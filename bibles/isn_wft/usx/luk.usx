<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LUK" style="id">LɄKA</book>
  <para style="h">ISANZU Bible Version</para>
  <para style="toc1">Nkani Nza anga niyandɨkilwe nʉ Lʉka</para>
  <para style="toc2">Lʉka</para>
  <para style="toc3">Lʉk</para>
  <para style="mt2">NKANI NZA ANGA NƗYANDƗKILWE NɄ</para>
  <para style="mt1">LɄKA</para>
  <para style="imt">NTONGEELA AKWE</para>
  <para style="ib">Ntongeela a Nkani Nza anga niyandɨkilwe nʉ Lʉka. Mbugulu a Nkani Nza anga niyandɨkilwe nʉ Lʉka ɨhangaa mbugulu ni inɨ. Mbugulu yɨhi yitangwa Nkani Nza, lʉkani ʉlʉ ndogoelyo akwe Nkani Nza. Mbugulu izi yandɨkilwe nʉ Matayo Nʉ Maliko Lʉka nʉ Yohana Yesʉ naɨwasha. Lʉka shanga aɨwandɨkile inkani yang’wa Yesʉ du, ingɨ aɨwandɨkile nɨ makani ʉ Yesʉ nɨ amanyisigwa akwe naɨatendile, Yesʉ naɨ washa nʉ kiʉka. Lʉka aɨwandɨkile nɨ mbugulu a Ntendo niya Itʉmi. Kʉtilɨ nʉlɨngile itungo naɨ yandɨkilwe Nkani Nza niyang’wa Lʉka ang’wi yandɨkɨwe pɨɨ. Ingɨ alɨngi ɨdʉ igombilye kɨna yandɨkilwe ng’waka nʉa mʉpungatɨ ʉ Kilisito naɨwasha. Mʉandɨka mbugulu ang’wa Lʉka, aɨ Lʉka naɨmʉkilɨki yʉyo aɨ wandɨkile. Mpyani aʉwandɨki wakwe nɨntambʉ akwe ɨkʉkʉmʉʉla kɨna aɨʉsomile. Lʉka aɨʉloilwe kʉandɨka ɨkʉlʉ kʉʉlʉ inkani niya likalo lang’wa Yesʉ, wazeganʉla makani ɨhi nɨ itɨ naɨ apumɨe, ingɨ antʉ ang’wɨ nɨakʉsoma ahume kʉlɨnga. Lʉka 1:1-3. Lʉka shanga aɨ Mʉyahudi. Akolosai 4:10-14. Aɨwandɨkile kʉmpyani a antʉ nɨshanga Ayahudi nɨahumile kʉlɨnga. Ikani ɨlɨ lɨkigeela kɨhenga itɨ nʉkʉitambʉla intendo niya Ayahudi Lʉka 1:8.</para>
  <para style="ip">Nkani Nza niyang’wa Lʉka yimpyani ni mbugulu niyaa Matayo nʉ Maliko, kʉnsoko mbugulu izi yiganʉe nkani zizo ziizo kʉ nzɨla yɨyo yɨɨyo. Mʉmbugulu izi ni itaatʉ, mbugulu ang’wa Lʉka yɨyo ɨkʉganʉla kɨhenga ʉʉtugwi wang’wa Yohana Mʉbadisi. Lʉka ʉkomangɨɨe kʉlekelwa mɨlandʉ. Lʉka 3:3, 11:4, 17:3-4, 23:34, 24:47 nɨ 24:47. Hangɨ ʉkomangɨɨe malompi 3:21, 5:16, 6:12, 11:1-12, 22:32.</para>
  <para style="iot">Namolɨ</para>
  <para style="ip">1:1-4 Lʉka ʉkʉitambʉla Nkani Nza nʉkʉganʉla nɨkɨ ʉkʉandɨka. Hangɨ ʉkʉganʉla kʉtugwa kʉng’wa Yesʉ nɨ itɨ naɨ wihambile kʉ ʉtanantyi 1:5-4-13. Mʉ nkani niyɨdʉ mʉ mbugulu ang’wa Lʉka 4:14-21-38 wandɨkile mɨʉkʉɨlwa nʉmanyisilye ʉ Yesʉ nɨ makani nʉitʉmile. Mpelo akwe 22-24 Lʉka ʉkʉganʉla ʉ Yesʉ naɨ ʉkule nʉkʉɨkwa nʉkiʉka.</para>
  <chapter number="1" style="c" sid="LUK 1" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1" />Ʉadɨ Mʉkʉlʉ Teopilo.</para>
  <para style="p" vid="LUK 1:1">Antʉ ɨdʉ akagupa kʉandɨka nʉkʉɨka iza makani ayo naɨatendekile mʉng’witʉ. <verse eid="LUK 1:1" /><verse number="2" style="v" sid="LUK 1:2" />Aɨandɨkile anga naɨ akuganʉɨwe nawo naɨiloee ɨmakani nanso kʉpumɨɨla ʉng’wandyo nʉkʉlʉtanantya ʉlʉkani nʉlanso. <verse eid="LUK 1:2" /><verse number="3" style="v" sid="LUK 1:3" />Nʉnenega nɨnakolenkeelya kɨsa ɨmakani aya, naona iza nʉkʉandɨkɨle nʉewe Mʉkʉlʉ Teopilo kʉ ʉkendegeeli nʉʉkʉlʉ, <verse eid="LUK 1:3" /><verse number="4" style="v" sid="LUK 1:4" />kitʉma itɨ ingɨ nʉewe ʉhume kʉlɨnga ɨtai amakani ayo naɨ ʉmanyisigwe.<verse eid="LUK 1:4" /></para>
  <para style="s">Ʉtugwi wang’wa Yohana Mʉbadisi ʉkʉtanantigwa</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5" />Matungo Helode naɨ mʉtemi nʉa kʉ Yʉdea, aɨʉkolɨ mʉpolyi ʉng’wɨ lina lakwe Zakalia, kʉpuma miʉmbɨ nɨla apolyi nilang’wa Abiya, mʉsʉngʉ wakwe witangwaa Elizabeti kʉpuma miʉmbɨ la apolyi nang’wa Aloni. <verse eid="LUK 1:5" /><verse number="6" style="v" sid="LUK 1:6" />Ɨhi mʉ ʉbɨɨlɨ wao aɨ amʉloeeye Itunda, kʉnsoko aɨ atyatile ɨmalagɨɨlyo nɨmalago ang’wi Isekʉlʉ Itunda. <verse eid="LUK 1:6" /><verse number="7" style="v" sid="LUK 1:7" />Shanga aɨatugile anga ana kʉnsoko ʉ Elizabeti aɨ mʉgʉmba, ɨantʉ awa ɨhi mʉbɨɨlɨ aɨ anyampae.<verse eid="LUK 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8" />Lʉhikʉ lʉng’wɨ ʉ Zakalia naɨ ʉmolɨ mʉʉalwi nʉa ʉpolyi Mʉnyʉmba ang’wi Itunda, <verse eid="LUK 1:8" /><verse number="9" style="v" sid="LUK 1:9" />anga ɨntendo aapolyi, Zakalia aɨ ʉsagʉwe nabʉngʉlʉ bʉngʉlʉ wingɨle Mʉnyʉmba ang’wi Itunda wakʉhɨɨlye ʉʉbani. <verse eid="LUK 1:9" /><verse number="10" style="v" sid="LUK 1:10" />Matungo naɨ ʉkʉkuhɨɨlya ʉʉbani antʉ ɨhi naɨ aziipolya aɨ ilʉndɨɨe mʉkianda ka Nyʉmba ang’wi Itunda akazelompa.<verse eid="LUK 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 1:11" />Mitʉmɨ nʉa kigʉlʉ nʉang’wi Itunda akigela wazewɨmɨkile ipande nɨla kɨgoha nɨla meza akʉkuhɨɨlɨlya ʉʉbani. <verse eid="LUK 1:11" /><verse number="12" style="v" sid="LUK 1:12" />Zakalia paɨwamʉona Mitʉmi nʉakigʉlʉ nʉang’wi Itunda akitumba, akogopa. <verse eid="LUK 1:12" /><verse number="13" style="v" sid="LUK 1:13" />Mitʉmɨ nʉa kigʉlʉ nʉang’wi Itunda akamʉila, “Zakalia leka kogopa. Itunda wijaa ɨmalompi ako, ʉmʉkɨmako Elizabeti ʉkʉʉtugɨla ng’wana mʉgoha, nʉewe ʉkʉmʉta ɨlɨna Yohana <verse eid="LUK 1:13" /><verse number="14" style="v" sid="LUK 1:14" />Nʉewe ʉkʉheka nʉkiloa nangalu, nɨantʉ ɨdʉ akʉlʉmbɨɨlya kʉnsoko akʉtugwa kʉng’waakwe. <verse eid="LUK 1:14" /><verse number="15" style="v" sid="LUK 1:15" />Kʉnsoko ʉkʉtula mʉkʉlʉ ntongeela ang’wi Isekʉlʉ. Shanga ʉkʉng’wa dibai ang’wɨ ntʉlɨ. Ʉkʉtongwa nʉ Ng’wahʉ wang’wi Itunda pʉma kʉʉtugwa wakwe. <verse eid="LUK 1:15" /><verse number="16" style="v" sid="LUK 1:16" />Yohana ʉkʉasʉsha Aisilaeli ɨdʉ amʉsʉkɨle Itunda wao. <verse eid="LUK 1:16" /><verse number="17" style="v" sid="LUK 1:17" />Ʉkʉmʉtongeela Isekʉlʉ, waze ʉkete ngulu nia Ng’wahʉ wang’wi Itunda anga mʉmanga Elia. Ʉkʉpɨʉla inkolo niya atata aakele ɨanaao, nawa nɨagila ʉlwijo amalɨnge ɨmakani nɨmaziza, nʉkʉanoneelya ɨantʉ kʉmʉsɨngɨɨlya Isekʉlʉ.”<verse eid="LUK 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18" />Zakalia akamʉkolya ʉ mitʉmi nʉa kigʉlʉ nʉang’wi Itunda, “Kʉhʉɨɨla ʉlɨ ikani ɨlɨ kɨna lɨkʉtʉlɨka? Ʉnene nɨmʉnyampala, nʉmʉkɨmane mʉkombi.”<verse eid="LUK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 1:19" />Mitʉmɨ nʉa kigʉlʉ nʉang’wi Itunda akamʉsʉkɨɨlya, “Ʉnene nɨ Gabilieli, nɨnimɨka ntongeela ang’wi Itunda. Ʉnene ndagɨɨgwe nʉkʉtambʉɨle inkani izi ninza. <verse eid="LUK 1:19" /><verse number="20" style="v" sid="LUK 1:20" />Itungɨlɨ kʉnsoko shanga ʉhʉɨɨe inkani nɨnʉkʉtambʉie. Ʉkʉtula wɨkɨmumɨ, shanga ʉkʉhuma kʉtambʉla kʉpikɨɨla lʉhikʉ ʉlo naakʉpumɨla ɨmakani aya.”<verse eid="LUK 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21" />Matungo nanso ɨantʉ naɨamʉlindɨɨe ʉ Zakalia mʉkɨanda akakʉɨlwa naɨwatinia kʉpuma Mʉnyʉmba ang’wi Itunda. <verse eid="LUK 1:21" /><verse number="22" style="v" sid="LUK 1:22" />Zakalia naɨʉpumile kunzi, aimugila anga ʉhumi nua kuligitya, akaligitya katumila ilɨngasɨɨlyo niya mɨkono. Antʉ akalɨnga kɨna wilolenkee mɨloto Mʉnyʉmba ang’wi Itunda. <verse eid="LUK 1:22" /><verse number="23" style="v" sid="LUK 1:23" />Naɨwimalya kitʉma Mʉnyʉmba ang’wi Itunda, akatʉlya kitolakwe. <verse eid="LUK 1:23" /><verse number="24" style="v" sid="LUK 1:24" />Mahikʉ masheenyʉ naɨatyatile ʉ Elizabeti mʉkɨmakwe akaʉsha mɨlɨgo. Shanga aɨupimile mʉnyʉmba akwe myeli ɨtaano. Wazelʉnga, <verse eid="LUK 1:24" /><verse number="25" style="v" sid="LUK 1:25" />“Iti ʉʉ ʉntendee Isekʉlʉ, wakembeta nʉkʉnihegelya ɨmɨnyala mʉ antʉ.”<verse eid="LUK 1:25" /></para>
  <para style="s">Kʉtugwa kʉng’wa Yesʉ ikʉtanantigwa</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26" />Mʉmyeli mʉtandatʉ mʉmɨligo ang’wa Elizabeti, mitʉmi nʉakigʉlʉ nʉang’wi Itunda nʉitangwaa Gabilieli akalagɨɨligwa ni Itunda walongole kʉkɨsalɨ kɨng’wɨ nɨka Galilaya nɨkitangwaa Nazaleti, <verse eid="LUK 1:26" /><verse number="27" style="v" sid="LUK 1:27" />kʉmʉnanso ʉng’wɨ naɨwakɨlɨ kʉtankana nʉmitʉnja wɨhi kɨmʉɨlɨ lina lakwe Maliamu, mʉnanso ʉyʉ aiʉligigwe nʉmʉgalimanga ʉng’wɨ lina lakwe Yusupu, kʉpuma ndʉgʉ ang’wa Daudi. <verse eid="LUK 1:27" /><verse number="28" style="v" sid="LUK 1:28" />Mitʉmi nʉakigʉlʉ nʉang’wi Itunda nʉitangwaa Gabilieli akingɨla mito lang’wa Maliamu akamʉlamʉsha, akamʉɨla “Itunda wɨpalʉng’wɨ nʉewe nʉɨkembetwa ni Isekʉlʉ.”<verse eid="LUK 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 1:29" />Maliamu naɨwija inkani izi, akasɨganɨɨlya mʉnkolo akwe, mɨlamʉ ɨyɨ ndogoelyo akwe ntʉni. <verse eid="LUK 1:29" /><verse number="30" style="v" sid="LUK 1:30" />Ingɨ Mitʉmɨ nʉakigʉlʉ nʉang’wi Itunda akamʉɨla, “Maliamu leka kogopa, kʉnsoko ʉewe ʉkembetilwe ni Itunda. <verse eid="LUK 1:30" /><verse number="31" style="v" sid="LUK 1:31" />Kʉnsoko ʉkʉʉsha mɨligo, ʉkʉtuga ng’wana mʉgoha, ɨlina lakwe ʉkʉmitanga Yesʉ. <verse eid="LUK 1:31" /><verse number="32" style="v" sid="LUK 1:32" />Ng’wana ʉyʉ ʉkʉtula mʉkʉlʉ, ʉkitangwa Ng’wana wang’wi Itunda Nʉkolɨ Migʉlya Nangalʉʉ, hangɨ Isekʉlʉ Itunda ʉkʉtula mʉtemi anga ʉtataakwe ʉ Daudi. <verse eid="LUK 1:32" /><verse number="33" style="v" sid="LUK 1:33" />Kʉlʉlo ʉkʉtema wileli wang’wa Yakobo mahikʉ ɨhi nɨmagila ɨmpelo, ʉtemi wakwe ɨzeʉgila anga mpelo.”<verse eid="LUK 1:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 1:34" />Maliamu akamʉsʉkɨɨlya, “Ʉnene nɨmʉnanso, nkɨlɨ kʉtankana kɨmʉɨlɨ nʉmitunja wɨhi ikani lɨkʉtula ʉlɨ?”<verse eid="LUK 1:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 1:35" />Mitʉmɨ nʉakigʉlʉ nʉang’wi Itunda, akamʉɨla, “Ng’wahʉ wang’wi Itunda ʉzile kʉng’waako, ningulu yang’wi Itunda nʉkolɨ migʉlya nangalu yʉkʉʉimba anga iluɨlya, nʉyo nʉkʉtungwa ʉkʉtula ukolɨ ipande lang’wi Itunda, hangɨ ʉkitangwa Ng’wana wang’wi Itunda. <verse eid="LUK 1:35" /><verse number="36" style="v" sid="LUK 1:36" />Goza ʉng’waanyu ʉ Elizabeti, ɨantʉ aɨamʉailye nʉanso kɨna mʉgʉmba, waʉsha mɨligo mʉʉkombi wakwe, imɨligo akwe apisha myeli mʉtandatʉ. <verse eid="LUK 1:36" /><verse number="37" style="v" sid="LUK 1:37" />Kʉnsoko kʉng’wi Itunda kʉtilɨ ikani nɨlʉkʉlemeka.”<verse eid="LUK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38" />Maliamu akalʉnga, “Ʉnene nɨmitʉmi wang’wi Itunda, itulɨke anga nʉtambʉe.” Sʉnga Mitʉmɨ nʉakigʉlʉ nʉang’wi Itunda akamʉleka, akahega.<verse eid="LUK 1:38" /></para>
  <para style="s">Maliamu ʉkʉmiʉmbaʉmbɨla ʉ Elizabeti</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39" />Mumahikʉ yayo yaayo, Maliamu akipatɨɨlya akalongola kʉpikɨɨla kɨsalɨ kɨng’wɨ nɨkɨkolɨ mʉlʉgʉlʉ nʉlakʉ Yʉdea. <verse eid="LUK 1:39" /><verse number="40" style="v" sid="LUK 1:40" />Naɨwapika kʉ Yʉdea akasɨngɨɨlɨgwa nʉkingɨla mʉnyʉmba ang’wa Zakalia, akamʉhanga ʉ Elizabeti akamʉlamʉsha. <verse eid="LUK 1:40" /><verse number="41" style="v" sid="LUK 1:41" />Itungo ʉdu ʉ Maliamu naiʉmʉlamʉkilye ʉdu ʉ Elizabeti, ikana naɨkakolɨ mʉnda ang’wa Elizabeti kɨkapulugunya. Nʉ Elizabeti akapegwa ʉhumi nʉa Ng’wahʉ wang’wi Itunda, <verse eid="LUK 1:41" /><verse number="42" style="v" sid="LUK 1:42" />Elizabeti akakʉta, “Ʉkembetilwe ni Itunda kʉkɨla asʉngʉ ɨhi, nʉng’wana nʉʉkʉtʉgwa nʉewe ʉkembetilwe. <verse eid="LUK 1:42" /><verse number="43" style="v" sid="LUK 1:43" />Kʉniki ikani ili linihange ʉnene kʉpikɨla ʉnyinya wang’wi Isekʉlʉ waniʉmbaʉmbɨle? <verse eid="LUK 1:43" /><verse number="44" style="v" sid="LUK 1:44" />Nʉkʉɨlene naza ʉnamʉkilye ʉdu, ʉng’wana nʉmoli mʉndane wapulugunya kʉʉlowa. <verse eid="LUK 1:44" /><verse number="45" style="v" sid="LUK 1:45" />Ʉkembetilwe ʉewe nʉhʉɨɨe kɨna ikani nʉtambʉɨwe Isekʉlʉ lʉkʉkamɨnkɨɨligwa.”<verse eid="LUK 1:45" /></para>
  <para style="s">Maliamu ʉkɨmba kʉmʉkʉlya Itunda</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46" />Maliamu akatambʉla,</para>
  <para style="q" vid="LUK 1:46">“Nkolo ane ɨkʉmʉkʉlya Isekʉlʉ,<verse eid="LUK 1:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="LUK 1:47" />Niloile mʉng’wi Itunda Mʉponyi wane,<verse eid="LUK 1:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="LUK 1:48" />Kʉnsoko kʉkɨnyaʉwai ʉnkɨmbʉkile mitʉmi wakwe nɨnininompya.</para>
  <para style="q" vid="LUK 1:48">Itɨgwa pumɨɨla ino wileli wihi akʉnintanga mʉkembetwa.<verse eid="LUK 1:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="LUK 1:49" />Kʉnsoko Itunda nɨmʉnyangulu yɨhi wantendeela makani makʉlʉ,</para>
  <para style="q" vid="LUK 1:49">nʉanso ingɨ yuyo wakukuligwa.<verse eid="LUK 1:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="LUK 1:50" />Kɨnyaʉwai kakwe kʉantʉ nɨɨmʉkʉlya,</para>
  <para style="q" vid="LUK 1:50">kɨkikiɨ wileli nʉ wileli.<verse eid="LUK 1:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="LUK 1:51" />Kʉʉhumi wakwe nʉangulu ʉtendile makani makʉlʉ</para>
  <para style="q" vid="LUK 1:51">usapatɨɨye ɨmahala anyalʉgoha nakoli mʉnkolo yao,<verse eid="LUK 1:51" /></para>
  <para style="q">
    <verse number="52" style="v" sid="LUK 1:52" />ʉahegilye ɨatemi mʉʉtemi wao,</para>
  <para style="q" vid="LUK 1:52">ingɨ uakʉiye awa nɨininompya.<verse eid="LUK 1:52" /></para>
  <para style="q">
    <verse number="53" style="v" sid="LUK 1:53" />Ʉikʉtilye ɨanyanzala maintʉ nɨmaza,</para>
  <para style="q" vid="LUK 1:53">ʉahegilye ɨagolɨ ahega mɨkono mɨtilɨ.<verse eid="LUK 1:53" /></para>
  <para style="q">
    <verse number="54" style="v" sid="LUK 1:54" />Ʉmuaɨiye mitʉmɨ akwe u Isilaeli,</para>
  <para style="q" vid="LUK 1:54">ʉkɨmbʉkile ilago lakwe nɨlakʉmuaisɨɨlya.<verse eid="LUK 1:54" /></para>
  <para style="q">
    <verse number="55" style="v" sid="LUK 1:55" />Anga naɨʉtambue kung’wa aguku itu, Ibulahimu nu wileli wakwe kalɨ na kalɨ.”<verse eid="LUK 1:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56" />Maliamu akamʉdʉɨla ʉ Elizabeti kʉmweli ɨtaatʉ, sʉnga akatulya kitolakwe.<verse eid="LUK 1:56" /></para>
  <para style="s">Kʉtugwa kʉng’wa Yohana Mubadisi</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57" />Naɨlɨpikie itungo lang’wa Elizabeti kitungʉɨla, akitungʉɨla ng’wana mʉgoha. <verse eid="LUK 1:57" /><verse number="58" style="v" sid="LUK 1:58" />Anyandʉgʉ nɨ anyakɨsalɨ akija Itunda nʉmʉtendee ʉkende ʉkʉlʉ ʉ Elizabeti, naoga akiloa palʉng’wɨ nʉ Elizabeti. <verse eid="LUK 1:58" /><verse number="59" style="v" sid="LUK 1:59" />Ʉng’wana naɨʉpikilye mahikʉ mʉnana akatwalwa kʉkɨdamu, ɨanyandʉgʉ akahiya kʉmʉta ʉng’wana lina Zakalia, lina lang’wiihe. <verse eid="LUK 1:59" /><verse number="60" style="v" sid="LUK 1:60" />Ingɨ ʉnyinya nʉang’wana akahita nʉkʉlʉnga, “Shanga lɨlo, lina lakwe ʉkitangwa Yohana.”<verse eid="LUK 1:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 1:61" />Anyandʉgʉ akamʉtambʉɨla, “Mʉndʉgʉako kʉtilɨ anga mʉntʉ wɨhi nʉitangwa ɨlina nɨlanso.” <verse eid="LUK 1:61" /><verse number="62" style="v" sid="LUK 1:62" />Antʉ akamʉkolya kʉtʉmɨla ɨlɨngasɨɨlyo ya mɨkono ʉ Zakalia ahume kʉlɨnga nʉanso ʉloilwe ʉng’wana wategwe lina kɨɨ.<verse eid="LUK 1:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 1:63" />Zakalia akaalompa wapegwe balʉa nɨla kʉandɨkɨla, akaandɨka kɨna, “Lina lang’wana ingɨ Yohana” antʉ ɨhi akakʉɨlwa. <verse eid="LUK 1:63" /><verse number="64" style="v" sid="LUK 1:64" />Papo paapo ʉ Zakalia akahuma hangɨ kʉligitya wakazemʉkʉlya Itunda. <verse eid="LUK 1:64" /><verse number="65" style="v" sid="LUK 1:65" />Anyakɨsalɨ akwe akakʉɨlwa, ɨantʉ mihɨɨ ɨhi namalʉgʉlʉ Ayʉdea akatʉlitambʉɨla inkani zizidu. <verse eid="LUK 1:65" /><verse number="66" style="v" sid="LUK 1:66" />Mʉntʉ wɨhi naɨwigulye inkani izi aɨʉkʉɨwe nʉkʉkolya, “Itɨɨ, ʉng’wana ʉyʉ ʉkʉtula mʉntʉ wakɨnyaʉlɨ?” Kʉnsoko kʉlʉ kʉʉlʉ ʉhumi wang’wi Itunda ʉkolɨ palʉng’wɨ nʉng’wenso.<verse eid="LUK 1:66" /></para>
  <para style="s">Ʉmanga wang’wa Zakalia</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67" />Sʉnga ʉ Zakalia ihe wang’wa Yohana, akazɨɨlwa nʉ Ng’wahʉ wang’wi Itunda, nʉng’wenso akapumya ʉmanga, akalʉnga,<verse eid="LUK 1:67" /></para>
  <para style="q">
    <verse number="68" style="v" sid="LUK 1:68" />“Wakʉligwe Isekʉlʉ, Itunda nʉa Aisilaeli,</para>
  <para style="q" vid="LUK 1:68">kʉnsoko wazaa kʉakomola ɨantʉ akwe.<verse eid="LUK 1:68" /></para>
  <para style="q">
    <verse number="69" style="v" sid="LUK 1:69" />Wakʉpeza mʉponyi nɨmankata,</para>
  <para style="q" vid="LUK 1:69">nʉɨkapuma mʉndʉgʉ ang’wa Daudi nɨmitʉmi wakwe.<verse eid="LUK 1:69" /></para>
  <para style="q">
    <verse number="70" style="v" sid="LUK 1:70" />Anga Itunda naɨʉtambʉe pakalɨ kʉkɨɨla amanga naɨʉahoile kʉmɨlɨmo akwe,<verse eid="LUK 1:70" /></para>
  <para style="q">
    <verse number="71" style="v" sid="LUK 1:71" />kɨna ʉkʉʉkomola kʉpuma mʉalʉgʉ itʉ</para>
  <para style="q" vid="LUK 1:71">nʉkʉʉheja mʉngulu yao nɨakʉbɨpɨwe.<verse eid="LUK 1:71" /></para>
  <para style="q">
    <verse number="72" style="v" sid="LUK 1:72" />Aɨʉtambʉe ʉkʉakendepa ɨatata itʉ,</para>
  <para style="q" vid="LUK 1:72">nʉkʉkɨmbʉka ilago naɨʉlɨɨkile kʉnsoko akwe.<verse eid="LUK 1:72" /></para>
  <para style="q">
    <verse number="73" style="v" sid="LUK 1:73" />Anga ilago naɨʉmʉɨkɨe ʉtataitʉ ʉ Ibulahimu aɨʉmʉlapɨla,<verse eid="LUK 1:73" /></para>
  <para style="q">
    <verse number="74" style="v" sid="LUK 1:74" />kɨna ʉkʉʉkomola mʉngulu nɨyaalʉgʉ itʉ,</para>
  <para style="q" vid="LUK 1:74">kʉʉhumya ʉsese kumitʉmila,<verse eid="LUK 1:74" /></para>
  <para style="p">
    <verse number="75" style="v" sid="LUK 1:75" />kʉhume kʉtula ipande lakwe nʉ kʉgombeka kʉng’wi Itunda,</para>
  <para style="q" vid="LUK 1:75">mʉmahikʉ itʉ ihi.<verse eid="LUK 1:75" /></para>
  <para style="q">
    <verse number="76" style="v" sid="LUK 1:76" />“Nʉewe ng’waane ʉkitangwa mʉmanga wang’wi Itunda nʉkolɨ migʉlya nangaluu,</para>
  <para style="q" vid="LUK 1:76">kʉnsoko ʉkʉmʉtongeela Isekʉlʉ</para>
  <para style="q" vid="LUK 1:76">nʉkʉnoneelya nzɨla kʉnsoko akwe,<verse eid="LUK 1:76" /></para>
  <para style="q">
    <verse number="77" style="v" sid="LUK 1:77" />kʉatanantɨlya ɨantʉ akwe kɨna akʉponyigwa</para>
  <para style="q" vid="LUK 1:77">kʉkɨɨla akʉlekelwa ɨmɨlandʉ ao,<verse eid="LUK 1:77" /></para>
  <para style="q">
    <verse number="78" style="v" sid="LUK 1:78" />kʉnsoko aʉpolo nɨkɨaisa kang’wi Itunda witʉ,</para>
  <para style="q" vid="LUK 1:78">nɨnzelya akwe nakʉʉkomola ɨkʉelya kʉpuma kigʉlʉ,<verse eid="LUK 1:78" /></para>
  <para style="q">
    <verse number="79" style="v" sid="LUK 1:79" />ɨhume kelya kʉawo nɨishiɨ mʉkiti nʉmilulɨ nɨlansha,</para>
  <para style="q" vid="LUK 1:79">nʉkʉʉtonga mʉnzɨla naʉpolo.”<verse eid="LUK 1:79" /></para>
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80" />Ng’wana ʉyʉ akakʉla nʉkongeeleka ingulu niakɨnkolo, akishiɨ mʉwɨɨ kʉpikɨɨla lʉhikʉ naɨwigeelekile kɨhenga kʉ Aisilaeli.<verse eid="LUK 1:80" /></para>
  <chapter eid="LUK 1" />
  <chapter number="2" style="c" sid="LUK 2" />
  <para style="s">Kʉtugwa kʉng’wa Yesʉ</para>
  <para style="r">
    <ref loc="MAT 1:18-23">Matayo 1:18-23</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1" />Mahikʉ nanso Agusito Mʉtemi nʉa Alʉmi akatanantya kɨna antʉ ɨhi mʉmahɨɨ aʉtemi wakwe aaligwe. <verse eid="LUK 2:1" /><verse number="2" style="v" sid="LUK 2:2" />Ʉaligwa ʉwʉ aɨwakwandya kitʉng’wa matungo ʉ Kilenio naɨmʉtongeeli mihɨɨ akʉ Silia. <verse eid="LUK 2:2" /><verse number="3" style="v" sid="LUK 2:3" />Antʉ ɨhi akalongola kʉaligwa mʉisalɨ yao naɨatungɨwe.<verse eid="LUK 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 2:4" />Yusupu akapuma kʉkɨsalɨ ka Nazaleti nɨkɨkolɨ kʉ Galilaya, akalongola kʉ Betelehemu mʉkɨsalɨ ka Yʉdea kaɨʉtugɨwe ʉ Daudi. Kʉnsoko ʉ Yusupu aɨwandʉgʉ ang’wa Daudi. <verse eid="LUK 2:4" /><verse number="5" style="v" sid="LUK 2:5" />Yusupu nʉ Maliamu kʉnsoko aɨʉmʉligilye aɨendile kʉng’wanso aaligwe palʉng’wɨ, ʉ Maliamu aɨmʉlito. <verse eid="LUK 2:5" /><verse number="6" style="v" sid="LUK 2:6" />Naɨakɨlɨ akolɨ kʉ Betelehemu, itungo nɨla kitungʉɨla ʉ Maliamu lɨkapika. <verse eid="LUK 2:6" /><verse number="7" style="v" sid="LUK 2:7" />Maliamu akitungʉɨla tangi akwe nʉakɨgoha. Akamʉimba ngʉo aana nɨadabu akamʉlalya milinga nɨlakʉlɨsɨlya ɨmɨtugo, kʉnsoko aɨaʉiye ɨlyoma Mʉnyʉmba niakʉlala ɨazɨɨla.<verse eid="LUK 2:7" /></para>
  <para style="s">Itʉmi nɨa kigʉlʉ nɨang’wi Itunda akigeela kʉ Adɨmi</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8" />Pang’waso aɨakolɨ pakupi niadɨma nkolo naɨakʉsʉnja imɨtugo ao ʉtikʉ. <verse eid="LUK 2:8" /><verse number="9" style="v" sid="LUK 2:9" />Pumpulugu, mitʉmi nʉakigʉlʉ nʉang’wi Itunda akaeigela kʉng’waao, ʉmɨlɨgintu wang’wi Isekʉlʉ ʉkelya mpande yɨhi, adɨmi ɨhi akogopa nangalu, <verse eid="LUK 2:9" /><verse number="10" style="v" sid="LUK 2:10" />ingɨ ʉmitʉmi nʉakigʉlʉ nʉang’wi Itunda akaatambʉɨla ɨadɨma nkolo, “Leki kogopi, nʉmʉletee mpola nziza niikʉleta ʉlowa ʉkʉlʉ kʉantʉ ɨhi. <verse eid="LUK 2:10" /><verse number="11" style="v" sid="LUK 2:11" />Kʉnsoko lelo ɨyɨ mʉkɨsalɨ kang’wa Daudi ʉtugilwe Mʉponyi, ingɨ Kilisito Isekʉlʉ. <verse eid="LUK 2:11" /><verse number="12" style="v" sid="LUK 2:12" />Kɨlɨngasɨɨlyo kanyu kɨkatula sɨkɨ, mʉkʉmʉhanga ng’wana mʉdabʉ ʉlalɨshigwe milinga lakʉlɨsɨlya mɨtugo nʉkʉimbwa ngʉo akʉimbɨla ana nɨadambʉ.”<verse eid="LUK 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 2:13" />Pumbulugu iumbɨ ikʉlʉ nɨla itʉmi akigʉlʉ nɨang’wi Itunda likigela likihangʉɨla nʉmitʉmi nʉa kigʉlʉ nʉang’wi Itunda nʉakwandya akitʉnta azemʉkʉlya Itunda azelʉnga.<verse eid="LUK 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="LUK 2:14" />“Itunda nʉakʉligwe nʉkolɨ migʉlya ikʉlʉ kigʉlʉ</para>
  <para style="q" vid="LUK 2:14">nʉmihɨɨ itule nʉʉpolo kʉantʉ nʉagombile.”<verse eid="LUK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15" />Itʉmi akigʉlʉ nɨang’wi Itunda naɨaaleka nʉkʉlongola kigʉlʉ, adɨma mɨtugo akitambʉlya ɨenso akalʉnga, “Siali kwendi kʉkɨsalɨ ka Betelehemu kende kilolenkeele ikani ɨlɨ nɨlaʉkʉɨlwa nɨlɨpumɨe, nɨkʉɨɨwe ni Isekʉlʉ.”<verse eid="LUK 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 2:16" />Ʉʉgwa adɨma mɨtugo akipatɨɨlya akalaongola kʉ Betelehemu, ɨkaahanga ʉ Yusupu nʉ Maliamu palʉng’wɨ nʉng’wana nʉmʉdabʉ ʉlaigwe milinga nɨlakʉlɨsɨlya mɨtugo. <verse eid="LUK 2:16" /><verse number="17" style="v" sid="LUK 2:17" />Adɨma nkolo naɨamʉona ʉng’wana, akandya kʉtanantya inkani niyang’wana naɨatambʉɨwe nʉ mitʉmi nʉakigʉlʉ nʉang’wi Itunda. <verse eid="LUK 2:17" /><verse number="18" style="v" sid="LUK 2:18" />Antʉ ɨhi naɨigulye akakʉɨlwa inkani niitambʉwe nɨadɨma nkolo. <verse eid="LUK 2:18" /><verse number="19" style="v" sid="LUK 2:19" />Ingɨ ʉ Maliamu akatunga mʉnkolo akwe ɨmakani aya kʉnʉ wazemasɨganɨɨlya. <verse eid="LUK 2:19" /><verse number="20" style="v" sid="LUK 2:20" />Adɨma nkolo akatʉlya kʉwii, kʉnʉ akazemʉkʉlya nʉkʉmʉlʉmbiilya Itunda, kʉmakani ihi naɨatambʉɨwe nʉmitʉmi nʉakigʉlʉ nʉang’wi Itunda nʉkilolenkeela.<verse eid="LUK 2:20" /></para>
  <para style="s">Ng’wana akategwa lina</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21" />Mʉlʉhikʉ nʉla mʉnana, akamʉtwala ʉng’wana kɨganda, nʉkʉmʉta ɨlina Yesʉ, lina ʉ Maliamu naɨʉtambʉɨwe nʉmitʉmi nʉakigʉlʉ nʉang’wi Itunda apo naɨwakɨlɨ kʉʉsha ɨmɨligo.<verse eid="LUK 2:21" /></para>
  <para style="s">Yesʉ ʉkʉtwalwa Mʉnyʉmba ang’wi Itunda</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 2:22" />Mahiku akɨzʉmba naiakila Maliamu akielya anga ntendo niilagɨɨye mʉmalagɨɨlyo ang’wa Musa, Yusupu nʉ Maliamu akamʉtwala ʉng’wana kʉ Yelusalemu kʉmʉpumya kʉng’wi Itunda. <verse eid="LUK 2:22" /><verse number="23" style="v" sid="LUK 2:23" />Anga niandɨkilwe mʉmalagɨɨlyo ang’wi Itunda kɨna, “Ʉng’wana nʉakɨgoha wɨhi nɨtangi wapumigwe kʉng’wi Itunda.” <verse eid="LUK 2:23" /><verse number="24" style="v" sid="LUK 2:24" />Hangɨ aɨapumilye ipolyo, nkʉlʉ ibɨɨlɨ, ang’wi ana nkʉnda abɨɨlɨ, anga niilagɨigwe mʉmalagɨɨlyo ang’wi Isekʉlʉ. <verse eid="LUK 2:24" /><verse number="25" style="v" sid="LUK 2:25" />Matungo nanso mʉkɨsalɨ ka Yelusalemu aɨʉkolɨ mitʉnja ʉng’wɨ ɨlina lakwe Simioni naɨza mʉntʉ nʉalwijo, hangɨ aɨʉgombekile kʉng’wi Itunda. Mʉntu naɨʉsʉmbɨɨye kʉkomolwa kʉ Aisilaeli, nʉyo aɨwɨpalʉng’wɨ Ng’wahʉ wang’wi Itunda. <verse eid="LUK 2:25" /><verse number="26" style="v" sid="LUK 2:26" />Ng’wahʉ wang’wi Itunda aɨʉmʉkamɨnkɨɨye mʉmɨloto kɨna shanga ʉkʉsha kʉpikɨɨla wamʉone ʉ Kilisito nʉhoilwe ni Isekʉlʉ <verse eid="LUK 2:26" /><verse number="27" style="v" sid="LUK 2:27" />Ng’wahʉ wang’wi Itunda akamʉtonga ʉ Simioni akalongola panyʉmba ang’wi Itunda. Aleli naɨamʉleta ʉ Ng’wana ʉ Yesʉ ahume kʉmʉtendeela anga niitakɨwe mʉmalagɨɨlyo, <verse eid="LUK 2:27" /><verse number="28" style="v" sid="LUK 2:28" />papogwa ʉ Simioni akamʉhola ʉng’wana mʉmɨkono akwe nʉkʉmʉkʉlya Itunda, wazelʉnga,<verse eid="LUK 2:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="LUK 2:29" />“Isekʉlʉ Mʉnyangulu, anga naɨʉlapile,</para>
  <para style="q" vid="LUK 2:29">itungo ɨlɨ wamʉgombyaa ʉmitʉmi nʉako wende kʉ atataakwe kʉʉziza.<verse eid="LUK 2:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="LUK 2:30" />Kʉnsoko kumiho ane nilolenkeela ʉponyi wako,<verse eid="LUK 2:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="LUK 2:31" />nʉaʉɨka pantongeela aantʉ ɨhi.<verse eid="LUK 2:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="LUK 2:32" />Nzelya nɨɨkelya kʉantʉ nɨshanga Ayahudi,</para>
  <para style="q" vid="LUK 2:32">nʉʉkʉlʉ kʉantʉ ako Aisilaeli.”<verse eid="LUK 2:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33" />Aleli ang’wana aɨakendakʉɨlwa ɨmakani nakʉtambʉlwa kʉng’wana. <verse eid="LUK 2:33" /><verse number="34" style="v" sid="LUK 2:34" />Ʉʉgwa ʉ Simioni akaakembeta, akamʉtambʉɨla ʉ Maliamu nyinya wang’wa Yesʉ, “Ʉng’wana ʉyʉ ʉɨkilwe nɨ Itunda kisɨgo nɨla kʉagwɨsa ang’wi kʉaponya antʉ ɨdʉ mʉ Isilaeli. Nʉanso ʉkʉtula kɨlɨngasɨɨlyo kang’wi Itunda nʉkʉhitwa nɨantʉ ɨdʉ, <verse eid="LUK 2:34" /><verse number="35" style="v" sid="LUK 2:35" />ingɨ masɨgo na antʉ ɨdʉ akʉkumʉʉlwa. Nʉewe ʉkʉtula nʉʉkɨa ʉkʉlʉ anga ʉwai wapanga nʉʉkʉawa mʉnkolo ako.”<verse eid="LUK 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 2:36" />Mʉng’wanso Mʉnyʉmba ang’wi Itunda aɨʉmolɨ mʉsʉngʉ ʉng’wɨ mʉgʉmba mʉmanga wang’wi Itunda, lina lakwe Ana ng’wana wang’wa Pwanueli nʉa ndʉgʉ ang’wa Asheli. Mʉsʉngʉ ʉyʉ akazeʉtɨnilwe nʉkikala kʉmyaka mʉpungatɨ ʉdu akashɨlwa nʉmʉgoha wakwe. <verse eid="LUK 2:36" /><verse number="37" style="v" sid="LUK 2:37" />Sunga aɨwikae mʉʉshɨlwa kʉmyaka makʉmi mʉnana nainnɨ. Matungo nanso ɨhi shanga aɨwɨhega panyʉmba ang’wi Itunda ingɨ wazemʉkʉlya Itunda kʉnʉ azewɨgwalya kʉlya nʉkʉmʉlompa ng’ʉng’wɨ nʉʉtikʉ. <verse eid="LUK 2:37" /><verse number="38" style="v" sid="LUK 2:38" />Itungo lɨlo lɨɨlo Ana akigeela paa Yusupu nʉ Maliamu, nʉkandya kʉmʉkʉlya Itunda, nʉkʉganʉla makani ang’wana kʉantʉ ɨhi naɨamʉsʉmbɨɨye Itunda wakomole ɨantʉ akʉ Yelusalemu.<verse eid="LUK 2:38" /></para>
  <para style="s">Yusupu nʉ Maliamu akʉtulya kʉ Nazaleti</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 2:39" />Yusupu nʉ Maliamu naɨakondya kitʉma intendo yɨhi anga niilagɨigwe mʉmalagɨɨlyo ang’wi Isekʉlʉ Itunda, akatulya kitolao kʉ Nazaleti, kʉkɨsalɨ ka Galilaya. <verse eid="LUK 2:39" /><verse number="40" style="v" sid="LUK 2:40" />Nʉng’wana, ʉ Yesʉ akalongoleka kʉkʉla nʉ kʉlija ingulu nɨmahala nʉʉkende wang’wi Itunda aɨʉkolɨ kʉng’waakwe.<verse eid="LUK 2:40" /></para>
  <para style="s">Yesʉ akalongola pa Nyʉmba ang’wi Itunda</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41" />Yusupu nʉ Maliamu aleli ang’wa Yesʉ myaka ɨhi aɨza akete wɨda wakʉlongola kʉ Yelusalemu matungo iloeelya nɨla Pasaka. <verse eid="LUK 2:41" /><verse number="42" style="v" sid="LUK 2:42" />Yesʉ naɨwapisha myaka ikʉmi naɨbɨɨlɨ, akalongolanya nɨaleli akwa kiloeelya anga naɨwɨda wao. <verse eid="LUK 2:42" /><verse number="43" style="v" sid="LUK 2:43" />Naɨ amalɨnkɨɨla iloeelya, Yusupu nʉ Maliamu akaze akolɨ mʉnzɨla agomokile kitolao, ingɨ ʉmʉhʉmba Yesʉ akasaga kʉ Yelusalemu ɨaleli akwe shanga akaze alɨngile. <verse eid="LUK 2:43" /><verse number="44" style="v" sid="LUK 2:44" />Aleli aɨasɨgile kɨna ʉng’wana ʉkolɨ palʉng’wɨ nɨanyamʉhɨnzo aʉya. Akagenda pii ng’ʉng’wɨ wɨhi, kʉnsoko shanga aɨakendamʉona akatula mʉduma mʉanyandʉngʉ nʉ mʉahʉmbaʉya. <verse eid="LUK 2:44" /><verse number="45" style="v" sid="LUK 2:45" />Naɨamʉʉlya, Yusupu nʉ Maliamu akatulya kʉ Yelusalemu endemʉdumɨla kʉko. <verse eid="LUK 2:45" /><verse number="46" style="v" sid="LUK 2:46" />Lʉhikʉ nʉlakataatʉ akamʉona Pa Nyʉmba ang’wi Itunda, wikiɨ pakatɨ aamanyisi, ʉategeeye nʉkʉakolya makolyo. <verse eid="LUK 2:46" /><verse number="47" style="v" sid="LUK 2:47" />Awa ɨhi naɨategeeye inkani yakwe aɨakʉɨwe kʉona ʉkete mahala nʉʉhumi ʉkʉlʉ nʉakʉlɨnga nʉkʉsʉkɨɨlya. <verse eid="LUK 2:47" /><verse number="48" style="v" sid="LUK 2:48" />Yusupu nʉ Maliamu naɨamʉona akakʉɨlwa. Ʉnyinya akamʉkolya, “Ng’waane nɨkɨ nʉakʉtendeela itɨ? Goza ʉnene nʉtataako kainakʉduma kʉnʉ kogopile.”<verse eid="LUK 2:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 2:49" />Yesʉ akaakolya, “Kʉnɨkɨ mʉkʉnduma? Shanga mʉlɨngilene kɨna ʉnene ntakɨwe kishiɨ Pa Nyʉmba ang’wa Tataane?” <verse eid="LUK 2:49" /><verse number="50" style="v" sid="LUK 2:50" />Aleli akwe shanga akalʉlɨnga ʉlʉkani nʉatambʉɨe.<verse eid="LUK 2:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 2:51" />Sʉnga akalongolania nɨenso kʉ Nazaleti, nʉng’wenso aɨʉkete lwijo kʉaleli akwe. Ingɨ ʉnyinya akamaɨka ɨmakani aya ɨhi mʉnkolo akwe. <verse eid="LUK 2:51" /><verse number="52" style="v" sid="LUK 2:52" />Nʉng’wenso Yesʉ akakʉla nʉkongeeleka kukula kimuili nɨmahala, aze ʉmʉloeeye Itunda nɨantʉ.<verse eid="LUK 2:52" /></para>
  <chapter eid="LUK 2" />
  <chapter number="3" style="c" sid="LUK 3" />
  <para style="s">Yohana mʉbadisi ʉkʉatanantɨlya ɨantʉ</para>
  <para style="r">
    <ref loc="MAT 3:1-12">Matayo 3:1-12</ref>; <ref loc="MRK 1:1-8">Maliko 1:1-8</ref>; <ref loc="JHN 1:19-28">Yohana 1:19-28</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1" />Mʉng’waka nʉikʉmi naɨtaano nʉakʉtema, ʉmʉtemi nʉitangwaa Tibelio. Pantio pilato aɨmʉkʉlʉ wihɨɨ akʉ Yʉdea. Helode aɨmʉkʉlʉ nʉa kʉ Galilaya, nʉ Pilipo mʉlunaakwe aɨmʉkʉlʉ nʉakʉ Itilea palʉng’wɨ nɨ Tilakiniti. Nʉ Lusania aɨmʉkʉlʉ nʉakʉ Abilene, <verse eid="LUK 3:1" /><verse number="2" style="v" sid="LUK 3:2" />nʉ Anasi nʉ Kayapa akaze apolyi nɨakʉlʉ. Matungo nanso ʉlʉkani lang’wi Itunda lʉkamʉzɨɨla ʉ Yohana ng’wana wang’wa Zakalia ʉko kʉwɨɨ. <verse eid="LUK 3:2" /><verse number="3" style="v" sid="LUK 3:3" />Yohana akalongola mumahɨɨ ɨhi nɨkolɨ mʉmpelo mpelo amongo nʉa Yolodani, wazeatanantɨlya ɨantʉ kila itʉnʉ abadisigwe Itunda wahume kʉlekela ɨmɨlandʉ ao. <verse eid="LUK 3:3" /><verse number="4" style="v" sid="LUK 3:4" />Anga niiandɨkilwe mʉmbugulu ang’wa Isaya mʉmanga wang’wi Itunda kɨna,</para>
  <para style="q" vid="LUK 3:4">“Lʉli nʉla mʉntʉ nʉkitanga muwii,</para>
  <para style="q" vid="LUK 3:4">‘noneelyi inzila nʉkʉkiila Isekʉlʉ nʉɨkɨza,</para>
  <para style="q" vid="LUK 3:4">gooli nʉziiza kiila.<verse eid="LUK 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="LUK 3:5" />makombogela ihi mʉnzila akʉtuhiilwa,</para>
  <para style="q" vid="LUK 3:5">mʉigʉngʉʉku yʉkʉtalantaligwa.</para>
  <para style="q" vid="LUK 3:5">Nzɨla niikunyangile yikugoolwa,</para>
  <para style="q" vid="LUK 3:5">ni nzila nimbii yukunonigwa.<verse eid="LUK 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="LUK 3:6" />Antʉ ɨhi akʉona ʉponyi nʉʉkʉletwa ni Itunda.”’<verse eid="LUK 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7" />Yohana akatula atambʉɨla iumbɨ nɨlaantʉ naɨazile abadisigwe nʉng’wenso, “Ʉnyenye wileli nua nzoka. Nyenyu nʉmʉhʉgʉe kʉpona ikuo lang'wi Itunda nɨlɨpembilye? <verse eid="LUK 3:7" /><verse number="8" style="v" sid="LUK 3:8" />Itʉmi intendo niikʉlagɨɨla kɨna milaa itʉnʉ. Hangɨ mʉleke kʉsɨgi mʉnkolo yanyu kɨna kʉkete tataa itʉ Ibulahimu. Kʉnsoko kʉmʉɨla, Itunda ʉhumile kʉmʉpa ʉ Ibulahimu ɨana kʉpuma mʉmagwe aya. <verse eid="LUK 3:8" /><verse number="9" style="v" sid="LUK 3:9" />Nitungo ɨlɨ ihengo lahʉmbʉlwa kʉtema matina amɨtɨ. Mʉtɨ wɨhi nɨshanga wɨpaa inkalɨ ninziza ʉkʉteng’wa nʉkʉgʉmɨlwa mʉmoto.”<verse eid="LUK 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10" />Iantʉ naɨilʉndile pang’wanso akamʉkolya, “Kʉtende ʉlɨgwa?”<verse eid="LUK 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 3:11" />Yohana akaatambʉɨla, “Mʉntʉ nʉkete mɨjʉlʉngʉ ɨbɨɨlɨ nʉamomoele ʉyʉ nɨmʉgila anga mɨjʉlʉngʉ, nʉkete indya nʉamʉgeele ʉmʉnyanzala.”<verse eid="LUK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 3:12" />Nawa nɨɨhangʉlya impia akapembya ahume kʉbadisigwa, akamʉkolya, “Mʉmanyisi ʉsese itakɨwe kʉtendeʉlɨ?”<verse eid="LUK 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 3:13" />Yohana akaasʉkiɨlya, “Nɨmʉkʉhangʉlya impia leki kʉholi kʉkɨlɨnkɨɨlya mʉitakɨwe.”<verse eid="LUK 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 3:14" />Amboi nɨenso akamʉkolya, “Aʉsese kʉtakɨwe kʉtendaʉlɨ?”</para>
  <para style="q" vid="LUK 3:14">Akaaɨla, “Leki kʉmuhegelya mʉntʉ wɨhi ang’wɨ kʉmʉsongeela mʉntʉ wɨhi, mikʉte niipegwa nɨmʉkʉpegwa.”<verse eid="LUK 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15" />Antʉ naɨasʉmbɨɨye kʉpembya kʉng’wa Kilisito nʉhoilwe ni Itunda akatulasɨga mʉnkolo yao kɨna ʉ Yohana yʉyʉ ng’wenso Kilisito nʉholiwe ni Itunda. <verse eid="LUK 3:15" /><verse number="16" style="v" sid="LUK 3:16" />Yohana akaatambʉila, “Ʉnene kʉmʉbadisa ʉnyenye kʉmazɨ. Ingɨ ʉpembilye ʉmʉnyangulu kʉkɨla ʉnene, nʉnene shanga nihumile kʉtolya ɨmɨkoha amakwasa akwe. Nʉanso ʉkʉmʉbadisa kʉ Ng’wahʉ wang’wi Itunda nʉ kʉmoto. <verse eid="LUK 3:16" /><verse number="17" style="v" sid="LUK 3:17" />Mʉmʉkono wakwe ʉhoile kisela, nʉyo ʉkʉʉgɨɨlya ɨkɨʉga kakwe iza, wahume kʉpeta ʉilo nʉkʉɨkɨla misalanka lakwe, ipuko ʉkʉlisonsa mʉmoto nɨshanga wɨlimaa.”<verse eid="LUK 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 3:18" />Mʉnkani niyanso nɨmaʉya ɨdʉ Yohana aiʉkenda ahʉgʉla nʉkʉakania nʉkʉatanantɨlya Nkani Nziza niang’wi Itunda. <verse eid="LUK 3:18" /><verse number="19" style="v" sid="LUK 3:19" />Ingɨ Yohana naɨwamʉkenela ʉmʉtemi Helode kigazo nilakʉmʉtina ʉ Helodia mʉsʉngʉ wang’wa heu wakwe, nʉʉbɨ wɨdʉ naɨ witʉmile, <verse eid="LUK 3:19" /><verse number="20" style="v" sid="LUK 3:20" />mʉtemi Helode akongeelya kitʉma ʉbɨ, akamʉamba ʉ Yohana nʉkʉmʉtunga mʉkadulumu.<verse eid="LUK 3:20" /></para>
  <para style="s">Yesʉ ʉkʉbadisigwa</para>
  <para style="r">
    <ref loc="MAT 3:13-17">Matayo 3:13-17</ref>; <ref loc="MRK 1:9-11">Maliko 1:9-11</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21" />Antʉ ɨhi naɨakʉbadisigwa, Yesʉ nʉng'weso wɨkabadisigwa. Yesʉ naɨʉkʉlompa, igʉlʉ lɨkalʉgʉka. <verse eid="LUK 3:21" /><verse number="22" style="v" sid="LUK 3:22" />Ng’wahʉ wang’wi Itunda wɨkasima migʉlya akwe kʉpembelya kigʉlʉ kʉmpyani ankʉnda, lʉli kʉpuma kigʉlʉ lɨkigigwa, “Ʉewe wing’waane ninʉkʉloilwe, ʉnene naloeeligwa nʉewe.”<verse eid="LUK 3:22" /></para>
  <para style="s">Ndʉgʉ ang’wa Yesʉ</para>
  <para style="r">
    <ref loc="MAT 1:1-17">Matayo 1:1-17</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23" />Yesʉ naɨʉkandya kitʉma ʉmʉlimo wakwe aiʉkete myaka makʉmi ataatʉ, antʉ aɨamʉlɨngɨle kɨna ng’wana wang’wa Yusupu, Yusupu aɨng’wana wang’wa Eli, <verse eid="LUK 3:23" /><verse number="24" style="v" sid="LUK 3:24" />Eli aɨng’wana wang’wa Matati nʉ Matati aɨng’wana wang’wa Lawi nʉ Lawi ʉyʉ aɨng’wana wang’wa Meliki nʉ Meliki aɨng’wana wang’wa Yanai nʉ Yanai aɨng’wana wang’wa Yusupu. <verse eid="LUK 3:24" /><verse number="25" style="v" sid="LUK 3:25" />Yusupu aɨng’wana wang’wa Matatia nʉ Matatia ʉyʉ aɨng’wana wang’wa Amosi nʉ Amosi ʉyʉ aɨng’wana wang’wa Nahumu nʉ Nahumu aɨng’wana wang’wa Esili nʉ Esili aɨng’wana wang’wa Nagai. <verse eid="LUK 3:25" /><verse number="26" style="v" sid="LUK 3:26" />Nagai aɨng’wana wang’wa Maati nʉ Maati aɨng’wana wang’wa Matatia nʉ Matatia aɨng’wana wang’wa Semeini nʉ Semeini aɨng’wana wang’wa Yoseki nʉ Yoseki aɨng’wana wang’wa Yoda, <verse eid="LUK 3:26" /><verse number="27" style="v" sid="LUK 3:27" />Yoda aɨng’wana wang’wa Yoanani nʉ Yoanani aɨng’wana wang’wa Lesa nʉ Lesa aɨng’wana wang’wa Zelubabeli nʉ Zelubabeli aɨng’wana wang’wa Shealitɨeli nʉ Shealitɨeli aɨng’wana wang’wa Neli, <verse eid="LUK 3:27" /><verse number="28" style="v" sid="LUK 3:28" />Neli aɨng’wana wang’wa Meliki nʉ Meliki aɨng’wana wang’wa Adi nʉ Adi aɨng’wana wang’wa Kosamu nʉ Kosamu aɨng’wana wang’wa Elimadamu nʉ Elimadamu aɨng’wana wang’wa Eli, <verse eid="LUK 3:28" /><verse number="29" style="v" sid="LUK 3:29" />Eli aɨng’wana wang’wa Yoshua nʉ Yoshua aɨng’wana wang’wa Eliezeli nʉ Eliezeli aɨng’wana wang’wa Yolimu nʉ Yolimu aɨng’wana wang’wa Matati nʉ Matati aɨng’wana wang’wa Lawi, <verse eid="LUK 3:29" /><verse number="30" style="v" sid="LUK 3:30" />Lawi aɨng’wana wang’wa Simeoni nʉ Simeoni aɨng’wana wang’wa Yʉda nʉ Yʉda aɨng’wana wang’wa Yosepu nʉ Yosepu aɨng’wana wang’wa Yonamu nʉ Yonamu aɨng’wana wang’wa Eliyakimu nʉ Eliyakimu aɨng’wana wang’wa Melea, <verse eid="LUK 3:30" /><verse number="31" style="v" sid="LUK 3:31" />Melea aɨng’wana wang’wa Mena nʉ Mena aɨng’wana wang’wa Matata nʉ Matata aɨng’wana wang’wa Natani nʉ Natani aɨng’wana wang’wa Daudi, <verse eid="LUK 3:31" /><verse number="32" style="v" sid="LUK 3:32" />Daudi aɨng’wana wang’wa Yese nʉ Yese aɨng’wana wang’wa Obedi nʉ Obedi aɨng’wana wang’wa Boazi nʉ Boazi aɨng’wana wang’wa Salimoni nʉ Salimoni aɨng’wana wang’wa Nashoni, <verse eid="LUK 3:32" /><verse number="33" style="v" sid="LUK 3:33" />Nashoni aɨng’wana wang’wa Aminadabu nʉ Aminadabu aɨng’wana wang’wa Alamu nʉ Alamu aɨng’wana wang’wa Hesiloni nʉ Hesiloni aɨng’wana wang’wa Pelesi nʉ Pelesi aɨng’wana wang’wa Yʉda, <verse eid="LUK 3:33" /><verse number="34" style="v" sid="LUK 3:34" />Yʉda aɨng’wana wang’wa Yakobo nʉ Yakobo aɨng’wana wang’wa Isaki nʉ Isaki aɨng’wana wang’wa Abulahamu nʉ Abulahamu aɨng’wana wang’wa Tela nʉ Tela aɨng’wana wang’wa Naholi, <verse eid="LUK 3:34" /><verse number="35" style="v" sid="LUK 3:35" />Naholi aɨng’wana wang’wa Selugi nʉ Selugi aɨng’wana wang’wa Leu nʉ Leu aɨng’wana wang’wa Pelegi nʉ Pelegi aɨng’wana wang’wa Ebeli nʉ Ebeli aɨng’wana wang’wa Shela, <verse eid="LUK 3:35" /><verse number="36" style="v" sid="LUK 3:36" />Shela aɨng’wana wang’wa Kenani nʉ Kenani aɨng’wana wang’wa Alipakisadi nʉ Alipakisadi aɨng’wana wang’wa Shemu nʉ Shemu aɨng’wana wang’wa Nuhu nʉ Nuhu aɨng’wana wang’wa Lameki, <verse eid="LUK 3:36" /><verse number="37" style="v" sid="LUK 3:37" />Lameki aɨng’wana wang’wa Metʉsela nʉ Metʉsela aɨng’wana wang’wa Enoki nʉ Enoki aɨng’wana wang’wa Yaledi nʉ Yaledi aɨng’wana wang’wa Mahalaleli nʉ Mahalaleli aɨng’wana wang’wa Kenani, <verse eid="LUK 3:37" /><verse number="38" style="v" sid="LUK 3:38" />Kenani aɨng’wana wang’wa Enoshi nʉ Enoshi aɨng’wana wang’wa Seti nʉ Seti aɨng’wana wang’wa Adamu nʉ Adamu aɨng’wana wang’wi Itunda.<verse eid="LUK 3:38" /></para>
  <chapter eid="LUK 3" />
  <chapter number="4" style="c" sid="LUK 4" />
  <para style="s">Yesʉ ukugeng’wa</para>
  <para style="r">
    <ref loc="MAT 4:1-11">Matayo 4:1-11</ref>; <ref loc="MRK 1:12-13">Maliko 1:12-13</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1" />Yesʉ akaze ʉkete ngulu nia Ng’wahʉ wang’wi Itunda, akahega kʉmongo nʉa Yolodani, akatongwa nʉ Ng’wahʉ wang’wi Itunda kʉlongola kuwɨɨ, <verse eid="LUK 4:1" /><verse number="2" style="v" sid="LUK 4:2" />kʉng’wanso akatula geng’wa nʉ shetani mahikʉ makʉmi anɨɨ itungo nɨlanso lɨhi shanga aɨʉkendalya anga kɨntʉ, sʉnga akahʉng’wa nzala. <verse eid="LUK 4:2" /><verse number="3" style="v" sid="LUK 4:3" />Shetani akamʉɨla, “Angaɨze tai ʉewe wɨng’wana wang’wi Itunda lɨpɨʉle igwe ɨlɨ lɨtule lʉdya ʉhume kʉlya.”<verse eid="LUK 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 4:4" />Yesʉ akamʉsʉkɨɨlya, “Iandɨkilwe, ‘mʉntʉ shanga ʉsanilye angandya ʉdu wahume kishiɨ, ʉsanilye lʉkani lang’wi Itunda”’<verse eid="LUK 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5" />Shetani akamʉtonga kʉmʉtwala kʉpikɨɨla mʉlʉgʉlʉ nʉlʉlɨpu, kitungo lɨng'wɨ akamʉlagɨɨla ʉtemi wɨhi nʉa mʉʉnkʉmbigʉlʉ. <verse eid="LUK 4:5" /><verse number="6" style="v" sid="LUK 4:6" />Shetani akamʉɨla, “Kʉʉhumya kʉtema ʉtemi ʉwʉ wɨhi nʉʉza wakwe kʉnsoko akolɨ mʉʉhumi wane, nʉnene nihumile kʉmʉpeza wɨhi nɨnʉmʉloilwe. <verse eid="LUK 4:6" /><verse number="7" style="v" sid="LUK 4:7" />Anga ʉewe ʉkʉnkʉlye ʉnene, maintʉ ayaitɨ ɨhi akʉtula ako.”<verse eid="LUK 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 4:8" />Ingɨ Yesʉ akamʉsʉkɨɨlya, “Hangɨ yandɨkilwe ‘mʉkʉlye Isekʉlʉ Itunda nʉkʉmitʉmɨla ʉng’wenso du.”’<verse eid="LUK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 4:9" />Shetani akamʉtwala kʉ Yelusalemu, akamʉnankɨlya mʉkilingasiilyo ka Nyʉmba ang’wi Itunda akamʉɨka kʉnsonge, akamʉɨla ʉ Yesʉ, “Ang’wɨ tai ʉewe wɨng’wana wang’wi Itunda, sialɨ igʉme pɨhi kʉpʉmɨɨla apa, <verse eid="LUK 4:9" /><verse number="10" style="v" sid="LUK 4:10" />kʉnsoko iandɨkilwe, ‘Itunda ʉkʉʉlagɨɨlɨlya Itumi akwe nɨakigʉlʉ akʉake, <verse eid="LUK 4:10" /><verse number="11" style="v" sid="LUK 4:11" />akʉʉhola mʉmɨkonoao nʉmʉgʉlʉ wako shanga ʉkikʉɨlya migwe”’<verse eid="LUK 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 4:12" />Ingɨ Yesʉ akamʉsʉkɨɨlya ʉshetani, “Hangi yandɨkilwe, ‘Leka kʉmʉgema Isekʉlʉ Itunda ako”’<verse eid="LUK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13" />Shetani naɨwakondya kʉmʉgema ʉ Yesʉ, akamʉleka, akatungɨla itungo nɨlɨgombekile.<verse eid="LUK 4:13" /></para>
  <para style="s">Yesʉ ʉkandya ʉmʉlɨmo wakwe kʉ Galilaya</para>
  <para style="r">
    <ref loc="MAT 4:12-17">Matayo 4:12-17</ref>; <ref loc="MRK 1:14-15">Maliko 1:14-15</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14" />Sʉnga Yesʉ akatʉlya kʉ Galilaya kʉnʉ waze ʉkete ngulu nia Ng’wahʉ wang’wi Itunda, lʉkumo lakwe lɨkakumʉka mʉ Galilaya nɨmahɨɨ ɨhi nakolɨ pakupɨ. <verse eid="LUK 4:14" /><verse number="15" style="v" sid="LUK 4:15" />Akatulingɨla Mʉnyʉmba niakʉtankanɨla Ayahudi mʉng’wanso akatula manyisa, antʉ ɨhi naɨamʉtegeeye akamʉlʉmbɨɨlya.<verse eid="LUK 4:15" /></para>
  <para style="s">Yesʉ ʉkʉhitwa kʉ Nazaleti</para>
  <para style="r">
    <ref loc="MAT 13:53-58">Matayo 13:53-58</ref>; <ref loc="MRK 6:1-6">Maliko 6:1-6</ref></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16" />Yesʉ akalongola kʉ Nazaleti kɨsalɨ naɨʉkʉɨe, naɨlɨlakapika Lʉhikʉ nʉla Kʉsupya nʉlitangwaa Sabato akingɨla Mʉnyʉmba nakʉtankanɨla Ayahudi anga naɨntendo akwe. Akimɨka wahume kʉsoma. <verse eid="LUK 4:16" /><verse number="17" style="v" sid="LUK 4:17" />Akapegwa mbugulu nɨandɨkilwe nʉ Isaya mʉmanga wang’wi Itunda, Yesʉ akakunukula paiandɨkilwe.<verse eid="LUK 4:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="LUK 4:18" />“Ng’wahʉ wang’wi Isekʉlʉ ʉkolɨ mʉng’wane,</para>
  <para style="q" vid="LUK 4:18">kʉnsoko ʉnihoile nɨatanantɨlya ɨahimbɨ Nkani ni Nziza.</para>
  <para style="q" vid="LUK 4:18">Ʉndagɨɨye kʉatanantɨlya ɨatʉng’wa kʉlekelwa kʉng’wao,</para>
  <para style="q" vid="LUK 4:18">nɨapoku ahume kʉona hangɨ,</para>
  <para style="q" vid="LUK 4:18">nʉ kʉalekela awa nɨɨonelwa,<verse eid="LUK 4:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="LUK 4:19" />hangɨ kʉʉtanantya ng’waka wang’wi Isekʉlʉ nʉʉgombekile.”</para>
  <para style="q" vid="LUK 4:19">Nʉang’wi Isekʉlʉ kʉaponya ɨantʉ akwe.<verse eid="LUK 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20" />Sʉnga akakunikila ɨmbugulu ɨyɨ, akamɨsʉsha akikiɨ. Antʉ ɨhi Mʉnyʉmba akʉtankanɨla Ayahudi akamʉgondoola.<verse eid="LUK 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 4:21" />Papo akandɨɨlya kʉatambʉɨla, “Nkani izi lelo yapikɨɨla anga naɨmijaa.”<verse eid="LUK 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22" />Antʉ ɨhi akaloeeligwa nʉ Yesʉ, akakʉɨlwa nkani ninziza nʉtambʉe, akikolya, “Ʉyʉ shanga ng’wana wang’wa Yusupu ne?”<verse eid="LUK 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23" />Yesʉ akaatambʉɨla, “Nɨngile mʉkʉmbɨla ntambʉ ɨyɨ, ‘Mʉlagʉli ilagʉle ʉewe.’ makani ɨhi nanza ʉtendile kʉ Kapelenahumu, itʉme napa mʉkɨsalɨ kako.” <verse eid="LUK 4:23" /><verse number="24" style="v" sid="LUK 4:24" />Yesʉ akatambʉɨɨla, “Ituleʉʉ kʉmʉɨla, mʉmanga shanga wɨkʉligwa nɨantʉ amʉkɨsalɨ kakwe.”<verse eid="LUK 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 4:25" />“Kʉmʉlompa mʉntegeelye, Ingɨ ɨtai kɨna matungo ang’wa Eliya mʉmanga wang’wi Itunda aɨakolɨ asʉngʉ ɨdʉ nɨashɨɨwe nɨagoha ʉko kʉ Isilaeli, ilunde aɨlɨgiɨigwe nɨmbʉla shanga ɨkakʉa kʉ myaka ɨtaatʉ nɨ myeli mʉtandatʉ, lɨkigela izala ikʉlʉ mihɨɨ ɨhi. <verse eid="LUK 4:25" /><verse number="26" style="v" sid="LUK 4:26" />Nɨitɨga ʉ Eliya shanga aɨʉlagɨigwe kʉasʉngʉ nɨanso nɨashɨɨwe nɨagohaao, akalagɨlɨigwa kʉ mʉsʉngʉ ʉng’wɨ nʉshɨɨwe nʉmʉgoha ʉko kʉ Seleputa mihɨɨ akʉ Sidoni. <verse eid="LUK 4:26" /><verse number="27" style="v" sid="LUK 4:27" />Hangɨ aɨakolɨ antʉ ɨdʉ naiambʉe mihɨɨ a Isilaeli matungo ang’wa Elisha. Hangɨ aɨikɨlɨ wigele mʉntʉ nʉanambʉ nʉaponigwe, ingɨ ʉ Naamani du mʉnyakʉ Silia.”<verse eid="LUK 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28" />Antʉ ɨhi pa Nyʉmba akʉtankanɨla Ayahudi naɨakija inkani izi akabɨpɨlwa nangaluu. <verse eid="LUK 4:28" /><verse number="29" style="v" sid="LUK 4:29" />Akimɨka, akamʉamba ʉ Yesʉ akamʉkweha nʉkʉmʉpumya kʉnzi akɨsalɨ, akamʉtwala kɨgɨɨlɨ lalʉgʉlʉ kaɨ kɨzengilwe ɨkɨsalɨ, akamʉpisha migɨɨlɨ la lʉgʉlʉ ahume kʉmʉgʉmɨla. <verse eid="LUK 4:29" /><verse number="30" style="v" sid="LUK 4:30" />Ingɨ Yesʉ akitʉntʉmɨɨlya akakɨɨla pakatɨ ao akalongola yakweʉ.<verse eid="LUK 4:30" /></para>
  <para style="s">Yesʉ ʉkʉheja hɨng’wɨ mʉ mʉntʉ</para>
  <para style="r">
    <ref loc="MRK 1:21-28">Maliko 1:21-28</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31" />Sʉnga ʉ Yesʉ akahulumʉka kʉ Kapelenaumu mʉkɨsalɨ ka Galilaya, mʉ Lʉhikʉ nʉla Kʉsupya akatula amanyisa iantʉ. <verse eid="LUK 4:31" /><verse number="32" style="v" sid="LUK 4:32" />Antʉ akakʉɨlwa ʉmanyisi wakwe, kʉnsoko aɨʉkʉmanyisa kʉʉhumi. <verse eid="LUK 4:32" /><verse number="33" style="v" sid="LUK 4:33" />Pa Nyʉmba akʉtankanɨla Ayahudi aɨʉkolɨ mʉntʉ ʉkete ahɨng’wɨ, akazogolya nʉkitʉnta wazelunga, <verse eid="LUK 4:33" /><verse number="34" style="v" sid="LUK 4:34" />“Ʉloilwe kʉʉtenda ʉli Yesʉ mʉnya kʉ Nazaleti? Kʉleke. Itɨɨ ʉzile kʉʉlimansɨɨlyane? Nʉkʉlɨngile ʉewe winyenyu. Ʉewe ingɨ ʉhoilwe kʉnsoko ang’wi Itunda.”<verse eid="LUK 4:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 4:35" />Ʉʉgwa Yesʉ akamʉkenela uhɨng’wɨ nʉanso, akamʉɨla “Kɨlaga ihɨtwɨ hangɨ hega kʉmʉntʉ ʉyʉ.” Ʉhɨng’wɨ akamʉkatʉlya pihɨ ʉmʉntʉ ʉyʉ pantongeela ao ɨhi, akapuma shanga ʉmʉlemaaye.<verse eid="LUK 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 4:36" />Antʉ ɨhi akakʉɨlwa akitambʉlya, Ʉmanyisi ʉwʉ wakɨnyaʉlɨ? Ʉkʉakenela ɨahɨng’wɨ kʉʉhumi ʉkʉlʉ, nao akʉhega.” <verse eid="LUK 4:36" /><verse number="37" style="v" sid="LUK 4:37" />Lʉkumo lakwe lɨkakumʉka nkɨka yɨhi nihɨɨ nanso.<verse eid="LUK 4:37" /></para>
  <para style="s">Yesʉ ʉkʉaponya antʉ ɨdʉ</para>
  <para style="r">
    <ref loc="MAT 8:14-17">Matayo 8:14-17</ref>; <ref loc="MRK 1:29-34">Maliko 1:29-34</ref></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38" />Yesʉ akapuma pa Nyʉmba akʉtankanɨla Ayahudi akalongola kitolang’wa Simioni. Mʉkwing’wa nʉakɨsʉngʉ nʉang’wa Simioni aɨwalwae ikʉlʉ, akamʉlompa ʉ Yesʉ wamʉponyie. <verse eid="LUK 4:38" /><verse number="39" style="v" sid="LUK 4:39" />Yesʉ akahumbeela pa mʉlwae akaʉtambʉɨla ʉlwae ʉpume kʉ mʉntʉ ʉyʉ, ʉlwae ʉkapuma, Itungo lɨlo lɨɨlo akaʉka nʉkandya kʉatʉmɨkɨla.<verse eid="LUK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40" />Lyoa naɨlɨkʉhaɨɨla, antʉ ɨhi naɨakete ɨalwae andwala yɨsa akaaleta alwaeao kʉng’wa Yesʉ, nʉ Yesʉ akakaɨkɨɨlya ihi mikono akaalompeela, akaaponya. <verse eid="LUK 4:40" /><verse number="41" style="v" sid="LUK 4:41" />Ahɨng’wɨ akapuma mʉalwae nɨanso akaze azogooye nʉkʉlʉnga, “Ʉewe ingɨ Ng’wana wang’wi Itunda.”</para>
  <para style="p" vid="LUK 4:41">Yesʉ akaakenela akɨlage, kʉnsoko aɨalɨngile kɨna nʉanso ingɨ Kilisito naiuhoilwe ni Itunda.<verse eid="LUK 4:41" /></para>
  <para style="s">Yesʉ ʉkʉtanantya nkani nziza kʉ Yʉdea</para>
  <para style="r">
    <ref loc="MRK 1:35-39">Maliko 1:35-39</ref></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42" />Mʉdaʉ maniambwa, Yesʉ akikoma wing’wene. Antʉ akatula mʉduma, naɨakamʉona akagema kʉmʉgiɨlya waleke kʉhega.<verse eid="LUK 4:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 4:43" />Ingɨ ʉ Yesʉ akaatambʉɨla, “Ntakɨwe kʉtanantya Nkani Nziza nia ʉtemi wang’wi Itunda mʉisalɨ ingɨɨza, kʉnsoko wʉwʉ mʉlɨmo aɨntʉmilwe ni Itunda nitʉme.”<verse eid="LUK 4:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 4:44" />Itigwa akalongoleka kʉtanantya Pa Nyʉmba niakʉtankanɨla Ayahudi niya kʉ Yʉdea.<verse eid="LUK 4:44" /></para>
  <chapter eid="LUK 4" />
  <chapter number="5" style="c" sid="LUK 5" />
  <para style="s">Yesʉ ʉkʉahola amanyisigwa ang’wandyo</para>
  <para style="r">
    <ref loc="MAT 4:18-20">Matayo 4:18-20</ref>; <ref loc="MRK 1:16-20">Maliko 1:16-20</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1" />Lʉhikʉ naɨlʉtyatile Yesʉ aɨwimɨkile mʉnshembo alʉzɨ nʉla Genezaleti, antʉ aɨakʉmʉnyoma ahume kʉtegeelya lʉkani lang’wi Itunda. <verse eid="LUK 5:1" /><verse number="2" style="v" sid="LUK 5:2" />Mʉmpelo amazɨ akaona mabɨnɨ abɨɨlɨ, akazealekilwe papo abui akʉnɨng’anɨɨlya nyabu yao. <verse eid="LUK 5:2" /><verse number="3" style="v" sid="LUK 5:3" />Yesʉ akanankɨla mibɨnɨ lang’wa Simoni, akamʉlompa walɨsuntɨɨlye mʉmazɨ kʉlɨ iniino nɨnshembo. Akikiɨ akandya kʉamanyisa iantʉ wazeʉmolɨ mibɨnɨ. <verse eid="LUK 5:3" /><verse number="4" style="v" sid="LUK 5:4" />Naɨwakondya kʉmanyisa akamʉɨla ʉ Simoni, “Twala ibɨnɨ pamazɨ ɨdʉ mʉgʉmɨle ɨnyabʉ mʉmazɨ mʉbue insamaki.”<verse eid="LUK 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 5:5" />Simoni akamʉsʉkɨɨlya ʉ Yesʉ, “Ʉewe Isekʉlʉ kagile kʉbua nsamaki ʉtikʉga kaʉlya anga kɨntʉ, kʉnsoko wewe ʉtambʉe kʉʉgʉmɨla ɨnyabu mʉmazɨ.” <verse eid="LUK 5:5" /><verse number="6" style="v" sid="LUK 5:6" />Naɨagʉmɨla ɨnyabu mʉmazɨ akabua nsamaki idʉ, sʉnga nyabu niao ikatula tamʉka. <verse eid="LUK 5:6" /><verse number="7" style="v" sid="LUK 5:7" />Akaakʉlya awo naɨakete ibɨnɨ lʉlya azeaaɨlya. Akiza nsamaki yɨkizʉla, mʉmabɨnɨ ɨhi abɨɨlɨ ɨkatula hegenteela. <verse eid="LUK 5:7" /><verse number="8" style="v" sid="LUK 5:8" />Simoni Petelo naɨwamaona ayaitɨ akatugama pang’wa Yesʉ, akalʉnga, “Isekʉlʉ hega kʉng’waane, kʉnsoko ʉnene nɨmʉntʉ nɨ mʉnyamɨlandʉ!”<verse eid="LUK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 5:9" />Simoni nawa ɨhi naɨine aɨalɨkʉɨwe kʉnsoko ilʉndo nɨla nsamaki naɨabuile. <verse eid="LUK 5:9" /><verse number="10" style="v" sid="LUK 5:10" />Itɨ ʉʉgwa ahʉmbaʉya ang’wa Simoni a Yakobo nʉ Yohana anaang’wa Zebedayo nɨenso akakʉɨlwa. Sʉnga ʉ Yesʉ akamʉɨla ʉ Simoni Petelo, “Leka kʉkʉɨlwa, kʉpumɨɨla ino shanga mʉkʉtula mɨabua nsamaki, ingɨ mʉkʉtulɨngɨila antʉ atule amanyisigwa ane.”<verse eid="LUK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 5:11" />Ʉʉgwa akasuntɨɨlya ɨmabɨnɨ mʉnshembo alʉzɨ, akaleka maintʉ ɨhi akityata ʉ Yesʉ.<verse eid="LUK 5:11" /></para>
  <para style="s">Yesʉ ʉkʉmʉponya mʉntʉ nʉambʉe</para>
  <para style="r">
    <ref loc="MAT 8:1-4">Matayo 8:1-4</ref>; <ref loc="MRK 1:40-45">Maliko 1:40-45</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12" />Lʉhikʉ lʉng’wi Yesʉ naɨʉkolɨ mʉkɨsalɨ kɨng’wɨ, mʉntʉ ʉng’wɨ naɨwambʉe nambʉ mʉɨlɨ wakwe wɨhi akapembya, naɨwamʉona ʉ Yesʉ, mʉntʉ ʉyʉ akatugama ʉsʉ wakwe ʉkakinyɨlya pihɨ akamʉlompa. “Isekʉlʉ angaikʉloe ʉhumile kʉnelya nihume kʉmʉkʉlya Itunda.”<verse eid="LUK 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 5:13" />Yesʉ akamʉamba ʉmʉkono akamʉɨla, “Ndoilwe, weligwe.” Nambʉ ɨkalimila akagombeka kʉmʉkʉlya Itunda. <verse eid="LUK 5:13" /><verse number="14" style="v" sid="LUK 5:14" />Yesʉ akamʉgilya, “Leka kʉmisasɨla mʉntʉ wɨhi, itungo ɨlɨ longola wiambye kʉapolyi kɨna ɨnambʉ alimɨla, kʉng’wanso ʉpumye ipolyo anga naɨʉlagɨɨye ʉ Musa kʉantʉ ɨhi kɨna weligwa.”<verse eid="LUK 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 5:15" />Nɨitɨga inkani izi yikakumʉka mpande yɨhi. Antʉ ɨdʉ akapembya ahume kʉponyigwa malwae ao. <verse eid="LUK 5:15" /><verse number="16" style="v" sid="LUK 5:16" />Nɨitɨga Yesʉ aɨwikoma kʉlɨ nɨantʉ, kʉng’wanso aɨwɨmʉlompa Itunda.<verse eid="LUK 5:16" /></para>
  <para style="s">Yesʉ ʉkʉmʉponya mʉntʉ nʉlemilwe kʉgenda</para>
  <para style="r">
    <ref loc="MAT 9:1-8">Matayo 9:1-8</ref>; <ref loc="MRK 2:1-12">Maliko 2:1-12</ref></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17" />Lʉhikʉ lʉng’wɨ Yesʉ aɨʉkʉmanyisa, Apalisayo nɨamanyisi amalagɨɨlyo ang’wa Musa, antʉ kʉpuma kʉisalɨ niakʉ Galilaya nʉ Ʉyahudi ni Yelusalemu akapembya akamʉtegeelya. Akaze aponya alwae kʉʉhumi wang’wi Isekʉlʉ. <verse eid="LUK 5:17" /><verse number="18" style="v" sid="LUK 5:18" />Akapika nɨantʉ angɨɨza amʉletile mʉntʉ nʉlemilwe kʉgenda, akaze amʉkenkile mʉmɨangʉ, akagema kʉmingɨlya mʉnyʉmba amʉtenge pamɨgʉlʉ ang’wa Yesʉ. <verse eid="LUK 5:18" /><verse number="19" style="v" sid="LUK 5:19" />Ingɨ naɨleng’wa kʉmingɨlya kʉnsoko amʉkoegano waantʉ, akanankɨla kitembe akatunja paɨʉkoli ʉ Yesʉ akataʉla akalija lyoma akamʉkɨɨlya ʉmʉntʉ nʉlemilwe kʉgenda naɨʉkenkilwe mʉmɨangʉ akamʉsimya nʉkʉmʉtenga pamɨgʉlʉ ang’wa Yesʉ. Antʉ anɨɨ akʉmʉsimya mʉlwae Mʉnyʉmba kʉkɨɨla kitembee. <verse eid="LUK 5:19" /><verse number="20" style="v" sid="LUK 5:20" />Yesʉ akalɨnga kɨna amʉhʉɨɨe, akamʉɨla ʉmʉlwae, “Mʉnyandʉgʉ walekelwa ɨmɨlandʉ ako.”<verse eid="LUK 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 5:21" />Apalisayo nɨamanyisi amalagɨɨlyo ang’wa Musa akatʉlikolya, “Mʉntʉ ʉyʉ watula nyenyu nʉkʉtambʉla inkani niakʉmʉtʉkɨla Itunda? Nyenyu nʉhumile kʉlekela ɨmɨlandʉ, si Itunda dʉne?”<verse eid="LUK 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 5:22" />Yesʉ akaalɨngɨlya ɨmasɨgo ao, akaakolya, “Kʉnɨkɨ mʉkʉsɨga nanso? <verse eid="LUK 5:22" /><verse number="23" style="v" sid="LUK 5:23" />Itɨɨ, kɨntʉni nɨkɨbahu, kʉmʉɨla mʉntʉ ʉyʉ, ‘walekelwa ɨmɨlandʉ ako,’ ang’wɨ kʉlʉnga, ‘Imɨke ʉgende?’ <verse eid="LUK 5:23" /><verse number="24" style="v" sid="LUK 5:24" />Ʉʉgwa ndoilwe mʉlɨnge kɨna, Ʉng’waa Mʉntʉ ʉkete ʉhumi nʉakʉahegelya ɨantʉ mɨlandʉ mʉnʉ mihɨɨ,” Papo paapo akamʉɨla mʉntʉ ʉyʉ nʉlemilwe kʉgenda, “Imɨke kenka ɨmɨangʉ ʉlongole kitolako.”<verse eid="LUK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 5:25" />Mʉntʉ nʉanso akimɨka ntongeela aantʉ ɨhi, akakenka ɨmɨangʉ naɨʉkenkeewe, akalongola kitolakwe kʉnʉ wazemʉkʉlya Itunda. <verse eid="LUK 5:25" /><verse number="26" style="v" sid="LUK 5:26" />Antʉ ɨhi akakʉɨlwa nʉkʉgʉlʉala, akandya kʉmʉkʉlya Itunda, akalʉnga, “Makani aʉkʉɨlwa nɨkʉmaine lelo.”<verse eid="LUK 5:26" /></para>
  <para style="s">Yesʉ ʉkʉmuhola ʉ Lawi kʉtula mʉmanyisigwa wakwe</para>
  <para style="r">
    <ref loc="MAT 9:9-13">Matayo 9:9-13</ref>; <ref loc="MRK 2:13-17">Maliko 2:13-17</ref></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27" />Naɨakɨla aya, Yesʉ nakitʉma aya akapuma kʉnzi, akamʉona mʉhangʉlwa kodi lina lakwe Lawi, wikiɨ paʉhangʉɨlyo nʉampia, Yesʉ akamʉɨla, “Ntyate.” <verse eid="LUK 5:27" /><verse number="28" style="v" sid="LUK 5:28" />Lawi akaʉka, akaleka papo maintʉ akwe ɨhi nʉkʉmʉtyata.<verse eid="LUK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 5:29" />Lawi akamʉnoneelelya ʉ Yesʉ iloeelya kitolakwe, ahangʉlwa kodi ɨdʉ palʉng’wɨ nɨantʉ angɨɨza naɨakolɨ kʉng’wa Lawi akikiɨ akalɨzania indya. <verse eid="LUK 5:29" /><verse number="30" style="v" sid="LUK 5:30" />Apalisayo nɨamanyisi amalagɨɨlyo ang’wa Musa naɨakolɨ miloeelya nɨlanso akatula anang’anɨla iamanyisigwa ang’wa Yesʉ azelʉnga, “Nɨkɨ mʉkʉlɨzania nʉkʉng’wezania nɨahangʉlwa kodi nɨanyamɨlandʉ?”<verse eid="LUK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 5:31" />Yesʉ akaasʉkɨɨlya, “Antʉ nɨapanga shanga ɨpenza anga mʉkilɨki, nɨɨpenza ʉmʉkilɨki ɨza antʉ nɨalwae. <verse eid="LUK 5:31" /><verse number="32" style="v" sid="LUK 5:32" />Shanga aɨnzileaɨla antʉ nɨa nɨaza amʉtyate Itunda, ingɨ aɨnzileaɨla antʉ nɨabɨ, amʉsʉkɨle Itunda.”<verse eid="LUK 5:32" /></para>
  <para style="s">Yesʉ ʉkʉkoligwa makani akʉgwalya</para>
  <para style="r">
    <ref loc="MAT 9:14-17">Matayo 9:14-17</ref>; <ref loc="MRK 2:18-22">Maliko 2:18-22</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33" />Sʉnga antʉ ang’wi akamʉkolya ʉ Yesʉ, “Amanyisigwa ang’wa Yohana mʉbadisi nawa nɨa Aapalisayo ɨgwalya kʉlya nʉkʉng’wa ahume kʉmʉkʉlya Itunda, haɨ amanyisigwa ako kaalongolekile kʉlya nʉkʉng’wa mahikʉ ɨhi.”<verse eid="LUK 5:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 5:34" />Yesʉ akaasʉkɨɨlya, “Itɨɨ, mʉhumilene kʉagilya ɨahʉmbaʉya amʉtɨzɨɨla kʉlya nʉkʉng’wa nɨɨpalʉng’wɨ nʉyo? <verse eid="LUK 5:34" /><verse number="35" style="v" sid="LUK 5:35" />Ingɨ itungo lɨkʉpika ʉmʉtɨzɨɨla nʉɨkahegigwa pang’waao, papo gwa akʉgwalya.”<verse eid="LUK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36" />Yesʉ akaapumɨlya mpyani, “Kʉtilɨ mʉntʉ nʉɨkʉɨɨla kɨlaka kngʉo nipya mitaho. Anga watende iti, ʉkʉtula watamʉla nankanda ngʉo nipya, nɨkɨlaka shanga kɨkendenkania nitaho. <verse eid="LUK 5:36" /><verse number="37" style="v" sid="LUK 5:37" />Ang’wi antʉ shanga ɨkɨtɨla ɨdibai mʉpuko andɨlɨ niikʉlʉpaae, dibai nanso angɨɨlye ɨkʉtamʉla ɨpuko nanso, ɨdibai ɨkʉhunʉka nɨmipuko nanso ɨkʉtamʉka. <verse eid="LUK 5:37" /><verse number="38" style="v" sid="LUK 5:38" />Idibai nɨmpya ɨkɨtɨlwa mʉndɨlɨ nimpya. <verse eid="LUK 5:38" /><verse number="39" style="v" sid="LUK 5:39" />Ang’wi, kʉtilɨ anga mʉntʉ nʉng’wee ɨdibai nakalɨ nʉɨkalowa kʉng’waa ɨdibai nɨmpya, anga watongeelye kʉonza ɨdibai nakalɨ. Ʉkʉlʉnga, ‘Ɨyo nakalɨ nziza mbele.”’<verse eid="LUK 5:39" /></para>
  <chapter eid="LUK 5" />
  <chapter number="6" style="c" sid="LUK 6" />
  <para style="s">Yesʉ ingɨ mʉkʉlʉ nʉa Lʉhikʉ nʉla Kʉsupya</para>
  <para style="r">
    <ref loc="MAT 12:1-8">Matayo 12:1-8</ref>; <ref loc="MRK 2:23-28">Maliko 2:23-28</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1" />Lʉhikʉ lʉng’wɨ nʉla Kʉsupya, Yesʉ nɨamanyisigwa akwe aɨakɨɨe mʉmɨgʉnda angano, amanyisigwa akwe akatula konyola mapemba angano, akapigiha akalya ɨngano akwe. <verse eid="LUK 6:1" /><verse number="2" style="v" sid="LUK 6:2" />Apalisayo ang’wɨ akakolya, “Nɨkɨ mʉkitʉma makani aya nsuta nɨmalagɨɨlyo a Lʉhikʉ nʉla Kʉsupya?”<verse eid="LUK 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 6:3" />Yesʉ akaasʉkɨɨlya, “Itɨɨ, ʉnyenye shanga mʉsomilene naɨʉtendile ʉ Daudi nɨantʉ akwe apo naɨahumilwe nzala? <verse eid="LUK 6:3" /><verse number="4" style="v" sid="LUK 6:4" />Daudi aɨwingɨe Mʉnyʉmba ang’wi Itunda, akahola ɨmɨkate nɨkomilwe kʉlɨgwa nɨapolyi du. Akalya, akainkɨɨlya ɨantʉ akwe nɨenso akalya.”<verse eid="LUK 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 6:5" />Yesʉ akaatambʉɨla, “Ng’waa Mʉntʉ ingɨ Mʉkʉlʉ nʉa Lʉhikʉ nʉla Kʉsupya.”<verse eid="LUK 6:5" /></para>
  <para style="s">Yesʉ ʉkʉmʉponya mʉntʉ nʉkete mʉkono nʉʉkule igandi</para>
  <para style="r">
    <ref loc="MAT 12:9-14">Matayo 12:9-14</ref>; <ref loc="MRK 3:1-3">Maliko 3:1-3</ref></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6" />Mʉlʉhikʉ lulya nula Lʉhikʉ nula Kʉsupya akatulamanyisa pa nyʉmba akʉtankanɨla Ayahudi, Munyumba nanso mʉntʉ ʉng’wɨ mʉkono wakwe nʉakɨgoha aɨʉkule igadi, aɨʉkolɨ mʉng’wanso. <verse eid="LUK 6:6" /><verse number="7" style="v" sid="LUK 6:7" />Apalisayo nɨamanyisi ang’wɨ nɨamalagɨɨlyo aɨɨduma nsoko akʉmʉsemela ʉ Yesʉ, aɨatungɨe aone anga ɨze ʉhumile kʉmʉponya mʉ Lʉhikʉ ʉlʉ nʉla Kʉsupya. <verse eid="LUK 6:7" /><verse number="8" style="v" sid="LUK 6:8" />Ingɨ ʉ Yesʉ akaalɨngɨlya ɨmasɨgoao, ʉʉgwa akamʉɨla mʉntʉ ʉyʉ mʉkono wakwe nʉʉkule igandi, “Ʉka longola wimɨke pantongeela aantʉ,” mʉntʉ ʉyʉ akimɨka pantongeela aantʉ ɨhi. <verse eid="LUK 6:8" /><verse number="9" style="v" sid="LUK 6:9" />Yesʉ akaatambʉɨla, “Kʉmʉkolya, itɨɨ, Lʉhikʉ nʉla Kʉsupya inoneene kitʉma ɨmakani nɨmziza ang’wɨ nɨmabibɨ? Kʉmʉponyaane ʉmʉntʉ ang’wɨ kʉmʉbʉlaga?” <verse eid="LUK 6:9" /><verse number="10" style="v" sid="LUK 6:10" />Yesʉ akaagozeela ɨantʉ mpande yɨhi, sʉnga akamʉɨla mʉntʉ ʉyʉ mʉkono wakwe nʉʉkule igandi, “Goola ʉmʉkono wako.” Akaʉgola ʉmʉkono ʉkapangataala.<verse eid="LUK 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 6:11" />Ingɨ Apalisayo nɨamanyisi awo akahʉng’wa ikuo, akandya kikolya enso kʉenso amʉtendeele ntʉni ʉ Yesʉ.<verse eid="LUK 6:11" /></para>
  <para style="s">Yesʉ ʉkʉholania itʉmi ikʉmi naabɨɨlɨ</para>
  <para style="r">
    <ref loc="MAT 10:1-4">Matayo 10:1-4</ref>; <ref loc="MRK 3:13-19">Maliko 3:13-19</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12" />Lʉhikʉ lʉng’wɨ Yesʉ akalongola mʉlʉgʉlʉ, kʉng’wanso akamʉlompa Itunda ʉtikʉga. <verse eid="LUK 6:12" /><verse number="13" style="v" sid="LUK 6:13" />Naɨwela kɨdaʉdaʉ Yesʉ akaitanga amanyisigwa akwe, akaholania antʉ mʉkatɨ ao ikʉmi naabɨɨlɨ, antʉ awa aɨʉitangile itʉmɨ. <verse eid="LUK 6:13" /><verse number="14" style="v" sid="LUK 6:14" />Antʉ naɨʉahoile aɨ Simoni naɨʉmitangile Petelo nʉ heu wang’wa Petelo nʉitangwa Endelea nʉ Yakobo nʉ Yohana nʉ Pilipo nʉ Batilimayo, <verse eid="LUK 6:14" /><verse number="15" style="v" sid="LUK 6:15" />Matayo nʉ Tomaso nʉ Yakobo ng’wana wang’wa Alipayo nʉ Simoni nʉɨmɨkʉiɨla ihɨɨ akwe <verse eid="LUK 6:15" /><verse number="16" style="v" sid="LUK 6:16" />Yʉda ng’wana wang’wa Yakobo nʉ Yʉda mʉnya kʉ Kaliote naɨʉmʉsuɨpile ʉ Yesʉ.<verse eid="LUK 6:16" /></para>
  <para style="s">Yesʉ ʉkʉponya ɨantʉ</para>
  <para style="r">
    <ref loc="MAT 4:23-25">Matayo 4:23-25</ref></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17" />Yesʉ naiʉhulumʉkile kʉpuma mʉlʉgʉlʉ nɨ itumi, akimɨka pawelela. Pang’wanso aɨlɨkolɨ iumbɨ ikʉlʉ nɨla amanyisigwa akwe nɨantʉ ɨdʉ naɨapembeeye isalɨ yɨhi nia Yʉdea nʉ kʉpuma Yelusalemu ninshembo nia Tilo ni Sidoni. <verse eid="LUK 6:17" /><verse number="18" style="v" sid="LUK 6:18" />Antʉ awa aɨazile mʉtegeelya nʉkʉponyigwa malwae ao. Nɨitɨga antʉ awo naɨagigwa nɨahɨng’wɨ aɨazile akahegeigwe. <verse eid="LUK 6:18" /><verse number="19" style="v" sid="LUK 6:19" />Antʉ ɨdʉ aɨakedahiya kʉmʉamba ʉ Yesʉ kʉnsoko aʉhumi naɨikʉmʉpuma kʉaponya iantʉ.<verse eid="LUK 6:19" /></para>
  <para style="s">Ʉlowa nʉ lwago</para>
  <para style="r">
    <ref loc="MAT 5:1-12">Matayo 5:1-12</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20" />Sʉnga Yesʉ akaapɨlʉkɨla iamanyisigwa akwe akaatambʉɨla,</para>
  <para style="q" vid="LUK 6:20">“Ʉnyenye nɨmɨahimbɨ mʉtendeewe ʉkende ni Itunda,</para>
  <para style="q" vid="LUK 6:20">kʉnsoko ʉtemi wang’wi Itunda ingɨ wanyu.<verse eid="LUK 6:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="LUK 6:21" />Ʉnyenye nɨ mɨanyanzala mʉtendeewe ʉkende ni Itunda,</para>
  <para style="q" vid="LUK 6:21">kʉnsoko mʉkikʉtigwa.</para>
  <para style="q" vid="LUK 6:21">Ʉnyenye nimʉhʉkilye kʉnsoko aʉbɨ, mʉtendeewe ʉkende ni Itunda, kʉnsoko panyambele mʉkʉlowa.<verse eid="LUK 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 6:22" />Mʉtendeewe ʉkende ni Itunda ʉnyenye ɨantʉ nɨamʉbɨpɨwe nʉ kʉmʉkoma nʉ kʉmʉtʉkɨla nʉ kʉmitanga ʉnyenye mɨabɨ, anga lʉkani nʉlʉbi kʉnsoko a Ng’waa Mʉntʉ. <verse eid="LUK 6:22" /><verse number="23" style="v" sid="LUK 6:23" />Iloi nʉkiseseelya kʉʉlowe ningɨligɨlɨ anga mʉhangwe nɨmakani nanso kʉnsoko kɨpengwa kanyu lʉhikʉ nʉlanso ingɨ kɨkʉlʉ kigʉlʉ. Kʉnsoko Atataao aɨatendee ʉʉ ɨamanga ang’wi Itunda.<verse eid="LUK 6:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="LUK 6:24" />“Mʉkaga ʉnyenye nɨmɨagolɨ,</para>
  <para style="q" vid="LUK 6:24">kʉnsoko maligilyee likalo lʉza.<verse eid="LUK 6:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="LUK 6:25" />Mʉkaga ʉnyenye nɨmikutile itungo ɨlɨ,</para>
  <para style="q" vid="LUK 6:25">kʉnsoko mɨkahʉng’wa nzala.</para>
  <para style="q" vid="LUK 6:25">Mʉkaga ʉnyenye nʉkʉheka itungo ɨlɨ,</para>
  <para style="q" vid="LUK 6:25">kʉnsoko mɨkahongelya nʉkʉlɨla.<verse eid="LUK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 6:26" />Mʉkaga ʉnyenye nɨmʉkʉkʉligwa nɨantʉ, kʉnsoko nɨanyakalɨ aɨatendee ɨamanga aʉteele.<verse eid="LUK 6:26" /></para>
  <para style="s">Alowi ɨalʉgʉ anyu</para>
  <para style="r">
    <ref loc="MAT 5:38-48">Matayo 5:38-48</ref>; <ref loc="MAT 7:12">7:12</ref></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27" />“Ingɨ kʉmʉtambʉɨla ʉnyenye nimʉntegeeye, mʉalowe ɨalʉgʉ anyu. Akendepi ɨantʉ nɨamʉbɨpɨwe. <verse eid="LUK 6:27" /><verse number="28" style="v" sid="LUK 6:28" />Mʉatendeele iza awo nɨɨmʉzʉmaa, nawa nɨmʉʉtendeela ʉʉbi mɨalompeele kʉng'wi Itunda. <verse eid="LUK 6:28" /><verse number="29" style="v" sid="LUK 6:29" />Mʉntʉ anga wakʉkʉe ikunda ipande lakɨgoha mʉpɨʉɨle nikunda lipande lankɨgɨ, Mʉntʉ anga wakʉhegelye ʉmʉjʉlʉngʉ mʉpe nɨ shati ao. <verse eid="LUK 6:29" /><verse number="30" style="v" sid="LUK 6:30" />Mʉntʉ anga wakʉlompe ʉmʉaɨɨlye kɨntʉ kɨhi mʉpeze, nʉmʉntʉ anga wakʉhegelye kɨntʉ kako leka kʉgonja wakʉsʉkɨɨlye. <verse eid="LUK 6:30" /><verse number="31" style="v" sid="LUK 6:31" />Atendeeli ɨantʉ angɨɨza anga nɨmʉtakile nɨanso amʉtendeele ʉnyenye. <verse eid="LUK 6:31" /><verse number="32" style="v" sid="LUK 6:32" />“Anga mʉalowe antʉ awa nɨamʉloilwe ʉnyenye, mʉkʉtula mʉlagɨɨe ʉkende kɨɨ? Kʉnsoko anyamɨlandʉ nɨenso ɨalowaa awa nɨaaloilwe. <verse eid="LUK 6:32" /><verse number="33" style="v" sid="LUK 6:33" />Hangɨ anga mʉatendeele ʉkende awa nɨɨmʉtendeela ʉnyenye ʉʉkende mʉkʉtula mʉlagɨɨe ʉkende kɨɨ? ‘Nɨ anyamɨlandʉ’ ɨtendaa yayo yaayo. <verse eid="LUK 6:33" /><verse number="34" style="v" sid="LUK 6:34" />Hangɨ anga mʉakopise awo ʉdu nɨmʉahʉʉe ahumile kʉsʉsha, mʉkʉtula mʉlagɨɨe ʉkende kɨɨ? Nɨanyamɨlandʉ ɨakopisa anyamɨlandʉ aʉya awa nɨahumile kʉsʉsha. <verse eid="LUK 6:34" /><verse number="35" style="v" sid="LUK 6:35" />Ingɨ kʉmʉɨla alowi ialʉgʉ anyu, atendeeli ʉʉkende, akopisi leki kʉlindiɨlɨ kʉsʉkiɨlɨgwa. Papo kɨpegwa kanyu ɨkʉtula nkʉlʉ, nʉnyenye mʉkʉtula mɨana ang’wi Itunda nʉkolɨ migʉlya, kʉnsoko nuanso mʉkende kʉantʉ nɨabɨ hangɨ nɨshanga ilʉmbɨɨlya. <verse eid="LUK 6:35" /><verse number="36" style="v" sid="LUK 6:36" />Mʉtule nɨkɨnyaʉwai anga Tataa nyu nʉa kilunde nʉkete ikɨnyaʉwai.<verse eid="LUK 6:36" /></para>
  <para style="s">Leki kʉapɨsɨɨlya ɨantʉ nɨangɨɨza</para>
  <para style="r">
    <ref loc="MAT 7:1-5">Matayo 7:1-5</ref></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37" />“Leki kʉpisɨɨlyi, Itunda shanga ʉkʉmʉpɨsɨɨlya ʉnyenye, leki kʉsoshi, Itunda shanga ʉkʉmʉsosha ʉnyenye, alekeli ɨantʉ, Itunda ʉkʉmʉlekela ʉnyenye. <verse eid="LUK 6:37" /><verse number="38" style="v" sid="LUK 6:38" />Apezi ɨantʉ iintʉ, Itunda ʉkʉmʉpeza nʉnyenye, ʉkʉmizʉɨlya nʉkʉhingɨsa kihigintɨle nʉkʉhʉnʉkɨlya. Kʉnsoko ngele nʉkʉgemeelelya ɨɨantʉ, yɨyo yɨɨyo ʉkʉgemeeleligwa.”<verse eid="LUK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39" />Akaapa mpyani ɨyɨ, “Itɨɨ, ʉmʉpoku ʉhumilene kʉmʉtonga ʉmʉpoku mʉya? Anga watende iti, ɨhi abɨɨlɨ shanga ahumilene kʉgwila mikombo? <verse eid="LUK 6:39" /><verse number="40" style="v" sid="LUK 6:40" />Mʉmanyisigwa shanga ʉkʉmʉkɨlya umʉmanyisi wakwe, ingɨ ʉyʉ nʉmaile ʉhumile kʉnɨng’anɨɨla nʉmʉmanyisi wakwe.<verse eid="LUK 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 6:41" />“Haɨ ka ʉkʉgoza kahɨgɨ mʉliho lamɨako, ʉewe shanga wioneeye ikota nɨlɨkolɨ mʉliho lako? <verse eid="LUK 6:41" /><verse number="42" style="v" sid="LUK 6:42" />Ang’wi ʉhumile ʉlɨ kʉmʉɨla ʉmɨako, ‘Ng’waitʉ tiga nʉkʉhegelye kahɨgɨ nɨkamolɨ mʉliho lako,’ nʉewe shanga ɨze wioneeye ikota nɨlɨzelɨmolɨ mʉliho lako? Ʉewe wɨmʉteele. Heja hanza ikota nɨlɨmolɨ mʉliho lako, pang’wanso papogwa ʉhumile kʉona iza nʉkʉheja kahɨgɨ nɨkamoli mʉliho nɨlamɨako.<verse eid="LUK 6:42" /></para>
  <para style="s">Mʉtɨ wɨkumʉka kʉnkalɨ yakwe</para>
  <para style="r">
    <ref loc="MAT 7:16-20">Matayo 7:16-20</ref>; <ref loc="MAT 12:33-35">12:33-35</ref></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43" />“Kʉtilɨ mʉtɨ nʉʉziza nʉɨpeza inkalɨ nimbɨ, ang’wi mʉtɨ nʉʉbɨ nʉɨpeza inkalɨ ninza. <verse eid="LUK 6:43" /><verse number="44" style="v" sid="LUK 6:44" />“Mɨtɨ ɨhi ikʉmʉka kʉ nkalɨ nɨɨpeza, kʉnsoko ɨantʉ shanga ɨkala nsingɨla mʉmʉgunga ang’wi nsalumbɨ mʉmɨtundulu. <verse eid="LUK 6:44" /><verse number="45" style="v" sid="LUK 6:45" />Mʉntʉ nʉmʉkende wɨpumyaa makani nɨmaza namolɨ mʉnkolo akwe, nʉ mʉntʉ nʉ mʉbɨ wɨpumyaa makani nɨambɨ namolɨ mʉnkolo akwe, kʉnsoko mʉntʉ wɨpumyaa makani namizʉɨe mʉnkolo.<verse eid="LUK 6:45" /></para>
  <para style="s">Azengi niahʉgu nɨazengi nɨapʉngʉ</para>
  <para style="r">
    <ref loc="MAT 7:24-27">Matayo 7:24-27</ref></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46" />“Kʉnɨkɨ mʉkʉnintanga ‘Isekʉlʉ, Isekʉlʉ,’ nʉnyenye shanga mʉkʉtenda aya nɨkʉmʉtambʉɨla? <verse eid="LUK 6:46" /><verse number="47" style="v" sid="LUK 6:47" />Kʉmʉlagɨɨla mʉntʉ nʉɨza nʉkija inkani yane nʉkʉitenda. <verse eid="LUK 6:47" /><verse number="48" style="v" sid="LUK 6:48" />Nʉanso wɨhangaa mʉntʉ nʉkʉzenga nyʉmba, aɨʉhɨmbile mʉkʉɨla nʉʉlundu nʉkʉzenga ɨkitako mitalagwe. Kɨhumo naɨkipikile mazɨ akamɨkʉa ɨnyʉmba akwe, nyʉmba nanso shanga ɨkʉgwa kʉnsoko ɨzengilwe mʉikomu. <verse eid="LUK 6:48" /><verse number="49" style="v" sid="LUK 6:49" />Ingɨ mʉntʉ wɨhi nʉikija inkani yane wahite kʉtenda niilagɨɨye, nʉanso wimpyanigwe nʉmʉntʉ nʉzengile ɨnyʉmba akwe mihangahanga nɨshanga ʉhɨmbile ʉmʉkʉɨla. Kɨhumo anga kɨmɨkʉe ɨkʉgwa nʉkuhambʉka.”<verse eid="LUK 6:49" /></para>
  <chapter eid="LUK 6" />
  <chapter number="7" style="c" sid="LUK 7" />
  <para style="s">Ʉhʉɨɨli nʉamʉkʉlʉ nʉamʉmboi nʉa kʉ Loma</para>
  <para style="r">
    <ref loc="MAT 8:5-13">Matayo 8:5-13</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1" />Yesʉ naɨwakondya kʉtambʉla inkani izi yɨhi kʉ antʉ naɨamʉtegeeye, akalongola mʉkɨsalɨ ka Kapelinaʉmu. <verse eid="LUK 7:1" /><verse number="2" style="v" sid="LUK 7:2" />Kʉng’wanso aɨʉkolɨ mʉkʉlʉ wiumbɨ lamʉmboi nʉakʉ Loma. Mʉkʉlʉ wakwe aɨʉmʉloilwe ikilo, mʉntʉ ʉyʉ aimʉlwae do. <verse eid="LUK 7:2" /><verse number="3" style="v" sid="LUK 7:3" />Mʉkʉlʉ ʉyʉ nʉa amboi naɨwakija inkani yang’wa Yesʉ, akaalagɨɨlya anyampala a Kiyahudi amʉlompe ʉ Yesʉ waze wamʉponye ʉmitʉmi wakwe. <verse eid="LUK 7:3" /><verse number="4" style="v" sid="LUK 7:4" />Akamʉhanga ʉ Yesʉ akamʉpepeelya wamʉaɨɨlye Mʉkʉlʉ ʉyʉ nʉa amboi, akamʉɨla, “Itʉnʉ mʉntu ʉyʉ ʉtakɨwe kʉaɨɨligwa. <verse eid="LUK 7:4" /><verse number="5" style="v" sid="LUK 7:5" />Kʉnsoko ɨɨza ʉaloilwe ɨantʉ itʉ hangɨ ʉkʉzengeeye nyʉmba akʉʉtankanɨla.”<verse eid="LUK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 7:6" />Yesʉ akityata nɨenso, naɨwamihumbeela ɨnyʉmba, mʉkʉlʉ ʉyʉ nʉa amboi akaalagɨɨlya ahʉmbaʉya amʉɨle ʉ Yesʉ, “Isekʉlʉ leka kiaja, ʉnene shanga ntakɨwe nʉkingɨlye mitolane. <verse eid="LUK 7:6" /><verse number="7" style="v" sid="LUK 7:7" />Yiyo nsoko azamine shanga ntakɨwe kʉʉhumbeela. Ingɨ tambʉla lʉkani ʉdu ʉmitʉmi wane ʉkʉkomya. <verse eid="LUK 7:7" /><verse number="8" style="v" sid="LUK 7:8" />Kʉnsoko ʉnene nkete akʉluane nɨantongee, nʉnene nkete amboi nɨnɨatongee. Anga nʉmʉɨle ʉng’wɨao, ‘Longola!’ nʉyo wilongola, hangɨ anga nʉmʉɨle ʉmʉya ‘Nzʉʉ!’ wɨpembyaa. Mʉtugwa wanega anga nʉmʉlagɨɨlye, ‘Itʉme kɨntʉ ɨkɨ’ nʉanso witʉma.”<verse eid="LUK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9" />Yesʉ naɨwija inkani izi, akakʉɨlwa, akaapɨlʉkɨla ɨantʉ naɨityatile, akaatambʉɨla, “Nkɨlɨ kʉona nʉ mʉantʉ Aisilaeli ga mʉntʉ nʉkete ʉhʉɨɨlɨ nʉaitɨ.”<verse eid="LUK 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 7:10" />Antʉ awa naɨatʉmilwe nʉ mʉkʉlʉ ʉyʉ nʉa amboi kʉng’wa Yesʉ, akatʉlya kito akahanga ʉmʉlwae wakomyaa.<verse eid="LUK 7:10" /></para>
  <para style="s">Yesʉ ʉkʉmʉiʉla ng’wana nʉa mʉsʉngʉ nʉshɨɨwe nʉmʉgoha</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11" />Ʉʉgwa naɨʉmaile ʉdu nanso Yesʉ akalongola mʉkɨsalɨ ka kʉ Naini, aɨakʉɨlanilye nɨamanyisigwa akwe palʉng’wɨ nɨantʉ ɨdʉ. <verse eid="LUK 7:11" /><verse number="12" style="v" sid="LUK 7:12" />Naɨahumbeela pa mʉmpita nʉa kɨsalɨ, akapembya antʉ akenkile mʉimba wamʉhʉmba mʉmɨangʉ alongoe kʉmʉɨka kʉnzi akɨsalɨ. Mʉhʉmba ʉyʉ naɨʉkʉle aɨkinyene ʉnyinya aɨwashɨɨwe nʉmʉgoha, anyasʉka ɨdʉ aɨakʉɨe nʉmʉsʉngʉ nʉshɨɨwe. <verse eid="LUK 7:12" /><verse number="13" style="v" sid="LUK 7:13" />Yesʉ naɨwamʉona ʉmʉsʉngʉ nʉshɨɨwe akamʉaisɨɨlya, akamʉɨla, “Kilaja kʉlila.” <verse eid="LUK 7:13" /><verse number="14" style="v" sid="LUK 7:14" />Sʉnga akaadagɨla nʉkʉamba mɨangʉ, awa naɨakenkile ʉmʉimba akimɨka, nao akaʉtʉla pihɨ ʉmʉimba, akakɨlaga nʉmʉkʉtegeelya. Yesʉ akaʉtambʉɨla ʉmʉimba, “Mʉhʉmba kʉʉɨla, ʉka.” <verse eid="LUK 7:14" /><verse number="15" style="v" sid="LUK 7:15" />Mʉhʉmba ʉyʉ naɨʉkule akaʉka akikiɨ akandya kʉligitya nɨantʉ, Yesʉ akamʉɨla ʉnyinya nʉa ng’wana mʉhole ʉng’waako.<verse eid="LUK 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16" />Antʉ ɨhi akagʉlʉala, akamʉkʉlya Itunda azelʉnga, “Mʉmanga mʉkʉlʉ wakigeela mʉng’wɨtʉ, Itunda ʉzile aponya ɨantʉ akwe.”<verse eid="LUK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 7:17" />Ikani ɨlɨ naɨwitʉmɨle ʉ Yesʉ akakʉmʉka mihɨɨ ɨhi na Yʉdea nʉ mʉisalɨ yɨhi niya pakʉpɨ.<verse eid="LUK 7:17" /></para>
  <para style="s">Yohana Mʉbadisi ʉkʉlagɨɨlya amanyisingwa akwe kʉng’wa Yesʉ</para>
  <para style="r">
    <ref loc="MRK 11:2-19">Maliko 11:2-19</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18" />Amanyisigwa ang’wa Yohana Mʉbadisi akamʉganʉɨla ʉ Yohana makani aya ɨhi. Kʉlʉlo ʉ Yahana akaitanga amanyisigwa akwe abɨɨlɨ, <verse eid="LUK 7:18" /><verse number="19" style="v" sid="LUK 7:19" />akaalagɨɨlya alongole kʉng’wi Isekʉlʉ amʉkolye, “Itɨɨ, ʉewe yʉyone nɨkʉɨɨwe ʉpembilye, ang’wi kʉmʉlindɨɨle mʉngɨɨza?”<verse eid="LUK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 7:20" />Amanyisigwa naɨalagɨɨgwe akapika kʉng’wa Yesʉ, nʉkʉmʉɨla, “Yohana Mʉbadisi ʉkʉlagɨɨye kʉkʉkolye, ‘Itɨɨ, ʉewe yʉyone nɨkʉɨɨwe ʉpembilye, ang’wi kʉmʉlindɨɨle mʉngɨɨza?”’<verse eid="LUK 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 7:21" />Matungo nanso ʉ Yesʉ aɨʉkʉaponya ɨantʉ naɨakete malwae, nawa nɨakete ahɨng’wɨ aɨahegeigwe, nɨapoku ɨdʉ akaatendeela aone. <verse eid="LUK 7:21" /><verse number="22" style="v" sid="LUK 7:22" />Ʉʉgwa ʉ Yesʉ akaasʉkɨɨlya amanyisigwa awo naɨalagɨigwe, “Longoli mʉmʉtambʉɨle ʉ Yohana aya ɨhi nɨmilolenkee nʉkija. Apoku akʉona, nɨakɨtele akʉgenda, niantʉ anambʉ akeligwa, nɨagulu akija, nɨashi akiʉkigwa, nɨaʉla akʉtanantɨlɨgwa Nkani ni Nziza. <verse eid="LUK 7:22" /><verse number="23" style="v" sid="LUK 7:23" />Ʉtendeewe ʉkende ni Itunda mʉntʉ ʉyʉ nɨmʉgila nkankani nʉnene.”<verse eid="LUK 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24" />Antʉ awo naɨalagɨigwe nʉ Yohana naɨakahega nʉkʉlongola, Yesʉ akandya kʉatambʉaɨla ɨantʉ nkani yang’wa Yohana, “Ʉko mʉwɨɨ azamendile kihenga kɨntʉ kɨɨ? Itɨɨ, azamendile kihenga nkonkoma nʉʉkʉkunkwa nʉng’wega ne? <verse eid="LUK 7:24" /><verse number="25" style="v" sid="LUK 7:25" />Ingɨ aza mendɨle kihenga mʉntʉ kɨɨ? Azamendile mʉona mʉntʉ nʉitungile ngʉo akɨgolɨ? Shanga ʉʉ ɨantʉ nɨɨtungala ɨngʉo akɨgolɨ nawa nɨakete maintʉ ɨhi nɨmaza ishiɨ mʉ mazʉmba akitemi, shanga ishiɨ mʉwɨɨ. <verse eid="LUK 7:25" /><verse number="26" style="v" sid="LUK 7:26" />Ntambʉɨlɨ aza mendile iloela kɨntʉkɨɨ? Aza mendele mʉona mʉmangane? Kʉlʉ kʉʉlʉ kʉmʉɨla nɨmʉmʉine ʉkɨlɨnkɨɨe ʉmʉmanga. <verse eid="LUK 7:26" /><verse number="27" style="v" sid="LUK 7:27" />Ʉyʉ yʉyʉ nkani yakwe niiandɨkilwe mʉʉandɨkwa, kɨna. ‘Itunda aɨʉtambʉe, kʉmʉtongelya mʉtʉʉng’wa wakʉtongeele, nʉkʉʉnoneelelya nzɨla nʉʉkʉkɨɨla ʉewe.”’ <verse eid="LUK 7:27" /><verse number="28" style="v" sid="LUK 7:28" />Sʉnga ʉ Yesʉ akaatambʉla ɨantʉ, “Kʉmʉɨla, mʉʉantʉ nɨatugilwe nʉmʉsʉngʉ kʉtilɨ nʉmʉkʉlʉ kʉmʉkɨla ʉ Yohana Mʉbadisi. Ingɨ ʉyʉ nɨmʉniino mʉʉtemi wang’wi Itunda ingɨ mʉkʉlʉ kʉkɨla ʉ Yohana Mʉbadisi.”<verse eid="LUK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 7:29" />Antʉ ɨhi palʉng’wɨ nɨahangʉlwa kodi naɨija inkani yang’wa Yesʉ akagomba kɨna Itunda ingɨ mʉkende, antʉ awa wawo Yohana naɨ ʉabadisilye. <verse eid="LUK 7:29" /><verse number="30" style="v" sid="LUK 7:30" />Ingɨ Apalisayo nɨamanyisi amalagɨɨyo akahita ayo Itunda naɨʉlagɨɨye ɨtʉme, kʉnsoko shanga aɨagombile kʉbadisigwa nʉ Yohana.<verse eid="LUK 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31" />Yesʉ akalongoleka kʉtambʉla, “Antʉ awileli ʉwʉ nɨimpyanie nɨ ntʉni? Itɨɨ, impyani nɨ ntʉni? <verse eid="LUK 7:31" /><verse number="32" style="v" sid="LUK 7:32" />Impyani nɨang’ɨnya nɨakolɨ pigalagalo. Nɨakikʉtɨɨlya enso, ‘Kʉkʉile impɨlɨmbɨ ʉnyenye shanga maina. Kɨmbile ɨmɨmbo asʉka, ʉnyenye shanga malɨla.’<verse eid="LUK 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 7:33" />Kʉnsoko ʉ Yohana mʉbadisi aɨʉzile aɨwɨgwalya kʉlya ang’wɨ kʉng’wa dibai, ‘Ʉnyenye mɨkalʉnga. ‘Ʉkete hɨng’wɨ.’ <verse eid="LUK 7:33" /><verse number="34" style="v" sid="LUK 7:34" />Ng’wana wang’wa Adamu waza ʉkʉlya nʉkʉng’wa nʉnyenye malʉnga, ‘Mʉoni mʉntʉ ʉyʉ mʉlakʉ hangɨ wɨgala, mʉhumbaʉya waa ahangʉlwa kodi nɨanyamɨlandʉ.’ <verse eid="LUK 7:34" /><verse number="35" style="v" sid="LUK 7:35" />Nɨitɨga ɨmahala ang’wi Itunda akamɨnkɨigwe kɨna atai kʉ awo nɨamagombile.”<verse eid="LUK 7:35" /></para>
  <para style="s">Yesʉ ʉkʉpʉgʉhɨlwa makuta nʉ mʉsʉngʉ nɨ mʉnyamɨlandʉ</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36" />Lʉhikʉ lʉng’wɨ mpɨndɨ Palisayo ʉng’wɨ akamʉlompa ʉ Yesʉ alɨzanie indya kitolakwe, ʉʉgwa ʉ Yesʉ akalongolania nʉ Palisayo ʉyʉ akalama pihɨ mʉkɨpalatʉ walye indya. <verse eid="LUK 7:36" /><verse number="37" style="v" sid="LUK 7:37" />Mʉkɨsalɨ nɨkanso aɨʉkolɨ mʉsʉngʉ ʉng’wɨ mʉnyamɨlandʉ. Naɨwigulye Yesʉ ʉkʉlya ndya mʉnyʉmba ang’wa Palisayo, akapembya nɨ kɨhongolo kizʉe makuta amanyunkɨɨlo, <verse eid="LUK 7:37" /><verse number="38" style="v" sid="LUK 7:38" />akatuna panyuma amɨgʉlʉ ang’wa Yesʉ, akatulalɨla. Liholi lɨkatonyokela mʉmɨgʉlʉ ang’wa Yesʉ. Mʉsʉngʉ ʉyʉ akatugama akapyagʉla ʉliholi mʉmɨgʉlʉ ang’wa Yesʉ kʉnsingɨ yakwe, kʉnʉ wazemʉungatɨla ɨmɨgʉlʉ, nʉkʉpʉgʉhɨla ɨmanyunkɨɨlo. <verse eid="LUK 7:38" /><verse number="39" style="v" sid="LUK 7:39" />Palisayo ʉyʉ naɨʉmʉsɨngɨɨye ʉ Yesʉ mitolakwe naɨwiloeela aya, akasɨganɨɨlya mʉnkolo akwe, “Anga ɨze mʉntʉ ʉyʉ mʉmanga wang’wi Itunda, aza ʉzelɨnga kɨna nyenyu nʉkʉmʉamba, hangɨ kɨna mʉsʉngʉ ʉyʉ ingɨ mʉnyamɨlandʉ.”<verse eid="LUK 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40" />Yesʉ akamʉtambʉɨla ʉ Palisayo, “Simoni nkete lʉkani nʉlakʉʉtambʉɨla.” Simoni nʉyo akamʉsʉkɨɨlya ʉ Yesʉ,</para>
  <para style="p" vid="LUK 7:40">“Mʉmanyisi ntambʉɨle,”<verse eid="LUK 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 7:41" />Yesʉ akatambʉla “Aɨakolɨ antʉ abɨɨlɨ naɨakopile mpia kʉ mʉntʉ nʉɨkopisa,” Yesʉ akalongoleka kʉlʉnga, “Ʉng’wiao aɨʉdaigwe ʉnyinyʉ nʉa dinali magana ataano, ihanga kɨnyamʉlɨmo ka mahikʉ magana ataano. Nʉmʉya aɨʉdaigwe ʉnyinyʉ nʉa dinali makʉmi ataano, ihanga kɨnyamʉlɨmo ka mahikʉ makumi ataano. <verse eid="LUK 7:41" /><verse number="42" style="v" sid="LUK 7:42" />Antʉ awa mʉʉbɨɨlɨao naɨakopile naɨaleng’wa kʉmʉsʉkɨɨlya ʉmʉkopisi impia yakwe, mʉkopisi wao akaalekela. Sialɨ ntambʉɨle nʉʉli nʉɨkamʉlowa ʉmʉkopisi?”<verse eid="LUK 7:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43" />Simoni akamʉsʉkɨɨlya ʉ Yesʉ, “Nsigile yʉyʉ nʉlekewe ʉdaigwa ʉkʉlʉ.”</para>
  <para style="p" vid="LUK 7:43">Yesʉ akamʉɨla ʉ Simoni watambʉla iza.” <verse eid="LUK 7:43" /><verse number="44" style="v" sid="LUK 7:44" />Sʉnga akamʉpɨlʉkɨla ʉmʉsʉngʉ ni mʉnyamɨlandʉ akamʉɨla ʉ Simoni, “Itɨɨ, ʉmʉine ʉmʉsʉngʉ ʉyʉ? Nɨningɨɨlɨla mitolako wahita kʉmpa ɨmazɨ nkalalye ɨmɨgʉlʉ ane, ingɨ ʉmʉsʉngʉ wanogelya ɨmɨgʉlʉane kʉliholi lakwe nʉkʉmpyagʉla kʉnsingɨ yakwe. <verse eid="LUK 7:44" /><verse number="45" style="v" sid="LUK 7:45" />Ʉewe shanga ʉnamʉkilye nʉkʉmungatɨla, ingɨ ʉmʉsʉngʉ ʉyʉ nɨningɨɨlɨla apaitɨ ʉkenda mɨungatɨla ɨmɨgʉlʉ ane. <verse eid="LUK 7:45" /><verse number="46" style="v" sid="LUK 7:46" />Ʉewe shanga ʉmpʉgʉhɨe ɨmakʉta mitwe lane, ingɨ ʉmʉsʉngʉ ʉyʉ wampʉgʉhɨla manyunkɨɨlo mʉmɨgʉlʉ ane. <verse eid="LUK 7:46" /><verse number="47" style="v" sid="LUK 7:47" />Kʉlʉlo kʉʉtambʉɨla, itɨgwa kʉʉlowa ʉkʉlʉ nʉa mʉsʉngʉ ʉyʉ walekelwa ɨmɨlandʉ akwe ɨhi. Kʉnsoko wantendeela ʉlowa ʉkʉlʉ, ingɨ mʉntʉ nʉlekewe nɨkɨniino wɨlowa iniino.”<verse eid="LUK 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 7:48" />Sʉnga Yesʉ akamʉɨla ʉmʉsʉngʉ ʉyʉ, “Walekelwa ɨmɨlandʉ ako.”<verse eid="LUK 7:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49" />Antʉ ang’wi naɨakolɨ mʉnyʉmba akatʉlikolya ɨenso, “Itɨɨ, mʉntʉ ʉyʉ nyenyu, nʉhumile kʉalekela ɨantʉ ɨmɨlandʉ ao?”<verse eid="LUK 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 7:50" />Yesʉ akamʉɨla umʉsʉngʉ ʉyʉ, “Ʉhʉɨɨlɨ wako wakʉguna, ongola izewiloile.”<verse eid="LUK 7:50" /></para>
  <chapter eid="LUK 7" />
  <chapter number="8" style="c" sid="LUK 8" />
  <para style="s">Asʉngʉ naɨityatile nʉ Yesʉ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1" />Naɨakɨla aya, Yesʉ akalongola mʉisalɨ niikʉlʉ nizi niinino wazetanantya Nkani Nziza niaʉtemi wang’wi Itunda wazekɨɨla mʉisalɨ niikʉlʉ niisalɨ niiniino. Amanyisigwa awo ikʉmi naabɨɨlɨ aɨakʉie palʉng’wɨ nʉ Yesʉ, <verse eid="LUK 8:1" /><verse number="2" style="v" sid="LUK 8:2" />nɨasʉngʉ awo ʉ Yesʉ naɨʉahegeeye ahɨng’wɨ nʉkʉaponya malwae ao. Mʉasʉngʉ nɨanso aɨamolɨ ɨa Malia nʉakʉ Magidala ʉyʉ naɨʉmʉhegeeye ahɨng’wɨ mʉpungatɨ nʉ, <verse eid="LUK 8:2" /><verse number="3" style="v" sid="LUK 8:3" />Yoana mʉsʉngʉ wang’wa Kuza naɨ mitʉmi mʉkʉlʉ mʉnyʉmba angwa Helode nʉ Susana nɨasʉngʉ aʉya ɨdʉ, naɨ akendaaɨɨlya Yesʉ nɨa manyisigwa akwe kʉnsao yao.<verse eid="LUK 8:3" /></para>
  <para style="s">Mpyani amʉmyagi</para>
  <para style="r">
    <ref loc="MAT 13:1-9">Matayo 13:1-9</ref>; <ref loc="MRK 4:1-9">Maliko 4:1-9</ref></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4" />Milʉndo nʉa antʉ ɨdʉ naɨwilʉndɨɨe, nawa naɨapembeeye mʉisalɨ ingɨɨza, Yesʉ akandya kʉamanyisa kʉmpyani.<verse eid="LUK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 8:5" />Mʉmyagi ʉng’wɨ aɨwendile myaga mbeʉ. Naɨʉkʉmyaga mʉmʉgʉnda wakwe, mbeʉ yɨng’wɨ yɨkagwɨlya mʉnzɨla, akɨlanzɨla akaipambata nɨnyʉnyi yikalya. <verse eid="LUK 8:5" /><verse number="6" style="v" sid="LUK 8:6" />Mbeʉ yɨng’wɨ yɨkagwɨla mʉnkaha, naɨihelʉkile ʉdu yɨkaʉlya ʉtundulu yɨkanyala. <verse eid="LUK 8:6" /><verse number="7" style="v" sid="LUK 8:7" />Mbeʉ yɨng’wɨ yɨkagwɨla mʉmɨkahɨ, naɨihelʉkile ʉdu ikasopwa nɨmɨkahɨ nʉkʉkakɨla. <verse eid="LUK 8:7" /><verse number="8" style="v" sid="LUK 8:8" />Mbeʉ yɨng’wɨ yɨkagwila mʉmboto, ikahelʉka nʉkʉkinda nʉkʉpa magana kʉkʉla inzʉya naɨimyaganigwe. Yesʉ naɨwakondya kʉtambʉla mpyani ɨyɨ, akitʉnta, akalʉnga, “Mʉntʉ wɨhi nʉigulye nʉalɨnge.”<verse eid="LUK 8:8" /></para>
  <para style="s">Nsoko akʉmanyisa kʉ mpyani</para>
  <para style="r">
    <ref loc="MAT 13:10-17">Matayo 13:10-17</ref>; <ref loc="MRK 4:10-12">Maliko 4:10-12</ref></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9" />Amanyisigwa akwe akamʉkolya impyani ɨyɨ ndogoelyo akwe ntʉni? <verse eid="LUK 8:9" /><verse number="10" style="v" sid="LUK 8:10" />Yesʉ akaasʉkɨɨlya, “Ʉnyenye mʉpewe ʉhumi nʉa kʉʉlɨnga ʉʉnkunku nʉa Ʉtemi wang’wi Itunda, kʉaʉya shanga ʉʉ. Nɨanso ingɨ kʉamanyisa kʉmpyani, anga agozeele aleke kʉona hangɨ anga ategeelye aleke kʉlɨnga.<verse eid="LUK 8:10" /></para>
  <para style="s">Yesʉ ʉkʉkumʉʉla impyani amʉmyagi</para>
  <para style="r">
    <ref loc="MAT 13:18-23">Matayo 13:18-23</ref>; <ref loc="MRK 4:13-20">Maliko 4:13-20</ref></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11" />“Ʉʉgwa ndogoelyo ampyani ɨyɨ sɨyɨ, mbeʉ ingɨ lʉkani lang’wi Itunda. <verse eid="LUK 8:11" /><verse number="12" style="v" sid="LUK 8:12" />Mbeʉ nazayigwɨe mʉnzɨla yimpyanigwe nɨantʉ nɨakija ʉlʉkani lang’wi Itunda, shetani wapembye nʉkʉlʉheja mʉnkolo yao, ingɨ aleng’we kʉlʉhʉɨɨla nʉkʉponyigwa. <verse eid="LUK 8:12" /><verse number="13" style="v" sid="LUK 8:13" />Mbeʉ nazayigwɨe mʉnkaha yimpyanigwe nɨantʉ awo nɨɨtegeelya ʉlʉkani lang’wi Itunda nʉkʉlʉsingɨɨlya kʉʉlowa. Ingɨ shanga akʉlʉɨka mʉnkolo yao, anga ageng’we ʉdu, ɨleka. <verse eid="LUK 8:13" /><verse number="14" style="v" sid="LUK 8:14" />Mbeʉ nazayigwɨe mʉmɨkahɨ yimpyanigwe nɨantʉ awo nɨakija ʉlʉkani, ingɨ nɨalongoleke nʉlʉkani lang’wi Itunda ɨnyong’wa nɨnkankani nʉ lwago nʉla ʉgolɨ, nʉ kiloa maintʉ amihɨɨ, antʉ awo shanga ishiɨ kʉtyata ʉmanyisigwa nʉa lʉkani lang’wi Itunda. <verse eid="LUK 8:14" /><verse number="15" style="v" sid="LUK 8:15" />Ingɨ mbeʉ niigwɨɨe mʉmboto, ingɨ antʉ awo nɨijaa ʉlʉkani lang’wi Itunda nʉkʉlʉɨka mʉnkolo yao. Antʉ nɨanso ishiɨ kʉtyata ʉmanyisigwa nʉa lʉkani lang’wi Itunda.<verse eid="LUK 8:15" /></para>
  <para style="s">Lʉmʉli nʉlʉɨkilwe mʉʉlungu nʉa ʉlɨlɨ</para>
  <para style="r">
    <ref loc="MRK 4:21-25">Maliko 4:21-25</ref></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16" />“Antʉ shanga akɨlya ʉlʉmʉlɨ nʉkukʉnɨkɨla nashʉngʉ ang’wɨ kʉɨka mʉʉlungu nʉa ʉlɨlɨ. Ingɨ angaakɨlye ʉlʉmʉli ɨpagɨka mʉkɨpagɨko, ingɨ antʉ nɨakingɨla ɨzeaine.<verse eid="LUK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 8:17" />Kʉnsoko kɨntʉ kɨhi nɨkɨpihilwe kɨkʉpihʉʉlwa, hangɨ kɨntʉ kɨhi nɨkaʉnkʉnkʉ kɨkʉumbʉʉlwa.<verse eid="LUK 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 8:18" />Kʉlʉlo hʉgʉki naya nɨmʉkija, kʉnsoko ʉyʉ nʉkete ʉkongeeligwa, ingɨ ʉyʉ nɨmʉgila, ʉkʉhegeligwa nɨkɨga nʉsɨgile kɨna ʉkete.”<verse eid="LUK 8:18" /></para>
  <para style="s">Yesʉ ʉkʉata nyinya nɨaluna akwe nɨatai</para>
  <para style="r">
    <ref loc="MAT 12:46-50">Matayo 12:46-50</ref>; <ref loc="MRK 3:31-35">Maliko 3:31-35</ref></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19" />Lʉhikʉ lʉng’wɨ nyinya ang’wa Yesʉ nɨaluna ang’wa Yesʉ aɨendile mʉona, nɨitɨga akaleng’wa kʉmʉpikɨɨla kʉnsoko aɨwiombazɨɨwe nɨantʉ. <verse eid="LUK 8:19" /><verse number="20" style="v" sid="LUK 8:20" />Mʉntʉ akamʉtambʉɨla Yesʉ kɨna, “Ʉnyinya nɨaluna ako aloilwe kiona nʉng’wenso.”<verse eid="LUK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 8:21" />Ingɨ ʉ Yesʉ akaasʉkɨɨlya ɨantʉ naɨamʉtambʉɨe, “Ʉiyaane nɨalunaane ingɨ antʉ awo nɨakija nʉkʉtyata ʉlʉkani lang’wi Itunda.”<verse eid="LUK 8:21" /></para>
  <para style="s">Yesʉ ʉkʉkenela kɨntingʉ kikɨlage</para>
  <para style="r">
    <ref loc="MAT 8:23-27">Matayo 8:23-27</ref>; <ref loc="MRK 4:35-41">Maliko 4:35-41</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22" />Lʉhikʉ lʉng’wɨ ʉ Yesʉ aɨʉatambʉɨe ɨmanyisigwa akwe, “Kwɨni kʉtambʉke ʉlʉzɨ nʉlʉkʉlʉ.” Ʉʉgwa akanankɨla mibɨnɨ akalongola. <verse eid="LUK 8:22" /><verse number="23" style="v" sid="LUK 8:23" />Naɨalongolekile nʉmʉhizo azeamoli mibɨnɨ, Yesʉ akahʉng’wa tʉlo, akalala. Kɨntingʉ kikʉlʉ kɨkandya kʉkunka, maɨngʉ amazɨ akatʉlingɨla mibɨnɨ, akahia kʉgwɨla mʉmazɨ. <verse eid="LUK 8:23" /><verse number="24" style="v" sid="LUK 8:24" />Amanyisigwa ang’wa Yesʉ akamʉhanga akamʉpitya azelʉnga, “Isekʉlʉ, Isekʉlʉ. Ʉka kaakagwɨla mʉmazɨ!”</para>
  <para style="p" vid="LUK 8:24">Yesʉ akapɨtya akimɨka, akakenela ɨkɨntingʉ nɨ maɨngʉ, nɨkɨntinkʉ kɨkatɨga ihɨtwɨ. <verse eid="LUK 8:24" /><verse number="25" style="v" sid="LUK 8:25" />Sʉnga akaakolya amanyisigwa akwe, “Ʉhʉɨɨlɨ wanyu ʉkolɨ pɨɨ?”</para>
  <para style="p" vid="LUK 8:25">Ʉʉgwa amanyisigwa akwe akakʉɨlwa nʉkingɨɨlwa nʉwoa kʉnʉ azikolya, “Mʉntʉ ʉyʉ nyenyu, ʉkʉlagɨɨlya ʉng’wega nɨmaɨngʉ, nɨmenso akʉmija?”<verse eid="LUK 8:25" /></para>
  <para style="s">Yesʉ ʉkʉmʉponya mʉntʉ nʉkete ahɨng’wɨ</para>
  <para style="r">
    <ref loc="MAT 8:28-34">Matayo 8:28-34</ref>; <ref loc="MRK 5:1-20">Maliko 5:1-20</ref></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26" />Sʉnga Yesʉ nɨamanyisigwa akwe akatambʉka lʉzɨ nʉla Galilaya akapika kitʉmbɨ lihɨɨ Aagelasi, ihɨɨ nɨkolɨ itʉmbɨ la kabɨɨlɨ nɨla Galilaya, <verse eid="LUK 8:26" /><verse number="27" style="v" sid="LUK 8:27" />Yesʉ naɨwasima mibɨnɨ, akamʉhanga mʉntʉ ʉng’wɨ nʉagigwa nɨahɨng’wɨ kʉpuma mʉkɨsalɨ nɨkanso, mʉntʉ ʉyʉ aɨwɨgenda kɨpwɨ hangɨ shanga wishiɨ kito ingɨ mʉibɨɨla. <verse eid="LUK 8:27" /><verse number="28" style="v" sid="LUK 8:28" />Mʉntʉ ʉyʉ naɨwamʉona ʉ Yesʉ akigʉma nʉkʉpalaganya pantongeela ang’wa Yesʉ nʉkitʉnta, “Ʉewe Yesʉ Ng’wana wang’wi Itunda nʉkolɨ migʉlya ikɨlo, ʉkʉhiya ʉntende ʉlɨ? Kʉʉlompa leka kʉnaja.” <verse eid="LUK 8:28" /><verse number="29" style="v" sid="LUK 8:29" />Kʉnsoko Yesʉ aɨwamʉkenela ʉhɨng’wɨ wamʉleke ʉmʉntʉ ʉyʉ. Nkʉa yɨdʉ hɨng’wɨ ʉyʉ aɨwɨmaja ʉmʉntʉ ʉyʉ napaga naɨɨmʉkʉtungwa mɨnyololo mʉmɨgʉlʉ nɨmpɨngu mʉmɨkono nʉkʉmʉsʉnga, ingɨ nʉanso aɨwɨtɨnanga ɨmɨnyololo nimpɨngu, nʉhɨng’wɨ ʉyʉ nʉkʉtwalwa mʉwɨɨ.<verse eid="LUK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 8:30" />Ʉʉgwa ʉ Yesʉ akamʉkolya, “Lina lako winyenyu?”</para>
  <para style="p" vid="LUK 8:30">akamʉsʉkɨɨlya, “Nitangwaa ‘Idale”’ kʉnsoko aɨwingɨɨwe ahɨng’wɨ ɨdʉ. <verse eid="LUK 8:30" /><verse number="31" style="v" sid="LUK 8:31" />Ahɨng’wɨ nɨanso akatula minena ʉ Yesʉ waleke kʉalagɨɨla alongole mikombo nɨlɨpu.<verse eid="LUK 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 8:32" />Pakʉpi ni pang’wanso aɨlɨkolɨ idale la ngʉlima lɨkʉdɨma mʉnkilimbwa alʉgʉlʉ. Ʉʉgwa, ahɨng’wɨ aɨaminenile ʉ Yesʉ amagombye ingɨle mʉngʉlima nɨanso. Yesʉ akamagombya. <verse eid="LUK 8:32" /><verse number="33" style="v" sid="LUK 8:33" />Kʉlʉlo ahɨng’wɨ akamʉlekela ʉmʉntʉ nʉkingɨla mʉngʉlima. Ngʉlima yɨkahala, yɨkahulumʉka yɨkagwɨla mʉlʉzɨ nʉlʉkʉ yɨkakapɨla mʉmo.<verse eid="LUK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 8:34" />Adɨma ngʉlima naɨaona aya ɨhi napumɨe akamanka, akalongola kʉapikɨlya ɨantʉ mʉisalɨ niinino niisalɨ nʉkʉlʉ. <verse eid="LUK 8:34" /><verse number="35" style="v" sid="LUK 8:35" />Antʉ akapuma endihenga aya napumɨe, naɨapikile pang’wa Yesʉ, akamʉona ʉmʉhali nʉlekewe nɨahɨng’wɨ wikiɨ pakupɨ nʉ Yesʉ, ʉkete mahala akwe hangɨ ʉtugae ngʉo, antʉ nɨanso akogopa. <verse eid="LUK 8:35" /><verse number="36" style="v" sid="LUK 8:36" />Antʉ awo naɨailolenkee makani aya napumɨe, akaaganʉɨla ɨantʉ awa ʉmʉntʉ ʉyʉ ʉponyigwe ʉli. <verse eid="LUK 8:36" /><verse number="37" style="v" sid="LUK 8:37" />Sʉnga antʉ ihɨɨ akʉ Gelasi akogopa, amkamʉlompa ʉ Yesʉ waateele, wahege mʉkɨsalɨ nɨkanso. Yesʉ akanankɨla hangɨ mibɨnɨ, akahega. <verse eid="LUK 8:37" /><verse number="38" style="v" sid="LUK 8:38" />Matungo ʉ Yesʉ naɨʉkʉhega, mʉntʉ ʉyʉ naɨʉhegeigwe ahɨng’wɨ akamʉlompa ʉ Yesʉ “Ndeke kʉkʉɨlanie.”</para>
  <para style="p" vid="LUK 8:38">Yesʉ akamʉhitɨlya, akamʉɨla, <verse eid="LUK 8:38" /><verse number="39" style="v" sid="LUK 8:39" />“Tulya kitolako ʉganʉle ʉkende nʉtendeewe ni Itunda.”</para>
  <para style="p" vid="LUK 8:39">Ʉʉgwa, mʉntʉ ʉyʉ akalongola mʉkɨsalɨ wazetanantya makani ɨhi nʉtendeewe nʉ Yesʉ.<verse eid="LUK 8:39" /></para>
  <para style="s">Mʉnanso wang’wa Yeilo ʉkiʉkigwa, nʉ mʉsʉngʉ ʉkʉponyigwa</para>
  <para style="r">
    <ref loc="MAT 9:18-26">Matayo 9:18-26</ref>; <ref loc="MRK 5:21-43">Maliko 5:21-43</ref></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40" />Yesʉ naɨʉkʉtulya kʉpuma kitʉmbɨ nɨla Agelasi, akasingɨiligwa kʉʉlowa ʉkʉlʉ, kʉnsoko aɨamʉlindɨɨe. <verse eid="LUK 8:40" /><verse number="41" style="v" sid="LUK 8:41" />Papo wa akɨza mʉntʉ ʉng’wɨ witangwaa Yeilo mʉtongeeli nʉa nyʉmba akʉtankanɨla Ayahudi akatugama pamɨgʉlʉ ang’wa Yesʉ, akamʉlompa alongolanie kitolakwe, <verse eid="LUK 8:41" /><verse number="42" style="v" sid="LUK 8:42" />kʉnsoko mʉnanso wakwe kinyene nʉamyaka ikʉmi na ibɨɨlɨ aɨmʉlwae kʉhiya kʉsha.</para>
  <para style="p" vid="LUK 8:42">Yesʉ naɨʉlongoe kʉ mʉntʉ ʉyʉ iumbɨ la antʉ aɨakʉmʉnyoma mpande yɨhi. <verse eid="LUK 8:42" /><verse number="43" style="v" sid="LUK 8:43" />Mʉmilʉndo nʉanso aɨʉkolɨ mʉsʉngʉ ʉng’wɨ aɨwɨnyong’waa kʉpuma nɨsakami itungo lamyaka ikʉmi naɨbɨɨlɨ, mʉsʉngʉ aɨwaʉɨwe insao kʉnsoko akʉʉtankɨɨla ʉlwae ʉwʉ mʉalagʉli ɨdʉ, kʉtilɨ ʉmʉlagʉli naɨwahumile kʉmʉkɨlɨka. <verse eid="LUK 8:43" /><verse number="44" style="v" sid="LUK 8:44" />Mʉsʉngʉ ʉyʉitɨ akamʉtyatɨɨla ʉ Yesʉ kʉnyuma akantomya ɨnsonge ngʉo lang’wa Yesʉ, itungo lɨlo sakami ɨkapela kʉpuma, akakomya. <verse eid="LUK 8:44" /><verse number="45" style="v" sid="LUK 8:45" />Yesʉ akaakolya, “Nyenyu nʉtomilye ngʉo lane?” Antʉ ɨhi akalʉnga kɨna kʉtilɨ anga mʉntʉ wɨhi nʉtomilye. Petelo akamʉtambʉɨla, “Isekʉlʉ, milundo wɨhi ʉwʉ nʉaantʉ niakʉpɨlɨmikɨɨye nʉkʉʉnyoma.”<verse eid="LUK 8:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 8:46" />Yesʉ akalʉnga, “Ʉkolɨ mʉntʉ ʉntomilye kʉnsoko kʉona ngulu impumile.” <verse eid="LUK 8:46" /><verse number="47" style="v" sid="LUK 8:47" />Mʉsʉngʉ ʉyʉ akaona kɨna ʉkʉleng’wa kipiha, akikumʉʉla kʉnʉ wazekagata nawoa, akagwa ʉundaala pamɨgʉlʉ ang’wa Yesʉ. Papo akandya kʉganʉla nɨkɨ ʉtomilye ngʉo lang’wa Yesʉ nɨitɨ nʉkomilye ɨndwala akwe. <verse eid="LUK 8:47" /><verse number="48" style="v" sid="LUK 8:48" />Yesʉ akamʉɨla mʉsʉngʉ ʉyʉ, “Mʉnanso, ʉhʉɨɨlɨ wako wakoponia, longola nʉʉlowa wang’wi Itunda.”<verse eid="LUK 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49" />Yesʉ naɨwakɨlɨ ʉlongolekile kʉtambʉla, mʉntʉ ʉng’wɨ akapembya kʉpuma mʉnyʉmba ang’wa Yailo akamʉletela mpola. “Ntʉnigwa nʉkʉkʉnyoma ʉ Mʉmanyisi kʉ mʉnanso wako wakʉza?”<verse eid="LUK 8:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 8:50" />Yesʉ naɨwija inkani izi akamʉtambʉɨla ʉ Yailo, “Leka kogopa, nihuiile ʉdu, mʉnanso wako ukukomya.”<verse eid="LUK 8:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 8:51" />Sʉnga Yesʉ akalongola kʉng’wa Yailo, naɨapikɨɨla mʉnyʉmba shanga akaagombya mʉntʉ wɨhi kingɨlania, ingɨ Petelo nʉ Yohana nʉ Yakobo nialeli amʉnanso. <verse eid="LUK 8:51" /><verse number="52" style="v" sid="LUK 8:52" />Anyasʉka akaze alongolekile kʉlɨla nʉkihongeelya kʉnsoko asʉka. Yesʉ akaaɨla, “Leki kʉlɨli kʉnsoko ʉng’wana ʉyʉ shanga ʉkʉle, ingɨ ʉlae!”<verse eid="LUK 8:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 8:53" />Anyasʉka akaheka nʉkʉmʉdalaha ʉ Yesʉ kʉnsoko nɨanso aɨaine kɨna ʉmʉnanso wakʉzaa kalɨ.<verse eid="LUK 8:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 8:54" />Ingɨ Yesʉ akaʉamba ʉmʉkono wamʉnanso nʉkitanga, “Ʉewe mʉnanso ʉka.” <verse eid="LUK 8:54" /><verse number="55" style="v" sid="LUK 8:55" />Itungo lɨlo mʉnanso akapangataala akaʉka. Yesʉ akaaɨla ɨaleli akwe amʉpe indya. <verse eid="LUK 8:55" /><verse number="56" style="v" sid="LUK 8:56" />Ingɨ aleli amʉnanso ʉyʉ akakʉɨlwa, Yesʉ akaagilya aleke kʉganʉla kʉ mʉntʉ wɨhi aya natendekile.<verse eid="LUK 8:56" /></para>
  <chapter eid="LUK 8" />
  <chapter number="9" style="c" sid="LUK 9" />
  <para style="s">Yesʉ ʉkʉalagɨɨlya awo nikʉmi na abɨɨlɨ</para>
  <para style="r">
    <ref loc="MAT 10:5-15">Matayo 10:5-15</ref>; <ref loc="MRK 6:7-13">Maliko 6:7-13</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1" />Yesʉ aɨʉitangile awo nɨikʉmi naabɨɨlɨ naɨʉahoile, akaapa ʉhumi nʉ ʉkʉlʉ nʉa kʉahegelya ɨantʉ ahɨng’wɨ nʉ kʉaponya ɨalwae. <verse eid="LUK 9:1" /><verse number="2" style="v" sid="LUK 9:2" />Sʉnga akaalagɨɨlya alongole kʉtanantye Ʉtemi wang’wi Itunda nʉkʉaponya ɨalwae. <verse eid="LUK 9:2" /><verse number="3" style="v" sid="LUK 9:3" />Akaalagɨɨlya akaaɨla, “Nɨmʉlongoe ʉmʉhɨnzo leki kikenkeelyi kɨntʉ kɨhi. Leki kʉholi mʉlanga ang’wɨ mbogoshi ang’wɨ mpamba ang’wi mpia ang’wɨ ngʉo nakʉkaɨla. <verse eid="LUK 9:3" /><verse number="4" style="v" sid="LUK 9:4" />Nyʉmba ɨhi nʉmʉkusingɨɨlɨgwa nʉkingɨla, ikɨɨ mʉmo kʉpikɨɨla kʉhʉsha nʉkʉlaga mʉkɨsalɨ nɨkanso. <verse eid="LUK 9:4" /><verse number="5" style="v" sid="LUK 9:5" />Antʉ awo nɨakʉhita kʉmʉsɨngɨɨlya, pumi mʉnyʉmba nanso, nɨmʉkʉpuma kʉnʉnti lʉnkʉndɨ nʉlamɨgʉlʉ anyu kʉlagɨɨla kɨna ahitɨle ʉlʉkani lang’wi itunda.” <verse eid="LUK 9:5" /><verse number="6" style="v" sid="LUK 9:6" />Ʉʉgwa amanyisigwa akandya ʉmʉhɨnzo, akakɨɨla nkɨka yɨhi azetanantya Nkani Nziza nʉ kʉapangataalya alwae pɨhi nɨakɨɨe.<verse eid="LUK 9:6" /></para>
  <para style="s">Kɨhʉsha ka mʉtemi Helode</para>
  <para style="r">
    <ref loc="MAT 14:1-12">Matayo 14:1-12</ref>; <ref loc="MRK 6:14-29">Maliko 6:14-29</ref></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7" />Ʉʉgwa ʉ Helode mʉtemi nʉa kʉ Galilaya naɨwija ayo naɨakʉtendeka, akahʉsha kʉnsoko antʉ ang’wɨ aɨakʉtambʉla kɨna ʉ Yohana Mʉbadisi wiʉka. <verse eid="LUK 9:7" /><verse number="8" style="v" sid="LUK 9:8" />Ingɨ antʉ ang’wi azelʉnga kɨna Eliya wapumɨla a hangɨ, antʉ ang’wi akalʉnga kɨna ʉng’wɨ nʉa anyakɨdagʉ wang’wi Itunda nɨakali wiʉka. <verse eid="LUK 9:8" /><verse number="9" style="v" sid="LUK 9:9" />Ingɨ ʉ Helode akalʉnga, “Yohana aɨnamʉdʉmʉla itwe namʉbʉlaga, ʉyʉ nyenyu itungo ɨlɨ nɨkija inkani yakwe?” Akahung’wa nsʉla akʉmʉona.<verse eid="LUK 9:9" /></para>
  <para style="s">Yesʉ ʉkʉalɨsa ndya antʉ magana anzogu ataano</para>
  <para style="r">
    <ref loc="MAT 14:13-21">Matayo 14:13-21</ref>; <ref loc="MRK 6:30-44">Maliko 6:30-44</ref>; <ref loc="JHN 6:1-14">Yohana 6:1-14</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10" />Itʉmi naɨatʉlya, akamʉganʉɨla ʉ Yesʉ makani ɨhi naɨitʉmɨle. Yesʉ akakaahola Itʉmi ikʉmi nabɨɨlɨ du, akalongola nɨenso azeipihɨɨye kʉpikɨɨla kɨsalɨ ka Betisaida. <verse eid="LUK 9:10" /><verse number="11" style="v" sid="LUK 9:11" />Ingɨ antʉ naɨalɨnga kʉendaa akamʉtyata. Yesʉ akaasɨngɨɨlya, akaatambʉɨla nkani nia ʉtemi wang’wi Itunda, kʉnʉ wazeaponya awo naɨaloilwe.<verse eid="LUK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 9:12" />Lyoa naɨlahumbeela kʉhaɨɨla, itʉmi awo nikʉmi naabɨɨlɨ akamʉtyata ʉ Yesʉ nʉkamʉɨla, “Alage ɨantʉ alongole mʉisalɨ niikʉlʉniisalɨ niinino, ende ɨdʉmilye ʉlyi nɨndalo, kʉnsoko apa nɨkʉmolɨ mʉwɨɨ kʉtilɨ anga nyʉmba.”<verse eid="LUK 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 9:13" />Ingɨ Yesʉ akaatambʉɨla, “Mʉape nyenye indya.”</para>
  <para style="p" vid="LUK 9:13">Nɨenso akamʉsʉkɨɨlya, “Kɨagila indya niyakʉalisa, kʉkete mɨkate ɨtaano ni nsamaki ibɨɨlɨ du. Kwaala kende kʉagʉɨlye ndya ɨantʉ awa ɨhi?” <verse eid="LUK 9:13" /><verse number="14" style="v" sid="LUK 9:14" />Aɨ akolɨ itʉnja magana anzogu ataano, Ingɨ Yesʉ akatambʉɨla itʉmi nɨikʉmi naabɨɨli akwe, “Ikalɨnshi ɨantʉ maanza aantʉ anga makʉmi ataano ataano itɨ.”<verse eid="LUK 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 9:15" />Itumi nɨikʉmi naabɨɨli akatenda ʉʉ, akaikalɨnsha ɨantʉ anga naɨalagɨɨgwe. <verse eid="LUK 9:15" /><verse number="16" style="v" sid="LUK 9:16" />Yesʉ akahola mɨkate nʉtaano ni nsamaki izi nibɨɨlɨ, akalangamɨla kilunde akamʉkʉlya Itunda, akakembeta, akaegania, sʉnga akainkɨɨlya ɨitumi nʉkʉaɨla api ɨantʉ alye. <verse eid="LUK 9:16" /><verse number="17" style="v" sid="LUK 9:17" />Antʉ ɨhi akalya nʉkikʉta, itʉmi akahoeela ʉnyinyu naɨʉsagile akizʉlya itoto ikʉmi naɨbɨɨlɨ.<verse eid="LUK 9:17" /></para>
  <para style="s">Petelo ʉkʉmʉta ʉ Yesʉ kɨna ingɨ Kilisito</para>
  <para style="r">
    <ref loc="MAT 16:13-19">Matayo 16:13-19</ref>; <ref loc="MRK 8:27-29">Maliko 8:27-29</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18" />Lʉhikʉ lʉng’wɨ ʉ Yesʉ aɨwikomile wing’wene wahume kʉlompa, amanyisigwa akwe aɨakolɨ pakupɨ nʉng’wenso. Aɨʉakoye, “Antʉ akenda ntambʉla ʉnene nɨnyenyu?”<verse eid="LUK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 9:19" />Itʉmi akwe akamʉsʉkɨɨlya, “Nɨang’wɨ akendalʉnga ʉewe wɨ Yohana Mʉbadisi, nɨang’wɨ akʉlʉnga wɨ Elia, nɨang’wɨ akʉlʉnga ʉewe ʉng’wɨ mʉamanga wang’wi Itunda nɨakalɨ wiʉkile kʉpuma kʉashi.”<verse eid="LUK 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 9:20" />Sʉnga Yesʉ akaakolya, “Ʉnyenye mʉkʉlʉnga, ʉnene ninyenyu?”</para>
  <para style="p" vid="LUK 9:20">Petelo akasʉkɨɨlya, “Ʉewe wɨ Kilisito nʉhoilwe ni Itunda.”<verse eid="LUK 9:20" /></para>
  <para style="s">Yesʉ ʉkʉtambʉla nsha akwe nɨɨkʉtula</para>
  <para style="r">
    <ref loc="MAT 16:20-28">Matayo 16:20-28</ref>; <ref loc="MRK 8:30">Maliko 8:30</ref>; <ref loc="MRK 9:1">9:1</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21" />Yesʉ akaagilya lʉkʉlʉ ɨitumi aleke kʉmʉɨla mʉntʉ wɨhi ʉlʉkani nʉlanso. <verse eid="LUK 9:21" /><verse number="22" style="v" sid="LUK 9:22" />Yesʉ akatambʉɨla hangɨ kɨna, “Ng’waa Mʉntʉ ʉtakɨwe kagigwa lʉkʉlʉ nʉkʉhitwa nɨanyampala nɨatongeeli ipolyo nɨamanyisi amalagɨɨlyo ang’wa Musa ang’wa Musa. Nʉng’wenso ʉtakiwe kʉbʉlagwa, ingɨ lʉhikʉ nʉla kataatʉ ʉkiʉka.”<verse eid="LUK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 9:23" />Sʉnga akaatambʉɨla ɨantʉ ɨhi kɨna, “Mʉntʉ wɨhi nʉloilwe kʉntyata, ʉtakɨwe wihite ʉng’wenso, wantyate anga mʉhemba wane mahikʉ ɨhi. <verse eid="LUK 9:23" /><verse number="24" style="v" sid="LUK 9:24" />Kʉnsoko mʉntʉ wɨhi nʉloilwe kʉgunɨɨlya likalo, ʉkʉleng’wa, ingɨ ʉyʉ nʉkihʉlya hanza kʉnsoko ane ʉkʉgunɨka. <verse eid="LUK 9:24" /><verse number="25" style="v" sid="LUK 9:25" />Kʉnsoko ʉmʉntʉ ʉkʉlija ntʉni anga wapantɨke makani ɨhi naʉnkʉmbigʉlʉ kʉnʉ walimɨlye ʉʉpanga wakwe ʉng’wenso? <verse eid="LUK 9:25" /><verse number="26" style="v" sid="LUK 9:26" />Anga mʉntʉ wamonele mɨnyala ʉnene nʉ ʉmanyisa wane, ingɨ Ng’wana wang’wi Itunda ʉkʉmʉhita mʉntʉ nʉanso itungo nʉzɨɨzapembya mʉʉmɨlɨgɨntu wakwe nʉʉmɨlɨgɨntu wang’wa Tata nʉʉmɨlɨgɨntu nʉa a Malaɨka. <verse eid="LUK 9:26" /><verse number="27" style="v" sid="LUK 9:27" />Ituleʉʉ taai kʉmʉtambʉɨla, Akolɨ antʉ ang’wi papa nɨshanga akʉsha kʉpikɨɨla aʉone Ʉtemi wang’wi Itunda.”<verse eid="LUK 9:27" /></para>
  <para style="s">Yesʉ ʉkʉkaɨlɨka ikelʉ</para>
  <para style="r">
    <ref loc="MAT 17:1-8">Matayo 17:1-8</ref>; <ref loc="MRK 9:2-8">Maliko 9:2-8</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28" />Naɨwakondya kʉtambʉla ɨkakɨla mahikʉ anga mʉnana itɨ, Yesʉ akaahola Petelo nʉ Yohana nʉ Yakobo akalongolania nɨenso mʉlʉgʉlʉ kenda kʉlompa. <verse eid="LUK 9:28" /><verse number="29" style="v" sid="LUK 9:29" />Yesʉ naɨʉkʉlompa, wigeeli wikelʉ lakwe wɨkakaɨlɨka nɨngʉo akwe akatula melʉ pee akazemɨlɨgɨnta. <verse eid="LUK 9:29" /><verse number="30" style="v" sid="LUK 9:30" />Pumpulugu akaaona antʉ abɨɨlɨ akazitambʉlya nʉng’wenso, antʉ nɨanso ingɨ aɨ Musa nʉ Eliya, <verse eid="LUK 9:30" /><verse number="31" style="v" sid="LUK 9:31" />naɨigee mʉʉmɨlɨgintu, akazitambʉɨla nʉ Yesʉ mpola nia nsha akwe, kɨna ʉkʉbʉlagɨlwa kʉ Yelusalemu. <verse eid="LUK 9:31" /><verse number="32" style="v" sid="LUK 9:32" />Petelo nɨaʉya aɨakɨɨlwaa tʉlo mʉlito, ingɨ naɨapɨtya lʉkʉlʉ akaʉona ʉmɨlɨgɨntu wang’wa Yesʉ nɨantʉ awo nɨabɨɨlɨ naɨimɨkanilye. <verse eid="LUK 9:32" /><verse number="33" style="v" sid="LUK 9:33" />Ʉʉgwa antʉ awa nɨabɨɨlɨ naɨakʉhega, Petelo akamʉɨla ʉ Yesʉ, “Isekʉlʉ azaiza ʉsese kikiɨ papa. Kʉzenge itala ɨtaatʉ apaitɨ, kɨtala kɨng’wɨ kɨtule kako, kitala kɨʉya kɨtule kang’wa Musa nɨkɨʉya kɨtule kang’wa Eliya.” Petelo ingɨ shanga aɨʉlɨngɨle ʉtambʉe kɨntʉ kɨɨ.<verse eid="LUK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 9:34" />Petelo wakaze ʉlongolekile kʉtambʉla, lɨkapumɨla ilunde lɨkaaimba, nɨenso akogopa naɨaimbwa nilunde nɨlanso. <verse eid="LUK 9:34" /><verse number="35" style="v" sid="LUK 9:35" />Akija lʉli kʉpumɨɨla milunde nɨlanso lʉkalʉnga, “Ʉyʉ Ng’waane nindoiigwe nʉng’wenso ninʉmʉsagʉe, mʉtegeelyi ng’wenso.”<verse eid="LUK 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 9:36" />Lʉli ʉlʉ naɨlakondya kʉtambʉla, Akamʉona ʉ Yesʉ waze wing’wene du. Amanyisigwa awo akaɨka mʉnkolo yao, shanga akamʉɨla mʉntʉ wɨhi naɨamaine.<verse eid="LUK 9:36" /></para>
  <para style="s">Yesʉ ʉkʉmʉponya mʉng’yɨnya nʉkete hɨng’wɨ</para>
  <para style="r">
    <ref loc="MAT 17:14-18">Matayo 17:14-18</ref>; <ref loc="MRK 9:14-27">Maliko 9:14-27</ref></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37" />Mʉdaʉ akwe naɨahulumʉka kʉpumɨɨla mʉlʉgʉlʉ, Yesʉ akatankania niumbɨ laantʉ. <verse eid="LUK 9:37" /><verse number="38" style="v" sid="LUK 9:38" />Miʉmbɨ nɨlanso mʉntʉ ʉng’wɨ akitʉnta, wazelʉnga, “Mʉmanyisi kʉʉlompa ʉmʉgoze ʉng’waane, ingɨ kinyene wane. <verse eid="LUK 9:38" /><verse number="39" style="v" sid="LUK 9:39" />Kʉnsoko hɨng’wɨ wɨmʉhanga, wɨzezogolya nkʉa yɨdʉ nʉkʉgwa nkolo kʉnʉ wazepuma ipomboolu mʉmʉlomo, hɨng’wɨ ʉyʉ ingɨ wɨmaja itungo ɨlɨpu, wɨmʉlekela itungo iniino ʉdu. <verse eid="LUK 9:39" /><verse number="40" style="v" sid="LUK 9:40" />Azenɨalompile amanyisigwa ako amʉheje ʉhɨng’wɨ, aleng’wa.”<verse eid="LUK 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 9:41" />Yesʉ akatambʉla, “Ʉnyenye antʉ nɨmɨabɨɨ nɨmɨagila ʉhʉɨɨlɨ, nikiɨ nʉnyenye kʉpikɨɨla nalɨ, papo mʉhume kʉnihʉɨɨla?” Ʉʉgwa akamʉɨla ʉmʉntʉ nʉanso, “Mʉlete ʉng’waako apaitɨ”<verse eid="LUK 9:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 9:42" />Ʉng’wana ʉyʉ naɨʉpembilye kʉng’wa Yesʉ, hɨng’wɨ ʉyʉ akagalagaligwa pɨhi akagwankolo. Yesʉ akamʉpatya ʉhɨng’wɨ wapume, akamʉponya ʉng’wana nʉanso, akamʉsʉsha kʉng’wɨ ihe. <verse eid="LUK 9:42" /><verse number="43" style="v" sid="LUK 9:43" />Antʉ ɨhi akakʉɨlwa naɨaʉona ʉʉkʉlʉ wang’wi Itunda.</para>
  <para style="s" vid="LUK 9:43">Yesʉ ʉkʉmɨtambʉla hangɨ ɨsha akwe</para>
  <para style="r" vid="LUK 9:43">
    <ref loc="MAT 17:22-23">Matayo 17:22-23</ref>; <ref loc="MRK 9:30-32">Maliko 9:30-32</ref></para>
  <para style="p" vid="LUK 9:43">Antʉ awo naɨalongolekile kʉkʉɨlwa ɨmakani naɨʉkʉtenda, Yesʉ akaatambʉɨla ɨamanyisigwa akwe, <verse eid="LUK 9:43" /><verse number="44" style="v" sid="LUK 9:44" />“Tegeelyi kɨsa aya nɨkʉmʉtambʉɨla itʉngɨlɨ. Ng’wana wa Mʉntʉ ʉkʉtwalwa mʉngulu ya antʉ.” <verse eid="LUK 9:44" /><verse number="45" style="v" sid="LUK 9:45" />Amanyisigwa ang’wa Yesʉ shanga akalɨnga ɨndogoelyo a lʉkani ʉlʉ. Kʉnsoko lʉkani ʉlʉ aɨlʉpihilwe kʉng’waao aleke kʉlɨnga, akakisha kʉmʉkolenkeelya ʉlɨɨye ʉli.<verse eid="LUK 9:45" /></para>
  <para style="s">Nyenyu nʉkʉtula mʉkʉlʉ?</para>
  <para style="r">
    <ref loc="MAT 18:1-5">Matayo 18:1-5</ref>; <ref loc="MRK 9:33-37">Maliko 9:33-37</ref></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46" />Aɨwigee wikʉngʉmi mʉamanyisigwa ɨenso kʉ enso, ingɨ nyenyu nʉkʉtula mʉkʉlʉ kʉkɨla ɨhi. <verse eid="LUK 9:46" /><verse number="47" style="v" sid="LUK 9:47" />Ingɨ ʉ Yesʉ akaalɨngɨlya ɨmasɨgo ao, ʉʉgwa akamʉhola mʉng’yɨnya mʉniino akamʉɨka pang’waakwe. <verse eid="LUK 9:47" /><verse number="48" style="v" sid="LUK 9:48" />Sʉnga akaatambʉɨla, “Mʉntʉ wɨhi nʉʉkʉmʉsɨngɨɨlya ʉmʉng’yɨnya anga ʉyʉ kʉlina lane, ʉkʉtula wansɨngɨɨlya nene, hangɨ wɨhi nʉʉkʉnsɨngɨɨlya nʉnene, ʉkʉtula wamʉsɨngɨɨlya Tata nʉndagɨɨye ʉnene. Kʉnsoko ʉyʉ nɨmʉniino mʉng’waanyu ingɨ yʉyo mʉkʉlʉ kʉkɨla mɨhi.”<verse eid="LUK 9:48" /></para>
  <para style="s">Nɨshanga wɨsa nʉnyenye nʉanso wipalʉng’wɨ nʉnyenye</para>
  <para style="r">
    <ref loc="MRK 9:38-40">Maliko 9:38-40</ref></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49" />Yohana akitanguzɨɨlya akatambʉla, “Isekʉlʉ, kʉmʉɨne mʉntʉ ʉng’wɨ ʉkʉtʉmɨla lina lako kʉzunsa ahɨng’wɨ, ʉsese kamʉgilya kʉnsoko nʉanso shangamɨitʉ.”<verse eid="LUK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 9:50" />Ingɨ ʉ Yesʉ akalʉnga, “Leki kʉmʉgilyi, ʉyʉ nɨshanga ʉkʉhutana nʉnyenye ingɨ nʉanso mɨanyu.”<verse eid="LUK 9:50" /></para>
  <para style="s">Anya kʉ Samalia akʉhita kʉmʉsɨngɨɨlya ʉ Yesʉ</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51" />Matungo naɨahumbeela nang’wa Yesʉ kʉholwa walongole kigʉlʉ, nʉanso akitʉntʉmɨɨlya walongole kʉ Yelusalemu. <verse eid="LUK 9:51" /><verse number="52" style="v" sid="LUK 9:52" />Ʉʉgwa akaalagɨɨlya antʉ amʉtongeele, antʉ nɨanso akatongela akingɨla mʉkɨsalɨ kɨng’wɨ nɨkakʉ Samalia amʉnɨng’anɨlɨlye makani ɨhi. <verse eid="LUK 9:52" /><verse number="53" style="v" sid="LUK 9:53" />Ingɨ akola ihɨɨ nanso aɨahitile kʉmʉsɨngɨɨlya kʉnsoko aɨwitʉntʉmɨɨye kʉ Yelusalemu. <verse eid="LUK 9:53" /><verse number="54" style="v" sid="LUK 9:54" />Amanyisigwa akwe ɨa Yohana nʉ Yakobo, naɨaine aya akalʉnga, “Isekʉlʉ ʉloilwe kʉlagɨɨlye moto ʉsime kʉpuma kilunde ʉalimansɨɨlye?”<verse eid="LUK 9:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 9:55" />Yesʉ akaapɨlʉkɨla akaakenela. <verse eid="LUK 9:55" /><verse number="56" style="v" sid="LUK 9:56" />Yesʉ nɨamanyisigwa akwe akapuma akalongola kɨsalɨ kɨngɨɨza<verse eid="LUK 9:56" /></para>
  <para style="s">Niitakɨwe kʉtula mʉmanyisigwa wang’wa Yesʉ</para>
  <para style="r">
    <ref loc="MAT 8:19-22">Matayo 8:19-22</ref></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57" />Naɨakɨlɨ akolɨ mʉnzɨla mʉntʉ ʉng’wɨ akamʉtambʉɨla ʉ Yesʉ, “Kʉʉtyatiila nkɨka yɨhi kʉwinzʉ.”<verse eid="LUK 9:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 9:58" />Yesʉ akamʉɨla ʉmʉntʉ ʉyʉ, “Amʉlʉla akete igaya niakipɨhɨla, ninyʉnyi ikete iiuyɨ, ingɨ Ng’waa Mʉntʉ mʉgila ndalo nʉʉsupɨlyo.”<verse eid="LUK 9:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 9:59" />Yesʉ akamʉɨla mʉntʉ mʉngɨɨza, “Ntyate.” Ingɨ mʉntʉ nʉanso akamʉɨla, “Isekʉlʉ ndeke hanza nende nʉmʉɨke ʉtataane.”<verse eid="LUK 9:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 9:60" />Yesʉ akamʉɨla, “Aleke ɨanyakɨlɨngʉ aaɨke ɨashiao, Ʉewe longola wendetanantya Ʉtemi wang’wi Itunda.”<verse eid="LUK 9:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 9:61" />Nʉmʉntʉ mʉya akamʉɨla, “Ʉnene kʉʉtyata, itungo ɨlɨ ngombye hanza nendealaga awa nɨkikalania mitolane.”<verse eid="LUK 9:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 9:62" />Yesʉ akamʉɨla, “Mʉntʉ wɨhi nʉandyaa kʉlɨma kʉnʉ ʉkikeya, shanga ʉtakɨwe kitʉma Mʉʉtemi wang’wi Itunda.”<verse eid="LUK 9:62" /></para>
  <chapter eid="LUK 9" />
  <chapter number="10" style="c" sid="LUK 10" />
  <para style="s">Yesʉ ʉkʉlagɨɨlya awo nɨmakʉmi mʉpungatɨ na abɨɨlɨ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1" />Naɨwakondya kitʉma nanso, Isekʉlʉ akaahola nɨaʉya makʉmi mʉpungatɨ na abɨɨlɨ, akaalagɨɨlya alongole abɨɨlɨ abɨɨlɨ mʉisalɨ nʉanso naɨʉlomee kʉlongola. <verse eid="LUK 10:1" /><verse number="2" style="v" sid="LUK 10:2" />Amanyisigwa awa naɨakɨlɨ kʉhega akaatambʉɨla, “Niyakʉogolwa yɨdʉ, ingɨ ɨaogoli asheenyʉ. Mʉlompi Isekʉlʉ nʉa ʉogoli wanɨɨle ɨaogolɨ nɨakwɨɨe mʉmʉgʉnda wakwe. <verse eid="LUK 10:2" /><verse number="3" style="v" sid="LUK 10:3" />Ʉʉgwa longoli. Mʉlɨnge kɨna kʉmʉlagɨɨlya ʉnyenye anga ɨanaankolo mʉmbugi. <verse eid="LUK 10:3" /><verse number="4" style="v" sid="LUK 10:4" />Leki kikenkeelyi ɨmbogoshi ang’wɨ nkapu ang’wɨ makwasa akʉkaɨla, leki kilamʉshi nʉ mʉntʉ wɨhi mʉnzɨla. <verse eid="LUK 10:4" /><verse number="5" style="v" sid="LUK 10:5" />Nyʉmba ɨhi anga mʉsɨngɨɨligwe, alamʉshi itɨ, ‘Ʉtɨgi wang’wi Itunda ʉtule ʉmolɨ mʉakola nyʉmba.’ <verse eid="LUK 10:5" /><verse number="6" style="v" sid="LUK 10:6" />Anga itule ʉmolɨ mʉntʉ nʉloilwe ʉtɨgi mʉnyʉmba nanso, ʉʉgwa mʉkʉsʉkɨlwa nʉ ʉtɨgi wanyu, anga itule wɨkʉtilɨ mʉkʉsʉkɨlwa nʉʉtɨgi wanyu. <verse eid="LUK 10:6" /><verse number="7" style="v" sid="LUK 10:7" />Ikii mʉnyʉmba nanso mʉzelya nʉkʉng’wa kɨhi nɨakʉmʉpa, kʉnsoko mitʉmi wɨpegwaa ɨkɨpegwa kakwe. Leki kʉhamambyi nyʉmba yɨdʉ. <verse eid="LUK 10:7" /><verse number="8" style="v" sid="LUK 10:8" />Anga mingɨle mʉkɨsalɨ nɨkanso lyii kɨhi nɨakʉmʉpa, <verse eid="LUK 10:8" /><verse number="9" style="v" sid="LUK 10:9" />aponyi ɨalwae nɨamolɨ mʉng’wanso, hangɨ atambʉɨlɨ ɨantʉ, ‘Ʉtemi wang’wi Itunda wahumbeela.’ <verse eid="LUK 10:9" /><verse number="10" style="v" sid="LUK 10:10" />Ingɨ anga mingɨle kɨsalɨ kɨhi ahite kʉmʉsɨngɨɨlya, pumi napa nɨmʉkʉkɨɨla mʉnzɨla yao tambʉli kɨna, <verse eid="LUK 10:10" /><verse number="11" style="v" sid="LUK 10:11" />‘Nʉlʉnkʉndɨ nʉla kɨsalɨ kanyu nʉlʉkamantɨɨe mʉmɨgʉlʉ itʉ kʉʉpunʉnta. Ingɨ mʉlɨnge kɨna ʉtemi wang’wi Itunda wahumbeela.’ <verse eid="LUK 10:11" /><verse number="12" style="v" sid="LUK 10:12" />Kʉlʉ kʉʉlʉ kʉmʉɨla kɨna, ɨantʉ akɨsalɨ nɨkanso akagigwa kʉkɨla naɨagigwe ɨantʉ nɨakʉ Sodoma.”<verse eid="LUK 10:12" /></para>
  <para style="s">Lwago kʉ antʉ aisalɨ nɨshanga akila itʉnʉ</para>
  <para style="r">
    <ref loc="MAT 11:20-24">Matayo 11:20-24</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13" />“Yʉkʉtula lwago kʉ antʉ akʉ Kolazini. Nʉnyenye nɨmɨkiɨ kʉ Betisaida kʉnsoko maona ilɨngasɨɨlyo yidʉ. Kʉnsoko ɨmɨʉkʉɨlwa ɨyɨ nɨkitʉng’wa kʉng’waanyu ɨze ɨtendilwe kʉ antʉ akʉ Tilo nʉkʉ Sidoni, antʉ akwe kalɨ ɨze apeile kitʉmaa ʉʉbɨ, hangɨ ɨze itungilee magʉnɨla nʉkisensela mau anga ʉkɨa nʉa mɨlandʉ ao. <verse eid="LUK 10:13" /><verse number="14" style="v" sid="LUK 10:14" />Lʉhikʉ Itunda nʉkʉlamʉlwa, yʉkʉtula bahu Tilo nɨ Sidoni kʉgimya ʉpɨsɨɨligwa wao kʉkɨla ʉnyenye. <verse eid="LUK 10:14" /><verse number="15" style="v" sid="LUK 10:15" />Nʉnyenye antʉ akʉ Kapalinaʉmu, itɨɨ, mʉkʉkʉligwa kʉpikɨɨle kilunde ne? A, a! Mʉkʉsimigwa kʉpikɨɨla kʉʉlʉngʉ”<verse eid="LUK 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16" />Yesʉ akalongoleka kʉatambʉɨla amanyisigwa akwe, “Mʉntʉ wɨhi nʉkʉtula nʉ lwijo kʉng’wanyu, mʉntʉ nʉanso ʉkʉtula ʉkete lwijo kʉng’wane. Nʉ mʉntʉ wɨhi nɨmʉgila anga lwijo kʉng’wane mʉntʉ nʉanso ʉkʉtula mʉgila lwijo kʉng’wa Tata nʉndagɨɨye ʉnene.”<verse eid="LUK 10:16" /></para>
  <para style="s">Awo nɨ makʉmi mʉpungatɨ na abɨɨlɨ akatʉlya</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17" />Panyambele awo nɨ makʉmi mʉpungatɨ na abɨɨlɨ naɨalagɨɨgwe akatʉlya iloile, akalʉnga, “Isekʉlʉ, ahɨng’wɨ akʉhega mʉantʉ anga kʉakenele kʉngulu nʉʉhumi wako.”<verse eid="LUK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 10:18" />Yesʉ akaasʉkɨɨlya, “Azanʉmʉine shetani ʉtʉngʉkile kʉpembelya kilunde anga lʉpɨto. <verse eid="LUK 10:18" /><verse number="19" style="v" sid="LUK 10:19" />Yesʉ akaatambʉɨla amanyisigwa akwe namʉpeza ʉnyenye ʉhumi nʉa kʉpambata nzoka ni nkʉmɨ nʉʉhumi nʉakʉahuma nɨalʉgʉ anyu ɨhi, kʉtilɨ anga kɨntʉ kɨhi nɨkɨkʉmʉlemaalya. <verse eid="LUK 10:19" /><verse number="20" style="v" sid="LUK 10:20" />Nɨitɨga leki kiloi kʉnsoko ahɨng’wɨ akete lwijo kʉng’waanyu, ingɨ iloi kʉnsoko ɨmina anyu andɨkilwe kigʉlʉ.”<verse eid="LUK 10:20" /></para>
  <para style="s">Yesʉ ʉkiloa</para>
  <para style="r">
    <ref loc="MAT 11:25-27">Matayo 11:25-27</ref>; <ref loc="MAT 13:16-17">13:16-17</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21" />Itungo lɨlo lɨɨlo Yesʉ akaze ʉkete Ng’wahʉ wang’wi Itunda akiloa, wazelʉnga, “Kʉʉlʉmbɨɨlya Tata, Isekʉlʉ nʉigʉlʉ nihɨɨ, kʉnsoko ɨmakani aya ʉapɨhile anyamahala nɨalɨngi amakani, waapihʉɨla ɨang’ɨnya nianiino, kʉnsoko nanso yayo akʉloile.”<verse eid="LUK 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 10:22" />Sʉnga akatambʉla, “Tataane ʉmpee ʉhumi nʉa kitʉma maintʉ ɨhi. Kʉtilɨ mʉntʉ wɨhi nʉmʉlɨngile Ʉng’wana kwaala Ʉtata ʉdu, ang’wi nʉmʉlingɨle ʉ Tata kwaala Ng’wana wakwe, nʉyo wɨhi ʉ Ng’wana nʉloilwe kʉakʉmʉɨla.”<verse eid="LUK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 10:23" />Sʉnga akaagozeela amanyisigwa akwe akaatambʉɨla, “Akembetilwe mʉntʉ ʉyo nʉkʉmaona ɨmakani aya nɨmʉkʉmaona ʉnyenye. <verse eid="LUK 10:23" /><verse number="24" style="v" sid="LUK 10:24" />Kʉlʉ kʉʉlʉ kʉmʉɨla, amanga ang’wi Itunda ɨdʉ nɨatemi aɨakete nsʉla akʉmaona aya nɨmʉkʉmaona ingɨ shanga aɨamaine, nʉkija aya nɨmʉkija ʉnyenye shanga akija.”<verse eid="LUK 10:24" /></para>
  <para style="s">Mpyani amʉntʉ nʉa kʉ Samalia nɨmʉkende</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25" />Lʉhikʉ lʉng’wɨ mʉmanyisi nʉa malagɨɨlyo wɨkimɨka wamʉgeme ʉ Yesʉ, “Mʉmanyisi nʉmʉkende, ntende ʉlɨ nihume kʉlija ʉpanga mahikʉ ɨhi nɨmagila ɨmpelo?”<verse eid="LUK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 10:26" />Yesʉ akamʉkolya, “Wɨlɨnga ntʉni anga ʉsome mʉmalagɨɨlyo ang’wa Musa?”<verse eid="LUK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 10:27" />Mʉmanyisi nʉa malagɨɨlyo akasʉkɨɨlya, “Mʉlowe Isekʉlʉ Itunda ako kʉnkolo ako ɨhi nʉ Ng’wahʉ wako wɨhi ningulu yako yɨhi nɨmahala ako ɨhi,’ hangɨ ‘Mʉlowe nʉ mʉnyakɨsalɨ nʉako anga nʉiloilwe ʉewe.”’<verse eid="LUK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 10:28" />Yesʉ akamʉɨla, “Wasʉkɨɨlya iza, itʉme ʉʉ, nʉewe ʉkikiɨ ni Itunda mahikʉ ɨhi nɨmagila ɨmpelo.’’<verse eid="LUK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 10:29" />Ingɨ mʉmanyisi nʉamalagɨɨlyo ʉyʉ akatulikumʉsha kɨna nʉanso mʉnyamahala, akamʉkolya ʉ Yesʉ, “Mʉnyakɨsalɨ wane nyenyu?”<verse eid="LUK 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 10:30" />Yesʉ wɨkamʉsʉkɨɨlya, “Mʉntʉ ʉng’wɨ aɨʉkʉhulumʉka ʉpembeeye kʉ Yelusalemu ʉlongoe kʉ Yeliko, mʉnzɨla wɨkaambwa nɨantʉ nɨabɨ wɨkamʉtugʉla ɨngʉo, wɨkamʉkʉa nʉkʉmʉlemaalya, wɨkamʉleka ʉkʉhiya kʉsha. <verse eid="LUK 10:30" /><verse number="31" style="v" sid="LUK 10:31" />Kʉlyoa lakwe wɨkapembya Mʉpolyi wang’wi Itunda ʉkɨɨe nzɨla yɨyo, naɨʉmʉine ʉdu wɨkamʉhʉga wɨkakɨɨla ipande. <verse eid="LUK 10:31" /><verse number="32" style="v" sid="LUK 10:32" />Itungo ʉdu wɨkapembya mʉntʉ ʉng’wɨ nɨmʉhemba waapolyi, naɨʉpikile pang’wanso naɨwamʉona, nʉng’wenso wɨkamʉhʉga wɨkakɨɨla ipande. <verse eid="LUK 10:32" /><verse number="33" style="v" sid="LUK 10:33" />Ingɨ mʉntʉ ʉng’wɨ kʉpuma kɨsalɨ ka Samalia aɨʉkolɨ mʉmʉhɨnzo ʉkɨɨe nzɨla yɨyo yɨɨyo, naɨwapika pang’wanso nʉkumʉona ʉmʉntʉ ʉyʉ, wɨkamʉaisɨɨlya. <verse eid="LUK 10:33" /><verse number="34" style="v" sid="LUK 10:34" />Wɨkalongola naɨʉkolɨ wɨkamʉhola wɨkoja inkomele yakwe nʉkʉpaka makʉta nɨdibai, wɨkamʉtungɨlya inkomele, sʉnga wɨkamʉkenka mʉndogwe akwe, wɨkamʉtwala Mʉnyʉmba nɨɨlala ɨazɨɨla, nʉkʉmʉkela. <verse eid="LUK 10:34" /><verse number="35" style="v" sid="LUK 10:35" />Naɨwela mʉdaʉ akwe, wɨkamʉlekela ʉmʉkola nyʉmba ʉnyinyʉ ʉbɨɨlɨ nʉa nangʉ apeza wɨkamʉlagɨɨlya, ‘Mʉlwalye ʉmʉntʉ ʉyʉ, kɨhi nɨkɨkʉkɨlɨnkɨɨla anga ngomoke nzee kʉsʉkɨɨlya.”’<verse eid="LUK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 10:36" />Sʉnga ʉ Yesʉ akamʉkolya, “Ʉsɨgile mʉantʉ awa nɨataatʉ, ʉmʉnyakɨsalɨ nʉa mʉntʉ ʉyʉ naɨʉkʉilwe nɨantʉ nɨabɨ nʉʉli?”<verse eid="LUK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 10:37" />Mʉmanyisi nʉa malagɨɨlyo akasʉkɨɨlya, “Ʉyʉ naɨʉmʉaisɨɨye yʉyo mʉnyakɨsalɨ wakwe”</para>
  <para style="p" vid="LUK 10:37">Yesʉ akamʉtambʉɨla, “Longola nʉewe witʉme ʉʉ.”<verse eid="LUK 10:37" /></para>
  <para style="s">Yesʉ ʉkʉiʉmbaʉmbɨla Malita nʉ Maliamu</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38" />Yesʉ nɨamanyisigwa akwe naɨakolɨ nʉmʉhɨnzo, akapika kɨsalɨ kɨng’wɨ, mʉsʉngʉ ʉng’wɨ witangwaa Malita, akamʉsingɨilya mitolakwe. <verse eid="LUK 10:38" /><verse number="39" style="v" sid="LUK 10:39" />Malita aɨʉkete mʉluna nʉakɨsʉngʉ witangwa Maliamu, Maliamu akikiɨ pang’wa Yesʉ umʉtengeeye. <verse eid="LUK 10:39" /><verse number="40" style="v" sid="LUK 10:40" />Ingɨ ʉ Malita nʉanso aɨʉkikɨza nɨmɨlɨmo ɨdʉ. Sʉnga ʉ Malita akamʉɨla ʉ Yesʉ, “Isekʉlʉ, shanga ʉkee kɨna ʉmʉluna wane ʉndekeeye ɨmɨlɨmo? Mʉɨle wanzaɨɨlye.”<verse eid="LUK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 10:41" />Yesʉ akamʉɨla ʉ Malita, “Malita, Malita, nɨkɨ ʉkʉnyomeka nɨmakani ɨdʉ, <verse eid="LUK 10:41" /><verse number="42" style="v" sid="LUK 10:42" />ingɨ kɨntʉ kɨng’wɨ du nɨkɨza nɨkɨtakɨwe. Maliamu wihoeeye kɨntʉ kɨza, hangɨ kʉtilɨ anga mʉntʉ nʉʉkʉmʉhegelya.”<verse eid="LUK 10:42" /></para>
  <chapter eid="LUK 10" />
  <chapter number="11" style="c" sid="LUK 11" />
  <para style="s">Yesʉ ʉkʉmanyisa amanyisigwa akwe kʉlompa</para>
  <para style="r">
    <ref loc="MAT 6:9-13">Matayo 6:9-13</ref>; <ref loc="MAT 7:7-11">7:7-11</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1" />Lʉhikʉ lʉng’wɨ Yesʉ aɨʉkʉlompa. Naɨwakondya kʉlompa, mʉmanyisigwa ʉng’wɨ akamʉɨla, “Isekʉlʉ, kʉʉlompa ʉkʉmanyise nʉsese kʉlompa anga ʉ Yohana Mʉbadisi naɨ ʉamanyisilye amanyisigwa akwe.”<verse eid="LUK 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 11:2" />Yesʉ akaatambʉɨla, “Nimʉkʉlompa lʉngi itɨ,</para>
  <para style="q" vid="LUK 11:2">‘Tata witʉ nʉkolɨ kigʉlʉ.</para>
  <para style="q" vid="LUK 11:2">Lina lako lɨkʉligwe,</para>
  <para style="q" vid="LUK 11:2">ʉteme wako ʉze.<verse eid="LUK 11:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="LUK 11:3" />Ʉkʉpe ndya yitʉ nia mahikʉ ɨhi.<verse eid="LUK 11:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="LUK 11:4" />Ʉkʉlekele ɨmagazo itʉ</para>
  <para style="q" vid="LUK 11:4">anga ʉsese nɨkɨalekela nɨakʉgazɨɨye,</para>
  <para style="q" vid="LUK 11:4">Leka kʉʉtwala mʉʉgeng’wa.”’<verse eid="LUK 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 11:5" />Sʉnga ʉ Yesʉ akaatambʉɨla, “Nyenyu mʉng’waanyu nʉpumile ʉtikʉ wigengu wamʉhange ʉmʉhʉmbamʉya wamʉile, ‘Mʉhʉmbamɨane nkopise mɨkate ɨtaatʉ. <verse eid="LUK 11:5" /><verse number="6" style="v" sid="LUK 11:6" />Kʉnsoko nagenipwaa nʉmʉnyandʉgʉ, nʉnene nɨmʉgila nɨkakʉmʉtengela.’ <verse eid="LUK 11:6" /><verse number="7" style="v" sid="LUK 11:7" />Ʉyʉ nʉa Mʉnyʉmba wamʉsʉkɨɨlye walʉnge, ‘Leka kʉnaja, nalugaɨlaa ʉlʉjɨ. ʉnene nɨanaane kʉlae, shanga kʉʉka nʉkʉaɨɨlye nʉkɨloilwe.’ <verse eid="LUK 11:7" /><verse number="8" style="v" sid="LUK 11:8" />Kʉlʉ kʉʉlʉ kʉmʉɨla, palʉng’wɨ nɨ kɨna shanga ʉkʉʉka wamʉpe ʉmʉkate, ingɨ kʉnsoko aʉhʉmbaʉya ʉdu, ingɨ kʉnsoko ʉlongolekile kʉminena, ʉkʉʉka nʉkʉminkɨɨlya kɨhi nʉlompile.<verse eid="LUK 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 11:9" />“Kʉlʉlo kʉmʉɨla, lompi nʉnyenye mʉkʉpegwa, dumi nʉnyenye mʉkʉlija, pɨndʉli nʉnyenye mʉkʉlugʉɨlwa mʉlango. <verse eid="LUK 11:9" /><verse number="10" style="v" sid="LUK 11:10" />Kʉnsoko mʉntʉ wɨhi nʉilompa wipegwa, nʉmʉntʉ nʉɨdʉma wɨlɨja nʉyʉ nʉɨpɨndʉla wɨlugʉɨlwa mʉlango. <verse eid="LUK 11:10" /><verse number="11" style="v" sid="LUK 11:11" />Itɨɨ, tata kɨɨ mʉng’wanyu anga ʉng’wana wakwe wamʉlompe nsamaki, ʉkʉmʉpa nzoka ɨtule yɨyo nsamaki? <verse eid="LUK 11:11" /><verse number="12" style="v" sid="LUK 11:12" />Ang’wɨ anga walompe ijɨ ʉkʉmʉpa nkʉmɨ? <verse eid="LUK 11:12" /><verse number="13" style="v" sid="LUK 11:13" />Anga itule ʉnyenye nɨmɨabɨ, mʉlɨngile kʉapa ɨanaanyu maintʉ nɨmaza, ingɨ, Tata wanyu nʉa kigʉlʉ ʉkʉkɨlɨnkɨɨla ikɨlo kʉapa Ng’wahʉ wang’wi Itunda ɨhi nɨɨmʉlompa.”<verse eid="LUK 11:13" /></para>
  <para style="s">Yesʉ nʉ Belizebʉli</para>
  <para style="r">
    <ref loc="MAT 12:22-30">Matayo 12:22-30</ref>; <ref loc="MRK 3:20-27">Maliko 3:20-27</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14" />Lʉhikʉ lʉng’wɨ Yesʉ aɨʉkʉpumya hɨng’wɨ naɨʉmʉtendile ʉmʉntʉ kʉtula ʉkɨmumɨ. Hɨng’wɨ ʉyo naɨwamʉpuma, mʉntʉ ʉyʉ naɨkɨmumɨ akahuma kʉligitya, iʉmbɨ laantʉ lɨkakʉɨlwa. <verse eid="LUK 11:14" /><verse number="15" style="v" sid="LUK 11:15" />Ingɨ ang’wɨ wao akatambʉla, “Ʉkʉapumya ahɨng’wɨ kʉʉhumi wang’wa Belizebuli, nimʉkʉlʉ nʉahɨng’wɨ.”<verse eid="LUK 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 11:16" />Nɨang’wi aɨamʉgemile ʉ Yesʉ, akamʉɨla witʉme ilɨngasɨɨlyo kʉpuma kigʉlʉ, ahume kʉlɨnga kɨna ʉʉhumi wakwe ʉpembeeya kigʉlʉ. <verse eid="LUK 11:16" /><verse number="17" style="v" sid="LUK 11:17" />Yesʉ akaalɨngɨlya ɨmasɨgo ao, akaatambʉɨla, “Ʉtemi wɨhi nʉʉkikʉngʉma wenso kʉ wenso, ʉkʉlimansɨɨla, nɨ antʉ nɨa nyʉmba ɨng’wɨ anga ikʉngʉme ɨenso, ɨkʉtalʉka. <verse eid="LUK 11:17" /><verse number="18" style="v" sid="LUK 11:18" />Anga ʉʉtemi nʉang’wa shetani ʉkinkʉngʉma wenso kʉ wenso, ʉtemi wakwe ʉkimɨka ʉli? Kʉmʉɨla itɨ kʉnsoko mʉkʉlʉnga kɨna kʉheja ahɨng’wɨ kʉʉhumi wang’wa Belizebʉli? <verse eid="LUK 11:18" /><verse number="19" style="v" sid="LUK 11:19" />Itungɨlɨ angaɨze ʉnene kʉazunsa ahɨng’wɨ kʉʉhumi wang’wa Belizebʉli, ahemba anyu akʉzunsa kʉʉhumi wang’wa nyenyu? Kʉnsoko nɨanso ɨahemba anyu wawo akʉmʉlamʉla ʉnyenye. <verse eid="LUK 11:19" /><verse number="20" style="v" sid="LUK 11:20" />Ingɨ angaɨze kʉzunsa ahɨng’wɨ kʉʉhumi wang’wi Itunda, kʉlʉlo lɨngi kɨna Itunda mʉteme wahugeela.<verse eid="LUK 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 11:21" />“Mʉnyangulu nʉihambile kʉ yɨgɨ yɨhi nʉkʉlila ɨnyʉmba akwe, nsao yakwe yɨhi shanga yʉkʉholwa. <verse eid="LUK 11:21" /><verse number="22" style="v" sid="LUK 11:22" />Ingɨ anga wapike mʉnyangulu kʉkɨla nʉanso wamʉkʉe nʉkʉmʉhumɨɨlya, wɨholaa yɨgɨ yakwe yɨhɨ nʉisanilye nʉkʉgalania nsao yakwe.<verse eid="LUK 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 11:23" />Mʉntʉ wɨhi nɨshanga wɨpalʉng’wɨ nʉnene, nʉanso ingɨ wɨnsuta wane, nʉyʉ wɨhi nɨshanga wilingɨɨla palʉng’wɨ nʉnene, nʉanso wɨbalansania.<verse eid="LUK 11:23" /></para>
  <para style="s">Kʉsʉka kʉng’wa hɨng’wɨ</para>
  <para style="r">
    <ref loc="MAT 12:43-45">Matayo 12:43-45</ref></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24" />“Hɨng’wɨ anga wamʉpume ʉmʉntʉ, wiʉmbaʉmba mʉwɨɨ wapenze paʉsupɨlyo. Anga waʉlye, witambʉlyaa ʉng’wenso. ‘Kʉtulya mʉnyʉmba naza mpumɨɨe.’ <verse eid="LUK 11:24" /><verse number="25" style="v" sid="LUK 11:25" />Nʉkʉpika nʉkʉhanga ɨnyʉmba ɨpyagʉe nʉkʉnoneeligwa iza. <verse eid="LUK 11:25" /><verse number="26" style="v" sid="LUK 11:26" />Papogwa wendaanɨɨla ahɨng’wɨ aʉya mʉpungatɨ nɨabɨ kʉkɨla nʉanso, ahɨng’wɨ nɨanso akʉlogola nʉkingɨla nʉkikiɨ mʉng’wanso. Ʉʉgwa ʉmʉntʉ ʉyʉ wɨtulaa mʉbɨ kʉkɨla pang’wandyo.”<verse eid="LUK 11:26" /></para>
  <para style="s">Ʉkembetwa nʉʉza</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27" />Yesʉ naɨʉkʉtambʉla itɨ, mʉsʉngʉ ʉng’wɨ kʉpumɨɨla miumbɨ naɨlɨmʉtegeeye, akitʉnta, akalʉnga, “Ʉkembetilwe mʉsʉngʉ, nʉkʉtugile nʉkʉonsha.”<verse eid="LUK 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 11:28" />Ingɨ ʉ Yesʉ akamʉsʉkɨɨlya, “Ingɨ akembetilwe awo nɨakija ʉlʉkani lang’wi Itunda nʉkʉlʉtyata.”<verse eid="LUK 11:28" /></para>
  <para style="s">Antʉ amahikʉ aya akʉhiya ɨlɨngasɨɨlyo</para>
  <para style="r">
    <ref loc="MAT 12:38-42">Matayo 12:38-42</ref></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29" />Ʉʉgwa iumbɨ la antʉ naɨongeeleka, Yesʉ akalongoleka kʉmanyisa, “Antʉ a mahikʉ aya aloilwe kɨlɨngasɨɨlyo, ingɨ shanga lɨkʉlagɨɨlwa kɨlɨngasɨɨlyo kɨhi, kwaala kɨlɨngasɨɨlyo kang’wa Yona. <verse eid="LUK 11:29" /><verse number="30" style="v" sid="LUK 11:30" />Anga ʉ Yona naɨkɨlɨngasɨɨlyo ka kʉalagɨɨla antʉ a kʉ Ninawi, ʉʉgwa ʉ Ng’waa Mʉntʉ ʉkʉtula kɨlɨngasɨɨlyo kʉantʉ a matungo aya. <verse eid="LUK 11:30" /><verse number="31" style="v" sid="LUK 11:31" />Lʉhikʉ nʉla ʉlamʉlwa, mʉtemi nʉa kɨsʉngʉ ʉkimɨka palʉng’wɨ nɨantʉ a matungo aya nʉkʉasemela, kʉsoko nʉanso aɨ ʉpembeeye kʉlɨ kʉza kʉtegeelya makani amahala na mʉtemi Sulemani. Apaitɨ ʉkolɨ mʉkʉlʉ kʉkɨla Sulemani. <verse eid="LUK 11:31" /><verse number="32" style="v" sid="LUK 11:32" />Lʉhikʉ nʉla ʉlamʉlwa antʉ akʉ Ninawi akimɨka kʉalamʉla antʉ amahikʉ aya, kʉnsoko nɨanso aɨ ila itʉnʉ kʉnsoko Yona aɨwaatanantɨlya, napaɨtɨ ʉkolɨ nʉmʉkʉlʉ kʉkɨla ʉ Yona.<verse eid="LUK 11:32" /></para>
  <para style="s">Nzelya amʉɨlɨ</para>
  <para style="r">
    <ref loc="MAT 5:15">Matayo 5:15</ref>; <ref loc="MAT 6:22-23">6:22-23</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33" />“Kʉtilɨ mʉntʉ nʉakɨɨlya lʉmʉli akaɨka nʉkʉkunɨkɨla pihɨ ashʉngʉ, anga wakilye wɨpagɨka paʉpagɨko, ingɨ antʉ nɨakingɨla mʉnyʉmba ahume kʉona. <verse eid="LUK 11:33" /><verse number="34" style="v" sid="LUK 11:34" />Liho lako ingɨ lɨhanga lʉmʉlɨ lamʉɨlɨ wako, miho ako anga atule mapanga, mʉɨlɨ wako wɨhi weigwe. Ingɨ angaɨze miho ako shanga akʉona, nʉmʉɨlɨ wako wɨhi ʉkʉtula mʉkiti. <verse eid="LUK 11:34" /><verse number="35" style="v" sid="LUK 11:35" />Kendegeela, nzelya nɨmolɨ mʉng’waako ɨleke kʉtula kitɨ. <verse eid="LUK 11:35" /><verse number="36" style="v" sid="LUK 11:36" />Mʉɨlɨ wako wɨhi angaʉtule ʉkete nzelya, ɨzekʉtilɨ ipiliga lɨhi nɨlɨkete kiti, mʉɨlɨ nʉanso ʉkelya anga lʉmʉli nʉleiye.”<verse eid="LUK 11:36" /></para>
  <para style="s">Yesʉ ʉkʉakunka Apalisayo nɨamanyisi amalagɨɨlyo ang’wa Musa</para>
  <para style="r">
    <ref loc="MAT 23:1-36">Matayo 23:1-36</ref>; <ref loc="MRK 12:38-40">Maliko 12:38-40</ref></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37" />Yesʉ naɨwakondya kʉtambʉla, Palisayo ʉng’wɨ akamʉlompa wingɨle mitolakwe walye indya, Yesʉ akingɨla, akikiɨ walye. <verse eid="LUK 11:37" /><verse number="38" style="v" sid="LUK 11:38" />Ingɨ ʉ Palisayo akakʉɨlwa naɨwaona ʉ Yesʉ akatulalya shanga waze ʉkalae ɨmɨkono akwe. <verse eid="LUK 11:38" /><verse number="39" style="v" sid="LUK 11:39" />Ingɨ Isekʉlʉ akamʉtambʉɨla, “Ʉnyenye Apalisayo mojaa ɨsahani niikombe shakʉnzi ʉdu, ingɨ mʉkatɨ mizʉe ʉlaku nʉʉbɨ. <verse eid="LUK 11:39" /><verse number="40" style="v" sid="LUK 11:40" />Ʉnyenye mɨapʉngʉ. Itɨɨ, nʉtundile kʉnzi amʉɨlɨ, shanga yʉyo ʉtundile nʉmʉkatɨ? <verse eid="LUK 11:40" /><verse number="41" style="v" sid="LUK 11:41" />Ʉʉgwa yɨhi nɨmʉkete api aʉla kʉnkolo nzelʉ pee, nʉnyenye mʉkʉgombeka kʉ ntendo niakʉmʉkʉlya Itunda.<verse eid="LUK 11:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42" />Ingɨ mʉkaga ʉnyenye Apalisayo ingɨ shanga mʉkee kʉatendeela ɨantʉ nʉmaza nʉ kʉmʉlowa Itunda. Ingɨ mɨmʉpeza Itunda iganda likʉmi nɨla maintʉ maniino, anga nyenyi niamapwa niilʉngɨlo ya ndya. mʉtakɨwe kʉatendeela nɨangɨɨza iza nʉ kʉmʉlowa Itunda palʉng’wɨ nʉ kʉpumya iganda lɨng’wɨ mʉ maganda ikʉmi.<verse eid="LUK 11:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 11:43" />“Mʉkaga ʉnyenye Apalisayo, kʉnsoko ɨza imʉloile kikiɨ mʉmatuntu akʉntongeela mʉnyʉmba nia kʉtankanɨla Ayahudi, nʉkʉlamukigwa kʉlʉkumo mʉmagalagalo. <verse eid="LUK 11:43" /><verse number="44" style="v" sid="LUK 11:44" />Mʉkaga kʉnsoko mɨhangaa ibɨɨla niigila ilɨngasɨɨlyo, antʉ ɨpambataa shanga ɨzealɨngile.”<verse eid="LUK 11:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45" />Mʉmanyisi ʉng’wɨ nʉa malagɨɨlyo akamʉsʉkɨɨlya ʉ Yesʉ, “Mʉmanyisi wainakʉkunka nʉsesega.”<verse eid="LUK 11:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 11:46" />Yesʉ akamʉsʉkɨɨlya, “Mʉkaga nʉnyenye amanyisi amalagɨɨlyo, kʉnsoko mʉkʉatika ɨantʉ mɨligo nɨmɨlito nɨlemekile kʉkenkwa ganʉkʉgemela, hangɨ ʉnyenye shanga mʉkʉaɨɨlya. <verse eid="LUK 11:46" /><verse number="47" style="v" sid="LUK 11:47" />Mʉkaga, kʉnsoko mʉkʉzengeela iibɨɨla ya amanga ang’wi Itunda awo atata anyu naɨ aabʉlagile. <verse eid="LUK 11:47" /><verse number="48" style="v" sid="LUK 11:48" />Papogwa mʉkʉlagɨɨla kɨna migombilye nintendo niya atata anyu naɨitʉmile, kʉnsoko nɨanso aɨ aabʉlagile ɨamanga nɨang’wi Itunda, nʉnyenye mʉkʉzengeela ibɨɨla nianso, mʉkʉkʉlya ɨnsha ao kʉnʉ shanga mʉtyatile ayo naɨ atanantilye. <verse eid="LUK 11:48" /><verse number="49" style="v" sid="LUK 11:49" />Ki ikani ɨlɨ, Itunda mʉmahala akwe aɨʉtambʉe, ‘Goza, kʉalagɨɨlɨlya amanga ang’wi Itunda nɨitʉmɨ, nɨanso akʉabʉlaga ang’wɨao, nɨangɨɨza akʉaja.’ <verse eid="LUK 11:49" /><verse number="50" style="v" sid="LUK 11:50" />Kʉlʉlo ʉnyenye nɨmʉleilwe itɨ nawa nɨamʉtongee mʉkʉpɨsɨɨligwa kʉnsoko asakami ɨhi na amanga ang’wi Itunda naɨhunʉkile kʉpumɨɨla ʉʉmbwa wihɨɨ, <verse eid="LUK 11:50" /><verse number="51" style="v" sid="LUK 11:51" />kʉpumɨɨla kʉbʉlagwa kʉng’wa Abeli kʉpikɨɨla kʉbʉlagwa kʉng’wa Zekalia naɨamʉbʉlagɨe pakatɨ itekeelo nɨ Nyʉmba ang’wi Itunda. Ee, kʉmʉtambʉɨla kɨna ʉnyenye nɨmʉleilwe itɨ mʉkʉpɨsɨɨlɨgwa kʉnsoko a yayo.<verse eid="LUK 11:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 11:52" />“Mʉkaga ʉnyenye amanyisi amalagɨɨlyo, kʉnsoko mʉagiilye ɨantʉ kʉmʉlɨnga Itunda, nʉnyenye shanga mʉmʉlɨngɨle Itunda hangɨ mʉagiilye awa nɨaloilwe kʉmʉlɨnga.”<verse eid="LUK 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53" />Yesʉ naɨʉkʉhega pang’wanso, Apalisayo nɨamanyisi amalagɨɨlyo ang’wa Musa akatula mʉikʉngʉmya kʉngulu nʉkʉmʉpatɨɨlya kʉ makolyo ɨdʉ, <verse eid="LUK 11:53" /><verse number="54" style="v" sid="LUK 11:54" />akamʉtungɨla ahume kʉmʉambisa kʉ nkani yakwe.<verse eid="LUK 11:54" /></para>
  <chapter eid="LUK 11" />
  <chapter number="12" style="c" sid="LUK 12" />
  <para style="s">Yesʉ ʉkʉakenela antʉ nɨitedisaa akʉmitʉmɨla Itunda</para>
  <para style="r">
    <ref loc="MAT 10:26-27">Matayo 10:26-27</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1" />Matungo nanso maumbɨ aantʉ ɨdʉ ikɨlo akilʉndɨɨla sʉnga akatulipanangɨla, Yesʉ akatulitabʉlya nɨamanyisigwa akwe hanza, akalʉnga, “Hʉgʉki mʉleke kʉtenda anga Apalisayo, ingɨ itendisa kɨna amʉtyatile Itunda. <verse eid="LUK 12:1" /><verse number="2" style="v" sid="LUK 12:2" />Kɨhi nɨkipihilwe kikupihʉʉlwa, ang’wi nɨkɨpihilwe kɨkʉikwa mʉyelʉ pee. <verse eid="LUK 12:2" /><verse number="3" style="v" sid="LUK 12:3" />Nɨmʉkɨtambʉe mʉkiti, kɨkʉkumʉka mʉyelʉ, niki nɨmipwepwee mʉakʉtwɨ anyu mʉkɨanda kʉnʉ lʉjɨ lʉlugaɨwe, kɨkitʉntwa kitembe.<verse eid="LUK 12:3" /></para>
  <para style="s">Nʉtakɨwe kogopwa</para>
  <para style="r">
    <ref loc="MAT 10:28-31">Matayo 10:28-31</ref></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4" />“Kʉmʉtambʉɨla ʉnyenye nɨmɨahʉmba ɨane. Leki kʉaogopi awo nɨɨbʉlaga ʉmʉɨlɨ, anga abʉlage ɨleng’waa kitʉma kɨntʉ kɨhi. <verse eid="LUK 12:4" /><verse number="5" style="v" sid="LUK 12:5" />Ingɨ kʉmʉlagɨɨla ʉyʉ nʉtakɨwe kogopwa. Mogopi ʉyo nɨɨza anga wakondye kʉʉbʉlaga ʉmʉɨlɨ, ʉhumile kʉʉgʉmɨla mʉmoto nɨshanga wɨlima mahikʉ ɨhi, kʉlʉ kʉʉlʉ kʉmʉɨla mogopi yʉyo.<verse eid="LUK 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 12:6" />Mʉlingɨle kɨna nsologwe itaano igʉligwa kʉ ʉgʉli ʉniino nangaluu? Ingɨ Itunda shanga ʉkʉmiwa ganɨng’wɨ ao. <verse eid="LUK 12:6" /><verse number="7" style="v" sid="LUK 12:7" />Leki kogopi, ʉnyenye mʉkete nsailo kʉkɨla insologwe. Ga ninsingɨ niamʉmatwe anyu iaigwe.<verse eid="LUK 12:7" /></para>
  <para style="s">Kʉmʉtanantya nʉkʉmʉhita Ʉkilisito</para>
  <para style="r">
    <ref loc="MAT 10:32-33">Matayo 10:32-33</ref>; <ref loc="MAT 12:32">12:32</ref>; <ref loc="MAT 10:19-20">10:19-20</ref></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8" />“Kʉmʉtambʉɨla kɨna, wɨhi nʉkʉtanantya ntongeela aantʉ kɨna nʉanso ʉkolɨ palʉng’wɨ nʉ nene, nʉ Ng’waa Mʉntʉ ʉkʉmʉtanantya kɨna ʉkolɨ palʉng’wɨ nʉnene ntongeela aitʉmi akigʉlʉ nɨang’wi Itunda. <verse eid="LUK 12:8" /><verse number="9" style="v" sid="LUK 12:9" />Ingɨ mʉntʉ wɨhi nʉkʉnihita ntongeela aantʉ, nʉ Ng’waa Mʉntʉ ʉkʉmʉhita ntongeela aitʉmi akilunde nɨang’wi Itunda.<verse eid="LUK 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 12:10" />“Mʉntʉ wɨhi nʉɨmʉtambʉla ibɨ nimbɨ ʉ Ng’waa Mʉntʉ ʉkʉlekelwa, nʉ kʉmʉkunka ʉ Ng’wahʉ wang’wi Itunda shanga ʉkʉlekelwa.<verse eid="LUK 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 12:11" />“Hangɨ anga amʉtwale mʉnyʉmba niakʉtankanɨla Ayahudi nʉkʉmʉsemela kʉatongeeli nɨatemi, leki kikolyi nɨkakʉsʉkɨɨlya. <verse eid="LUK 12:11" /><verse number="12" style="v" sid="LUK 12:12" />Kʉnsoko matungo nanso Ng’wahʉ wang’wi Itunda ʉkʉmʉmanyisa ɨko nɨmʉtakɨwe kʉtambʉla.”<verse eid="LUK 12:12" /></para>
  <para style="s">Mpyani amʉgolɨ mʉmʉpʉngʉ</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13" />Mʉntʉ ʉng’wɨ miumbɨ nɨla antʉ akamʉtambʉɨla ʉ Yesʉ, “Mʉmanyisi mʉɨle ʉ heu wane komolane isalo.”<verse eid="LUK 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 12:14" />Yesʉ akamʉsʉkɨɨlya, “Mʉhʉmbamɨane, nyenyu nʉmbɨkile ʉnene ntule nɨmʉsali wanyu?” <verse eid="LUK 12:14" /><verse number="15" style="v" sid="LUK 12:15" />Sʉnga ʉ Yesʉ akaatambʉɨla antʉ nɨanso, “Hʉgʉki nʉʉimani, kʉnsoko ʉʉpanga wamʉntʉ ʉmʉtilɨ mʉʉgolɨ nʉkete.”<verse eid="LUK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16" />Sʉnga Yesʉ akaapa mpyani ɨyɨ, “Aɨʉkolɨ mʉgolɨ ʉng’wɨ, mʉgʉnda wakwe aɨʉkindile nangaluu. <verse eid="LUK 12:16" /><verse number="17" style="v" sid="LUK 12:17" />Ʉʉgwa mʉgolɨ ʉyʉ akatula sɨnganɨɨlya mʉnkolo akwe, ‘Ntendeʉlɨ kanɨmʉgila ʉɨko nʉandya yane nɨmpʉe? <verse eid="LUK 12:17" /><verse number="18" style="v" sid="LUK 12:18" />Sʉnga akalʉnga kʉtenda itɨ, ‘kʉtaʉla imasalanka ane ɨhi ntume isalanka lɨng’wɨ nikʉlʉ kʉkɨla aya, nkitɨle indya yane yɨhi mʉng’wanso ninsao yane yɨhi. <verse eid="LUK 12:18" /><verse number="19" style="v" sid="LUK 12:19" />Sʉnga akitambʉɨla mʉnkolo akwe, nkolo ane itungo ɨlɨ nkete nsao yɨdʉ ninza nɨnsʉmbilye kʉmyaka ɨdʉ. Itungo ɨlɨ supya ʉlye ʉng’we hangɨ wiloeelye.’ <verse eid="LUK 12:19" /><verse number="20" style="v" sid="LUK 12:20" />Ingɨ Itunda akamʉtambʉɨla, ‘Ʉewe wɨmʉpʉngʉ, ʉtikʉ walelo ʉkʉsha. Ɨmaintʉ ɨhi nʉsʉmbilye akʉtula ang’wa nyenyu?”’<verse eid="LUK 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 12:21" />Yesʉ akamalɨnkɨɨlya wazelʉnga, “Iti ʉʉ yɨlɨ kʉmʉntʉ nʉisʉmbyaa insao kʉnsoko akwe ʉng’wenso, ingɨ agila kɨntʉ nɨ kansaɨlo kʉng’wi Itunda.”<verse eid="LUK 12:21" /></para>
  <para style="s">Kʉmʉsania Itunda</para>
  <para style="r">
    <ref loc="MAT 6:25-34">Matayo 6:25-34</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22" />Sʉnga ʉ Yesʉ akaatambʉɨla amanyisigwa akwe, “Kʉlʉlo leki kiaji kʉnsoko alikalo lanyu kɨna mʉkʉlya ntʉni, ang’wi kʉ mɨɨlɨ anyu kɨna mʉkʉtugala ntʉni. <verse eid="LUK 12:22" /><verse number="23" style="v" sid="LUK 12:23" />Kʉnsoko bahu ʉpanga kʉkɨla indya, hangɨ bahu mʉɨlɨ kʉkɨla ingʉo. <verse eid="LUK 12:23" /><verse number="24" style="v" sid="LUK 12:24" />Gozi inkʉngʉlʉ, shanga yɨtemela ang’wi kʉogola, ngila anga isalanka ang’wɨ ʉɨko wɨhi nʉwandya, ingɨ Itunda wɨilɨsa. Ʉnyenye mɨbahu ikʉlʉ kʉkɨla inyunyi nɨanso. <verse eid="LUK 12:24" /><verse number="25" style="v" sid="LUK 12:25" />Nyenyu mʉng’waanyu nʉhumile kiaja wiongeelye ʉlikalo lakwe ki saa lɨng’wɨ du? <verse eid="LUK 12:25" /><verse number="26" style="v" sid="LUK 12:26" />Kʉnsoko mʉlemilwe kitʉma ikani ɨlɨ niniino, nɨkɨgwa mʉkiaja kitʉma makani nɨmangɨɨza? <verse eid="LUK 12:26" /><verse number="27" style="v" sid="LUK 12:27" />Gozi mpʉmbʉʉlʉ nɨkʉla, shanga itʉma ang’wɨ kʉtuma ngʉo. Ingɨ kʉmʉtambʉɨla, Mʉtemi Solomoni palʉng’wɨ nʉgolɨ nʉkʉtugala ngʉo maza ikɨlo, shanga aɨʉtugaigwe iza anga mpʉmbʉʉlʉ nɨanso. <verse eid="LUK 12:27" /><verse number="28" style="v" sid="LUK 12:28" />Anga ɨze Itunda wɨmatugalya iza impʉmbʉʉlʉ namʉmɨgʉnda nɨɨza lelo akolɨ mʉdaʉ akʉmagʉmɨlwa mʉmoto, itɨɨ, shanga ʉkʉmʉtendeela ʉza ʉnyenye kʉkɨla nanso? Ʉnyenye nimʉkete ʉhʉɨɨlɨ ʉniino.<verse eid="LUK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 12:29" />Leki kiaji kɨna mʉkʉlya ntʉni ang’wi mʉkʉng’wa ntʉni. Leki kagɨɨli makani nanso. <verse eid="LUK 12:29" /><verse number="30" style="v" sid="LUK 12:30" />Kʉnsoko ɨantʉ nɨshanga amʉhʉɨɨe Itunda agigwa nɨmakani nanso. Ingɨ ʉ Tata wanyu nʉa kigʉlʉ ʉlɨngile kɨna mʉmatakile ɨmakani nanso. <verse eid="LUK 12:30" /><verse number="31" style="v" sid="LUK 12:31" />Ingɨ ʉdumi hanza ʉtemi wang’wi Itunda, nɨ maintʉ aya itɨga mʉkʉpegwa.”<verse eid="LUK 12:31" /></para>
  <para style="s">Kiɨkɨlya ʉgolɨ kigʉlʉ</para>
  <para style="r">
    <ref loc="MAT 6:19-21">Matayo 6:19-21</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 12:32" />“Leki kogopi ʉnyenye nɨmɨasheenyʉ, kʉnsoko Ʉtata wanyu ʉsɨgɨɨe kʉmʉpeza Ʉtemi wakwe. <verse eid="LUK 12:32" /><verse number="33" style="v" sid="LUK 12:33" />Gʉlyi insao yanyu impia nɨmʉkʉlija mʉape ɨaʉla. Tumi imbogoshi ya kuɨkɨɨla mpia nɨshanga yikʉlʉpaala, mʉɨke ɨkɨʉto nɨshanga kɨkepaa kilunde. Kʉng’wanso shanga kɨkiwa, ang’wi kʉgazangɨgwa nʉmʉpwa. <verse eid="LUK 12:33" /><verse number="34" style="v" sid="LUK 12:34" />Kʉnsoko mʉkɨmolɨ ɨkɨʉto kako, papo nɨnkolo ako ikʉtula ɨmolɨ.<verse eid="LUK 12:34" /></para>
  <para style="s">Anyamɨlɨmo kʉtula akendegeeli</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35" />Ɨze mihambile kitʉma ɨmɨlɨmo, nimʉli yanyu ɨze yeilye. <verse eid="LUK 12:35" /><verse number="36" style="v" sid="LUK 12:36" />Anga anyamɨlɨmo nɨamʉlindɨɨe ʉmʉkʉlʉ wao nʉkʉtulya kʉpuma kʉwɨnga, anga watulye nʉkʉpɨndʉla ahume kʉkaya kʉmʉlugʉɨla. <verse eid="LUK 12:36" /><verse number="37" style="v" sid="LUK 12:37" />Anyamɨlɨmo awo akʉlowa ʉmʉkʉlʉ anga waahange amʉlindɨɨe. Kʉlʉ kʉʉlʉ kʉmʉtambʉɨla, ʉkitunga ngʉo aanyamʉlɨmo ʉkʉaɨla ikii pihɨ nʉnene kʉmʉlɨsa. <verse eid="LUK 12:37" /><verse number="38" style="v" sid="LUK 12:38" />Anyamɨlɨmo awo akʉlowa mʉkʉlʉ wao nʉkʉahanga ihambile kʉmʉsɨngɨɨlya, palʉng’wi kɨna ʉtulye ʉtikʉ wigengʉ ang’wi dau maniambwa. <verse eid="LUK 12:38" /><verse number="39" style="v" sid="LUK 12:39" />Mʉlɨnge kɨna, angaɨze mʉkola nyʉmba ʉlɨngile matungo ʉmii nʉkingɨla nʉkʉmiɨla shanga ʉkʉlala ʉtikʉga, hangɨ shanga ʉkʉmileka nyʉmba akwe wiɨlwe. <verse eid="LUK 12:39" /><verse number="40" style="v" sid="LUK 12:40" />Nʉnyenye ga ihambi, kʉnsoko Ng’waa Mʉntʉ ʉzile itungo nɨshanga mihambile.”<verse eid="LUK 12:40" /></para>
  <para style="s">Mitʉmi nɨ mʉhʉɨɨli</para>
  <para style="r">
    <ref loc="MAT 24:45-51">Matayo 24:45-51</ref></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41" />Petelo akamʉkolya, “Isekʉlʉ, mpyani nanso ʉkʉʉtambʉɨla ʉsese duune, ang’wɨ antʉ ɨhi?”<verse eid="LUK 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 12:42" />Isekʉlʉ akamʉsʉkɨɨlya, “Nyenyu nɨ mitʉmi nɨ mʉhʉɨɨli hangɨ nɨ mʉnyamahala, nʉ mʉkʉlʉ wakwe ʉkʉmʉɨka wɨmɨɨle ɨnyʉmba akwe nʉkʉapa indya yao kʉ matungo akwe? <verse eid="LUK 12:42" /><verse number="43" style="v" sid="LUK 12:43" />Yʉkʉtula ilʉmbi kʉ mitʉmi nʉanso nʉmʉkʉlʉ wakwe ʉkʉtulya wamʉhange ʉkʉtenda ʉʉ. <verse eid="LUK 12:43" /><verse number="44" style="v" sid="LUK 12:44" />Kʉmʉtambʉɨla kʉlʉ kʉʉlʉ mʉkʉlʉ wakwe ʉkʉmʉɨka ʉmitʉmi nʉanso wɨmɨɨli mʉnsao yakwe yɨhi. <verse eid="LUK 12:44" /><verse number="45" style="v" sid="LUK 12:45" />Ingɨ mitʉmi nʉanso anga wasɨgɨɨle mʉnkolo, Mʉkʉlʉ wane watinia kʉtulya, wandye kʉakʉa itʉmi aʉya, nɨakɨgoha nawa nɨakɨsʉngʉ, kʉnʉ wazelya nʉkʉng’wa nʉkʉgala, <verse eid="LUK 12:45" /><verse number="46" style="v" sid="LUK 12:46" />ingɨ mʉkʉlʉ wakwe ʉkʉtulya lʉhikʉ nɨshanga ʉsɨgile nɨmatungo nɨshanga ʉine. Mʉkʉlʉ nʉanso ʉkʉmʉpɨsɨɨlya ikʉlʉ, nʉkʉmʉɨka palʉng’wɨ nɨ antʉ nɨabɨ.<verse eid="LUK 12:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 12:47" />Mitʉmi ʉyʉ nʉlɨngile mʉkʉlʉ wakwe wɨlowaa watendeʉli nʉyo ingɨ nʉanso wahite kʉtenda anga nʉloilwe, ʉkʉpɨsɨɨligwa ikʉlʉ. <verse eid="LUK 12:47" /><verse number="48" style="v" sid="LUK 12:48" />Ingɨ mʉntʉ wɨhi nɨshanga ʉlɨngile natakɨwe kitʉng’wa, witʉme makani aʉpɨsɨɨlya, ʉkʉpɨsɨɨligwa iniino. Mʉntʉ wɨhi nʉilihilwe intʉ yɨdʉ ʉkʉdaigwa yɨdʉ, nʉyʉ nʉpewe wɨmɨɨli nʉ mʉntʉ mʉngɨɨza ʉkʉkoligwa nanguluu.<verse eid="LUK 12:48" /></para>
  <para style="s">Yesʉ ʉkʉleta ʉtemanʉki</para>
  <para style="r">
    <ref loc="MAT 10:34-36">Matayo 10:34-36</ref></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49" />“Nzile akɨlya moto mihɨɨ, ndoilwe ɨze wandyaa kakɨla. <verse eid="LUK 12:49" /><verse number="50" style="v" sid="LUK 12:50" />Nkete lwago lʉbɨ nɨtakiwe kagigwa, kʉnyomeka ikʉlʉ kʉpikɨɨla nʉlʉkʉkondanɨɨla. <verse eid="LUK 12:50" /><verse number="51" style="v" sid="LUK 12:51" />Leki kʉsɨgi ndetile ʉlowa mihɨɨ? Kʉmʉtambʉɨla shanga ʉʉ, ndetile ʉtemanʉki. <verse eid="LUK 12:51" /><verse number="52" style="v" sid="LUK 12:52" />Kʉpumɨɨla itungo ɨlɨ, mʉnyʉmba ɨng’wɨ akʉtula akolɨ antʉ ataano nɨshanga akilɨnga kʉnsoko ane, nɨataatʉ akʉtemanʉka nawa nɨabɨɨlɨ ang’wi nɨabɨɨlɨ akʉtemanʉka nawa nɨataatʉ. <verse eid="LUK 12:52" /><verse number="53" style="v" sid="LUK 12:53" />Ihe akʉtemanʉka nʉng’waakwe, ng’wana akʉtemanʉka nihe, ʉnyinya akʉtemanʉka nʉmʉnanso wakwe, nʉmʉnanso akʉtemanʉka nʉnyinya, mʉkwingwa akʉtemanʉka nʉmʉkʉmʉlɨma, mʉkʉmʉlɨma akʉtemanʉka nʉmʉkwɨng’wakwe.”<verse eid="LUK 12:53" /></para>
  <para style="s">Kʉlɨnga ɨmatungo</para>
  <para style="r">
    <ref loc="MAT 16:2-3">Matayo 16:2-3</ref></para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54" />Akaatambʉɨla ʉmilʉndo nʉa antʉ, “Anga mʉone imalunde akilingɨila ipande lang’weli, itungo ʉdu mɨlʉngaa ‘mbula akakʉa, nɨmbula ɨkʉa ɨtaitaai. <verse eid="LUK 12:54" /><verse number="55" style="v" sid="LUK 12:55" />Anga ng’wega nʉʉkʉkunka kʉpumɨɨla takama, mɨlʉngaa yainaa kɨpasʉ, ʉʉ itulaa, <verse eid="LUK 12:55" /><verse number="56" style="v" sid="LUK 12:56" />Ʉnyenye nɨmɨateele mɨgozaa malunde nihɨɨ mʉhume kʉmalɨnga ɨmatungo, kʉnɨkɨgwa shanga mʉlɨngile ndogoelyo amakani nakigela itungo ɨlɨ?<verse eid="LUK 12:56" /></para>
  <para style="s">Ilɨnge nɨalʉgʉ ako</para>
  <para style="r">
    <ref loc="MAT 5:25-26">Matayo 5:25-26</ref></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57" />“Niki mʉlemilwe kʉlamʉla ʉnyenye kitʉma makani atai? <verse eid="LUK 12:57" /><verse number="58" style="v" sid="LUK 12:58" />Nɨmʉlongoe nʉmʉsemi wako kianza, gema kilɨnga nʉng’wenso nɨmʉkolɨ mʉnzɨla. Waleke kʉʉpikɨɨlya kʉ mʉlamʉli, nʉmʉlamʉli ʉkʉinkɨɨlya kʉmʉmboi, nʉmʉmboi ʉkʉʉlʉgaɨla mʉkadulumu. <verse eid="LUK 12:58" /><verse number="59" style="v" sid="LUK 12:59" />Kʉlʉ kʉʉlʉ kʉʉɨla shʉʉkʉpuma mʉkadulumu, kʉpikɨɨla nʉʉzɨɨzamala kʉsʉsha impia yɨhi.”<verse eid="LUK 12:59" /></para>
  <chapter eid="LUK 12" />
  <chapter number="13" style="c" sid="LUK 13" />
  <para style="s">Kʉtambʉla nʉ kʉleka mɨlandʉ</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1" />Itungo lɨlo lɨɨlo antʉ aɨamʉtambʉɨe ʉ Yesʉ nkani niya antʉ kʉpuma kʉ Galilaya ʉ Pilato naɨʉlagɨɨye abʉlagwe ɨsakami ao ɨhangɨgwe nɨmɨtugo nɨpumigwe kʉnsoko ipolyo. <verse eid="LUK 13:1" /><verse number="2" style="v" sid="LUK 13:2" />Yesʉ akaakolya, “Mʉsɨgile kɨna antʉ kʉpuma kʉ Galilaya aɨagazilye kʉkɨla antʉ akʉ Galilaya kʉnsoko aɨabʉlagilwe itɨ. <verse eid="LUK 13:2" /><verse number="3" style="v" sid="LUK 13:3" />Kʉmʉtambʉɨla kʉlʉ kʉʉlʉ shanga ʉʉ, nʉnyenyega anga mʉhite kɨla itʉnʉ mʉkʉlimansɨɨligwa anga wawo. <verse eid="LUK 13:3" /><verse number="4" style="v" sid="LUK 13:4" />Ang’wi antʉ awo ikʉmi na mʉnana naɨakule akaze agwɨɨwe nɨkɨlɨngasɨɨlyo ʉko kʉ Siloamu, akasha, mʉsɨgile kɨna nɨanso aɨanyamɨlandʉ kʉkɨla ɨaʉaya ɨhi naɨishiɨ kʉ Yelusalemu? <verse eid="LUK 13:4" /><verse number="5" style="v" sid="LUK 13:5" />Kʉmʉtambʉila shanga ʉʉ, ingɨ ʉnyenye anga mʉhite kɨla itʉnʉ, mʉkʉsha anga ɨenso.”<verse eid="LUK 13:5" /></para>
  <para style="s">Mpyani mʉtɨ nʉa mʉtini nɨshanga wɨpaa nkali</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6" />Sʉnga Yesʉ akaatambʉɨla mpyani ɨyɨ, “Mʉntʉ ʉng’wɨ aɨʉkete mʉtɨ nʉampyani amʉtini mʉmʉgʉnda wakwe nʉa mʉzabibʉ. Mʉntʉ ʉyʉ akalongola waze ʉsʉmbɨɨye wakale nkali yakwe, akahanga shanga ʉpee nkali kanɨyɨ nɨng’wɨ. <verse eid="LUK 13:6" /><verse number="7" style="v" sid="LUK 13:7" />Ingɨ akamʉɨla mʉlila mʉgʉnda nʉa mɨzabibʉ wakwe, ‘Goza, kʉmyaka ɨtaatʉ nɨpembya nkale nkalɨ mʉmʉtini ʉwʉ, shanga nɨlɨja kanɨyɨ nɨng’wɨ. Ʉteme ʉgwe. Nɨkɨ ʉlimɨlye ɨmboto amʉgʉnda wane?’ <verse eid="LUK 13:7" /><verse number="8" style="v" sid="LUK 13:8" />Mitʉmi akamʉsʉkɨɨlya, ‘Mʉkʉlʉ wane siʉleke hangɨ nʉng’waka ʉwʉ, nʉʉgɨngɨɨle nʉkʉɨkɨla ʉtinko. <verse eid="LUK 13:8" /><verse number="9" style="v" sid="LUK 13:9" />Kʉng’waka anga ʉpee, iza tai, anga ʉhite kʉpa ʉʉteme”’<verse eid="LUK 13:9" /></para>
  <para style="s">Yesʉ ʉkʉmʉponia mʉsʉngʉ Lʉhikʉ nʉla Kʉsupya</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10" />Lʉhikʉ lʉng’wɨ nʉla kʉsupya Yesʉ aɨʉkʉmanyisa mʉnyʉmba akʉtankanɨla Ayahudi. <verse eid="LUK 13:10" /><verse number="11" style="v" sid="LUK 13:11" />Mʉnyʉmba nanso aɨʉkolɨ mʉsʉngʉ ʉng’wɨ wɨkaɨwe ahɨng’wɨ itungo lamyaka ikʉmi namʉnana, nʉmʉgongo wakwega aɨwigubile akʉleng’wa kimɨka. <verse eid="LUK 13:11" /><verse number="12" style="v" sid="LUK 13:12" />Yesʉ naɨwamʉona, akamitanga, akamʉtambʉɨla, “Mʉsʉngʉ waponyigwa watungʉɨlwa mʉʉlema wako.” <verse eid="LUK 13:12" /><verse number="13" style="v" sid="LUK 13:13" />Yesʉ akamʉɨkɨɨlya mɨkono migʉlya akwe, pumpulungu akimɨka akatula kʉmʉkʉlya Itunda.<verse eid="LUK 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 13:14" />Ingɨ mʉkʉlʉ nʉa nyʉmba akʉtankanɨla Ayahudi aɨʉtakile kʉnsoko ʉ Yesʉ wamʉponya umʉsʉngʉ ʉyʉ mu Lʉhikʉ nʉla Kʉsupya. Kʉlʉlo umʉkʉlʉ nʉa nyumba akʉtankanɨla Ayahudi akaatambʉɨla awa naɨ ilundile pang’wanso. “Mʉkete mahikʉ mʉtandatʉ niakitʉma imɨlɨmo. Itɨgwa, mʉmahikʉ nanso mʉze mʉaponye alwae anyu, shanga mʉ Lʉhikʉ nʉla Kʉsupya.”<verse eid="LUK 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 13:15" />Papo gwa ʉ Yesʉ akamʉsʉkɨɨlya, “Ʉnyenye ateele. Nyenyu mʉng’wanyu nɨshanga ʉkʉkonkola mɨtugo walongole kʉng’wensa mʉlʉhikʉ nʉla kʉsupya? <verse eid="LUK 13:15" /><verse number="16" style="v" sid="LUK 13:16" />Nʉ mʉsʉngʉ uyu nʉiele lang’wa Ibulahimu, nʉikaiwe nʉhɨng’wɨ kʉmyaka ikʉmi na mʉnana. Itɨɨ, shanga itakɨwe watungʉɨlwe mʉlʉhikʉ nʉla kʉsupya?” <verse eid="LUK 13:16" /><verse number="17" style="v" sid="LUK 13:17" />Naiwatambʉla itɨ, alʉngʉ akwe ɨhi akahʉng’wa mɨnyala, ingɨ antʉ aʉya ɨhi akalowa kʉnsoko makani aʉkʉɨlwa ɨhi naitʉmɨle.<verse eid="LUK 13:17" /></para>
  <para style="s">Mpyani ambeʉ ninyɨgɨnyɨgɨ namʉtɨ nʉwitangwa mʉhaladali</para>
  <para style="r">
    <ref loc="MAT 13:31-32">Matayo 13:31-32</ref>; <ref loc="MRK 4:30-32">Maliko 4:30-32</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18" />Sʉnga ʉ Yesʉ akakolya, “Itɨɨ, ʉtemi wang’wi Itunda wimpyani nɨntʉni? Itɨɨ, nʉimpyanie nintʉni? <verse eid="LUK 13:18" /><verse number="19" style="v" sid="LUK 13:19" />Ʉkolɨ anga mbeʉ ninyɨgɨnyɨgɨ namʉtɨ nʉwitangwa mʉhaladali nɨɨza mʉntʉ ʉng’wɨ naɨʉmɨhoile akamɨtemela mʉmʉgʉnda wakwe, ɨkahelʉka ɨkakʉtula nʉkʉtula mʉti ʉkʉlʉ. Nyʉnyi itumaa iʉyɨ mʉntambi yakwe.”<verse eid="LUK 13:19" /></para>
  <para style="s">Mpyani aigaɨ</para>
  <para style="r">
    <ref loc="MAT 13:33">Matayo 13:33</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20" />Yesʉ akaakolya hangɨ, “Ʉtemi wang’wi Itunda nʉimpyanie nɨntʉni? <verse eid="LUK 13:20" /><verse number="21" style="v" sid="LUK 13:21" />Ʉkolɨ anga igaɨ isheenyʉ mʉsʉngʉ nʉhoile wagahɨɨlye mʉutu madebe ataatʉ, sʉnga utu wɨhi wɨlʉla.”<verse eid="LUK 13:21" /></para>
  <para style="s">Mʉlango nʉʉpinyɨ</para>
  <para style="r">
    <ref loc="MAT 7:13-14">Matayo 7:13-14</ref>; <ref loc="MAT 21:23">21:23</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22" />Sʉnga ʉ Yesʉ akalongoleka nʉmʉhɨnzo wakwe kʉlongola kʉ Yelusalemu, mʉmʉhɨnzo akazekɨɨla mʉisalɨ niikʉlʉ niisalɨ niinino, wazetanantya lʉkani lang’wi Itunda. <verse eid="LUK 13:22" /><verse number="23" style="v" sid="LUK 13:23" />Mʉntʉ ʉng’wɨ akamʉkolya, “Mʉmanyisi itɨɨ, ɨantʉ nɨakʉgunɨka asheenyʉne?” <verse eid="LUK 13:23" /><verse number="24" style="v" sid="LUK 13:24" />Yesʉ akaatambʉɨla, “Kagupi mingɨle kʉkɨɨla mʉlango nʉʉpinyɨ, kʉnsoko kʉmʉtambʉɨla ɨkʉlʉ kʉʉlʉ, antʉ ɨdʉ akʉgema kingɨla ingɨ akʉleng’wa. <verse eid="LUK 13:24" /><verse number="25" style="v" sid="LUK 13:25" />Itungo lɨpembilye ʉmʉkola nyʉmba ʉkʉʉka nʉkʉlugaɨla ʉmʉlango, ʉnyenye mʉkimɨka kʉnzi nʉkandya kʉpɨndʉla mʉzelʉnga, ‘Isekʉlʉ kʉlugʉɨle ʉmʉlango, nʉanso ingɨ ʉkamʉsʉkɨɨlya, ‘Shanga nʉmʉmanyile, shanga nɨngile ʉko nɨmʉpembeeye.’ <verse eid="LUK 13:25" /><verse number="26" style="v" sid="LUK 13:26" />Nʉnyenye mʉkʉtula mʉtambʉɨla, ‘Ʉsese kɨantʉ awo naɨkʉlɨzanilye nʉkʉng’wezania nʉewe, hangɨ aɨʉmanyisilye mʉmagalagalo itʉ.’ <verse eid="LUK 13:26" /><verse number="27" style="v" sid="LUK 13:27" />Ingɨ nʉanso ʉkasʉkɨɨlya, ‘shanga nɨngile ʉnyenye kʉmʉpembeeye, hegi pang’waane ʉnyenye mɨhi mɨitʉma mɨlandʉ.’ <verse eid="LUK 13:27" /><verse number="28" style="v" sid="LUK 13:28" />Papo yɨkʉtula kɨlɨlo nʉkʉkelya imino, nɨmɨkamʉona ʉ Ibulahimu nʉ Isaki nʉ Yakobo nɨamanga ang’wi Itunda ɨhi azeamolɨ mʉʉtemi wangwi Itunda, Ingɨ ʉnyenye mʉkʉgʉng’wa kʉnzi. <verse eid="LUK 13:28" /><verse number="29" style="v" sid="LUK 13:29" />Antʉ azile kʉpuma kilya ni ng’weli, aʉya kʉpuma hukuma nɨ takama akikiɨ palyoma lao nʉkʉhangɨla iloeelya ni Itunda ʉkʉatema. <verse eid="LUK 13:29" /><verse number="30" style="v" sid="LUK 13:30" />Akolɨ antʉ nɨakumʉkile nɨakʉkepigwa, nawa niakepigwe nɨakʉkumʉkigwa.”<verse eid="LUK 13:30" /></para>
  <para style="s">Yesʉ ʉkʉʉlɨɨla antʉ akʉ Yelusalemu</para>
  <para style="r">
    <ref loc="MAT 23:37-39">Matayo 23:37-39</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31" />Matungo yayo yaayo Palisayo ang’wɨ akamʉhanga ʉ Yesʉ akamʉtambʉɨla, “Hega apa ʉlongole kɨsalɨ kɨngɨɨza, kʉnsoko ʉ Helode ʉkʉloma kʉʉbʉlaga.”<verse eid="LUK 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 13:32" />Yesʉ akaasʉkɨɨlya, “Longoli mʉmʉɨle mʉlʉla nʉanso kɨna ‘Lelo nʉmʉdaʉ kʉahegelya antʉ ahɨng’wɨ, nʉlʉhikʉ nʉla kataatʉ kʉkondeelya isɨgo lane.’ <verse eid="LUK 13:32" /><verse number="33" style="v" sid="LUK 13:33" />Nɨitɨga lelo nʉmʉdaʉ nɨpashaʉla ntakɨwe nongoleke nʉmʉhɨnzo wane, kʉnsoko kʉtilɨ mʉmanga nʉhumilwe kʉshɨlaa kʉnzi a kʉsalɨ ka Yelusalemu!<verse eid="LUK 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34" />“Ʉewe Yelusalemu! Ʉewe Yelusalemu! Wɨabʉlaga amanga ang’wi Itunda nɨalagɨɨgwe kʉng’waako kʉakʉa magwe. Nkʉa inga nagemile kʉmilingɨɨla palʉng’wɨ nihume kumusunja anga nkuku nisunjaa ianaakwe mumanana, ingɨ ʉewe shanga ʉloilwe. <verse eid="LUK 13:34" /><verse number="35" style="v" sid="LUK 13:35" />Goza imatolanyu akʉlekwa ize ngila anga antʉ, itɨgwa kʉmʉtambʉɨla, shanga mɨkamona hangɨ kʉpikɨɨla itungo nɨmɨkalʉnga. ‘Ʉkembetilwe ʉyʉ nʉpembilye kʉlina lang’wi Isekʉlʉ”’<verse eid="LUK 13:35" /></para>
  <chapter eid="LUK 13" />
  <chapter number="14" style="c" sid="LUK 14" />
  <para style="s">Yesʉ ʉkʉmʉponya mʉntʉ nʉimbile mʉɨlɨ wɨhi</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1" />Lʉhikʉ lʉng’wɨ nʉla kʉsupya Yesʉ naɨ wanilwe wendelya ndya mʉnyʉmba mʉtongeeli ʉng’wɨ nʉa Apalisayo, antʉ aɨ atungɨe amʉone ʉkʉtendaʉli. <verse eid="LUK 14:1" /><verse number="2" style="v" sid="LUK 14:2" />Pantongeela akwe aɨ ʉkolɨ mʉntʉ nʉkete ndwala akʉimba mʉɨlɨ wakwe wɨhi. <verse eid="LUK 14:2" /><verse number="3" style="v" sid="LUK 14:3" />Yesʉ akaakolya amanyisi amalagɨɨlyo nɨa Palisayo, “Itɨɨ, igombigwene kʉponya mʉlʉhikʉ nʉla kʉsupya, ang’wɨ shanga igombigwe?”<verse eid="LUK 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 14:4" />Ingɨ nɨanso ɨhi akakɨlaja ihɨtwɨ. Kʉlʉlo ʉ Yesʉ akamʉamba ʉmʉlwae nʉanso akamʉponya, akamʉɨla walongole kitolakwe. <verse eid="LUK 14:4" /><verse number="5" style="v" sid="LUK 14:5" />Sʉnga akaakolya, “Nyenyu mʉng’wanyu anga ʉng’waakwe ang’wi mʉtugo wakwe ʉgwɨle mikombo Lʉhikʉ nʉla Kʉsupya, shanga ʉkʉkaya kʉmʉpumya mʉ Lʉhikʉ nʉla Kʉsupya?”<verse eid="LUK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 14:6" />Akaleng’wa kʉmʉsʉkɨɨlya ikolyo nɨlanso.<verse eid="LUK 14:6" /></para>
  <para style="s">Kininompya nʉ kikʉlya</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7" />Yesʉ naɨ waaona antʉ naɨ anilwe akiaja kʉduma matuntu akʉntongeela ikiɨ matungo akʉlya, akaapumɨlya mpyani ɨyɨ,<verse eid="LUK 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 14:8" />“Anga mʉntʉ wakane mʉwɨnga, leka kitanguzɨɨlya kikaɨla ituntu nɨla ʉkʉligwa, angaitye wanilwe mʉkʉlʉ mʉngɨɨza kʉkɨla ʉewe. <verse eid="LUK 14:8" /><verse number="9" style="v" sid="LUK 14:9" />Anga ʉtende itɨ ʉyʉ nʉmanile ʉnyenye nɨ mɨabɨɨlɨ wɨkapembya wakʉɨle. ‘Mʉlekele ʉyʉ ituntu nɨlanso.’ Papogwa ʉkihumya mɨnyala paantʉ ɨhi, ʉkʉlongola wikiɨ kʉ matuntu nɨshanga aakʉlʉ. <verse eid="LUK 14:9" /><verse number="10" style="v" sid="LUK 14:10" />Ingɨ nʉʉkʉpembya ʉyʉ nʉkanile, wakʉɨle, ‘Mʉhʉmba mɨane pembya kʉnʉ wikiɨ mituntu nɨla ʉkʉlʉ.’ Papo gwa ʉkʉtula wakʉligwaa ntongeela aantʉ ɨhi nɨakʉgozee. <verse eid="LUK 14:10" /><verse number="11" style="v" sid="LUK 14:11" />Kʉnsoko nanso, mʉntʉ wɨhi nʉikʉlyaa ʉkʉninopigwa, nʉyʉ nʉininompyaa ʉkʉkʉligwa.”<verse eid="LUK 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12" />Sʉnga Yesʉ akamʉtambʉɨla ʉyʉ nʉanile, “Anga ʉnoneelye iloeelya nɨlandya ng’ʉng’wɨ ang’wi ʉtikʉ, leka kana iahʉmbaɨako ang’wi alunaako ang’wi anyadʉgʉ ako nianyakɨsalɨ ako nɨagolɨ, kʉnsoko anga ʉtende itɨ, nɨenso ahume kʉana kʉmatolao akʉtula akʉsʉkɨɨlya ayo naɨʉatendee. <verse eid="LUK 14:12" /><verse number="13" style="v" sid="LUK 14:13" />Ingɨ anga ʉnoneelye iloeelya, ane aʉla nɨalema nɨakɨtele nɨapoku, <verse eid="LUK 14:13" /><verse number="14" style="v" sid="LUK 14:14" />anga witʉme itɨ ʉkʉkembetwa ni Itunda, kʉnsoko nɨanso agila nɨkakʉʉsʉkɨɨlya ʉewe ʉkʉsʉkɨɨligwa lʉhikʉ nʉla kiʉkigwa ɨantʉ nɨagombekile kʉng’wi Itunda.”<verse eid="LUK 14:14" /></para>
  <para style="s">Mpyani iloeelya nikʉlʉ</para>
  <para style="r">
    <ref loc="MAT 22:1-10">Matayo 22:1-10</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15" />Itɨ gwa naɨwija inkani izi mʉntʉ ʉng’wɨ naɨwikalanilye nʉ Yesʉ akalʉnga, “Ʉkembetilwe mʉntʉ ʉyo nʉʉzɨɨzalya indya miloeelya nɨla Ʉtemi wang’wi Itunda.”<verse eid="LUK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 14:16" />Yesʉ akamʉsʉkɨɨlya, “Mʉntʉ ʉng’wɨ aɨ ʉnonilye iloeelya ikʉlʉ, akana antʉ ɨdʉ ikɨlo. <verse eid="LUK 14:16" /><verse number="17" style="v" sid="LUK 14:17" />Naɨapika matungo akandya iloeelya, akamʉlagɨɨlya ʉmitʉmi wakwe waaɨla awo naɨanilwe, ‘Kɨlanyi maintʉ ɨhi akonda.’ <verse eid="LUK 14:17" /><verse number="18" style="v" sid="LUK 14:18" />Ingɨ awo naɨanilwe akandya kilongola ʉng’wɨ ʉng’wɨ. Nʉa ng’wandyo akamʉile ʉmitʉmi, ‘Ʉnene ngʉile mʉgʉnda, ntakɨwe nende ʉgoza, ndeke nongole.’ <verse eid="LUK 14:18" /><verse number="19" style="v" sid="LUK 14:19" />Nʉmʉya akalʉnga. ‘Ngʉile ng’ombe ikʉmi niyakʉlɨmɨla, itɨ gwa itungo ɨlɨ nongoe kʉigemela, kʉlompa ngombye nongole.’ <verse eid="LUK 14:19" /><verse number="20" style="v" sid="LUK 14:20" />Nʉmʉya akalʉnga, ‘Ntɨnile mʉsʉngʉ mahikʉ yaya, kʉleng’wa kʉpembya.’<verse eid="LUK 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 14:21" />“Mitʉmɨ nʉanso akatʉlya nʉ kʉmʉɨla ʉmʉkola iloeelya nkani nianso. Mʉkola iloeelya akahʉng’wa ikuo, akamʉlagɨɨlya ʉmitʉmi wakwe, ‘Kayanga longola mʉmapanda nʉ mʉminsambwa anzɨla aisalɨ, ʉalete iaula nɨakɨtele nɨalema niapoku.’ <verse eid="LUK 14:21" /><verse number="22" style="v" sid="LUK 14:22" />Itungo ʉdu, ʉmitʉmi nʉanso akamʉɨla ʉmʉkola iloeelya ‘Mʉkʉlʉ wane, makani ɨhi itʉng’waa anga naza ʉlagɨɨye, nɨitɨga lyoma lɨkɨlɨ lɨkolɨ mʉnyʉmba iloeelya.’ <verse eid="LUK 14:22" /><verse number="23" style="v" sid="LUK 14:23" />Mʉkʉlʉ nʉanso akamʉɨla ʉmitʉmi wakwe, ‘Longola mʉmapanda nʉ mʉminsambwa nzɨla mʉisalɨ niino mʉapele ɨatʉ kʉpembya ɨnyʉmbane izʉle. <verse eid="LUK 14:23" /><verse number="24" style="v" sid="LUK 14:24" />Kʉnsoko, kʉmʉɨla, mʉantʉ awo naza anilwe ahita, kʉtilɨ anga mʉntʉ wɨhi nʉkʉlʉlya indya miloeelya lane.”’<verse eid="LUK 14:24" /></para>
  <para style="s">Niitakɨwe kʉtula wimʉmanyisigwa wang’wa Yesʉ</para>
  <para style="r">
    <ref loc="MAT 10:37-38">Matayo 10:37-38</ref></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25" />Antʉ aɨ ɨkʉɨlania nʉ Yesʉ, akaapɨlʉkɨla akaaɨla, <verse eid="LUK 14:25" /><verse number="26" style="v" sid="LUK 14:26" />“Mʉntʉ wɨhi anga walowe kʉtula mʉmanyisigwa wane, ʉtakɨwe wandowe ʉnene kʉkɨla nʉaloilwe ihe nʉnyinya nʉmʉsʉngʉ wakwe nɨana akwe aheʉ akwe nɨaluna akwe nɨakɨsʉngʉ, hangɨ ʉtakɨwe wandowe hanza ʉnene kʉkɨla nʉiloilwe nʉanso. Anga wahite kʉtenda itɨ shanga ʉhumile kʉtula mʉmanyisigwa wane. <verse eid="LUK 14:26" /><verse number="27" style="v" sid="LUK 14:27" />Mʉntʉ wɨhi nɨshanga ʉgombile kagigwa nʉkʉsha nʉtyatile, shanga ʉkʉtula mʉmanyisigwa wane.’<verse eid="LUK 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 14:28" />Kʉnsoko itɨ nyenyu mʉng’waanyu nʉloilwe kʉzenga nyʉmba amatapaali, nɨshanga ʉkikiɨ nʉkʉaɨɨlya ɨmaintʉ wahume kʉlɨnga ʉketene ingulu niakʉkondya ʉlʉzengo? <verse eid="LUK 14:28" /><verse number="29" style="v" sid="LUK 14:29" />Anga ize shangaʉʉ, anga wakondye kʉgʉmɨla imagwe mʉmʉkuɨla, waleng’we kʉkondeelya ɨantʉ akʉmʉheka, <verse eid="LUK 14:29" /><verse number="30" style="v" sid="LUK 14:30" />azelʉnga, ‘aza ʉkidaya kʉzenga, kʉnʉ mʉgila anga lʉgʉlʉ nʉla kʉzenga.’<verse eid="LUK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 14:31" />“Ntambʉle mpyani ngɨza, ‘anga itule ʉkolɨ mʉtemi ʉtakile kenda kikʉa nʉ mʉtemi mʉngɨɨza, itɨɨ, shanga ʉkikiɨ hanza nʉkʉsɨganɨɨlya anga ɨze ʉkʉhuma, nʉanso nɨanyambita akwe magana anzogu ikʉmi lɨng’wɨ ʉkʉhuma kikʉa nʉ mʉtemi nʉkete anyambita magana anzogu makʉmi abɨɨlɨ? <verse eid="LUK 14:31" /><verse number="32" style="v" sid="LUK 14:32" />Anga waone shanga ʉkʉhuma, ʉkʉlagɨɨlya amalʉme akwe aze akɨlɨ akolɨ kʉlɨ ende alompe igombye. <verse eid="LUK 14:32" /><verse number="33" style="v" sid="LUK 14:33" />Iti ʉʉ, Yesʉ akalʉnga, “kʉtilɨ ga nʉng’wi mʉng’waanyu nʉʉkʉtula mʉmanyisigwa wane anga wahite kʉhʉlya maintʉ ɨhi nʉmakete.’<verse eid="LUK 14:33" /></para>
  <para style="s">Mʉnyu nɨshanga wɨkoela</para>
  <para style="r">
    <ref loc="MAT 5:13">Matayo 5:13</ref>; <ref loc="MRK 9:50">Maliko 9:50</ref></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34" />“Mʉnyʉ ingɨ ʉza, anga ʉpele kʉkoela, ʉkʉlʉngɨlwa ntʉni ʉkoele? <verse eid="LUK 14:34" /><verse number="35" style="v" sid="LUK 14:35" />Mʉnyʉ nʉanso shanga ʉtakɨwe kʉɨkʉlwa mihalʉ ang’wi mʉʉtinko. Antʉ ɨʉhunʉlaa kʉli. Nʉkete kʉtwɨ nʉije.”<verse eid="LUK 14:35" /></para>
  <chapter eid="LUK 14" />
  <chapter number="15" style="c" sid="LUK 15" />
  <para style="s">Mpyani a nkolo nɨlimɨe</para>
  <para style="r">
    <ref loc="MAT 18:12-14">Matayo 18:12-14</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1" />Lʉhikʉ lʉng’wɨ ahangʉlya kodi nɨanyamɨlandʉ aɨendile mʉtegeelya ʉ Yesʉ. <verse eid="LUK 15:1" /><verse number="2" style="v" sid="LUK 15:2" />Apalisayo nɨamanyisi amalagɨɨlyo ang’wa Musa akatula mʉtegeta azelʉnga, “Mʉntʉ ʉyʉ, wɨasɨngɨilya nʉkʉlɨzania nɨanyamɨladʉ.” <verse eid="LUK 15:2" /><verse number="3" style="v" sid="LUK 15:3" />Yesʉ akaatambʉɨla mpyani ɨyɨ.<verse eid="LUK 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 15:4" />“Anga ize mʉntʉ ʉng’wɨ mʉng’waanyu ʉkete nkolo igana lɨng’wɨ, anga wapumpugɨɨlye kɨna nkolo ɨng’wɨ ikʉtilɨ. Itɨɨ, shanga ʉkʉileka inkolo izo nimakʉmi kenda na kenda nʉkandya kʉmɨdʉma inkolo iyo nɨlɨmie kʉpikɨɨla wamɨlɨje? <verse eid="LUK 15:4" /><verse number="5" style="v" sid="LUK 15:5" />Anga wamɨlɨje, ʉkʉmɨkenka kiega waze wiloile. <verse eid="LUK 15:5" /><verse number="6" style="v" sid="LUK 15:6" />Anga wapike kitolakwe, ʉkʉitanga ɨahʉmbaʉya nɨanyakɨsalɨ nʉkʉaɨla. ‘Iloi palʉng’wɨ nʉnene kʉnsoko namihola inkolo ane naza ɨlimɨe.’ <verse eid="LUK 15:6" /><verse number="7" style="v" sid="LUK 15:7" />Itɨ gwa kʉmʉtambʉɨla, yɨkʉtula ilʉmbi kilunde kʉnsoko a mʉnyamɨlandʉ ʉng’wi nʉkʉleka ɨmɨlandʉ, kʉkɨla ɨantʉ makʉmi kende na kenda nɨagombekile kʉng’wi Itunda nɨagila igazo nɨlakɨla itʉnʉ.<verse eid="LUK 15:7" /></para>
  <para style="s">Mpyani a shilingɨ nɨlimɨe</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8" />Yesʉ akalogoleka kutambʉla “Anga itule ʉnyenye mʉine ʉli? Anga kʉlʉnge mʉsʉngʉ ʉng’wɨ ʉkete ʉnyinyʉ nʉa nangʉ ikʉmi niya nangʉ a peza, anga walimilye ʉnyinyʉ ʉng’wɨ, itɨɨ, shanga ʉkakɨlya ʉlʉmʉli, wamɨpyagʉle ɨnyʉmba nʉkʉduma kɨsa nyinyʉ nʉa nangʉ ɨng’wɨ kʉpikɨɨla walɨje. <verse eid="LUK 15:8" /><verse number="9" style="v" sid="LUK 15:9" />Anga walije, ʉkʉitanga iahumbaʉya nianyakɨsalɨ waaile, ‘Iloi palʉng’wɨ nʉ nene, kʉnsoko nalija ʉnyinyʉ wane nʉʉng’wɨ nʉa nangʉ a peza naza nimɨɨye.’ <verse eid="LUK 15:9" /><verse number="10" style="v" sid="LUK 15:10" />Itɨ ʉʉ kʉmʉɨla, itɨ ʉʉ nɨɨkiloa ɨitʉmɨ akilunde nɨang’wi Itunda kʉnsoko amʉnyamɨlandʉ ʉng’wɨ nʉkʉpɨlʉka nʉkila itʉnʉ.”<verse eid="LUK 15:10" /></para>
  <para style="s">Mpyani mʉhʉmba nʉlimɨe</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11" />Papo gwa ʉ Yesʉ akalongoleka kʉtambʉla, “Ai ʉkolɨ mʉntʉ ʉng’wɨ aɨ ʉkete ahʉmba abɨɨlɨ. <verse eid="LUK 15:11" /><verse number="12" style="v" sid="LUK 15:12" />Ʉyʉ nʉmʉniino akamʉɨla ihe, ‘Tata, kʉʉlompa ʉnomoele isalo lane.’ sʉnga ihe akagalania, akamʉpa mʉhʉmba nʉmʉniino isalo lakwe. <verse eid="LUK 15:12" /><verse number="13" style="v" sid="LUK 15:13" />Naɨ akɨla mahikʉ mashenyʉ, mʉhʉmba ʉyʉ nɨ mʉniino akagʉlya isalo lakwe, naɨ walija impia akatunga mʉhɨnzo nʉkʉlongola ihɨɨ akʉli kʉng’wanso akalya nʉkʉkulanga mpia yakwe kʉʉsambo. <verse eid="LUK 15:13" /><verse number="14" style="v" sid="LUK 15:14" />Naɨ wamala kʉsapatɨlya impia yakwe yɨhi, mihɨɨ nanso ɨkigela nzala ntaki, mʉhʉmba ʉyʉ akatulaga. <verse eid="LUK 15:14" /><verse number="15" style="v" sid="LUK 15:15" />Papo gwa mʉhʉmba ʉyʉ akaduma ʉtugwa kʉmʉkola ihɨɨ nanso, mʉgolɨ wakwe akamʉpa mʉlɨmo kʉlisa ngʉlima. <verse eid="LUK 15:15" /><verse number="16" style="v" sid="LUK 15:16" />Mʉhʉmba ʉyʉ akaawa kʉlya indya niyʉkʉlya ingʉlima, ingɨ aɨkʉtilɨ mʉntʉ wɨhi nʉakʉmʉpa kɨntʉ kɨhi nɨkakʉlya. <verse eid="LUK 15:16" /><verse number="17" style="v" sid="LUK 15:17" />Ingɨ mahala akwe naɨandilye kʉmʉsʉkɨla, wɨkisɨja mʉnkolo akwe, akalʉnga. ‘Kʉng’wa tata wane akolɨ anyamɨlɨmo ɨdʉ akʉlya nʉkusaja, nɨkɨ ʉnene kolɨ apa kishɨla na nzala? <verse eid="LUK 15:17" /><verse number="18" style="v" sid="LUK 15:18" />Kʉkahega kʉnʉ ntulye kʉng’wa tata wane nende nʉmʉɨle. Tata nakʉtendeela igazo ʉewe tata nʉ mʉlandʉ kʉng’wi Itunda kilunde. <verse eid="LUK 15:18" /><verse number="19" style="v" sid="LUK 15:19" />Shanga inonee nitangwe nɨng’waako. Kʉʉlompa itʉnʉ monenele kɨnyaʉwai ʉndeke ntule anga nɨʉng’wɨ nʉa anyamɨlɨmo ako.’ <verse eid="LUK 15:19" /><verse number="20" style="v" sid="LUK 15:20" />Ʉʉgwa akahega akʉtʉlya kʉng’wi ihe.</para>
  <para style="p" vid="LUK 15:20">“Nai wakɨlɨ ʉpembeeye kʉli, ihe akamʉona, akamʉaɨsɨɨlya, akamʉmankɨɨla akamʉsɨngɨilya akamʉʉngatɨla nʉkʉmʉlʉngɨla. <verse eid="LUK 15:20" /><verse number="21" style="v" sid="LUK 15:21" />Mʉhʉmba ʉyʉ akamʉɨla ihe, ‘Tata nakʉtendeela igazo ʉewe tata nʉ mʉlandʉ kʉng’wi Itunda kilunde. Shanga inonee nitangwe nɨng’waako.’ <verse eid="LUK 15:21" /><verse number="22" style="v" sid="LUK 15:22" />Ingɨ ihe akaalagɨɨlya ɨanyamɨlɨmo akwe, ‘Kayangi mʉleteli ɨngʉo nɨ maza mʉmʉtugale. Mʉtugalyi ikong’wa nɨla kʉshaala mʉtugalyi ilatʉ niiza. <verse eid="LUK 15:22" /><verse number="23" style="v" sid="LUK 15:23" />Mʉsɨnzi ng’waa mʉzagamba nʉmʉgɨnʉ, kʉnonie iloeelye kʉlye. <verse eid="LUK 15:23" /><verse number="24" style="v" sid="LUK 15:24" />Kʉnsoko ʉng’waane ʉyʉ aɨ wakʉlee itungo ɨlɨ mʉpanga, aɨ walimɨlaa itungo ɨlɨ wigelaa.’ Papo gwa akandya iloeelya.<verse eid="LUK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25" />“Matungo nanso ʉ heu wakwe nʉmʉkʉlʉ aɨ ʉkolɨ kʉmʉgʉnda. Naɨ naɨutuiye akahumbeela kito, akija ngɨligɨlɨ ningoma. <verse eid="LUK 15:25" /><verse number="26" style="v" sid="LUK 15:26" />Akamitanga mitʉmi ʉng’wɨ, akamʉkolya, ‘Itɨɨ, ntʉni nɨkɨkolɨ?’ <verse eid="LUK 15:26" /><verse number="27" style="v" sid="LUK 15:27" />Mitʉmɨ nʉanso akamʉɨla, ‘Mʉniino wako watʉlyaa kito, nʉ tataako wamʉsɨnzɨlaa ng’waa mʉzagamba nʉ mʉgɨnʉ kʉnsoko ʉng’waakwe watʉlyaa kito kʉnʉ mʉpanga.’<verse eid="LUK 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 15:28" />“Mʉhʉmba nʉmʉkʉlʉ akahʉng’wa ikuo nʉkʉhita kingɨla mʉnyʉmba. Ihe akapuma kʉnzi akamʉpepeelya. <verse eid="LUK 15:28" /><verse number="29" style="v" sid="LUK 15:29" />Mʉhʉmba nʉmʉkʉlʉ akamʉsʉkɨɨlya ihe, ‘Tata kɨmbʉka, ʉnene nɨkitʉmɨla myaka ɨhi, izaa nkɨlɨ nʉkʉhitɨlye kitʉma nʉndagɨɨye. Wampee ntʉni? Ʉkɨlɨ kʉmpa ga nʉ ng’waa mbʉli nʉmʉniino niloeelye palʉng’wɨ nɨahʉmba iane. <verse eid="LUK 15:29" /><verse number="30" style="v" sid="LUK 15:30" />Ingɨ ʉng’waako ʉyʉ nʉsapatɨɨye insao yako palʉng’wɨ nɨasambo, itungo ʉdu naza ʉgomokile ʉdu kito ʉewe wamʉsinzɨla ng’waa mʉzagamba nʉmʉgɨnu.’ <verse eid="LUK 15:30" /><verse number="31" style="v" sid="LUK 15:31" />Ihe akamʉsʉkɨɨlya, ‘Ng’waane ʉewe mahikʉ ɨhi ʉkolɨ palʉng’wɨ nʉ nene, maintʉ ɨhi nɨnkete ingɨ ako. <verse eid="LUK 15:31" /><verse number="32" style="v" sid="LUK 15:32" />Aza kʉtakɨwe kitʉma iloeelya nʉ kiloa, kʉnsoko ʉmʉniino wako ʉyʉ aɨ wakʉlee, itungo ɨlɨ waina mʉpanga, aɨ walimɨe itungo ɨlɨ wigela.”’<verse eid="LUK 15:32" /></para>
  <chapter eid="LUK 15" />
  <chapter number="16" style="c" sid="LUK 16" />
  <para style="s">Mpyani a milihwa nɨ mʉlɨngi</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1" />Yesʉ akaatambʉɨla amanyisigwa akwe, “Aɨ ʉkolɨ mʉntʉ ʉng’wɨ mʉgolɨ aɨ ʉkete milihwa wakwe. Mʉgolɨ nʉanso akaɨlwa kɨna milihwa wakwe wakulanga insao nʉilihilwe. <verse eid="LUK 16:1" /><verse number="2" style="v" sid="LUK 16:2" />Lʉhikʉ lʉng’wɨ mʉgolɨ akamitanga milihwa, akamʉkolya. ‘Makani kɨɨ aya nɨkija kʉng’waako? Itungo ɨlɨ mbaɨle ialo nɨla nsao yane nɨnʉkilihile, kʉnsoko shanga ʉkʉlongoleka kʉtula wɨmilihwa wane hangɨ.’ <verse eid="LUK 16:2" /><verse number="3" style="v" sid="LUK 16:3" />Itɨ gwa mɨlɨhwa ʉyʉ akasɨga kɨna. ‘Mʉgolɨ wane ʉkʉnihegelyaa ʉwilihwa wane. Itungo ɨlɨ kʉtenda ʉli? Kʉlɨma kʉleng’wa, hangɨ kenda kilompeelya kʉhung’wa mɨnyala. <verse eid="LUK 16:3" /><verse number="4" style="v" sid="LUK 16:4" />Itungo ɨlɨ nalɨnga nɨkakʉtenda, anga nihegigwe mʉ mʉlɨmo ɨantʉ ahume kʉnsɨngɨɨlya mʉmatolao.’<verse eid="LUK 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 16:5" />“Kʉlʉlo akaitanga ʉng’wɨ ʉng’wɨ mʉantʉ naɨ adaigwe, akamʉkolya nʉa ng’wandyo, ‘Itɨɨ, ʉdaigwe inga nʉmʉgolɨ wane? <verse eid="LUK 16:5" /><verse number="6" style="v" sid="LUK 16:6" />Mʉdaigwa nʉa ng’wandyo akasʉkɨɨlya. ‘Madebe igana nɨ makʉmi mʉnana na ataano na makuta amɨzeitʉni.’ milihwa ʉyʉ akamʉɨla ʉmʉdaigwa. ‘Hola itʉtʉ naɨ miandɨkɨe, kayanga andɨke makʉmi kenda na abɨɨlɨ.’ <verse eid="LUK 16:6" /><verse number="7" style="v" sid="LUK 16:7" />Sʉnga akamʉkolya mʉdaigwa nʉa kabɨɨlɨ. ‘Haɨ ʉewe ʉdaigwe inga?’ Nʉanso akamʉsʉkɨɨlya. ‘Mɨsʉta magana abɨɨlɨ angano.’ Milihwa akamʉɨla ‘Hola itʉtʉ naɨ miandɨkɨe, andike igana nɨ makʉmi mʉtandatʉ.’ <verse eid="LUK 16:7" /><verse number="8" style="v" sid="LUK 16:8" />“Itɨ gwa ʉmʉgolɨ akamʉlʉmbɨɨlya ʉmilihwa ʉyʉ nɨshanga mʉhʉɨɨli, kʉnsoko antʉ nɨshanga amʉhʉɨɨe Itunda kɨna ʉkete ʉlɨngi wɨdʉ, kʉsoko antʉ a mʉʉnkumbigʉlʉ ɨtʉmɨla mahala ɨdʉ, ingɨ antʉ nɨɨmʉtyata Itunda shanga ahʉgu anga nɨanso.”<verse eid="LUK 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 16:9" />Yesʉ nʉyo akalongoleka kʉtambʉla, “Ʉnene kʉmʉɨli, tʉmɨli nsao kidumɨlya ahʉmbaʉ ɨanyu, ingɨ anga iʉle mʉsɨngɨɨligwe ni Itunda mʉlikalo nʉla kalɨ na kalɨ. <verse eid="LUK 16:9" /><verse number="10" style="v" sid="LUK 16:10" />Mʉntʉ wɨhi nɨ mʉhʉɨɨli maintʉ nɨ maniino, ʉkʉtula mʉhʉɨɨli kʉ maintʉ nɨ makʉlʉ, hangɨ mʉntʉ wɨhi nɨshanga mʉhʉɨɨlɨ kʉ maintʉ nɨ maniino, shanga ʉkʉtula mʉhʉɨɨli kʉ maintʉ nɨdʉ. <verse eid="LUK 16:10" /><verse number="11" style="v" sid="LUK 16:11" />Kʉlʉlo gwa nga ʉhite kʉtula wɨmʉhʉɨɨli kʉtʉmɨla ʉgolɨ nʉwa mihɨɨ, nyenyu gwa nʉkʉʉpeza ʉgolɨ nʉwa kɨ nkolo? <verse eid="LUK 16:11" /><verse number="12" style="v" sid="LUK 16:12" />Hangɨ anga ɨze ʉnyenye shanga mɨahʉɨɨli kʉ ʉgolɨ nʉwa mʉntʉ mʉngɨɨza, nyenyu gwa nʉkʉmʉpa ʉgolɨ wanyu?<verse eid="LUK 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13" />“Kʉtilɨ mʉntʉ nʉhumile kʉitʉmɨla agolɨ abɨɨlɨ, kʉnsoko ʉkʉmʉbɨpɨlwa ʉng’wɨ nʉkumʉlowa ʉmʉya, ang’wɨ ʉkʉtula nʉlwijo kʉ mʉgolɨ ʉng’wɨ nʉkʉmʉdalaha ʉmʉya. Shanga mʉhumile kʉmitʉmɨla Itunda palʉng’wɨ ni mpia.”<verse eid="LUK 16:13" /></para>
  <para style="s">Ʉmanyisi ʉʉya nʉang’wa Yesʉ</para>
  <para style="r">
    <ref loc="MAT 11:12-13">Matayo 11:12-13</ref>; <ref loc="MAT 5:31-32">5:31-32</ref>; <ref loc="MRK 10:11-12">Maliko 10:11-12</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14" />Ingɨ Apalisayo naɨ alowa mpia naɨija nanso, akamʉdalaha ʉ Yesʉ. <verse eid="LUK 16:14" /><verse number="15" style="v" sid="LUK 16:15" />Papo gwa ʉ Yesʉ akaatambʉɨla, “Ʉnyenye midaiye mɨagoloku ntongeela ya antʉ, Ingɨ Itunda ʉɨlɨngɨle inkolo yanyu. Ingɨ iko nɨkɨkʉigwe nɨantʉ ingɨ Itunda ʉkɨbɨpɨwe kɨntʉ nɨkanso.<verse eid="LUK 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 16:16" />“Malagɨɨlyo ang’wa Musa nʉandɨkwa nʉa amanga ang’wi Itunda aɨ itanantigwa kʉpikɨɨla itungo lang’wa Yohana Mʉbadisi. Kʉpumɨɨla itungo lɨlo, Nkani Nza niya Ʉtemi wang’wi Itunda ikʉtanantigwa, mʉntʉ wɨhi ʉkingɨlaa kʉngulu mʉʉtemi nʉwanso. <verse eid="LUK 16:16" /><verse number="17" style="v" sid="LUK 16:17" />Ingɨ ipepeele ilunde ni ihɨɨ kʉhega, kʉkɨla ʉnyinyʉ nʉandɨkwa kʉhega mʉ malagɨɨlyo ang’wa Musa.<verse eid="LUK 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18" />“Mʉntʉ wɨhi nʉʉkʉmʉleka mʉkɨma wakwe nʉkʉtɨna mʉsʉngʉ mʉngɨɨza, ʉkʉgoolya, hangɨ mʉntʉ wɨhi nʉʉkʉmʉtina mʉsʉngʉ nʉlekilwe nʉmʉgoha, mʉntʉ nʉanso ʉkʉgoolya.<verse eid="LUK 16:18" /></para>
  <para style="s">Mʉgolɨ nʉ Lazalo</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19" />Yesʉ akalʉnga, “Ai ʉkolɨ mʉntʉ ʉng’wɨ mʉgolɨ, aɨ wɨtugalaa ngʉo aʉgʉlwi ʉkʉlʉ naʉkengo nʉa zabalaʉ naya nɨ melʉ pe, hangɨ mahikʉ ɨhi aɨ wishiɨ kʉ ʉsambo. <verse eid="LUK 16:19" /><verse number="20" style="v" sid="LUK 16:20" />Mʉʉla nʉitangwa Lazalo aɨɨza ʉtatɨe nkomele mʉɨlɨ wakwe wɨhi, aɨ wɨletwaa nʉkʉikwa pa mʉmpita nʉa nyʉmba amʉgolɨ nʉanso. <verse eid="LUK 16:20" /><verse number="21" style="v" sid="LUK 16:21" />Lazalo aɨ wɨawaa kʉlya maminyangʉɨlwa andya nalagae pɨhi ameza amʉgolɨ, itɨ gwa mbwa aɨyɨza kʉlapa inkomele yakwe.<verse eid="LUK 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 16:22" />“Panyambele, Lazalo akasha, a Malaɨka akamʉhola akamʉtwala wikiɨ palʉng’wɨ Ibulahimu. Nʉ mʉgolɨ ʉyʉ akasha, akaɨkwa mʉkɨbɨɨla. <verse eid="LUK 16:22" /><verse number="23" style="v" sid="LUK 16:23" />Kʉng’wanso kʉantʉ nɨakʉle ʉmʉgolɨ aɨ ʉkete lwago, akagoza kʉlɨ, akamʉona ʉ Lazalo wikiɨ palʉng’wɨ nʉ Ibulahimu. <verse eid="LUK 16:23" /><verse number="24" style="v" sid="LUK 16:24" />Papo mʉgolɨ akalila, akitʉnta. ‘Tataane Ibulahimu mbaisɨɨlye, ʉmʉlagɨɨlye ʉ Lazalo wine ɨshaala kakwe mʉmazɨ waze wantontelye ilangʉ, kʉnsoko kʉnʉ kʉashi nkolɨ mʉ lwago la moto.’<verse eid="LUK 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 16:25" />“Ingɨ ʉ Ibulahimu akamʉsʉkɨɨlya, ‘Ng’waane kɨmbʉka mʉ ʉpanga wako aɨ wɨlija maintʉ ɨhi nɨmaza, nʉ Lazalo aɨ wagaa. Itungo ɨlɨ ʉkolɨ ʉkʉtetembwa, nʉewe ʉkaga. <verse eid="LUK 16:25" /><verse number="26" style="v" sid="LUK 16:26" />Kʉleka nanso, pakatɨ itʉ lɨpʉʉwe ikombo ilundu, kʉnsoko awo nɨakolɨ kitoitʉ nɨaloilwe kʉpembya kʉng’waanyu aleng’we, nawa nɨakolɨ kʉng’waanyu nɨaloilwe kʉpembya kitoitʉ aleng’we.’ <verse eid="LUK 16:26" /><verse number="27" style="v" sid="LUK 16:27" />Mʉntʉ ʉyʉ naɨ mʉgolɨ akaminena, ‘Itɨ gwa tata wane kʉʉlompa mʉlagɨɨlye ʉ Lazalo walongole kʉ anyandʉgʉ ane, <verse eid="LUK 16:27" /><verse number="28" style="v" sid="LUK 16:28" />kʉnsoko nkete aheu ane ataano. Wende waahʉgʉlye nɨenso aleke kʉpembya kʉnʉ mʉlwago.’<verse eid="LUK 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 16:29" />“Ibulahimu akamʉsʉkɨɨlya, ‘Aheu ako akete Musa nɨamanga ang’wi Itunda, leka aategeelye wawo.’ <verse eid="LUK 16:29" /><verse number="30" style="v" sid="LUK 16:30" />Mʉntʉ ʉyʉ naɨ mʉgolɨ akalʉnga, ‘Aa shanga ikondile, tataane Ibulahimu, Ingɨ anga ahangwe ahʉgʉligwe nʉ mʉntʉ nʉiʉkile kʉpuma kʉnʉ kʉashi, akʉmija nʉkila itʉnʉ.’ <verse eid="LUK 16:30" /><verse number="31" style="v" sid="LUK 16:31" />Ingɨ ʉ Ibulahimu nʉng’wenso akalʉnga. ‘Anga ahite kʉategeelya Musa nɨamanga ang’wi Itunda, shanga akʉmʉkela ka nʉ mʉntʉ nʉiʉkile kʉpuma kʉnʉ kʉashi.”’<verse eid="LUK 16:31" /></para>
  <chapter eid="LUK 16" />
  <chapter number="17" style="c" sid="LUK 17" />
  <para style="s">Ʉmanyisi nʉa mɨlandʉ nʉ ʉlekelwa</para>
  <para style="r">
    <ref loc="MAT 18:6-7">Matayo 18:6-7</ref>; <ref loc="MAT 21">21</ref>; <ref loc="MAT 22">22</ref>; <ref loc="MRK 9:42">Maliko 9:42</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1" />Sʉnga ʉ Yesʉ akaatambʉɨla amanyisigwa akwe, “Maintʉ nakʉmʉsasha mʉntʉ witʉme mɨlandʉ akigela, ʉkaga mʉntʉ ʉyʉ nʉkʉsasha mʉntʉ witʉme mɨlandʉ. <verse eid="LUK 17:1" /><verse number="2" style="v" sid="LUK 17:2" />Yɨkʉtula bahu mʉntʉ ʉyʉ watungɨɨlɨgwe lwala nʉlʉkʉlʉ mʉnkingo akwe wagʉmɨlwa mʉlʉzɨ nʉlʉkʉlʉ, kʉkɨla kʉmʉsasha mʉng’enya wɨhi mʉniino witʉme mɨlandʉ. <verse eid="LUK 17:2" /><verse number="3" style="v" sid="LUK 17:3" />Kʉlʉlo hʉgʉki.</para>
  <para style="p" vid="LUK 17:3">“Mʉnyandʉgʉ wako anga watenda mʉlandʉ, mʉkenele, anga wila itʉnʉ, mʉlekele ʉmʉlandʉ wakwe. <verse eid="LUK 17:3" /><verse number="4" style="v" sid="LUK 17:4" />Anga wakʉtendeele mʉlandʉ nkʉa mʉpungatɨ mʉlʉhikʉ lʉng’wɨ, nʉng’wenso wakʉhange nkʉa mʉpungatɨ wazekʉɨla, ‘Nilaa itʉnʉ,’ mʉlekele ʉmʉlandʉ wakwe.”<verse eid="LUK 17:4" /></para>
  <para style="s">Ʉhʉɨɨli</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5" />Itʉmi akamʉɨla ʉ Yesʉ, “Isekʉlʉ kongeelye ʉhʉɨɨlɨ.”<verse eid="LUK 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 17:6" />Yesʉ akasʉkɨɨlya, “Anga azaize mʉkete ʉʉhʉɨɨlɨ ʉniino anga mbeʉ nɨ niino na mʉtɨ nʉa haladali, mʉhumile kʉʉlagɨɨlya mʉkʉyʉ ʉwʉ, ‘nomooka apaitɨ wende witemele mʉlʉzɨ nʉlʉkʉlʉ,’ mʉkʉyʉ aza ʉziija.<verse eid="LUK 17:6" /></para>
  <para style="s">Mʉlɨmo nʉa mitʉmɨ</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7" />Yesʉ akalʉnga “Anga itule ʉng’wɨanyu ʉɨkete mʉnyamɨlɨmo ʉkʉlɨma mʉ mʉgʉnda ang’wi ʉkʉdɨma nkolo. Anga wakotoke. Itɨɨ, mʉkʉlʉ wakwe ʉkʉmʉɨlane ʉmʉnyamɨlɨmo pepala nzʉʉ ʉlye indya? <verse eid="LUK 17:7" /><verse number="8" style="v" sid="LUK 17:8" />Itɨɨ, shanga ʉkʉmʉɨlane ʉmʉnyamɨlɨmo, ‘Ʉnoneelelye indya, ndye. Ihambe, ʉnoneelelye niyakʉlya nʉkʉng’wa, nʉewe ʉkʉtyatɨɨla kʉlya.’ <verse eid="LUK 17:8" /><verse number="9" style="v" sid="LUK 17:9" />Itɨɨ, ʉkʉmʉlʉmbane mʉnyamɨlɨmo nʉanso kʉnsoko witʉmɨle aya nʉlagɨɨgwe kitʉma? <verse eid="LUK 17:9" /><verse number="10" style="v" sid="LUK 17:10" />Iti ʉʉ nʉnyenye ga, anga mʉkondye kitʉma ɨhi nɨmʉlagɨɨgwe, lʉngi, ‘Ʉsese kɨanyamɨlɨmo nɨkɨagila anga nsailo, kitʉmile anga naza kʉlagɨigwe kitʉma.”’<verse eid="LUK 17:10" /></para>
  <para style="s">Yesʉ ʉkʉakomya anyambili ikʉmi</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11" />Yesʉ akaze ʉkolɨ mʉmʉhɨnzo ʉlongoe kʉ Yelusalemu aɨ ʉkɨɨe mʉmɨmbɨ niya Samalia nɨ Galilaya. <verse eid="LUK 17:11" /><verse number="12" style="v" sid="LUK 17:12" />Naɨ wandilye kingɨla mʉkɨsalɨ kɨng’wɨ, anyambili ikʉmi akatankana nʉng’wenso, akimɨkɨla kʉli. <verse eid="LUK 17:12" /><verse number="13" style="v" sid="LUK 17:13" />Akitʉnta, akalʉnga, “Isekʉlʉ, Yesʉ kʉaisɨɨlye!”<verse eid="LUK 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14" />Naɨ waaona akaaɨla, “Longoli miambye kʉapolyi.” Ʉʉgwa naɨ alongoe, akela ɨmbili ao nʉkʉgombeka kʉntendo ipolyo. <verse eid="LUK 17:14" /><verse number="15" style="v" sid="LUK 17:15" />Ʉng’wɨao naɨ wiona kɨna welaa imbili akwe, akatʉlya kʉng’wa Yesʉ akazitʉnta nʉkʉmʉkʉlya Itunda. <verse eid="LUK 17:15" /><verse number="16" style="v" sid="LUK 17:16" />Akagwa ʉundaala pamɨgʉlʉ ang’wa Yesʉ waze mʉlʉmba. Mʉntʉ ʉnyʉ ingɨ aɨ Mʉsamalia. <verse eid="LUK 17:16" /><verse number="17" style="v" sid="LUK 17:17" />Papo Yesʉ akamʉkolya, “Itɨɨ, shanga nɨeilye antʉ ɨhi ikʉmi? Awa nɨkenda akolɨ pɨɨ? <verse eid="LUK 17:17" /><verse number="18" style="v" sid="LUK 17:18" />Kʉtilɨne nʉmʉngɨɨza nʉsʉkile kʉmʉkʉlya Itunda, ingɨ wasʉka ʉmʉnzɨɨla yʉyʉ du?” <verse eid="LUK 17:18" /><verse number="19" style="v" sid="LUK 17:19" />Sʉnga Yesʉ akamʉɨla mʉntʉ ʉyʉ naɨ welaa, “Imɨke ʉlongole kitolako, ʉhʉɨɨlɨ nʉako wakʉkomya.”<verse eid="LUK 17:19" /></para>
  <para style="s">Kʉpembya kʉ ʉtemi wang’wi Itunda</para>
  <para style="r">
    <ref loc="MAT 24:23-28">Matayo 24:23-28-37-41</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20" />Itungo lɨng’wɨ, Apalisayo akamʉkolya ʉ Yesʉ, “Ʉtemi wang’wi Itunda ʉzile nalɨ?” Yesʉ akaasʉkɨɨlya, “Ʉtemi wang’wi Itunda shanga ʉzile ize wigeelekile. <verse eid="LUK 17:20" /><verse number="21" style="v" sid="LUK 17:21" />Hangɨ kʉtilɨ nʉkʉlʉnga, ‘Ʉkolɨ apa itɨ,’ ang’wi ‘Ʉkolɨ apo itɨ.’ Kʉnsoko ʉtemi wang’wi Itunda ʉmolɨ mʉng’wanyu.”<verse eid="LUK 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22" />Sʉnga akaatambʉɨla amanyisigwa akwe, “Itungo lɨpembilye nɨmʉkʉhʉng’wa nsʉla mʉone hangɨ lʉhikʉ lʉng’wɨ nʉla mahikʉ ane Ng’waa Mʉntʉ, ingɨ shanga mʉkʉmona. <verse eid="LUK 17:22" /><verse number="23" style="v" sid="LUK 17:23" />Hangɨ antʉ akʉmʉɨla. ‘Gozi, ʉkolɨ apo itɨ.’ Ang’wɨ ‘Gozi ʉkolɨ apa itɨ.’ Ingɨ ʉnyenye leki kʉpumi pamʉkolɨ ang’wɨ leki kʉatyati. <verse eid="LUK 17:23" /><verse number="24" style="v" sid="LUK 17:24" />Kʉnsoko anga lʉpɨto nʉlɨpɨta nʉkelya ilunde ipande lɨng’wɨ nipande lʉlya, ʉʉ ʉnene Ng’waa Mʉntʉ kʉtula mʉlʉhikʉ lane. <verse eid="LUK 17:24" /><verse number="25" style="v" sid="LUK 17:25" />Ingɨ ntakɨwe ʉnene Ng’waa Mʉntʉ nagigwe hanza nʉkʉhitwa nɨantʉ iele ɨlɨ.<verse eid="LUK 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 17:26" />“Anga naɨ yɨlɨ mʉ mahikʉ ang’wa Nuhu, yʉkʉtula ʉʉ mʉ mahikʉ ane Ng’waa Mʉntʉ. <verse eid="LUK 17:26" /><verse number="27" style="v" sid="LUK 17:27" />Mʉmahikʉ ang’wa Nuhu antʉ aɨ alongolekile kʉlya nʉkʉng’wa, kʉtɨna nʉkʉtɨnwa kʉpikɨɨla lʉhikʉ ʉ Nuhu naɨ wingɨe mʉsapina. Kɨhʉmo ka mbula nkʉlʉ akapumɨla nʉkʉlimansɨɨlya intʉ yɨhi. <verse eid="LUK 17:27" /><verse number="28" style="v" sid="LUK 17:28" />Anga naɨ itulɨkile mʉmatungo ang’wa Loti. Antʉ aɨ alongolekile kʉlya nʉkʉng’wa, kʉgʉla kʉgʉlya, kʉlima nʉkuzenga. <verse eid="LUK 17:28" /><verse number="29" style="v" sid="LUK 17:29" />Ingɨ ulʉhikʉ ʉ Loti naɨ ʉhegile kʉ Sodoma, moto nʉa kibiliti kʉpuma kilunde yɨkahunʉka anga mbula nʉ kʉalimansɨɨlya ɨhi. <verse eid="LUK 17:29" /><verse number="30" style="v" sid="LUK 17:30" />Iti ʉʉ yʉkʉtula ʉlʉhikʉ ʉlo nʉla nene Ng’waa Mʉntʉ nɨkigeela.<verse eid="LUK 17:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 17:31" />“Lʉhikʉ nʉlanso, mʉntʉ wɨhi nʉkolɨ kitembe nʉaleke kʉsima kingɨla mʉnyʉmba kʉhola maintʉ akwe. Nʉyʉ nʉkolɨ kʉmʉgʉnda waleke kʉtulya kito kʉhola maintʉ akwe. <verse eid="LUK 17:31" /><verse number="32" style="v" sid="LUK 17:32" />Kɨmbʉkɨɨlyi naɨ amʉhangɨle mʉsʉngʉ wang’wa Loti. <verse eid="LUK 17:32" /><verse number="33" style="v" sid="LUK 17:33" />Kʉnsoko mʉntʉ wɨhi nʉloilwe kʉponia ʉlikalo lakwe, ʉkʉlʉlimɨlya, ingɨ ʉyʉ nʉkulimɨlya ʉlikalo lakwe kʉnsoko ane ʉkiponia. <verse eid="LUK 17:33" /><verse number="34" style="v" sid="LUK 17:34" />Kʉmʉtambʉɨla, lʉhikʉ nʉlanso ʉtikʉ antʉ abɨɨlɨ akʉtula alae ʉlɨlɨ ʉng’wɨ, ʉng’wɨ ʉkʉholwa nʉmʉya ʉkʉlekwa. <verse eid="LUK 17:34" /><verse number="35" style="v" sid="LUK 17:35" />Asʉngʉ abɨɨlɨ nɨakʉsia palʉng’wɨ mʉlwala, ʉng’wɨ ʉkʉholwa nʉmʉya ʉkʉlekwa.” <verse eid="LUK 17:35" /><verse number="36" style="v" sid="LUK 17:36" />Itʉnja abɨɨlɨ akʉtula akolɨ mʉ mʉgʉnda, ʉng’wɨ ʉkʉholwa nʉmʉya ʉkʉlekwa.<verse eid="LUK 17:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 17:37" />Papo amanyisigwa akwe akamʉkolya, “Isekʉlʉ makani aya akʉpumɨla pii?”</para>
  <para style="p" vid="LUK 17:37">Yesʉ akaasʉkɨɨlya, “Nʉʉkolɨ mʉimba wakɨkalɨ, papo indi yʉkilingɨɨlɨla.”<verse eid="LUK 17:37" /></para>
  <chapter eid="LUK 17" />
  <chapter number="18" style="c" sid="LUK 18" />
  <para style="s">Mpyani amʉsʉngʉ nʉshɨɨwe nʉ mʉgoha nʉ mʉlamʉli</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1" />Itɨ gwa, Yesʉ aɨ ʉatambʉɨe amanyisigwa akwe mpyani ɨyɨ, kʉalagɨɨla nɨatakɨwe kʉmʉlompa Itunda mahikʉ ɨhi aleke kʉkatapa. <verse eid="LUK 18:1" /><verse number="2" style="v" sid="LUK 18:2" />Yesʉ akalʉnga, “Mʉkɨsalɨ kɨng’wɨ aɨ ʉkolɨ mʉlamʉli nɨshanga aɨ ʉmogopile Itunda ang’wɨ kʉakela antʉ ɨhi. <verse eid="LUK 18:2" /><verse number="3" style="v" sid="LUK 18:3" />Mʉkɨsalɨ kɨko kɨɨko, aɨ ʉkolɨ mʉsʉngʉ nʉshɨɨwe nʉ mʉgoha naɨ wɨmʉtyataa nkʉa yɨdʉ ʉmʉlamʉli wazemʉpepeelya wazemʉɨla ‘Nzaɨɨlye ndije maintʉ mʉabi ane naɨ akʉhiya kʉnimɨlɨɨlya.’ <verse eid="LUK 18:3" /><verse number="4" style="v" sid="LUK 18:4" />Mʉlamʉli ʉyʉ aɨ wɨhita kʉmʉaɨɨlya ʉmʉsʉngʉ ʉyʉ kitungo ilɨpu, mpelo akwe akipwepweela, ‘Palʉng’wi nʉ nene kʉtula shanga nɨmogopa Itunda ang’wi kʉakela antʉ, <verse eid="LUK 18:4" /><verse number="5" style="v" sid="LUK 18:5" />ingɨ kʉnsoko mʉsʉngʉ ʉyʉ nʉshɨɨwe nʉ mʉgoha wakwe ʉlongolekile kʉnyoma, anga nʉmʉaɨɨlye ɨko nʉloilwe ʉkʉleke kʉnyoma, anga ɨze shanga ʉʉ ʉkʉlongoleka kʉntyatɨɨla, mpelo akwe wankatalye!”’<verse eid="LUK 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6" />Itɨ gwa, ʉ Isekʉlʉ Yesʉ akatambʉla, “Masɨganɨɨlyi, aya naɨʉmatambʉe ʉmʉlamʉli ʉyʉ nɨshanga wɨtʉma mʉlɨmo wakwe anga mʉitakɨwe. <verse eid="LUK 18:6" /><verse number="7" style="v" sid="LUK 18:7" />Itɨɨ, kʉlʉnge kɨna Itunda shanga ʉkʉatendeela ɨtai antʉ awo nʉahoile, nɨɨmʉlɨɨla ng’ʉng’wɨ nʉ ʉtikʉ? Itɨɨ, ʉkʉtinia ne kʉapa nɨatakile? <verse eid="LUK 18:7" /><verse number="8" style="v" sid="LUK 18:8" />Kʉmʉɨla ʉkʉkaya kʉapa nɨatakile. Nɨitɨ ga, itɨɨ, ʉnene Ng’waa Mʉntʉ lʉhikʉ nɨkʉpembya kʉhaga antʉ aketene ʉhʉɨɨlɨ mihɨɨ?”<verse eid="LUK 18:8" /></para>
  <para style="s">Mpyani ang’wa Palisayo nʉ mʉhangʉlya kodi</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9" />Ʉʉgwa ʉ Yesʉ akaatambʉɨla kʉ mpyani, antʉ awo nɨisanilye kɨna agombekile ntongeela ang’wi Itunda nʉ kʉadalaha ɨaʉya, akalʉnga, <verse eid="LUK 18:9" /><verse number="10" style="v" sid="LUK 18:10" />“Antʉ abɨɨlɨ aɨ alongoe Mʉnyʉmba ang’wi Itunda kenda kʉlompa. Ʉng’wi Palisayo nʉ mʉya mʉhangʉlya kodi.<verse eid="LUK 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 18:11" />Palisayo ʉyʉ akimɨka, akalompa wazikʉlya kʉng’wi Itunda, ‘Ʉewe Itunda nʉkʉlʉmbile kʉnsoko ʉnene shanga nɨmʉbɨ anga antʉ ang’wi, Antʉ nɨ ii nɨang’wɨ ateele nɨang’wɨ asambo. Nʉkʉlumbile kɨna ʉnene shanga nɨhanga mʉhangʉlya kodi ʉyʉ. <verse eid="LUK 18:11" /><verse number="12" style="v" sid="LUK 18:12" />Ʉnene nɨgwalya kʉlya kabɨɨlɨ kɨmahikʉ mʉpungatɨ, nɨpumyaa masongelyo iganda lɨng’wɨ mʉ maganda ikʉmi namaintʉ nɨ ndigilye.’<verse eid="LUK 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 18:13" />Ingɨ mʉhangʉlya kodi ʉyʉ, akaze wimɨkɨe kʉli akaze ʉkunamile, akikʉanga mʉkɨkua kʉʉkia, akalʉnga, ‘Ʉewe Itunda, mbaisɨɨlye ʉnene nɨmʉnyamɨlandʉ.”’ <verse eid="LUK 18:13" /><verse number="14" style="v" sid="LUK 18:14" />Yesʉ akaaɨla, “Mʉhangʉlwa kodi ʉyʉ aɨ ʉsʉkile kitolakwe waze ʉgombekile kʉng’wi ni Itunda. Ingɨ kʉng’wa Palisayo shanga ʉʉ. Kʉnsoko wɨhi nʉwikʉlya wɨninopigwa nʉyʉ nʉininopya wikʉligwa.”<verse eid="LUK 18:14" /></para>
  <para style="s">Yesʉ ʉkʉakembeta ang’enya nɨaniino</para>
  <para style="r">
    <ref loc="MAT 19:13-15">Matayo 19:13-15</ref>; <ref loc="MRK 10:13-16">Maliko 10:13-16</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15" />Antʉ aɨ ɨmʉletela Yesʉ ang’enya nɨaniino akembetwe. Amanyisigwa akwe naɨ aaona, akaakenela. <verse eid="LUK 18:15" /><verse number="16" style="v" sid="LUK 18:16" />Ingɨ ʉ Yesʉ akaitanga ang’enya nɨaniino kʉng’waakwe wazelʉnga, “Aleki ang’enya nɨanso nɨaniino aze kʉng’wane, leki kʉagilyi, kʉnsoko Ʉtemi wang’wi Itunda waantʉ nɨɨhanga ang’enya awa. <verse eid="LUK 18:16" /><verse number="17" style="v" sid="LUK 18:17" />Kʉmʉɨli ɨtai, mʉntʉ wɨhi nɨshanga ʉkʉʉsingɨilya ʉtemi wang’wi Itunda anga mʉng’enya nʉmʉniino, kwee shanga ʉkʉingɨla ʉʉtemi wang’wi Itunda.”<verse eid="LUK 18:17" /></para>
  <para style="s">Mʉtongeeli nɨmʉgolɨ</para>
  <para style="r">
    <ref loc="MAT 19:16-30">Matayo 19:16-30</ref>; <ref loc="MRK 10:17-31">Maliko 10:17-31</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18" />Mʉtongeeli ʉng’wɨ nʉa Kiyahudi akamʉkolya ʉ Yesʉ, “Mʉmanyisi nʉmʉkende, ʉnene ntendeʉlɨ nihume kʉʉpantɨka ʉʉpanga nʉa kalɨ na kalɨ?”<verse eid="LUK 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 18:19" />Yesʉ akamʉsʉkɨɨlya, “Kʉnɨkɨ ʉkʉnintanga ʉnene nɨmʉkende? Kʉtilɨ nɨmʉkende ingɨ Itunda wing’wene du. <verse eid="LUK 18:19" /><verse number="20" style="v" sid="LUK 18:20" />Ʉmalingɨlene ɨmalagɨɨlyo, ‘Leka kʉgoolya, Leka kʉbʉlaga, Leka kia, Leka kʉkʉɨɨla ʉteela, Akʉlye tataako nʉ iyaako”’<verse eid="LUK 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 18:21" />Mʉtongeeli nɨmʉgolɨ akalʉnga, “Nanso ɨhi nɨmaambile kʉpumɨɨla ʉʉhʉmba wane.”<verse eid="LUK 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 18:22" />Yesʉ naɨ wija itɨ, akamʉɨla, “Ʉkɨlɨ ʉkepewe kɨntʉ kɨng’wɨ. Longola ʉgʉlye maintʉ ɨhi nʉʉkete, mpia nɨanso ʉagalanie ɨaʉla, ʉkʉtula ʉkete kɨʉto kigʉlʉ, sʉnga nzʉʉ ʉntyate.” <verse eid="LUK 18:22" /><verse number="23" style="v" sid="LUK 18:23" />Mʉtongeeli ʉyʉ nɨ mʉgolɨ naɨwija inkani nianso, akahʉsha nanguluu kʉnsoko aɨ mʉgolɨ ikʉlʉ.<verse eid="LUK 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 18:24" />Yesʉ naɨ waona wahʉsha itɨ, akalʉnga, “Goza itɨ nɨikakʉ mʉgolɨ kingɨla mʉʉtemi wang’wi Itunda. <verse eid="LUK 18:24" /><verse number="25" style="v" sid="LUK 18:25" />Ingɨ itontu kɨkalɨ nɨkikʉlʉ nɨkitangwa ngamia kingɨla mʉ nzʉʉnki alʉsingɨ, kʉkɨla mʉgolɨ kingɨla mʉʉtemi wang’wi Itunda.”<verse eid="LUK 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 18:26" />Antʉ awo naɨ ija inkani ɨlɨ, akakolya, “Nyenyu gwa nʉʉkʉgunwa?”<verse eid="LUK 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 18:27" />Yesʉ akasʉkɨɨlya, “Nishanga ahumɨkile kʉ mʉntʉ, kʉng’wi Itunda ahumɨkile.”<verse eid="LUK 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 18:28" />Petelo nʉng’wenso akamʉkolya ʉ Yesʉ, “Ʉsese kʉlekile ɨmaintʉ itʉ ɨhi kakʉtyata.”<verse eid="LUK 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 18:29" />Yesʉ akaaɨla, “Kʉmʉɨla kulu kʉʉlu, mʉntʉ wɨhi nʉmilekile ɨndʉgʉakwe nʉ mʉsʉngʉ wakwe ang’wɨ aluna akwe ang’wi aleli akwe ang’wi ana akwe kʉnsoko a ʉtemi wang’wi Itunda, <verse eid="LUK 18:29" /><verse number="30" style="v" sid="LUK 18:30" />itungo ɨlɨ ʉkʉlija nkʉa yɨdʉ, nʉkigʉlʉ ʉkʉlija intʉ yɨdʉ ikɨlo, ʉkʉlija nʉ ʉpanga nʉa kalɨ na kalɨ.”<verse eid="LUK 18:30" /></para>
  <para style="s">Yesʉ ʉkʉpumya mʉloto nkʉa a kataatʉ ɨnsha nʉ wiʉki wakwe</para>
  <para style="r">
    <ref loc="MAT 20:17-19">Matayo 20:17-19</ref>; <ref loc="MRK 10:32-34">Maliko 10:32-34</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31" />Yesʉ akaatwala kɨmpelo amanyisigwa awo nɨikʉmi na abɨɨlɨ, akaatambʉɨla, “Tegeelyi. Kʉʉnankɨla kʉlongoe kʉ Yelusalemu kʉng’wanso maintʉ ɨhi nɨnandɨkɨwe nɨamanga ang’wi Itunda ʉnene Ng’waa Mʉntʉ akʉkondanɨɨligwa. <verse eid="LUK 18:31" /><verse number="32" style="v" sid="LUK 18:32" />Kʉnsoko alʉgʉ a Ng’waa Mʉntʉ akʉmʉtwala mʉantʉ nɨshanga Ayahudi, nɨenso akʉmʉtendeela ʉbɨ nʉkʉmʉtyila imati. <verse eid="LUK 18:32" /><verse number="33" style="v" sid="LUK 18:33" />Akʉmʉkʉa mɨsheleti nʉkʉmʉbʉlaga, lʉhikʉ nʉla kataatʉ ʉkiʉka.”<verse eid="LUK 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 18:34" />Ingɨ amanyisigwa akwe shanga akalɨnga ikani ɨlɨ, aiapɨhilwe indogoelyo ikani nɨlanso, hangɨ shanga akalɨnga ɨkɨ nɨkɨtambʉwe.<verse eid="LUK 18:34" /></para>
  <para style="s">Yesʉ ʉkʉmʉponya mʉpokʉ</para>
  <para style="r">
    <ref loc="MAT 20:29-34">Matayo 20:29-34</ref>; <ref loc="MRK 10:46-52">Maliko 10:46-52</ref></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35" />Yesʉ naɨ wahumbeela kɨsalɨ ka Yeliko, mʉntʉ ʉng’wɨ mupoku aiwikɨɨ mupelo anzɨla ukilompeelya. <verse eid="LUK 18:35" /><verse number="36" style="v" sid="LUK 18:36" />Mupoku ʉyʉ naɨwija iumbɨ laantʉ likʉkɨla, akaolya, “Hai ntʉni?”<verse eid="LUK 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 18:37" />Akamʉɨla, “Yesʉ Mʉzaleti ʉkɨile.”<verse eid="LUK 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 18:38" />Papo mʉpoku ʉyʉ akitʉnta, akalʉnga, “Yesʉ Ng’wana wang’wa Daudi, mbaisɨɨlye.”<verse eid="LUK 18:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 18:39" />Ʉʉgwa antʉ awo naɨ atongee kʉntongeela akamʉkenela wakɨlage, mʉpoku ʉyʉ akalongoleka kɨntʉnta. “Ng’wana wang’wa Daudi mbaisɨɨlye.”<verse eid="LUK 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 18:40" />Yesʉ akimɨka akalagɨɨlya antʉ amʉlete pang’waakwe. Mʉpoku ʉyʉ naɨwahumbeela pakupɨ, Yesʉ akamʉkolya, <verse eid="LUK 18:40" /><verse number="41" style="v" sid="LUK 18:41" />“Ʉloilwe nʉkʉtendeele ntʉni?”</para>
  <para style="p" vid="LUK 18:41">Mʉpoku akamʉsʉkɨɨlya, “Isekʉlʉ kʉlompa nihume kʉona.”<verse eid="LUK 18:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 18:42" />Yesʉ akamʉɨla, “Pitya ʉone! Ʉhʉɨɨlɨ wako wakʉponia.”<verse eid="LUK 18:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 18:43" />Papo paapo mʉpoku akapitya akandya kʉona, akamʉtyata ʉ Yesʉ kʉnʉ wazemʉkʉlya Itunda. Nɨantʉ ɨhi naɨ aine nanso akamʉkʉlya Itunda.<verse eid="LUK 18:43" /></para>
  <chapter eid="LUK 18" />
  <chapter number="19" style="c" sid="LUK 19" />
  <para style="s">Yesʉ nʉ Zakayo</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1" />Yesʉ akingɨla kʉ Yeliko, akiʉmba ʉmba mʉnzɨla niyakɨsalɨ nɨkanso. <verse eid="LUK 19:1" /><verse number="2" style="v" sid="LUK 19:2" />Mʉkɨsalɨ nɨkanso aɨ ʉkolɨ mʉntʉ ʉng’wɨ witang’waa Zakayo, mʉntʉ ʉyʉ aɨ mʉtongeeli waahangʉlwa kodi, nʉyo aɨ mʉgolɨ. <verse eid="LUK 19:2" /><verse number="3" style="v" sid="LUK 19:3" />Zakayo aɨ wɨduma wamʉone ʉ Yesʉ wɨʉli, ingɨ aɨ wɨleng’wa kʉmʉona, kʉnsoko aɨ mʉkupi nɨantʉ aɨ ɨdʉ. <verse eid="LUK 19:3" /><verse number="4" style="v" sid="LUK 19:4" />Itɨ gwa akamanka kʉntongeela, akanankɨla mʉmʉkʉyʉ naɨ ʉkolɨ pampelo anzɨla wahume kʉmʉona Yesʉ, kʉnsoko aɨ ʉlɨngile kɨna ʉ Yesʉ ʉkʉkɨɨla nzɨla yɨyo. <verse eid="LUK 19:4" /><verse number="5" style="v" sid="LUK 19:5" />Itɨ gwa, ʉ Yesʉ naɨ wapika pamʉkʉyʉ nʉanso, akalangamila migʉlya, akamʉɨla, “Zakayo kayanga sima, kʉnsoko lelo ɨyɨ kʉʉgenipa.”<verse eid="LUK 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 19:6" />Zakayo akipatɨɨlya akasima, akamʉsingɨilya ʉ Yesʉ kʉʉkende. <verse eid="LUK 19:6" /><verse number="7" style="v" sid="LUK 19:7" />Antʉ ɨhi naɨaona nanso, akatula nang’ana azelʉnga, “Wamʉgenipa mʉnyamɨlandʉ!”<verse eid="LUK 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 19:8" />Ingɨ ʉ Zakayo akimɨka, akamʉɨla, “Isekʉlʉ tegeelya! Ʉnene kʉgalania mʉmaganda abɨɨlɨ na nsao yane ɨganda ɨng’wɨ kʉapa aʉla, hangɨ anga ɨze ai nʉmiɨe mʉntʉ wɨhi kɨntʉ kakwe, kʉmʉsʉkɨɨlya kanɨ.”<verse eid="LUK 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 19:9" />Yesʉ akamʉɨla, “Lelo ɨyɨ ʉguni wingɨla mʉnyʉmba ɨyɨ, kʉnsoko ingɨ nʉyʉga mʉhʉmba wang’wa Ibulahimu. <verse eid="LUK 19:9" /><verse number="10" style="v" sid="LUK 19:10" />Kʉnsoko ʉnene Ng’waa Mʉntʉ nzileduma nʉkʉguna ɨkɨ nɨkɨlimɨe.”<verse eid="LUK 19:10" /></para>
  <para style="s">Mpyani a itʉmɨ ikʉmi</para>
  <para style="r">
    <ref loc="MAT 25:14-30">Matayo 25:14-30</ref></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11" />Matungo naso antʉ aɨ akɨlɨ ategeeye ʉ Yesʉ, aɨ asɨganɨɨye kɨna itungo nɨlang’wi Itunda kʉtema lapika. Kʉnsoko aɨ ahumbeela kʉpika kʉ Yelusalemu, Yesʉ akaatambʉɨla mpyani ngɨɨza. <verse eid="LUK 19:11" /><verse number="12" style="v" sid="LUK 19:12" />Itɨ gwa akaatambʉɨla, “Aɨ ʉkolɨ mʉntʉ wandʉgʉ akɨtemi akatunga mʉhɨnzo akalongola kihɨɨ akʉli wande watemigwe ʉtemi, ʉʉ gwa watʉlye. <verse eid="LUK 19:12" /><verse number="13" style="v" sid="LUK 19:13" />Itɨ gwa naɨ wakɨlɨ kʉhega, akaitanga itʉmɨ akwe ikʉmi, ɨhi akaapa mpia nʉkʉaɨla, ‘Itʉmɨlɨ ʉsʉlʉja kʉpikɨɨla kʉnzɨɨzatulya.’<verse eid="LUK 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 19:14" />Ingɨ antʉ a mihɨɨ akwe aɨ amʉbɨpɨwe, nɨitɨ ga akaalagɨɨlya antʉ alongole kihɨɨ nʉinzʉtemigwa ende aatambʉɨle ɨantʉ ihɨɨ iyo nʉlongoe kɨna, ‘Shanga kʉmʉloilwe ʉmʉntʉ ʉyʉ wakʉteme ʉsese.’<verse eid="LUK 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 19:15" />“Nɨ itɨ ga mʉgolɨ ʉyʉ akatemigwa akatulya kitolakwe nʉkʉtula mʉtemi, sʉnga akaitangaa itʉmɨ akwe naɨʉapee mpia, ingɨ wahume kʉlɨnga atugisilye ʉli mʉʉsʉlʉja nʉao. <verse eid="LUK 19:15" /><verse number="16" style="v" sid="LUK 19:16" />Mitʉmɨ wang’wandyo akaza akʉmʉɨla, ‘Isekʉlʉ, ntugisilye ninzʉya ikʉmi kʉpuma miganda lɨng’wɨ nɨla mpia naɨ ʉmpee.’ <verse eid="LUK 19:16" /><verse number="17" style="v" sid="LUK 19:17" />Mʉgolɨ ʉyʉ akamʉɨla, ‘Songela mitʉmi nʉ mʉhʉɨɨli. Kʉnsoko wɨmʉhʉɨɨli kikani niniino, kʉʉɨka ʉtule wɨmʉkʉlʉ mʉisalɨ ikʉmi.’ <verse eid="LUK 19:17" /><verse number="18" style="v" sid="LUK 19:18" />Mitʉmɨ nʉakabɨɨlɨ akapembya nʉkʉlʉnga, ‘Isekʉlʉ, ntugisilye ninzʉya itaano kʉpuma mʉganda ʉng’wɨ nʉa mpia naɨ ʉmpee.’ <verse eid="LUK 19:18" /><verse number="19" style="v" sid="LUK 19:19" />Mʉgolɨ ʉyʉ akamʉɨla, ‘Songela, nʉewe ʉkʉtula wɨmʉkʉlʉ mʉisalɨ ɨtaano.’<verse eid="LUK 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 19:20" />“Mitʉmɨ mʉya akapembya, nʉkʉlʉnga, ‘Mpia ako naɨʉmpe sɨyɨ, aɨ nɨmɨtungile misongolo nʉkʉpiha iza. <verse eid="LUK 19:20" /><verse number="21" style="v" sid="LUK 19:21" />Kʉnsoko aɨ nogopile kɨna ʉewe shanga wɨkapwa. Ʉewe wɨholaa maintʉ nɨshanga ako, wɨogolaa nɨshanga ʉtemee.’ <verse eid="LUK 19:21" /><verse number="22" style="v" sid="LUK 19:22" />Mʉgolɨ ʉyʉ akamʉɨla, ‘ʉewe wimitʉmi nʉmʉbɨ kʉʉpɨsɨɨlya kʉntambʉ ako. Ʉnɨngile kɨna shanga nɨkapwa, nɨholaa maintʉ nɨshanga ane, nʉkʉogola nɨshanga ntemee. <verse eid="LUK 19:22" /><verse number="23" style="v" sid="LUK 19:23" />Kʉnɨkɨgwa shanga waapa ɨmpia ane kʉasʉlʉja? Ingɨ lʉhikʉ nɨkʉtulya nihole mpia ane nɨkɨtugisigwa.’<verse eid="LUK 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 19:24" />Ʉʉgwa akaatambʉɨla awa naɨakolɨ pang’wanso, ‘Mʉhegelyi ʉyʉitɨ impia mʉmʉpe ʉyʉ nʉtugisilye maganda ikʉmi.’ <verse eid="LUK 19:24" /><verse number="25" style="v" sid="LUK 19:25" />Antʉ awa akamʉtambʉɨla mʉgolɨ ʉyʉ ‘Isekʉlʉ mitʉmi ʉyʉ wakondilye kutugisa anga zizo maganda ikʉmi.’ <verse eid="LUK 19:25" /><verse number="26" style="v" sid="LUK 19:26" />Mʉgolɨ ʉyʉ akaasʉkɨɨlya, ‘Ʉyu nʉkete maintu ʉkongeeligwa. Ʉyu nimugila ukuhegeligwa ganiki nikiniino nʉkɨkete. <verse eid="LUK 19:26" /><verse number="27" style="v" sid="LUK 19:27" />Ingɨ, kʉalʉgʉ ane awa nɨshanga aɨ aloilwe ʉnene ntule nɨmʉtemi wao, aleti apa mʉabʉlage pantongeela ane”’<verse eid="LUK 19:27" /></para>
  <para style="s">Yesʉ ʉkingɨla kʉ Yelusalemu kʉngɨlɨgɨlɨ</para>
  <para style="r">
    <ref loc="MAT 21:1-11">Matayo 21:1-11</ref>; <ref loc="MRK 11:1-11">Maliko 11:1-11</ref>; <ref loc="JHN 12:12-19">Yohana 12:12-19</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28" />Yesʉ naɨ wakondya kʉtambʉla inkani izi, akaatongeela kʉlongola kʉ Yelusalemu. <verse eid="LUK 19:28" /><verse number="29" style="v" sid="LUK 19:29" />Naɨ ahumbeela kʉpika kʉ Betipage ni Betania, pakupi nʉlʉgʉlʉ nʉlitangwa mizeituni, akaalagɨɨlya amanyisigwa akwe abɨɨlɨ, <verse eid="LUK 19:29" /><verse number="30" style="v" sid="LUK 19:30" />akaaɨla, “Longoli kʉkɨsalɨ nɨkɨkolɨ pa ntongeela itʉ. Anga maakingɨla mʉkɨsalɨ, mʉkʉmʉhanga ng’waa ndogwe nʉakɨlɨ kʉmʉpakɨla nʉ mʉntʉ wɨhi. Mʉtungʉɨli mʉmʉlete apa. <verse eid="LUK 19:30" /><verse number="31" style="v" sid="LUK 19:31" />Mʉntʉ nʉkʉmʉkolya nɨkɨ mʉkʉmʉtungʉɨla ʉng’waa ndogwe, mʉɨli, ‘Isekʉlʉ ʉmʉtakile.”’<verse eid="LUK 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32" />Amanyisigwa awa naɨalagɨɨigwe akalongola akahanga anga ʉ Yesʉ naɨʉatambuie. <verse eid="LUK 19:32" /><verse number="33" style="v" sid="LUK 19:33" />Naɨ akʉmutungʉɨla ʉng’waa ndogwe, mukola ndogwe ankaakolya, “Nɨkɨ mʉkʉmʉtungʉɨla ʉng’waa ndogwe ʉyʉ?”<verse eid="LUK 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 19:34" />Akamʉsʉkɨɨlya, “Isekʉlʉ ʉmʉtakile.” <verse eid="LUK 19:34" /><verse number="35" style="v" sid="LUK 19:35" />Itʉ gwa, akamʉtungʉɨla ʉng’waa ndogwe ʉyʉ akamʉtaila ʉ Yesʉ. Akaila ingʉo ao mʉmʉgongo nʉa ng’waa ndogwe, akamʉpakilya ʉ Yesʉ mʉng’waa ndogwe. <verse eid="LUK 19:35" /><verse number="36" style="v" sid="LUK 19:36" />Yesʉ akalongoleka nʉmʉhɨnzo, ɨantʉ akaɨla ngʉo ao mʉnzɨla.<verse eid="LUK 19:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 19:37" />Nai wahumbeela kʉ Yelusalemu kʉ nzɨla nɨhulumʉkile mʉlʉgʉlʉ nʉla mizeituni, iumbɨ lɨhi nɨamanyisigwa akwe akandya kʉkʉa ngɨligɨlɨ nʉkitunta azemukʉmʉkʉlya Itunda kʉnsoko amɨʉkʉɨlwa ɨhi naɨ aʉine. <verse eid="LUK 19:37" /><verse number="38" style="v" sid="LUK 19:38" />Akatula lʉnga, “Itunda ʉmʉkembetile Mʉtemi ʉyʉ nʉzile kʉlina lang’wi Isekʉlʉ, migʉlya kigʉlʉ itule nʉʉgila minyomo nikʉlyo ʉko kigʉlya nangaluu.”<verse eid="LUK 19:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39" />Papo Apalisayo ang’wi naɨ akolɨ mʉmilʉndo nʉanso akamʉɨla ʉ Yesʉ, “Mʉmanyisi akɨlaje ɨamanyisigwa ako.”<verse eid="LUK 19:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 19:40" />Yesʉ akaatambʉɨla, “Kʉmʉɨli, anga awa anga akɨlaje, kʉlʉ kʉʉlʉ magwe aya itɨ akitʉnta.”<verse eid="LUK 19:40" /></para>
  <para style="s">Yesʉ ʉkʉkɨlɨɨla kɨsalɨ ka Yelusalemu</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41" />Nai wahumbeela nʉkʉkɨona kɨsalɨ ka Yelusalemu, Yesʉ akakɨlɨɨla, <verse eid="LUK 19:41" /><verse number="42" style="v" sid="LUK 19:42" />wazelʉnga, “Aza bahu ʉlinge lelo ɨyɨ makani nɨlɨletaa ʉgila minyomo. Ingɨ itungo ɨlɨ lɨpɨhilwe pamiho ako. <verse eid="LUK 19:42" /><verse number="43" style="v" sid="LUK 19:43" />Kʉnsoko apembilye mahikʉ alʉgʉ ako akʉʉkitɨɨla ikito, akʉʉgɨlɨnkɨɨlya nʉ kʉʉkʉa mpande yɨhi. <verse eid="LUK 19:43" /><verse number="44" style="v" sid="LUK 19:44" />Sʉnga akʉʉtaga pihɨ ʉewe palʉng’wɨ nɨantʉ nɨakolɨ mʉkatɨ amakiligo ako, shanga akʉlekeela igwe likoligo lako lɨsage migʉlya igwe lʉlya, kʉnsoko shanga aɨ ʉlingɨle itungo Itunda naɨ ʉzile kʉʉponya.”<verse eid="LUK 19:44" /></para>
  <para style="s">Yesʉ mʉnyʉmba ang’wi Itunda</para>
  <para style="r">
    <ref loc="MAT 21:12-17">Matayo 21:12-17</ref>; <ref loc="MRK 11:15-19">Maliko 11:15-19</ref>; <ref loc="JHN 2:13-22">Yohana 2:13-22</ref></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45" />Sʉnga ʉ Yesʉ akingɨla mʉnyʉmba ang’wi Itunda, akatula azunsa agʉlyi apume kʉnzi, <verse eid="LUK 19:45" /><verse number="46" style="v" sid="LUK 19:46" />wazelʉnga, “Yandɨkilwe, ‘Nyumba ane ɨkʉtula nyʉmba amalompi,’ ingɨ ʉnyenye mamɨtenda kʉtula ikʉlʉngu lakʉtankanɨla ii.”<verse eid="LUK 19:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 19:47" />Yesʉ akatula manyisa mahikʉ ɨhi mʉnyʉmba ang’wi Itunda. Ingɨ akʉlʉ aapolyi nɨamanyisi amalagɨɨlyo ang’wa Musa nɨatogeeli aantʉ akahiya kʉmʉbʉlaga, <verse eid="LUK 19:47" /><verse number="48" style="v" sid="LUK 19:48" />ingɨ aɨ agila nɨkakʉtenda, kʉnsoko antʉ ɨhi aɨ ɨmʉtegeelya kɨsa.<verse eid="LUK 19:48" /></para>
  <chapter eid="LUK 19" />
  <chapter number="20" style="c" sid="LUK 20" />
  <para style="s">Ikolyo nɨla ʉhumi wang’wa Yesʉ</para>
  <para style="r">
    <ref loc="MAT 21:23-27">Matayo 21:23-27</ref>; <ref loc="MRK 11:27-33">Maliko 11:27-33</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1" />Lʉhikʉ lʉng’wɨ Yesʉ aɨʉkʉmanyisa mʉnyʉmba ang’wi Itunda nʉkʉtanantya Nkani Nza, akʉlʉ aapolyi nɨamanyisi amalagɨɨlyo ang’wa Musa palʉng’wɨ nianyampala akamendeela, <verse eid="LUK 20:1" /><verse number="2" style="v" sid="LUK 20:2" />akamʉkolya, “Kʉɨle! Ʉkitʉma makani aya kʉ ʉhumi kɨɨ? Nyenyu nʉkʉpee ʉhumi ʉwʉ?”<verse eid="LUK 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 20:3" />Yesʉ akaasʉʉkɨlya, akaaɨla “Nʉnene kʉmʉkolya ikolyo, mʉmbɨle. <verse eid="LUK 20:3" /><verse number="4" style="v" sid="LUK 20:4" />Itɨɨ, ʉhumi nʉa kʉbadisa nʉang’wa Yohana aɨ ʉpumile kilunde kʉng’wi Itunda, ang’wi kʉ antʉ?”<verse eid="LUK 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5" />Ingɨ akitambʉlya itɨ, “Anga kʉlʉnge aɨʉpumile kilunde kʉng’wi Itunda, nʉanso ʉkʉʉkolya, ‘Nɨkɨ mikahita kʉmʉhʉɨɨla?’ <verse eid="LUK 20:5" /><verse number="6" style="v" sid="LUK 20:6" />Hangɨ anga kʉlʉnge aɨ ʉpumile kʉ antʉ, antʉ ɨhi nɨamolɨ apa akʉʉkʉa magwe, kʉnsoko antʉ ɨhi ahʉɨɨe kɨna ʉ Yohana aɨ mʉmanga wang’wi Itunda.” <verse eid="LUK 20:6" /><verse number="7" style="v" sid="LUK 20:7" />Itɨ gwa akamʉsʉkɨɨlya, “Shanga kʉlingɨle ʉʉhumi nʉanso aɨ ʉpumile pii.”<verse eid="LUK 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 20:8" />Yesʉ akaatambʉɨla, “Nʉnene ga shanga kʉmʉɨla kitʉma makani aya kʉ ʉhumi kɨɨ.”<verse eid="LUK 20:8" /></para>
  <para style="s">Mpyani agodisa mʉgʉnda</para>
  <para style="r">
    <ref loc="MAT 21:33-46">Matayo 21:33-46</ref>; <ref loc="MRK 12:1-12">Maliko 12:1-12</ref></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9" />Yesʉ akalongoleka kʉatambʉɨla ɨantʉ impyani ɨyɨ, “Mʉntʉ ʉng’wɨ aɨ ʉtemee mʉgʉnda wa mɨzabibʉ, akagodisa kʉ alɨmi, sʉnga nʉanso akalongola kihɨɨ akʉli, kʉng’wanso akikiɨ itungo ɨlɨpu. <verse eid="LUK 20:9" /><verse number="10" style="v" sid="LUK 20:10" />Matungo amaogola naɨapika, mʉntʉ ʉyʉ akamʉlagɨɨlya mitʉmi wakwe kʉalɨmi awa, wende wapegwe ikinda nɨla zabibu. Ingɨ agodisi awa akamʉkʉa, sʉnga akamʉsʉsha mɨkono mɨtilɨ. <verse eid="LUK 20:10" /><verse number="11" style="v" sid="LUK 20:11" />Mʉkola mʉgʉnda akamʉlagɨɨlya mitʉmi mʉngɨɨza, nʉyʉga akamʉkua nʉkʉmʉtendeela makani a mɨnyala, akamʉsʉsha mɨkono mitɨlɨ. <verse eid="LUK 20:11" /><verse number="12" style="v" sid="LUK 20:12" />Akamʉlagɨɨlya hangɨ mitʉmi nʉa kataatʉ, nʉyo akamʉlemaalya, nʉkʉmʉgʉma kʉnzi amʉgʉnda. <verse eid="LUK 20:12" /><verse number="13" style="v" sid="LUK 20:13" />Mʉkola mʉgʉnda ʉyʉ akasɨganɨɨlya. ‘Ntenda ʉli gwa? Kʉmʉlagɨɨlya ʉng’waane nɨnʉmʉloilwe, kwaala nʉanso akʉmʉkela.’ <verse eid="LUK 20:13" /><verse number="14" style="v" sid="LUK 20:14" />Ingɨ awa naɨ agodile naɨ amʉine ʉdu, akitambʉlya, ‘Ʉyʉ yʉyʉ mʉsali. Siali gwa, kʉmʉbʉlage isalo lakwe lɨkʉtula litʉ.’ <verse eid="LUK 20:14" /><verse number="15" style="v" sid="LUK 20:15" />Itɨ gwa, akamʉpumya kʉnzi amʉgʉnda nʉanso nʉa mɨzabibʉ, akamʉbʉlaga.</para>
  <para style="p" vid="LUK 20:15">Yesʉ akaakolya, “Mʉkola mʉgʉnda ʉyʉ ʉkʉatenda ʉlɨ agodisi awa? <verse eid="LUK 20:15" /><verse number="16" style="v" sid="LUK 20:16" />Ʉzile nʉkʉabʉlaga agodisi nɨanso waape agodisi angɨɨza mʉgʉnda ʉwʉ nʉa mɨzabibʉ.” Antʉ awa naɨ ija inkani izi, akalʉnga.</para>
  <para style="p" vid="LUK 20:16">“A, a! makani aya aleke kʉʉhanga ʉsese ga naya nɨiniino.”<verse eid="LUK 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 20:17" />Ingɨ ʉ Yesʉ akaagoza, akalʉnga,</para>
  <para style="q" vid="LUK 20:17">“Ndogoelyo alʉkani ʉlʉ nʉlʉandɨkilwe ntʉni gwa?</para>
  <para style="q" vid="LUK 20:17">Igwe azengi naɨ alɨhitile, itungo ɨlɨ lainaa igwe ikʉlʉ nɨlɨsanigwe kʉmpelo akitako kanyʉmba.’<verse eid="LUK 20:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="LUK 20:18" />Mʉntʉ wɨhi nʉkʉgwa migwe nɨlanso ʉkʉgalanʉka ʉtompo ʉtompo, hangɨ, mʉntʉ wɨhi nɨlʉkʉmʉgwɨla ʉkʉtʉlatɨɨligwa.”<verse eid="LUK 20:18" /></para>
  <para style="s">Ikolyo nɨla kʉlɨpa kodi kʉng’wa Kaisali</para>
  <para style="r">
    <ref loc="MAT 22:15-22">Matayo 22:15-22</ref>; <ref loc="MRK 12:13-17">Maliko 12:13-17</ref></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19" />Amanyisi amalagɨɨlyo ang’wa Musa nɨapolyo nɨakʉlʉ aɨ alɨngile kɨna impyani ɨyɨ aɨao, akaduma nsoko akʉmʉamba, akogopa kʉnsoko aantʉ. <verse eid="LUK 20:19" /><verse number="20" style="v" sid="LUK 20:20" />Itɨ gwa akatungɨla matungo nɨmaza kʉmʉamba. Akaalagɨɨlya adumɨɨla nkani nɨidayaa kɨna ahʉɨɨli, amʉgwilye ʉ Yesʉ kʉ makolyo, itɨ ahume kʉmʉamba nʉkʉmʉtwala kʉ akʉlʉ aselɨkalɨ a kɨlumɨ. <verse eid="LUK 20:20" /><verse number="21" style="v" sid="LUK 20:21" />Adumɨɨla nkani awa akamʉɨla ʉ Yesʉ, “Mʉmanyisi kʉlɨngile kɨna wɨtambʉla nʉkʉmanyisa makani atai, kʉlɨngile kɨna ʉewe wɨmʉgila ʉbagʉli, ʉewe wɨmanyisa ɨtai ɨmakani aya Itunda nʉtakile ʉsese kitʉme. <verse eid="LUK 20:21" /><verse number="22" style="v" sid="LUK 20:22" />Itɨ gwa, sikʉɨle malagɨɨlyo ang’wa Musa akʉgombilye kʉpumya kodi kʉ mʉtemi nʉ mʉkʉlʉ nʉa kʉ Loma.”<verse eid="LUK 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 20:23" />Yesʉ akalɨnga ʉhʉgu wao, akaaɨla, <verse eid="LUK 20:23" /><verse number="24" style="v" sid="LUK 20:24" />“Ndagɨɨli mpia, Itɨɨ, ikelʉ ɨlɨ nʉʉandɨkwa ʉwʉ wang’wa nyenyu?”<verse eid="LUK 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 20:25" />Nianso akamʉsʉkɨɨlya, “Ɨkete ikelʉ nʉʉandɨkwa wang’wa Kaisali, mʉtemi nʉ mʉkʉlʉ nʉa kʉ Loma.”</para>
  <para style="p" vid="LUK 20:25">Papo gwa Yesʉ akaaɨla, “Ʉʉgwa niyang’wa mʉtemi nʉmʉkʉlʉ nʉa kʉ Loma mʉpi maintʉ akwe, naya nang’wi Itunda mʉpi Itunda.”<verse eid="LUK 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 20:26" />Shanga akahuma kʉmʉamba pang’wanso pantongeela aatʉ, nɨitɨga akakilaga ihɨtwɨɨ aze akʉɨwe ʉsʉkɨɨlya wakwe.<verse eid="LUK 20:26" /></para>
  <para style="s">Makolyo a wiʉki</para>
  <para style="r">
    <ref loc="MAT 22:23-33">Matayo 22:23-33</ref>; <ref loc="MRK 12:18-27">Maliko 12:18-27</ref></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27" />Sʉnga Asadukayo nɨɨza antʉ shanga ahʉɨɨe kɨna ʉwiʉki nʉa antʉ ʉkolɨ, akaza kʉng’wa Yesʉ, nʉkʉmʉkolya. <verse eid="LUK 20:27" /><verse number="28" style="v" sid="LUK 20:28" />“Mʉmanyisi, ʉ Musa aɨ ʉkʉandɨkɨɨye kɨna, ‘anga mʉnyandʉgʉ nʉa mʉntʉ washe, waleke mʉsʉngʉ wakwe mʉgila anga ng’wana, ʉtakɨwe heu wakwe wamʉsale ʉmʉsʉngʉ ʉyʉ nʉshɨɨwe, nʉkʉmʉtugɨlya ʉmuluna wakwe ana.’ <verse eid="LUK 20:28" /><verse number="29" style="v" sid="LUK 20:29" />Ʉʉgwa aɨ akolɨ aluna mʉpungatɨ. Nʉa ng’wandyo aɨ ʉtinile mʉsʉngʉ, akasha shanga ulekile anga ng’wana. <verse eid="LUK 20:29" /><verse number="30" style="v" sid="LUK 20:30" />Mʉluna nʉa kabɨɨlɨ akamʉsala ʉmʉsʉngʉ ʉyʉ nʉshɨɨwe, nʉng’wenso akasha shanga ʉtugile, <verse eid="LUK 20:30" /><verse number="31" style="v" sid="LUK 20:31" />yɨkatula ʉʉ nʉ mʉluna nʉa kataatʉ. Makani akatula yayo ʉdu kʉ aluna ɨhi mʉpungatɨ, akasha ɨhi shanga atugile anga ana. <verse eid="LUK 20:31" /><verse number="32" style="v" sid="LUK 20:32" />Mpelo akwe mʉsʉngʉ ʉyʉ nʉng’wenso akasha. <verse eid="LUK 20:32" /><verse number="33" style="v" sid="LUK 20:33" />Itɨɨ, lʉhikʉ ashi nɨazee iuka, mʉsʉngʉ ʉyʉ ʉkʉtula wang’wa nyenyu? Kʉnsoko aluna awa ɨhi nɨ mʉpungatɨ aɨ amʉtinile.”<verse eid="LUK 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34" />Yesʉ akaasʉkɨɨlya, “Antʉ aʉnkumbigʉlʉ nʉitungɨlɨ ɨtɨnaa nʉkʉtɨnwa, <verse eid="LUK 20:34" /><verse number="35" style="v" sid="LUK 20:35" />ingɨ antʉ Itunda nʉɨka aona kɨna atakɨwe kʉiʉlwa nʉkishiɨ mʉ ʉnkʉmbigʉlʉ nʉʉpembilye, shanga akʉtɨna nʉ kʉtɨnwa. <verse eid="LUK 20:35" /><verse number="36" style="v" sid="LUK 20:36" />Nɨanso shanga ahumile kʉsha hangɨ, kʉnsoko akʉtula anga ɨa Malaɨka. Ingɨ ana ang’wi Itunda kʉnsoko Itunda waakendepa kishiɨ hangɨ. <verse eid="LUK 20:36" /><verse number="37" style="v" sid="LUK 20:37" />Ingɨ kʉlʉnga antʉ nɨakʉle akiʉka, Musa nʉng’wenso ʉkumʉʉe ikani ɨlɨ mʉʉandɨkwa kɨna ɨantʉ akiʉka. Apo naɨ ʉmʉtee Isekʉlʉ kɨna Itunda wang’wa Ibulahimu hangɨ Itunda wang’wa Isaki hangɨ Itunda wang’wa Yakobo apo pikʉndʉɨ naɨlɨkʉpya ʉmoto shanga lɨkazezigɨla. <verse eid="LUK 20:37" /><verse number="38" style="v" sid="LUK 20:38" />Ingɨ nʉanso shanga Itunda waashi, ingɨ Itunda waantʉ nɨapanga, kʉnsoko ɨhi nɨishiɨ kʉng’waakwe akete ʉpanga.”<verse eid="LUK 20:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 20:39" />Ang’wɨao mʉamanyisi amalagɨɨlyo ang’wa Musa akalʉnga, “Mʉmanyisi, ʉsʉkɨɨye iziza lʉkʉlʉ.” <verse eid="LUK 20:39" /><verse number="40" style="v" sid="LUK 20:40" />Ingɨ shanga aɨ agemile kʉmʉkolya makolyo mangɨɨza hangɨ.<verse eid="LUK 20:40" /></para>
  <para style="s">Kilisito ng’waa nyenyu</para>
  <para style="r">
    <ref loc="MAT 22:41-46">Matayo 22:41-46</ref>; <ref loc="MRK 12:35-37">Maliko 12:35-37</ref></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41" />Sʉnga ʉ Yesʉ akaakolya, “Ihumɨkile ʉlɨ antʉ alʉnge kʉna ʉ Kilisito nʉhoilwe ni Itunda watule ng’wana wang’wa Daudi? <verse eid="LUK 20:41" /><verse number="42" style="v" sid="LUK 20:42" />Kʉnsoko Daudi ʉng’wenso mʉmbugulu azabʉli ʉlɨɨye,</para>
  <para style="q" vid="LUK 20:42">‘Isekʉlʉ aɨ ʉmʉtambʉɨe Isekʉlʉ wane,</para>
  <para style="q" vid="LUK 20:42">Ikiɨ ipande lane nɨla ʉkʉlʉ nʉ ʉhumi<verse eid="LUK 20:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="LUK 20:43" />kʉpikɨɨla nɨaɨke ɨalʉgʉ ako atule ituntu nɨla kʉpambatɨlya mɨgʉlʉ ako.’<verse eid="LUK 20:43" /></para>
  <para style="m">
    <verse number="44" style="v" sid="LUK 20:44" />Anga itule ʉ Daudi aɨ ʉmitangaile nʉanso ‘Isekʉlʉ,’ yʉkʉtula ʉli ʉ Kilisito watule ng’wana wang’wa Daudi?”<verse eid="LUK 20:44" /></para>
  <para style="s">Hʉgʉki nɨamanyisi amalagɨɨlyo ang’wa Musa</para>
  <para style="r">
    <ref loc="MAT 23:1-36">Matayo 23:1-36</ref>; <ref loc="MRK 12:38-40">Maliko 12:38-40</ref></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45" />Antʉ ɨhi naɨ amʉtegeelya, Yesʉ akaatambʉɨla amanyisigwa akwe, <verse eid="LUK 20:45" /><verse number="46" style="v" sid="LUK 20:46" />“Hʉgʉki nɨamanyisi amalagɨɨlyo ang’wa Musa nɨɨlowa kikɨlakɨlya aze atugae mɨjʉlʉngʉ. Ɨlowaa kʉlamʉkigwa nɨantʉ mʉʉgalagalo, nʉkikaɨla matuntu akʉntongeela mʉnyʉmba nɨakʉtankanɨla Ayahudi, nʉkikaɨla matuntu aʉkʉligwa mʉmaloeelya. <verse eid="LUK 20:46" /><verse number="47" style="v" sid="LUK 20:47" />Ɨhola insao niya asʉngʉ nɨashɨɨwe nɨagoha ao, kʉnʉ azidaya kɨna akende azelompa ikʉlʉ. Antʉ anga awa akʉpisiɨlɨgwa ikʉlʉ nangalʉʉ.”<verse eid="LUK 20:47" /></para>
  <chapter eid="LUK 20" />
  <chapter number="21" style="c" sid="LUK 21" />
  <para style="s">Isongelyo nɨla mʉsʉngʉ nʉshɨɨwe nʉ mʉgoha</para>
  <para style="r">
    <ref loc="MRK 12:41-44">Maliko 12:41-44</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1" />Yesʉ akakendegeela iza, akaaona ɨagolɨ akʉɨkɨla masongelyo ao mʉkɨseme kamasongelyo Mʉnyʉmba ang’wi Itunda, <verse eid="LUK 21:1" /><verse number="2" style="v" sid="LUK 21:2" />akamʉona nʉ mʉsʉngʉ ʉng’wɨ mʉʉla nʉshɨɨwe nʉmʉgoha ʉkʉɨkɨla mʉmo isongelyo mʉkɨseme senti ibɨɨlɨ. <verse eid="LUK 21:2" /><verse number="3" style="v" sid="LUK 21:3" />Itɨ gwa Yesʉ akaaɨla, “Kʉlʉ kʉʉlʉ kʉmʉɨla, mʉsʉngʉ ʉyʉ nɨ mʉʉla hangɨ nʉshɨɨwe nʉmʉgoha, ʉɨkɨe yɨdʉ mʉkɨseme ka masongelyo kʉkɨla antʉ ɨhi nɨaɨkɨe. <verse eid="LUK 21:3" /><verse number="4" style="v" sid="LUK 21:4" />Kʉnsoko antʉ ang’wi apumilye isongelyo kʉpuma mʉʉsigo nʉasailo niyao, ingɨ ʉmʉsʉngʉ ʉyʉ kʉnsoko aɨmʉʉla ʉpumilye yɨhi niyakʉmʉaɨɨlya mʉlikalo lakwe.”<verse eid="LUK 21:4" /></para>
  <para style="s">Mʉloto nʉa kʉkumʉlwa kʉ Nyʉmba ang’wi Itunda</para>
  <para style="r">
    <ref loc="MAT 24:1-2">Matayo 24:1-2</ref>; <ref loc="MRK 13:1-2">Maliko 13:1-2</ref></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5" />Amanyisigwa ang’wi akatula mɨtambʉla Nyʉmba ang’wi Itunda, kʉitɨ nɨlɨzengilwe kʉmagwe ansaɨlo nkulu naɨanoneeye ɨ Nyʉmba ang’wi Itunda, palʉng’wɨ nɨmasongelyo naɨ apumigwe kʉng’wi Itunda. Yesʉ akalʉnga, <verse eid="LUK 21:5" /><verse number="6" style="v" sid="LUK 21:6" />“Aya itɨ ɨhi nɨmʉkʉmaona apa, mahikʉ akʉpika yɨkʉtula kʉtilɨ igwe nɨlɨkasagɨɨla migʉlya alʉlya, maintʉ ɨhi akʉkumʉlwa nʉ kʉgʉng’wa kʉnzi.”<verse eid="LUK 21:6" /></para>
  <para style="s">Yesʉ ʉkʉtambʉla ilɨngasɨɨlyo ka mahikʉ ampelo</para>
  <para style="r">
    <ref loc="MAT 24:3-14">Matayo 24:3-14</ref>; <ref loc="MRK 13:3-13">Maliko 13:3-13</ref></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 21:7" />Ʉʉgwa antʉ akamʉkolya ʉ Yesʉ, “Mʉmanyisi, Makani aya nʉkumatambʉla nali akʉpumɨla, kɨlɨngasiilyo kɨɨ nikikʉlagɨɨla kɨna yahumbeela kʉpumɨla ɨmakani nanso?”<verse eid="LUK 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 21:8" />Yesʉ akaasʉkɨɨlya, “Hʉgʉki mʉleke kʉkongwa. Kʉnsoko antʉ ɨdʉ akʉpembya kʉlina lane, azidaya kɨna ‘Ʉnene nɨ Kilisito,’ mʉlɨnge kɨna, ‘matungo nanso ahumbeela,’ ingɨ Ʉnyenye leki kʉatyati nɨanso. <verse eid="LUK 21:8" /><verse number="9" style="v" sid="LUK 21:9" />Ʉʉgwa anga mije inkani niyambita nʉminyomo, leki kogopi, kʉnsoko maintʉ nanso atakɨwe apumile hanza, ʉgeelo nʉa maintʉ ɨhi ʉkʉtula ʉkɨlɨ.”<verse eid="LUK 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 21:10" />Sʉnga Yesʉ akalongoleka kʉtambʉla, “Antʉ ihɨɨ ɨng’wɨ akʉlongola kikʉa nɨantʉ ihɨɨ nzʉya, hangɨ antʉ aʉtemi ʉng’wɨ akʉlongola kikʉa nɨantʉ aʉtemi ʉya. <verse eid="LUK 21:10" /><verse number="11" style="v" sid="LUK 21:11" />Yʉkʉtula nɨmɨtentemo mɨkʉlʉ mihɨɨ, yɨkigela nzala nɨmalwae akilekeelya mʉ mahɨɨ ɨhi. Yikʉtula ɨkolɨ mɨʉkʉɨlwa akogopya niilɨngasiilyo ikʉlʉ kʉpumɨɨla kilunde. <verse eid="LUK 21:11" /><verse number="12" style="v" sid="LUK 21:12" />Ingɨ azeakɨlɨ kʉpumɨla aya ɨhi, akʉmʉamba, akʉmaja akʉmutwala mʉlamʉlwe mʉnyʉmba niyakʉtankanɨla Ayahudi, akʉmʉtunga mʉkadulumu, hangɨ akʉmʉtwala kʉatemi nɨakʉlʉ kʉnsoko mʉnihʉɨɨe ʉnene, <verse eid="LUK 21:12" /><verse number="13" style="v" sid="LUK 21:13" />ingɨ kʉng’waanyu ʉkʉtula ʉkʉɨɨli wanyu kʉng’waao. <verse eid="LUK 21:13" /><verse number="14" style="v" sid="LUK 21:14" />Ingɨ leki kogopi, nʉkʉsigɨɨla mʉkʉtambʉla ʉlɨ, <verse eid="LUK 21:14" /><verse number="15" style="v" sid="LUK 21:15" />kʉnsoko ʉnene kʉmʉlɨngasa inkani niyamahala niyakʉtambʉla, ingɨ alʉgʉ anyu shanga akʉmʉlemya nʉkʉmʉkʉnguma ʉnyenye. <verse eid="LUK 21:15" /><verse number="16" style="v" sid="LUK 21:16" />Ʉnyenye mʉkʉpɨlʉkwa nɨaleli anyu nɨaluna anyu nɨanyandʉgʉ anyu nɨahʉmba ɨanyu, nɨang’wi anyu mʉkʉbʉlagwa. <verse eid="LUK 21:16" /><verse number="17" style="v" sid="LUK 21:17" />Antʉ ɨhi akʉmʉbɨpɨlwa kʉnsoko mʉnihʉɨɨe nene. <verse eid="LUK 21:17" /><verse number="18" style="v" sid="LUK 21:18" />Ingɨ Itunda ʉkʉmʉsʉnja shanga mʉkʉhangwa nʉʉbi wɨhi mʉlikalo lanyu, hangɨ nkolo yanyu yɨkʉtula ikolɨ iza ɨkalɨ na kalɨ. <verse eid="LUK 21:18" /><verse number="19" style="v" sid="LUK 21:19" />Ingɨ ʉyo nʉkʉgimya, ʉkʉtula nʉ ʉpanga nʉa kalɨ na kalɨ.<verse eid="LUK 21:19" /></para>
  <para style="s">Mʉloto nʉa kʉkumʉlwa kɨsalɨ ka Yelusalemu</para>
  <para style="r">
    <ref loc="MAT 24:15-21">Matayo 24:15-21</ref>; <ref loc="MRK 13:14-19">Maliko 13:14-19</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20" />“Anga mʉone kɨsalɨ ka Yelusalemu kapɨlɨmikɨɨligwa nɨanyambita aalʉgʉ, ʉʉgwa mʉlɨnge kɨna mahikʉ akʉkumʉlwa ɨkɨsalɨ nɨkanso apikaa. <verse eid="LUK 21:20" /><verse number="21" style="v" sid="LUK 21:21" />Pang’wanso ɨantʉ nɨamolɨ kʉ Yʉdea amankɨɨle mʉmalʉgʉlʉ, nawo nɨamolɨ mʉkɨsalɨ ka Yelusalemu apume kʉnzi, nawo nɨamolɨ kʉmɨgʉnda aleke kingɨla mʉkɨsalɨ. <verse eid="LUK 21:21" /><verse number="22" style="v" sid="LUK 21:22" />Kʉnsoko mahikʉ nanso akʉtula aʉpɨsɨɨlya, ingɨ kʉkondanɨɨlya ɨhi naandɨkilwe. <verse eid="LUK 21:22" /><verse number="23" style="v" sid="LUK 21:23" />Akaga ikʉlʉ asʉngʉ nɨalito nawa nɨakonsha mʉmahikʉ nanso. Kʉnsoko yʉkʉtula nʉlwago lʉkʉlʉ mihɨɨ ɨhi, nikuo lang’wi Itunda lɨkʉahanga ɨantʉ ihɨɨ a Yʉdea. <verse eid="LUK 21:23" /><verse number="24" style="v" sid="LUK 21:24" />Nɨang’wɨ akʉbʉlagwa kʉtemangwa apanga nɨang’wɨ akʉholwa ʉtʉʉng’wa mʉ mahɨɨ ɨhi, kɨsalɨ ka Yelusalemu kɨkʉteng’wa nɨantʉ nɨshanga Ayahudi, kʉpikɨɨla itugo nɨla antʉ nɨanso kʉtema nɨlɨkʉhila.<verse eid="LUK 21:24" /></para>
  <para style="s">Kʉtulya kʉ Ng’waa Mʉntʉ</para>
  <para style="r">
    <ref loc="MAT 24:29-31">Matayo 24:29-31</ref>; <ref loc="MRK 13:24-27">Maliko 13:24-27</ref></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25" />“Yʉkʉtula niilɨngasɨɨlyo mʉlyoa nʉ mʉng’weli nʉ mʉnzota. Yʉkʉtula nʉmʉlulumo nɨmaɨngʉ mʉlʉzɨ nʉlʉkʉlʉ, nɨantʉ a mihɨɨ ɨdʉ akʉnyong’wa nʉkogopa. <verse eid="LUK 21:25" /><verse number="26" style="v" sid="LUK 21:26" />Antʉ akʉkatapa kʉnsoko awoa, aze asʉmbɨɨye ɨmakani nakʉʉhanga ʉʉnkumbigʉlʉ, kʉnsoko ngulu nia kilunde yʉkʉhingɨsigwa. <verse eid="LUK 21:26" /><verse number="27" style="v" sid="LUK 21:27" />Mʉmatungo nanso mʉkʉmona ʉnene Ng’waa Mʉntʉ mpembilye mʉmalunde, nɨze nkete ngulu nʉʉmɨlɨgɨntu ʉkʉlʉ. <verse eid="LUK 21:27" /><verse number="28" style="v" sid="LUK 21:28" />Matungo makani aya nakandya kʉpumɨla, imɨki ize mikaminyangile, kʉnsoko ʉponyi wanyu wahumbeela.”<verse eid="LUK 21:28" /></para>
  <para style="s">Ʉmanyisi nʉʉpumɨɨe mʉkʉyʉ</para>
  <para style="r">
    <ref loc="MAT 24:32-35">Matayo 24:32-35</ref>; <ref loc="MRK 13:28-31">Maliko 13:28-31</ref></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29" />Sʉnga Yesʉ akaaɨla ɨamanyisigwa akwe mpyani ɨyɨ, “Siʉgozi kɨsa mʉkʉyʉ nɨmɨtɨ mɨngɨɨza ɨhi. <verse eid="LUK 21:29" /><verse number="30" style="v" sid="LUK 21:30" />Anga mʉone andya kʉtegeta matʉtʉ, mɨlɨnga kɨna ɨhongola apika. <verse eid="LUK 21:30" /><verse number="31" style="v" sid="LUK 21:31" />Itɨ ʉʉ anga mandye kʉona ɨmakani aya akigela, mʉkʉlɨnga kɨna ʉtemi wang’wi Itunda wahumbeela.<verse eid="LUK 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 21:32" />“Kʉmʉɨli ɨtai, antʉ nɨiele nɨakʉona makani aya shanga akʉkɨla ihɨ kʉpikɨɨla ɨmakani aya ɨhi apumɨle. <verse eid="LUK 21:32" /><verse number="33" style="v" sid="LUK 21:33" />Lʉhikʉ lʉng’wɨ Igʉlʉ nihɨɨ shanga yʉkigela hangɨ, ingɨ nkani yane yʉkʉtula ikolɨ mahikʉ ɨhi.<verse eid="LUK 21:33" /></para>
  <para style="s">Ihambi matungo ɨhi</para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34" />“Hʉgʉki, nkolo yanyu ileke kʉlemeeligwa nʉ ʉlaku ang’wɨ ʉgala ntʉli ang’wɨ ʉnyomeki nʉa likalo ʉlʉ. Shanga ʉʉ, lʉhikʉ ʉlʉ lʉleke kʉmʉhanga ʉnyenye shanga ɨze mihambile, anga ʉmʉmpeto nʉɨambisa. <verse eid="LUK 21:34" /><verse number="35" style="v" sid="LUK 21:35" />Itɨ ʉʉ lʉhikʉ nʉlanso lʉkʉazɨɨla antʉ ɨhi nɨishiɨ mihɨɨ ɨhi. <verse eid="LUK 21:35" /><verse number="36" style="v" sid="LUK 21:36" />Hʉgʉki nʉkʉlompa mahikʉ ɨhi mʉhume kʉlija ingulu niyakʉkɨla iza mʉmakani ɨhi nɨɨkapumɨla, mʉhume kimɨka pantongeela a Ng’waa Mʉntʉ.”<verse eid="LUK 21:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37" />Mahikʉ ɨhi ʉng’ʉng’wɨ, Yesʉ aɨwɨmanyisa Mʉnyʉmba ang’wi Itunda, nɨ mpɨndɨ aɨ wɨlongolaa mʉlʉgʉlʉ nʉa mɨzeituni aɨwɨtula kʉko ʉtikʉ ga. <verse eid="LUK 21:37" /><verse number="38" style="v" sid="LUK 21:38" />Anga wele ʉdu aɨwɨzaa Mʉnyʉmba ang’wi Itunda, nɨantʉ ɨhi aɨiandɨɨla akalongola kʉmʉtegeelya.<verse eid="LUK 21:38" /></para>
  <chapter eid="LUK 21" />
  <chapter number="22" style="c" sid="LUK 22" />
  <para style="s">Masigo akʉmʉbʉlaga ʉ Yesʉ</para>
  <para style="r">
    <ref loc="MAT 26:1-5">Matayo 26:1-5</ref>; <ref loc="MRK 14:1-2">Maliko 14:1-2</ref>; <ref loc="JHN 11:45-53">Yohana 11:45-53</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1" />Lʉhikʉ nʉliloeelya, nʉla kʉlya mɨkate nɨshanga ɨgahɨigwe, nʉlitangwa pasaka aɨ lahumbeela. <verse eid="LUK 22:1" /><verse number="2" style="v" sid="LUK 22:2" />Apolyi nɨakʉlʉ nɨamanyisi amalagɨɨlyo ang’wa Musa akatula duma nzɨla akʉmʉbʉlaga ʉ Yesʉ, aɨituma nɨlanso kʉ kɨnkunku kʉsoko aɨ aogopile antʉ.<verse eid="LUK 22:2" /></para>
  <para style="s">Yʉda ʉkʉgomba kʉmʉsʉɨpa ʉ Yesʉ</para>
  <para style="r">
    <ref loc="MAT 26:14-16">Matayo 26:14-16</ref>; <ref loc="MRK 14:10-11">Maliko 14:10-11</ref></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 22:3" />Papo gwa ʉ Shetani akamingɨɨla ʉ Yʉda mʉntʉ kʉpuma kʉ Kaliote, ʉng’wɨao mʉ itʉmɨ ikʉmi na abɨɨlɨ nɨang’wa Yesʉ. <verse eid="LUK 22:3" /><verse number="4" style="v" sid="LUK 22:4" />Yʉda akalongola akigombya nɨapolyi nɨakʉlʉ nɨasʉnja Nyʉmba ang’wi Itunda itɨ nʉɨkamʉsʉɨpa ʉ Yesʉ. <verse eid="LUK 22:4" /><verse number="5" style="v" sid="LUK 22:5" />Antʉ awa akiloa ikʉlʉ, akigombya kʉmʉpa mpia. <verse eid="LUK 22:5" /><verse number="6" style="v" sid="LUK 22:6" />Yʉda akagomba, akatula duma lyoma niza nɨla kʉmʉsʉɨpa ʉ Yesʉ itungo nʉɨmʉtilɨ mʉmilʉndo nʉa antʉ.<verse eid="LUK 22:6" /></para>
  <para style="s">Pasaka a ng’wisho nang’wa Yesʉ</para>
  <para style="r">
    <ref loc="MAT 26:17-25">Matayo 26:17-25</ref>; <ref loc="MRK 14:12-21">Maliko 14:12-21</ref>; <ref loc="JHN 13:21-30">Yohana 13:21-30</ref></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7" />Papo gwa naɨlapika Iloeelya nʉla kʉlya Mɨkate nɨshanga igahɨigwe. Lʉhikʉ nʉlanso lʉlo nʉla kʉsɨnzwa ʉ ng’waa nkolo nʉa pasaka. <verse eid="LUK 22:7" /><verse number="8" style="v" sid="LUK 22:8" />Yesʉ akaalagɨɨlya ɨa Petelo nʉ Yohana, wazeaɨla, “Longoli mʉnoneelye ndya niya pasaka kʉlye.”<verse eid="LUK 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 22:9" />Petelo nʉ Yohana akamʉkolya, “Ʉloilwe kʉnoneelelye pɨɨ?”<verse eid="LUK 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 22:10" />Yesʉ akaaɨla, “Tegeelyi! Anga mingɨle mʉkɨsalɨ, mʉkʉmʉpantɨka mʉntʉ ʉkenkile ntʉnda amazɨ. Mʉtyati mingɨle mʉnyʉmba nʉɨkingɨla. <verse eid="LUK 22:10" /><verse number="11" style="v" sid="LUK 22:11" />Mʉɨli ʉ mʉkola nyʉmba nanso, ‘Mʉmanyisi ʉkʉkolya kɨkolɨ pɨɨ kɨanda mʉnikalɨla ɨpasaka palʉng’wɨ nɨamanyisigwa ane?’ <verse eid="LUK 22:11" /><verse number="12" style="v" sid="LUK 22:12" />Mʉntʉ nʉanso ʉkʉmʉlagɨɨla kɨanda kɨkʉlʉ migolopwa. Noneelelyi mʉmo.”<verse eid="LUK 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 22:13" />Ʉʉgwa, akalongola akahanga maintʉ ɨhi atʉile anga naza atambʉɨwe nʉ Yesʉ, akanoneelya ɨpasaka.<verse eid="LUK 22:13" /></para>
  <para style="s">Lʉdya lang’wi Isekʉlʉ</para>
  <para style="r">
    <ref loc="MAT 26:26-30">Matayo 26:26-30</ref>; <ref loc="MRK 14:22-26">Maliko 14:22-26</ref>; <ref loc="1CO 11:23-25">1 Akolinto 11:23-25</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14" />Itungo lakʉlya naɨlapika ʉ Yesʉ akikiɨ walye ndya palʉng’wɨ nɨ itumi akwe. <verse eid="LUK 22:14" /><verse number="15" style="v" sid="LUK 22:15" />Akaaɨla, “Nkete nsʉla ndye ɨpasaka palʉng’wɨ nʉnyenye nɨnkɨlɨ kagigwa. <verse eid="LUK 22:15" /><verse number="16" style="v" sid="LUK 22:16" />Kʉnsoko kʉmʉɨla, shanga kʉlya hangɨ pasaka kʉpikɨɨla Itunda nʉʉkʉtula waakomola antʉ akwe nʉkʉatema.”<verse eid="LUK 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 22:17" />Sʉnga naɨ wahola kɨkombe nɨkɨkete dibai, akamʉlʉmbɨɨlya Itunda, akalʉnga, “Holi ɨkɨkombe mʉumbane mɨhi. <verse eid="LUK 22:17" /><verse number="18" style="v" sid="LUK 22:18" />Kʉnsoko kʉmʉɨli, shanga kʉmɨng’wa hangɨ ɨdibai a nkalɨ a zabibʉ kʉpikɨɨla ʉtemi wang’wi Itunda nʉʉzɨɨza.” <verse eid="LUK 22:18" /><verse number="19" style="v" sid="LUK 22:19" />Sʉnga Yesʉ akahola mʉkate, akamʉlʉmba Itunda, akaʉega, akaapa itʉmi wazelʉnga, “Ʉwʉ ingɨ mʉɨlɨ wane nʉʉpumigwe kʉnsoko anyu. Tendi ʉʉ mʉze mʉnkɨmbʉkile.” <verse eid="LUK 22:19" /><verse number="20" style="v" sid="LUK 22:20" />Naɨ akondya kʉlya akatenda ʉʉ akahola kikombe kadibai, wazelʉnga, “Dibai ɨyɨ mʉkikombe ingɨ ilago nipya nɨlɨkitʉng’wa mʉsakami ane nɨkʉhunʉka kʉnsoko anyu.<verse eid="LUK 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 22:21" />“Ingɨ mʉntʉ nʉkʉnsuɨpa kʉʉlɨzania papa. <verse eid="LUK 22:21" /><verse number="22" style="v" sid="LUK 22:22" />Tai ʉnene Ng’wana Mʉntʉ naakenda bʉlagwa anga naɨ ilagɨigwe, ingɨ ʉkaga mʉntʉ nʉkʉnsuɨpa.”<verse eid="LUK 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 22:23" />Akatʉlikolya enso kʉ enso, nyenyu nʉɨkitʉma ikani nɨlanso.<verse eid="LUK 22:23" /></para>
  <para style="s">Kikʉngʉmɨla ʉkʉlʉ</para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24" />Ʉkigela wikʉngumi mʉitʉmɨ kɨna nyenyu mʉkatɨao nʉsɨgɨɨwe kʉtula mʉkʉlʉ kʉkɨla ɨaʉya. <verse eid="LUK 22:24" /><verse number="25" style="v" sid="LUK 22:25" />Yesʉ akaaɨla, “Atemi a mihɨɨ ɨtemaa ɨantʉ ao kʉngulu, nienso ɨlowaa kitangwa, ‘Aguna antʉ.’ <verse eid="LUK 22:25" /><verse number="26" style="v" sid="LUK 22:26" />Ingi ʉnyenye ileke kʉtula itɨ, itɨ gwa ʉyʉ nʉmʉkʉlʉ wanyu, ʉtakɨwe watule mʉniino kʉkɨla mɨhi, nʉyʉ nɨmʉtongeeli ʉtakɨwe watule anga mʉtʉʉng’wa. <verse eid="LUK 22:26" /><verse number="27" style="v" sid="LUK 22:27" />Kʉnsoko, nyenyu nɨmʉkʉlʉ, itɨɨ, ʉyʉ nʉikiɨ pihɨ walye ndya, ang’wi ʉyʉ nʉkʉatengela antʉ indya? Shanga ʉyʉne nʉikiɨ pandya walye! Nɨitɨ ga, ʉnene molɨ palʉng’wɨ nʉnyenye anga nɨmʉtugwa.<verse eid="LUK 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 22:28" />“Ʉnyenye mʉsagile nʉnene matungo ɨhi namageng’wa ane, <verse eid="LUK 22:28" /><verse number="29" style="v" sid="LUK 22:29" />anga itɨ ʉ Tataane nʉntemilye ʉʉtemi, itɨ ʉʉgwa nʉnene kʉmʉtemya ʉnyenye ʉtemi. <verse eid="LUK 22:29" /><verse number="30" style="v" sid="LUK 22:30" />Mʉhume kʉlya nʉkʉng’wa nʉnene mʉʉtemi wane, nʉ kikiɨ mʉ matuntu akɨtemi kʉilamʉla ndʉgʉ ikʉmi na ibɨɨlɨ nia Aisilaeli.<verse eid="LUK 22:30" /></para>
  <para style="s">Yesʉ ʉkʉtambʉla kɨna ʉ Petelo ʉkʉmʉhita</para>
  <para style="r">
    <ref loc="MAT 26:31-35">Matayo 26:31-35</ref>; <ref loc="MRK 14:27-31">Maliko 14:27-31</ref>; <ref loc="JHN 13:36-38">Yohana 13:36-38</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31" />Yesʉ akalʉnga, “Ʉewe Simoni! Simoni! Tegeelya! Shetani walompa wamʉpenente ʉnyenye anga mʉntʉ nʉɨpenenta ɨngano. <verse eid="LUK 22:31" /><verse number="32" style="v" sid="LUK 22:32" />Ingi ʉnene nʉkʉlompee ʉewe ʉhʉɨɨlɨ wako ʉleke kʉkepa. Nʉewe anga ʉnsʉkile, ʉakamatɨshe anyandʉgʉ ako.”<verse eid="LUK 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 22:33" />Petelo akamʉsʉkɨɨlya, “Isekʉlʉ, ʉnene nihambile kendania nʉewe mʉkadulumu, hangɨ ga nʉkusha.”<verse eid="LUK 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 22:34" />Yesʉ akamʉsʉkɨɨlya, “Petelo kʉʉila, ʉtikʉ nʉa lelo ɨyɨ nsambalʉme ɨze ɨkɨlɨ kʉkʉnkʉla, ʉewe ʉkʉtula wanihita nkʉa itaatʉ kɨna shanga ʉnɨngile.”<verse eid="LUK 22:34" /></para>
  <para style="s">Ihambi kʉ ʉlʉgʉ</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 22:35" />Sʉnga ʉ Yesʉ akaakolya amanyisigwa akwe, “Apo naza nʉmʉtakile mʉlongole ɨzemɨagila anga nkapu ang’wɨ mbogoshi ampia ang’wɨ makwasa, aza mʉʉɨwe kɨntʉne?”</para>
  <para style="p" vid="LUK 22:35">Akamʉsʉkɨɨlya, “Shanga aza kʉʉɨwe”<verse eid="LUK 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 22:36" />Yesʉ akaaɨla, “Itungo ɨlɨ, ʉyʉ nʉkete mbogoshi ampia nʉahole, nʉyʉ nʉkete nkapu nʉahole. Nʉ mʉntʉ wɨhi nɨmʉgila panga, nʉagʉlye mʉjʉlʉngʉ wakwe wagʉle panga ɨng’wɨ. <verse eid="LUK 22:36" /><verse number="37" style="v" sid="LUK 22:37" />Kʉnsoko yandɨkilwe mʉ Nkani Nza niyang’wɨ Itunda, ‘Aɨ ʉɨkilwe iumbɨ lɨng’wɨ nɨagazi,’ ʉnene kʉmʉɨla ikani ɨlɨ lɨtakɨwe kʉkondanɨɨla kʉng’waane. Nɨnandɨkɨwe ʉnene atakɨwe kʉkondanɨɨla.”<verse eid="LUK 22:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 22:38" />Amanyisigwa akalʉnga, “Isekʉlʉ goza apaitɨ ɨkolɨ panga ibɨɨlɨ.”</para>
  <para style="p" vid="LUK 22:38">Yesʉ akalʉnga, “Yakonda.”<verse eid="LUK 22:38" /></para>
  <para style="s">Yesʉ ʉkʉlompa mʉlʉgʉlʉ nʉla Mɨzeituni</para>
  <para style="r">
    <ref loc="MAT 26:36-46">Matayo 26:36-46</ref>; <ref loc="MRK 14:32-42">Maliko 14:32-42</ref></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39" />Papo gwa ʉ Yesʉ akapuma, akalongola mʉlʉgʉlʉ nʉla Mɨzeituni, anga naɨ ntendo akwe, amanyisigwa akwe akamʉtyata. <verse eid="LUK 22:39" /><verse number="40" style="v" sid="LUK 22:40" />Naɨ wapika kʉng’wanso akaaɨla, “Lompi mʉleke kingɨla mʉ mageng’wa.”<verse eid="LUK 22:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 22:41" />Sʉnga akaaleka akalongola kʉli iniino mʉntʉ nʉhumile kʉgʉma igwe, akatugama akalompa. <verse eid="LUK 22:41" /><verse number="42" style="v" sid="LUK 22:42" />“Ʉewe Tata, anga ʉloeligwe, lwago ʉlʉ lʉleke kʉnihanga, shanga kʉʉlowa wane, ingɨ ʉlowa wako wʉwo ʉtʉlike.” <verse eid="LUK 22:42" /><verse number="43" style="v" sid="LUK 22:43" />Papo Malaɨka akamʉziila nʉkʉmʉkomya nkolo. <verse eid="LUK 22:43" /><verse number="44" style="v" sid="LUK 22:44" />Yesʉ naɨ ʉkolɨ mʉʉwai ʉkʉlʉ, akalongoleka kʉlompa, akatʉla puma litutu nʉlɨhangaa sakami lɨkatonya pihɨ.<verse eid="LUK 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45" />Naɨ wakondya kʉlompa, akaasʉkɨla amanyisigwa akwe, akaahanga alala tʉlo kʉnsoko aɨ ahʉsha. <verse eid="LUK 22:45" /><verse number="46" style="v" sid="LUK 22:46" />Akaatambʉɨla, “Malala nɨkɨ? Ʉki mʉlompe, mʉleke kingɨla mʉmageng’wa.”<verse eid="LUK 22:46" /></para>
  <para style="s">Yesʉ ʉkʉambwa</para>
  <para style="r">
    <ref loc="MAT 26:47-56">Matayo 26:47-56</ref>; <ref loc="MRK 14:43-50">Maliko 14:43-50</ref>; <ref loc="JHN 18:3-11">Yohana 18:3-11</ref></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47" />Naɨ wakɨlɨ ʉkʉligitya nɨamanyisigwa akwe, iumbɨ laantʉ lɨkapika lɨtongeewe nʉ Yʉda, ʉng’wɨ mʉtʉmɨ ikʉmi na abɨɨlɨ nɨang’wa Yesʉ. Yʉda akalongola wamʉlamʉshe nʉkʉmʉlʉngɨla ʉ Yesʉ. <verse eid="LUK 22:47" /><verse number="48" style="v" sid="LUK 22:48" />Yesʉ ingɨ akamʉɨla, “Yʉda. Itɨɨ, ʉkʉmʉsʉɨpa ʉ Ng’waa Mʉntʉ kʉmʉlʉngɨla?”<verse eid="LUK 22:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 22:49" />Amanyisigwa akwe naɨ amaine nanso akalʉnga, “Isekʉlʉ kʉateme na panga yitʉne?” <verse eid="LUK 22:49" /><verse number="50" style="v" sid="LUK 22:50" />Ʉng’wi ao akamʉteme kʉtwɨ nʉipande nɨla kɨgoha, ʉng’wɨ nʉa mitʉmi nʉa mʉpolyi nʉ mʉkʉlʉ.<verse eid="LUK 22:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 22:51" />Papo ʉ Yesʉ akalʉnga, “Leka. Yakonda.” Akamʉgutya ʉkʉtwɨ wa mʉntʉ ʉyʉ akamʉponia.<verse eid="LUK 22:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 22:52" />Sʉnga ʉ Yesʉ akaatambʉɨla apolyo nɨakʉlʉ, nɨakʉlʉ aasʉnja nyʉmba ang’wi Itunda nɨanyampala naɨazile kʉmʉamba. “Itɨɨ, mʉpembilye nipanga niidunkʉli kʉmamba anga kɨna ʉnene nɨmʉgazi? <verse eid="LUK 22:52" /><verse number="53" style="v" sid="LUK 22:53" />Mahikʉ ɨhi naɨkolɨ nʉnyenye mitando la Nyʉmba ang’wi Itunda shanga aɨ mʉmambile. Ingɨ lɨlɨ itungo lanyu lʉkʉlʉ, lɨlɨ itungo nɨla ʉtemi nʉwa kiti.”<verse eid="LUK 22:53" /></para>
  <para style="s">Petelo ʉkʉmʉhita ʉ Yesʉ</para>
  <para style="r">
    <ref loc="MAT 26:57-58">Matayo 26:57-58</ref>; <ref loc="MRK 14:53-54">Maliko 14:53-54-66-72</ref>; <ref loc="JHN 18:12-18">Yohana 18:12-18-25-27</ref></para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54" />Ʉʉgwa, akamʉamba, akamʉlongolya munyumba amʉpolyi nʉ mʉkʉlʉ. Petelo akamʉtyatɨɨla kʉlɨ. <verse eid="LUK 22:54" /><verse number="55" style="v" sid="LUK 22:55" />Palʉganga aɨakɨɨye moto, nɨantʉ awa akikiɨ kʉʉpɨlɨmikɨɨlya, Petelo aɨwikiɨ nɨenso. <verse eid="LUK 22:55" /><verse number="56" style="v" sid="LUK 22:56" />Mitʉmi ʉng’wɨ nʉakɨsʉngʉ akamʉona ʉ Petelo wikɨɨ palʉng’wɨ nɨenso, akamʉgondoola, akalʉnga, “Mʉntʉ ʉyʉ aza ɨpalʉng’wɨ nʉ Yesʉ.”<verse eid="LUK 22:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 22:57" />Ingɨ Petelo akahita akalʉnga, “Nyenyu! Ʉnene shanga nʉmʉmanyile ʉ mʉntʉ ʉyʉ.”<verse eid="LUK 22:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 22:58" />Itungo iniino, mʉntʉ mʉngɨɨza akamʉona ʉ Petelo akalʉnga, “Ʉewe mɨpalʉng’wɨ.”</para>
  <para style="p" vid="LUK 22:58">Petelo ingɨ akasʉkɨɨlya, “Ʉweadɨ shanga nene.”<verse eid="LUK 22:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 22:59" />Anga kʉkɨla isaa lɨng’wɨ, mʉntʉ mʉngɨɨza akakomangɨɨla, “Kʉlʉ kʉʉlʉ mʉntʉ ʉyʉ wɨpalʉng’wɨ nʉ Yesʉ, ʉpembeeye kʉ Galilaya.”<verse eid="LUK 22:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 22:60" />Ingɨ ʉ Petelo akalʉnga, “Ʉweadɨ, ɨkɨ nʉkʉkɨtambʉla shanga nɨkɨlɨngile.”</para>
  <para style="p" vid="LUK 22:60">Papo paapo, Petelo aɨ wakɨlɨ ʉkʉtambʉla, nsambalume ɨkakʉnkʉla. <verse eid="LUK 22:60" /><verse number="61" style="v" sid="LUK 22:61" />Isekʉlʉ Yesʉ akapɨlʉka akamʉgoza ʉ Petelo, Petelo nʉng’wenso akaikɨmbʉka nkani yɨhi naɨ ʉtambʉɨwe ni Isekʉlʉ. “Lelo nsambalume ɨze ɨkɨlɨ kʉkʉnkʉla ʉewe ʉkʉnihita kataatʉ.” <verse eid="LUK 22:61" /><verse number="62" style="v" sid="LUK 22:62" />Papo ʉ Petelo akapuma kʉnzi, akaalɨka mʉnkolo nʉkʉlɨla.<verse eid="LUK 22:62" /></para>
  <para style="s">Yesʉ ʉkʉbehʉlwa nʉ kʉkʉwa</para>
  <para style="r">
    <ref loc="MAT 26:67-68">Matayo 26:67-68</ref>; <ref loc="MRK 14:65">Maliko 14:65</ref></para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63" />Antʉ awo naɨ amʉambile ʉ Yesʉ akatula mʉbehʉla nʉkʉmʉkʉa. <verse eid="LUK 22:63" /><verse number="64" style="v" sid="LUK 22:64" />Akamʉtunga mʉkako mʉmiho, akatula mʉkolya, “Pumya mʉloto kʉone nyenyu nʉkʉkʉile.” <verse eid="LUK 22:64" /><verse number="65" style="v" sid="LUK 22:65" />Akamʉtʉkɨɨlya itʉki niikʉlʉ yɨdʉ.<verse eid="LUK 22:65" /></para>
  <para style="s">Yesʉ pantongeela ianza nɨla anyampala a Ayahudi</para>
  <para style="r">
    <ref loc="MAT 26:59-66">Matayo 26:59-66</ref>; <ref loc="MRK 14:55-64">Maliko 14:55-64</ref>; <ref loc="JHN 18:19-24">Yohana 18:19-24</ref></para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66" />Naɨwela kɨdaʉdaʉ, ianza la anyampala aantʉ nɨapolyi nɨakʉlʉ nɨamanyisi amalagɨɨlyo ang’wa Musa akatankana akikiɨ palʉng’wɨ. Akamʉleta ʉ Yesʉ pantongeela ianza nɨlanso. <verse eid="LUK 22:66" /><verse number="67" style="v" sid="LUK 22:67" />Ianza ɨlɨ lɨkamʉkolya ʉ Yesʉ, “Sikʉtambʉɨle. Itɨɨ ʉewe, yʉʉ wewe wɨ Kilisito nʉhoilwe ni Itunda?”</para>
  <para style="p" vid="LUK 22:67">Yesʉ ingɨ akaatambʉɨla, “Anga nʉmʉɨle shanga mʉkʉhʉɨɨla, <verse eid="LUK 22:67" /><verse number="68" style="v" sid="LUK 22:68" />hangɨ anga nʉmʉkolye ikolyo, shanga mʉkʉnsʉkɨɨlya. <verse eid="LUK 22:68" /><verse number="69" style="v" sid="LUK 22:69" />Ingɨ kʉpumɨɨla itungo ɨlɨ ʉnene Ng’waa Mʉntʉ kikiɨ ipande nɨla ʉkʉlʉ nɨlang’wi Itunda nɨ mʉnyangulu.”<verse eid="LUK 22:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="LUK 22:70" />Pang’wanso ianza lɨhi lɨkatambʉla, “Ʉʉgwa kʉlʉnge ʉewe wɨ Ng’wana wang’wi Itunda?”</para>
  <para style="p" vid="LUK 22:70">Yesʉ nʉyo akalʉnga, “Nɨmʉkɨtambʉe ʉnyenye kɨko tai.”<verse eid="LUK 22:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="LUK 22:71" />Ianza lɨkalʉnga, “Itɨɨ, kʉloilwe ʉkʉɨɨli ʉʉya nʉʉlɨ gwa? Sese kʉtegeeye ʉkʉtambʉla kʉmʉlomo wakwe.”<verse eid="LUK 22:71" /></para>
  <chapter eid="LUK 22" />
  <chapter number="23" style="c" sid="LUK 23" />
  <para style="s">Yesʉ ʉkʉtalwa kʉng’wa Pilato</para>
  <para style="r">
    <ref loc="MAT 27:1-2">Matayo 27:1-2</ref>; <ref loc="MAT 11:14">11:14</ref>; <ref loc="MRK 15:1-5">Maliko 15:1-5</ref>; <ref loc="JHN 18:28-38">Yohana 18:28-38</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1" />Sʉnga, ɨanza lɨhi akimɨka, akamʉtala ʉ Yesʉ kʉng’wa Pilato. <verse eid="LUK 23:1" /><verse number="2" style="v" sid="LUK 23:2" />Akandya kʉmʉsemela azelʉnga. “Aza kʉmʉhangɨle ʉmʉntʉ ʉyʉ ʉkʉalimangɨɨlya ɨantʉ itʉ, nʉkʉagilya ɨantʉ aleke kʉpumya kodi kʉ mʉtemi nʉ mʉkʉlʉ nʉa Loma hangɨ ʉkitendisa kɨna nʉanso yʉyo Kilisito, Mʉtemi.”<verse eid="LUK 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 23:3" />Pilato akamʉkolya ʉ Yesʉ, “Ʉewe Wɨmʉtemi nʉa Ayahudi?”</para>
  <para style="p" vid="LUK 23:3">Yesʉ akamʉsʉkɨɨlya, “Wewe ʉlʉngile.”<verse eid="LUK 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 23:4" />Sʉnga ʉ Pilato akaaɨla apolyi nɨakʉlʉ niumbɨ laantʉ, “Shanga kʉona igazo lɨhi kʉ mʉntʉ ʉyʉ.” <verse eid="LUK 23:4" /><verse number="5" style="v" sid="LUK 23:5" />Nɨanso ingɨ akakomangɨɨla azelʉnga, “Mʉntʉ ʉyʉ ʉmanyisi wakwe mihɨɨ a Yʉdea ɨhi ʉkʉasasha ɨantʉ aapɨlʉke ɨatemi. Aɨ wandɨɨye kʉ Galilaya, itungo ɨlɨ ʉkolɨ pa Yelusalemu.”<verse eid="LUK 23:5" /></para>
  <para style="s">Yesʉ ʉkʉtalwa kʉng’wa Helode</para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6" />Ʉʉgwa ʉ Pilato naɨ wija nianso akakolya, “Itɨɨ, mʉntʉ ʉyʉ mʉnya kʉ Galilaya?” <verse eid="LUK 23:6" /><verse number="7" style="v" sid="LUK 23:7" />Naɨ walɨnga kɨna ʉ Yesʉ ʉkolɨ kʉ ʉtemi wang’wa Helode, akaalagɨɨlya amʉtale kʉng’wa Helode, matungo nanso aɨ ʉkolɨ kʉ Yelusalemu. <verse eid="LUK 23:7" /><verse number="8" style="v" sid="LUK 23:8" />Helode akiloa naɨ wamʉona ʉ Yesʉ, aɨ wigulye lʉkumo lakwe, nɨitɨga itungo ɨlɨpu aɨ wasʉmbɨɨye kʉmʉona kɨhenga. Kʉkɨla nanso, aɨ ʉkete nsʉla wamʉone ʉ Yesʉ ʉkitʉma ɨmɨʉkʉɨlwa. <verse eid="LUK 23:8" /><verse number="9" style="v" sid="LUK 23:9" />Ʉʉgwa, Helode akamʉkolya makolyo ɨdʉ, ʉ Yesʉ ingɨ shanga aɨ ʉkenda sʉsha anga lʉkani lɨhi. <verse eid="LUK 23:9" /><verse number="10" style="v" sid="LUK 23:10" />Apolyi nɨakʉlʉ nɨamanyisi amalagɨɨlyo ang’wa Musa akapumɨla pantongeela, akamʉsemela kʉngulu ikʉlʉ. <verse eid="LUK 23:10" /><verse number="11" style="v" sid="LUK 23:11" />Sʉnga, ʉ Helode palʉng’wɨ nɨanyambita akwe, akamʉkʉa ʉ Yesʉ nʉkʉmʉbehʉla, akamʉtugala ngʉo la kɨtemi, akamʉsʉsha kʉng’wa Pilato. <verse eid="LUK 23:11" /><verse number="12" style="v" sid="LUK 23:12" />Lʉhikʉ nʉlanso Pilato nʉ Helode akatula ɨkɨhʉmbashʉya kʉnsoko alʉkani nʉlanso, kʉpumɨɨla ng’wandyo aɨ alemanile.<verse eid="LUK 23:12" /></para>
  <para style="s">Yesʉ ʉkʉlamʉlwa kʉbʉlagwa</para>
  <para style="r">
    <ref loc="MAT 27:15-26">Matayo 27:15-26</ref>; <ref loc="MRK 15:6-15">Maliko 15:6-15</ref>; <ref loc="JHN 18:39">Yohana 18:39</ref>; <ref loc="JHN 19:16">19:16</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13" />Itɨ gwa ʉ Pilato akitangisa ianza laa apolyi nɨakʉlʉ nɨatongeeli aantʉ, <verse eid="LUK 23:13" /><verse number="14" style="v" sid="LUK 23:14" />akaatambʉɨla, “Mʉmʉletile ʉmʉntʉ ʉyʉ kʉmʉsemela apa itɨ kɨna ʉkʉakinyɨla ɨantʉ apelʉke. Itungo ɨlɨ tegeelyi! Nɨnakolenkeelya ikʉlʉ ntongeela anyu, naona mʉgila anga igazo lɨhi. <verse eid="LUK 23:14" /><verse number="15" style="v" sid="LUK 23:15" />Shanga ʉnene du nʉ Helode ga ʉʉiye igazo lɨhi, yɨyo nsoko ʉmʉsʉkilye kʉng’waane. Ingɨ ɨtai ʉmʉntʉ ʉyʉ shanga witʉmɨle igazo lɨhi nɨlakʉmʉsasha ʉlamʉlwa nʉa kʉbʉlagwa. <verse eid="LUK 23:15" /><verse number="16" style="v" sid="LUK 23:16" />Iti gwa, kʉlagɨɨlya wakʉwe mɨsheleti, sʉnga nʉmʉlekele.” <verse eid="LUK 23:16" /><verse number="17" style="v" sid="LUK 23:17" />Aɨ izɨɨe mʉlʉhikʉ nʉla pasaka, Pilato wamʉtungʉɨle mʉtungwa ʉng’wɨ.<verse eid="LUK 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 23:18" />Ingɨ antʉ ɨhi kʉlʉli lʉng’wɨ akazogolya, azelʉnga. “Mʉntʉ ʉyʉ nʉabʉlagwe, kʉloilwe mʉtunguʉɨle ʉ Balaba!” <verse eid="LUK 23:18" /><verse number="19" style="v" sid="LUK 23:19" />Balaba ʉyʉ aɨ ʉtungilwe kʉnsoko akʉsasha kʉʉpɨlʉka ʉʉtemi mʉkɨsalɨ nɨ antʉ kʉbʉlagwa.<verse eid="LUK 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 23:20" />Pilato aɨ ʉloilwe kʉmʉlekela ʉ Yesʉ, itɨ gwa akitambʉlya nɨenso hangɨ, <verse eid="LUK 23:20" /><verse number="21" style="v" sid="LUK 23:21" />ɨantʉ ingɨ akazogolya. “Mʉkononteele mʉmʉsalaba, mʉkononteele mʉmʉsalaba.”<verse eid="LUK 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 23:22" />Pilato akaatambʉɨla nkʉa akataatʉ, “Ʉgazilye ntʉni ʉmʉntʉ ʉyʉ? Shanga kʉmʉonelya anga igazo lɨhi nɨlakʉbʉlagwa, kʉlʉlo kʉmʉkʉa nkootya, sʉnga nʉmʉlekele.”<verse eid="LUK 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 23:23" />Antʉ ingɨ akalongoleka kʉzogolya ikʉlʉ, kɨna ʉ Yesʉ kʉʉsinja wabʉlagwe. Mpelo akwe iogo lao lɨkamʉtʉntʉmɨɨlya ʉ Pilato. <verse eid="LUK 23:23" /><verse number="24" style="v" sid="LUK 23:24" />Itɨ gwa ʉ Pilato akalamʉla anga ɨantʉ mʉatakɨɨe. <verse eid="LUK 23:24" /><verse number="25" style="v" sid="LUK 23:25" />Akamʉtungʉɨla kʉpuma mʉkitungo mʉntʉ ʉyʉ naɨʉtungilwe kʉnsoko akʉsasha antʉ apɨlʉke nʉʉbʉlagi, akamʉpumya ʉ Yesʉ kʉ antʉ, amʉtendeela mʉaloewe.<verse eid="LUK 23:25" /></para>
  <para style="s">Yesʉ ʉkʉkonenteelwa mʉ mʉsalaba</para>
  <para style="r">
    <ref loc="MAT 27:32-44">Matayo 27:32-44</ref>; <ref loc="MRK 15:21-32">Maliko 15:21-32</ref>; <ref loc="JHN 19:17-27">Yohana 19:17-27</ref></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26" />Antʉ awa naɨ amʉtwae ʉ Yesʉ kʉmʉbʉlaga, mʉnzɨla akatankana nʉ mʉntʉ ʉng’wɨ witangwa Simoni mʉnya kʉ Kilene, aɨ ʉpembeeye kʉnzi a kɨsalɨ. Itɨ gwa akamʉamba akamʉkensha ʉmʉsalaba wamʉtyate ʉ Yesʉ kʉnyuma.<verse eid="LUK 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 23:27" />Antʉ ɨdʉ, akamʉtyata mʉkatɨ ao azeakolɨ asʉngʉ naɨ akʉlɨla nʉkuhongeelya. <verse eid="LUK 23:27" /><verse number="28" style="v" sid="LUK 23:28" />Yesʉ akaapɨlʉkɨla, akatambʉla, “Ʉnyenye asʉngʉ a kʉ Yelusalemu. Leki kʉndɨɨli ʉnene, lɨli kʉnsoko anyu nɨanaanyu. <verse eid="LUK 23:28" /><verse number="29" style="v" sid="LUK 23:29" />Kʉnsoko, ɨtai mahikʉ apembilye nɨazɨzalʉnga. ‘Akembetilwe ao nɨagʉmba, nɨshanga atugile nʉkonsha ana.’ <verse eid="LUK 23:29" /><verse number="30" style="v" sid="LUK 23:30" />Itungo nɨlanso, papo ɨantʉ akandya kʉmaɨla ɨmalʉgʉlʉ, ‘Kʉgwɨli.’ Nɨmasʉkʉʉlʉ, ‘Kʉkunɨkɨli.’ <verse eid="LUK 23:30" /><verse number="31" style="v" sid="LUK 23:31" />Kʉnsoko anga ɨze ɨantʉ akʉntenda itɨ ʉnene nɨnɨmʉgila igazo lɨhi, akʉmʉtenda ʉlɨ mʉntʉ ʉyo nʉkete igazo?”<verse eid="LUK 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32" />Akaahola antʉ aʉya abɨɨlɨ, nɨagazi, abʉlagwe palʉng’wɨ nʉ Yesʉ. <verse eid="LUK 23:32" /><verse number="33" style="v" sid="LUK 23:33" />Naɨ apikile nkɨka nitang’wa, “Ing’ang’a litwe,” Papo ai amʉbʉlagile ʉ Yesʉ palʉng’wɨ nɨantʉ awo nɨabɨɨlɨ niagazi, ʉng’wɨ mʉsalaba wakwe ipande nɨla kɨgoha nʉ mʉya mʉsalaba wakwe ipande nɨla nkɨgɨ. <verse eid="LUK 23:33" /><verse number="34" style="v" sid="LUK 23:34" />Yesʉ akatambʉla, “Tata leka kʉaaɨɨlya ʉmʉlandʉ kʉnsoko shanga alɨngile nɨakʉlɨtenda.” Sʉnga apolyo nɨalɨngi amalagɨɨlyo akatʉmɨla bʉnkʉlʉ bʉnkʉlʉ komolana ɨngʉo ang’wa Yesʉ. <verse eid="LUK 23:34" /><verse number="35" style="v" sid="LUK 23:35" />Antʉ ang’wɨ azeimɨkile aaloeeye. Atongeeli a Ayahudi akazemʉbehʉla azelʉnga. “Ʉaponilye nɨangɨɨza, itungo ɨlɨ nʉiponie ng’wenso, anga ɨze tai nʉanso Kilisito, nʉpumigwe ni Itunda.”<verse eid="LUK 23:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 23:36" />Anyambita nɨenso ga akamʉbehʉla, akamʉpa kɨlʉʉlwɨ ka dibai <verse eid="LUK 23:36" /><verse number="37" style="v" sid="LUK 23:37" />azelʉnga. “Anga ɨze tai ʉewe wɨ Mʉtemi nʉa Ayahudi iponie ʉewe.”<verse eid="LUK 23:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 23:38" />Ʉʉgwa akatʉmbɨka ʉandɨkwa ʉwʉ mʉmʉsalaba pigʉlya akwe. “ɄYɄ YɄYɄ MɄTEMI NɄA AYAHUDI.”<verse eid="LUK 23:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 23:39" />Ʉng’wɨ mʉagazi awo naɨ atʉmbɨnkanigwe mʉmɨsalaba akamʉtʉkɨla ʉ Yesʉ, wazelʉnga. “Itɨɨ, Ʉewe ingɨ wɨ Kilisito? Iponie ʉewe, ʉkʉponie nʉsese.”<verse eid="LUK 23:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 23:40" />Ingɨ mʉgazi ʉyʉ nʉa kabɨɨlɨ akamʉkenela ʉmʉya wazelʉnga. “Ʉewe shanga ʉmogopile Itunda? Kʉnʉ nʉsese kɨhi kʉtʉmbɨkilwe mʉ mʉsalaba anga ʉng’wenso. <verse eid="LUK 23:40" /><verse number="41" style="v" sid="LUK 23:41" />Ʉewe nʉ nene kʉtendeewe mʉitakɨwe, kʉnsoko ɨkɨ ingɨ kɨlɨpo ka magazo itʉ nɨkʉtendile. Mʉntʉ ʉyʉ shanga witʉmɨle kɨntʉ kɨhi nɨkɨbɨ.” <verse eid="LUK 23:41" /><verse number="42" style="v" sid="LUK 23:42" />Sʉnga akamʉɨla, “Ʉewe Yesʉ itungo nʉɨkingɨla Mʉʉtemi nʉako ʉkɨmbʉke nʉ nene.”<verse eid="LUK 23:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 23:43" />Yesʉ akamʉsʉkɨɨlya, “Kʉlʉ kʉʉlʉ kʉʉɨla, lelo yɨyɨ ʉkʉtula palʉng’wɨ nʉ nene pang’ wi Itunda.”<verse eid="LUK 23:43" /></para>
  <para style="s">Yesʉ ʉkʉsha</para>
  <para style="r">
    <ref loc="MAT 27:45-56">Matayo 27:45-56</ref>; <ref loc="MRK 15:33-41">Maliko 15:33-41</ref>; <ref loc="JHN 19:28-30">Yohana 19:28-30</ref></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 23:44" />Ai yainaa anga saa mʉtandatʉ ng’ʉng’wɨ, yikatula kitɨ mihɨɨ ɨhi kʉpikɨɨla saa kenda, <verse eid="LUK 23:44" /><verse number="45" style="v" sid="LUK 23:45" />kʉnsoko lyoa aɨ laleka kelya, nipazɨa naɨlɨkolɨ Mʉnyʉmba ang’wi Itunda likatamʉka pa katɨkati kʉpumɨɨla migʉlya kʉpikɨɨla pihɨ. <verse eid="LUK 23:45" /><verse number="46" style="v" sid="LUK 23:46" />Yesʉ akakʉta, akalʉnga, “Tata nkolo ane namiika mʉmɨkono ako.” Naɨ wakondya kʉtambʉla itɨ, akasha.<verse eid="LUK 23:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 23:47" />Papo ʉmankata naɨ wilolenkee aya natendekile akamʉkʉlya Itunda wazelʉnga, “Tai mʉntʉ ʉyʉ aɨ ʉkembetilwe ni Itunda.”<verse eid="LUK 23:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 23:48" />Antʉ ɨhi naɨilingɨle pang’wanso, kiloeela aya nakʉtendeka, ai asukile kumatalao akikʉanga mʉkɨkua kʉʉkia. <verse eid="LUK 23:48" /><verse number="49" style="v" sid="LUK 23:49" />Ingɨ antʉ ɨhi naɨ amʉmanyile palʉng’wɨ nɨasʉngʉ naɨ ityatile nʉ Yesʉ kʉpumɨɨla kʉ Galilaya, aɨimikile kʉli aziloeela makani nanso.<verse eid="LUK 23:49" /></para>
  <para style="s">Kʉɨkwa kʉng’wa Yesʉ</para>
  <para style="r">
    <ref loc="MAT 27:57-61">Matayo 27:57-61</ref>; <ref loc="MRK 15:42-47">Maliko 15:42-47</ref>; <ref loc="JHN 19:38-42">Yohana 19:38-42</ref></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 23:50" />Aɨ ʉkolɨ mʉntʉ ʉng’wɨ witangwa Yusupu, ʉpembeeye kɨsalɨ kɨng’wɨ nɨka Ayahudi, mʉntʉ ʉng’wɨ mʉanyampala ianza ikʉlʉ nɨla Ayahudi, aɨ mʉntʉ nʉgombekile kʉng’wi Itunda. <verse eid="LUK 23:50" /><verse number="51" style="v" sid="LUK 23:51" />Mʉntʉ ʉyʉ shanga aɨ wigombilye nʉ ʉlamʉli wianza nɨ makani ɨhi nɨakitʉma ɨaʉya, mʉntʉ ʉyʉ aɨ ʉpembeeye kʉ kɨsali ka Alimataya aɨ usʉmbɨɨye kʉza kʉ ʉtemi wang’wi Itunda. <verse eid="LUK 23:51" /><verse number="52" style="v" sid="LUK 23:52" />Sʉnga Yusupu akamʉhanga ʉ Pilato, akalompa wapegwe mʉimba wang’wa Yesʉ. <verse eid="LUK 23:52" /><verse number="53" style="v" sid="LUK 23:53" />Naɨ wagombigwa akasimya mʉimba wang’wa Yesʉ kʉpuma mʉ mʉsalaba, akaʉtunga shanda naʉgʉlwa ʉkʉlʉ, akaʉɨka mʉkɨbɨɨla naɨ kɨpʉʉwe migwe, kɨbɨɨla ɨkɨ aɨ kɨkɨlɨ kɨɨkwe mʉntʉ wɨhi, akakiɨla igwe pamʉlango nʉa kɨbɨɨla. <verse eid="LUK 23:53" /><verse number="54" style="v" sid="LUK 23:54" />Lʉhikʉ nʉlanso ingɨ aɨ lakihamba kʉnsoko a Lʉhikʉ nʉla Kʉsupya.<verse eid="LUK 23:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 23:55" />Asʉngʉ awo naɨ amʉtyatile ʉ Yesʉ kʉpumɨɨla kʉ Galilaya akamʉtyata ʉ Yusupu, akakiona ikibɨɨlɨ mʉʉɨkilwe mʉimba wang’wa Yesʉ. <verse eid="LUK 23:55" /><verse number="56" style="v" sid="LUK 23:56" />Sʉnga akatʉlya kitolao akanoneelya makʉta nɨnyunkɨɨla nɨmakuta akʉʉpaka mʉɨlɨ wang’wa Yesʉ. Lʉhikʉ nʉla kʉsupya akasupya anga mʉilagɨɨgwe nilagɨɨlyo.<verse eid="LUK 23:56" /></para>
  <chapter eid="LUK 23" />
  <chapter number="24" style="c" sid="LUK 24" />
  <para style="s">Kiʉka kʉng’wa Yesʉ</para>
  <para style="r">
    <ref loc="MAT 28:1-10">Matayo 28:1-10</ref>; <ref loc="MRK 16:1-8">Maliko 16:1-8</ref>; <ref loc="JHN 20:1-10">Yohana 20:1-10</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1" />Lʉhikʉ nʉla ng’wandyo nʉla wiki, daʉ maniambwa, asʉngʉ awa akalongola kʉkɨbɨɨla azeahoile manyunkɨɨlyo ayo naɨamanoneeye. <verse eid="LUK 24:1" /><verse number="2" style="v" sid="LUK 24:2" />Nɨ apika pa kɨbɨɨla akahanga igwe naɨ lɨkiɨɨigwe pakɨbɨɨla lɨpingɨlitɨgwe kʉlɨ. <verse eid="LUK 24:2" /><verse number="3" style="v" sid="LUK 24:3" />Naɨ ingɨla mʉkatɨ akɨbɨɨla, shanga akaʉona ʉmʉimba wang’wi Isekʉlʉ Yesʉ. <verse eid="LUK 24:3" /><verse number="4" style="v" sid="LUK 24:4" />Naɨ akɨlɨ akʉkʉɨlwa ikani ɨlɨ, itungo ʉdu, antʉ abɨɨlɨ atugae ngʉo akʉmɨlɨgɨnta anga impɨto, akimɨka pakupɨ nɨenso. <verse eid="LUK 24:4" /><verse number="5" style="v" sid="LUK 24:5" />Asʉngʉ awa akogopa, akatunia ɨmiho nʉkʉtugama pihɨ. Papo gwa antʉ awa akaaɨla, “Nɨkɨ mʉkʉmduma mʉntʉ nɨmʉpanga mʉantʉ nɨakule? <verse eid="LUK 24:5" /><verse number="6" style="v" sid="LUK 24:6" />Wɨmʉtilɨ apa, wiʉka. Kɨmbʉki ayo naɨ ʉmʉtambʉɨe naɨ mʉkolɨ ʉko kʉ Galilaya. <verse eid="LUK 24:6" /><verse number="7" style="v" sid="LUK 24:7" />Apo naɨ ʉtambʉe ‘Ʉnene Ng’waa Mʉntʉ ntakɨwe mpumigwe kʉantʉ nɨabɨ, nɨantʉ awa nɨabɨ akononteele mʉmʉsalaba nʉlʉhikʉ nʉlakataatʉ kiʉka.”’<verse eid="LUK 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 24:8" />Papo asʉngʉ awa akakɨmbʉka inkani yang’wa Yesʉ, <verse eid="LUK 24:8" /><verse number="9" style="v" sid="LUK 24:9" />naɨ atulya kʉpuma kʉkɨbɨɨla, akaaganʉɨla ɨitʉmi awo nɨikʉmi na ʉng’wɨ nɨantʉ aʉya ɨhi ɨmakani nanso ɨhi. <verse eid="LUK 24:9" /><verse number="10" style="v" sid="LUK 24:10" />Asʉngʉ awa naɨ aganʉe inkani izi kʉ itʉmi, ingɨ aɨ Malia mʉnya kʉ Magidala nʉ Yoana nʉ Malia nyinya wang’wa Yakobo, palʉng’wɨ nɨasʉngʉ aʉya naɨendanilye kʉkɨbɨɨla. <verse eid="LUK 24:10" /><verse number="11" style="v" sid="LUK 24:11" />Ingɨ itʉmi nɨanso akahʉɨɨla nkani izi asʉngʉ naɨ aganʉe, akaiona nkani yaʉteele. <verse eid="LUK 24:11" /><verse number="12" style="v" sid="LUK 24:12" />Nɨitɨ ga Petelo akaʉka, akamanka ntambo kʉkɨbɨɨla. Naɨ wapika akatuna wakʉnɨɨle mʉkɨbɨɨla, akamɨona shanda du ikoeganile papo. Akatʉlya kito kʉnʉ waze ʉkʉɨwe nkani izi niipumɨe.<verse eid="LUK 24:12" /></para>
  <para style="s">Yesʉ ʉkʉigeela antʉ abɨɨlɨ mʉ nzɨla a kʉ Emau</para>
  <para style="r">
    <ref loc="MRK 16:12-13">Maliko 16:12-13</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13" />Lʉhikʉ lʉlo lʉʉlo antʉ abɨɨlɨ mʉitʉmɨ ang’wa Yesʉ akatula alongoe kʉ kɨsalɨ kɨng’wɨ nɨkʉniino kitangwa Emau, ʉkʉli wakwe anga kilomita ikʉmi na ɨng’wɨ kʉpumɨɨla kʉ Yelusalemu. <verse eid="LUK 24:13" /><verse number="14" style="v" sid="LUK 24:14" />Akazitambʉlya makani ɨhi naɨ apumɨe. <verse eid="LUK 24:14" /><verse number="15" style="v" sid="LUK 24:15" />Naɨ akitambʉɨla nʉkigombasɨɨlya nkani nianso, Yesʉ akigela akakʉɨlania nɨenso. <verse eid="LUK 24:15" /><verse number="16" style="v" sid="LUK 24:16" />Akamʉona kʉmiho ao, nɨitɨga shanga akahuma kʉmʉmanya kɨna ng’wenso. <verse eid="LUK 24:16" /><verse number="17" style="v" sid="LUK 24:17" />Yesʉ akaakolya, “Makani kɨɨ aya nɨmʉkitambʉɨla kʉnʉ mʉkʉgenda?” Antʉ awa akimɨka akakɨlaga ihɨtwɨ, akahininaala kʉʉkia. <verse eid="LUK 24:17" /><verse number="18" style="v" sid="LUK 24:18" />Mʉntʉ ʉng’wɨ, linalakwe Kileopa, akamʉsʉkɨɨlya, “Itɨɨ, ʉewe wing’wene nʉimʉzɨɨla mʉnʉ mu Yelusalemu nɨshanga umalingɨle ɨmakani napumɨe mahikʉ yaya mʉnʉ mu Yelusalemu?”<verse eid="LUK 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 24:19" />Yesʉ akaakolya, “Makani kɨɨ nanso?”</para>
  <para style="p" vid="LUK 24:19">Antʉ awa akamʉsʉkɨɨlya, “Makani naza amuhangɨle ʉ Yesʉ nʉa kʉ Nazaleti. Ingɨ aza mʉmanga wang’wi Itunda aza ʉkete ʉhumi ʉkʉlʉ nʉakitʉma makʉlʉ nʉkʉmanyisa pantongeela ang’wi Itunda nintongeela aantʉ ɨhi. <verse eid="LUK 24:19" /><verse number="20" style="v" sid="LUK 24:20" />Akulu ipolyo niatemi itu akalamula kumaja nʉ kʉmʉbulaga. <verse eid="LUK 24:20" /><verse number="21" style="v" sid="LUK 24:21" />Ʉsese ingɨ aza kusumbɨɨye kɨna nʉanso yuyo ʉkʉaponya Aisilaeli. Kukɨla nanso ɨhi, lelo akɨla mahikʉ ataatʉ ɨmakani naya napumiɨlɨla. <verse eid="LUK 24:21" /><verse number="22" style="v" sid="LUK 24:22" />Nihangɨ, asʉngʉ nɨang’wi akʉtinʉla. Dau maniambwa ɨlelo azaendile kʉkɨbɨɨla, <verse eid="LUK 24:22" /><verse number="23" style="v" sid="LUK 24:23" />shanga auona umʉimba wakwe. Atʉlya alʉnga kɨna apumiwe nia Malaɨka aatambʉɨla kɨna Yesʉ wainaa mʉpanga. <verse eid="LUK 24:23" /><verse number="24" style="v" sid="LUK 24:24" />Ang’wi itu azaendile kʉkɨbɨɨla ende iloeela makani ayo iasʉngʉ niamatambue, nʉanso ingɨ shanga amʉona.”<verse eid="LUK 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25" />Sʉnga ʉ Yesʉ akaatambʉɨla, “Ʉnyenye mɨapʉngʉ itɨ ni nkolo yanyu ingɨ nkakʉ kʉnsoko shanga mʉhʉɨɨe aya ɨhi naɨatambʉwe nɨamanga ang’wi Itunda? <verse eid="LUK 24:25" /><verse number="26" style="v" sid="LUK 24:26" />Itɨɨ, ʉ Kilisito shanga aza ʉtakɨwene kagigwa, nɨitɨ wingɨle mʉʉkulu akwe?” <verse eid="LUK 24:26" /><verse number="27" style="v" sid="LUK 24:27" />Yesʉ akaalɨngasa ʉandɨkwa wɨhɨ nʉa Nkani Nza nʉʉtambʉe ɨmakani akwe, kandɨɨlya ʉ Musa nianyakidagu ɨhi.<verse eid="LUK 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28" />Naɨ akihumbeela ɨkɨsalɨ iko naɨ alongoe, Yesʉ akitendisa kɨna ʉkʉ kɨlɨnkania nʉ mʉhɨnzo, <verse eid="LUK 24:28" /><verse number="29" style="v" sid="LUK 24:29" />ingɨ nɨanso akamʉpepeelya azelʉnga, “Saga palʉng’wɨ nʉsese, kusoko wainiila, nʉʉtikʉ wapikaa.” Ʉʉgwa akingɨla mʉkɨsalɨ akikiɨ palʉng’wɨ nɨenso. <verse eid="LUK 24:29" /><verse number="30" style="v" sid="LUK 24:30" />Naɨ wikiɨ kʉlya indya palʉng’wɨ nɨenso, akaʉhola umukate, akamʉlʉmba Itunda, akauega, akainkɨɨlya. <verse eid="LUK 24:30" /><verse number="31" style="v" sid="LUK 24:31" />Itungo lɨlo lɨɨlo miho ao akapɨtya, akamʉlinga, nʉanso ingɨ akalimansɨɨla pakatɨ ao. <verse eid="LUK 24:31" /><verse number="32" style="v" sid="LUK 24:32" />Ʉʉgwa akatʉlitambʉɨla, “Itɨɨ, inkolo yitu shanga aza yɨkʉpɨta kʉʉlowa apo naza ʉkʉʉlɨngasa Ʉandɨkwa nʉa Nkani Nza naza kʉkolɨ mʉnzɨla?”<verse eid="LUK 24:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 24:33" />Itungo lɨlo lɨɨlo akahega, akatʉlya kʉ Yelusalemu. Kʉng’wanso akaahanga ɨitʉmɨ awo ni ikʉmi na ʉng’wɨ nawo ɨhi naɨ ɨpalʉng’wɨ nɨenso <verse eid="LUK 24:33" /><verse number="34" style="v" sid="LUK 24:34" />akalʉnga, “Kʉlʉ kʉʉlʉ Isekʉlʉ wiʉka, ʉmigee ʉ Simoni.”<verse eid="LUK 24:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 24:35" />Sʉnga, ahʉɨɨlɨ nɨabɨɨlɨ akaapikilya nkani yɨhi naɨ aiine mʉnzɨla, niitɨ naɨ amʉlingɨle naɨ ʉkʉʉega ʉmʉkate.<verse eid="LUK 24:35" /></para>
  <para style="s">Yesʉ ʉkigela kʉ amanyisigwa akwe</para>
  <para style="r">
    <ref loc="MAT 28:16-20">Matayo 28:16-20</ref>; <ref loc="MRK 16:14-18">Maliko 16:14-18</ref>; <ref loc="JHN 20:19-23">Yohana 20:19-23</ref>; <ref loc="ACT 1:6-8">Ntendo 1:6-8</ref></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36" />Naɨ akɨlɨ akitambʉlya inkani nianso, Yesʉ akimɨka pakatɨ ao, akaaɨla, “Ʉgila minyomo utule nʉ nyenye.”<verse eid="LUK 24:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 24:37" />Akalunguala akingɨilwa nʉwoa akasɨganɨɨlya kɨna aonaa mintunga. <verse eid="LUK 24:37" /><verse number="38" style="v" sid="LUK 24:38" />Ingɨ ʉ Yesʉ akaatambʉɨla, “Kʉnɨkɨ mʉkʉlʉnguala? Hai kamʉkete mitumbo mʉnkolo yanyu? <verse eid="LUK 24:38" /><verse number="39" style="v" sid="LUK 24:39" />Gozi mɨkono ane ni mɨgʉlʉ ane, nɨ nene. Mambangi muone, kʉnsoko mʉtumbʉka izaa mʉgila anga mʉɨlɨ ang’wɨ makʉpa anga nimʉkumona ʉnene.<verse eid="LUK 24:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 24:40" />Naɨ wakondya kʉtambʉla itɨ, akaalagɨɨla mɨkono nɨ mɨgʉlʉ akwe. <verse eid="LUK 24:40" /><verse number="41" style="v" sid="LUK 24:41" />Naɨ akɨlɨ kʉhʉɨɨla kɨna ng’wenso, kʉnsoko aʉlowa nʉ ʉkʉɨlwa naɨ akete, akaakolya, “Mʉketene ɨkɨntʉ kakʉlya” <verse eid="LUK 24:41" /><verse number="42" style="v" sid="LUK 24:42" />Akamʉpa ng’waa nsamaki nɨasile. <verse eid="LUK 24:42" /><verse number="43" style="v" sid="LUK 24:43" />Akahola, akalya, ɨhi aze amʉloeeye.<verse eid="LUK 24:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44" />Sʉnga akaatambʉɨla, “Yaya makani naɨ nʉmʉtambʉɨe matungo naɨ kɨpalʉng’wɨ nʉnyenye, kɨna aɨ atakɨwe akondanɨɨle ɨhi naɨ andɨkilwe mʉmalagɨɨlyo ang’wa Musa nʉ mʉmbugulu niya amanga ang’wi Itunda nʉ mʉ Zabʉli.”<verse eid="LUK 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 24:45" />Sʉnga akahumya mʉmahala ao ahume kʉʉlinga ʉandɨkwa wang’wi Itunda. <verse eid="LUK 24:45" /><verse number="46" style="v" sid="LUK 24:46" />Akaaila, “Yandɨkilwe mʉandɨkwa wang’wi Itunda, kɨna ʉ Kilisito ʉkʉkaga nʉkʉsha nʉ lʉhikʉ nʉla kataatʉ ʉkiʉka, <verse eid="LUK 24:46" /><verse number="47" style="v" sid="LUK 24:47" />nɨ kɨna itakɨwe, kʉ lina lakwe, antʉ andʉgʉ yɨhi, akʉtanantɨligwa kɨna ɨantʉ atakɨwe kila itʉnʉ nʉ kʉlekelwa ɨmɨlandʉ ao, kandɨɨlya kʉ Yelusalemu. <verse eid="LUK 24:47" /><verse number="48" style="v" sid="LUK 24:48" />Ʉnyenye ingɨ mɨakʉiɨlɨ amakani nanso. <verse eid="LUK 24:48" /><verse number="49" style="v" sid="LUK 24:49" />Ʉnene kumulagiɨlɨlya ʉyo Tataane naɨʉlapile, ingɨ ikii mʉnʉ mʉkɨsalɨ ipikɨɨle nimʉkʉpegwa ʉhumi nʉʉpembeeye kilunde.”<verse eid="LUK 24:49" /></para>
  <para style="s">Kʉholwa kʉng’wa Yesʉ</para>
  <para style="r">
    <ref loc="MRK 16:19-20">Maliko 16:19-20</ref>; <ref loc="ACT 1:9-11">Ntendo 1:9-11</ref></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50" />Sʉnga Yesʉ akaatongeela itʉmi akwe kʉpuma kʉnzi akɨsalɨ ka Betania, Akahumbula imɨkono akwe migʉlya, akaakembeta. <verse eid="LUK 24:50" /><verse number="51" style="v" sid="LUK 24:51" />Yesʉ naɨ ʉkʉakembeta, akaholwa, nʉkʉaleka, akalongola kilunde. <verse eid="LUK 24:51" /><verse number="52" style="v" sid="LUK 24:52" />Sunga akamʉkʉlya ng’wenso, akasʉka kʉ Yelusalemu aze iloile ikʉlʉ. <verse eid="LUK 24:52" /><verse number="53" style="v" sid="LUK 24:53" />Matungo ɨhi aɨikiɨ Mʉnyʉmba ang’wi Itunda azemukʉlya Itunda.<verse eid="LUK 24:53" /></para>
  <chapter eid="LUK 24" />
</usx>