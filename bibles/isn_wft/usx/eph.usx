<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EPH" style="id">- Isanzu Bible Version</book>
  <para style="h">Aepeso</para>
  <para style="toc1">Balʉa a mitʉmi Paʉlo kʉ Aepeso</para>
  <para style="toc2">Aepeso</para>
  <para style="toc3">Aep</para>
  <para style="mt2">Balʉa a mitʉmi Paʉlo kʉ</para>
  <para style="mt1">AEPESO</para>
  <para style="imt">Ntongeela akwe</para>
  <para style="ip">Balua a kʉ Epeso aɨyandɨnkanigwe itungo lɨng'wɨ nɨ balʉa a kʉ Kolosai mʉng'waka nʉwa wa Sitini kʉpuma Kilisito naɨʉtugilwe. Paʉlo ʉkikoola ʉng'wenso kɨna ng'wenso aɨwandɨkile balʉa ɨyɨ 1:1. Asomi ɨdʉ agombile kɨna Paʉlo aɨwandɨkile balʉa kʉ Aepeso, palʉng'wɨ kɨna balʉa ɨyɨ ngila anga mɨlamʉ akwe anga naɨyɨlɨ mʉbalʉa a Akolosai. Kʉnsoko ɨyɨ, aɨyɨhumɨkile aɨitakɨwe ɨtalwe kʉ madale kitʉnga a antʉ nɨamʉhʉɨɨe Kilisito naɨ akolɨ mʉkɨsalɨ nɨkanso. Hangɨ, Paʉlo ʉkʉganʉla kɨna aɨʉkolɨ mʉkadulumu itungo naɨʉandɨkile balʉa ɨyɨ 3:1, 4:1, nɨ 6:20. Paʉlo aɨʉmʉpee balʉa ɨyɨ Tikiko naɨʉkʉagendela antʉ nɨamʉhʉɨe Kilisito nɨakʉ Epeso 6:21,22</para>
  <para style="ip">Epeso aiza kɨsalɨ nɨkɨkʉlʉ hangɨ Ikʉlʉ mʉʉtemi nʉwa Lumi mʉ kɨsalɨ ka Asia nɨniino. Epeso ɨɨkumʉkile kʉ nyʉmba amʉlʉngʉ naɨandɨigwe nʉ mʉlʉngʉ nʉwakɨsʉngʉ nʉwa Kɨyunani naɨwitangilwe Alitemi. Ntendo 19: 23-31. Antʉ nɨamʉhʉɨɨe ʉ Kilisito nɨamolɨ kʉ Epeso pang'wandyo aɨakete ɨngulu ingɨ panyambele ikiɨwa. Ʉkunʉkʉlwa 2: 1-7.</para>
  <para style="ip">Mikinda nɨla ng'wandyo mʉbalʉa ɨyɨ Paʉlo ʉkʉganʉla anga ni Itunda naɨʉahoile antʉ nʉkʉaguna kʉpuma mʉ mɨlandʉao kʉkɨɨla Yesʉ Kilisito. Paʉlo ʉkʉimpyana antʉ nɨamʉhʉɨɨe Kilisito nʉ mʉɨlɨ, nʉ Kilisito anga itwe lakwe. Hangɨ ʉkʉimpyaia antʉ nɨamʉhʉɨɨe Kilisito nɨ nyʉmba, nʉ Kilisito anga igwe nɨlɨambɨɨe nyʉmba nanso. Mikinda nɨla kabɨlɨ nɨla balʉa ɨyɨ, Paʉlo ʉkʉlɨngasa antʉ nɨamʉhʉɨɨe Kilisito nɨatakɨwe kishiɨ.</para>
  <para style="iot">Namolɨ</para>
  <para style="io">Paʉlo wandilye kikoola nʉkʉalamʉsha Aepeso. 1: 1-2</para>
  <para style="io">Sʉnga ʉkʉganʉla mʉhangʉ nʉwa a antʉ nɨamʉhʉɨɨe Kilisito. 1:3-3-21.</para>
  <para style="io">Ʉlongolekile kʉandɨka wazelagɨɨla antʉ nɨamʉhʉɨɨe ʉ Kilisito nɨatakɨwe kɨshiɨ. 4:1-6-20.</para>
  <para style="io">Sʉnga Paʉlo ʉkʉmaɨɨlya ʉkʉganʉla nkani niya kʉmaɨɨlya. 6:21-24.</para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />Ʉnene Paʉlo, mitʉmi wang'wa Kilisito Yesʉ, anga mʉloewe Itunda.</para>
  <para style="p" vid="EPH 1:1">Kʉmʉandɨkɨla balʉa ɨyɨ ʉnyenye antʉ ang'wi Itunda nɨmʉkolɨ kʉ Epeso, nɨmɨahʉɨɨli mʉngwa Kilisito Yesʉ.<verse eid="EPH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 1:2" />Kʉlompile mʉkembetwe mʉtule nɨ matiliga kʉpuma kʉng'wa Tata witʉ Itunda nʉ kʉpuma kʉng'wi Isekʉlʉ witʉ Kilisito.<verse eid="EPH 1:2" /></para>
  <para style="s">Ʉkembetwa Itunda nʉkʉkembetile kʉkɨɨla Kilisito</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />Wakʉligwe Itunda Tata wang'wi Isekʉlʉ witʉ Yesʉ kilisito, kʉnsoko kʉʉkamɨnkani nʉ Kilisito ʉkʉkembetile ʉsese ʉkembetwa wɨhi nʉwa Ngwahʉ Ng'welʉ kʉpuma kigʉlʉ. <verse eid="EPH 1:3" /><verse number="4" style="v" sid="EPH 1:4" />Kʉnsoko ʉnkumbigʉlʉ naɨʉkɨlɨ kʉtundwa, Itunda aɨʉkʉhoile ʉsese kʉkɨɨla Kilisito kʉhume kʉgombeka pang'wakwe nɨagila magazo. Kʉnsoko aɨʉkʉloilwe.<verse eid="EPH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 1:5" />Ʉnkumbigʉlʉ naɨʉkɨlɨ kʉtundwa Itunda aɨʉlamʉe kʉʉhola kʉtule kɨana akwe kʉkɨɨla Yesʉ Kilisito, aɨʉlamʉe kitʉma itɨ kʉnsoko aɨyʉmʉloile. <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" />Kʉlʉlo kʉʉmʉkʉlya Itunda kʉkɨaisa kakwe kɨkʉlʉ naɨʉkʉpee ʉsese nakanda kʉkɨɨla Ng'waakwe nʉmʉloilwe. <verse eid="EPH 1:6" /><verse number="7" style="v" sid="EPH 1:7" />Kʉkomowe kipolyo nɨla sakami ang'wa Kilisito. Kʉhegeigwe mɨlandʉ kʉnsoko aʉkende wɨdʉ nʉwang'wi Itunda. <verse eid="EPH 1:7" /><verse number="8" style="v" sid="EPH 1:8" />Itunda aɨʉkʉkembetile ʉkende ʉwʉ nʉkʉkɨlɨnkɨɨla.</para>
  <para style="p" vid="EPH 1:8">Kʉmahala nʉ ʉlɨngi wakwe wɨhi. <verse eid="EPH 1:8" /><verse number="9" style="v" sid="EPH 1:9" />Itunda ʉkʉhumilye kʉlɨnge nkani yakwe niya ʉnkunku, naɨʉsɨgɨe kitʉma ikani ɨlɨ kʉkɨɨla Kilisito. <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" />Isɨgo lang'wi Itunda aɨkʉpikɨɨla itungo lakwe wɨkatenda ikani naɨʉloilwe Kilisito wɨkatema intʉ yɨhi ni intʉ yɨhi kigʉlʉ nʉ mʉʉnkumbigʉlʉ.<verse eid="EPH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11" />Mʉ ʉkamɨnkani nʉ Kilisito ʉsese kahoilwe kʉtule kɨantʉ ang'wi Itunda anga mʉng'wenso ʉloewe. Itunda witʉmile makani ɨhi anga mʉloewe. <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />Itunda aɨʉtendile itɨ, kʉnsoko ʉsese nɨ Kɨayahudi naɨkʉtongee kʉmʉhʉɨɨla Kilisito, kʉmʉkʉlye Itunda kʉ ʉkʉlʉ wakwe.<verse eid="EPH 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 1:13" />Nʉnyenye antʉ nɨshanga mɨ Ayahudi, aɨmigulye lʉkani latai, nɨɨza Nkani Nza naɨyɨmʉletee ʉgunwi. Mɨkamʉhʉɨla ʉ Kilisito, nʉyo Itunda kʉlagiɨla kɨna ʉnyenye mɨantʉ akwe, kʉʉkamɨnkani nʉ Kilisito mɨkaɨkɨlwa kɨlɨngasɨɨlyo ka lʉkao lakwe, wɨkamʉpa Ng'wahʉ Ng'welʉ naɨʉlɨɨye ʉkʉmʉpa. <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" />Ng'wahʉ Ng'welʉ nʉwanso wɨkʉsasha kʉsɨngɨɨlye makani ɨhi Itunda naɨʉatambʉɨe ʉkʉapa antʉ akwe, ikani ɨlɨ lɨkʉʉkamɨnkɨɨlya kɨna Itunda ʉkʉakomola antʉ akwe. Ʉsese kʉkʉlye ʉkʉlʉ wang'wi Itunda.<verse eid="EPH 1:14" /></para>
  <para style="s">Paʉlo ʉkʉalompeela Aepeso</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />Kʉpuma naɨnigulye mʉmʉhʉɨɨe Isekʉlʉ Yesʉ nʉʉlowa wanyu kʉ antʉ ɨhi nɨang'wi Itunda, <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" />kwe shanga ndekile kʉmʉlʉmba Itunda kʉnsoko anyu. Nʉmʉkɨmbʉkile nɨkʉmʉlompa Itunda. <verse eid="EPH 1:16" /><verse number="17" style="v" sid="EPH 1:17" />Nongolekile kʉmʉlompa Itunda wang'wi Isekʉlʉ witʉ Yesʉ Kilisito, Tata nʉwi kʉlyo, wamʉpe Ng'wahʉ Ng'welʉ nʉwɨkamʉsasha mʉgombeke kʉng'wakwe nʉ kʉmʉkʉnʉkʉɨla mʉhume kʉmʉlɨnga Itunda. <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />Nɨmʉlompa Itunda walʉgʉle nkolo yanyu mʉsɨngɨɨlye nzelya mʉhume kʉlɨnga isʉmbɨlyo naɨʉaɨkɨɨye nɨsʉmbɨɨlyo naɨʉaɨkɨɨye antʉ akwe. <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />Kʉmʉlompa Itunda mʉmanya ʉhumi wakwe nʉʉkʉlʉ nangalʉ kʉnsoko itʉ ʉsese nɨkʉmʉhʉɨɨe ʉ Kilisito. Ʉhumi nʉwanso nʉwitʉma mɨlɨmo mʉng'witʉ, yimpyani nɨ ngulu nɨnkʉlʉ, <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" />naɨʉmiʉkɨɨye ʉ Kilisito, wamikalɨnsha ipande lakwe nɨla kɨgoha nɨla ʉkʉlʉ. <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" />Ʉmʉɨkile ʉ Kilisito wateme ʉtemi wɨhi nɨ ʉhumi wɨhi nʉ ngulu yɨhi ʉkʉlʉ wɨhi. Ʉmʉpee kʉtema ʉkʉlʉ wɨhi nʉ ʉkolɨ mʉʉnkumbigʉlʉ ʉwʉ nʉ mʉʉnkumbigʉlʉ nʉ ʉpembilye. <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" />Itunda ʉiɨkile intʉ yɨhi yiteng'we nʉ Kilisito hangɨ wamʉtenda watule mʉtongeeli mʉ maintʉ ɨhi kʉnsoko a antʉ nɨamʉhʉɨɨe ʉ Kilisito. <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" />Antʉ nɨamʉhʉɨɨe ʉ Kilisito ingɨ mʉɨlɨ wakwe, nʉ kilisito ng'wenso wɨkondanɨlya intʉ yɨhi.<verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="s">Kʉpuma mʉnsha nʉkingɨla mʉ ʉpanga</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />Ʉnyenye aɨmɨhanga makule kʉnsoko a magazo nɨ mɨlandʉ anyu. <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />Pakalɨ aɨmishiɨ mʉzetyata ntendo nimbɨ niya ʉnkumbigʉlʉ ʉwʉ, mʉzemitʉmɨla mʉkʉlʉ nʉwa ahɨng'wɨ nɨɨza mʉtemi wilunde, nkolo ɨyo nitʉma mʉlɨmo mʉantʉ nɨagila lwijo kʉng'wi Itunda. <verse eid="EPH 2:2" /><verse number="3" style="v" sid="EPH 2:3" />Nʉsese pakalɨ aɨkɨhanga ɨenso, aɨkishiɨ kʉzekʉtyatile kɨlakulaku kitʉ nika ntendo niya mɨlandʉ nʉkitʉma makani ayo naɨloeelya mɨɨlɨ nɨ mahala itʉ. Kʉpʉma ng'wandyo nʉsese ga kʉtugɨwe mʉ mɨlandʉ, aɨkʉtakɨwe kʉpɨsɨɨligwe ni Itunda.<verse eid="EPH 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 2:4" />Ingɨ Itunda waʉkende dʉ nɨkɨaisa kɨkʉlʉ. Aɨʉkʉloilwe ʉsese kʉ ʉlowa nʉʉgila mpyani, <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />itɨ gwa palʉng'wɨ nɨkɨna aɨkakule kʉnsoko amɨlandʉ itʉ, wɨkakʉtenda kʉtule kɨapanga palʉng'wɨ nʉ Kilisito. Kʉʉkende wang'wi Itunda ʉnyenye magunilwe. <verse eid="EPH 2:5" /><verse number="6" style="v" sid="EPH 2:6" />Kʉkamɨnkana nʉ Kilisito Yesʉ, Itunda aɨʉkiʉkilye palʉng'wɨ nʉng'wenso, kende tema palʉng'wɨ nʉ Yesʉ ʉko kigʉlʉ. <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />Itɨ gwa aɨʉloilwe kʉlagɨɨla ʉkʉlʉ nʉwa ʉkende wakwe kʉ antʉ amatungo napembilye naɨʉkʉkendepile kʉ ʉkende kʉ ʉkamɨnkani witʉ nʉ Kilisito. <verse eid="EPH 2:7" /><verse number="8" style="v" sid="EPH 2:8" />Kʉnsoko mʉgunilwe kʉ ʉkende wakwe kʉkɨɨla kʉmʉhʉɨɨla ʉ Kilisito. Ikani ɨlɨ shanga lipumɨɨe mʉngulu yanyu, ingɨ kɨpegwa kʉpuma kʉng'wi Itunda. <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />Leki kikʉlyi kʉnsoko shanga aɨmʉgunilwe kʉpuma mʉntendo yanyu. <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />Ʉsese kʉʉmbilwe ʉpya ni Itunda kʉkɨɨla kʉkamɨnkana nʉ Kilisito Yesʉ kʉhume kitʉma makani nɨmaza mʉlikalo litʉ nʉkʉnoneeleye.<verse eid="EPH 2:10" /></para>
  <para style="s">Mʉhangʉ mʉng'wa Kilisito</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />Itɨ gwa kɨmbʉki naɨmɨlɨ pakalɨ ʉnyenye antʉ nɨshanga mɨ Ayahudi nɨɨmitanga “Shanga atawe kiganda” ingɨ nɨanso iɨla antʉ “Nɨatawe kiganda” kʉnsoko a kɨntʉ nɨatendile mʉmɨɨlɨao. <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />Kɨmbʉki kɨna pakalɨ shanga aɨmʉmʉlɨngile ʉ Kilisito, aɨmʉkomilwe nɨ Aisɨlaeli, mɨkatula mɨageni nɨagila lyoma kʉsɨngɨɨlya malago ɨhi ayo Itunda naɨʉtambʉe kʉ antʉ akwe kɨna ʉkitʉma. Aɨmɨagila isʉmbɨɨlyo hangɨ shanga aɨmʉmʉlɨngile Itunda mʉnʉ mihɨɨ. <verse eid="EPH 2:12" /><verse number="13" style="v" sid="EPH 2:13" />Pang'wandyo ʉnyenye aɨmɨkʉlɨ ni Itunda, ingɨ itungo ɨlɨ makamɨkana nʉ Kilisito Yesʉ, maina mɨpakupɨ kʉkɨɨla sakami ang'wa Kilisito naɨhunʉkile pa mʉsalaba. <verse eid="EPH 2:13" /><verse number="14" style="v" sid="EPH 2:14" />Ingɨ ʉ Kilisito ng'wenso ʉkʉletee matiliga kʉasasha Ayahudi nɨ antʉ nɨ shanga Ayahudi kʉtule ndʉgʉ ɨng'wɨ. Kʉʉpumya mʉɨli wakwe ng'wenso wɨkaheja wilei naɨʉkʉkomile anga ipʉpa. <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" />Kilisito aɨʉhegilye malagɨɨlyo ang'wa Musa palʉng'wɨ nɨmiko akwe, wɨkasasha madale abɨlɨ atule ɨpalʉng'wɨ nahangigwe nʉ Kilisito, kʉtenda itɨ wɨkaleta matiliga kʉng'witʉ. <verse eid="EPH 2:15" /><verse number="16" style="v" sid="EPH 2:16" />Kilisito wɨkaheja wilei kʉ Ayahudi nɨ antʉ nɨshanga Ayahudi, nʉ kʉasasha atule ndʉgʉ ɨng'wɨ, kʉkɨɨla kʉsha kʉng'wakwe mʉmʉsalaba, sʉnga wɨkasasha ndʉgʉ yɨhii niibɨɨlɨ yigombye ni Itunda. <verse eid="EPH 2:16" /><verse number="17" style="v" sid="EPH 2:17" />Kilisito aɨʉzile wɨkatanantya Nkani Nza niya matiliga kʉng'wanyu ʉnyenye nɨshanga mɨ Ayahudi, nɨ antʉ nɨ shanga aɨmʉmʉlɨngile Itunda, mikaaletela hangɨ Nkani Nza nɨ matiliga kʉ Ayahudi nɨamʉlɨngile Itunda. <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />Itigwa, kʉkɨɨla Kilisito, ʉsese kɨhi nɨ kɨ Ayahudi nʉ nyenye nɨshanga mɨ Ayahudi kʉhumile kʉgombeka kʉng'wa Tata kʉ Ng'wahʉ Ng'welʉ.<verse eid="EPH 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19" />Itɨ gwa, ɨtungo ɨlɨ ʉnyenye nɨ shanga mɨ Ayahudi shanga mɨageni hangɨ akɨlanzɨla, ingɨ mɨakolihɨɨ palʉng'wɨ nɨ antʉ ang'wi Itunda, kʉlʉlo mɨantʉ amito lang'wi Itunda. <verse eid="EPH 2:19" /><verse number="20" style="v" sid="EPH 2:20" />Ʉnyenye nɨ mɨahʉɨɨli mʉzengɨlwe migʉlya amʉkuɨla nʉwa itʉmi nɨ amanga, nʉ Kilisito Yesʉ ingɨ ng'wenso wɨhanga igwe nikʉlʉ nɨlɨambɨɨe ɨnyʉmba. <verse eid="EPH 2:20" /><verse number="21" style="v" sid="EPH 2:21" />Nyʉmba ɨhi ɨhongenkanigwe mʉng'wa Kilisito, lɨhongekee kʉtula Nyʉmba angwi Itunda kʉnsoko ang'wi Isekʉlʉ. <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />Kʉkamɨnkana nʉ Kilisito ʉnyenye mɨhi mʉhongekeewe palʉng'wɨ nɨantʉ nɨshanga Ayahudi mishiɨ ni Itunda kʉkɨɨla Ng'wahʉ Ng'welʉ.<verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="s">Mʉlɨmo wang'wa Paʉlo kʉ antʉ nɨshanga Ayahudi</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />Kʉndogoelyo ɨyɨ, ʉnene Paʉlo, nɨntungilwe kʉnsoko akitʉma mʉlɨmo wang'wa Kilisito Yesʉ kʉnsoko anyu nɨshanga mɨ Ayahudi, kʉmʉlompeela kʉng'wi Itunda. <verse eid="EPH 3:1" /><verse number="2" style="v" sid="EPH 3:2" />Mʉlɨngɨle kʉlʉ kʉʉlʉ kɨna Itunda kʉkɨɨla ʉkende wakwe aɨʉmpee mʉlɨmo ʉwʉ nʉmʉtanantɨlye ʉnyenye Nkani Nza. <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />Itunda ʉnkunʉkʉɨe iniino nahuma kʉlɨnga ikani ɨlɨ nɨlipihile. Ikani ɨlɨ nʉmʉandɨkɨe kʉ nkani nkehʉ, <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" />anga mʉsoma nɨnʉmʉandɨkɨkɨe, ʉnyenye mʉkʉlɨnga kɨna ʉnene nʉʉlɨngile ʉnkunku wang'wa Kilisito. <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />Ʉnkunku ʉwʉ anya kalɨ aɨapihɨwe, ingɨ itungo ɨlɨ Itunda waapee ʉhumi itʉmi nɨ amanga akwe kʉlɨnga ʉnkunku nʉwanso kʉkɨɨla Ng'wahʉ Ng'welʉ. <verse eid="EPH 3:5" /><verse number="6" style="v" sid="EPH 3:6" />Ʉnkunku nʉwanso ingɨ sʉwʉ, kʉkɨɨla Nkani Nza, antʉ nɨshanga Ayahudi Itunda ʉkʉakembeta palʉng'wɨ nɨ Ayahudi. Antʉ awa aile mapiliga a mʉɨlɨ ʉng'wɨ hangɨ ihangilye mʉʉkembetwa ʉwʉ Itunda aɨʉtambʉe ʉkʉapa kʉkɨɨla Kilisito.<verse eid="EPH 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7" />Ʉnene naile nɨ mitʉmi nʉwa kʉtanantya Nkani Nza ɨyɨ kʉkɨɨla kɨpegwa ka ʉkende Itunda naɨ ʉnkendepile kʉ ʉhumi wakwe nʉ ʉkʉlʉ. <verse eid="EPH 3:7" /><verse number="8" style="v" sid="EPH 3:8" />Palʉng'wɨ nɨ kɨna ʉnene nɨshanga mbaigwe lʉkʉlʉ mʉ antʉ ɨhi nɨang'wi Itunda, ingɨ wamkembetile ʉkende wakwe, nɨhume kʉatantɨlya antʉ nɨshanga Ayahudi ʉgolɨ wang'wa Kilisito nɨ shanga wakʉganʉla, <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />nʉ kʉakumʉɨla ʉnkunku nʉwanso antʉ alɨnge isɨgo lang'wi Itunda nɨlitʉng'wa. Itunda naɨʉtundile intʉ yɨhi naɨʉpihile kʉ antʉ kʉpuma ɨkalɨ. <verse eid="EPH 3:9" /><verse number="10" style="v" sid="EPH 3:10" />Isɨgo lang'wi Itunda aɨkɨna atemi ɨhi nɨanyangulu ɨhi nɨamolɨ mʉʉnkumbigʉlʉ nʉwa kɨnkolo alɨnge nzɨla yidʉ nʉwɨtʉmɨla kʉlagɨɨla mahala akwe. Akʉlɨnga itɨ kʉkɨɨla antʉ nɨamʉhʉɨɨe ʉ Kilisito. <verse eid="EPH 3:10" /><verse number="11" style="v" sid="EPH 3:11" />Ikani ɨlɨ lendenkanilye nisɨgo Itunda naɨʉkete kʉpuma ɨkalɨ, aɨwitʉma lʉkani lakwe kʉkɨɨla Kilisito Yesʉ Isekʉlʉ witʉ. <verse eid="EPH 3:11" /><verse number="12" style="v" sid="EPH 3:12" />Itɨ gwa, kʉkamɨnkani nʉ Kilisito nʉkʉmʉhʉɨɨla, ʉsese kɨagimyi kʉmʉhanga Itunda ɨze kiahʉɨɨli. <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />Kʉlʉlo, nʉmʉlompile leki kʉkatapi kʉnsoko alwago nɨkagigwa ʉnene kʉnsoko anyu, nanso ingɨ kʉnsoko ikʉlyo lanyu.<verse eid="EPH 3:13" /></para>
  <para style="s">Ʉlowa wang'wa Kilisito</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />Kʉlʉlo, ntugamile nʉkʉlompa pang'wi Itunda Tata, <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />nɨɨza ʉpuumo nʉwa iʉmbwa yɨhi mʉʉnkumbigʉlʉ nʉ kigʉlʉ. <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />Kʉmʉlompa Itunda kʉkɨɨla Ng'wahʉ wakwe wamʉkomelye inkolo yanyu, <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />ingɨ ʉ Kilisito wishiɨ mʉnkolo yanyu kʉkɨɨla ʉhʉɨɨli wanyu. Kʉmʉlompeela kʉng'wi Itunda makani ɨhi nɨmʉkituma apumɨɨla mʉʉlowa nʉwa tai, <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />ingɨ ʉnyenye palʉng'wɨ nɨ antʉ nɨagombekile kʉng'wɨ Itunda mʉlɨnge kɨna ʉ Kilisito ʉkʉloilwe ikʉlʉ kʉ ʉlowa nʉʉgila mɨmbɨ. <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />Hangɨ mʉlɨnge ʉlowa nʉwanso ingɨ nʉʉkɨlɨnkɨe ʉlɨngi nʉwa mʉntʉ wɨhi, mʉhume kʉkondanɨɨla, mʉ ʉkondanɨɨli wɨhi nʉwang'wi Itunda. <verse eid="EPH 3:19" /><verse number="20" style="v" sid="EPH 3:20" />Itunda nʉwitʉma mʉlɨmo mʉng'witʉ, ʉhumile kitʉma makani makʉlʉ kʉkɨla ayo nɨkʉhumile kʉlompa ang'wɨ kʉsɨga, <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />wakʉligwe kʉnsoko a antʉ nɨamʉhʉɨɨe ʉ Kilisito nɨ kʉnsoko ang'wa Kilisito Yesʉ kʉ wileli matungo ɨhi, kalɨ na kalɨ. Tai.<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="s">Ʉkamɨnkani mʉ mʉɨlɨ wang'wa Kilisito</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />Itɨ gwa, ʉnene nɨntungilwe kʉnsoko akʉmitʉmɨla Isekʉlʉ, kʉmʉlompa mishiɨ likalo anga nɨmʉtakɨwe mʉwitangwi wanyu. <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" />Mʉzeleka kikʉlya hangɨ mʉzeleka kʉmalya. Ɨze mɨagimyi nʉkitegeelya kʉ ʉlowa. <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />Kagupi kʉsʉnja ʉkamɨnkani nʉletilwe nʉ Ng'wahʉ Ng'welʉ, kishiɨ palʉng'wɨ kʉ matiliga. <verse eid="EPH 4:3" /><verse number="4" style="v" sid="EPH 4:4" />Ʉkolɨ mʉɨlɨ ʉng'wɨ nʉ Ng'wahʉ ʉng'wɨ, anga Itunda naɨʉmʉhoile mʉtule nisʉmbɨɨlyo lɨng'wɨ du. <verse eid="EPH 4:4" /><verse number="5" style="v" sid="EPH 4:5" />Hangɨ ʉkolɨ Isekʉlʉ ʉng'wɨ nʉ ʉhʉɨɨli ʉng'wɨ nʉ ʉbadisigwa ʉng'wɨ du. <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />Itunda ingɨ ʉng'wɨ hangɨ ingɨ Tata waantʉ ɨhi, nʉtemile maintʉ ɨhi, witʉma mʉlɨmo kʉkɨɨla sese kɨhi hangɨ wishiɨ mʉng'witʉ kɨhi.<verse eid="EPH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7" />Mʉntʉ wɨhi ʉpewe kɨpegwa anga mʉloewe ʉ Kilisito kʉmʉpa. <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" />Yɨyo ndogoelyo wandɨkwa wang'wi Itunda nʉwandɨkilwe,</para>
  <para style="q" vid="EPH 4:8">“Aɨʉlumile migʉlya nangalu,</para>
  <para style="q" vid="EPH 4:8">wɨkahola atungwa,</para>
  <para style="q" vid="EPH 4:8">wɨkaapumya kɨpegwa.”<verse eid="EPH 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="EPH 4:9" />Itɨ gwa nɨyandɨkilwe kɨna, “aɨʉlumile migʉlya nangalu kʉng'wi Itunda,” ndogoelyo akwe ntʉni? Ndogoelyo akwe ingɨ ʉ Kilisito aɨʉsimile hanza mihɨɨ. <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />Kilisito naɨʉsimile mihɨɨ, ng'wenso aɨʉlumile migʉlya kʉkɨla igʉlʉ lɨhi ingɨ watule ʉkolɨ nkɨka yɨhi. <verse eid="EPH 4:10" /><verse number="11" style="v" sid="EPH 4:11" />Kilisito yʉyo “naɨʉapee antʉ ipegwa”, wikaaɨka nɨangɨza kʉtula itʉmi nɨ antʉ ang'wɨ kʉtula amanga nɨ antʉ ang'wɨ kʉtula atanantya Nkani Nza nɨ antʉ ang'wɨ kʉtula adɨmi nɨ antʉ ang'wɨ kʉtula amanyisi. <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />Ingɨ aɨʉtendile itɨ kʉanoneelya antʉ ang'wi Itunda kʉnsoko a mʉlɨmo wakwe nʉwakʉtula akomu anga nʉwɨlɨ ʉmʉɨlɨ wang'wa Kilisito. <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />Nɨitɨ ʉsese kɨhi kʉpikɨɨle mʉhangʉ nʉwa ʉhʉɨɨli nʉkʉmʉlɨnga Ng'wana wang'wi Itunda, kʉtule antʉ nɨakulaa nʉ kʉʉpikɨɨla ʉkondanɨɨli wang'wa Kilisito ng'wenso. <verse eid="EPH 4:13" /><verse number="14" style="v" sid="EPH 4:14" />Itɨ gwa, shanga kʉtula anga ang'enya nɨadabʉ, nʉkʉlutwa nʉ ʉmanyisi wɨdʉ nʉ ʉkʉletwa nɨantʉ nɨɨkongelana ahume kʉalimɨlya antʉ ang'wɨ kʉ ʉmanyisi wao nʉwa ʉteele. <verse eid="EPH 4:14" /><verse number="15" style="v" sid="EPH 4:15" />Kɨmɨkɨɨli kakwe, kʉzitambʉɨla ɨtai kʉ ʉlowa, kʉkʉle mʉ makani ɨhi, nʉkʉmʉpikɨɨla ng'wenso nɨɨza mʉtongeeli ingɨ Kilisito. <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" />Ʉsakilye mʉɨli wɨhi ʉkamɨnkane nʉkʉhongekeelya nʉ mʉkano ʉng'wɨ. Kʉnʉ ipiliga lɨhi litʉma mʉlɨmo wakwe, ɨlɨ lɨsasha mʉɨlɨ wɨhi ʉkʉle nʉkizenga mʉʉlowa.<verse eid="EPH 4:16" /></para>
  <para style="s">Likalo nʉlʉpya nʉ likalo nʉlakalɨ</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />Nkete lʉkani nʉlakʉmʉɨla kʉʉhumi wang'wi Isekʉlʉ, kʉmʉhʉgʉlya, leki kʉlongoleki kishiɨ anga antʉ nɨshanga amʉhʉɨɨe Itunda, antʉ nɨanso masɨgoao nɨɨza mabɨɨ. <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />Antʉ nɨanso agila anga mahala hangɨ akomilwe kʉlɨ nʉ ʉpanga wang'wi Itunda. Kʉnsoko aʉpʉngʉ nʉ lʉgoha lao. <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />Antʉ awa agila mɨnyala itʉma ʉbɨɨ hangɨ aile asambo. Kʉlʉlo alongolekile kitʉma makani ɨhi na ʉdosi.<verse eid="EPH 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20" />Ingɨ ʉnyenye shanga aɨmʉmanyisigwe itɨ apo naɨmamʉlɨnga ʉ Kilisito. <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />Nɨngile ʉnyenye aɨmigulye kɨsa mpola yakwe, hangɨ anga mʉtule mɨahemba akwe mʉmanyisigwe makani atai napumile kʉng'wa Yesʉ. <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" />Aɨmʉmanyisigwe mʉleke ʉʉbɨɨ wanyu nʉwakalɨ anga mʉntʉ nʉkʉtugʉla ngʉo, ntendo yanyu niyakalɨ, naɨimʉgazangilwe nɨkɨlakulaku kakwe nɨka ʉkongelani, <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />mʉnkolo mʉhume kʉtendwa mɨapya mʉmasɨgo nintendo yanyu. <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" />Hangɨ mʉtule nʉlikalo nʉlʉpya anga ni Itunda aɨʉmʉʉmbɨle kimpyana nʉ ng'wenso, ɨze mʉgombekile lʉkʉlʉ nʉkʉleka kʉsokigwa ni Itunda.<verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />Kʉlʉlo leki ʉteele, mʉntʉ wɨhi ʉtakɨwe wazetambʉla ɨtai, kʉnsoko ʉsese kɨhi kɨmapiliga mʉmʉɨlɨ wang'wa Kilisito. <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />Anga mʉhung'we ikuo, mʉleke kʉgomba ikuo lanyu lɨmʉsashe kitʉma mʉlandʉ, hangɨ lyoa lɨleke kʉhaɨɨla ɨze mʉkɨlɨ mʉhumilwe ikuo. <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />Ikuo lɨkʉmʉpa lyoma ʉ Shetani wamʉhume. <verse eid="EPH 4:27" /><verse number="28" style="v" sid="EPH 4:28" />Mʉntʉ wɨhi nɨmii, waleke kia, witʉme mɨlɨmo nɨmɨza kʉmɨkono akwe, walije miaɨlɨlyo akwe nʉkʉmʉgeela mʉkʉmbɨli. <verse eid="EPH 4:28" /><verse number="29" style="v" sid="EPH 4:29" />Leki kʉtambʉli nkani nɨmbɨ, ingɨ mʉzɨtambʉlya nkani ninza nɨyihumile kʉaɨɨlya antʉ nɨangɨza. Itɨ gwa nkani nɨmʉkʉtambʉla yiakendepe antʉ nɨamʉtegeeye. <verse eid="EPH 4:29" /><verse number="30" style="v" sid="EPH 4:30" />Hangɨ leki kʉsashi ʉkɨa kʉ Ng'wahʉ Ng'welʉ wang'wi Itunda. Itunda aɨʉkʉpee Ng'wahʉ Ng'welʉ anga kɨɨkɨli kɨna ʉnyenye mɨantʉ akwe hangɨ kɨna ʉkʉmʉsʉnja kʉpikɨɨla lʉhikʉ nʉkʉmʉkomola. <verse eid="EPH 4:30" /><verse number="31" style="v" sid="EPH 4:31" />Itɨ gwa, leki ʉ wilei, ang'wɨ ikuo nʉ ʉtaki ni iyogo ni itʉki. Mʉleke kitʉma ʉbɨ wɨhi. <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" />Mʉtule nɨ nkolo nza hangɨ mʉntʉ wɨhi wamʉaisɨɨlye ʉmʉya. Milekela anga Itunda naɨʉmʉlekee ʉnyenye kʉkɨɨla Kilisito.<verse eid="EPH 4:32" /></para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="s">Kishiɨ mʉ Nzelya</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1" />Ʉnyenye ingɨ mɨana akwe nʉmuloilwe, kʉlʉlo kagupi kishiɨ anga ng'wenso. <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" />Milowe anga ʉ Kilisito naɨʉkʉloilwe ʉsese, wɨkipumya kʉnsoko itʉ watule isongelyo nipolyo nɨlɨkete ʉnyunkɨɨlyo ʉza nʉʉmʉloeeye Itunda.<verse eid="EPH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3" />Ʉnyenye mɨantʉ ang'wi Itunda, kʉlʉlo makani a ʉsambo nʉ ʉdosi nɨ nsʉla aʉgoolyi shanga atakɨwe kʉlapwa mʉng'wanyu. <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />Hangɨ nkani nɨya mɨnyala nɨ nikani niya ʉpʉngʉ ang'wɨ nkani niya nsasɨla, nkani nianso shanga yinonee mʉng'wanyu. Ingɨ nkani niya kʉmʉlʉmba Itunda zizo yinonee mʉng'wanyu. <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />Manyi lʉkʉlʉ kɨna mʉsambo wɨhi ang'wɨ mʉgoolyi wɨhi ang'wɨ mʉdosi wɨhi, mʉntʉ nʉwitʉma makani nanso shanga ʉkʉlija kɨntʉ kɨhi mʉ ʉtemi wang'wa Kilisito ni Itunda. Mʉntʉ nʉwanso ingɨ mʉkʉlya adʉdʉ.<verse eid="EPH 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 5:6" />Leki kʉmʉgombyi mʉntʉ wɨhi wamʉkonge kʉ nkani niya kɨpʉngʉ, kʉnsoko makani anga nanso Itunda wɨatakɨɨla antʉ nɨagila lwijo. <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />Kʉlʉlo temanʉki nɨ antʉ nɨanso. <verse eid="EPH 5:7" /><verse number="8" style="v" sid="EPH 5:8" />Pakalɨ ʉnyenye aɨmʉkolɨ mʉkiti shanga aɨmʉmʉmanyile Itunda nʉwa tai, kʉʉkamɨnkani ni Isekʉlʉ maile mɨana akwe mʉkolɨ mʉ nzelya. Kʉlʉlo mishiɨ mʉnzelya anga mʉloewe Itunda. <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />Kʉlʉlo nzelya ɨleta ʉkende nʉ kishiɨ likalo nʉlʉgombekile kʉng'wi Itunda nɨ tai. <verse eid="EPH 5:9" /><verse number="10" style="v" sid="EPH 5:10" />Mʉgeme kʉduma makani namʉloeelya Isekʉlʉ. <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />Temanʉki nɨ makani nɨshanga anonee nitʉng'wa nɨantʉ nɨakolɨ mʉkiti, ingɨ atambʉɨli antʉ kɨna makani nanso shanga maza. <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />Makani niitʉng'wa kʉ ʉnkunku ingɨ mɨnyala kʉmatambʉla. <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />Ingɨ ɨkumʉka anga apihʉʉwe nɨnzelya. <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />Kʉnsoko maintʉ ɨhi nakumʉʉwe ɨkaɨlwa nʉkʉtula nzelya. Kʉnsoko yitambʉlwa,</para>
  <para style="q" vid="EPH 5:14">“Pɨtya, ʉewe nʉlae,</para>
  <para style="q" vid="EPH 5:14">wiʉke kʉashi,</para>
  <para style="q" vid="EPH 5:14">Kilisito nʉng'wenso ʉkʉalɨkɨla.”<verse eid="EPH 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />Itɨ gwa ikendegeeli mʉlikalo lanyu nɨmishiɨ. Ishii anga antʉ nɨakete mahala, shanga anga antʉ nɨapʉngʉ. <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" />Kʉlʉnga kɨna tʉmɨli kɨsa lyoma nɨmʉkete, kʉnsoko matungo aya ingɨ aʉbɨ. <verse eid="EPH 5:16" /><verse number="17" style="v" sid="EPH 5:17" />Kʉlʉlo mʉlikalo lanyu mʉleke kʉtula mɨapʉngʉ, Mʉgeme kʉduma makani nɨmʉloeelya Isekʉlʉ.<verse eid="EPH 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 5:18" />Mʉleke kʉgala ntʉlɨ, nɨkʉlimɨlya likalo lanyu, ingɨ mʉteg'we nʉ Ng'wahʉ Ng'welʉ. <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" />Mitambʉlye ʉnyenye kʉ mɨmbo a Zabuli nɨ mɨmbo akʉkʉlya nɨ mɨmbo maʉya natongilwe nʉ Ng'wahʉ Ng'welʉ, mɨmbɨli nʉ kʉmʉkʉlya Isekʉlʉ kʉ nkolo yanyu. <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />Mʉlʉmbi Itunda Tata mʉnkani yɨhi kʉkɨɨla lina lang'wi Isekʉlʉ witʉ Yesʉ Kilisito.<verse eid="EPH 5:20" /></para>
  <para style="s">Agoha nɨ Akɨma</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21" />Mʉntʉ wɨhi wamʉkʉlye mʉya kʉnsoko a ikʉlyo nɨmʉkete kʉng'wa Kilisito.<verse eid="EPH 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22" />Mʉkɨma nʉwatule nʉ lwijo kʉ mʉgohakwe anga kʉtʉla nʉ ʉlwijo kʉng'wi Isekʉlʉ. <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />Kʉnsoko ʉmʉgoha ʉkete ʉhumi kʉ mʉkɨmakwe, anga ʉ Kilisito nɨɨza ʉkete ʉhumi kʉ antʉ nɨamʉhʉɨɨe, hangɨ ʉ Kilisito ng'wenso ʉakomoe antʉ nɨamʉhʉɨɨe, nɨɨza mʉɨlɨ wakwe. <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />Anga antʉ nɨamʉhʉɨɨe ʉ Kilisito nɨakete ʉlwijo kʉng'wa Kilisito, ʉʉgwa nɨakɨma atakɨwe atule lwijo kʉ agohaao mʉ makani ɨhi.<verse eid="EPH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25" />Ʉnyenye agoha, alowi akɨma anyu, anga ʉ Kilisito nɨɨza ʉaloilwe antʉ nɨamʉhʉɨɨe ʉng'wenso wɨkipumya washe kʉnsokoao. <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />Aɨʉkule wahume kʉatenda agombeke kʉng'wi Itunda kʉ lʉkani lakwe, naɨwakondya kʉelisa kʉoja na mazɨ akʉbadisilya, <verse eid="EPH 5:26" /><verse number="27" style="v" sid="EPH 5:27" />wahume kʉlija antʉ nɨamʉhʉɨɨe ʉ Kilisito nɨakomilwe kʉnsoko ang'wi Itunda hangɨ nɨagila igazo lɨhi ang'wɨ kɨntʉ kɨhi nɨkɨbɨ mʉng'wakwe. <verse eid="EPH 5:27" /><verse number="28" style="v" sid="EPH 5:28" />Itɨ gwa agoha atakɨwe alowe akɨmaao anga mɨɨlɨao. Mʉgoha wɨhi nʉmʉloilwe mʉkɨma wakwe wilolwa ʉng'wenso. <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />Kʉtilɨ mʉntʉ wɨhi nʉʉbɨpɨwe ʉmʉɨlɨ nʉwakwe ng'wenso, ingɨ wɨʉlɨsa nʉkʉʉsʉnja, anga ʉ Kilisito wɨalɨsa nʉkʉasʉnja kʉ antʉ nɨamʉhʉɨɨe ʉng'wenso. <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />Kʉnsoko ʉsese kɨmapiliga mʉmʉɨlɨ wakwe. <verse eid="EPH 5:30" /><verse number="31" style="v" sid="EPH 5:31" />Wandɨkwa wang'wi Itunda wandɨkile kɨna, “Mʉgoha ʉkʉmʉleka ihe nʉ nyinya, nʉyo ʉkʉkʉɨla nʉ mʉkɨmakwe antʉ awa nɨabɨɨlɨ akʉtula mʉɨlɨ ʉng'wɨ.” <verse eid="EPH 5:31" /><verse number="32" style="v" sid="EPH 5:32" />Ʉnkunku ʉwʉ ingɨ ʉkʉlʉ, ingɨ ʉnene kʉtambʉla mpola yang'wa Kilisito nɨ antʉ nɨamʉhʉɨɨe ʉng'wenso. <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />Nɨitɨ ga, mʉgoha wɨhi mʉng'wanyu ʉtakɨwe wamʉlowe mʉkɨma wakwe anga nʉwiloilwe, mʉkɨma nʉyo watule nʉ lwijo kʉ mʉgoha wakwe.<verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="s">Ʉmanyisi kʉ Ang'enya nɨ Aleli</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />Ʉnyenye ang'enya, kʉnsoko mʉkamɨnkanile Isekʉlʉ tuli nʉ lwijo kʉ aleli anyu, kʉnsoko ikani ɨlɨ ɨngɨ iza. <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" />Ilagɨɨlyo nɨla ng'wandyo nɨlɨkete ilago lɨlagɨɨye “Mʉkʉlye tataako nʉ iyaako, <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" />ingɨ ʉkendepwe, nʉkishiɨ mahikʉ dʉ mʉnʉ mihɨɨ.”<verse eid="EPH 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 6:4" />Nʉ nyenye nɨ mɨatata, mʉleke kʉatendeela ʉbɨ ɨana anyu, ingɨ mʉalele mʉmahala nʉ ʉmanyisi nʉ ʉlangi naɨmʉsɨngɨɨye kʉpuma kʉng'wi Isekʉlʉ.<verse eid="EPH 6:4" /></para>
  <para style="s">Atʉʉng'wa nɨ Akʉlʉao</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />Ʉnyenye atʉʉng'wa, tuli nʉ lwijo ni kʉlyo kʉ akʉlʉ anyu nɨamʉnʉ mʉʉnkumbigʉlʉ. Hangɨ tendi itɨ kʉnkolo ɨng'wɨ, anga nɨmʉkete lwijo kʉng'wa Kilisito. <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />Tendi itɨ shanga kʉ aloeelya ʉdu akʉlʉ anyu apo nɨakʉmʉona mʉhume kʉmʉkʉɨɨlwa, ingɨ matungo ɨhi. Kʉnsoko ʉnyenye ingɨ mɨatʉʉng'wa ang'wa Kilisito, mitʉme kʉnkolo yanyu makani Itunda nʉmaloilwe. <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />Itʉmi mɨlɨmo anyu, hangɨ mʉlowe kitʉma. Itʉmi anga mʉkʉmitʉmɨla Isekʉlʉ, shanga kʉ antʉ ʉdu. <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />Kɨmbʉki kɨna Isekʉlʉ ʉkʉmʉpa mʉntʉ wɨhi kɨpegwa nʉtendile makani nɨmaza watule mʉtʉʉng'wa ang'wɨ mʉntʉ nʉwidesile.<verse eid="EPH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9" />Nʉ nyenye akʉlʉ, atendeliʉ atʉʉng'wa anyu, leki kʉatambʉɨla makani akʉatumba, kʉnsoko mʉlɨngile kɨna Isekʉlʉ wanyu nʉyʉ nʉ wao ingɨ ʉng'wɨ du hangɨ ʉkolɨ kigʉlʉ, hangɨ shanga wɨkʉɨɨla mʉntʉ ɨhi.<verse eid="EPH 6:9" /></para>
  <para style="s">Tugali yɨgɨ yɨhi niyang'wɨ Itunda</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />Kʉmaɨɨlya kʉtambʉla itɨ, ndoilwe mʉkamatɨke mʉʉkamɨnkani ni Isekʉlʉ nʉ mʉʉhumi nʉwa ngulu yakwe. <verse eid="EPH 6:10" /><verse number="11" style="v" sid="EPH 6:11" />Tugali yɨgɨ yɨhi nɨmʉpewe ni Itunda ingɨ mʉhume kʉgilya ʉhʉgu wɨhi nʉwang'wa Shetani. <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />Kʉnsoko ɨmbita itʉ shanga kʉikʉa nɨ antʉ ingɨ kʉikʉa nɨ anyambita nɨabɨ mʉʉnkumbigʉlʉ nʉwa kɨnkolo. Ʉsese kʉikʉa nʉ ʉtemi nʉ ʉhumi ningulu niya kiti nɨ ahɨng'wɨ nɨakolɨ mʉʉnkumbigʉlʉ nɨshanga wigela. <verse eid="EPH 6:12" /><verse number="13" style="v" sid="EPH 6:13" />Kʉlʉlo tugali yɨgɨ yɨhi Itunda nʉmʉpee ingɨ mʉhume kikʉɨla mʉ matungo aʉbɨ, anga mʉkondye kikʉa mʉkʉlongoleka kʉtula mɨakamatɨku.<verse eid="EPH 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 6:14" />Itɨ gwa, ihambi kʉnʉ taɨ ɨze ɨhanga mɨsipi mʉilɨno yanyu, ni ntendo niigombekile kʉng'wi Itunda yitule anga ngʉla kʉkɨngɨla ikua yanyu. <verse eid="EPH 6:14" /><verse number="15" style="v" sid="EPH 6:15" />Ʉwihambi nʉwa kʉtanantya Nkani Nza niya matiliga ʉtule anga ilatʉ mʉ mɨgʉlʉ anyu. <verse eid="EPH 6:15" /><verse number="16" style="v" sid="EPH 6:16" />Palʉng'wɨ nɨ itɨ ʉhʉɨɨli ʉtule anga ngʉla mʉ mɨkono anyu, ɨmʉaɨɨlye kʉkɨngɨla mɨyɨ ɨhi nɨkete moto nang'wa Shetani. <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" />Sɨngɨɨlyi ʉgunwi wang'wi Itunda ʉtule anga nkompila ashʉma, nʉ lʉkani lang'wi Itunda lʉtule anga nyalahanda nɨmɨpegwa nʉ Ng'wahʉ Ng'welʉ. <verse eid="EPH 6:17" /><verse number="18" style="v" sid="EPH 6:18" />Mʉmʉlompe mahikʉ ɨhi anga Ng'wahʉ Ng'welʉ nʉmʉtongee, mʉ ʉlompi nɨ malompi. Matungo ɨhi mihambe kʉalompeela antʉ ɨhi nɨang'wi Itunda. <verse eid="EPH 6:18" /><verse number="19" style="v" sid="EPH 6:19" />Nompeeli nʉnene ga, ɨngɨ nɨkʉligitya Itunda wanzaɨɨlye kɨntʉ nɨkakʉligitya, ndeke kogopa kʉtanantya tai Itunda nʉɨkile kɨhenga kʉkɨɨla Nkani Nza. <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />Itunda ʉndagɨɨye ntanantye Nkani Nza, palʉng'wɨ nʉ kʉtula nkolɨ mʉkɨtungo. Kʉlʉlo mʉnompeele nihume kʉtanantya kʉʉkamatɨku anga niitakɨwe.<verse eid="EPH 6:20" /></para>
  <para style="s">Mɨlamʉ aʉmalɨnkɨɨlyo</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />Tikiko nɨ mʉnyandʉgʉ witʉ nɨkʉmuloilwe hangɨ mitʉmi nɨ mʉhʉɨɨli mʉʉkamɨnkani ni Isekʉlʉ, ʉkʉmʉɨla makani ɨhi mʉhume kʉlɨnga nongolekiʉlɨ hangɨ kitʉma ntʉni. <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />Nʉmʉlagɨɨye ng'wenso waze wamʉganʉɨle ɨmpola yitʉ, nʉyo wamʉkomelye nkolo.<verse eid="EPH 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23" />Kʉlʉlo anyandʉgʉ ane kʉmʉlompa Itunda Tata ni Isekʉlʉ witʉ Yesʉ Kilisito amʉpe matiliga nʉ ʉlowa nʉ ʉhʉɨɨli. <verse eid="EPH 6:23" /><verse number="24" style="v" sid="EPH 6:24" />Kʉmʉlompa Itunda wamʉkembete ʉnyenye nɨ antʉ ɨhi nɨmʉmʉloilwe Isekʉlʉ witʉ Yesʉ Kilisito kʉ ʉlowa wɨhi nʉʉgila mpelo.<verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>