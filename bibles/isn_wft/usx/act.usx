<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ACT" style="id">- Isanzu Bible Version</book>
  <para style="h">NTENDO</para>
  <para style="toc1">NTENDO NIYA ITɄMI</para>
  <para style="toc2">Ntendo</para>
  <para style="toc3">Nte</para>
  <para style="mt1">Ntendo niya</para>
  <para style="mt2">ITɄMI</para>
  <para style="imt">NTONGEELA AKWE</para>
  <para style="ip">Mbugulu a Ntendo niya Itʉmi ɨganʉe Ahʉɨɨli ang'wa Yesʉ naɨandɨɨye kʉ Yelusalemu nɨitɨ naɨenee kʉ Yʉdea nɨ Samalia nʉkapika nkɨka ngɨza, anga ʉ Yesʉ Kilisito naɨʉtambʉɨe amanyisigwa akwe naɨwakɨlɨ kʉholwa walongole kigʉlʉ. Mʉlango nʉwa 1:8. Mbugulu ɨyɨ ɨandɨkilwe nʉ Lʉka nɨmʉandɨka mbugulu a Nkani Nza anga nɨyandɨkilwe nʉ Lʉka. Lʉka ʉyʉ aɨmʉkilɨki, nʉyo aɨʉkendegee lʉkʉlʉ ɨzewɨkɨsa kʉɨka impola nʉkʉandɨka makani ɨhi kʉ ʉkendegeeli. Mʉandɨkɨlwa nʉwa mbugulu yɨhi izi ni ibɨɨlɨ, niya Nkani Nza nɨ mbugulu a Ntendo niya Itʉmi ingɨ Mʉyunani nʉwitangwa ‘Teopilo.’ Ingɨ ihumɨkile imbugulu izi aɨandɨkɨwe antʉ nɨamʉhʉɨɨe ʉ Kilisito, nɨakumʉkile kɨna Ayunani nɨ Ayahudi. Mʉlango nʉwa 1.1. Ihumɨkile ɨmbugulu a Ntendo niya Itʉmi ɨandɨkilwe mʉ myaka a makʉmi mʉtandatʉ kʉpikɨɨla makʉmi mʉtandatʉ na ɨnnɨ kʉpumɨɨla nʉwatugʉlwa ʉ Yesʉ Kilisito, kʉnsoko ɨmbugulu ɨyɨ ɨkondile ʉ Paʉlo aɨwakɨlɨ kʉlekelwa mʉkadulumu. Lʉka aɨwendile mʉhɨnzo palʉng'wɨ nʉ Mitʉmi Paʉlo, itɨgwa ihumɨkile aɨwandɨkile mbugulʉ ɨyɨ mʉ kɨsalɨ ka Antiokia. Mbugulu a Ntendo ingɨ ʉlongoleki nʉwa mbugulu a Nkani Nza anga nɨyandɨkilwe nʉ Lʉka, kandɨɨye kʉganʉla kʉlongola kigʉlʉ kʉng'wa Yesʉ. Isɨgo lang'wa Lʉka kʉandɨka mbugulu ɨyɨ lɨlongolekile kʉtula lɨlo lɨɨlo naɨ ʉlɨkete naɨ ʉkʉandɨka imbugulu a Nkani Nza. Aʉloilwe ʉ Teopilo, nɨ Ahʉɨɨli ang'wa Yesʉ ɨdʉ naɨ alongolekile kizʉla alije ɨkʉlʉ kʉʉlʉ a nkani nɨakʉmanyisigwa, kʉlʉlo aɨʉandɨlile kʉʉkendegeeli ʉlikalo lang'wa Yesʉ nʉkenela kʉ Ʉkilisito. Mbugulu ɨyɨ na Ntendo niya Itʉmi kɨkʉʉpa ʉsese mpyani a Ahʉɨɨli ang'wa Yesʉ ang'wandyo naɨɨlɨ, nɨitɨ antʉ naɨikae likalo nʉla kʉmʉhʉɨɨla ʉ Yesʉ. Mpyani a itʉmi ɨkʉʉlagɨɨla ʉsese niitakɨwe kʉʉsania ʉhumi nʉwa Ng'wahʉ Ng'welʉ kenelya Nkani Nza kʉ antʉ angɨɨza.</para>
  <para style="iot">Namolɨ</para>
  <para style="io">Nɨka ng'wandyo Ng'wahʉ Ng'welʉ ʉkʉazɨɨla amanyisigwa ang'wa Yesʉ nɨ Ahʉɨɨli ang'wa Yesʉ naɨongeelekile. Mʉlango nʉwa 1:1-8-1</para>
  <para style="io">Sʉnga Ahʉɨɨli ang'wa Yesʉ ɨkakɨɨla mʉmatungo anzala nʉ lwago, nɨ Ahʉɨɨli ang'wa Yesʉ ɨkongeeleka kʉkɨla imɨmbɨ niya Yelusalemu. Mʉlango nʉwa 8:2-12-23.</para>
  <para style="io">Naɨakɨla nanso Paʉlo wɨkalongola mʉhɨnzo wakwe nʉwa ng'wandyo nʉwa kutanantya Nkani Ninza. Mʉlango nʉwa 12:24-14-28.</para>
  <para style="io">Sʉnga ianza lɨkatankana kʉ Yelusalemu nʉ kʉlamʉla inkani kɨɨ ni nkʉlʉ niyitakɨwe kʉ ahʉɨɨlɨ nɨapya. Mʉlango nʉwa 15:1-35.</para>
  <para style="io">Nɨ kɨtyatɨɨe Paʉlo ʉkʉlongola mʉhɨnzo wakwe nʉwa kabɨɨlɨ kutanantya Nani Nza. Mʉlango nʉwa 15:36-18-22.</para>
  <para style="io">Naɨakɨla nanso Paʉlo wɨkalongola mʉhɨnzo wakwe nʉwa kataatʉ nʉwa Nkani Nza. Mʉlango nʉwa 18:23-20-38.</para>
  <para style="io">Panyambele Paʉlo ʉkʉambɨlwa kʉ Yelusalemu. Mʉlango nʉwa 21-26.</para>
  <para style="io">Ʉmaɨɨlyo Paʉlo wɨkatalwa kʉ Lʉmi. Mʉlango nʉwa 27-28.</para>
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1" />Ʉadɨ Mʉkʉlʉ Teopilo,</para>
  <para style="p" vid="ACT 1:1">Mʉmbugulu ane naɨntongee kʉʉandɨkɨla aɨnʉkʉandɨkɨe makani ɨhi ʉ Yesʉ naɨ ʉmanyisilye nʉ kʉtenda kʉpumɨɨla ʉ wandɨɨlyo nʉa mʉlɨmo wakwe, <verse eid="ACT 1:1" /><verse number="2" style="v" sid="ACT 1:2" />kʉpikɨɨla lʉhikʉ ʉlo naɨ ʉhoilwe kilunde. Naɨ wakɨlɨ kʉholwa kilunde ʉ Yesʉ aɨʉalagɨɨye makani akitʉma kʉkɨɨla Ng'wahʉ Ng'welʉ itʉmi akwe awo naɨʉahoile. <verse eid="ACT 1:2" /><verse number="3" style="v" sid="ACT 1:3" />Mahikʉ makʉmi annɨ kʉpuma naɨ wiʉkile, aɨʉkenda agendeela waze akomya nkolo kɨna waina mʉpanga hangɨ. Aɨakenda mʉona kɨhenga nʉyo wazeatambʉɨla makani a Ʉtemi wang'wi Itunda. <verse eid="ACT 1:3" /><verse number="4" style="v" sid="ACT 1:4" />Itungo lɨng'wɨ naɨatankanile palʉng'wɨ aɨʉalagɨɨye kɨna, “Mʉleke kʉhega mʉ Yelusalemu, mʉlindɨɨle kɨpengwa ɨko naɨmʉnigulye kʉmʉɨla kɨna ʉ Tata wane ʉkʉmʉpa. <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" />Yohana Mʉbadisi aɨwɨbadisɨlya mazɨ, mahikʉ makeehʉ napembilye ʉnyenye mʉkʉbadisigwa kʉ Ng'wahʉ Ng'welʉ.”<verse eid="ACT 1:5" /></para>
  <para style="s">Yesʉ ʉkʉholwa kʉlongola kigʉlʉ</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />Sʉnga Itʉmi naɨikiɨ palʉng'wɨ nʉ Yesʉ ɨkamʉkolya, “Isekʉlʉ, itungo lɨlone nʉʉkʉasʉkɨɨlya Aisilaeli ʉ ʉtemi?”<verse eid="ACT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 1:7" />Ingɨ Yesʉ wɨkaaɨla, “Tata du nʉlɨngile, mahikʉ nɨ matungo akʉtula nalɨ, shanga mʉlɨmo wanyu kʉlɨnga, nanso ʉmaɨkile mʉhumi wakwe. <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" />Ingɨ mʉkʉsɨngɨɨlya ʉhumi anga wamʉzɨɨle ʉ Ng'wahʉ Ng'welʉ, nʉ nyenye mʉkʉtula mɨakʉɨɨli ane kʉ Yelusalemu, mihɨɨ ɨhi na Yʉdea nɨ Samalia nʉ ʉnkumbigʉlʉ wɨhi.” <verse eid="ACT 1:8" /><verse number="9" style="v" sid="ACT 1:9" />Naɨ wakondya kʉtambʉla nianso, ɨhi akaze amʉgozee, Yesʉ wɨkaholwa migʉlya ilunde lɨkamʉsɨngɨɨlya nʉkʉmʉpiha shanga ɨkamʉona hangɨ.<verse eid="ACT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 1:10" />Naɨ akɨlɨ agozee kilunde, Yesʉ naɨ ʉlongoe, kolwa itʉnja abɨɨlɨ atugae ngʉo melʉ pee ɨkimɨka pakupɨ nɨenso, <verse eid="ACT 1:10" /><verse number="11" style="v" sid="ACT 1:11" />ɨkalʉnga, “Ʉnyenye antʉ akʉ Galilaya, haɨ ka mimɨkile mʉgozee kigʉlʉ? Yesʉ ʉyʉ nɨmʉmʉine ʉhoilwe kʉpuma kʉng'waanyu, nɨmʉine ʉlongoe kigʉlʉ ʉ ʉzɨɨza tulya.”<verse eid="ACT 1:11" /></para>
  <para style="s">Matia wɨkasopela pa lyoma lang'wa Yʉda</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />Sʉnga Itʉmi nɨanso ɨkatulya kʉ Yelusalemu kʉpuma mʉlʉgʉlʉ nʉla Mɨzeitʉni, lʉgʉlʉ naɨ lʉkolɨ pakupɨ nɨ Yelusalemu, anga lʉgendo la kilomɨta ɨng'wɨ itɨ kʉpuma mʉ kɨsalɨ nɨkanso. <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" />Naɨingɨla mʉ kɨsalɨ, ɨkanankɨla mʉgolopwa mʉnɨndo kishiɨ. Itʉmi nɨanso ingɨ a Petelo nʉ Yohana nʉ Yakobo nʉ Andelea nʉ Pilipo nʉ Tomaso nʉ Batilimayo nʉ Matayo nʉ Yakobo ng'wana wang'wa Alipayo nʉ Simoni Zelote nʉwɨmɨkʉɨɨla ihɨɨ akwe nʉ Yʉda ng'wana wang'wa Yakobo. <verse eid="ACT 1:13" /><verse number="14" style="v" sid="ACT 1:14" />Awa ɨhi aɨalongolekile mʉmalompi a palʉng'wɨ, mʉasʉngʉ, aɨʉkolɨ Maliamu nyinya wang'wa Yesʉ nɨasʉngʉ ang'wɨ, nɨ aheu ang'wa Yesʉ.<verse eid="ACT 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15" />Lʉhikʉ lʉng'wɨ mʉ mahikʉ nanso ahʉɨɨli ang'wa Yesʉ naɨ ilʉndɨɨe azelompa, antʉ nɨanso aɨatuile anga igana lɨng'wɨ nɨ makʉmi abɨɨlɨ, Petelo naɨʉng'wɨ mʉ ahʉɨɨli wɨkimɨka pakatɨ a anyandʉgʉ nɨamʉhʉɨɨe ʉ Yesʉ, wɨkalʉnga, <verse eid="ACT 1:15" /><verse number="16" style="v" sid="ACT 1:16" />“Anyandʉgʉ ane, Ʉandɨkwa nʉ Ʉza aza ʉtakɨwe ʉpikɨɨle, anga ʉ Ng'wahʉ Ng'welʉ naɨʉtambʉe kʉkɨɨla Daudi, kɨna ʉ Yʉda yʉyo aɨʉatongee antʉ awo naɨ amʉambile ʉ Yesʉ. <verse eid="ACT 1:16" /><verse number="17" style="v" sid="ACT 1:17" />Yʉda aɨmɨitʉ, kʉnsoko aɨʉhoilwe nʉ Yesʉ watule mɨitʉ mʉ mʉlɨmo ʉwʉ.”<verse eid="ACT 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 1:18" />Yʉda aɨʉgʉile mʉgʉnda kʉ mpia izo nimbɨ, naɨ ʉkolɨ kʉng'wanso kʉ mʉgʉnda wɨkagwa pihɨ, wɨkatumbʉka, nɨmala akwe ɨhi ɨkapumɨla kʉnzi. <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />Ikani ɨlɨ lɨkakumʉka kʉantʉ ɨhi nɨishiɨ mʉ Yelusalemu, mʉgʉnda nʉanso ʉkitangwa kʉ kɨnyitolao, “AkelDama,” ndogoelyo ake, “Mʉgʉnda nʉwa sakami.”<verse eid="ACT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20" />Petelo wɨkalʉnga “Itɨ gwa, yandɨkilwe mʉ mbugulu a Zabuli.</para>
  <para style="q" vid="ACT 1:20">‘Nyʉmba akwe ɨtule makumʉʉlʉ,</para>
  <para style="q" vid="ACT 1:20">mʉntʉ wɨhi nʉaleke kishiɨ mʉng'wanso.’</para>
  <para style="m" vid="ACT 1:20">Nɨ hangɨ yandɨkilwe.</para>
  <para style="q" vid="ACT 1:20">‘Mʉntʉ mʉngɨɨza nʉasopele pa lyoma lakwe.’<verse eid="ACT 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 1:21" />Kʉlʉlo, waholwe mʉntʉ ʉng'wɨ wihanje nʉsese, kʉpumɨɨla mʉantʉ awo naɨkɨkʉɨlania matungo ɨhi Isekʉlʉ ʉ Yesʉ naɨ kɨpalʉng'wɨ,<verse eid="ACT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 1:22" />kʉpuma lʉhikʉ ʉlo Yohana naɨ ʉmʉbadisilye ʉ Yesʉ, kʉpikɨɨla lʉhikʉ ʉlo Yesʉ naɨʉhoilwe kʉlongoligwa kilunde. Mʉntʉ ʉyʉ ʉkutula mʉkʉɨɨli kʉtanantya wiʉki wang'wa Yesʉ.”<verse eid="ACT 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23" />Papo gwa, ɨkaata itunja abɨɨlɨ, nʉa ng'wandyo Yusupu nʉitangwaa Balisaba ang'wɨ Yusito, nʉa kabɨɨlɨ Matia. <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />Sʉnga ɨkamʉlompa Itunda, “Isekʉlʉ, ʉewe ʉalɨngile nkolo niya antʉ awa ɨhi. Itɨ gwa, ʉkʉlagɨɨle nʉʉlɨ mʉantʉ awa nɨ abɨɨlɨ nʉmʉhoile <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />wahume kʉsopela pa mʉlɨmo nʉʉlekilwe nʉ Yʉda nʉendile kʉine ng'wenso.” <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />Ɨkakʉa bʉnkʉlʉ bʉnkʉlʉ, wɨkaholwa Matia, yʉyo wɨkongeeligwa mʉ itʉmi awo ni ikʉmi na ʉng'wɨ.<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="s">Kʉza kʉ Ng'wahʉ Ng'welʉ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />Naɨlapika lʉhikʉ liloeelya nɨla <note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="ft" closed="false">pentekosite ingɨ mahikʉ makʉmi ataano kʉpuma pasaka</char></note>pentekosite, antʉ naɨamʉhʉɨɨe ʉ Yesʉ Kilisito aɨilʉndɨɨe palʉng'wɨ. <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />Pumpulugu akija lʉli anga mʉlulumo ʉkʉlʉ kʉpuma kilunde, anga lʉli nʉla ng'wega ʉkizʉlya mʉnyʉmba ɨhi naɨ ikiɨ. <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />Sʉnga, yɨkigela intʉ nɨ yihanga nzahɨ niya moto, ɨkagalanʉka nʉkʉmikaɨla mitwe ng'waa mʉntʉ wɨhi mʉng'wanso. <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />Antʉ ɨhi ɨkatongwa nʉ Ng'wahʉ Ng'welʉ, ɨkatula ligitya ntambʉ ngɨɨza anga Ng'wahʉ naɨ ʉahumilye.<verse eid="ACT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5" />Kʉng'wanso kʉ Yelusalemu aɨakolɨ Ayahudi nɨamʉhʉɨɨe Itunda, naɨ apembeeye mahɨɨ ɨhi mʉ ʉnkumbigʉlʉ. <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />Antʉ naɨ igulye lʉli ʉlʉ nʉla ng'wega, antʉ ɨhi ɨkamanka ɨkapembya kaɨakolɨ ɨahʉɨɨli ang'wa Yesʉ, ɨkakʉɨlwa nangaluu kʉnsoko antʉ ɨhi aɨigulye ntambʉ akwe ɨkʉtambulwa nɨahʉɨɨli ang'wa Yesʉ. <verse eid="ACT 2:6" /><verse number="7" style="v" sid="ACT 2:7" />Antʉ ɨkakʉɨlwa, nʉkitumba akitambʉlya, “Itɨɨ, awa ɨhi nɨkʉʉija akʉtambʉla itɨ, shanga anya kʉ Galilaya ne? <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />Yatula ʉlɨgwa ʉsese kɨhi kʉʉija akʉligitya kɨnyitaitʉ? <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />Ʉsese nɨkʉmolɨ apaɨti kɨanya kʉ Paliti nɨang'wɨ kʉ Media nʉkʉ Elamu, nɨangɨza anya kʉ Mesopotamia nʉ kʉ Yʉdea nʉ kʉ Kapadokia nʉ kʉ Ponto nʉ kʉ Asia. <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />Akolɨ anya kʉ Paligia nʉ kʉ Pampilia nʉ kʉ Misili nɨnkɨka akʉ Libia pakupɨ nɨ Kilene, nɨazɨɨla kʉpuma kʉ Lumi, <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />Ayahudi nɨ antʉ nɨkʉhʉɨɨe dini a Kiyahudi, nɨang'wɨ apumile kʉ Kilete ihɨɨ nɨpilimilwe nɨ mazɨ nʉ kʉ Alabu. Ʉsese kɨhi kʉigulye antʉ awa akʉtambʉla kɨnyitaitʉ, kɨhi kʉkʉɨwe makani makʉlʉ aʉkʉɨlwa nʉtendile Itunda kʉ ntambʉ yitʉ.” <verse eid="ACT 2:11" /><verse number="12" style="v" sid="ACT 2:12" />Atʉ ɨhi ɨkakʉɨlwa nʉkitumba kʉnʉ azikolya, “Ndogoelyo a makani aya ntʉni?<verse eid="ACT 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 2:13" />Ingɨ nɨang'wɨ ɨka asensa, ɨkalʉnga, “Antʉ awa agaile ntʉlɨ.”<verse eid="ACT 2:13" /></para>
  <para style="s">Petelo ʉkʉatanantɨlya antʉ lʉkani lang'wi Itunda</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />Sʉnga ʉ Petelo wɨkapumɨla mʉitʉmi aʉya nikʉmi naʉng'wɨ, wɨkitʉnta wɨkaaɨla, “Ʉnyenye adɨ mihɨ aluna ane Ayahudi, nʉnyenye mɨhi nɨmishiɨ mihɨɨ a Yelusalemu, tegeelyi kɨsa inkani yane mʉlɨnge ndogoelyo ikani ɨlɨ. <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />Antʉ awa shanga agaile anga ʉnyenye nɨmʉsɨgile, kʉnsoko itungo ɨlɨ ikɨlɨ saa taatʉ kɨdaʉdaʉ. <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />Ingɨ ɨtai ikani ɨlɨ, aɨlɨtambʉwe nʉ Yoeli mʉmanga wang'wi Itunda kɨna,<verse eid="ACT 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 2:17" />Itunda ʉlɨɨye,</para>
  <para style="q" vid="ACT 2:17">“Mʉ mahikʉ ampelo,</para>
  <para style="q" vid="ACT 2:17">Kʉahumya kʉ Ng'wahʉ wane mʉ antʉ ɨhi.</para>
  <para style="q" vid="ACT 2:17">Agalimanga nɨ ananso anyu akʉpumya ʉmanga,</para>
  <para style="q" vid="ACT 2:17">ahʉmba anyu akʉona mɨloto,</para>
  <para style="q" vid="ACT 2:17">nɨanyampala anyu akʉlota ndoti.<verse eid="ACT 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ACT 2:18" />Kʉlʉ kʉʉlʉ itʉmi ane ga nɨakɨgoha nawa nɨakɨkɨma,</para>
  <para style="q" vid="ACT 2:18">kʉahumya kʉ Ng'wahʉ wane,</para>
  <para style="q" vid="ACT 2:18">nɨenso akʉpumya ʉmanga.<verse eid="ACT 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ACT 2:19" />Nʉnene kigeelya mɨʉkʉɨlwa migʉlya kilunde,</para>
  <para style="q" vid="ACT 2:19">nɨ kɨlɨngasɨɨlyo pihɨ mihɨɨ,</para>
  <para style="q" vid="ACT 2:19">yɨkʉtula nɨ sakami nʉ moto nʉ lyʉki lʉlito,<verse eid="ACT 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ACT 2:20" />lyoa lɨkʉgiɨligwa nɨ kiti,</para>
  <para style="q" vid="ACT 2:20">nʉng'weli ʉkʉtula ʉkaʉku anga sakami,</para>
  <para style="q" vid="ACT 2:20">ɨze lʉkɨlɨ kʉza lʉhikʉ lang'wi Isekʉlʉ nʉla kʉtulya.<verse eid="ACT 2:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ACT 2:21" />Pang'wanso, mʉntʉ wɨhi nʉʉkʉlompa ʉgunwi kʉpuma kʉng'wi Isekʉlʉ, ʉkʉgunwa.’<verse eid="ACT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22" />“Ʉnyenye Aisilaeli, tegeelyi inkani izi nɨkʉmʉɨla. Yesʉ Mʉnazaleti, mʉntʉ ʉyʉ aɨʉɨkilwe kɨhenga kʉng'waanyu kɨna ʉhumi wakwe aɨwang'wi Itunda, kʉkɨɨla mɨʉkʉɨlwa ni kɨlɨngasɨɨlyo, Itunda naɨ ʉtendile kʉ ʉhumi wakwe kʉng'waanyu, anga nɨmʉlɨngile. <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" />Itunda aɨʉlamʉe kʉ masɨgo akwe kɨna ʉ Yesʉ mʉkʉmʉbʉlaga, nʉ nyenye mɨkaalekeela alʉgʉ amʉkome mʉ mʉsalaba. <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" />Sʉnga Itunda aɨʉmiʉkilye, wɨkamʉkomola mʉ ʉwai nʉa nsha, kʉnsoko shanga aɨihumɨkile lʉkʉlʉ ɨsha ɨmʉgiɨlye. <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" />Kʉnsoko ʉ Daudi aiʉtambʉe itɨ,</para>
  <para style="q" vid="ACT 2:25">‘Mahikʉ ɨhi nɨmʉona Isekʉlʉ ʉkolɨ pantongela ane,</para>
  <para style="q" vid="ACT 2:25">ʉkolɨ ipande lane nɨla ʉhumi, shanga kʉhingɨɨka.<verse eid="ACT 2:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ACT 2:26" />Kʉlʉlo, nkolo ane iloile,</para>
  <para style="q" vid="ACT 2:26">nʉ lʉlɨmɨ lane lʉkʉkʉa ngiligili kʉ ʉlowa.</para>
  <para style="q" vid="ACT 2:26">Nʉ mʉɨlɨ wane,</para>
  <para style="q" vid="ACT 2:26">ʉkikiɨ ɨze ʉsʉmbɨɨye,<verse eid="ACT 2:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ACT 2:27" />kʉnsoko ʉewe Isekʉlʉ Itunda shanga ʉkʉmɨleka nkolo ane kʉ ʉlʉngʉ,</para>
  <para style="q" vid="ACT 2:27">ang'wɨ mʉsanigwa nʉwako waole mʉ kɨbɨɨla.<verse eid="ACT 2:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ACT 2:28" />Wandagɨɨla nzɨla nɨntongile kʉ ʉpanga,</para>
  <para style="q" vid="ACT 2:28">pantongeela ako nalija ʉlowa.’<verse eid="ACT 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29" />“Anyandʉgʉ ane Aisilaeli, ndoilwe nʉmʉɨle kʉlʉ kʉʉlʉ a makani naɨamʉhangɨle ʉgʉkʉ witʉ ʉ Daudi. Nʉanso aɨʉkule wɨkaɨkwa, kɨbɨɨla kakwe nɨsambʉnayʉ kɨlolɨ pang'witʉ. <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />Ingɨ ʉ Daudi aɨmʉmanga, hangɨ aɨʉlɨngile kɨna Itunda ʉmʉlapɨe ʉng'wɨ mʉʉtugwa wakwe ʉkʉmikalɨnsha mituntu nɨla ʉtemi anga ʉ Daudi. <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />Daudi aɨʉtongee kʉona makani nakʉpumɨla nʉ Yesʉ Kilisito ʉkiʉka. Apo naɨ ʉtambʉe kɨna,</para>
  <para style="q" vid="ACT 2:31">“Itunda shanga ʉkʉmʉleka kʉ ʉlʉngʉ,</para>
  <para style="q" vid="ACT 2:31">ang'wɨ mʉɨlɨ nʉwa mʉsanigwa wakwe ʉole.<verse eid="ACT 2:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="ACT 2:32" />“Itunda yʉyo aɨʉmiʉkilye ʉ Yesʉ nʉsese kɨ akʉɨɨli ikani nɨlanso. <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />Yesʉ naɨwaholwa nʉkʉɨkwa ipande nɨla ʉhumi nɨlang'wi Itunda, nʉ kʉhumigwa Ng'wahʉ Ng'welʉ, anga Tata naɨ ʉlapile, yʉyo ʉkʉpee ʉhumi anga nɨmʉkʉona nʉkija itungo ɨlɨ. <verse eid="ACT 2:33" /><verse number="34" style="v" sid="ACT 2:34" />Daudi ng'wenso shanga aɨʉhoilwe kenda kigʉlʉ, ingɨ ʉtambʉe,</para>
  <para style="q" vid="ACT 2:34">‘Isekʉlʉ Itunda aɨʉmʉɨe Isekʉlʉ wane,</para>
  <para style="q" vid="ACT 2:34">Ikiɨ ipande lane nɨla ʉhumi,<verse eid="ACT 2:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="ACT 2:35" />kʉpikɨɨla nʉkʉhumye ʉateme alʉgʉ ako.’<verse eid="ACT 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36" />“Kʉlʉlo Aisilaeli ɨhi alɨnge kɨna kʉlʉ kʉʉlʉ ʉyʉ yʉyʉ Yesʉ naɨ mʉmʉkomile mʉ mʉsalaba, Itunda ʉmʉtendɨle kʉtula Isekʉlʉ hangɨ Kilisito.”<verse eid="ACT 2:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37" />Ʉʉgwa antʉ naɨigulye nkani izi, ɨkaalɨka mʉ nkolo yao, ɨkamʉkolya ʉ Petelo nɨ itʉmi aʉya, “Aluna itʉ, itungo ɨlɨ kʉtende ʉlɨ?”<verse eid="ACT 2:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 2:38" />Petelo wɨkaasʉkɨɨlya, “Mɨhi mile itʉnʉ, nʉ kʉmʉsʉkɨla Itunda, mʉbadisigwe mɨhi kʉlina lang'wa Yesʉ Kilisito mʉhume kʉhegeligwa mɨlandʉ anyu, sʉnga mʉsɨngɨɨlye ilago nɨla Ng'wahʉ Ng'welʉ. <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />Kʉnsoko, ilapo nɨlanso aɨkʉnsoko anyu nɨ anaanyu nʉ kʉ antʉ nɨshanga Ayahudi, nʉ kʉ antʉ ɨhi nɨ itangilwe ni Isekʉlʉ Itunda witʉ.”<verse eid="ACT 2:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40" />Petelo wɨkalongoleka kʉ ahʉgʉlya antʉ kʉ nkani yakwe waze akomangɨɨla ɨantʉ wazeligitya, “Lɨponi ikuo nɨla wɨleli ʉwʉ nʉ ʉbɨ.” <verse eid="ACT 2:40" /><verse number="41" style="v" sid="ACT 2:41" />Lʉhikʉ nʉlanso antʉ naɨahʉʉɨe lʉkanɨ lang'wa Petelo ɨkabadisigwa antʉ elupu itaatʉ ɨkongeeleka mʉahʉɨɨli ang'wa Yesʉ. <verse eid="ACT 2:41" /><verse number="42" style="v" sid="ACT 2:42" />Antʉ awa ɨhi ɨkalongoleka kʉtegeelya nʉ kʉmanyisigwa nʉwa itʉmi nʉkʉtula nʉ mʉhangʉ nɨaʉya, ɨkihangʉɨla nʉ kʉlya indya palʉng'wɨ nʉ lʉdya lang'wi Isekʉlʉ palʉng'wɨ nʉ kʉlompa.<verse eid="ACT 2:42" /></para>
  <para style="s">Likalo nʉla antʉ nɨamʉhʉɨɨe ʉ Kilisito</para>
  <para style="p">
    <verse number="43" style="v" sid="ACT 2:43" />Antʉ ɨhi ɨkingɨɨlwa nʉ woa kʉ ʉkʉɨlwa ni kɨlɨngasɨɨlyo naɨ yitʉmilwe nɨ itʉmi antʉ ɨhi ɨkamʉhʉɨɨla Itunda. <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" />Ahʉʉɨli ang'wa Yesʉ Kilisito ɨhi ɨkikalanɨa nʉ kʉhangʉɨla insao yao. <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />Aɨkenda gʉlya nsao nɨ maintʉao naɨakete nʉkomoelana impia anga mʉaloewe. <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />Ɨkalongoleka kʉtankana palʉng'wɨ mahikʉ ɨhi pa Nyʉmba ang'wi Itunda, itungo nɨlakʉlya aɨɨlɨzania kʉ matolao ɨkalɨzania ndya kʉʉlowa wɨhi nɨ nkolo nzelʉ pe, <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />azemʉkʉlya Itunda, nʉ kʉaloa antʉ ɨhi. Mahikʉ ɨhi Isekʉlʉ Itunda wɨkongeelya ahʉɨɨli ang'wa Yesʉ Kilisito nawa naɨ akʉkomowe.<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="s">Petelo ʉkʉmʉkomya kɨtele kʉ lina lang'wa Yesʉ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />Lʉhikʉ lʉng'wɨ mpɨndɨ anga saa kenda itɨ, Petelo nʉ Yohana aɨalongoe mʉ malompi pa Nyʉmba ang'wi Itunda. <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />Matungo nanso antʉ aɨamʉkekile mʉntʉ kɨtele mʉʉtugwa wakwe, aɨʉkenkilwe nʉkʉtengemekwa pa mʉlango nʉa Nyʉmba ang'wi Itunda nʉitangwa “Mʉlango nʉ Ʉza,” wahume kʉlompa waaɨligwe mpia nɨantʉ nɨakingɨla pa Nyʉmba ang'wi Itunda. <verse eid="ACT 3:2" /><verse number="3" style="v" sid="ACT 3:3" />Kɨtele ʉyʉ naɨ waaona a Petelo nʉ Yohana ahumbeela kingɨla pa Nyʉmba ang'wi Itunda, wɨkaalompa amʉpe mpia. <verse eid="ACT 3:3" /><verse number="4" style="v" sid="ACT 3:4" />Petelo nʉ Yohana ɨkamʉdʉbɨɨla, sʉnga Petelo wɨkamʉɨla, “Kʉgoze ʉsese.” <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />Kɨtele ʉyʉ wɨkaapɨlʉkɨla, wazeʉsʉmbɨɨye kʉlija kɨntʉ kʉpuma kʉng'wao. <verse eid="ACT 3:5" /><verse number="6" style="v" sid="ACT 3:6" />Papo ʉ Petelo wɨkamʉɨla, “Nɨmʉgila mpia niyakʉʉpa, ingɨ ɨkɨ nɨnkete kɨko kʉʉpa. Kʉlina lang'wa Yesʉ Kilisito nʉa kʉ Nazaleti, imɨke, ʉlongole.” <verse eid="ACT 3:6" /><verse number="7" style="v" sid="ACT 3:7" />Sʉnga Petelo wɨkamʉamba kɨtele nʉwanso mʉkono nʉwa kɨgoha, wɨkamʉʉsha. Papo paapo malu nɨ mang'weng'we akwe ɨkakoma. <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />Wɨkimɨka, wɨkatula genda nʉkʉputangila. Sʉnga ɨkingɨlania nɨa Petelo nʉ Yohana pa Nyʉmba ang'wi Itunda nʉ kʉmʉkʉlya Itunda. <verse eid="ACT 3:8" /><verse number="9" style="v" sid="ACT 3:9" />Antʉ ɨhi naɨ akolɨ pang'wanso naɨamʉona ʉkʉgenda nʉ kʉmʉkʉlya Itunda, <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />naɨamʉmanya kɨna yʉyo kɨtele naɨ izɨɨe kʉmʉona wɨɨkwa nʉkilompisa pa mʉlango nʉa Nyʉmba ang'wa Itunda nʉitangwaa “Mʉlango nʉ Ʉza,” ɨkakʉɨlwa nanguluu shanga ɨkalɨnga nɨkɨmʉpantɨkile.<verse eid="ACT 3:10" /></para>
  <para style="s">Petelo ʉkʉtanantya pa Nyumba ang'wi Itunda</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />Kɨtele naɨʉkomigwe ɨkakʉɨlania nɨ a Petelo nʉ Yohana, antʉ ɨhi ɨkakʉɨlwa ɨkatula mankɨɨla pa kɨanda kang'wa Solomoni. <verse eid="ACT 3:11" /><verse number="12" style="v" sid="ACT 3:12" />Petelo naɨ waona itɨ wɨkaatambʉɨla, “Ʉnyenye Aisilaeli, nɨkɨ mʉkʉɨwe ɨkani ɨlɨ itɨ? Haɨ ka mʉkʉgozee itɨ, ituile anga kʉ ʉhumi witʉ ang'wɨ kʉ ʉkende witʉ kamʉtendeela ʉmʉntʉ ʉyʉ wahume kʉgenda? <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />Itunda nʉwa agʉkʉ itʉ, Ibulahimu nʉ Isaka nʉ Yakobo, ʉmʉkʉiye mitʉmi wakwe ʉ Yesʉ. Nʉwanso yʉyo ʉnyenye naɨmʉmʉsuɨpile nʉkʉmʉhita ntongeela ang'wa Pilato, nɨ itɨ Pilato aɨʉlamʉe watungʉɨlwe walongole. <verse eid="ACT 3:13" /><verse number="14" style="v" sid="ACT 3:14" />Ʉnyenye aɨmʉmʉhitile Yesʉ hangɨ nɨ Mʉkende, mɨkalowa mʉpegwe mʉntʉ nɨ mʉbʉlagani. <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />Itɨ gwa mɨkamʉbʉlaga ʉyo nɨ ng'wandyo nʉwa ʉpanga, Itunda ingɨ wɨkamiʉsha. Ʉsese kɨakʉɨɨli a makani nanso. <verse eid="ACT 3:15" /><verse number="16" style="v" sid="ACT 3:16" />Kʉhʉɨɨla lina lang'wa Yesʉ kɨko kɨmʉpee ngulu mʉntʉ ʉyʉ nɨmʉmʉine hangɨ mʉmʉmanyile. Ʉhʉɨɨli wakwe kʉng'wa Yesʉ wʉwo ʉmʉponilye lʉkʉlʉ ʉmʉntʉ ʉyʉ anga nɨmʉine.<verse eid="ACT 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17" />“Itungo ɨlɨ aluna ane, nɨngile kɨna aɨmʉmʉtendee ʉ Yesʉ kʉnsoko shanga aɨmʉlɨngile, anga atongeeli anyu naɨatendile. <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />Ingɨ kʉkɨɨla nzɨla ɨyɨ Itunda ʉkamɨnkɨɨye lʉkani naɨ ʉtanantilye ɨkalɨ kʉkɨɨla amanga akwe ɨhi, kɨna ʉ Kilisito wakwe wagigwe. <verse eid="ACT 3:18" /><verse number="19" style="v" sid="ACT 3:19" />Ingɨ mile itʉnʉ, mʉmʉsʉkɨle Itunda, wahume kʉmʉlekela mɨlandʉ anyu. <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />Itʉmi nanso Isekʉlʉ wamʉpeze matungo akiloa nʉkʉmʉlagɨɨlya ʉ Yesʉ Kilisito naɨ ʉmʉhoile kʉnsoko anyu. <verse eid="ACT 3:20" /><verse number="21" style="v" sid="ACT 3:21" />Naɨ ʉtakɨwe kʉsaga kigʉlʉ ahume kʉpika matungo akʉnonigwa ʉpyaa maintʉ ɨhi, anga Itunda naɨʉtambʉe kʉkɨɨla amanga akwe nɨelʉ kʉpuma wandɨɨlyo nʉa ʉnkumbigʉlʉ. <verse eid="ACT 3:21" /><verse number="22" style="v" sid="ACT 3:22" />Musa nʉyo aɨʉtambʉe, ‘Isekʉlʉ Itunda wanyu ʉkʉmʉleta mʉmanga wakwe anga ʉnene kʉpuma mʉ aluna anyu, mʉtakɨwe kʉmija yʉyo mʉnkani ɨhi nʉkʉmʉɨla. <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />Mʉntʉ wɨhi nɨshanga ʉkʉmija ʉ mʉmanga ʉyʉ nʉ wang'wi Itunda, ʉkʉkong'wa nɨ antʉ ang'wi Itunda nʉ kʉbʉlaga.’ <verse eid="ACT 3:23" /><verse number="24" style="v" sid="ACT 3:24" />Amanga ang'wi Itunda ɨhi kandɨɨlya Samweli nawa ɨhi naɨ atyatilye, aɨatambʉe nʉkʉpumya ʉmanga nʉwa makani nɨɨkatendeka mahikʉ aya. <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />Ʉnyenye maile mɨana a amanga hangɨ ana ilago anga Itunda naɨ wilagile nɨ agʉkʉ anyʉ, wazemʉɨla ʉ Ibulahimu, ‘Kʉkɨɨla wileli wako, ndʉgʉ yɨhi mʉ ʉnkumbigʉlʉ yɨkʉkembetwa.’ <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />Itunda, naɨ wakondya kʉmiʉsha Mitʉmi wakwe, wɨkatongela kʉmʉlagɨɨlya kʉ ng'waanyu, ingɨ wamʉkembete mʉntʉ wɨhi mʉ ng'waanyu nʉ kʉmʉpa ʉhumi nʉwakʉleka kitʉma ʉbɨ.<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="s">Petelo nʉ Yohana pianza nɨla anyampala</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />Petelo nʉ Yohana naɨ alongolekile kʉatanantɨlya ɨantʉ, apolyi nʉ mʉkʉlʉ nʉwa amboi a Nyʉmba ang'wɨ Itunda palʉng'wɨ nɨ Asadukayo ɨkaahanga. <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />Aɨatakile kʉnsoko itʉmi awa aɨakʉamanyisa antʉ nʉkʉatanantɨlya kɨna ʉ Yesʉ aɨwiʉkile, ikani nɨlɨkumʉʉe kɨna mʉng'wa Yesʉ ashi akiʉkigwa. <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />Kʉɨtɨ gwa, ɨkaamba a Petelo nʉ Yohana kʉnsoko ʉtikʉ aɨwila ɨkaalugaɨla mʉkadulumu, ɨkaɨka antʉ aasʉnje kʉpikɨɨla mʉdaʉao. <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />Ingɨ antʉ ɨdʉ mʉawo naɨatageeye lʉkani naɨatanatilye a Petelo nʉ Yohana ɨkahʉɨɨla, itʉnja ʉdu naɨ ahʉɨɨe aɨanga elupu itaano.<verse eid="ACT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5" />Naɨwela mʉdaʉao, atongeeli a Ayahudi nɨ anyampala nɨ amanyisi a malagɨɨlyo ang'wa Musa ɨkilʉnda palʉng'wɨ ʉko kʉ Yelusalemu. <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />Mianza nɨlanso aɨʉkolɨ mʉpolyi nʉ mʉkʉlʉ ʉ Anasi nʉ Kayapwa nʉ Yohana nʉ Alekisanda nɨ antʉ aʉya nɨa ndʉgʉ a Mʉpolyi nʉ mʉkʉlʉ. <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />Ɨkaimɨsha a Petelo nʉ Yohana pa ntongeela ianza, ɨkaakolya, “Ʉnyenye mʉkitʉma ikani ɨlɨ kʉ ʉhumi kɨɨ ang'wɨ kʉ ʉhumi wang'wa nyenyu?”<verse eid="ACT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 4:8" />Papo, Petelo, kʉ ngulu niya Ng'wahʉ Ng'welʉ, wɨkaaɨla, “Atongeeli nɨ anyampala a antʉ! <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />Anga mʉkʉʉkolya lelo ikani ɨlo nʉtendeewe kɨtele ʉyʉ nɨ itɨ nʉahuma kʉkomigwa, <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />itɨ gwa, ʉnyenye nɨ Aisilaeli mɨhi mʉtakɨwe mʉlɨnge kɨna, mʉntʉ ʉyʉ wimɨkile mʉpanga pa ntongeela anyu lelo, kʉ ʉhumi nʉwa lina lang'wa Yesʉ Kilisito ʉnyenye naɨ mʉmʉkomile mʉ mʉsalaba, Itunda ingɨ wɨkamiʉsha. <verse eid="ACT 4:10" /><verse number="11" style="v" sid="ACT 4:11" />esʉ ʉyʉ yʉyo Ʉandɨkwa nʉ Ʉza nʉʉandɨlile kɨna,</para>
  <para style="q" vid="ACT 4:11">‘Igwe ɨlo nɨmʉlɨhitile ʉnyenye azengi,</para>
  <para style="q" vid="ACT 4:11">Itungo ɨlɨ laina Igwe ikʉlʉ nɨlakandɨɨlya kʉzengela nyʉmba.’<verse eid="ACT 4:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ACT 4:12" />Yesʉ du yʉyo ʉhumile kʉaguna ɨantʉ, kʉnsoko mʉnʉ mihɨɨ kʉtilɨ lina nɨkʉpewe nɨlɨhumile kʉʉguna.”<verse eid="ACT 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13" />Anyampala awo nɨianza, naɨ aʉona ʉʉkamatɨkʉ nʉwa a Petelo nʉ Yohana nʉkʉlɨnga kɨna shanga asomile hangɨ agila ʉlɨngi wɨhi ɨkakʉɨlwa nangalʉʉ. Ɨkalɨnga kɨna a Petelo nʉ Yohana ɨpalʉng'wɨ nʉ Yesʉ. <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />Ingɨ naɨ aona kɨna kɨtele nʉkomilye wimɨkile palʉng'wɨ nɨa Petelo nʉ Yohana, ɨkaleng'wa kikʉngʉmya kɨntʉ kɨhi. <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />Itɨgwa, anyampala ɨka azunsa a Petelo nʉ Yohana ahege pianza, nɨanso ɨkasaga itegete. <verse eid="ACT 4:15" /><verse number="16" style="v" sid="ACT 4:16" />Anyampala ianza ɨkikolya, “Kʉatande ʉlɨ antʉ awa? Mʉntʉ wɨhi nʉishiɨ mʉ Yelusalemu walɨngaa kɨna ipɨlʉ ɨlɨ litʉng'waa, ʉsese kʉʉleng'wa kikʉngʉmya. <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />Ingɨ anga kʉhie kʉgilya ikani ɨlɨ lɨleke kenela mʉ antʉ, kʉakanie aleke kitambʉlya nʉ mʉntʉ wɨhi kʉlina lang'wa Yesʉ.”<verse eid="ACT 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 4:18" />Kʉlʉlo akʉlʉ nɨanyampala ɨkaitanga a Petelo nʉ Yohana ingɨle mianza, ɨkaakania aleke kitambʉlya nɨ antʉ mʉ welela, ang'wɨ kʉlongoleke kʉmanyisa kʉlina lang'wa Yesʉ. <verse eid="ACT 4:18" /><verse number="19" style="v" sid="ACT 4:19" />Ingɨ a Petelo nʉ Yohana ɨkaasʉkɨɨlya, “Lamʉli nyenye ntongeela ang'wi Itunda, anga ɨzetai kʉmʉtegeelya ʉnyenyene ang'wɨ kʉmʉtegeelya Itunda. <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />Ingɨ ʉsese shanga kʉhumile kʉleka kʉtambʉla ɨmakani ayo naɨkigulye nʉ kʉmaona.” <verse eid="ACT 4:20" /><verse number="21" style="v" sid="ACT 4:21" />Itɨgwa, anyampala awa nɨianza ɨkaakania kʉ ʉtaki, sʉnga ɨkaaleka alongole. Ɨkaleng'wa kʉapɨsɨɨlya kʉnsoko antʉ ɨhi aɨaina mʉkʉlya Itunda kʉnsoko ikani nɨlanso. <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />Mʉntʉ ʉyʉ naɨ ʉkomigwe aɨwilika nɨlɨkɨile myaka makʉmi annɨ.<verse eid="ACT 4:22" /></para>
  <para style="s">Ahʉɨɨli ang'wa Yesʉ akʉmʉlompa Itunda waongeelye ngulu</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />Papo paapo naɨalekelwa ʉdu, Petelo nʉ Yohana ɨkaasʉkɨla ɨaʉya, ɨkaaganʉɨla nkani naiatambʉɨwe nɨapolyi nɨakʉlʉ nɨanyampala. <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />Antʉ awa naɨija ʉdu impola niyanso ɨhɨ palʉng'wɨ ɨkitʉnta ɨzemʉlompa Itunda, ɨzelʉnga, “Ʉewe Isekʉlʉ, wɨmʉtundi igʉlʉ ni ihɨɨ nʉ lʉzɨ naya ɨhi namolɨ! <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />Ʉewe aɨʉmʉɨkile mitʉmi nʉwako, gʉkʉ witʉ ʉ Daudi, watambʉle kʉ ʉhʉmi nʉwa Ng'wahʉ Ng'welʉ,</para>
  <para style="q" vid="ACT 4:25">‘Kʉnɨkɨ anyaɨngʉ akiaja?</para>
  <para style="q" vid="ACT 4:25">Antʉ ka akitʉma masɨgo a nakanda?<verse eid="ACT 4:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ACT 4:26" />Atemi a mihɨɨ ihambile,</para>
  <para style="q" vid="ACT 4:26">nɨ atemi ɨkatankana palʉng'wɨ,</para>
  <para style="q" vid="ACT 4:26">kigidɨɨla ni Isekʉlʉ nʉ kigidɨɨla nʉ Kilisito wakwe.’<verse eid="ACT 4:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="ACT 4:27" />“Kʉlʉ kʉʉlʉ Helode nʉ Pontio Pilato palʉng'wɨ nɨ ndʉgʉ Aisilaeli nɨ antʉ nɨshanga Ayahudi atankanɨe pa kɨsalɨ ɨkɨ, kʉ mikʉngʉmya mitʉmi nʉwako Yesʉ naɨ ʉhoilwe watule Kilisito. <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />Itʉmi aɨatankanile ahume kʉtenda makani ayo naɨ ʉsɨgile nʉkʉnoneelya kʉpuma ng'wandyo apumɨle kʉ ʉhumi nʉ ʉlowa nʉ wako. <verse eid="ACT 4:28" /><verse number="29" style="v" sid="ACT 4:29" />Itungo ɨlɨ ingɨ, ʉewe Isekʉlʉ, kolwa nɨakʉʉtʉmba. Kʉʉkʉlompa ʉkʉmhʉmye ʉsese atʉʉng'wa ako kʉtanantye lʉkani lako kʉ ʉkamatɨku ʉkʉlʉ. <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />Lagɨɨlya ʉʉhumi wako ʉakomye alwae. Itʉme ilɨngasɨɨlyo nɨ mɨʉkʉɨlwa kʉ lina lang'wa Yesʉ Mitʉmi wako nɨ Ng'welʉ.”<verse eid="ACT 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31" />Naɨ akondya kʉlompa, kɨanda ɨko naɨ ilʉndɨɨe kɨkahingɨsigwa, ɨhi pang'wanso akizʉligwa Ng'wahʉ Ng'welʉ. Ɨhi ɨkatula tanantya ʉlʉkani lang'wi Itunda kʉ ʉkamatɨku.<verse eid="ACT 4:31" /></para>
  <para style="s">Antu nɨamʉhʉʉɨe ʉ Yesʉ ɨkishiɨ anga antʉ a ndʉgʉ ɨng'wɨ</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />Antʉ ɨhi naɨ ahʉʉɨe ɨkatula palʉng'wɨ nʉkitʉma makani ɨhi kʉnkolo ɨng'wɨ. Aɨkʉtɨlɨ mʉntʉ wɨhi naɨ ʉkete kɨntʉ kɨhi wɨkakɨɨka kɨtule nsao akwe wɨng'wene, ingɨ maintʉ ɨhi naɨ akete ɨkatula a mʉhangʉ. <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" />Itʉmi aɨatambʉɨe ɨantʉ nkani nɨya wɨʉki wang'wɨ Isekʉlʉ Yesʉ, ngulu nʉ ʉkende wang'wi Itunda wɨkatula mʉng'waao. <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />Kʉtɨlɨ anga mʉntʉ wɨhi naɨ ʉkepewe kɨntʉ, kʉnsoko awo naɨ akete mɨgʉnda ang'wɨ nyʉmba aɨagʉiye nʉ kʉleta <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />ɨkʉtala mpia nianso kʉ itʉmi, itʉmi nawo ɨkaomolania ɨantʉ anga mʉʉhiɨlwa wakwe.<verse eid="ACT 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36" />Pang'wanso aɨʉkolɨ mʉntʉ ʉng'wɨ nʉwa ndʉgʉ a Alawi, ʉtugɨwe kʉ Kʉpolo, lina lakwe Yusupu, itʉmi aɨɨmitanga Balinaba, ʉng'waao “Mʉntʉ nʉɨkomelania nkolo.” <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />Nʉng'wenso ga aɨʉkete mʉgʉnda wɨkagʉlya, mpia nɨanso naɨ ʉpatile wɨkaapa itʉmi.<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="s">Anania nʉ Sapila akʉlongopa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />Aɨʉkolɨ Mʉntʉ ʉng'wɨ witangwa Anania palʉng'wɨ nʉ mʉkɨma wakwe Sapila nɨenso aɨagʉiye mʉgʉnda. <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />Ingɨ Anania wɨkabagʉla nʉkʉpiha mpia ying'wɨ naɨagʉiye mʉngʉnda, kʉnʉ mʉkɨma wakwe waze ʉlɨngile, mpia naɨisagile wɨkatala nʉkʉapa itʉmi. <verse eid="ACT 5:2" /><verse number="3" style="v" sid="ACT 5:3" />Itɨ gwa, ʉ Petelo wɨkamʉkolya, “Anania, nɨkɨ wamʉgombya ʉ Shetani wingɨla mʉnkolo ako? Wapembya kʉmʉkongela Ng'wahʉ Ng'welʉ, kʉpiha mpia ying'wɨ nʉgʉiye mʉgʉnda? <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />Naza ʉkɨlɨ kʉgʉlya mʉgʉnda nʉanso ingɨ aza wako, napo naza wagʉlya mpia niyanso aza yako aza ʉhumile kʉitendela mʉloewe. Nɨkɨgwa, nkolo ako alamʉla ibɨ kʉtenda ikani ɨlɨ? Shanga ʉmʉkʉkongee anga mʉntʉ, ingɨ ʉmʉkongee Itunda.” <verse eid="ACT 5:4" /><verse number="5" style="v" sid="ACT 5:5" />Anania naɨwija nkani ɨlɨ, wɨkagwa pihɨ wɨkasha. Antʉ ɨhi naɨ igule ikani ɨlɨ ɨkogopa nangaluu. <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />Sʉnga ahʉmba ɨkaʉka nʉ kʉʉimba sanda mʉimba wakwe, ɨkamʉpumya kʉnzi ɨkʉmʉtuhɨɨla mʉkɨbɨɨla.<verse eid="ACT 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7" />Naɨakɨla masaa ataatʉ itɨ, mʉkɨma wang'wa Anania wɨkaze shanga aɨʉlɨngile nɨlɨpumɨe, wakingɨla mʉnyʉmba. <verse eid="ACT 5:7" /><verse number="8" style="v" sid="ACT 5:8" />Petelo wɨkamʉkolya, “Ntambʉɨle! Ɨtɨɨ, taine zizidu mpia naza mʉgʉiye mʉgʉnda wanyu?” Mʉsʉngʉ wang'wa Anania wɨkamʉsʉkɨɨlya, “Ee, zizo ʉdu.”<verse eid="ACT 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9" />Papo Petelo wɨkamʉɨla, “Yatulaʉlɨ ʉewe nʉ mʉgohako migombya kʉmʉgema Ng'wahʉ Ng'welʉ wangwɨ Isekʉlʉ? Tegeelya ahʉmba awo naza endile mʉtuhɨɨla ʉmʉgohako, itungo ɨlɨ akolɨ pamʉlango akʉʉhola nʉewe ga.” <verse eid="ACT 5:9" /><verse number="10" style="v" sid="ACT 5:10" />Papo paapo, Sapila wɨkagwa pa mɨgʉlʉ ang'wa Petelo wɨkasha. Ahʉmba nɨanso naɨingɨla ɨkaona wakondaa kʉsha, ɨkamʉpumya kʉnzi, ɨkamʉtuhɨɨla mʉ kɨbɨɨla pakupɨ nʉ mʉgoha wakwe. <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />Milʉndo nʉ ahʉɨɨli ang'wa Yesʉ ang'wa Kilisito nɨ antʉ naɨ ija makani nikani nɨlanso ɨkaambwa woa ʉkʉlʉ.<verse eid="ACT 5:11" /></para>
  <para style="s">Itʉmi akʉakomya antʉ ɨdʉ</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />Itʉmi ɨkatenda ilɨngasɨɨlyo nɨ mɨʉkʉɨlwa ɨdʉ mʉantʉ. Ahʉɨɨli ang'wa Yesʉ Kilisito aɨɨtankania nkʉa ɨdʉ pa Nyʉmba ang'wi Itunda nkɨka nitangwa “Kɨanda kang'wa Solomoni.” <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />Kʉtilɨ mʉntʉ wɨhi naɨ wakɨlɨ kʉmʉhʉɨɨla ʉ Yesʉ naɨʉgemile kʉkamantana nɨenso, aɨɨatetemba. <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />Antʉ nɨangɨɨza ɨkongeeleka kʉmʉhuɨɨla Isekʉlʉ Yesʉ, itʉnja kʉ asʉngʉ. <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />Makani naɨ atendilwe nɨitʉmi aɨiaatendile ɨantʉ ɨkatula atala alwae mʉ mapanda nʉkʉalambaalya mʉ ʉlɨlɨ niipalatʉ ingɨ Petelo nʉ kʉkɨɨla mʉlimilimi wakwe ʉaluɨɨlye nɨang'wɨao akomigwe. <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />Antʉ ɨdʉ kʉpumɨɨla mʉisalɨ nɨyampelo mpelo a Yelusalemu ɨkatula aleta alwaeao nawoga naɨ akete ɨahɨng'wɨ, ɨhi ɨkakomya.<verse eid="ACT 5:16" /></para>
  <para style="s">Itʉmi akagigwa</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />Sʉnga, mʉpolyi nʉ mʉkʉlʉ nɨaʉya naɨ idale nɨa Asadukayo naɨ apang'wanso, ɨkatula aonela wɨlu itʉmi. <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />Itɨ gwa, ɨkaamba itumi, ɨkaatunga mʉkadulumu. <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />Ingɨ ʉtikʉ Malaɨka wang'wi Isekʉlʉ wɨkalʉgʉla ɨmɨlango akadulumu, wɨkaapumya kʉnzi, wɨkaaɨla, <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />“Longoli mimɨke pa Nyʉmba ang'wi Itunda mʉatambʉɨle ɨantʉ makani ɨhi a likalo ʉlʉ nʉla kʉkamantana nʉ Yesʉ.” <verse eid="ACT 5:20" /><verse number="21" style="v" sid="ACT 5:21" />Itʉmi ɨkija, daʉ maniambwa ɨkingɨla pa Nyʉmba ang'wi Itunda, ɨkandya kʉmanyisa.</para>
  <para style="p" vid="ACT 5:21">Nai wingɨla ʉ mʉpolyi nʉ mʉkʉlʉ niaʉya, akaitanga palʉng'wɨ ianza nila anyampala niakʉlʉ nɨ anyampala a Aisilaeli, papo gwa ɨkaalagɨɨlya antʉ aalete iitʉmi kʉpuma mʉkadulumu. <verse eid="ACT 5:21" /><verse number="22" style="v" sid="ACT 5:22" />Antʉ awa naɨ alagɨigwe naɨapika mʉkadulumu shanga ɨkaahanga ɨitʉmi. Ʉʉgwa ɨtatulya, ɨkapisha mpola izi kʉ anyampala ianza, <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />azelʉnga, “Kʉpikile pa kadulumu kahanga ɨmɨlango ɨlugaɨwe amboi akʉsʉnja pa milango. Nɨkalʉgʉla milango ʉdu kingɨla mʉ nyʉmba shanga kʉhangɨle anga mʉntʉ wɨhi.” <verse eid="ACT 5:23" /><verse number="24" style="v" sid="ACT 5:24" />Mʉkʉlʉ nʉwa amboi a Nyʉmba ang'wi Itunda nɨ apolyi nɨ akʉlʉ nazaigulye ʉdu impola izi ɨkingɨilwa nʉ woa, ɨkahita kʉlinga nɨkɨahangɨle. <verse eid="ACT 5:24" /><verse number="25" style="v" sid="ACT 5:25" />Mʉntʉ ʉng'wi ɨkapika, wɨkaatambʉila, “Antʉ awo naza mʉalugaie mʉkadulumu, itungo ɨlɨ akolɨ pa Nyʉmba ang'wi Itunda akʉmanyisa antʉ.” <verse eid="ACT 5:25" /><verse number="26" style="v" sid="ACT 5:26" />Papo gwa mʉkʉlʉ nʉa amboi akadulumu palʉng'wi ni antʉ akwe wɨkalongola pa Nyʉmba ang'wi Itunda, akaaleta. Ingɨ shanga ɨkaamba kʉ ngulu kʉnsoko aɨogopile kɨna akʉkʉwa magwe nɨ antʉ.<verse eid="ACT 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 5:27" />Itɨ gwa, ɨkaatala ɨ itumi nʉkʉimɨsha ntongeela ianza. Mʉpolyi nʉ mʉkʉlʉ wɨkaakolya. <verse eid="ACT 5:27" /><verse number="28" style="v" sid="ACT 5:28" />“Aza kʉmʉhitɨɨye kʉmanyisa kʉlina lang'wa Yesʉ, itugo ɨlɨ ihɨɨ ihi na Yelusalemu enela ʉmanyisi wanyu nʉa lina lang'wa Yesʉ hangɨ mʉkʉhiya kʉʉkinyila kʉ antʉ kɨna sese kʉsakilye ɨnsha ang'wa Yesʉ.” <verse eid="ACT 5:28" /><verse number="29" style="v" sid="ACT 5:29" />Papo ʉ Petelo, aze wipalʉng'wi ni itʉmi aʉya, wɨkasʉkiilya, “Itakɨwe kʉmʉkele Itunda, kʉkɨla ana a atʉ. <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />Itunda nʉwa agʉkʉ itʉ aiʉmiʉkilye ʉ Yesʉ, ʉyʉ ʉnyenye naɨ mʉmʉbʉlagile nʉkʉmʉkoma mʉ mʉsalaba. <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />Mʉntʉ nʉanso yʉyo Itunda naɨ ʉmʉkʉiye nʉpikɨɨla kʉmʉika ipande lakwe nɨla ʉhumi, wɨkatula mʉtongeeli hangɨ mʉguni, waahʉmye Aisilaeli ile itʉnʉ, ahume kʉlekelwa ɨ milandʉao. <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />Ʉsese kɨ akʉɨɨli ikani nɨlanso, nʉ Ng'wahʉ Ng'welʉ ʉyʉ ni Itunda ʉapee awo nɨamʉkee, nʉyo mʉkʉɨɨli mikani ɨlɨ.”<verse eid="ACT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33" />Anyampala ɨhi nianza naɨija nkani nɨanso, ɨkahung'wa ikuo nangaluu, ɨkisɨja kʉabʉlaga itʉmi nɨanso. <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />Mʉpalisayo ʉng'wi witangwaa Gamalieli nɨɨza mʉmanyisi nʉa malagɨɨlyo ang'wa Musa naiʉsanigwe niantʉ ihi, wɨkimɨka ntongeela ianza nɨlanso, wɨkalagɨɨlya itʉmi apʉmigwe kʉnzi ki itungo iniino. <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />Sʉnga wɨkaatambʉila anyampala ianza, “Ʉnye Aisilaeli ɨane, hʉgʉki, nɨmʉkili kitʉma ikani ɨlɨ nimʉtakile kʉatendeela ɨantʉ awa! <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />Matungo nakɨile, aiʉpʉmie mʉntʉ ʉng'wi witangwaa Teuda, wɨkazikʉmʉsha kɨna mʉntʉ nʉsanigwe ni antʉ magana annɨ ɨkakʉila palʉng'wi. Ingɨ wɨkabʉlagwa, sʉnga ahemba akwe ɨkabalansana lʉkumo lakwe lɨkaʉla papo. <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />Ni panyambele, itungo nɨla kʉaligwa antʉ, wɨkigela Yʉda mʉnya kʉ Galilaya, nʉyʉ wɨkatongeela antʉ, nʉ ng'wenso ga wɨkabʉlagwa, ahemba akwe ɨhi ɨkabalansana. <verse eid="ACT 5:37" /><verse number="38" style="v" sid="ACT 5:38" />Nʉnene ga itungo ɨlɨ kʉmʉhʉgʉla temanʉki nɨ antʉ awa, aleki alongole, kʉnsoko anga ize masigo aya ang'wɨ mʉlimo ʉwʉ wandigwe nʉ mʉntʉ, ʉkʉlimansɨɨla ʉwenso. <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />Ingɨ anga ize mʉlɨmo ʉwʉ wadigwe ni Itunda, shanga mʉhumile kʉagilya antʉ awa, ingɨ mʉkʉhanga maina ikʉngʉma ni Itunda.” Itɨ gwa anyianza ɨkigombya nʉ ng'wenso. <verse eid="ACT 5:39" /><verse number="40" style="v" sid="ACT 5:40" />Itɨgwa itʉmi ɨkitangwa ingɨle mianza, ɨkalagɨɨlya akʉwe milanga nʉkʉɨlwa apele kʉmanyisa hangɨ kʉ lina lang'wa Yesʉ, sʉnga ɨkaaleka alaongole. <verse eid="ACT 5:40" /><verse number="41" style="v" sid="ACT 5:41" />Itɨ gwa, itʉmi awa ikapuma kʉnzi ianza aze iloile, kʉnsoko Itunda aɨʉakʉiye kʉaleka ahumigwe minyala kʉkɨɨla lina lang'wa Yesʉ. <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />Mahikʉ ɨhi ɨkalongoleka kʉmanyisa nʉ kʉtanantya Nkani Nza pa Nyʉmba ang'wi Itunda nʉ mʉnyʉmba niya antʉ kɨna Yesʉ yʉyo Kilisito.<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="s">Antʉ mʉpungatɨ akʉholwa kʉaɨɨlya itʉmi</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />Matungo nanso, amanyisigwa ang'wa Yesʉ ɨkalongoleka kongeeleka, ʉkigela ʉnang'ani kʉpuma kʉ Ayahudi a kʉ Yunani ɨkaanang'anɨla Aebulanɨa kɨna mahikʉ ɨhi asʉngʉ a Kɨyunani nɨashɨɨwe nɨagoha ɨkong'wa pa ʉgalani nʉwandya. <verse eid="ACT 6:1" /><verse number="2" style="v" sid="ACT 6:2" />Kʉlʉlo itʉmi awo ni ikʉmi na abɨɨlɨ, ɨkaitanga ahʉɨɨli ang'wa Yesʉ ɨhi, ɨkalʉnga, “Shanga iza ʉsese kʉleke kʉtanantya lʉkani lang'wi Itunda kɨmɨɨle ʉgalani nʉwandya. <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />Itɨgwa aluna itʉ, holi antʉ mʉpungatɨ mʉng'waanyu, antʉ nɨakete ngulu a Ng'wahʉ Ng'welʉ nɨ mahala nʉ lʉkumo lʉza, ʉsese kʉʉalekela mʉlɨmo ʉwʉ. <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />Ʉsese kʉ ʉlongoleka kʉlompa nʉ kitʉma mʉlɨmo nʉa kʉtanantya ʉlʉkani lang'wɨ Itunda.” <verse eid="ACT 6:4" /><verse number="5" style="v" sid="ACT 6:5" />Lʉkani nʉlanso lʉkaaloa ianza lɨhi nɨla ahʉɨɨli ang'wa Yesʉ. Ɨkamʉhola Sitepwano mʉntʉ naɨ ʉmʉhʉʉɨe nangulu Itunda hangɨ nʉizʉe ngulu Ng'wahʉ Ng'welʉ. Pilipo nʉ Pʉlokolo nʉ Nikanoli nʉ Timoni nʉ Pelimena nʉ Nikolao nʉa kʉ Antokia naɨ ʉpilukile mʉnzɨla a Kiyahudi. <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />Ɨkaaɨka pa ntongeela a ɨtumi, itʉmi ɨkaalompeela nʉ kʉakembeta kʉnʉ azeaɨkɨɨlya mɨkono mʉ matwe.<verse eid="ACT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7" />Lʉkani lang'wi Itunda lɨkongeleka kenela, antʉ ɨdʉ naɨahʉɨɨe ʉ Yesʉ ɨkongeeleka kʉ Yelusalemʉ nɨ apolyi a Kiyahudi ɨdʉ ɨkahʉɨɨla.<verse eid="ACT 6:7" /></para>
  <para style="s">Sitepwano ʉkʉambwa</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />Sitepwano aɨmʉntʉ nʉkembetilwe ni Itunda ningʉlʉ, aɨwɨtumile ilɨngasɨɨlyo nɨ miʉkʉɨlwa mʉantʉ. <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />Lʉhikʉ lʉng'wɨ antʉ kʉpuma mʉnyʉmba niya kʉ tankanɨla Ayahudi nɨtangwa “Nyʉmba akidesela antʉ,” Nawo Aɨayahudi kʉpumɨɨla kʉ Kilene nʉkʉ Alekisandilia nɨaʉya aɨapumile kʉ Kilikia nihɨɨ a kʉ Asia. Antʉ awa ɨkatula kikʉngʉma nʉ Sitepwano. <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />Ingɨ shanga ɨkamʉlemya ʉ Sitepwano naɨʉkʉtambʉla kʉnsoko Ng'wahʉ Ng'welʉ aɨʉmʉpee mahala. <verse eid="ACT 6:10" /><verse number="11" style="v" sid="ACT 6:11" />Kʉlʉlo antʉ awa ɨkaapembeseelya kaganda ka antʉ nʉ kʉapa nkumba mʉlomo kʉmʉtunja ʉteele, “Kamija ʉ Sitepwano ʉkʉmʉtukɨla Mʉsa nʉ kʉmʉsensa Itunda.” <verse eid="ACT 6:11" /><verse number="12" style="v" sid="ACT 6:12" />kʉitɨ ɨkaakinyɨla antʉ nɨ anyampala nɨ amanyɨsi a malagɨɨlyo ang'wa Musa. Sʉnga ɨkamʉhanga ʉ Sitepwano, ɨkamʉamba nʉ kʉmʉtala pianza nɨla anyampala. <verse eid="ACT 6:12" /><verse number="13" style="v" sid="ACT 6:13" />Antʉ awa ɨkaɨka akʉɨɨli a ʉteele naɨ alongopile, “Mʉntʉ ʉyʉ shanga wɨleka kʉtambʉla nkani nɨya kʉtukɨla nyʉmba ang'wa Itunda nɨ Malagɨɨlyo ang'wa Mʉsa. <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />Kʉnsoko aɨkʉmigulye ʉkʉlʉnga ʉ Yesʉ ʉyʉ nʉa kʉ Nazaleti ʉkʉkʉmʉla nkɨka nɨnelʉ nang'wi Itunda nʉ kʉkaɨla lʉkʉlu ntendo naɨkʉpewe nʉ Mʉsa.” <verse eid="ACT 6:14" /><verse number="15" style="v" sid="ACT 6:15" />Antʉ awo ɨhi naɨakolɨ pianza ɨkamʉgozeela ʉ Sitepwano, nawo ɨkaona ʉsʉ wang'wa Sitepwana ʉkʉmɨlɨginta anga Malaɨka wang'wi Itunda.<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="s">Sitepwano ʉkilongoola pianza nɨla anyampala</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />Papo mʉpolyi nʉ mʉkʉlʉ wɨkamʉkolya ʉ Sitepwano, “Makani aya nʉsemewe a taine?”<verse eid="ACT 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 7:2" />Sitepwano wɨkasʉkɨɨlya, “Anyandʉgʉ ane nɨ atata, ntegeelyi! Itunda aɨʉmigee ʉ gʉkʉ witʉ ʉ Ibulahimu, naɨʉkolɨ ʉko kʉ Mesopotamia, naɨ wakɨlɨ kʉhamɨla kishiɨ kʉ Halani. <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />Itunda wɨkamʉɨla ʉ Ibulahimu, ‘Hega mihɨɨ ako aleke ɨanyandʉgʉ ako, ʉlongole kihɨɨ nɨ kʉʉlagɨɨla.’ <verse eid="ACT 7:3" /><verse number="4" style="v" sid="ACT 7:4" />Kʉlʉlo Ibulahimu wɨkahega mihɨɨ a Akalidayo wɨkalongola kishiɨ kʉ Halani. Naɨwasha ihe, Itunda wɨkamʉheja kʉ Halani wɨkahamɨla mihɨɨ ɨyɨ nɨmishiɨ itungo ɨlɨ. <verse eid="ACT 7:4" /><verse number="5" style="v" sid="ACT 7:5" />Itunda shanga aɨʉmʉsalisilye ihɨɨ ɨyi, nɨ itɨga, Itunda ingɨ aɨʉmʉlapɨe kɨna ʉkʉmʉlekela ihɨɨ ɨyɨ ʉ Ibulahimu nʉ wileli wakwe, palʉng'wɨ nɨ itɨ itungo nɨlanso Ibulahimu aɨmɨgila anga ng'wana wɨhi. <verse eid="ACT 7:5" /><verse number="6" style="v" sid="ACT 7:6" />Itunda wɨkamʉɨla ʉ Ibulahimu. ‘Wileli nʉwako ʉkʉtula akʉteng'wa mihɨɨ nɨshangaao, nawo akʉtula atʉʉng'wa nʉkʉtendeelwa ʉbɨ myaka magana annɨ.’ <verse eid="ACT 7:6" /><verse number="7" style="v" sid="ACT 7:7" />Itunda wɨkalʉnga, ‘Ʉnene ingɨ kʉmɨtenda ibɨ ndʉgʉ nɨkʉmʉtenda ʉnyenye kʉtula mɨatʉʉng'wa. Sʉnga akʉhega mihɨɨ nanso aze ankʉlye apa itɨ.’ <verse eid="ACT 7:7" /><verse number="8" style="v" sid="ACT 7:8" />Papo Itunda wɨkamʉpa ʉ Ibulahimu ntendo ahʉmba kʉtalwa kɨdamu kɨtule kɨlɨngasɨɨlyo kilago lakwe. Sʉnga Ibulahimu wɨkamʉtuga ʉ Isaki, lʉhikʉ nʉla mʉnana Ibulahimu wɨkamʉtala ʉ Isaki kʉ kɨdamu nʉ Isaki wɨkamʉtuga ʉ Yakobo. Yakobo nʉyo wɨkaatuga agʉkʉ itʉ awo ni ikʉmi na abɨɨlɨ. <verse eid="ACT 7:8" /><verse number="9" style="v" sid="ACT 7:9" />“Agʉkʉ itʉ kʉnsoko aɨamuonee wɨlu Yusupu, ɨkamʉgʉlya watule mʉtʉʉng'wa kʉ Misili. Ingɨ Itunda aɨwɨpalʉng'wɨ nʉ Yusupu. <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />Itunda wɨkamʉguna ʉ Yusupu mʉlwago lɨhi, wɨkamʉaɨɨlya ʉkembetwa nɨ mahala pantongeela ang'wa Palao mʉtemi nʉwa kʉ Misili, naɨ ʉmʉɨkile Yusupu watule mʉkʉlʉ mihɨɨ ɨhi na Misili nɨ nyʉmba akwe na kɨtemi. <verse eid="ACT 7:10" /><verse number="11" style="v" sid="ACT 7:11" />Sʉnga lɨkigela izala mihɨɨ ɨhi na Misili nɨ Kanaani, izala nɨlanso lɨkasasha lwago lʉkʉlʉ, agʉkʉ itʉ ɨkaʉlya anga ndya. <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />Ingɨ ʉ Yakobo naɨwija kɨna ʉko kʉ Misili ndya ikolɨ, wɨkaalagɨɨlya anaakwe nɨɨza agʉkʉ itʉ alongole kʉ Misili. Nʉwanso wʉwo aɨmʉhɨnzo wang'wandyo kenda kʉ Misili. <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />Naɨasʉkɨɨe mʉhɨnzo nʉwa kabɨɨlɨ, Yusupu wɨkikoola kʉ aheu akwe, mpola niya aheu ang'wa Yusupu yɨkapika kung'wa Palao. Palao wɨkaamanya ɨaluna ang'wa Yusupu. <verse eid="ACT 7:13" /><verse number="14" style="v" sid="ACT 7:14" />Papo gwa ʉ Yusupu wɨkalagɨɨlya amʉlete Yakobo ihe palʉng'wɨ nɨ ndʉgʉ akwe ɨhi aze kʉ Misili, mʉhangʉ nʉwa antʉ ɨhi naɨendile kʉ Misili aɨmakʉmi mʉpungatɨ na ataano. <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />Itɨ gwa ʉ Yakobo wɨkalongola kʉ Misili kaɨʉshɨɨe ng'wenso palʉng'wɨ nɨ agʉkʉ itʉ. <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />Mɨimbaao ɨkasʉkigwa kʉ Shekemu nʉkʉɨkwa mʉkɨbɨɨla Ibulahimu naɨʉgʉile kʉ mpia nsheenyʉ kʉ ana ang'wa Hamoli.<verse eid="ACT 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17" />“Ingɨ itungo naɨ lahumbeela nɨlang'wi Itunda kʉmɨnkɨɨlya ʉ Ibulahimu ilago lakwe, antʉ itʉ aɨongeelekile nangaluu ʉko kʉ Misili. <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />Sʉnga kʉ Misili wɨkatema mʉtemi nɨshanga aɨʉmʉmanyile ʉ Yusupu. <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />Mʉtemi ʉyʉ wɨkaatendeela agʉkʉ itʉ makani amɨnyala nʉkʉaja kʉnʉ waze asinja kʉagʉma kʉnzi ana nɨaniino ashe. <verse eid="ACT 7:19" /><verse number="20" style="v" sid="ACT 7:20" />Itungo lɨlo Musa wɨkatugwa, Musa aiʉgombekile kʉng'wi Itunda. Wɨkalelwa mʉnyʉmba ang'wi ihe kʉ myeli ɨtaatʉ. <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />Naɨaleng'wa kʉlongoleka kʉmʉpiha mʉnyʉmba, ɨkamʉpumya kʉnzi nʉ kʉmʉpiha kʉlɨ nɨ nyʉmba, sʉnga mʉnanso wang'wa Palao wɨkamʉhola, wɨkamʉlela anga ng'wana wakwe. <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />Musa wɨkamanyisigwa mahala a ki Misili, wɨkatula mʉhʉgu kʉ nkani ni ntendo. <verse eid="ACT 7:22" /><verse number="23" style="v" sid="ACT 7:23" />Naɨwapisha ilika la myaka makʉmi annɨ, wɨkalamʉla kenda kʉaona anyandʉgʉ akwe ɨ Aisilaeli. <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />Kʉng'wanso Musa wɨkamʉona mʉntʉ ʉng'wɨ ʉkʉgaɨlwa nʉ mʉ Misili, wɨkamʉgunɨɨlya ʉ mʉntʉ ʉyʉ naɨ ʉkʉgaɨlwa, wɨkalamʉla kʉmalya, wɨkamʉkʉa nʉ kʉmʉbʉlaga ʉ mʉ Misili. <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />Musa aɨʉsɨgile kɨna anyandʉgʉ akwe akʉlɨnga kɨna ʉlagɨigwe ni Itunda waagunɨɨlye, anyandʉgʉ ang'wa Musa shanga ɨkalɨnga. <verse eid="ACT 7:25" /><verse number="26" style="v" sid="ACT 7:26" />Lʉhikʉ naɨ lʉtyatile Musa wɨkaahanga Aisilaeli abɨɨlɨ akilea, wɨkagema kʉ ahʉnga wazeaɨla, ‘Ʉnyenye, ingɨ mɨndʉgʉ, haɨ ka mʉkʉhiya kilemaalya?’ <verse eid="ACT 7:26" /><verse number="27" style="v" sid="ACT 7:27" />“Mʉntʉ ʉyʉ naɨ ʉkʉmʉonela ʉmʉya wɨkamʉgʉma kʉmpelo ʉ Musa, wɨkamʉkolya, ‘Nyenyu nʉkʉɨkile ʉewe ʉtule wɨmʉtongeeli hangɨ wɨmʉlamʉli witʉ?’ <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />‘Itɨɨ, ʉkʉhiya kʉmbʉlaga anga igʉlo naza ʉmʉbʉlagile ʉ mʉnya kʉ Misili?’ <verse eid="ACT 7:28" /><verse number="29" style="v" sid="ACT 7:29" />Musa naɨwija inkani izi, wɨkamankɨɨla kʉ Midiani wɨkikiɨ kʉko anga mʉzɨɨla, kʉng'wanso wɨkatuga ana akɨgoha abɨɨlɨ.<verse eid="ACT 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30" />“Itɨ gwa naɨ akɨla myaka makʉmi annɨ, Malaɨka wang'wi Itunda wɨkamigeela ʉ Musa mʉ kɨhaka naɨkakɨe moto ʉko kʉwɨɨ pakupɨ nʉ lʉgʉlʉ nʉla Sinai. <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />Musa naɨwaona makani nanso, wɨkakʉɨlwa. Naɨwahumbeela pakupɨ wagoze kɨsa, wɨkija lʉli lang'wi Isekʉlʉ, <verse eid="ACT 7:31" /><verse number="32" style="v" sid="ACT 7:32" />‘Ʉnene ni Itunda nʉwa agʉkʉ ako, Itunda wang'wa Ibulahimu nʉ Isaki nʉ Yakobo.’ Musa wɨkakagata kʉwoa shanga wɨkagema kʉgoza. <verse eid="ACT 7:32" /><verse number="33" style="v" sid="ACT 7:33" />“Papo Isekʉlʉ wɨkamʉɨla, ‘Tugʉla ɨmakwasa ako kʉnsoko apa nʉwimɨkile ingɨ ihɨɨ na welʉ. <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />Nalʉona ʉ lwago nɨakʉtendeelwa antʉ ane ʉko kʉ Misili. Nijaa kɨlɨlo kao nɨka ʉwai, ʉnene nzile nɨakomole. Itɨ gwa itungo ɨlɨ ʉnene kʉʉlagɨɨlya kʉ Misili.’<verse eid="ACT 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35" />“Ʉyʉ yʉyʉ Musa naɨʉhitilwe nɨantʉ azelʉnga, ‘Nyenyu naɨ ʉkʉɨkile ʉewe kʉtula wɨmʉtongeeli hangɨ wɨmʉlamʉli witʉ?’ kʉkɨɨla ang'wa Malaɨka naɨʉmigee mʉkɨhaka naɨ kakɨe ʉmoto, Itunda wɨkamʉlagɨɨlya ʉ Musa watule mʉtongeeli hangɨ mʉguni. <verse eid="ACT 7:35" /><verse number="36" style="v" sid="ACT 7:36" />Musa yʉyo aɨtongile Aisilaeli kʉpuma kʉ Misili, naɨ wakondya kitʉma ilɨngasɨɨlyo nɨ mɨʉkʉɨlwa ʉko kʉ Misili nʉ kʉ Lʉzɨ nʉla Shamu nʉ mʉwɨɨ kitungo nɨla myaka makʉmi annɨ. <verse eid="ACT 7:36" /><verse number="37" style="v" sid="ACT 7:37" />“Ʉyʉ yʉyʉ Musa naɨ ʉatambʉɨe ɨ Aisilaeli kɨna, ‘Itunda ʉkʉmʉhoela mʉmanga mʉng'wanyu.’ <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />Ʉyʉ yʉyʉ Musa naɨʉkolɨ mʉ milʉndo nʉwa Aisilaeli ʉko mʉwɨɨ, Malaɨka wang'wi Itunda aɨwitambʉye nʉyo palʉng'wɨ nɨa agʉkʉ itʉ mʉlʉgʉlʉ nʉla Sinai, yʉyo aɨʉsɨngɨɨye inkani niya ʉpanga wakʉpikɨlye ʉsese. <verse eid="ACT 7:38" /><verse number="39" style="v" sid="ACT 7:39" />“Ingɨ agʉkʉ itʉ ɨkahita kʉmʉkela ʉ Musa, nsuta nɨitɨ ɨkamʉhita nʉ kahiya kʉtulya kʉ Misili. <verse eid="ACT 7:39" /><verse number="40" style="v" sid="ACT 7:40" />Ɨkamʉɨla ʉ Aloni, ‘Kʉnonelye mʉlʉngʉ nʉwa kʉʉtonga mʉnzɨla, kʉnsoko shanga kʉlɨngile watendaʉlɨ ʉ Musa naɨ ʉkʉtongile kʉpuma kʉ Misili.’ <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />Papo naɨ anonilye dʉdʉ nʉwiɨlɨgano nɨla ndama, ɨkaleta mapolya nʉ kʉnoneelya iloeelya kʉ kɨntʉ ɨko naɨ akɨnonilye kʉ mɨkonoao. <verse eid="ACT 7:41" /><verse number="42" style="v" sid="ACT 7:42" />Papo Itunda wɨkahega mʉng'wao, wɨkaaleka akʉlye inzota niya kilunde anga nɨyandɨkilwe mʉ mbugulu niya amanga.</para>
  <para style="q" vid="ACT 7:42">‘Ʉnyenye Aisilaeli! Shanga nene</para>
  <para style="q" vid="ACT 7:42">naɨ mʉpumilye ipolya nisongelyo</para>
  <para style="q" vid="ACT 7:42">kitungo lamyaka makʉmi annɨ ʉko kʉwɨɨ.<verse eid="ACT 7:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="ACT 7:43" />Ʉnyenye naɨ mʉkenkile ihema lang'wi mʉlʉngʉ ʉ Moleki</para>
  <para style="q" vid="ACT 7:43">nʉ dʉdʉ nʉwa nzota ang'wi itunda wanyu ʉ Lepwani,</para>
  <para style="q" vid="ACT 7:43">adʉdʉ naɨmʉnonilye mʉhume kʉikʉlya.</para>
  <para style="q" vid="ACT 7:43">Kʉlʉlo kʉmutala kʉ ʉtʉʉng'wa kʉlɨ’ kʉkɨla ɨ Babeli.’<verse eid="ACT 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44" />“Ʉko kʉwɨɨ agʉkʉ itʉ aɨakete ɨhema ɨlo nɨla kɨlɨngasɨɨlyo kɨna Itunda ʉkolɨ. Aɨkɨnonigwe anga Itunda naɨ ʉmʉlɨngasilye ʉ Musa, kimpyana nɨkɨlɨngasɨɨlyo naɨʉlagɨɨwe. <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />Agʉkʉ itʉ naɨ asɨngɨɨlya ihema aziaɨla azeatongeewe nʉ Yoshua mʉ ʉhumi nʉ wihɨɨ kʉpuma kʉ antʉ Itunda naɨ ʉazunsilye pantongelaao. Papo kɨkikiɨ kʉpikɨɨla matungo ang'wa Daudi. <verse eid="ACT 7:45" /><verse number="46" style="v" sid="ACT 7:46" />Daudi naɨ ʉgombekile kʉng'wi Itunda, nʉyo wɨkalompa wamʉgombye wamʉzengele nyʉmba, nʉ Daudi nɨ Aisilaeli ɨhi akʉhuma kʉmʉkʉlya. <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />Ingɨ Solomoni yʉyo aɨʉmʉzengee Itunda ɨ nyʉmba.<verse eid="ACT 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 7:48" />“Nɨitɨ ga, Itunda nʉwa Kigʉlʉ shanga wishiɨ mʉnyʉmba niyizengilwe kʉ mɨkono a ana antʉ. Anga mʉmanga wakwe naɨ ʉtambʉe, <verse eid="ACT 7:48" /><verse number="49" style="v" sid="ACT 7:49" />Isekʉlʉ ʉlɨɨye</para>
  <para style="q" vid="ACT 7:49">‘Igʉlʉ ingɨ ituntu lane nɨla ʉhumi,</para>
  <para style="q" vid="ACT 7:49">nihɨɨ ingɨ kɨanza ka kʉpambatɨlya mɨgʉlʉ ane.</para>
  <para style="q" vid="ACT 7:49">Mʉkʉnzengela nyʉmba akɨnyaʉlɨ?</para>
  <para style="q" vid="ACT 7:49">Ang'wɨ paʉsupɨlyo wamɨgʉlʉ ane yʉkʉtula pɨɨ?<verse eid="ACT 7:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="ACT 7:50" />Itɨɨ, shanga mɨkono ane naɨtundile maintʉ aya ɨhi?’”<verse eid="ACT 7:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51" />Sitepwano wɨkalongoleka kʉtambʉla “Ʉnyenye antʉ nɨ mɨlʉgoha, nɨmɨagila kʉtwɨ, anga naɨatendile ɨ agʉkʉ anyu pakalɨ aɨamikʉngʉmilye ʉ Ng'wahʉ Ng'welʉ. <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />Amanga ɨhi aɨatendeewe ʉbɨ nɨagʉkʉ anyu. Aɨabʉlagile awo Itunda naɨ ʉalagɨɨye kʉtanantya kʉpembya ʉyo nɨ Mʉnyatai. Itungo ɨlɨ mamʉsuɨpa nʉkʉmʉbʉlaga. <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />Ʉnyenye aɨmʉsɨngɨɨye ɨmalagɨɨlyo ang'wa Musa naɨmʉletewe nʉ Malaɨka, ingɨ shanga mɨkakela.”<verse eid="ACT 7:53" /></para>
  <para style="s">Sitepwano ʉkʉkʉwa magwe.</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />Anyampala ianza naɨija nanso ɨkabɨpɨlwa nʉkʉkelya mino nangalu. <verse eid="ACT 7:54" /><verse number="55" style="v" sid="ACT 7:55" />Ingɨ Sitepwano kʉnʉ wɨkaze wizʉe ngulu a Ng'wahʉ Ng'welʉ wɨkalangamɨla kigʉlʉ wɨkaʉona ʉkʉlʉ wang'wi Itunda nʉ Yesʉ wɨmɨkile ipande nɨla ʉhumi nɨlang'wi Itunda. <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />Sitepwano wɨkalʉnga, “Gozi! Kʉona igʉlʉ lalugʉlwa nʉ Ng'waa Mʉntʉ wɨmikɨle ipande nɨla ʉkʉligwa wang'wi Itunda.”<verse eid="ACT 7:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57" />Papo antʉ ɨhi, pianza ɨkakʉlya iyogo nʉkʉkiɨla akʉtwɨ. Sʉnga ɨhi palʉng'wɨ ɨkamʉputɨla ʉ Sitepwano, <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />ɨkamʉpumya kʉnzi a kɨsalɨ, ɨkandya kʉmʉkʉa magwe. Asemi awo ɨkatugʉlanga mɨgololeao ɨkaɨka mʉmɨgʉlʉ amʉhʉmba ʉng'wɨ lina lakwe Sauli wɨmɨɨle. <verse eid="ACT 7:58" /><verse number="59" style="v" sid="ACT 7:59" />Naɨalongolekile kʉmʉkʉa magwe, ʉ Sitepwano wɨkalompa, “Isekʉlʉ Yesʉ, mɨsɨngɨɨlye ɨnkolo ane.” <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />Sʉnga wɨkatugama, wɨkakʉta, “Isekʉlʉ, leka kʉasosha ʉmʉlandʉ ʉwʉ.” Naɨwakondya kʉtambʉla itɨ, wɨkasha.<verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />Nɨ itɨ ga ʉ Sauli nʉyo waze wigombilye ʉ Sitepwano kʉbʉlagwa.</para>
  <para style="s" vid="ACT 8:1">Nɨamʉhʉɨe ʉ Yesʉ akagigwa</para>
  <para style="p" vid="ACT 8:1">Lʉhikʉ nʉlanso nɨamʉhʉɨe Yesʉ ʉko kʉ Yelusalemu ɨkatula kagigwa. Ahʉɨɨli ang'wa Yesʉ ɨhi ɨkabalansana ɨkasiga ɨitʉmi ʉdu, ɨkenela kʉisalɨ ni iniino niya kʉ Yʉdea nʉ kʉ Samalia. <verse eid="ACT 8:1" /><verse number="2" style="v" sid="ACT 8:2" />Antʉ nɨɨmʉkʉlya Itunda ɨkamʉɨka ʉ Sitepwano nɨ sʉka aɨnkʉlʉ.<verse eid="ACT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 8:3" />Sauli nʉwanso ingɨ aɨʉkendagema kʉaja ɨahʉɨɨli ang'wa Yesʉ, wɨkazingɨla nyʉmba kʉ nyʉmba nʉkʉaamba ahʉɨli ang'wa Yesʉ asʉngʉ nɨ itʉnja nʉ kʉatunga mʉkadulumu.<verse eid="ACT 8:3" /></para>
  <para style="s">Pilipo ʉkʉtanantya Nkani Nza kʉ Samaria</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4" />Kʉlʉlo ahʉɨɨli ang'wa Yesʉ naɨabalansanile ɨkatula tanantya lʉkani lang'wi Itunda nkɨka yɨhi naɨendile. <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" />Pilipo wɨkahulumʉka kʉ kɨsalɨ kɨng'wɨ kitangwa Samalia wɨkatanantya mpola yang'wa Kilisito.<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false">ingɨ masia</char></note> <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />Antʉ naɨamija ʉ Pilipo nʉkʉona ilɨngasɨɨlyo nɨ mɨʉkʉɨlwa naɨ ʉkʉtenda ɨkamʉtegeelya kɨsa kɨɨsa naɨ ʉkʉtambʉla. <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />Ahɨng'wɨ ɨkapuma mʉ antʉ ɨdʉ kʉnʉ azekʉta nɨ antʉ ɨdʉ naɨ apoiye mɨɨlɨ nɨ akɨtele ɨkakomigwa. <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />Antʉ a kɨsalɨ nɨkanso ɨkalowa.<verse eid="ACT 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9" />Itɨ gwa aɨʉkolɨ mʉntʉ ʉng'wɨ witangwa Simoni naɨmʉlogi kitungo ɨlɨpu mʉ kɨsalɨ ka Samalia, antʉ aɨɨmʉkʉɨlwa kʉnsoko aʉlogi wakwe. Aɨwisania kɨna nʉwanso ingɨ mʉntʉ mʉkʉlʉ, <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />antʉ ɨhi, nɨakʉlʉ nawa nɨaniino aɨɨmʉtegeelya kɨsa kɨɨsa azelʉnga “Mʉntʉ ʉyʉ ʉkete ʉhumi wang'wi Itunda nʉʉkumʉkile anga ‘Ʉhumi nʉ Ʉkʉlʉ.”’ <verse eid="ACT 8:10" /><verse number="11" style="v" sid="ACT 8:11" />Ɨkamʉkela kʉnsoko itungo ɨlɨpu aɨwɨakʉɨla ɨantʉ kʉ ʉlogi wakwe. <verse eid="ACT 8:11" /><verse number="12" style="v" sid="ACT 8:12" />Ingɨ ʉ Pilipo naɨ waatanantɨlya Nkani Nza niya Ʉtemi wang'wi Itunda nɨ lina lang'wa Yesʉ Kilisito, agoha nɨ asʉngʉ ɨkahʉɨɨla nʉ kʉbadisigwa. <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />Simoni nʉyo wɨkahʉɨɨla Nkani Nza nʉkʉbadisigwa, wɨkakʉɨlania nʉ Pilipo nkɨka yɨhi, wazekʉɨlwa ilɨngasɨɨlyo nɨ mɨʉkʉɨlwa naɨ ɨkʉtendeka.<verse eid="ACT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14" />Itɨ gwa itʉmi naɨakolɨ kʉ Yelusalemu naɨ ija kɨna Asamalia agomba ʉ lʉkani lang'wi Itunda, ɨkaalagɨɨlya a Petelo nʉ Yohana alongole kʉng'wanso. <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />Petelo nʉ Yohana naɨapika ɨkaalompeela antʉ naɨ amʉhʉɨɨla ʉ Yesʉ amʉsɨngɨɨlye ʉ Ng'wahʉ Ng'welʉ, <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />kʉnsoko Ng'wahʉ Ng'welʉ aɨwakɨlɨ kʉmʉzɨɨla mʉntʉ wɨhi, ingɨ aɨabadisigwe kʉ lina lang'wi Isekʉlʉ Yesʉ ʉdu. <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />Papo a Petelo nʉ Yohana ɨkaaɨkɨɨlya mɨkono mʉ matwe ahʉɨɨli ang'wa Yesʉ, nawo ɨkasɨngɨɨlya Ng'wahʉ Ng'welʉ.<verse eid="ACT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18" />Simoni naɨwaona antʉ akʉsɨngɨɨlya Ng'wahʉ Ng'welʉ naɨ aɨkɨɨigwe mɨkono mʉ matwe nɨitʉmi, wɨkahiya kʉapa mpia <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />wazelʉnga, “Mʉmpe nʉnene ga ʉhumi ʉwʉ ingɨ mʉntʉ wɨhi nɨkʉmʉɨkɨɨlya mɨkono mitwe lakwe, wasɨngɨɨlye ʉ Ng'wahʉ Ng'welʉ.”<verse eid="ACT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20" />Petelo wɨkamʉsʉkɨɨlya, “Hega apa, ʉewe ni Mpia yako mʉlimansɨɨlɨle kʉlɨ, kʉnsoko ʉsɨgile kɨna ʉhumile kʉgʉla ɨkɨpegwa kang'wi Itunda kʉ mpia. <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />Ʉewe wɨmʉgila anga ipatyo ang'wi kaganda mʉ mʉlɨmo ʉwʉ kʉnsoko nkolo ako shanga ɨgolokile kʉng'wi Itunda. <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />Kʉlʉlo ile itʉnʉ kʉ ʉbɨ wako nʉanso hangɨ mʉlompe Itunda nʉyo ʉhumile kʉʉlekela ɨmasɨgo nʉkete mʉnkolo ako. <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />Kʉnsoko kʉona kɨna ʉewe ʉkete wɨlu hangɨ wɨmʉtʉʉng'wa wamilandʉ.”<verse eid="ACT 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24" />Papo Simoni wɨkasʉkɨɨlya, “Itʉnʉ nompeeli kʉng'wi Isekʉlʉ, ingɨ mʉ ayo ɨhi nɨmʉtambʉe aleke kʉnihanga.” <verse eid="ACT 8:24" /><verse number="25" style="v" sid="ACT 8:25" />Petelo nʉ Yohana naɨ akondya kʉmanyisa lʉkani lang'wi Isekʉlʉ, ɨkatulya kʉ Yelusalemu azetanantya Nkani Nza mʉisalɨ yɨhi niya Samalia.<verse eid="ACT 8:25" /></para>
  <para style="s">Pilipo ʉkʉmʉbadisa mʉkʉlʉ mʉnya kʉ Esiopia</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />Malaɨka wang'wi Isekʉlʉ wɨkamʉila ʉ Pilipo. “Ihambe ʉlongole takama ʉkɨɨle nzɨla a mʉwɨɨ ɨyo nɨpumɨɨe kʉ Yelusalemu ahulumʉka kʉ Gaza.” <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />Itɨ gwa Pilipo wɨkandya mʉhɨnzo wɨkatankana nʉ mitʉnja ʉng'wɨ nʉtuilwe, mʉntʉ ʉyʉ aɨmʉkʉlʉ nʉwa aɨka mpia ang'wa Kandake Mʉtemi nʉwa Kɨsʉngʉ nʉwa kʉ Esiopia, Mʉkʉlʉ ʉyʉ nʉtuilwe aɨwendɨle kʉ Yelusalemʉ kʉmʉkʉlya Itunda. <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />Itungo nɨlanso mʉkʉlʉ nʉwanso aɨugomokile kitolakwe, waze ʉnankɨe mʉtuka nʉilutwaa ni mpalasɨ, wɨkazesoma mʉmbugulu a mʉmanga Isaya. <verse eid="ACT 8:28" /><verse number="29" style="v" sid="ACT 8:29" />Itɨ gwa Ng'wahʉ Ng'welʉ wɨkamʉɨla ʉ Pilipo, “Longola pakupɨ nʉmʉtuka nʉanso wɨtyate nʉwenso.” <verse eid="ACT 8:29" /><verse number="30" style="v" sid="ACT 8:30" />Sʉnga ʉ Pilipo wɨkamankɨɨla pakupɨ nʉ mʉtuka nʉkʉmija mʉkʉlʉ nʉwanso ʉkʉsoma mʉmbugulu amʉmanga ʉ Isaya. Papo ʉ Pilipo wɨkamʉkolya, “Itɨɨ, nkani nɨanso nʉkʉsoma ʉilɨngilene?”<verse eid="ACT 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 8:31" />Mʉkulʉ nʉwanso wɨkamʉsʉkɨɨlya, “Kʉlɨnga ʉlɨ anga nihite kʉlɨngasigwa nʉ mʉntʉ?” Papo wɨkamʉɨla ʉ Pilipo wanankɨle mʉmʉtuka wɨkiɨ palʉng'wɨ nʉng'wenso. <verse eid="ACT 8:31" /><verse number="32" style="v" sid="ACT 8:32" />Mʉkʉlʉ nʉwanso aɨʉkʉsoma ʉandɨkwa nʉʉlɨɨye itɨ.</para>
  <para style="q" vid="ACT 8:32">“Aɨʉtuile anga nkolo nɨtawe kʉsɨnzwa,</para>
  <para style="q" vid="ACT 8:32">anga ng'wa nkolo nʉwɨkilaga ihɨtwɨ nʉʉkʉteng'wa mauli,</para>
  <para style="q" vid="ACT 8:32">shanga aɨʉtambʉe lʉkani lɨhi.<verse eid="ACT 8:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="ACT 8:33" />Wɨkahumigwa minyala nʉkʉmʉonela,</para>
  <para style="q" vid="ACT 8:33">kʉtɨlɨ nʉhumile kʉʉganʉla ʉtuugwa wakwe,</para>
  <para style="q" vid="ACT 8:33">kʉnsoko lɨkalo lakwe lapikɨɨla mpelo mihɨɨ.”<verse eid="ACT 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34" />Mʉkʉlʉ nʉwanso wɨkamʉkolya ʉ Pilipo, “Ntambʉɨle, mʉmanga ʉyʉ ʉkʉligitɨlya ntʉni? Ʉkʉtambʉla nkani yakwene ang'wɨ nkani ya mʉntʉ mʉngɨɨza?” <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />Papo ʉ Pilipo wɨkandɨɨlya ninkɨɨlɨ niyanso ni ya Ʉandɨkwa nʉ Ʉza, wɨkamʉtambʉɨla Nkani Nza niyang'wa Yesʉ. <verse eid="ACT 8:35" /><verse number="36" style="v" sid="ACT 8:36" />Naɨ alongolekile nʉmʉhɨnzo, ɨkapikɨɨla nkɨka nakolɨ mazɨ. Mʉkʉlʉ nʉanso wɨkamʉɨla ʉ Pilipo, “Kolwa saya mazɨ apa, “Itɨi, Kɨntʉ kɨɨ nɨkɨkʉngilya ndeke kʉbadisigwa?” <verse eid="ACT 8:36" /><verse number="37" style="v" sid="ACT 8:37" />Pilipo wɨkalʉnga, “Anga ɨze wahʉɨɨla kʉnkolo ako ɨhi ʉhumile kʉbadisigwa.” Mʉntʉ ʉyʉ wɨkasʉkɨɨlya, “Nahʉɨɨla kɨna Yesʉ Kilisito ingɨ Ng'wana wang'wi Itunda.”<note caller="+" style="f"><char style="fr" closed="false">8:37 </char><char style="ft" closed="false">Lʉkɨɨlɨ ʉlʉ lɨkʉtilɨ mʉ mbugulu yɨdʉ </char></note><verse eid="ACT 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 8:38" />Papo Mʉkʉlʉ nʉwanso wɨkalagɨɨlya mʉtuka wimɨke. Ɨhi mʉʉbiɨlɨao ɨkasima, ɨkingɨla mʉmazi, Pilipo wɨkamʉbadisa Mʉkʉlʉ nʉwanso. <verse eid="ACT 8:38" /><verse number="39" style="v" sid="ACT 8:39" />Naɨapuma mʉmazi, Ng'wahʉ wang'wɨ Isekʉlʉ wɨkamʉhola ʉ Pilipo, mʉkʉlʉ nʉwanso shanga wɨkamʉona hangɨ ʉ Pilipo, wɨkalongoleka nʉmʉhɨnzo wakwe wazewiloile. <verse eid="ACT 8:39" /><verse number="40" style="v" sid="ACT 8:40" />Pilipo wɨkihanga ʉkolɨ kʉ kɨsalɨ ka Azoto, wɨkakɨɨla mʉisalɨ yɨhi wɨkazetanantya lʉkani lang'wɨ Itunda, sʉnga wɨkapika kʉ kɨsalɨ ka Kaisalia.<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="s">Sauli ʉkʉmʉhʉɨɨla ʉ Kilisto</para>
  <para style="r">
    <ref loc="ACT 22:6-16">Ntendo 22:6-16</ref>; <ref loc="ACT 26:12-18">26:12-18</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />Matungo nanso, Sauli aɨʉlongolekile kʉatumba kʉ ʉtaki nʉkʉabulaga ahʉɨɨli ang'wa Isekʉlʉ. Wɨkalongola kʉ Mʉpolyi nʉ Mʉkʉlu, <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />wɨkalompa wapegwe balʉa nɨla kʉmʉhumya nʉanso walongole mʉnyʉmba nɨyakʉtankanɨla ayahudi ʉko kʉ Damesiki, ingɨ wahume kʉaamba ɨahʉɨɨli ang'wa Yesʉ itʉnja nɨ asʉngu nɨamʉhʉɨɨe ʉ Yesʉ Kilisito nʉkʉaleta kʉ Yelusalemu.<verse eid="ACT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 9:3" />Ingɨ ʉ Sauli naɨʉkolɨ mʉnzɨla pakupɨ nʉkʉpika kʉ Damesiki, pumpulugu nzelya kʉpumɨɨla kilunde ɨkamalɨkɨla mpande yɨhi. <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />Wɨkagwa pɨhi nʉkija lʉli, “Sauli, Sauli. Nɨkɨ ʉkʉnaja?”<verse eid="ACT 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5" />Sauli nʉyo wɨkakolya, “Wɨnyenyu ʉewe Isekʉlʉ?”</para>
  <para style="p" vid="ACT 9:5">Lʉli nʉlanso lɨkasʉkɨɨlya, “Ʉnene ingɨ Yesʉ ʉyʉ ʉewe nʉʉkʉmaja. <verse eid="ACT 9:5" /><verse number="6" style="v" sid="ACT 9:6" />Itungo ɨlɨ ʉka, wingɨle mʉ kɨsalɨ ka Damesiki kʉng'wanso ʉkʉɨlwa nʉtakɨwe kʉtenda.”<verse eid="ACT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7" />Antʉ awo naɨ akʉɨlanilye nʉ Sauli aɨikimɨka papo, ɨkakʉɨlwa azeagila nʉla kʉtambʉla, kʉnsoko aɨigule ʉlʉli nʉlanso, ingɨ shanga ɨkamʉona ʉmʉntʉ naɨʉkʉligitya. <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />Sauli wɨkaʉka, naɨʉgemile kʉpɨtula miho wɨkalengwa kʉnsoko wapokula. Itɨgwa antʉ naɨaona itɨ ɨkamʉtongeela ɨkaze amʉambɨe mʉkono kʉpikɨɨla kʉ kɨsalɨ ka Damesiki. <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />Sauli wɨkikiɨ itungo lamahikʉ ataatʉ wazemʉpoku, itungo nɨlanso shanga aɨwɨlyaa ang'wɨ kʉng'wa kɨntʉ kɨhi.<verse eid="ACT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10" />Kʉng'wanso kʉ Damesikɨ aɨʉkolɨ mʉhʉɨɨlɨ ʉng'wɨ wang'wa Yesʉ witangwa Anania. Isekʉlʉ wɨkamʉpɨndʉla mʉ mʉloto, “Anania.”</para>
  <para style="p" vid="ACT 9:10">Anania wɨkamʉsʉkɨɨlya, “Isekʉlʉ, Nkolɨ papa.”<verse eid="ACT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 9:11" />Isekʉlʉ nʉyo wɨkamʉɨla, “Longola mipanda nɨlitangwa Nzɨla nɨ Ngoloku, mito lang'wa Yʉda ʉmʉkoeelye mʉntʉ ʉng'wɨ ʉkitangwa Sauli ʉpembeeye kʉ Taso, itungo ɨlɨ ʉkolɨ ʉkʉmʉlompa Itunda, <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" />mʉ mʉloto wɨkamʉona mʉntʉ wɨtangwa Anania ʉkingɨla mʉnyʉmba nʉkʉmʉɨkɨɨlya mɨkono mitwe lakwe wahume kʉona hangɨ.”<verse eid="ACT 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13" />Ingɨ ʉ Anania wɨkasʉkɨɨlya, “Isekʉlʉ, nija nkani yɨdʉʉ kʉpuma kʉ antʉ nɨya mʉntʉ ʉyʉ, nigule naɨ wɨatendeela ʉbɨɨ ɨahʉɨɨli ang'wa Yesʉ ʉko kʉ Yelusalemʉ. <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />Nʉyo ʉzile apa ɨti ʉpewe ʉhumi kʉpumɨla kʉ Apolyi nɨ akʉlu wahume kʉaamba ɨhi nɨakʉlompa kʉ lina lako.”<verse eid="ACT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 9:15" />Ingɨ Isekʉlʉ wɨkamʉila ʉ Anania, “Ʉewe longola ʉdu kʉnsoko namʉhola ʉ Sauli witʉme mʉlɨmo nʉwa kʉtanantya lina lane, kʉ antʉ nɨshanga Ayahudi nɨ atemi nʉ kʉ antʉ ɨhi nɨa kʉ Isilaeli. <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" />Nene kʉmʉlɨngasa nʉwɨkagigwa kʉnsoko a lina lane.”<verse eid="ACT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17" />Ʉʉgwa, Anania wɨkalongola, wɨkingɨla mʉnyʉmba nanso nʉ kʉmʉhanga ʉ Sauli. Sʉnga wɨkaɨkɨɨlya mɨkono, wɨkalʉnga, “Sauli mʉnyandʉgʉ, Isekʉlʉ Yesʉ ng'wenso naɨ ʉkigee mʉnzɨla, yʉyo ʉndagiiye ʉnene nɨze kʉng'wako ʉhume kʉona hangɨ wizʉligwe ngulu a Ng'wahʉ Ng'welʉ” <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />Papo paapo maɨntʉ nɨhanga makulugamba ɨkagwaa kʉpumɨla mʉ miho ang'wa Sauli, wɨkatulaona hangɨ. Sʉnga wɨkaʉka, wɨkʉbadisigwa. <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />Naɨ walya indya, ngʉlʉ yakwe yɨkamʉsʉkɨla.</para>
  <para style="s" vid="ACT 9:19">Sauli ʉkʉtanantya kʉ Damesiki</para>
  <para style="p" vid="ACT 9:19">Sauli wɨkishiɨ mahikʉ makeehʉ nɨahʉɨɨli ang'wa Yesʉ kʉng'wanso kʉ Damesiki. <verse eid="ACT 9:19" /><verse number="20" style="v" sid="ACT 9:20" />Papo ʉ Sauli wɨkandya kʉtanantya mʉnyʉmba niyakʉtankanɨla Ayahudi wazelʉnga kɨna, “Yesʉ ingɨ Ng'wana wang'wi Itunda.”<verse eid="ACT 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 9:21" />Antʉ ɨhi naɨigulye inkani yang'wa Sauli aiakʉɨwe nʉkʉkolya, “Ʉyʉ shanga yʉyʉne naɨʉsakilye ʉbʉlagwi ʉkʉlʉ nʉwa antʉ naɨ ilapɨla ɨlina lang'wa Yesʉ ʉko kʉ Yelusalemʉ? Ng'wenso aɨwɨza apa itɨ kʉaamba ahʉɨɨli ang'wa Yesʉ nʉkʉatala kʉatongeeli a apolyi azeatungilwe?”<verse eid="ACT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 9:22" />Sauli wɨkalongoleka kʉtula mʉkamatɨku nʉ kʉ akʉɨɨla ɨ Ayahudi naɨishiɨ kʉ Damesiki waze kumʉʉla kɨna ʉ Yesʉ ingɨ Kilisito.<verse eid="ACT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23" />Naɨakɨla mahikʉ ɨdʉ, Ayahudi ɨkisɨja kʉmʉbʉlaga ʉ Sauli. <verse eid="ACT 9:23" /><verse number="24" style="v" sid="ACT 9:24" />Sauli wɨkija masigoao. Ayahudi ɨkadagɨɨlya mʉ ʉkɨɨlo wɨhi nʉwa kɨsalɨ, ʉtikʉ nʉ ng'ʉng'wɨ ahume kʉmʉbʉlaga. <verse eid="ACT 9:24" /><verse number="25" style="v" sid="ACT 9:25" />Ingɨ amanyisigwa ang'wa Sauli aɨɨmʉkenka mʉkɨsela ʉtikʉ ɨkamʉsimɨɨlya kʉkɨɨla palyoma nɨlɨkolɨ mikiligo.<verse eid="ACT 9:25" /></para>
  <para style="s">Sauli ʉkʉtulya kʉ Yelusalemu</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />Sauli naɨ wapika kʉ Yelusalemu wɨkagema kihanja nɨamanyisigwa ang'wa Yesʉ. Amanyisigwa nɨanso ɨkitumba, kʉnsoko shanga aɨahʉɨɨe kɨna ʉ Sauli wainaa mʉmanyisigwa wang'wa Yesʉ. <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />Ingɨ Balinaba yʉyo wɨkamʉhola, wɨkamʉtala kʉ itʉmi. Wɨkaaganʉɨla itɨ ʉ Sauli naɨ ʉkolɨ mʉnzɨla aɨʉtankanile kɨnyaʉlɨ ni Isekʉlʉ, Isekʉlʉ aɨʉligitilye ʉlɨ nʉ Sauli nɨ itɨ naɨʉtanantilye kʉ ʉkamatɨku wɨhi kʉ lina lang'wa Yesʉ ʉko kʉ Damesiki. <verse eid="ACT 9:27" /><verse number="28" style="v" sid="ACT 9:28" />Kʉlʉlo ʉ Sauli wɨkishiɨ palʉng'wɨ nɨenso kʉnʉ waze wihangɨlye kʉtanantya kɨhenga ɨ lina lang'wa Yesʉ nkɨka yɨhi ʉko kʉ Yelusalemu. <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />Aɨʉkenditambʉlya nʉ kikʉngʉma nɨ Ayahudi nɨ antambʉ a Kɨyunani, ingɨ wawo aɨagemile kʉmʉbʉlaga. <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />Anyandʉgʉ awa naɨ ija impola niyanso, ɨkamʉhola ʉ Paʉlo ɨkamʉtala kʉ Kaisalia, ɨkamʉtindikɨɨla walongole kʉ Taliso.<verse eid="ACT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31" />Papo gwa ahʉɨɨli ang'wa Yesʉ nɨa kʉ Yʉdea nɨ Galilaya nɨ Samalia ɨkiloeelya ɨmatiliga aya. Ahʉɨɨli ang'wa Yesʉ ɨkakamatɨka nʉ kʉlongoleka kʉmʉkʉlya Isekʉlʉ nʉkʉkomigwa nkolo nʉ Ng'wahʉ Ng'welʉ.<verse eid="ACT 9:31" /></para>
  <para style="s">Petelo mʉ kɨsalɨ ka Lida nɨ Yapwa</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32" />Petelo naɨ ʉkʉgendeela nkɨka yɨhi, wɨkalongola kʉiʉmbaʉmbɨla ahʉɨɨli ang'wa Yesʉ naɨishiɨ kʉ kɨsalɨ ka Lida. <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />Kʉng'wanso wɨkamʉhanga mʉntʉ ʉng'wɨ witangwa Ainea, naɨ ʉpoiye wɨza ʉlae mʉ ʉlɨlɨ myaka mʉnana. <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />Petelo wɨkamʉɨla, “Ainea, Yesʉ Kilisito ʉkʉʉkomya, ʉka palinga kɨpalatʉ kako.” Papo Ainea wɨkaʉka. <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />Antʉ ɨhi kʉkʉsalɨ ka Lida nɨkʉng'wapo nʉwakʉ Shaloni naɨ amʉona ʉ Ainea ʉkʉgenda ɨkamʉhʉɨɨla Isekʉlʉ.<verse eid="ACT 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />Kʉ kɨsalɨ kakʉ Yapwa aɨʉkolɨ mʉmanyisigwa nʉwa kɨsʉngʉ lina lakwe Tabita, kʉ Kɨyunani ɨza Dolikasi, ndogoelyo akwe Mpala. Mʉmanyisigwa ʉyʉ aɨmʉkende ikʉlʉ, aɨwɨtʉmaa iza nʉ kʉaɨɨlya ɨaʉla. <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />Matungo nanso Tabita wɨkalwala, wɨkasha, antʉ naɨakondya kʉoja ʉmʉimba wakwe ɨkaʉlalya mʉnɨndo nɨkolɨ mʉgolopwa. <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" />Kɨsalɨ ka Lida shanga aɨkʉlɨ nɨ Yapwa, Amanyisigwa naɨ ija kɨna ʉ Petelo ʉkolɨ kʉng'wanso ɨkalagɨɨlya antʉ abɨɨlɨ amʉhange nʉ kʉmʉlompa, “Itʉnʉ kayanga nzʉʉ kʉnʉ.” <verse eid="ACT 9:38" /><verse number="39" style="v" sid="ACT 9:39" />Kʉlʉlo ʉ Petelo wɨkihamba wɨkakʉɨlania nɨenso, naɨwapika, ɨkamʉtala kʉnɨndo nɨkolɨ kigʉlya kaɨalailye ʉ mʉimba. Ashɨlwa ang'wɨ aɨimɨkile pakupɨ nʉ mʉimba akʉlɨla ɨkamʉlagɨɨla nkanjʉ nɨ ngʉo maʉya ʉ Dolikasi naɨʉatumɨɨye naɨ wakɨlɨ kʉsha. <verse eid="ACT 9:39" /><verse number="40" style="v" sid="ACT 9:40" />Petelo wɨkaapumya kʉnzi anɨndo nanso, wɨkatugama wɨkalompa, Sʉnga wɨkaʉpɨlʉkɨla ʉmʉimba wɨkalʉnga, “Tabita, ʉka.” Tabita wɨkapɨtya naɨ wamʉona ʉ Petelo, wɨkikiɨ. <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />Petelo wɨkamʉamba mʉkono wɨkamʉʉsha, sʉnga wɨkaitanga ɨahʉɨɨli ang'wa Yesʉ nɨasʉngʉ nɨashɨɨwe wɨkaapa ʉmʉnanso waze mʉpanga. <verse eid="ACT 9:41" /><verse number="42" style="v" sid="ACT 9:42" />Mpola izi yɨkakumʉka nkɨka yɨhi niya kɨsalɨ ka Yapwa, antʉ ɨdʉ ɨkamʉhʉɨɨla Isekʉlʉ. <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />Petelo wɨkishiɨ kʉ Yapwa mahikʉ ɨdʉ kʉ mʉntʉ mʉtuma ndɨlɨ witangwa Simoni.<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="s">Kolinelio ʉkʉmitanga ʉ Petelo</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />Mʉkɨsalɨ ka Kaisalia aɨʉkolɨ mʉntʉ naɨwitangwa Kolinelio, aɨɨza mankata midale nɨla anyambita igana naɨlɨkumʉkile “Idale nɨla Kɨitalia.” <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />Kolinelio nɨ antʉ amitolakwe aɨɨmʉkʉlya Itunda. Aɨwɨaaɨɨlya antʉ ɨdʉ nʉ kʉmʉlompa Itunda mahikʉ ɨhi. <verse eid="ACT 10:2" /><verse number="3" style="v" sid="ACT 10:3" />Lʉhikʉ lʉng'wɨ ng'ʉng'wɨ, anga saa kenda itɨ, mʉmʉloto wɨkaona, Malaɨka wang'wi Itunda ʉkʉmʉzɨɨla nʉ kʉmʉɨla, “Kolinelio.”<verse eid="ACT 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 10:4" />Kolinelio wɨkamʉgoza kʉwoa wɨkalʉnga, “Isekʉlʉ, Ʉkʉlʉnga ʉlɨ?”</para>
  <para style="p" vid="ACT 10:4">Malaɨka wɨkamʉɨla, “Itunda wagomba ɨmalompi ako, ingɨ waona nʉ ʉaɨɨlya wako kʉ ahimbɨ hangɨ shanga ʉkɨwa. <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />Itungo ɨlɨ lagɨɨlya antʉ ang'wɨ alongole kʉ Yopa amitange mʉntʉ ʉng'wɨ lina lakwe Simoni lina lyʉlya witangwaa Petelo. <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />Mʉntʉ ʉyʉ wikalania nʉ Simoni mʉnonia ndɨlɨ nyʉmba akwe ɨkolɨ mʉnshembo alʉzi.” <verse eid="ACT 10:6" /><verse number="7" style="v" sid="ACT 10:7" />Naɨ wahega ʉ Malaɨka wang'wi Itunda ʉyʉ naɨ ʉkitambʉlya nʉ Kolinelio, Kolinelio wɨkaitanga anyamʉlɨmo akwe abɨɨlɨ palʉng'wɨ nʉ mʉmboi ʉng'wɨ nʉwɨmʉkʉlya Itunda naɨɨza yine nɨantʉ awo nɨɨmitʉmɨla. <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />Kolinelio wɨkaaɨla makani ɨhi naza apumɨe, sʉnga wɨkaalagɨɨlya alongole kʉ Yopa.<verse eid="ACT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />Lʉhikʉ naɨ lʉtyatile anyamɨlɨmo ang'wa Kolɨnelio aɨahumbeela kingɨla mʉ kɨsalɨ ka Yopa, itungo nɨla saa mʉtandatu ng'ʉng'wɨ Petelo wɨkanankɨla mitembe kʉmʉlompa Itunda. <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />Petelo naɨ wahung'wa nzala. Naɨakɨlɨ akʉnoneelya indya, wɨkahola mʉloto. <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />Wɨkaona igʉlʉ lalugʉka nɨ kɨntʉ anga mʉgolole ʉkʉlu ʉkʉsimigwa pihɨɨ ɨze ʉambɨɨwe mpelo yakwe yɨhi innɨ. <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />Mʉmʉgolole nʉwanso aɨyimole mpyani yɨhi niyaikalɨ niigenda ni ikalɨ niyagula ni nyʉnyi. <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />Sʉnga wɨkija lʉli, “Petelo, ʉka ʉsɨnze, ʉlye.”<verse eid="ACT 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 10:14" />Petelo wɨkasʉkɨɨlya, “A a, Isekʉlʉ wane. Ʉnene ɨza nkɨlɨ kʉlulya kɨntʉ kɨhi nɨkɨgiigwe mʉmalagɨɨlyo ang'wa Musa, kʉlya ang'wɨ nɨkɨkʉmʉsasha mʉntʉ waleke kʉgombeka kʉmʉkʉlya Itunda.”<verse eid="ACT 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 10:15" />Wɨkija lʉli nʉlanso nkʉa akabɨɨlɨ, “Leka kʉlʉnga igiigwe kʉlya intʉ yɨhi niyigombigwe ni Itunda” <verse eid="ACT 10:15" /><verse number="16" style="v" sid="ACT 10:16" />Mʉloto nʉanso ʉkisʉkɨɨla nkʉa itaatʉ, sʉnga mʉgolole nʉwanso wɨkasʉkigwa kigʉlʉ.<verse eid="ACT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17" />Petelo naɨ wakɨlɨ ʉkikolya mʉloto ʉwʉ ng'waao ntʉni, antʉ awo naɨ alagɨigwe nʉ Kolinelio ɨkamɨpumpugɨɨlya ɨ nyʉmba ang'wa Simoni mʉnonia ndɨlɨ ɨkimɨka pa mʉlango. <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />Ɨkapɨndʉla nʉ kʉkolya “Itɨɨ apa ʉkolɨ mʉzɨɨla nʉwitangwa Simoni Petelo.<verse eid="ACT 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 10:19" />Petelo aɨwakɨlɨ ʉkʉsɨganɨɨlya mʉloto nʉanso, Ng'wahʉ wɨkamʉɨla, “Simoni, akolɨ antʉ ataatʉ akʉʉduma. <verse eid="ACT 10:19" /><verse number="20" style="v" sid="ACT 10:20" />Ʉka, sima, leka kisinsɨla kʉlongolania nɨeso kʉnsoko nene nɨalagɨɨye.” <verse eid="ACT 10:20" /><verse number="21" style="v" sid="ACT 10:21" />Petelo wɨkasima nʉkʉaɨla ɨantʉ awa naɨ alagɨigwe nʉ Kolinelio, “Nɨmʉkʉnduma ingɨ nene. Mʉzɨɨe ntʉni apa?”<verse eid="ACT 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 10:22" />Antʉ awa ɨkamʉsʉkɨɨlya, “Kʉlagɨigwe nʉ mankata ʉ Kolinelio nɨɨza mʉntʉ mʉkende, nʉɨmʉkʉlya Itunda nʉkʉsanigwa nɨ Ayahudi ɨhi. Nʉyo ʉlagɨigwe nʉ Malaɨka wang'wi Itunda wakitange kitolakwe, wahume kija nkani yɨhi nʉkʉmʉɨla.” <verse eid="ACT 10:22" /><verse number="23" style="v" sid="ACT 10:23" />Sʉnga ʉ Petelo nɨantʉ nɨanso ɨkingɨlania mʉ nyʉmba wɨkaanoneelya ɨ ndalo.</para>
  <para style="p" vid="ACT 10:23">Mʉdaʉao Petelo wɨkalongolania nɨantʉ nɨanso azeityatile nɨanyandʉgʉ ang'wɨ kʉpuma kʉ Yapwa. <verse eid="ACT 10:23" /><verse number="24" style="v" sid="ACT 10:24" />Lʉhikʉ nʉla kabɨɨlɨ ɨkapika kʉ Kaisalia. Kolinelio nɨ anyandʉgʉ akwe nɨ apakupɨ nɨ ahʉmbaʉya naɨʉanile. <verse eid="ACT 10:24" /><verse number="25" style="v" sid="ACT 10:25" />Petelo naɨʉkingɨla pamʉmpita, Kolinelio wɨkamʉsɨngɨɨlya wɨkatugama pa mɨgʉlʉ nʉkʉmʉkʉlya. <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />Petelo wɨkamʉʉsha wɨkamʉɨla, “Imɨke, nʉnene ga nɨ ng'waa mʉntʉ ʉdu anga ʉewe.” <verse eid="ACT 10:26" /><verse number="27" style="v" sid="ACT 10:27" />Petelo naɨakitambʉlya nʉng'wenso wɨkingɨla mʉnyʉmba wɨkahanga antʉ ɨdʉ ilʉndɨɨe. <verse eid="ACT 10:27" /><verse number="28" style="v" sid="ACT 10:28" />Petelo wɨkaaɨla, “Mʉlɨngile kɨna nsuta mʉntendo yitʉ Ayahudi kihanja nɨ antʉ nɨ shanga Ayahudi ang'wɨ kʉmʉgendeela. Itunda ingɨ ʉndagɨɨe kɨna kʉgiigwe kenda kʉ mʉntʉ wɨhi nʉkomilwe ʉpiti ang'wɨ mʉbɨɨ. <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />Itɨ naza ʉnintangile shanga nisinsɨe. Itungo ɨlɨ kʉlompa ʉmbɨle ʉnintangɨe ntʉni?”<verse eid="ACT 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30" />Kolinelio wɨkasʉkɨɨlya, “Mahikʉ ataatʉ nakɨla, itungo anga lɨlɨ aɨkʉlompa mʉnyʉmba, ng'ʉng'wɨ masaa kenda itɨ. Kʉpumpugɨɨlya mʉntʉ ʉtugae ngʉo melʉpee wimɨkile pa ntongeela ane, <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />wakalʉnga, ‘Kolinelio, wigigwa ɨmalompi ako ni masongelyo ako agombwa ni Itunda. <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />Ingɨ lagɨɨlya antʉ alongole kʉ Yapwa akolye mʉntʉ ʉng'wɨ witangwa Simoni Petelo, mʉntʉ ʉyʉ ingɨ mʉgeni mʉ nyʉmba ang'wa Simoni mʉnonya ndɨlɨ, nyʉmba akwe nɨɨza ɨkolɨ pa nshembo alʉzi.’ <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />Kʉlʉlo nalagɨɨlya antʉ kʉng'wako, nʉewe watenda iza kʉza. Itungo ɨlɨ ʉsese kɨhi kʉkolɨ apa ntongeela ang'wi Itunda kʉtegeeye ʉkʉɨle makani ɨhi Isekʉlʉ nʉkʉlagiiye.”<verse eid="ACT 10:33" /></para>
  <para style="s">Petelo ʉkʉtanantya Nkani Nza</para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34" />Papo ʉ Petelo wɨkandya kʉtambʉla, “Nalɨnga kɨna Itunda shanga wɨkoma, <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />Ingɨ Itunda wɨagomba antʉ ɨhi nɨakʉmʉkʉlya shanga wɨkela apembeeye ihɨɨ kɨɨ. <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />Ʉlʉ lʉlʉ lʉkani lang'wi Itunda nʉlagɨigwe kʉ Aisilaeli, wazetanantya Nkani Nza niya matiliga kʉkɨɨla kʉng'wa Yesʉ Kilisito Isekʉlʉ nʉwa antʉ ɨhi. <verse eid="ACT 10:36" /><verse number="37" style="v" sid="ACT 10:37" />Mʉlɨngile ikani ɨlo naɨlɨpumɨe kʉ Yʉdea ɨhi kandɨɨlya kʉ Galilaya ʉ Yohana Mʉbadisi naɨwakondya kʉatanantɨɨlya antʉ lʉkani lakwe nʉla ʉbadisigwa. <verse eid="ACT 10:37" /><verse number="38" style="v" sid="ACT 10:38" />Kɨnyaʉlɨ Itunda aɨʉmʉhoile ʉ Yesʉ mʉnya kʉ Nazaleti mʉ Ng'wahʉ Ng'welʉ nʉ ʉhumi. Nkɨka yɨhi naɨwendile nʉkʉtenda makani nɨmaza nʉ kʉakomya antʉ ɨhi naɨza aonewe ningulu yang'wa Shetani, kʉnsoko Itunda aɨwɨpalʉng'wɨ nʉyo. <verse eid="ACT 10:38" /><verse number="39" style="v" sid="ACT 10:39" />“Ʉsese kɨakʉɨɨli amakani ɨhi naɨitʉmilwe mʉ Yʉdea nɨ Yelusalemu. Aɨamʉbʉlagile nʉ kʉmʉkoma mʉ mʉsalaba. <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />Ingɨ lʉhikʉ nʉla kataatʉ Itunda wɨkamiʉsha sʉnga wɨkamʉpa ʉhumi nʉwakigeeleka kʉ antʉ, <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />shanga aɨwigeelekile anga kʉ antʉ ɨhi, ingɨ kʉng'witʉ Itunda naɨʉkʉhoile kʉtule kɨakʉɨɨli akwe, ingɨ ʉsese naɨkɨlizania nʉkʉng'wezania apa naɨ wakondya kiʉka kʉpuma kʉashi. <verse eid="ACT 10:41" /><verse number="42" style="v" sid="ACT 10:42" />Nʉyo aɨʉkʉlagɨɨye kʉtanantye Nkani Nza kʉ antʉ ɨhi nʉkʉmʉɨla kɨna Yesʉ ng'wenso Itunda naɨʉhoile kʉtula mʉlamʉli kʉ antʉ nɨ apanga nawa nɨakule. <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />Amanga ang'wi Itunda ɨhi aɨatambʉe kɨna mʉntʉ wɨhi nʉʉkʉhʉɨɨla ʉkʉlekelwa mɨlandʉ kʉkɨɨla lina lang'wa Yesʉ.”<verse eid="ACT 10:43" /></para>
  <para style="s">Antʉ ɨhi nɨ shanga Ayahudi akʉmʉsɨngɨɨlya Ng'wahʉ Ng'welʉ</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />Itungo ʉ Petelo naɨʉkʉtambʉla inkani izi, ngulu a Ng'wahʉ Ng'welʉ ɨkaasimɨɨla antʉ ɨhi naɨategeeye inkani niyanso. <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />Antʉ awa naɨabadisigwe naɨazile palʉng'wɨ nu Petelo ɨkakʉɨlwa kʉona kɨna Itunda wahunʉla ʉhumi nʉwa Ng'wahʉ Ng'welʉ mʉ antʉ nɨshanga Ayahudi. <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />Aɨaalɨngɨle kʉnsoko aɨaigulye akʉtambʉla kʉntambʉ ngɨɨza azemʉlʉmbɨɨlya Itunda. Papo ʉ Petelo wɨkalʉnga, <verse eid="ACT 10:46" /><verse number="47" style="v" sid="ACT 10:47" />“Itɨɨ, ʉkolɨne mʉntʉ wɨhine nʉhumile kʉagilya antʉ awa aleke kʉbadisigwa kʉ mazi? Amʉsɨngɨɨlya u Ng'wahʉ Ng'welʉ anga ʉsese naɨkʉmʉsɨngɨɨye.” <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />Kʉlʉlo wɨkalagɨɨlya antʉ ɨhi abadisigwe kʉ lina lang'wa Yesʉ Kilisito. Sʉnga antʉ ɨkamʉlompa ʉ Petelo wishiɨ nɨenso kʉ mahikʉ makeehʉ.<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="s">Petelo ʉkʉaganʉɨla antʉ nɨshanga amʉhʉɨɨe ʉ Yesʉ kʉ Yelusalemu</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />Itʉmi nɨ antʉ nɨshanga Ayahudi awa naɨahʉɨɨe aɨakolɨ kʉ Yʉdea ɨkija kɨna antʉ nɨ shanga Ayahudi nɨenso asɨngɨɨlya ʉ lʉkani lang'wi Itunda. <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />Itɨ gwa ʉ Petelo wɨkanankɨla kʉ Yelusalemu, Ayahudi awa naɨabadisigwa nʉ kuhʉɨɨla ɨkamʉsosha, azemʉtʉka, <verse eid="ACT 11:2" /><verse number="3" style="v" sid="ACT 11:3" />“Ʉewe aza wendile mʉnyʉmba kʉlɨzania nɨ antʉ nɨshanga atawe kʉ kɨdamu.” <verse eid="ACT 11:3" /><verse number="4" style="v" sid="ACT 11:4" />Papo ʉ Petelo wɨkaaganʉɨla makani ɨhi naɨapumɨe kandɨɨlya ʉng'wandyo.<verse eid="ACT 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 11:5" />“Lʉhikʉ lʉng'wɨ aɨnkolɨ mʉ kɨsalɨ ka Yapwa kʉlompa, nɨkakɨɨlwa tʉlo, nɨkaona mʉloto. Nɨkaona kɨntʉ anga mʉgolole ʉkʉlʉ, ʉkʉsima kʉpuma kigʉlʉ ʉkete mpande innɨ, nʉwenso ʉkahumbeeligwa paɨnkolɨ. <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />Nɨkahʉngɨɨla mʉkatɨ akwe nɨkaona ikalɨ niikete mɨgʉlʉ innɨ, ikalɨ niya mʉwɨɨ, ikalɨ niyagula ni nyʉnyi. <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />Sʉnga nɨkija kʉɨlwa ‘Petelo, ʉka ʉsɨnje ʉlye.’ <verse eid="ACT 11:7" /><verse number="8" style="v" sid="ACT 11:8" />“Ʉnene nɨkasʉkɨɨlya, ‘Isekʉlʉ, A a, kɨntʉ kɨhi nɨkɨgiigwe kʉlya nɨkɨ nɨkɨbɨ kɨkɨlɨ kʉunzɨlwa mʉ mʉlomo wane.’ <verse eid="ACT 11:8" /><verse number="9" style="v" sid="ACT 11:9" />“Nɨkaɨlwa nkʉa akabɨɨlɨ kʉpuma kigʉlʉ, ‘Kɨntʉ kɨhi Itunda nʉkeilye leka kʉlʉnga miko kʉlɨgwa.’ <verse eid="ACT 11:9" /><verse number="10" style="v" sid="ACT 11:10" />Ikani ɨlɨ azalisʉkɨɨe kataatʉ kʉpumɨla, papo ɨkɨntʉ nɨkanso nɨkimpyani nʉ mʉgolole kɨkaholwa hangɨ kigʉlʉ. <verse eid="ACT 11:10" /><verse number="11" style="v" sid="ACT 11:11" />Itungo lɨlo lɨɨlo antʉ ataatʉ, naɨ alagɨigwe kʉpuma kʉ Kaisalia ɨkapikɨɨla mʉnyʉmba naɨnishiɨ. <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />Ng'wahʉ ng'welʉ wɨkambɨla kʉkʉɨlanie nɨenso ndeke kisinsɨla. Anyandʉgʉ awa nɨ mʉtandatʉ nɨenso ga ɨkakʉɨlania nʉnene, nʉsese kɨkingɨle mʉ nyʉmba ang'wa Kolinelio. <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />Kolinelio wɨkakʉganʉɨla naɨʉmʉine ʉ Malaɨka wimɨkile mʉnyʉmba akwe nʉkʉlʉnga, ‘Lagɨɨlya antʉ alongole kʉ Yapwa amʉlete ʉ Simoni nʉitangwa Petelo. <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />Ng'wenso ʉkʉʉpa lʉkani ʉewe nawa ɨhi nɨa mitolako nɨmʉtakɨwe kʉtenda mʉhume kʉgunɨka.’ <verse eid="ACT 11:14" /><verse number="15" style="v" sid="ACT 11:15" />Nʉnene naza nandilye kʉtambʉla, Ng'wahʉ Ng'welʉ wɨkasima migʉlyaao anga naɨʉkʉsimɨɨe ʉsese apo pa ng'wandyo. <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" />Papo nɨkakɨmbʉka ʉlʉkani lang'wi Isekʉlʉ Yesʉ naɨʉtambʉe, ‘Yohana aɨʉbadisilye kʉ mazɨ, ʉnyenye ingɨ mʉkʉbadisigwa kʉ Ng'wahʉ Ng'welʉ.’ <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />Ingɨ Itunda anga itule aɨʉapee antʉ awa kɨpegwa kɨko kɨɨko naɨʉkʉpee ʉsese naɨkʉmʉhʉɨɨe Isekʉlʉ Yesʉ, itɨɨ, ʉnene naina nɨ nyenyu nɨngeme kʉmikʉngʉmya Itunda?” <verse eid="ACT 11:17" /><verse number="18" style="v" sid="ACT 11:18" />Antʉ naɨija inkani izi ɨkaʉlya nila kikʉngʉmya. Nawo ɨkamʉkʉlya Itunda azelʉnga, “Itunda, ʉapee antʉ nɨshanga Ayahudi kila itʉnʉ nɨlɨletaa ʉpanga nʉwa kalɨ na kalɨ.”<verse eid="ACT 11:18" /></para>
  <para style="s">Ahʉɨɨli ang'wa Yesʉ nɨa kʉ Antiokia</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />Itungo lɨlo lɨɨlo ahʉɨɨli ang'wa Yesʉ naɨabalansanile kʉpumɨɨla kʉ Yelusalemʉ matungo alwango naɨakɨla ɨnsha ang'wa Sitepwano. Nɨang'wɨ ɨkalongola kʉli kʉpikɨɨla kʉ Poiniki nʉ kʉ Kipʉlo nʉ kʉ Antiokia nʉ kʉ Silia, ɨkatanantya Nkani Nza kʉ Ayahudi ʉdu. <verse eid="ACT 11:19" /><verse number="20" style="v" sid="ACT 11:20" />Ingɨ ahʉɨɨli ang'wa Yesʉ nɨang'wɨ naɨapumɨɨe kʉ Kʉpʉlo nʉ kʉ Kilene, ɨkalongola kʉ Antokia, ɨkandya kʉtanantya Nkani Nza nɨang'wa Isekʉlʉ Yesʉ kʉ antʉ nɨshanga Ayahudi. <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />Ʉhumi wang'wi Isekʉlʉ wɨkatula palʉng'wɨ nɨenso nɨ antʉ ɨdʉ nɨshanga Ayahudi ɨkahʉɨɨla nʉkʉmʉsʉkɨla Itunda.<verse eid="ACT 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22" />Mpola yikani nɨlanso yɨkaapikɨɨla antʉ naɨ amʉhʉɨɨla ʉ Yesʉ kʉ Yelusalemʉ, ɨkamʉlagɨɨlya ʉ Balinaba walongole kʉ Antiokia. <verse eid="ACT 11:22" /><verse number="23" style="v" sid="ACT 11:23" />Balinaba naɨwɨkapika kʉ ng'wanso, wɨkahanga itɨ Itunda naɨ ʉakembetile antʉ nɨanso, wɨkiloa nʉkʉakomya nkolo ɨhi akagupe mʉ ʉhʉɨɨlɨ wao kʉng'wi Isekʉlʉ kʉ nkolo nɨyao yɨhi. <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />Balinaba aɨmʉntʉ mʉkende hangɨ aɨʉtoneewe nʉ Ng'wahʉ Ng'welʉ hangɨ mʉhʉɨɨlɨ. Antʉ ɨdʉ ɨkangeeleka kʉng'wi Itunda.<verse eid="ACT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25" />Sʉnga Balinaba wɨkalongola kʉ kɨsalɨ ka Taliso kʉmʉduma ʉ Sauli. <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />Naɨwamʉpantɨka, wɨkamʉleta kʉ Antiokia. Ɨhi mʉbiɨlɨao akikiɨ nɨantʉ nɨamʉhʉʉɨe Isekʉlʉ ng'waka wɨhi ɨkaze amanyisa antʉ. Kʉng'wanso kʉ Antokia, kʉko ahʉɨɨli ang'wa Yesʉ aɨandɨɨye kitangwa Akilisito.<verse eid="ACT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27" />Matungo nanso amanga ang'wi Itunda ang'wɨao aɨahulumʉkile kʉ Antiokia kʉpuma kʉ Yelusalemu. <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" />Mʉmanga ʉng'wɨ lina lakwe Agabo, kʉ ʉhumi nʉwa Ng'wahʉ Ng'welʉ wɨkimɨka wɨkapumya mʉloto kɨna izala ikʉlʉ lɨkenela mihɨɨ ɨhi. Nzala nanso ɨkʉpumɨle mʉ ʉtemi wang'wa Tibelio. <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />Itʉmi ɨkalagɨɨlya mʉntʉ wɨhi, anga ʉhumi wakwe nʉkete, wamʉgeele mʉnyandʉgʉ nʉishiɨ mʉ Yʉdea. <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />Ʉʉgwa ɨkatendaʉ, ʉgeeli wao wɨkatalwa kʉa Balinaba nʉ Sauli, awo atwale kuatongeeli a ahʉɨɨli ang'wa Yesʉ.<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="s">Ahʉɨɨli ang'wa Yesʉ akagigwa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />Itungo lɨlo lɨɨlo Mʉtemi Helode Agilipa aɨwandilye kʉamba Ahʉɨɨli ang'wɨ nɨang'wa Yesʉ nʉkʉaja. <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />Wɨkalagɨɨlya ʉ Yakobo ʉ mʉluna wang'wa Yohana, wabʉlagwe kʉteng'wa panga. <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />Naɨwaona ikani nɨlanso laaloeelya ɨ Ayahudi, wɨkalongoleka, wɨkamʉamba ʉ Petelo. Ɨlɨ aɨlɨtendekile matugo iloeelya nɨla Mɨkate Nɨshanga ɨgahɨɨye. <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />Naɨ wamʉamba ʉ Petelo wɨkamʉtunga mʉkadulumu, wɨkaɨka amboi maumbɨ annɨ, idale lɨng'wɨ lɨkete amboi annɨ annɨ ahume kʉmʉsʉnja. Herode aɨʉlomee anga ɨkɨle ɨ pasaka ʉkʉmʉpumya kʉ antʉ amʉpɨsɨɨlye. <verse eid="ACT 12:4" /><verse number="5" style="v" sid="ACT 12:5" />Kʉlʉlo ʉ Petelo naɨʉkolɨ mʉkadulumu, ingɨ ahʉɨɨli ang'wa Yesʉ aɨakagupile kʉmʉlompa Itunda.<verse eid="ACT 12:5" /></para>
  <para style="s">Petelo ʉkʉpumigwa mʉkadulumu</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6" />Ʉtikʉ nʉwanso Helode Agilipa aɨwakɨlɨ ʉlomee kʉmʉpumya ʉ Petelo wamʉpɨsɨɨlye pa ntongeela antʉ, Petelo aɨʉlae pakatɨ a amboi abɨɨlɨ, waze ʉtungilwe mɨnyololo ɨbɨɨlɨ. Amboi aɨakʉsʉnja pa mʉlango nʉwa kadulumu. <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />Papo paapo Malaɨka wang'wi Itunda wɨkapumɨla nzelya ikelya mʉnyʉmba. Malaɨka ʉyʉ wɨkamʉgutya ʉ Petelo palʉbalu, wɨkamʉʉsha wazelʉnga, “Kaya hega.” Papo mɨnyololo naɨamʉtungile ʉ Petelo ɨkatungʉka nʉkʉgwa kʉpuma mʉ mɨkono. <verse eid="ACT 12:7" /><verse number="8" style="v" sid="ACT 12:8" />Malaɨka ʉyʉ wɨkamʉɨla, “Tugala ɨngʉo ako nɨ makwasa ako.” Petelo wɨkatenda anga naɨ ʉlagɨɨigwe. Sʉnga Malaɨka wɨkamʉɨla, “Itunge mʉgolole wako ʉntyate.” <verse eid="ACT 12:8" /><verse number="9" style="v" sid="ACT 12:9" />Petelo wɨkapuma mʉkadulumu azeakʉɨlanilye nʉ Malaɨka. Itungo nɨlanso shanga aɨʉlɨngile aya ɨhi nakʉpumɨla aɨataine. Aɨʉsɨgile kɨna mʉloto. <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />Ɨkakɨla mʉlango nʉwa kwandya nʉwʉ nʉwa kabɨɨlɨ, papo ɨkapika pa mʉmpita nʉwa shʉma nʉwakingɨɨlɨla mʉ kɨsalɨ. Mʉmpita nʉanso wɨkalugʉka ʉwenso, nawo ɨkakɨla ɨkapuma kʉnzi. Naɨakʉgenda mʉ nzɨla, pumpulugu Malaɨka wɨkamʉleka ʉ Petelo wing'wene.<verse eid="ACT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11" />Papo paapo Petelo naɨ wanzʉʉkɨlwa nɨ ndʉɨ, wɨkalʉnga, “Itungo ɨlɨ nalɨnga kʉlʉ kʉʉlʉ Isekʉlʉ ʉmʉlagɨɨye Malaɨka wakwe kʉmpumya kʉpuma mʉ mɨkono ang'wa Helode Agilipa nʉ kʉpuma mʉ masɨgo a Ayahudi.”<verse eid="ACT 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12" />Petelo naɨ wanzʉʉkɨlwa nɨ ndʉɨ wɨkalongola mʉ nyʉmba ang'wa Malia, nyinya wang'wa Yohana nʉitangwa Maliko. Mʉnyʉmba nanso antʉ ɨdʉ aɨatankanile kʉnsoko a malompi. <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />Petelo wɨkapɨndʉla pa mʉmpita nʉwa kʉnzi, mʉtugwa ʉng'wɨ mʉnanso lina lakwe Loda, wɨkahugeela pa mʉlango kʉtegeelya. <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />Mʉnanso ʉyʉ naɨwalɨnga ʉlʉli lang'wa Petelo, wɨkiloa nangalu ingɨ shanga wɨkalugʉla, wɨkamankɨɨla mʉnyʉmba nʉkʉaɨla ɨantʉ ɨhi kɨna, “Petelo ʉkolɨ panzi a mʉmpita.” <verse eid="ACT 12:14" /><verse number="15" style="v" sid="ACT 12:15" />Amanyisigwa ɨkamʉɨla ʉ mʉnanso, “Ʉewe wahala.” Mʉnanso ʉyʉ wɨkalongoleka kʉkomangɨɨla kɨna tai, ɨkalʉnga, “Kwaala ʉkʉtula Malaɨka wakwe.”<verse eid="ACT 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16" />Ingɨ ʉ Petelo wɨkalongoleka kʉpɨndʉla, nɨenso naɨalugʉla ʉ mʉmpita ɨkamʉona ʉ Petelo, ɨkalʉngʉala nangalu. <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />Petelo nʉyo wɨkaagingɨla ʉ mʉkono akilage ihɨtwɨ, wɨkaaganʉɨla Isekʉlʉ aɨʉmʉpumilye ʉlɨ mʉkadulumu. Petelo wɨkalongoleka kʉlʉnga, “Aganʉɨli mpola izi Yakobo nɨ ahʉɨɨli aʉya nɨang'wa Yesʉ.” Sʉnga ʉ Petelo wɨkahega wɨkalongola nkɨka ngɨɨza.<verse eid="ACT 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18" />Naɨwela amboi ɨkogopa nangalʉ kʉ makani naɨapumɨe kʉng'wa Petelo. <verse eid="ACT 12:18" /><verse number="19" style="v" sid="ACT 12:19" />Helode wɨkalagɨɨlya Petelo wadung'we nkɨka yɨhi, ingɨ shanga ɨkamʉona. Ɨtɨgwa wɨkaakolenkeelya ɨ amboi naɨ akʉsʉnja ɨkadulumu, sʉnga wɨkalagɨɨlya ɨamboi nɨanso abʉlagwe.</para>
  <para style="p" vid="ACT 12:19">Naɨakɨla aya, Helode Agilipa wɨkapuma kʉ Yʉdea wɨkalongola kʉ kɨsalɨ ka Kaisalia, wɨkikiɨ kʉko mahikʉ makeehʉ.<verse eid="ACT 12:19" /></para>
  <para style="s">Helode Agilipa ʉkʉsha</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20" />Sʉnga Helode Agilipa aɨwatakigwa nɨ antʉ a kʉ Tilo nɨ Sidoni. Itɨ gwa antʉ a isalɨ izi ni ibɨɨlɨ kʉ palʉng'wɨ ɨkihanja ɨkaduma lyoma nɨla kʉtankana nʉyo. Ɨkamʉpembeseelya ʉ Bilasito mitʉmɨ nʉhʉɨɨwe nʉ Mʉtemi Helode Agilipa, ɨkalompa wigombya nɨ matiliga kʉnsoko aɨasanilye kʉaɨɨligwa ndya kʉpuma kihɨɨ a mʉtemi nʉanso.<verse eid="ACT 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 12:21" />Mʉlʉhikʉ naɨlʉgambilwe mʉtemi Helode Agilipa wɨkatugala ngʉo a kɨtemi, wɨkikiɨ mituntu lakwe nɨla ʉkʉlʉ wɨkatula ligitya nɨantʉ. <verse eid="ACT 12:21" /><verse number="22" style="v" sid="ACT 12:22" />Antʉ naɨilundiie ɨkalʉnga, “Ʉlʉ shanga lʉli la ng'waa mʉntʉ, ingɨ lʉli lang'wi Itunda witʉ.” <verse eid="ACT 12:22" /><verse number="23" style="v" sid="ACT 12:23" />Papo paapo kʉnsoko Helode Agilipa shanga aiwɨmʉkʉlya Itunda, Malaɨka wang'wi Isekʉlʉ wɨkamʉgwɨsa pihɨ, wɨkaambwa kɨntunga sʉnga wɨkasha.<verse eid="ACT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24" />Ingɨ lʉkani lang'wi Itunda lɨkalongoleka kʉtanantigwa, antʉ ɨdʉ ɨkamʉhʉɨɨla ʉ Yesʉ Kilisito.<verse eid="ACT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 12:25" />Balinaba nʉ Sauli naɨakondya ʉmʉlɨmo wao naɨendee, ɨkatulya kʉ Yelʉsalemu ɨze ɨpalʉng'wɨ nʉ Yohana nʉitangwa Maliko.<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="s">Balinaba nʉ Sauli akʉholwa nʉ kʉtʉng'wa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />Kʉ ahʉɨɨli ang'wa Yesʉ kʉ Antiokia nʉ kʉ Shamu aɨakolɨ antʉ naɨ amanga nɨ amanyisi amalagɨɨlyo ang'wa Musa, ang'wɨao ingɨ a Balinaba nʉ Simoni nʉitangwa Milwalu nʉ Lʉko nʉwa kʉ Kilene nʉ Manaeni naɨ akʉlanilye nʉ mʉtemi Helode Agilipa nʉ Sauli. <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />Naɨ akipolya kʉng'wi Isekʉlʉ nʉ kʉgwalya, Ng'wahʉ Ng'welʉ wɨkalʉnga, “Ntemanʉɨlyi a Balinaba nʉ Sauli kʉ mʉlɨmo ʉwo naɨ nɨitangɨe.”<verse eid="ACT 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 13:3" />Papo gwa naɨ akondya kipolya nʉ kʉgwalya, ɨka aɨkɨɨlya mɨkono a Paʉlo nʉ Balinaba, ɨkaaleka alongole.<verse eid="ACT 13:3" /></para>
  <para style="s">Balinaba nʉ Sauli akʉlongola kʉ Kipolo</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />Itɨgwa, Balinaba nʉ Sauli azealagɨigwe nʉ Ng'wahʉ Ng'welʉ, ɨkahulumʉka Seleʉkia nʉ kʉpuma kɨng'wanso ɨkalongola kʉkɨɨla mʉlʉzɨ ɨkapika kihɨɨ nɨpilimilwe nɨ mazɨ na Kipolo. <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />Naɨapika mʉ kɨsalɨ ka Salami, ɨkatanantya lʉkani lang'wi Itunda mʉ nyʉmba niya kʉtankanɨla Ayahudi. Yohana Maliko aɨwɨaaɨɨlya mɨlɨmoao.<verse eid="ACT 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6" />Naɨakɨla ihɨɨ nɨpilimilwe nɨ mazɨ ɨkapikɨɨla kʉ Papwo, kʉng'wanso ɨkatankana nʉ Mʉyahudi ʉng'wɨ mʉlogi naɨ witendisa kɨna mʉmanga, lina lakwe Bali Yesʉ. <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />Mʉntʉ ʉyʉ aɨɨpalʉng'wɨ nʉ Seligio Paʉlo, mʉntʉ nɨmʉnya mahala mʉhemba nʉwa mʉtaata nʉwa mʉtemi mʉ kɨsalɨ nɨkanso, Seligio Paʉlo wɨkaitanga a Sauli nʉ Balinaba wazehiya kija lʉkani lang'wi Itunda. <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />Ingɨ ʉ Elima ʉyo naɨ mʉlogi ɨyɨ yɨyɨ ndogoelyo a lina lakwe kʉ Kɨgiliki, wɨkaahitɨlya a Balinaba nʉ Sauli nʉkʉgema kʉmʉpʉtaalya ʉmʉkʉlʉ nʉwa kɨsalɨ waleke kʉmʉhʉɨɨla Yesʉ. <verse eid="ACT 13:8" /><verse number="9" style="v" sid="ACT 13:9" />Papo ʉ Sauli, nʉwitangwa Paʉlo, waze ʉkete ngulu a Ng'wahʉ Ng'welʉ, wɨkamʉgozeela ʉ Elima nɨmʉlogi, <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />wɨkamʉɨla, “Ʉewe ng'wana wang'wa shetani, ʉewe wɨmʉlʉgʉ nʉwa kɨntʉ kɨhi nɨka tai. Wizʉe mpyani yɨhi niya ʉpʉtaalyi nʉ ʉteele. Itɨɨ, shanga ʉkʉlekane kʉlimangɨɨlya nzɨla yang'wi Isekʉlʉ niyigolokile? <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />Itungo ɨlɨ tegeelya, ʉhumi wang'wi Isekʉlʉ wakʉlomeela ʉewe. Ʉkʉpokula shanga ʉkʉona nzelya a lyoa.”</para>
  <para style="p" vid="ACT 13:11">Papo paapo ikuhɨ nɨ kiti kɨkamʉkunɨkɨla, nʉyo wɨkatula daga wazeduma mʉntʉ nʉwa kʉmʉamba mʉkono wahume kʉmʉlagɨɨla ɨnzɨla. <verse eid="ACT 13:11" /><verse number="12" style="v" sid="ACT 13:12" />Mʉkʉlʉ ʉyʉ nʉwa kɨsalɨ naɨwaona napumɨe, wɨkogopa wɨkamʉhʉɨɨla ʉ Yesʉ, kʉnsoko aɨʉkʉɨwe ʉmanyisi wang'wi Isekʉlʉ.<verse eid="ACT 13:12" /></para>
  <para style="s">Paʉlo nʉ Balinaba kʉ Antiokia namʉ Pisidia</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />Sʉnga ʉ Paʉlo nɨaʉya ɨkatunga mʉhɨnzo kʉpuma kʉ Papwo ɨkapika kʉ Pelige kihɨɨ a kʉ Pampilia. Ingɨ Yohana nʉwitangwa Maliko wɨkaaleka kʉko nʉwanso wɨkatulya kʉ Yelusalemu. <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />Ingɨ a Paʉlo nʉ Balinaba ɨkahega kʉ Pelige ɨkakɨlɨnkania ɨkalongola kʉ Antiokia nakʉ Pisidia, lʉhikʉ nʉla kʉsupya a Ayahudi ɨkingɨla nʉ kikiɨ mʉ nyʉmba akʉtankanɨla Ayahudi. <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />Naɨ lakondya kʉnsong'wa Malagɨɨlyo ang'wa Musa nɨ mbugulu niya amanga ang'wi Itunda, atongeeli a nyʉmba akʉtankanɨla Ayahudi ɨkalagɨɨlya lʉkani azelʉnga, “Anyandʉgʉ, anga ɨze mʉkete lʉkani nʉla kʉakomya nkolo ɨantʉ awa, itʉnʉ tambʉli.” <verse eid="ACT 13:15" /><verse number="16" style="v" sid="ACT 13:16" />Paʉlo wɨkimɨka, wɨkaahʉmbʉɨla mʉkono akilaje, wɨkandya kʉtambʉla.</para>
  <para style="p" vid="ACT 13:16">“Ʉnyenye Aisilaeli ɨane nʉ nyenye mɨhi nɨ mɨmʉkʉlya Itunda, ntegeelyi. <verse eid="ACT 13:16" /><verse number="17" style="v" sid="ACT 13:17" />Itunda nʉwa Aisilaeli aɨʉahoile agʉkʉ itʉ, wɨkaapa ʉhumi nʉwakituga nʉ kongeleka naɨakolɨ kʉ Misili, kʉ ʉhumi ʉkʉlʉ wɨkaatongeela nʉ kʉapumya mihɨɨ a Misili. <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />Aɨʉgimilye intendo yao mʉwɨɨ myaka makʉmi annɨ. <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />Itunda naɨ wakondya kʉalimansɨɨlya ndʉgʉ yɨhi mʉpungatɨ niya kʉ Kanaani, wɨkaapa ihɨɨ Aisilaeli ituleao. <verse eid="ACT 13:19" /><verse number="20" style="v" sid="ACT 13:20" />Makani aya ɨhi aɨahoile itungo anga la myaka magana annɨ nɨ makʉmi ataano.</para>
  <para style="p" vid="ACT 13:20">“Naɨakɨla aya, Itunda wɨkaapa alamʉli aatongele kʉpikɨɨla Samweli mʉmanga wang'wi Itunda. <verse eid="ACT 13:20" /><verse number="21" style="v" sid="ACT 13:21" />Papo Aisilaeli ɨkalompa apegwe mʉtemi, Itunda nʉyo wɨkaapa Sauli ng'wana wang'wa Kishi naɨ wandʉgʉ ang'wa Benjamini watule mʉtemi nʉwao. Nʉyo wɨkatema kʉ myaka makʉmi annɨ. <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />Itunga naɨwamʉheja ʉ Sauli mʉ ʉtemi, wɨkamʉtemya ʉ Daudi kʉtula mʉtemi wao. Itunda wɨkalʉnga, ‘Namʉona ʉ Daudi ng'wana wang'wa Yese, mʉntʉ nʉmɨloeeye ɨnkolo ane, mʉntʉ nʉɨkatenda aya ɨhi nɨndoilwe atendwe.’ <verse eid="ACT 13:22" /><verse number="23" style="v" sid="ACT 13:23" />“Kʉpuma mʉ wileli ʉwʉ nʉwang'wa Daudi, Itunda wamʉletela Yesʉ Muguni nʉwa Aisilaeli, anga naɨʉlapile kʉpuma ɨkalɨ. <verse eid="ACT 13:23" /><verse number="24" style="v" sid="ACT 13:24" />Yesʉ naɨ wakɨlɨ kandya mʉlɨmo wakwe, Yohana Mʉbadisi aɨʉtanantɨɨye antʉ ɨhi nɨa Aisilaeli kila itʉnʉ nʉ ʉbadisigwa. <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" />Yohana naɨ ʉkʉkondanɨɨlya ʉ mʉlɨmo wakwe, aɨʉlʉngile, ‘Ʉnyenye mʉsɨgile ʉnene nɨ nyenyu? Ʉnene shanga nɨ Kilisito nɨmʉmʉlindɨɨe. Nʉwanso ʉpembilye ʉntyatile, ʉnene nimʉgila ʉhumi nʉwa kʉtolya mɨkoha a makwasa akwe.’<verse eid="ACT 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26" />“Anyandʉgʉ ane Aisilaeli, ana ang'wa Ibulahimu, nʉnyenye antʉ ɨhi nɨ shanga Ayahudi nɨmɨmʉkʉlya Itunda, mpola izi niya ʉgunwa yɨzile kʉ antʉ ɨhi. <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />Antʉ ɨhi nɨishiɨ mʉ Yelusalemu nɨatongeeli awo shanga ɨkamʉmanya ang'wɨ kʉlɨnga inkani niya amanga ang'wi Itunda niisong'wa mahikʉ ɨhi nakʉsupya Ayahudi. Ingɨ nkani niyanso aɨyikondanɨɨye nkani niya amanga ang'wi Itunda kʉlamʉla ʉ Yesʉ washe. <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" />Nɨ itɨga shanga ɨkalija nsoko akʉlamʉla Yesʉ washe, aɨamʉlompile ʉ Pilato kɨna walamule ʉ Yesʉ wabʉlagwe. <verse eid="ACT 13:28" /><verse number="29" style="v" sid="ACT 13:29" />Naɨ akondya kʉmʉtendeela ɨhi Yesʉ naɨʉandɨkɨwe, ɨkamʉbʉlaga aze amʉkomile mʉmʉsalaba ɨkamʉsimya nʉ kʉmʉɨka mʉ kɨbɨɨla naɨ kɨpʉʉwe migwe. <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />Ingɨ Itunda wɨkamiʉsha kʉashi. <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" />Mahikʉ ɨdu Yesʉ aɨʉapumɨe awa naɨ ɨgendania kandɨɨlya kʉ Galilaya kʉpikɨɨla kʉ Yelusalemu. Nawo itungo ɨlɨ aile akʉɨɨli akwe kʉ Aisilaeli. <verse eid="ACT 13:31" /><verse number="32" style="v" sid="ACT 13:32" />Nʉsese kʉmʉletee Nkani Nza niyang'wi Itunda kɨna aɨʉalapɨe ɨ agʉkʉ itʉ, <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />itungo ɨlɨ ʉkondanɨɨye kʉng'witʉ nɨ anaao, kʉmiʉsha ʉ Yesʉ. Anga nɨyandɨkilwe mʉ zabuli a kabɨɨlɨ.</para>
  <para style="q" vid="ACT 13:33">‘Ʉewe ingɨ wɨng'wana wane,</para>
  <para style="q" vid="ACT 13:33">ʉnene lelo naina nɨ Tataako.’<verse eid="ACT 13:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="ACT 13:34" />Kʉnsoko Itunda aɨʉmiʉkilye waleke kʉola lʉkʉlʉ, aɨʉtambʉe nkani izi.</para>
  <para style="q" vid="ACT 13:34">‘Kʉʉpa ʉewe ʉkendepwa nʉwa kʉlʉ kʉʉlʉ</para>
  <para style="q" vid="ACT 13:34">ʉwo naɨ nʉmʉlapɨe ʉ Daudi.’<verse eid="ACT 13:34" /></para>
  <para style="m">
    <verse number="35" style="v" sid="ACT 13:35" />Anga niyitambʉwe nɨpaʉya mʉ Zabuli,</para>
  <para style="q" vid="ACT 13:35">‘Shanga ʉkʉmʉleka Mʉkembetwa wako waole.’<verse eid="ACT 13:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="ACT 13:36" />Daudi aɨʉtʉmɨkɨe isɨgo lang'wi Itunda mʉ wileli wakwe, sʉnga wɨkasha wɨkaɨkwa pakupɨ nɨihe nʉ mʉɨlɨ wakwe wɨkaola. <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />Ingɨ ʉyo Itunda aɨʉmiʉkilye Yesʉ shanga wɨkʉona ʉbɨ. <verse eid="ACT 13:37" /><verse number="38" style="v" sid="ACT 13:38" />Kʉlʉlo anyandʉgʉ ane Aisilseli, ndoilwe ʉnyenye mʉlɨnge kɨna kʉkɨɨla Yesʉ ʉyʉ ʉlekelwa nʉwa mɨlandʉ watanantigwa kʉng'wanyu. <verse eid="ACT 13:38" /><verse number="39" style="v" sid="ACT 13:39" />Mʉntʉ wɨhi nʉmʉhʉɨɨe ʉ Yesʉ ʉkʉlekelwa mɨlandʉ ɨhi, ikani nɨshanga aza lɨhumɨkile kʉ kʉkɨɨla malagɨɨlyo ang'wa Musa. <verse eid="ACT 13:39" /><verse number="40" style="v" sid="ACT 13:40" />Kʉlʉlo itungo ɨlɨ hʉgʉki ingɨ mʉleke kʉhangwa nayo naɨ amatambʉe ɨ amanga ang'wi Itunda.<verse eid="ACT 13:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="ACT 13:41" />‘Tegeelyi, ʉnyenye nɨmʉkete insasɨla, mʉkʉɨlwe, mʉlimansɨɨle.</para>
  <para style="q" vid="ACT 13:41">Kʉnsoko kɨntʉ nɨkitʉma itungo ɨlɨ, mʉ matungo anyu,</para>
  <para style="q" vid="ACT 13:41">kʉtenda kɨntʉ nɨshanga mʉkʉhʉɨɨla,</para>
  <para style="q" vid="ACT 13:41">mʉntʉ wɨhi ga anga wamʉganʉɨle.”’<verse eid="ACT 13:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42" />Paʉlo nʉ Balinaba naɨ akʉpuma mʉnyʉmba akʉtankanɨla Ayahudi, antʉ ɨkaaɨla atambʉle hangɨ inkani niyanso mʉ lʉhikʉ nʉla kʉsupya Ayahudi nʉlʉtyatile. <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />Ahʉɨɨli ang'wa Yesʉ naɨabalansana, Ayahudi ɨdʉ nɨantʉ nɨshanga Ayahudi naɨ ahʉɨɨli adini a Kiyahudi ɨkaatyata a Paʉlo nʉ Balinaba, ɨkitambʉlya nawo nʉkʉakomya nkolo ikiɨ azeasanilye ʉkende wang'wi Itunda.<verse eid="ACT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44" />Lʉhikʉ lʉlya nʉla kʉsupya Ayahudi, antʉ ɨdʉ mʉ kɨsalɨ nɨkanso aɨazile kʉtegeelya Nkani Nza niyang'wa Yesʉ Kilisito. <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" />Ayahudi naɨalɨona iumbɨ nɨla antʉ ɨkaaonela wɨlu nʉ kʉbehʉla nkani nɨʉkʉtambʉla ʉ Paʉlo nʉkʉmʉtʉkɨla. <verse eid="ACT 13:45" /><verse number="46" style="v" sid="ACT 13:46" />Papo Paʉlo nʉ Balinaba ɨkaasʉkɨɨlya kʉ ʉkamatɨku, azelʉnga, “Aza kʉtakɨwe kʉmʉtanantɨlye hanza lʉkani lang'wi Itunda. Kʉnsoko malʉhita, kʉlʉlo mipɨsɨɨye ʉnyenye kɨna ʉpanga nʉwa kalɨ na kalɨ shanga wanyu, itungo ɨlɨ kʉʉmʉleka kʉapɨlʉkʉla antʉ nɨshanga Ayahudi. <verse eid="ACT 13:46" /><verse number="47" style="v" sid="ACT 13:47" />Ʉlʉ lʉlʉ lʉkani Isekʉlʉ ʉkʉlagɨɨye.</para>
  <para style="q" vid="ACT 13:47">‘Namʉɨka ʉnyenye mʉtule mɨnzelya kʉ antʉ nɨshanga Ayahudi,</para>
  <para style="q" vid="ACT 13:47">ingɨ antʉ ɨhi mihɨɨ agunɨke.”’<verse eid="ACT 13:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48" />Antʉ nɨshanga Ayahudi naɨija ikani ɨlɨ ɨkalowa nʉkʉlʉkʉlya lʉkani lang'wi Isekʉlʉ, nawo ɨhi naɨ asʉmbɨɨye ʉ ʉpanga nʉwa kalɨ na kalɨ ɨkamʉhʉʉɨla Isekʉlʉ Yesʉ.<verse eid="ACT 13:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="ACT 13:49" />Lʉkani lang'wi Isekʉlʉ lɨkenela nkɨka yɨhi mʉ kɨsalɨ nɨkanso. <verse eid="ACT 13:49" /><verse number="50" style="v" sid="ACT 13:50" />Ayahudi ɨkaapema asʉngʉ nɨɨmʉkʉlyaa Itunda, nɨakete ʉkʉlʉ palʉng'wɨ nɨ antʉ nɨakumʉkile mʉ kɨsalɨ. Sʉnga ɨkakinyɨla Paʉlo nʉ Balinaba agigwe nʉ kʉazunsa apume mʉ kɨsalɨ kao. <verse eid="ACT 13:50" /><verse number="51" style="v" sid="ACT 13:51" />Ingɨ a Paʉlo nʉ Balinaba ɨkapununta lʉnkʉndɨ mʉ mɨgʉlʉao anga akʉahʉgʉlya, nawo ɨkalongola kʉ kɨsalɨ ka Ikonio. <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />Amanyisigwa a kʉ kɨsalɨ ka Antiokia ikiloa nʉkʉtongwa kʉ Ng'wahʉ Ng'welʉ.<verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="s">Paʉlo nʉ Balinaba akolɨ kʉ Ikonio</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />Kʉng'wanso kʉ kɨsalɨ ka Ikonio Paʉlo nʉ Balinaba aɨingɨlania mʉ nyʉmba niya kʉtankanɨla Ayahudi anga naɨizɨɨe. Ɨkatanantya Nkani Nza niyang'wi Itunda kʉʉkamatɨku Ayahudi nɨ Agiliki ɨkahʉɨɨla. <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />Ingɨ Ayahudi naɨ ahʉɨɨe ɨka ahʉgʉlya antʉ nɨ shanga Ayahudi nɨshanga ahʉɨɨe nʉkʉakinyɨla aakʉe antʉ nɨ shanga Ayahudi nɨahʉɨɨe. <verse eid="ACT 14:2" /><verse number="3" style="v" sid="ACT 14:3" />Paʉlo nʉ Balinaba ɨkishiɨ kʉng'wanso kitungo ɨlɨpu, aze akamatɨku kʉtanantya nkani yang'wi Isekʉlʉ. Isekʉlʉ nʉyo wɨkakamɨnkɨɨlya ʉlʉkani lakwe kʉ ʉkende wakwe, waze ʉahumilye kʉtenda ilɨngasɨɨlyo nɨ mɨʉkʉɨlwa. <verse eid="ACT 14:3" /><verse number="4" style="v" sid="ACT 14:4" />Ingɨ antʉ nɨa kɨsalɨ nɨkanso ɨkahutana, nɨang'wɨ ɨkigombya nɨ Ayahudi nɨ shanga ahʉɨɨli, nɨang'wɨ ɨkigombya nɨ itʉmi.<verse eid="ACT 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 14:5" />Antʉ nɨ shanga Ayahudi nɨ Ayahudi ɨkihanja nɨ akʉlʉao, ɨkalomeela kʉatendeela ʉbɨɨ itʉmi nʉ kʉakʉa magwe. <verse eid="ACT 14:5" /><verse number="6" style="v" sid="ACT 14:6" />Itʉmi naɨ ija ikani ɨlɨ ɨkamankɨɨla isalɨ niya kʉ Lisitila nʉ kʉ Delibe, isalɨ niyikolɨ kʉ Likaonia nɨ mahɨɨ nakolɨ pakupɨ, <verse eid="ACT 14:6" /><verse number="7" style="v" sid="ACT 14:7" />kʉng'wanso ɨkalongoleka kʉtanantya Nkani Ninza niyang'wi Itunda.<verse eid="ACT 14:7" /></para>
  <para style="s">Paʉlo nʉ Balinaba akolɨ kʉ Lisitila nʉ kʉ Delibe</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />Kʉ kɨsalɨ nɨkanso nɨka Lisitila aɨʉkolɨ mitʉnja kitele, shanga aɨwigendaa mʉʉtugwa wakwe. <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />Mʉntʉ ʉyʉ wɨkija ʉ Paʉlo nʉkʉtanantya. Paʉlo nʉyo wɨkamʉkendegela nʉ kʉona kɨna ʉkete ʉhʉɨɨli nʉwa kʉkomya, <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />Paʉlo wɨkamitʉntɨɨla, “Imɨke kʉ mɨgʉlʉ ako.” Kɨtele ʉyʉ wɨkimɨka nʉkandya kʉgenda. <verse eid="ACT 14:10" /><verse number="11" style="v" sid="ACT 14:11" />Milʉndo nʉwa antʉ naɨ aona nʉwitʉmile ʉ Paʉlo, ɨkazogolya, azetambʉla kʉ ntambʉ a Kilikaonia, “Alʉngʉ aina anga antʉ nawo akʉhanga.” <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />Ɨkamʉta ʉ Balinaba Zeu lina nɨla mʉlʉngʉ nʉmʉkʉlʉ nʉ Paʉlo ɨkamʉta Helime lina nɨla mʉlʉngʉ mʉya, kʉnsoko Paʉlo aɨmʉtambʉli nʉ mʉkʉlʉ. <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" />Mʉpolyi wang'wa Zeu naɨɨza nyʉmba akwe naɨ akipoelya ɨkolɨ kʉnzi a kɨsalɨ, wɨkaleta amʉzagamba a ng'ombe nɨ ngala niya mpʉmbʉʉlʉ pa mʉmpita nʉwa kɨsalɨ. Kʉnsoko nʉwanso palʉng'wɨ nʉ milʉndo nʉwa antʉ aɨakʉhiya kʉapa ipolyo ɨ itʉmi.<verse eid="ACT 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14" />Ingɨ a Balinaba nʉ Paʉlo, naɨ ija impola niyanso, ɨkatamʉla ɨngʉoao kʉhita kipoligwa, ɨkamanka ɨkingɨla mʉ milʉndo nʉwa antʉ, ɨkaitʉntɨɨla, <verse eid="ACT 14:14" /><verse number="15" style="v" sid="ACT 14:15" />“Ʉnyenye antʉ, nɨkɨ mʉkʉtenda itɨ? Ʉsese kɨ antʉ anga ʉnyenye, kʉʉmʉtanantɨlya Nkani Nza, mʉhume kʉpɨʉlwa nʉ kʉleka kipoelya ɨadʉdʉ nʉkʉmʉtyata Itunda nɨ mʉpanga, naɨ ʉtundile igʉlʉ nihɨɨ nʉlʉzɨ nɨ maintʉ ɨhi namolɨ. <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />Pa kalɨ Itunda aɨʉalekile antʉ ɨhi nɨshanga Ayahudi itʉme mʉaloewe. <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />Nɨ itɨ ga, Itunda shanga aɨʉlekile kʉatendeela ʉkende nʉwakwe, wɨapa mbula kʉpumɨɨla kilunde, wɨapeza maogola kʉ matungo akwe, wɨapeza indya nʉʉlowa.” <verse eid="ACT 14:17" /><verse number="18" style="v" sid="ACT 14:18" />Palʉng'wɨ nʉkʉtambʉla nkani izi yɨhi Paʉlo nʉ Balinaba ɨkahuma kʉagilya kʉntandatʉ ɨ antʉ nɨanso kʉapa ipolyo.<verse eid="ACT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19" />Naɨlakɨla itungo Ayahudi ang'wɨ nɨakʉpuma kʉ Antiokia nʉ kʉ Ikonio, ɨkaapema ɨantʉ, ɨkamʉkʉa magwe ʉ Paʉlo, ɨkamʉkweha kʉnzi a kɨsalɨ, azeasɨgile kɨna wakuzaa. <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />Ingɨ amanyisigwa ang'wɨ naɨ amʉpilima mpande yɨhi, wɨkimɨka, wɨkasʉka mʉ kɨsalɨ. Mʉdaʉao Paʉlo nʉ Balinaba ɨkalongola kʉ Delibe.<verse eid="ACT 14:20" /></para>
  <para style="s">Paʉlo nʉ Balinaba akʉtulya kʉ Antiokia akʉ Silia</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21" />Sʉnga a Paʉlo nʉ Balinaba naɨakondya kʉtanantya Nkani Nza mʉ kɨsalɨ ka Delibe antʉ ɨdʉ ɨkamʉhʉɨɨla ʉ Yesʉ. Sʉnga ɨkatulya kʉkɨɨla isalɨ niya Lisitila nʉ kʉ Ikonio nʉ kʉ Antiokia namʉ Pisidia. <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />Ingɨ aze akomya nkolo ɨamanyisigwa aisalɨ niyanso asage mʉhʉɨɨli ang'wa Yesʉ azeahʉgʉla kɨna, “Antʉ akʉaja nɨze kʉkɨlɨ kingɨla mʉ ʉtemi wang'wi Itunda.” <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />Naɨ akondya kʉhola atongeeli mʉ ahʉɨɨli ang'wa Yesʉ ɨhi, ɨkagwalya nʉ kʉ lompa Itunda waasʉnje.<verse eid="ACT 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 14:24" />Naɨ akondya kʉtanantya ɨkakɨɨla kʉ kɨsalɨ ka Pisidia ɨkapika kʉ Pampilia. <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />Naɨ akondya kʉtanantya lʉkani lang'wi Itunda kʉ Pelige ɨkahulumʉka kʉ Atalia. <verse eid="ACT 14:25" /><verse number="26" style="v" sid="ACT 14:26" />Kʉpumɨɨla kʉng'wanso ɨkanankɨla meli ɨkatulya kʉ Antiokia akʉ Silia, kʉng'wanso kʉko pa kwadya ahʉɨɨli ang'wa Yesʉ naɨ alompeewe ʉkende wang'wi Itunda kʉnsoko a mʉlɨmo naɨ akondanɨɨlya.<verse eid="ACT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 14:27" />Naɨapika kʉ Atiokia ɨkaitanga ɨahʉɨɨli ang'wa Yesʉ, ɨkaaganʉɨla makani ɨhi Itunda nʉatendee antʉ nɨshanga Ayahudi amʉhʉɨɨli Yesʉ Kilisito. <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />Paʉlo nʉ Balinaba ɨkishiɨ kʉng'wanso palʉng'wɨ nɨ ahʉɨɨli ang'wa Yesʉ mahikʉ ɨdʉ.<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="s">Itʉmi nɨanyampala akʉtankana kʉ Yelusalemu</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />Antʉ ang'wɨ ɨkapika kʉ Antiokia kʉpuma kʉ Yʉdea, nawo ɨkatula amanyisa antʉ nɨshanga Ayahudi nɨamʉhʉɨɨe ʉ Yesʉ kɨna, “Anga mʉhite kʉtwalwa kɨdamu anga ntendo naɨʉlagɨɨye ʉ Musa, shanga mʉkʉhuma kʉgunɨka.” <verse eid="ACT 15:1" /><verse number="2" style="v" sid="ACT 15:2" />Ikani nɨlanso lɨkasasha a Paʉlo nʉ Balinaba ikʉngʉme nɨantʉ, itɨ gwa Paʉlo nʉ Balinaba ɨkaholwa palʉng'wɨ nɨ antʉ ang'wi nɨahʉɨɨe ʉ Yesʉ nɨa kʉ Antiokia alongole kʉ Yelusalemu ahume kitambʉlya ikani ɨlɨ nɨ itʉmi nɨ anyampala.<verse eid="ACT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 15:3" />Itɨ gwa ɨkatindɨkɨɨligwa nɨ ahʉɨɨli ang'wa Yesʉ, mʉnzɨla ɨkakɨɨla kʉ Poiniki nʉkʉ Samalia ɨkaaganʉɨla ɨanyaɨngʉ naɨapɨlʉka nʉ kʉmʉtyata Itunda. Mpola izi yɨkaleta ʉlowa ʉkʉlʉ kʉ antʉ ɨhi. <verse eid="ACT 15:3" /><verse number="4" style="v" sid="ACT 15:4" />Paʉlo nʉ Balinaba naɨapika kʉ Yelusalemu, ɨkasɨngɨɨligwa nɨ ahʉɨɨli ang'wa Yesʉ nɨ itʉmi nɨ anyampala, papo ʉ Paʉlo nʉ Balinaba ɨkaaganʉɨla maintʉ ɨhi Itunda nʉtendile kʉkɨɨla enso. <verse eid="ACT 15:4" /><verse number="5" style="v" sid="ACT 15:5" />Papo antʉ ang'wɨ nɨahʉɨɨe ʉhʉɨɨli nʉwa Apalisayo ɨkimɨka nʉkʉlʉnga, “Antʉ awa shanga Ayahudi aɨatakɨwe kʉtalwa kʉ kɨdamu nʉkʉmanyisigwa kʉkela intendo yang'wa Musa.”<verse eid="ACT 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6" />Itʉmi nɨ atongeli ɨkatankania ahume kʉkoeelya ikani ɨlɨ. <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" />Naɨ akondya kʉkoeelya, Petelo naɨ witangwa Simoni wɨkimɨka wɨkalʉnga, “Anyandʉgʉ ane, mʉlɨngile kɨna mʉ mahikʉ a ng'wandyo Itunda aɨʉnihoile ʉnene mʉng'wanyu ntanantye Nkani Nza kʉ antʉ nɨshanga Ayahudi ahume kija nʉ kʉihʉɨɨla. <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" />Itunda, nʉlɨngile ɨnkolo niya antʉ, wɨkalagɨɨla kɨna ʉagombile antʉ nɨshanga Ayahudi apo naɨʉmʉpee ʉ Ng'wahʉ Ng'welʉ anga naɨʉkʉpee ʉsese. <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />Shanga aɨʉkʉtemanʉe ʉsese nɨenso, Itunda aɨʉalekee mɨlandʉao kʉnsoko aɨamʉhʉɨɨe ʉ Yesʉ. <verse eid="ACT 15:9" /><verse number="10" style="v" sid="ACT 15:10" />Itungo ɨlɨ gwa, nɨkɨ mʉkʉhiya kʉmikʉngʉmya Itunda kʉakensha mpɨnda ahʉɨɨli ang'wa Yesʉ nɨ agʉkʉ anyu, nʉsese shanga aɨkʉhumile kʉkenka? <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />Ingɨ Ʉsese kʉhʉɨɨe kɨna kɨkomolwa kʉkɨɨla ʉkende wang'wi Isekʉlʉ Yesʉ Kilisito, anga enso nɨɨkomolwa.”<verse eid="ACT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12" />Antʉ ɨhi ɨkakilaja ihɨtwɨ, ɨkaategeelya a Balinaba nʉ Paʉlo naɨakʉganʉla kɨna Itunda aɨʉatumɨe ʉlɨ kitʉma ilɨngasɨɨlyo nɨ mɨʉkʉɨlwa kʉ antʉ nɨshanga Ayahudi. <verse eid="ACT 15:12" /><verse number="13" style="v" sid="ACT 15:13" />Naɨ akondya kʉtambʉla, Yakobo wɨkalʉnga, “Anyandʉgʉ, sɨntegeelyi. <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />Simoni wakʉganʉɨe Itunda pang'wandyo naɨ ʉtendile kʉ antʉ nɨshanga Ayahudi wɨkahola antʉ ang'wɨao atule antʉ akwe. <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />Nkani izi yɨhanga anga nkani niya amanga, anga Ʉandikwa nʉ Welu nʉʉandɨkilwe,<verse eid="ACT 15:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ACT 15:16" />‘Anga akɨla makani aya ʉnene kʉtulya,</para>
  <para style="q" vid="ACT 15:16">nʉ kʉmɨzenga hangɨ nyʉmba ang'wa Daudi nɨgwɨe.</para>
  <para style="q" vid="ACT 15:16">Kʉzenga makumʉʉlʉ akwe</para>
  <para style="q" vid="ACT 15:16">nʉ kimɨsha hangɨ.<verse eid="ACT 15:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ACT 15:17" />papo antʉ ang'wɨ ɨhi ahume kʉmʉsʉkɨla Isekʉlʉ,</para>
  <para style="q" vid="ACT 15:17">ga ni antʉ nɨshanga Ayahudi ɨhi nɨitangwaa kʉ lina lane,<verse eid="ACT 15:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ACT 15:18" />Itɨʉʉ ntambʉe ʉnene nɨ ni Isekʉlʉ nɨntendile ikani ɨlɨ lɨkumʉke kʉpuma ɨkalɨ.”’<verse eid="ACT 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19" />“Kʉlʉlo Yakobo aɨʉlongolekile kʉlʉnga, aya ingɨ masɨgo ane, kʉleke kʉaja antʉ nɨshanga Ayahudi nɨakʉmʉhʉɨɨla Itunda. <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />Ingɨ kʉataɨle lʉkani kɨna aleke kʉlya maintʉ napumigwe ipolyo kʉ itunda nɨ adʉdʉ, atemanʉke nʉ ʉgoolyi, aleke kʉlya nyama nɨyigiigwe kʉlɨgwa ang'wi kʉng'wa ɨsakami. <verse eid="ACT 15:20" /><verse number="21" style="v" sid="ACT 15:21" />Kʉnsoko kʉpuma ɨkalɨ malagɨɨlyo ang'wa Musa yitanantigwa mʉisalɨ yɨhi nʉ kʉsong'wa mʉnyʉmba niya kʉtankanɨla Ayahudi mahikʉ ɨhi nakʉsupya Ayahudi.”<verse eid="ACT 15:21" /></para>
  <para style="s">Balʉa kʉ antʉ nɨshanga Ayahudi nɨamʉhʉɨɨe ʉ Yesʉ</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />Itʉmi nɨ anyampala palʉng'wɨ nɨ ahʉɨɨli ang'wa Yesʉ ɨhi, ɨkalamʉla kʉahola antʉ ang'wɨ nʉkʉalagɨɨlya kʉ Antiokia ɨze ɨpalʉng'wɨ nʉ Paʉlo nʉ Balinaba. Ɨkahola antʉ abɨɨlɨ a Yʉda nʉitangwa Balisaba palʉng'wɨ nʉ Sila, antʉ abɨɨlɨ nɨɨza atongeeli mʉ anyandʉgʉ, <verse eid="ACT 15:22" /><verse number="23" style="v" sid="ACT 15:23" />sʉnga ɨkaapa balʉa nɨlɨandɨkilwe nkani izi.</para>
  <para style="pi" vid="ACT 15:23">Ʉsese Itʉmi nɨ anyampala, anyandʉgʉ anyu, kʉʉmʉlamʉsha anyandʉgʉ nɨ mɨantʉ nɨshanga Ayahudi nɨmʉhʉɨɨe nɨmʉkolɨ kʉ kɨsalɨ ka Antiokia nʉ kʉ mahɨɨ a Silia nʉ kʉ Kilikia. <verse eid="ACT 15:23" /><verse number="24" style="v" sid="ACT 15:24" />Kijaa kɨna akolɨ antʉ ang'wɨ azaa kʉng'wanso apembeeye kʉng'witʉ akʉmʉnyoma nʉkʉmaja mʉ masɨgo anyu ʉsese nɨshanga kʉalagɨɨye. <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />Itɨ gwa ʉsese kɨhi kʉnʉ kigombya kʉahola antʉ ang'wɨ nʉ kʉalagɨɨlya kʉng'wanyu palʉng'wɨ nɨ ahʉmbaɨitʉ a Balinaba nʉ Paʉlo, <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />nɨihʉiye kʉsha kʉnsoko ang'wi Isekʉlʉ witʉ Yesʉ Kilisito. <verse eid="ACT 15:26" /><verse number="27" style="v" sid="ACT 15:27" />Kʉlʉlo kʉʉalagɨɨlya kʉng'wanyu a Yʉda nʉ Sila, enso akʉmʉganʉɨla makani aya nɨkʉʉmʉandɨkɨla. <verse eid="ACT 15:27" /><verse number="28" style="v" sid="ACT 15:28" />Itɨ gwa Ng'wahʉ Ng'welʉ nʉ sese kʉleke kʉmʉkensha makani nɨmakaku kʉkɨla aya natakɨwe, <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />kɨna mʉtemanʉke nɨ maintʉ ɨhi nakʉpumigwa masongelyo kʉ adʉdʉ nʉ kʉng'wa sakami ni nyama niya ikalɨ nɨyishɨɨe, hangɨ mʉtemanʉke nʉ ʉgoolya. Anga mʉtemanʉke nɨ makani aya mʉkʉtula matendaa iza. Mʉlamʉ.”<verse eid="ACT 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />Itɨ gwa Yʉda nʉ Sila ɨkalagwa, ɨkahulumʉka kʉlongola kʉ Antiokia, naɨ akondya kʉilingɨɨla palʉng'wɨ ɨ ahʉɨɨli ang'wa Yesʉ, ɨkaapa balʉa nɨlanso. <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />Nawo ɨahʉɨɨli ang'wa Yesʉ naɨ akondya kʉsoma balʉa nɨlanso, ɨkiloa nangaluu kʉ nkani niya kʉakomya nkolo. <verse eid="ACT 15:31" /><verse number="32" style="v" sid="ACT 15:32" />Yʉda nʉ Sila, antʉ awa nɨɨza amanga ang'wi Itunda ɨkatambʉla nkani yidʉ niya kʉakomya nkolo nʉ kʉazenga mʉ ʉhʉɨɨli anyandʉgʉ awa nɨ amʉhʉɨɨe ʉ Yesʉ. <verse eid="ACT 15:32" /><verse number="33" style="v" sid="ACT 15:33" />Naɨishiɨ mahikʉ mashenyʉ kʉ Antiokia, ɨkalagwa nɨ anyandʉgʉ kʉ matiliga atulye kʉ antʉ awo naɨaalagɨye. <verse eid="ACT 15:33" /><verse number="34" style="v" sid="ACT 15:34" />Ingɨ ʉ Sila wɨkalongoleka kʉsaga kʉko.<note caller="+" style="f"><char style="fr" closed="false">15:34 </char><char style="ft" closed="false">Mbugulu ningɨza ngila ʉlʉkɨɨlɨ ʉlʉ</char></note><verse eid="ACT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 15:35" />Ingɨ a Paʉlo nʉ Balinaba nɨanso ɨkasaga kʉ Antiokia, enso palʉng'wɨ ni anyandʉgʉ aʉya ɨdʉ aikʉmanyisa nʉ kʉtanantya Nkani Nza niyang'wi Isekʉlʉ.<verse eid="ACT 15:35" /></para>
  <para style="s">Paʉlo nʉ Balinaba akʉtemanʉka</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />Naɨyakɨla mahikʉ kɨtʉʉnga, Paʉlo wɨkamʉɨla ʉ Balinaba, “Kʉtulye kende agendeela anyandʉgʉ mʉisalɨ yɨhi naɨkʉtanantilye ʉlʉkani lang'wi Isekʉlʉ kʉaone alongolekile ʉlɨ.” <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />Balinaba wɨkahiya amʉhole nʉ Yohana nʉitangwa Maliko akʉɨlanie. <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" />Ingɨ ʉ Paʉlo wɨkaona shanga iza kʉnsoko ʉ Yohana aɨwagemile kʉaleka naɨakolɨ ʉko kʉ Pampilia, wɨkahita kʉlongoleka kitʉmania mɨlɨmo. <verse eid="ACT 15:38" /><verse number="39" style="v" sid="ACT 15:39" />Wɨkigela wikʉngʉmi kʉ a Paʉlo nʉ Balinaba ki ikani ɨlɨ, itigwa ɨkatemanʉka. Balinaba wɨkamʉhola ʉ Maliko ɨkakɨɨla mʉ lʉzɨ kʉlongola kʉ Kipilo. <verse eid="ACT 15:39" /><verse number="40" style="v" sid="ACT 15:40" />Paʉlo nʉanso wɨkamʉhola Sila, ahʉɨɨli ang'wa Yesʉ naɨakondya kʉlompeelwa kʉ ʉkende wang'wi Isekʉlʉ sʉnga ɨkahega. <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />Ɨkakɨɨla kʉ Silia nʉ kʉ Kilikia, wazeakomya nkolo ahʉɨɨli ang'wa Yesʉ nɨa kʉng'wanso.<verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="s">Timoteo ʉkʉkʉɨla nɨa Paʉlo nʉ Sila</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />Sʉnga Paʉlo wɨkapika kʉ isalɨ niya kʉ Delibe nɨ Lisitila, kʉng'wanso aɨʉkolɨ mʉmanyisigwa lina lakwe Timoteo, nyinya wakwe ingɨ Mʉyahudi nʉhʉɨɨe ʉ Yesʉ Kilisito, tata wakweaɨ Mʉyunani. <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />Timoteo aɨwalʉkumo lʉza kʉahʉɨɨli ang'wa Yesʉ nɨakʉ Lisitila nʉ kʉ Ikonio <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />Paʉlo wɨkahiya Timoteo wakʉɨlanie nʉyo, kʉlʉlo wɨkamʉtala kʉ kɨdamu hanza kʉnsoko Ayahudi naɨishiɨ nkɨka nanso ɨhi aɨalɨngɨle kɨna ihe wang'wa Timoteo ingɨ Mʉyunani. <verse eid="ACT 16:3" /><verse number="4" style="v" sid="ACT 16:4" />Naɨ akʉgendeela kɨsalɨ nɨ kɨsalɨ, ɨkatula apa ɨantʉ malago ayo naɨ apumigwe nɨ anyampala ʉko kʉ Yelusalemu,kʉnʉ azeaɨla amaambe. <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />Itɨ gwa antʉ naɨamʉhʉɨɨe Yesʉ ɨkatula akamatɨku mʉ ʉhʉɨɨli nʉ kongeeleka kizʉla mahikʉ ɨhi.<verse eid="ACT 16:5" /></para>
  <para style="s">Paʉlo naɨʉkolɨ kʉ Tiloa wɨkahola mʉloto</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />Paʉlo nɨaʉya ɨkatunga mʉhɨnzo nkɨka niya Piligia nɨ Galatia, kʉnsoko Ng'wahʉ Ng'welʉ aɨʉagiiye aleke kʉtanantya ʉko kʉ Asia. <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />Naɨapika mʉ mɨmbɨ akʉ Misia, ɨkagema kingɨla mʉ Bitinia ingɨ Ng'wahʉ wang'wa Yesʉ wɨkaahitɨlya. <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />Kʉlʉlo ɨkakɨlɨnkania kʉ Misia ɨkapika kʉ Tiloa. <verse eid="ACT 16:8" /><verse number="9" style="v" sid="ACT 16:9" />Ʉtikʉ nʉwanso Paʉlo wɨkahola mʉloto, wɨkamʉona mʉntʉ nʉwa Makedonia wɨkimɨka wɨkamʉlompa, “Tambʉka ʉze ʉkʉaɨɨlye kʉnʉ kʉ Makedonia.” <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />Paʉlo naɨwakondya kʉʉhola mʉloto, papo kɨkihamba kʉlongola kʉ Makedonia, ɨzekʉhʉɨɨe kɨna Itunda ʉkitangile kʉtanantye Nkani Nza kʉng'wanso.<verse eid="ACT 16:10" /></para>
  <para style="s">Lidia ʉkʉgunɨka</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />Kɨkahega kʉ Tiloa kɨkakɨlɨnkania kʉ Samotilake kʉkɨɨla mʉlʉzɨ kaze kʉnankɨe ibɨnɨ ni kʉlʉ, mʉdaʉao kɨkapika kʉ kɨsalɨ ka Neapoli. <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />Kɨkahega kʉng'wanso kɨkalongola kʉ Pilipi, kɨsalɨ nɨkɨkʉlʉ nɨka Makedonia nɨ kɨtemilwe nɨ a Lumi, kɨkikiɨ mʉ kɨsalɨ nɨkanso mahikʉ makeehʉ. <verse eid="ACT 16:12" /><verse number="13" style="v" sid="ACT 16:13" />Lʉhikʉ nʉla kʉsupya Ayahudi kɨkalongola kʉnzi a mʉmpita nʉwa kɨsalɨ mpelo amongo, nkɨka naɨkʉsɨgile kɨna kʉʉlija lyoma nɨla malompi. Kɨkikiɨ pihɨ, kitambʉlya nɨasʉngʉ naɨ ilʉndile kʉng'wanso. <verse eid="ACT 16:13" /><verse number="14" style="v" sid="ACT 16:14" />Ʉng'wɨao mʉ asʉngʉ awa naɨ akʉtegeeye, lina lakwe Lidia, mʉsʉlʉja nʉwa ngʉo azambalaʉ, naʉgʉli ʉkʉlʉ, mʉnya kʉ Tiatila naɨ wɨmʉkʉlya Itunda. Isekʉlʉ wɨkamʉtenda ʉ Lidia wahʉɨɨle lʉkani naɨʉkʉtambʉla ʉ Paʉlo. <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />Itɨ gwa Lidia naɨwakondya kʉbadisigwa palʉng'wɨ nɨantʉ amitolakwe, wɨkakʉsɨngɨɨlya mitolakwe wazelʉnga, “Anga ɨze tai maona kɨna ʉnene namʉhʉɨɨla Isekʉlʉ, kɨlanyi mikiɨ mitolane.” Nʉyo wɨkakinena.<verse eid="ACT 16:15" /></para>
  <para style="s">Paʉlo nʉ Sila akʉtungwa mʉ kadulumu</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16" />Lʉhikʉ lʉng'wɨ naɨkʉlongoe kʉ mʉkʉlya Itunda pakipoelya, kɨkatankana nʉ mʉnanso ʉng'wɨ mʉtʉʉng'wa ʉkete ahɨng'wɨ aʉlagʉli, aɨwɨatambʉɨla ɨantʉ makaniao napembilye. Kʉtenda itɨ aɨwɨagolɨpya ɨagolɨ akwe. <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />Mʉnanso nʉwanso wɨkamʉtyata Paʉlo nʉsese, wɨkitʉnta nʉkʉlʉnga “Antʉ awa ingɨ anyamɨlɨmo ang'wi Itunda nʉ Mʉkʉlʉ. Azile kʉmʉtanantɨlya ʉnyenye nkani niya ʉgunɨligwa.” <verse eid="ACT 16:17" /><verse number="18" style="v" sid="ACT 16:18" />Wɨkalongoleka kitʉma itɨ mahikʉ ɨhi. Lʉhikʉ lʉng'wɨ Paʉlo wɨkataka, wɨkamʉpɨlʉkɨla nʉkʉmʉkenela hɨng'wɨ nʉwanso, “Kʉʉlagɨɨlya kʉlina lang'wa Yesʉ Kilisito, puma mʉ mʉnanso ʉyʉ.” Papo paapo hɨng'wɨ nʉanso wɨkapuma.<verse eid="ACT 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19" />Agolɨ a mʉnanso ʉyʉ naɨaona isanio lao nɨla kʉpantɨkɨla nsao lahila, ɨkaamba a Paʉlo nʉ Sila ɨkaakweha nʉkʉatala mʉʉgalagalo kʉ atongeeli naɨ akolɨ. <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />Ɨkaaitʉntɨɨla ɨ atongeeli akɨsalɨ azelʉnga. “Antʉ awa ingɨ Ayahudi aɨnaleta dome mʉ kɨsalɨ kitʉ. <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />Akʉmanyisa ntendo nʉsese Alumi shanga kʉtakɨwe kʉigomba ang'wɨ kʉityata.” <verse eid="ACT 16:21" /><verse number="22" style="v" sid="ACT 16:22" />Iumbɨ laantʉ ɨkihangʉɨla ɨka akʉa a Paʉlo nʉ Sila.</para>
  <para style="p" vid="ACT 16:22">Papo alamʉli akɨsalɨ ɨkalagɨɨlya atugʉlwe ngʉo, atang'we nkootya. <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />Naɨ akʉɨkɨgwa, ɨkingɨligwa mʉkadulumu, mɨmɨɨli wɨkalagɨɨligwa waakendegeele aleke kʉtigana. <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />Kʉ ʉlagɨɨligwa nʉwanso mɨmɨɨli wɨkaaɨka kʉnindo akadulumu, wɨkaatungɨɨla mɨgʉlʉao mʉ magogo nɨ malito.<verse eid="ACT 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25" />Naɨyahumbeela ʉtikʉ wigɨngu, Paʉlo nʉ Sila aɨakʉlompa nʉkɨmba mɨmbo akʉmʉkʉlya Itunda, kʉnʉ atungwa aʉya ɨkaze aategeye. <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />Pumpulugu, wɨkapumɨla mʉtentemo ʉkʉlʉ wihɨɨ naɨ ʉhingɨsilye kɨtako kanyʉmba akadulumu. Itungo ʉdu ndʉjɨ yɨhi niyakadulumu yɨkalugʉka, mɨnyololo naɨ atungɨwe ɨatungwa ɨhi ɨkatɨnɨka. <verse eid="ACT 16:26" /><verse number="27" style="v" sid="ACT 16:27" />Mɨmɨɨli nʉwa kadulumu naɨwapitya nʉkʉona ndʉjɨ nɨyakadulumu ilʉgʉkile, wɨkasɨga kɨna atungwa ɨhi atigana. Nɨ itɨ wɨkahopola nyalahanda akwe wɨkahiya kibʉlaga. <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />Ingɨ Paʉlo wɨkamitʉntɨɨla, wɨkalʉnga, “Leka kibʉlaga, ʉsese kɨhi kʉkolɨ papa!”<verse eid="ACT 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29" />Mɨmɨɨli nʉmʉkʉlʉ nʉwa kadulumu naɨ wigule itɨ,wɨkamitanga mʉntʉ walete lʉmʉlɨ, wɨkamanka wɨkingɨla mʉnindo akadulumu, wɨkatugama pa mɨgʉlʉ a Paʉlo nʉ Sila kʉnʉ wazekagata kʉwoa. <verse eid="ACT 16:29" /><verse number="30" style="v" sid="ACT 16:30" />Sʉnga wɨka apumya kʉnzi, wɨka akolya. “Akʉlʉ ane, ntendeʉlɨ nihume kʉgunɨka?”<verse eid="ACT 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31" />Paʉlo nʉ Sila ɨkamʉsʉkɨɨlya, “Anga ʉmʉhʉɨɨle Isekʉlʉ Yesʉ ʉewe palʉng'wɨ nɨantʉ ɨhi nɨamitolako papo mʉkʉgunɨka.” <verse eid="ACT 16:31" /><verse number="32" style="v" sid="ACT 16:32" />Papo gwa ɨkamʉtanantɨlya lʉkani lang'wi Isekʉlʉ ng'wenso palʉng'wɨ nawa ɨhi nɨamitolakwe. <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />Itungo lɨlo lɨɨlo nɨla utikʉ mɨmɨɨli nʉanso wɨkaatendeela iza wɨkaogelya ngʉma yao, sʉnga papo paapo wɨkabadisigwa ng'wenso palʉng'wɨ nɨantʉ ɨhi nɨamitolakwe. <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />Sʉnga wɨkaatala Paʉlo nʉ Sila kitolakwe. Wɨkaapa indya. Ng'wenso palʉng'wɨ nɨantʉ ɨhi nɨamitolakwe ɨkiloa kʉnsoko aɨamʉhʉɨɨla Itunda.<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />Naɨwela kɨdaʉdaʉ alamʉli ɨkalagɨɨlya aopisaao nɨakʉlʉ kʉ mʉkʉlʉ nʉwa akadulumu azelʉnga, “Alugʉɨli antʉ awa alongole.”<verse eid="ACT 16:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 16:36" />Mʉkʉlʉ nʉwa kadulumu wɨkamʉɨla ʉ Paʉlo “Alamʉli alagɨɨye kɨna kʉmʉlekele, kʉlʉlo pumi mʉlongole.”<verse eid="ACT 16:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37" />Ingɨ ʉ Paʉlo wɨkasʉkɨɨlya, “Age ntʉni? Akʉkʉile ntongeela yaantʉ, kʉnʉ shanga akʉpɨsɨɨye, nawo akʉlugaɨla mʉkadulumu nʉsese kɨ anya kʉ Lumi. Itungo ɨlɨ akipihɨɨlya ʉlɨ kʉʉpumya mʉkadulumu. Shangaʉʉ. Nɨaze ɨenso akʉpumye mʉnʉ mʉkadulumu.”<verse eid="ACT 16:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38" />Akʉlʉ a aopisa awa ɨkatulya kʉ alamʉli nʉ kʉaɨla inkani izi, naɨ alɨnga kɨna a Paʉlo nʉ Sila antʉ akʉ Lumi, ikogopa ikʉlʉ. <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />Kʉlʉlo ɨkapembya ɨka alompa itʉnʉ, ɨka apumya mʉ kadulumu, ɨkaalompa ahege mʉ kɨsalɨ nɨkanso. <verse eid="ACT 16:39" /><verse number="40" style="v" sid="ACT 16:40" />Paʉlo nʉ Sila naɨapuma mʉkadulumu ɨkalongola kito lang'wa Lidia. Kʉng'wanso ɨkatankana nɨanyandʉgʉ naɨahʉɨɨli ang'wa Yesʉ, ɨkaakomya nkolo, sʉnga ɨkahega.<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="s">Minyomo nʉwa kʉ Tesalonike</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />Paʉlo nʉ Sila ɨkatunga mʉhɨnzo kʉkɨɨla kʉ isalɨ niya kʉ Ampipoli nɨ Apolonia ɨkapika kʉ Tesalonike, kʉng'wanso aɨkolɨ nyʉmba akʉtankanɨla Ayahudi. <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />Paʉlo anga naɨwizɨɨe wɨkingɨla mʉnyʉmba akʉtankanɨla Ayahudi. Wazikolya nɨenso kʉpuma mʉ Ʉandɨkwa kʉ mahikʉ ataatʉ nakʉsupya ɨ Ayahudi, <verse eid="ACT 17:2" /><verse number="3" style="v" sid="ACT 17:3" />wazeaɨla nʉ kʉakomangɨɨla kɨna itakɨwe ʉ Kilisito wagigwe nʉ kiʉka, wɨkalʉnga, “Kilisito nɨkʉmʉtanatɨlya nkani yakwe, ingɨ Yesʉ.” <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />Ayahudi ang'wɨ ɨkahʉɨɨla, ɨkihangʉɨla nɨ a Paʉlo nʉ Sila, aze akolɨ Ayunani ɨdʉ naɨ amʉhʉɨɨe Itunda nɨ asʉngʉ nɨasanigwe mihɨɨ nanso.<verse eid="ACT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5" />Ingɨ Ayahudi nɨshanga aiamʉhʉɨɨe Itunda ɨkatula akete wɨlu, ɨkalagɨɨlya antʉ nɨ abɨ kʉpuma mʉ ʉgalagalo, ɨkilingɨɨla milʉmdo waantʉ, ɨkasasha wilei mʉ kɨsalɨ kɨhi. Ɨkadagɨɨlya nyʉmba ang'wa Yasoni azeaduma Paʉlo nʉ Sila aalete kʉnzɨ pa milʉmdo waantʉ. <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />Ingɨ naɨ aaʉlya a Paʉlo nʉ Sila ɨkaamba a Yasoni ni anyandʉgʉ aʉya ɨkaakweha nʉ kʉatala kʉakʉlʉ akɨsalɨ, ɨkitʉnta nʉkʉlʉnga, “Antʉ awa akenda apɨʉla ɨantʉ, itungo ɨlɨ akolɨ mʉnʉ mʉkisalɨ, <verse eid="ACT 17:6" /><verse number="7" style="v" sid="ACT 17:7" />ingɨ Yasoni ʉasingɨɨye mitolakwe. Awa ɨhi akitʉma nsuta nɨlagɨɨlyo lang'wa Kaisari, akʉlʉnga age ʉkolɨ mʉtemi mʉngɨɨza witangwa Yesʉ.” <verse eid="ACT 17:7" /><verse number="8" style="v" sid="ACT 17:8" />Akʉlʉ akɨsalɨ naɨija makani aya, milʉmdo ʉwʉ nɨakʉlʉ akɨsalɨ minyomo wɨkakʉla. <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />Nɨenso naɨ akondya kʉadaya mpia Yasoni nɨ aʉya ɨkaaleka alongole.<verse eid="ACT 17:9" /></para>
  <para style="s">Paʉlo nʉ Sila kʉ Beloya</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />Ʉtikʉ wʉwo, antʉ naɨamʉhʉɨɨla ʉ Yesʉ ɨkaaɨla a Paʉlo nʉ Sila alongole kʉ Beloya. Naɨapika kʉng'wanso, ɨkalongola mʉnyʉmba akʉtankanɨla Ayahudi. <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />Ayahudi awa nɨa kʉ Beloya aɨakende ikɨlo kʉkɨla awa nɨa kʉ Tesalonike, kʉnsoko asɨngɨɨye ʉlʉkani lang'wi Isekʉlʉ kʉnsʉla nkʉlʉ, mahikʉ ɨhi aɨɨkendegeela Ʉandɨkwa wang'wi Itunda, nʉ kʉona kɨna a Paʉlo nʉ Sila ɨtambʉla nkani yatai. <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />Ayahudi ɨdʉ ɨkahʉɨɨla palʉng'wɨ nɨ asʉngʉ nɨ itʉnja nɨa Kɨyunani nɨasanigwe. <verse eid="ACT 17:12" /><verse number="13" style="v" sid="ACT 17:13" />Ingɨ Ayahudi nɨa kʉ Tesalonike naɨija kɨna ʉ Paʉlo ʉkʉtanantya lʉkani lang'wi Itunda kʉ Beloya, ɨkaatyata nʉkʉng'wanso ga, ɨkatula anyoma nʉ kʉakinyɨla ɨantʉ. <verse eid="ACT 17:13" /><verse number="14" style="v" sid="ACT 17:14" />Papo antʉ naɨamʉhʉɨɨe Yesʉ awa nɨ a kʉ Beloya ɨkakaya kʉmʉtindɨkɨɨlya ʉ Paʉlo walongole kʉ mpwani, ingɨ a Sila nʉ Timoteo ɨkasiga kʉ Beloya. <verse eid="ACT 17:14" /><verse number="15" style="v" sid="ACT 17:15" />Antʉ awa naɨ amʉhʉɨɨe ʉ Yesʉ naɨamʉtindɨkɨɨye ʉ Paʉlo ɨkalongolania kʉ Atene, sʉnga ɨkatemanɨka nʉ Paʉlo ɨkatulya kʉ Beloya aze alagɨigwe kʉ a Sila nʉ Timoteo kɨna akaye kʉmʉtyata.<verse eid="ACT 17:15" /></para>
  <para style="s">Paʉlo kʉ kɨsalɨ ka Atene</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />Matungo ʉ Paʉlo naɨ ʉalindɨie a Sila nʉ Timoteo kʉng'wanso kʉ Atene, wɨkaona itɨ adʉdʉ a alʉngʉ naɨizʉe mʉ kɨsalɨ nɨkanso wɨkabɨpɨlwa nangalu mʉnkolo akwe. <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />Kʉlʉlo wɨkalongola kitambʉlya mʉnyʉmba nakʉtankanɨla Ayahudi, nɨ itɨga mahikʉ ɨhi ɨkitambʉlya mʉʉgalagalo nɨ Ayahudi nɨ antʉ aʉya nɨɨmʉkʉlya Itunda, hangɨ aɨitambʉlya nʉ mʉntʉ wɨhi nʉkigela. <verse eid="ACT 17:17" /><verse number="18" style="v" sid="ACT 17:18" />Sʉnga antʉ ang'wɨ naɨ atyatile ʉmanyisigwa nʉwa Aepikulo nɨ a Asitoiko nɨ amanyi ikʉlʉ ɨkikʉngʉma nʉ Paʉlo. Ang'wɨao ɨkalʉnga, “Itɨɨ, ʉkɨtambʉtambʉ ʉyʉ ʉkʉhiya kʉlʉnga ʉlɨ?”</para>
  <para style="p" vid="ACT 17:18">Aʉya ɨkalʉnga, “Ʉtuile anga ʉkʉtanantya nkani niya itunda akɨzɨɨla.” Aɨatambʉe itɨ kʉnsoko ʉ Paʉlo aɨʉkʉtanantya Nkani Nza ni yang'wa Yesʉ nʉ wiʉki nʉwa ashi. <verse eid="ACT 17:18" /><verse number="19" style="v" sid="ACT 17:19" />Kʉitɨ gwa ɨkamʉhola ʉ Paʉlo nʉkʉmʉleta mianza nɨlitangwa Aleopago, ɨkalʉnga, “Itɨɨ, kʉhumilene kʉlɨnga ʉmanyisi ʉwʉ nʉwa kɨgeni ʉkʉmanyisa ntʉni? <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />Ʉewe ʉkʉleta makani mageni, kʉtakile kʉlɨnga ʉng'waao ntʉni.” <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />Antʉ a kʉ Atene nɨageni aʉya ɨhi nɨishiɨ kʉng'wanso shanga aɨatʉmɨe matungoao kʉtenda kɨntʉ kɨhii, ingɨ kiganʉɨla nʉkʉtegeelya nkani niya kɨngeni.<verse eid="ACT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22" />Papo Paʉlo wɨkimɨka ntongeela ianza nɨlanso, wɨkalʉnga, “Ʉnyenye antʉ akʉ Atene. Naona kɨna ʉnyenye mɨakʉlya alʉngʉ anyu kʉ nzɨla yɨhi. <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />Naza kiʉmbaʉmba mʉ kɨsalɨ kanyu naona adʉdʉ mʉ matekeelo anyu ɨdʉ nakipoelya, kʉng'wanso nalɨona itekeelo lɨng'wi landɨkilwe, ‘Kʉng'wi itunda nɨshanga ʉmanyɨkile.’ Itunda ʉyʉ nɨmʉkʉmʉkʉlya kʉnʉ shanga mʉmʉmanyile, yʉyo ʉnene kʉmʉtanantya kʉng'waanyu. <verse eid="ACT 17:23" /><verse number="24" style="v" sid="ACT 17:24" />Itunda ʉyʉ, yʉyo nʉtundɨle ʉnkumbigʉlʉ naya ɨhi namoolɨ, nʉwanso ingɨ yʉyo Isekʉlʉ nʉ wigʉlʉ nihɨɨ, shanga wishiɨ mʉ Nyʉmba nɨzengilwe nɨ antʉ. <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />Hangɨ shanga witʉmɨlwa nɨ antʉ nɨitɨga shanga ʉloilwe kɨntʉ kɨhi kʉpuma kʉng'wao, kʉnsoko ng'wenso wɨapeza antʉ ʉpanga nɨ mɨhupo, ng'wenso wɨakoteelya antʉ intʉ yɨhi. <verse eid="ACT 17:25" /><verse number="26" style="v" sid="ACT 17:26" />Kʉpumɨɨla mʉ mʉntʉ ʉng'wɨ Itunda wɨkaʉmba antʉ ɨhi nʉ kʉahumya ishiɨ mihɨɨ ɨhi. Wɨkalamʉla nʉ kʉnonia matungo wɨkalamʉla antʉ nɨ kishiɨ. <verse eid="ACT 17:26" /><verse number="27" style="v" sid="ACT 17:27" />Itunda aɨʉtendile itɨ, ingɨ antʉ ɨhi amʉdʉme ng'wenso anga ize kʉambangɨlya, ahume kʉmʉpantɨka. Nɨitɨga Itunda shanga wɨkʉli nʉsese, <verse eid="ACT 17:27" /><verse number="28" style="v" sid="ACT 17:28" />anga mʉntʉ ʉng'wɨ nʉlʉngile,</para>
  <para style="q" vid="ACT 17:28">‘Mʉng'wakwe ʉsese kishiɨ, hangɨ kigenda nʉ kʉlongoleka kishiɨ.’</para>
  <para style="m" vid="ACT 17:28">Anga ɨmbi anyu nɨang'wɨ naɨ atambʉe.</para>
  <para style="q" vid="ACT 17:28">‘Ʉsese kɨhi kiana akwe.’<verse eid="ACT 17:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="ACT 17:29" />Itɨgwa ʉsese kɨana ang'wi Itunda, shanga kʉtakɨwe kʉmʉsigɨɨla Itunda wɨhangaa dʉdʉ nʉa zahabu ang'wɨ magwe a peza ang'wɨ nʉa magwe nakomangilwe nʉkʉʉgʉligwa kʉ ʉhʉgu nʉwa kɨ ʉntʉ. <verse eid="ACT 17:29" /><verse number="30" style="v" sid="ACT 17:30" />Pakalɨ antʉ nɨshanga amʉmanyile Itunda nʉwa tai. Itunda aɨʉtuile anga shanga ʉine, itungo ɨlɨ ʉkʉlagɨɨlya antʉ ɨhi nkɨka yɨhi ile itunʉ nʉ kʉmʉsʉkɨla, <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />kʉnsoko wakondɨlye kʉika lʉhikʉ nʉla kʉpɨsɨɨlya antʉ ɨhi mihɨɨ kʉtai kʉkʉɨɨla mʉntʉ ʉng'wɨ nʉmʉhoile. Itunda waakʉmʉie antʉ ɨhi ikani ɨlɨ kʉmiusha mʉntʉ ʉyʉ kʉpuma kʉ ashi.”<verse eid="ACT 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32" />Naɨija ʉ Paʉlo ʉkʉtambʉla nkani niya kiʉka kʉ ashi, nɨang'wɨ ɨkakenenteelya, ingɨ nɨang'wɨ ɨkalʉnga. “Kʉtakile kʉkije hangɨ ʉkʉtambʉla ikani ɨlɨ.” <verse eid="ACT 17:32" /><verse number="33" style="v" sid="ACT 17:33" />Itɨ gwa ʉ Paʉlo wɨkaaleka wɨkahega pakatɨ ianza. <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />Ingɨ antʉ ang'wɨ ɨkihangʉila nʉ Paʉlo ɨkamʉhʉɨɨla ang'wa Yesʉ, mʉantʉ nɨanso aɨakolɨ a Dionisio nʉ mʉnyianza nɨla Mʉleopago nʉ mʉsʉngʉ ʉng'wɨ nʉitangwa Damari nɨ antʉ aʉya ɨdʉ.<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="s">Paʉlo ʉkolɨ kʉ Kolinto</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />Naɨakɨla makani aya, Paʉlo wɨkahega kʉ Atene wɨkalongola kʉ Kolinto. <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />Kʉng'wanso kʉ Kolinto wɨkatankana nʉ Mʉyahudi ʉng'wɨ witangwa Akila, mʉnya kʉ Ponto, itungo ikupɨ aɨapikile nʉ mʉkimakwe Pilisila kʉpuma ihɨɨ kʉ Italia, kʉnsoko mʉtemi Kilaudio aɨʉlagɨɨye Ayahudi ɨhi ahege kʉ kɨsalɨ ka Lumi. Paʉlo wɨkalongola kʉaona itambʉlye, <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />itɨ gwa Paʉlo wɨkikiɨ palʉng'wɨ nɨenso kitʉmania mʉlɨmo, kʉnsoko ʉ Paʉlo aɨmʉtuma mahema anga ɨenso. <verse eid="ACT 18:3" /><verse number="4" style="v" sid="ACT 18:4" />Mahikʉ ɨhi aya nakʉsupya Ayahudi yɨhi Paʉlo aɨwitambʉlya nɨ Ayahudi nɨ Ayunani wazegema kʉapepeelya amʉhʉɨɨle ʉ Yesʉ.<verse eid="ACT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5" />Sila nʉ Timotheo naɨapika kʉpuma kʉ Makedonia, ɨkamʉhanga ʉ Paʉlo azewipumilye matungo ɨhi kʉtanantya, wazeatambʉɨla ɨtai ɨ Ayahudi kɨna Yesʉ yʉyo Kilisito. <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />Ayahudi naɨ amikʉngʉmya ʉ Paʉlo nʉ kʉmʉsensa, wɨkakununta lʉnkʉndɨ ngʉo akwe kʉahʉgʉlya kɨna watemanʉka nɨenso, wɨkaaɨla, “Anga mʉlimɨle mʉkʉona hapo! Ʉnene nɨmʉgila anga kinkwaatya, naʉkondya ʉmʉlɨmo wane. Kandɨɨlya ino nakaahanga antʉ nɨshanga Ayahudi.” <verse eid="ACT 18:6" /><verse number="7" style="v" sid="ACT 18:7" />Sʉnga wɨkahega mʉnyʉmba akʉtankanɨla Ayahudi, wɨkalongola mʉnyʉmba amʉntʉ ʉng'wɨ witangwa Tito Yusito, aɨwɨmʉkʉlya Itunda. Nyʉmba akwe aɨkɨsalɨ ni nyumba akʉtankanɨla Ayahudi. <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" />Mʉtongeeli nʉwa nyʉmba nanso nakʉtankanɨla Ayahudi, aɨwitangwa Kilisipo, mʉtongeeli ʉyʉ wɨkamʉhʉɨɨla Isekʉlʉ palʉng'wɨ niantʉ amitolakwe, Akolinto ɨdʉ naɨamʉtegeeye ʉ Paʉlo ɨkahʉɨɨla nʉkʉbadisigwa.<verse eid="ACT 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9" />Lʉhikʉ lʉng'wi ʉtikʉ Isekʉlʉ wɨkamʉtambʉlya ʉ Paʉlo mʉ mɨloto kɨna, “Leka kogopa, longoleka kʉtanantya Nkani Nza hangɨ leka kʉkatapa, <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" />kʉnsoko ʉnene nkolɨ palʉng'wɨ nʉewe. Kʉtilɨ anga mʉntʉ wɨhi nʉkʉʉkʉa wakʉlemaalye, kʉnsoko mʉkɨsalɨ ɨkɨ akolɨ antʉ ɨdʉ nɨɨkanihʉɨɨla.” <verse eid="ACT 18:10" /><verse number="11" style="v" sid="ACT 18:11" />Itɨ gwa ʉ Paʉlo wɨkikiɨ kʉng'wanso ng'waka ʉng'wɨ nɨ myeli nɨ myeli mʉtandatʉ, wazemanyisa lʉkani lang'wi Itunda kʉ antʉ ang'wɨ.<verse eid="ACT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />Itɨgwa Galio naɨ mʉtemi kʉ kɨsalɨ ka Akaya, Ayahudi ɨkamihangɨɨla ʉ Paʉlo amʉkʉe, ɨkamʉamba nʉ kʉmʉtala kianza. <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />Ɨkamʉsemela azelʉnga, “Mʉntʉ ʉyʉ ʉkʉapema antʉ amʉkʉlye Itunda nsuta nɨ malagɨɨlyo ang'wa Musa.”<verse eid="ACT 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14" />Papo ʉ Paʉlo naɨwalija lyoma nɨla kilongola, Galio wɨkaaɨla Ayahudi, “Anga ɨze ʉnyenye Ayahudi aza mʉkʉmʉsosha kʉ magazo makʉlʉ aza ntakɨwe ʉnene nʉmʉtegeelye. <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />Kʉnsoko wikʉngʉmi nʉwa nkani nɨ mina nɨ malagɨɨlyo anyu, ʉnyenye lamʉli kʉko. Ʉnene shanga kʉtula nɨmʉlamʉli mʉmakani aya.” <verse eid="ACT 18:15" /><verse number="16" style="v" sid="ACT 18:16" />Sʉnga Galio wɨkaazunsa apume mianza. <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />Papo gwa antʉ ɨhi ɨkamʉamba ʉ Sositene mʉtongeeli nʉwa nyʉmba akʉtankanɨla Ayahudi, ɨkamʉkʉa pantongeela ianza, ingɨ Galio shanga wɨkakela ikanɨ nɨlanso.<verse eid="ACT 18:17" /></para>
  <para style="s">Paʉlo ʉkʉtulya kʉ Antiokia a kʉ Silia</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />Paʉlo naɨwikiɨ kʉ Kolinto mahikʉ ɨdʉ. Sʉnga wɨkaalaga anyandʉgʉ awa naɨahʉɨɨla wɨkatunga mʉhɨnzo kʉkɨɨla nzɨla alʉzi wɨkalongola kʉ Silia waze wityatile nʉ Pilisila nʉ Akila. Naɨapika kʉ Kenkilea Paʉlo wɨkazula insingɨ yakwe anga naɨwilapie kʉnsoko aɨwakondya mʉlɨmo. <verse eid="ACT 18:18" /><verse number="19" style="v" sid="ACT 18:19" />Naɨapika kʉ Epeso, Paʉlo wɨkaaleka kʉko a Pilisila nʉ Akila, ingɨ nʉanso wɨkingɨla mʉ nyʉmba akʉtankanɨla Ayahudi wɨkatulitambʉlya nɨenso. <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />Antʉ ɨkamʉlompa wikalanie nɨenso kitungo ɨlɨpu, Paʉlo wɨkahita. <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />Ingɨ naɨ ʉkʉhega, wɨkalaga, “Kʉtulya anga Itunda walowe.” Sʉnga wɨkahega kʉ Epeso kʉkɨɨla nzɨla.<verse eid="ACT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 18:22" />Wɨkimɨsha ɨmeli kʉ Kaisalia, wikalongola kʉ Yelusalemu kʉalamʉsha ahʉɨɨli ang'wa Yesʉ, sʉnga wɨkalongola kʉ kɨsalɨ ka Antiokia. <verse eid="ACT 18:22" /><verse number="23" style="v" sid="ACT 18:23" />Wɨkikiɨ kʉng'wanso itungo iniino, sʉnga wɨkalongoleka nʉ mʉhɨnzo kʉkɨɨla nkɨka niya Galatia nɨ Piligia, wazeakomya nkolo amanyisigwa ɨhi.<verse eid="ACT 18:23" /></para>
  <para style="s">Apolo ʉkʉtanatya kʉ Epeso nʉ kʉ Kolinto</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />Matungo nanso aɨʉkolɨ Myahudi ʉng'wɨ lina lakwe Apolo, mʉnya kʉ Alekisandilia, wɨkaza kʉ Epeso. Mʉntʉ ʉyʉ aiʉkete ʉhumi ʉkʉlʉ nʉwa kʉtambʉla, hangɨ aɨmʉmanyi nʉwa Ʉandikwa wang'wi Itunda. <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />Aɨʉmanyisigwe makani ang'wi Isekʉlʉ, nʉyo aɨmʉkamatɨku mʉ ng'wahʉ, wɨkamanyisa iza nkani yang'wa Yesʉ, Nɨ itɨga aɨwɨmanyisa ɨkʉlʉ kʉʉlʉ palʉng'wɨ nɨ kɨna aɨʉʉlɨngile ʉbadisi wang'wa Yohana du. <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />Apolo wɨkandya kʉtambʉla kʉ ʉkamatɨku mʉnyʉmba akʉtankanɨla Ayahudi, ingɨ Pilisila nʉ Akila naɨija ɨkamʉhola kimpelo ikamʉmanyisa kɨsa kɨɨsa makani ang'wi Itunda. <verse eid="ACT 18:26" /><verse number="27" style="v" sid="ACT 18:27" />Sʉnga Apolo naɨwahiya kʉlongola kʉ Akaya, ahʉɨɨli ang'wa Yesʉ akʉ Epeso ɨkamʉkomya ɨnkolo, ɨkamʉandɨkɨlya balʉa kʉatambʉlya ahʉɨɨli ang'wa Yesʉ nɨa kʉ Akaya amʉsɨngɨɨlye. Naɨwapika kʉng'wanso aɨʉagunile kʉ ʉkende wang'wi Itunda antʉ naɨahʉɨɨla. <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />Kʉʉhumi nʉwakwe ʉkʉlʉ nʉwa kʉtambʉla aɨʉlongolekile kʉ ʉkamatɨku kʉahitɨlya kɨhenga Ayahudi wazelagɨɨla makani a Ʉandɨkwa kɨna ʉ Yesʉ yʉyo Kilisito.<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="s">Paʉlo ʉkʉtanantya ʉko kʉ Epeso</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />Apolo naɨʉkolɨ kʉ Kolinto, Paʉlo wɨkalongola mʉmahɨɨ nakoli mʉmalʉgʉlʉ, wɨkapika kʉ Epeso. Kʉng'wanso wɨkaahanga amanyisigwa kɨtʉnga, <verse eid="ACT 19:1" /><verse number="2" style="v" sid="ACT 19:2" />wɨkaakolya, “Itɨɨ, aɨmʉmʉsɨngɨɨyene ʉ Ng'wahʉ Ng'welʉ apo naɨmʉmʉhʉɨɨe ʉ Yesʉ?” Nɨenso ɨkamʉsʉkɨɨlya,</para>
  <para style="p" vid="ACT 19:2">“Shanga aɨkigulye kɨna ʉkolɨ Ng'wahʉ Ng'welʉ.”<verse eid="ACT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 19:3" />Papo Paʉlo wɨkaakolya, “Itɨɨ, aɨmʉbadisigwe ʉbadiso kɨɨ?” Ɨkamʉsʉkɨɨlya,</para>
  <para style="p" vid="ACT 19:3">“Naɨʉmanyisilye ʉ Yohana.”<verse eid="ACT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 19:4" />Paʉlo wɨkalʉnga, “Yohana aɨʉmʉmanyisilye kila itʉnʉ, Yohana aɨʉatambʉie ɨantʉ amʉhʉɨɨle ʉyo nʉpembilye anga wahega nʉanso, ingɨ ʉ Yesʉ.”<verse eid="ACT 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 19:5" />Antʉ naɨija aya, ɨkabadisigwa kʉ lina lang'wa Yesʉ. <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />Paʉlo wɨkaalompeela nʉkʉaɨkɨɨlya mɨkano, ɨkalija ngulu niya Ng'wahʉ Ng'welʉ, nawo ɨkandya kʉtambʉla kʉntambʉ ngɨɨza nʉkʉtanantya Nkani Nza. <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />Antʉ awa aɨanga itʉnja ikʉmi na abɨɨlɨ.<verse eid="ACT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8" />Matungo a myeli ɨtaatʉ Paʉlo aɨʉkendingɨla mʉnyʉmba akʉtankanɨla Ayahudi mʉng'wanso wɨkatambʉla kʉ ʉkamatɨku, wazitambʉlya nʉkʉpepeelya antʉ ahʉɨɨle makani a Ʉtemi wang'wi Itunda. <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" />Ingɨ ang'wɨao aɨalʉgoha ɨkahita kʉhʉɨɨla, ɨkatula lʉkunka lʉkani lang'wi Isekʉlʉ Yesʉ ntongeela amɨlʉmdo nʉwa antʉ. Papo ʉ Paʉlo wɨkatemanʉka nɨenso, wɨkaahola kɨmpelo ɨamanyisigwa akwe, wɨkitambʉlya nawo mahikʉ ɨhi mʉ kɨanda ka mʉntʉ ʉng'wɨ witangwa Tilano. <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />Wɨkalongoleka kʉtendaʉʉ kʉ myaka ɨbɨɨlɨ, Ayahudi nɨ antʉ nɨshanga Ayahudi ɨhi nɨishiɨ kihɨɨ a Asia ɨkatula ija ʉlʉkani lag’wi Isekʉlʉ Yesʉ.<verse eid="ACT 19:10" /></para>
  <para style="s">Ahʉmba ang'wa Sikewa akʉgema kʉpʉmya hɨng'wɨ</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11" />Itunda wɨkituma mɨʉkʉɨlwa ɨdʉ kʉkɨɨla Paʉlo. <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />Antʉ aɨakendahola itambala ang'wɨ ngʉo ga natugawe nʉ Paʉlo, alwae anga ikʉye mʉmɨɨlɨao, aɨakenda komya malwaeao nawa nɨ ahɨng'wɨ aɨakenda puma. <verse eid="ACT 19:12" /><verse number="13" style="v" sid="ACT 19:13" />Ayahudi ang'wɨ nawo naɨɨhamambya azepumya ahɨng'wɨ ɨkagema kʉtʉmɨla lina lang'wi Isekʉlʉ Yesʉ kʉ antʉ nɨakete ahɨng'wɨ azelʉnga, “Kʉʉlagɨɨlya ʉmʉpume kʉ lina lang'wi Isekʉlʉ Yesʉ, ʉyo nʉkʉtanantigwa nʉ Paʉlo.” <verse eid="ACT 19:13" /><verse number="14" style="v" sid="ACT 19:14" />Aɨakolɨ ahʉmba mʉpungatɨ a mʉtongeeli nʉwa apolyi nʉwa Ayahudi lina lakwe Sikewa, aɨagemile kʉheja hɨng'wɨ. <verse eid="ACT 19:14" /><verse number="15" style="v" sid="ACT 19:15" />Ingɨ ʉ hɨng'wɨ wɨkaasʉkɨɨlya, “Yesʉ nʉmʉmanyile nʉ Paʉlo nʉmʉmanyile, ʉnyenye mɨanyenyu?”<verse eid="ACT 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 19:16" />Sʉnga mʉntʉ ʉyʉ naɨʉkete ʉhɨng'wɨ wɨkaaputɨla wɨkaakʉa nʉ kʉalemya ɨhi. Ɨkapuma mʉnyʉmba nanso ikamanka aze ɨkɨpwɨ hangɨ akete ngʉma. <verse eid="ACT 19:16" /><verse number="17" style="v" sid="ACT 19:17" />Ikani ɨlɨ lɨkakumʉka kʉ Ayahudi ɨhi nɨ antʉ nɨshanga Ayahudi naɨishiɨ kʉ Epeso, ɨhi ɨkaambwa woa, nawo ɨkalɨkʉlya ɨ lina lang'wi Isekʉlʉ Yesʉ. <verse eid="ACT 19:17" /><verse number="18" style="v" sid="ACT 19:18" />Antʉ nɨamʉhʉɨɨe ʉ Yesʉ ɨdʉ ɨkapumɨla kɨhenga ɨkila itʉnʉ kʉ ntendo yao nimbɨ. <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" />Antʉ ang'wɨ naɨitʉmile makani aʉlogi ɨkaleta mbugulu nɨɨlogela pantongeela a antʉ nʉkʉisonsa moto. Ɨkaaɨɨlya nsaɨlo niyambugulu naɨasonsilwe moto aɨmagwe amadini apeza elupu hamʉsini. <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" />Itɨ ʉʉgwa lʉkani lang'wi Isekʉlʉ Yesʉ lɨkalongoleka kenela nʉkʉtula ningulu.<verse eid="ACT 19:20" /></para>
  <para style="s">Antʉ akʉleta minyomo kʉ Epeso</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />Naɨakɨla makani aya, Paʉlo wɨkolomeela walongole kʉ Yelusalemu kʉkɨɨla kihɨɨ a kʉ Makedonia nɨ Akaya. Wɨkalʉnga, “Anga mpike kʉng'wanso, nɨitiga kʉhɨɨgwa nongole nʉ kʉ Lumi.” <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />Itɨgwa wɨkaalagɨɨlya ahemba akwe abɨɨlɨ a Timoteo nʉ Elasito, amʉtongeele kʉ Makedonia, nʉanso wɨkasaga iniino kʉ Asia.<verse eid="ACT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />Itungo lɨlo lɨɨlo wikigela minyomo ʉkʉlʉ kʉ Epeso kʉnsoko a lʉkani lang'wi Isekʉlʉ. <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />Mʉntʉ ʉng'wɨ mʉtyana peza lina lakwe Demetilio aiwipityana pidʉdʉ nɨpimpyani nɨ mʉnyʉmba ang'wi Itundaao nʉwa kɨsʉngʉ nʉitangwa Alitemi, mʉlɨmo nʉwanso aɨwɨagolɨpya atyani. <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />Dematilio wɨkailingɨɨla antyanɨ aʉya naɨɨtyana anga ng'wenso, wɨkaaɨla, “Ʉnyenye antʉ, mʉlɨngile kɨna ʉgolɨ witʉ wɨpumɨɨla mʉʉsʉlʉja wʉwʉ. <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />Nʉnyenye mijaa nʉkʉona makani ʉ Paʉlo nʉkʉtenda, shanga kʉnʉ kʉ Epeso du ingɨ pakupɨ Asia ɨhi ile itʉnʉ. Waapema nʉkʉapɨʉla antʉ ɨdʉ kʉnsoko ʉkʉlʉnga kɨna alʉngʉ nɨatyanilwe nɨ antʉ shanga alʉngʉ atai. <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />Nɨitiga nɨkɨbɨ shanga mʉlɨmo witʉ ʉdu ʉkʉdalahwa, ingɨ nɨ nyʉmba nag’wi mʉlʉngʉ nʉwa kɨsʉngʉ ʉ Alitemi ɨkʉdalahwa. Nɨtunda nʉmʉkʉlʉ nʉɨkʉligwa kʉ Asia ɨhi nʉ ʉnkumbigʉlʉ wɨhi antʉ akʉpela kʉmʉkʉligwa.”<verse eid="ACT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28" />Naɨija inkani izi, ɨkahung'wa ikuo ɨkatula kitʉnta azelʉnga, “Alitemi mʉlʉngʉ nʉwa Aepeso ingɨ Mʉkʉlʉ.” <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />Papo minyomo wɨkigela mʉantʉ kɨsalɨ kɨhi. Ɨkaamba a Gayo nʉ Alisitaliko, antʉ abɨɨlɨ nɨa kʉ Makedonia naɨɨgendania nʉ Paʉlo, antʉ ɨkamankɨɨla pa ɨtankanɨla kʉdʉa. <verse eid="ACT 19:29" /><verse number="30" style="v" sid="ACT 19:30" />Paʉlo wɨkahiya kingɨla mʉmilʉmdo nʉwa antʉ, ingɨ ahemba ɨkamʉgilya. <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />Atongeeli ang'wɨ nɨa kɨsalɨ ka Asia, naɨahʉmbaʉya ang'wa Paʉlo, ɨkalagɨɨlya antʉ azemʉɨla ʉ Paʉlo waleke kiaja kingɨla pang'wanso. <verse eid="ACT 19:31" /><verse number="32" style="v" sid="ACT 19:32" />Pang'wanso shanga aɨakitengeelya antʉ ang'wɨ aɨakitʉnta itɨ nɨ aʉya aɨakitʉnta itɨ. Antʉ ɨdʉ shanga aɨalɨngile nɨkɨ aɨilundile kʉng'wanso. <verse eid="ACT 19:32" /><verse number="33" style="v" sid="ACT 19:33" />Ayahudi ɨkamʉtala ʉ Alekisanda pantongeelao, antʉ aʉya mʉmilʉmdo nʉanso ɨkitʉnta azemʉlɨngasa nɨkakʉtambʉla. Alekisanda wɨkanyansʉɨla mʉkono akilaje wahume kilongola ntongeela a antʉ. <verse eid="ACT 19:33" /><verse number="34" style="v" sid="ACT 19:34" />Ingɨ naɨalɨnga kɨna ʉ Alekisanda ingɨ Mʉyahudi, ɨhi palʉng'wɨ ɨkazogolya kitungo nɨla masaa abɨɨlɨ, azelʉnga, “Alitemi nʉwa Aepeso ingɨ Mʉkʉlʉ.”<verse eid="ACT 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35" />Itungo iniino mʉtongeeli nʉwa kɨsalɨ wɨkaakilaja ɨantʉ nʉ kʉlʉnga, “Ʉnyenye anya kʉ Epeso, itɨɨ, mʉlɨngɨlene kɨna antʉ a kɨsalɨ ka Epeso wawo asʉnji a nyʉmba ang'wa Alitemi nɨɨza mʉkʉlʉ hangɨ ɨɨza asʉnji a dʉdʉ nʉigwe naɨtʉngʉkile kʉpuma kigʉlʉ. <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />Kʉtɨlɨ anga mʉntʉ nʉhumile kʉhita ɨmakani aya. Kʉlʉlo mʉtakɨwe mʉkilaje hangɨ mʉleke kipatɨɨlya kʉtenda kɨhi. <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />Maaleta antʉ awa apaitɨ, nɨitɨ ga shanga amɨsensile ɨ nyʉmba ang'wa Alitemi ang'wɨ kʉmʉtʉkɨla itunda witʉ nʉwa kɨsʉngʉ. <verse eid="ACT 19:37" /><verse number="38" style="v" sid="ACT 19:38" />Itɨ gwa, anga ɨze ʉ Demetilio nɨatyani aʉya akete ikani ilito kʉ mʉntʉ wɨhi, maanza nɨalamʉli akolɨ, ahumile kʉsema kʉko. <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />Ingɨ anga ɨze lɨkolɨ ikani lɨhi, mʉtakɨwe mʉtale mʉ milʉmdo nʉʉgombekile. <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />Anga itungo ɨlɨ nɨ yɨlɨ, kʉkolɨ mʉʉsemelwa kɨna kʉletile minyomo kʉnsoko ikani nɨla lelo. Shanga kʉhumile kilongola kʉnsoko minyomo shanga ʉkʉaɨɨlya.” <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />Naɨwakondya kʉtambʉla itɨ wɨkaaɨla antʉ naɨakolɨ pianza nɨlanso abalansane.<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="s">Paʉlo ʉkʉlongola hangɨ kʉ Makedonia nʉ kʉ Yunani</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />Minyomo ʉwʉ nʉwa kʉ kɨsalɨ ka Epeso naɨwaʉla, Paʉlo wɨkaɨtanga palʉng'wɨ ɨahʉɨɨli ang'wa Yesʉ wɨkaakomya nkolo, wɨkaalaga. Sʉnga wɨkalongola kʉ Makedonia. <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />Wɨkakɨɨla mʉ mahɨɨ nanso waze akomya nkolo antʉ nɨamʉhʉɨɨe ʉ Yesʉ kʉ nkani yɨdʉ. Sʉnga wɨkapika kʉ Ʉyunani, <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />kʉng'wanso wɨkikiɨ myeli ɨtaatʉ. Naɨ ʉkihamba kʉlongola kʉ Silia wɨkalɨnga kɨna Ayahudi aɨakʉnoneelya isuɨ ɨbɨ, itɨ gwa Paʉlo wɨkalamʉla kʉsʉka kʉkɨɨla kʉ Makedonia. <verse eid="ACT 20:3" /><verse number="4" style="v" sid="ACT 20:4" />Paʉlo aɨakʉɨlanilye nɨ a Sopatilo, ng'wana wang'wa Piliho, kʉpuma kʉ Belea, wɨkakʉɨlania nɨa Alisitaliko nʉ Sekundo, kʉpuma kʉ Tesalonike nʉ Gayo kʉpuma kʉ Delibe nɨ a Timoteo nʉ Tukiko nʉ Tilopimo nʉwa kɨsalɨ ka Asia. <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />Antʉ awa aɨakʉtongee ʉsese nʉ kʉʉlindɨɨla kʉ Tiloa. <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />Naɨlakɨla iloeelya nila mikate nɨshanga Ɨgahɨɨye, ʉsese kɨkanankɨla meli kʉpuma kʉ Pilipi, naɨ akɨla mahikʉ ataatʉ kɨkapikɨɨla kʉ Tiloa, kʉng'wanso aɨkikiɨ mahikʉ mʉpungatɨ.<verse eid="ACT 20:6" /></para>
  <para style="s">Paʉlo ʉkʉmiʉsha ʉ Eʉtiko ʉko kʉ Tiloa</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />Lʉhikʉ nʉla ng'wandyo mʉ mahikʉ mʉpungati kɨkatankana kʉlya lʉdya lang'wi Isekʉlʉ. Paʉlo aɨwalomeela kʉhega mʉdaʉao, wɨka atanantɨlya ɨantʉ nʉkʉlongoleka kʉdʉa nɨ antʉ kʉpikɨɨla ʉtikʉ wigɨngʉ. <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />Mʉnɨndo naɨ kʉmolɨ kʉgolopwa, aɨyikolɨ koloboi yɨdʉ yakɨe. <verse eid="ACT 20:8" /><verse number="9" style="v" sid="ACT 20:9" />Midilisha nɨla nɨndo naso aɨwikiɨ mʉhʉmba ʉng'wɨ witangwa Eutiko, ʉ Paʉlo naɨ ʉlongolekile kʉtanantya, mʉhʉmba ʉyʉ wɨkandya kʉtindila sʉnga wɨkakɨɨlwa tʉlo, wɨkagwa pihɨ kʉpuma golopwa a kataatʉ. Naɨendile mʉkenka wɨkatula wakuza. <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />Ingɨ ʉ Paʉlo wɨkasima pihɨ, wɨkatuna, wɨkamʉungatɨla mʉhʉmba nʉwanso wɨkalʉnga, “Leki kʉlɨli mʉpangaʉ.” <verse eid="ACT 20:10" /><verse number="11" style="v" sid="ACT 20:11" />Sʉnga ʉ Paʉlo wɨkanankɨla migʉlya agolopwa, wɨkahola ndya, wɨkalya. Wɨkalongoleka kʉdʉa nɨenso kitungo ɨlɨpu kʉpikɨɨla kilya kʉtamʉka, sʉnga wɨkahega. <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />Antʉ ɨkamʉsʉsha ʉ mʉhʉmba kitolao waze mʉpanga, nawo ɨkalowa ikʉlʉ.<verse eid="ACT 20:12" /></para>
  <para style="s">Mʉhɨnzo wang'wa Paʉlo kʉpuma kʉ Tiloa kenda kʉ Mileto</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />Ʉsese kɨkingɨla mʉmeli kɨkalongola mʉhɨnzo kʉkɨɨla mʉlʉzɨ kɨkapika kʉ Aso, kʉko naɨ kʉze mʉkenkeelya ʉ Paʉlo. Aʉkʉɨɨe ʉsese kʉtende itʉ, kʉnsoko nʉanso aɨʉloilwe kʉlongola kʉng'wanso namɨgʉlʉ. <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />Naɨ wakʉhanga kʉ Aso, wɨkanankɨla meli kɨkapikania kʉ Mitilene. <verse eid="ACT 20:14" /><verse number="15" style="v" sid="ACT 20:15" />Kʉpuma kʉng'wanso kɨkalongoleka kʉkɨɨla mʉlʉzɨ kɨkapika kʉ Kio. Lʉhikʉ nʉla kataatʉ kɨkaputa kitʉmbi kɨkalongola kʉ Samo, lʉhikʉ nʉla kannɨ kɨkapikɨɨla kʉ Mileto. <verse eid="ACT 20:15" /><verse number="16" style="v" sid="ACT 20:16" />Paʉlo aɨʉlamʉe kʉleke kʉkɨɨla kʉ Epeso, waleke kitintɨka mʉnkɨka niya kʉ Asia. Aɨwipatɨɨye kʉpika kʉ Yelusalemu ɨze lʉkɨlɨ kʉpika lʉhikʉ liloeelya nɨla Pentekosite ang'wɨ ikʉhumɨka.<verse eid="ACT 20:16" /></para>
  <para style="s">Paʉlo ʉkʉalaga Anyampala a kʉ Epeso</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17" />Paʉlo naiʉkolɨ kʉ Mileto, wɨkalagɨɨlya mʉntʉ kʉ atongeelɨ a kʉ Epeso atankane nʉyo. <verse eid="ACT 20:17" /><verse number="18" style="v" sid="ACT 20:18" />Mʉntʉ ʉyʉ naɨwapika ɨkaatambʉɨla, “Ʉnyenye mʉlɨngile naɨ nishiɨ mitolanyu itungo lɨhi kʉpuma lʉhikʉ nʉla ng'wandyo naɨmpikile apa pa Asia. <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />Mʉlɨngile naɨ neenditʉma mʉlɨmo wang'wi Isekʉlʉ kʉʉza wɨhi nʉʉwai nɨzengimilye ʉlwago ninkʉngumi naɨ nɨkendatendeelwa nɨ Ayahudi. <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />Mʉlɨngile kɨna shanga aɨnɨtendisilye kʉtanantya ikani lɨhi nɨlɨkʉmʉaɨɨlya ʉnyenye, ingɨ manyisilye kɨhenga mʉmatolanyu. <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />Nɨahʉgʉe ɨ Ayahudi nɨ Ayunani kɨna amʉgombe Itunda nʉkʉleka ɨmɨlandʉ nʉ kʉmʉhʉɨɨla Isekʉlʉ witʉ Yesʉ Kilisito. <verse eid="ACT 20:21" /><verse number="22" style="v" sid="ACT 20:22" />Itungo ɨlɨ nahega kʉngulu a Ng'wahʉ Ng'welʉ, nalongola kʉ Yelusalemu shanga ningɨle nakʉmpata kʉng'wanso. <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />Nɨngɨle kɨna Ng'wahʉ Ng'welʉ ʉnihʉgʉʉye kɨna kɨtungo nʉlwago yinindɨɨe. <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" />Ingɨ ʉnene shanga mbaɨɨye ʉlikalo lane kɨna kɨntʉ ka nsaɨlo, anga kʉmala wikʉngʉmi nʉ kʉkondeelya mʉlɨmo wang'wi Isekʉlʉ Yesʉ naɨʉmpee, ingɨ, kʉtanantya Nkani Nza niya ʉkende wang'wi Itunda.<verse eid="ACT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25" />“Ʉnene itungo ɨlɨ nalɨnga kɨna kʉtilɨ nʉyʉ nʉng'wɨ ga mʉng'waanyu nɨshanga nʉmʉtanantɨye Ʉtemi wang'wi Itunda mʉ ʉgendagendi wane, nɨngile kɨna kʉtilɨ anga mʉntʉ nʉɨkamona hangɨ. <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />Itʉngo ɨlɨ kʉmʉɨli kɨna lelo ɨyɨ mʉntʉ wɨhi anga walimɨle nɨmʉgila anga igazo lɨhi, <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />kʉnsoko mahikʉ ɨhi nʉmʉtambʉɨe nkani yɨhi naɨʉloilwe Itunda. <verse eid="ACT 20:27" /><verse number="28" style="v" sid="ACT 20:28" />Hʉgʉki mʉnkolo yanyu nʉ kʉasʉnja ahʉɨɨli ɨhi Ng'wahʉ Ng'welʉ nʉmʉɨkile mʉtule mɨasʉnji akwe. Asʉnji ahʉɨɨli ang'wa Yesʉ nʉagʉile kʉkɨɨla sakami a ng'waakwe. <verse eid="ACT 20:28" /><verse number="29" style="v" sid="ACT 20:29" />Nɨngɨle kɨna anga ʉnene nihege, azile amanyisi aʉteele mʉng'wanyu nɨɨhanga mbugi ntaki niangila kɨaisa kʉ antʉ nɨamʉhʉɨɨe ang'wa Yesʉ. <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />Nʉmʉng'wanyu ga ɨkimɨka antʉ aʉteele kʉlimangɨɨlya ɨtai ahume kʉapema antʉ nɨamʉhʉɨɨe ʉ Yesʉ aatyate. <verse eid="ACT 20:30" /><verse number="31" style="v" sid="ACT 20:31" />Itɨ gwa hʉgʉki, kɨmbʉki kɨna myaka ɨtaatʉ ʉtikʉ nʉ ng'ʉng'wɨ, aɨnongolekile kʉmʉmanyisilye mɨhi, kʉ lioli.<verse eid="ACT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32" />“Itungo ɨlɨ gwa kʉmʉleka mʉʉhumi wang'wi Itunda nʉ kʉ lʉkani nʉla ʉkende, ʉhumi nʉkʉmʉzenga nʉ kʉmʉpa ʉnyenye kɨpegwa nʉaɨkɨɨye antʉ ɨhi nɨagombekile kʉng'wakwe. <verse eid="ACT 20:32" /><verse number="33" style="v" sid="ACT 20:33" />Ʉnene aɨnɨmʉgila anga nsʉla a mpia ang'wɨ zahabu ang'wɨ ngʉo a mʉntʉ wɨhi. <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />Nyenye mʉlɨngile kɨna kʉ mɨkono ane nitʉmile mɨlɨmo nɨzeduma maitʉ ane naya na antʉ naɨkɨpalʉng'wɨ. <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />Aɨnɨmʉpeza mpyani kɨna kʉkɨɨla akitʉma mɨlɨmo kʉngulu yɨhi kʉtakɨwe kʉaaɨɨlya ɨalema, mʉzekɨmbʉka inkani yang'wi Isekʉlʉ Yesʉ naɨ ʉitambʉe kɨna, ‘Ingɨ bahu kʉpumya kʉkɨla kʉsɨngɨɨlya.”’<verse eid="ACT 20:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36" />Paʉlo naɨ wakondya kʉtambʉla itɨ, wɨkatugama palʉng'wɨ nɨenso, wɨkamʉlompa Itunda. <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />Antʉ ɨhi ɨkalɨla, ɨkamʉʉngatila ʉ Paʉlo nʉkʉmʉlaga. <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />Naɨlɨalɨiye ingɨ nkani naɨʉtambʉe ʉ Paʉlo kɨna shanga akʉmʉona hangɨ. Ɨkamʉtindɨkɨɨlya wɨkamʉpisha mʉ meli.<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="s">Paʉlo ʉlongoe kʉ Yelusalemu</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />Naɨkilaga nɨenso kʉʉkɨa, kɨkanankɨla meli kɨkandya mʉhɨnzo kɨkakɨlɨnkania kɨkapika kʉ Kosi. Lʉhikʉ naɨlʉtyatile kɨkapika kʉ Lodo kʉpuma kʉng'wanso kɨkalongola kʉ Patala. <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />Pang'wanso kɨkahanga meli ilongoe kʉ Poinike kʉlʉlo kɨkanankɨla kɨkalongola nɨyo. <verse eid="ACT 21:2" /><verse number="3" style="v" sid="ACT 21:3" />Naɨkakɨona kɨsiwa ka Kipolo, kɨkakɨndamɨla ipande nɨla takama, kɨkatʉnga kʉ Silia. Meli ɨkapantama pa kɨsalɨ ka Tilo pang'wanso ɨkatula simya mɨligo akwe. <verse eid="ACT 21:3" /><verse number="4" style="v" sid="ACT 21:4" />Kɨkaahanga amanyisigwa akʉng'wanso, kɨkikalania mahikʉ mʉpungatɨ. Amanyisigwa nɨanso kʉʉtongwɨ nʉwa Ng'wahʉ ɨkamʉɨla ʉ Paʉlo wadɨle kʉ Yelusalemu. <verse eid="ACT 21:4" /><verse number="5" style="v" sid="ACT 21:5" />Ingɨ itungo litʉ naɨlaʉla, kɨkahega kɨkalongoleka nʉ mʉhɨnzo witʉ. Amanyisigwa nɨanso ɨhi palʉng'wɨ nɨ asʉngʉao nɨ anaao, ɨkakʉtindɨkɨɨlya ɨkakʉpisha kʉnzɨ akɨsalɨ, naɨkapika pa mpelo kɨhi kɨkatugama kɨkalompa. <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />Sʉnga naɨkilaga, ʉsese kikanankila mʉmeli, nɨanso ɨkatulya mʉmatolao.<verse eid="ACT 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7" />Ʉsese kɨkalongoleka nʉ mʉhɨnzo witʉ na meli kʉpuma kʉ Tilo kɨkapika kʉ Tolemai, kɨkaalamʉsha anyandʉgʉ ɨitʉ nɨahʉɨɨli nɨa kʉng'wanso kɨkadʉania lʉhikʉ lʉng'wɨ. <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" />Lʉhikʉ naɨ lʉtyatile kɨkalongoleka nʉ mʉhɨnzo, kɨkapika kʉ kɨsalɨ ka Kaisalia. Kʉng'wanso kɨkalongola mito nɨla mʉtanantyi ʉng'wɨ witangwa Pilipo, ʉng'wɨao mʉ antʉ awo nɨaaɨɨlyi mʉpungatɨ naɨ ahoilwe ʉko kʉ Yelusalemu. <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />Pilipo aɨʉkete anaanso annɨ nɨakɨlɨ kʉmanya itʉnja naɨ ɨpumyaa ʉmanga. <verse eid="ACT 21:9" /><verse number="10" style="v" sid="ACT 21:10" />Naɨkikiɨ mahikʉ kɨtʉnga mʉmanga ʉngɨwɨ nʉwang'wɨ Itunda ɨlina lakwe Agabo wɨkahulumʉka kʉpuma kʉ Yʉdea. <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />Naɨwakʉhanga, wɨkahola ʉ mʉsipi wang'wa Paʉlo, wɨkitaligɨɨlya mɨkono nɨ mɨgʉlʉ akwe sʉnga wɨkalʉnga, “Ng'wahʉ Ng'welʉ ʉkʉlʉnga itɨ, Ayahudi akʉ Yelusalemu akʉmʉtaligɨɨlyaʉ ʉmʉkola mʉsipi ʉwʉ nʉkʉmʉtala kʉ antʉ nɨshanga Ayahudi wagigwe.”<verse eid="ACT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12" />Naɨkija inkani izi, ʉsese nɨ anyandʉgʉ aʉya kɨkamʉpepeelya ʉ Paʉlo wadɨle kʉ Yelusalemu. <verse eid="ACT 21:12" /><verse number="13" style="v" sid="ACT 21:13" />Ingɨ Paʉlo wɨkasʉkɨɨlya, “Mʉkʉhiya kʉtenda ʉlɨ? mʉkʉlɨla nʉkuhiya kʉnkatapya? Ʉnene nihambile shanga ʉkʉtungwa mʉkadulumu du, ingɨ ga nʉkʉshɨla kʉ Yelusalemu kʉnsoko ang'wi Isekʉlʉ Yesʉ.”<verse eid="ACT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 21:14" />Naɨwahita kʉija, kɨkamʉleka, kɨkalʉnga, “Niitule anga nʉloewe Itunda.”<verse eid="ACT 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15" />Kɨkikiɨ pang'wanso mahikʉ kɨtʉnga, sʉnga kɨkihamba nʉkʉhega, kɨkalongoleka nʉ mʉhɨnzo witʉ kʉ Yelusalemu. <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" />Amanyisigwa ang'wɨ kʉpuma kʉ Kaisalia aɨakʉɨlanilye nʉsese ɨkakʉtala kito lamʉntʉ naɨwitangwa Mʉnasoni, naɨkʉtakɨwe kʉpikɨla mitolakwe. Mʉntʉ ʉyʉ aɨmʉnya kʉ Kipolo aɨʉng'wɨ mʉ amanyisigwa ang'wandyo.<verse eid="ACT 21:16" /></para>
  <para style="s">Paʉlo ʉkʉmiʉmbaʉmbɨla Yakobo</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />Naɨkapika kʉ Yelusalemu anyandʉgʉ nɨahʉɨɨli ɨkakʉsɨngɨɨlya kʉ ʉlowa. <verse eid="ACT 21:17" /><verse number="18" style="v" sid="ACT 21:18" />Mʉdaʉao Paʉlo wɨkakʉɨlania nʉsese kʉdʉa nʉ Yakobo nɨ anyampala ahʉɨɨli ang'wa Yesʉ naɨamolɨ. <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />Naɨkakondya kʉalamʉsha, Paʉlo wɨkatula aganʉɨla lʉng'wɨ lʉng'wɨ mʉmakani Itunda naɨwitʉmile mʉantʉ nɨshanga Ayahudi kʉkɨɨla witʉmi wakwe. <verse eid="ACT 21:19" /><verse number="20" style="v" sid="ACT 21:20" />Antʉ nɨanso naɨija imakani aya ɨkamʉkʉlya Itunda. Papo ɨkamʉɨla ʉ Paʉlo, “Mʉnyandʉgʉ, waona akolɨ ɨdʉ ʉbɨ na Ayahudi nɨahʉɨɨe, hangɨ ɨhi akagupile kʉambɨɨla ɨmalagɨɨlyo ang'wa Musa. <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />Ingɨ ijaa impola niyako kɨna ʉkʉamanyisa Ayahudi ɨhi nɨishiɨ mʉ antʉ nɨshanga Ayahudi amahite ɨmalagɨɨlyo ang'wa Musa nɨ kɨna aleke kʉatala kɨganda ɨanao nɨagoha ang'wɨ kʉtyata intendo yao. <verse eid="ACT 21:21" /><verse number="22" style="v" sid="ACT 21:22" />Itungo ɨlɨ kʉʉtendaʉlɨ? Kʉlʉ kʉʉlʉ ahumile kija kɨna ʉewe wazaa kʉ Yelusalemu. <verse eid="ACT 21:22" /><verse number="23" style="v" sid="ACT 21:23" />Kʉlʉlo itume anga nɨkʉkʉtambʉɨla. Akolɨ antʉ annɨ apa nɨalapile kʉmʉpumɨɨlya Itunda. <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />Ihanje nɨ antʉ nɨanso ʉalɨpɨlye mpia yɨhi nɨamʉlapɨe Itunda, sʉnga azulwe insingɨ yao. Anga ʉtende itɨ antʉ ɨhi akʉlɨnga kɨna makani naɨigulye kɨna ʉewe ʉtyatile malagɨɨlyo ang'wa Musa shanga atai. <verse eid="ACT 21:24" /><verse number="25" style="v" sid="ACT 21:25" />Ingɨ kʉ antʉ nɨshanga Ayahudi nɨaina ahʉɨɨli ang'wa Yesʉ kaandɨkɨla ʉʉlamʉli witʉ kɨna aleke kʉlya kɨntʉ kɨhi nɨkɨpumigwe isongelyo kʉ adʉdʉ nɨ sakami ang'wɨ kʉlya nyama niya kɨkalɨ nɨ kishɨɨe ang'wɨ kɨgogilwe, hangɨ ikome ni ntendo niya ʉsambo.”<verse eid="ACT 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26" />Papogwa mʉdaʉao ʉ Paʉlo wɨkaahola antʉ nɨanso ɨkinoneelya ahume kʉgombeka mʉitakɨwe mʉntendo yipolyo. Sʉnga wɨkingɨla pa Nyʉmba ang'wi Itunda wahume kʉapikɨlya mpola niya mahikʉao nakishiɨ mʉwielyi nʉʉgombekile kʉ ntendo nɨyipolya, nɨsongelyo nɨlɨkʉpumigwa kʉnsoko amʉntʉ wɨhi.<verse eid="ACT 21:26" /></para>
  <para style="s">Paʉlo ʉkʉambwa</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />Mahikʉ aya nɨmʉpungatɨ naɨahumbeela kʉʉla, Ayahudi ang'wɨ kʉpuma nkɨka akʉ Asia naɨamʉona ʉ Paʉlo pa Nyʉmba ang'wi Itunda, ɨka asambɨɨlya antʉ ɨhi ɨkamʉamba. <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />Ɨkaitʉntɨɨla azelʉnga, “Ʉnyeye Aisilaeli, kʉaɨɨlyi. Ʉyʉ yʉyʉ mʉntʉ nʉkendamanyisa ɨantʉ nkɨka yɨhi, makani nɨnsuta nɨ antʉ itʉ nɨmalagɨɨlyo ang'wa Musa nɨ Nyʉmba ang'wi Itunda. Itungo ɨlɨ ga waingɨlya antʉ nɨshanga Aisilaeli mʉ Nyʉmba ang'wi Itunda nʉkʉkanza pa nkɨka nɨ nzelʉ ileke kʉgombeka kʉng'wi Itunda.” <verse eid="ACT 21:28" /><verse number="29" style="v" sid="ACT 21:29" />Aɨatambʉe itɨ kʉnsoko aɨamʉine ʉ Tilopimo, mʉnya kʉ Epeso, ʉkolɨ mʉkɨsalɨ palʉng'wɨ nʉ Paʉlo, ɨkasɨga kɨna ʉ Paʉlo ʉmingɨɨye ʉ Tilopimo pa Nyʉmba ang'wi Itunda.<verse eid="ACT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30" />Antʉ ɨhi mʉkɨsalɨ ɨkahalɨnkanɨlwa, ɨkapembya kʉpuma mpande yɨhi aze amankile ɨkamʉamba ʉ Paʉlo, ɨkamʉkweha kʉpuma pa Nyʉmba ang'wi Itunda. Ndʉjɨ niya Nyʉmba ang'wi Itunda yɨkalugaɨlwa. <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />Iumbɨ nɨla antʉ nɨanso naɨihamba kʉmʉbʉlaga ʉ Paʉlo, mpola yɨkamʉpikɨɨla ʉ mankata nʉwa anyambita a Kilumi, kɨna kɨsalɨ kɨhi nɨka Yelusalemu ʉkolɨ minyomo. <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />Papo ʉ mankata wɨkahola anyambita akwe palʉng'wɨ nɨatongeeli maumbɨ aamboi ɨkahulumʉka mʉminyomo nʉwanso, antʉ awo naɨakete ʉminyomo naɨamʉona ʉmankata nɨamboi apembilye, ɨkaleka kʉmʉkʉa ʉ Paʉlo. <verse eid="ACT 21:32" /><verse number="33" style="v" sid="ACT 21:33" />Mankata nʉwanso wɨkɨza, wɨkamʉamba ʉ Paʉlo wɨkalagɨɨlya watungwe mɨnyololo ɨbɨɨlɨ. Sʉnga wɨkakolya, “Mʉntʉ ʉyʉ nyenyu, hangɨ ʉtendile ntʉni?” <verse eid="ACT 21:33" /><verse number="34" style="v" sid="ACT 21:34" />Antʉ ang'wɨ mʉ milʉmdo ɨkazogolya, awa azelʉnga itɨ nɨaʉya azelʉnga itɨ. Mankata nʉwanso naɨwaona kɨna kʉnsoko iyogo shanga ʉhumile kija ɨkʉlʉ kʉʉlʉ ankani, wɨkalagɨɨlya ʉ Paʉlo watalwe mʉnkambɨ aanyambita. <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />Paʉlo naɨwapika pa mʉnankɨɨlo nʉwakingɨɨlɨla mʉnkambɨ, amboi ɨkamikenkania kʉnsoko aminyomo nʉwa antʉ. <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />Kʉnsoko iumbɨ nɨla antʉ aɨatyatɨɨe nʉkʉlongoleka kʉzogolya akazelʉnga, “Mʉbʉlage ʉmʉntʉ ʉyʉ.”<verse eid="ACT 21:36" /></para>
  <para style="s">Paʉlo ʉkilongola</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />Paʉlo naɨ wahumbeela kingɨligwa mʉnkambɨ, wɨkamʉɨla ʉ mankata nʉwa anyambita, “Itɨɨ, nihumilene kʉʉɨla kɨntʉ kɨng'wɨ?” Mankata ʉyʉ wɨkamʉsʉkɨɨlya,</para>
  <para style="p" vid="ACT 21:37">“Itɨɨ, ʉmanyilene ɨ Kɨyunani? <verse eid="ACT 21:37" /><verse number="38" style="v" sid="ACT 21:38" />Itɨɨ, ʉewe shanga wɨ Mʉmisili ʉyo mahikʉ a pakupɨ naɨʉsakilye ʉpɨlʉki nʉ kʉatongeela abʉlagi elupu innɨ naɨ akete iyɨgɨ mijang'wa?”<verse eid="ACT 21:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39" />Paʉlo wɨkasʉkɨɨlya, “Ʉnene nɨ Mʉyahudi, ntugɨwe kʉ Taliso, ʉko kʉ Kilikia, nɨ mʉntʉ nʉwa kɨsalɨ nɨ kɨkumʉkile. Itʉnʉ ngombye nitambʉlye nɨ antʉ awa.”<verse eid="ACT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 21:40" />Mankata nʉwanso wɨkamʉgombya itambʉlye, Paʉlo wɨkimɨka pa mʉnankɨɨlo, wɨkaaɨla ɨantʉ akilaje. Antʉ ɨhi ɨkakilaja ihɨtwɨ, Paʉlo wɨkitambʉlya nɨ antʉ kʉ ntambʉ a Kiebulania, wɨkalʉnga.<verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />Paʉlo wɨkalongoleka kʉtambʉla, “Anyandʉgʉ ane nɨ atata ane, tegeelyi makani aya nɨlɨ.” <verse eid="ACT 22:1" /><verse number="2" style="v" sid="ACT 22:2" />Antʉ awa naɨija ʉkʉtambʉla ntambʉ a Kiebulania, ɨkakilaja ihɨtwɨ. Papo ʉ Paʉlo wɨkalʉnga.<verse eid="ACT 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 22:3" />“Ʉnene nɨ Mʉyahudi, ntugɨwe kʉ kɨsalɨ ka Taliso ʉko kʉ Kilikia, nkʉɨe mʉkɨsalɨ kɨkɨ, ndeilwe nʉ Gamalieli. Manyisigwe iza malagɨɨlyo a atata itʉ, aɨnɨmʉkamatɨku kʉng'wi Itunda anga ʉnyenye nɨmɨlɨ lelo. <verse eid="ACT 22:3" /><verse number="4" style="v" sid="ACT 22:4" />Aɨnɨagilye nʉkʉabʉlaga ɨantʉ nɨatyatile Nzɨla ɨyɨ, nɨzeaamba itʉnja nɨasʉngʉ nʉkʉatunga mʉkadulumu. <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />Mʉpolyi nʉ Mʉkʉlʉ nianza lɨhi nɨla anyampala ahumile kʉkʉɨɨla ikani nɨlanso. Kʉpuma kʉng'waao aɨnɨhola balʉa nɨaandɨkɨwe Ayahudi nɨakolɨ kʉ Damesiki, Ʉnene aɨnɨlongola nʉkʉaamba ɨantʉ nɨkaatunga nʉkʉaleta kʉ Yelusalemu ahume kʉpɨsɨɨligwa.<verse eid="ACT 22:5" /></para>
  <para style="s">Paʉlo ʉkʉganʉla kɨnyaʉlɨ ʉ Kilisito naɨʉmigee</para>
  <para style="r">
    <ref loc="ACT 9:1-19">Ntendo 9:1-19</ref>; <ref loc="ACT 26:12-18">26:12-18</ref></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6" />“Itɨ gwa naɨnkolɨ mʉnzɨla nongoe kʉ Damesiki, itungo nɨla saa mʉtandatʉ ng'ʉng'wɨ, kʉpumpugɨɨlya nzelya nkʉlʉ kʉpuma kilunde ɨkanalɨkɨla mpande yɨhi. <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />Nʉnene nɨkagwa pihɨ, nɨkija lʉli lʉkʉmbɨla, ‘Sauli, Sauli. Nɨkɨ ʉkʉnaja?’ <verse eid="ACT 22:7" /><verse number="8" style="v" sid="ACT 22:8" />Ʉnene nɨkakolya, ‘Ʉewe wɨnyenyu Isekʉlʉ?’ Nʉyo wɨkambɨla, ‘Ʉnene nɨ Yesʉ nʉwa kʉ Nazaleti ʉewe nɨwɨnaja.’ <verse eid="ACT 22:8" /><verse number="9" style="v" sid="ACT 22:9" />Itɨ gwa awa naɨɨpalʉng'wɨ nʉnene aɨamɨine ɨnzelya nanso, ingɨ shanga aɨigulye ʉlʉli nʉla ʉyʉ nʉkitambʉlya nʉnene. <verse eid="ACT 22:9" /><verse number="10" style="v" sid="ACT 22:10" />Ʉnene nɨkakolya, ‘Isekʉlʉ ntende ʉlɨ?’ Isekʉlʉ wɨkambɨla, ‘Ʉka ʉlongole kʉ Damesiki, kʉng'wanso ʉkʉɨlwa makani ɨhi nʉpangɨwe kʉtenda.’ <verse eid="ACT 22:10" /><verse number="11" style="v" sid="ACT 22:11" />Kʉlʉlo nɨkaleng'wa kʉona kʉnsoko a ʉmɨlɨgɨntu nʉwa nzelya, ɨane ɨkamamba mʉkono ɨkantala kʉ Damesiki.<verse eid="ACT 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12" />“Kʉ Dameski aɨʉkolɨ mʉntʉ ʉng'wɨ lina lake Anania, mʉntʉ ʉyʉ aɨʉambile malagɨɨlyo ang'wa Musa hangɨ aɨʉsanigwe nɨ Ayahudi ɨhi nɨishiɨ kʉng'wanso. <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />Anania wɨkimɨka pakupɨ nʉ nene wɨkalʉnga, ‘Mʉnyandʉgʉ Sauli, ona hangɨ!’ Papo paapo miho ane ɨkahuma kʉona hangɨ, ʉnene nikʉmʉona. <verse eid="ACT 22:13" /><verse number="14" style="v" sid="ACT 22:14" />Sʉnga Anania wɨkalʉnga, ‘Itunda nʉwa Atata itʉ wakʉhola ʉewe ʉhume kʉlɨnga ʉʉlowa wakwe, ʉmʉone nʉanso nɨ Mʉnya Tai hangɨ ʉhume kija inkani nʉkʉtambʉla. <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />Ʉewe wɨkatula atambʉɨla antʉ kʉnsoko makani ɨhi nʉmaine nʉkija. <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />Itungo ɨlɨ gwa, nɨkɨ ʉkitintɨka? Ʉka, ʉbadisigwe weligwe ʉhume kʉlekelwa mɨlandʉ ako, ʉlɨkʉlye ɨlina lakwe.’<verse eid="ACT 22:16" /></para>
  <para style="s">Isekʉlʉ ʉkʉmʉlagɨɨlya Paʉlo kʉtanantya kʉ antʉ nɨshanga Ayahudi</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17" />“Itɨ gwa nɨkatulya kʉ Yelusalemu, naɨkʉlompa mʉ Nyʉmba ang'wi Itunda, nɨkaona mʉloto, <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />nɨkamʉona Isekʉlʉ ʉkʉmbɨla, ‘Ipatɨɨlye, hega mʉ Yelusalemu kʉnsoko antʉ shanga akʉgomba lʉkani lane nʉʉkʉatambʉɨla.’ <verse eid="ACT 22:18" /><verse number="19" style="v" sid="ACT 22:19" />Ʉnene nɨkamʉsʉkɨɨlya, ‘Isekʉlʉ, antʉ awa alɨngile naɨnɨkendakɨɨla mʉnyʉmba yɨhi niya kʉtankanɨla Ayahudi kʉaamba nʉ kʉatunga mʉkadulumu nʉ kʉakʉa awa naɨakʉhʉɨɨe. <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" />Nɨ kɨna mitʉmi nʉwako ʉ Sitepwano naɨ ʉkʉbʉlagwa ʉnene aɨnkolɨ papo, nɨkagomba ntendo nanso kʉnʉ nɨze mambɨɨe ɨngʉo a antʉ naɨakʉmʉbʉlaga.’ <verse eid="ACT 22:20" /><verse number="21" style="v" sid="ACT 22:21" />Papo Isekʉlʉ wɨkambɨla, ‘Longola, kʉnsoko nɨkakʉlagɨɨlya kʉlɨ, kʉantʉ nɨshanga Ayahudi.”’<verse eid="ACT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />Kʉpikɨɨla apa milʉndo nʉwa antʉ aɨamʉtegeeye ʉ Paʉlo, ingɨ naɨʉtambʉe ʉdu nkani izi, papo ɨkandya kitʉnta azelʉnga, “Mʉheje mihɨɨ! Mʉbʉlagi! Mʉntʉ ʉyʉ nʉwa itɨ shanga ʉtakɨwe kishiɨ!” <verse eid="ACT 22:22" /><verse number="23" style="v" sid="ACT 22:23" />Naɨakɨlɨ akitʉnta nʉ kʉpununta ngʉoao kʉnʉ azekunkʉla ʉlʉnkʉndɨ. <verse eid="ACT 22:23" /><verse number="24" style="v" sid="ACT 22:24" />Mankata nʉwanso nʉwa anyambita wɨkalagɨɨlya ʉ Paʉlo wingɨligwe mʉnkambɨ a anyambita, wɨkaaɨla kɨna amʉkʉe mɨsheleti ahume kʉlɨnga nɨkɨ antʉ azogooye itɨ. <verse eid="ACT 22:24" /><verse number="25" style="v" sid="ACT 22:25" />Ingɨ naɨakondya kʉmʉtunga ɨmɨkoha ahume kʉmʉkʉa mɨsheleti, Paʉlo wɨkamʉkolya mʉtongeeli nʉidale nɨla anyambita naɨwimɨkile pakupɨ nʉ ng'wenso, “Itɨɨ, igombigwene mʉmalagɨɨlyo kʉmʉkʉa mʉntʉ nɨ mʉnya kʉ Lumi ize wakɨlɨ kʉpɨsɨɨligwa igazo lakwe?”<verse eid="ACT 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26" />Mʉtongeeli ʉyʉ nʉwiumbɨ nɨla anyambita naɨ wija inkani izi, wɨkamʉhanga ʉ mankata nʉkʉmʉɨla, “Ʉkʉhiya kʉtenda ʉlɨ? Kʉnsoko mʉntʉ ʉyʉ ingɨ mʉnya kʉ Lumi.”<verse eid="ACT 22:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27" />Itɨgwa mankata ʉyʉ wɨkamhʉanga ʉ Paʉlo wɨkamʉkolya, “Mbɨle, ʉewe wɨmʉnya kʉ Lumi?”</para>
  <para style="p" vid="ACT 22:27">Paʉlo wɨkasʉkɨɨlya, “Ee! Ʉnene nɨ mʉnya kʉ Lumi.”<verse eid="ACT 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 22:28" />Papo mankata nʉwanso wɨkalʉnga, “Ʉnene ntʉmɨe mpia yɨdʉ kʉʉgʉla ʉ Lumi wane.”</para>
  <para style="p" vid="ACT 22:28">Paʉlo wɨkalʉnga “Ʉnene ingɨ nɨ mʉ Lumi kʉʉtugwa.”<verse eid="ACT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 22:29" />Papo antʉ awa naɨihambaa kʉmʉkolenkeelya ʉ Paʉlo ɨkalimɨla. Mankata nʉyo wɨkogopa, naɨwalɨnga kɨna amʉtungile ʉ Paʉlo kʉ minyololo, mʉ Lumi kʉʉtugwa.<verse eid="ACT 22:29" /></para>
  <para style="s">Paʉlo ʉkʉtalwa pianza nikʉlʉ nɨla Ayahudi</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />Mʉdaʉao, mankata wɨkalowa kʉlɨnga ikʉlʉ kʉʉlʉ nɨkɨ ʉ Paʉlo ʉsemewe nɨ Ayahudi, wɨkamʉtungʉɨla nʉkʉlagɨɨlya apolyi nɨakʉlʉ nianza nɨla anyampala atankane. Sʉnga wɨkamʉleta ʉ Paʉlo wɨkamimɨsha pɨanza nɨla anyampala.<verse eid="ACT 22:30" /></para>
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />Paʉlo wɨkaagozeela ɨanyianza, wɨkalʉnga, “Anyandʉgʉ ane, ʉnene nituma mʉlɨmo wang'wi Itunda kʉ nkolo nza sambʉnʉyʉ.” <verse eid="ACT 23:1" /><verse number="2" style="v" sid="ACT 23:2" />Kʉnsoko ikani ɨlɨ Mʉpolyi nʉ Mkʉlʉ ʉ Anania wikaalagɨɨlya antʉ naɨakolɨ pakupɨ nʉ Paʉlo amʉkʉɨlye ʉmʉlomo. <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" />Papo Paʉlo wɨkamʉɨla, “Itunda ʉkʉʉkʉa nʉewe nʉwɨhangaa ikiligo nɨlɨdobigwe nswakaala! Kʉnsoko ʉewe wɨmʉteele wikiɨ pang'wanso ʉhume kʉlamʉla kʉtyata malagɨɨlyo ang'wa Musa, kʉnʉ ʉewe ʉmahitile ɨmalagɨɨlyo nanso ʉkʉlagɨɨlya ʉnene nkʉwe nsuta nɨmalagɨɨlyo nalʉngile.”<verse eid="ACT 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4" />Antʉ awo naɨimikile pakupɨ ɨkamʉɨla ʉ Paʉlo, “Itɨɨ, nɨkɨ ʉewe ʉkʉmʉtʉkɨla Mʉpolyi nʉ Mʉkʉlʉ nʉang'wi Itunda?”<verse eid="ACT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 23:5" />Paʉlo wikaasʉkɨɨlya, “Anyandʉgʉ ane, shanga aza nɨngile kɨna ʉyʉ ingɨ Mʉpolyi Mʉkʉlʉ nʉang'wi Itunda. Kʉnsoko yandɨkilwe, ‘Leka kʉmʉtambʉla ibɨ nʉatongeeli nʉwa antʉ ako.’”<verse eid="ACT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6" />Paʉlo naɨwaalɨnga kɨna nɨang'wɨ ingɨ Asadukayo nɨaʉya Apalisayo, wɨkitʉnta wɨkalʉnga, “Anyandʉgʉ ane, ʉnene nɨ Palisayo, ng'waa Palisayo. Ʉnene nsemewe kʉnsoko nihʉɨɨe kɨna ɨashi akiʉka.”<verse eid="ACT 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 23:7" />Paʉlo naɨwatambʉla inkani izi, wilei wɨkandya kʉ Apalisayo nɨ Asadukayo ianza lɨhi lɨkatemanʉka maumbɨ abɨɨlɨ. <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" />Naɨkɨsakilye atemanʉke aɨsɨkɨ Asadukayo ahʉɨɨe kɨna kʉtilɨ ʉwiʉki, hangɨ kɨna kʉtilɨ anga a Malaɨka ang'wi ng'wahʉ, ingɨ Apalisayo ahʉɨɨe aya ɨhi nataatʉ. <verse eid="ACT 23:8" /><verse number="9" style="v" sid="ACT 23:9" />Yɨkatula nʉ minyomo ʉkʉlʉ, amanyisi a malagɨɨlyo ang'wa Musa nɨ iumbɨ nɨla Apalisayo, ɨkimɨka nʉkamdya kikʉngʉma kʉngulu azelʉnga, “Shanga kʉʉona anga igazo lɨhi kʉ mʉntʉ ʉyʉ. Ihuɨkile kʉtula ng'wahʉ ang'wi Malaɨka witambʉʉye nʉmʉntʉ ʉyʉ!”<verse eid="ACT 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 23:10" />Minyomo wɨkatula ʉkʉlʉ kʉpikɨɨla mankata nʉanso nʉwa anyambita wɨkogopa kɨna ahumile kʉmʉgalanʉla ʉ Paʉlo mapande abɨɨlɨ, wɨkalagɨɨlya iumbɨ nɨla anyambita amʉheja kʉngulu ʉ Paʉlo pa katɨao akʉmʉsʉkɨlye mʉnkambi a anyambita.<verse eid="ACT 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11" />Ʉtikʉ naɨʉtyatile Isekʉlʉ wɨkimɨka pakupɨ nʉ Paʉlo wɨkamʉɨla, “Komya ɨnkolo! Anga naza ʉatambʉe antʉ inkani yane apa pa Yelʉsalemu, ʉtakɨwe kʉatambʉɨla antʉ a kʉnʉ kʉ Lumi.”<verse eid="ACT 23:11" /></para>
  <para style="s">Ayahudi akʉduma nzɨla akʉmʉbʉlaga ʉ Paʉlo</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />Naɨwela Ayahudi ɨkipema nʉkʉlapa kɨna, shanga akʉlya ang'wɨ kʉng'wa kʉpikɨɨla amʉbʉlage ʉ Paʉlo. <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />Antʉ naɨipemile ikani nɨlanso aɨakɨlɨnkɨɨe makʉmi annɨ. <verse eid="ACT 23:13" /><verse number="14" style="v" sid="ACT 23:14" />Sʉnga ɨkaahanga atongeli a apolyi nɨ anyampala nʉ kʉlʉnga, “Ʉsese kɨhi kipemile nʉkʉlapa kɨna shanga kʉʉlya ang'wɨ kʉng'wa kʉpikɨɨla kʉmʉbʉlage ʉ Paʉlo. <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />Kʉlʉlo, ʉnyenye palʉng'wɨ nianza nɨla anyampala, mʉtakɨwe mʉmʉɨle ʉ mankata wamʉlete ʉ Paʉlo, mitendise kɨna mʉkʉhiya mʉkolenkeelye kɨsa inkani yakwe. Ʉsese kihambile kʉmʉbʉlagɨla mʉnzɨla ɨze wakɨlɨ kʉpika apaitɨ.”<verse eid="ACT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16" />Ingɨ mipwa wang'wa Paʉlo naɨwija itegete ɨlɨ, wɨkalongola mitando nɨla anyambita nʉkʉnʉɨla ʉ Paʉlo itegete nɨlanso. <verse eid="ACT 23:16" /><verse number="17" style="v" sid="ACT 23:17" />Papo ʉ Paʉlo wɨkamitanga ʉng'wɨ nʉwa akʉlʉ iumbɨ nɨla anyambita wɨkamʉɨla, “Mʉtale ʉmʉhʉmba ʉyʉ kʉng'wa mankata nʉwa anyambita, ʉkete lʉkani nʉlakʉmʉɨla.” <verse eid="ACT 23:17" /><verse number="18" style="v" sid="ACT 23:18" />Kʉlʉlo mʉtongeeli ʉyʉ nʉwiʉmbɨ nɨla anyambita wɨkamʉtala ʉmʉhʉmba ʉyʉ kʉng'wa mankata nʉwa anyambita wɨkamʉɨla, “Paʉlo, mʉtungwa ʉyo azaʉnintangile wambɨla nʉmʉlete ʉmʉhʉmba ʉyʉ kʉng'wako, kʉnsoko ʉkete lʉkani nʉlakʉʉtambʉɨla.”<verse eid="ACT 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19" />Mankata nʉwa anyambita wɨkamʉamba mʉkono ʉmʉhʉmba ʉyʉ, wɨkamʉtala kɨmpelo nʉ kʉmʉkolya, “Ʉloilwe kʉmbɨla ʉlɨ?”<verse eid="ACT 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20" />Mʉhʉmba ʉyʉ wɨkalʉnga, “Ayahudi ipemile kɨna, mʉdaʉ akʉlompe ʉmʉtale ʉ Paʉlo kianza nikʉlʉ azedaya kɨna akʉhiya amʉkolenkeelye ikʉlʉ kʉʉlʉ ankani yakwe. <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />Ingɨ ʉewe ʉleke kʉpeng'wa nɨ antʉ awa kʉnsoko akolɨ antʉ akɨlɨnkɨɨe makʉmi annɨ amʉtungɨe mʉnzɨla. Antʉ awa ilapɨe kɨna shanga akʉlya ang'wɨ kʉng'wa kʉpikɨɨla amʉbʉlage ʉ Paʉlo. Itungo ɨlɨ akolɨ ihambile, alindɨɨe ʉagombye ilompi lao.”<verse eid="ACT 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22" />Mankata nʉwanso nʉwa anyambita wɨkamʉhʉgʉlya ʉmʉhʉmba nʉwanso, wazemʉɨla, “Ʉleke kʉmʉɨla mʉntʉ wɨhi kɨna wanganʉɨla inkani izi nʉyo wɨkamʉleka walongole.”<verse eid="ACT 23:22" /></para>
  <para style="s">Paʉlo ʉkʉhamɨligwa kʉ Kaisalia</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23" />Sʉnga mankata nʉwanso nʉwa anyambita wɨkaitanga akʉlʉ amaumbɨ abɨɨlɨ nɨa anyambita wɨkaaɨla, “Noneelyi anyambita magana abɨɨlɨ alongolya mpalasi nɨ antʉ sabini nɨ antʉ nɨakete ndɨlɨma magana abɨɨlɨ. Aɨle ihambe mʉkʉhega saa tatʉ ʉtikʉ ʉwʉ mʉlongole kʉ Kaisali. <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />Noneelyi nimpalasi kɨtʉʉnga nɨyʉkʉtʉmɨlwa nʉ Paʉlo, mʉmʉpishe kʉ mʉtemi Pelikisi waze mʉpanga.” <verse eid="ACT 23:24" /><verse number="25" style="v" sid="ACT 23:25" />Sʉnga ʉ mankata nʉwa anyambita wɨkamʉandikila ʉ Pelikisi balʉa nɨ lɨlɨɨye itɨ:<verse eid="ACT 23:25" /></para>
  <para style="pi">
    <verse number="26" style="v" sid="ACT 23:26" />Ʉnene nɨ Kilaudio Lisia, kʉʉandɨkɨla ʉewe Mʉtemi Pelikisi, ingɨ kʉʉlamʉsha ʉdu. <verse eid="ACT 23:26" /><verse number="27" style="v" sid="ACT 23:27" />Ayahudi aɨamʉambile ʉ mʉntʉ ʉyʉ alamʉla kʉmʉbʉlaga, ingɨ ʉnene naɨnigulye kɨna mʉntʉ ʉyʉ mʉnya kʉ Lumi, itɨ gwa ʉnene nahola antʉ ane nenda namʉgunɨɨlya. <verse eid="ACT 23:27" /><verse number="28" style="v" sid="ACT 23:28" />Nɨkalowa kʉlɨnga nɨkɨ amʉsemee, kʉlʉlo nɨkamʉtala pianza lao nikʉlʉ. <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />Papo nɨkalɨnga kɨna amʉsemee kʉnsoko ankʉngumi mʉ makani amalagɨɨlyoao, ingɨ shanga ʉsemewe ki ikani lɨhi nɨlakʉsasha wabʉlagwe ang'wi kʉtungwa mʉkadulumu. <verse eid="ACT 23:29" /><verse number="30" style="v" sid="ACT 23:30" />Naɨmpikɨigwe kɨna Ayahudi ipemile kʉmʉbʉlaga ʉ mʉntʉ ʉyʉ, nalamʉla nʉmʉlete kʉng'wako, nɨalagɨɨye nɨasemi akwe ilongoole kʉng'wako ɨkɨ nɨamʉsemelee.”<verse eid="ACT 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31" />Itɨ gwa anyambita nɨanso ɨkamʉhola ʉ Paʉlo anga nɨalagɨigwe, ʉtikʉ wʉwo ikamʉtala kʉ kɨsalɨ ka Antipatili. <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />Mʉdaʉao anyambita naɨalongoe na mɨgʉlʉ ɨkatulya mʉnkambɨ a anyambita, ɨkaaleka anyambita nɨɨnankɨla mpalasi nʉ Paʉlo alongoleke nʉ mʉhɨnzo. <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />Anyambita nɨanso nɨanankɨla mpalasi naɨapika kʉ Kaisali ɨkamʉpa ʉ Mʉtemi balʉa, ɨkamʉleka ʉ Paʉlo mʉwɨmɨɨli nʉwa Mʉtemi. <verse eid="ACT 23:33" /><verse number="34" style="v" sid="ACT 23:34" />Mʉtemi Pelikisi naɨwakondya kʉlɨsoma balʉa wɨkamʉkolya ʉ Paʉlo ʉewe wɨapɨ. Naɨwalɨngasigwa kɨna ʉpembeeye kʉ Kilikia, <verse eid="ACT 23:34" /><verse number="35" style="v" sid="ACT 23:35" />mʉtemi wɨkalʉnga, “Anga apike ɨantʉ nɨakʉsemee kʉtegeelya ʉsemelwa nʉwako.” Sʉnga wɨkalagɨɨlya ʉ Paʉlo waɨkwe mʉʉkendegeeli mizʉmba nɨla kɨtemi nɨlang'wa Helode.<verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="s">Ayahudi akʉmʉsemela ʉ Paʉlo</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />Naɨakila mahikʉ ataano, Mʉkʉlʉ nʉwa Apolyi ʉ Anania wɨkapika kʉ Kaisalia palʉng'wɨ nɨanyampala ang'wɨ azeityatile nʉ mʉntʉ ʉng'wɨ mʉlɨngi nʉwa malagɨɨlyo ang'wa Musa witangwa Telitulo. Ɨkamʉsemela Paʉlo kʉ Mʉkʉlʉ nʉwanso. <verse eid="ACT 24:1" /><verse number="2" style="v" sid="ACT 24:2" />Paʉlo naɨwitangwa wingɨle mʉnyʉmba, Telitulo wɨkandya kʉmʉsemela ʉ Paʉlo wazelʉnga,</para>
  <para style="p" vid="ACT 24:2">“Mʉkʉlʉ Pelikisi, mahikʉ ɨdʉ iza kiloile kʉnsoko matiliga nʉwigombya nʉʉza nʉkolɨ mʉantʉ kʉnsoko amasɨgo ako nɨmaza nɨɨza ʉkete nʉkʉtenda mihɨɨ itʉ. <verse eid="ACT 24:2" /><verse number="3" style="v" sid="ACT 24:3" />Matungo ɨhɨ nɨ nkɨka yɨhi kʉsɨngɨɨye makanɨ aya ɨhi kʉʉlowa nʉ kʉʉlʉmbɨɨlya ʉewe Mʉkʉlʉ Pelikisi. <verse eid="ACT 24:3" /><verse number="4" style="v" sid="ACT 24:4" />Ingɨ ndeke kʉʉkatalya, kʉʉkende nʉwako kʉʉlompa ʉkʉtegeelye iniino. <verse eid="ACT 24:4" /><verse number="5" style="v" sid="ACT 24:5" />Kaona kɨna mʉntʉ ʉyʉ mʉsʉmbʉli, ʉkʉkinyɨla minyomo kʉ Ayahudi ang'wɨ mihɨɨ ɨhi. Ʉyʉ ingɨ mʉtongeeli midale nɨla Anazaleti. <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />Hangɨ aɨʉgemile kʉtenda makani nɨshanga atakɨwe pa Nyʉmba ang'wi Itunda, ingɨ kɨkamʉamba kɨkalowa kʉmʉlamʉla kʉtyata malagɨɨlyo itʉ. <verse eid="ACT 24:6" /><verse number="7" style="v" sid="ACT 24:7" />Ingɨ mankata ʉ Lisia, wɨkingɨɨla nʉkʉmʉheja kʉ ngulu, <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />sʉnga walagɨɨlya antʉ nɨamʉsemee aze kʉng'wako. Anga ʉmʉkolenkeelye ʉewe ʉmʉntʉ ʉkʉlɨnga makani ɨhi ayo nɨkʉmʉsemee.” <verse eid="ACT 24:8" /><verse number="9" style="v" sid="ACT 24:9" />Ayahudi ɨkihanja ɨkakʉɨɨla nʉkʉlʉnga kɨna makani aya nʉsemewe ʉ Paʉlo ingɨ tai.<verse eid="ACT 24:9" /></para>
  <para style="s">Paʉlo ʉkilongola pang'wa Pelikisi</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />Sʉnga Mʉkʉlʉ Pelikisi wɨkamʉpa kɨlɨngasɨɨlyo ʉ Paʉlo wilongole, Paʉlo nʉyo wɨkasʉkɨɨlya,</para>
  <para style="p" vid="ACT 24:10">“Nɨngile kɨna ʉewe waile wɨmʉlamʉli mihɨɨ ɨyɨ kʉ myaka ɨdʉ, kʉlʉlo kilongola kʉʉlowa ʉkʉlʉ pang'wako. <verse eid="ACT 24:10" /><verse number="11" style="v" sid="ACT 24:11" />Ʉhumile kʉlɨnga iza kɨna akɨlɨ kʉkɨla mahikʉ ikʉmi na abɨɨlɨ kʉpuma nɨnendela kʉ Yelusalemu kipolya. <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />Antʉ awa nɨakʉnsemela shanga aza anihangɨle kikʉngʉma nʉ mʉntʉ wɨhi pa Nyʉmba ang'wi Itunda, ang'wɨ kʉkinyɨla maumbɨ a antʉ mʉnyʉmba niya kʉtankanɨla Ayahudi, ang'wɨ pɨhi mʉkɨsalɨ nɨkanso. <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />Hangɨ shanga ahumile kʉʉɨla ɨtai a makani aya nɨakʉnsemela. <verse eid="ACT 24:13" /><verse number="14" style="v" sid="ACT 24:14" />Ingɨ, ngombile kɨna ʉnene nɨmʉkʉlya Itunda nʉwa atata itʉ, nɨshiɨ kʉtyata Nzɨla ɨyo nɨanso nɨɨmitanga aʉmanyisi waʉteele. Nihʉɨɨe makani ɨhi naandɨkilwe mʉmbugulu niya malagɨɨlyo nɨ amanga. <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />Ʉnene nkete isʉmbɨɨlyo anga nɨakete nɨanso, kɨna antʉ nɨakende nawa nɨabɨɨ akiʉka. <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />Kʉlʉlo mahikʉ ɨhi nkagupile kʉtula nɨnkolo nza kʉng'wi Itunda nʉ kʉ antʉ.<verse eid="ACT 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17" />“Itɨ gwa, myaka ɨdʉ akɨla ʉnene aɨnkolɨ kʉlɨ, nɨkatulya kʉ Yelusalemu nɨzeleta ʉaɨɨlya kʉ ahimbɨ nʉ kʉpumya isongelyo kʉng'wi Itunda. <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />Naza niɨkile iza ngombeke kʉmʉkʉlya Itunda, papo aza anihangɨle pa Nyʉmba ang'wi Itunda. Aza kʉtilɨ anga iumbɨ nɨla antʉ palʉng'wɨ nʉnene, hangɨ shanga azakinyɨe anga antʉ kʉsasha minyomo. <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />Ingɨ akolɨ Ayahudi ang'wɨ kʉpuma kʉ Asia, nɨanso wawo atakɨwe kʉza kʉng'wako ansemele anga ɨzelɨkolɨ ikani lɨhi nibɨ nɨnitʉmile, <verse eid="ACT 24:19" /><verse number="20" style="v" sid="ACT 24:20" />ang'wɨ antʉ awa nɨakolɨ apaitɨ atambule igazo nazaaine apo nazanimɨkile ntongeela ianza nikʉlʉ, <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" />ingɨ ntambʉe ikani lɨng'wɨ duu pa ntongeelaao, ‘Ʉnene kʉnsemelwa kʉnsoko nihʉɨɨe kɨna ashi akiʉkigwa.”’<verse eid="ACT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />Papo Mʉkʉlʉ ʉ Pelikisi naɨʉmɨlɨngile iza ɨ Nzɨla nanso, wɨkadɨlya kʉtegeelya ʉsemelwa wang'wa Paʉlo wazelʉnga, “Mankata Lisia nʉʉkʉhulumʉka kʉza kʉnʉ, papo kʉʉlamʉla ʉsemelwa ʉwʉ.” <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />Papo wɨkalagɨɨlya mʉkʉlʉ wiumbɨ nɨla anyambita wamʉsʉnje iza ingɨ aze wagombigwe kutenda makani akwe nɨ ahʉmbaʉya aleke kʉgiligwa azemʉaɨɨlya.<verse eid="ACT 24:23" /></para>
  <para style="s">Pelikisi nʉ Dulusila akʉtegeelya ʉsemelwa wang'wa Paʉlo</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24" />Naɨakila mahikʉ kɨtʉʉnga Pelikisi wɨkapika azeakʉɨe nʉ mʉsʉngʉ wakwe ʉ Dulusila, mʉsʉngʉ ʉyʉ aɨ Mʉyahudi. Wɨkalagɨɨlya witangɨligwe ʉ Paʉlo, wɨkamʉtegeelya wazetambʉla ndogoelyo akʉmʉhʉɨɨla ʉ Yesʉ Kilisito. <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />Ingɨ ʉ Paʉlo naɨʉkʉtambʉla mpola niya ɨtai ane, ɨkepyi hangɨ nʉkʉ mpola niya kʉʉlamʉli nʉʉzile, Pelikisi wɨkogopa wɨkalʉnga, “Geela papo. Ʉhumile kʉhega. Anga ndije lyoma kʉitanga.” <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />Itungo lɨlo lɨɨlo Pelikisi aɨʉsʉmbɨɨye kɨna ʉ Paʉlo wɨkamʉpa nkumba mʉlomo wamʉlekele. Itɨ gwa wɨkatula sʉkɨnkania kʉmitanga itambʉlye.<verse eid="ACT 24:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 24:27" />Naɨakɨla myaka ɨbɨɨlɨ, Polikio Pesito wɨkatema palyoma lang'wa Pelikisi, kʉnsoko Pelikisi aɨʉkʉhiya kʉaloeelya ɨ Ayahudi, wɨkamʉleka ʉ Paʉlo mʉkadulumu.<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="s">Paʉlo ʉkʉlompa Mʉtemi nʉmʉkʉlʉ nʉwakʉ Lumi wategelye ʉsemelwa wakwe</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />Naɨakɨla mahikʉ ataatʉ ʉ Pesito nʉwazɨla kʉ Kaisalia kandya kʉtema, wɨkahega kʉ Kaisalia nʉkenda kʉ Yelusalemu, <verse eid="ACT 25:1" /><verse number="2" style="v" sid="ACT 25:2" />kʉng'wanso apolyi nɨ akʉlʉ nɨ atongeeli a Ayahudi ɨkapika kʉmʉsemela ʉ Paʉlo. <verse eid="ACT 25:2" /><verse number="3" style="v" sid="ACT 25:3" />Ɨkaminena ʉ Pesito, waatendeele mʉaloewe, walagɨlye ʉ Paʉlo wahamɨligwe kʉ Yelusalemu, kʉnsoko aɨihambile kʉmʉtungɨla amʉbʉlagɨle mʉnzɨla. <verse eid="ACT 25:3" /><verse number="4" style="v" sid="ACT 25:4" />Pesito wɨkasʉkɨɨlya, “Paʉlo ʉgiɨigwe mʉkadulumu kʉ Kaisalia, nʉnene shanga kalɨ ninzʉ kʉko. <verse eid="ACT 25:4" /><verse number="5" style="v" sid="ACT 25:5" />Aleki atongeeli ang'wɨ ityate nʉnene ende amʉsemela ʉ mʉntʉ ʉyʉ kʉko, kɨna ʉgazilye kɨntʉ kɨhi.” <verse eid="ACT 25:5" /><verse number="6" style="v" sid="ACT 25:6" />Pesito wɨkikalania nɨenso itungo lamahikʉ mʉnana ang'wɨ ikʉmi, wɨkatulya kʉ Kaisalia, lʉhikʉ naɨlʉtyatile wɨkitangisa ianza, wikikiɨ mituntu nɨla ʉlamʉli, wɨkalagɨɨlya ʉ Paʉlo waletwe pa ng'waakwe. <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />Paʉlo naɨwapika, Ayahudi awo naɨapembeeye kʉ Yelusalemu ɨkimɨka aze amʉpilimɨkɨɨye, ɨkandya kʉmʉsemela ʉ Paʉlo kʉ makani ɨdʉ nɨmabɨ kʉnʉ azeleng'wa kʉtambʉla tai. <verse eid="ACT 25:7" /><verse number="8" style="v" sid="ACT 25:8" />Ingɨ ʉ Paʉlo wɨkilongola, wɨkalʉnga, “Ʉnene shanga nitʉmile igazo lɨhi nsuta nɨ Malagɨɨlyo a Ayahudi ang'wɨ Nyʉmba ang'wɨ Itunda ang'wɨ nsuta nʉ ʉmanyisigwa nʉwa Alumi.”<verse eid="ACT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9" />Ingɨ Pesito, wɨkahiya kʉaloeelya ɨ Ayahudi, wɨkamʉkolya ʉ Paʉlo, “Itɨɨ, ʉkʉlowane kʉlongola kʉ Yelusalemu nende ntegeelelye ʉsemelwa wako kʉko?”<verse eid="ACT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 25:10" />Paʉlo wɨkasʉkɨɨlya, “Itungo ɨlɨ ʉnene nimɨkile pa ntongeela ianza lang'wa Kaisali, papa ntakɨwe kʉsemelwa. Anga ʉewe nʉlɨgile iza kɨna ʉnene shanga nɨatendee igazo lɨhi ɨ Ayahudi. <verse eid="ACT 25:10" /><verse number="11" style="v" sid="ACT 25:11" />Ingɨ anga ɨze nkete igazo lɨhi nɨlɨkʉsasha mbʉlagwe, shanga nihitile kʉsha. Ingɨ anga ize ʉsemelwa nɨnsemewe nɨ Ayahudi awa shanga watai, kʉtilɨ mʉntʉ wɨhi nʉhumile kʉntala ʉnene kʉng'wao. Kʉlompa ntalwe kʉng'wa Kaisali.”<verse eid="ACT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12" />Pesito naɨwakondya kitambʉlya nɨ ahemba akwe, wɨkamʉɨla ʉ Paʉlo, “Ʉewe walowa ʉsemelwa wako ʉkɨligwe kʉng'wa Kaisali, ʉzaʉ kʉng'wa Kaisali winzʉ.”<verse eid="ACT 25:12" /></para>
  <para style="s">Agilipa ʉkʉpikɨligwa ʉsemeelwa wang'wa Paʉlo</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />Naɨakɨla mahikʉ kɨtʉʉnga Mʉtemi Agilipa nʉ Belinike ɨkapika kʉ Kaisalia kʉmʉsɨngɨɨlya ʉ Pesito kʉtula mʉtemi nʉmʉpya. <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />Ɨkadʉa mahikʉ kɨtʉnga kʉ Kaisalia, Pesito ɨkisɨja nʉ mʉtemi ʉsemelwa wang'wa Paʉlo, wazelʉnga, “Ʉkolɨ mʉntʉ ʉng'wɨ nʉ Pelikisi naiʉmʉlekile mʉkadulumu. <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />Naɨnendile kʉ Yelʉsalemu, apolyi nɨakʉlʉ nɨatongeeli a Ayahudi aɨanihangɨle nʉkʉmbɨla namʉle kɨna ʉkete igazo. <verse eid="ACT 25:15" /><verse number="16" style="v" sid="ACT 25:16" />Ingɨ ʉnene nikaaɨla kɨna shanga ntendo a Kɨlumi mʉntʉ walamʉlwe waze wakɨlɨ kikʉngʉma nao nɨamʉsemee akwe, ʉtakɨwe wapegwe lyoma nɨla kilongola kʉ ʉsemelwa nʉsemewe. <verse eid="ACT 25:16" /><verse number="17" style="v" sid="ACT 25:17" />Itɨ naza apikile apaitɨ palʉng'wɨ nʉnene, shanga natinia, mʉdaʉao nitangisa ianza, nɨkalagɨɨlya mʉntʉ nʉwanso waletwe. <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />Antʉ naɨamʉsemee ɨkimɨka, shanga ɨkamʉsemela kigazo lɨhi naɨnsɨgɨɨe. <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />Ingi ɨkatulikʉngʉma nʉ Paʉlo kʉmakani amapolyoao nɨmakani amʉntʉ ʉng'wɨ nʉwitangwa Yesʉ, naɨ ʉkule, ingɨ ʉ Paʉlo wɨzʉhʉɨɨe kɨna mʉpanga. <verse eid="ACT 25:19" /><verse number="20" style="v" sid="ACT 25:20" />Kʉnsoko shanga aɨnɨngile kʉmʉkolenkeelya ʉlɨ ikani ɨlɨ, nɨkamʉkolya anga ize ʉloilwe kenda kʉ Yelusalemu wahume kʉkolenkeeligwe iza kʉ ʉsemelwa ʉwʉ. <verse eid="ACT 25:20" /><verse number="21" style="v" sid="ACT 25:21" />Ingɨ ʉ Paʉlo wɨkalowa walamʉlwe nʉ Agusito Mʉtemi nʉmʉkʉlʉ nʉwa kʉ Lumi, kʉlʉlo nɨkalagɨɨlya amʉsʉnje kʉpikɨɨla ninzɨzamʉtala kʉng'wa Kaisali.”<verse eid="ACT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22" />Papo Agilipa wɨkamʉɨla ʉ Pesito, “Ʉnene ndoilwe kʉmʉtegeelya ʉ mʉntʉ nʉwanso.”</para>
  <para style="p" vid="ACT 25:22">Pesito wɨkasʉkɨɨlya, “Ʉkʉmʉtegeelya mʉdaʉ.”<verse eid="ACT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />Lʉhikʉ naɨlʉtyatile ʉ Agilipa nʉ Belinike ɨkapika azi tetembwa, ɨkingɨla mʉ kɨanda kianza, palʉng'wɨ nɨ amankata a anyambita nɨ akʉlʉ ihɨ nɨasanigwe. Papo Pesito wɨkalagɨɨlya ʉ Paʉlo waletwa mʉkatɨ. <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />Pesito wɨkalʉnga, “Mʉtemi Agilipa, nʉ nyenye mɨhi nɨmʉkolɨ apa palʉng'wɨ nʉsese, mamʉonane ʉ mʉntʉ ʉyʉ. Ayahudi ɨhi akʉmʉsosha ʉ mʉntʉ ʉyʉ kʉpumɨɨla kʉ Yelusalemu napa pa Kaisalia, azogooye kɨna shanga ʉtakɨwe walongoleke kishiɨ. <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />Ingɨ ʉnene shanga namʉonelya igazo lɨhi nɨlɨkʉmʉsasha wabʉlagwe, ingɨ kʉnsoko ng'wenso aɨʉloilwe Mʉtemi nʉmʉkʉlʉ wategeelye, ʉsemelwa wakwe nʉnene nalamʉla kʉmʉtala kʉ Lumi. <verse eid="ACT 25:25" /><verse number="26" style="v" sid="ACT 25:26" />Ingɨ ʉnene nɨmʉgila kɨntʉ nɨkakʉmʉandɨkɨla ʉ mʉkʉligwa Mʉtemi nʉ mʉkʉlʉ nʉwa kʉ Lumi. Kʉlʉlo namʉleta pa ntongeela anyu mɨhi nɨ pa ntongeela ako Mʉtemi Agilipa, ingɨ anga mʉmʉkolenkeelye, nihume kʉlija kɨntʉ nɨkakʉandɨka. <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />Kʉnsoko naona shanga ikaniiza kʉmʉtala mʉtungwa kʉ Mʉtemi nʉmʉkʉlʉ nʉwa kʉ Lumi ize shanga nʉmʉoneeye anga igazo.”<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="s">Paʉlo ʉkilongola pang'wa Mʉtemi Agilipa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />Agilipa wɨkamʉɨla ʉ Paʉlo, “Wagombigwa kilongola.” Kʉlʉlo ʉ Paʉlo wɨkaahʉmbʉɨla ʉmʉkono amʉtegeelye, wɨkandya kilongola, wɨkalʉnga.<verse eid="ACT 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 26:2" />“Mʉtemi Agilipa, kʉona lyoa lane ɨlelɨyɨ kimɨka pang'wako nilongole ʉsemelwa wane wɨhi nɨansemee Ayahudi, <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />kʉlʉ kʉʉlʉ ingɨ kʉnsoko ʉewe ʉlingɨle ɨtai ntendo yɨhi niya Ayahudi ni nkani niya wikʉngʉmi. Kʉlʉlo, kʉʉlompa gimya ʉntegeleke.<verse eid="ACT 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4" />“Ayahudi ɨhi alɨngile likalo lane naɨnishiɨ kʉpuma ʉʉng'enya wane, kandɨɨlya ʉng'wandyo nʉwa likalo lane kihɨɨ ane nʉko kʉ Yelusalemu. <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" />Anɨngile kitungo ɨlɨpu, hangɨ ahumile kʉnkʉɨɨla nanso anga alowe, kɨna puma ɨkalɨ aɨnkolɨ miumbɨ nɨla Apalisayo nɨnkomanɨɨye malagɨɨlyo adini itʉ na Kɨyahudi, kʉkɨla maumbɨ nɨmangɨza ɨhi. <verse eid="ACT 26:5" /><verse number="6" style="v" sid="ACT 26:6" />Ʉnene itungo ɨlɨ nsemewe apaitɨ kʉnsoko isʉmbɨɨlyo nɨnkete kʉ ɨko Itunda naɨʉalapɨe Atata itʉ. <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />Ɨlɨ lɨlɨ ilago nindʉgʉ yitu ikʉmi na ɨbɨɨlɨ nɨasʉmbɨɨye kʉona lɨkʉkondanɨɨligwa, nɨenso akʉmitʉmɨla Itunda kʉ ngulu yɨhi ʉtikʉ nʉ ng'ʉng'wɨ. Ʉewe Mʉtemi Ayahudi akʉnsemela kʉnsoko isʉmbɨɨlyo lɨlo! <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />Kʉnɨkɨ mʉntʉ wɨhi mʉng'wanyu wasɨge kɨna ikaku Itunda kiʉsha ɨashi?<verse eid="ACT 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9" />“Nʉnene ga ɨkalɨ aɨnihʉɨɨe kɨna ntakɨwe kitʉma kɨntʉ kɨhi nɨkɨhumile kʉlikʉngʉmya ɨ lina lang'wa Yesʉ nʉwa kʉ Nazareti. <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />Makani nanso ʉnene aɨnitʉmile ʉko kʉ Yelusalemu. Kʉʉhumi nʉwa a Apolyi nɨ akʉlʉ, aɨnɨatungile mʉkadulumu ahʉɨɨli ang'wa Yesʉ ɨdʉ nɨ ang'wi Itunda. Napa naɨakʉbʉlagwa, ʉnene aɨnɨkʉa bʉnkʉlʉbʉnkʉlʉ ngombe ahume kʉbʉlagwa. <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />Nkʉa yɨdʉ aɨnenda mʉnyʉmba yao niya kʉtankanɨla Ayahudi nɨzeaja, ʉnene aɨnɨgema kʉasinja alɨbehʉle ɨ lina lang'wa Yesʉ. Aɨnɨatakɨɨla anga ʉmʉhali, aɨnɨlongola ga nʉ mʉisalɨ niya mahɨɨ mangɨza nʉkʉaja.<verse eid="ACT 26:11" /></para>
  <para style="s">Paʉlo ʉkʉganʉla naɨʉgunɨkile</para>
  <para style="r">
    <ref loc="ACT 9:1-19">Ntendo 9:1-19</ref>; <ref loc="ACT 22:6-16">22:6-16</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12" />“Mʉmɨhɨnzo nanso lʉhikʉ lʉng'wɨ naɨnongoe kʉ Damesiki, nɨzempewe ʉhumi nilagɨɨlyo kʉpuma kʉ apolyi nɨakʉlʉ. <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />Ʉwe Mʉtemi, nɨkaze nkolɨ mʉnzɨla anga ng'ʉng'wɨ itɨ, nɨkaona nzelya ntaki kʉkɨla mpasʉ kʉpuma kigʉlʉ, ɨkelya mpande yɨhi kʉmpilimɨɨlya ʉnene palʉng'wɨ nawo naɨkine. <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />Kɨhi kɨkagwa pihɨ, nikija lʉli lʉkitambʉlya nʉnene kʉ ntambʉ a Kɨebulania, ‘Sauli, Sauli. Kʉnɨkɨ ʉkʉnaja? Ʉkilemalya nankanda kikʉngʉma nʉnene anga ndogwe nɨkʉʉkʉa ilambɨ ʉ mʉlanga nʉwa mʉdɨmi wakwe.’ <verse eid="ACT 26:14" /><verse number="15" style="v" sid="ACT 26:15" />“Nɨkakolya, ‘Wɨ nyenyu ʉewe, Isekʉlʉ?’ Isekʉlʉ nʉyo wɨkansʉkɨɨlya, ‘Nɨ nene Yesʉ nʉʉkʉnaja. <verse eid="ACT 26:15" /><verse number="16" style="v" sid="ACT 26:16" />Ingɨ itungo ɨlɨ imɨke kʉ mɨgʉlʉ ako. Kʉnsoko nʉkigee kisɨgo ɨlɨ. Kʉʉɨka witʉme nʉ kʉtambʉɨla ɨantʉ ayo nʉmaine nayo nigee kʉng'wako. <verse eid="ACT 26:16" /><verse number="17" style="v" sid="ACT 26:17" />Kʉʉgunɨɨlya kʉ Ayahudi ɨako nʉ kʉ antʉ nɨshanga Ayahudi nɨkʉʉlagɨɨlya kʉng'wao. <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" />Ingɨ ahume kʉnɨnga apume mʉkiti ingɨle mʉwelʉ nʉ kʉhega mʉngulu yang'wa Shetani, ingɨle mʉʉtemi wang'wi Itunda ahume kʉsɨngɨɨlya ʉlekelwa nʉwa mɨlandʉ nʉ kʉtula palʉng'wɨ nawo nɨanihʉɨɨe.’<verse eid="ACT 26:18" /></para>
  <para style="s">Paʉlo ʉkʉʉtambʉla ʉ mʉlɨmo wakwe</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19" />“Itɨ gwa, Mʉtemi Agilipa, ʉnene shanga aɨnɨlʉgoha kʉ mʉloto ʉwʉ nʉʉpembeeye kigʉlʉ. <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" />Aɨnandɨɨye kʉtanantya kʉ antʉ a kʉ Damesiki, sʉnga kʉ Yelusalemu nʉ kʉisalɨ yɨhi niya kʉ Yʉdea nʉ kʉ antʉ nɨshanga Ayahudi ɨhi, kɨna atakɨwe kila itʉnʉ nʉkʉmʉpɨlʉkɨla Itunda nʉkʉkamɨnkɨɨlya kila itʉnʉ kʉ ntendo yao nimbɨ. <verse eid="ACT 26:20" /><verse number="21" style="v" sid="ACT 26:21" />Ingɨ kʉnsoko nanso, Ayahudi ɨkamamba naɨ nkolɨ pa Nyʉmba ang'wi Itunda, ɨkahiya kʉmbʉlaga. <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />Ingɨ Itunda aɨʉnzaɨɨye, nɨ itɨgwa lʉhikʉ nʉla lelo nimɨkile apaitɨ nɨatambʉɨle ɨtai antʉ nɨ akʉlʉ nɨ antʉ nɨa niino. Shanga kʉtambʉla kɨhi kʉkɨla ayo Musa nɨamanga naɨatambʉe kɨna akʉpumɨla, <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" />kɨna ʉ Kilisito ʉkagigwa nɨ kɨna nʉwanso ʉkʉtula wang'wandyo kiʉka kʉpuma kʉashi, wahume kʉtanantya welʉ nʉwa ʉgunwi kʉ antʉ akwe Ayahudi nʉ kʉ antʉ nɨshanga Ayahudi.”<verse eid="ACT 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />Paʉlo naɨ ʉkilongola, Pesito wɨkitʉnta nʉkʉlʉnga, “Paʉlo, ʉewe wahalaa. Ʉʉsomɨ nʉwako wakʉhalya.” <verse eid="ACT 26:24" /><verse number="25" style="v" sid="ACT 26:25" />Ingɨ ʉ Paʉlo wɨkasʉkɨɨlya, “Ʉnene shanga nihaile, mʉkʉlʉ Pesito, ingɨ kʉtambʉla ɨtai kʉnʉ nkete mahala ɨhi. <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />Mʉtemi Agilipa nʉng'wenso ga. Ʉlɨngile ɨmakani ɨhi, nʉnene kʉtambʉla kʉmatiliga ɨhi. Kʉnsoko nkete ɨ kʉlʉ kʉʉlʉ kɨna kʉtilɨ ikani ga nɨlɨ nɨlɨng'wɨ nɨshanga ʉlɨngile, kʉnsoko shanga aɨitʉmilwe kɨʉnkunku. <verse eid="ACT 26:26" /><verse number="27" style="v" sid="ACT 26:27" />Mʉtemi Agilipa, itɨɨ, ʉahʉɨɨene ɨ amanga? Nɨngile kɨna ʉahʉɨɨe.”<verse eid="ACT 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28" />Agilipa wɨkamʉɨla ʉ Paʉlo, “Itɨɨ, ʉsɨgɨɨe kitungo ɨlɨ nikupɨ ʉkʉmpemane ntule nɨ Mʉkilisito?”<verse eid="ACT 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 26:29" />Paʉlo wɨkalʉnga, “Itule kitungo ikupɨ ang'wɨ kitungo ilepu, kʉmʉlompa Itunda, shanga ʉewe du wing'wene ingɨ nawa ɨhi nɨantegeeye lelo, atule anga nɨnɨlɨ ʉnene, kʉleka ɨkɨtungo du.”<verse eid="ACT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30" />Naɨwakondya kʉtambʉla aya, mʉtemi Agilipa palʉng'wɨ nʉ Pesito mʉkʉlʉ nʉwa kʉ Yudea nʉ Belinike nawa naɨ ikalanilye ɨkimɨka. <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />Sʉnga naɨapuma mianza, ɨkitambʉlya “Mʉntʉ ʉyʉ shanga ʉtendile kɨntʉ kɨhi nɨkɨkʉmʉsasha washe ang'wɨ kʉtungwa mʉkadulumu.” <verse eid="ACT 26:31" /><verse number="32" style="v" sid="ACT 26:32" />Agilipa wɨkamʉɨla ʉ Pesito, “Mʉntʉ ʉyʉ aza ʉzelekelwa widese anga aza watule shanga ʉlompile kenda kʉng'wa Kaisali Mʉtemi nʉ mʉkʉlʉ nʉwa kʉ Lumi.”<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="s">Paʉlo ʉkʉtalwa kʉ Lumi</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />Naɨyalamʉlwa kɨna kinzʉ mʉhɨnzo kenda kʉ Italia kʉkɨɨla mʉlʉzɨ nʉlʉkʉlʉ, Paʉlo nɨatungwa aʉya ɨkaɨkwa mʉwɨmɨɨlwi wang'wa Juliasi naɨ ʉkolɨ miumbɨ laanyambita a Mʉtemi nʉ mʉkʉlʉ nʉwa kʉ Lumi, midale nɨla asʉnji ang'wa Kaisali Agusito. <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />Aɨkandilye mʉhɨnzo kɨkanankɨla meli naɨpumile kʉ Adilamitio nɨkɨɨla mʉisalɨ niyipantamile mu bandali niya mihɨɨ a Asia, kɨze kɨ palʉng'wɨ nʉ Alisitaliko mʉnya kʉ Makedonia kʉpuma kʉ Tesalonike. <verse eid="ACT 27:2" /><verse number="3" style="v" sid="ACT 27:3" />Mʉdaʉao kɨkimɨka kʉ Sidoni, Juliasi nʉyo wɨkamʉtendeela iza ʉ Paʉlo, wɨkamʉgombya walongole kʉ ahʉmbaʉya amʉaɨɨlye maintʉ akiaɨɨlya. <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />Kʉpuma kʉng'wanso kɨkingɨla hangɨ mʉlʉzɨ kɨkakɨɨla ipande nɨla kihɨɨlɨ nɨla kɨsiwa nɨka Kipilo kʉnsoko ng'wega aɨʉkʉinyoma. <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />Naɨkaputa ʉlʉzɨ nʉlʉkʉlʉ nʉlʉkolɨ ipande nɨla Kilikia nɨ Pampilia, kɨkapika mʉkisalɨ ka Mila nɨkolɨ mihɨɨ akʉ Likia. <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />Kʉng'wanso mankata nʉwanso ʉ Juliasi wɨkalija meli Alekisandilia nilongoe kʉ Italia, wɨkakʉnankɨlya mʉmo.<verse eid="ACT 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 27:7" />Kɨkagenda lʉgendo lʉniino kʉ mahikʉ ɨdʉ kʉ lwago, panyambele kɨkapika pakupɨ nɨ Nido. Kʉnsoko ʉng'wega aɨʉkɨlɨ ʉkʉlʉ kɨkalemigwa naɨ kʉlomee kɨkapantamɨla kʉkilya, kɨkakɨɨla kilya akɨsiwa ka Kilete nikikengee nɨ Salimone. <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />Kɨkipantamɨɨlya mʉmpelo a lʉzɨ kʉ lwago kɨkapika nkɨka ɨng'wɨ nitangwa Bandali Nɨnza, pakupɨ nɨ kasalɨ nɨka Lasea.<verse eid="ACT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9" />Matungo ɨdʉ aɨalimɨe, mʉhɨnzo witʉ nʉwa mʉlʉzɨ wɨkatula nʉlwago, kʉnsoko matungo aʉgwalyi nʉwa Ayahudi aɨakɨla. Itɨ gwa ʉ Paʉlo wikaahʉgʉlya wɨkalʉnga, <verse eid="ACT 27:9" /><verse number="10" style="v" sid="ACT 27:10" />“Anyandʉgʉ ane, kʉona kɨna mʉhɨnzo ʉwʉ ingɨ ʉkete lwago, shanga kʉ meli du ingɨ ikʉsasha ʉlimɨlyi ʉkʉlʉ nʉwa mɨligo, nʉ likalo litʉ.” <verse eid="ACT 27:10" /><verse number="11" style="v" sid="ACT 27:11" />Ingɨ mʉtongeeli nʉwa anyambita wɨkahita kʉtegeelya nkani nʉtambʉe ʉ Paʉlo, wikatyata ʉsɨgigwa nʉwa mʉlongolya meli nʉ mʉkola meli. <verse eid="ACT 27:11" /><verse number="12" style="v" sid="ACT 27:12" />Kʉnsoko bandali nanso shanga aɨnza kikiɨ matungo ampepo, antʉ ɨdʉ ɨkalamʉla kʉlongoleke nʉ mʉhɨnzo azeasʉmbɨɨye kʉpika kʉ Poinike nʉkikiɨ kʉng'wanso matungo ampepo. Poenike ingɨ bandali nɨkolɨ kʉ kɨsiwa ka Kilete igozenkanilye nipande nila takama nɨ ng'weli, nɨ hukuma nɨ ng'weli.<verse eid="ACT 27:12" /></para>
  <para style="s">Ng'wega nʉwa mʉlʉzɨ</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13" />Ng'wega kʉpuma takama wɨkatula kunka inino, ɨkasɨga kɨna ahumile kʉtenda mʉaloewe, itigwa ɨkaheja ɨkɨambɨɨla meli ɨkahega nʉkandya ʉmʉhɨnzo kʉtʉnga mʉmpelompelo a kɨsiwa ka Kilete. <verse eid="ACT 27:13" /><verse number="14" style="v" sid="ACT 27:14" />Ingɨ naɨlakila itungo inɨɨno ng'wega ʉkʉlʉ nʉwitangwa “Ng'wega nʉwa hukuma” wɨkatula kunka kʉpuma kʉ kisiwa ka Kilete. <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />Meli ɨkakʉwa nʉ ng'wega kɨkaleng'wa kʉmɨlongolya ɨmeli kʉloma kʉʉpembeeye ʉng'wega nʉwanso, kɨkaleka ɨmeli ɨtalwe kʉʉlomile ʉng'wega. <verse eid="ACT 27:15" /><verse number="16" style="v" sid="ACT 27:16" />Meli ɨkapatɨɨligwa kʉnsuntwa kɨkapikigwa kʉ kɨsiwa kɨniino nɨkitangwa Kauda. Kɨkahuma kʉlwago kʉtunga ibɨnɨ niniino nɨla kʉagunɨla iantʉ naɨ lɨkolɨ mʉ meli. <verse eid="ACT 27:16" /><verse number="17" style="v" sid="ACT 27:17" />Antʉ naɨakondya kʉlutɨɨla ibɨnɨ nɨlanso niniino mʉ meli, ɨkatunga lʉdigi kʉambɨnkania palʉng'wɨ nɨ meli. Aɨogopile kʉtalwa mʉ mɨhangahanga mʉmpelo a Libia, ɨkaheja ɨkɨambɨɨla meli ɨkaleka ɨsuntwe nʉ ng'wega. <verse eid="ACT 27:17" /><verse number="18" style="v" sid="ACT 27:18" />Aɨkʉʉsuntwa nʉ kɨntingʉ mʉdaʉao ng'wega wɨkalongoleka wɨkatula mɨzuga ɨmeli ɨkatula kʉgumanga mɨligo a mʉ meli, <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />lʉhikʉ nʉla kataatʉ kʉ mɨkonoao, ɨkagʉmɨla mʉlʉzɨ iseme niya meli. <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />Mahikʉ ɨdʉ shanga ɨkaona lyoa ang'wɨ nzota, ng'wega nʉanso wɨkalongoleka kʉtula ʉkʉlʉ, Sʉnga kɨkakatapa lʉkʉlʉ kʉgunɨka.<verse eid="ACT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21" />Naɨikiɨ mahikʉ ɨdʉ agila anga ndya, Paʉlo wɨkimɨka pakatiao wɨkalʉnga, “Ʉnyenye antʉ, aza mʉzentegeelya naza nʉmʉsɨgilye kɨna mʉleke kʉlongoleka nʉ mʉhɨnzo kʉpuma kʉ Kilete, papo ʉnyenye aza mʉzeegunɨka kʉgazɨka meli nʉlwago ʉlʉ nʉlʉbɨ nʉkʉlimɨlya nsao. <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />Itungo ɨlɨ kʉmʉlompa, komyi inkolo yanyu kʉnsoko kʉtilɨ ga nʉng'wɨ anyu nʉʉkʉsha, meli du ɨkʉgazɨka. <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />Itunda ʉyo nʉnene nɨ nɨmʉntʉ wakwe hangɨ nɨmitumɨla, igʉlo ʉtikʉ aza ʉmʉlagɨɨye ʉ Malaɨka wakwe wanigeela, <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />nʉyo wambɨla, ‘Paʉlo leka kogopa, kʉnsoko ʉtakɨwe kimɨka pang'wa Kaisali mʉtemi nʉ mʉkʉlʉ nʉwa kʉ Lumi. Itunda ʉkʉʉtendela ʉkende, kʉnsoko ako ʉkʉaguna ɨhi nɨakolɨ mʉhɨnzo ʉng'wɨ nʉewe mʉleke kʉsha.’ <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />Itɨ gwa, ʉnyenye antʉ komyi inkolo! Kʉnsoko nihʉɨɨe kɨna Itunda ʉkʉtenda anga nazaʉntambʉɨe. <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />Ingɨ meli itʉ ɨkʉsuntɨɨligwa nʉ kʉholomela kʉ kɨsiwa kɨngɨza.”<verse eid="ACT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />Ʉtikʉ nʉwa lʉhikʉ likʉmi na innɨ, naɨlapika, kɨkaze kʉkɨlɨ kʉʉnsuntwa nʉ ng'wega kʉtʉnga Lʉzɨ nʉla Adilia, naɨyatula ʉtikʉ wigɨngʉ, alongolya meli ɨkakʉɨla kɨna kaakapuma mʉ Lʉzɨ nʉla Adilia. <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />Kʉlʉlo ɨkatunga shʉma na lʉdigi nʉkʉgʉmɨla mʉmazɨ kʉgemeelya ʉlundu nʉwa mazɨ ɨkahanga aɨmita makʉmi annɨ, naɨkalongoleka pantongeela iniino ɨkagemelya hangɨ ɨkahanga ʉlundu wakwe mita ikʉmi abɨɨlɨ na mʉtandatʉ. <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />Kɨhi aɨkogopile kʉmɨkumɨlya ɨmeli itʉ mʉmagwe nɨmakulu, ɨkagʉmɨla maambɨla meli ainnɨ kʉnyuma a meli, ɨkatula lompa ʉkaye kela. <verse eid="ACT 27:29" /><verse number="30" style="v" sid="ACT 27:30" />Akʉa nsambo ɨkaduma nzila kʉtigana, kʉlʉlo ɨkasimya ibɨnɨ nɨla kʉgunɨla ɨantʉ naɨlɨkolɨ mʉ meli mʉlʉzɨ, ɨkitendisa kɨna akʉgʉmɨla mʉmazɨ ɨmaambɨɨla meli nakʉntongeela. <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />Ingɨ ʉ Paʉlo wɨkamʉɨla ʉ mankata nʉwa anyambita nɨ anyambita akwe, “Akʉa nsambo awa anga ahite kʉsiga mʉ meli, shanga mʉkʉgunɨka.” <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />Kʉlʉlo anyambita awo ɨkatema indigi niiambɨɨe ibɨnɨ niniino nɨla kʉgunila ɨ antʉ mʉ meli, ɨkalekela ɨbɨni lɨtalwe nɨ mazɨ.<verse eid="ACT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33" />Daʉ nɨnkʉlʉ, Paʉlo wɨkaakomelya nkolo antʉ ɨhi alye indya, wazelʉnga, “Lelo ingɨ lʉhikʉ likʉmi na kannɨ mʉkolɨ mʉʉkɨa hangɨ mʉkɨlɨ kʉlya kɨntʉ kɨhi. <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />Kʉlʉlo kʉmʉlompa mʉlye indya, kʉnsoko yɨkʉmʉaɨɨlya mʉhume kishiɨ. Kʉnsoko kʉtilɨ anga mʉntʉ wɨhi mʉng'wanyu nʉkʉlemaala.” <verse eid="ACT 27:34" /><verse number="35" style="v" sid="ACT 27:35" />Naɨwakondya kʉtambʉla inkani izi, Paʉlo wɨkahola ʉmʉkate, wɨkamʉlompa Itunda ntongeelaao ɨhi, wɨkaʉega, wɨkandya kʉlya. <verse eid="ACT 27:35" /><verse number="36" style="v" sid="ACT 27:36" />Kʉlʉlo antʉ ɨhi ɨkakomya nkolo, ɨkatulalya indya. <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" />Mʉmeli nanso aɨkʉkolɨ antʉ Magana abɨɨlɨ nɨ makʉmi mʉpungatɨ na mʉtandatʉ. <verse eid="ACT 27:37" /><verse number="38" style="v" sid="ACT 27:38" />Antʉ ɨhi naɨalya indya nʉkikʉta, ɨkatula gʉmɨla mʉlʉzɨ ngano nindya ying'wɨ kʉkepya ʉlito mʉ meli.<verse eid="ACT 27:38" /></para>
  <para style="s">Kɨntingu kɨkʉbunga Meli</para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39" />Naɨweleela, shanga ɨkamɨlɨnga ihɨɨ nanso, ingɨ aɨaine kɨhepeelo kɨkete mɨhangahanga ɨkalamʉla kʉsuntɨɨlya kʉko ɨmeli imɨke anga ɨzeyikʉhumɨka. <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />Kʉlʉlo ɨkatema maambɨɨla meli ɨhi nʉkʉmaleka mʉlʉzɨ, itungo lɨlo lɨɨlo ikatungʉla ndigi naɨitungɨɨe ʉlongoelyo nʉwa meli, sʉnga ɨkakɨngamya mʉgolole ʉng'wɨ nʉwa kʉntongeela kʉkɨja ng'wega ʉhume kʉmɨsuntɨɨlya ɨmeli ɨlome kʉmɨhangahanga. <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />Ingɨ meli ɨkasuntwa nɨ mazɨ ɨkenda paipelu ɨkaholomela mʉmɨhangahanga, nɨanso ɨkamɨkweheela ɨmeli pampelo alʉzɨ, ntongeela ameli ɨkaholomela mihangahanga, ɨkatula nkaku kʉhegigwa, ingɨ ipande nɨla kʉnyʉma ɨkatulabunɨka mapande kʉnsoko akʉkʉwa nɨmaɨngʉ.<verse eid="ACT 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42" />Anyambita awo ɨkigombya kʉabʉlaga atungwa ɨhi kʉnsoko aɨogopile kɨna ahumile kipumpa nʉ kʉmanka atigane. <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />Ingɨ ʉ mankata wɨkahiya kʉmʉguna ʉ Paʉlo, wɨkaagɨɨlya anyambita aleke kitʉma ɨsɨgo lao. Wɨkalagɨɨlya awa nɨahumile kipumpa igʉmɨle mʉlʉzɨ, ipumpe apume kʉnzɨ a lʉzɨ. <verse eid="ACT 27:43" /><verse number="44" style="v" sid="ACT 27:44" />Nɨasagile akʉpikɨɨla kʉnzi a lʉzɨ kʉtʉmɨla balʉa ambao ang'wɨ mapande nabunɨkɨe mʉ meli. Ʉʉgwa ʉsese kɨhi naɨkʉgunɨkile iza.<verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="s">Makani naɨwitʉmile ʉ Paʉlo kʉ Kisiwa ka Malita</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />Naɨkapika iza kʉmpelo a lʉzɨ, papo kɨkalɨnga kɨna kisiwa nɨkanso kitangwa Malita. <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />Akolihɨɨ mʉ kɨsiwa nɨkanso aɨankolo nza. Kʉnsoko ambula naɨkʉkʉɨle nɨmpepo naɨ ɨkʉhumileka ɨkɨɨla ʉmoto nʉkʉɨla ʉsese kɨhi kote. <verse eid="ACT 28:2" /><verse number="3" style="v" sid="ACT 28:3" />Paʉlo wɨkahoeela iligo nɨya nkwɨ wɨkatula iɨkiɨla mʉmoto. Papo gwa kʉnsoko a ʉpyʉ nʉwa moto, nzoka aʉhʉngʉ ʉtaki ɨkapuma mʉnkwɨ niyanso ɨkakamantɨɨla nʉkipalingɨɨlya mʉkono wang'wa Paʉlo. <verse eid="ACT 28:3" /><verse number="4" style="v" sid="ACT 28:4" />Akolihɨɨ nɨanso naɨamɨona nzoka nanso ɨning'inile mʉmʉkono wang'wa Paʉlo, ɨkitambʉɨla, “Ihumɨlile ʉ mʉntʉ ʉyʉ ʉkʉtula wabʉlaganɨle, nɨitiga ʉgunɨkile kʉpuma mʉlʉzɨ, alʉngʉ itʉ shanga akʉmʉleka walongoleke kishiɨ.” <verse eid="ACT 28:4" /><verse number="5" style="v" sid="ACT 28:5" />Ingɨ ʉ Paʉlo wɨkamɨkanantɨla mʉ moto nzoka nanso kʉnʉ nʉwanso shanga waze ʉlemaigwe. <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />Antʉ ɨkasʉmbɨɨlya waɨmbe ang'wɨ wagwe nʉ kʉsha. Ingɨ naɨasʉmbɨɨlya itungo ɨlɨpu nʉkʉona kʉtilɨ anga kɨntʉ kɨhi nɨkɨpumie, ɨkakaɨla isɨgo lao nʉkandya kʉlʉnga kɨna ʉyʉ ingɨ ʉng'wɨao mʉ alʉngʉ.<verse eid="ACT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7" />Pakupɨ nɨnkɨka nanso, aɨʉkolɨ mʉgʉnda ʉkʉlʉ nʉwa mʉntʉ ʉng'wɨ witangwa Pʉbilio, mʉtongeeli nʉwa kɨsiwa nɨkanso, aɨʉkʉsɨngɨɨye nʉ kʉʉkendepa nangʉlʉ kʉ mahikʉ ataatʉ. <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />Ihe wang'wa Pʉbilio aɨmʉlwae kʉnʉ ʉlae mʉʉlɨlɨ, ʉkʉlwala nʉkʉpanza sakami. Paʉlo wɨkingɨla mʉnyʉmba wamʉone, naɨ wamʉlompeela, wɨkamʉɨkɨɨlya mɨkono nʉ kʉmʉkomya. <verse eid="ACT 28:8" /><verse number="9" style="v" sid="ACT 28:9" />Makani aya naɨlɨpumɨe, antʉ ɨhi naɨalwae mʉ kɨsiwa nɨkanso ɨkapembya ʉ Paʉlo ɨkaponigwa. <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />Antʉ akɨsalɨ nɨkanso ɨkakʉlʉmba nʉkʉʉpa ipegwa yɨdʉ kʉnsoko amakani naɨwitʉmile ʉ Paʉlo, nʉsese naɨkandya ʉ mʉhɨnzo kʉkɨɨla amʉlʉzɨ, ɨkanakɨlya mʉ meli maintʉ ɨhi naɨkʉmatakile.<verse eid="ACT 28:10" /></para>
  <para style="s">Mʉhɨnzo wang'wa Paʉlo kʉpuma kʉ Malita kenda kʉ Lumi</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />Myelyi ɨtaatʉ naɨkɨla kɨkanankila mʉ meli naimɨkile mʉ kɨsiwa nɨkanso kʉnsoko ampepo kɨkandya mʉhɨnzo. Meli nɨpembeeye kʉ Alekisandilia ɨndɨkilwe logo la “Alʉngʉ a Mapaha” nɨitangwa Kasita nʉ Polʉkisi. <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />Kɨkapika kʉ Silakʉsa pang'wanso kɨkikiɨ mahikʉ ataatʉ. <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />Kʉpuma pang'wanso lʉhikʉ naɨ lʉtyatile kɨkapika kʉ Legio. Naɨlakɨla lʉhikʉ lʉng'wɨ ng'wega ʉkʉlʉ wɨkandya kʉkʉnka kʉpembelya takama, kɨkalongoleka nʉ mʉhɨnzo lʉhikʉ nʉla kabɨɨlɨ kɨkapika kʉ kɨsalɨ ka Puteoli. <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />Kʉng'wanso kɨkaahanga anyandʉgʉ, kɨkasɨngɨɨligwa kʉdʉe nɨenso mahikʉ mʉpungatɨ. Itɨʉʉ naɨkʉpikile kʉ Lumi. <verse eid="ACT 28:14" /><verse number="15" style="v" sid="ACT 28:15" />Anyandʉgʉ a kʉ Lumi naɨigulye impola yitʉ, ɨkaza kʉʉsɨngɨɨlya pa ʉgalagalo nʉwa Apio nɨ Mɨkahawa Itaatʉ. Paʉlo naɨ waaona, wɨkamʉlompa Itunda nʉkʉakomya nkolo.<verse eid="ACT 28:15" /></para>
  <para style="s">Paʉlo ʉko kʉ Lumi</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 28:16" />Naɨkapika kʉ Lumi, Paʉlo wɨkagombigwa kishiɨ wing'wene palʉng'wɨ nʉ mʉmboi nʉwa kʉmʉsʉnja.<verse eid="ACT 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />Mahikʉ ataatʉ naɨakɨla Paʉlo wɨkaitanga palʉng'wɨ atongeeli nɨa Kiyahudi. Naɨilʉnda wɨkaaɨla, “Anyandʉgʉ ane, palʉng'wɨ nʉkʉtula shanga nitʉmile anga ikani lɨhi nibɨ kʉ antʉ itʉ ang'wɨ kʉhita ntendo niya atata itʉ, ingɨ aɨntungilwe kʉ Yelusalemu nɨkatalwa mʉʉhumi nʉwa Alumi. <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />Alumi nɨenso naɨakondya kʉnkolenkeelya, ɨkahiya kʉndekela kʉnsoko shanga ɨkaona igazo lɨhi nɨntendile nɨlakʉsasha mbʉlagwe. <verse eid="ACT 28:18" /><verse number="19" style="v" sid="ACT 28:19" />Ingɨ Ayahudi nɨang'wɨ naɨahita ikani nɨlanso, nɨkatakɨlwa kʉlompa ʉsemelwa ʉwʉ ʉtalwe kʉng'wa Kaisali Mʉtemi nʉmʉkʉlʉ nʉwa kʉ Lumi walamʉle, palʉng'wɨ nʉ kʉtula aɨnɨmʉgila isosho lɨhi nɨla kʉasemela antʉ ane. <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />Itɨ gwa anga nihume kitambʉlya nʉ nyenye, ingɨ kʉnsoko isʉmbɨɨlyo nɨla Aisilaeli ntungilwe mɨnyololo.”<verse eid="ACT 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21" />Nɨanso ɨkamʉsʉkɨɨlya, “Ʉsese shanga kʉsɨngɨɨye anga balʉa nɨlako lɨhi kʉpuma kʉ Yʉdea, hangɨ kʉtilɨ anga mʉnyandʉgʉ wɨhi nʉzile apa kʉpumya mpola ang'wɨ kʉtambʉla ikani lɨhi nibɨ kʉng'wako. <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />Ingɨ kʉloilwe kija kʉpuma kʉng'wako nʉsɨgile kʉnsoko kʉlɨngile kɨna nkɨka yɨhi shanga alɨgombile iumbɨ ɨlɨ.”<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />Ikaɨka lʉhikʉ nʉla kʉtankana nʉ Paʉlo, antʉ ɨdʉ ɨkapembya mʉnyʉmba nʉwikiɨ ʉ Paʉlo kandɨɨlya daʉ kʉpikɨɨla mpindi wɨkaaganʉɨla nʉ kʉalɨngansa kʉ Ʉtemi wang'wi Itunda wazegema kʉapema amʉhʉɨɨle ʉ Yesʉ kʉkɨɨla malagɨɨlyo ang'wa Musa nʉ mʉmbugulu niya amanga. <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />Antʉ ang'wɨ ɨkahʉɨɨla kʉ nkani nʉtambʉe ʉ Paʉlo, nɨang'wɨ shanga ɨkahʉɨɨla. <verse eid="ACT 28:24" /><verse number="25" style="v" sid="ACT 28:25" />Itɨ gwa ɨkatula kikʉngʉma enso kʉ enso, ɨkatulahega, Paʉlo wɨkaatambʉɨla lʉkani lʉng'wɨ. “Ng'wahʉ Ng'welʉ aɨʉtambʉɨe ɨtai kʉatata anyu naɨkʉtambʉla mpola yang'wi Isekʉlʉ Yesʉ kʉkɨɨla Isaya. <verse eid="ACT 28:25" /><verse number="26" style="v" sid="ACT 28:26" />Wazelʉnga,</para>
  <para style="q" vid="ACT 28:26">“‘Longola kʉ antʉ awa ʉatambʉɨle,</para>
  <para style="q" vid="ACT 28:26">“Mʉkʉtulija ingɨ shanga mʉkʉtulalɨnga,</para>
  <para style="q" vid="ACT 28:26">Mʉkʉtulaona, ingɨ shanga mʉzemanya,”<verse eid="ACT 28:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ACT 28:27" />kʉnsoko nkolo niya antʉ awa yakagupile,</para>
  <para style="q" vid="ACT 28:27">nɨakʉtwɨao alitopile,</para>
  <para style="q" vid="ACT 28:27">atutilyee kʉmiho aleke kʉona.</para>
  <para style="q" vid="ACT 28:27">nʉkʉtegeelya kʉ akʉtwɨao.</para>
  <para style="q" vid="ACT 28:27">Anga ɨze shangaʉʉ aza azeona kʉ mihoao</para>
  <para style="q" vid="ACT 28:27">akʉlɨnga kʉnkolo niyao nʉkʉmpɨlʉkɨla,</para>
  <para style="q" vid="ACT 28:27">nʉ nene nɨaponie.’<verse eid="ACT 28:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28" />Sʉnga ʉ Paʉlo wɨkatambʉla, “Kʉlʉlo ndoilwe ʉnyenye Ayahudi mʉlɨnge kɨna, ʉkomolwi ʉwʉ nʉwang'wi Itunda watawe kʉ antʉ nɨshanga Ayahudi, nɨenso akʉtegeelya.” <verse eid="ACT 28:28" /><verse number="29" style="v" sid="ACT 28:29" />Paʉlo naɨwakondya kʉtambʉla nkani izi, Ayahudi ɨkahega azikolya ɨenso.<verse eid="ACT 28:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30" />Paʉlo aɨwɨshiɨ myaka ɨbɨɨli mʉnyʉmba naɨʉpangile, wɨkaze asɨngɨɨlya antʉ ɨhi naɨakendɨza kʉmʉlamʉsha. <verse eid="ACT 28:30" /><verse number="31" style="v" sid="ACT 28:31" />Wazetanantya Ʉtemi wang'wi Itunda nʉ kʉmanyisa makani ayo nang'wi Isekʉlʉ Yesʉ Kilisito, kʉ ʉkamatɨku kʉnʉ shanga waze wogopile ɨkaze kʉtilɨ anga mʉntʉ nʉwa kʉmʉgilya kʉtambʉla kɨntʉ kɨhi.<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>