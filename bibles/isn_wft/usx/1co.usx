<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CO" style="id">- Isanzu Bible Versio</book>
  <para style="h">1 AKOLINTO</para>
  <para style="toc1">IBADA LANG'WA PAɄLO NƗLANG'WANDYO KɄ</para>
  <para style="toc2">1 Akolinto</para>
  <para style="toc3">1Ako</para>
  <para style="toc1">IBADA LANG'WA PAɄLO NƗLANG'WANDYO KɄ</para>
  <para style="mt1">AKOLINTO</para>
  <para style="is">Ntongela akwe</para>
  <para style="ip">Itʉtʉ ɨlɨ nɨla ng'wandyo nɨla Akolinto aɨlɨandɨkilwe nʉ Mitʉmi Paʉlo mʉmatungo anga mʉng'waka nʉwa makʉmi ataano na ɨtaano naɨwatugwa ʉ Yesʉi Kilisito 1:1. Ɨlɨ ingɨ itʉtʉ lang'wandyo mʉʉbɨɨlɨ naandɨkilwe nʉ Paʉlo kʉ ahʉɨɨli ang'wa Kilisito naɨ akʉ kɨsalɨ ka Kolinto. Anga iyʉke aɨʉandɨkile itʉtʉ ɨlɨ naɨwishiɨ kʉ Epeso waze ʉlomee kʉlongola ʉmʉhɨnzo nʉwa kʉ Kolinto nɨzʉlongoe nʉkʉtulya kʉpuma kʉ Makedonia 16:5-9.</para>
  <para style="ip">Itʉtʉ ɨlɨ ingɨ Paʉlo ʉganʉe mpola naɨʉpewe kʉpuma kʉ ahʉɨɨli ang'wa Kilisito nɨang'wɨ kʉpuma mʉ makani ang'wɨ nɨshanga maza nakʉtendwa mʉmo mʉahʉɨɨli ang'wa Kilisito palʉng'wɨ nʉ ʉtemanʉki nʉ ʉgoolya. Antʉ a kɨsalɨ ka Kolinto aɨkɨkumʉkile kʉ ntendo niya ʉgoolya nʉʉkɨlɨnkɨɨe, itɨgwa shanga ɨkʉɨlwa kʉona kɨna ɨahʉɨɨli ang'wɨ nɨa pang'wanso aɨagigwa nɨmakani nanso. Itʉtʉ ɨlɨ nɨla ng'wandyo nɨla Akolinto lɨkete mɨlango nɨmɨza nɨganʉe ʉʉlowa nʉwo ingɨ mʉlango 13.</para>
  <para style="iot">Namolɨ</para>
  <para style="io">Paʉlo wandɨɨye kʉalamʉsha Akolinto nʉkʉmʉsongelya Itunda kʉnsokoao Akolinto. 1:9.</para>
  <para style="io">Naɨakɨla nanso ʉkitʉma mʉlɨmo wa mpola naɨʉpewe niya ʉtemanʉki mʉahʉɨɨli ang'wa Kilisito nɨakolɨ kʉ Kolinto. 1:10-4-21.</para>
  <para style="io">Sʉnga wɨkandya kʉkania makani a ʉgoolya nintendo nɨakitendeela nʉkisemela mʉmaanza ɨenso kʉ enso 5-6.</para>
  <para style="io">Naɨyakɨla pang'wanso ʉkʉalagɨɨla makani awitɨni nʉ kʉpumya isongeelyo kʉadʉdʉ ni ipolya mʉmilʉndo ni ipegwa niya kɨnkolo niyipumile kʉng'wi Itunda nɨmakani naʉkunʉkʉɨlwa 7-15.</para>
  <para style="io">Paʉlo ʉmaɨɨye kʉtambʉla makani ang'wɨ akitʉmɨla mʉlɨmo hangɨ akinyene 16.</para>
  <chapter number="1" style="c" sid="1CO 1" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1" />Ʉnene Paʉlo, nɨ nitangilwe ni Itunda kʉʉlowa wakwe ntule nɨ mitʉmi wang'wa Kilisito Yesʉ, kine nʉ Sositene mʉnyandʉgʉ witʉ.<verse eid="1CO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 1:2" />Kʉmʉandɨkɨla itʉtʉ ɨlɨ ʉnyenye nɨ mɨanya kʉ Kolinto nɨmʉmʉhʉɨɨe Itunda, ʉnyenye melisigwe mʉng'wa Kilisito Yesʉ, mɨkitangwa mʉtule mɨantʉ ang'wi Itunda, palʉng'wɨ nɨantʉ ɨhi mihɨɨ nɨakʉmʉlompa Isekʉlʉ Yesʉ Kilisito nɨɨza Isekʉlʉ nʉwao hangɨ ingɨ Isekʉlʉ witʉ.<verse eid="1CO 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 1:3" />Kʉmʉlompelya ʉkende nɨmatiliga kʉpuma kʉng'wi Itunda Tata witʉ nʉ kʉng'wi Isekʉlʉ witʉ Yesʉ Kilisito ʉtule palʉng'wɨ nʉnyenye.<verse eid="1CO 1:3" /></para>
  <para style="s">Paʉlo ʉkʉmʉsongelya Itunda</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4" />Mahikʉ ɨhi nɨmʉsongelya Itunda nʉwane kʉnsoko anyu kʉ ʉkende wakwe nɨmʉpewe mʉng'wa Kilisito Yesʉ. <verse eid="1CO 1:4" /><verse number="5" style="v" sid="1CO 1:5" />Kʉnsoko kʉkamɨnkana nʉ Kilisito, Itunda ʉmʉpe maintʉ ɨhi nɨmʉmatakile, anga mʉʉtambʉli wanyu nʉ mʉʉlɨngi wanyu. <verse eid="1CO 1:5" /><verse number="6" style="v" sid="1CO 1:6" />Kʉnsoko nanso impola yang'wa Kilisito naɨkʉmʉtanantɨɨye ingɨ yatai, <verse eid="1CO 1:6" /><verse number="7" style="v" sid="1CO 1:7" />kʉlʉlo shanga mʉkepewe kɨpegwa kɨhi nɨka kɨnkolo nɨmʉsʉmbɨɨye kʉtulya kʉng'wi Isekʉlʉ witʉ Yesʉ Kilisito. <verse eid="1CO 1:7" /><verse number="8" style="v" sid="1CO 1:8" />Nʉwanso ʉkʉmʉkomelya nkolo ʉnyenye kʉpikɨɨla ɨmpelo, ingɨ mʉleke kʉtula nigazo lɨhi lʉhikʉ ʉlo nʉlakʉtulya Isekʉlʉ witʉ Yesʉ Kilisito. <verse eid="1CO 1:8" /><verse number="9" style="v" sid="1CO 1:9" />Itunda ingɨ watai, nʉwanso naɨ ʉmitangile mʉtule palʉng'wɨ nʉng'waakwe ʉ Yesʉi Kilisito Isekʉlʉ witʉ.<verse eid="1CO 1:9" /></para>
  <para style="s">Kʉtemanʉka kʉ antʉ nɨamʉhʉɨɨe Itunda</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10" />Anyandʉgʉ ane, kʉminena kʉʉhumi wang'wa Yesʉ Kilisito Isekʉlʉ witʉ, kɨna mʉzigombya mʉnkani yɨhi nɨmʉkitambʉɨla, leki kʉtemanʉki, mʉtule nisɨgo lɨng'wɨ nʉ wigombyi ʉng'wɨ. <verse eid="1CO 1:10" /><verse number="11" style="v" sid="1CO 1:11" />Ahʉɨɨli ɨane, mbɨɨwe nɨantʉ kʉpuma mikoe lang'wa Kɨloe, yigelekile kɨhenga kɨna ɨkolɨ nkʉngʉmi mʉng'wanyu. <verse eid="1CO 1:11" /><verse number="12" style="v" sid="1CO 1:12" />Nigulye mʉkikʉngʉma itɨ, kɨla mʉntʉ ʉkʉtambʉla yakweʉ. Ʉmʉya ʉkʉlʉnga, “Ʉnene nʉmʉkee Paʉlo,” Ʉmʉya ʉkʉlʉnga, “Ʉnene nʉmʉkee Apolo,” Ʉmʉya ʉkʉlʉnga, “Ʉnene nʉmʉkee Petelo,” nʉ mʉya ʉkʉlʉnga, “Ʉnene nʉmʉkee Kilisito.” <verse eid="1CO 1:12" /><verse number="13" style="v" sid="1CO 1:13" />Itɨɨ, ʉ Kilisito ʉtemanʉkile maumbɨ maumbɨne? Itɨɨ, Paʉlo ng'wensone aɨʉkonontewe mʉmʉsalaba kʉnsoko anyu? Itɨɨ, aɨmʉbadisigwe mʉtule mɨamanyisigwa ang'wa Paʉlo ne?<verse eid="1CO 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 1:14" />Nʉmʉsongeeye Itunda kɨna, shanga aɨnʉmʉbadisilye mʉntʉ wɨhi mʉng'wanyu ingɨ aɨnɨabadisilye a Kilisipo nʉ Gayo du. <verse eid="1CO 1:14" /><verse number="15" style="v" sid="1CO 1:15" />Kʉlʉlo kʉtilɨ mʉntʉ wɨhi nʉhumile kʉlʉnga ʉbadisigwe kʉtula mʉmanyisigwa wane. <verse eid="1CO 1:15" /><verse number="16" style="v" sid="1CO 1:16" />Itʉnʉ nakɨmbʉka, aɨmbadisilye antʉ a mikoe lang'wa Sitepwano, ingɨ shanga nkɨmbʉkile kɨna aɨmbadisilye mʉntʉ mʉngɨɨza wɨhi. <verse eid="1CO 1:16" /><verse number="17" style="v" sid="1CO 1:17" />Kʉnsoko ʉ Kilisito shanga aɨʉndagɨɨye kʉbadisa, ingɨ aɨʉndagɨɨye kʉtanantya Nkani Nza, hangɨ ntanantye ɨze shanga nzaɨigwe nʉ ʉlɨngi nʉwa antʉ, ntendile kʉnsoko ngulu ansha ang'wa Kilisito mʉ mʉsalaba ɨleke kʉgʉmanɨɨligwa.<verse eid="1CO 1:17" /></para>
  <para style="s">Kilisito ingɨ ngulu hangɨ mahala ang'wi Itunda</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18" />Kʉnsoko lʉkani nʉlansha ang'wa Kilisito mʉmʉsalaba ingɨ ikani lakɨpʉngʉ kʉantʉ awa nɨamolɨ mʉʉlimɨli, ʉsese nɨkʉgunɨkile ʉlʉkani nʉlanso ingɨ ngulu yang'wi Itunda niyakʉʉguna ʉsese. <verse eid="1CO 1:18" /><verse number="19" style="v" sid="1CO 1:19" />Kʉnsoko wandɨkwa wang'wi Itunda nʉwandɨkilwe,</para>
  <para style="q" vid="1CO 1:19">“Kʉagazangɨlya anyamahala ɨmahalao</para>
  <para style="q" vid="1CO 1:19">kʉluanga ʉlɨngi nʉwalɨngi.”<verse eid="1CO 1:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="1CO 1:20" />Ʉkolɨpɨ mʉntʉ nʉkete mahala? Ʉkolɨpɨ mʉntʉ nʉlɨngile malagɨɨlyo? Ʉkolɨpɨ nʉ mankata nʉwankʉngʉmi kʉ matungo aya? Mahala a antʉ amʉʉnkumbigʉlʉ ʉwʉ Itunda ʉailye kɨna ʉpʉngʉ ʉtilɨ.<verse eid="1CO 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 1:21" />Itunda ingɨ mʉhʉgu. Antʉ shanga ahumile kʉmʉlɨnga Itunda ɨzeasanilye mahala akɨʉntʉ. Itunda ʉtʉmɨe lʉkani lang'wa Yesʉ kʉaguna antʉ. Lʉkani ʉlo anyamahala nɨalʉaɨɨye kɨna ʉpungu, antʉ nɨahʉɨɨe ʉlʉkani nɨkʉlʉtanantya ɨgunɨka. <verse eid="1CO 1:21" /><verse number="22" style="v" sid="1CO 1:22" />Ayahudi aloilwe kɨlɨngasɨɨlyo ahume kʉhʉɨɨla, nɨ Ayunani akʉduma mahala ahume kʉhʉɨɨla. <verse eid="1CO 1:22" /><verse number="23" style="v" sid="1CO 1:23" />Ingɨ ʉsese kʉʉmʉtanantya ʉ Kilisito naɨʉkomilwe mʉmʉsalaba, kʉ Ayahudi ikani ɨli ingɨ lɨkʉanaʉla, nʉ kʉ Ayunani ingɨ ʉpʉngʉ ʉtilɨ, <verse eid="1CO 1:23" /><verse number="24" style="v" sid="1CO 1:24" />ingɨ kʉ antʉ awo nɨitangilwe ni Itunda atule Ayahudi ang'wɨ Ayunani, kʉ antʉ awa ʉ Kilisito ingɨ ngulu ang'wi Itunda hangɨ mahala ang'wi Itunda. <verse eid="1CO 1:24" /><verse number="25" style="v" sid="1CO 1:25" />Kʉnsoko antʉ nɨkʉaɨɨye kɨna ʉpʉngʉ wang'wi Itunda, ingɨ kɨsanigwe kʉkɨla mahala akɨʉntʉ, nʉ ʉnementalu wang'wi Itunda, ingɨ ngulu kʉkɨla ngulu niya kɨʉntʉ.<verse eid="1CO 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26" />Anyandʉgʉ ane, kɨmbʉki ɨlɨ kɨna Itunda naɨʉmitangile mʉtule mɨantʉ akwe, kisɨgo nɨla kɨʉntʉ aɨmʉaɨigwe kɨna ang'wɨ anyu mɨagila mahala. Antʉ ang'wɨ shanga aɨmʉkumʉkile kʉantʉ, antʉ ang'wɨ aɨmʉpumile mʉmakoe nɨmagila anga ʉhumi. <verse eid="1CO 1:26" /><verse number="27" style="v" sid="1CO 1:27" />Ingɨ Itunda aɨʉaholanilye antʉ awa nɨantʉ aʉnkumbigʉlʉ aaiye kɨna apʉngʉ, ɨngɨ waahumye mɨnyala antʉ nɨakete ɨmahala. Hangɨ Itunda aɨʉaholanilye antʉ awa nɨantʉ aʉnkumbigʉlʉ aaine kɨna agila anga ngulu ingɨ waahumye mɨnyala antʉ nɨakete ingulu. <verse eid="1CO 1:27" /><verse number="28" style="v" sid="1CO 1:28" />Itunda ʉaholanilye antʉ awa nɨahimbɨ hangɨ nɨadalahilwe nɨantʉ, antʉ nɨshanga akumʉkile, wahume kʉalagɨɨla antʉ awa nɨasanigwe ikʉlʉ kɨna shanga kɨntʉ. <verse eid="1CO 1:28" /><verse number="29" style="v" sid="1CO 1:29" />Ʉtendile itɨ ingɨ mʉntʉ waleke kilolya ntongela ang'wi Itunda kɨna nʉwanso ingɨ ʉsanigwe. <verse eid="1CO 1:29" /><verse number="30" style="v" sid="1CO 1:30" />Ingɨ Itunda ng'wenso ʉkʉkamɨnkanilye ʉnyenye nʉ Yesʉ Kilisito, Itunda ʉmʉtendile ʉ Kilisito Yesʉ watule mahala itʉ. Kʉkɨɨla Kilisito Yesʉ ʉsese kʉgombwe ni Itunda, kaile kɨantʉ ang'wi Itunda nɨkeigwe nʉkʉkomolwa mʉ mɨlandʉ. <verse eid="1CO 1:30" /><verse number="31" style="v" sid="1CO 1:31" />Kʉlʉlo gwa, anga wandɨkwa wang'wi Itunda nʉwandɨkilwe, “Nʉloilwe kilolya, Nʉiloelye mʉlɨmo nʉwitʉmile Isekʉlʉ.”<verse eid="1CO 1:31" /></para>
  <chapter eid="1CO 1" />
  <chapter number="2" style="c" sid="1CO 2" />
  <para style="s">Mpola yakʉkong'wa mumusala ʉ Yesʉi Kilisito</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1" />Anyandʉgʉ ane, ʉnene naɨnzile kʉng'wanyu kʉtanantya lʉkani nʉlatai nulang'wi Itunda shanga aɨnzile kʉmʉlagɨɨla kɨna nɨngile kʉtambula iza, ang'wɨ nkete mahala. <verse eid="1CO 2:1" /><verse number="2" style="v" sid="1CO 2:2" />Naɨnkoli kʉng'waanyu aɨnamʉe kɨwa kɨntʉ kɨhi nɨkanso nsaje kʉtambʉla mpola yang'wa Yesʉ Kilisito du niya nsha akwe naɨʉkomilwe mʉmʉsalaba. <verse eid="1CO 2:2" /><verse number="3" style="v" sid="1CO 2:3" />Naɨmolɨ kʉng'wanyu nɨkahanga shanga nkondanɨɨe kituma makani aya nʉ Kilisito ʉloilwe nitʉme, nɨkazekagata na woa nʉʉkʉlʉ. <verse eid="1CO 2:3" /><verse number="4" style="v" sid="1CO 2:4" />Ʉmanyisa nʉ ʉʉtanantyi wane shanga aɨnɨkendatambʉla nkani niyakʉaloeelya antʉ nɨmahala ane, ingɨ kʉtongeelwa nʉ Ng'wahʉ Ng'welʉ. <verse eid="1CO 2:4" /><verse number="5" style="v" sid="1CO 2:5" />Aɨntendile itɨ ingɨ ʉhʉʉɨli wanyu ʉleke kʉsania mahala a kɨʉntʉ ingɨ ngulu yang'wi Itunda.<verse eid="1CO 2:5" /></para>
  <para style="s">Mahala ang'wi Itunda</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6" />Nɨitɨ ga, ʉsese kɨmanyisa kʉtʉmɨla mahala kʉ antʉ nɨakomile mʉʉhʉɨɨli, ingɨ shanga mahala antʉ a mihɨɨ ɨyɨ, ang'wɨ shanga mahala a atemi a mihɨɨ ɨyɨ ʉtemi wao nʉɨlimansɨɨla. <verse eid="1CO 2:6" /><verse number="7" style="v" sid="1CO 2:7" />Kʉʉmatambʉla mahala ang'wi Itunda kʉ mpola niyatai, mahala aya Itunda naɨʉmapihile kʉ antʉ, Itunda aɨʉlomee kitʉma puma ʉng'wandyo kʉnsoko ikʉlyo litʉ. <verse eid="1CO 2:7" /><verse number="8" style="v" sid="1CO 2:8" />Ingɨ mahala aya atemi nɨa mihɨɨ ɨyɨ shanga aɨalɨngile, kʉnsoko anga aɨalɨnge shanga aɨazemʉkoma mʉmʉsalaba Isekʉlʉ nʉwa ʉkʉligwa. <verse eid="1CO 2:8" /><verse number="9" style="v" sid="1CO 2:9" />Ingɨ, anga wandɨkwa wang'wi Itunda nʉwandɨkilwe.</para>
  <para style="q" vid="1CO 2:9">“Makani ayo ɨliho nɨɨzelɨkɨlɨ kʉmaona, ang'wɨ kʉtwɨ ɨzewakɨlɨ kija,</para>
  <para style="q" vid="1CO 2:9">makani ʉ mʉntʉ nʉwakɨlɨ kʉmasɨgɨɨla mʉ nkolo akwe,</para>
  <para style="q" vid="1CO 2:9">makani nanso yayo Itunda nʉwanoneeye antʉ nɨamʉloilwe.”<verse eid="1CO 2:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="1CO 2:10" />Ingɨ Itunda ʉkʉkunʉkʉɨe makani nanso kʉ ʉhumi nʉwa Ng'wahʉ wakwe. Kʉnsoko Ng'wahʉ wɨkendegeela kɨntʉ kɨhi ga nɨ makani amʉkatɨ mʉng'wi Itunda. <verse eid="1CO 2:10" /><verse number="11" style="v" sid="1CO 2:11" />Nyenyu nʉlɨngile ɨmasɨgo a mʉntʉ mʉngɨɨza, ingɨ nkolo a mʉntʉ yɨyo ɨlɨngile. Nɨitɨ ga, Ng'wahʉ wang'wi Itunda ng'wenso ʉlɨngile makani ang'wi Itunda. <verse eid="1CO 2:11" /><verse number="12" style="v" sid="1CO 2:12" />Ʉsese aɨkʉsɨngɨɨye Ng'wahʉ wang'wi Itunda, shanga ng'wahʉ nʉwa mihɨɨ ɨyɨ, ingɨ kʉhume kʉlɨnga ayo nɨkʉpewe ni Itunda.<verse eid="1CO 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 2:13" />Itɨ gwa, ʉsese kʉʉmanyisa, shanga kʉnkani nɨkʉmanyisigwe kʉ mahala a antʉ, ingɨ nkani nɨkʉmanyisigwe nʉ Ng'wahʉ, kɨzemanyisa makani akɨnkolo kʉ antʉ nɨakete ʉ Ng'wahʉ nʉwanso. <verse eid="1CO 2:13" /><verse number="14" style="v" sid="1CO 2:14" />Mʉntʉ nɨmʉgila ʉNg'wahʉ wang'wi Itunda shanga ʉkʉsɨngɨɨlya ɨmakani aNg'wahʉ wang'wi Itunda. Kʉ mʉntʉ ʉyʉ makani nanso ingɨ ʉpʉngʉ ʉtilɨ, shanga ʉlɨngile mahala aya, kʉnsoko makani nanso ahumile kʉlɨngwa kʉkɨɨla ʉhumi nʉwa Ng'wahʉ wang'wi Itunda. <verse eid="1CO 2:14" /><verse number="15" style="v" sid="1CO 2:15" />Ingɨ mʉntʉ nʉtongilwe nʉ Ng'wahʉ wang'wi Itunda ʉhumile kʉgema nʉ kʉlamʉla makani mʉitakɨwe, ingɨ mʉntʉ nʉwanso shanga ʉkʉlamʉlwa nʉ mʉntʉ wɨhi. <verse eid="1CO 2:15" /><verse number="16" style="v" sid="1CO 2:16" />Mʉwandɨkwa wang'wi Itunda yandɨkilwe,</para>
  <para style="q" vid="1CO 2:16">“Nyenyu nʉkʉlɨnga ɨmahala ang'wi Isekʉlʉ?</para>
  <para style="q" vid="1CO 2:16">Nyenyu nʉkʉmʉɨla Itunda kɨntʉ kɨkakʉtenda?”</para>
  <para style="m" vid="1CO 2:16">Ingɨ ʉsese nɨkɨahʉɨɨli ang'wa Kilisito kʉkete mahala akʉsɨga anga ʉKilisito nʉwɨsɨga.<verse eid="1CO 2:16" /></para>
  <chapter eid="1CO 2" />
  <chapter number="3" style="c" sid="1CO 3" />
  <para style="s">Itʉmi ang'wi Isekʉlʉ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1" />Anyandʉgʉ ane, shanga aɨnʉmʉmanyisilye ʉnyenye anga antʉ nɨakete Ng'wahʉ wang'wi Itunda, ingɨ aɨnʉmʉmanyisilye ʉnyenye anga antʉ nɨagila Ng'wahʉ wang'wi Itunda anga ang'enya nɨadabʉ nɨakɨlɨ kʉmʉhʉɨɨla ʉKilisito. <verse eid="1CO 3:1" /><verse number="2" style="v" sid="1CO 3:2" />Aɨkʉmʉmanyisa nkani nɨmpepeele kʉlɨngwa anga mʉsʉngʉ nʉkonsha ʉng'wana maele shanga aɨkʉmʉlɨsa ndya nɨnkaku, aɨntendile itɨ kʉnsoko aɨmʉkɨlɨ mʉhume kʉlya ndya ninkaku, nɨtungo ɨlɨ ga mʉkɨlɨ kʉhuma, <verse eid="1CO 3:2" /><verse number="3" style="v" sid="1CO 3:3" />kʉnsoko ʉnyenye mʉkɨlɨ mʉtyatile ntendo niya mihɨɨ anga antʉ amihɨɨ ɨyɨ nɨatyatile. Itɨɨ, shanga taine kɨna mʉkɨlɨ mʉkete wɨlʉ nʉ wilei? Makani anga nanso akumʉʉe kɨna ʉnyenye mʉkɨlɨ mʉtyatile ntendo niya mihɨɨ, mʉtyatile ntendo niya antʉ amihɨɨ mʉkɨlɨ mʉlemigwe nɨ kɨlakulaku ka mʉɨlɨ. <verse eid="1CO 3:3" /><verse number="4" style="v" sid="1CO 3:4" />Kʉnsoko ʉng'wɨanyu anga walʉnge, “Ʉnene nʉmʉkee Paʉlo,” nʉmʉya walʉnge, “Ʉnene nʉmʉkee Apolo,” Itɨɨ, nɨmʉkʉtambʉla makani anga nanso mʉkɨlɨ mʉkitʉma anga antʉ nɨshanga amʉhʉɨɨe Itunda.<verse eid="1CO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5" />Itɨɨ, ʉApolo nyenyu? Nʉ Paʉlo nyenyu? Apolo nʉ nene ingɨ kɨitʉmi ʉdu Itunda naɨʉkʉlagɨɨye kʉng'wanyu mʉhume kʉmʉhʉɨɨla ʉ Yesʉi Kilisito. Ʉsese kɨhi kitʉmile mʉlɨmo naɨkʉpewe ni Isekʉlʉ. <verse eid="1CO 3:5" /><verse number="6" style="v" sid="1CO 3:6" />Ʉnene aɨntemee mbeʉ, nʉ Apolo wɨhɨla mazɨ, Itunda ingɨ ng'wenso ʉpumisilye nʉ kʉkʉlisa. <verse eid="1CO 3:6" /><verse number="7" style="v" sid="1CO 3:7" />Ingɨ mʉntʉ nʉtemee mbeʉ, nʉ mʉntʉ nʉwɨhɨe mazɨ antʉ awa shanga kɨntʉ. Kɨkʉlʉ ingɨ Itunda nʉwɨpumisa mbeʉ nʉ kʉkʉlisa. <verse eid="1CO 3:7" /><verse number="8" style="v" sid="1CO 3:8" />Mʉntʉ ʉyʉ nʉtemee nʉmʉntʉ ʉyʉ nʉwɨhɨla kʉtilɨ nʉmʉkɨlɨnkɨɨe ʉmʉya, antʉ awa ɨhi Itunda ʉkʉapa kɨnyamʉlɨmo kao anga mʉitʉmile. <verse eid="1CO 3:8" /><verse number="9" style="v" sid="1CO 3:9" />Kʉndogoelyo nanso ʉnene nʉ Apolo ingɨ kʉitʉma mʉlɨmo wang'wi Itunda, nʉnyenye ingɨ mɨmʉgʉnda wakwe.</para>
  <para style="p" vid="1CO 3:9">Hangɨ ʉnyenye mɨnyʉmba ang'wi Itunda. <verse eid="1CO 3:9" /><verse number="10" style="v" sid="1CO 3:10" />Kʉʉkende wang'wi Itunda nʉmpee ʉnene naina nɨang'wandyo kʉmʉletela mpola yang'wa Yesʉ anga mʉzengi nɨmʉkendegeeli nʉkʉhɨmba nʉkʉzenga mʉkuɨla, itungo ɨlɨ amanyisi angɨɨza akʉmanyisa mʉnkani niyanso anga mʉzengi mʉngɨɨza nʉkʉzenga mʉmʉkuɨla wʉwo. Itɨ gwa, mʉzengi wɨhi nʉwatule mʉkendegeeli nʉkʉzenga. <verse eid="1CO 3:10" /><verse number="11" style="v" sid="1CO 3:11" />Kʉlʉlo kʉtɨlɨ anga mʉzengi mʉngɨza nʉhumile kʉhɨmba nʉkʉzenga mʉkuɨla ʉngɨza, kʉnsoko mʉkuɨla nʉwakondile kʉhɨmbwa nʉkʉzengwa ingɨ Yesʉ Kilisito. <verse eid="1CO 3:11" /><verse number="12" style="v" sid="1CO 3:12" />Ingɨ anga mʉzengi nʉkʉzenga iza mʉ mʉkuɨla nʉwanso kʉ zahabu ang'wɨ kʉ nangʉ a Peza, ang'wɨ kʉ magwe ansaɨlo nkʉlʉ, mʉzengi nʉkʉzenga ibɨ wɨhanga anga mʉntʉ nʉkʉzengala mɨtɨ, ang'wɨ mapwa ang'wɨ matʉtʉ. <verse eid="1CO 3:12" /><verse number="13" style="v" sid="1CO 3:13" />Mʉlɨmo nʉwa mʉntʉ wɨhi ʉkigeela anga nʉwɨlɨ lʉhikʉ nʉla kʉtulya ʉKilisito. Lʉhikʉ nʉlanso lʉzile nʉ moto, moto nʉwanso ʉkʉgema nʉ kigeelya ʉza nʉwa mʉlɨmo nʉwanso. <verse eid="1CO 3:13" /><verse number="14" style="v" sid="1CO 3:14" />Anga ɨze mʉlɨmo nʉwa mʉntʉ nʉzengile mʉmʉkuɨla nʉwanso ʉkʉkɨɨligwa mʉ moto ʉleke kʉzigɨla, mʉntʉ nʉwanso ʉkʉpegwa kɨpegwa. <verse eid="1CO 3:14" /><verse number="15" style="v" sid="1CO 3:15" />Ingɨ anga ɨze mʉlɨmo nʉwa mʉntʉ nʉzengile ʉkʉzigɨla, mʉntʉ nʉwanso shanga ʉkʉpegwa ɨkɨpegwa kakwe, ingɨ mʉntʉ nʉwanso ʉkʉgunwa anga mʉntʉ nʉwipʉlʉpʉtilye mʉ moto nʉwa ʉlamʉlwi.<verse eid="1CO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16" />Itɨɨ, shanga mʉlɨngilene kɨna ʉnyenye mɨnyʉmba ang'wi Itunda, hangɨ kɨna Ng'wahʉ wang'wi Itunda wishiɨ mʉng'wanyu? <verse eid="1CO 3:16" /><verse number="17" style="v" sid="1CO 3:17" />Itɨ gwa, mʉntʉ anga wamɨgazanje ɨnyʉmba ang'wi Itunda, Itunda ʉkʉmʉgazanja. Kʉnsoko ɨnyʉmba ang'wi Itunda ɨbagʉwe kʉnsoko akwe, nɨnyʉmba ang'wi Itunda ingɨ ʉnyenye.<verse eid="1CO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18" />Leki kikongi. Mʉntʉ wɨhi nʉwiine ʉkete mahala mʉntendo niya mihɨɨ, bahu watule anga mʉpungʉ kʉnsoko wahume kʉlija mahala atai. <verse eid="1CO 3:18" /><verse number="19" style="v" sid="1CO 3:19" />Ntambʉe itɨ kʉndogoelyo, mahala aantʉ amihɨɨ ɨyɨ ingɨ ʉpʉngʉ pang'wi Itunda. Kʉnsoko yandɨkilwe mʉ wandɨkwa wang'wi Itunda itɨ, “Itunda wɨaambisa anyamahala mʉ ʉhʉgu nʉwao.” <verse eid="1CO 3:19" /><verse number="20" style="v" sid="1CO 3:20" />Nɨ hangɨ yandɨkilwe mʉ wandɨkwa wang'wi Itunda, “Isekʉlʉ ʉlɨngile kɨna masigo aanyamahala shanga kɨntʉ.” <verse eid="1CO 3:20" /><verse number="21" style="v" sid="1CO 3:21" />Itɨ gwa, mʉntʉ nʉwaleke kiketela ntendo nɨantʉ akʉtenda. Kʉndogoelyo nɨanso ɨhi aɨkilwe ni Itunda kʉʉaɨɨlya ʉsese. <verse eid="1CO 3:21" /><verse number="22" style="v" sid="1CO 3:22" />Leki kiketela makani nitʉmilwe itule Paʉlo ang'wi Apolo ang'wi Petelo ang'wɨ antʉ ɨhi mihɨɨ nʉ likalo nɨnsha nɨ makani ni itungo ɨlɨ makani napembilye, maintʉ aya ɨhi anyu, <verse eid="1CO 3:22" /><verse number="23" style="v" sid="1CO 3:23" />ʉnyenye ingɨ mɨantʉ ang'wa Kilisito, nʉ Kilisito ingɨ wang'wi Itunda.<verse eid="1CO 3:23" /></para>
  <chapter eid="1CO 3" />
  <chapter number="4" style="c" sid="1CO 4" />
  <para style="s">Itʉmi ang'wa Kilisito</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1" />Mʉntʉ nʉwakʉaɨlye ʉsese kɨitʉmi ang'wa Kilisito. Itunda ʉkʉlagɨɨye ʉsese kʉatambʉɨle antʉ mpola nɨakɨlɨ kʉɨlwa nʉ mʉntʉ wɨhi. <verse eid="1CO 4:1" /><verse number="2" style="v" sid="1CO 4:2" />Mʉntʉ wɨhi nʉpewe ʉmʉlɨmo ʉwʉ nʉwa kʉtanantya antʉ mpola yang'wi Itunda ingɨ ʉtakɨwe kʉtula mʉhʉɨɨli. <verse eid="1CO 4:2" /><verse number="3" style="v" sid="1CO 4:3" />Ʉnene ingɨ shanga nkee anga namʉlwe nʉnyenye kɨna nitumile mʉlɨmo ʉwʉ izane ang'wɨ ibɨne ang'wɨ namʉlwe nɨanza laantʉ, hangɨ ʉnene shanga kilamʉla. <verse eid="1CO 4:3" /><verse number="4" style="v" sid="1CO 4:4" />Ʉnene shanga nsɨgile kɨna nɨmʉgila igazo lɨhi, ɨngɨ shanga kɨna nɨmʉgila imamala. Isekʉlʉ ng'wenso ʉkʉnamʉla. <verse eid="1CO 4:4" /><verse number="5" style="v" sid="1CO 4:5" />Itɨ gwa, nakɨlɨ kʉpika matungo leki kʉmʉlamʉli mʉntʉ wɨhi, leki ipikɨɨle Isekʉlʉ nʉʉzɨɨzɨza. Nʉwanso ʉkʉpihʉla makani nɨmabɨ, nʉkigelya kɨhenga masɨgo amʉnkolo yaantʉ. Papo mʉntʉ wɨhi ʉkʉtula nʉlʉkumo lakwe kʉpuma kʉng'wi Itunda.<verse eid="1CO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6" />Anyandʉgʉ ane, makani aya nɨntambʉe nang'wa Apolo nɨmakani ane, ingɨ amʉaɨɨlye nʉkimanyisa, mʉlɨnge ndogoelyo antambʉ ɨyɨ, “Komanɨɨlyi aya naandɨkilwe.” Anga mʉtende itɨ, mʉng'wanyu shanga ʉkigela mʉntʉ wɨhi nʉkiketela mʉntʉ ʉng'wɨ nʉkʉmʉdalaha ʉmʉya. <verse eid="1CO 4:6" /><verse number="7" style="v" sid="1CO 4:7" />Nyenyu nʉkʉɨkile ʉewe ʉtule wɨmʉkʉlʉ? Kɨntʉ kɨ ʉewe nɨshanga ʉpewe ni Itunda? Anga ɨze ʉpewe, nɨkɨgwa nʉkiloelya anga kako?<verse eid="1CO 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8" />Aligwa, Mʉkidaya mikʉtane? Mʉkidaya mɨagolɨne? Mʉkidaya mɨatemine kʉleka ʉsese? Bahu anga ɨze tai maile mɨatemi, ingɨ nʉsese ga kʉtule kɨatemi palʉng'wɨ nʉnyenye. <verse eid="1CO 4:8" /><verse number="9" style="v" sid="1CO 4:9" />Nsɨgile Itunda ʉkʉtendile ʉsese nɨkɨitʉmi kʉtule kɨantʉ akʉdalahwa lʉkʉlʉ, anga antʉ nɨalamʉwe kʉbʉlagwa kʉnsoko kaina kɨantʉ akʉhekwa mʉnkumbigʉlʉ wɨhi ntongela amalaɨka nɨ antʉ. <verse eid="1CO 4:9" /><verse number="10" style="v" sid="1CO 4:10" />Antʉ ɨdʉ akʉine ʉsese kɨapʉngʉ kʉnsoko akʉmitʉmɨla Kilisito, ingɨ ʉnyenye mɨanyamahala kʉkamɨnkana nʉ Kilisito! Ʉsese kɨagila ingulu, ʉnyenye mʉkete ingulu! Ʉnyenye mʉkʉkʉligwa, ʉsese kʉdalahilwe. <verse eid="1CO 4:10" /><verse number="11" style="v" sid="1CO 4:11" />Sambʉ nʉyʉ, ʉsese kʉhumilwe nzala nɨnyota, kɨagila anga matugalo, kikumbile nkundi kɨagila anga ndalo, <verse eid="1CO 4:11" /><verse number="12" style="v" sid="1CO 4:12" />hangɨ kʉiaja nʉkitʉma ɨmɨlɨmo kʉmɨkono itʉ. Anga kʉtʉkɨlwe, kɨka akembeta, anga kagigwe, kɨgimya, <verse eid="1CO 4:12" /><verse number="13" style="v" sid="1CO 4:13" />anga kʉtungigwe kɨsʉkɨlya kʉ wininompyi. Itungo nɨlɨ antʉ akʉgeile anga mpaala mʉnkumbigʉlʉ, hangɨ kʉ mʉntʉ wɨhi ʉsese kɨmpaala!<verse eid="1CO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14" />Shanga kʉmʉandɨkɨla ɨmakani aya kʉnsoko akʉmʉhumya mɨnyala ʉnyenye, ingɨ kʉnsoko akʉmʉmanyisa ʉnyenye nɨmɨana ane nɨ nʉmʉloilwe. <verse eid="1CO 4:14" /><verse number="15" style="v" sid="1CO 4:15" />Palʉng'wɨ nɨ kɨna mʉkete amanyisi maelupu nɨakʉmʉletela lʉkani lang'wa Kɨlisito, tata wanyu ingɨ ʉng'wɨ du. Ʉnene aɨnɨ tata wanyu mʉng'wa Kilisito kʉnsoko aɨnʉmʉletee Nkani Nza. <verse eid="1CO 4:15" /><verse number="16" style="v" sid="1CO 4:16" />Kʉlʉlo kʉminena, tyati anga ʉnene nɨnɨtenda. <verse eid="1CO 4:16" /><verse number="17" style="v" sid="1CO 4:17" />Yɨyo ndogoelyo nʉmʉlagɨɨye ʉTimoteo kʉng'wanyu, nʉwanso ingɨ ng'waane nɨnʉmʉloilwe hangɨ nʉgombekile mʉʉkamɨnkani ni Isekʉlʉ. Nʉwanso ʉkʉmʉkɨmbʉsha nzɨla nɨtyatile kʉ ʉkamɨnkani nʉ Kilisito, nzɨla nɨkɨmanyisa mʉ maumbɨ aantʉ nɨahʉɨɨli ang'wi Itunda.<verse eid="1CO 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18" />Antʉ ang'wɨ mʉng'wanyu ainaɨlʉgoha ageile kɨna shanga nzile hangɨ kʉng'wanyu. <verse eid="1CO 4:18" /><verse number="19" style="v" sid="1CO 4:19" />Ingɨ Isekʉlʉ anga walowe, kʉkaya kɨza kʉng'wanyu, papo kʉlowa kiloeela ʉnene shanga kʉlɨnga yaya nɨakʉtambʉla du ingɨ nʉ kʉlɨnga ngulu a ʉhʉɨɨli wao, nɨkɨ ga nɨahumile kitʉma. <verse eid="1CO 4:19" /><verse number="20" style="v" sid="1CO 4:20" />Kʉndogoelyo ʉtemi wang'wi Itunda shanga wankani ntilɨ, ingɨ kishiɨ nʉ kʉtula ningulu yang'wi Itunda. <verse eid="1CO 4:20" /><verse number="21" style="v" sid="1CO 4:21" />Itɨɨ, lamʉli nyenye? Nɨze kʉng'wanyu nʉmʉlangane, ang'wɨ nɨze nɨnkolo aʉlowa nʉ wininompyi?<verse eid="1CO 4:21" /></para>
  <chapter eid="1CO 4" />
  <chapter number="5" style="c" sid="1CO 5" />
  <para style="s">Ʉgoolya ʉgiigwe mʉantu nɨamʉhʉɨɨe ʉKilisito</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1" />Nigulye mpola ni ya tai kɨna mʉng'wanyu ʉmolɨ ʉgoolya, hangɨ ʉgoolya nʉʉbɨ naɨ ʉkɨlɨ wɨgele mʉantʉ nɨshanga amʉmanyile Itunda. Ntambʉɨwe age mʉntʉ ʉng'wɨ mʉng'wanyu ʉmʉtɨnile ʉmʉsʉngʉ wang'wihe! <verse eid="1CO 5:1" /><verse number="2" style="v" sid="1CO 5:2" />Kʉnɨkɨ mʉkiketa? Shanga mʉaalɨkile mʉnkolo nʉ kʉmʉheje mʉng'wanyu mʉntʉ nʉɨtenda makani nanso. <verse eid="1CO 5:2" /><verse number="3" style="v" sid="1CO 5:3" />Nʉnene, shanga kɨpalʉng'wɨ nʉnyenye, nɨitɨga kɨnkolo nkolɨ palʉng'wɨ nʉnyenye, hangɨ, nakondya kʉmʉlamʉla mʉntʉ naza ʉtendile ikani ɨlɨ nɨlamɨnyala, aza nzeetenda ʉ anga azantule nkolɨ kʉko, <verse eid="1CO 5:3" /><verse number="4" style="v" sid="1CO 5:4" />Matungo nɨmʉkilʉnda palʉng'wɨ kʉmʉkʉlya Isekʉlʉ witʉ ʉ Yesʉi, ʉnene nkolɨ palʉng'wɨ nʉnyenye mʉ Ng'wahʉ, kʉ ʉhumi wang'wi Isekʉlʉ witʉ ʉ Yesʉi, <verse eid="1CO 5:4" /><verse number="5" style="v" sid="1CO 5:5" />mʉntʉ nʉwanso mʉkagɨɨli kʉng'wa Shetani waʉkʉe mʉɨlɨ wakwe, nkolo akwe ingɨ ɨhume kʉgunwa ʉlʉhikʉ nʉla kʉtulya Isekʉlʉ. <verse eid="1CO 5:5" /><verse number="6" style="v" sid="1CO 5:6" />Wiketi wanyu ʉgila anga kɨntʉ kɨhi! Itɨɨ, shanga mʉlɨngilene kɨna amila nsheenyu ɨgasisa kɨgao kɨhi nɨka utu wangano? <verse eid="1CO 5:6" /><verse number="7" style="v" sid="1CO 5:7" />Tendi nkolo yanyu yigombeke kʉng'wi Itunda kʉkɨɨla kʉmʉheja mʉntʉ nʉmʉbɨ mʉng'wanyu anga kʉheja amila mʉkɨgao ka utu wangano nʉʉkandilwe. Ingɨ mʉtule anga kɨgao kɨhi nɨka utu wangano nɨshanga kɨgasile. Ndogoeelyo Kilisito nɨɨza ng'waa nkolo witʉ nʉwa pasaka wapumigwa kʉtula ipolyo. <verse eid="1CO 5:7" /><verse number="8" style="v" sid="1CO 5:8" />Kʉlʉlo itungo ɨlɨ kʉleke kʉnoneelya iloeelya nɨla Pasaka kʉ amila nakalɨ, amila namasɨgo mabɨ nʉkitʉma ʉbɨ. ingɨ kʉ mɨkate nɨshanga ɨgahɨigwe, nʉwanso wʉwo welʉ nʉwa kɨnkolo nɨtai.<verse eid="1CO 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9" />Mitʉtʉ aɨnʉmʉandɨkɨe kʉ mahala ane kɨna mʉleke kihanja nɨagoolya. <verse eid="1CO 5:9" /><verse number="10" style="v" sid="1CO 5:10" />Shanga ntambʉe kɨna kʉleka mʉleke kihanja nɨantʉ ɨhi mihɨɨ ɨyɨ anga nɨagoolya nɨantʉ nɨabɨ ankolo nɨateele hangɨ nɨɨkʉlya adʉdʉ. Ndogoelyo kʉtemanʉka nɨantʉ nɨanso ɨhi aza izeemʉsasha kʉhama lʉkʉlʉ mʉʉnkumbigʉlʉ ʉwʉ. <verse eid="1CO 5:10" /><verse number="11" style="v" sid="1CO 5:11" />Naɨnɨkɨandɨkɨle ingɨ sɨkɨ, mʉleke kihanja nɨ antʉ nɨɨza ahʉɨɨli ang'wa Yesʉ anga ʉnyenye kʉnʉ agoolyi nɨ abɨ ankolo nɨ akʉlya adʉdʉ nɨ akinyɨli nɨ agala ntʉlɨ nɨ ateele. Antʉ anga nɨanso leki nʉkʉlɨzania.<verse eid="1CO 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12" />Itɨɨ mʉlɨmo wane kʉalamʉla antʉ nɨshanga ahʉɨɨli ang'wa Yesʉ? Nɨanso Itunda ʉkʉalamʉla. Itɨɨ? ʉnyenye mʉgombigwene kʉalamʉla antʉ nɨakolɨ mʉ mʉhangʉ nʉwa ahʉɨɨli anga niyandɨkilwe, “Mʉheji ʉmʉntʉ nɨmʉbɨ mʉng'wanyu.” <verse eid="1CO 5:12" /><verse number="13" style="v" sid="1CO 5:13" />Mʉsensekelyi kʉlɨ mʉntʉ nɨmʉbɨ.<verse eid="1CO 5:13" /></para>
  <chapter eid="1CO 5" />
  <chapter number="6" style="c" sid="1CO 6" />
  <para style="s">Leki kisemeli mʉ maanza</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1" />Anga mʉntʉ wilee nʉ mʉlʉna ʉkʉgemaʉlɨ kʉmʉsemela kianza nɨla antʉ nɨshanga amʉhʉɨɨe Yesʉ nsuta nʉ kʉmʉsemela kʉ antʉ nɨamʉhʉɨɨe ʉ Yesʉi. Nɨkɨ waleke kʉmʉsemela mʉntʉ nʉwanso ntongela aantʉ nɨamʉhʉɨɨe Itunda? <verse eid="1CO 6:1" /><verse number="2" style="v" sid="1CO 6:2" />Itɨɨ, shanga mʉlɨngilene kɨna ahʉɨɨli ang'wa Yesʉ akʉalamʉla antʉ aʉnkumbigʉlʉ? Anga ɨze antʉ aʉnkumbigʉlʉ ʉkʉlamʉlwa nʉnyenye, nɨkɨ shanga mʉkʉlamʉla makani nɨ manino? <verse eid="1CO 6:2" /><verse number="3" style="v" sid="1CO 6:3" />Itɨɨ, shanga mʉlɨngile kɨna mʉkʉalamʉla ga nɨa malaɨka, mʉkʉleng'wa ʉlɨ kʉlamʉla makani nɨ manino na mahikʉ ɨhi? <verse eid="1CO 6:3" /><verse number="4" style="v" sid="1CO 6:4" />Nɨmʉkete wilei mʉ makani anyu nɨ maniino, nɨkɨ mʉkisemela kʉ antʉ nɨshanga agombekile kʉ antʉ nɨamʉhʉɨɨe ʉ Yesʉi? <verse eid="1CO 6:4" /><verse number="5" style="v" sid="1CO 6:5" />Hung'wi mɨnyala! Kʉlʉnge kʉtilɨ ga nʉyʉ nʉng'wɨ mʉng'wanyu nʉkete mahala nʉhumile kʉhunga makani na anyandʉgʉ nɨamʉhʉɨɨe ʉKilisito. <verse eid="1CO 6:5" /><verse number="6" style="v" sid="1CO 6:6" />Kɨmɨkɨli kakwe, tai yatula wɨda mʉntʉ nʉmʉhʉɨɨe ʉ Yesʉi kʉmʉsemela mʉluna kianza nɨla antʉ nɨshanga ahʉɨɨe ʉ Yesʉi!<verse eid="1CO 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7" />Kʉtai kisemela itɨ nyenye atilɨ ilɨngɨkile kɨna maleng'wa lʉkʉlʉ. Itɨɨ, nɨkɨ ʉnyenye mʉleke kʉgomba kʉtendeelwa ʉbɨ? Shanga bahune kʉhegeligwa ɨnsao yanyu? <verse eid="1CO 6:7" /><verse number="8" style="v" sid="1CO 6:8" />Ingɨ kɨmɨkɨli kakwe, nyenye mʉkʉatendeela ʉbɨ, mʉkʉhegeligwa ɨnsao ahʉɨɨli ɨanyu! <verse eid="1CO 6:8" /><verse number="9" style="v" sid="1CO 6:9" />Ang'wɨ itɨɨ, shanga mʉlɨngilene kɨna ɨantʉ nɨabɨ shanga akingɨla mʉ ʉtemi wang'wi Itunda. Antʉ nɨ asambo nɨ akʉlya adʉdʉ nɨ agoolya ang'wɨ agoha nɨigoolya agoha <verse eid="1CO 6:9" /><verse number="10" style="v" sid="1CO 6:10" />nɨ antʉ nɨia nɨabɨ ankolo nɨagala ntʉlɨ nɨategetani nɨahegelani nɨanso ɨhi shanga akingɨla mʉ ʉtemi wang'wi Itunda. <verse eid="1CO 6:10" /><verse number="11" style="v" sid="1CO 6:11" />Mʉng'wanyu nɨang'wɨ aɨmɨtendaʉ. Ingɨ itungo ɨlɨ witʉ kʉkɨɨla Isekʉlʉ ʉ Yesʉi Kilisito melisigwe ʉʉbɨ wanyu, maholanigwe nʉkʉaligwa kɨna magombeka pantongeela ang'wi Itunda kʉ lina lang'wi Isekʉlʉ ʉ Yesʉi Kilisito nʉkʉ Ng'wahʉ wang'wi Itunda<verse eid="1CO 6:11" /></para>
  <para style="s">Tʉmɨli mɨɨlɨ anyu ki ikʉkʉlyo lang'wi Itunda</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12" />Mʉntʉ ʉhumile kʉlʉnga, “Ngombigwe kitʉma maɨntʉ ɨhi mʉndoewe.” Ʉzaʉ, ingɨ shanga kɨntʉ kɨhi kɨza. Ngombile kɨna ngombigwe kitʉma maɨntʉ ɨhi mʉndoewe ingɨ shanga ngombile kʉtongwa nɨ kɨntʉ kɨhi. <verse eid="1CO 6:12" /><verse number="13" style="v" sid="1CO 6:13" />Ʉhumile kʉlʉnga itɨ, “Indya ingɨ kʉnsoko anda, nɨnda kʉnsoko andya.” Ʉzaʉ, ingɨ Itunda ʉkʉiheja yɨhi mʉbɨɨlɨ. Mʉɨlɨ nʉwa mʉntʉ shanga kʉnsoko aʉgoolya ingɨ kʉnsoko akʉmitʉmɨla Isekʉlʉ nʉng'wenso Isekʉlʉ ingɨ wɨlilaa ɨmɨɨlɨ itʉ nʉkʉmɨlɨsa. <verse eid="1CO 6:13" /><verse number="14" style="v" sid="1CO 6:14" />Itɨ gwa, Itunda aɨʉmiʉkilye Isekʉlʉ Yesʉ, ʉkʉʉiʉla nʉsese kʉngulu yakwe.<verse eid="1CO 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 6:15" />Itɨɨ, shanga mʉlɨngilene kɨna ɨmɨɨlɨ anyu mapiliga amʉɨlɨ wang'wa Kilisito? Itɨɨ, mʉlɨye nihumile kʉhola mʉmʉɨlɨ wang'wa Kilisito nʉkʉtula mʉɨlɨ nʉwa mʉgoolyi? Shangaʉ! <verse eid="1CO 6:15" /><verse number="16" style="v" sid="1CO 6:16" />Ndogoelyo, anga nɨmʉlɨngile, mʉntʉ wɨhi nʉɨwɨgoolya nʉ mʉgoolya wɨtula mʉɨlɨ ʉng'wɨ nʉng'wenso, anga niyandɨkilwe, “Nɨenso nɨabɨɨlɨ akʉtula mʉɨlɨ ʉng'wɨ.” <verse eid="1CO 6:16" /><verse number="17" style="v" sid="1CO 6:17" />Ingɨ kʉkamɨnkana nʉ Isekʉlʉ wɨtula nkolo ɨng'wɨ nʉng'wenso.<verse eid="1CO 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18" />Itɨ gwa leki kʉgoolyi. Mɨlandʉ mɨʉya ɨhi mʉntʉ witʉma kʉnzi amʉɨlɨ wakwe, ingɨ mʉtʉ nʉwigoolya witʉma mʉlandʉ mʉmʉɨlɨ nʉwakwe. <verse eid="1CO 6:18" /><verse number="19" style="v" sid="1CO 6:19" />Itɨɨ, shanga mʉlɨngilene ɨmɨɨlɨ anyu ingɨ nyʉmba aNg'wahʉ wang'wi Itunda nʉwishiɨ mʉ nkolo yanyu, naɨmʉpewe kʉpuma kʉng'wi Itunda? Itɨ gwa mɨɨlɨ anyu shanga anyu ingɨ nsao ang'wi Itunda. <verse eid="1CO 6:19" /><verse number="20" style="v" sid="1CO 6:20" />Kʉnsoko aɨmʉgʉilwe kʉ nsao nɨnkʉlʉ. Kʉlʉlo tʉmɨli mɨɨlɨ anyu kikʉlyo lang'wi Itunda.<verse eid="1CO 6:20" /></para>
  <chapter eid="1CO 6" />
  <chapter number="7" style="c" sid="1CO 7" />
  <para style="s">Ʉmanyisi nʉwa witɨni</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1" />Itungo ɨlɨ, tɨgi nʉmʉsʉkɨɨlye nkani naɨmʉnandɨkɨe.</para>
  <para style="p" vid="1CO 7:1">Aɨmʉnkoiye izane mitʉnja anga waleke kʉtɨna. <verse eid="1CO 7:1" /><verse number="2" style="v" sid="1CO 7:2" />Ingɨ kʉnsoko aʉgoolyi, ʉgwa, mitʉnja wɨhi nʉwatule nʉ mʉsʉngʉ wakwe ʉng'wenso nʉ mʉsʉngʉ wɨhi nʉwatule nʉ mʉgoha wakwe ʉng'wenso. <verse eid="1CO 7:2" /><verse number="3" style="v" sid="1CO 7:3" />Mʉgoha nʉwamʉtendeele ʉmʉsʉngʉ wakwe anga mʉitakɨwe nʉ mʉsʉngʉ nʉwamʉtendeele ʉmʉgoha wakwe anga mʉitakɨwe. <verse eid="1CO 7:3" /><verse number="4" style="v" sid="1CO 7:4" />Mʉsʉngʉ nʉtɨnilwe shanga ʉhumile kʉʉtendeela mʉɨlɨ wakwe anga mʉtakɨe ingɨ mʉgoha wakwe nʉ mʉgoha nʉtɨnile shanga ʉhumile kʉʉtendeela mʉɨlɨ wakwe anga mʉtakɨe ingɨ mʉsʉngʉ wakwe. <verse eid="1CO 7:4" /><verse number="5" style="v" sid="1CO 7:5" />Mʉleke kiima, ingɨ anga migombye kʉleka kitungo ʉdu mʉhume kʉlija lyoma nɨlakʉmʉkʉlya Itunda. Panyambele misʉkɨle hangɨ ingɨ shetani waleke kʉmʉgema kʉnsoko akʉleng'wa kʉgimya.<verse eid="1CO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 7:6" />Ntambʉe itɨ ingɨ kʉmʉsɨja ʉdu shanga kʉmʉsinja. <verse eid="1CO 7:6" /><verse number="7" style="v" sid="1CO 7:7" />Azandoilwe antʉ ɨhi atule anga nene, ingɨ mʉntʉ wɨhi ʉkete kɨpegwa kakwe kʉpuma kʉng'wi Itunda, mʉntʉ mʉya ʉpewe kɨpegwa ɨkɨ nʉ mʉya ʉpewe kɨpegwa kɨko.<verse eid="1CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8" />Itungo ɨlɨ, kʉaɨla awa nɨshanga atɨnile nʉmʉsʉngʉ nʉshɨɨwe nʉmʉgoha aza iza ishiɨ anga ʉnene nɨnɨlɨ. <verse eid="1CO 7:8" /><verse number="9" style="v" sid="1CO 7:9" />Mʉntʉ anga waleng'we kʉgimya itɨ, nʉwatɨne nʉkʉtɨnwa. Ingɨ bahu kʉtɨna ang'wɨ kʉtɨnwa kʉkɨla kʉhung'wa nsʉla.<verse eid="1CO 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10" />Kʉ mʉntʉ nʉtɨnile nkete ilagɨɨlyo, hangɨ shanga ilagɨɨlyo lane, ingɨ ilagɨɨlyo lang'wi Isekʉlʉ, mʉsʉngʉ nʉwaleke kileka nʉmʉgoha wakwe, <verse eid="1CO 7:10" /><verse number="11" style="v" sid="1CO 7:11" />ingɨ anga ileke nʉng'wenso, nʉwasigeʉ waleke kʉtɨnwa kʉngɨɨza, anga ɨza shangaʉ wigombye nʉkisʉkɨla nʉmʉgoha wakwe, mʉgoha nʉng'wenso nʉwaleke kʉmʉleka ʉmʉsʉngʉ wakwe.<verse eid="1CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12" />Itungo ɨlɨ kʉligitya nɨantʉ nɨangɨza naɨatɨnile azeakɨlɨ kʉmʉhʉɨla ʉ Yesʉi, aya nɨkʉtambʉla shanga Isekʉlʉ ʉtambʉe ingɨ masigo ane ʉdu, mʉgoha nɨmʉhʉɨɨli wang'wa Yesʉ nʉtɨnile mʉsʉngʉ nɨshanga mʉhʉɨɨli wang'wa Yesʉ nʉ mʉsʉngʉ nʉwanso ʉgombile kishiɨ nʉng'wenso, nʉwaleke kʉmʉleka. <verse eid="1CO 7:12" /><verse number="13" style="v" sid="1CO 7:13" />Hangɨ, mʉsʉngʉ ang'wɨ mʉhʉɨɨli wang'wa Yesʉ ʉtɨnilwe nʉmʉgoha shanga mʉhʉɨɨli wang'wa Yesʉ nʉmʉgoha nʉwanso ʉgombile kishiɨ nʉng'wenso, itɨ gwa, nʉwaleke kʉmʉleka ʉmʉgoha wakwe. <verse eid="1CO 7:13" /><verse number="14" style="v" sid="1CO 7:14" />Ndogoelyo ʉmʉgoha nʉwanso nɨshanga mʉhʉɨɨli wang'wa Yesʉ wɨgombwa ni Itunda kʉkɨɨla mʉsʉngʉ wakwe, nʉ mʉsʉngʉ nɨshanga ʉhʉɨɨe wɨgombwa ni Itunda kʉkɨɨla mʉgoha wakwe. Anga ɨze shangaʉ ana anyu shanga akʉsɨngɨɨligwa ni Itunda, katɨ itungo ɨlɨ ɨana ana ang'wi Itunda. <verse eid="1CO 7:14" /><verse number="15" style="v" sid="1CO 7:15" />Nɨ itɨ ga, ang'wɨ ʉyʉ nɨshanga mʉhʉɨɨli wang'wa Yesʉ ʉloilwe kileka nʉyʉ nɨ mʉhʉɨɨli wang'wa Yesʉ, nʉwa mʉleke ʉdu. Pang'wanso mʉhʉɨɨli wang'wa Yesʉ ʉyʉ shanga ʉgiɨigwe nʉ witɨni nʉwanso. Ndogoelyo Itunda ʉmitangile ʉnyenye mishiɨ kʉ matiliga. <verse eid="1CO 7:15" /><verse number="16" style="v" sid="1CO 7:16" />Ʉewe mʉsʉngʉ nʉmʉhʉɨɨe ʉ Yesʉi, shanga ʉhumile kʉlɨnga kɨna ʉhumile kʉmʉguna ʉmʉgoha wako. Ang'wɨ ʉewe mʉgoha nʉmʉhʉɨɨe ʉ Yesʉi, shanga ʉhumile kʉlɨnga kɨna ʉhumile kʉmʉguna ʉmʉkɨmako kʉnsoko aʉhʉɨɨli nʉwako.<verse eid="1CO 7:16" /></para>
  <para style="s">Ishii anga naɨmitangilwe Itunda</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17" />Mʉntʉ wɨhi nʉishiɨ anga Isekʉlʉ naɨʉmʉpangɨe naɨwakɨlɨ kitangwa ni Itunda. Ɨlɨ lɨlɨ ilagɨɨlyo lane kʉ maumbɨ ɨhi na antʉ nɨamʉhʉɨɨe ʉ Yesʉi. <verse eid="1CO 7:17" /><verse number="18" style="v" sid="1CO 7:18" />Anga ɨze mʉntʉ aɨwitangilwe waze wakɨlɨ kʉtalwa kiganda, nʉwaleke kisɨngɨɨla kɨna wakɨlɨ kʉtalwa kiganda, ang'wɨ mʉntʉ naɨʉkitangwa aɨwatawe kiganda, nʉwaleke kʉtalwa kiganda. <verse eid="1CO 7:18" /><verse number="19" style="v" sid="1CO 7:19" />Kʉtalwa kiganda ang'wɨ kʉhita kʉtalwa kiganda shanga kɨntʉ, nɨkɨkʉlʉ ingɨ kʉamba malagɨɨlyo ang'wi Itunda. <verse eid="1CO 7:19" /><verse number="20" style="v" sid="1CO 7:20" />Itɨ gwa, mʉntʉ wɨhi nʉwasage anga naɨwɨlɨ itungo naɨʉkitangwa. <verse eid="1CO 7:20" /><verse number="21" style="v" sid="1CO 7:21" />Itɨɨ, ʉewe itungo naɨwitangilwe ni Itunda aɨwɨmʉtʉʉng'wane? Ʉzaʉ, leka kʉkela, ingɨ anga ʉlije ɨlyoma, litʉmɨle. <verse eid="1CO 7:21" /><verse number="22" style="v" sid="1CO 7:22" />Ndogoelyo mʉntʉ nʉitangilwe ni Isekʉlʉ anga ɨze mʉtʉʉng'wa witula mʉntʉ nʉwidesile kʉng'wa Isekʉlʉ. Nʉyʉ ga naɨwitangilwe waze widesile, witula mʉtʉʉng'wa wang'wa Kilisito. <verse eid="1CO 7:22" /><verse number="23" style="v" sid="1CO 7:23" />Mɨhi mʉgʉilwe nʉ Kilisito kʉ nsaɨlo, kʉlʉlo mʉleke hangɨ kʉtula mɨatʉʉng'wa amʉntʉ. <verse eid="1CO 7:23" /><verse number="24" style="v" sid="1CO 7:24" />Anyandʉgʉ ane, mʉntʉ wɨhi nʉwishiɨ anga naɨwɨlɨ apo naɨʉkitangwa ni Itunda.<verse eid="1CO 7:24" /></para>
  <para style="s">Kʉ itunja nɨshanga atɨnile nɨasʉngʉ nɨashɨɨwe nɨagoha</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25" />Itungo ɨlɨ kʉaandɨkɨla ananso nɨakɨlɨ kʉtɨnwa, ʉnene nɨmʉgila anga ilagɨɨlyo kʉpuma kʉng'wi Isekʉlʉ, ingɨ nene kʉmʉsɨja kʉkɨaisa kang'wi Isekʉlʉ mʉtakɨwe kʉhʉɨɨla ʉlʉkani lane.<verse eid="1CO 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 7:26" />Kʉnsoko alwago nʉlʉkolɨ, nsɨgile kɨna iza mʉntʉ wasage anga nʉwɨlɨ. <verse eid="1CO 7:26" /><verse number="27" style="v" sid="1CO 7:27" />Itɨɨ, anga ɨze ʉtɨnile. leka kileka nʉmʉsʉngʉ nʉwako. Ʉewe nɨshanga ʉtɨnile. Itɨ gwa, leka kʉtɨna. <verse eid="1CO 7:27" /><verse number="28" style="v" sid="1CO 7:28" />Ingɨ anga ʉtɨne shanga witʉmile anga mʉlandu, nʉmʉnanso anga watɨnwe shanga witʉmile anga mʉlandu. Antʉ nɨakitɨna akʉtula nʉlwago nʉla mʉnkumbigʉlʉ ʉwʉ, ʉnene ingɨ azandoilwe ʉlwago nʉlanso lʉleke kʉmʉhanga ʉnyenye.<verse eid="1CO 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29" />Anyandʉgʉ ane, ndoilwe nʉnge itɨ, matungo makʉpɨ nasagile, kʉpuma itungo lɨlɨ antʉ nɨatɨnile nɨishiɨ anga shanga atɨnile, <verse eid="1CO 7:29" /><verse number="30" style="v" sid="1CO 7:30" />antʉ nɨakʉlɨla atule anga shanga akʉlɨla, nɨantʉ nɨaloilwe atule anga shanga aloilwe, antʉ nɨakʉgʉla atule anga agila anga kɨntʉ, <verse eid="1CO 7:30" /><verse number="31" style="v" sid="1CO 7:31" />nɨantʉ nɨakete ɨmɨlɨmo mʉnkumbigʉlʉ ʉwʉ atule anga agila mɨlɨmo lʉkʉlʉ. Kʉnsoko ʉnkumbigʉlʉ ʉwʉ anga nɨkʉine ʉkʉkɨla.<verse eid="1CO 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32" />Ndoilwe ʉnyenye mʉleke kogopa. Mʉntʉ nɨshanga ʉtɨnile wipumya kitʉma mʉlɨmo wang'wi Isekʉlʉ wahume kʉmʉloeelya Isekʉlʉ. <verse eid="1CO 7:32" /><verse number="33" style="v" sid="1CO 7:33" />Mitʉnja nʉtɨnile witʉma makani amʉnkumbigʉlʉ ingɨ wahume kʉmʉloeelya mʉsʉngʉ wakwe, <verse eid="1CO 7:33" /><verse number="34" style="v" sid="1CO 7:34" />hangɨ ɨkolɨ nsuta kʉ mʉsʉngʉ nʉtɨnilwe nʉ mʉnanso. Mʉnanso witʉma makani ang'wi Isekʉlʉ wipumya mʉɨlɨ nɨ nkolo akwe wahume kʉmʉloeelya Isekʉlʉ, ingɨ mʉsʉngʉ nʉtɨnilwe witʉma makani amʉnkumbigʉlʉ ʉwʉ wahume kʉmʉloeelya mʉgohakwe.<verse eid="1CO 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 7:35" />Kʉmʉtambʉɨla nkani izi nihume kʉmʉaɨɨlya shanga kʉmʉgilya. Ingɨ ndoilwe mishiɨ iza ingɨ mʉhume kʉmitʉmɨla Isekʉlʉ kʉ nkolo ɨng'wɨ.<verse eid="1CO 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36" />Anga ɨze mʉgoha ʉkʉona kɨna shanga ʉkʉmʉtendeela iza mʉnanso nʉmʉligilye anga wahite kʉmʉtɨna, nɨ myaka akʉtɨnwa ɨlongolekile, nʉng'wenso nsʉla akwe ɨkʉmʉlema, nʉwatende mʉloewe ingɨ nʉwatɨne ʉdu. Pang'wanso shanga ʉkʉtula witʉmile mɨlandʉ. <verse eid="1CO 7:36" /><verse number="37" style="v" sid="1CO 7:37" />Anga mʉgoha nʉwanso walamʉle mʉnkolo kʉhita kʉtɨna hangɨ ang'wɨ ʉhumile kigilya nsʉla akwe nʉkʉlamʉla witʉme ntʉni, itɨgwa, ʉkʉtula witʉma iza anga wahite kʉmʉtɨna ʉmʉnanso ʉyʉ. <verse eid="1CO 7:37" /><verse number="38" style="v" sid="1CO 7:38" />Kʉlʉlo, mʉgoha ʉyʉ nʉkʉlamʉla kʉtɨna ʉkitʉma iza, nʉyu nʉkʉlamʉla kʉhita kʉtɨna ʉkitʉma izambele. <verse eid="1CO 7:38" /><verse number="39" style="v" sid="1CO 7:39" />Mʉsʉngʉ nʉtɨnilwe ʉkʉtula ʉtungilwe nɨmalagɨɨlyo awitɨni ʉmʉgoha nʉwakɨlɨ kʉsha, ingɨ mʉgoha wakwe anga washe ʉmʉsʉngʉ widesa, anga walowe ʉkʉtɨnwa nʉ mʉgoha wihi, ingɨ watule mʉntʉ nʉmʉhʉɨɨe ʉKilisito. <verse eid="1CO 7:39" /><verse number="40" style="v" sid="1CO 7:40" />Ingɨ ʉnene mine, iza mbele anga mʉsʉngʉ nʉshɨɨwe nʉ mʉgoha wishiɨ waleke kʉtɨnwa. Nanso masɨgo ane, hangɨ kʉsɨga kɨna nkete Ng'wahʉ wang'wi Itunda.<verse eid="1CO 7:40" /></para>
  <chapter eid="1CO 7" />
  <chapter number="8" style="c" sid="1CO 8" />
  <para style="s">Ndya niyipumigwe ipolyo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1" />Ndoilwe nʉmʉandɨkɨla kʉndya niyipumigwe mipolyo.</para>
  <para style="p" vid="1CO 8:1">Kʉlɨngile kɨna, “Kɨhi kʉlɨngile,” Ʉlɨngi wɨleta wiketi, ʉlowa ingɨ wʉwo wɨkʉsasha kʉaaɨɨlye antʉ nɨamʉhʉɨɨe ʉ Yesʉi. <verse eid="1CO 8:1" /><verse number="2" style="v" sid="1CO 8:2" />Mʉntʉ nʉwiine kɨna ʉlɨngile kɨntʉ, kʉtai shanga ʉlɨngile kɨntʉ kɨhi anga nʉtakɨwe kʉlɨnga. <verse eid="1CO 8:2" /><verse number="3" style="v" sid="1CO 8:3" />Ingɨ mʉntʉ nʉmʉloilwe Itunda ʉlɨngɨkile kʉng'wi Itunda.<verse eid="1CO 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4" />Kʉlʉlo, ndya niyipumigwe ipolyo kʉ alʉngʉ, kʉlɨngile kɨna alʉngʉ shanga kɨntʉ mʉʉnkumbigʉlʉ, kʉine kɨna Itunda ingɨ ʉng'wɨ du. <verse eid="1CO 8:4" /><verse number="5" style="v" sid="1CO 8:5" />Anga itule kɨna amolɨ maintʉ nitangwa “alʉngʉ,” mihɨɨ ang'wɨ kigʉlʉ, anga ɨze amolɨ “alʉngʉ” ɨdʉ nɨ “Isekʉlʉ” ɨdʉ, <verse eid="1CO 8:5" /><verse number="6" style="v" sid="1CO 8:6" />nɨitɨga ʉsese ʉmolɨ Itunda ʉng'wɨ du. Nʉyo Tata witʉ, intʉ yɨhi yitundilwe nʉng'wenso, kʉnsoko akwe ʉsese kʉkolɨ, hangɨ ʉkolɨ Isekʉlʉ ʉng'wɨ du, Yesʉ Kilisito, kʉng'wakwe intʉ yɨhi aɨyitundilwe, nʉsese kishiɨ kʉnsoko akwe.<verse eid="1CO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7" />Ingɨ, shanga mʉntʉ wɨhi ʉlɨngile iza ʉlʉ, kʉnsoko akolɨ antʉ ang'wɨ aɨakete ntendo akipolya kʉ adʉdʉ. Antʉ nɨanso nitungo ɨlɨ ga nɨakʉlya ndya niyanso ɨiona anga akʉlya ndya nɨyipoigwe kʉ adʉdʉ, kʉnsoko akɨlɨ kʉhʉɨɨla mʉitakɨwe, mʉnkolo yao iona kɨna akʉtenda makani nɨshanga agombekile kʉng'wi Itunda. <verse eid="1CO 8:7" /><verse number="8" style="v" sid="1CO 8:8" />Ingɨ indya shanga yɨkʉhumbeelya kʉng'wi Itunda, anga kʉleke kʉlya shanga kʉʉkepelwa anga kɨntʉ, hangɨ anga kʉlye shanga kʉongeligwa anga kɨntʉ.<verse eid="1CO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 8:9" />Ingɨ ihambi, ʉlɨngi wanyu ʉwʉ ʉleke kʉtula kɨnkwatya kʉ antʉ awa nɨakɨlɨ kʉhʉɨɨla. <verse eid="1CO 8:9" /><verse number="10" style="v" sid="1CO 8:10" />Kʉnsoko mʉntʉ nʉwaʉhʉɨɨli ʉnino anga wakʉone ʉewe nʉlɨngile ʉkʉlya indya niyanso mʉnyʉmba niya adʉdʉ, itɨɨ, mʉnkolo akwe shanga ʉkʉsɨgane kɨna nʉyo ʉtakɨwe walye indya nipoeigwe kʉ adʉdʉ? <verse eid="1CO 8:10" /><verse number="11" style="v" sid="1CO 8:11" />Mʉntʉ ʉyʉ nʉwaʉhʉɨɨli ʉnino Kilisito naɨʉkule kʉnsoko akwe ʉkʉlimɨla kʉnsoko aʉlɨngi wako. <verse eid="1CO 8:11" /><verse number="12" style="v" sid="1CO 8:12" />Anga mʉagazɨɨlye anyandʉgʉ anyu nɨaʉhʉɨɨli ʉnino mʉkʉasasha itʉme mɨlandʉ nʉkʉalemalya ʉhʉɨɨli wao, pang'wanso mʉkʉtula magaza kʉng'wa Kilisito. <verse eid="1CO 8:12" /><verse number="13" style="v" sid="1CO 8:13" />Kʉlulo anga itule ndya nɨkʉlya yikʉmʉsasha ʉmʉhʉɨɨli mɨane watende mɨlandʉ, pang'wanso shanga kʉlya ɨnyama kwee, ndeke kʉmʉsasha mʉhʉɨɨli mɨane witume mʉlandʉ.<verse eid="1CO 8:13" /></para>
  <chapter eid="1CO 8" />
  <chapter number="9" style="c" sid="1CO 9" />
  <para style="s">Mʉlɨmo nʉwa mitʉmi naya nʉtakɨwe kʉtendeelwa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1" />Itɨɨ, ʉnene nɨmʉtungwane? Itɨɨ, mʉlɨngile kɨna ʉnene nɨmitʉmi nɨ kɨna aɨnʉmʉine ʉ Yesʉi Isekʉlʉ witʉ? Itɨɨ, ʉnyenye shanga aɨnʉmʉmanyisilyene mʉmʉhʉɨɨle Isekʉlʉ? <verse eid="1CO 9:1" /><verse number="2" style="v" sid="1CO 9:2" />Palʉng'wɨ nɨ kɨna antʉ ang'wɨ ahitile kɨna ʉnene nɨ mitʉmi, ingɨ ʉnyenye mʉgombile kɨna ʉnene nɨ mitʉmi. Kʉnsoko ʉnyenye mʉmʉhʉɨɨe ʉKilisito kɨko kɨlɨngasɨɨlyo kɨna ʉnene nɨmitʉmi wang'wi Isekʉlʉ.<verse eid="1CO 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3" />Kʉ antʉ nɨanihitile ʉnene kilongola itɨ. <verse eid="1CO 9:3" /><verse number="4" style="v" sid="1CO 9:4" />Itɨɨ, shanga kʉgombigwene ʉsese kʉpegwa indya nɨ kɨng'wegwa? <verse eid="1CO 9:4" /><verse number="5" style="v" sid="1CO 9:5" />Itɨɨ, shanga izane ʉsese kendania mʉhɨnzo nʉ mʉsʉngʉ wane nʉmʉhʉɨɨe Itunda anga itʉmi nɨangɨza nʉ Petelo nɨ aheu ang'wi Isekʉlʉ nɨɨtenda. <verse eid="1CO 9:5" /><verse number="6" style="v" sid="1CO 9:6" />Ang'wɨ ʉnene Paʉlo nʉ Balinaba ʉdu nɨkʉtakɨwe kitʉma mɨlɨmo kʉhume kʉlija maintʉ akiaɨɨlya kʉhume kishiɨ? <verse eid="1CO 9:6" /><verse number="7" style="v" sid="1CO 9:7" />Mʉnyambita kɨ nʉwenda kʉmbita kʉ nsao yakwe? Mʉlɨmi kɨ nʉɨtemela mʉgʉnda nʉwa mɨzabibʉ wahite kʉlya inkali yakwe? Nyenyu nʉɨdɨma idale lamɨtugo waleke kʉng'wa imaele?<verse eid="1CO 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 9:8" />Itɨɨ, kʉligitya makani aya kɨʉntʉne? Itɨɨ, malagɨɨlyo ang'wi Itunda naɨʉmʉpee Musa shanga atambʉe ʉne? <verse eid="1CO 9:8" /><verse number="9" style="v" sid="1CO 9:9" />Yandɨkilwe mʉmalagɨɨlyo ang'wi Itunda naɨʉmʉpee Musa, “Leka kʉmɨtungɨlya ng'ombe mʉlomo itungo nʉʉkʉpʉla.” Itɨɨ, nɨkʉʉtambʉla inkani izi, kʉlʉnge Itunda ʉsɨgile ɨng'ombe dune? <verse eid="1CO 9:9" /><verse number="10" style="v" sid="1CO 9:10" />Itɨɨ, Itunda nʉligitilye itɨ shanga aɨʉkʉsɨgile nʉ sesene? Yandɨkilwe ɨtai kʉnsoko itʉ, kʉnsoko mʉntʉ nʉkʉlɨma nʉ mʉntʉ nʉkʉpʉla, ɨhi nɨ itʉmeʉ ahʉɨɨle kɨna akʉtepanigwa nzepwa. <verse eid="1CO 9:10" /><verse number="11" style="v" sid="1CO 9:11" />Anga ɨze ʉsese kʉmʉtanantɨɨye lʉkani lang'wi Itunda, itɨɨ, shanga kʉtakɨwe kʉlija kɨntʉne nɨka kʉʉaɨɨlya kɨmʉɨlɨ anga ndya niing'wegwa kʉpuma kʉng'wanyu? <verse eid="1CO 9:11" /><verse number="12" style="v" sid="1CO 9:12" />Anga ɨze antʉ ang'wɨ mʉkʉaɨɨlya, haɨ ʉsese gwa, shanga kʉtakɨwene kʉaɨɨligwa kʉkɨla antʉ nɨanso?</para>
  <para style="p" vid="1CO 9:12">Ingɨ ʉsese shanga kʉdaiye nɨkʉtakɨwe kʉtendeelwa nʉnyenye. Kɨmɨkɨɨli kakwe kigigimɨɨye mʉ maintʉ ɨhi ingɨ kʉleke kʉgilya Nkani Nza niyang'wa Kilisito kʉtanantigwa. <verse eid="1CO 9:12" /><verse number="13" style="v" sid="1CO 9:13" />Itɨɨ, shanga mʉlɨngilene kɨna antʉ nɨitʉmɨla Mʉnyʉmba ang'wi Itunda ɨlyaa mʉmo, hangɨ antʉ awo nɨitʉmɨla mitekeelo omoelwa kʉpuma mʉmasongelyo napumigwe? <verse eid="1CO 9:13" /><verse number="14" style="v" sid="1CO 9:14" />Isekʉlʉ aɨʉlagɨye angaʉ, atanantya Nkani Nza alye kʉkɨɨla mʉlɨmo wʉwo.<verse eid="1CO 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15" />Ingɨ ʉnene nkɨlɨ kʉgema anga nɨkang'wɨ kʉlompa kɨntʉ kɨhi mʉmaintʉ nɨtakɨwe kʉtendeelwa, hangɨ shanga kʉandɨka itɨ nihume kʉtendeelwa nanso. Ingɨ bahu ʉnene nshe kʉkɨla mʉntʉ wangilye kikʉlya. <verse eid="1CO 9:15" /><verse number="16" style="v" sid="1CO 9:16" />Ingɨ nɨkʉtanantya Nkani Nza shanga ntakɨwe kikʉlya kʉnsoko ntakɨwe kitʉma mʉlɨmo nʉwanso. Ʉkɨa wane anga ndeke kʉtanantya Nkani Nza. <verse eid="1CO 9:16" /><verse number="17" style="v" sid="1CO 9:17" />Anga ntanantye mʉndoewe ʉnene, kʉdaya mpegwe kɨnyamʉlɨmo. Ingɨ kitʉma kʉnsoko mʉlɨmo wane nɨmpewe, yɨyɨ ndogoelyo Itunda ʉndagɨɨye nitʉme. <verse eid="1CO 9:17" /><verse number="18" style="v" sid="1CO 9:18" />Kɨnyamʉlɨmo kane kɨntʉ kɨgwa? Kɨnyamʉlɨmo kane ingɨ kʉlija lyoma nɨlakʉtanantya Nkani Nza nakanda, ndekene kʉdaya ɨkɨnyamʉlɨmo kʉʉtanantyi nʉwa Nkani Nza.<verse eid="1CO 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19" />Kʉlulo, palʉng'wɨ nʉkʉtula ʉnene shanga nʉmʉtʉng'wa nʉwa mʉntʉ wɨhi, nitendisilye kʉtula nɨmʉtʉng'wa nʉwa antʉ ɨhi ingɨ nihume kʉaaɨɨlya antʉ ɨdʉ amʉhʉɨɨla ʉKilisito. <verse eid="1CO 9:19" /><verse number="20" style="v" sid="1CO 9:20" />Kʉ Ayahudi aɨnishiɨ anga nɨ Mʉyahudi ingɨ nɨaaɨɨlye Ayahudi amʉhʉɨɨle ʉKilisito, palʉng'wɨ nʉkʉlʉnga ʉnene shanga ntongilwe nɨmalagɨɨlyo, mambile malagɨɨlyoao, ingɨ nɨaɨɨlye awo nɨmolɨ mʉmalagɨɨlyo amʉhʉɨɨle ʉKilisito. <verse eid="1CO 9:20" /><verse number="21" style="v" sid="1CO 9:21" />Nɨ antʉ nɨshanga Ayahudi, ʉnene aɨnimpyani nɨantʉ nɨanso, shanga aɨtyatile malagɨɨlyo, ingɨ nihume kʉaaɨɨlya antʉ nɨshanga Ayahudi. Ingɨ ndeke kʉsɨgɨɨlwa kɨna shanga ntyatile ɨmalagɨɨlyo ang'wi Itunda, kʉnsoko ntyatile malagɨɨlyo ang'wa Kilisito. <verse eid="1CO 9:21" /><verse number="22" style="v" sid="1CO 9:22" />Kʉ antʉ nɨahimbɨ aɨnitendisilye anga nɨmʉhimbɨ ingɨ nɨaaɨɨlye antʉ nɨahimbɨ. Aɨntendile maintʉ ɨhi kʉ antʉ ɨhi ingɨ nihume kʉaguna antʉ ang'wɨ kʉnzɨla ɨyɨ.<verse eid="1CO 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 9:23" />Kitʉma nanso ɨhi kʉnsoko Ankani Nza, ingɨ ʉnene nɨahʉɨɨli ɨane kʉhume kʉsɨngɨɨlya ʉkembetwa nʉwa Nkani Nza. <verse eid="1CO 9:23" /><verse number="24" style="v" sid="1CO 9:24" />Itɨɨ, shanga mʉlɨngilene kɨna mʉmiginso nʉwakʉmanka antʉ ɨhi ɨmanka mɨlugu, ingɨ mʉntʉ nʉtiganile yʉyo wɨpegwa ɨngala. Kʉlʉlo manki mʉatige ɨanyu mʉhume kʉpegwa ɨngala. <verse eid="1CO 9:24" /><verse number="25" style="v" sid="1CO 9:25" />Amanki ihamba mahikʉ ɨdʉ nʉkiima maitʉ ɨdʉ ingɨ lʉhikʉ nʉlakitiga ahume kʉtigana, itenda itɨ kʉnsoko akʉpegwa ngala nɨbɨpa, ʉsese ingɨ kihamba mahikʉ ɨdʉ nʉkiima maitʉ ɨdʉ kʉpegwe ɨngala nɨshanga ɨbɨpa. <verse eid="1CO 9:25" /><verse number="26" style="v" sid="1CO 9:26" />Kʉlʉlo mankile mɨlugu nsʉla ane kʉpegwa ngala, ʉgwa nɨkikʉa nkundi, shanga kikʉa kʉzegʉma nkundi mʉtilɨ anga mʉntʉ. <verse eid="1CO 9:26" /><verse number="27" style="v" sid="1CO 9:27" />Ingɨ kʉaja ʉmʉɨlɨ wane nʉkiima makani nɨshanga atakɨwe, ingɨ anga nkondye kʉatanantɨlya antʉ Nkani Nza ndeke kʉhitwa pang'wi Itunda.<verse eid="1CO 9:27" /></para>
  <chapter eid="1CO 9" />
  <chapter number="10" style="c" sid="1CO 10" />
  <para style="s">Leki kipolyo kʉ adʉdʉ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1" />Anyadʉgʉ ane, ndoilwe mʉlɨngɨ kɨna atata itʉ aɨakʉsʉngwa nʉ Ng'wahʉ hangɨ ɨhi ɨkaputa iza ʉlʉzɨ ʉlo nʉlʉkʉlʉ. <verse eid="1CO 10:1" /><verse number="2" style="v" sid="1CO 10:2" />Antʉ ɨhɨ ɨkabadisigwa milunde nʉmʉlʉzɨ ʉlo nʉlʉkʉlʉ atule antʉ ang'wa Musa. <verse eid="1CO 10:2" /><verse number="3" style="v" sid="1CO 10:3" />Antʉ ɨhi ɨkalya lʉdya lʉlo nʉla kɨnkolo naɨlʉpumile kʉng'wi Itunda <verse eid="1CO 10:3" /><verse number="4" style="v" sid="1CO 10:4" />antʉ ɨhi ɨkang'wa kɨng'wegwa kɨko kɨɨko ka kɨnkolo. Ndogoelyo aɨang'wee kʉpuma migwe nikʉlʉ nɨla kɨnkolo naɨlɨatyatile, igwe nɨlanso ingɨ Kilisito. <verse eid="1CO 10:4" /><verse number="5" style="v" sid="1CO 10:5" />Nɨitɨ ga, mʉ antʉ awa ɨdʉ shanga aɨatendile makani namʉloeeye Itunda, ɨkasha nɨ mɨimbaao ikasambaɨla mʉwɨ.<verse eid="1CO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6" />Makani aya aɨapumie ingɨ ahume kʉʉhʉgʉla ʉsese kʉleke kʉawa kʉtenda makani nɨmabɨ anga nɨanso naɨailwe nʉ kʉtenda. <verse eid="1CO 10:6" /><verse number="7" style="v" sid="1CO 10:7" />Leki kʉkʉlyi adʉdʉ anga antʉ ang'wɨ naɨɨlɨ. Anga niyandɨkilwe, “Antʉ aɨikiɨ alye nʉkʉng'wa, ɨkaʉka nʉkiinɨla anga antʉ nɨshanga amʉlɨngile Itunda.” <verse eid="1CO 10:7" /><verse number="8" style="v" sid="1CO 10:8" />Hangɨ leki kʉgoolyi anga ang'wɨao naɨagooye, lʉhikʉ lʉng'wɨ ɨkalimansɨligwa antʉ elupu makʉmi abɨɨlɨ na ataatʉ. <verse eid="1CO 10:8" /><verse number="9" style="v" sid="1CO 10:9" />Leki kʉmʉgemi Isekʉlʉ anga antʉ ang'wɨao naɨamʉgemile, kʉnsoko nanso ɨkalʉng'wa nzoka ɨkasha. <verse eid="1CO 10:9" /><verse number="10" style="v" sid="1CO 10:10" />Hangɨ leki kʉnang'ani kʉ makani nʉkitʉma Itunda anga antʉ ang'wɨ nɨɨnang'ana, Itunda wɨkamʉlagɨɨlya malaɨka wakwe nʉwa nsha wɨkaalimansɨlya.<verse eid="1CO 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11" />Itɨ gwa, makani nanso naɨaahagile ingɨ akʉkanie ʉsese, hangɨ aandɨkilwe ingɨ akʉmanyise ʉsese nɨkʉkolɨ mʉmatungo ampelo naʉnkumbigʉlʉ.<verse eid="1CO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 10:12" />Itɨgwa mʉntʉ wɨhi nʉsɨgile kɨna ʉkomile mʉʉhʉɨɨli nʉwakendegeele waleke kʉgwa nʉkitʉma mɨlandʉ. <verse eid="1CO 10:12" /><verse number="13" style="v" sid="1CO 10:13" />Kʉtilɨ anga mageng'wa ɨhi antʉ nɨakʉgeng'wa nɨɨza akɨlɨ kigela. Itunda ingɨ wakʉhʉɨɨlwa shanga ʉkʉleka mʉgeng'we kʉkɨla ʉhʉɨɨli wanyu, ingɨ palʉng'wɨ nʉkʉgeng'wa kʉng'wanyu, Itunda ʉkʉmʉpa ʉhumi nʉwakʉgigimɨlya nɨnzɨla akʉpumɨla ɨze mɨapanga.<verse eid="1CO 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14" />Kʉlulo, ahʉmba ɨane, temanʉki nɨmapolya adʉdʉ. <verse eid="1CO 10:14" /><verse number="15" style="v" sid="1CO 10:15" />Kʉitambʉlya nʉnyenye anga antʉ nɨmʉkete mahala, lamʉli ʉnyenye aya nɨkʉtambʉla. <verse eid="1CO 10:15" /><verse number="16" style="v" sid="1CO 10:16" />Nɨkɨmʉsongelya Itunda kʉ kɨkombe ɨko nɨkaʉkembetwa, itɨɨ, shanga kɨng'wezaniane ɨsakami ang'wa Kilisito? Hangɨ ʉmʉkate nɨkɨʉega, itɨɨ, shanga kɨlɨzaniane ʉmʉɨlɨ wang'wa Kilisito? <verse eid="1CO 10:16" /><verse number="17" style="v" sid="1CO 10:17" />Kʉnsoko mʉkate ingɨ ʉng'wɨ, ʉsese palʉng'wɨ nʉkʉtula kɨdʉ, ingɨ kɨmʉɨlɨ ʉng'wɨ, kʉndogoelyo ʉsese kɨhi kɨhangɨla kʉlya mʉkate ʉng'wɨ. <verse eid="1CO 10:17" /><verse number="18" style="v" sid="1CO 10:18" />Kolwi Aisilaeli, antʉ nɨɨpumya ipolyo wawo ɨlyaa masongelyo nanso. <verse eid="1CO 10:18" /><verse number="19" style="v" sid="1CO 10:19" />Itɨɨ nʉnge ʉlɨgwa? Kɨna ndya niipumigwe kʉ adʉdʉ kɨsanigwene kʉkɨla indya? Ang'wɨ dʉdʉ yʉyo ʉsanigwene? <verse eid="1CO 10:19" /><verse number="20" style="v" sid="1CO 10:20" />Ingɨ kʉlʉnge kɨna, ndya niipoeigwe kʉ ahɨng'wɨ, ingɨ ipolyo laahɨng'wɨ, shanga kʉng'wi Itunda. Shanga ndoilwe lʉkʉlʉ ʉnyenye mʉtule palʉng'wɨ nɨahɨng'wɨ. <verse eid="1CO 10:20" /><verse number="21" style="v" sid="1CO 10:21" />Shanga mʉhumile kʉng'wela ɨkɨkombe kang'wi Isekʉlʉ nɨkɨkombe ka ahɨng'wɨ, shanga mʉhumile kʉlya nʉ kʉng'wa miloeelya lang'wi Isekʉlʉ, sʉnga mende mihanje kʉlya nʉ kʉng'wa miloeelya nɨlakʉkʉlya ɨahɨng'wɨ. <verse eid="1CO 10:21" /><verse number="22" style="v" sid="1CO 10:22" />Ang'wɨ itɨɨ, kʉloilwe kʉmʉsasha Isekʉlʉ watule nʉ wɨlʉne? Itɨɨ mʉsɨgile kʉkete ngulu kʉkɨla nʉwanso? Tendi ɨhi kikʉlyo lang'wi Itunda.<verse eid="1CO 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23" />Mʉlʉngile, “Kʉgombigwe maintʉ ɨhi” Ingɨ ʉnene nʉngile shanga maitʉ ɨhi maza kʉng'wi Itunda. “Ʉsese kʉgombigwe kitʉma maintʉ ɨhi.” Ʉnene nʉngile shanga maintʉ ɨhi akʉaaɨɨlya antʉ kʉmʉhʉɨɨla Itunda. <verse eid="1CO 10:23" /><verse number="24" style="v" sid="1CO 10:24" />Mʉntʉ nʉwaleke kʉdʉma nakʉmʉaɨɨlya ʉng'wenso du, ingɨ wadume nakʉaaɨɨlya antʉ nɨangɨza.<verse eid="1CO 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 10:25" />Lyii nyama yɨhi niikʉgʉligwa kʉ ʉgalagalo. Leki kiaji kʉnsoko amasɨgo anyu. <verse eid="1CO 10:25" /><verse number="26" style="v" sid="1CO 10:26" />Ndogoeelyo Mʉwandɨkwa wang'wi Itunda yandɨkilwe, “Ihɨɨ nɨ maintʉ ɨhi namole ingɨ ɨhi ang'wi Isekʉlʉ.”<verse eid="1CO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27" />Anga itule mʉntʉ nɨshanga ʉmʉhʉɨɨe Itunda ʉmanile nʉnyenye mʉgombe kʉlongola, itɨgwa, lyii kɨhi nɨmʉkʉtengelwa, leki kiaji mʉnkolo yanyu. <verse eid="1CO 10:27" /><verse number="28" style="v" sid="1CO 10:28" />Ingɨ mʉntʉ anga wamʉɨle, “Nyama ɨyɨ ipoeigwe adʉdʉ,” Itɨ gwa, leki kʉlyi, kʉnsoko amʉntʉ nʉmanile nɨ ingɨmʉleke kʉalɨka mʉnkolo yanyu, <verse eid="1CO 10:28" /><verse number="29" style="v" sid="1CO 10:29" />apa shanga kʉtambʉla kʉnsoko akʉaalya masɨgo anyu, ingɨ kʉaalya akʉaalya masɨgo amʉntʉ nʉkʉɨɨe.</para>
  <para style="p" vid="1CO 10:29">Mʉhumile kʉnkolya, “Nɨkɨ, aya nɨndoilwe kitʉma ʉnene ilamʉlwe nʉmʉntʉ mʉngɨza? <verse eid="1CO 10:29" /><verse number="30" style="v" sid="1CO 10:30" />Anga ɨze ʉnene kʉlya ndya niyanso kʉnʉ nʉmʉsongelya Itunda, nɨkɨ nsokigwe kʉnsoko andya nɨnʉmʉsongeeye Itunda?”<verse eid="1CO 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31" />Itɨgwa, kɨntʉ kɨhi nɨmʉkitʉma itule kʉlya ang'wɨ kʉng'wa, itʉmi maintʉ ɨhi kʉnsoko akʉmʉkʉlya Itunda. <verse eid="1CO 10:31" /><verse number="32" style="v" sid="1CO 10:32" />Leki kʉsashi kɨnkwaatya kaʉbɨ kʉ Ayahudi ang'wɨ kʉ Ayunani aleke kʉmʉhʉɨɨla ʉKilisito ang'wɨ kʉ ahʉɨɨli ang'wi Itunda itʉme mɨlandʉ. <verse eid="1CO 10:32" /><verse number="33" style="v" sid="1CO 10:33" />Mʉtule anga nene, kʉgema kʉaloeelya antʉ kʉ ntendo yɨhi, shanga kʉdʉma makani nakʉnzaɨɨlya ʉnene ingɨ makani akʉnzaɨɨlya antʉ ɨhi, ahume kʉgunwa.<verse eid="1CO 10:33" /></para>
  <chapter eid="1CO 10" />
  <chapter number="11" style="c" sid="1CO 11" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1" />Ntyatɨ ntendo yane anga ʉnene nɨntyatile intendo yang'wa Kilisito.<verse eid="1CO 11:1" /></para>
  <para style="s">Kʉkunɨkɨla itwe mipolyo</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2" />Nʉmʉlʉmbɨɨye kʉnsoko mʉmakani anyu ɨhi nɨmʉkʉtenda mʉnkɨmbʉkile ʉnene hangɨ mʉtyatile ʉmanyisi naɨnʉmʉmanyisilye. <verse eid="1CO 11:2" /><verse number="3" style="v" sid="1CO 11:3" />Ingɨ ndoilwe mʉlɨnge kɨna ʉ Kilisito ingɨ itwe la mɨtʉnja, nʉ mitʉnja ɨngɨ itwe la mʉsʉngʉ wakwe, ni Itunda ɨngɨ itwe lang'wa Kilisito. <verse eid="1CO 11:3" /><verse number="4" style="v" sid="1CO 11:4" />Itɨ gwa, mitʉnja wɨhi nʉkʉlompa ang'wɨ nʉkʉtanantya impola yang'wi Itunda kʉnʉ wazeʉkunɨkɨe itwe lakwe nʉwanso ʉmʉdalahile ʉKilisito. <verse eid="1CO 11:4" /><verse number="5" style="v" sid="1CO 11:5" />Nʉ mʉsʉngʉ nʉkʉlompa ang'wɨ nʉkʉtanantya impola yang'wi Itunda shanga kʉnʉ wazeʉkʉnɨkɨe itwe lakwe mʉsʉngʉ nʉwanso ʉmʉdalahile ʉmʉgoha wakwe, nʉkʉtenda itɨ wɨhanga mʉsʉngʉ nʉzue ing'ʉlyʉ. <verse eid="1CO 11:5" /><verse number="6" style="v" sid="1CO 11:6" />Mʉsʉngʉ nɨshanga ʉkʉnɨkɨe itwe lakwe, bahu wazule isingi lakwe. Ingɨ mɨnyala kʉ mʉsʉngʉ kʉteng'wa isingi yakwe ang'wɨ kʉzulwa, bahu wakʉnɨkɨle itwe lakwe. <verse eid="1CO 11:6" /><verse number="7" style="v" sid="1CO 11:7" />Shanga inonee ʉmitʉnja kʉkunɨkɨla itwe lakwe, kʉnsoko nʉwanso ingɨ mpyani ang'wi Itunda hangɨ wɨlagɨɨla ʉkʉlʉ wang'wi Itunda. Ingɨ ʉmʉsʉngʉ wɨlagɨɨla ʉkʉlʉ nʉwa mitʉnja, kʉnsoko ng'wenso ʉkenkile ikʉlyo nɨla mitʉnja, <verse eid="1CO 11:7" /><verse number="8" style="v" sid="1CO 11:8" />kʉnsoko Itunda shanga aɨʉmʉʉmbile ʉmitʉnja kʉpuma kʉ mʉsʉngʉ, ingɨ ʉmʉsʉngʉ aɨʉʉmbilwe kʉpuma kʉ mitʉnja. <verse eid="1CO 11:8" /><verse number="9" style="v" sid="1CO 11:9" />Hangɨ mitʉnja shanga aɨʉʉmbilwe kʉnsoko akʉmʉaɨɨlya mʉsungʉ, ingɨ ʉmʉsʉngʉ aɨʉʉmbilwe kʉnsoko akʉmʉaɨɨlya mitʉnja. <verse eid="1CO 11:9" /><verse number="10" style="v" sid="1CO 11:10" />Kʉnsoko nanso nɨ kʉnsoko ang'wa malaɨka, yɨyo ndogoelyo ʉmʉsʉngʉ wakunɨkɨla itwe lakwe, yitule kɨlɨngasɨɨlyo kang'wa malaɨka nʉmolɨ kʉng'wakwe. <verse eid="1CO 11:10" /><verse number="11" style="v" sid="1CO 11:11" />Nɨitɨ ga, mʉng'wi Isekʉlʉ mʉsʉngʉ ʉmʉsanilye mitʉnja, nʉ mitʉnja ʉmʉsanilye mʉsʉngʉ. <verse eid="1CO 11:11" /><verse number="12" style="v" sid="1CO 11:12" />Anga ʉmʉsʉngʉ naɨʉmbilwe kʉpuma kʉ mitʉnja, ʉlʉkʉlʉ nʉ mitʉnja wɨtugwa nʉ mʉsʉngʉ, ingɨ maintʉ ɨhi ɨpuma kʉng'wi Itunda.<verse eid="1CO 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 11:13" />Lamʉli nyenye. Itɨɨ, inoneene ʉmʉsʉngʉ kʉmʉlompa Itunda shanga ɨze ʉkunɨkɨe itwe lakwe? <verse eid="1CO 11:13" /><verse number="14" style="v" sid="1CO 11:14" />Itɨɨ, shanga taine kʉʉpumoo kʉmanyisigwe kɨna mɨnyala kʉ mitʉnja kʉtʉla nɨnsingi nkʉlʉ, <verse eid="1CO 11:14" /><verse number="15" style="v" sid="1CO 11:15" />Ingɨ kʉ mʉsʉngʉ kʉtula nɨnsingi nkʉlʉ ingɨ ikʉlyo kʉng'wake. Mʉsʉngʉ ʉpewe nsingi nkʉlʉ ingɨ kʉkunɨkɨla itwe lakwe. <verse eid="1CO 11:15" /><verse number="16" style="v" sid="1CO 11:16" />Mʉntʉ wɨhi anga walete nkʉngʉmi kʉ nkani nɨntambʉe, itɨ gwa, mʉntʉ nʉwanso nʉwalɨnge kɨna ʉsese kɨagila ntendo nanso, hangɨ antʉ nɨamʉhʉɨɨe Itunda kɨtendaʉ.<verse eid="1CO 11:16" /></para>
  <para style="s">Iloelya lang'wi Isekʉlʉ</para>
  <para style="r">
    <ref loc="MAT 26:26-29">Matayo 26:26-29</ref>; <ref loc="MRK 14:22-25">Maliko 14:22-25</ref>; <ref loc="LUK 22:14-20">Lʉka 22:14-20</ref></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17" />Itungo ɨlɨ nɨnongolekile kʉmʉlagɨɨlya, shanga kʉmʉlʉmbɨɨlya lʉkʉlʉ, kʉnsoko nɨmʉkʉtankana kʉmʉkʉlya Itunda mʉkenditʉma makani nɨmabɨ kʉkɨla makani nɨmaza. <verse eid="1CO 11:17" /><verse number="18" style="v" sid="1CO 11:18" />Ng'wandyo lʉkʉlʉ, nigulye kɨna mʉʉtankani wanyu nʉwa kʉmʉkʉlya Itunda mɨkendatula kikʉngʉma, makani aya nɨnigulye nihʉɨɨe kɨna nang'wɨ atai. <verse eid="1CO 11:18" /><verse number="19" style="v" sid="1CO 11:19" />Kʉnsoko amasɨgo anyu nkʉngʉmi ɨhumile kʉpumɨla, ingɨ yigeeleke antʉ nɨagombekile kʉng'wi Itunda. <verse eid="1CO 11:19" /><verse number="20" style="v" sid="1CO 11:20" />Anga mʉtankane kʉmʉkʉlya Itunda, ingɨ shanga mɨtankana anga iloelya lang'wi Isekʉlʉ nʉlɨtakɨe. <verse eid="1CO 11:20" /><verse number="21" style="v" sid="1CO 11:21" />Kʉndogoelyo nɨmʉkʉlya, kɨla mʉntʉ witengeela indya yakwe wazeʉakuɨe mʉgongo ɨaʉya, hangɨ anga yitule ang'wɨ anyu ahumilwe nzala isaga nɨnzalaao, kʉnʉ nɨang'wɨ azelya nʉkʉng'wa kʉpikɨɨla kʉgala. <verse eid="1CO 11:21" /><verse number="22" style="v" sid="1CO 11:22" />Itɨɨ, shanga mʉhumilene kʉlya nʉ kʉng'wa kʉmatolanyu? Ang'wɨ, mʉadalahilene antʉ nɨamʉhʉɨɨe Itunda nʉkʉahumya mɨnyala antʉ nɨagila anga kɨntʉ? Nʉmʉɨlɨ ʉlɨ? Nʉmʉlʉmbɨlyene? Kʉtilɨ. Kʉ ntendo ɨyɨ shanga kʉmʉlʉmbɨɨlya.<verse eid="1CO 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23" />Ndongoelyo ʉnene aɨnanʉnkʉe kʉpuma kʉng'wi Isekʉlʉ imalagɨɨlyo naɨnʉmʉpee, kɨna ʉtikʉ ʉwo naɨʉpumigwe Isekʉlʉ Yesʉ, aɨʉhoile ʉmʉkate, <verse eid="1CO 11:23" /><verse number="24" style="v" sid="1CO 11:24" />wɨkamʉsongelya Itunda, wɨkaʉega, wɨkalʉnga, “Ʉwʉ wʉwʉ mʉɨlɨ wane nʉʉpumigwe kʉnsoko anyu. Mʉzetendaʉ kʉnkɨmbʉka ʉnene.” <verse eid="1CO 11:24" /><verse number="25" style="v" sid="1CO 11:25" />Kʉ itɨ, naɨalya wɨkahola kɨkombe kadibai wɨkalʉnga, “Ɨkɨ kɨkombe kilago nipya nɨlɨkigeeleka kɨna tai mʉsakami ane nɨkʉhunʉka kʉnsoko anyu. Mʉzetendaʉ kʉnkɨmbʉka ʉnene.”<verse eid="1CO 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 11:26" />Ndogoelyo nɨmʉkʉlya ʉmʉkate ʉwʉ nʉkʉng'wela kɨkombe ɨkɨ mʉlongolekile mʉkʉatanantɨlya antʉ nɨangɨɨza kʉpikɨɨla nʉzɨɨzɨza, kɨna ʉKilisito aɨʉkule kʉnsoko anyu. <verse eid="1CO 11:26" /><verse number="27" style="v" sid="1CO 11:27" />Kʉlʉlo mʉntʉ wɨhi nʉkʉlya ʉmʉkate ʉwʉ ang'wɨ kʉng'wela ɨkɨkombe kang'wi Isekʉlʉ mʉshanga ʉtakɨwe, ʉkʉtula nigazo nɨlakʉtenda mʉlandʉ kʉmʉɨlɨ nɨ sakami ang'wi Isekʉlʉ. <verse eid="1CO 11:27" /><verse number="28" style="v" sid="1CO 11:28" />Itɨ gwa, mʉntʉ wɨhi wikolenkeelye hanza mʉnkolo, papogwa walye ʉmʉkate nʉwanso nʉkʉng'wela ɨkɨkombe nɨkanso. <verse eid="1CO 11:28" /><verse number="29" style="v" sid="1CO 11:29" />Kʉnsoko mʉntʉ nʉkʉlya nʉkʉng'wa shanga waze ʉlɨngile ɨndogoelyo aʉkamantani wakwe nʉmʉɨlɨ wang'wi Isekʉlʉ, ʉkʉtula walya nʉkʉng'wa ʉlamʉlwi wakwe. <verse eid="1CO 11:29" /><verse number="30" style="v" sid="1CO 11:30" />Yɨyo nsoko mʉng'wanyu nɨang'wɨ nɨshanga amʉhʉɨɨe Itunda hangɨ alwae kɨnkolo nɨaʉya akulee kɨnkolo. <verse eid="1CO 11:30" /><verse number="31" style="v" sid="1CO 11:31" />Anga aɨze kikolenkeeye kɨsa hanza ʉsese Itunda shanga aɨʉze kʉpɨsɨlya itɨ. <verse eid="1CO 11:31" /><verse number="32" style="v" sid="1CO 11:32" />Ingɨ nɨkʉʉlamʉlwa ni Isekʉlʉ, kʉʉmanyisigwa, ingɨ kʉhʉge kʉlamʉlwa palʉng'wɨ nɨ antʉ amihɨɨ.<verse eid="1CO 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33" />Kʉlʉlo, anyandʉgʉ ane, nɨmʉkʉlya miloelya lang'wi Isekʉlʉ milindɨɨle. <verse eid="1CO 11:33" /><verse number="34" style="v" sid="1CO 11:34" />Anga itule ʉkolɨ mʉntʉ ʉlemeeigwe nzala, nʉwalye hanza kitolakwe, ingɨ anga mʉtankane palʉng'wɨ mʉleke kʉsasha kʉlamʉlwa. Ingɨ makani nasagile anga nɨze kʉlɨngasa iza.<verse eid="1CO 11:34" /></para>
  <chapter eid="1CO 11" />
  <chapter number="12" style="c" sid="1CO 12" />
  <para style="s">Ipegwa niya Ng'wahʉ Ng'welʉ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1" />Anyandʉgʉ ane, aya naza mʉnkiye nɨa ipegwa, ndoilwe mʉlɨnge ipegwa niya Ng'wahʉ Ng'welʉ.</para>
  <para style="p" vid="1CO 12:1">Ndoilwe mʉlɨnge iza makani aya. <verse eid="1CO 12:1" /><verse number="2" style="v" sid="1CO 12:2" />Mʉlɨngile kɨna ʉnyenye naɨmʉkɨlɨ kʉmʉlɨnga Itunda, aɨmʉpembeseigwe nʉ kʉlimɨligwa nɨadʉdʉ nɨshanga apanga. <verse eid="1CO 12:2" /><verse number="3" style="v" sid="1CO 12:3" />Kʉlʉlo, lɨngi kɨna mʉntʉ wɨhi nʉaɨigwe nʉ Ng'wahʉ Ng'welʉ shanga ʉhumile kʉlʉnga, “Yesʉ wazung'we!” Nɨ hangɨ kʉtilɨ mʉntʉ wɨhi nʉhumile kʉlʉnga, Yesʉ ingɨ Isekʉlʉ,” anga waleke kʉaɨɨligwa nʉ Ng'wahʉ Ng'welʉ.<verse eid="1CO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4" />Hangɨ yikolɨ ipegwa nia kɨnkolo yɨdʉ, ingɨ yɨpumigwa nʉ Ng'wahʉ ʉng'wɨ. <verse eid="1CO 12:4" /><verse number="5" style="v" sid="1CO 12:5" />Yikolɨ nzɨla yɨdʉ niya kʉmitʉmɨla, ingɨ kɨaɨɨligwa ni Isekʉlʉ ʉng'wɨ <verse eid="1CO 12:5" /><verse number="6" style="v" sid="1CO 12:6" />Hangɨ yimolɨ nzɨla yɨdʉ niya kitʉma mʉlɨmo, ingɨ Itunda ʉng'wɨ nʉwɨkʉpeza ʉhumi kitʉme ɨmɨlɨmo kʉ antʉ ɨhi. <verse eid="1CO 12:6" /><verse number="7" style="v" sid="1CO 12:7" />Kɨla mʉntʉ wɨaɨɨligwa nʉ Ng'wahʉ kitʉma mʉlɨmo ingɨ antʉ ɨhi ahume kiaɨɨlya. <verse eid="1CO 12:7" /><verse number="8" style="v" sid="1CO 12:8" />Ndogoelyo Ng'wahʉ wɨmʉpa kɨla mʉntʉ mahala akʉtambʉla nkani ninza, ʉmʉya kʉtambʉla nkani niya ʉlɨngi. <verse eid="1CO 12:8" /><verse number="9" style="v" sid="1CO 12:9" />Ng'wahʉ yʉyo yʉʉyo wɨmʉpeza mʉntʉ mʉya ʉhumi ʉkʉlʉ nʉwa kʉhʉɨɨla, hangɨ wɨmʉpeza mʉntʉ mʉya kɨpegwa ka kʉakomya antʉ. <verse eid="1CO 12:9" /><verse number="10" style="v" sid="1CO 12:10" />Ng'wahʉ wɨmʉpeza mʉntʉ mʉya kɨpegwa nɨka kʉtenda mɨʉkʉɨlwa, nʉ mʉntʉ mʉya wɨmʉpeza ʉhumi nuwa kʉtanantya nkani kʉpuma kʉng'wi Itunda, nʉ mʉntʉ mʉya kʉilɨnga Ng'wahʉ nʉmʉbi nʉ Ng'wahʉ nʉwa tai, mʉntʉ mʉya kʉtambʉla ntambʉ ngeni, mʉntʉ mʉya kʉnononsola ntambʉ niyanso. <verse eid="1CO 12:10" /><verse number="11" style="v" sid="1CO 12:11" />Makani aya ɨhi ingɨ mʉlɨmo nʉwa Ng'wahʉ yʉyo ʉng'wɨ du, Ng'wahʉ yʉyo wɨlamʉla wamʉpe ntʉni ʉmʉntʉ.<verse eid="1CO 12:11" /></para>
  <para style="s">Mʉɨlɨ ingɨ ʉng'wɨ mapɨlɨga idʉ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12" />Anga mʉɨlɨ nɨɨza ʉng'wɨ nʉwenso ʉkete mapɨlɨga ɨdʉ, nɨmapɨlɨga nanso palʉng'wɨ nʉ kʉtula ɨdʉ, ingɨ mapiliga nanso ɨhi mʉɨlɨ ʉng'wɨ, ʉyɨlɨ mʉng'wa Kilisito. <verse eid="1CO 12:12" /><verse number="13" style="v" sid="1CO 12:13" />Ndogoelyo ʉsese, anga kʉtule kɨ Ayahudi ang'wɨ antʉ andʉgʉ ngɨza, atʉʉng'wa ang'wɨ antʉ nɨidesile, kɨhi kʉbadisigwe kʉtule kɨmʉɨlɨ ʉng'wɨ kʉkɨɨla Ng'wahʉ ʉng'wɨ, nʉsese kɨkahunʉɨlwa Ng'wahʉ yʉyo ʉng'wɨ.<verse eid="1CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14" />Mʉɨlɨ shanga ipɨlɨga lɨng'wɨ du, ingɨ mapɨlɨga ɨdʉ. <verse eid="1CO 12:14" /><verse number="15" style="v" sid="1CO 12:15" />Anga mʉgʉlʉ ʉlʉnge, “Kʉnsoko ʉnene shanga nɨ mʉkono, itɨ gwa ʉnene shanga nɨa mʉɨlɨ,” Ingɨ kʉtambʉla itɨ, yɨkʉʉtenda mʉgʉlʉ ʉtule shanga ipɨlɨga lamʉɨlɨ. <verse eid="1CO 12:15" /><verse number="16" style="v" sid="1CO 12:16" />Hangi anga ʉkʉtwɨ walʉnge, “Kʉnsoko ʉnene shanga nɨliho, kʉitɨ ʉnene shanga nɨa mʉɨlɨ,” Ingɨ kʉntambʉla itɨ, yɨkʉtenda ʉkʉtwɨ watule shanga ipɨlɨga lamʉɨlɨ. <verse eid="1CO 12:16" /><verse number="17" style="v" sid="1CO 12:17" />Angaɨze ʉmʉɨlɨ wɨhi aɨʉtule liho, aɨkʉziija ʉlɨ? Ang'wɨ ʉmʉɨlɨ wɨhi aɨʉtule kʉtwɨ, mʉntʉ aɨʉzenyunsha ʉlɨ? <verse eid="1CO 12:17" /><verse number="18" style="v" sid="1CO 12:18" />Anga ɨze mapiliga ɨhi namʉɨlɨ aɨipɨlɨga lɨng'wɨ, mʉɨlɨ aɨze wɨkʉtilɨ, itɨ gwa Itunda aɨʉhongekee mʉmʉɨlɨ mapiliga aya ɨsa anga naɨʉloilwe. <verse eid="1CO 12:18" /><verse number="19" style="v" sid="1CO 12:19" />Anga ɨze mʉmʉɨlɨ aɨyitule ipɨlɨga lɨng'wɨ, ʉmʉɨlɨ aɨʉzetula ʉlɨ? <verse eid="1CO 12:19" /><verse number="20" style="v" sid="1CO 12:20" />Ingɨ tai kɨna, akolɨ mapiliga ɨdʉ, ʉmʉɨlɨ ingɨ ʉng'wɨ.<verse eid="1CO 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21" />Itɨ gwa, ɨliho shanga lɨhumile kʉʉɨla ʉmʉkono, “Shanga nʉkʉloilwe ʉewe!” hangɨ itwe shanga lɨhumile kʉmɨɨla mɨgʉlʉ, “Shanga nʉkʉloilwe ʉewe.” <verse eid="1CO 12:21" /><verse number="22" style="v" sid="1CO 12:22" />Ingɨ kɨmɨkɨɨli kakwe, mapiliga aya nɨmanementalu, yayo akʉigwe nangulu mʉmʉɨlɨ, <verse eid="1CO 12:22" /><verse number="23" style="v" sid="1CO 12:23" />hangɨ, mapiliga ayo nɨgee kɨna adalahilwe, yayo kʉmakʉiye nangalʉ, nɨmapiliga amʉɨlɨ nɨkʉsɨgile kɨna ɨhumania mɨnyala, yayo kʉmakʉiye nangulu, <verse eid="1CO 12:23" /><verse number="24" style="v" sid="1CO 12:24" />mapiliga ang'wɨ nɨmaza, shanga itakile kʉimbwa kʉkendegeeli ʉkʉlʉ. Itunda ng'wenso ʉhongekee ʉmʉɨlɨ kɨɨsa wamakʉlye mapiliga nadalahilwe. <verse eid="1CO 12:24" /><verse number="25" style="v" sid="1CO 12:25" />Ingɨ mʉɨlɨ ʉleke kʉtemanʉka, Itunda aɨʉloilwe mapiliga ɨhi iaalye palʉng'wɨ. <verse eid="1CO 12:25" /><verse number="26" style="v" sid="1CO 12:26" />Anga ipɨlɨga lɨng'wɨ lɨaalɨke, mapiliga ɨhi yiaalɨka palʉng'wɨ nɨlyenso, ang'wɨ ipɨlɨga lɨng'wɨ lɨkʉligwe mapiliga ɨhi ɨlowa palʉng'wɨ nɨlyenso.<verse eid="1CO 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27" />Itungo ɨlɨ ʉnyenye mɨhi mɨmʉɨlɨ wang'wa Kilisito, kɨla mʉntʉ ingɨ ipɨlɨga lamʉɨlɨ nʉwanso. <verse eid="1CO 12:27" /><verse number="28" style="v" sid="1CO 12:28" />Mʉahʉɨɨli ang'wi Itunda, Itunda ʉɨkile kɨla ʉmʉntʉ palyoma lakwe, nɨang'wandyo itʉmi, nɨakabɨɨlɨ amanga, nɨakatatʉ amanyisi, sʉnga wɨkaaɨka nawa nɨakete ipegwa niyakitʉma imapɨlʉ, kʉakomya antʉ nɨahumile kʉaaɨɨlya aʉya, nɨantʉ nɨakʉaɨɨlya nʉ kʉatongeela antʉ nawa nɨa kʉligitya ɨntambʉ niya kɨgeni. <verse eid="1CO 12:28" /><verse number="29" style="v" sid="1CO 12:29" />Itɨɨ, antu awa ɨhi itʉmine ang'wɨ amangane ang'wɨ amanyisine. Itɨɨ, antʉ ɨhi akete ʉhumi nʉwa kitʉma ɨmapɨlʉne, <verse eid="1CO 12:29" /><verse number="30" style="v" sid="1CO 12:30" />ang'wɨ antʉ ɨhi akete ipegwa nia kʉkomya antʉne, ang'wɨ antʉ ɨhi akete ipegwa niya kʉtambʉla ntambʉ akɨgenine, ang'wɨ antʉ ɨhi akete ipegwa niya kʉnononsoola ntambʉne. <verse eid="1CO 12:30" /><verse number="31" style="v" sid="1CO 12:31" />Itungo ɨlɨ longoleki kʉtula niipegwa niya Ng'wahʉ nɨmʉyiine kɨna ikʉlʉ mbele.</para>
  <para style="p" vid="1CO 12:31">Nɨkɨza mbele ndoilwe kʉmʉlagɨɨla nzɨla ikʉlʉ nakʉlija ipegwa.<verse eid="1CO 12:31" /></para>
  <chapter eid="1CO 12" />
  <chapter number="13" style="c" sid="1CO 13" />
  <para style="s">Ʉlowa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1" />Anga ɨze kʉtambʉla kʉntambʉ niya antʉ nizi niya amalaɨka, ingɨ anga ɨze nʉmʉgila ʉlowa ʉne ntuile anga ʉlʉli nʉla idebe nɨgila anga kɨntʉ ang'wɨ anga mʉntʉ nʉkʉkʉania mazenzele. <verse eid="1CO 13:1" /><verse number="2" style="v" sid="1CO 13:2" />Hangɨ nihumile kʉtula nɨkɨpegwa kakʉtanantya ʉlʉkani lang'wi Itunda, manye makani ɨhi nag'wi Itunda napihilwe, nihumile ntule nʉhʉɨli nʉkʉhamya ɨmalʉgʉlʉ, ingɨ angaɨze nʉmʉgila ʉlowa tilɨ anga kɨntʉ ʉnene. <verse eid="1CO 13:2" /><verse number="3" style="v" sid="1CO 13:3" />Anga mpumye maintʉ ɨhi nɨnkete nɨape ɨahimbɨ, hangɨ anga nʉʉpumye ʉmʉɨlɨ nʉwane ʉsonswe moto, angaɨze nʉmʉgila ʉlowa nanso shanga akʉnzaɨlya kɨntʉ kɨhi.<verse eid="1CO 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4" />Nʉkete ʉlowa mʉgimya, nʉkete ʉlowa wɨkendepa, mʉntʉ nʉkete ʉlowa mʉgila anga wɨlu, shanga wiketa hangɨ shanga wilolya. <verse eid="1CO 13:4" /><verse number="5" style="v" sid="1CO 13:5" />Nʉkete ʉlowa shanga wɨduma makani akiaɨɨlya ʉng'wenso du, nʉkete ʉlowa shanga wɨduma nsailo akwe du, hangɨ mʉgila anga ikuo, nʉkete ʉlowa shanga wɨkɨmbʉka nɨmabɨ, <verse eid="1CO 13:5" /><verse number="6" style="v" sid="1CO 13:6" />mʉntʉ nʉkete ʉlowa shanga wɨlowa ʉbɨ, ingɨ wɨloa nɨtai. <verse eid="1CO 13:6" /><verse number="7" style="v" sid="1CO 13:7" />Mʉntʉ nʉaloilwe aʉya wɨgimya ɨhi, mʉntʉ nʉaloilwe aʉya wɨahʉɨɨla antʉ angɨɨza, hangɨ wɨhuma maintʉ ɨhi.<verse eid="1CO 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8" />Ʉlowa wɨlongoleka, anga ɨze imolɨ ipegwa niya kʉtanantya ʉlʉkani nʉla ng'wi Itunda, niyanso yɨzɨza kɨla lʉhikʉ lʉng'wɨ, anga ɨze ipegwa niyakʉtambʉla ntambʉ nakɨgeni yʉkʉkɨla, anga ɨze ʉkolɨ ʉmanyi nʉwenso ʉkʉkɨla. <verse eid="1CO 13:8" /><verse number="9" style="v" sid="1CO 13:9" />Kʉnsoko shanga kʉlɨngile maintʉ ɨhi, nɨkɨpegwa kitʉ nɨkakʉtanantya ʉlʉkani lang'wi Itunda shanga kʉlɨngile maintʉ ɨhi, <verse eid="1CO 13:9" /><verse number="10" style="v" sid="1CO 13:10" />Ingɨ mʉmahikʉ napembilye kʉʉlɨnga makani ɨhi anga nɨlɨ, nɨmakani aya nɨmasheenyu nɨkʉmalɨngile akʉhega.<verse eid="1CO 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 13:11" />Naɨ nɨmʉng'enya aɨnɨligitya kɨng'enya, aɨnɨngile kɨng'enya, aɨnɨsɨga kɨng'enya, ingɨ itungo ɨlɨ nɨmʉntʉ mʉkʉlʉ, ɨmakani akɨng'enya akɨile. <verse eid="1CO 13:11" /><verse number="12" style="v" sid="1CO 13:12" />Itungo ɨlɨ ingɨ shanga kʉʉona maintʉ ɨhi kɨsa, kʉʉona anga ikelʉ nɨlʉkʉzizɨɨla mʉkɨyoo, ingɨ anga akɨle aya kʉiona kɨhenga kʉ ʉsʉ. Itungo ɨlɨ kʉlɨngile iniino ʉdu, ingɨ panyambele kʉʉlɨnga makani ɨhi kɨsa, anga Itunda nʉkʉlɨngile ʉsese.<verse eid="1CO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13" />Itɨ gwa itungo ɨlɨ, akʉlongoleka makani aya nataatʉ, kʉlongoleka kʉmʉhʉɨɨla Itunda nʉ kʉsʉmbɨɨlya kʉsɨngɨɨlya maintʉ kʉpuma kʉng'wi Itunda nʉkʉlongoleka kilowa, nikʉlʉ mʉmakani aya nataatʉ ingɨ ʉlowa.<verse eid="1CO 13:13" /></para>
  <chapter eid="1CO 13" />
  <chapter number="14" style="c" sid="1CO 14" />
  <para style="s">Ipegwa ingɨɨza niya Ng'wahʉ Ng'welʉ</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1" />Longoleki kilowa, hangɨ kagupi kʉsɨngɨɨlya ipegwa ningɨɨza kʉpuma kʉ Ng'wahʉ wang'wi Itunda, nɨkɨkʉlʉ kɨpegwa nɨkakʉtanantya ʉlʉkani lang'wi Itunda. <verse eid="1CO 14:1" /><verse number="2" style="v" sid="1CO 14:2" />Nʉkʉligitya ɨntambʉ na kɨgeni shanga wɨligitya nɨantʉ ingɨ wɨligitya ni Itunda kʉnsoko kʉtilɨ mʉntʉ nʉɨmʉlɨnga, nʉwanso wɨligitya kʉ ngulu aNg'wahʉ ɨmakani aya antʉ nɨshanga amalɨngile. <verse eid="1CO 14:2" /><verse number="3" style="v" sid="1CO 14:3" />Ingɨ nʉkete ɨkɨpegwa kakʉtanantya ʉlʉkani nʉlang'wi Itunda wɨligitya nɨantʉ wɨzeamanyisa nʉkʉaaɨɨlya nʉkʉakomelya nkolo kʉmʉhʉɨɨla Itunda. <verse eid="1CO 14:3" /><verse number="4" style="v" sid="1CO 14:4" />Nʉkʉtambʉla kʉntambʉ nʉpewe Nʉng'wahʉ wang'wi Itunda wimanyisa ʉng'wenso, ingɨ nʉkete ɨkɨpegwa kakʉtanantya ʉlʉkani lang'wi Itunda ʉkʉmanyisa antʉ nɨamʉhʉɨɨe ʉKilisito.<verse eid="1CO 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 14:5" />Itɨ gwa, azandoilwe ʉnyenye mɨhi mʉligitye ntambʉ nɨmʉpewe nʉ Ng'wahʉ Ng'welʉ, ingɨ ndoilwe lʉkʉlʉ mʉtule nɨkɨpegwa kakʉtanantya lʉkani lang'wi Itunda. Kʉnsoko mʉntʉ nʉkete ɨkɨpegwa kakʉtanantya ʉlʉkani lang'wi Itunda ingɨ wɨaɨɨlya ɨantʉ kʉkɨla mʉntʉ nʉkʉtambʉla kʉ ntambʉ nakɨgeni. Ingɨ itakɨwe pang'wanso wazeʉkomolɨ mʉntʉ nʉwakʉnononsola ɨmakani nanso nakʉtambʉlwa, ingɨ antʉ nɨamʉhʉɨɨe ʉKilisito ahume kʉaɨɨligwa. <verse eid="1CO 14:5" /><verse number="6" style="v" sid="1CO 14:6" />Itɨ gwa anyandʉgʉ ane, aganɨze kitolanyu ndigitye kʉ ntambʉ akɨgeni ɨkʉmʉaɨllya ntʉni? Shanga ɨkʉmʉaɨlya anga kɨntʉ. Ingɨ anga nʉmʉtambʉɨle ʉlɨngi nʉwa kɨtʉnga ang'wɨ lʉkani lang'wi Itunda ang'wɨ ʉkunʉkʉlwa wang'wi Itunda ang'wɨ nʉmanyise papo kʉmʉaɨɨlya. <verse eid="1CO 14:6" /><verse number="7" style="v" sid="1CO 14:7" />Niintʉ niigila ʉpanga niyɨpumya ʉlʉli anga pɨlɨmbɨ ang'wɨ kɨnanda. Itɨɨ, mʉntʉ ʉhumile ʉlɨ kʉlɨnga ɨlyɨmbo nɨlɨkɨmbwa anga maintʉ nanso shanga yʉkʉpumya ʉlʉli anga nitakɨwe? <verse eid="1CO 14:7" /><verse number="8" style="v" sid="1CO 14:8" />Mpembe anga ɨkʉwe ɨhite kʉlɨngwa antʉni, nyenyu nʉkihamba kʉ mbita? <verse eid="1CO 14:8" /><verse number="9" style="v" sid="1CO 14:9" />Itɨʉ nʉnyenye, angamʉtambʉle nkani nɨshanga imanyɨkile, nyenyu nʉkʉlɨnga nɨmʉkʉtambʉla? Nkani yanyu yʉkʉtula shakaʉ. <verse eid="1CO 14:9" /><verse number="10" style="v" sid="1CO 14:10" />Ingɨ mihɨɨ yimolɨ ntambʉ yɨdʉ, kʉtilɨ ga nɨyɨ nɨng'wɨ nɨngila ɨndogoelyo. <verse eid="1CO 14:10" /><verse number="11" style="v" sid="1CO 14:11" />Ingɨ anga ɨze shanga nɨngile ndogoelyo antambʉ nʉkʉligitya mʉntʉ mʉngɨɨza, ʉnene nɨmʉgeni kʉ mʉntʉ nʉwanso nʉng'wenso mʉgeni kʉng'wane. <verse eid="1CO 14:11" /><verse number="12" style="v" sid="1CO 14:12" />Nʉnyenye, kʉnsoko ʉdu mʉkete ɨnsʉla kʉtula niipegwa niya Ng'wahʉ, kagupi nangalu kʉlija nipegwa niyakʉaɨlya kʉamanyisa antʉ nɨamʉhʉɨɨe ʉKilisito.<verse eid="1CO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13" />Kʉlʉlo, mʉntʉ nʉkʉtambʉla ntambʉ nakɨgeni nʉwalompe apegwe ʉhumi nʉwa kʉnononsola <verse eid="1CO 14:13" /><verse number="14" style="v" sid="1CO 14:14" />Kʉnsoko, anga nompe kʉntambʉ akɨgeni, nkolo ane yɨyo ɨkʉlompa, ingɨ ɨmahala ane magila nga mʉlɨmo. <verse eid="1CO 14:14" /><verse number="15" style="v" sid="1CO 14:15" />Ntendeʉlɨ gwa? Kʉlompa mʉnkolo ane, hangɨ kʉlompa kʉmahala ane. Kɨmba kʉnkolo ane, hangɨ kɨmba kʉmahala ane. <verse eid="1CO 14:15" /><verse number="16" style="v" sid="1CO 14:16" />Anga ʉmʉkʉlye Itunda kʉnkolo ako du, ʉkʉlumɨɨlyaʉlɨ mʉntʉ mʉngɨɨza nʉmolɨ pamilʉndo walʉnge, “Ɨtai”, anga ɨze shanga ʉlɨngile nʉkʉligitya? <verse eid="1CO 14:16" /><verse number="17" style="v" sid="1CO 14:17" />Malompi ako nakʉmʉkʉlya Itunda ahumile atule maza tai, ingɨ shanga akʉaɨɨlya antʉ nɨangɨɨza.<verse eid="1CO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18" />Nʉmʉsongeeye Itunda kɨna ʉnene kʉligitya ntambʉ akɨgeni kʉkɨla ʉnyenye mɨhi. <verse eid="1CO 14:18" /><verse number="19" style="v" sid="1CO 14:19" />Ingɨ mʉmilʉndo nʉwa ahʉɨɨli ntakile kʉligitya nkani itaano niilɨngɨkile ingɨ nɨamanyise nɨantʉ angɨɨza, kʉkɨla kʉligitya nkani elupu niya ntambʉ akɨgeni.<verse eid="1CO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20" />Anyandʉgʉ ane, leki kʉtuli anga ang'enya, mʉmakani nɨmabɨ mʉtule anga ang'enya nɨadabʉ, ingɨ nɨmʉkʉsɨga mʉtule anga antʉ nɨakʉlʉ. <verse eid="1CO 14:20" /><verse number="21" style="v" sid="1CO 14:21" />Mʉwandɨkwa wang'wi Itunda yandɨkilwe,</para>
  <para style="q" vid="1CO 14:21">Isekʉlʉ ʉtambʉe itɨ, “Kʉkɨɨla antʉ nɨakʉntambʉla kʉ ntambu akɨgeni,</para>
  <para style="q" vid="1CO 14:21">nʉkʉkɨɨla antʉ nɨageni,</para>
  <para style="q" vid="1CO 14:21">Kʉligitya nɨantʉ awa.</para>
  <para style="q" vid="1CO 14:21">Nɨitɨga antʉ ane shanga akʉntegeelya.”<verse eid="1CO 14:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="1CO 14:22" />Kʉlʉlo gwa, ingɨ kɨpegwa kakʉligitya kʉntambʉ akɨgeni ingɨ kɨlɨngansɨlyo, shanga kʉantʉ nɨakete ʉhʉɨɨli, ingɨ kʉantʉ nɨshanga amʉhʉɨɨɨe ʉKilisito, ingɨ ɨkɨpegwa nɨkakʉtanantya ʉlʉkani lang'wi Itunda ingɨ kʉantʉ awo nɨahʉɨe shanga nɨshanga amʉhʉɨɨe ʉKilisito.<verse eid="1CO 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 14:23" />Itɨ gwa, antʉ ɨhi nɨɨamʉhʉɨɨe ʉKilisito nɨakʉtankana palʉng'wɨ, ɨhi azetambʉla ntambʉ akɨgeni, anga apike antʉ nɨshanga alɨngile ɨntambʉ nanso ang'wɨ nɨshanga amʉhʉɨɨe ʉKilisito, itɨ, shanga akʉlʉnga kɨna ʉnyenye mɨahaline? <verse eid="1CO 14:23" /><verse number="24" style="v" sid="1CO 14:24" />Ingɨ anga ɨze mʉntʉ wɨhi ʉkʉtanantya lʉkani lang'wi Itunda anga wapike mʉntʉ nɨshanga ʉhʉɨɨɨe, mʉntʉ nʉwanso anga wije ʉkʉtambʉlwa ʉbɨ wakwe, mʉntʉ nʉwanso nʉkija ʉkilamʉla ng'wenso. <verse eid="1CO 14:24" /><verse number="25" style="v" sid="1CO 14:25" />Makani napihilwe mʉnkolo akwe akʉpihʉlwa nʉ mʉntʉ nʉwanso ʉkʉtugama nʉkʉmʉkʉlya Itunda, wazelʉnga, “Ɨtai Itunda ʉkolɨ palʉng'wɨ nʉnyenye!”<verse eid="1CO 14:25" /></para>
  <para style="s">Nɨmʉtakɨwe kʉtenda pamʉkʉmʉpolya Itunda</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26" />Anyandʉgʉ, kʉlʉnge ʉlɨ gwa? Nɨmʉkʉtankana palʉng'wɨ kʉmʉkʉlya Itunda, nʉntʉ ʉng'wɨ wɨmbe ɨlyɨmbo, nʉmʉya wamanyise, nʉmʉya watule nʉkʉnʉkʉɨlwa kʉpuma kʉng'wi Itunda, ʉmʉya witʉmɨle ɨkɨpegwa nɨkakʉligitya kʉntambʉ nɨngeni nʉmʉya anononsole makani aya nakʉtambʉlwa. Ɨhi atule kʉnsoko akʉaaɨɨlya antʉ nɨamʉhʉɨɨe Itunda. <verse eid="1CO 14:26" /><verse number="27" style="v" sid="1CO 14:27" />Anga ɨze amolɨ antʉ nɨakʉtambʉla ntambʉ nɨngeni, aligitye abɨɨlɨ abɨɨlɨ ang'wɨ ataatʉ taatʉ, aleke kʉkɨlɨnkɨla azeligitya ʉng'wɨ ʉng'wɨ, hangɨ wazʉmole ʉyʉ nʉwa kʉnononsola makani nakʉtambʉlwa. <verse eid="1CO 14:27" /><verse number="28" style="v" sid="1CO 14:28" />Ingɨ anga ɨze kʉtilɨ nʉkʉnononsola, papo ʉgwa, nʉkʉtambʉla ɨntambʉ akɨgeni wakilage, nʉwaligitye ni Itunda. <verse eid="1CO 14:28" /><verse number="29" style="v" sid="1CO 14:29" />Nɨ antʉ awo nɨa amanga ang'wi Itunda apumye ʉmanga nʉwang'wi Itunda nɨang'wɨ alamʉʉle makani aya nakʉtambʉlwa. <verse eid="1CO 14:29" /><verse number="30" style="v" sid="1CO 14:30" />Ingɨ mʉntʉ ʉlongolekile anga wahole mʉloto kʉpuma kʉng'wi Itunda, nʉkʉtambʉla nʉmʉya, anga mʉntʉ mʉngɨɨza pang'wanso wamʉtegeelye mʉntʉ ʉyʉ naza ʉkʉtambʉla nʉwakilaje. <verse eid="1CO 14:30" /><verse number="31" style="v" sid="1CO 14:31" />Kʉndogoelyo mɨhi mʉhumile kʉtambʉla ʉmanga kʉpuma kʉng'wi Itunda, ʉng'wɨ ʉng'wɨ mɨhi mʉhume kimanyisa nʉkikomelya nkolo. <verse eid="1CO 14:31" /><verse number="32" style="v" sid="1CO 14:32" />Nɨakete kɨpegwa ka kʉtanantya lʉkani lang'wi Itunda, atakɨwe akɨhume ɨkɨpegwa kao,<verse eid="1CO 14:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 14:33" />kʉnsoko Itunda shanga waminyomo ingɨ Itunda nʉwa matiliga. <verse eid="1CO 14:33" /><verse number="34" style="v" sid="1CO 14:34" />Anga niyɨlɨ Mʉnyʉmba ang'wi Itunda kwe, asʉngʉ nɨakilaje ɨhɨtwɨ mʉmilʉndo nʉwahʉɨɨli ang'wi Itunda, Shanga agombigwe kʉligitya ingɨ atule nʉlwiji anga natambʉe malagɨɨlyo. <verse eid="1CO 14:34" /><verse number="35" style="v" sid="1CO 14:35" />Anga ɨzeakete makolyo, aakolye agohaao kʉmatolao, kʉnsoko mɨnyala mʉsʉngʉ kʉligitya mʉmilʉndo nʉwahʉɨɨli ang'wi Itunda.<verse eid="1CO 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36" />Itɨɨ, mʉlʉngile ʉlʉkani lang'wi Itunda lʉpumile kʉng'wanyu? Ang'wɨ lʉmɨzɨɨe ʉnyenye dune? <verse eid="1CO 14:36" /><verse number="37" style="v" sid="1CO 14:37" />Mʉntʉ anga walɨnge kɨna nʉwanso ingɨ mʉmanga wang'wɨ ʉkete kɨpegwa kang'wi Itunda mʉntʉ nʉwa nʉwanso walɨnge nanso nɨkʉmʉandɨkɨla, kɨna malagɨɨlyo ang'wi Isekʉlʉ. <verse eid="1CO 14:37" /><verse number="38" style="v" sid="1CO 14:38" />Ingɨ mʉntʉ nɨshanga ʉkʉlɨnga nanso, ʉgwa, leka kʉmʉkela ʉmʉntʉ nʉwanso. <verse eid="1CO 14:38" /><verse number="39" style="v" sid="1CO 14:39" />Itɨ gwa, anyandʉgʉ ane, mʉtakiwe kʉtula nɨnsʉla akʉtanantya ʉlʉkani lang'wi Itunda, ingɨ mʉleke kʉmʉgilya ʉmʉntʉ nʉkʉtambʉla kʉntambʉ nɨngeni. <verse eid="1CO 14:39" /><verse number="40" style="v" sid="1CO 14:40" />Kʉlʉlo makani ɨhi itʉng'we anga mʉitakɨwe.<verse eid="1CO 14:40" /></para>
  <chapter eid="1CO 14" />
  <chapter number="15" style="c" sid="1CO 15" />
  <para style="s">Wiʉki wang'wa Kilisito</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1" />Itungo ɨlɨ, anyandʉgʉ ane, ndoilwe kʉmʉkɨmbʉsha Nkani Nza izo naɨnʉmʉtanantɨɨye nʉnyenye mɨkaigomba, kʉlʉlo longoleki kishiɨ nʉkʉityata. <verse eid="1CO 15:1" /><verse number="2" style="v" sid="1CO 15:2" />Nkani Nza izi naɨnʉmʉtanantɨɨye ingɨ aɨnzɨla ang'wi Itunda kʉmʉguna. Mʉtakɨwe kʉlongoleka kʉihʉɨɨla inkani niyanso. Anga mʉileke kʉityata, mʉkʉtula mʉhʉɨɨe nakanda.<verse eid="1CO 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3" />Ndogoelyo ʉnene aɨnʉmʉmanyisilye makani anga naɨmanyisigwe, aɨnʉmʉmanyisilye ɨkʉlʉ kʉʉlʉ kɨna ʉKilisito aɨʉkule kʉnsoko amɨlandʉ itʉ anga Wandɨkwa wang'wi Itunda nʉwandɨkilwe, <verse eid="1CO 15:3" /><verse number="4" style="v" sid="1CO 15:4" />kɨna aɨʉɨkilwe mʉkɨbɨɨla nʉ lʉhikʉ nʉla kataatʉ wɨkiʉka, <verse eid="1CO 15:4" /><verse number="5" style="v" sid="1CO 15:5" />nɨ kɨna aɨwiambilye kʉng'wa Petelo nɨ panyambele wɨkiambya kʉ itʉmi ikʉmi na abɨɨlɨ. <verse eid="1CO 15:5" /><verse number="6" style="v" sid="1CO 15:6" />Sʉnga wɨkiambya kʉ nkʉa ɨng'wɨ kʉ anyandʉgʉ nɨakɨile magana atano, nɨang'wɨao akɨlɨ amolɨ apanga ingɨ nɨang'wɨ akulee. <verse eid="1CO 15:6" /><verse number="7" style="v" sid="1CO 15:7" />Panyambele wɨkiambya kʉng'wa Yakobo sʉnga wɨkiambya kʉitʉmi ɨhi.<verse eid="1CO 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 15:8" />Wɨkamalɨnkɨɨlya kiambya kʉng'wane naɨntuile anga mʉng'enya nʉpee mahikʉ akʉtugwa. <verse eid="1CO 15:8" /><verse number="9" style="v" sid="1CO 15:9" />Ndogoelyo ʉnene nɨmʉniino lʉkʉlʉ mʉ itʉmi. Kʉtambʉla itɨ kʉnsoko shanga aɨnonee kitangwa nɨ mitʉmi, aɨnɨagilye antʉ nɨamʉhʉɨɨe Itunda. <verse eid="1CO 15:9" /><verse number="10" style="v" sid="1CO 15:10" />Ingɨ kʉ ʉkende wang'wi Itunda naile anga itɨ nɨ nɨlɨ, nʉ ʉkende wakwe nʉmpee shanga ʉkʉlimɨla nakanda. Ʉnene nitʉmile mʉlɨmo kʉkɨla antʉ ɨhi, ingɨ shanga nene nɨnitʉmile, ʉwʉ ʉkende nɨnkendepilwe ni Itunda wenso witʉma mʉlɨmo palʉng'wɨ nʉnene. <verse eid="1CO 15:10" /><verse number="11" style="v" sid="1CO 15:11" />Itɨ gwa, anga itule nene nɨtanantya ang'wɨ atule itʉmi nɨangɨɨza wawo ɨtanantya, hʉlyo, ʉsese kɨatanantɨlya antʉ lʉkani lʉlo lʉʉlo, hangɨ ɨkɨ kɨkɨ nɨmʉkɨhʉɨɨe.<verse eid="1CO 15:11" /></para>
  <para style="s">Wiʉki witʉ</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12" />Itungo ɨlɨ, anga ɨze kʉtanantilye kɨna ʉKilisito aɨwiʉkigwe ang'wɨ anyu ahumile ʉlɨ kʉlʉnga kɨna kʉtilɨ anga wiʉkigwa? <verse eid="1CO 15:12" /><verse number="13" style="v" sid="1CO 15:13" />Anga ɨze kʉtilɨ anga wiʉki ʉgwa nʉ Kilisito shanga aɨwiʉkile, <verse eid="1CO 15:13" /><verse number="14" style="v" sid="1CO 15:14" />Anga ɨze ʉKilisito shanga aɨwiʉkile, itɨ gwa, ʉtanantyi witʉ wanakanda nʉ ʉhʉɨɨli witʉ wanakanda. <verse eid="1CO 15:14" /><verse number="15" style="v" sid="1CO 15:15" />Nʉsese kʉʉgaza nʉkʉtula kɨakʉɨɨli aʉtele pang'wi Itunda, ndogoelyo kʉmʉtanantɨɨye antʉ kɨna Itunda aɨʉmiʉkilye ʉKilisito. Hangɨ anga ɨze tai kʉtilɨ nʉwiʉkigwa, itɨgwa Itunda shanga aɨʉmiʉkilye ʉKilisito. <verse eid="1CO 15:15" /><verse number="16" style="v" sid="1CO 15:16" />Ingɨ anga itule tai antʉ nɨakulee shanga iʉkigwa, nʉyo ʉKilisito shanga aɨwiʉkile. <verse eid="1CO 15:16" /><verse number="17" style="v" sid="1CO 15:17" />Hangɨ anga ize ʉKilisito shanga aɨʉiʉkigwe, ʉhʉɨɨli wanyu wanakanda, mʉkɨlɨ mʉmolɨ mʉmɨlandʉ anyu. <verse eid="1CO 15:17" /><verse number="18" style="v" sid="1CO 15:18" />Nɨ antʉ naɨamʉhʉɨɨe ʉKilisito nɨakule yʉkʉtula alimɨee lʉkʉlʉ. <verse eid="1CO 15:18" /><verse number="19" style="v" sid="1CO 15:19" />Anga ɨze ʉsʉmbɨɨlyi witʉ mʉng'wa Kilisito ingɨ kʉnsoko a likalo nʉla mihɨɨ, itɨ gwa, ʉsese kɨ antʉ akʉaisɨligwa kʉkɨla antʉ ɨhi mihɨɨ.<verse eid="1CO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20" />Ingɨ kʉlʉ kʉʉlʉʉ, ʉKilisito wiʉkigwe, ng'wenso wang'wandyo kʉ antʉ nɨakule nɨaziiʉkigwa. <verse eid="1CO 15:20" /><verse number="21" style="v" sid="1CO 15:21" />Ndogoelyo anga ɨnsha naɨzile mʉ antʉ kʉkɨɨla kʉ mʉntʉ ʉng'wɨ, ʉlʉkʉlʉ nʉ kiʉka yisakigwe nʉ mʉntʉ ʉng'wɨ. <verse eid="1CO 15:21" /><verse number="22" style="v" sid="1CO 15:22" />Anga ɨantʉ ɨhi nɨɨkuza nakʉsakigwa nʉ Adamu, itɨʉ lʉkʉlʉ antʉ ɨhi akiʉkigwa nakʉsakigwa nʉ Kilisito. <verse eid="1CO 15:22" /><verse number="23" style="v" sid="1CO 15:23" />Ingɨ kɨla mʉntʉ ʉkiʉka kʉ matungo akwe. Kilisito hanza, ʉgwa nawa nɨang'wa Kilisito itungo ʉ Kilisito nʉɨkɨza. <verse eid="1CO 15:23" /><verse number="24" style="v" sid="1CO 15:24" />Papo gwa itungo lampelo lɨkʉpika nʉ Kilisito nʉkʉlimansɨɨlya atemi nʉʉhumi ningʉlʉ. Sʉnga ʉKilisito ʉkʉmʉpa ʉtemi Itunda nɨ Tata wakwe. <verse eid="1CO 15:24" /><verse number="25" style="v" sid="1CO 15:25" />Ndogoelyo ʉKilisito ingɨ ʉtakɨwe wateme hanza kʉpikɨɨla Itunda nʉwɨkalemya alʉgʉ akwe ɨhi nʉkʉatema. <verse eid="1CO 15:25" /><verse number="26" style="v" sid="1CO 15:26" />Mʉlʉgʉ nʉkʉmalɨnkɨɨlya kʉlimansɨligwa ingɨ nsha. <verse eid="1CO 15:26" /><verse number="27" style="v" sid="1CO 15:27" />Wandɨkwa wang'wi Itunda wandɨkilwe, “Itunda ʉɨkile maintʉ ɨhi mʉʉtemi wakwe.” Ingɨ Wandɨkwa wandɨkilwe kɨna, “Maintʉ ɨhi aɨkilwe mʉʉtemi wakwe” ingɨ tai kɨna Itunda dʉ nɨshanga ʉkʉteng'wa nʉ Kilisito, kʉnsoko Itunda ng'wenso ʉmʉpee ʉKilisito maintʉ nanso wamateme. <verse eid="1CO 15:27" /><verse number="28" style="v" sid="1CO 15:28" />Ingɨ maintʉ ɨhi anga ateng'we nʉ Kilisito, papo gwa nʉ Kilisito ʉkitemya kʉng'wi Itunda, kʉlʉnga itɨ Itunda ʉkʉtula mʉtemi mʉkʉlʉ nʉwa intʉ yɨhi.<verse eid="1CO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29" />Anga ize kʉtilɨ wiʉki, itɨ, antʉ awo nɨakʉbadisigwa kʉnsoko ashi asʉmbɨɨye akʉlija kɨntʉ kɨɨ? Anga ɨze ɨashi shanga iʉkigwa, yakɨgwa kʉbadisigwa kʉnsoko antʉ nɨanso? <verse eid="1CO 15:29" /><verse number="30" style="v" sid="1CO 15:30" />Nʉsese nɨkɨgwa kʉitwala mʉʉlʉgʉ matungo ɨhi? <verse eid="1CO 15:30" /><verse number="31" style="v" sid="1CO 15:31" />Anyandʉgʉ, ʉnene kigidɨɨe nɨnsha mahikʉ ɨhi! Nisanilye kʉnsoko anyu nɨ mʉmʉhʉɨɨe ʉKilisito Yesʉ Isekʉlʉ witʉ kɨko kɨkʉnsasha ntanantye ɨkani ɨlɨ. <verse eid="1CO 15:31" /><verse number="32" style="v" sid="1CO 15:32" />Anga ɨze ɨmasɨgo ane amihɨ, ʉne kikʉa niikalɨ niitaki ʉko kʉ Epeso aɨyɨze nzaɨlya ntʉni? Anga ɨze ɨashi shanga akʉiʉka, ʉgwa, “Kʉlye nʉkʉng'wa kʉnsoko mʉdaʉ kʉʉsha.”<verse eid="1CO 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 15:33" />Leki kikongi! Ʉhʉmbashʉya nɨ antʉ nɨabɨ ikanza ntendo ninza.” <verse eid="1CO 15:33" /><verse number="34" style="v" sid="1CO 15:34" />Hʉgʉki! Mandye kʉsɨɨgɨla nɨmaza mʉpele kitʉma ɨmɨlandʉ kʉnsoko nɨang'wɨ mʉng'wanyʉ shanga amʉlɨngile Itunda. Itɨ kʉmʉɨla ingɨ mɨnyala ikʉlʉ kʉng'wanyu.<verse eid="1CO 15:34" /></para>
  <para style="s">Mʉɨlɨ nʉwa ʉiʉki</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35" />Ingɨ ʉmʉntʉ ʉhumile kʉkolya, “Antʉ nɨakulee azeiʉkigwa ʉlɨ? Azetula nɨmɨɨlɨ ɨʉlɨ? <verse eid="1CO 15:35" /><verse number="36" style="v" sid="1CO 15:36" />Nanso makolyo akɨpʉngʉ! Anga ʉtemele ɨmbeʉ anga ɨhite kʉsha shanga ɨkuhelʉka. <verse eid="1CO 15:36" /><verse number="37" style="v" sid="1CO 15:37" />Wɨtemela mbeʉ, ɨtule ngano ang'wɨ mbeʉ ngɨza, ingɨ shanga mʉmea nʉwigela. <verse eid="1CO 15:37" /><verse number="38" style="v" sid="1CO 15:38" />Itunda wɨpumisa mɨmea anga mʉtakɨe kʉpuma mʉmbeʉ niyanso.<verse eid="1CO 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 15:39" />Iʉmbwa yɨhi ingɨ yikete mɨɨlɨ, ingɨ mɨɨlɨ nanso shanga impyani, mɨɨlɨ aana antʉ ingɨ impyani, ni mɨɨlɨ aikalɨ ingɨ mɨngɨza, ninyʉnyi mɨngɨza nɨmɨɨlɨ ansamaki mɨngɨza.<verse eid="1CO 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1CO 15:40" />Ɨkolɨ ɨmɨɨlɨ akigʉlʉ nɨmɨɨlɨ amihɨ, ʉʉza nʉwa mɨɨlɨ akigʉlʉ mɨngɨza, nʉʉza nʉwa mʉɨlɨ nʉwa mihɨɨ ʉngɨza <verse eid="1CO 15:40" /><verse number="41" style="v" sid="1CO 15:41" />Lyoa lɨkete ʉza wakwe, nʉ ng'weli ʉkete ʉza wakwe nɨ nzota ga yɨkete ʉza wakwe, nzota nizo yɨhutana kʉʉza wao.<verse eid="1CO 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42" />Itɨ izetula kiʉki kʉashi atule apanga. Anga ɨmbeʉ, ʉmʉɨlɨ wɨhɨmbɨlwa mʉkɨbɨɨla ʉze ʉbɨɨ, ingɨ wiʉkigwa wɨze ʉza. <verse eid="1CO 15:42" /><verse number="43" style="v" sid="1CO 15:43" />Wɨhɨmbɨlwa kʉ mɨnyala, wɨkaiʉkigwa kikʉlyo, wɨhɨmbɨlwa kʉ ʉlema, wɨiʉkigwa ʉze ʉkete ngulu. <verse eid="1CO 15:43" /><verse number="44" style="v" sid="1CO 15:44" />Nʉkʉhɨmbɨlwa anga mʉɨlɨ ʉdu, nʉʉkʉiʉkigwa mʉɨlɨ nʉwa kɨnkolo. Ʉmolɨ ʉmʉɨlɨ anga nɨkɨʉona, hangɨ ʉmolɨ ʉmʉɨlɨ nʉwa kinkolo. <verse eid="1CO 15:44" /><verse number="45" style="v" sid="1CO 15:45" />Ndogoelyo wandɨkwi wandɨkilwe itɨ, “Mʉntʉ nʉwa ng'wandyo ingɨ Adamu, aɨkɨʉʉmbwa naɨ kɨpanga,” ingɨ ʉ Adamu nʉwa mpelo ingɨ Ng'wahʉ wang'wi Itunda nʉɨapeza ɨantʉ ʉpanga. <verse eid="1CO 15:45" /><verse number="46" style="v" sid="1CO 15:46" />Ingɨ nʉɨtongela kʉng'wako shanga mʉɨlɨ nʉwakɨnkolo, ingɨ mʉɨlɨʉ, wɨkatyata ʉmʉɨlɨ nʉwa kɨnkolo. <verse eid="1CO 15:46" /><verse number="47" style="v" sid="1CO 15:47" />Adamu nʉwa ng'wandyo aɨʉʉmbilwe kʉ malolo, kʉpuma pihɨ, mʉntʉ nʉwa kabɨɨlɨ aɨʉpumɨɨe kigʉlʉ. <verse eid="1CO 15:47" /><verse number="48" style="v" sid="1CO 15:48" />Ɨhi nɨa amolɨ mihɨɨ ingɨ yimpyani nʉ mʉntʉ naɨʉʉmbilwe na malolo, awa nɨakigʉlʉ amolɨ anga ʉyʉ naɨʉpumɨɨe kigulu. <verse eid="1CO 15:48" /><verse number="49" style="v" sid="1CO 15:49" />Anga nɨkimpyani nʉyʉ naɨ ʉʉmbilwe kʉ malolo, ʉlʉkʉlʉ kɨɨkimpyana nʉyʉ naɨʉpumile kigʉlʉ.<verse eid="1CO 15:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50" />Itɨ gwa, anyandgʉ kʉlʉnga itɨ, ɨko nɨkɨzɨpigwe kʉmʉɨlɨ nɨ sakami shanga kɨkʉtula mʉʉtemi nʉwa ng'wi Itunda nɨkɨ nɨkɨbɨ shanga kɨkʉzɨpa.<verse eid="1CO 15:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="1CO 15:51" />Tegeli, nʉmʉɨle ʉnkunku, ʉsese shanga kʉʉsha nɨ kɨɨhi ingɨ kɨɨhi kʉkaɨlwa.<verse eid="1CO 15:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="1CO 15:52" />Matungo na mpembe ampelo, kitungo inino kʉtutya nʉkʉpɨtya, kʉnsoko idede nɨɨkalɨla ɨashi akʉiyʉkigwa atule apanga nʉsese kʉkaɨlwa. <verse eid="1CO 15:52" /><verse number="53" style="v" sid="1CO 15:53" />Kʉnsoko kʉsinja ʉʉ nʉɨbɨpa ʉpele kʉbɨpa nʉwʉ nʉɨkuza ʉpele kʉsha. <verse eid="1CO 15:53" /><verse number="54" style="v" sid="1CO 15:54" />Itɨ gwa, ʉmʉɨlɨ ʉyʉ nʉɨbɨpa nʉɨka tula shanga wɨbɨpa nʉyʉ nʉkza nɨka tula shangawakʉsha papogwa lʉkʉkondanɨɨla ʉlʉkani naɨlʉandɨkile, “Nsha alimansɨligwa ʉhumi wakondanɨɨla!”<verse eid="1CO 15:54" /></para>
  <para style="q">
    <verse number="55" style="v" sid="1CO 15:55" />Nsha, ʉhumi nʉwako ʉmolɨpɨ?</para>
  <para style="q" vid="1CO 15:55">Ʉhumi nʉwako nʉwakʉaalya ʉmolɨpɨ?<verse eid="1CO 15:55" /></para>
  <para style="m">
    <verse number="56" style="v" sid="1CO 15:56" />Ʉwai wansha ingɨ mɨlandʉ nɨngulu amɨlandʉ ingɨ malagɨɨlyo. <verse eid="1CO 15:56" /><verse number="57" style="v" sid="1CO 15:57" />Ingɨ kʉmʉsongelye Itunda nʉɨkʉpeza ʉhumi kʉkɨɨla kʉng'wi Isekʉlʉ witʉ ʉ Yesʉi Kilisito.<verse eid="1CO 15:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58" />Itɨ gwa, anyandʉgʉ ane nɨnʉmʉloilwe mʉkome, mʉleke kʉhingiɨka mʉlongoleke kitʉma ʉmʉlɨmo wang'wi Isekʉlʉ mahikʉ ɨhi, kʉnsoko mʉlɨngile kɨna ʉlwago lanyu shanga nakanda mʉng'wi Isekʉlʉ.<verse eid="1CO 15:58" /></para>
  <chapter eid="1CO 15" />
  <chapter number="16" style="c" sid="1CO 16" />
  <para style="s">Mʉhangʉ nʉwa kʉaɨɨlya Ahʉɨɨli</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1" />Itungo ɨlɨ kʉmʉɨla mʉhangʉ nʉwa kʉaɨɨlya ahʉɨɨli ang'wi Itunda. Tendi anga nɨalagɨɨye ahʉɨɨli ang'wi Itunda nɨa kʉ Galatia kʉtenda. <verse eid="1CO 16:1" /><verse number="2" style="v" sid="1CO 16:2" />Jumapɨlɨ yɨhi antʉ ɨhi wahole mpia nkeehʉ waibagʉle kʉmpelo. Ingɨ wabagʉle anga mʉkendepewe, anga nɨze kʉleke kʉtula nʉʉhangʉlya. <verse eid="1CO 16:2" /><verse number="3" style="v" sid="1CO 16:3" />Anga nɨze kitolanyu, kʉalagɨɨlya antʉ ang'wɨ nɨmʉkʉaholania mʉng'wanyu atwale itʉtʉ nɨkɨnyaʉgeni kanyu kʉ Yelusalemu. <verse eid="1CO 16:3" /><verse number="4" style="v" sid="1CO 16:4" />Anga ɨze inonee ʉnene nongole, itɨ gwa, antʉ nɨanso ninzanilye.<verse eid="1CO 16:4" /></para>
  <para style="s">Masɨgo ang'wa Paʉlo</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5" />Nsɨgile nɨze kitolanyu anga nkɨɨle kʉ Makedonia, kʉnsoko nsɨgile kʉkɨɨla hanza kʉ Mekidonia papo nɨze kʉng'wanyu. <verse eid="1CO 16:5" /><verse number="6" style="v" sid="1CO 16:6" />Angaiyʉke kikiɨ kitolanyu kitungo ʉdu, ang'wɨ nɨhumile kikiɨ palʉng'wɨ nʉnyenye matungo ɨhi na malila, ingɨ mʉhume kʉnzaɨɨlya nongoleke nʉmʉhɨnzo nʉwane pɨhi kʉ ninzʉɨye. <verse eid="1CO 16:6" /><verse number="7" style="v" sid="1CO 16:7" />Ndogoelyo shanga ndoilwe kʉkɨɨla kʉng'wanyu nzeniangʉpɨye nʉ mʉhɨnzo, Isekʉlʉ anga walowe nsʉmbɨɨye kikiɨ kʉng'wanyu kitungo ikupɨ.<verse eid="1CO 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 16:8" />Ingɨ kʉsaga papa pa Epeso kʉpikɨɨla lʉhikʉ nʉla Pentekosite. <verse eid="1CO 16:8" /><verse number="9" style="v" sid="1CO 16:9" />Lyoma lɨkolɨ kʉnsoko amʉlɨmo wane nɨnkete apa, palʉng'wɨ nʉkʉtula akolɨ antʉ ɨdʉ nɨakʉnkɨngɨla ndeke kitʉma.<verse eid="1CO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10" />Ingɨ ʉTimoteo anga waza kʉng'wanyu mʉsɨngɨɨlyi, kendegeeli wishiɨ nɨ matiliga waleke kʉtula nʉwoa, kʉnsoko ʉkitʉma mʉlɨmo wang'wi Isekʉlʉ anga ʉnene. <verse eid="1CO 16:10" /><verse number="11" style="v" sid="1CO 16:11" />Kʉlʉlo mʉntʉ wɨhi waleke kʉmʉdalaha, ingɨ mʉaɨɨlyi walongoleke nʉ mʉhɨnzo wakwe kʉ matiliga ingɨ wahume kʉtulya kʉng'wane, kʉnsoko ʉnene nʉmʉlindɨɨe waze palʉng'wɨ nɨaluna itʉ.<verse eid="1CO 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12" />Apolo mʉnyandʉgʉ. Nʉminenile nangalʉ wangʉpe waze kʉng'wanyu palʉng'wɨ nɨanyandʉgʉ angɨza amiʉmbaʉmbɨle kʉng'wanso kʉ Kolinto. Palʉng'wɨ nɨ kɨna shanga ʉloilwe lʉkʉlʉ kɨza itungo ɨlɨ. Itunda anga waaɨɨlye ʉzile ʉdu.<verse eid="1CO 16:12" /></para>
  <para style="s">Paʉlo ʉmalɨnkɨɨye kʉandɨka itɨ</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13" />Hʉgʉki, mʉkamatɨke lʉkʉlʉ mʉʉhʉɨli, mʉtule mɨagimya ɨze mʉkete ingulu. <verse eid="1CO 16:13" /><verse number="14" style="v" sid="1CO 16:14" />Itʉmi maintʉ ɨhi kʉ ʉlowa.<verse eid="1CO 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15" />Ʉnyenye mʉlɨngile kɨna Ʉsitepwano nɨ antʉ amitolakwe wawo aɨahʉɨɨli ang'wandyo mʉ kɨsalɨ ka Akaya, nɨenso ipumilye kʉaɨɨlya antʉ ang'wi Itunda. Anyandʉgʉ ane kʉminena nʉnyenye <verse eid="1CO 16:15" /><verse number="16" style="v" sid="1CO 16:16" />mʉtyate intendo niya kʉaaɨɨlya ɨantʉ anga nɨɨtenda nɨanso, nintendo niya antʉ ɨhi nɨitʉma mʉlɨmo palʉng'wɨ nɨenso.<verse eid="1CO 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 16:17" />Niloile nangalʉ kɨna Sitepwana nʉ Politunato nʉ Akaiko apika, alihɨɨla ɨlyoma naza mɨkʉtilɨ ʉnyenye. <verse eid="1CO 16:17" /><verse number="18" style="v" sid="1CO 16:18" />Amɨloelya ɨnkolo ane nɨnkolo anyu. Kʉlʉlo inonee kʉakɨmbʉka ɨantʉ nɨaitɨ.<verse eid="1CO 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19" />Ahʉɨɨli ang'wi Itunda nɨakolɨ kʉ Asia amʉlamʉkilye. Kʉ ʉhumi wang'wi Isekʉlʉ mʉlamʉkigwe nʉ Akula nʉ Pilisika palʉng'wɨ nɨantʉ ɨhi nɨang'wi Itunda nɨakolɨ mʉmatolao. <verse eid="1CO 16:19" /><verse number="20" style="v" sid="1CO 16:20" />Mʉlamʉkigwe nɨanyandʉgʉ ɨhi.</para>
  <para style="p" vid="1CO 16:20">Nʉnyenye ilamʉshi kʉ kɨlɨngasɨɨlyo ka ʉlowa wang'wi Itunda.<verse eid="1CO 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21" />Ʉnene Paʉlo kʉandɨka ɨmɨlamʉ ɨyɨ kʉ mʉkono wane.<verse eid="1CO 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22" />Mʉntʉ wɨhi nɨshanga ʉmʉloilwe Isekʉlʉ nʉwazung'we!</para>
  <para style="p" vid="1CO 16:22">Malanata, ndogoelyo akwe Isekʉlʉ witʉ nzʉʉ!<verse eid="1CO 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 16:23" />Ʉkende wang'wi Isekʉlʉ witʉ Yesʉ ʉtule nʉnyenye.<verse eid="1CO 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 16:24" />Nʉmʉloilwe ʉnyenye mɨhinɨmʉmʉhʉɨɨe ʉ Kilisito Yesʉ.<verse eid="1CO 16:24" /></para>
  <chapter eid="1CO 16" />
</usx>