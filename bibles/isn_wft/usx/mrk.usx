<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">Isanzu Bible Version</book>
  <para style="h1">MALIKO</para>
  <para style="toc1">Nkani ni Nza anga niyandɨkilwe nʉ Maliko</para>
  <para style="toc2">Maliko</para>
  <para style="toc3">Mak</para>
  <para style="mt2">Nkani Nza anga nɨyandɨkilwe nʉ</para>
  <para style="mt1">MALIKO</para>
  <para style="imt">Ntongeela a nkani niyanso</para>
  <para style="iot">Namolɨ</para>
  <para style="ip">NKANI ni Nza niyang’wa Maliko ɨhanga I Nkani Nza nzʉya ni innɨ mʉ mbugulu Ilago nipya niiganʉe ʉlikalo lang’wa Yesʉ Kilisito. Yɨhi yitangwaa Nkani Nza,’’ ndogoelyo akwe “Nkani Nza.’’ Mbugulu niyanso aɨyandɨkilwe naɨakɨla ɨnsha ang’wa Yesʉ, aɨyandikliwe nʉ Matayo nʉ Maliko nʉ Lʉka nʉ Yohana. Nkani Nza nɨyandɨkilwe nʉ Maliko zizo nkupɨ mʉ Nkani Nza yɨhi ni innɨ. Nɨitiga ikʉmʉkile kina yandɨkilwe mʉ Nkani Nza yihi mʉ matungo a myaka makʉmi mʉtangatʉ na itaano nɨ myaka makʉmi mʉpungatɨ naɨ watugwa u Kilisito. Alɨngi ɨdʉ ahʉɨɨe kɨna ɨmbugulu a Nkani Nza niang’wa Maliko iandɨkiwe kʉ Loma kʉnsoko akʉasambya Akilisito a kɨlumi nɨa kʉng’waso.</para>
  <para style="ip">Nɨiti ga Maliko naɨ ʉkumʉkile kɨna Yohana Maliko, aɨ mʉhemba wa Mitʉmi Paulo nʉ Balinaba, ingɨ ʉgombi wakwe ingɨ aɨ lʉalemaaye naɨ waleka ʉmʉhɨnzo wao nʉla ʉmishonali “Ntendo niya Itʉmi 13:13.’’ Panyambele Maliko akatunga mʉhɨnzo, akalongolania nʉ Balinaba ‘’Ntendo nia Itʉmi 15:37-39’’. Maliko aɨ ʉlɨngɨkile kɨna mʉhʉmbamʉya nʉwa pakupɨ nʉwang’wa Petelo ''Petelo 5:13’’. Nɨitɨ ga ʉ Maliko shanga aɨ wilolenkee ʉlikalo lang’wa Yesʉ, alɨngi ahʉɨɨe kɨna ʉ Maliko aɨ ʉandɨkile ʉkʉɨɨli wang’wa Petelo nʉwanso wʉwo wandɨɨlyo nʉwa Nkani Nza niyandɨkilwe nʉ Maliko. Mʉ Nkani Nza, Maliko ʉlagɨɨye ʉtanantyi nʉwa ʉmanyisi wang’wa Yesʉ mʉ matungo ampelo.</para>
  <para style="ip">Kɨkupɨ ka nkani izi.</para>
  <para style="io1">Maliko ʉtongeeye nkani 1:1-13.</para>
  <para style="io1">Sʉnga Maliko akaganʉla mʉlɨmo wang’wa Yesʉ naɨʉkolɨ kihɨɨ a Galilaya 1:14-8-21.</para>
  <para style="io1">Sʉnga Maliko ʉkʉganʉla mʉhɨnzo wang’wa Yesʉ kʉlongola kʉ Yelusalemu 8:22-10-52</para>
  <para style="io1">Ʉmalɨnkɨɨlyo Maliko akaganʉla matungo Yesʉ naɨ ʉkolɨ kʉ Yelusalemu, akaganʉla ni nsha nʉ wiʉki wang’wa Yesʉ 11:1-16-8</para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">Ʉtananti wang’wa Yohana Mʉbadisi</para>
  <para style="r">
    <ref loc="MAT 3:1-12">Matayo 3:1-12</ref>; <ref loc="LUK 1:1-18">Lʉka 1:1-18</ref>; <ref loc="JHN 1:19-28">Yohana 1:19-28</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />Ʉwʉ wʉwʉ ng’wandyo nʉwa Nkani Nza niyang’wa Yesʉ Kilisito, Ng’wana wang’wi Itunda. <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />Yandɨɨye anga niyandɨkilwe mʉmbugulu a mʉmanga wang’wi Itunda nʉitangwa Isaya,</para>
  <para style="q" vid="MRK 1:2">“Itunda akalʉnga, ‘Kʉlagɨɨlya mitʉmi wane atongele akʉnoneelelye ʉkɨɨlo nʉwako.’<verse eid="MRK 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MRK 1:3" />Lʉli la mʉntʉ nʉkitʉnta mʉwɨɨ, ‘Mʉnoneleelyi Isekʉlʉ <note caller="+" style="f"><char style="fr" closed="false">1:3 </char></note>ʉkɨɨlo wakwe, mihambe kʉmʉsɨngɨɨlya Isekʉlʉ nʉpembilye.”’<verse eid="MRK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />Itigwa mitʉmi nʉwanso aɨ Yohana Mʉbadisi akapembelya mʉwɨɨ wazetanantya, kɨna antʉ ile itʉnʉ nʉkʉbadisigwa Itunda waalekele ɨmɨlandʉ ao. <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />Antʉ ɨdʉ kʉpuma nkɨka nɨya Yʉdea nɨanya kʉ Yelusalemu, akatula mʉhanga ʉ Yohana pamongo nʉwa Yolodani akamʉtegeelye, akatulila itʉnʉ nɨla mɨlandʉ ao nʉkʉbadisigwa.<verse eid="MRK 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6" />Yohana aɨwiɨndile itugalo naɨ lɨtumilwe namauli akikalɨ nɨkitangwa ngamɨa, nʉmʉkɨlɨno kakwe akakomisɨlya mʉsipi wandɨlɨ. Nindya yakwe aɨ nkʉmbɨ nʉ ʉkɨ nʉwa mihaka. <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />Mʉʉtananti wakwe aɨ ʉlongolekile kʉlʉnga, “Anga nkɨle ʉnene ʉkolɨ nʉntyatɨle mʉnyangulu kʉkɨla ʉnene. Ʉnene nɨmʉgila lʉkumo nʉla kʉtolya mɨkoha a makwasa akwe. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />Ʉnene kʉmʉbadisa namazɨ, ingɨ nʉwanso ʉkʉmʉbadisa kʉ Ng’waʉ Ng’welʉ.”<verse eid="MRK 1:8" /></para>
  <para style="s">Yesʉ ʉkʉbadisigwa nʉ kʉgeng’wa</para>
  <para style="r">
    <ref loc="MAT 3:13">Matayo 3:13</ref>; <ref loc="MAT 4:11">4:11</ref>; <ref loc="LUK 3:21-22">Lʉka 3:21-22</ref>; <ref loc="LUK 4:1-13">4:1-13</ref></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />Mahɨkʉ nanso Yesʉ akapuma kʉ Nazaleti, mʉkɨsalɨ ka Galilaya, akapika kʉng’wa Yohana akabadisigwa mʉmongo nʉwa Yolodani. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />Yesʉ naɨ wapuma ʉdu mʉmazɨ, akaona igʉlʉ lɨkalugʉlwa, nʉ Ng’waʉ akamʉsimɨɨla anga nkʉlʉ nɨsima. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />Akija lʉli lang’wi Itunda kʉpuma kigʉlʉ lʉkʉlʉnga, “Ʉewe wɨng’waane nɨnʉkʉloilwe, naloeeligwa nʉewe.” <verse eid="MRK 1:11" /><verse number="12" style="v" sid="MRK 1:12" />Itungo lɨlo lɨɨlo Ng’waʉ akamʉtonga ʉ Yesʉi kʉlongola mʉwɨɨ. <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />Akishiɨ mahikʉ makʉmi annɨ akazegeng’wa nʉ Shetani. Kʉng’wanso aɨikalanɨa niikalɨ, itʉmi akigʉlʉ nɨang’wa Itunda ɨkamʉaɨɨlya.<verse eid="MRK 1:13" /></para>
  <para style="s">Yesʉ ʉkʉitanga abua nsamaki annɨ amʉtyate</para>
  <para style="r">
    <ref loc="MAT 4:12-22">Matayo 4:12-22</ref>; <ref loc="LUK 4:14-15">Lʉka 4:14-15</ref>; <ref loc="LUK 5:1-11">5:1-11</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />Naɨ akɨla mahikʉ idʉ Yohana akatungwa mukadulumu. Naɨ watungwa, Yesʉ akalongola kʉ Galilaya akatanantya Nkani Nza nɨyang’wi Itunda. <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />Wazelunga, “Matungo apika nang’wi Itunda kʉtema. Mʉtakɨwe mile itʉnʉ nʉkʉleka mɨlandʉ anyu hangɨ mʉhʉɨɨle Nkani Nza.” <verse eid="MRK 1:15" /><verse number="16" style="v" sid="MRK 1:16" />Lʉhikʉ lʉng’wɨ Yesʉ aɨʉkɨɨe mʉmpelo alʉzɨ nʉlʉkʉlʉ nʉla Galilaya, akaaona abua nsamaki abɨɨlɨ. Simioni nʉ mʉniino wakwe ʉ Andelea azebua nsamaki kʉ nyabu. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />Yesʉ akaatambʉɨla, “Ntyati, ʉnene kʉmʉmanyisa mʉtule aleta antʉ kʉg’waane anga naɨ mɨbua insamaki.” <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />Ʉʉgwa itungo ʉdu akaleka inyabu yao, akamʉtyata. <verse eid="MRK 1:18" /><verse number="19" style="v" sid="MRK 1:19" />Naʉlongoe patongela ʉdu, akaaona Yakobo nʉ Yohana ahʉmba ang’wa Zebedayo. Nɨenso aɨakolɨ mibɨnɨ lao azenoneelya nyabu. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />Yesʉ akaitanga amʉtyate, nɨenso akamʉleka ʉ Zebedayo tata ao mibɨnɨ palʉng’wɨ nɨitʉma mɨlɨmo, akamʉtyata ʉ Yesʉi.<verse eid="MRK 1:20" /></para>
  <para style="s">Yesʉ ʉkʉmʉhegelya mʉntʉ hɨng’wɨ</para>
  <para style="r">
    <ref loc="LUK 4:31-37">Lʉka 4:31-37</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />Sʉnga Yesʉ nɨamanyinsigwa akwe akalongola kʉ Kapelanaumu, naɨlapika ʉlʉhikʉ nʉla kʉsupya Ayahudi Yesʉ akingɨla mʉnyʉmba akʉtankanɨla Ayahudi akandya kʉmanyisa. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />Antʉ ɨdʉ akakʉɨlwa ʉmanyisi wakwe, kʉnsoko aɨ ʉkʉmanyisa anga mʉntʉ nʉkete ʉhumi, shanga anga amanyisi amalagɨɨlyo ang’wa Musa nɨa Kɨyahudi nɨɨmanyisa.<verse eid="MRK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23" />Mʉnyʉmba akʉtankanɨla Ayahudi aɨ ʉkolɨ mʉntʉ ʉkete hɨng’wɨ, akakʉta akalʉnga, <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />“Kilee ntʉni nʉewe, Yesʉ mʉnya kʉ Nazaleti? Itɨɨ, ʉzekʉlɨmansilyane? Nɨngile kɨna ʉewe wɨ Kinyene nʉkomilwe nʉpembeeye kʉng’wi Itunda.”<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />Yesʉ akamʉpatya ʉhɨng’wɨ nʉwanso, “Kilaga, puma mʉleke ʉ mʉntʉ ʉyʉ.”<verse eid="MRK 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26" />Ʉʉgwa, hɨng’wɨ nʉwanso akamʉhingɨsa ʉ mʉntʉ nʉwanso, akalɨla kʉlʉli nʉlʉkʉlʉ, akapuma. <verse eid="MRK 1:26" /><verse number="27" style="v" sid="MRK 1:27" />Antʉ ɨhi akakʉɨlwa, akikolya, “Makani kɨ aya? Itɨɨ, ʉmanyisigwa ʉpyane ʉwʉ? Mʉntʉ ʉyʉ ʉkete ʉhumi wakʉlagɨɨlya ahɨng’wɨ, nɨenso akʉmijaa!”<verse eid="MRK 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28" />Nkani yang’wa Yesʉ yɨkakumʉka nkɨka yɨhi niya Galilaya.<verse eid="MRK 1:28" /></para>
  <para style="s">Antʉ ɨdʉ akʉkomigwa nʉ Yesʉi</para>
  <para style="r">
    <ref loc="MAT 8:14-17">Matayo 8:14-17</ref>; <ref loc="LUK 4:38-41">Lʉka 4:38-41</ref></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />Yesʉ nɨ amanyisigwa akwe azeamolɨ ɨa Simioni nʉ Andelea nʉ Yakobo nʉ Yohana akapuma mʉnyʉmba akʉtankanɨla Ayahudi, akatongolomoka akalongola kito nɨlaa Simoni nʉ Andelea. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />Mkwɨngwa wang’wa Simoni nʉwa kɨsʉngʉ aɨ mʉlwae, ʉlae mʉʉlɨlɨ, nɨenso akamʉtambʉɨla ʉ Yesʉi ʉlwae nʉwa mʉkwingwa wang’wa Simoni. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />Yesʉ akamʉhanga mʉsʉngʉ nʉwanso, akamʉamba kʉmʉkono, akamʉʉsha. Akakomya ʉlwae nʉwanso, akandya kʉitʉmɨla.<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />Naɨ yapika mpɨndɨ, naɨ lakɨla ʉlʉhikʉ nʉla kʉsʉpya, antʉ akamʉletela ʉ Yesʉi alwae ɨhi nɨantʉ nɨingɨɨwe nɨa hɨng’wɨ. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />Antʉ ɨdʉ mʉkɨsalɨ nɨkanso akilinga kʉnzi pamʉmpita. <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />Nʉng’wenso ʉ Yesʉi akaakomya antʉ ɨdʉ naɨakete ndwala yɨsa, akaapumya ahɨng’wɨ ɨdʉ mʉmɨɨlɨ aalwae, ingɨ akaagilya ɨahɨng’wɨ aleke kʉligitya kɨntʉ kɨhi kʉnsoko amʉlɨngile kɨna nʉwanso nyenyu.<verse eid="MRK 1:34" /></para>
  <para style="s">Yesʉ ʉkʉtanantya kʉ Galilaya</para>
  <para style="r">
    <ref loc="LUK 4:42-44">Lʉka 4:42-44</ref></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />Mʉdaʉ manɨambwa, Yesʉ akapuma, akalongola kʉlompa nkɨka naɨkʉtilɨ anga antʉ. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />Simoni nɨaʉya akalongola kʉmʉduma, <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />naɨ amʉona akamʉɨla, “Antʉ ɨdʉ akʉʉduma.”<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />Ingɨ ʉ Yesʉi akaaɨla, “Kwɨni mʉisalɨ ingɨza nia pakupɨ nʉkʉng’wanso ga nende ntanantye Nkani Nza, kʉnsoko wʉwo mʉlɨmo nzɨɨe.”<verse eid="MRK 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 1:39" />Sʉnga akenda nkɨka yɨhi ʉko kʉ Galilaya akatanantya mʉnyʉmba nia kʉtankanɨlya Ayahudi nʉkʉazunza ahɨng’wɨ.<verse eid="MRK 1:39" /></para>
  <para style="s">Yesʉ ʉkʉmʉkomya mʉnyambili</para>
  <para style="r">
    <ref loc="MAT 8:1-4">Matayo 8:1-4</ref>; <ref loc="LUK 5:12-16">Lʉka 5:12-16</ref></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />Mʉntʉ ʉng’wɨ nɨ mʉnyambili akamʉhanga ʉ Yesʉi, akatungama, akamʉlompa, “Anga ʉlowe ʉhumile kʉnelya!”<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />Yesʉ akamʉonela kɨnyaʉwai, akagoola ʉmʉkono wakwe, akamʉgutya nʉkʉmʉɨla, “Ndoilwe, ele!” <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />Ʉʉgwa itungo lɨlo lɨɨlo ɨmbili ɨkahega mʉ mʉntʉ nʉwanso, akeligwa, akagombeka kung’wi Itunda. <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />Sʉnga ʉ Yesʉi akakaya kʉmʉɨla hega longola, hangɨ akamʉɨla, <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />“Goza ʉleke kʉmʉɨla mʉntʉ wɨhi ikani ɨlɨ, ingɨ longola wiambye kʉ mʉpolyi, nʉkʉpumya ipolyo kʉnsoko akeligwa kʉng’wako anga naɨʉlagɨɨye ʉ Musa kʉakamɨnkɨɨlya kɨna weligwa.”<verse eid="MRK 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45" />Sʉnga ʉ mʉntʉ nʉwanso akatula kʉkumʉsha inkani niyanso nkɨka yɨhi nʉkʉtambʉla makani ɨdʉ, Yesʉ akatulipihɨɨlya kingɨla mʉkɨsalɨ, akikiɨ kʉnzɨ, kɨmpelo. Nɨitɨga, antʉ ɨdʉ akamʉtyata kʉpuma nkɨka yɨhi.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">Yesʉ ʉkʉmʉkomya mʉntʉ nʉpoiye</para>
  <para style="r">
    <ref loc="MAT 9:1-8">Matayo 9:1-8</ref>; <ref loc="LUK 5:17-26">Lʉka 5:17-26</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />Naɨyakɨla mahikʉ makehʉ, Yesʉ akatulya kʉ kɨsalɨ ka Kapelanaumu, antʉ akija kɨna ʉkolɨ kitolakwe. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />Ʉʉgwa, antʉ ɨdʉ akɨza, ingɨ yɨkatula kʉtilɨ lyoma pamʉlango. Yesʉ aɨ ʉkʉtanantya lʉkani lang’wi Itunda. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />Akapika antʉ annɨ amʉkenkile mʉlwae nʉpoiye amʉletile kʉng’wa Yesʉ. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />Akaleng’wa kʉmʉtwala pakʉpɨ nʉ Yesʉi, kʉnsoko amʉkoegano nʉwa antʉ. Ʉʉgwa akanankɨla kitembe akataʉla paɨ ʉmolɨ ʉ Yesʉi. Naɨ alija ɨlyoma, akamʉsimya mʉntʉ nʉwanso waze ʉlae mʉndɨlɨ. <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />Yesʉ naɨwaona itɨ nɨamʉhʉɨɨe, akamʉɨla ʉ mʉntʉ nʉwanso naɨ ʉpoiye, “Mʉhʉmba mɨane, nakʉlekela ɨmɨlandʉ ako.”<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />Amanyisi ang’wɨ nɨa amalagɨɨlyo ang’wa Musa naɨ ikiɨ pang’wanso akasɨga mʉnkolo yao, <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />“Ʉkʉgema ʉlɨ kʉlʉnga itɨ? Ʉyʉ ʉkʉmʉbehʉla Itunda. Kʉtilɨ anga mʉntʉ nʉkʉlekeela ɨmɨlandʉ ingɨ Itunda wing’wene.”<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />Pumpulugu Yesʉ naɨ walɨnga ɨmasɨgo ao, akaaɨla, “Nɨkɨ mʉkʉsɨga itɨ? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />Nɨkɨʉlɨ nɨkɨtontu, ‘Kʉmʉɨla mʉntʉ ʉyʉ nʉpoiye, ‘Walekelwa ɨmɨlandu ako,’ ang’wɨ kʉmʉɨla, ‘Uka! Hola ɨndɨlɨ ako ulongole?’ <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />Ingɨ, ndoilwe mʉlɨnge kɨna, ʉnene Ng’waa Mʉntʉ nkete ʉhumi mʉ ʉnkumbigʉlʉ nʉwakʉlekela ɨantʉ ɨmɨlandʉ ao.” Ʉʉgwa, akamʉɨla ʉmʉntʉ ʉyʉ naɨ mʉlwae, <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />“Kʉʉɨla ʉka, hola ɨndɨlɨ ako ʉlongole kitolako!”<verse eid="MRK 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12" />Papo paapo mʉntʉ nʉwanso akaʉka, akahola ɨndɨlɨ akwe akalongola akaziseseelya, ɨhi akaze aloeye. Akakʉɨlwa nangalu, akamʉlʉmbɨɨlya Itunda azelʉnga, “Ɨza kʉkɨlɨ kʉone ikani anga ɨlɨ!”<verse eid="MRK 2:12" /></para>
  <para style="s">Yesʉ ʉkʉmitanga ʉ Lawi wamʉtyate</para>
  <para style="r">
    <ref loc="MAT 9:9-13">Matayo 9:9-13</ref>; <ref loc="LUK 5:27-32">Lʉka 5:27-32</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />Yesʉ akalongola hangɨ kʉmpelo alʉzɨ nʉlʉkʉlʉ nʉla Galilaya. Milʉndo waantʉ ʉkamʉhanga, nʉyo akatula amanyisa. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />Naɨ ʉkʉkɨla mʉng’wanso, akamʉona Lawi ng’wana wang’wa Alupayo, wikiɨ pa ʉhoeelo nʉwa kodi, Yesʉ akamʉɨla, “Ntyate.” Lawi akaʉka akamʉtyata.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />Sʉnga ʉ Lawi akamana ʉ Yesʉi kʉlya ndya kitolakwe. Ahoeela kodi ɨdʉ nɨaʉya naɨ akumʉkile kɨna anyamɨlandʉ akamʉtyata ʉ Yesʉi palʉng’wɨ nɨamanyisigwa akwe, nɨantʉ ɨdʉ akalɨzanɨa ɨndya pang’wanso. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />Amanyisi amalagɨɨlyo ang’wa Musa ang’wɨ naɨɨza Apalisayo, naɨ aona ʉ Yesʉi ʉkʉlɨzania nɨahoeela kodi palʉng’wɨ nɨaʉya naɨ akumʉkile kɨna anyamɨlandʉ, akaakolya ɨamanyisigwa akwe, “Nɨkɨ ʉkʉlɨzanɨa nɨantʉ nɨakumʉkile kɨna anyamɨlandʉ?”<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />Yesʉ naɨwija akaasʉkɨɨlya, “Nɨ apanga shanga ɨhiyaa ʉmʉkilɨki, ingɨ nɨalwae ɨhiyaa mʉkilɨki. Shanga aza nzile aduma nɨagombekile kʉng’wi Itunda, aza nzile aduma anyamɨlandʉ.”<verse eid="MRK 2:17" /></para>
  <para style="s">Yesʉ ʉkimpyania ʉmanyisi wakwe nʉ ʉmanyisi nʉwa kalɨ</para>
  <para style="r">
    <ref loc="MAT 9:14-17">Matayo 9:14-17</ref>; <ref loc="LUK 5:33-39">Lʉka 5:33-39</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />Itungo lɨng’wɨ amanyisigwa ang’wa Yohana nɨ Apalisayo aɨ agwaiye kʉlya. Ʉʉgwa, ɨantʉ akamʉkolya ʉ Yesʉi, “Kʉnɨkɨ amanyisigwa ang’wa Yohana nɨ Apalisayo ɨgwalya kʉlya, ingɨ amanyisigwa ako shanga ɨgwalya kʉlya?”<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />Yesʉ akaasʉkɨɨlya, “Itɨɨ, antʉ nɨanilwe kʉwɨnga ahumile ʉlɨ kʉgwalya kʉlya anga ʉmʉtɨzɨɨla waze ʉmolɨ palʉng’wɨ nɨenso? Matungo ɨhi nɨamolɨ palʉng’wɨ nʉmʉtɨzɨɨla shanga akʉgwalya kʉlya. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />Ingɨ mahikʉ apembilye nɨazehegeligwa ʉmʉtɨzɨɨla, papo gwa mahikʉ nanso azegwalya kʉlya.<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />“Antʉ shanga ɨtema ɨkɨlaka mitugalo nɨpya nʉkʉkʉɨɨla mitaho. Anga akʉɨɨle, kɨlaka nɨkɨpya kɨkʉtaʉla mitaho nɨlanso, pa italʉkile ikʉtalʉka ikʉlʉ. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />Hangɨ ɨantʉ shanga ɨkɨtɨla ɨdibai nɨmpya mʉnsaʉda nɨkʉlʉpaae. Anga atende itɨ, ɨdibai ɨkʉtamʉla ɨnsaʉnda nanso, ɨdibai ɨkʉhunʉka nɨnsaʉnda ɨkʉgazɨka. Ɨdibai nɨmpya ɨkɨtɨlwa mʉnsaʉda nɨmpya.”<verse eid="MRK 2:22" /></para>
  <para style="s">Yesʉ ng’wenso Isekʉlʉ nʉwa Lʉhikʉ nʉla Kʉsupya</para>
  <para style="r">
    <ref loc="MAT 12:1-8">Matayo 12:1-8</ref>; <ref loc="LUK 6:1-5">Lʉka 6:1-5</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />Lʉhikʉ lʉng’wɨ mʉ mahikʉ akʉsupya nʉla Ayahudi, Yesʉ aɨʉkɨɨe mʉmɨgʉnda angano. Naɨakʉgenda, amanyisigwa akwe akatulapʉʉla nʉ kʉpigiha mapemba angano. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />Apalisayo akamʉkolya, “Goza! Nɨkɨ akitʉma ikani nɨlɨgiigwe kitʉng’wa lʉhikʉ nʉla kʉsupya nʉla Ayahudi?”<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />Yesʉ akaasʉkɨɨlya, “Itɨɨ, shanga mʉsomilene mʉ Ʉandikwa nʉ Ʉza naɨʉtendile ʉ Daudi palʉng’wɨ nɨaʉya itungo naɨahumilwe ɨnzala? <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />Daudi aɨwingɨe mʉnyʉmba ang’wi Itunda, akahola mɨkate aɨagombigwe kʉlɨgwa nɨapolyi du, akalya indya naɨ iɨkilwe ntongela ang’wi Itunda, akaapa nɨaʉya. Ikani nɨlanso aɨlitʉmilwe ʉ Abiasali aɨza mʉpolyi nʉ mʉkʉlʉ.”<verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />Ʉʉgwa, Yesʉ akaaɨla, “Lʉhikʉ nʉla kʉsupya aɨlʉɨkilwe kʉnsoko akʉa aɨɨlya antʉ, shanga antʉ kʉtula atʉʉng’wa a lʉhikʉ nʉla kʉsupya! <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />Kʉlʉlo ʉnene, Ng’waa Mʉntʉ yʉ nene nɨ Mʉkʉlʉ nʉwa Lʉhikʉ nʉla Kʉsupya nʉla Ayahudi.”<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">Yesʉ ʉkʉponia mʉntʉ mʉ lʉhikʉ nʉla kʉsupya</para>
  <para style="r">
    <ref loc="MAT 12:9-14">Matayo 12:9-14</ref>; <ref loc="LUK 6:6-11">Lʉka 6:6-11</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />Lʉhikʉ lʉlya nʉla kʉsupya, Yesʉ akingɨla hangɨ mʉnyʉmba akʉtankanɨlya Ayahudi, mʉnyʉmba nanso aɨʉkolɨ mʉntʉ mʉkono wakwe ʉpoiye. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />Ingɨ mʉng’wanso, Apalisayo ang’wɨ aɨ amʉlindɨe amʉkomye ʉ mʉntʉ nʉwanso Lʉhikʉ nʉla kʉsupya ingɨ aɨ atungɨe alije nsoko akʉmʉsemela <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />Yesʉ akamʉɨla ʉ mʉntʉ ʉyʉ ʉmʉkono naɨ ʉpoiye, “Nzʉʉ apa pakatɨ” <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />Sʉnga, Yesʉ akaakolya, “Itɨɨ, Lʉhikʉ nʉla kʉsupya igombigwene kitʉma ikani niza ang’wɨ kitʉma ikani nibɨ, kʉguna ʉpanga nʉwa mʉntʉ ang’wɨ kʉbʉlaga?”</para>
  <para style="p" vid="MRK 3:4">Ingɨ nɨanso akakilaga ihɨ twɨɨ. <verse eid="MRK 3:4" /><verse number="5" style="v" sid="MRK 3:5" />Pang’wanso akaagoza ɨhi kikʉo, akatula nʉkɨa kʉnsoko akʉhita kʉhʉɨɨla kʉng’wao. Papo gwa akamʉɨla ʉmʉntʉ nʉwanso, “Goola ʉmʉkono wako!” Mʉlwae akaʉgoola ʉmʉkono wakwe, ʉkapangataala. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />Papo paapo Apalisayo akapuma kʉnzi, akigombya palʉg’wɨ nɨahemba ang’wa Helode akʉmʉlimansɨɨlya ʉlɨ ʉ Yesʉi.<verse eid="MRK 3:6" /></para>
  <para style="s">Milʉndo waantʉ akʉmʉtyata ʉ Yesʉi</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />Yesʉ palʉng’wɨ nɨamanyisigwa akwe akahega pang’wanso, akalongola kʉmpelo alʉzɨ nʉlʉkʉlʉ nʉla Galilaya, milʉndo waantʉ nɨapumɨɨe kʉ Galilaya nʉkʉ Yʉdea akamutyata. <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />Antʉ nɨanso aɨigulye makani ɨdʉ naɨ witʉmile ʉ Yesʉi, ɨhi akalongola kʉng’wa Yesʉ kʉpembela isalɨ nɨa Yelusalemu nʉkʉ Yʉdea nɨ Idumia, kilya a mongo nʉwa Yolodani, Tilo nɨ Sidoni. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />Yesʉ akaatambʉɨla amanyisigwa akwe amʉnoneelya ibɨnɨ lɨng’wɨ, kʉnsoko iumbɨ laantʉ aɨ ɨdʉ, aleke kʉmʉnyoma. <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />Aɨ ʉakomilye antʉ ɨdʉ, nawa ɨhi naɨalwae aɨamʉpilimɨɨye ahume kʉmʉtonya. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />Nɨantʉ naɨ ingɨwe nɨahɨng’wɨ naɨamʉine ʉdu ʉ Yesʉi, akigalagalya pantongela akwe nʉkitʉnta azelʉnga, “Ʉewe Wing’wana wang’wi Itunda!”<verse eid="MRK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12" />Ingɨ ʉ Yesʉi akaalagɨɨlya ɨahɨng’wɨ aleke kʉkumʉʉla kɨna nʉwanso nyenyu.<verse eid="MRK 3:12" /></para>
  <para style="s">Yesʉ ʉkʉhola itʉmi ikʉmi na abɨɨlɨ</para>
  <para style="r">
    <ref loc="MAT 10:1-4">Matayo 10:1-4</ref>; <ref loc="LUK 6:12-16">Lʉka 6:12-16</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />Yesʉ akanankɨla mʉlʉgʉlʉ akaitanga awo naɨʉasigɨɨe ng’wenso, nɨenso akamʉhanga, <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />nʉng’wenso akahola antʉ ikʉmi na abɨɨlɨ naɨʉatee itʉmi. Akaaɨla, “Nʉmʉhoile mikiɨ nʉnene, nɨze mʉtʉma kʉtanantya Nkani Nza, <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />mʉtule nʉʉhumi wakʉheja ahɨng’wɨ.”<verse eid="MRK 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16" />Ʉʉgwa, awa wawo ikʉmi na abɨɨlɨ naɨʉahoile. Simoni ʉyʉ Yesʉi nʉɨmitanga Petelo, <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />nʉ Yakobo nʉ Yohana, ana ang’wa Zebedayo, Yesʉ wɨitanga ɨilali awa nɨabɨɨlɨ lina la Boanelige, ɨndogoelyo akwe “Ana amʉgugumo,” <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />nʉ Andelea nʉ Pilipo nʉ Batilimayo nʉ Matayo nʉ Tomaso nʉ Yakobo ng’wana wang’wa Alupayo nʉ Tadayo nʉ Simoni nʉɨmɨkʉɨɨla ihɨ akwe <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />nʉ Yʉda mʉnya kʉ Isikaliote ʉyʉ naɨ ʉzɨɨza mʉsuɨpa ʉ Yesʉi.<verse eid="MRK 3:19" /></para>
  <para style="s">Yesʉ mʉkʉlʉ kʉkɨla ʉ Belizebuli</para>
  <para style="r">
    <ref loc="MAT 12:22-32">Matayo 12:22-32</ref>; <ref loc="LUK 11:14-23">Lʉka 11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />Sʉnga ʉ Yesʉi akatulya kitolakwe hangɨ, milʉndo waantʉ ʉkilʉnda, sʉnga Yesʉ nɨamanyisigwa akwe akaʉlya itungo nɨla kʉlya indya kʉnsoko akʉaɨɨlya ɨantʉ. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />Itɨgwa, anyandʉgʉ akwe naɨija impola nɨanso akalongola kʉmʉamba, kʉnsoko aɨalʉnga, “Kɨna wainaa monyele.”<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />Amanyisi ang’wɨ nɨa Malagilyo ang’wa Musa naɨapumile kʉ Yelusalemu aɨ akʉlʉnga, “Ʉtongilwe nʉ Belizebuli mʉkʉlʉ nʉwa ahɨng’wɨ yʉyo nʉkenda mʉpa ʉʉhumi nʉwa kʉzunsa ahɨng’wɨ kʉ antʉ.”<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />Kʉlʉlo ʉ Yesʉi akaitanga nʉkʉligitya nɨenso kʉmpyani, “Itɨɨ, Shetani ʉng’wenso ʉhumile ʉlɨ kizunsa? <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />Anga ʉtemi ʉtemanʉke nʉ kikʉa, ʉtemi nʉwanso shanga ʉkʉkʉla. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />Hangɨ anga itule antʉ ikoe lɨng’wɨ atemanʉke nʉkikʉa, ikoe nɨlanso lɨkʉlɨmansɨɨla. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />Kʉlʉlo ʉtemi wang’wa Shetani anga ʉtemanʉke, shanga ʉkʉkʉla, ingɨ ʉkʉlimansɨɨla nʉkʉpikɨɨla mpelo.<verse eid="MRK 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27" />“Kʉtilɨ anga mʉntʉ nʉhumile kingɨɨla ikoe la mʉnyangulu nʉ kʉmʉhegelya insao yakwe shanga waze ʉmʉtungile. Kwaala wamʉtunge hanza, papo gwa ʉhumile kʉmʉhegelya insao yakwe.<verse eid="MRK 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28" />“Kʉmʉɨla ɨtai, antʉ akʉlekelwa mɨlandʉ ao ɨhi nɨkɨmeli kao kɨhi, <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />ingɨ mʉntʉ wɨhi nʉkʉmʉbehʉla ʉ Ng’waʉ Ng’welʉ, kwee shanga ʉkʉlekelwa, witʉmile igazo la mʉlandʉ nʉwa kalɨ na kalɨ.” <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />Yesʉ aɨ ʉtambʉe itɨ kʉnsoko nɨanso aɨ akʉlʉnga, “Ʉtongilwe nʉhɨng’wɨ.”<verse eid="MRK 3:30" /></para>
  <para style="s">Aluna atai nɨang’wa Yesʉ</para>
  <para style="r">
    <ref loc="MAT 12:46-50">Matayo 12:46-50</ref>; <ref loc="LUK 8:19-21">Lʉka 8:19-21</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />Akɨza nyinya nɨalʉna ang’wa Yesʉ, akimɨkɨla kʉnzi a nyʉmba. Akalagɨɨlya mʉntʉ wingɨle itangɨligwe ʉ Yesʉi. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />Milʉndo nʉwa antʉ aɨ ikiɨ amʉpilimɨye ʉ Yesʉi, akamʉɨla, “Kolwa, ʉiya wako nɨaluna ako amolɨ kʉnzi, akʉitanga.”<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />Yesʉ akaasʉkɨɨlya, “Iyaane nɨ aluna ane anyenyu? <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />Papo gwa akaagoza iantʉ ɨhi naɨ ikiɨ amʉpilimɨye mpande yɨhi, akalʉnga, “Kolwi, awa wawa aiya ane nɨaluna ane! <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />Mʉntʉ wɨhi nʉkitʉma ʉlowa wang’wi Itunda, nʉwanso yʉyo heu wane nʉ ng’waitʉ nʉ iya wane.”<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">Mpyani amʉmyagi</para>
  <para style="r">
    <ref loc="MAT 13:1-9">Matayo 13:1-9</ref>; <ref loc="LUK 8:4-8">Lʉka 8:4-8</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />Yesʉ akandya kʉmanyisa ɨantʉ hangɨ pa mpelo alʉzɨ nʉla Galilaya. Milʉndo ʉkʉlʉ nʉwa antʉ ʉkamʉpilɨmɨɨlya nʉwanso akingɨla mibɨnɨ akikiɨ antʉ aleke kʉmʉnyoma. Antʉ ɨhi ɨkikiɨ kihɨ nɨ nyʉmʉ, pa mpelo alʉzɨ nʉlʉkʉlʉ. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />Aɨ ʉkʉamanyisa makani ɨdʉ kʉmpyani, mʉʉmanyisi wakwe akaaɨla,<verse eid="MRK 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 4:3" />“Tegelyi! Mʉmyagi ʉng’wɨ aɨwendile kʉmyaga. <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />Naɨ ʉkʉmyaga ɨmbeʉ, nɨɨng’wɨ yɨkagwɨla mʉnzɨla nyonyi yɨkahoeela nʉkʉilya. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />Mbeʉ ying’wɨ yɨkagwɨla mitalagwe mʉkʉtilɨ ihalʉ nɨlɨdʉ, ninyenso aɨikaiye kʉhelʉka kʉnsoko aɨituhɨɨwe iniino. <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />Mpasʉ naɨ akɨɨe mɨmea akwe ɨkanyala, yɨkalimansɨɨla, kʉnsoko ɨmɨli amɨmea shanga aɨɨhɨmbɨɨye iza. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />Mbeʉ ying’wɨ yɨkagwɨla mʉmɨtɨ namija, ɨmɨtɨ ɨkakʉla ɨkasopa ɨmɨmea shanga ɨkapa anga mbeʉ ɨhi. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />Mbeʉ ying’wɨ yɨkagwɨla mʉmboto, yɨkahelʉka yɨkakinda nʉkʉkʉla, yɨkapa. ing’wɨ makʉmi atatʉ, ninzʉya makʉmi mʉtandatʉ, ninzʉya igana.”<verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />Sʉnga Yesʉ akaaɨla, “Nʉkete ʉkʉtwɨ nʉije!”<verse eid="MRK 4:9" /></para>
  <para style="s">Nsoko akʉmanyisa kʉmpyani</para>
  <para style="r">
    <ref loc="MAT 13:10-17">Matayo 13:10-17</ref>; <ref loc="LUK 8:9-10">Lʉka 8:9-10</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />Ingɨ ʉ Yesʉi naɨwatula wing’wene du, antʉ ang’wɨ naɨamigulye palʉng’wɨ nɨamanyisigwa ao nikʉmi na abɨɨlɨ, akamʉhanga, akamʉkolya ndogoelyo ampyani nanso. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />Yesʉ akasʉkɨɨlya, “Itunda ʉmʉpee ʉnyenye kʉlɨnga ʉnkunku nʉwa ʉtemi wang’wi Itunda, ingɨ awo nɨakolɨ kʉnzi akʉtambʉɨlwa maintʉ ɨhi kʉmpyani, <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />ingɨ,</para>
  <para style="q1" vid="MRK 4:12">‘Awo nɨakʉgoza agoze,</para>
  <para style="q2" vid="MRK 4:12">aleng’we kʉona,</para>
  <para style="q1" vid="MRK 4:12">awo nɨakija, nɨije,</para>
  <para style="q2" vid="MRK 4:12">aleke kʉlɨnga.</para>
  <para style="q1" vid="MRK 4:12">Kunsoko anga alɨnge, akʉmʉsʉkɨla Itunda,</para>
  <para style="q2" vid="MRK 4:12">nʉyo ʉkʉalekela ɨmɨlandʉ ao.”’<verse eid="MRK 4:12" /></para>
  <para style="s">Yesʉ ʉkʉdʉndʉʉla ɨmpyani amʉmyagi</para>
  <para style="r">
    <ref loc="MAT 13:18-23">Matayo 13:18-23</ref>; <ref loc="LUK 8:11-15">Lʉka 8:11-15</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />Ʉʉgwa, ʉ Yesʉi akaakolya, “Itɨɨ, nʉnyenye shanga mʉlɨngile mpyani ɨyɨ, Mʉhumile ʉlɨ, kʉlɨnga mpyani niing’wɨ? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />Mʉmyagi ingɨ mʉtanantyi lʉkani lang’wi Itunda. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />Antʉ ang’wɨ ɨhanga ɨmbeʉ nigwɨɨe mʉnzɨla, anga ije ʉdʉ lʉkani lang’wi Itunda, Shetani wɨzaa nʉkʉlʉheja ʉlʉkani nʉlʉtemewe mʉng’waao. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />Antʉ ang’wɨ ɨhanga mbeʉ nɨgwɨɨe mitalagwe mihalʉ nisheehʉ. Anga ije ʉdʉ ʉlʉkani lang’wi Itunda ɨlʉsɨngɨɨlya kʉʉlowa. <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />Ingɨ ɨhanga ɨmɨli amɨmea, lʉkani lang’wi Itunda ɨlʉhʉɨɨla kitungo ikupɨ mʉnkolo yao. kʉlʉlo anga ligele lwago ang’wɨ wagigwi kʉnsoko alʉkani nʉlanso, itungo ʉdu ɨlʉleka ʉlʉkani. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />Antʉ ang’wɨ ingɨ ɨhanga mbeʉ izo naɨigwɨe mʉmɨtɨ amija. Nianso ingɨ impyani nɨantʉ awo anga ije ʉlʉkani nʉlanso, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />ingɨ mɨlɨmo amʉʉnkumbigʉlʉ nʉ ʉgoolya nʉwansao, nɨnsʉla amakani mangɨza anga yingɨɨle, yɨlʉsopa ʉlʉkani nʉlanso, shanga ɨlitʉmɨla anga mʉlɨmo. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />Antʉ ang’wɨ, ɨhangaa mbeʉ nɨyigwɨɨe mʉmboto, ɨlɨjaa ʉlʉkani lang’wi Itunda ɨlʉsɨngɨɨlya, nʉkʉlʉhʉɨɨla, nʉkʉtugisa. Anga mbeʉ niyipesa, niying’wɨ makʉmi ataatʉ, niying’wɨ makʉmi mʉtandatʉ hangɨ niying’wɨ igana.”<verse eid="MRK 4:20" /></para>
  <para style="s">Lʉmʉlɨ nʉlakɨe paʉpagɨko</para>
  <para style="r">
    <ref loc="LUK 8:16-18">Lʉka 8:16-18</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />Yesʉ akalongoleka kʉatambʉɨla, “Itɨɨ, antʉ akɨlya lʉmʉlɨ mʉnyʉmba nʉkʉlʉkʉnɨkɨla na shʉngʉ ang’wɨ kʉɨka mʉʉlungu? Shanga ʉʉ! Lʉmʉlɨ lɨɨkwa paʉpagɨko. <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />Itɨ ʉʉgwa, kɨhi nɨkɨpihilwe kɨkʉpihʉʉlwa, hangɨ nɨkɨ nɨkɨkʉnɨkɨwe kɨkʉkʉnʉkʉlwa. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />Ʉyʉ nʉkete ʉkʉtwɨ, nʉije.”<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />Yesʉ akaaɨla hangɨ, “Tegeelyi kɨsa ɨkɨ nɨkʉmʉɨla. Itɨ nʉipumilye kʉtegeelya ʉlʉkani, itɨ ʉʉ Itunda ʉkʉongeelya kʉlɨnga ʉlʉkani ikʉlʉ. <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />Mʉntʉ ʉyʉ nʉkʉtegeelya ʉlʉkani lang’wi Itunda nʉkʉlʉlɨnga, Itunda ʉkʉmʉaɨɨlya nʉkʉmʉtenda walʉlɨnge lʉkʉlʉ. Mʉntu nɨshanga ʉkʉtegeelya lʉkani lang’wi Itunda, nʉlʉkani nʉlʉniino nʉlʉlɨngile ʉkʉhegeligwa.”<verse eid="MRK 4:25" /></para>
  <para style="s">Mpyani a mbeʉ nɨkʉhelʉka</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />Yesʉ akalongoleka kʉtambʉla, “Ʉtemi wang’wi Itunda wimpyani itɨ. Mʉntʉ ʉng’wɨ aɨʉmyagile mbeʉ mʉmʉgʉnda. <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />Ʉtɨkʉ wɨlala nʉ ng’ʉng’wɨ ɨza ʉpɨtilye ʉʉ, ɨmbeʉ yɨkʉhelʉka nʉ kʉkinda nʉwanso shanga iza ʉlɨngɨle nɨkɨkʉtendeka. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />Ingɨ aɨ itɨ, kʉnsoko ihalʉ lyenso lɨhelʉkisa ɨmbeʉ nʉkʉkʉlya nʉkʉtula mimea nʉkʉpa ɨndya, landɨɨlya hanza kigela itina nidabʉ, wityata mʉmea nʉʉkindile, sʉnga ipemba nɨlɨpee inseke. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />Nseke nɨanso anga ikonde, mʉntʉ wandya kʉogola wazetema na zolo kʉnsoko maogola apika.<verse eid="MRK 4:29" /></para>
  <para style="s">Mpyani ambeʉ a haladali</para>
  <para style="r">
    <ref loc="MAT 13:31-32">Matayo 13:31-32</ref>,<ref loc="MAT 13:34">34</ref>; <ref loc="LUK 13:18-19">Lʉka 13:18-19</ref></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />Yesʉ aɨʉakoiye, “Ʉtemi wang’wi Itunda wimpyanigwe nɨ ntʉni? Kʉʉganʉle kʉmpyani kɨɨ? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />Ingɨ wimpyani nɨmbeʉ a haladali nɨɨza niino kʉkɨla mbeʉ yɨhi nia mʉnkʉmbɨgʉlʉ. <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />Ingɨ anga ɨtemelwe ɨhelʉka, nʉkʉtula mɨtɨ mɨkʉlʉ kʉkɨla mɨtɨ ɨhi na nyenyi, ntambɨ yakwe yikʉla, nɨnyʉnyɨ yɨtuma iuyɨ mʉmilʉlɨ akwe,”<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />Yesʉ aɨʉatanantɨɨye inkani yakwe kʉmpyani yɨdʉ anga niyanso, aɨʉligitilye nɨenso anga naɨ ahumile kʉmʉlɨnga nʉkʉkɨtambʉla. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />Shanga aɨʉligitilye nɨenso kɨntʉ kɨhi waze mʉgila mpyani, ingɨ nʉmolɨ nɨamanyisigwa akwe, akaakʉmʉɨla aya ɨhi.<verse eid="MRK 4:34" /></para>
  <para style="s">Yesʉ ʉkʉlagɨɨlya kɨntinkʉ kɨkilage</para>
  <para style="r">
    <ref loc="MAT 8:23-27">Matayo 8:23-27</ref>; <ref loc="LUK 8:22-25">Lʉka 8:22-25</ref></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />Lʉhikʉ nʉlanso, naɨyaina tula mpɨndɨ, Yesʉ akaatambʉɨla amanyisigwa akwe, “Kʉpute kitʉmbɨ la lʉzɨ.” <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />Ʉʉgwa, akaleka ʉmilʉndo waantʉ, akingɨla mibɨnɨ naɨʉmolɨ ʉ Yesʉi. Nɨ itɨga antʉ aʉya ɨkalongolania nɨenso azeamolɨ mʉ mabɨnɨ ao. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />Ʉʉgwa, kɨkigela kɨntinkʉ kɨkʉlʉ, maɨngʉ akalɨkʉa ibɨnɨ naɨʉmolɨ ʉ Yesʉi lɨkatula izʉla mazɨ. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />Yesʉ aɨʉmolɨ kʉnyuma ibɨnɨ, waze wilaɨɨye mʉkɨpalatʉ. Ʉʉgwa, amanyisigwa akwe akamʉʉsha nʉkʉmʉɨla, Mʉmanyisi, nɨkɨ shanga ʉkee kɨna kaakakapɨla mʉmazɨ?”<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />Yesʉ akaʉka, papo paapo akalagɨɨlya ɨkɨntinkʉ nɨkanso, “Kilaga! Ihɨtwɨɨ!” Kɨntinkʉ kɨkatɨga, maɨngʉ akatɨga. <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />Sʉnga ʉ Yesʉi akaaɨla amanyisigwa akwe, “Nɨkɨ mɨoa? Itɨɨ, mʉkɨlɨ mɨagila anga ʉhʉɨɨli?”<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />Amanyisigwa akwe akitumba ikʉlʉ, akatulikolya, “Ʉyʉ nyenyu gwa, kɨntinkʉ nʉ lʉzɨ yʉkʉmija!”<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">Yesʉ ʉkʉmʉkomya mʉntʉ nʉkete ahɨng’wɨ</para>
  <para style="r">
    <ref loc="MAT 8:28-34">Matayo 8:28-34</ref>; <ref loc="LUK 8:26-39">Lʉka 8:26-39</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />Yesʉ nɨamanyisigwa akwe ɨkapika kitʉmbɨ nɨla lʉzɨ nʉla Galilaya, kihɨɨ a Agelasi. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />Yesʉ naɨ ʉsimile ʉdu mibɨnɨ, akatankana nʉmʉntʉ nʉkete hɨng’wɨ ʉpumɨe mʉibɨɨla. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />Mʉntʉ nʉwanso aɨwishiɨ mʉibɨɨla aɨ kʉtilɨ anga mʉntʉ naɨ ʉhumile kʉmʉtunga mɨnyololo. <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />Nkʉa yɨdʉ aɨ wɨtungwa minyololo ni mpɨngu, ingɨ aɨ wɨdʉmʉla ɨmɨnyololo nʉkʉbunanga impɨngu niyanso, aɨ kʉtilɨ anga mʉntʉ nʉhumile kʉmʉamba. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />Ʉtikʉ nʉ ng’ʉng’wɨ aɨwishiɨ mʉibɨɨla nʉ mʉmalʉgʉlʉ, wazekʉta nʉkikwalambʉla kʉ magwe.<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />Naɨ ʉmʉine ʉ Yesʉi kakʉlɨ akamʉmankɨɨla, akatugama ntongela akwe, <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />akakʉta akalʉnga, “Ʉewe Yesʉ Ng’wana wang’wi Itunda nʉwa kigʉlʉ, nɨkɨ ʉkʉningɨɨla? Kʉinena kʉlina lang’wi Itunda leka kʉnaja!” <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />Aɨʉtambʉe itɨ kʉnsoko Yesʉ aɨʉmʉkenee, “Ʉewe hɨng’wɨ, mʉmʉntʉ ʉyʉ hega!”<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />Yesʉ akamʉkolya “Lina lako wɨnyenyu?”</para>
  <para style="p" vid="MRK 5:9">Hɨng’wɨ akasʉkɨɨlya, “Lina lane Anyambita, kʉnsoko ʉsese kɨdʉ.” <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />Sʉnga ahɨng’wi nɨanso akaminena ʉ Yesʉi waleke kʉazunsa apume mihɨɨ nanso.<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />Pakupɨ nɨpang’wanso aɨlɨkolɨ idale ikʉlʉ nɨla ngulima lɨkʉdima. <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />Ʉʉgwa, ahɨng’wɨ nɨanso akaminena ʉ Yesʉi, “Kʉgombye kingɨle mʉngulima izo.” <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />Yesʉ akaagombya. Ʉʉgwa, ahɨng’wɨ nɨanso akapuma, akingɨla mʉngulima nɨanso. Idale lɨhi nɨla ngulima lɨkahulumʉkɨla migɨɨlɨ nʉ kʉkapɨla mʉlʉzɨ nʉkʉsha, aɨ anga ngulima magana amagana abɨɨlɨ.<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />Ɨmɨɨli idale nɨla ngulima akamanka, akatanantya ikani nɨlanso mʉisalɨ niikʉlʉ nʉmʉɨsalɨ ni iniino. Antʉ ɨkaza kiloeela naɨ atendekile. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />Naɨ apika kʉng’wa Yesʉ, akamʉona nʉyʉ naɨʉkete ʉhɨng’wɨ, wikiɨ pihɨ, ʉtugae matugalo aze ʉkete mahala akwe, akogopa. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />Antʉ naɨ iloee ikani nɨlanso akaaganʉɨla nɨaʉya makani naɨ ʉtendewe mʉntʉ ʉyʉ naɨ ʉkete ahɨng’wɨ ninkani yidale nɨla ngulima. <verse eid="MRK 5:16" /><verse number="17" style="v" sid="MRK 5:17" />Ʉʉgwa, antʉ akatulaminena ʉ Yesʉi wahege mihɨɨ ao.<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />Yesʉ naɨ ʉkʉnankɨla mibɨnɨ, mʉntʉ ʉyo naɨ ʉhegeigwe ahɨng’wɨ akaminena akamʉɨla “Ngombye kʉkʉile nʉewe!”<verse eid="MRK 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 5:19" />Ingɨ ʉ Yesʉi akamʉhitɨlya, akamʉɨla, “Longola kʉ antʉ ako wende ʉatambʉɨle anyandʉgʉ ako makani nɨmakʉlʉ Isekʉlʉ nʉkʉgunile, nʉkʉʉonela ɨkɨnyaʉwai.”<verse eid="MRK 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 5:20" />Kʉlʉlo, mʉntʉ nʉwanso akalongola, akandya kʉtanantya mʉ Dekapoli ndogoelyo akwe isalɨ ikumi, Yesʉ naɨ ʉmʉponyile, antʉ ɨhi akakʉɨlwa.<verse eid="MRK 5:20" /></para>
  <para style="s">Mʉnanso wang’wa Yailo ʉkiʉkigwa nʉ mʉsʉngʉ ʉng’wɨ ʉkʉkomigwa</para>
  <para style="r">
    <ref loc="MAT 9:18-26">Matayo 9:18-26</ref>; <ref loc="LUK 8:40-56">Lʉka 8:40-56</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />Yesʉ naɨ watambʉka kʉtulya itʉmbɨ lakabɨɨlɨ nɨla lʉzɨ. Milʉndo waantʉ ɨdʉ akamʉpilima nʉwanso waze ʉmolɨ kʉmpelo alʉzɨ nʉlʉkʉlʉ. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />Akapika mʉntʉ ʉng’wɨ mʉtongeli wa nyʉmba akʉtankanɨla Ayahudi, witangwaa Yailo, naɨ ʉmʉine ʉ Yesʉi, akigʉma pamɨgʉlʉ akwe, <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />akaminena, akalʉnga, “Mʉnanso wane mʉlwae ʉkʉhima nsha. Itʉnʉ kʉlompa nzʉ ʉmʉtonye wahume kʉkomya nʉ kʉpangataala.” <verse eid="MRK 5:23" /><verse number="24" style="v" sid="MRK 5:24" />Ʉʉgwa ʉ Yesʉi akalongolania nʉng’wenso. Antʉ ɨdʉ akamʉtyata, antʉ akamʉpingapinga.<verse eid="MRK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25" />Mʉng’wao aɨʉkolɨ mʉsʉngʉ ʉng’wɨ naɨwɨpuma sakami akɨsʉngʉ kʉ myaka ikʉmi na ɨbɨɨlɨ, <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />mʉsʉngʉ nʉwanso aɨwagile, kʉgenda kʉakilɨki ɨdʉ. Aɨwamaile nsao yakwe yɨhi kikilɨkɨla, ingɨ ndwala ɨkalongoleka kʉtula mbɨ. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />Naɨ wigulye impola yang’wa Yesʉ, ʉʉgwa akakunkuma mʉantʉ, akagutya itugalo lang’wa Yesʉ kʉnyuma. <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />Aɨ witumile itɨ, kʉnsoko aɨ usɨgɨɨe mʉnkolo, “Anga ngutye itugalo lakwe, kʉkomya.”<verse eid="MRK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29" />Ʉʉgwa naɨʉgutilye itugalo lang’wa Yesʉ ɨsakami ɨkapela kʉpuma, akamanya kɨna wakomyaa ʉlwae wakwe. <verse eid="MRK 5:29" /><verse number="30" style="v" sid="MRK 5:30" />Yesʉ akalɨnga kɨna ngulu yakwe niaʉponyi yitʉmaa mʉlɨmo. Akapɨlʉkɨla milʉndo nua antʉ, akakolya, “Itɨɨ, nyenyu ʉngutilye itugalo lane?”<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />Amanyisigwa akwe akamʉsʉkɨɨlya, “Ʉine antʉ akʉʉpinga pinga, ʉkʉlɨnga nyenyu nʉkʉgutilye?”<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />Ingɨ ʉ Yesʉi akalaa lala mpande yɨhi wahume kʉmʉona ʉyo nʉmʉgutilye. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />Papo gwa mʉsʉngʉ nʉwanso aɨʉlɨngɨle ayo nʉtendewe, akapumɨla akaze wogopile, akaza akagwɨla mʉmɨgʉlʉ ang’wa Yesʉ nʉkʉtambʉla ɨtai ntɨlɨ. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />Yesʉ akamʉɨla, “Ng’waane, wagunwaa nʉ ʉhʉɨɨli wako kʉng’waane. Longola kʉʉlowa, lwago lako lahila lʉkʉlʉ.”<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />Yesʉ aɨwakɨlɨ ʉkʉligitya, antʉ akaza kʉpuma kito la mʉtongeeli wanyʉmba akʉtankanɨla ɨa Yahudi, akamʉɨla, “Mʉnanso wako wakʉza. Nɨkɨ ʉlongoleke kʉmʉnyoma ʉ Mʉmanyisi?”<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />Ingɨ ʉ Yesʉi, naɨwigule ʉlʉkani nʉlanso naɨ lʉkʉtambʉlwa, akamʉɨla ʉ Yailo, “Leka kogopa, hʉɨɨla ʉdu.” <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />Yesʉ akaahitɨlya antʉ angɨɨza ityate nʉng’wenso, Petelo nʉ Yohana nʉ Yohana mʉlʉna ang’wa Yakobo wawo du naɨ ʉagombilye kityata. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />Akapika kito lang’wa Yailo Yesʉ akija iogo, nyangi nʉ ʉhongeelya. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />Akingɨla mʉnyʉmba, akaaɨla, “Nɨkɨ mʉzogooye mʉkʉlɨla nʉkʉhongeelya? Mʉnanso ʉyʉ shanga ʉkʉle, ʉlae ʉdʉ!”<verse eid="MRK 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40" />Nɨanso ingɨ akamʉheka. Ʉʉgwa, akaapumya ɨhi kʉnzi, akaahola ihe nʉ nyinya nɨa mʉnanso nʉwanso nɨ amanyisigwa akwe awo nɨataatʉ, akingɨlania nkɨka kaɨ alalɨkilye mʉimba nʉwa mʉnanso. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />Ʉʉgwa akamʉamba mʉkono, akamʉɨla, “Talita, kumi,” ndogoelyo akwe, “Kʉʉɨla, mʉnanso ʉka!”<verse eid="MRK 5:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42" />Pumpulugu mʉnanso akimɨka, akandya kʉgenda. Mʉnanso ʉyʉ aɨʉkete ilika lamyaka ikʉmi na ɨbɨɨlɨ. Papo aleli nɨamanyisigwa naɨingɨe akakʉɨlwa ikʉlʉ. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />Yesʉ akaagilya lʉkʉlʉ aleke kʉmʉɨla mʉntʉ ikani nɨlanso. Sʉnga akaaɨla ɨaleli amʉpe ʉmʉnanso nʉwanso indya walye.<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">Antʉ akʉ Nazaleti akʉmʉhita u Yesʉ</para>
  <para style="r">
    <ref loc="MAT 13:53-58">Matayo 13:53-58</ref>; <ref loc="LUK 4:16-30">Lʉka 4:16-30</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />Yesʉ akahega pang’wanso akatulya kʉ Nazaleti kɨsalɨ naɨ ʉkʉɨe, aɨakʉɨɨe nɨamanyisigwa akwe. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />Lʉhikʉ nʉla kʉsupya naɨlapika, akandya kʉmanyisa mʉnyʉmba a kʉtankanɨlya Ayahudi. Antʉ ɨdʉ naɨamigulye akakʉɨlwa, akikolya, “Itɨɨ, ʉpumɨɨye pɨ ʉmanyisi ʉwʉ? Mahala kɨ aya nʉkete? Hangɨ, ʉkitʉma ʉlɨ ɨmapɨlʉ aya? <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />Itɨɨ, ʉyʉ shanga anga mʉsesa mɨtɨ ng’wana wang’wa Malia, nɨaluna akwe a Yakobo nʉ Yosepu nʉ Yʉda nʉ Simoni? Itɨɨ, aluna akwe nɨakɨsʉngʉ shanga kikalanɨa papane?” Itɨ gwa, akamʉbɨpɨlwa, akahɨta kʉmʉhʉɨɨla.<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />Yesʉ akaatambʉɨla, “Mʉmanga wang’wi Itunda wɨkuligwa nɨantʉ amahɨɨ mangɨɨza, ingɨ shanga wɨkʉligwa nɨantʉ amihɨɨ akwe nʉ mʉanyandʉgʉ akwe nʉ mitolakwe.”<verse eid="MRK 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 6:5" />Shanga akitʉma mampɨlʉ pang’wanso, kʉitɨ akalompeela alwae akeehʉ akaakomya. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />Yesʉ akakʉɨlwa nangalʉ kʉnsoko shanga aɨ amʉhʉɨɨe.</para>
  <para style="s" vid="MRK 6:6">Yesʉ ʉkʉalagɨɨlya amanyisigwa ikʉmi na abɨɨlɨ</para>
  <para style="r" vid="MRK 6:6">
    <ref loc="MAT 10:5-15">Matayo 10:5-15</ref>; <ref loc="LUK 9:1-6">Lʉka 9:1-6</ref></para>
  <para style="p" vid="MRK 6:6">Yesʉ aɨ wɨigendeela isalɨ niya pakupɨ nɨpang’wanso wazeamanyisa ɨantʉ. <verse eid="MRK 6:6" /><verse number="7" style="v" sid="MRK 6:7" />Aɨ ʉitangile amanyisigwa ao nɨkʉmi naabɨɨlɨ. Akaapa ʉhumi nʉwakʉheja ahɨng’wɨ, akandya kʉalagɨɨlya abɨɨlɨ abɨɨlɨ, <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />akaalagɨɨlya, “Kʉmʉlongoe mʉhole mʉlanga nʉwa kikimagɨɨlya du. Mʉleke kʉhola ɨmpamba ang’wɨ nkapu ang’wɨ mpia mʉ mbogoshi. <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />Tugali makwasa ingɨ mʉleke kʉhola matugalo akʉkaɨla.” <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />Hangɨ akaatambʉɨla, “Ikoe lɨhi nɨmʉkʉsɨngɨɨligwa, mishiɨ mʉmo kʉpikɨɨla nɨmʉkʉhega mʉkɨsalɨ nɨkanso. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />Kɨsalɨ kɨhi antʉ nɨakʉhita kʉmʉsɨngɨɨlya ang’wɨ kʉmʉtegelya, hegi pang’wanso nʉkipyagʉla ʉlʉnkʉndɨ mʉmɨgʉlʉ anyu itule kɨlɨngasɨɨlyo kɨna Itunda waahita nɨenso.”<verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />Ʉʉgwa, amanyisigwa akalongola akaatanantɨlya ɨantʉ amʉsʉkɨle Itunda nʉ kʉleka mɨlandʉ.<verse eid="MRK 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 6:13" />Aɨ akenda ahegilye antʉ ɨdʉ ahɨng’wɨ, akaapaka makʉta alwae ɨdʉ, nʉkʉakomya.<verse eid="MRK 6:13" /></para>
  <para style="s">Kʉsha kʉng’wa Yohana Mʉbadisi</para>
  <para style="r">
    <ref loc="MAT 14:1-12">Matayo 14:1-12</ref>; <ref loc="LUK 9:7-9">Lʉka 9:7-9</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />Ingɨ, mʉtemi Helode aɨwigulye ɨhi nanso, kʉnsoko ʉ Yesʉi aɨwakʉmʉka mpande yɨhi. Antʉ ang’wɨ akatula lʉnga, “Yohana Mʉbadisi wiʉka, ʉkitʉma mɨʉkʉɨlwa kʉnsoko aɨ mʉmanga wang’wi Itunda.”<verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />Nɨang’wɨ aɨakʉlʉnga, “Mʉntʉ ʉyʉ, ingɨ mumanga Elia wiʉka.”</para>
  <para style="p" vid="MRK 6:15">Nɨang’wɨ akalʉnga, “Ʉyʉ mʉmanga wang’wi Itunda ʉng’wɨao mʉamanga ang’wi Itunda nɨakalɨ.”<verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />Ingɨ ʉ Helode naɨwija impola izi akalʉnga, “Ʉyʉ ingɨ Yohana Mʉbadisi! Naɨ nʉmʉdʉmʉe itwe, waiʉka.” <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" />Helode aɨʉtambʉe itɨ kʉnsoko aɨʉlagɨɨye kɨna Yohana Mʉbadisi waambwe watugwe mʉkadulumu. Aɨwitʉmile itɨ kʉnsoko aɨ wamʉtɨna Helodia naɨ mʉsʉngʉ wang’wa Pilipo heu wakwe. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />Helode aiʉmʉtendee itɨ ʉ Yohana Mʉbadisi kʉsoko aɨʉmʉɨe, “Shanga inonee ʉewe kʉmʉtina ʉmʉsʉngʉ wang’wa heu wako.”<verse eid="MRK 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19" />Itɨ gwa ʉ Helodia aɨ ʉmʉbɨpɨwe nangalu ʉ Yohana, akalomeela kʉmʉbʉlaga, akaleng’wa, <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />kʉnsoko Helode aɨwɨmʉsʉnja. Helode aɨʉmogopile ʉ Yohana, kʉnsoko aɨʉlɨngɨle kɨna mʉntʉ nʉgombekile kʉng’wi Itunda, aɨwɨlowaa kʉmʉtegeelya, nɨitɨ ga naɨ wamʉtegeelya akahʉsha nangalu.<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />Naɨapika matungo akʉkɨmbʉkɨɨlya kʉtugwa ʉ Helode. Helode akanoneelelya iloeelya ɨanyampala ianza lakwe, nɨamankata nɨ atongeli nɨakʉ Galilaya. Papo gwa ʉ Helodia akalija lyoma naɨwɨlomeela kʉmʉbʉlaga ʉ Yohana. <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />Ʉʉgwa, mʉnanso wang’wa Helodia akingɨla miloeelya, akaina, akamʉloeelya nangalu ʉ Helode nɨazɨɨla akwe. Mʉtemi Helode akamʉɨla ʉmʉnanso nʉwanso, “Nompe kɨntʉ kɨhi nʉtakile, nʉnene kʉʉpa” <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />Akamʉlapɨla hangɨ, “Kɨntʉ kɨhi nʉkʉnompa, kʉʉpa, itule nusu a ʉtemi wane, kʉʉpa.”<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />Papo gwa, ʉmʉnanso nʉwanso akapuma, akamʉkolya ʉnyinya, “Nompe ntʉni?”</para>
  <para style="p" vid="MRK 6:24">Nyinya akamʉsʉkɨɨlya,</para>
  <para style="p" vid="MRK 6:24">“Lompa itwe lang’wa Yohana Mʉbadisi.”<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />Mʉnanso akatulya intambo kʉ Mʉtemi, akamʉlompa, “Ndoilwe ʉmpe ino ino itwe lang’wa Yohana mʉbadisi mʉntua.”<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />Mʉtemi akahʉsha nangalu, akaleng’wa kʉmʉhitɨlya, kʉnsoko ilapo lakwe, nɨ aazɨɨla akwe nɨamolɨ miloeelya. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />Ʉʉgwa ʉ Mʉtemi akamʉlagɨɨlya ʉmʉmboi walete itwe lang’wa Yohana. Mʉmboi akalongola mʉkadulumu akamʉdʉmʉla Yohana itwe, <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />akaɨkɨla itwe nɨlanso mʉntua, akaleta, akamʉpa ʉmʉnanso, nʉyo ʉmʉnanso akamʉpa ʉnyinya. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />Amanyisigwa ang’wa Yohana naɨ igule itɨ, akalongola akaʉhola ʉmʉimba wang’wa Yohana akaʉɨka.<verse eid="MRK 6:29" /></para>
  <para style="s">Yesʉ ʉkʉapa ndya antʉ magana amaga ataano</para>
  <para style="r">
    <ref loc="MAT 14:13-21">Matayo 14:13-21</ref>; <ref loc="LUK 9:10-17">Lʉka 9:10-17</ref>; <ref loc="JHN 6:1-14">Yohana 6:1-14</ref></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />Amanyisigwa awo naɨalagɨigwe akatʉlya, akilinga ntongela ang’wa Yesʉ, akamʉɨla ɨhi nɨamanyisilye nʉkitʉma. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />Yesʉ akaaɨla ɨamanyisigwa akwe, “Kwɨndi ʉnyenye ʉdu ipande nigila anga antʉ mʉsʉpye iniino.” Aɨʉtambʉe itɨ kʉnsoko pang’wanso aɨ akolɨ antʉ ɨdʉ naɨ akingɨla nʉkʉpuma, Yesʉ nɨamanyisigwa akaʉlya ɨlyoma la kʉlya kʉnsoko akʉaaɨɨlya. <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />Itɨgwa, akanankɨla mibɨnɨ, akalongola ipande ningila antʉ.<verse eid="MRK 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33" />Ingɨ antʉ ɨdʉ aɨ aine alongoe, akalɨnga kʉalomile. Antʉ ɨdʉ akapuma mʉisalɨ yɨhi, akamankɨɨla ʉko naɨʉlomile ʉ Yesʉi nɨamanyisigwa akwe, akaatongeela kʉpika. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />Yesʉ naɨ ʉsimile mibɨnɨ, akaona antʉ ɨdʉ ilʉndile, akaaisɨɨlya, kʉnsoko aɨ ɨhanga nkolo ningɨla mʉdɨmi. Akandya kʉamanyisa nkani yɨdʉ. Akatula amanyisa <verse eid="MRK 6:34" /><verse number="35" style="v" sid="MRK 6:35" />Matungo ampɨndɨ naɨapika, amanyisigwa akamʉhanga ʉ Yesʉi, akamʉɨla, “Mʉnʉ ingɨ wɨɨ, nilyoa laina haɨɨla. <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />Bahu ʉalage iantʉ alongole mʉisalɨ niikʉlʉ niisalɨ niinino nɨya pakʉpɨ, ende agʉle indya.” <verse eid="MRK 6:36" /><verse number="37" style="v" sid="MRK 6:37" />Yesʉ akaaɨla, “Api nyenye indya.” Nɨenso akamʉkolya, “Itɨɨ, kende kʉagʉɨlye mɨkate nɨkete nsaɨlo dinali magana abɨɨlɨ, shanga akenela?”<note caller="+" style="f"><char style="fr" closed="false">6:37 </char><char style="ft" closed="false">dinali magana abɨɨli ihanga kɨnyamʉlɨmo ka myeli mʉnana kʉ matungo nanso</char></note> <verse eid="MRK 6:37" /><verse number="38" style="v" sid="MRK 6:38" />Yesʉ akaakolya, “Mʉkete mɨkate ɨnga? Endi mʉgoze.” Naɨagoza, akamʉɨla, “Ɨkolɨ mɨkate ɨtaano ninsamaki ɨbɨɨlɨ.”<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />Ʉʉgwa ʉ Yesʉi akaalagɨɨlya amanyisigwa akwe aɨli ɨantʉ ikiɨ maʉmbɨ mʉmapwa nɨmadabʉ. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />Antʉ nɨenso ɨkikiɨ maʉmbɨ aantʉ igana, nɨmaʉmbɨ maʉlya antʉ makʉmi ataano. <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />Sʉnga ʉ Yesʉi akahola mɨkate nanso nɨtaano ni nsamaki niibɨɨlɨ, akalangamɨla kilunde, akakembeta, akaeganɨa mɨkate, akaapa amanyisigwa akwe aomolanie ɨantʉ. Ni nsamaki niibɨɨlɨ akaomolania antu. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />Antʉ ɨhi akalya nʉ kikʉta. <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />Amanyisingwa akwe akahoela lʉsago nʉla mɨkate ni nsamaki, yɨkizʉla itoto ikʉmi na ibɨɨlɨ. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />Antʉ naɨ alɨe ɨmɨkate nanso aɨ itʉnja du aɨ anga magana anzogu ataano.<verse eid="MRK 6:44" /></para>
  <para style="s">Yesʉ ʉkʉgenda migʉlya amazi</para>
  <para style="r">
    <ref loc="MAT 14:22-23">Matayo 14:22-23</ref>; <ref loc="JHN 6:15-21">Yohana 6:15-21</ref></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />Itungo lɨlo lɨɨlo ʉ Yesʉi akaalagɨɨlya amanyisigwa akwe anankɨlange mibɨnɨ, apute itumbi lakabɨɨli nɨla lʉzɨ apike kʉ Betisaɨda, nʉwanso aɨ ʉkʉlaga milʉndo nʉwa antʉ. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />Yesʉ naɨ wakondya kʉalaga ɨantʉ, akalongola kʉlʉgʉlʉ kʉlompa. <verse eid="MRK 6:46" /><verse number="47" style="v" sid="MRK 6:47" />Naɨ yatula ʉtikʉ, ibɨnɨ aɨ lɨmolɨ pakatɨ alʉzɨ nʉlʉkʉlʉ, Yesʉ aɨ ʉkolɨ wing’wene kitʉmbɨ. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />Yesʉ akaaona amanyisigwa akwe akaga kʉlongolya ibɨnɨ, kʉnsoko aɨ akʉkɨngɨlwa nʉ ʉng’wega. Ʉtikʉ wigɨngʉ, Yesʉ akalongola kʉ amanyisigwa wazegenda migʉlya amazɨ, akahiya kʉakɨla. <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />Naɨ amʉona ʉkʉgenda migʉlya amazɨ, akasɨganɨɨlya kɨna mʉtumbʉka, akakʉta! <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />Nsoko ɨhi aɨamʉine aɨogopile ikʉlʉ.</para>
  <para style="p" vid="MRK 6:50">Sʉnga ʉ Yesʉi akaaɨla, “Kilaji, ingɨ nene. Leki kogopi” <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />Sʉnga akanankɨla mibɨnɨ naɨ akolɨ, ʉng’wega ʉkakilaja. Nɨenso akakʉɨlwa. <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />Kʉnsoko aɨ akɨlɨ kʉlɨnga ɨndogoelyo amɨʉkʉɨlwa amɨkate. Nkolo yao aɨ nkaku kʉhʉɨɨla.<verse eid="MRK 6:52" /></para>
  <para style="s">Yesʉ ʉkʉakomya alwae kʉ Genesaleti</para>
  <para style="r">
    <ref loc="MAT 14:34-36">Matayo 14:34-36</ref></para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />Naɨ aputile ʉlʉzɨ nʉlʉkʉlʉ akapika kihɨɨ akʉ Genesaleti, akimɨsha ibɨnɨ mʉmpelo a lʉzɨ. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />Naɨasima mibɨnɨ itungo ʉdu antʉ akamʉlɨnga ʉ Yesʉi. <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />Ʉʉgwa, antʉ akalongola kʉpilima ihɨɨ nanso ihɨ, azeahola ɨalwae ao mʉmɨango akaatwala ʉko naɨ igulye kɨna ʉ Yesʉi ʉkolɨ. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />Nkɨka yɨhi ʉ Yesʉi naɨwendile, mʉisalɨ niikʉlʉ ang’wɨ isalɨ ni iniino ang’wɨ gapɨhi, antʉ aɨ aaɨkile ɨalwae mʉʉgalagalo, akaminena ʉ Yesʉi kɨna ɨalwae agutye ʉdu ʉkunzɨlo nʉwa matugalo akwe. Nɨenso ɨhi naɨ amʉgutilye akakomya.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">Ʉmanyigwi naɨ alekeeigwe nɨa Anyampala</para>
  <para style="r">
    <ref loc="MRK 15:1-9">Maliko 15:1-9</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />Lʉhikʉ lʉng’wɨ Apalisayo nɨ Amanyisi amalagɨɨlyo aɨapumile kʉ Yelusalemu ɨkilʉnda pantongeela ang’wa Yesʉ. <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" /><note caller="+" style="f"><char style="fr" closed="false">7:2 </char></note>Aɨaine amanyisigwa ang’wɨ nɨang’wa Yesʉ nɨakalya shanga ɨkalala iza ɨmikono kʉheja ɨmiko anga nɨalekeigwe mʉntendo nianyampala.<verse eid="MRK 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3" />Kʉnsoko Apalisayo anga nɨyɨlɨ Ayahudi nɨangɨɨza akomanɨɨye ʉmanyisigwa nʉwa anyampala ao. Shanga ɨlyaa kɨntʉ kɨhi nɨ shanga akalae mɨkono iza kʉpika mʉinkokola kʉheja ɨmiko anga niilagɨɨgwe. <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />Hangɨ, shanga ɨlyaa kɨntʉ kɨhi nɨkɨpumɨɨe kigalagalo, kʉpikɨɨla ielye hanza. Ɨkolɨ hangɨ ntendo ninzʉya naɨ amanyisigwe kʉpuma ɨkalɨ, anga koja nkulu niyʉngʉ niiseme niya kʉlɨla.<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />Itɨ gwa, Apalisayo nɨ Amanyisi amalagɨɨlyo akamʉkolya ʉ Yesʉi, “Nɨkɨ amanyisigwa ako shanga akitʉma aya naɨ kʉmanyisigwe nɨanyampala itʉ, ingɨ ɨlyaa indya shanga akalae mɨkono kʉheja ɨmiko anga ntendo nɨyɨlɨ?<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />Yesʉ akaasʉkɨɨlya, “Ʉnyenye mɨateele! Mʉnya kɨdagu wang’wi Itunda Isaya aɨʉpumilye mʉloto kʉng’wanyu naɨ ʉandɨkile. ‘Itunda aɨ ʉlʉngile.</para>
  <para style="q1" vid="MRK 7:6">Antʉ awa ɨnitetemba kʉnkani ʉdu,</para>
  <para style="q2" vid="MRK 7:6">ingɨ mʉnkolo yao shanga anihʉɨɨe ʉnene.<verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />Akʉnkʉlya ʉnene nakanda,</para>
  <para style="q2" vid="MRK 7:7">kʉnsoko ɨnkani nɨakʉmanyisa akɨʉntʉ ʉdu azelunga apembeeye kʉng’wi Itunda.’<verse eid="MRK 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8" />Ʉnyenye mʉlekile ilagɨɨlyo lang’wi Itunda nʉkʉtyata ntendo yaantʉ.”<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />Yesʉ akalongoleka kʉtambʉla, ʉnyenye mʉkinega ilagɨɨlyo lang’wi Itunda, kʉnsoko mʉtyatile ntendo yanyu! <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />Musa aɨ ʉlʉngile. ‘Akʉlye ʉtatako nʉ iyaako,’ hangɨ, ‘Nʉʉkʉmʉtʉkɨla ihe ang’wi nyinya nʉwabʉlagwe.’ <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />Ʉnyenye ingɨ mʉkʉmanyisa, ‘Mʉntʉ nʉʉkete kɨntʉ nɨkakʉmʉaɨɨlya ihe ang’wi nyinya, anga walompwe ingɨ wamʉkongele kɨna ɨkɨ ka ‘Kolibani’ ndogoelyo akwe ɨkɨ nɨkɨpumilye kʉnsoko ang’wi Itunda, <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />kʉlʉlo mʉkʉagilya antʉ aleke kʉaaɨɨlya ɨihe ang’wɨ anyinya.’ <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />Kʉtenda itɨ mʉdalahile ʉlʉkani lang’wi Itunda kʉnsoko antendo yanyu nimʉkilekeelya. Hangɨ mʉkitʉma makani ɨdʉ nihanga nanso.”<verse eid="MRK 7:13" /></para>
  <para style="s">Makani nakʉmʉsasha ʉmʉntʉ waleke kugombeka kʉng’wi Itunda</para>
  <para style="r">
    <ref loc="MRK 15:10-20">Maliko 15:10-20</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />Yesʉ akalitanga hangɨ ilʉndo la antʉ, akaatambʉɨla, “Ntegeeli mɨhi, mʉnɨnge. <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />Kʉtilɨ anga kɨntʉ nɨkɨkolɨ kʉnzi a mʉntʉ nɨkɨhumile kʉmʉsasha mʉntʉ waleke kugombeka kʉng’wi Itunda. Ingɨ kɨntʉ nɨkɨkolɨ mʉkatɨ akwe anga kɨmʉpume kɨko kʉmʉsasha mʉntʉ waleke kugombeka kʉng’wi Itunda.” <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />Mʉntʉ nʉkete akʉtwɨ nʉije!<note caller="+" style="f"><char style="fr" closed="false">7:16 </char><char style="ft" closed="false">Bibilia ying’wi nia kalɨ ngila ʉlʉkɨɨlɨ ʉlʉ</char></note><verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />Yesʉ naɨwahega pamilʉndo waantʉ nʉkingɨla mʉnyʉmba, amanyisigwa akwe akamʉkolya ndogoelyo ihumo nɨlanso. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />Yesʉ akaatambʉɨla, “Itɨɨ, nʉnyenyega shanga mʉlɨngɨlene, kɨna kʉtilɨ kɨntʉ nɨkɨkolɨ kʉnzi amʉntʉ nɨkɨhumile kʉmʉsasha mʉntʉ waleke kugombeka kʉng’wi Itunda, <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />kʉnsoko shanga kinzʉ mʉnkolo ingɨ mʉnda, sʉnga kɨpuma nʉkʉtula kɨnyalʉgʉlʉ.” Kʉntambʉ nanso nang’wa Yesʉ aɨ ʉigombilye ndya yɨhi.<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />Akalongoleka kʉtambʉla, “Nɨkɨkʉmʉpuma mʉntʉ kɨko nɨkɨhumile kʉmʉsasha mʉntʉ waleke kʉgombeka kʉng’wi Itunda. <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />Kʉtambʉla itɨ kʉnsoko mʉnkolo amʉntʉ, ɨpuma masɨgo nɨmabɨ nʉ ʉgoolya nʉwii nʉ ʉbʉlagi, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />ʉgoolya nɨ nkolo nɨmbi nʉ ʉbɨ nʉ ʉkongelani nʉ wii nʉwa nsao yɨdʉ niyantʉ nʉ wɨlu nʉ wibehʉli nikʉo nʉ lʉgoha nʉ ʉpʉngʉ. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />Ʉbɨ nʉwanso wɨhi wɨpuma mʉmʉntʉ, nʉwo wɨmʉsasha mʉntʉ waleke kʉgombeka kʉng’wi Itunda.”<verse eid="MRK 7:23" /></para>
  <para style="s">Ʉhʉɨɨli nʉwa mʉsʉngʉ nɨ shanga Mʉyahudi</para>
  <para style="r">
    <ref loc="MRK 15:21-28">Maliko 15:21-28</ref></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />Yesʉ akahega pang’wanso, akenda kʉkɨsalɨ ka Tilo. Kung’wanso akingɨla mʉnyʉmba ɨng’wɨ, shanga aɨʉloilwe mʉntʉ wɨhi walɨnge, ingɨ akaleng’wa kipiha. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />Pang’wanso aɨʉkolɨ mʉsʉngʉ ʉng’wɨ mʉnanso wakwe naɨʉkete hɨng’wɨ, naɨwigulyee kɨna ʉ Yesʉi ʉkolɨ pang’wanso akaza akatugama pantongela ang’wa Yesʉ. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />Akamʉlompa ʉ Yesʉi wamʉhegelye ʉ mʉmʉnanso wakwe hɨng’wɨ. Mʉsʉngʉ nʉwanso ingɨ shanga aɨ Mʉyahudi, aɨ mʉnya kʉ Silopoinike mʉ kɨsalɨ ka Silia. <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />Yesʉ akamʉɨla, “Leka ɨana ikʉte hanza, shanga ɨza kʉhola indya ya ana ʉigʉmɨle imbwa.”<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />Ingɨ mʉsʉngʉ nʉwanso akalʉnga, “Isekʉlʉ, nʉtambʉe ingɨ tai ga nimbwa yɨhoela maminyangʉlwa andya nɨalagaaye ɨana.”<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />Yesʉ akamʉɨla, kʉnsoko watambʉla iza, longola kitolako, hɨng’wɨ kondyaa kʉmʉpuma ʉmʉnanso wako!”<verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />Ʉʉgwa, akalongola kitolakwe, akamʉhanga ʉng’wana wakomya, ʉsupilye mʉʉlɨlɨ.<verse eid="MRK 7:30" /></para>
  <para style="s">Yesʉ ʉkʉmʉkomya kɨmumɨ hangɨ gulu</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />Sʉnga Yesʉ akahega kʉ kɨsalɨ ka Tilo, akakɨɨla kʉ Sidoni, akapika kʉlʉzɨ nʉlʉkʉlʉ nʉla Galilaya nʉkingɨla nkɨka a Dekapoli ndogoelyo akwe isalɨ ikumi. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />Ʉʉgwa, antʉ ang’wɨ akamʉletela ʉ Yesʉi mʉntʉ kɨmumɨ hangɨ gulu, akaminena amʉɨkɨɨlye mɨkono wakomye. <verse eid="MRK 7:32" /><verse number="33" style="v" sid="MRK 7:33" />Yesʉ akamʉpumya kʉmpelo aantʉ, nʉ kʉmʉɨkɨɨlya ng’anza mʉakʉtwɨ amʉntʉ nʉwanso, akatya ɨmatɨ nʉ kʉmugutya ʉlʉlɨmɨ. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />Sʉnga akalangamɨla kilʉnde, akamʉaisɨɨlya, akamʉɨla, “Epata,” ndogoelyo akwe “Lugʉka.”<verse eid="MRK 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 7:35" />Papo paapo akʉtwɨ akwe akalugʉka nʉlʉlɨmi lakwe lɨkatola, akatula ligitya iza tai. <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />Yesʉ akaagilya aleke kʉmʉɨla mʉntʉ wɨhi ikani nɨlanso. Ingɨ anga naɨ ʉagiiye, nɨanso akalongoleka kʉtanantya ikani nɨlanso. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />Antʉ akakʉɨlwa nangaluu, akalʉnga, “Witʉmile maintʉ ɨhi iza. Ʉkʉatenda agulu kija, nɨa kɨmumɨ kʉligitya!”<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">Yesʉ ʉkʉalɨsa ndya antʉ magana amagana annɨ</para>
  <para style="r">
    <ref loc="MAT 15:32-39">Matayo 15:32-39</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />Matungo nanso, milʉndo ʉkʉlʉ nʉwa antʉ akilinga hangɨ, aɨagila anga ndya. Ʉʉgwa, Yesʉ akaitanga amanyisigwa akwe akaatambʉɨla, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />“Kʉaonela kɨnyaʉwai antʉ awa kʉnsoko akolɨ palʉng’wɨ nʉnene mahikʉ atatʉ, agila nɨkakʉlya. <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />Anga nɨaleke alongole kito kʉnʉ ɨze ahumilwe nzala akʉsha kɨsha mʉkanka mʉnzɨla, kʉnsoko nɨang’wɨ apumɨe kʉlɨ.”<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />Amanyisigwa akwe akamʉkolya, “Apa itɨ wɨɨ kʉʉpumya pɨ ndya niakʉalɨsa antʉ awa ɨhi?”<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />Yesʉ akaakolya, “Mʉkete mɨkate ɨnga?” Akasʉkɨɨlya, “Kʉkete mɨkate mʉpungatɨ.” <verse eid="MRK 8:5" /><verse number="6" style="v" sid="MRK 8:6" />Itɨ gwa, Yesʉ akaaɨla ɨantʉ ikiɨ pihɨ. Akahola mɨkate nanso nɨmʉpungatɨ, akamʉsongelya Itunda, akamɨeganɨa, akaapa amanyisigwa akwe agalanye ɨantʉ, akaagalanya. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />Aɨakete nipi samaki pikeehʉ. Yesʉ akapikembeta, akaaɨla agalanyi ɨantʉ. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />Antʉ ɨhi akalya akikʉta. Akilingɨla ɨmaminyangʉɨlwa akazoela akizɨlya itoto mʉpungatɨ. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />Aɨ alɨe anga antʉ magana amagana annɨ. Yesʉ akaalaga ɨantu alongole kʉmatolao, <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />papo paapo akanankɨla mibɨnɨ nɨamanyisigwa akwe, akalongola kʉ kɨsalɨ ka Dalimanʉta.<verse eid="MRK 8:10" /></para>
  <para style="s">Apalisayo akʉhiya kɨlɨngasɨɨlyo</para>
  <para style="r">
    <ref loc="MAT 12:38-42">Matayo 12:38-42</ref>; <ref loc="MAT 16:1-4">16:1-4</ref></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />Apalisayo akapika, akatulitambʉlya nʉ Yesʉi, akaze mʉgema. Akahiya witume mampɨlʉ kʉlɨnga kɨna tai ʉlagɨigwe ni Itunda. <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />Yesʉ akahupa kʉʉkɨa mʉnkolo akwe, akalʉnga, “Nɨkɨ ʉwileli ʉwʉ ʉloɨlwe kɨlɨngasɨɨlyo? Kʉmʉɨla ɨtai, wileli ʉwʉ shanga ʉkʉlagɨɨlwa anga kɨlɨngasɨɨlyo kɨhi.”<verse eid="MRK 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 8:13" />Itɨ gwa, Yesʉ akaaleka, nʉwanso palʉng’wɨ nɨamanyisigwa akwe akanankɨla hangɨ mibɨnɨ, akandya ʉmʉhɨnzo nʉwa kʉlongola kitʉmbɨ nɨla kabɨɨlɨ nɨla lʉzɨ nʉlʉkʉlʉ.<verse eid="MRK 8:13" /></para>
  <para style="s">Igaɨ niilʉlʉ nɨa Apalisayo nʉ Helode</para>
  <para style="r">
    <ref loc="MAT 16:5-12">Matayo 16:5-12</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />Amanyisigwa aɨ ɨilwe kʉhola ɨmɨkate nɨdʉ, aɨ akete mʉkate ʉng’wɨ ʉdu mʉng’wanso mibɨnɨ. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />Yesʉ akaahʉgʉla, “Gozi kɨsa! Hʉgʉki niigaɨ niilʉlʉ nɨa Apalisayo nʉ Helode.”<verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />Amanyisigwa akatulitambʉlya ɨenso, “Ʉkʉtambʉla itɨ kʉnsoko kɨagila anga mɨkate.”<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />Yesʉ aʉlɨngɨle nanso naɨ akitambʉɨla, akaaɨla, “Nɨkɨ mʉkitambʉlya kɨna mɨagila mɨkate? Itɨɨ, mʉkɨlɨ kʉmanya, hangɨ mʉkɨlɨ kʉlɨnga? Itɨɨ, nkolo yanyu nkaku kʉlɨnga? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />Itɨɨ, mʉkete ɨmiho shanga mʉkʉona? Mʉkete akʉtwɨ shanga mʉkija? Itɨɨ, shanga mʉkɨmbʉkile <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />matungo ayo naɨmbegile mɨkate ɨtaano nʉkʉalɨsa iantʉ magana amagana ataano? Aɨmʉhoee nkapu inga nɨa ʉsago.” Akasʉkɨɨlya,</para>
  <para style="p" vid="MRK 8:19">“Nkapu ikʉmi naibili.”<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />“Hangɨ naɨ nɨmɨegile mɨkate mʉpungatɨ, nʉkʉalɨsa antʉ magana amagana annɨ, aɨmʉhoee nkapu inga nɨa ʉsago?” Akasʉkɨɨlya, “Nkapu mʉpungatɨ.” <verse eid="MRK 8:20" /><verse number="21" style="v" sid="MRK 8:21" />Sʉnga, akakolya, “Mʉkɨlɨ du kʉlɨnga?”<verse eid="MRK 8:21" /></para>
  <para style="s">Yesʉ ʉkʉmʉkomya mʉpokʉ kʉ Betisaida</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />Yesʉ palʉng’wɨ nɨamanyisigwa akwe akapika kʉ kɨsalɨ ka Betisaida. Naɨ ʉkolɨ kʉng’wenso antʉ akamʉletela mʉpoku, akaminena amʉkomye. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />Yesʉ akamʉamba mʉkono mʉpokʉ nʉwanso, akamʉtwala kʉnzi akɨsalɨ. Akamʉtyɨla matɨ mʉmiho, akamʉlompeela, akamʉkolya, “Itɨɨ, ʉhumilene kʉona kɨntʉ?” <verse eid="MRK 8:23" /><verse number="24" style="v" sid="MRK 8:24" />Mʉpoku nʉwanso akagoza, akalʉnga, “Kʉaona antʉ anga mɨtɨ akʉgenda.” <verse eid="MRK 8:24" /><verse number="25" style="v" sid="MRK 8:25" />Sʉnga Yesʉ akamʉɨkɨɨlya hangɨ mɨkono mʉmiho, ɨmiho akapɨtya, akaona iza maintʉ ɨhi. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />Yesʉ akamʉɨla alongole kito lakwe, hangɨ akamʉlagɨɨlya, “Leka kingɨla mʉ kɨsalɨ!”<verse eid="MRK 8:26" /></para>
  <para style="s">Petelo ʉkʉmʉgomba ʉ Yesʉi kɨna Kilisito</para>
  <para style="r">
    <ref loc="MAT 16:13-20">Matayo 16:13-20</ref>; <ref loc="LUK 9:18-21">Lʉka 9:18-21</ref></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />Sʉnga Yesʉ nɨamanyisigwa akwe akalongola kʉ isalɨ niya Kaisalia Pilipi. Naɨ amolɨ mʉnzɨla Yesʉ akakolya amanyisigwa akwe, “Antʉ akʉlʉnga ʉne nɨnyenyu?”<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />Akamʉsʉkɨɨlya nɨang’wɨ akʉlʉnga ʉewe wɨ Yohana mʉbadisi, nɨang’wɨ akʉlʉnga mʉnyakɨdagʉ ang’wi Itunda ʉ Elia hangɨ nɨang’wɨ akʉlʉnga ʉng’wɨ nʉwa anyakɨdagʉ ang’wi Itunda.”<verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />Yesʉ akaakolya, “Unyenye, mʉnɨngile ʉnene nɨnyenyu?” Petelo akasʉkɨɨlya, “Ʉewe wɨ Kilisito.”<verse eid="MRK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30" />Sʉnga ʉ Yesʉi akahʉgʉla mʉleke kʉmʉɨla mʉntʉ wɨhi kɨna ʉnene nɨ Kilisito.<verse eid="MRK 8:30" /></para>
  <para style="s">Yesʉ ʉkʉpumya mʉloto nʉwa nsha akwe</para>
  <para style="r">
    <ref loc="MAT 16:21-28">Matayo 16:21-28</ref>; <ref loc="LUK 9:22-27">Lʉka 9:22-27</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />Yesʉ akandya kʉamanyisa amanyisigwa akwe akaaɨla kɨna, itakɨwe ʉnene Ng’waa Mʉntʉ kagigwa nʉkʉhitwa nɨ anyampala nɨapolyi nɨakʉlʉ nɨamanyisa malagɨɨlyo ang’wa Musa. Hangɨ kʉbʉlagwa, lʉhikʉ nʉla kataatʉ kiʉka. <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />Yesʉ aɨ ʉkʉatambʉɨla kɨhenga ikani nɨlanso. Papo gwa, ʉ Petelo akamʉtwala kʉmpelo, akatula mʉkenela. <verse eid="MRK 8:32" /><verse number="33" style="v" sid="MRK 8:33" />Ingɨ ʉ Yesʉi akapɨlʉka, akaagoza amanyisigwa akwe, akamʉkenela ʉ Petelo akamʉɨla, “Sʉka kʉnyuma ane. Ʉewe wɨ Shetani! Masɨgo ako shanga ang’wi Itunda ʉkete masigo akɨ ʉntʉ.”<verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />Sʉnga ʉ Yesʉi akaitanga milʉndo nʉwa antʉ palʉng’wɨ nɨamanyisigwa akwe, akaaɨla, “Mʉntʉ wɨhi nʉloilwe kʉtula mʉmanyisigwa wane, nʉihite ʉng’wenso, nʉwakenke nʉwagombe kagigwa kʉpikɨɨla ɨsha wantyate. <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />Kʉnsoko mʉntʉ nʉloilwe kʉguna likalo lakwe, ʉkʉsha, nʉ mʉntʉ nʉloilwe kʉsha kʉnsoko alina lane hangɨ kʉnsoko a Nkani Nza, ʉkʉlʉguna. <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />Itɨɨ, mʉntʉ ʉkʉlija nsaɨlo kɨɨ anga waʉlije ʉnkumbigʉlʉ wɨhi nʉkʉʉlimɨlya ʉlikalo lakwe? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />Ang’wɨ ʉ mʉntʉ ʉkʉpumya ntʉni wagune ʉpanga wakwe? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />Mʉntʉ wɨhi nʉkʉmonela mɨnyala mʉ wileli ʉwʉ nʉʉbɨ nʉʉmanyisi wane, nʉnene Ng’waa Mʉntʉ nzɨɨza mʉhita, matungo nɨ nzɨɨza mʉʉkʉlʉ wang’wa Tata wane palʉng’wɨ nɨ a malaɨka nɨelʉ.”<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />Yesʉ akalongoleka kʉatambʉɨla, “Kʉmʉɨla ɨtai, akolɨ antʉ nɨɨmɨkile apaitɨ nɨshanga a kʉsha lʉkʉlʉ kʉpikɨɨla aʉone ʉtemi wang’wi Itunda ʉpembilye kʉngulu.”<verse eid="MRK 9:1" /></para>
  <para style="s">Yesʉ ʉkigeela mʉʉkʉlʉ wakwe</para>
  <para style="r">
    <ref loc="MAT 17:1-13">Matayo 17:1-13</ref>; <ref loc="LUK 9:28-36">Lʉka 9:28-36</ref></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />Naɨakɨla mahikʉ mʉtandatʉ, Yesʉ akaahola Petelo nʉ Yohana nʉ Yakobo akanankɨla nɨenso mʉlʉgʉlʉ. Yesʉ akaɨlɨka ikelʉ lakwe ntongela ao, <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />Matugalo akwe akatula mɨlɨgɨnta, nʉkʉtula melʉ pee, kʉtilɨ anga mʉntʉ mʉʉnkumbigʉlʉ nʉhumile kʉhombola atule melʉ itɨ. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />Papo paapo amanyisigwa ao nɨataatʉ akaaona amanga ang’wi Itunda Elia nʉ Musa, akitambʉlya nʉ Yesʉi. <verse eid="MRK 9:4" /><verse number="5" style="v" sid="MRK 9:5" />Petelo akamʉɨla ʉ Yesʉi, “Mʉmanyisi, inonee ʉsese ɨze kʉmolɨ papa. Bahu kʉzenge itala itaatʉ, kɨng’wɨ kako, nɨkɨʉya kang’wa Musa nɨkɨʉya kang’wa Elia.” <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />Petelo akaʉlya nɨkakʉligitya, kʉnsoko nʉwanso nɨaʉya aɨogopa.<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />Sʉnga lɨkagiɨlya ilunde lɨkakʉnɨkɨla, ʉlʉlɨ lang’wi Itunda lɨkigigwa kʉpuma milunde nɨlanso, “Ʉyʉ ng’waane nɨnʉmʉloilwe mʉtegeelyi.” <verse eid="MRK 9:7" /><verse number="8" style="v" sid="MRK 9:8" />Papo paapo amanyisigwa nɨanso akagoza kʉnʉ nɨ kʉnʉ, shanga akaona anga mʉntʉ wɨhi, ingɨ ʉ Yesʉi du palʉng’wɨ nɨenso.<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />Ʉʉgwa, naɨ akʉhulumʉka kʉpuma mʉlʉgʉlʉ, Yesʉ akaalagɨɨlya “Leki kʉmʉɨli mʉntʉ wɨhi makani nazamʉmaɨne, kʉpikɨɨla ʉnene Ng’waa Mʉntʉ nʉzɨɨza iʉka.”<verse eid="MRK 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10" />Itɨ gwa akagomba ilagɨɨlyo nɨlanso, ingɨ akikolya enso kʉ enso wiʉki ɨndogoelyo ntuni. <verse eid="MRK 9:10" /><verse number="11" style="v" sid="MRK 9:11" />Akamʉkolya ʉ Yesʉi, “Amanyisi amalagɨɨlyo ka ɨlʉnga, mʉnyakɨdagʉ wang’wi Itunda Elia ʉkʉmʉtongeela ʉ Kilisito kʉza?”<note caller="+" style="f"><char style="fr" closed="false">9:11 </char><char style="ft" closed="false">Yesʉ aɨ ʉmimpyanilye ʉ Yohana Mʉbadisi nʉ Elia. Yohana Mʉbadisi aɨwitʉmile ʉmʉlɨmo nɨ Ayahudi aɨ alindɨɨe kɨna ʉ Elia ng’wenso ʉziitʉma. Mʉlɨmo nʉwanso aɨ kʉmʉnoneelya Yesʉ nzɨla </char></note><verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />Yesʉ nʉng’wenso akaasʉkɨɨlya, “Tai, mʉnyakɨdagʉ wang’wi Itunda Elia ʉpembilye hanza kʉnoneelya ɨhi. Nɨɨtɨ ga, kʉnɨkɨ gwa yandɨkilwe Mʉʉandɨkwa Nʉʉza kɨna ʉnene Ng’waa Mʉntʉ kagigwa nʉ kʉdalahwa. <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />Kʉmʉtambʉɨla, mʉmanga wang’wi Itunda ʉ Elia wazile, antʉ akamʉtendeela ɨhi naɨaloilwe, anga naɨ ʉandɨkɨwe mʉʉandɨkwa.”<verse eid="MRK 9:13" /></para>
  <para style="s">Mʉhʉmba nʉkete ʉhɨng’wɨ ʉkʉkomigwa nʉ Yesʉi</para>
  <para style="r">
    <ref loc="MAT 17:4-21">Matayo 17:4-21</ref>; <ref loc="LUK 9:37-43">Lʉka 9:37-43</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />Yesʉ nɨamanyisigwa awo nɨataatʉ naɨapika kʉ amanyisigwa aʉya, pang’wanso akaona milʉndo ʉkʉlʉ nʉwa antʉ. Nɨamanyisi amalagɨɨlyo nɨang’wɨ aɨ akitambʉlya nɨantʉ nɨanso. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />Itungo ʉdu milʉndo nʉwanso nʉwa antʉ naɨamʉine ʉ Yesʉi, ɨhi akakʉɨlwa, akamʉmankɨɨla amʉlamʉshe. <verse eid="MRK 9:15" /><verse number="16" style="v" sid="MRK 9:16" />Yesʉ akaakolya, “Mʉkikʉngʉma ntʉni nɨenso?”<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />Mʉntʉ ʉng’wɨ mʉ milʉndo nʉwanso akamʉsʉkɨɨlya ʉ Yesʉi, “Mʉmanyisi, namʉletaa ʉng’waane kʉng’wako, nʉwatendɨlwe kɨmʉmi nʉhɨng’wɨ. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />Matungo ɨdʉ hɨng’wɨ nʉwanso wɨmʉkatʉlya pihɨ akatulaa puma ipomboolu kʉmʉlomo, nʉkʉkelya mino nʉ mʉɨli wɨhi wɨkakamaala. Amanyisigwa ako aza nɨatambʉɨe amʉhegelye aleng’wa.”<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />Yesʉ akaaɨla, “Ʉnyenye wileli nɨmɨagila ʉhʉɨɨli! Mʉkʉtula nʉnene mahikʉ ɨhi? Kigigimɨlya kʉpikɨɨla nalɨ? Mʉleti kʉng’wane ʉng’wana nʉwanso.” <verse eid="MRK 9:19" /><verse number="20" style="v" sid="MRK 9:20" />Akamʉtwala ʉng’wana nʉwanso kʉng’wa Yesʉ. Papo paapo hɨng’wɨ nʉwanso naɨʉmʉine ʉdu ʉ Yesʉi,</para>
  <para style="p" vid="MRK 9:20">Mʉhʉmba akatulwa nɨ nkolo, akagwa pihɨ, akagalʉka nʉkʉpuma ipombolu kʉmʉlomo. <verse eid="MRK 9:20" /><verse number="21" style="v" sid="MRK 9:21" />Yesʉ akamʉkolya ihe nʉwa mʉhʉmba nʉwanso, “Ng’waako wandilye nalɨ kʉtula itɨ?” Nʉng’wenso ihe nʉwa mʉhʉmba akasʉkɨɨlya, “Ʉʉ ɨza wɨlɨ puma nʉwatugɨwe. <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />Nkʉa yɨdu hɨng’wɨ ʉyʉ wɨmʉgʉmɨla mʉmoto ang’wɨ mʉmazɨ, kʉnsoko wamʉlimansɨlye lʉkʉlʉ. Kʉaisɨɨlye anga ɨze ʉhumile kʉaɨɨlye!” <verse eid="MRK 9:22" /><verse number="23" style="v" sid="MRK 9:23" />Yesʉ akamʉɨla, “Kʉnɨkɨ ʉlʉngile ang’wɨ ihumɨkile! Ɨhi ahumɨkile kʉmʉntʉ nʉkete ʉhʉɨɨli.”<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />Papo paapo ihe nʉwa mʉhʉmba akalɨla kʉ ʉkɨa, “Nihʉɨɨe! Ingɨ ʉhʉɨɨli wane ʉnino, nzaɨlye nihume kʉhʉɨɨla.”<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />Yesʉ naɨwaona milʉndo nʉwa antʉ ʉkongeeleka pa ntongela akwe, akamʉkenela ʉhɨng’wɨ nʉwanso, “Ʉwe hɨng’wɨ nʉwagulu nɨ kɨmumɨ nʉkʉmʉtenda ʉmʉhʉmba ʉyʉ kʉtula kɨmumɨ hangɨ gulu, kʉʉsinja puma mʉmʉhʉmba ʉyʉ ʉleke kʉsʉka hangɨ!”<verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />Papo paapo ʉhɨng’wɨ nʉwanso akakʉta, akamʉkatʉlya pihɨ mʉhʉmba nʉwanso, akahega. Mʉhʉmba akatula anga ʉmʉimba, antʉ ang’wɨ akalʉnga, “Wakʉza!” <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />Yesʉ akamʉamba ʉmʉkono mʉhʉmba, akamʉʉsha, nʉng’wenso akimɨka. <verse eid="MRK 9:27" /><verse number="28" style="v" sid="MRK 9:28" />Ingɨ, ʉ Yesʉi naɨwingɨla mʉnyʉmba, amanyisigwa akwe akamʉkolya, “Nɨkɨ ʉsese aza kaleng’wa kʉmʉpumya ʉhɨng’wɨ ʉyʉ?” <verse eid="MRK 9:28" /><verse number="29" style="v" sid="MRK 9:29" />Yesʉ akaaɨla, “Ʉhɨng’wɨ anga ʉyʉ, shanga ʉhumile kʉhega ingɨ kʉnzɨla akʉlompa hanza ʉewe.”<verse eid="MRK 9:29" /></para>
  <para style="s">Yesʉ ʉkʉligitɨlya hangɨ ɨnsha nʉ wiʉki wakwe</para>
  <para style="r">
    <ref loc="MAT 17:22-23">Matayo 17:22-23</ref>; <ref loc="LUK 9:43-45">Lʉka 9:43-45</ref></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />Yesʉ nɨamanyisigwa akwe akahega pang’wanso akalongoleka nʉmʉhɨnzo akakɨɨla kʉ Galilaya. Yesʉ shanga aɨ ʉloilwe antʉ alɨnge ʉko kʉkolɨ, <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />kʉnsoko aɨ ʉkʉamanyisa amanyisigwa akwe. Akaatambʉɨla, “Ʉnene Ng’waa Mʉntʉ kʉsuɨpwa nɨ antʉ nʉkʉmbʉlaga, lʉhikʉ nʉla kataatʉ kiʉka.”<verse eid="MRK 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32" />Ingɨ amanyisigwa akwe shanga aɨ alɨngɨle ikani nɨlanso. Akogopa kʉmʉkolya.<verse eid="MRK 9:32" /></para>
  <para style="s">Nyenyu nʉ mʉkʉlʉ?</para>
  <para style="r">
    <ref loc="MAT 18:1-5">Matayo 18:1-5</ref>; <ref loc="LUK 9:46-48">Lʉka 9:46-48</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />Yesʉ nɨ amanyisigwa akwe naɨapika kʉ Kapalanaʉmu. Naɨ ʉmolɨ mʉnyʉmba, akaakolya, “Mʉnzɨla aza mʉkikʉngʉma ntʉni?” <verse eid="MRK 9:33" /><verse number="34" style="v" sid="MRK 9:34" />Nɨenso shanga akasʉkɨlya, kʉnsoko mʉnzɨla aɨ akikʉngʉma kɨna mʉng’witʉ nyenyu nʉkʉtula mʉkʉlʉ. <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" />Yesʉ akalama pihɨ, akaitanga amanyisigwa ao ikʉmi na abɨɨlɨ, akaaɨla, “Mʉntʉ wɨhi anga walowe kʉtula mʉkʉlʉ kʉsinja atule mʉniino hangɨ mitʉmi waʉya ɨhi.” <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />Sʉnga Yesʉ akamʉhola ng’wana mʉniɨno, akamimɨsha pakatɨ ao, akamʉungatɨla, sʉnga akaaɨla hangɨ, <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />“Ʉyʉ nʉkʉmʉsɨngɨɨlya ng’wana anga ʉyʉ kikʉlyo la lina lane, ʉnsɨngɨɨye nene, hangɨ nʉkʉnsɨngɨɨlya ʉnene, shanga ʉnsɨngɨɨye anga ʉnene du, ingɨ ʉmʉsɨngɨɨye Itunda naɨ ʉndagɨɨye.”<verse eid="MRK 9:37" /></para>
  <para style="s">Nɨshanga wɨnsuta nʉsese nʉwanso wɨpalʉng’wɨ nʉsese</para>
  <para style="r">
    <ref loc="LUK 9:49-50">Lʉka 9:49-50</ref></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />Yohana akamʉɨla Yesʉ, “Mʉmanyisi, kamʉona mʉntʉ ʉkʉheja hɨng’wɨ kʉlina lako, ʉsese kamʉgilya kʉnsoko shanga mɨitʉ.”<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />Ingɨ ʉ Yesʉi akaaɨla, “Leki kʉmʉgilyi ʉmʉntu ɨkɨ nʉkitʉma. Kʉtilɨ mʉntʉ nʉkitʉma ʉmʉlɨmo kʉlina lane, papo paapo waakentambʉla niibɨ. <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />Mʉntʉ wɨhi nʉkitʉma aya nɨkʉitʉma wɨpalʉng’wɨ nʉsese. <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />Kʉmʉɨla kʉlʉ kʉʉlʉ, mʉntʉ wɨhi nʉkʉmʉpeza ɨmazɨ akʉng’wa, kʉnsoko ʉnyenye mɨantʉ ang’wa Kilisito, kʉmʉɨla ʉkʉlija kɨpegwa kakwe.<verse eid="MRK 9:41" /></para>
  <para style="s">Makani nɨsasha mʉntʉ kitʉma mɨlandʉ</para>
  <para style="r">
    <ref loc="MAT 18:6-9">Matayo 18:6-9</ref>; <ref loc="LUK 17:1-2">Lʉka 17:1-2</ref></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />Mʉntʉ wɨhi nʉkʉʉmʉsasha ʉng’wɨ mʉana awa itʉme mɨlandʉ, bahu mʉntʉ nʉwanso watungɨɨlwe lwala nʉlʉkʉlʉ mʉnkingo wagʉmɨlwe mʉlʉzɨ nʉ lʉkʉlʉ. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />Mʉkono wako anga ʉkʉsashe, ʉheje! Bahu kingɨla mʉʉpanga ɨze ʉkete mʉkono ʉng’wɨ, kʉkɨla kʉtula nɨ mɨkono ɨbɨɨlɨ wingɨle kʉʉlʉngʉ mʉ moto nɨshanga wɨlimaa. <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />Mʉng’wanso ngunyɨ yakwe shanga yɨshaa nʉ moto shanga wɨlima. <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />Nʉ mʉgʉlʉ wako anga ʉkʉsashe, ʉheje! Bahu kingɨla mʉʉpanga ɨze ʉkete mʉgʉlʉ ʉng’wɨ, kʉkɨla kʉtula nɨ mɨgʉlʉ ɨbɨɨlɨ wingɨle kʉʉlʉngʉ mʉ moto nɨshanga wɨlimaa. <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />Mʉng’wanso ngunyɨ yakwe shanga yɨshaa nʉ moto shanga wɨlima. <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />Nɨ liho lako anga lɨkʉsashe, lɨheje! Bahu kingɨla mʉʉtemi wang’wi Itunda ɨze wihongo, kʉkɨla kʉtula nɨmiho ɨhi abɨɨlɨ nʉkʉgʉmɨlwa kʉʉlʉngʉ mʉ moto nɨshanga wɨlimaa. <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />Mʉng’wanso ngunyɨ yakwe shanga yɨshaa nʉ moto shanga wɨlima.<verse eid="MRK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49" />Itunda ʉkʉmʉkɨɨlya mʉntʉ wɨhi mʉlwago nʉlɨhanga kʉzigɨligwa nʉ moto, anga antʉ nɨɨpaka mʉnyʉ mʉnyama nɨakɨlɨ kʉmɨlimansɨɨlya.<verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />Mʉnyʉ ʉza, ingɨ anga ʉʉlye ʉʉza wakwe nyenyu nʉkʉʉnonia hangɨ?</para>
  <para style="p" vid="MRK 9:50">Nʉnyenye mʉtule anga mʉnyʉ nʉɨkoela, ɨze migombye ʉnyenye.”<verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">Yesʉ ʉkʉʉtambʉla ʉwileki</para>
  <para style="r">
    <ref loc="MAT 19:1-12">Matayo 19:1-12</ref>; <ref loc="LUK 16:18">Lʉka 16:18</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />Sʉnga ʉ Yesʉi akahega kʉ Kapelenaʉmu, akaputa ʉmongo nʉwa Yolodani akenda kʉ Yʉdea. Milʉndo nʉwa antʉ akamʉhanga hangɨ, akaamanyisa anga naɨwizɨɨe.<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />Itɨ gwa, Apalisayo ang’wɨ akamʉhanga ʉ Yesʉi, akamʉkolya azemʉgema, “Itɨɨ, mʉmalagɨɨlyo itʉ igombigwe ne mʉgoha kʉmʉleka mʉkɨmakwe?”<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />Yesʉ akaasʉkɨɨlya, “Itɨɨ, Musa aɨ ʉmʉlagɨɨlyo ntʉnɨ?”<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />Nɨenso akalʉnga, “Musa aɨʉgombilye kɨna mʉgoha ʉhumile kʉmʉandɨkɨla mʉkɨmakwe itʉtʉ nɨla wileki.”<verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />Yesʉ akaaɨla, “Musa aɨ ʉmʉandɨkɨe ilagɨɨlyo nɨlanso kʉnsoko shanga mɨambaa inkani nɨ mʉkʉmanyisigwa. <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />Ingɨ puma kʉtundwa kʉ ʉnkumbigʉlʉ Itunda aɨ ʉmʉʉmbile mitʉnja nʉ mʉsʉngʉ. <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />Itɨ gwa mʉgoha ʉkʉmʉleka ihe nʉ nyinya, ʉkʉkamɨnkana nʉ mʉkɨmakwe, <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />nɨenso nɨabɨɨlɨ akʉtula mʉɨlɨ ʉng’wɨ. kʉlʉlo, shanga abɨɨlɨ hangɨ ingɨ mʉɨlɨ ʉng’wɨ. <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />Itɨ gwa, Itunda nʉkɨkamantanilye, mʉntʉ waleke kʉkɨtemanʉla.”<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />Naɨingɨla hangɨ mʉnyʉmba, amanyisigwa akamʉkolya ikani nɨlawileki. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />Yesʉ akaaɨla, “Mʉgoha nʉkʉmʉleka mʉkɨmakwe watɨne mʉkɨma mʉngɨza, ʉkʉgoolya kʉmʉkɨmakwe. <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />Mʉkɨma nʉkileka nʉmʉgohakwe nʉkʉtɨnwa nʉmʉgoha mʉngɨɨza ʉkʉgoolya kʉmʉgohakwe.<verse eid="MRK 10:12" /></para>
  <para style="s">Yesʉ ʉkʉakembeta ang’enya nɨaniino</para>
  <para style="r">
    <ref loc="MAT 19:13-15">Matayo 19:13-15</ref>; <ref loc="LUK 18:15-17">Lʉka 18:15-17</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />Antʉ aɨ aatwae ang’enya nɨaniino kʉng’wa Yesʉ waaɨkɨɨllye mɨkono wahume kʉakembeta, amanyisigwa akwe akaapatya.<verse eid="MRK 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 10:14" />Naɨwaona itɨ ʉ Yesʉi, akabɨpɨlwa akaaɨla, “Aleki ang’enya nɨanso aze kʉng’wane, leki kʉagilyi, ʉtemi wang’wi Itunda ingɨ waantʉ nɨhanga ang’enya nɨaniino awa itɨ. <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />Kʉmʉɨla ɨtai, mʉntʉ wɨhi nʉkʉhita kʉʉsɨngɨɨlya ʉtemi wang’wi Itunda anga ʉhʉɨɨli nʉwa mʉng’enya nʉmʉniino shanga ʉkingɨla mʉng’wanso.” <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />Sʉnga Yesʉ akaahola ang’enya nɨaniino, akaaʉngatɨla, aka aɨkɨɨlya mɨkono, aka akembeta.<verse eid="MRK 10:16" /></para>
  <para style="s">Mʉntʉ nɨ mʉgolɨ</para>
  <para style="r">
    <ref loc="MAT 19:16-30">Matayo 19:16-30</ref>; <ref loc="LUK 18:18-30">Lʉka 18:18-30</ref></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />Yesʉ naɨwandya ʉmʉhinzo wakwe, mʉntʉ ʉng’wɨ akamʉmankɨɨla, akenda pantongela akwe akatugama, akamʉkolya, “Mʉmanyisi nʉmʉza, ntendeʉlɨ mpantɨke ʉpanga nʉwa kalɨ na kalɨ?”<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />Yesʉ akamʉkolya, “Nɨkɨ ʉkʉnitanga nɨmʉza? Kʉtilɨ nʉmʉza ingɨ Itunda du. <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />Yesʉ akalongoleka kʉmʉɨla ʉlɨngɨlene ɨmalagɨɨlyo ang’wa Musa, ‘Leka kʉgoolya, Leka kʉbʉlaga, Leka kia, Leka kʉkʉɨɨla ʉteele, Leka kʉlongopa, Akʉlye tataako nʉ iyaako.’”<verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />Nʉng’wenso akamʉsʉkɨɨlya, “Mʉmanyisi kʉpuma mʉʉhʉmba wane nɨmatyatile malagiilyo aya ɨhi.”<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />Yesʉ akamʉgoza, akamʉlowa, akamʉɨla, “Ʉkepewe kɨntʉ kɨng’wɨ. Longola ʉgʉlye maintʉ ako ɨhi nʉkete, ʉape ɨaʉla mpia nɨyanso, nʉewe ʉkʉtula nɨnsaɨlo kigʉlʉ, sʉnga ʉpembye ʉntyate.” <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />Mʉntu ʉyʉ naɨ waɨlwa itɨ, akaalɨka mʉnkolo akwe, akalongola nʉʉkɨɨa, kʉnsoko aɨʉkete nsao yɨdʉ.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />Yesʉ akagoza kʉnʉ nɨ kʉnʉ, akaatambʉɨla amanyisigwa akwe, “Kɨnyaʉlɨ nɨikakʉ agolɨ kingɨla mʉʉtemi wang’wi Itunda!”<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />Amanyisigwa akwe akakʉɨlwa inkani yakwe. Yesʉ akaaɨla hangɨ, “Ahʉmba ɨane ingɨ ikakʉ nangaluu mʉntʉ kingɨla mʉʉtemi wang’wi Itunda! <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />Ingɨ itotu kɨkalɨ nɨkitangwaa ngamia kʉhepela mʉnzʉʉnki a sindano kʉkɨla mʉntʉ nɨ mʉgolɨ kingɨla mʉʉtemi wang’wi Itunda.<verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />Amanyisigwa akwe akakʉɨlwa nangalu akikolya, “Nyenyu gwa, nʉhumile kʉgunɨka?”<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />Yesʉ akaagozeela amanyisigwa akwe, akaaɨla, “Kʉantʉ shanga ihumɨkile, kʉng’wi Itunda shanga ʉ, kʉng’wi Itunda maintʉ ɨhi ahumɨkile.”<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />Petelo akamʉkolya, “Itɨɨ, ʉsese kʉlekile maintʉ itʉ ɨhi kakʉtyata?”<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />Yesʉ akalʉnga, “Kʉmʉɨla ɨtai, mʉntʉ wɨhi nʉlekile ito ang’wɨ heu ang’wɨ mʉluna nʉwa kɨsʉngʉ ang’wɨ ihe ang’wɨ nyinya ang’wɨ ana ang’wɨ mɨgʉnda kʉnsoko ane ni Nkani Nza, <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />ʉkʉlija maintʉ idʉ kʉkɨlɨnkɨɨla anga, nyʉmba, aheu, nɨalʉna nɨakɨsʉngʉ, nʉnyinya nɨana nɨmɨgʉnda, nʉlwago, nɨ matungo nazile akʉsɨngɨɨlya ʉpanga nʉwa kalɨ na kalɨ. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />Ingɨ nɨatongee akʉtula akʉsɨkɨɨlya nawa nɨasɨkɨɨye akʉtula atongee.”<verse eid="MRK 10:31" /></para>
  <para style="s">Yesʉ ʉkʉtambʉla nsha nʉ wiʉki wakwe nkʉa akataatu</para>
  <para style="r">
    <ref loc="MAT 20:17-19">Matayo 20:17-19</ref>; <ref loc="LUK 18:31-34">Lʉka 18:31-34</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />Itɨ gwa, Yesʉ akaatonga naɨakole mʉnzɨla alongoe kʉ Yelusalemu, Yesʉ aɨʉatongee. Amanyisigwa akatula nʉ woa, nɨantʉ naɨ alondoe akatula nʉ woa. Yesʉ akaakoma amanyisigwa ao nɨ kʉmi nabɨɨlɨ, akatula atambʉɨla makani nakʉmʉhanga. <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />Yesʉ akaaɨla, “Tegeelyi! Kʉlongoe kʉ Yelusalemu, kʉng’wanso ʉnene Ng’waa Mʉntʉ kʉɨkwa mʉmɨkono apolyi nɨakʉlʉ nɨamanyisi amalagɨɨlyo ang’wa Musa, nɨenso akʉmpɨsɨɨlya kʉmbʉlaga nʉkʉntwala kʉ antʉ nɨ shanga Ayahudi, <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />Nɨenso akʉndalaha, akʉntyɨla matɨ. akʉnkʉa namɨsheleti nʉkʉmbʉlaga. Ingɨ mʉlʉhikʉ nʉla kataatʉ kiʉka.”<verse eid="MRK 10:34" /></para>
  <para style="s">Yakobo nʉ Yohana akʉmʉlompa Yesʉ ʉkʉlʉ</para>
  <para style="r">
    <ref loc="MAT 20:20-28">Matayo 20:20-28</ref></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />Ana ang’wa Zebedayo, ʉ Yakobo nʉ Yohana, akamʉhanga ʉ Yesʉi akamʉɨla, “Mʉmanyisi, kɨkolɨ kɨntʉ kʉʉkʉlompa ʉkʉtendeele.”<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />Yesʉ akaakolya, “Itɨɨ, mʉloilwe nʉmʉtendeele ntʉnɨ?”<verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />Akamʉsʉkɨɨlya, “Nʉɨkikiɨ mituntu lako nʉlaʉkʉlʉ nikʉlyo, ʉkʉgombye kikiɨ nʉewe ʉng’wɨ ipande lako nɨla kɨgoha nʉmʉya ipande lako nɨla nkɨgɨ.”<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />Yesʉ akaaɨla, “Shanga mʉlɨngɨle nɨmʉkʉkɨlompa! Itɨɨ, mʉhumilene kʉgimya kagigwa anga nɨzeagigwa ʉnene, ang’wɨ kʉbʉlagwa anga nɨzebʉlagwa ʉnene?”<verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />Akamʉsʉkɨɨlya, “Kuhumile.”</para>
  <para style="p" vid="MRK 10:39">Yesʉ wɨkaaɨla, “Tai mʉkagigwa anga nene, ang’wɨ mʉkʉbʉlagwa anga nene. <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />Ingɨ ʉlʉ nʉla kikiɨ ʉng’wɨ ipande la kɨgoha ang’wɨ ipande la nkɨgɨ lyoma nɨlanso shanga nene kʉʉnoneelya. Itunda ʉkʉapa awo nʉwanoneleeye.”<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />Amanyisigwa nɨangɨɨza awo ni ikʉmi naɨigule nanso, akaatakɨɨla ɨa Yohana nʉ Yakobo. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />Itɨ gwa,Yesʉ akaitanga ɨhi palʉng’wɨ, akaatambʉɨla, “Mʉlɨngɨle kɨna awa nɨasɨgɨɨwe atemi aantʉ nɨshanga Ayahudi ɨatema ɨantʉ ao kʉngulu, hangɨ akʉlʉ nɨanso ɨonyeelya ɨantʉ ao. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />Ingɨ ʉnyenye ileke kʉtula itɨ, mʉntʉ wɨhi nʉloilwe kʉtula mʉkʉlʉ anyu, ʉtakɨwe watule mitʉmi wanyu. <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />Nʉloilwe kʉtʉla mʉtongeeli, ʉtakɨwe watule mitʉmi wa antʉ ɨhi. <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />Kʉlʉnga itɨ kʉnsoko nʉnene Ng’waa Mʉntʉ shanga aɨ nzilitʉmɨlwa, ingɨ kʉitʉmɨla, nʉkʉpumya ʉpanga wakwe kʉtula kɨkomoli ka antʉ ɨdʉ.”<verse eid="MRK 10:45" /></para>
  <para style="s">Yesʉ ʉkʉmʉkomya mʉpokʉ nʉitangwa Batimayo</para>
  <para style="r">
    <ref loc="MAT 20:29-34">Matayo 20:29-34</ref>; <ref loc="LUK 18:35-43">Lʉka 18:35-43</ref></para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />Sʉnga naɨ akapika kʉ Yeliko, nʉ Yesʉi nɨamanyisigwa akwe palʉng’wɨ nʉ milʉndo waantʉ naɨ ʉkʉhega mʉkɨsalɨ nɨkanso aze ine, mʉpoku nʉitangwa Batimayo, aɨ wikiɨ mʉmpelo ipanda wazilompeelya maintʉ. <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />Naɨ wija kɨna Yesʉ mʉnya kʉ Nazaleti ʉkɨile pang’wanso, akandya kitʉnta, “Ʉewe Yesʉ, Ng’wana nʉwa ndʉgʉ a ʉtemi wang’wa Daudi, mbaisɨɨlye!”<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />Antʉ ɨdʉ akamʉkenela kʉnsoko wakilage, ingɨ nʉwanso akalongoleka kitʉnta, “Ʉewe Yesʉ, Ng’wana nʉwa ndʉgʉ a ʉtemi wang’wa Daudi, mbaisɨɨlye!”<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />Yesʉ akimɨka, akalʉnga, “Mʉɨli waze.”</para>
  <para style="p" vid="MRK 10:49">Itɨ gwa akamitanga ʉmʉpokʉ nʉwanso, akamʉɨla, “Komya ɨnkolo! Imɨke, ʉkʉitanga.”<verse eid="MRK 10:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 10:50" />Nʉng’wenso akimɨka akagʉma itugalo lakwe, akaputa, akamʉhanga ʉ Yesʉi.<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />Yesʉ akamʉkolya, “Ʉkʉhiya ntʉni?” Mʉpokʉ nʉwanso akamʉsʉkɨɨlya,</para>
  <para style="p" vid="MRK 10:51">“Mʉmanyisi, kʉlompa kʉona.”<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />Yesʉ akamʉɨla, “Longola, kʉhʉɨɨla kʉng’wako wakomigwa.”</para>
  <para style="p" vid="MRK 10:52">Papo paapo mʉpokʉ nʉwanso akandya kʉona, akamʉtyata ʉ Yesʉi.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">Yesʉ ʉkingɨla kʉ Yelusalemu kʉ ngiligili</para>
  <para style="r">
    <ref loc="MAT 21:1-11">Matayo 21:1-11</ref>; <ref loc="LUK 19:28-40">Lʉka 19:28-40</ref>; <ref loc="JHN 12:12-19">Yohana 12:12-19</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />Yesʉ nɨamanyisigwa akwe aɨ ahugeela pa Yelusalemu akapika kʉ isalɨ niinino nia Betipage nɨ Betania pakʉpɨ nʉlʉgʉlʉ nʉla Mizeituni. Papo gwa Yesʉ akaalagɨɨlya amanyisigwa akwe abɨɨlɨ, <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />akaaɨla, “Longoli kʉ kɨsalɨ nɨka kʉntongeela. Anga mapika kʉng’wanso, mʉkʉmʉhanga ng’waa ndogwe ʉtungilwe ɨza wakɨlɨ kʉtʉmɨlwa nʉ mʉntʉ wɨhi. Mʉtungʉɨli ndeteli apa. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />Anga mʉntʉ wamʉkolye, nɨkɨ mʉkitʉma itɨ? Mʉɨli, ‘Isekʉlʉ ʉmʉtakile ʉkʉmʉsʉsha ʉdu.”’<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />Akalongola, akamʉhanga ng’waa ndogwe ʉtungilwe mʉ mpelo ɨpanda pakʉpɨ nʉ mʉmpita. Naɨ akʉmʉtungʉɨla, <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />antʉ ang’wɨ naɨɨmɨkile pang’wanso akaakolya, “Ʉnyenye mʉkʉtenda ʉlɨ pang’wanso? Nɨkɨ mʉkʉmʉtungʉɨla ʉng’waa ndogwe?”<verse eid="MRK 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 11:6" />Amanyisigwa ang’wa yesʉ akaasʉkɨɨlya anga naɨ atambʉɨwe nʉ Yesʉi, akagombigwa akalongola. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />Akamʉtwala ʉng’waa ndogwe nʉwanso kʉng’wa Yesʉ. Akaɨla matugalo ao mʉ mʉgongo wa ng’waa ndogwe, Yesʉ akanankɨla mʉ mʉgongo wakwe. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />Antʉ ɨdʉ akaɨla matugalo ao mʉ mapanda, nɨang’wɨ akaɨla ntambɨ niniino nɨa mɨtɨ naɨ aitemile mʉmɨgʉnda. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />Antʉ ɨhi naɨ atongee nawa naɨ atyatɨɨe, akitʉnta akalʉnga, “Itunda wakʉligwe! Ʉkembetilwe ʉewe nʉzile kʉlina lang’wi Isekʉlʉ! <verse eid="MRK 11:9" /><verse number="10" style="v" sid="MRK 11:10" />Ʉkembetilwe ʉtemi nʉʉzile nʉwang’wa tata itʉ ʉ Daudi. Ikʉlyo kʉng’wi Itunda nʉkolɨ kilunde!”<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />Yesʉ naɨ wingɨla mʉkɨsalɨ nɨkɨkʉlʉ nɨka Yelusalemu akatongolomoka panyʉmba ang’wi Itunda, akalaa lala maintʉ ɨhi. Ingɨ kʉnsoko aɨ yaina mpɨndɨ, akatulya kʉ Betania nɨamanyisigwa nɨkʉmi naabɨɨlɨ.<verse eid="MRK 11:11" /></para>
  <para style="s">Yesʉ ʉkʉʉzʉma mʉkʉyʉ</para>
  <para style="r">
    <ref loc="MAT 21:18-19">Matayo 21:18-19</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />Mʉdaʉ akwe naɨ akʉhega kʉ Betania kʉlongola kʉ Yelusalemu, ʉ Yesʉi akahung’wa nzala. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />Itɨ gwa, Yesʉ akaʉona mʉkʉyʉ ʉdemile matʉtʉ. Akalongola wagoze ang’wɨ ʉpee nkali. Naɨ wapika, akahanga ʉgila anga nkali ɨhi ingɨ matʉtʉ matile, kʉnsoko shanga aɨ matungo a nkali. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />Papo gwa Yesʉ akaʉɨla ʉmʉkʉyʉ, “Puma ɨlelo nɨkalɨ na kalɨ shanga ʉkʉpa anga nkali, amanyisigwa akwe aɨigulye naɨ ʉkʉʉzuma<verse eid="MRK 11:14" /></para>
  <para style="s">Yesʉ ʉkingɨla panyʉmba ang’wi Itunda</para>
  <para style="r">
    <ref loc="MAT 21:12-17">Matayo 21:12-17</ref>; <ref loc="LUK 19:45-48">Lʉka 19:45-48</ref>; <ref loc="JHN 2:13-22">Yohana 2:13-22</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />Itɨ gwa, Yesʉ nɨamanyisigwa akwe akapika kʉ Yelusalemu. Yesʉ akingɨla panyʉmba ang’wi Itunda akatula azunsa antʉ naɨ akʉgʉlya nʉkʉgʉla maintʉ mʉng’wanso. Akaipɨʉla imeza niya akaisa mpia, akapɨʉla matuntu awo naɨakʉgʉlya nkʉnda. <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />Akagilya mʉntʉ wɨhi waleke kʉhola kɨntʉ kɨhi kʉpuma panyʉmba ang’wi Itunda, <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />Sʉnga akaamanyisa kɨna, “Itɨɨ, yandɨkilwe kɨna Itunda ʉlɨɨye, ‘Nyumba ane ɨkɨtangwa nyumba amalompi kʉ antʉ ɨhi?’ Ingɨ ʉnyenye magela ikʉlungu la antu nɨ ii!”<verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />Apolyi nɨakʉlu nɨamanyisi amalagilyo ang’wa Musa naɨ ija itɨ, akatula duma ihala nɨla kʉmʉlimansɨlya. Ingɨ aɨ amogopile, kʉnsoko antʉ ɨhi aɨakʉɨwe ʉmanyisi wakwe.<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />Naɨ yatula mpɨndɨ ʉ Yesʉi nɨamanisigwa akwe akahega mʉkisalɨ nɨkɨkʉlʉ nɨka Yelusalemu.<verse eid="MRK 11:19" /></para>
  <para style="s">Ʉmanyisi nʉwa mʉkʉyʉ nʉ wʉmile</para>
  <para style="r">
    <ref loc="MAT 21:20-22">Matayo 21:20-22</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />Mʉdaʉ akwe naɨ akʉkɨla, akauona ʉmʉkʉyʉ ʉwo wɨhi wʉmile, nɨ mɨli akwe. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />Petelo akakɨmbʉka, akamʉɨla ʉ Yesʉi, “Mʉmanyisi, goza! mʉkʉyʉ ʉwʉ naza ʉʉzumile wʉmaa!”<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />Yesʉ akaatambʉɨla, “Mʉhʉɨɨli Itunda. <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />Kʉmʉɨla ɨtai, mʉntʉ wɨhi anga walʉɨle ʉlʉgʉlʉ ʉlʉ, ‘Hega wigʉmɨle mʉlʉzɨ nʉlʉkʉlʉ,’ waleke kikankanɨa mʉnkolo akwe, ingɨ wahʉɨɨle kɨna nkani yɨhi nʉkʉtambʉla yɨkʉtulɨka, ikani nɨlanso lɨkʉtendeka. <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />Kʉlʉlo kʉmʉɨla, nɨ mʉkʉkʉlya nʉkʉlompa kɨntʉ kɨhi kʉng’wi Itunda, hʉɨɨli kɨna masɨngɨɨlya, aina anyu. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />Nɨ mʉkʉlompa, mʉlekeli mʉntʉ wɨhi nʉmʉgazɨɨye, nʉnyenye mʉkʉlekelwa ɨmagazo anyu nʉ Tata wanyu nʉkole kilunde.” <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />Ingɨ anga ʉnyenye mʉhite kʉalekela antʉ nɨangɨɨza, nʉng’wenso Tata wanyu nʉwa kilunde shanga ʉkʉmʉlekela ʉnyenye ɨmagazo anyu.<note caller="+" style="f"><char style="fr" closed="false">11:26 </char><char style="ft" closed="false">Bibilia ying’wɨ niya kalɨ ngila nkani izi</char></note><verse eid="MRK 11:26" /></para>
  <para style="s">Ikolyo nɨla ʉhumi wang’wa Yesʉ</para>
  <para style="r">
    <ref loc="MAT 21:23-27">Matayo 21:23-27</ref>; <ref loc="LUK 20:1-8">Lʉka 20:1-8</ref></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />Itɨ gwa Yesʉ nɨa amanyisigwa akwe akapika hangɨ kʉ kɨsalɨ ka Yelusalemu. Yesʉ aɨ ʉkʉgenda genda panyʉmba ang’wi Itunda, apolyi nɨakʉlʉ, nɨamanyisi amalagɨɨlyo ang’wa Musa nɨanyampala akamʉhanga, <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />akamʉkolya, “Makani aya nʉitʉmaa mahikʉ ga, witʉmaa kʉʉhumi wang’wa nyenyu?”<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />Yesʉ akaaɨla, “Kʉmukolya ikolyo lɨng’wɨ, anga mʉnsʉkɨɨlye, nʉnene kʉmʉɨla kɨna makani aya kitʉma kʉ ʉhumi wang’wa nyenyu. <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />Itɨɨ, Yohana ʉhumi wakwe nʉwa kʉbadisa, ʉpumile kʉng’wi Itunda ne ang’wɨ kʉ antʉ?”<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />Akandya kitambʉlya ɨenso, “Anga kʉlʉnge, “Ʉhumi nʉwa kʉbadisa aɨ ʉpumile kʉng’wi Itunda,’ ʉkʉʉkolya, ‘Nɨkɨ, shanga aɨ mʉmʉhʉɨɨe?’ <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />Ingɨ anga kʉlʉnge, ‘Ʉpumile kʉ antʉ,’ aapa akʉbɨpɨlwa,” aɨ aogopile kʉnsoko antʉ aɨ ahuɨɨe ɨtai ʉ Yohana kɨna aɨ mʉnyakɨdagu wang’wi Itunda. <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />Itɨ gwa, akamʉsʉkɨɨlya ʉ Yesʉi, “Ʉsese shanga kʉlɨngɨle.”</para>
  <para style="p" vid="MRK 11:33">Nʉ Yesʉi akaaɨla, “Nʉnene ga shanga kʉmʉɨla kɨna, kitʉma makani aya itɨ kʉʉhumi kɨɨ.”<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">Yesʉ ʉkʉimpyania atongeeli a Ayahudi nɨ alɨmi nɨabʉlaagani</para>
  <para style="r">
    <ref loc="MAT 21:33-46">Matayo 21:33-46</ref>; <ref loc="LUK 20:9-19">Lʉka 20:9-19</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />Yesʉ akandya kʉligitya nɨenso kʉmpyani. “Mʉntʉ ʉng’wɨ aɨ ʉlɨmile mʉgʉnda nʉwa mizabibu. Akakita ikito, pakatɨ akahimba ikombo paʉkamɨlo wa zabibʉ, akazenga kɨtala. Akiliha mʉgʉnda nʉwanso kʉ alɨmi, nʉwanso akahega akalongola kihɨɨ akʉli. <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />Matungo a maogola, akamʉlagɨɨlya mʉtʉʉng’wa wakwe kʉalɨmi nɨanso, wende wahole nzepwa nia zabibʉ amʉletele. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />Ingɨ alɨmi nɨanso akamʉamba, akamʉkʉa, akamʉzunsa mɨkono mɨtilɨ. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />Akamʉlagɨɨlya mʉtʉʉng’wa mʉngɨɨza, nʉyo nʉwanso akamʉkʉa ngʉma, akamʉhumya mɨnyala. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />Mʉkola mʉgʉnda nʉwanso akamʉlagɨɨlya mʉtʉʉng’wa mʉngɨɨza alɨmi nɨanso akamʉbʉlaga. Aɨ ʉalagɨɨye atʉʉng’wa angɨɨza ɨdʉ, nɨang’wɨ akakʉwa, nɨang’wi akabʉlagwa. <verse eid="MRK 12:5" /><verse number="6" style="v" sid="MRK 12:6" />Akasaga ʉng’wɨ, naɨ ng’wana wakwe nʉmʉloilwe. Ʉmalɨnkɨɨlyo wakwe nʉyo akamʉlagɨɨlya akalʉnga, ‘Nihʉɨɨe akʉmʉkʉlya nʉkʉmʉkela kʉnsoko ng’waane.’ <verse eid="MRK 12:6" /><verse number="7" style="v" sid="MRK 12:7" />Sʉnga alɨmi nɨanso akitambʉlya, ‘Ʉyʉ yʉyʉ mʉsali nʉwa mʉgʉnda ʉwʉ, kwɨni kʉmʉbʉlage ʉsali wakwe ʉtule witʉ! <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />Kʉlʉlo akamʉamba, akamʉbʉlaga nʉkʉmʉgʉma kʉnzi amʉgʉnda nʉwa mɨzabibʉ.<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />Yesʉ akaakolya “Itɨ gwa, ʉmʉkola mʉgʉnda ʉ kʉtenda ʉlɨ? Ʉzile waabʉlage lʉkʉlʉ alɨmi nɨanso nʉkʉapa mʉgʉnda nʉnso kʉ antʉ angɨɨza. <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />Itɨɨ, shanga mʉsomile inkani yang’wi Itunda?</para>
  <para style="q1" vid="MRK 12:10">‘Igwe nɨlɨhitilwe nɨazengi</para>
  <para style="q2" vid="MRK 12:10">itungo ɨlɨ lasanigwe kʉkɨla magwe ɨhi nɨɨzengela nyʉmba.<verse eid="MRK 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11" />Isekʉlʉ Itunda ng’wenso witʉmile ikani ɨlɨ,</para>
  <para style="q2" vid="MRK 12:11">nɨlyenso laʉkʉɨlwa kʉng’witʉ.”’<verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />Apolyi nɨakʉlʉ, nɨamanyisi amalagilyo ang’wa Musa nɨanyampala aɨ alɨngile ɨmpyani nanso aɨ wao. Akaduma lyoma lakʉmʉamba, ingɨ akatula nʉ woa kʉnsoko amilʉndo waantʉ. Ʉʉgwa, akamʉleka akalongola.<verse eid="MRK 12:12" /></para>
  <para style="s">Kʉpumya kodi kʉng’wa Kaisali</para>
  <para style="r">
    <ref loc="MAT 22:15-22">Matayo 22:15-22</ref>; <ref loc="LUK 20:20-26">Lʉka 20:20-26</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />Itɨ gwa, Apalisayo ang’wɨ nɨahemba ang’wa Helode akalagɨɨligwa amʉambise ʉ Yesʉi kʉ nkani yakwe naɨ wɨtambʉla. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />Akamʉhanga, akamʉɨla, “Mʉmanyisi, kʉlɨngile kɨna ʉewe wɨmʉhʉɨɨli hangɨ wɨtambʉla ɨtai ntilɨ, hangɨ shanga wɨmogopa mʉntʉ wɨhi. Hangɨ ʉkʉlʉ wa mʉntʉ shanga kɨntʉ kʉng’wako, wɨmanyisa ɨtai a nzɨla ang’wi Itunda. Itɨɨ, kʉɨle taine kʉpumya kodi kʉng’wa Kaisali? Kʉmʉlɨpene ang’wɨ kʉleke kʉmʉlɨpa?”<verse eid="MRK 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15" />Ingɨ Yesʉ aɨ ʉlɨngile ʉʉtele wao, akaakolya, “Nɨkɨ mʉkʉngema? Ndeteli mpia nanso nɨmɨone.” <verse eid="MRK 12:15" /><verse number="16" style="v" sid="MRK 12:16" />Akamʉtaɨla mpia nanso. Yesʉ nʉyo akaakolya, “Ikelʉ nɨ lina ɨlɨ lang’wa nyenyu?” Akamʉsʉkɨɨlya, “Wang’wa Kaisali.” <verse eid="MRK 12:16" /><verse number="17" style="v" sid="MRK 12:17" />Itɨ gwa, Yesʉ akaaɨla, “Mʉpi ʉ Kaisali niyang’wa Kaisali, mʉpi Itunda niyang’wi Itunda.”</para>
  <para style="p" vid="MRK 12:17">Akamʉkʉɨlwa nangaluu.<verse eid="MRK 12:17" /></para>
  <para style="s">Yesʉ ʉkʉmanyisa kiʉka</para>
  <para style="r">
    <ref loc="MAT 22:23-33">Matayo 22:23-33</ref>; <ref loc="LUK 20:27-40">Lʉka 20:27-40</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />Sʉnga Asadukayo, antʉ nɨɨlʉnga kɨna tilɨ anga wiʉki aɨ amʉhangile ʉ Yesʉi, akamʉkolya, <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />“Mʉmanyisi, Musa aɨ ʉkʉlagɨɨye itɨɨ, mʉntʉ aga washe nɨshanga ʉtugile ʉng’wana nʉ mʉsʉngʉ wakwe, mʉluna wakwe ʉtakɨwe wamʉhole mʉsʉngʉ nʉwanso nʉshɨɨwe kʉnsoko wamʉtugɨlye mʉluna wakwe ɨana.’ <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />Aɨ akolɨ alʉna mʉpungatɨ. Ʉtangi aɨ ʉtɨnile, akasha aze wakɨlɨ kʉtuga ʉng’wana. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />Mʉluna wakwe nʉwa kabɨɨlɨ akamʉsala mʉsʉngʉ nʉwanso nʉshɨɨwe, nʉyo akasha akaze mʉgila anga ng’wana, aɨitulɨkile ʉʉ kʉ mʉluna nʉwa kataatʉ akasha waze mʉgila anga ng’wana. <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />Awa ɨhi nɨmʉpungatɨ akasha, shanga aɨatugile anga ng’wana. Mpelo akwe nʉmʉsʉngʉ nʉng’wenso akasha. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />Itɨ gwa lʉhikʉ nʉla kiʉkigwa ɨantʉ, itɨɨ, ʉzeetula mʉsʉngʉ wang’wa nyenyu? Antʉ awa ɨhi mʉpungatɨ aɨ amʉtɨnile.”<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />Yesʉ akaatambʉɨla, “Ʉnyenye malɨmɨla kʉnsoko shanga mʉlɨngile Nkani Nza niyang’wi Itunda ang’wɨ ʉʉhumi wakwe. <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />Ɨashi nɨakiʉka shanga akʉtina ang’wɨ kʉtɨnwa, akʉtula anga a malaɨka. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />Ingɨ kiʉka kʉashi, itɨɨ, shanga mʉsomile mbugulu ang’wa Musa nkɨɨli nɨitambʉe kɨhaka naɨ kɨkʉpya moto? Itunda naɨ ʉmʉtambʉɨe ʉ Musa kɨna, ‘Ʉnene ni Itunda wang’wa Abulahamu nʉ Isaki nʉ Yakobo.’ <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />Itɨ gwa nʉwanso ingɨ Itunda waantʉ nɨapanga, shanga Itunda waantʉ nɨakʉle, kʉlʉlo ʉnyenye mʉlimangɨɨe ikʉlʉ.<verse eid="MRK 12:27" /></para>
  <para style="s">Ilagɨɨlyo nikʉlʉ</para>
  <para style="r">
    <ref loc="MAT 22:34-40">Matayo 22:34-40</ref>; <ref loc="LUK 10:25-28">Lʉka 10:25-28</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />Ʉng’wɨ ao mʉamanyisi amalagɨɨlyo ang’wa Musa, akija wikʉngʉmi wang’wa Yesʉ nɨ Asadukayo nɨahemba ang’wa Helode. Naɨwaona asʉkɨigwe iza nʉ Yesʉi, akigeela, akamʉkolya, “Mʉmalagɨɨlyo ang’wa Musa ɨhi ilagɨɨlyo kɨ nikʉlʉ kʉkɨla ɨhi?”<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />Yesʉ akasʉkɨɨlya, ilagɨɨlyo nikʉlʉ sɨlɨ, ‘Tegeelyi ʉnyenye Aisilaeli! Isekʉlʉ, Itunda witʉ, Isekʉlʉ ʉng’wɨ du. <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />Mʉlowe Isekʉlʉ Itunda wako kʉ nkolo ako nʉng’wahʉ wako wɨhi, nɨmahala ako ɨhi ningulu yako yɨhi.’ <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />Ilagɨɨlyo nɨla kabɨɨlɨ sɨlɨ. Mʉlowe ʉmɨako anga nʉiloilwe ʉewe.’ Kʉtilɨ anga malagɨɨlyo nakʉkɨla aya nabɨɨlɨ.”<verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />Mʉmanyisi nʉwa malagɨɨlyo ang’wa Musa nʉwanso akamʉɨla ʉ Yesʉi, “Mʉmanyisi! Ʉtambʉe ɨtai, kʉlʉ kʉʉlʉ Itunda ʉng’wɨ hangɨ kʉtilɨ nʉ mʉngɨɨza ingɨ ʉng’wenso. <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />Mʉlowe Isekʉlʉ Itunda wako kʉ nkolo ako nʉng’wahʉ wako wɨhi, nɨmahala ako ɨhi ningulu yako yɨhi.’ Nʉkʉmʉlowa ʉmɨako anga nʉiloilwe ʉewe.’ Ingɨ ikani iza kʉkɨla kʉmʉpumɨlya Itunda ipolyo nɨ masongelyo.”<verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />Yesʉ naɨwaona mʉntʉ ʉyʉ ʉsʉkɨɨye kʉ mahala akamʉɨla, “Ʉewe wahumbeela kingɨla mʉʉtemi wang’wi Itunda.” Naɨ akɨla nanso kʉtilɨ anga mʉntʉ hangɨ naɨʉgemile kʉmʉkolya ʉ Yesʉi kɨntʉ kɨhi.<verse eid="MRK 12:34" /></para>
  <para style="s">Kilisito ingɨ nyenyu</para>
  <para style="r">
    <ref loc="MAT 22:41-46">Matayo 22:41-46</ref>; <ref loc="LUK 20:41-44">Lʉka 20:41-44</ref></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />Matungo ʉ Yesʉi naɨ ʉkʉmanyisa panyʉmba ang’wi Itunda, akaakolya, “Nɨkɨ amanyisi amalagilyo ang’wa Musa ɨlʉnga ʉ Kilisito ng’wana wang’wa mʉtemi Daudi? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />Daudi naɨ ʉtongeewe nʉ Ng’waʉ Ng’welʉ wɨkalʉnga,</para>
  <para style="q1" vid="MRK 12:36">‘Isekʉlʉ aɨ ʉmʉtambʉɨe Isekʉlʉ wane.</para>
  <para style="q2" vid="MRK 12:36">Ikiɨ ipande lane nɨla kɨgoha, kʉpikɨɨla</para>
  <para style="q2" vid="MRK 12:36">nɨahume alʉgʉ ako ɨhi.’<verse eid="MRK 12:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />“Daudi ʉng’wenso ʉkʉmitanga ʉ Kilisito, Isekʉlʉ wane. Kilisito ʉkʉtʉla ʉlɨ ng’wana wang’wa Daudi?”</para>
  <para style="s" vid="MRK 12:37">Yesʉ ʉkʉahʉgʉlya ɨantʉ ahʉgʉke kʉamanyisi amalagɨɨlyo</para>
  <para style="r" vid="MRK 12:37">
    <ref loc="MAT 23:1-36">Matayo 23:1-36</ref>; <ref loc="LUK 20:45-47">Lʉka 20:45-47</ref></para>
  <para style="p" vid="MRK 12:37">Milʉndo nʉwa antʉ aɨamʉtegeeye ʉ Yesʉi kʉʉlowa.<verse eid="MRK 12:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />Mʉʉmanyisi wakwe, Yesʉ aɨ ʉlɨye, “Hʉgʉki nɨamanyisi amalagɨɨlyo ang’wa Musa nɨɨtugala matugalo nɨmalɨpu nʉkʉlamʉkigwa nɨantʉ kʉʉkʉligwa mʉʉgala galo, <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />ɨlowa kikiɨ matuntu akʉntongeela mʉnyʉmba ya kʉtankanɨla Ayahudi, nʉkʉkʉligwa mʉ maloeelya. <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />Ɨahegelya asʉngʉ nɨashɨɨwe nɨagoha maintʉ kʉnʉ azidaya kɨna akende azelompa malompi malɨpu! Lʉhikʉ nʉla ʉpɨsɨɨlya, akʉpɨsɨɨligwa ikʉlʉ.”<verse eid="MRK 12:40" /></para>
  <para style="s">Mʉsʉngʉ nʉshɨɨwe nʉ mʉgoha nʉpumilye isongelyo niza</para>
  <para style="r">
    <ref loc="LUK 21:1-4">Lʉka 21:1-4</ref></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />Yesʉ aɨ wikiɨ pakʉpɨ kɨseme nɨka kʉpumɨlya ɨmasongelyo naɨ kɨkolɨ pa nyumba ang’wi Itunda. Aɨ ʉaloeye ɨantʉ naɨ akʉpumya impia mʉkɨseme. Agolɨ ɨdʉ aɨapumilye impia yɨdʉ. <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />Papo paapo akaza mʉsʉngʉ nʉshɨɨwe nʉ mʉgoha, akapumya senti ɨbɨɨlɨ. <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />Yesʉ akaitanga amanyisigwa akwe, akaaɨla, “Kʉmʉɨla ɨtai, ʉmʉsʉngʉ ʉyʉ nɨ mʉhimbɨ nʉshɨɨwe nʉ mʉgoha ʉɨkɨe ikʉlʉ mʉkɨseme nɨla kʉpumɨlya masongelyo kʉkɨla nɨangɨza ɨhi. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />Kʉnsoko nɨangɨza ɨhi apumilye kʉpuma mʉlʉsago wansao yao, ingɨ mʉsʉngʉ ʉyʉ mʉʉla wakwe, ʉgʉmɨe yɨhi naza ʉkete, ʉpumilye maintʉ ɨhi nakʉmʉaɨɨlya mʉlikalo lakwe.”<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">Kʉkumʉlwa Nyumba ang’wi Itunda</para>
  <para style="r">
    <ref loc="MAT 24:1-2">Matayo 24:1-2</ref>; <ref loc="LUK 21:5-6">Lʉka 21:5-6</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />Yesʉ naɨ ʉkʉpuma panyʉmba ang’wi Itunda ʉng’wɨ mʉamanyisigwa akwe akamʉɨla, “Mʉmanyisi, kʉɨlwa ɨmagwe aya nɨnyʉmba izi niyinonee!”<verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />Yesʉ akamʉsʉkɨɨlya, “Ʉewe ʉkʉɨwe ɨmagwe nɨnyʉmba izi niizengilwe iza ikʉlʉ? Ingɨ magwe ɨhi nazengilwe shanga akʉsaga aze agelenkanigwe, ɨhi akʉkumʉlwa”<verse eid="MRK 13:2" /></para>
  <para style="s">Mʉloto nʉwa lwago nʉ kagigwa</para>
  <para style="r">
    <ref loc="MAT 24:3-14">Matayo 24:3-14</ref>; <ref loc="LUK 21:7-19">Lʉka 21:7-19</ref></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />Yesʉ naɨ wikiɨ migʉlya mʉlʉgʉlʉ la Mizeituni naɨ wikengee nɨ Nyʉmba ang’wi Itunda, Petelo nʉ Yakobo nʉ Yohana nʉ Andelea aze ing’wene akamʉkolya ʉ Yesʉi, <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />“Kʉɨle makani aya akʉpumɨla nalɨ? Kɨlɨngasɨɨlyo kakwe ntʉni nɨkɨkʉlɨngasa kɨna makani aya ahumbeela kʉtulɨka?”<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />Yesʉ akandya kʉatambʉɨla, “Hʉgʉki mʉleke kʉkongwa nʉ mʉntʉ. <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />Kʉnsoko antʉ ɨdʉ akʉpembya azetʉmɨla lina lane, ɨhi azekongela antʉ kɨna ‘ɨenso aɨna a Masia!’ Antʉ awa akʉalimɨlya antʉ ɨdʉ. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />Anga mije nkani niya ʉlʉgʉ ni ng’ung’u la ʉlʉgʉ, mʉleke kʉkʉɨlwa. Makani nanso akʉpumɨla, ingɨ ɨmpelo ɨkɨlɨ kʉpikɨɨla. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />Antʉ ihɨɨ ɨng’wɨ akikʉa nɨ antʉ ihɨɨ ngɨɨza, antʉ a ʉtemi ʉng’wɨ akikʉa nɨantʉ a ʉtemi ʉngɨɨza ingɨ nkɨka yɨhi yɨkʉtula nɨmɨtentemo nɨ nzala ɨkʉpumɨla. Makani nanso ɨhanga ʉwai nʉwa mʉsʉngʉ nʉkʉhiya kitungʉɨla.<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />“Ʉnyenye hʉgʉki. Kʉnsoko antʉ akʉmʉtwala mʉ maanza, mʉnyʉmba nɨa kʉtankanɨlya Ayahudi. Mʉng’wanso mʉkʉmʉkʉwa. Mʉkʉtwalwa kʉakʉlʉ nʉ kʉ atemi kʉnsoko ane, ingɨ mʉtanantye Nkani Nza kʉng’wao. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />Nkani Nza itakɨwe itanantigwe hanza kʉ antʉ amahɨɨ ɨhi. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />Nɨanso akʉmʉamba nʉkʉmʉtwala mʉmaanza, mʉleke kʉsɨga aya nakʉtambʉla. Itungo nɨlanso anga lɨpike tambʉli yɨhi nɨmʉkʉpegwa, kʉnsoko shanga nyenye mʉkʉligitya ingɨ Ng’waʉ Ng’welʉ. <verse eid="MRK 13:11" /><verse number="12" style="v" sid="MRK 13:12" />Pang’wanso mʉluna ʉkʉmʉpumya ʉmʉluna wakwe wabʉlagwe. Ihe ʉkʉmʉpumya ʉng’wana wakwe wabʉlagwe, ana nɨenso akʉakʉa nʉkʉabʉlaga ɨaleli ao. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />Antʉ ɨhi akʉmʉhʉkɨlwa kʉnsoko mʉntyatile nene. Ingɨ nʉkiʉmɨɨlya kʉpikɨɨla ɨmpelo nʉwanso ʉkʉgʉnɨka.<verse eid="MRK 13:13" /></para>
  <para style="s">Lwago lʉkʉlʉ lʉpembilye</para>
  <para style="r">
    <ref loc="MAT 24:15-28">Matayo 24:15-28</ref>; <ref loc="LUK 21:20-24">Lʉka 21:20-24</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />“Anga maona, ‘Kɨntʉ nɨkɨkʉmʉbipɨla Itunda kɨmolɨ munyʉmba akwe, papo gwa antʉ nɨamolɨ kʉ Yʉdea amankɨɨle mʉ malʉgʉlʉ. Mʉntʉ nʉkʉsoma nʉwalɨnge ɨndogoelyo akwe. <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />Nʉkolɨ kʉnzi a nyʉmba akwe nʉwaleke kingɨla mʉnyʉmba kʉhola maintʉ. <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />Nʉkolɨ kʉmʉgʉnda nʉwaleke kʉtulya kito kʉhola itugalo lakwe. <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />Akaga asʉngʉ nɨalito nawa nɨakonsha mʉlʉhikʉ nʉlanso! <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />Mʉlompi Itunda makani nanso aleke kʉpumɨla mʉmalila. <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />Yʉkʉtula lwago nʉlʉkɨlɨ kigela kandɨɨlya Itunda nʉwatundɨe ʉnkumbigʉlʉ kʉpikɨɨla ɨlelo, shanga lʉziigela hangɨ. <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />Isekʉlʉ anga aɨ waleke kʉkepya ɨmahikʉ nanso aɨ kʉtilɨ anga mʉntʉ naɨ ʉzegunɨka. Ingɨ kʉnsoko ahʉɨɨli akwe naɨ ʉahoile Isekʉlʉ ʉzɨɨzakepya mahikʉ nanso.<verse eid="MRK 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21" />“Mʉmahikʉ nanso mʉntʉ anga wamʉɨle, ‘Goza, Kilisito ʉmolɨ apa,’ ang’wɨ ‘ʉkolɨ apo,’ mʉleke kʉhʉɨɨla. <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />Kʉnsoko wɨkiambya anyakɨdagʉ aʉtele nɨantʉ nɨitee ‘Ʉnene nɨ Kilisito!’ Ɨkitʉma ɨlɨngasɨɨlyo nɨmaʉkʉɨlwa, kʉnsoko anga iyʉke akʉalimangɨɨlya ɨahʉɨɨli ang’wi Itunda. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />Ingɨ ʉnyenye hʉgʉki. Ʉnene namʉtambʉɨla makani ɨhi nwɨkiambya.<verse eid="MRK 13:23" /></para>
  <para style="s">Ng’waa Mʉntʉ ʉpembilye</para>
  <para style="r">
    <ref loc="MAT 24:29-31">Matayo 24:29-31</ref>; <ref loc="LUK 21:25-28">Lʉka 21:25-28</ref></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />Mʉmahikʉ nanso, lwago nʉlanso anga lahila, lyoa lɨkʉtula kiti nʉ ng’weli shanga ʉkelya. <verse eid="MRK 13:24" /><verse number="25" style="v" sid="MRK 13:25" />Nzota yʉkʉgwa kʉpuma migʉlya, nɨ maintʉ maʉya na kilunde akʉhingisigwa. <verse eid="MRK 13:25" /><verse number="26" style="v" sid="MRK 13:26" />Papo gwa antʉ akʉmona ʉnene Ng’waa Mʉntʉ mpembilye nɨ malunde kʉngulu yɨdʉ nʉ ʉkʉlʉ. <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />Sʉnga kʉalagɨɨlya amalaɨka anɨɨle ɨahʉɨɨli akwe nkɨka yɨhi mʉʉnkumbigʉlʉ, kʉpuma mpelo ihɨɨ kʉpikɨɨla mpelo igʉlʉ.<verse eid="MRK 13:27" /></para>
  <para style="s">Ʉmanyisi nʉwa mʉkʉyʉ</para>
  <para style="r">
    <ref loc="MAT 24:32-35">Matayo 24:32-35</ref>; <ref loc="LUK 21:29-33">Lʉka 21:29-33</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />Imanyisi ikani ɨlɨ kʉ mpyani a mʉkʉyʉ. Matʉtʉ akwe anga andye kʉtegeta, mʉlɨngile kɨna matungo a hongola ahumbeela. <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />Nʉnyenye ga anga maona makani aya ɨhi nɨnʉmʉtambʉɨe ainiigela, mʉlɨnge kɨna ʉnene Ng’waa Mʉntʉ naakapembya. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />Kʉmʉtambʉɨla ɨkʉlʉ kʉʉlʉ antʉ awileli ʉwʉ shanga akʉtagɨka ɨhi makani aya ɨhi aze akɨlɨ kigela. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />Igʉlʉ ni ihɨɨ yʉkʉkɨla, ingɨ nkani yane shanga yʉkʉkɨla.<verse eid="MRK 13:31" /></para>
  <para style="s">Kʉtilɨ nʉine ʉlʉhikʉ ang’wɨ saa</para>
  <para style="r">
    <ref loc="MAT 24:36-44">Matayo 24:36-44</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />“Ingɨ, kʉtilɨ anga mʉntʉ nʉlɨngile lʉhikʉ nʉlanso ang’wɨ saa nanso kʉtilɨ, amalaɨka ang’wɨ ʉnene Ng’wana wang’wi Itunda, ingɨ ʉ Tata du nʉlɨngile. <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />Ingɨ hʉgʉki ihambi kɨsa, kʉnsoko shanga mʉlɨngile matungo ampelo akʉtula nalɨ. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />Yʉkʉtula anga mʉntʉ nʉhegile kitolakwe wende ʉmʉhinzo waalekele ʉhumi atʉʉng’wa a mitolakwe kɨla mʉntʉ nʉ mʉlɨmo wakwe, akamʉɨla mʉsʉnja mʉmpita waleke kʉhung’wa tʉlo. <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" />Leki kʉhung’wi tʉlo kʉnsoko shanga mʉlɨngile mʉkola nyʉmba ʉzile nalɨ, mpɨndɨ ang’wɨ ʉtikʉ wigɨngʉ ang’wɨ maniambwa ang’wɨ kɨdaʉdaʉ. <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />Leki kʉhung’wi tʉlo kʉnsoko anga wamʉpumpugɨɨlye mʉleke kʉhangwa mʉlae. <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />Ikɨ nɨkʉmʉɨla ʉnyenye, ingɨ kʉaɨla antʉ ɨhi, leki kʉhung’wi tʉlo!”<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">Masigo akʉmʉbʉlaga ʉ Yesʉi</para>
  <para style="r">
    <ref loc="MAT 26:1-5">Matayo 26:1-5</ref>; <ref loc="LUK 22:1-2">Lʉka 22:1-2</ref>; <ref loc="JHN 11:45-53">Yohana 11:45-53</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />Aɨasaga mahikʉ abɨɨlɨ kʉpikɨɨla lʉhikʉ nʉla pasaka, nɨmɨkate nɨshanga ɨgahɨigwe. Apolyi nɨakʉlʉ nɨamanyisi amalagɨɨlyo aɨ akʉduma ihala nɨla kipihɨɨlya amʉambe nʉkʉmʉbʉlaga ʉ Yesʉi. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />Akalʉnga, “Kʉleke kʉmʉamba matungo niloelya nɨla pasaka, kʉnsoko antʉ ahumile kʉʉgaɨla.”<verse eid="MRK 14:2" /></para>
  <para style="s">Mʉsʉngʉ ʉkʉmʉpaka Yesʉ makʉta</para>
  <para style="r">
    <ref loc="MAT 26:6-13">Matayo 26:6-13</ref>; <ref loc="JHN 12:1-8">Yohana 12:1-8</ref></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />Yesʉ naɨ ʉmolɨ kʉ Betanɨa, mʉnyʉmba ang’wa Simoni naɨ mʉnyambili. Naɨ ʉkʉlya mʉsʉngʉ ʉng’wɨ akaza nɨkɨhongolo kɨkete makʉta akʉnyunkɨɨla iza ansaɨlo dʉ, akakunʉkʉla ɨkɨhongolo nɨkanso akadubunkɨlya makʉta nanso mitwe lang’wa Yesʉ. <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />Antʉ ang’wɨ naɨakolɨ pang’wanso akatakɨnkana, akitambʉlya, “Nɨkɨ kʉlimɨlya nakanda makʉta aya nakʉnyunkɨɨla? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />Aza ahumile kʉgʉligwa kʉ nsaɨlo nɨnkʉlʉ, mpia niyanso apegwe aʉla.? Sʉnga akamʉkenela mʉsʉngʉ nʉwanso!”<verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />Ingɨ Yesʉ akaaɨla, “Mʉleki, nɨkɨ mʉkʉmʉnyoma? Ʉntendee ikani ɨlɨ iza. <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />Aʉla mɨpalʉng’wɨ mahikʉ ɨhi, mʉhumile kʉaaɨɨlya anga nɨmʉloewe. Ingɨ ʉnene shanga ɨzekolɨ nʉnyenye mahikʉ ɨhi. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />Nʉwanso witʉmile anga nʉhumile, waʉdubunkɨɨlya ʉmʉɨlɨ wane makʉta akʉnyunkɨɨla kʉ ʉnoneelya kʉɨkwa. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />Kʉmʉɨla ɨtai, mʉʉnkumbigʉlʉ wɨhi mʉyɨkʉtanantigwa Nkani Nza, ikani ɨlɨ nɨlitʉmilwe lɨkʉtambʉlwa kʉmʉkɨmbʉka nʉwanso.”<verse eid="MRK 14:9" /></para>
  <para style="s">Yʉda ʉkʉgomba kʉmʉsʉɨpa ʉ Yesʉi</para>
  <para style="r">
    <ref loc="MAT 26:14-16">Matayo 26:14-16</ref>; <ref loc="LUK 22:3-6">Lʉka 22:3-6</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />Sʉnga Yʉda mʉnya kʉ Isikalioti, ʉng’wɨ mʉamanyisigwa nikʉmi naabɨɨlɨ, aɨwendile kʉmʉsuɨpa ʉ Yesʉi kʉ apolyi nɨakʉlʉ <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />Apolyi nɨakʉlʉ naɨatambʉɨlwa nkani nɨanso, akalowa, akamʉɨla akʉmʉpa mpia. Ʉʉgwa, Yʉda akatula duma lyoma nɨla kʉmʉsuɨpa Yesʉ.<verse eid="MRK 14:11" /></para>
  <para style="s">Yesʉ ʉkʉlya lʉdya nʉla Pasaka nɨamanyisigwa akwe</para>
  <para style="r">
    <ref loc="MAT 26:17-25">Matayo 26:17-25</ref>; <ref loc="LUK 22:7-14">Lʉka 22:7-14</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Yohana 13:21-30</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />Lʉhikʉ nʉla ng’wandyo nʉla iloeelya nɨla mɨkate nɨshanga ɨgahɨɨye, matungo nʉng’waa nkolo nʉɨsɨnzwa, amanyisigwa akwe akamʉkolya, “Itɨɨ, ʉloilwe kʉkʉnoneelelye pɨ lʉdya nʉla Pasaka?”<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />Yesʉ akalagɨlya amanyisigwa akwe abɨɨlɨ akaaɨla, “Longoli kʉkɨsalɨ nɨkikʉlʉ, kʉng’wanso mʉkʉtankana nʉmitunja ʉng’wɨ ʉkenkile ntʉnda amazi. Mʉtyati, <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />kʉpikɨɨla nyʉmba nʉʉkingɨla, mende mʉmʉkolye ʉmʉkola nyumba, Mʉmanyisi ʉkʉkolya. ‘Inɨndo ane ɨkolɨ pɨ nɨkʉlɨla ɨ pasaka nɨamanyisigwa ane?’ <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />Nʉyo ʉkʉmʉlagɨɨla nɨndo nkʉlʉ a migʉlya nɨnoneeigwe nʉkʉpambɨlwa, mʉkʉnoneelya mʉmo.”<verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />Amanyisigwa akalongola kʉkɨsalɨ nɨkɨkʉlʉ, akahanga maintʉ ɨhi anga ʉ Yesʉi naɨʉatambʉɨe, akanoneelya lʉndya nʉla pasaka.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />Naɨyatula mpɨndɨ, Yesʉ palʉng’wɨ nɨ amanyisigwa akwe ikʉmi na abɨɨlɨ akapika mʉ nyumba nanso. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />Naɨ akʉlya, Yesʉ akalʉnga, “Kʉmʉɨla ɨtai, ʉng’wɨ mʉng’wanyu ʉkʉlɨzania nʉnene, ʉkʉnsuɨpa.”<verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />Papo gwa amanyisigwa akwe akatula nʉkɨa, akatula mʉkolya ʉng’wɨ ʉng’wɨ, “Itɨɨ, nene kʉʉsuɨpa?”<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />Yesʉ akaaɨla, “Ingɨ ʉng’wɨ wanyu nɨ mikʉmi na abɨɨlɨ, nʉkʉlɨɨlya ntonge palʉng’wɨ nʉnene, nʉwanso yʉyo mʉsuɨpi. <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />Tai ʉnene Ng’waa Mʉntʉ kʉsha anga Nkani Nza nɨyandɨkilwe, ingɨ, ʉkaga mʉntʉ ʉyʉ nʉkʉnsuɨpa ʉnene Ng’waa Mʉntʉ! Bahu mʉntʉ nʉwanso aɨwaleke nʉkʉtugwa.”<verse eid="MRK 14:21" /></para>
  <para style="s">Lʉdya lang’wi Isekʉlʉ</para>
  <para style="r">
    <ref loc="MAT 26:26-30">Matayo 26:26-30</ref>; <ref loc="LUK 22:14-20">Lʉka 22:14-20</ref>; <ref loc="1CO 11:23-25">1 Akolinto 11:23-25</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />Naɨ akʉlya, Yesʉ akahola mʉkate, akalompa, akaʉega akaapa amanyisigwa akwe akalʉnga, “Holi mʉlye, ʉwʉ ingɨ mʉɨlɨ wane.”<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />Hangɨ akahola kɨkombe ka dibai, akamʉlompa Itunda, akaapa, ɨhi akang’wela kɨkombe nɨkanso. <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />Akaaɨla, “Iyi ingɨ sakami ane nɨkʉkamɨnkɨɨlya ilago lang’wi Itunda nɨ antʉ, sakami nɨkʉhunʉka kʉnsoko antʉ ɨdʉ. <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />Kʉmʉɨla ɨtai, shanga kʉng’wa hangɨ ɨdibai kʉpikɨɨla lʉhikʉ ʉlo nɨ nɨkamɨng’wa nɨ mapya mʉʉtemi wang’wi Itunda.”<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />Sʉnga akɨmba lyɨmbo nɨla kʉmʉkʉlya Itunda. Naɨ amala kɨmba akahega akalongola mʉlʉgʉlʉ nʉla Mizeituni.<verse eid="MRK 14:26" /></para>
  <para style="s">Yesʉ ʉkʉhola mʉloto kɨna Petelo ʉkʉmʉhita</para>
  <para style="r">
    <ref loc="MAT 26:31-35">Matayo 26:31-35</ref>; <ref loc="LUK 22:31-34">Lʉka 22:31-34</ref>; <ref loc="JHN 13:36-38">Yohana 13:36-38</ref></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />Naɨ akolɨ mʉnzɨla Yesʉ akaatambʉɨla amanyisigwa akwe, “Ʉnyenye mɨhi mʉkʉmanka nʉkʉndeka, anga niyandɨkilwe mʉ nkani ninza niyang’wi Itunda, Itunda aɨʉtambʉe.</para>
  <para style="q1" vid="MRK 14:27">‘Kʉmʉkʉa mʉdɨmi nkolo yɨkʉsambaɨla.’<verse eid="MRK 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 14:28" />Ingɨ anga niʉke kʉmʉtongeela kʉ Galilaya.”<verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />Itɨ gwa ʉ Petelo akamʉɨla, “Anga ɨze antʉ ɨhi awa akʉmanka nʉkʉʉleka, kwee ʉnene shanga kʉʉleka.<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />Yesʉ akamʉɨla, “Kʉɨla ɨtai, ʉtikʉ ʉwʉ nʉwa lelo, nsambalʉme nʉwakɨlɨ kʉkʉnkʉla nkʉa kabɨɨlɨ, ʉkʉtula wa nihita kataatʉ.”<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />Ingɨ Petelo akakomangɨɨla, anga itule kʉsha nʉewe, shanga kʉʉleka.”</para>
  <para style="p" vid="MRK 14:31">Amanyisigwa ɨhi akalʉnga ʉʉ.<verse eid="MRK 14:31" /></para>
  <para style="s">Yesʉ ʉkʉmʉlompa Itunda mʉkɨbuulya ka Getisemane</para>
  <para style="r">
    <ref loc="MAT 26:35-46">Matayo 26:35-46</ref>; <ref loc="LUK 22:39-46">Lʉka 22:39-46</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />Ʉʉgwa, akapika nkɨka nitangwa Getisemane, Yesʉ akaaɨla amanyisigwa akwe, “Ikii papa leki ʉnene nende mʉlompa Itunda.” <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />Sʉnga akaahola ʉ Petelo nʉ Yakobo nʉ Yohana akalongolania kʉlɨ iniino, akandya kʉaalɨɨka mʉnkolo nʉkaga ikʉlʉ. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />Akaaɨla, “Kʉaalɨka ikʉlʉ mʉnkolo ɨhiya kʉsha. Ikii hapa leki kʉhung’wi ʉtʉlo.”<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />Yesʉ akalongola kʉntongeela iniino, akigʉma akagwa ʉundaala, akalompa kɨna, ‘Anga ize ihumikile, ndeke kʉkɨɨla itungo ɨlɨ nɨla lwago.’ <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />Akalompa, “Tata wane, kʉng’wako ɨhi ahumɨkile. Ʉnihegelye kɨkombe ɨkɨ nɨka lwago, ingɨ ileke kʉtula anga nɨndoilwe ʉnene, itule anga nʉloilwe ʉewe.”<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />Sʉnga akatulya kʉamanyisigwa ao nɨatatʉ, akaahanga ahung’waa tʉlo, akamʉkolya ʉ Simoni nʉitangwa Petelo, “Simoni itii, walala tʉlone? Shanga ʉhumile kʉleka kʉlala tʉlo saa ɨng’wɨ?” <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />Sʉnga akaaɨla, “Leki kʉhung’wi tʉlo hangɨ mʉlompe ingɨ mʉleke kʉgeng’wa kitʉma ʉbɨ. Ʉnyenye mʉloilwe kʉgeng’wa, mɨɨlɨ anyu mɨgila anga ngulu.”<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />Yesʉ akalongola hangi kʉmʉlompa Itunda, akasʉkɨɨla malompi yayo yaayo nang’wandyo. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />Sʉnga akatulya hangɨ akahanga alala tʉlo mʉlito. Akaleng’wa kʉmʉsʉkɨɨlya.<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />Naɨ ʉahangile nkʉa akataatʉ akaaɨla, “Mʉkɨlɨ mʉlae nʉkʉsupya? Itungo ɨlɨ yakonda! Ʉki itungo lapika! Ʉnene Ng’waa Mʉntʉ kʉambwa nʉ kʉkagɨɨlwa kʉ anyamɨlandʉ. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />Imɨki, kwɨndi, mʉntʉ ʉyo nʉkʉnsuɨpa wahumbeela.”<verse eid="MRK 14:42" /></para>
  <para style="s">Yesʉ ʉkʉambwa</para>
  <para style="r">
    <ref loc="MAT 26:47-56">Matayo 26:47-56</ref>; <ref loc="LUK 22:47-53">Lʉka 22:47-53</ref>; <ref loc="JHN 18:3-12">Yohana 18:3-12</ref></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />Yesʉ naɨ wakɨlɨ ʉkʉligitya, akapika Yʉda ʉng’wɨ mʉ amanyisigwa ikʉmi na abɨɨlɨ akapika. akapika palʉng’wɨ niʉmbɨ nɨla antʉ naɨakete yɨgɨ ni idunkuli. Antʉ nɨanso aɨ alagɨɨgwe niʉmbɨ nɨla apolyi nɨakʉlʉ nɨamanyisi amalagɨɨlyo ang’wa Musa nɨanyampala. <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />Ʉʉgwa Yʉda mʉsuɨpi aɨ ʉang’enyee kɨna, “Ʉyo nɨkʉmʉlʉngɨla ize yʉyo mʉambi, mʉambi mʉmʉtwale ɨze mʉmʉkendegee.”<verse eid="MRK 14:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45" />Ʉʉgwa Yʉda naɨ ʉpikile, akamʉloela ʉ Yesʉi, akamʉlamʉsha, “Mʉmanyisi!” Akamʉlʉngɨla. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />Itɨ gwa, antʉ nɨanso akamʉamba ʉ Yesʉi akamʉtunga. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />Ʉng’wɨ wao awa naɨimɨkile palʉng’wɨ nʉ Yesʉi, akahopoola nyalahanda akwe, akamʉtemelya kʉtwɨ mʉtʉʉng’wa nʉwa mʉpolyi nʉmʉkʉlʉ. <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />Yesʉ akaaɨla, “Itɨɨ, mʉpembilye ni yɨgɨ kʉmamba ʉnene anga nɨ mii? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />Mahikʉ ɨhi aɨ nɨmanyisa panyʉmba ang’wi Itunda, shanga aɨ mɨmamba. Ingɨ aya ɨhi atulɨkile ingɨ Ʉandɨkwa nʉ Ʉza ʉkondanɨle.”<verse eid="MRK 14:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50" />Papo paapo amanyisigwa akwe ɨhi akamʉleka, akamanka.<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />Aɨ ʉkolɨ mʉhumba ʉng’wɨ aɨ wikumbile minkʉmbɨ aɨ ʉmʉlondoe Yesʉ. Nʉng’wenso akahiya kʉmuamba. <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />Mʉhumba nʉwanso akaapʉlʉpʉtya, akatigana, akaalekela minkʉmbɨ, akamanka kimpʉnyu.<verse eid="MRK 14:52" /></para>
  <para style="s">Yesʉ pantongeela ianza</para>
  <para style="r">
    <ref loc="MAT 26:57-68">Matayo 26:57-68</ref>; <ref loc="LUK 22:54-55">Lʉka 22:54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Yohana 18:13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref></para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />Itɨ gwa, akamʉtwala ʉ Yesʉi mʉ nyʉmba a Mʉpolyi nʉ mʉkʉlʉ papo gwa apolyi niakʉlʉ nɨanyampala nɨamanyisi amalagɨɨlyo ang’wa Musa akamikaɨla ianza. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />Petelo akamʉlondoola ʉ Yesʉi, akingɨla mitando la mʉpolyi nʉ mʉkʉlʉ, akikiɨ palʉng’wɨ nɨalili akaze ota moto. <verse eid="MRK 14:54" /><verse number="55" style="v" sid="MRK 14:55" />Apolyi nɨakʉlʉ nɨianza lɨhi akaduma ʉkʉɨɨli nʉwa kʉmʉsemela ʉ Yesʉi amʉbʉlage, ingɨ shanga akapata. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />Antʉ ɨdʉ aɨ akʉɨɨe ʉtele kʉng’wa Yesʉ, ingɨ ʉkʉɨli wao shanga ʉkimpyana.<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />Sʉnga antʉ nɨang’wɨ akimɨka hangɨ, azetambʉla ʉkʉɨɨli nʉwa ʉtele azelʉnga, <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />“Aɨ kʉmigulye mʉntʉ ʉyʉ wazelʉnga, ‘Kʉmɨkumʉla Nyumba ɨyɨ nang’wi Itunda naɨzengilwe nɨantʉ, hangɨ kʉ mahikʉ ataatʉ kʉmɨzenga ngɨɨza nɨshanga ɨkʉzengwa nɨantʉ.”’ <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />Ingɨ nɨitɨ ga ʉkʉɨɨli wao shanga ʉkimpyana.<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />Itɨ gwa, mʉpolyi nʉmʉkʉlʉ akimɨka pakatɨ ao, akamʉkolya ʉ Yesʉi, “Itɨɨ, shanga ʉkʉsʉkɨlya anga lʉkanine? Itɨɨ shanga wigulye antʉ awa ɨhi akʉpumya ʉkʉɨɨli nʉwa kʉʉsemela ʉewe”<verse eid="MRK 14:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="MRK 14:61" />Yesʉ akakilaga ihɨtwɨɨ, shanga akaligitya lʉkani lɨhi. Mʉpolyi nʉ mʉkʉlʉ akamʉkolya hangɨ, “Itɨɨ, ʉewe wɨ Kilisito, Ng’wana wang’wi Itunda nʉkembetilwe?”<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />Yesʉ akasʉkɨɨlya, “Ee, yʉ nene. Mʉkʉmona hangɨ, ʉnene Ng’waa Mʉntʉ nikiɨ ipande nɨla ʉkʉlʉ nɨ lang’wi Isekʉlʉ Mʉnya Ngulu, mpembilye nɨmalunde a kigʉlʉ.”<verse eid="MRK 14:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />Papo paapo mʉpolyo nʉ mʉkʉlʉ akatamʉla mʉjʉlʉngʉ wakwe nikuo, akalʉnga, “Kʉʉpenza ʉkʉɨɨli kɨɨ hangɨ? <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />Ʉnyenye mijaa nʉkʉmʉmbehʉla Itunda! Mʉkʉona ʉlɨ ʉnyenye?”</para>
  <para style="p" vid="MRK 14:64">Ianza lɨhi lɨkalamʉla kɨna ʉtakɨwe kʉbʉlagwa.<verse eid="MRK 14:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65" />Itɨ gwa, antʉ ang’wɨ akatula mʉtyɨla matɨ ʉ Yesʉi, akamʉtunga mʉkako mʉ miho, akamʉkʉa nʉkʉmʉkolya, “Kʉtele nyenyu nʉkʉkʉile! “Sʉnga nɨamboi akamʉkʉa makopi.”<verse eid="MRK 14:65" /></para>
  <para style="s">Petelo ʉkʉmʉhita ʉ Yesʉi</para>
  <para style="r">
    <ref loc="MAT 26:69-75">Matayo 26:69-75</ref>; <ref loc="LUK 22:56-62">Lʉka 22:56-62</ref>; <ref loc="JHN 18:15-18">Yohana 18:15-18-25-27</ref></para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />Petelo naɨ wakɨlɨ ʉkolɨ mitando, wakɨza mitʉmi ʉng’wɨ nʉwa kɨsʉngʉ nʉwa mʉpolyi nʉ mʉkʉlʉ . <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />Naɨ wamʉona ʉ Petelo ʉkota moto, akamʉgondoola, akamʉɨla, “Nʉewe ga aza mɨpalʉng’wɨ nʉ Yesʉi Mʉnya kʉ Nazaleti.”<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />Ingɨ ʉ Petelo akahita, “Shanga nʉmʉmanyile hangɨ shanga nɨngile nʉʉkʉkɨligitya.” Sʉnga ʉ Petelo akahega akapʉma kʉnzi itando. Papo paapo nsambalume ɨkakʉnkʉla.<verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />Mitʉmi nʉwanso naɨʉmʉine hangɨ ʉ Petelo nkɨka nanso, akatula atambʉɨla ɨantʉ naɨ ɨmikile pang’wanso, “Mʉntʉ ʉyʉ ingɨ wɨpalʉng’wɨ nɨenso.” <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />Ingɨ Petelo akahita hangɨ.</para>
  <para style="p" vid="MRK 14:70">Itungo iniino, antʉ naɨɨmikile pang’wanso akamʉhanga, akamʉɨla ʉ Petelo, “Kʉlʉ kʉʉlʉ ʉewe mɨpalʉng’wɨ, kʉnsoko ʉewe wɨ mʉnya kʉ Galilaya.”<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />Ingɨ ʉ Petelo akatula lapa nʉkizuma wazelʉnga, “Ʉnene shanga nʉmʉlingile ʉmʉntʉ ʉyʉ nɨmʉkʉligitya inkani yakwe.”<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />Papo paapo nsambalume ɨkakʉnkʉla nkʉa a kabɨɨlɨ. Itɨ gwa, Petelo akakɨmbuka ʉ Yesʉi naɨʉmʉɨɨe. Nsambalume nɨze ɨkɨlɨ kʉkʉnkʉla nkʉa aka bɨɨlɨ, ʉkʉnihita nkʉa itaatʉ. “Petelo akatula lɨla.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">Yesʉ ʉtwawe pantongeela ang’wa Pilato</para>
  <para style="r">
    <ref loc="MAT 27:1-2">Matayo 27:1-2</ref>; <ref loc="MAT 11:14">11:14</ref>; <ref loc="LUK 23:1-5">Lʉka 23:1-5</ref>; <ref loc="JHN 18:28-38">Yohana 18:28-38</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />Naɨ weleela, Apolyi nɨakʉlʉ nɨanyampala nɨamanyisi amalagɨɨlyo ang’wa Musa, ianza ɨlɨ lɨhi akigombya kʉmʉtunga ʉ Yesʉi, akamʉtwala kʉngwa Pilato, mʉtongeeli nʉpembeeye kʉ Lumi. <verse eid="MRK 15:1" /><verse number="2" style="v" sid="MRK 15:2" />Pilato akamʉkolya ʉ Yesʉi, “Itɨɨ, ʉewe wɨ mʉtemi Nʉ Ayahudi?”</para>
  <para style="p" vid="MRK 15:2">Yesʉ akasʉkɨɨlya, “Eee, anga ʉewe nʉtambʉe.”<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />Apolyi nɨakʉlʉ akamʉsemela ʉ Yesʉi makani ɨdʉ. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />Sʉnga Pilato akamʉkolya hangɨ ʉ Yesʉi, “Itɨɨ, nɨkɨ shanga ʉkʉsʉkɨɨlya anga lʉkani? Kolwa antʉ akʉʉsemela makani ɨdʉ itɨ.”<verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />Ingɨ Yesʉ shanga akasʉkɨɨlya, Pilato akakʉɨlwa.<verse eid="MRK 15:5" /></para>
  <para style="s">Yesʉ ʉkʉpɨsɨɨligwa kʉbʉlagwa</para>
  <para style="r">
    <ref loc="MAT 27:15-26">Matayo 27:15-26</ref>; <ref loc="LUK 23:13-25">Lʉka 23:13-25</ref>; <ref loc="JHN 18:39">Yohana 18:39</ref>; <ref loc="JHN 19:16">19:16</ref></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />Matungo iloeelya la Pasaka, Pilato aɨ wizɨɨe kʉmʉtungʉɨla mʉtungwa ʉng’wɨ antʉ nɨamʉloilwe. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />Itɨ gwa, aɨʉkolɨ mʉntʉ ʉng’wɨ lina lakwe aɨ Balaba, aɨʉtungilwe palʉng’wɨ atungwa angɨɨza kʉnsoko aʉpɨlʉki nʉ ʉbʉlagi nʉwa antʉ mʉminyomo. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />Antʉ ɨdʉ akalongola kʉng’wa Pilato waatendeele anga ɨntendo akwe. <verse eid="MRK 15:8" /><verse number="9" style="v" sid="MRK 15:9" />Pilato akaakolya, “Itɨɨ, mʉloilwe nʉmʉlekele Mʉtemi nʉwa Ayahudi?” <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />Pilato aɨ ʉtambʉe itɨ kʉnsoko aɨ ʉlɨngɨle kɨhenga kɨna Apolyi nɨakʉlʉ aɨamʉtwae ʉ Yesʉi kʉng’wakwe kʉnsoko awɨlu.<verse eid="MRK 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11" />Ingɨ Apolyi nɨakʉlʉ aɨ aapemile ɨantʉ amʉlompe Pilato wamʉlekele ʉ Balaba kimɨkɨɨli kang’wa Yesʉ. <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />Pilato akaakolya hangɨ, “Itɨ gwa, itungo ɨlɨ mʉloilwe nʉmʉtende ʉlɨ mʉntʉ ʉyʉ nɨmʉkʉmitanga Mʉtemi nʉ Ayahudi?”<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />Antʉ ɨhi akitʉnta hangɨ “Mʉkononteele mʉ mʉsalaba!”<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />Pilato akaakolya, “Itɨɨ! Ʉgazile ntʉni?” Ingɨ nɨanso akalongoleka kintʉnta, “Mʉkononteele mʉ mʉsalaba!”<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />Pilato aɨ ʉloilwe waliloeelye ilʉndo nɨla antʉ, ʉʉgwa, akamʉlekela ʉ Balaba kʉpuma mʉkadulumu. Sunga akalagɨɨlya Yesʉ wakʉwe misheleti, nʉkʉmʉkononteela mʉ mʉsalaba.<verse eid="MRK 15:15" /></para>
  <para style="s">Amboi akʉmʉdalaha ʉ Yesʉi</para>
  <para style="r">
    <ref loc="MAT 27:27">Matayo 27:27</ref>; <ref loc="JHN 19:2-3">Yohana 19:2-3</ref></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />Sʉnga amboi akamʉhola ʉ Yesʉi akamʉtwala kʉ nyʉmba ang’wa Pilato, nyumba nanso itangwa Paitolio. Mʉng’wanso akatankana niʉmbɨ lɨhi nɨla amboi. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />Akamʉtugala itugalo nɨla kɨtemi, akanonia ngala amija, akamʉtugalya ʉ Yesʉi kitwe. <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />Akatula mʉlamʉsha azemʉona ʉpʉngʉ, “Ʉlɨ adɨ Mʉtemi nʉwa Ayahudi!” <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />Akamʉkʉa mɨlanga mitwe, akamʉtyɨla matɨ, akatugama nʉ kʉmʉkʉlya azemʉdalaha. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />Naɨ akondya kʉmʉona ʉpʉngʉ, akamʉtugʉla itugalo ɨlo nɨla kɨtemi, akamʉtugala matugalo akwe, akamʉtwala kʉmʉkononteela mʉ mʉsalaba.<verse eid="MRK 15:20" /></para>
  <para style="s">Yesʉ ʉkʉkonenteelwa mʉ mʉsalaba</para>
  <para style="r">
    <ref loc="MAT 27:32-44">Matayo 27:32-44</ref>; <ref loc="LUK 23:26-43">Lʉka 23:26-43</ref>; <ref loc="JHN 19:17-27">Yohana 19:17-27</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />Mʉnzila, aɨatankanile nʉ mʉntʉ ʉng’wɨ ɨlina lakwe Simoni, mʉnya kʉ Kʉlene. Nʉwanso aɨ ihe waa Alekisanda nʉ Lupo, matungo nanso aɨʉpumɨɨe kʉmʉgʉnda ʉkingɨla mʉkisalɨ. Itɨ gwa, amboi akamʉsinja waʉkenke mʉsalaba ang’wa Yesʉ. <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />Sʉnga akamʉtwala ʉ Yesʉi kʉ nkɨka nitangwa Goligota, ndogoelyo akwe, ing’ang’a litwe <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />Akamʉpa Yesʉ dibai nihangigwe nʉ ʉgota nʉitangwa manemane, nʉwanso akahita kʉng’wa. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />Itɨ gwa, akamʉkononteela mʉ mʉsalaba, akagalana matugalo akwe kʉ bʉnkʉlʉ bʉnkʉlʉ alamʉle nyenyu ʉkʉlija ntʉni. <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />Aɨ anga saa tatʉ kɨdaʉ daʉ naɨ amʉkonontee ʉ Yesʉi mʉ mʉsalaba. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />Mʉmʉsalaba aɨ andɨkile igazo lakwe itɨ, “Mʉtemi nʉwa Ayahudi.” <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />Sʉnga agazi abɨɨlɨ aɨ akononteewe mʉ mɨsalaba palʉng’wɨ Yesʉ, ʉmʉya ipande lakwe nʉla kɨgoha nʉmʉya ipande lakwe nʉla nkɨgɨ. <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />Papo gwa ʉkakondanɨla ʉandɨkwa wang’wi Itunda nʉʉtambʉe kɨna, “Aɨ ʉaɨʉɨkilwe palʉng’wɨ nɨ ii.”<note caller="+" style="f"><char style="fr" closed="false">15:28 </char><char style="ft" closed="false">Bibilia niyakalɨ ngila nkani izi nia lʉkɨɨlɨ nula 28</char></note><verse eid="MRK 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29" />Antʉ naɨ akʉkɨɨla pang’wanso akamʉtʉkɨla, aze ahumilwe ikuo akamʉɨla, “Ee gwa! Ʉewe nʉhumile kʉkumʉla nʉkʉzenga ɨ Nyʉmba ang’wi Itunda kʉ mahikʉ ataatʉ! <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />Itungo ɨlɨ, ikomole ʉewe, ʉsima mʉmʉsalaba!”<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />Anga ɨantʉ naɨ akʉmʉdalaha, Apolyi nɨakʉlʉ palʉng’wɨ nɨamanyisi amalagɨɨlyo ang’wa Musa ga nɨenso akamʉdalaha akalʉnga, “Aɨʉakomoe nɨangɨza, nʉwanso shanga ʉhumile kikomola! <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />Akalongoleka kʉlʉnga, age nʉwanso Kilisito, Mʉtemi nʉwa Aisilaeli! Kʉlʉlo nʉwasime kʉpuma mʉ mʉsalaba ingɨ ʉsese kʉone nʉ kʉmʉhʉɨɨla.”</para>
  <para style="p" vid="MRK 15:32">Nɨantʉ awa naɨ akononteewe mʉmɨsalaba palʉng’wɨ nʉ Yesʉi nɨenso aɨ amʉtʉkɨe.<verse eid="MRK 15:32" /></para>
  <para style="s">Yesʉ ʉkʉsha mʉmʉsalaba</para>
  <para style="r">
    <ref loc="MAT 27:45-56">Matayo 27:45-56</ref>; <ref loc="LUK 23:44-49">Lʉka 23:44-49</ref>; <ref loc="JHN 19:28-30">Yohana 19:28-30</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />Kʉpʉma saa mʉtandatʉ ng’ʉng’wɨ kiti kɨkituma ihɨɨ ɨhi kʉ saa itaatʉ. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />Naɨ yapika saa kenda Yesʉ akalɨla akakʉta, akalʉnga, Eloi, Eloi, lama sabakitani?” Ndogoilyo akwe, “Itunda wane, Itunda wane, haɨ ka wandeka?”<verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />Antʉ ang’wɨ naɨ ɨmɨkile pang’wanso, naɨ igule itɨ, akalʉnga, “Tegeelyi! Ʉkʉmitanga mʉnyakɨdagʉ wang’wi Itunda ʉ Elia.” <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />Mʉntʉ ʉng’wɨ akamanka, akahola ipʉpi akina mʉ kɨlʉʉlwi, akakensha mʉlʉkito nʉlʉlɨpu, akamʉpa wanune, wazelʉnga, “Kʉonegwa ang’wi ʉ mʉnyakɨdagʉ wang’wi Itunda Elia ʉzee mʉsimya mʉ mʉsalaaba!”<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />Yesʉ akakʉta, akasha.<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />Ʉʉgwa, ipazɨa naɨlɨkolɨ nkɨka nɨ nelʉ mʉ Nyʉmba ang’wi Itunda lɨkatamʉka ʉtoompo ʉbɨɨlɨ kʉpuma migʉlya kʉpikɨɨla pihɨ. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />Mʉkʉlʉ ʉng’wɨ nʉwa amboi naɨ wimɨkile pantongela a mʉsalaba naɨ waona ʉ Yesʉi ʉkʉsha itɨ, akalʉnga, “Kʉlʉ kʉʉlʉ mʉntʉ ʉyʉ aza Ng’wana wang’wi Itunda!”<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />Aɨ akolɨ asʉngʉ naɨ ɨmɨkie kʉlɨ aloeye, ang’wɨ ao aɨ Maliamu kʉpuma kʉ kɨsalɨ ka Magidala nʉ Solome nʉ Malia nyinya nʉwa a Yakobo nʉ mʉniino nʉ Yose. <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />Asʉngʉ nɨanso aɨ amʉtyatile ʉ Yesʉi naɨ ʉkolɨ kʉ Galilaya nʉkʉmitʉmɨla. Aɨ akolɨ asʉngʉ aʉya ɨdʉ naɨazile ʉ Yesʉi kʉpuma kʉ Yelusalemu aɨ akolɨ pang’wanso.<verse eid="MRK 15:41" /></para>
  <para style="s">Yesʉ ʉkʉɨkwa</para>
  <para style="r">
    <ref loc="MAT 27:57-61">Matayo 27:57-61</ref>; <ref loc="LUK 23:50-56">Lʉka 23:50-56</ref>; <ref loc="JHN 19:38-42">Yohana 19:38-42</ref></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />Nai ihumbee kʉtula mpɨndɨ, kʉnsoko aɨ lʉhikʉ lakihamba kʉ lʉhikʉ nʉla kʉsupya Ayahudi, <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />akaza ʉ Yosepu naɨ mʉnya kʉ Alimataya, mʉnyampala wianza nikʉlʉ, nʉsanigwe nangalu. Nʉng’wenso aɨʉlindɨɨe kʉza kʉ ʉtemi wang’wi Itunda. Ʉʉgwa, shanga akogopa akamʉhanga ʉ Pilato, akalompa wapegwe ʉmʉimba wang’wa Yesʉ. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />Pilato aɨʉkʉɨwe kija kɨna ʉ Yesʉi wakʉza. Ʉʉgwa, akamitanga mʉkʉlʉ nʉwa amboi, akamʉkolya kɨna taine ʉ Yesʉi wakʉza. <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />Pilato naɨ watambʉɨlwa nʉ mʉkʉlʉ nʉwa amboi, kɨna tai Yesʉ wakondya kʉsha, akamʉgombya ʉ Yosepu kʉʉhola ʉmʉimba wang’wa Yesʉ. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />Papo gwa ʉ Yosepu akagʉla shanda, akaʉsimya pihɨ ʉmʉimba nʉwanso, akaʉtunga shanda. Akaʉɨka mʉkɨbɨɨla naɨ kɨpʉʉwe migwe, sʉnga akapingilitɨlya igwe ikʉlʉ akakiɨla. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />Nɨenso ɨa Maliamu nʉwa kʉ Magidala nʉ Malia nyiya wang’wa Yosepu aɨ aine pang’wanso naɨ ʉɨkilwe ʉmʉimba wang’wa Yesʉ.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">Yesʉ ʉkiʉka</para>
  <para style="r">
    <ref loc="MAT 28:1-8">Matayo 28:1-8</ref>; <ref loc="LUK 24:1-12">Lʉka 24:1-12</ref>; <ref loc="JHN 20:1-10">Yohana 20:1-10</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />Naɨ lakɨla lʉhikʉ nʉla kʉsupya, Maliamu nʉwa kʉ Magidala nʉ Solome nʉ Malia nyinya wang’wa Yakobo akagʉla makʉta akʉnyunkɨɨla akalongola aʉpʉgʉhɨle ʉ mʉimba wang’wa Yesʉ. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />Itɨ gwa, lʉhikʉ nʉla Jumapɨlɨ, daʉ maniambwa, lyoa lɨkaze lɨkɨlɨ kʉtoloka, akapika pakɨbɨɨla. <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />Naɨ akolɨ mʉnzɨla akikolya, “Nyenyu nʉʉkʉʉpingilitɨlya igwe pa mʉlango nʉwa kɨbɨɨla?” <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />Naɨ ahumbeela kʉpika akagoza, akaona igwe lapingilitigwa kʉlɨ nʉ mʉlango nʉwa kɨbɨɨla. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />Naɨ ingɨla mʉkɨbɨɨla, akamʉona mʉhʉmba ʉng’wɨ ʉtugae matugalo melʉ, wikiɨ ipande nɨla kɨgoha nɨla kɨbɨɨla, akakʉɨlwa ikʉlʉ.<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />Ingɨ mʉhʉmba nʉwanso akaaɨla, “Leki kʉkʉɨlwi. Mʉkʉmʉduma Yesʉ nʉwa kʉ Nazaleti naɨ ʉkononteewe mʉ mʉsalaba. Gozi naza amʉɨkile, waiʉka, wɨmʉtilɨ apa. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />Longoli mʉmʉɨle ʉ Petelo nɨamanyisigwa aʉya kɨna Yesʉ wamʉtongeela kʉ Galilaya, kʉng’wanso mʉkʉmʉona anga ng’wenso naɨʉmʉtambʉɨe.”<verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />Itɨ gwa asʉngʉ nɨanso, akatula kagata kʉwoa nʉkʉkʉɨlwa, akahega pakɨbɨɨla aze amankile mɨlugu. Shanga aɨ aligitilye kɨntʉ kɨhi kʉmʉntʉ, kʉnsoko aɨ ogopile.<verse eid="MRK 16:8" /></para>
  <para style="s">Yesʉ ʉkʉmigeela Maliamu nʉwa kʉ Magidala</para>
  <para style="r">
    <ref loc="MAT 28:9-10">Matayo 28:9-10</ref>; <ref loc="JHN 20:11-18">Yohana 20:11-18</ref></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />Lʉhikʉ nʉla Jumapɨlɨ, daʉ maniambwa, Yesʉ naɨ wiʉkile akamigeela hanza Maliamu nʉwa kʉ Magidala, naɨ ʉmʉhegeye ahɨng’wɨ nɨabɨ mʉpungatɨ.<note caller="+" style="f"><char style="fr" closed="false">16:9 </char><char style="ft" closed="false">Bibilia ying’wɨ nia kalɨ ngila ʉlʉkɨɨlɨ nʉla 9 kʉpikɨɨla lʉkɨɨlɨ nʉla 20. </char></note> <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />Maliamu nʉwa kʉ Magidala akalongola, akaapikɨlya impola awa naɨ ɨpalʉng’wɨ nʉ Yesʉi, matungo nanso aɨ akʉhongeelya nʉ kʉlɨla. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />Ingɨ naɨ ija kɨna ʉ Yesʉi waina mʉpanga hangɨ, nɨ kɨna ʉ Maliamu nʉwa kʉ Magidala ʉmʉine, shanga akahʉɨɨla.<verse eid="MRK 16:11" /></para>
  <para style="s">Yesʉ ʉkʉigeela amanyisigwa abɨɨlɨ</para>
  <para style="r">
    <ref loc="LUK 24:13-35">Lʉka 24:13-35</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />Panyambele ʉ Yesʉi akaigeela amanyisigwa abɨɨlɨ. Amanyisigwa awa aɨ alongoe kʉmʉgʉnda, aze wikelʉ ingɨɨza. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />Amanyisigwa awa nɨabɨɨlɨ naɨ amʉlɨnga, akatulya akaaganʉɨla anyisigwa aʉya. Nɨitɨ ga shanga akahʉɨɨla.<verse eid="MRK 16:13" /></para>
  <para style="s">Yesʉ ʉkʉigeela amanyisigwa akwe ikʉmi na ʉng’wɨ</para>
  <para style="r">
    <ref loc="MAT 28:16-20">Matayo 28:16-20</ref>; <ref loc="LUK 24:36-49">Lʉka 24:36-49</ref>; <ref loc="JHN 20:19-23">Yohana 20:19-23</ref>; <ref loc="ACT 1:6-8">Ntendo 1:6-8</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />Panyambele ʉ Yesʉi akaigeela amanyisigwa ikʉmi na ʉng’wɨ naɨ akʉlya. Yesʉ akaakenela kʉnsoko a lʉgoha lao, kʉnsoko shanga aɨahʉɨɨe awo naɨ aatambʉie kɨna amʉona waiʉka. <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" />Itɨ gwa, akaatambʉɨla, “Longoli mʉ ʉnkumbigʉlʉ wɨhi mende mʉtanantye Nkani Nza kʉ iʉʉmbwa yɨhi. <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />Mʉntʉ wɨhi nʉkʉhʉɨɨla nʉkʉbadisigwa ʉkʉgunɨka. Mʉntʉ wɨhi nɨshanga ʉkʉhʉɨla ʉkʉpisɨligwa. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />Niilɨngasɨɨlyo izi yɨkʉtula nawo nɨahʉɨɨe. Akʉtʉmɨla ʉhumi nʉwa lina lane kʉpumya ahɨng’wɨ hangɨ akʉtambʉla ntambʉ mpya. <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />Akʉamba nzoka ang’wɨ akʉng’wa kɨntʉ kɨhi nɨkakʉbʉlaga, shanga kɨkʉalemaalya. Akʉaɨkɨɨlya alwae mɨkono, nɨenso akʉkomya.”<verse eid="MRK 16:18" /></para>
  <para style="s">Yesʉ ʉkʉluma kilunde</para>
  <para style="r">
    <ref loc="LUK 24:50-53">Lʉka 24:50-53</ref>; <ref loc="ACT 1:9-11">Ntendo 1:9-11</ref></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />Itɨ gwa, Isekʉlʉ Yesʉ naɨ waligitya nɨenso, akaluma walongole kilunde, akikiɨ ipande nɨla ʉhumi nɨlang’wi Itunda. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />Sunga amanyisigwa akalongola akaatanantɨlya antʉ Nkani Nza nkɨka yɨhi. Isekʉlʉ Yesʉ aɨ ʉkʉkamɨnkɨɨlya ʉkolɨ palʉng’wi nɨenso kʉ ilɨngasɨɨlyo naɨ yityatile nʉ lʉkani.<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>