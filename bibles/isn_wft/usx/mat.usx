<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Isanzʉ Bible Version</book>
  <para style="h">MATAYO</para>
  <para style="toc1">Nkani ni Nza anga niyandɨkilwe nʉ Matayo</para>
  <para style="toc2">Matayo</para>
  <para style="toc3">Mata</para>
  <para style="mt2">Nkani ni Nza niyandɨkilwe nʉ</para>
  <para style="mt1">MATAYO</para>
  <para style="imt">NTONGEELA AKWE</para>
  <para style="ip">Nkani ni Nza niyandɨkilwe nʉ Matayo ingɨ ɨng'wɨ mʉ mbugulu innɨ nɨyiganʉe ʉlikalo lang'wa Kilisito. Mʉ mbugulu inzi yitangwa “Injili” lʉkani nʉlʉkete ndogoelyo a “Nkani ni Nza.” Mbugulu izi yandɨkilwe nʉ Matayo nʉ Maliko nʉ Lʉka nʉ Yohana Mʉbadisi, yandɨkilwe itungo nsha ang'wa Yesʉ naɨ akɨla. Amanyi shanga alɨngile itungo kɨɨ lʉkʉlʉ yandɨkilwe Nkani ni Nza niyang'wa Matayo, ingɨ ihumɨkile lukulu kɨna aɨ yandɨkilwe mʉ ng'waka nʉa makʉmi mʉtandatʉ kʉpumɨɨla nʉatugɨwe ʉ Kilisito. Kɨʉya ingɨ nkɨka naɨyadɨkiwe shanga ilɨngɨkile kʉlʉ kʉʉlʉ, ingɨ antʉ ɨdʉ ɨsɨgɨɨla kɨna kɨandɨkɨwe mihɨɨ a Palesitina, hangɨ ihumɨkile kɨandɨkɨwe mʉ kɨsalɨ ka Yelusalemu.</para>
  <para style="ip">Mʉandɨki nʉa mbugulu ɨyɨ ingɨ Matayo, naɨ wakɨlɨ kitangwa nʉ Yesʉ atule mʉmanyisigwa wakwe aɨ mʉhangʉlya kodi. Lina lʉlya nɨlang'wa Matayo aɨ ʉkumʉkile Lawi. Matayo aɨ ʉng'wɨao mʉ Itʉmi nɨ ikʉmi na abɨɨlɨ, nʉyo aɨ wandɨkile i Nkani ni Nza waze ʉasɨgɨɨe alɨngi a Kɨyahudi. Mpola izi yikomanɨɨye kʉona kɨna ʉkolɨ ʉandɨkwi makumi mʉtandatʉ nʉkʉkɨla kʉpuma mʉwandɨkwa nʉwa kalɨ. Matayo ʉsɨgɨɨe kʉganʉla kɨna ʉ Yesʉ ingɨ Masia. Mʉguni nʉhoilwe ni Itunda, nʉ ʉmanga ʉpumilye ʉ mʉloto wakwe. Matayo ʉandɨkile hangɨ makani nɨmaʉya ɨdʉ na ʉtemi wang'wi Itunda. Ayahudi aɨ alindɨɨe Masia ʉkʉtula mʉtemi nʉa kɨ ʉnkumbigʉlʉ. Matayo wɨkaganʉla yɨdʉ nsuta nɨ masɨgoao kʉ ʉmanyi nʉ ʉkendegeeli ʉkʉlʉ, waze ʉganʉla ʉtemi nʉa kɨnkolo nʉ wang'wi Itunda.</para>
  <para style="ip">Mbugulu a Nkani ni Nza nɨandɨkilwe nʉ Matayo ingɨ kɨza kʉtula wandɨɨlyo wi Ilago ni Ipya, kʉnsoko kɨsʉkɨɨe makani ɨdʉ kʉpumɨɨla mi Ilago ni la Kalɨ, ingɨ kɨtungɨnkani kɨza nɨka Malago aya nabɨɨlɨ. Antʉ nɨasomile atambʉe kɨna ingɨ ʉ Matayo aɨʉgemile kʉtyatɨnkania nɨ mbugulu niyandɨkilwe nʉ Musa, nɨɨza mbugulu itaano niya ng'wandyo Milago nɨ la Kalɨ.</para>
  <para style="iot">Namolɨ</para>
  <para style="io">Matayo ʉkandya Nkani ni Nza kʉganʉla mpola niyakʉtugwa kʉng'wa Kilisito nʉ ng'wandyo nʉa mʉlɨmo wakwe, mʉ mʉlango nʉa 1-4.</para>
  <para style="io">Naɨ wamala nanso Matayo ʉkʉganʉla mʉlɨmo nʉ ʉmanyisi wɨdʉ nʉ wang'wa Yesʉ, mʉlango 5-25.</para>
  <para style="io">Ʉmalɨnkɨɨlyo nʉa Nkani ni Nza niyandɨkilwe nʉ Matayo yiganʉe ikani nɨla kʉlʉ kʉʉlʉ nɨla kʉnsha nʉ kiʉka kʉng'wa Yesʉ, mʉ mʉlango nʉa 26-28.</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">Ndʉgʉ ang'wa Kilisito</para>
  <para style="r">
    <ref loc="LUK 3:23-38">Lʉka 3:23-38</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Ʉwʉ wʉwʉ mʉlongo nʉwa ndʉgʉ ang'wa Kilisito, ng'wana wang'wa Daudi, ng'wana wang'wa Ibulahimʉ.<verse eid="MAT 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2" />Ibulahimʉ wɨkamʉtuga Isaki nʉ Isaki wɨkamʉtuga Yakobo, nʉ Yakobo wɨkamʉtuga Yʉda nɨaluna akwe <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />Yʉda wɨkamʉtuga Pelesi nʉ Zela, nyinya wao aɨ Tamali, nʉ Pelesi wɨkamʉtuga Esilomu nʉ Esilomu wɨkamʉtuga Alamu. <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />Alamu wɨkamʉtuga Aminadabu nʉ Aminadabu wɨkamʉtuga Nashoni nʉ Nashoni wɨkamʉtuga Salimoni <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />Salimoni wɨkamʉtuga Boazi nʉ nyinya wang'wa Boazi aɨ Lahabu nʉ Boazi wɨkamʉtuga Obedi nʉ nyinya wang'wa Obedi aɨ Luti nʉ Obedi wɨkamʉtuga Yese.<verse eid="MAT 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 1:6" />Yese wɨkamʉtuga Daudi naɨza Mʉtemi. Daudi wɨkamʉtuga Solomoni, ʉnyinya wang'wa Solomoni aɨ Bati Sheba yʉyo naɨ mʉkɨma wang'wa Ulia. <verse eid="MAT 1:6" /><verse number="7" style="v" sid="MAT 1:7" />Solomoni wɨkamʉtuga Lehoboamu. Lehoboamu wɨkamʉtuga Abiya. Abiya wɨkamʉtuga Asa, <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />Asa wɨkamʉtuga Yehoshapati nʉ Yehoshapati wɨkamʉtuga Yolamʉ nʉ Yolamu wɨkamʉtuga Ʉzia, <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />Ʉzia wɨkamʉtuga Yotamu nʉ Yotamu wɨkamʉtuga Ahazi nʉ Ahazi wɨkamʉtuga Hezekia, <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />Hezekia wɨkamʉtuga Manase nʉ Manase wɨkamʉtuga Amoni nʉ Amoni wɨkamʉtuga Yosia, <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />Yosia wɨkamʉtuga Yekonia nɨ aluna akwe. Itungo nɨlanso papo Ayahudi naɨahamɨgwe kʉtalwa kʉ Babeli.<verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />Ayahudi naɨ ahamigwe kʉtalwa kʉ Babeli, Yekonia wɨkamʉtuga Shealitieli nʉ Shealitieli wɨkamʉtuga Zelubabeli, <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />Zelubabeli wɨkamʉtuga Abiudi nʉ Abihudi wɨkamʉtuga Eliakimʉ, Eliakimʉ wɨkamʉtuga Azoli, <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />Azoli wɨkamʉtuga Sadoki nʉ Sadoki wɨkamʉtuga Akimʉ nʉ Akimʉ wɨkamʉtuga Eliʉdi, <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />Eliʉdi wɨkamʉtuga Eliazali nʉ Eliazali wɨkamʉtuga Matani nʉ Matani wɨkamʉtuga Yakobo, <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />Yakobo wɨkamʉtuga Yusupu, Yusupu aɨ mʉgoha wang'wa Malia, Malia yʉyo aɨ ʉmʉtugile Yesʉ nʉ witangwa Kilisito.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Kʉpuma kʉng'wa Ibilahimʉ kʉpikɨɨla kʉtugwa kʉng'wa Daudi aɨ akolɨ matʉgɨlo ikʉmi na annɨ nʉ kʉpumɨɨla kʉng'wa Daudi kʉpikɨɨla nɨ Ayahudi naɨ aholwa kʉhamɨligwa kʉ Babeli, aɨ matugɨlo ikʉmi na innɨ nʉ kʉpuma naɨ aholwa kʉhamɨligwa kʉ Babeli, kʉpikɨɨla nʉ Kilisito naɨ ʉkʉtugwa aɨ matugɨlo ikʉmi na innɨ.<verse eid="MAT 1:17" /></para>
  <para style="s">Kʉtugwa kʉng'wa Kilisito</para>
  <para style="r">
    <ref loc="LUK 2:1-7">Lʉka 2:1-7</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Ʉʉgwa, kʉtugwa kʉng'wa Kilisito aɨ it. Malia nyinya wang'wa Kilisito aɨ ʉligigwe nʉ Yusupu, ɨkaze akɨlɨ atankane kɨmʉɨlɨ, ʉ Malia wɨkatʉla waʉsha mɨligo kʉʉhumi nʉa Ng'wahʉ Ng'welʉ. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Yusupu naɨwaona kɨna Malia ʉyʉ nʉmʉligilye waʉsha mɨligo, wɨkasɨga wamʉleke kɨnkʉnkʉ, kʉnsoko ʉ Yusupu aɨ mʉntʉ nʉwɨtenda aya nagombekile kʉng'wi Itunda shanga aɨ ʉloilwe kʉmʉhumya mɨnyala ʉ Malia. <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />Yusupu naɨwakɨlɨ ʉkisɨja kʉmʉleka, Mitʉmi nʉakigʉlʉ nʉang'wi Itunda wang'wi Itunda wɨkamʉɨla mʉndoti, “Ʉewe Yusupu ng'wana wang'wa Daudi, leka kogopa kʉmʉhola Malia watʉle mʉkɨmako, kʉndogoelyo mɨligo ɨyɨ nʉkete ingɨ kʉʉhumi nʉwa Ng'wahʉ Ng'welʉ. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Ʉkʉtuga ng'wana mʉgoha, nʉewe ʉkʉmʉta lina Yesʉ, kʉnsoko nʉanso yʉyo ʉkʉaguna antʉ akwe mʉmɨlandʉao.”<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Aya ɨhi aɨapʉmɨe kʉtimɨlya ʉlʉkani ni Itunda aɨʉtambʉe kʉkɨɨla mʉ amanga akwe kɨna, <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />“Kolwa, mʉnanso nʉwakɨlɨ kʉmanya mitʉnja ʉkʉpantɨka mɨligo nʉyo ʉkʉtuga ng'wana mʉgoha lina lakwe akʉmʉta Imanueli” Ndogoelyo alina ɨlɨ, “Itunda palʉng'wɨ nʉsese”.<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Itɨgwa Yusupu naɨwapitya mʉtʉlo wɨkatenda anga naɨʉlagɨigwe nʉ Itʉmi akigʉlʉ niang'wi Itunda wɨkamʉhola Malia kʉtula mʉkɨma wakwe anga Itʉmi akigʉlʉ niang'wi Itunda nʉwang'wi Itunda aɨ ʉmʉtambʉye mʉndoti. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Ingɨ Yusupu shanga aɨ ʉtankanile kɨmʉɨlɨ nʉ Malia, kʉpikɨɨla Malia naɨ utugile ng'wana mʉgoha. Ʉʉgwa Yusupu wɨkamʉta ʉng'wana lina Yesʉ.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">Alɨngi a nzota ɨkapika kʉmʉkʉlya ʉ Yesʉ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Yesʉ aɨ ʉtugɨlwe kʉ Betelehemu mʉkɨsalɨ ka Yʉda, itungo nɨlanso Helode aɨ mʉtemi. Itungo ɨniino ʉdu Yesʉ naɨ watugwa, alɨngi a nzota kʉpembelya kilya ɨkapɨka kʉ Yelusalemu, <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />ɨkakolya, “Itɨɨ, ʉkolɨ pɨɨ ng'wana nʉtugilwe? Mʉtemi nʉwa Ayahudi, kʉnsoko kʉmɨine nzota akwe ɨpembeeye kilya, nʉsese kaza kʉmʉkʉlya.”<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Mʉtemi Helode naɨwija ɨnkani izi wɨkahʉsha nangalu mʉnkolo akwe palʉng'wɨ nɨantʉ ɨhi nɨakʉ Yelʉsalemu. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Mʉtemi Helode wɨkitanga ɨanza la akʉlʉ a apolyi nɨ amanyisi a malagɨɨlyo ang'wa Musa, wɨkaakolya kina, “Kilisito ʉkʉtugɨlwe pɨɨ?”<verse eid="MAT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5" />Nɨenso ɨkamʉsʉkɨɨlya, “Ʉtugɨwe kʉ Betelehemu, mʉ mʉkɨsalɨ ka Yuda, kʉnsoko itɨ ʉʉ yandɨkilwe nʉ mʉmanga wang'wi Itunda kɨna,<verse eid="MAT 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="MAT 2:6" />‘Ʉewe kɨsalɨ ka Betelehemʉ, nʉkolɨ mihɨɨ a Yuda,</para>
  <para style="q" vid="MAT 2:6">ʉewe shanga wɨmʉniino mʉ ɨsalɨ niisanigwe nɨya Yuda,</para>
  <para style="q" vid="MAT 2:6">kʉnsoko kʉng'wako ʉkʉpʉmiila mʉtongi</para>
  <para style="q" vid="MAT 2:6">nʉʉkʉatongeela antʉ ane Aisilaeli.”’<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Papogwa, Helode wɨkaitanga kɨmpelo alɨngɨ amakani, wɨkaakolenkeelya kɨna matungo kɨ aɨ amɨɨne nzota nanso. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Sʉnga Helode wɨkaalagɨɨlya, “Longoli kʉ Betelehemʉ mʉkolenkeelye kɨsa nkani niya ng'wana nʉanso, anga mamʉona mʉze mʉmbɨle nʉnene nende nʉmʉkʉlya,”<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />Alɨngi a nzota naɨ akondya kʉmʉtegeelya ʉ mʉtemi, ɨkalongola nɨ nzota naɨ amɨine kʉkilya ɨkaatongeela ɨkenda ɨkimɨka pigʉlya paɨ ʉkolɨ ʉ ng'wana. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Naɨ amɨine ɨnzota nanso aɨaloilwe nangalu. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Ʉʉgwa ikingɨla mʉnyʉmba, ɨkamʉona ng'wana palʉng'wɨ nʉ Malia nyinya nʉwa ng'wana, ɨkatʉgama ɨkamʉkʉlya. Sʉnga ɨkapumya ipegwa kʉ ng'wana, Zahabʉ nɨ maintʉ akʉkuhɨɨlya nɨ makuta akʉnyunkɨɨla.<verse eid="MAT 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 2:12" />Kʉnsoko Itunda aɨ waakania kʉkɨɨla ndoti aleke kʉsʉka kʉng'wa Helode, ʉʉgwa ɨkatʉlya mʉ mahɨɨ ao kʉkɨɨla nzɨla ngɨza.<verse eid="MAT 2:12" /></para>
  <para style="s">Kʉmankɨɨla kʉ Misili</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Itungo alɨngi anzota naɨahega, Itʉmi akigʉlʉ niang'wi Itunda wang'wi Itunda wɨkamʉtambʉlya Yosepʉ mʉ ndoti, wɨkamʉɨla, “Ʉka, Mʉhole ʉng'wana nʉ nyinya, longoli kʉ Misili. Mishiɨ kʉko kʉpikɨɨla ninzɨza kʉɨla, kʉnsoko Helode wasɨga kʉmʉbʉlaga ʉng'wana ʉyʉ.”<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />Itɨ gwa, Yosepʉ wɨkaʉka ʉtikʉ wɨkamʉhola ng'wana ɨkakʉila nʉ nyinya nʉa ng'wana, ɨkalongola kihɨɨ akʉ Misili. <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />Akishiɨ kihɨɨ akʉ Misili kʉpikɨɨla Helode naɨ washa. Ikani ɨlɨ aɨ lɨpʉmɨe kʉkondanɨlya ni Itunda aɨʉtambʉe kʉkɨɨla mʉmanga wakwe kɨna. “Aɨ nʉmitangile ʉng'waane kʉpumɨɨla kihɨɨ akʉ Misili.”<verse eid="MAT 2:15" /></para>
  <para style="s">Mʉtemi Helode ʉkʉabʉlaga ana akigoha</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Helode naɨwaona alɨngi anzota amʉkongela, wɨkabɨpɨlwa nangʉlʉʉ. Wɨkalagɨɨlya kʉ Betelehemʉ niisalɨ yɨhi mʉmpelompelo abʉlagwe ang'enya nɨagoha ɨhi nɨ shanga apikɨɨe ilɨka la myaka ɨbɨɨlɨ. Aɨwɨtʉmile itɨ kʉtyatɨɨla matʉngo alɨngi anzota naɨ amʉhangile.<verse eid="MAT 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 2:17" />Ʉʉgwa yɨkatula tai ɨnkani naɨ itambʉwe nʉ mʉmanga wang'wi Itunda ʉ Yelemia kɨna,<verse eid="MAT 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="MAT 2:18" />“Nyangi yɨkigigwa kʉ Lama,</para>
  <para style="q" vid="MAT 2:18">kɨlɨlo nʉ kihongeelya,</para>
  <para style="q" vid="MAT 2:18">Laheli ʉkʉalɨɨla ana akwe,</para>
  <para style="q" vid="MAT 2:18">nʉyo shanga ʉloilwe kʉkilagigwa,</para>
  <para style="q" vid="MAT 2:18">kʉnsoko ana akwe ɨhi akuza”.<verse eid="MAT 2:18" /></para>
  <para style="s">Kʉtulya kʉpuma kʉ Misili</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Naɨakɨla mahikʉ kɨtʉnga kʉpumɨɨla nsha ang'wa Helode, Itʉmi akigʉlʉ niang'wi Itunda wang'wi Itunda, wɨkamʉtambuɨla Yusupu mʉndoti ʉko kʉ Misili, <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />wɨkamʉɨla, “Ʉka, mʉhole Ng'wana nʉ nyinya nʉwa ng'wana mʉtulye kihɨɨ akʉ Isilaeli, kʉnsoko ʉyo naɨaloilwe kʉmʉbʉlaga Yesu wakule.” <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />Ʉʉgwa ikahega kʉtʉlya kʉ Isilaeli, ng'wenso nʉ mʉkɨma azeamʉkenkile nʉ Mʉng'enya.<verse eid="MAT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 2:22" />Ingɨ Yusupu naɨwɨja kɨna ʉ Alikelao ng'wana wang'wa Helode, ng'wenso wasaɨle ituntu nɨla ʉtemi wang'wi ihe, wɨkogopa kʉlongola. Ʉʉgwa, naɨ wahʉgʉligwa ni Itunda mʉ miloto, nʉyo wɨkalongola kishiɨ kʉ Galilaya, <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />nʉyo wɨkalongola kishiɨ mʉkɨsalɨ nɨkitangwa Nazaleti. Ʉʉgwa yɨkapikɨɨla nkani naɨ yɨtambʉwe nʉmʉnga wang'wi Itunda, “Ʉkitangwa Mʉnazaleti.”<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">Yohana Mʉbadisi ʉkʉtanantya</para>
  <para style="r">
    <ref loc="MRK 1:1-8">Maliko 1:1-8</ref>; <ref loc="LUK 3:1-18">Lʉka 3:1-18</ref>; <ref loc="JHN 1:19-28">Yohana 1:19-28</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Naɨ akɨla mahikʉ ɨdʉ, Yohana Mʉbadisi wɨkalongola wɨkatula tanantya ki jangwa nɨla kʉ Ʉyahudi, wazelʉnga, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />“Pɨlʉki mʉleke mɨlandʉ anyu mʉmʉsʉkɨle Itunda, kʉnsoko Itunda ingɨ wihambile kʉatongeela antʉ akwe.” <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Yohana Mʉbadisi yʉyʉ naɨʉtambʉwe nʉ Isaya mʉmanga wang'wi Itunda kɨna,</para>
  <para style="q" vid="MAT 3:3">“mʉntʉ ʉkitanga kʉpʉmɨɨla mijangwa,</para>
  <para style="q" vid="MAT 3:3">‘Noneelyi nzɨla yang'wi Itunda,</para>
  <para style="q" vid="MAT 3:3">gooli ʉkɨɨlo wakwe.”<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Yohana Mʉbadisi aɨ ʉtugae itugalo naɨlɨtumilwe kʉlʉnzʉ nila ngamɨa mʉ kɨlɨno aɨ wɨtʉngile mʉsipi nʉa ndɨlɨ, ndya yakwe aɨ nkʉmbi nʉ ʉkɨ. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Antʉ ɨkamendela Yohana Mʉbadisi kʉpʉma ku Yelʉsalemu nʉ Ʉyahudi wɨhi nɨ mahɨɨ ɨhi amʉmpelo mpelo a ʉmongo nʉa Yolodani, <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />Ɨkaleka mɨlandʉ ikamʉsʉkɨla Itunda, nʉ Yohana Mʉbadisi wɨkaabadisa mʉmongo nʉanso nʉa Yolodani.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Ingɨ Yohana Mʉbadisi naɨ waaona iʉmbi ikʉlʉ nɨla Apalisayo nɨ Asadukayo akʉmʉzɨɨla wahume kʉabadisa, wɨkaakolya, “Ʉnyenye wileli nʉ wanzoka, nyenyʉ nʉʉmʉhʉgʉye mʉhege nʉkʉʉtiga ʉtaki wang'wi Itunda nʉʉpembilye? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Itɨgwa itʉmɨ ntendo nɨnza nɨyakʉlɨngasɨɨlya kɨna maleka mɨlandʉ anyu. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Leki kʉsɨgi kɨna tata itʉ ʉsese ingɨ Ibilahimu, kʉnsoko Itunda ʉhumile kʉmʉpeza Ibilahimu ana kʉpuma mʉ magwe aya. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Ingɨ manyi kɨna ihengo laɨkwa pa mɨli a mʉtɨ, mʉtɨ wɨhi nɨ shanga wɨpeza nkali nɨ nza ʉkʉteng'wa ʉgʉmilwe mʉmoto. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />Ʉnene kʉmʉbadisa na mazɨ kʉlɨngasɨɨlya kɨna maleka ntendo yanyu ni mbɨ. Ʉyʉ nɨ nɨmʉtongee wakɨlɨ ʉpembilye ʉkete ʉhumi nʉʉkʉlʉ kʉkila ʉnene, shanga nɨhʉmile kʉtolya mɨkoha a makwasa akwe, nʉanso ʉkʉmʉbadisa na Ng'wahʉ Ng'welʉ nʉ moto. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Mʉmikono akwe ʉkenkile kɨsela nɨka kʉpetela ilo, ʉkʉʉgɨɨlya kɨʉga ʉkʉpʉla ilo wakwe nʉkʉɨka misalanka, ʉkʉsonsa ipʉko kʉ moto nɨ shanga wɨlima.”<verse eid="MAT 3:12" /></para>
  <para style="s">Yesʉ ʉkʉbadisigwa</para>
  <para style="r">
    <ref loc="MRK 1:9-11">Maliko 1:9-11</ref>; <ref loc="LUK 3:21-22">Lʉka 3:21-22</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Ʉʉgwa matʉngo nanso Yesʉ aiʉpumɨɨe kʉ Galilaya akapɨka pa mongo nʉwa Yolodani wabadisigwe nʉ Yohana Mʉbadisi. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Ingɨ Yohana Mʉbadisi wɨkahɨa kʉmʉgilya, wɨkamʉɨla, “Ʉewe ʉpembilye ʉbadɨsigwe nʉnene, Ʉnene ntakɨwe mbadisigwe nʉ ewe?”<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Yesʉ wɨkasʉkɨɨlya wɨkamʉɨla, “Gomba ʉdu itungo ɨlɨ, kʉnsoko ʉʉ kʉtakɨwe kʉkondanɨɨlya tai ɨhi Itunda nʉloilwe kitʉme.” Ʉʉgwa Yohana Mʉbadisi wɨkamʉbadisa.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Papo paapo Yesʉ naɨ wakondya kʉbadisigwa, akapʉma mʉ mazɨ, pʉmpʉlʉgʉ akaona igʉlʉ lalugʉka nʉ Ng'wahʉ ng'welʉ kʉmpyani a nkʉnda akasima nʉkutɨga miega lakwe. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Sʉnga lʉli kʉpumɨɨla kilunde lʉkalʉnga, “Ʉyʉ yʉyʉ Ng'wana mʉlowa wane, nɨndoeɨɨgwe nʉng'wenso.”<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">Yesʉ ʉkʉgeng'wa</para>
  <para style="r">
    <ref loc="MRK 1:12-13">Maliko 1:12-13</ref>; <ref loc="LUK 4:1-13">Lʉka 4:1-13</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Sʉnga Yesʉ akatongeelwa nʉ Ng'wahʉ Ng'welʉ mʉwɨɨ wahume kʉgeng'wa nʉ shetani. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Yesʉ wɨkagwalya kʉlya mahikʉ makʉmi annɨ ʉtikʉ nʉ ng'ʉng'wɨ, sʉnga wɨkahung'wa nzala. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Itɨgwa shetani wɨkamʉhanga wɨkamʉɨla, “Ang'wɨ tai ʉewe wɨng'wana wang'wi Itunda, maɨle ɨmagwe aya apɨlʉke atule mɨkate.<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Yesʉ wɨkasʉkɨɨlya wɨkalʉnga, “Goza yandɨkilwe mʉʉandɨkwa nɨmaza kɨna ʉmʉntʉ shanga ʉkishiɨ wazelya indya du, ingɨ mʉlʉkani lɨhi Itunda nʉʉkʉtambʉla.<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Sʉnga shetani wɨkamʉtwala ʉ Yesʉ kʉ Yelʉsalemu kɨsalɨ nɨkɨɨkilwe kʉnsoko ang'wi Itunda, wɨkamɨmɨsha mʉkɨlɨngasɨɨlyo nɨka Nyʉmba ang'wi Itunda, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />wɨkamʉɨla “Ang'wɨ ʉewe tai wɨ Ng'wana wang'wi Itunda igʉme pɨhi, kʉnsoko yandɨkilwe kɨna,</para>
  <para style="q" vid="MAT 4:6">‘Itunda ʉkʉalagɨɨlya a Itʉmi akigʉlʉ niang'wi Itunda akwe kʉnsoko ako akʉgunɨlye,</para>
  <para style="q" vid="MAT 4:6">akʉkenke mʉ mikono ao,</para>
  <para style="q" vid="MAT 4:6">ʉleke kilemalya mʉgʉlʉ wako migwe.”’<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Yesʉ wɨkamʉsʉkɨɨlya kɨna, “Hangɨ yandɨkilwe kɨna, ‘Leka kʉmʉgema Isekʉlʉ Itunda wako.’”<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Sʉnga ʉ shetani wɨkamʉhola Yesʉ hangɨ wɨkamʉtwala migʉlya alʉgʉlʉ nʉlʉlɨpʉ, wɨkamʉlagɨɨla utemi nʉwa mahɨɨ ɨhi nʉʉgolɨ wakwe, <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />shetani wɨkamʉɨla ʉ Yesʉ, “Izi yɨhi kʉʉpeza anga ʉtugame nʉ kʉnkʉlya.”<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Papo gwa ʉ Yesʉ wɨkamʉɨla “Hega apa itɨ shetani! Yandɨkilwe mʉmbugulu ang'wi Itunda. ‘Ʉkʉmʉkʉlya Isekʉlʉ Itunda wako nʉ kʉmitʉmɨla ʉng'wenso wɨng'wene du.”’<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Ɨtɨgwa ʉ shetani wɨkamʉleka Yesu papo, nɨ a Itʉmi akigʉlʉ niang'wi Itunda ang'wi Itunda ɨkaza mitʉmɨla.<verse eid="MAT 4:11" /></para>
  <para style="s">Yesʉ ʉkandya mʉlɨmo mʉ Galilaya</para>
  <para style="r">
    <ref loc="MRK 1:14-15">Maliko 1:14-15</ref>; <ref loc="LUK 4:14-15">Lʉka 4:14-15</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Ɨtɨgwa itungo Yesʉ naɨwija kɨna ʉ Yohana Mʉbadisi Mʉbadɨsi watungwa mʉkadulumu, wɨkatulya kʉ Galilaya. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Yesʉ wɨkahega mʉkɨsalɨ ka Nazaleti, wɨkalongola kɨshiɨ mʉ kisalɨ nɨka Kapelanaʉmu nɨkolɨ mʉmpelo a lʉzɨ lʉkʉlʉ nʉla Galilaya, pakupɨ nɨ mahɨɨ akʉ Zabuloni nɨ Naputali. <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />Itɨgwa aɨ utendile itɨ lʉpikɨɨle ʉlʉkani naɨ lʉtambʉwe nʉ Mʉmanga wang'wi Itunda ʉ Isaya.<verse eid="MAT 4:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MAT 4:15" />“Ihɨɨ a Zabʉloni ni ihɨɨ akʉ Napʉtali,</para>
  <para style="q" vid="MAT 4:15">nzɨla nɨhongile kʉ lʉzɨ nʉlʉkʉlʉ, kitʉmbɨ nɨla mongo nʉwa Yolodani,</para>
  <para style="q" vid="MAT 4:15">Galilaya nɨishiɨ antʉ nɨ shanga Ayahudi.<verse eid="MAT 4:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="MAT 4:16" />Antʉ nɨishiɨ mʉ kiti,</para>
  <para style="q" vid="MAT 4:16">alɨkɨlwa nzelya nkʉlʉ.</para>
  <para style="q" vid="MAT 4:16">awa naɨ ɨshiɨ mihɨɨ na kiti nawa nia mihɨɨ aʉlʉgʉ,</para>
  <para style="q" vid="MAT 4:16">alɨkɨlwa nzelya.<verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Kʉpumɨɨla itʉngo lɨlo, Yesʉ wɨkandya kʉtanantya wazelʉnga, “Pɨlʉki mʉleke mɨlandʉ anyu mʉmʉsʉkɨle Itunda, kʉnsoko ʉtemi wang'wi Itunda wahugeela”<verse eid="MAT 4:17" /></para>
  <para style="s">Yesʉ ʉkʉitanga abua nsamaki annɨ</para>
  <para style="r">
    <ref loc="MRK 1:16-20">Maliko 1:16-20</ref>; <ref loc="LUK 5:1-11">Lʉka 5:1-11</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Itungo nɨlanso Yesʉ naɨ ʉkʉgendagenda pakupɨ nʉ lʉzɨ nʉ lʉkʉlʉ nʉla Galilaya, wɨkaaona abʉa nsamaki abɨɨlɨ, Simioni nʉwitangwa Petelo nʉ Andelea mʉluna wakwe. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Yesʉ wɨkaaɨla, “Nzii, mʉntyate, ʉnene kʉmʉmanyisa kʉaleta antu kʉng'wi Itunda, kimɨkɨɨli ka kubua insamaki,. <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Itʉngo lɨlo ɨkaleka nyabu yao, ɨkamʉtyata.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Naɨ wagenda ɨniino, wɨkaaona nɨaʉya abɨɨlɨ Yakobo nʉ Yohana Mʉbadisi ana ang'wa Zebedayo, akaze anankɨe mibɨnɨ nʉ tata ao Zebedayo, akʉinoneelya nyabʉ yao, papo Yesʉ akaɨtanga kɨlanyi, <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />itʉngo ʉdu ɨkalɨleka ibɨnɨ nʉ tata ao, ɨkamʉtyata ʉ Yesʉ.<verse eid="MAT 4:22" /></para>
  <para style="s">Yesʉ ʉkʉmanyisa antʉ nʉkʉakomya alwae</para>
  <para style="r">
    <ref loc="LUK 6:17-19">Lʉka 6:17-19</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Yesʉ aɨ wɨgendeela nkɨka yɨhi niya kisalɨ ka Galilaya, akaze amanyisa mʉnyʉmba nɨya kʉtankanɨla Ayahudi, wɨkatanantya Nkani ni Nza niya ʉtemi wang'wi Itunda, nʉkʉakomya antʉ ndwala ʉyaga ʉyaga. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Ʉlʉkumo lang'wa Yesu lʉkenela nkɨka yɨhi niya Silia, nɨ antʉ ɨkamʉtwaɨla alwae naɨ ilwala ndwala ʉyagaʉyaga, ahali nɨagwa nkolo nawa nɨapoiye, Yesʉ wɨkaakomya ɨhi. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Papogwa maumbɨ a antʉ kʉpuma kʉ Galilaya nʉkʉ Dekapoli nʉkʉ Yelusalemu nʉkʉ Ʉyahʉdi nʉ kitʉmbɨ nɨla mongo nʉa Yolodani akatula mʉtyata Yesʉ.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">Yesʉ ʉkʉmanyisa antʉ mʉlʉgʉlʉ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Itɨ gwa itungo Yesʉ naɨ waona iumbɨ la antʉ ɨdʉ, wɨkanankɨla mʉlʉgʉlʉ, akikiɨ. Nɨ amanyisigwa akwe ɨkamʉhanga, <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Yesʉ nʉyo wɨkandya kʉamanyisa,<verse eid="MAT 5:2" /></para>
  <para style="s">Ʉkembetwa wang'wi Itunda</para>
  <para style="r">
    <ref loc="LUK 6:20-23">Lʉka 6:20-23</ref></para>
  <para style="q">
    <verse number="3" style="v" sid="MAT 5:3" />“Akembetilwe antʉ awa nɨ alɨnga kina amʉtakile Itunda,</para>
  <para style="q" vid="MAT 5:3">kʉnsoko ʉtemi wang'wi Itunda ingɨ wao!<verse eid="MAT 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MAT 5:4" />Akembetilwe antʉ awa nɨ akɨa mʉnkolo,</para>
  <para style="q" vid="MAT 5:4">kʉnsoko Itunda ʉkʉsʉkɨɨlya ʉlowa!<verse eid="MAT 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MAT 5:5" />Akembetilwe awa nɨ ininompya,</para>
  <para style="q" vid="MAT 5:5">kʉnsoko nɨanso akʉpegwa ihɨɨ ɨtule ao.<verse eid="MAT 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="MAT 5:6" />Akembetilwe awa nɨakete nsʉla akitʉma aya namʉloeeye Itunda,</para>
  <para style="q" vid="MAT 5:6">kʉnsoko Itunda ʉkʉapa ngulu niya kitʉma nanso.<verse eid="MAT 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MAT 5:7" />Akembetilwe awa nɨakete kɨaisa kʉaʉya,</para>
  <para style="q" vid="MAT 5:7">kʉnsoko nɨenso akʉasɨɨligwa ni Itunda.<verse eid="MAT 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MAT 5:8" />Akembetilwe awa nɨagila anga magazo mʉnkolo yao,</para>
  <para style="q" vid="MAT 5:8">kʉnsoko nɨanso akʉmʉona Itunda!<verse eid="MAT 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MAT 5:9" />Akembetilwe nɨaloilwe antʉ ikiɨ nɨ matiliga,</para>
  <para style="q" vid="MAT 5:9">kʉnsoko nɨanso akitangwa ana ang'wi Itunda!<verse eid="MAT 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MAT 5:10" />Akembetilwe awa nɨakagigwa kʉnsoko akitʉma aya Itunda nʉmaloilwe,</para>
  <para style="q" vid="MAT 5:10">kʉnsoko ʉtemi wang'wi Itunda ingɨ wao.<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />“Mʉkembetilwe ʉnyenye nɨmʉkʉtʉkilwa nɨantʉ nʉkagigwa nʉ kʉtambʉlwa ʉbɨɨ, kʉnsoko mʉkitʉma aya Itunda nʉmaloilwe. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />Iloi, nʉkʉkʉa ngiligili kʉnsoko kɨpegwa kanyʉ kɨkʉlʉ kɨmʉlindɨɨe kigʉlʉ. Ingɨ itɨ ʉʉ aɨatendile ɨamanga ang'wi Itunda naɨ amʉtongee ʉnyenye.<verse eid="MAT 5:12" /></para>
  <para style="s">Mʉnyʉ nɨ nzelya</para>
  <para style="r">
    <ref loc="MRK 9:50">Maliko 9:50</ref>; <ref loc="LUK 14:34-35">Lʉka 14:34-35</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />“Ʉnyenye mimpyani nʉ mʉnyʉ kʉanonɨa antʉ nɨalɨkalo lʉbii, atʉle nʉ lɨkalo nʉlʉza mihɨɨ. Ingɨ mʉnyʉ anga ʉlimɨlye ʉʉza wakwe ʉkʉtendwa ʉlɨ ʉnone? Mʉnyʉ nʉwanso wɨhunʉlwa kʉnzi nʉkʉpambatwa nɨ antʉ. <verse eid="MAT 5:13" /><verse number="14" style="v" sid="MAT 5:14" />Ʉnyenye ingɨ mɨantʉ akʉamanyisa antʉ itʉme aya ni Itunda ʉmaloilwe. Mɨmpyani nɨ nyʉmba nɨzengilwe mʉlʉgʉlʉ shanga mʉhumile kipiha. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Hangɨ antʉ shanga akɨlya lʉmʉlɨ alʉkunɨkɨle mʉnyʉngʉ, ingɨ lʉmʉlɨ lɨɨkwa paʉpagɨko migʉlya alɨkɨlwe antʉ ɨhi nɨamolɨ mʉnyʉmba <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Ʉʉgwa lʉkʉlʉ lʉmʉlɨ lanyʉ isingilye kʉalɨkɨla antʉ kʉntongeela, ahʉme kihenga ntendo yanyʉ ninziza, anga aone intendo yanyu ninza amʉkʉlye ʉ Tata wanyʉ nʉa kigʉlʉ.<verse eid="MAT 5:16" /></para>
  <para style="s">Yesʉ ʉkʉmanyisa malagɨɨlyo</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />Yesʉ wɨkalʉnga, “Mʉleke kʉsɨga kɨna ʉnene nzee heja malagɨɨlyo Itunda naɨ ʉmʉpee Musa, nʉ ʉmanyisi nʉwa amanga naɨ atʉmilwe ni Itunda, ingɨ shanga nzee heja, nzile kamɨnkɨɨlya. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Kʉmʉɨla ɨtai, ihɨɨ nigʉlʉ yʉkʉkila, shanga nzeheja kɨntʉ kɨhi mʉ malagɨɨlyo ang'wa Musa, ingɨ ɨhi akʉkondanɨɨla. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Kʉlʉlo mʉntʉ wɨhi nɨshanga ʉkʉkela malagɨɨlyo ang'wa Musa nɨlɨ ga niniino kʉkɨla ɨhi, hangɨ mʉntʉ nʉanso waamanyise nɨaʉya kitʉma anga nʉanso, mntʉ nʉanso ʉkʉtula mʉniino lʉkʉlʉ mʉ Ʉtemi wang'wi Itunda. Ingɨ mʉntʉ nʉkʉtenda mʉitakɨwe nʉ kʉamanyisa aʉya, mʉntʉ nʉanso ʉkʉpegwa ihɨɨ ɨtule akwe. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Kʉlʉlo kʉmʉila kʉlʉ kʉʉlʉ, anga mʉleke kitʉma niiza anga niitakɨwe ni Itunda, kʉkɨla Apalisayo nɨamanyisi amalagɨɨlyo ang'wa Musa nɨɨtenda, kwee shanga mʉkingɨla kigʉlʉ.<verse eid="MAT 5:20" /></para>
  <para style="s">Ʉmanyisi nʉ wikuo</para>
  <para style="r">
    <ref loc="LUK 12:57-59">Lʉka 12:57-59</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />Yesʉ wɨkaaɨla, matongee kija kʉpuma kʉantʉ akali naɨ atambʉɨwe kɨna, “Leka kʉbʉlaga! Ʉyʉ nʉkʉbʉlaga isingilye wapɨsɨɨligwe. <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Ingɨ ʉnene kʉmʉɨla itɨɨ, wɨhi nʉkʉmʉtakɨɨla ʉmʉluna wakwe, itakɨwe wapɨsɨɨligwe. Nʉ mʉntʉ nʉkʉmʉdalaha mʉluna wakwe kɨna shanga kɨntʉ ʉkʉtalwa kɨanza lakʉlamʉla, nʉyʉ nʉkʉmʉdalaha ʉmʉluna akwe, Itunda ʉkʉmʉpɨsɨɨlya nʉkʉmʉtala kʉʉlʉngʉ milambo la moto nɨɨtalwa anyamɨlandʉ nɨakule. <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />Kʉlʉlo gwa, nʉkitʉma ipolyo nɨla kʉtegenteelya pitekeelo, ʉkɨmbʉkɨɨlye kɨna mileile nʉ mʉluna wako, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />leka ipolyo lako pitekeelo, ʉlongole hanza milɨnge nʉ mʉluna wako, papogwa ʉze witʉme ipolyo lako.<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />Kaya kilɨnga nʉ milei wako nʉkɨlɨ ʉkete lyoma nakɨlɨ kʉʉpisha kɨanza. Angwɨ shanga ʉʉ, ʉyʉ nʉkʉsemee ʉkʉʉtwala kianza nɨlaanyampala, nɨanyampala akʉʉtwala kʉmʉlamʉli nʉmʉkʉlʉ, nʉyo ukʉitangɨlya amboi, nao ʉkʉʉlugaila mʉkadʉlʉmʉ. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Kʉʉɨla ɨtaɨ, shanga ʉkʉpʉma mʉkadʉlumu kʉpikɨɨla nʉkʉmaɨla kʉlipa matʉndʉ ɨhi nʉaɨwe.<verse eid="MAT 5:26" /></para>
  <para style="s">Makani aʉgoolya</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />Yesʉ akalongoleka kʉtambʉla, “Migulyee kɨna antʉ aɨatambʉɨwe, ‘Leka kʉgoolya!’ <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Ʉnene ingɨ kʉmʉɨla, mʉntʉ wɨhi nʉ ʉkʉmʉawa mʉsʉngʉ nɨshanga ʉmʉtɨnile kɨnkolo ʉkʉtula wagoolya. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Itɨ gwa, angaitule liho lako lɨkʉʉsasha lɨkompole ʉligʉme kʉlɨ. Bahʉ wingɨle kigʉlʉ ize wihongo, kʉkɨla ʉmʉɨlɨ wako wɨhi ʉgʉmɨlwe kʉʉlʉngʉ. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Ang'wɨ mʉkono ako nʉakigoha ʉkʉʉsasha, ʉteme ʉgʉme kʉli. Bahʉ kʉlimɨlya mʉkono ako ʉng'wɨ, kʉkila mʉili ako wɨhi kʉʉlʉngʉ kihɨɨ aashi.<verse eid="MAT 5:30" /></para>
  <para style="s">Makani a wileki</para>
  <para style="r">
    <ref loc="MAT 19:9">Matayo 19:9</ref>; <ref loc="MRK 10:11-12">Maliko 10:11-12</ref>; <ref loc="LUK 16:18">Lʉka 16:18</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />Yakondigwe kʉandɨkwa kɨna, mʉntʉ wɨhi nʉkʉmʉleka mʉkɨma wakwe, wamʉtamʉɨle talaka’. <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Ingɨ ʉnene kʉmʉtambʉɨla itɨ, mʉntʉ wɨhi nʉkʉʉkʉmʉtamʉila mʉkɨma wakwe talaka, shanga kʉnsoko aʉgoolyi, ʉkʉmʉsasha mʉkɨma watule mʉgoolya, nʉ mitʉnja, nʉkʉmʉtina mʉsʉngʉ nʉanso nʉlekilwe ʉkʉgoolya.<verse eid="MAT 5:32" /></para>
  <para style="s">Makani amalapo</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />Yesʉ akalongoleka kʉaɨla, “Hangɨ migʉle anyakalɨ aɨɨwe kɨna, ‘Leka kitʉma makani nagiigwe mʉmalagɨɨlyo ang'wi Itunda, ingɨ mʉtakɨwe kitʉma anga niilagɨigwe mʉmalagɨɨyo ang'wi Itunda.’ <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Ingɨ ʉnene kʉmʉɨla, itʉnʉ leki kʉlapi, mʉkɨntʉ kɨhi nɨka kigʉlʉ, kʉnsoko lɨlo ituntu nɨla ʉtemi nɨ lang'wi Itunda, <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />ang'wɨ leki kulapi mʉkɨntʉ kɨhi nɨka mihɨɨ, kʉnsoko mʉmo ʉpandilyo wamigʉlʉ ang'wi Itunda, ang'wɨ leki kilapɨɨla Yelʉsalemu kʉnsoko kɨko kɨsalɨ kamʉtemi nʉmʉkʉlʉ. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Hangɨ mʉleke kilapɨɨla mʉmatwe anyʉ, kʉnsoko shanga mʉhʉmile kʉpɨʉla ga nʉlʉsingi nʉ lʉng'wɨ lʉtʉle lwelʉ ang'wɨ lilwaalʉ. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Anga ‘Itule wagomba’ ‘lunga nagomba’ anga ‘Itule wahita’ ‘lunga nahita’ nkani yɨhi niikʉkɨla nkani izi ɨpʉma kʉng'wa shetani.<verse eid="MAT 5:37" /></para>
  <para style="s">Makani aʉmalyi</para>
  <para style="r">
    <ref loc="LUK 6:29-30">Lʉka 6:29-30</ref></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />Yesʉ wɨkalongeleka kʉlʉnga, “Mimigʉlye yatambʉwe kɨna, ‘Liho kʉ liho, lino nɨ lino.’ <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Ingɨ ʉnene nʉmʉɨɨe, mʉleke kikʉngʉma nʉ mʉntʉ nʉmʉbɨ. Anga mʉntʉ wakʉkʉe ikʉnda lɨng'wi, mʉpɨʉɨle nikʉnda lʉlya. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Mʉntʉ anga wakʉsemele mianza azehiya kʉʉhegelya mʉjʉlʉngʉ wako, mʉlekele nɨ shati ga. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Mʉntʉ nʉkʉʉmɨɨlya ʉmʉkenkelye mʉligo wakwe kilomita ɨng'wɨ, mʉkenkelye kilomita ibɨɨlɨɨ. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Mʉntʉ ʉyʉ nʉkʉʉlompa mʉpee leka kʉmʉima, nʉkʉhiya kʉʉkopa kɨntʉ mʉkopise, leka kʉmʉhitɨlya.<verse eid="MAT 5:42" /></para>
  <para style="s">Kʉalowa alʉgʉ</para>
  <para style="r">
    <ref loc="LUK 6:27-28">Lʉka 6:27-28-32-36</ref></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />“Migʉlye kɨna itambʉwe. Ʉmʉnyakɨsalɨ ako ʉmʉlowe, nʉ mʉlʉgʉ wako ʉmʉhʉkɨlwe.’ <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Ingɨ ʉnene kʉmʉɨla, mʉalowe alʉgʉ anyʉ nʉ kʉalompeela awa nɨakʉmaja, <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />mʉhʉme kʉtʉla mɨana ang'wa Tata wanyʉ nʉa kigʉlʉ. Kʉnsoko nʉanso wɨalɨkɨla lyoa lakwe anyamɨlandʉ nawa nɨa mʉhʉɨɨe, hangɨ wɨkʉisa mbʉla kʉ ahʉɨɨli nʉ kʉ anyamɨlandʉ. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Kʉtilɨ kɨpegwa kɨhi nɨ mʉkʉkɨlija anga mʉalowe wawadʉ nɨ amʉloilwe, kʉnsoko ga nɨahangʉlya mpia ʉʉ ɨtenda! <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Hangɨ anga mʉalamʉshe ɨanyandʉgʉ anyʉ dʉ, ikʉtula mʉakɨiye ntʉni ɨantʉ nɨangɨza? Kʉnsoko nɨ antʉ nɨ shanga amʉmanyile Itunda nao ga ʉʉ ɨtenda. <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Kʉlʉlo gwa, mʉleke kʉtula nɨ magazo anga Ʉtata wanyʉ nʉa kigʉlʉ nɨmʉgila anga magazo!<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">Ʉmanyisi nʉa kʉaɨɨlya nɨangɨɨza</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />Yesʉ wɨkalongeleka kʉmanyisa, “Mʉkendegeele nɨ mʉkitʉma intendo yanyʉ ninza, mʉleke kitʉma pa ntongeela yaantʉ mʉhʉme kʉgozwa nɨ antʉ ʉdu, kʉsoko anga mʉtende itɨ, shanga mʉkʉpegwa anga kɨpegwa nʉ Tata anyʉ nʉa kigʉlʉ.<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />Ingɨ, nɨmʉkʉaɨɨlya akʉmbɨli, leka kitanantya kʉ antʉ. Ʉleke kʉtenda anga atambʉla ʉteele nɨɨtambʉla mʉnkɨka nɨɨtankanɨlya Ayahudi nʉ mʉnzila, ahʉme kʉkʉligwa nɨantʉ. Tai nʉmʉtaambʉɨe nɨanso apantɨkile kɨpegwa kao. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Ingɨ ʉewe nʉkʉmʉaɨɨlya mʉkʉmbɨli, tenda itɨ ga nʉ mʉhʉmba mɨako nʉa pakupɨ waleke kʉlɨnga nʉkɨtendile. <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />Kʉitɨ ikani nɨlanso lɨkʉtula la ʉnkunku kʉng'wako, nʉ Tata wako nʉwɨona nʉkɨtendile kɨnkunku, ʉkʉʉpa kɨpegwa.<verse eid="MAT 6:4" /></para>
  <para style="s">Yesʉ ʉkʉmanyisa malompi</para>
  <para style="r">
    <ref loc="LUK 11:2-4">Lʉka 11:2-4</ref></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />Kʉlʉlo gwa, “Nʉnyenye nɨmʉkʉmʉlompa, mʉleke kʉtenda anga atambʉla ʉteele nɨɨtenda. Kʉnsoko nɨanso ilowa kʉmʉlompa Itunda azeimɨkile kʉ ntongeela nyʉmba niya kʉtankanɨla Ayahudi nʉ mʉmpelo mpelo nɨya nzɨla ɨantʉ ahʉme kʉakʉlya. Itaɨ kʉmʉtambʉɨla, awaitɨ apantɨkile ɨkɨpegwa kao. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Ingɨ ʉewe nʉkʉmʉlompa Itunda, ingɨle kʉmbele, ʉsʉshe mʉlango, sʉnga wandye kʉmʉlompa ʉ Tata ako nɨshanga wɨgela kikelʉ. Nʉng'wenso nʉɨona nakɨnkʉnkʉ ʉkʉʉpa kɨpegwa kako.<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />‘Ʉnyenye nɨmʉkʉlompa, mʉzeleka kʉtula ninkani yɨdʉ nɨmagila anga ndogoelyo, kʉnsoko nɨ antʉ nɨshanga amʉlɨngile Itunda ɨtenda ʉʉ, nɨanso ɨza alʉngile akʉtegeeligwa kʉnsoko a ʉdʉ wankani yao. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Mʉleke kʉlompa anga enso, kʉnsoko ʉ Tata wanyʉ ʉlɨngile nɨ mʉmaloilwe ize mʉkɨlɨ kʉmʉlompa. <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />Kʉitɨ, Yesʉ wɨkalongoleka kʉaɨla, nɨmʉkʉmʉlompa Itunda, mʉzelompa itɨ,</para>
  <para style="q" vid="MAT 6:9">‘Tata wɨtʉ nʉkolɨ kigʉlʉ,</para>
  <para style="q" vid="MAT 6:9">Lina lako lɨkʉligwe.<verse eid="MAT 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MAT 6:10" />Ʉtemi nʉako ʉze.</para>
  <para style="q" vid="MAT 6:10">Lɨhi nʉloilwe lɨtendeke mihɨɨ anga nɨlɨtendeka kigʉlʉ.<verse eid="MAT 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MAT 6:11" />Ʉkʉpe lelo ndya yitʉ anga nʉwɨkʉpeza<verse eid="MAT 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MAT 6:12" />Ʉkʉlekele imagazo itʉ,</para>
  <para style="q" vid="MAT 6:12">anga ʉsese nɨkɨalekela nɨakʉgazɨɨye.<verse eid="MAT 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="MAT 6:13" />Ʉleke kʉʉtwala mʉʉgeng'wa.</para>
  <para style="q" vid="MAT 6:13">Ingɨ ʉkʉgune mʉmagemo ang'wa shetani.’<verse eid="MAT 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />“Kʉnsoko anga mʉalekele ɨantʉ magazo ao nɨamʉtendee, nʉ Tata wanyʉ ga nʉa kigʉlʉ ʉkʉmʉlekela magazo anyʉ. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Ingɨ anga mʉhite kʉalekela ɨantʉ magazo ao, nʉ Tata wanyʉ ga shanga ʉkʉmʉlekela ʉnyenye magazo anyʉ.<verse eid="MAT 6:15" /></para>
  <para style="s">Makani a kʉgwalya kʉlya</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />Yesʉ wɨkalongoleka kʉmanyisa, wɨkaaila, “Mʉleke kʉtʉla nʉʉkɨa itʉngo nɨmʉgwaɨye kʉlya anga atambʉla ʉteele. Nɨanso ɨhininala kʉ ʉsʉ aonwe nɨantʉ kɨna agwaiye kʉlya. Kʉmʉila taɨ nɨanso apantikile ɨkɨpegwa kao. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Ingɨ ʉewe nʉgwaiye kʉlya, kalala ʉ ʉso wako wikʉye kɨlaha mitwe, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />ingɨ mʉntʉ wɨhi waleke kʉlɨnga kɨna ʉewe ʉgwaiye kʉlya, walɨnge ʉ Tata ako du nɨshanga wigela. Nʉ Tata ako nʉɨona aya nʉkitʉma kɨnkunku ʉkʉʉpa kɨpegwa kako.<verse eid="MAT 6:18" /></para>
  <para style="s">Inonee kiɨkɨlya kɨʉto kansao Kigʉlʉ</para>
  <para style="r">
    <ref loc="LUK 12:33-34">Lʉka 12:33-34</ref></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />Yesʉ wɨkalongoleka kʉaɨla, “Mʉleke kiɨkɨlya Kɨʉto kansao yanyʉ mʉnʉ mihɨɨ mʉ kutu nɨ maling'wana nɨ mabɨɨ ikanza nɨ ii ɨkumʉla nʉkɨa. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Iikilyi insao kigʉlʉ kʉtu nɨ maling'wana nɨ mabɨɨ shanga ɨkanza, nɨ ii shanga ingɨla kia. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Kʉnsoko pa kɨʉto ka nsao yako kɨkolɨ, papo nɨ nkolo ako ɨkikiɨ.<verse eid="MAT 6:21" /></para>
  <para style="s">Nzelya a mʉɨlɨ</para>
  <para style="r">
    <ref loc="LUK 11:34-36">Lʉka 11:34-36</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />Yesʉ wɨkalongoleka kʉaɨla, “Liho lako ingɨ nzelya a mʉili. Anga ɨze liho lako ipanga, nʉ mʉili wako wɨhi ʉkʉtʉla ʉkolɨ mʉ nzelya. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Ingɨ anga ɨtʉle iliho lako labɨpile, nʉmʉili ʉkʉtula mʉkiti. Ʉʉgwa anga ɨtule nzelya mʉnkolo ako kiti, ɨkiti nɨkanso kɨkʉtula kiti kigɨngu.<verse eid="MAT 6:23" /></para>
  <para style="s">Itunda ni nsao</para>
  <para style="r">
    <ref loc="LUK 16:13">Lʉka 16:13</ref>; <ref loc="LUK 12:22-31">12:22-31</ref></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />Yesʉ wɨkaaɨla, “Kʉtilɨ mʉntʉ nʉhʉmile kʉitʉmɨla akʉlʉ abɨɨlɨ itʉngo lɨng'wɨ, kʉnsoko ʉkʉmʉbɨpɨlwa ʉyʉ nʉkigombya nʉyʉ nʉa kabɨɨlɨ; ang'wɨ akʉkamantana nʉng'wɨao nʉ kʉmʉkepya ʉmʉya. Shanga mʉhʉmile kʉmitʉmila Itunda ni nsao.<verse eid="MAT 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />“Yɨyɨ nsoko kʉmʉila, mʉleke kʉsɨga mʉkʉlya ang'wɨ mʉkʉngwa ntʉni mʉhʉme kishiɨ, ang'wɨ matʉgalo nɨmʉloilwe kʉtʉgala. Ʉlɨkalo shanga lʉkʉlʉne kʉkɨla indya? Ang'wɨ mʉili shanga ʉkʉlɨne kʉkɨla ɨmatʉgalo, <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Kolwi nyʉnyɨ, shanga yilɨma hangi shanga ipʉla, hangi ngilanga masalanka. Nɨitɨ ga, Tata wanyʉ nʉa kigʉlʉ wɨilɨsa. Itɨɨ, ʉnyenye shanga mʉsanigwe ne kʉkɨla inyʉnyi? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Itɨɨ, mʉntʉ wɨhi mʉng'wanyu ʉhumile kɨaja wɨongeelye lʉhikʉ lʉng'wɨ nʉla kishiɨ?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />“Nɨkɨ mʉkʉsɨga matʉgalo? Kolwi impʉmbʉʉlʉ niya mʉwɨɨ niidemile. Shanga yitʉma anga mʉlimo ang'wɨ kʉtuma matugalo. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Ingɨ kʉmʉila, nʉ Solomoni ga palʉng'wɨ nʉ ʉgolɨ wakwe wɨhi shanga aɨ wɨtugalaa iza kʉkɨla mpʉmbʉʉlʉ niyanso. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Anga itʉle, Itunda wɨmatʉgalya iza itʉtʉ nɨla mʉng'wapo lelo nɨlɨkolɨ nʉ mʉdaʉ ɨnyalaa. Itɨɨ ʉnyenye, Itunda shanga ʉkʉmʉtʉgala iza kʉkɨla nanso? Ʉnyeye nimʉkepewe nʉ ʉhʉɨɨli!<verse eid="MAT 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 6:31" />Kʉlʉlo, mʉleke kʉtʉla nʉ woa, kɨna kʉʉlya ntʉni ang'wɨ kʉʉng'wa ntuni ang'wɨ kʉʉtʉgala ntʉni! <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Kʉnsoko antʉ nɨshanga amʉlɨngile Itunda wawo iaja kʉnkani niyanso. Tata wanyʉ nʉa kigʉlʉ ʉlɨngile kɨna mʉtakile maintʉ nanso ɨhi. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Itɨ gwa, ʉdumi Ʉtemi wang'wi Itunda, nayo nɨmangɨɨza ɨhi mʉkʉkoteeligwa. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Itɨgwa leki kʉsɨgi mʉdaʉ ʉkela ʉlɨ, kʉnsoko namʉdaʉ ʉlɨngile Itunda. Ʉlwago nʉla lʉhikʉ lʉng'wɨ lʉkondile lʉlo.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">Kʉpɨsɨɨlya nɨangɨɨza</para>
  <para style="r">
    <ref loc="LUK 6:37-38">Lʉka 6:37-38</ref>,<ref loc="LUK 6:41-42">41-42</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />Ʉʉgwa Yesʉ akaaɨla, “Leki kʉapɨsɨɨlya nɨangɨɨza, nʉ nyenye mʉleke kʉpɨsɨɨligwa ni Itunda, <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />kʉnsoko anga itɨ nɨmʉkʉapɨsɨɨlya nɨangiza, nʉnyenye ʉʉ nɨmʉkʉpɨsɨɨligwa ni Itunda, ngele yɨyo yɨɨyo nɨmʉkʉagemeelya ɨanyu, ni Itunda yɨyo ʉkʉmʉgemeelya. <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />Kʉnɨkɨ ʉone kɨntʉ kɨniino mʉliho la mʉnyandʉgʉ wako, papo paapo ʉhite kʉona kɨntʉ kɨkʉlʉ nɨkɨmolɨ mʉliho lako? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Angwɨ, ʉhʉmile ʉlɨ kʉmʉɨla ʉmʉnyandʉgʉ ako, ‘Mʉnyandʉgʉ tɨga nʉkʉhegelye kɨntʉ nɨkɨniino mʉliho lako, itungo lɨlo lɨɨlo ʉewe wingɨɨwe nɨkɨntʉ kɨkʉlʉ mʉliho lako? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Ʉewe wɨmʉteele! Heja hanza kɨntʉ nɨ kɨkʉlʉ nɨkɨkolɨ mʉliho lako, papo yʉkʉnonela kʉmʉhegelya kɨntʉ nɨkɨniino nɨkɨkolɨ mʉliho nɨla mʉnyandʉgʉ ako<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />“Leki kʉapi antʉ nɨ impyani ni mbugi maintʉ ang'wi Itunda aleke kʉmʉpɨlʉkɨla nʉ kʉmʉtaʉla, hangɨ leki kʉpumyi itai ang'wi Itunda kʉantʉ nɨidobya anga ngulima, ahumile kʉpanangɨla.<verse eid="MAT 7:6" /></para>
  <para style="s1">Lompa nʉ kʉpenza nʉ kʉpɨndʉla</para>
  <para style="r">
    <ref loc="LUK 11:9-13">Lʉka 11:9-13</ref></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />“Lompi nʉ nyenye mʉkʉpegwa, penzi nʉ nyenye mʉkʉlija, pɨndʉli nʉnyenye mʉkʉlʉgʉɨlwa. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Kʉnsoko, wɨhi nʉwɨlompa wɨpegwa nʉyʉ nʉwɨpenza wɨlija nʉyʉ nʉwɨpɨndʉla wɨlugʉɨlwa. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />Itɨɨ, nyenyʉ mʉng'wanyu anga ng'wana wakwe wamʉlompe ndya, nʉanso ʉkʉmʉpa igwene? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Ang'wɨ, anga walompwe nsamaki, ʉkʉmʉpa nzokane? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Anga ize ʉnyenye nɨmɨanyamɨlandʉ, mʉlɨngile kʉapa ɨana anyu maintʉ nɨmaza, Kʉlʉ kʉʉlʉ ʉ Tata wanyʉ nʉa kigʉlʉ ʉkitʉma nakɨlɨnkɨɨe.<verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />“Aya ɨhi nɨmʉloilwe ɨantʉ amʉtendeele, nʉnyenye atendeeli ʉʉ. Ɨyɨ yɨyɨ dogoelyo amalagɨɨlyo ang'wa Mʉsa nʉ ʉmanyisi nʉa amanga ang'wi Itunda.<verse eid="MAT 7:12" /></para>
  <para style="s">Mʉlango nʉ ʉpinyɨ</para>
  <para style="r">
    <ref loc="LUK 13:24">Lʉka 13:24</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />Ingɨli kʉkɨɨla mʉlango nʉ ʉpinyɨ, kʉnsoko nzɨla nɨhongile kʉʉlimɨli ingɨ ngalɨ, nʉmʉlango nʉakingɨla kʉng'wanso ʉgalɨ, nɨ antʉ nɨakɨɨe nzɨla nanso ɨdʉ. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Ingɨ nzɨla nɨhongile kʉ ʉpanga mpinyɨ, nʉ mʉlango nʉa kingɨɨla kʉng'wanso ingɨ ʉpinyɨ, nɨ antʉ akeehʉda nɨahʉmile kʉmɨlɨnga nzɨla nanso.<verse eid="MAT 7:14" /></para>
  <para style="s">Mʉtɨ wɨlɨngɨka kʉ nkali yakwe</para>
  <para style="r">
    <ref loc="LUK 6:43-44">Lʉka 6:43-44</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />“Hʉgʉki nɨ amanga aʉteele, antʉ nɨ ɨtendisa kɨna apolo anga nkolo kʉnʉ mʉkatɨ akete ʉlʉgʉ ʉkʉlʉ ɨhanga mbugi. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Mʉkʉalɨnga kʉntendo nɨ akitʉma, itɨ gwa, antʉ ɨkalane matogo mʉ mɨgʉnga, ang'wɨ nkʉyʉ mʉ mʉgagao? A, a! <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Itɨ gwa, mʉtɨ nʉ ʉza wɨpeza nkali ninza, nʉ mʉtɨ nʉ ʉbɨ wɨpeza nkali nimbɨ. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Mʉtɨ nʉ ʉza shanga ʉhʉmile kʉpa nkali nimbɨ, hangɨ mʉtɨ nʉ ʉbɨ shanga ʉhʉmile kʉpa nkali ninza. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Kʉlʉlo mʉtɨ wɨhi nɨshanga wɨpeza nkali nɨnza wɨteng'wa nʉkʉgʉmɨlwa mʉmoto. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Kʉlʉlo antʉ nɨanso mʉkʉalɨnga kʉntendo nɨ akitʉma.<verse eid="MAT 7:20" /></para>
  <para style="s">Shanga nʉmʉlɨngile ʉnyenye</para>
  <para style="r">
    <ref loc="LUK 13:25-27">Lʉka 13:25-27</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />“Ingɨ shanga mʉntʉ wɨhi nʉɨmbɨla, Isekʉlʉ, Isekʉlʉ nʉʉzɨɨzingɨla kʉ ʉtemi nʉwa kigʉlʉ, ingɨ ʉyʉ nʉɨtʉma aya nʉ Tata wane nʉa kigʉlʉ nʉmaloilwe. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Lʉhikʉ nʉla ʉlamʉli antʉ ɨdʉ azɨɨza mbɨla, ‘Isekʉlʉ, Isekʉlʉ! Aɨ kʉtanantilye lʉkani lang'wi Itunda kʉlina lako, aɨ kɨaheja nɨa hing'wɨ nʉ kʉtenda mɨʉkʉɨlwa ɨdʉ kʉ ʉhumi nʉwa lina lako’, <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Papogwa, nzɨɨza mʉɨla, ‘Kwee shanga aɨ nʉmʉmanyile hegi apa itɨ pantongeela ane, anya mɨlandʉ nyee.<verse eid="MAT 7:23" /></para>
  <para style="s">Anyalʉzengo a nyʉmba abɨɨlɨ</para>
  <para style="r">
    <ref loc="LUK 6:47-49">Lʉka 6:47-49</ref></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />“Kʉlʉlo, mʉntʉ wɨhi nʉkʉkela inkani yane izi nɨkʉtambʉla, ʉkimpyanigwa nʉ mʉntʉ nʉkete mahala, naɨ ʉzengile nyʉmba akwe mitalagwe. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Mbʉla nkʉlʉ ɨkakʉa, kɨhʉmo kɨkahʉma, ng'wega ʉkʉlʉ wɨkakʉnka nʉkʉkɨɨla nyʉmba nanso. Ingɨ nyʉmba nanso shanga ɨkagwa kʉnsoko ɨzengilwe mitalagwe.<verse eid="MAT 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 7:26" />“Ingɨ mʉntʉ wɨhi nʉkija inkani yane wahite kʉikomanɨɨlya, wimpyani nʉ mʉntʉ mʉpʉngʉ nʉʉzengile nyʉmba mihanga hanga. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Mbʉla ɨkakʉa, kɨhʉmo kikaza, ng'wega ʉkʉlʉ wɨkakʉnka wɨkamɨhingisa ɨnyʉmba nanso, nɨyo ɨkakumʉka ɨkagwa, ʉgwi wakwe aɨ ʉkʉlʉ.<verse eid="MAT 7:27" /></para>
  <para style="s">Ʉhumi wang'wa Yesʉ</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Yesʉ naɨ wakondya kʉligitya inkani yɨhi izi, milʉndo wɨhi nʉwa antʉ wɨkakʉɨlwa ɨti naɨ ʉkʉmanyisa. <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />Kʉnsoko shanga aɨ ʉkʉmanyisa anga amanyisi amalagɨɨlyo ang'wa Musa, aɨ ʉkʉmanyisa anga mʉntʉ nʉkete ʉhʉmi.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">Yesʉ ʉkʉmʉkomya mʉnyambili</para>
  <para style="r">
    <ref loc="MRK 1:40-45">Maliko 1:40-45</ref>; <ref loc="LUK 5:12-16">Lʉka 5:12-16</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Itungo, Yesʉ naɨ wahulumʉka kʉpuma mʉlʉgʉlʉ, antʉ ɨdʉ ɨkamʉtyata. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Ʉʉgwa mʉntʉ ʉng'wɨ naɨ wambʉe mbili wɨkaza, wɨkatugama pamɨgʉlʉ ang'wa Yesʉ wɨkamʉlompa wɨkalʉnga, “Isekʉlʉ anga ʉlowe ʉhumile, kʉnkomya.<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />Yesʉ wɨkahʉmbʉla ʉmʉkono wakwe, wɨkamʉtonya, wɨkamʉɨla, “Ndoilwe! Komya.” Itʉngo lɨlo mbili a mʉntʉ nʉanso ɨkahega wɨkakomya. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Sʉnga Yesʉ wɨkamʉɨla “Komanɨɨlya! ʉleke kʉmʉtambʉɨla mʉntʉ wɨhi,” “Longola wɨambye kʉ mʉpolyi, ʉpʉmye isongeelyo anga nɨilagɨigwe nu Mʉsa, kʉkamɨnkɨɨlya antʉ kɨna wakomya<verse eid="MAT 8:4" /></para>
  <para style="s">Yesʉ ʉkʉkomya mitʉmi wang'wa mankata nʉakʉ Loma</para>
  <para style="r">
    <ref loc="LUK 7:1-10">Lʉka 7:1-10</ref></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Lʉhikʉ lʉng'wɨ Yesʉ naɨ ʉkingɨla mʉkɨsalɨ ka Kapelinaumu, mʉkʉlʉ ʉng'wɨ nʉwa anyambita a kʉ Lumi wɨkamʉhanga wɨkamɨnena, <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />wɨkalʉnga, “Isekʉlʉ, mitʉmi wane ʉlae mʉ ʉlɨlɨ ʉkʉlwala ʉlwae wɨgandi hangɨ shanga ʉhumile ga nʉkʉpɨlʉka”<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />Yesʉ wɨkamʉɨla “Mpembilye kʉmʉkomya.”<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />Mʉkʉlʉ nʉwa anyambita nʉwanso wɨkamʉɨla “Isekulu shanga ɨnonee ʉewe wingɨle mʉnyʉmba ane. Ingɨ lagɨɨlya ʉdu, mitʉmi wane ʉkʉkomya. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Kʉnsoko, nʉnene ga nɨ mʉntʉ nɨnkolɨ mʉ wɨmɨɨlwi nʉwa antʉ angɨɨza, nkete amboi nɨ nɨɨmɨɨe. Nɨmʉlagɨɨlya ʉng'wɨ wao, ‘Longola! Nʉyo wɨlongola, nʉmʉya nɨmʉɨla, ‘Pembya!’ Nʉyo wɨpembya, nʉmitʉmi wane anga nʉmʉile, ‘Itʉme ikani ɨlɨ! Nʉyo wɨtʉma.”<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />Yesʉ naɨ wija nkani niyanso akakʉɨlwa, wɨkaaɨla ɨantʉ naɨ amʉtyatɨle, “Kʉmʉɨla ɨtai, nkɨlɨ kʉmʉona mʉntʉ wɨhi mihɨɨ a Isilaeli nʉkete ʉhʉɨɨli anga nʉwa mʉntʉ ʉyʉ. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Itɨgwa, kʉmʉɨla kɨna antʉ ɨdʉ akʉpembya kʉpʉma kilya nɨ ng'weli, nawo akikiɨ miloeelya palʉng'wɨ nʉ Ibilahimʉ nʉ Isaki nʉ Yakobo mʉ ʉtemi wang'wi Itunda. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Ingɨ awo naɨatakɨwe kʉteng'wa ni Itunda akʉgʉng'wa kʉnzi mʉkiti, papo gwa akʉlɨlɨla nʉkelya mino.” <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />Sʉnga Yesʉ wɨkamuɨla mankata nʉwanso nʉwa kʉ Loma, “Longola kitolako, nɨɨtule anga nʉʉhʉɨɨe.”</para>
  <para style="p" vid="MAT 8:13">Nʉ mitʉmi wakwe wɨkakomya itungo lɨlo.<verse eid="MAT 8:13" /></para>
  <para style="s">Yesʉ ʉkʉkomya antʉ ɨdʉ</para>
  <para style="r">
    <ref loc="MRK 1:29-34">Maliko 1:29-34</ref>; <ref loc="LUK 4:38-41">Lʉka 4:38-41</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Yesʉ naɨ wingɨla mʉnyʉmba ang'wa Petelo wɨkahanga mʉkwɨngwa nʉwa kɨsʉngʉ nʉ ang'wa Petelo ʉlae mʉʉlɨlɨ mʉlwae do. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Itɨgwa, ʉ Yesʉ wɨkamʉtonya kʉmʉkono mʉsʉngʉ nʉanso itungo lɨlo ʉlwae wɨkamʉleka wɨkakomya, wɨkaʉka wɨkatula anoneelelya ndya.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Lyoa la mpɨndɨ anyakɨsalɨ nɨkanso ɨkamʉletela antʉ ɨdʉ naɨ akete ahɨng'wɨ nawa naɨ alwae. Yesʉ wɨkakenela ahɨng'wɨ ɨkahega, nʉkʉakomya ɨhi ʉ ʉlwae wao. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Aɨ witʉmile itɨ kʉtimɨlya lʉnkani naɨ ʉtambʉe mʉmanga ʉ Isaya,</para>
  <para style="q" vid="MAT 8:17">“Ng'wenso wakʉhegeye ʉnementalu witʉ,</para>
  <para style="q" vid="MAT 8:17">nʉkʉhegelya ndwala yitʉ.”<verse eid="MAT 8:17" /></para>
  <para style="s">Mʉatakɨwe kishiɨ amanyisigwa ang'wa Yesʉ</para>
  <para style="r">
    <ref loc="LUK 9:57-62">Lʉka 9:57-62</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Yesʉ naɨ waona wapilimɨɨligwa nɨ antʉ ɨdʉ, wɨkaalaga amanyisigwa akwe atambʉke kitʉmbi nʉla lʉzɨ la Galilaya. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Sʉnga mʉmanyisi ʉng'wɨ nʉwa malagɨɨlyo ang'wa Musa wɨkamʉhanga ʉ Yesʉ, wɨkamʉɨla, “Mʉmanyisi kʉʉtyata pɨhi nʉkʉhongeela.”<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />Yesʉ wɨkamʉsʉkɨɨlya, “Amʉlʉla akete igaya ni nyʉnyi yikete iuyɨ, Ʉng'waa Mʉntʉ mʉgila paʉlalo.”<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Sʉnga mʉmanyisigwa ʉng'wɨ hangɨ wɨkamʉɨla ʉ Yesʉ, “Isekʉlʉ, ngombye hanza nende nʉmʉɨke ʉ tata wane.”<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Ingɨ Yesʉ wɨkamʉɨla “Aleke antʉ nɨatuile anga akule aaɨke ɨashi aʉya! Ʉewe ntyate.”<verse eid="MAT 8:22" /></para>
  <para style="s1">Yesʉ ʉkʉkɨɨla kɨntingʉ kɨlule</para>
  <para style="r">
    <ref loc="MRK 4:35-41">Maliko 4:35-41</ref>; <ref loc="LUK 8:22-25">Lʉka 8:22-25</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Naɨ akɨla nanso Yesʉ akanankɨla mibɨnɨ ɨkalongolania palʉng'wɨ nɨamanyisigwa akwe. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Itʉngo lilo kɨntingʉ kɨkapumɨla mʉlʉzɨ, ibɨnɨ lɨkakakʉnikilwa ni maɨngo, Yesʉ akaze walala tʉlo. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Amanyisigwa ang'wa Yesʉ ɨkamʉhanga ɨkamʉpitya, ɨkamʉɨla, “Isekʉlʉ, kʉgʉne, kaaka kapɨla kʉshe!”<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />Yesʉ wɨkaasʉkɨɨlya, ‘‘Ka maambwa nʉwoa? Ʉnyenye mɨantʉ nɨa ʉhʉɨɨli ʉniino!” Wɨkaʉka itʉngo lilo, wɨkakikenela ɨkɨntingʉ maɨngo ɨkatɨga ihɨ twɨɨ.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />Antʉ ɨhi ɨkamʉkʉɨlwa ʉ Yesʉ, azelʉnga, “Mʉntʉ ʉyʉ wɨʉlɨ? Ga nɨ kɨntingʉ nɨ maɨngʉ yɨkʉmʉgombya”<verse eid="MAT 8:27" /></para>
  <para style="s1">Yesʉ ʉkʉakomya antʉ abɨɨlɨ nɨakete ahɨng'wɨ</para>
  <para style="r">
    <ref loc="MRK 5:1-20">Maliko 5:1-20</ref>; <ref loc="LUK 8:26-39">Lʉka 8:26-39</ref></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Lʉhikʉ lʉlya Yesʉ naɨwapɨka kitʉmbɨ la lʉzɨ nʉ lʉkʉlʉ kʉ kɨsali ka Agelasi, kʉng'wanso wɨkatankana nɨ antʉ abɨɨlɨ nɨakete ahɨng'wɨ apʉmile mʉibɨɨla. Antʉ nɨanso aɨ aogopilwe nɨ antʉ ɨhi kʉtile naɨ wɨgema kʉkɨɨla nzɨla nanso. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Papo paapo antʉ nɨanso ɨkamitʉntɨɨla ʉ Yesʉ, ɨkamʉɨla, “Ʉewe Ng'wana wang'wi Itunda ʉkʉhiya ʉkʉtende ʉlɨ? Itɨ ʉzee kaja inone, nitʉngo litʉ lɨkɨlɨ lɨpike?”<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Pakʉpɨ nɨpang'wanso aɨyikolɨ ngʉlima yɨdʉ yɨkʉdɨma. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Ahɨng'wɨ nɨanso ɨkaminena ɨkamʉɨla, “Ang'wɨ ʉkʉʉpʉmya mʉantʉ awa, kʉgombye kingɨle mʉngulima izo.”<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />Yesʉ wɨkaaɨla, “Ali longoli.” Papo paapo ahɨng'wɨ lɨkapʉma mʉantʉ nɨanso, yɨngɨla mʉngulima. Idale lɨhi nɨla ngulima lɨkahʉlʉmʉkɨla kʉnsimo nʉkʉgwɨla mʉlʉzi nʉlʉkʉlʉ, ngʉlima yɨhi yɨkashɨla mʉmo.<verse eid="MAT 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33" />Adɨma ngʉlima niyanso ɨkamankɨɨla mʉkɨsalɨ kao, kʉng'wanso ɨkaaganʉɨla ɨantʉ impola yɨhi naɨ yitendekile kʉ antʉ nɨ abɨɨlɨ naɨ ingɨɨwe nɨ ahɨng'wɨ. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Sʉnga, antʉ ɨhi mʉkɨsalɨ nɨkanso ɨkapuma ɨkamʉhanga ʉ Yesʉ, ɨkaminena wahege mʉkɨsalɨ kao.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s1">Yesʉ ʉkʉmʉkomya mʉntʉ nʉkʉle igandi</para>
  <para style="r">
    <ref loc="MRK 2:1-12">Maliko 2:1-12</ref>; <ref loc="LUK 5:17-26">Lʉka 5:17-26</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Sʉnga Yesʉ wɨkanankɨla mibɨnɨ, wɨkatambʉka lʉzɨ wɨkapɨka mʉkɨsalɨ ka Nazaleti naɨ wishiɨ. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Sʉnga antʉ ɨkamʉletela mʉntʉ ʉng'wɨ ʉmʉɨlɨ wakwe aɨ ʉkule igandi amʉlalɨkilye mʉʉlɨlɨ, Yesʉ naɨ waona ʉʉhʉɨɨli wa antʉ nɨanso, wɨkamuɨla mʉlwae nʉwanso, “Ng'waane komya nkolo! Walekelwa mɨlandʉ ako”<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />Amanyisi amalagɨɨlyo ang'wa Musa nɨang'wɨ ɨkandya kʉsɨgɨɨla kɨna, “Mʉntʉ ʉyʉ ʉkʉmʉbehʉla Itunda”<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />Yesʉ akalɨnga ɨmasɨgoao, wɨkaaɨla, ‘‘Kʉnɨkɨ mʉkʉsɨga niibɨ itɨ mʉnkolo yanyu? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Itɨ, nɨlɨʉiɨ nipepele, kʉlʉnga walekelwa ne mɨlandʉ? Ang'wɨ kʉlʉnga, ‘Ʉka ʉgenda? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Itɨgwa, mʉlɨngɨ kɨna Ʉng'wana wang'wa Adamʉ ʉkete ʉʉhʉmi nʉa kʉlekela antʉ ɨmɨlandʉ. Papo paapo wɨkamuɨla ʉmʉlwae ʉyo naɨ ʉkule igandi, “Ʉka kenka nʉʉlɨlɨ wako, longola kito.<verse eid="MAT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7" />Mʉntʉ nʉanso wɨkaʉka, wɨkalongola kito lakwe. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Antʉ ɨhi pamilʉndo nʉanso naɨ aona nanso, ɨkagʉlʉala; ɨkamʉkʉlya Itunda naɨ ʉapee ɨantʉ ʉʉhʉmi anga ʉwʉ.<verse eid="MAT 9:8" /></para>
  <para style="s1">Yesʉ ʉkʉmitanga Matayo</para>
  <para style="r">
    <ref loc="MRK 2:13-17">Maliko 2:13-17</ref>; <ref loc="LUK 5:27-32">Lʉka 5:27-32</ref></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Yesʉ naɨ wahega pang'wanso, wɨkamʉona mʉntʉ ʉng'wɨ lina lakwe Matayo, wɨkiɨ mʉnyʉmba akʉhangɨlya kodi. Yesʉ wɨkamʉɨla “Ntyate.”</para>
  <para style="p" vid="MAT 9:9">Nʉyo wɨkaʉka wɨkamʉtyata.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Yesʉ naɨ wɨkiɨ mʉnyʉmba ang'wa Mathayo walye ndya, kolwa, ahangʉlya kodi nɨanyamilandʉ idʉ ɨkapembya ɨkikiɨ palʉng'wɨ nʉ Yesʉ nɨa manyisigwa akwe alɨzanie ndya. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Apalisayo naɨaona nanso, ɨkaakolya amanyɨsigwa ang'wa Yesʉ, “Kʉnɨkɨ ʉ Yesʉ ʉkʉlɨzania nɨanya mɨlandʉ nɨahangʉlya kodi?”<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />Yesʉ wɨkija, wɨkaaɨla, “Antʉ nɨshanga alwae shanga ɨmʉduma mʉkilɨki, awa nɨalwae wawo ɨmʉduma. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Ʉʉgwa, longoli mimanyise ndogoelyo a nkani izi mʉlɨnge, ‘Ndoilwe kɨaisa, hangɨ shanga ipolyo. ‘Kʉnsoko shanga aɨ nzeitanga antʉ nɨagila milandʉ, ingɨ kʉ anyamilandʉ.<verse eid="MAT 9:13" /></para>
  <para style="s1">Ikolyo lakʉgwalya kʉlya</para>
  <para style="r">
    <ref loc="MRK 2:18-22">Maliko 2:18-22</ref>; <ref loc="LUK 5:33-39">Lʉka 5:33-39</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Sʉnga amanyisigwa ang'wa Yohana Mʉbadisi ɨkamendeela Yesʉ nʉkʉmʉkolya, “Ʉsese nɨ Apalisayo kɨgwalya kʉlya nkʉa yidʉ, nɨkɨ amanyisigwa ako shanga akʉgwalya lʉkʉlʉ kʉlya?<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />Yesʉ wɨkaasʉkɨɨlya, “Itɨɨ, antʉ nɨanilwe mʉwɨnga akʉhʉsha nʉkʉgwalya kʉlya mʉtɨzɨɨla nʉkolɨ palʉng'wɨ nɨenso? A, a! Shanga ʉʉ! Ingɨ itʉngo anga lipike mʉtɨzɨɨla ʉkʉhegigwa mʉng'wao papo akʉhʉsha nʉ kʉgwalya kʉlya.<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />Antʉ shanga ibadɨkɨla ikilaka nikɨpya mitaho. Kʉnsoko ikilaka nɨkanso kɨkʉtamʉla itaho nɨlanso napo naza yitamʉkile yɨkongeeleka. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Hangi antʉ shanga ɨkɨtɨla dibaɨ nɨ mpya mʉmɨpʉko nɨnonigwe kʉ ndɨlɨ a nkolo nɨkʉlʉpae. Anga akɨtɨle, dibaɨ ikʉtumbʉla mɨpʉko nanso nʉkʉhunʉka. Hangɨ mɨpuko nanso ɨkʉgazɨka. Ingɨ antʉ ɨkɨtɨla dibaɨ nɨmpya mʉmɨpuko nɨmɨmpya, dibai nɨ mɨpuko nanso yɨkishiɨ uza.<verse eid="MAT 9:17" /></para>
  <para style="s1">Mʉnanso wa mʉkʉlʉ nʉ mʉsʉngʉ ʉkʉkomigwa</para>
  <para style="r">
    <ref loc="MRK 5:21-43">Maliko 5:21-43</ref>; <ref loc="LUK 8:40-56">Lʉka 8:40-56</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Yesʉ naɨ ʉkʉtambʉla nanso, wɨkapɨka mʉtongeeli ʉng'wɨ nʉwa Ayahʉdi, wikatugama nʉkʉmʉɨla, “Mʉnanso wane washaa ino. Itʉnʉ kwɨni wende ʉmʉlompeele ʉkʉpangatala.”<verse eid="MAT 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 9:19" />Yesʉ wɨkalongola palʉng'wɨ nɨamanyisigwa akwe, ɨkamʉtyata mʉntʉ nʉwanso.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />Naɨ alongoe, mʉsʉngʉ ʉng'wɨ naɨ wɨpʉma sakami matʉngo a myaka ikʉmi na ɨbiili, wɨkamʉlondola Yesʉ, wɨkamʉtonya kʉmpelo itugalo lakwe. <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />Aɨ ʉtendile itɨ kʉnsoko aɨ ʉsigɨɨe mʉnkolo akwe kɨna, “Anga ntonye ʉdu itugalo lakwe, kʉkomya.”<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />Ʉgwa, Yesʉ wɨkapɨlʉka wɨkamʉona, wɨkamʉila, “Mʉnanso, komya nkolo! kʉhʉɨɨla kʉng'wako wakʉkomya.” Itungo lɨlo mʉsʉngʉ nʉwanso wɨkakomya.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Sʉnga Yesʉ wɨkingɨla mʉnyʉmba amʉtongeeli nʉwanso. Hangi naɨ waaona akʉa pɨlɨmbɨ niya sʉka nɨ antʉ ɨdʉ akʉhongeelya, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />wɨkaaɨla, “Hegi apa! Mʉnanso ʉyʉ shanga ʉkʉle, ʉlae ʉdu,” Ingɨ antʉ nɨanso ɨkamʉheka. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Ʉʉgwa, milʉndo wa antʉ nɨanso naɨ wahegigwa, Yesʉ wɨkingɨla kʉmʉlwae, wɨkamʉamba mʉkono mʉnanso nʉwanso wɨkimɨka. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Nkani niyanso yɨkakʉmʉka ga yɨhi mihɨɨ nanso.<verse eid="MAT 9:26" /></para>
  <para style="s1">Yesʉ ʉkʉakomya apoku abɨɨlɨ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Yesʉ naɨ ʉhegile pang'wanso, nʉkʉlongola, apokʉ abɨɨlɨ ɨkamʉtyata ɨzitʉnta nʉkʉminena izelʉnga, “Uewe Ng'wana wang'wa Daudi kʉonele kɨnyaʉwai.<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Yesʉ naɨ wingɨla mʉnyʉmba, apokʉ nɨanso nɨabɨɨlɨ ɨkamʉhanga, nʉng'wenso wɨkaakolya, “Mʉhʉiie kɨna nɨhʉmile kʉmʉkomya? Nienso ɨkamʉsʉkilya, “Ee, Isekʉlʉ kʉhʉiie”<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Papogwa Yesʉ wɨkaatonya mʉmiho ao, wɨkaaɨla, “Itule anga nɨmʉhʉɨɨe” <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Miho ao ɨkapɨtya lʉkʉlʉ. Yesʉ wɨkaagilya nʉkʉaɨla, “Mʉleke kʉmʉila mʉntʉ wɨhi ɨkani ɨlɨ”<verse eid="MAT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 9:31" />Ingɨ nɨanso ɨkalongola, ɨkakʉmʉsha lʉkumo langwa Yesʉ mʉ mahɨɨ ɨhi.<verse eid="MAT 9:31" /></para>
  <para style="s1">Yesʉ ʉkʉmʉkomya kɨmumɨ</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Antʉ naɨ alongola kʉmatolao, antʉ angɨza ɨkamʉletela Yesʉ mʉntʉ nɨ kɨmumɨ kʉnsoko aɨ ʉkete hɨng'wɨ. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Yesʉ naɨ wamʉheja hɨng'wɨ nʉwanso, kɨmumɨ nʉwanso wɨkandya kʉligitya. Antʉ ɨkakʉɨlwa nʉkʉlʉnga, “Ikani anga ɨlɨ ɨza lɨkɨlɨ kigela mʉnʉ mʉ Isilaeli.<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />Ingɨ Apalisayo ɨkatula lʉnga, “Mʉntʉ ʉyʉ ʉkʉpʉmya ahɨng'wɨ kʉngulu nɨya mʉkʉlʉ nʉa ahɨng'wɨ.”<verse eid="MAT 9:34" /></para>
  <para style="s1">Yesʉ ʉkʉaonela kɨnyaʉwaɨ ɨantʉ</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Yesʉ aɨ ʉgendee mʉisali niikʉlʉ nɨzi niiniino, akazemanyisa mʉnyʉmba nɨya kʉtankanɨla Ayahudi nʉkʉtanantya Nkani ni Nza niya ʉtemi nʉwa kigʉlʉ, nʉkʉakomya ndwala yɨhi nʉʉlema wɨhi. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Ʉʉgwa Yesʉ, naɨ wamaona maʉmbi nɨ maʉmbi a antʉ, wɨka aaisɨɨlya kʉnsoko aɨ anementala anga nkolo ningila mʉdɨmi. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Pang'wanso Yesʉ wɨkaaɨla amanyisigwa akwe, “Maintʉ akʉogolwa ɨdʉ, ingɨ aogoli akeehʉ. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Ʉʉgwa mʉlompi Isekʉlʉ Itunda wamʉɨle mʉkola mʉgʉnda wanɨɨle aogoli akwe”<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s1">Itʉmi ikʉmi na abɨɨlɨ</para>
  <para style="r">
    <ref loc="MRK 3:13-19">Maliko 3:13-19</ref>; <ref loc="LUK 6:12-16">Lʉka 6:12-16</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Yesʉ wɨkaɨtanga amanyisigwa akwe ikʉmi na abɨɨlɨ, wɨkaapa ʉhʉmi nʉ wa kʉapumɨlya antu ahɨng'wɨ nʉ kʉakomya ndwala nɨ malwae ɨhi. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />Aya yaya mina a amanyisigwa akwe naɨ ʉitangile itʉmi, nʉwa ng'wandyo Simoni nʉwitangwa Petelo nʉ Andelea mʉluna wang'wa Petelo, Yakobo nʉ Yohana Mʉbadisi mʉluna wakwe ana ang'wa Zebedayo, <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Pilipo nʉ Batilimayo nʉ Tomaso nʉ Matayo naɨ mʉhangʉlya kodi; nʉ Yakobo ng'wana wang'wa Alipayo nʉ Tadayo, <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />nʉ Simoni nʉɨmɨkʉɨla ihɨ akwe nʉ Yʉda Isɨkaliote, ʉyʉ yʉyo naɨ ʉmʉsuɨpile ʉ Yesʉ.<verse eid="MAT 10:4" /></para>
  <para style="s1">Yesʉ ʉkʉalagɨɨlya itʉmi ikʉmi na abɨɨlɨ</para>
  <para style="r">
    <ref loc="MRK 6:7-13">Maliko 6:7-13</ref>; <ref loc="LUK 9:1-6">Lʉka 9:1-6</ref></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Naɨ waahola itʉmi awa ni ikʉmi na abɨɨlɨ Yesʉ wɨkaalagɨɨlya itɨ, “Mʉleke kenda kʉantʉ nɨshanga Ayahʉdi, ang'wɨ mʉleke kingɨla mʉisalɨ niya Asamalɨa. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Longoli kʉ Asilaeli, awa ɨhanga anga nkolo niilimɨe. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Longoli mʉtanantye, ‘Ʉtemi nʉa kigʉlʉ wahʉmbeela.’ <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Mʉakomye alwae, mʉiʉshe nɨakule nɨanyambili mʉakomye nawaitɨ nɨ ingɨiwe nɨ ahing'wɨ mʉapumɨlye. Mʉpewe ʉhʉmi ʉwʉ nakanda, mʉzeleka kʉhɨa kʉlɨpwa. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Mʉmɨpuko anyu leki kʉholi zahabʉ ang'wɨ mpɨa ang'wɨ magwe a peza. <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />Leki kikenkeelyi mbogoshi ang'wɨ matʉgalo akʉkaɨla, ang'wɨ ilatʉ ang'wɨ mʉlanga, kʉnsoko mitʉmi wɨhi wɨpantɨka kinyamʉlɨmo kakwe.<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />“Anga mingɨle mʉkɨsalɨ ni kɨkʉlʉ ang'wɨ kɨsalɨ nɨ kɨniino, dʉmi mʉntʉ nʉmʉkende wamʉsɨngɨɨlye, mikiɨ papo kʉpikɨɨla nɨmʉkʉhega pang'wanso. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Anga mingɨle mʉnyʉmba nanso, alamʉshi muzelʉnga, matiliga atule kʉng'waanyu. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Akola nyʉmba nanso anga amʉsɨngɨɨlye, matiliga anyu akʉtula palʉng'wɨ nɨenso. Ingɨ anga itule akola nyʉmba nanso shanga akʉmʉsɨngɨɨlya, matiliga akʉmʉsʉkɨla. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Mʉntʉ wɨhi nɨshanga ʉkʉmʉsɨngɨɨlya, nɨmʉkʉpuma mʉ kɨsalɨ nɨkanso, pyagʉli ʉlʉnkʉndɨ nʉlamɨgʉlʉ anyu, itule kɨlɨngasɨɨlyo kɨna amʉhita. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Kʉmʉila ɨtai, antʉ nɨa ɨitɨ lʉhikʉ nʉlaʉlamʉlwa Itunda ʉkʉpɨsɨɨligwa kʉkɨla antʉ a kʉ Sodoma nɨ Gomola<verse eid="MAT 10:15" /></para>
  <para style="s">Lwago nʉlʉpembilye</para>
  <para style="r">
    <ref loc="MRK 13:9-13">Maliko 13:9-13</ref>; <ref loc="LUK 21:12-17">Lʉka 21:12-17</ref></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />Yesʉ wɨkalʉnga, “Itungo ɨlɨ, ʉnene kʉmʉtʉma mʉantʉ nɨabi mʉtʉle mɨapolo anga inkolo niikolɨ pambʉgi. Mʉtʉle mɨahʉgʉ anga inzoka, hangi mʉzemɨapolo anga nkʉnda. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />Hʉgʉki nɨantʉ, kʉnsoko akʉmikʉngʉmya nʉ kʉmʉtwala mʉ maanza nʉ kʉmʉkʉa mʉnyʉmba niyakʉtankanɨla Ayahʉdi. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Mʉkʉtwalwa kʉntongeela atemi kʉnsoko ane, mʉhume kʉatanantilya Nkani ni Nza enso nɨ ntongeela antʉ nɨshanga Ayahudi. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Itɨ gwa, anga amʉtwale mʉ maanza, mʉleke kʉsɨgɨɨla nʉla kʉsʉkɨɨlya, itʉngo lɨlo mʉkʉpegwa lʉkani nʉla kʉsʉkɨɨlya. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Kʉnsoko shanga nyenye nimʉkʉtambʉla, ingɨ Ng'wahʉ Ng'welʉ nɨ Tata wanyu nʉkoli mʉkolo yanyʉ yʉyo ʉkʉtambʉla.<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />Mʉntʉ ʉkʉmʉsuɨpa mʉluna wakwe wabʉlagwe, ihe ʉkʉmʉsuɨpa ʉng'wana wakwe wabʉlagwe, nɨ ana akʉasuɨpa aleli ao ahume kʉbʉlagwa. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Antʉ akʉmʉhʉkilwa ʉnyenye kʉnsoko alina lane. Ingɨ gwa ʉyʉ nʉkʉgimya kʉpikɨɨla mpelo, Itunda ʉkʉmʉponia. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Ingɨ anga magigwe nɨantʉ mʉkɨsalɨ king'wɨ, longoli mʉkɨsalɨ kɨngɨza. Kʉmʉɨla ɨtai shanga mʉkʉmala kʉigendeela isalɨ nɨya Aisilaeli ʉnene Yesʉ nɨze nkɨlɨ kʉtulya.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />“Mʉmanyisigwa shanga wɨmʉkilya ʉ mʉmanyisi wakwe, nʉ mʉtugwa shanga wɨmʉkɨlya mʉgolɨ wakwe. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Ikondile mʉmanyisigwa watule anga mʉmanyisi wakwe, nʉ mʉtugwa watule anga mʉkʉlʉ wakwe. Anga ɨtʉle antʉ akʉmitanga mʉkola nyʉmba Beelizebʉli! Itɨɨ, antʉ aʉya mʉnyʉmba nanso shanga akitangwa mina nɨ mabɨ nangalune?<verse eid="MAT 10:25" /></para>
  <para style="s">Nʉwa kogopwa</para>
  <para style="r">
    <ref loc="LUK 12:2-7">Lʉka 12:2-7</ref></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />Yesʉ akalongoleka kʉaɨla, “Itɨ gwa, mʉleke kʉogopa antʉ nɨanso. Kʉnsoko ɨpiha maintʉ nɨakitʉma mahikʉ apembilye makani ɨhi napihilwe aze umbʉʉlwa, ni kɨntʉ kɨhi nɨkaʉnkunku kɨzɨɨza kumʉka. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Lʉkani nɨnʉmʉtambʉɨe kɨnkunku, ʉnyenye tambʉli mʉmagalagalo, nkani nɨkʉmʉpwepwela, ʉnyenye tanantyi mʉʉgalagalo. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Leki kʉogopi ɨantʉ nɨahumille kʉʉbʉlaga mʉɨlɨ nʉwako, ingɨ shanga ahʉmile kʉbʉlaga nkolo a mʉntʉ. Bahʉ kʉmogopa ʉyʉ nʉhʉmile kʉlimansɨɨlya mʉili nɨ nkolo kʉʉlʉngʉ mʉ moto nɨ shanga wɨlima. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Itɨɨ, nsense ibɨɨlɨɨ yɨgʉligwa senti ɨng'wɨ. Ingɨ kʉtilɨ nɨyɨ nɨng'wɨ nɨlimɨla ʉ Tata wanyʉ shanga waze ʉmɨine. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Ingɨ ʉnyenye, ʉaiye nɨ nsingi nɨya mʉmatwe anyʉ. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Kʉlʉlo leki kogopi, kʉnsoko ʉnyenye mʉkete nsaɨlo kʉng'wi Itunda kʉkɨla nsense ni yɨdʉ.<verse eid="MAT 10:31" /></para>
  <para style="s">Kʉmʉgomba nʉ kʉmʉhita ʉ Yesʉ</para>
  <para style="r">
    <ref loc="LUK 12:8-9">Lʉka 12:8-9</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />“Mʉntʉ wɨhi nʉkʉngomba nʉ kʉntanantya mʉmilʉndo kɨna nʉanso wane, nʉnene ga nzɨza mʉgomba pantongeela ang'wa Tata wane nʉwa kigʉlʉ. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Ingɨ mʉntʉ wɨhi nʉkʉnihita ntongeela a antʉ kɨna ʉnene singa nɨakwe, nʉ nene nzɨɨza mʉhita pantongeela ang'wa Tata wane nʉwa kigʉlʉ.<verse eid="MAT 10:33" /></para>
  <para style="s">Wilei</para>
  <para style="r">
    <ref loc="LUK 12:51-53">Lʉka 12:51-53</ref>; <ref loc="LUK 14:26-27">14:26-27</ref></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />Yesʉ wɨkalʉnga hangɨ, “Leki kʉsɨgi kɨna ndetile matiliga mihɨɨ. Ingɨ shanga ndetile anga matiliga, ndetile wilei. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Kʉnsoko ndetile ʉkinyɨli kung'wi ihe nʉ ng'wana, kʉ mʉnanso nʉ nyinya, nʉ kʉ mʉkʉmʉlima nʉ mʉkwɨngwa wakwe. <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />Nɨ alʉgʉ a mʉntʉ ingɨ awa nɨa mʉnyʉmba akwe<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />“Mʉntʉ wɨhi nʉmʉloilwe ihe ang'wɨ nyinya kʉkila nʉndoilwe ʉnene, nʉanso shanga ʉtakiwe kʉtula wane. Nʉmʉloilwe mʉhʉmba wakwe ang'wɨ mʉnanso wakwe kʉkila kʉndowa ʉnene, shanga ʉtakiwe kʉtula mʉmanyisigwa wane. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Mʉntʉ wɨhi nɨ shanga ʉkʉkenka mʉsalaba wakwe nʉ kʉntyata, shanga ʉkʉhʉma kʉtʉla mʉmanyisigwa wane. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Mʉntʉ wɨhi nʉloilwe kʉmiponia nkolo akwe kʉnsoko ane ʉkʉmilimɨlya, ingɨ mʉntʉ wɨhi nʉʉkʉlimɨlya nkolo akwe nsoko ane ʉkʉmɨponia.<verse eid="MAT 10:39" /></para>
  <para style="s">Antʉ nɨakʉsɨngɨɨlya kɨpegwa</para>
  <para style="r">
    <ref loc="MRK 9:41">Maliko 9:41</ref></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />Sʉnga wɨkalongoleka kʉatambʉɨla “Mʉntʉ wɨhi nʉkʉmʉsɨngɨɨlya ʉnyenye mʉmato lao, ʉkʉtula wansɨngɨɨlya ʉnene, nʉyo nʉkʉnsɨngɨɨlya ʉnene, ʉkʉtula wamʉsɨngɨɨlya ʉyo naɨ ʉndagɨɨye ʉnene. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Mʉntʉ ʉyʉ nʉkʉmʉsɨngɨɨlya mʉmanga kʉnsoko ingɨ mʉmanga, ʉkʉpegwa kipegwa ka mʉmanga. Nʉʉkʉmʉsingɨɨlya mʉntʉ nʉ mʉkende kʉnsoko ingɨ mʉntʉ mʉkende, ʉkʉpegwa kipegwa ka mʉntʉ nʉ mʉkende. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Kʉmʉɨla ɨtai, mʉntʉ wɨhi nʉʉkʉmʉpa mazɨ wang'we mʉkikombe kʉnsoko akʉtula mitʉmi wane mʉniino, Itunda ʉkʉmʉpeza kɨpegwa kakwe.”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">Yesʉ ʉkʉmʉganʉla ʉza ʉ Yohana Mʉbadisi</para>
  <para style="r">
    <ref loc="LUK 7:18-35">Lʉka 7:18-35</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Yesʉ naɨ wakondya kʉapa malago amanyisigwa akwe ikʉmi na abɨɨlɨ, wɨkahega pang'wanso, wɨkalongola kʉmanyisa nʉ kʉtanantya mʉisalɨ nɨyakʉ Galilaya.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Yohana Mʉbadisi aɨ watungilwe migeleza wɨkija makani naɨ witʉma Kilisito. Itɨgwa, wɨkaalagɨɨlya amanyisigwa akwe amʉhange ʉ Yesʉ, <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />ende amʉkolye “Itɨɨ, yʉ wewe nʉpembilye ne, ang'wɨ kʉmʉloeele mʉngɨza?”<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />Yesʉ wɨkaasʉkɨɨlya, “Longoli mʉmʉɨle ʉ Yohana Mʉbadisi makani ɨhi nɨmigulye nʉkiloeela. <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />Apokʉ akʉona nɨ akɨtele akʉgenda nɨ anyambili akeligwa nɨ agʉlʉ akija nɨ akʉle akiʉkigwa nɨ ahimbɨ akʉtanantiligwa Nkani ni Nza. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Ʉkembetilwe mʉntʉ wɨhi nɨ shanga ʉmbɨpɨwe ʉnene.”<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Itɨgwa amanyisigwa ang'wa Yohana Mʉbadisi naɨ alongola, Yesʉ wɨkandya kʉʉtambʉɨla mɨlʉndo wa antʉ mpola yang'wa Yohana Mʉbadisi kɨna, “Mʉwɨɨ aɨ mendile goza ntʉni? Iti gwa aɨ mʉtakile kihenga mapwa nɨmalɨpu nakʉhingisigwa nʉ ng'wega ne? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Itɨgwa, aɨminzʉ goza ntʉni? Aɨ minzʉ goza mʉntʉ nʉtʉgae matʉgalo nɨ maza ne? Antʉ nɨɨtʉgala matʉgalo nɨmaza ikiɨ mʉnyʉmba ya kɨtemi. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Ingɨ, aɨ mendile goza ntʉni? Mʉmanga ne? Ee, kʉlʉ kʉʉlʉ ʉkɨlɨnkɨɨe mʉmanga. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />“Ʉyʉ yʉyʉ Yohana Mʉbadisi nʉganʉwe ni Itunda mʉ ʉandɨkwa nʉa Nkani Nza kɨna,</para>
  <para style="q" vid="MAT 11:10">‘Kolwa, ʉnene kʉmʉlagɨɨlya mitʉmi wane nʉ wa kigʉlʉ wakʉtongeele, nʉʉkʉnoneelelya ʉkɨɨlo wako.’<verse eid="MAT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11" />Kʉmʉɨla ɨtai, mʉʉtugwa nʉa antʉ, wakɨlɨ kigela nʉ mʉkʉlʉ kʉkɨla Yohana Mʉbadisi. Nɨitɨ ga, ʉyʉ nʉ mʉniino mʉ Ʉtemi nʉa kigʉlʉ, nʉanso mʉkʉlʉ kʉkɨla ʉ Yohana Mʉbadisi. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Kandɨɨlya matʉngo ang'wa Yohana Mʉbadisi nɨ sambʉ nʉyʉ, ʉtemi nʉwa kigʉlʉ wɨdagwa kʉngulu, nɨ anyangʉlʉ wawo ɨgema kʉʉhola ʉtule wao. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Ʉmanyisi wɨhi nʉwa Amanga nɨ malagɨɨlyo ang'wa Musa aɨ ɨpumya mɨloto aʉtemi wang'wi Itunda kʉpikɨɨla itungo lang'wa Yohana Mʉbadisi Mʉbadɨsi. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />Anga ɨze mʉhʉmile kʉgomba, ingɨ ʉ Yohana Mʉbadisi yʉyo Elia mʉmanga naɨ ʉmʉtambʉwe kɨna aɨ ʉzɨɨza. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Nʉkete akʉtwɨ akija nʉ wije.<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />“Itɨgwa, nɨimpyanie nɨ ntʉni antʉ amahikʉ aya? Wimpyani nɨahʉmba nɨikiɨ mʉʉgalagalo, azikolya iumbɨ lɨng'wɨ niumbɨ lʉlya. <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />‘Kʉkʉile impɨlɨmbɨ ʉnyenye shanga maina. Kɨmbile ɨmɨmbo asʉka, ʉnyenye shanga malɨla!’ <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />Kʉnsoko Yohana Mʉbadisi aɨʉzile, akazegwalya kʉlya hangi shanga aɨ ʉng'wee idibaɨ, ɨkalʉga. ‘Ʉyʉ ʉkete ahɨng'wɨ.’ <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Ng'wana nʉwa Mʉntʉ, wɨkɨza wazelya nʉ kʉng'wa, nɨanso ɨkalʉnga. ‘Mʉgozi ʉyʉ mʉlakʉ hangɨ mʉgala ntʉli, ɨkɨhʉmba shʉya nɨahangʉlya kodi nɨ anyamilandʉ!’ Nɨiti ga, mahala ang'wi Itunda a tai igeela kʉ ntendo yakwe nʉwitʉma.”<verse eid="MAT 11:19" /></para>
  <para style="s">Isalɨ ya antʉ nɨ shanga ahʉɨɨe</para>
  <para style="r">
    <ref loc="LUK 10:13-15">Lʉka 10:13-15</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Sʉnga Yesʉ wɨkandya kʉizuma isalɨ niyanso naɨ witʉmile miʉkʉɨlwa dʉ antʉ nɨanso shanga ɨkagomba kila itʉnʉ nʉ kʉleka ʉbɨ wao. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />“Akaga anya kʉ Kolazini! Nɨ anya kʉ Betisaɨda akaga! Kʉnsoko mɨʉkʉɨlwa naɨtendekile kʉng'wanyʉ anga aɨtendeke kʉ kisalɨ ka Tilo nʉkʉ Sidoni, antʉ akʉng'wanso aɨazetugama ilɨngɨke kɨnaila itʉnʉ alekelwa mɨlandʉ. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Nɨitɨ ga kʉmʉɨla, lʉhikʉ nʉlampelo ʉnyenye mʉkʉpɨsɨɨligwa ikʉlʉ kʉkɨla antʉ a kisali ka Tilo nɨ Sidoni. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Nʉnyenye anya kʉ Kapalinaumu, Itɨɨ, mʉkikʉlya nʉ kigʉlʉ ne? Ʉkʉsimigwa kihɨɨ a antʉ nɨakulee! Kʉnsoko mɨʉkʉɨlwa naɨtedekile kʉng'wanso anga aɨ ɨtendeke kʉ Sodoma antʉ ihɨɨ nanso ize akɨlɨ akolɨ nitungo ɨlɨ. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Ingɨ kʉmʉila, lʉhikʉ nɨla ʉpɨsɨɨligwa wanyʉ mʉkʉpɨsɨligwa ikʉlʉ kʉkila antʉ akʉ Sodoma”<verse eid="MAT 11:24" /></para>
  <para style="s">Pembyi mʉsʉpye kʉng'wane</para>
  <para style="r">
    <ref loc="LUK 10:21-22">Lʉka 10:21-22</ref></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Itʉngo lɨlo Yesʉ wɨkalʉnga, “Ʉwewe Tata, nakʉsongeelya Isekʉlʉ nʉ wigʉlʉ ni hɨɨ, kʉnsoko nɨasomile nawanɨakete mahala ʉapihɨe makani aya, wɨkaakunʉkʉɨla antʉ nɨɨhanga ang'enya. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Ee Tata, ʉʉ aɨikʉloeeye yɨpumɨle.<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />“Tata ane ʉmpee iintʉ yɨhi, kʉtile nʉmʉlɨngile Ng'wana, ingɨ Tata, hangɨ kʉtile nʉmʉlɨngile ʉ Tata, ingɨ ʉ Ng'wana, nʉ mʉntʉ wɨhi Ng'wana ʉmʉloilwe wamʉlagɨɨle,<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />“Pembyi kʉng'wane, ʉnyenye mɨhi nɨmagigwa nʉkʉbunwa nɨ mɨlandʉ, nʉnene kʉmʉsupɨɨlya. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Ngombi ʉnene nʉkʉnintʉmɨla, mimanyise kʉngwane kʉnsoko ʉnene nɨ shanga nɨmʉtaki hangɨ shanga nilolya, nʉ nyenye mʉkʉsupya. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Kʉnsoko ʉmanyisi wane nɨnɨkʉmʉmanyisa lʉtotu, nʉ mʉligo wane ʉpepele”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">Makani amʉ Sabato</para>
  <para style="r">
    <ref loc="MRK 2:23-28">Maliko 2:23-28</ref>; <ref loc="LUK 6:1-5">Lʉka 6:1-5</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Itʉngo nɨlanso Yesʉ aɨʉkiila mʉmigʉnda nilimilwe ngano, lʉhikʉ nʉlakʉsupya. Iamanyisigwa akwe ahung'wa nzala, ɨkatula nʉpʉʉla ngano, nʉkʉlya nseke ya ngano. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Apalisayo naɨaona itɨ ɨkamʉila Yesʉ, “Gozakati, amanyisigwa ako akitʉma ɨkani nɨshanga linonee kitʉma lʉhikʉ nʉla kʉsupya.”<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />Ingɨ Yesʉ wɨkaasʉkɨɨlya, “Itɨɨ, mʉkiline kʉsoma ʉ Daudi palʉng'wɨ nɨaʉya naɨʉtendile apo naɨahumilwe i nzala? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Daudi nɨaʉya ikingɨla mʉnyʉmba ang'wi Itunda ɨkalya ɨmɨkate iyo naɨikilwe munyʉmba ang'wi Itunda. Imɨkate nanso shanga aɨagombigwe kʉlɨgwa nʉmʉntʉ wɨhi nɨshanga mʉpolyi. <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Ang'wɨ mʉkiline kʉsoma mʉmbʉgʉlʉ amalagɨɨlyo kɨna, apolyi ileka kitʉma mahikʉ ɨhi natakiwe mʉlʉhikʉ nʉlakʉsupya papo pitekeelo, ingɨ shanga ɨsɨgɨɨlwa kɨna agazilye? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Ʉʉgwa, nʉmʉɨɨe mʉlɨnge kɨna apa ʉkolinʉ mʉkʉlʉ kʉkila nyʉmba ang'wi Itunda. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Angamʉlɨnge insoko ankani izi kɨna. ‘Ndoilwe kɨaɨsa shanga ipolya,’ shanga aɨmʉzeapɨsɨɨlya antʉ nɨagilanga mɨlandʉ. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Ndogoelyo Ng'wana wang'wi Itunda ʉkete ʉʉhʉmi mʉ lʉhikʉ lakʉsupya<verse eid="MAT 12:8" /></para>
  <para style="s">Mʉntʉ nʉpoiye mʉkono</para>
  <para style="r">
    <ref loc="MRK 3:1-6">Maliko 3:1-6</ref>; <ref loc="LUK 6:6-11">Lʉka 6:6-11</ref></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Yesʉ wɨkahega pang'wanso, wɨkalongola pa ʉtankanɨlyo wa Ayahudi. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Aiʉkoli mʉntʉ ʉng'wɨ naɨ ʉpoiye mʉkono. Ʉʉgwa antʉ ɨkamʉkolya Yesʉ, “Itɨɨ, inoneene kʉmʉkomya ʉmʉntʉ mʉlʉhikʉ nʉla kʉsupya? “Aɨamʉkoiye iti akazedʉma nsoko nakʉmʉsemela.”<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />Ingɨ Yesʉ wɨkaakolya, “Ʉnyenye, angaɨze ʉng'wɨ wanyu ʉkete mʉtugo wakwe ʉgwɨle mikombo lʉhikʉ nʉla kʉsupya, shanga ʉkʉmipʉmyane lʉhikʉ nʉlakʉsupya? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Lingɨ ʉmʉntʉ ʉkʉigwe kʉkila mʉtugo! Itɨgwa, inonee kitʉma nɨmaza lʉhikʉ nʉlakʉsupya.” <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />Sʉnga wɨkamuɨla ʉmʉntʉ nʉanso, “Goola ʉmʉkono wako”</para>
  <para style="p" vid="MAT 12:13">Wɨkaʉgoola, wɨkatula ʉpanga, anga ʉʉya. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Itɨgwa, Apalisayo akapʉma kʉnzi, akatula kisija akʉhuma ʉlɨ kʉmʉbʉlaga ʉ Yesʉ.<verse eid="MAT 12:14" /></para>
  <para style="s">Mitʉmi nʉhoilwe kʉmʉlɨmo wang'wi Itunda</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Ingɨ Yesʉ naɨ walɨnga masɨgoao, wɨkahega pang'wanso. Antʉ ɨdʉ ɨkamʉtyata, wɨkaakomya ɨhi, <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />wɨkaagilya aleke kʉmʉtambʉila mʉntʉ wɨhi, <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />yɨhume kʉkondaɨɨla nkani nayɨtambʉwe nɨ Itunda kʉkɨɨla mʉnyakɨdagʉ Isaya.<verse eid="MAT 12:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="MAT 12:18" />“Kolwi ʉmʉtʉmi wane nɨ nʉmʉpʉmilye, mʉlowa wane nʉndoeeye mʉ nkolo ane.</para>
  <para style="q" vid="MAT 12:18">Nkolo ane kʉɨka mʉng'wakwe, nʉyo ʉkʉatanantilya ʉʉpɨsɨɨligwa wane ɨantʉ andʉgʉ yɨhi.<verse eid="MAT 12:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="MAT 12:19" />Izemʉgila anga nkʉngʉmi,</para>
  <para style="q" vid="MAT 12:19">hangɨ shanga ʉkʉzogolya,</para>
  <para style="q" vid="MAT 12:19">hangɨ lʉli lakwe shanga lʉkigigwa mʉ mapanda.<verse eid="MAT 12:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="MAT 12:20" />Lʉkito nʉlʉnempu shanga ʉkʉbunɨka,</para>
  <para style="q" vid="MAT 12:20">nʉ lʉmʉlɨ ga nʉlʉkʉzizila shanga ʉkʉlimisa, kʉpikɨɨla nʉʉkʉɨka ʉtemi ʉʉpisiilya nʉ wa taɨ,<verse eid="MAT 12:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="MAT 12:21" />antʉ andʉgʉ yɨhi akʉsʉmbɨɨlya.”<verse eid="MAT 12:21" /></para>
  <para style="s">Yesʉ nʉ Mʉkʉlʉ nʉa Ahɨng'wɨ</para>
  <para style="r">
    <ref loc="MRK 3:20-30">Maliko 3:20-30</ref>; <ref loc="LUK 11:14-23">Lʉka 11:14-23</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Lʉhikʉ lʉng'wɨ antʉ ɨkamʉletela Yesʉ mʉntʉ mʉpokʉ hangɨ kɨmʉmɨ kʉnsoko aɨ asakɨgwe nʉ hɨng'wɨ. Yesʉ wɨkamʉkomya wɨkahuma kʉgoza nʉkʉligitya. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Antʉ ɨhi ɨkakʉɨlwa ɨkalʉnga, “Itɨɨ, shanga yɨhumɨkile ne kʉtula ʉyʉ yʉyʉ Ng'wana wang'wa Daudi?”<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />Ingɨ Apalisayo naɨ ija nanso ɨkalʉnga, “Ʉmʉntʉ ʉyʉ ʉkʉpegwa ʉhumi nʉwakʉaheja ahɨng'wɨ kʉ ngulu ya mʉkʉlʉ nʉwa ahɨng’wɨ ʉ Belizebʉli.<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />Ingɨ Yesʉ wɨkalɨnga masɨgoao, wɨkaaɨla, “Ʉtemi wɨhi anga ʉtemanʉke maumbɨ maumbɨ ʉkikʉa wɨʉlya anga ngʉlʉ nɨya kʉtema, hangɨ kɨsalɨ kɨhi ang'wɨ ndʉgʉ ɨhi anga ɨtemanʉke nʉ kikʉngʉma, ikʉbalansana. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Anga ɨtʉle hɨng'wɨ ʉkʉmʉzunsa hing'wɨ mʉya, kʉlʉlo ʉtemi akwe shanga ʉkʉlʉngoleka ne? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Ʉnyenye mʉkʉlʉnga kɨna ʉnene kʉheja ahɨng'wɨ kʉngulu yang'wa Belizebʉli, itɨɨ, ahemba anyʉ ɨheja ahɨng'wɨ kʉngulu yang'wa nyenyʉ? Kʉnsoko nanso, enso akʉmʉlamʉla ʉnyenye. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Ingɨ anga ɨtʉle kʉaheja ahing'wɨ kʉngʉlʉ ya Ng'wahʉ Ng'welʉ, itɨ gwa lɨngi kɨna ʉtemi wang'wi Itunda waza kʉng'wanyu.<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />“Kʉtilɨ anga mʉntʉ nʉhumile kingila mʉnyʉmba a mʉntʉ nɨ mʉnyangulu nʉkʉmʉhegelya insao yakwe, ɨze shanga ʉmʉtungile hanza mʉnyangʉlʉ nʉwanso? Ʉtakɨwe wamutunge hanza, papo gwa ʉkʉhuma kʉmʉhegelya insao yakwe.<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />“Mʉntʉ wɨhi nɨshanga ʉkʉkamɨnkana palʉng'wɨ nʉnene, wɨnsuta nʉnene, nʉ mʉntʉ wɨhi nɨshanga ʉkilingɨɨla palʉng'wɨ nʉnene, wɨkulanga. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Itungo ɨlɨ kʉmʉɨla, antʉ akʉlekelwa ɨmɨlandʉ ɨhi nɨ kɨbehʉli kao kɨhi. Ingɨ shanga akʉlekelwa ɨmɨlandʉ nɨakʉmʉbehʉla ʉ Ng'wahʉ Ng'welʉ. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Hangi, mʉntʉ wɨhi nʉkʉligitya lʉkani lakʉmʉgilya ʉ Ng'wana nʉwa Mʉntʉ ʉkʉlekelwa ɨmɨlandʉ, ingɨ ʉyʉ nʉkʉmʉbehʉla ʉ Ng'wahʉ Ng'welʉ shanga ʉkʉlekelwa ɨmɨlandʉ, itʉle mʉnʉ mʉ ʉnkʉmbigʉlʉ, ang'wɨ mʉ ʉnkʉmbigʉlʉ nʉ ʉpembilye.<verse eid="MAT 12:32" /></para>
  <para style="s">Mʉtɨ ni nkali yakwe</para>
  <para style="r">
    <ref loc="LUK 6:43-45">Lʉka 6:43-45</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />Yesʉ wɨkalongoleka kʉtambʉla “Mʉtɨ nʉʉza wɨpaa nkali ni nza, ang'wɨ mʉtɨ nʉ ʉbɨ wɨpaa nkali ni mbɨ. Mʉtɨ wɨmanyɨka kʉ nkali yakwe. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Ʉnyenye ni mɨabɨ anga nzoka niyɨkete ʉhʉngʉ! Mʉhʉmile ʉlɨ kʉligitya nkani nɨnza kʉnʉ ʉnyenye mɨabi? Kʉnsoko mʉntʉ wɨligitya nizʉe mʉnkolo akwe. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Mʉntʉ nʉ mʉkende wɨpʉmya ʉkende kʉpuma mʉ nkolo akwe, nʉ mʉntʉ nɨ mʉbɨ wɨpumya ʉbɨ wakwe mʉnkolo akwe.<verse eid="MAT 12:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 12:36" />“Ingɨ kʉmʉtambʉila, kɨna nkani yɨhi nimbɨ nɨakʉligitya antʉ azɨɨza iganʉla yɨhi nɨ mbɨ naɨ utendile. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Kʉnsoko kʉ nkani yako ʉkʉaligwa kɨna wɨmʉtenda maza, hangɨ kʉnkani yako ʉkʉpɨsɨɨligwa kɨna ʉkete milandʉ.”<verse eid="MAT 12:37" /></para>
  <para style="s">Kʉhiya kɨlɨngasɨɨlyo</para>
  <para style="r">
    <ref loc="MRK 8:11-12">Maliko 8:11-12</ref>; <ref loc="LUK 11:29-32">Lʉka 11:29-32</ref></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Sʉnga amanyisi ang'wɨ nɨ amalagɨɨlyo ang'wa Musa nɨ Apalisayo ɨkamʉɨla Yesʉ, “Ʉewe Mʉmanyisi, kʉloilwe kʉone kɨlɨngasɨɨlyo kʉpʉma kʉng'wako. <verse eid="MAT 12:38" /><verse number="39" style="v" sid="MAT 12:39" />Yesʉ wɨkaasʉkɨɨlya, “Wileli ʉwʉ nʉʉbi nʉa ʉsambo, wɨduma kɨlɨngasɨɨlyo, shanga kɨkʉpegwa, ingɨ mʉmanga Yona kɨko kɨlɨngasɨɨlyo kʉng'wao. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Anga ʉYona naɨ wɨkae mʉnda a nsamaki nɨ nkʉlʉ mahikʉ ataatʉ ʉtikʉ nʉ ng'ʉng'wɨ, ʉgwa nʉ Ng'wana nʉwa Mʉntʉ ʉkikiɨ pihɨɨ mahikʉ ataatʉ ʉtikʉ nʉ ng'ʉng'wɨ. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Antʉ akɨsalɨ ka Ninawɨ akimɨka lʉhikʉ nʉla ʉlamʉli, nienso akʉasemela antʉ awɨleli ʉwʉ kɨna agazilye. Kʉnsoko anya ku Ninawi aɨ ilile itʉnʉ kʉ mɨlandʉ ao kʉnsoko aʉtanantyi wang'wa Yona, napaɨti ʉkolɨ nʉ mʉkʉlʉ kʉmʉkɨla ʉ Yona! <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Mʉtemi nʉa kɨsʉngʉ nʉakʉ takama ʉziimɨka matungo nʉa wɨleli ʉwʉ nʉʉkʉlamʉlwa, nʉng'wenso ʉzeʉsemela ʉwileli ʉwʉ kɨna ʉkete igazo. Kʉnsoko nʉwanso aɨ ʉtungile mʉhinzo kʉpʉma kʉlɨ, wɨkɨza kʉtegeelya makani amahala nang'wa Solomoni, napaitɨ ʉkolɨ nʉ mʉkʉlʉ kʉmʉkɨla ʉ Solomoni.<verse eid="MAT 12:42" /></para>
  <para style="s">Kʉsʉkɨlwa nʉ hɨng'wɨ</para>
  <para style="r">
    <ref loc="LUK 11:24-26">Lʉka 11:24-26</ref></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />Yesʉ wɨkalongoleka kʉmanyisa, wazelʉnga, “Ʉhing'wɨ anga wapʉmigwe mʉ mʉntʉ, wɨtʉla sʉʉla mʉwɨɨ mʉtilɨ mazɨ wazedʉma pa ʉsʉpilyo, anga waʉlye, <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />papo gwa wɨtʉla kitambʉlya, ‘Nɨmɨsʉkile ɨnyʉmba ane nazampʉmɨɨe’. Nʉng'wenso anga watʉlye wamihange ngila anga kɨntʉ, ipyagʉwe nʉkʉnoneeligwa, <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />wendaa ahola ahing'wɨ aʉya mʉpʉngatɨ, nɨabɨ kʉkɨla nʉwanso, nɨenso ingɨla ɨhi mʉ mʉntʉ nʉwanso. Nʉ mʉntʉ nʉwanso wɨtʉla mʉbɨ kʉkɨla pa ng'wandyo.”<verse eid="MAT 12:45" /></para>
  <para style="s">Aluna nʉ nyinya atai nɨang'wa Yesʉ</para>
  <para style="r">
    <ref loc="MRK 3:31-35">Maliko 3:31-35</ref>; <ref loc="LUK 8:19-21">Lʉka 8:19-21</ref></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Yesʉ aɨ wakɨlɨ akitʉmbʉlya nʉ milʉndo wa antʉ wɨkapɨka nyinya nɨaluna akimɨkɨla panzi, azealoilwe kitambʉlya nʉ Yesʉ, <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Sʉnga mʉntʉ ʉng'wɨ wɨkamʉɨla “Iyaa ako nɨaluna ako akoli panzi, aloilwe kitambʉlya nʉewe.”<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />Yesʉ wɨkamʉsʉkɨɨlya mʉntʉ nʉwanso, “Iyaa wane nyenyʉ, nɨalʉna ane anyenyʉ? <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Nʉyo wɨkaaloteela amanyisigwa akwe, wɨkalʉnga, “Awa wawa ɨyaa ane nɨ alʉna ane! <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Kʉnsoko mʉntʉ wɨhi nʉkitʉma aya nʉmaloilwe ʉTata wane nʉa kigʉlʉ, yʉyo mʉnyandʉgʉ wane ang'wɨ ng'waitʉ ang'wɨ iyaa wane.<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">Ʉmanyisi nʉwa mʉntʉ nʉkʉmyaga mbeʉ</para>
  <para style="r">
    <ref loc="MRK 4:1-9">Maliko 4:1-9</ref>; <ref loc="LUK 8:4-8">Lʉka 8:4-8</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Lʉhikʉ lʉlo lʉʉlo, Yesʉ wɨkapʉma mʉ nyʉmba nanso, akalongola kikiɨ mʉ mpelompelo a lʉzɨ nʉla Galilaya. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Antʉ ɨdʉ ɨkamʉpilimɨkɨɨlya Yesʉ, nʉyo wɨkanankɨla mibɨnɨ wɨkikiɨ wɨkingɨla mʉmazɨ. Itungo nɨlanso antʉ ɨhi ɨkimɨka mʉ mʉmpelo a lʉzɨ, <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Yesʉ nʉyo wɨkaatambʉila nkani yɨdʉ kʉ mpyani. “Wɨkaaɨla tegeelyi! Mʉntʉ ʉng'wɨ aɨwendile myaga mbeʉ mʉ mʉgʉnda. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Naɨ ʉkʉmyaga, mbeʉ ying'wɨ yɨkagwɨla mʉnzɨla, nyʉnyi yɨkailya. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Mbeʉ ying'wɨ yɨkagwɨla mʉ matalagwe mihalʉ ikeehʉ. Yɨkakaya kʉhelʉka ingɨ kʉnsoko aɨ yɨtuhɨɨwe ihalʉ ikeehʉ. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Ng'ʉng'wɨ naɨ wakɨla yɨkapya yɨkanyala, kʉnsoko mɨli akwe shanga aɨ yihɨmbɨɨye iza. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Mbeʉ ying'wɨ yɨkagwɨla mʉ mɨtɨ amija, ɨmɨtɨ ɨkakʉla nʉkaisopa. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Mbeʉ ying'wɨ yɨkagwɨla mihalʉ la mʉmboto, yɨkahelʉka, yɨkakʉla mimea ɨkapa mapemba. Ipemba lɨng'wɨ nseke igana, ipemba lʉlya nseke makʉmi mʉtandatʉ ipemba lulya nseke makʉmi ataatʉ.<verse eid="MAT 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 13:9" />Yesʉ wɨkamaɨlya kʉlʉnga, “Nʉkete kʉtwɨ nʉwakija, nʉwije!”<verse eid="MAT 13:9" /></para>
  <para style="s">Nsoko akʉmanyisa kʉ mpyani</para>
  <para style="r">
    <ref loc="MRK 4:10-12">Maliko 4:10-12</ref>; <ref loc="LUK 8:9-10">Lʉka 8:9-10</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Sʉnga amanyisigwa akwe ɨkaza ikʉmʉkolya, “Nɨkɨ ʉkʉamanyisa antʉ awa kʉ mpyani?<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />Yesʉ wɨkaasʉkɨɨlya, “Ʉnyenye mʉkembetilwe ni Itunda kʉlɨnga makani nakɨlɨ kʉɨkwa kɨhenga mʉ ʉtemi nʉa kigʉlʉ, ingɨ nɨanso shanga akembetilwe kʉlɨnga makani nanso. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Kʉnsoko mʉntʉ nʉkete kɨntu ʉkongeligwa, nʉyʉ nʉmʉgila anga kɨntʉ, nɨkɨ nɨkɨniino nʉkete ʉkʉhegeligwa. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Yɨyo nsoko kʉitambʉlya nɨenso kʉmpyani, kʉ nsoko awo ɨgoza shanga ɨona, ɨtegeelya shanga ija, ang'wɨ shanga ɨlɨnga. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />Kʉnsoko apikɨɨla ayo naɨ ʉtambʉe mʉmanga Isaya kɨna.</para>
  <para style="q" vid="MAT 13:14">‘Antʉ awa akʉtegeelya nʉkʉtegeelya, ingɨ shanga akʉlɨnga.</para>
  <para style="q" vid="MAT 13:14">Antʉ awa akʉgoza nʉkʉgoza, ingɨ shanga akʉona.<verse eid="MAT 13:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MAT 13:15" />Kʉnsoko antʉ awa agila ʉhumi nʉwakʉtegeelya kɨsa,</para>
  <para style="q" vid="MAT 13:15">hangɨ ahitile kʉmɨona ɨtai.</para>
  <para style="q" vid="MAT 13:15">Anga ɨze shanga ʉʉ, aza azeaone kʉmiho ao,</para>
  <para style="q" vid="MAT 13:15">aza aziija kʉakʉtwɨ ao, aza azelɨnga kʉmahala ao,</para>
  <para style="q" vid="MAT 13:15">aza azeenkela ʉnene ni Isekʉlʉ, aza zee akomya.’<verse eid="MAT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />“Ingɨ mʉkembetilwe ʉnyenye, kʉnsoko imiho anyʉ akʉona nɨakʉtwɨ anyʉ akija. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Kʉmʉila ɨtai, amanga nɨ antʉ ɨdʉ nɨakende aɨ asʉmbɨɨye kʉona aya nɨmʉkʉona, shanga ɨkaona, nʉkija aya nɨmʉkija, shanga ɨkija.<verse eid="MAT 13:17" /></para>
  <para style="s">Yesʉ ʉkʉpumya ndogoelyo a mpyani amʉmyagi</para>
  <para style="r">
    <ref loc="MRK 4:13-20">Maliko 4:13-20</ref>; <ref loc="LUK 8:11-15">Lʉka 8:11-15</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />Itigwa, ʉnyenye tegeelyi ndogoelyo a mpyani a mʉmyagi. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Antʉ ɨhi nɨija ʉlʉkani nʉla ʉtemi wang'wi Itunda ahite kʉlʉlɨnga, impyanigwe nimbeʉ naɨ yigwɨɨe mʉnzila, Shetani wɨza kʉheja nikitemewe mʉnkolo yao. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Mbeʉ izo naɨ yigwɨɨe mitalaagwe yimpyanigwe nɨ antʉ nɨɨtegeelya lʉkani lang'wi Itunda nʉkʉlʉsɨhgɨɨlya kʉʉlowa. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />Ingɨ ʉlʉkani lang'wi Itunda shanga lingɨe mʉnkolo yao, ɨhʉiila itʉngo iniino ʉdu, hangɨ anga lwago lʉmʉhange ang'wɨ ʉonelwɨ wigele kʉnsoko alʉkani lʉlo, ɨleka kʉhʉila. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Mbeʉ izo naɨ yigwɨɨe mʉmɨtɨ amija, ingɨ yɨmpyanigwe nɨ amʉntʉ niija ʉlʉkani lang'wi Itunda, ingɨ ʉlʉkani lisopwa kʉnsoko lwago nʉla milimo amʉnʉ mihɨɨ nʉ kʉloeligwa nsao, nʉ mʉntʉ nʉwanso shanga ɨtʉmaa makani nʉmaloilwe Itunda. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Mbeʉ ɨzo naɨ yigwɨɨe mihalʉ nɨla mboto yimpyanigwe nɨ antʉ nɨɨtegeelya lʉkani lang'wi Itunda nʉkʉlinga, witʉmaa aya namʉloeeye Itunda, wɨhanga mʉmea nʉwɨpa nkali igana lɨng'wɨ nʉ ʉya makʉmi mʉtandatʉ nʉ ʉya makʉmɨ ataatʉ.<verse eid="MAT 13:23" /></para>
  <para style="s">Mpyani a pʉngʉ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Yesʉ wɨkaapa ɨantʉ mpyani ngɨɨza kɨna, “Ʉtemi nʉa kigʉlʉ wɨmpyani nʉ mʉntʉ naɨ ʉmyagile mbeʉ nɨnza mʉmʉgʉnda wakwe. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Ingɨ ʉtikʉ antʉ naɨ alala, mʉlʉgʉ wɨkɨza, wɨkamyaga mbeʉ a pʉngʉ mʉmʉgʉnda wʉwo wʉʉwo, akahega akalongola. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Itɨ gwa, mbeʉ naɨyahelʉka mɨmea ɨkakʉla nʉ kʉpununta, apʉngʉ nawo ɨkandya kʉpununta, papo itʉmi ɨkalɨnga. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />Itʉmi ɨkamʉtyata mʉkola mʉgʉnda ɨkamʉɨla, ‘Isekʉlʉ itɨɨ shanga aɨ ʉmyagile mbeʉ nɨnza mʉmʉgʉnda wako. Itɨɨ, apʉngʉ apʉma pɨɨ?’ <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />Nʉwanso wɨkaasʉkɨɨlya, ‘Mʉlʉgʉ yʉyo ʉtendile itɨ, itʉmi akwe ɨkamʉkolya, itɨɨ ʉloilwe kende kipange ne?’ <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />Nʉyo wɨkasʉkɨɨlya, leki kipi ʉ pʉngʉ, anga mipe mʉkʉkenkeelya nɨ mɨmea nɨmɨza. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Mʉleki ʉ pʉngʉ ikʉlanie nɨ mbeʉ nɨnza kʉpikɨɨla ɨ maogola. itʉngo nɨlanso kʉaɨla ɨaogoli. Mʉtungi hanza ʉ pʉngʉ matita akʉsonsa moto, ingɨ ngano mɨogoli mʉpʉle mʉɨkɨle misalanka lane.”’<verse eid="MAT 13:30" /></para>
  <para style="s">Mpyani a mʉmea nʉitangwaa haladali</para>
  <para style="r">
    <ref loc="MRK 4:30-32">Maliko 4:30-32</ref>; <ref loc="LUK 13:18-19">Lʉka 13:18-19</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Yesʉ wɨkaaɨla ɨantʉ mpyani ngɨɨza, “Ʉtemi nʉa kigʉlʉ wimpyanigwe nɨ mbeʉ niino nitangwa haladali mʉntʉ ʉng'wɨ naɨ ʉmitemee mʉmʉgʉnda wakwe. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Mbeʉ ahaladali ingɨ niino kʉkɨla mbeʉ yɨhi, anga ʉmɨtemele ikʉle mʉmea wakwe wɨtʉla ʉkʉlʉ kʉkɨla mɨmea ɨhi. Ingɨ ɨkʉla wɨkatula mʉtɨ ʉkʉlʉ ni nyʉnyi yitʉma iuyɨ mʉmatambi yakwe.”<verse eid="MAT 13:32" /></para>
  <para style="s">Mpyani a amila</para>
  <para style="r">
    <ref loc="LUK 13:20-21">Lʉka 13:20-21</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Yesʉ akalongoleka kʉtambʉla mpyani ngɨɨza. “Ʉtemi nʉa Kigʉlʉ wimpyani itɨ, mʉsʉngʉ ʉng'wɨ naɨ ʉhoile amila wɨkagahɨɨlya mʉ utu nʉwa ngano madebe abɨɨlɨ ni ikinda, sʉnga utu wɨhi wɨkagasa nʉkʉhupa.”<verse eid="MAT 13:33" /></para>
  <para style="s">Nsoko ang'wa Yesʉ kʉmanyisa kʉ mpyani</para>
  <para style="r">
    <ref loc="MRK 4:33-34">Maliko 4:33-34</ref></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Yesʉ aɨʉamanyisilye antʉ aya ɨhi kʉ mpyani. Shanga aɨ wɨtambʉlaa nkani yɨhi shanga waze ʉapumɨɨye mpyani, <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />ingɨ lɨhʉme kʉpikɨɨla ɨkani naɨ litambʉwe nʉmʉmanga.</para>
  <para style="q" vid="MAT 13:35">“Nɨkitambʉlya nɨanso kʉmpyani,</para>
  <para style="q" vid="MAT 13:35">kʉpihʉʉla naɨ apihilwe pʉma ʉʉmbwa nʉa ʉnkʉmbigʉlʉ.”<verse eid="MAT 13:35" /></para>
  <para style="s">Yesʉ ʉkʉkumʉʉla mpyani a pʉngʉ</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Sʉnga Yesʉ wɨkaalaga antʉ, wɨkingɨla mʉnyʉmba. Amanyisigwa akwe ɨkamʉhanga, ɨkamʉkolya, “Kʉkumʉɨle impyani iyo nʉwa pʉngʉ mʉmʉgʉnda.”<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />Yesʉ wɨkasʉkɨɨlya, wɨkalʉnga, “Mʉmyagi nʉa mbeʉ ninza nɨyanso niya ngano ingɨ Ng'wana nʉwa Mʉntʉ. <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />Mʉgʉnda ingɨ ʉnkʉmbigʉlʉ. Mbeʉ izo ninza ingɨ antʉ awo nʉʉtemi nʉa kigʉlʉ ingɨ wao. Apʉngʉ ingɨ antʉ awa nɨamʉtyatile Mʉlʉgʉ. <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />Mʉlʉgʉ ʉyʉ nʉ ʉtemee apʉngʉ ingɨ Shetani. Maogola ingɨ mpelo a ʉnkumbigʉlʉ, nɨ itʉmi ingɨ a Itʉmi akigʉlʉ niang'wi Itunda. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />Anga nɨyɨlɨ apʉngʉ nɨɨtungwa matita nʉ kʉsonswa moto, Itɨʉ izeetula kʉmpelo a ʉnkumbigʉlʉ, <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Ng'wana nʉwa Mʉntʉ ʉkʉalagɨɨlya a Itʉmi akigʉlʉ niang'wi Itunda ilingɨɨle antʉ ɨhi kʉpuma mʉ ʉhumi wakwe nɨɨsasha antʉ itʉme mɨlandʉ, nawa ɨhi nɨitʉma makani nɨmabɨ, <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />nʉ kʉagʉmɨla mʉ moto ʉtaki nishanga wɨlima kalɨ na kalɨ, kʉng'wanso akʉlɨla nʉkʉkelya mino. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Sʉnga, antʉ awa nɨakende azemɨlɨgɨnta anga lyoa mʉʉtemi wang'wa Tata wao. Kʉlʉlo mʉntʉ nʉkete kʉtwɨ nʉwakija, nʉije!<verse eid="MAT 13:43" /></para>
  <para style="s">Mpyani akɨntʉ ka nsaɨlo nkʉlʉ nɨkipihile</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />“Ʉtemi nʉa kigʉlʉ wɨmpyanigwe nɨ kɨntʉ ka nsaɨlo nkʉlʉ naɨ kɨpihilwe mʉmʉgʉnda. Mʉntʉ ʉng'wɨ wɨkakʉga, wɨkakɨpiha hangi. Sʉnga mʉ wiloi wakwe, wɨkalongola wɨkagʉlya maintʉ ɨhi naɨ ʉkete, wɨkagʉla mʉgʉnda nʉanso.<verse eid="MAT 13:44" /></para>
  <para style="s">Mpyani a nsaɨlo nkʉlʉ nɨtangwa lulu</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />“Hangi, ʉtemi nʉwakigʉlʉ wimpyanigwe nʉ mʉsʉlʉja ʉng'wɨ naɨ ʉkʉpenza lulu nɨnza. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Naɨ walija lulu ing'wɨ nɨkete nsaɨlo nkʉlʉ, wɨkalongola wɨkagʉlya ɨhi naɨ ʉkete, wɨkamigʉla lulu nanso.<verse eid="MAT 13:46" /></para>
  <para style="s">Mpyani anyabu akʉbuɨla nsamaki</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />“Hangi, ʉtemi nʉa kigʉlʉ wɨmpyanigwe nɨ nyabu nɨgʉmɨwe mʉlʉzi, ɨkaambisa nsamaki niya mpyani yɨhi. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Nyabu naɨizʉla, antʉ ɨkaluta kitʉmbɨ, ɨkikiɨ, ɨkaholanɨa nsamaki izi ninza ɨkaɨkɨla mʉnkapu yao, nsamaki nimbɨ ɨkagʉma. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Itɨ ʉʉ izeetula matungo ampelo. Itʉmi akigʉlʉ nɨang'wi Itunda aziigela kʉkomatʉla antʉ nɨɨtenda aya namʉloeeye Itunda nawa nɨɨtenda aya nɨmabɨ, <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />aze agʉmɨla mʉmoto nʉʉtaki nʉwa kalɨ na kalɨ awa nɨɨtenda nɨ mabɨ, mʉng'wanso azɨɨza lɨla nʉkʉkelya mino.”<verse eid="MAT 13:50" /></para>
  <para style="s">Maintʉ nɨmapya naya nakalɨ</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />Yesʉ wɨkaakolya hangɨ amanyisigwa akwe, itɨɨ, malɨngane makani aya ɨhi?” Ɨkamʉsʉkɨɨlya,</para>
  <para style="p" vid="MAT 13:51">“Ee kalɨnga.”<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Yesʉ wɨkaatambʉila, “Itɨ gwa, mʉmanyisi wɨhi nʉa malago ang'wa Musa nʉwɨkaɨlɨka kʉtula mʉmanyisigwa nʉwa ʉtemi nʉwa kigʉlʉ wɨmpyani nʉ mʉkola nyʉmba nʉwɨpʉmya mʉ maintʉ a nsaɨlo nkʉlʉ intʉ niipya nizi niya kalɨ.”<verse eid="MAT 13:52" /></para>
  <para style="s">Yesʉ ʉkʉhitwa kʉ Nazaleti</para>
  <para style="r">
    <ref loc="MRK 6:1-6">Maliko 6:1-6</ref>; <ref loc="LUK 4:16-30">Lʉka 4:16-30</ref></para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Yesʉ naɨ wakondya kʉatambʉila mpyani niyanso wɨkahega pang'wanso, <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />naɨ wapɨka mʉkɨsalɨ kakwe. Kʉng'wanso wɨkatula amanyisa antʉ mʉ nyʉmba akʉtankanɨla Ayahudi ɨkakʉɨlwa, ɨkalʉnga, “Mʉntʉ ʉyʉ waligɨlya pɨɨ mahala aya nɨ mɨʉkʉɨlwa ɨyɨ? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Mʉntʉ ʉyʉ shanga ng'wana wa mʉsesa mbaone? Nʉ nyinya shanga ʉ Malɨa! Nɨa aluna akwe ga shanga ɨa Yakobo nʉ Yosepu nʉ Simoni nʉ Yʉda? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Nɨ alʉna akwe nɨa kɨsʉngʉ, shanga wawa ɨhi nɨkɨkalanɨa palʉng'wɨ nʉsese? Itɨɨ, waligɨlya pɨɨ aya itɨ ɨhi?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Kʉlʉlo ɨkamʉhita,</para>
  <para style="p" vid="MAT 13:57">Ingɨ Yesʉ wɨkaaɨla, “Mʉmanga wɨkʉligwa nkɨka yɨhi, ingɨ shanga wɨkʉligwa mʉkɨsalɨ kakwe nʉ mʉalʉna akwe!” <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />Kʉlʉlo, shanga aɨ witʉmile mampɨlʉ nɨdʉ mʉkɨsalɨ kakwe kʉnsoko aɨ agila anga ʉhʉɨɨli.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">Kʉsha kʉng'wa Yohana Mʉbadisi</para>
  <para style="r">
    <ref loc="MRK 6:14-29">Maliko 6:14-29</ref>; <ref loc="LUK 9:7-9">Lʉka 9:7-9</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Matʉngo nanso, mʉtemi Helode Mʉtemi nʉwa kʉ Galilaya wɨkija ʉlʉkʉmo lang'wa Yesʉ. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />Itɨ gwa, wɨkaaɨla itʉmi akwe, “Mʉntʉ ʉyʉ ingɨ Yohana Mʉbadisi wiyʉka. Kʉlʉlo ʉhumi nɨ mampɨlʉ akolɨ mʉng'waakwe zizo yʉkitʉma.”<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Helode wɨka mʉamba Yohana Mʉbadisi, wɨkamʉtʉnga wɨkamʉlʉgaɨla mʉ kadulumu, kʉnsoko ang'wa Helodɨa mʉsʉngʉ wang'wa Pilipo, naɨ heʉ wang'wa Helode. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Kɨnsasha kɨna nkʉa yɨdʉ Yohana Mʉbadisi aɨ wɨmʉɨla Helode itɨ, “Shanga inonee ʉewe ʉmʉtine ʉmʉsʉngʉ nʉanso!” <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Helode akahiya kʉmʉbʉlaga ʉ Yohana Mʉbadisi ingɨ aɨ wogopile antʉ, kʉnsoko antʉ aɨ amʉaɨɨye ʉ Yohana Mʉbadisi kɨna mʉmanga wao.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />Naɨ lapɨka lʉhikʉ nʉ liloeelya nɨla kʉtʉgwa ʉ Helode, mʉnanso wang'wa Helodia akaina iza pantongeela niya antʉ naɨ anilwe. Helode wɨkaloeligwa nangaluu, <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />Sʉnga ʉ Helode wɨkalapa, “Kʉʉpa kɨntʉ kɨhi nʉkʉnompa.”<verse eid="MAT 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 14:8" />Nʉyo wɨkamanyisigwa nʉ nyinya, munanso wikalʉnga, “Mpe ino inoo itwe lang'wa Yohana Mʉbadisi mʉntʉa.”<verse eid="MAT 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 14:9" />Mʉtemi Helode wɨkahʉsha, ingɨ kʉnsoko ilapo lakwe nɨ antʉ nɨikalanilye miloeeya lakwe, wɨkalagɨɨlya ʉ mʉnanso wapegwe ʉdu ɨkɨ nʉlompile. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Kʉlʉlo gwa Helode wɨkalagɨɨlya amboi ende mʉkadulumu amʉdumʉle ʉ Yohana Mʉbadisi itwe. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Itwe lang'wa Yohana Mʉbadisi lɨkaletwa lɨkenkilwe mʉsahani, Helode wɨkamʉpa ʉmʉnanso wang'wa Helodia, nʉyo wɨkamʉtwaɨla ʉnyinya. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Amʉnyisigwa ang'wa Yohana Mʉbadisi ɨkɨza, ɨkaʉhola ʉmʉimba wang'wa Yohana Mʉbadisi, ɨkenda ɨkaʉɨka. Sʉnga ɨkamʉpikɨlya ʉ Yesʉ mpola niyanso.<verse eid="MAT 14:12" /></para>
  <para style="s">Yesʉ ʉkʉalɨsa antʉ akɨile elupu itaano</para>
  <para style="r">
    <ref loc="MRK 6:30-44">Maliko 6:30-44</ref>; <ref loc="LUK 9:10-17">Lʉka 9:10-17</ref>; <ref loc="JHN 6:1-14">Yohana 6:1-14</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Yesʉ naɨwija impola niyanso, wɨkanankɨla mibɨnɨ wɨkahega pang'wanso, wɨkalongola patilɨ antʉ watule wing'wene. Ingɨ antʉ naɨija kʉkoli, ɨkamʉtyata azegenda na mɨgʉlʉ kʉpuma palʉzɨ. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Yesʉ naɨ wahulumʉka mʉlʉgʉlʉ, wɨkaona milʉndo waantʉ, wɨkaaonela kɨnyaʉwai, naɨ alwae wɨkaakomya.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />Naɨ yatula mpɨndɨ amanyisigwa akwe ɨkamʉhanga ɨkamʉɨla, “Apa itɨ nɨkʉkolɨ ingɨ mʉwɨɨ, nɨlyoa laembama. Itɨ gwa alage ɨantʉ ende igʉɨlye indya mʉkɨsalɨ alye.”<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />Yesʉ wɨkasʉkɨɨlya, “Kʉtilɨ anga nsoko akʉlongola, api nyenye indya.”<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />Ingɨ amanyisigwa ɨkamʉɨla, “Ʉsese kʉkete mɨkate itaano ninsamaki ibɨɨlɨ dʉ<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />Yesʉ wɨkaaɨla, “Sileti apa.” <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Yesʉ wɨkalagɨɨlya antʉ alame mʉmapwa. Wɨkahʉmbʉla mɨkate ni itaano ni nsamaki ni ibɨɨlɨ, wɨkalangamɨla kigʉlʉ, wɨkaɨkembeta. Sʉnga wɨkaegania ɨmɨkate nanso, wɨkaapa amanyisigwa akwe, nɨenso ɨkaapa ɨantʉ. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Antʉ ɨhi ɨkalya ɨkikʉta. Sʉnga amanyisigwa ɨkahoeela naɨasagilye, yikizʉla nkapʉ ikʉmi na ibɨɨlɨ. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Antʉ ɨhi naɨalɨe aɨapikile itʉnja elupu itaano, leka kʉaɨɨlya asʉngʉ nɨ ang'enya.<verse eid="MAT 14:21" /></para>
  <para style="s">Yesʉ ʉkʉgenda migʉlya a mazɨ</para>
  <para style="r">
    <ref loc="MRK 6:45-52">Maliko 6:45-52</ref>; <ref loc="JHN 6:15-21">Yohana 6:15-21</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Itʉngo lɨlo, Yesʉ wɨkaaɨla amanyisigwa akwe anankɨle mibɨnɨ, atongele kitʉmbɨ la lʉzɨ nʉanso naɨwakɨlɨ ʉkʉlaga maʉmbɨ aantʉ. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Naɨwakondya kʉalaga antʉ, wɨkanankila mʉlʉgʉlʉ wamʉlompe Itunda. Akatula kʉko wing'wene sunga kiti kɨkituma, <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />itʉngo nɨlanso ibɨnɨ naɨanankɨe ɨamanyisigwa akwe aɨlapɨka pakatɨ alʉzi, ibɨnɨ lɨkatula yʉngʉya kʉnsoko ng'wega ʉkʉlʉ aɨʉkʉkunka.<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />Ʉtikʉ, naɨyahumbeela kilya kʉtamʉka, Yesʉ wɨkaatyata ɨamanyisigwa akwe wazegenda migʉlya amazɨ. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Amanyisigwa akwe naɨamʉona ʉkʉgenda migʉlya amazɨ ɨkaambwa woa, ɨkakʉta ɨkalʉnga, “Ʉyʉ mʉtumbʉka!”<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />Papo Yesʉ wɨkaatambʉlya, “Komyi ɨnkolo, ingɨ nene. Leki kogopi!”<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />Petelo wɨkamʉɨla “Isekʉlʉ angaɨze tai yʉ wewe, ngombye nʉnene ngende migʉlya amazɨ nize kʉng'waako.”<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />Yesʉ wɨkalʉnga, “Alɨ genda pembya.” Papo, Petelo wɨkasima mibɨnɨ, wɨkagenda migʉlya amazɨ ʉhongile kʉng'wa Yesʉ. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Ingɨ Petelo naɨ waona ʉng'wega wakʉnka, wɨkogopa, wɨkatʉla nyohela mʉmazɨ; wɨkakʉta, “Isekʉlʉ ngune!”<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />Papo ʉ Yesʉ, wɨkamʉamba mʉkono, wɨkamʉɨla “Ʉewe nʉkete ʉhʉɨɨli ʉniino! Nɨkɨ wogopa?” <verse eid="MAT 14:31" /><verse number="32" style="v" sid="MAT 14:32" />Sʉnga ɨkanankɨla mibɨnɨ, nʉng'wega ʉkakilaja. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Ɨhi naɨ amoli mibɨnɨ ɨkatugama nʉkʉmʉkʉlya, ɨkalʉnga, “Kʉlʉ kʉʉlʉ ʉewe wɨ Ng'wana wang'wi Itunda.<verse eid="MAT 14:33" /></para>
  <para style="s">Yesʉ ʉkʉakomya alwae kihɨɨ akʉ Genezaleti</para>
  <para style="r">
    <ref loc="MRK 6:53-56">Maliko 6:53-56</ref></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Ɨkatambʉka ʉlʉzi, ɨkapɨka kihɨɨ a Genezaleti. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Anya kʉ Genezaleti naɨ amʉlɨnga kɨna Yesʉ, ɨkakumʉsha mpola yakwe nkɨka yɨhi niya kʉng'wanso. Itɨ gwa, Antʉ akaaleta alwae ɨhi kʉng'wa Yesʉ, <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />ɨkamʉlompa waalekele atonie ga ʉkunzɨlo nʉa matʉgalo akwe. Nawa ɨhi naɨ atonyilye ɨkakomya.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">Ʉmanyisi nʉa anyakalɨ</para>
  <para style="r">
    <ref loc="MRK 7:1-13">Maliko 7:1-13</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Sʉnga Apalisayo ang'wɨ nɨ amanyisi amalagɨɨlyo ang'wa Musa naɨapʉmile kʉ Yelʉsalemu ɨkamʉhanga ʉ Yesʉ, ɨkamʉkolya, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“Nɨkɨ amanyisigwa ako shanga akee ʉmanyisi naɨ kʉmanyisigwe nɨanyakalɨ? Kʉnsoko shanga ɨkʉkalala mɨkono kʉpikɨɨla mʉinkokola anga mʉitakɨwe nɨakandya kʉlya indya!”<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />Yesʉ wɨkaasʉkɨɨlya, “Kʉnɨkɨ ʉnyenye shanga mʉkee malagɨɨlyo ang'wi Itunda ingɨ mʉtyatile ʉmanyisigwa wanyu ʉnyenye? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Itunda ʉliiye, ‘Mʉkʉlye tata wako nʉ iyaa wako,’ hangi ‘Nʉkʉmʉtʉkɨla ihe ang'wɨ nyinya nʉwabʉlagwe.’ <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Ingɨ ʉnyenye mɨmanyisa kɨna mʉntʉ anga ɨze ʉkete kɨntʉ kakʉmʉaɨilya ihe ang'wɨ nyinya, ingɨ walʉnge. ‘Kɨntʉ ɨkɨ kʉkɨpʉmya kʉng'wɨ Itunda,’ <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />ʉnyenye mɨmanyisa mʉntʉ ʉyʉ waleke kʉmʉkʉlya ihe ang'wɨ nyinya! Itɨ gwa mʉgʉmaniiye inkani yang'wɨ Itʉnda mʉtyatile ʉmanyisigwa wanyʉ. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Ʉnyenye mitendisaa kɨna mɨaza! Mʉmanga Isaya aɨʉpumilye ʉmanga kʉng'wanyʉ kɨna.<verse eid="MAT 15:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MAT 15:8" />‘Itunda ʉlɨɨye, antʉ awa ɨnitetemba kʉnkani ʉdu,</para>
  <para style="q" vid="MAT 15:8">ingɨ mʉnkolo yao shanga anihʉɨɨe ʉnene.<verse eid="MAT 15:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MAT 15:9" />Ɨnkʉlya ʉnene nakanda,</para>
  <para style="q" vid="MAT 15:9">kʉnsoko ɨnkani nɨakʉmanyisa akɨʉntʉ ʉdu azelunga apembeeye kʉng'wi Itunda.”’<verse eid="MAT 15:9" /></para>
  <para style="s">Makani nɨmʉtenda mʉntʉ wahitwe pa kʉʉmʉkʉlya Itunda</para>
  <para style="r">
    <ref loc="MRK 7:14-23">Maliko 7:14-23</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Sʉnga Yesʉ wɨkitanga milʉndo nʉa antʉ, wɨkaaɨla, “Tegeelyi hangɨ mʉlɨnge! <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Kɨntʉ nɨkɨkolɨ kʉnzi amʉntʉ nɨkɨkingɨla mʉkatɨ shanga kɨhumile kʉmʉsasha mʉntʉ wahitwe kʉmʉkʉlya Itunda. Ingɨ kɨntʉ nɨkɨkolɨ mʉkatɨ akwe anga kɨmʉpume kɨko kɨkʉmʉsasha mʉntʉ wahitwe kʉmʉkʉlya Itunda.”<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Sʉnga amanyisigwa ɨkamʉhanga ʉ Yesʉ, ɨkamʉɨla, “Itɨ, ʉlɨngilene kɨna Apalisayo naza ategeeye abɨpɨlwa inkani yako?<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />Yesʉ wɨkaasʉkɨɨlya amanyisigwa, “Kɨntʉ kɨhɨ nɨshanga kɨtemewe nʉ Tata nʉwa kigulu, kɨkipwa. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Aleki nɨanso! Ingɨ atongeeli aapoku, mʉpoku anga wamʉtongeele mʉpoku mʉya, ɨhi mʉʉbɨɨlɨ akʉgwɨla mikombo.”<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />Petelo wɨkamʉɨla “Kʉtambʉile ndogoelyo ampyani nanso.”<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />Yesʉ wɨkaakolya, “Nʉnyenye ga shanga mʉlingɨlene ikani ɨlɨ? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Itɨɨ, shanga mʉlingɨle kɨna kɨntʉ nɨkɨkolɨ kʉnzi amʉntʉ kenda mʉnda nʉ kʉtwalwa kʉshoo? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Ingɨ kɨntʉ nɨkɨkʉpʉma mʉmʉlomo, nɨkanso kɨko kɨkʉmʉsasha mʉntʉ wahitwe kʉmʉkʉlya Itunda. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Kʉnsoko mʉnkolo amʉntʉ ɨpuma masɨgo aʉbʉlagi nʉ ʉgoolya nʉ ʉsambo nʉ wii nitegete ni itʉki. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Ʉbɨ nʉwanso wʉwo wɨmʉsasha mʉntʉ wahitwe kʉmʉkʉlya Itunda. Ingɨ kʉlya mʉitakɨwe kʉpikɨɨla kʉinkokola shanga ikʉmʉsasha mʉntʉ wahitwe kʉmʉkʉlya Itunda.”<verse eid="MAT 15:20" /></para>
  <para style="s">Ʉhʉɨɨli nʉwa mʉsʉngʉ</para>
  <para style="r">
    <ref loc="MRK 7:24-30">Maliko 7:24-30</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Yesʉ wɨkahega pang'wanso wɨkenda kʉtanantya kʉ Tilo nʉkʉ Sidoni. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Mʉsʉngʉ ʉng'wɨ naɨwishiɨ mʉnkɨka niyanso nɨ shanga aɨ Mʉyahudi wɨkamʉhanga ʉ Yesʉ, wɨkitʉnta wazelʉnga. Isekʉlʉ, Ng'wana wang'wa Daudi, mbaisɨɨlye! Mʉnanso wane wingɨɨwe ahing'wi wagigwa ikʉlʉ.”<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />Yesʉ ingɨ shanga wɨkamʉsʉkɨɨlya anga lʉkani lɨhi. Amanyisigwa akwe ɨkamʉhanga, ɨkamʉɨla, “Mʉɨle ʉmʉsʉngʉ ʉyʉ wahege kʉnsoko ʉkʉtyatiie kʉnʉ ʉkʉʉzogoeye.”<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />Yesʉ wɨkasʉkɨɨlya, “Ʉnene ntʉmilwe kʉ Aisilaeli nɨatuile anga nkolo nɨyilimɨe.”<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />Papo gwa ʉmʉsʉngʉ nʉanso wɨkahʉgeela, wɨkatʉgama ntongeela ang'wa Yesʉ, wɨkamʉɨla, “Isekʉlʉ itʉnʉ nzaɨɨlye.” <verse eid="MAT 15:25" /><verse number="26" style="v" sid="MAT 15:26" />Yesʉ wɨkamʉsʉkɨɨlya, wɨkamʉɨla “Shanga iza kʉhola indya niya ana ʉigʉmɨle imbwa.”<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />Mʉsʉngʉ nʉwanso wɨkamʉɨla “Itaɨ Isekʉlʉ, ingɨ ga ni mbwa ilɨza ʉsigo nʉʉgwɨe pihɨ nʉkʉlya Isekulu wakwe.”<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />Papo ʉ Yesʉ wɨkamʉsʉkɨɨlya, “Mʉsʉngʉ, ʉkete ʉhʉɨɨli ʉkʉlʉ, tendelwa anga nʉloilwe.” Kʉpʉma itungo lɨlo mʉnanso wakwe wɨkakomya.<verse eid="MAT 15:28" /></para>
  <para style="s">Yesʉ ʉkʉkomya antʉ ɨdʉ</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Yesʉ wɨkahega pang'wanso wɨkalongola pampelo alʉzi nʉla Galilaya, wɨkanankila mʉlʉgʉlʉ, wɨkikiɨ pihɨɨ. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Antʉ ɨdʉ ɨkamʉletela antʉ naɨ alema nɨ apokʉ nɨakɨtele nɨakɨmʉmɨ nɨalwae ɨhi, nʉkʉaɨka pantongeela ang'wa Yesʉ, nʉyo wɨkaakomya. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Milʉndo wɨhi nʉa antʉ naɨaona akɨmʉmɨ akʉligitya nawa naɨapoiye akʉkomya nɨakɨtele akʉgenda nɨapokʉ akʉona, ɨkakʉɨlwa, ɨkamʉlʉmbɨɨlya Itunda nʉa Aisilaeli.<verse eid="MAT 15:31" /></para>
  <para style="s">Yesʉ ʉkʉlɨsa antʉ elupu innɨ</para>
  <para style="r">
    <ref loc="MRK 8:1-10">Maliko 8:1-10</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Itɨ gwa Yesʉ wɨkaitanga amanyisigwa akwe, wɨkaaɨla, “Nɨa aisɨɨye ɨantʉ awa, kʉnsoko akolɨ palʉng'wɨ nʉnene mahikʉ ataatʉ, nitungo ɨlɨ agila nɨkakʉlya. Shanga ndoilwe kʉaleka alongole na nzala, ahʉmile kʉgwa mpʉmbɨɨli nanzala.<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />Amanyisigwa akwe ɨkamʉɨla, “Apa kʉkolɨ mʉwɨɨ, kʉʉligɨlya pɨɨ indya niyakʉlɨsa ɨantʉ awa niidʉ iti?”<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />Yesʉ wɨkaakolya amanyisigwa akwe, “Mʉkete mɨkate ɨnga?” Ɨkamʉsʉkɨɨlya, “Kʉkete mɨkate mʉpʉngatɨ nɨ pisamaki pikeehʉ.<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />Itɨ gwa, Yesʉ wɨkalagɨɨlya antʉ ɨhi alame pihɨ. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Wɨkahola mɨkate nanso nɨ mʉpʉngatɨ nɨ pisamaki, wɨkamʉsongelya Itunda, wɨkaega, wɨkaapa amanyisigwa akwe ɨkaatengela antʉ ɨhi. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Antʉ ɨhi ɨkalya nʉkikʉta, sʉnga amanyisigwa akwe ɨkahoeela ʉsigo ɨkizʉla nkapu mʉpʉngatɨ. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Awa naɨalie aɨ antʉ elupu innɨ, asʉngʉ nɨang'enya shanga aɨ aaɨgwe.<verse eid="MAT 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 15:39" />Itɨ gwa ʉ Yesʉ wɨkaalaga antʉ nɨanso, nʉanso wɨkanankɨla mibɨnɨ, wɨkalongola kʉ kɨsalɨ ka Magadani.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">Antʉ akʉhiya mɨʉkʉɨlwa</para>
  <para style="r">
    <ref loc="MRK 8:11-13">Maliko 8:11-13</ref>; <ref loc="LUK 12:54-56">Lʉka 12:54-56</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Lʉhikʉ lʉng'wɨ Apalisayo nɨ Asadukayo ang'wɨ ɨkamʉhanga ʉ Yesʉ ɨkamʉgema, waalagile mɨʉkʉɨlwa kʉpembelya kigʉlʉ. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />Yesʉ ingɨ wɨkaasʉkɨɨlya, “Anga itʉle mpɨndɨ, kʉnsoko kilunde ikaʉku, mɨlʉnga mʉdaʉ ukela ʉza. <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Nɨ kɨdaʉdaʉ, milʉnga lelo ize ng'wega ʉkʉlʉ, kʉnsoko malunde agiɨɨye. Itɨ gwa, ʉnyenye mitendisaa mɨaza, mʉlingɨle kʉgoza lelo kigʉlʉ iyʉlɨ, ingɨ shanga mʉlingɨle kʉtemanʉla matʉngo ampelo? <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Wileli nʉ ʉbɨɨ nʉʉgila ʉhʉɨɨli! Kɨloilwe mɨʉkʉɨlwa, ingɨ shanga akʉpegwa anga mɨʉkʉɨlwa wɨhi, ingɨ ɨkondile mɨʉkʉɨlwa ang'wa Yona.”</para>
  <para style="p" vid="MAT 16:4">Itɨ gwa, wɨkaaleka, wɨkalongola.<verse eid="MAT 16:4" /></para>
  <para style="s1">Amila Aapalisayo nɨ Asadukayo</para>
  <para style="r">
    <ref loc="MRK 8:14-21">Maliko 8:14-21</ref></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Amanyisigwa akwe naɨ aputa ʉlʉzi kenda itʉmbɨ nɨla kabɨɨlɨ, ɨkalɨnga kɨna shanga ahoile mɨkate. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Yesʉ wɨkaatambʉɨla, “Gozi kɨsa, hʉgʉki nɨ amila Aapalisayo nɨ Asadukayo.”<verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />Papo amanyisigwa ɨkatulitambʉlya, “Ʉkʉlʉnga ɨti kʉnsoko shanga kʉhoile mɨkate.”<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />Yesʉ wɨkalɨnga nɨakikʉngʉma, wɨkaaɨla, “Ʉhʉɨɨli wanyu ʉniino! Mʉkikʉngʉma nɨkɨ mɨagila mɨkate? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Itɨɨ, mʉkɨlɨ du kʉlinga? Itɨɨ shanga mʉkɨmbʉkile apo naɨ mbeganilye mɨkate ɨtaano nɨkalɨsa antʉ elupu itaano? Itɨɨ aɨmizʉiye nkapʉ inga niya ʉsigo? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Angwɨ, mɨkate mʉpʉngatɨ naɨndɨsilye antʉ elupu innɨ, itɨɨ aɨmʉkahoee nkapu inga niya ʉsigo. <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Yatʉlaʉli mahita kʉlɨnga kɨna shanga aɨnʉmʉtambʉie kʉnsoko amɨkate? Itungo ɨli hʉgʉki nɨ amila Aapalisayo nɨ Asadukayo.”<verse eid="MAT 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12" />Papo gwa amanyisigwa akwe ɨkalɨnga ɨa kɨna shanga igaɨ niya mɨkate, ingɨ ahʉgʉke nʉʉmanyisi nʉa Apalisayo nɨ Asadukayo.<verse eid="MAT 16:12" /></para>
  <para style="s1">Petelo ʉkʉtambʉla kɨna ʉ Yesʉ Ng'wana wang'wi Itunda</para>
  <para style="r">
    <ref loc="MRK 8:27-30">Maliko 8:27-30</ref>; <ref loc="LUK 9:18-21">Lʉka 9:18-21</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Yesʉ naɨ wapɨka nkɨka niya kʉ Kaisalea nɨ Pilipi, wɨkaakolya amanyisigwa akwe, “Itɨɨ, antʉ ɨntambʉla ʉnene nɨ nyenyu?”<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />Amanyisigwa ɨkamʉsʉkɨɨlya, “Antʉ ang'wɨ ilʉnga kɨna wɨ Yohana Mʉbadisi nɨang'wɨ ilʉnga wɨ Elɨa nɨangwɨ ilʉnga wɨ Yelemia nɨang'wɨ ʉng'wɨ nʉwa amanga.”<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />Yesʉ wɨkaakolya, “Haɨ ʉnyenye mɨlʉnga ʉnene nɨ nyenyʉ?”<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />Simoni Petelo wɨkasʉkɨɨlya, “Ʉewe ingɨ wɨ Kilisito Mʉguni, Ng'wana wang'wi Itunda nɨ mʉpanga.”<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />Yesʉ wɨkamʉɨla “Ʉkembetilwe ʉewe Simoni ng'wana wang'wa Yona, kʉnsoko kʉtilɨ ng'waa mʉntʉ wɨhi nʉkʉkunʉkʉɨe ʉewe ɨkani ɨlɨ, ingɨ Tata wane nʉkolɨ kigʉlʉ. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Nʉ nene kʉʉila. Ʉewe wɨ Petelo,<note caller="+" style="f"><char style="fr" closed="false">16:18 </char><char style="ft" closed="false">Petelo lʉkani la Kigiliki ndogoelyo akwe italagwe.</char></note> igwe nikʉlʉ, migwe ili kulizenga idale la ahʉɨɨli ane. Ngulu yang'wa Shetani shanga yʉkʉʉhuma. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Kʉʉpa malʉgʉɨlo na ʉtemi nʉa kigʉlʉ, kɨhi nʉkʉkilugʉɨla mʉnʉ mihɨɨ, kɨkʉtula kalugʉɨlwa nʉ kigʉlʉ, kɨhi nʉkʉkɨlugaɨla mʉnʉ mihɨɨ, kɨkʉlugʉɨlwa nʉkigʉlʉ.”<verse eid="MAT 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20" />Sʉnga wɨka ahʉgʉlya amanyisigwa akwe kɨna aleke kʉmʉila mʉntʉ wɨhi kɨna nʉanso yʉyo Kilisito.<verse eid="MAT 16:20" /></para>
  <para style="s">Yesʉ ʉkʉligitya nkani niya lwago nʉkʉsha kʉng'wakwe</para>
  <para style="r">
    <ref loc="MRK 8:31">Maliko 8:31</ref>; <ref loc="MRK 9:1">9:1</ref>; <ref loc="LUK 9:22-27">Lʉka 9:22-27</ref></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Kʉpʉma itungo lɨlo Yesʉ wɨkatʉla atambʉɨla kɨhenga amanyisigwa akwe kɨna ʉtakɨwe walongole kʉ Yelʉsalemu, kʉng'wanso ʉkagigwa ikʉlʉ nakʉsakigwa nɨ anyampala, nɨ apolyi nɨ akʉlʉ nɨamanyisi amalagɨɨlyo ang'wa Musa. Kɨna, ʉkʉbʉlagwa nʉlʉhikʉ lakataatʉ ʉkiʉkigwa.<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />Ingɨ ʉ Petelo naɨ wɨja itɨ, wɨkamʉpʉmya kimpelo wɨkatula mʉkenela. “Itunda nʉa kɨɨlɨlye kʉlɨ, Isekʉlʉ wane ɨkani ɨlɨ shanga lɨkʉʉpantɨka!”<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />Ingɨ Yesʉ wɨkamʉpɨlʉkɨla, wɨkamʉɨla Petelo, “Hega pa ntongeela ane, Shetani! Ʉewe wɨkɨnkwaatya kʉng'wane. Masigo ako shanga ang'wi Itunda, ingɨ akɨʉntʉ!”<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Sʉnga ʉ Yesʉ wɨkaaɨla amanyisigwa akwe kɨna, “Mʉntʉ wɨhi nʉloilwe kʉntyata, ʉtakɨwe wiime ʉng'wenso, wagombe ʉlwago nʉ kʉaalɨka, papo wantyate. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Kʉnsoko, mʉntʉ nʉloilwe kʉgʉna ʉlɨkalo lakwe ʉkʉlʉlimɨlya, ingɨ mʉntʉ nʉkʉlʉlimilya ʉlɨkalo lakwe kʉnsoko ane ʉkʉlʉlija. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Itɨɨ, ʉmʉntʉ ʉkʉlija nsaɨlo kɨɨ anga wapate ʉgolɨ wɨhi nʉa mʉ ʉnkʉmbigʉlʉ kʉnʉ waze walimɨlye ʉpanga wakwe? Ang'wɨ, mʉntʉ ʉkʉpʉmya ntʉni wagune ʉlɨkalo lakwe? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Kʉnsoko, Ng'wana nʉwa Mʉntʉ ʉzɨɨza kikʉlyo lang'wa Tata wakwe palʉng'wɨ nɨa Itʉmi akigʉlʉ nɨang'wi Itunda, pang'wanso papo nʉɨka mʉlɨpa mʉntʉ wɨhi anga mʉntendo yakwe. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Kʉmʉɨla ɨtaɨ, akolɨ antʉ ang'wɨ papa nɨshanga akʉsha aze akɨlɨ kʉmʉona Ng'wana nʉwa Mʉntʉ ʉzile mʉ ʉtemi wakwe.”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">Yesʉ ʉkʉkaɨlɨka ikelʉ</para>
  <para style="r">
    <ref loc="MRK 9:2-13">Maliko 9:2-13</ref>; <ref loc="LUK 9:28-36">Lʉka 9:28-36</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Naɨakɨla mahikʉ mʉtandatʉ, Yesʉ wɨkaahola kɨmpelo Petelo nʉ Yakobo nʉ mʉlʉna ʉ Yohana Mʉbadisi, ɨkakʉɨla ɨkanankɨla mʉlʉgʉ nʉ lʉlɨpʉ. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Kʉng'wanso Yesʉ wɨkakaɨlɨka ikelʉ lakwe ntongeelaao, ʉsʉ wakwe ʉkamɨlɨgɨnta anga ʉmɨlɨgɨntu nʉwa lyoa nɨmatʉgalo akwe ikelya anga nzelya. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Papo paapo ɨkigela Mʉsa nʉ Elɨa, ɨkakitambʉlya nʉ Yesʉ. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />Itɨgwa ʉ Petelo naɨ waona itɨ wɨkamʉɨla ʉ Yesʉ, “Isekʉlʉ ingɨ iza ʉsese kikiɨ papa! Anga ikʉloe kʉzenga itala itaatʉ. Kɨng'wɨ kako, king'wɨ kang'wa Mʉsa ikiʉya kangwa Elɨa.”<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />Petelo naɨwakɨlɨ ʉkʉtambʉla itɨ, ilʉnde lyelʉ lɨkaaimba, akija lʉli kʉpʉma milʉnde nɨlanso, lʉkalʉnga, “Ʉyʉ yʉyʉ Ng'wana wane mʉlowa, nɨndoeeigwe nʉng'wenso, mʉtegeelyi ng'wenso.”<verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />Amanyisigwa akwe naɨija lʉli nʉlanso, ɨkogopa ɨkagwa pihɨɨ ʉʉndala. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Yesʉ wɨkaahanga, wɨka atonya, wɨkaaɨla, “Imɨki, leki kogopi!” <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Naɨagoza, shanga akaona antʉ nɨangɨɨza, ingɨ ʉ Yesʉ du.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Itɨ gwa, naɨ akʉhʉlʉmʉka mʉlʉgʉlʉ, Yesʉ wɨka ahʉgʉlya, “Mʉleke kʉmʉila mʉntʉ wɨhi makani aya nɨmʉmaine kʉpikɨɨla Ng'wana nʉwa Mʉntʉ nʉwɨkiyʉka.”<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />Sʉnga amanyisigwa akwe ɨkamʉkolya, “Nɨkɨ amanyisi amalagɨɨlyo ang'wa Musa ɨlʉnga kɨna Elia ʉtakɨwe waze hanza?”<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />Yesʉ wɨkaasʉkɨɨlya, “Ɨtai, Elia ʉzile hanza kʉnoneelya makani ɨhi. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Ingɨ kʉmʉɨla, Elia wazile antʉ shanga ɨkamʉmanya, ingɨ ɨkamʉtendeela anga nɨatakile. Ingɨ Ng'wana nʉwa Mʉntʉ akʉmʉtendeela anga mʉatakɨe.”<verse eid="MAT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13" />Papo gwa amanyisigwa akwe ɨkalɨnga kɨna aɨʉkʉmʉtambʉla Yohana Mʉbadisi.<verse eid="MAT 17:13" /></para>
  <para style="s">Yesʉ ʉkʉmʉkomya mʉhʉmba naɨʉkete hɨng'wɨ</para>
  <para style="r">
    <ref loc="MRK 9:14-29">Maliko 9:14-29</ref>; <ref loc="LUK 9:37-43">Lʉka 9:37-43</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Naɨ aʉpikɨɨla milʉndo nʉwa antʉ, mʉntʉ ʉng'wɨ wɨkamʉhanga Yesʉ, wɨkatʉgama pamɨgʉlʉ, <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />wɨkalʉnga, “Isekʉlʉ mʉaisɨɨlye ʉng'waane kʉnsoko wɨgwa nkolo, hangi wagaa nangaluu, nkʉa yɨdʉ wɨgwɨla mʉmoto ang'wɨ mʉmazɨ. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Aɨnʉmʉletile kʉ amanyisigwa ako ɨkaleng'wa kʉmʉkomya.”<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />Yesʉ wɨkaaɨla, “Ʉnyenye wileli nɨmɨagila ʉhʉɨɨli, nɨmɨtenda magazo! Kʉikiɨ nʉnyenye kʉpikɨɨla nalɨ? Kʉmʉgimɨɨlya kʉpikɨɨla nalɨ? Mʉleti mʉhʉmba nʉwanso apaitɨ!” <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Yesʉ wɨkamʉkenela hɨng'wɨ, wɨkapuma, papo paapo mʉhʉmba nʉwanso wɨkakomya.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Sʉnga amanyisigwa ɨkamʉhanga Yesʉ waze wing'wene, ɨkamʉkolya, “Kʉnɨkɨ ʉsese kaleng'wa kʉmʉpʉmya hɨng'wɨ nʉwanso?”<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />Yesʉ wɨkaasʉkɨɨlya, “Kʉnsoko ʉhʉɨɨli wanyu ʉniino. Taɨ kʉmʉtambʉɨla, anga mʉtule mʉkete ʉhʉɨɨli ʉniino anga kaseke ka haladali, mʉhʉmile kʉlʉɨla ʉlʉgʉlʉ ʉlʉ. ‘Hega apa itɨ ʉlongole apoitɨ,’ nʉ lwenso lʉkʉ longola. Kʉtili kɨntʉ kɨhi nɨkɨkʉmʉlema. <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />Hɨng'wɨ anga ʉyʉ shanga ʉhʉmile kʉpʉmaʉʉ, ingɨ kʉlompa nʉ kʉgwalya kʉlya.”<verse eid="MAT 17:21" /></para>
  <para style="s">Yesʉ ʉkʉmɨtambʉla hangi nsha akwe nʉ wiʉki wakwe</para>
  <para style="r">
    <ref loc="MRK 9:30-32">Maliko 9:30-32</ref>; <ref loc="LUK 9:43-45">Lʉka 9:43-45</ref></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Lʉhikʉ lʉng'wɨ amanyisigwa naɨakolɨ palʉng'wɨ kʉ Galilaya, Yesʉ wɨkaaɨla, “Ng'wana nʉwa Mʉntʉ ʉkʉambwa nʉkʉtalwa kʉantʉ, <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />antʉ nɨanso akʉmʉbʉlaga, lʉhikʉ nʉla kataatʉ ingɨ ʉkiʉkigwa.”</para>
  <para style="p" vid="MAT 17:23">Amanyisigwa akwe ingɨ ɨkahʉsha ʉbi.<verse eid="MAT 17:23" /></para>
  <para style="s">Kʉpumya kodi a Nyʉmba ang'wi Itunda</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Naɨapɨka kʉ Kapelinaʉmu ahangʉlya kodi anyʉmba ang'wi Itunda ɨkamʉhanga ʉ Petelo, ɨkamʉkolya, “Itɨɨ, mʉmanyisi wanyʉ wɨpumyane kodi na Nyʉmba ang'wi Itunda?”<note caller="+" style="f"><char style="fr" closed="false">17:24 </char><char style="ft" closed="false">Anga nusu senti</char></note><verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />Petelo wɨkasʉkɨɨlya, “Ee wɨpumya.”</para>
  <para style="p" vid="MAT 17:25">Itɨ gwa, Petelo naɨ wingɨla mʉnyʉmba, Yesʉ wɨkamʉkaya ʉ Petelo wɨkamʉkolya, “Ʉewe Simoni, ʉine ʉlɨ? Atemi amihɨɨ ɨhangʉlya kodi kʉpuma kʉantʉ nɨaʉlɨ? kʉpuma kʉalola ihɨɨ ang'wi anyakʉlɨ?”<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />Petelo wɨkasʉkɨɨlya, “Kʉpuma kʉanyakʉlɨ.”</para>
  <para style="p" vid="MAT 17:26">Yesʉ wɨkamʉɨla. “Kʉlʉlo akola ihɨɨ alekilwe. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Ingɨ kʉleke kʉatasha, hola ɨndoano longola mʉlʉzɨ wende ʉtege mʉlʉzɨ, nsamaki ang'wandyo kʉambigwa, mamahʉle mʉlomo ʉkʉhanga mpɨa. Hole mpɨa nanso ʉpumye kodi ane nɨyɨ nako.”<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">Nyenyʉ nɨmʉkʉlʉ mʉ ʉtemi wang'wi Itunda</para>
  <para style="r">
    <ref loc="MRK 9:33-37">Maliko 9:33-37</ref>; <ref loc="LUK 9:46-48">Lʉka 9:46-48</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Itʉngo nɨlanso amanyisigwa akwe ɨkamʉhanga ʉ Yesʉ, ɨkamʉkolya, “Nyenyʉ nʉmʉkʉlʉ mbele mʉʉtemi nʉwa kigʉlʉ?” <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />Yesʉ wɨkamʉhola mʉng'enya ʉng'wɨ, wɨkamimɨsha pakatɨ, <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />sʉnga wɨkaaɨla, kʉmʉɨla tai, anga mʉhite kʉkaɨlɨka mʉtʉle anga mʉng'enya, shanga mʉkingɨla mʉ ʉtemi nʉwa kigʉlʉ <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Kʉlʉlo mʉntʉ nʉkininompya anga mʉng'enya, yʉyo mʉkʉlʉ mʉʉtemi nʉwa kigʉlʉ. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />Mʉntʉ wɨhi nʉkʉmʉsingɨɨlya mʉang'enya anga ʉyʉ kʉlina lane, ʉkʉtula ʉnsɨngɨɨye nene.<verse eid="MAT 18:5" /></para>
  <para style="s">Mageng'wa nɨɨmʉsasha mʉntʉ watende mɨlandʉ</para>
  <para style="r">
    <ref loc="MRK 9:42-48">Maliko 9:42-48</ref>; <ref loc="LUK 17:1-2">Lʉka 17:1-2</ref></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />“Mʉntʉ wɨhi nʉkʉmʉsasha ʉng'wɨao mʉang'enya nɨaniino mʉawa nɨanihʉɨɨe, ibahʉ kʉng'wakwe anga watungɨɨligwe lwala mʉnkingo wagʉmilwe mʉlʉzi pailʉndu. <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />Akaga antʉ amihɨɨ nɨɨsasha antʉ nɨamʉhʉɨɨe ʉ Kilisito atende mɨlandʉ. Masasho nɨmɨsasha mʉntʉ watede mɨlandʉ, Ingɨ ʉkaga mʉntʉ nʉanso nʉkʉtʉla ɨsasho nɨla mʉntʉ kʉtenda mɨlandʉ. <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />“Anga itʉle mʉkono ang'wɨ mʉgʉlʉ ʉkʉʉsasha ʉtende mɨlandʉ, ʉteme ʉgʉme kʉli nʉewe. Ingɨ bahʉ kingɨla mʉʉpanga ɨze wɨmʉgila mʉkono ʉng'wɨ ang'wɨ mʉgʉlʉ ʉng'wɨ, kʉkila kʉgʉmɨlwa mʉmoto nɨshanga wɨlima mahikʉ ɨhi nɨmagila mpelo ɨze ʉkete mɨkono ɨbɨɨlɨ ang'wɨ mɨgʉlʉ ɨbɨɨlɨ. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Nɨliho lako anga ɨze lɨkʉʉsasha ʉtende mɨlandʉ, lɨkompole ʉlɨgʉme kʉlɨ nʉewe. Ingɨ bahu kingɨla kʉʉpanga nihongo, kʉkɨla kʉgʉmɨlwa mʉmoto nɨshanga wɨlima mahikʉ ɨhi nɨmagila mpelo ɨzeʉkete miho abɨɨlɨ.<verse eid="MAT 18:9" /></para>
  <para style="s">Mpyani ankolo nɨlimɨe</para>
  <para style="r">
    <ref loc="LUK 15:3-7">Lʉka 15:3-7</ref></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />“Hʉgʉki! Mʉleke kʉmʉmela ʉng'wɨao mʉaniino awa, kʉnsoko kʉmʉila Mitʉmi nʉwa kigʉlʉ nʉang'wi Itunda nʉwa ang'enya awa matʉngo ɨhi ɨza akolɨ palʉng'wɨ nʉ Tata wane nʉwa kigʉlʉ. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />Kʉnsoko Ng'wana nʉwa Mʉntʉ aɨʉzile aguna awo nɨishiɨ anga alimɨe. <verse eid="MAT 18:11" /><verse number="12" style="v" sid="MAT 18:12" />Mʉine ʉlɨ? Mʉntʉ angaɨze ʉkete nkolo igana lɨng'wɨ, anga wɨlimilye nkolo ɨng'wɨ, wɨtenda ʉlɨ? Wɨileka mʉlʉgʉlʉ nkolo izi nɨ tisini na tisa, wɨkenda mɨpenza ɨyo nɨng'wɨ nɨlimɨe. <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Anga wamɨlije, kʉmʉɨla tai wɨmɨlowa nanso kʉkɨla izi yɨhi nimakʉmi kenda na kenda nɨshanga ilimɨe. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Nɨitɨga ʉ Tata wanyʉ ga nʉakigʉlʉ, shanga ʉloilwe ʉng'wɨ mʉang'enya awa nɨaniino walimɨle.<verse eid="MAT 18:14" /></para>
  <para style="s">Kilɨnga nʉ mʉntʉ nʉkʉgazɨɨye</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />“Mʉnyandʉgʉ wako anga wakʉgazɨɨlye, mʉhange ʉmʉɨle igazo lakwe ize mɨabɨɨlɨ dʉ. Anga wakije ʉkʉtula wamʉlija ʉmʉnyandʉgʉ wako. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Mʉnyandʉgʉ nʉanso anga wahite kʉija, mitangɨlye mʉntʉ ʉng'wɨ ang'wɨ antʉ abɨɨlɨ amʉtegeelye, ingɨ kʉkɨɨla ntambʉ aantʉ abɨɨlɨ ang'wɨ ataatʉ, makani nɨmigazɨɨye ahume kʉhungwa, anga ʉandɨkwa nʉandɨkilwe. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Anga wahite kʉija nɨanso, pisha kɨanza la ahʉɨɨli. Anga wahita kʉlɨtegeelya ianza nɨla ahʉɨɨli, mʉalye anga antʉ nɨshanga amʉmanyile Itunda nɨ ahangʉlya kodi.<verse eid="MAT 18:17" /></para>
  <para style="s">Kʉgilya nʉ kʉgombya</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />Yesʉ akalongoleka kʉtambʉla, “Kʉmʉila ɨtai, kɨhi nɨmʉkʉkɨgilya mihɨɨ nʉ kigʉlʉ kɨkʉgilingwa, nikɨ nɨmʉkʉkɨgombya mihɨɨ nʉ kigʉlʉ kɨkʉgombigwa.<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />Kʉmʉɨla hangi, antʉ abɨɨlɨ mʉng'wanyʉ anga igombye mihɨɨ mɨkani lɨhi nɨakʉlompa, Tata wane nʉa kigʉlʉ ʉkʉatendeela ɨkani nɨlanso. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Kʉnsoko pɨhi nɨakʉtankana antʉ abɨɨlɨ ang'wɨ ataatʉ kʉlina lane, ʉnene nkolɨ palʉng'wɨ nɨenso.”<verse eid="MAT 18:20" /></para>
  <para style="s">Mpyani amitʉmi nɨshanga wɨlekela</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Sʉnga Petelo wɨkamʉhanga ʉ Yesʉ, wɨkamʉkolya, “Isekʉlʉ, Itɨɨ, mʉnyandʉgʉ wane anga waze ʉlongolekile kʉngazɨɨlya, nʉmʉlekele nkʉa inga? Nkʉa mʉpʉngati ne?”<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />Yesʉ wɨkamʉsʉkɨɨlya, “Shanga kʉlʉnga nkʉa mʉpʉngati ʉdu, ingɨ ga ni nkʉa sabini na saba. <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />Kʉlʉlo ʉtemi wakigʉlʉ ʉhumile kimpyanigwa itɨ, mʉtemi ʉng'wɨ naɨ ʉtakile kʉalya nsao kʉ itʉmi akwe. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Naɨ wandya kʉalya, wɨkaletelwa mʉntʉ naɨʉdaɨgwe ideni la shilingɨ milioni yɨdʉ. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Mʉntʉ nʉanso aɨmʉgila kɨlɨpo kɨhi, kʉitɨ mʉtemi wakwe wɨkalamʉla wagʉligwe, ng'wenso nʉ mʉkima wakwe, nɨana akwe nɨ maɨntʉ ɨhi naɨ ʉkete, walɨpwe ideni lakwe. <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />Intɨ gwa mitʉmi nʉanso, wɨkatʉgama pantongeela amʉtemi wɨkamʉlompa wazelʉnga, ‘Itʉnʉ mbaisɨɨlye ʉnene kʉʉlipa yɨhi nʉndaɨye’. <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Mʉtemi nʉwanso wɨkamʉaisɨɨlya, wɨkamʉlekela ideni lɨhi wɨkamʉleka walongole.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />Ingɨ mitʉmi ʉyʉ naɨwapuma, nʉanso wɨkalongola, wɨkamʉhanga mʉntʉ ʉng'wɨ naɨ itʉmania akaze ʉmʉdaɨye shilingɨ nkeehʉ. Wɨkamʉamba, wɨkamʉgoga, wazemʉila, ‘Ndɨpe ideni lane.’ <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />Mitʉmi mʉya wɨkatʉgama, wɨkamʉlompa, ‘Itʉnʉ mbaisɨɨlye ʉnene kʉʉlipa yɨhi nʉndaɨye’. <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />Ingɨ nʉanso wɨkahita kʉmʉaisɨɨlya, wɨkamʉtwala mʉkadʉlʉmʉ kʉʉzɨɨzamala kʉmʉlɨpa ideni. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Itɨ gwa, itʉmɨ nɨitʉmania naɨ aona ɨkani ɨlɨ nʉtendile ɨkabɨpɨlwa nanguluu, ɨkamʉhanga ʉmʉtemi wao ɨkamʉtambʉila makani ɨhi natendekile. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />Papo mʉtemi ʉyʉ wɨkamitanga ʉmitʉmi nʉanso, wɨkamʉɨla ‘Ʉewe wɨ mitʉmi nʉ mʉbi ikɨlo! Aɨ ʉnompile, nʉnene nɨkakʉlekela ideni lako lɨhi naɨnʉkʉdaɨye. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Itɨɨ, shanga aza ʉtakɨwene, nʉewe ʉmʉaisɨɨlye ʉmitʉmi mɨako anga naza nʉkʉaisɨɨye?’ <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Papo gwa, mʉtemi nʉanso wɨkabɨpɨlwa, wɨkamʉtwala mʉkadulumu wahume kagigwa, kʉpikɨɨla kʉʉzɨza lɨpa ideni lɨhi naɨʉdaigwe.”<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />Yesʉ wɨkamaɨɨlya wɨkalʉnga, Tata wane nʉwa kigʉlʉ ʉkʉmʉtendeela anga mʉleke kʉalekela antʉ nɨamʉgazɨɨye.<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">Yesʉ ʉkʉmanyisa makani awileki nʉwa mʉgoha nʉ mʉkɨma</para>
  <para style="r">
    <ref loc="MRK 10:1-12">Maliko 10:1-12</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Yesʉ naɨwakondya kʉligitya inkani nɨanso, wɨkahega kʉ Galilaya, wɨkalongola kʉ kɨsalɨ Yʉdea, itʉmbɨ nɨla mongo nʉwa Yolodani. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Antʉ ɨdʉ ɨkamʉtyata kʉko, nʉyo wɨkaakomya.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Apalisayo ang'wɨao ɨkamʉhanga amʉgeme, ɨkamʉkolya, “Itɨɨ, inoneene mʉgoha kʉmʉleka mʉsʉngʉ wakwe kʉnsoko ɨhi?”<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />Yesʉ wɨkasʉkɨɨlya, “Itɨɨ, shanga mʉsomilene Nkani yang'wi Itunda kɨna kʉpʉma ʉng'wandyo naɨʉkʉʉmba, aɨʉʉmbile mitʉnja nʉ mʉsʉngʉ? <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />Nʉyo wɨkalʉnga, ‘Yɨyɨ nsoko mitʉnja ʉkʉmʉleka ihe nʉ nyinya, akʉkamɨnkana nʉ mʉsʉngʉ wakwe, ɨhi mʉʉbɨɨlɨ akʉtʉla imʉili ʉng'wɨ.’ <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Kʉɨtɨ, awa nɨabɨɨlɨ akʉtʉla mʉili ʉng'wɨ shanga ɨabɨɨlɨ. Ʉʉgwa ɨkɨ Itunda nʉkamɨnkanilye, mʉntʉ wɨhi waleke kʉkɨtemanʉla”<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />Nɨanso ingɨ ɨkamʉkolya, “Niki gwa, Mʉsa aɨʉkʉlagiiye kʉmʉtemela mʉsʉngʉ wakwe itʉtʉ nɨla kileka?”<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />Yesʉ wɨkaaɨla, ʉ Mʉsa aɨʉmʉɨɨe mʉhʉmile kileka nɨasʉngʉ anyʉ kʉnsoko aʉkakʉ wanyu nɨshanga mɨamba nɨmʉkʉmanyisigwa, ingɨ kʉpʉma ʉng'wandyo aɨkʉtilɨ. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Ʉnene kʉmʉɨla, mʉntʉ wɨhi nʉkʉmʉleka ʉmʉsʉngʉ wakwe kʉnsoko aʉgoolya nʉyo wamʉtine mʉsʉngʉ mʉngɨza, ʉkʉtula ʉkʉgoolya. Nʉyʉ nʉkʉmʉtɨna mʉsʉngʉ ʉyʉ nʉlekilwe nʉyo ga ʉkʉtula wagoolya.”<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />Amanyisigwa akwe ɨkamʉila, angaɨze makani amitʉnja nʉ mʉsʉngʉ ɨlɨitɨ, ingɨ bahʉ mʉntʉ waleke kʉtina,”<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />Yesʉ wɨkaaɨla, “Shanga antʉ ɨhi nɨahʉmile kʉgomba, ihʉmikile kʉantʉ awa Itunda nʉapee ikani nɨlanso. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Kʉnsoko ikolɨ inkwaatya yidʉ niyakʉleka kʉtina, Nɨang'wɨ kʉnsoko atʉgilweʉʉ, nɨang'wɨ atendeewe nɨantʉ, nɨang'wɨ alamʉe aleke kʉtina kʉnsoko aʉtemi nʉwa kigʉlʉ. Nʉhʉmile kʉamba ʉmanyisigwa ʉwʉ nʉwaambe.<verse eid="MAT 19:12" /></para>
  <para style="s">Yesʉ ʉkʉakembeta ang'enya nɨaniino</para>
  <para style="r">
    <ref loc="MRK 10:13-16">Maliko 10:13-16</ref>; <ref loc="LUK 18:15-17">Lʉka 18:15-17</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Sʉnga antʉ ɨkamʉletela ʉ Yesʉ ang'enya nɨaniino waakembeta nʉkʉalompeela. Ingɨ amanyisigwa ang'wa Yesʉ ɨkaagilya. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Yesʉ wɨkaaɨla, “Aleki ang'enya nɨaniino aze kʉng'wane, leki kʉagilyi, kʉnsoko Ʉtemi nʉa kigʉlʉ ingɨ waantʉ nʉwininompya anga ang'enya awa.”<verse eid="MAT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 19:15" />Ʉgwa, Yesʉ wɨkaakembeta, sʉnga wɨkahega pang'wanso.<verse eid="MAT 19:15" /></para>
  <para style="s">Mʉhʉmba nɨmʉgolɨ</para>
  <para style="r">
    <ref loc="MRK 10:17-31">Maliko 10:17-31</ref>; <ref loc="LUK 18:18-30">Lʉka 18:18-30</ref></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Mʉntʉ ʉng'wɨ aɨʉmʉhangile ʉ Yesʉ, wɨkamʉkolya, “Mʉmanyisi nɨmʉkende, nitʉme kɨntʉ kɨɨ nɨkɨza nihʉme kʉlija ʉpanga nʉwa mahikʉ ɨhi nɨmagila anga mpelo?”<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />Yesʉ wɨkamʉɨla “Nɨkɨ ʉkʉnintanga nɨmʉkende? Kʉtilɨ nɨmʉkende ingɨ ʉng'wɨdu Itunda wing'wene. Ingɨ ang'wɨ ʉloilwe kʉlija ʉpanga nʉ wamahikʉ ɨhi nɨmagila mpelo, amba ɨmalagiilyo ang'wi Itunda.”<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />Mʉntʉ nʉwanso wɨkamʉkolya, “Malagɨɨlyo naʉli ʉloilwe nɨmaambe?”</para>
  <para style="p" vid="MAT 19:18">Yesʉ wɨkamʉsʉkɨɨlya, “Leka kʉbʉlaga, Leka kʉgoolya, Leka kɨa, Leka kʉtambʉla ʉteele, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />Mʉkʉlye tataako nʉ iyaako, hangi, Mʉlowe mɨako anga nʉwiloilwe ʉewe.” <verse eid="MAT 19:19" /><verse number="20" style="v" sid="MAT 19:20" />Mʉhʉmba nʉwanso wɨkamʉɨla “Malagɨɨlyo nanso ɨhi nɨmakomaniiye, itɨɨ, nkɨlɨ mpee kɨntʉ kɨɨ?” <verse eid="MAT 19:20" /><verse number="21" style="v" sid="MAT 19:21" />Yesʉ wɨkamʉɨla “Ang'wɨ ʉloilwe kʉtula wɨmʉkende, longola ʉgʉlye insao yako yɨhi nʉkete, ʉape ahimbɨ mpia niyanso, sʉnga wɨze ʉntyate, nʉewe ʉkʉtʉla wiɨkɨlya kɨʉto kako kigʉlʉ.” <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" />Mʉhʉmba nʉwanso naɨwɨja itɨ, wɨkalongola waze ʉhʉkilye, kʉnsoko aɨʉkete nsao yɨdʉ. <verse eid="MAT 19:22" /><verse number="23" style="v" sid="MAT 19:23" />Yesʉ wɨkaaɨla amanyisigwa akwe, “Kʉmʉɨla ɨtai yɨkʉtula ikaku kʉagolɨ kingɨla mʉʉtemi nʉwakigʉlʉ. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Kʉmʉɨla hangɨ, ingɨ yɨhumɨkile kɨkalɨ nɨkitangwa ngamɨa kʉkɨɨla mibolomyo nɨla sindano, kʉkɨla ʉmʉgolɨ kingɨla kʉʉtemi wakigʉlʉ.”<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />Amanyisigwa akwe nɨenso naɨgʉlye nanso ɨkakʉɨlwa nangalʉ, ɨkamʉkolya, “Itɨɨ, nyenyʉ gwa nʉhʉmile kʉgʉnɨka?”<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />Yesʉ wɨkaakendegeela, wɨkaaɨla, “Kʉantʉ ɨkani ɨlɨ shanga lɨhʉmikile, ingɨ kʉng'wɨ Itunda makani ɨhi ahumɨkile.”<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Sʉnga Petelo wɨkamʉɨla “Kaʉsese gwa? Nɨkʉlekile maintʉ ɨhi kakʉtyata wewe; kʉʉpantɨka ntʉni?<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />Yesʉ wɨkaaɨla, “Kʉmʉtambʉila ɨtai, apo Ng'wana wa mʉntʉ nʉkikiɨ mituntu nɨla ʉtemi nɨlɨkʉmɨlɨgɨnta mʉʉnkʉmbigʉlʉ nʉʉpya, nʉnyenye naɨmʉntyatile mʉkikaɨla matuntu ikʉmi na abɨɨlɨ mʉzealamʉla Aisilaeli ndʉgʉ ikʉmi na ibɨɨlɨɨ. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Nʉ mʉntʉ wɨhi nʉlekile ito, ang'wɨ aheu akwe, ang'wɨ alʉna nɨakima, ang'wɨ ihe, ang'wɨ nyinya, ang'wɨ ana, ang'wɨ migʉnda, kʉnsoko ane, ʉzelija nkʉa igana, nʉkʉpegwa ʉpanga mahikʉ ɨhi nimagila anga mpelo. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Ingɨ nɨatongee akʉsɨkɨɨlya, nawa nɨsɨkɨɨye akʉtongela.<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">Itʉmi amʉ mʉgʉnda wa mɨzabibʉ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />Yesʉ wɨkalongoleka kʉaɨla kɨna, “Ʉʉtemi wa kigʉlʉ, wɨpyani nʉ mʉntʉ nʉlɨmile mʉgʉnda, watemele mɨzabibʉ, naɨ wiandɨɨe kʉana antʉ alongole kutyɨtya mʉ mʉgʉnda nʉwanso. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Ɨkigombya nɨenso kɨna ʉkʉalɨpa ɨkɨnyamʉlɨmo kaʉtyɨti nɨka lʉhikʉ lʉng'wɨ, naɨ igombasɨɨlya wɨkaatwala kʉmʉlɨmo nʉwanso. <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />Wɨkapuma hangɨ matʉngo a saa tatʉ kɨdaʉdaʉ, wɨkaaona antʉ nɨaʉya ɨmɨkile insʉng'wa pigalagalo agilanga mʉlɨmo. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Wɨkaaɨla, ‘Longoli nʉnyenye mende tyɨtya kʉ mʉgʉnda wane nʉwa mɨzabibʉ, nʉ nene kʉmʉpa ɨkɨnyamʉlɨmo kanyʉ anga mʉitakɨwe.’ <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Kʉlʉlo antʉ nɨanso ɨkalongola. ‘Ʉmʉkola mʉgʉnda nʉwanso wɨkapuma hangɨ itungo nɨla saa mʉtandatʉ nitʉngo nɨla saa kenda, wɨkatendaʉʉ. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Nɨ saa kʉmi na moja mpɨndɨ wɨkapuma hangɨ, wɨkaahanga nɨ aʉya imɨkile agilanga mɨlɨmo. Wɨkaakolya, ‘Nɨkɨ mimɨkila ng'ʉng'wɨ pii, mɨagilanga mʉlɨmone? <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />Antu nɨanso ɨkamʉsʉkɨɨlya, ‘Kimɨkile kʉnsoko kʉtilɨ anga mʉntʉ nʉkʉpee ʉmʉlɨmo wakitʉma,’ nʉyo wɨkaaɨla, ‘Nʉnyenye longoli mitʉme mʉlɨmo mʉ mʉgʉnda wane nʉwa mɨzabibʉ.’<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />“Lyoa naɨ lɨkʉhaɨɨla, mʉkola mʉgʉnda nʉanso wɨkamʉɨla ʉmʉamba mpɨa wakwe, ‘Itange ɨitʉma mʉlimo aze ʉape ɨkɨnyamʉlɨmo kao, wandye awa naza asɨkɨɨye kʉɨkwa mʉmʉlɨmo, ʉmaɨɨlye nawa naza atongee kʉɨkwa mʉmʉlɨmo. <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />Itɨgwa, ɨkaza awa naɨkilwe ɨmpɨndɨ matʉngo a saa kʉmi na moja wɨkapegwa ilɨpo la lʉhikʉ lʉng'wɨ. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Itɨgwa ɨkapika awa naɨandilye kɨdaʉdaʉ, nɨanso aɨasɨgile akongeeligwa kʉkila ɨaʉya, ingɨ mʉntʉ wɨhi wɨkapegwa ilɨpo la lʉhikʉ lʉng'wɨ. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Naɨahola ilɨpo lao, shanga ɨkalowa ɨkamʉɨla mʉkola mʉgʉnda shanga ʉkʉtendee anga iza. <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />Ɨkazelʉnga, ‘Antʉ awa naza asɨkɨɨye itʉmile mʉlɨmo itungo la saa ing'wɨ, nɨkɨ waapa anga ʉsese nɨkʉgimilye kituma mʉlɨmo ng'ʉng'wɨ pi?’<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />Papo gwa, “Mʉkola mʉgʉnda wɨkamʉsʉkɨɨlya ʉng'wɨao, ‘Mʉhʉmba mɨane, shanga nʉkʉkapile anga kɨntʉ! Itɨɨ, shanga aza kigombilye anga ilɨpo la lʉhikʉ lʉng'wɨ? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Hola ilɨpo lako, ʉlongole. Nene ndoilwe kʉmʉpa ʉyʉ nʉsɨkɨɨye anga ʉewe. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Itɨɨ, ngiigwene kitʉmɨla ɨnsao ane anga mʉndoewe? Itɨɨ, waona wɨlune kʉnsoko ʉnene nɨmʉkende?”’<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />Sʉnga Yesʉ wɨkalʉnga itɨ, “Ʉʉgwa, nɨatongee akʉsɨkɨɨlya, nawa nɨakʉsɨkɨɨlya akʉtongela.”<verse eid="MAT 20:16" /></para>
  <para style="s">Yesʉ ʉkʉtambʉla nkʉa akataatʉ kʉsha nʉkiʉka kʉng'wakwe</para>
  <para style="r">
    <ref loc="MRK 10:32-34">Maliko 10:32-34</ref>; <ref loc="LUK 18:31-34">Lʉka 18:31-34</ref></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Yesʉ naɨʉlongoe kʉ Yelʉsalemu, aɨʉhoile kɨmpelo atule ɨenso amanyisigwa akwe awa nikʉmi na abɨɨlɨ wɨkaaɨla, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“Tegeelyi katɨ,” “Kʉlongoe kʉ Yelʉsalemu, kʉng'wanso Ng'wana nʉwa Mʉntʉ winzʉambwa nʉ kʉmʉtala Apolyi nɨakʉlʉ nɨ amanyisi amalago ang'wa Musa, nawo akʉlamʉla wabʉlagwe. <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />Nɨ Apolyi nɨakʉlʉ akʉmʉtala mʉantʉ nɨ shanga ayahudi, akʉmʉng'eng'a, nʉ kʉmʉkʉa nkotya sʉnga kʉmʉbʉlaga aze amʉkonontee mʉmʉsalaba, ingɨ ʉlʉhikʉ lakataatʉ ʉkiʉkigwa.”<verse eid="MAT 20:19" /></para>
  <para style="s">Nyinya nʉwa Yakobo nʉ Yohana Mʉbadisi ʉkʉalompelya ana akwe kɨntʉ</para>
  <para style="r">
    <ref loc="MRK 10:35-45">Maliko 10:35-45</ref></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Sʉnga, mʉsʉngʉ wang'wa Zebedayo palʉng'wɨ nɨana akwe ɨkamʉhanga ʉ Yesʉ, wɨkatʉgama pa mɨgʉlʉ ang'wa Yesʉ wɨkalompa kɨntʉ.<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />Yesʉ wɨkamʉkolya, “Ʉloilwe ntʉni?” Mʉsʉngʉ nʉanso wɨkasʉkɨɨlya, “Sintambʉɨle ɨtai kɨna kʉʉtemi wako ɨana ane awa nɨabɨɨlɨ aziikiɨ ʉng'wɨ ipande lako nɨlakigoha nʉ mʉya ipande lako nɨla kɨsʉngʉ.”<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />Yesʉ wɨkasʉkɨɨlya, “Ʉnyenye shanga mʉlɨngile mʉkʉlompa ntʉni. Itɨɨ, mʉhʉmilene kʉng'wela kɨkombe ka lwago anga nɨnɨkang'wela ʉnene?”</para>
  <para style="p" vid="MAT 20:22">Ɨkamʉsʉkɨɨlya, “Ee kʉʉng'wela.”<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />Yesʉ wɨkaaɨla, “Tai mʉhʉmile kʉng'wela kɨkombe ka lwago anga nɨnɨkang'wela ʉnene, ingɨ ʉlʉ nʉlakikiɨ ipande lakigoha ang'wɨ nɨlakɨkɨma shanga mʉlɨmo wane, ɨkani nɨlanso akʉpegwa nɨakondilye kʉɨkɨligwa nʉ Tata Wane.”<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Amanyisigwa aʉya awa nikʉmi naɨ ija itɨ, ɨkaatakɨɨla a Yakobo nʉ Yohana Mʉbadisi.<verse eid="MAT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 20:25" />Kʉitɨ Yesʉ wɨkaitanga ɨhi palʉng'wɨ, wɨkaaɨla, “Mʉlɨngile kɨna atemi aantʉ nɨshanga Ayahudi ɨatema antʉao kʉʉhumi, atemi nɨanso ɨitʉmya antʉ mɨlɨmo kʉngulu. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Ingɨ kʉng'wanyʉ ileke kʉtʉla itɨ, mʉntʉ ʉyʉ nʉloilwe kʉtʉla mʉkʉlʉ kʉaʉya ʉtakɨwe kʉatʉmɨkɨla aʉya ɨhi, <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />nʉ mʉntʉ ʉyʉ nʉloilwe kʉtʉla mʉtongeeli wanyu ʉtakiwe watule mʉnyamɨlɨmo wanyu, <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />anga ʉʉgwa, Ng'wana nʉwa Mʉntʉ shanga aɨʉzetʉmɨkɨlwa, ingɨ aɨʉzetʉmɨkɨla nʉ kʉpʉmya ʉpanga wakwe wahume kʉakomola antʉ ɨdʉ.”<verse eid="MAT 20:28" /></para>
  <para style="s">Yesʉ ʉkʉakomya apokʉ abɨɨlɨ</para>
  <para style="r">
    <ref loc="MRK 10:46-52">Maliko 10:46-52</ref>; <ref loc="LUK 18:35-43">Lʉka 18:35-43</ref></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Itungo Yesʉ nɨ amanyisigwa akwe naɨʉkʉhega mʉkɨsalɨ ka Yeliko, iʉmbɨ laantʉ lɨkamʉtyata. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Aɨakoli apokʉ abɨɨlɨ ikiɨ mʉmpelo anzɨla, naɨija kɨna Yesʉ ʉkɨile, ɨkitʉnta ɨzelʉnga, “Isekʉlʉ, Ng'wana wang'wa Daudi, kʉaisɨɨlye!”<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />Iʉmbɨ laantʉ nɨanso lɨkaakenela ɨapokʉ nɨanso akilage. Ingɨ apokʉ nɨanso ɨkalongoleka kitʉnta azelʉnga, “Isekʉlʉ, Ng'wana wang'wa Daudi, ʉkʉaisɨɨlye!”<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />Yesʉ wɨkimɨka, wɨkaɨtanga wɨkaakolya, “Mʉloilwe nʉmʉtendeele ntʉni?”<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />Apokʉ nɨanso ɨkamʉsʉkɨɨlya, “Isekʉlʉ kʉʉloilwe kʉone.”<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />Kʉlʉlo, Yesʉ wɨkaaisɨɨlya, wɨkaatonya mihoao, itʉngo lɨlo ɨkatula ona, nawo ɨkamʉtyata.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">Yesʉ ʉkingɨla mʉ Yelʉsalemʉ kʉ ngiligili</para>
  <para style="r">
    <ref loc="MRK 11:1-11">Maliko 11:1-11</ref>; <ref loc="LUK 19:28-40">Lʉka 19:28-40</ref>; <ref loc="JHN 12:12-19">Yohana 12:12-19</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Lʉhikʉ lʉng'wɨ, Yesʉ nɨamanyisigwa akwe naɨahʉmbeela kʉ Yelusalemu ɨkapika kɨsalɨ ka Betipage mʉlʉgʉlʉ nʉla mɨzeɨtʉni, wɨkaalagɨɨlya amanyisigwa akwe abɨɨlɨ, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />wɨkaaɨla, “Longoli mʉkɨsalɨ nɨkɨkolɨ kʉntongeela anyu mʉkʉhanga ndogwe ɨtungilwe palʉng'wɨ nʉng'wana. Itungʉɨli mʉndetele. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Anga mʉntʉ wamʉkolye nɨkɨ mʉkʉitungʉɨla, mʉɨli itɨ, ‘Isekʉlʉ ʉitakile,’ nʉyo ʉkʉmʉgombya mʉilete.<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Ikani ɨlɨ aɨlɨtendekile kʉnsoko ikani naɨʉtambʉe nʉ mʉmanga lɨtimɨle,<verse eid="MAT 21:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MAT 21:5" />“Atambʉɨli antʉ akʉ Yelusalemu yɨyo Sayuni.</para>
  <para style="q" vid="MAT 21:5">Gozi, mʉtemi wanyu ʉpembilye!</para>
  <para style="q" vid="MAT 21:5">Mʉpolo ʉnankɨe mʉmʉgongo nʉwa ndogwe,</para>
  <para style="q" vid="MAT 21:5">ng'waa ndogwe.”<verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Kʉitɨ, amanyisigwa nɨanso ɨkalongola ɨkitʉma anga naɨ aɨɨwe nʉ Yesʉ. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Ɨkamɨleta ndogwe nʉanso nʉ ng'wa ndogwe, ɨkaɨla matugalo ao mʉ mʉgongo nʉwa ng'waa ndogwe nʉ Yesʉ wɨkanankɨla wɨkikaɨla matugalo nanso. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Iumbɨ nila antʉ ɨkaɨla matugalo ao mipanda, nɨang'wɨ ɨkabuna pitambɨ pya mɨtɨ ɨkaɨla mipanda. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Iumbɨ nɨla antʉ naɨlitongee nawa naɨasɨkɨɨye ɨhi ɨkitʉnta ɨzelʉnga,</para>
  <para style="q" vid="MAT 21:9">“Wakʉligwe, Ng'wana wang'wa Daudi!</para>
  <para style="q" vid="MAT 21:9">Ʉkʉigwe ʉyo nʉzile kʉlina lang'wɨ Isekʉlʉ!</para>
  <para style="q" vid="MAT 21:9">Ikʉlyo kʉng'wi Itunda nʉwa kigʉlʉ!”<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Yesʉ naɨ ʉkingɨla kʉ Yelusalemu, antʉ ɨhi ɨkakʉilwa. Ɨkatula kolya, “Ʉyʉ itɨ nyenyu”<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />Angʉ ang'wɨ miumbɨ nɨlanso ɨkalʉnga, “Ʉyʉ ingɨ mʉmanga Yesʉ, ʉpumile kɨsalɨ ka Nazaleti kɨsalɨ nɨ kɨniino nɨka Galilaya.”<verse eid="MAT 21:11" /></para>
  <para style="s">Yesʉ ʉlongoe mʉ Nyʉmba ang'wi Itunda</para>
  <para style="r">
    <ref loc="MRK 11:15-19">Maliko 11:15-19</ref>; <ref loc="LUK 19:45-48">Lʉka 19:45-48</ref>; <ref loc="JHN 2:13-22">Yohana 2:13-22</ref></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Ʉʉgwa, ʉ Yesʉ wɨkapika mitando nɨla Nyʉmba ang'wi Itunda, wɨkaazʉnsa antʉ naɨ akʉsʉlʉja maintʉ nawa naɨ akʉgʉla apume mitando nɨla Nyʉmba ang'wi Itunda, wɨkaipɨʉla meza niya akaisa mpia, nɨ matuntu asʉlʉja nkʉnda. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Wɨkaaɨla, “Yandɨkilwe Mʉʉandɨkwa wang'wi Itunda. Nyʉmba ane ɨkitangwa nyʉmba ipolyo. Ʉnyenye mamɨgela ikʉlʉngʉ nɨlaii.”<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Papo akɨtele ɨkamʉhanga Pa Nyʉmba ang'wi Itunda nʉyo wɨkaakomya. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Ʉʉgwa, Apolyi nɨ akʉlʉ nɨ amanyisi amalagɨɨlyo ang'wa Musa, naɨaona makani aʉkʉɨlwa Yesʉ naɨʉkitʉma, ni ang'enya naɨakɨmba ɨkazelʉnga, “Ikʉlyo kʉ Ng'wana wang'wa Daudi,” ɨkahung'wa ikuo <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />Kʉlʉlo ɨkamʉɨla ʉ Yesʉ, “Itɨ, ʉewe Yesʉ shanga wɨgʉlyene nɨakʉlʉnga ɨang'enya?”</para>
  <para style="p" vid="MAT 21:16">Yesʉ wɨkaasʉkɨɨlya, “Ee, nigʉlye! Itɨɨ, mʉkɨlɨne kʉsoma mʉyandɨkile itɨ? ‘Kʉmɨlomo ang'enya nɨaniino nawa nɨadabʉ akʉʉkʉlya ʉewe.”’<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />Ʉʉgwa, Yesʉ wɨkaaleka, wɨkapuma mʉ kɨsalɨ nɨkanso, wɨkalongola kʉ Betahania, wɨkalala kʉko.<verse eid="MAT 21:17" /></para>
  <para style="s">Yesʉ ʉkʉʉzuma mʉkʉyʉ</para>
  <para style="r">
    <ref loc="MRK 11:12-14">Maliko 11:12-14-20-24</ref></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Yesʉ wɨkiandɨɨla kɨdaʉdaʉ kʉpuma ku Betania wɨkatʉlya mʉ kɨsalɨ ka Yelusalemu, mʉnzɨla wɨkahʉng'wa nzala. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Wɨkaʉona mʉkʉyʉ ʉng'wɨ mʉmpelo anzɨla, wɨkaʉhʉmbeela, wɨkahanga ʉdemile ɨmatʉtʉ du. Papo wɨkaʉzuma, wazelʉnga, “Ʉleka kʉpaa nkali kwe!” Papo paapo mʉkʉyʉ nʉanso wɨkʉma.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />Amanyisigwa akwe naɨaona itɨ ɨkakʉilwa, ɨkamʉɨla, “Yatula ʉlɨ ʉmʉkʉyʉ ʉwʉ kʉpumpugɨɨlya wʉma?”<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />Yesʉ wɨkaaɨla, “Kʉmʉila ɨtai, angaitule mʉkete ʉhʉɨɨli nʉʉgila nkankani, shanga mʉkitʉma anga yaya du, ingɨ mʉhʉmile kʉʉtambʉɨla ʉlʉgʉlʉ ʉlʉ, “Hɨmbʉka pang'wanso wigʉmɨle mʉlʉzi nʉlʉkʉlʉ, yɨkʉtulaʉʉ.’ <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Hangi anga mʉtule nʉʉhʉɨɨli, kɨhi nɨmʉkʉlompa kʉng'wi Itunda, mʉkʉpantɨka.”<verse eid="MAT 21:22" /></para>
  <para style="s">Yesʉ ʉkʉkoligwa mpola niya ʉhumi wakwe</para>
  <para style="r">
    <ref loc="MRK 11:27-33">Maliko 11:27-33</ref>; <ref loc="LUK 20:1-8">Lʉka 20:1-8</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Yesʉ wɨkingɨla hangɨ panyʉmba ang'wi Itunda, wɨkatula manyisa. Naɨʉkʉmanyisa, apolyi nɨakʉlʉ nɨ anyampala aantʉ ɨkamʉhanga nʉkʉmʉkolya, “Ʉkitʉma imakani aya kʉʉhumi wang'wa nyenyu? Nyenyʉ nʉkʉgombilye wɨtʉme itɨ?”<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />Yesʉ wɨkaakolya, “Nʉnene kʉmʉkolya ikolyo lɨng'wɨ, anga mansʉkɨɨlya, nʉnene kʉmʉɨla kitʉma kʉʉhumi wang'wa nyenyu?” <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Itɨɨ, ʉhumi wang'wa Yohana Mʉbadisi nʉwakʉbadisa antʉ, aɨʉpumile kʉng'wi Itunda ne ang'wɨ kʉantʉ?”</para>
  <para style="p" vid="MAT 21:25">Ɨkaakikolya kɨmpelo, “Angakʉlʉnge, kʉng'wi Itunda,’ ʉkʉʉkolya, ‘Apa nɨkɨ nɨshanga mɨkahʉɨɨla ʉ Yohana Mʉbadisi?’ <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Hangɨ anga kʉlʉnge, ‘Aɨʉpumile kʉantʉ, kogopile iumbɨ laantʉ nɨahumile kʉtenda, kʉnsoko antʉ aɨalɨngile kɨna Yohana Mʉbadisi aɨmʉmanga wang'wi Itunda.” <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />Ʉʉgwa, ɨkamʉsʉkɨɨlya, “Shanga kʉlingile!” Yesʉ nʉyo wɨkaasʉkɨɨlya,</para>
  <para style="p" vid="MAT 21:27">“Nʉnene ga shanga kʉmʉila kitʉma kʉʉhumi wang'wa nyenyu.<verse eid="MAT 21:27" /></para>
  <para style="s">Mpyani ahʉmba abɨɨlɨ</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />“Ʉnyenye mʉine ʉlɨ? Mʉntʉ ʉng'wɨ aɨʉkete ahʉmba abɨɨlɨ. Wɨkamʉɨla nʉa ng'wandyo, ‘Ng'waane, lelɨyɨ longola witʉme kʉ mʉgʉnda nʉa mɨzabibʉ.’ <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />Mʉhʉmba nʉanso wɨkasʉkɨɨlya ‘shanga ninzʉ!’ Panyambele wɨkisɨja, sʉnga wɨkalongola. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />Ʉtata nʉanso wɨkamuɨla ʉng'waakwe nʉakabɨɨlɨ leliyi longola witʉma kʉmʉgʉnda nʉa mɨzabibʉ, nʉyo wɨkamʉsʉkɨɨlya ʉ tata akwe, Ninzʉ Tata ane! Ingɨ shanga wɨkenda kʉ mʉlimo nʉanso. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />Itɨ gwa, mʉahʉmba awa nɨabɨɨlɨ nʉʉlɨ naɨ wɨtʉmile aya nʉ tata wao aɨʉtakile?” “Ikamʉsʉkɨɨlya, ingɨ yʉyʉ nʉa ng'wandyo.</para>
  <para style="p" vid="MAT 21:31">“Ʉʉgwa Yesʉ wɨkaaɨla, “Taɨ kʉmʉtambʉila,</para>
  <para style="p" vid="MAT 21:31">Ahangʉlya mpia niya kodi nɨagoolya akʉmʉtongeela kingɨla kʉ ʉtemi wang'wi Itunda. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Yohana Mʉbadisi aɨʉzile mʉlagɨɨla kishiɨ ɨze mʉmʉloeeye Itunda, ʉnyenye shanga mɨkamʉhʉɨɨla, ingɨ ahangʉlya kodi nɨagoolyi ɨkamʉhʉɨɨla. Ʉnyenye palʉng'wɨ nʉkʉona nanso ɨhi shanga mɨkila itʉnʉ nʉmʉhʉiila.”<verse eid="MAT 21:32" /></para>
  <para style="s">Mpyani aalɨmi nɨabɨ</para>
  <para style="r">
    <ref loc="MRK 12:1-12">Maliko 12:1-12</ref>; <ref loc="LUK 20:9-19">Lʉka 20:9-19</ref></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />Yesʉ wɨkalʉnga, “Tegeelyi nɨ mpani nzʉya,” “Mʉntʉ ʉng'wɨ aɨʉtemee zabibʉ mʉmʉgʉnda wakwe, wɨkazenga kɨtala ka kʉliɨla, wɨkahɨmba ikombo lakʉgundɨkɨla dibai, wɨkimɨsha nɨkɨlɨngasɨɨlyo. Sʉnga wɨkaagodisa kʉ antʉ nʉwanso wɨkatunga mʉhinzo kʉ mahɨɨ akʉlɨ. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Matʉngo akʉogola, wɨkaalagɨɨlya itʉmi akwe kʉalimi, amʉhoelye iganda lakwe. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Alimi nɨanso ɨkaagumɨla awo naɨalagɨɨigwe; ʉng'wɨ ikamʉkʉa, ʉmʉya ɨkamʉbʉlaga nʉmʉyao ɨkamʉkʉa magwe. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Mʉkola mʉgʉnda nʉanso wɨkaalagɨɨlya hangi itʉmi aʉya, ɨkaze ɨdʉ kʉkɨla nɨa ng'wandyo, alimi nɨanso ɨkaatenda anga naɨatendile awo nɨang'wandyo. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Panyambele wɨkamʉlagɨɨlya ʉng'waakwe waze ʉsɨgɨɨe kɨna, lelo akʉmʉkela ʉng'waane.’ <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />Ingɨ ɨalimi nɨanso naɨ amʉona ʉng'waakwe ikitambʉlya, ‘Ʉyʉ yʉyʉ mʉsali, ali kʉmʉbʉlage kʉsale sese isalo lakwe!’ <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Ʉʉgwa, ɨkamʉgumɨla, ɨkamʉkʉa nʉkʉmʉbʉlaga nʉkʉmʉgʉma kʉnzi amʉgʉnda nʉanso.<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />Yesʉ wikaakolya, “Itʉngo nɨlanso nʉkʉtʉlya ʉmʉkola mʉgʉnda nʉanso, ʉkʉatenda ʉli ɨalɨmi nɨanso?”<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />Nɨanso ɨkamʉsʉkɨɨlya, ʉkʉalimansɨɨlya ibɨ hangɨ atenda mɨlandʉ, nʉmʉgʉnda nʉanso ʉkʉapangisa alɨmi angɨɨza, nɨahumile kʉmʉpa ɨkɨganda kakwe.”<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Yesʉ wɨkaakolya, “Itɨɨ?</para>
  <para style="q" vid="MAT 21:42">Shanga mʉsomilene mʉʉandɨkwa wang'wi Itunda?</para>
  <para style="q" vid="MAT 21:42">Igwe naɨlɨhitilwe nɨazengi latʉile igwe nɨlɨsanigwe mʉkɨtako ka nyʉmba.</para>
  <para style="q" vid="MAT 21:42">Ikani ɨlɨ lɨpembeeye kʉn’wi Itunda,</para>
  <para style="q" vid="MAT 21:42">nɨkani ɨlɨ laʉkʉɨlwa kʉng'wɨtʉ!’<verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />“Kʉlʉlo kʉmʉila, ʉtemi wang'wi Itunda ʉkʉhegigwa kʉng'wanyʉ akʉpegwa antʉ nɨshanga ayahudi nɨahʉmile kʉtenda namʉloeeye Itunda.” <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Mʉntʉ wɨhi nʉkʉgwɨla migwe nɨlanso ʉkʉbunɨka mapɨlɨga mapɨlɨga, nʉ mʉntʉ wɨhi nʉkʉgwɨlwa nigwe nɨlanso ʉkʉtʉlangwa”<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />Apolyi nɨakʉlʉ a Ayahudi nɨa Palisayo naɨija mpyani nanso ɨkalɨnga kɨna Yesʉ ʉkʉatambʉla enso. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Kʉlʉlo ɨkatula duma nzɨla akʉmʉamba, ingɨ kʉnʉ ɨeaogopile antʉ kʉnsoko antʉ aɨalɨngile kɨna ʉ Yesʉ mʉmanga wang'wi Itunda.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">Mpyani andya niya wɨnga</para>
  <para style="r">
    <ref loc="LUK 14:15-24">Lʉka 14:15-24</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Yesʉ wɨkitambʉlya nɨamanyisigwa akwe hangɨ kʉmpyani, <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />“Ʉtemi nʉakigʉlʉ ʉhumile kɨmpyanigwa nʉ mʉtemi naɨ ʉmʉnoneeye mʉhʉmba wakwe ndya niya wɨnga. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Itɨgwa, wɨkaalagɨɨlya anɨɨli akwe aitange awa naɨanilwe kʉwɨnga, ingɨ awanaɨanilwe shanga ɨkagomba kɨza. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />Wɨkaalagɨɨlya hangɨ anɨɨli angɨɨza, wɨkaaɨla, ‘Aɨli awa naza nɨanile, nanoneelya ʉʉlyi, nsɨnzile nzagamba niamʉdama nɨagɨnʉ, maɨntʉ ɨhi akonda, pembyi kʉwɨnga.’ <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />Ingɨ nɨanso ɨkadalaha, ɨkahongayao, ʉng'wɨao kʉmʉgʉnda, ʉmʉya kʉmɨlɨmo akwe, <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />nɨang'wɨ ɨkaagumɨla awaitɨ naɨatʉmilwe ɨkaakongoga, ɨkaabʉlaga. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Mʉtemi nʉanso wɨkatakɨsha, wɨkaalagɨɨlya anyambita akwe ende aabʉlage ɨabulagi awa nukʉsonsa moto kɨsali nɨkanso. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Sʉnga wɨkaaɨla anyamɨlɨmo akwe, ‘Maɨntʉ ɨhi namʉwɨnga akonda, awa naza nɨanile azanimangɨɨe. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Itɨgwa, longoli mʉmapanda nɨkɨɨla antʉ ɨdʉ anɨɨli antʉ nɨanso aze mʉwɨnga. <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Anɨɨli nɨanso ɨkalongola mʉmapanda akɨsalɨ nɨɨkiila antʉ ɨdʉ, ɨkanɨɨla ɨantʉ ɨhi, nɨabi nawa nɨaza. Nyʉmba ɨkizʉla anyawɨnga.’<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />“Mʉtemi naʉkingɨla waagoze anyawɨnga, wɨkamʉona mʉntʉ ʉng'wɨ mʉgila itʉgalo nɨla wɨnga. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Mʉtemi wɨkamʉkolya, ‘mʉhʉmbamɨane, wingɨlaʉlɨ mʉwɨnga ʉwʉ kʉnʉ shanga utugae itugalo nɨlawɨnga?’ wɨkakilaga ihɨtwɨ. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />Sʉnga mʉtemi nʉwanso wɨkaaɨla anyamɨlɨmo akwe, ‘Mʉambi mʉtʉngi migʉlʉ ni mikono mʉgʉmi kʉnzi mʉkiti, kʉko ʉkʉlila nʉkʉkelya mino.”<verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />Yesʉ wɨkamaɨɨlya wɨkalʉnga itɨ, “Nɨanilwe ɨdʉ nɨanilwe, ingɨ nɨakʉholwa akeehʉ.”<verse eid="MAT 22:14" /></para>
  <para style="s">Yesʉ ʉkʉkoligwa mpola niya kʉpumya kodi</para>
  <para style="r">
    <ref loc="MRK 12:13-17">Maliko 12:13-17</ref>; <ref loc="LUK 20:20-26">Lʉka 20:20-26</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Sʉnga Apalisayo ɨkapuma kʉnzi, ɨkisɨja kɨna akʉmʉambisa ʉlɨ Yesʉ mʉnkani yakwe. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Ɨkaalagɨɨlya ahembaao palʉng'wɨ nɨa Helode. Alongole amʉkolye, “Mʉmanyisi, kʉlingɨle ʉewe wɨmʉhʉɨɨli ʉkʉmanyisa ɨtai likalo ni Itunda ʉloilwe, shanga ʉmogopile anga mʉntʉ wɨhi, kʉnsoko wɨkʉɨɨla anga mʉntʉ. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Alɨ, kʉtambʉile, ʉewe ʉkʉona ʉli? Itɨɨ ʉsese kʉtakɨwene kʉpʉmya ɨkodi kʉng'wa Kaɨsali?<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Ingɨ Yesʉ wɨkalinga ɨsuɨ lao, wɨkaaɨla, “Ʉnye ateele, nɨkɨ mʉkʉgema kʉmambisa? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Ndagɨɨli itʉndʉ nɨmɨpumɨlya ɨkodi,”</para>
  <para style="p" vid="MAT 22:19">Nienso ɨkamʉletela itʉndʉ lɨng'wɨ. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />Yesʉ nʉyo wɨkaakolya, ikelʉ nɨ lina ɨlɨ lang'wa nyenyʉ?”<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />Ikamʉila ikelʉ lang'wa Kaisali.</para>
  <para style="p" vid="MAT 22:21">Yesʉ wɨkaaɨla papo, “Nang'wa Kaɨsali<note caller="+" style="f"><char style="fr" closed="false">22:21 </char><char style="fq" closed="false">Kaɨsali </char><char style="ft" closed="false">Mʉtemi nʉwa kʉ Loma</char></note> mʉpii ʉ Kaɨsali, naya nang'wi Itunda mʉpii Itunda.”<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />Naɨija itɨɨ ɨkakʉɨlwa, ɨkamʉleka hapo, nɨanso ɨkalongola.<verse eid="MAT 22:22" /></para>
  <para style="s">Makolyo a wɨʉki</para>
  <para style="r">
    <ref loc="MRK 12:18-27">Maliko 12:18-27</ref>; <ref loc="LUK 20:27-40">Lʉka 20:27-40</ref></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Lʉhikʉ lʉlo lʉʉlo Asadukayo nɨshanga ahʉɨɨe kɨna antʉ nɨakʉle akiʉka, ɨkamʉhanga ʉ Yesʉ. <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />Ɨkamʉkolya ʉ Yesʉ, kɨna ʉ Mʉsa aɨʉkʉɨɨe itɨ, ʉmʉntʉ nʉkʉsha shanga ʉtugile ng'wana, isingilye ʉmʉlʉna wae ʉmʉsale mʉsʉngʉ nʉanso, wahʉme kʉmʉtʉgɨlya ɨana ʉmʉlʉna. <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Ʉʉgwa, apa pɨtaitʉ aɨakolɨ ahʉmba akɨluna mʉpʉngatɨ, Nʉang'wandyo wɨkatɨna mʉsʉngʉ sʉnga wɨkasha shanga ʉtugile anga ng'wana, ʉmʉsʉngʉ nʉwanso wɨkasalwa nʉmʉlʉna. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Ikani ɨlɨ lɨkamʉhanga nʉyʉ nʉwa kabɨɨli wɨkasha nʉyʉ nʉaka taatʉ, sʉnga ɨhi mʉpʉngatɨ. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Panyambele mʉsʉngʉ nʉanso wɨkasha. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Itɨɨ, lʉhikʉ nʉla kiʉkigwa mʉsʉngʉ nʉanso ʉzɨzatʉla wang'wa nyenyʉ? Kʉnsoko ɨhi aɨamʉtinile ɨhi mʉkɨluna kao.”<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Yesʉ wɨkaasʉkɨɨlya Asadukayo nɨanso, “Ʉnyenye mʉlimangɨɨe nakʉhita kʉlinga Inkani yang'wi Itunda ga ningʉlʉ yakwe. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Matungo nɨaziʉkigwa ɨashi shanga akʉtɨna ang'wɨ kʉtɨnwa; azetula anga ɨitʉmi akigʉlʉ nɨang'wi Itunda. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Ingɨ kiʉka kʉashi, itɨɨ, shanga mʉsomilene ayaitɨ Itunda naɨmʉtambʉie? kɨna, <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />‘Ʉnene ni Itunda wang'wa Ibulahimu, Itunda wang'wa Isaki, Itunda wang'wa Yakobo?’ Kʉlʉlo gwa, Itunda shanga waantʉ nɨakule, ingɨ Itunda nʉwa antʉ nɨapanga.”<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Iumbɨ nɨla antʉ ɨhi naɨija ʉʉmanyisi wakwe ɨkakʉɨlwa.<verse eid="MAT 22:33" /></para>
  <para style="s">Ilagɨɨlyo nikʉlʉ kʉkɨla ɨhi</para>
  <para style="r">
    <ref loc="MRK 12:28-34">Maliko 12:28-34</ref>; <ref loc="LUK 10:25-28">Lʉka 10:25-28</ref></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Apalisayo naɨja kɨna ʉ Yesʉ wɨkaalemya Asadukayo aʉlye nʉkakʉtambʉla, ɨkianɨɨla ɨkikiɨ ɨanza. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Mʉntʉ ʉng'wɨ naɨmʉlɨngi mʉ malagɨɨlyo ang'wa Musa wɨkamʉkolya ʉ Yesʉ wazemʉgema. <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“Mʉmanyisi,” itɨɨ mʉmalago, ilago niliʉli nikʉlʉ kʉkila ɨhi mʉ malagɨɨlyo?”<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />Yesʉ wɨkamʉsʉkɨɨlya, “‘Mʉlowe Itunda ako mʉ Ng'wahʉ ako wɨhi, nʉmʉnkolo ako ɨhi nʉmʉmahala ako ɨhi’. <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Ɨlɨ lɨlɨ ilago nikʉlʉ hangɨ nɨla ng'wandyo. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Ɨlɨ nɨlakabɨɨlɨ limpyani nɨlɨ nilanso, ‘Mʉlowe ʉmʉnyakisali nʉwako anga nʉiloilwe ʉewe’. <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Malago ɨhi nang'wa Mʉsa nʉʉmanyisi nʉwa amanga asanilye malago yaya na abɨɨlɨ.”<verse eid="MAT 22:40" /></para>
  <para style="s">Yesʉ ʉkʉakolya Apalisayo Kilisito nyenyʉ</para>
  <para style="r">
    <ref loc="MRK 12:35-37">Maliko 12:35-37</ref>; <ref loc="LUK 20:41-44">Lʉka 20:41-44</ref></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Apalisayo naɨkɨlɨ isʉmbilye palʉng'wɨ, Yesʉ wɨkaakolya, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />“Ʉnyenye mʉlɨngile ʉ Kilisito Mʉguni anga nyenyu? Itii, nʉanso ng'wana wang'wa nyenyʉ?” Ɨkamʉsʉkɨɨlya,</para>
  <para style="p" vid="MAT 22:42">“Ng'wana wang'wa Daudi.”<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />Yesʉ wɨkaaɨla, “Apa yatʉlɨkaʉli kʉngʉlʉ niya Ng'wahʉ Ng'welʉ ʉkʉmʉtonga ʉ Daudi kʉmitanga nʉanso Isekʉlʉ? Kʉnsoko aɨʉlʉngile:<verse eid="MAT 22:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="MAT 22:44" />‘Isekʉlʉ aɨʉmʉtambʉie Isekʉlʉ wane:</para>
  <para style="q" vid="MAT 22:44">Ikiɨ ipande lane nɨla ʉhumi</para>
  <para style="q" vid="MAT 22:44">kʉpikɨɨla nʉɨka ahuma ɨalʉgʉ ako.’<verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />Itɨgwa, Daudi ʉkʉmitanga ʉ Kilisito ‘Isekʉlʉ.’ ihumɨkile ʉlɨ watʉla ng'waakwe?”<verse eid="MAT 22:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46" />Antʉ ɨhi ɨkaleng'wa kʉmʉsʉkɨɨlya lʉkani lɨhi. Kʉpʉma lʉhikʉ lʉlo kʉtilɨ naʉgemile hangi kʉmʉkolya ikolyo lɨhi.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">Yesʉ ʉkʉakania amanyisi imalago nɨ Apalisayo</para>
  <para style="r">
    <ref loc="MRK 12:38-39">Maliko 12:38-39</ref>; <ref loc="LUK 11:43">Lʉka 11:43</ref>,<ref loc="LUK 11:46">46</ref>; <ref loc="LUK 20:45-46">20:45-46</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Sʉnga Yesʉ wɨkaaɨla iʉmbi lɨhi palʉng'wɨ nɨamanyisigwa akwe, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />‘Amanyisi amalagɨɨlyo nɨ Apalisayo akete ʉhumi kʉmʉtambʉila imalagɨɨlyo ang'wa Mʉsa. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Kʉlʉlo ambi aya nɨakʉmʉmanyisa nʉkitʉma kɨhi nimʉilwa. Shanga ɨtenda aya nɨakʉmʉɨla. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Itʉnga nʉkʉatɨka antʉ mɨligo nɨmɨlito nʉkʉatɨka mʉmaega, ingɨ nɨanso shanga ɨgema kʉkenka kʉmikonoao. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />“Nɨanso itʉma makani ɨhi ahʉme kʉkʉligwa nɨantʉ. Kitwe nʉ mʉmɨkono itugala matendele naandikile malagɨɨlyo nʉkipela maleza aʉsaningala nɨmalɨpu kʉkɨla antʉ ɨhi. <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Ɨlowa kikiɨ matʉntʉ akʉntongeela mʉmaloeelya mʉmatʉntʉ akʉntongeela mʉnyumba niya kʉtankanɨla ayahudi. <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />Ɨlowa kʉlamʉkigwa mʉʉgalagalo nʉkʉkʉligwa nʉkitangwa ‘Mʉmanyisi.’ <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />Ʉnyenye mʉleke kitangwa ‘Mʉmanyisi,’ kʉnsoko Mʉmanyisi wanyʉ ʉng'wɨ dʉ, ʉnyenye mɨhi mɨahemba ane. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Leka kʉmitanga mʉntʉ wɨhi mʉnʉ mihɨɨ ‘Tata’ kʉnsoko Tata wanyu ingɨ ʉng'wɨ du, yʉyʉ nʉa kigʉlʉ du. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Mʉleke kitangwa ‘Atongeeli,’ kʉnsoko mʉtongeeli wanyʉ ʉng'wɨ dʉ, nʉyo Kilisito. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Ʉyʉ nʉ mʉkʉlʉ mʉng'waanyu nʉwatule mʉtʉng'wa wanyu. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Wɨhi nʉkikʉlya ʉkʉninompigwa, nʉyʉ nʉkininompya ʉkʉkʉligwa.<verse eid="MAT 23:12" /></para>
  <para style="s">Yesʉ ʉkʉakania ateele</para>
  <para style="r">
    <ref loc="MRK 12:40">Maliko 12:40</ref>; <ref loc="LUK 11:39-42">Lʉka 11:39-42</ref>,<ref loc="LUK 11:44">44</ref>,<ref loc="LUK 11:52">52</ref>; <ref loc="LUK 20:47">20:47</ref></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />“Ʉkɨa wanyu amanyisi amalagɨɨlyo ang'wa Musa nɨ Apalisayo, mɨateele! Milʉgaɨla ʉmʉlango nʉwa kingɨɨlɨla mʉʉtemi wang'wi Itunda. Nawa nɨaloilwe kingɨla shanga mʉkʉaleka ingɨle. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />“Ʉkɨa wanyu amanyisi amalagɨɨlyo ang'wa Musa nɨ Apalisayo mɨateele! Mɨhola maintʉ aasʉngʉ nɨashɨɨwe nɨagoha, hangi mɨlompa malompi malipu. Kʉnsoko nanso ʉpisɨɨligwa wanyu ʉkʉtula ʉkʉlʉ.<verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />“Ʉkɨa wanyu amanyisi amalagiilyo ang'wa Mʉsa nɨ Apalisayo, nɨmɨateele! Miʉmbaʉmba mʉlʉzi nʉlʉkʉlʉ nʉkiʉmbaʉmba mihɨɨ mʉzeduma mʉntʉ nʉkʉtyata aya nɨmʉhʉɨɨe ʉnyenye. Anga mʉmʉlije, mɨkamʉtenda wɨngɨle kʉʉlʉngʉ nʉ moto shawɨlima nkʉa akabɨɨlɨ kʉkila ʉnyenye.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />“Ʉkɨa wanyʉ atongeeli mɨapokʉ! Ʉnye nimilʉnga ʉmʉntʉ anga walapile kʉ Nyʉmba ang'wi Itunda, ilapo lakwe shanga kɨntʉ; itɨgwa anga walape kʉ zahabu nɨpumigwe kʉ nyʉmba ang'wi Itunda, ilapo nɨlanso lɨkʉmʉpɨsɨɨlya. <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Ʉnyenye apʉngʉ hangɨ mɨapokʉ! Nɨkɨʉlɨ nikikʉlʉ nangalʉ. Zahabune ang'wɨ nyʉmba ang'wi Itunda nimatendya zahabu kʉtʉla nziza? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Hangɨ mɨlʉnga mʉntʉ anga wilapɨle kitekeelo shanga kɨntʉ; ilagwa anga walapɨle kipegwa nɨkɨɨkilwe mitekeelo, ilapo nɨlanso lɨkʉmʉpɨsɨɨlya. <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Ʉnyenye apokʉ! Kɨntʉ kɨɨ nɨkɨkʉlʉ ikɨlo: Kipegwa nɨkansone, ang'wɨ itekeelo nɨkɨkɨtenda ɨkɨpegwa nɨkanso kitʉle kɨza? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Ʉyʉ nʉilapɨla itekeelo nʉkilapila kitekeelo nʉ kʉmaɨntʉ ɨhi naletilwe mitekeelo nɨlanso. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Nʉyʉ nʉkilapile kʉ nyʉmba ang'wi Itunda ʉlapile kʉnyʉmba yɨyo nʉ kʉng'wi Itunda nʉwishiɨ mʉnyʉmba nanso. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Nʉyʉ nʉkʉlapa kigʉlʉ ʉlapile kituntu nɨla ʉhumi nɨlang'wi Itunda, nʉyʉ nʉwikaɨe itʉntʉ nɨlanso.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />Ʉkɨa wanyu amanyisi amalagiilyo ang'wa Musa nɨ Apalisayo, mɨateele! Kʉnsoko mɨpumye ɨkɨkʉmi kamaintʉ ansaɨlo niino anga ɨnseke nɨya nyenyi nɨ bizali ni jila, Ingɨ mɨhita kʉtenda makani nalagɨɨgwe mumalagiilyo, kʉtenda aya namʉloeeye Itunda, kʉaisɨɨlya ɨantʉ nʉkʉtula mɨahʉɨɨli, kʉtula nʉʉhʉɨɨli kʉng'wi Itunda. Nɨitɨga aya yaya lʉkʉlʉ mʉtakɨwe mʉkʉkamɨnkɨɨlya mʉleke kɨwa aya nɨmangɨɨza. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Atongeeli nɨapokʉ! minimʉla ngi mʉgaɨ yanyu, ingɨ mɨmɨla ingamɨa!<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />“Ʉkɨa wanyu amanyisi amalagiilyo ang'wa Mʉsa nɨ Apalisayo, mɨateele! Mʉgʉʉlya ikombe nɨ mabakuli kʉnzi, ingɨ mʉkatɨ mʉilekile yizʉe maɨntʉ nimʉligilye kʉ wii nʉʉbɨ nʉwa nkolo. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Ʉewe Palisayo nɨmʉpoku! Ʉgʉʉlye hanza ɨkikombe mʉkati nʉkʉnzi ga kikʉtʉla kelʉ.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />Ʉkɨa wanyu amanyisi amalagiilyo ang'wa Mʉsa nɨ Apalisayo, mɨateele! Mihangaanga ibɨɨla niiʉgɨigwe nswakaala kʉgoza kʉzi iza, ingɨ mʉkati yizʉe makʉpa amiimba nɨ makani aʉolu. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Nʉnyenye ga kʉmiho aantʉ migela mɨakende, mʉnkolo ingɨ mizʉe ʉteele nʉbi.<verse eid="MAT 23:28" /></para>
  <para style="s">Ʉpɨsɨɨlya nʉʉpembilye</para>
  <para style="r">
    <ref loc="LUK 11:47-51">Lʉka 11:47-51</ref></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />Ʉkɨa wanyu amanyisi amalagiilyo ang'wa Mʉsa nɨ Apalisayo, mɨateele! Mʉkʉzenga ibiila niya amanga ang'wi Itunda nʉkʉnoneelya ibɨɨla niya antʉ nɨakende yigeeleke iza. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Mɨlʉnga, ‘Angaɨze ʉsese aɨze kʉkoli matʉngo aanyakalɨ shanga aɨkʉziiaɨɨlya kʉabʉlaga amanga ang'wi Itunda!’ <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Kʉɨtɨ mʉkʉkomanɨɨlya ʉnyenye kɨna mɨana aatʉ naɨ aabʉlagile amanga. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Ali kondeelyi ʉmʉlimo nʉwa anyakalɨ anyʉ aɨandilye! <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />Ʉnyenye mɨwileli nʉwa nzoka, Mʉhumile ʉlɨ kʉhʉga ʉpɨsɨɨlya nʉwa moto nʉwa mahikʉ ɨhi nɨshanga wɨlima? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Yɨyo nsoko ʉnene nɨmʉletela ʉnyenye amanga, antʉ nɨakete mahala nɨamanyisi; ʉnyenye mʉkʉabʉlagɨla mʉmʉsalaba, mʉkʉakʉa nkotya munyumba niya kutankanɨla ayahudi, nɨang'wɨ mʉkʉadagɨɨlya kɨsalɨ nɨ kɨsalɨ. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Kʉɨtɨ ʉnyenye mʉkʉtula nigazo nɨla anyampala naɨabʉlagile antʉ nɨaza mʉnʉ mihɨɨ. Ee, kʉpʉma naɨʉbʉlagilwe ʉ Abeli nɨshanga aɨʉgazilye, kʉpikɨɨla naɨ amʉbʉlagɨe ʉ Zakalia, ng'wana wang'wa Balakia, panyʉmba ang'wi Itunda pakatɨ itekeelo nɨ payelʉ. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Kʉmʉtambʉɨla ɨtai, ʉwileli ʉwʉ ʉkʉpɨsɨɨligwa kʉnsoko amakani yaya.<verse eid="MAT 23:36" /></para>
  <para style="s">Yesʉ ʉkʉkɨlɨɨla kɨsalɨ kakʉ Yelusalemu</para>
  <para style="r">
    <ref loc="LUK 13:34">Lʉka 13:34</ref>,<ref loc="LUK 13:35">35</ref></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />“Yelusalemu! Ʉewe Yelusalemu! Nʉwɨabʉlaga amanga ang'wi Itunda nʉ kʉakʉa magwe awa nɨalagɨigwe kʉng'wako. Nkʉa inga nɨngemile kilingɨɨla ɨana ako kʉng'wane anga nkʉkʉ nisʉnja ɨana akwe mʉmanana, ingɨ ʉhitile. <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Alɨgwa, nyʉmba ako ɨkʉsaga ikʉmʉʉlʉ. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Kʉʉɨla, kandɨɨlya ino shanga ʉkʉmona hangɨ kʉpikɨɨla itʉngo nʉɨkalʉnga, ‘Wakembetwe ʉyo nʉpembilye kʉlina lang'wi Isekʉlʉ.’”<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">Yesʉ ʉkʉtambʉla kʉgazɨka kʉ Nyʉmba ang'wi Itunda</para>
  <para style="r">
    <ref loc="MRK 13:1">Maliko 13:1</ref>,<ref loc="MRK 13:2">2</ref>; <ref loc="LUK 21:5">Lʉka 21:5</ref>,<ref loc="LUK 21:6">6</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Yesʉ wɨkapʉma pa Nyʉmba ang'wi Itunda, naɨʉkʉgenda, amanyisigwa akwe ɨkamʉhanga ɨkatulitambʉɨla makani a Nyʉmba ang'wi Itunda. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Yesʉ wɨkaaɨla, “Ʉzaʉ, mʉhʉmile kʉmagoza ayaitɨ ɨhi! Kʉmʉila taɨ, kʉtilɨ igwe nɨlʉkʉsaga migwe lʉlya; intʉ yɨhi yɨkʉgazangigwa.”<verse eid="MAT 24:2" /></para>
  <para style="s">Lwago nʉ wagigwa</para>
  <para style="r">
    <ref loc="MRK 13:3-13">Maliko 13:3-13</ref>; <ref loc="LUK 21:7-19">Lʉka 21:7-19</ref></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Yesʉ naɨwɨkiɨ mʉlʉgʉlʉ nʉla Mɨzeɨtʉni, amanyisigwa akwe ɨkamʉhanga kɨmpelo itambʉlye, ɨkamʉkolya, “Kʉtambʉɨle makani aya akʉpʉmɨla nalɨ? Nikɨlɨngasɨɨlyo nɨkakʉonela itʉngo lakʉtʉlya kʉng'wako nʉ lʉhikʉ lampelo.”<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />Yesʉ wɨkaasʉkɨɨlya, “Hʉgʉki mʉleke kʉkongwa nʉ mʉntʉ. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Kʉnsoko azile antʉ ɨdʉ azelʉnga ʉnene nɨ Kilisito, antʉ nɨanso akʉalimɨlya antʉ ɨdʉ. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Mʉkija makani a mbita ning'ung'u nɨla mbita, ingɨ mʉleke kʉhʉsha, kʉnsoko nanso atakɨwe kʉpʉmɨla. Ingɨ ɨmpelo ɨkɨlɨ. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Antʉ ihɨɨ ɨng'wɨ akikʉa nɨantʉ ihɨɨ nzʉya; antʉ a ʉtemi akʉtʉlikʉa nɨantʉ a ʉtemi ʉya. Izala lɨkʉpumɨla nɨ mɨtentemo ihɨɨ ɨkʉpumɨla matʉmbɨ nɨ matʉmbɨ. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Nanso ɨhi ingɨ anga ng'wandyo nʉwa ʉwaɨ nʉwakipepalya ng'wana.<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />“Sʉnga akʉmʉamba nʉkʉmaja ang'wɨanyu akʉbʉlagwa. Antʉ ɨhi akʉmʉbɨpɨlwa kʉnsoko mʉnihʉɨɨe nene. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Matungo nɨlanso antʉ idʉ nɨanihʉɨɨe akʉleka kʉnihʉɨɨla, akipɨlʉka nʉkibɨpɨlwa. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Akigela amanga ɨdʉ nɨaʉteele nawo akʉalimɨɨlya antʉ idʉ. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Kʉnsoko akongeeleka ʉpɨlʉki, ʉlowa nʉwa antʉ idʉ ʉkʉkepa. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Ingɨ kʉ mʉntʉ wɨhi nʉkʉgigimɨɨlya kʉpikɨɨla lʉhikʉ nʉlampelo yʉyo ʉkʉponyigwa. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Igɨ impelo nɨkɨlɨ kʉpikɨɨla, Nkani Nza niya ʉtemi wang'wi Itunda yɨkʉtanantigwa mʉ ʉnkʉmbigʉlʉ wɨhi ingɨ antʉ ɨhi ije.<verse eid="MAT 24:14" /></para>
  <para style="s">Mahikʉ a lwago nʉ lʉkʉlʉ</para>
  <para style="r">
    <ref loc="MRK 13:14-23">Maliko 13:14-23</ref>; <ref loc="LUK 21:20-24">Lʉka 21:20-24</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />“Itɨ gwa, anga maona ‘Kɨntʉ nɨ kɨbɨ nɨkɨleta ʉgazangigwa nɨkɨtambʉwe nʉ mʉmanga ʉ Danieli kimɨkile mʉnyʉmba, mʉntʉ nʉkʉsoma nʉwalɨnge ɨndogoelyo akwe, <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />papo gwa, antʉ nɨishiɨ mihɨɨ a kʉ Yʉda amankɨɨle mʉmalʉgʉlʉ. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />Mʉntʉ nʉkolɨ mitembe nʉwaleke kʉsima kʉhola kɨntʉ kɨhi mʉnyʉmba akwe. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />Ʉyu nʉkolɨ kʉmʉgʉnda nʉwaleke kʉsʉkila matʉgalo kitolakwe. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Akutula nʉ lwago asʉngʉ nɨalito nawa nɨakonsha mahikʉ niyanso! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Lompi ʉlʉmanko lanyʉ lʉleke kʉtʉla lʉhikʉ nʉla mpepo ang'wɨ Lʉhikʉ nʉla Kʉsʉpya! <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Kʉnsoko matʉngo nanso akʉtʉla alwago lʉkʉlʉ nɨɨza lʉkɨlɨ kigela pʉma ʉtundwi nʉwa ʉnkʉmbigʉlʉ kʉpikɨɨla lelo, kʉnsoko lwago nʉlanso shanga ɨzepumɨla hangɨ. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Itunda anga aɨwaleke kukepya mahikʉ nanso, kʉtilɨ anga ng'waa mʉntʉ wɨhi naʉzehuma kʉgunɨka; ingɨ gwa kʉnsoko aantʉ nɨahoilwe mahikʉ nanso akʉkepigwa.<verse eid="MAT 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />“Itɨ gwa, mahikʉ nanso mʉntʉ anga wamʉile; Kilisito ʉkolɨ apa, ang'wɨ ‘Ʉkolɨ apo,’ mʉleke kʉhʉɨɨla. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Kʉnsoko akigela amanga aʉteele niantʉ idʉ nɨakʉtula lʉnga ʉnene nɨ kilisito. Akʉtenda mɨʉkʉɨlwa mɨkʉlʉ nɨkʉhʉma kʉalimɨlya antʉ ihʉmikile ga nawa nɨasagʉwe ni Itunda. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Tegeelyi, nakondya kʉmʉhʉgʉla makani nakɨlɨ kʉpika.<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />Itɨgwa, anga amʉɨle gozi ʉkolɨ kijangwa,’ mʉleke kʉlongola kʉng'wanso; ang'wɨ, ‘Gozi, ʉkilisito wɨpɨhile mʉkati,’ mʉleke kʉhʉiila; <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />kʉnsoko, anga ʉlʉpito nʉlipita kʉpʉma kʉ kilya nʉkigeeleka kʉ ng'weli, ʉʉ yɨkatʉla lʉhikʉ nʉlakɨza ʉ Ng'waa Mʉntʉ.<verse eid="MAT 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 24:28" />Pa mʉimba ʉkolɨ, papo indɨ yilingɨɨla.<verse eid="MAT 24:28" /></para>
  <para style="s">Kʉza kʉ Ng'waa Mʉntʉ</para>
  <para style="r">
    <ref loc="MRK 13:24-27">Maliko 13:24-27</ref>; <ref loc="LUK 21:25-28">Lʉka 21:25-28</ref></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />“Anga lʉkɨle ʉlwago nʉlanso, lyoa lɨkʉlima nʉ ng'weli shanga ʉkelya ni nzota yɨkʉtʉngʉka kʉpuma kilunde, ningulu niya kigʉlʉ yɨkʉhingiɨka. <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />Sʉnga, ikilingasiilyo ka Ng'waa Mʉntʉ kɨkigela migʉlya, papo ndʉgʉ yɨhi mihɨɨ izemʉnang'anɨkɨla; akʉmʉona ʉ Ng'waa Mʉntʉ ʉpembilye migʉlya amalʉnde nikʉlyo. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Nʉyo ʉkʉalagɨɨlya amalɨka nao azekʉa ipembeguma, nɨanso aze ilingɨɨla antʉ nɨahoilwe kʉpʉmiila mpande yɨhi nɨ yihɨɨ, kʉpʉma mpelo ɨyɨ nigʉlʉ nɨmpelo ngɨɨza nigʉlʉ.<verse eid="MAT 24:31" /></para>
  <para style="s">Mpyani a mʉkʉyʉ</para>
  <para style="r">
    <ref loc="MRK 13:28-31">Maliko 13:28-31</ref>; <ref loc="LUK 21:29-33">Lʉka 21:29-33</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />Imanyisi kʉ mpyani a mʉkʉyʉ. Anga mʉone ʉdu matʉtʉ akwe andya kʉtegeta, mɨlɨnga kɨna malɨma ahʉmbeela. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Nʉnyenye ga anga mʉone makani aya ɨhi akitʉng'wa, lɨngi kɨna matungo akʉpembya ʉ Ng'waa Mʉntʉ ahumbeela. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Kʉmʉtambʉɨla ɨtai ʉwileli ʉwʉ shanga ʉkʉkɨla makani aya apʉmile. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Igʉlʉ ni ihɨɨ yʉkʉkɨla, ingɨ itʉnʉ nkani yane shanga ikʉkɨla.<verse eid="MAT 24:35" /></para>
  <para style="s">Kʉtilɨ mʉntʉ nʉlɨngile kʉtulya kʉ Ng'waa Mʉntʉ</para>
  <para style="r">
    <ref loc="MRK 13:32-37">Maliko 13:32-37</ref>; <ref loc="LUK 17:26-30">Lʉka 17:26-30</ref>,<ref loc="LUK 17:34-36">34-36</ref></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />“Ingɨ, itʉngo nɨlanso ang'wɨ lʉhikʉ nʉlanso, kʉtilɨ mʉntʉ nʉlingɨle lʉkʉpɨka nali; a malaɨka ang'wɨ Ng'waa Mʉntʉ; ingɨ Tata dʉ wɨng'wene ʉlɨngile. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Kʉnsoko anga naɨitʉile mahikʉ ang'wa Nʉhʉ, ʉʉ izetʉla kiza kʉ Ng'waa Mʉntʉ. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Kʉnsoko mahikʉ nanso, kɨhʉmo kikʉlʉ aɨkɨkɨlɨ, antʉ aɨalongolekile kʉlya nʉkʉng'wa, ɨkazetina nʉkʉtinwa, kʉpikɨɨla nʉ Nʉhʉ naɨʉkingɨla mibɨnɨ ikʉlʉ nɨlitangwa sapina. <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />Antʉ shanga aɨalɨngile ntʉni kikʉpʉmɨla. Mbula ɨkakʉa matungo malɨpu, antʉ ɨkasha kʉ kihʉmo ka mazɨ. Itɨʉʉ izeetʉla itʉngo nʉʉzɨzɨza ʉ Ng'waa Mʉntʉ. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Matʉngo nanso antʉ abɨɨlɨ akʉtula akolɨ kʉ mʉgʉnda; mʉntʉ ʉng'wɨ ʉkʉholwa ʉng'wɨ ʉkʉlekwe. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Asʉngʉ abɨɨlɨ azesia na lwala palʉng'wɨ ʉng'wɨ ʉkʉholwa ʉmʉya ʉkʉlekwe.<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />Itɨ gwa, ihambi, kʉnsoko shanga mʉlɨngile lʉhikʉ kɨɨ nʉzile Isekʉlʉ wanyʉ. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Kɨmbʉki gwa ikani ɨlɨ. Mʉkola nyʉmba anga ɨze ʉlɨngile lʉhikʉ nʉ mii ʉzile, shanga ʉkʉlala, shanga ʉkʉleka nyʉmba akwe ɨkumʉlwe. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Kʉlʉlo, nʉnyenye ga hʉgʉki, kʉnsoko Ng'waa Mʉntʉ ʉzile matungo nɨshanga mʉsɨgɨɨe.”<verse eid="MAT 24:44" /></para>
  <para style="s">Mitʉmi nʉhʉɨɨwe nʉyʉ nɨshanga ʉhʉɨɨwe</para>
  <para style="r">
    <ref loc="LUK 12:41-48">Lʉka 12:41-48</ref></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />Yesʉ wɨkalongeleka kʉlʉnga, nyenyʉgwa nʉkete mitʉmi nʉmʉhʉɨɨe hangi nʉkete mahala, Mʉkʉlʉ wakwe nʉhumile kʉmʉɨka wɨmɨɨle antʉ akwe, azeapa ɨantʉ ndya kʉ matungo nɨmaza? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Mitʉmi nʉanso ʉkiloa anga mʉkʉlʉ wakwe wahange ʉkʉtenda iti. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Kʉmʉtambʉila taɨ, ʉzemʉɨka ʉmitʉmi nʉanso mɨmɨɨli nʉwa nsao yakwe yɨhi. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Ingɨ mitʉmi ʉyʉ anga watule mʉbɨ ʉkitambʉila mʉnkolo akwe: Mʉkʉlʉ wane watinya kʉsʉka,’ <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />sʉnga wandye kʉakʉa itʉmi aʉya, wandye kʉlya nʉkʉng'wa palʉng'wɨ nɨagala ntʉlɨ, <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />sʉnga mʉkʉlʉ wakwe ʉzile lʉhikʉ nɨshanga ʉsɨgɨɨe nitʉngo nɨshanga ʉine. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Ʉkʉmʉpɨsɨɨlya ibɨ, nʉkʉmʉɨka palʉng'wɨ nɨateele. Kʉng'wanso kʉko yɨkʉtula kɨlɨlo nʉkʉkelya mino.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">Mpyani a ananso ikʉmi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />Yesʉ wɨkalongoleka kʉtambʉla, “Matʉngo nanso, ʉtemi nʉa kigʉlʉ ʉkimpyanigwa nɨananso ikʉmi naɨahoile koloboi niyao, ɨkalongola kʉmʉsɨngɨɨlya mʉtɨzɨɨli nʉwa kɨgoha. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Ataano mʉananso awa nikʉmi aɨapʉngʉ nɨaʉya ataano aɨakete mahala. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Ananso awa nɨapʉngʉ aɨahoile koloboi niyao, ingɨ shanga ɨkikenkeelya ɨmbago a makʉta. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Ingɨ gwa ananso awa naɨakete mahala ɨkakɨtɨla makʉta mʉnsʉpa niyao palʉng'wɨ koloboi niyao. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Kʉnsoko mʉtɨzɨɨla naɨwatinia kʉpika, ananso nɨanso ɨkatʉla tindila, ɨkalala tʉlo.<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />Ʉtikʉ wɨgengʉ mʉntʉ wɨkitʉnta: ‘Aligwa, ʉki! Mʉtɨzɨɨla wapembya, pumi kende mʉsɨngɨɨlya.’ <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />Papo ananso nɨanso ɨhi ɨkaʉka, ɨkatula pyagʉla makili mʉʉtambɨ niwa koloboi yao. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Ananso awa nɨapʉngʉ ɨkaaɨla ɨaʉya nɨakete mahala: ‘Kʉguni makʉta makeehʉ kʉnsoko koloboi yitʉ yainalima,’ <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />Ingɨgwa awa naɨakete mahala ɨkaaɨla, ‘Makʉta aya makeehʉ shanga kʉhʉma kelya mʉkoloboi yitʉ niziniyanyʉ! Bahʉ ʉnyenye mende mʉgʉle nanyu kʉkigʉila!’ <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />Itɨ gwa, ananso awa naɨ apʉngʉ ɨkalongola kʉgʉla makʉta, mʉtizɨɨla wɨkapikɨɨla. Ananso awa naɨihambile ɨkingɨlania nʉ mʉtɨzɨɨla mizʉmba nɨlawɨnga. Sʉnga mʉlango wɨkalugaɨlwa.<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />Panyambele ananso nɨapʉngʉ naɨendilegʉla makʉta ɨkaza, ɨkapika nʉkʉpɨndʉla; Mʉkʉlʉ, Mʉkʉlʉ, kʉlʉgʉɨle!’ <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />Mʉkʉlʉ nʉyo wɨkaasʉkɨɨlya, ‘Kʉmʉila ɨtai, ʉnyenye shanga nʉmʉlɨngile.’’’<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />Sʉnga Yesʉ wɨkamalɨnkɨɨlya wɨkalʉnga, “Hʉgʉki gwa, kʉnsoko shanga mʉlɨngile lʉhikʉ ang'wɨ itʉngo.<verse eid="MAT 25:13" /></para>
  <para style="s">Mpyani aitʉmi ataatʉ</para>
  <para style="r">
    <ref loc="LUK 19:11-27">Lʉka 19:11-27</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />“Itʉngo nɨlanso izetʉla anga mʉntʉ naʉloilwe kʉlongola mʉhɨnzo nʉakʉgela nikʉli. Wɨkaitanga itʉmi akwe, wɨkailiha insao yakwe. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Wɨkaapa antʉ ɨhi anga ʉhumi wakwe: Ʉng'wɨ wɨkapegwa pyana mbogoshi nɨpya zahabu pitaano, ʉmʉya pyana mbogoshi nɨpya zahabu pibɨɨlɨ nʉ mʉya wɨkapegwa kana mbogoshi kazahabu kang'wɨ, sʉnga mʉkʉlʉ wɨkenda mʉhɨnzo. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Itungo ʉdu mitʉmi ʉyʉ naɨʉpewe pyana mbogoshi pitaano wɨkatʉgisa pyana mbogoshi nipiʉya pitaano. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Nʉ mitʉmi ʉyʉ ga naʉpewe pyana mbogoshi pibɨɨlɨ wikatugisa nipiʉya pibɨɨlɨ. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Ingɨ gwa mitʉmi ʉyʉ naʉpewe kambogoshi kang'wɨ wɨkalongola, wɨkahɨmba ikombo pihɨɨ, wɨkapiha kambogoshi ka mʉkʉlʉ wakwe, wɨkatuhɨɨla ikombo nɨlanso.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />“Naɨlakɨla itʉngo ilɨpʉ, mʉkʉlʉ nʉanso wɨkatʉlya, wɨkalowa kʉlɨnga nsao yakwe. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Mitʉmi ʉyʉ naɨʉpewe pyana mbogoshi pitaano wɨkaleta nipiʉya pyana mbogoshi pitaano nʉtugisilye, wɨkamʉɨla, ‘mʉkʉlʉ, azaʉmpee pyana mbogoshi pitaano sipi pyana mbogoshi nipiʉya pitaano nintugisilye.’ <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />Mʉkʉlʉ wakwe wɨkamʉɨla ‘Watenda iza, wɨmitʉmi nʉmʉza hangɨ nʉmʉhʉɨɨli. Watʉla ʉkete ʉhʉɨɨli kʉmakani nɨ maniino, kʉʉpa nɨmaʉya makani nɨmakʉlʉ. Nzʉʉ wingɨle wɨloeelye palʉng'wɨ nʉmʉkʉlʉ wako.’<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />Sʉnga mitʉmi naʉpewe pyana mbogoshi pibɨɨlɨɨ nɨpya zahabu wɨkaza, wɨkapʉmya pyana mbogoshi nipiʉya pibɨɨlɨɨ nʉtugisilye, wɨkalʉnga, ‘Mʉkʉlʉ, aɨʉmpee pyana mbogoshi pibɨɨlɨ. Hola nɨpyana mbogoshi piʉya pibɨɨlɨ nɨntugisilye.’ <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />Mʉkʉlʉ wakwe wɨkamʉɨla ‘ʉza, wɨmitʉmi nʉmʉza hangɨ nʉmʉhʉɨɨli. Watʉla ʉkete ʉhʉɨɨli kʉmakani nɨ maniino, kʉʉpa makani nɨmakʉlʉ. Nzʉʉ wingɨle wɨloeelye palʉng'wɨ nʉ mʉkʉlʉ wako.’<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />Ingɨ gwa wɨkapembya nʉyʉ naʉpewe kana mbogoshi kang'wɨ, wɨkalʉnga, ‘Mʉkʉlʉ nɨngile kɨna ʉewe wɨmʉntʉ nʉmʉkakʉ; ʉewe wɨogola pashanga ʉtemee, nʉkilingɨila pashanga ʉsapatɨɨye. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Ainogopile, nɨkapiha ɨkana mbogoshi kako mʉmahalʉ. Hola ɨkabogoshi kako.’<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />“‘Mʉkʉlʉ wakwe wɨkamʉɨla, ‘Ʉewe wɨmitʉmi nʉ mʉbɨ hangi wɨmʉkata! Ʉlɨngile kɨna ʉnene nɨogola pashanga ntemee, nʉkilingɨɨla pashanga nsapatɨɨye? <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Yatula ʉlɨ wahita kʉtwala kana mbogoshi kane kʉasʉlʉja, ʉnene aza nzepegwa kana mbogoshi kane nɨyɨ nɨtugisigwe! <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />Itɨ gwa, mʉhegelyi kana mbogoshi nɨkanso mʉmʉpe ʉyʉ nʉwa pibogoshi pitaano. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Kʉnsoko, mʉntʉ ʉyʉ nʉkitʉmɨla mʉlɨmo kɨntʉ nɨnʉmʉpee kʉmongeelya kɨntʉ kɨʉya, ʉkʉtula ʉkete yɨdʉ. Ingɨ mʉntʉ wɨhi nɨshanga ʉkitʉmɨla kɨntʉ nɨkɨniino nɨnʉmʉpee, kʉmʉhegelya nɨkɨ ga nɨkɨniino nʉkete. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Nʉ mʉntʉ nɨshanga ʉtugisilye, mʉgʉmi kʉnzi mʉkiti! Kʉng'wanso ʉkʉtʉla nɨkɨlɨlo nʉkʉkelya mino.’<verse eid="MAT 25:30" /></para>
  <para style="s">Ʉlamʉlwi nʉwa mpelo</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />Itʉngo nʉzile ʉ Ng'waa Mʉntʉ anga mʉkʉlʉ palʉng'wɨ nɨa malaɨka ɨhi, papo ʉziikiɨ mituntu lakwe nɨla ʉhumi waze Mʉtemi. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Antʉ ɨhi aziilingɨɨla pantongeela akwe, nʉyo ʉzeakomatʉla anga mʉdɨmi nʉɨkomatʉɨla nkolo ni mbʉli. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Nkolo ʉkʉiɨka mʉkono nʉwa kigoha ni mbʉli ʉkʉiɨka mʉkono nʉwa nkɨgɨ. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />“Sʉnga Mʉtemi ʉkʉaɨla awa nɨakolɨ mʉkono nʉwa kɨgoha, ‘Kɨlanyi ʉnyenye nimʉkembetilwe nʉ Tata wane; holi ʉʉtemi naɨ ʉnoneeigwe kʉnsoko anyu kʉpuma ʉtundwi nʉwa ʉnkumbigʉlʉ. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Kʉnsoko aɨnihʉmilwe nzala ʉnyenye mɨkampa indya; aɨhʉmilwe nyota ʉnyenye mɨkampa ɨmazi; aɨnimʉzɨɨla ʉnyenye mɨkansɨngɨɨlya, <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />aɨnɨkɨpwɨ, mɨkantʉnga myenda; aɨnimʉlwae ʉnyenye mɨkansolya; aɨnkolɨ mʉkɨtʉngo ʉnyenye mɨkɨza kʉnamʉsha.’<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />Papo, antʉ awa nɨaza azee mʉsʉkɨɨlya ʉ mʉtemi ‘Mʉkʉlʉ, nalɨ naɨkʉkʉine ʉhʉmilwe nzala ʉsese kɨkakʉpa indya, ang'wɨ ʉhʉmilwe nyota ʉsese kɨkakʉng'wensa mazi? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Nalɨ naɨkʉkʉine wɨmʉzɨɨla ʉsese kɨkakʉsɨngɨɨlya. ang'wɨ wɨkipwɨ ʉsese kɨkakʉtunga myenda? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Hangɨ nalɨ naɨkʉkʉine wɨmʉlwae ʉsese kɨkakʉsolya, ang'wɨ ʉkolɨ mʉkitʉngo ʉsese kɨkɨza kʉʉlamʉsha? <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />Mʉtemi ʉkʉasʉkɨɨlya, ‘Kʉmʉtambʉila ɨtai, kɨntʉ kɨhi naɨmʉmʉtendee ʉng'wɨao mʉanyandʉgʉ ane nɨaʉla, aɨmʉntendee nene.’<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />“Sʉnga ʉkʉaɨla awa nɨamoli mʉkono nʉwa nkɨgɨ, ‘Hegi pang'wane ʉnyenye nɨmazumilwe! Longoli mʉmoto nɨshanga wɨlima nʉwa kalɨ na kalɨ naɨʉɨkɨigwe ʉ shetani. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Kʉnsoko aɨnihʉmilwe nzala ʉnyenye shanga mɨkampa indya; aɨnihumilwe nyota ʉnyenye shanga mɨkampa ɨmazɨ. <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Aɨnɨmʉzɨɨla ʉnyenye shanga mɨkansɨngɨɨlya; aɨnɨmʉlwae ʉnyenye shanga mɨlansolya aɨnkolɨ nɨmʉtʉngwa ʉnyenye shanga mɨkɨza kʉnamʉsha.’<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />Papo nawo akʉmʉsʉkɨɨlya, ‘Mʉkʉlʉ nalɨ naɨkʉkʉine ʉhʉmilwe nzala ang'wɨ nyota, ang'wɨ wɨmʉziila ang'wɨ nawɨmʉgila matʉgalo, ang'wɨ wɨmʉlwae ang'wɨ ʉkolɨ mʉkitʉngo ʉsese kɨkahita kʉaɨɨlya? <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />Nʉyo ʉkʉasʉkɨɨlya, ‘Kʉmʉila ɨtai, makani ɨhi naɨmʉmʉtendee ʉng'wɨao mʉaʉla awa, aɨmʉnɨhitile nene.’ <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />Itɨ gwa, antʉ awa nɨabɨ akʉlongola mʉlwago mʉla kalɨ na kalɨ, antʉ awa nɨahʉɨɨli akʉlongola kʉ ʉpanga nʉwa kalɨ na kalɨ.’’<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">Masɨgo akʉmʉbʉlaga ʉ Yesʉ</para>
  <para style="r">
    <ref loc="MRK 14:1">Maliko 14:1</ref>,<ref loc="MRK 14:2">2</ref>; <ref loc="LUK 22:1">Lʉka 22:1</ref>,<ref loc="LUK 22:2">2</ref>; <ref loc="JHN 11:45-53">Yohana 11:45-53</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Yesʉ naɨwakondya kʉtambʉla nkani yɨhi, wɨkaaɨla amanyisigwa akwe, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />“Mʉlɨngile kɨna asiga mahikʉ abɨɨlɨ itule iloeelye nɨla pasaka, Ng'waa Mʉntʉ nʉyo ʉkʉkononteelwa mʉ mʉsalaba.”<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Itungo nɨlanso Apolyi nɨakʉlʉ nɨatongeeli aayahudi ɨkaɨka ianza mizʉmba lang'wa Kayapwa, mʉpolya nʉ mʉkʉlʉ. <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />Ɨkisɨja akʉmʉamba ʉli ʉ Yesʉ kisuɨ amʉbʉlage. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Ingɨ ɨkigombasɨɨlya ɨkani ɨlɨ lɨleke kitung'wa mʉ mahikʉ iloeelya nɨla pasaka, antʉ aleke kʉleta minyomo.<verse eid="MAT 26:5" /></para>
  <para style="s">Yesʉ ʉkʉdubunkɨligwa makʉta kʉ Betanɨa</para>
  <para style="r">
    <ref loc="MRK 14:3-9">Maliko 14:3-9</ref>; <ref loc="JHN 12:1-8">Yohana 12:1-8</ref></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Yesʉ naʉmolɨ kʉ Betania, mʉnyʉmba ang'wa Simoni, naɨ mʉnyambili, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />mʉsʉngʉ ʉng'wɨ nsʉpa a nɨnonigwe nigwe nɨlitangwa alabasita ɨkete makʉta aɨgʉlwɨ nʉwa mpɨa yɨdʉ, wɨkamʉdumbʉnkɨlya imakʉta nanso mitwe. <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />Amanyisigwa akwe naɨaona iti ɨkataka, ɨkalʉnga, “Ʉpʉngʉ wantʉni ʉwʉ? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Makʉta aya azahʉmile kʉgʉligwa mpia yidʉ, apegwe ahimbɨ impɨa niyanso.”<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Yesʉ wɨkalinga mʉakʉsɨga, wɨkaaɨla, “Niki mʉkʉmʉnyoma ʉmʉsʉngʉ ʉyʉ? Nʉanso wɨtʉmile ɨkani niziza. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Ahimbɨ ɨzamine mahikʉ ɨhi, ilagwa ʉnene shangakikiɨ nʉnyenye mahikʉ nɨhi. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Mʉsʉngʉ ʉyʉ ʉndʉbʉnkɨɨye ɨmakʉta ʉkʉnoneelya mʉɨlɨ wane kʉnsoko kʉikwa kʉng'waane. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Kʉmʉtambʉila taɨ, ga yɨhi mʉʉnkʉmbigʉlʉ Nkani Nziza ikʉtanantigwa, iti nʉtendile ʉmʉsʉngʉ ʉyʉ ikʉtambʉlwa kʉmʉkimbʉka ng'wenso.”<verse eid="MAT 26:13" /></para>
  <para style="s">Yʉda wɨkagomba kʉmʉsuɨpa ʉ Yesʉ</para>
  <para style="r">
    <ref loc="MRK 14:10-11">Maliko 14:10-11</ref>; <ref loc="LUK 22:3-6">Lʉka 22:3-6</ref></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Sʉnga, Yʉda Isikaliote ʉng'wɨao mʉamanyisigwa awo nikʉmi naabɨɨlɨ, wɨkalongola kʉapolya nɨakʉlʉ, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />wɨkaaɨla, “Mʉkʉmpa ntʉni anga nʉmʉletele ʉ Yesʉ?” Ɨkamʉpa makʉmi ataatʉ a mpia. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />kʉpuma itʉngo lɨlo ʉ Yʉda wɨkatʉladumɨɨla lyoma nɨlakʉaletela ʉ Yesʉ.<verse eid="MAT 26:16" /></para>
  <para style="s">Yesʉ ʉkʉlya ndya yiloeelya nɨla pasaka nɨ amanyisigwa akwe</para>
  <para style="r">
    <ref loc="MRK 14:12-21">Maliko 14:12-21</ref>; <ref loc="LUK 22:7-13">Lʉka 22:7-13</ref>; <ref loc="LUK 21:23">21:23</ref>; <ref loc="JHN 13:21-30">Yohana 13:21-30</ref></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Lʉhikʉ nʉla ng'wandyo nʉliloeelya nɨla mɨkate nɨshanga ɨgahɨigwe, amanyisigwa akwe ɨkamʉhanga ʉ Yesʉ ɨkamʉkolya, “Ʉloilwe kʉkʉnonelelye pɨ indya niyiloeelya nɨla pasaka?”<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />Yesʉ wɨkaasʉkɨɨlya, “Longoli kʉkɨsalɨ kʉmʉntʉ ʉng'wɨ, mʉmʉile: ‘Mʉmanyisi ʉlʉngile, itʉngo lane lapika; nɨkʉlɨla ɨpasaka palʉng'wɨ nɨamanyisigwa ane kʉng'wako.’”<verse eid="MAT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 26:19" />Amanyisigwa ɨkatenda ʉʉ anaga ʉ Yesʉ naʉalagiiye, ɨkanoneelya indya niyiloeelya nɨla pasaka.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Naɨyatula mpindi, Yesʉ palʉng'wɨ nɨamanyisigwa akwe ikumi abɨɨlɨ ɨkikiɨ ahume kʉlya indya. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Naɨakʉlya, Yesʉ wɨkalʉnga, “Kʉmʉtambila taɨ, ʉng'wɨanyʉ ʉkʉmpɨlʉka.<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />Amanyisigwa akwe ɨkaalɨka mʉnkolo, ɨkatulakolya, ʉng'wɨ ʉng'wɨ, “Isekʉlʉ! Itɨ, nenene?”<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />Yesʉ wɨkaasʉkɨɨlya, “Ʉyʉ nʉkʉlɨɨlya ɨntonge mibakuli palʉng'wɨ nʉnene, yʉyo ʉkʉnsuɨpa. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Ɨtai, Ng'waa Mʉntʉ ʉkʉsha anga ʉandɨkwa wang'wi Itunda nʉʉandikilwe, ingɨ ʉkɨa wakwe mʉntʉ ʉyʉ nʉkʉmʉsuɨpa ʉ Ng'waa Mʉntʉ! Aibahʉ mʉntʉ nʉanso aɨwaleke kʉtʉgwa.”<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Yʉda ʉyʉ nʉmʉsuɨpi, wɨkamʉkolya, “Mʉmanyisi, itɨ nenene?” Yesʉ wɨkamʉsʉkɨɨlya, “Ʉlʉngʉle wewe.”<verse eid="MAT 26:25" /></para>
  <para style="s">Lʉdya nʉliloeelya lang'wɨ Isekʉlʉ</para>
  <para style="r">
    <ref loc="MRK 14:22-26">Maliko 14:22-26</ref>; <ref loc="LUK 22:14-20">Lʉka 22:14-20</ref>; <ref loc="1CO 11:23-25">1 Akolinto 11:23-25</ref></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Naɨakʉlya, Yesʉ wɨkahola mʉkate, wɨkamʉsongelya Itunda, wɨkaega, wɨkaapa ɨamanyisigwa akwe wɨkaaɨla, “Holi mʉlye; ʉwʉ wʉwʉ mʉɨlɨ wane.”<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />Sʉnga wɨkahola kikombe nɨka dibai, wɨkamʉsongelya Itunda, wɨkaapa amanyisigwa akwe, wɨkalʉnga, “Ng'weli mɨhi ɨkɨkombe ɨkɨ; <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />kʉnsoko ɨyɨ ingɨ sakami ane nɨkʉkamɨnkɨɨlya kɨna ilago ingɨ tai, sakami nɨkʉhʉnʉka kʉnsoko aantʉ ɨdʉ ahume kʉhegeligwa mɨlandʉ. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Kʉmʉɨla, shanga kʉng'wa hangi ɨdibai a mʉzabibʉ kʉpikɨɨla lʉhikʉ ʉlo ninzeng'wa nimpya palʉng'wɨ nʉnyenye kʉʉtemi nʉang'wa Tata ane.”<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Naɨ akondya kimba lyimbo, ɨkahega, ɨkalongola mʉlʉgʉlʉ nʉla Mɨzeɨtʉni.<verse eid="MAT 26:30" /></para>
  <para style="s">Yesʉ ʉkʉtambʉla kɨna Petelo wɨkamʉhita</para>
  <para style="r">
    <ref loc="MRK 14:27-31">Maliko 14:27-31</ref>; <ref loc="LUK 22:31-34">Lʉka 22:31-34</ref>; <ref loc="JHN 13:36-38">Yohana 13:36-38</ref></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Sʉnga Yesʉ wɨkaaɨla, “Ʉtikʉ nʉa lelo, ʉnyenye mɨhi mʉkʉmanka nʉkʉndeka, kʉnsoko yandɨkilwe. ‘Kʉmʉkʉa ʉmʉdimi, ninkolo nɨyidale yʉkʉsapatɨla.’ <verse eid="MAT 26:31" /><verse number="32" style="v" sid="MAT 26:32" />Ingɨ anga niʉka, kʉmʉtongeela kʉ kɨsalɨ ka Galilaya.”<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Petelo wɨkamuɨla ʉ Yesʉ, “Ata ɨhi akʉleke, ʉnene shanga kʉʉleka.”<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />Yesʉ wɨkamʉɨla “Kʉʉtambʉila ɨtai, nsambaligʉgʉ ize ɨkɨlɨ kʉkʉnkʉla ʉkʉnihita nkʉa itaatʉ.”<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Petelo wɨkamʉɨla ata anga ɨzeisingilye kʉsha, kʉsha palʉng'wɨ nʉewe, ɨtai shanga kʉʉhita,</para>
  <para style="p" vid="MAT 26:35">“Nɨamanyisigwa ɨaʉya ɨkalʉnga ʉʉ ɨhi.<verse eid="MAT 26:35" /></para>
  <para style="s">Yesʉ ʉkʉlompa mʉkibuulya ka Getisiemane</para>
  <para style="r">
    <ref loc="MRK 14:32-42">Maliko 14:32-42</ref>; <ref loc="LUK 22:39-46">Lʉka 22:39-46</ref></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Sʉnga Yesʉ wɨkalongolaniya palʉng'wɨ nɨamanyisigwa akwe mʉkibʉʉlya ka Getisemae, nʉyo wɨkaaɨla, “Ikii papa ʉnene nongole pa ntongeela nendelompa.” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Wɨkamʉhola Petelo nɨana ang'wa Zebedayo abɨɨlɨ, wɨkandya kʉona ʉwaɨ nʉ kaga mʉnkolo. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Papo wɨkaaɨla, “Nkete ʉwaɨ ʉkʉlʉ mʉnkolo ane. Leki kʉlali ikii mʉlompe palʉng'wɨ nʉ nene.”<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />Itɨ gwa, wɨkalongola pantongeela iniino, wɨkagwa ʉʉndala, wɨkalompa. “Tata, anga ɨze ihʉmikile, ʉlwago ʉlʉ, lʉnihʉge; ingɨ ileke kʉtʉla anga nene ndoilwe, ingɨ anga nʉewe ʉloilwe.”<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Sʉnga wɨkaasʉkila amanyisigwa, wɨkahanga alala. Wɨkamʉila ʉ Petelo, “Itɨ gwa itʉile kɨna mʉlemilwe kʉleka tʉlo ga nisaa ning'wɨne? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Hʉgʉki nʉ kʉlompa mʉleke kʉkʉlala mʉhʉme kʉleka kingɨla mʉʉgeng'wa. Nkolo ɨloilwe kʉtenda natakiwe ingɨ ʉmʉɨlɨ ʉgila anga ngʉlʉ.”<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Wɨkalongola hangi nkʉa akabɨɨlɨ kʉlompa: “Tata nʉwane, ang'wɨ shanga ʉkʉnihegelya ʉlwago kʉkiila kʉngiza mpaka lʉkiile kʉng'wane, nagomba tenda anga nʉloilwe.” <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />Wɨkaasʉkila hangi, wɨkahanga alae, kʉnsoko aɨalemigwa tʉlo.<verse eid="MAT 26:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 26:44" />Itɨ gwa, wɨkaaleka, wɨkasʉka hangi kʉmalompi nkʉa akataatʉ wɨkalompa malompi yayoyayo. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />Sʉnga wɨkasʉka ɨamanyisigwa nɨanso, wɨkaaɨla, “iti, mʉkili mʉlae nʉkʉsʉpyane? Gozi itʉngo lapɨka, Ng'waa Mʉntʉ ʉkʉambwa nɨanyamilandʉ. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Ʉki; kwendi. Gozi! Ʉyʉ nʉkʉnsuɨpa wapika.”<verse eid="MAT 26:46" /></para>
  <para style="s">Yesʉ ʉkʉambwa</para>
  <para style="r">
    <ref loc="MRK 14:43-50">Maliko 14:43-50</ref>; <ref loc="LUK 22:47-53">Lʉka 22:47-53</ref>; <ref loc="JHN 18:3-12">Yohana 18:3-12</ref></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Ʉgwa, Yesʉ naɨwakili ʉkʉatambʉila, itʉngo lilo Yʉda ʉng'wɨ nʉwa amanyisigwa ikʉmi na abɨɨlɨ wɨkapika. Yʉda wikaze witongeeye niantʉ idʉ. Ikazeine nɨantʉ idʉ nɨapʉmya mapolya nɨakʉlʉ nɨanyampala aantʉ. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Ʉyʉ naʉtakile kʉmʉsuɨpa ʉ Yesʉ, aɨwakondya kʉatambʉila ɨkɨlɨngasiilyo kakʉalagiila: Ʉyʉ nɨkamʉlamʉsha ɨze nʉmʉungatɨe, mʉmʉambe yʉyo.”<verse eid="MAT 26:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49" />Itɨ gwa, ʉ Yʉda wɨkamʉhʉmbeela ʉ Yesʉ, “wɨkamʉlamʉsha, “Ʉwe mʉmanyisi, mɨlamʉ!” Sʉnga wɨkamʉungatɨla.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />Yesʉ wɨkamʉɨla “Ʉwe mʉhʉmbamɨane, itʉme ɨkani nʉzɨɨe.</para>
  <para style="p" vid="MAT 26:50">“Papo antʉ nɨanso ɨkamʉhumbeela ʉ Yesʉ, ɨkamʉamba, ɨkamʉtʉnga. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Ʉng'wɨao naɨ ɨpalʉng'wɨ nʉ Yesʉ wɨkatala mʉkono, wɨhopola ɨpanga akwe, wɨkamʉtema kʉtwɨ, ʉng'wɨao mʉitʉmi mʉpolyi nʉmʉkʉlʉ. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />Papo Yesʉ wɨkamʉɨla “Sʉkɨɨlya ɨpanga ako mʉnyalahanda, kʉnsoko ʉyʉ nʉwɨbʉlaga na panga, ʉzɨɨzabʉlagwa na panga. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Itɨɨ, shanga mʉlingɨle kɨna nihʉmile kʉmʉlompa ʉ Tata ane wanzaɨɨlye nʉo ʉhumile milʉndo imilʉndo ambita ikʉmi naabɨɨlɨ naɨtʉmi akigʉlʉ nɨang'wi Itunda? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Ʉandikwa wang'wi Itunda akʉtimila ʉligwa naliiye kɨna ʉʉ yandikilwe itʉlike?”<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Itʉngo lɨlo lɨɨlo Yesʉ wɨkaaɨla ɨantʉ nɨanso naɨaze mʉamba nʉkʉmʉtunga, “Itii, mʉzemamba anga nimii? Mʉkete nipanga niidunkuli, aɨnɨmanyisa Mʉnyʉmba ang'wi Itunda mahikʉ ɨhi, shanga aɨmimamba! <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Ingɨ aya ɨti ɨhi apumɨe kʉtimilya nkani yaamanga naɨatambʉe.”</para>
  <para style="p" vid="MAT 26:56">Sʉnga amanyisigwa akwe ɨhi ɨkamanka, ɨkamʉleka.<verse eid="MAT 26:56" /></para>
  <para style="s">Yesʉ ʉkolɨ pi anza</para>
  <para style="r">
    <ref loc="MRK 14:53">Maliko 14:53</ref>; <ref loc="LUK 22:54-55">Lʉka 22:54-55-63-71</ref>; <ref loc="JHN 18:13-14">Yohana 18:13-14</ref>; <ref loc="JHN 19:24">19:24</ref></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Itɨ gwa, antʉ nɨanso naɨamʉambile Yesʉ ɨkamʉtwala Mʉnyʉmba mʉpolyi nʉ mʉkʉlʉ nʉwitangwa Kayapwa, kʉaɨlingɨie ɨamanyisi amalago nɨanyampala. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Petelo wɨkamʉtyatɨɨla kakʉlɨ wɨkingɨila mitando nɨla nyʉmba nanso wɨkikiɨ palʉng'wɨ nɨalili wahʉme kiloeela imakani akʉtʉla ʉli. <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />Itɨ gwa, akʉlʉ nɨamapolya nɨanza lɨhi ɨkadʉma akʉiili nɨaʉteele ahʉme kʉmʉbʉlaga ʉ Yesʉ, <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />ingɨ shanga ɨkalija ʉkʉiili wɨhi, palʉng'wɨ nɨ kɨna antʉ aɨapumilye ʉkʉiili wɨdʉ nʉaʉteele. Sʉnga ɨkaza akʉɨɨli abɨɨlɨ, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />ɨkalʉnga, “Mʉntʉ ʉyʉ aɨʉlʉngile. Nihʉmile kʉmikumʉla Nyʉmba ang'wi Itunda nʉkʉmizenga kʉnsikʉ itaatʉ.’”<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Sʉnga Mʉpolyi nʉmʉkʉlʉ wɨkimɨka, wɨkamʉkolya, ʉe Yesʉ, itɨɨ shanga ʉkʉasʉkɨɨlya anga kɨntʉne? Antʉ awa alʉngilile ʉli kʉhʉsʉ nʉewe? <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Yesʉ ingɨ wɨkakilaja ɨhitwɨ. Mʉpolyi nʉmʉkʉlʉ wɨkamʉɨla “Lapa kʉlina lang'wa Itunda nʉmʉkʉlʉ. kʉtambʉile ang'wɨ ʉewe wewe wɨ Kilisito, Ng'wana wang'wi Itunda!”<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />Yesʉ wɨkamʉɨla “wewe ʉlʉngile! Ingɨ kʉmʉtambʉila, kʉpʉma itʉngo lili mʉkʉmʉona Ʉng'waa Mʉntʉ wɨkiɨ nkɨka akigoha nʉang'wɨ Isekʉlʉ Mʉkola ʉhumi, wazesima nɨmalunde akigʉlʉ.”<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Papo paapo mʉpolyi nʉ mʉkʉlʉ wɨkatamʉla matugalo akwe, wɨkalʉnga, “Wamʉtʉkɨla Itunda! kʉʉhiya ʉkʉɨɨli nʉʉlɨ? itungo ɨlɨ mijaa ɨkɨtʉki kakwe. <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Ʉnyenye mʉsɨgile ʉli?</para>
  <para style="p" vid="MAT 26:66">Nɨanso ɨkamʉsʉkɨɨlya, “Ʉyʉ inonee wabʉlagwe.<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Sʉnga ɨkamʉtyila mati mʉʉsʉ, ɨkamʉkʉa makopi. Nɨang'wɨ ɨkazealongelekile kʉmʉkʉa makopi, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />ɨkamʉila, ʉewe kilisito kʉlotoele nyenyʉ nʉkʉkʉile!”<verse eid="MAT 26:68" /></para>
  <para style="s">Yesʉ ʉkʉmʉhita nʉ Petelo</para>
  <para style="r">
    <ref loc="MRK 14:66">Maliko 14:66</ref>; <ref loc="LUK 22:56-62">Lʉka 22:56-62</ref>; <ref loc="JHN 18:15-18">Yohana 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref></para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Petelo aɨwɨkiɨ kʉnzi mitando. Mitʉmi ʉng'wɨ nʉakisʉngʉ wɨkamʉhanga, wɨkamʉkolya, “Ʉewe azamine nʉ Yesʉ nʉwakʉ Galilaya.”<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />Petelo wɨkahita ntongeela aantʉ ɨhi wɨkalʉnga, shanga nɨkɨine ɨkɨ nʉkʉkɨtambʉla. <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />Petelo wɨkahega pang'wanso wɨkalongola pamʉmpita, mitʉmi mʉngɨɨza nʉwa kisʉngʉ wɨkamʉona, wɨkaaɨla antʉ naɨakolɨ pang'wanso, “Mʉntʉ ʉyʉ azaine nʉ Yesʉ Mʉnazaleti.<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Petelo wɨkahita hangɨ wazelapa, “Shanga nʉmʉmanyile ʉmʉntʉ ʉyʉ.”<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Itungo lɨlo antʉ naɨimɨkile pang'wanso ɨkamʉhanga ʉ Petelo, ɨkamʉila, “Itaɨ, ʉewe mɨpalʉng'wɨ nʉ mʉntʉ ʉyʉ, kʉnsoko intambʉ ako mimpyani.”<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Sʉnga Petelo wɨkandya kizʉma nʉkʉlapa wazelʉnga, “Mʉntʉ ʉyʉ ʉnene shanga nʉmʉmanyile!</para>
  <para style="p" vid="MAT 26:74">Nsambaligʉgʉ ɨkakʉnkʉla itʉngo lilo. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />Petelo wɨkakɨmbʉka inkani naɨʉtambʉiwe nʉ Yesʉ: “Kina nsambaligʉgʉ ɨzeɨkɨlɨ kʉkʉnkʉla ʉkʉnɨhita nkʉa taatʉ, “Papo wɨkapʉma kʉnzi, wɨkatʉlalɨla nʉkilɨɨla.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">Yesʉ ʉkatwalwa kʉng'wa Pilato</para>
  <para style="r">
    <ref loc="MRK 15:1">Maliko 15:1</ref>; <ref loc="LUK 23:1">Lʉka 23:1</ref>,<ref loc="LUK 23:2">2</ref>; <ref loc="JHN 18:28-32">Yohana 18:28-32</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Daʉ maniambwa, ɨakʉlʉ nɨapʉmya mapolya nɨatongeeli a ayahudi ɨhi ɨkitambʉlya akʉhʉma ʉlɨ kʉmʉbʉlagʉ Yesʉ. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Ikamʉtʉnga mpingʉ, ɨkamʉhola, ɨkamʉtala kʉng'wa Pilato, naɨ mʉkʉlʉ nʉwa kɨsalɨ wahume kʉlamʉla kʉsha.<verse eid="MAT 27:2" /></para>
  <para style="s">Yʉda ʉkigoga</para>
  <para style="r">
    <ref loc="ACT 1:18">Ntendo 1:18</ref>,<ref loc="ACT 1:19">19</ref></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Papo gwa, ʉ Yʉda naɨʉmʉsuɨpile ʉ Yesʉ, naɨwaona kɨna Yesʉ wakondya kʉmʉpɨsɨɨlya kʉbʉlagwa, wɨkaona watenda ibɨ, wɨkahʉsha wɨkasʉsha mpia makʉmi ataatʉ na naʉpewe nɨ Apolyi nɨakʉlʉ. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />Wɨkaaɨla, “Nagaza kʉmʉsongeela ʉmʉntʉ nʉmʉgilaangi igazo wabʉlagwe,</para>
  <para style="p" vid="MAT 27:4">“Ingɨ nɨanso ɨkamʉila, “Ʉkʉlɨnga hapo, ʉsese kʉtendeʉli? <verse eid="MAT 27:4" /><verse number="5" style="v" sid="MAT 27:5" />Yʉda wɨkaɨgʉma mpia niyanso Mʉnyʉmba ang'wi Itunda, wɨkapʉma kʉnzi, wɨkenda kigoga. <verse eid="MAT 27:5" /><verse number="6" style="v" sid="MAT 27:6" />Apolyi nɨakʉlʉ ɨkaɨhola impɨa niyanso, ɨkalʉnga, “Shanga inonee kʉɨka mpɨa izi mʉmbago a Nyʉmba ang'wi Itunda kʉnsoko impɨa izi yasakami.” <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Itɨ gwa, ɨkigombasɨɨlya, aɨtʉmile kʉgʉɨla mʉgʉnda nʉwa mʉʉmbi atʉle aɨka antʉ nɨshanga ayahudi. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Yɨyo nsoko mʉgʉnda nʉwanso kʉpikɨɨla lelo wɨtangwa mʉgʉnda nʉwa sakami. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Papo nkani niya mʉmanga Yelemia ɨkakondanɨɨla. “Aɨahoile mpia makʉmi ataatʉ, ngele yiyo anya ku Isilaeli aɨigombilye kigʉɨla, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />ɨkamʉgʉila mʉgʉnda nʉwa mʉʉmbi, anga Isekʉlʉ naʉndagiiye.”<verse eid="MAT 27:10" /></para>
  <para style="s">Pilato ʉkʉmʉkolya ʉ Yesʉ</para>
  <para style="r">
    <ref loc="MRK 15:2-5">Maliko 15:2-5</ref>; <ref loc="LUK 23:3-5">Lʉka 23:3-5</ref>; <ref loc="JHN 18:33-38">Yohana 18:33-38</ref></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Yesʉ aɨwɨmikigwe pantongeela amʉkʉlʉ nʉwa kʉ Lumi. Ʉgwa, ʉmʉkʉlʉ nʉanso wɨkamʉkolya, “Itii, ʉewe wewene wɨmʉtemi nʉa Ayahʉdi?” Yesʉ wɨkamʉɨla “wewe ʉtambʉe.” <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />Ingɨ Apolya nɨakʉlʉ nɨatongeeli aayahudi nɨakʉsemeee, shanga akʉsʉkiiye lʉkani lɨhi. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Kʉɨtɨ ʉ Pilato wɨkamʉkolya, “Iti, ʉewe shanga wɨgʉlyene inkani izi nɨakʉsemelwa?” <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />Ingɨ Yesʉ shanga aʉsʉkiiye lʉkani ga nʉlʉ nʉlʉng'wɨ, ʉmʉkʉlʉ nʉwa kʉ Loma nʉyo wɨkakʉilwa.<verse eid="MAT 27:14" /></para>
  <para style="s">Yesʉ ʉkʉpɨsɨɨligwa kʉbʉlagwa</para>
  <para style="r">
    <ref loc="MRK 15:6-15">Maliko 15:6-15</ref>; <ref loc="LUK 23:13-25">Lʉka 23:13-25</ref>; <ref loc="JHN 18:39">Yohana 18:39</ref>; <ref loc="JHN 19:16">19:16</ref></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Aɨntendo a matungo iloeelya nɨla pasaka mʉkʉlʉ nʉwa kʉ Loma kʉmʉtʉngʉila mʉtʉngwa ʉng'wɨ ni Ayahʉdi amʉloilwe. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Matʉngo nanso aʉkolɨ mʉtʉngwa ʉng'wɨ naʉmanyɨkile ikɨlo, ɨlina lakwe Balaba. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />kʉɨtɨ, ɨantʉ naɨlinga palʉng'wɨ, Pilato wɨkaakolya, “Mʉloilwe nʉmʉtʉngʉile nyenyu mʉantʉ awa nɨabɨɨlɨ, Balabane ang'wɨ Yesʉ nʉwitangwa Kilisito? <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Pilato aɨʉtambʉe itɨ kʉnsoko aʉlɨngile kɨna amʉletile kʉng'wakwe kʉnsoko awɨlu ʉdu. <verse eid="MAT 27:18" /><verse number="19" style="v" sid="MAT 27:19" />Pilato aɨwikiɨ mituntu nɨla kʉlamʉɨla, mʉsʉngʉ wakwe wɨkamʉtwaɨla lʉkani. Leka kʉmʉtendeela ikani lɨhi nibɨ ʉmʉntʉ ʉyʉ nɨmʉkende, lelo ɨyɨ nagile mʉndoti kʉnsoko amʉntʉ ʉyʉ. <verse eid="MAT 27:19" /><verse number="20" style="v" sid="MAT 27:20" />Apolyi nɨakʉlʉ nɨatongeeli a ayahudi ingɨgwa ɨkaapema ɨantʉ amʉɨle ʉ Pilato wamʉtungʉɨle ʉ Balaba nʉ Yesʉ wabʉlagwe. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />Pilato wɨkaakolya, “Antʉ awa nɨabɨɨlɨ mʉloilwe nʉmʉtʉngʉle nʉʉli? Ikasʉkɨɨlya. “Balaba!” <verse eid="MAT 27:21" /><verse number="22" style="v" sid="MAT 27:22" />Pilato wɨkaakolya, “Apa, ʉ Kilisito nʉmʉtende ʉli?” Ɨhi ɨkasʉkɨɨlya, “Wakononteelwe mʉmʉsalaba!” <verse eid="MAT 27:22" /><verse number="23" style="v" sid="MAT 27:23" />Pilato wɨkakolya, “Kʉnsoko kɨɨ? Witʉmile igazo kɨɨ?” Nɨanso ɨkamitʉntɨɨla. “Mʉkonontele mʉmʉsalaba!” <verse eid="MAT 27:23" /><verse number="24" style="v" sid="MAT 27:24" />Pilato naɨwalɨnga kɨna shanga ʉhʉmile kʉtenda kɨntʉ kɨhi kʉnsoko minyomo wainiigela, wɨkahola mazɨ, wɨkakalala mɨkono ntongeela iʉmbɨ nɨla antʉ, wɨkalʉnga, ikani ɨlɨ itʉmi nyenye akola, “Mʉlɨnga ʉnyenye.” <verse eid="MAT 27:24" /><verse number="25" style="v" sid="MAT 27:25" />Antʉ ɨhi ɨkalʉnga, “Anga ize kʉʉtumula kikani ɨlɨ Itunda nʉwakʉpɨsɨɨlye sese nɨ ana itʉ!” <verse eid="MAT 27:25" /><verse number="26" style="v" sid="MAT 27:26" />Papo gwa ʉ Pilato wɨkamʉtʉngʉɨla ʉ Balaba kʉpʉma mʉkadulumu, wɨkalagɨɨlya amboi akwe amʉkʉe ʉ Yesʉ misheleti, wɨkamʉpʉmya Yesʉ wɨkaapa amʉkononteelwe mʉmʉsalaba.<verse eid="MAT 27:26" /></para>
  <para style="s">Amboi akʉmʉtenda ʉpʉngʉ ʉ Yesʉ</para>
  <para style="r">
    <ref loc="MRK 15:16-20">Maliko 15:16-20</ref>; <ref loc="JHN 19:2">Yohana 19:2</ref>,<ref loc="JHN 19:3">3</ref></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Sʉnga amboi ang'wa Pilato ɨkamingɨlya ʉ Yesʉ mitando nɨla nyumba nʉikiɨ mʉtongeeli nʉwa Aloma, amboi ɨhi ikamʉpilimɨkɨɨlya. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Ɨkamʉtugʉla matʉgalo naɨʉtʉgae, ɨkamʉtʉgala <note caller="+" style="f"><char style="fr" closed="false">27:28 </char><char style="ft" closed="false">itugalo nɨɨtugala Atemi</char></note>mʉjʉlʉngʉ ʉkaʉku. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Sʉnga ɨkapotya ngala amamija, ɨkamʉtʉgalya mitwe, hangi ɨkamʉikilya mʉlanga ʉkaʉku kʉmʉkono wakwe nʉakigoha. Ikatʉgama pa ntongeela akwe, ɨkatʉla mʉtenda ʉpʉngʉ, “Ɨkaze mʉambi imigʉlʉ nʉkʉmʉila mʉtemi wa Ayahʉdi!” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Ɨkamʉtyɨla matɨ, ɨkahola ʉmʉti nʉanso, ɨkamʉkʉila wʉwʉ mitwe. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Naɨakondya kʉmʉtenda ʉʉpʉngʉ, ɨkamʉtʉgʉla ʉmʉjʉlʉngʉ nʉanso, ɨkamʉtʉgala hangi matʉgalo akwe, sʉnga ɨkamʉlongolya kenda kʉmʉkononteela mʉmʉsalaba.<verse eid="MAT 27:31" /></para>
  <para style="s">Yesʉ ʉkʉkononteelwa mʉmʉsalaba</para>
  <para style="r">
    <ref loc="MRK 15:21-32">Maliko 15:21-32</ref>; <ref loc="LUK 23:26-43">Lʉka 23:26-43</ref>; <ref loc="JHN 19:17-27">Yohana 19:17-27</ref></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Naɨalongoe, ɨkatankana nʉ mʉntʉ ʉng'wɨ lina lakwe Simioni, mʉnya kʉ Kilene, ɨkamʉsinja waʉkeke ʉmsalaba wang'wa Yesʉ. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Naɨapɨka payitangwa Goligota, ndogoelyo akwe, Ing'ang'a litwe, <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />ɨkamʉpa dibai nɨhalɨnkanilye nikɨntʉ nikilʉlʉ, ingɨ Yesʉ naɨwalʉlya wɨkahita kʉng'wa. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />Naɨamʉkononteela mʉmʉsalaba, amatʉgalo akwe ɨkakʉɨla mbʉkʉlʉbʉnkʉlʉ. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Ɨkikiɨ, ɨkakamʉsʉnga. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Pigʉlya migʉlya itwe lakwe mʉmʉsalaba ɨkaandɨka magazo akwe kɨna, “Ʉyʉ ingɨ Yesʉ, Mʉtemi nʉwa Ayahʉdi.” <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Antʉ abɨɨlɨ nɨii aɨakononteewe ga nienso mʉmɨsalaba palʉng'wɨ nʉ Yesʉ, ʉng'wɨ kʉmʉkono nʉwa nkɨgɨ nʉakabɨɨlɨ mʉkono nʉwa kɨgoha. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />Antʉ nɨakʉkɨɨla pang'wanso ɨkazeginga matweao nʉkʉmʉtʉkɨɨlya ʉ Yesʉ azelʉnga, <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />“Ʉewe! Ingɨ aɨwisanilye ʉhumile kʉkumʉla Nyʉmba ang'wi Itunda nʉkʉzenga kʉmahikʉ ataatʉ? igune ʉewe. Anga ɨze ʉewe wɨ Ng'wana wang'wi Itunda, sialɨ, sima mʉmʉsalaba!” <verse eid="MAT 27:40" /><verse number="41" style="v" sid="MAT 27:41" />Nɨapolyi nɨakʉlʉ nɨamanyisi amalago ang'wa Mʉsa nɨatongeeli ayahudi ɨkamʉsensa azelʉnga, <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“Ʉagunile nɨangiza, kiponya nʉanso waleng'wa! Anga ɨze nʉanso mʉtemi wa Ayahʉdi! Nʉasime mʉmʉsalaba, nʉsese kʉʉmʉhʉiila. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Aiʉmʉhɨɨe Itunda nʉkʉlʉnga kɨna nʉanso Ng'wana wang'wi Itunda; Itunda nʉamʉgune anga ɨze ʉloilwe.” <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Nɨii awa nɨabɨɨlɨ naɨakononteewe palʉng'wɨ nʉyo ɨkamʉtʉkila.<verse eid="MAT 27:44" /></para>
  <para style="s">Yesʉ ʉkʉsha mʉmʉsalaba</para>
  <para style="r">
    <ref loc="MRK 15:33-41">Maliko 15:33-41</ref>; <ref loc="LUK 23:44-49">Lʉka 23:44-49</ref>; <ref loc="JHN 19:28-30">Yohana 19:28-30</ref></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Kʉpʉma saa mʉtandatʉ ng'ʉng'wɨ kʉpikɨɨla saa kenda, kiti aɨkitumile ɨhii ɨhi. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Naɨapɨka saa kenda Yesʉ wɨkakʉta, “Eloi, Eloi, lama sabakitani?” Ndogoelyo akwe, Itunda wane, Itunda wane, nɨkɨ wandeka?” <verse eid="MAT 27:46" /><verse number="47" style="v" sid="MAT 27:47" />Ingɨ awa naɨmikile pang'wanso naɨija itɨ, “Waɨna mitanga Elɨa.” <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Ʉng'wɨao wɨkamanka wɨkahola sipongo, wɨkalɨɨlya mʉkɨlʉʉlwɨ, wɨkahepya mʉmʉlanga, wɨkamʉpa wang'we.” <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Antʉ ang'wɨ ɨkalʉnga, kilagi kʉone ang'wɨ Elɨa ʉzemʉgʉna.” <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />Yesʉ wɨkalɨla hangi nangalʉ, wɨkasha. <verse eid="MAT 27:50" /><verse number="51" style="v" sid="MAT 27:51" />Papo pazɨa nɨla Nyʉmba ang'wi Itunda, lɨkatamʉka mpande ibɨɨlɨɨ, kʉpʉma migʉlya mpaka pihɨ; ihɨɨ ɨkahingiɨka; imagwe ɨkagalanʉka, <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />ibɨɨla yɨkalugʉka antʉ ɨdʉ nɨang'wi Itunda naɨakule ɨkiʉkigwa, <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Yesʉ naɨwiʉka antʉ nɨanso ɨkapuma mʉibɨɨla, ikigɨla mʉkɨsalɨ kaantʉ, ɨkigeela kʉantʉ ɨdʉ <verse eid="MAT 27:53" /><verse number="54" style="v" sid="MAT 27:54" />Itɨ gwa, mankata nʉa asʉnji nawa naɨ akʉmʉsʉnja ʉ Yesʉ naɨaona ʉmʉtentemo wihɨɨ nimakani naɨapʉmie, ikogopa ɨkalʉnga, “Itʉnʉ mʉntʉ ʉyʉ aɨ Ng'wana wang'wi Itunda.” <verse eid="MAT 27:54" /><verse number="55" style="v" sid="MAT 27:55" />Kakʉlɨ nɨpang'wanso aɨakolɨ asʉngʉ idʉ ɨkaze iloee. Asʉngʉ nɨanso wawa naɨ endaamʉtyatile ʉ Yesʉ nʉkʉmitʉmila naɨapʉmɨe kʉ Galilaya. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Mʉng'wao kaze ʉkolɨ Maliamu mʉnyakʉ Magidala, nʉ Malɨa nyinya wang'wa Yakobo nʉ Yosepu, palʉng'wɨ nʉ nyinya waana ang'wa Zebedayo.<verse eid="MAT 27:56" /></para>
  <para style="s">Kʉikwa kʉng'wa Yesʉ</para>
  <para style="r">
    <ref loc="MRK 15:42-47">Maliko 15:42-47</ref>; <ref loc="LUK 23:50-56">Lʉka 23:50-56</ref>; <ref loc="JHN 19:38-42">Yohana 19:38-42</ref></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Naɨyatʉla mpɨndɨ, wɨkɨza mʉntʉ ʉng'wɨ mʉgolɨ kʉpuma kʉ Makigala, lina lakwe aɨwɨtangwa Yosepu, ga nʉng'wenso aɨ mʉmanyisigwa wang'wa Kilisito. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Wɨkamʉhanga ʉ Pilato, wɨkalompa wapegwe ʉmʉimba wang'wa Yesʉ. Ʉʉgwa, Pilato wɨkalagɨɨlya wapegwe. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Yosepu wɨkaʉhola mʉimba wang'wa Yesʉ, wɨkaʉtʉnga shanda nɨnzelʉ pee. <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />wɨkaʉɨka mʉkɨɨbɨɨla nɨkɨpya naɨʉkɨpoowe migwe. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Maliamu mʉnyakʉ Magidala, nʉ Maliamu nyinya wang'wa Yakobo nʉ Yosepu aɨikiɨ kʉkengeela kʉkɨbɨɨla.<verse eid="MAT 27:61" /></para>
  <para style="s">Kɨbɨɨla kang'wa Yesʉ kɨkʉsʉngwa</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Mʉdaʉao, naɨ lʉhikʉ nʉla kʉsupya, apolyi nɨakʉlʉ nɨa Palisayo ɨkamʉhanga ʉ Pilato, <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />Ɨkamʉɨla, “Ʉewe Mʉkʉlʉ, kʉkɨmbʉkile kɨna mʉteele ʉyʉ naɨwakɨlɨ kʉsha aʉlʉngile kɨna, “Lʉhikʉ nʉla kataatʉ ʉkiʉka,’ <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />kʉɨtɨ lagɨɨlya antʉ asʉnje ɨkɨbɨɨla kakwe kʉpikɨɨla lʉhikʉ nʉla kataatʉ amanyisigwa akwe aleke kɨza kia ʉmʉimba wang'wa Yesʉ atʉle aɨla ɨantʉ kɨna wɨʉka. Ʉʉteele ʉwʉ nʉwa mpelo ʉkʉtʉla ʉbɨ kʉkila ʉteele nʉang'wandyo.” <verse eid="MAT 27:64" /><verse number="65" style="v" sid="MAT 27:65" />Pilato wɨkaaɨla, “Namʉgombya ʉnyenye mʉkete ɨasʉnji, longoli mʉaɨke anga nimʉloewe,’’ <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Kʉlʉlo, ɨkalongola, ɨkaɨka asʉnji ɨkakɨsʉnga ɨkɨbɨɨla kʉʉkendegeeli, ɨkapela ʉgomola migwe naɨlɨkiɨigwe pang'wanso ɨkaɨka asʉnji, asʉnje.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">Kiʉka kʉng'wa Yesʉ</para>
  <para style="r">
    <ref loc="MRK 16:1-10">Maliko 16:1-10</ref>; <ref loc="LUK 24:1-12">Lʉka 24:1-12</ref>; <ref loc="JHN 20:1-10">Yohana 20:1-10</ref></para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Naɨakɨla lʉhikʉ nʉla kʉsupya, daʉ maniambwa mʉlʉhikʉ nʉla ng'wandyo nʉla wiki, Maliamu mʉnya kʉ Magidala nʉ Maliamʉ mʉya, ɨkalongola kʉgoza kɨbɨɨla. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />Pʉmpʉlʉgʉ wɨkigela mʉtentemo ʉkʉlʉ wihɨɨ; kʉnsoko malaɨka wang'wi Isekʉlʉ aɨʉkʉsima kʉpʉma kigʉlʉ nʉ kʉlɨpingɨlitya igwe naɨlɨkiɨwe pakɨbɨɨla nʉ kʉlɨɨka kʉmpelo, wɨkɨkaɨla. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Ikelʉ lang'wa malaɨka ʉyu aɨlɨkʉmɨlɨgɨnta anga lʉpito, matʉgalo akwe aɨmelʉ pee. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Asʉnji a kɨbɨɨla ɨkatʉlakagata kʉwoa ʉkʉlʉ, ɨkagagantala anga antʉ nɨakʉle.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />Malaɨka nʉwanso wɨkaaɨla asʉngʉ nɨanso, “Ʉnyenye leki kogopi! Ningɨle kɨna mʉkʉmʉduma Yesʉ naza amʉkomile mʉmʉsalaba. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Wɨkʉtilɨ apaitɨ, kʉnsoko wiʉka anga naza ʉlɨɨye. Pembyi mʉgoze paza amʉlalɨkilye. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Itɨ gwa, kayi longoli mʉatambʉile ɨamanyisigwa akwe kɨna, ‘wɨʉka nitungo ɨlɨ watongela kʉ Galilaya, kʉko mʉkʉmʉona. Aligwa ʉnene, nakondya kʉmʉila.”<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />Asʉngʉ nɨanso ɨkatʉla nʉ woa kʉnʉ akete ʉlowa ʉkʉlʉ, ɨkapepaala ɨkamanka kenda kʉatambʉila amanyisigwa ang'wa Yesʉ impola izi.<verse eid="MAT 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9" />Pʉmpʉlʉgʉ, mʉnzɨla ɨkatankana nʉ Yesʉ, nʉyo wɨkaaɨla, “Kʉmʉlamʉsha.” Asʉngʉ awa ɨkamʉhʉmbeela, ɨkatʉgama pamɨgʉlʉ ang'wa Yesʉ, ɨkaamba migʉlʉ akwe. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Sʉnga ʉ Yesʉ wɨkaaɨla, “Leki kogopi! Longoli mʉaɨle ɨanyandʉgʉ ane alongole kʉ Galilaya, kʉko akʉmona.”<verse eid="MAT 28:10" /></para>
  <para style="s">Nkani niya asʉnja kɨbɨɨla</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Asʉngʉ nɨanso naɨ alongoe, asʉnja kɨbɨɨla nɨangwɨ ɨkalogola mʉkɨsalɨ kʉtwala mpola kʉ atongeeli aapolyi makani ɨhi napʉmie. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Itɨ gwa, atongeeli a apolyi ɨkatankana nɨatongeeli a ayahudi, naɨakondya kisɨja. ɨkaapa mpɨa yidʉ ɨasʉnja kɨbɨɨla <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />aze apema, “Ʉnyenye mʉtakɨwe kʉlʉnga itɨɨ. ‘Ʉtikʉ ʉsese naza kʉlae, amanyisigwa akwe aza amɨa.’ <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Hangɨ anga mʉtongeeli nʉwa Alumɨ nʉwitangwa Pilato wije ʉlʉkani ʉlʉ, sese kʉʉmʉkʉɨɨla, ʉnyenye mʉleke kʉtula nigazo lɨhi.<verse eid="MAT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15" />Kʉlʉlo asʉnji awa nɨakɨbɨɨla ɨkaɨhola impia nianso, ɨkatenda anga naɨ amanyisigwe. Mpola izi yenee Mʉayahudi nʉsambʉ nʉyʉ.<verse eid="MAT 28:15" /></para>
  <para style="s">Yesʉ ʉkigeeleka kʉ amanyisigwa akwe</para>
  <para style="r">
    <ref loc="MRK 16:14-18">Maliko 16:14-18</ref>; <ref loc="LUK 24:36-49">Lʉka 24:36-49</ref>; <ref loc="JHN 20:19-23">Yohana 20:19-23</ref>; <ref loc="ACT 1:6-8">Ntendo 1:6-8</ref></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Amanyisigwa awo nikʉmi na ʉng'wɨ ɨkalongola kʉ Galilaya mʉ lʉgʉlʉ ʉlo anga naɨalagɨigwe nʉ Yesʉ. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Naɨamʉonaʉ Yesʉ ɨkamʉkʉlya, palʉng'wɨ nʉkʉtʉla nɨang'wɨ shanga aɨahʉɨɨe. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Yesʉ wɨkaahʉmbeela, wɨkaaɨla, “Mpewe nene ʉhʉmi wɨhi nʉwa kʉtema kigʉlʉ nʉ mihɨɨ. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Kʉnsoko ɨyɨ, longoli mʉʉnkumbigʉlʉ, mende mʉatende antʉ amahɨɨ ɨhi atʉle amanyisigwa ane. Mʉze abadisa kʉ lina lang'wa Tata nʉ Ng'wana nʉ Ng'wahʉ Ng'welʉ. <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />Amanyisi kʉamba makani ɨhi ninʉmʉpee. Ʉnene nɨpalʉng'wɨ nʉ nyenye mahikʉ ɨhi, sʉnga ɨmpelo amatʉngo.”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>