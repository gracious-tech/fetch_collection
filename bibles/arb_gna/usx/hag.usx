  <para style="toc3">حج</para>
  <para style="toc1">حجّاي</para>
  <para style="toc2">حجاي</para>
  <para style="mt">حجّاي</para>
  <chapter number="1" style="c" sid="HAG 1" />
  <para style="s1">إعادة بناء الهيكل</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="HAG 1:1" />في السَّنةِ الثَّانيةِ لداريّوسَ المَلكِ، في اليومِ الأوَّلِ مِنَ الشَّهرِ السَّادسِ، كانت كلِمةُ الرّبِّ على لسانِ حَجَّاي النَّبيِّ إلى زَرُبَّابِلَ بنِ شَألتئيلَ حاكِمِ يَهوذا، وإلى يَشوعَ بنِ يُوصادقَ الكاهنِ العظيمِ.<verse eid="HAG 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="HAG 1:2" />هذا ما قالَ الرّبُّ القديرُ: ”هذا الشَّعبُ يقول: إنَّ وقتَ بناءِ بَيتِ الرّبِّ ما حانَ بَعدُ“. <verse eid="HAG 1:2" /><verse number="3" style="v" pubnumber="3" sid="HAG 1:3" />فكانت كلِمةُ الرّبِّ على لِسانِ حَجَّايَ النَّبيِّ، قالَ: <verse eid="HAG 1:3" /><verse number="4" style="v" pubnumber="4" sid="HAG 1:4" />”كيفَ لكُم أنْ تسكُنوا في بيوتِكُمُ المُسقَّفةِ، فيما بَيتُ الرّبِّ هذا خَرِبٌ؟ <verse eid="HAG 1:4" /><verse number="5" style="v" pubnumber="5" sid="HAG 1:5" />والآنَ هذا ما يقولُ الرّبُّ القديرُ: تأمَّلوا في قلوبِكُم أينَ أوصَلَتْكُم طُرقُكُم. <verse eid="HAG 1:5" /><verse number="6" style="v" pubnumber="6" sid="HAG 1:6" />زرعتُم كثيرًا وحَصدتُم قليلًا. تأكلونَ ولا تَشبعونَ. تَشربونَ ولا ترتَوونَ. تكتَسونَ ولا تَدفأونَ. والّذي يأخُذُ أُجرةً يُلقيها في كيسٍ مثقوبٍ“.<verse eid="HAG 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="HAG 1:7" />وهذا ما يقولُ الرّبُّ القديرُ: ”تأمَّلوا في قلوبِكُم أينَ أوصَلَتْكُم طُرقُكُم. <verse eid="HAG 1:7" /><verse number="8" style="v" pubnumber="8" sid="HAG 1:8" />إصعَدوا إلى الجبَلِ، وهَيِّئوا خشَبًا، واَبنوا بيتي فأرضى بهِ وأتمجَّدَ، يقولُ الرّبُّ. <verse eid="HAG 1:8" /><verse number="9" style="v" pubnumber="9" sid="HAG 1:9" />إنتظرتُم كثيرًا فإذا بقليلٍ، ولمَّا أدخلتُمُوه بيوتَكُم نفخْتُ علَيهِ فتبدَّدَ. لماذا؟ يقولُ الرّبُّ القديرُ. لأنَّ بيتي خَرِبٌ وأنتم مُنهمِكُونَ، كُلُّ واحدٍ مِنكُم، ببناءِ بيتِه. <verse eid="HAG 1:9" /><verse number="10" style="v" pubnumber="10" sid="HAG 1:10" />لذلِكَ اَمتَنَعَتِ السَّماءُ فوقَكُم مِنَ المطَرِ، ومنعتِ الأرضُ غلَّتَها. <verse eid="HAG 1:10" /><verse number="11" style="v" pubnumber="11" sid="HAG 1:11" />وأنا دَعوتُ بالقَحْطِ على الأرضِ والجبالِ، وعلى الحنطةِ والخمرِ والزَّيتِ، وعلى ما تُنبتُ الأرضُ، وعلى البشَرِ والبهائِمِ، وعلى كُلِّ تعبِ اليدَينِ“.<verse eid="HAG 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="HAG 1:12" />فسمِعَ زرُبَّابِلُ بنُ شَألتئيلَ، ويَشوعُ بنُ يوصَادقَ الكاهنِ العظيمِ، وسائرُ الشَّعبِ، لصوتِ الرّبِّ إلهِهِم ولكلامِهِ كما أرسلَهُ على لِسانِ حَجَّايَ النَّبيِّ، فخافوا مِنْ وجهِ الرّبِّ. <verse eid="HAG 1:12" /><verse number="13" style="v" pubnumber="13" sid="HAG 1:13" />وتكلَّمَ حَجَّايُ بما أرسلَهُ الرّبُّ للشَّعبِ: ”أنا معكُم، يقولُ الرّبُّ“. <verse eid="HAG 1:13" /><verse number="14" style="v" pubnumber="14" sid="HAG 1:14" />وأثارَ الرّبُّ حماسةَ زربَّابِلَ بنِ شَألتئيلَ حاكمِ يَهوذا ويشوعَ بنِ يوصَادقَ الكاهنِ العظيمِ وسائِرِ الشَّعبِ، فجاؤوا وباشروا العمَلَ في بَيتِ الرّبِّ القديرِ إلهِهِم. <verse eid="HAG 1:14" /><verse number="15" style="v" pubnumber="15" sid="HAG 1:15" />في اليومِ الرَّابعِ والعِشرينَ مِنَ الشَّهرِ السَّادسِ، في السَّنةِ الثَّانيةِ لداريُّوسَ المَلكِ.<verse eid="HAG 1:15" /></para>
  <chapter eid="HAG 1" />
  <chapter number="2" style="c" sid="HAG 2" />
  <para style="s1">مجد الهيكل الجديد</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="HAG 2:1" />وفي الحادي والعِشرينَ مِنَ الشَّهرِ السَّابِعِ في تِلكَ السَّنةِ، كانت كَلِمةُ الرّبِّ على لِسانِ حَجَّايَ النَّبيِّ، قالَ: <verse eid="HAG 2:1" /><verse number="2" style="v" pubnumber="2" sid="HAG 2:2" />”قُلْ لِزَربَّابلَ بنِ شألتئيلَ حاكمِ يَهوذا، ولِيشوعَ بنِ يوصادقَ الكاهنِ العظيمِ ولِسائِرِ الشَّعبِ: <verse eid="HAG 2:2" /><verse number="3" style="v" pubnumber="3" sid="HAG 2:3" />مَنْ فيكُم، أنتُمُ الباقونَ، رأى بَيتي هذا في مَجدِهِ الأوَّلِ؟ وكيفَ ترَونَهُ الآنَ؟ أمَا هوَ في عيُونِكُم كلا شيءٍ؟ <verse eid="HAG 2:3" /><verse number="4" style="v" pubnumber="4" sid="HAG 2:4" />فالآنَ يقولُ الرّبُّ: تشدَّدْ يا زَربَّابِلُ، وتشدَّدْ يا يشوعُ، وتشدَّدوا يا جميعَ شعبِ هذِهِ الأرضِ، واَعملُوا وأنا معكُم، يقولُ الرّبُّ القديرُ، <verse eid="HAG 2:4" /><verse number="5" style="v" pubnumber="5" sid="HAG 2:5" />على حسَبِ ما عاهدْتُكُم بهِ عندَ خروجِكُم مِنْ مِصْرَ. روحي يُقيمُ فيما بَينكُم، فلا تخافوا. <verse eid="HAG 2:5" /><verse number="6" style="v" pubnumber="6" sid="HAG 2:6" />فأنا الرّبُّ القديرُ أقولُ إنِّي مرَّةً بَعدُ، عَنْ قريبٍ، أُزلزِلُ السَّماءَ والأرضَ والبحرَ والبَرَّ، <verse eid="HAG 2:6" /><verse number="7" style="v" pubnumber="7" sid="HAG 2:7" />وأُزَلزِلُ جميعَ الأُمَمِ فتأتي كنُوزُها لتملأَ هذا البَيتَ مَجدًا. <verse eid="HAG 2:7" /><verse number="8" style="v" pubnumber="8" sid="HAG 2:8" />ليَ الفِضَّةُ وليَ الذَّهبُ، يقولُ الرّبُّ القديرُ. <verse eid="HAG 2:8" /><verse number="9" style="v" pubnumber="9" sid="HAG 2:9" />وسيكونُ مَجدُ هذا البَيتِ الأخيرُ أعظمَ مِنْ مَجدِهِ الأوَّلِ. وفي هذا المَوضِعِ أُعطي السَّلامَ، يقولُ الرّبُّ القديرُ“.<verse eid="HAG 2:9" /></para>
  <para style="s1">النبي يستشير الكهنة</para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="HAG 2:10" />في الرَّابعِ والعِشرينَ مِنَ الشَّهرِ التَّاسعِ، في السَّنةِ الثَّانيةِ لداريُّوسَ، كانت كلِمةُ الرّبِّ إلى حَجَّايَ النَّبيِّ، قالَ: <verse eid="HAG 2:10" /><verse number="11" style="v" pubnumber="11" sid="HAG 2:11" />”هذا ما قالَ الرّبُّ القديرُ: إسألِ الكهَنةَ عَنْ فَتواهُم في هذِهِ المسألةِ: <verse eid="HAG 2:11" /><verse number="12" style="v" pubnumber="12" sid="HAG 2:12" />إذا حمَلَ إنسانٌ لَحمًا مُقدَّسًا في طرَفِ ثوبِهِ، ولَمسَ بطرفِهِ خُبزًا أو طبيخًا أو خمرًا أو زيتًا أو أيَّ طَعامٍ كانَ، أفَيَتقدَّسُ أيضًا؟“ فأجابَ الكهنَةُ: ”لا“. <verse eid="HAG 2:12" /><verse number="13" style="v" pubnumber="13" sid="HAG 2:13" />فقالَ حَجَّايُ: ”إذا لَمسَ المُتَنَجِّسُ بمَيتٍ شيئًا مِنْ هذِهِ الأطعمةِ، أفيَتَنجَّسُ بِها؟“ فأجابَ الكهنَةُ: ”يتنجَّسُ“. <verse eid="HAG 2:13" /><verse number="14" style="v" pubnumber="14" sid="HAG 2:14" />فقالَ حَجَّايُ: ”كذلكَ هذا الشَّعبُ وهذِهِ الأمَّةُ في نظري، وجميعُ أعمالِ أيديهم وما يُقرِّبونَهُ لي هُناكَ على المذبَحِ، فهوَ نجسٌ. <verse eid="HAG 2:14" /><verse number="15" style="v" pubnumber="15" sid="HAG 2:15" />فالآنَ تأمَّلوا في قلوبِكُم ما كانَ مِنْ أمرِكُم في الأيّامِ الماضيةِ قَبلَ أنْ يُوضَعَ حجَرٌ على حجَرٍ في هَيكلِ الرّبِّ. <verse eid="HAG 2:15" /><verse number="16" style="v" pubnumber="16" sid="HAG 2:16" />كانَ يأتي الواحدُ مِنكُم إلى كُومَةِ حِنطةٍ تزِنُ عِشرينَ فلا يَجِدُ إلَّا عشَرَةً، أو يأتي إلى المَعصرةِ لِيَغرُفَ مِنها خمسينَ كَيلًا فلا يجدُ إلَّا عِشرينَ. <verse eid="HAG 2:16" /><verse number="17" style="v" pubnumber="17" sid="HAG 2:17" />ضرَبتُكُم باللَّفْحِ والذُّبولِ والبَرَدِ في جميعِ أعمالِ أيديكُم وما تُبتُم إليَّ. <verse eid="HAG 2:17" /><verse number="18" style="v" pubnumber="18" sid="HAG 2:18" />لكنْ تأمَّلوا في قلوبِكُم ما يكونُ مِنْ أمرِكُم في الأيّامِ الآتيةِ، بَعدَ أنْ تأسَّسَ هَيكلُ الرّبِّ في الرَّابعِ والعِشرينَ مِنَ الشَّهرِ التَّاسعِ. تأمَّلوا في قلوبِكُم: <verse eid="HAG 2:18" /><verse number="19" style="v" pubnumber="19" sid="HAG 2:19" />هل في الأهراءِ حبوبٌ بَعدُ؟ هلِ الكرمُ والتِّينُ والرُّمانُ والزَّيتونُ يُثمِرُ بَعدُ؟ كلَّا. لكنِّي مِنْ هذا اليومِ أُبارِكُكُم“.<verse eid="HAG 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="HAG 2:20" />وكانت كَلِمةُ الرّبِّ ثانيةً إلى حَجَّايَ، في الرَّابعِ والعِشرينَ مِنَ الشَّهرِ، قالَ: <verse eid="HAG 2:20" /><verse number="21" style="v" pubnumber="21" sid="HAG 2:21" />”قُلْ لزربَّابِلَ حاكمِ يَهوذا إنِّي سأُزلزِلُ السَّماءَ والأرضَ <verse eid="HAG 2:21" /><verse number="22" style="v" pubnumber="22" sid="HAG 2:22" />وأقلِبُ عرشَ مَمالِكِ الأمَمِ وأُدمِّرُ قُدرتَها، وأقلِبُ المَركباتِ ورُكَّابَها، وأُسقِطُ الخيلَ وفُرسانَها، كُلُّ واحدٍ بسيفِ الآخَرِ. <verse eid="HAG 2:22" /><verse number="23" style="v" pubnumber="23" sid="HAG 2:23" />في ذلِكَ اليومِ، يقولُ الرّبُّ القديرُ، آخذُكَ يا زَربَّابِلُ بنُ شألتَئيلَ عبدي وأرسُمُكَ حاكمًا. فإنِّي اَخترتُكَ، يقولُ الرّبُّ القديرُ“.<verse eid="HAG 2:23" /></para>
  <chapter eid="HAG 2" />
</usx>