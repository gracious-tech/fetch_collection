  <para style="toc3">‏ ١أخ</para>
  <para style="toc1">أخبار الأيام الأول</para>
  <para style="toc2">‏ ١أخبار</para>
  <para style="mt1">أخبار الأيام الأول</para>
  <chapter number="1" style="c" sid="1CH 1" />
  <para style="s1">من آدم إلى إبراهيم</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="1CH 1:1" />آدمُ ولَدَ شيتًا، وشيتُ ولَدَ أنوشَ. <verse eid="1CH 1:1" /><verse number="2" style="v" pubnumber="2" sid="1CH 1:2" />أنوشُ ولَدَ قينانَ، قِينانُ ولَدَ مَهلَلْئيلَ، ومَهلَلْئيلُ ولَدَ يارَدُ. <verse eid="1CH 1:2" /><verse number="3" style="v" pubnumber="3" sid="1CH 1:3" />يارَدُ ولَدَ أخنوخَ، وأخنوخُ ولَدَ مَتوشالَحَ، ومَتوشالَحَ ولَدَ لامَكَ. <verse eid="1CH 1:3" /><verse number="4" style="v" pubnumber="4" sid="1CH 1:4" />لامَكُ ولَدَ نُوحًا، ونُوحٌ ولَدَ سامًا وحامًا ويافَثَ.<verse eid="1CH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="1CH 1:5" />بَنو يافثَ: جُومَرُ وماجُوحُ ومادايُ وياوانُ وتوبالُ وماشَكُ وتيراسُ. <verse eid="1CH 1:5" /><verse number="6" style="v" pubnumber="6" sid="1CH 1:6" />وبَنو جومَرَ: أشْكَنازُ وريفاتُ وتوجَرْمَةُ. <verse eid="1CH 1:6" /><verse number="7" style="v" pubnumber="7" sid="1CH 1:7" />وبَنو ياوانَ: أليشَةُ وتَرشيشُ وكِتِّيمُ ودُودانيمُ.<verse eid="1CH 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="1CH 1:8" />بَنو حامَ: كوشٌ ومِصْرائيمُ وفوطُ وكنعانُ. <verse eid="1CH 1:8" /><verse number="9" style="v" pubnumber="9" sid="1CH 1:9" />وبَنو كُوشٍ: سَبا وحويلَةُ وسَبْتا ورَعْما وسَبْتكا. وبَنو رَعْما: شَبا ودادانُ. <verse eid="1CH 1:9" /><verse number="10" style="v" pubnumber="10" sid="1CH 1:10" />وكوشٌ ولَدَ نَمرُودَ وهوَ أوَّلُ قائدٍ في الأرضِ.<verse eid="1CH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="1CH 1:11" />ومِصْرائيمُ ولَدَ لُوديمَ وعَنامَ ولَهابَ ونَفتُوحَ <verse eid="1CH 1:11" /><verse number="12" style="v" pubnumber="12" sid="1CH 1:12" />وفَتروسَ وكَسلوحَ وأكريتَ الّذينَ خرَجَ مِنهُمُ الفِلسطيُّونَ. <verse eid="1CH 1:12" /><verse number="13" style="v" pubnumber="13" sid="1CH 1:13" />وكنعانُ ولَدَ صيدونَ بِكْرَهُ وحِثَّا. <verse eid="1CH 1:13" /><verse number="14" style="v" pubnumber="14" sid="1CH 1:14" />وكنعانُ كانَ أيضًا أبا اليَبوسيِّينَ والأموريِّينَ والجِرجاشيِّينَ <verse eid="1CH 1:14" /><verse number="15" style="v" pubnumber="15" sid="1CH 1:15" />والحُوِّيِّينَ والعَرقيِّينَ والسِّينيِّينَ <verse eid="1CH 1:15" /><verse number="16" style="v" pubnumber="16" sid="1CH 1:16" />والأرواديِّينَ والصُّمّاريِّينَ والحُّماثيِّينَ.<verse eid="1CH 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="1CH 1:17" />بنو سامٍ: عيلامُ وأشُّورُ وأرفَكْشادُ ولُودٌ وأرامُ وعُوصٌ وحُولٌ وجاثِرُ وماشِكُ. <verse eid="1CH 1:17" /><verse number="18" style="v" pubnumber="18" sid="1CH 1:18" />وأرفَكْشادُ ولَدَ شالَحَ، وشالَحُ ولَدَ عابَرَ. <verse eid="1CH 1:18" /><verse number="19" style="v" pubnumber="19" sid="1CH 1:19" />ووُلِدَ لِعابَرَ اَبنانِ، أحدُهُما فالَجٌ لأنَّهُ في أيّامِهِ اَنقَسَمَتِ الأرضُ، والآخَرُ يَقطانُ <verse eid="1CH 1:19" /><verse number="20" style="v" pubnumber="20" sid="1CH 1:20" />ويَقطانُ ولَدَ ألمودادَ وشالَفَ وحَضرَموتَ ويارَحَ <verse eid="1CH 1:20" /><verse number="21" style="v" pubnumber="21" sid="1CH 1:21" />وهَدُورامَ وأوزالَ ودِقلَةَ <verse eid="1CH 1:21" /><verse number="22" style="v" pubnumber="22" sid="1CH 1:22" />وعيبالَ وأبيماييلَ وشَبا <verse eid="1CH 1:22" /><verse number="23" style="v" pubnumber="23" sid="1CH 1:23" />وأوفيرَ وحويلَةَ ويوبابَ.<verse eid="1CH 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="1CH 1:24" />ومِنْ سامٍ إلى أبرامَ: أرفَكْشادُ وشالَحُ <verse eid="1CH 1:24" /><verse number="25" style="v" pubnumber="25" sid="1CH 1:25" />وعابَرُ وفالَجُ ورَعُو <verse eid="1CH 1:25" /><verse number="26" style="v" pubnumber="26" sid="1CH 1:26" />وسَروجُ وناحُورُ وتارَحُ <verse eid="1CH 1:26" /><verse number="27" style="v" pubnumber="27" sid="1CH 1:27" />وأبرامُ وهوَ إبراهيمُ. <verse eid="1CH 1:27" /><verse number="28" style="v" pubnumber="28" sid="1CH 1:28" />واَبنا إبراهيمَ: إسحَقُ وإسماعيلُ.<verse eid="1CH 1:28" /></para>
  <para style="s1">مواليد إسماعيل</para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="1CH 1:29" />وهذِهِ مواليدُ إسماعيلَ: نَبايُوتُ بِكرُهُ وقيدارُ وأدبَئيلُ ومِبْسامُ <verse eid="1CH 1:29" /><verse number="30" style="v" pubnumber="30" sid="1CH 1:30" />ومِشْماعُ ودُومَةُ ومَسَّا وحَدَدُ وتيماءُ <verse eid="1CH 1:30" /><verse number="31" style="v" pubnumber="31" sid="1CH 1:31" />ويَطورُ ونافيشُ وقِدمَةُ. <verse eid="1CH 1:31" /><verse number="32" style="v" pubnumber="32" sid="1CH 1:32" />وأمَّا بَنو قطورةَ، جاريةِ إبراهيمَ، فهُم: زِمْرانُ ويُقشانُ ومَدانُ ومِديانُ ويِشباقُ وشوحٌ. واَبنا يقشانَ: شَبا وددانُ. <verse eid="1CH 1:32" /><verse number="33" style="v" pubnumber="33" sid="1CH 1:33" />وبَنو مِديانَ: عَيفَةُ وعِفْرٌ وحَنُوكُ وأبيداعُ وألدَعَةُ.<verse eid="1CH 1:33" /></para>
  <para style="s1">مواليد عيسو</para>
  <para style="p">
    <verse number="34" style="v" pubnumber="34" sid="1CH 1:34" />وولَدَ إبراهيمُ إسحَقَ. واَبنا إسحَقَ: عيسو ويَعقوبُ وهوَ إِسرائيلُ. <verse eid="1CH 1:34" /><verse number="35" style="v" pubnumber="35" sid="1CH 1:35" />وبَنو عيسو: أليفازُ ورَعوئِيلُ ويَعوشُ ويعلامُ وقورَحُ. <verse eid="1CH 1:35" /><verse number="36" style="v" pubnumber="36" sid="1CH 1:36" />وبَنو أليفازَ: تَيمانُ وأومارُ وصَفيٌ وجَعثامُ وقَنازُ وتِمناعُ وعَماليقُ. <verse eid="1CH 1:36" /><verse number="37" style="v" pubnumber="37" sid="1CH 1:37" />وبَنو رَعوئيلَ: نَحْتُ وزارَحُ وشَمَّةُ ومِزَّةُ.<verse eid="1CH 1:37" /></para>
  <para style="s1">سكان أدوم</para>
  <para style="p">
    <verse number="38" style="v" pubnumber="38" sid="1CH 1:38" />وبَنو سعيرَ: لوطانُ وشوبالُ وصِبعونُ وعانَةُ وديشونُ وإيصَرُ وديشانُ. <verse eid="1CH 1:38" /><verse number="39" style="v" pubnumber="39" sid="1CH 1:39" />واَبنا لوطانَ: حُوري وهومامُ. وأختُ لوطانَ: تِمناعُ. <verse eid="1CH 1:39" /><verse number="40" style="v" pubnumber="40" sid="1CH 1:40" />وبَنو شُوبالَ: عَليانُ ومناحَةُ وعيبالُ وشفيٌ وأونامُ. واَبنا صِبعونَ: أيَّةُ وعانَةُ. <verse eid="1CH 1:40" /><verse number="41" style="v" pubnumber="41" sid="1CH 1:41" />واَبنُ عانَةَ: ديشونُ. وبَنو ديشونَ: حَمرانُ وأشبانُ ويثرانُ وكَرانُ. <verse eid="1CH 1:41" /><verse number="42" style="v" pubnumber="42" sid="1CH 1:42" />وبَنو إيصَرَ: بِلْهانُ وزَعوانُ ويَعقانُ. واَبنا ديشانَ: عُوصٌ وأرانُ.<verse eid="1CH 1:42" /></para>
  <para style="s1">ملوك أدوم</para>
  <para style="p">
    <verse number="43" style="v" pubnumber="43" sid="1CH 1:43" />هؤلاءِ المُلوكُ مَلَكُوا في أرضِ أدومَ على التَّوالي، قَبلَ أنْ يَملِكَ مَلِكٌ في بَني إِسرائيلَ: بالِعُ بنُ بَعورَ مِنْ دِنهابة، <verse eid="1CH 1:43" /><verse number="44" style="v" pubnumber="44" sid="1CH 1:44" />ويوبابُ بنُ زارَحَ مِنْ بَصرَةَ، <verse eid="1CH 1:44" /><verse number="45" style="v" pubnumber="45" sid="1CH 1:45" />وماتَ يوبابُ، وملَكَ بَعدَهُ حوشامُ مِنْ أرضِ التِّيمانيِّينَ، <verse eid="1CH 1:45" /><verse number="46" style="v" pubnumber="46" sid="1CH 1:46" />وهَدَدُ بنُ بَدَدَ مِنْ عَويتَ وهوَ الّذي هزَمَ المِديانيِّينَ في بلادِ موآبَ، <verse eid="1CH 1:46" /><verse number="47" style="v" pubnumber="47" sid="1CH 1:47" />وماتَ هَدَدُ، وملَكَ بَعدَهُ سَملَةُ مِنْ مَسريقَةَ، <verse eid="1CH 1:47" /><verse number="48" style="v" pubnumber="48" sid="1CH 1:48" />ومات سَملَةُ، فَمَلَكَ بَعدَهُ شاوُلُ مِنْ رَحبوتَ على الفُراتِ، <verse eid="1CH 1:48" /><verse number="49" style="v" pubnumber="49" sid="1CH 1:49" />وماتَ شاوُلُ فمَلَكَ بَعدَهُ بَعلَ حَنانُ بنُ عكْبورَ، <verse eid="1CH 1:49" /><verse number="50" style="v" pubnumber="50" sid="1CH 1:50" />وماتَ بَعلَ حَنانُ، فمَلَكَ بَعدَهُ هَدَدُ مِنْ فاعي، واَسمُ اَمرأتِهِ مَهيطبيلُ بِنتُ مَطرِدَ بِنتِ ميزَهَبَ.<verse eid="1CH 1:50" /></para>
  <para style="p">
    <verse number="51" style="v" pubnumber="51" sid="1CH 1:51" />وأُمراءُ أدومَ: تِمناعُ وعَلوَةُ ويَتيتُ <verse eid="1CH 1:51" /><verse number="52" style="v" pubnumber="52" sid="1CH 1:52" />وأهوليبامَةُ وإيلَةُ فينونَ <verse eid="1CH 1:52" /><verse number="53" style="v" pubnumber="53" sid="1CH 1:53" />وقَنازُ وتيمانُ ومِبصارُ <verse eid="1CH 1:53" /><verse number="54" style="v" pubnumber="54" sid="1CH 1:54" />ومَجديئيلُ وعيرامُ.<verse eid="1CH 1:54" /></para>
  <chapter eid="1CH 1" />
  <chapter number="2" style="c" sid="1CH 2" />
  <para style="s1">مواليد يهوذا</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="1CH 2:1" />وهؤلاءِ بَنو يَعقوبَ: رَأوبينُ وشِمعونُ ولاويُّ ويَهوذا ويسَّاكَرُ وزَبولونُ <verse eid="1CH 2:1" /><verse number="2" style="v" pubnumber="2" sid="1CH 2:2" />ودانُ ويوسُفُ وبنيامينُ ونَفتالي وجادُ وأشيرُ. <verse eid="1CH 2:2" /><verse number="3" style="v" pubnumber="3" sid="1CH 2:3" />وبَنو يَهوذا: عيرُ وأونانُ وشيلَةُ الّذينَ ولَدَتْهُم لَه بِنتُ شُوعَ الكنعانيَّةُ. وكانَ عيرُ بِكْرُ يَهوذا شرِّيرًا في نظَرِ الرّبِّ فأماتَهُ. <verse eid="1CH 2:3" /><verse number="4" style="v" pubnumber="4" sid="1CH 2:4" />وولَدَت لَه تامارُ كَنَّتُهُ فارصَ وزارَحَ. فجميعُ بَني يَهوذا خمسةٌ.<verse eid="1CH 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="1CH 2:5" />واَبنا فارَصَ: حصرونُ وحامولُ. <verse eid="1CH 2:5" /><verse number="6" style="v" pubnumber="6" sid="1CH 2:6" />وبَنو زارَحَ: زِمري وأيثانُ وهَيمانُ وكلكُولُ ودارَعُ. <verse eid="1CH 2:6" /><verse number="7" style="v" pubnumber="7" sid="1CH 2:7" />واَبنُ كرمي: عاكارُ الّذي عكَّرَ صَفوَ بَني إِسرائيلَ لأنَّهُ اَحتَفَظَ لِنفْسِهِ بِغَنيمةٍ حَرامٍ. <verse eid="1CH 2:7" /><verse number="8" style="v" pubnumber="8" sid="1CH 2:8" />واَبنُ أيثانَ: عزَرْيا.<verse eid="1CH 2:8" /></para>
  <para style="s1">نسب داود</para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="1CH 2:9" />وبَنو حصرونَ: يَرحَمْئيلُ ورامُ وكُلُوبايُ. <verse eid="1CH 2:9" /><verse number="10" style="v" pubnumber="10" sid="1CH 2:10" />ومِنْ رامَ إلى يَسَّى: عَمِّينادابُ <verse eid="1CH 2:10" /><verse number="11" style="v" pubnumber="11" sid="1CH 2:11" />ونحشونُ رئيسُ بَني يَهوذا، وسَلْمُو وبوعَزُ <verse eid="1CH 2:11" /><verse number="12" style="v" pubnumber="12" sid="1CH 2:12" />وعُوبيدُ ويَسَّى.<verse eid="1CH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="1CH 2:13" />ويَسَّى ولَدَ سبعةَ بَنينَ هُم حسَبَ أعمارِهِم: أليابُ وأبينادابُ وشِمعا <verse eid="1CH 2:13" /><verse number="14" style="v" pubnumber="14" sid="1CH 2:14" />ونثَنَئيلُ ورَدَّايُ <verse eid="1CH 2:14" /><verse number="15" style="v" pubnumber="15" sid="1CH 2:15" />وأوصَمُ وداوُدُ. <verse eid="1CH 2:15" /><verse number="16" style="v" pubnumber="16" sid="1CH 2:16" />وأُختاهُم صَرويَّةُ وأبيجايِلُ. وبَنو صَرويَّةَ: أبشايُ ويوآبُ وعَسائيلُ. <verse eid="1CH 2:16" /><verse number="17" style="v" pubnumber="17" sid="1CH 2:17" />وأبيجايلُ ولَدَت عَماسا بنَ يَثْرا الإسماعيليِّ.<verse eid="1CH 2:17" /></para>
  <para style="s1">مواليد حصرون</para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="1CH 2:18" />وكالَبُ بنُ حصرونَ ولَدَ مِنْ عَزُوبَةَ اَمرأتِهِ اَبنَةً اَسمُها يريعوثُ وثَلاثَةَ بَنينَ هُم: ياشَرُ وشوبابُ وأردونُ. <verse eid="1CH 2:18" /><verse number="19" style="v" pubnumber="19" sid="1CH 2:19" />وماتَت عَزُوبَةُ فتَزَوَّجَ كالَبُ أفراتَةَ، فوَلَدَت لَه حُورًا، <verse eid="1CH 2:19" /><verse number="20" style="v" pubnumber="20" sid="1CH 2:20" />وحُورٌ ولَدَ أوري، وأوري ولَدَ بَصَلْئيلَ. <verse eid="1CH 2:20" /><verse number="21" style="v" pubnumber="21" sid="1CH 2:21" />ثُمَّ تزَوَّجَ حصرونُ بِنتَ ماكيرَ أبي جلعادَ، وهوَ اَبنُ سِتِّينَ سنَةً، فولَدَت لَه سَجوبَ. <verse eid="1CH 2:21" /><verse number="22" style="v" pubnumber="22" sid="1CH 2:22" />وسَجوبُ ولَدَ يائيرَ. وكانَت لَه ثلاثٌ وعشرونَ مدينةً في أرضِ جلعادَ. <verse eid="1CH 2:22" /><verse number="23" style="v" pubnumber="23" sid="1CH 2:23" />ثُمَّ أخَذَ مِنْ جَشُّورَ وآرامَ سِتِّينَ مدينةً، ومنها قُرى يائيرُ وقَناتُ وتوابِعُها. فهذا كُلُّه لِبَني ماكيرَ أبي جلعادَ. <verse eid="1CH 2:23" /><verse number="24" style="v" pubnumber="24" sid="1CH 2:24" />وبَعدَ وفاةِ حصرونَ تزَوَّجَ كالَبُ اَبنَةَ أفراتَةَ اَمرأةِ أبيهِ، فَولَدَت لَه أشحورَ أبا تَقُوعَ.<verse eid="1CH 2:24" /></para>
  <para style="s1">مواليد يرحمئيل</para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="1CH 2:25" />وبَنو يَرحَمْئيلَ بِكْرِ حصرونَ: رامُ بِكْرُه، وبونَةُ وأورَنُ وأوصَمُ وأخيَّا. <verse eid="1CH 2:25" /><verse number="26" style="v" pubnumber="26" sid="1CH 2:26" />وكانَ ليَرحَمْئيلَ اَمرأةٌ أُخرى اَسمُها عَطارَةُ، فولَدَت لَه أونامَ. <verse eid="1CH 2:26" /><verse number="27" style="v" pubnumber="27" sid="1CH 2:27" />وبَنو رامَ: مَعْصٌ ويَمينُ وعاقَرُ. <verse eid="1CH 2:27" /><verse number="28" style="v" pubnumber="28" sid="1CH 2:28" />واَبنا أونامَ: شَمَّايُ وياداعُ. واَبنا شمَّاي: نادابُ وأبيشورُ. <verse eid="1CH 2:28" /><verse number="29" style="v" pubnumber="29" sid="1CH 2:29" />واَسمُ اَمرأةِ أبيشورَ أبيجايلُ الّتي ولَدَت لَه أحبانَ ومُوليدَ. <verse eid="1CH 2:29" /><verse number="30" style="v" pubnumber="30" sid="1CH 2:30" />واَبنا نادابَ: سالَدٌ وأفَّايمُ. وماتَ سالَدُ بِلا بَنينَ. <verse eid="1CH 2:30" /><verse number="31" style="v" pubnumber="31" sid="1CH 2:31" />واَبنُ أفَّايمَ: يَشْعي، واَبنُ يَشْعي: شيشانُ، واَبنُ شيشانَ: أحلايُ. <verse eid="1CH 2:31" /><verse number="32" style="v" pubnumber="32" sid="1CH 2:32" />واَبنا ياداعَ، أخي شَمَّايَ: يَثَرُ ويوناثانُ. وماتَ يَثَرُ بِلا بَنينَ. <verse eid="1CH 2:32" /><verse number="33" style="v" pubnumber="33" sid="1CH 2:33" />واَبنا يوناثانَ: فالَتٌ وزازا. هؤلاءِ هُم بَنو يَرحَمئيلَ. <verse eid="1CH 2:33" /><verse number="34" style="v" pubnumber="34" sid="1CH 2:34" />ولم يكُنْ لِشيشانَ بَنونَ بل بَناتٌ. وكانَ لِشيشانَ عَبدٌ مِصْريٌّ اَسمُهُ يَرحَعُ، <verse eid="1CH 2:34" /><verse number="35" style="v" pubnumber="35" sid="1CH 2:35" />فزَوَّجَهُ اَبنَتَهُ، فولَدَت لَه عَتَّايَ. <verse eid="1CH 2:35" /><verse number="36" style="v" pubnumber="36" sid="1CH 2:36" />ومِنْ عَتَّايَ إلى أليشَمَعَ: ناثانُ <verse eid="1CH 2:36" /><verse number="37" style="v" pubnumber="37" sid="1CH 2:37" />وزابادُ وأفلالُ وعوبيدُ <verse eid="1CH 2:37" /><verse number="38" style="v" pubnumber="38" sid="1CH 2:38" />وياهو وعزَرْيا <verse eid="1CH 2:38" /><verse number="39" style="v" pubnumber="39" sid="1CH 2:39" />وحالَصُ وإلعاسَةُ <verse eid="1CH 2:39" /><verse number="40" style="v" pubnumber="40" sid="1CH 2:40" />وسِسْمايُ وشَلُّومُ <verse eid="1CH 2:40" /><verse number="41" style="v" pubnumber="41" sid="1CH 2:41" />ويَقَميَّةُ وأليشَمَعُ.<verse eid="1CH 2:41" /></para>
  <para style="s1">سائر مواليد كالب</para>
  <para style="p">
    <verse number="42" style="v" pubnumber="42" sid="1CH 2:42" />وبَنو كالَبَ، أخي يَرحَمْئيلَ: ميشاعُ بِكْرُهُ، وهوَ أبو زيفَ. واَبنُ ميشاعَ: مَريشَةُ، وهوَ أبو حبرونَ. <verse eid="1CH 2:42" /><verse number="43" style="v" pubnumber="43" sid="1CH 2:43" />وبَنو حبرونَ: قورَحُ وتَفُّوحُ وراقَمُ وشامَعُ. <verse eid="1CH 2:43" /><verse number="44" style="v" pubnumber="44" sid="1CH 2:44" />وشامَعُ ولَدَ راقَمَ، وهوَ أبو يَرُقْعامَ. وراقَمُ ولَدَ شَمَّايَ. <verse eid="1CH 2:44" /><verse number="45" style="v" pubnumber="45" sid="1CH 2:45" />وشَمَّايُ ولَدَ مَعُونَ، وهوَ أبو بَيتِ صورَ.<verse eid="1CH 2:45" /></para>
  <para style="p">
    <verse number="46" style="v" pubnumber="46" sid="1CH 2:46" />وكانَ لِكالَبَ جاريَةٌ اَسمُها عيفَةُ، فولَدَت لَه حارانَ وموصا وجازيزَ. وحارانُ ولَدَ جازيزَ. <verse eid="1CH 2:46" /><verse number="47" style="v" pubnumber="47" sid="1CH 2:47" />وبَنو يَهدايَ: راجَمُ ويوثامُ وجيشانُ وفَلَطُ وعيفَةُ وشاعَفُ. <verse eid="1CH 2:47" /><verse number="48" style="v" pubnumber="48" sid="1CH 2:48" />وأمَّا مَعكةُ جاريةُ كالَبَ الأخرَى، فولَدَت لَه شَبَرَ وتَرحَنَةَ. <verse eid="1CH 2:48" /><verse number="49" style="v" pubnumber="49" sid="1CH 2:49" />ثُمَّ ولَدَت شاعَفَ، وهوَ أبو مَدمَنَّةَ، وشَوَا، وهوَ أبو مكْبينا وأبو جَبَعا. وكانَ لِكالَبَ أيضًا اَبنَةٌ اَسمُها عكسةُ.<verse eid="1CH 2:49" /></para>
  <para style="p">
    <verse number="50" style="v" pubnumber="50" sid="1CH 2:50" />وهؤلاءِ أيضًا بَنو كالَبَ: حُورُ بِكْرُهُ مِنِ اَمرأتِهِ أفراتَةَ. وحُورُ ولَدَ شوبالَ باني قَريَةِ يَعاريمَ، <verse eid="1CH 2:50" /><verse number="51" style="v" pubnumber="51" sid="1CH 2:51" />وسَلْما باني بَيتَ لَحمَ، وحاريفَ باني بَيتَ جاديرَ. <verse eid="1CH 2:51" /><verse number="52" style="v" pubnumber="52" sid="1CH 2:52" />وبَنو شوبالَ، باني قريَةِ يَعاريمَ: هَرُواهُ، أي نِصفَ سُكَّانِ مَنوحوتَ <verse eid="1CH 2:52" /><verse number="53" style="v" pubnumber="53" sid="1CH 2:53" />وعشائِرُ قريةِ يَعاريمَ: اليَثريُّونَ والفُوتيُّونَ والشَّماتيُّونَ والمِشراعيُّونَ. ومِنْ هؤلاءِ خرَجَ الصَرْعيُّونَ والأشتاؤوليُّونَ. <verse eid="1CH 2:53" /><verse number="54" style="v" pubnumber="54" sid="1CH 2:54" />وبَنو سلْما، باني قريةِ بَيتَ لَحمَ: النَّطوفاتيُّونَ وعَطْروتُ بَيتِ يوآبَ والصَّرعيُّونَ الّذينَ هُم إحدى عَشيرَتَي مَنوحوتَ. <verse eid="1CH 2:54" /><verse number="55" style="v" pubnumber="55" sid="1CH 2:55" />وعشائِرُ الصَّفُّوريِّينَ سُكَّانِ يَعبيصَ: التَّرعيُّونَ والشَّمعيُّونَ والسُّوكيُّونَ، وهُم القَينيُّونَ الّذينَ جاؤُوا مِنْ حَمَّةَ وتَحَدَّرَ مِنهُم الرَّكابيُّونَ.<verse eid="1CH 2:55" /></para>
  <chapter eid="1CH 2" />
  <chapter number="3" style="c" sid="1CH 3" />
  <para style="s1">بنو داود</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="1CH 3:1" />هؤلاءِ بَنو داوُدَ الّذينَ وُلِدوا لَه في حبرونَ، بِحَسَبِ أعمارِهِم: أمنونُ بِكْرُهُ مِنْ أخينوعَمَ اليَزرعيليَّةِ، ودانِئيلُ مِنْ أبيجايِلَ الكرمليَّةِ، <verse eid="1CH 3:1" /><verse number="2" style="v" pubnumber="2" sid="1CH 3:2" />وأبشالومُ اَبنُ مَعكةَ بِنتِ تَلمايَ مَلِكِ جَشورَ، وأدونيَّا مِنْ حَجِّيثَ، <verse eid="1CH 3:2" /><verse number="3" style="v" pubnumber="3" sid="1CH 3:3" />وشَفَطيا مِنْ أبيطالَ، ويَثَرعامُ مِنْ عَجْلَةَ اَمرأتِهِ. <verse eid="1CH 3:3" /><verse number="4" style="v" pubnumber="4" sid="1CH 3:4" />هؤلاءِ السِتَّةُ وُلِدوا لَه في حبرونَ، حَيثُ ملَكَ سَبْعَ سنينَ وسِتَّةَ أشهرٍ. وملَكَ ثَلاثًا وثَلاثينَ سنَةً في أورُشليمَ. <verse eid="1CH 3:4" /><verse number="5" style="v" pubnumber="5" sid="1CH 3:5" />وهُناكَ ولَدَت لَه بَتشوعُ بِنتُ عَمِّيئيلَ أربَعةَ بَنينَ: شِمْعا وشوبابَ وناثانَ وسليمانَ. <verse eid="1CH 3:5" /><verse number="6" style="v" pubnumber="6" sid="1CH 3:6" />وكانَ لَه تِسعَةُ بَنينَ: يبحارُ وأليشامَعُ وأليفالَطُ <verse eid="1CH 3:6" /><verse number="7" style="v" pubnumber="7" sid="1CH 3:7" />ونوجَهُ ونافَجُ ويافيعُ <verse eid="1CH 3:7" /><verse number="8" style="v" pubnumber="8" sid="1CH 3:8" />وأليشَمَعُ وألياداعُ وأليفَلَطُ. <verse eid="1CH 3:8" /><verse number="9" style="v" pubnumber="9" sid="1CH 3:9" />هؤلاءِ كُلُّهُم وأُختُهم تامارُ وُلِدوا لِداوُدَ، ما عدا الّذينَ ولَدَتْهُم لَه جَواريهِ.<verse eid="1CH 3:9" /></para>
  <para style="s1">مواليد الملك سليمان</para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="1CH 3:10" />وهذِهِ مواليدُ المَلِكِ سليمانَ: أبًا لاَبنٍ: رحَبعامُ وأبيَّا وآسا ويوشافاطُ <verse eid="1CH 3:10" /><verse number="11" style="v" pubnumber="11" sid="1CH 3:11" />ويورامُ وأخَزْيا ويُوآشُ <verse eid="1CH 3:11" /><verse number="12" style="v" pubnumber="12" sid="1CH 3:12" />وأمَصْيا وعزَرْيا ويوثامُ <verse eid="1CH 3:12" /><verse number="13" style="v" pubnumber="13" sid="1CH 3:13" />وآحازُ وحَزْقِيَّا ومنَسَّى <verse eid="1CH 3:13" /><verse number="14" style="v" pubnumber="14" sid="1CH 3:14" />وآمونُ ويوشيَّا. <verse eid="1CH 3:14" /><verse number="15" style="v" pubnumber="15" sid="1CH 3:15" />وبَنو يُوشيَّا: يوحانانُ بِكْرُه، ويوياقيمُ وصِدقيَّا وشَلُّومُ. <verse eid="1CH 3:15" /><verse number="16" style="v" pubnumber="16" sid="1CH 3:16" />واَبنا يوياقيمَ: يَكُنيا وصِدْقيَّا.<verse eid="1CH 3:16" /></para>
  <para style="s1">مواليد الملك يوياقيم</para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="1CH 3:17" />واَبنُ يَكُنيا الّذي أسَرَهُ البابليُّونَ: شألتِئيلُ. <verse eid="1CH 3:17" /><verse number="18" style="v" pubnumber="18" sid="1CH 3:18" />وبَنو شألتِئيلَ: مَلكيرامُ وفدايا وشِنأصَّرُ ويَقَميَّةُ وهوشاماعُ ونَدَبْيا. <verse eid="1CH 3:18" /><verse number="19" style="v" pubnumber="19" sid="1CH 3:19" />واَبنا فدايا: زَرُبَّابِلُ وشِمْعي. واَبنا زَرُبَّابِلَ: مَشُلَّامُ وحَنَنْيا، وأُختُهُما شلوميَةُ. <verse eid="1CH 3:19" /><verse number="20" style="v" pubnumber="20" sid="1CH 3:20" />وبَنوهُ الخمسةُ الآخَرونَ: حَشُوبَةُ وأوهَلُ وبَرَخْيا وحسَدْيا ويوشَبُ حاسَدَ.<verse eid="1CH 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="1CH 3:21" />واَبنُ حَنَنيا: فلَطْيا، واَبنُ فلَطْيا: يِشْعِيا، واَبنُ يِشْعِيا: رَفايا، واَبنُ رَفايا: أرْنانُ، واَبنُ أرْنانَ: عُوبَدْيا، واَبنُ عوبَدْيا: شَكُنيا، <verse eid="1CH 3:21" /><verse number="22" style="v" pubnumber="22" sid="1CH 3:22" />وبَنو شَكُنيا: شَمْعِيا وحَطُّوشُ ويَجآلُ وباريحُ ونَعَرْيا وشافاطُ. <verse eid="1CH 3:22" /><verse number="23" style="v" pubnumber="23" sid="1CH 3:23" />وبَنو نَعَرْيا: أليُوعينيُّ وحَزْقِيَّا وعَزريقامُ. <verse eid="1CH 3:23" /><verse number="24" style="v" pubnumber="24" sid="1CH 3:24" />وبَنو أليُوعينيِّ سبعةٌ: هودويا وألياشيبُ وفلايا وعَقُّوبُ ويوحانانُ ودَلايا وعَناني.<verse eid="1CH 3:24" /></para>
  <chapter eid="1CH 3" />
  <chapter number="4" style="c" sid="1CH 4" />
  <para style="s1">مواليد يهوذا</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="1CH 4:1" />وبَنو يَهوذا: فارَصُ وحصرونُ وكَرمي وحُورُ وشوبالُ. <verse eid="1CH 4:1" /><verse number="2" style="v" pubnumber="2" sid="1CH 4:2" />واَبنُ شوبالَ: رآيا ولَدَ يَحَثَ، ويَحَثَ ولَدَ أخومايَ ولاهدَ. هذِهِ عشائِرُ الصَّرْعيِّينَ. <verse eid="1CH 4:2" /><verse number="3" style="v" pubnumber="3" sid="1CH 4:3" />وهؤلاءِ بَنو عيطَمَ: يَزرَعيلُ ويَشْما ويَدْباشُ، واَسمُ أُختِهِم هَصَّلَلفوني. <verse eid="1CH 4:3" /><verse number="4" style="v" pubnumber="4" sid="1CH 4:4" />وفنوئيلُ بَنى مدينةَ جَدورَ، وعازَرُ بَنى حُوشَةَ، وهُما اَبنا حُورَ بِكْرِ أفراتَةَ الّذي بَنى بَيتَ لَحمَ.<verse eid="1CH 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="1CH 4:5" />وكانَ لأشحورَ باني تَقوعَ اَمرأتانِ هُما: حَلاةُ ونَعرَةُ. <verse eid="1CH 4:5" /><verse number="6" style="v" pubnumber="6" sid="1CH 4:6" />فولَدَت لَه نَعرَةُ أخُزَّامَ وحافَرَ وتَيمانيَّ وأخشَتاريّ. <verse eid="1CH 4:6" /><verse number="7" style="v" pubnumber="7" sid="1CH 4:7" />وولَدَت لَه حَلاةُ صَرَتَ وصوحَرَ وأثنانَ. <verse eid="1CH 4:7" /><verse number="8" style="v" pubnumber="8" sid="1CH 4:8" />وكانَ قوصُ أبا عانوبَ وهَصوبيبَةَ وعشائر أخَرحيلَ بنِ هارُمَ. <verse eid="1CH 4:8" /><verse number="9" style="v" pubnumber="9" sid="1CH 4:9" />وكانَ يعبيصُ أشهَرَ إخوَتِهِ، وسَمَّتْهُ أمُّهُ يعبيصَ لأنَّها قالَت في نفْسِها: ”ولَدْتُهُ بِحزنٍ“. <verse eid="1CH 4:9" /><verse number="10" style="v" pubnumber="10" sid="1CH 4:10" />وصلَّى يعبيصُ إلى إلهِ إِسرائيلَ: ”بارِكْني، ووَسِّعْ أرضي، لِتكُنْ يَدُكَ معي، ولَتحَفظْني مِنَ الشَّرِّ لِئلَّا أشقَى“. فاَسْتجابَ اللهُ لِصلاتِهِ.<verse eid="1CH 4:10" /></para>
  <para style="s1">عشائر أخرى</para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="1CH 4:11" />وكَلوبُ أخو شوحَةَ ولَدَ مَحيرَ، وهوَ أبو أشتونَ. <verse eid="1CH 4:11" /><verse number="12" style="v" pubnumber="12" sid="1CH 4:12" />وأشتونُ ولَدَ بَيتَ رافا وفاسِحَ وتَحِنَّةَ باني مدينةِ ناحاشَ. هؤلاءِ أهلُ رَيكَةَ. <verse eid="1CH 4:12" /><verse number="13" style="v" pubnumber="13" sid="1CH 4:13" />وقَنازُ ولَدَ عُثنئيلَ وساراي، وعُثنئيلُ ولَدَ حثاتَ. <verse eid="1CH 4:13" /><verse number="14" style="v" pubnumber="14" sid="1CH 4:14" />ومَعونوثايُ ولَدَ عَفرَةَ، وسارايُ ولَدَ يُوآبَ باني جيهاراشيمَ، أي وادي الصُّنَّاعِ، لأنَّهم كانوا صُنَّاعًا. <verse eid="1CH 4:14" /><verse number="15" style="v" pubnumber="15" sid="1CH 4:15" />وبَنو كالَبَ بنِ يَفُنَّةَ: عيرُو وأيلَةُ وناعِمُ. وأيلَةُ ولَدَ قَنازَ. <verse eid="1CH 4:15" /><verse number="16" style="v" pubnumber="16" sid="1CH 4:16" />وبَنو يَهلَلئيلَ: زيفُ وزيفَةُ وثيريَّا وأسرَئيلُ. <verse eid="1CH 4:16" /><verse number="17" style="v" pubnumber="17" sid="1CH 4:17" />وبَنو عَزرَةَ: يَثُرُ ومَرَدُ وعافِرُ ويالونُ. وتزَوَّجَ مَرَدُ بِثيَةَ فولَدَت مِيريام وشَمَّايَ ويِشبَحَ باني مدينةِ أشتَموعَ. <verse eid="1CH 4:17" /><verse number="18" style="v" pubnumber="18" sid="1CH 4:18" />هؤلاءِ بَنو بِثيَةَ بِنتِ فِرعَونَ. وولَدَت طارَدُ، اَمرأتُه اليهوديَّةُ، يارَدَ باني مدينةِ جَدورَ، وحابَرَ باني سُوكُو، ويَقوتيئيلَ باني زانوحَ.<verse eid="1CH 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="1CH 4:19" />وتزَوَّجَ هُوديا أُختَ نَحَمَ، وإليهِما تَنتَسِبُ عَشيرَةُ جَرْمَ في قَعيلَةَ وعَشيرَةُ مَعكةَ في أشتَموعَ. <verse eid="1CH 4:19" /><verse number="20" style="v" pubnumber="20" sid="1CH 4:20" />وبَنو شيمونَ: أمنونُ ورِنَّةُ وبُنحانانُ وتيلونُ. واَبنا يِشْعي: زوحَيتُ وبَنزوحَيتُ.<verse eid="1CH 4:20" /></para>
  <para style="s1">مواليد شيلة</para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="1CH 4:21" />وبَنو شيلَةَ بنِ يَهوذا: عيرُ باني مدينةِ لَيكةَ، ولَعدَةَ باني مَريشةَ، وعشائِرُ ناسجي الكتَّانِ مِنْ مدينةِ بَيتَ أشبيعَ، <verse eid="1CH 4:21" /><verse number="22" style="v" pubnumber="22" sid="1CH 4:22" />ويوقيمُ وأهلُ مدينةِ كزيبا، ويوآشُ وسارافُ الّذينَ تَزَوَّجُوا نِساءً مُوآبيَّاتٍ وسكَنوا في بَيتَ لَحمَ. وهذِهِ كُلُّها أحداثٌ قديمةٌ. <verse eid="1CH 4:22" /><verse number="23" style="v" pubnumber="23" sid="1CH 4:23" />هؤلاءِ هُمُ الخزَّافونَ الّذينَ أقاموا معَ المَلِكِ في نَتاعيمَ وجديرَةَ وعَمِلوا في خِدمتِهِ.<verse eid="1CH 4:23" /></para>
  <para style="s1">مواليد شمعون</para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="1CH 4:24" />وبَنو شِمعونَ: نَموئيلُ ويامينُ ويريبُ وزارحُ وشاوُلُ. <verse eid="1CH 4:24" /><verse number="25" style="v" pubnumber="25" sid="1CH 4:25" />وشاوُلُ ولَدَ شَلُّومَ، وشَلُّومُ ولَدَ مِبسامَ، ومِبسامُ ولَدَ مِشْماعَ. <verse eid="1CH 4:25" /><verse number="26" style="v" pubnumber="26" sid="1CH 4:26" />ومِشماعُ ولَدَ حَمُوئيلَ وحَموئيلُ ولَدَ زَكُّورَ، وزَكُّورُ ولَدَ شِمعي. <verse eid="1CH 4:26" /><verse number="27" style="v" pubnumber="27" sid="1CH 4:27" />وكانَ لِشِمعي ستَّةَ عشَرَ اَبنًا وستُّ بَناتٍ. ولم يكُنْ لإِخوتِهِ بَنونَ كثيرونَ، وعشائِرُهُم لم تكثُرْ كما كثُرَ بَنو يَهوذا. <verse eid="1CH 4:27" /><verse number="28" style="v" pubnumber="28" sid="1CH 4:28" />وكانوا يسكنونَ في بِئرَ سَبْعَ ومُولادَةَ وحَصَرِ شوعالَ <verse eid="1CH 4:28" /><verse number="29" style="v" pubnumber="29" sid="1CH 4:29" />وبَلْهَةَ وعاصِمَ وتُولادَ <verse eid="1CH 4:29" /><verse number="30" style="v" pubnumber="30" sid="1CH 4:30" />وبَتوئيلَ وحُرمَةَ وصِقلَغَ <verse eid="1CH 4:30" /><verse number="31" style="v" pubnumber="31" sid="1CH 4:31" />وبَيتَ مَركَبوتَ وحَصَرَ سوسيمَ. وبَيتَ بِرْئي وشَعَرايمَ: هذِهِ مُدُنُهم إلى عَهدِ المَلِكِ داوُدَ. <verse eid="1CH 4:31" /><verse number="32" style="v" pubnumber="32" sid="1CH 4:32" />وقُراهُم خَمْسٌ وهيَ: عَيطَمُ وعَينُ رمونَ وتُوكنُ وعاشانُ <verse eid="1CH 4:32" /><verse number="33" style="v" pubnumber="33" sid="1CH 4:33" />والمَزارِعُ الّتي حَولَها إلى بَلدةِ بَعالَةَ. هذِهِ مَساكِنُهُم وأنسابُهُم.<verse eid="1CH 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" pubnumber="34" sid="1CH 4:34" />وأمَّا مَشوبابُ ويَمليكُ ويوشا بنُ أمَصْيا، <verse eid="1CH 4:34" /><verse number="35" style="v" pubnumber="35" sid="1CH 4:35" />ويوئيلُ وياهو بنُ يُوشيبيا بنِ سَرايا بنِ عَسيئيلَ <verse eid="1CH 4:35" /><verse number="36" style="v" pubnumber="36" sid="1CH 4:36" />وأليوعينايُ ويَعقوبا ويَشوحايا وعَسايا وعَدِيئيلُ ويَسِمِئيلُ وبَنايا <verse eid="1CH 4:36" /><verse number="37" style="v" pubnumber="37" sid="1CH 4:37" />وزَيزا بنُ شِفعي بنِ ألُونَ بنِ بَدايا بنِ شِمْري بنِ شَمْعيا، <verse eid="1CH 4:37" /><verse number="38" style="v" pubnumber="38" sid="1CH 4:38" />فهُم رؤساءُ عشائِرِهِم وعائِلاتِهِمِ الّذينَ تكاثَروا، <verse eid="1CH 4:38" /><verse number="39" style="v" pubnumber="39" sid="1CH 4:39" />فاَمتَدُّوا غربًا إلى مَدخَلِ جَدورَ سَعيًا وراءَ مرعًى لِماشيَتِهِم شرقيَّ الوادي، <verse eid="1CH 4:39" /><verse number="40" style="v" pubnumber="40" sid="1CH 4:40" />فصادَفوا مرعًى خصيبًا صالحًا، وأرضًا وسيعَةً، هادئَةً وآمنَةً، سكَنَها بَنو حامَ قديمًا.<verse eid="1CH 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" pubnumber="41" sid="1CH 4:41" />وفي أيّامِ حَزْقِيَّا مَلِكِ يَهوذا، جاءَ هؤلاءِ الشِّمعونيُّونَ المذكورَةُ أسماؤُهُم إلى جَدورَ. فهَدَموا خيامَ السَّاكنينَ هُناكَ مِنَ المَعُونيِّينَ وأبادوهُم وسكَنوا في أماكِنِهم إلى هذا اليومِ، لأنَّهُم وجَدوا مرعًى لِماشيتهِم. <verse eid="1CH 4:41" /><verse number="42" style="v" pubnumber="42" sid="1CH 4:42" />وذهَبَ خَمْسُ مئَةِ رَجُلٍ مِنْ بَني شِمعونَ شرقًا إلى جبَلِ سَعيرَ وعلى رأسِهِم بَنو يِشعِي: فَلْطيا ونَعْريا ورفايا وعُزِّيئيلُ، <verse eid="1CH 4:42" /><verse number="43" style="v" pubnumber="43" sid="1CH 4:43" />فقَتَلوا مَنْ نَجا مِنْ بَني عَماليقَ وسكَنوا هُناكَ إلى هذا اليومِ.<verse eid="1CH 4:43" /></para>
  <chapter eid="1CH 4" />
  <chapter number="5" style="c" sid="1CH 5" />
  <para style="s1">مواليد رأوبين</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="1CH 5:1" />ولِرَأوبينَ، بِكْرِ يَعقوبَ، بَنونَ. كانَ هوَ البِكْرَ، إلَّا أنَّه ضاجَعَ جواريَ أبيهِ فخَسِرَ حَقَّ البُكوريَّةِ، فأُعطيَ الحَقُّ لِبني يوسفَ بنِ يَعقوبَ. <verse eid="1CH 5:1" /><verse number="2" style="v" pubnumber="2" sid="1CH 5:2" />وقوِيَ سِبْطُ يَهوذا على سائِرِ أسباطِ إخوتِهِ، فخَرَجَ مِنهُ مَلِكٌ علَيهِم جميعًا. <verse eid="1CH 5:2" /><verse number="3" style="v" pubnumber="3" sid="1CH 5:3" />وبَنو رَأوبينَ، بِكْرِ يَعقوبَ، أربعَةٌ: حَنوكُ وفَلُّو وحَصرونُ وكرمي.<verse eid="1CH 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="1CH 5:4" />وبَنو يوئيلَ: شَمْعيا اَبنُهُ، وجوجُ بنُ شَمْعيا، وشَمعي بنُ جوجَ، <verse eid="1CH 5:4" /><verse number="5" style="v" pubnumber="5" sid="1CH 5:5" />وميخا بنُ شَمعي، ورآيا بنُ ميخا، وبَعلُ بنُ رآيا، <verse eid="1CH 5:5" /><verse number="6" style="v" pubnumber="6" sid="1CH 5:6" />وبَثيرَةُ بنُ بَعلَ، وهوَ الّذي أسَرَهُ تَغلثْ فلاسَرُ مَلِكُ أشُّورَ، وهوَ رئيسُ الرَّأوبينيِّينَ. <verse eid="1CH 5:6" /><verse number="7" style="v" pubnumber="7" sid="1CH 5:7" />وأنسباؤُهُ بِحسَبِ عشائِرِهِم ومَواليدِهِم: يَعيئيلُ وزكَريا <verse eid="1CH 5:7" /><verse number="8" style="v" pubnumber="8" sid="1CH 5:8" />وبالِعُ بنُ عازارَ بنِ شامِعَ بنِ يوئيلَ هؤلاءِ سكَنوا في عَروعيرَ واَنتَشَروا شمالًا إلى نَبو وبَعلَ مَعونَ، <verse eid="1CH 5:8" /><verse number="9" style="v" pubnumber="9" sid="1CH 5:9" />وشرقًا إلى مَدخَلِ الصَّحراءِ المُؤدِّيةِ إلى نهرِ الفُراتِ، لأنَّ ماشيتَهُم كثُرَت في أرضِ جلعاد. <verse eid="1CH 5:9" /><verse number="10" style="v" pubnumber="10" sid="1CH 5:10" />وقاتَلوا الهاجريِّينَ في أيَّامَ شاوُلَ وأبادوهُم، فسكنوا في خيامِهِمِ المُنتَشِرةِ في القِسمِ الشَّرقي مِنْ جلعاد.<verse eid="1CH 5:10" /></para>
  <para style="s1">مواليد جاد</para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="1CH 5:11" />وسكَنَ بَنو جادَ مُقابِلَهُم في أرضِ باشانَ المُمتَدَّةِ إلى سَلْكَةَ. <verse eid="1CH 5:11" /><verse number="12" style="v" pubnumber="12" sid="1CH 5:12" />وكانَ يوئيلُ رئيسًا، ويليهِ شافامُ. وكانَ يَعنايُ وشافاطُ رئيسَينِ أيضًا في باشانَ. <verse eid="1CH 5:12" /><verse number="13" style="v" pubnumber="13" sid="1CH 5:13" />وأنسِباؤُهُم بِحسَبِ عيالِهِم سبعةٌ: ميخائيلُ ومُشلَّامُ وشَبَعُ ويُورايُ ويَعكانُ وزيعُ وعابِرُ. <verse eid="1CH 5:13" /><verse number="14" style="v" pubnumber="14" sid="1CH 5:14" />هؤلاءِ بَنو أبيجايِلَ بنِ حُوري بنِ ياروحَ بنِ جلعادَ بنِ ميخائيلَ بنِ يشيشايَ بنِ يَحْدو بنِ بُوزَ. <verse eid="1CH 5:14" /><verse number="15" style="v" pubnumber="15" sid="1CH 5:15" />وكانَ أخي بنُ عبديئيلَ بنِ جُوني رئيسَ بيتِ أبائِهِم. <verse eid="1CH 5:15" /><verse number="16" style="v" pubnumber="16" sid="1CH 5:16" />وسكنوا في جلعادَ، في باشانَ وتوابِعِها، وفي جميعِ مراعي شارونَ. <verse eid="1CH 5:16" /><verse number="17" style="v" pubnumber="17" sid="1CH 5:17" />وجرى تَدوينُ اَنتِسابِهِم جميعًا في أيّامِ يوتامَ مَلِكِ يَهوذا ويَربعامَ مَلِكِ إسرائيلَ.<verse eid="1CH 5:17" /></para>
  <para style="s1">جيوش الأسباط الشرقيين</para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="1CH 5:18" />وكانَ في بني رَأوبينَ وبَني جادَ وبَني نِصفِ سِبْطِ منَسَّى أَرْبَعَةٌ وَأَرْبَعُونَ أَلْفًا وَسَبْعُ مِئَةٍ وَسِتُّونَ مُقاتِلًا جبَّارًا مُدَرَّبًا على القِتالِ بالتُّرْسِ والسَّيفِ والقَوسِ. <verse eid="1CH 5:18" /><verse number="19" style="v" pubnumber="19" sid="1CH 5:19" />فقاتلوا الهاجريِّينَ وأعوانَهُم <verse eid="1CH 5:19" /><verse number="20" style="v" pubnumber="20" sid="1CH 5:20" />وغلَبوهُم لأنَّهُم صرَخوا إلى اللهِ في القِتالِ فاَستجابَ لهُم لاتِّكالِهِم علَيهِ. <verse eid="1CH 5:20" /><verse number="21" style="v" pubnumber="21" sid="1CH 5:21" />ونهَبوا خمسينَ ألفًا مِنَ الجِمالِ ومئَتَينِ وخمسينَ ألفًا مِنَ الغنَمِ، وألفَينِ مِنَ الحميرِ، وأسَروا مِنَ النَّاسِ مئَةَ ألفٍ. <verse eid="1CH 5:21" /><verse number="22" style="v" pubnumber="22" sid="1CH 5:22" />وسقطَ قَتلى كثيرونَ مِنَ الهاجريِّينَ لأنَّ القِتالَ ضِدَّهُم كانَ بِمَشيئةِ اللهِ، وسكَنَ بَنو رَأوبينَ في أماكِنِهم إلى وقتِ السَّبْي.<verse eid="1CH 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="1CH 5:23" />وسكنَ بَنو نِصفِ سِبْطِ منَسَّى في أرضِ باشانَ المُمتَدَّةِ إلى بَعلَ حَرمونَ وسَنيرَ وجبَلِ حَرمونَ، لأنَّهم تكاثَروا. <verse eid="1CH 5:23" /><verse number="24" style="v" pubnumber="24" sid="1CH 5:24" />وهؤلاءِ رُؤساءُ عائلاتِهِم: عافَرُ ويَشعي وأليئيلُ وعَزْرئيلُ ويَرْميا وهودَيا ويَحديئيلُ، وكُلُّهُم رِجالٌ أشِدَّاءُ ورؤساءُ مَشهورونَ لِعائلاتِهِم. <verse eid="1CH 5:24" /><verse number="25" style="v" pubnumber="25" sid="1CH 5:25" />لكنَّ الشَّعبَ خانوا إلهَ آبائِهِم وخَطِئوا باَتِّباعِ آلهةِ شعوبٍ أُخرى طرَدَهُمُ الرّبُّ مِنْ أمامِهِم. <verse eid="1CH 5:25" /><verse number="26" style="v" pubnumber="26" sid="1CH 5:26" />فأثارَ الرّبُّ علَيهِم فولَ مَلِكَ أشُّورَ، وهوَ تَغلَثْ فلاسَرُ، فسَبى بَني رَأوبينَ وبَني جادَ وبَني نِصفِ منَسَّى، وجاءَ بِهِم إلى حَلَحَ وخابورَ وهارا ونهرِ جوزانَ وهُم فيها إلى هذا اليومِ.<verse eid="1CH 5:26" /></para>
  <para style="s1">مواليد لاوي</para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="1CH 5:27" />وبَنو لاويّ: جَرشونُ وقَهاتُ ومَراري. <verse eid="1CH 5:27" /><verse number="28" style="v" pubnumber="28" sid="1CH 5:28" />وبَنو قَهاتَ عَمرامُ ويِصْهارُ وحبرونُ وعُزِّيئيلُ. <verse eid="1CH 5:28" /><verse number="29" style="v" pubnumber="29" sid="1CH 5:29" />وبَنو عَمرامُ: هرونُ وموسى ومريمُ. وبَنو هرونَ: نادابُ وأبيهو وألعازارُ وإيثامارُ. <verse eid="1CH 5:29" /><verse number="30" style="v" pubnumber="30" sid="1CH 5:30" />وألعازارُ ولَدَ فينحاسَ، وفينحاسُ ولَدَ أبيشوعَ، <verse eid="1CH 5:30" /><verse number="31" style="v" pubnumber="31" sid="1CH 5:31" />وأبيشوعُ ولَدَ بُقِّيَ، وبُقِّي ولَدَ عُزِّيَ، <verse eid="1CH 5:31" /><verse number="32" style="v" pubnumber="32" sid="1CH 5:32" />وعُزِّي ولَدَ زَرَحْيا، وزَرَحْيا ولَدَ مَرايوثَ، <verse eid="1CH 5:32" /><verse number="33" style="v" pubnumber="33" sid="1CH 5:33" />ومرايوثُ ولَدَ أمَرْيا، وأمَرْيا ولَدَ أخيطوبَ، <verse eid="1CH 5:33" /><verse number="34" style="v" pubnumber="34" sid="1CH 5:34" />وأخيطوبُ ولَدَ صادوقَ، وصادوقُ ولَدَ أخيمعصَ، <verse eid="1CH 5:34" /><verse number="35" style="v" pubnumber="35" sid="1CH 5:35" />وأخيمعصُ ولَدَ عزَرْيا، وعزَرْيا ولَدَ يوحنانَ، <verse eid="1CH 5:35" /><verse number="36" style="v" pubnumber="36" sid="1CH 5:36" />ويوحنانُ ولَدَ عزَرْيا وهوَ الّذي خدمَ في بَيتِ الرّبِّ الّذي بناهُ سُليمانُ في أورُشليمَ، <verse eid="1CH 5:36" /><verse number="37" style="v" pubnumber="37" sid="1CH 5:37" />وعزَرْيا ولَدَ أمَرْيا وأمَرْيا ولَدَ أخيطوبَ، <verse eid="1CH 5:37" /><verse number="38" style="v" pubnumber="38" sid="1CH 5:38" />وأخيطوبُ ولَدَ صادوقَ، وصادوقُ ولَدَ شلُّومَ، <verse eid="1CH 5:38" /><verse number="39" style="v" pubnumber="39" sid="1CH 5:39" />وشلُّومُ ولَدَ حَلْقيا، وحَلْقيا ولَدَ عزَرْيا، <verse eid="1CH 5:39" /><verse number="40" style="v" pubnumber="40" sid="1CH 5:40" />وعزَرْيا ولَدَ سَرايا، وسَرايا ولَدَ يوصاداقَ، <verse eid="1CH 5:40" /><verse number="41" style="v" pubnumber="41" sid="1CH 5:41" />ويوصاداقُ سَباهُ الرّبُّ معَ سُكَّانِ يَهوذا، وأورُشليمَ على يَدِ نَبوخذنَصَّرَ.<verse eid="1CH 5:41" /></para>
  <chapter eid="1CH 5" />
  <chapter number="6" style="c" sid="1CH 6" />
  <para style="s1">بنو لاوي</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="1CH 6:1" />وبَنو لاويّ: جَرشونُ وقَهاتُ ومَراري. <verse eid="1CH 6:1" /><verse number="2" style="v" pubnumber="2" sid="1CH 6:2" />واَبنا جَرشومَ: لِبني وشِمْعي. <verse eid="1CH 6:2" /><verse number="3" style="v" pubnumber="3" sid="1CH 6:3" />وبَنو قَهاتَ: عَمرامُ ويَصهارُ وحبرونُ وعُزِّيئيلُ. <verse eid="1CH 6:3" /><verse number="4" style="v" pubnumber="4" sid="1CH 6:4" />واَبنا مَراري: مَحلي وموشي. هذِهِ عشائِرُ اللَّاويِّينَ بِحسَبِ أبائِهِم. <verse eid="1CH 6:4" /><verse number="5" style="v" pubnumber="5" sid="1CH 6:5" />واَبنُ لِبني بنِ جَرشومَ: يَحَثُ، واَبنُ يَحَثَ زِمَّةُ، <verse eid="1CH 6:5" /><verse number="6" style="v" pubnumber="6" sid="1CH 6:6" />واَبنُ زِمَّةَ يوآخُ، واَبنُ يوآخَ عِدُّو، <verse eid="1CH 6:6" /><verse number="7" style="v" pubnumber="7" sid="1CH 6:7" />واَبنُ عِدُّو زارحُ، واَبنُ زارحَ يأثَرايُ. <verse eid="1CH 6:7" /><verse number="8" style="v" pubnumber="8" sid="1CH 6:8" />واَبنُ عَمينادابَ بنِ قَهاتَ: قورحُ، واَبنُ قورحَ أسيرُ، <verse eid="1CH 6:8" /><verse number="9" style="v" pubnumber="9" sid="1CH 6:9" />واَبنُ أسيرَ تحثُ، واَبنُ تحثَ أوريئيلُ، واَبنُ أوريئيلَ عُزِّيا واَبنُ عُزِّيا شاولُ. <verse eid="1CH 6:9" /><verse number="10" style="v" pubnumber="10" sid="1CH 6:10" />واَبنا ألقانةَ: عماسايُ وأخيموتُ. <verse eid="1CH 6:10" /><verse number="11" style="v" pubnumber="11" sid="1CH 6:11" />وبَنو أخيموتَ ألقانةُ، وصوفايَ، ونحثُ، <verse eid="1CH 6:11" /><verse number="12" style="v" pubnumber="12" sid="1CH 6:12" />وأليآبُ، ويروحامُ، وألقانةُ. <verse eid="1CH 6:12" /><verse number="13" style="v" pubnumber="13" sid="1CH 6:13" />واَبنا صموئيلَ يوئيلُ البكرُ: والثاني أبيَّا. <verse eid="1CH 6:13" /><verse number="14" style="v" pubnumber="14" sid="1CH 6:14" />واَبنُ مَحلي بنِ مراري: لِبني، واَبنُ لِبني: شِمْعي، واَبنُ شِمْعي: عُزَّةُ، <verse eid="1CH 6:14" /><verse number="15" style="v" pubnumber="15" sid="1CH 6:15" />واَبنُ عُزَّةَ: شِمعي، واَبنُ شِمْعي: حَجيا، واَبنُ حَجيا: عَسايا.<verse eid="1CH 6:15" /></para>
  <para style="s1">جوقة الغناء في بيت الرب</para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="1CH 6:16" />وهؤلاءِ هُمُ الّذينَ أوكلَ إليهِم داوُدُ إدارةَ جوقةِ الغِناءِ في بَيتِ الرّبِّ، بَعدَ أن اَستقرَّ فيهِ تابوتُ العَهدِ. <verse eid="1CH 6:16" /><verse number="17" style="v" pubnumber="17" sid="1CH 6:17" />وكانوا يَتناوبونَ على الخِدمةِ بالغِناءِ أمامَ خَيمةِ الاجتماعِ، إلى أنْ بَنى سُليمانُ بَيتَ الرّبِّ في أورُشليمَ. <verse eid="1CH 6:17" /><verse number="18" style="v" pubnumber="18" sid="1CH 6:18" />وهؤلاءِ هُمُ الّذينَ تَوَلَّوا هذا المَنصِبَ، وبَنوهُم مِنْ بَعدِهِم: <verse eid="1CH 6:18" /><verse number="19" style="v" pubnumber="19" sid="1CH 6:19" />ابنُ ألقانةَ بنِ يَروحامَ بنِ إيلئيلَ بنِ توحَ <verse eid="1CH 6:19" /><verse number="20" style="v" pubnumber="20" sid="1CH 6:20" />بنِ صوفَ بنِ ألقانةَ بنِ مَحَثَ بنِ عماسيَ <verse eid="1CH 6:20" /><verse number="21" style="v" pubnumber="21" sid="1CH 6:21" />بنِ ألقانةَ بنِ يوئيلَ بنِ عزَرْيا بن صَفَنيا <verse eid="1CH 6:21" /><verse number="22" style="v" pubnumber="22" sid="1CH 6:22" />بنِ تَحَثَ بنِ أسيرَ بنِ أبياسافَ بنِ قورحَ <verse eid="1CH 6:22" /><verse number="23" style="v" pubnumber="23" sid="1CH 6:23" />بنِ يَصهارَ بنِ قهاتَ بنِ لاويّ بنِ يَعقوبَ.<verse eid="1CH 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="1CH 6:24" />وكانَ أسافُ ثاني مُديرٍ للجوقةِ، وهوَ ابنُ برَخْيا بنِ شِمْعي <verse eid="1CH 6:24" /><verse number="25" style="v" pubnumber="25" sid="1CH 6:25" />بنِ ميخائيلَ بنِ بعَسْيا بنِ مَلْكيا <verse eid="1CH 6:25" /><verse number="26" style="v" pubnumber="26" sid="1CH 6:26" />بنِ أثنايَ بنِ زارحَ بنِ عَدايا <verse eid="1CH 6:26" /><verse number="27" style="v" pubnumber="27" sid="1CH 6:27" />بنِ أيثانَ بنِ زِمَّةَ بنِ شِمْعي <verse eid="1CH 6:27" /><verse number="28" style="v" pubnumber="28" sid="1CH 6:28" />بنِ يحثَ بنِ جرشومَ بنِ لاويّ.<verse eid="1CH 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="1CH 6:29" />وكانَ أيثانُ ثالثَ مُديرٍ للجوقةِ، وهوَ ابنُ قيشي بنِ عبدي بنِ ملُّوخَ <verse eid="1CH 6:29" /><verse number="30" style="v" pubnumber="30" sid="1CH 6:30" />بنِ حشبيا بنِ أمَصْيا بنِ حَلْقيا <verse eid="1CH 6:30" /><verse number="31" style="v" pubnumber="31" sid="1CH 6:31" />بنِ أَمصي بنِ باني بنِ شامرَ <verse eid="1CH 6:31" /><verse number="32" style="v" pubnumber="32" sid="1CH 6:32" />بنِ مَحلي بنِ مُوشي بنِ مَراري بنِ لاويّ. <verse eid="1CH 6:32" /><verse number="33" style="v" pubnumber="33" sid="1CH 6:33" />وكانَ أنسباؤُهُم مِنَ اللَّاويِّينَ يتَولَّونَ سائرَ الخِدماتِ في بَيتِ اللهِ.<verse eid="1CH 6:33" /></para>
  <para style="s1">مواليد هرون</para>
  <para style="p">
    <verse number="34" style="v" pubnumber="34" sid="1CH 6:34" />وكانَ هرونُ وبَنوهُ مِنْ بَعدِهِ يُقدِّمونَ القرابينَ على مذبَحِ المُحرقةِ ومذبَحِ البَخورِ، ويقومونَ بِكُلِّ ما يَختَصُّ بقُدسِ الأقداسِ وبالذَّبائحِ والتَّقدماتِ الّتي كانَ يُكفِّرُ بها بَنو إِسرائيلَ عنْ خطاياهُم، على حسَبِ ما أمرَ بهِ موسى عبدُ اللهِ. <verse eid="1CH 6:34" /><verse number="35" style="v" pubnumber="35" sid="1CH 6:35" />وهؤلاءِ هُم بَنو هرونَ: ألعازارُ اَبنُهُ، فينحاسُ بنُ ألعازارَ، وأبيشوعُ بنُ فينحاسَ، <verse eid="1CH 6:35" /><verse number="36" style="v" pubnumber="36" sid="1CH 6:36" />وبقيُّ بنُ أبيشوعَ وزَرَحْيا بنُ عُزِّي، <verse eid="1CH 6:36" /><verse number="37" style="v" pubnumber="37" sid="1CH 6:37" />ومَرايوثُ بنُ زَرَحْيا، وأمَرْيا بنُ مَرايوثَ، وأخيطوبُ بنُ أمَرْيا، <verse eid="1CH 6:37" /><verse number="38" style="v" pubnumber="38" sid="1CH 6:38" />وصادوقُ بنُ أخيطوبَ، وأخيمعصُ بنُ صادوقَ.<verse eid="1CH 6:38" /></para>
  <para style="s1">مساكن اللاويين</para>
  <para style="p">
    <verse number="39" style="v" pubnumber="39" sid="1CH 6:39" />وهذِهِ مَساكِنُ بَني هرونَ مِنْ عَشيرةِ القهاتيِّينَ معَ ضياعِهِم وتُخومِهِم، لأنَّ الحِصَّةَ الأولى كانَت لهُم: <verse eid="1CH 6:39" /><verse number="40" style="v" pubnumber="40" sid="1CH 6:40" />حبرونُ في أرضِ يَهوذا وما حَولَها مِنَ المراعي. <verse eid="1CH 6:40" /><verse number="41" style="v" pubnumber="41" sid="1CH 6:41" />وأمَّا حُقولُ المدينةِ وضِياعُها التَّابعةُ لها، فأُعطيت لكالَبَ بنِ يَفُنَّةَ. <verse eid="1CH 6:41" /><verse number="42" style="v" pubnumber="42" sid="1CH 6:42" />وأُعطيَتْ لِبني هرونَ أيضًا مُدنُ الملجأِ: حبرونُ ولِبنةُ ومَراعيهما. ويَتيرُ وأشتموعُ ومراعيهُما. <verse eid="1CH 6:42" /><verse number="43" style="v" pubnumber="43" sid="1CH 6:43" />وحيلَينُ ودبيرُ ومراعيهُما، <verse eid="1CH 6:43" /><verse number="44" style="v" pubnumber="44" sid="1CH 6:44" />وعاشانُ وبيَت شَمسُ ومَراعيهما. <verse eid="1CH 6:44" /><verse number="45" style="v" pubnumber="45" sid="1CH 6:45" />وأُعطيَت لهُم مِنْ أرضِ سِبْطِ بِنيامينَ: جَبَعُ ومراعيها، وعَلْمَثُ ومراعيها، وعَناثوثُ ومراعيها. وجميعُ مدُنِهِم ثلاثَ عَشْرةَ مدينةً لِكُلِّ عشائِرِهِم. <verse eid="1CH 6:45" /><verse number="46" style="v" pubnumber="46" sid="1CH 6:46" />وللباقينَ مِنْ بَني قهاتَ أُعطيت عَشْرُ مُدُنٍ بالقرعَةِ مِنْ أرضِ أفرايمَ ودانَ ونِصفِ منَسَّى.<verse eid="1CH 6:46" /></para>
  <para style="p">
    <verse number="47" style="v" pubnumber="47" sid="1CH 6:47" />وأُعطيَت لِبَني جَرشومَ، بِحسَبِ عشائِرهِم، ثَلاثَ عَشْرَةَ مدينةً مِنْ أرضِ بَني يَسَّاكرَ وأشيرَ ونَفتالي ونِصفِ منَسَّى في باشانَ. <verse eid="1CH 6:47" /><verse number="48" style="v" pubnumber="48" sid="1CH 6:48" />ولِبَني مَراري أُعطيَت، بِحسَبِ عشائرهِم، اَثنتا عَشْرَةَ مدينةً بالقُرعةِ مِنْ أرضِ بَني رَأوبينَ وجادَ وزبولونَ. <verse eid="1CH 6:48" /><verse number="49" style="v" pubnumber="49" sid="1CH 6:49" />وهكذا أعطَى بَنو إِسرائيلَ للَّاويِّينَ مُدُنًا معَ مراعيها ليسكنوا فيها. <verse eid="1CH 6:49" /><verse number="50" style="v" pubnumber="50" sid="1CH 6:50" />والمُدُنُ الّتي في أرضِ بَني يَهوذا وشمعونَ وبنيامينَ، والّتي سبَقَ ذِكرُها، أُعطيت لهُم بالقُرعةِ أيضًا.<verse eid="1CH 6:50" /></para>
  <para style="p">
    <verse number="51" style="v" pubnumber="51" sid="1CH 6:51" />وبعضُ عشائِرِ بَني قَهاتَ نالوا مُدُنًا معَ مراعيها في أرضِ بَني أفرايمَ، <verse eid="1CH 6:51" /><verse number="52" style="v" pubnumber="52" sid="1CH 6:52" />وهيَ مُدُنُ الملجأِ: شكيمُ في جبَلِ أفرايمَ، وجازرُ، <verse eid="1CH 6:52" /><verse number="53" style="v" pubnumber="53" sid="1CH 6:53" />ويَقمَعامُ وبَيتُ حُورنَ <verse eid="1CH 6:53" /><verse number="54" style="v" pubnumber="54" sid="1CH 6:54" />وأيِّلونُ وجَتُّ رمُّونَ. <verse eid="1CH 6:54" /><verse number="55" style="v" pubnumber="55" sid="1CH 6:55" />وفي أرضِ سِبْطِ نِصفِ منَسَّى غربًا أُعطيَت للباقينَ مِنْ بَني قَهاتَ عانيرُ ومراعيها، وبِلْعامُ ومراعيها.<verse eid="1CH 6:55" /></para>
  <para style="p">
    <verse number="56" style="v" pubnumber="56" sid="1CH 6:56" />وأُعطيَت لِبَني جَرشومَ هذِهِ المُدُنُ معَ مراعيها: في أرضِ نِصفِ سِبْطِ منَسَّى شرقًا: جولانُ في باشانَ وعشتاروتُ. <verse eid="1CH 6:56" /><verse number="57" style="v" pubnumber="57" sid="1CH 6:57" />في أرضِ سِبْطِ يسَّاكرَ قادِشُ ودَبَرَةُ <verse eid="1CH 6:57" /><verse number="58" style="v" pubnumber="58" sid="1CH 6:58" />وراموثُ وعانيمُ. <verse eid="1CH 6:58" /><verse number="59" style="v" pubnumber="59" sid="1CH 6:59" />وفي أرضِ سِبْطِ أشيرَ: مَشآلُ وعَبدونُ، <verse eid="1CH 6:59" /><verse number="60" style="v" pubnumber="60" sid="1CH 6:60" />وحُقوقُ ورَحوبُ. <verse eid="1CH 6:60" /><verse number="61" style="v" pubnumber="61" sid="1CH 6:61" />وفي أرضِ سِبْطِ نَفتالي: قادِشُ في الجليلِ، وحمُّونُ وقريَتايمُ.<verse eid="1CH 6:61" /></para>
  <para style="p">
    <verse number="62" style="v" pubnumber="62" sid="1CH 6:62" />ولِلباقينَ مِنْ بَني مَراري أُعطيت هذِهِ المُدُنُ معَ مراعيها: في أرضِ سِبْطِ زَبولونَ: رمُّونو وتابورُ. <verse eid="1CH 6:62" /><verse number="63" style="v" pubnumber="63" sid="1CH 6:63" />وفي أرضِ سِبْطِ رَأوبينَ شرقيَّ الأردنِّ قُبالَةَ أريحا: باصِرُ في السَّهلِ ويهصةُ <verse eid="1CH 6:63" /><verse number="64" style="v" pubnumber="64" sid="1CH 6:64" />وقديموتُ وميفَعَةُ. <verse eid="1CH 6:64" /><verse number="65" style="v" pubnumber="65" sid="1CH 6:65" />وفي أرضِ سِبْطِ جادَ: راموتُ في جلعادَ، ومَحَنايِمُ <verse eid="1CH 6:65" /><verse number="66" style="v" pubnumber="66" sid="1CH 6:66" />وحَشبونُ ويَعَزيرُ.<verse eid="1CH 6:66" /></para>
  <chapter eid="1CH 6" />
  <chapter number="7" style="c" sid="1CH 7" />
  <para style="s1">مواليد يساكر</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="1CH 7:1" />وبَنو يَسَّاكرَ أربَعةٌ: تُولاعُ وفوةُ وياشوبُ وشِمْرونُ. <verse eid="1CH 7:1" /><verse number="2" style="v" pubnumber="2" sid="1CH 7:2" />وبَنو تولاعَ: عُزِّي ورفايا ويريئيلُ ويَحمايُ ويَبسامُ وشَموئيلُ، وكانوا رؤساءَ بيوتِ آبائِهِم ومُقاتِلينَ أشدَّاءَ. وكانَ عدَدُهُم في أيّامِ داوُدَ اَثنينِ وعِشرينَ ألفًا وستَّ مِئَةٍ. <verse eid="1CH 7:2" /><verse number="3" style="v" pubnumber="3" sid="1CH 7:3" />واَبنُ عُزِّي: يَزرَحْيا، وبَنو يَزرَحْيا أربَعةٌ: ميخائيلُ وعُوبَديا ويوئيلُ ويَشِّيَّا، وكانوا كُلُّهُم رؤساءَ بيوتِ آبائِهِم. <verse eid="1CH 7:3" /><verse number="4" style="v" pubnumber="4" sid="1CH 7:4" />وأكثروا مِنَ الزَّوجاتِ والبَنينَ، فكانَ لهُم مِنْ مَواليدِهِم سِتَّةٌ وثَلاثونَ ألفَ مُقاتلٍ. <verse eid="1CH 7:4" /><verse number="5" style="v" pubnumber="5" sid="1CH 7:5" />وأنسِباؤُهُم جميعًا، مِنْ كُلِّ عشائِرِ يَسَّاكَر، سبعةٌ وثمانونَ ألفَ مُقاتلٍ جَبارٍ.<verse eid="1CH 7:5" /></para>
  <para style="s1">مواليد بنيامين وجاد</para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="1CH 7:6" />وبَنو بنيامينَ ثَلاثَةٌ، وهُم بالَعُ وباكَرُ ويَديعئيلُ. <verse eid="1CH 7:6" /><verse number="7" style="v" pubnumber="7" sid="1CH 7:7" />وبَنو بالَعَ خمسةٌ وهُم: أصبونُ وعُزِّي وعَزِّيئيلُ ويَريموثُ وعيري، وكُلُّهُم رؤساءُ عائلاتِهِم وجَبابِرَةٌ أشدَّاءُ. وكانَ عددُ أنسبائِهِم اَثنينِ وعشرينَ ألفًا وأربَعةً وثَلاثينَ. <verse eid="1CH 7:7" /><verse number="8" style="v" pubnumber="8" sid="1CH 7:8" />وبَنو باكرَ تِسعةٌ وهُم: زَميرةُ ويوعاشُ وأليعزَرُ وأليوعينايُ وعُمري ويَريموثُ وأبيَّا وعناتوتُ وعلامَثُ. <verse eid="1CH 7:8" /><verse number="9" style="v" pubnumber="9" sid="1CH 7:9" />وكانوا كُلُّهُم رؤساءَ عائلاتِهِم وجبابِرَةً أشدَّاءَ، ويَنتَسِبُ إليهِم عشرونَ ألفًا ومئتانِ. <verse eid="1CH 7:9" /><verse number="10" style="v" pubnumber="10" sid="1CH 7:10" />واَبنُ يَديعئيلَ بَلهانُ، وبَنو بَلهانَ سبعةٌ وهُم: يَعيشُ وبنيامينُ وأهودُ وكنعَنَةُ وزيتانُ وترشيشُ وأخيشاحَرُ. <verse eid="1CH 7:10" /><verse number="11" style="v" pubnumber="11" sid="1CH 7:11" />كُلُّ هؤلاءِ كانوا رؤساءَ عائلاتِهِم وجبابرَةً أشدَّاءَ، ويَنتَسِبُ إليهِم سبعةَ عشَرَ ألفًا ومئتا مُحاربٍ. <verse eid="1CH 7:11" /><verse number="12" style="v" pubnumber="12" sid="1CH 7:12" />واَبنا عيرَ: شُفِّيمُ وحُفِّيمُ، واَبنُ أحيرَ حوشيمُ.<verse eid="1CH 7:12" /></para>
  <para style="s1">مواليد نفتالي</para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="1CH 7:13" />وبَنو نَفتالي أربَعةٌ، وهُم يَحصيئيلُ وجوني ويصَرُ وشَلُّومُ، مِنْ نَسلِ بِلهَةَ جاريةِ يَعقوبَ.<verse eid="1CH 7:13" /></para>
  <para style="s1">مواليد منسّى</para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="1CH 7:14" />واَبنا منَسَّى مِنْ جاريتِهِ الآراميَّةِ: إشريئيلُ وماكيرُ أبو جلعادَ. <verse eid="1CH 7:14" /><verse number="15" style="v" pubnumber="15" sid="1CH 7:15" />واَتَّخَذَ ماكيرُ زوجةً لِكُلٍّ مِنْ حُفِّيمَ وشُفِّيمَ. اَسمُ أُختِهما مَعكةُ، واَسمُ اَبنِهِ الثَّاني صَلْفَحادُ. وكانَ لصَلْفَحادَ بناتٌ لا بَنينَ. <verse eid="1CH 7:15" /><verse number="16" style="v" pubnumber="16" sid="1CH 7:16" />ووَلَدت مَعكةُ اَمرأةُ ماكيرَ ولَدَينِ وسمَّتْهُما فرَشَ وشارشَ، واَبنا فرَشَ، أولامُ وراقَمُ. <verse eid="1CH 7:16" /><verse number="17" style="v" pubnumber="17" sid="1CH 7:17" />واَبنُ أولامَ: بَدانُ. هؤلاءِ بنو جلعادَ بنِ ماكيرَ بنِ منَسَّى. <verse eid="1CH 7:17" /><verse number="18" style="v" pubnumber="18" sid="1CH 7:18" />وولَدت أختُ جلعادَ همُّولكةُ إيشَهودَ وأبيعزرَ ومَحلَةَ. <verse eid="1CH 7:18" /><verse number="19" style="v" pubnumber="19" sid="1CH 7:19" />وبَنو شميداعَ أربَعةٌ، وهُمُ: أخيانُ وشكيمُ ولِقْحي وأنيعامُ.<verse eid="1CH 7:19" /></para>
  <para style="s1">مواليد أفرايم</para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="1CH 7:20" />واَبنُ أفرايمَ: شوتالَحُ. وشوتالَحُ ولَدَ برَدَ، وبرَدُ ولَدَ تحثَ، وتحثُ ولَدَ ألعادَةَ، وألعادَةُ ولَدَ تحثَ، <verse eid="1CH 7:20" /><verse number="21" style="v" pubnumber="21" sid="1CH 7:21" />وتحثُ ولَدَ زابادَ وزابادُ ولَدَ شوتالَحَ، وشوتالَحُ ولَدَ عزرَ وألعادَ. فقَتَلَهُم رجالُ جتَّ لأنَّ بَني أفرايمَ نزَلوا ليأخذوا ماشيتَهُم. <verse eid="1CH 7:21" /><verse number="22" style="v" pubnumber="22" sid="1CH 7:22" />فناحَ أفرايمُ أبوهُم أيّامًا كثيرة، وجاءَ إخوتُهُ ليُعزُّوهُ. <verse eid="1CH 7:22" /><verse number="23" style="v" pubnumber="23" sid="1CH 7:23" />ونامَ أفرايم معَ اَمرأتِهِ. فحَبِلَت وولَدَت اَبنًا سمَّاهُ بَريعةَ لأنَّ نَكبَةً نزَلَت في بَيتِهِ. <verse eid="1CH 7:23" /><verse number="24" style="v" pubnumber="24" sid="1CH 7:24" />وكانَ لأفرايمَ اَبنَةٌ اَسمُها شيرَةُ، وهيَ بَنَتْ بَيتَ حُورونَ السُّفلى والعُليا وأزينَ شيرَةَ. <verse eid="1CH 7:24" /><verse number="25" style="v" pubnumber="25" sid="1CH 7:25" />وكانَ لَه أيضًا اَبنٌ اَسمُهُ رَفَحُ، وبَنوهُ: تاحَنُ بنُ تَلَحَ بنِ رَشَفَ، <verse eid="1CH 7:25" /><verse number="26" style="v" pubnumber="26" sid="1CH 7:26" />وأليشَمَعُ بنُ عَميهودَ بنِ لَعدانَ، <verse eid="1CH 7:26" /><verse number="27" style="v" pubnumber="27" sid="1CH 7:27" />ويشوعُ بنُ نُونٍ. <verse eid="1CH 7:27" /><verse number="28" style="v" pubnumber="28" sid="1CH 7:28" />وأملاكُهُم ومساكِنهُم كانَت بيتَ بابلَ وتوابِعَها، وشرقًا نَعَرانَ، وغربًا جازَرَ وشكيمَ وتوابِعَهُما، إلى عَيَّا وتوابِعَها. <verse eid="1CH 7:28" /><verse number="29" style="v" pubnumber="29" sid="1CH 7:29" />ولِبَني منَسَّى بَيتُ شانَ وتوابِعُها، وتَعنَكُ وتوابِعُها، ومِجِدُّو وتوابِعُها، ودُورُ وتوابِعُها، هُناكَ كانَت مساكِنُ بَني يوسفَ بنِ يعقوبَ.<verse eid="1CH 7:29" /></para>
  <para style="s1">مواليد أشير</para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="1CH 7:30" />وبَنو أشيرَ: يَمنَةُ ويِشوَةُ ويِشوي وبَريعةُ، وسارَحُ أختُهُم. <verse eid="1CH 7:30" /><verse number="31" style="v" pubnumber="31" sid="1CH 7:31" />واَبنا بَريعَةَ: حابِرُ وملكِئيلُ، وهوَ أبو بِرْزاوثَ. <verse eid="1CH 7:31" /><verse number="32" style="v" pubnumber="32" sid="1CH 7:32" />وحابِرُ ولَدَ يَفليطَ وشوميرَ وحوثامَ وشُوعَا أُختُهُم. <verse eid="1CH 7:32" /><verse number="33" style="v" pubnumber="33" sid="1CH 7:33" />وبَنو يَفليطَ: فاسكُ وبِمْهالُ وعَشوَةُ. <verse eid="1CH 7:33" /><verse number="34" style="v" pubnumber="34" sid="1CH 7:34" />وبَنو شامَرَ: آخي ورُهجَةُ ويَحَبَّةُ وأرامُ. <verse eid="1CH 7:34" /><verse number="35" style="v" pubnumber="35" sid="1CH 7:35" />وبَنو هيلامَ أخيهِ: صوفَحُ ويَمناعُ وشالَشُ وعامالُ. <verse eid="1CH 7:35" /><verse number="36" style="v" pubnumber="36" sid="1CH 7:36" />وبَنو صوفَحَ: سوحُ وحَرنفَرُ وشوعالُ وبيري ويَمرَةُ <verse eid="1CH 7:36" /><verse number="37" style="v" pubnumber="37" sid="1CH 7:37" />وباصِرُ وهُودُ وشَمَّا وشِلْشَةُ ويِثرانُ وبئيرا. <verse eid="1CH 7:37" /><verse number="38" style="v" pubnumber="38" sid="1CH 7:38" />وبَنو يَثَرَ: يَفُنَّةُ وفِسفَةُ وأرا. <verse eid="1CH 7:38" /><verse number="39" style="v" pubnumber="39" sid="1CH 7:39" />وبَنو عُلَّا: آراحُ وحَنيئيلُ ورصيا. <verse eid="1CH 7:39" /><verse number="40" style="v" pubnumber="40" sid="1CH 7:40" />كُلُّ هؤلاءِ بَنو أشيرَ. وكانوا رُؤساءَ بيوتِ آبائِهِم وجَبابِرةً أشدَّاءَ مَشهورينَ وقادةً بارِزينَ، والّذينَ يَنتَسبونَ إليهِم عدَدُهُم سِتَّةٌ وعشرونَ ألفَ مُحاربٍ.<verse eid="1CH 7:40" /></para>
  <chapter eid="1CH 7" />
  <chapter number="8" style="c" sid="1CH 8" />
  <para style="s1">مواليد بنيامين</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="1CH 8:1" />وبَنو بنيامينَ خمسةٌ وهُم، على حسَبِ أعمارِهِم: بالَعُ بِكْرُهُ، وأشبيلُ وأخرَخُ <verse eid="1CH 8:1" /><verse number="2" style="v" pubnumber="2" sid="1CH 8:2" />ونُوحَةُ ورافا. <verse eid="1CH 8:2" /><verse number="3" style="v" pubnumber="3" sid="1CH 8:3" />وبَنو بالَعَ: أدارُ وجَيرا وأبيهُودُ <verse eid="1CH 8:3" /><verse number="4" style="v" pubnumber="4" sid="1CH 8:4" />وأبيشوعُ ونُعمانُ وأخُوخُ <verse eid="1CH 8:4" /><verse number="5" style="v" pubnumber="5" sid="1CH 8:5" />وحَيرا وشَفوفانُ وحُورامُ. <verse eid="1CH 8:5" /><verse number="6" style="v" pubnumber="6" sid="1CH 8:6" />وبَنو أحودُ الّذينَ كانوا رؤساءَ عائِلاتِهِم وسُكَّانُ جَبْعَ، ثُمَّ نُقِلوا إلى مَناحَةَ، <verse eid="1CH 8:6" /><verse number="7" style="v" pubnumber="7" sid="1CH 8:7" />هُم: نُعمانُ وأخيا، جَيرا أبو عُزَّا وأخيحودَ، هوَ الّذي نقَلَهُم إلى مَناحَةَ، <verse eid="1CH 8:7" /><verse number="8" style="v" pubnumber="8" sid="1CH 8:8" />وكانَ لِشحرايمَ بَنونَ في أرضِ مُوآبَ، بَعدَ أنْ طَلَّقَ حُوشيمَ وبَعْرا اَمرأتَيهِ، <verse eid="1CH 8:8" /><verse number="9" style="v" pubnumber="9" sid="1CH 8:9" />فوَلَدَ مِنْ حودَشَ اَمرأتِهِ يوبابَ وظِبْيا ومَيشا ومَلكامَ <verse eid="1CH 8:9" /><verse number="10" style="v" pubnumber="10" sid="1CH 8:10" />ويَعوصَ وشَبيا ومُرمَةَ، وهؤلاءِ كانوا رؤساءَ عائلاتِهِم. <verse eid="1CH 8:10" /><verse number="11" style="v" pubnumber="11" sid="1CH 8:11" />وولَدَ أيضًا مِنْ حُوشيمَ اَمرَأتِهِ أبيطوبَ وألفَعَلَ. <verse eid="1CH 8:11" /><verse number="12" style="v" pubnumber="12" sid="1CH 8:12" />وبَنو ألفَعَلَ: عابِرُ ومِشعامُ وشامِرُ وهوَ الّذي بَنى أونو ولُودَ وتوابِعَها.<verse eid="1CH 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="1CH 8:13" />وكانَ بَريعةُ وشَمَعُ رئيسَينِ لِعائِلاتِهِما سكَنا في أيِّلونَ وطَردا سُكَّانَ جَتَّ. <verse eid="1CH 8:13" /><verse number="14" style="v" pubnumber="14" sid="1CH 8:14" />وبَنو بريعةَ: أخيو وشاشَقُ ويَريمُوتُ <verse eid="1CH 8:14" /><verse number="15" style="v" pubnumber="15" sid="1CH 8:15" />وزَبَدْيا وعَرادُ وعادَرُ <verse eid="1CH 8:15" /><verse number="16" style="v" pubnumber="16" sid="1CH 8:16" />وميخائيلُ ويِشفَةُ ويُوخا.<verse eid="1CH 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="1CH 8:17" />وبَنو ألفَعَلَ: زَبَدْيا ومَشُلَّامُ وحَزقي وحابِرُ <verse eid="1CH 8:17" /><verse number="18" style="v" pubnumber="18" sid="1CH 8:18" />ويشمرايُ ويَزَلياهُ ويوبابُ. <verse eid="1CH 8:18" /><verse number="19" style="v" pubnumber="19" sid="1CH 8:19" />وبَنو شِمْعي: ياقيمُ وزِكري وزَبدي <verse eid="1CH 8:19" /><verse number="20" style="v" pubnumber="20" sid="1CH 8:20" />وأليعينايُ وصِلَّتايُ وإيليئيلُ <verse eid="1CH 8:20" /><verse number="21" style="v" pubnumber="21" sid="1CH 8:21" />وعَدايا وبَرايا وشِمرَةُ. <verse eid="1CH 8:21" /><verse number="22" style="v" pubnumber="22" sid="1CH 8:22" />وبَنو شاشَقَ: يِشفانُ وعابِرُ وإيليئيلُ. <verse eid="1CH 8:22" /><verse number="23" style="v" pubnumber="23" sid="1CH 8:23" />وعَبدونُ وزِكري وحانانُ <verse eid="1CH 8:23" /><verse number="24" style="v" pubnumber="24" sid="1CH 8:24" />وحَننيا وعيلامُ وعَنثوثيا <verse eid="1CH 8:24" /><verse number="25" style="v" pubnumber="25" sid="1CH 8:25" />ويَفَدْيا وفَنوئيلُ. <verse eid="1CH 8:25" /><verse number="26" style="v" pubnumber="26" sid="1CH 8:26" />وبَنو يروحامَ: شِمشرايُ وشَحَرْيا وعثَلْيا <verse eid="1CH 8:26" /><verse number="27" style="v" pubnumber="27" sid="1CH 8:27" />ويَعرَشْيا وإيليَّا وزِكري. <verse eid="1CH 8:27" /><verse number="28" style="v" pubnumber="28" sid="1CH 8:28" />هؤلاءِ رؤساءُ عائلاتِهِم، بِحسَبِ مواليدِهِم، وكانَت مَساكِنُهُم في أورُشليمَ.<verse eid="1CH 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="1CH 8:29" />وبَنى يَعوئيلُ مدينةَ جبعونَ وسكنَ فيها، واَسمُ اَمرأتِهِ مَعكةُ. <verse eid="1CH 8:29" /><verse number="30" style="v" pubnumber="30" sid="1CH 8:30" />واَبنُهُ البِكْرُ عَبدونُ، ثُمَّ صُورُ وقيشُ وبَعلُ ونادابُ <verse eid="1CH 8:30" /><verse number="31" style="v" pubnumber="31" sid="1CH 8:31" />وجَدورُ وأخيو وزاكرُ. <verse eid="1CH 8:31" /><verse number="32" style="v" pubnumber="32" sid="1CH 8:32" />ومقْلوثُ ولَدَ شَماةَ. وسكنَ أبناؤُهُم في أورُشليمَ معَ سائِرِ أبناءِ عَشيرَتِهِم.<verse eid="1CH 8:32" /></para>
  <para style="s1">ذرية الملك شاول</para>
  <para style="p">
    <verse number="33" style="v" pubnumber="33" sid="1CH 8:33" />ونيرُ ولَدَ قَيشًا، وقَيشٌ ولَدَ شاولَ. وبَنو شاولَ: يوناثانُ ومَلكيشوعُ وأبينادابُ وإشبَعْلُ. <verse eid="1CH 8:33" /><verse number="34" style="v" pubnumber="34" sid="1CH 8:34" />ويوناثانُ ولَدَ مَريبَعَلَ، ومَريبَعَلُ ولَدَ ميخا. <verse eid="1CH 8:34" /><verse number="35" style="v" pubnumber="35" sid="1CH 8:35" />وبَنو ميخا: فيثُونُ ومالِكُ وتاريعُ وآحازُ. <verse eid="1CH 8:35" /><verse number="36" style="v" pubnumber="36" sid="1CH 8:36" />وآحازُ ولَدَ يُوعَدَّةَ ويُوعَدَّةُ ولَدَ عَلمَثَ وعَزمُوتَ وزِمْري. وزِمْري ولَدَ مُوصا. <verse eid="1CH 8:36" /><verse number="37" style="v" pubnumber="37" sid="1CH 8:37" />ومُوصا ولَدَ بِنْعا، وبِنْعا ولَدَ رافَةَ، ورافَةُ ولَدَ ألعاسَةَ، وألعاسَةُ ولَدَ أصيلَ. <verse eid="1CH 8:37" /><verse number="38" style="v" pubnumber="38" sid="1CH 8:38" />ولأصيلَ سِتَّةُ بَنينَ وهذِهِ أسماؤُهُم: عَزْريقامُ وبُكْرُو وإسماعيلُ وشَعَرْيا وعوبَدْيا وحانانُ. <verse eid="1CH 8:38" /><verse number="39" style="v" pubnumber="39" sid="1CH 8:39" />وبَنو عاشِقَ أخيهِ: أُولامُ بِكْرُهُ، ويَعُوشُ وأليفَلَطُ. <verse eid="1CH 8:39" /><verse number="40" style="v" pubnumber="40" sid="1CH 8:40" />وكانَ بَنو أولامَ رِجالًا جَبابِرةً ورُماةَ سِهامٍ، وكانَ لهُم بَنونَ وبَنو بَنينَ كثيرونَ بلَغوا مئَةً وخمسينَ. كُلُّ هؤلاءِ مَرَّ ذِكرُهُم مِنْ بَني بنيامينَ.<verse eid="1CH 8:40" /></para>
  <chapter eid="1CH 8" />
  <chapter number="9" style="c" sid="1CH 9" />
  <para style="s1">المسبيون العائدون</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="1CH 9:1" />واَكتتَبَ جميعُ بَني إِسرائيلَ بِحسَبِ أنسابِهِم، وهُم مُدوَّنونَ في سِفْرِ مُلوكِ إِسرائيلَ. وسُبيَ شعبُ يَهوذا إلى بابِلَ عِقابًا لهُم على خيانَتِهِم للرّبِّ. <verse eid="1CH 9:1" /><verse number="2" style="v" pubnumber="2" sid="1CH 9:2" />وكانَ أوَّلُ العائِدينَ مِنَ السَّبْي إلى السَّكنِ في مُلْكِهِم ومُدُنِهِم هُمُ الكهَنةُ واللَّاويُّونَ وخَدَمُ الهَيكلِ مِنْ بَني إِسرائيلَ. <verse eid="1CH 9:2" /><verse number="3" style="v" pubnumber="3" sid="1CH 9:3" />فسكَنَ في أورُشليمَ مِنْ أسباطِ يَهوذا وبنيامينَ وأفرايمَ ومنَسَّى: <verse eid="1CH 9:3" /><verse number="4" style="v" pubnumber="4" sid="1CH 9:4" />عوثايُ بنُ عَمِّيهودَ بنِ عُمري بنِ إمري بنِ باني، مِنْ بَني فارَصَ بنِ يَهوذا. <verse eid="1CH 9:4" /><verse number="5" style="v" pubnumber="5" sid="1CH 9:5" />ومِنْ بَني شيلَةَ بنِ يَهوذا: عَسايا بِكْرُهُ، وبَنوهُ. <verse eid="1CH 9:5" /><verse number="6" style="v" pubnumber="6" sid="1CH 9:6" />ومِنْ بَني زارَحَ بنِ يَهوذا: يَعوئيلُ، وأنسباؤُهُم سِتُّ مئَةٍ وتِسعونَ. <verse eid="1CH 9:6" /><verse number="7" style="v" pubnumber="7" sid="1CH 9:7" />ومِنْ بَني بنيامينَ: سَلُّو بنُ مَشُلَّامَ بنِ هُودويا بنِ هَسْنوأة، <verse eid="1CH 9:7" /><verse number="8" style="v" pubnumber="8" sid="1CH 9:8" />ويِبْنيا بنُ يَروحامَ، وأيلَةُ بنُ عُزِّي بنِ مِكْري، ومَشُلَّامُ بنُ شَفَطْيا بنِ رَعوئيلَ بنِ يِبْنيا. <verse eid="1CH 9:8" /><verse number="9" style="v" pubnumber="9" sid="1CH 9:9" />وأنسباءُ هؤلاءِ بِحسَبِ مَواليدِهِم تِسْعُ مئَةٍ وسِتَّةٌ وخمسونَ، وكُلُّهُم رؤساءُ بُيوتِ عائِلاتِهِم.<verse eid="1CH 9:9" /></para>
  <para style="s1">الكهنة الساكنون أورشليم</para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="1CH 9:10" />ومِنَ الكهَنةِ السَّاكِنينَ أورُشليمَ: يَدْعيا ويوياريبُ وياكينُ <verse eid="1CH 9:10" /><verse number="11" style="v" pubnumber="11" sid="1CH 9:11" />وعزَرْيا بنُ حِلْقِيا بنِ مَشُلَّامَ بنِ صادوقَ بنِ مَرايوثَ بنِ أخيطوبَ، رئيسِ هَيكلِ اللهِ، <verse eid="1CH 9:11" /><verse number="12" style="v" pubnumber="12" sid="1CH 9:12" />وعَدايا بنُ روحامَ بنِ فشحورَ بنِ مَلْكيا، ومَعْساي بنُ عَديئيلَ بنِ يَحزيرَة بنِ مَشُلَّامَ بنِ مَشِّليميتَ بنِ إمِّيرَ، <verse eid="1CH 9:12" /><verse number="13" style="v" pubnumber="13" sid="1CH 9:13" />كُلُّ هؤلاءِ وأنسِباؤُهُم ألْفٌ وسَبعُ مئَةٍ وسِتُّونَ، وكُلُّهُم رؤساءُ عائِلاتٍ ورِجالٌ مُقتَدِرونَ في القيامِ بِخِدمةِ هَيكلِ اللهِ.<verse eid="1CH 9:13" /></para>
  <para style="s1">اللاويون الساكنون أورشليم</para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="1CH 9:14" />ومِنَ اللَّاويِّينَ السَّاكنينَ أورُشليمَ: شَمَعْيا بنُ حَشُّوبَ بنِ عَزْريقامَ بنِ حَشَبْيا مِنْ بَني مَراري، <verse eid="1CH 9:14" /><verse number="15" style="v" pubnumber="15" sid="1CH 9:15" />وبَقبَقَّرُ وحرَشُ وجَلالُ ومَتَّنْيَا بنُ ميخا بنِ زِكْري بنِ آسافَ، <verse eid="1CH 9:15" /><verse number="16" style="v" pubnumber="16" sid="1CH 9:16" />وعُوبديا بنُ شَمْعيا بنِ جلالِ بنِ يَدوثونَ وبرَخْيا بنُ آسا بنِ ألقانَةَ السَّاكِنِ في قُرى النَّطوفيِّينَ.<verse eid="1CH 9:16" /></para>
  <para style="s1">البوابون الساكنون أورشليم</para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="1CH 9:17" />ومِنْ بَوَّابي هَيكلِ اللهِ السَّاكنينَ في أورُشليمَ: شَلّومُ وعَقُّوبُ وطَلمونُ وأخيمانُ وأنسِباؤُهُم. وكانَ شَلُّومُ رئيسَهُم. <verse eid="1CH 9:17" /><verse number="18" style="v" pubnumber="18" sid="1CH 9:18" />وهُم إلى الآنَ يَتوارثونَ الخِدمةَ على مَدخلِ بوَّابةِ المَلِكِ شَرقًا، وكانوا قَبلًا بوَّابي مَساكِنِ اللَّاويِّينَ. <verse eid="1CH 9:18" /><verse number="19" style="v" pubnumber="19" sid="1CH 9:19" />وشَلُّومُ بنُ قوري بنِ أبيآسافَ بنِ قورَحَ وأنسِباؤُهُم مِنْ بَني قورَحَ كانوا حُرَّاسًا لأبوابِ خيمةِ الاجتماعِ، كما كانَ آباؤُهُم مِنْ قَبلُ حُرَّاسًا لِمَدخَلِ مَحلَّةِ شعبِ الرّبِّ. <verse eid="1CH 9:19" /><verse number="20" style="v" pubnumber="20" sid="1CH 9:20" />وكانَ فِنحاسُ بنُ ألعازارَ رئيسًا علَيهِم مِنْ قبلُ، وكانَ الرّبُّ معَهُ. <verse eid="1CH 9:20" /><verse number="21" style="v" pubnumber="21" sid="1CH 9:21" />وكانَ زَكَريا بنُ مَشَلْميا أيضًا بوَّابَ خَيمةِ الاجتماعِ. <verse eid="1CH 9:21" /><verse number="22" style="v" pubnumber="22" sid="1CH 9:22" />جميعُ هؤلاءِ البَوَّابينَ المُنتَخَبينَ لِحِراسَةِ الأبوابِ والمَداخِلِ، وعدَدُهُم مئَتانِ واَثنا عشَرَ، أُكتُتِبُوا بِحسَبِ أنسِبائِهِم وقُراهُم، وثَبَّتَهُم داوُدُ المَلِكُ وصموئيلُ الرَّائي في وظائِفِهِم. <verse eid="1CH 9:22" /><verse number="23" style="v" pubnumber="23" sid="1CH 9:23" />فكانوا هُم وبَنوهُم مِنْ بَعدِهِم حُرَّاسًا لأبوابِ بيتِ الرّبِّ، وهيَ خَيمةُ الاجتماعِ. <verse eid="1CH 9:23" /><verse number="24" style="v" pubnumber="24" sid="1CH 9:24" />وكانَ لكُلِ جِهةٍ مِنَ الجِهاتِ الأربَعِ، شرقًا وغربًا وشمالًا وجنوبًا، بابٌ علَيهِ رئيسٌ للبَوَّابينَ. <verse eid="1CH 9:24" /><verse number="25" style="v" pubnumber="25" sid="1CH 9:25" />وكانَ أنسباؤُهُم في القُرى يَنضَمُّونَ إليهِم لِمُدَّةِ أُسبوعٍ، مِنْ حينٍ إلى حينٍ. <verse eid="1CH 9:25" /><verse number="26" style="v" pubnumber="26" sid="1CH 9:26" />وكانَ رؤساءُ البَوَّابينَ الأربعةُ، وهُم مِنَ اللَّاويِّينَ، يتَوَلَّونَ أيضًا حِراسَةَ غُرَفِ هَيكلِ اللهِ وخَزائِنِه. <verse eid="1CH 9:26" /><verse number="27" style="v" pubnumber="27" sid="1CH 9:27" />وكانَت مَنازِلُهُم حَولَ بَيتِ اللهِ، لأنَّهُ كانَت علَيهِم حِراسَةُ أبوابِهِ وفَتحُها كُلَّ صباحٍ.<verse eid="1CH 9:27" /></para>
  <para style="s1">اللاويون الآخرون</para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="1CH 9:28" />ومِنَ اللَّاويِّينَ مَنْ توَلَّى المُحافظَةَ على آنيةِ الخِدمةِ في هَيكلِ الرّبِّ، فكانوا يَعُدُّونَها كُلَّما أخرَجوها مِنْ مكانِها وأعادُوها إليهِ بَعدَ الخِدمةِ. <verse eid="1CH 9:28" /><verse number="29" style="v" pubnumber="29" sid="1CH 9:29" />ومِنهُم مَنْ أُوكِلَ إليهِم أمرُ سائِرِ الآنيةِ المُقَدَّسةِ، وأمرُ السَّميذِ والخمرِ والبَخورِ والأطيابِ. <verse eid="1CH 9:29" /><verse number="30" style="v" pubnumber="30" sid="1CH 9:30" />ومِنْ بينِ الكهَنةِ مَنْ كانوا يَهتَمُّونَ بِمَزْجِ الأطيابِ الخاصَّةِ بالكهَنةِ. <verse eid="1CH 9:30" /><verse number="31" style="v" pubnumber="31" sid="1CH 9:31" />وكانَ مَتَّنْيَا اللَّاويُّ، وهوَ بِكْرُ شَلُّومَ القُورَحيِّ، مُؤتَمَنًا على تَهيئَةِ ما يُطبَخُ تَقدِمةً للرّبِّ. <verse eid="1CH 9:31" /><verse number="32" style="v" pubnumber="32" sid="1CH 9:32" />ومِنْ بَني قَهاتَ أنسبائِهِم مَنْ كانوا يُهيِّئونَ خُبزَ التَّقدِمةِ في كُلِّ سَبْتٍ. <verse eid="1CH 9:32" /><verse number="33" style="v" pubnumber="33" sid="1CH 9:33" />والرُّؤساءُ اللَّاويُّونَ الّذينَ كانوا مُغَنِّينَ سكَنوا بَعضَ غُرَفِ هَيكلِ اللهِ. وكانوا لا يعمَلُونَ أيَّ عمَلٍ آخَرَ، لأنَّهُم كانوا تَحتَ الطَّلَبِ نهارًا وليلًا.<verse eid="1CH 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" pubnumber="34" sid="1CH 9:34" />فهؤلاءِ اللَّاويُّونَ الّذينَ سبَقَ ذِكْرُهُم كانوا رُؤساءَ عائِلاتٍ بِحسَبِ مَواليدِهِم. وكانَت مَساكِنُهُم في أورُشليمَ.<verse eid="1CH 9:34" /></para>
  <para style="s1">نسب الملك شاوُل وذريته</para>
  <para style="p">
    <verse number="35" style="v" pubnumber="35" sid="1CH 9:35" />وبَنى يَعوئيلُ مدينةَ جبعونَ وسكَنَ فيها، واَسمُ اَمرأتِهِ مَعكةُ. <verse eid="1CH 9:35" /><verse number="36" style="v" pubnumber="36" sid="1CH 9:36" />واَبنُهُ البِكْرُ عبدونُ، ثُمَّ صورُ وقَيشُ وبَعَلُ ونَيرُ ونادابُ <verse eid="1CH 9:36" /><verse number="37" style="v" pubnumber="37" sid="1CH 9:37" />وجدورُ وأخيُو وزَكَريا ومِقْلوثُ. <verse eid="1CH 9:37" /><verse number="38" style="v" pubnumber="38" sid="1CH 9:38" />ومِقْلوثُ ولَدَ شمامَ. وسكَنَ أبناؤُهُم في أورُشليمَ معَ سائِرِ أبناءِ عَشيرتِهِم.<verse eid="1CH 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" pubnumber="39" sid="1CH 9:39" />ونَيرُ ولَدَ قَيشًا، وقَيشُ ولَدَ شاوُلَ. وبَنو شاوُلَ: يوناثانُ ومَلكيشوعُ وأبينادابُ وإشبَعْلُ. <verse eid="1CH 9:39" /><verse number="40" style="v" pubnumber="40" sid="1CH 9:40" />ويوناثانُ ولَدَ مَريبَعلَ ومَريبَعلُ ولَدَ ميخا. <verse eid="1CH 9:40" /><verse number="41" style="v" pubnumber="41" sid="1CH 9:41" />وبَنو ميخا: فيثونُ ومالِكُ وتَحريعُ وآحازُ. <verse eid="1CH 9:41" /><verse number="42" style="v" pubnumber="42" sid="1CH 9:42" />وآحازُ ولَدَ يَعرَةَ، ويَعرَةُ ولَدَ عَلْمَثَ وعَزْموتَ وزِمْري. وزِمْري ولَدَ مُوصا. <verse eid="1CH 9:42" /><verse number="43" style="v" pubnumber="43" sid="1CH 9:43" />ومُوصا ولَدَ بِنْعا. وبِنْعا ولَدَ رَفايا، ورَفايا ولَدَ ألعاسَةَ، وألعاسَةُ ولَدَ آصيلَ. <verse eid="1CH 9:43" /><verse number="44" style="v" pubnumber="44" sid="1CH 9:44" />وكانَ لآصيلَ سِتَّةُ بَنينَ وهذِهِ أسماؤُهُم: عَزْريقامُ وبُكْرو وإسمَعيلُ وشَعَرْيا وعُوبديا وحانانُ.<verse eid="1CH 9:44" /></para>
  <chapter eid="1CH 9" />
  <chapter number="10" style="c" sid="1CH 10" />
  <para style="s1">موت الملك شاول</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="1CH 10:1" />وحارَبَ الفلِسطيُّونَ بَني إِسرائيلَ، فاَنهَزَمَ رجالُ إِسرائيلَ مِنْ أمامِهِم، وسقَطَ مُعظَمُهُم قَتلَى في جبَلِ جِلْبوعَ. <verse eid="1CH 10:1" /><verse number="2" style="v" pubnumber="2" sid="1CH 10:2" />ولحِقَ الفلِسطيُّونَ شاوُلَ وبَنيهِ وقَتَلوا يوناثانَ وأبينادابَ ومَلكيشوعَ بَني شاوُلَ. <verse eid="1CH 10:2" /><verse number="3" style="v" pubnumber="3" sid="1CH 10:3" />واَشتَدَّتِ الحربُ على شاوُلَ، وفاجأهُ الرُّماةُ بالأقواسِ فاَرتَعَبَ مِنهُم جِدًّا. <verse eid="1CH 10:3" /><verse number="4" style="v" pubnumber="4" sid="1CH 10:4" />فقالَ لِحامِلِ سلاحِهِ: ”إِستَلَّ سيفَكَ واَطْعَنِّي بهِ لِئلَّا يأتيَ هؤلاءِ الفلِسطيُّونَ غَيرُ المَختونينَ ويَقتُلوني ويُشَنِّعوا فيَّ“. فرفَضَ حامِلُ سلاحِهِ أمرَهُ هذا لأنَّهُ خافَ جِدًّا. فأخَذَ شاوُلُ سيفَهُ وسقَطَ علَيهِ. <verse eid="1CH 10:4" /><verse number="5" style="v" pubnumber="5" sid="1CH 10:5" />ولمَّا رأى حامِلُ سلاحِهِ أنَّهُ ماتَ، سقَطَ هوَ أيضًا على سيفِهِ وماتَ معَهُ. <verse eid="1CH 10:5" /><verse number="6" style="v" pubnumber="6" sid="1CH 10:6" />فماتَ شاوُلُ وبَنوهُ الثَّلاثَةُ، وجميعُ أهلِ بيتِه، في ذلِكَ اليومِ. <verse eid="1CH 10:6" /><verse number="7" style="v" pubnumber="7" sid="1CH 10:7" />ولمَّا عَلِمَ بَنو إِسرائيلَ الّذينَ في الجانِبِ الآخَرِ مِنَ الوادي أنَّ رِجالَهُم هربوا وأنَّ شاوُلَ وبنيهِ ماتوا، تَركوا المُدُنَ وهربوا هُم أيضًا فجاءَ الفلِسطيُّونَ وأقاموا فيها.<verse eid="1CH 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="1CH 10:8" />وفي الغَدِ أقبَلَ الفلِسطيُّونَ ليَسلُبوا القَتلَى. فوَجَدوا شاوُلَ وبَنيهِ الثَّلاثَةَ قَتلَى في جبَلِ جِلْبوعَ. <verse eid="1CH 10:8" /><verse number="9" style="v" pubnumber="9" sid="1CH 10:9" />فقَطَعُوا رأسَهُ ونزَعوا سِلاحَه، وأرسلوا يُبَشِّرونَ في أرضِهِم أصنامَهم وشعبَهُم. <verse eid="1CH 10:9" /><verse number="10" style="v" pubnumber="10" sid="1CH 10:10" />ووضَعُوا سلاحَهُ في هَيكلِ عَشتاروتَ، وعَلَّقُوا جُمجُمَتَهُ في بَيتِ داجونَ. <verse eid="1CH 10:10" /><verse number="11" style="v" pubnumber="11" sid="1CH 10:11" />وسَمِعَ أهلُ يابيشَ في جلعادَ بِما فعَلَ الفلِسطيُّونَ بِشاوُلَ، <verse eid="1CH 10:11" /><verse number="12" style="v" pubnumber="12" sid="1CH 10:12" />فنَهَضَ مُقاتِلوهُم، وأخَذوا جُثَّةَ شاوُلَ وجُثَثَ بَنيهِ وجاؤوا بِها إلى يابيشَ ودفَنوا عِظامَهُم تَحتَ شجَرةِ البُطْمَةِ الّتي في يابيشَ، وصاموا سَبعةَ أيّامٍ. <verse eid="1CH 10:12" /><verse number="13" style="v" pubnumber="13" sid="1CH 10:13" />فماتَ شاوُلُ لأنَّهُ خانَ الرّبَّ وعصَى كلِمَتَهُ، وأيضًا لأنَّهُ اَستَشارَ أرواحَ الموتى، <verse eid="1CH 10:13" /><verse number="14" style="v" pubnumber="14" sid="1CH 10:14" />ولم يَستَشِرِ الرّبَّ، فأهلَكَهُ وحَوَّلَ المُلْكَ إلى داوُدَ بنِ يَسَّى.<verse eid="1CH 10:14" /></para>
  <chapter eid="1CH 10" />
  <chapter number="11" style="c" sid="1CH 11" />
  <para style="s1">داود يملك على إسرائيل ويهوذا</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="1CH 11:1" />وأقبَلَ جميعُ بَني إِسرائيلَ إلى داوُدَ في حبرونَ وقالوا لَه: ”ها نَحنُ مِنْ لَحمِكَ وعَظمِكَ. <verse eid="1CH 11:1" /><verse number="2" style="v" pubnumber="2" sid="1CH 11:2" />حينَ كانَ شاوُلُ علَينا مَلِكًا، كُنتَ تَخرُجُ لِلحَربِ وتعودُ على رأسِ رجالِ إِسرائيلَ، والرّبُّ قالَ لكَ: أنتَ ترعى شعبي بَني إِسرائيلَ، وأنتَ تكونُ قائِدًا لهُم“. <verse eid="1CH 11:2" /><verse number="3" style="v" pubnumber="3" sid="1CH 11:3" />وأقبَلَ بَنو إِسرائيلَ إلى داوُدَ في حبرونَ، فقَطَعَ معَهُم عَهدًا أمامَ الرّبِّ ومسَحُوهُ مَلِكًا علَيهِم بِحسَبِ كلامِ الرّبِّ على لِسانِ صموئيلَ.<verse eid="1CH 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="1CH 11:4" />وسارَ داوُدُ ورِجالُه إلى أورُشليمَ أي يَبُوسَ حَيثُ كانَ اليَبوسيُّونَ، <verse eid="1CH 11:4" /><verse number="5" style="v" pubnumber="5" sid="1CH 11:5" />فقالوا لَه: ”لا يُمكِنُكَ أنْ تَدخُلَ إلى هُنا“. فاَحتَلَّ داوُدُ حِصْنَ صِهيونَ الّذي سُمِّيَ مدينةَ داوُدَ فيما بَعدُ. <verse eid="1CH 11:5" /><verse number="6" style="v" pubnumber="6" sid="1CH 11:6" />وقالَ في ذلِكَ اليومِ: ”كُلُّ مَنْ يَقتُلُ يَبُوسيًّا أوَّلًا يكونُ رئيسًا وقائِدًا“. فصعِد أوَّلًا يُوآبُ اَبنُ صَرُويَّةَ وقتَلَ يَبوسيًّا فصارَ رئيسًا. <verse eid="1CH 11:6" /><verse number="7" style="v" pubnumber="7" sid="1CH 11:7" />وأقامَ داوُدُ في الحِصْنِ وسَمَّاهُ مدينةَ داوُدَ. <verse eid="1CH 11:7" /><verse number="8" style="v" pubnumber="8" sid="1CH 11:8" />وبَنى المدينةَ مِنْ حَولِهِ، مِنْ مَلُو فما حَولَها، وجَدَّدَ يُوآبُ سائِرَ المدينةِ. <verse eid="1CH 11:8" /><verse number="9" style="v" pubnumber="9" sid="1CH 11:9" />وكانَ داوُدُ يزدادُ عظَمَةً، والرّبُّ القديرُ معَهُ.<verse eid="1CH 11:9" /></para>
  <para style="s1">مشاهير الأبطال</para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="1CH 11:10" />وهذِهِ أسماءُ القادةِ الأبطالِ الّذينَ ساعَدوا داوُدَ معَ جميعِ بَني إِسرائيلَ لِيُقيموهُ مَلِكًا كما قالَ الرّبُّ: <verse eid="1CH 11:10" /><verse number="11" style="v" pubnumber="11" sid="1CH 11:11" />يشُبْعامُ بنُ الحَكْمُونيُّ رئيسُ الثَّلاثَةِ الأبطالِ الّذي هَزَّ الرُّمحَ على ثَلاثِ مئَةٍ فقَتَلَهُم بِضربةٍ واحدةٍ. <verse eid="1CH 11:11" /><verse number="12" style="v" pubnumber="12" sid="1CH 11:12" />وبَعدَهُ ألعازارُ بنُ دودو بنِ أخُوخي، وهوَ أحدُ الثَّلاثةِ الأبطالِ. <verse eid="1CH 11:12" /><verse number="13" style="v" pubnumber="13" sid="1CH 11:13" />وكانَ معَ داوُدَ في فَسَّ دَمِّيمَ. وحشدَ الفلِسطيُّونَ جيشَهُم في حقلٍ مَزروعٍ شعيرًا، فاَنهَزَمَ رِجالُ إِسرائيلَ أمامَ الفلِسطيِّينَ. <verse eid="1CH 11:13" /><verse number="14" style="v" pubnumber="14" sid="1CH 11:14" />فوقَفَ ألعازارُ وسَطَ الحقلِ وأنقَذَ داوُدَ، وهزَمَ الفلِسطيِّينَ، فأحرَزَ الرّبُّ نَصرًا عظيمًا لإسرائيلَ.<verse eid="1CH 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="1CH 11:15" />وفي أوانِ الحَصادِ نزَلَ ثَلاثَةٌ مِنَ الثَّلاثينَ بطَلًا إلى داوُدَ في مَغارةِ عَدلَّامَ. وكانَ جيشُ الفِلسطيِّينَ مُخَيِّمًا في وادي رَفائيمَ، <verse eid="1CH 11:15" /><verse number="16" style="v" pubnumber="16" sid="1CH 11:16" />وكانَ داوُدُ في الحِصْنِ بَينَما كانَ مُعَسكَرُ الفلِسطيِّينَ في بَيتَ لَحمَ. <verse eid="1CH 11:16" /><verse number="17" style="v" pubnumber="17" sid="1CH 11:17" />فتَأوَّهَ داوُدُ وقالَ: ”مَنْ يَسقيني ماءً مِنْ بِئرِ بَيتَ لَحمَ الّتي عِندَ بابِ المدينةِ“. <verse eid="1CH 11:17" /><verse number="18" style="v" pubnumber="18" sid="1CH 11:18" />فاَختَرَقَ هؤلاءِ الأبطالُ الثَّلاثةُ مُعَسكرَ الفِلسطيِّينَ وحمَلوا ماءً مِنَ البِئرِ وجاؤوا بهِ إلى داوُدَ. فما شاءَ أنْ يشربَ مِنهُ، بل سكَبَهُ تَقدِمةً للرّبِّ وقالَ: <verse eid="1CH 11:18" /><verse number="19" style="v" pubnumber="19" sid="1CH 11:19" />”يا رَبُّ حَرامٌ عليَّ أنْ أفعَلَ هذا، لِئلَّا أكونَ كمَنْ يشربُ دَمَ رِجالٍ خاطَروا بِأنفُسِهِم“. هذا ما فعَلَ هؤلاءِ الأبطالُ الثَّلاثةُ.<verse eid="1CH 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="1CH 11:20" />ثُمَّ أبيشايُ أخو يُوآبَ واَبنُ صَرُويَّةَ وهوَ قائِدُ الثَّلاثينَ بطَلًا. وهذا سَدَّدَ رُمحَهُ على ثَلاثِ مئَةٍ وقتَلَهُم، وكانَ اَسمُهُ بَينَ الثَّلاثينَ. <verse eid="1CH 11:20" /><verse number="21" style="v" pubnumber="21" sid="1CH 11:21" />وهوَ أشهَرُهُم، وكانَ لهُم قائدًا، إلَّا أنَّهَ لم يَبلُغْ مَرتَبةَ الثَّلاثَةِ الأوَّلينَ.<verse eid="1CH 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="1CH 11:22" />ثُمَّ بَنايا بنُ يُوياداعَ المُقاتِلُ المِغوارُ، العظيمُ الفِعالِ مِنْ قَبصئيلَ، وهوَ الّذي قتَلَ جبَّارَينِ مِنْ جَبابِرةِ مُوآبَ، وأسدًا وسَطَ جُبٍّ في يومٍ مُثلِجٍ. <verse eid="1CH 11:22" /><verse number="23" style="v" pubnumber="23" sid="1CH 11:23" />وقتَلَ مِصْريًّا طُولُه خمسُ أذرعٍ في يَدِهِ رُمحٌ كنَولِ الحائِكِ فنازَلَهُ بالعصا وخطَفَ الرُّمحَ مِنْ يدِه وقتَلَهُ بهِ. <verse eid="1CH 11:23" /><verse number="24" style="v" pubnumber="24" sid="1CH 11:24" />هذا ما فعَلَهُ بنايا بنُ يُوياداعَ وكانَ أحدَ الأبطالِ الثَّلاثينَ. <verse eid="1CH 11:24" /><verse number="25" style="v" pubnumber="25" sid="1CH 11:25" />وكانَت شُهرَتُهُ تفوقُ شُهرَتَهُم جميعًا، إلَّا أنَّهُ لم يَبلُغْ مَرتَبةَ الثَّلاثَةِ الأوَّلينَ، فجَعَلَهُ داوُدُ قائدًا لِحرَسِهِ. <verse eid="1CH 11:25" /><verse number="26" style="v" pubnumber="26" sid="1CH 11:26" />وأبطالُ الجيشِ هُم: عَسائيلُ أخو يُوآبَ، وألحانانُ بنُ دودو مِنْ بَيْتَ لَحمَ، <verse eid="1CH 11:26" /><verse number="27" style="v" pubnumber="27" sid="1CH 11:27" />وشَمُّوتُ الهَرُوريُّ، وحَالِصُ الفَلونيُّ، <verse eid="1CH 11:27" /><verse number="28" style="v" pubnumber="28" sid="1CH 11:28" />وعيرا بنُ عَقِّيشَ التَّقوعيُّ، وأبيعَزَرُ العَناثوتيّ، <verse eid="1CH 11:28" /><verse number="29" style="v" pubnumber="29" sid="1CH 11:29" />وسِبْكايُ الحوشاتيُّ، وعيلايُ الآخوخيُّ، <verse eid="1CH 11:29" /><verse number="30" style="v" pubnumber="30" sid="1CH 11:30" />ومَهرايُ النَّطوفاتيُّ، وخالِدُ بنُ بَعنَةَ النَّطوفاتيُّ <verse eid="1CH 11:30" /><verse number="31" style="v" pubnumber="31" sid="1CH 11:31" />وإتَّايُ بنُ ريبايَ مِنْ جِبعَة بَني بنيامينَ، وبنايا الفَرعَتونيُّ، <verse eid="1CH 11:31" /><verse number="32" style="v" pubnumber="32" sid="1CH 11:32" />وحورايُ مِنْ أوديةِ جاعَشَ، وأبيئيلُ العرَباتيُّ، <verse eid="1CH 11:32" /><verse number="33" style="v" pubnumber="33" sid="1CH 11:33" />وعَزْموتُ البُحروميُّ، وإليَحْبَا الشَّعلَبونيُّ، <verse eid="1CH 11:33" /><verse number="34" style="v" pubnumber="34" sid="1CH 11:34" />وهاشِمُ الجَزُّونيُّ، ويوناثانُ بنُ شاجايَ الهَراريُّ، <verse eid="1CH 11:34" /><verse number="35" style="v" pubnumber="35" sid="1CH 11:35" />وأخيآمُ بنُ ساكارَ الهَراريُّ، وأليفالُ بنُ أورَ، <verse eid="1CH 11:35" /><verse number="36" style="v" pubnumber="36" sid="1CH 11:36" />وحافِرُ المكيراتيُّ، وأخيا الفَلونيُّ، <verse eid="1CH 11:36" /><verse number="37" style="v" pubnumber="37" sid="1CH 11:37" />وحَصْرُو الكَرمَليُّ، ونَعرايُ بنُ أزبايَ، <verse eid="1CH 11:37" /><verse number="38" style="v" pubnumber="38" sid="1CH 11:38" />ويوئيلُ أخو ناثانَ، وميحارُ بنُ هَجْري، <verse eid="1CH 11:38" /><verse number="39" style="v" pubnumber="39" sid="1CH 11:39" />وصالِقُ العَمُّونيُّ، ونَحرايُ البَئيروتيُّ حامِلُ سلاحِ يُوآبَ بنِ صَرويَّةَ، <verse eid="1CH 11:39" /><verse number="40" style="v" pubnumber="40" sid="1CH 11:40" />وعيرا اليِثريُّ، وجارِبُ اليثريُّ، <verse eid="1CH 11:40" /><verse number="41" style="v" pubnumber="41" sid="1CH 11:41" />وأوريَّا الحِثِّيُّ، وزابادُ بنُ أحلايَ، <verse eid="1CH 11:41" /><verse number="42" style="v" pubnumber="42" sid="1CH 11:42" />وعَدينا بنُ شيزا الرأوبينيُّ على رأسِ ثَلاثينَ مِنَ الرَّأوبينيِّينَ، <verse eid="1CH 11:42" /><verse number="43" style="v" pubnumber="43" sid="1CH 11:43" />وحانانُ بنُ مَعكةَ، ويوشافاطُ المَثْنيَّ، <verse eid="1CH 11:43" /><verse number="44" style="v" pubnumber="44" sid="1CH 11:44" />وعُزيَّا العَشتَروتيُّ، وشاماعُ ويَعُوئيلُ اَبنا حوتامَ العروعيريِّ، <verse eid="1CH 11:44" /><verse number="45" style="v" pubnumber="45" sid="1CH 11:45" />ويَديعيئيلُ بنُ شَمْري، ويوخا أخوهُ التِّيصيُّ، <verse eid="1CH 11:45" /><verse number="46" style="v" pubnumber="46" sid="1CH 11:46" />وإيليئيلُ مِنْ مَحويمَ ويَريبايُ ويوشويا اَبنا النَّعَمَ ويثمَةُ المُوآبيُّ <verse eid="1CH 11:46" /><verse number="47" style="v" pubnumber="47" sid="1CH 11:47" />وإيليئيلُ وعُوبيدُ ويَعسيئيلُ مِنْ صُوبَةَ.<verse eid="1CH 11:47" /></para>
  <chapter eid="1CH 11" />
  <chapter number="12" style="c" sid="1CH 12" />
  <para style="s1">أتباع داود البنياميون الأول</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="1CH 12:1" />وهؤلاءِ هُمُ الّذينَ اَنْضَمّوا إلى داوُدَ في صِقْلَغَ، وهوَ بَعدُ مُختَبِئٌ مِنْ وَجهِ شاوُلَ بنِ قَيشَ، وكانوا مِنَ الجَبابِرةِ الّذينَ أعانوهُ في الحربِ، <verse eid="1CH 12:1" /><verse number="2" style="v" pubnumber="2" sid="1CH 12:2" />يَرمُونَ الحجارةَ بالمِقلاعِ والسِّهامَ بالقَوسِ، سَواءٌ باليَمينِ أو باليَسارِ. فمِنْ أنسباءِ شاوُلَ البنيامينيِّ: <verse eid="1CH 12:2" /><verse number="3" style="v" pubnumber="3" sid="1CH 12:3" />الرئيسُ أخيعَزَرُ بنُ شماعَةَ الجِبْعيُّ وأخوهُ يُوآشُ، ويَزوئيلُ بنُ عَزموتَ وأخوهُ فالَطُ، وبَراخَةُ وياهو مِنْ عناثوثَ، <verse eid="1CH 12:3" /><verse number="4" style="v" pubnumber="4" sid="1CH 12:4" />ويَشمَعْيا الجِبعونيُّ أحدُ الجَبابِرةِ الثَّلاثينَ ورئيسُهُم، <verse eid="1CH 12:4" /><verse number="5" style="v" pubnumber="5" sid="1CH 12:5" />ويَرْميا ويَحْزيئيلُ ويوحانانُ ويوزابادُ مِنْ جَديرةَ، <verse eid="1CH 12:5" /><verse number="6" style="v" pubnumber="6" sid="1CH 12:6" />وإلعُوازيُ ويَريموثُ بَعْليا وشَمَرْيا وشَفَطْيا مِنْ حروفَ، <verse eid="1CH 12:6" /><verse number="7" style="v" pubnumber="7" sid="1CH 12:7" />وألقانَةُ ويَشيَّا وعَزْرئيلُ ويوعَزَرُ ويَشُبْعامُ مِنْ عَشيرةِ قورَحَ، <verse eid="1CH 12:7" /><verse number="8" style="v" pubnumber="8" sid="1CH 12:8" />ويوعيلَةُ بنُ روحامَ وأخوهُ زَبَدْيا مِنْ جَدورَ.<verse eid="1CH 12:8" /></para>
  <para style="s1">أتباع داود الجاديون</para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="1CH 12:9" />وحينَ كانَ داوُدُ في الحِصْنِ في البرِّيَّةِ اَلتَحَقَ بهِ مِنَ الجاديِّينَ جَبابِرةُ حربٍ، حامِلو تُروسٍ ورِماحٍ، وجوهُهُم كوُجُوهِ الأُسودِ، كوعولِ الجِبالِ خِفَّةً، وهُم: <verse eid="1CH 12:9" /><verse number="10" style="v" pubnumber="10" sid="1CH 12:10" />الرَّئيسُ عازَرُ، والثَّاني عوبديا، والثَّالِثُ أليآبُ، <verse eid="1CH 12:10" /><verse number="11" style="v" pubnumber="11" sid="1CH 12:11" />والرَّابِعُ مِشْمِنَّةُ، والخامِسُ يَرْميا، <verse eid="1CH 12:11" /><verse number="12" style="v" pubnumber="12" sid="1CH 12:12" />والسَّادِسُ عَنَّايُ، والسَّابِعُ إيليئيلُ، <verse eid="1CH 12:12" /><verse number="13" style="v" pubnumber="13" sid="1CH 12:13" />والثَّامِنُ يوحانانُ، والتَّاسِعُ ألزابادُ، <verse eid="1CH 12:13" /><verse number="14" style="v" pubnumber="14" sid="1CH 12:14" />والعاشِرُ يَرْميا، والحادي عشَرَ مَخبَنَّايُ. <verse eid="1CH 12:14" /><verse number="15" style="v" pubnumber="15" sid="1CH 12:15" />هؤلاءِ الجاديُّونَ كانوا قُوَّادًا في الجيشِ: أصغَرُهُم قائدٌ على مئَةٍ وأكبَرُهُم على ألفٍ <verse eid="1CH 12:15" /><verse number="16" style="v" pubnumber="16" sid="1CH 12:16" />هؤلاءِ عَبَرُوا الأردُنَّ في الشَّهرِ الأوَّلِ مِنَ السَّنةِ وهوَ طافِحٌ مِنْ جميعِ ضِفافِهِ وهَزَموا جميعَ مَنْ في الأوديةِ إلى الشَّرقِ والغربِ.<verse eid="1CH 12:16" /></para>
  <para style="s1">أتباع داود من بني بنيامين ويهوذا</para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="1CH 12:17" />وجاءَ قَومٌ مِنْ بَني بَنيامينَ ويَهوذا إلى داوُدَ في حِصْنِهِ، <verse eid="1CH 12:17" /><verse number="18" style="v" pubnumber="18" sid="1CH 12:18" />فخَرَجَ للقائِهِم وقالَ لهُم: ”إنْ كانَ مَجيئُكُم إليَّ للسِّلْمِ والتَّأييدِ، فأهلًا وسَهلًا بِكُم، وإنْ كانَ لِتَسليمي إلى عَدُوِّي وما فعَلْتُ سُوءًا، فإلَهُ آبائِنا يشهَدُ ويَحكُمُ علَيكُم“. <verse eid="1CH 12:18" /><verse number="19" style="v" pubnumber="19" sid="1CH 12:19" />فحَلَّ روحُ اللهِ على عماسايَ، رئيسِ الثَّلاثينَ جبَّارًا، فقالَ:</para>
  <para style="p" vid="1CH 12:19">”نحنُ لكَ يا داوُدُ</para>
  <para style="p" vid="1CH 12:19">ومَعَكَ يا اَبنَ يَسَّى.</para>
  <para style="p" vid="1CH 12:19">سلامٌ، سلامٌ لكَ،</para>
  <para style="p" vid="1CH 12:19">وسلامٌ لِمَنْ يُناصِرُكَ،</para>
  <para style="p" vid="1CH 12:19">لأنَّ إلهَكَ نَصيرُكَ“.</para>
  <para style="p" vid="1CH 12:19">فقَبِلَهُم داوُدُ وجعَلَهُم قادةً في جيشِهِ.<verse eid="1CH 12:19" /></para>
  <para style="s1">أتباع داود من بني منسى</para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="1CH 12:20" />واَنحازَ قَومٌ مِنْ بَني منَسَّى إلى داوُدَ، حينَ جاءَ لِمُحارَبةِ شاوُلَ ومعَهُ الفِلسطيُّونَ، ولم يُساعِدوهُم، لأنَّ مُلوكَ الفِلسطيِّينَ تَشاوروا فيما بَينَهُم وقالوا: ”ماذا لو رَجَعَ إلى سيِّدِهِ شاوُلَ؟ ألا يَرجِعُ إليهِ بِرؤوسِنا؟“ <verse eid="1CH 12:20" /><verse number="21" style="v" pubnumber="21" sid="1CH 12:21" />وعِندَ ذهابِ داوُدَ إلى صِقْلَغَ اَنضَمَّ إليهِ مِنْ بَني منَسَّى عَدناحُ ويوزابادُ ويَديَعئيلُ وميخائيلُ ويوزابادُ وأليهو وصِلْتايُ، وهُم قادةُ ألوفٍ في بَني منَسَّى، <verse eid="1CH 12:21" /><verse number="22" style="v" pubnumber="22" sid="1CH 12:22" />وناصَروه كقادةٍ في جيشِهِ، وكانوا كُلُّهُم جَبابِرةً أشدَّاءَ. <verse eid="1CH 12:22" /><verse number="23" style="v" pubnumber="23" sid="1CH 12:23" />وكانَ لا يمضي يومٌ إلَّا ويأتيهِ الأنصارُ، حتّى صاروا جيشًا عظيمًا.<verse eid="1CH 12:23" /></para>
  <para style="s1">جيش داود</para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="1CH 12:24" />وهذا عَدَدُ المُحاربينَ الّذينَ اَنْضَمُّوا إلى داوُدَ في حبرونَ، ليُحَوِّلوا إليهِ مُلْكَ شاوُلَ على حسَبِ قولِ الرّبِّ: <verse eid="1CH 12:24" /><verse number="25" style="v" pubnumber="25" sid="1CH 12:25" />بَنو يَهوذا: سِتَّةُ آلافٍ وثماني مئَة مُجَهَّزٍ للقِتالِ مِنْ حامِلي التُّروسِ والرِّماحِ. <verse eid="1CH 12:25" /><verse number="26" style="v" pubnumber="26" sid="1CH 12:26" />ومِنْ بَني شِمعونَ: سبعةُ آلافٍ ومئَةُ جبَّارٍ مُدرَّبٍ على القِتالِ. <verse eid="1CH 12:26" /><verse number="27" style="v" pubnumber="27" sid="1CH 12:27" />ومِنْ بَني لاويّ: أربعةُ آلافٍ وسِتُّ مئَةٍ، <verse eid="1CH 12:27" /><verse number="28" style="v" pubnumber="28" sid="1CH 12:28" />فَضلًا عَنْ ثَلاثةِ آلافٍ وسَبعِ مئَةٍ معَ يوياداعَ رئيسِ المُنتَسِبينَ إلى هرونَ، <verse eid="1CH 12:28" /><verse number="29" style="v" pubnumber="29" sid="1CH 12:29" />وعَن اثنينِ وعشرينَ قائدًا معَ صادوقَ، وهوَ فتىً جبَّارٌ، يَنتَسِبون إلى عائِلَتِهِ. <verse eid="1CH 12:29" /><verse number="30" style="v" pubnumber="30" sid="1CH 12:30" />ومِنْ بَني بنيامينَ أنسِباءِ شاوُلَ: ثَلاثةُ آلافٍ، لأنَّ مُعظَمَ أنسِبائِهِ كانوا إلى الآنَ مُوالينَ لَه. <verse eid="1CH 12:30" /><verse number="31" style="v" pubnumber="31" sid="1CH 12:31" />ومِنْ بَني أفرايمَ: عشرونَ ألفًا وثماني مئَةِ جبَّارٍ مِنَ الجَبابِرةِ المَشهودِ لهُم في عائلاتِهِم. <verse eid="1CH 12:31" /><verse number="32" style="v" pubnumber="32" sid="1CH 12:32" />ومِنْ نِصْفِ سِبْطِ منَسَّى: ثمانيةَ عشَرَ ألفًا اَختيروا ليُقيمُوا داوُدَ مَلِكًا. <verse eid="1CH 12:32" /><verse number="33" style="v" pubnumber="33" sid="1CH 12:33" />ومِنْ بَني يَسَّاكرَ: مئَتا قائدٍ، جميعُ أنسبائِهِم تَحتَ أمرِهِم، ولهُم عِلْمٌ بِما يَجِبُ أنْ يَفعَلَهُ بَنو إِسرائيلَ، وبالوقتِ المُناسِبِ لِفِعْلِهِ. <verse eid="1CH 12:33" /><verse number="34" style="v" pubnumber="34" sid="1CH 12:34" />ومِنْ بَني زَبولونَ: خمسونَ ألفًا مِمَّنْ يَخرُجونَ لِلحربِ ويَستَعِدُّونَ لِلقِتالِ بِقلبٍ واحدٍ، <verse eid="1CH 12:34" /><verse number="35" style="v" pubnumber="35" sid="1CH 12:35" />ومِنْ بَني نَفتالي: ألفُ قائدٍ ومعَهُم سبعةٌ وثَلاثونَ ألفًا بِالتُّروسِ والرِّماحِ. <verse eid="1CH 12:35" /><verse number="36" style="v" pubnumber="36" sid="1CH 12:36" />ومِنْ بَني دانَ: ثمانيةٌ وعشرونَ ألفًا وَسِتُّ مئَةٍ جاهِزون لِلقِتالِ. <verse eid="1CH 12:36" /><verse number="37" style="v" pubnumber="37" sid="1CH 12:37" />ومِنْ بَني أشيرَ أربعونَ ألفًا مِمَّنْ يَخرُجونَ لِلحربِ ويَستَعِدُّونَ للقِتالِ. <verse eid="1CH 12:37" /><verse number="38" style="v" pubnumber="38" sid="1CH 12:38" />ومِنْ شرقيِّ الأردُنِّ: مئَةٌ وعشرونَ ألفًا مِنْ بَني رَأوبينَ وبَني جادَ وبَني نِصفِ منَسَّى، مُسَلَّحينَ بِجميعِ أدَواتِ الحربِ.<verse eid="1CH 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" pubnumber="39" sid="1CH 12:39" />هؤلاءِ جميعُهُم رِجالُ حربٍ مُستَعِدُّونَ لِلقِتالِ، جاؤوا إلى حبرونَ بِقلوبٍ مَليئَةٍ بِحُسْنِ النِّيَّةِ لِيُقيموا داوُدَ مَلِكًا على جميعِ بَني إِسرائيلَ وكانَ سائِرُ بَني إِسرائيلَ أيضًا قَلبًا واحدًا في هذِهِ الغايةِ. <verse eid="1CH 12:39" /><verse number="40" style="v" pubnumber="40" sid="1CH 12:40" />وأقاموا هُناكَ معَ داوُدَ ثَلاثةَ أيّامٍ، يأكلونَ ويشربونَ مِمَّا أعَدَّهُ لهُم بَنو قَومِهِم مِنَ الطَّعامِ والشَّرابِ. <verse eid="1CH 12:40" /><verse number="41" style="v" pubnumber="41" sid="1CH 12:41" />وكذلِكَ أقرباؤُهُم، حتّى بَنو يَسَّاكرَ وزَبولونَ ونَفتالي كانوا يأتونَ بخُبزٍ على الحميرِ والجِمالِ والبِغالِ والبقَرِ، وبِطَعامٍ مِنْ دَقيقٍ وأقراصِ تينٍ وعناقيدِ زبيبٍ، وبخمرٍ وزيتٍ وبقَرٍ وغنَمٍ كثيرٍ، لأنَّهُ كانَ فرَحٌ في أرضِ إِسرائيلَ.<verse eid="1CH 12:41" /></para>
  <chapter eid="1CH 12" />
  <chapter number="13" style="c" sid="1CH 13" />
  <para style="s1">نقل تابوت العهد</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="1CH 13:1" />وتَشاوَرَ داوُدُ معَ جميعِ قادةِ المِئاتِ والألوفِ <verse eid="1CH 13:1" /><verse number="2" style="v" pubnumber="2" sid="1CH 13:2" />ثُمَّ قالَ لِكُلِّ المُجتمعينَ مِنْ بَني إِسرائيلَ: ”إنْ كُنتُم تُوافِقونَ وكانَت هذِهِ هيَ مَشيئةُ الرّبِّ إلهِنا، فلنُرسِلْ إلى سائِرِ بَني قَومِنا في أرضِ إِسرائيلَ كُلِّها، وإلى الكهَنةِ واللَّاويِّينَ في مُدُنِهِم، ليَجتَمِعوا إلينا، <verse eid="1CH 13:2" /><verse number="3" style="v" pubnumber="3" sid="1CH 13:3" />فنُرجِعَ تابوتَ عَهدِ إلهِنا الّذي أهمَلْناهُ في أيّامِ شاوُلَ“. <verse eid="1CH 13:3" /><verse number="4" style="v" pubnumber="4" sid="1CH 13:4" />فحَسُنَ ذلِكَ في عيونِ المُجتمِعينَ كُلِّهِمِ ووافَقوا علَيهِ.<verse eid="1CH 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="1CH 13:5" />وجمَعَ داوُدُ كُلَّ رجالِ إِسرائيلَ مِنْ حدودِ مِصْرَ إلى ليبو حَماةَ لِنَقْلِ تابوتِ عَهدِ الرّبِّ مِنْ قريَةِ يعاريمَ إلى أورُشليمَ <verse eid="1CH 13:5" /><verse number="6" style="v" pubnumber="6" sid="1CH 13:6" />وسارَ بِهِم إلى بَعلَةَ أي قريةِ يَعاريمَ في يَهوذا ليَحمِلوا مِنْ هُناكَ تابوتَ عَهدِ اللهِ الجالِس على الكروبيمِ. <verse eid="1CH 13:6" /><verse number="7" style="v" pubnumber="7" sid="1CH 13:7" />فحَمَلوهُ على مَركبةٍ جديدةٍ وجاؤوا بهِ مِنْ بَيتِ أبينادابَ وكانَ عُزَّةُ وأخيو، اَبنا أبينادابَ، يَسوقانِ المَركبةَ. <verse eid="1CH 13:7" /><verse number="8" style="v" pubnumber="8" sid="1CH 13:8" />وكانَ داوُدُ وجميعُ بَني إِسرائيلَ يَرقُصونَ بِكُلِّ قِواهُم ويُنشِدونَ على أنغامِ القيثاراتِ والرَّبابِ والدُّفوفِ والجنّوكِ والصُّنوجِ. <verse eid="1CH 13:8" /><verse number="9" style="v" pubnumber="9" sid="1CH 13:9" />فلمَّا وصَلوا إلى بَيدَرِ كيدونَ عثَرَتِ الثِّيرانُ، فمَدَّ عُزَّةُ يَدَهُ إلى تابوتِ عَهدِ اللهِ وأمسَكَهُ. <verse eid="1CH 13:9" /><verse number="10" style="v" pubnumber="10" sid="1CH 13:10" />فاَشتَدَّ غضَبُ الرّبِّ على عُزَّةَ وضرَبَهُ لأنَّهُ مَدَّ يَدَهُ إلى التَّابوتِ، فماتَ هُناكَ أمامَ اللهِ. <verse eid="1CH 13:10" /><verse number="11" style="v" pubnumber="11" sid="1CH 13:11" />فاَغتاظَ داوُدُ لأنَّ الرّبَّ ضرَبَ عُزَّةَ، ولِذلِكَ دُعي ذلِكَ المَوضِعُ فارَصَ عُزَّةَ إلى هذا اليومِ. <verse eid="1CH 13:11" /><verse number="12" style="v" pubnumber="12" sid="1CH 13:12" />وخافَ داوُدُ مِنَ الرّبِّ في ذلِكَ اليوم وقالَ: ”كيفَ أُبقي تابوتَ عَهدِ الرّبِّ عِندي؟“ <verse eid="1CH 13:12" /><verse number="13" style="v" pubnumber="13" sid="1CH 13:13" />ولم يشَأْ داوُدُ أنْ يأخُذَهُ معَهُ إلى أورُشليمَ، فوَضَعَهُ في بَيتِ عُوبيدَ آدومَ الجِتِّيِّ. <verse eid="1CH 13:13" /><verse number="14" style="v" pubnumber="14" sid="1CH 13:14" />فبَقيَ تابوتُ عَهدِ الرّبِّ هُناكَ ثَلاثةَ أشهُرٍ، فبارَكَ الرّبُّ بَيتَ عوبيدَ أدومَ وكُلَّ ما لَه.<verse eid="1CH 13:14" /></para>
  <chapter eid="1CH 13" />
  <chapter number="14" style="c" sid="1CH 14" />
  <para style="s1">داود ينتصر على الفلسطيين</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="1CH 14:1" />وأرسلَ حيرامُ مَلِكُ صورَ وَفدًا إلى داوُدَ وأخشابَ أرزٍ ونَجَّارينَ ونَحَّاتينَ، فبَنَوا قصرَ داوُدَ. <verse eid="1CH 14:1" /><verse number="2" style="v" pubnumber="2" sid="1CH 14:2" />وعرَفَ داوُدُ أنَّ الرّبَّ أقَرَّهُ مَلِكًا على بَني إِسرائيلَ وعَظُمَ مُلْكُه مِنْ أجلِ شعبِهِ. <verse eid="1CH 14:2" /><verse number="3" style="v" pubnumber="3" sid="1CH 14:3" />واَتَّخَذَ لَه جواريَ وزوجاتٍ مِنْ أورُشليمَ، ووُلِدَ لَه بَنونَ وبَناتٌ. <verse eid="1CH 14:3" /><verse number="4" style="v" pubnumber="4" sid="1CH 14:4" />وهذِهِ أسماءُ المَولودينَ لَه في أورُشليمَ: شَمُّوعُ وشوبابُ وناثانُ وسُليمانُ <verse eid="1CH 14:4" /><verse number="5" style="v" pubnumber="5" sid="1CH 14:5" />ويبحارُ وأليشوعُ <verse eid="1CH 14:5" /><verse number="6" style="v" pubnumber="6" sid="1CH 14:6" />وألِفالِط ونَوجَهُ ونافَجُ ويافيعُ <verse eid="1CH 14:6" /><verse number="7" style="v" pubnumber="7" sid="1CH 14:7" />وأليشَمَعُ وألياداعُ وأليفَلَطُ.<verse eid="1CH 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="1CH 14:8" />وسَمِعَ الفلِسطيُّونَ أنَّ داوُدَ مُسِحَ مَلِكًا على جميعِ إِسرائيلَ، فصَعِدوا لِمُحاربَتِهِ. فعَلِمَ داوُدُ بِذلِكَ، فنَزَلَ إلى مَوقِعٍ حصينٍ. <verse eid="1CH 14:8" /><verse number="9" style="v" pubnumber="9" sid="1CH 14:9" />وجاءَ الفلِسطيُّونَ واَنْتَشَروا في وادي الرَّفائيمِ. <verse eid="1CH 14:9" /><verse number="10" style="v" pubnumber="10" sid="1CH 14:10" />فسألَ داوُدُ الرّبَّ: ”هل أصعَدُ لِمُحاربَةِ الفلِسطيِّينَ؟ وهل تُسَلِّمُهُم إلى يَدي؟“ فقالَ لَه الرّبُّ: ”إصعَدْ، فأُسَلِّمَ الفلِسطيِّينَ إلى يَدِكَ“. <verse eid="1CH 14:10" /><verse number="11" style="v" pubnumber="11" sid="1CH 14:11" />وزحَفَ داوُدُ إلى بَعلَ فراصيمَ وضرَبَهُم هُناكَ وقالَ: ”بيدي أجتاحُ أعدائي كالسَّيلِ“. ولِذلِكَ سُمِّيَ ذلِكَ المَوضِعُ بَعلَ فراصيمَ. <verse eid="1CH 14:11" /><verse number="12" style="v" pubnumber="12" sid="1CH 14:12" />وترَكَ الفلِسطيُّونَ أصنامَهُم هُناكَ، فأمَرَ داوُدُ رِجالَهُ فَأحرقوها بالنَّارِ.<verse eid="1CH 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="1CH 14:13" />وعادَ الفلِسطيُّونَ واَنتَشَروا في وادي الرَّفائيمِ. <verse eid="1CH 14:13" /><verse number="14" style="v" pubnumber="14" sid="1CH 14:14" />فسألَ داوُدُ الرّبَّ عَمَّا يَفعَلُهُ، فأجابَهُ: ”لا تُهاجِمْهُم وجهًا لِوجهٍ، بل مِنْ خَلفِهِم، مِنْ تُجاهِ أشجارِ البَلسَمِ. <verse eid="1CH 14:14" /><verse number="15" style="v" pubnumber="15" sid="1CH 14:15" />فإذا سَمِعْتَ صوتَ خطواتٍ في رُؤوسِ أشجارِ البَلسَمِ فتَقَدَّمْ، لأنَّ الرّبَّ خرَجَ أمامَكَ لِضَربِ مُعَسكَرِهِم“. <verse eid="1CH 14:15" /><verse number="16" style="v" pubnumber="16" sid="1CH 14:16" />ففَعَلَ داوُدُ كما أمرَهُ الرّبُّ وضرَبَ الفِلسطيِّينَ مِنْ جِبعونَ إلى مَدخَلِ جازَرَ. <verse eid="1CH 14:16" /><verse number="17" style="v" pubnumber="17" sid="1CH 14:17" />واَنتَشَرَ اَسمُ داوُدَ في كُلِّ الأرضِ وجعَلَ الرّبُّ جميعَ الأمَمِ يَهابونَهُ.<verse eid="1CH 14:17" /></para>
  <chapter eid="1CH 14" />
  <chapter number="15" style="c" sid="1CH 15" />
  <para style="s1">الاستعداد لنقل تابوت العهد</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="1CH 15:1" />وبَنى داوُدُ لَه بيوتًا في مدينةِ داوُدَ وهَيَّأَ مَوضِعًا لِتابوتِ عَهدِ اللهِ ونصَبَ لَه خَيمةً. <verse eid="1CH 15:1" /><verse number="2" style="v" pubnumber="2" sid="1CH 15:2" />ثُمَّ قالَ: ”لا يَحمِلُ تابوتَ العَهدِ غَيرُ اللَّاويِّين، لأنَّ الرّبَّ اَختارَهُم ليَحمِلوهُ ويَخدِموهُ إلى الأبدِ“. <verse eid="1CH 15:2" /><verse number="3" style="v" pubnumber="3" sid="1CH 15:3" />وجمَعَ داوُدُ كُلَّ بَني إِسرائيلَ إلى أورُشليمَ لإصعادِ تابوتِ العَهدِ إلى المكانِ الّذي هيَّأهُ لَه. <verse eid="1CH 15:3" /><verse number="4" style="v" pubnumber="4" sid="1CH 15:4" />واَستَدعَى داوُدُ بَني هرونَ واللَّاويِّينَ، <verse eid="1CH 15:4" /><verse number="5" style="v" pubnumber="5" sid="1CH 15:5" />فجاءَ مِنْ بَني قَهاتَ مئَةٌ وعشرونَ رَجُلًا وعلى رأسِهِم أوريئيلُ، <verse eid="1CH 15:5" /><verse number="6" style="v" pubnumber="6" sid="1CH 15:6" />ومِنْ بَني مَراري مِئتانِ وعشرونَ وعلى رأسِهِم عَسايا، <verse eid="1CH 15:6" /><verse number="7" style="v" pubnumber="7" sid="1CH 15:7" />ومِنْ بَني جِرشومَ مئَةٌ وثَلاثونَ وعلى رأسِهِم يوئيلُ، <verse eid="1CH 15:7" /><verse number="8" style="v" pubnumber="8" sid="1CH 15:8" />ومِنْ بَني أليصافانَ مئَتانِ وعلى رأسِهِم شمَعْيا، <verse eid="1CH 15:8" /><verse number="9" style="v" pubnumber="9" sid="1CH 15:9" />ومِنْ بَني حبرونَ ثمانونَ وعلى رأسِهِم إيليئيلُ، <verse eid="1CH 15:9" /><verse number="10" style="v" pubnumber="10" sid="1CH 15:10" />ومِنْ بَني عُزِّيئيلَ مئَةٌ واَثنا عشَرَ وعلى رأسِهِم عَمِّينادابُ. <verse eid="1CH 15:10" /><verse number="11" style="v" pubnumber="11" sid="1CH 15:11" />واَستَدعى داوُدُ الكاهنَينِ صادوقَ وأبياثارَ واللَّاويِّينَ أوريئيلَ وعَسايا ويُوئيلَ وشَمَعْيا وإيليئيلَ وعَمِّينادابَ <verse eid="1CH 15:11" /><verse number="12" style="v" pubnumber="12" sid="1CH 15:12" />وقالَ لهُم: ”أنتُم رؤساءُ بيوتِ آبائِكُم اللَّاويِّينَ، فطَهِّروا أنفُسَكُم أنتُم وأنسباؤُكُم اللَّاويُّونَ لِتُصعِدوا تابوتَ عَهدِ الرّبِّ إلهِ إِسرائيلَ إلى المَوضِعِ الّذي هَيَّأتُهُ لَه. <verse eid="1CH 15:12" /><verse number="13" style="v" pubnumber="13" sid="1CH 15:13" />فلأنَّكُم لم تكونوا هُناكَ لِتَحمِلوهُ في المَرَّةِ الأولى، عاقبَنا الرّبُّ إلهُنا لأنَّنا لم نَعبُدْهُ حَسبَما أمرَ بهِ“. <verse eid="1CH 15:13" /><verse number="14" style="v" pubnumber="14" sid="1CH 15:14" />فطَهَّرَ الكهَنةُ واللَّاويُّونَ أنفُسَهُم لِيُصعِدوا تابوتَ عَهدِ الرّبِّ إلهِ إِسرائيلَ. <verse eid="1CH 15:14" /><verse number="15" style="v" pubnumber="15" sid="1CH 15:15" />وحمَلَهُ اللَّاويُّونَ بِقضيبٍ مِنْ هُنا وقضيبٍ مِنْ هُناكَ، كما أمرَ الرّبُّ على لِسانِ موسى.<verse eid="1CH 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="1CH 15:16" />وأمرَ داوُدُ رُؤساءَ اللَّاويِّينَ أنْ يُعَيِّنوا مِنْ أنسِبائِهِم مُغَنِّينَ ولاعِبينَ بِآلاتِ الغِناءِ، بالقيثاراتِ والرَّبابِ والصُّنوجِ، لِرَفْعِ أصواتِ الفرحِ. <verse eid="1CH 15:16" /><verse number="17" style="v" pubnumber="17" sid="1CH 15:17" />فاَختارَ اللَّاويُّونَ هَيمانَ بنَ يوئيلَ، ومِنْ أنسِبائِهِ آسافَ بنَ بَرَكْيا وأثيانَ بنَ قوشَيا مِنْ بَني مَراري. <verse eid="1CH 15:17" /><verse number="18" style="v" pubnumber="18" sid="1CH 15:18" />واَختاروا لِمُساعَدَتِهِم مِنَ اللَّاويِّينَ زكَرِيّا ويَعْزئيلَ وشَميراموثَ ويَحيئيلَ وعُنَّي وأليآبَ وبَنايا ومَعَسْيا ومَتَّثِيَّا وأليفلْيا ومَقْنَيا، وعوبيدَ أدومَ ويَعيئيلَ البَوَّابَينِ. <verse eid="1CH 15:18" /><verse number="19" style="v" pubnumber="19" sid="1CH 15:19" />فكانَ المُغَنُّونَ هَيمانُ وآسافُ وإثيانُ يضرِبونَ بِصُنوجِ النُّحاسِ، <verse eid="1CH 15:19" /><verse number="20" style="v" pubnumber="20" sid="1CH 15:20" />وزكريّا ويَعزئيلُ وشَميرامُوثُ ويَحيئيلُ وعُنِّي وأليآبُ ومَعَسْيا وبَنايا يلعَبونَ بالرَّبابِ على النَّغَمِ العالي، <verse eid="1CH 15:20" /><verse number="21" style="v" pubnumber="21" sid="1CH 15:21" />ومَتَّثِيَّا وأليفَلْيا ومِقْنيا وعوبيدُ أدومُ ويَعيئيلُ يلعَبونَ بالقيثاراتِ على النَّغَمِ الواطِئِ. <verse eid="1CH 15:21" /><verse number="22" style="v" pubnumber="22" sid="1CH 15:22" />وكانَ كَننيا، رئيسُ اللَّاويِّينَ في الغِناءِ، يُدَرِّبُهُم على الغِناءِ لأنَّهُ كانَ خبيرًا بهِ. <verse eid="1CH 15:22" /><verse number="23" style="v" pubnumber="23" sid="1CH 15:23" />وكانَ بَرَكْيا وألقانَةُ بوَّابَينِ لِتابوتِ العَهدِ، <verse eid="1CH 15:23" /><verse number="24" style="v" pubnumber="24" sid="1CH 15:24" />وكانَ شَبَنْيا ويوشافاطُ ونَثَنَئيلُ وعَماسايُ وزَكَريّا وبَنايا وأليعَزَرُ الكهَنةُ يَنفُخونَ بالأبواقِ أمامَ تابوتِ العَهدِ، وعوبيدُ أدومُ ويَحيا يَحرسانِ التَّابوتَ.<verse eid="1CH 15:24" /></para>
  <para style="s1">انتقال تابوت العهد إلى أورشليم</para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="1CH 15:25" />وذهَبَ داوُدُ وشيوخُ بَني إِسرائيلَ وقادةُ الألوفِ إلى بَيتِ عوبيدَ أدومَ ليُصعِدوا تابوتَ عَهدِ الرّبِّ بِفرحٍ عظيمٍ. <verse eid="1CH 15:25" /><verse number="26" style="v" pubnumber="26" sid="1CH 15:26" />وذبَحُوا سَبعةَ عُجولٍ وسَبعةَ كِباشٍ ليُعيِّنَ اللهُ اللَّاويِّينَ حامِلي التَّابوتِ. <verse eid="1CH 15:26" /><verse number="27" style="v" pubnumber="27" sid="1CH 15:27" />وكانَ داوُدُ وجميعُ اللَّاويِّينَ حامِلي التَّابوتِ والمُغَنُّونَ وكَنَنْيا رئيسُهُم لابسينَ جُبَبًا مِنْ كَتَّانٍ. وكانَ على داوُدَ أفودٌ مِنْ كَتَّانٍ. <verse eid="1CH 15:27" /><verse number="28" style="v" pubnumber="28" sid="1CH 15:28" />فأصعَدَ بَنو إِسرائيلَ جميعُهُمُ التَّابوتَ بالهُتافِ وبِصوتِ الصُّورِ والأبواقِ والصُّنوجِ والرَّبابِ والقيثاراتِ.<verse eid="1CH 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="1CH 15:29" />فلمَّا دخَلَ تابوتُ عَهدِ الرّبِّ مدينةَ داوُدَ أطَلَّت ميكالُ اَبنَةُ شاوُلَ مِنَ النَّافِذةِ، فرَأتِ المَلِكَ داوُدَ يرقصُ ويلعبُ فاَحتَقَرتْهُ في قلبِها.<verse eid="1CH 15:29" /></para>
  <chapter eid="1CH 15" />
  <chapter number="16" style="c" sid="1CH 16" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="1CH 16:1" />وأخَذوا تابوتَ العَهدِ ووضَعوهُ وسَطَ الخَيمةِ الّتي نَصَبَها لَه داوُدُ، وقدَّموا مُحرَقاتٍ وذبائحَ سلامَةٍ أمامَ الرّبِّ. <verse eid="1CH 16:1" /><verse number="2" style="v" pubnumber="2" sid="1CH 16:2" />ولمَّا فرَغَ داوُدُ مِنْ تقديمِ المُحرَقاتِ وذبائِحِ السَّلامةِ، بارَكَ الشَّعبَ باَسمِ الرّبِّ <verse eid="1CH 16:2" /><verse number="3" style="v" pubnumber="3" sid="1CH 16:3" />ووَزَّعَ على كُلِّ واحدٍ مِنهُم، رِجالًا ونِساءً، رغيفَ خُبزٍ وكَمشَةً مِنَ البَلَحِ والزَّبيبِ.<verse eid="1CH 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="1CH 16:4" />وأقامَ داوُدُ مِنَ اللَّاويِّينَ خُدَّامًا أمامَ تابوتِ العَهدِ ليَذكُروا ويَحمَدوا الرّبَّ إلهَ إِسرائيلَ ويُسَبِّحُوهُ. <verse eid="1CH 16:4" /><verse number="5" style="v" pubnumber="5" sid="1CH 16:5" />وذلِكَ بِقيادةِ آسافَ بالصُّنوجِ يُساعِدُه زَكَريّا، ومُشارَكةِ يَعيئيلَ وشميراموثَ ويَحيئيلَ ومَتَثِيَّا وأليآبَ ونبايا وعوبيدَ أدومَ ويَعْزئيلَ بآلاتٍ مِنَ الرَّبابِ والقيثاراتِ، <verse eid="1CH 16:5" /><verse number="6" style="v" pubnumber="6" sid="1CH 16:6" />وبَنايا ويَحزيئيلَ الكاهِنينِ بالأبواقِ دائمًا أمامَ تابوتِ العَهدِ. <verse eid="1CH 16:6" /><verse number="7" style="v" pubnumber="7" sid="1CH 16:7" />وفي ذلِكَ الحينِ كلَّفَ داوُدُ آسافَ وأفرادَ فِرقَتِهِ بِتَسبيحِ الرّبِّ بِهذا النَّشيدِ:<verse eid="1CH 16:7" /></para>
  <para style="s1">نشيد حمد</para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="1CH 16:8" />إحمَدُوا الرّبَّ واَدعوا بِاَسمِهِ</para>
  <para style="p" vid="1CH 16:8">وفي الشُّعوبِ بِأعمالِهِ حَدِّثوا.<verse eid="1CH 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="1CH 16:9" />أنشِدوا لَه ورَتِّلوا</para>
  <para style="p" vid="1CH 16:9">وتأمَّلوا في جميعِ عجائِبِه.<verse eid="1CH 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="1CH 16:10" />تَباهَوا باَسمِهِ القُدُّوسِ،</para>
  <para style="p" vid="1CH 16:10">ولتَفرَحْ قلوبُ طالِبي الرّبِّ.<verse eid="1CH 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="1CH 16:11" />اَطلُبوا الرّبَّ وعِزَّتَهُ،</para>
  <para style="p" vid="1CH 16:11">واَلتَمِسُوا وجهَهُ كُلَّ حينٍ.<verse eid="1CH 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="1CH 16:12" />أذكُروا عَجائِبَهُ الّتي صنَعَ،</para>
  <para style="p" vid="1CH 16:12">آياتِهِ وأحكامَ فَمِهِ،<verse eid="1CH 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="1CH 16:13" />يا نَسلَ إِسرائيلَ عَبدِهِ،</para>
  <para style="p" vid="1CH 16:13">يا بَني يَعقوبَ الّذي اَختارَهُ.<verse eid="1CH 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="1CH 16:14" />هوَ الرّبُّ إلهُنا.</para>
  <para style="p" vid="1CH 16:14">في الأرضِ كُلِّها أحكامُهُ.<verse eid="1CH 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="1CH 16:15" />اَذكُروا إلى الأبدِ عَهدَهُ،</para>
  <para style="p" vid="1CH 16:15">وصيَّتَهُ إلى ألفِ جيلٍ،<verse eid="1CH 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="1CH 16:16" />العَهدَ الّذي قطَعَهُ معَ إبراهيمَ،</para>
  <para style="p" vid="1CH 16:16">واليمينَ الّتي حلَفَها لإسحَقَ.<verse eid="1CH 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="1CH 16:17" />جعَلَهُ فريضَةً ليَعقوبَ،</para>
  <para style="p" vid="1CH 16:17">لإِسرائيلَ عَهدًا أبديًّا.<verse eid="1CH 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="1CH 16:18" />قالَ: ”لكَ أُعطي أرضَ كنعانَ</para>
  <para style="p" vid="1CH 16:18">قِسْمَةَ مِيراثٍ لبنيكَ“.<verse eid="1CH 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="1CH 16:19" />حينَ كانوا عددًا يُحْصى</para>
  <para style="p" vid="1CH 16:19">قليلينَ وغُرَباءَ فيها،<verse eid="1CH 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="1CH 16:20" />مُتَنَقِّلينَ مِنْ أُمَّةٍ إلى أُمَّةٍ،</para>
  <para style="p" vid="1CH 16:20">ومِنْ مَملَكةٍ إلى مَملَكةٍ.<verse eid="1CH 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="1CH 16:21" />لم يَدَعِ الرّبُّ أحدًا يَظلِمُهُم</para>
  <para style="p" vid="1CH 16:21">وأنذَرَ مُلوكًا مِنْ أجلِهِم،<verse eid="1CH 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="1CH 16:22" />قالَ: ”لا تَمَسُّوا الّذينَ اَختَرْتُهُم،</para>
  <para style="p" vid="1CH 16:22">ولا تُسيئُوا إلى أنبيائي“.<verse eid="1CH 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="1CH 16:23" />رَنِّموا للرّبِّ يا جميعَ الأرضِ،</para>
  <para style="p" vid="1CH 16:23">بَشِّروا مِنْ يومٍ إلى يومٍ بِخلاصِهِ.<verse eid="1CH 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="1CH 16:24" />حدِّثوا في الأمَمِ بِمَجدِهِ،</para>
  <para style="p" vid="1CH 16:24">وفي جميعِ الشُّعوبِ بِعَجائِبِه.<verse eid="1CH 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="1CH 16:25" />الرّبُّ عظيمٌ فهَلِّلوا لَه</para>
  <para style="p" vid="1CH 16:25">ومَرهوبٌ فَوقَ جميعِ الآلِهةِ.<verse eid="1CH 16:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="1CH 16:26" />جميعُ آلِهةِ الشُّعوبِ أصنامٌ</para>
  <para style="p" vid="1CH 16:26">والرّبُّ صانِعُ السَّماواتِ.<verse eid="1CH 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="1CH 16:27" />المَجدُ والجَلالُ أمامَ وجهِهِ،</para>
  <para style="p" vid="1CH 16:27">وفي مَقامِهِ العِزَّةُ والبَهاءُ،<verse eid="1CH 16:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="1CH 16:28" />إعتَرِفوا للرّبِّ يا قبائِلَ الشُّعوبِ،</para>
  <para style="p" vid="1CH 16:28">إعتَرِفوا للرّبِّ بالمَجدِ والعِزَّةِ،<verse eid="1CH 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="1CH 16:29" />إعتَرِفوا لَه بِمَجدِ اَسمهِ.</para>
  <para style="p" vid="1CH 16:29">تَعالَوا بِتَقدِمةٍ إلى أمامِهِ.</para>
  <para style="p" vid="1CH 16:29">ولَه اَسجدوا في بَهاءِ قُدْسِهِ.<verse eid="1CH 16:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="1CH 16:30" />إرتَعِدوا مِنهُ يا جميعَ الأرضِ.</para>
  <para style="p" vid="1CH 16:30">هوَ ثَبَّتَ العالَمَ، فلن يتَزَعزَعَ.<verse eid="1CH 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" pubnumber="31" sid="1CH 16:31" />فلتَفرَحِ السَّماواتُ وتَبتَهِجِ الأرضُ،</para>
  <para style="p" vid="1CH 16:31">وَليُنادَ في الأُمَمِ: ”مَلِكٌ هوَ الرّبُّ“.<verse eid="1CH 16:31" /></para>
  <para style="p">
    <verse number="32" style="v" pubnumber="32" sid="1CH 16:32" />لِيَعِجَّ البحرُ وكُلُّ خليقةٍ فيهِ،</para>
  <para style="p" vid="1CH 16:32">وَلتَبتَهِجِ البرِّيَّةُ وكُلُّ ما فيها.<verse eid="1CH 16:32" /></para>
  <para style="p">
    <verse number="33" style="v" pubnumber="33" sid="1CH 16:33" />لِيُرَنِّمْ شجَرُ الغابِ أمامَ الرّبِّ</para>
  <para style="p" vid="1CH 16:33">حينَ يأتي لِيَحكُمَ في الأرضِ.<verse eid="1CH 16:33" /></para>
  <para style="p">
    <verse number="34" style="v" pubnumber="34" sid="1CH 16:34" />اَحمَدوا الرّبَّ لأنَّهُ صالحٌ،</para>
  <para style="p" vid="1CH 16:34">وإلى الأبدِ رحمَتُه.<verse eid="1CH 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" pubnumber="35" sid="1CH 16:35" />قولوا: ”خَلِّصْنا يا اللهُ مُخَلِّصَنا،</para>
  <para style="p" vid="1CH 16:35">واَجمَعْنا ومِنَ الأُمَمِ أنقِذْنا</para>
  <para style="p" vid="1CH 16:35">لِنَحمَدَ اَسمَكَ القُدُّوسَ</para>
  <para style="p" vid="1CH 16:35">ونُفاخِرَ يا ربُّ بالتَّهليلِ لكَ“.<verse eid="1CH 16:35" /></para>
  <para style="p">
    <verse number="36" style="v" pubnumber="36" sid="1CH 16:36" />تَبارَكَ الرّبُّ إلهُ إِسرائيلَ،</para>
  <para style="p" vid="1CH 16:36">تَبارَكَ مِنَ الأزَلِ إلى الأبدِ.</para>
  <para style="p" vid="1CH 16:36">فقالَ جميعُ الشَّعبِ: ”آمينَ“، وهَلَّلوا للرّبِّ.<verse eid="1CH 16:36" /></para>
  <para style="s1">العبادة في أورشليم وجبعون</para>
  <para style="p">
    <verse number="37" style="v" pubnumber="37" sid="1CH 16:37" />وترَكَ داوُدُ آسافَ وفِرقَتَهُ هُناكَ، أمامَ تابوتِ عَهدِ الرّبِّ، لِيَقوموا بالخِدمةِ كُلَّ يومٍ بِلا اَنقِطاع، <verse eid="1CH 16:37" /><verse number="38" style="v" pubnumber="38" sid="1CH 16:38" />على أنْ يُساعِدَهُم أدومُ بنُ يَديثونَ معَ أنسِبائِهِ الثَّمانيةِ والسِّتِّينَ. وكانَ عوبيدُ أدومَ وحوسَةُ بوَّابَينِ. <verse eid="1CH 16:38" /><verse number="39" style="v" pubnumber="39" sid="1CH 16:39" />أمَّا صادوقُ الكاهِنُ وأنسِباؤُهُ الكهَنةُ، فتَرَكهُم داوُدُ أمامَ مَسكِنِ الرّبِّ على التَّلِّ الّذي في جَبعونَ <verse eid="1CH 16:39" /><verse number="40" style="v" pubnumber="40" sid="1CH 16:40" />ليقَدِّموا مُحرقاتٍ للرّبِّ على المذبَحِ صباحًا ومساءً بِلا اَنقِطاعٍ، على حسَبِ ما هوَ مكتوبٌ في شريعةِ الرّبِّ الّتي أمرَ بِها بَني إِسرائيلَ. <verse eid="1CH 16:40" /><verse number="41" style="v" pubnumber="41" sid="1CH 16:41" />وكانَ معَهُم هَيمانُ ويَدُوثونُ وسائِرُ الّذينَ اَختِيروا مِمَّنْ سبَقَ ذِكْرُ أسمائِهِم ليَحمَدوا الرّبَّ لأنَّ رحمَتَهُ إلى الأبدِ. <verse eid="1CH 16:41" /><verse number="42" style="v" pubnumber="42" sid="1CH 16:42" />وكانَ على هَيمانَ ويدوثونَ أنْ يتَوَلَّيا أمرَ الصُّنوجِ والأبواقِ وآلاتِ الغِناءِ عِندَ الإنشادِ للهِ. وأمَّا بَنو يَدُوثونَ فكانوا بوَّابِينَ.<verse eid="1CH 16:42" /></para>
  <para style="p">
    <verse number="43" style="v" pubnumber="43" sid="1CH 16:43" />ثُمَّ اَنصَرَفَ جميعُ الشَّعبِ، كُلُّ واحدٍ إلى بَيتِهِ، ورجَعَ داوُدُ لِيُقيمَ معَ أهلِ بَيتِهِ.<verse eid="1CH 16:43" /></para>
  <chapter eid="1CH 16" />
  <chapter number="17" style="c" sid="1CH 17" />
  <para style="s1">نبوءة ناثان</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="1CH 17:1" />ولمَّا سكَنَ المَلِكُ في قَصرِهِ، قالَ لِناثانَ النَّبيِّ: ”أنا مُقيمٌ في قصرٍ مِنْ أرزٍ، بَينَما تابوتُ عَهدِ الرّبِّ مُقيمٌ في خَيمةٍ“. <verse eid="1CH 17:1" /><verse number="2" style="v" pubnumber="2" sid="1CH 17:2" />فأجابَهُ ناثانُ: ”إفعَلْ كُلَّ ما في بالِكَ لأنَّ الرّبَّ معَكَ“.<verse eid="1CH 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="1CH 17:3" />لكِنْ في تِلكَ اللَّيلَةِ قالَ الرّبُّ لِناثانَ: <verse eid="1CH 17:3" /><verse number="4" style="v" pubnumber="4" sid="1CH 17:4" />”قُلْ لِعبدي داوُدَ: هذا ما يقولُ الرّبُّ: ”أأَنتَ تَبني لي بَيتًا لِسُكْناي؟ <verse eid="1CH 17:4" /><verse number="5" style="v" pubnumber="5" sid="1CH 17:5" />ما سكَنْتُ بَيتًا مِنْ يومِ أَخرَجْتُ بَني إِسرائيلَ مِنْ مِصْرَ إلى هذا اليومِ، بل كُنتُ أسيرُ في خَيمةٍ مِنْ مكانٍ إلى آخَرَ. <verse eid="1CH 17:5" /><verse number="6" style="v" pubnumber="6" sid="1CH 17:6" />وفي كُلِّ مَسيري معَ جميعِ بَني إِسرائيلَ لم أسألْ أحدًا مِنْ رؤسائِهِمِ الّذينَ أمَرتُهُم أنْ يَرعَوا بَني إِسرائيلَ شعبي: لِماذا لم تَبنوا لي بَيتًا مِنَ الأرْزِ؟ <verse eid="1CH 17:6" /><verse number="7" style="v" pubnumber="7" sid="1CH 17:7" />فقُلْ لِعبدي داوُدَ: هذا ما يقولُ الرّبُّ القديرُ: أنا اَختَرْتُكَ مِنَ الحظيرةِ، مِن وراءِ الغنَمِ، لِتكونَ رئيسًا على شعبي بَني إِسرائيلَ، <verse eid="1CH 17:7" /><verse number="8" style="v" pubnumber="8" sid="1CH 17:8" />وكُنتُ معَكَ حَيثُما سِرْتَ، وأبَدْتُ جميعَ أعدائِكَ مِنْ أمامِكَ، وأقَمْتُ لكَ اَسمًا عظيمًا كالعُظماءِ في الأرضِ. <verse eid="1CH 17:8" /><verse number="9" style="v" pubnumber="9" sid="1CH 17:9" />وجَعَلْتُ مكانًا لِشعبي بَني إِسرائيلَ وغرَسْتُهُ، فثَبَتَ في مكانِهِ فلا يتَزَعزَعُ مِنْ بَعدُ ولا يعودُ بَنو الشَّرِّ يَضطَهِدونَهُ كما مِنْ قَبلُ، <verse eid="1CH 17:9" /><verse number="10" style="v" pubnumber="10" sid="1CH 17:10" />إلى يومِ أقَمتُكَ حاكمًا علَيهِم وأرَحْتُكَ مِنْ جميعِ أعدائِكَ. وأنا الرّبُّ أُخبِرُكَ بِأنِّي سَأُقيمُ لكَ نَسلًا. <verse eid="1CH 17:10" /><verse number="11" style="v" pubnumber="11" sid="1CH 17:11" />وإذا اَنتَهَت أيّامُكَ ورَقَدْتَ معَ أبائِكَ، أقَمتُ خَلَفًا لكَ مِنْ نَسلِكَ الّذي يخرُجُ مِنْ صُلْبِكَ وثَبَّتُّ مُلْكَهُ، <verse eid="1CH 17:11" /><verse number="12" style="v" pubnumber="12" sid="1CH 17:12" />فهوَ يَبني بَيتًا لاَسمي وأنا أُثَبِّتُ عرشَ مُلْكِهِ إلى الأبدِ. <verse eid="1CH 17:12" /><verse number="13" style="v" pubnumber="13" sid="1CH 17:13" />أنا أكونُ لَه أبًا وهوَ يكونُ لي اَبنًا، وأمَّا رحمَتي فلا أَنزعُها عَنه كما نزَعتُها عَنْ شاوُلَ الّذي كانَ قَبلَكَ، <verse eid="1CH 17:13" /><verse number="14" style="v" pubnumber="14" sid="1CH 17:14" />بل يكونُ نَسلُكَ ومُلْكُكَ ثابِتَينِ على الدَّوامِ أمامَ وجهي، وعرشُكَ يكونَ راسخًا إلى الأبدِ“. <verse eid="1CH 17:14" /><verse number="15" style="v" pubnumber="15" sid="1CH 17:15" />فأخبَرَ ناثانُ داوُدَ بِجميعِ هذا الكلامِ وهذِهِ الرُّؤيا كُلِّها.<verse eid="1CH 17:15" /></para>
  <para style="s1">صلاة داود</para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="1CH 17:16" />فدَخَلَ المَلِكُ داوُدُ وجلَسَ أمامَ الرّبِّ وقالَ: ”مَنْ أنا يا سيِّدي الرّبُّ، وما بَيتي الّذي أنتَسِبُ إليهِ حتّى أوصَلْتَني إلى هُنا؟ <verse eid="1CH 17:16" /><verse number="17" style="v" pubnumber="17" sid="1CH 17:17" />وكانَ هذا كُلُّهُ قليلًا في عينَيكَ يا سيِّدي الرّبُّ، فوَعَدْتَني أيضًا أنا عبدَكَ، أنْ يدومَ نَسلي زَمانًا طويلًا، واَعتَبَرتَني كواحدٍ مِنْ عُظَماءِ الأرضِ أيُّها السَّيِّدُ الرّبُّ. <verse eid="1CH 17:17" /><verse number="18" style="v" pubnumber="18" sid="1CH 17:18" />فبِماذا أُكَلِّمُكَ وأنتَ كَرَّمْتَني وعَرَفْتَني؟ <verse eid="1CH 17:18" /><verse number="19" style="v" pubnumber="19" sid="1CH 17:19" />فمِنْ أجلِ وعدِكَ ومَحَبَّةِ قلبِكَ فعَلْتَ لي هذا الأمرَ العظيمَ وأعلَمْتَني بهِ، فما أعظَمَكَ أيُّها الرّبُّ الإلهُ. <verse eid="1CH 17:19" /><verse number="20" style="v" pubnumber="20" sid="1CH 17:20" />أنتَ لا مَثيلَ لكَ ولا إلهَ سِواكَ، كما سَمِعنا بآذانِنا. <verse eid="1CH 17:20" /><verse number="21" style="v" pubnumber="21" sid="1CH 17:21" />وأيَّةُ أُمَّةٍ في الأرضِ مِثلُ شعبِكَ بَني إِسرائيلَ الّذينَ جعَلْتَهُم لِنَفسِكَ شعبًا وجعَلْتَ لهُمُ اَسمًا، وعَمِلْتَ لهُم تِلكَ الأعمالَ العظيمةَ الهائِلَةَ حَيثُ طَرَدْتَ مِنْ أمامِهِمِ الشُّعوبَ وآلهَتَهُم، يومَ أخرَجتَهُم مِنْ مِصْرَ. <verse eid="1CH 17:21" /><verse number="22" style="v" pubnumber="22" sid="1CH 17:22" />وثَبَّتَّ شعبَكَ بَني إِسرائيلَ شعبًا لكَ إلى الأبدِ، وأنتَ يا ربُّ صِرْتَ لهُم إلهًا. <verse eid="1CH 17:22" /><verse number="23" style="v" pubnumber="23" sid="1CH 17:23" />والآنَ أيُّها الرّبُّ الإلهُ، أقِمْ إلى الأبدِ وعدَكَ الّذي وعَدْتَني بهِ أنا ونَسلي واَفعلْ كما قُلتَ <verse eid="1CH 17:23" /><verse number="24" style="v" pubnumber="24" sid="1CH 17:24" />ليَعظُمَ اَسمُكَ إلى الأبدِ ويُقالَ: الرّبُّ القديرُ إلهٌ على إِسرائيلَ، وليكُنْ نَسلُ عبدِكَ داوُدَ ثابتًا أمامَكَ، <verse eid="1CH 17:24" /><verse number="25" style="v" pubnumber="25" sid="1CH 17:25" />لأنَّكَ أنتَ القديرُ يا إلهي، أعلَنْتَ ذلِكَ على مَسمَعي حينَ قُلْتُ: أَبني لكَ بَيتًا. لِذلِكَ تشَجَّعَ قلبي أنا عبدكَ أنْ أرفَعَ إليكَ هذِهِ الصَّلاةَ. <verse eid="1CH 17:25" /><verse number="26" style="v" pubnumber="26" sid="1CH 17:26" />والآنَ أيُّها الرّبُّ، أنتَ هوَ اللهُ، وأنتَ الّذي وعَدْتَني هذا الوعدَ الحَسَنَ. <verse eid="1CH 17:26" /><verse number="27" style="v" pubnumber="27" sid="1CH 17:27" />فالآنَ تَحَنَّنْ وبارِكْ نَسلي بارَكتَهُ فكانَ مُبارَكًا إلى الأبدِ“.<verse eid="1CH 17:27" /></para>
  <chapter eid="1CH 17" />
  <chapter number="18" style="c" sid="1CH 18" />
  <para style="s1">حروب داود</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="1CH 18:1" />وبَعدَ ذلِكَ هزَمَ داوُدُ الفِلسطيِّينَ وأذَلَّهُم، وأخَذَ جَتَّ وجِوارَها مِنْ أيديهِم. <verse eid="1CH 18:1" /><verse number="2" style="v" pubnumber="2" sid="1CH 18:2" />وهزَمَ المُوآبيِّينَ. فصاروا لَه عبيدًا يُؤدُّونَ أعمالَ السُّخرَةِ.<verse eid="1CH 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="1CH 18:3" />وهاجَمَ داوُدُ هدَدَعزَرَ مَلِكَ صُوبَةَ في حماةَ وكانَ هذا ذاهبًا ليَستَرِدَّ سُلطَتَهُ على نهرِ الفُراتِ، <verse eid="1CH 18:3" /><verse number="4" style="v" pubnumber="4" sid="1CH 18:4" />وأخَذَ مِنهُ ألفَ مَركبةٍ وسبعةَ آلافِ فارسٍ وعشرينَ ألفًا مِنَ المُشاةِ، وقطَعَ مَفاصِلَ أرجُلِ خَيلِ جميعِ المَركباتِ وأبقى مِنها ما يكفي لِمئَةِ مَركبَةٍ. <verse eid="1CH 18:4" /><verse number="5" style="v" pubnumber="5" sid="1CH 18:5" />فجاءَ الآراميُّونَ مِنْ دِمَشقَ لِنَجدَةِ هدَدَعزَرَ مَلِكِ صُوبَةَ، فقَتَلَ داوُدُ مِنهُم اثنَينِ وعشرينَ ألفَ رَجُلٍ، <verse eid="1CH 18:5" /><verse number="6" style="v" pubnumber="6" sid="1CH 18:6" />وأقامَ مُعَسكَراتٍ في أرضِهِم، فصارَ الآراميُّونَ عبيدًا لِداوُدَ يُؤدُّونَ لَه أعمالَ السُّخرَةِ ونصَرَ الرّبُّ داوُدَ حَيثُما تَوجَّهَ. <verse eid="1CH 18:6" /><verse number="7" style="v" pubnumber="7" sid="1CH 18:7" />وأخَذَ داوُدُ تُروسَ الذَّهبِ الّتي كانَت معَ رِجالِ هدَدَعزَرَ وجاءَ بِها إلى أورُشليمَ. <verse eid="1CH 18:7" /><verse number="8" style="v" pubnumber="8" sid="1CH 18:8" />وأخَذَ المَلِكُ داوُدُ مِنْ طَبحَةَ، وخُونَ مدينَتَي هدَدَعزَرَ، نُحاسًا كثيرًا جِدًّا عَمِلَ مِنهُ سُليمانُ حَوضَ النُّحاسِ والأعمِدَةَ وأوانيَ النُّحاسِ في الهَيكلِ.<verse eid="1CH 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="1CH 18:9" />وسَمِعَ توعو مَلِكُ حماةَ أنَّ داوُدَ كسَرَ جيشَ هدَدَعزَرَ مَلِكِ صوبَةَ <verse eid="1CH 18:9" /><verse number="10" style="v" pubnumber="10" sid="1CH 18:10" />فأرسلَ إليهِ اَبنَهُ هدورامَ لِيُسَلِّمَ علَيهِ ويُهَنِّئَهُ لأنَّهُ قاتَلَ هدَدَعزَرَ وكسَرَهُ، وهوَ الّذي كانَت لَه حُروبٌ معَهُ. وحمَلَ هدورامُ إلى داوُدَ آنيةً مِنَ الفِضَّةِ والذَّهبِ والنُّحاسِ. <verse eid="1CH 18:10" /><verse number="11" style="v" pubnumber="11" sid="1CH 18:11" />وهذِهِ أيضًا كرَّسَها المَلِكُ داوُدُ للرّبِّ، في ما كرَّسَهُ مِنْ فِضَّةِ وذهَبِ جميعَ الشُّعوبِ مِنَ الآراميِّينَ والموآبيِّين وبَني عَمُّونَ والفِلسطيِّينَ وبَني عماليقَ. <verse eid="1CH 18:11" /><verse number="12" style="v" pubnumber="12" sid="1CH 18:12" />وقتَلَ أبيشايُ اَبنُ صَرويَّةَ مِنَ الأدوميِّينَ في وادي المِلْحِ ثمانيةَ عشَرَ ألفَ رَجُلٍ.<verse eid="1CH 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="1CH 18:13" />وأقامَ داوُدُ في أدومَ كُلِّها مُعَسكراتٍ، وصارَ جميعُهُم عبيدًا لَه. ونصَرَهُ الرّبُّ حَيثُما توَجَّه.<verse eid="1CH 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="1CH 18:14" />وملَكَ داوُدُ على جميعِ بَني إِسرائيلَ، وكانَ يَحكُمُ شعبَهُ بالعَدلِ والإنصافِ. <verse eid="1CH 18:14" /><verse number="15" style="v" pubnumber="15" sid="1CH 18:15" />وكانَ يوآبُ بنُ صَرويَّةَ قائدًا لِلجيشِ، ويوشافاطُ اَبنُ أخيلودَ مُسَجِّلًا، <verse eid="1CH 18:15" /><verse number="16" style="v" pubnumber="16" sid="1CH 18:16" />وصادوقُ بنُ أخيطوبَ وأخيمالِكُ بنُ أبياثارَ كاهنَينِ، وسَرايا كاتبًا في الدِّيوانِ، <verse eid="1CH 18:16" /><verse number="17" style="v" pubnumber="17" sid="1CH 18:17" />وبَنايا بنُ يوياداعَ قائدًا لِحرَسِ المَلِكِ، وكانَ بَنو داوُدَ الأوَّلينَ في خِدمةِ المَلِكِ.</para>
  <para style="p" vid="1CH 18:17">داود يهزم العمونيين والآراميين<verse eid="1CH 18:17" /></para>
  <chapter eid="1CH 18" />
  <chapter number="19" style="c" sid="1CH 19" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="1CH 19:1" />وبَعدَ ذلِكَ تُوُفِّيَ ناحاشُ مَلِكُ بَني عَمُّونَ، فمَلَكَ حَنونُ اَبنُهُ مكانَهُ. <verse eid="1CH 19:1" /><verse number="2" style="v" pubnumber="2" sid="1CH 19:2" />فقالَ داوُدُ: ”أُحسِنُ إلى حَنونَ بنِ ناحاشَ كما أحسَنَ أبوهُ إليَّ“، وأرسلَ وَفدًا يُعَزِّيهِ بِأبيهِ. فجاؤوا إلى بَني عَمُّون، <verse eid="1CH 19:2" /><verse number="3" style="v" pubnumber="3" sid="1CH 19:3" />فقالَ زُعَماءُ بَني عَمُّونَ لِحَنونَ سَيِّدِهِم: ”أتَظُنُّ داوُدَ يُكرِمُ أباكَ حتّى أرسلَ إليكَ مُعَزِّينَ؟ أمْ أنَّهُ أرسَلَهُم ليَتَفَحَّصُوا المدينةَ ويَستَطلِعوها تَمهيدًا لِلاستيلاءِ علَيها؟“ <verse eid="1CH 19:3" /><verse number="4" style="v" pubnumber="4" sid="1CH 19:4" />فقَبَضَ حَنونُ على رُسُلِ داوُدَ، وحَلَقَ نِصفَ لِحاهُم وقطَعَ نِصفَ ثيابِهِم عِندَ الوِرْكِ، ثُمَّ أطلَقَهُم. <verse eid="1CH 19:4" /><verse number="5" style="v" pubnumber="5" sid="1CH 19:5" />فسَمِعَ داوُدُ بِما حَلَّ بِرُسُلِهِ، ولأنَّهُم كانوا خجلينَ جِدًّا، أرسلَ مَنْ يقولُ: ”أقيمُوا بِأريحا حتّى تَنبُتَ لِحاكُم ثُمَّ اَرجِعوا“.<verse eid="1CH 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="1CH 19:6" />ولمَّا رأى بَنو عَمُّونَ أنَّ داوُدَ أصبَحَ يكرَهُهُم أرسلوا مئَةً وسِّتينَ قِنطارًا مِنَ الفِضَّةِ ليَستأجِروا مَراكِبَ وفُرسانًا مِنْ آرامِ النهرَينِ ومِنْ مدينَتَي مَعكَةَ وصُوبَةَ في آرامَ <verse eid="1CH 19:6" /><verse number="7" style="v" pubnumber="7" sid="1CH 19:7" />فاَسْتأجَروا اَثْنَينِ وثلاثينَ ألفَ مَركبَةٍ، واَستَقدَموا مَلِكَ مَعكَةَ ورجالَهُ، فنَزَلوا تُجاهَ مَيدبا، وخرَجَ بَنو عَمُّونَ مِنْ مُدُنِهِم واَجتَمَعُوا لِلقِتالِ. <verse eid="1CH 19:7" /><verse number="8" style="v" pubnumber="8" sid="1CH 19:8" />فلمَّا سَمِعَ داوُدُ بالأمرِ أرسلَ يُوآبَ على رأسِ جيشِهِ. <verse eid="1CH 19:8" /><verse number="9" style="v" pubnumber="9" sid="1CH 19:9" />فخَرَجَ بَنو عَمُّونَ واَسْتَعَدّوا لِلحربِ عِندَ مَدخَلِ عاصِمَتِهِم، وأخَذَ الآراميُّونَ مَواقِعَهم في البرِّيَّةِ.<verse eid="1CH 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="1CH 19:10" />فرَأى يُوآبُ أنَّ القِتالَ مَفروضٌ علَيهِ مِنَ الأمامِ والخَلْفِ، فاَخْتارَ نُخبَةَ جُنودِهِ وصَفَّهُم لِمُقاتَلَةِ الآراميِّينَ، <verse eid="1CH 19:10" /><verse number="11" style="v" pubnumber="11" sid="1CH 19:11" />وأسنَدَ قيادةَ بَقيَّةِ الجُنودِ إلى أبيشايَ أخيهِ، فصَفَّهُم لِمُقاتَلَةِ بَني عَمُّونَ. <verse eid="1CH 19:11" /><verse number="12" style="v" pubnumber="12" sid="1CH 19:12" />وقالَ لأبيشايَ: ”إنْ قوِيَ عليَّ الآراميُّونَ تُنجِدُني، وإنْ قوِيَ علَيكَ بَنو عَمُّونَ أُنجِدُكَ. <verse eid="1CH 19:12" /><verse number="13" style="v" pubnumber="13" sid="1CH 19:13" />فتَشَجَّعْ واَثْبُتْ دِفاعًا عَنْ شعبِنا ومُدُنِ إلهِنا، وليَفعَلِ الرّبُّ ما يَراهُ حسَنًا“. <verse eid="1CH 19:13" /><verse number="14" style="v" pubnumber="14" sid="1CH 19:14" />ثُمَّ تقَدَّمَ يُوآبُ ورِجالُهُ لِمُقاتَلَةِ الآراميِّينَ فاَنهَزَموا مِنْ أمامِهِ. <verse eid="1CH 19:14" /><verse number="15" style="v" pubnumber="15" sid="1CH 19:15" />ولمَّا رأى بَنو عَمُّونَ أنَّ الآراميِّينَ اَنهَزَموا، هرَبوا هُم أيضًا مِنْ أمامِ أبيشايَ ودخَلوا عاصِمَتَهُم. فاَمتَنَعَ يوآبُ عَنْ مُقاتَلَةِ بَني عَمُّونَ ورَجَعَ إلى أورُشليمَ.<verse eid="1CH 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="1CH 19:16" />فلمَّا رأى الآراميُّونَ أنَّهُم اَنْكَسَروا أمامَ بَني إِسرائيلَ، أرسلَ المَلِكُ هدَدَعزَرُ جُنْدَ الآراميِّينَ الّذينَ كانوا شرقيَّ نهرِ الفُراتِ، فجاؤوا بِقيادةِ شُوفيكَ رئيسِ جيشِهِ. <verse eid="1CH 19:16" /><verse number="17" style="v" pubnumber="17" sid="1CH 19:17" />وسَمِعَ داوُدُ بالأمرِ فحشدَ جميعَ رِجالِ بَني إِسرائيلَ وعبَرَ الأردُنَّ وزحَفَ إليهم. فاَستَعَدَّ الآراميُّونَ لمُحاربَتِهِ، <verse eid="1CH 19:17" /><verse number="18" style="v" pubnumber="18" sid="1CH 19:18" />فاَنهَزَموا مِنْ أمامِهِ بَعدَ أنْ أهلَكَ لهُم سبعةَ آلافِ سائِقِ مَركبةٍ وأربَعينَ ألفَ فارسٍ، وقتَلَ شُوفيكَ قائدَهُم هُناكَ. <verse eid="1CH 19:18" /><verse number="19" style="v" pubnumber="19" sid="1CH 19:19" />فلمَّا رأى رِجالُ هدَدَعزَرَ أنَّهُمُ اَنْكَسَروا أمامَ بَني إِسرائيلَ، صالَحوا داوُدَ وخضَعوا لهُ. وخافَ الآراميُّونَ أنْ يَعودوا إلى نَجدَةِ بَني عَمُّونَ.<verse eid="1CH 19:19" /></para>
  <chapter eid="1CH 19" />
  <chapter number="20" style="c" sid="1CH 20" />
  <para style="s1">داود يستولي على ربَّة</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="1CH 20:1" />وفي رَبيعِ السَّنةِ المُقبِلَةِ، وقتَ خُروجِ المُلوكِ عادةً إلى الحربِ، قادَ يوآبُ الجيشَ وغَزا أرضَ بَني عَمُّونَ وحاصرَ عاصِمَتَهُم رَبَّةَ. وأمَّا داوُدُ فبَقيَ في أورُشليمَ. فهاجَمَ يُوآبُ رَبَّةَ وهدَمَها. <verse eid="1CH 20:1" /><verse number="2" style="v" pubnumber="2" sid="1CH 20:2" />وأخَذَ داوُدُ التَّاجَ عَنْ رأسِ الإلهِ مَلكومَ، فوَجَدَ وَزْنَهُ ثَلاثَةَ عشَرَ رَطلًا مِنَ الذَّهبِ. وكانَ فيهِ حجَرٌ كريمٌ، فوَضَعَهُ داوُدُ في تاجِهِ، وغَنِمَ مِنَ المدينةِ غَنائِمَ كثيرةً جِدًّا. <verse eid="1CH 20:2" /><verse number="3" style="v" pubnumber="3" sid="1CH 20:3" />وأخرَجَ سُكَّانَها أيضًا وأمَرَهُم بالعمَلِ بالمَناشيرِ ونوارِجِ الحديدِ والفُؤوسِ. وهكذا فعَلَ بِجميعِ مُدُنِ بَني عَمُّونَ، ثُمَّ رجَعَ معَ الجيشِ إلى أورُشليمَ.<verse eid="1CH 20:3" /></para>
  <para style="s1">الحرب على الفلسطيِّين</para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="1CH 20:4" />ونشبَت بَعدَ ذلِكَ حربٌ في جازَرَ معَ الفِلسطيِّينَ، فقَتَلَ فيها سِبكايُ الحوشيُّ رفائيًّا اَسمُهُ سَفَّايُ فاَنْهَزَمَ الفِلسطيُّونَ. <verse eid="1CH 20:4" /><verse number="5" style="v" pubnumber="5" sid="1CH 20:5" />ثُمَّ نشبَت أيضًا حربٌ معَ الفِلسطيِّينَ، فقَتَلَ ألحانانُ بنُ بَعورَ أخا جُلياتَ الجِتِّيّ واَسمُهُ لَحْمي وكانَت قَناةُ رُمحِهِ كنَولِ الحائِكِ. <verse eid="1CH 20:5" /><verse number="6" style="v" pubnumber="6" sid="1CH 20:6" />وفي حربٍ أُخرى في جَتَّ، كانَ فيها رَجُلٌ جبَّارٌ طويلُ القامةِ، لَه سِتُّ أصابِعَ في كُلِّ يَدٍ ورِجْلٍ، <verse eid="1CH 20:6" /><verse number="7" style="v" pubnumber="7" sid="1CH 20:7" />فلمَّا أهانَ بَني إِسرائيلَ قتَلَهُ يوناثانُ بنُ شِمْعا أخي داوُدَ. <verse eid="1CH 20:7" /><verse number="8" style="v" pubnumber="8" sid="1CH 20:8" />هؤلاءِ الثَّلاثةُ الّذينَ سقَطوا بِيَدِ داوُدَ وأيدي رِجالِه كانوا مِنْ بَني هَرْفَةَ في جَتَّ.<verse eid="1CH 20:8" /></para>
  <chapter eid="1CH 20" />
  <chapter number="21" style="c" sid="1CH 21" />
  <para style="s1">إحصاء شعب إسرائيل ويهوذا</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="1CH 21:1" />ونَوى الشّيطانُ الشَّرَّ لإِسرائيلَ، فحَضَّ داوُدَ على إحصاءِ شعبِها. <verse eid="1CH 21:1" /><verse number="2" style="v" pubnumber="2" sid="1CH 21:2" />فقالَ داوُدُ لِيوآبَ وقادةِ جيشِهِ: ”إِذهَبوا واَحصوا شعبَ إِسرائيلَ، مِنْ دانَ إلى بِئْرَ سَبْعَ، وأخبِروني لأعلَمَ كم عدَدُهُ“. <verse eid="1CH 21:2" /><verse number="3" style="v" pubnumber="3" sid="1CH 21:3" />فأجابَهُ يوآبُ: ”ليَزِدِ الرّبُّ شعبَهُ مئَةَ ضُعفٍ، أمَا كُلُّهُم رَعاياكَ يا سيِّدي المَلِكُ، فلِماذا تَطلُبُ هذا الأمرَ وتجعَلُ بَني إِسرائيلَ يَخطأونَ لِلرّبِّ؟“ <verse eid="1CH 21:3" /><verse number="4" style="v" pubnumber="4" sid="1CH 21:4" />غَيرَ أنَّ إرادَةَ داوُدَ تغَلَّبَت على رأيِ يُوآبَ فخَرَجَ هذا الأخيرُ وجالَ في كُلِّ أنحاءِ الأرضِ، ثُمَّ رجَعَ إلى أورُشليمَ. <verse eid="1CH 21:4" /><verse number="5" style="v" pubnumber="5" sid="1CH 21:5" />وأخبَرَ يُوآبُ المَلِكَ داوُدَ بِجُملَةِ عدَدِ الشَّعبِ، فكانَ عدَدُ رِجالِ إِسرائيلَ كُلِّهِم مليونًا ومئَةَ ألفِ رَجُلٍ قادرٍ على حَمْلِ السِّلاحِ، وعدَدُ رجالِ يَهوذا أربَعَ مئَةٍ وسَبعينَ ألفَ رَجُلٍ. <verse eid="1CH 21:5" /><verse number="6" style="v" pubnumber="6" sid="1CH 21:6" />ولم يُحصِ يُوآبُ سِبْطَي لاوي وبنيامينَ لأنَّ ما أمرَ بهِ المَلِكُ كانَ مكروهًا لدَيهِ. <verse eid="1CH 21:6" /><verse number="7" style="v" pubnumber="7" sid="1CH 21:7" />واَستاءَ اللهُ مِمَّا فعَلَهُ داوُدُ، فعاقَبَ جميعَ الشَّعبِ. <verse eid="1CH 21:7" /><verse number="8" style="v" pubnumber="8" sid="1CH 21:8" />فقالَ داوُدُ للرّبِّ: ”خَطِئْتُ جِدًّا في ما فعَلْتُ. والآنَ يا ربُّ اَغفِرْ لِعَبدِكَ هذِهِ الخطيئةَ، لأنِّي بِحَماقةٍ عظيمةٍ تَصَرَّفْتُ“. <verse eid="1CH 21:8" /><verse number="9" style="v" pubnumber="9" sid="1CH 21:9" />وكلَّمَ الرّبُّ جادَ النَّبيَّ، رائيَ داوُدَ: <verse eid="1CH 21:9" /><verse number="10" style="v" pubnumber="10" sid="1CH 21:10" />”إِذهَبْ إلى داوُدَ وقُلْ لَه: هذا ما يقولُ الرّبُّ: أَعرِضُ علَيكَ ثَلاثَ ضَرَباتٍ، فاَختَرْ واحدةً مِنها أُنزِلُها بِكَ“. <verse eid="1CH 21:10" /><verse number="11" style="v" pubnumber="11" sid="1CH 21:11" />فجاءَ جادُ إلى داوُدَ وقالَ لَه: <verse eid="1CH 21:11" /><verse number="12" style="v" pubnumber="12" sid="1CH 21:12" />”أيا مِنَ الضَّرَباتِ الثَّلاثِ تَختارُ: أنْ تَمُرَّ علَيكَ ثَلاثُ سِنينَ جُوعٍ في أرضِكَ، أم تَهربُ أمامَ أعدائِكَ ثَلاثَةَ أشهرٍ وهُم يُطاردونَكَ، أمْ يَحِلُّ في أرضِكَ وَباءٌ ثَلاثَةَ أيّامٍ؟ فَفكِّرِ الآنَ بِما أُجيبُ بهِ الرّبَّ“. <verse eid="1CH 21:12" /><verse number="13" style="v" pubnumber="13" sid="1CH 21:13" />فقالَ لَه داوُدُ: ”هذا اَخْتيارٌ عَسيرٌ جِدًّا. لكِنْ إذا كانَ لا بُدَّ مِنَ الاختيارِ فلنَقَعْ في يَدِ الرّبِّ لأنَّ مَراحِمَهُ كثيرةٌ، ولا نَقَعُ في يَدِ النَّاسِ“.<verse eid="1CH 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="1CH 21:14" />فأرسَلَ الرّبُّ وباءً، فماتَ مِنَ الشَّعبِ سَبعونَ ألفَ رَجُلٍ. <verse eid="1CH 21:14" /><verse number="15" style="v" pubnumber="15" sid="1CH 21:15" />وبَعَثَ اللهُ ملاكًا إلى أورُشليمَ لِيُدَمِّرَها، فنَدِمَ الرّبُّ على هذِهِ الضَّربةِ وقالَ للملاكِ الّذي كانَ يُميتُ الشَّعبَ: ”كفَى، كُفَّ الآنَ يَدَكَ“. وكانَ ملاكُ الرّبِّ عِندَ بَيدَرِ أرنانَ اليَبوسيِّ، <verse eid="1CH 21:15" /><verse number="16" style="v" pubnumber="16" sid="1CH 21:16" />ورفَعَ داوُدُ عَينَيهِ فرأى الملاكَ واقِفًا بَينَ السَّماءِ والأرضِ وبيَدِهِ سَيفُهُ فسَدَّدَهُ على أورُشليمَ. فسَجَدَ داوُدُ والشُّيوخُ على وجُوهِهِم وهم لابِسونَ المُسوحَ <verse eid="1CH 21:16" /><verse number="17" style="v" pubnumber="17" sid="1CH 21:17" />وقالَ داوُدُ للهِ: ”أنا الّذي خَطِئْتُ، وأنا الّذي فعَلْتُ السُّوءَ، وأمَّا أولئِكَ المَساكينُ كالخِرافِ فماذا فعَلوا؟ فعاقِبْني أيُّها الرّبُّ إلهي، وعاقِبْ أهلَ بَيتي، ولا تُعاقِبْ شعبَكَ“. <verse eid="1CH 21:17" /><verse number="18" style="v" pubnumber="18" sid="1CH 21:18" />فأمرَ ملاكُ الرّبِّ جادَ النَّبيَّ أنْ يأمُرَ داوُدَ بالصُّعودِ إلى بَيدَرِ أرنانَ اليَبوسيِّ ويُقيمَ مذبَحًا للرّبِّ. <verse eid="1CH 21:18" /><verse number="19" style="v" pubnumber="19" sid="1CH 21:19" />فصَعِدَ داوُدُ كما أمرَهُ الرّبُّ على لِسانِ جادَ. <verse eid="1CH 21:19" /><verse number="20" style="v" pubnumber="20" sid="1CH 21:20" />واَلتَفَتَ أرنانُ وهوَ يَدوسُ الحِنطَةَ على البَيدَرِ فرأى الملاكَ فاَختَبَأ هوَ وبَنوهُ الأربعَةُ الّذينَ معَهُ. <verse eid="1CH 21:20" /><verse number="21" style="v" pubnumber="21" sid="1CH 21:21" />وجاءَ داوُدُ إلى أرنانَ، فلمَّا رآهُ أرنانُ خرَجَ مِنَ البَيدَرِ واَنْحَنى لَه إلى الأرضِ. <verse eid="1CH 21:21" /><verse number="22" style="v" pubnumber="22" sid="1CH 21:22" />فقالَ لَه داوُدُ: ”أعطِني البَيدَرَ بالثَّمنِ الّذي يَستَحِقُّه حتّى أبنيَ فيهِ مذبَحًا لِلرّبِّ، فتكُفَّ الضَّربةُ عَنِ الشَّعبِ“. <verse eid="1CH 21:22" /><verse number="23" style="v" pubnumber="23" sid="1CH 21:23" />فقالَ لَه أرنانُ: ”خُذْهُ يا سيِّدي المَلِكُ واَعمَلْ ما تَراهُ حسَنًا. ها أنا أُعطي البقَرَ مُحرَقاتٍ والنَّوارِجَ حطَبًا والحِنطَةَ تقدِمةً. هذا كُلُّهُ أُعطيهِ“. <verse eid="1CH 21:23" /><verse number="24" style="v" pubnumber="24" sid="1CH 21:24" />فقالَ لَه المَلِكُ داوُدُ: ”كلَّا، بل أشتَري مِنكَ البَيدَرَ بِثَمنٍ كامِلٍ. فأنا لا آخُذُ مالَكَ فَأُقَدِّمُ للرّبِّ مُحرَقَةً مَجَّانيَّةً“. <verse eid="1CH 21:24" /><verse number="25" style="v" pubnumber="25" sid="1CH 21:25" />فدَفَعَ داوُدُ إلى أرنانَ ثمَنَ البَيدَرِ سِتَّ مئَةِ قِطعَةٍ مِنَ الذَّهبِ. <verse eid="1CH 21:25" /><verse number="26" style="v" pubnumber="26" sid="1CH 21:26" />وبَنى فيهِ مذبَحًا للرّبِّ، وقدَّمَ مُحرَقاتٍ وذَبائِحَ سلامةٍ، ودَعا إلى الرّبِّ فاَستجابَ لَه بإنزالِ نارٍ مِنَ السَّماءِ على مذبَحِ المُحرَقَةِ. <verse eid="1CH 21:26" /><verse number="27" style="v" pubnumber="27" sid="1CH 21:27" />وأمرَ الرّبُّ الملاكَ فرَدَّ سيفَهُ إلى غِمدِهِ.<verse eid="1CH 21:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="1CH 21:28" />وحينَ رأى داوُدُ أنَّ الرّبَّ اَستَجابَ لَه صارَ يُقَدِّمُ ذبائِحَ للرّبِّ في بَيدَرِ أرنانَ اليَبوسيّ، <verse eid="1CH 21:28" /><verse number="29" style="v" pubnumber="29" sid="1CH 21:29" />لأَنَّ مَسكِنَ الرّبِّ الّذي عَمِلَهُ موسى في البرِّيَّةِ ومذبَحَ المُحرَقةِ كانا في ذلِكَ الوقتِ على تَلَّةِ جِبْعونَ. <verse eid="1CH 21:29" /><verse number="30" style="v" pubnumber="30" sid="1CH 21:30" />ولم يقبَل داوُدُ أنْ يذهَبَ إلى هُناكَ لِيعبُدَ اللهَ خَوفًا مِنْ سيفِ ملاكِ الرّبِّ.<verse eid="1CH 21:30" /></para>
  <chapter eid="1CH 21" />
  <chapter number="22" style="c" sid="1CH 22" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="1CH 22:1" />فقالَ داوُدُ: ”هُنا يُبْنَى هَيكلُ الرّبِّ الإلهِ، ومذبَحُ المُحرَقةِ لِبَني إِسرائيلَ“.<verse eid="1CH 22:1" /></para>
  <para style="s1">الاستعداد لبناء بيت الله</para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="1CH 22:2" />وأمرَ داوُدُ أنْ يُجمَعَ الغُرباءُ الّذينَ في أرضِ إِسرائيلَ لِلعمَلِ في بِناءِ بَيتِ اللهِ، واَختارَ مِنهُم نَحَّاتينَ لِيَنحَتوا الحجارةَ. <verse eid="1CH 22:2" /><verse number="3" style="v" pubnumber="3" sid="1CH 22:3" />وجهَّزَ حديدًا كثيرًا لِصُنْعِ المَساميرِ والوَصْلِ لِمَصاريعِ الأبوابِ، ونُحاسًا لا يُوزَنُ لِكثرَتِهِ، <verse eid="1CH 22:3" /><verse number="4" style="v" pubnumber="4" sid="1CH 22:4" />وخشَبَ أرْزٍ لا يُحصى، أحضَرَهُ الصَّيدونيُّونَ والصُّوريُّونَ بِكثرَةٍ إلى داوُدَ. <verse eid="1CH 22:4" /><verse number="5" style="v" pubnumber="5" sid="1CH 22:5" />فعَلَ داوُدُ ذلِكَ لأنَّهُ قالَ في نفسِهِ: سُليمانُ اَبني صَبيٌّ صغيرٌ قليلُ الخِبرَةِ، فيَجِبُ أنْ أُجَهِّزَ لَه كُلَّ شيءٍ. ذلِكَ أنَّ الهَيكلَ الّذي يُبْنى للرّبِّ سيكونُ عظيمَ الشُّهرَةِ والفخامَةِ في كُلِّ الأرضِ، وهكذا جهَّزَ داوُدُ كُلَّ شيءٍ بِكثرَةٍ قَبلَ وفاتِهِ.<verse eid="1CH 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="1CH 22:6" />ثُمَّ دعا سُليمانَ اَبنَهُ وأوصاهُ بِأنْ يَبنيَ هَيكلًا للرّبِّ إلهِ إِسرائيلَ. <verse eid="1CH 22:6" /><verse number="7" style="v" pubnumber="7" sid="1CH 22:7" />وقالَ لَه داوُدُ: ”كانَ في نيَّتي يا اَبني أنْ أبنيَ هَيكلًا لاَسمِ الرّبِّ إلهي، <verse eid="1CH 22:7" /><verse number="8" style="v" pubnumber="8" sid="1CH 22:8" />لكِنَّ الرّبَّ قالَ لي: سَفكْتَ دَمًا كثيرًا وحارَبْتَ حروبًا كثيرةً، لِذا لن تَبنيَ هَيكلًا لاَسمي لأنَّكَ سَفكْتَ دَمًا كثيرًا على الأرضِ أمامي. <verse eid="1CH 22:8" /><verse number="9" style="v" pubnumber="9" sid="1CH 22:9" />لكِنْ سَيولَدُ لكَ اَبنٌ يكونُ رَجُلَ سلامٍ، وأنا أُريحُهُ مِنْ جميعِ أعدائِهِ لأنَّ اَسمَهُ سُليمانُ، وأمنَحُ السَّلامَ والأمانَ لإِسرائيلَ في أيّامِهِ. <verse eid="1CH 22:9" /><verse number="10" style="v" pubnumber="10" sid="1CH 22:10" />فهوَ الّذي يَبني هَيكلًا لاَسمي، ويكونُ لي اَبنًا وأكونُ لَه أبًا، وأُثَبِّتُ عرشَ مُلْكِهِ على بَني إِسرائيلَ إلى الأبدِ. <verse eid="1CH 22:10" /><verse number="11" style="v" pubnumber="11" sid="1CH 22:11" />فالآنَ يا اَبني، لِيكنِ الرّبُّ معَكَ، فتَنجَحَ وتَبنيَ هَيكلَ الرّبِّ إلهِكَ، كما قالَ ذلِكَ عَنكَ. <verse eid="1CH 22:11" /><verse number="12" style="v" pubnumber="12" sid="1CH 22:12" />وليَمنَحْكَ الرّبُّ إلهُكَ حِكمَةً وفَهْمًا فتَحكُمَ بَني إِسرائيلَ بِحسَبِ شريعتِهِ. <verse eid="1CH 22:12" /><verse number="13" style="v" pubnumber="13" sid="1CH 22:13" />فأنتَ تَنجَحُ إذا عَمِلْتَ بالفرائِضِ والأحكامِ الّتي أمرَ بِها الرّبُّ بَني إِسرائيلَ على لِسانِ موسى. فتَشَدَّدْ وتشَجَّعْ. لا تَخَفْ ولا تَرهَبْ. <verse eid="1CH 22:13" /><verse number="14" style="v" pubnumber="14" sid="1CH 22:14" />أمَّا هَيكلُ الرّبِّ فأنا رُغْمَ فَقْري جَهَّزْتُ لَه أربَعةَ آلافِ طُنٍّ مِنَ الذَّهبِ وأربعينَ ألفَ طُنٍّ مِنَ الفِضَّةِ وما لا يُوزَنُ مِنَ النُّحاسِ والحديدِ لِكثرَتِهِ. وجَهَّزْتُ أخشابًا وحجارةً وأنتَ سَتزيدُ علَيها. <verse eid="1CH 22:14" /><verse number="15" style="v" pubnumber="15" sid="1CH 22:15" />وعِندَكَ صُنَّاعٌ كثيرونَ لِلعمَلِ: نَحَّاتونَ وبَنَّاؤونَ ونَجَّارونَ وما لا يُحصى مِنَ المهَرَةِ في كُلِّ ما يُصنَعُ <verse eid="1CH 22:15" /><verse number="16" style="v" pubnumber="16" sid="1CH 22:16" />بالذَّهبِ والفِضَّةِ والنُّحاسِ والحديدِ. فقُمْ لِلعمَلِ، وليكُنِ الرّبُّ معَكَ“.<verse eid="1CH 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="1CH 22:17" />وأوصى داوُدُ جميعَ الرُّؤساءِ في بَني إِسرائيلَ بِأنْ يُساعِدوا سُليمانَ اَبنَهُ، فقالَ لهُم: <verse eid="1CH 22:17" /><verse number="18" style="v" pubnumber="18" sid="1CH 22:18" />”أمَا كانَ الرّبُّ إلهُكُم معَكُم، فأراحكُم مِنَ الحروبِ معَ الشُّعوبِ، وسَلَّمَ سُكَّانَ هذِهِ الأرضِ إلى يَدي، وهيَ خاضِعَةٌ للرّبِّ ولِشعبِهِ؟ <verse eid="1CH 22:18" /><verse number="19" style="v" pubnumber="19" sid="1CH 22:19" />فَوَجِّهوا الآنَ قُلوبَكُم ونُفوسَكُم إلى الرّبِّ إلهِكُم، وقُومُوا واَبنوا هَيكلًا لاَسمِهِ القُدُّوسِ لإيواءِ تابوتِ عَهدِهِ وآنيةِ اللهِ المُقَدَّسةِ.<verse eid="1CH 22:19" /></para>
  <chapter eid="1CH 22" />
  <chapter number="23" style="c" sid="1CH 23" />
  <para style="s1">وظائف اللاويين ومراتبهم</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="1CH 23:1" />ولمَّا شاخَ داوُدُ وشَبِعَ مِنَ الأيّامِ أقامَ سُليمانَ اَبنَهُ مَلِكًا على بَني إِسرائيلَ. <verse eid="1CH 23:1" /><verse number="2" style="v" pubnumber="2" sid="1CH 23:2" />وجمَعَ كُلَّ رؤساءِ إِسرائيلَ وكُلَّ الكهَنةِ واللَّاويِّينَ، <verse eid="1CH 23:2" /><verse number="3" style="v" pubnumber="3" sid="1CH 23:3" />فأحصى اللَّاويِّينَ مِنِ اَبنِ ثَلاثينَ سنَةً فما فَوقُ، فكانَ عدَدُهُم ثمانيةً وثَلاثينَ ألفَ رجُلٍ. <verse eid="1CH 23:3" /><verse number="4" style="v" pubnumber="4" sid="1CH 23:4" />فعَيَّنَ مِنهُم أربَعةً وعشرينَ ألفًا مُراقبينَ على بِناءِ هَيكلِ الرّبِّ، وسِتَّةَ آلافِ مُوَظَّفٍ وقاضٍ، <verse eid="1CH 23:4" /><verse number="5" style="v" pubnumber="5" sid="1CH 23:5" />وأربَعةَ آلافِ بَوَّابٍ، وأربَعةَ آلافِ مُنشِدٍ للرّبِّ على آلاتِ التَّسبيحِ. <verse eid="1CH 23:5" /><verse number="6" style="v" pubnumber="6" sid="1CH 23:6" />وقَسَّمَهُم داوُدُ فِرَقًا بِحسَبِ عشائِرِ بَني لاويِّ الثَّلاثِ: جَرشونَ وقَهاتَ ومَراري.<verse eid="1CH 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="1CH 23:7" />وكانَ لِجَرشونَ اَبنانِ: لَعْدانُ وشَمْعي، <verse eid="1CH 23:7" /><verse number="8" style="v" pubnumber="8" sid="1CH 23:8" />ولِلَعْدانَ ثَلاثةُ بَنينَ: أوَّلُهُم يَحيئيلُ ثُمَّ زيثامُ ويوئيلُ، <verse eid="1CH 23:8" /><verse number="9" style="v" pubnumber="9" sid="1CH 23:9" />ولِشَمْعي ثَلاثةُ بَنينَ: شَلوميثُ وحَزيئيلُ وهارانُ. هؤلاءِ رؤساءُ البيوتِ المُنتَسِبةِ للَعْدانَ. <verse eid="1CH 23:9" /><verse number="10" style="v" pubnumber="10" sid="1CH 23:10" />وبَنو شَمْعي أربَعةٌ: يَحَثُ وزيزا ويَعوشُ وبَريعةُ. <verse eid="1CH 23:10" /><verse number="11" style="v" pubnumber="11" sid="1CH 23:11" />وكانَ يَحَثُ أوَّلَهُم ثُمَّ زيزا، وأمَّا يَعوشُ وبَريعَةُ فما كانَ لهُما بَنونَ كثيرونَ فَحُسِبوا بَيتًا واحدًا.<verse eid="1CH 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="1CH 23:12" />وبَنو قَهاتَ أربَعةٌ: عَمرامُ ويَصهارُ وحبرونُ وعُزِّيئيلُ. <verse eid="1CH 23:12" /><verse number="13" style="v" pubnumber="13" sid="1CH 23:13" />وعَمرامُ ولَدَ هرونَ وموسى. وتكَرَّسَ هرونُ للخِدمةِ في قُدْسِ الأقداسِ هوَ وبَنوهُ إلى الأبدِ: لِيُوقِدَ البَخورَ أمامَ الرّبِّ ويَخدِمَهُ ويُبارِكَ الشَّعبَ باَسمِهِ. <verse eid="1CH 23:13" /><verse number="14" style="v" pubnumber="14" sid="1CH 23:14" />أمَّا موسى رَجُلُ اللهِ، فعُدَّ بَنوهُ في سِبْطِ لاويِّ. <verse eid="1CH 23:14" /><verse number="15" style="v" pubnumber="15" sid="1CH 23:15" />واَبنا موسى: جَرشومُ وأليعَزَرُ. <verse eid="1CH 23:15" /><verse number="16" style="v" pubnumber="16" sid="1CH 23:16" />ولِجَرشومَ بَنونَ أوَّلُهُم شَبوئيلُ. <verse eid="1CH 23:16" /><verse number="17" style="v" pubnumber="17" sid="1CH 23:17" />ولأليعَزَرَ اَبنٌ واحدٌ: رَحَبْيا، وأمَّا بَنو رَحَبْيا فكانوا كثيرينَ جِدًّا. <verse eid="1CH 23:17" /><verse number="18" style="v" pubnumber="18" sid="1CH 23:18" />واَبنُ يَصهارَ: شَلوميثُ وهوَ رئيسُ بَيتِ أبيهِ. <verse eid="1CH 23:18" /><verse number="19" style="v" pubnumber="19" sid="1CH 23:19" />وبَنو حبرونَ أربَعةٌ: يَرِيَّا أوَّلُهُم ثُمَّ أمُرْيا ويَحْزيئيلُ ويَقمَعامُ. <verse eid="1CH 23:19" /><verse number="20" style="v" pubnumber="20" sid="1CH 23:20" />واَبنا عُزِّيئيلَ: ميخا أوَّلُهُما ثُمَّ يَشِّيَّا. <verse eid="1CH 23:20" /><verse number="21" style="v" pubnumber="21" sid="1CH 23:21" />واَبنا مَراري: مَحْلي ومُوشى. واَبنا مَحْلي: ألعازارُ وقَيشُ. <verse eid="1CH 23:21" /><verse number="22" style="v" pubnumber="22" sid="1CH 23:22" />وماتَ ألعازارُ ولم يكُنْ لَه بَنونَ بل بَناتٌ، فَتَزَوَّجهنَّ بَنو قَيشَ عَمِّهِنَّ. <verse eid="1CH 23:22" /><verse number="23" style="v" pubnumber="23" sid="1CH 23:23" />وبَنو موشى ثَلاثةٌ: مَحْلي وعادَرُ ويَريموثُ. <verse eid="1CH 23:23" /><verse number="24" style="v" pubnumber="24" sid="1CH 23:24" />هؤلاءِ بَنو لاوي بِحسَبِ بيوتِ آبائِهِم وعَشائِرِهِم كما أُحصُوا بأسمائِهِم واحدًا واحدًا. وتوَلَّى العمَلَ لِخِدمةِ هَيكلِ الرّبِّ كُلُّ مَنْ جاوزَ مِنهُمُ العشرينَ مِنَ العُمرِ، <verse eid="1CH 23:24" /><verse number="25" style="v" pubnumber="25" sid="1CH 23:25" />لأنَّ داوُدَ قالَ: ”أراحَ الرّبُّ إلهُ إِسرائيلَ شعبَهُ، وهوَ يَسكُنُ في أورُشليمَ إلى الأبدِ. <verse eid="1CH 23:25" /><verse number="26" style="v" pubnumber="26" sid="1CH 23:26" />فلن يَحمِلَ اللَّاويُّونَ مِنْ بَعدُ مَسكِنَهُ ولا أيَّ شيءٍ يُستَعمَلُ لِخِدمَتِهِ“. <verse eid="1CH 23:26" /><verse number="27" style="v" pubnumber="27" sid="1CH 23:27" />لِهذا: أُحصيَ بَنو لاويّ مِنِ اَبنِ عشرينَ فما فَوقُ، <verse eid="1CH 23:27" /><verse number="28" style="v" pubnumber="28" sid="1CH 23:28" />فكانوا تَحتَ تَصَرُّفِ بَني هرونَ لِخِدمةِ هَيكلِ الرّبِّ، ولِلعنايةِ بالدُّورِ والغُرَفِ وتَطهيرِ كُلِّ شيءٍ مُقدَّسٍ لِلعبادةِ، <verse eid="1CH 23:28" /><verse number="29" style="v" pubnumber="29" sid="1CH 23:29" />وللمُساعَدةِ في تأمينِ الخُبزِ وسميذِ التَّقدِمةِ ورِقاقِ الفطيرِ وما يُخبَزُ على الصَّاجِ ويُعجَنُ بالزَّيتِ. وكذلِكَ في كُلِّ كَيلٍ وقياسٍ، <verse eid="1CH 23:29" /><verse number="30" style="v" pubnumber="30" sid="1CH 23:30" />ولِلحُضورِ كُلَّ صباحٍ ومساءٍ لِحَمدِ الرّبِّ وتَسبيحِهِ، <verse eid="1CH 23:30" /><verse number="31" style="v" pubnumber="31" sid="1CH 23:31" />ولِتَقديمِ مُحرَقاتِ الرّبِّ في أيّامِ السَّبتِ ورُؤوسِ الشُّهورِ والأعيادِ، بِحسَبِ العدَدِ المَفروضِ علَيهِم دائمًا أمامَ الرّبِّ، <verse eid="1CH 23:31" /><verse number="32" style="v" pubnumber="32" sid="1CH 23:32" />ولِلقيامِ بِحِراسةِ خَيمةِ الاجتماعِ وآنيةِ اللهِ المُقَدَّسةِ، وحِراسةِ بَني هرونَ أنسِبائِهِم في خِدمةِ هَيكلِ الرّبِّ.</para>
  <para style="p" vid="1CH 23:32">وظائف الكهنة<verse eid="1CH 23:32" /></para>
  <chapter eid="1CH 23" />
  <chapter number="24" style="c" sid="1CH 24" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="1CH 24:1" />وهذِهِ هيَ فِرَقُ بَني هرونَ: بَنو هرونَ أربَعةٌ: نادابُ وأبيهو وألِعازارُ وإيثامارُ. <verse eid="1CH 24:1" /><verse number="2" style="v" pubnumber="2" sid="1CH 24:2" />وماتَ نادابُ وأبيهو قَبلَ أبيهِما، ولم يكُنْ لهُما بَنونَ، فتَوَلَّى الكهانةَ إلعازارُ وإيثامارُ. <verse eid="1CH 24:2" /><verse number="3" style="v" pubnumber="3" sid="1CH 24:3" />وقسَمَهُم داوُدُ بِمُساعدَةِ صادوقَ مِنْ بَني ألعازارَ، وأخيمالِكَ مِنْ بَني إيثامارَ، على حسَبِ وظيفَتِهِم في الخِدمةِ. <verse eid="1CH 24:3" /><verse number="4" style="v" pubnumber="4" sid="1CH 24:4" />فقَسَموا بَني ألعازارَ سِتَّ عَشْرَةَ فِرقَةً وبَني إيثامارَ ثَمانيَ فِرَقٍ، لأنَّهُم وجَدوا أنَّ لِبَني ألعازارَ رؤساءً لِعائلاتِهِم أكثَرَ مِمَّا لِبَني إيثامارَ. <verse eid="1CH 24:4" /><verse number="5" style="v" pubnumber="5" sid="1CH 24:5" />قسَموهُم جميعًا بالقُرعةِ، لأنَّ القائِمينَ على الخِدمةِ في القُدْسِ وفي هَيكلِ الرّبِّ كانوا مِنْ بَني ألعازارَ وبَني إيثامارَ على السَّواءِ. <verse eid="1CH 24:5" /><verse number="6" style="v" pubnumber="6" sid="1CH 24:6" />وسَجَّلَهُم شَمَعْيا بنُ نَثَنئيلَ، وهوَ كاتِبٌ مِنَ اللَّاويِّينَ، أمامَ المَلِكِ والرُّؤساءِ وصادوقَ الكاهنِ وأخيمالِكَ بنِ أبياثارَ ورؤساءِ عائِلاتِ الكهَنةِ واللَّاويِّينَ. <verse eid="1CH 24:6" /><verse number="7" style="v" pubnumber="7" sid="1CH 24:7" />فأُلقِيَتِ القُرعةُ الأولى ليوياريبَ، والثَّانيةُ لِيَدْعِيا، <verse eid="1CH 24:7" /><verse number="8" style="v" pubnumber="8" sid="1CH 24:8" />والثَّالثةُ لِحاريمَ، والرَّابعةُ لِسَعوريمَ، <verse eid="1CH 24:8" /><verse number="9" style="v" pubnumber="9" sid="1CH 24:9" />والخامسةُ لِمُلْكِيَّا، والسَّادسةُ لِمَيَّامينَ، <verse eid="1CH 24:9" /><verse number="10" style="v" pubnumber="10" sid="1CH 24:10" />والسَّابِعةُ لِهَقُّوصَ، والثَّامنةُ لأبيَّا، <verse eid="1CH 24:10" /><verse number="11" style="v" pubnumber="11" sid="1CH 24:11" />والتَّاسِعةُ ليشوعَ، والعاشِرَةُ لِشَكُنْيا، <verse eid="1CH 24:11" /><verse number="12" style="v" pubnumber="12" sid="1CH 24:12" />والحاديَةَ عَشْرَةَ لألياشيبَ، والثَّانيةَ عَشْرَةَ لياقيمَ، <verse eid="1CH 24:12" /><verse number="13" style="v" pubnumber="13" sid="1CH 24:13" />والثَّالثةَ عَشْرَةَ لِحُفَّهَ، والرَّابِعةَ عَشْرَةَ لِيَشَبْآبَ، <verse eid="1CH 24:13" /><verse number="14" style="v" pubnumber="14" sid="1CH 24:14" />والخامِسةَ عَشْرَةَ لِبَلْجَةَ، والسَّادِسةَ عَشْرَةَ لإيميرَ، <verse eid="1CH 24:14" /><verse number="15" style="v" pubnumber="15" sid="1CH 24:15" />والسَّابِعةَ عَشْرَةَ لِحيزيرَ، والثَّامنةَ عَشْرَةَ لِهَفْصيصَ، <verse eid="1CH 24:15" /><verse number="16" style="v" pubnumber="16" sid="1CH 24:16" />والتاسِعةَ عَشْرَةَ لِفَقَحْيَا، والعشرونَ ليَحَزْقيئيلَ، <verse eid="1CH 24:16" /><verse number="17" style="v" pubnumber="17" sid="1CH 24:17" />والحاديَةُ والعشرونَ لياكينَ، والثَّانيَةُ والعشرونَ لجامولَ، <verse eid="1CH 24:17" /><verse number="18" style="v" pubnumber="18" sid="1CH 24:18" />والثَّالثةُ والعشرونَ لدلايا، والرَّابعةُ والعشرونَ لِمَعَزْيا. <verse eid="1CH 24:18" /><verse number="19" style="v" pubnumber="19" sid="1CH 24:19" />هؤلاءِ تسَجَّلوا حسَبَ وظائِفِهِم لِلخِدمةِ في هَيكلِ الرّبِّ تَحتَ يَدِ هرونَ نَسيبِهِم، كما أمرَهُ الرّبُّ إلهُ إِسرائيلَ.<verse eid="1CH 24:19" /></para>
  <para style="s1">اللاويون الباقون</para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="1CH 24:20" />وأمَّا بَنو لاويّ الباقونَ، فَمِنْ بَني عَمرامَ: شوبائيلُ، ومِنْ بَني شوبائيلَ: يَحَدْيا، <verse eid="1CH 24:20" /><verse number="21" style="v" pubnumber="21" sid="1CH 24:21" />ومِنْ بني رَحَبْيا: يَشِّيَّا الرئيسُ، <verse eid="1CH 24:21" /><verse number="22" style="v" pubnumber="22" sid="1CH 24:22" />ومِنْ بَني أليصهارَ: شَلوموثُ، ومِنْ بَني شلوموث: يَحَثُ <verse eid="1CH 24:22" /><verse number="23" style="v" pubnumber="23" sid="1CH 24:23" />ومِنْ بَني حبرونَ: يَريَّا ثُمَّ أمَرْيا ويَحْزيئيلُ ويَقْمَعامُ، <verse eid="1CH 24:23" /><verse number="24" style="v" pubnumber="24" sid="1CH 24:24" />ومِنْ بَني عُزِّيئيلَ: ميخا، ومِنْ بَني ميخا: شامورُ. <verse eid="1CH 24:24" /><verse number="25" style="v" pubnumber="25" sid="1CH 24:25" />وأخو ميخا: يَشِّيَّا، ومِنْ بَني يَشِّيَّا: زَكَريَّا. <verse eid="1CH 24:25" /><verse number="26" style="v" pubnumber="26" sid="1CH 24:26" />واَبنا مَراري: مَحْلي ومُوشي. واَبنُ يَعَزْيا بَنُو. <verse eid="1CH 24:26" /><verse number="27" style="v" pubnumber="27" sid="1CH 24:27" />ومِنْ بَني مَراري ليَعَزْيا: بَنو وشوهَمُ وزَكُّورُ وعِبري، <verse eid="1CH 24:27" /><verse number="28" style="v" pubnumber="28" sid="1CH 24:28" />ومِنْ مَحْلي: إلعازارُ ولم يكُنْ لَه بَنونَ، <verse eid="1CH 24:28" /><verse number="29" style="v" pubnumber="29" sid="1CH 24:29" />وقَيشُ وكانَ لَه يَرْحَمْئيلُ. <verse eid="1CH 24:29" /><verse number="30" style="v" pubnumber="30" sid="1CH 24:30" />وبَنو موشي: مَحْلي وعادِرُ ويريموثُ. هؤلاءِ هُم بَنو اللَّاويِّينَ حسَبَ عائِلاتِهِم. <verse eid="1CH 24:30" /><verse number="31" style="v" pubnumber="31" sid="1CH 24:31" />وألقى رئيسُ كُلِّ عائلَةٍ معَ أصغرِ إخوَتِهِ قُرعةً لتَعيينِ الخِدمةِ، كما فعَلَ أنسباؤُهُم بَنو هرونَ، وهذا أمامَ داوُدَ المَلِكِ وصادوقَ وأخيمالِكَ ورؤساءِ عائِلاتِ الكهَنة واللَّاويِّينَ.<verse eid="1CH 24:31" /></para>
  <chapter eid="1CH 24" />
  <chapter number="25" style="c" sid="1CH 25" />
  <para style="s1">المغنون في هيكل الرب</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="1CH 25:1" />وعَيَّنَ داوُدُ ورؤساءُ اللَّاويِّينَ لِلخِدمةِ بَعضَ بَني آسافَ وهَيمانَ ويدوثونَ لإِنشادِ كلامِ اللهِ على أنغامِ القيثاراتِ والرَّبابِ والصُّنوجِ. وهذِهِ أسماؤُهُم معَ وظائِفِهِم: <verse eid="1CH 25:1" /><verse number="2" style="v" pubnumber="2" sid="1CH 25:2" />فمِنْ بَني آسافَ: زكُّورُ ويوسُفُ ونَثَنْيا وأشَرئيلَةُ، وكانوا يعمَلونَ بِقيادةِ آسافَ أبيهِمِ الّذي كانَ يُنشِدُ كُلَّما أمرَهُ المَلِكُ، <verse eid="1CH 25:2" /><verse number="3" style="v" pubnumber="3" sid="1CH 25:3" />ومِنْ بَني يَدوثونَ: جَدَلْيا وصَري ويِشْعيا وشِمْعي وحَشَبْيا ومَتَّثْيَا. وهُم سِتَّةٌ بِقيادةِ أبيهِم يدوثونَ، وكانوا يُنشدونَ على أنغامِ القيثاراتِ، حامِدينَ ومُسَبِّحينَ الرّبَّ. <verse eid="1CH 25:3" /><verse number="4" style="v" pubnumber="4" sid="1CH 25:4" />ومِنْ بَني هَيمانَ: بَقِّيَّا ومَتَّنْيا وعُزِّيئيلُ وشَبوئيلُ ويَريموثُ وحَنَنْيا وهَناني وإبليآثَةُ، وجِدَّلْتي ورومَمْتي عَزَرُ ويَشْبَقاشَةُ ومَلوثي وهوثيرُ ومَحْزيوثُ. <verse eid="1CH 25:4" /><verse number="5" style="v" pubnumber="5" sid="1CH 25:5" />جميعُ هؤلاءِ الأربعةَ عشَرَ اَبنًا، معَ ثَلاثِ بناتٍ، وهَبَهُمُ الرّبُّ لِهَيمانَ حسَبَ وَعدِهِ لَه لِرَفْعِ مَقامِهِ. <verse eid="1CH 25:5" /><verse number="6" style="v" pubnumber="6" sid="1CH 25:6" />وكانوا يُغَنُّونَ بِقيادةِ أبيهِم في خِدمةِ هَيكلِ الرّبِّ على أنغامِ الصُّنوجِ والرَّبابِ والقيثاراتِ. وكانَ آسافُ ويَدوثونُ وهَيمانُ أنفُسُهُم في خِدمةِ المَلِكِ. <verse eid="1CH 25:6" /><verse number="7" style="v" pubnumber="7" sid="1CH 25:7" />وكانَ جميعُ هؤلاءِ الماهِرينَ معَ أنسِبائِهِم المُدَرَّبينَ على الغِناءِ للرّبِّ مئَتَينِ وثَمانيةً وثَمانينَ. <verse eid="1CH 25:7" /><verse number="8" style="v" pubnumber="8" sid="1CH 25:8" />وألقَوا قُرعةً لِتَحديدِ وظائِفِهِم، سَواءٌ فيهِمِ الصغيرُ والكبيرُ، والمُعَلِّمُ والتِّلميذُ.<verse eid="1CH 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="1CH 25:9" />فكانَتِ القُرعةُ الأولى ليوسُفَ مِنْ أبيآسافَ، والثَّانيةُ لِجَدَليا وبَنيه وإخوتِه الاثني عشَرَ، <verse eid="1CH 25:9" /><verse number="10" style="v" pubnumber="10" sid="1CH 25:10" />والثَّالثةُ لِزَكُّورَ وبَنيه وإخوَتِهِ الاثني عشَرَ، <verse eid="1CH 25:10" /><verse number="11" style="v" pubnumber="11" sid="1CH 25:11" />والرَّابِعةُ لِيَصْري وبَنيهِ وإخوَتِهِ الاثني عشَرَ، <verse eid="1CH 25:11" /><verse number="12" style="v" pubnumber="12" sid="1CH 25:12" />والخامِسةُ لِنَثَنْيا وبَنيهِ وإخوتِهِ الاثني عشَرَ، <verse eid="1CH 25:12" /><verse number="13" style="v" pubnumber="13" sid="1CH 25:13" />والسَّادِسَةُ لِبُقِّيَّا وبَنيهِ وإخوتِهِ الاثني عشَرَ، <verse eid="1CH 25:13" /><verse number="14" style="v" pubnumber="14" sid="1CH 25:14" />والسَّابِعةُ لِيَشْرئيلَةَ وبَنيهِ وإخوتِهِ الاثني عشَرَ، <verse eid="1CH 25:14" /><verse number="15" style="v" pubnumber="15" sid="1CH 25:15" />والثَّامِنةُ لِيَشْعيا وبَنيهِ وإخوتِهِ الاثني عشَرَ، <verse eid="1CH 25:15" /><verse number="16" style="v" pubnumber="16" sid="1CH 25:16" />والتَّاسِعةُ لِمَتَّنْيا وبَنيهِ وإخوتِهِ الاثني عشَرَ، <verse eid="1CH 25:16" /><verse number="17" style="v" pubnumber="17" sid="1CH 25:17" />والعاشرةُ لِشِمْعي وبَنيهِ وإخوتِهِ الاثني عشَرَ، <verse eid="1CH 25:17" /><verse number="18" style="v" pubnumber="18" sid="1CH 25:18" />والحاديةَ عَشْرَةَ لِعزرئيل وبَنيهِ وإخوتِهِ الاثني عشَرَ، <verse eid="1CH 25:18" /><verse number="19" style="v" pubnumber="19" sid="1CH 25:19" />والثَّانيةَ عشْرَةَ لِحَشَبِيَّا وبَنيهِ وإخوَتِهِ الاثني عشَرَ، <verse eid="1CH 25:19" /><verse number="20" style="v" pubnumber="20" sid="1CH 25:20" />والثَّالِثِةَ عَشْرَةَ لِشوبائيلَ وبَنيهِ وإخوتِهِ الاثني عشَرَ، <verse eid="1CH 25:20" /><verse number="21" style="v" pubnumber="21" sid="1CH 25:21" />والرَّابِعةَ عَشْرَةَ لِمَتَّثِيَّا وبَنيهِ وإخوتِهِ الاثني عشَرَ، <verse eid="1CH 25:21" /><verse number="22" style="v" pubnumber="22" sid="1CH 25:22" />والخامِسةَ عَشْرَةَ ليريموثَ وبَنيهِ وإخوتِهِ الاثني عشَرَ، <verse eid="1CH 25:22" /><verse number="23" style="v" pubnumber="23" sid="1CH 25:23" />والسَّادِسَةَ عَشْرَةَ لِحَنَنْيا وبَنيهِ وإخوتِهِ الاثني عشَرَ، <verse eid="1CH 25:23" /><verse number="24" style="v" pubnumber="24" sid="1CH 25:24" />والسَّابِعةَ عَشْرَةَ لِيَشبَقاشَةَ وبَنيهِ وإخوتِهِ الاثني عشَرَ، <verse eid="1CH 25:24" /><verse number="25" style="v" pubnumber="25" sid="1CH 25:25" />والثَّامنةَ عَشْرَةَ لِحَناني وبَنيهِ وإخوتِهِ الاثني عشَرَ، <verse eid="1CH 25:25" /><verse number="26" style="v" pubnumber="26" sid="1CH 25:26" />والتَّاسِعةَ عَشْرَةَ لِمَلُّوثي وبَنيهِ وإخوتِهِ الاثني عشَرَ، <verse eid="1CH 25:26" /><verse number="27" style="v" pubnumber="27" sid="1CH 25:27" />والعشرونَ لإيلياثَةَ وبنيهِ وإخوتِهِ الاثني عشَرَ، <verse eid="1CH 25:27" /><verse number="28" style="v" pubnumber="28" sid="1CH 25:28" />والحاديةُ والعشرونَ لِهوثيرَ وبَنيهِ وإخوتِهِ الاثني عشَرَ، <verse eid="1CH 25:28" /><verse number="29" style="v" pubnumber="29" sid="1CH 25:29" />والثَّانيةُ والعشرونَ لِجِدَّلْتي وبَنيهِ وإخوتِهِ الاثني عشَرَ، <verse eid="1CH 25:29" /><verse number="30" style="v" pubnumber="30" sid="1CH 25:30" />والثَّالثةُ والعشرونَ لِمَخْريوثَ وبنيهِ وإخوتِهِ الاثني عشَرَ، <verse eid="1CH 25:30" /><verse number="31" style="v" pubnumber="31" sid="1CH 25:31" />والرَّابعةُ والعشرونَ لِرومَمْتي عَزَرَ وبَنيهِ وإخوتِهِ الاثني عشَر.<verse eid="1CH 25:31" /></para>
  <chapter eid="1CH 25" />
  <chapter number="26" style="c" sid="1CH 26" />
  <para style="s1">حراس هيكل الرب</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="1CH 26:1" />وأمَّا البَوَّابونَ فَقُسِّموا لِحراسَةِ هَيكلِ الرّبِّ على الشَّكلِ التَّالي:</para>
  <para style="p" vid="1CH 26:1">مِنْ بَني قورَحَ: مَشَلَمْيا بنُ قوري مِنْ بَني آسافَ. <verse eid="1CH 26:1" /><verse number="2" style="v" pubnumber="2" sid="1CH 26:2" />وكانَ لِمَشَلَمْيا سَبعَةُ بَنينَ: زَكَريَّا البِكْرُ، ثُمَّ يَديَعئيلُ وزَبَدْيا ويَثَنْئيلُ <verse eid="1CH 26:2" /><verse number="3" style="v" pubnumber="3" sid="1CH 26:3" />وعيلامُ ويوحانانُ واليوعينايُ. <verse eid="1CH 26:3" /><verse number="4" style="v" pubnumber="4" sid="1CH 26:4" />وكانَ لِعوبيدَ أدومَ ثَمانيةُ بَنينَ: شَمْعيا البِكْرُ، ثُمَّ يُوزابادُ ويوآخُ وساكارُ ونَثَنْئيلُ <verse eid="1CH 26:4" /><verse number="5" style="v" pubnumber="5" sid="1CH 26:5" />وعَمِّيئيلُ ويَسَّاكَرُ وفَعَلْتايُ، لأنَّ اللهَ باركَهُ. <verse eid="1CH 26:5" /><verse number="6" style="v" pubnumber="6" sid="1CH 26:6" />وكانَ لِشَمْعيا اَبنِهِ سِتَّةُ بَنينَ حكَموا في عائلةِ أبيهِم لأنَّهُم كانوا جبابِرةً أشِدَّاءَ، <verse eid="1CH 26:6" /><verse number="7" style="v" pubnumber="7" sid="1CH 26:7" />وهُم عَثني ورفائيلُ وعوبيدُ وألزابادُ وأليهو وسَمَكْيا، والأخيرانِ تَمَيَّزا بِشِدَّةِ البأْسِ. <verse eid="1CH 26:7" /><verse number="8" style="v" pubnumber="8" sid="1CH 26:8" />وكانَ جميعُ هؤلاءِ وبَنوهُم وأنسباؤُهُم البالِغُ عَدَدُهُم اَثنينِ وستِّينَ جبابِرةً أشِدَّاءَ. <verse eid="1CH 26:8" /><verse number="9" style="v" pubnumber="9" sid="1CH 26:9" />وكانَ لِمَشَلَمْيا ثَمانيةَ عشَرَ اَبنًا ونَسيبًا وكُلُّهُم شَديدو البَأْسِ. <verse eid="1CH 26:9" /><verse number="10" style="v" pubnumber="10" sid="1CH 26:10" />وكانَ لِحوسَةَ مِنْ بَني مَراري أربَعةُ بَنينَ: شِمْري الّذي عيَّنَهُ أبوهُ رئيسًا معَ أنَّهُ لم يكُنْ بِكْرًا، <verse eid="1CH 26:10" /><verse number="11" style="v" pubnumber="11" sid="1CH 26:11" />ثُمَّ حَلْقيَّا وطَبَلْيا وزَكَريَّا. فجميعُ بَني حوسَةَ هؤلاءِ وأنسباؤُهُم ثَلاثةَ عشَرَ.<verse eid="1CH 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="1CH 26:12" />وكانَ هؤلاءِ البَوَّابونَ مُنْقَسمينَ فِرَقًا بِحَسَبِ رُؤسائِهِم، وأُسنِدَت إليهِم وظائِفُ في خِدمةِ هَيكلِ الرّبِّ مِثلَ أنسبائِهِم. <verse eid="1CH 26:12" /><verse number="13" style="v" pubnumber="13" sid="1CH 26:13" />فألقَوا قُرَعًا، على صغيرِهِم وكبيرِهِم، بِحسَبِ بيوتِ آبائِهِم لِتَعيينِ الحِراسةِ على كلِّ بابٍ. <verse eid="1CH 26:13" /><verse number="14" style="v" pubnumber="14" sid="1CH 26:14" />فأصابَتِ القُرعةُ شَلَمْيا لِحِراسَةِ البابِ الشَّرقيِّ، وزَكَريَّا اَبنِهِ الدَّاهيةِ في الرَّأيِ لِحِراسةِ البابِ الشَّماليِّ، <verse eid="1CH 26:14" /><verse number="15" style="v" pubnumber="15" sid="1CH 26:15" />وعوبيدَ أدومَ لِحِراسةِ البابِ الجنوبيِّ وبَنيهِ لِحِراسةِ المَخازِنِ، <verse eid="1CH 26:15" /><verse number="16" style="v" pubnumber="16" sid="1CH 26:16" />وشُفيمَ وحوسَةَ لِحِراسةِ البابِ الغَربيِّ معَ بابِ شَلَّكةَ عِندَ مَطلَعِ الطَّريقِ. وكانتِ الحِراسةُ بالتَّناوبِ وبِغَيرِ اَنقِطاعٍ. <verse eid="1CH 26:16" /><verse number="17" style="v" pubnumber="17" sid="1CH 26:17" />فكانَ مِنْ هؤلاءِ البَوَّابينَ لِكُلِّ يومٍ سِتَّةٌ مِنْ جِهَةِ الشَّرقِ، وأربعةٌ مِنْ جِهَةِ الشَّمالِ، وأربَعةٌ مِنْ جِهَةِ الجَنوبِ، واَثنانِ على كُلٍّ مِنَ المَخزَنينِ. <verse eid="1CH 26:17" /><verse number="18" style="v" pubnumber="18" sid="1CH 26:18" />وكانَ مِنْ جِهَةِ الرِّواقِ إلى الغربِ أربعةٌ في مَطلَعِ الطَّريقِ واَثنانِ في الرِّواقِ ذاتِهِ. <verse eid="1CH 26:18" /><verse number="19" style="v" pubnumber="19" sid="1CH 26:19" />هذِهِ هي فِرَقُ البَوَّابينَ مِنْ بَني قورَحَ وبَني مَراري.<verse eid="1CH 26:19" /></para>
  <para style="s1">وظائف أخرى للاويّين</para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="1CH 26:20" />وكانَ بَعضُ أنسِباءِ هؤلاءِ اللَّاويِّينَ حُرَّاسًا على خَزائِنِ الهَيكلِ وخَزائِنِ الهِباتِ المُكرَّسةِ للرّبِّ. <verse eid="1CH 26:20" /><verse number="21" style="v" pubnumber="21" sid="1CH 26:21" />فمِنهُم لَعْدانُ مِنْ بَني جَرشون، وهوَ أبٌ لِعِدَّةِ عائلاتٍ، مِنْها بَيتُ يَحيئيلي اَبنِهِ. <verse eid="1CH 26:21" /><verse number="22" style="v" pubnumber="22" sid="1CH 26:22" />واَبنا يَحيئيلي: زيثامُ ويوئيلُ اللَّذانِ توَلَّيا حِراسةَ خزائِنِ الهَيكلِ. <verse eid="1CH 26:22" /><verse number="23" style="v" pubnumber="23" sid="1CH 26:23" />ومِنْ بَني عَمرامَ وأليصهارَ وحبرونَ وعزِّيئيلَ <verse eid="1CH 26:23" /><verse number="24" style="v" pubnumber="24" sid="1CH 26:24" />كانَ شبوئيلُ بنُ جَرشومَ بنِ موسى رئيسًا على حِراسةِ تِلكَ الخَزائِنِ. <verse eid="1CH 26:24" /><verse number="25" style="v" pubnumber="25" sid="1CH 26:25" />وأنسباؤُهُ مِنْ إلعازارَ: شَلوميثُ بنُ زِكْري بنِ يورامَ بنِ يَشْعيا بنِ رَحَبْيا. <verse eid="1CH 26:25" /><verse number="26" style="v" pubnumber="26" sid="1CH 26:26" />وكانَ شلوميثُ هذا وأنسباؤُهُ وكلاءَ على جميعِ خَزائنِ الهِباتِ الّتي كرَّسَها للرّبِّ داوُدُ المَلِكُ، ورؤساءُ العائِلاتِ، وقادةُ الألوفِ والمِئاتِ وضُبَّاطُ الجيشِ. <verse eid="1CH 26:26" /><verse number="27" style="v" pubnumber="27" sid="1CH 26:27" />فهؤلاءِ كرَّسوا بَعضَ ما غَنِمُوه في الحروبِ لِترميمِ الهَيكلِ. <verse eid="1CH 26:27" /><verse number="28" style="v" pubnumber="28" sid="1CH 26:28" />وكانَ شَلوميثُ وأنسباؤُهُ أيضًا وكلاءَ على كُلِّ ما كرَّسَهُ للرّبِّ صموئيلُ الرَّائي وشاولُ بنُ قَيشَ وأبنيرُ بنُ نيرَ ويوآبُ بنُ صَرويَّةَ.<verse eid="1CH 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="1CH 26:29" />وتوَلَّى كَنَنْيا وبَنوهُ مِنْ بَني أليصهارَ وظائِفَ خارجةً عَنِ الخِدمةِ في الهَيكلِ، فكانوا كتَبَةً وقُضاةً لِشعبِ إِسرائيلَ.<verse eid="1CH 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="1CH 26:30" />وكانَ حشَبْيا وأنسِباؤُهُ مِنْ بَني حبرونَ، وهُم ألفٌ وسَبْعُ مئَةِ رَجُلٍ مُقتَدِرٍ، وكلاءَ على بَني إِسرائيلَ غربيَّ الأردُنِّ في جميعِ الأمورِ الخاصَّةِ بالهَيكلِ وخِدمةِ المَلِكِ. <verse eid="1CH 26:30" /><verse number="31" style="v" pubnumber="31" sid="1CH 26:31" />وكانَ يَرِيَّا رئيسًا لِبَني حبرونَ في السَّنةِ الرَّابعةِ مِنْ عَهدِ المَلِكِ داوُدَ، فبَحَثَ بِحسَبِ مواليدِ عائلاتِهِم، فوَجَدَ فيهمِ جبابِرةً أشدّاءَ في يَعزيرَ بِجلعادَ. <verse eid="1CH 26:31" /><verse number="32" style="v" pubnumber="32" sid="1CH 26:32" />فما كانَ مِنْ داوُدَ المَلِكِ إلَّا أنْ جعَلَ يَريَّا وألفَينِ وسَبعَ مئَةٍ مِنْ أنسبائِهِ هؤلاءِ، وكُلُّهُم مُقتَدِرٌ ورئيسٌ لِعائِلَتِهِ، وكلاءَ على بَني رَأوبينَ وجادَ ونِصفِ سِبْطِ منَسَّى شَرقيَّ الأردُنِّ في جميعِ الأمورِ الخاصَّةِ بالهَيكلِ والمَلِكِ.<verse eid="1CH 26:32" /></para>
  <chapter eid="1CH 26" />
  <chapter number="27" style="c" sid="1CH 27" />
  <para style="s1">نظام الجيش والإدارة</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="1CH 27:1" />وهذِهِ في إِسرائيلَ أسماءُ رُؤساءِ العائِلاتِ وقادةِ الألوفِ والمِئاتِ وضُبَّاطِهِم الّذينَ خَدموا المَلِكَ في جميعِ الأمورِ. وكانوا شهرًا فشهرًا على مَدارِ السَّنةِ يتَناوبونَ الخِدمةَ في فِرَقٍ مِنْ أربَعةٍ وعشرينَ ألفًا. <verse eid="1CH 27:1" /><verse number="2" style="v" pubnumber="2" sid="1CH 27:2" />وكانَ رئيسَ الفِرقَةِ الأولى لِلشَّهرِ الأوَّلِ يَشُبْعامُ بْنُ زَبْديئيلَ <verse eid="1CH 27:2" /><verse number="3" style="v" pubnumber="3" sid="1CH 27:3" />وهوَ مِنْ بني فارصَ، <verse eid="1CH 27:3" /><verse number="4" style="v" pubnumber="4" sid="1CH 27:4" />وعلى رأسِ فِرقَةِ الشَّهرِ الثَّاني دودايُ الأخوخيُّ، ومِنْ فِرْقَتِهِ مَقْلوتُ القائدُ، <verse eid="1CH 27:4" /><verse number="5" style="v" pubnumber="5" sid="1CH 27:5" />وعلى رأسِ فِرقَةِ الشَّهرِ الثَّالثِ بَنايا بنُ يوياداعَ الكاهنِ، <verse eid="1CH 27:5" /><verse number="6" style="v" pubnumber="6" sid="1CH 27:6" />وهوَ رئيسُ الثَّلاثينَ جبَّارًا ومِنْ فِرقَتِهِ عَمِّيزابادُ، اَبنُهُ، <verse eid="1CH 27:6" /><verse number="7" style="v" pubnumber="7" sid="1CH 27:7" />وعلى رأسِ فِرقَةِ الشَّهرِ الرَّابعِ عسائيلُ أخو يوآبَ وخَلَفَهُ عَمِّيزابادُ اَبنُهُ، <verse eid="1CH 27:7" /><verse number="8" style="v" pubnumber="8" sid="1CH 27:8" />وعلى رأسِ فِرقَةِ الشَّهرِ الخامِسِ شَمْحوتُ اليَزراحيُّ، <verse eid="1CH 27:8" /><verse number="9" style="v" pubnumber="9" sid="1CH 27:9" />وعلى رأسِ فِرقَةِ الشَّهرِ السَّادسِ عيرا بنُ عِقِّيشَ التّقوعيِّ، <verse eid="1CH 27:9" /><verse number="10" style="v" pubnumber="10" sid="1CH 27:10" />وعلى رأسِ فِرقَةِ الشَّهرِ السَّابعِ حالِصُ الفُلونيُّ مِنْ بَني أفرايمَ، <verse eid="1CH 27:10" /><verse number="11" style="v" pubnumber="11" sid="1CH 27:11" />وعلى رأسِ فِرقَةِ الشَّهرِ الثَّامنِ سِبْكايُ الحوشيُّ مِنْ بَني زارَحَ، <verse eid="1CH 27:11" /><verse number="12" style="v" pubnumber="12" sid="1CH 27:12" />وعلى رأسِ فِرقَةِ الشَّهرِ التَّاسعِ أبيعَزَرُ العَناثوثيُّ مِنْ بَني بنيامينَ، <verse eid="1CH 27:12" /><verse number="13" style="v" pubnumber="13" sid="1CH 27:13" />وعلى رأسِ فِرقَةِ الشَّهرِ العاشِرِ مَهْراي النَّطوفيُّ مِنْ بَني زَارحَ، <verse eid="1CH 27:13" /><verse number="14" style="v" pubnumber="14" sid="1CH 27:14" />وعلى رأسِ فِرقَةِ الشَّهرِ الحادي عشَرَ بَنايا الفَرْعَتونيُّ مِنْ بَني أفرايمَ، <verse eid="1CH 27:14" /><verse number="15" style="v" pubnumber="15" sid="1CH 27:15" />وعلى رأسِ فِرقَةِ الشَّهرِ الثَّاني عشَرَ حَلْدايُ النَّطوفيُّ مِنْ بَني عُثْنيئيلَ.<verse eid="1CH 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="1CH 27:16" />وكانَ على رأسِ كُلِّ سِبْطٍ مِنْ أسباطِ بَني إسرائيلَ رئيسٌ، فعلى بَني رَأوبينَ: أليعزَرُ بنُ زِكْري، وعلى بَني شِمعونَ: شَفَطْيا بنُ مَعكَةَ، <verse eid="1CH 27:16" /><verse number="17" style="v" pubnumber="17" sid="1CH 27:17" />وعلى بَني لاويّ مِنْ غَيرِ بَني هرونَ: حَشَبْيا بنُ قَموئيلَ، وعلى بَني هرونَ: صادوقُ، <verse eid="1CH 27:17" /><verse number="18" style="v" pubnumber="18" sid="1CH 27:18" />وعلى بَني يَهوذا: أليهو مِنْ إخوَةِ داوُدَ، وعلى بَني يَسَّاكرَ: عَمري بنُ ميخائيلَ، <verse eid="1CH 27:18" /><verse number="19" style="v" pubnumber="19" sid="1CH 27:19" />وعلى بَني زَبولونَ: يَشْمَعيا بنُ عوبَديا، وعلى بَني نَفتالي: يَريموثُ بنُ عَزَرْئيلَ، <verse eid="1CH 27:19" /><verse number="20" style="v" pubnumber="20" sid="1CH 27:20" />وعلى بَني أفرايمَ: هُوشَعُ بنُ عَزُزْيا، وعلى نِصفِ بَني منَسَّى: يوئيلُ بنُ فَدايا، <verse eid="1CH 27:20" /><verse number="21" style="v" pubnumber="21" sid="1CH 27:21" />وعلى نِصفِ بني منَسَّى الآخَرِ في جلعادَ: يَدُّو بنُ زكريّا، وعلى بَني بَنيامينَ: يَعْسِئيلُ بنُ أبنير، <verse eid="1CH 27:21" /><verse number="22" style="v" pubnumber="22" sid="1CH 27:22" />وعلى بَني دانَ: عَزَرْئيلُ بنُ يروحامَ.<verse eid="1CH 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="1CH 27:23" />ولم يُحصِ داوُدُ عدَدَ بَني إِسرائيلَ مِنِ اَبنِ عشرينَ سنَةً، فما دونَ، لأنَّ الرّبَّ قالَ إنَّهُ يُكثِرُ إِسرائيلَ كنجومِ السَّماءِ. <verse eid="1CH 27:23" /><verse number="24" style="v" pubnumber="24" sid="1CH 27:24" />واَبتَدَأ يوآبُ بنُ صَرويَّةَ في الإحصاءِ ولم يُتِمَّهُ، لأنَّ الرّبَّ غَضِبَ على بَني إِسرائيلَ بِسبَبِ هذا الإحصاءِ ولِذلِكَ لم يُدَوَّنِ العَدَدُ في سِفرِ أخبارِ المَلِكِ داوُدَ.<verse eid="1CH 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="1CH 27:25" />وكانَ وكيلًا على خَزائِنِ المَلِكِ عَزْموتُ بنُ عَديئيلَ، وعلى الخَزائِنِ المَحلِّيَّةِ في المُدُنِ والقُرى والحُصونِ يوناثانُ بنُ عُزِّيَّا، <verse eid="1CH 27:25" /><verse number="26" style="v" pubnumber="26" sid="1CH 27:26" />وعلى عُمَّالِ الحُقولِ والفَلَّاحينَ عَزْري بنُ كلوبَ، <verse eid="1CH 27:26" /><verse number="27" style="v" pubnumber="27" sid="1CH 27:27" />وعلى الكُرومِ شِمْعي الرَّامي، وعلى العِنَبِ وخَزائِنِ الخمرِ زَبْدي الشَّعْمي، <verse eid="1CH 27:27" /><verse number="28" style="v" pubnumber="28" sid="1CH 27:28" />وعلى الزَّيتونِ والجُمَّيزِ اللَّذَينِ في السَّهْلِ بَعلُ حانانَ الجديري، وعلى خَزائِنِ الزَّيتِ يوعاشُ، <verse eid="1CH 27:28" /><verse number="29" style="v" pubnumber="29" sid="1CH 27:29" />وعلى البقَرِ في مراعي شارونَ شَطْرايُ الشَّارونيُّ، وعلى البقَرِ الّذي في الأوديةِ شافاطُ بنُ عَدْلاي، <verse eid="1CH 27:29" /><verse number="30" style="v" pubnumber="30" sid="1CH 27:30" />وعلى الجِمالِ أوبيلُ الإسماعيليُّ، وعلى الحميرِ يَحَدْيا الميرنوثيُّ، <verse eid="1CH 27:30" /><verse number="31" style="v" pubnumber="31" sid="1CH 27:31" />وعلى الغنَمِ يازيزُ الهاجريُّ. كُلُّ هؤلاءِ كانوا وُكلاءَ أملاكِ المَلِكِ داوُدَ.<verse eid="1CH 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" pubnumber="32" sid="1CH 27:32" />وتوَلَّى يوناثانُ عَمُّ داوُدَ، وهوَ صاحِبُ حِكمَةٍ ودَهاءٍ ومَعرفةٍ، تَربيةَ بَني المَلِكِ معَ يَحيئيلَ بنِ حَكْموني. <verse eid="1CH 27:32" /><verse number="33" style="v" pubnumber="33" sid="1CH 27:33" />وكانَ أخيتوفَلُ مُستشارًا للمَلِكِ، وحوشايُ الأركيُّ نَديمَهُ. <verse eid="1CH 27:33" /><verse number="34" style="v" pubnumber="34" sid="1CH 27:34" />وبَعدَ وفاةِ أخيتوفَلَ خَلَفَهُ يوياداعُ بنُ بنايا وأبياثارُ. وكانَ يوآبُ قائدَ جيشِ المَلِكِ.<verse eid="1CH 27:34" /></para>
  <chapter eid="1CH 27" />
  <chapter number="28" style="c" sid="1CH 28" />
  <para style="s1">داود وبناء الهيكل</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="1CH 28:1" />وجمَعَ داوُدُ المَلِكُ في أورُشليمَ جميعَ رؤساءِ بَني إِسرائيلَ. فجاءَ رؤساءُ الأسباطِ والفِرَقِ الّذينَ يَخدِمونَ المَلِكَ، وقادةُ الأُلوفِ والمئاتِ في الجيشِ، والوكلاءُ على الأملاكِ والمَواشي الّتي لِلمَلِكِ ولِبَنيهِ، ورِجالُ الحاشيةِ، والجبابِرةُ، وجميعُ المُحاربينَ الأشِدَّاءِ. <verse eid="1CH 28:1" /><verse number="2" style="v" pubnumber="2" sid="1CH 28:2" />فوقَفَ داوُدُ وقالَ لهُم: ”إستَمِعوا لي يا إخوتي وشعبي. كانَ في نيَّتي أنْ أبنيَ هَيكلًا ثابتًا لِتابوتِ عَهدِ الرّبِّ ولِمَوطئِ قُدْسِ إلهِنا. ولمَّا جَهَّزْتُ كُلَّ شيءٍ لِلبِناءِ <verse eid="1CH 28:2" /><verse number="3" style="v" pubnumber="3" sid="1CH 28:3" />قالَ ليَ اللهُ: ”أنتَ لن تَبنيَ هَيكلًا لاَسمي، لأنَّكَ رَجُلُ حروبٍ وسَفكْتَ الكثيرَ مِنَ الدِّماءِ. <verse eid="1CH 28:3" /><verse number="4" style="v" pubnumber="4" sid="1CH 28:4" />لكِنَّ الرّبَّ إلهَ إِسرائيلَ اَختارَني مِنْ جميعِ بَيتِ أبي، لأنْ أكونَ مَلِكًا على إِسرائيلَ إلى الأبدِ، لأنَّهُ اَختارَ سِبْطَ يَهوذا للقيادةِ، ومِنْ سِبْطِ يَهوذا عائِلَتي، ومِنْ عائِلَتي رَضيَ عنِّي فَملَّكني على كُلِّ إِسرائيلَ. <verse eid="1CH 28:4" /><verse number="5" style="v" pubnumber="5" sid="1CH 28:5" />ورزَقَني الرّبُّ بنينَ كثيرينَ واَختارَ مِنهُم سُليمانَ ليَجلِسَ على عَرشِ إِسرائيلَ مَملكَةِ الرّبِّ، <verse eid="1CH 28:5" /><verse number="6" style="v" pubnumber="6" sid="1CH 28:6" />وقالَ لي: سُليمانُ اَبنُكَ هوَ الّذي سَيَبني هَيكلي وأروِقَتَهُ لأنِّي اَختَرْتُهُ ليَ اَبنًا وأنا أكونُ لَه أبًا، <verse eid="1CH 28:6" /><verse number="7" style="v" pubnumber="7" sid="1CH 28:7" />وأُثبِّتُ مُلْكَهُ إلى الأبدِ إنِ اَستَمَرّ على العمَلِ بوصايايَ وأحكامي كما يفعَلُ اليومَ. <verse eid="1CH 28:7" /><verse number="8" style="v" pubnumber="8" sid="1CH 28:8" />والآنَ على عيونِ جميعِ بَني إِسرائيلَ وعُيونِكُم أنتُمُ المُجتَمِعينَ باَسمِ الرّبِّ، وعلى مَسمَعِ إلهِنا، أقولُ لكُمُ: إحفَظوا جميعَ وصايا الرّبِّ إلهِكُم واَعمَلوا بِها لِتَمتَلِكوا هذِهِ الأرضَ الطَّيِّبةَ وتُورِثوها لِبَنيكُم مِنْ بَعدِكُم إلى الأبدِ.<verse eid="1CH 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="1CH 28:9" />”وأنتَ يا سُليمانُ اَبني، فاَعرِفْ إلهَ أبيكَ واَعبُدْهُ بِقلبٍ سليمٍ ونفْسٍ راغبةٍ، لأنَّ الرّبَّ يفحَصُ جميعَ القلوبِ ويتَبَيَّنُ الخواطِرَ والأفكارَ. إذا طلَبْتَهُ وجَدْتَهُ، وإنْ تَركْتَهُ تخَلَّى عَنكَ إلى الأبدِ. <verse eid="1CH 28:9" /><verse number="10" style="v" pubnumber="10" sid="1CH 28:10" />والآنَ اَعرِفْ أنَّ الرّبَّ اَختارَكَ لِتَبنيَ هَيكلًا لاَسمِهِ القُدُّوسِ، فكُنْ شديدَ العَزْمِ وبادِرْ إلى العمَلِ“.<verse eid="1CH 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="1CH 28:11" />ثُمَّ شرَحَ داوُدُ لاَبنِهِ سُليمانَ صورةَ الهَيكلِ بِأروِقَتِهِ وخَزائنِهِ وغُرَفِهِ العاليةِ ومَخادِعِهِ الدَّاخِليَّةِ وبَيتِ التَّكفيرِ عَنِ الخطايا. <verse eid="1CH 28:11" /><verse number="12" style="v" pubnumber="12" sid="1CH 28:12" />كذلِكَ أدواتِ خِدمةِ الهَيكلِ وخَزائِنَ الهَيكلِ المُكَرَّسَةَ للرّبِّ، <verse eid="1CH 28:12" /><verse number="13" style="v" pubnumber="13" sid="1CH 28:13" />ونِظامَ فِرَقِ الكهَنةِ واللَّاويِّينَ وكُلَّ ما يقومونَ بهِ مِنْ عمَلٍ لِخِدمةِ هَيكلِ الرّبِّ والعِنايةِ بأدواتِ هذِهِ الخِدمةِ. <verse eid="1CH 28:13" /><verse number="14" style="v" pubnumber="14" sid="1CH 28:14" />وبَيَّنَ لَه أيضًا وَزْنَ الذَّهبِ أوِ الفِضَّةِ لِكُلِّ إناءِ خِدمةٍ، <verse eid="1CH 28:14" /><verse number="15" style="v" pubnumber="15" sid="1CH 28:15" />ولِكُلِ شَمعَدانٍ وسِراجِهِ، على حسَبِ اَستِعمالِهِ في الخِدمةِ، <verse eid="1CH 28:15" /><verse number="16" style="v" pubnumber="16" sid="1CH 28:16" />ولِكُلِّ مائِدةٍ لِعَرْضِ خُبزِ التَّقدِمةِ، <verse eid="1CH 28:16" /><verse number="17" style="v" pubnumber="17" sid="1CH 28:17" />ولِلمَلاقِطِ والطَّاساتِ والكؤوسِ والأقداحِ، <verse eid="1CH 28:17" /><verse number="18" style="v" pubnumber="18" sid="1CH 28:18" />ولِمَذبَحِ البَخورِ الّذي هوَ مِنَ الذَّهبِ المُصَفَّى، ولِعَجَلَةِ الكروبَينِ الباسِطَينِ أجنِحَتَهُما الّتي تُظَلِّلُ تابوتَ عَهدِ الرّبِّ. <verse eid="1CH 28:18" /><verse number="19" style="v" pubnumber="19" sid="1CH 28:19" />وقالَ داوُدُ: ”هذا كُلُّهُ تلَقَّيتُهُ مكتوبًا بِيَدِ الرّبِّ، حتّى يكونَ كُلُّ شيءٍ واضحًا لي لِلعمَلِ بهِ“.<verse eid="1CH 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="1CH 28:20" />وقالَ داوُدُ لِسُليمانَ ابنِهِ: ”تشَدَّدْ وتشَجَّعْ واَعمَلْ. لا تخَفْ ولا تَرهَبْ لأنَّ الرّبَّ إلهي معَكَ. فهوَ لا يتَخَلَّى عَنكَ ولا يُهمِلُكَ حتّى تُنهيَ كُلَّ هذا العمَلِ لِخِدمةِ الهَيكلِ. <verse eid="1CH 28:20" /><verse number="21" style="v" pubnumber="21" sid="1CH 28:21" />وهذِهِ فِرَقُ الكهَنةِ واللَّاويِّينَ على اَستِعدادٍ لِكُلِّ خِدمةٍ تَخُصُّ هذا الهَيكلَ، ومعَكَ في جميعِ ما تعمَلُ صُنَّاعٌ ماهرونَ في صَنعَتِهِم، فَضلًا عَنْ أنَّ الشَّعبَ ورؤساءَهُ جميعًا تَحتَ أمرِكَ“.<verse eid="1CH 28:21" /></para>
  <chapter eid="1CH 28" />
  <chapter number="29" style="c" sid="1CH 29" />
  <para style="s1">تقدمات لبناء الهيكل</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="1CH 29:1" />وقالَ داوُدُ لِجميعِ الحاضرينَ: ”سُليمانُ ابني هوَ الّذي اَخْتارَهُ اللهُ لِبِناءِ الهَيكلِ، لكنَّهُ صغيرٌ قليلُ الخِبرَةِ، والعمَلُ عظيمٌ لأنَّ البِناءَ هَيكلٌ لِلرّبِّ لا بَيتٌ للبشَرِ. <verse eid="1CH 29:1" /><verse number="2" style="v" pubnumber="2" sid="1CH 29:2" />وأنا قُمتُ بِكُلِّ جَهدي لِتَجهيزِهِ بالذَّهبِ والفِضَّةِ والنُّحاسِ والحديدِ والخشَبِ، وبِمقدارٍ كبيرٍ مِنَ العَقيقِ والرُّخامِ وكُلِّ نَوعٍ مِنَ الحجارةِ الكريمةِ المُلَوَّنةِ. <verse eid="1CH 29:2" /><verse number="3" style="v" pubnumber="3" sid="1CH 29:3" />وعلاوَةً على هذا كُلِّهِ وهَبْتُ ما أملِكُهُ مِنَ الذَّهبِ والفِضَّةِ رَغبةً في بِناءِ هذا الهَيكلِ، <verse eid="1CH 29:3" /><verse number="4" style="v" pubnumber="4" sid="1CH 29:4" />ومِقْدارُهُ أربَعُ مئَةٍ وسِتُّونَ قِنطارًا مِنْ ذَهبِ أوفيرَ الخالِصِ وألفٌ وسِتُّونَ قِنطارَ فِضَّةٍ مُصَفَّاةٍ لِتَصفيحِ الجُدرانِ، <verse eid="1CH 29:4" /><verse number="5" style="v" pubnumber="5" sid="1CH 29:5" />ولِكُلِّ شيءٍ يعمَلُهُ الصُنَّاعُ المهَرَةُ، فمَنْ أرادَ مِنكُم أنْ يتَبَرَّعَ للرّبِّ، فليَفتَحْ يَدَهُ بِسَخاءٍ“.<verse eid="1CH 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="1CH 29:6" />فقامَ رؤساءُ عائِلاتِ أسباطِ إِسرائيلَ، وقادةُ الألوفِ والمئاتِ، وكِبارُ العامِلينَ في خِدمةِ المَلِكِ، <verse eid="1CH 29:6" /><verse number="7" style="v" pubnumber="7" sid="1CH 29:7" />وتَبرَّعوا لِبِناءِ الهَيكلِ بِسَبعِ مئَةٍ وسِتِّينَ قِنطارًا مِنَ الذَّهبِ، وبِعَشَرَةِ آلافِ دِرهَمٍ ومِنَ الفِضَّةِ بألفٍ وخَمسِ مئَةٍ وعشرينَ قِنطارًا، ومِنَ النُّحاسِ بألفينِ وسَبعِ مئَةِ قِنطارٍ، ومِنَ الحديدِ بِخمسةَ عشَرَ ألفَ قِنطارٍ. <verse eid="1CH 29:7" /><verse number="8" style="v" pubnumber="8" sid="1CH 29:8" />وكُلُّ مَنْ كانَ عِندَهُ حجارةٌ كريمةٌ أعطاها لِخَزينةِ هَيكلِ الرّبِّ على يَدِ يَحيئيلَ الجَرشونيِّ. <verse eid="1CH 29:8" /><verse number="9" style="v" pubnumber="9" sid="1CH 29:9" />ففَرِحَ الشَّعبُ لِتَبَرُّعِهِم للرّبِّ لأنَّهُم فعَلوا ذلِكَ بِقَلبٍ سليمٍ، وفَرِحَ داوُدُ المَلِكُ أيضًا فرَحًا عظيمًا.<verse eid="1CH 29:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="1CH 29:10" />وحمَدَ داوُدُ الرّبَّ أمام جميعِ الحاضرينَ وقالَ: ”مُبارَكٌ أنتَ أيُّها الرّبُّ إلهُ إِسرائيلَ أبينا مِنَ الأزلِ وإلى الأبدِ. <verse eid="1CH 29:10" /><verse number="11" style="v" pubnumber="11" sid="1CH 29:11" />لكَ يا رَبُّ العظَمَةُ والجَبَروتُ والجَلالُ والبَهاءُ والمَجدُ، لأنَّ لكَ كُلَّ ما في السَّماءِ والأرضِ، ولكَ المُلكُ أيُّها الرّبُّ والسِّيادةُ على الجميعِ. <verse eid="1CH 29:11" /><verse number="12" style="v" pubnumber="12" sid="1CH 29:12" />مِنكَ الغِنى والكرامةُ وأنتَ تَملِكُ على كُلِّ شيءٍ. في يَدِكَ القُدرَةُ والجَبَروتُ والعظَمَةُ، وأنتَ تُقوِّي كُلَّ إنسانٍ وتُعَظِّمُهُ. <verse eid="1CH 29:12" /><verse number="13" style="v" pubnumber="13" sid="1CH 29:13" />فالآنَ يا إلهَنا نَحمَدُكَ ولاَسمِكَ المَجيدِ نُهَلِّلُ.<verse eid="1CH 29:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="1CH 29:14" />ولكِنْ مَنْ أنا ومَنْ شعبي حتّى نَقدِرَ أنْ نَتَبَرَّعَ لكَ بِأيِّ شيءٍ؟ نحنُ لا شيءَ. فكُلُّ شيءٍ مِنكَ، ومِمَّا أعطَيتَنا أعطيناكَ. <verse eid="1CH 29:14" /><verse number="15" style="v" pubnumber="15" sid="1CH 29:15" />وما نَحنُ في هذِهِ الدُّنيا إلَّا غُرَباءُ ونُزَلاءُ كما كانَ جميعُ آبائِنا، وأيّامُنا كالظِّلِّ على الأرضِ ولا رَجاءَ لنا في البَقاءِ. <verse eid="1CH 29:15" /><verse number="16" style="v" pubnumber="16" sid="1CH 29:16" />كُلُّ هذِهِ الثَّروَةِ الّتي أعدَدْناها أيُّها الرّبُّ إلهُنا، لِنَبنيَ هَيكلًا لاَسمِكَ القُدُّوسِ مِنْ يَدِكَ أخَذْناها وهيَ كُلُّها لكَ. <verse eid="1CH 29:16" /><verse number="17" style="v" pubnumber="17" sid="1CH 29:17" />وأنا أعلَمُ يا إلهي أنَّكَ تَمتَحِنُ القلوبَ وتفرَحُ بالاستِقامةِ. أمَّا أنا فباَستِقامةِ قلبي تَبَرَّعْتُ لكَ بِكُلِّ هذا، وكم فَرِحْتُ حينَ رأيتُ شعبَكَ الحاضرينَ هُنا يتَبَرَّعونَ لكَ. <verse eid="1CH 29:17" /><verse number="18" style="v" pubnumber="18" sid="1CH 29:18" />أيُّها الرّبُّ إلهُ إبراهيمَ وإسحَقَ ويَعقوبَ آبائِنا، إحفَظْ إلى الأبدِ مِثلَ هذِهِ النيَّاتِ والمَقاصِدِ في قُلوبِ شعبِكَ، ووَجِّهْ قُلوبَهُم إليكَ. <verse eid="1CH 29:18" /><verse number="19" style="v" pubnumber="19" sid="1CH 29:19" />واَمنَحْ سُليمانَ ابني قلبًا سليمًا ليَعمَلَ بِوصاياكَ وإرشاداتِكَ وفَرائِضِكَ ولِيَبنيَ الهَيكلَ الّذي جَهَّزْتُ لَه كُلَّ شيءٍ“.<verse eid="1CH 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="1CH 29:20" />وقالَ داوُدُ لِجميعِ الحاضرينَ: ”بارِكوا الرّبَّ إلهَكُم“. فباركوا الرّبَّ إلهَ آبائِهِم وركَعوا وسجَدوا لَه ولِلمَلِكِ. <verse eid="1CH 29:20" /><verse number="21" style="v" pubnumber="21" sid="1CH 29:21" />وذبَحوا للرّبِّ ذَبائِحَ، وقَدَّموا في غَدِ ذلِكَ اليومِ مُحرَقاتٍ للرّبِّ ألفَ ثورٍ وألفَ كَبْشٍ وألفَ خروفٍ معَ الخمرِ العائِدَةِ لها، عَلاوَةً على ذبائِحَ أُخرى مِنْ أجلِ الحاضرينَ مِنْ بَني إِسرائيلَ. <verse eid="1CH 29:21" /><verse number="22" style="v" pubnumber="22" sid="1CH 29:22" />فأكَلُوا وشَرِبُوا أمامَ الرّبِّ في ذلِكَ اليومِ بِفَرَحٍ عظيمٍ، وأقاموا سُليمانَ بنَ داوُدَ مَلِكًا مرَّةً ثانيةً، وأمامَ الرّبِّ قائدًا وكرَّسوا صادوقَ كاهنًا. <verse eid="1CH 29:22" /><verse number="23" style="v" pubnumber="23" sid="1CH 29:23" />فخَلَفَ سُليمانُ داوُدَ على العرشِ الّذي أقامَهُ الرّبُّ، وكانَ مَلِكًا ناجحًا أطاعَهُ جميعُ بَني إِسرائيلَ. <verse eid="1CH 29:23" /><verse number="24" style="v" pubnumber="24" sid="1CH 29:24" />وخضَعَ الرُّؤساءُ والقادةُ وكذلِكَ كُلُّ بَني المَلِكِ داوُدَ لِسُليمانَ المَلِكِ. <verse eid="1CH 29:24" /><verse number="25" style="v" pubnumber="25" sid="1CH 29:25" />ورفَعَ الرّبُّ مكانَةَ سُليمانَ في عيونِ جميعِ بَني إِسرائيلَ، ومنَحَهُ مِنَ الجَلالِ ما لم يكُنْ لِمَلِكٍ قَبلَهُ في إِسرائيلَ.<verse eid="1CH 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="1CH 29:26" />وهكذا ملَكَ داوُدُ بنُ يَسَّى على جميعِ بَني إِسرائيلَ <verse eid="1CH 29:26" /><verse number="27" style="v" pubnumber="27" sid="1CH 29:27" />مُدَّةَ أربعينَ سنَةً، سَبْعٌ مِنها في حبرونَ، وثَلاثٌ وثَلاثونَ في أورُشليمَ. <verse eid="1CH 29:27" /><verse number="28" style="v" pubnumber="28" sid="1CH 29:28" />ثُمَّ ماتَ بِشَيخوخةٍ صالِحةٍ بَعدَ أنْ شَبِعَ مِنَ الأيّامِ والغِنى والمَجدِ، وملَكَ سُليمانُ اَبنُهُ مكانَهُ. <verse eid="1CH 29:28" /><verse number="29" style="v" pubnumber="29" sid="1CH 29:29" />وأعمالُ داوُدَ المَلِكِ، مِنْ أوّلِها إلى آخِرِها، مُدَوَّنَةٌ في سِفرِ أخبارِ صموئيلَ الرَّائيّ وناثانَ النَّبيِّ وجادَ الرَّائيّ، <verse eid="1CH 29:29" /><verse number="30" style="v" pubnumber="30" sid="1CH 29:30" />معَ كُلِّ ما كانَ مِنْ مُلْكِهِ وجبَروتِهِ والأحوالِ الّتي مَرَّت علَيهِ، وعلى إِسرائيلَ وعلى جميعِ مَمالِكِ الأرضِ.<verse eid="1CH 29:30" /></para>
  <chapter eid="1CH 29" />
</usx>