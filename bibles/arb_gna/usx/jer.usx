  <para style="toc3">إر</para>
  <para style="toc1">إرميا</para>
  <para style="toc2">إرميا</para>
  <para style="mt1">إرميا</para>
  <chapter number="1" style="c" sid="JER 1" />
  <para style="s1">مقدمة</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 1:1" />هذا الكتابُ يحتوي كلامَ إرميا بنِ حَلْقيَّا، أحدِ كَهنَةِ مدينةِ عناتوتَ في أرضِ بنيامينَ. <verse eid="JER 1:1" /><verse number="2" style="v" pubnumber="2" sid="JER 1:2" />كَلَّمَهُ الرّبُّ في أيّامِ يوشيَّا بنِ آمونَ، مَلِكِ يَهوذا، في السَّنةِ الثَّالثةَ عشْرةَ مِنْ مُلْكِهِ. <verse eid="JER 1:2" /><verse number="3" style="v" pubnumber="3" sid="JER 1:3" />ثُمَّ كَلَّمَهُ الرّبُّ في أيّامِ يوياقيمَ بنِ يوشيَّا، مَلِك يَهوذا، وبَقيَ يُكلِّمُهُ إلى الشَّهرِ الخامِسِ مِنَ السَّنةِ الحاديةَ عشْرةَ مِنْ مُلْكِ صدقيَّا بنِ يوشيَّا مَلِكِ يَهوذا، حينَ ذهَبَ أهلُ أورُشليمَ إلى السَّبْي.<verse eid="JER 1:3" /></para>
  <para style="s1">الرب يدعو إرميا</para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="JER 1:4" />قالَ الرّبُّ لي: <verse eid="JER 1:4" /><verse number="5" style="v" pubnumber="5" sid="JER 1:5" />”قَبلَ أنْ أُصوِّرَكَ في البَطْنِ اختَرتُكَ، وقَبلَ أنْ تَخرُجَ مِنَ الرَّحِمِ كَرَّستُكَ وجعَلتُكَ نبيًّا للأُمَمِ“.<verse eid="JER 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="JER 1:6" />فقُلتُ: ”آهِ، أيُّها السَّيِّدُ الرّبُّ! أنا لا أعرِفُ أنْ أتكَلَّمَ لأنِّي صغيرٌ“.<verse eid="JER 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="JER 1:7" />فقالَ ليَ الرّبُّ: ”لا تَقُلْ: إنِّي صغيرٌ. أينَما أُرسِلكَ تذهب، وكُلُّ ما آمُرُكَ بهِ تقولُهُ، <verse eid="JER 1:7" /><verse number="8" style="v" pubnumber="8" sid="JER 1:8" />لا تَخَفْ مِنْ مواجهَةِ أحدٍ، فأنا معَكَ لأُنقِذَكَ“. <verse eid="JER 1:8" /><verse number="9" style="v" pubnumber="9" sid="JER 1:9" />ثُمَّ مَدَّ يَدَهُ ولمسَ فَمي وقالَ: ”ها أنا جعَلْتُ كلامي في فَمِكَ <verse eid="JER 1:9" /><verse number="10" style="v" pubnumber="10" sid="JER 1:10" />وأعطَيتُكَ اليومَ سُلطةً على الأمَمِ وعلى المَمالِكِ لِتَقلَعَ وتَهدِمَ وتُهلِكَ، ولِتَنقُضَ وتَبنيَ وتَغرُسَ“.<verse eid="JER 1:10" /></para>
  <para style="s1">الرؤى الأولى</para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JER 1:11" />وقالَ ليَ الرّبُّ: ”ماذا ترى يا إرميا؟“ فقُلتُ: ”أرى غُصنَ لَوزٍ“. <verse eid="JER 1:11" /><verse number="12" style="v" pubnumber="12" sid="JER 1:12" />فقالَ: ”أَحسنتَ فيما رَأيتَ. فأنا ساهرٌ على فِعْلِ ما أقولُ“.<verse eid="JER 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="JER 1:13" />وقالَ ليَ الرّبُّ ثانيةً: ”ماذا ترى الآنَ؟“ فقُلتُ: ”أرى وِعاءً يَغلي على موقدٍ يَتَّجِهُ إلى الشِّمالِ“. <verse eid="JER 1:13" /><verse number="14" style="v" pubnumber="14" sid="JER 1:14" />فقالَ: ”مِنَ الشِّمالِ يَهُبُّ الشَّرُّ على جميعِ سُكَّانِ هذِهِ الأرضِ. <verse eid="JER 1:14" /><verse number="15" style="v" pubnumber="15" sid="JER 1:15" />سأدعو جميعَ ممالِكِ الشِّمالِ، فيأتونَ وَينصُبُ كُلُّ مَلِكٍ مِنْ مُلوكِها عَرشَهُ عِندَ مَدخَلِ أبوابِ أُورُشليمَ ومُدُنِ يَهوذا. <verse eid="JER 1:15" /><verse number="16" style="v" pubnumber="16" sid="JER 1:16" />وأتْلو حُكمي على شعبي جزاءَ جميعِ الشُّرورِ الّتي فعَلوها، لأنَّهُم ترَكوني وأحرَقوا البَخورَ على مذبَحِ آلهَةٍ أخرى وسجَدوا لِما صَنَعَتْهُ أيديهِم. <verse eid="JER 1:16" /><verse number="17" style="v" pubnumber="17" sid="JER 1:17" />وأمَّا أنتَ فتَأهَّبْ وقُمْ وكَلِّمْهُم بِكُلِّ ما آمُرُكَ بهِ. لا تفزَعْ مِنْ مُواجَهتِهِم لِئلَّا أُفزِعَكَ أمامَهُم. <verse eid="JER 1:17" /><verse number="18" style="v" pubnumber="18" sid="JER 1:18" />جعَلْتُكَ اليومَ يا إرميا مدينةً حصينةً، وعمودًا مِنْ حديدٍ، وسورًا مِنْ نُحاسٍ، في وجهِ جميعِ الّذينَ في أرضِ يَهوذا مِنْ مُلوكٍ ورؤساءَ وكَهنَةٍ وشعبٍ. <verse eid="JER 1:18" /><verse number="19" style="v" pubnumber="19" sid="JER 1:19" />فيُحارِبونَكَ ولا يَقوَونَ علَيكَ لأنِّي معَكَ لأُنقِذَكَ“. هكذا يقولُ الرّبُّ.<verse eid="JER 1:19" /></para>
  <chapter eid="JER 1" />
  <chapter number="2" style="c" sid="JER 2" />
  <para style="s1">الرب يعنى بإسرائيل</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 2:1" />وقالَ ليَ الرّبُّ: <verse eid="JER 2:1" /><verse number="2" style="v" pubnumber="2" sid="JER 2:2" />”إذهَبْ ونادِ في أُورُشليمَ: هذا ما يقولُ الرّبُّ:</para>
  <para style="p" vid="JER 2:2">”أذكُرُ مَوَدَّتَكِ في صِباكِ،</para>
  <para style="p" vid="JER 2:2">وحبَّكِ يومَ خِطْبَتِكِ</para>
  <para style="p" vid="JER 2:2">سِرتِ ورائي في البَرِّيَّةِ،</para>
  <para style="p" vid="JER 2:2">في أرضٍ لا زَرعَ فيها.<verse eid="JER 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="JER 2:3" />إسرائيلُ مُكَرَّسَةٌ لِلرّبِّ،</para>
  <para style="p" vid="JER 2:3">باكُورةُ غَلَّتِهِ في الشُّعوبِ</para>
  <para style="p" vid="JER 2:3">مَنْ أكَلَها يَخطَأُ</para>
  <para style="p" vid="JER 2:3">ويَحِلُّ بهِ الشَّرُّ“.</para>
  <para style="p" vid="JER 2:3">هكذا يقولُ الرّبُّ.<verse eid="JER 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="JER 2:4" />إسمعوا كَلامَ الرّبِّ يا بَيتَ يَعقوبَ، ويا جميعَ عشائِرِ إِسرائيلَ <verse eid="JER 2:4" /><verse number="5" style="v" pubnumber="5" sid="JER 2:5" />”أيُّ سُوءٍ وجَدَ آباؤُكُم فيَّ حتّى اَبتَعَدوا عَنِّي وتَبِعوا آلهةً باطِلةً وصاروا باطِلًا؟ <verse eid="JER 2:5" /><verse number="6" style="v" pubnumber="6" sid="JER 2:6" />نَسَوا أنْ يقولوا: أينَ الرّبُّ الّذي أخرَجَنا مِنْ أرضِ مِصْرَ وسارَ بنا في البرِّيَّةِ، في قِفارٍ وحُفَرٍ، وفي أرضِ قَحطٍ وظِلالِ موتٍ في أرضٍ ما عبَرَها إنسانٌ ولا سكَنَها بشَرٌ؟ <verse eid="JER 2:6" /><verse number="7" style="v" pubnumber="7" sid="JER 2:7" />فأدخَلْتُكُم أرضًا طَيِّبةً لِتأكُلوا ثمَرَها وخيراتِها ولكِنَّكُم دخَلْتُم ونَجَّسْتُم أرضي وجعَلْتُم ما أورَثتُكُم إيَّاهُ رِجْسًا. <verse eid="JER 2:7" /><verse number="8" style="v" pubnumber="8" sid="JER 2:8" />فلا الكَهنَةُ قالوا: أين الرّبُّ، ولا مُعَلِّمو الشَّريعةِ عرَفوني، والحُكَّامُ أنفُسُهُم عصَوني، والأنبياءُ تنَبَّأُوا بِاَسم البَعلِ وذهَبوا وراءَ إلَهٍ لا نَفعَ فيهِ. <verse eid="JER 2:8" /><verse number="9" style="v" pubnumber="9" sid="JER 2:9" />فلِذلِكَ أُخاصِمُكُم يا شعبي، وأُخاصِمُ بَنيكُم. <verse eid="JER 2:9" /><verse number="10" style="v" pubnumber="10" sid="JER 2:10" />أُعبُروا إلى شواطئِ كِتِّيمَ واَنظُروا، أو أَرسِلوا شَرقًا إلى قيدارَ واَفحَصوا جيِّدًا ترَوا هل جرى هُناكَ ما جرى عِندَكُم؟ <verse eid="JER 2:10" /><verse number="11" style="v" pubnumber="11" sid="JER 2:11" />هلِ اَستَبدَلَت أُمَّةٌ آلِهَتَها، معَ أنَّها آلِهَةٌ مَزعومةٌ؟ أمَّا شعبي، فاَستَبدَلَ إلهَهُ وهوَ عُنوانُ مَجدِهِ بآلِهَةٍ، لا نَفعَ فيها. <verse eid="JER 2:11" /><verse number="12" style="v" pubnumber="12" sid="JER 2:12" />فاَنذَهلي أيَّتُها السَّماواتُ وارتَعِدي، وأعجَبي مِنْ ذلِكَ كُلَّ العجَبِ!<verse eid="JER 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="JER 2:13" />شعبي يرتَكبُ شَرَّينِ: ”ترَكوني أنا ينبوعُ المياهِ الحيَّةِ وحفروا لهُم آبارًا مُشَقَّقةً لا تُمسِكُ الماءَ“.<verse eid="JER 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="JER 2:14" />أعَبدٌ مُشْترًى إسرائيلُ أوِ ابنُ عَبدٍ مُقتَنًى؟ ما بالُهُ صارَ نَهْبًا لِلأعداءِ؟ <verse eid="JER 2:14" /><verse number="15" style="v" pubnumber="15" sid="JER 2:15" />تُزَمجِرُ كالأشبالِ علَيهِ ويُرسلونَ أصواتَهُم مِنْ بعيدٍ. جعَلوا أرضَهُ خرابًا، وأحرقوا مُدُنَهُ، فلا ساكِنَ فيها. <verse eid="JER 2:15" /><verse number="16" style="v" pubnumber="16" sid="JER 2:16" />بَنو مَمفيسَ وتَحْفَنيسَ حطَّموا جُمجُمَتَهُ. <verse eid="JER 2:16" /><verse number="17" style="v" pubnumber="17" sid="JER 2:17" />فيا أرضَ إِسرائيلَ، أمَا جلَبتِ هذا المَصيرَ علَيكِ حينَ ترَكتِ الرّبَّ إلهَكِ وكانَ يَهديكِ الطَّريقَ السَّويَّ؟ <verse eid="JER 2:17" /><verse number="18" style="v" pubnumber="18" sid="JER 2:18" />فما لَكِ الآنَ تَأخذينَ طريقَ مِصْرَ لِتَشربي مِنْ مياهِ النِّيلِ، وما لكِ تأخُذينَ طريقَ أَشُّورَ لِتَشربي مِنْ نهرِ الفُراتِ؟ <verse eid="JER 2:18" /><verse number="19" style="v" pubnumber="19" sid="JER 2:19" />شَرُّكِ يُعاقِبُكِ وعِصيانُكِ يُؤدِّبُكِ، تَعلَمينَ وتنظُرينَ كم هوَ شَرٌّ ومُرٌّ أنْ تترُكي الرّبَّ إلهَكِ وأنْ لا تكونَ مخافَتي فيكِ، يقولُ السَّيِّدُ الرّبُّ القديرُ.<verse eid="JER 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="JER 2:20" />”مِنَ القديمِ كسَرْتُ نِيرَكِ وقطَعْتُ رُبُطَكِ وقُلتِ: لا أعبُدُ الرّبَّ. وعلى كُلِّ تَلَّةٍ عاليةٍ وتَحتَ كُلِّ شجرَةٍ خضراءَ اَضطَجَعتِ زانيةً في مَعبَدِ البَعلِ. <verse eid="JER 2:20" /><verse number="21" style="v" pubnumber="21" sid="JER 2:21" />أنا غرَسْتُكِ أجودَ كَرمَةٍ، وزرَعْتُكِ كُلَّكِ أفضَلَ زَرْعٍ، فكَيفَ تحَوَّلْتِ إلى كَرمَةٍ تنَكَّرت لي <verse eid="JER 2:21" /><verse number="22" style="v" pubnumber="22" sid="JER 2:22" />فأنتِ وإنِ اغتَسَلْتِ بالنَّطرونِ، وأَكثَرْتِ مِنَ الأُشنانِ لا تَزالينَ مُلَطَّخَةً بالإثْمِ أمامي، يقولُ السَّيِّدُ الرّبُّ.<verse eid="JER 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="JER 2:23" />”كيفَ تقولينَ: ما تَنَجَّسْتُ ولا اتَّبَعْتُ البَعلَ؟ أُنظُري سُلوكَكِ في الوادي واَعرِفي سُوءَ ما تفعلينَ، يا ناقةً خفيفةً تتَمايَلُ في سَيرِها، <verse eid="JER 2:23" /><verse number="24" style="v" pubnumber="24" sid="JER 2:24" />يا أتانًا وَحشيَّةً اعتادَتِ القِفارَ! مِنْ شِدَّةِ شهوَتِها تَستَنْشِقُ الرِّيحَ، فمَنْ يكبَحُ نَزوَتَها؟ كُلُّ مَنْ يَطلُبُها لا يتعَبُ، يَجِدُها حتّى في شهرِها. <verse eid="JER 2:24" /><verse number="25" style="v" pubnumber="25" sid="JER 2:25" />إحفَظي رِجلَكِ مِنَ الخَفاءِ وحَلقَكِ مِنَ العطَشِ! لا تقولي: عبَثًا، لا أقدِرُ لأنِّي أحببتُ الآلِهَةَ الغريبةَ ووَراءَها تعَوَّدتُ أنْ أذهَبَ.<verse eid="JER 2:25" /></para>
  <para style="s1">إسرائيل يستحق العقاب</para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="JER 2:26" />”كعارِ السَّارِقِ حينَ يُمسَكُ، كذلِكَ عارُ بَيتِ إِسرائيلَ، هُم ومُلوكُهُم ورُؤساؤُهُم وكَهنَتُهُم وأنبياؤُهُم. <verse eid="JER 2:26" /><verse number="27" style="v" pubnumber="27" sid="JER 2:27" />هُم يقولونَ لِلخشَبِ أنتَ أبي ولِلحجَرِ أنتَ ولَدْتَني، وهُم يُديرونَ لي ظُهورَهُم، وفي وقت الضِّيقِ يقولونَ قُمْ خَلِّصْنا. <verse eid="JER 2:27" /><verse number="28" style="v" pubnumber="28" sid="JER 2:28" />فأينَ الآلِهَةُ الّتي صَنَعتُمُوها لَكُم يا بَني يَهوذا، وهُمْ على عدَدِ مُدُنِكم، فليقوموا لإنقاذِكُم في الزَّمنِ الرَّديءِ، <verse eid="JER 2:28" /><verse number="29" style="v" pubnumber="29" sid="JER 2:29" />لِماذا تُخاصِمونَني؟ كُلُّكُم عصَيتُموني، يقولُ الرّبُّ. <verse eid="JER 2:29" /><verse number="30" style="v" pubnumber="30" sid="JER 2:30" />عبَثًا ضرَبْتُ بَنيكُم، فهُم لا يَقبَلونَ التَّأديبَ. أكَلَ سَيفُكُم أنبياءَكُم كالأسَدِ المُفتَرِسِ. <verse eid="JER 2:30" /><verse number="31" style="v" pubnumber="31" sid="JER 2:31" />أيُّها الجِيلُ اَسمَعوا كَلِمَتي: هل كُنتُ قَفْرًا لإسرائيلَ أو أرضَ ظَلامٍ دامسٍ؟ فما بالُ شعبي يقولونَ: تحَرَّرْنا فلا نعودُ إليكَ؟ <verse eid="JER 2:31" /><verse number="32" style="v" pubnumber="32" sid="JER 2:32" />أتَنسى الصَّبيَّةُ حِليَتَها والعروسُ جِهازَها؟ أمَّا شعبي فنَسيني أيّامًا لا تُحصَى.<verse eid="JER 2:32" /></para>
  <para style="p">
    <verse number="33" style="v" pubnumber="33" sid="JER 2:33" />”كم تُحسِنينَ فُنونَ الحُبِّ، فتُعَلِّمينَ الفاجِراتِ، <verse eid="JER 2:33" /><verse number="34" style="v" pubnumber="34" sid="JER 2:34" />وعلى أذيالِكِ دَمُ المَساكينِ والأبرياءِ، لا دَمُ الّذينَ تَجِدينَهُم ويَنقُبونَ ويسرقونَ ومعَ كُلِّ هذا الّذي تَفعَلينَهُ، <verse eid="JER 2:34" /><verse number="35" style="v" pubnumber="35" sid="JER 2:35" />تقولينَ: أنا بَريئةٌ وغضَبُ الرّبِّ يَرتَدُّ عنِّي“. لكِنِّي أنا الرّبُّ سَأُحاكِمُكِ على قولِكِ لم أَخطأْ. <verse eid="JER 2:35" /><verse number="36" style="v" pubnumber="36" sid="JER 2:36" />يا لِخِفَّتِكِ في تَبديلِ سياسَتِكِ! مِنْ مِصْرَ سيلحَقُكِ الخِزْيُ كما لَحِقَكِ الخِزْيُ مِنْ أشُّورَ. <verse eid="JER 2:36" /><verse number="37" style="v" pubnumber="37" sid="JER 2:37" />فَمِنْ مِصْرَ تخرُجينَ مُستَسلِمَةً ويَداكِ مَرفوعَتانِ على رأسِكِ لأنَّ الرّبَّ رفَضَ مَنْ تَتَّكِلينَ علَيهِم، فهُم لا خيرَ فيهِم“.<verse eid="JER 2:37" /></para>
  <chapter eid="JER 2" />
  <chapter number="3" style="c" sid="JER 3" />
  <para style="s1">إسرائيل الخائن</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 3:1" />وخاطَبَني الرّبُّ: ”إذا سَرَّحَ الرَّجلُ اَمرأتَهُ فذَهَبَت مِنْ عِندِهِ وتَزَوَّجَت رَجُلًا آخَرَ فهل يَرجِعُ إليها مِنْ بَعدُ؟ ألا تتَدَنَّسُ تَدَنُّسًا؟ وكذلِكَ تِلكَ الأرضُ. فأنتِ يا أرضَ إِسرائيلَ زنَيتِ معَ عُشَّاقٍ كثيرينَ، ومعَ ذلِكَ يقولُ لكِ الرّبُّ إِرجِعي إليَّ. <verse eid="JER 3:1" /><verse number="2" style="v" pubnumber="2" sid="JER 3:2" />إِرفَعي عينَيكِ إلى الرَّوابي واَنظُري! هل مِنْ مكانٍ إلَّا وضاجَعْتِ فيهِ؟ قعَدْتِ لهُم في جوانِبِ الطُّرقاتِ كالأعرابي في الصَّحراءِ ودَنَّسْتِ الأرضَ بِزناكِ وفُجورِكِ. <verse eid="JER 3:2" /><verse number="3" style="v" pubnumber="3" sid="JER 3:3" />فاَمتَنَعَ المَطَرُ حتّى في أوَّلِ الرَّبيعِ ومعَ ذلِكَ بَقيَت جَبهَتُكِ جَبهَةَ اَمرأةٍ زانيةٍ ورَفَضْتِ أنْ تَستَحي.<verse eid="JER 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="JER 3:4" />”ثُمَّ صَرَخْتِ إليَّ: يا أبي، أنتَ رفيقُ صِبايَ!: <verse eid="JER 3:4" /><verse number="5" style="v" pubnumber="5" sid="JER 3:5" />هل تَحتَفِظُ بِغضَبِكَ على الدَّوامِ؟ هكذا قُلتِ، ولكِنَّكِ أخذتِ تَفعَلينَ الشَّرَّ بِعنادٍ شديدٍ“.<verse eid="JER 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="JER 3:6" />وقالَ ليَ الرّبُّ في أيّامِ يوشيَّا المَلِكِ:</para>
  <para style="p" vid="JER 3:6">”هل رأيتَ ما فعَلَتِ السَّائبةُ إِسرائيلُ؟ كيفَ اَنطَلَقَت إلى كُلِّ جبَلٍ عالٍ، وإلى تَحتِ كُلِّ شجَرةٍ خضراءَ وزَنَت هُناكَ؟ <verse eid="JER 3:6" /><verse number="7" style="v" pubnumber="7" sid="JER 3:7" />وبَعدَ أنْ صَنَعَتْ هذا كُلَّهُ قُلتُ لها: إِرجعي إليَّ فما رجَعَت. ورَأت هذا أُختُها الخائِنَةُ يَهوذا. <verse eid="JER 3:7" /><verse number="8" style="v" pubnumber="8" sid="JER 3:8" />إنِّي بِسبَبِ زِنى السَّائِبةِ إِسرائيلَ سَرَّحْتُها وأعطَيتُها كتابَ الطَّلاقِ، فما خافَتِ الخائِنةُ يَهوذا، بل ذَهَبَت وزَنَت هيَ أيضًا. <verse eid="JER 3:8" /><verse number="9" style="v" pubnumber="9" sid="JER 3:9" />واَستَسهَلَتِ الزِّنى، فنَجَّسَتِ الأرض وزَنَت فعبَدَتِ الحجَرَ والخشَبَ. <verse eid="JER 3:9" /><verse number="10" style="v" pubnumber="10" sid="JER 3:10" />وإذا كانَت رَجَعَت إليَّ، فَنِفاقًا لا بِكُلِّ قلبِها“. هكذا يقولُ الرّبُّ.<verse eid="JER 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JER 3:11" />وقالَ ليَ الرّبُّ: ”السَّائِبةُ إِسرائيلُ بَرَّرَت نفسَها أكثَر مِنَ الخائِنةِ يَهوذا. <verse eid="JER 3:11" /><verse number="12" style="v" pubnumber="12" sid="JER 3:12" />إِذهَبْ ونادِ بِهذِهِ الكَلِماتِ في أرضِ الشِّمالِ وقُلْ: إرجِعي أيَّتُها السَّائِبةُ إِسرائيلُ يقولُ الرّبُّ. فلا يَعبِسُ وجهي غضَبًا علَيكِ لأنِّي رحيمٌ ولا أحقِد إلى الأبدِ. <verse eid="JER 3:12" /><verse number="13" style="v" pubnumber="13" sid="JER 3:13" />إعتَرِفي أنَّكِ أذنَبتِ حينَ عصَيتِ الرّبَّ إلهَكِ وتَفَنَّنْتِ في حُبِّكِ لآلِهَةٍ غريبةٍ تَحتَ كُلِّ شجَرَةٍ خضراءَ دُونَ أنْ تسمَعي لِصَوتي“.<verse eid="JER 3:13" /></para>
  <para style="s1">رجوع يهوذا</para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="JER 3:14" />وقالَ الرّبُّ: ”إِرجِعوا أيُّها البَنونَ الشَّارِدونَ، فأنا سيِّدُكُم. آخُذُكُم واحدًا مِن مدينةٍ واَثنَينِ مِن عَشيرةٍ وأجيءُ بِكُم إلى صِهيَونَ. <verse eid="JER 3:14" /><verse number="15" style="v" pubnumber="15" sid="JER 3:15" />وأُعطيكُم حُكّامًا على مُشتَهى قلبي، فيَحكُمونَكُم بِمَعرِفةٍ وفَهْمٍ. <verse eid="JER 3:15" /><verse number="16" style="v" pubnumber="16" sid="JER 3:16" />وحينَ تَكثُرونَ وتُثمِرونَ في الأرضِ لا يتَحَدَّثونَ بَعدُ عَن تابوتِ عَهدِ الرّبِّ ولا يَخطُرُ لهُم بِبالٍ ولا يَذكُرونَهُ ولا يَفتَقِدونَهُ ولا صَنَعَهُ أحدٌ ثانيةً. <verse eid="JER 3:16" /><verse number="17" style="v" pubnumber="17" sid="JER 3:17" />لأنَّ أورُشليمَ في تِلكَ الأيّامِ تُدعى عرشَ الرّبِّ، وتجتَمِعُ إليها كُلُّ الأُمَمِ باَسمِ الرّبِّ ولا يَنساقونَ مِنْ بَعدُ وراءَ نِيَّاتِ قُلوبِهِمِ الشِّرِّيرةِ.<verse eid="JER 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="JER 3:18" />وفي تِلكَ الأيّامِ ينضَمُّ بَيتُ يَهوذا إلى بَيتِ إِسرائيلَ ويَجيئُونَ معًا مِنْ أرضِ الشِّمالِ إلى الأرضِ الّتي اَمتَلَكَها آباؤُهُم.<verse eid="JER 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="JER 3:19" />ولكِنِّي أقولُ لكِ أحسبُكِ مِنَ البَنينَ وأُعطيكِ تِلكَ الأرضَ الطَّيِّبةَ مُلكًا ولا أجمَلَ بَينَ الأمَمِ وظَنَنتِ أنَّكِ تَدعينَني يا أبي ولا تَرتدِّينَ مِنَ السَّيرِ ورائي. <verse eid="JER 3:19" /><verse number="20" style="v" pubnumber="20" sid="JER 3:20" />لكِنْ كما تغدُرُ المرأةُ الخائِنةُ بِزَوجِها، كذلِكَ غَدَرْتُم بي يا بَيتَ إِسرائيلَ“.<verse eid="JER 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="JER 3:21" />صوتٌ سُمِعَ في الرَّوابي،</para>
  <para style="p" vid="JER 3:21">بكاءُ تَضَرُّعٍ مِنْ بَني إِسرائيلَ</para>
  <para style="p" vid="JER 3:21">لأنَّهُم حادوا عَنْ طريقِهِم.</para>
  <para style="p" vid="JER 3:21">ونسَوا الرّبَّ إلَهَهُم.<verse eid="JER 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="JER 3:22" />فاَرجِعوا أيُّها البَنونَ الشَّاردونَ،</para>
  <para style="p" vid="JER 3:22">فيَغفِرَ الرّبُّ لكُم شُرورَكُم.</para>
  <para style="p" vid="JER 3:22">ها نحنُ نأتي إليكَ،</para>
  <para style="p" vid="JER 3:22">فأنتَ الرّبُّ إلهُنا.<verse eid="JER 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="JER 3:23" />فيكَ حَقًّا خلاصُ إِسرائيلَ</para>
  <para style="p" vid="JER 3:23">وباطِلٌ ما يجري في الرَّوابي</para>
  <para style="p" vid="JER 3:23">مِنْ فُجورٍ تَضِجُّ مِنهُ الجِبالُ.<verse eid="JER 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="JER 3:24" />لكِنْ عارُ عِبادَتِنا لآلِهَةٍ غريبةٍ أكَلَ تعَبَ أبائِنا مُنذُ فَجرِ أيّامِنا: غنَمَهُم وبقَرَهُم، بَنيهِم وبناتِهِم. <verse eid="JER 3:24" /><verse number="25" style="v" pubnumber="25" sid="JER 3:25" />والآنَ نَضطَجِعُ في عارِنا ويُغَطِّينا خجَلُنا، لأنَّنا خَطِئْنا إلى الرّبِّ إلَهِنا ورَفَضْنا أنْ نسمَعَ لِصوتِهِ، نحنُ وآباؤُنا مُنذُ فَجرِ أيّامِنا إلى يومِنا هذا.<verse eid="JER 3:25" /></para>
  <chapter eid="JER 3" />
  <chapter number="4" style="c" sid="JER 4" />
  <para style="s1">الدعوة إلى التوبة</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 4:1" />وقال الرّبُّ: ”إنْ رَجَعْتِ يا إِسرائيلُ إليَّ ونَزَعْتِ أصنامَكِ الرَّجسةَ مِنْ أمامِ وجهي وكُنتِ أمينةً لي. <verse eid="JER 4:1" /><verse number="2" style="v" pubnumber="2" sid="JER 4:2" />وإنْ حَلَفْتِ: ”حَيٌّ هوَ الرّبُّ“، بِالحَقِّ والعَدلِ والاستِقامةِ، تَبارَكَت بِكِ الأُمَمُ واَفتَخَرت“.<verse eid="JER 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="JER 4:3" />وقالَ الرّبُّ لِرجالِ يَهوذا ولأورُشليمَ: ”إفلَحوا أرضَكُم غَيرَ المَفلوحَةِ ولا تَزرَعوا بَينَ الأشواكِ. <verse eid="JER 4:3" /><verse number="4" style="v" pubnumber="4" sid="JER 4:4" />عاهِدوا الرّبَّ في قُلوبِكُم يا رِجالَ يَهوذا وسُكَّانَ أورُشليمَ لِئلَّا يَخرُجَ غضَبي كالنَّارِ لِشَرِّ أعمالِكُم، فَيُحرِقَ ولا مَنْ يُطفئُ.<verse eid="JER 4:4" /></para>
  <para style="s1">الغزو يهدد يهوذا</para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="JER 4:5" />أخبروا في يَهوذا،</para>
  <para style="p" vid="JER 4:5">أَذيعوا في أُورُشليمَ،</para>
  <para style="p" vid="JER 4:5">أنفُخوا بِالبوقِ في الأرضِ.</para>
  <para style="p" vid="JER 4:5">نادوا بِمِلءِ أفواهِكُم</para>
  <para style="p" vid="JER 4:5">وقولوا: إِجتمعوا.</para>
  <para style="p" vid="JER 4:5">أُدخُلوا المُدُنَ الحصينةَ.<verse eid="JER 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="JER 4:6" />إرفعوا رايةً نحوَ صِهيَونَ،</para>
  <para style="p" vid="JER 4:6">أُهربوا، لا تَقِفوا.</para>
  <para style="p" vid="JER 4:6">سَأجلِبُ شَرًّا مِنَ الشِّمالِ</para>
  <para style="p" vid="JER 4:6">وويلًا شديدَ الهَولِ.<verse eid="JER 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="JER 4:7" />طلَعَ الأسدُ مِنْ عَرينِهِ!</para>
  <para style="p" vid="JER 4:7">ها هوَ قاهِرُ الأُمَمِ!</para>
  <para style="p" vid="JER 4:7">يزحَفُ خارِجًا مِنْ مكانِهِ</para>
  <para style="p" vid="JER 4:7">ليَجعَلَ الأرضَ خَرابًا،</para>
  <para style="p" vid="JER 4:7">لا يسكُنُ فيها ساكِنٌ.<verse eid="JER 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="JER 4:8" />لذلِكَ اتَّزِروا بالمُسوحِ!</para>
  <para style="p" vid="JER 4:8">وَلْوِلوا والطِموا الخُدودَ،</para>
  <para style="p" vid="JER 4:8">فَحِدَّةُ غضَبِ الرّبِّ</para>
  <para style="p" vid="JER 4:8">لم تَنصَرِفْ عنَّا“.<verse eid="JER 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="JER 4:9" />وقالَ الرّبُّ: ”في ذلِكَ اليومِ يخُورُ قلبُ المَلِكِ وقلوبُ الرُّؤساءِ، ويتَحَيَّرُ الكهَنةُ ويتَعَجَّبُ الأنبياءُ <verse eid="JER 4:9" /><verse number="10" style="v" pubnumber="10" sid="JER 4:10" />ويقولُ الشَّعبُ: أيُّها السَّيِّدُ الرّبُّ! أنتَ حقًّا خدَعْتَنا حينَ قلتَ لنا: تَنعَمونَ بالسَّلامِ، وها هوَ السَّيفُ على رِقابِنا“.<verse eid="JER 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JER 4:11" />في ذلِكَ الزَّمانِ يقولُ الرّبُّ لِهذا الشَّعبِ ولأورُشليمَ: ”رِيحٌ لافِحةٌ تَهُبُّ مِنْ رَوابي البرِّيَّةِ على قَومي، لا لِتَذْريةِ البَيادِرِ ولا لِتَنقيتِها. <verse eid="JER 4:11" /><verse number="12" style="v" pubnumber="12" sid="JER 4:12" />هيَ ريحٌ أشَدُّ مِنها تَهُبُّ مِنْ عِندي، فَأُعلِنُ أنا نفسي حُكْمي علَيكُم.<verse eid="JER 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="JER 4:13" />أُنظُروا. ها العَدُوُّ صاعِدٌ كسَحابٍ، مركَباتُهُ كالزَّوبَعَةِ وخَيلُهُ أخَفُّ مِنَ النُّسورِ. ويلٌ لنا، هلَكْنا!<verse eid="JER 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="JER 4:14" />إِغسِلي مِنَ الشَّرِّ قلبَكِ يا أورُشليمُ فتَخلُصي. إلى متى تَبيتُ في داخِلِك أفكارُكِ الشِّرِّيرةُ؟<verse eid="JER 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="JER 4:15" />صوتُ مُخبِرٍ مِنْ دانَ بالبليَّةِ ومُنادٍ بِها مِنْ جبَلِ أفرايمَ: <verse eid="JER 4:15" /><verse number="16" style="v" pubnumber="16" sid="JER 4:16" />أُنذُروا الأُمَمَ! أَخبِروا أورُشليمَ! المُحاصِرونَ قادِمونَ مِنْ أرضٍ بَعيدةٍ. يَرفعونَ الصَّوتَ على مُدُنِ يَهوذا، <verse eid="JER 4:16" /><verse number="17" style="v" pubnumber="17" sid="JER 4:17" />ويُحيطونَ بِها كَنواطيرِ الحُقولِ، لأنَّها تمَرَّدَت عليَّ يقولُ الرّبُّ“.<verse eid="JER 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="JER 4:18" />طُرُقكِ وأعمالُكِ جَلَبَت علَيكِ هذا كُلَّهُ. ذلِكَ مَصيرُكِ وهوَ مُرٌّ، ومرارتُهُ بَلَغَت إلى قلبِكِ.<verse eid="JER 4:18" /></para>
  <para style="s1">حزن إرميا على الشعب</para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="JER 4:19" />أحشائي، أحشائي تُوجِعُني!</para>
  <para style="p" vid="JER 4:19">قلبي يَئِنُّ بَينَ جُدرانِهِ.</para>
  <para style="p" vid="JER 4:19">كيفَ السُّكوتُ وأنا سَمِعْتُ</para>
  <para style="p" vid="JER 4:19">صوتَ البُوقِ وهُتافَ الحربِ؟<verse eid="JER 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="JER 4:20" />نَكبَةٌ على نَكبَةٍ أشَدَّ،</para>
  <para style="p" vid="JER 4:20">فالأرضُ كُلُّها خرابٌ.</para>
  <para style="p" vid="JER 4:20">دُمِّرَت خيامُنا بَغتَةً</para>
  <para style="p" vid="JER 4:20">ومَساكِنُنا في لَحظَةٍ.<verse eid="JER 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="JER 4:21" />إلى متى أرى رايةَ الحربِ</para>
  <para style="p" vid="JER 4:21">وأسمَعُ صوتَ البُوقِ؟<verse eid="JER 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="JER 4:22" />شعبي جاهلٌ لا يَعرفُني.</para>
  <para style="p" vid="JER 4:22">بَنونَ حَمْقى لا فَهْمَ لهُم</para>
  <para style="p" vid="JER 4:22">وحُكَماءُ في عمَلِ الشَّرِّ</para>
  <para style="p" vid="JER 4:22">لا يَعرفونَ ما لِلخَيرِ.<verse eid="JER 4:22" /></para>
  <para style="s1">رؤيا الخراب الآتي</para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="JER 4:23" />نظَرتُ إلى الأرضِ، فهيَ خَلاءٌ</para>
  <para style="p" vid="JER 4:23">وإلى السَّماواتِ فلا نُورَ فيها،<verse eid="JER 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="JER 4:24" />نظَرتُ إلى الجِبالِ، فهيَ تَرتَجِفُ</para>
  <para style="p" vid="JER 4:24">وجميعُ التِّلالِ تتَزَعزعُ.<verse eid="JER 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="JER 4:25" />نظَرتُ فما مِنْ إنسانٍ،</para>
  <para style="p" vid="JER 4:25">وطُيورُ السَّماءِ كُلُّها هرَبَت.<verse eid="JER 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="JER 4:26" />ورَأيتُ الجنَائِنَ صارَت قَفرًا</para>
  <para style="p" vid="JER 4:26">وجميعَ المَدائِنِ أنقاضًا</para>
  <para style="p" vid="JER 4:26">مِنْ وجهِ الرّبِّ وحِدَّةِ غضَبِهِ.<verse eid="JER 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="JER 4:27" />فهذا ما قالَ الرّبُّ:</para>
  <para style="p" vid="JER 4:27">”سأُخرِّبُ الأرضَ كُلَّها،</para>
  <para style="p" vid="JER 4:27">لكِنِّي لا أفنيها“.<verse eid="JER 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="JER 4:28" />فتَنوحُ الأرضُ نُواحًا</para>
  <para style="p" vid="JER 4:28">وتُظلِمُ السَّماواتُ مِنْ فَوقُ</para>
  <para style="p" vid="JER 4:28">أنا تَكَلَّمْتُ ولا أندَمُ،</para>
  <para style="p" vid="JER 4:28">وعَزَمتُ ولا أرجِعُ عَنهُ“.<verse eid="JER 4:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="JER 4:29" />مِنْ صوتِ الفارسِ والرَّامي بالقوسِ</para>
  <para style="p" vid="JER 4:29">فَرَّ سُكَّانُ المُدُنِ جميعًا.</para>
  <para style="p" vid="JER 4:29">دَخَلوا الغابَ أو صَعِدوا الصُّخورَ،</para>
  <para style="p" vid="JER 4:29">فكُلُّ مدينةٍ مَهجورةٍ،</para>
  <para style="p" vid="JER 4:29">ولا إنسانَ ساكنٌ فيها.<verse eid="JER 4:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="JER 4:30" />وأنتِ ماذا تفعَلينَ</para>
  <para style="p" vid="JER 4:30">أيَّتُها المدينةُ الخرابُ؟</para>
  <para style="p" vid="JER 4:30">تَلبَسينَ ثيابَ القِرمِزِ،</para>
  <para style="p" vid="JER 4:30">وتَتَحَلّينَ بِحُلِيِّ الذَّهَبِ،</para>
  <para style="p" vid="JER 4:30">وتُكَحِّلينَ بالإثْمِدِ عينَيكِ،</para>
  <para style="p" vid="JER 4:30">ولكِنْ باطِلًا تتَجَمَّلينَ.</para>
  <para style="p" vid="JER 4:30">عُشَّاقُكِ الآنَ يَمقُتونَكِ</para>
  <para style="p" vid="JER 4:30">وهُم يَطلبونَ حياتَكِ!<verse eid="JER 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" pubnumber="31" sid="JER 4:31" />سَمِعتُ صوتًا كصوتِ المَخاضِ</para>
  <para style="p" vid="JER 4:31">كتَوَجُّعِ الّتي تَلِدُ بِكْرَها.</para>
  <para style="p" vid="JER 4:31">هوَ صوتُ اَبنَةِ صِهيَونَ</para>
  <para style="p" vid="JER 4:31">تَنتَحِبُ وتَبسِطُ كَفَّيها:</para>
  <para style="p" vid="JER 4:31">”ويلٌ لي، أُغميَ عليَّ</para>
  <para style="p" vid="JER 4:31">مِنَ القتَلَةِ المُحيطينَ بي“.<verse eid="JER 4:31" /></para>
  <chapter eid="JER 4" />
  <chapter number="5" style="c" sid="JER 5" />
  <para style="s1">مدينة تعج بالفساد</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 5:1" />طُوفوا في شوارعِ أورُشليمَ.</para>
  <para style="p" vid="JER 5:1">أُنظُروا واَستَخْبِروا وفَتِّشوا!</para>
  <para style="p" vid="JER 5:1">هل تَجِدونَ في ساحاتِها إنسانًا؟</para>
  <para style="p" vid="JER 5:1">إنسانًا واحدًا يصنَعُ العَدلَ</para>
  <para style="p" vid="JER 5:1">ويَطلُبُ بِالحَقِّ، فأعفوَ عَنها؟<verse eid="JER 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="JER 5:2" />فهُم وإنْ قالوا: حَيٌّ هوَ الرّبُّ،</para>
  <para style="p" vid="JER 5:2">فإنَّما يَحلِفونَ زُورًا.</para>
  <para style="p" vid="JER 5:2">هكذا يقولُ الرّبُّ.<verse eid="JER 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="JER 5:3" />نعم يا ربُّ، عيناكَ على الحَقِّ!</para>
  <para style="p" vid="JER 5:3">ضرَبْتَهُم ضَرْبًا فما توَجَّعوا،</para>
  <para style="p" vid="JER 5:3">وأهلَكْتَهُم فما قبِلوا التَّأديبَ.</para>
  <para style="p" vid="JER 5:3">قسّوا وجوهَهُم أكثرَ مِنَ الصَّخرِ</para>
  <para style="p" vid="JER 5:3">ورَفَضوا أنْ يَرجِعوا إليكَ.<verse eid="JER 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="JER 5:4" />فقُلتُ: ”هُم قَومٌ مَساكينُ</para>
  <para style="p" vid="JER 5:4">يَجهَلونَ طريقَ الرّبِّ</para>
  <para style="p" vid="JER 5:4">ولا يَعرِفونَ شريعةَ إلهِنا،<verse eid="JER 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="JER 5:5" />أذهَبُ إلى العُظَماءِ أُكَلِّمُهُم،</para>
  <para style="p" vid="JER 5:5">لَعلَّهُم يَعرِفونَ طريقَ الرّبِّ</para>
  <para style="p" vid="JER 5:5">ولا يَجهَلونَ شريعةَ إلَهِنا،</para>
  <para style="p" vid="JER 5:5">فوَجدتُ هؤلاءِ جميعًا</para>
  <para style="p" vid="JER 5:5">كَسروا النِّيرَ وقَطَعوا الرُّبُطَ<verse eid="JER 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="JER 5:6" />سَيَقتُلُهُم أسدٌ مِنَ الغابِ</para>
  <para style="p" vid="JER 5:6">ويُهلِكُهُم ذِئبٌ مِنَ القَفْرِ،</para>
  <para style="p" vid="JER 5:6">ويَسهَرُ النَّمِرُ حَولَ مُدُنِهِمِ</para>
  <para style="p" vid="JER 5:6">يَفتَرِسُ كُلَّ مَنْ خرَجَ مِنها.</para>
  <para style="p" vid="JER 5:6">فمَعاصيهِم تكاثَرَت جدًّا،</para>
  <para style="p" vid="JER 5:6">وكُفرُهُم دائِمًا في اَزديادٍ.<verse eid="JER 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="JER 5:7" />وقالَ الرّبُّ: ”كَيفَ أُسامِحُكِ يا أورُشليمُ وبَنوكِ ترَكوني وحلَفوا بإِلهٍ مَزعومٍ حينَ أَشبَعتُهُم زَنَوا، وفي بُيوتِ الزَّواني صرَفوا وقتَهُم. <verse eid="JER 5:7" /><verse number="8" style="v" pubnumber="8" sid="JER 5:8" />صاروا أحصِنةً معلوفةً سائِبةً، كُلٌّ يَصهَلُ على اَمرأةِ صاحبِهِ. <verse eid="JER 5:8" /><verse number="9" style="v" pubnumber="9" sid="JER 5:9" />أفلا أُعاقِبُهُم على هذِهِ المَعاصي يقولُ الرّبُّ، وأنتَقِمُ مِنْ أُمَّةٍ كهذِهِ الأُمَّةِ؟<verse eid="JER 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="JER 5:10" />”إصعَدوا على كَرمَتِها وأَفسِدوا ولا تُتلِفوها. إنزَعوا أغصانَها فما هيَ لي. <verse eid="JER 5:10" /><verse number="11" style="v" pubnumber="11" sid="JER 5:11" />فغَدْرًا غدَرَ بي بَيتُ إِسرائيلَ وبَيتُ يَهوذا“. هكذا يقولُ الرّبُّ.<verse eid="JER 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="JER 5:12" />أنكَروا الرّبَّ وقالوا: ”لا وُجودَ لَه، فالشَّرُّ لا يَنزِلُ بِنا ولن نرى حربًا ولا جوعًا. <verse eid="JER 5:12" /><verse number="13" style="v" pubnumber="13" sid="JER 5:13" />وما الأنبياءُ إلَّا هباءٌ، والرّبُّ لا يتَكَلَّمُ فيهِم، وأقوالُهُم مِنْ عِندهِم“.<verse eid="JER 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="JER 5:14" />لذلِكَ قالَ ليَ الرّبُّ الإلهُ القديرُ: ”بِما أنَّكُم تَكَلَّمْتُم هذا الكَلامَ، فسَأجعَلُ كَلِماتي في فَمِكَ نارًا وهذا الشَّعبُ حطَبًا فتَأكُلُهُم <verse eid="JER 5:14" /><verse number="15" style="v" pubnumber="15" sid="JER 5:15" />وأجلِبُ علَيكُم أُمَّةً مِنْ بَعيدٍ يا بَيتَ إِسرائيلَ، أُمَّةً قويَّةً عريقةً، أُمَّةً لا تَعرِفونَ لُغَتَها ولا تَفهَمونَ ما تَتكَلَّمُ بهِ. <verse eid="JER 5:15" /><verse number="16" style="v" pubnumber="16" sid="JER 5:16" />جُعبَةُ سِهامِها كقبرٍ مَفتوحٍ، وكُلُّ بَنيها جبابِرةٌ. <verse eid="JER 5:16" /><verse number="17" style="v" pubnumber="17" sid="JER 5:17" />فيَأكُلونَ حصادَكُم وخبزَكُم ويَقتُلونَ بَنيكُم وبَناتِكُم ويَذبحونَ غنَمَكُم وبقَرَكُم، ويتلفونَ كَرمَكُم وتينَكُم، ويُدمِّرونَ بالسَّيفِ مُدُنَكُمُ الحصينةَ الّتي أنتُم مُتوكِّلونَ علَيها“.<verse eid="JER 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="JER 5:18" />”ولَكنْ في تِلكَ الأيّامِ لا أَفنيكُم يقولُ الرّبُّ: <verse eid="JER 5:18" /><verse number="19" style="v" pubnumber="19" sid="JER 5:19" />وإنْ قالوا: لماذا فعَلَ الرّبُّ إلهُنا بِنا هذا كُلَّهُ؟ فتَقولُ لهُم: بِما أنَّكُم تَركتُموني وخَدمْتُم آلِهةً غريبةً في أرضِكُم، فستَخدِمونَ الغُرَباءَ في أرضٍ غَيرِ أرضِكُم. <verse eid="JER 5:19" /><verse number="20" style="v" pubnumber="20" sid="JER 5:20" />فأخبروا بذلِكَ في بَني يَعقوبَ، ونادوا بهِ في بَني يَهوذا. قولوا لهُم: <verse eid="JER 5:20" /><verse number="21" style="v" pubnumber="21" sid="JER 5:21" />إسمعوا هذا الكلامَ أيُّها الحَمقى، أيُّها الشَّعبُ الّذينَ فقَدوا الحِسَّ، الّذينَ لهُم عُيونٌ ولا يُبصرونَ وآذانٌ ولا يَسمعونَ“.<verse eid="JER 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="JER 5:22" />”ألا تخافونَني يقولُ الرّبُّ. ألا تَرتَعدونَ مِنْ وجهي؟ أنا جعَلْتُ الرَّملَ حَدًّا لِلبحرِ، حاجزًا أبديًّا لا يَتعَدَّاهُ. فأمواجُهُ تَلتطِمُ وتَبقى عاجِزَةً، وتَعِجُّ ولا تتَجاوزُهُ“. <verse eid="JER 5:22" /><verse number="23" style="v" pubnumber="23" sid="JER 5:23" />لَكنَّ هذا الشَّعبَ لَه قلبٌ ثائِرٌ مُتَمرِّدٌ، فابتَعَدوا ومَضَوا <verse eid="JER 5:23" /><verse number="24" style="v" pubnumber="24" sid="JER 5:24" />وما قالوا في قُلوبِهِم: لِنَخَفِ الرّبَّ إلهَنا الّذي يَمنَحُ المطَرَ المُبَكِّرَ مِنهُ والمُتأخِّرَ في حينِهِ، ويَحفَظُ لنا أسابيعَ الحَصادِ في مَواعيدِها.<verse eid="JER 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="JER 5:25" />لَكنَّ آثامَكُم أفسَدَت تِلكَ المَواعيدَ، وخطاياكُم منَعَتِ الخَيرَ عَنكُم. <verse eid="JER 5:25" /><verse number="26" style="v" pubnumber="26" sid="JER 5:26" />فلا يزالُ بَينَ شعبي مُنافقونَ، يَكمُنونَ لِلطَّريدَةِ كالصَّيَّادينَ ويَنصُبونَ لِلنَّاسِ فَخًّا. <verse eid="JER 5:26" /><verse number="27" style="v" pubnumber="27" sid="JER 5:27" />كالقَفَصِ المَملوءِ طُيورًا، كذلِكَ بُيوتُهُمُ امتلأت مِنَ المَكْرِ، فعَظُموا واغتَنَوا. <verse eid="JER 5:27" /><verse number="28" style="v" pubnumber="28" sid="JER 5:28" />هُم سِمانٌ لَمَعَت جُلودُهُم مِنَ الشَّحْمِ وجاوَزوا الحَدَّ بِشُرورِهِم. لا يَحكُمونَ بِالعَدلِ في دَعوى اليَتيمِ فتَنجَحُ، ولا يَقضونَ لِلمَساكينِ بِالحَقِّ.<verse eid="JER 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="JER 5:29" />”أفلا أُعاقِبُ على هذِهِ المعاصي وأَنتَقِمُ مِنْ أُمَّةٍ كَهذِهِ يقولُ الرّبُّ“.<verse eid="JER 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="JER 5:30" />في أرضِنا عَجَبٌ عِجابٌ: <verse eid="JER 5:30" /><verse number="31" style="v" pubnumber="31" sid="JER 5:31" />”الأنبياءُ يتَنَبَّأونَ زُورًا، والكَهنَةُ يَجمعونَ ما تَصِلُ إليهِ أيديهِم، وشعبي راضٍ بِهذِهِ الأمورِ. فماذا تفعَلونَ لِتَضَعوا حَدًّا لها“؟<verse eid="JER 5:31" /></para>
  <chapter eid="JER 5" />
  <chapter number="6" style="c" sid="JER 6" />
  <para style="s1">حصار أورشليم</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 6:1" />أُهرُبوا يا بَني بنيامينَ مِنْ أورُشليمَ.</para>
  <para style="p" vid="JER 6:1">أُنفُخوا في البُوقِ في تَقوعَ</para>
  <para style="p" vid="JER 6:1">وانصِبوا علَمًا في بَيتِ الكرمِ،</para>
  <para style="p" vid="JER 6:1">فَمِنَ الشِّمالِ لاحَ شَرٌّ عَظيمٌ<verse eid="JER 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="JER 6:2" />يُدَمِّرُ صِهيَونَ الجميلةَ المُترَفةَ<verse eid="JER 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="JER 6:3" />فيأتي إليها الرُّعاةُ بِقُطعانِهِم</para>
  <para style="p" vid="JER 6:3">ويَنصِبونَ خيامَهُم مِنْ حَولِها،</para>
  <para style="p" vid="JER 6:3">ويَرعَونَ كُلُّ واحدٍ في مكانِهِ.<verse eid="JER 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="JER 6:4" />إشهَروا علَيها الحربَ.</para>
  <para style="p" vid="JER 6:4">قوموا نَصعَدُ عِندَ الظَّهيرةِ.</para>
  <para style="p" vid="JER 6:4">وَيحٌ لنا، لأنَّ النَّهارَ يَميلُ</para>
  <para style="p" vid="JER 6:4">وظِلالَ المساءِ أخَذَت تَستَطيلُ.<verse eid="JER 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="JER 6:5" />قوموا نَصعَدُ في اللَّيلِ</para>
  <para style="p" vid="JER 6:5">ونَهدِمُ لها قُصورَها.<verse eid="JER 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="JER 6:6" />وقالَ الرّبُّ القديرُ: ”إقطَعوا الأشجارَ واَنصِبوا على أورُشليمَ مِترَسةً. فهذِهِ مدينةٌ تستَوجِبُ العِقابَ لأنَّها مَلآنةٌ بالظُّلمِ. <verse eid="JER 6:6" /><verse number="7" style="v" pubnumber="7" sid="JER 6:7" />يَنبَعُ مِنها شَرُّها كالبِئرِ يَنبَعُ مِنها الماءُ. فيها أسمَعُ بِالعُنْفِ والسَّلْبِ، وأرى المرَضَ والجُروحَ كُلَّ حينٍ. <verse eid="JER 6:7" /><verse number="8" style="v" pubnumber="8" sid="JER 6:8" />فاَتَّعِظي يا أُورُشليمُ لِئلَّا أترُكَكِ وأجعَلَكِ أَرضًا خرابًا لا تُسكَنُ“.<verse eid="JER 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="JER 6:9" />وقالَ ليَ الرّبُّ القديرُ: ”أقطُفْ، كما تُقطَفُ لُقاطَةُ الكَرمَةِ، ما تَبقَّى مِنْ شعبِ إِسرائيلَ، وَرُدَّ يَدَكَ إلى الأغصانِ كالقاطِفِ“.<verse eid="JER 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="JER 6:10" />مَنْ يسمعُ إذا تكَلَّمتُ وأنذَرتُ؟ آذانُكُم مُغلَقَةٌ فلا تَقدِرونَ أنْ تُصغوا. كَلِمَةُ الرّبِّ صارَت لهُم عارًا، وأنتُم لا تَحفَظونَها. <verse eid="JER 6:10" /><verse number="11" style="v" pubnumber="11" sid="JER 6:11" />لذلِكَ اَمتَلأتُ مِنْ غضَبِ الرّبِّ، وأعياني أنْ أكبُتَهُ في صَدْري.</para>
  <para style="p" vid="JER 6:11">”أُفرِغُهُ على أطفالِ الأزِقَّةِ على جُموعِ الشُّبَّانِ أيضًا وأقولُ: سيُؤخَذُ الرَّجلُ معَ اَمرأتِهِ، والشُّيوخُ معَ المُتَقدِّمِ في السِّنِّ. <verse eid="JER 6:11" /><verse number="12" style="v" pubnumber="12" sid="JER 6:12" />فتَصيرُ بُيوتُهُم لآخَرينَ، والحُقولُ والنِّساءُ جميعًا. فعلى سُكَّانِ هذِهِ الأرضِ أمُدُّ يَدي وأُعاقِبُهُم يقولُ الرّبُّ <verse eid="JER 6:12" /><verse number="13" style="v" pubnumber="13" sid="JER 6:13" />لأنَّهُم جميعًا مِنْ صغيرِهِم إلى كبيرِهِم يَطمَعونَ بالمَكْسَبِ الخَسيسِ، وِمِن النَّبيِّ إلى الكاهنِ يُمارِسونَ أعمالَ الزُّورِ <verse eid="JER 6:13" /><verse number="14" style="v" pubnumber="14" sid="JER 6:14" />ويُداوُونَ جِراحَ شعبي باَستِخفافٍ. يقولونَ: سلامٌ سلامٌ، وما مِنْ سلامٍ. <verse eid="JER 6:14" /><verse number="15" style="v" pubnumber="15" sid="JER 6:15" />هل يَخزَونَ إذا اَقتَرَفوا رِجْسًا؟ كلَّا، لا يَخزَونَ ولا يَعرِفونَ الخجَلَ. فلذلِكَ يَسقُطونَ معَ السَّاقطينَ، وحينَ أُعاقِبُهُم يُصرعونَ يقولُ الرّبُّ“.<verse eid="JER 6:15" /></para>
  <para style="s1">إسرائيل ترفض طريق الرب</para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="JER 6:16" />وقالَ الرّبُّ: ”قِفوا في الطُّرُقِ واَنظُروا، واَسألوا عَنِ السُّبُلِ القديمةِ، أينَ الطَّريقُ الصَّالِحُ وسِيروا فيهِ، فتَجِدوا راحةً لِنُفوسِكُم. لكِنَّكُم أجَبْتُم: لا نَسيرُ. <verse eid="JER 6:16" /><verse number="17" style="v" pubnumber="17" sid="JER 6:17" />أقَمتُ لكُم رُقَباءَ أنْ أصغُوا إلى صوتِ البُوقِ! فقُلتُم: لا نُصغي. <verse eid="JER 6:17" /><verse number="18" style="v" pubnumber="18" sid="JER 6:18" />لذلِكَ اَسمَعوا أيُّها الأمَمُ واَعلَموا ماذا يُصيبُهُم. <verse eid="JER 6:18" /><verse number="19" style="v" pubnumber="19" sid="JER 6:19" />واَسمَعي أيَّتُها الأرضُ: سأجلِبُ على هذا الشَّعبِ شَرًّا جَزاءَ مَكايِدِهِم، لأنَّهُم لا يُصغُونَ إلى كلامي ويَرفُضونَ العمَلَ بشريعَتي. <verse eid="JER 6:19" /><verse number="20" style="v" pubnumber="20" sid="JER 6:20" />لِماذا يأتونَني بِالبَخورِ مِنْ شَبا وبِعيدانِ الطِّيبِ مِنْ أرضٍ بعيدةٍ؟ مُحرَقاتُهُم لا أرضى بِها، وذَبائِحُهُم لا تَلَذُّ لي. <verse eid="JER 6:20" /><verse number="21" style="v" pubnumber="21" sid="JER 6:21" />لذلِكَ سأجَعلُ لِهذا الشَّعبِ معاثِرَ يَعثُرونَ بِها، فيَهلِكُ الآباءُ والبَنونَ، والجارُ والصَّديقُ جميعًا“.<verse eid="JER 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="JER 6:22" />وقالَ الرّبُّ: ”ها شعبٌ مُقبِلٌ مِنْ أرضِ الشِّمال، أُمَّةٌ عظيمةٌ ناهِضةٌ مِنْ أقاصي الأرضِ، <verse eid="JER 6:22" /><verse number="23" style="v" pubnumber="23" sid="JER 6:23" />قابِضونَ على القَوسِ والرُّمحِ، قُساةٌ لا يَرحمونَ وكالبحرِ صوتُهُم، راكِبونَ خُيُولًا مُصطَفَّةً كأنَّ علَيها راكِبًا واحدًا، لِمُقاتَلَتِكِ يا اَبنَةَ صِهيونَ“.<verse eid="JER 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="JER 6:24" />سَمِعْنا خبَرَهُم فاَستَرْخَت أيدينا، وأصابَنا ضيقٌ ووَجَعٌ كالّتي تَلِدُ. <verse eid="JER 6:24" /><verse number="25" style="v" pubnumber="25" sid="JER 6:25" />لا تَخرُجوا إلى الحقلِ ولا تَسيروا في الطَّريقِ، فسَيفُ العَدُوِّ رُعْبٌ مِنْ كُلِّ جِهَةٍ.<verse eid="JER 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="JER 6:26" />تَحَزَّموا بِالمِسْحِ يا بَني قَوْمي، وتَمَرَّغوا حُزنًا في الرَّمادِ. أقيموا مناحةً كما على وحيدٍ اَنتَحِبوا اَنتِحابًا مُرًّا، فالدَّمارُ يَحِلُّ بِكُم بَغتَةً.<verse eid="JER 6:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="JER 6:27" />وقالَ ليَ الرّبُّ: ”جعَلتُكَ مُمتَحِنًا تَمتَحِنُ شعبي كالمَعدَنِ فتَعرِفُ سُلُكَهُم. <verse eid="JER 6:27" /><verse number="28" style="v" pubnumber="28" sid="JER 6:28" />هُم نُحاسٌ وحديدٌ. كُلُّهُم عُصاةٌ مُتَمَرِّدونَ وساعونَ بالنَّميمةِ ومُفسِدونَ. <verse eid="JER 6:28" /><verse number="29" style="v" pubnumber="29" sid="JER 6:29" />يَحترِقُ المِنفاخُ ويَفنى الرَّصاصُ بِالنَّارِ، وباطِلًا يَمحَصُ الماحِصُ، فالأشرارُ لا يُفرَزونَ. <verse eid="JER 6:29" /><verse number="30" style="v" pubnumber="30" sid="JER 6:30" />يُدعَونَ فِضَّةً مَرفوضَةً لأنِّي أنا الرّبُّ رَفَضْتُهُم“.<verse eid="JER 6:30" /></para>
  <chapter eid="JER 6" />
  <chapter number="7" style="c" sid="JER 7" />
  <para style="s1">عظة إرميا في الهيكل</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 7:1" />وقالَ الرّبُّ لإرميا: <verse eid="JER 7:1" /><verse number="2" style="v" pubnumber="2" sid="JER 7:2" />”قِفْ بِبابِ الهَيكَلِ وقُلْ: إِسمَعوا كَلِمَةَ الرّبِّ يا جميعَ رِجالِ يَهوذا الدَّاخلينَ في هذِهِ الأبوابِ ليَسجُدوا للرّبِّ. <verse eid="JER 7:2" /><verse number="3" style="v" pubnumber="3" sid="JER 7:3" />هذا ما قالَ الرّبُّ القديرُ إلهُ إِسرائيلَ: أصلِحوا طُرُقَكُم وأعمالَكُم فأُسكِنَكُم في هذا المَوضعِ. <verse eid="JER 7:3" /><verse number="4" style="v" pubnumber="4" sid="JER 7:4" />لا تَتَّكِلوا على قولِكُم: هيكَلُ الرّبِّ! هيكَلُ الرّبِّ! هيكَلُ الرّبِّ! فتَخدَعونَ أنفسَكُم. <verse eid="JER 7:4" /><verse number="5" style="v" pubnumber="5" sid="JER 7:5" />بل بِالأولى أَصلِحوا طُرُقَكُم وأعمالَكُم واَقضوا بِالعَدلِ بَينَ الواحدِ والآخَرِ، <verse eid="JER 7:5" /><verse number="6" style="v" pubnumber="6" sid="JER 7:6" />ولا تَجوروا على الغريبِ واليَتيمِ والأرملَةِ، ولا تَسفِكُوا الدَّمَ البَريءَ في هذا المَوضعِ ولا تَتبَعوا آلِهَةً أُخرى لِضَرَرِكُم. فإنْ فعَلْتُم هذا <verse eid="JER 7:6" /><verse number="7" style="v" pubnumber="7" sid="JER 7:7" />أسكُنُ معَكُم في هذا المَوضعِ، في الأرضِ الّتي أعطَيتُها قديمًا لآبائِكُم إلى الأبدِ.<verse eid="JER 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="JER 7:8" />”ولكِنَّكُم تتَّكِلونَ على كلامٍ لا فائِدَةَ فيهِ فتَخدَعونَ أنفُسَكُم. <verse eid="JER 7:8" /><verse number="9" style="v" pubnumber="9" sid="JER 7:9" />أتَسرِقونَ وتَقتُلونَ وتَزنونَ وتَحلِفونَ بالزُّورِ وتُبَخِّرونَ لِلبَعلِ وتَتبَعونَ آلِهَةً أُخرى تَجهَلونَها، <verse eid="JER 7:9" /><verse number="10" style="v" pubnumber="10" sid="JER 7:10" />ثُمَّ تَجيئونَ وتَقِفونَ بَينَ يَدَيَّ في هذا البَيتِ الذي دُعِيَ باَسمي وتَقولونَ ”أنقِذْنا“ لِتَعودوا وتَعمَلوا جميعَ تِلكَ الرَّجاساتِ؟ <verse eid="JER 7:10" /><verse number="11" style="v" pubnumber="11" sid="JER 7:11" />فهذا البَيتُ الّذي دُعيَ باَسمي هل صارَ مَغارةً لِلُّصوصِ أمامَ عُيونِكُم؟ بل أنا رأيتُ ذلِكَ يقولُ الرّبُّ.<verse eid="JER 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="JER 7:12" />”إذهَبوا إلى مَوضِعي الّذي في شِيلوهَ حَيثُ أسكَنتُ اَسمي أوَّلًا، واَنظُروا ما فعَلْتُ بِهِ بِسبَبِ شَرِّ شعبي إِسرائيلَ. <verse eid="JER 7:12" /><verse number="13" style="v" pubnumber="13" sid="JER 7:13" />والآنَ بِما أنَّكُم عَمِلْتُم هذِهِ الأعمالَ بَعدَما كَلَّمتُكُم ولم تَسمَعوا، ودَعَوتُكُم ولم تُجيبُوا <verse eid="JER 7:13" /><verse number="14" style="v" pubnumber="14" sid="JER 7:14" />فسأفعَلُ بهذا البَيتِ الّذي دُعيَ بِاَسمي وأنتُم علَيهِ مُتَّكِلونَ، وبِهذا المَوضعِ الّذي أعطَيتُهُ لكُم ولآبائِكُم، كما فعَلتُ هُناكَ بشيلوهَ. <verse eid="JER 7:14" /><verse number="15" style="v" pubnumber="15" sid="JER 7:15" />وأنبُذُكُم عَنْ وجهي كما نبَذتُ جميعَ إخوَتِكُم مِنْ نَسلِ إِسرائيلَ.<verse eid="JER 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="JER 7:16" />”وأنتَ يا إرميا فلا تتَضَرَّعْ ولا ترفَعْ دُعاءً ولا صلاةً لأجلِ هذا الشَّعبِ، ولا تشفَعْ إليَّ فأنا لا أسمَعُ لكَ. <verse eid="JER 7:16" /><verse number="17" style="v" pubnumber="17" sid="JER 7:17" />ألا ترى ما يفعَلونَ في مُدُنِ يَهوذا وفي شوارعِ أورُشليمَ؟ <verse eid="JER 7:17" /><verse number="18" style="v" pubnumber="18" sid="JER 7:18" />البنونَ يَلتَقِطونَ الحطَبَ، والآباءُ يوقِدونَ النَّارَ، والنِّساءُ يَعْجُنَّ الدَّقيقَ لِيَصنَعوا أقراصًا لِمَلِكَةِ السَّماءِ ويَسكبوا قرابينَ خمرٍ لإلهٍ آخرَ حتّى يُغيظوني. <verse eid="JER 7:18" /><verse number="19" style="v" pubnumber="19" sid="JER 7:19" />فهَل هُم حقًّا يُغيظونَني؟ ألا يعودُ ذلِكَ علَيهِم بِالعارِ؟ <verse eid="JER 7:19" /><verse number="20" style="v" pubnumber="20" sid="JER 7:20" />فلذلِكَ سيَنَصَبُّ غضَبي وغَيظي على هذا المَوضعِ، على البشَرِ والبَهائِمِ وعلى شجَرِ البرِّيَّةِ وثمَرِ الأرضِ، فيَتَّقِدُ ولا يَنطَفِئُ“.<verse eid="JER 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="JER 7:21" />وقالَ الرّبُّ القديرُ إِلهُ إِسرائيلَ: ”إجمَعوا مُحرَقاتِكُم إلى ذَبائِحِكُم وكُلوا لَحمَها. <verse eid="JER 7:21" /><verse number="22" style="v" pubnumber="22" sid="JER 7:22" />فأنا لم أُكلِّمْ أباءَكُم ولا أمَرتُهُم بأيَّةِ مُحرَقةٍ أو ذبيحةٍ يومَ أخرَجْتُهُم مِنْ أرضِ مِصْرَ <verse eid="JER 7:22" /><verse number="23" style="v" pubnumber="23" sid="JER 7:23" />وإنَّما أمَرتُهُم بِأنْ يَسمَعوا لي حينَ أُكَلِّمُهُم فأكونُ لهُم إلهًا ويكونونَ لي شعبًا، ويسلُكونَ في كُلِّ طريقٍ آمرُهُم بِهِ لخَيرِهِم. <verse eid="JER 7:23" /><verse number="24" style="v" pubnumber="24" sid="JER 7:24" />فما سَمِعوا ولا مالوا بِآذانِهِم، بل سَلَكوا في المَعاصي وفي نِيّاتِ قُلوبِهِم الشِّرِّيرةِ. فأداروا لي ظُهورَهُم لا وُجوهَهُم. <verse eid="JER 7:24" /><verse number="25" style="v" pubnumber="25" sid="JER 7:25" />ومُنذُ خرَجَ آباؤُكُم مِنْ أرضِ مِصْرَ إلى هذا اليومِ وأنا أُرسِلُ إليكُم عَبيدي الأنبياءَ كُلَّ يومٍ بِلا اَنقِطاعٍ. <verse eid="JER 7:25" /><verse number="26" style="v" pubnumber="26" sid="JER 7:26" />فما سَمِعتُم لي ولا مِلْتُم بِآذانِكُم، بل قَسَّيتُم رِقابَكُم وأسأْتُم أكثرَ مِمَّا أساءَ آباؤُكُم.<verse eid="JER 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="JER 7:27" />”وأنتَ إذا كَلَّمتَهُم بِهذا الكلامِ وما سَمِعوا لكَ، ودَعَوتَهُم وما أجابوكَ <verse eid="JER 7:27" /><verse number="28" style="v" pubnumber="28" sid="JER 7:28" />فقُلْ لهُم: أنتُم هيَ الأُمَّةُ الّتي لا تسمَعُ لِصوتِ الرّبِّ إلهِها ولا تَقبَلُ التّأديبَ. ذهَبَ الحَقُّ واَنقَطَعَ عَنْ أفواهِكُم“.<verse eid="JER 7:28" /></para>
  <para style="s1">وادي القتل</para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="JER 7:29" />فَجُزِّي شَعرَكِ واَرمي بهِ واَنشُدي مِرثاةً على الرَّوابي يا اَبنَةَ صِهيونَ، لأنَّ الرّبَّ غَضِبَ على هذا الجِيلِ ورَفَضَهُ ونَبَذَهُ.<verse eid="JER 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="JER 7:30" />وقالَ الرّبُّ: ”بَنو يَهوذا فعَلوا الشَّرَّ أمامَ عينَيَّ، فنَصَبوا أصنامَهُمُ الرَّجِسةَ في البَيتِ الّذي دُعيَ بِاَسمي ليُنَجِّسوهُ، <verse eid="JER 7:30" /><verse number="31" style="v" pubnumber="31" sid="JER 7:31" />وبَنَوا مشارِفَ تُوفَةَ الّتي في وادي اَبنِ هَنُّومَ لِيَحرقوا بَنيهِم وبَناتِهِم بِالنَّارِ. وأنا ما أمَرتُ بذلِكَ ولا خطَرَ بِبالي. <verse eid="JER 7:31" /><verse number="32" style="v" pubnumber="32" sid="JER 7:32" />لذلِكَ تَجيءُ أيّامٌ، يقولُ الرّبُّ، لا يُقالُ فيها تُوفَةُ ولا وادي اَبنِ هَنُّومَ، بل وادي القَتْلِ، ويَدفِنونَ فيهِ موتاهُم فلا يَبقى مَوضعٌ، <verse eid="JER 7:32" /><verse number="33" style="v" pubnumber="33" sid="JER 7:33" />وتصيرُ جُثَثُ هذا الشَّعبِ مأكَلًا لِطَيرِ السَّماءِ وبَهائِمِ الأرضِ ولا مَنْ يَزجُرُها. <verse eid="JER 7:33" /><verse number="34" style="v" pubnumber="34" sid="JER 7:34" />وأُزيلُ مِنْ مُدُنِ يَهوذا ومِنْ شوارِعِ أورُشليمَ صوتَ الطَّرَبِ وصوتَ الفرَحِ، صوتَ العريسِ وصوتَ العروسِ، لأنَّ الأرضَ تكونُ خَرابًا“.<verse eid="JER 7:34" /></para>
  <chapter eid="JER 7" />
  <chapter number="8" style="c" sid="JER 8" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 8:1" />وقالَ الرّبُّ: ”في ذلِكَ الزَّمانِ يَنبُشونَ عِظامَ مُلوكِ يَهوذا ورؤسائِها وكَهنَتِها وأنبيائِها وعِظامَ سُكَّانِ أورُشليمَ مِنْ قُبورِهِم <verse eid="JER 8:1" /><verse number="2" style="v" pubnumber="2" sid="JER 8:2" />ويَنشُرونَها تُجاهَ الشَّمسِ والقمَرِ وكُلِّ نُجومِ السَّماءِ الّتي أحَبُّوها وعبَدوها واَتَّبَعوها واَستَشاروها وسَجَدوا لها، فلا تُجمَعُ ولا تُدفَنُ وتكونُ زِبْلًا على وجهِ الأرضِ. <verse eid="JER 8:2" /><verse number="3" style="v" pubnumber="3" sid="JER 8:3" />وتُفَضِّلُ الموتَ على الحياةِ جميعُ البقيَّةِ الباقيةِ مِنْ هذِهِ العَشيرةِ الشِّرِّيرةِ في جميعِ الأماكِنِ الّتي هَزَمْتُهُم إليها يقولُ الرّبُّ القديرُ.<verse eid="JER 8:3" /></para>
  <para style="s1">الخطيئة والعقاب</para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="JER 8:4" />وقالَ الرّبُّ: ”تقولُ لهُم: أيسقُطونَ ولا يَنهَضونَ. يرتَدُّونَ عنِّي ولا يَتوبونَ؟ <verse eid="JER 8:4" /><verse number="5" style="v" pubnumber="5" sid="JER 8:5" />ما بالُ شعبِ أورُشليمَ هذا يُصرُّونَ على اَرتِدادِهِم وهُم يتَمَسَّكونَ بالغُرورِ ويَرفُضونَ أنْ يَتوبوا. <verse eid="JER 8:5" /><verse number="6" style="v" pubnumber="6" sid="JER 8:6" />أصغَيتُ واَستَمعتُ فإذا هُم يتَكَلَّمونَ بما يُنافي الحَقَّ، ولا مَنْ يَندَمُ على شَرِّهِ فيقولُ: ماذا فعَلتُ؟ بل كُلُّ واحدٍ يتَّجِهُ في سَيرِهِ كفَرَسٍ يَندَفِعُ إلى ساحةِ القِتالِ. <verse eid="JER 8:6" /><verse number="7" style="v" pubnumber="7" sid="JER 8:7" />اللَّقلَقُ في الفضاءِ يَعرِفُ مَواقِيتَهُ واليَمامةُ والسُّنونَةُ المُزَقزِقَةُ تُراعيانِ وقتَ مَجيئِهما، وأمَّا شَعبي فلا يَعرفونَ أحكامَ الرّبِّ.<verse eid="JER 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="JER 8:8" />”كيفَ تقولونَ: نحنُ حُكماءُ وشريعةُ الرّبِّ معَنا؟ أما تَرَونَ أنَّ قلمَ الكتبةِ الكاذِبَ حَوَّلَها إلى الكَذِبِ. <verse eid="JER 8:8" /><verse number="9" style="v" pubnumber="9" sid="JER 8:9" />خَزِيَ الحُكَماءُ وخابوا واَنخَدَعوا. فها هُم نَبَذوا كلامَ الرّبِّ، فماذا فيهِم مِنَ الحِكمةِ؟ <verse eid="JER 8:9" /><verse number="10" style="v" pubnumber="10" sid="JER 8:10" />لذلِكَ أعطي نِساءَهُم لآخرينَ وحُقولَهُم لِلْغُزاةِ، فهُم جميعًا مِنْ صغيرِهِم إلى كبيرِهِم يَطمَعونَ بِالمَكسَبِ الخَسيسِ، ومِنَ النَّبيِّ فيهِم إلى الكاهنِ يُمارِسونَ الكَذِبَ. <verse eid="JER 8:10" /><verse number="11" style="v" pubnumber="11" sid="JER 8:11" />يُداوُونَ جِراحَ بِنْتِ شعبي بِاَستِخفافٍ ويقولونَ: سلامٌ سلامٌ! وما مِنْ سلامٍ. <verse eid="JER 8:11" /><verse number="12" style="v" pubnumber="12" sid="JER 8:12" />هل يَستَحونَ إذا اقتَرَفوا رجْسًا؟ كلَّا. لا يَستَحونَ ولا يَعرِفونَ الخَجَلَ. فلذلِكَ يَسقُطونَ معَ السَّاقِطينَ، وحينَ أعاقِبُهُم يُصرَعونَ يقولُ الرّبُّ.<verse eid="JER 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="JER 8:13" />”سأُبيدُهُم إِبادةً يقولُ الرّبُّ. فلا يكونُ عِنَبٌ في الكَرمَةِ ولا تينٌ في التِّينَةِ. حتّى الوَرَقُ يَسقُطُ، وكُلَّ ما وَهَبْتُهُ لهُم يزولُ“.<verse eid="JER 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="JER 8:14" />لماذا نحنُ قُعودٌ؟ لِنَجتَمِعْ ونَدخُلِ المُدُنَ الحصينةَ ونَهلِكْ هُناكَ، لأنَّ الرّبَّ إلهَنا حكَمَ علَينا بِالهَلاكِ وسَقانا السُّمَّ لأنَّنا خَطِئنا إليهِ. <verse eid="JER 8:14" /><verse number="15" style="v" pubnumber="15" sid="JER 8:15" />إنتَظَرْنا السَّلامةَ عَبَثًا وأوانَ الشِّفاءِ فجاءَنا الرُّعبُ.<verse eid="JER 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="JER 8:16" />مِنْ دانَ يُسمَعُ نَخيرُ خيلِ العَدُوِّ، وعِندَ صوتِ صَهيلِ جيادِهِم تَرتَجِفُ الأرضُ. يأتونَ يأكلونَ الأرضَ بِما فيها والمدينةَ وسُكَّانَها.<verse eid="JER 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="JER 8:17" />سأُرسِلُ علَيكُم حَيَّاتٍ أراقِمَ لا يَنفَعُ فيها السِّحرُ، فتَلدَغُكُم يقولُ الرّبُّ.<verse eid="JER 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="JER 8:18" />حُزني لا شِفاءَ لَه</para>
  <para style="p" vid="JER 8:18">فقلبي في صَدْري عليلٌ.<verse eid="JER 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="JER 8:19" />صوتُ اَستِغاثَةِ شعبي</para>
  <para style="p" vid="JER 8:19">يُسمَعُ مِنْ أرضٍ بعيدةٍ:</para>
  <para style="p" vid="JER 8:19">ألا يُقيمُ الرّبُّ في صِهيَونَ؟</para>
  <para style="p" vid="JER 8:19">ألا يوجَدُ مَلِكُها فيها؟</para>
  <para style="p" vid="JER 8:19">”لِماذا أغاظوني بِمَنحوتاتِهِم،</para>
  <para style="p" vid="JER 8:19">لِماذا أسخَطوني بِالآلِهَةِ الغريبةِ؟<verse eid="JER 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="JER 8:20" />مضى الحَصادُ واَنقَضى الصَّيفُ</para>
  <para style="p" vid="JER 8:20">وخلاصُنا ما جاءَ بَعدُ.<verse eid="JER 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="JER 8:21" />على سَحْقِ شعبي اَنسَحَقْتُ</para>
  <para style="p" vid="JER 8:21">حَزِنتُ واَستَولى عليَّ الذُّهولُ<verse eid="JER 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="JER 8:22" />أما مِنْ بَلسَمٍ في جلعادَ؟</para>
  <para style="p" vid="JER 8:22">أما مِنْ طبيبٍ هُناكَ</para>
  <para style="p" vid="JER 8:22">يُضَمِّدُ جِراحَ شعبي؟<verse eid="JER 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="JER 8:23" />ليتَ رأسي مِلؤُهُ ماءٌ</para>
  <para style="p" vid="JER 8:23">وعينَيَّ يَنبوعُ دُموعٍ،</para>
  <para style="p" vid="JER 8:23">فأبكيَ نهارًا وليلًا</para>
  <para style="p" vid="JER 8:23">على قَتلى أبناءِ شعبي.<verse eid="JER 8:23" /></para>
  <chapter eid="JER 8" />
  <chapter number="9" style="c" sid="JER 9" />
  <para style="s1">الكذب في كل مكان</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 9:1" />ليتَ لي كُوخًا في البرِّيَّةِ</para>
  <para style="p" vid="JER 9:1">فأنصَرِفَ تارِكًا شعبي.</para>
  <para style="p" vid="JER 9:1">هُم جميعًا مِنَ الخَوَنةِ،</para>
  <para style="p" vid="JER 9:1">وزُمرَةٌ مِنَ الماكِرينَ.<verse eid="JER 9:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="JER 9:2" />ألسِنَتُهُم قِسِيٌّ لِلكَذِبِ.</para>
  <para style="p" vid="JER 9:2">لا بالحَقِّ تَقوُّوا في الأرضِ.</para>
  <para style="p" vid="JER 9:2">يَنتَقِلونَ مِنْ شَرٍّ إلى شَرٍّ،</para>
  <para style="p" vid="JER 9:2">ولا يَعرفونَني أنا الرّبُّ.<verse eid="JER 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="JER 9:3" />لِيَحذَرْ كُلُّ واحدٍ مِنْ صاحبِهِ،</para>
  <para style="p" vid="JER 9:3">ولا يَتَّكِلْ على أحدٍ مِنْ إخوَتِهِ.</para>
  <para style="p" vid="JER 9:3">فكُلُّ أخٍ يَمكُرُ بِأخيهِ،</para>
  <para style="p" vid="JER 9:3">وكُلُّ صاحبٍ يَسعى بِالنَّميمَةِ.<verse eid="JER 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="JER 9:4" />كُلُّ واحدٍ يُخادِعُ صاحبَهُ،</para>
  <para style="p" vid="JER 9:4">ولا أحدَ يتَكَلَّمُ بِالصِّدقِ.</para>
  <para style="p" vid="JER 9:4">عَلَّموا ألسِنَتَهُم كَلامَ الكَذِبِ،</para>
  <para style="p" vid="JER 9:4">فَعَجِزوا عَنِ الرُّجوعِ عَنهُ.<verse eid="JER 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="JER 9:5" />يَسكُنونَ في وسَطِ المَكْرِ،</para>
  <para style="p" vid="JER 9:5">وبِالمَكْرِ رفَضوا أنْ يَعرِفوني“.<verse eid="JER 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="JER 9:6" />فقالَ الرّبُّ القديرُ:</para>
  <para style="p" vid="JER 9:6">سأصهرُهُم وأمتَحِنُهُم بِالنَّارِ،</para>
  <para style="p" vid="JER 9:6">وإلَّا فكَيفَ أُجازي شعبي؟<verse eid="JER 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="JER 9:7" />لِسانُهُم سَهمٌ قاتِلٌ،</para>
  <para style="p" vid="JER 9:7">وأفواهُهُم تَنطِقُ بِالمَكْرِ.</para>
  <para style="p" vid="JER 9:7">يقولُ الواحدُ لِلآخَرِ: سلامٌ!</para>
  <para style="p" vid="JER 9:7">وفي سِرِّهِ يَكيدُ لهُ.<verse eid="JER 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="JER 9:8" />أعلى ذلِكَ لا أُعاقِبُهُم،</para>
  <para style="p" vid="JER 9:8">أم مِنْ أُمَّةٍ كهذِهِ لا أنتَقِمُ؟<verse eid="JER 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="JER 9:9" />على الجِبالِ أَندُبُ وأبكي،</para>
  <para style="p" vid="JER 9:9">وعلى المُروجِ أُنشِدُ رِثائي.</para>
  <para style="p" vid="JER 9:9">إحتَرَقَت فلا يَجتازُ فيها أحدٌ،</para>
  <para style="p" vid="JER 9:9">ولا يُسمَعُ صوتُ الماشيةِ.</para>
  <para style="p" vid="JER 9:9">مِنْ طُيورِ السَّماءِ إلى البَهائِمِ،</para>
  <para style="p" vid="JER 9:9">جميعُها هرَبَت ومَضَت.<verse eid="JER 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="JER 9:10" />سأجعَلُ أورُشليمَ رِجسًا</para>
  <para style="p" vid="JER 9:10">ومأوى لِبناتِ آوى،</para>
  <para style="p" vid="JER 9:10">وأجعَلُ مُدُنَ يَهوذا</para>
  <para style="p" vid="JER 9:10">خَرابًا لا ساكِنَ فيها“.<verse eid="JER 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JER 9:11" />مَن هوَ الحكيمُ فيَفهَمَ ذلِكَ؟ ومَنْ كَلَّمَهُ الرّبُّ فَيُخبِرَ لِماذا بادَتِ الأرضُ واَحتَرَقَت فصارَت كالقَفْرِ لا يجتازُ فيها أحدٌ.<verse eid="JER 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="JER 9:12" />وقالَ الرّبُّ: ”بِما أنَّهُم ترَكوا شريعتي الّتي أعطَيتُها لهُم، وما سَمِعوا كَلامي ولا عَملوا بهِ، <verse eid="JER 9:12" /><verse number="13" style="v" pubnumber="13" sid="JER 9:13" />بلِ اَتَّبَعوا نيَّاتِ قُلوبِهِم وعَبَدوا الإلهَ البَعلَ كما عَلَّمَهُم آباؤُهُم. <verse eid="JER 9:13" /><verse number="14" style="v" pubnumber="14" sid="JER 9:14" />لذلِكَ سَأُطعِمُ هذا الشَّعبَ نباتًا مُرًّا وأسقيهِم ماءَ العَلقَمِ، <verse eid="JER 9:14" /><verse number="15" style="v" pubnumber="15" sid="JER 9:15" />وأُشَتِّتُهُم في أُمَمٍ لا يَعرِفونَها ولا عَرَفَها آباؤهُم، وأُلاحِقُهُم بِالسَّيفِ حتّى أُفنيَهُم يقولُ الرّبُّ القديرُ“.<verse eid="JER 9:15" /></para>
  <para style="s1">استغاثة سكان أورشليم</para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="JER 9:16" />قوموا واَستَدعوا النَّادِباتِ ليَأْتينَ، والرَّاثياتِ لِيُقْبِلْنَ، <verse eid="JER 9:16" /><verse number="17" style="v" pubnumber="17" sid="JER 9:17" />مُسرِعاتٍ ويَرفَعْنَ صوتَ النَّحيبِ، فتَجري عُيونُنا بالدُّموعِ وتَسيلُ جُفونُنا بِماءِ البُكاءِ <verse eid="JER 9:17" /><verse number="18" style="v" pubnumber="18" sid="JER 9:18" />ويُسمَعُ مِنْ صِهيَونَ صوتُ النَّدْبِ: ”ويلٌ لنا، كَيفَ هَلَكْنا ولَحِقْنا العارَ لأنَّنا تَرَكْنا الأرضَ وتَهَدَّمَت مَساكِنُنا“.<verse eid="JER 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="JER 9:19" />فاَسمَعْنَ أيَّتُها النِّساءُ كَلِمَةَ الرّبِّ،</para>
  <para style="p" vid="JER 9:19">ولْتَقْبَلْ آذانُكُنَّ كَلِمَةَ فَمِهِ!</para>
  <para style="p" vid="JER 9:19">عَلِّمنَ بَناتِكُنَّ النَّحيبَ،</para>
  <para style="p" vid="JER 9:19">وصاحِباتِكُنَّ كَيفَ يكونُ الرِّثاءُ.<verse eid="JER 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="JER 9:20" />فالموتُ يصعَدُ إلى نَوافِذِنا</para>
  <para style="p" vid="JER 9:20">ويدخُلُ قُصورَنا الجميلةَ!</para>
  <para style="p" vid="JER 9:20">يكتَسِحُ الأطفالَ في الشَّوارِعِ</para>
  <para style="p" vid="JER 9:20">معَ الشُّبَّانِ في السَّاحاتِ.<verse eid="JER 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="JER 9:21" />وتَسقُطُ جُثَثُ البشَرِ</para>
  <para style="p" vid="JER 9:21">كالزِّبْلِ على وجهِ الحُقولِ،</para>
  <para style="p" vid="JER 9:21">كالحِزمَةِ وراءَ الحاصِدِ</para>
  <para style="p" vid="JER 9:21">ولا يكونُ مَنْ يَلتَقِطُ.</para>
  <para style="p" vid="JER 9:21">هكذا قالَ ليَ الرّبُّ.<verse eid="JER 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="JER 9:22" />وقالَ الرّبُّ: ”لا يَفتَخرِ الحكيمُ بِحِكمتِهِ، ولا الجبَّارُ بِجَبَروتِهِ، ولا الغنيُّ بِغِناهُ. <verse eid="JER 9:22" /><verse number="23" style="v" pubnumber="23" sid="JER 9:23" />بل مَنْ يَفتَخِرْ فليَفْتَخِرْ بِمَعرِفَتي ويفهَمْ أنِّي أنا الرّبُّ مَصدَرُ الرَّحمةِ والحُكْمِ والعَدلِ في الأرضِ. بِمِثْلِ هؤلاءِ أرضى يقولُ الرّبُّ.<verse eid="JER 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="JER 9:24" />”وستَأْتي أيّامٌ يقولُ الرّبُّ أُعاقِبُ فيها المَختونينَ بِالجسَدِ معَ غَيرِ المَختونينَ مِنْ <verse eid="JER 9:24" /><verse number="25" style="v" pubnumber="25" sid="JER 9:25" />أهلِ مِصْرَ ويَهوذا وأدومَ وعَمُّونَ ومُوآبَ ومِنْ مَقصوصي الشَّعرِ السَّاكِنينَ في الباديةِ فإذا كانَ كُلُّ هؤلاءِ الأمَمِ غَيرَ مَختونينَ بالجسَدِ، فكُلُّ بَيتِ إِسرائيلَ غَيرُ مَختونينَ بِالقلبِ“.<verse eid="JER 9:25" /></para>
  <chapter eid="JER 9" />
  <chapter number="10" style="c" sid="JER 10" />
  <para style="s1">الله الحي والأصنام</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 10:1" />إسمَعوا ما تَكلَّمَ بهِ الرّبُّ علَيكُم يا بَيتَ إِسرائيلَ: <verse eid="JER 10:1" /><verse number="2" style="v" pubnumber="2" sid="JER 10:2" />”لا تتَعَلَّموا طريقةَ الأمَمِ، ولا تَفزَعوا مِنْ عَجائِبِ السَّماواتِ. الأمَمُ وَحدَها تَرتَعِبُ مِنها <verse eid="JER 10:2" /><verse number="3" style="v" pubnumber="3" sid="JER 10:3" />لأنَّ دِيانةَ الأمَمِ باطِلةٌ، فما إلهُهُم إلَّا شجَرَةً تُقْطَعُ مِنَ الغابةِ وتَصنَعُها يَدُ النَّجَّارِ بِالقَدُّومِ <verse eid="JER 10:3" /><verse number="4" style="v" pubnumber="4" sid="JER 10:4" />وتُزَيَّنُ بِالفِضَّةِ والذَّهَبِ وتُطَرَّقُ وتُسَمَّرُ لِئلَّا تتَحَرَّكَ. <verse eid="JER 10:4" /><verse number="5" style="v" pubnumber="5" sid="JER 10:5" />فتكونُ كالفَزَّاعَةِ في المَزرَعةِ، لا تَنطِقُ ولا تَمشي فتُحمَلُ. فلا تَخافوها لأنَّها لا تَضُرُّ ولا تَنفَعُ“.<verse eid="JER 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="JER 10:6" />لا نَظيرَ لكَ يا ربُّ،</para>
  <para style="p" vid="JER 10:6">عظيمٌ أنتَ، عظيمٌ اَسمُكَ الجبَّارُ.<verse eid="JER 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="JER 10:7" />مَنْ لا يَهابُكَ يا مَلِكَ الشُّعوبِ؟</para>
  <para style="p" vid="JER 10:7">فمَهابَتُكَ تَليقُ بِكَ.</para>
  <para style="p" vid="JER 10:7">بَينَ جميعِ حُكَماءِ الشُّعوبِ،</para>
  <para style="p" vid="JER 10:7">وفي المَمالِكِ كُلِّها لا نَظيرَ لكَ.<verse eid="JER 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="JER 10:8" />أغبياءُ هُم وحَمقى،</para>
  <para style="p" vid="JER 10:8">فماذا يتَعَلَّمونَ مِنَ الخشَبِ<verse eid="JER 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="JER 10:9" />مِنَ الفِضَّةِ المُطَرَّقَةِ مِنْ تَرشيشَ</para>
  <para style="p" vid="JER 10:9">والذَّهَبِ المَجلُوبِ مِنْ أُوفازَ؟</para>
  <para style="p" vid="JER 10:9">فأصنامُهُم صَنْعَةُ يَدِ الصَّائِغِ.</para>
  <para style="p" vid="JER 10:9">لِباسُها اللَّيلَكُ والأُرْجوانُ،</para>
  <para style="p" vid="JER 10:9">صَنَعَها أمهَرُ الصُّنَّاعِ.<verse eid="JER 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="JER 10:10" />لَكنَّ الرّبَّ هوَ الإلهُ الحَقُّ،</para>
  <para style="p" vid="JER 10:10">الإلهُ الحَيُّ والمَلِكُ الأزَليُّ.</para>
  <para style="p" vid="JER 10:10">مِنْ سُخْطِهِ تتَزلزَلُ الأرضُ،</para>
  <para style="p" vid="JER 10:10">والأمَمُ لا تتَحَمَّلُ غضَبَهُ.<verse eid="JER 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JER 10:11" />وهذا ما تقولُهُ لهُم: ”الآلِهَةُ الّتي لم تَصنَعِ السَّماواتِ والأرضَ تَبيدُ مِنَ الأرضِ ومِنْ تَحتِ هذِهِ السَّماواتِ“.<verse eid="JER 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="JER 10:12" />الرّبُّ صنَعَ الأرضَ بِقُوَّتِهِ.</para>
  <para style="p" vid="JER 10:12">ثَبَّتَ العالَمَ بِالحِكمةِ</para>
  <para style="p" vid="JER 10:12">وبَسَطَ السَّماواتِ بِفِطنَتِهِ.<verse eid="JER 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="JER 10:13" />بِصوتِهِ يَجمَعُ مياهًا في السَّماءِ</para>
  <para style="p" vid="JER 10:13">ويُطلِعُ السَّحابَ مِنْ أقصى الأرضِ.</para>
  <para style="p" vid="JER 10:13">يُحدِثُ البُروقَ لِلمَطَرِ</para>
  <para style="p" vid="JER 10:13">ويُخرِجُ الرِّيحَ مِنْ خزائِنِه.<verse eid="JER 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="JER 10:14" />مَنْ يَعرِفْ ذلِكَ يَحِسّ بِالغباءِ</para>
  <para style="p" vid="JER 10:14">وكُلُّ صائِغٍ يَخجَلُ بِتِمثالِهِ،</para>
  <para style="p" vid="JER 10:14">لأنَّهُ زُورٌ ولا رُوحَ فيهِ،<verse eid="JER 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="JER 10:15" />هوَ باطِلٌ وصَنعَةٌ مُضحِكَةٌ،</para>
  <para style="p" vid="JER 10:15">ويومَ عِقابِ الرّبِّ يَبيدُ.<verse eid="JER 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="JER 10:16" />ما هكذا إلهُ يَعقوبَ،</para>
  <para style="p" vid="JER 10:16">لأنَّهُ صَوَّرَ الأكوانَ جميعًا.</para>
  <para style="p" vid="JER 10:16">الرّبُّ القديرُ اَسمُهُ</para>
  <para style="p" vid="JER 10:16">وإسرائيلُ شعبُهُ المُختارُ.<verse eid="JER 10:16" /></para>
  <para style="s1">النكبة الآتية</para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="JER 10:17" />لِمِّي بُقْجَتَكِ مِنَ الأرضِ،</para>
  <para style="p" vid="JER 10:17">أيَّتُها القاعِدةُ تَحتَ الحِصارِ!<verse eid="JER 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="JER 10:18" />فهذا ما قالَ الرّبُّ:</para>
  <para style="p" vid="JER 10:18">”سأقذِفُ سُكَّانَ هذِهِ الأرضِ</para>
  <para style="p" vid="JER 10:18">إلى بعيدٍ هذِهِ المَرَّةَ،</para>
  <para style="p" vid="JER 10:18">وأُضيِّقُ علَيهِم حتّى يَهجُروا“.<verse eid="JER 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="JER 10:19" />ويلٌ لي على اَنسحاقي.</para>
  <para style="p" vid="JER 10:19">جِراحي لا شِفاءَ مِنها.</para>
  <para style="p" vid="JER 10:19">لَكِنَّني قُلتُ لِنَفسي:</para>
  <para style="p" vid="JER 10:19">لي قُدرَةٌ على اَحتِمالِها.<verse eid="JER 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="JER 10:20" />خَيمَتي دُمِّرت تَدميرًا</para>
  <para style="p" vid="JER 10:20">وقُطِعَت جميعُ حِبالِها.</para>
  <para style="p" vid="JER 10:20">بَنيَّ ذهَبوا عَنِّي</para>
  <para style="p" vid="JER 10:20">ولا وُجودَ لهُم.</para>
  <para style="p" vid="JER 10:20">فَمَنْ يَمُدُّ خَيمَتي مِنْ بَعدُ،</para>
  <para style="p" vid="JER 10:20">ويَرفَعُ لي سَتائِرَها؟<verse eid="JER 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="JER 10:21" />رُعاةُ شعبِنا أغبياءُ</para>
  <para style="p" vid="JER 10:21">ولا يَطلُبونَ الرّبَّ.</para>
  <para style="p" vid="JER 10:21">لذلِكَ لم يَنجَحوا.</para>
  <para style="p" vid="JER 10:21">وجميعُ رَعيَّتِهِم تَبَدَّدَت.<verse eid="JER 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="JER 10:22" />ها صوتُ شائِعَةٍ يُسمَعُ</para>
  <para style="p" vid="JER 10:22">وضَجيجٌ مِنْ أرضِ الشِّمالِ:</para>
  <para style="p" vid="JER 10:22">إجعَلوا مُدُنَ يَهوذا دمارًا</para>
  <para style="p" vid="JER 10:22">ومَأوى لِبناتِ آوى.<verse eid="JER 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="JER 10:23" />يا ربُّ أعرِفُ أنَّ البشَرَ</para>
  <para style="p" vid="JER 10:23">عاجِزونَ عَنْ رَسمِ طريقِهِم</para>
  <para style="p" vid="JER 10:23">وتَسديدِ خُطواتِهِم بِأنفُسِهِم.<verse eid="JER 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="JER 10:24" />أدِّبْ شعبَكَ لَكِنْ بِإنصافٍ،</para>
  <para style="p" vid="JER 10:24">لا بِغضَبٍ لِئلَّا تُبيدَهُم.<verse eid="JER 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="JER 10:25" />بل أفرِغْ غضَبَكَ على الأُمَمِ،</para>
  <para style="p" vid="JER 10:25">أولَئِكَ الّذينَ لا يَعرِفونَكَ،</para>
  <para style="p" vid="JER 10:25">أوِ الّذينَ لا يُدعَونَ باَسمِكَ،</para>
  <para style="p" vid="JER 10:25">أنَّهُم أكَلوا بَني يَعقوبَ،</para>
  <para style="p" vid="JER 10:25">أفنَوهُم ودَمَّروا مَساكِنَهُم.<verse eid="JER 10:25" /></para>
  <chapter eid="JER 10" />
  <chapter number="11" style="c" sid="JER 11" />
  <para style="s1">عقاب خيانة العهد</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 11:1" />وقالَ الرّبُّ لإرميا: <verse eid="JER 11:1" /><verse number="2" style="v" pubnumber="2" sid="JER 11:2" />”إسمَعْ كَلِماتِ العَهدِ الّذي عاهَدْتُ بهِ آباءَكُم، وكَلِّمْ يَهوذا وسُكَّانَ أُورُشليمَ: <verse eid="JER 11:2" /><verse number="3" style="v" pubnumber="3" sid="JER 11:3" />”هذا ما قالَ الرّبُّ إلهُ إِسرائيلَ: مَلعونٌ مَنْ لا يَسمَعُ كَلِماتِ هذا العَهدِ <verse eid="JER 11:3" /><verse number="4" style="v" pubnumber="4" sid="JER 11:4" />الّذي أمَرتُ بهِ آباءَكُم يومَ أخرجتُهُم مِنْ أرضِ مِصْرَ، مِنْ أتونِ النَّارِ وقُلتُ: إِسمَعوا لِصوتي واَعمَلوا بِوَصايايَ، فتكونوا لي شعبًا وأكونَ لكُم إلهًا، <verse eid="JER 11:4" /><verse number="5" style="v" pubnumber="5" sid="JER 11:5" />لأُقيمَ الحِلْفَ الّذي حلَفْتُ لآبائِكُم أنْ أُعطيَهُم أرضًا تَفيضُ لبنًا وعسَلًا كما في هذا اليومِ“. فأجبتُ: آمين يا ربُّ!“<verse eid="JER 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="JER 11:6" />فقالَ ليَ الرّبُّ: ”أخبِرْ بِكُلِّ هذا الكلامِ في مُدُنِ يَهوذا وفي شوارعِ أورُشليمَ وقُلْ: إِسمَعوا كَلِماتِ هذا العَهدِ واَعمَلوا بِها. <verse eid="JER 11:6" /><verse number="7" style="v" pubnumber="7" sid="JER 11:7" />فحينَ أخرَجْتُ آباءَكُم مِنْ أرضِ مِصْرَ أنذَرْتُهُم بِغيرِ اَنقطاعٍ، ولا أزالُ أُنذِرُهُم إلى هذا اليومِ، أنْ يَسمَعوا لِصوتي. <verse eid="JER 11:7" /><verse number="8" style="v" pubnumber="8" sid="JER 11:8" />فما سَمِعوا ولا أمالوا آذانَهُم، بل سارَ كُلُّ واحدٍ حسَبَ نيَّاتِ قلبِهِ الشِّرِّيرِ، فجَلَبْتُ علَيهِم كُلَّ شُرورِ هذا العَهدِ الّذي أمَرتُ بِالعَمَلِ بهِ وما عمِلوا“.<verse eid="JER 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="JER 11:9" />وقالَ لي الرّبُّ: ”تمَرَّدَ عليَّ رِجالُ يَهوذا وسُكَّانُ أورُشليمَ <verse eid="JER 11:9" /><verse number="10" style="v" pubnumber="10" sid="JER 11:10" />ورَجَعوا إلى ذُنوبِ آبائِهِمِ الأوَّلينَ الّذينَ رَفَضوا أنْ يَسمَعوا لِكَلِماتي، فاَتَّبَعوا آلِهَةً أخرى لِيَعبُدوها. ونقَضَ بَيتُ إِسرائيلَ وبَيتُ يَهوذا ذلِكَ العَهدَ الّذي عاهَدْتُ بهِ آباءَهُم. <verse eid="JER 11:10" /><verse number="11" style="v" pubnumber="11" sid="JER 11:11" />لذلِكَ سَأجلِبُ علَيهِم شَرًّا لا يَقدِرونَ أنْ يَنجوا مِنهُ، فيَصرُخونَ إليَّ ولا أسمَعُ لهُم. <verse eid="JER 11:11" /><verse number="12" style="v" pubnumber="12" sid="JER 11:12" />فيذهَبُ أهالي مُدُنِ يَهوذا وسُكَّانُ أورُشليمَ إلى الآلِهَةِ الّتي يَحرقونَ لها البَخورَ ويَصرُخونَ إليها فلا تُخَلِّصهُم في وقتِ ضيقِهِم، <verse eid="JER 11:12" /><verse number="13" style="v" pubnumber="13" sid="JER 11:13" />معَ أنَّ آلِهَتَكَ يا يَهوذا كانَت على عدَدِ مُدُنِكَ، وعلى عدَدِ شوارعِ أورُشليمَ نَصبتُم يا سُكَّانَ أُورُشليمَ مَذابِحَ لِلعارِ، مَذابِحَ للتَّبخيرِ لِلبَعلِ. <verse eid="JER 11:13" /><verse number="14" style="v" pubnumber="14" sid="JER 11:14" />وأنتَ يا إرميا لا تتَضَرَّعْ عَنْ هذا الشَّعبِ ولا تَرفَعْ لأجلِهِم دُعاءً ولا صلاةً، فَلَنْ أسمَعَ صُراخَهُم إليَّ وقتَ ضيقِهِم. <verse eid="JER 11:14" /><verse number="15" style="v" pubnumber="15" sid="JER 11:15" />أيُّ حقٍّ لأمَّتي الحبيبةِ في بَيتي إذا هيَ عَمِلَت شَرًّا؟ أتَظنُّ أنَّ النُّذورَ والذَّبائِحَ المُقَدَّسةَ تَدفعُ عَنها الهَلاكَ؟ أو أنَّها بذلِكَ تكونُ سعيدةً؟“<verse eid="JER 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="JER 11:16" />فإذا كانَ الرّبُّ سَمَّاكِ مرَّةً زيتونةً خضراءَ جميلةً شَهِيَّةَ الثَّمَرِ، فهوَ بِهَبَّةِ ريحٍ عاصفةٍ يُضرِمُ فيكِ النَّارَ فتَلتَهِمُ أغصانَكِ. <verse eid="JER 11:16" /><verse number="17" style="v" pubnumber="17" sid="JER 11:17" />وإذا كانَ الرّبُّ القديرُ الّذي غرَسَكِ تَكَلَّمَ علَيكِ شَرًّا فَلأنَّ بَيتَ إسرائيلَ وبَيتَ يَهوذا فعَلوا الشَّرَّ ليُغيظوهُ بِتَبخيرهِم لِلبَعلِ.<verse eid="JER 11:17" /></para>
  <para style="s1">مكيدة اغتيال إرميا</para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="JER 11:18" />أعلَمَني الرّبُّ فَعَلِمْتُ، وأراني فرَأيتُ أعمالَهُم. <verse eid="JER 11:18" /><verse number="19" style="v" pubnumber="19" sid="JER 11:19" />كُنتُ أنا كخَروفٍ وديعٍ يُساقُ إلى الذَّبحِ ولا عِلْمَ لي أنَّهُم كادوا لي مَكيدةً. قالوا: لِنُتْلِفِ الشَّجرةَ معَ ثَمَرِها! لِنَقطَعْهُ مِنْ أرضِ الأحياءِ ولا يُذكَرِ اَسمُهُ مِنْ بَعدُ!“<verse eid="JER 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="JER 11:20" />فيا ربَّنا القديرَ الّذي يَحكُمُ بِالعَدلِ ويَفحَصُ المَشاعِرَ والأفكارَ دَعْني أرى انتِقامَكَ منِهُم. فإليكَ رفَعتُ دَعوايَ.<verse eid="JER 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="JER 11:21" />فقالَ الرّبُّ على رِجالِ عناتوتَ الّذينَ يَطلُبونَ حياتي ويقولونَ لا تتَنَبَّأْ لِئلَّا تموتَ بِأيدينا: <verse eid="JER 11:21" /><verse number="22" style="v" pubnumber="22" sid="JER 11:22" />”أنا الرّبُّ القديرُ أُعاقِبُهُم، فيموتُ الشُبَّانُ مِنهُم بِالسَّيفِ وبَنوهُم وبَناتُهُم بِالجوعِ <verse eid="JER 11:22" /><verse number="23" style="v" pubnumber="23" sid="JER 11:23" />لأنِّي يومَ أعاقِبُهُم سَأجلِبُ علَيهِم شَرًّا ولا تَبقى مِنهُم بَقيَّةٌ“.<verse eid="JER 11:23" /></para>
  <chapter eid="JER 11" />
  <chapter number="12" style="c" sid="JER 12" />
  <para style="s1">حوار مع الرب</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 12:1" />عادِلٌ أنتَ يا ربُّ وإنْ حاجَجْتُكَ لكِنِّي أُكَلِّمُكَ بِما هوَ حَقٌّ. لماذا تَنجَحُ طريقُ الأشرارِ ويَسعَدُ الغادِرونَ جميعًا؟ <verse eid="JER 12:1" /><verse number="2" style="v" pubnumber="2" sid="JER 12:2" />أنتَ غرَسْتَهُم فتَأصَّلوا ونَمَوا وأثمَروا. أنتَ قريبٌ مِنْ أفواهِهِم وبعيدٌ عَنْ قُلوبِهِم. <verse eid="JER 12:2" /><verse number="3" style="v" pubnumber="3" sid="JER 12:3" />أنتَ عرَفتَني ورَأيتَني واَمتَحنتَ قلبي نحوكَ. أفرِزْهُم كغَنَمٍ لِلذَّبحِ، وخَصِّصْهُم لِيومِ القَتْلِ.<verse eid="JER 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="JER 12:4" />إلى متى تَنوحُ الأرضُ ويَيبَسُ العُشْبُ في كُلِّ حَقلٍ وتَهلِكُ البَهائِمُ والطُّيورُ مِنْ شَرِّ السَّاكنينَ فيها، القائِلينَ: اللهُ لا يرَى ما نَفعَلُ؟<verse eid="JER 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="JER 12:5" />تَجري معَ المُشاةِ فتَتعَبُ، فكَيفَ تُسابِقُ الفُرسانَ؟ وإنْ كُنتَ تَتعَبُ في أرضِ الأمانِ، فكَيفَ تَفعَلُ في غَورِ الأردُنِّ؟ <verse eid="JER 12:5" /><verse number="6" style="v" pubnumber="6" sid="JER 12:6" />إنْ كانَ إخوتُكَ وأهلُ بَيتِ أبيكَ يَغدُرونَ بِكَ ويَصرُخونَ ورَاءَكَ بِملءِ أفواهِهِم، فكَيفَ تَأتَمِنُهُم إذا كَلَّموكَ بِالخيرِ؟<verse eid="JER 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="JER 12:7" />تَركتُ بَيتي وهَجَرْتُ أرضي، وسلَّمتُ مَحبوبَتي إلى أيدي أعدائِها <verse eid="JER 12:7" /><verse number="8" style="v" pubnumber="8" sid="JER 12:8" />صارَ لي شعبي كأسدٍ في الغابةِ، رفَعَ عليَّ صوتَهُ فكَرِهتُهُ. <verse eid="JER 12:8" /><verse number="9" style="v" pubnumber="9" sid="JER 12:9" />أيكونُ شعبي طَيرًا مُلَوَّنَ الرِّيشِ تُهاجِمُهُ الطُّيورُ الكاسِرةُ مِنْ كُلِّ جِهَةٍ؟ هيَّا تَجَمَّعي يا جميعَ وحوشِ الصَّحراءِ وتعالَي اَشتَركي في الوليمةِ!<verse eid="JER 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="JER 12:10" />رُعاةٌ كثيرونَ أفسَدوا كَرْمي وداسوا ميراثي الخَصيبَ وجعَلوهُ قَفْرًا خَرِبًا. <verse eid="JER 12:10" /><verse number="11" style="v" pubnumber="11" sid="JER 12:11" />جعَلوهُ خَرابًا وعُرضَةً لِلنُّواحِ. صارَ خَرابًا. الأرضُ كُلُّها خَرابٌ لأنَّ لا أحدَ يَهتَمُّ بِها في قلبِهِ. <verse eid="JER 12:11" /><verse number="12" style="v" pubnumber="12" sid="JER 12:12" />على جميعِ الرَّوابي في البرِّيَّةِ زحَفَ النَّاهبونَ، لأنَّ لِلرّبِّ سيفًا يأكلُ مِنْ أقصى الأرضِ إلى أقصاها، ولا سلامٌ لأحدٍ.<verse eid="JER 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="JER 12:13" />زَرَعوا حِنطَةً فحَصَدوا شَوكًا، تَعِبوا وما اَنتَفَعوا. تَلِفَت غَلَّاتُهُم لأنَّ الرّبَّ مِنْ حِدَّةِ غضَبِهِ حرَمَهُم مِنها.<verse eid="JER 12:13" /></para>
  <para style="s1">وعيد الرّبّ لجيران إسرائيل</para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="JER 12:14" />وقالَ الرّبُّ على الجيرانِ الأشرارِ الّذينَ يعتَدونَ على الأرضِ الّتي أعطاها لِشعبِهِ إسرائيلَ: ”سأقتَلِعُهُم مِنْ أرضِهِم وأقتَلِعُ بَيتَ يَهوذا مِنْ بَينِهِم. <verse eid="JER 12:14" /><verse number="15" style="v" pubnumber="15" sid="JER 12:15" />وبَعدَ أنْ أقتَلِعَهُم أعودُ وأرحَمُهُم وأُعيدُهُم كُلًا إلى ميراثِهِ وإلى أرضِهِ. <verse eid="JER 12:15" /><verse number="16" style="v" pubnumber="16" sid="JER 12:16" />فإنْ تَعَلَّموا جيِّدًا طُرُقَ شعبي وحَلَفوا بِاَسمي حَيٌّ هوَ الرّبُّ كما عَلَّموا شعبي أن يَحلِفوا بِالبَعلِ، فهُم يُقيمونَ في وسَطِ شعبي. <verse eid="JER 12:16" /><verse number="17" style="v" pubnumber="17" sid="JER 12:17" />وإلَّا فإنِّي أقتَلِعُهُمُ اَقتِلاعًا وأبيدُهُم يقولُ الرّبُّ“.<verse eid="JER 12:17" /></para>
  <chapter eid="JER 12" />
  <chapter number="13" style="c" sid="JER 13" />
  <para style="s1">حزام الكتان</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 13:1" />وقالَ ليَ الرّبُّ: ”إِذهَبْ واَشتَرِ لكَ حِزامًا مِنْ كَتَّانٍ واَشدُدْهُ على وسطِكَ ولا تَضَعْهُ في الماءِ“. <verse eid="JER 13:1" /><verse number="2" style="v" pubnumber="2" sid="JER 13:2" />فاَشتَريتُ الحِزامَ، كما قالَ الرّبُّ، وشدَدْتُهُ على وسطي.<verse eid="JER 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="JER 13:3" />ثُمَّ قالَ ليَ الرّبُّ: <verse eid="JER 13:3" /><verse number="4" style="v" pubnumber="4" sid="JER 13:4" />”خُذِ الحِزامَ الّذي اَشتَريتَهُ وشَدَدْتَهُ على وسطِكَ، وقُمِ اَذهَبْ إلى وادي الفارَةِ وخَبِّئْهُ هُناكَ في شِقِّ الصَّخرِ“. <verse eid="JER 13:4" /><verse number="5" style="v" pubnumber="5" sid="JER 13:5" />فذَهَبتُ وخَبَّأتُهُ في وادي الفارَةِ كما أمرَني الرّبُّ.<verse eid="JER 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="JER 13:6" />وبَعدَ أيّامٍ كثيرةٍ قالَ ليَ الرّبُّ: ”قُمِ اَذهَبْ إلى وادي الفارَةِ وخُذِ الحِزامَ الّذي أمَرْتُكَ أنْ تُخفيَهُ هُناكَ“. <verse eid="JER 13:6" /><verse number="7" style="v" pubnumber="7" sid="JER 13:7" />فذَهَبْتُ إلى وادي الفارَةِ وحفَرْتُ وأخَذتُ الحِزامَ مِنَ المَوضعِ الّذي خَبَّأْتُهُ فيهِ، فإذا هوَ فاسِدٌ لا يَصلحُ لِشَيءٍ.<verse eid="JER 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="JER 13:8" />فقالَ ليَ الرّبُّ: <verse eid="JER 13:8" /><verse number="9" style="v" pubnumber="9" sid="JER 13:9" />”كما فسَدَ الحِزامُ أُفسِدُ كِبرياءَ يَهوذا وكِبرياءَ أُورُشليمَ العظيمةِ. <verse eid="JER 13:9" /><verse number="10" style="v" pubnumber="10" sid="JER 13:10" />وهذا الشَّعبُ الشِّرِّيرُ الّذي يرفُضُ أنْ يسمَعَ لِكَلامي ويَسيرَ حسَبَ نيَّاتِ قلبِهِ ويَتبَعَ آلِهَةً أُخرى ليَعبُدَها ويَسجُدَ لها يكونُ كالحِزامِ الّذي لا يَصلحُ لِشيءٍ. <verse eid="JER 13:10" /><verse number="11" style="v" pubnumber="11" sid="JER 13:11" />فكما أنَّ الحِزامَ يَلتَصِقُ بِوَسطِ الإنسانِ، كذلِكَ ألصَقتُ بي جميعَ بَيتِ إِسرائيلَ وجميعَ بَيتِ يَهوذا لِيَكونوا لي شعبًا وإسمًا وفَخرًا ومَجدًا، ولَكِنَّهُم رفَضوا أنْ يَسمَعوا.<verse eid="JER 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="JER 13:12" />”فتقولُ لهُم هذا الكلامَ: كُلُّ دَنٍّ يمتَلِئُ خمرًا، فيَقولونَ لكَ: ألا نَعرِفُ أنَّ كُلَّ دَنٍّ يَمتَلِئ خمرًا؟ <verse eid="JER 13:12" /><verse number="13" style="v" pubnumber="13" sid="JER 13:13" />فتقولُ لهُم: قالَ الرّبُّ: سأملأُ سُكرًا جميعَ سُكَّانِ هذِهِ الأرضِ، والمُلوكِ الجالسينَ على عرشِ داوُدَ والكهَنَةِ جميعًا <verse eid="JER 13:13" /><verse number="14" style="v" pubnumber="14" sid="JER 13:14" />ولا أُشفِقُ ولا أترَأّفُ ولا أرحَمُ حتّى أُهلِكَهُم“.<verse eid="JER 13:14" /></para>
  <para style="s1">تنديد بالكبرياء</para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="JER 13:15" />فاَسمَعوا وأصغوا! لا تَستَكبِروا لأنَّ الرّبَّ تَكلَّمَ. <verse eid="JER 13:15" /><verse number="16" style="v" pubnumber="16" sid="JER 13:16" />مَجِّدوا الرّبَّ إلهَكُم قَبلَ أنْ يُنشَرَ الظَّلامُ، وقَبلَ أنْ تَعثُرَ أقدامُكُم على الجِبالِ المُعتِمةِ. وفيما أنتُم تَنتَظِرونَ النُّورَ يُحَوِّلُهُ الرّبُّ إلى ظِلِّ موتٍ ويَجعَلُهُ ظَلامًا دامِسًا. <verse eid="JER 13:16" /><verse number="17" style="v" pubnumber="17" sid="JER 13:17" />فإنْ كُنتُم لا تَسمَعونَ تبْكي نَفسي في الخِفيَةِ على كِبريائِكُم وتَجري العَبَراتُ مِنْ عَينَيَّ وتَسيلُ بالدُّموعِ، لأنَّ قطيعَ الرّبِّ سِيقَ إلى السَّبْي.<verse eid="JER 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="JER 13:18" />قُلْ لِلمَلِكِ والمَلِكَةِ: أُقعُدوا الآنَ على الأرضِ لأنَّ تاجَ مَجدِكُما نَزَلَ عَنْ رأسيَكُما. <verse eid="JER 13:18" /><verse number="19" style="v" pubnumber="19" sid="JER 13:19" />أُغلِقَت مُدُنُ الجَنوبِ ولا فاتِحَ لها. سُبيَت يَهوذا بِجُملَتِها، سُبِيَت عَنْ آخِرِها.<verse eid="JER 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="JER 13:20" />إرفَعي عَينَيكِ يا أُورُشليمُ واَنظُري المُقبِلينَ مِنَ الشِّمالِ. أينَ القَطيعُ الجميلُ الّذي أُعطِيَ لَكِ؟ أينَ الغنَمُ الّذي كُنتِ فَخورَةً بهِ؟ <verse eid="JER 13:20" /><verse number="21" style="v" pubnumber="21" sid="JER 13:21" />ماذا تَقولينَ في شعبٍ حَسِبْتِهِ صديقًا، فكانَ عَدُوًّا لَكِ وحاكِمًا؟ أفَلا تَأخُذُكِ الأوجاعُ كالمرأةِ الّتي تَلِدُ؟<verse eid="JER 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="JER 13:22" />وإنْ قُلتِ في قلبِكِ: لِماذا أصابَتني هذِهِ المُصيبةُ؟ لِكَثرةِ خطاياكِ رَفَعتِ أذيالَ ثوبِكِ وبانَ كاحِلاكِ.<verse eid="JER 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="JER 13:23" />هل يُغَيِّرُ الحبَشيُّ بَشَرَتَهُ والنَّمِرُ جِلْدَهُ المُرَقَّطَ؟ إذًا تَقدِرونَ أنتُم أنْ تَصنَعوا الخيرَ وأنتُم تَعَوَّدتُمُ الشَّرَّ.<verse eid="JER 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="JER 13:24" />سَأُبَدِّدُكِ كالقشِّ في مهَبِّ ريحِ البرِّيَّةِ. <verse eid="JER 13:24" /><verse number="25" style="v" pubnumber="25" sid="JER 13:25" />هذا حظُّكِ ونصيبُكِ مِنِّي يقولُ الرّبُّ، لأنَّكِ نَسيتني وتوَكَّلْتِ على آلِهَةٍ باطِلةٍ. <verse eid="JER 13:25" /><verse number="26" style="v" pubnumber="26" sid="JER 13:26" />فأنا أيضًا رفَعتُ أذيالَ ثوبِكِ على وجهِكِ فاَنكَشَفَت عَورَتُكِ. <verse eid="JER 13:26" /><verse number="27" style="v" pubnumber="27" sid="JER 13:27" />رأيتُ أرجاسَكِ رأيتُ فِسقَكِ وصَهيلَكِ وفَحْشَ زِناكِ على التِّلالِ في البرِّيَّةِ. ويلٌ لَكِ يا أُورُشليمُ، أفلا تَطهَرينَ؟ وإلى متى؟<verse eid="JER 13:27" /></para>
  <chapter eid="JER 13" />
  <chapter number="14" style="c" sid="JER 14" />
  <para style="s1">القحط الرهيب</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 14:1" />وقالَ الرّبُّ لإرميا في شَأنِ القَحْطِ: <verse eid="JER 14:1" /><verse number="2" style="v" pubnumber="2" sid="JER 14:2" />”تَنوحُ يَهوذا وتَخورُ أبوابُها، وتَقعُدُ على التُّرابِ حزينةً ويَرتَفِعُ صُراخُ أُورُشليمَ. <verse eid="JER 14:2" /><verse number="3" style="v" pubnumber="3" sid="JER 14:3" />أشرافُها يُرسِلونَ خَدَمَهُم لِلماءِ، فيَجيئونَ إلى الآبارِ فلا يَجِدونَ ماءً، فيَرجِعونَ بِجِرارِهِم فارِغةً. فيَخزَونَ ويُغَطُّونَ رُؤوسَهُم خَجلًا“.<verse eid="JER 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="JER 14:4" />تتَشَقَّقُ الأرضُ مِنْ قِلَّةِ المطَرِ، فيَخزى الفلَّاحونَ ويُغَطُّونَ رُؤوسَهُم. <verse eid="JER 14:4" /><verse number="5" style="v" pubnumber="5" sid="JER 14:5" />تَلِدُ الغزالةُ في البرِّيَّةِ وتَترُكُ وليدَها، لأنْ لا عُشبَ هُناكَ. <verse eid="JER 14:5" /><verse number="6" style="v" pubnumber="6" sid="JER 14:6" />وحميرُ الوَحشِ تَقِفُ على الرَّوابي وتَستَنشِقُ الرِّيحَ كبناتِ آوى. فتَكِلُّ عُيونُها ولا تَجِدُ عُشْبًا.<verse eid="JER 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="JER 14:7" />معَ أنَّ آثامَنا تشهَدُ علَينا يا ربُّ، فلأجلِ اَسمِكَ ساعِدْنا. إبتَعَدْنا عَنكَ مِرارًا وإليكَ خَطِئْنا. <verse eid="JER 14:7" /><verse number="8" style="v" pubnumber="8" sid="JER 14:8" />يا رجاءَ إسرائيلَ ومُخَلِّصَها وقتَ الضِّيقِ، لِماذا تكونُ كغَريبٍ في الأرضِ، وكمُسافرٍ يَميلُ إلى مَبيتٍ. <verse eid="JER 14:8" /><verse number="9" style="v" pubnumber="9" sid="JER 14:9" />لِماذا تكونُ كالرَّجُلِ المُتَحَيِّرِ، كالجبَّارِ الّذي لا يَقدِرُ أنْ يُخَلِّصَ؟ أنتَ في وسَطِنا يا ربُّ، وبِاَسمِكَ دُعينا، فلا تَخذُلْنا؟<verse eid="JER 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="JER 14:10" />هكذا تكَلَّمَ الرّبُّ على القَحْطِ، لأنَّ هذا الشَّعبَ يُحِبُّونَ الضَّلالَ ولا يَمتَنِعونَ. فلِذلِكَ لا يَرضى الرّبُّ عَنهُم، وهوَ الآنَ يَذكُرُ آثامَهُم ويُعاقِبُهُم على خطاياهُم.<verse eid="JER 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JER 14:11" />وقالَ ليَ الرّبُّ: ”لا تُصَلِّ لأجلِ خَيرِ هذا الشَّعبِ. <verse eid="JER 14:11" /><verse number="12" style="v" pubnumber="12" sid="JER 14:12" />إذا صاموا فلا أسمَعُ صُراخَهُم، وإذا أصعَدوا مُحرَقةً وتَقدِمةً فلا أرضى عَنهُم، بل أفنيهِم بِالسَّيفِ والجُوعِ والوَباءِ“.<verse eid="JER 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="JER 14:13" />فقُلتُ: ”آهِ، يا سيِّدي الرّبُّ! الأنبياءُ يقولونَ لهُم: لا تَرونَ السَّيفَ ولا يَحِلُّ بِكُم جُوعٌ، لأنَّ الرّبَّ يَمنَحُكُم سلامًا أكيدًا في هذِهِ الدِّيارِ“.<verse eid="JER 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="JER 14:14" />فقالَ ليَ الرّبُّ: ”الأنبياءُ يتَنَبَّأونَ بِاَسمي زُورًا، فما أنا الّذي أُرسِلُهُم وآمُرُهُمْ وأُكلِّمُهُم، وإنما هُم يتَنَبَّأونَ لكُم بِرُؤيا كاذِبةٍ وبالعَرافةِ والباطِلِ وضَلالِ قُلوبِهِم. <verse eid="JER 14:14" /><verse number="15" style="v" pubnumber="15" sid="JER 14:15" />لذلِكَ هذا ما أقولُ عَنِ الأنبياءِ المُتَنَبِّئينَ بِاَسمي وأنا لم أُرسِلْهُم. هُم يقولونَ لا يكونُ في هذِهِ الأرضِ سَيفٌ ولا جُوعٌ، ولَكِنَّهُم سيَفنونَ بِالسَّيفِ والجوعِ. <verse eid="JER 14:15" /><verse number="16" style="v" pubnumber="16" sid="JER 14:16" />وأمَّا الشَّعبُ الّذينَ يتَنَبَّأُونَ لهُم، فيُطرحونَ في شوارِعِ أُورُشليمَ مِنَ الجُوعِ والسَّيفِ ولا يكونُ لهُم دافِنٌ، هُم ونِساؤهُم وبَنوهُم وبَناتُهُم، وأصُبُّ علَيهِم شَرَّهُم.<verse eid="JER 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="JER 14:17" />وتقولُ لهُم هذا الكلامَ:</para>
  <para style="p" vid="JER 14:17">لِتَسِلْ عَينايَ بِالدُّموعِ</para>
  <para style="p" vid="JER 14:17">ليلًا ونهارًا بِغَيرِ انقِطاعٍ،</para>
  <para style="p" vid="JER 14:17">لأنَّ العذراءَ بِنْتَ شعبي</para>
  <para style="p" vid="JER 14:17">أُصيبَت بِجُرْحٍ بَليغٍ،</para>
  <para style="p" vid="JER 14:17">بِضربةٍ لا شِفاءَ مِنها.<verse eid="JER 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="JER 14:18" />إنْ خَرَجْتُ إلى البرِّيَّةِ</para>
  <para style="p" vid="JER 14:18">رأيتُ القتلى بِالسَّيفِ،</para>
  <para style="p" vid="JER 14:18">وإنْ دخَلْتُ إلى المدينةِ</para>
  <para style="p" vid="JER 14:18">رأيتُ المرضى بِالجُوعِ.</para>
  <para style="p" vid="JER 14:18">حتّى النَّبيُّ والكاهنُ يَطوفانِ في الأرضِ</para>
  <para style="p" vid="JER 14:18">ولا يَعرِفانِ ماذا يَفعلانِ.<verse eid="JER 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="JER 14:19" />هل رفَضْتَ يَهوذا رَفْضًا</para>
  <para style="p" vid="JER 14:19">وعافَت نفسُكَ صِهيونَ؟</para>
  <para style="p" vid="JER 14:19">لِماذا ضرَبتَنا ولا شِفاءَ لنا؟</para>
  <para style="p" vid="JER 14:19">نَنتَظِرُ السَّلامَ لَكِنْ عبَثًا</para>
  <para style="p" vid="JER 14:19">ووقتَ الشِّفاءِ فإذا الرُّعبُ.<verse eid="JER 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="JER 14:20" />نَعتَرِفُ بِشَرِّنا وإثْمِ آبائِنا</para>
  <para style="p" vid="JER 14:20">لأنَّنا يا ربُّ خَطِئنا إليكَ.<verse eid="JER 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="JER 14:21" />لا تَرفُضْنا إكرامًا لاَسمِكَ</para>
  <para style="p" vid="JER 14:21">ولا تُهِنْ عرشَكَ المجيدَ.</para>
  <para style="p" vid="JER 14:21">أُذْكُرْ ولا تَنقُضْ عَهدَكَ معَنا.<verse eid="JER 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="JER 14:22" />هل بَينَ أصنامِ الأمَمِ مَنْ يُمطِرُ؟</para>
  <para style="p" vid="JER 14:22">أم هلِ السَّماواتُ تُرسِلُ الغَيثَ؟</para>
  <para style="p" vid="JER 14:22">أما أنتَ هوَ الرّبُّ إلَهُنا الّذي نَرجوهُ،</para>
  <para style="p" vid="JER 14:22">لأنَّكَ أنتَ تَعمَلُ ذلِكَ كُلَّهُ.<verse eid="JER 14:22" /></para>
  <chapter eid="JER 14" />
  <chapter number="15" style="c" sid="JER 15" />
  <para style="s1">الويل لشعب يهوذا</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 15:1" />وقالَ ليَ الرّبُّ: ”لو أنَّ موسى وصَموئيلَ تَشَفَّعا أمامي لَما اَلتَفَتَ قلبي إلى هذا الشَّعبِ. فأطرَحُهُم عَنْ وجهي خارِجًا. <verse eid="JER 15:1" /><verse number="2" style="v" pubnumber="2" sid="JER 15:2" />وإذا قالوا لكَ: إلى أينَ نخرُجُ؟ فأجِبهُم: هذا ما قالَ الرّبُّ:</para>
  <para style="p" vid="JER 15:2">الّذينَ لِلوَباءِ فإلى الوَباءِ،</para>
  <para style="p" vid="JER 15:2">والّذينَ لِلسَّيفِ فإلى السَّيفِ.</para>
  <para style="p" vid="JER 15:2">الّذينَ لِلجوعِ فإلى الجوعِ،</para>
  <para style="p" vid="JER 15:2">والّذينَ لِلسَّبْيِ فإلى السَّبْيِ.<verse eid="JER 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="JER 15:3" />”وأُوكِلُ بِهم أربَعةَ أصنافٍ مِنْ أدواتِ الموتِ: السَّيفَ لِلقَتلِ، والكِلابَ لِلتَّمزيقِ، وطَيرَ السَّماءِ ووُحوشَ الأرضِ لِلأكلِ والإفناءِ. <verse eid="JER 15:3" /><verse number="4" style="v" pubnumber="4" sid="JER 15:4" />وأجعَلُهُم عِبْرةً رهيبَةً لِمَن يَعتَبِرُ في جميعِ مَمالِكِ الأرضِ، جزاءَ ما فعَلَهُ منَسَّى بنُ حزَقيَّا مَلِكُ يَهوذا في أُورُشليمَ.<verse eid="JER 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="JER 15:5" />”فَمَنْ يُشفِقُ علَيكِ يا أُورُشليمُ ومَنْ يُعَزِّيكِ؟ ومَنْ يَميلُ لِيَسألَ عَنْ سلامَتِكِ؟ <verse eid="JER 15:5" /><verse number="6" style="v" pubnumber="6" sid="JER 15:6" />تَرَكتِني واَرتَدَدْتِ عنِّي يقولُ الرّبُّ. فأمُدُّ يَدي علَيكِ وأُهلِكُكِ. فأنا مَلَلْتُ مِنَ العفوِ عَنكِ.<verse eid="JER 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="JER 15:7" />”ذرَّيتُ شعبي بِالمِذراةِ إلى أبوابِ الأرضِ. أثكَلْتُهُم وأبَدتُهُم وما رَجَعوا عَنْ طُرُقِهِم. <verse eid="JER 15:7" /><verse number="8" style="v" pubnumber="8" sid="JER 15:8" />جَعَلْتُ أرامِلَهُم أكثرَ مِنْ رملِ البِحارِ، وجَلَبْتُ لأُمَّهاتِ شُبَّانِهِم مَنْ أهلَكَهُم عِندَ الظَّهيرةِ، وأوقَعْتُ علَيهِم بَغتةً كُلَّ هَولٍ ورُعْبٍ.<verse eid="JER 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="JER 15:9" />”تَراخَت والِدَةُ السَّبعةِ وفاضَت روحُها. غابَت شمسُها في عِزِّ النَّهارِ، فلَحِقَها الخِزْيُ والعارُ. وسأدفَعُ بَقيَّةَ شعبي إلى السَّيفِ أمامَ أعدائِهِم يقولُ الرّبُّ“.<verse eid="JER 15:9" /></para>
  <para style="s1">شكوى إرميا</para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="JER 15:10" />ويلٌ لي يا أُمِّي لأنَّكِ ولَدْتِني. في خِصامٍ ونِزاعٍ أنا. لا أقرِضُ ولا أستَقرِضُ، وكُلُّ واحدٍ يَلعَنُني.<verse eid="JER 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JER 15:11" />فلتَكُنِ اللَّعنةُ عليَّ يا ربُّ إنْ كُنتُ لم أتضَرَّعْ إليكَ لِخَيرِ عَدُوِّي في أوانِ الضِّيقِ ووقتِ الشِّدةِ. <verse eid="JER 15:11" /><verse number="12" style="v" pubnumber="12" sid="JER 15:12" />ولَكِنْ مَنْ يَقدِرُ أنْ يَكسِرَ سِلاحَ الحديدِ والنُّحاسِ الآتي مِنَ الشِّمالِ!<verse eid="JER 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="JER 15:13" />سأدفَعُ غِنَى شعبي وكُنوزَهُ نَهْبًا بِلا ثمَنٍ عِقابًا لَه على كُلِّ خطاياهُ في جميعِ أرضِهِ. <verse eid="JER 15:13" /><verse number="14" style="v" pubnumber="14" sid="JER 15:14" />وأجعَلُهُ عَبدًا لأعدائِهِ في أرضٍ لا يَعرِفُها، لأنَّ غضَبي أوقَدَ نارًا ستَشتَعِلُ إلى الأبدِ.<verse eid="JER 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="JER 15:15" />فيا ربُّ، أنتَ تَعرِفُني. فاذكُرْني وتفَقَّدْني واَنتَقِمْ لي مِمَّنْ يضطَهِدونَني. لا تَأخُذْهُم بِطولِ حِلْمِكَ، واَعلَم أنِّي لأجلِكَ اَحتمَلتُ التَّعييرَ.<verse eid="JER 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="JER 15:16" />سَمِعْتُ كَلامَكَ فَوَعَيتُهُ. فكانَ لي كلامُكَ سُرورًا وفرَحًا في قلبي. فأنا دُعيتُ بِاَسمِكَ أيُّها الرّبُّ الإلهُ القديرُ.<verse eid="JER 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="JER 15:17" />لا أجلِسُ في مَجلِسِ المازِحينَ لاهيًا، بل بِثقلِ يَدِك عليَّ أجلِسُ وحيدًا يَملأُني الغضَبُ. <verse eid="JER 15:17" /><verse number="18" style="v" pubnumber="18" sid="JER 15:18" />لِماذا صارَ وجَعي مُستَديمًا ودائي عُضالًا يُقاوِمُ الشِّفاءَ؟ أتكونُ لي كسَرابٍ خادِعٍ، كمياهٍ لا تَدومُ؟<verse eid="JER 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="JER 15:19" />فقالَ الرّبُّ: ”إنْ رَجَعْتَ قَبِلْتُكَ، فتَقِفُ بَينَ يَدَيَّ. وإنْ نَطَقْتَ بالرَّصينِ لا بِالهَراءِ مِنَ الكلامِ كُنتَ كمَنْ يَنطِقُ بِفَمي. هُم يَرجِعونَ إليكَ وأنتَ لا تَرجِعُ إليهِم. <verse eid="JER 15:19" /><verse number="20" style="v" pubnumber="20" sid="JER 15:20" />وسأجعَلُكَ في وجهِ هذا الشَّعبِ سُورًا مِنْ نُحاسٍ حصينًا، فيُحارِبونَكَ ولا يَقدِرونَ علَيكَ، لأنِّي معَكَ لأخَلِّصَكَ وأُنقِذَكَ يقولُ الرّبُّ.<verse eid="JER 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="JER 15:21" />”نعم، سأُنقِذُكَ مِنْ أيدي الأشرارِ وأفتَديكَ مِنْ قبضَةِ الطُّغاةِ“.<verse eid="JER 15:21" /></para>
  <chapter eid="JER 15" />
  <chapter number="16" style="c" sid="JER 16" />
  <para style="s1">يوم النكبة</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 16:1" />وقالَ ليَ الرّبُّ: <verse eid="JER 16:1" /><verse number="2" style="v" pubnumber="2" sid="JER 16:2" />”لا تأخُذْ لكَ اَمرأةً ولا يَكُنْ لكَ بَنونَ وبَناتٌ في هذا المَوضعِ“.<verse eid="JER 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="JER 16:3" />وهذا ما قالَ الرّبُّ على البَنينَ والبَناتِ المَولودينَ في هذا المَوضعِ، وعلى أُمَّهاتِهِمِ اللَّواتي ولَدْنَهُم وعلى أبائِهِمِ الّذينَ ولَدوهُم في هذِهِ الأرضِ: <verse eid="JER 16:3" /><verse number="4" style="v" pubnumber="4" sid="JER 16:4" />”سيَموتونَ بِالأمراضِ ولا يُندَبونَ ولا يُدفَنونَ، بل يكونونَ زِبْلًا على وجهِ الأرضِ. ويَفنَونَ بِالسَّيفِ وبِالجُوعِ وتكونُ جُثَثُهُم طعامًا لِطَيرِ السَّماءِ ووحوشِ الأرضِ“.<verse eid="JER 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="JER 16:5" />وقالَ ليَ الرّبُّ: ”لا تدخُلْ بَيتًا فيهِ مَناحةٌ ولا تذهَبْ إليهِ لِلنَّدبِ ولا تُعَزِّهِم، لأنِّي أزلْتُ عَنْ هذا الشَّعبِ سلامي ورأفَتي ومراحِمي أنا الرّبُّ. <verse eid="JER 16:5" /><verse number="6" style="v" pubnumber="6" sid="JER 16:6" />فيموتُ كِبارُ القَومِ وصِغارُهُم في هذِهِ الأرضِ ولا يُدفَنونَ ولا يُندَبونَ ولا يَخدُشُ أحدٌ نَفسَه ولا يَحلِقُ شَعرَ رأسِهِ حُزْنًا علَيهِم. <verse eid="JER 16:6" /><verse number="7" style="v" pubnumber="7" sid="JER 16:7" />ولا يَكسِرُ النَّاسُ خُبزًا في المَناحةِ لأهلِ المَيتِ، ويَسقونَهُم كأْسَ السُّلوانِ عَنْ أبٍ أو أمٍّ. <verse eid="JER 16:7" /><verse number="8" style="v" pubnumber="8" sid="JER 16:8" />ولا تدخُلْ بَيتًا فيهِ وَليمَةٌ لِتَجلسَ معَهُم وتأْكُلَ وتشربَ“.<verse eid="JER 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="JER 16:9" />وقالَ الرّبُّ القديرُ إلهُ إِسرائيلَ: ”سأُبطِلُ مِنْ هذا المَوضعِ أمامَ عُيونِكُم وفي أيّامِكُم صوتَ الطَّرَبِ والفرَحِ، صوتَ العريسِ والعروسِ. <verse eid="JER 16:9" /><verse number="10" style="v" pubnumber="10" sid="JER 16:10" />وإذا أخبَرْتَ هذا الشَّعبَ بِجميعِ كَلامي هذا وقالوا لكَ: لِماذا تكَلَّمَ الرّبُّ علَينا هذا الشَّرَّ العظيمَ؟ ما هوَ إثمُنا؟ وما هيَ خَطيئَتُنا الّتي خَطِئْنا بِها إلى الرّبِّ إلَهِنا؟ <verse eid="JER 16:10" /><verse number="11" style="v" pubnumber="11" sid="JER 16:11" />فتقولُ لهُم: لأنَّ آباءَكُم ترَكوني واَتَّبَعوا آلِهَةً أُخرى وعَبَدوها وسَجَدوا لها. ترَكوني وما حَفِظوا شريعتي. <verse eid="JER 16:11" /><verse number="12" style="v" pubnumber="12" sid="JER 16:12" />أنتُم أسأْتُم في عمَلِكُم أكثرَ مِمَّا أساءَ آباؤكُم، فسارَ كُلُّ واحدٍ مِنكُم حسَبَ نيَّاتِ قلبِهِ الشِّرِّيرِ غَيرَ سامِعٍ لي. <verse eid="JER 16:12" /><verse number="13" style="v" pubnumber="13" sid="JER 16:13" />فلِذلِكَ أقذِفُكُم مِنْ هذِهِ الأرضِ إلى أرضٍ لا تَعرِفونَها أنتُم ولا عَرَفَها آباؤكُم. هُناكَ تَعبُدونَ آلِهَة أُخرى، نهارًا وليلًا، لأنِّي لا أهَبُكُم رَحمةً.<verse eid="JER 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="JER 16:14" />”لذلِكَ تأتي أيّامٌ، يقولُ الرّبُّ، لا يُقالُ فيها مِنْ بَعدُ: حَيٌّ الرّبُّ الّذي أخرجَ بَني إِسرائيلَ مِنْ أرضِ مِصْرَ، <verse eid="JER 16:14" /><verse number="15" style="v" pubnumber="15" sid="JER 16:15" />بل يُقالُ: حَيٌّ الرّبُّ الّذي أخرجَ بَني إِسرائيلَ مِنْ أرضِ الشِّمالِ ومِنْ جميعِ الأراضي الّتي أبعَدَهُم إليها، لأنِّي سأُعيدُهُم إلى أرضِهِم الّتي أعطَيتُها لآبائِهِم.<verse eid="JER 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="JER 16:16" />”سأرسِلُ صَيَّادينَ كثيرينَ يقولُ الرّبُّ، فيَصطادونَهُم عَنْ كُلِّ جبَلٍ، وعَنْ كُلِّ تَلٍّ، ومِنْ شُقوقِ الصُّخورِ <verse eid="JER 16:16" /><verse number="17" style="v" pubnumber="17" sid="JER 16:17" />لأنَّ عينيّ على جميعِ طُرُقِهِم، لأنَّها غَيرُ مُستتِرةٍ عَنْ وجهي ولا إثْمُهُم يَخفى عَنْ نَظَري. <verse eid="JER 16:17" /><verse number="18" style="v" pubnumber="18" sid="JER 16:18" />فأُضاعِفُ لهُمُ العِقابَ على إثْمِهِم وخَطيئَتِهِم لأنَّهُم دَنَّسوا أرضي وملأُوها مِنْ جُثَثِ أصنامِهِمِ الرَّجِسةِ الكريهةِ“.<verse eid="JER 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="JER 16:19" />”أيُّها الرّبُّ، أنتَ عِزِّي وحِصْني ومَلجأي في يومِ الضِّيقِ. إليكَ تَجيءُ الأُمَمُ مِنْ أقاصي الأرضِ وتقولُ: ”وَرِثَ آباؤُنا عِبادَةَ الزُّورِ والباطِلِ وما فائِدة فيهِ. <verse eid="JER 16:19" /><verse number="20" style="v" pubnumber="20" sid="JER 16:20" />هل يَصنَعُ البشَرُ لأنفُسِهِم آلِهَةً وما هيَ آلِهَةً؟“<verse eid="JER 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="JER 16:21" />وقالَ الرّبُّ: ”سأعرِّفُهُم هذِهِ المرَّةَ، أعرِّفُهُم بَطْشي وجَبَروتي، فيعلمونَ أنَّ الرّبَّ إِسمي“.<verse eid="JER 16:21" /></para>
  <chapter eid="JER 16" />
  <chapter number="17" style="c" sid="JER 17" />
  <para style="s1">عقاب يهوذا على خطيئتها</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 17:1" />قالَ الرّبُّ: ”خطيئةُ رِجالِ يَهوذا مكتوبةٌ بِقلَمٍ مِنْ حديدٍ، بِرأْسٍ مِنَ الماسِ مَنقوشَةٌ على ألواحِ قُلوبِهِم وقُرونِ مذابِحِهِم، <verse eid="JER 17:1" /><verse number="2" style="v" pubnumber="2" sid="JER 17:2" />فيما بَنوهُم يَذكُرونَ مذابِحَهُم وشعائِرَ أشيرةَ عِندَ الأشجارِ الخُضْرِ على الجِبالِ العاليةِ.<verse eid="JER 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="JER 17:3" />”يا جبَلي في البرِّيَّةِ! سأدفَعُ غِناكَ وجميعَ كُنوزِكَ ومَعابِدِكَ في المشارِفِ جزاءَ خطيئَتِكَ في جميعِ أرضِكَ. <verse eid="JER 17:3" /><verse number="4" style="v" pubnumber="4" sid="JER 17:4" />وأكُفُّ يَدَكَ عَنْ أرضِكَ الّتي أعطيتُكَ إيَّاها وأجعَلُكَ عبدًا لأعدائِكَ في أرضٍ لا تَعرِفُها، لأنَّكَ أشعَلتَ نارَ غضَبي فاَشتَعَلَت إلى الأبدِ“.<verse eid="JER 17:4" /></para>
  <para style="s1">حكم وأمثال</para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="JER 17:5" />وقالَ الرّبُّ:</para>
  <para style="p" vid="JER 17:5">”مَلعونٌ مَنْ يتَوكَّلُ على الإنسانِ</para>
  <para style="p" vid="JER 17:5">ويَجعَلُ البشَرَ سنَدًا لَه.</para>
  <para style="p" vid="JER 17:5">ويَصرِفُ قلبَهُ عَنِ الرّبِّ<verse eid="JER 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="JER 17:6" />فيكونُ مِثلَ النَّبْتِ في الصَّحراءِ،</para>
  <para style="p" vid="JER 17:6">وَلا يَرى الخَيْرَ إِذا أَقبَلَ</para>
  <para style="p" vid="JER 17:6">يَسكُنُ الفَلاةَ الشَّديدةَ الحَرِّ</para>
  <para style="p" vid="JER 17:6">والأرضَ المالِحةَ الّتي لا تُسكَنُ.<verse eid="JER 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="JER 17:7" />مُبارَكٌ مَنْ يَحتَمي بِالرّبِّ</para>
  <para style="p" vid="JER 17:7">ويَجعَلُ الرّبَّ مَأْمَنًا لَه،<verse eid="JER 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="JER 17:8" />فيكونُ كشجَرَةٍ مَغروسةٍ على المياهِ،</para>
  <para style="p" vid="JER 17:8">وعِندَ النَّهرِ تَمُدُّ جُذورَها.</para>
  <para style="p" vid="JER 17:8">لا تَرى الحَرَّ إذا أقبَلَ،</para>
  <para style="p" vid="JER 17:8">بل يَبقى ورَقُها أخضَرَ.</para>
  <para style="p" vid="JER 17:8">وفي سنَةِ القَحْطِ لا تَخافُ</para>
  <para style="p" vid="JER 17:8">ولا تَكُفُّ عَنِ الإثمارِ.<verse eid="JER 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="JER 17:9" />”القلبُ أخدَعُ الأشياءِ</para>
  <para style="p" vid="JER 17:9">وأخبَثُها فمَنْ يَعرِفُهُ؟<verse eid="JER 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="JER 17:10" />”أنا الرّبُّ أفحَصُ نيَّاتِ القُلوبِ</para>
  <para style="p" vid="JER 17:10">وأمتَحِنُ مشاعِرَ البشَرِ،</para>
  <para style="p" vid="JER 17:10">فأُجازي الإنسانَ بِحسَبِ طُرُقِهِ،</para>
  <para style="p" vid="JER 17:10">بِحسَبِ ثمَرَةِ أعمالِهِ“.<verse eid="JER 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JER 17:11" />جامِعُ الغِنى بِغَيرِ حَقٍّ</para>
  <para style="p" vid="JER 17:11">كالحَجَلَةِ تَحضُنُ بَيضَ غَيرِها.</para>
  <para style="p" vid="JER 17:11">وفي عِزِّ أيّامِهِ يَترُكُهُ غِناهُ</para>
  <para style="p" vid="JER 17:11">وفي آخِرَتِهِ يكونُ أحمَقَ.<verse eid="JER 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="JER 17:12" />بَيتُكَ المُقَدَّسُ عرشٌ مجيدٌ</para>
  <para style="p" vid="JER 17:12">مُرتَفِعٌ مُنذُ الاَبتِداءِ.<verse eid="JER 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="JER 17:13" />يا ربُّ، يا رجاءَ إِسرائيلَ!</para>
  <para style="p" vid="JER 17:13">كُلُّ الّذينَ يَترُكونَكَ يَخزَونَ</para>
  <para style="p" vid="JER 17:13">وكأسماءٍ مكتوبةٍ في التُّرابِ،</para>
  <para style="p" vid="JER 17:13">لأنَّهُم تَرَكوكَ أيُّها الرّبُّ،</para>
  <para style="p" vid="JER 17:13">يا يَنبوعَ ماءِ الحياةِ.<verse eid="JER 17:13" /></para>
  <para style="s1">صلاة إرميا</para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="JER 17:14" />إشفني يا ربُّ فأُشفى</para>
  <para style="p" vid="JER 17:14">خَلِّصني فأخلَّصَ لأمَجِّدَكَ.<verse eid="JER 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="JER 17:15" />ها هُم يقولونَ لي:</para>
  <para style="p" vid="JER 17:15">”أينَ وَعيدُ الرّبِّ فليأتِ!“<verse eid="JER 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="JER 17:16" />ما دعَيتُ علَيهِم بِالشَّرِّ،</para>
  <para style="p" vid="JER 17:16">ولا تَمَنَّيتُ يومَ البَليَّةِ.</para>
  <para style="p" vid="JER 17:16">أنتَ تَعرِفُ ما تَفَوَّهْتُ بهِ،</para>
  <para style="p" vid="JER 17:16">لأنَّهُ كانَ أمامَ وجهِكَ.<verse eid="JER 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="JER 17:17" />لا تَكُنْ لي يا ربُّ رُعبًا.</para>
  <para style="p" vid="JER 17:17">أنتَ مَلجأي يومَ الشَّرِّ.<verse eid="JER 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="JER 17:18" />يَخزَى الّذينَ يَضطَهِدونَني</para>
  <para style="p" vid="JER 17:18">أمَّا أنا فلا أخزَى</para>
  <para style="p" vid="JER 17:18">لِيَرتَعِبوا هُم ولا أرتَعِبُ.</para>
  <para style="p" vid="JER 17:18">إِجلِبْ علَيهِم يومَ الشَّرِّ</para>
  <para style="p" vid="JER 17:18">واَسحَقْهُم سَحقًا مُضاعفًا.<verse eid="JER 17:18" /></para>
  <para style="s1">يوم السبت</para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="JER 17:19" />وقالَ ليَ الرّبُّ: ”إِذْهَبْ وَقِفْ بِالبابِ الكبيرِ الّذي مِنهُ يَدخُلُ مُلوكُ يَهوذا ويَخرُجونَ، وبِسائِرِ أبوابِ أورُشليمَ <verse eid="JER 17:19" /><verse number="20" style="v" pubnumber="20" sid="JER 17:20" />وقُلْ: إِسمَعوا كَلِمَةَ الرّبِّ يا مُلوكَ يَهوذا ورِجالَها، ويا جميعَ سُكّانِ أُورُشليمَ الدَّاخلينَ مِنْ هذِهِ الأبوابِ: <verse eid="JER 17:20" /><verse number="21" style="v" pubnumber="21" sid="JER 17:21" />هذا ما قالَ الرّبُّ: لا تَحمِلوا حِمْلًا في يومِ السَّبتِ وتَدخُلوا بهِ أبوابَ أُورُشليمَ. <verse eid="JER 17:21" /><verse number="22" style="v" pubnumber="22" sid="JER 17:22" />لا تَخرُجوا بِحِمْلٍ مِنْ بُيوتِكُم في يومِ السَّبتِ، ولا تَعمَلوا عمَلًا، بل قَدِّسُوا يومَ السَّبتِ كما أمَرتُ آباءَكُم. <verse eid="JER 17:22" /><verse number="23" style="v" pubnumber="23" sid="JER 17:23" />فما سَمِعوا ولا مالوا بآذانِهِم، بل قَسّوا رِقابَهُم لِئلَّا يَسمَعوا ويَقبَلوا التَّأديبَ.<verse eid="JER 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="JER 17:24" />”أمَّا أنتُم، فإذا سَمِعْتُم لي جيِّدًا، يقولُ الرّبُّ، وما دَخَلتُم بِحِمْلٍ مِنْ أبوابِ هذِهِ المدينةِ في يومِ السَّبتِ، بَل قَدَّستُم يومَ السَّبتِ حتّى لا تعمَلوا فيهِ مِنَ العمَلِ شيئًا، <verse eid="JER 17:24" /><verse number="25" style="v" pubnumber="25" sid="JER 17:25" />فسَيَدخُلُ مِنْ أبوابِ هذِهِ المدينةِ المُلوكُ وهُم جالِسونَ على عرشِ داوُدَ، والرُّؤساءُ ورِجالُ يَهوذا وسُكَّان أُورُشليمَ، وهُم جميعًا راكِبونَ على عَجَلاتٍ وخيلٍ، وتُسكَنُ هذِهِ المدينةُ إلى الأبدِ. <verse eid="JER 17:25" /><verse number="26" style="v" pubnumber="26" sid="JER 17:26" />ويَجيئونَ مِنْ مُدُنِ يَهوذا، ومِنْ حَولِ أُورُشليمَ، وَمِنْ أرضِ بَنيامينَ ومِنَ السَّهلِ والجبَلِ والجنوبِ، ويَدخلونَ بِمُحرَقةٍ وذبيحةٍ وتقدِمَةٍ ولُبانٍ، وبِذَبائِحِ شُكْرٍ إلى بَيتِ الرّبِّ.<verse eid="JER 17:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="JER 17:27" />”وإنْ كُنتُم لا تسمَعونَ لي، فتُقَدِّسوا يومَ السَّبتِ ولا تَحمِلوا حِمْلًا وتدخُلوا بهِ مِنْ أبوابِ أُورُشليمَ في هذا اليومِ، فَسأُشعِلُ نارًا في أبوابِها فتَأكُلُ قُصورَ أُورُشليمَ ولا تَنطَفِئُ“.<verse eid="JER 17:27" /></para>
  <chapter eid="JER 17" />
  <chapter number="18" style="c" sid="JER 18" />
  <para style="s1">الخزاف وعمله</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 18:1" />وقال الرّبُّ لإرميا: <verse eid="JER 18:1" /><verse number="2" style="v" pubnumber="2" sid="JER 18:2" />”قُمْ واَنزِلْ إلى بَيتِ الخَزَّافِ وهُناكَ أُسمِعُك كَلامي“. <verse eid="JER 18:2" /><verse number="3" style="v" pubnumber="3" sid="JER 18:3" />فنَزَلْتُ إلى بَيتِ الخَزَّافِ، فإذا هوَ يَعمَلُ عمَلًا على الدُّولابِ. <verse eid="JER 18:3" /><verse number="4" style="v" pubnumber="4" sid="JER 18:4" />فلمَّا لم يَصلُحِ الوِعاءُ الّذي كانَ يَصنَعُهُ مِنَ الطِّينِ في يَدِهِ، عادَ وصَنَعَهُ وِعاءً آخَرَ كما رأى أنْ يَصنَعَهُ.<verse eid="JER 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="JER 18:5" />فقالَ ليَ الرّبُّ: <verse eid="JER 18:5" /><verse number="6" style="v" pubnumber="6" sid="JER 18:6" />”ألا أقدِرُ أنْ أصنَعَ بِكُم كهذا الخَزَّافِ يا بَيتَ إِسرائيلَ؟ أنتُم في يَدي مِثلُ الطِّينِ في يَدِ الخَزَّافِ. <verse eid="JER 18:6" /><verse number="7" style="v" pubnumber="7" sid="JER 18:7" />كُلَّما تَكَلَّمتُ على أُمَّةٍ أو على مَملَكةٍ أنِّي سَأقلَعُها وأهدِمُها وأُهلِكُها <verse eid="JER 18:7" /><verse number="8" style="v" pubnumber="8" sid="JER 18:8" />فرَجَعَت تِلكَ الأمَّةُ أوِ المَملَكةُ عَنْ شَرِّها الّذي مِنْ أجلِهِ تَكَلَّمتُ علَيها، نَدِمْتُ على الشَّرِّ الّذي نَويتُ أنْ أُنزِلَهُ بِها. <verse eid="JER 18:8" /><verse number="9" style="v" pubnumber="9" sid="JER 18:9" />وكُلَّما تكَلَّمْتُ على أُمَّةٍ أو على مَملَكةٍ أنِّي سَأبنيها وأغرِسُها، <verse eid="JER 18:9" /><verse number="10" style="v" pubnumber="10" sid="JER 18:10" />ففَعَلَتِ الشَّرَّ في عيَنيَّ وما سَمِعَت لِصوتي، نَدِمْتُ على الخَيرِ الّذي نَوَيتُ أنْ أصنَعَهُ إليها.<verse eid="JER 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JER 18:11" />”فالآنَ قُلْ لِرجالِ يَهوذا وسُكَّانِ أُورُشليمَ: هذا ما قالَ الرّبُّ: أُهَيِّئُ علَيكُم شرًّا وأُدبِّرُ علَيكُم مَكيدةً، فاَرجِعوا كُلُّ واحدٍ مِنكُم عَنْ طَريقِهِ الشِّرِّيرِ، وأصلِحوا سُلوكَكُم وأعمالَكُم. <verse eid="JER 18:11" /><verse number="12" style="v" pubnumber="12" sid="JER 18:12" />فيقولونَ: لا نَقدِرُ. سنَتبَعُ أفكارَنا ونَسيرُ بِحسَبِ نيَّاتِ قُلوبِنا الشِّرِّيرةِ“.<verse eid="JER 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="JER 18:13" />فقالَ الرّبُّ:</para>
  <para style="p" vid="JER 18:13">إِسألوا بَينَ الأمَمِ</para>
  <para style="p" vid="JER 18:13">منْ سَمِعَ بِمِثلِ هذا</para>
  <para style="p" vid="JER 18:13">بَنو إِسرائيلَ شعبي</para>
  <para style="p" vid="JER 18:13">عَمِلوا عمَلًا فَظيعًا.<verse eid="JER 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="JER 18:14" />هل تَخْلو جُرودُ لبنانَ مِنَ الثَّلجِ</para>
  <para style="p" vid="JER 18:14">أم تَنضَبُ ينابيعُهُ البارِدَةُ الجاريةُ؟<verse eid="JER 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="JER 18:15" />لكِنَّ شَعبي نَسَوني</para>
  <para style="p" vid="JER 18:15">وبَخَّروا للأصنامِ الباطِلةِ.</para>
  <para style="p" vid="JER 18:15">عثَروا في طُرُقِهِمِ القَويمةِ القديمةِ</para>
  <para style="p" vid="JER 18:15">وسَلَكوا في طَريقٍ غَيرِ مُمَهَّدٍ،<verse eid="JER 18:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="JER 18:16" />ليَجعَلوا أرضَهُم رُعْبًا</para>
  <para style="p" vid="JER 18:16">وعُرضَةً لِصَفيرِ الهُزْءِ.</para>
  <para style="p" vid="JER 18:16">فَكُلُّ مَنْ يَمُرُّ فيها</para>
  <para style="p" vid="JER 18:16">يَرتَعِبُ ويَهُزُّ رَأْسَهُ.<verse eid="JER 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="JER 18:17" />كَريحٍ شرقيَّةٍ أُبَدِّدُهُم</para>
  <para style="p" vid="JER 18:17">أمامَ وجهِ العَدُوِّ،</para>
  <para style="p" vid="JER 18:17">وأُريهِم في يومِ الضِّيقِ</para>
  <para style="p" vid="JER 18:17">ظَهري لا وجهي.<verse eid="JER 18:17" /></para>
  <para style="s1">مكيدة على إرميا</para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="JER 18:18" />فقالوا: ”تَعالَوا نَكيدُ لإرميا مَكيدةً، فالشَّريعةُ لا تُحرَمُ مِنْ كاهنٍ سِواهُ، ولا حُسنُ المَشورةِ مِنْ حكيمٍ، ولا كَلِمةُ الوحي مِنْ نبِيٍّ. تعالَوا نَتَّهِمُهُ ولا نُصغي إلى كَلِمةٍ مِنْ كَلِماتِهِ“.<verse eid="JER 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="JER 18:19" />أصغِ يا ربُّ إليَّ</para>
  <para style="p" vid="JER 18:19">واَسمَعْ صوتَ دَعواي.<verse eid="JER 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="JER 18:20" />أيُجازَى الخَيرُ بِالشَّرِّ؟</para>
  <para style="p" vid="JER 18:20">فَهُم حفَروا حُفرَةً لِهَلاكي.</para>
  <para style="p" vid="JER 18:20">أُذكُرْ وقوفي بَينَ يَدَيكَ</para>
  <para style="p" vid="JER 18:20">لأتَكَلَّمَ مِنْ أجلِهِم بِالخَيرِ</para>
  <para style="p" vid="JER 18:20">وأرُدَّ عَنهُم غضَبَكَ.<verse eid="JER 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="JER 18:21" />سَلِّمْ بَنيهِم إلى الجُوعِ</para>
  <para style="p" vid="JER 18:21">واَدفَعْهُم إلى يَدِ السَّيفِ</para>
  <para style="p" vid="JER 18:21">لِتَكُنْ نِساؤُهُم ثَكالى وأرامِلَ،</para>
  <para style="p" vid="JER 18:21">وليَكُنْ رِجالُهُم قَتْلى الوباءِ</para>
  <para style="p" vid="JER 18:21">وشُبَّانُهُم صَرْعى السَّيفِ.<verse eid="JER 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="JER 18:22" />لِيُسمَعْ صُراخٌ مِنْ بُيوتِهِم</para>
  <para style="p" vid="JER 18:22">حينَ تُباغِتُهُم بِالغُزاةِ،</para>
  <para style="p" vid="JER 18:22">فهُم حفَرُوا هُوَّةً ليَأخُذوني</para>
  <para style="p" vid="JER 18:22">وأخفَوا لِرِجلَيَّ فِخاخًا.<verse eid="JER 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="JER 18:23" />وأنتَ تَعلَمُ مَكايدَهُم لِقَتْلي،</para>
  <para style="p" vid="JER 18:23">فلا تَغفِرْ يا ربُّ إثْمَهُم.</para>
  <para style="p" vid="JER 18:23">لا تَمْحُ خطيئَتَهُم مِنْ أمامِكَ</para>
  <para style="p" vid="JER 18:23">وعاقِبْهُم في وقتِ غضَبِكَ.<verse eid="JER 18:23" /></para>
  <chapter eid="JER 18" />
  <chapter number="19" style="c" sid="JER 19" />
  <para style="s1">الجرة المكسورة</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 19:1" />وقالَ ليَ الرّبُّ: ”إذهَبْ معَ بَعضِ شُيوخِ الشَّعبِ وكِبارِ الكَهنَةِ واَشتَرِ جَرَّةً مِنْ فَخَّارٍ، <verse eid="JER 19:1" /><verse number="2" style="v" pubnumber="2" sid="JER 19:2" />واَخرُجْ إلى وادي اَبنِ هَنُّومَ الّذي عِندَ مَدخلِ بابِ الفخَّارِ ونادِ هُناكَ بِالكلامِ الّذي أُكَلِّمُكَ بهِ. <verse eid="JER 19:2" /><verse number="3" style="v" pubnumber="3" sid="JER 19:3" />قُلِ: إِسمَعوا يا مُلوكَ يَهوذا ويا سُكَّانَ أُورُشليمَ ما قالَ الرّبُّ القديرُ إلهُ إِسرائيلَ: سأجلِبُ على هذا المَوضعَ شَرًّا، كُلُّ مَنْ سَمِعَ بهِ تَطِنُّ أُذُناهُ، <verse eid="JER 19:3" /><verse number="4" style="v" pubnumber="4" sid="JER 19:4" />لأنَّهُم تَرَكوني وشَوَّهوا هذا المَوضِعَ وبَخَّروا فيهِ لآلِهَةٍ أُخرى لا يَعرفونَها ولا عَرَفَها آباؤُهُم ولا مُلوكُ يَهوذا. ومَلأوا هذا المَوضعَ مِنْ دَمِ الأبرياءِ <verse eid="JER 19:4" /><verse number="5" style="v" pubnumber="5" sid="JER 19:5" />وبَنَوا مذابِحَ لِلبَعلِ في المشارِفِ ليَحرقوا أولادَهُم بِالنَّارِ، وأنا ما أوصَيتُ بِذلِكَ ولا تَكَلَّمْتُ بهِ ولا خَطَر بِبالي. <verse eid="JER 19:5" /><verse number="6" style="v" pubnumber="6" sid="JER 19:6" />فلذلِكَ تأتي أيّامٌ لا يُدعَى فيها هذا المَوضعُ مِنْ بَعدُ تُوفَةَ أو وادي اَبنِ هَنُّومَ، ولَكِنْ وادي القَتلِ. <verse eid="JER 19:6" /><verse number="7" style="v" pubnumber="7" sid="JER 19:7" />وأُحبِطُ خُطَطَ أهلِ يَهوذا وأُورُشليمَ في هذا المَوضعِ، وأُسقِطُهُم بِالسَّيفِ أمامَ أعدائِهِم وبأيدي الّذينَ يَطلُبونَ حياتَهُم، وأدفَعُ جُثَثَهُم طَعامًا لِطَيرِ السَّماءِ ولِوحوشِ الأرضِ. <verse eid="JER 19:7" /><verse number="8" style="v" pubnumber="8" sid="JER 19:8" />وأجعَلُ هذِهِ المدينةَ خَرابًا وعُرضةً لِصفيرِ الهُزءِ، فكُلُّ مَنْ يَمُرُّ بها يَدهَشُ وَيصفرُ على جميعِ نَكَباتِها. <verse eid="JER 19:8" /><verse number="9" style="v" pubnumber="9" sid="JER 19:9" />وأُطعِمُ سُكَّانَها لَحمَ بَنيهِم وبَناتِهِم، وكُلُّ واحدٍ مِنهُم يأكُلُ لَحمَ صاحِبِهِ في الحِصارِ والضِّيقِ الّذي يُضايقُهُم بهِ أعداؤُهُم وطالِبو حياتِهِم.<verse eid="JER 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="JER 19:10" />”ثُمَّ تَكسِرُ الجَرَّةَ بِمَشهَدٍ مِنَ الرِّجالِ الّذينَ يُرافِقونَكَ <verse eid="JER 19:10" /><verse number="11" style="v" pubnumber="11" sid="JER 19:11" />وتقولُ لهُم: هذا ما قالَ الرّبُّ القديرُ: كما يتَحَطَّمُ وِعاءُ الخَزَّافِ الّذي لا يُمكِنُ أنْ يُجبَرَ مِنْ بَعدُ، أُحَطِّمُ هذا الشَّعبَ وهذِهِ المدينةَ، وتُدفَنُ جُثَثُهُم في تُوفَةَ، حتّى لا يَبقى مَوضِعٌ فيها لِلدَّفْنِ. <verse eid="JER 19:11" /><verse number="12" style="v" pubnumber="12" sid="JER 19:12" />ذلِكَ ما أصنَعُهُ بِهذا المَوضعِ وسُكَّانِهِ يقولُ الرّبُّ، وأجعَلُ هذِهِ المدينةَ مِثلَ تُوفَةَ <verse eid="JER 19:12" /><verse number="13" style="v" pubnumber="13" sid="JER 19:13" />وتكونُ بُيوتُ أُورُشليمَ وبيوتُ مُلوكِ يَهوذا الّتي بَخَّروا على سُطوحِها لِنجومِ السَّماءِ جميعًا وسَكَبوا قرابينَ خمرٍ لآلِهَةٍ أُخرى مَواضعَ نَجِسَةً كمَوضعِ تُوفَةَ“.<verse eid="JER 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="JER 19:14" />وعادَ إرميا مِنْ تُوفَةَ، حَيثُ كانَ أرسَلَهُ الرّبُّ ليَتنبَّأَ، ووقَفَ في دارِ الهيكَلِ وقالَ لِجميعِ الشَّعبِ: <verse eid="JER 19:14" /><verse number="15" style="v" pubnumber="15" sid="JER 19:15" />”قالَ الرّبُّ القديرُ إلهُ إِسرائيلَ: سأجلِبُ على هذِهِ المدينةِ وعلى قُراها جميعَ الشَّرِّ الّذي تكَلَّمتُ بهِ علَيها، لأنَّ سُكَّانَها قسّوا قُلوبَهُم لِئلَّا يَسمَعوا لِكَلامي“.<verse eid="JER 19:15" /></para>
  <chapter eid="JER 19" />
  <chapter number="20" style="c" sid="JER 20" />
  <para style="s1">اعتقال إرميا واطلاقه</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 20:1" />وسَمِعَ فَشحورُ بنُ إميرَ الكاهنُ، وهوَ رئيسُ القَيِّمينَ على هَيكلِ الرّبِّ، أنَّ إرميا يتَنَبَّأُ بهذِهِ الكَلِماتِ، <verse eid="JER 20:1" /><verse number="2" style="v" pubnumber="2" sid="JER 20:2" />فضَرَبَهُ وحبَسَ رِجلَيهِ في القُيودِ، بِبابِ بنيامينَ الأعلى، عِندَ بَيتِ الرّبِّ.<verse eid="JER 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="JER 20:3" />وفي الغَدِ أطلَقَ فَشحورُ إرميا مِنَ الخشَبَةِ، فقالَ لَه إرميا: ”ما دعا الرّبُّ اَسمَكَ فَشحورَ، بلِ الرُّعبَ مِنْ كُلِّ جِهةٍ“. <verse eid="JER 20:3" /><verse number="4" style="v" pubnumber="4" sid="JER 20:4" />لأنَّ هذا ما قالَ الرّبُّ: سأجعَلُكَ رُعبًا، أنتَ وجميعَ أحِبَّائِكَ، فيَسقُطونَ بِسَيفِ أعدائِهِم وعيناكَ تَنظُرانِ، وأجعَلُ يَهوذا كُلَّها في يَدِ مَلِكِ بابِلَ، فيَسبيهِم إلى بابِلَ ويقتلُهُم بِالسَّيفِ. <verse eid="JER 20:4" /><verse number="5" style="v" pubnumber="5" sid="JER 20:5" />وأجعَلُ كُلَّ ثروةِ هذِهِ المدينةِ، وكُلَّ مَحاصيلِها ونفائِسِها وكُلَّ كُنوزِ مُلوكِ يَهوذا في أيدي أعدائِها، فيَغنَمونَها ويأخُذونَها إلى بابِلَ. <verse eid="JER 20:5" /><verse number="6" style="v" pubnumber="6" sid="JER 20:6" />وأنتَ، يا فَشحورُ، تُسبَى معَ جميعِ سُكَّانِ بَيتِكَ إلى بابِلَ وتموتُ فيها وتُدفَنُ أنتَ وكُلُّ أحِبَّائِكَ الّذينَ تنبَّأْتَ لهُم بِالكَذِبِ“.<verse eid="JER 20:6" /></para>
  <para style="s1">شكوى إرميا</para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="JER 20:7" />خدَعتَني يا ربُّ فاَنخَدَعتُ،</para>
  <para style="p" vid="JER 20:7">وغالَبتَني بِقُوَّتِكَ فغَلَبتَ.</para>
  <para style="p" vid="JER 20:7">صِرْتُ أُضحُوكَةً ليلَ نهار،</para>
  <para style="p" vid="JER 20:7">وجَميعُهُم يَستَهزِئونَ بي.<verse eid="JER 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="JER 20:8" />كُلَّما تكَلَّمتُ صَرَختُ</para>
  <para style="p" vid="JER 20:8">ونادَيتُ بِالويلِ والدَّمارِ،</para>
  <para style="p" vid="JER 20:8">حتّى صارَ كَلامُ الرّبِّ عارًا</para>
  <para style="p" vid="JER 20:8">ومهانَةً ليلَ نهار.<verse eid="JER 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="JER 20:9" />فإِنْ قُلتُ: ”لن أذكُرَ الرّبَّ</para>
  <para style="p" vid="JER 20:9">ولا أتَكَلَّمَ بِاَسمِهِ مِنْ بَعدُ“،</para>
  <para style="p" vid="JER 20:9">أحسَسْتُ بِنارٍ مُحرِقَةٍ</para>
  <para style="p" vid="JER 20:9">مَحبوسَةٍ داخِلَ عظامي،</para>
  <para style="p" vid="JER 20:9">أُحاوِلُ كَبتَها ولا أقدِرُ.<verse eid="JER 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="JER 20:10" />أسمَعُ الكثيرينَ يَهمُسونَ،</para>
  <para style="p" vid="JER 20:10">والرُّعْبُ حَولي مِنْ كُلِّ جانِبٍ:</para>
  <para style="p" vid="JER 20:10">”دَعُونا نشتَكي علَيهِ!“</para>
  <para style="p" vid="JER 20:10">ويقولُ كُلُّ أصحابي،</para>
  <para style="p" vid="JER 20:10">وهُم يُراقِبونَ سُقوطي:</para>
  <para style="p" vid="JER 20:10">”لَعَلَّهُ يَزِلُّ فنَقوى علَيهِ</para>
  <para style="p" vid="JER 20:10">ونَأخُذَ ثَأرَنا مِنهُ“.<verse eid="JER 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JER 20:11" />لَكِنَّ الرّبَّ معي كجَبَّارٍ،</para>
  <para style="p" vid="JER 20:11">يُخيفُهُم فيَعثُرونَ ولا يَقومونَ.</para>
  <para style="p" vid="JER 20:11">يَخزَونَ خِزيًا ولا يَنجَحونَ.<verse eid="JER 20:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="JER 20:12" />فيا أيُّها الرّبُّ القديرُ</para>
  <para style="p" vid="JER 20:12">يا مَنْ تَمتَحِنُ الحَقَّ</para>
  <para style="p" vid="JER 20:12">وترى أعماقَ القُلوبِ،</para>
  <para style="p" vid="JER 20:12">دَعني أرى انتقامَكَ مِنهُم</para>
  <para style="p" vid="JER 20:12">فإلَيكَ فَوَّضتُ دَعوايَ.<verse eid="JER 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="JER 20:13" />رَنِّموا للرّبِّ وسبِّحوا</para>
  <para style="p" vid="JER 20:13">أنقَذَ المِسكينَ مِنْ يَدِ الأشرارِ.<verse eid="JER 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="JER 20:14" />مَلعونٌ اليومُ الّذي وُلِدْتُ فيهِ،</para>
  <para style="p" vid="JER 20:14">الّذي ولَدَتْني أُمِّي فيهِ لا يَكُنْ مُبارَكًا.<verse eid="JER 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="JER 20:15" />مَلعونٌ مَنْ بَشَّرَ أبي:</para>
  <para style="p" vid="JER 20:15">أنْ وُلِدَ لكَ اَبنٌ لِيُفَرِّحَهُ،<verse eid="JER 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="JER 20:16" />لِيَكُنْ ذلِكَ الإنسانُ كَمُدُنٍ</para>
  <para style="p" vid="JER 20:16">دَمَّرَها الرّبُّ في غَيرِ رَحمَةٍ،</para>
  <para style="p" vid="JER 20:16">يَسمَعُ الصُّراخَ في الصَّباحِ</para>
  <para style="p" vid="JER 20:16">وضَجيجَ القِتالِ عِندَ الظَّهيرةِ!<verse eid="JER 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="JER 20:17" />لَيتَ الرّبَّ قتَلَني في الرَّحِمِ</para>
  <para style="p" vid="JER 20:17">حتّى تكونَ لي أُمِّي قَبرًا،</para>
  <para style="p" vid="JER 20:17">فتَبقى حُبلى إلى الأبدِ.<verse eid="JER 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="JER 20:18" />لِماذا خَرَجتُ مِنَ الرَّحِمِ</para>
  <para style="p" vid="JER 20:18">لأرى البُؤسَ والحُزْنَ</para>
  <para style="p" vid="JER 20:18">وتَفنى أيّامي في العارِ.<verse eid="JER 20:18" /></para>
  <chapter eid="JER 20" />
  <chapter number="21" style="c" sid="JER 21" />
  <para style="s1">نبؤة خراب أورشليم</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 21:1" />وأرسَلَ المَلِكُ صِدْقيَّا فَشحورَ بنَ مَلْكِيَّا وصَفَنْيا بَن مَعِسيَّا إلى إرميا يَقولُ لَه: <verse eid="JER 21:1" /><verse number="2" style="v" pubnumber="2" sid="JER 21:2" />”أطلُبْ إلى الرّبِّ عنَّا أنْ يُساعِدَنا، لأنَّ نَبوخذنَصَّرَ مَلِكَ بابِلَ يُحارِبُنا، لَعلَّ الرّبَّ يَصنَعُ معَنا مُعجِزَةً مِثلَ جميعِ مُعجِزاتِهِ، فيَرُدَّهُ عنَّا“.<verse eid="JER 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="JER 21:3" />فقالَ لهُما إرميا: ”قولا لِصِدقيَّا <verse eid="JER 21:3" /><verse number="4" style="v" pubnumber="4" sid="JER 21:4" />إنَّ الرّبَّ إلهَ إِسرائيلَ قالَ: سأستَرِدُّ سِلاحَكُمُ الّذي تُحارِبونَ بهِ مَلِكَ بابِلَ وجيشَهُ الّذينَ يُحاصِرونَكُم في خارِجِ السُّورِ، وأجمَعُهُ في وسَطِ هذِهِ المدينةِ. <verse eid="JER 21:4" /><verse number="5" style="v" pubnumber="5" sid="JER 21:5" />وأُحارِبُكُم أنا بِيَدٍ مَمدودَةٍ وذِراعٍ قويَّةٍ، وبِغضَبٍ وحَنَقٍ وغَيظٍ عظيمٍ. <verse eid="JER 21:5" /><verse number="6" style="v" pubnumber="6" sid="JER 21:6" />وأضرِبُ سُكَّانَ هذِهِ المدينةِ وبهائِمَها، فيَموتونَ بِوَباءٍ رَهيبٍ. <verse eid="JER 21:6" /><verse number="7" style="v" pubnumber="7" sid="JER 21:7" />وبَعدَ ذلِكَ أُسَلِّمُ صِدْقيَّا مَلِكَ يَهوذا وعَبيدَهُ والشَّعبَ ومَنْ بَقيَ في هذِهِ المدينةِ مِنَ الوباءِ ومِنَ السَّيفِ والجُوعِ إلى يَدِ نَبوخذنَصَّرَ مَلِكِ بابِلَ وإلى أيدي أعدائِهِم، وطالِبي حياتِهِم. فيَقتُلونَهُم بِحَدِّ السَّيفِ ولا يتَرأّفونَ بِهِم ولا يُشفِقونَ علَيهِم ولا يَرحمونَ“.<verse eid="JER 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="JER 21:8" />وقالَ الرّبُّ لإرميا: ”قُلْ لِهذا الشَّعبِ: سأجعَلُ أمامَكُم طريقَ الحياةِ وطريقَ الموتِ. <verse eid="JER 21:8" /><verse number="9" style="v" pubnumber="9" sid="JER 21:9" />الّذي يُقيمُ في هذِهِ المدينةِ يموتُ بِالسَّيفِ والجُوعِ والوَباءِ، والّذي يَخرُجُ ويَلجأُ إلى البابِليِّينَ الّذينَ يُحاصِرونَكُم يحَيا وتكونُ لَه حياتُهُ مَغنَمًا. <verse eid="JER 21:9" /><verse number="10" style="v" pubnumber="10" sid="JER 21:10" />فأنا نَوَيتُ شَرًّا بِهذِهِ المدينةِ لا خَيرًا يقولُ الرّبُّ. فتُسَلَّمُ إلى يَدِ مَلِكِ بابِلَ، فيَحرِقُها بِالنَّارِ“.<verse eid="JER 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JER 21:11" />وقُلْ لِبَيتِ مَلِكِ يَهوذا: ”إسمَعوا كَلِمَةَ الرّبِّ <verse eid="JER 21:11" /><verse number="12" style="v" pubnumber="12" sid="JER 21:12" />يا بَيتَ داوُدَ: أُحكُموا بِالعَدلِ كُلَّ صباحٍ، وأنقِذوا المَظلومَ مِنْ يَدِ الظَّالِمِ لِئلَّا يَنفَجِرَ غضَبي كالنَّارِ جَزاءَ شَرِّ أعمالِكُم، فيُحرِقُ ولا مَنْ يُطفِئُ.<verse eid="JER 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="JER 21:13" />”يا ساكِنةَ الوادي، يا صَخرَةَ السَّهلِ، يا مَنْ تقولونَ: مَنْ يَقدرُ أن يَنزِلَ علَينا أو يَقتَحِمَ مَساكِنَنا؟ <verse eid="JER 21:13" /><verse number="14" style="v" pubnumber="14" sid="JER 21:14" />أنا أُعاقِبُكُم على ثمَرَةِ أعمالِكُم يقولُ الرّبُّ، وأُوقِدُ نارًا في الغابَةِ فتَحرقُ كُلَّ ما حَولَها“.<verse eid="JER 21:14" /></para>
  <chapter eid="JER 21" />
  <chapter number="22" style="c" sid="JER 22" />
  <para style="s1">كلمة الرّبّ إلى قصر ملك يهوذا</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 22:1" />وقالَ ليَ الرّبُّ: ”إِنْزِلْ إلى قصرِ مَلِكِ يَهوذا <verse eid="JER 22:1" /><verse number="2" style="v" pubnumber="2" sid="JER 22:2" />وقُلْ لَه: إِسمَعْ كَلِمَةَ الرّبِّ يا مَلِكَ يَهوذا الجالِسَ على عرشِ داوُدَ، أنتَ وعَبيدُكَ وشعبُكَ الدَّاخلونَ مِنْ هذِهِ الأبوابِ: <verse eid="JER 22:2" /><verse number="3" style="v" pubnumber="3" sid="JER 22:3" />أحكُموا بِالعَدلِ وأنقِذوا المَظلومَ مِنْ يَدِ الظَّالِمِ، ولا تَضطَهِدوا الغريبَ واليَتيمَ والأرمَلَةَ، ولا تَجوروا علَيهِم، ولا تَسفِكوا الدَّمَ البَريءَ في هذا المَوضعِ. <verse eid="JER 22:3" /><verse number="4" style="v" pubnumber="4" sid="JER 22:4" />فإنْ عَمِلْتُم بِهذا الكَلامِ، يَبقى على عرشِ داوُدَ مُلوكٌ يَركَبونَ على عَجلاتٍ وخَيلٍ ويَدخُلونَ مِن أبوابِ هذا القصرِ، هُم وعَبيدُهُم وشعبُهُم. <verse eid="JER 22:4" /><verse number="5" style="v" pubnumber="5" sid="JER 22:5" />وإنْ كُنتُم لا تَسمَعونَ لِهذا الكَلامِ، فَبِنَفسي، أقسَمتُ أنا الرّبُّ سأجعَلُ هذا البَيتَ خَرابًا“.<verse eid="JER 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="JER 22:6" />وقالَ الرّبُّ على بَيتِ مَلِكِ يَهوذا: ”أنتَ لي كجِلعادَ وكرأسِ لبنانَ. لكنِّي أجعلُكَ قَفرًا ومدينةً لا ساكِنَ فيها. <verse eid="JER 22:6" /><verse number="7" style="v" pubnumber="7" sid="JER 22:7" />وأُرسِلُ علَيكَ مَنْ يُدَمِّرونَكَ، كُلَّ واحدٍ بِسلاحِهِ، فيَقطَعونَ نُخبَةَ أرزِكَ ويُلقونَها في النَّارِ. <verse eid="JER 22:7" /><verse number="8" style="v" pubnumber="8" sid="JER 22:8" />فتَمُرُّ أُمَمٌ كثيرةٌ بِهذِهِ المدينةِ، فيقولُ الواحدُ للآخَرِ: لماذا فعَلَ الرّبُّ هكذا لهذِهِ المدينةِ؟ <verse eid="JER 22:8" /><verse number="9" style="v" pubnumber="9" sid="JER 22:9" />فيُجيبُهُ: لأنَّ سُكَّانَها ترَكوا عَهدَ الرّبِّ إلهِهِم وسَجدوا لآلِهةٍ أُخرى وعَبدوها“.<verse eid="JER 22:9" /></para>
  <para style="s1">شلوم بن يوشيا</para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="JER 22:10" />لا تبكوا على المَيتِ ولا تَندُبوهُ، بلِ إِبكوا بُكاءً مُرًّا على الذَّاهِبِ الّذي لا يَرجِعُ مِنْ بَعدُ ولا يرَى أرضَ ميلادِهِ.<verse eid="JER 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JER 22:11" />وقالَ الرّبُّ على شَلُّومَ بنِ يُوشيَّا الّذي ملَكَ على يَهوذا مَكانَ أبيهِ وخرَجَ مِنْ هذا الموضعِ: ”لا يرجِعُ إلى هُنا مِنْ بَعدُ، <verse eid="JER 22:11" /><verse number="12" style="v" pubnumber="12" sid="JER 22:12" />بل في الموضعِ الّذي سُبِيَ إليهِ يموتُ ولن يرَى هذِهِ الأرضَ“.<verse eid="JER 22:12" /></para>
  <para style="s1">توبيخ يوياقيم</para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="JER 22:13" />ويلٌ لِمَن يَبني بَيتَهُ بِالظُّلمِ ويُعَلِّي غُرَفَهُ بِغَيرِ حَقٍّ! يَستَخدِمُ الآخَرينَ بِلا أُجرَةٍ ولا يُوفي أحدًا عَنْ عمَلِه. <verse eid="JER 22:13" /><verse number="14" style="v" pubnumber="14" sid="JER 22:14" />ويقولُ: ”أبني لي بَيتًا واسِعًا وغُرَفًا فَسيحَةً“. فيَفتَحُ لَه نَوافِذَ ويُغَلِّفُهُ بِالأرزِ ويَدهَنُهُ بِلونِ القِرمِزِ. <verse eid="JER 22:14" /><verse number="15" style="v" pubnumber="15" sid="JER 22:15" />أتكونُ عَظَمَةُ مُلكِكَ أنْ يُفاخِرَ بِالأرزِ؟ أما اَكتَفى أبوكَ بِأنْ أكَلَ وشَرِبَ <verse eid="JER 22:15" /><verse number="16" style="v" pubnumber="16" sid="JER 22:16" />وأجرى الحَقَّ والعَدلَ وقضى لِلبائِسِ والمسكينِ، فكانَ في خَيرٍ؟ ألاَ يَدُلُّ ذلِكَ على أنَّهُ كانَ يَعرِفُني؟ <verse eid="JER 22:16" /><verse number="17" style="v" pubnumber="17" sid="JER 22:17" />أمَّا أنتَ فعَيناكَ وقلبُكَ على المَكْسَبِ الخَسيسِ وسَفْكِ الدَّمِ البَريءِ والظُّلْمِ والعُنْفِ. <verse eid="JER 22:17" /><verse number="18" style="v" pubnumber="18" sid="JER 22:18" />لذلِكَ قالَ الرّبُّ على يوياقيمَ بنِ يوشيَّا مَلِكِ يَهوذا: ”لا يُناحُ علَيهِ فيُقالُ: آها يا أخي! أو آها، يا أُختي! ولا يُقالُ: آها يا سيِّدُ! أو آها يا مَلِكي! <verse eid="JER 22:18" /><verse number="19" style="v" pubnumber="19" sid="JER 22:19" />بل يُسحَبُ ويُطرَحُ بَعيدًا عَن أبوابِ أُورُشليمَ ويُطمَرُ هُناكَ طَمْرَ الحمارِ“.<verse eid="JER 22:19" /></para>
  <para style="s1">مصير أورشليم</para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="JER 22:20" />”إصعَدي إلى لبنانَ واَصرُخي،</para>
  <para style="p" vid="JER 22:20">وفي باشانَ اَرفعي صوتَكِ،</para>
  <para style="p" vid="JER 22:20">وليُسمَعْ صُراخُكِ في عباريمَ</para>
  <para style="p" vid="JER 22:20">لأنَّ جميعَ مُحبِّيكِ اَنسَحَقوا<verse eid="JER 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="JER 22:21" />كلَّمتُكِ في أيّامِ عِزِّكِ،</para>
  <para style="p" vid="JER 22:21">فَقُلتِ لي: لا أسمَعُ،</para>
  <para style="p" vid="JER 22:21">هذا طريقُكِ مُنذُ صِباكِ</para>
  <para style="p" vid="JER 22:21">أنَّكِ لا تَسمَعينَ لِصوتي،<verse eid="JER 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="JER 22:22" />ستَذهَبُ الرِّيحُ بِجميعِ رُعاتِكِ</para>
  <para style="p" vid="JER 22:22">ويَذهَبُ مُحبُّوكِ إلى السَّبي،</para>
  <para style="p" vid="JER 22:22">فتَخزَينَ في ذلِكَ الحينِ وتَخجَلينَ</para>
  <para style="p" vid="JER 22:22">جَزاءَ كُلِّ ما فعَلْتِهِ مِنْ شَرٍّ.<verse eid="JER 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="JER 22:23" />يا ساكِنَةَ لبنانَ يا الّتي</para>
  <para style="p" vid="JER 22:23">صَنَعَت مِنْ أرزِهِ عشًّا لها،</para>
  <para style="p" vid="JER 22:23">كم تَئِنِّينَ حينَ يأتيكِ الوَجَعُ</para>
  <para style="p" vid="JER 22:23">في مَخاضٍ كالّتي تَلِدُ.<verse eid="JER 22:23" /></para>
  <para style="s1">الحكم على يوياقيم</para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="JER 22:24" />”وقالَ الرّبُّ لِكُنْيا بنِ يوياقيمَ مَلِكِ يَهوذا: ”لو كُنتَ خاتَمًا في يَدي اليُمنى لنَزَعتُكَ مِنها <verse eid="JER 22:24" /><verse number="25" style="v" pubnumber="25" sid="JER 22:25" />وجعَلتُكَ في أيدي الّذينَ يطلُبونَ حياتَكَ والّذينَ تَخافُ مِنهُم، وفي يَدِ نَبوخذنَصَّرَ مَلِكِ بابِلَ وأيدي جيشِهِ <verse eid="JER 22:25" /><verse number="26" style="v" pubnumber="26" sid="JER 22:26" />ولَقَذَفتُكَ أنتَ وأُمُّكَ إلى أرضٍ غَيرِ الّتي وُلِدْتُما فيها وهُناكَ تَموتانِ. <verse eid="JER 22:26" /><verse number="27" style="v" pubnumber="27" sid="JER 22:27" />والأرضُ الّتي تشتاقانِ إلى الرُّجوعِ إليها لا تَرجعانِ إليها“.<verse eid="JER 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="JER 22:28" />أوعاءُ خزَفٍ مَكسورٍ لا نَفْعَ مِنهُ، هذا الرَّجُلُ كُنْيا، أو إناءٌ لا يَرغَبُ فيهِ أحدٌ؟ ما بالُهُ قُذِفَ هوَ ونَسلُهُ وأُلقوا إلى أرضٍ لا يَعرِفونَها؟<verse eid="JER 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="JER 22:29" />يا أرضُ، يا أرضُ، يا أرضُ اَسمَعي ما قالَ الرّبُّ: <verse eid="JER 22:29" /><verse number="30" style="v" pubnumber="30" sid="JER 22:30" />”كُتِبَ على هذا الرَّجُلِ أنْ يَفقِدَ بَنيهِ، وأنْ لا يَنجَحَ في حياتِهِ، وأنْ لا يكونَ لَه مِنْ نَسلِهِ أحدٌ يَجلِسُ على عرشِ داوُدَ ويَحكُمُ في يَهوذا مِنْ بَعدُ“.<verse eid="JER 22:30" /></para>
  <chapter eid="JER 22" />
  <chapter number="23" style="c" sid="JER 23" />
  <para style="s1">كلام على الرعاة</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 23:1" />”ويلٌ لِلرُّعاةِ الّذينَ يَبيدونَ ويُبَدِّدونَ غنَمَ رَعيَّتي يقولُ الرّبُّ.<verse eid="JER 23:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="JER 23:2" />وهذا ما تكَلَّمَ بهِ الرّبُّ إلهُ إِسرائيلَ على أُولئِكَ الرُّعاةِ الّذينَ يَرعَونَ شعبي: ”أنتُم بَدَّدْتُم غنَمي وطَردتُموها وما تَفَقَّدْتُموها. فسأُعاقِبُكُم على شَرِّ أعمالِكُم <verse eid="JER 23:2" /><verse number="3" style="v" pubnumber="3" sid="JER 23:3" />وأجمَعُ بَقِيَّةَ غنَمي مِنْ جميعِ الأراضي الّتي طَرَدْتُها إليها وأرُدُّها إلى حظائِرِها، فتُثمِرُ وتَكثُرُ، <verse eid="JER 23:3" /><verse number="4" style="v" pubnumber="4" sid="JER 23:4" />وأُقيمُ علَيها رُعاةً يَرعَونها، فلا تخافُ مِنْ بَعدُ ولا تَفزَعُ ولا يكونُ فيها مَفقودٌ يقولُ الرّبُّ.<verse eid="JER 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="JER 23:5" />”ستَأْتي أيّامٌ يقولُ الرّبُّ، أُقيمُ مِنْ نَسلِ داوُدَ مَلِكًا صالحًا، يَملِكُ ويكونُ حكيمًا ويُجري الحَقَّ والعَدلَ في الأرضِ. <verse eid="JER 23:5" /><verse number="6" style="v" pubnumber="6" sid="JER 23:6" />في أيّامِهِ يُخَلَّصُ شعبُ يَهوذا ويَسكُنُ بَنو إِسرائيلَ في أمانٍ، ويكونُ اَسمُهُ: ”الرّبُّ صادِقٌ معَنا“.<verse eid="JER 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="JER 23:7" />”وستَأتي أيّامٌ لا يُقالُ فيها مِنْ بَعدُ: حَيٌّ الرّبُّ الّذي أخرَجَ بَني إِسرائيلَ مِنْ أرضِ مِصْرَ، <verse eid="JER 23:7" /><verse number="8" style="v" pubnumber="8" sid="JER 23:8" />بل حيٌّ الرّبُّ الّذي أخرَجَ ذُرِّيَّةَ بَيتِ إِسرائيلَ وجاءَ بهِم مِنْ أرضِ الشِّمالِ ومِنْ جميعِ الأراضي الّتي طَرَدْتُهُم إليها، فسَكَنوا في أرضِهِم“.<verse eid="JER 23:8" /></para>
  <para style="s1">كلام على الأنبياء</para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="JER 23:9" />وهذا كلامٌ على الأنبياءِ:</para>
  <para style="p" vid="JER 23:9">إنكَسرَ قلبي في داخلي</para>
  <para style="p" vid="JER 23:9">ورَجَفَت كُلُّ عِظامي.</para>
  <para style="p" vid="JER 23:9">بِالرّبِّ وكَلامِهِ المُقَدَّسِ</para>
  <para style="p" vid="JER 23:9">صِرْتُ كإِنسانٍ سَكْران،</para>
  <para style="p" vid="JER 23:9">كرَجُلٍ غَلَبَتْهُ الخمرُ.<verse eid="JER 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="JER 23:10" />الأرضُ اَمتَلأت بِالفاسِقينَ،</para>
  <para style="p" vid="JER 23:10">مَساعيهِم صارَت للشَّرِّ</para>
  <para style="p" vid="JER 23:10">وقُدرَتُهُمُ الخارِقةُ لِلباطِلِ</para>
  <para style="p" vid="JER 23:10">ومِنْ لَعنَةِ الرّبِّ</para>
  <para style="p" vid="JER 23:10">يَبِسَت مَراعي البرِّيَّةِ.<verse eid="JER 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JER 23:11" />”النَّبيُّ والكاهنُ كافِرانِ،</para>
  <para style="p" vid="JER 23:11">وفي هيكَلي وجَدْتُ شَرَّهُما.<verse eid="JER 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="JER 23:12" />لذلِكَ يكونُ طريقُهُما</para>
  <para style="p" vid="JER 23:12">كزَلَّاقَةٍ لهُما في الظَّلامِ</para>
  <para style="p" vid="JER 23:12">يُدفعانِ إليها فَيسقُطانِ</para>
  <para style="p" vid="JER 23:12">وأجلِبُ علَيهِما شَرًّا.</para>
  <para style="p" vid="JER 23:12">في سنَةِ عِقابِهِما.<verse eid="JER 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="JER 23:13" />في أنبياءِ السَّامِرةِ رأيتُ حماقَةً:</para>
  <para style="p" vid="JER 23:13">يتَنَبَّأونَ بِاَسمِ الإلَهِ بَعلٍ</para>
  <para style="p" vid="JER 23:13">ويُضَلِّلونَ شعبي إِسرائيلَ.<verse eid="JER 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="JER 23:14" />وفي أنبياءِ أُورُشليمَ رأيتُ العَجَبَ:</para>
  <para style="p" vid="JER 23:14">يَسلُكونَ طريقَ الزِّنى والزُّورِ،</para>
  <para style="p" vid="JER 23:14">ويُشَجِّعونَ مَنْ يَفعَلونَ الشَّرَّ</para>
  <para style="p" vid="JER 23:14">لِئلَّا يَرجِعوا عَنْ شَرِّهِم.</para>
  <para style="p" vid="JER 23:14">فصاروا لي كُلُّهُم كسَدومَ،</para>
  <para style="p" vid="JER 23:14">وصارَ سُكَّانُها كعَمورَةَ“.<verse eid="JER 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="JER 23:15" />وقالَ الرّبُّ القديرُ على الأنبياءِ: ”سأُطعِمُ أنبياءَ أُورُشليمَ عَلْقَمًا وأسقيهِم سَمًّا، فَمِنهُم خرَجَ الكُفْرُ إلى كُلِّ الأرضِ“.<verse eid="JER 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="JER 23:16" />وقالَ الرّبُّ القديرُ: ”لا تَسمَعوا لِكَلامِ الأنبياءِ الّذينَ يتَنَبَّأونَ لكُم ويَخدَعونَكُم. هُم يتَكَلَّمونَ بِما يتَراءى لهُم، لا بِما أقولُ أنا الرّبُّ. <verse eid="JER 23:16" /><verse number="17" style="v" pubnumber="17" sid="JER 23:17" />هُم يَقولونَ لِلَّذينَ يَستَهينونَ بِكَلامي: لكُم سلامٌ، ويَقولونَ لِكُلِّ مَنْ يَسيرُ بِحسَبِ نيَّاتِ قلبِهِ لا يُصيبُكُم أذًى“.<verse eid="JER 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="JER 23:18" />ولَكِنْ مَنْ مِنهُم وقَفَ في مَجلِسِ الرّبِّ</para>
  <para style="p" vid="JER 23:18">ورأى وسَمِعَ كَلِمَتَهُ؟ مَنْ مِنهُم أصغى إلى كَلِمَتِهِ واَستَمَعَ لها؟<verse eid="JER 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="JER 23:19" />ها غضَبُ الرّبِّ زَوبَعَةٌ تَهبُّ وريحٌ عاصِفَةٌ على رُؤوسِ الأشرارِ، <verse eid="JER 23:19" /><verse number="20" style="v" pubnumber="20" sid="JER 23:20" />فلا يَرتَدُّ حتّى يفعَلَ فِعلَهُ ويُتَمِّمَ ما نوى في قلبِهِ. وفي آخِرِ الأيّامِ تَفهَمونَ ذلِكَ حَقَّ الفَهمِ.<verse eid="JER 23:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="JER 23:21" />”أنا لم أُرسِلْ أُولَئِكَ الأنبياءَ يقولُ الرّبُّ. بل هُم أرسَلوا أنفُسَهُم. وأنا لم أُكلِّمْهُم، بل هُم تَنَبَّأوا. <verse eid="JER 23:21" /><verse number="22" style="v" pubnumber="22" sid="JER 23:22" />لو وقَفوا في مَجلِسي وسَمِعوا كَلامي وأسمَعوهُ لِشعبي، لَكانوا رَدُّوهُم عَنْ طريقِ الشَّرِّ وعَنْ شَرِّ ما يَفعلونَ.<verse eid="JER 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="JER 23:23" />”أإلَهٌ أنا يرى عَنْ قريبٍ يقولُ الرّبُّ، ولَستُ إِلهًا يرَى عَنْ بُعدٍ؟ <verse eid="JER 23:23" /><verse number="24" style="v" pubnumber="24" sid="JER 23:24" />أيختَبِئُ أحدٌ في الخَفايا وأنا لا أراهُ؟ أما أنا مالِئُ السَّماواتِ والأرضِ؟ <verse eid="JER 23:24" /><verse number="25" style="v" pubnumber="25" sid="JER 23:25" />”سَمِعْتُ ما تنَبَّأَ بهِ الأنبياءُ بِاَسمي زُورًا قائِلينَ: ”رأينا ذلِكَ في الحُلُمِ، <verse eid="JER 23:25" /><verse number="26" style="v" pubnumber="26" sid="JER 23:26" />فإلى متى يَدومُ الكَذِبُ في قُلوبِ الأنبياءِ المُتَنَبِّئينَ بِالكَذِبِ، المُتَنَبِّئينَ بِما يتَوَهَّمونَ في قُلوبِهِم. <verse eid="JER 23:26" /><verse number="27" style="v" pubnumber="27" sid="JER 23:27" />الّذينَ يَظُنُّونَ أنَّهُم بِالأحلامِ الّتي يتَناقَلونَها يَجعَلونَ شعبي يَنسى اَسمي كما نَسيَهُ آباؤُهُم واَتَّبَعوا الإلَهَ البَعلَ؟<verse eid="JER 23:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="JER 23:28" />”النَّبيُّ الّذي عِندَهُ حُلُمٌ فلْيَقُصَّ حُلُمَهُ، والّذي عِندَهُ كَلِمَتي، فليَقُلْ كَلِمَتي بأمانَةٍ. ما شَأْنُ التِّبْنِ معَ الحِنطَةِ؟ يقولُ الرّبُّ. <verse eid="JER 23:28" /><verse number="29" style="v" pubnumber="29" sid="JER 23:29" />أمَا كَلِمَتي كالنَّارِ وكالمطرَقَةِ الّتي تُحَطِّمُ الصَّخرَ؟ <verse eid="JER 23:29" /><verse number="30" style="v" pubnumber="30" sid="JER 23:30" />فأنا خَصمُ الأنبياءِ الّذينَ يَسرُقونَ الكَلامَ، بَعضُهُم مِنْ بَعضٍ، ويَزعمونَ أنَّهُ كَلامي. <verse eid="JER 23:30" /><verse number="31" style="v" pubnumber="31" sid="JER 23:31" />وأنا خَصمُ الأنبياءِ الّذينَ يَختَلِقونَ الكَلامَ ويقولونَ: قالَ الرّبُّ. <verse eid="JER 23:31" /><verse number="32" style="v" pubnumber="32" sid="JER 23:32" />وأنا خَصمُ الّذينَ يتَنَبَّأونَ بِأحلامٍ كاذِبَةٍ، ويَقُصُّونَها ويُضَلِّلونَ شعبي بِأكاذيبِهِم وعَنجَهِيَّتِهِم. فلا أنا أرسَلْتُهُم، وأمَرْتُهُم ولا هُم يَنفَعونَ هذا الشَّعبَ في شيءٍ“.</para>
  <para style="s1" vid="JER 23:32">وحي الرب</para>
  <para style="p" vid="JER 23:32">وقالَ الرّبُّ لإرميا: <verse eid="JER 23:32" /><verse number="33" style="v" pubnumber="33" sid="JER 23:33" />”إذا سألَكَ هذا الشَّعبُ أو نَبيٌّ أو كاهنٌ: ما وَحيُ الرّبِّ؟ فَقُلْ لهُم: هذا وَحيُ الرّبِّ: إنِّي أرفُضُكُم يقولُ الرّبُّ. <verse eid="JER 23:33" /><verse number="34" style="v" pubnumber="34" sid="JER 23:34" />والنَّبيُّ والكاهنُ وكُلُّ مَنْ يقولُ: هذا وَحيُ الرّبِّ، أُعاقِبُهُ هوَ وأهلُ بَيتِهِ. <verse eid="JER 23:34" /><verse number="35" style="v" pubnumber="35" sid="JER 23:35" />بل فليَقُلْ كُلٌّ مِنكُم لِصاحبِهِ أو لأخيهِ: بِماذا أجابَ الرّبُّ؟ أو بِماذا تكَلَّمَ الرّبُّ؟ <verse eid="JER 23:35" /><verse number="36" style="v" pubnumber="36" sid="JER 23:36" />أمَّا وَحيُ الرّبِّ فلا تَذكُروهُ مِنْ بَعدُ، لأنَّ لِكُلٍّ مِنكُم كلامًا مِنْ وَحيهِ، فعكَسْتُم كلامَ الإلَهِ الحَيِّ والرّبِّ القديرِ. <verse eid="JER 23:36" /><verse number="37" style="v" pubnumber="37" sid="JER 23:37" />فَقُلْ لِلأنبياءِ: بِماذا أجابَكُمُ الرّبُّ وبِماذا كلَّمَكُم؟ <verse eid="JER 23:37" /><verse number="38" style="v" pubnumber="38" sid="JER 23:38" />فإِنْ قالوا: هذا وَحيُ الرّبِّ، تُجيبُهُم: جَزاءَ قولِكُم هذا: <verse eid="JER 23:38" /><verse number="39" style="v" pubnumber="39" sid="JER 23:39" />سأنساكُم وأنبُذُكُم أنتُم والمدينةُ الّتي أعطيتُها لكُم ولآبائِكُم، <verse eid="JER 23:39" /><verse number="40" style="v" pubnumber="40" sid="JER 23:40" />وأُلْحِقُ بِكُم عارًا أبديًّا وخِزْيًا دائِمًا لن يُنْسى“.<verse eid="JER 23:40" /></para>
  <chapter eid="JER 23" />
  <chapter number="24" style="c" sid="JER 24" />
  <para style="s1">سلَّتا التين</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 24:1" />وأراني الرّبُّ في رُؤيا سَلَّتَي تينٍ أمامَ الهيكَلِ، بَعدَ أنْ أخذَ نبوخذنَصَّرُ، مَلِكُ بابِلَ، يَكُنيا بنَ يوياقيمَ مَلِكَ يَهوذا ورُؤساءَ يَهوذا والنَّجَّارينَ مِنْ أُورُشليمَ وجاءَ بِهِم إلى بابِلَ. <verse eid="JER 24:1" /><verse number="2" style="v" pubnumber="2" sid="JER 24:2" />وكانَ في السَّلَّةِ الواحدةِ تينٌ طَيِّبٌ جدًّا، كباكورَةِ التِّينِ، وفي السَّلَّةِ الأخرى تينٌ رَديءٌ جِدًّا لا يُمكِنُ أكلُهُ مِنْ رداءتهِ. <verse eid="JER 24:2" /><verse number="3" style="v" pubnumber="3" sid="JER 24:3" />فقالَ ليَ الرّبُّ: ”ماذا ترى يا إرميا؟“ فَقُلت: تينًا. والتِّينُ الطَّيِّبُ مِنهُ طَيِّبٌ جدًّا، والرَّديءُ جدًّا لا يُمكِنُ أكلُهُ مِنْ رداءتهِ.<verse eid="JER 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="JER 24:4" />ثُمَّ قالَ ليَ الرّبُّ: <verse eid="JER 24:4" /><verse number="5" style="v" pubnumber="5" sid="JER 24:5" />”أنا الرّبُّ إلَهُ إِسرائيلَ أنظُرُ بِعطفٍ إلى الّذينَ أرسَلتُهُم مِنْ أرضِ يَهوذا إلى أرضِ البابليِّينَ كما أنظُرُ إلى هذا التِّينِ الطَّيِّبِ. <verse eid="JER 24:5" /><verse number="6" style="v" pubnumber="6" sid="JER 24:6" />أنظرُ إليهم بِعَطفٍ وأُعيدُهُم إلى هذِهِ الأرضِ وأبنيهِم ولا أهدِمُهُم، وأغرِسُهُم ولا أقلَعُهُم. <verse eid="JER 24:6" /><verse number="7" style="v" pubnumber="7" sid="JER 24:7" />وأُعطيهِم وَعيًا في قُلوبِهِم لِيَعرِفوا أنِّي أنا الرّبُّ، فيكونونَ لي شعبًا وأكونُ لهُم إلهًا، لأنَّهُم يَرجِعونَ إليَّ بِكُلِّ قُلوبِهِم.<verse eid="JER 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="JER 24:8" />”أمَّا صِدْقيَّا مَلِكُ يَهوذا ورُؤساءُ يَهوذا وبَقيَّةُ سُكَّانِ أُورُشليمَ الّذينَ بَقوا في هذِهِ الأرضِ والسَّاكِنونَ في أرضِ مِصْرَ، فأنا الرّبُّ أُعامِلُهُم كهذا التِّينِ الرَّديءِ الّذي لا يُمكِنُ أكلُهُ مِنْ رَداءتِهِ. <verse eid="JER 24:8" /><verse number="9" style="v" pubnumber="9" sid="JER 24:9" />وأُنزِلُ بِهِم شَرًّا يُرعِبُ جميعَ مَمالِكِ الأرضِ، وأجعَلُهُم عارًا وعِبرَةً ومَذَمَّةً ولَعنَةً أينَما طَرَدْتُهُم. <verse eid="JER 24:9" /><verse number="10" style="v" pubnumber="10" sid="JER 24:10" />وأضرِبُهُم بِالسَّيفِ والجُوعِ والوباءِ حتّى يَفنوا مِنَ الأرضِ الّتي أعطَيتُها لهُم ولآبائِهِم“.<verse eid="JER 24:10" /></para>
  <chapter eid="JER 24" />
  <chapter number="25" style="c" sid="JER 25" />
  <para style="s1">العدو الآتي من الشمال</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 25:1" />في السَّنةِ الرَّابِعةِ ليُوياقيمَ بنِ يُوشيَّا مَلِكِ يَهوذا، وهيَ السَّنَةُ الأولى لِنبوخذنَصَّرَ مَلِكِ بابِلَ أوحى الرّبُّ إلى النَّبيِّ إرميا هذِهِ الكَلِمةَ <verse eid="JER 25:1" /><verse number="2" style="v" pubnumber="2" sid="JER 25:2" />الّتي تكَلَّمَ بِها على جميعِ شعبِ يَهوذا وسُكَّانِ أُورُشليمَ، قالَ:<verse eid="JER 25:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="JER 25:3" />”مِنَ السَّنةِ الثَّالثةَ عَشْرَةَ لِيوشيَّا بنِ آمونَ مَلِكِ يَهوذا إلى هذا اليومِ مَضَت ثَلاثٌ وعشرونَ سنَةً على كَلِمةِ الرّبِّ الّتي أوحى بِها إليَّ، فكَلَّمْتُكُم بِها مِرارًا وتَكرارًا فلم تَسمَعوا. <verse eid="JER 25:3" /><verse number="4" style="v" pubnumber="4" sid="JER 25:4" />وسبَقَ وأرسَلَ إليكُم عبيدَهُ الأنبياءَ فلَم تَسمَعوا ولا مِلْتُم آذانَكُم لِتَسمَعوا. <verse eid="JER 25:4" /><verse number="5" style="v" pubnumber="5" sid="JER 25:5" />قالَ لكُم: إِرجِعوا عَنْ طَريقِ الشَّرِّ وسُوءِ التَّصَرُفِ، واَسكُنوا في الأرضِ الّتي أعطَيتُها أنا الرّبُّ لكُم ولآبائِكُم مِن الأزَلِ إلى الأبدِ، <verse eid="JER 25:5" /><verse number="6" style="v" pubnumber="6" sid="JER 25:6" />ولا تَتبَعوا آلِهَةً أُخرى، لِتَعبُدوها وتَسجُدوا لها ولا تُغيظوني بِآلِهَةٍ مِنْ صُنعِ أيديكُم لِئلَّا أُسيءَ إليكُم. <verse eid="JER 25:6" /><verse number="7" style="v" pubnumber="7" sid="JER 25:7" />فلم تَسمَعوا لي يقولُ الرّبُّ، بل أغظتُموني بِآلِهَةٍ مِنْ صُنعِ أيديكُم مِمَّا أدَّى إلى ضرَرِكُم“.<verse eid="JER 25:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="JER 25:8" />لِذلِكَ قالَ الرّبُّ القديرُ: ”بِما أنَّكُم ما سَمِعْتُم لِكَلامي <verse eid="JER 25:8" /><verse number="9" style="v" pubnumber="9" sid="JER 25:9" />فسأُرسِلُ وآخُذُ جميعَ عشائِرِ الشِّمالِ ونبوخذنَصَّرَ مَلِكَ بابِلَ عبدي وأجيءُ بِهِم إلى هذِهِ الأرضِ لِمُحارَبةِ يَهوذا وجميعِ سُكَّانِها والأمَمِ المُجاوِرَةِ لها، فأجعَلُ قَتْلَهُم حَلالًا ومَثارَ رُعْبٍ وصفيرِ هُزءٍ وعارًا أبديًّا. <verse eid="JER 25:9" /><verse number="10" style="v" pubnumber="10" sid="JER 25:10" />وأُبطِلُ فيهِم صوتَ الطَّرَبِ وصوتَ الفرَحِ، صوتَ العريسِ وصوتَ العروسِ، صوتَ الطَّاحونَةِ ونورَ السِّراجِ. <verse eid="JER 25:10" /><verse number="11" style="v" pubnumber="11" sid="JER 25:11" />وتكونُ هذِهِ الأرضُ كُلُّها خَرابًا وقَفْرًا وتَخدُمُ هذِهِ الأمَمُ مَلِكَ بابِلَ سبعينَ سنَةً. <verse eid="JER 25:11" /><verse number="12" style="v" pubnumber="12" sid="JER 25:12" />وعِندَما تَتِمُّ السَّبعونَ سنَةً، أُعاقِبُ مَلِكَ بابِلَ وأُمَّتَهُ على ذُنوبِهِم، كما أُعاقِبُ أرضَ البابِليِّينَ وأجعَلُها خَرابًا أبديًّا. <verse eid="JER 25:12" /><verse number="13" style="v" pubnumber="13" sid="JER 25:13" />وأجلِبُ على سُكَّانِ تِلكَ الأرضِ جميعَ الشُّرورِ الّتي تكَلَّمْتُ بِها علَيها وكُلَّ ما ورَدَ في هذا الكِتابِ وتنَبَّأ بهِ إرميا على جميعِ الأُمَمِ. <verse eid="JER 25:13" /><verse number="14" style="v" pubnumber="14" sid="JER 25:14" />فأُجازيهِم على أفعالِهِم، وأعمالِهِم، فيكونونَ عبيدًا لأمَمٍ كثيرةٍ ومُلوكٍ عِظامٍ“.<verse eid="JER 25:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="JER 25:15" />وقالَ ليَ الرّبُّ إلهُ إِسرائيلَ: ”خُذْ كأسَ غضَبي هذِهِ مِنْ يَدي واَسْقِها جميعَ الأمَمِ الّتي أُرسِلُكَ إليهِم، <verse eid="JER 25:15" /><verse number="16" style="v" pubnumber="16" sid="JER 25:16" />فيَشربونَ ويتَرَنَّحونَ ويفقدونَ صوابَهُم مِنَ السَّيفِ الّذي أُرسِلُهُ بَينَهُم“.<verse eid="JER 25:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="JER 25:17" />فأخَذتُ الكأسَ مِنْ يَدِ الرّبِّ وسَقَيتُها جميعَ الأمَمِ الّذينَ أرسَلَني الرّبُّ إليهِم بَدءًا <verse eid="JER 25:17" /><verse number="18" style="v" pubnumber="18" sid="JER 25:18" />بأُورُشليمَ ومُدُنِ يَهوذا ومُلوكِها ورُؤسائِها، لأجعَلَها خَرابًا وقَفْرًا وصفيرَ هُزءٍ ولَعنَةً كما في هذا اليومِ. <verse eid="JER 25:18" /><verse number="19" style="v" pubnumber="19" sid="JER 25:19" />أمَّا الآخَرونَ الّذينَ يَشربونَ الكأسَ فهُم: فِرعَونُ مَلِكُ مِصْرَ وعبيدُهُ ووُزَراؤُهُ وكُلُّ شعبِهِ <verse eid="JER 25:19" /><verse number="20" style="v" pubnumber="20" sid="JER 25:20" />والأقوامُ الغريبةُ بَينَهُم، وكُلُّ مُلوكِ أرضِ عُوصَ ومُدُنِ الفِلِسطيِّينَ في: أشقَلونَ وغَزَّةَ وعَقرونَ وبَقيَّةِ أشدودَ، <verse eid="JER 25:20" /><verse number="21" style="v" pubnumber="21" sid="JER 25:21" />وأدومَ وموآبَ وبَني عَمُّونَ، <verse eid="JER 25:21" /><verse number="22" style="v" pubnumber="22" sid="JER 25:22" />وكُلُّ مُلوكِ صورَ وصيدونَ والجُزُرِ الّتي في عَبرِ البحرِ، <verse eid="JER 25:22" /><verse number="23" style="v" pubnumber="23" sid="JER 25:23" />ودادانُ وتَيماءُ وبوزُ وكُلُّ مَقصُوصي الشَّعرِ <verse eid="JER 25:23" /><verse number="24" style="v" pubnumber="24" sid="JER 25:24" />وكُلُّ مُلوكِ العربِ وقَبائِلِ الصَّحراءِ <verse eid="JER 25:24" /><verse number="25" style="v" pubnumber="25" sid="JER 25:25" />وكُلُّ مُلوكِ زِمْري وعيلامَ ومادايَ <verse eid="JER 25:25" /><verse number="26" style="v" pubnumber="26" sid="JER 25:26" />وكُلُّ مُلوكِ الشِّمالِ قَريبُهُم وبَعيدُهُم، وواحِدُهُم بَعدَ الآخَرِ، وكُلُّ المَمالِكِ الّتي على وجهِ الأرضِ. ويكونُ مَلِكُ بابِلَ آخِرَ مَنْ يشربُ.<verse eid="JER 25:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="JER 25:27" />وقالَ الرّبُّ القديرُ إلهُ إِسرائيلَ: ”قُلْ لهُمُ إِشرَبوا واَسكَروا وقيِّئُوا واَسقُطوا ولا تقوموا مِنَ السَّيفِ الّذي سَأُرسِلُهُ بَينَكُم. <verse eid="JER 25:27" /><verse number="28" style="v" pubnumber="28" sid="JER 25:28" />وإذا رفَضوا أنْ يأخُذوا الكأْسَ مِنْ يَدكَ لِيَشربوا، فقُلْ لهُم: بل تَشرَبونَ قَسرًا <verse eid="JER 25:28" /><verse number="29" style="v" pubnumber="29" sid="JER 25:29" />فها أنا بَدأتُ أُنزِلُ الشَّرَّ بِهذِهِ المدينةِ الّتي دُعِيَت بِاَسمي، يقولُ الرّبُّ فهل تَنجونَ أنتُم مِنَ العِقابِ؟ لا تَنجونَ مِنَ العِقابِ لأنِّي أجلِب السَّيفَ على جميعِ سُكَّانِ الأرضِ.<verse eid="JER 25:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="JER 25:30" />”وأنتَ فتَنَبَّأْ علَيهِم بِكُلِّ هذا الكَلامِ وقُلْ لهُم:</para>
  <para style="p" vid="JER 25:30">”الرّبُّ مِنَ العَلاءِ يَزأرُ،</para>
  <para style="p" vid="JER 25:30">ومِنْ مَسكِنِهِ المُقَدَّسِ يُطلِقُ صوتَهُ.</para>
  <para style="p" vid="JER 25:30">يزأرُ زَئيرًا على رَعيَّتِهِ،</para>
  <para style="p" vid="JER 25:30">وكالدَّائِسينَ بِعُنفٍ يَهتِفُ عاليًا</para>
  <para style="p" vid="JER 25:30">على جميعِ سُكَّانِ الأرضِ.<verse eid="JER 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" pubnumber="31" sid="JER 25:31" />العَجيجُ بلَغَ أقاصيَ الأرضِ</para>
  <para style="p" vid="JER 25:31">لأنَّ لِلرّبِّ خِصامًا معَ الأمَمِ</para>
  <para style="p" vid="JER 25:31">فيُحاكِمُ البشَرَ جميعًا.</para>
  <para style="p" vid="JER 25:31">ويَدفَعُ الأشرارَ إلى السَّيفِ.<verse eid="JER 25:31" /></para>
  <para style="p">
    <verse number="32" style="v" pubnumber="32" sid="JER 25:32" />”وقال ليَ الرّبُّ القديرُ:</para>
  <para style="p" vid="JER 25:32">سيَخرُجُ الشَّرُّ مِنْ أُمَّةٍ إلى أُمَّةٍ،</para>
  <para style="p" vid="JER 25:32">وتَثورُ زَوبَعَةٌ مِنْ أطراف الأرضِ.<verse eid="JER 25:32" /></para>
  <para style="p">
    <verse number="33" style="v" pubnumber="33" sid="JER 25:33" />القَتْلى تَنتَشِرُ في ذلِكَ اليومِ،</para>
  <para style="p" vid="JER 25:33">مِنْ أقصى الأرضِ إلى أقصاها،</para>
  <para style="p" vid="JER 25:33">لا يُندَبونَ ولا يُجمَعونَ ولا يُدفَنونَ،</para>
  <para style="p" vid="JER 25:33">بل يكونونَ زِبْلًا على وجهِ الأرضِ“.<verse eid="JER 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" pubnumber="34" sid="JER 25:34" />ولوِلوا، أيُّها الرُّعاةُ واَصرُخوا،</para>
  <para style="p" vid="JER 25:34">وتَمَرَّغوا في الرَّمادِ يا أسيادَ القطيعِ،</para>
  <para style="p" vid="JER 25:34">حانَ الوقتُ لِذَبحِكُم وتَبديدِكُم</para>
  <para style="p" vid="JER 25:34">فتَسقُطونَ كالعُجولِ المُسَمَّنَةِ.<verse eid="JER 25:34" /></para>
  <para style="p">
    <verse number="35" style="v" pubnumber="35" sid="JER 25:35" />يَزولُ كُلُّ مَلجأٍ عَنِ الرُّعاةِ</para>
  <para style="p" vid="JER 25:35">وكُلُّ نَجاةٍ عَنْ أسيادِ القطيعِ.<verse eid="JER 25:35" /></para>
  <para style="p">
    <verse number="36" style="v" pubnumber="36" sid="JER 25:36" />ويُسمَعُ صوتُ صُراخِ الرُّعاةِ</para>
  <para style="p" vid="JER 25:36">ووَلوَلَةُ أسيادِ القطيعِ.</para>
  <para style="p" vid="JER 25:36">لأنَّ الرّبَّ دَمَّرَ مراعيَهُم<verse eid="JER 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" pubnumber="37" sid="JER 25:37" />فهَلَكَتْ قُطعانُهُمُ الوادِعَةُ</para>
  <para style="p" vid="JER 25:37">مِنْ شِدَّةِ غضَبِ الرّبِّ.<verse eid="JER 25:37" /></para>
  <para style="p">
    <verse number="38" style="v" pubnumber="38" sid="JER 25:38" />هجَرَ الشِّبلُ عَرينَهُ،</para>
  <para style="p" vid="JER 25:38">لأنَّ أرضَهُم صارَت خَرابًا</para>
  <para style="p" vid="JER 25:38">مِنَ السَّيفِ الّذي لا يرحَمُ</para>
  <para style="p" vid="JER 25:38">ومِنْ حِدَّةِ غضَبِ الرّبِّ.<verse eid="JER 25:38" /></para>
  <chapter eid="JER 25" />
  <chapter number="26" style="c" sid="JER 26" />
  <para style="s1">محاكمة إرميا</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 26:1" />في بَدءِ عَهدِ يوياقيمَ بنِ يُوشيَّا مَلِكِ يَهوذا قالَ الرّبُّ لإرميا <verse eid="JER 26:1" /><verse number="2" style="v" pubnumber="2" sid="JER 26:2" />”قِفْ في دارِ هيكَلِ الرّبِّ وخاطِبِ الّذينَ يَحضُرونَ لِلسُّجودِ هُناكَ في مُدُنِ يَهوذا بجميعِ ما آمُرُكَ بهِ ولا تُنقِصْ كلِمَةً <verse eid="JER 26:2" /><verse number="3" style="v" pubnumber="3" sid="JER 26:3" />لَعلَّهُم يَسمَعونَ ويَرجِعونَ كُلُّ واحدٍ عَنْ طريقِ الشَّرِّ، فأندَمَ على الشَّرِّ الّذي نَوَيتُ أنْ أُنزِلَهُ بِهِم جَزاءَ شَرِّ أعمالِهِم <verse eid="JER 26:3" /><verse number="4" style="v" pubnumber="4" sid="JER 26:4" />وقُلْ لهُم: إنْ كُنتُم لا تَسمَعونَ لي ولا تَسلُكونَ في شَريعتي الّتي جعَلْتُها أمامَكُم <verse eid="JER 26:4" /><verse number="5" style="v" pubnumber="5" sid="JER 26:5" />وتُصغونَ إلى كلامِ عبيدي الأنبياءِ الّذينَ أرسلتُهُم إِليكُم مِرارًا وتَكرارًا ولَم تُصغوا إليهِم <verse eid="JER 26:5" /><verse number="6" style="v" pubnumber="6" sid="JER 26:6" />فسأفعَلُ بِهذا الهَيكَلِ كما فعَلْتُ بِشيلوهَ وأجعَلُ هذِهِ المدينةَ لَعنَةً لِجميعِ أُمَمِ الأرضِ“.<verse eid="JER 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="JER 26:7" />فسَمِعَ الكَهنَةُ والأنبياءُ وكُلُّ الشَّعبِ إرميا يتَكَلَّمُ بِهذا الكلامِ في هيكَلِ الرّبِّ، <verse eid="JER 26:7" /><verse number="8" style="v" pubnumber="8" sid="JER 26:8" />وهوَ الكلامُ الّذي أمَرَهُ بهِ الرّبُّ. فلمَّا فرَغَ قَبَضوا علَيهِ وقالوا لَه: ”موتًا تموتُ! <verse eid="JER 26:8" /><verse number="9" style="v" pubnumber="9" sid="JER 26:9" />كيفَ تنَبَّأْتَ باَسمِ الرّبِّ أنْ يصيرَ هذا الهيكَلُ كمَصيرِ شيلوهَ وتصيرَ هذِهِ المدينةُ خَرابًا لا ساكِنَ فيها؟“ واَجتَمعَ الشَّعبُ كُلُّهُ إلى إرميا في هيكَلِ الرّبِّ.<verse eid="JER 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="JER 26:10" />فسَمِعَ رُؤساءُ يَهوذا بذلِكَ، فصَعِدوا مِنْ قصرِ المَلِكِ إلى هيكَلِ الرّبِّ وجلَسوا في مدخَلِ البابِ الجديدِ. <verse eid="JER 26:10" /><verse number="11" style="v" pubnumber="11" sid="JER 26:11" />فقالَ لهُمُ الكَهنَةُ والأنبياءُ وكُلُّ الشَّعبِ: ”هذا الرَّجُلُ يَستَحِقُّ الحُكْمَ علَيهِ بالموتِ لأنَّهُ تَنَبَّأ على هذِهِ المدينةِ، كما سَمِعْتُم بِآذانِكُم“.<verse eid="JER 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="JER 26:12" />وقال إرميا للرُّؤساءِ والشَّعبِ كُلِّه: ”الرّبُّ أرسلني لأتنبَّأَ على هذا الهيكَلِ وعلى هذِهِ المدينةِ بجميعِ الكلامِ الّذي سَمِعتُموه. <verse eid="JER 26:12" /><verse number="13" style="v" pubnumber="13" sid="JER 26:13" />فالآنَ أصلِحوا طُرقَكُم وأعمالَكُم واَسمعوا لصوتِ الرّبِّ إلهِكُم، فيَندمَ على الشَّرِّ الّذي تكلَّمَ بهِ علَيكُم. <verse eid="JER 26:13" /><verse number="14" style="v" pubnumber="14" sid="JER 26:14" />أمَّا أنا ففي أيديكم، فاَفعلوا بي ما ترَونَهُ حَقًّا وعدلًا. <verse eid="JER 26:14" /><verse number="15" style="v" pubnumber="15" sid="JER 26:15" />ولكنِ اَعلموا حَقَّ العِلْمِ أنَّكُم إنْ قتَلتُموني تَسفُكونَ دمًا بريئًا يقعُ علَيكُم وعلى هذِهِ المدينةِ وسُكَّانِها، لأنَّ الرّبَّ أرسلَني حَقًّا إليكُم لأتَكلَّمَ على مسامِعِكُم بِكُلِّ هذا الكَلامِ“.<verse eid="JER 26:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="JER 26:16" />فقالَ الرُّؤساءُ وكُلُّ الشَّعبِ لِلكَهنَةِ والأنبياءِ: ”هذا الرَّجلُ لا يَستَحِقُّ الحُكْمَ علَيهِ بالموتِ، فهوَ باَسمِ الرّبِّ إلَهِنا كَلَّمَنا“.<verse eid="JER 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="JER 26:17" />فقامَ بَعضُ شُيوخِ الشَّعبِ وقالوا للحاضرينَ جميعًا: <verse eid="JER 26:17" /><verse number="18" style="v" pubnumber="18" sid="JER 26:18" />”في أيّامِ حزقيَّا مَلِكِ يَهوذا تَنَبَّأ ميخا المُورَشْتيُّ، وقالَ لِشعبِ يَهوذا: قالَ الرّبُّ القديرُ سَتُفلَحُ صِهيونُ كحَقلٍ، وتَصيرُ أُورُشليمُ أطلالًا وجبَلُ بَيتِ الرّبِّ تِلالًا وَعرَةً. <verse eid="JER 26:18" /><verse number="19" style="v" pubnumber="19" sid="JER 26:19" />فهل قتَلَهُ حزقيَّا مَلِكُ يَهوذا أو قتَلَهُ سُكَّانُها؟ أمَا خافَ الرّبَّ واَستَعطَفَهُ، فنَدِمَ الرّبُّ على الشَّرِّ الّذي تكَلَّمَ بهِ علَيهِم؟ فنَحنُ إنْ قَتَلْنا هذا الرَّجلَ نَجلِبُ على أنفُسِنا شَرًّا عظيمًا“.<verse eid="JER 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="JER 26:20" />وفي تِلكَ الأيّامِ كانَ رَجُلٌ آخرُ يتَنَبَّأُ بِاَسمِ الرّبِّ. وهوَ أُوريَّا بنُ شِمْعيَّا مِنْ قريةِ يَعاريمَ، فتَنَبَّأ على هذِهِ المدينةِ وعلى هذِهِ الأرضِ بِمِثلِ ما تَنَبَّأ إرميا. <verse eid="JER 26:20" /><verse number="21" style="v" pubnumber="21" sid="JER 26:21" />فسَمِعَ كَلامَهُ المَلِكُ يوياقيمُ وجُنودُهُ وكُلُّ الرُّؤساءِ فطَلبَ المَلِكُ أنْ يَقتُلَهُ. فلمَّا سَمِعَ أُوريَّا بذلِكَ خافَ وهربَ إلى مِصْرَ. <verse eid="JER 26:21" /><verse number="22" style="v" pubnumber="22" sid="JER 26:22" />فأرسلَ المَلِكُ يوياقيمُ ألناثانَ بنَ عكبورَ ورِجالًا يَصحَبونَهُ إلى مِصْرَ. <verse eid="JER 26:22" /><verse number="23" style="v" pubnumber="23" sid="JER 26:23" />فأخرَجوا أُوريَّا مِنْ مِصْرَ وجاؤوا بهِ إلى المَلِكِ يوياقيمَ، فقَتَلَهُ بِالسَّيفِ وطرَحَ جُثَّتَهُ في قُبورِ عامَّةِ الشَّعبِ.<verse eid="JER 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="JER 26:24" />أمَّا إرميا فكانَت تَحميهِ يَدُ أحيقامَ بنِ شافانَ لِئلَّا يُسلَّمَ إلى أيدي الشَّعبِ فيَقتُلوهُ.<verse eid="JER 26:24" /></para>
  <chapter eid="JER 26" />
  <chapter number="27" style="c" sid="JER 27" />
  <para style="s1">نير إرميا</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 27:1" />في بَدءِ عَهدِ يوياقيمَ مَلِكِ يَهوذا قالَ الرّبُّ لإرميا: <verse eid="JER 27:1" /><verse number="2" style="v" pubnumber="2" sid="JER 27:2" />”إِصنعْ لكَ بِالرُّبُطِ والأتادِ نيرًا واَجعَلْهُ في عُنُقِكَ <verse eid="JER 27:2" /><verse number="3" style="v" pubnumber="3" sid="JER 27:3" />واَرسِلْ مِثلَهُ إلى كُلٍّ مِنْ مُلوكِ أدومَ وموآبَ وبَني عَمُّونَ وصورَ وصَيدونَ وبأيدي الرُّسلِ القادمينَ إلى أُورُشليمَ إلى صِدْقيَّا مَلِكِ يَهوذا. <verse eid="JER 27:3" /><verse number="4" style="v" pubnumber="4" sid="JER 27:4" />وأمَرَهُم أنْ يقولوا لِسادَتِهِم: قالَ الرّبُّ القديرُ إلهُ إِسرائيلَ: قولوا لسادَتِكُم: <verse eid="JER 27:4" /><verse number="5" style="v" pubnumber="5" sid="JER 27:5" />أنا صَنَعتُ الأرضَ والبشَرَ والبَهائِمَ الّتي على وجهِ الأرضِ بِقُدرَتي العظيمةِ وذِراعي المَبسوطَةِ وأعطَيتُها لِمَنْ حَسُنَ في عيني.<verse eid="JER 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="JER 27:6" />”والآن جعَلْتُ جميعَ هذِهِ الأراضي في يَدِ نبوخذنَصَّرَ مَلِكِ بابِلَ عبدي، وأعطَيتُهُ أيضًا وحوشَ البرِّيَّةِ لِتَخدُمَهُ. <verse eid="JER 27:6" /><verse number="7" style="v" pubnumber="7" sid="JER 27:7" />فتكونُ جميعُ الأمَمِ عبيدًا لَه ولاَبنِهِ ولاَبنِ اَبنِهِ مِنْ بَعدِهِ إلى أنْ يَحينَ أجَلُ أُمَّتِهِ أيضًا، فتَستَعبِدُها أُمَمٌ قَويَّةٌ ومُلوكٌ عِظامٌ. <verse eid="JER 27:7" /><verse number="8" style="v" pubnumber="8" sid="JER 27:8" />وكُلُّ أمَّةٍ أو مَملَكَةٍ لا تَخضَعُ لِنبوخذنَصَّرَ مَلِكِ بابِلَ ولا تَجعَلُ عُنُقَها تَحتَ نيرِهِ، فإنِّي أُعاقِبُها بالسَّيفِ والجُوعِ والوَباءِ، حتّى أفنيَها بيدِهِ. <verse eid="JER 27:8" /><verse number="9" style="v" pubnumber="9" sid="JER 27:9" />فلا تَسمَعوا لأنبيائِكُم وعَرَّافيكُم وحالِميكُم ومُشَعوذيكُم وسَحَرَتِكُمُ الّذينَ يقولونَ لكُم: لا تَخضَعوا لِمَلِكِ بابِلَ. <verse eid="JER 27:9" /><verse number="10" style="v" pubnumber="10" sid="JER 27:10" />فهُم يتَنَبَّأُونَ لكُم بِالزُّورِ لِيُبعدوكُم عَنْ أرضِكُم ولأطرُدَكُم أنا فتَهلكوا. <verse eid="JER 27:10" /><verse number="11" style="v" pubnumber="11" sid="JER 27:11" />أمَّا الأمَّةُ الّتي تَضَعُ عُنُقَها تَحتَ نيرِ مَلِكِ بابِلَ وتَخدُمُهُ، فأُبقيها في أرضِها لِتَفلَحَها وتَسكُنَ فيها“.<verse eid="JER 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="JER 27:12" />وكَلَّمْتُ صِدْقيَّا مَلِكَ يَهوذا بِكُلِّ هذا الكلامِ. قُلتُ لَه: ”ضَعوا أعناقَكُم تَحتَ نيرِ مَلِكِ بابِلَ واَخدُموهُ هوَ وشَعبُهُ فتَحيوا. <verse eid="JER 27:12" /><verse number="13" style="v" pubnumber="13" sid="JER 27:13" />فلِماذا تموتونَ أنتَ وشعبُك بِالسَّيفِ والجوعِ والوَباءِ، كما تَكلَّمَ الرّبُّ على الأمَّةِ الّتي لا تَخدُمُهُ؟“ <verse eid="JER 27:13" /><verse number="14" style="v" pubnumber="14" sid="JER 27:14" />فلا تَسمَعوا لِكلامِ الأنبياءِ الّذينَ يقولونَ لكُم: ”لا تَخدُموا مَلِكَ بابلَ. فهؤلاءِ يتَنَبَّأونَ لكُم بِالزُّورِ، <verse eid="JER 27:14" /><verse number="15" style="v" pubnumber="15" sid="JER 27:15" />وأنا لم أُرسِلْهُم يقولُ الرّبُّ، وهُم يتَنَبَّأُونَ بِاَسمي زُورًا لأطرُدَكُم، فتَهلكوا أنتُم والأنبياءُ الّذينَ تَنَبَّأُوا لكُم“.<verse eid="JER 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="JER 27:16" />وقُلتُ لِلكَهنَةِ ولِكُلِّ هذا الشَّعبِ: ”قالَ الرّبُّ: لا تَسمَعوا لِكلامِ أنبيائِكُمُ الّذينَ يَقولونَ لكُم: عَنْ قريبٍ تُستَرَدُّ آنيةُ هيكَلِ الرّبِّ مِنْ بابِلَ. فهؤلاءِ يتَنَبَّأُونَ لكُم بِالزُّورِ. <verse eid="JER 27:16" /><verse number="17" style="v" pubnumber="17" sid="JER 27:17" />لا تَسمَعوا لهُم، بلِ اَخدُموا مَلِك بابِلَ واَنجُوا بِحياتِكُم. فلِماذا تصيرُ هذِهِ المدينةُ خَرابًا؟<verse eid="JER 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="JER 27:18" />”فإنْ كانوا أنبياءَ حَقًّا وكانَ كلامهُم مِنَ الرّبِّ القديرِ، فليَتَوسَّلوا إليهِ أنْ لا يؤخَذَ إلى بابِلَ ما بَقيَ مِنَ الآنيةِ في هيكَلِ الرّبِّ وقصرِ مَلِكِ يَهوذا وفي أُورُشليمَ <verse eid="JER 27:18" /><verse number="19" style="v" pubnumber="19" sid="JER 27:19" />لأنَّ الرّبَّ القديرَ تكَلَّمَ على الأعمِدَةِ وحوَضِ النُّحاسِ والقواعدِ وسائِرِ الآنيةِ الباقيةِ في المدينةِ <verse eid="JER 27:19" /><verse number="20" style="v" pubnumber="20" sid="JER 27:20" />ما ترَكَهُ نبوخذنَصَّرُ مَلِكُ بابِلَ لمَّا سبَى يكنيا بنَ يوياقيمَ مَلِكَ يَهوذا مِنْ أُورُشليمَ إلى بابِلَ معَ كُلِّ أشرافِ يَهوذا وأُورُشليمَ. <verse eid="JER 27:20" /><verse number="21" style="v" pubnumber="21" sid="JER 27:21" />نعم، هذا ما تَكلَّمَ بهِ الرّبُّ القديرُ إلهُ إِسرائيلَ على ما بَقيَ مِنَ الآنيةِ في هيكَلِ الرّبِّ وقصرِ المَلِكِ وأُورُشليمَ: <verse eid="JER 27:21" /><verse number="22" style="v" pubnumber="22" sid="JER 27:22" />ستُؤخَذُ إلى بابِلَ وتكونُ هُناكَ إلى يومِ أُعاقِبُ بابِلَ. فأستَرِدُّها في ذلِكَ الوقتِ وأُعيدُها إلى هذا المَوضِعِ“.<verse eid="JER 27:22" /></para>
  <chapter eid="JER 27" />
  <chapter number="28" style="c" sid="JER 28" />
  <para style="s1">إرميا والنبي حننيَّا</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 28:1" />وفي الشَّهرِ الخامِسِ مِنْ تِلكَ السَّنَة، في بَدءِ عَهدِ صِدْقيَّا مَلِكِ يَهوذا، قالَ لي حننيَّا بنُ عَزورَ النَّبيّ الّذي مِنْ جِبعونَ، في هيكَلِ الرّبِّ أمامَ الكهَنَةِ وكُلِّ الشَّعبِ: <verse eid="JER 28:1" /><verse number="2" style="v" pubnumber="2" sid="JER 28:2" />”هذا ما قالَ الرّبُّ القديرُ إلهُ إِسرائيلَ: كسَرتُ نيرَ مَلِكِ بابِلَ، <verse eid="JER 28:2" /><verse number="3" style="v" pubnumber="3" sid="JER 28:3" />وبَعدَ سنَتَينِ أرُدُّ إلى هذا المَوضعِ كُلَّ آنِيةِ هيكَلِ الرّبِّ الّتي أخذَها نبوخذنَصَّرُ مَلِكُ بابِلَ مِنْ هذا المَوضِعِ وذهَبَ بِها إلى بابِلَ، <verse eid="JER 28:3" /><verse number="4" style="v" pubnumber="4" sid="JER 28:4" />وأرُدُّ إلى هذا الموضِعِ يكُنيا بنَ يوياقيمَ مَلِكَ يَهوذا وجميعَ سَبْي يَهوذا الّذينَ ذهَبوا إلى بابِلَ، لأنِّي أكسِرُ نيرَ مَلِكِ بابِلَ يقولُ الرّبُّ“.<verse eid="JER 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="JER 28:5" />فقالَ إرميا النَّبيُّ لِحنَنيَّا النَّبيِّ أمامَ الكَهنَةِ وأمامَ كُلِّ الشَّعبِ الواقِفينَ في بَيتِ الرّبِّ: <verse eid="JER 28:5" /><verse number="6" style="v" pubnumber="6" sid="JER 28:6" />”آمينَ. لِيَفعَلِ الرّبُّ هكذا. لِيُتِمَّ الرّبُّ كَلامَكَ الّذي تنَبَّأتَ بهِ ويَرُدَّ آنيَةَ هيكَلِ الرّبِّ وكُلَّ المَسبيِّينَ مِنْ بابِلَ إلى هذا المَوضِعِ. <verse eid="JER 28:6" /><verse number="7" style="v" pubnumber="7" sid="JER 28:7" />لَكنِ إِسمَعْ ما أقولُ في أُذُنَيكَ وفي آذانِ الشَّعبِ كُلِّهِ: <verse eid="JER 28:7" /><verse number="8" style="v" pubnumber="8" sid="JER 28:8" />الأنبياءُ الّذينَ كانوا قَبلي وقَبلَكَ مِنْ قديمِ الزَّمانِ تنَبَّأُوا على أراضٍ كثيرةٍ وممالِكَ عظيمةٍ بِالحربِ والشَّرِّ والوباءِ. <verse eid="JER 28:8" /><verse number="9" style="v" pubnumber="9" sid="JER 28:9" />أمَّا النَّبيُّ الّذي يتَنَبَّأ بِالسَّلامِ، فعِندما تَتِمُّ نبوءته، يَعرِفُ أنَّ الرّبَّ أرسلَهُ حَقًّا“.<verse eid="JER 28:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="JER 28:10" />فأخذَ حنَنيَّا النَّبيُّ النِّيرَ عَنْ عُنُقِ إرميا النَّبيِّ وكَسرَهُ <verse eid="JER 28:10" /><verse number="11" style="v" pubnumber="11" sid="JER 28:11" />وقالَ أمامَ كُلِّ الشَّعبِ: ”هذا ما قالَ الرّبُّ: كذلِكَ أكسِرُ نيرَ نبوخذنَصَّرَ مَلِكِ بابِلَ بَعدَ سنَتَينِ عَنْ أعناقِ جميعِ الأمَمِ“. ومضى إرميا في طريقِهِ.<verse eid="JER 28:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="JER 28:12" />فقالَ الرّبُّ لإرميا، بَعدَ أنْ كَسرَ حنَنيَّا النَّبيُّ النِّيرَ عَنْ عُنُقِ إرميا: <verse eid="JER 28:12" /><verse number="13" style="v" pubnumber="13" sid="JER 28:13" />”إذهَبْ وقُلْ لِحننيَّا: هذا ما قالَ الرّبُّ: كَسَرتَ نيرًا مِنْ خشَبٍ، لكنِّي صَنَعتُ عِوَضَهُ نيرًا مِنْ حديدٍ، <verse eid="JER 28:13" /><verse number="14" style="v" pubnumber="14" sid="JER 28:14" />لأنَّ هذا ما قالَ الرّبُّ القديرُ إلهُ إِسرائيلَ: جَعَلتُ نيرًا مِنْ حديدٍ على أعناقِ جميعِ هذِهِ الشُّعوبِ لِيَخدُموا نبوخذنَصَّرَ مَلِكَ بابِلَ، وأعطَيتُهُ أيضًا وُحوشَ البرِّيَّةِ“.<verse eid="JER 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="JER 28:15" />فقالَ إرميا النَّبيُّ لِحننيَّا النَّبيِّ: ”إسمَعْ يا حنَنيَّا! ما أرسلَكَ الرّبُّ، وأنتَ جعَلْتَ هذا الشَّعبَ يَعتَمِدُ على الكَذِبِ. <verse eid="JER 28:15" /><verse number="16" style="v" pubnumber="16" sid="JER 28:16" />لذلِكَ قالَ الرّبُّ: ”سَأنفيكَ عَنْ وجهِ الأرضِ، وفي هذِهِ السَّنةِ تموتُ، لأنَّكَ تكلَّمْتَ بِالعِصيانِ على الرّبِّ“. <verse eid="JER 28:16" /><verse number="17" style="v" pubnumber="17" sid="JER 28:17" />فماتَ حننيَّا النَّبيُّ في الشَّهرِ السَّابعِ مِنْ تِلكَ السَّنةِ.<verse eid="JER 28:17" /></para>
  <chapter eid="JER 28" />
  <chapter number="29" style="c" sid="JER 29" />
  <para style="s1">إرميا يكتب إلى اليهود في بابل</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 29:1" />هذا نَصُّ الكتابِ الّذي أرسلَهُ إرميا النَّبيُّ مِنْ أُورُشليمَ إلى بَقيَّةِ الشُّيوخِ في السَّبْي، وإلى الكهنَةِ والأنبياءِ وعُمومِ الّذينَ سَباهُم نَبوخذنَصَّرُ مِنْ أُورُشليمَ إلى بابِلَ، <verse eid="JER 29:1" /><verse number="2" style="v" pubnumber="2" sid="JER 29:2" />بَعدَ أنْ خرَجَ يكُنيا المَلِكُ والمَلِكَةُ والخِصيانُ ورُؤساءُ يَهوذا وأُورُشليمَ والنَّجَّارونَ والحَدَّادونَ مِنْ أُورُشليمَ. <verse eid="JER 29:2" /><verse number="3" style="v" pubnumber="3" sid="JER 29:3" />كانَ ذلِكَ على يَدِ ألعاسةَ بنِ شافانَ وجَمَرْيا بنِ حَلْقيَّا اللَّذينَ أوفَدَهُما صِدقيَّا مَلِكُ يَهوذا إلى نبوخذنَصَّرَ مَلِكِ بابِلَ، وفيهِ يقولُ: <verse eid="JER 29:3" /><verse number="4" style="v" pubnumber="4" sid="JER 29:4" />”قالَ الرّبُّ القديرُ إلهُ إِسرائيلَ لِكُلِّ الّذينَ سَبَيتُهُم مِنْ أُورُشليمَ إلى بابِلَ: <verse eid="JER 29:4" /><verse number="5" style="v" pubnumber="5" sid="JER 29:5" />إبنوا بُيوتًا واَسكُنوا واغرُسوا بساتينَ وكُلوا مِنْ ثمَرِها. <verse eid="JER 29:5" /><verse number="6" style="v" pubnumber="6" sid="JER 29:6" />تَزَوَّجوا ولِدوا بَنينَ وبَناتٍ وزَوِّجوا بَنيكُم وبَناتِكُم لِيَلِدوا بَنينَ وبَناتٍ، وأكثِروا هُناكَ ولا تَقِلُّوا. <verse eid="JER 29:6" /><verse number="7" style="v" pubnumber="7" sid="JER 29:7" />إعمَلوا لِخَيرِ المدينةِ الّتي سبَيتُكُم إليها، وصلُّوا مِنْ أجلِها. ففي خَيرِها خَيرُكُم. <verse eid="JER 29:7" /><verse number="8" style="v" pubnumber="8" sid="JER 29:8" />لأنَّهُ هذا ما قالَ الرّبُّ القديرُ إلهُ إِسرائيلَ: لا يُضِلَّكُم أنبياؤُكُم والعَرَّافونَ الّذينَ بَينَكُم، ولا تَسمَعوا لِلأحلامِ الّتي يَحلمونَ. <verse eid="JER 29:8" /><verse number="9" style="v" pubnumber="9" sid="JER 29:9" />فهُم يتَنَبَّأونَ لكُم باَسمي زُورًا، وأنا لم أُرسِلْهُم يقولُ الرّبُّ.<verse eid="JER 29:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="JER 29:10" />”وقالَ الرّبُّ: عِندَما تَتِمُّ لكُم سَبعونَ سنَةً في بابِلَ أتفَقَّدُكُم وأبُرُّ بِوَعدي لكُم، فأُعيدُكُم إلى هذا المَوضِعِ. <verse eid="JER 29:10" /><verse number="11" style="v" pubnumber="11" sid="JER 29:11" />أنا أعرِفُ ما نَوَيتُ لكُم مِنْ خَيرٍ لا مِنْ شَرٍّ، فيكونُ لكُمُ الغَدُ الّذي تَرجونَ. <verse eid="JER 29:11" /><verse number="12" style="v" pubnumber="12" sid="JER 29:12" />فتَدعونَني وتَجيئونَ وتُصَلُّونَ إليَّ فأستَمِع لكُم، <verse eid="JER 29:12" /><verse number="13" style="v" pubnumber="13" sid="JER 29:13" />وتَطلُبونَني فتَجِدونَني إذا طلَبتُموني بِكُلِّ قُلوبِكُم. <verse eid="JER 29:13" /><verse number="14" style="v" pubnumber="14" sid="JER 29:14" />وأُوجَدُ بَينَكُم وأُعيدُ لكُم أمجادَكُم وأجمَعُكُم مِنْ بَينِ كُلِّ الأُمَمِ ومِنْ جميعِ المَواضعِ الّتي طَرَدْتُكُم إليها، وأُعيدُكُم إلى المَوضعِ الّذي سَبَيتُكُم مِنهُ.<verse eid="JER 29:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="JER 29:15" />”فأجبتُم: أقامَ الرّبُّ لنا أنبياءَ في بابِلَ. <verse eid="JER 29:15" /><verse number="16" style="v" pubnumber="16" sid="JER 29:16" />لكِنِ اَسمَعوا ما قالَ الرّبُّ على المَلِكِ الجالِسِ على عرشِ داوُدَ، وعلى جميعِ السَّاكنينَ في هذِهِ المدينةِ مِنْ إخوتِكُمُ الّذينَ بَقوا وما خرَجوا معَكُم إلى السَّبْي: <verse eid="JER 29:16" /><verse number="17" style="v" pubnumber="17" sid="JER 29:17" />سأُرسِلُ علَيهِم السَّيفَ والجُوعَ والوباءَ وأجعَلُهُم كتينٍ رَديءٍ لا يُؤكَلُ لِرداءَتِهِ. <verse eid="JER 29:17" /><verse number="18" style="v" pubnumber="18" sid="JER 29:18" />وأطرُدُهُم بِالسَّيفِ والجوعِ والوباءِ وأجعَلُهُم مَثارَ رُعْبٍ في جميعِ مَمالِكِ الأرضِ ولَعنَةً وهَولًا وصفيرَ هُزءٍ وعارًا عِندَ جميعِ الأمَمِ الّتي طرَدْتُهُم إليها، <verse eid="JER 29:18" /><verse number="19" style="v" pubnumber="19" sid="JER 29:19" />لأنَّهُم لا يَسمعونَ لِكلامي، وهوَ الكلامُ الّذي أرسَلْتُ على لِسانِ عبيدي الأنبياءِ مِرارًا وتَكرارًا، وأنتُم لم تَسمَعوا لهُم.<verse eid="JER 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="JER 29:20" />”فاَسمعوا يا جميعَ الّذينَ سُبيتُم مِنْ أُورُشليمَ إلى بابِلَ. <verse eid="JER 29:20" /><verse number="21" style="v" pubnumber="21" sid="JER 29:21" />ما قالَ الرّبُّ القديرُ إلهُ إِسرائيلَ على أخابَ بنِ قولايا وعَنْ صِدْقيَّا بنِ مَعِسيَّا اللَّذَينِ يتَنَبَّآنِ لكُم بِاَسمي زُورًا: سأُسلِمُهُما إلى يَدِ نبوخذنَصَّرَ مَلِكِ بابِلَ، فيَقتُلُهُما أمامَ عُيونِكُم، <verse eid="JER 29:21" /><verse number="22" style="v" pubnumber="22" sid="JER 29:22" />وتُحسَبُ عاقِبَتُهُما لَعنَةً بَينَ جميعِ سَبْي يَهوذا الّذينَ في بابِلَ، فيُقالُ: جعَلَكَ الرّبُّ كصِدْقيَّا وكأخابَ اللَّذَينِ قلاهُما مَلِكُ بابِلَ بالنَّارِ، <verse eid="JER 29:22" /><verse number="23" style="v" pubnumber="23" sid="JER 29:23" />لأنَّهُما اَرتكَبا حماقَةً في إِسرائيلَ، وزَنيا معَ نِساءِ أصحابِهِما، وتكَلَّما بِاَسمي كلامًا كاذبًا ما أمرتُهُما بهِ. أنا أعرِفُ وأشهَدُ يقولُ الرّبُّ“.<verse eid="JER 29:23" /></para>
  <para style="s1">كتاب إلى شمعيا</para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="JER 29:24" />وقُلْ لِشمعيا النِّحلاميِّ: <verse eid="JER 29:24" /><verse number="25" style="v" pubnumber="25" sid="JER 29:25" />”قالَ الرّبُّ القديرُ إلهُ إِسرائيلَ: أنتَ كتَبتَ بِاَسمِكَ إلى عُمومِ الّذينَ في أُورُشليمَ، وإلى صفَنيا بنِ مَعسيَّا الكاهنِ، وإلى جميعِ الكَهنَةِ، وإلى صفَنيا تقولُ لَه: <verse eid="JER 29:25" /><verse number="26" style="v" pubnumber="26" sid="JER 29:26" />”أقامَكَ الرّبُّ كاهِنًا مكانَ يوياداعَ الكاهنِ لِتكونَ وكيلًا في بَيتِ الرّبِّ على كُلِّ رَجُلٍ مَجنونٍ ومُتَنَبِّئٍ، فتُقَيِّدُهُ وتَحبِسُ رِجلَيهِ في الخشبَةِ. <verse eid="JER 29:26" /><verse number="27" style="v" pubnumber="27" sid="JER 29:27" />والآنَ، فلِماذا لا تُوَبِّخُ إرميا العَناتوتيَّ الّذي يتَنَبَّأُ لكُم؟ <verse eid="JER 29:27" /><verse number="28" style="v" pubnumber="28" sid="JER 29:28" />فهوَ كتبَ إلينا في بابِلَ يقولُ: السَّبيُ طويلٌ، فاَبنوا لكُم بُيوتًا واَسكُنوا، واغرُسوا بساتينَ وكُلوا مِنْ ثمَرِها“.<verse eid="JER 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="JER 29:29" />وقرأَ صفَنيا الكاهنُ ما كتَبَهُ شِمعيا لَه على مَسامِعِ إرميا النَّبيِّ. <verse eid="JER 29:29" /><verse number="30" style="v" pubnumber="30" sid="JER 29:30" />ثُمَّ قالَ الرّبُّ لإرميا: <verse eid="JER 29:30" /><verse number="31" style="v" pubnumber="31" sid="JER 29:31" />”أرسِلْ إلى جميعِ المَسبيِّينَ قائِلًا: ”هذا ما قالَ الرّبُّ على شِمعيا النِّحلاميّ: بِما أنَّهُ تنَبَّأَ لكُم، وأنا لم أرسِلْهُ، وجعَلَكُم تَعتَمِدونَ على الكَذِبِ، <verse eid="JER 29:31" /><verse number="32" style="v" pubnumber="32" sid="JER 29:32" />فسأُعاقِبُ شمعيا النَّحلاميّ وذُرِّيَّتَهُ، فلا يكونُ لَه مِنْ نَسلِهِ مَنْ يُقيمُ بَينَ هذا الشَّعبِ، ولا يَرى الخَيرَ الّذي سأعمَلُهُ لِشعبي، لأنَّهُ تكَلَّم على الرّبِّ بِالعِصيانِ“.<verse eid="JER 29:32" /></para>
  <chapter eid="JER 29" />
  <chapter number="30" style="c" sid="JER 30" />
  <para style="s1">وعد الرّبّ لشعبه</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 30:1" />وقالَ الرّبُّ لإرميا: <verse eid="JER 30:1" /><verse number="2" style="v" pubnumber="2" sid="JER 30:2" />”أُكتُبْ جميعَ ما كَلَّمْتُكَ بهِ في كِتابٍ. <verse eid="JER 30:2" /><verse number="3" style="v" pubnumber="3" sid="JER 30:3" />فستَأتي أيّامٌ أُعيدُ فيها أمجادَ شعبي إِسرائيلَ ويَهوذا وأرُدُّهُم إلى الأرضِ الّتي أورَثْتُها لآبائِهِم فيَمتَلِكونَها“.<verse eid="JER 30:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="JER 30:4" />وقالَ الربُّ على إِسرائيلَ ويَهوذا:<verse eid="JER 30:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="JER 30:5" />”سَمِعْنا صوتَ رُعْبٍ،</para>
  <para style="p" vid="JER 30:5">صوتَ خوفٍ لا سلامٍ.<verse eid="JER 30:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="JER 30:6" />إسألوا واَنظُروا:</para>
  <para style="p" vid="JER 30:6">هل يَحبَلُ الرَّجُلُ ويَلِدُ؟</para>
  <para style="p" vid="JER 30:6">فلِماذا أرى كُلَّ رَجُلٍ</para>
  <para style="p" vid="JER 30:6">يَداهُ على وسطِهِ كالّتي تَلِدُ؟</para>
  <para style="p" vid="JER 30:6">لِماذا أرى كُلَّ وجهٍ</para>
  <para style="p" vid="JER 30:6">لونُهُ صارَ إلى اَصفِرارٍ؟<verse eid="JER 30:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="JER 30:7" />آهِ، ذلِكَ اليومُ عظيمٌ</para>
  <para style="p" vid="JER 30:7">لا يُضاهيهِ يومٌ!</para>
  <para style="p" vid="JER 30:7">هوَ وقتُ شِدَّةٍ على شعبي</para>
  <para style="p" vid="JER 30:7">لَكنِّي أُخَلِّصُهُ مِنهُ.<verse eid="JER 30:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="JER 30:8" />”وفي ذلِكَ اليومِ، يقولُ الرّبُّ القديرُ، أكسِرُ النِّيرَ عَنْ عُنُقِهِم وأقطَعُ رُبُطَهُم ولا يَستَعبِدُهُمُ الغُرَباءُ مِنْ بَعدُ، <verse eid="JER 30:8" /><verse number="9" style="v" pubnumber="9" sid="JER 30:9" />بل يَخدُمونَ الرّبَّ إلَهَهُم والمَلِكَ الّذي أُقيمُهُ علَيهِم مِنْ نَسلِ داوُدَ.<verse eid="JER 30:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="JER 30:10" />”فلا تَخَفْ يا يَعقوبُ عبدي،</para>
  <para style="p" vid="JER 30:10">لا تَفزَعْ، يا إِسرائيلُ!</para>
  <para style="p" vid="JER 30:10">سأُخَلِّصُكَ مِنَ الغُربَةِ،</para>
  <para style="p" vid="JER 30:10">مِنْ أرضِ جَلاءِ ذُرِّيَّتِكَ</para>
  <para style="p" vid="JER 30:10">فتَرجِعُ وتستقرُّ في أمانٍ.</para>
  <para style="p" vid="JER 30:10">ولا يُخيفُكَ أحدٌ<verse eid="JER 30:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JER 30:11" />لأنِّي معَكَ لأخَلِّصَكَ،</para>
  <para style="p" vid="JER 30:11">أفني جميعَ الأمَمِ،</para>
  <para style="p" vid="JER 30:11">تِلكَ الّتي شتَّتُّكَ بَينَها،</para>
  <para style="p" vid="JER 30:11">وأنتَ لا أفنيكَ ولا أُبْرِئُكَ.</para>
  <para style="p" vid="JER 30:11">بل بِإنصافٍ أُؤدِّبُكَ“.<verse eid="JER 30:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="JER 30:12" />وقالَ الرّبُّ:</para>
  <para style="p" vid="JER 30:12">”كَسْرُ عَظْمِكِ لا يُجبَرُ،</para>
  <para style="p" vid="JER 30:12">وجُرحُكِ لا شِفاءَ مِنهُ.<verse eid="JER 30:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="JER 30:13" />لا أحدَ يَهتَمُّ فيَجبُرُكِ</para>
  <para style="p" vid="JER 30:13">ويُضمِّدُ جُرحَكِ فتُشفَينَ.<verse eid="JER 30:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="JER 30:14" />جميعُ مُحبِّيكِ نَسوكِ،</para>
  <para style="p" vid="JER 30:14">ولا يُبالونَ بِكِ في شيءٍ،</para>
  <para style="p" vid="JER 30:14">لأنِّي ضرَبْتُكِ ضَرْبَ العَدُوِّ</para>
  <para style="p" vid="JER 30:14">وأدَّبْتُكِ تَأديبًا قاسيًا</para>
  <para style="p" vid="JER 30:14">لأجلِ آثامِكِ الكثيرةِ</para>
  <para style="p" vid="JER 30:14">وخطاياكِ الّتي تَفاقَمَت.<verse eid="JER 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="JER 30:15" />لِماذا تَصرُخينَ مِنْ كَسْرِ عَظْمِكِ؟</para>
  <para style="p" vid="JER 30:15">ومِنْ جُرحِكِ الّذي لا يَبرأُ</para>
  <para style="p" vid="JER 30:15">فأنا لآثامِكِ الكثيرةِ</para>
  <para style="p" vid="JER 30:15">وخطاياكِ الّتي تَفاقَمَت</para>
  <para style="p" vid="JER 30:15">فعَلْتُ ما فعَلْتُهُ بِكِ.<verse eid="JER 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="JER 30:16" />جميع آكِليكِ سَيُؤكَلونَ</para>
  <para style="p" vid="JER 30:16">ويُسبَى جميعُ أعدائِكِ،</para>
  <para style="p" vid="JER 30:16">والّذين يَنهَبونَكِ يُنهَبونَ،</para>
  <para style="p" vid="JER 30:16">ويُسلَبُ الّذين يَسلِبونَكِ.<verse eid="JER 30:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="JER 30:17" />أُعيدُ إليكِ العافيةَ،</para>
  <para style="p" vid="JER 30:17">ومِنْ جُروحِكِ أشفيكِ.</para>
  <para style="p" vid="JER 30:17">فلا تُدْعَينَ صِهيونَ المَنبوذَةَ</para>
  <para style="p" vid="JER 30:17">تِلكَ الّتي لا طالِبَ لها“.<verse eid="JER 30:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="JER 30:18" />وقالَ الرّبُّ:</para>
  <para style="p" vid="JER 30:18">”سأُعيدُ أمجادَ قَبائِلِ يَعقوبَ</para>
  <para style="p" vid="JER 30:18">وأُظهِرُ شَفَقَتي على مساكِنِهِ،</para>
  <para style="p" vid="JER 30:18">فتُبنَى المدينةُ على تَلِّها</para>
  <para style="p" vid="JER 30:18">ويُشادُ القصرُ على أنقاضِهِ<verse eid="JER 30:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="JER 30:19" />فتَرتَفِعُ أناشيدُ الحَمدِ،</para>
  <para style="p" vid="JER 30:19">وأصواتُ الّذينَ في طَرَبٍ</para>
  <para style="p" vid="JER 30:19">أُكثِّرُهُم فلا يَقِلُّونَ،</para>
  <para style="p" vid="JER 30:19">وأُكرِمُهُم فلا يَذِلُّونَ.<verse eid="JER 30:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="JER 30:20" />يكونُ بَنوهُم كما في القديمِ،</para>
  <para style="p" vid="JER 30:20">وجماعَتُهم تَثبُتُ أمامي،</para>
  <para style="p" vid="JER 30:20">وأُعاقِبُ جميعَ ظالِميهِم.<verse eid="JER 30:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="JER 30:21" />ويكونُ كبيرُهُم واحدًا مِنهُم،</para>
  <para style="p" vid="JER 30:21">ورَئيسُهُم يَخرُجُ مِنْ بَينِهِم.</para>
  <para style="p" vid="JER 30:21">أُقرِّبُهُ فيَدنو إليَّ،</para>
  <para style="p" vid="JER 30:21">حينَ ما مِنْ أحدٍ يَجرُؤُ</para>
  <para style="p" vid="JER 30:21">أنْ يَدنو إليَّ مِنْ تِلْقائِهِ.<verse eid="JER 30:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="JER 30:22" />تكونونَ أنتُم لي شعبًا،</para>
  <para style="p" vid="JER 30:22">وأكونُ أنا لكُم إلهًا.<verse eid="JER 30:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="JER 30:23" />ها غضَبُ الرّبِّ</para>
  <para style="p" vid="JER 30:23">زَوبَعةٌ خرَجَت مِنهُ</para>
  <para style="p" vid="JER 30:23">على رُؤوسِ الأشرارِ.<verse eid="JER 30:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="JER 30:24" />غضَبُ الرّبِّ لا يَرجِعُ</para>
  <para style="p" vid="JER 30:24">حتّى يفعَلَ وحتّى يُتِمَّ</para>
  <para style="p" vid="JER 30:24">ما في قلبِهِ مِنْ مقاصِدَ</para>
  <para style="p" vid="JER 30:24">تَفهَمونَها في آخِرِ الأيامِ.<verse eid="JER 30:24" /></para>
  <chapter eid="JER 30" />
  <chapter number="31" style="c" sid="JER 31" />
  <para style="s1">العودة من السبي</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 31:1" />في ذلِكَ الزَّمانِ يقولُ الرّبُّ، أصيرُ إلهًا لجميعِ عشائِرِ إِسرائيلَ، وهُم يكونونَ لي شعبًا.<verse eid="JER 31:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="JER 31:2" />وقالَ الرّبُّ: ”في البرِّيَّةِ رَحَمتُ الشَّعبَ الّذينَ نجَوا مِنَ السَّيف، وحينَ طلبَ إِسرائيلُ الأمانَ <verse eid="JER 31:2" /><verse number="3" style="v" pubnumber="3" sid="JER 31:3" />ظَهرتُ لَه مِنْ بَعيدٍ. أحببتُكِ يا عذراءَ إِسرائيلَ، حبًّا أبديًّا، فأبقيتُ على رَحمتي لكِ. <verse eid="JER 31:3" /><verse number="4" style="v" pubnumber="4" sid="JER 31:4" />أبنيكِ بَعدُ فَتُبنَينَ، يا عذراءَ إِسرائيلَ، وتحملينَ دُفوفَكِ بَعدُ وَتبرُزينَ في حَلْبةِ الرَّاقصينَ. <verse eid="JER 31:4" /><verse number="5" style="v" pubnumber="5" sid="JER 31:5" />تَغرسينَ بَعدُ كُرومًا في جِبالِ السَّامِرةِ، والّذينَ يَغرسونَ يأكُلونَ ثمَرَ ما يَغرِسونَ. <verse eid="JER 31:5" /><verse number="6" style="v" pubnumber="6" sid="JER 31:6" />فسيَأتي يومٌ يُنادي فيهِ النَّواطيرُ في جِبالِ أفرَايمَ: قوموا نَصعدْ إلى صِهيَونَ، إلى الرّبِّ إلهِنا“.<verse eid="JER 31:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="JER 31:7" />وقالَ الرّبُّ:</para>
  <para style="p" vid="JER 31:7">”رَنِّموا لِبَني إِسرائيلَ بِفرَحٍ،</para>
  <para style="p" vid="JER 31:7">هَلِّلوا لِسَيِّدِ الأمَمِ.</para>
  <para style="p" vid="JER 31:7">نادوا وسَبِّحوا وقولوا،</para>
  <para style="p" vid="JER 31:7">الرّبُّ خَلَّصَ شعبَهُ،</para>
  <para style="p" vid="JER 31:7">أنقَذَ بَقيَّةَ إِسرائيلَ.<verse eid="JER 31:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="JER 31:8" />سأُعيدُهُم مِنْ أرضِ الشِّمالِ</para>
  <para style="p" vid="JER 31:8">وأجمَعُهُم مِنْ أطرافِ الأرضِ.</para>
  <para style="p" vid="JER 31:8">والأعمى والأعرَجُ فيهِم،</para>
  <para style="p" vid="JER 31:8">والحُبلى والوالِدَةُ جميعًا.</para>
  <para style="p" vid="JER 31:8">حَشْدٌ عظيمٌ يَعودونَ إلى هُنا.<verse eid="JER 31:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="JER 31:9" />يَجيئونَ وهُم يَبكونَ،</para>
  <para style="p" vid="JER 31:9">وأقودُهُم وهُم يتَضَرَّعونَ.</para>
  <para style="p" vid="JER 31:9">أُسَيِّرُهُم قُربَ أنهارِ المياهِ،</para>
  <para style="p" vid="JER 31:9">وفي طريقٍ قَويمٍ فلا يَعثُرونَ.</para>
  <para style="p" vid="JER 31:9">أنا أبٌ لإسرائيلَ</para>
  <para style="p" vid="JER 31:9">وأفرايمُ بِكْرٌ لي“.<verse eid="JER 31:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="JER 31:10" />إسمَعوا كَلِمةَ الرّبِّ أيُّها الأمَمُ</para>
  <para style="p" vid="JER 31:10">ونادوا بِها في الجُزُرِ البعيدةِ.</para>
  <para style="p" vid="JER 31:10">قولوا: ”مَنْ بَدَّدَ بَني إِسرائيلَ يَجمَعُهُم</para>
  <para style="p" vid="JER 31:10">ويَحرُسُهُم كَراعٍ قطيعَهُ.<verse eid="JER 31:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JER 31:11" />الرّبُّ الإلهُ اَفتَداهُم</para>
  <para style="p" vid="JER 31:11">فَكَّهُم مِنْ يَدٍ لا يَقوَونَ علَيها.<verse eid="JER 31:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="JER 31:12" />فيَجيئُونَ ويُرَنِّمونَ في أعالي صِهيَونَ،</para>
  <para style="p" vid="JER 31:12">ويُقبِلونَ على خَيراتِ الرّبِّ،</para>
  <para style="p" vid="JER 31:12">على الحِنطةِ والخمرِ والزَّيتِ</para>
  <para style="p" vid="JER 31:12">وصِغارِ الغنَمِ والبقَرِ،</para>
  <para style="p" vid="JER 31:12">وتكونُ حياتُهم كجَنَّةٍ رَيَّانَةٍ،</para>
  <para style="p" vid="JER 31:12">ولا يَعودونَ يَذبلونَ مِنْ بَعدُ.<verse eid="JER 31:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="JER 31:13" />فتَفرَحُ العذراءُ في المَراقِصِ،</para>
  <para style="p" vid="JER 31:13">والشُّبَّانُ والشُّيوخُ جميعًا،</para>
  <para style="p" vid="JER 31:13">وأُحوِّلُ نُوَاحَهمُ إلى طَرَبٍ</para>
  <para style="p" vid="JER 31:13">وأُعَزِّيهِم وأُفَرِّحُهُم بَعدَ حُزنٍ،<verse eid="JER 31:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="JER 31:14" />وأملأُ الكَهنَةَ مِنَ الدَّسَمِ،</para>
  <para style="p" vid="JER 31:14">وشعبي يَشبَعُ مِنْ خَيراتي“.<verse eid="JER 31:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="JER 31:15" />وقالَ الرّبُّ:</para>
  <para style="p" vid="JER 31:15">”صوتٌ سُمِعَ في الرَّامَةِ،</para>
  <para style="p" vid="JER 31:15">نوحٌ وبُكاءٌ مُرٌّ.</para>
  <para style="p" vid="JER 31:15">راحيلُ تَبكي بَنيها</para>
  <para style="p" vid="JER 31:15">وتَأبى أنْ تَتَعَزَّى عَنهُم،</para>
  <para style="p" vid="JER 31:15">لأنَّهُم زالوا عَنِ الوجودِ.<verse eid="JER 31:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="JER 31:16" />كُفّي صوتَكِ عَنِ البُكاءِ</para>
  <para style="p" vid="JER 31:16">وعينَيكِ عَنْ ذَرْفِ الدُّموعِ</para>
  <para style="p" vid="JER 31:16">ستَنالينَ جزاءَ عمَلِكِ.</para>
  <para style="p" vid="JER 31:16">فيَرجِعونَ مِنْ أرضِ العَدُوِّ<verse eid="JER 31:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="JER 31:17" />يَرجِعُ بَنوكِ إلى بلادِهِم</para>
  <para style="p" vid="JER 31:17">ويكونُ في غَدِكِ رَجاءٌ.<verse eid="JER 31:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="JER 31:18" />سَمِعْتُ شعبي يَنتَحِبُ،</para>
  <para style="p" vid="JER 31:18">ويقولُ: أدَّبتَني فتَأدَّبْتُ</para>
  <para style="p" vid="JER 31:18">كالعِجْلِ غَيرِ المُرَوَّضِ.</para>
  <para style="p" vid="JER 31:18">أعِدْني إليكَ فأعودَ،</para>
  <para style="p" vid="JER 31:18">لأنَّكَ الرّبُّ إلهي.<verse eid="JER 31:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="JER 31:19" />بَعدَ رُجوعي إِليكَ نَدِمْتُ،</para>
  <para style="p" vid="JER 31:19">وبَعدَما عرَفتُ لَطَمْتُ وجهي.</para>
  <para style="p" vid="JER 31:19">اَستَحيَيتُ واستَولى عليَّ الخجَلُ</para>
  <para style="p" vid="JER 31:19">لأنِّي حمَلْتُ عارَ صِباي.<verse eid="JER 31:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="JER 31:20" />”أفرايمُ ابنٌ عَزيزٌ عليَّ،</para>
  <para style="p" vid="JER 31:20">ولَدٌ يُبهِجُني كثيرًا</para>
  <para style="p" vid="JER 31:20">مَهما تكَلَّمْتُ علَيهِ شَرًّا</para>
  <para style="p" vid="JER 31:20">أعودُ فأذكُرُهُ بِالخَيرِ،</para>
  <para style="p" vid="JER 31:20">فأحشائي تَحِنُّ إليهِ.</para>
  <para style="p" vid="JER 31:20">أقولُ أنا الرّبُّ.<verse eid="JER 31:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="JER 31:21" />”إنصِبي إشاراتٍ واَرسُمي معالِمَ،</para>
  <para style="p" vid="JER 31:21">وخُذي لَكِ الحِيطَةَ في الطَّريقِ،</para>
  <para style="p" vid="JER 31:21">في السَّبيلِ الّذي تَسيرينَ فيهِ،</para>
  <para style="p" vid="JER 31:21">واَرجِعي يا عذراءَ إِسرائيلَ،</para>
  <para style="p" vid="JER 31:21">إرجِعي إلى مُدُنِكِ هذِهِ.<verse eid="JER 31:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="JER 31:22" />إلى متى تَحارينَ أيَّتُها البِنْتُ،</para>
  <para style="p" vid="JER 31:22">أيَّتُها البِنْتُ المُرتَدَّةُ عنِّي؟</para>
  <para style="p" vid="JER 31:22">خلَقَ الرّبُّ شيئًا جديدًا في الأرضِ:</para>
  <para style="p" vid="JER 31:22">أُنثى تتَغَزَّلُ بِرَجُلٍ“.<verse eid="JER 31:22" /></para>
  <para style="s1">عهد جديد</para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="JER 31:23" />وقالَ الرّبُّ القديرُ إلهُ إِسرائيلَ: ”سيُقالُ في أرضِ يَهوذا وفي مُدُنِها، حينَ أُعيدُ لِشعبي أمجادَهُم: ليُبارِكُكَ الرّبُّ يا مَسكِنَ العَدلِ، أيُّها الجبَلُ المُقَدَّسُ! <verse eid="JER 31:23" /><verse number="24" style="v" pubnumber="24" sid="JER 31:24" />فيَسكُنُ الشَّعبُ في يَهوذا وجميعِ مُدُنِها، ومعَهُمُ الفلَّاحونَ والّذينَ يُسَرِّحونَ القُطعانَ. <verse eid="JER 31:24" /><verse number="25" style="v" pubnumber="25" sid="JER 31:25" />وأروي النَّفْسَ العَطشانَةَ وأُشبِعُ كُلَّ نَفْسٍ خائِرةٍ. <verse eid="JER 31:25" /><verse number="26" style="v" pubnumber="26" sid="JER 31:26" />فيقولُ كُلُّ واحدٍ: أفَقْتُ وتَأمَّلْتُ، ولَذَّ لي مَنامي.<verse eid="JER 31:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="JER 31:27" />”ستَأتي أيّامٌ أزرَعُ أرضَ إِسرائيلَ وأرضَ يَهوذا بِالبشَرِ والبَهائِمِ. <verse eid="JER 31:27" /><verse number="28" style="v" pubnumber="28" sid="JER 31:28" />وكما سَهِرْتُ علَيهِم لأقلَعَ وأهدِمَ وأنقُضَ وأُهلِكَ وأُسيءَ، فكذلِكَ أسهَرُ علَيهِم لأبنيَ وأغرُسَ. <verse eid="JER 31:28" /><verse number="29" style="v" pubnumber="29" sid="JER 31:29" />في تِلكَ الأيّامِ لا يُقالُ بَعدُ: الآباءُ أكَلوا الحِصرِمَ وأسنانُ البَنينَ تَضرَسُ، <verse eid="JER 31:29" /><verse number="30" style="v" pubnumber="30" sid="JER 31:30" />بل كُلُّ واحدٍ بِخطيئَتِهِ يموتُ، وكُلُّ إنسانٍ بِالحِصرِمِ الّذي يَأكُلُهُ تَضرَسُ أسنانُهُ.<verse eid="JER 31:30" /></para>
  <para style="p">
    <verse number="31" style="v" pubnumber="31" sid="JER 31:31" />”وستأتي أيّامٌ أُعاهِدُ فيها بَيتَ إِسرائيلَ وبَيتَ يَهوذا عَهدًا جديدًا <verse eid="JER 31:31" /><verse number="32" style="v" pubnumber="32" sid="JER 31:32" />لا كالعَهدِ الّذي عاهَدْتُهُ آباءَهُم يومَ أخَذْتُ بِأيديهِم وأخرَجْتُهُم مِنْ أَرضِ مِصْرَ، لأنَّهُم نَقَضوهُ معَ أنِّي عامَلْتُهُم بِالحُسْنى. <verse eid="JER 31:32" /><verse number="33" style="v" pubnumber="33" sid="JER 31:33" />أمَّا العَهدُ الجديدُ الّذي أُعاهِدُ بهِ بَيتَ إِسرائيلَ بَعدَ تِلكَ الأيّامِ، فهوَ هذا: أجعَلُ شَريعَتي في ضَمائِرِهِم وأكتُبُها على قلوبِهِم وأكونُ لهُم إلهًا وهُم يكونونَ لي شعبًا. <verse eid="JER 31:33" /><verse number="34" style="v" pubnumber="34" sid="JER 31:34" />فلا يُعَلِّمُ بَعدُ واحدهُمُ الآخَرَ، والأخُ أخاهُ، أنْ يَعرِفَ الرّبَّ. فجميعُهُم مِنْ صغيرِهِم إلى كبيرِهِم سَيَعرِفونني، لأنِّي سأغفِرُ ذُنوبَهُم ولن أذكُرَ خطاياهُم مِنْ بَعدُ“.<verse eid="JER 31:34" /></para>
  <para style="p">
    <verse number="35" style="v" pubnumber="35" sid="JER 31:35" />وقالَ الرّبُّ القديرُ اَسمُهُ الّذي جعَلَ الشَّمسَ نورًا في النَّهارِ، والقمرَ والكَواكِبَ نورًا في اللَّيلِ، والّذي يُثيرُ البحرَ فتَعِجُّ أمواجُهُ: <verse eid="JER 31:35" /><verse number="36" style="v" pubnumber="36" sid="JER 31:36" />”إنْ زالَ نِظامُ الكونِ مِنْ أمامي، فنَسْلُ إِسرائيلَ يَبطُلُ أنْ يكونَ أُمَّةً أمامي إلى الأبدِ“.<verse eid="JER 31:36" /></para>
  <para style="p">
    <verse number="37" style="v" pubnumber="37" sid="JER 31:37" />وقالَ الرّبُّ: ”أنا أنبُذُ جميعَ ذُرِّيَّةِ إِسرائيلَ لأجلِ كُلِّ ما فعَلوا، إِنْ أمكَنَ أنْ تُقاسَ السَّماواتُ مِنْ فَوقُ ويُفحَصَ عَنْ أُسُسِ الأرضِ مِنْ تَحتُ“.<verse eid="JER 31:37" /></para>
  <para style="p">
    <verse number="38" style="v" pubnumber="38" sid="JER 31:38" />”ستَأتي أيّامٌ تُبنَى فيها مدينةُ الرّبِّ أُورُشليمُ مِنْ بُرْجِ حنَنئيلَ إلى بابِ الزَّاويةِ، <verse eid="JER 31:38" /><verse number="39" style="v" pubnumber="39" sid="JER 31:39" />ويَخرُجُ خَيطُ القياسِ قُبالَتَهُ على تَلَّةِ جارِبَ ويَستَديرُ إلى جَوعَةَ. <verse eid="JER 31:39" /><verse number="40" style="v" pubnumber="40" sid="JER 31:40" />ويكونُ كُلُّ وادي الجُثَثِ والرَّمادِ وكُلُّ الحُقولِ إلى وادي قَدرونَ، إلى زاويةِ بابِ الخَيلِ شَرقًا مَوضِعًا مُقدَّسًا لِلرّبِّ، فلا يُقلَعُ ولا يُهدَمُ إلى الأبدِ“.<verse eid="JER 31:40" /></para>
  <chapter eid="JER 31" />
  <chapter number="32" style="c" sid="JER 32" />
  <para style="s1">إرميا يشتري حقلًا</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 32:1" />وتَلَقَّى إرميا كَلِمةَ الرّبِّ في السَّنةِ العاشِرةِ لِعَهدِ صِدْقيَّا مَلِكِ يَهوذا، وهيَ السَّنةُ الثَّامِنَةَ عَشْرَةَ لِعَهدِ نبوخذنَصَّرَ. <verse eid="JER 32:1" /><verse number="2" style="v" pubnumber="2" sid="JER 32:2" />وكانَ في ذلِكَ الحينِ جيشُ مَلِكِ بابِلَ يُحاصِرُ أُورُشليمَ، وكانَ إرميا النَّبيُّ مَحبوسًا في السِّجنِ الّذي في قصرِ مَلِكِ يَهوذا، <verse eid="JER 32:2" /><verse number="3" style="v" pubnumber="3" sid="JER 32:3" />لأنَّ صِدْقيَّا مَلِكَ يَهوذا حبَسَهُ وقالَ لَه: لِماذا تتَنَبَّأُ فتقولُ: قالَ الرّبُّ: سأجعَلُ هذِهِ المدينةَ في يَدِ مَلِكِ بابِلَ فيَأخُذُها، <verse eid="JER 32:3" /><verse number="4" style="v" pubnumber="4" sid="JER 32:4" />وصِدْقيَّا مَلِكُ يَهوذا لا يَنجو مِنْ أيدي البابليِّينَ، بل يُسلَّمُ إلى يَدِ مَلِكِ بابِلَ ويُخاطِبُهُ فَمًا إلى فَمٍ وعَيناهُ تَنظُرانِ عَينَيهِ. <verse eid="JER 32:4" /><verse number="5" style="v" pubnumber="5" sid="JER 32:5" />ويَذهبُ بِصِدْقيَّا إلى بابِلَ، فيَبقى هُناكَ إلى أنْ أتفَقَّدَهُ، إنْ حارَبتُمُ البابِليِّينَ فلا تَنجَحونَ“.<verse eid="JER 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="JER 32:6" />ذلِكَ ما تَنَبَّأ بهِ إرميا عِندَما قالَ: <verse eid="JER 32:6" /><verse number="7" style="v" pubnumber="7" sid="JER 32:7" />”قال ليَ الرّبُّ: يَجيئُكَ حَنمَئيلُ بنُ شَلُّومَ عَمِّكَ فيقولُ لكَ: إِشْتَرِ حَقلي الّذي في عناتوتَ، لأنَّ لكَ حَقَّ فَكِّ الرَّهْنِ والشِّراءِ. <verse eid="JER 32:7" /><verse number="8" style="v" pubnumber="8" sid="JER 32:8" />فجاءَني حَنمَئيلُ اَبنُ عَمِّي، على حسَبِ كَلِمةِ الرّبِّ، إلى السِّجنِ وقالَ لي: إِشتَرِ حَقلي الّذي في عناتوتَ مِنْ أرضِ بنيامينَ، لأنَّ لكَ حَقَّ الإرثِ وحَقَّ فَكِّ الرَّهنِ، فاَشتَرِهِ لكَ. فعَرَفْتُ أنَّها كَلِمةُ الرّبِّ. <verse eid="JER 32:8" /><verse number="9" style="v" pubnumber="9" sid="JER 32:9" />فاَشترَيتُ الحَقلَ ووَزنْتُ لَه ثمَنَهُ وهوَ سَبعَةَ عشَرَ مِثقالًا مِنَ الفِضَّةِ. <verse eid="JER 32:9" /><verse number="10" style="v" pubnumber="10" sid="JER 32:10" />وكَتَبْتُ ذلِكَ في صَكٍّ، وخَتَمْتُهُ وأشهَدْتُ شُهودًا ووَزَنتُ الفِضَّةَ بِميزانٍ، <verse eid="JER 32:10" /><verse number="11" style="v" pubnumber="11" sid="JER 32:11" />وأخَذْتُ صَكَّ الشِّراءِ المَختومَ في نُسخَتَيْنِ، واحدةٍ مُغلَقَةٍ وفيها العَقدُ وشُروطُهُ، وأُخرى مَفتوحَة، <verse eid="JER 32:11" /><verse number="12" style="v" pubnumber="12" sid="JER 32:12" />وسَلَّمتُهُما إلى باروخَ بنِ نَيريَّا بنِ مَحسِيَّا بِمَحضَرٍ مِنْ حَنمَئيلَ اَبنِ عَمِّي والشُّهودِ الّذينَ وقَّعوا على الصكِّ، وبِمَحضَرٍ مِنْ جميعِ اليهودِ الجالسينَ في باحَةِ السِّجنِ. <verse eid="JER 32:12" /><verse number="13" style="v" pubnumber="13" sid="JER 32:13" />وقُلتُ لِباروخَ أمامَهُم: <verse eid="JER 32:13" /><verse number="14" style="v" pubnumber="14" sid="JER 32:14" />قالَ الرّبُّ القديرُ إلهُ إِسرائيلَ: خُذْ هذا الصَّكَّ المَختومَ في نُسخَتينِ، مُغلَقَةٍ ومَفتوحَةٍ، وضَعْهُما في إناءٍ من خزَفٍ لِتَدوما أيّامًا طويلةً، <verse eid="JER 32:14" /><verse number="15" style="v" pubnumber="15" sid="JER 32:15" />لأنَّ الرّبَّ القديرَ إلهَ إِسرائيلَ قالَ: سَيشتَرونَ فيما بَعدُ بُيوتًا وحُقولًا وكُرومًا في هذِهِ الأرضِ“.<verse eid="JER 32:15" /></para>
  <para style="s1">صلاة إرميا</para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="JER 32:16" />وصَلَّيتُ إلى الرّبِّ بَعدَما سَلَّمتُ صَكَّ الشِّراءِ إلى باروخَ بنِ نَيريَّا، فقُلتُ: <verse eid="JER 32:16" /><verse number="17" style="v" pubnumber="17" sid="JER 32:17" />”آهِ، يا سيِّدي الرّبُّ! أنتَ صَنَعتَ السَّماواتِ والأرضَ بِقُدرَتِكَ العظيمةِ وذِراعِكَ المَمدودَةِ ولا يَصعُبُ علَيكَ شيءٌ. <verse eid="JER 32:17" /><verse number="18" style="v" pubnumber="18" sid="JER 32:18" />أنتَ يا مَنْ تمنَحُ رَحمتَكَ الألوفَ وتُعاقِبُ البَنينَ على ذُنوبِ آبائِهِم، أيُّها الإلهُ العظيمُ الجبَّارُ الّذي الرّبُّ القديرُ اَسمُهُ. <verse eid="JER 32:18" /><verse number="19" style="v" pubnumber="19" sid="JER 32:19" />عظيمٌ أنتَ في المَشورَةِ، وقديرٌ في العمَلِ، وعيناكَ مَفتوحتانِ على طُرُقِ بَني آدمَ لِتُجازيَ كُلَّ واحدٍ بِحسَبِ طُرُقِهِ وثِمارِ أعمالِهِ. <verse eid="JER 32:19" /><verse number="20" style="v" pubnumber="20" sid="JER 32:20" />أظهَرتَ آياتٍ ومُعجِزاتٍ في أرضِ مِصْرَ، ولا تَزالُ تُظهِرُها إلى هذا اليومِ في إِسرائيلَ وبَينَ سائِرِ البشَرِ، وعَمِلتَ لكَ اَسمًا كما في هذا اليومِ. <verse eid="JER 32:20" /><verse number="21" style="v" pubnumber="21" sid="JER 32:21" />وأخرَجتَ شعبَكَ إِسرائيلَ مِنْ أرضِ مِصْرَ بِآياتٍ ومُعجِزاتٍ، وبِيدٍ قديرَةٍ وذِراعٍ مَمدودَةٍ ورُعْبٍ عظيمٍ، <verse eid="JER 32:21" /><verse number="22" style="v" pubnumber="22" sid="JER 32:22" />وأعطَيتَهُم هذِهِ الأرضَ الّتي أقسَمتَ لآبائِهِم أنْ تُعطيَها لهُم أرضًا تَدُرُّ لبنًا وعسَلًا. <verse eid="JER 32:22" /><verse number="23" style="v" pubnumber="23" sid="JER 32:23" />فدَخلوا وامتَلَكوها. ولَكِنَّهُم ما سَمِعوا لِصوتِكَ، ولا سلَكوا شَريعَتَكَ، ولا عَمِلوا بِكُلِّ ما أمرتَهُم بهِ، فأنزَلتَ بِهِم هذا الشَّرَّ كُلَّهُ. <verse eid="JER 32:23" /><verse number="24" style="v" pubnumber="24" sid="JER 32:24" />فها هيَ آلاتُ الحِصارِ تُحيطُ بِالمدينةِ، تُسَلَّمُ إلى أيدي البابليِّينَ الّذينَ يُحارِبونَها بِالسَّيفِ والجُوعِ والوَباءِ. فالّذي قُلتَهُ حدَثَ وها أنتَ تَراهُ. <verse eid="JER 32:24" /><verse number="25" style="v" pubnumber="25" sid="JER 32:25" />فكَيفَ قُلتَ لي أيُّها السَّيِّدُ الرّبُّ: إِشتَرِ الحَقلَ بِالفِضَّةِ وأشهِدْ شُهودًا، بَينَما المدينةُ تُسَلَّمُ إلى أيدي البابليِّينَ؟“<verse eid="JER 32:25" /></para>
  <para style="s1">جواب الرب</para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="JER 32:26" />فقالَ الرّبُّ لإرميا: <verse eid="JER 32:26" /><verse number="27" style="v" pubnumber="27" sid="JER 32:27" />”أنا الرّبُّ إلهُ كُلِّ بشَرٍ، أيَصعُبُ عليَّ شيءٌ؟ <verse eid="JER 32:27" /><verse number="28" style="v" pubnumber="28" sid="JER 32:28" />سَأُسلِّمُ هذِهِ المدينةَ إلى أيدي البابليِّينَ وإلى يَدِ نَبوخذنَصَّرَ مَلِكِ بابِلَ فيأخُذُها. <verse eid="JER 32:28" /><verse number="29" style="v" pubnumber="29" sid="JER 32:29" />ويَدخُلُ البابليُّونَ الّذينَ يُحارِبونَ هذِهِ المدينةَ، فُيشعِلونَ فيها النَّارَ ويَحرقونَها هيَ وبُيوتها الّتي بَخَّرَ بَنو إِسرائيلَ وبَنو يَهوذا على سُطوحِها للبَعلِ وسكَبوا قرابينَ خمرٍ لآلِهَةٍ أُخرى ليُغيظوني. <verse eid="JER 32:29" /><verse number="30" style="v" pubnumber="30" sid="JER 32:30" />فبَنو إِسرائيلَ وبَنو يَهوذا صَنَعوا الشَّرَّ في عينَيَّ مُنذُ فَجرِ تاريخِهِم، وكم أغاظَني بَنو إِسرائيلَ بِأعمالِهِم. <verse eid="JER 32:30" /><verse number="31" style="v" pubnumber="31" sid="JER 32:31" />وهذِهِ المدينةُ كانَت مَثارَ غضَبي وغَيظي مِنْ يومِ بَنوها إلى هذا اليومِ، فسأُزيلُها مِنْ أمام وجهي <verse eid="JER 32:31" /><verse number="32" style="v" pubnumber="32" sid="JER 32:32" />جَزاءَ كُلِّ ما فَعَلَهُ بَنو إِسرائيلَ وبَنو يَهوذا مِنْ شَرٍّ لِيُغيظوني، هُم ومُلوكُهُم ورُؤساؤُهُم وكَهنَتُهُم وأنبياؤُهُم في يَهوذا وأُورُشليمَ، <verse eid="JER 32:32" /><verse number="33" style="v" pubnumber="33" sid="JER 32:33" />وأداروا لي ظُهورَهُم لا وجُوهَهُم. ومعَ أنِّي عَلَّمْتُهُم بِغَيرِ اَنقطاعٍ، فما سَمِعوا لي ولا قَبِلوا التَّأديبَ، <verse eid="JER 32:33" /><verse number="34" style="v" pubnumber="34" sid="JER 32:34" />بل نَصَبوا أصنامَهُم في هَيكَلي الّذي دُعِيَ باَسمي لِيُنَجِّسوهُ، <verse eid="JER 32:34" /><verse number="35" style="v" pubnumber="35" sid="JER 32:35" />وبَنوا مَذابِحَ للبَعلِ في وادي هَنُّومَ لِيُقَدِّموا بَنيهِم وبَناتِهِم بِالنَّارِ قربانًا للإلهِ مُولَكَ، وأنا لم آمُرْهُم بذلِكَ ولا خطَرَ بِقلبي أنْ يَعمَلوا هذا الرِّجْسَ ويوقِعوا يَهوذا في الإثْمِ.<verse eid="JER 32:35" /></para>
  <para style="p">
    <verse number="36" style="v" pubnumber="36" sid="JER 32:36" />”والآنَ، فهذا ما أقولُهُ أنا الرّبُّ إلهُ إِسرائيلَ على هذِهِ المدينةِ الّتي أنتُم تقولونَ إنَّها تُسَلَّمُ إلى يَدِ مَلِكِ بابِلَ ضَحيَّةَ السَّيفِ والجُوعِ والوَباءِ: <verse eid="JER 32:36" /><verse number="37" style="v" pubnumber="37" sid="JER 32:37" />سأجمَعُ الشَّعبَ مِنْ جميعِ الأراضي الّتي طَرَدْتُهُم إليها بِغضَبي وغيظي وسُخطي الشَّديدِ، وأُعيدُهُم إلى هذا المَوضعِ وأُسكِنُهُم في أمانٍ. <verse eid="JER 32:37" /><verse number="38" style="v" pubnumber="38" sid="JER 32:38" />فيكونونَ لي شعبًا وأكونُ لهُم إلهًا. <verse eid="JER 32:38" /><verse number="39" style="v" pubnumber="39" sid="JER 32:39" />وأُعطيهِم قلبًا واحدًا وطريقًا واحدًا لِيخافوني دائمًا لِخَيرِهِم وخَيرِ بَنيهِم مِنْ بَعدِهِم. <verse eid="JER 32:39" /><verse number="40" style="v" pubnumber="40" sid="JER 32:40" />وأُعاهِدُهُم عَهدًا أبديًّا أنِّي لا أتحَوَّلُ عَنهُم، بل أُحسِنُ إِليهِم وأجعَلُ مَخافَتي في قُلوبِهِم لِئلَّا يَبتَعِدوا عنِّي. <verse eid="JER 32:40" /><verse number="41" style="v" pubnumber="41" sid="JER 32:41" />وأفرَحُ بأنْ أُحسِنَ إليهِم وأغرُسُهُم في هذِهِ الأرضِ بِكُلِّ قلبي وكُلِّ نفْسي وأكونُ أمينًا لهُم.<verse eid="JER 32:41" /></para>
  <para style="p">
    <verse number="42" style="v" pubnumber="42" sid="JER 32:42" />”فكما أنِّي جلَبْتُ على هذا الشَّعبِ كُلَّ هذا الشَّرِّ العظيمِ، كذلِكَ أجلِبُ لهُم كُلَّ الخَيرِ الّذي وعَدتُهُم بهِ. <verse eid="JER 32:42" /><verse number="43" style="v" pubnumber="43" sid="JER 32:43" />فيشتَري الشَّعبُ حُقولًا في هذِهِ الأرضِ الّتي قُلتُ علَيها إِنَّها تخرَبُ وتَخلو مِنَ البشَرِ والبَهائِمِ وتُسَلَّمُ إلى أيدي البابليِّينَ. <verse eid="JER 32:43" /><verse number="44" style="v" pubnumber="44" sid="JER 32:44" />يَشتَرونَها بِالفِضَّةِ ويَكتُبونَ ذلِكَ في الصُّكوكِ ويَختُمونَ علَيها ويُشهِدونَ الشُّهودَ في أرضِ بنيامينَ وفيما حَولَ أُورُشليمَ وفي مُدُنِ يَهوذا ومُدُنِ الجبَلِ ومُدُنِ السَّهلِ ومُدُنِ الجَنوبِ، لأنِّي أُعيدُ لهُم أمجادَهُم يقولُ الرّبُّ“.<verse eid="JER 32:44" /></para>
  <chapter eid="JER 32" />
  <chapter number="33" style="c" sid="JER 33" />
  <para style="s1">وعد آخر بالعودة</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 33:1" />وقالَ الرّبُّ لإرميا ثانيةً، وهوَ مَحبوسٌ بَعدُ في السِّجنِ: <verse eid="JER 33:1" /><verse number="2" style="v" pubnumber="2" sid="JER 33:2" />”يقولُ الرّبُّ الّذي صنَعَ الأرضَ وصَوَّرَها وثَبَّتَها في مكانِها، الرّبُّ اَسمُهُ: <verse eid="JER 33:2" /><verse number="3" style="v" pubnumber="3" sid="JER 33:3" />أُدعُني فأُجيبَكَ بِما لا تَعرِفُ مِنْ عَظائِمِ الأمورِ وخفاياها <verse eid="JER 33:3" /><verse number="4" style="v" pubnumber="4" sid="JER 33:4" />وبِما أقولُهُ على بُيوتِ هذِهِ المدينةِ وقُصورِ مُلوكِ يَهوذا الّتي هُدِمَت لإقامَةِ المَتاريسِ والوقوفِ في وجهِ السَّيفِ: <verse eid="JER 33:4" /><verse number="5" style="v" pubnumber="5" sid="JER 33:5" />سيَجيءُ البابِليُّونَ ليُحارِبوا هذِهِ المدينةَ وليَملأوها مِنْ جُثَثِ البشَرِ الّذينَ أضرِبُهُم بِغضَبي وغَيظي، لأنِّي حجَبتُ وجهي عَنها جَزاءَ شُرورِهِم. <verse eid="JER 33:5" /><verse number="6" style="v" pubnumber="6" sid="JER 33:6" />ولكنِّي سأُضَمِّدُ جُرحَها وأُداويهِ فأشفيهِ وأمنَحُهُم وافِرَ الخَيرِ والأمانِ، <verse eid="JER 33:6" /><verse number="7" style="v" pubnumber="7" sid="JER 33:7" />وأُعيدُ أمجادَ يَهوذا وإِسرائيلَ وأبنِيهِم كما مِنْ قَبلُ. <verse eid="JER 33:7" /><verse number="8" style="v" pubnumber="8" sid="JER 33:8" />وأُطَهِّرُهُم مِنْ جميعِ خطاياهُمُ الّتي خَطِئوا بِها إليَّ، وأعفو عَنْ عِصيانِهِم وكُلِّ ما اقتَرَفوهُ مِن ذُنوبٍ. <verse eid="JER 33:8" /><verse number="9" style="v" pubnumber="9" sid="JER 33:9" />وتكونُ لي هذِهِ المدينةُ عُنوانَ بَهجَةٍ ومَديحٍ واَعتزازٍ لدى جميعِ أُمَمِ الأرضِ الّذينَ يَسمَعونَ بِجميعِ الخَيرِ الّذي أعملُهُ لها، وسيَخافونَ ويَرتَعدونَ حينَ يرَونَ جميعَ ما أُغدِقُهُ علَيها مِنْ خَيرٍ وسلامٍ“.<verse eid="JER 33:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="JER 33:10" />وقالَ الرّبُّ: ”سَيُسمَعُ مِنْ بَعدُ في هذا المَوضِعِ الّذي قُلتُ إنَّهُ يَصيرُ خرابًا، لا إنسانَ فيهِ ولا بَهيمَةَ <verse eid="JER 33:10" /><verse number="11" style="v" pubnumber="11" sid="JER 33:11" />صوتُ الطَّرَبِ وصوتُ الفرَحِ، صوتُ العريسِ وصوتُ العروسِ، صوتُ القائِلينَ: إِحمَدوا الرّبَّ القديرَ لأنَّهُ صالِحٌ وإلى الأبدِ رَحمَتُهُ، وصوتُ الّذينَ يُقَدِّمونَ الشُّكْرَ في بَيتِ الرّبِّ لأنِّي أُعيدُ لِهذِهِ الأرضِ أمجادَها الّتي كانَت لها مِنْ قَبلُ“.<verse eid="JER 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="JER 33:12" />وقالَ الرّبُّ القديرُ: ”سيكونُ مِنْ بَعدُ في هذا المَوضِعِ وفي جميعِ مُدُنِهِ الخَرِبَةِ الّتي لا إنسانَ فيها ولا بَهيمَةَ مَساكِنُ لِلرُّعاةِ وحَظائِرُ للغنَمِ. <verse eid="JER 33:12" /><verse number="13" style="v" pubnumber="13" sid="JER 33:13" />وفي مُدُنِ الجبَلِ والسَّهلِ والجَنوبِ، وفي أرضِ بنيامينَ وما حَولَ أُورُشليمَ، وفي مُدُنِ يَهوذا، تَمُرُّ الغنَمُ مِنْ بَعدُ تَحتَ يَدَيْ مَنْ يحصيها. <verse eid="JER 33:13" /><verse number="14" style="v" pubnumber="14" sid="JER 33:14" />وستأتي أيّامٌ يقولُ الرّبُّ أبُرُّ فيها بِالعَهدِ الّذي عاهَدتُ بهِ بَيتَ إِسرائيلَ وبَيتَ يَهوذا. <verse eid="JER 33:14" /><verse number="15" style="v" pubnumber="15" sid="JER 33:15" />وفي تِلكَ الأيّامِ أُنبِتُ مِنْ أصلِ داوُدَ غُصنًا صالحًا، فيَحكُمُ بالعَدلِ والحَقِّ في الأرضِ. <verse eid="JER 33:15" /><verse number="16" style="v" pubnumber="16" sid="JER 33:16" />وفي تِلكَ الأيّامِ أُخَلِّصُ بَني يَهوذا وأُسكِنُهُم في أُورُشليمَ في أمانٍ وتُدعى: الرّبُّ صادِقٌ معَنا“.<verse eid="JER 33:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="JER 33:17" />وقالَ الرّبُّ: ”لا يَنقَطِعُ لِداوُدَ رَجُلٌ مِنْ نَسلِهِ يَجلِسُ على عرشِ بَيتِ إِسرائيلَ <verse eid="JER 33:17" /><verse number="18" style="v" pubnumber="18" sid="JER 33:18" />ولا يَنقَطِعُ لِكَهنَةِ اللَّاويِّينَ رَجُلٌ يُصعِدُ المُحرقاتِ أمامي ويُقَدِّمُ قرابينَ الحِنطَةِ، ويَذبَحُ الذَّبائِحَ إلى الأبدِ“.<verse eid="JER 33:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="JER 33:19" />وقالَ الرّبُّ لإرميا: <verse eid="JER 33:19" /><verse number="20" style="v" pubnumber="20" sid="JER 33:20" />”إنْ أمكَنَ أنْ تَنقُضوا عَهدي معَ النَّهارِ وعَهدي معَ اللَّيلِ، حتّى لا يكونَ اللَّيلُ ولا النَّهارُ في أوانِهِما، <verse eid="JER 33:20" /><verse number="21" style="v" pubnumber="21" sid="JER 33:21" />يُمكِنُ أنْ تَنقُضوا عَهدي معَ داوُدَ عبدي حتّى لا يكونَ لَه مِنْ نَسلِهِ مَنْ يَملِكُ على عرشِهِ، ومعَ الكَهنَةِ اللَّاويِّينَ خُدَّامي، <verse eid="JER 33:21" /><verse number="22" style="v" pubnumber="22" sid="JER 33:22" />وكما أنَّ نُجومَ السَّماء لا تُحصى، ورَمل البحرِ لا يُكالُ، كذلِكَ أُكثِرُ ذُرِّيَّةَ داوُدَ عبدي واللَّاويِّينَ خُدَّامي“.<verse eid="JER 33:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="JER 33:23" />وقالَ الرّبُّ لإرميا: <verse eid="JER 33:23" /><verse number="24" style="v" pubnumber="24" sid="JER 33:24" />”أما سَمِعتَ هذا الشَّعبَ يقولُ إنِّي رفَضتُ يَهوذا وإِسرائيلَ وهُما العَشيرتانِ اللَّتانِ اَختَرتُهُما؟ فاَحتَقروا بذلِكَ شعبي وما اَعتَبَروهُ مِنْ بَعدُ أُمَّةً. <verse eid="JER 33:24" /><verse number="25" style="v" pubnumber="25" sid="JER 33:25" />لذلِكَ أقولُ أنا الرّبُّ: مِثلَما اَتَّخَذْتُ عَهدًا معَ النَّهارِ واللَّيلِ ونِظامِ السَّماواتِ والأرضِ، <verse eid="JER 33:25" /><verse number="26" style="v" pubnumber="26" sid="JER 33:26" />هكذا لا أرفُضُ نَسلَ يَعقوبَ وداوُدَ عبدي فأختارُ مِنهُ مُلوكًا على ذُرِّيَّةِ إبراهيمَ وإسحقَ ويَعقوبَ، وأُعيدُ لهُم أمجادَهُم وأرحَمُهُم“.<verse eid="JER 33:26" /></para>
  <chapter eid="JER 33" />
  <chapter number="34" style="c" sid="JER 34" />
  <para style="s1">رسالة إلى صدقيا</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 34:1" />قالَ الرّبُّ لإرميا حينَ كانَ نَبوخذنَصَّرُ مَلِكُ بابِلَ وجيشُهُ وجميعُ ممالِكِ الأرضِ الّتي تَخضَعُ لَه وجميعُ الشُّعوبِ يُحارِبونَ أُورُشليمَ وسائِرَ مُدُنِها: <verse eid="JER 34:1" /><verse number="2" style="v" pubnumber="2" sid="JER 34:2" />”إذهَبْ وقُلْ لِصِدْقيَّا مَلِكِ يَهوذا: سأُسَلِّمُ هذِهِ المدينةَ إلى يَدِ مَلِكِ بابِلَ فيُحرقُها بِالنَّارِ، <verse eid="JER 34:2" /><verse number="3" style="v" pubnumber="3" sid="JER 34:3" />وأنتَ لا تفلتُ مِنْ يَدِهِ، بل تَقَعُ في قَبضَتِهِ وتَقِفُ أمامَهُ وجهًا إلى وجهٍ ويُكَلِّمكَ وتَذهَبُ إلى بابِلَ. <verse eid="JER 34:3" /><verse number="4" style="v" pubnumber="4" sid="JER 34:4" />”ولكنِ اسمَعْ ما يقولُ الرّبُّ عنكَ يا صِدْقيَّا مَلِكَ يَهوذا: أنتَ لا تموتُ بِالسَّيفِ <verse eid="JER 34:4" /><verse number="5" style="v" pubnumber="5" sid="JER 34:5" />بل تموتُ بِسلامٍ، وكما كانَ يُحرَقُ البَخورُ لآبائِكَ المُلوكِ الّذينَ ماتوا قَبلَكَ، فكذلِكَ يُحرَقُ لكَ ويَندُبُكَ الشَّعبُ بِقولِهِم: واأسفاه يا سيِّدُ! لأنِّي بذلِكَ أمَرْتُ أنا الرّبُّ“.<verse eid="JER 34:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="JER 34:6" />فكَلَّمَ إرميا النَّبيُّ صِدْقيَّا مَلِكَ يَهوذا بِكُلِّ هذا الكلامِ في أُورُشليمَ، <verse eid="JER 34:6" /><verse number="7" style="v" pubnumber="7" sid="JER 34:7" />حينَ كانَ جيشُ مَلِكِ بابِلَ يُحارِبُ أُورُشليمَ وما بَقيَ مِنْ مُدُنِ يَهوذا، أي لخيشَ وعَزيقَةَ، وهُما مدينَتانِ مُحَصَّنتانِ.<verse eid="JER 34:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="JER 34:8" />وكَلَّمَ الرّبُّ إرميا بَعدَ أنْ قطَعَ المَلِكُ صِدْقيَّا عَهدًا معَ شعبِ أُورُشليمَ على المُناداةِ بِتَحريرِ العبيدِ، <verse eid="JER 34:8" /><verse number="9" style="v" pubnumber="9" sid="JER 34:9" />فيُطلِقُ كُلُّ واحدٍ عبدَهُ العِبرانيَّ وأمَتَهُ العِبرانيَّةَ، ولا يَستَعبِدُ أحدٌ يَهوديًّا مِنْ بَني قَومِهِ. <verse eid="JER 34:9" /><verse number="10" style="v" pubnumber="10" sid="JER 34:10" />فوافَقَ جميعُ الرُّؤساءِ وعامَّةُ الشَّعبِ على هذا العَهدِ وأطلَقوا عَبيدَهُم أحرارًا. <verse eid="JER 34:10" /><verse number="11" style="v" pubnumber="11" sid="JER 34:11" />لَكِنَّهُم عادوا بَعدَ ذلِكَ وأرجَعوا العبيدَ والإماءَ الّذينَ أطلقوهُم أحرارًا إلى العُبوديَّةِ.<verse eid="JER 34:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="JER 34:12" />فقالَ الرّبُّ لإرميا: <verse eid="JER 34:12" /><verse number="13" style="v" pubnumber="13" sid="JER 34:13" />”قطَعْتُ عَهدًا معَ آبائِكُم يومَ أخرجتُهُم مِنْ أرضِ مِصْرَ، مِنْ دارِ العُبوديَّةِ، <verse eid="JER 34:13" /><verse number="14" style="v" pubnumber="14" sid="JER 34:14" />قُلتُ: كُلَّ سَبعِ سِنينَ أطلِقوا كُلُّ واحدٍ أخاهُ العِبرانيَّ حُرًّا بَعدَ أنْ يكونَ باعَ نَفسَهُ لكَ وخَدَمَكَ سِتَّ سَنواتٍ كاملةٍ، فلم يَسمَعْ لي آباؤُكُم ولا اَهتَمُّوا لِكلامي. <verse eid="JER 34:14" /><verse number="15" style="v" pubnumber="15" sid="JER 34:15" />واليومَ رَجَعتُم أنتُم إلى الطَّريقِ القَويمِ في عينَيَّ، فنادَيتُم بِتحريرِ عبيدِكُم مِنْ أبناءِ قَومِكُم وقَطَعتُم بذلِكَ عهدًا أمامي في الهيكَلِ الّذي دُعيَ باَسمي. <verse eid="JER 34:15" /><verse number="16" style="v" pubnumber="16" sid="JER 34:16" />ثُمَّ عُدْتُم فنَجَّستُمُ اَسمي وأعدتُم عبيدَكُم وإماءَكُمُ الّذينَ أطلقتُموهُم أحرارًا إلى العُبوديَّةِ.<verse eid="JER 34:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="JER 34:17" />”لِذلِكَ بِما أنَّكُم لم تَسمَعوا لِمُناداةِ صِدْقيَّا بأنْ يُحَرِّرَ كُلُّ واحدٍ عبدَهُ الّذي مِنْ إخوَتِهِ أبناءِ قَومِهِ، فها أنا اليومَ أُنادي لكُم بِالحرِّيَّةِ، حرِّيَّةِ الموتِ بِالسَّيفِ والجُوعِ والوَباءِ. يقولُ الرّبُّ. وأجعَلُكُم مَثارَ رُعْبٍ في جميعِ ممالِكِ الأرضِ. <verse eid="JER 34:17" /><verse number="18" style="v" pubnumber="18" sid="JER 34:18" />وأمَّا الرِّجالُ الّذينَ خالفوا عَهدي ونَقَضوا ما تعاهَدوا علَيهِ أمامي حينَ قطَعوا العِجْلَ شَطرينِ ومَرُّوا بَينَ قطعَتَيهِ. <verse eid="JER 34:18" /><verse number="19" style="v" pubnumber="19" sid="JER 34:19" />وهُم رُؤساءُ يَهوذا وأُورُشليمَ والخِصْيانُ والكهنَةُ وجميعُ شعبِ هذِهِ الأرضِ، <verse eid="JER 34:19" /><verse number="20" style="v" pubnumber="20" sid="JER 34:20" />فأسلِّمُهُم إلى أيدي أعدائِهِم، وأيدي الّذينَ يَطلُبونَ حياتَهُم، فتكونُ جُثَثُهُم مأكلًا لِطَيرِ السَّماءِ ولوحوشِ الأرضِ. <verse eid="JER 34:20" /><verse number="21" style="v" pubnumber="21" sid="JER 34:21" />وأُسلِمُ صِدْقيَّا مَلِكَ يَهوذا ووُزراءَهُ إلى أيدي أعدائِهِم، وأيدي الّذينَ يَطلبونَ حياتَهُم، وأيدي جيشِ مَلِكِ بابِلَ الّذينَ رجَعوا عَنكُم. <verse eid="JER 34:21" /><verse number="22" style="v" pubnumber="22" sid="JER 34:22" />فسآمُرُهُم وأُعيدُهُم إلى هذِهِ المدينةِ فيُحارِبونَها ويأخُذونَها ويَحرقونَها بِالنَّارِ، وأجعَلُ مُدُنَ يَهوذا قَفْرًا بلا ساكِنَ فيها.<verse eid="JER 34:22" /></para>
  <chapter eid="JER 34" />
  <chapter number="35" style="c" sid="JER 35" />
  <para style="s1">إرميا والرّكابيّون</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 35:1" />قالَ الرّبُّ لإرميا في أيّامِ يوياقيمَ بنِ يوشيَّا مَلِكِ يَهوذا: <verse eid="JER 35:1" /><verse number="2" style="v" pubnumber="2" sid="JER 35:2" />”إذهَبْ إلى بَيتِ الرَّكابيِّينَ وكَلِّمْهُم، واَدخُلْ بهِم إلى إحدى الغُرَفِ في بَيتِ الرّبِّ واسقِهِم خمرًا“.<verse eid="JER 35:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="JER 35:3" />فأخَذْتُ يازَنْيا بنَ إرميا بنِ حَبْصينيا وإخوَتَهُ وبَنيهِ وجميعَ بَيتِ الرَّكابيِّينَ <verse eid="JER 35:3" /><verse number="4" style="v" pubnumber="4" sid="JER 35:4" />ودخَلْتُ بهِم إلى الهيكَلِ، إلى غُرفَةِ بَني حانانَ بنِ يَجَدْليا، رَجُلِ اللهِ، وهيَ الّتي بِجانِبِ غُرفَةِ الرُّؤساءِ فَوقَ غُرفَةِ مَعْسيَّا بنِ شَلَّومَ حارِسِ الأبوابِ. <verse eid="JER 35:4" /><verse number="5" style="v" pubnumber="5" sid="JER 35:5" />ووضَعتُ أمامَ الرَّكابيِّينَ أباريقَ مَلأى مِنَ الخمرِ وكُؤوسًا وقُلتُ لهُم: ”إِشرَبوا خمرًا“. <verse eid="JER 35:5" /><verse number="6" style="v" pubnumber="6" sid="JER 35:6" />فقالوا: ”نَحنُ لا نَشربُ خمرًا، لأنَّ يونادابَ بنَ رَكابَ أبانا أوصانا قائلًا: لا تَشرَبوا خمرًا أنتُم ولا بَنوكُم إلى الأبدِ، <verse eid="JER 35:6" /><verse number="7" style="v" pubnumber="7" sid="JER 35:7" />ولا تَبنوا بَيتًا ولا تزرَعوا زَرْعًا ولا تَغرُسوا لتَعيشوا أيّامًا كثيرةً على وجهِ الأرضِ الّتي أنتُم فيها مُتغَربونَ. <verse eid="JER 35:7" /><verse number="8" style="v" pubnumber="8" sid="JER 35:8" />فسَمِعْنا ليونادابَ أبينا في كُلِّ ما أمَرَنا بهِ أنْ لا نَشربَ خمرًا كُلَّ أيّامِ حياتِنا، نحنُ ونِساؤُنا وبَنونا وبَناتُنا، <verse eid="JER 35:8" /><verse number="9" style="v" pubnumber="9" sid="JER 35:9" />وأنْ لا نَبنيَ بُيوتًا لِنَسكُنَها ولا يكونُ لنا كَرمٌ ولا حقلٌ ولا زرعٌ. <verse eid="JER 35:9" /><verse number="10" style="v" pubnumber="10" sid="JER 35:10" />وسَكَنَّا في الخيامِ وسَمِعنا وعَمِلْنا بِكُلِّ ما أمَرَنا بهِ يونادابُ أبونا، <verse eid="JER 35:10" /><verse number="11" style="v" pubnumber="11" sid="JER 35:11" />فلمَّا غزا نبوخذنَصَّرُ مَلِكُ بابِلَ هذِهِ الأرضَ قُلنا: تَعالَوا نَدخُلُ أُورُشليمَ مِنْ وجهِ جيشِ البابليِّينَ وجيشِ الآراميِّينَ، فسَكنَّا في أُورُشليمَ“.<verse eid="JER 35:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="JER 35:12" />ثُمَّ قالَ الرّبُّ إلهُ إِسرائيلَ لإرميا: <verse eid="JER 35:12" /><verse number="13" style="v" pubnumber="13" sid="JER 35:13" />”إذهَبْ وقُلْ لِرِجالِ يَهوذا ولِسُكَّانِ أُورُشليمَ: ”ألا تتأدَّبونَ فتَسمَعوا لِكلامي يقولُ الرّبُّ؟ <verse eid="JER 35:13" /><verse number="14" style="v" pubnumber="14" sid="JER 35:14" />بَنو يونادابَ بنِ رَكابَ سَمِعوا لِكلامِ أبيهِم أنْ لا يشرَبوا خمرًا، فهُم لا يَشرَبونَ إلى هذا اليومِ. أمَّا أنتُم فما سَمِعْتُم لِكلامي الّذي كَلَّمتُكُم بهِ مِرارًا وتَكرارًا، <verse eid="JER 35:14" /><verse number="15" style="v" pubnumber="15" sid="JER 35:15" />وأرسَلتُ إليكُم جميعَ عبيدي الأنبياءِ بِغيرِ اَنقطاعٍ أقولُ: إِرجِعوا عَنْ طريقِ الشَّرِّ وأصلِحوا أعمالَكُم ولا تَتبَعوا آلِهَةً أُخرى لتَعبُدوها، فتَسكنوا في الأرضِ الّتي أعطَيتُها لكُم ولآبائِكُم، فما أصغَيتُم ولا سَمِعتُم لي. <verse eid="JER 35:15" /><verse number="16" style="v" pubnumber="16" sid="JER 35:16" />وبَنو يونادابَ بنِ ركابَ يَعمَلونَ بِوصيَّةِ أبيهِم، أمَّا هذا الشَّعبُ فما سَمِعوا لي. <verse eid="JER 35:16" /><verse number="17" style="v" pubnumber="17" sid="JER 35:17" />لذلِكَ سأجلِبُ على بَيتِ يَهوذا وعلى جميعِ سُكَّانِ أُورُشليمَ كُلَّ الشَّرِّ الّذي تكَلَّمتُ بهِ علَيهِم، لأنِّي كلَّمتُهُم فما سَمِعوا، ودَعوتُهُم فما أجابوا“.<verse eid="JER 35:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="JER 35:18" />وقالَ إرميا لِبيتِ الرَّكابيِّينَ: ”قالَ الرّبُّ القديرُ إلهُ إِسرائيلَ: ”بِما أنَّكُم سَمِعتُم لِوصيَّةِ يونادابَ أبيكُم وحَفِظْتُم أحكامَهُ وعَمِلْتُم بِجميعِ ما أمَرَكُم بهِ، <verse eid="JER 35:18" /><verse number="19" style="v" pubnumber="19" sid="JER 35:19" />لذلِكَ لا يَنقَطِعُ ليونادابَ بنِ ركابَ رَجُلٌ مِنْ نَسلِهِ يَخدُمُني كُلَّ الأيّامِ“.<verse eid="JER 35:19" /></para>
  <chapter eid="JER 35" />
  <chapter number="36" style="c" sid="JER 36" />
  <para style="s1">باروخ يتلو كلام إرميا</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 36:1" />وفي السَّنةِ الرَّابعةِ ليوياقيمَ بنِ يوشيَّا مَلِكِ يَهوذا، قالَ الرّبُّ لإرميا: <verse eid="JER 36:1" /><verse number="2" style="v" pubnumber="2" sid="JER 36:2" />”خُذْ لكَ صَحيفةَ كتابٍ واَكتُبْ فيها كُلَّ الكَلامِ الّذي كَلَّمتُكَ بهِ على إِسرائيلَ ويَهوذا وجميعِ الأُمَمِ، مِنْ أيّامِ يوشيَّا إلى هذا اليومِ، <verse eid="JER 36:2" /><verse number="3" style="v" pubnumber="3" sid="JER 36:3" />لَعلَّ بَيتَ يَهوذا يَسمَعونَ بجميعِ الشَّرِّ الّذي نوَيتُ أنْ أُنزِلَهُ بِهِم، فيَرجِعوا عَنْ طريقِ السُّوءِ حتّى أعفوَ عَنْ إثْمِهِم وخطيئَتِهِم“.<verse eid="JER 36:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="JER 36:4" />فدعا إرميا باروخَ بنَ نَيريَّا وأملى علَيهِ جميعَ كَلامِ الرّبِّ الّذي كَلَّمَهُ بهِ، فكَتبَهُ في الصَّحيفةِ. <verse eid="JER 36:4" /><verse number="5" style="v" pubnumber="5" sid="JER 36:5" />وقالَ إرميا لباروخَ: ”أنا مَحبوسٌ لا أقدِرُ أنْ أدخُلَ بَيتَ الرّبِّ، <verse eid="JER 36:5" /><verse number="6" style="v" pubnumber="6" sid="JER 36:6" />فاَدخُلْ أنتَ واَقرأْ في الصَّحيفةِ ما أملَيتُهُ علَيكَ مِنْ كلامِ الرّبِّ على مسامِعِ الشَّعبِ في بَيتِ الرّبِّ يومَ الصَّومِ، واَقرَأْهُ أيضًا على مسامِعِ كُلِّ رِجالِ يَهوذا القادمينَ مِنْ مُدُنِهِم، <verse eid="JER 36:6" /><verse number="7" style="v" pubnumber="7" sid="JER 36:7" />لَعلَّهُم يَتضرَّعونَ إلى الرّبِّ ويرجِعونَ عَنْ طريقِ الشَّرِّ، لأنَّ غضَبَ الرّبِّ وسُخطَهُ الّذي تكلَّمَ بهِ علَيهم شديدٌ“.<verse eid="JER 36:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="JER 36:8" />فعَمِلَ باروخُ بنُ نَيريَّا بِكُلِّ ما أمَرَهُ بهِ إرميا النَّبيُّ، فقرَأَ في بَيتِ الرّبِّ ما كتبَهُ مِنْ كلامِ الرّبِّ. <verse eid="JER 36:8" /><verse number="9" style="v" pubnumber="9" sid="JER 36:9" />وكانَ ذلِكَ في الشَّهرِ التَّاسِعِ مِنَ السَّنةِ الخامسةِ ليوياقيمَ بنِ يوشيَّا مَلِكِ يَهوذا، حينَ تَنادى إلى الصَّومِ أمامَ الرّبِّ سُكَّانُ أُورُشليمَ وكُلُّ مَنْ جاءَ إليها مِنْ مُدُنِ يَهوذا. <verse eid="JER 36:9" /><verse number="10" style="v" pubnumber="10" sid="JER 36:10" />فقرَأَ باروخُ في الكتابِ كلامَ إرميا على مَسامِعِ كُلِّ الشَّعبِ في بَيتِ الرّبِّ، في غُرفةِ جمريا بنِ شافانَ الكاتِبِ، في الدَّارِ العُلْيا عِندَ بابِ بَيتِ الرّبِّ الجديدِ، <verse eid="JER 36:10" /><verse number="11" style="v" pubnumber="11" sid="JER 36:11" />فلمَّا سَمِعَ ميخا بنُ جمريا بنِ شافانَ، <verse eid="JER 36:11" /><verse number="12" style="v" pubnumber="12" sid="JER 36:12" />نَزَلَ إلى غُرفِةِ الكاتِبِ في قصرِ المَلِكِ، فوَجدَ الرُّؤساءَ كُلَّهُم جالسينَ هُناكَ، وهُم أليشاماعُ الكاتِبُ ودلايا بنُ شِمْعيا وألناثانُ بنُ عَكبورَ وجَمَريا بنُ شافانَ وصِدْقيَّا بنُ حنَنْيا وسِواهُم. <verse eid="JER 36:12" /><verse number="13" style="v" pubnumber="13" sid="JER 36:13" />فأخبرَهُم ميخا بجميعِ الكَلامِ الّذي سَمِعَهُ عِندَما قرأَ باروخُ في الكتابِ على مسامِعِ الشَّعبِ. <verse eid="JER 36:13" /><verse number="14" style="v" pubnumber="14" sid="JER 36:14" />فأرسَلَ جميعُ الرُّؤساءِ إلى باروخَ يهودي بنَ نَثَنْيا بنِ شَلَمْيا بنِ كوشي يقولُ لَه: ”خُذْ بِيَدِكَ الكتابَ الّذي قرأتَ فيهِ على مَسامِعِ الشَّعبِ وتعالَ“. فأخَذَ باروخُ بنُ نَيريَّا الكتابَ بِيَدِهِ وجاءَ إليهِم. <verse eid="JER 36:14" /><verse number="15" style="v" pubnumber="15" sid="JER 36:15" />فقالوا لَه: ”إجلِسْ واَقرَأ ذلِكَ على مَسامِعِنا“. فقرأَ باروخُ على مسامِعِهِم. <verse eid="JER 36:15" /><verse number="16" style="v" pubnumber="16" sid="JER 36:16" />فلمَّا سَمعوا كُلَّ هذا الكلامِ خافوا ونَظرَ بَعضُهُم إلى بَعضٍ وقالوا لباروخَ: ”يَجِبُ أنْ نُخبرَ المَلِكَ بِكُلِّ هذا الكلامِ“. <verse eid="JER 36:16" /><verse number="17" style="v" pubnumber="17" sid="JER 36:17" />وقالوا لِباروخ: ”أخبِرْنا كيفَ كَتَبتَ كُلَّ هذا الكلامِ عَنْ لِسانِ إرميا؟“ <verse eid="JER 36:17" /><verse number="18" style="v" pubnumber="18" sid="JER 36:18" />فأجابَهُم باروخُ: ”كانَ يُمليهِ عليَّ فأخُطُّهُ في الكتابِ بِالحِبرِ“. <verse eid="JER 36:18" /><verse number="19" style="v" pubnumber="19" sid="JER 36:19" />فقالوا لَه: ”إِذهَبْ واَختَبِئْ أنتَ وإرميا ولا تَدَعْ أحدًا يَعرِفُ أينَ أنتُما“.<verse eid="JER 36:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="JER 36:20" />وأودَعَ الرُّؤساءُ الكتابَ في غُرفَةِ أليشاماعَ الكاتِبِ ودَخَلوا إلى المَلِكِ في ديوانِهِ وسَرَدوا على مَسامِعِهِ كُلَّ ما ورَدَ في الكتابِ. <verse eid="JER 36:20" /><verse number="21" style="v" pubnumber="21" sid="JER 36:21" />فأرسَلَ المَلِكُ يَهودي لِيأخُذَ الكِتابَ، فأخذَهُ مِنْ غُرفَةِ أليشاماعَ الكاتِبِ وقَرأهُ على مسامِعِ المَلِكِ وجميعِ الرُّؤساءِ الحاضِرينَ لَدَيهِ، <verse eid="JER 36:21" /><verse number="22" style="v" pubnumber="22" sid="JER 36:22" />وكانَ الوقتُ شِتاءً في الشَّهرِ التَّاسِعِ، والمَلِكُ جالِسٌ وأمامَهُ كانونُ نارٍ مُتَّقِد. <verse eid="JER 36:22" /><verse number="23" style="v" pubnumber="23" sid="JER 36:23" />فلمَّا قرَأَ يَهوديُّ ثَلاثَ فقراتٍ وأربعًا شَقَّ الكتابَ بِسكِّينِ الكاتِبِ وألقاهُ في نارِ الكانونِ حتّى احتَرقَ كُلُّهُ. <verse eid="JER 36:23" /><verse number="24" style="v" pubnumber="24" sid="JER 36:24" />ولكِن لا المَلِكُ ولا أحدٌ مِنْ عبيدِهِ الّذينَ سَمِعوا كُلَّ هذا الكَلامِ فَزِعَ أو مَزَّقَ ثيابَهُ، <verse eid="JER 36:24" /><verse number="25" style="v" pubnumber="25" sid="JER 36:25" />وتَشَفَّعَ ألناثانُ ودلايا وجَمَرْيا إلى المَلِكِ أنْ لا يَحرِقَ الكتابَ فما سَمِعَ لهُم. <verse eid="JER 36:25" /><verse number="26" style="v" pubnumber="26" sid="JER 36:26" />ثُمَّ أمَرَ المَلِكُ اَبنَهُ يَرْحَمَئيلَ وسَرايا بنَ عَزرئيل وشَلَمْيا بنَ عَبدِئيلَ أنْ يَقبضوا على باروخَ الكاتِبِ وإرميا النَّبيِّ، ولكِنَّ الرّبَّ أخفاهُما.<verse eid="JER 36:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="JER 36:27" />وقالَ الرّبُّ لإرميا بَعدَ أنْ أحرَقَ المَلِكُ الكتابَ: <verse eid="JER 36:27" /><verse number="28" style="v" pubnumber="28" sid="JER 36:28" />”خُذْ صحيفةً أُخرى واَكتُبْ فيها جميعَ الكلامِ الّذي كان في الصَّحيفةِ الأولى الّتي أحرَقَها يوياقيمُ مَلِكُ يَهوذا، <verse eid="JER 36:28" /><verse number="29" style="v" pubnumber="29" sid="JER 36:29" />وقُلْ ليوياقيمَ: قالَ الرّبُّ: أنتَ أحرَقتَ هذِهِ الصَّحيفةَ وقُلتَ لإرميا، لِماذا كتَبتَ فيها أنَّ مَلِكَ بابِلَ لا بُدَّ أنْ يأتيَ ويُدَمِّرَ هذِهِ الأرضَ ويُبيدَ فيها النَّاسَ والبَهائِمَ؟ <verse eid="JER 36:29" /><verse number="30" style="v" pubnumber="30" sid="JER 36:30" />فلذلِكَ قالَ الرّبُّ على يوياقيمَ مَلِكِ يَهوذا: لا يَجلِسُ أحدٌ مِنْ نَسلِهِ على عرشِ داوُدَ، وتُطرَحُ جُثَّتُهُ لِلحَرِّ في النَّهارِ وللصَّقيعِ في اللَّيلِ. <verse eid="JER 36:30" /><verse number="31" style="v" pubnumber="31" sid="JER 36:31" />وأُعاقِبُهُ هوَ وذُرِّيَّتهُ وعبيدهُ على ذُنوبِهِم، وأجلِبُ علَيهِم وعلى سُكَّانِ أُورُشليمَ ورِجالِ يَهوذا جميعَ الشَّرِّ الّذي تَكَلَّمتُ بهِ لأنَّهُم لم يَسمَعوا“.<verse eid="JER 36:31" /></para>
  <para style="p">
    <verse number="32" style="v" pubnumber="32" sid="JER 36:32" />فأخذَ إرميا صحيفةً أخرى وأعطاها لباروخَ بنِ نَيريَّا الكاتِبِ، فكتَبَ فيها عَنْ لِسانِ إرميا كُلَّ ما اَحتَواهُ الكتابُ الّذي أحرَقَهُ يوياقيمُ بِالنَّارِ، وزِيدَ علَيهِ كلامٌ كثيرٌ مِثلُهُ.<verse eid="JER 36:32" /></para>
  <chapter eid="JER 36" />
  <chapter number="37" style="c" sid="JER 37" />
  <para style="s1">صدقيا يناشد إرميا</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 37:1" />وأمرَ نبوخذنَصَّرُ مَلِكُ بابِلَ، فمَلَّكَ صِدْقيَّا بنَ يوشيَّا مكانَ كُنْيا بنِ يوياقيمَ على أرضِ يَهوذا. <verse eid="JER 37:1" /><verse number="2" style="v" pubnumber="2" sid="JER 37:2" />فلم يسمَعْ هوَ ولا رِجالُهُ ولا شعبُ تِلكَ الأرضِ لِكلامِ الرّبِّ على لِسانِ إرميا النَّبيِّ.<verse eid="JER 37:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="JER 37:3" />وأرسَلَ المَلِكُ صِدْقيَّا يوخَلَ بنَ شَلَمْيا وصَفَنْيا بنَ مَعسِيَّا الكاهنَ إلى إرميا النَّبيِّ يقولُ لَه: ”صَلِّ مِنْ أجلِنا إلى الرّبِّ إلهِنا“. <verse eid="JER 37:3" /><verse number="4" style="v" pubnumber="4" sid="JER 37:4" />وكانَ إرميا يَروحُ ويَجيءُ بَينَ الشَّعبِ، قَبلَ أنْ يُلقَى في السِّجنِ. <verse eid="JER 37:4" /><verse number="5" style="v" pubnumber="5" sid="JER 37:5" />وكانَ البابِليُّونَ يُحاصِرونَ أُورُشليمَ، فلمَّا سَمِعوا بأنَّ جيشَ فِرعونَ خرَجَ إليهِم مِنْ مِصْرَ اَرتَدُّوا عَنْ أُورُشليمَ. <verse eid="JER 37:5" /><verse number="6" style="v" pubnumber="6" sid="JER 37:6" />فقالَ الرّبُّ لإرميا النَّبيِّ: <verse eid="JER 37:6" /><verse number="7" style="v" pubnumber="7" sid="JER 37:7" />”قُلْ لِمَلِكِ يَهوذا الّذي أرسلَكَ لِتَستَشيرَني: سيَرجِعُ جيشُ فِرعَونَ الّذي خرَجَ لِمُساعَدَتِكُم إلى أرضِ مِصْرَ، <verse eid="JER 37:7" /><verse number="8" style="v" pubnumber="8" sid="JER 37:8" />ويَرجِعُ البابليُّونَ ويُحارِبونَ هذِهِ المدينةَ ويَأخُذونَها ويَحرقونَها بِالنَّارِ. <verse eid="JER 37:8" /><verse number="9" style="v" pubnumber="9" sid="JER 37:9" />فلا تَخدَعوا أنفُسَكُم فتقولوا: سيذهَبُ البابليُّونَ عنَّا لأنَّهُم لا يَذهبونَ. <verse eid="JER 37:9" /><verse number="10" style="v" pubnumber="10" sid="JER 37:10" />بل لو قتَلْتُم جميعَ جيشِ البابليِّينَ الّذينَ يُحارِبونَكُم وبَقيَ مِنهُم عدَدٌ مِنَ الجَرحى في عَسكرِهِم، فهؤلاءِ يقومونَ ويحرِقونَ هذِهِ المدينةَ بِالنَّارِ“.<verse eid="JER 37:10" /></para>
  <para style="s1">إرميا في السجن</para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JER 37:11" />ولمَّا رجَعَ جيشُ البابليِّينَ عَنْ أُورُشليمَ عِندَ اقترابِ جيشِ فِرعونَ، <verse eid="JER 37:11" /><verse number="12" style="v" pubnumber="12" sid="JER 37:12" />خرَجَ إرميا مِنْ أُورُشليمَ لِيَذهبَ إلى أرضِ بنيامينَ ويأخُذَ حِصَّتَهُ مِنْ إِرثِ عائِلَتِهِ. <verse eid="JER 37:12" /><verse number="13" style="v" pubnumber="13" sid="JER 37:13" />فلمَّا وصَلَ إلى بابِ بنيامينَ قبَضَ علَيهِ رئيسُ الحَرسِ واسمُهُ يَرئِيَّا بنُ شَلَمْيا بنِ حَنَنِيَّا وقالَ لَه: ”أنتَ هاربٌ إلى البابليِّينَ“. <verse eid="JER 37:13" /><verse number="14" style="v" pubnumber="14" sid="JER 37:14" />فقالَ لَه إرميا: ”هذا كَذِبٌ. ما أنا هارِبٌ إلى البابليِّين“. فلم يَسمَعْ لَه، بل قبَضَ علَيهِ وجاءَ بهِ إلى الرُّؤساءِ. <verse eid="JER 37:14" /><verse number="15" style="v" pubnumber="15" sid="JER 37:15" />فثارَ غضَبُ الرُّؤساءِ على إرميا وضرَبوهُ وألقوهُ في بَيتِ يوناثانَ الكاتِبِ، لأنَّهُم جعَلوا ذلِكَ البَيتَ سِجنًا.<verse eid="JER 37:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="JER 37:16" />فدخَلَ إرميا إلى سرَاديبِ السِّجنِ وأقامَ هُناكَ أيّامًا كثيرةً. <verse eid="JER 37:16" /><verse number="17" style="v" pubnumber="17" sid="JER 37:17" />ثُمَّ أرسَلَ المَلِكُ صِدْقيَّا وأخذَهُ وسألَهُ في قصرِهِ سِرًّا: ”هل كَلَّمَكَ الرّبُّ حَقًّا؟“ فقالَ إرميا: ”نعم، وقالَ لي سَتُسَلَّمُ إلى يَدِ مَلِكِ بابِلَ“.<verse eid="JER 37:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="JER 37:18" />وقالَ إرميا للمَلِكِ صِدْقيَّا: ”بِماذا خَطِئْتُ إليكَ وإلى رِجالِكَ وإلى هذا الشَّعبِ حتّى ألقَيتُموني في السِّجنِ؟ <verse eid="JER 37:18" /><verse number="19" style="v" pubnumber="19" sid="JER 37:19" />وأينَ أنبياؤُكُمُ الّذينَ تنَبَّأوا لكُم قائِلينَ إنَّ مَلِكَ بابِلَ لا يأتي علَيكُم ولا على هذِهِ الأرضِ؟ <verse eid="JER 37:19" /><verse number="20" style="v" pubnumber="20" sid="JER 37:20" />”والآنَ إِسمَعْ يا سيِّدي المَلِكُ واَقبَلْ تَضَرُّعي إليكَ ولا تَرُدَّني إلى بَيتِ يوناثانَ الكاتِبِ لِئلَّا أموتَ هُناكَ“. <verse eid="JER 37:20" /><verse number="21" style="v" pubnumber="21" sid="JER 37:21" />فأمرَ المَلِكُ صِدْقيَّا أن يودَعَ إرميا في سِجنِ القصرِ، وأنْ يُعطَى لَه رغيفٌ مِنَ الخبزِ كُلَّ يومٍ مِنْ سُوقِ الخَبَّازينَ إلى أنْ يَنفُدَ الخبزُ كُلُّهُ مِنَ المدينةِ. فأقامَ إرميا في سِجنِ القصرِ.<verse eid="JER 37:21" /></para>
  <chapter eid="JER 37" />
  <chapter number="38" style="c" sid="JER 38" />
  <para style="s1">إرميا في الجب</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 38:1" />وسَمِعَ شَفَطْيا بنُ مَتَّانَ وجَدَليا بنُ فَشحورَ ويوخَلُ بنُ شَلَمْيا وفَشحورُ بنُ مَلْكيَّا أنَّ إرميا كانَ يقولُ لِلشَّعبِ كُلِّهِ: <verse eid="JER 38:1" /><verse number="2" style="v" pubnumber="2" sid="JER 38:2" />”إنّ الرّبَّ قالَ: كُلُّ مَنْ يُقيمُ في هذِهِ المدينةِ يموتُ بِالسَّيفِ والجوعِ والوباءِ، ومَنْ يَخرُجُ إلى البابليِّينَ يَحيا ويَنجو بِحياتِهِ. <verse eid="JER 38:2" /><verse number="3" style="v" pubnumber="3" sid="JER 38:3" />وستسَلَّمُ هذِهِ المدينةُ إلى أيدي جيشِ مَلِكِ بابِلَ، فيَحتَلُّها“.<verse eid="JER 38:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="JER 38:4" />فقالَ أُولَئِكَ الرُّؤساءُ لِلمَلِكِ: ”أُقتُلْ هذا الرَّجُلَ لأنَّهُ يُضعِفُ عزيمةَ المُحارِبينَ الباقينَ في هذِهِ المدينةِ وعزيمةَ جميعِ الشَّعبِ بِكلامِهِ هذا، لأنَّهُ لا يُريدُ لِهذا الشَّعبِ خَيرًا بل شَرًّا“. <verse eid="JER 38:4" /><verse number="5" style="v" pubnumber="5" sid="JER 38:5" />فقالَ المَلِكُ صِدقيَّا: ”هوَ في أيديكُم وأنا المَلِكُ لا أقدِرُ أنْ أمنَعكُم“. <verse eid="JER 38:5" /><verse number="6" style="v" pubnumber="6" sid="JER 38:6" />فأخَذوا إرميا ليُلقوهُ في جُبِّ مَلْكيَّا اَبنِ المَلِكِ في سِجنِ القصرِ، فدَلُّوهُ بِحبالٍ وكانَ في الجُبِّ وَحْلٌ ولا ماءَ فيهِ، فغاصَ إرميا في الوَحْلِ.<verse eid="JER 38:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="JER 38:7" />فسَمِعَ عَبدُ مَلِكُ الكوشيُّ، أحدُ الخِصيانِ وهوَ في قصرِ المَلِكِ أنَّهُم ألقوا إرميا في الجُبِّ، وكانَ المَلِكُ جالِسًا بِبابِ بنيامينَ. <verse eid="JER 38:7" /><verse number="8" style="v" pubnumber="8" sid="JER 38:8" />فخَرجَ عَبدُ مَلِكُ مِنَ القصرِ وقالَ لِلمَلِكِ: <verse eid="JER 38:8" /><verse number="9" style="v" pubnumber="9" sid="JER 38:9" />”يا سيِّدي المَلِكُ! أُولَئِكَ الرِّجالُ أساؤوا في كُلِّ ما فعَلوا بإرميا النَّبيِّ الّذي ألقوهُ في الجُبِّ، فهوَ يموتُ جُوعًا هُناكَ وما بَقيَ في المدينةِ خبزٌ“. <verse eid="JER 38:9" /><verse number="10" style="v" pubnumber="10" sid="JER 38:10" />فأمرَهُ المَلِكُ قالَ: ”خُذْ مِنْ هُنا ثَلاثةَ رِجالٍ وأخْرِجْ إرميا النَّبيَّ مِنَ الجُبِّ قَبلَ أنْ يموتَ“. <verse eid="JER 38:10" /><verse number="11" style="v" pubnumber="11" sid="JER 38:11" />فأخَذَهُم وجاءَ إلى قصرِ المَلِكِ وتناوَلَ مِنَ الخِزانَةِ هُناكَ ثيابًا عتيقةً وخِرقًا باليةً ودَلَّاها بِحِبالٍ إلى إرميا في الجُبِّ. <verse eid="JER 38:11" /><verse number="12" style="v" pubnumber="12" sid="JER 38:12" />وقالَ عَبدُ مَلِكُ الكوشيُّ لإرميا: ”ضَعِ الثِّيابَ العتيقةَ والخِرَقَ الباليةَ تَحتَ إبطَيك مِنْ تَحتِ الحِبالِ“. ففَعَلَ كذلِكَ. <verse eid="JER 38:12" /><verse number="13" style="v" pubnumber="13" sid="JER 38:13" />وجَذَبوهُ بِالحِبالِ وأخرَجوهُ مِنَ الجُبِّ وأقامَ في السِّجنِ.<verse eid="JER 38:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="JER 38:14" />ثُمَّ أرسَلَ المَلِكُ صِدْقيَّا وأخذَ إرميا النَّبيَّ إليهِ في المَدخَلِ الثَّالِثِ لِبيتِ الرّبِّ وقالَ لَه: ”أُريدُ أنْ أسألَكَ عَنْ أمرٍ، فلا تكْتُمْ عنِّي شيئًا. <verse eid="JER 38:14" /><verse number="15" style="v" pubnumber="15" sid="JER 38:15" />فأجابَهُ إرميا: ”إنْ أخبَرتُكَ تَقتُلُني، وإنْ نَصَحتُكَ لا تَسمَعُ لي“. <verse eid="JER 38:15" /><verse number="16" style="v" pubnumber="16" sid="JER 38:16" />فحَلَفَ لَه المَلِكُ سِرًّا قالَ: ”حَيٌّ الرّبُّ الّذي وهَبَنا الحياةَ لا أقتُلُكَ ولا أُسْلِمُكَ إلى أيدي أُولئِكَ الرِّجالِ الّذينَ يَطلبونَ حياتَكَ“.<verse eid="JER 38:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="JER 38:17" />فقالَ إرميا لِصدْقيَّا: ”قالَ الرّبُّ القديرُ إلهُ إِسرائيلَ: إنْ خرَجْتَ إلى رُؤساءِ مَلِكِ بابِلَ تَحفَظُ حياتَكَ، وهذِهِ المدينةُ لا تُحرَقُ بِالنَّارِ، وأنتَ وأهلُ بَيتِكَ تَنجُونَ بِحياتِكُم. <verse eid="JER 38:17" /><verse number="18" style="v" pubnumber="18" sid="JER 38:18" />وإنْ كُنتَ لا تخرُجُ إلى رُؤساءِ مَلِكِ بابِلَ، فهذِهِ المدينةُ تَسقُطُ في أيدي البابِليِّينَ، فيَحرقونَها بِالنَّارِ وأنتَ لا تفلتُ مِنْ أيديهِم“. <verse eid="JER 38:18" /><verse number="19" style="v" pubnumber="19" sid="JER 38:19" />فقالَ المَلِكُ صِدْقيَّا لإرميا: ”أخافُ أنْ أُسلَمَ إلى أيدي اليَهودِ الّذينَ هَرَبوا إلى البابِليِّينَ فيَستَهزِئونَ بي“. <verse eid="JER 38:19" /><verse number="20" style="v" pubnumber="20" sid="JER 38:20" />فقالَ لَه إرميا: ”لا تُسْلَمُ إلى أيديهِم إسمَعْ لِكَلامِ الرّبِّ الّذي أُكَلِّمُكَ بهِ فيكونَ لكَ خَيرٌ وتُحفَظ حياتُكَ. <verse eid="JER 38:20" /><verse number="21" style="v" pubnumber="21" sid="JER 38:21" />لكِنْ إنْ رَفَضتَ ذلِكَ فالرُّؤيا الّتي أراني إِيَّاها الرّبُّ تَصدُقُ علَيكَ. <verse eid="JER 38:21" /><verse number="22" style="v" pubnumber="22" sid="JER 38:22" />فيُساقُ جميعُ مَنْ بَقيَ مِنَ النِّساءِ في قصرِ المَلِكِ إلى رُؤساءِ مَلِكِ بابِلَ، فيَقُلْنَ: رِجالُكَ الّذينَ وثِقْتَ بِهِم خَدَعوكَ وتَغَلَّبوا علَيكَ، فغَرِقَت رِجلاكَ في الوَحْلِ وهُمُ اَنصَرَفوا عَنكَ. <verse eid="JER 38:22" /><verse number="23" style="v" pubnumber="23" sid="JER 38:23" />وتُساقُ جميعُ نِسائِكَ وبَنيكَ إلى البابِليِّينَ، وأنتَ لا تفلتُ مِنْ أيديهِم، بل يأسُرُكَ مَلِكُ بابِلَ، وهذِهِ المدينةُ تُحرَقُ بِالنَّارِ“. <verse eid="JER 38:23" /><verse number="24" style="v" pubnumber="24" sid="JER 38:24" />فقالَ صِدْقيَّا لإرميا: ”لا تَدَعْ أحدًا يَعلَمُ بِهذا الكلامِ لِئلَّا تموتَ. <verse eid="JER 38:24" /><verse number="25" style="v" pubnumber="25" sid="JER 38:25" />وإذا سَمِعَ الرُّؤساءُ بِأنِّي كَلَّمتُكَ، فجاؤوا وقالوا لكَ: أخبِرْنا ماذا قُلتَ لِلمَلِكِ وماذا قالَ المَلِكُ لكَ. لا تكتُمْهُ عنَّا فلا نَقتُلُكَ <verse eid="JER 38:25" /><verse number="26" style="v" pubnumber="26" sid="JER 38:26" />فقُلْ لهُم: تَضَرَّعْتُ إلى المَلِكِ أنْ لا يُعيدَني إلى بَيتِ يوناثانَ لأموتَ هُناكَ“.<verse eid="JER 38:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="JER 38:27" />فجاءَ جميعُ الرُّؤساء إلى إرميا وسألوهُ، فأخبَرَهُم كما أوصاهُ المَلِكُ. فكَفُّوا عَنهُ لأنَّ أحدًا لم يَسمَعْ ما تَحَدَّثَ بهِ معَ المَلِكِ. <verse eid="JER 38:27" /><verse number="28" style="v" pubnumber="28" sid="JER 38:28" />وأقامَ إرميا في السِّجنِ إلى يومِ أُخِذَت أُورُشليمَ.<verse eid="JER 38:28" /></para>
  <chapter eid="JER 38" />
  <chapter number="39" style="c" sid="JER 39" />
  <para style="s1">سقوط أُورُشليم</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 39:1" />في الشَّهرِ العاشِرِ من السَّنةِ التَّاسِعةِ لِصدْقيَّا مَلِكِ يَهوذا جاءَ نبوخذنَصَّرُ مَلِكُ بابِلَ وجميعُ جيشِهِ إلى أُورُشليمَ وحاصَرَها. <verse eid="JER 39:1" /><verse number="2" style="v" pubnumber="2" sid="JER 39:2" />وفي الشَّهرِ الرَّابِعِ مِنَ السَّنةِ الحاديَةَ عَشْرَةَ لِصِدْقيَّا، اَختَرَقَ العدُوُّ أسوارَ المدينةِ. <verse eid="JER 39:2" /><verse number="3" style="v" pubnumber="3" sid="JER 39:3" />ودخَلَ كُلُّ رُؤساءِ مَلِكِ بابِلَ وجَلَسوا بِالبابِ الأوسَطِ، وهُم: نَرجَلُ شراصَرُ رئيسُ المَجوسِ، وسَمْجَرُ نَبو وسرسَخيمُ رئيسُ الخِصيانِ وسواهُم. <verse eid="JER 39:3" /><verse number="4" style="v" pubnumber="4" sid="JER 39:4" />فلمَّا رآهُم صِدْقيَّا مَلِكُ يَهوذا وجميعُ جُنودِهِ هَرَبوا وخرَجوا مِنَ المدينةِ لَيلًا مِنْ طريقِ بستانِ المَلِكِ مِنَ البابِ الّذي بَينَ السُّورَينِ، وذَهَبوا في طريقِ غَورِ الأردُنِّ. <verse eid="JER 39:4" /><verse number="5" style="v" pubnumber="5" sid="JER 39:5" />فلَحِقَ بِهِم جيشُ البابِليِّينَ في سَهلِ أريحا، فقَبَضوا على صِدْقيَّا وأخَذوهُ إلى نبوخذنَصَّرَ مَلِكِ بابِلَ في رَبلَةَ بِأرضِ حَماةَ، فحكَمَ علَيهِ. <verse eid="JER 39:5" /><verse number="6" style="v" pubnumber="6" sid="JER 39:6" />وذبَحَ مَلِكُ بابِلَ بَني صِدْقيَّا في رَبلَةَ أمامَ عَينَيهِ، كما ذبَحَ جميعَ أشرافِ يَهوذا. <verse eid="JER 39:6" /><verse number="7" style="v" pubnumber="7" sid="JER 39:7" />وفقَأَ عَينَي صِدْقيَّا وقَيَّدَهُ بِسِلسِلَتينِ مِنْ نُحاسٍ لِيَجيءَ بهِ إلى بابِلَ. <verse eid="JER 39:7" /><verse number="8" style="v" pubnumber="8" sid="JER 39:8" />وأحرَقَ البابِليُّونَ قصرَ المَلِكِ وبُيوتَ الشَّعبِ بِالنَّارِ وهَدَموا أسوارَ أُورُشليمَ. <verse eid="JER 39:8" /><verse number="9" style="v" pubnumber="9" sid="JER 39:9" />وسَبى نَبُوزَرادانُ، رئيسُ الشُّرطَةِ إلى بابِلَ بَقيَّةَ الّذينَ اَعتَصَموا في المدينةِ، والهارِبينَ الّذينَ لَجأُوا إليهِ، وسائِرَ الصُنَّاع. <verse eid="JER 39:9" /><verse number="10" style="v" pubnumber="10" sid="JER 39:10" />أمَّا الفُقراءُ مِنَ الشَّعبِ الّذينَ لا يَملِكونَ شيئًا، فتَركَهُم نَبوزَرادانُ في أرضِ يَهوذا وأعطاهُم كُرومًا وحُقولًا في ذلِكَ الوقتِ.<verse eid="JER 39:10" /></para>
  <para style="s1">إرميا يخرج من السجن</para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JER 39:11" />قالَ نبوخذنَصَّرُ مَلِكُ بابِلَ لِنَبوزَرادانَ، رئيسِ الشُّرطَةِ في شأنِ إرميا: <verse eid="JER 39:11" /><verse number="12" style="v" pubnumber="12" sid="JER 39:12" />”خُذْهُ وأكرِمْهُ ولا تُسِئْ إليهِ في شيءٍ، بل اعمَلْ لَه كما يقولُ لكَ“. <verse eid="JER 39:12" /><verse number="13" style="v" pubnumber="13" sid="JER 39:13" />فأرسَلَ نَبوزَرادانُ رئيسُ الشُّرطَةِ، ونَبوشَزبانُ رئيسُ الخِصيانِ، ونَرجَلُ شَراصَرُ رئيسُ المَجوسِ، وجميعُ رِجالِ مَلِكِ بابِلَ، <verse eid="JER 39:13" /><verse number="14" style="v" pubnumber="14" sid="JER 39:14" />أرسَلوا وأخَذوا إرميا مِنَ السِّجنِ ليُسلِموهُ إلى جَدَليا بنِ أحيقامَ بنِ شافانَ، فيَجِيءَ بهِ إلى بَيتِهِ، ليُقيمَ بَينَ الشَّعبِ.<verse eid="JER 39:14" /></para>
  <para style="s1">وعد الرّبّ لعبد ملك</para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="JER 39:15" />وقالَ الرّبُّ لإرميا عِندَما كانَ مَحبوسًا في السِّجنِ: <verse eid="JER 39:15" /><verse number="16" style="v" pubnumber="16" sid="JER 39:16" />”إِذهَبْ وقُل لِعَبدَ مَلِكَ الكُوشيِّ: يقولُ الرّبُّ القديرُ إلهُ إِسرائيلَ: سَأُتِمُّ كَلامي على هذِهِ المدينةِ لِلشَّرِّ لا لِلخَيرِ، ويكونُ ذلِكَ أمامَكَ يومَ يَتِمُّ. <verse eid="JER 39:16" /><verse number="17" style="v" pubnumber="17" sid="JER 39:17" />لَكنِّي أُنقِذُكَ في ذلِكَ اليومِ، فلا تَقَعُ في أيدي الّذينَ تخافُ مِنهُم. <verse eid="JER 39:17" /><verse number="18" style="v" pubnumber="18" sid="JER 39:18" />وأُنَجِّيكَ فلا تَسقُطُ بِالسَّيفِ، بل تَنجو بِحياتِكَ لأنَّكَ تَوَكَّلْتَ عليَّ، يقولُ الرّبُّ“.<verse eid="JER 39:18" /></para>
  <chapter eid="JER 39" />
  <chapter number="40" style="c" sid="JER 40" />
  <para style="s1">إرميا يقيم عند جدليا</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 40:1" />وكلَّمَ الرّبُّ إرميا بَعدَ أنْ أطلَقَهُ نَبوزَرادانُ رئيسُ الشُّرطَةِ مِنَ الرَّامَةِ حَيثُ كانَ أخذَهُ مُكبَّلًا بِالقُيودِ بَينَ جميعِ أسرى أُورُشليمَ ويَهوذا الّذينَ سُبُوا إلى بابِلَ. <verse eid="JER 40:1" /><verse number="2" style="v" pubnumber="2" sid="JER 40:2" />فاَنفَرَدَ رئيسُ الشُّرطَةِ بإرميا وقالَ لَه: ”الرّبُّ إلَهُكَ تكَلَّمَ بِهذا الشَّرِّ على هذا الموضِعِ، <verse eid="JER 40:2" /><verse number="3" style="v" pubnumber="3" sid="JER 40:3" />وهوَ الّذي جَلَبَهُ كما قالَ، خَطِئْتُم إليهِ وما سَمِعْتُم لَه، فتَمَّ علَيكُم هذا الأمرُ. <verse eid="JER 40:3" /><verse number="4" style="v" pubnumber="4" sid="JER 40:4" />والآنَ أفلَتُّ يَدَكَ مِنَ القيودِ، فإنْ رَغِبتَ أنْ تَجيءَ معي إلى بابِلَ، فتعالَ، وأنا أعتَني بِأمرِكَ. وإنْ ساءَكَ أنْ تَجيءَ مَعي إلى بابِلَ فابْقَ. أُنظُرْ! فالأرضُ كُلُّها بَينَ يَدَيكَ، وأينَما طابَ لكَ ووافَقَ أنْ تَذهَبَ فاَذْهَبْ <verse eid="JER 40:4" /><verse number="5" style="v" pubnumber="5" sid="JER 40:5" />أمَّا إذا بَقيتَ، فَعُدْ إلى جَدَلْيا بنِ أحيقامَ بنِ شافانَ الّذي ولَّاهُ مَلِكُ بابِلَ على مُدُنِ يَهوذا، وأقِمْ معَهُ بَينَ الشَّعبِ، أو فاَذهَبْ أينَما تيَسَّرَ لكَ“. وأعطاهُ زادًا وهديَّةً وصَرَفَهُ.<verse eid="JER 40:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="JER 40:6" />فجاءَ إرميا إلى جَدليا بنِ أحيقامَ في مِصفاةَ وأقامَ معَهُ بَينَ الشَّعبِ الباقي في البِلادِ.<verse eid="JER 40:6" /></para>
  <para style="s1">جدليا حاكم يهوذا</para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="JER 40:7" />ولمَّا سَمِعَ القادَةُ والجُنودُ الّذينَ لَجأُوا إلى الصَّحراءِ أنَّ مَلِكَ بابِلَ ولَّى جَدَليا بنَ أحيقامَ على أرضِ يَهوذا، ووكَّلَ إليهِ الفُقَراءَ مِنَ الرِّجالِ والنِّساءِ والأطفالِ الّذينَ بَقوا في البِلادِ ولم يَسْبِهِمِ البابِليُّونَ إلى بابِلَ، <verse eid="JER 40:7" /><verse number="8" style="v" pubnumber="8" sid="JER 40:8" />جاؤوا إلى جَدَليا في مِصفاةَ، وهُم إسماعيلُ بنُ نَثَنيا ويوحانانُ ويوناثانُ اَبنا قارِيعَ وسَرايا بنُ تَنحومَثَ، وبَنو عيفايَ النَّطوفاتيِّ، ويَزَنْيا بنُ المَعكيِّ، هُم ورِجالُهُم. <verse eid="JER 40:8" /><verse number="9" style="v" pubnumber="9" sid="JER 40:9" />فطَمأنَهُم جَدَليا بِقولِهِ لهُم: ”لا تخافوا مِنْ عُبوديَّةِ البابِليِّينَ. أُسكُنوا في هذِهِ الأرضِ واَخدُموا مَلِكَ بابِلَ. <verse eid="JER 40:9" /><verse number="10" style="v" pubnumber="10" sid="JER 40:10" />وأنا مُقيمٌ في مِصفاةَ لِأستَقبِلَ البابِليِّينَ الّذينَ يأتونَ إِلينا، أمَّا أنتُم فاَجمَعوا الخمرَ والثِّمارَ والزَّيتَ واخزُنوها في أوعيَتِكُم واَسكُنوا في مُدُنِكُمُ الّتي تَحتَلُّونَها“. <verse eid="JER 40:10" /><verse number="11" style="v" pubnumber="11" sid="JER 40:11" />وكذلِكَ فعَلَ جميعُ اليهودِ الّذينَ في مُوآبَ وبَينَ بَني عَمُّونَ وفي أدومَ وسائِرِ الأراضي حينَ سَمِعوا أنَّ مَلِكَ بابِلَ ترَكَ بَقيَّةً مِنَ الشَّعبِ في يَهوذا ووَلَّى علَيهِم جَدَليا بنَ أحيقامَ بنِ شافانَ. <verse eid="JER 40:11" /><verse number="12" style="v" pubnumber="12" sid="JER 40:12" />فرَجَعوا مِنْ جميعِ المواضعِ الّتي طُرِدوا إليها وجاؤوا إلى أرضِ يَهوذا، إلى جَدَليا في مِصفاةَ، وجَمَعوا مِنَ الخمرِ والثِّمارِ شيئًا كثيرًا جدًّا.<verse eid="JER 40:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="JER 40:13" />ثُمَّ إنَّ يوحانانَ بنَ قاريحَ وجميعَ القادَةِ الّذينَ لَجأوا إلى الصَّحراءِ جاؤوا إلى جَدَليا في مِصفاةَ <verse eid="JER 40:13" /><verse number="14" style="v" pubnumber="14" sid="JER 40:14" />وقالوا لَه: ”هل عَلِمْتَ أنَّ بَعليسَ مَلِكَ بَني عَمُّونَ أرسَلَ إِسماعيلَ بنَ نَثَنيا لِيَقتُلَكَ؟“ فما صَدَّقَهُم جَدَليا. <verse eid="JER 40:14" /><verse number="15" style="v" pubnumber="15" sid="JER 40:15" />فقالَ يوحانانُ بنُ قاريحَ لِجَدَليا سِرًّا في مصفاةَ: ”دَعني أَذهَبُ فأقتُلَ إسماعيلَ بنَ نَثَنيا دونَ أنْ يَعلَمَ أحدٌ. لِماذا يَقتُلُكَ هوَ فيَتَبَدَّد جميعُ اليهودِ المُجتمِعينَ إليكَ وتَهلِك بَقيَّةُ يَهوذا“. <verse eid="JER 40:15" /><verse number="16" style="v" pubnumber="16" sid="JER 40:16" />فأجابَهُ جَدَليا: ”لا تفعَلْ، فما تقولُهُ على إسماعيلَ اَفتِراءٌ“.<verse eid="JER 40:16" /></para>
  <chapter eid="JER 40" />
  <chapter number="41" style="c" sid="JER 41" />
  <para style="s1">مقتل جدليا</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 41:1" />وفي الشَّهرِ السَّابِعِ مِنْ تِلكَ السَّنةِ جاءَ إسماعيلُ بنُ نَثَنيا بنِ أليشاماعَ، وهوَ مِنَ العائِلةِ المالِكَةِ وأحدُ وُزَراءِ المَلِكَ، وعَشَرَةُ رِجالٍ معَهُ إلى جَدَليا بنِ أحيقامَ في مِصفاةَ. وبَعدَ أنْ تَناولوا الطَّعامَ معَهُ، <verse eid="JER 41:1" /><verse number="2" style="v" pubnumber="2" sid="JER 41:2" />قامَ إسماعيلُ والعَشَرَةُ الرِّجالِ الّذينَ معَهُ وضَربوا جَدَليا بِالسَّيفِ وقَتَلوهُ، وهوَ الّذي ولاهُ مَلِكُ بابِلَ على أرضِ يَهوذا، <verse eid="JER 41:2" /><verse number="3" style="v" pubnumber="3" sid="JER 41:3" />كما قَتَلوا جميعَ اليَهودِ الّذينَ كانوا معَ جَدَليا في مِصفاة، والجُنودَ البابِليِّينَ الّذينَ وجَدوهُم هُناكَ.<verse eid="JER 41:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="JER 41:4" />وفي اليومِ الثَّاني بَعدَ مَقتَلِ جَدَليا، وقَبلَ أنْ يَعلَمَ أحدٌ، <verse eid="JER 41:4" /><verse number="5" style="v" pubnumber="5" sid="JER 41:5" />جاءَ مِنْ شكيمَ وشيلوهَ والسَّامِرةِ ثمانونَ رَجُلًا حَلَقوا لِحاهُم ومَزَّقوا ثيابَهُم وخَدَشوا وجوهَهُم، وبِأيديهِم تَقدِمَةٌ ولُبانٌ ليُقَرِّبوهُما في بَيتِ الرّبِّ. <verse eid="JER 41:5" /><verse number="6" style="v" pubnumber="6" sid="JER 41:6" />فخَرَجَ إسماعيلُ بنُ نَثَنيا لِلقائِهِم مِنْ مِصفاةَ، وكانَ يَسيرُ باكيًا، ولمَّا اَستقبَلَهُم قالَ لهُم: ”تعالَوا إلى جَدَليا بنِ أحيقامَ“. <verse eid="JER 41:6" /><verse number="7" style="v" pubnumber="7" sid="JER 41:7" />فلمَّا دَخلوا إلى وسَطِ المدينةِ ذبَحَهُم إسماعيلُ وألقاهُم في الجُبِّ، هوَ والرِّجالُ الّذينَ معَهُ. <verse eid="JER 41:7" /><verse number="8" style="v" pubnumber="8" sid="JER 41:8" />وكانَ بينَهُم عَشَرَةُ رِجالٍ قالوا لإسماعيلَ: ”لا تَقتُلْنا، فلنا كُنوزٌ في البرِّيَّةِ مِنْ حِنطَةٍ وشعيرٍ وزيتٍ وعسَلٍ“. فاَمتَنَعَ عَنْ قَتْلِهِم بَينَ رِفاقِهِم.<verse eid="JER 41:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="JER 41:9" />وكانَ الجُبُّ الّذي ألقى فيهِ إسماعيلُ جُثَثَ الرِّجالِ الّذينَ قَتلَهُم، هوَ الجُبُّ الكبيرُ الّذي حفَرَهُ المَلِكُ آسا لِحِمايَتِهِ مِنْ بَعشا مَلِكِ إِسرائيلَ، فمَلأهُ إِسماعيلُ بِالقَتلى. <verse eid="JER 41:9" /><verse number="10" style="v" pubnumber="10" sid="JER 41:10" />واَعتقَلَ إِسماعيلُ جميعَ مَنْ بَقيَ في مِصفاةَ، ومِنهُم بناتُ المَلِكِ والّذينَ جعَلَهُم نَبوزَرادانُ رئيسُ الشِّرطةِ في عِهدَةِ جَدَليا بنِ أحيقامَ، وأخَذَهُم معَهُ أسرى إلى بَني عَمُّونَ.<verse eid="JER 41:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JER 41:11" />فسَمِعَ يوحانانُ بنُ قاريحَ وجميعُ قادةِ الجيشِ الّذينَ معَهُ بِالشَّرِّ العظيمِ الّذي فعَلَهُ إسماعيلُ بنُ نَثَنيا، <verse eid="JER 41:11" /><verse number="12" style="v" pubnumber="12" sid="JER 41:12" />فأخَذوا جميعَ رِجالِهِم وساروا إلى مُحاربَةِ إسماعيلَ. فصادَفوهُ عِندَ البِرْكَةِ الكبيرةِ الّتي في جبعونَ. <verse eid="JER 41:12" /><verse number="13" style="v" pubnumber="13" sid="JER 41:13" />فلمَّا رأى جميعُ الأسرى الّذينَ معَ إسماعيلَ قادةَ الجيشِ وعلى رأسِهِم يوحانانُ بنُ قاريحَ فرحوا، <verse eid="JER 41:13" /><verse number="14" style="v" pubnumber="14" sid="JER 41:14" />وأقبَلوا علَيهِ مُسرعينَ. <verse eid="JER 41:14" /><verse number="15" style="v" pubnumber="15" sid="JER 41:15" />أمَّا إسماعيلُ فهرَبَ معَ ثمانيةِ رجالٍ مِنْ وجهِ يوحانانَ وذهَبَ إلى بَني عمُّونَ. <verse eid="JER 41:15" /><verse number="16" style="v" pubnumber="16" sid="JER 41:16" />فاَسترَدَّ يوحانانُ وقادةُ الجيشِ الّذينَ معَهُ بَقيَّةَ شعبِ مِصفاةَ مِنْ إسماعيلَ بَعدَ مَقتَلِ جَدَليا وأعادَهُم إلى جبعونَ، وهُم جنودٌ ونِساءٌ وأطفالٌ وخِصيان. <verse eid="JER 41:16" /><verse number="17" style="v" pubnumber="17" sid="JER 41:17" />فساروا وأقاموا في جَيروتَ كِمهامَ الّتي بِجوارِ بَيت لَحمَ، وفي نيَّتِهِم أنْ يَلجأُوا إلى مِصْرَ <verse eid="JER 41:17" /><verse number="18" style="v" pubnumber="18" sid="JER 41:18" />خَوفًا مِنَ البابِليِّينَ لأنَّ إسماعيلَ بنَ نَثَنيا قتَلَ جَدَليا بنَ أحيقامَ الّذي ولَّاهُ مَلِكُ بابِلَ على كُلِّ أرضِ يَهوذا.<verse eid="JER 41:18" /></para>
  <chapter eid="JER 41" />
  <chapter number="42" style="c" sid="JER 42" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 42:1" />وتقَدَّمَ جميعُ قادةِ الجُيوشِ ويوحانانُ بنُ قاريحَ وعزَرْيا بنُ هوشَعْيا وجميعُ الشَّعبِ، مِنْ صغيرِهِم إلى كبيرِهِم، <verse eid="JER 42:1" /><verse number="2" style="v" pubnumber="2" sid="JER 42:2" />وقالوا لإرميا النَّبيِّ: ”نتَضَرَّعُ إليكَ أنْ تُصَلِّيَ إلى الرّبِّ إلَهِكَ لأجلِ مَنْ بَقيَ مِنَّا، وهُم قليلٌ مِنْ كثيرٍ، كما تَرانا عَيناكَ. <verse eid="JER 42:2" /><verse number="3" style="v" pubnumber="3" sid="JER 42:3" />فيخبِرُنا الرّبُّ إلهُكَ كيفَ نَسلُكُ وماذا نعمَلُ“. <verse eid="JER 42:3" /><verse number="4" style="v" pubnumber="4" sid="JER 42:4" />فقالَ لهُم إرميا النَّبيُّ: ”سَمِعْتُكُم وسأُصَلِّي إلى الرّبِّ إلهِكُم كما تَطلُبونَ وأُخبِرُكُم بِما يُجيبُكُمُ الرّبُّ، ولا أكتُمُ عنكُم شيئًا“. <verse eid="JER 42:4" /><verse number="5" style="v" pubnumber="5" sid="JER 42:5" />فقالوا لإرميا: ليَكُنِ الرّبُّ إلهُكَ شاهِدًا علَينا أنَّنا نَعمَلُ بِكُلِّ الكلامِ الّذي يُرسِلُهُ إلينا. <verse eid="JER 42:5" /><verse number="6" style="v" pubnumber="6" sid="JER 42:6" />إنْ خَيرًا أو شَرًّا، لأنَّ السَّماعَ لِصوتِ الرّبِّ إلهِنا الّذي نَطلُبُ مِنكَ الصَّلاةَ إليهِ أفضَلُ لنا.<verse eid="JER 42:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="JER 42:7" />وبَعدَ عَشَرَةِ أيّامٍ كَلَّمَ الرّبُّ إرميا، <verse eid="JER 42:7" /><verse number="8" style="v" pubnumber="8" sid="JER 42:8" />فدَعا يوحانانَ بنَ قاريحَ وجميعَ قادةِ الجُيوشِ الّذينَ معَهُ وكُلَّ الشَّعبِ، مِنْ صغيرِهِم إلى كبيرِهِم، <verse eid="JER 42:8" /><verse number="9" style="v" pubnumber="9" sid="JER 42:9" />وقالَ لهُم: ”قالَ الرّبُّ إلهُ إِسرائيلَ الّذي طَلَبْتُم مِنِّي بتَضَرُّعاتِكُم: <verse eid="JER 42:9" /><verse number="10" style="v" pubnumber="10" sid="JER 42:10" />إنْ سَكَنتُم في هذِهِ الأرضِ، فأنا أبنيكُم ولا أنقُضُ، وأغرُسُكُم ولا أقلَعُ، لأنِّي نَدِمْتُ على الشَّرِّ الّذي أنزَلتُهُ بِكُم. <verse eid="JER 42:10" /><verse number="11" style="v" pubnumber="11" sid="JER 42:11" />لا تَخافوا مِنْ مَلِكِ بابِلَ، لا تخافوا مِنهُ يقولُ الرّبُّ. فأنا مَعكُم لأحفَظَكُم وأُنقِذَكُم مِنْ يَدِهِ. <verse eid="JER 42:11" /><verse number="12" style="v" pubnumber="12" sid="JER 42:12" />وأُنعِمَ علَيكُم فيَرحَمَكُم مَلِكُ بابِلَ ويُبقيكُم في أرضِكُم. <verse eid="JER 42:12" /><verse number="13" style="v" pubnumber="13" sid="JER 42:13" />وإنْ قُلتُم: لا نَسكُنُ في هذِهِ الأرضِ رافضينَ أنْ تَسمَعوا لِصوتِ الرّبِّ إلهِكُم، <verse eid="JER 42:13" /><verse number="14" style="v" pubnumber="14" sid="JER 42:14" />وقلتُم: لا بل نذهَبُ إلى أرضِ مِصْرَ، حيثُ لا نرَى حربًا ولا نَسمَعُ صوتَ بوقٍ، ولا نَجوعُ إلى خُبزٍ ونُقيمُ هُناكَ. <verse eid="JER 42:14" /><verse number="15" style="v" pubnumber="15" sid="JER 42:15" />فاَسمَعوا كلامَ الرّبِّ يا بَقيَّةَ شعبِ يَهوذا: إنْ ذَهَبتُم إلى مِصْرَ لتَتَغَرَّبوا فيها، <verse eid="JER 42:15" /><verse number="16" style="v" pubnumber="16" sid="JER 42:16" />فالسَّيفُ والجوعُ اللَّذانِ تَخافونَ مِنهُما يَلحَقانِكُم إلى هُناكَ وتَموتونَ. <verse eid="JER 42:16" /><verse number="17" style="v" pubnumber="17" sid="JER 42:17" />وكذلِكَ جميعُ الّذينَ ذَهَبوا إلى مِصْرَ وتَغرَّبوا هُناكَ يَموتونَ بِالسَّيفِ والجُوعِ والوَباءِ، ولا يَنجو مِنَ الشَّرِّ الّذي أجلِبُهُ علَيهِم. <verse eid="JER 42:17" /><verse number="18" style="v" pubnumber="18" sid="JER 42:18" />فكما اَنصَبَّ غضَبي وغَيظي على سُكَّانِ أُورُشليمَ فكذلِكَ يَنصَبُّ غَيظي علَيكُم إذا ذَهَبتُم إلى مِصْرَ، فتكونونَ شتيمَةً ومثارَ رُعبٍ ولَعنَةً وعارًا، ولا تَرَونَ هذا الموضعَ مِنْ بَعدُ، يقولُ الرّبُّ إلهُ إِسرائيلَ.<verse eid="JER 42:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="JER 42:19" />”وقالَ لكُمُ الرّبُّ يا بَقيَّةَ شعبِ يَهوذا: لا تَذهبوا إلى مِصْرَ، ها أنا أنذَرتُكُمُ الآنَ. <verse eid="JER 42:19" /><verse number="20" style="v" pubnumber="20" sid="JER 42:20" />فأنتُم تُخطِئونَ خَطَأً جسيمًا يُكَلِّفُكُم حياتَكُم إنْ ذَهَبتُم إلى هُناكَ. أمَا أرسلتُموني إلى الرّبِّ إلهِكُم قائِلينَ: صَلِّ إلى الرّبِّ إلَهِنا لأجلِنا، وكُلُّ ما يقولُهُ أخبِرْنا بهِ فنَعمَلَهُ؟ <verse eid="JER 42:20" /><verse number="21" style="v" pubnumber="21" sid="JER 42:21" />وأنا اليومَ أخبَرتكُم فلم تَسمَعوا لِشيءٍ مِمَّا أرسلَني بهِ إليكُم. <verse eid="JER 42:21" /><verse number="22" style="v" pubnumber="22" sid="JER 42:22" />فالآنَ اعلَموا يَقينًا أنَّكُم تموتونَ بِالسَّيفِ والجُوعِ والوباءِ في المَوضعِ الّذي أرَدْتُم أنْ تَذهبوا إليهِ لِتتَغَرَّبوا فيهِ“.<verse eid="JER 42:22" /></para>
  <chapter eid="JER 42" />
  <chapter number="43" style="c" sid="JER 43" />
  <para style="s1">إرميا في مصر</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 43:1" />ولمَّا فرَغَ إرميا مِنْ مُخاطبةِ الشَّعبِ بِكُلِّ هذا الكلامِ الّذي أرسلَهُ إليهِم بهِ الرّبُّ إلهُهُم. <verse eid="JER 43:1" /><verse number="2" style="v" pubnumber="2" sid="JER 43:2" />قالَ لَه عزَرْيا بنُ هوشَعْيا ويوحانانُ بنُ قاريحَ وجميعُ الرِّجالِ بِوقاحَةٍ: ”أنتَ تَكذِبُ. لم يُرسِلْكَ الرّبُّ إلهُنا لِتقولَ لنا: لا تَذهَبوا إلى مِصْرَ لِتتَغَرَّبوا هُناكَ. <verse eid="JER 43:2" /><verse number="3" style="v" pubnumber="3" sid="JER 43:3" />لكِنَّ باروخَ بنَ نَيريَّا حَرَّضَكَ علَينا لِتُسْلِمَنا إلى أيدي البابِليِّينَ، فنُقتَلَ أو نُسبَى إلى بابِلَ“. <verse eid="JER 43:3" /><verse number="4" style="v" pubnumber="4" sid="JER 43:4" />ورفَضَ يوحانانُ بنُ قاريحَ وقادةُ الجيشِ وجميعُ الشَّعبِ أنْ يَسمَعوا لِصوتِ الرّبِّ فيُقيموا في أرضِ يَهوذا. <verse eid="JER 43:4" /><verse number="5" style="v" pubnumber="5" sid="JER 43:5" />وأخذَ يوحانانُ وقادةُ الجيشِ بَقيَّةَ شعبِ يَهوذا الّذينَ رَجَعوا مِنْ بَينِ الأمَمِ الّتي طُرِدوا إليها لِيُقيموا في أرضِ يَهوذا: <verse eid="JER 43:5" /><verse number="6" style="v" pubnumber="6" sid="JER 43:6" />الرِّجالُ والنِّساءُ والأطفالُ وبَناتُ المَلِكِ وسائِرُ الّذينَ تركَهُم نَبوزَرادانُ رئيسُ الشُّرطَةِ في عِهْدَةِ جَدَليا بنِ أحيقامَ بنِ شافانَ وإرميا النَّبيِّ وباروخَ بنِ نَيريَّا. <verse eid="JER 43:6" /><verse number="7" style="v" pubnumber="7" sid="JER 43:7" />وذَهَبوا إلى أرضِ مِصْرَ دُونَ أنْ يَسمَعوا لِصوتِ الرّبِّ، فوصلوا إلى مدينةِ تَحفَنحيسَ.<verse eid="JER 43:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="JER 43:8" />وقالَ الرّبُّ لإرميا في تَحفَنحيسَ: <verse eid="JER 43:8" /><verse number="9" style="v" pubnumber="9" sid="JER 43:9" />”خُذْ بِيَدِكَ حِجارةً كبيرةً واَطمُرْها في كُومَةِ الطِّينِ الّتي عِندَ مَدخَلِ قصرِ فِرعَونَ في المدينةِ بِمَشهَدٍ مِنْ بَعضِ اليهودِ <verse eid="JER 43:9" /><verse number="10" style="v" pubnumber="10" sid="JER 43:10" />وقُلْ لهُم: قالَ الرّبُّ القديرُ إلهُ إِسرائيلَ: سأُرسِلُ وآخُذُ نَبوخذنَصَّرَ مَلِكَ بابِلَ عبدي، لِينْصِبَ عرشَهُ فَوقَ هذِهِ الحجارةِ الّتي طَمَرْتُها ويَنشُرَ قُبَّتَهُ المَلَكِيَّةَ فَوقَها. <verse eid="JER 43:10" /><verse number="11" style="v" pubnumber="11" sid="JER 43:11" />فيَجيءُ ويَضرِبُ أرضَ مِصْرَ، فيَصيرُ الّذينَ لِلموتِ إلى الموتِ، والّذينَ لِلسبي إلى السبي، والّذينَ لِلسَّيفِ إلى السَّيفِ. <verse eid="JER 43:11" /><verse number="12" style="v" pubnumber="12" sid="JER 43:12" />ويوقِدُ نارًا في بُيوتِ آلِهَةِ مِصْرَ، فيَحرِقُها ويَسبيها ويُنَظِّفُ أرضَ مِصْرَ كما يُنَظِّفُ الرَّاعي ثوبَهُ مِنَ القَملِ، ويَخرُجُ مِنْ هُناكَ بِسلامٍ. <verse eid="JER 43:12" /><verse number="13" style="v" pubnumber="13" sid="JER 43:13" />ويكْسِرُ أعمِدَةَ بَيتِ الشَّمسِ الّتي في أرضِ مِصْرَ ويَحرِقُ آلِهَتَها بِالنَّارِ“.<verse eid="JER 43:13" /></para>
  <chapter eid="JER 43" />
  <chapter number="44" style="c" sid="JER 44" />
  <para style="s1">كلمة الرّبّ إلى يهود مصر</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 44:1" />وقالَ الرّبُّ لإرميا: ”قُلْ لِجميعِ اليَهودِ السَّاكِنينَ في مَجدولَ وتَحفَنحيسَ ومَمفيسَ وفَتروسَ مِنْ أرضِ مِصْرَ: <verse eid="JER 44:1" /><verse number="2" style="v" pubnumber="2" sid="JER 44:2" />”قالَ الرّبُّ القديرُ إلهُ إِسرائيلَ: رأيتُم ما جَلَبْتُهُ مِنْ خرابٍ عظيمٍ على أُورُشليمَ وسائِرِ مُدُنِ يَهوذا، وها هيَ اليومَ خِربَةٌ لا ساكِنَ فيها. <verse eid="JER 44:2" /><verse number="3" style="v" pubnumber="3" sid="JER 44:3" />بِسبَبِ الشَّرِّ الّذي فَعَلهُ شعبُها لِيُغيظوني. فأحرقوا البَخورَ وعبَدوا آلِهَةً أُخرى لا يَعرِفونَها هُم ولا أنتُم ولا آباؤُكُم، <verse eid="JER 44:3" /><verse number="4" style="v" pubnumber="4" sid="JER 44:4" />وأرسَلْتُ إليكُم مِرارًا وتَكرارًا جميعَ عبيدي الأنبياءِ أقولُ لكُم: ”إِيَّاكُم وهذا الرِّجْسَ، فأنا أبغِضُهُ“. <verse eid="JER 44:4" /><verse number="5" style="v" pubnumber="5" sid="JER 44:5" />فما سَمِعتُم ولا أصغَيتُم ما تَراجَعتُم عَنْ شَرِّكُم وعَنْ إِحراقِ البَخورِ لآلِهَةٍ أُخرى. <verse eid="JER 44:5" /><verse number="6" style="v" pubnumber="6" sid="JER 44:6" />فاَنصَبَّ غَيظي وغضَبي واَشتَعلا في مُدُنِ يَهوذا وفي شوارِعِ أُورُشليمَ، فصارَت خَرابًا وقَفْرًا كما هيَ اليومَ. <verse eid="JER 44:6" /><verse number="7" style="v" pubnumber="7" sid="JER 44:7" />فالآنَ يقولُ الرّبُّ القديرُ إلهُ إِسرائيلَ: لِماذا تفعَلونَ هذا الشَّرَّ العظيمَ الّذي يَنقَلِبُ علَيكُم، فيَنقَرِضَ الرَّجُلُ والمرأةُ والصَّبيُّ والطِّفلُ مِنْ بَينِ شعبِ يَهوذا، حتّى لا تَبقى لكُم بَقيَّةٌ؟ <verse eid="JER 44:7" /><verse number="8" style="v" pubnumber="8" sid="JER 44:8" />لِماذا تُغيظوني بِأَعمالِكُم فتبخِّرونَ لآلِهَةٍ أُخرى في أرضِ مِصْرَ الّتي جِئْتُم إليها لِتَتَغَرَّبوا فيها وتَنقَرِضوا وتَصيروا لَعنَةً وعارًا في جميعِ أُمَمِ الأرضِ؟ <verse eid="JER 44:8" /><verse number="9" style="v" pubnumber="9" sid="JER 44:9" />أنَسيتُم شُرورَ آبائِكُم وشرورَ مُلوكِ يَهوذا ونِسائِهِم وشُرورَكُم وشُرورَ نِسائِكُم في أرضِ يَهوذا وفي شوارِعِ أُورُشليمَ؟ <verse eid="JER 44:9" /><verse number="10" style="v" pubnumber="10" sid="JER 44:10" />أإلى هذا اليومِ لا تَتَّضِعونَ فلا تَخافونَ ولا تَسلُكونَ في شَريعَتي وأحكامي الّتي أعلَنْتُها لكُم ولآبائِكُم؟<verse eid="JER 44:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JER 44:11" />”فلذَلِكَ يقولُ الرّبُّ القديرُ إلهُ إِسرائيلَ: سأُواجِهُكُم بِالشَّرِّ فأسحَقُ كُلَّ شعبِ يَهوذا <verse eid="JER 44:11" /><verse number="12" style="v" pubnumber="12" sid="JER 44:12" />وأمَّا البَقيَّةُ الّذينَ ذَهَبوا إلى أرضِ مِصْرَ لِيتَغَرَّبوا فيها فسَيَفْنَونَ جميعًا هُناكَ ويَسقُطونَ بِالسَّيفِ والجُوعِ ويموتونَ، مِنَ الصَّغيرِ إلى الكبيرِ، ويَصيرونَ شتيمةً ومَثارَ رُعْبٍ ولَعنةً وعارًا. <verse eid="JER 44:12" /><verse number="13" style="v" pubnumber="13" sid="JER 44:13" />وأُعاقِبُ اليَهودَ السَّاكِنينَ في مِصْرَ كما عاقَبْتُ أُورُشليمَ بِالسَّيفِ والجوعِ والوباءِ، <verse eid="JER 44:13" /><verse number="14" style="v" pubnumber="14" sid="JER 44:14" />فلا يَفلتُ ولا يَنجو أحدٌ مِنْ بَقيَّةِ يَهوذا الّذينَ ذَهَبوا إلى أرضِ مِصْرَ لِيَتَغَرَّبوا فيها ثُمَّ يَرجِعوا إلى أرضِ يَهوذا الّتي يَشتاقونَ إلى الرُّجوعِ إليها لِيَسكُنوا فيها، فهُم لا يرجِعونَ ما عدا قِلَّةً مِنَ الهارِبينَ“.<verse eid="JER 44:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="JER 44:15" />فقالَ لإرميا جميعُ الرِّجالِ العارِفينَ أنَّ نساءَهُم يَحرِقْنَ البَخورَ لآلِهَةٍ أُخرى، وجميعُ النِّساءِ الواقِفاتِ في مَحفَلٍ عظيمٍ، وجميعُ السَّاكِنينَ في فَتروسَ مِنْ أرضِ مِصْرَ: <verse eid="JER 44:15" /><verse number="16" style="v" pubnumber="16" sid="JER 44:16" />”لا نَسمَعُ لِهذا الكَلامِ الّذي كَلَّمْتَنا بِه بِاَسمِ الرّبِّ، <verse eid="JER 44:16" /><verse number="17" style="v" pubnumber="17" sid="JER 44:17" />بل نَعمَلُ بِكُلِّ كلامٍ يَخرُجُ مِنْ أفواهِنا، فنُبَخِّرُ لِمَلِكَةِ السَّماءِ ونَسكُبُ لها قرابينَ خمرٍ، كما عَمِلْنا نحنُ وآباؤُنا ومُلوكُنا ورُؤساؤُنا في مُدُنِ يَهوذا وشوارعِ أُورُشليمَ، فشَبِعْنا خُبزًا وكُنَّا بِخَيرٍ وما رأينا شَرًّا. <verse eid="JER 44:17" /><verse number="18" style="v" pubnumber="18" sid="JER 44:18" />ولكِن مُنذُ أهمَلْنا التَّبخيرَ لِمَلِكَةِ السَّماءِ وسَكْبَ الخمرِ لها صِرْنا مُحتاجينَ إلى كُلِّ شيءٍ وفَنينا بِالسَّيفِ والجُوعِ“. <verse eid="JER 44:18" /><verse number="19" style="v" pubnumber="19" sid="JER 44:19" />وقالَتِ النِّساءُ: ”نحنُ حينَ كُنَّا نُبَخِّرُ لِمَلِكَةِ السَّماءِ ونَسكُبُ لها قَرابينَ الخمرِ ونَصنَعُ الفَطائِرَ لِعِبادَتِها، أكانَ ذلِكَ دونَ رِضى رِجالِنا؟“<verse eid="JER 44:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="JER 44:20" />فقالَ إرميا لِجميعِ الشَّعبِ، رِجالًا ونِساءً: <verse eid="JER 44:20" /><verse number="21" style="v" pubnumber="21" sid="JER 44:21" />مِمَّنْ أجابوهُ بِهذا الكلامِ: ”ذلِكَ البخورُ الّذي أحرَقتُموهُ في مُدُنِ يَهوذا وفي شوارِعِ أُورُشليمَ أنتُم وآباؤُكُم ومُلوكُكُم ورُؤساؤُكم والشَّعبُ كُلُّهُ: أما ذكَرَهُ الرّبُّ وخَطَرَ في قلبِهِ؟ <verse eid="JER 44:21" /><verse number="22" style="v" pubnumber="22" sid="JER 44:22" />فكيفَ كانَ يَقدِرُ على احتِمالِ شَرِّ أعمالِكُم وما فعَلْتُم مِنَ الأرجاسِ حتّى صارَت أرضُكُم خَرابًا ومَثارَ رُعْبٍ ولَعنةٍ، لا ساكِنَ فيها. كما هيَ اليومَ. <verse eid="JER 44:22" /><verse number="23" style="v" pubnumber="23" sid="JER 44:23" />فلأنَّكُم بَخَّرتُم لآلِهَةٍ أُخرى وخطِئتُم إلى الرّبِّ وما سَمعتُم لِصوتِهِ ولا سَلَكتُم في شَريعَتِهِ وأحكامِهِ وفَرائِضِه حَلَّ بكُم هذا الشَّرُّ كُلُّهُ، كما في هذا اليومِ“.<verse eid="JER 44:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="JER 44:24" />ثُمَّ قالَ إرميا لِجميعِ الشَّعبِ، وخُصوصًا النِّساء: ”إِسمَعوا كلامَ الرّبِّ يا شعبَ يَهوذا الّذينَ في مِصْرَ: <verse eid="JER 44:24" /><verse number="25" style="v" pubnumber="25" sid="JER 44:25" />قالَ الرّبُّ القديرُ إلهُ إِسرائيلَ: أنتُم ونِساؤُكُم حَقَّقْتُم بِأعمالِكُم ما قُلتُموهُ بِكلامِكُم: نَحنُ نَفي بِنُذورِنا فنَحرِقُ البَخورَ لِمَلِكَةِ السَّماءِ ونسكُبُ لها قرابينَ الخمرِ. إذًا، قوموا بِوَفاءِ نُذورِكُم. <verse eid="JER 44:25" /><verse number="26" style="v" pubnumber="26" sid="JER 44:26" />ولكِنِ اَسمَعوا كَلِمَةَ الرّبِّ يا شعبَ يَهوذا السَّاكِنينَ في أرضِ مِصْرَ: أقسَمْتُ باَسمي العظيمِ أنا الرّبُّ أنْ لا يَحلِفَ باَسمي بَعدَ الآنَ أحدٌ مِن شعبِ يَهوذا، في جميعِ أرضِ مِصْرَ نقولُ: حيٌّ السَّيِّدُ الرّبُّ. <verse eid="JER 44:26" /><verse number="27" style="v" pubnumber="27" sid="JER 44:27" />ها أنا أتَرَقَّبُهُم لِلشَّرِّ لا لِلخَيرِ، فيَفنى رِجالُ يَهوذا الّذينَ في أرضِ مِصْرَ بِالسَّيفِ والجُوعِ حتّى آخِرِ رَجُلٍ. <verse eid="JER 44:27" /><verse number="28" style="v" pubnumber="28" sid="JER 44:28" />ولا يَنجو مِنَ السَّيفِ إلَّا قِلَّةٌ يَرجِعونَ مِنْ أرضِ مِصْرَ إلى أرضِ يَهوذا فيَعلَمُ بَقيَّةُ شعبِ يَهوذا الّذينَ جاؤوا إلى أرضِ مِصْرَ لِيَتَغرَّبوا فيها أيُّ كلامٍ يَصدُقُ، أكلامي أم كلامُهُم. <verse eid="JER 44:28" /><verse number="29" style="v" pubnumber="29" sid="JER 44:29" />وهذِهِ عَلامةٌ لكُم على أنِّي أعاقِبُكُم في هذا المَوضعِ، لِتَعلَموا أنَّ كَلامي علَيكُم لِلشَّرِّ هوَ الّذي يَصدُقُ. <verse eid="JER 44:29" /><verse number="30" style="v" pubnumber="30" sid="JER 44:30" />”سَأُسَلِّمُ فِرعَونَ خَفرَعَ مَلِكَ مِصْرَ إلى أيدي أعدائِهِ وأيدي الّذينَ يُريدونَ موتَهُ، كما سَلَّمْتُ صِدْقيَّا مَلِكَ يَهوذا إلى عَدُوِّهِ الّذي يَطلُبُ حياتَهُ“.<verse eid="JER 44:30" /></para>
  <chapter eid="JER 44" />
  <chapter number="45" style="c" sid="JER 45" />
  <para style="s1">وعد الرّبّ لباروخ</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 45:1" />وفي السَّنةِ الرَّابِعةِ لِيوياقيمَ بنِ يوشيَّا مَلِكِ يَهوذا، حينَ كتَبَ باروخُ بنُ نَيريَّا هذا الكلامَ في كتابٍ على لِسانِ إرميا النَّبيِّ، قالَ لَه إرميا: <verse eid="JER 45:1" /><verse number="2" style="v" pubnumber="2" sid="JER 45:2" />”قالَ الرّبُّ إلهُ إِسرائيلَ لكَ يا باروخُ، <verse eid="JER 45:2" /><verse number="3" style="v" pubnumber="3" sid="JER 45:3" />لأنَّكَ قُلتَ: ويلٌ لي لأنَّ الرّبَّ زادَني حُزنًا على ألَمي، ولأنِّي أذوبُ في أنيني ولا أجِدُ راحةً. <verse eid="JER 45:3" /><verse number="4" style="v" pubnumber="4" sid="JER 45:4" />قُلْ لَه: قالَ الرّبُّ: سَأَنقُضُ ما بَنَيتُهُ، وأقلَعُ ما غَرَستُهُ، في كُلِّ هذِهِ الأرضِ. <verse eid="JER 45:4" /><verse number="5" style="v" pubnumber="5" sid="JER 45:5" />فكَيفَ تَطلُبُ لِنَفسِكَ أُمورًا عظيمةً؟ لا تَطلُبْ. فسَأجلِبُ شَرًّا على كُلِّ بشَرٍ. أمَّا أنتَ فأُبقي على حياتِكَ في جميعِ المواضِعِ الّتي تَذهَبُ إليها“.<verse eid="JER 45:5" /></para>
  <chapter eid="JER 45" />
  <chapter number="46" style="c" sid="JER 46" />
  <para style="s1">هزيمة مصر في كركميش</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 46:1" />قالَ الرّبُّ لإرميا على الأمَمِ، <verse eid="JER 46:1" /><verse number="2" style="v" pubnumber="2" sid="JER 46:2" />على مِصْرَ، على جيشِ فِرعَونَ، نَخوَ مَلِكِ مِصْرَ، حينَ هزَمَهُ نبوخذنَصَّرُ مَلِكُ بابِلَ عِندَ نهرِ الفُراتِ في كَركَميشَ، في السَّنةِ الرَّابِعةِ لِعَهدِ يوياقيمَ بنِ يُوشيَّا مَلِكِ يَهوذا.<verse eid="JER 46:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="JER 46:3" />”هَيِّئوا الدِّرْعَ والتُّرْسَ واَزحَفوا لِلقِتالِ.<verse eid="JER 46:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="JER 46:4" />أَسرِجوا الخَيلَ واَركَبوا أيُّها الفُرسانُ.</para>
  <para style="p" vid="JER 46:4">إنتَصِبوا بِالخُوَذِ.</para>
  <para style="p" vid="JER 46:4">إِصقِلوا الرِّماحَ والبَسوا الدُّروعَ.<verse eid="JER 46:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="JER 46:5" />ما لي أراهُم خابوا واَرتَدُّوا إلى الوراءِ، واَنغَلَبَ أبطالُهُم واَنهَزَموا سَريعًا لا يَلتَفِتونَ؟</para>
  <para style="p" vid="JER 46:5">الرُّعْبُ مِنْ كُلِّ جانِبٍ يقولُ الرّبُّ.<verse eid="JER 46:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="JER 46:6" />الخفيفُ لا يَهرُبُ، والبَطَلُ لا يَنجو!</para>
  <para style="p" vid="JER 46:6">في الشِّمالِ عِندَ نهرِ الفُراتِ عَثَروا وسَقَطوا.<verse eid="JER 46:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="JER 46:7" />ما هذا الّذي كالنِّيلِ يَفيضُ</para>
  <para style="p" vid="JER 46:7">وكالأنهارِ تتَلاطَمُ أمواجُها؟<verse eid="JER 46:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="JER 46:8" />هيَ مِصْرُ كالنِّيلِ تَفيضُ،</para>
  <para style="p" vid="JER 46:8">وكالأنهارِ تتَلاطمُ أمواجُها</para>
  <para style="p" vid="JER 46:8">وتقولُ: أفيضُ وأُغَطِّي الأرضَ.</para>
  <para style="p" vid="JER 46:8">أُخَرِّبُ المُدُنَ والسَّاكِنينَ فيها.<verse eid="JER 46:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="JER 46:9" />تَقَدَّمي أيَّتُها الخَيلُ،</para>
  <para style="p" vid="JER 46:9">وثُوري أيَّتُها العَجَلاتُ!</para>
  <para style="p" vid="JER 46:9">لِيَبْرُزَ أبطالُ كُوشَ وفُوطَ،</para>
  <para style="p" vid="JER 46:9">أُولَئِكَ القابِضونَ على التُّروسِ</para>
  <para style="p" vid="JER 46:9">وأبطالُ لُودَ القابِضونَ على القِسيِّ“.<verse eid="JER 46:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="JER 46:10" />هذا اليومُ يومُ السَّيِّدِ القديرِ،</para>
  <para style="p" vid="JER 46:10">يومُ اَنتقامٍ مِنْ أعدائِهِ.</para>
  <para style="p" vid="JER 46:10">فيَأكُلُ السَّيفُ ويَشبَعُ</para>
  <para style="p" vid="JER 46:10">ويُروَى مِنْ دِمائِهِم،</para>
  <para style="p" vid="JER 46:10">لأنَّ لِلسَّيدِ الرّبِّ القديرِ</para>
  <para style="p" vid="JER 46:10">ذَبيحَةً في أرضِ الشِّمالِ</para>
  <para style="p" vid="JER 46:10">عِندَ نهرِ الفُراتِ.<verse eid="JER 46:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JER 46:11" />إصعَدي إلى جلعادَ وخُذي بَلَسانًا،</para>
  <para style="p" vid="JER 46:11">أيَّتُها العذراءُ ابنَةَ مِصْرَ،</para>
  <para style="p" vid="JER 46:11">باطِلًا تُكثِرينَ الأدويَةَ،</para>
  <para style="p" vid="JER 46:11">لأنَّ لا شِفاء لَكِ.<verse eid="JER 46:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="JER 46:12" />سَمِعَتِ الأمَمُ بِعارِكِ،</para>
  <para style="p" vid="JER 46:12">ومَلأَ صِياحُكِ الأرضَ،</para>
  <para style="p" vid="JER 46:12">لأنَّ الجبَّارَ عَثَرَ بِالجبَّارِ،</para>
  <para style="p" vid="JER 46:12">فسَقطَا كِلاهُما معًا.<verse eid="JER 46:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="JER 46:13" />وقالَ الرّبُّ لإرميا النَّبيِّ في قُدومِ نبوخذنَصَّرَ مَلِكِ بابِلَ لِيَضرِبَ أرضَ مِصْرَ.<verse eid="JER 46:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="JER 46:14" />”أخبِروا في مِصْرَ وأسمِعوا في مَجدولَ!</para>
  <para style="p" vid="JER 46:14">نادوا في مَمفيسَ وتَحفَنحيسَ</para>
  <para style="p" vid="JER 46:14">قولوا: قِفوا وتَهيَّأُوا</para>
  <para style="p" vid="JER 46:14">فالسَّيفُ أكَلَ ما حَولَكُم<verse eid="JER 46:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="JER 46:15" />لِماذا هرَبَ إلهُكُم أفيسُ؟</para>
  <para style="p" vid="JER 46:15">لِماذا لم يَقِفْ عِجْلُكُم؟</para>
  <para style="p" vid="JER 46:15">لأنَّ الرّبَّ صَرَعَهُ.<verse eid="JER 46:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="JER 46:16" />رِجالُكُم سَقطوا واحدُهُم على الآخَرِ،</para>
  <para style="p" vid="JER 46:16">قالوا: قوموا نَرجِعُ إلى شعبِنا</para>
  <para style="p" vid="JER 46:16">إلى أرضِ ميلادِنا، مِنْ سَيفِ القاهِرِ.<verse eid="JER 46:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="JER 46:17" />سَمَّوا فِرعَونَ مَلِكَ مِصْرَ بِاَسمٍ جديدٍ:</para>
  <para style="p" vid="JER 46:17">العَجَّاجَ الّذي تَرَكَ الوقتَ يَفوتُهُ!<verse eid="JER 46:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="JER 46:18" />حَيٌّ أنا يقولُ الإلهُ</para>
  <para style="p" vid="JER 46:18">الرّبُّ القديرُ اَسمُهُ:</para>
  <para style="p" vid="JER 46:18">كجبَلِ تابورَ بينَ الجِبالِ</para>
  <para style="p" vid="JER 46:18">ومِثلَ الكَرمَلِ عِندَ البحرِ</para>
  <para style="p" vid="JER 46:18">يكونُ القادِمُ لِقتالِكُم.<verse eid="JER 46:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="JER 46:19" />تأَهَّبي لِلجَلاءِ يا اَبنَةَ مِصْرَ</para>
  <para style="p" vid="JER 46:19">لأنَّ مَمفيسَ تَصيرُ خَرابًا</para>
  <para style="p" vid="JER 46:19">وتَبقى قَفْرًا بِغَيرِ ساكِنٍ.<verse eid="JER 46:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="JER 46:20" />مِصْرُ عِجْلةٌ بارِعَةُ الجَمالِ</para>
  <para style="p" vid="JER 46:20">تُباغِتُها ذُبابَةٌ مِنَ الشِّمالِ.<verse eid="JER 46:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="JER 46:21" />حتّى المُرتَزِقَةُ في وسَطِها</para>
  <para style="p" vid="JER 46:21">رِجالٌ كالعُجولِ المُسَمَّنَةِ،</para>
  <para style="p" vid="JER 46:21">لكِنَّهُم يَرتَدُّونَ ويَهربونَ جميعًا،</para>
  <para style="p" vid="JER 46:21">ولا يَقِفونَ لأنَّ نكبَتَهُم حلَّتْ بِهِم.</para>
  <para style="p" vid="JER 46:21">وحَلَّ بِهِم وقتُ عِقابِهِم.<verse eid="JER 46:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="JER 46:22" />صوتُ مِصْرَ كالحَيَّةِ وهيَ تَسري</para>
  <para style="p" vid="JER 46:22">إنَّ أعداءَها زاحِفونَ بِجيشِهِم.</para>
  <para style="p" vid="JER 46:22">جاؤُوا إليها بِفؤوسٍ</para>
  <para style="p" vid="JER 46:22">كأنَّهُم يُحطِّبونَ الأشجارَ.<verse eid="JER 46:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="JER 46:23" />سيَقطَعونَ غابَها،</para>
  <para style="p" vid="JER 46:23">وإنْ كانَ لا يُحصَى،</para>
  <para style="p" vid="JER 46:23">لأنَّهُم أكثرُ مِنَ الجَرادِ</para>
  <para style="p" vid="JER 46:23">حتّى لا عدَدَ لهُم.<verse eid="JER 46:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="JER 46:24" />سَتَخزَينَ يا بِنتَ مِصْرَ</para>
  <para style="p" vid="JER 46:24">وتُسَلَّمينَ إلى شعبٍ مِنَ الشِّمالِ“.<verse eid="JER 46:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="JER 46:25" />وقالَ الرّبُّ القديرُ إلهُ إِسرائيلَ: ”سأُعاقِبُ أمونَ إلهَ ثيبَةَ وفِرعَونَ وآلِهَةَ مِصْرَ ومُلوكَها، وآخُذُ فِرعَونَ والمُتَوَكِّلينَ علَيهِ. <verse eid="JER 46:25" /><verse number="26" style="v" pubnumber="26" sid="JER 46:26" />وأُسلِمُهُم إلى أيدي الّذينَ يَطلُبونَ حياتَهُم، إلى يَدِ نبوخذنَصَّرَ وأيدي عبيدِهِ. وبَعدَ ذلِكَ يعودُ الهُدوءُ إلى مِصْرَ كما كانَ مِنْ قَبلُ، يقولُ الرّبُّ.<verse eid="JER 46:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="JER 46:27" />”فلا تَخَفْ يا يَعقوبُ عبدي.</para>
  <para style="p" vid="JER 46:27">يا إِسرائيلُ لا تَرتَعِبْ مِنْ شيءٍ</para>
  <para style="p" vid="JER 46:27">فأنا أُخلِّصُكَ مِنَ الغُربَةِ،</para>
  <para style="p" vid="JER 46:27">أُخَلِّصُ ذُرِّيَّتَكَ مِنْ أرضِ سَبْيهِم،</para>
  <para style="p" vid="JER 46:27">فيَرجِعونَ ويَستَقِرُّونَ في أمانٍ</para>
  <para style="p" vid="JER 46:27">ويَطمَئِنُّونَ ولا يُرعِبُهُم أحدٌ.<verse eid="JER 46:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="JER 46:28" />لا تَخَفْ يا يَعقوبُ عبدي،</para>
  <para style="p" vid="JER 46:28">لأنِّي معَكَ يَقولُ الرّبُّ.</para>
  <para style="p" vid="JER 46:28">سأُفني جميعَ الأمَمِ،</para>
  <para style="p" vid="JER 46:28">وهيَ الّتي طَرَدْتُكَ إليها.</para>
  <para style="p" vid="JER 46:28">أمَّا أنتَ فلن أفنيَكَ!</para>
  <para style="p" vid="JER 46:28">بل أُؤدِبُّكَ بِالعَدلِ ولا أُبرِئُكَ“.<verse eid="JER 46:28" /></para>
  <chapter eid="JER 46" />
  <chapter number="47" style="c" sid="JER 47" />
  <para style="s1">كلمة الرّبّ على الفلسطيّين</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 47:1" />قالَ الرّبُّ لإرميا النَّبيِّ على الفِلِسطيِّينَ قَبلَ أنْ يُهاجِمَ فِرعَونُ غَزَّةَ: <verse eid="JER 47:1" /><verse number="2" style="v" pubnumber="2" sid="JER 47:2" />”تَفيضُ مياهٌ مِنَ الشِّمالِ وتَصيرُ سَيلًا جارِفًا، فتَغمُرُ الأرضَ وجميعَ ما فيها والمُدُنَ وسُكَّانَها. فيَصرُخُ البشَرُ ويُوَلوِلُ أهلُ الأرضِ <verse eid="JER 47:2" /><verse number="3" style="v" pubnumber="3" sid="JER 47:3" />مِنْ صوتِ وَقْعِ حوافِرِ الجيادِ واندِفاعِ المركَباتِ وصَريرِ الدَّواليبِ، فلا يَلتَفِتُ الآباءُ إلى البَنينَ مِنِ انهيارِ العَزائِمِ <verse eid="JER 47:3" /><verse number="4" style="v" pubnumber="4" sid="JER 47:4" />في ذلِكَ اليومِ الآتي يُدَمَّرُ جميعُ الفِلِسطيِّينَ، ويُقتَلَعُ أهالي صورَ وصيدونَ وجميعُ مَن بَقيَ مِنْ مُناصِريهِم، لأنَّ الرّبَّ يُفني بَقيَّةَ الفِلِسطيِّينَ الّذينَ نَزَحوا مِنْ جزيرةِ كفتورَ“.<verse eid="JER 47:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="JER 47:5" />حانَ لِسُكَّانِ غَزَّةَ أنْ يَحلِقوا رُؤوسَهُم حُزنًا ولأشقَلونَ أنْ تَسكُتَ. يا بَقيَّةَ سُكَّانِ واديهِم، إلى متى تَخدُشونَ أجسادَكُم أسفًا؟ <verse eid="JER 47:5" /><verse number="6" style="v" pubnumber="6" sid="JER 47:6" />يا سَيفَ الرّبِّ إلى متى لا تكُفّ؟ عُدْ إلى غِمدِكَ واَهدَأْ واَستَقِرَّ. <verse eid="JER 47:6" /><verse number="7" style="v" pubnumber="7" sid="JER 47:7" />ولكِنْ كَيفَ يكُفُّ والرّبُّ أمَرَهُ بِتَدميرِ أشقلونَ وساحِلِ البحرِ ودعاهُ إلى هناكَ.<verse eid="JER 47:7" /></para>
  <chapter eid="JER 47" />
  <chapter number="48" style="c" sid="JER 48" />
  <para style="s1">حكم الرّبّ على موآب</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 48:1" />قالَ الرّبُّ القديرُ إلهُ إِسرائيلَ على موآبَ:</para>
  <para style="p" vid="JER 48:1">”ويلٌ لِشعبِ نَبو.</para>
  <para style="p" vid="JER 48:1">مدينَتُهُم دُمِّرَت!</para>
  <para style="p" vid="JER 48:1">وقَريتايمُ اَنهَزَمَت وأُخِذَت،</para>
  <para style="p" vid="JER 48:1">وأُبيحَ الحِصْنُ وهُدِمَ.<verse eid="JER 48:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="JER 48:2" />فَخرُ مُوآبَ زالَ عَنِ الوجودِ.</para>
  <para style="p" vid="JER 48:2">في حَشبونَ فَكَّروا شَرًّا.</para>
  <para style="p" vid="JER 48:2">تَعالَوا نَقتَلِعُها مِنْ بَينِ الأمَمِ!</para>
  <para style="p" vid="JER 48:2">وأنتِ أيضًا يا مَدمينُ سَتَصمُتينَ،</para>
  <para style="p" vid="JER 48:2">والسَّيفُ يَسعى وراءَكِ،<verse eid="JER 48:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="JER 48:3" />صوتُ صُراخٍ مِنْ حُورونايمَ!</para>
  <para style="p" vid="JER 48:3">خرابٌ ودمارٌ عظيمٌ.<verse eid="JER 48:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="JER 48:4" />تحَطَّمَت مُوآبُ تَحطيمًا</para>
  <para style="p" vid="JER 48:4">وتعالَى صُراخُ صِغارِهِم،<verse eid="JER 48:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="JER 48:5" />على سَفْحِ لُوحِيتَ</para>
  <para style="p" vid="JER 48:5">يَصعَدونَ والدَّمعُ في عُيونِهِم.</para>
  <para style="p" vid="JER 48:5">وفي مُنحَدَرِ حورونايمَ</para>
  <para style="p" vid="JER 48:5">يُسمَعُ نِداءُ الخرابِ:<verse eid="JER 48:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="JER 48:6" />أُهرُبوا واَنجوا بِنُفوسِكُم!</para>
  <para style="p" vid="JER 48:6">كونوا كحمارِ الوَحْشِ في البرِّيَّةِ.<verse eid="JER 48:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="JER 48:7" />توَكَّلتِ على قُوَّتِكِ وكُنوزِكِ</para>
  <para style="p" vid="JER 48:7">فأنتِ أيضًا تُؤخَذينَ،</para>
  <para style="p" vid="JER 48:7">ويَخرُجُ الإلهُ كَموشُ إلى السَّبْي،</para>
  <para style="p" vid="JER 48:7">كَهَنَتُهُ ورُؤساؤُهُ جميعًا.<verse eid="JER 48:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="JER 48:8" />ويَجتاحُ المُدَمِّرُ كُلَّ المُدُنِ</para>
  <para style="p" vid="JER 48:8">ولا تَنجو مِنهُ مدينةٌ،</para>
  <para style="p" vid="JER 48:8">ويَهدِمُ الوادي ويُدَمِّرُ السَّهلَ</para>
  <para style="p" vid="JER 48:8">لأنَّ الرّبَّ تكَلَّمَ.<verse eid="JER 48:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="JER 48:9" />”أقيموا شاهِدةً على مُوآبَ</para>
  <para style="p" vid="JER 48:9">فما هيَ إلَّا خَرابٌ.</para>
  <para style="p" vid="JER 48:9">مُدُنُها تَصيرُ مُقفِرةً</para>
  <para style="p" vid="JER 48:9">لا ساكِنَ فيها“.<verse eid="JER 48:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="JER 48:10" />ملعونٌ مَنْ عَمِلَ عمَلَ الرّبِّ بِفُتورٍ، ومَلعونٌ مَنْ يَمنَعُ سَيفَهُ عَنِ الدَّمِ.<verse eid="JER 48:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JER 48:11" />مُوآبُ في أمانٍ مُنذُ فَجرِ أيّامِها. ما ذهَبَت إلى السَّبْي فبَقيَت كالخمرةِ في دَنِّها على ما رسَبَ مِنها. لا أحدَ أفرَغَها مِنْ وِعاءٍ إلى وِعاءٍ فبَقيَ طَعمُها فيها وما تغَيَّرَت رائِحَتُها.<verse eid="JER 48:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="JER 48:12" />لذلِكَ ستَأتي أيّامٌ يقولُ الرّبُّ أُرسِلُ فيها إلى مُوآبَ مَنْ يُخضِعُها ويُفرِغُ أَوعيتَها ويَكسِرُ دِنانَها، <verse eid="JER 48:12" /><verse number="13" style="v" pubnumber="13" sid="JER 48:13" />فتَخجَلُ مُوآبُ مِنَ الإلهِ كَموشَ كما خَجِلَ بَيتُ إِسرائيلَ مِنْ إلَهِ بَيتِ إيلَ الّذي توكَّلوا علَيهِ.<verse eid="JER 48:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="JER 48:14" />كيفَ تقولونَ نحنُ جبابِرةٌ</para>
  <para style="p" vid="JER 48:14">ورجالٌ أَشدَّاءُ في القِتالِ؟<verse eid="JER 48:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="JER 48:15" />ومُوآبُ ومُدُنُها دَمَّرَها العَدُوُّ،</para>
  <para style="p" vid="JER 48:15">ونُخبَةُ شُبَّانِها نَزَلوا لِلذَّبحِ.</para>
  <para style="p" vid="JER 48:15">يقولُ المَلِكُ إلهُنا.</para>
  <para style="p" vid="JER 48:15">الرّبُّ القديرُ اَسمُهُ.<verse eid="JER 48:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="JER 48:16" />إقتَرَبَ هَلاكُ مُوآبَ</para>
  <para style="p" vid="JER 48:16">وأسرَعَتْ نَكبَتُها في المَجيءِ<verse eid="JER 48:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="JER 48:17" />اندُبوها أيُّها الّذينَ حَولَها</para>
  <para style="p" vid="JER 48:17">والّذينَ يَعرِفونَ اَسمَها قولوا:</para>
  <para style="p" vid="JER 48:17">كَيفَ انكَسَرَ صولَجانُ عِزِّها</para>
  <para style="p" vid="JER 48:17">وعصا سُلطانِها المَجيدِ!<verse eid="JER 48:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="JER 48:18" />أهبُطي مِنْ غِناكِ إلى الحِرمانِ</para>
  <para style="p" vid="JER 48:18">أيَّتُها السَّاكِنةُ في دِيبونَ</para>
  <para style="p" vid="JER 48:18">فمُدَمِّرُ مُوآبَ صَعِدَ إليكِ</para>
  <para style="p" vid="JER 48:18">وهَدمَ جميعَ حُصونِكِ.<verse eid="JER 48:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="JER 48:19" />قِفي في الطَّريقِ واَنتَظِري</para>
  <para style="p" vid="JER 48:19">أيَّتُها السَّاكِنةُ في عَروعيرَ.</para>
  <para style="p" vid="JER 48:19">إسألي الهارِبَ والنَّاجيَةَ،</para>
  <para style="p" vid="JER 48:19">قولي لهُما: ماذا جرى؟<verse eid="JER 48:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="JER 48:20" />إِنهَزَمَت مُوآبُ واَنكَسَرَت!</para>
  <para style="p" vid="JER 48:20">وَلْوِلوا واَصرُخوا جميعًا،</para>
  <para style="p" vid="JER 48:20">أخبِروا في ضِفافِ نهرِ أرنونَ</para>
  <para style="p" vid="JER 48:20">أنَّ مُوآب دُمِّرَت تَدميرًا.<verse eid="JER 48:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="JER 48:21" />وافى الحُكْمُ على مُدُنِ السَّهلِ، على حولونَ ويَهصَى ومَيفَعَةَ <verse eid="JER 48:21" /><verse number="22" style="v" pubnumber="22" sid="JER 48:22" />وعلى ديبونَ ونَبو وبَيتِ دَبلَتايمَ، <verse eid="JER 48:22" /><verse number="23" style="v" pubnumber="23" sid="JER 48:23" />وعلى قريَتايمَ وبَيتِ جامولَ وبَيتِ مَعونَ، <verse eid="JER 48:23" /><verse number="24" style="v" pubnumber="24" sid="JER 48:24" />وعلى قريوتَ وبُصرَةَ وجميعِ مُدُنِ أرضِ مُوآبَ البعيدةِ والقريبةِ. <verse eid="JER 48:24" /><verse number="25" style="v" pubnumber="25" sid="JER 48:25" />انقَطَعَ حَيْلُ مُوآبَ واَنكَسَرَت ذِراعُها يقولُ الرّبُّ.<verse eid="JER 48:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="JER 48:26" />أسكِروا مُوآبَ لأنَّها تعاظَمَت على الرّبِّ، فتَتَمَرَّغَ في قَيئِها وتكونَ هيَ أُضحوكَةً. <verse eid="JER 48:26" /><verse number="27" style="v" pubnumber="27" sid="JER 48:27" />أمَا كانَت إِسرائيلُ أُضحوكَةً عِندَكِ يا مُوآبُ؟ هل وَجَدْتِها بَينَ اللُّصوصِ حتّى تَهُزِّينَ رأسَكِ اَحتِقارًا كلَّما تحَدَّثتِ عَنها؟<verse eid="JER 48:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="JER 48:28" />أُتركوا المُدُنَ وأقيموا بَينَ الصُّخورِ</para>
  <para style="p" vid="JER 48:28">وكونوا يا سُكَّانَ مُوآبَ</para>
  <para style="p" vid="JER 48:28">كحَمامةٍ تُعَشِّشُ في أطرافِ فَمِ الهُوَّةِ<verse eid="JER 48:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="JER 48:29" />سَمِعْنا بِتَكَبُّرِ مُوآبَ،</para>
  <para style="p" vid="JER 48:29">كم كانَت مُوآبُ مُتَكَبِّرةً</para>
  <para style="p" vid="JER 48:29">سَمِعْنا باَستِعلائِها وكِبريائِها،</para>
  <para style="p" vid="JER 48:29">بعَجرَفَتِها وشُموخِ أنفِها.<verse eid="JER 48:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="JER 48:30" />أعرِفُ تَجَبُّرَ مُوآبَ،</para>
  <para style="p" vid="JER 48:30">يقولُ الرّبُّ القديرُ:</para>
  <para style="p" vid="JER 48:30">فباطِلٌ ما تُفاخِرُ بهِ</para>
  <para style="p" vid="JER 48:30">وباطِلٌ ما تَعمَلُ.<verse eid="JER 48:30" /></para>
  <para style="p">
    <verse number="31" style="v" pubnumber="31" sid="JER 48:31" />لذلِكَ أُوَلْوِلُ على مُوآبَ!</para>
  <para style="p" vid="JER 48:31">على مُوآبَ كُلِّها أصرُخُ،</para>
  <para style="p" vid="JER 48:31">وعلى رِجالِ قيرَ حارِسَ أنوحُ.<verse eid="JER 48:31" /></para>
  <para style="p">
    <verse number="32" style="v" pubnumber="32" sid="JER 48:32" />أبكي علَيكَ يا كَرْمَ سَبمَةَ</para>
  <para style="p" vid="JER 48:32">بُكائي على يَعزيرَ.</para>
  <para style="p" vid="JER 48:32">أغصانُكَ جازَتِ البحرَ</para>
  <para style="p" vid="JER 48:32">وبَلَغَت إلى يَعزيرَ</para>
  <para style="p" vid="JER 48:32">والآنَ على حِصادِكَ في الصَّيفِ</para>
  <para style="p" vid="JER 48:32">وعلى قِطافِكَ اَنقَضَّ المُدَمِّرُ<verse eid="JER 48:32" /></para>
  <para style="p">
    <verse number="33" style="v" pubnumber="33" sid="JER 48:33" />وزالَ الفرَحُ والطَّربُ</para>
  <para style="p" vid="JER 48:33">مِنْ أرضِ مُوآبَ الخَصيبةِ،</para>
  <para style="p" vid="JER 48:33">واَنقَطَعَتِ الخمرُ مِنَ المعاصِرِ،</para>
  <para style="p" vid="JER 48:33">فلا يَدوسُ دائِسٌ بِهُتافٍ،</para>
  <para style="p" vid="JER 48:33">بل يكونُ هَرَجٌ لا هُتافٌ.<verse eid="JER 48:33" /></para>
  <para style="p">
    <verse number="34" style="v" pubnumber="34" sid="JER 48:34" />مِنْ حَشبونَ والعالَةِ إلى ياهَصَ أطلَقوا أصواتَهُم. ومِنْ صُوغَرَ إلى حورونايمَ عجلةِ شليشيَةَ أطلَقوا أصواتَهُم. فمياهُ نِمْريمَ أيضًا نَضَبَت. <verse eid="JER 48:34" /><verse number="35" style="v" pubnumber="35" sid="JER 48:35" />سأسحَقُ مِنْ مُوآبَ كُلَّ مَنْ يُصعِدُ ذبيحةً ويَحرِقُ بخورًا لآلِهَتِهِ على المذابِحِ في المشارِفِ. <verse eid="JER 48:35" /><verse number="36" style="v" pubnumber="36" sid="JER 48:36" />لذلِكَ يَئِنُّ قلبي على مُوآبَ كالرَّبابِ، وينوحُ كالنَّايِ على قِيرَ حارِسَ لأنَّ ثَروَتَهُم الّتي جَمَعوها بادَت. <verse eid="JER 48:36" /><verse number="37" style="v" pubnumber="37" sid="JER 48:37" />كُلُّ رأسٍ أقرَعُ وكُلُّ لِحيةٍ محلوقَةٌ، وعلى كُلِّ الأيدي خُدوشٌ وعلى أوساطِهِم مُسوحٌ. <verse eid="JER 48:37" /><verse number="38" style="v" pubnumber="38" sid="JER 48:38" />على جميعِ مُوآبَ وساحاتِها أَندُبُ، لأنَّ الرّبَّ حَطَّمَ مُوآبَ كإناءٍ مُهمَلٍ. <verse eid="JER 48:38" /><verse number="39" style="v" pubnumber="39" sid="JER 48:39" />فوَلْوِلوا كيفَ اَنكَسَرَت مُوآبُ، كيفَ أدارَت ظَهرَها، فكانَت أُضحوكَةً ومَثارَ رُعبِ الشُّعوبِ حَولَها.<verse eid="JER 48:39" /></para>
  <para style="p">
    <verse number="40" style="v" pubnumber="40" sid="JER 48:40" />وقالَ الرّبُّ: ”سيَطيرُ العَدُوُّ كالنَّسرِ ويَنشُرُ جناحَيهِ على مُوآبَ. <verse eid="JER 48:40" /><verse number="41" style="v" pubnumber="41" sid="JER 48:41" />فتُؤخَذُ المُدُنُ وتُداهَمُ الحُصونُ، وتكونُ قُلوبُ جبابِرةِ مُوآبَ في ذلِكَ اليومِ كقلبِ اَمرأةٍ تُعاني أوجاعَ المَخاضِ. <verse eid="JER 48:41" /><verse number="42" style="v" pubnumber="42" sid="JER 48:42" />ويَزولُ شعبُ مُوآبَ مِنْ بَينِ الشُّعوبِ، لأنَّهُ تَعاظَمَ على الرّبِّ. <verse eid="JER 48:42" /><verse number="43" style="v" pubnumber="43" sid="JER 48:43" />ويكونُ الرُّعْبُ والحُفرَةُ والفَخُّ أمامَكَ يا ساكِنَ مُوآبَ. <verse eid="JER 48:43" /><verse number="44" style="v" pubnumber="44" sid="JER 48:44" />فالهارِبُ مِنَ الرُّعْبِ يَقَعُ في الحُفرَةِ، والصَّاعِدُ مِنَ الحُفرَةِ يُؤخَذُ بِالفَخِّ، لأنِّي أَجلِبُ ذلِكَ على مُوآبَ في سنَةِ عِقابِها، يقولُ الرّبُّ.<verse eid="JER 48:44" /></para>
  <para style="p">
    <verse number="45" style="v" pubnumber="45" sid="JER 48:45" />في ظِلِّ حَشبونَ يَقِفُ الهارِبونَ مَنهوكي القِوى، لأنَّ نارًا خرَجَت مِنْ حَشبونَ ولهيبًا مِنْ قصرِ سيحونَ المَلِكِ فأكَلَتْ سُفوحَ موآبَ وقِمَمَها المَلأى بِضَجيج العابِدينَ. <verse eid="JER 48:45" /><verse number="46" style="v" pubnumber="46" sid="JER 48:46" />ويلٌ لَكِ يا مُوآبُ، هَلَكْتَ يا شعبَ الإلهِ كَموشَ. بَنوكَ أُسِروا وبناتُكَ في السَّبْي. <verse eid="JER 48:46" /><verse number="47" style="v" pubnumber="47" sid="JER 48:47" />لَكِنِّي أُعيدُ أَمجادَ مُوآبَ في آخِرِ الأيّامِ يقولُ الرّبُّ“. إلى هُنا حكَمَ الرّبُّ على مُوآبَ.<verse eid="JER 48:47" /></para>
  <chapter eid="JER 48" />
  <chapter number="49" style="c" sid="JER 49" />
  <para style="s1">حكم الرّبّ على بني عمون</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 49:1" />هذا ما قالَ الرّبُّ على بَني عَمُّونَ: ”أمَا لِشعب إِسرائيلَ بَنونَ، أو لا وارِثَ لهُم؟ فما بالُ شعبِ الإلهِ مَلكومَ وَرِثَ أرضَ جادَ وسكَنَ في مُدُنِها <verse eid="JER 49:1" /><verse number="2" style="v" pubnumber="2" sid="JER 49:2" />لذلِكَ تأتي أيّامٌ، يقولُ الرّبُّ، أسمَعُ فيها هُتافَ القِتالِ في رَبَّةَ عاصِمةِ بَني عَمُّونَ، فتَصيرُ تَلًا مِنَ الأنقاضِ، وتُحرَقُ قُراها بِالنَّارِ، ويَسلُبُ بَنو إِسرائيلَ سَالِبيهِم، يقولُ الرّبُّ.<verse eid="JER 49:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="JER 49:3" />وَلْوِلي يا حَشبونُ لأنَّ عايَ دُمِّرَت. أصرُخنَ يا بَناتِ رَبَّةَ وتَحَزَّمْنَ بِالمُسوحِ واَندُبْنَ وطُفْنَ بَينَ الأسيجَةِ، لأنَّ الإلهَ مَلكومَ يَذهَبُ إلى السَّبْي، هوَ وكَهنَتُهُ ورُؤساؤُهُ جميعًا.<verse eid="JER 49:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="JER 49:4" />ما بالُكِ تَفتَخرينَ بالأوديَةِ، وواديكِ يَفيضُ دَمًا أيَّتُها الابنَةُ العاصيَةُ، المُتَوكِّلَةُ على كُنوزِها، القائِلَةُ: مَنْ يَهجُمُ عليَّ؟ <verse eid="JER 49:4" /><verse number="5" style="v" pubnumber="5" sid="JER 49:5" />سأَجلِبُ علَيكِ الرُّعْبَ مِنْ حَوالَيكِ يقولُ السَّيِّدُ الرّبُّ القديرُ، فيُطْرَدُ أَهلُكِ ويَهيمُ كُلُّ واحدٍ على وجهِهِ ولا أحدَ يَجمَعُ الشَّارِدينَ. <verse eid="JER 49:5" /><verse number="6" style="v" pubnumber="6" sid="JER 49:6" />وبَعدَ ذلِكَ أُعيدُ أمجادَ بَني عَمُّونَ يقولُ الرّبُّ“.<verse eid="JER 49:6" /></para>
  <para style="s1">حكم الرّبّ على أدوم</para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="JER 49:7" />وقالَ الرّبُّ القديرُ على أدومَ: ”أمَا مِنْ حِكمَةٍ بَعدُ في تيمانَ؟ هل نَفَدَ الفَهْمُ في بَنيها وزالت حِكمَتُهُم؟ <verse eid="JER 49:7" /><verse number="8" style="v" pubnumber="8" sid="JER 49:8" />أُهرُبوا. وَلُّوا. إختَبِئوا يا سُكَّانَ دَدانَ! سأجلِبُ النَّكبَةَ على الأدوميِّينَ بَني عيسو لأنَّ وقتَ عِقابِهِم حانَ. <verse eid="JER 49:8" /><verse number="9" style="v" pubnumber="9" sid="JER 49:9" />لو جاءَكِ القاطِفونَ يا أدومُ لكانوا تَركوا في الكَرْمِ بَقيَّةً، أوِ اللُّصوصُ ليلًا لكانوا قَنَعوا بِنَهْبِ ما يكفيهِم. <verse eid="JER 49:9" /><verse number="10" style="v" pubnumber="10" sid="JER 49:10" />أمَّا أنا فأُعرِّي بَني عيسو وأَكشِفُ خَفاياهُم فلا يَقدِرونَ أنْ يَختَبِئوا. وأُدَمِّرُهُم.هُم وذُرِّيَّتُهُم وأنسِباؤُهُم وجيرانُهُم، حتّى لا يَبقى مِنهُم أحدٌ. <verse eid="JER 49:10" /><verse number="11" style="v" pubnumber="11" sid="JER 49:11" />أُترُكْ أيتامَكَ يا أدومُ فأنا أحييهِم، ولتَتَوكَّلْ أرامِلُكَ عليَّ“.<verse eid="JER 49:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="JER 49:12" />وقالَ الرّبُّ: ”الّذينَ لا يَستَحِقُّونَ أنْ يَشرَبوا كأسَ العِقابِ شَرِبوها الآنَ، فلِماذا أُبَرِّئُكَ أنتَ يا أدومُ؟ لا أُبرِّئك، بل تَشرَبُها أنتَ أيضًا، <verse eid="JER 49:12" /><verse number="13" style="v" pubnumber="13" sid="JER 49:13" />لأنِّي بذاتي أقسَمْتُ، يقولُ الرّبُّ: تَصيرُ بُصرَةُ العاصِمةُ مَثارَ رُعْبٍ وعارًا وخَرابًا ولَعنَةً، وتَصيرُ جميعُ قُراها خرائِبَ أبديَّةً“.<verse eid="JER 49:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="JER 49:14" />سَمِعْتُ نَبَأً مِنَ الرّبِّ حَمَلَهُ سفيرٌ إلى الأمَمِ: إجتَمِعوا واَهجُموا على أدومَ واَنهَضوا لِلقِتالِ. <verse eid="JER 49:14" /><verse number="15" style="v" pubnumber="15" sid="JER 49:15" />سأجعَلُكِ صغيرةً في الأمَمِ، حقيرةً بَينَ البشَرِ. <verse eid="JER 49:15" /><verse number="16" style="v" pubnumber="16" sid="JER 49:16" />ضَلَّلَكِ بَطشُكِ وكِبرِياءُ قلبِكِ، أنتِ أيَّتُها السَّاكِنَةُ في شُقوقِ الصَّخرِ بِأعالي الجِبالِ، ومهما تُعَلِّينَ عِشَّكِ كَالنَّسرِ، فأنا أُوقِعُكِ مِنْ هُناكَ. <verse eid="JER 49:16" /><verse number="17" style="v" pubnumber="17" sid="JER 49:17" />وتكونينَ خرابًا، فكُلُّ مَنْ يَمُرُّ بِكِ يُدهَشُ ويَصفِرُ صفيرَ الهُزءِ على جميعِ نكَباتِكِ. <verse eid="JER 49:17" /><verse number="18" style="v" pubnumber="18" sid="JER 49:18" />وكما في سَدومَ وعَمورَةَ والمُدُنِ المُجاوِرَةِ بَعدَ دَمارِها لا يَسكُنُ فيكِ إنسانٌ ولا يتَغَرَّبُ بشَرٌ يقولُ الرّبُّ.<verse eid="JER 49:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="JER 49:19" />”ها أنا كأسَدٍ يَصعَدُ مِنْ غَورِ الأردُنِّ على مُرتَفَعِ قُطعانٍ خَصيبٍ انقَضَّ بَغتَةً وأطرُدُهُم مِنها وأُقيمُ علَيها الّذي أختارُهُ. فَمَن مِثلي؟ ومَنْ يُحاكِمُني؟ ومَنِ الرَّاعي الّذي يَقِفُ في وجهي؟ <verse eid="JER 49:19" /><verse number="20" style="v" pubnumber="20" sid="JER 49:20" />فاَسمَعوا ما نَوَيتُ بهِ أنا الرّبُّ على بَني أدومَ وما فكَّرْتُ بهِ على سُكَّانِ مدينةِ تيمانَ: حتّى صِغارُهُم يُجَرُّونَ جَرًّا ويَستَولي الرُّعْبُ على مساكنِهِم. <verse eid="JER 49:20" /><verse number="21" style="v" pubnumber="21" sid="JER 49:21" />مِنْ صوتِ سُقوطِهِم تتَزَلزَلُ الأرضُ، وصُراخُهُم يُسمَعُ في بَحرِ القَصَبِ. <verse eid="JER 49:21" /><verse number="22" style="v" pubnumber="22" sid="JER 49:22" />ها هوَ العَدُوُّ كنَسرٍ يَرتَفِعُ ويَطيرُ ويَنشُرُ جناحَيهِ على بُصرَةَ، فتَصيرُ قُلوبُ جبابِرةِ بَني أَدومَ في ذلِكَ اليومِ كقلبِ اَمرأةٍ تُعاني المَخاضَ“.<verse eid="JER 49:22" /></para>
  <para style="s1">حكم الرّبّ على دمشق</para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="JER 49:23" />وقالَ الرّبُّ على دِمشْقَ: ”تَخزَى حماةُ وأرفادُ لأنَّهُما سَمِعَتا نَبَأً فظيعًا، وتَذوبانِ مِنَ الرُّعْبِ وتَضطَرِبانِ كالبحرِ الّذي لا يُمكِنُ أنْ يَهدَأَ. <verse eid="JER 49:23" /><verse number="24" style="v" pubnumber="24" sid="JER 49:24" />تَخورُ قوى دِمشْقَ فتُولِّي هارِبَةً. يَدُبُّ فيها الذُّعْرُ ويَستَولي علَيها الغَمُّ والوجَعُ كاَمرَأةٍ في المَخاضِ. <verse eid="JER 49:24" /><verse number="25" style="v" pubnumber="25" sid="JER 49:25" />وَيحَها كيفَ تُهجَرُ تِلكَ المدينةُ المَرِحَةُ <verse eid="JER 49:25" /><verse number="26" style="v" pubnumber="26" sid="JER 49:26" />وكَيفَ يَسقُطُ شُبَّانُها في ساحاتِها ويَهلِكُ جُنودُها في ذلِكَ اليومِ. <verse eid="JER 49:26" /><verse number="27" style="v" pubnumber="27" sid="JER 49:27" />وأُشعِلُ نارًا في سُورِ دِمشْقَ فتَأْكُلُ قُصورَ بَنهَدَدَ مَلِكِها.<verse eid="JER 49:27" /></para>
  <para style="s1">الحكم على قبائل العرب</para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="JER 49:28" />وقالَ الرّبُّ على بَني قيدارَ ومَمالِكِ حاصورَ الّتي قاتَلَها نبوخذنَصَّرُ مَلِكُ بابِلَ: ”قوموا اَصعَدوا إلى بَني قيدارَ ودَمِّروا أبناءَ المَشرِقِ <verse eid="JER 49:28" /><verse number="29" style="v" pubnumber="29" sid="JER 49:29" />خُذوا خيامَهُم وغنَمَهُم وستائِرَهُم وجميعَ أدواتِهِم وجِمالَهُم، ونادوا علَيهِم بِالرُّعْبِ مِنْ كُلِّ جهةٍ.<verse eid="JER 49:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="JER 49:30" />أُهرُبوا سَريعًا واَختَبِئوا يا سُكَّانَ حاصورَ، لأنَّ نبوخذنَصَّرَ مَلِكَ بابِلَ نَوى علَيكُم شَرًّا ودَبَّرَ مكيدَةً.<verse eid="JER 49:30" /></para>
  <para style="p">
    <verse number="31" style="v" pubnumber="31" sid="JER 49:31" />قوموا اَصعَدوا إلى أُمَّةٍ مُطمَئِنَّةٍ ساكِنةٍ في أمانٍ، لا أبوابَ لها ولا أقفالَ وسُكَّانُها في عُزلَةٍ. <verse eid="JER 49:31" /><verse number="32" style="v" pubnumber="32" sid="JER 49:32" />فتُنهَبُ جِمالُها نَهبًا وتُسلَبُ مَواشيها الكثيرةُ. وأُبَدِّدُ معَ كُلِّ رِيحٍ أولَئِكَ المَقصوصي الشَّعرِ، وأُنزِلُ بهِمِ النَّكبَةَ مِنْ كُلِّ جِهَةٍ يقولُ الرّبُّ. <verse eid="JER 49:32" /><verse number="33" style="v" pubnumber="33" sid="JER 49:33" />فتَصيرُ حاصورُ مأوًى لِبناتِ آوى، قَفْرًا إلى الأبدِ، لا يَسكُنُ فيها إنسانٌ ولا يَتَغرَّبُ بشَرٌ“.<verse eid="JER 49:33" /></para>
  <para style="s1">على عيلام</para>
  <para style="p">
    <verse number="34" style="v" pubnumber="34" sid="JER 49:34" />وقالَ الرّبُّ لإرميا النَّبيِّ على عيلامَ، في بَدءِ عَهدِ صِدقيَّا مَلِكِ يَهوذا: <verse eid="JER 49:34" /><verse number="35" style="v" pubnumber="35" sid="JER 49:35" />”سأَكسِرُ قَوسَ عيلامَ، مَصدَرَ قُوَّتِها، <verse eid="JER 49:35" /><verse number="36" style="v" pubnumber="36" sid="JER 49:36" />وأجلِبُ علَيهِمِ الرِّياحَ الأربَعَ مِنْ أطرافِ السَّماءِ الأربعَةِ وأُبَدِّدُهُم معَ الرِّياحِ كُلِّها، ولا تَبقى أُمَّةٌ لا يَلجأُ إلَيها مُهَجَّروهُم. <verse eid="JER 49:36" /><verse number="37" style="v" pubnumber="37" sid="JER 49:37" />وأُنزِلُ بِسُكَّانِ عيلامَ الذُّعْرَ أمامَ أعدائِهِم وأمامَ الّذينَ يَطلُبونَ حياتَهُم، وأجلِبُ علَيهِمِ الشَّرَّ ونارَ غضَبي. وأتبَعُهُم بِالسَّيفِ حتّى أَفنيَهُم. <verse eid="JER 49:37" /><verse number="38" style="v" pubnumber="38" sid="JER 49:38" />وأجعَلُ عرشي في عيلامَ وأُهلِكُ مَلِكَها ورُؤساءَها، <verse eid="JER 49:38" /><verse number="39" style="v" pubnumber="39" sid="JER 49:39" />لكنِّي في الأيّامِ الآتيةِ أُعيدُ أمجادَها يقولُ الرّبُّ“.<verse eid="JER 49:39" /></para>
  <chapter eid="JER 49" />
  <chapter number="50" style="c" sid="JER 50" />
  <para style="s1">دمار بابل ورجوع بني إسرائيل</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 50:1" />وقالَ الرّبُّ لِبابِلَ وسُكَّانِها على لِسانِ إرميا النَّبيِّ:<verse eid="JER 50:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="JER 50:2" />”أخبِروا في الأمَمِ.</para>
  <para style="p" vid="JER 50:2">ونادوا واَرفَعوا الرَّايةَ.</para>
  <para style="p" vid="JER 50:2">وأعلِنوا، لا تكتُموا.</para>
  <para style="p" vid="JER 50:2">قولوا: أُخِذَت بابِلُ.</para>
  <para style="p" vid="JER 50:2">اَنهَزَمَ بيلُ واَنسَحَقَ مَردوخُ</para>
  <para style="p" vid="JER 50:2">اَنهَزَمَت أوثانُها واَنسَحَقَت أصنامُها!<verse eid="JER 50:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="JER 50:3" />فَمِنَ الشِّمالِ طَلَعَت علَيها أُمَّةٌ جعَلَت أرضَها مُقفِرَةً لا ساكِنَ فيها. هرَبَ مِنْها البشَرُ والبَهائِمُ ونَزَحوا جميعًا.<verse eid="JER 50:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="JER 50:4" />في ذلِكَ اليومِ، يقولُ الرّبُّ، يَرجِعُ بَنو إِسرائيلَ وبَنو يَهوذا معًا، وهُم يَسيرونَ ويَبكونَ ويَطلُبونَ الرّبَّ إلهَهُم. <verse eid="JER 50:4" /><verse number="5" style="v" pubnumber="5" sid="JER 50:5" />يسألونَ عَنِ الطَّريقِ إلى صِهيَونَ، ويَتَوَجَّهونَ مُقبِلينَ علَيها. يأتونَ وينضمُّونَ إلى الرّبِّ بِعَهدٍ أبديٍّ لا يُنْسى.<verse eid="JER 50:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="JER 50:6" />”كانَ شعبي خِرافًا ضالَّةً. أضَلَّهُم رُعاتُهُم وحادوا بِهِم إلى الجِبالِ، فساروا مِنْ تَلٍّ إلى رابيةٍ ونَسوا حَظيرَتَهُم. <verse eid="JER 50:6" /><verse number="7" style="v" pubnumber="7" sid="JER 50:7" />فَكُلُّ مَنْ صادَفَهُم افتَرَسَهُم، وأعداؤُهُم قالوا: لا لَومَ علَينا.</para>
  <para style="p" vid="JER 50:7">هُم خَطِئوا إلى الرّبِّ، مَوئِلِهِم الحَقِّ ورَجاءِ آبائِهِم.<verse eid="JER 50:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="JER 50:8" />أُهرُبوا مِنْ وسَطِ بابِلَ، ومِنْ أرضِ البابِليِّينَ اَخرُجوا. سيروا كالكِباشِ قُدَّامَ القطيعِ. <verse eid="JER 50:8" /><verse number="9" style="v" pubnumber="9" sid="JER 50:9" />ها أنا أُحَرِّضُ وأُصعِدُ على بابِلَ حَشْدًا مِنْ أُمَمٍ عظيمةٍ تَجيءُ مِنْ أرضِ الشِّمالِ. يَصطَفُّونَ علَيها ومِنْ هُناكَ تُؤخَذُ. هُم كصَيَّادٍ ماهِرٍ، سِهامُهُم لا تخطِئُ. <verse eid="JER 50:9" /><verse number="10" style="v" pubnumber="10" sid="JER 50:10" />فتَسلُبُ أرضَ البابِليِّينَ ويَشبَعُ سالِبوها.<verse eid="JER 50:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JER 50:11" />كم فَرِحْتُم وطَرِبْتُم يا ناهِبي شعبي، وقَفَزتُم كعِجْلَةٍ على العُشبِ أو صَهلْتُم كالخَيلِ. <verse eid="JER 50:11" /><verse number="12" style="v" pubnumber="12" sid="JER 50:12" />لكِنَّ أُمَّكُمُ الّتي ولَدَتْكُم تَخزى وتَخجَلُ فتكونُ الأخيرةَ بَينَ الأمَمِ وتَصيرُ بَرِّيَّةً قَفْرًا وأرضًا يَباسًا. <verse eid="JER 50:12" /><verse number="13" style="v" pubnumber="13" sid="JER 50:13" />ومِنْ غَيظِ الرّبِّ لا تُسكَنُ، بل تكونُ كُلُّها خَرابًا. فكُلُّ مَنْ يَمُرُّ ببابِلَ يُدهَشُ ويَصفِرُ هُزءًا على جميعِ نكباتِها.<verse eid="JER 50:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="JER 50:14" />إصطَفُّوا على بابِلَ مِنْ كُلِّ جانِبٍ يا رُماةَ السِّهامِ. إرموا علَيها. خَطِئَت إلى الرّبِّ فلا تُوَفِّروا السِّهامَ. <verse eid="JER 50:14" /><verse number="15" style="v" pubnumber="15" sid="JER 50:15" />إهتِفوا هُتافَ الحربِ حَولَها، فتَستَسلِمَ وتَنهارَ أُسُسُها وتَنهَدِمَ أسوارُها. لذلِكَ هوَ اَنتِقامُ الرّبِّ. فاَنتَقِموا مِنها، وكما فعَلَت بِالآخرينَ إفعَلوا بِها. <verse eid="JER 50:15" /><verse number="16" style="v" pubnumber="16" sid="JER 50:16" />أَبيدوا الزَّارِعَ مِنْ بابِلَ والحاصِدَ وقتَ الحصادِ، فيَهرُبَ كُلُّ واحِدٍ مِنْ وجهِ السَّيفِ ويَرجِعَ إلى شعبِهِ وأرضِهِ.<verse eid="JER 50:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="JER 50:17" />بَنو إِسرائيلَ غنَمٌ مُشَتَّتَةٌ طارَدَتْها الأسودُ. مَلِكُ أشُّورَ أوَّلُ مَنِ اَفتَرَسَهُم، ونبوخذنَصَّرُ مَلِكُ بابِلَ آخِرُ مَنْ سحَقَ عِظامَهُم. <verse eid="JER 50:17" /><verse number="18" style="v" pubnumber="18" sid="JER 50:18" />لذلِكَ يقولُ الرّبُّ القديرُ إلهُ إِسرائيلَ: سأُعاقِبُ مَلِكَ بابِلَ وأرضَهُ كما عاقَبْتُ مَلِكَ أشُّورَ <verse eid="JER 50:18" /><verse number="19" style="v" pubnumber="19" sid="JER 50:19" />وأُعيدُ بَني إِسرائيلَ إلى مَرعاها، فتَسرَحُ في الكَرمَلِ وباشانَ وتَشبَعُ في جبَلِ أفرايمَ وجلعادَ. <verse eid="JER 50:19" /><verse number="20" style="v" pubnumber="20" sid="JER 50:20" />وفي ذلِكَ اليومِ لا يكونُ إثْمٌ ولا خطيئةٌ في إِسرائيلَ ويَهوذا، لأنِّي أغفِرُ لِمَنْ أُبقيهِ يقولُ الرّبُّ.<verse eid="JER 50:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="JER 50:21" />إصعَدوا إلى أرضِ مراثايمَ وإلى سُكَّانِ فَقودَ. إتبَعوهُم واَقتُلوهُم واَفعَلوا كُلَّ ما أمَرتُكُم بهِ. <verse eid="JER 50:21" /><verse number="22" style="v" pubnumber="22" sid="JER 50:22" />صوتُ قِتالٍ في الأرضِ وخرابٌ عظيمٌ. <verse eid="JER 50:22" /><verse number="23" style="v" pubnumber="23" sid="JER 50:23" />كَيفَ اَنكَسَرَت وتحَطَّمَت بابِلُ، مِطرَقَةُ الأرضِ كُلِّها، وصارَت مَثارَ رُعْبِ الأُمَمِ. <verse eid="JER 50:23" /><verse number="24" style="v" pubnumber="24" sid="JER 50:24" />”نُصِبَ لَكِ يا بابِل فَخٌّ، فعَلِقْتِ وما شَعَرْتِ. إنفَضَحَ أمرُكِ واَنغَلَبتِ لأنَّكِ تَحَدَّيتِ الرّبَّ. <verse eid="JER 50:24" /><verse number="25" style="v" pubnumber="25" sid="JER 50:25" />فتَحَ الرّبُّ خَزائِنَ أسلِحَتِهِ وأخرَجَ آلاتِ غضَبِهِ، لأنَّ لَه مُهِمَّةً في أرضِ البابِليِّينَ.<verse eid="JER 50:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="JER 50:26" />إنقَضُّوا علَيها مِنْ كُلِّ جانِبٍ واَفتَحوا أهراءَها وكَوِّموا قَمحَها وأَبيدوها ولا تكُنْ لها بَقيَّةٌ. <verse eid="JER 50:26" /><verse number="27" style="v" pubnumber="27" sid="JER 50:27" />أفنوا جميعَ ثيرانِها وأنزِلوها لِلذَّبْحِ. ويلٌ لِسُكَّانِ بابِلَ! حانَ يومُ عِقابِها.<verse eid="JER 50:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="JER 50:28" />إسمَعوا صوتَ الهاربينَ النَّاجينَ مِنْ أرضِ بابِلَ ليُخبِروا في أُورُشليمَ أنَّ الرّبَّ إلهَنا اَنتَقَمَ لِهَيكلِهِ.<verse eid="JER 50:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="JER 50:29" />إستَدعوا إلى بابِلَ أصحابَ القِسيِّ، وليَنزِلْ علَيها رُماةُ السِّهامِ مِنْ كُلِّ جانِبٍ، ولا تَدَعوا أحدًا يَنجو، جازُوها بِحسَبِ أفعالِها وعامِلوها بِمِثلِ ما عامَلَتِ الآخرينَ، لأنَّها تجَبَّرَت على الرّبِّ قُدُّوسِ إِسرائيلَ.<verse eid="JER 50:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="JER 50:30" />لِذلِكَ يَسقُطُ شُبَّانُها في ساحاتِها ويَهلِكُ جميعُ رِجالِها المُحارِبينَ في ذلِكَ اليومِ يقولُ الرّبُّ.<verse eid="JER 50:30" /></para>
  <para style="p">
    <verse number="31" style="v" pubnumber="31" sid="JER 50:31" />”أنا عَدُوُّكَ أيُّها الباغي. جاءَ يومُ عِقابِكَ. <verse eid="JER 50:31" /><verse number="32" style="v" pubnumber="32" sid="JER 50:32" />سيَعثرُ الباغي ويَسقُطُ ولا أحدَ يُقيمُهُ، وأُشعِلُ نارًا في مُدُنِه فتَأكُلُ كُلَّ ما حَولَها“.<verse eid="JER 50:32" /></para>
  <para style="p">
    <verse number="33" style="v" pubnumber="33" sid="JER 50:33" />وقالَ الرّبُّ القديرُ: ”بَنو إِسرائيلَ وبَنو يَهوذا مَظلومونَ جميعًا، والّذينَ سَبَوهُم تَمَسَّكوا بِهِم ورَفَضوا أنْ يُطلِقوهُم. <verse eid="JER 50:33" /><verse number="34" style="v" pubnumber="34" sid="JER 50:34" />لكِنَّ فاديَهُم قويٌّ. الرّبُّ القديرُ اَسمُهُ. فهوَ يتَولَّى دَعواهُم لِيُريحَ الأرضَ ويُزعِجَ سُكَّانَ بابِلَ.<verse eid="JER 50:34" /></para>
  <para style="p">
    <verse number="35" style="v" pubnumber="35" sid="JER 50:35" />”السَّيفُ على البابِليِّينَ وكُلِّ مَنْ يَسكُنُ بابِلَ، وعلى رُؤسائِها وحُكَمائِها. <verse eid="JER 50:35" /><verse number="36" style="v" pubnumber="36" sid="JER 50:36" />السَّيفُ على عَرَّافيها فيَصيرونَ حَمْقى، وعلى أبطالِها فيَهلكونَ. <verse eid="JER 50:36" /><verse number="37" style="v" pubnumber="37" sid="JER 50:37" />السَّيفُ على خَيلِها ومَركَباتِها، وعلى جُنودِها المُرتزِقَةِ فيَصيرونَ كالنِّساءِ. السَّيفُ على كُنوزِها فتُنهَبُ. <verse eid="JER 50:37" /><verse number="38" style="v" pubnumber="38" sid="JER 50:38" />الحَرُّ على مياهِها فتَجِفُّ لأنَّها أرضُ مَنحوتاتٍ وهُم بِأصنامِهِم مُوَلُّونَ.<verse eid="JER 50:38" /></para>
  <para style="p">
    <verse number="39" style="v" pubnumber="39" sid="JER 50:39" />”لِذلِكَ تَسكُنُها وحوشُ القَفْرِ والثَّعالِبُ وتَأوي إليها بَناتُ النَّعامِ. لا يَسكُنُها إِنسانٌ بَعدَ اليومِ إلى الأبدِ ولا تُعمَرُ مدى الأجيالِ. <verse eid="JER 50:39" /><verse number="40" style="v" pubnumber="40" sid="JER 50:40" />يُخَرِّبُها اللهُ كما خرَّبَ سَدومَ وعَمورَةَ وجِوارَهُما، فلا يَسكُنُ فيها إنسانٌ ولا يتَغَرَّبُ بشَرٌ.<verse eid="JER 50:40" /></para>
  <para style="p">
    <verse number="41" style="v" pubnumber="41" sid="JER 50:41" />ها شعبٌ مُقبِلٌ مِنَ الشِّمالِ، وأُمَّةٌ عظيمةٌ ومُلوكٌ كثيرونَ يتأَهَّبونَ لِلقِتالِ مِنْ أقاصي الأرضِ. <verse eid="JER 50:41" /><verse number="42" style="v" pubnumber="42" sid="JER 50:42" />يَقبضونَ على القِسيِّ والرِّماحِ، قُساةٌ لا يَرحَمونَ وكالبحرِ صوتُهُم. يَركَبونَ خُيولًا مُصطَفَّةً كفارِسٍ واحدٍ لِمُقاتَلَتِكِ يا بابِلُ.<verse eid="JER 50:42" /></para>
  <para style="p">
    <verse number="43" style="v" pubnumber="43" sid="JER 50:43" />بلَغَ خبَرُهُم مَلِكَ بابِلَ فاَنهارَت عظَمَتُهُ واَستَولى علَيهِ غَمٌّ ووَجَعٌ كاَمَرَأةٍ تُعاني المَخاضَ. <verse eid="JER 50:43" /><verse number="44" style="v" pubnumber="44" sid="JER 50:44" />ها أنا كأسدٍ يَصعَدُ مِنْ غَورِ الأردُنِّ على حَظيرةِ غنَمٍ منيعةٍ وأنقَضُّ بَغْتَةً وأطرُدُهُم وأقيمُ علَيهِم مَنْ أختارُهُ. فمَنْ مِثلي؟ ومَنْ يُحاكِمُني؟ وأيُّ راعٍ يَقِفُ في وجهي؟ <verse eid="JER 50:44" /><verse number="45" style="v" pubnumber="45" sid="JER 50:45" />لِذلِكَ اَسمَعوا ما نَوَيتُهُ أنا الرّبُّ على بابِلَ وما دُبِّرَ على أرضِ البابِليِّينَ: سَيَجُرُّ العَدُوُّ صِغارَ القطيعِ جَرًّا وتَنهارُ حَظيرَتُهُم علَيهِم. <verse eid="JER 50:45" /><verse number="46" style="v" pubnumber="46" sid="JER 50:46" />ومِنَ النَّبَإ القائِلِ: أُخِذَت بابِلُ، تتَزَلزلُ الأرضُ ويُسمَعُ الصُّراخُ بَينَ الأممِ“.<verse eid="JER 50:46" /></para>
  <chapter eid="JER 50" />
  <chapter number="51" style="c" sid="JER 51" />
  <para style="s1">انتقام الرّبّ من بابل</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 51:1" />وقالَ الرّبُّ: ”سأُثيرُ على بابِلَ وسُكَّانِها رِيحًا مُهلِكَةً. <verse eid="JER 51:1" /><verse number="2" style="v" pubnumber="2" sid="JER 51:2" />وأُرسِلُ إلى بابِلَ غُرَباءَ، فيُذَرُّونَها كالتِّبنِ ويُخلونَ الأرضَ مِنْ ساكِنِيها ويُحاصِرونَها مِنْ كُلِّ جِهَةٍ في يومِ نكبَتِها. <verse eid="JER 51:2" /><verse number="3" style="v" pubnumber="3" sid="JER 51:3" />لا يَدَعونَ الرَّامي يَحني قَوسَهُ ولا الجُنديَ يَختالُ بِدِرعِهِ. لا يُشفِقونَ على شُبَّانِها، بل يَقضونَ على كُلِّ جيشِها. <verse eid="JER 51:3" /><verse number="4" style="v" pubnumber="4" sid="JER 51:4" />فيَسقُطُ القَتلى في أرضِ البابِليِّينَ والجَرحى في شوارِعِها. <verse eid="JER 51:4" /><verse number="5" style="v" pubnumber="5" sid="JER 51:5" />فإِسرائيلُ ويَهوذا لم تُحرَما مِنَ الرّبِّ القديرِ إلهِهِما، وإنِ اَمتَلأت أرضُهُما إثْمًا على قُدُّوسِ إِسرائيلَ“.<verse eid="JER 51:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="JER 51:6" />أُهرُبوا مِنْ وسَطِ بابِلَ، واَنجُوا كُلُّ واحدٍ بِنفْسِهِ، لا تَهلكوا بِخطيئَتِها، لأنَّ هذا وقتُ اَنتِقامٍ للرّبِّ، فهوَ يُعاقِبُها بِما تَستَحِقُّ.<verse eid="JER 51:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="JER 51:7" />بابِلُ كأسٌ مِنْ ذهَبٍ بِيَدِ الرّبِّ تُسكِرُ كُلَّ أُمَمِ الأرضِ. مِنْ خمرِها شَرِبَتِ الأمَمُ ففَقَدَت صَوابَها. <verse eid="JER 51:7" /><verse number="8" style="v" pubnumber="8" sid="JER 51:8" />بَغْتَةً سَقَطَت بابِلُ وتَحَطَّمَت. ولْوِلوا علَيها. خُذوا بَلْسمًا لِجُرحِها، لَعَلَّها تُشفى.<verse eid="JER 51:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="JER 51:9" />عالَجْنا بابِلَ فما شُفِيَت. دَعُوها ولنَذهَبْ كُلُّ واحدٍ إلى أرضِهِ فالحُكْمُ علَيها بلَغَ إلى السَّماواتِ واَرتَفَعَ إلى الغُيومِ“.<verse eid="JER 51:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="JER 51:10" />الرّبُّ أظهَرَ بَراءَتَنا، فَهَيَّا نُخبِرُ في صِهيَونَ بِعمَلِ الرّبِّ إلهِنا. <verse eid="JER 51:10" /><verse number="11" style="v" pubnumber="11" sid="JER 51:11" />سُنُّوا السِّهامَ واَملأوا الجِعابَ، فالرّبُّ أثارَ رُوحَ مَلِكِ ماداي لأنَّهُ نوى أنْ يُدَمِّرَ بابِلَ انتِقامًا ويَثأرَ لِخرابِ هيكَلِهِ.<verse eid="JER 51:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="JER 51:12" />على أَسوارِ بابِلَ اَرفَعوا الرَّايةَ. شَدِّدوا الحِراسةَ وأقيموا الرُّقباءَ. هَيِّئُوا الكَمينَ. فالرّبُّ نوى أنْ يفعَلَ ما قالَهُ على سُكَّانِ بابِلَ.<verse eid="JER 51:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="JER 51:13" />أيَّتُها السَّاكِنَةُ عِندَ المياهِ الغَزيرةِ! أيَّتُها الكثيرةُ الكُنوزِ! جاءَت آخِرَتُكِ واَنقَطَعَ خَيطُ حياتِكِ. <verse eid="JER 51:13" /><verse number="14" style="v" pubnumber="14" sid="JER 51:14" />بِذاتِهِ أقسَمَ الرّبُّ القديرُ: أملأُكِ رِجالًا كالجَرادِ، يَصيحونَ علَيكِ بِهُتافِ النَّصرِ.<verse eid="JER 51:14" /></para>
  <para style="s1">نشيد الحمد للرب</para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="JER 51:15" />الرّبُّ صنَعَ الأرضَ بِقُوَّتِهِ.</para>
  <para style="p" vid="JER 51:15">بِحِكْمَتِهِ ثَبَّتَ الكَونَ</para>
  <para style="p" vid="JER 51:15">وبَسطَ السَّماواتِ بِفِطنَتِهِ.<verse eid="JER 51:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="JER 51:16" />بِصوتِهِ يَجمَعُ مياهًا في السَّماءِ</para>
  <para style="p" vid="JER 51:16">ويُصعِدُ السَّحابَ مِنْ أقصى الأرضِ.</para>
  <para style="p" vid="JER 51:16">يُحْدِثُ البُروقَ لِلمَطَرِ</para>
  <para style="p" vid="JER 51:16">ويُخرِجُ الرِّيحَ مِنْ خَزائِنِه.<verse eid="JER 51:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="JER 51:17" />مَنْ يَعرفُ ذلِكَ يُحِسُّ بِالبَلادَةِ،</para>
  <para style="p" vid="JER 51:17">وكُلُّ صائِغٍ يَخزى بِتِمثالِهِ.</para>
  <para style="p" vid="JER 51:17">لأنَّهُ زُورٌ ولا رُوحَ فيهِ.<verse eid="JER 51:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="JER 51:18" />مَسبوكاتُهُ باطِلَةٌ وصنعَةٌ مُضحِكَةٌ،</para>
  <para style="p" vid="JER 51:18">ويومَ يَفتَقِدُها الرّبُّ تَبيدُ.<verse eid="JER 51:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="JER 51:19" />لكِنْ إلهُ يَعقوبَ غَيرُ ذلِكَ</para>
  <para style="p" vid="JER 51:19">لأنَّهُ صَوَّرَ الأكوانَ جميعًا.</para>
  <para style="p" vid="JER 51:19">واَختارَ إِسرائيلَ شعبًا لَه،</para>
  <para style="p" vid="JER 51:19">الرّبُّ القديرُ اَسمُهُ.<verse eid="JER 51:19" /></para>
  <para style="s1">مطرقة الرب</para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="JER 51:20" />”كُنتِ يا بابِلُ مِطرقَةً لي،</para>
  <para style="p" vid="JER 51:20">كُنتِ آلةَ حربٍ،</para>
  <para style="p" vid="JER 51:20">سَحَقْتُ بِكِ الأمَمَ</para>
  <para style="p" vid="JER 51:20">ودَمَّرتُ المَمالِكَ.<verse eid="JER 51:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="JER 51:21" />سَحَقتُ الفَرسَ والفارسَ</para>
  <para style="p" vid="JER 51:21">والمَركَبَةَ وراكِبَها معًا.<verse eid="JER 51:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="JER 51:22" />سَحَقتُ الرَّجلَ والمرأةَ</para>
  <para style="p" vid="JER 51:22">والشَّيخَ والصَّبيَّ.</para>
  <para style="p" vid="JER 51:22">سَحَقتُ الفتى والفتاةَ.<verse eid="JER 51:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="JER 51:23" />والرَّاعي وقَطيعَهُ جميعًا.</para>
  <para style="p" vid="JER 51:23">سَحَقتُ الفَلَّاحَ وفدَّانَهُ</para>
  <para style="p" vid="JER 51:23">وحُكَّامَ الأرضِ وَوُلاتَها.<verse eid="JER 51:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="JER 51:24" />لكنِّي سَأُريكُم كيفَ أُجازي بابِلَ وجميعَ سُكَّانِها على كُلِّ ما فعَلوهُ مِنَ الشَّرِّ بِصهيَونَ، يقولُ الرّبُّ.<verse eid="JER 51:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="JER 51:25" />أنا عَدوُّكِ يا بابِلُ، يا جبَلَ الدَّمارِ، يا مُدَمِّرَةَ العالَمِ يقولُ الرّبُّ. أَمُدُّ يَدي علَيكِ وأُدَحرِجُكِ مِنَ الصُّخورِ وأجعَلُكِ جبَلًا مُحتَرِقًا <verse eid="JER 51:25" /><verse number="26" style="v" pubnumber="26" sid="JER 51:26" />فلا يُؤخَذُ مِنهُ حجَرٌ لِلزَّاويَةِ ولا حجَرٌ لِلأساسِ، بل يكونُ خَرابًا إلى الأبدِ“.<verse eid="JER 51:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="JER 51:27" />إِرفَعوا الرَّايةَ في الأرضِ، واَنفُخوا في البوقِ في الأُمَمِ. هَيِّئوا على بابِلَ الأُمَمَ ونادوا علَيها ممالِكَ أراراطَ ومِنِّي وأشكَنازَ. وَلُّوا لِلهُجومِ علَيها قائِدًا وأخرِجوا علَيها الخيَلَ كالجرادِ الزَّاحِفِ. <verse eid="JER 51:27" /><verse number="28" style="v" pubnumber="28" sid="JER 51:28" />هَيِّئوا علَيها الأُمَمَ ونادوا مُلوكَ ماداي وحُكَّامَها وُولاتَها وجُيوشَ الأرضِ الّتي تَحتَ سُلطانِهِم، <verse eid="JER 51:28" /><verse number="29" style="v" pubnumber="29" sid="JER 51:29" />فتَتَزَلزلُ الأرضُ وتَرتَعِدُ، لأنَّ للرّبِّ قَصدَهُ، فيَجعَلُ أرضَ بابِلَ مُقفِرَةً لا ساكِنَ فيها.<verse eid="JER 51:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="JER 51:30" />يتَوَقَّفُ جبابِرةُ بابِلَ عَنِ القِتالِ ويَلجأونَ إلى الحُصونِ. عزَائِمُهُم تَخورُ ويَصيرونَ كالنِّساءِ. مَساكِنُ بابِلَ تَحتَرِقُ وأبوابُ المدينةِ. <verse eid="JER 51:30" /><verse number="31" style="v" pubnumber="31" sid="JER 51:31" />يَسعى ساعٍ لِلقاءِ ساعٍ، ومُخبِرٌ لِلقاءِ مُخبِرٍ، لِيقولَ لِلمَلِكِ إنَّ مَدينتَهُ أُخِذَت عَنْ آخِرِها، <verse eid="JER 51:31" /><verse number="32" style="v" pubnumber="32" sid="JER 51:32" />وإنَّ المَعابِرَ اَحتُلَّت، والقلاعَ أُحرِقَت بِالنَّارِ، والجيشَ اَستَولى علَيهِ الرُّعْبُ. <verse eid="JER 51:32" /><verse number="33" style="v" pubnumber="33" sid="JER 51:33" />أمَا قالَ الرّبُّ إلهُ إِسرائيلَ: صارَت بابِلُ كبيدرٍ حانَ دَرسُهُ، وبَعدَ قليلٍ يَجيءُ وقتُ جَمعِ حُبوبِهِ.<verse eid="JER 51:33" /></para>
  <para style="p">
    <verse number="34" style="v" pubnumber="34" sid="JER 51:34" />أكَلَني نبوخذنَصَّرُ مَلِكُ بابِلَ.</para>
  <para style="p" vid="JER 51:34">أفناني وجعَلَني إِناءً فارِغًا.</para>
  <para style="p" vid="JER 51:34">اَبتَلَعَني كالتِّنِّينِ.</para>
  <para style="p" vid="JER 51:34">مَلأَ جَوفَهُ مِنْ لَذائِذي</para>
  <para style="p" vid="JER 51:34">وطَرَحَ ما تَبقَّى بَعيدًا.<verse eid="JER 51:34" /></para>
  <para style="p">
    <verse number="35" style="v" pubnumber="35" sid="JER 51:35" />لِيَقَعْ على بابِلَ ظُلْمُها لي</para>
  <para style="p" vid="JER 51:35">وما حَلَّ بي مِنَ العذابِ،</para>
  <para style="p" vid="JER 51:35">تقولُ ساكِنةُ صِهيَونَ.</para>
  <para style="p" vid="JER 51:35">لِيَقَعْ دَمي الّذي سَفكُوهُ</para>
  <para style="p" vid="JER 51:35">على سُكَّانِ أرضِ بابِلَ،</para>
  <para style="p" vid="JER 51:35">تقولُ أُورُشليمُ.<verse eid="JER 51:35" /></para>
  <para style="p">
    <verse number="36" style="v" pubnumber="36" sid="JER 51:36" />وقالَ الرّبُّ: ”أُخاصِمُ معَكِ وأنتَقِمُ لَكِ، فأُجَفِّفُ نَهرَ بابِلَ وأُنَشِّفُ يَنابيعَها، <verse eid="JER 51:36" /><verse number="37" style="v" pubnumber="37" sid="JER 51:37" />وتَصيرُ بابِلُ رُجمًا ومأوى لِبناتِ آوى، ومَثارَ رُعْبٍ وصفيرَ هُزءٍ لا يَسكُنُها أحدٌ. <verse eid="JER 51:37" /><verse number="38" style="v" pubnumber="38" sid="JER 51:38" />وَيزأرُ البابِليُّونَ كالأشبالِ ويُصَوِّتونَ كَجِراءِ الأسودِ. <verse eid="JER 51:38" /><verse number="39" style="v" pubnumber="39" sid="JER 51:39" />أفَلا يَشبَعونَ؟ سأُهيِّئُ لهُم شرابًا وأُسكِرُهُم لِيَمرَحوا ثُمَّ يَناموا نَومًا أبديًّا، فلا يُفيقونَ. <verse eid="JER 51:39" /><verse number="40" style="v" pubnumber="40" sid="JER 51:40" />وأُنزِلُهُم كالخِرافِ والكِباشِ إلى الذَّبْحِ يقولُ الرّبُّ“.<verse eid="JER 51:40" /></para>
  <para style="s1">مصير بابل</para>
  <para style="p">
    <verse number="41" style="v" pubnumber="41" sid="JER 51:41" />”كَيفَ أُخِذَت بابِلُ وغُلِبَت فَخْرُ كُلِّ الأرضِ. كيفَ صارَت بابِلُ مَثارَ رُعْبٍ بَينَ الأمَمِ. <verse eid="JER 51:41" /><verse number="42" style="v" pubnumber="42" sid="JER 51:42" />طلَعَ البحرُ على بابِلَ فغَمَرَها بِكَثرةِ أمواجِهِ. <verse eid="JER 51:42" /><verse number="43" style="v" pubnumber="43" sid="JER 51:43" />صارَت مُدُنُها مُقفِرَةً وأرضًا يَباسًا لا يسكُنُ فيها إنسانٌ ولا يَمُرُّ بِها بشَرٌ.<verse eid="JER 51:43" /></para>
  <para style="p">
    <verse number="44" style="v" pubnumber="44" sid="JER 51:44" />أعاقِبُ الإلهَ بيلَ في بابِلَ، وأُخرِجُ مِنْ فَمِهِ ما اَبتَلَعَ، ولا تَتوافَدُ إليهِ الأمَمُ مِنْ بَعدُ، وسُورُ بابِلَ أيضًا يَسقُطُ. <verse eid="JER 51:44" /><verse number="45" style="v" pubnumber="45" sid="JER 51:45" />أُخرُجوا مِنْ وسَطِها يا شعبي، واَنجوا كُلُّ واحدٍ بِنفْسِهِ مِنْ نارِ غضَبِ الرّبِّ. <verse eid="JER 51:45" /><verse number="46" style="v" pubnumber="46" sid="JER 51:46" />ولا تَخُرْ عَزائِمُكُم فتَخافوا مِنَ الشَّائِعاتِ الّتي تُسمَعُ في أنحاءِ الأرضِ. فكُلُّ سنَةٍ تَنتَشِرُ شائِعةٌ عَنِ الظُّلمِ هُنا أو هُناكَ، وعَنِ الحربِ بَينَ هذا المَلِكِ أو ذاكَ. <verse eid="JER 51:46" /><verse number="47" style="v" pubnumber="47" sid="JER 51:47" />لِذلِكَ تَجيءُ أيّامٌ أتفَقَّدُ فيها أصنامَ بابِلَ فتَخرَبُ أرضُها وتَسقُطُ قَتلاها في وسَطِها. <verse eid="JER 51:47" /><verse number="48" style="v" pubnumber="48" sid="JER 51:48" />ويَهْتِفُ على بابِلَ كُلُّ ما في السَّماواتِ والأرضِ فرَحًا بِسُقوطِ بابِلَ في أَيدي المُدَمِّرينَ الّذينَ يأْتونَها مِنَ الشِّمالِ يقولُ الرّبُّ.<verse eid="JER 51:48" /></para>
  <para style="p">
    <verse number="49" style="v" pubnumber="49" sid="JER 51:49" />فكما أَسقَطَت بابِلُ قتلى إِسرائيلَ يُسقِطُ الرّبُّ قَتلَى بابِلَ في كُلِّ الأرضِ. <verse eid="JER 51:49" /><verse number="50" style="v" pubnumber="50" sid="JER 51:50" />أيُّها الّذينَ نجَوا مِنَ السَّيفِ اَذهَبوا، لا تَقِفوا. أُذكُروا الرّبَّ في الغُربَةِ ولتَخطُرْ أُورُشليمُ بِبالِكُم.<verse eid="JER 51:50" /></para>
  <para style="p">
    <verse number="51" style="v" pubnumber="51" sid="JER 51:51" />خَزينا لأنَّنا سَمِعْنا تَعييرًا، وغَطَّى الخَجَلُ وجُوهَنا لأنَّ الغُرباءَ دَخَلوا أقداسَ بَيتِ الرّبُّ.<verse eid="JER 51:51" /></para>
  <para style="p">
    <verse number="52" style="v" pubnumber="52" sid="JER 51:52" />”لِذلِكَ تَجِيءُ أيّامٌ يَقولُ الرّبُّ أتَفَقَّدُ فيها أصنامَ بابِلَ، وفي كُلِّ أرضِها يَئِنُّ الجَرحى. <verse eid="JER 51:52" /><verse number="53" style="v" pubnumber="53" sid="JER 51:53" />وإنِ اَرتَفَعَت بابِلُ إلى السَّماواتِ وبَنَت حُصونًا مَنيعةً هُناكَ، فَمِنْ عِندي يأتي علَيها المُدَمِّرونَ، هكذا يقولُ الرّبُّ.<verse eid="JER 51:53" /></para>
  <para style="p">
    <verse number="54" style="v" pubnumber="54" sid="JER 51:54" />صوتُ صُراخٍ في بابِلَ، صوتُ دَمارٍ عظيمٍ مِنْ أرضِ البابِليِّينَ. <verse eid="JER 51:54" /><verse number="55" style="v" pubnumber="55" sid="JER 51:55" />هوَ الرّبُّ يُدَمِّرُ بابِلَ ويُسكِتُ فيها الضَّجيجَ. لأمواجِها أنْ تَعُجَّ كالمياهِ الغزيرةِ ولأصواتِها أنْ تَنطَلِقَ بِدَوِيٍّ شديدٍ. <verse eid="JER 51:55" /><verse number="56" style="v" pubnumber="56" sid="JER 51:56" />المُدَمِّرُ يَزحَفُ على بابِلَ فجبابِرَتُها أُسِرُوا، وقِسيُّهُم كُسِرَت، لأنَّ الرّبَّ الإلهَ يُجازيها بِما تَستَحِقُّ. <verse eid="JER 51:56" /><verse number="57" style="v" pubnumber="57" sid="JER 51:57" />سَأُسكِرُ رُؤساءَها وحُكَماءَها وحُكَّامَها وَوُلاتَها وجَبابِرتَها، فيَنامونَ نَومًا أبديًّا ولا يُفيقونَ يقولُ المَلِكُ الرّبُّ القديرُ.<verse eid="JER 51:57" /></para>
  <para style="p">
    <verse number="58" style="v" pubnumber="58" sid="JER 51:58" />”أسوارُ بابِلَ العريضةُ تُدَكُّ دَكًّا، وأبوابُها الشَّامِخةُ تُحرَقُ بِالنَّارِ، فيَصيرُ تَعَبُ الشُّعوبِ إلى الباطِلِ وجَهدُ الأمَمِ إلى النَّارِ“. يقولُ الرّبُّ القديرُ.<verse eid="JER 51:58" /></para>
  <para style="s1">الكلام المكتوب على بابل</para>
  <para style="p">
    <verse number="59" style="v" pubnumber="59" sid="JER 51:59" />هذا، ما أوصى بِهِ إِرميا النَّبيُّ سَرايا بنَ نَيريَّا بنِ مَحْسيَّا، عِندَما ذهَبَ معَ صِدْقيَّا مَلِكِ يَهوذا إلى بابِلَ في السَّنةِ الرَّابِعةِ لِمُلكِهِ. <verse eid="JER 51:59" /><verse number="60" style="v" pubnumber="60" sid="JER 51:60" />كتَبَهُ إِرميا في كتابٍ واحدٍ يَحتوي جميعَ الكَلامِ على الشَّرِّ الّذي يَحِلُّ بِبابِلَ. <verse eid="JER 51:60" /><verse number="61" style="v" pubnumber="61" sid="JER 51:61" />وقالَ إِرميا لِسرايا: ”إذا وصَلْتَ إلى بابِلَ، فاَحرَصْ أنْ تَتلُوَهُ <verse eid="JER 51:61" /><verse number="62" style="v" pubnumber="62" sid="JER 51:62" />وتقولَ: أيُّها الرّبُّ، أنتَ تكَلَّمتَ على هذا المَوضِعِ أنْ تَسحَقَهُ، فلا يَسكُنُهُ إنسانٌ ولا بَهيمَةٌ، بل يكونُ خرائِبَ أبديَّةً. <verse eid="JER 51:62" /><verse number="63" style="v" pubnumber="63" sid="JER 51:63" />ومتى فرَغتَ مِنْ تلاوَةِ هذا الكتابِ، فاربُطْ بهِ حجَرًا وأَلْقِهِ في وسَطِ الفُراتِ، <verse eid="JER 51:63" /><verse number="64" style="v" pubnumber="64" sid="JER 51:64" />وقُلْ: كذلِكَ تَغرَقُ بابِلُ ولا تَقومُ مِنَ الشَّرِّ الّذي جَلبَهُ الرّبُّ علَيها“.</para>
  <para style="p" vid="JER 51:64">إلى هُنا كلامُ إِرميا.<verse eid="JER 51:64" /></para>
  <chapter eid="JER 51" />
  <chapter number="52" style="c" sid="JER 52" />
  <para style="s1">سقوط أورشليم</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JER 52:1" />كانَ صِدْقيَّا اَبنَ إحدى وعِشرينَ سنَةً حينَ ملَكَ، وملَكَ إحدى عَشْرَةَ سنَةً في أُورُشليمَ، واَسمُ أُمِّهِ حَميطَلُ بِنْتُ إرميا مِنْ لِبْنَةَ. <verse eid="JER 52:1" /><verse number="2" style="v" pubnumber="2" sid="JER 52:2" />وعَمِلَ الشَّرَّ في عينَي الرّبِّ مِثلَما عَمِلَ المَلِكُ يوياقيمُ. <verse eid="JER 52:2" /><verse number="3" style="v" pubnumber="3" sid="JER 52:3" />وما حدَثَ أثارَ غضَبَ الرّبِّ على سُكَّانِ أُورُشليمَ ويَهوذا أنْ نَفاهُمُ الرّبُّ مِنْ أمامِ وجهِهِ.</para>
  <para style="p" vid="JER 52:3">وتمَرَّدَ صِدْقيَّا على نبوخذنَصَّرَ مَلِكِ بابِلَ، <verse eid="JER 52:3" /><verse number="4" style="v" pubnumber="4" sid="JER 52:4" />وفي السَّنةِ التَّاسِعةِ مِنْ مُلْكِهِ، وفي اليومِ العاشِرِ مِنَ الشَّهرِ العاشِرِ زحَفَ نَبوخذنَصَّرُ معَ جميعِ جُيوشِهِ على أُورُشليمَ وحاصَرُوها وبَنَوا حَولَها المتاريسَ. <verse eid="JER 52:4" /><verse number="5" style="v" pubnumber="5" sid="JER 52:5" />فدَخَلَتِ المدينةُ تَحتَ الحِصارِ إلى السَّنةِ الحاديةَ عَشْرَةَ لِلملِكِ صِدقيَّا. <verse eid="JER 52:5" /><verse number="6" style="v" pubnumber="6" sid="JER 52:6" />وفي اليومِ التَّاسِعِ مِنَ الشَّهرِ الرَّابِعِ اَشتَدَّ الجُوعُ في المدينةِ ولم يكُنْ خُبزٌ لِلشَّعبِ، <verse eid="JER 52:6" /><verse number="7" style="v" pubnumber="7" sid="JER 52:7" />ففَتَحوا ثُغرَةً في سُورِ المدينةِ. وهربَ المَلِكُ صِدْقيَّا وجميعُ الجُنودِ ليلًا، مِنْ طريقِ البابِ الّذي بَينَ السُّورَينِ، بالقُربِ مِنْ بُستانِ المَلِكِ، والبابِليُّونَ مُحيطونَ بِالمدينةِ، وذهَبوا في طريقِ غَورِ الأردُنِّ. <verse eid="JER 52:7" /><verse number="8" style="v" pubnumber="8" sid="JER 52:8" />فتَبِعَ جيشُ البابِليِّينَ المَلِكَ حتّى لَحِقوا بهِ في سَهلِ أريحا، حيثُ تفَرَّقَ عَنهُ جميعُ جيشِهِ. <verse eid="JER 52:8" /><verse number="9" style="v" pubnumber="9" sid="JER 52:9" />فأخَذوا المَلِكَ وأصعَدوهُ إلى مَلِكِ بابِلَ في رَبلَةَ بِأرضِ حماةَ، فحكَمَ علَيهِ <verse eid="JER 52:9" /><verse number="10" style="v" pubnumber="10" sid="JER 52:10" />بِأنْ ذبَحَ اَبنَيهِ أمامَ عَينَيهِ وذبَحَ جميعَ رُؤساءِ يَهوذا في رَبْلَةَ، <verse eid="JER 52:10" /><verse number="11" style="v" pubnumber="11" sid="JER 52:11" />ثُمَّ فَقَأَ عَينَي صِدْقيَّا وقَيَّدَهُ بِسِلسِلَتَينِ مِنْ نُحاسٍ وجاءَ بهِ إلى بابِلَ وسَجَنهُ إلى يومِ موتِهِ.<verse eid="JER 52:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="JER 52:12" />وفي اليومِ العاشِرِ مِنَ الشَّهرِ الخامسِ، في السَّنةِ التَّاسعةَ عَشْرَةَ لِمُلْكِ نبوخذنَصَّرَ مَلِكِ بابِلَ، جاءَ نَبوزَرادانُ رئيسُ الشُّرطَةِ ووَزيرُ المَلِكِ إلى أُورُشليمَ. <verse eid="JER 52:12" /><verse number="13" style="v" pubnumber="13" sid="JER 52:13" />وأحرَقَ بَيتَ الرّبِّ وقصرَ المَلِكِ وجميعَ بيوتِ الأشرافِ في أُورُشليمَ. <verse eid="JER 52:13" /><verse number="14" style="v" pubnumber="14" sid="JER 52:14" />وهَدَمَ جُنودُهُ الّذينَ معَهُ كُلَّ أسوارِ أورُشليمَ المُحيطَةِ بِها، <verse eid="JER 52:14" /><verse number="15" style="v" pubnumber="15" sid="JER 52:15" />وسبى نَبوزَرادانُ سائِرَ الّذينَ بَقُوا في المدينةِ، والهارِبينَ اللَّاجِئينَ إلى بابِلَ، وسائِرَ المَهرَةِ مِنَ الصُّنَّاعِ. <verse eid="JER 52:15" /><verse number="16" style="v" pubnumber="16" sid="JER 52:16" />وتَركَ نَبوزَرادانُ مِنْ مَساكينِ الأرضِ كَرَّامينَ وفَلَّاحينَ. <verse eid="JER 52:16" /><verse number="17" style="v" pubnumber="17" sid="JER 52:17" />وحَطَّمَ البابِليُّونَ أعمِدَةَ النُّحاسِ والقَواعِدَ والحَوضَ الكبيرَ في بَيتِ الرّبِّ، وحمَلوا كُلَّ نُحاسِها إلى بابِلَ. <verse eid="JER 52:17" /><verse number="18" style="v" pubnumber="18" sid="JER 52:18" />وأخَذوا القُدورَ والرُّفوشَ والسَّكاكينَ والأوانيَ والصُّحونَ وجميعَ الأدَواتِ الّتي تُستَعمَلُ لِلعِبادَةِ في بَيتِ الرّبِّ. <verse eid="JER 52:18" /><verse number="19" style="v" pubnumber="19" sid="JER 52:19" />أمَّا الطُّسوتُ والمَجامِرُ والسَّكاكينُ والقُدورُ والمَناراتُ والصُّحونُ والأقداحُ وكُلُّ مَصنوعاتِ الذَّهَبِ والفِضَّةِ، فأخَذَها رئيسُ الشُّرطَةِ، <verse eid="JER 52:19" /><verse number="20" style="v" pubnumber="20" sid="JER 52:20" />وأخَذَ مَصنوعاتِ النُّحاسِ الّتي صنَعَها المَلِكُ سُليمانُ لِبيتِ الرّبِّ، وهيَ العَمودانِ والحَوضُ الكبيرُ وقَواعِدُهُ الاثنا عَشَرَ ثورًا وكانَت مِنَ الثِّقْلِ بِحَيثُ لا تُوزَنُ. <verse eid="JER 52:20" /><verse number="21" style="v" pubnumber="21" sid="JER 52:21" />وكانَ طُولُ كُلٍّ مِنَ العَمودينِ ثَمانيَ عَشْرَةَ ذِراعًا ومُحيطُهُ اَثنَتَي عَشْرَةَ ذِراعًا، وثُخْنُهُ أربَعَ أصابِعَ، وهوَ أجوَفُ <verse eid="JER 52:21" /><verse number="22" style="v" pubnumber="22" sid="JER 52:22" />وعلَيهِ تاجٌ مِنْ نُحاسٍ اَرتفاعُ التَّاجِ الواحدِ خَمْسُ أذرُعٍ، وعلى التَّاجِ حَبيكَةٌ ورُمَّانٌ مِنْ حَولِها، والكُلُّ مِنْ نُحاسٍ. وكذلِكَ كانَ العَمودُ الثَّاني والرُمَّاناتُ. <verse eid="JER 52:22" /><verse number="23" style="v" pubnumber="23" sid="JER 52:23" />وكانَتِ الرُّمَّاناتُ سِتًّا وتِسعينَ على الجانِبِ الواحدِ، ومجموعُ الرُّمَّانِ مِئَة على الحَبيكَةِ الواحدةِ مِنْ حَولِها.<verse eid="JER 52:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="JER 52:24" />وأخذَ رئيسُ الشُّرطَةِ سَرايا الكاهنَ الأوَّلَ وصَفَنْيا الكاهنَ الثَّاني وحُرَّاسَ أبوابِ بَيتِ الرّبِّ الثَّلاثَةَ. <verse eid="JER 52:24" /><verse number="25" style="v" pubnumber="25" sid="JER 52:25" />وأخذَ مِنَ المدينةِ الخَصيَّ الّذي كانَ قَيِّمًا على الجُنْدِ، وسبعةَ رِجالٍ مِنْ حاشيةِ المَلِكِ الّذينَ وُجِدوا في المدينةِ، وأمينَ سِرِّ قائدِ الجيشِ الّذي كانَ يَحفَظُ سِجِلَّ المُجَنَّدينَ مِنَ الشَّعبِ، وسِتِّينَ رَجُلًا مِنَ الأعيانِ وُجِدوا في المدينةِ، <verse eid="JER 52:25" /><verse number="26" style="v" pubnumber="26" sid="JER 52:26" />أخذَهُم نَبوزَرادانُ رئيسُ الشُّرطَةِ وساقَهُم إلى مَلِكِ بابِلَ في رَبْلَةَ، <verse eid="JER 52:26" /><verse number="27" style="v" pubnumber="27" sid="JER 52:27" />فضرَبَهُمُ المَلِكُ وقَتلَهُم هُناكَ في أرضِ حماةَ. وسبى سُكَّانَ يَهوذا مِنْ أرضِهِم. <verse eid="JER 52:27" /><verse number="28" style="v" pubnumber="28" sid="JER 52:28" />وكانَ عدَدُ الّذينَ سباهُم نبوخذنَصَّرُ في السَّنةِ السَّابعةِ لِمُلْكِهِ ثَلاثَةَ آلافٍ وثَلاثَةً وعِشرينَ مِنَ اليهودِ. <verse eid="JER 52:28" /><verse number="29" style="v" pubnumber="29" sid="JER 52:29" />وفي السَّنةِ الثَّامِنةَ عَشْرَةَ سبى مِنْ أُورُشليمَ ثَماني مِئَةٍ واَثنَينِ وثلاثينَ شخصًا. <verse eid="JER 52:29" /><verse number="30" style="v" pubnumber="30" sid="JER 52:30" />وفي السَّنةِ الثَّالِثةِ والعِشرينَ لِنبوخذنَصَّرَ سبى نَبوزَرادانُ رئيسُ الشُّرطَةِ سَبْعَ مِئةٍ وخَمسةً وأربَعينَ مِنَ اليهودِ. فكانَ مَجموعُ عدَدِ المَسبيِّينَ أربَعةَ آلافٍ وسِتَّ مِئةٍ.<verse eid="JER 52:30" /></para>
  <para style="p">
    <verse number="31" style="v" pubnumber="31" sid="JER 52:31" />وكانَ في السَّنةِ السَّابِعةِ والثَّلاثينَ لِسَبْي يوياكينَ مَلِكِ يَهوذا، في السَّابِعِ والعِشرينَ مِنَ الشَّهرِ الثَّاني عَشَرَ، أنَّ أويلَ مَرُودَخَ مَلِكَ بابِلَ عفا عَنْ يوياكينَ وأخرَجَهُ مِنَ السِّجنِ <verse eid="JER 52:31" /><verse number="32" style="v" pubnumber="32" sid="JER 52:32" />وكلَّمَهُ بِكلامٍ لَطيفٍ وجعَلَ عرشَهُ أعلى مِنْ عُروشِ المُلوكِ الّذينَ معَهُ في بابِلَ. <verse eid="JER 52:32" /><verse number="33" style="v" pubnumber="33" sid="JER 52:33" />وغَيَّرَ يوياكينُ ثيابَ سِجنِهِ وبَقيَ يتَناوَلُ الطَّعامَ على مائِدةِ المَلِكِ كُلَّ أيّامِ حياتِهِ. <verse eid="JER 52:33" /><verse number="34" style="v" pubnumber="34" sid="JER 52:34" />وكانَت لَه عَلاوَةٌ دائمةٌ تُعطى لَه مِنْ عِندِ المَلِكِ، وتَفي بِحاجةِ كُلِّ يومٍ في يومِهِ، إلى يومِ وفاتِهِ.<verse eid="JER 52:34" /></para>
  <chapter eid="JER 52" />
</usx>