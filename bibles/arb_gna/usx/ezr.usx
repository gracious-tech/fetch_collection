  <para style="toc3">عز</para>
  <para style="toc1">عزرا</para>
  <para style="toc2">عزرا</para>
  <para style="mt1">عزرا</para>
  <chapter number="1" style="c" sid="EZR 1" />
  <para style="s1">العودة من السبي</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="EZR 1:1" />في السَّنةِ الأُولى لِكُورُشَ مَلِكِ الفُرسِ شاءَ الرّبُّ أنْ يَتمَّ ما تكلَّمَ بهِ على لِسانِ إرميا، فأيقَظَ ضَميرَ كُورُشَ فأطلَقَ في مَملكَتِهِ كُلِّها نِداءً مكتوبًا جاءَ فيهِ: <verse eid="EZR 1:1" /><verse number="2" style="v" pubnumber="2" sid="EZR 1:2" />”هذا ما يقولُ كُورُشُ مَلِكُ الفُرسِ: أعطاني الرَّبُّ، إلهُ السَّماواتِ، جميعَ مَمالِكِ الأرضِ وأوصاني أنْ أبنيَ لَه هَيكلًا في أورُشليمَ الّتي بيَهوذا. <verse eid="EZR 1:2" /><verse number="3" style="v" pubnumber="3" sid="EZR 1:3" />فمَنْ كانَ مِنكُم مِنْ شعبِهِ، فليَذهَبْ إلى أورُشليمَ ويَبني هَيكلَ الرّبِّ إلهِ بَني إِسرائيلَ، وهوَ الإلهُ الّذي في أورُشليمَ، ولْيكُنِ اللهُ معَهُ. <verse eid="EZR 1:3" /><verse number="4" style="v" pubnumber="4" sid="EZR 1:4" />وكُلّ مَنْ بَقيَ مِنْ شعبِهِ في السَّبْي وكانَ بِحاجةٍ إلى مَعُونةٍ لِلعَودَةِ إلى أورُشليمَ، فَليُمِدَّهُ أهلُ المكانِ الّذي يُقيمُ فيهِ بالفِضَّةِ والذَّهبِ والمالِ والبَهائِمِ، فَضلًا عَمَّا يتَبرَّعونَ لهَيكَلِ اللهِ الّذي في أورُشليمَ“.<verse eid="EZR 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="EZR 1:5" />فاَستعَدَّ رُؤساءُ عَشائِرِ بَني يَهوذا وبنيامينَ، والكَهَنةُ واللَّاويُّونَ، معَ كُلِّ مَنْ أيقَظَ اللهُ ضَميرَهُ، ليَذهَبوا إلى أورُشليمَ لِبنَاءِ هَيكلِ الرّبِّ. <verse eid="EZR 1:5" /><verse number="6" style="v" pubnumber="6" sid="EZR 1:6" />وكُلُّ السَّاكِنينَ حَولهُم أمَدُّوهُم بآنيةٍ مِنَ الفِضَّةِ والذَّهبِ، وبالمالِ والبَهائِمِ وأشياءَ ثَمينَةٍ، وغَيرِ ذلِكَ مِمَّا تبَرَّعوا بهِ. <verse eid="EZR 1:6" /><verse number="7" style="v" pubnumber="7" sid="EZR 1:7" />وأخرَجَ المَلِكُ كُورُشُ آنيَةَ الهَيكلِ الّتي كان حمَلَها نَبوخَذنَصَّرُ مِنْ أورُشليمَ ووَضَعَها في بَيتِ آلهتِهِ. <verse eid="EZR 1:7" /><verse number="8" style="v" pubnumber="8" sid="EZR 1:8" />أخرَجَها كُورُشَ مَلِكُ الفُرسِ على يَدِ مِثْرَداتَ خازِنِهِ، وعَدَّها لِشيشبَصَّرَ حاكِمِ يَهوذا. <verse eid="EZR 1:8" /><verse number="9" style="v" pubnumber="9" sid="EZR 1:9" />وهذا عَدَدُها: ثلاثونَ طَسْتًا مِنَ الذَّهبِ، وألفُ طَسْتٍ مِنَ الفِضَّةِ، وتِسعَةٌ وعِشرونَ سِكِّينًا، وثلاثونَ كاسًا مِنَ الذَّهبِ. <verse eid="EZR 1:9" /><verse number="10" style="v" pubnumber="10" sid="EZR 1:10" />وأربعُ مئَةٍ وعَشْرُ طاساتٍ مِنَ الفِضَّةِ، وألفُ قِطْعَةٍ مِنْ آنيَةٍ أُخرَى. <verse eid="EZR 1:10" /><verse number="11" style="v" pubnumber="11" sid="EZR 1:11" />فكانَ جميعُ آنيةِ الذَّهبِ والفضَّةِ خمسَةَ آلافٍ وأربعَ مئَةٍ، حَمَلَها شيشبَصَّرُ عِندَما ذهَبَ معَ المَسْبيِّينَ مِنْ بابِلَ إلى أورُشليمَ.<verse eid="EZR 1:11" /></para>
  <chapter eid="EZR 1" />
  <chapter number="2" style="c" sid="EZR 2" />
  <para style="s1">الراجعون من سبي بابل</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="EZR 2:1" />وخرَجَ مُعظَمُ المَسْبيِّينَ في إقليمِ بابِلَ، مِمَّنْ سَباهُم نَبوخَذنَصَّرُ مَلِكُ بابِلَ، ورَجَعوا إلى أورُشليمَ ويَهوذا، كُلُّ واحدٍ إلى مدينتِهِ. <verse eid="EZR 2:1" /><verse number="2" style="v" pubnumber="2" sid="EZR 2:2" />جاؤوا معَ زَرُبَّابِلَ ويشوعَ ونَحَميا وسَرايَا ورَعَلايَا ومَرْدَخايَ وبِلْشانَ ومِسفارَ وبِغْوايَ وَرَحومَ وبِعْنَةَ وهذا عَدَدُهُم: <verse eid="EZR 2:2" /><verse number="3" style="v" pubnumber="3" sid="EZR 2:3" />بَنو فَرْعُوشَ ألفانِ ومئَةٌ واَثنانِ وسَبعونَ. <verse eid="EZR 2:3" /><verse number="4" style="v" pubnumber="4" sid="EZR 2:4" />وبَنو شَفَطْيا ثَلاثُ مئَةٍ واَثنانِ وسَبعُونَ. <verse eid="EZR 2:4" /><verse number="5" style="v" pubnumber="5" sid="EZR 2:5" />وبَنو آرَحَ سَبْعُ مئَةٍ وخَمسةٌ وسَبعونَ. <verse eid="EZR 2:5" /><verse number="6" style="v" pubnumber="6" sid="EZR 2:6" />وبَنو فَحَثَ مُوآبَ أو بَنو يشوعَ ويُوآبَ ألفانِ وثَماني مئَةٍ واَثنا عشَرَ. <verse eid="EZR 2:6" /><verse number="7" style="v" pubnumber="7" sid="EZR 2:7" />وبَنو عِيلامَ ألفٌ ومئتانِ وأربَعةٌ وخَمسونَ <verse eid="EZR 2:7" /><verse number="8" style="v" pubnumber="8" sid="EZR 2:8" />وبَنو زَتُّو تِسْعُ مئَةٍ وخَمسةٌ وأربَعونَ. <verse eid="EZR 2:8" /><verse number="9" style="v" pubnumber="9" sid="EZR 2:9" />وبَنو زكَّايَ سَبْعُ مئَةٍ وسِتُّونَ. <verse eid="EZR 2:9" /><verse number="10" style="v" pubnumber="10" sid="EZR 2:10" />وبَنو باني سِتُّ مئَةٍ واَثنانِ وأربَعونَ. <verse eid="EZR 2:10" /><verse number="11" style="v" pubnumber="11" sid="EZR 2:11" />وبَنو بابايَ سِتُّ مئَةٍ وثلاثةٌ وعِشرونَ. <verse eid="EZR 2:11" /><verse number="12" style="v" pubnumber="12" sid="EZR 2:12" />وبَنو عَزْجَدَ ألفٌ ومِئتانِ واَثنانِ وعِشرونَ. <verse eid="EZR 2:12" /><verse number="13" style="v" pubnumber="13" sid="EZR 2:13" />وبَنو أدُونيقامَ سِتُّمئَةٍ وستَّةٌ وستُّونَ. <verse eid="EZR 2:13" /><verse number="14" style="v" pubnumber="14" sid="EZR 2:14" />وبَنو بِغْوايَ ألفانِ وستَّةٌ وخمسونَ. <verse eid="EZR 2:14" /><verse number="15" style="v" pubnumber="15" sid="EZR 2:15" />وبَنو عادينَ أربَعُ مئَةٍ وأربَعةٌ وخَمسونَ. <verse eid="EZR 2:15" /><verse number="16" style="v" pubnumber="16" sid="EZR 2:16" />وبَنو آطيرَ أو حِزقيَّا ثمانيَةٌ وتِسعونَ <verse eid="EZR 2:16" /><verse number="17" style="v" pubnumber="17" sid="EZR 2:17" />وبَنو بيصايَ ثَلاثُ مئَةٍ وثلاثَةٌ وعِشرونَ. <verse eid="EZR 2:17" /><verse number="18" style="v" pubnumber="18" sid="EZR 2:18" />وبَنو يورَةَ مئَةٌ واَثنا عشَرَ <verse eid="EZR 2:18" /><verse number="19" style="v" pubnumber="19" sid="EZR 2:19" />وبَنو حَشومَ مِئتانِ وثلاثَةٌ وعِشرونَ. <verse eid="EZR 2:19" /><verse number="20" style="v" pubnumber="20" sid="EZR 2:20" />وبَنو جِبَّارَ خَمسةٌ وتِسعونَ. <verse eid="EZR 2:20" /><verse number="21" style="v" pubnumber="21" sid="EZR 2:21" />وبَنو بَيتَ لَحمَ مئَةٌ وثلاثَةٌ وعِشرونَ. <verse eid="EZR 2:21" /><verse number="22" style="v" pubnumber="22" sid="EZR 2:22" />ورِجالُ نَطُوفَةَ ستَّةٌ وخَمسونَ. <verse eid="EZR 2:22" /><verse number="23" style="v" pubnumber="23" sid="EZR 2:23" />ورِجالُ عناتُوتَ مئَةٌ وثمانيَةٌ وعِشرونَ.<verse eid="EZR 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="EZR 2:24" />وبَنو عَزمُوتَ اَثنانِ وأربَعونَ. <verse eid="EZR 2:24" /><verse number="25" style="v" pubnumber="25" sid="EZR 2:25" />وبَنو قَريَةِ عاريمَ وكَفيرَةَ وبَئيروت سَبْعُ مئَةٍ وثلاثَةٌ وأربعونَ. <verse eid="EZR 2:25" /><verse number="26" style="v" pubnumber="26" sid="EZR 2:26" />وبَنو الرَّامَةِ وجَبْعَ سِتُّ مئَةٍ وواحدٌ وعِشرونَ <verse eid="EZR 2:26" /><verse number="27" style="v" pubnumber="27" sid="EZR 2:27" />ورِجالُ مِخْماسَ مئَةٌ واَثنانِ وعِشرونَ. <verse eid="EZR 2:27" /><verse number="28" style="v" pubnumber="28" sid="EZR 2:28" />ورِجالُ بَيتَ إيلَ وعايَ مِئتانِ وثلاثَةٌ وعِشرونَ. <verse eid="EZR 2:28" /><verse number="29" style="v" pubnumber="29" sid="EZR 2:29" />وبَنو نَبو اَثنانِ وخَمسونَ. <verse eid="EZR 2:29" /><verse number="30" style="v" pubnumber="30" sid="EZR 2:30" />وبَنو مَغْبيشَ مئَةٌ وستَّةٌ وخَمسونَ. <verse eid="EZR 2:30" /><verse number="31" style="v" pubnumber="31" sid="EZR 2:31" />وبَنو عيلامَ الآخرِ ألفٌ ومِئتانِ وأربَعةٌ وخَمسونَ <verse eid="EZR 2:31" /><verse number="32" style="v" pubnumber="32" sid="EZR 2:32" />وبَنو حاريمَ ثَلاثُ مئَةٍ وعِشرونَ. <verse eid="EZR 2:32" /><verse number="33" style="v" pubnumber="33" sid="EZR 2:33" />وبَنو لُودَ وبَنو حاديدَ وأُونُو سَبْعُ مئَةٍ وخَمسةٌ وعِشرونَ. <verse eid="EZR 2:33" /><verse number="34" style="v" pubnumber="34" sid="EZR 2:34" />وبَنو أريحا ثَلاثُ مئَةٍ وخَمسةٌ وأربَعونَ. <verse eid="EZR 2:34" /><verse number="35" style="v" pubnumber="35" sid="EZR 2:35" />وبَنو سَناءَةَ ثَلاثَةُ آلافٍ وسِتُّ مئَةٍ وثلاثونَ.<verse eid="EZR 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" pubnumber="36" sid="EZR 2:36" />الكهَنةُ: بَنو يَدَعْيا مِنْ بَيتِ يَشوعَ: تِسْعُ مئَةٍ وثَلاثةٌ وسَبعونَ <verse eid="EZR 2:36" /><verse number="37" style="v" pubnumber="37" sid="EZR 2:37" />وبَنو أمِّيرَ ألفٌ واَثنانِ وخَمسونَ، <verse eid="EZR 2:37" /><verse number="38" style="v" pubnumber="38" sid="EZR 2:38" />وبَنو فَشْحورَ ألفٌ ومِئتانِ وسَبعةٌ وأربَعونَ <verse eid="EZR 2:38" /><verse number="39" style="v" pubnumber="39" sid="EZR 2:39" />وبَنو حاريمَ ألفٌ وسَبعةَ عشَرَ.<verse eid="EZR 2:39" /></para>
  <para style="p">
    <verse number="40" style="v" pubnumber="40" sid="EZR 2:40" />اللَّاويُّونَ: بَنو يَشوعَ وقَدْميئيلَ مِنْ بَني هُودَوْيا أربَعةٌ وسَبعونَ، <verse eid="EZR 2:40" /><verse number="41" style="v" pubnumber="41" sid="EZR 2:41" />والمُغَنُّونَ: بَنو آسافَ مئَةٌ وثمانيَةٌ وعِشرونَ، <verse eid="EZR 2:41" /><verse number="42" style="v" pubnumber="42" sid="EZR 2:42" />والبَوَّابونَ: بَنو شَلُّومَ وبَنو آطيرَ وبَنو طَلْمُونَ وبَنو عقُّوبَ وبَنو حَطيطا وبَنو شُوبايَ جميعُهم مئَةٌ وتِسعَةٌ وثَلاثونَ.<verse eid="EZR 2:42" /></para>
  <para style="p">
    <verse number="43" style="v" pubnumber="43" sid="EZR 2:43" />وخُدَّامُ الهَيكلِ: بَنو صِيحا وبَنو حَسوفا وبَنو طَباعوتَ <verse eid="EZR 2:43" /><verse number="44" style="v" pubnumber="44" sid="EZR 2:44" />وبَنو قيروسَ وبَنو سيعَها وبَنو فادونَ <verse eid="EZR 2:44" /><verse number="45" style="v" pubnumber="45" sid="EZR 2:45" />وبَنو لَبانَةَ وبَنو حَجابَةَ وبَنو عَقُّوبَ <verse eid="EZR 2:45" /><verse number="46" style="v" pubnumber="46" sid="EZR 2:46" />وبَنو حاجابَ وبَنو شَمْلايَ وبَنو حانانَ <verse eid="EZR 2:46" /><verse number="47" style="v" pubnumber="47" sid="EZR 2:47" />وبَنو جِدِّيلَ وبَنو جَحَرَ وبَنو رآيا <verse eid="EZR 2:47" /><verse number="48" style="v" pubnumber="48" sid="EZR 2:48" />وبَنو رَصينَ وبَنو نَقودا وبَنو جَزَّامَ <verse eid="EZR 2:48" /><verse number="49" style="v" pubnumber="49" sid="EZR 2:49" />وبَنو عُزَّا وبَنو فاسيحَ وبَنو بيسايَ <verse eid="EZR 2:49" /><verse number="50" style="v" pubnumber="50" sid="EZR 2:50" />وبَنو أسْنَةَ وبَنو مَعونيمَ وبَنو نَفوسيمَ <verse eid="EZR 2:50" /><verse number="51" style="v" pubnumber="51" sid="EZR 2:51" />وبَنو بَقْبوقَ وبَنو حَقوفا وبَنو حَرْحورَ <verse eid="EZR 2:51" /><verse number="52" style="v" pubnumber="52" sid="EZR 2:52" />وبَنو بَصْلوتَ وبَنو مَحيدا وبَنو حَرْشا <verse eid="EZR 2:52" /><verse number="53" style="v" pubnumber="53" sid="EZR 2:53" />وبَنو بَرْقوسَ وبَنو سيسَرا وبَنو تامَحَ <verse eid="EZR 2:53" /><verse number="54" style="v" pubnumber="54" sid="EZR 2:54" />وبَنو نَصيحَ وبَنو حَطيفا.<verse eid="EZR 2:54" /></para>
  <para style="p">
    <verse number="55" style="v" pubnumber="55" sid="EZR 2:55" />وبَنو عَبيدِ سليمانَ: بَنو سُوطاي وبَنو هسُّوفَرَت وبَنو فَرودا <verse eid="EZR 2:55" /><verse number="56" style="v" pubnumber="56" sid="EZR 2:56" />وبَنو يَعْلَةَ وبَنو دَرْقونَ وبَنو جِدِّيلَ <verse eid="EZR 2:56" /><verse number="57" style="v" pubnumber="57" sid="EZR 2:57" />وبَنو شَفَطْيا وبَنو حَطِّيلَ وبَنو فوخَرَةَ مِنَ الصبائيمِ وبَنو آمي. <verse eid="EZR 2:57" /><verse number="58" style="v" pubnumber="58" sid="EZR 2:58" />وجميعُ خُدَّامِ الهَيكلِ وبَني عَبيدِ سليمانَ ثلاثُ مئَةٍ واَثنانِ وتِسعونَ.<verse eid="EZR 2:58" /></para>
  <para style="p">
    <verse number="59" style="v" pubnumber="59" sid="EZR 2:59" />أمَّا الّذينَ قَدِمُوا مِنْ تَلِّ المِلْحِ وتَلِّ حَرْشا وكرُوبَ وأدانَ وإِمِّيرَ فلم يَقدِروا أنْ يُبَرهِنوا على أنَّ عَشائِرَهُم يَنتَسِبُونَ إلى بَني إِسرائيلَ: <verse eid="EZR 2:59" /><verse number="60" style="v" pubnumber="60" sid="EZR 2:60" />بَنو دَلايا وبَنو طُوبيَّا وبَنو نَقودا سِتُّ مئَةٍ واَثنانِ وخَمسونَ. <verse eid="EZR 2:60" /><verse number="61" style="v" pubnumber="61" sid="EZR 2:61" />ومِنْ بَينِ الكهَنةِ بَنو حبايا وبَنو هَقُّوصَ وبَنو بَرْزِلّايَ الّذي تَزَوَّجَ مِنْ بَناتِ بَرزِلَّايَ الجِلْعاديّ فَدُعيَ باَسمِهِ. <verse eid="EZR 2:61" /><verse number="62" style="v" pubnumber="62" sid="EZR 2:62" />هؤلاءِ بَحَثُوا عَنْ سِجِلِّ أنْسابِهِم فلم يَجِدوا، فَحُرِموُا مِنَ الكَهَنوتِ بِحَسَبِ الشَّريعَةِ. <verse eid="EZR 2:62" /><verse number="63" style="v" pubnumber="63" sid="EZR 2:63" />وأمَرَهُمُ الحاكِمُ أنْ لا يأكُلوا مِنَ الطَّعامِ المكَرَّسِ لِلرَّبِّ إلى أنْ يقومَ كاهنٌ يَفصِلُ في الأمرِ.<verse eid="EZR 2:63" /></para>
  <para style="p">
    <verse number="64" style="v" pubnumber="64" sid="EZR 2:64" />مَجموعُ هؤلاءِ العائِدينَ مِنَ السَّبْي اَثنانِ وأربَعونَ ألفًا وثَلاثُ مئَةٍ وسِتُّونَ، <verse eid="EZR 2:64" /><verse number="65" style="v" pubnumber="65" sid="EZR 2:65" />فَضلًا عنْ عبيدِهِم وجواريهِم وهُم سَبعةُ آلافٍ وثَلاثُ مئَةٍ وسَبعةٌ وثلاثونَ، ولَهم مِئتانِ مِنَ المُغَنّينَ والمُغَنّياتِ. <verse eid="EZR 2:65" /><verse number="66" style="v" pubnumber="66" sid="EZR 2:66" />خَيلُهُم سَبْعُ مئَةٍ وسِتَّةٌ وثلاثونَ، وبِغالُهُم مِئتانِ وخَمسةٌ وأربَعونَ. <verse eid="EZR 2:66" /><verse number="67" style="v" pubnumber="67" sid="EZR 2:67" />وجِمالُهُم أربَعُ مئَةٍ وخَمسةٌ وثلاثونَ، وحَميرُهُم سِتَّةُ آلافٍ وسَبْعُ مئَةٍ وعِشرونَ.<verse eid="EZR 2:67" /></para>
  <para style="p">
    <verse number="68" style="v" pubnumber="68" sid="EZR 2:68" />ولمَّا وصَلوا إلى هَيكلِ الرّبِّ الّذي في أورُشليمَ تَبَرَّعَ بَعضُ رُؤساءِ العَشائِرِ لإعادَةِ بِناءِ هيكلِ اللهِ في مكانِهِ. <verse eid="EZR 2:68" /><verse number="69" style="v" pubnumber="69" sid="EZR 2:69" />فأعطَوا على قَدْرِ طاقَتِهِم لِهذا العَمَلِ واحدًا وسِتّينَ ألفَ دِرْهَمٍ مِنَ الذَّهبِ وعشَرَةَ قَناطيرَ مِنَ الفِضَّةِ ومئَةَ قَميصٍ لِلكَهَنةِ.<verse eid="EZR 2:69" /></para>
  <para style="p">
    <verse number="70" style="v" pubnumber="70" sid="EZR 2:70" />فسكَنَ الكَهَنةُ واللَّاويُّونَ وبَعضٌ مِنَ الشَّعبِ في أورُشليمَ وما حَولَها، وسكَنَ المُغَنُّونَ والبَوَّابونَ وخُدَّامُ الهَيكلِ في المُدُنِ المُجاوِرةِ، وسائِرُ بَني إِسرائيلَ في مُدُنِ آبائِهِم.<verse eid="EZR 2:70" /></para>
  <chapter eid="EZR 2" />
  <chapter number="3" style="c" sid="EZR 3" />
  <para style="s1">استئناف العبادة</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="EZR 3:1" />ولمَّا جاءَ الشَّهرُ السَّابِعُ كانَ بَنو إِسرائيلَ اَستَقَرُّوا في مُدُنِهِم فاَجتَمَعوا بِقلبٍ واحدٍ وجاؤوا إلى أورُشليمَ. <verse eid="EZR 3:1" /><verse number="2" style="v" pubnumber="2" sid="EZR 3:2" />فقامَ يَشوعُ بنُ يوصادَقَ وإخوَتُهُ الكهَنةُ، وزَرُبابِلُ بنُ شألْتِئيلَ وإخوَتُه وبَنَوا مذبَحَ إلهِ إِسرائيلَ ليُصعِدوا علَيهِ مُحرقاتٍ كما كُتِبَ في شريعةِ موسى رَجُلِ اللهِ. <verse eid="EZR 3:2" /><verse number="3" style="v" pubnumber="3" sid="EZR 3:3" />وأقاموا المذبحَ على قَواعِدِهِ نَفْسِها، معَ أنَّهُم كانوا خائِفينَ مِنَ الشُّعوبِ المُجاوِرةِ، وأصعَدوا علَيهِ مُحرقاتٍ للرّبِّ في الصَّباحِ والمَساءِ. <verse eid="EZR 3:3" /><verse number="4" style="v" pubnumber="4" sid="EZR 3:4" />وعَيَّدوا عيدَ المَظالِّ كما كُتِبَ في الشَّريعةِ، وقَدَّمُوا للرّبِّ المُحرقاتِ اليوميَّةَ على حسَبِ ما هوَ مَرسُومٌ كُلَّ يَومٍ في يَومِهِ، <verse eid="EZR 3:4" /><verse number="5" style="v" pubnumber="5" sid="EZR 3:5" />وفَضلًا عَنْ هذِهِ المُحرقاتِ قدَّمُوا بَعدَ ذلِكَ مُحرقاتِ رُؤُوسِ الشُّهورِ وجميعِ أعيادِ الرّبِّ المُقَدَّسَةِ، وكُلَّ ما تبَرَّعَ النَّاسُ بهِ لِلرّبِّ مِنْ قرابينَ. <verse eid="EZR 3:5" /><verse number="6" style="v" pubnumber="6" sid="EZR 3:6" />مِنَ اليومِ الأوَّلِ مِنَ الشَّهرِ السَّابِعِ اَبتَدَأوا يُقَدِّمونَ مُحرقاتٍ للرّبِّ، معَ أنَّ هَيكلَ الرّبِّ لم يكُنْ أُسِّسَ بَعدُ.<verse eid="EZR 3:6" /></para>
  <para style="s1">البدء بإعادة البناء</para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="EZR 3:7" />وأعطَوا فِضَّةً لِلنَّحَّاتينَ والنَّجَّارينَ، وطَعامًا وشَرابًا وزَيتًا للصَّيدُونيِّينَ والصُّوريِّينَ ليأتُوا بِخَشَبِ الأرزِ مِنْ لبنانَ إلى يافا بِطريقِ البحرِ، بعدَ أنْ أذِنَ كُورَشُ مَلِكُ الفُرسِ لهُم. <verse eid="EZR 3:7" /><verse number="8" style="v" pubnumber="8" sid="EZR 3:8" />وفي الشَّهرِ الثَّاني مِنَ السَّنةِ الثَّانيةِ مِنْ مَجيئِهِم إلى هَيكلِ اللهِ في أورُشليمَ، بَدَأَ زَرُبَّابِلُ بنُ شألتِئيلَ بالعَمَلِ ومعَهُ يَشوعُ بنُ يُوصادَقَ وبَقيَّةُ أنسِبائِهِمِ الكهَنةِ واللَّاويِّينَ وكُلُّ مَنْ رجَعَ مِنَ السَّبْي إلى أورُشليمَ. وأُوكِلَ إلى اللَّاويِّينَ مِنِ اَبنِ عِشرينَ سَنةً فما فَوقُ على مُراقَبَةِ العَمَلِ في بِناءِ هَيكلِ الرّبِّ. <verse eid="EZR 3:8" /><verse number="9" style="v" pubnumber="9" sid="EZR 3:9" />فتَوَلَّى ذلِكَ يَشوعُ وبَنوهُ وإخوَتُهُ، وقَدْميئيلُ وبَنوهُ، وبَنو يَهوذا، يُعاوِنُهُم بَنو حينَدادَ وبَنوهُم وأنسِباؤُهُمُ اللَّاويُّونَ.<verse eid="EZR 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="EZR 3:10" />ولمَّا أسَّسَ البَنَّاؤونَ هَيكلَ الرّبِّ قامَ الكهَنةُ في مَلابِسِهِم بالأبواقِ، واللَّاويُّونَ بَنو آسافَ بالصُّنوجِ، ليُهَلِّلوا للرّبِّ على حسَبِ تَرتيبِ داوُدَ مَلِكِ إِسرائيلَ. <verse eid="EZR 3:10" /><verse number="11" style="v" pubnumber="11" sid="EZR 3:11" />ورَنَّمُوا بالتَّهليلِ والحَمدِ للرّبِّ لأنَّهُ صالِحٌ، لأنَّ رَحمتَهُ إلى الأبدِ على إِسرائيلَ، وهتَفَ جميعُ الشَّعبِ هُتافًا عظيمًا، وهَلَّلوا اَبْتِهاجًا بِتأسيسِ هَيكلِ الرّبِّ. <verse eid="EZR 3:11" /><verse number="12" style="v" pubnumber="12" sid="EZR 3:12" />وكانَ كثيرونَ مِنَ الكهَنةِ واللَّاويِّينَ والشُّيوخِ مِنْ رُؤساءِ العَشائِرِ رَأَوا الهَيكلَ الأوَّلَ فَبكَوا بِصَوتٍ عظيمٍ عِندَما وُضِعَ أساسُ هذا الهَيكلِ أمامَ عُيونِهِم. ولكِنَّ الآخرينَ هَتَفوا بالفَرَحِ رافِعينَ أصواتَهُم، <verse eid="EZR 3:12" /><verse number="13" style="v" pubnumber="13" sid="EZR 3:13" />حتّى إنَّ أحدًا لم يَقدِرْ أنْ يُمَيِّزَ صوتَ هُتافِ الفَرَحِ مِنْ صوتِ البُكاءِ، لأنَّ الشَّعبَ كانوا يَهتِفونَ هُتافًا عظيمًا حتّى كانَ الصَّوتُ يُسمَعُ مِنْ بَعيدٍ.<verse eid="EZR 3:13" /></para>
  <chapter eid="EZR 3" />
  <chapter number="4" style="c" sid="EZR 4" />
  <para style="s1">معارضة بناء الهيكل وأورشليم</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="EZR 4:1" />وسمِعَ أعداءُ بَني يَهوذا وبَنيامينَ بأنَّ العائِدينَ مِنَ السَّبي يَبنونَ هَيكلًا لِلرّبِّ إلهِ بَني إِسرائيلَ، <verse eid="EZR 4:1" /><verse number="2" style="v" pubnumber="2" sid="EZR 4:2" />فأقبَلوا على زَرُبَّابِلَ ورُؤساءِ العَشائِرِ وقالوا لهُم: ”نَحنُ نَبني مَعكُم، لأنَّنا نَعبُدُ إلهَكُم مِثْلَكُم، ونَحنُ نَذبَحُ لَه مِنْ أيّامِ أسرَحَدُّونَ مَلِكِ أشُّورَ الّذي جاءَ بِنا إلى هُنا“. <verse eid="EZR 4:2" /><verse number="3" style="v" pubnumber="3" sid="EZR 4:3" />فقالَ لهُم زَرُبَّابِلُ ويَشوعُ وسائِرُ رؤساءِ عَشائِرِ بَني إِسرائيلَ: ”أيَّةُ عَلاقَةٍ تَربِطُنا بِكُم لِتَبنوا مَعَنا بَيتًا لإلَهِنا، فنَحنُ وَحْدَنا نَبني لِلرّبِّ إلهِ بَني إِسرائيلَ كما أمَرَنا المَلِكُ كُورشُ، مَلِكُ الفُرسِ“.<verse eid="EZR 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="EZR 4:4" />وأخَذَ أهلُ تِلكَ الأرضِ يُثَبِّطُونَ عَزيمَةَ شعبِ يَهوذا ويُخيفونَهم ليَمتنِعوا عَنِ البِناءِ. <verse eid="EZR 4:4" /><verse number="5" style="v" pubnumber="5" sid="EZR 4:5" />واَستَأجَروا علَيهِم بَعضَ رِجالَ السُّلطَةِ لِعَرقَلَةِ مَساعيهِم طُولَ أيّامِ كُورشَ مَلِكِ الفُرسِ وبَقَوا على هذِهِ الحالِ إلى أنْ ملَكَ داريوسُ.<verse eid="EZR 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="EZR 4:6" />وفي أوَّلِ أيّامِ المَلِكِ أحشويروشَ كتَبوا شكوَى على سُكَّانِ يَهوذا وأورُشليمَ. <verse eid="EZR 4:6" /><verse number="7" style="v" pubnumber="7" sid="EZR 4:7" />وفي أيّامِ أرتَحشَشتَا أيضًا كتَبَ بِشلامُ ومِثْرَداتُ وطَبْئيلُ وسائِرُ مُعاونيهِم رِسالةَ شكوى إلى أرتَحشَشتا مَلِكِ الفُرسِ. وكانتِ الرِّسالةُ بالآراميَّةِ خَطًّا ومَضمُونًا. <verse eid="EZR 4:7" /><verse number="8" style="v" pubnumber="8" sid="EZR 4:8" />وكتَبَ رَحومُ الحاكِمُ وشِمْشايُ الكاتِبُ رسالةً أولى على أورُشليمَ إلى أرتَحشَشتا المَلِكِ بِهذا المَعنى. <verse eid="EZR 4:8" /><verse number="9" style="v" pubnumber="9" sid="EZR 4:9" />ثُمَّ كتَبَ رَحومُ الحاكِمُ وشِمْشاي الكاتِبُ وسائِرُ مُعاونيهِم الدِّينيِّينَ والأفْرَسِتكيِّينَ والطَّرْفَليِّينَ والأفْرَسيِّين والأركيِّينَ والبابِليِّين والشُّوشَنيِّينَ والدَّهويِّين والعيلاميِّينَ <verse eid="EZR 4:9" /><verse number="10" style="v" pubnumber="10" sid="EZR 4:10" />وسائِرِ الأمَمِ الّذينَ سَباهُم أشُّورُ بانيبالُ العظيمُ الجَليلُ وأسكَنَهم مُدُنَ السَّامِرةِ وسِواها في غربي الفُراتِ. <verse eid="EZR 4:10" /><verse number="11" style="v" pubnumber="11" sid="EZR 4:11" />وهذا نَصُّ الرِّسالةِ: ”مِنْ عبيدِكَ السَّاكِنينَ في غَربي الفُراتِ، سلامٌ. <verse eid="EZR 4:11" /><verse number="12" style="v" pubnumber="12" sid="EZR 4:12" />ليكُنْ مَعلومًا لدى المَلِكِ أنَّ اليهودَ الّذينَ خرَجوا مِنْ عِندِكَ جاؤوا إلينا، إلى أورُشليمَ المُتَمَرِّدَةِ الشَّقيَّةِ يَبنونَ أسوارَها ويُرَمِّمونَ أُسُسَها. <verse eid="EZR 4:12" /><verse number="13" style="v" pubnumber="13" sid="EZR 4:13" />وليكُنْ مَعلومًا لدى المَلِكِ أنَّه إنْ بُنِيَت هذِهِ المدينةُ وأُكمِلَت أسوارُها لا يُؤدّي أهلُها الخَراجَ ولا الجِزيَةَ ولا الضَّريبَةَ المعتادةَ، وهوَ ما يوقِعُ الضَّررَ بالدَّخْلِ المَلكِيِّ. <verse eid="EZR 4:13" /><verse number="14" style="v" pubnumber="14" sid="EZR 4:14" />وبِما أننا أكَلْنا خُبزَ المَلِكِ ومِلْحَهُ لم يكُنْ لائقًا بِنا أنْ نَرى هذا الضَّررَ يَنزِلُ بالمَلِكِ، فأرسَلْنا وأعلَمْناكَ <verse eid="EZR 4:14" /><verse number="15" style="v" pubnumber="15" sid="EZR 4:15" />لعَلَّكَ تَأْمُرُ بالبَحثِ في كتابِ أخبارِ آبائِكَ، فتَطَّلعَ فيها وتَعلمَ أنَّ هذِهِ المدينةَ مدينةٌ مُتَمَرِّدَةٌ تُسيءُ إلى المُلوكِ وحُكَّامِ الأقاليمِ، وأنَّ سُكَّانَها أثاروا فيها شَغَبًا في قديمِ الزَّمانِ، مِمَّا أدَّى إلى خَرابِها. <verse eid="EZR 4:15" /><verse number="16" style="v" pubnumber="16" sid="EZR 4:16" />فاَعلَمْ إذًا أيُّها المَلِكُ أنَّ هذِهِ المدينةَ إنْ بُنِيَت واَكتَمَلَت أسوارُها لا يكونُ لكَ نَصيبٌ في غربي الفُراتِ“.<verse eid="EZR 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="EZR 4:17" />فأرسَلَ المَلِكُ جوابًا هذا نَصُّهُ: ”لِرَحومَ الحاكِمِ وشِمْشايَ الكاتِبِ وسائِرِ مُعاونِيهما السَّاكِنينَ في السَّامِرةِ، ولِبَقيَّةِ الّذينَ في غربي الفُراتِ، ”سلامٌ. <verse eid="EZR 4:17" /><verse number="18" style="v" pubnumber="18" sid="EZR 4:18" />قُرِئَت رِسالتُكُم إلينا بِوضوحٍ، <verse eid="EZR 4:18" /><verse number="19" style="v" pubnumber="19" sid="EZR 4:19" />فأمَرْتُ بالبَحثِ فوَجَدْتُ أنَّ هذِهِ المدينةَ في قديمِ الزَّمانِ ثارَت على المُلوكِ وكانَ فيها تَمَرُّدٌ وفِتنَةٌ. <verse eid="EZR 4:19" /><verse number="20" style="v" pubnumber="20" sid="EZR 4:20" />وكانَ على أورُشليمَ مُلوكٌ أقوِياءُ تَسَلَّطوا على جميعِ الأرضِ غربي الفُراتِ، دَفَعَ سُكَّانُها إليهِمِ الخَراجَ والجِزيَةَ والضَّريبةَ. <verse eid="EZR 4:20" /><verse number="21" style="v" pubnumber="21" sid="EZR 4:21" />فالآنَ أصدِروا أمرًا بِمَنْعِ هؤلاءِ الرِّجالِ مِنْ بِناءِ هذِهِ المدينةِ حتّى يَصدُرَ أمرٌ مِنِّي. <verse eid="EZR 4:21" /><verse number="22" style="v" pubnumber="22" sid="EZR 4:22" />حاذِروا أنْ تَتَهاونوا في تنفيذِ هذا الأمرِ لِئلَّا يتَفاقَمَ الضَّرَرُ، فَيَلحَق الأذَى بالمُلوكِ“.<verse eid="EZR 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="EZR 4:23" />فلمَّا تُليَت رسالةُ المَلِكِ أرتَحشَشتا أمامَ رحومَ وشِمْشايَ الكاتِبِ ومُعاونِيهِما أسرَعوا في الذَّهابِ إلى أورُشليمَ، إلى اليهودِ، ومَنَعُوهُم بالعُنْفِ والقوَّةِ. <verse eid="EZR 4:23" /><verse number="24" style="v" pubnumber="24" sid="EZR 4:24" />فتَعَطَّلَ العَمَلُ في بِناءِ هَيكلِ اللهِ الّذي في أورُشليمَ، وبَقيَ مُنقَطِعًا إلى السَّنةِ الثَّانيةِ لِداريوسَ مَلِكِ الفُرسِ.<verse eid="EZR 4:24" /></para>
  <chapter eid="EZR 4" />
  <chapter number="5" style="c" sid="EZR 5" />
  <para style="s1">بناء الهيكل</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="EZR 5:1" />وكانَ النَّبيَّانِ، حَجَّايُ وزكَرِيَّا بنُ عَدُّو، يَتكَلَّمانِ باَسْمِ إلهِ إِسرائيلَ لليهودِ الّذينَ في يَهوذا وأورُشليمَ. <verse eid="EZR 5:1" /><verse number="2" style="v" pubnumber="2" sid="EZR 5:2" />فقامَ زَرُبَّابِلُ بنُ شألتئيلَ ويَشوعُ بنُ يوصادَقَ. وشَرَعا في بِناءِ هيكَلِ اللهِ الّذي في أورُشليمَ، ومَعَهُما نَبيَّا اللهِ يُساعدانِهما. <verse eid="EZR 5:2" /><verse number="3" style="v" pubnumber="3" sid="EZR 5:3" />فجاءَهُم نَثْناي والي غربي الفُراتِ وشَتْرَبُوزناي وأعوانُهما وقالوا لهُم: ”مَنْ أمَرَكُم بِبِناءِ الهَيكَلِ وتَجْهيزِهِ؟“ <verse eid="EZR 5:3" /><verse number="4" style="v" pubnumber="4" sid="EZR 5:4" />وسألوهُم: ”ما هيَ أسماءُ الرِّجالِ القائمينَ بِهذا البِناءِ؟“ <verse eid="EZR 5:4" /><verse number="5" style="v" pubnumber="5" sid="EZR 5:5" />وكانَت عينُ الله تَرعَى شُيوخَ اليهودِ فلم يَمنَعُوهُم عَنِ العَمَلِ، ريثَما يَرفَعونَ الأمرَ إلى داريوسَ ويَتَلَقَّون جوابَهُ. <verse eid="EZR 5:5" /><verse number="6" style="v" pubnumber="6" sid="EZR 5:6" />وهذا نَصُّ الرِّسالةِ الّتي أرسَلَها إلى داريوسَ المَلِكِ: مِنْ تثنايَ والي غربي الفُراتِ وشتربوزنايَ وأعوانِهِما الأفرسكيِّينَ <verse eid="EZR 5:6" /><verse number="7" style="v" pubnumber="7" sid="EZR 5:7" />”إلى داريوسَ المَلِكِ فائِقُ السَّلام. <verse eid="EZR 5:7" /><verse number="8" style="v" pubnumber="8" sid="EZR 5:8" />لِيكُنْ مَعلومًا لدَى المَلِكِ أننا ذَهَبْنا إلى بِلادِ يَهوذا، فوجَدْنا أنَّ هَيكلَ اللهِ العظيمِ يُبنَى بِحِجارةٍ ضَخْمَةٍ ويُوضَعُ الخشَبُ الآنَ في حِيطانِهِ، والعَمَلُ مُعَجَّلٌ فيهِ وهوَ يَتِمُّ بِنَجاحٍ. <verse eid="EZR 5:8" /><verse number="9" style="v" pubnumber="9" sid="EZR 5:9" />فسألْنا أُولَئِكَ الشُّيوخَ: مَنْ أمَرَكُم بِبِناءِ الهَيكلِ وتَجهيزِهِ؟ <verse eid="EZR 5:9" /><verse number="10" style="v" pubnumber="10" sid="EZR 5:10" />وسألْناهُم عَنْ أسمائِهِم لِنكتُبَ إليكَ ونُعلِمَكَ مَنْ هُمُ القائِمونَ بهذا العَمَلِ. <verse eid="EZR 5:10" /><verse number="11" style="v" pubnumber="11" sid="EZR 5:11" />فأجابوا: نَحنُ، عبيدُ إلهِ السَّماواتِ والأرضِ، نُعيدُ بِناءَ الهَيكلِ الّذي بَناهُ مِنْ سنينَ كثيرةٍ وأتَمَّ بِناءَهُ مَلِكٌ عظيمٌ لِبَني إِسرائيلَ. <verse eid="EZR 5:11" /><verse number="12" style="v" pubnumber="12" sid="EZR 5:12" />ولكِنْ بَعدَ أنْ أغضَبَ آباؤُنا إلهَ السَّماواتِ أسلَمَهُم إلى يَدِ نَبوخذنَصَّرَ مَلِكِ البابليِّينَ الّذي هدَمَ الهَيكلَ وسَبَى الشَّعبَ إلى بابِلَ. <verse eid="EZR 5:12" /><verse number="13" style="v" pubnumber="13" sid="EZR 5:13" />وفي السَّنةِ الأولى لِكُورُشَ مَلِكِ بابِلَ أصدَرَ المَلِكُ كُورُشُ أمرًا بِبِناءِ هَيكلِ اللهِ هذا، <verse eid="EZR 5:13" /><verse number="14" style="v" pubnumber="14" sid="EZR 5:14" />وأعادَ آنيَةَ الذَّهبِ والفِضَّةِ، وكانَ نَبوخذنَصَّرُ أخرَجها مِنَ الهَيكلِ الّذي في أورُشليمَ وأدخَلها هَيكلَ بابِلَ. هذِهِ الآنيَةُ أخرَجَها كُورشُ المَلِكُ مِنْ هَيكلِ بابِلَ وسَلَّمَها إلى رَجُلٍ اَسْمُهُ شيشَبْصَرُ الّذي كانَ أقامَهُ واليًا <verse eid="EZR 5:14" /><verse number="15" style="v" pubnumber="15" sid="EZR 5:15" />وقالَ لَه: خُذْ هذِهِ الآنيَةَ وأعِدْها إلى الهَيكلِ الّذي في أورُشليمَ واَعمَلْ على بِنَاءِ هَيكلِ اللهِ في مكانِهِ. <verse eid="EZR 5:15" /><verse number="16" style="v" pubnumber="16" sid="EZR 5:16" />فجاءَ شيشَبْصَرُ ووضَعَ أساسَ هَيكلِ اللهِ، ومِنْ ذلِكَ الوقتِ إلى الآنَ ونَحنُ نَبنيهِ ولم نُكْمِلْهُ بَعدُ <verse eid="EZR 5:16" /><verse number="17" style="v" pubnumber="17" sid="EZR 5:17" />فالآنَ إنْ حَسُنَ عِندَكَ، أيُّها المَلِكُ، فاَبحَثْ في وثائِقِ المَملكَةِ المَحفوظَةِ هُناكَ في بابِلَ هل صَدَرَ أمرٌ مِنْ كُورشَ المَلِكِ بِبِناءِ هَيكلِ اللهِ هذا في أورُشليمَ، ثُمَّ أرسِلْ إلينا ما تَشاءُ أنْ نَفعَلَهُ في هذا الأمرِ“.<verse eid="EZR 5:17" /></para>
  <chapter eid="EZR 5" />
  <chapter number="6" style="c" sid="EZR 6" />
  <para style="s1">العثور على أمر كورش</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="EZR 6:1" />فأصدرَ داريوسُ المَلِكُ أمرًا بالبَحثِ في الوثائِقِ الّتي كانَت خَزائِنُها مَحفوظَةً في بابِلَ، <verse eid="EZR 6:1" /><verse number="2" style="v" pubnumber="2" sid="EZR 6:2" />ووجِدَ في أحْمَتا، في القصرِ الّذي في بِلادِ ماديَ سِجِلٌّ مكتوبٌ فيهِ هذِهِ المُذَكِّرةُ: <verse eid="EZR 6:2" /><verse number="3" style="v" pubnumber="3" sid="EZR 6:3" />”في السَّنةِ الأولى لِكُورشَ أصدرَ كُورشُ المَلِكُ أمرًا بأنْ يُبنى هَيكلُ اللهِ في أورُشليمَ على أُسُسِهِ القديمةِ ليكونَ مكانًا يَذبحُ فيهِ اليهودُ الذَّبائحَ، على أنْ يكونَ عُلُوُّهُ سِتِّينَ ذِراعًا، وعَرضُهُ سِتِّينَ ذِراعًا، <verse eid="EZR 6:3" /><verse number="4" style="v" pubnumber="4" sid="EZR 6:4" />بِثلاثةِ صُفوفٍ منْ حِجارةٍ عظيمةٍ فَوقَ كُلٍّ مِنها صَفٌّ مِنْ خشَبٍ، وعلى أنْ تكونَ النَّفَقةُ مِنْ بَيتِ المَلِكِ. <verse eid="EZR 6:4" /><verse number="5" style="v" pubnumber="5" sid="EZR 6:5" />وأمَرَ أيضًا أن تُرَدَّ آنيَةُ الذَّهبِ والفِضَّةِ الّتي أخرَجَها نَبوخذنَصَّرُ مِنَ الهَيكلِ الّذي في أورُشليمَ وجاءَ بِها إلى بابِلَ، فَتَرجعَ إلى مكانِها في الهَيكلِ وتُوضَعَ هُناكَ“.<verse eid="EZR 6:5" /></para>
  <para style="s1">داريوس يأمر بمتابعة البناء</para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="EZR 6:6" />فكتَبَ داريوسُ هذا الجوابَ إلى تَتْنايَ والي غربيِّ الفُراتِ، وشتربوزنايَ ومُعاونيهِما في ذلِكَ الإقليمِ: ”إبتَعِدُوا مِنْ هُناكَ. <verse eid="EZR 6:6" /><verse number="7" style="v" pubnumber="7" sid="EZR 6:7" />دَعُوا والي يَهوذا وشيوخَ اليهودِ يَعمَلونَ في بِناءِ هَيكَلِ اللهِ هذا في مكانِهِ. <verse eid="EZR 6:7" /><verse number="8" style="v" pubnumber="8" sid="EZR 6:8" />وآمُرُكُم أنْ تساعِدُوا هؤلاءِ في بِنائِهِ، على أنْ تُعطَى لهُمُ النَّفَقةُ فَورًا مِنْ خراجِ غربيِّ الفُراتِ العائِدِ لِلمَلِكِ لِئلَّا يتَعَطَّلُوا عَنِ العَمَلِ. <verse eid="EZR 6:8" /><verse number="9" style="v" pubnumber="9" sid="EZR 6:9" />ويُعطَى لهُم مِنْ دونِ تأخيرٍ ما يقولُ الكهَنةُ الّذينَ في أورُشليمَ أنَّهُم يَحتاجونَ إليهِ كُلَّ يومٍ مِنَ العُجولِ والكِباشِ والخِرافِ لِمُحرَقاتِ إلهِ السَّماواتِ، ومِنَ الحِنْطَةِ والمِلْحِ والخَمرِ والزَّيتِ، <verse eid="EZR 6:9" /><verse number="10" style="v" pubnumber="10" sid="EZR 6:10" />فيُقَدِّمُ الكهَنةُ ذَبائِحَ رِضىً لإلهِ السَّماواتِ ويُصَلّونَ لأجلِ المَلِكِ وبَنيهِ. <verse eid="EZR 6:10" /><verse number="11" style="v" pubnumber="11" sid="EZR 6:11" />وأمَرَ أيضًا أنَّ كُلَّ مَنْ يُخالِفُ هذا الكَلامَ تُقلَعُ خَشَبةٌ مِنْ بَيتِهِ وتُنصَبُ ليُعَلَّقَ علَيها مَصلُوبًا، ويكونُ بَيتُهُ مَزبَلَةً. <verse eid="EZR 6:11" /><verse number="12" style="v" pubnumber="12" sid="EZR 6:12" />واللهُ الّذي أحَلَّ اَسمَه في أورُشليمَ يُدَمِّرُ كُلَّ مَلِكٍ وشعبٍ يَمُدُّ يَدَهُ لِتَغييرِ هذا القرارِ وهَدْمِ هَيكلِ اللهِ هُناكَ. أنا دارِيوسُ أمَرْتُ بِذلِكَ، فَليُنفَّذْ عاجِلًا“.</para>
  <para style="p" vid="EZR 6:12">تكريس الهيكل<verse eid="EZR 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="EZR 6:13" />فسارَعَ تَتنايُ والي غربيِّ الفُراتِ، وشَتْرَبوزَنايَ ومُعاوِنوهُما إلى العَمَلِ بِما أمَرَ بهِ داريوسُ المَلِكُ. <verse eid="EZR 6:13" /><verse number="14" style="v" pubnumber="14" sid="EZR 6:14" />ونجَحَ شُيوخُ اليهودِ في بِناءِ الهَيكلِ بِحسَبِ إرشاداتِ النَّبيَّينِ حَجَّايَ وزَكريَّا بنِ عَدُّو، فَأكمَلُوهُ كما أمَرَ إلهُ إِسرائيلَ وأمَرَ كُورشُ وداريوسُ وأرتَحشَشتا، مُلوكُ الفُرسِ. <verse eid="EZR 6:14" /><verse number="15" style="v" pubnumber="15" sid="EZR 6:15" />وكانَ ذلِكَ في اليومِ الثَّالِثِ والعِشرينَ مِنْ شَهرِ آذارَ مِنَ السَّنةِ السَّادِسَةِ لِداريوسَ المَلِكِ. <verse eid="EZR 6:15" /><verse number="16" style="v" pubnumber="16" sid="EZR 6:16" />ودَشَّنَ بَنو إِسرائيلَ والكهَنةُ واللَّاويُّونَ وسائِرُ العائِدينَ مِنَ السَّبْي هَيكلَ اللهِ هذا بِفَرَحٍ. <verse eid="EZR 6:16" /><verse number="17" style="v" pubnumber="17" sid="EZR 6:17" />وقَرَّبُوا عِندَ تَدشينِهِ مئَةَ ثَورٍ ومِئَتَي كَبْشٍ وأربَعَ مئَةِ خروفٍ، وقَرَّبوا ذَبيحَةَ خَطيئةٍ تكفيرًا عَنْ جميعِ بَني إِسرائيلَ اَثنَي عشَرَ تَيسًا على عَدَدِ أسباطِهِم. <verse eid="EZR 6:17" /><verse number="18" style="v" pubnumber="18" sid="EZR 6:18" />وقامَ بَنو إِسرائيلَ بِتَنظيمِ الكهَنةِ واللَّاويِّينَ في فِرَقٍ وأقسامٍ لِخِدمةِ هَيكلِ اللهِ الّذي في أورُشليمَ، كما وَرَدَ في كِتابِ موسى.<verse eid="EZR 6:18" /></para>
  <para style="s1">الفصح وعيد الفطير</para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="EZR 6:19" />وعَمِلَ العائِدونَ مِنَ السَّبْي الفِصْحَ في الرَّابعَ عَشَرَ مِنَ الشَّهرِ الأوَّلِ، <verse eid="EZR 6:19" /><verse number="20" style="v" pubnumber="20" sid="EZR 6:20" />لأنَّ الكَهَنةَ واللَّاويِّينَ تَطَهَّرُوا جميعًا وذَبَحُوا الفِصْحَ لِجميعِ العائدينَ مِنَ السَّبي ولأنسبائِهِمِ الكَهَنةِ ولأنفُسِهِم. <verse eid="EZR 6:20" /><verse number="21" style="v" pubnumber="21" sid="EZR 6:21" />فأكَلَهُ بَنو إِسرائيلَ الّذينَ رَجَعوا مِنَ السَّبي كما أكَلَهُ كُلُّ مَنْ تَرَكَ رَجاساتِ أُمَمِ الأرضِ واَنْحازَ إليهِم ليَطلُبَ الرّبَّ إلهَ إِسرائيلَ. <verse eid="EZR 6:21" /><verse number="22" style="v" pubnumber="22" sid="EZR 6:22" />وعَيَّدوا عيدَ الفَطيرِ سَبعةَ أيّامٍ بِفَرَحٍ، لأنَّ الرّبَّ فَرَّحَهُم وجعَلَ قلبَ مَلِكِ أشُّورَ يَميلُ إليهِم ليُشَجِّعَهُم في العَمَلِ لِبِناءِ هَيكلِ اللهِ إلهِ إِسرائيلَ.<verse eid="EZR 6:22" /></para>
  <chapter eid="EZR 6" />
  <chapter number="7" style="c" sid="EZR 7" />
  <para style="s1">عزرا في أورشليم</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="EZR 7:1" />بَعدَ هذِهِ الأُمورِ، أي في أيّامِ أرتَحشَشتا مَلِكِ الفُرسِ، كانَ رَجُلٌ اَسْمُهُ عَزْرا، وهوَ ابنُ سَرايا بنِ عَزَرْيا بنِ حِلْقيَّا <verse eid="EZR 7:1" /><verse number="2" style="v" pubnumber="2" sid="EZR 7:2" />بنِ شَلُّومَ بنِ صادوقَ بنِ أخيطوبَ <verse eid="EZR 7:2" /><verse number="3" style="v" pubnumber="3" sid="EZR 7:3" />بنِ أمَرْيا بنِ عَزَرْيا بنِ مرايوثَ <verse eid="EZR 7:3" /><verse number="4" style="v" pubnumber="4" sid="EZR 7:4" />بنِ زَرَحْيا بنِ عُزِّيَ بنِ بُقِّيَ <verse eid="EZR 7:4" /><verse number="5" style="v" pubnumber="5" sid="EZR 7:5" />بنِ أبيشوعَ بنِ فينحاسَ بنِ ألعازارَ بنِ هرونَ رئيسِ الكهَنةِ. <verse eid="EZR 7:5" /><verse number="6" style="v" pubnumber="6" sid="EZR 7:6" />وكانَ عَزْرا عالِمًا ماهرًا في شريعةِ موسى الّتي أعطاها الرّبُّ إلهُ بَني إِسرائيلَ، ومَنَحَهُ المَلِكُ كُلَّ ما طلَبَه، لأنَّ برَكَةَ الرّبِّ إلَهِهِ كانَت علَيهِ. <verse eid="EZR 7:6" /><verse number="7" style="v" pubnumber="7" sid="EZR 7:7" />فخَرَجَ مِنْ بابِلَ إلى أورُشليمَ ومَعَهُ قَومٌ مِنْ بَني إِسرائيلَ ومِنَ الكهَنةِ واللَّاويِّينَ والمُغَنِّينَ وحُرَّاسِ بَيتِ اللهِ وخُدَّامِهِ. كانَ ذلِكَ في السَّنةِ السَّابِعةِ لأرْتَحشَشتا المَلِكِ. <verse eid="EZR 7:7" /><verse number="8" style="v" pubnumber="8" sid="EZR 7:8" />فوَصَل إلى أورُشليمَ في الشَّهرِ الخامسِ في السَّنةِ السَّابِعةِ للملِكِ <verse eid="EZR 7:8" /><verse number="9" style="v" pubnumber="9" sid="EZR 7:9" />لأنَّه في أوَّلِ يومٍ مِنَ الشَّهرِ الأوَّلِ، كانَ مبدأُ الصُّعودِ منْ بابِلَ وفي أوَّلِ يومٍ مِنَ الشَّهرِ الخامسِ وَفدَ إلى أورُشليمَ، لأنَّ بَركَةَ اللهِ الصَّالِحةَ كانَت علَيه، <verse eid="EZR 7:9" /><verse number="10" style="v" pubnumber="10" sid="EZR 7:10" />ولأنَّ قلبَ عَزْرا كانَ مُهَيَّئًا لِدراسَةِ شريعةِ الرّبِّ والعَمَلِ بِها، ولِتَعليم فَرائِضِها وأحكامِها في أرضِ إِسرائيلَ.<verse eid="EZR 7:10" /></para>
  <para style="s1">رسالة الملك ارتحششتا</para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="EZR 7:11" />وهذِهِ نُسخَةُ الرِّسالةِ الّتي أعطاها المَلِكُ أرتَحشَشتا لَعَزْرا الكاهنِ العالِمِ بالشَّريعةِ وبِوصايا الرّبِّ الّتي أعطاها لبَني إِسرائيلَ:<verse eid="EZR 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="EZR 7:12" />”مِنْ أرتَحشَشتا مَلِكِ المُلوكِ إلى عَزْرا الكاهنِ العالِمِ بِشريعةِ إلهِ السَّماءِ، سلامٌ. <verse eid="EZR 7:12" /><verse number="13" style="v" pubnumber="13" sid="EZR 7:13" />أذَعْتُ أمرًا بأنَّ كُلَّ مَنْ شاءَ في مَملكَتي مِنْ شعبِ إِسرائيلَ وكَهَنَتِهِ واللَّاويِّينَ أنْ يَرجِعَ إلى أورُشليمَ معَكَ فليَرجِعْ. <verse eid="EZR 7:13" /><verse number="14" style="v" pubnumber="14" sid="EZR 7:14" />وأنا المَلِكُ ووُزرائي السَّبعةُ أرسَلْناكَ لِتَستَعلِمَ عَنْ مدَى مُراعاةِ يَهوذا وأورُشليمَ لِشَريعَةِ إلهِكَ الّتي بيدِكَ، <verse eid="EZR 7:14" /><verse number="15" style="v" pubnumber="15" sid="EZR 7:15" />ولِتأخُذَ الفِضَّةَ والذَّهبَ اللَّذَينِ تبَرَّعَ بِهِما المَلِكُ ووُزراؤُهُ لإلهِ إِسرائيلَ الّذي مَسكِنُهُ في أورُشليمَ، <verse eid="EZR 7:15" /><verse number="16" style="v" pubnumber="16" sid="EZR 7:16" />فَضلًا عَنْ كُلِّ ما تَجِدُهُ مِنَ الفِضَّةِ والذَّهبِ في بلادِ بابِلَ كُلِّها، وعَنْ تَبَرُّعاتِ الشَّعبِ والكهَنةِ لِهَيكلِ اللهِ الّذي في أورُشليمَ، <verse eid="EZR 7:16" /><verse number="17" style="v" pubnumber="17" sid="EZR 7:17" />على أنْ تَشتَريَ عاجِلًا بِهذا المالِ ثيرانًا وكِباشًا وخِرافًا معَ التَّقدِماتِ وسكائِبِ الخمرِ وتُقَرِّبَها على مذبحِ هَيكلِكُمُ الّذي في أورُشليمَ. <verse eid="EZR 7:17" /><verse number="18" style="v" pubnumber="18" sid="EZR 7:18" />وكُلُّ ما حَسُنَ عِندَكَ وعِندَ بَني قَومِكَ أنْ تَعمَلُوه بِما يَفضُلُ مِنَ الذَّهبِ والفِضَّةِ فاَعمَلُوهُ كما يَشاءُ إلهُكُم. <verse eid="EZR 7:18" /><verse number="19" style="v" pubnumber="19" sid="EZR 7:19" />والآنيَةُ الّتي أُعطيَت لكَ لِخِدمَةِ هَيكلِ إلهِكَ قَدِّمْها إلى اللهِ في أورُشليمَ. <verse eid="EZR 7:19" /><verse number="20" style="v" pubnumber="20" sid="EZR 7:20" />وسائِرُ ما تَحتاجُ للهَيكلِ، فَلَكَ أنْ تَأْخُذَهُ مِنْ خَزائِنِ المَلِكِ.<verse eid="EZR 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="EZR 7:21" />”وأنا أرتَحشَشتا المَلِكُ أمَرتُ جميعَ أُمَناءِ الخَزينةِ المَلكيَّةِ الّذينَ في غربيِّ الفُراتِ بأنَّه مَهما يَطلُبهُ مِنكُم عَزْرا الكاهِنُ العالِمُ بِشريعةِ إِلهِ السَّماواتِ فأعطوهُ عاجِلًا، <verse eid="EZR 7:21" /><verse number="22" style="v" pubnumber="22" sid="EZR 7:22" />على إلَّا يتَعَدَّى أربَعةَ عَشَرَ قِنْطارَ فِضَّةٍ ومئَةَ قُفَّةِ قَمحٍ ومئَةَ دِنٍّ ومئَةَ خابيةِ زَيتٍ، والمِلْحُ دُونَ تَقييدٍ. <verse eid="EZR 7:22" /><verse number="23" style="v" pubnumber="23" sid="EZR 7:23" />وكُلُّ ما يأمُرُهُ إلهُ السَّماواتِ لأجلِ هَيكلِهِ، فاَعْمَلوهُ باَهْتِمامٍ لِئلَّا يَغضَبَ اللهُ على مَمْلكَتي أنا المَلِكُ ومَمْلكَةِ بَنيَّ. <verse eid="EZR 7:23" /><verse number="24" style="v" pubnumber="24" sid="EZR 7:24" />ونُعلِمُكُم أننا لا نَأْذَنُ بِفَرْضِ خَراجٍ أو جِزيَةٍ أو ضَريبةٍ على جميعِ الكَهَنةِ اللَّاويِّينَ والمُغَنّينَ وحُرَّاسِ هَيكلِ اللهِ هذا وخُدَّامِهِ.<verse eid="EZR 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="EZR 7:25" />”وأنتَ يا عَزْرا، بِحسَبِ حِكمَةِ إلهِكَ الّتي معَكَ، أقِمْ قُضاةً وحُكَّامًا يَقضونَ بَينَ جميعِ الشَّعبِ الّذينَ في غربيِّ الفُراتِ مِمَّنْ يَعلَمُ شرائِعَ إلهِكَ، ومَنْ لا يَعلَمُ فعَلِّمُوهُ. <verse eid="EZR 7:25" /><verse number="26" style="v" pubnumber="26" sid="EZR 7:26" />وكُلُّ مَنْ لا يَعمَلُ بِشريعةِ إلَهِكَ وشريعةِ المَلِكِ، فليُحْكَمْ علَيهِ عاجِلًا، إمَّا بالموتِ أو بالنَّفي أو بِغَرامةِ مالٍ أو بالحَبسِ“.<verse eid="EZR 7:26" /></para>
  <para style="s1">عزرا يحمد الله</para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="EZR 7:27" />فقالَ عَزْرا: ”تَبارَكَ الرّبُّ إلهُ آبائِنا الّذي ألهَمَ المَلِكَ مِثلَ هذا العمَلَ لِتكريمِ هَيكلِ الرّبِّ الّذي في أورُشليمَ، <verse eid="EZR 7:27" /><verse number="28" style="v" pubnumber="28" sid="EZR 7:28" />وجعَلَني أحظى بِعَطْفِ المَلِكِ ووُزرائِهِ وجميعِ أُمَرائِهِ المُقْتَدِرينَ. فَتَقَوَّيتُ بِقُدرَةِ الرّبِّ إلهي وجَمَعْتُ عددًا مِنْ رُؤساءِ بَني إِسرائيلَ ليَعُودوا مَعي“.<verse eid="EZR 7:28" /></para>
  <chapter eid="EZR 7" />
  <chapter number="8" style="c" sid="EZR 8" />
  <para style="s1">العائدون مع عزرا</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="EZR 8:1" />وهؤلاءِ رُؤساءُ العَشائِرِ ونسَبُ الّذينَ عادُوا معي مِنْ بابِلَ في أيّامِ أرتَحشَشتا المَلِكِ: <verse eid="EZR 8:1" /><verse number="2" style="v" pubnumber="2" sid="EZR 8:2" />مِنْ بَني فينحاسَ جرْشومُ، ومِنْ بَني إيثامارَ دانيالُ، ومِنْ بَني داوُدَ حَطُّوشُ <verse eid="EZR 8:2" /><verse number="3" style="v" pubnumber="3" sid="EZR 8:3" />بنُ شكَنْيا، ومِنْ بَني فَرْعَوشَ زكريَّا ومعَهُ مِنَ الذُّكورِ مِئةٌ وخمسونَ رَجُلًا سُجِّلَ نسَبُهُم، <verse eid="EZR 8:3" /><verse number="4" style="v" pubnumber="4" sid="EZR 8:4" />ومِنْ بَني فحَثِ مُوآبَ أليهوعَيْنايُ بنُ زَرَحْيا ومعَهُ مئَتا رَجُلٍ، <verse eid="EZR 8:4" /><verse number="5" style="v" pubnumber="5" sid="EZR 8:5" />ومِنْ بَني زتو شكنيا بنُ يَحْزيئيلَ ومعَهُ ثلاثُ مئَةِ رَجُلٍ، <verse eid="EZR 8:5" /><verse number="6" style="v" pubnumber="6" sid="EZR 8:6" />ومِنْ بَني عادينَ: عابَدُ بنُ يوناثانَ ومعَهُ خمسونَ رَجُلًا، <verse eid="EZR 8:6" /><verse number="7" style="v" pubnumber="7" sid="EZR 8:7" />ومِنْ بَني عيلامَ يَشَعْيا بنُ عَثَلْيا ومعَهُ سَبعونَ رَجُلًا، <verse eid="EZR 8:7" /><verse number="8" style="v" pubnumber="8" sid="EZR 8:8" />ومِنْ بَني شَفَطْيا زَبَدْيا بنُ ميخائيلَ ومعَهُ ثمانونَ رَجُلًا، <verse eid="EZR 8:8" /><verse number="9" style="v" pubnumber="9" sid="EZR 8:9" />ومِنْ بَني يُوآبَ عُوبَدْيا بنُ يَحيئيلَ ومعَهُ مِئتانِ وثَمانيَةَ عشَرَ رَجُلًا، <verse eid="EZR 8:9" /><verse number="10" style="v" pubnumber="10" sid="EZR 8:10" />ومِنْ بَني باني: شَلُوميثُ بنُ يوشِفْيا ومعَهُ مئَةٌ وسِتُّونَ رَجُلًا، <verse eid="EZR 8:10" /><verse number="11" style="v" pubnumber="11" sid="EZR 8:11" />ومِنْ بَني بابايَ زكريَّا بنُ باباي ومعَهُ ثمانيةٌ وعِشرونَ رَجُلًا، <verse eid="EZR 8:11" /><verse number="12" style="v" pubnumber="12" sid="EZR 8:12" />ومِنْ بَني عَزْجَدَ يُوحانانُ بنُ هِقَّاطانَ ومعَهُ عشَرَةُ رِجالٍ، <verse eid="EZR 8:12" /><verse number="13" style="v" pubnumber="13" sid="EZR 8:13" />ومِنْ بَني أدونيقامَ الآخَرونَ وهذِهِ أسماؤُهم: أليفَلْطُ ويَعيئيلُ وشَمْعيا ومعَهُم ستُّونَ رَجُلًا، <verse eid="EZR 8:13" /><verse number="14" style="v" pubnumber="14" sid="EZR 8:14" />ومِنْ بَني بِغْوايَ عُوتايُ وزَبَّودُ ومعَهُما سَبعونَ رَجُلًا.<verse eid="EZR 8:14" /></para>
  <para style="s1">إيجاد لاويين لخدمة الهيكل</para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="EZR 8:15" />فجمَعْتُهُم عِندَ النَّهرِ الجاري إلى مدينةِ أهوا، وهُناكَ نَزَلْنا ثَلاثَةَ أيّامٍ. وحينَ نَظَرْتُ إلى الجَمْعِ والكهَنةِ الّذينَ بَينَهُم لم أجِدْ أحدًا مِنْ بَني لاوي. <verse eid="EZR 8:15" /><verse number="16" style="v" pubnumber="16" sid="EZR 8:16" />فدَعَوتُ تِسعةً مِنَ الرُّؤساءِ وهُم: أليعَزَرُ وأريئيلُ وشَمَعْيا وألناثانُ وياريبُ وألناثانُ وناثانُ وزكريَّا ومَشُلّامُ، واثنَينِ مِنَ العُلَماءِ وهُما يوياريبُ وألناثانُ، <verse eid="EZR 8:16" /><verse number="17" style="v" pubnumber="17" sid="EZR 8:17" />وأرسَلتُهُم إلى إِدُّو رئيسِ الجماعةِ في المكانِ المُسَمَّى كسِفْيا ولقَّنْتُهُم ما يَقولونَهُ لإِدُّو ولأنسِبائِهِ خُدَّامِ هَيكلِ اللهِ هُناكَ وهوَ أنْ يَحضُروا إلينا لِخِدمةِ هَيكلِ إلهِنا. <verse eid="EZR 8:17" /><verse number="18" style="v" pubnumber="18" sid="EZR 8:18" />فجاؤوا إلينا، لأنَّ بَركةَ اللهِ الصَّالِحَةَ كانَت علَينا، بِرَجُلٍ فَهيمٍ مِنْ بَني مَحْلي بنِ لاوي بنِ إِسرائيلَ يُدعى شَرَبْيا معَ ثمانيَةَ عشَرَ رَجُلًا مِنْ بَنيهِ وإخوَتِهِ. <verse eid="EZR 8:18" /><verse number="19" style="v" pubnumber="19" sid="EZR 8:19" />وجاؤوا إلينا أيضًا بِحَشَبْيا، ومعَهُ يشعيا منْ بَني مَراري وإخوَتُهُ وبَنوهُم وعدَدُهُم عِشرونَ، <verse eid="EZR 8:19" /><verse number="20" style="v" pubnumber="20" sid="EZR 8:20" />وبمِئَتَينِ وعِشرينَ مِنْ خُدَّامِ بَيتِ اللهِ الّذينَ عَيَّنَهُم داوُدُ ومُعاوِنوهُ لِخِدمةِ اللَّاويِّينَ، وكُلُّهُم مَعروفونَ بِأسمائِهِم. <verse eid="EZR 8:20" /><verse number="21" style="v" pubnumber="21" sid="EZR 8:21" />فنادَيتُ بِصَومٍ هُناكَ عِندَ نَهرِ أهوا لِنَخشَعَ أمامَ إلهِنا طالبينَ مِنهُ أنْ يَهديَنا طريقًا آمِنًا لنا ولأطفالِنا ولِجميعِ أموالِنا، <verse eid="EZR 8:21" /><verse number="22" style="v" pubnumber="22" sid="EZR 8:22" />لأني خَجِلْتُ أنْ أطلُبَ مِنَ المَلِكِ جيشًا وفُرسانًا ليَحرُسونا مِنَ العَدُوِّ في الطَّريقِ، بعدَ أنْ قُلتُ لَه إنَّ قُدرَةَ إلهِنا معَ جميعِ الّذينَ يَتَّبِعونَهُ، وإنَّ بطْشَهُ وغضَبَهُ على جميعِ الّذينَ يَترُكونَهُ. <verse eid="EZR 8:22" /><verse number="23" style="v" pubnumber="23" sid="EZR 8:23" />فَصُمْنا ودَعَونا إلى اللهِ لِحِمايَتِنا، فاَسْتَجاب لنا.<verse eid="EZR 8:23" /></para>
  <para style="s1">تبرعات لبيت الله</para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="EZR 8:24" />ثُمَّ اَختَرْتُ اَثنَي عشَرَ مِنْ رُؤساءِ الكهَنةِ ومعَهُم شَرَبْيا وحَشَبيا وعشَرَةٌ مِنْ أنسِبائِهِما معَهُما، <verse eid="EZR 8:24" /><verse number="25" style="v" pubnumber="25" sid="EZR 8:25" />ووَزَنْتُ لهُمُ الفِضَّةَ والذَّهبَ والآنيةَ، وهيَ ما قدَّمَهُ لهَيكلِ إلهِنا مَلِكُ الفُرسِ ومُستَشارُوهُ ومُعاونوهُ وجميعُ الّذينَ كانوا هُناكَ مِنْ بَني إِسرائيلَ، <verse eid="EZR 8:25" /><verse number="26" style="v" pubnumber="26" sid="EZR 8:26" />فكانَت مئَةَ قِنْطارِ فِضَّةٍ وأربَعَةَ عَشَرَ قِنطارًا مِنْ أواني الفِضَّةِ وأربَعَةَ عَشَرَ قِنطارًا مِنَ الذَّهبِ، <verse eid="EZR 8:26" /><verse number="27" style="v" pubnumber="27" sid="EZR 8:27" />وعِشرينَ كأسًا مِنَ الذَّهبِ تُساوي ألفَ دِرهَمٍ، وإناءَينِ مِنْ نُحاسٍ أصفَرَ جَيِّدٍ ثَمينٍ كالذَّهبِ. <verse eid="EZR 8:27" /><verse number="28" style="v" pubnumber="28" sid="EZR 8:28" />وقُلتُ لهُم أنتُم مُكرَّسونَ لِلرّبِّ إلهِ آبائِكُم، وكذلِكَ الآنيَةُ والفِضَّةُ والذَّهبُ. <verse eid="EZR 8:28" /><verse number="29" style="v" pubnumber="29" sid="EZR 8:29" />فاَسْهَروا علَيها وصونُوها في غُرَفِ هَيكلِ الرّبِّ، إلى أنْ تَزِنوها قُدَّامَ رؤساءِ الكهَنةِ واللَّاويِّينَ ورُؤساءِ عَشائِرِ بَني إِسرائيلَ في أورُشليمَ، <verse eid="EZR 8:29" /><verse number="30" style="v" pubnumber="30" sid="EZR 8:30" />فأخَذَ الكهَنةُ واللَّاويُّونَ الفِضَّةَ والذَّهبَ والآنيَةَ ليَجيئُوا بها إلى أورُشليمَ إلى هَيكلِ إلهِنا.<verse eid="EZR 8:30" /></para>
  <para style="s1">العودة إلى أورشليم</para>
  <para style="p">
    <verse number="31" style="v" pubnumber="31" sid="EZR 8:31" />ثُمَّ رَحَلْنا مِنْ نَهر أهوا في الثَّاني عشَرَ مِنَ الشَّهرِ الأولِ لنَذْهبَ إلى أورُشليمَ، وكانَت قُدرَةُ إلهِنا معَنا، فأنقَذَنا مِنْ يَدِ العَدُوِّ الكامِنِ في الطَّريقِ. <verse eid="EZR 8:31" /><verse number="32" style="v" pubnumber="32" sid="EZR 8:32" />فوَصَلْنا إلى أورُشليمَ وأقَمْنا هُناكَ ثَلاثَةَ أيّامٍ. <verse eid="EZR 8:32" /><verse number="33" style="v" pubnumber="33" sid="EZR 8:33" />وفي اليومِ الرَّابعِ وُزنَتِ الفِضَّةُ والذَّهبُ والآنيةُ في هَيكلِ إلهِنا على يَدِ مَريموثَ بنِ أُوريَّا الكاهنِ، ومعَهُ ألعازارُ بنُ فينحاسُ، ومعَهُما يوزابادُ بنُ يَشوعَ ونوعَدْيا بنُ بِنُّويَ اللَّاويّانِ، <verse eid="EZR 8:33" /><verse number="34" style="v" pubnumber="34" sid="EZR 8:34" />كُلُّ ذلِكَ بالعَدَدِ والوَزْنِ وسجَّلْتُهُ كُلَّهُ في ذلِكَ الوقتِ. <verse eid="EZR 8:34" /><verse number="35" style="v" pubnumber="35" sid="EZR 8:35" />وقَدَّمَ اليهودُ القادمونَ مِنَ السَّبْي مُحرَقاتٍ لإلهِ إِسرائيلَ اَثْنَي عَشَرَ عِجْلًا عَنْ جميعِ بَني إِسرائيلَ، وسِتَّةً وتِسعينَ كَبْشًا واَثنينِ وسَبعينَ خَروفًا واَثنَي عشَرَ تَيسًا ذبيحةَ خطيئةٍ، وكُلُّ ذلِكَ مُحرَقةٌ لِلرّبِّ. <verse eid="EZR 8:35" /><verse number="36" style="v" pubnumber="36" sid="EZR 8:36" />وسَلَّموا أوامرَ المَلِكِ إلى نُوَّابِ المَلِكِ وحُكَّامِ غربيِّ الفُراتِ، فقَدَّمُوا المَعونةَ لِلشَّعبِ ولِهَيكلِ اللهِ.<verse eid="EZR 8:36" /></para>
  <chapter eid="EZR 8" />
  <chapter number="9" style="c" sid="EZR 9" />
  <para style="s1">الزواج من غير اليهود</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="EZR 9:1" />وبعدَ أنْ تَمَّ هذا كُلُّهُ أقبَلَ بَعضُ أعيانِ الشَّعبِ إليَّ يقولونَ: ”شعبُ إِسرائيلَ والكهَنةُ واللَّاويُّونَ لم يَفصِلوا أنفُسَهُم مِنْ شُعوبِ هذِهِ الأرضِ مِنَ الكنعانيِّينَ والحِثِّيِّينَ والفَرزِّيِّينَ واليَبوسيِّينَ والعَمُّونيِّينَ والموآبيِّينَ والمِصْريِّينَ والأموريِّينَ، فمارَسوا أعمالَهُمُ الرَّجسَةَ <verse eid="EZR 9:1" /><verse number="2" style="v" pubnumber="2" sid="EZR 9:2" />واَتَّخَذوا مِنْ بَناتِهِم زوجاتٍ لهُم ولِبَنيهِم، فاَختلَطَ نَسلُهُمُ الطَّاهِرُ بِتِلكَ الشُّعوبِ، وكانَ أعيانُ الشَّعبِ وحُكَّامُهُ أوَّلَ مَنِ اَرتكَبَ هذِهِ الخِيانَةَ“. <verse eid="EZR 9:2" /><verse number="3" style="v" pubnumber="3" sid="EZR 9:3" />فلمَّا سَمِعْتُ هذا الكلامَ مَزَّقْتُ ثوبي وعَباءَتي ونتَفْتُ شَعرَ رأسي ولِحيتي وقعَدْتُ مُتشائِمًا <verse eid="EZR 9:3" /><verse number="4" style="v" pubnumber="4" sid="EZR 9:4" />إلى أنْ يحينَ وقتُ ذبيحةِ المساءِ. فاَجتمَعَ إليَّ كُلُّ مَنْ فَزِعَ مِنْ كلامِ إلهِ بَني إِسرائيلَ على خيانةِ الّذينَ عادوا مِنَ السَّبْي. <verse eid="EZR 9:4" /><verse number="5" style="v" pubnumber="5" sid="EZR 9:5" />ولمَّا حانَت ذَبيحةُ المساءِ قُمتُ مِنْ مُعاناتي وركعْتُ على رُكبَتَيَّ بِثوبي وعَباءَتي المُمَزَّقَينِ وبسَطْتُ يَدَيَّ إلى الرّبِّ إلهي <verse eid="EZR 9:5" /><verse number="6" style="v" pubnumber="6" sid="EZR 9:6" />وقُلتُ: ”يا اللهُ إلهي، كم أشعُرُ بالخَجلِ والعارِ حينَ أرفَعُ إليكَ وَجهي، لأنَّ ذُنوبَنا وآثامَنا تكاثَرَت واَرْتفَعَت فَوقَ رُؤوسِنا حتّى بَلَغَت أعاليَ السَّماءِ. <verse eid="EZR 9:6" /><verse number="7" style="v" pubnumber="7" sid="EZR 9:7" />فمِنْ أيّامِ آبائِنا إلى هذا اليومِ ونَحنُ نُكثِرُ مِنِ اَرْتكابِ الآثامِ، ولأجلِ هذِهِ الآثامِ أسلَمْتَنا نَحنُ ومُلوكَنا وكهَنَتَنا إلى أيدي مُلوكِ الأرضِ، فكانَ مَصيرُنا السَّيفَ والسَّبْيَ والنَّهْبَ وسوادَ الوجهِ كما في هذا اليومِ. <verse eid="EZR 9:7" /><verse number="8" style="v" pubnumber="8" sid="EZR 9:8" />والآنَ، فَلِمُدَّةٍ قصيرةٍ تَرَأَّفْتَ بِنا، أيُّها الرّبُّ إلهُنا، ونَجَّيتَ بَعضَنا مِنَ العُبوديَّةِ، وأعطَيتَنا مَسكِنًا في مكانِكَ المُقَدَّسِ، حتّى تُنيرَ أبصارَنا وتُعطينَا قليلًا مِنَ الحياةِ في عُبوديَّتِنا. <verse eid="EZR 9:8" /><verse number="9" style="v" pubnumber="9" sid="EZR 9:9" />فما نَحنُ إلَّا عبيدٌ، وفي عُبوديَّتِنا لم تَترُكْنا يا إلهَنا، بل جعَلْتَ مُلوكَ الفُرسِ يَرحَمونَنا ويَمنَحونَنا حياةً حتّى نَبْنيَ هَيكلَكَ ونُرَمِّمَ خَرابَهُ، ونَجِدَ لَنا مَلجأً وأمانًا في يَهوذا وأورُشليمَ.<verse eid="EZR 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="EZR 9:10" />”والآنَ، يا إلهَنا، ماذا نقولُ بعدَ هذا، فنَحنُ أهمَلْنا وصاياكَ <verse eid="EZR 9:10" /><verse number="11" style="v" pubnumber="11" sid="EZR 9:11" />الّتي أمَرْتَ بِها على ألسِنَةِ عبيدِكَ الأنبياءِ فَقُلتَ: الأرضُ الّتي تذهَبونَ إليها لِتَملِكوها هيَ أرضٌ دَنَّسَتْها شُعوبُها ونَجَّسَتْها بِرَجاساتِها الّتي ملأوها بِها مِنْ أقصاها إلى أقصاها. <verse eid="EZR 9:11" /><verse number="12" style="v" pubnumber="12" sid="EZR 9:12" />والآنَ فلا تُعطُوا بَناتِكُم لِبَنيهِم ولا تأْخُذوا بَناتِهِم لِبَنيكُم، ولا تَطلُبوا سِلْمَهُم ولا خَيرَهُم إلى الأبدِ، فيَنقَطعَ نَسلُهُم وتأكُلوا خَيراتِ الأرضِ وتُورِثوها نَسلَكُم مدَى الدَّهرِ. <verse eid="EZR 9:12" /><verse number="13" style="v" pubnumber="13" sid="EZR 9:13" />وبَعدَ كُلِّ ما أصابَنا مِنَ العِقابِ على أعمالِنا السَّيِّئةِ وإثمِنا العظيمِ، معَ أنَّكَ يا إلهَنا عاقَبْتَنا بأقَلَّ مِمَّا تَستَحقُ ذُنوبُنا ونَجَّيتَ هذِهِ البقيَّةَ الباقيةَ مِنَّا، <verse eid="EZR 9:13" /><verse number="14" style="v" pubnumber="14" sid="EZR 9:14" />أفنَعودُ ونُخالِفُ وصاياكَ ونُصاهِرُ أُممًا تَرتكِبُ مِثلَ هذِهِ الرَّجاساتِ؟ أما تغضَبُ علَينا حتّى تُفْنيَنا فلا تَبقَى مِنَّا بَقيَّةٌ ولا يكونُ لنا نَجاةٌ؟ <verse eid="EZR 9:14" /><verse number="15" style="v" pubnumber="15" sid="EZR 9:15" />أيُّها الرّبُّ إله بَني إِسرائيلَ، أنتَ عادلٌ لأنَّكَ نَجَّيتَنا وأبقَيتَنا إلى هذا اليومِ. ها نَحنُ نعتَرِفُ لكَ بِآثامِنا، ولا يَحِقُّ لنا الوقوفُ بَينَ يَدَيكَ“.<verse eid="EZR 9:15" /></para>
  <chapter eid="EZR 9" />
  <chapter number="10" style="c" sid="EZR 10" />
  <para style="s1">توبة بني إسرائيل</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="EZR 10:1" />ولمَّا صَلَّى عَزْرا واَعترَفَ باكيًا وهوَ مُنطَرحٌ قُدَّامَ الهَيكلِ، اَجتمَعَ إليهِ مِنْ إِسرائيلَ جَمعٌ كثيرٌ جِدًّا مِنَ الرِّجالِ والنِّساءِ والأولادِ وهُم يَبكونَ بُكاءً شديدًا. <verse eid="EZR 10:1" /><verse number="2" style="v" pubnumber="2" sid="EZR 10:2" />فقالَ شكَنْيا بنُ يَحيئيلَ مِنْ بَني عيلامَ لِعَزْرا: ”خُنَّا إلهَنا وأخَذنا نِساءً غريباتٍ مِنْ أُمَمِ الأرضِ، ومعَ ذلِكَ فلا يَزالُ الآنَ رَجاءٌ لإسرائيلَ. <verse eid="EZR 10:2" /><verse number="3" style="v" pubnumber="3" sid="EZR 10:3" />لِنَقْطَعِ الآنَ عَهدًا معَ إلهِنا على إخراجِ جميعِ النِّساءِ وأولادِهِنَّ، وَفْقًا لِمَشورَتِكَ يا سيّدي ومَشورَةِ الّذينَ يَحتَرِمونَ وَصيَّةَ إلهِنا، ولنَعمَلْ بِحسَبِ الشَّريعَةِ. <verse eid="EZR 10:3" /><verse number="4" style="v" pubnumber="4" sid="EZR 10:4" />قُمْ، فالأمرُ لكَ ونَحنُ معَكَ. تَشَجَّعْ واَعْمَل“.<verse eid="EZR 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="EZR 10:5" />فقامَ عَزْرا وحَلَّفَ رؤُساءَ الكهَنةِ اللَّاويِّينَ وجميعَ بَني إِسرائيلَ على أنْ يَعمَلوا بِرأي شكَنْيا فحَلَفوا. <verse eid="EZR 10:5" /><verse number="6" style="v" pubnumber="6" sid="EZR 10:6" />ونهَضَ عَزْرا مِنْ أمامِ الهَيكلِ ودخَلَ غُرفةَ يوحانانَ بنِ ألياشيبَ وباتَ ليلتَهُ مِنْ دونِ أنْ يأكُلَ خُبزًا ويشربَ ماءً، لأنَّهُ كانَ يَنوحُ لِخيانةِ الّذينَ عادوا مِنَ السَّبْي. <verse eid="EZR 10:6" /><verse number="7" style="v" pubnumber="7" sid="EZR 10:7" />ثُمَّ أرسَلوا نِداءً في يَهوذا وأورُشليمَ إلى جميعِ المَسْبيِّينَ ليتوافَدوا إلى أورُشليمَ، <verse eid="EZR 10:7" /><verse number="8" style="v" pubnumber="8" sid="EZR 10:8" />حسَبَ مَشورةِ الرُّؤساءِ والشُّيوخِ، وأنَّ كُلَّ مَنْ لا يَجيءُ في ثَلاثةِ أيّامٍ تُحَرَّمُ علَيهِ كُلُّ أموالِهِ ويُعزَلُ عَنِ الجماعةِ.<verse eid="EZR 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="EZR 10:9" />فاَجتمعَ جميعُ رِجالِ يَهوذا وبنيامينَ إلى أورُشليمَ في ثَلاثَةِ أيّامٍ، في العِشرينَ مِنَ الشَّهرِ التَّاسِعِ، وقَعَدوا في ساحةِ الهَيكلِ مُرتَعِدينَ مِنْ خُطورةِ هذا الأمرِ ومِنْ غَزارةِ الأمطارِ. <verse eid="EZR 10:9" /><verse number="10" style="v" pubnumber="10" sid="EZR 10:10" />فقامَ عَزْرا الكاهنُ وقالَ لهُم: ”خُنْتُمُ الرّبَّ واَتَّخَذْتُم نِساءً غريباتٍ لتَزيدوا في إثْمِ بَني إِسرائيلَ. <verse eid="EZR 10:10" /><verse number="11" style="v" pubnumber="11" sid="EZR 10:11" />فاَعتَرِفوا الآنَ لِلرّبِّ إلهِ آبائِكُم واَعمَلوا بِما يُرضيهِ واَعتَزِلوا أُمَمَ الأرضِ والنِّساءَ الغريباتِ“. <verse eid="EZR 10:11" /><verse number="12" style="v" pubnumber="12" sid="EZR 10:12" />فقالتِ الجماعةُ كُلُّها بصوتٍ عظيمٍ: ”نعم، نعمَلُ بِما قُلتَ. <verse eid="EZR 10:12" /><verse number="13" style="v" pubnumber="13" sid="EZR 10:13" />إلَّا أنَّنا جَمعٌ كبيرٌ، والمطَرُ غزيرٌ، فلا قُدْرَةَ لنا أنْ نَقِفَ في الخارِجِ، ثُمَّ إنَّ هذا العمَلَ لا يُعمَلُ في يومٍ أوِ اَثنَينِ، لأنَّ أكثَرَنا خَطِئوا. <verse eid="EZR 10:13" /><verse number="14" style="v" pubnumber="14" sid="EZR 10:14" />فليَقُمْ رُؤساؤُنا مَقامَنا جميعًا في هذا الأمرِ، وكُلُّ مَنِ اَتَّخَذَ اَمرَأةً غريبةً، فليَحضُرْ إلى هُنا في وقتٍ مُعَيَّنٍ ومعَهُ شُيوخُ مدينَتِهِ وقُضاتُها. وبذلِكَ يَصرِفُ إلهُنا غضَبَهُ عنَّا“. <verse eid="EZR 10:14" /><verse number="15" style="v" pubnumber="15" sid="EZR 10:15" />فقامَ يوناثانُ بنُ عسائيلَ ويَحَزْيا بنُ تِقْوَه بِهذِهِ المُهِمَّةِ، وأعانَهُما مَشُلَّامُ وشَبْتايُ اللَّاويُّ.<verse eid="EZR 10:15" /></para>
  <para style="s1">المتزوجون بنساء غريبات</para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="EZR 10:16" />فعَمِلَ العائِدونَ مِنَ السَّبْي بِهذا الرَّأيِ، واَخْتارَ عَزْرا الكاهنُ عددًا مِنْ رؤساءِ العَشائِرِ، وكُلُّهُم مَعروفونَ بأسمائِهِم، وجَلَسوا في اليومِ الأوَّلِ مِنَ الشَّهرِ العاشِرِ لِلبَحثِ في هذا الأمرِ. <verse eid="EZR 10:16" /><verse number="17" style="v" pubnumber="17" sid="EZR 10:17" />وفَرَغوا في اليومِ الأوَّلِ مِنَ الشَّهر الأوَّلِ مِنْ إحصاءِ جميعِ الرِّجالِ الّذينَ اَتَّخَذوا نِساءً غريباتٍ. <verse eid="EZR 10:17" /><verse number="18" style="v" pubnumber="18" sid="EZR 10:18" />فوَجَدوا أنَّ الّذينَ اَتَّخَذوا نِساءً غريباتٍ بَينَ بَني الكهَنةِ هُم مِنْ بَني يَشوعَ بنِ يوصاداقَ وإخوَتِهِ: مَعَسْيا وأليعَزَرُ وياريبُ وجَدْليا، <verse eid="EZR 10:18" /><verse number="19" style="v" pubnumber="19" sid="EZR 10:19" />فأعطى هؤلاءِ كلِمَتَهُم أنْ يُخرِجوا نِساءَهُم مِنْ بُيوتِهِم، وقَدَّمُوا كَبْشًا مِنَ الغنَمِ ذبيحَةً عن إثمِهِم. <verse eid="EZR 10:19" /><verse number="20" style="v" pubnumber="20" sid="EZR 10:20" />ومِنْ بَني إمِّيرَ: حَناني وزَبَدْيا. <verse eid="EZR 10:20" /><verse number="21" style="v" pubnumber="21" sid="EZR 10:21" />ومِنْ بَني حاريمَ: مَعَسْيا وإيليّا وشَمَعْيا ويَحيئيلُ وعُزِّيَّا، <verse eid="EZR 10:21" /><verse number="22" style="v" pubnumber="22" sid="EZR 10:22" />ومِنْ بَني فشحورَ: أليوعينايُ ومَعَسْيا وإسمعيلُ ونَثَنَئيلُ ويوزابادُ وألعاسةُ، <verse eid="EZR 10:22" /><verse number="23" style="v" pubnumber="23" sid="EZR 10:23" />ومِنَ اللَّاويِّينَ: يوزابادُ وشِمْعي وقَلايا، أي قَليطا، وفَتَحْيا ويَهوذا وأليعَزَرُ <verse eid="EZR 10:23" /><verse number="24" style="v" pubnumber="24" sid="EZR 10:24" />ومِنَ المُغَنّينَ ألياشيبُ، ومِنَ البَوّابينَ: شلُّومُ وطالَمُ وأُوري، <verse eid="EZR 10:24" /><verse number="25" style="v" pubnumber="25" sid="EZR 10:25" />ومِنْ إِسرائيلَ مِنْ بَني فرعوشَ: رميا ويَزِّيَّا ومَلْكيَّا وميَّامينُ وألعازَرُ ومَلْكيَّا <verse eid="EZR 10:25" /><verse number="26" style="v" pubnumber="26" sid="EZR 10:26" />ومِنْ بَني عيلامَ: مَتَّنْيا وزكريّا ويَحيئيلُ وعبدي ويَريموثُ وإيليّا، <verse eid="EZR 10:26" /><verse number="27" style="v" pubnumber="27" sid="EZR 10:27" />ومِنْ بَني زتُّو: أليُوعيناي وألياشيبُ ومَتَّنْيا ويَريموثُ وزابادُ وعَزيزا، <verse eid="EZR 10:27" /><verse number="28" style="v" pubnumber="28" sid="EZR 10:28" />ومِنْ بَني بابايَ: يوحانانُ وحَنَنْيا وزبَّايُ وعَثْلايُ، <verse eid="EZR 10:28" /><verse number="29" style="v" pubnumber="29" sid="EZR 10:29" />ومِنْ بَني باني مشُلَّامُ وملُّوخُ وعداياي وياشوبُ وشآلُ وراموثُ. <verse eid="EZR 10:29" /><verse number="30" style="v" pubnumber="30" sid="EZR 10:30" />ومِنْ بَني فَحْثَ موآبَ: عَدْنا وكلالُ وبَنايا ومَعَسْيا ومَتَّنْيا وبَصْلَئيلُ وبِنُّوي ومنَسَّى، <verse eid="EZR 10:30" /><verse number="31" style="v" pubnumber="31" sid="EZR 10:31" />ومِنْ بَني حاريمَ: أليعَزَرُ ويَشِّيَّا ومَلْكيَّا وشَمَعْيا وشِمعونُ <verse eid="EZR 10:31" /><verse number="32" style="v" pubnumber="32" sid="EZR 10:32" />وبنامينُ وملُّوخُ وشمريا، <verse eid="EZR 10:32" /><verse number="33" style="v" pubnumber="33" sid="EZR 10:33" />ومِنْ بَني حشومَ: مَتَّنايُ ومَتَّاثا وزابادُ وأليفلطُ ويَريمايُ ومنَسَّى وشِمْعي، <verse eid="EZR 10:33" /><verse number="34" style="v" pubnumber="34" sid="EZR 10:34" />ومِنْ بَني باني: معدايُ وعُمْرامُ وأوئيلُ <verse eid="EZR 10:34" /><verse number="35" style="v" pubnumber="35" sid="EZR 10:35" />وبَنايا وبيديا وكلوهي <verse eid="EZR 10:35" /><verse number="36" style="v" pubnumber="36" sid="EZR 10:36" />وونيا ومَريموثُ وألياشيبُ <verse eid="EZR 10:36" /><verse number="37" style="v" pubnumber="37" sid="EZR 10:37" />ومَتَّنْيا ومَتَّناي ويَعْسو <verse eid="EZR 10:37" /><verse number="38" style="v" pubnumber="38" sid="EZR 10:38" />وباني وبِنِّوي وشِمْعي <verse eid="EZR 10:38" /><verse number="39" style="v" pubnumber="39" sid="EZR 10:39" />وشَلميا وناثانُ وعَدايا <verse eid="EZR 10:39" /><verse number="40" style="v" pubnumber="40" sid="EZR 10:40" />ومكَنْدبايُ وشاشايُ وشارايُ <verse eid="EZR 10:40" /><verse number="41" style="v" pubnumber="41" sid="EZR 10:41" />وعَيزرئيلُ وشَلَميا وشَمَريا <verse eid="EZR 10:41" /><verse number="42" style="v" pubnumber="42" sid="EZR 10:42" />وشَلُّوم وأمَرْيا ويوسفُ. <verse eid="EZR 10:42" /><verse number="43" style="v" pubnumber="43" sid="EZR 10:43" />ومِنْ بَني نبو: يعيئيلُ ومَتَّثْيا وزابادُ وزبينا ويَدُّو ويوئيلُ وبنايا. <verse eid="EZR 10:43" /><verse number="44" style="v" pubnumber="44" sid="EZR 10:44" />كُلُّ هؤلاءِ اَتَّخذوا نساءً غريباتٍ، ومِنهنَّ مَنْ ولَدْنَ بَنينَ، فطردوهنَّ معَ البَنينَ.<verse eid="EZR 10:44" /></para>
  <chapter eid="EZR 10" />
</usx>