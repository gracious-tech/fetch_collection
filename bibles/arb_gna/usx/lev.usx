  <para style="toc3">لا</para>
  <para style="toc1">اللّاويّين</para>
  <para style="toc2">لاويين</para>
  <para style="mt1">اللّاويّين</para>
  <chapter number="1" style="c" sid="LEV 1" />
  <para style="s1">تقديم المحرقة بكاملها</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="LEV 1:1" />ودعا الرّبُّ موسى وكلَّمَهُ مِنْ خَيمَةِ الاجتِماعِ فقالَ: <verse eid="LEV 1:1" /><verse number="2" style="v" pubnumber="2" sid="LEV 1:2" />”قُلْ لِبني إِسرائيلَ: إذا قرَّبَ أحدٌ مِنكُم قُربانًا لِلرّبِّ مِنَ البَهائِمِ، فَمِنَ البقَرِ والضأنِ يُقرِّبُه. <verse eid="LEV 1:2" /><verse number="3" style="v" pubnumber="3" sid="LEV 1:3" />إنْ كانَ قُربانُه مُحرَقَةً مِنَ البقَرِ، فذَكَرًا صحيحًا يُقرِّبُهُ. يُقدِّمُهُ عِندَ بابِ خَيمةِ الاجتِماعِ ليكونَ مقبولًا أمامَ الرّبِّ. <verse eid="LEV 1:3" /><verse number="4" style="v" pubnumber="4" sid="LEV 1:4" />ويضعُ يدَهُ على رأسِ المُحرَقةِ، فيَقبَلُها الرّبُّ مِنهُ تكفيرًا عَنهُ. <verse eid="LEV 1:4" /><verse number="5" style="v" pubnumber="5" sid="LEV 1:5" />ويذبَحُ العِجْلَ أمامَ الرّبِّ، فيُقرِّبُ بَنو هرونَ الكهَنةُ الدَّمَ ويَرُشُّونَه على أربعةِ جوانِبِ المذبَحِ الّذي عندَ بابِ الخَيمةِ. <verse eid="LEV 1:5" /><verse number="6" style="v" pubnumber="6" sid="LEV 1:6" />ويَسلَخُ الرَّجُلُ المُحرَقَةَ ويُقَطِّعُها قِطَعًا. <verse eid="LEV 1:6" /><verse number="7" style="v" pubnumber="7" sid="LEV 1:7" />ويجعَلُ بَنو هرونَ الكهَنةُ نارًا على المذبحِ ويُرتِّبونَ علَيها حطَبًا، <verse eid="LEV 1:7" /><verse number="8" style="v" pubnumber="8" sid="LEV 1:8" />ويُرتِّبونَ فَوقَ الحطَبِ قِطعَ اللَّحمِ معَ الرَّأسِ والشَّحْمِ. <verse eid="LEV 1:8" /><verse number="9" style="v" pubnumber="9" sid="LEV 1:9" />وأمَّا الأمعاءُ والأكارعُ فيغسِلُها الرَّجُلُ بالماءِ، ويُوقِدُ الكاهنُ هذا كُلَّهُ على المذبحِ مُحرَقَةً وقيدَةً تُرضي رائِحَتُها الرّبَّ.<verse eid="LEV 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="LEV 1:10" />”وإنْ كانَ قُربانُهُ مُحرَقةً مِنَ الضأْنِ أوِ المعَزِ، فذَكرًا صحيحًا يُقَرِّبُهُ. <verse eid="LEV 1:10" /><verse number="11" style="v" pubnumber="11" sid="LEV 1:11" />يذبَحُهُ على جانبِ المذبحِ جِهَةَ الشِّمالِ أمامَ الرّبِّ، فيرُشُّ بَنو هرونَ الكهنَةُ دَمَهُ على أربعةِ جوانبِ المذبحِ. <verse eid="LEV 1:11" /><verse number="12" style="v" pubnumber="12" sid="LEV 1:12" />ويُقطِّعُهُ قِطعًا ويَفصِلُ رأسَهُ وشَحْمَه، فيُرتِّبُها الكاهنُ على حطَبِ نارِ المذبَحِ. <verse eid="LEV 1:12" /><verse number="13" style="v" pubnumber="13" sid="LEV 1:13" />وأمَّا الأمعاءُ والأكارِعُ فيَغسِلُها الرَّجُلُ بالماءِ، ويُوقِدُ الكاهنُ هذا كُلَّه على المذبحِ مُحرَقةً وقيدَةً تُرضي رائِحَتُها الرّبَّ.<verse eid="LEV 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="LEV 1:14" />”وإن كانَ قُربانُهُ للرّبِّ مُحرَقَةً مِنَ الطَّيرِ، فليَكُنْ مِنَ اليَمامِ أو مِنْ فِراخِ الحَمام. <verse eid="LEV 1:14" /><verse number="15" style="v" pubnumber="15" sid="LEV 1:15" />فيُقَرِّبُه الكاهنُ إلى المذبحِ ويَحُزُّ رأسَه، ثُمَّ يوقِدُهُ ويعصِرُ دَمَهُ على حائِطِ المذبَحِ. <verse eid="LEV 1:15" /><verse number="16" style="v" pubnumber="16" sid="LEV 1:16" />ويَنزَعُ الكاهنُ حَوصَلَتَهُ بِما فيها ويطرحُها إلى جانبِ المذبَحِ شرقيَّ موضِعِ الرَّمادِ. <verse eid="LEV 1:16" /><verse number="17" style="v" pubnumber="17" sid="LEV 1:17" />ويخلَعُ جناحَيهِ ولا يفصِلُهُما. ويوقِدُهُ الكاهنُ على حطَبِ نارِ المذبَحِ مُحرَقَةً وقيدَةً تُرضي رائِحَتُها الرّبَّ.<verse eid="LEV 1:17" /></para>
  <chapter eid="LEV 1" />
  <chapter number="2" style="c" sid="LEV 2" />
  <para style="s1">قربان الحنطة</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="LEV 2:1" />”وإذا قرَّبَ أحدٌ قربانَ تقدمةٍ للرّبِّ، فليَكُنْ قُربانُهُ دقيقًا يَصُبُّ علَيهِ زيتًا ويضَعُ لُبانًا. <verse eid="LEV 2:1" /><verse number="2" style="v" pubnumber="2" sid="LEV 2:2" />ويجيءُ بهِ إلى بَني هرونَ الكهَنةِ، فيأخذُ الكاهنُ مِلْءَ قبضَتِهِ عَيِّنَةً مِنَ الدَّقيقِ والزَّيتِ وكُلِّ اللُّبانِ ويوقِدُها على المذبَحِ وقيدَةً تُرضي رائِحَتُها الرّبَّ. وتُذَكِّرُهُ بمقدِّمِها. <verse eid="LEV 2:2" /><verse number="3" style="v" pubnumber="3" sid="LEV 2:3" />وما فضَلَ مِنَ التَّقدِمةِ يكونُ لِهرونَ وبَنيهِ، وهوَ مُقَدَّسٌ كُلَّ التَّقديسِ لأنَّهُ مِنَ الوَقائِدِ المُقَرَّبَةِ للرّبِّ.<verse eid="LEV 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="LEV 2:4" />”وإنْ قرَّبْتَ قُربانَ تَقدِمةٍ مَخبوزًا في تَنُّورٍ، فليَكُنْ أقراصَ فطيرٍ مِنْ دَقيقٍ مَلتوتَةً بِزيتٍ، ورِقاقَ فطيرٍ مَمسوحةً بِزيتٍ. <verse eid="LEV 2:4" /><verse number="5" style="v" pubnumber="5" sid="LEV 2:5" />وإنْ كانَ مَخبوزًا على الصَّاجِ، فليَكُنْ فطيرًا مِنْ دَقيقٍ مَلتوتًا بِزيتٍ، <verse eid="LEV 2:5" /><verse number="6" style="v" pubnumber="6" sid="LEV 2:6" />تَفُتُّهُ فُتاتًا وتَصُبُّ علَيهِ زيتًا فهوَ قُربانُ تَقدِمةٍ. <verse eid="LEV 2:6" /><verse number="7" style="v" pubnumber="7" sid="LEV 2:7" />وإنْ كانَ مَقليًّا، فتعملُهُ دقيقًا بزيتٍ <verse eid="LEV 2:7" /><verse number="8" style="v" pubnumber="8" sid="LEV 2:8" />وتجيءُ بهِ تَقدِمةً إلى الرّبِّ وتُناولُهُ إلى الكاهنِ، فيَقتَرِبُ بهِ إلى المذبَحِ <verse eid="LEV 2:8" /><verse number="9" style="v" pubnumber="9" sid="LEV 2:9" />ويرفَعُ عَيِّنَةً تذكاريَّةً مِنهُ ويوقِدُها على المذبَحِ وقيدَةً تُرضي رائِحَتُها الرّبَّ. <verse eid="LEV 2:9" /><verse number="10" style="v" pubnumber="10" sid="LEV 2:10" />وما فَضَلَ مِنَ التَّقدِمةِ يكونُ لِهرونَ وبَنيهِ، وهوَ مُقَدَّسٌ كُلَّ التَّقديسِ لأنَّهُ مِنَ الوقائِدِ المُقَرَّبَةِ للرّبِّ.<verse eid="LEV 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="LEV 2:11" />”كُلُّ تَقدِمةٍ تُقَرِّبونَها لِلرّبِّ لا تَعجِنوها بِخَميرٍ، لأنَّ الخَميرَ والعسَلَ لا يُوقَدُ مِنهُما وقيدَةٌ للرّبِّ. <verse eid="LEV 2:11" /><verse number="12" style="v" pubnumber="12" sid="LEV 2:12" />تُقَرِّبونَ بَواكيرَهُما قُربانًا للرّبِّ، ولكِنْ إلى المذبَحِ لا تُصعِدوهما، فرائِحَتُهُما لا تُرضي الرّبَّ. <verse eid="LEV 2:12" /><verse number="13" style="v" pubnumber="13" sid="LEV 2:13" />وتُمَلِّحونَ كُلَّ قُربانِ تَقدِمةٍ بالمِلْحِ، لأنَّ المِلْحَ رمزُ العَهدِ بَينَكُم وبَينَ إلهِكُم. فلا تَجعَلوا قَرابينَ التَّقدِمةِ خاليةً مِنَ المِلْحِ، بل قرِّبوا المِلْحَ في جميعِ قرابينِكُم.<verse eid="LEV 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="LEV 2:14" />”وإنْ قرَّبتَ مِنْ بَواكيرِ الغَلَّةِ تَقدِمةً للرّبِّ، فليكُنْ فريكًا مَشوِيًّا بالنَّارِ، جَريشًا مِنَ السُنْبُلِ الطَّريءِ. <verse eid="LEV 2:14" /><verse number="15" style="v" pubnumber="15" sid="LEV 2:15" />وتجعلُ علَيها زيتًا وتضَعُ لُبانًا، فهيَ قربانُ تَقدِمةٍ. <verse eid="LEV 2:15" /><verse number="16" style="v" pubnumber="16" sid="LEV 2:16" />فيُوقِدُ الكاهنُ عَيِّنةً تَذكارِيَّةً مِنْ جَريشِها وزَيتِها معَ جميعِ لُبانِها وقيدةً للرّبِّ.<verse eid="LEV 2:16" /></para>
  <chapter eid="LEV 2" />
  <chapter number="3" style="c" sid="LEV 3" />
  <para style="s1">ذبيحة السلامة</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="LEV 3:1" />”وإنْ كانَ قُربانُ الرَّجُلِ ذبيحةَ سلامةٍ مِنَ البقَرِ ذَكَرًا أو أُنثى، فصحيحًا يُقَرِّبُه أمامَ الرّبِّ. <verse eid="LEV 3:1" /><verse number="2" style="v" pubnumber="2" sid="LEV 3:2" />يضَعُ يدَهُ على رأسِ قُربانِهِ ويذبَحُهُ عِندَ بابِ خَيمةِ الاجتماعِ، فيَرُشُّ بَنو هرونَ الكهَنةُ الدَّمَ على أربعةِ جوانبِ المذبَحِ. <verse eid="LEV 3:2" /><verse number="3" style="v" pubnumber="3" sid="LEV 3:3" />ويُقدِّمُ الرَّجُلُ مِنْ ذبيحةِ السَّلامةِ وقيدةً للرّبِّ ما يُغَطِّي الأمعاءَ وما علَيها مِنَ الشَّحْمِ، <verse eid="LEV 3:3" /><verse number="4" style="v" pubnumber="4" sid="LEV 3:4" />والشَّحْمِ الّذي علَيهما عِندَ الخاصِرتَينِ، والكَبِدِ بَعدَ نَزْعِ زيادتِه مِنَ الكليتَينِ. <verse eid="LEV 3:4" /><verse number="5" style="v" pubnumber="5" sid="LEV 3:5" />فيوقِدُ بَنو هرونَ هذا كُلَّه على المذبَحِ، معَ المُحرَقةِ الّتي فوقَ الحطَبِ الّذي على النَّارِ، وقيدةً تُرضي رائِحَتُها الرّبَّ.<verse eid="LEV 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="LEV 3:6" />”وإنْ كانَ قُربانُه للرّبِّ ذبيحةَ سلامةٍ مِنَ الضأْنِ والمعَزِ ذَكَرًا أو أُنثى، فصحيحًا يُقَرِّبُه. <verse eid="LEV 3:6" /><verse number="7" style="v" pubnumber="7" sid="LEV 3:7" />إنْ كانَ مِنَ الضَأْنِ، فأمامَ الرّبِّ يُقَرِّبُه. <verse eid="LEV 3:7" /><verse number="8" style="v" pubnumber="8" sid="LEV 3:8" />يضَعُ يدَهُ على رأسِ قُربانِهِ ويذبحُهُ أمامَ خَيمةِ الاجتماعِ، فيَرُشُّ بَنو هرونَ دمَهُ على أربعةِ جوانبِ المذبحِ. <verse eid="LEV 3:8" /><verse number="9" style="v" pubnumber="9" sid="LEV 3:9" />ويُقرِّبُ الرَّجُلُ مِنْ ذبيحةِ السَّلامةِ وقيدةً للرّبِّ: شَحْمُها وألْيَتُها كُلُّها مِنْ عِندِ العُصْعُصِ، وما يُغَطِّي الأمعاءَ وما علَيها مِنَ الشَّحْمِ، <verse eid="LEV 3:9" /><verse number="10" style="v" pubnumber="10" sid="LEV 3:10" />والكِلْيتانِ والشَّحْمِ الّذي علَيهما عِندَ الخاصِرتَينِ، والكَبِدِ بَعدَ نَزْعِ زِيادتِهِ معَ الكلْيتَينِ. <verse eid="LEV 3:10" /><verse number="11" style="v" pubnumber="11" sid="LEV 3:11" />ويُوقِدُ الكاهِنُ هذا كُلَّه على المذبحِ طَعامَ وقيدةٍ للرّبِّ.<verse eid="LEV 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="LEV 3:12" />”وإنْ كانَ قُربانُه مِنَ المعَزِ، فأمامَ الرّبِّ يُقَرِّبُه. <verse eid="LEV 3:12" /><verse number="13" style="v" pubnumber="13" sid="LEV 3:13" />يضَعُ يدَهُ على رأسِهِ ويذبَحُهُ أمامَ خَيمةِ الاجتماعِ، فيرُشُّ بَنو هرونَ دَمَهُ على أربعةِ جوانبِ المذبَحِ. <verse eid="LEV 3:13" /><verse number="14" style="v" pubnumber="14" sid="LEV 3:14" />ويُقَرِّبُ الرَّجُلُ مِنهُ قُربانَهُ وقيدةً لِلرّبِّ، مِمَّا يُغطِّي الأمعاءَ وما علَيها مِنَ الشَّحْمِ، <verse eid="LEV 3:14" /><verse number="15" style="v" pubnumber="15" sid="LEV 3:15" />والكلْيتَين والشَّحْمَ الّذي علَيهما عِندَ الخاصرتَينِ، والكَبِدَ بَعدَ نَزْعِ زيادتِهِ معَ الكلْيتَينِ. <verse eid="LEV 3:15" /><verse number="16" style="v" pubnumber="16" sid="LEV 3:16" />ويُوقِدُ الكاهِنُ هذا كُلَّه على المذبَحِ طَعامَ وقيدةٍ تُرضي رائِحَتُها الرّبَّ. كُلُّ شَحْمٍ هوَ للرّبِّ. <verse eid="LEV 3:16" /><verse number="17" style="v" pubnumber="17" sid="LEV 3:17" />هذِهِ فريضةٌ أبديَّةٌ مدَى أجيالِكُم في جميعِ دِيارِكُم. لا تأكلوا شَحْمًا ولا دَمًا“.<verse eid="LEV 3:17" /></para>
  <chapter eid="LEV 3" />
  <chapter number="4" style="c" sid="LEV 4" />
  <para style="s1">ذبيحة الخطيئة سهوًا</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="LEV 4:1" />وكلَّمَ الرّبُّ موسى فقالَ: <verse eid="LEV 4:1" /><verse number="2" style="v" pubnumber="2" sid="LEV 4:2" />”قُلْ لِبَني إِسرائيلَ: إنْ خَطِئَ أحدٌ سَهوًا في شيءٍ أو بَعضِهِ مِمَّا نَهى الرّبُّ عَنْ فِعلِهِ، <verse eid="LEV 4:2" /><verse number="3" style="v" pubnumber="3" sid="LEV 4:3" />فإنْ كانَ كاهنًا مَمسوحًا خَطِئَ الشَّعبُ بِسبَبِهِ فعلَيهِ أنْ يُقرِّبَ عَنْ خَطيئتِهِ التي اَرْتَكَبَها عِجْلًا مِنَ البقَرِ صحيحًا ذبيحةَ خطيئةٍ للرّبِّ. <verse eid="LEV 4:3" /><verse number="4" style="v" pubnumber="4" sid="LEV 4:4" />يجيءُ بالعِجْلِ إلى بابِ خَيمةِ الاجتِماعِ ويضَعُ يدَهُ على رأسِهِ ويذبَحُهُ أمامَ الرّبِّ. <verse eid="LEV 4:4" /><verse number="5" style="v" pubnumber="5" sid="LEV 4:5" />ويأخُذُ مِنْ دَمِ العِجْلِ ويدخُلُ بِهِ خَيمةَ الاجتماعِ، <verse eid="LEV 4:5" /><verse number="6" style="v" pubnumber="6" sid="LEV 4:6" />فيَغمِسُ إصبَعَهُ فيهِ ويَرُشُّ مِنهُ سَبْعَ مرَّاتٍ أمامَ الرّبِّ تِجاهَ حجابِ القُدسِ. <verse eid="LEV 4:6" /><verse number="7" style="v" pubnumber="7" sid="LEV 4:7" />ويضَعُ مِنَ الدَّمِ على قرونِ مذبحِ البَخورِ العَطِر الّذي في خَيمةِ الاجتِماعِ أمامَ الرّبِّ، وسائِرُ دَمِ العِجْلِ يسكُبُهُ عِندَ قاعدةِ مذبَحِ المُحرِقَةِ الّذي عِندَ بابِ خَيمةِ الاجتِماعِ. <verse eid="LEV 4:7" /><verse number="8" style="v" pubnumber="8" sid="LEV 4:8" />وينزعُ مِنَ العِجْل جميعَ شَحْمِهِ، مِمَّا يُغطِّي الأمعاءَ وما علَيها، <verse eid="LEV 4:8" /><verse number="9" style="v" pubnumber="9" sid="LEV 4:9" />والكليتَينِ والشَّحْمَ الّذي علَيهما عِندَ الخاصرتَينِ، والكَبِدَ بَعدَ نَزْعِ زيادتِهِ معَ الكليتَينِ، <verse eid="LEV 4:9" /><verse number="10" style="v" pubnumber="10" sid="LEV 4:10" />كما تُنزَعُ مِنْ ثورِ ذبيحةِ السَّلامةِ. ويوقِدُ الكاهنُ هذا كُلَّه على مذبحِ المُحرقةِ. <verse eid="LEV 4:10" /><verse number="11" style="v" pubnumber="11" sid="LEV 4:11" />وأمَّا جِلْدُ العِجْلِ وجميعُ لَحمِه معَ رأسهِ وأكارِعهِ وأمعائِهِ ومَصارينِهِ، <verse eid="LEV 4:11" /><verse number="12" style="v" pubnumber="12" sid="LEV 4:12" />فيُخرِجُها إلى خارجِ المَحلَّةِ، إلى موضِعٍ نظيفٍ حيثُ يُطرَحُ الرَّمادُ، ويحرقُها على حطَبٍ بالنَّار.<verse eid="LEV 4:12" /></para>
  <para style="s1">ذبيحة الجماعة</para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="LEV 4:13" />”وإنْ خَطِئَت جماعةُ بَني إِسرائيلَ كُلُّها سَهوًا وعمِلوا أيَّةَ واحدةٍ مِمَّا نَهى الرّبُّ عَنْ فِعلِهِ وأثِموا، <verse eid="LEV 4:13" /><verse number="14" style="v" pubnumber="14" sid="LEV 4:14" />ثُمَّ عُرِفَتِ الخطيئةُ الّتي اَرْتَكَبُوها، فَعلَيهِم أنْ يُقَرِّبوا للرّبِّ عِجْلًا مِنَ البقَرِ ذبيحةَ خطيئةٍ. يُحضِرونَه أمامَ خَيمةِ الاجتِماعِ. <verse eid="LEV 4:14" /><verse number="15" style="v" pubnumber="15" sid="LEV 4:15" />فيضَعُ شُيوخُ الجماعةِ أيديَهم على رأسِ العِجْلِ أمامَ الرّبِّ ويذبحونَه. <verse eid="LEV 4:15" /><verse number="16" style="v" pubnumber="16" sid="LEV 4:16" />ويأخذُ الكاهنُ المَمسوحُ مِنْ دَمِ العِجْلِ إلى خَيمةِ الاجتِماعِ، <verse eid="LEV 4:16" /><verse number="17" style="v" pubnumber="17" sid="LEV 4:17" />فيَغمسُ إصبعَهُ فيهِ ويرشُّ مِنهُ سَبْعَ مرَّاتٍ أمامَ الرّبِّ تُجاهَ الحِجابِ. <verse eid="LEV 4:17" /><verse number="18" style="v" pubnumber="18" sid="LEV 4:18" />ويضَعُ مِنهُ على قرونِ المذبحِ الّذي أمامَ الرّبِّ في خَيمةِ الاجتماعِ، وسائرُ الدَّمِ يسكُبُه عِندَ قاعدةِ مذبحِ المُحرقةِ الّذي عندَ بابِ الخَيمةِ <verse eid="LEV 4:18" /><verse number="19" style="v" pubnumber="19" sid="LEV 4:19" />وينزعُ جميعَ شَحْمِهِ مِنهُ ويُوقِدُه على المذبَحِ، <verse eid="LEV 4:19" /><verse number="20" style="v" pubnumber="20" sid="LEV 4:20" />ويفعَلُ بهِ كما فعَلَ بعجْلِ ذبيحةِ الخطيئةِ. ويُكفِّرُ عنهُمُ الكاهنُ، فيسامحُهُمُ الرّبُّ. <verse eid="LEV 4:20" /><verse number="21" style="v" pubnumber="21" sid="LEV 4:21" />ويخرِجُ الكاهنُ العِجْلَ إلى خارجِ المحَلَّةِ ويحرقُهُ كما أحرقَ العِجْلَ الأوَّلَ. هوَ ذبيحةُ تكفيرٍ عَنْ خطيئةِ الجماعةِ.<verse eid="LEV 4:21" /></para>
  <para style="s1">ذبيحة الرئيس</para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="LEV 4:22" />”وإنْ خَطِئَ رئيسٌ وعمِلَ سَهوًا أيَّةَ واحدةٍ مِمَّا نَهى الرّبُّ عَنْ فِعلِه وأثِمَ، <verse eid="LEV 4:22" /><verse number="23" style="v" pubnumber="23" sid="LEV 4:23" />ثُمَّ جاءَ مَنْ يُنَبِّهُهُ على خطيئتِهِ الّتي اَرْتَكبها، فعلَيهِ أنْ يجيءَ بقربانِهِ تَيسًا مِنَ المعَزِ ذَكَرًا صحيحًا. <verse eid="LEV 4:23" /><verse number="24" style="v" pubnumber="24" sid="LEV 4:24" />يضَعُ يدَهُ على رأسِهِ ويذبَحُهُ في موضِعِ ذَبْحِ المُحرَقةِ أمامَ الرّبِّ هوَ ذبيحةُ خطيئةٍ. <verse eid="LEV 4:24" /><verse number="25" style="v" pubnumber="25" sid="LEV 4:25" />فيأخذُ الكاهنُ مِنْ دَمِ الذَّبيحةِ هذه بإصبعِهِ ويضَعُ على قرونِ مذبحِ المُحرَقةِ، ويَصُبُّ الدَّمَ عِندَ قاعدةِ المذبَحِ. <verse eid="LEV 4:25" /><verse number="26" style="v" pubnumber="26" sid="LEV 4:26" />ويوقِدُ جميعَ شَحْمِهِ على المذبَحِ، كما يفعَلُ بشَحْمِ ذبيحةِ السَّلامةِ. ويُكَفِّرُ عَنهُ الكاهنُ خطيئتَهُ فيُسامِحُهُ الرّبُّ.<verse eid="LEV 4:26" /></para>
  <para style="s1">ذبيحة العامة من الناس</para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="LEV 4:27" />”وإنْ خَطِئَ أحدٌ مِنْ عامَّةِ النَّاسِ سَهوًا وعمِلَ واحدةً مِمَّا نَهى الرّبُّ عَنْ فِعلِهِ وأثِمَ، <verse eid="LEV 4:27" /><verse number="28" style="v" pubnumber="28" sid="LEV 4:28" />ثُمَّ جاءَ مَنْ نَبَّهَهُ على خطيئتِهِ الّتي اَرْتَكبها، فليَجِئْ بِقُربانِهِ عَنْزًا مِنَ المعَزِ صحيحةً. <verse eid="LEV 4:28" /><verse number="29" style="v" pubnumber="29" sid="LEV 4:29" />يضَعُ يدَهُ على رأسِها ويذبَحُها ذبيحةَ خطيئةٍ في موضِعِ المُحرَقةِ. <verse eid="LEV 4:29" /><verse number="30" style="v" pubnumber="30" sid="LEV 4:30" />فيأخُذُ الكاهنُ مِنْ دَمِها بإصبعِهِ ويضَعُ على قرونِ مذبَحِ المُحرَقةِ، وسائرُ دَمِها يسكبُهُ عِندَ قاعدةِ المذبَحِ. <verse eid="LEV 4:30" /><verse number="31" style="v" pubnumber="31" sid="LEV 4:31" />وينزعُ جميعَ شَحْمِها، كما ينزعُ الشَّحْمَ مِنْ ذبيحةِ السَّلامةِ، ويوقِدُهُ على المذبَحِ رائحةَ رضًى للرّبِّ. ويُكَفِّرُ عَنهُ الكاهنُ خطيئتَهُ فيسامِحُهُ الرّبُّ. <verse eid="LEV 4:31" /><verse number="32" style="v" pubnumber="32" sid="LEV 4:32" />وإنْ هوَ جاءَ بقربانِهِ مِنَ الضأْنِ ذبيحةَ خطيئةٍ، فلتكنْ أنثى صحيحةً. <verse eid="LEV 4:32" /><verse number="33" style="v" pubnumber="33" sid="LEV 4:33" />يضَعُ يدَهُ على رأسِها ويذبحُها ذبيحةَ خطيئةٍ في موضِعِ ذبْحِ المُحرَقةِ. <verse eid="LEV 4:33" /><verse number="34" style="v" pubnumber="34" sid="LEV 4:34" />فيأخذُ الكاهنُ مِنْ دَمِ الذَّبيحةِ هذِهِ بإصبَعِهِ ويرُشُّ على قرونِ مذبَحِ المُحرَقةِ، وسائرُ الدَّمِ يسكبُهُ عِندَ قاعدةِ المذبَحِ. <verse eid="LEV 4:34" /><verse number="35" style="v" pubnumber="35" sid="LEV 4:35" />وجميعُ شَحْمها ينزعُهُ، كما ينزعُ شَحْمَ ضأْنِ ذبيحةِ السَّلامةِ، ويوقِدُهُ على المذبَحِ معَ وقائدِ الرّبِّ، ويُكَفِّرُ عَنهُ الكاهنُ خطيئتَهُ فيسامِحُهُ الرّبُّ.<verse eid="LEV 4:35" /></para>
  <chapter eid="LEV 4" />
  <chapter number="5" style="c" sid="LEV 5" />
  <para style="s1">ذبيحة الخطيئة أيضًا</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="LEV 5:1" />”وإذا خَطِئَ أحدٌ بأنْ سَمِعَ صوتَ الدَّعوةِ إلى الشَّهادةِ في قضيَّةٍ رآها أو عَلِمَ بها ولم يُخبِرْ بذلِكَ، تحَمَّلَ عاقِبةَ إثمِهِ. <verse eid="LEV 5:1" /><verse number="2" style="v" pubnumber="2" sid="LEV 5:2" />أو إذا مَسَّ شيئًا نَجِسًا مِنْ جيفَةِ وَحشٍ نَجِسٍ، أو بَهيمةٍ نَجِسةٍ، أو زحَّافٍ نَجِسٍ، وخَفِيَ علَيه ذلِكَ. فهوَ نَجِسٌ وآثِمٌ. <verse eid="LEV 5:2" /><verse number="3" style="v" pubnumber="3" sid="LEV 5:3" />أو إذا مسَّ نجاسةَ إنسانٍ، أيَّةً كانت نجاسَتُهُ، وخَفِيَ علَيه ذلِكَ ثُمَّ عرَفَ، فهوَ آثِمٌ. <verse eid="LEV 5:3" /><verse number="4" style="v" pubnumber="4" sid="LEV 5:4" />أو إذا حلَفَ مِنْ غيرِ رَويَّةٍ، فأحْسَنَ أو أساءَ، أيَّةً كانتِ اليمينُ الّتي حلَفَها، وخَفِيَ علَيهِ ذلِكَ ثُمَّ عرَفَ، فهوَ آثِمٌ في حالَتَي الإساءَةِ والإحسانِ.<verse eid="LEV 5:4" /></para>
  <para style="s1">ذبيحة الفقراء</para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="LEV 5:5" />”فعلى كُلِّ مَنْ خَطِئَ في أيِّ شيءٍ مِنْ ذلِكَ أنْ يعترِفَ بِخَطيئتهِ <verse eid="LEV 5:5" /><verse number="6" style="v" pubnumber="6" sid="LEV 5:6" />ويجيءَ بِذبيحةِ خطيئةٍ للرّبِّ نعجةً مِنَ الغنَمِ أو عَنْزًا مِنَ المعَزِ، فَيُكفِّرُ الكاهنُ عَنْ خطيئتِهِ. <verse eid="LEV 5:6" /><verse number="7" style="v" pubnumber="7" sid="LEV 5:7" />فإنْ كانَ غيرَ قادرٍ أنْ يُقدِّمَ نعجةً أو عَنْزًا، يجيءُ بيمامتَينِ أو فَرخَي حمامٍ للرّبِّ، أحدُهُما ذبيحَةُ خطيئةٍ والآخرُ مُحرَقةٌ. <verse eid="LEV 5:7" /><verse number="8" style="v" pubnumber="8" sid="LEV 5:8" />يجيءُ بِهِما إلى الكاهنِ، فَيُقَرِّبُ ذبيحةَ الخطيئةِ أوَّلًا. يَحُزُّ رأسَها مِنَ الرَّقَبَةِ ولا يَفصِلُهُ. <verse eid="LEV 5:8" /><verse number="9" style="v" pubnumber="9" sid="LEV 5:9" />يَرُشُّ مِنْ دَمِ الذَّبيحةِ هذِهِ على حائطِ المذبَحِ، وما فضَلَ مِنَ الدَّمِ يعصِرُهُ على قاعدةِ المذبحِ. هيَ ذبيحةُ خطيئةٍ. <verse eid="LEV 5:9" /><verse number="10" style="v" pubnumber="10" sid="LEV 5:10" />والذَّبيحةُ الثَّانيةُ يحرقُها كالعادةِ، فيُكفِّرُ الكاهنُ عنهُ خطيئتَهُ فيُسامِحُهُ الرّبُّ. <verse eid="LEV 5:10" /><verse number="11" style="v" pubnumber="11" sid="LEV 5:11" />فإنْ كانَ غيرَ قادرٍ أنْ يُقدِّمَ يمامتَينِ أو فرخَي حمامٍ، فعلَيهِ أنْ يُقَرِّبَ عَنْ خطيئتِهِ الّتي اَرْتَكبها عُشْرَ قُفَّةٍ مِنَ الدَّقيقِ لا يَصُبُّ علَيهِ زيتًا ولا يضَعُ علَيهِ لُبانًا، لأنَّه ذبيحةُ خطيئةٍ. <verse eid="LEV 5:11" /><verse number="12" style="v" pubnumber="12" sid="LEV 5:12" />يجيءُ بهِ إلى الكاهنِ، فيأخذُ الكاهنُ مِلْءَ قبضتِهِ عَيِّنَةً مِنهُ ويوقِدُها على المذبَحِ معَ وقائِد الرّبِّ. هوَ ذبيحةُ خطيئةٍ. <verse eid="LEV 5:12" /><verse number="13" style="v" pubnumber="13" sid="LEV 5:13" />فيُكَفِّرُ عَنهُ الكاهنُ خطيئَتَهُ الّتي اَرْتَكَبَها بشيءٍ مِنَ الدَّقيقِ، والباقي يكونُ للكاهنِ كما في قربانِ التَّقدمةِ“.<verse eid="LEV 5:13" /></para>
  <para style="s1">ذبيحة التكفير</para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="LEV 5:14" />وكلَّمَ الرّبُّ موسى فقالَ: <verse eid="LEV 5:14" /><verse number="15" style="v" pubnumber="15" sid="LEV 5:15" />”إنِ اَحْتالَ أحدٌ اَحْتيالًا وخَطِئَ سَهوًا، فأهمَلَ شيئًا مِمَّا قدَّسَهُ مِنْ قرابينِهِ للرّبِّ، فعلَيهِ أنْ يجيءَ بذبيحةِ إثْمِهِ إلى الرّبِّ كَبْشًا صحيحًا مِنَ الضأْنِ تُقدِّرهُ بِمثاقيلَ مِنْ فِضَّةٍ بِحسَبِ السِّعرِ الرَّسميِّ. <verse eid="LEV 5:15" /><verse number="16" style="v" pubnumber="16" sid="LEV 5:16" />فيُسَلِّمُهُ تكفيرًا عمَّا خَطِئَ فيهِ، ويَزيدُ علَيهِ خُمْسَهُ، ويدفَعُهُ إلى الكاهنِ فَيُكَفِّرُ الكاهنُ عنهُ بِكَبْشٍ ذبيحةَ الإثمِ فيُسامِحُهُ الرّبُّ.<verse eid="LEV 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="LEV 5:17" />”وإنْ خَطِئَ أحدٌ ففعَلَ شيئًا مِمَّا نَهى الرّبُّ عَنْ فِعلِه وما عَلِمَ بأنَّهُ خَطِئَ، تَحمَّلَ عاقِبةَ إثْمِهِ. <verse eid="LEV 5:17" /><verse number="18" style="v" pubnumber="18" sid="LEV 5:18" />فيجيءُ إلى الكاهنِ بِكَبْشٍ صحيحٍ مِنَ الضأْنِ تُقَوِّمُهُ بِمِقدارِ قيمةِ ذبيحةِ الإثْمِ، فيُكفِّرُ عَنهُ الكاهنُ سهوتَهُ الّتي سَها وما عَلِمَ بها، فيُسامِحُهُ الرّبُّ. <verse eid="LEV 5:18" /><verse number="19" style="v" pubnumber="19" sid="LEV 5:19" />هوَ ذبيحةُ إثْمٍ، لأنَّ الرَّجُلَ أثِمَ إلى الرّبِّ“.<verse eid="LEV 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="LEV 5:20" />وكلَّمَ الرّبُّ موسى فقالَ: <verse eid="LEV 5:20" /><verse number="21" style="v" pubnumber="21" sid="LEV 5:21" />”إنْ خَطِئَ أحدٌ وغدرَ بالرّبِّ، فأنكرَ على أحدٍ مِنْ قومِهِ وديعةً أو أمانةً، أو سَلَبَهُ، أوِ اَغْتَصَبَ مِنهُ شيئًا، <verse eid="LEV 5:21" /><verse number="22" style="v" pubnumber="22" sid="LEV 5:22" />أو وجَدَ ما كانَ ضائِعًا فأنكرَهُ، وحلَفَ كاذِبًا على كُلِّ هذا وعلى سِواهُ مِمَّا يفعَلُهُ فيَخْطَأُ بهِ، <verse eid="LEV 5:22" /><verse number="23" style="v" pubnumber="23" sid="LEV 5:23" />فليَرُدَّ ما سَلَبَهُ أوِ اَغْتَصَبَهُ أو أودعَ عِندَه أو وجَدَهُ <verse eid="LEV 5:23" /><verse number="24" style="v" pubnumber="24" sid="LEV 5:24" />أو كُلَّ ما حلَفَ علَيهِ كاذِبًا. يُسلِّمُهُ هوَ بِعَينِهِ، ويَزيدُ علَيهِ خُمْسَهُ ويدفَعُهُ إلى صاحِبِه في يومِ تقريبِ ذبيحةِ إثْمهِ للرّبِّ، <verse eid="LEV 5:24" /><verse number="25" style="v" pubnumber="25" sid="LEV 5:25" />فيجيءُ إلى الكاهنِ بالذَّبيحةِ كَبْشًا صحيحًا مِنَ الغنَمِ تُقَدِّرُهُ بمقدارِ قيمةِ ذبيحةِ الإثْمِ. <verse eid="LEV 5:25" /><verse number="26" style="v" pubnumber="26" sid="LEV 5:26" />فَيُكَفِّرُ عَنهُ الكاهنُ أمامَ الرّبِّ، فيُسامِحُ الرّبُّ جميعَ ما فعَلَهُ مِنْ إثْمٍ“.<verse eid="LEV 5:26" /></para>
  <chapter eid="LEV 5" />
  <chapter number="6" style="c" sid="LEV 6" />
  <para style="s1">حرق الذبيحة بأكملها</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="LEV 6:1" />وكلَّمَ الرّبُّ موسى فقالَ: <verse eid="LEV 6:1" /><verse number="2" style="v" pubnumber="2" sid="LEV 6:2" />”قُلْ لِهرونَ وبَنيهِ هذِهِ شريعَةُ المُحرَقةِ: تكونُ المُحرَقةُ على موقِدَةِ المذبَحِ طُولَ اللَّيلِ إلى الصَّباحِ، ونارُ المذبَحِ مُتَّقِدَةٌ علَيهِ. <verse eid="LEV 6:2" /><verse number="3" style="v" pubnumber="3" sid="LEV 6:3" />ويلبَسُ الكاهنُ قميصًا وسِروالًا مِنَ الكَتَّانِ على بدَنِهِ، ويرفَعُ رمادَ نارِ المُحرَقةِ على المذبَحِ ويضَعُهُ إلى جانبِ المذبَحِ. <verse eid="LEV 6:3" /><verse number="4" style="v" pubnumber="4" sid="LEV 6:4" />ثُمَّ يخلَعُ ثيابَهُ ويلبَسُ ثيابًا غيرَها ويُخرِجُ الرَّمادَ إلى خارجِ المحلَّةِ، إلى موضِعٍ بِحسَبِ الشَّريعةِ. <verse eid="LEV 6:4" /><verse number="5" style="v" pubnumber="5" sid="LEV 6:5" />وتبقى النَّارُ على المذبَحِ مُتَّقِدَةً لا تُطفَأُ، ويضَعُ علَيها الكاهنُ حطَبًا في كُلِّ صباحٍ، ويُرتِّبُ علَيها المُحرَقةَ ويوقِدُ شُحومَ ذبائِحِ السَّلامةِ. <verse eid="LEV 6:5" /><verse number="6" style="v" pubnumber="6" sid="LEV 6:6" />تبقى النَّارُ مُتَّقِدَةً دائمًا على المذبَحِ لا تُطفَأُ.<verse eid="LEV 6:6" /></para>
  <para style="s1">شريعة التقدمة</para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="LEV 6:7" />”وهذِهِ شريعةُ التَّقدِمةِ يُقَرِّبُها بَنو هرونَ بينَ يدَيِّ الرّبِّ أمامَ المذبَحِ: <verse eid="LEV 6:7" /><verse number="8" style="v" pubnumber="8" sid="LEV 6:8" />يأخذُ مِلْءَ قبضتِهِ مِنْ دقيقِها وزيتِها وجميعِ اللُّبانِ الّذي علَيها ويوقِدُهُ على المذبَحِ عَيِّنَةً تَذكاريَّةً تُرضي رائحَتُها الرّبَّ، <verse eid="LEV 6:8" /><verse number="9" style="v" pubnumber="9" sid="LEV 6:9" />وما فضَلَ منهُ يأكلُهُ هرونُ وبَنوهُ فطيرًا في موضِعٍ مُقدَّسٍ، في رواقِ خَيمةِ الاجتِماعِ. <verse eid="LEV 6:9" /><verse number="10" style="v" pubnumber="10" sid="LEV 6:10" />لا يخبِزونَهُ خَميرًا، لأنِّي جعَلْتُه نصيبَهم مِنْ وقائدي. هوَ قُربانٌ مُقَدَّسٌ كُلَّ التَّقديسِ، كذبيحَتَي الخطيئةِ والإثْمِ. <verse eid="LEV 6:10" /><verse number="11" style="v" pubnumber="11" sid="LEV 6:11" />كُلُّ ذَكَرٍ مِنْ بَني هرونَ يأكلُ مِنهُ. هذِهِ فريضةٌ أبديَّةٌ مدَى أجيالِكُم لِوَقائدِ الرّبِّ. كُلُّ مَنْ مَسَّها يكونُ مُقَدَّسًا“.<verse eid="LEV 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="LEV 6:12" />وكلَّمَ الرّبُّ موسى فقالَ: <verse eid="LEV 6:12" /><verse number="13" style="v" pubnumber="13" sid="LEV 6:13" />”وهذِهِ شريعةُ القربانِ الّذي يُقَرِّبُهُ هرونُ وبَنوهُ مِنْ بَعدِهِ للرّبِّ يومَ مَسْحِهِ كاهنًا: عُشْرُ قُفَّةٍ مِنَ الدَّقيقِ تقدِمةً دائمةً نِصفُها صباحًا ونِصفُها عِندَ الغروبِ. <verse eid="LEV 6:13" /><verse number="14" style="v" pubnumber="14" sid="LEV 6:14" />تُخبَزُ بزيتٍ على صاجٍ، ويُؤتَى بها مدلوكَةً ومفتوتَةً وتُقَرَّبُ تقدِمةً تُرضي رائِحَتُها الرّبَّ. <verse eid="LEV 6:14" /><verse number="15" style="v" pubnumber="15" sid="LEV 6:15" />والكاهنُ المَمسوحُ مِنْ بَنيهِ بَعدَه يُقرِّبُ هذِهِ التَّقدمةَ للرّبِّ فريضةً أبديَّةً توقَدُ بأكملِها <verse eid="LEV 6:15" /><verse number="16" style="v" pubnumber="16" sid="LEV 6:16" />وكُلُّ تقدمةٍ يُقرِّبُها كاهنٌ بأكملِها ولا تُؤكَلُ“.<verse eid="LEV 6:16" /></para>
  <para style="s1">تقدمة للحصول على الغفران</para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="LEV 6:17" />وكلَّمَ الرّبُّ موسى فقالَ: <verse eid="LEV 6:17" /><verse number="18" style="v" pubnumber="18" sid="LEV 6:18" />”قُلْ لِهرونَ وبَنيهِ: هذِهِ شريعةُ ذبيحةِ الخطيئةِ: في الموضِعِ الّذي فيهِ تُذبَحُ المُحرَقةُ تُذبَحُ ذبيحةُ الخطيئةِ أمامَ الرّبِّ. هيَ قُربانٌ مُقَدَّسٌ كُلَّ التَّقديسِ. <verse eid="LEV 6:18" /><verse number="19" style="v" pubnumber="19" sid="LEV 6:19" />والكاهنُ الّذي يُقَرِّبُها هوَ يأكُلُها في موضِعٍ مُقَدَّسٍ في رِواقِ خَيمةِ الاجتِماعِ. <verse eid="LEV 6:19" /><verse number="20" style="v" pubnumber="20" sid="LEV 6:20" />كُلُّ مَنْ مَسَّ لَحمَها يكونُ مُقَدَّسًا. وإذا وقَعَ مِنْ دَمِها على ثوبٍ، يُغسَلُ الثَّوبُ في موضِعٍ مُقدَّسٍ. <verse eid="LEV 6:20" /><verse number="21" style="v" pubnumber="21" sid="LEV 6:21" />ووِعاءُ الخَزَفِ الّذي تُطبَخُ الذَّبيحةُ فيهِ يُكسَرُ. فإنْ طُبِخت في وِعاءٍ مِنْ نُحاسٍ، يُجلَى ويُشطَفُ بالماءِ. <verse eid="LEV 6:21" /><verse number="22" style="v" pubnumber="22" sid="LEV 6:22" />كُلُّ ذَكَرٍ مِنَ الكهنَةِ يأكلُ مِنها. هيَ قُربانٌ مُقَدَّسٌ كُلَّ التَّقديسِ. <verse eid="LEV 6:22" /><verse number="23" style="v" pubnumber="23" sid="LEV 6:23" />وكُلُّ ذبيحةٍ يُؤخَذُ مِنْ دَمِها للتكفيرِ عنِ الخطيئةِ في قُدْسِ خَيمةِ الاجتِماعِ لا تُؤكَلُ، بل تُحرَقُ بالنَّارِ.<verse eid="LEV 6:23" /></para>
  <chapter eid="LEV 6" />
  <chapter number="7" style="c" sid="LEV 7" />
  <para style="s1">شريعة ذبيحة الإثم</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="LEV 7:1" />”وهذِهِ شريعةُ ذبيحةِ الإثْمِ، وهيَ قُربانٌ مُقَدَّسٌ كُلَّ التَّقديسِ: <verse eid="LEV 7:1" /><verse number="2" style="v" pubnumber="2" sid="LEV 7:2" />في موضِعِ ذَبْحِ المُحرَقةِ يذبَحُ الكاهنُ ذبيحةَ الإثْمِ ويَرُشُّ دَمَها على أربعَةِ جوانبِ المذبَحِ. <verse eid="LEV 7:2" /><verse number="3" style="v" pubnumber="3" sid="LEV 7:3" />ويُقَرِّبُ مِنها جميعَ شَحْمِها: الألْيَةَ والشَّحْمَ الّذي يُغَطِّي الأمعاءَ، <verse eid="LEV 7:3" /><verse number="4" style="v" pubnumber="4" sid="LEV 7:4" />والكلْيتَينِ والشَّحْمَ الّذي علَيهما عِندَ الخاصِرتَينِ، والكَبِدَ بَعدَ نَزْعِ زيادَتِهِ معَ الكلْيتَينِ. <verse eid="LEV 7:4" /><verse number="5" style="v" pubnumber="5" sid="LEV 7:5" />ويُوقِدُ الكاهنُ الذَّبيحةَ على المذبَحِ وقيدةً للرّبِّ. هيَ ذبيحةُ إثْمٍ. <verse eid="LEV 7:5" /><verse number="6" style="v" pubnumber="6" sid="LEV 7:6" />كُلُّ ذَكَرٍ مِنَ الكهَنةِ يأكُلُ مِنها في موضِعٍ مُقَدَّسٍ هيَ قُربانٌ مُقَدَّسٌ كُلَّ التَّقديس.<verse eid="LEV 7:6" /></para>
  <para style="s1">نصيب الكاهن</para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="LEV 7:7" />”لِذبيحةِ الإثْمِ وذبيحةِ الخطيئةِ شريعةٌ واحدةٌ، والكاهنُ الّذي يُكَفِّرُ بها تكونُ مِنْ نَصيبهِ. <verse eid="LEV 7:7" /><verse number="8" style="v" pubnumber="8" sid="LEV 7:8" />والكاهنُ الّذي يُقَرِّبُ مُحرَقةَ أحدٍ مِنَ النَّاسِ، يكونُ جِلْدُها مِنْ نَصيبِهِ بَعدَ تَقريبِها. <verse eid="LEV 7:8" /><verse number="9" style="v" pubnumber="9" sid="LEV 7:9" />كُلُّ تقدِمةٍ مِمَّا تُخبَزُ في التَنُّورِ أو تُقلَى في مِقلاةٍ أو تُخبَزُ على الصَّاجِ، تكونُ للكاهنِ الّذي يُقَرِّبُها. <verse eid="LEV 7:9" /><verse number="10" style="v" pubnumber="10" sid="LEV 7:10" />وكُلُّ تقدِمةٍ مَلتوتةٍ بِزيتٍ أو جافةٍ تكونُ لجميعِ بَني هرونَ بالتَّساوي.<verse eid="LEV 7:10" /></para>
  <para style="s1">شريعة ذبيحة السلامة</para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="LEV 7:11" />”وهذِهِ شريعةُ ذبيحةِ السَّلامةِ الّتي تُقَرَّبُ للرّبِّ: <verse eid="LEV 7:11" /><verse number="12" style="v" pubnumber="12" sid="LEV 7:12" />إذا قُدِّمَت للشُّكرِ يُقَرَّبُ معَها قُربانٌ مِنْ أقراصِ فطيرٍ مَلتُوتةٍ بِزيتٍ، ورِقاقِ فطيرٍ مَمسوحةٍ بِزيتٍ، ودقيقٍ مَدلوكٍ أقراصًا مَلتوتةً بِزيتٍ. <verse eid="LEV 7:12" /><verse number="13" style="v" pubnumber="13" sid="LEV 7:13" />معَ أقراصِ خُبزِ خَميرٍ يُقدَّمُ هذا القُربانُ معَ ذبيحةِ السَّلامةِ الّتي للشُّكرِ. <verse eid="LEV 7:13" /><verse number="14" style="v" pubnumber="14" sid="LEV 7:14" />ويُرفَعُ واحدٌ مِنْ كُلِّ ذلكَ ويُقَرَّبُ قُربانًا للربِّ، والباقي يكونُ للكاهنِ الّذي يَرُشُّ دمَ ذبيحةِ السَّلامةِ. <verse eid="LEV 7:14" /><verse number="15" style="v" pubnumber="15" sid="LEV 7:15" />ولَحمُ ذبيحةِ السَّلامةِ الّتي للشُّكرِ يُؤكَلُ في يومِ تَقريبِهِ، لا يَبقَ مِنهُ إلى الغَدِ. <verse eid="LEV 7:15" /><verse number="16" style="v" pubnumber="16" sid="LEV 7:16" />وإنْ كانتِ الذَّبيحةُ نَذْرًا أو تَبَرُّعًا، فلتُؤكَلْ في يومِ تقريبِها، وما فضَلَ مِنها يُؤكَلُ في الغَدِ. <verse eid="LEV 7:16" /><verse number="17" style="v" pubnumber="17" sid="LEV 7:17" />وما بقيَ مِنها إلى اليومِ الثَّالثِ يُحرَقُ بالنَّارِ. <verse eid="LEV 7:17" /><verse number="18" style="v" pubnumber="18" sid="LEV 7:18" />وإنْ أكلَ أحدٌ مِنها في اليومِ الثَّالِثِ، فلا يَرضى عَنها الرّبُّ، والّذي قَرَّبَها لا تُحسَبُ لَه، بل تكونُ رِجْسًا، ومَنْ أكلَ مِنها تحَمَّلَ عاقِبةَ إثْمِهِ. <verse eid="LEV 7:18" /><verse number="19" style="v" pubnumber="19" sid="LEV 7:19" />وإذا مسَّ لَحمُها شيئًا نَجِسًا، فلا يُؤكَلُ بل يُحرَقُ بالنَّارِ، ولَحمُها يأكلُهُ مَنْ كانَ طاهرًا.<verse eid="LEV 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="LEV 7:20" />”كُلُّ مَنْ أكلَ لَحمًا مِنْ ذبيحةِ السَّلامةِ الّتي للرّبِّ وكانَ نَجِسًا أقطَعُهُ مِنْ شعبِهِ. <verse eid="LEV 7:20" /><verse number="21" style="v" pubnumber="21" sid="LEV 7:21" />وكُلُّ مَنْ لامَسَ شيئًا نَجِسًا لإنسانٍ أو بَهيمةٍ، أو أيَّةِ رجاسةٍ ما نَجِسةٍ، ثُمَّ أكلَ مِنْ ذبيحةِ السَّلامةِ الّتي للرّبِّ أقطَعُه مِنْ شعبِهِ“.<verse eid="LEV 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="LEV 7:22" />وكلَّمَ الرّبُّ موسى فقالَ: <verse eid="LEV 7:22" /><verse number="23" style="v" pubnumber="23" sid="LEV 7:23" />”قُلْ لِبني إسرائيلَ: كُلُّ شَحْمٍ مِنْ بقَرٍ أو ضَأنٍ أو معَزٍ لا تأكُلُوهُ. <verse eid="LEV 7:23" /><verse number="24" style="v" pubnumber="24" sid="LEV 7:24" />وشَحْمُ الحيوانِ المَيْتِ والفريسةِ تستعمِلونَه في أيَّةِ صَنعَةٍ، ولكنْ لا تَأكُلُوه. <verse eid="LEV 7:24" /><verse number="25" style="v" pubnumber="25" sid="LEV 7:25" />مَنْ أكلَ شَحْمًا مِنَ البهيمةِ الّتي يُقَرَّبُ مِنها وقِيدةً للرّبِّ أقطَعُهُ مِنْ شعبِهِ.<verse eid="LEV 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="LEV 7:26" />كُلُّ دَمٍ مِنَ الطَّيرِ والبَهائِمِ لا تأكُلُوه أينَما سَكَنتُم. <verse eid="LEV 7:26" /><verse number="27" style="v" pubnumber="27" sid="LEV 7:27" />ومَنْ أكلَ شيئًا مِنَ الدَّمِ أقطَعُه مِنْ شعبِه“.<verse eid="LEV 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="LEV 7:28" />وكلَّمَ الرّبُّ موسى فقالَ: <verse eid="LEV 7:28" /><verse number="29" style="v" pubnumber="29" sid="LEV 7:29" />”قُلْ لِبني إِسرائيلَ: مَنْ قرَّبَ ذبيحةَ سلامةٍ لِلرّبِّ، فَليُقَرِّبْ مِنها للرّبِّ <verse eid="LEV 7:29" /><verse number="30" style="v" pubnumber="30" sid="LEV 7:30" />وقيدةً مِنَ الشَّحْمِ المُلتَصِقِ بالصَّدْرِ تحمِلُها يَداهُ معَ الصَّدْرِ، فيُحَرِّكُ الصَّدْرَ تحريكًا أمامَ الرّبِّ لِيُكَرِّسَهُ <verse eid="LEV 7:30" /><verse number="31" style="v" pubnumber="31" sid="LEV 7:31" />وأمَّا الشَّحْمُ فيُوقِدُه الكاهنُ على المذبَحِ. ويكونُ الصَّدْرُ لِهرونَ وبَنيهِ الكهَنةِ. <verse eid="LEV 7:31" /><verse number="32" style="v" pubnumber="32" sid="LEV 7:32" />وأعطُوا الكَتِفَ اليُمنى لِمَنْ مِنهم <verse eid="LEV 7:32" /><verse number="33" style="v" pubnumber="33" sid="LEV 7:33" />قرِّبْ دَمَ ذبيحةِ السَّلامةِ وشحْمَها <verse eid="LEV 7:33" /><verse number="34" style="v" pubnumber="34" sid="LEV 7:34" />فيكونُ أنِّي أخذتُ الصَّدْرَ والكَتِفَ اليُمنى مِنْ ذبائِحِ سلامةِ بَني إِسرائيلَ وأعطيتُها لِهرونَ الكاهنِ ولبَنيهِ. هذِهِ فريضةٌ لِبني إِسرائيلَ إلى الأبدِ“.<verse eid="LEV 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" pubnumber="35" sid="LEV 7:35" />تِلكَ حِصَّةُ هرونَ وبَنيهِ مِنَ الذَّبائِحِ الّتي توقَدُ للرّبِّ يومَ تقديمِهِم ليكونوا كهَنةً لَه، <verse eid="LEV 7:35" /><verse number="36" style="v" pubnumber="36" sid="LEV 7:36" />أمرَ الرّبُّ بِها فريضَةً أبديَّةً على مَمَرِّ أجيالِهِم، <verse eid="LEV 7:36" /><verse number="37" style="v" pubnumber="37" sid="LEV 7:37" />وتلكَ شريعةُ المُحرَقةِ والتَّقدمةِ وذبيحةِ الخطيئةِ وذبيحةِ الإثْمِ وتكريسِ الكهَنةِ وذبيحةِ السَّلامةِ، <verse eid="LEV 7:37" /><verse number="38" style="v" pubnumber="38" sid="LEV 7:38" />أمرَ الرّبُّ بها موسى في جبَلِ سيناءَ يومَ أمرَ بَني إِسرائيلَ بأنْ يُقرِّبوا قرابينَهُم للرّبِّ في بريَّةِ سيناءَ“.<verse eid="LEV 7:38" /></para>
  <chapter eid="LEV 7" />
  <chapter number="8" style="c" sid="LEV 8" />
  <para style="s1">شريعة التكريس</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="LEV 8:1" />وقالَ الرّبُّ لِموسى: <verse eid="LEV 8:1" /><verse number="2" style="v" pubnumber="2" sid="LEV 8:2" />”خُذْ هرونَ وبَنيهِ معَهُ، والثِّيابَ وزيتَ المَسْحِ وعِجْلَ ذبيحةِ الخطيئةِ والكَبشَينِ وسَلَّةَ الفطيرِ، <verse eid="LEV 8:2" /><verse number="3" style="v" pubnumber="3" sid="LEV 8:3" />واَجْمَعْ بَني إِسرائيلَ كُلَّهم إلى بابِ خَيمَةِ الاجتِماعِ“. <verse eid="LEV 8:3" /><verse number="4" style="v" pubnumber="4" sid="LEV 8:4" />فعَمِلَ موسى كما أمرَ الرّبُّ. ولمّا اَجْتمَعتِ الجماعةُ إلى بابِ الخَيمةِ، <verse eid="LEV 8:4" /><verse number="5" style="v" pubnumber="5" sid="LEV 8:5" />قالَ لهُم موسى: ”هذا ما أمرَني الرّبُّ أنْ أعمَلَهُ“، <verse eid="LEV 8:5" /><verse number="6" style="v" pubnumber="6" sid="LEV 8:6" />وقدَّمَ هرونَ وبَنيه وغسَلَهُم بالماءِ، <verse eid="LEV 8:6" /><verse number="7" style="v" pubnumber="7" sid="LEV 8:7" />ثُمَّ ألبَسَ هرونَ القميصَ وشَدَّهُ بالحِزامِ، ثُمَّ ألبَسَه الجُبَّةَ والأفودَ وشدَّ الأفودَ بِزُنَّارٍ، <verse eid="LEV 8:7" /><verse number="8" style="v" pubnumber="8" sid="LEV 8:8" />ووَضعَ علَيهِ الصُّدْرةَ وفيها الأُوريمُوالتُّمّيمُ. <verse eid="LEV 8:8" /><verse number="9" style="v" pubnumber="9" sid="LEV 8:9" />وَضعَ العِمامةَ على رأسِ هرونَ وعلَيها مِنَ الأمامِ صَفيحةُ الذَّهبِ، وهوَ التَّاجُ المُقَدَّسُ، كما أمرَ الرّبُّ موسى.<verse eid="LEV 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="LEV 8:10" />وأخذَ موسى زيتَ المَسْحِ ومسَحَ المسكِنَ وجميعَ ما فيهِ وقَدَّسَهُ. <verse eid="LEV 8:10" /><verse number="11" style="v" pubnumber="11" sid="LEV 8:11" />ورَشَّ مِنهُ على المذبَحِ سَبْعَ مرَّاتٍ، ومسَحَ المذبَحَ وجميعَ أدواتِهِ والمِغسَلَةِ ومقعَدَها وقدَّسَها. <verse eid="LEV 8:11" /><verse number="12" style="v" pubnumber="12" sid="LEV 8:12" />وصبَّ مِنْ زيتِ المَسْحِ على رأسِ هرونَ ومسَحَهُ وقدَّسَهُ.<verse eid="LEV 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="LEV 8:13" />ثُمَّ قدَّمَ موسى بَني هرونَ وألبَسَهُم أقمِصَةً، وشَدَّهم بأحزِمةٍ، وعصَبَ لهُم قلانِسَ، كما أمرَ الرّبُّ موسى.<verse eid="LEV 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="LEV 8:14" />وقدَّمَ موسى عِجْلَ ذبيحةِ الخطيئةِ، فوضَعَ هرونُ وبَنوهُ أيديَهُم على رأسِهِ. <verse eid="LEV 8:14" /><verse number="15" style="v" pubnumber="15" sid="LEV 8:15" />وذبَحَهُ موسى وأخذَ الدَّمَ وجعَلَهُ على قُرونِ المذبَحِ مِنْ كُلِّ جِهةٍ بإصبَعِهِ، فطَهَّرهُ وصَبَّ الدَّمَ عِندَ قاعِدَتِهِ وقَدَّسَهُ تكفيرًا عَنه. <verse eid="LEV 8:15" /><verse number="16" style="v" pubnumber="16" sid="LEV 8:16" />وأخذَ موسى جميعَ الشَّحْمِ الّذي على الأمعاءِ وزياداتِ الكَبِدِ والكليَتَينِ وشَحْمَهُما وأوقدَ ذلِكَ على المذبَحِ. <verse eid="LEV 8:16" /><verse number="17" style="v" pubnumber="17" sid="LEV 8:17" />وأحرقَ جِلْدَ العِجْلِ ولَحمَهُ ورَوثَه بالنَّارِ في خارجِ المحَلَّةِ كما أمرَ الرّبُّ. <verse eid="LEV 8:17" /><verse number="18" style="v" pubnumber="18" sid="LEV 8:18" />ثُمَّ قدَّمَ كَبْشَ المُحرَقةِ، فوضعَ هرونُ وبَنوهُ أيديَهُم على رأسِهِ. <verse eid="LEV 8:18" /><verse number="19" style="v" pubnumber="19" sid="LEV 8:19" />وذبَحَهُ موسى ورشَّ الدَّمَ على المذبَحِ مِنْ كُلِّ جِهةٍ. <verse eid="LEV 8:19" /><verse number="20" style="v" pubnumber="20" sid="LEV 8:20" />وقطَّعَ موسى الكَبْشَ قِطَعًا وأوقدَ الرَّأسَ والقِطَعَ والشَّحْمَ. <verse eid="LEV 8:20" /><verse number="21" style="v" pubnumber="21" sid="LEV 8:21" />وغسَلَ الأمعاءَ والأكارِعَ بالماءِ وأوقدَ الكَبْشَ كُلَّهُ على المذبَحِ. هوَ مُحرَقةٌ وقيدةٌ تُرضي رائحَتُها الرّبَّ، كما أمرَ موسى.<verse eid="LEV 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="LEV 8:22" />ثُمَّ قدَّمَ الكَبْشَ الثَّاني، كَبْشَ التَّكريسِ، فوضعَ هرونُ وبَنوهُ أيديَهُم على رأسِهِ. <verse eid="LEV 8:22" /><verse number="23" style="v" pubnumber="23" sid="LEV 8:23" />وذبحَهُ موسى وأخذَ مِنْ دَمِهِ ووضعَ على شَحْمةِ أذُنِ هرونَ اليُمنى، وعلى إبهامِ يدِهِ اليُمنى، وعلى إبهام رجلِهِ اليُمنى.<verse eid="LEV 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="LEV 8:24" />ثُمَّ قَدَّمَ بني هرونَ ووَضعَ مِنَ الدَّمِ على شَحْماتِ آذانِهِمِ اليُمنى، وعلى أباهمِ أيديهِمِ اليُمنى وأباهمِ أرجُلِهِمِ اليُمنى، ورَشَّ الدَّمَ على المذبَحِ مِنْ كُلِّ جِهةٍ. <verse eid="LEV 8:24" /><verse number="25" style="v" pubnumber="25" sid="LEV 8:25" />وأخذَ الشَّحْمَ والألْيةَ، وجميعَ الشَّحْمِ الّذي على الأمعاءِ، وزياداتِ الكَبِدِ، والكليتَينِ وشَحْمَهُما، والكَتِفَ اليُمنى. <verse eid="LEV 8:25" /><verse number="26" style="v" pubnumber="26" sid="LEV 8:26" />وأخذَ مِنْ سلَّةِ الفطيرِ الّتي أمامَ الرّبِّ قُرصَ فطيرٍ وقرصَ خبزٍ بزيتٍ ورُقاقةً ووضعَها على الشُّحومِ والكَتِفِ اليمنى. <verse eid="LEV 8:26" /><verse number="27" style="v" pubnumber="27" sid="LEV 8:27" />ووضعَ موسى هذا كُلَّه على راحتَي هرونَ، وعلى راحاتِ بَنيه، وحرَّكَه تَحْريكًا أمامَ الرّبِّ. <verse eid="LEV 8:27" /><verse number="28" style="v" pubnumber="28" sid="LEV 8:28" />ثُمَّ أخذَهُ عَنْ راحاتِهِم وأوقدَهُ على المذبَحِ فوقَ المُحرَقةِ. هوَ قُربانُ تكريسٍ ووقيدةٌ تُرضي رائحَتُها الرّبَّ.<verse eid="LEV 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="LEV 8:29" />ثُمَّ أخذَ موسى صَدْرَ الذَّبيحةِ وحرَّكَهُ تَحْريكًا أمامَ الرّبِّ، وكانَ هذا حِصَّةَ موسى مِنْ كَبْشِ التَّكريسِ، كما أمرَ الرّبُّ موسى. <verse eid="LEV 8:29" /><verse number="30" style="v" pubnumber="30" sid="LEV 8:30" />وأخذَ موسى مِنْ زيتِ المَسْحِ، ومِنَ الدَّمِ الّذي على المذبَحِ، فرَشَّ على هرونَ وثيابِهِ، وعلى بَنيهِ وثيابِهِم، وقَدَّسَ هرونَ وثيابَهُ وبَنيهِ وثيابَهُم.<verse eid="LEV 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" pubnumber="31" sid="LEV 8:31" />وقالَ موسى لِهرونَ وبَنيهِ: ”أُطبُخوا اللَّحمَ عِندَ بابِ خَيمةِ الاجتماعِ وكُلُوهُ هُناكَ معَ الخُبزِ الّذي في سلَّةِ التَّكريسِ، كما أمرَ الرّبُّ وقالَ ”هرونُ وبَنوه يأكلونَهُ“، <verse eid="LEV 8:31" /><verse number="32" style="v" pubnumber="32" sid="LEV 8:32" />وما فضَلَ مِنَ اللَّحمِ والخُبزِ، فاَحرِقوه بالنَّارِ. <verse eid="LEV 8:32" /><verse number="33" style="v" pubnumber="33" sid="LEV 8:33" />ولا تخرُجوا مِنْ عِندِ بابِ خَيمةِ الاجتِماعِ حتى تمضيَ سَبعةُ أيّامٍ ويكونَ مِنْ بَعدِها تكريسُكُم. <verse eid="LEV 8:33" /><verse number="34" style="v" pubnumber="34" sid="LEV 8:34" />فأعملُ بِكُم مِثلما عَمِلْتُ اليومَ تكفيرًا عنكُم، كما أمرَ الرّبُّ. <verse eid="LEV 8:34" /><verse number="35" style="v" pubnumber="35" sid="LEV 8:35" />فأقيمُوا عِندَ بابِ خَيمةِ الاجتِماعِ نهارًا وليلًا سَبعةَ أيّامٍ لِتَحرُسوا شعائِرَ الرّبِّ فلا تموتُونَ. هكذا أمرَ الرّبُّ“.<verse eid="LEV 8:35" /></para>
  <para style="p">
    <verse number="36" style="v" pubnumber="36" sid="LEV 8:36" />فعَمِل هرونُ وبَنوهُ بجميعِ ما أمرَ بهِ الرّبُّ على لِسانِ موسى.<verse eid="LEV 8:36" /></para>
  <chapter eid="LEV 8" />
  <chapter number="9" style="c" sid="LEV 9" />
  <para style="s1">هرون يقرب الذبائح</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="LEV 9:1" />ودَعا موسى في اليومِ الثَّامنِ هرونَ وبَنيهِ وشُيوخَ بَني إِسرائيلَ، <verse eid="LEV 9:1" /><verse number="2" style="v" pubnumber="2" sid="LEV 9:2" />وقالَ لِهرونَ: ”خُذْ عِجْلًا مِنَ البقَرِ لِذبيحةِ الخطيئةِ، وكَبْشًا لَمُحرَقةٍ صحيحَينِ وقدِّمْهُما قربانًا أمامَ الرّبِّ. <verse eid="LEV 9:2" /><verse number="3" style="v" pubnumber="3" sid="LEV 9:3" />وقُلْ لِبَني إِسرائيلَ: خُذُوا تَيسًا مِنَ المعَزِ لذبيحةِ خطيئةٍ، وعِجْلًا وخروفًا حَوليَّينِ صحيحَينِ لِمُحرَقةٍ، <verse eid="LEV 9:3" /><verse number="4" style="v" pubnumber="4" sid="LEV 9:4" />وثورًا وكَبْشًا لِذبيحةِ سلامةٍ أمامَ الرّبِّ، وتقدِمةً مَلتُوتَةً بِزيتٍ، فالرّبُّ اليومَ يتراءَى لكُم“.<verse eid="LEV 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="LEV 9:5" />فأخذَ بَنو إِسرائيلَ ما أمرَ موسى إلى بابِ خَيمةِ الاجتِماعِ واَقتَربُوا جميعًا ووَقَفُوا أمامَ الرّبِّ. <verse eid="LEV 9:5" /><verse number="6" style="v" pubnumber="6" sid="LEV 9:6" />فقالَ موسى: ”هذا ما أمرَ بهِ الرّبُّ، تعمَلُونَهُ فيَتَراءى لكم مَجدُهُ“. <verse eid="LEV 9:6" /><verse number="7" style="v" pubnumber="7" sid="LEV 9:7" />ثُمَّ قالَ لِهرونَ: ”إقْتَرِبْ إلى المذبَحِ واَعْمَلْ للرّبِّ ذبيحةَ تكفيرٍ عَنْ خطيئَتِكَ ومُحرَقةً تُكفِّرُ بِها عَنْ نَفسِكَ وعَنِ الشَّعبِ. وقرِّبْ إلى الرّبِّ ما يُكَفِّرُ عَنِ الشَّعبِ بِحسَبِ ما أمرَ الرّبُّ“.<verse eid="LEV 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="LEV 9:8" />فاَقْتَرَبَ هرونُ إلى المذبَحِ وذبَحَ عِجْلَ ذبيحةِ الخطيئَةِ الّذي لهُ. <verse eid="LEV 9:8" /><verse number="9" style="v" pubnumber="9" sid="LEV 9:9" />وقَدَّمَ لَه بَنو هرونَ الدَّمَ، فغَمسَ إصبعَهُ في الدَّمِ وجعَلَ على قُرونِ المذبَحِ، وصَبَّ الدَّمَ على قاعِدتِهِ. <verse eid="LEV 9:9" /><verse number="10" style="v" pubnumber="10" sid="LEV 9:10" />وأوقدَ الشَّحْمَ والكليَتَينِ وزيادةَ الكَبِدِ على المذبَحِ، كما أمرَ الرّبُّ موسى. <verse eid="LEV 9:10" /><verse number="11" style="v" pubnumber="11" sid="LEV 9:11" />وأمَّا اللَّحمُ والجِلْدُ فأحرَقَهُما بِنارٍ في خارجِ المحَلَّةِ.<verse eid="LEV 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="LEV 9:12" />ثُمَّ ذبَحَ المُحرَقةَ، وناولَهُ بَنو هرونَ الدَّمَ، فرَشَّهُ على أربعَةِ جوانبِ المذبَحِ. <verse eid="LEV 9:12" /><verse number="13" style="v" pubnumber="13" sid="LEV 9:13" />وناولُوهُ المُحرَقةَ بِقِطَعِها والرَّأسَ، فأوقدَها على المذبَحِ. <verse eid="LEV 9:13" /><verse number="14" style="v" pubnumber="14" sid="LEV 9:14" />وغسَلَ الأمعاءَ والأكارِعَ وأوقدَها فوقَ المُحرقَةِ على المذبَحِ.<verse eid="LEV 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="LEV 9:15" />وقدَّمَ هرونُ قُربانَ الشَّعبِ، فأخذَ تَيْسَ ذبيحةِ الخطيئةِ الّذي للشَّعبِ وذبَحَهُ وقدَّمَهُ ذبيحةَ خطيئةٍ كالعِجْلِ الأوَّلِ. <verse eid="LEV 9:15" /><verse number="16" style="v" pubnumber="16" sid="LEV 9:16" />ثُمَّ قرَّبَ المُحرَقةَ، كما جرَتِ العادةُ. <verse eid="LEV 9:16" /><verse number="17" style="v" pubnumber="17" sid="LEV 9:17" />وقرَّبَ التَّقدِمةَ، فمَلأَ قبضَتَهُ مِنها وأوقدَها على المذبَحِ معَ مُحرَقةِ الصَّباحِ. <verse eid="LEV 9:17" /><verse number="18" style="v" pubnumber="18" sid="LEV 9:18" />وذبَحَ الثَّورَ والكَبْشَ ذبيحةَ سلامةٍ للشَّعبِ، وناولَهُ بَنو هرونَ الدَّمَ، فرَشَّهُ على أربعَةِ جَوانبِ المذبَحِ. <verse eid="LEV 9:18" /><verse number="19" style="v" pubnumber="19" sid="LEV 9:19" />وناولُوهُ الشَّحْمَ مِنَ الثَّورِ ومِنَ الكَبْشِ، معَ ألْيتِهِ وما يُغطِّي الأمعاءَ والكليتَينِ والزَّائِدَ مِنَ الكَبِدِ. <verse eid="LEV 9:19" /><verse number="20" style="v" pubnumber="20" sid="LEV 9:20" />ووضعوا الشَّحْمَ على الصَّدْرَينِ، فأوقدَ هرونُ الشَّحْمَ على المذبَحِ. <verse eid="LEV 9:20" /><verse number="21" style="v" pubnumber="21" sid="LEV 9:21" />وأمَّا الصَّدْرانَ والسَّاقُ اليُمنى، فحَرَّكَها هرونُ تَحْريكًا أمامَ الرّبِّ، كما قالَ لَه موسى.<verse eid="LEV 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="LEV 9:22" />ولمَّا أكملَ هرونُ تقريبَ ذبيحةِ الخطيئةِ، والمُحرَقةِ، وذبيحةِ السَّلامةِ، رفَعَ يَدهُ نحوَ الشَّعبِ وبارَكَهُم ونزَلَ عَنِ المذبَحِ. <verse eid="LEV 9:22" /><verse number="23" style="v" pubnumber="23" sid="LEV 9:23" />ودخَلَ موسى وهرونُ إلى خَيمةِ الاجتِماعِ، ثُمَّ خرجا وباركا الشَّعبَ. فتَراءى مَجْدُ الرّبِّ لِكُلِّ الشَّعبِ. <verse eid="LEV 9:23" /><verse number="24" style="v" pubnumber="24" sid="LEV 9:24" />وخرَجَتْ نارٌ مِنْ عِندِ الرّبِّ وأحرقَتِ المُحرَقةَ والشَّحْمَ على المذبَحِ. فلمَّا رأى الشَّعبُ ذلِكَ هتَفوا ووقعوا على وجُوهِهِم ساجِدينَ.<verse eid="LEV 9:24" /></para>
  <chapter eid="LEV 9" />
  <chapter number="10" style="c" sid="LEV 10" />
  <para style="s1">خطيئة ناداب وأبيهو</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="LEV 10:1" />وأخذَ كُلٌّ مِنْ نادابَ وأبيهو، اَبنَي هرونَ، مِجمَرَتَهُ وجعَلَ فيها نارًا ووضَعَ علَيها بَخُورًا، وقرَّبَ أمامَ الرّبِّ نارًا غيرَ مُقَدَّسةٍ لم يأمُرْهُما بها. <verse eid="LEV 10:1" /><verse number="2" style="v" pubnumber="2" sid="LEV 10:2" />فخَرَجت نارٌ مِنْ عِندِ الرّبِّ وأكلَتْهُما، فماتا أمامَ الرّبِّ. <verse eid="LEV 10:2" /><verse number="3" style="v" pubnumber="3" sid="LEV 10:3" />فقالَ موسى لِهرونَ: ”هذا ما قالَه الرّبُّ: أنا في الّذينَ يقترِبونَ مِنِّي مُقَدَّسٌ، وأمامَ جميعِ الشَّعبِ مُمَجَّدٌ“. فأسِفَ هرونُ.<verse eid="LEV 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="LEV 10:4" />ودَعا موسى ميشائيلَ وألصافانَ، اَبنَي عُزِّيئيلَ عمِّ هرونَ، وقالَ لهُما: ”إقتربا واَحمِلا نَسيبَيكُما مِنْ هذا المكانِ المُقدَّسِ إلى خارجِ المحَلَّةِ“. <verse eid="LEV 10:4" /><verse number="5" style="v" pubnumber="5" sid="LEV 10:5" />فاَقْترَبا وحَملاهُما في قَميصَيهِما إلى خارجِ المحَلَّةِ، كما قالَ موسى.<verse eid="LEV 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="LEV 10:6" />وقالَ موسى لِهرونَ وألعازارَ وإيثامارَ اَبنَيهِ: ”لا تكشِفوا رُؤوسَكُم، ولا تشُقُّوا ثيابَكُم حِدادًا لِئلَّا تموتوا ويغضَبَ الرّبُّ على الجماعةِ كُلِّها. وإنَّما يجوزُ لِسائرِ بَني إِسرائيلَ أنْ يَبكوا اللَّذَينِ أحرَقَتْهُما نارُ الرّبِّ. <verse eid="LEV 10:6" /><verse number="7" style="v" pubnumber="7" sid="LEV 10:7" />ومِنْ عِندِ بابِ خَيمةِ الاجتِماعِ لا تخرُجوا لِئلَّا تموتوا، لأنَّ زيتَ مَسْحةِ الرّبِّ علَيكُم“. ففعَلوا كما قالَ موسى.<verse eid="LEV 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="LEV 10:8" />وقالَ الرّبُّ لِهرونَ: <verse eid="LEV 10:8" /><verse number="9" style="v" pubnumber="9" sid="LEV 10:9" />”لا تشربْ خمرًا ومُسكِرًا، أنتَ وبَنوكَ معَكَ، عِندَ دُخولِكُم إلى خَيمةِ الاجتِماعِ لِئلَّا تموتوا. هذِهِ فريضةٌ أبديَّةٌ مدَى أجيالِكُم، <verse eid="LEV 10:9" /><verse number="10" style="v" pubnumber="10" sid="LEV 10:10" />لِتُميِّزوا بَينَ المُقَدَّسِ للرّبِّ والمُحلَّلِ للعُمومِ، وبَينَ النَّجِسِ والطَّاهرِ، <verse eid="LEV 10:10" /><verse number="11" style="v" pubnumber="11" sid="LEV 10:11" />ولِتُعَلِّموا بَني إِسرائيلَ جميعَ الفَرائضِ الّتي أمرَ الرّبُّ بها على لِسانِ موسى“.<verse eid="LEV 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="LEV 10:12" />وقالَ موسى لِهرونَ وألعازارَ وإيثامارَ اَبنَيهِ الباقيَينِ: ”خُذُوا التَّقدِمةَ الباقيةَ مِنْ وقائدِ الرّبِّ وكُلُوها فطيرًا بِجانبِ المذبَحِ، فهيَ مُقَدَّسةٌ كُلَّ التَّقديسِ. <verse eid="LEV 10:12" /><verse number="13" style="v" pubnumber="13" sid="LEV 10:13" />تأكلونَها في موضِعٍ مُقدَّسٍ لأنَّها مِنْ حَقِّكَ وحَقِّ بَنيكَ مِنْ وقائدِ الرّبِّ، كما أمرْتُ. <verse eid="LEV 10:13" /><verse number="14" style="v" pubnumber="14" sid="LEV 10:14" />وأمَّا صَدْرُ التَّحريكِ، والكَتِفُ اللَّذانِ جعَلْتُهُما مِنْ حَقِّكَ وحَقِّ بَنيكَ مِنْ ذبائِحِ السَّلامةِ الّتي يُقَرِّبُها بَنو إِسرائيلَ، فتأكُلونَهُما في موضِعٍ طاهِرٍ، أنتَ وبَنوكَ وبناتُكَ معَكَ. <verse eid="LEV 10:14" /><verse number="15" style="v" pubnumber="15" sid="LEV 10:15" />يجيئونَ بِهِما معَ وقائِدِ الشَّحْمِ لِيُحرَّكا تَحريكًا أمامَ الرّبِّ، فيكونانِ لكَ ولِبَنيكَ معَكَ فريضَةً أبديَّةً، كما أمرَ الرّبُّ“.<verse eid="LEV 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="LEV 10:16" />ولمَّا طلَبَ موسى تَيسَ ذبيحةِ الخطيئةِ عَلِمَ أنَّه اَحْتَرَقَ. فغَضِبَ على ألعازَرَ وإيثامارَ اَبنَي هرونَ الباقيَينِ وقالَ: <verse eid="LEV 10:16" /><verse number="17" style="v" pubnumber="17" sid="LEV 10:17" />”لماذا لم تَأْكلا ذبيحةَ الخطيئةِ في الموضِعِ المُقَدَّسِ؟ فَهيَ مقدَّسَةٌ كُلَّ التَّقديسِ للرّبِّ الّذي أعطاها لكُما تكفيرًا عَنْ إثْمِ الجماعةِ أمامَ الرّبِّ. <verse eid="LEV 10:17" /><verse number="18" style="v" pubnumber="18" sid="LEV 10:18" />كانَ يجبُ أنْ يُؤتَى بدَمِها إلى داخلِ القُدْسِ، وأنْ تأكلاها هُناكَ كما أمرْتُ؟“ <verse eid="LEV 10:18" /><verse number="19" style="v" pubnumber="19" sid="LEV 10:19" />فقالَ هرونُ لموسى: ”هُما قرَّبا اليومَ ذبيحةَ التكفيرِ عَنْ خطيئتِهِما مُحرَقةً أمامَ الرّبِّ، ومعَ ذلِكَ أصابَتْني مِثلُ هذِهِ المَصائبِ. فلو أكلْتُ ذبيحةَ الخطيئةِ اليومَ، هل كانَ ذلِكَ يُرضي الرّبَّ؟“<verse eid="LEV 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="LEV 10:20" />فلمَّا سَمِعَ موسى جوابَ هَرونَ اَقْتَنَعَ بهِ.<verse eid="LEV 10:20" /></para>
  <chapter eid="LEV 10" />
  <chapter number="11" style="c" sid="LEV 11" />
  <para style="s1">شريعة الطاهر والنجس من الحيوان</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="LEV 11:1" />وقالَ الرّبُّ لموسى وهرونَ: <verse eid="LEV 11:1" /><verse number="2" style="v" pubnumber="2" sid="LEV 11:2" />”قُولا لبَني إِسرائيلَ هذِهِ هيَ الحيواناتُ الّتي تأكُلونَها مِنْ جميعِ البَهائِمِ الّتي على الأرضِ: <verse eid="LEV 11:2" /><verse number="3" style="v" pubnumber="3" sid="LEV 11:3" />جميعُ ما هوَ مشقوقُ الظِّفْرِ ويجتَرُّ مِنَ البَهائِمِ. <verse eid="LEV 11:3" /><verse number="4" style="v" pubnumber="4" sid="LEV 11:4" />أمَّا الحيواناتُ الّتي تجتَرُّ، وأظفارُها غيرُ مشقوقةٍ أو الّتي لا تَجتَرُّ وأظفارُها مشقوقةٌ، فلا تأكلوها لأنَّها نَجِسٌ لكُم: الجَمَلُ لأنَّهُ يجتَرُّ ولكنَّه غيرُ مشقوقِ الظِّفْرِ، <verse eid="LEV 11:4" /><verse number="5" style="v" pubnumber="5" sid="LEV 11:5" />والغَرغورُ لأنَّهُ يجتَرُّ ولكنَّه غيرُ مشقوقِ الظِّفْرِ، <verse eid="LEV 11:5" /><verse number="6" style="v" pubnumber="6" sid="LEV 11:6" />والأرنَبُ لأنَّهُ يجتَرُّ ولكِنَّه غيرُ مشقوقِ الظِّفْرِ، <verse eid="LEV 11:6" /><verse number="7" style="v" pubnumber="7" sid="LEV 11:7" />والخِنزيرُ لأنَّهُ مشقوقُ الظِّفْرِ ولكنَّه لا يجتَرُّ. <verse eid="LEV 11:7" /><verse number="8" style="v" pubnumber="8" sid="LEV 11:8" />مِنْ لَحمِها لا تأكلوا ولا تَمَسُّوها مَيتَةً، فهيَ نَجِسةٌ لكُم.<verse eid="LEV 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="LEV 11:9" />”وهذا ما تأكلونَه مِنْ جميعِ ما في الماءِ: جميعُ ما لَه زعانِفُ وقُشورٌ في البِحارِ والأنهارِ. <verse eid="LEV 11:9" /><verse number="10" style="v" pubnumber="10" sid="LEV 11:10" />وما عدا ذلِكَ مِمَّا لا زعانِفَ وقشورَ لَه مِنْ جميعِ ما يزحفُ في الماءِ مِنَ الحيوانِ، فهوَ رِجْسٌ لكُم. <verse eid="LEV 11:10" /><verse number="11" style="v" pubnumber="11" sid="LEV 11:11" />مِنْ لَحمِهِ لا تأكلوا، وإنْ كانَ جُثَّةً فتَجَنَّبُوه لأنَّه رِجْسٌ. <verse eid="LEV 11:11" /><verse number="12" style="v" pubnumber="12" sid="LEV 11:12" />كُلُّ ما لا زعانِفَ وقُشورَ لَه مِمَّا في الماءِ، فهو رجْسٌ لكُم.<verse eid="LEV 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="LEV 11:13" />”وهذا ما تَتَجَنَّبونَه مِنَ الطَّيرِ ولا تأكلونَه لأنَّه رِجْسٌ: النَّسْرُ والأنوقُ والعِقابُ، <verse eid="LEV 11:13" /><verse number="14" style="v" pubnumber="14" sid="LEV 11:14" />والحَدأُ والصَّدى بأصنافِها، <verse eid="LEV 11:14" /><verse number="15" style="v" pubnumber="15" sid="LEV 11:15" />وجميعُ الغُربانِ بأصنافِها <verse eid="LEV 11:15" /><verse number="16" style="v" pubnumber="16" sid="LEV 11:16" />والنَّعامُ والخطَّافُ والسَّأفُ والبازيُّ بأصنافِه، <verse eid="LEV 11:16" /><verse number="17" style="v" pubnumber="17" sid="LEV 11:17" />والبُومُ والزَمُّجُ والباشَقُ، <verse eid="LEV 11:17" /><verse number="18" style="v" pubnumber="18" sid="LEV 11:18" />والشَّاهينُ والقُوقُ والرَّخَمُ، <verse eid="LEV 11:18" /><verse number="19" style="v" pubnumber="19" sid="LEV 11:19" />والصَّقْرُ والبَبَّغاءُ بأصنافِهِ، والهُدهُدُ، والخفَّاشُ، <verse eid="LEV 11:19" /><verse number="20" style="v" pubnumber="20" sid="LEV 11:20" />ولا تأكلوا الحشَراتِ المُجَنَّحَةَ الّتي تمشي على أربَعٍ، فهوَ رِجْسٌ لكُم، <verse eid="LEV 11:20" /><verse number="21" style="v" pubnumber="21" sid="LEV 11:21" />ما عدا الّتي لها رِجْلانِ أطولُ مِنْ يَدَيها تقفزُ بهما على الأرضِ، <verse eid="LEV 11:21" /><verse number="22" style="v" pubnumber="22" sid="LEV 11:22" />كالجَرادِ بأصنافِهِ، والدَّبَى بأصنافِه، والحَرجُوانِ بأصنافِهِ، والجُنْدبِ بأصنافِهِ. <verse eid="LEV 11:22" /><verse number="23" style="v" pubnumber="23" sid="LEV 11:23" />وأمَّا سائِرُ الطَّيرِ الّذي يَدِبُّ ولَه أربَعُ أرجُلٍ، فهو رِجْسٌ لكُم. <verse eid="LEV 11:23" /><verse number="24" style="v" pubnumber="24" sid="LEV 11:24" />مِنْ هذِهِ تتَنَجَّسونَ، وكُلُّ مَنْ مَسَّ جُثَّتَها يكونُ نَجِسًا إلى المَغيبِ، <verse eid="LEV 11:24" /><verse number="25" style="v" pubnumber="25" sid="LEV 11:25" />وكُلُّ مَنْ حمَلَ جُثَّتَها يغسِلُ ثيابَه ويكونُ نَجِسًا إلى المَغيبِ. <verse eid="LEV 11:25" /><verse number="26" style="v" pubnumber="26" sid="LEV 11:26" />كُلُّ حيوانٍ لَه ظِفْرٌ غيرُ مَشقوقٍ وكُلُّ ما لا يجترُّ، فهوَ نَجِسٌ لكُم. كُلُّ مَنْ مَسَّ جُثَّتَه يكونُ نَجِسًا. <verse eid="LEV 11:26" /><verse number="27" style="v" pubnumber="27" sid="LEV 11:27" />وكُلُّ ما يسعى على راحَتَيه مِنْ جميعِ الوحوشِ ويمشي على أربَعٍ فهوَ نَجِسٌ لكُم. وكُلُّ مَنْ مَسَّ جُثَّتَه يكونُ نَجِسًا إلى المَغيبِ، <verse eid="LEV 11:27" /><verse number="28" style="v" pubnumber="28" sid="LEV 11:28" />وكُلُّ مَنْ حمَلَ جُثَّتَه يَغسِلُ ثيابَهُ ويكونُ نَجِسًا إلى المَغيبِ.<verse eid="LEV 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="LEV 11:29" />”وهذا هوَ النَّجِسُ لكُم مِمَّا يدِبُّ على الأرضِ: الخِلْدُ والفأرُ والضَّبُّ بأصنافِها، <verse eid="LEV 11:29" /><verse number="30" style="v" pubnumber="30" sid="LEV 11:30" />والورَلُ والحِرْذَونُ والعِظاءةُ والحِرباءُ وسامٌّ أبرصُ. <verse eid="LEV 11:30" /><verse number="31" style="v" pubnumber="31" sid="LEV 11:31" />هذِهِ نَجِسةٌ لكُم مِنْ جميع ما يَدِبُّ. مَنْ مسَّ جُثَّتَها يكونُ نجِسًا إلى المَغيبِ، <verse eid="LEV 11:31" /><verse number="32" style="v" pubnumber="32" sid="LEV 11:32" />وكُلُّ ما وُضِعَ علَيه شيءٌ مِنها بَعدَ موتِها يكونُ نَجِسًا: أوعيةُ الخشَبِ، والثِّيابُ، والجِلْدُ، والمَسْحُ وكُلُّ وِعاءٍ مُستعمَلٍ، يُنقَعُ في الماءِ ويكونُ نَجِسًا إلى المَغيبِ ثُمَّ يُطهَّرُ. <verse eid="LEV 11:32" /><verse number="33" style="v" pubnumber="33" sid="LEV 11:33" />وكُلُّ وِعاءِ خَزَفٍ مِنها وقعَ شيءٌ في وسَطهِ يكونُ كُلُّ ما في داخلِهِ نَجِسًا، فاَكسِروهُ. <verse eid="LEV 11:33" /><verse number="34" style="v" pubnumber="34" sid="LEV 11:34" />فإنْ كانَ طَعامًا يُؤكلُ، فهوَ نَجِسٌ ولو غُسِلَ بالماءِ، وإنْ كانَ شَرابًا يُشرَبُ، فهوَ نَجِسٌ مهما يَكُنْ وِعاؤُهُ.<verse eid="LEV 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" pubnumber="35" sid="LEV 11:35" />”وكُلُّ ما وقَعَ علَيهِ مِنْ جُثَّتِها يكونُ نَجِسًا، فإنْ كانَ تَنُّورًا أو مَوقدةً فاَهدموهُما. هيَ نَجِسةٌ، فَنَجِسةً تكونُ لكُم. <verse eid="LEV 11:35" /><verse number="36" style="v" pubnumber="36" sid="LEV 11:36" />أمَّا النَّبْعُ والبِئْرُ وكُلُّ مُجتمعِ ماءٍ، فيكونُ طاهرًا. ولكنْ إذا مَسَّها وهي جُثَّةٌ فيكونُ نجسًا. <verse eid="LEV 11:36" /><verse number="37" style="v" pubnumber="37" sid="LEV 11:37" />وإنْ وقَعَ شيءٌ مِنْها وهي جثَّةٌ على أيِّ بِذرٍ يُزرَعُ، فهوَ طاهرٌ. <verse eid="LEV 11:37" /><verse number="38" style="v" pubnumber="38" sid="LEV 11:38" />فإنْ كانَ على البَذرِ ماءٌ ووقَعَ شيءٌ مِنها علَيهِ وهيَ جُثَّةٌ، فهوَ نَجِسٌ لكُم.<verse eid="LEV 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" pubnumber="39" sid="LEV 11:39" />”وإذا ماتَ حيوانٌ مِمَّا يَحِلُّ لكُم أكلُهُ، فإنْ مَسَّهُ أحدٌ يكونُ نَجِسًا إلى المَغيبِ. <verse eid="LEV 11:39" /><verse number="40" style="v" pubnumber="40" sid="LEV 11:40" />ومَنْ أكلَ مِنْ جُثَّتِهِ يَغسِلُ ثيابَه ويكونُ نَجِسًا إلى المَغيب. ومَنْ حمَلَ جُثَّتَه يَغسِلُ ثيابَه ويكونُ نَجِسًا إلى المَغيبِ.<verse eid="LEV 11:40" /></para>
  <para style="p">
    <verse number="41" style="v" pubnumber="41" sid="LEV 11:41" />”وجميعُ الحشَراتِ الّتي تدِبُّ على الأرضِ هي رجسٌ لا يُؤكَلُ. <verse eid="LEV 11:41" /><verse number="42" style="v" pubnumber="42" sid="LEV 11:42" />ولا تأكلوا كُلَّ ما حَبا على بَطنِه وعلى أربَعٍ، وكُلَّ ما كثُرَت أرجلُهُ، فهوَ رِجْسٌ. <verse eid="LEV 11:42" /><verse number="43" style="v" pubnumber="43" sid="LEV 11:43" />لا تُدَنِّسوا أنفُسَكُم بشيءٍ مِنهُ ولا تتنجَّسوا بهِ، فتكونوا نَجِسينَ.<verse eid="LEV 11:43" /></para>
  <para style="p">
    <verse number="44" style="v" pubnumber="44" sid="LEV 11:44" />”أنا الرّبُّ إلهُكُم، فتَقَدَّسوا وكونوا قدِّيسينَ لأنِّي أنا قدُّوسٌ. ولا تُنَجِّسوا أنفُسَكُم بشيءٍ مِنَ الحشَراتِ الّتي تدِبُّ مُتَحرِّكةً على الأرضِ. <verse eid="LEV 11:44" /><verse number="45" style="v" pubnumber="45" sid="LEV 11:45" />فأنا الرّبُّ الّذي أخرَجَكُم مِنْ أرضِ مِصْرَ لأكونَ إلهًا لكُم، فكونوا قدِّيسينَ لأنِّي أنا قدُّوسٌ.<verse eid="LEV 11:45" /></para>
  <para style="p">
    <verse number="46" style="v" pubnumber="46" sid="LEV 11:46" />هذِهِ شريعةُ البَهائمِ والطَّيرِ وجميعِ المخلوقاتِ الحَيَّةِ مِمَّا يتَحرَّكُ في الماءِ ومِمَّا يدِّبُّ على الأرضِ. <verse eid="LEV 11:46" /><verse number="47" style="v" pubnumber="47" sid="LEV 11:47" />بها تُميِّزونَ بَينَ النَّجِسِ والطَّاهرِ، وبَينَ الحيوانِ الّذي يُؤكَلُ والّذي لا يُؤكَلُ“.<verse eid="LEV 11:47" /></para>
  <chapter eid="LEV 11" />
  <chapter number="12" style="c" sid="LEV 12" />
  <para style="s1">شريعة الولادة</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="LEV 12:1" />وكلَّمَ الرّبُّ موسى فقالَ: <verse eid="LEV 12:1" /><verse number="2" style="v" pubnumber="2" sid="LEV 12:2" />”قُلْ لِبني إِسرائيلَ: إذا حَبِلَتِ اَمرأةٌ فوَلَدَت ذَكَرًا، تكونُ نَجِسةً سَبعَةَ أيّامٍ كما في أيّامِ طَمْثِها. <verse eid="LEV 12:2" /><verse number="3" style="v" pubnumber="3" sid="LEV 12:3" />وفي اليومِ الثَّامنِ يُختَنُ المولودُ. <verse eid="LEV 12:3" /><verse number="4" style="v" pubnumber="4" sid="LEV 12:4" />وتنتَظِرُ ثلاثةً وثلاثينَ يومًا آخرَ لِيتطهَّرَ دَمُها، لا تُلامِسُ شيئًا مِنَ المُقَدَّساتِ ولا تدخُلُ المَقْدِسَ حتّى تَتِمَّ أيّامُ طُهورِها.<verse eid="LEV 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="LEV 12:5" />فإنْ وَلَدت أُنثى، تكونُ نَجِسةً أسبوعينِ كما في أيّامِ طَمْثِها، وتنتَظِرُ سِتَّةً وستّينَ يومًا لِيتطهَّرَ دَمُها. <verse eid="LEV 12:5" /><verse number="6" style="v" pubnumber="6" sid="LEV 12:6" />وعِندَما تَتِمُّ أيّامُ طُهورِها، لِذَكَرٍ كان أو أُنثى، تَجيءُ بِخَروفٍ حَوليٍّ مُحرَقةً، وبِفَرْخِ حمامٍ أو بيمامةٍ ذبيحةَ خطيئةٍ إلى بابِ خيمةِ الاجتِماعِ، إلى الكاهنِ، <verse eid="LEV 12:6" /><verse number="7" style="v" pubnumber="7" sid="LEV 12:7" />فيُقَرِّبُها أمامَ الرّبِّ ويُكَفِّرُ عنها، فتَطهَرُ مِنْ سَيَلانِ دَمِها. هذِهِ شريعةُ الّتي تَلِدُ ذَكَرًا أو أُنثى. <verse eid="LEV 12:7" /><verse number="8" style="v" pubnumber="8" sid="LEV 12:8" />وإنْ كانت لا تَملِكُ ثَمَنَ خَروفٍ، فلْتَأخُذْ يَمامَتَينِ أو فرخَي حمامٍ، أحدُهُما مُحرَقةٌ والآخرُ ذبيحةُ خطيئةٍ. فيُكَفِّرُ عنها الكاهنُ، فتَطهُرُ“.<verse eid="LEV 12:8" /></para>
  <chapter eid="LEV 12" />
  <chapter number="13" style="c" sid="LEV 13" />
  <para style="s1">شريعة بلوى البرص</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="LEV 13:1" />وكلَّمَ الرّبُّ موسى وهرونَ فقالَ: <verse eid="LEV 13:1" /><verse number="2" style="v" pubnumber="2" sid="LEV 13:2" />”مَنْ كانَ في جِلْدِ بَدَنِهِ نُتوءٌ أو طَفْحةٌ جِلْديَّةٌ أو لَمعَةٌ تُشيرُ إلى بلوى البرَصِ، فلْيَحضُرْ إلى هرونَ الكاهنِ أو إلى واحدٍ مِنْ بَنيهِ الكهَنةِ. <verse eid="LEV 13:2" /><verse number="3" style="v" pubnumber="3" sid="LEV 13:3" />فيفحَصَ الكاهنُ الدَّاءَ في جِلْدِ البدَنِ، فإنْ كانَ في موضِعِ الدَّاءِ شَعْرٌ أبيضُ، ومَنظرُ الدَّاءِ أعمقُ مِنْ جِلْدِ بَدَنِهِ، فهوَ بَلوى البرَصِ. فإذا رآهُ الكاهنُ كذلِكَ، يحكُمُ بِنَجاسَتِه. <verse eid="LEV 13:3" /><verse number="4" style="v" pubnumber="4" sid="LEV 13:4" />وإنْ كانَ الدَّاءُ لَمعَةً بيضاءَ في جِلْدِ بدَنِهِ، لا مَنظرُها أعمَقُ مِنَ الجِلْدِ ولا شَعْرُها أبيضُ، يحجُزُهُ الكاهنُ سَبعَةَ أيّامٍ. <verse eid="LEV 13:4" /><verse number="5" style="v" pubnumber="5" sid="LEV 13:5" />ثُمَّ يفحَصُهُ في اليومِ السَّابِعِ، فإذا رأى أنَّ الدَّاءَ لم يَتَفَشَّ في الجِلْدِ، يحجُزُهُ سَبعَةَ أيّامٍ أُخَرَ. <verse eid="LEV 13:5" /><verse number="6" style="v" pubnumber="6" sid="LEV 13:6" />ثُمَّ يفحَصُهُ في اليومِ السَّابعِ ثانيةً، فإنْ كانَ الدَّاءُ داكِنَ اللَّونِ وغيرَ مُتَفَشٍّ في الجِلْدِ، يحكُمُ بِطهارَتِه. هيَ طَفحَةٌ جِلْديَّةٌ، فيَغسِلُ ثيابَه ويَطهُرُ. <verse eid="LEV 13:6" /><verse number="7" style="v" pubnumber="7" sid="LEV 13:7" />وإنْ تَفَشَّتِ الطَّفحَةُ في جِلْدِهِ، بَعدَما عَرَضَ نفْسَه على الكاهنِ لأجلِ تَطهيرِهِ، يحضُرُ إلى الكاهنِ ثانيةً. <verse eid="LEV 13:7" /><verse number="8" style="v" pubnumber="8" sid="LEV 13:8" />فإذا رأى الكاهنُ أنَّ الطَّفحَةَ تَفَشَّت في الجِلْدِ، يحكُمُ بِنَجاستِهِ، فهيَ برَصٌ.<verse eid="LEV 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="LEV 13:9" />”وإذا أصابَت أحدًا بَلوى برَصٍ فأُحضِرَ إلى الكاهنِ <verse eid="LEV 13:9" /><verse number="10" style="v" pubnumber="10" sid="LEV 13:10" />ففَحَصَهُ الكاهنُ فرأى في جِلْدِهِ نُتوءًا أبيضَ جعَلَ الشَّعْرَ أبيضَ وكانَ في النُّتوءِ لَحمٌ حيٌّ، <verse eid="LEV 13:10" /><verse number="11" style="v" pubnumber="11" sid="LEV 13:11" />فهوَ برَصٌ مُزمِنٌ في جِلْدِ بدَنِهِ. فيَحكُمُ الكاهنُ بِنَجاستهِ ولا يحجُزُهُ لأنَّهُ نَجِسٌ. <verse eid="LEV 13:11" /><verse number="12" style="v" pubnumber="12" sid="LEV 13:12" />وإنْ خرَجَ البرَصُ في البدَنِ وغطَّى المُبتَلَى بهِ مِنْ رأسِهِ إلى قدَمَيهِ، ممَّا يقَعُ تَحتَ بَصَرِ الكاهنِ، <verse eid="LEV 13:12" /><verse number="13" style="v" pubnumber="13" sid="LEV 13:13" />وفَحَصَهُ الكاهنُ فرأى البرَصَ غطَّى جميعَ بدَنِهِ، يحكُمُ بِطهارَتِهِ لأنَّهُ اَنْقَلبَ كُلُّهُ أبيضَ، فهوَ طاهرٌ. <verse eid="LEV 13:13" /><verse number="14" style="v" pubnumber="14" sid="LEV 13:14" />وإنْ جاءَ يومٌ ظهَرَ في البدَنِ لَحمٌ حيٌّ، فيكونُ نَجِسًا. <verse eid="LEV 13:14" /><verse number="15" style="v" pubnumber="15" sid="LEV 13:15" />فإذا رأى الكاهنُ اللَّحمَ الحيَّ، يحكُمُ بِنَجاستِهِ. فاللَّحمُ الحيُّ نَجِسٌ لأنَّه برَصٌ. <verse eid="LEV 13:15" /><verse number="16" style="v" pubnumber="16" sid="LEV 13:16" />وإنْ رجَعَ اللَّحمُ الحيُّ فاَبيضَّ يَجيءُ الرَّجُلُ إلى الكاهنِ. <verse eid="LEV 13:16" /><verse number="17" style="v" pubnumber="17" sid="LEV 13:17" />فإذا فحَصَهُ الكاهنُ فرأى أنَّ البَلوى اَنقَلَبَت بيضاءَ، يحكُمُ بِطهارتِهِ، فهوَ طاهرٌ.<verse eid="LEV 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="LEV 13:18" />”وإذا كانَ أحدٌ في جِلْدِ بدَنِهِ دُملةٌ فبرِئَت، <verse eid="LEV 13:18" /><verse number="19" style="v" pubnumber="19" sid="LEV 13:19" />فصارَ في موضِعِ الدُّملةِ نُتوءٌ أبيضُ أو لَمعَةٌ بيضاءُ تَميلُ إلى حُمرَةٍ، فلتُعْرَضْ على الكاهنِ. <verse eid="LEV 13:19" /><verse number="20" style="v" pubnumber="20" sid="LEV 13:20" />فإذا فَحَصها الكاهنُ فرأى مَنظرَها أعمقَ مِنَ الجِلْدِ وشَعْرَها أبيضَ، يحكُمُ بِنَجاسَتِهِ. فهيَ بَلوى برَصٍ طَلَعَت في الدُّملةِ. <verse eid="LEV 13:20" /><verse number="21" style="v" pubnumber="21" sid="LEV 13:21" />وإنْ فحَصَها الكاهنُ فما رأى فيها شَعْرًا أبيضَ، ولا وجَدَها أعمَقَ مِنَ الجِلْدِ، وهيَ داكِنَةُ اللَّونِ، يحجُزُهُ سَبعةَ أيّامٍ. <verse eid="LEV 13:21" /><verse number="22" style="v" pubnumber="22" sid="LEV 13:22" />فإنْ هيَ تَفَشَّت في الجِلْدِ يحكُمُ الكاهنُ بِنجاستِهِ، فهيَ بَلوى. <verse eid="LEV 13:22" /><verse number="23" style="v" pubnumber="23" sid="LEV 13:23" />ولكِنْ إنْ وَقَفَتِ اللَّمعَةُ مكانَها ولم تَتَفَشَّ، فهيَ أثَرُ الدُّملَةِ. فيَحكُمُ الكاهنُ بِطهارتِهِ.<verse eid="LEV 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="LEV 13:24" />”وإذا كانَ أحدٌ في جِلْدِ بدَنِهِ كَيُّ نارٍ، وكانَ أثرُ الكَيِّ لَمعَةً بيضاءَ أو بيضاءَ تَميلُ إلى حُمرةٍ، <verse eid="LEV 13:24" /><verse number="25" style="v" pubnumber="25" sid="LEV 13:25" />فيَفحَصُها الكاهنُ. فإنْ كانَ الشَّعْرُ أبيضَ في اللَّمعَةِ، وكانَ مَنظَرُها أعمقَ مِنَ الجِلْدِ، فهذا برَصٌ طَلَعَ في الكَيِّ. فيحكُمُ الكاهنُ بنجاستِهِ. فهوَ بَلوى برَصٍ. <verse eid="LEV 13:25" /><verse number="26" style="v" pubnumber="26" sid="LEV 13:26" />ولكنْ إذا فحَصَها الكاهنُ فما رأى في اللَّمعَةِ شَعْرًا أبيضَ، ولا وجَدَها أعمقَ مِنَ الجِلْدِ، وهيَ داكِنَةُ اللَّونِ، يَحجُزُه سَبعَةَ أيّامٍ. <verse eid="LEV 13:26" /><verse number="27" style="v" pubnumber="27" sid="LEV 13:27" />ثُمَّ يَفحَصُهُ الكاهنُ في اليومِ السَّابعِ، فإنْ كانت تَفَشَّت في الجِلْدِ يَحكُمُ بِنجاستِهِ، فهوَ بَلوى برَصٍ. <verse eid="LEV 13:27" /><verse number="28" style="v" pubnumber="28" sid="LEV 13:28" />وإنْ وقَفَتِ اللَّمعَةُ في مكانِها ولم تَتَفَشَّ في الجِلْدِ وكانت داكِنةَ اللَّونِ، فهيَ نُتوءُ الكَيِّ. فيحكُمُ الكاهنُ بِطهارتِهِ، فهيَ أثَرُ الكَيِّ.<verse eid="LEV 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="LEV 13:29" />”وإذا كانت بِرَجُلٍ أوِ اَمرأةٍ بَلوى في رأسهِ أو ذَقنِهِ، <verse eid="LEV 13:29" /><verse number="30" style="v" pubnumber="30" sid="LEV 13:30" />فليَفحَصِ الكاهنُ البَلوى. فإنْ كانَ مَنظَرُها أعمقَ مِنَ الجِلْدِ، وفيها شَعْرٌ أشقرُ دقيقٌ، يحكُمُ الكاهنُ بِنجاستِهِ، فهوَ قَرَعٌ، أي برَصُ الرَّأسِ أو الذَّقنِ. <verse eid="LEV 13:30" /><verse number="31" style="v" pubnumber="31" sid="LEV 13:31" />فإنْ فحَصَها الكاهنُ ولم يَجِدْ مَنظَرَها أعمقَ مِنَ الجِلْدِ، ولا فيها شَعْرٌ أسودُ، يحجُزُ المُبْتَلَى بالقَرَعِ سَبعَةَ أيّامٍ. <verse eid="LEV 13:31" /><verse number="32" style="v" pubnumber="32" sid="LEV 13:32" />ثُمَّ يَفحَصُهُ في اليومِ السَّابعِ، فإنْ كانَ القَرَعُ غيرَ مُتَفَشٍّ، ولا فيه شَعْرٌ أشقرُ، ولا مَنظَرُهُ أعمقُ مِنَ الجِلْد، <verse eid="LEV 13:32" /><verse number="33" style="v" pubnumber="33" sid="LEV 13:33" />يَحلِقُ الرَّجُلُ شَعْرَه ولا يَحلِقُ موضِعَ القَرَعِ، ويحجُزُهُ الكاهنُ سَبعَةَ أيّامٍ أُخَرَ. <verse eid="LEV 13:33" /><verse number="34" style="v" pubnumber="34" sid="LEV 13:34" />ثُمَّ يَفحَصُه في اليومِ السَّابعِ، فإنْ كانَ القَرَعُ غيرَ مُتَفَشٍّ في الجِلْدِ، ولا مَنظَرُهُ أعمقَ مِنَ الجِلْدِ، يحكُمُ بِطهارتِهِ، فيَغسِلُ ثيابَهُ ويَطهُرُ. <verse eid="LEV 13:34" /><verse number="35" style="v" pubnumber="35" sid="LEV 13:35" />ولكنْ إنْ تَفَشَّى القَرَعُ في جِلْدِ الرَّجُلِ بَعدَما طَهُرَ، <verse eid="LEV 13:35" /><verse number="36" style="v" pubnumber="36" sid="LEV 13:36" />ففَحَصَهُ الكاهنُ فرأى ذلِكَ، فلا يُفَتِّشُ عَنِ الشَّعْرِ الأشقرِ لأنَّ الرَّجُلَ نَجِسٌ. <verse eid="LEV 13:36" /><verse number="37" style="v" pubnumber="37" sid="LEV 13:37" />ولكنْ إنْ رأى أنَّ القَرَعَ وَقَفَ ونَبَتَ فيهِ شَعْرٌ أسودُ، فيكونُ بَرَأ والرَّجُلُ طاهرٌ. فيحكُمُ الكاهنُ بِطهارتِهِ.<verse eid="LEV 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" pubnumber="38" sid="LEV 13:38" />”وإذا كانت لِرَجُلٍ أوِ اَمرأةٍ لُمَعٌ بيضٌ في جِلْدِ بدَنِهِ، <verse eid="LEV 13:38" /><verse number="39" style="v" pubnumber="39" sid="LEV 13:39" />فيَفحَصُهُ الكاهنُ. فإذا كانتِ اللُّمَعُ داكِنةَ اللَّونِ تَميلُ إلى بياضٍ، فهوَ بَهَقٌ خرَجَ في الجِلْدِ، والرَّجُلُ طاهرٌ.<verse eid="LEV 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" pubnumber="40" sid="LEV 13:40" />”مَنْ سقَطَ شَعْرُ رأسِهِ فهوَ أقرعُ، وهو طاهرٌ. <verse eid="LEV 13:40" /><verse number="41" style="v" pubnumber="41" sid="LEV 13:41" />وإنْ كانَ سُقوطُ شَعْرِهِ مِنْ جِهةِ وجهِهِ فهوَ أصلَعُ، وهوَ طاهرٌ. <verse eid="LEV 13:41" /><verse number="42" style="v" pubnumber="42" sid="LEV 13:42" />وإنْ كانَ في الحَصَصِ أوِ الصَّلْعَةِ بَلوى بيضاءُ تَميلُ إلى حُمرةٍ، فهوَ برَصٌ خرَجَ في قُرعتِهِ أو في صَلْعَتِهِ. <verse eid="LEV 13:42" /><verse number="43" style="v" pubnumber="43" sid="LEV 13:43" />فيفحَصُهُ الكاهنُ، فإنْ كانَ نُتوءُ البَلوى أبيضَ مائِلًا إلى حُمرةٍ، كَمَنظَرِ برَصِ جِلْدِ البدَنِ، <verse eid="LEV 13:43" /><verse number="44" style="v" pubnumber="44" sid="LEV 13:44" />فالرَّجُلُ أبرَصُ، وهوَ نَجِسٌ. فيحكُمُ الكاهنُ بِنجاستِهِ مِنَ البَلوى في رأسِهِ.<verse eid="LEV 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" pubnumber="45" sid="LEV 13:45" />”والأبرَصُ الّذي بهِ البَلوى يَلبَسُ ثيابَهُ مَشقُوقةً، ويكشِفُ رأسَه، ويُغَطِّي شاربَيهِ ويُنادي: نَجِسٌ، نَجِسٌ. <verse eid="LEV 13:45" /><verse number="46" style="v" pubnumber="46" sid="LEV 13:46" />ما دامت بهِ البَلوى يكونُ نَجِسًا، ويسكُنُ مُنفرِدًا وفي خارِجِ المَحلَّةِ.<verse eid="LEV 13:46" /></para>
  <para style="s1">شريعة بلوى العفن</para>
  <para style="p">
    <verse number="47" style="v" pubnumber="47" sid="LEV 13:47" />”وإذا كانت بَلوى العَفَنِ في ثوبٍ مِنْ صُوفٍ أو كَتَّانٍ، <verse eid="LEV 13:47" /><verse number="48" style="v" pubnumber="48" sid="LEV 13:48" />أو في ثوبٍ سَداهُ أو لُحمَتُهُ مِنْ كتَّانٍ أو صُوفٍ، أو في جِلْدٍ أو كُلِّ ما يُصنَعُ مِنَ الجِلْدِ، <verse eid="LEV 13:48" /><verse number="49" style="v" pubnumber="49" sid="LEV 13:49" />وكانَ مَنظَرُها لا يَميلُ إلى خُضرةٍ أو حُمرةٍ، فذلِكَ هوَ بَلوى العَفَنِ ويُعرَضُ على الكاهنِ. <verse eid="LEV 13:49" /><verse number="50" style="v" pubnumber="50" sid="LEV 13:50" />فيفحَصُ الكاهنُ البَلوى ويُقفِلُ على المَتاعِ الّذي أصابَتهُ البَلوى سَبعَةَ أيّامٍ. <verse eid="LEV 13:50" /><verse number="51" style="v" pubnumber="51" sid="LEV 13:51" />ثُمَّ يَفحَصُهُ في اليومِ السَّابعِ. فإنْ تَفَشَّت فيه البَلوى تكونُ عَفَنًا مُفسِدًا وهوَ نَجِسٌ. <verse eid="LEV 13:51" /><verse number="52" style="v" pubnumber="52" sid="LEV 13:52" />فيحرقُ الكاهنُ المَتاعَ بالنَّارِ. <verse eid="LEV 13:52" /><verse number="53" style="v" pubnumber="53" sid="LEV 13:53" />وإنْ فَحَصَهُ فرأى أنَّ البَلوى غيرُ مُتَفَشِّيةٍ في المَتاعِ <verse eid="LEV 13:53" /><verse number="54" style="v" pubnumber="54" sid="LEV 13:54" />يأمُرُ بِغَسلِه ويُقفِلُ علَيهِ سَبعَةَ أيّامٍ أُخَرَ. <verse eid="LEV 13:54" /><verse number="55" style="v" pubnumber="55" sid="LEV 13:55" />ثُمَّ يَفحَصُهُ بَعدَ غَسلِهِ، فإنْ رَأى أنَّ البَلوى لم يتَغَيَّرْ مَنظَرُها، ولو كانت غيرَ مُتَفَشِّيةٍ، فهوَ نَجسٌ ويُحرَقُ بالنَّارِ، سَواءٌ كانتِ الضَّربةُ في ظاهِر المَتاعِ أو في باطنِهِ. <verse eid="LEV 13:55" /><verse number="56" style="v" pubnumber="56" sid="LEV 13:56" />فإنْ فَحَصَهُ الكاهنُ بَعدَ غَسلِهِ فرأى البَلوى داكنةَ اللَّونِ فلْيقطَعْها مِنَ الثَّوبِ أو مِنَ الجِلْدِ. <verse eid="LEV 13:56" /><verse number="57" style="v" pubnumber="57" sid="LEV 13:57" />وإنْ ظهرت ثانيةً تكونُ أفرخت، فليَحرقِ المَتاعَ بالنَّارِ. <verse eid="LEV 13:57" /><verse number="58" style="v" pubnumber="58" sid="LEV 13:58" />وإنْ زالتِ البَلوى بَعدَ غَسلِهِ يُغسَلُ ثانيةً ويَطهُرُ.<verse eid="LEV 13:58" /></para>
  <para style="p">
    <verse number="59" style="v" pubnumber="59" sid="LEV 13:59" />هذِهِ شريعةُ بَلوى العَفَنِ في ثوبِ الصُّوفِ أوِ الكتَّانِ، أو في السَّدى أوِ اللُّحمَةِ، أو في جميعِ أمتِعَةِ الجِلْدِ، لِلحُكْم بِنجاسَتِها أو طهارتِها“.<verse eid="LEV 13:59" /></para>
  <chapter eid="LEV 13" />
  <chapter number="14" style="c" sid="LEV 14" />
  <para style="s1">شريعة الأبرص بعد طهره</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="LEV 14:1" />وكلَّمَ الرّبُّ موسى فقالَ: <verse eid="LEV 14:1" /><verse number="2" style="v" pubnumber="2" sid="LEV 14:2" />”هذِهِ تكونُ شريعةُ الأبرَصِ في يومِ طُهْرِهِ: يُؤتَى بهِ إلى الكاهنِ، <verse eid="LEV 14:2" /><verse number="3" style="v" pubnumber="3" sid="LEV 14:3" />فيخرُجُ الكاهنُ إلى خارجِ المحَلَّةِ لِيَفحَصَهُ. فإذا رأى أنَّ الأبرَصَ بَريءٌ مِنْ بَلوى البرَصِ، <verse eid="LEV 14:3" /><verse number="4" style="v" pubnumber="4" sid="LEV 14:4" />يأمرُ الكاهنُ بأنْ يُؤخَذَ للمُتَطَهِّرِ عُصفورانِ حَيَّانِ طاهرانِ، وعودُ أرْزٍ، وقِرمِزٌ وزُوفى. <verse eid="LEV 14:4" /><verse number="5" style="v" pubnumber="5" sid="LEV 14:5" />ويأمُرُ الكاهنُ بذبحِ واحدٍ مِنَ العُصفورَينِ في وعاءِ خَزَفٍ، على ماءٍ جارٍ. <verse eid="LEV 14:5" /><verse number="6" style="v" pubnumber="6" sid="LEV 14:6" />ويأخُذُ العُصفورَ الحَيَّ، وعُودَ الأرْزِ، والقِرمزَ، والزُّوفَى، ويَغمِسُ هذا كُلَّهُ في دَمِ العُصفورِ المَذبوحِ على الماءِ الجاري، <verse eid="LEV 14:6" /><verse number="7" style="v" pubnumber="7" sid="LEV 14:7" />ويَرُشُّ على المُتَطهِّرِ مِنَ البرَصِ سَبعَ مرَّاتٍ، ويُطهِّرُهُ، ويُطلِقُ العُصفورَ الحَيَّ على وجهِ الصَّحراءِ. <verse eid="LEV 14:7" /><verse number="8" style="v" pubnumber="8" sid="LEV 14:8" />ثُمَّ يَغسِلُ المُتَطَهِّرُ ثيابَه، ويَحلِقُ جميعَ شَعْرِهِ، ويَغتَسِلُ بالماءِ، فيطهُرُ. وبَعدَ ذلِكَ يدخُلُ المَحلَّةَ ويُقيمُ في خارجِ خَيمتِهِ سَبعَةَ أيّامٍ، <verse eid="LEV 14:8" /><verse number="9" style="v" pubnumber="9" sid="LEV 14:9" />وفي اليومِ السَّابعِ يَحلِقُ جميعَ شَعْرِ رأسِهِ وذَقنِهِ وحواجِبِ عينيهِ، وجميعَ شَعْرِ بَدَنِهِ، ويَغسِلُ ثيابَهُ ويَستَحِمُّ بالماءِ فيَطهُرُ.<verse eid="LEV 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="LEV 14:10" />”وفي اليومِ الثَّامنِ يأخُذُ خروفَينِ صحيحَينِ ونَعجةً حَوليَّةً صحيحةً وثَلاثةَ أعشارِ القُفَّةِ مِنَ الدَّقيقِ قُربانَ تقدمةٍ مَلتوتةً بِزيتٍ، وحُقَّ زيتٍ. <verse eid="LEV 14:10" /><verse number="11" style="v" pubnumber="11" sid="LEV 14:11" />ويوقِفُ الكاهنُ المُطَهِّرُ الرَّجُلَ المُتَطَهِّرَ معَ قرابينِهِ هذِهِ أمامَ الرّبِّ عِندَ بابِ خَيمةِ الاجتِماعِ. <verse eid="LEV 14:11" /><verse number="12" style="v" pubnumber="12" sid="LEV 14:12" />ويأخُذُ الكاهنُ أحدَ الخروفَينِ ليُقرِّبَهُ ذبيحةَ إثْمٍ، معَ حُقِّ الزَّيتِ، فيُحرِّكُهُما تَحريكًا أمامَ الرّبِّ. <verse eid="LEV 14:12" /><verse number="13" style="v" pubnumber="13" sid="LEV 14:13" />ويذبحُ الخروفَ في الموضِعِ المقدَّسِ حَيثُ يذبحُ ذبيحةَ الخطيئةِ والمُحرَقةَ، لأنَّ ذبيحةَ الإثم هيَ للكاهنِ كذبيحةِ الخطيئةِ، مُقدَّسةٌ كُلَّ التَّقديسِ. <verse eid="LEV 14:13" /><verse number="14" style="v" pubnumber="14" sid="LEV 14:14" />ثُمَّ يأخُذُ مِنْ دَمِ ذبيحةِ الإثْمِ ويضَعُ على شَحْمَةِ أُذُنِ المُتَطَهِّرِ اليُمنى، وعلى إبهامِ يَدِهِ اليُمنى وإبهامِ رِجْلهِ اليُمنى.<verse eid="LEV 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="LEV 14:15" />”ويأخُذُ الكاهنُ مِنْ حُقِّ الزَّيتِ ويَصُبُّ في راحةِ الكاهنِ اليُسرى. <verse eid="LEV 14:15" /><verse number="16" style="v" pubnumber="16" sid="LEV 14:16" />ثُمَّ يَغمسُ إصبَعَهُ اليُمنى في الزَّيتِ الّذي في راحتِهِ اليُسرى، ويَرُشُّ مِنهُ بإصبَعِهِ سَبعَ مرَّاتٍ أمامَ الرّبِّ. <verse eid="LEV 14:16" /><verse number="17" style="v" pubnumber="17" sid="LEV 14:17" />ثُمَّ يأخُذُ مِمَّا بقيَ مِنَ الزَّيتِ في راحتِهِ ومِنْ دَمِ ذبيحةِ الإثْمِ ويضَعُهُ على شَحْمةِ أذُنِ المُتطَهِّرِ اليُمنى، وعلى إبهام يَدِهِ اليُمنى، وعلى إبهامِ رِجْلِهِ اليُمنى. <verse eid="LEV 14:17" /><verse number="18" style="v" pubnumber="18" sid="LEV 14:18" />والباقي مِنَ الزَّيتِ في راحةِ الكاهنِ يَصبُّهُ على رأسِ المُتَطَهِّرِ ويُكَفِّرُ عَنهُ أمامَ الرّبِّ.<verse eid="LEV 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="LEV 14:19" />”ثُمَّ يعمَلُ الكاهنُ ذبيحةَ الخطيئةِ ليُزيلَ عَنِ المُتَطَهِّرِ نجاسَتَهُ، ويذبَحُ المُحرَقةَ <verse eid="LEV 14:19" /><verse number="20" style="v" pubnumber="20" sid="LEV 14:20" />ويُصعِدُها، معَ التَّقدِمَةِ، على المذبَحِ، ويُكفِّرُ عَنهُ الكاهنُ، فيطهُرُ.<verse eid="LEV 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="LEV 14:21" />”وإنْ كانَ المُتَطَهِّرُ فقيرًا لا تَملِكُ يَدُهُ ذلِكَ، فلْيُقَرِّبْ للرّبِّ خروفًا واحدًا ذبيحةَ إثْمٍ يُحرِّكُها الكاهنُ أمامَ الرّبِّ ليُكفِّرَ عَنهُ، ويُقدِّمُ قُفَّةً مِنَ الدَّقيقِ مَلتوتًا بزيتٍ وحُقَّ زيتٍ، <verse eid="LEV 14:21" /><verse number="22" style="v" pubnumber="22" sid="LEV 14:22" />ويمامَتَينِ أو فَرخَي حمامٍ، على حسَبِ ما تَملِكُ يدُهُ، فيكونُ أحدُهُما ذبيحةَ خطيئةٍ والآخَرُ مُحرَقةً.<verse eid="LEV 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="LEV 14:23" />”يَجيءُ المُتَطَهِّرُ بِذلِكَ كُلِّهِ، في اليومِ الثَّامنِ مِنْ طُهْرِهِ، إلى الكاهنِ عِندَ بابِ خَيمةِ الاجتِماعِ أمامَ الرّبِّ. <verse eid="LEV 14:23" /><verse number="24" style="v" pubnumber="24" sid="LEV 14:24" />فيأخُذُ الكاهنُ خروفَ ذبيحةِ الإثْمِ، وحُقَّ الزَّيتِ، ويُحَرِّكُهُما تَحريكًا أمامَ الرّبِّ. <verse eid="LEV 14:24" /><verse number="25" style="v" pubnumber="25" sid="LEV 14:25" />ثُمَّ يذبَحُ الخروفَ ويأخُذُ مِنْ دمِهِ ويضَعُ على شَحْمَةِ أذُنِ المُتَطَهِّرِ اليُمنى، وعلى إبهامِ يَدِهِ اليُمنى، وعلى إبهامِ رجْلِهِ اليُمنى. <verse eid="LEV 14:25" /><verse number="26" style="v" pubnumber="26" sid="LEV 14:26" />ويَصُبُّ الكاهنُ زيتًا في راحتِهِ اليُسرى <verse eid="LEV 14:26" /><verse number="27" style="v" pubnumber="27" sid="LEV 14:27" />ويَرُشُّ مِنهُ بإصبَعِه اليُمنى سَبعَ مرَّاتٍ أمامَ الرّبِّ، <verse eid="LEV 14:27" /><verse number="28" style="v" pubnumber="28" sid="LEV 14:28" />ويضَعُ مِنهُ على شَحْمَةِ أذُنِ المُتَطَهِّرِ اليُمنى، وعلى إبهامِ يَدِهِ اليُمنى، وعلى إبهامِ رِجلِه اليُمنى، حَيثُ وضَعَ دَمَ ذبيحةِ الإثْمِ. <verse eid="LEV 14:28" /><verse number="29" style="v" pubnumber="29" sid="LEV 14:29" />والباقي مِنْ هذا الزَّيتِ يضَعُهُ على رأسِ المُتَطَهِّرِ تكفيرًا عَنهُ أمامَ الرّبِّ.<verse eid="LEV 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="LEV 14:30" />”ثُمَّ يُقَرِّبُ المُتَطَهِّرُ مِنَ اليمامَتَينِ أو فَرخَي الحمامِ، على حسَبِ ما تَملِكُه يَدُهُ، <verse eid="LEV 14:30" /><verse number="31" style="v" pubnumber="31" sid="LEV 14:31" />واحدًا ذبيحةَ خطيئةٍ والآخَرَ مُحرَقةً معَ تقدِمةٍ ويُكَفِّرُ الكاهنُ عَنهُ أمامَ الرّبِّ.<verse eid="LEV 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" pubnumber="32" sid="LEV 14:32" />”هذِهِ شريعةُ مَنْ كانت بهِ بَلوى برَصٍ ولا يَملِكُ لَوازِمَ تطهيرِهِ مِنها“.<verse eid="LEV 14:32" /></para>
  <para style="s1">بلوى العفن في البيوت</para>
  <para style="p">
    <verse number="33" style="v" pubnumber="33" sid="LEV 14:33" />وكلَّم الرّبُّ موسى وهرونَ فقالَ: <verse eid="LEV 14:33" /><verse number="34" style="v" pubnumber="34" sid="LEV 14:34" />”متى دخَلْتُم أرضَ كنعانَ الّتي أعطَيتُها لكُم مُلْكًا، فأنزَلْتُ بَلوى العَفَنِ بِبَيتٍ في أرضِكُم، <verse eid="LEV 14:34" /><verse number="35" style="v" pubnumber="35" sid="LEV 14:35" />يجيءُ صاحبُ البيتِ إلى الكاهنِ ويقولُ لَه: تبيَّنَ لي في البيتِ ما يُشبِهُ البَلوى. <verse eid="LEV 14:35" /><verse number="36" style="v" pubnumber="36" sid="LEV 14:36" />فيأمُرُ الكاهنُ بإخلاءِ البيتِ، قَبلَ أنْ يدخُلَهُ، ليفحَصَ البَلوى لِئلَّا يَتَنجَّسَ جميعُ ما في البيتِ، ثُمَّ يدخُلُ لِيَرى البيتَ. <verse eid="LEV 14:36" /><verse number="37" style="v" pubnumber="37" sid="LEV 14:37" />فإنْ كانتِ البَلوى في حيطانِ البيتِ بُقعًا مُحمَرَّةً أو مُخضَرَّةً، ومَنظَرُها عَميقٌ في الحائِطِ، <verse eid="LEV 14:37" /><verse number="38" style="v" pubnumber="38" sid="LEV 14:38" />يَخرُجُ الكاهنُ مِنَ البيتِ ويُقفِلُهُ سَبعةَ أيّامٍ. <verse eid="LEV 14:38" /><verse number="39" style="v" pubnumber="39" sid="LEV 14:39" />ثُمَّ يرجِعُ في اليومِ السَّابعِ ويَفحصُهُ، فإنْ كانتِ البَلوى تفَشَّت في حيطانِهِ، <verse eid="LEV 14:39" /><verse number="40" style="v" pubnumber="40" sid="LEV 14:40" />يأمرُ بِقَلْعِ الحجارةِ المُبتَلاةِ وطَرْحِها في موضِعٍ نَجسٍ خارجَ المدينةِ، <verse eid="LEV 14:40" /><verse number="41" style="v" pubnumber="41" sid="LEV 14:41" />وبِقَشْرِ حيطانِ داخلِ البيتِ مِنْ كُلِّ جهةٍ وطَرْحِ التُّرابِ المَقشورِ في موضعٍ نَجِسٍ خارجَ المدينةِ. <verse eid="LEV 14:41" /><verse number="42" style="v" pubnumber="42" sid="LEV 14:42" />وتُؤخذُ حجارةٌ أُخَرُ وتوضَعُ مكانَ الحِجارةِ المَقلوعةِ، ويُؤخَذُ تُرابٌ آخَرُ ويُطيَّنُ البيتُ. <verse eid="LEV 14:42" /><verse number="43" style="v" pubnumber="43" sid="LEV 14:43" />فإنْ عادتِ البَلوى وطَلَعَت في البيتِ بَعدَ قَلْعِ الحجارةِ وقَشْرِ البيتِ وتَطيينِهِ، <verse eid="LEV 14:43" /><verse number="44" style="v" pubnumber="44" sid="LEV 14:44" />يدخُلُ الكاهنُ ويَفحَصُه، فإذا رأى البَلوى تَفشَّت فيهِ، فهيَ عَفَنٌ مُفسِدٌ، والبيتُ نَجِسٌ. <verse eid="LEV 14:44" /><verse number="45" style="v" pubnumber="45" sid="LEV 14:45" />فيُهدَمُ بِحجارتِه وخشَبِهِ وجميعِ تُرابِه، ويُطرَحُ في موضِعٍ نَجِسٍ خارجَ المدينةِ. <verse eid="LEV 14:45" /><verse number="46" style="v" pubnumber="46" sid="LEV 14:46" />ومَنْ دخلَ البيتَ طُولَ الأيّامِ الّتي يُقفَلُ فيها يكونُ نَجِسًا إلى المَغيبِ. <verse eid="LEV 14:46" /><verse number="47" style="v" pubnumber="47" sid="LEV 14:47" />ومَنْ نامَ فيه أو أكلَ، فلْيَغسِل ثيابَه.<verse eid="LEV 14:47" /></para>
  <para style="p">
    <verse number="48" style="v" pubnumber="48" sid="LEV 14:48" />”وإنْ دَخلَ الكاهنُ البيتَ وفحَصَهُ فرأى أنَّ البَلوى غيرُ مُتَفَشِّيةٍ فيهِ بَعدَ تَطيينِهِ، فليُطَهِّرْهُ لأنَّ البَلوى زالت مِنهُ. <verse eid="LEV 14:48" /><verse number="49" style="v" pubnumber="49" sid="LEV 14:49" />فيأخُذُ لِتَطْهيرِه عُصفُورَينِ، وعُودَ أرْزٍ، وقِرمِزًا، وزُوفى. <verse eid="LEV 14:49" /><verse number="50" style="v" pubnumber="50" sid="LEV 14:50" />ويذبحُ واحدًا مِنَ العُصفُورَينِ في وِعاءِ خزَفٍ على ماءٍ جارٍ. <verse eid="LEV 14:50" /><verse number="51" style="v" pubnumber="51" sid="LEV 14:51" />ويأخُذُ عُودَ الأرْزِ، والزُوفى، والقِرمِزَ، والعُصفُورَ الحَيَّ، ويَغمِسُ ذلِكَ كُلَّه في دَمِ العُصفُورِ المَذبُوحِ، وفي الماءِ الجاري، ويَرُشُّ على البيتِ سَبعَ مرَّاتٍ. <verse eid="LEV 14:51" /><verse number="52" style="v" pubnumber="52" sid="LEV 14:52" />ويُطهِّرُ البيتَ بدَمِ العُصفُورِ وبالماءِ الجاري والعُصفُورِ الحَيِّ وعُودِ الأرْزِ، والزُوفى والقِرمزِ. <verse eid="LEV 14:52" /><verse number="53" style="v" pubnumber="53" sid="LEV 14:53" />ثُمَّ يُطلِقُ العُصفُورَ الحَيَّ إلى خارجِ المدينةِ على وجهِ الصَّحراءِ. ويُكفِّرُ عنِ البيتِ فيَطْهُرُ.<verse eid="LEV 14:53" /></para>
  <para style="p">
    <verse number="54" style="v" pubnumber="54" sid="LEV 14:54" />”تِلكَ هيَ الشَّريعةُ لِكُلٍّ مِنْ بَلوى البرَصِ والقَرَعِ <verse eid="LEV 14:54" /><verse number="55" style="v" pubnumber="55" sid="LEV 14:55" />والعَفَنِ في الثِّيابِ والبُيوتِ، <verse eid="LEV 14:55" /><verse number="56" style="v" pubnumber="56" sid="LEV 14:56" />ومِنَ النُّتوءِ وطَفْحَةِ الجِلْدِ واللَّمعةِ، <verse eid="LEV 14:56" /><verse number="57" style="v" pubnumber="57" sid="LEV 14:57" />حتّى تعرِفوا متى تكونُ النَّجاسةُ والطَّهارةُ“.<verse eid="LEV 14:57" /></para>
  <chapter eid="LEV 14" />
  <chapter number="15" style="c" sid="LEV 15" />
  <para style="s1">شريعة ما يفرزه الجسد</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="LEV 15:1" />وكلَّمَ الرّبُّ موسى وهرونَ فقالَ: <verse eid="LEV 15:1" /><verse number="2" style="v" pubnumber="2" sid="LEV 15:2" />”قُولا لِبَني إِسرائيلَ: مَنْ كانَ بِجسدِهِ سَيَلانٌ فهوَ نَجِسٌ <verse eid="LEV 15:2" /><verse number="3" style="v" pubnumber="3" sid="LEV 15:3" />سَواءٌ سالَ مِنْ جسَدِهِ أوِ اَحْتقَنَ جسَدُهُ بهِ. <verse eid="LEV 15:3" /><verse number="4" style="v" pubnumber="4" sid="LEV 15:4" />كُلُّ فِراشٍ يستَلقي علَيهِ يكونُ نَجِسًا، وكُلُّ ما يَجلِسُ علَيهِ مِنَ الأمتِعَةِ يكونُ نَجِسًا. <verse eid="LEV 15:4" /><verse number="5" style="v" pubnumber="5" sid="LEV 15:5" />ومَنْ مَسَّ فِراشَهُ، فليَغسِلْ ثيابَهُ ويَستَحِمَّ بِالماءِ، ويكونُ نَجِسًا إلى المَغيبِ. <verse eid="LEV 15:5" /><verse number="6" style="v" pubnumber="6" sid="LEV 15:6" />ومَنْ جلَسَ على ما يَجلِسُ علَيهِ صاحبُ السَّيَلانِ، فليَغسِلْ ثيابَهُ ويَستَحِمَّ بِالماءِ ويكونُ نَجِسًا إلى المَغيبِ. <verse eid="LEV 15:6" /><verse number="7" style="v" pubnumber="7" sid="LEV 15:7" />ومَنْ لَمَسَ جسَدَ صاحبِ السَّيَلانِ، فليَغسِلْ ثيابَهُ ويَستَحِمَّ بالماءِ ويكونُ نَجِسًا إلى المَغيبِ. <verse eid="LEV 15:7" /><verse number="8" style="v" pubnumber="8" sid="LEV 15:8" />وإنْ بصَقَ صاحبُ السَّيلانِ على الطَّاهرِ، فليَغسِلِ الطَّاهرُ ثيابَهُ ويَستَحِمَّ بالماءِ، ويكونُ نَجِسًا إلى المَغيبِ. <verse eid="LEV 15:8" /><verse number="9" style="v" pubnumber="9" sid="LEV 15:9" />كُلُّ ما يركَبُ علَيهِ صاحبُ السَّيلانِ يكونُ نَجِسًا. <verse eid="LEV 15:9" /><verse number="10" style="v" pubnumber="10" sid="LEV 15:10" />فمَنْ لمَسَ شيئًا مِمَّا كانَ تحتَهُ يكونُ نَجِسًا إلى المَغيبِ. ومَنْ حمَلَ شيئًا مِنهُ يَغسِلُ ثيابَهُ ويَستَحِمُّ بالماءِ، ويكونُ نَجِسًا إلى المَغيبِ. <verse eid="LEV 15:10" /><verse number="11" style="v" pubnumber="11" sid="LEV 15:11" />وكلُّ مَنْ لمَسَهُ صاحبُ السَّيَلانِ بيدَينِ غيرِ مَغسولَتَينِ بالماءِ، فليَغسِلْ ثيابَهُ ويستحمَّ بالماءِ، ويكونُ نَجِسًا إلى المَغيبِ. <verse eid="LEV 15:11" /><verse number="12" style="v" pubnumber="12" sid="LEV 15:12" />وإذا لمَسَ صاحبُ السَّيَلانِ وِعاءَ خزَفٍ فليُكْسَرْ، أو وِعاءَ خشَبٍ فليُغْسَلْ بالماءِ. <verse eid="LEV 15:12" /><verse number="13" style="v" pubnumber="13" sid="LEV 15:13" />وإذا طَهُرَ مِنْ سَيلانِه ينتَظِرُ سَبعَةَ أيّامٍ، ثُمَّ يَغسِلُ ثيابَه ويَستَحمُّ بماءٍ حارٍّ. <verse eid="LEV 15:13" /><verse number="14" style="v" pubnumber="14" sid="LEV 15:14" />وفي اليومِ الثَّامنِ يأخُذُ لَه يَمامتَينِ أو فَرخَي حمامٍ ويجيءُ إلى أمامِ الرّبِّ، إلى بابِ خَيمةِ الاجتماعِ، ويدفعُهُما إلى الكاهنِ. <verse eid="LEV 15:14" /><verse number="15" style="v" pubnumber="15" sid="LEV 15:15" />فيُقرِّبُ الكاهنُ أحدَهُما ذبيحةَ خطيئةٍ والآخرَ مُحرَقةً، ويُكفِّرُ عَنهُ أمامَ الرّبِّ.<verse eid="LEV 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="LEV 15:16" />”وإذا خرَجَت مِنْ رَجُلٍ نُطفَةُ مُضاجَعةٍ، فليَغسِلْ جميعَ بدَنِه بالماءِ، ويكونُ نَجِسًا إلى المَغيبِ. <verse eid="LEV 15:16" /><verse number="17" style="v" pubnumber="17" sid="LEV 15:17" />وأيُّ ثوبٍ أو جِلْدٍ أصابَهُ مِنها شيءٌ، فليُغسَلْ بالماءِ، ويكونُ نَجِسًا إلى المَغيبِ. <verse eid="LEV 15:17" /><verse number="18" style="v" pubnumber="18" sid="LEV 15:18" />وإذا ضاجعَ رَجُلٌ امرأةً بنُطفَةٍ، فلْيسَتحِمَّا بالماءِ ويكونانِ نجِسَينِ إلى المَغيبِ.<verse eid="LEV 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="LEV 15:19" />”وإذا كانَ باَمرأةٍ سَيلانُ دَمٍ مِنْ جسَدِها كعادةِ النِّساءِ، فسَبعَةُ أيّامٍ تكونُ في طَمْثِها، وكُلُّ مَنْ لمَسَها يكونُ نَجِسًا إلى المَغيبِ. <verse eid="LEV 15:19" /><verse number="20" style="v" pubnumber="20" sid="LEV 15:20" />وجميعُ ما تَضطَجِعُ أو تجلِسُ علَيهِ في طَمْثِها يكونُ نَجِسًا، <verse eid="LEV 15:20" /><verse number="21" style="v" pubnumber="21" sid="LEV 15:21" />وكُلُّ مَنْ لمَسَ فِراشَها يَغسِلُ ثيابَهُ ويَستَحِمُّ بالماءِ، ويكونُ نَجِسًا إلى المَغيبِ. <verse eid="LEV 15:21" /><verse number="22" style="v" pubnumber="22" sid="LEV 15:22" />مَنْ لمَسَ شيئًا مِمَّا تجلِسُ علَيهِ يغسِلُ ثيابَهُ ويَستَحِمُّ بالماءِ، ويكونُ نَجِسًا إلى المَغيبِ. <verse eid="LEV 15:22" /><verse number="23" style="v" pubnumber="23" sid="LEV 15:23" />وإنْ كانَ على فِراشِها أو على ما هيَ جالِسةٌ علَيهِ شيءٌ، فَمَنْ لمَسَهُ يكونُ نَجِسًا إلى المَغيبِ. <verse eid="LEV 15:23" /><verse number="24" style="v" pubnumber="24" sid="LEV 15:24" />وإنْ ضاجَعَها رَجُلٌ فصارَ طَمْثُها علَيهِ يكونُ نَجِسًا سَبعةَ أيّامٍ، وكُلُّ فِراشٍ يَستَلقي علَيهِ يكونُ نَجِسًا.<verse eid="LEV 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="LEV 15:25" />”وإذا سالَ دَمُ امرأةٍ أيّامًا كثيرةً في غيرِ وقتِ طَمْثِها أو بَعدَهُ، فلْتَكُنْ في جميعِ أيّامِ سَيَلانِها نَجِسةً كما في أيّامِ طَمْثِها. <verse eid="LEV 15:25" /><verse number="26" style="v" pubnumber="26" sid="LEV 15:26" />فكُلُّ فِراشٍ تَستَلقي علَيهِ وكُلُّ ما تجلِسُ علَيهِ يكونُ نَجِسًا. <verse eid="LEV 15:26" /><verse number="27" style="v" pubnumber="27" sid="LEV 15:27" />وكلُّ مَنْ لمَسَ شيئًا مِنها يكونُ نَجِسًا، فيَغسِلُ ثيابَهُ ويَستَحِمُّ بالماءِ ويكونُ نَجِسًا إلى المَغيبِ. <verse eid="LEV 15:27" /><verse number="28" style="v" pubnumber="28" sid="LEV 15:28" />وإذا طَهُرَت مِنْ سَيَلانِها فلتَنتَظِرْ سَبعَةَ أيّامٍ، ثُمَّ تَطهُرُ. <verse eid="LEV 15:28" /><verse number="29" style="v" pubnumber="29" sid="LEV 15:29" />وفي اليومِ الثَّامنِ تأخُذُ لها يَمامتَينِ أو فَرخَي حمامٍ وتجيءُ بهما إلى الكاهنِ، إلى بابِ خَيمةِ الاجتِماعِ، <verse eid="LEV 15:29" /><verse number="30" style="v" pubnumber="30" sid="LEV 15:30" />فيُقَرِّبُ الكاهنُ أحدَهُما للرّبِّ ذبيحةَ خطيئةٍ والآخَرَ مُحرَقةً، ويُكفِّرُ عَنها الكاهنُ أمامَ الرّبِّ سَيَلانَ نَجاستِها.<verse eid="LEV 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" pubnumber="31" sid="LEV 15:31" />”هكذا تُجنِّبانِ بَني إِسرائيلَ النَّجاسةَ لِئلَّا يموتوا في نَجاستِهم بِتَنجيسِهِم مَسكِني الّذي بَينَهم.<verse eid="LEV 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" pubnumber="32" sid="LEV 15:32" />”تِلكَ شريعةُ مَنْ بهِ سَيَلانٌ ومَنْ يَخرُجُ مِنْهُ نُطفَةُ مُضاجَعةٍ فَيَتَنَجَّسُ بِهِما، <verse eid="LEV 15:32" /><verse number="33" style="v" pubnumber="33" sid="LEV 15:33" />وشريعةُ المرأةِ في أيّامِ طَمْثِها ومَنْ بِهِ سَيَلانٌ، ذَكَرًا أو أُنثى، وشريعةُ الرَّجُلِ الّذي يضاجِعُ نَجِسَةً“.<verse eid="LEV 15:33" /></para>
  <chapter eid="LEV 15" />
  <chapter number="16" style="c" sid="LEV 16" />
  <para style="s1">يوم الكفارة</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="LEV 16:1" />وكلَّمَ الرّبُّ موسى بَعدَ موتِ اَبنَي هرونَ لأنَّهما قدَّما أمامَ الرّبِّ نارًا غيرَ مُقدَّسةٍ <verse eid="LEV 16:1" /><verse number="2" style="v" pubnumber="2" sid="LEV 16:2" />فقالَ لَه: ”قلْ لهرونَ أخيكَ أنْ لا يدخُلَ في كُلِّ وقتٍ إلى القُدْسِ إلى داخلِ الحِجابِ، أمامَ الغِطاءِ الّذي على تابوتِ العَهدِ لِئلَّا يموتَ، لأنِّي أظهَرُ في السَّحابِ فَوقَ الغِطاءِ. <verse eid="LEV 16:2" /><verse number="3" style="v" pubnumber="3" sid="LEV 16:3" />يُمكِنُه أنْ يدخُلَ القُدْسَ إذا جاءَ بِعِجْلٍ مِنَ البقَرِ لذبيحةِ الخطيئةِ وبِكَبْشٍ للمُحرَقةِ. <verse eid="LEV 16:3" /><verse number="4" style="v" pubnumber="4" sid="LEV 16:4" />ويَلبَسُ قميصًا مِنْ كَتَّانٍ مُقدَّسًا، ويكونُ على بدَنِه سِروالٌ مِنْ كَتَّانٍ وعلى وسَطهِ حِزامٌ مِنْ كَتَّانٍ، ويضَعُ على رأسهِ عِمامةً مِنْ كَتَّانٍ. وهيَ ثيابٌ مُقدَّسةٌ يَغسِلُ بدَنَهُ بماءٍ قَبلَ أنْ يَلبَسَها. <verse eid="LEV 16:4" /><verse number="5" style="v" pubnumber="5" sid="LEV 16:5" />ويأخُذُ مِنْ عِندِ جماعةِ بَني إِسرائيلَ تَيسَينِ مِنَ المعَزِ لذبيحةِ الخطيئةِ وكَبْشًا للمُحرَقةِ. <verse eid="LEV 16:5" /><verse number="6" style="v" pubnumber="6" sid="LEV 16:6" />فيُقرِّبُ هرونُ عِجْلَ ذبيحةِ الخطيئةِ الّذي لَه، ويُكفِّرُ عَنْ نفْسِهِ وعَنْ أهلِ بيتهِ <verse eid="LEV 16:6" /><verse number="7" style="v" pubnumber="7" sid="LEV 16:7" />ثُمَّ يأخُذُ التَّيسَينِ ويُوقِفُهما أمامَ الرّبِّ عِندَ بابِ خيمةِ الاجتِماعِ <verse eid="LEV 16:7" /><verse number="8" style="v" pubnumber="8" sid="LEV 16:8" />ويُلقي علَيهما قُرعتَينِ: إحداهُما للرّبِّ وأخرى لعَزازيلَ. <verse eid="LEV 16:8" /><verse number="9" style="v" pubnumber="9" sid="LEV 16:9" />فالتَّيسُ الّذي وقعت علَيهِ القُرعَةُ يُقَرِّبُه للرّبِّ ذبيحةَ خطيئةٍ، <verse eid="LEV 16:9" /><verse number="10" style="v" pubnumber="10" sid="LEV 16:10" />أمَّا الآخرُ الّذي وقعت علَيهِ القُرعةُ لعَزازيلَ فيوقِفُهُ حَيًّا أمامَ الرّبِّ ليُكفِّرَ عَنهُ، ويُرسلُهُ إلى عَزازيلَ في البرِّيَّةِ.<verse eid="LEV 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="LEV 16:11" />”وحينَ يُقَرِّبُ هرونُ عِجْلَ الخطيئةِ الّذي لَه ويُكفِّرُ عَنْ نفْسهِ وعَنْ أهلِ بَيتهِ، <verse eid="LEV 16:11" /><verse number="12" style="v" pubnumber="12" sid="LEV 16:12" />يملأُ المِجمَرةَ جَمرَ نارٍ مِنْ فَوقِ المذبحِ أمامَ الرّبِّ، كما يملأُ راحتَيهِ بَخورًا عَطِرًا مَدقوقًا، ويدخلُ بها إلى داخلِ الحِجابِ، <verse eid="LEV 16:12" /><verse number="13" style="v" pubnumber="13" sid="LEV 16:13" />ويُلقي البَخورَ على النَّارِ أمامَ الرّبِّ حتى يُغطِّيَ دُخانُه الغِطاءَ على تابوتِ العَهدِ، فلا يراهُ لِئلَّا يموتَ. <verse eid="LEV 16:13" /><verse number="14" style="v" pubnumber="14" sid="LEV 16:14" />ويأخُذُ مِنْ دَمِ العِجْلِ، فيَرُشُّ بإصبَعِهِ على وجهِ الغِطاءِ، ثُمَّ يرشُّ أمامَ الغِطاءِ سَبعَ مرَّات.<verse eid="LEV 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="LEV 16:15" />”وبَعدَ ذلِكَ يذبحُ تَيسَ الخطيئةِ الّذي للشَّعبِ، ويدخُلُ بِدَمِهِ إلى داخلِ الحِجابِ ويَرُشُّ مِنهُ على وجهِ الغِطاءِ وأمامَه، كما فعَلَ بدَمِ عِجْلِ الخطيئةِ. <verse eid="LEV 16:15" /><verse number="16" style="v" pubnumber="16" sid="LEV 16:16" />ويُكفِّرُ عنِ القُدْسِ مِنْ نَجاسةِ بَني إِسرائيلَ ومعاصيهِم وجميعِ خطاياهُم. وكذلِكَ يفعلُ بخيمةِ الاجتِماعِ القائمةِ وسَطَ نجاساتِهِم. <verse eid="LEV 16:16" /><verse number="17" style="v" pubnumber="17" sid="LEV 16:17" />ولا يَكُنْ أحدٌ في خَيمةِ الاجتِماعِ، مُنذُ دُخولِهِ للتَّكفيرِ في القُدْسِ إلى أنْ يخرُجَ، فيُكفِّرُ عَنْ نفْسِهِ وعَنْ بَيتِهِ وعَنْ كُلِّ جماعةِ بَني إِسرائيلَ. <verse eid="LEV 16:17" /><verse number="18" style="v" pubnumber="18" sid="LEV 16:18" />ثُمَّ يخرُجُ إلى المذبَحِ الّذي أمامَ الرّبِّ ويُكفِّرُ عَنهُ، فيأخُذُ مِنْ دَمِ العِجْلِ ودَمِ التَّيسِ ويضَعُ على قُرونِ المذبَحِ مِنْ كلِّ جِهةٍ. <verse eid="LEV 16:18" /><verse number="19" style="v" pubnumber="19" sid="LEV 16:19" />ويَرُشُّ علَيهِ مِنَ الدَّمِ بإصبَعِهِ سَبعَ مرَّاتٍ، ويُطهِّرُهُ ويقدِّسُهُ مِنْ نَجاسةِ بَني إِسرائيلَ. <verse eid="LEV 16:19" /><verse number="20" style="v" pubnumber="20" sid="LEV 16:20" />ومتى فرَغَ مِنَ التَّكفيرِ عَنِ القُدْسِ وعَنْ خَيمةِ الاجتِماعِ وعَنِ المذبَحِ، يُقرِّبُ التَّيسَ الحَيَّ <verse eid="LEV 16:20" /><verse number="21" style="v" pubnumber="21" sid="LEV 16:21" />ويضَعُ يَديهِ على رأسِ التَّيسِ ويعتَرِفُ علَيه بجميعِ آثامِ بَني إِسرائيلَ ومعاصيهِم وخطاياهُم وبذلِكَ يضَعُها على رأسِ التَّيسِ ويرسِلُهُ إلى البرِّيَّةِ بِيَدِ رُجلٍ مُستعِدٍّ لِذلِكَ. <verse eid="LEV 16:21" /><verse number="22" style="v" pubnumber="22" sid="LEV 16:22" />فيَحمِلُ التَّيسُ جميعَ ذُنوبِهِم إلى أرضٍ مُنقطِعةٍ.<verse eid="LEV 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="LEV 16:23" />”وبَعدَ أنْ يُرسِلَ التَّيسَ يدخُلُ هرونُ خيمةَ الاجتِماعِ ويَنزِعُ الثِّيابَ الكَّتانَ الّتي لَبِسَها عِندَ دُخولهِ القُدْسَ ويتركُها هُناكَ. <verse eid="LEV 16:23" /><verse number="24" style="v" pubnumber="24" sid="LEV 16:24" />ثُمَّ يَغسِلُ بدَنَهُ بالماءِ في موضِعٍ مُقدَّسٍ ويَلبَسُ ثيابَهُ ويَخرُجُ، فيقرِّبُ للرّبِّ مُحرَقَتَهُ ومُحرَقةَ الشَّعبِ، ويُكفِّرُ عَنْ نفْسِهِ وعَنِ الشَّعبِ. <verse eid="LEV 16:24" /><verse number="25" style="v" pubnumber="25" sid="LEV 16:25" />وشَحْمُ ذبيحةِ الخطيئةِ يَحرقُهُ على المذبَحِ. <verse eid="LEV 16:25" /><verse number="26" style="v" pubnumber="26" sid="LEV 16:26" />والّذي يُرسِلُ تَيسَ عَزازيلَ يَغسِلُ ثيابَه ويَستحمُّ بالماءِ، وبَعدَ ذلِكَ يَدخُلُ المَحلَّةَ. <verse eid="LEV 16:26" /><verse number="27" style="v" pubnumber="27" sid="LEV 16:27" />وأمَّا عِجْلُ الخطيئةِ وتَيسُ الخطيئةِ اللَّذانِ دخَلَ هرونُ بدَمهِما للتَّكفيرِ في القُدْسِ، فيُخرَجَانِ إلى خارجِ المَحلَّةِ وتُحرَقُ جُلودُهُما ولَحمُهُما ورَوثُهُما بالنَّارِ. <verse eid="LEV 16:27" /><verse number="28" style="v" pubnumber="28" sid="LEV 16:28" />والّذي يَحرقُهُما يَغسِلُ ثيابَهُ ويَستحمُّ بالماءِ، وبَعدَ ذلِكَ يدخُلُ المَحلَّةَ.<verse eid="LEV 16:28" /></para>
  <para style="s1">فريضة السبت</para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="LEV 16:29" />”وهذا يكونُ لكم فريضةً أبديَّةً: في اليومِ العاشرِ مِنَ الشَّهرِ السَّابعِ تُذَلِّلونَ نفوسَكُم بالصَّومِ ولا تعمَلونَ عَملًا، الأصيلُ فيكُم والغريبُ والدَّخيلُ، <verse eid="LEV 16:29" /><verse number="30" style="v" pubnumber="30" sid="LEV 16:30" />لأنَّهُ في هذا اليومِ يُكفِّرُ عَنكُم لِتَطهيرِكُم، فتَطهَرونَ مِنْ جميعِ خطاياكم أمامَ الرّبِّ. <verse eid="LEV 16:30" /><verse number="31" style="v" pubnumber="31" sid="LEV 16:31" />هوَ سَبْتُ عُطلةٍ لكم تُذَلِّلونَ فيهِ نفوسَكُم بالصَّومِ ويكونُ فريضةً أبديَّةً. <verse eid="LEV 16:31" /><verse number="32" style="v" pubnumber="32" sid="LEV 16:32" />والكاهنُ المَمسوحُ كاهنًا مكانَ أبيهِ يَلبسُ ثيابَ الكَتَّانِ المُقَدَّسةَ ويُكفِّرُ عَنكُم <verse eid="LEV 16:32" /><verse number="33" style="v" pubnumber="33" sid="LEV 16:33" />وعَنِ القُدْسِ وخَيمةِ الاجتِماعِ والمذبحِ، وعَنِ الكهنَةِ والجماعةِ كُلِّهم. <verse eid="LEV 16:33" /><verse number="34" style="v" pubnumber="34" sid="LEV 16:34" />فيكونُ هذا لكُم فريضةً أبديَّةً لتكفيرِ جميعِ الخطايا عَنْ بَني إِسرائيلَ مرَّةً واحدةً في السَّنةِ“. فكانَ كما أمرَ الرّبُّ موسى.<verse eid="LEV 16:34" /></para>
  <chapter eid="LEV 16" />
  <chapter number="17" style="c" sid="LEV 17" />
  <para style="s1">قداسة الدم</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="LEV 17:1" />وقالَ الرّبُّ لموسى: <verse eid="LEV 17:1" /><verse number="2" style="v" pubnumber="2" sid="LEV 17:2" />”قُلْ لهرونَ وبَنيهِ وسائرِ بَني إِسرائيلَ: هذا ما أمرَ الرّبُّ بهِ: <verse eid="LEV 17:2" /><verse number="3" style="v" pubnumber="3" sid="LEV 17:3" />كُلُّ إِسرائيليٍّ ذبَحَ بقَرًا أو غنَمًا أو معَزًا في المَحلَّةِ أو في خارجِ المَحلَّةِ <verse eid="LEV 17:3" /><verse number="4" style="v" pubnumber="4" sid="LEV 17:4" />ولم يَجِئ بِهِ إلى بابِ خَيمةِ الاجتِماعِ ليُقدِّمَهُ قُربانًا للرّبِّ أمامَ مَسكِنِهِ، أُحاسِبُهُ كَمَنْ سفَكَ دَمًا وأقطعُهُ مِنْ بَينِ شعبِهِ. <verse eid="LEV 17:4" /><verse number="5" style="v" pubnumber="5" sid="LEV 17:5" />فعلَى بَني إِسرائيلَ مِنَ الآنَ فصاعِدًا أنْ يَجيئوا بذبَائحِهِمِ الّتي كانوا يذبحونَها في الصَّحراءِ، يَجيئونَ بها إلى الرّبِّ إلى الكاهنِ عِندَ بابِ خَيمةِ الاجتِماعِ، ويذبَحونَها ذبائحَ سلامةٍ للرّبِّ. <verse eid="LEV 17:5" /><verse number="6" style="v" pubnumber="6" sid="LEV 17:6" />فيَرُشُّ الكاهنُ دَمَها على مذبَحِ الرّبِّ عِندَ بابِ خَيمةِ الاجتِماعِ ويَحرُقُ الشَّحْمَ، فتُرضي رائِحَتُهُ الرّبَّ. <verse eid="LEV 17:6" /><verse number="7" style="v" pubnumber="7" sid="LEV 17:7" />ولا يذبَحوا بَعدَ الآنَ ذبائِحَهُم للآلهةِ التُّيوسِ ويَخونوا الرّبَّ بعبادتِها. تلكَ فريضةٌ أبديَّةٌ لهُم مدَى أجيالِهِم.<verse eid="LEV 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="LEV 17:8" />”وقُلْ لهُم: وأيُّ رَجُلٍ مِنْ بَني إِسرائيلَ والغُرباءِ النُّزَلاءِ فيما بَينَهُم أصعدَ مُحرَقةً أو ذبيحةً <verse eid="LEV 17:8" /><verse number="9" style="v" pubnumber="9" sid="LEV 17:9" />ولم يَجئ بها إلى بابِ خَيمةِ الاجتِماعِ لِيُقرِّبَها للرّبِّ أقطَعُهُ مِنْ بَينِ شعبِهِ، <verse eid="LEV 17:9" /><verse number="10" style="v" pubnumber="10" sid="LEV 17:10" />وإذا أكلَ دَمًا أُواجِهُهُ وأقطَعُهُ مِنْ بَينِ شعبِهِ. <verse eid="LEV 17:10" /><verse number="11" style="v" pubnumber="11" sid="LEV 17:11" />فنَفْسُ الجسَدِ هيَ في الدَّمِ، ولِذلِكَ جعَلتُهُ لكُم على المذبَحِ لِتُكفِّروا بهِ عَنْ نُفوسِكُم، لأنَّ الدَّمَ يُكفِّرُ عَنِ النَّفْسِ. <verse eid="LEV 17:11" /><verse number="12" style="v" pubnumber="12" sid="LEV 17:12" />لِهذا قُلتُ لِبَني إِسرائيلَ ولِكُلِّ غريبٍ نزيلٍ فيما بَينَهمُ: لا تأكلوا دَمًا. <verse eid="LEV 17:12" /><verse number="13" style="v" pubnumber="13" sid="LEV 17:13" />وكُلُّ مَنْ صادفَ مِنهُم صَيدًا مِنَ الوَحشِ أو الطَّيرِ اللَّذَينِ يُؤكَلانِ، فليَسفُكْ دَمَهُ ويُغطِّهِ بالتُّرابِ. <verse eid="LEV 17:13" /><verse number="14" style="v" pubnumber="14" sid="LEV 17:14" />فنَفْسُ كُلِّ جسَدٍ هيَ في دَمِهِ، ولذلِكَ قُلتُ لبَني إِسرائيلَ: لا تأكلوا دَمَ جسَدٍ ما، لأنَّ نفْسَ كُلِّ جسَدٍ هيَ دَمُهُ. فكُلُّ مَنْ أكلَهُ أقطعُهُ مِنْ بَينِ شعبهِ.<verse eid="LEV 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="LEV 17:15" />”وكُلُّ مَنْ أكلَ جُثَّةً أو فريسةً، أصيلًا كانَ أم دخيلًا، فليَغسِلْ ثيابَهُ ويَستحمَّ بالماءِ، ويكونَ نَجِسًا إلى المَغيبِ، ثُمَّ يَطهُرُ. <verse eid="LEV 17:15" /><verse number="16" style="v" pubnumber="16" sid="LEV 17:16" />فإنْ رفضَ تَحمَّلَ عاقبةَ إثْمِهِ“.<verse eid="LEV 17:16" /></para>
  <chapter eid="LEV 17" />
  <chapter number="18" style="c" sid="LEV 18" />
  <para style="s1">احترام العلاقة الزوجية</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="LEV 18:1" />وكلَّمَ الرّبُّ موسى فقالَ: <verse eid="LEV 18:1" /><verse number="2" style="v" pubnumber="2" sid="LEV 18:2" />”قُلْ لبَني إِسرائيلَ: ”أنا الرّبُّ إلهُكُم. <verse eid="LEV 18:2" /><verse number="3" style="v" pubnumber="3" sid="LEV 18:3" />كما يعمَلُ أهلُ مِصْرَ الّتي أقمتُم بها لا تعمَلوا، وكما يعمَلُ أهلُ أرضِ كنعانَ الّتي أُدخِلُكُم إليها لا تعمَلوا، وفي فرائِضِهِم لا تسلُكوا <verse eid="LEV 18:3" /><verse number="4" style="v" pubnumber="4" sid="LEV 18:4" />بلِ اَعمَلوا بأحكامي، واَخضَعوا لفرائِضي واَسلُكوا فيها، فأنا الرّبُّ إلهُكُم. <verse eid="LEV 18:4" /><verse number="5" style="v" pubnumber="5" sid="LEV 18:5" />فاَحفظوا فَرائِضي وأحكامي فمَنْ عَمِلَ بها يحيا. أنا الرّبُّ.<verse eid="LEV 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="LEV 18:6" />”لا يَقرَبْ أحدٌ إلى قريبِهِ في الرَّحِمِ لِكَشْفِ عَورتِهِ. أنا الرّبُّ. <verse eid="LEV 18:6" /><verse number="7" style="v" pubnumber="7" sid="LEV 18:7" />لا تَكشِفْ عَورةَ أبيكَ بكَشْفِ عَورةِ أمِّكَ. فهِيَ أمُّكَ، لا تَكْشِفْ عَورتَها. <verse eid="LEV 18:7" /><verse number="8" style="v" pubnumber="8" sid="LEV 18:8" />وعَورةُ زوجةِ أبيكَ لا تَكْشِفْها، فهيَ عَورةُ أبيكَ. <verse eid="LEV 18:8" /><verse number="9" style="v" pubnumber="9" sid="LEV 18:9" />وعَورةُ أُختِكَ اَبنةِ أبيكَ أوِ اَبنةِ أمِّكَ المولودةِ في البيتِ أو في خارجِه لا تَكْشِفْها. <verse eid="LEV 18:9" /><verse number="10" style="v" pubnumber="10" sid="LEV 18:10" />ولا تَكْشِفْ عَورةَ بنتِ اَبنِكَ أو بنتِ اَبنتِكَ. فهيَ عَورتُكَ. <verse eid="LEV 18:10" /><verse number="11" style="v" pubnumber="11" sid="LEV 18:11" />وعَورةُ بِنتِ زوجةِ أبيكَ المولودةِ مِنْ أبيكَ لا تَكْشِفْها فهيَ أُختُكَ. <verse eid="LEV 18:11" /><verse number="12" style="v" pubnumber="12" sid="LEV 18:12" />وعَورةُ أختِ أبيكَ لا تكشِفْها فهيَ قريبةُ أبيكَ في الرَّحِمِ. <verse eid="LEV 18:12" /><verse number="13" style="v" pubnumber="13" sid="LEV 18:13" />وعَورةُ أختِ أمِّكَ لا تَكْشِفْها، فهيَ قريبةُ أمِّكَ في الرَّحِمِ. <verse eid="LEV 18:13" /><verse number="14" style="v" pubnumber="14" sid="LEV 18:14" />وعَورةُ عمِّكَ لا تَكْشِفْها، إلى اَمرأتِهِ لا تقترِبْ. فهيَ عمَّةٌ لكَ. <verse eid="LEV 18:14" /><verse number="15" style="v" pubnumber="15" sid="LEV 18:15" />وعَورةُ كنَّتِكَ لا تَكْشِفْها، فهيَ زوجةُ اَبنِكَ. <verse eid="LEV 18:15" /><verse number="16" style="v" pubnumber="16" sid="LEV 18:16" />ولا تَكْشِفْ عَورةَ زوجةِ أخيكَ، فهيَ عَورةُ أخيكَ. <verse eid="LEV 18:16" /><verse number="17" style="v" pubnumber="17" sid="LEV 18:17" />وعَورةُ اَمرأةٍ واَبنتِها لا تَكْشِفْ. ولا تأخذِ اَبنةَ اَبنِها ولا اَبنةَ اَبنتِها لتَكْشِفَ عَورتَهُما، فهُما قريبتاها في الرَّحِمِ. وهذا فَحْشٌ. <verse eid="LEV 18:17" /><verse number="18" style="v" pubnumber="18" sid="LEV 18:18" />ولا تأخذِ اَمرأةً معَ أختِها لتكونَ ضَرَّتَها وتَكْشِفَ عَورتَها معَها في حياتِها.<verse eid="LEV 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="LEV 18:19" />”لا تَقرُبِ اَمرأةً في نجاسةِ طَمْثِها لِتكْشِفَ عَورتَها، <verse eid="LEV 18:19" /><verse number="20" style="v" pubnumber="20" sid="LEV 18:20" />ولا تُضاجعْ زوجةَ أحدٍ لِئلَّا تتَنجَّسَ بِها. <verse eid="LEV 18:20" /><verse number="21" style="v" pubnumber="21" sid="LEV 18:21" />لا تُعطِ مِنْ نسلِكَ مُحرَقةً تَطيبُ رائِحتُها للوَثنِ مُولَكَ لِئلَّا تُدنِّسَ اَسمَ إلهِكَ. أنا الرّبُّ.<verse eid="LEV 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="LEV 18:22" />”لا تُضاجعِ الذَّكَرَ مُضاجعةَ النِّساءِ، فذلِكَ مَعيبٌ. <verse eid="LEV 18:22" /><verse number="23" style="v" pubnumber="23" sid="LEV 18:23" />لا تُضاجعْ أيَّةَ بَهيمةٍ ولا تتَنجَّسْ بِها، ولا تَقفِ اَمرأةٌ أمامَ بَهيمةٍ لتُضاجِعَها، فذلِكَ فُجورٌ.<verse eid="LEV 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="LEV 18:24" />”لا تتَنجَّسوا بشيءٍ مِنْ هذا، فبِمثلِها تنجَّستِ الأمَمُ الّذينَ أطردُهُم مِنْ أمامِكُم. <verse eid="LEV 18:24" /><verse number="25" style="v" pubnumber="25" sid="LEV 18:25" />فتنجَّستِ الأرضُ. وسأُعاقبُها على إثْمِها حتّى تَفرُغَ مِنْ سُكَّانِها. <verse eid="LEV 18:25" /><verse number="26" style="v" pubnumber="26" sid="LEV 18:26" />فاَعمَلوا أنتم بفَرائضي وأحكامي ولا ترتكبوا شيئًا مِنْ جميعِ هذِهِ العُيوبِ، سَواءٌ مِنكمُ الأصيلُ والغريبُ النَّزِيلُ فيما بَينَكُم. <verse eid="LEV 18:26" /><verse number="27" style="v" pubnumber="27" sid="LEV 18:27" />فجميعُ هذِهِ العُيوبِ اَرْتَكبَها أهلُ هذِهِ الأرضِ الّذينَ مِنْ قَبلِكُم، فَتنجَّستِ الأرضُ <verse eid="LEV 18:27" /><verse number="28" style="v" pubnumber="28" sid="LEV 18:28" />وقذَفَتهُم كما تَقذِفُكُم أنتم إذا نجَّستُموها. <verse eid="LEV 18:28" /><verse number="29" style="v" pubnumber="29" sid="LEV 18:29" />بل كُلُّ مَنِ اَرتكبَ شيئًا مِنْ هذِهِ العُيوبِ أقطعُهُ مِنْ بَينِ شعبِهِ. <verse eid="LEV 18:29" /><verse number="30" style="v" pubnumber="30" sid="LEV 18:30" />فاَحفظوا ما أمرتُكُم بهِ لِئلَّا تعمَلوا شيئًا مِنَ العاداتِ المَعيبةِ الّتي عَمِلَتْها الشُّعوبُ مِنْ قَبلِكُم، ولا تتنجَّسوا بِها. أنا الرّبُّ إلهُكُم“.<verse eid="LEV 18:30" /></para>
  <chapter eid="LEV 18" />
  <chapter number="19" style="c" sid="LEV 19" />
  <para style="s1">فرائض القداسة العادلة</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="LEV 19:1" />وكلَّمَ الرّبُّ موسى فقالَ: <verse eid="LEV 19:1" /><verse number="2" style="v" pubnumber="2" sid="LEV 19:2" />”قُلْ لِجماعةِ بَني إِسرائيلَ كُلِّهِم: كُونوا قِدِّيسينَ لأنِّي أنا الرّبُّ إلهُكُم قُدُّوسٌ. <verse eid="LEV 19:2" /><verse number="3" style="v" pubnumber="3" sid="LEV 19:3" />لِيحتَرِمْ كُلُّ واحدٍ مِنكُم أمَّهُ وأباهُ ويَحتفظْ لي بأيّامِ السَّبْتِ. أنا الرّبُّ إلهُكُم. <verse eid="LEV 19:3" /><verse number="4" style="v" pubnumber="4" sid="LEV 19:4" />لا تَلتفِتوا إلى الأوثانِ ولا تَصنعوا لَكم آلهَةً مَسبُوكةً. أنا الرّبُّ إلهُكُم.<verse eid="LEV 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="LEV 19:5" />”وإذا ذبحتُم لي ذبيحةَ سلامةٍ، فحسَبَ ما أوصيتُكم بهِ تذبحونَها لأرضَى عَنكُم. <verse eid="LEV 19:5" /><verse number="6" style="v" pubnumber="6" sid="LEV 19:6" />وفي يومِ ذبحِها وفي غَدِهِ تُؤكَلُ، وما بقيَ إلى اليومِ الثَّالثِ يُحرَقُ بالنَّارِ. <verse eid="LEV 19:6" /><verse number="7" style="v" pubnumber="7" sid="LEV 19:7" />وإنْ أكلَ أحدٌ مِنها في اليومِ الثَّالثِ أحسَبُها رِجْسًا ولا أرضى بِها. <verse eid="LEV 19:7" /><verse number="8" style="v" pubnumber="8" sid="LEV 19:8" />ومَنْ أكلَ مِنها تحمَّلَ عاقبةَ إثْمِهِ، لتدنيسِهِ ما هوَ مُقَدَّسٌ لي أنا الرّبُّ. فأقطعُهُ مِنْ بَينِ شعبهِ.<verse eid="LEV 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="LEV 19:9" />”وإذا حصَدْتُم حصيدَ أرضِكُم، فلا تحصُدوه إلى أطرافِ حُقولِكُم، ولا تلتَقِطوا ما تَعفَّرَ مِنهُ بالتُّرابِ. <verse eid="LEV 19:9" /><verse number="10" style="v" pubnumber="10" sid="LEV 19:10" />ولا تعُودوا إلى قَطْفِ ما تَبقَّى مِنْ عُفارةِ كرومِكُم، ولا تلتَقِطوا ما سقطَ مِنهُ، بلِ اَترُكوا ذلِكَ للمِسكينِ والغريبِ. أنا الرّبُّ إلهُكُم.<verse eid="LEV 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="LEV 19:11" />لا تَسرِقوا ولا تَغدُروا ولا يَكذِبْ بَعضُكُم على بَعضٍ. <verse eid="LEV 19:11" /><verse number="12" style="v" pubnumber="12" sid="LEV 19:12" />لا تَحلِفوا باَسْمي كَذِبًا ولا تُدَنِّسوا اَسْمي، فأنا الرّبُّ إلهُكُم. <verse eid="LEV 19:12" /><verse number="13" style="v" pubnumber="13" sid="LEV 19:13" />لا تَظلِموا أحدًا ولا تَسلُبوهُ. لا تَحتَفِظوا بأجرةِ الأجيرِ عِندَكُم إلى الغَدِ. <verse eid="LEV 19:13" /><verse number="14" style="v" pubnumber="14" sid="LEV 19:14" />لا تَلعَنُوا الأصَمَّ، ولا تَضَعوا حجَرَ عَثْرٍ أمامَ الأعمى، واَتَّقوني، فأنا الرّبُّ إلهُكُم.<verse eid="LEV 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="LEV 19:15" />”لا تَجُوروا في الحُكْمِ، لا تُسايِروا فقيرًا، ولا تُحابوا عظيمًا، بلِ اَحْكُموا للآخرينَ بالعَدلِ.<verse eid="LEV 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="LEV 19:16" />”لا تنشُرِ النَّميمةَ بَينَ النَّاسِ، ولا تَشهدْ بالزُّورِ على حياةِ أحدٍ. أنا الرّبُّ. <verse eid="LEV 19:16" /><verse number="17" style="v" pubnumber="17" sid="LEV 19:17" />لا تُبغِضْ أحدًا في قلبِكَ، بل عاتِبْهُ عِتابًا لِئلَّا ترتَكِبَ خطيئةَ بُغْضِكَ لهُ.<verse eid="LEV 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="LEV 19:18" />”لا تَنتَقِمْ ولا تَحقُدْ على أبناءِ شعبِكَ، بل أحبَّ قريبَكَ مِثلما تُحِبُّ نفْسَكَ. أنا الرّبُّ.<verse eid="LEV 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="LEV 19:19" />”إحفظوا فَرائِضي. لا تُولِدْ بَهائِمَكَ مِنْ نَوعَينِ، ولا تَزرعْ حَقلَكَ مِنْ صُنفَينِ. وثوبًا مَنسوجًا مِنْ صُنفَينِ لا تلبَسْ.<verse eid="LEV 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="LEV 19:20" />”وإذا ضاجَعَ رَجُلٌ جاريةً مخطوبةً لآخرَ، وهيَ غيرُ مُحرَّرةٍ بفِديةٍ ولا مَعتُوقةٍ، فيُؤدَّبانِ ولا يُقتَلانِ لأنَّها لم تُعتَقْ. <verse eid="LEV 19:20" /><verse number="21" style="v" pubnumber="21" sid="LEV 19:21" />وليَجِئِ الرَّجُلُ إلى بابِ خَيمةِ الاجتِماعِ بِكَبشٍ يُقرِّبُه ذبيحةَ إثْمٍ للرّبِّ. <verse eid="LEV 19:21" /><verse number="22" style="v" pubnumber="22" sid="LEV 19:22" />فيُكفِّرُ عَنهُ الكاهنُ خطيئتَهُ بِكَبْشِ الإثْمِ أمامَ الرّبِّ، فيُسامِحُهُ.<verse eid="LEV 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="LEV 19:23" />”وإذا دَخلتُم أرضَ كنعانَ وغَرَستُم أيَّ شجَرٍ يُؤكَلُ فليَكُنْ أكلُهُ مُحَرَّمًا عَلَيكُم ثَلاثَ سِنينَ، تقطعونَ فيها ثَمرَهُ كما لو كُنتُم تَختِنُونَهُ. <verse eid="LEV 19:23" /><verse number="24" style="v" pubnumber="24" sid="LEV 19:24" />وفي السَّنةِ الرّابعَةِ يكونُ جميعُ ثَمرِهِ قُربانًا مُقدَّسًا لِتَمجيدِ الرّبِّ. <verse eid="LEV 19:24" /><verse number="25" style="v" pubnumber="25" sid="LEV 19:25" />وفي السَّنةِ الخامسةِ تأكلونَ ثَمرَهُ، فيُزادُ لكُم في غَلَّتِهِ. أنا الرّبُّ إلهُكُم.<verse eid="LEV 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="LEV 19:26" />”لا تأكلوا لَحمًا بِدَمِهِ. لا تَتشاءموا مِنْ شيءٍ ولا تَتفاءلوا بهِ. <verse eid="LEV 19:26" /><verse number="27" style="v" pubnumber="27" sid="LEV 19:27" />لا تَحلِقُوا رُؤوسَكُم حَولَ أطرافِها، ولا تقصُّوا شيئًا مِنْ لِحاكُم. <verse eid="LEV 19:27" /><verse number="28" style="v" pubnumber="28" sid="LEV 19:28" />لا تَجعَلوا خُدوشًا في أبدانِكُم حِدادًا على مَيْتٍ، ولا كتابةَ وَشْمٍ علَيها. أنا الرّبُّ.<verse eid="LEV 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="LEV 19:29" />”لا تُدنِّسِ اَبنتَكَ بِجَعلِها زانيةً لِئلَّا يزني أهلُ الأرضِ فتَمتَلِئَ بالفَواحشِ.<verse eid="LEV 19:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="LEV 19:30" />إحْتَفِظوا لي بأيّامِ السَّبْتِ وتَهَيَّبوا معبَدي المُقَدَّسَ. أنا الرّبُّ. <verse eid="LEV 19:30" /><verse number="31" style="v" pubnumber="31" sid="LEV 19:31" />فلا تَلتَفِتوا إلى السَّحَرةِ ولا تَسعَوا وراءَ العرَّافينَ فتتَنَجَّسوا بِهِم. أنا الرّبُّ.<verse eid="LEV 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" pubnumber="32" sid="LEV 19:32" />”قُمِ اَحترامًا لِلأشيبِ، وأكرِمْ وجهَ الشَّيخِ واَتَّقِ إلهَكَ. أنا الرّبُّ. <verse eid="LEV 19:32" /><verse number="33" style="v" pubnumber="33" sid="LEV 19:33" />وإذا نزَلَ بِكُم غريبٌ في أرضِكُم، فلا تُرهِقُوه. <verse eid="LEV 19:33" /><verse number="34" style="v" pubnumber="34" sid="LEV 19:34" />وليَكنْ عِندَكُمُ الغريبُ النَّزيلُ فيما بَينكُم كالأصيلِ مِنكُم. أحِبُّوه مِثلما تُحبُّونَ أنفسَكُم لأنَّكُم كُنتُم غُرَباءَ في أرضِ مِصْرَ. أنا الرّبُّ إلهُكُم.<verse eid="LEV 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" pubnumber="35" sid="LEV 19:35" />”لا تجوروا في الحُكْمِ ولا في المساحةِ والوَزنِ والكَيلِ. <verse eid="LEV 19:35" /><verse number="36" style="v" pubnumber="36" sid="LEV 19:36" />بل لِتَكُنْ مَوازينُكُم وعياراتُكُم عادلةً، وليَكنْ لكُم قُفَّةٌ عادلةٌ وهِينٌ عادلٌ. أنا الرّبُّ إلهُكُم الّذي أخرجَكُم مِنْ أرضِ مِصْرَ. <verse eid="LEV 19:36" /><verse number="37" style="v" pubnumber="37" sid="LEV 19:37" />”فاَحفظوا جميعَ فَرائضي وأحكامي واَعْمَلوا بِها. أنا الرّبُّ“.<verse eid="LEV 19:37" /></para>
  <chapter eid="LEV 19" />
  <chapter number="20" style="c" sid="LEV 20" />
  <para style="s1">عواقب العصيان</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="LEV 20:1" />وكلَّمَ الرّبُّ موسى فقالَ: <verse eid="LEV 20:1" /><verse number="2" style="v" pubnumber="2" sid="LEV 20:2" />”قُلْ لِبَني إِسرائيلَ: أيُّ إِسرائيليٍّ وغريبٍ نَزيلٍ في إِسرائيلَ أعطى مِنْ نسلِهِ لِلوثنِ مُولَكَ، فَليَقتُلْهُ الشَّعبُ رَجْمًا بالحجارةِ. <verse eid="LEV 20:2" /><verse number="3" style="v" pubnumber="3" sid="LEV 20:3" />وأنا أُواجِهُهُ وأقطَعُهُ مِنْ بَينِ شعبِهِ، لأنَّهُ أعطى مِنْ نسلِهِ لِمُولَكَ، فدَنَّسَ مَقْدِسي واَسميَ القُدُّوسَ. <verse eid="LEV 20:3" /><verse number="4" style="v" pubnumber="4" sid="LEV 20:4" />وإنْ تغاضَى الشَّعبُ عَنهُ فلم يقتُلُوهُ، <verse eid="LEV 20:4" /><verse number="5" style="v" pubnumber="5" sid="LEV 20:5" />واجَهْتُهُ هوَ وعَشيرتَهُ وجميعَ الّذينَ تَبِعُوهُ في فُجورِه بعبادةِ مُولَكَ، وقطَّعتُهُم مِنْ بَينِ شعبِهِم.<verse eid="LEV 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="LEV 20:6" />”وكُلُّ مَنِ اَلتَفتَ إلى السَّحَرةِ والعرَّافينَ وتَبِعَهُم في فُجورِهِم أُواجِهُهُ وأقطَعُهُ مِنْ بَينِ شعبِهِ. <verse eid="LEV 20:6" /><verse number="7" style="v" pubnumber="7" sid="LEV 20:7" />فَتقَدَّسوا وكُونوا قِدِّيسينَ، لأنِّي أنا الرّبُّ إلهُكُم. <verse eid="LEV 20:7" /><verse number="8" style="v" pubnumber="8" sid="LEV 20:8" />واَحْفَظوا فَرائِضي واَعْمَلوا بِها، أنا الرّبُّ أُقدِّسُكُم.<verse eid="LEV 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="LEV 20:9" />”كُلُّ مَنْ لعنَ أباهُ أو أُمَّه يُقتَلُ قَتلًا ودَمُهُ على رأسِهِ. <verse eid="LEV 20:9" /><verse number="10" style="v" pubnumber="10" sid="LEV 20:10" />وكُلُّ مَنْ زنى باَمرأةِ إِسرائيليٍّ آخرَ يُقتَلُ الزَّاني والزَّانيةُ. <verse eid="LEV 20:10" /><verse number="11" style="v" pubnumber="11" sid="LEV 20:11" />وإنْ ضاجعَ أحدٌ زوجةَ أبيهِ كشَفَ عَورةَ أبيهِ، فليُقتلا كِلاهُما، ودَمُهُما على رأسَيهِما. <verse eid="LEV 20:11" /><verse number="12" style="v" pubnumber="12" sid="LEV 20:12" />وإنْ ضاجعَ أحدٌ كَنَّتَهُ فليُقتَلا كِلاهُما لِفُجورِهِما، ودَمُهُما على رأسَيهِما. <verse eid="LEV 20:12" /><verse number="13" style="v" pubnumber="13" sid="LEV 20:13" />وإنْ ضاجعَ أحدٌ ذَكَرًا مُضاجعةَ النِّساءِ فكِلاهُما فعَلا أمرًا مَعيبًا فليُقتَلا ودَمُهُما على رأسَيهِما. <verse eid="LEV 20:13" /><verse number="14" style="v" pubnumber="14" sid="LEV 20:14" />وإنْ أخذَ أحدٌ اَمرأةً وأُمَّها، فتِلكَ فاحشةٌ. فيُحرَقُ هوَ وهيَ بالنَّار، ولا تَكُنْ فاحِشةٌ كهَذِهِ فيما بَينَكُم. <verse eid="LEV 20:14" /><verse number="15" style="v" pubnumber="15" sid="LEV 20:15" />وإنْ ضاجعَ أحدٌ بَهيمَةً، فيُقتَلُ هوَ والبهيمةُ قَتلًا. <verse eid="LEV 20:15" /><verse number="16" style="v" pubnumber="16" sid="LEV 20:16" />وإنْ اَقتربتِ اَمرأةٌ إلى بَهيمةٍ لِتُضاجِعَها، تُقتَلِ المرأةُ والبهيمةُ قَتلًا ودَمُهُما على رأسَيهِما.<verse eid="LEV 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="LEV 20:17" />”وإنْ أخذَ أحدٌ أُختَهُ، اَبنةَ أبيهِ أو اَبنةَ أمِّهِ، ورأى عَورتَها ورأت عورتَهُ، فهذا عارٌ، فليُقطَعا مِنْ بَينِ شعبِهِما أمامَ عُيونِ بَني شعبِهِما. هوَ كشَفَ عَورَةَ أختِهِ فتَحَمَّلَ عاقِبةَ إثْمهِ.<verse eid="LEV 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="LEV 20:18" />”وإنْ ضاجعَ أحدٌ اَمرأةً طامِثًا وكَشفَ عَورَتَها، فعَرَّى مَسِيلَها وكشَفَت هيَ عَنْ سَيلِ دَمِها، فَلْيُقطعا كِلاهُما مِنْ بَينِ شعبِهِما. <verse eid="LEV 20:18" /><verse number="19" style="v" pubnumber="19" sid="LEV 20:19" />لا تَكْشِف عَورةَ خالتِكَ أو عَمَّتِكَ، فتكونَ كَمَنْ عَرَّى قريبةً لَه في الرَّحِمِ. هُما يتَحَمَّلانِ عاقِبَةَ إثْمِهِما. <verse eid="LEV 20:19" /><verse number="20" style="v" pubnumber="20" sid="LEV 20:20" />وإنْ ضاجعَ أحدٌ زوجةَ عَمِّهِ كشَفَ عَورةَ عمِّه. هُما يَتحمَّلانِ عاقِبةَ خطيئتِهما، فليَموتا مَنبوذَينِ. <verse eid="LEV 20:20" /><verse number="21" style="v" pubnumber="21" sid="LEV 20:21" />وإنْ أخذَ أحدٌ زوجةَ أخيهِ، فهذا جُرْمٌ. هوَ كشَفَ عَورةَ أخيهِ، فليكُونا كِلاهُما مَنبوذَينِ.<verse eid="LEV 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="LEV 20:22" />”فاَحْفَظوا جميعَ فرائضي وأحكامي واَعْملوا بها لِئلَّا تَرفُضَكُمُ الأرضُ التي أدخلتُكُم إليها لِتُقيمُوا بها. <verse eid="LEV 20:22" /><verse number="23" style="v" pubnumber="23" sid="LEV 20:23" />ولا تَسلُكوا مَسلَكَ الشُّعوبِ باَتّباعِ فرائضِهِم، وهُمُ الّذينَ أطردُهُم مِنْ أمامِكُم لأنَّهُم فعَلوا هذا كُلَّه فأنزَلتُ بهِمِ القِصاصَ. <verse eid="LEV 20:23" /><verse number="24" style="v" pubnumber="24" sid="LEV 20:24" />وقُلتُ لكُم: تَرِثونَ أرضَهُم وأنا أُعطِيها لكُم لِتَمتَلِكوها أرضًا تَدُرُّ لبَنًا وعسَلًا. أنا الرّبُّ إلهُكُم الّذي اَتَّخَذَكُم بدَلَ سِواكُم مِنَ الشُّعوبِ. <verse eid="LEV 20:24" /><verse number="25" style="v" pubnumber="25" sid="LEV 20:25" />فميِّزوا البَهائِمَ الطَّاهِرةَ مِنَ النَّجِسةِ، والطُّيورَ النَّجِسَةَ مِنَ الطَّاهِرةِ، ولا تُدَنِّسوا أنفُسَكُم بالبَهائِمِ والطَّيرِ وسائرِ ما يَدِبُّ على الأرضِ مِمَّا أخبَرْتُكم أنَّه نَجِسٌ. <verse eid="LEV 20:25" /><verse number="26" style="v" pubnumber="26" sid="LEV 20:26" />وكُونوا لي قِدِّيسينَ، لأنِّي أنا الرّبُّ قدُّوسٌ، اَتَّخَذْتُكُم بدَلَ سِواكُم مِنَ الشُّعوبِ لِتَكُونوا لي.<verse eid="LEV 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="LEV 20:27" />”مَنْ كانَ مِنَ الرِّجالِ أوِ النِّساءِ ساحرًا أو عرَّافًا، يُقْتَلُ رَجْمًا بالحجارةِ، ودَمُهُ على رأسِهِ“.<verse eid="LEV 20:27" /></para>
  <chapter eid="LEV 20" />
  <chapter number="21" style="c" sid="LEV 21" />
  <para style="s1">قداسة الكهنة</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="LEV 21:1" />وكلَّمَ الرّبُّ موسى فقالَ: ”قُلْ لِلكهَنةِ بَني هرونَ: لا يَتَنَجَّسْ أحدٌ مِنهُم بِدَفْنِ مَيْتٍ مِنْ شعبِهِ، <verse eid="LEV 21:1" /><verse number="2" style="v" pubnumber="2" sid="LEV 21:2" />إلَّا بِنَسيبِهِ الأقربِ إليهِ: أُمُّهُ وأبوهُ واَبنُهُ واَبنتُهُ وأخوهُ <verse eid="LEV 21:2" /><verse number="3" style="v" pubnumber="3" sid="LEV 21:3" />وأختُهُ العذراءُ المقيمةُ في بَيتهِ، لأنْ لا زوجَ لها. <verse eid="LEV 21:3" /><verse number="4" style="v" pubnumber="4" sid="LEV 21:4" />وأمَّا الّذينَ ينتسبونَ إليهِ بالزَّواجِ فلا يَتَنجَّسْ بِدَفنِ مَيْتٍ مِنهُم.<verse eid="LEV 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="LEV 21:5" />”لا يَحلِقِ الكهَنةُ مِنْ شَعْرِ رُؤوسِهِم ولِحاهُم، ولا يَخدِشُوا خَدْشًا في أبدانِهِم حِدادًا على مَيْتٍ. <verse eid="LEV 21:5" /><verse number="6" style="v" pubnumber="6" sid="LEV 21:6" />يكُونونَ مُقَدَّسينَ لي، أنا إلهُهُم، ولا يُدنِّسونَ اَسْمي. هُم يُقَرِّبونَ وقائدَ الرّبِّ، طَعامَ إلهِهِم، فليَكُونوا مُقَدَّسينَ.<verse eid="LEV 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="LEV 21:7" />”باَمرأةٍ زانيةٍ أو مُدَنَّسةٍ فُضَّتْ بَكارَتُها، أو مُطلَّقةٍ مِنْ بَعلِها، لا يَتَزَّوجِ الكاهنُ، لأنَّ الكاهنَ مُكرَّسٌ لإلهِهِ. <verse eid="LEV 21:7" /><verse number="8" style="v" pubnumber="8" sid="LEV 21:8" />يكونُ مُكَرَّسًا عِندَكُم، لأنَّه يُقَرِّبُ طَعامَ إلهِكُم. أنا الرّبُّ قدُّوسٌ وأُقدِّسُكُم.<verse eid="LEV 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="LEV 21:9" />”وكُلُّ اَبنةِ رَجُلٍ كاهنٍ دنَّستْ نَفسَها بالزِّنى تكونُ دنَّستْ أباها، تُحرَقُ بالنَّارِ.<verse eid="LEV 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="LEV 21:10" />”والكاهِنُ الأعظمُ بَينَ إخوتِهِ، الّذي صُبَّ على رأسِهِ زيتُ المَسْحِ، وكُرِّسَ ليَلبسَ الثِّيابَ المُقَدَّسةَ، لا يَكْشِفُ رأسَهُ ولا يُمَزِّقُ ثيابَهُ حِدادًا. <verse eid="LEV 21:10" /><verse number="11" style="v" pubnumber="11" sid="LEV 21:11" />وعلى مَيْتٍ لا يَدخُلُ، ولو كانَ أباهُ أو أمَّهُ، لِئلَّا يَتَنجَّسَ. <verse eid="LEV 21:11" /><verse number="12" style="v" pubnumber="12" sid="LEV 21:12" />ومِنْ معبَدي المُقَدَّسِ لا يَخرجُ وعلَيهِ زيتُ المَسْحِ المَنذُورُ لي لِئلَّا يُدنِّسَهُ. أنا الرّبُّ إلهُهُ. <verse eid="LEV 21:12" /><verse number="13" style="v" pubnumber="13" sid="LEV 21:13" />وعلى الكاهنِ أنْ يأخُذَ اَمرأةً بِكْرًا مِنْ قومِهِ، <verse eid="LEV 21:13" /><verse number="14" style="v" pubnumber="14" sid="LEV 21:14" />لا مُطلَّقةً ولا مُدنَّسةً فُضَّتْ بَكارتُها ولا زانيةً <verse eid="LEV 21:14" /><verse number="15" style="v" pubnumber="15" sid="LEV 21:15" />لِئلَّا يُدنِّسَ نسلَه بَينَ قومِهِ، وهوَ الّذي كرَّسْتُهُ لي. أنا الرّبُّ“.<verse eid="LEV 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="LEV 21:16" />وكلَّمَ الرّبُّ موسى فقالَ: <verse eid="LEV 21:16" /><verse number="17" style="v" pubnumber="17" sid="LEV 21:17" />”قُلْ لهرونَ: مَنْ كانَ فيهِ عَيبٌ مِنْ نسلِكَ على مَمرِّ الأجيالِ، فلا يقتَرِبْ ليُقدِّمَ طَعامَ إلهِهِ: <verse eid="LEV 21:17" /><verse number="18" style="v" pubnumber="18" sid="LEV 21:18" />الأعمى والأعرجُ والأفطسُ والأشرعُ، <verse eid="LEV 21:18" /><verse number="19" style="v" pubnumber="19" sid="LEV 21:19" />والمَكسورُ الرِّجْلِ أوِ اليدِ، <verse eid="LEV 21:19" /><verse number="20" style="v" pubnumber="20" sid="LEV 21:20" />والأحدبُ والقزَمُ والّذي في عينَيه بياضٌ، والأجربُ والّذي في بدَنِهِ بُثورٌ، ومَرضوضُ الخِصيتَينِ. <verse eid="LEV 21:20" /><verse number="21" style="v" pubnumber="21" sid="LEV 21:21" />كُلُّ مَنْ بهِ عَيبٌ مِنْ نَسلِ هرونَ لا يتقدَّمْ ليقرِّبَ وقائدَ طَعامِ الرّبِّ إلهِهِ. <verse eid="LEV 21:21" /><verse number="22" style="v" pubnumber="22" sid="LEV 21:22" />لكنَّهُ يأكلُ مِنْ طَعامِ إلهِهِ، سَواءٌ أكانَ مُقدَّسًا أم مُقدَّسًا كُلَّ التَّقديسِ. <verse eid="LEV 21:22" /><verse number="23" style="v" pubnumber="23" sid="LEV 21:23" />وأمَّا الحِجابُ المُقَدَّسُ، فلا يَقتَرِبْ مِنهُ، ولا يتَقدَّمْ إلى المذبَحِ إذْ بِهِ عَيبٌ فلا يُدنِّسُ معبَدي الّذي كرَّسْتُهُ لي. أنا الرّبُّ“.<verse eid="LEV 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="LEV 21:24" />فكلَّمَ موسى بذلِكَ هرونَ وبَنيه وسائرَ بَني إِسرائيلَ.<verse eid="LEV 21:24" /></para>
  <chapter eid="LEV 21" />
  <chapter number="22" style="c" sid="LEV 22" />
  <para style="s1">قداسة القرابين</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="LEV 22:1" />وكلَّمَ الرّبُّ موسى فقالَ: <verse eid="LEV 22:1" /><verse number="2" style="v" pubnumber="2" sid="LEV 22:2" />”قُلْ لهرونَ وبَنيهِ أنْ يتَوَقَّوا القرابينَ الّتي يُكرِّسُها لي بَنو إِسرائيلَ لِئلَّا يُدنِّسوا اَسْمي القُدُّوسَ. أنا الرّبُّ. <verse eid="LEV 22:2" /><verse number="3" style="v" pubnumber="3" sid="LEV 22:3" />وقُلْ لهُم: أيُّ رَجُلٍ مِنْ نَسلِكُم على مَمرِّ أجيالِكُمُ اَقْتربَ إلى القرابينِ المُقَدَّسةِ الّتي يُكرِّسُها لي بَنو إِسرائيلَ، وهوَ نَجِسٌ بِحسَبِ الشَّريعةِ، أحرِمُهُ مِنْ خِدمَتي، أنا الرّبُّ. <verse eid="LEV 22:3" /><verse number="4" style="v" pubnumber="4" sid="LEV 22:4" />وأيُّ رَجُلٍ مِنْ نَسلِ هرونَ كانَ في حالةِ البرَصِ أوِ السَّيلانِ، فلا يأكُلْ مِنَ القرابينِ المُقَدَّسةِ لي إلى أنْ يَطهُرَ. وكذلِكَ مَنْ مَسَّ شيئًا نَجِسًا لمَيْتٍ، أو ضاجَعَ اَمرأةً، <verse eid="LEV 22:4" /><verse number="5" style="v" pubnumber="5" sid="LEV 22:5" />أو مَسَّ دبيبًا يتنجَّسُ بهِ، أو إنسانًا لنجاسةٍ فيهِ، <verse eid="LEV 22:5" /><verse number="6" style="v" pubnumber="6" sid="LEV 22:6" />فليكُنْ نَجِسًا إلى المَغيبِ ولا يأكُلْ مِنَ القرابينِ المُقدَّسةِ لي، بل يَغسِلُ بدَنَه بالماءِ. <verse eid="LEV 22:6" /><verse number="7" style="v" pubnumber="7" sid="LEV 22:7" />فإذا غابَتِ الشَّمسُ طَهُرَ، وبَعدَ ذلِكَ يأكلُ مِنَ القرابينِ المُقدَّسةِ لي لأنَّها طَعامُهُ. <verse eid="LEV 22:7" /><verse number="8" style="v" pubnumber="8" sid="LEV 22:8" />ولا يأكلْ جُثَّةً ولا فريسةً، فيتَنَجَّسَ. أنا الرّبُّ. <verse eid="LEV 22:8" /><verse number="9" style="v" pubnumber="9" sid="LEV 22:9" />فليحفظوا ما أمرتُهُم بهِ ولا يتحمَّلوا فيها خطيئةً، فيموتوا بسَببِ الأطعمةِ الّتي كرَّسْتُها لي. أنا الرّبُّ.<verse eid="LEV 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="LEV 22:10" />”لا يأكلُ قُربانًا مُقدَّسًا لي غيرُ الكاهنِ، ولا يأكُلُ مِنهُ ضَيفُ الكاهنِ أو أجيرُه <verse eid="LEV 22:10" /><verse number="11" style="v" pubnumber="11" sid="LEV 22:11" />وإنَّما يأكُلُ مِنهُ عبدُ الكاهنِ إذا اَشتراهُ بمالِهِ، وكذلِكَ مولودُ بَيتهِ، لأنَّهما مِنْ طَعامِهِ يأكلانِ. <verse eid="LEV 22:11" /><verse number="12" style="v" pubnumber="12" sid="LEV 22:12" />وأيَّةُ اَبنةِ كاهنٍ تزوَّجتْ برجلٍ غيرِ كاهنٍ لا تأكلُ مِمَّا هوَ نصيبٌ مِنَ القرابينِ المُقدَّسةِ لي. <verse eid="LEV 22:12" /><verse number="13" style="v" pubnumber="13" sid="LEV 22:13" />ولكنَّها إذا صارتْ أرملةً أو مُطلَّقَةً ولا نَسلَ لها، ورَجَعتْ إلى بَيتِ أبيها كأيّامِ صِباها، فتأكُلُ مِنْ طَعامِ أبيها الّذي لا يأكُلُ مِنهُ غَيرُ الكاهنِ. <verse eid="LEV 22:13" /><verse number="14" style="v" pubnumber="14" sid="LEV 22:14" />وكُلُّ مَنْ أكلَ سَهوًا مِنَ القرابينِ المُقدَّسةِ لي، يَدفعُ ما أكلَهُ إلى الكاهنِ بزيادةِ خُمْسِهِ.<verse eid="LEV 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="LEV 22:15" />”لا يُدَنِّسِ الكهنَةُ ما يُقَدِّمُهُ بَنو إِسرائيلَ مِنْ قرابينَ يكرِّسونَها للرّبِّ بأنْ يُطعِموها لِمَنْ لا يَحلُّ لَه، <verse eid="LEV 22:15" /><verse number="16" style="v" pubnumber="16" sid="LEV 22:16" />فيحمِّلونَه بأكلِها الإثْمَ والعقابَ، وهيَ الّتي كرَّسْتُها. أنا الرّبُّ“.<verse eid="LEV 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="LEV 22:17" />وكلَّمَ الرّبُّ موسى فقالَ: <verse eid="LEV 22:17" /><verse number="18" style="v" pubnumber="18" sid="LEV 22:18" />”قُلْ لهرونَ وبَنيهِ وسائرِ بَني إِسرائيلَ: إذا قرَّبَ رَجُلٌ مِنْ بَيتِ إِسرائيلَ ومِنْ نُزَلائِهِم قُربانَه وجعَلَهُ مُحرقَةً للرّبِّ وفاءَ نَذْرٍ أو تَبرُّعًا، <verse eid="LEV 22:18" /><verse number="19" style="v" pubnumber="19" sid="LEV 22:19" />فالرّبُّ يَرضى به إذا قدَّمَ ذَكَرًا صحيحًا مِنَ البقَرِ أوِ الضَأْنِ أوِ المعَزِ، <verse eid="LEV 22:19" /><verse number="20" style="v" pubnumber="20" sid="LEV 22:20" />وما بهِ عَيبٌ فلا تُقرِّبوهُ للرّبِّ، لأنَّه لا يَرضى بهِ مِنكُم.<verse eid="LEV 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="LEV 22:21" />”ومَنْ قرَّبَ ذبيحةَ سلامةٍ للرّبِّ مِنَ البقَرِ والغنَمِ وفاءَ نَذْرٍ أو تَبرُّعًا، فليكُنْ صحيحًا لا عَيبَ فيهِ ليرضى بهِ الرّبُّ: <verse eid="LEV 22:21" /><verse number="22" style="v" pubnumber="22" sid="LEV 22:22" />لا أعمى ولا مكسورًا ولا مَجروحًا ولا بهِ بُثورٌ ولا أجربَ ولا أحصفَ. <verse eid="LEV 22:22" /><verse number="23" style="v" pubnumber="23" sid="LEV 22:23" />وكُلُّ ثَورٍ أو خَروفٍ خُلِقَ وفي بدَنِه زيادةٌ أونَقْصٌ، فلا يُمكِنُ تَقريبُهُ للرّبِّ تَبرُّعًا، ولا وفاءَ نَذْرٍ، لأنَّه لا يرضى بهِ. <verse eid="LEV 22:23" /><verse number="24" style="v" pubnumber="24" sid="LEV 22:24" />ولا تُقرِّبوهُ للرّبِّ إذا كان خَصيًّا بالرَّضِّ أوِ السَّحْقِ أوِ القَلْعِ أوِ القَطْعِ. لا تَفعلوا شيئًا مِنْ هذا في أرضِكُم، <verse eid="LEV 22:24" /><verse number="25" style="v" pubnumber="25" sid="LEV 22:25" />ولا تَقبلوهُ مِنْ يَدِ الغريبِ لِتُقرِّبوهُ طَعامًا لإلهِكُم، لأنَّ بهِ عَيبًا فلا يَرضى بهِ مِنكُم“.<verse eid="LEV 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="LEV 22:26" />وكلَّمَ الرّبُّ موسى فقالَ: <verse eid="LEV 22:26" /><verse number="27" style="v" pubnumber="27" sid="LEV 22:27" />”إذا وُلِدَ بقَرٌ أو ضَأْنٌ أو معَزٌ، فيكونُ سَبعةَ أيّامٍ معَ أمِّهِ. ومِنَ اليومِ الثَّامن وما بَعدُ يَرضى بهِ الرّبُّ قُربانَ وَقيدةٍ لهُ. <verse eid="LEV 22:27" /><verse number="28" style="v" pubnumber="28" sid="LEV 22:28" />لا تذبحوا البقَرةَ أوِ الشَّاةَ معَ ولدِها في يومٍ واحدٍ. <verse eid="LEV 22:28" /><verse number="29" style="v" pubnumber="29" sid="LEV 22:29" />وإذا ذبحتُم ذبيحةَ شُكْرٍ للرّبِّ، فعلى ما أمرَ بهِ الرّبُّ تذبحونَها ليَرضى بِها، <verse eid="LEV 22:29" /><verse number="30" style="v" pubnumber="30" sid="LEV 22:30" />وفي اليومِ نفسِهِ تأكلونَها. لا تُبقُوا مِنها شيئًا إلى الغَدِ. أنا الرّبُّ.<verse eid="LEV 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" pubnumber="31" sid="LEV 22:31" />”فاَحفظوا وصايايَ واَعمَلوا بِها. أنا الرّبُّ. <verse eid="LEV 22:31" /><verse number="32" style="v" pubnumber="32" sid="LEV 22:32" />ولا تُدَنِّسوا اَسْميَ القُدُّوسَ، فأبقَى مُقدَّسًا فيما بَينَ بَني إِسرائيلَ. أنا الرّبُّ الّذي كَرَّسَكُم <verse eid="LEV 22:32" /><verse number="33" style="v" pubnumber="33" sid="LEV 22:33" />وأخرَجَكُم مِنْ أرضِ مِصْرَ ليكونَ لكُم إلهًا. أنا الرّبُّ“.<verse eid="LEV 22:33" /></para>
  <chapter eid="LEV 22" />
  <chapter number="23" style="c" sid="LEV 23" />
  <para style="s1">أعياد الربِّ</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="LEV 23:1" />وكلَّمَ الرّبُّ موسى فقالَ: <verse eid="LEV 23:1" /><verse number="2" style="v" pubnumber="2" sid="LEV 23:2" />”قُلْ لبَني إِسرائيلَ: أعيادُ الرّبِّ الّتي تحتفلونَ بِها مُقدَّسةٌ للرّبِّ. <verse eid="LEV 23:2" /><verse number="3" style="v" pubnumber="3" sid="LEV 23:3" />في سِتَّةِ أيّامٍ تعمَلُ عمَلًا، وفي اليومِ السَّابعِ سَبْتُ عُطلةٍ مُقدَّسٌ تحتفلونَ بهِ ولا تعمَلوا عمَلًا في جميعِ ديارِكُم. فهوَ سَبْتٌ للرّبِّ.<verse eid="LEV 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="LEV 23:4" />”هذِهِ أعيادُ الرّبِّ المُقدَّسةُ الّتي تحتَفلونَ بِها في أوقاتِها: <verse eid="LEV 23:4" /><verse number="5" style="v" pubnumber="5" sid="LEV 23:5" />في الشَّهرِ الأوَّلِ، في مساءِ اليومِ الرَّابعَ عشَرَ مِنهُ إلى مساءِ اليومِ الخامسَ عشَرَ فِصْحٌ للرّبِّ. <verse eid="LEV 23:5" /><verse number="6" style="v" pubnumber="6" sid="LEV 23:6" />وفي اليومِ الخامسَ عشَرَ مِنهُ عيدُ الفَطير للرّبِّ، وفيهِ تأكلونَ فَطيرًا سَبعةَ أيّامٍ. <verse eid="LEV 23:6" /><verse number="7" style="v" pubnumber="7" sid="LEV 23:7" />وفي اليومِ الأوَّلِ مِنها تحتفلونَ اَحتفالًا مُقدَّسًا ولا تعمَلونَ عمَلًا شاقًّا. <verse eid="LEV 23:7" /><verse number="8" style="v" pubnumber="8" sid="LEV 23:8" />وتُقرِّبونَ وَقيدةً للرّبِّ سَبعةَ أيّامٍ، وفي اليومِ السَّابعِ تحتفلونَ اَحتفالًا مُقدَّسًا لكُم، لا تعمَلونَ فيهِ عمَلًا شاقًّا“.<verse eid="LEV 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="LEV 23:9" />وكلَّمَ الرّبُّ موسى فقالَ: <verse eid="LEV 23:9" /><verse number="10" style="v" pubnumber="10" sid="LEV 23:10" />”قُلْ لبَني إِسرائيلَ: إذا دَخلتُمُ الأرضَ الّتي أُعطيها لكُم وحَصدْتُم حَصيدَها، تَجيئونَ بِحُزْمةٍ مِنْ باكورةِ حَصيدِكُم إلى الكاهنِ <verse eid="LEV 23:10" /><verse number="11" style="v" pubnumber="11" sid="LEV 23:11" />فيُحرِّكُها تَحريكًا في غَدِ السَّبْتِ أمامَ الرّبِّ ليرضى عَنكُم. <verse eid="LEV 23:11" /><verse number="12" style="v" pubnumber="12" sid="LEV 23:12" />وقرِّبوا في يومِ تَحريكِ الحُزمةِ خروفًا صحيحًا حَوليًّا مُحرَقةً للرّبِّ. <verse eid="LEV 23:12" /><verse number="13" style="v" pubnumber="13" sid="LEV 23:13" />قرِّبوهُ معَ عُشْرَي قُفَّةٍ مِنْ دقيقٍ مَلتوتٍ بِزيتٍ وَقيدةً تُرضي رائِحتُها الرّبَّ، واَسكُبوا علَيها رُبعَ هَيْنٍ مِنَ الخمرِ. <verse eid="LEV 23:13" /><verse number="14" style="v" pubnumber="14" sid="LEV 23:14" />لا تأكلوا خُبزًا وفَريكًا وسُنبُلًا طَرِيًّا إلى ذلِكَ اليومِ الّذي فيهِ تُقدِّمونَ قُربانَ إلهِكُم. تِلكَ فريضةٌ أبديَّةٌ على مَمرِّ أجيالِكُم، في جميعِ ديارِكُم.<verse eid="LEV 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="LEV 23:15" />”ومِنْ غَدِ السَبْتِ، يومَ تَجيئونَ بِحُزمةٍ مِنْ باكورةِ حَصيدِكُم تَقدِمةً يُحرِّكُها الكاهنُ أمامَ الرّبِّ، تَحسِبُون لكُم سَبعةَ أسابيعَ كاملةٍ. <verse eid="LEV 23:15" /><verse number="16" style="v" pubnumber="16" sid="LEV 23:16" />وفي غَدِ السَّبْتِ السَّابعِ بَعدَ خمسينَ يومًا تُقرِّبونَ تَقدمةً جديدةً للرّبِّ. <verse eid="LEV 23:16" /><verse number="17" style="v" pubnumber="17" sid="LEV 23:17" />فتأتونَ بخُبزٍ للتَّحريكِ أمامَ الرّبِّ: رغيفانِ مِنْ كُلِّ بَيتٍ يُخبَزانِ بعُشْري قُفَّةٍ مِنَ الدَّقيقِ خَميرًا باكورةً للرّبِّ <verse eid="LEV 23:17" /><verse number="18" style="v" pubnumber="18" sid="LEV 23:18" />وقرِّبوا معَ الخُبزِ، عنِ الجماعةِ كُلِّها سَبعةَ خِرافٍ صحيحةٍ حَوليَّةٍ وعِجْلًا مِنَ البقَرِ وكَبْشَينِ مُحرَقةً للربِّ، معَ تَقدمتِهما، وسكيبِهما مِنَ الخمرِ وَقيدةً تُرضي رائحَتُها الرّبَّ. <verse eid="LEV 23:18" /><verse number="19" style="v" pubnumber="19" sid="LEV 23:19" />وقرِّبوا لَه تَيسًا مِنَ المعَزِ ذبيحةَ خطيئةٍ، وخَروفَينِ صحيحَينِ ذبيحةَ سلامةٍ. <verse eid="LEV 23:19" /><verse number="20" style="v" pubnumber="20" sid="LEV 23:20" />فيُحرِّكُ الكاهنُ الخروفَينِ معَ خُبزِ البواكيرِ تَحريكًا أمامَ الرّبِّ. هيَ قربانٌ مُقدَّسٌ للرّبِّ ولِلكاهنِ تكونُ.<verse eid="LEV 23:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="LEV 23:21" />”وفي ذلِكَ اليومِ ذاتِه تحتفلون اَحْتفالًا مُقدَّسًا لكُم، لا تعمَلونَ فيهِ عمَلًا شاقًّا. ويكونُ ذلِكَ لكُم فريضةً أبديَّةً في جميعِ ديارِكُم مدَى أجيالِكُم.<verse eid="LEV 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="LEV 23:22" />”وإذا حَصدتُم حَصيدَ أرضِكُم، فلا تحصُدوا أطرافَ حُقولِكُم ولا تجمعوا لُقاطَ حَصيدِكُم، بلِ اَتركوهُ للمِسكينِ والغريبِ. أنا الرّبُّ إلهُكُم“.<verse eid="LEV 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="LEV 23:23" />وكلَّمَ الرّبُّ موسى فقالَ: <verse eid="LEV 23:23" /><verse number="24" style="v" pubnumber="24" sid="LEV 23:24" />”قُلْ لبَني إِسرائيلَ: يكونُ لكُمُ اليومُ الأوَّلُ مِنَ الشَّهرِ السَّابعِ يومَ عُطلةٍ وتَذكارٍ واَحْتفالٍ مُقدَّسٍ على صوتِ البُوقِ. <verse eid="LEV 23:24" /><verse number="25" style="v" pubnumber="25" sid="LEV 23:25" />لا تعمَلوا فيهِ عمَلًا شاقًّا، وقرِّبوا وَقيدةً للرّبِّ“.<verse eid="LEV 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="LEV 23:26" />وكلَّمَ الرّبُّ موسى فقالَ: <verse eid="LEV 23:26" /><verse number="27" style="v" pubnumber="27" sid="LEV 23:27" />”أمَّا اليومُ العاشرُ مِنَ الشَّهر السَّابِعِ هذا، فهوَ يومُ الكفَّارةِ وفيهِ تحتفلونَ اَحْتفالًا مُقدَّسًا لكُم، وتُذلِّلونَ نُفوسَكُم بالصَّومِ وتُقرِّبونَ وَقيدةً للرّبِّ. <verse eid="LEV 23:27" /><verse number="28" style="v" pubnumber="28" sid="LEV 23:28" />وفي هذا اليومِ ذاتِهِ لا تعمَلوا عمَلًا لأنَّهُ يومُ كفَّارةٍ، يُكفِّرُ فيهِ الكاهنُ عَنكُم أمامَ الرّبِّ إلهِكُم. <verse eid="LEV 23:28" /><verse number="29" style="v" pubnumber="29" sid="LEV 23:29" />فكُلُّ مَنْ لا يُذلِّلُ نَفسَهُ بالصَّومِ في هذا اليومِ أقطعُهُ مِنْ بَينِ شعبِهِ. <verse eid="LEV 23:29" /><verse number="30" style="v" pubnumber="30" sid="LEV 23:30" />وكُلُّ مَنْ يعمَلُ فيهِ عمَلًا أُبيدُهُ مِنْ بَينِ شعبِهِ. <verse eid="LEV 23:30" /><verse number="31" style="v" pubnumber="31" sid="LEV 23:31" />عمَلًا لا تعمَلوا فيهِ. هذِهِ فريضةٌ أبديَّةٌ مدَى أجيالِكُم، في جميعِ ديارِكمُ. <verse eid="LEV 23:31" /><verse number="32" style="v" pubnumber="32" sid="LEV 23:32" />فهوَ سَبْتُ عُطلةٍ لكُم، تُذلِّلونَ فيهِ نُفوسَكُم بالصَّومِ مِنْ مساءِ اليومِ التَّاسِعِ مِنَ الشَّهرِ إلى مساءِ اليومِ العاشرِ ولا تعمَلونَ عمَلًا“.<verse eid="LEV 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" pubnumber="33" sid="LEV 23:33" />وكلَّمَ الرّبُّ موسى فقالَ: <verse eid="LEV 23:33" /><verse number="34" style="v" pubnumber="34" sid="LEV 23:34" />”قُلْ لبَني إِسرائيلَ يكونُ اليومُ الخامسَ عشَرَ مِنْ هذا الشَّهرِ السَّابعِ عيدَ المَظالِّ للرّبِّ مُدَّتُهُ سَبعةُ أيّامٍ. <verse eid="LEV 23:34" /><verse number="35" style="v" pubnumber="35" sid="LEV 23:35" />في اليومِ الأوَّلِ مِنها تحتفلونَ اَحتفالًا مُقدَّسًا لكُم، لا تعمَلونَ فيهِ عمَلًا شاقًّا. <verse eid="LEV 23:35" /><verse number="36" style="v" pubnumber="36" sid="LEV 23:36" />وتُقرِّبونَ وَقيدةً للرّبِّ سَبعةَ أيّامٍ، وفي اليومِ الثَّامنِ تحتَفلونَ اَحْتفالًا مُقدَّسًا لكُم، تُقرِّبونَ فيهِ وقيدةً للرّبِّ ولا تَعملونَ عمَلًا.<verse eid="LEV 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" pubnumber="37" sid="LEV 23:37" />”هذِهِ أعيادُ الرّبِّ الّتي تحتفلونَ فيها اَحْتفالًا مُقدَّسًا وتُقرِّبونَ للرّبِّ وقائدَ ومُحرَقاتٍ وتَقدِماتٍ وذبائحَ سَكائبَ خمرٍ، فريضةُ كُلِّ يومٍ في يومِهِ، <verse eid="LEV 23:37" /><verse number="38" style="v" pubnumber="38" sid="LEV 23:38" />وذلِكَ فَضْلًا عَنْ أيّامِ السَّبْتِ وسائرِ عطاياكُم وجميعِ نُذورِكُم وتبرُّعاتِكُم للرّبِّ.<verse eid="LEV 23:38" /></para>
  <para style="p">
    <verse number="39" style="v" pubnumber="39" sid="LEV 23:39" />”وعِندَما تجمعونَ غَلَّةَ الأرضِ تُعيِّدونَ عيدًا للرّبِّ في الخامسَ عشَرَ مِنَ الشَّهرِ السَّابِعِ مُدَّتُهُ سَبعةُ أيّامٍ في اليومِ الأوَّلِ مِنها عُطلةٌ وفي اليومِ الثَّامنِ عُطلةٌ. <verse eid="LEV 23:39" /><verse number="40" style="v" pubnumber="40" sid="LEV 23:40" />وخُذوا لكُم في اليومِ الأوَّلِ ثِمارَ أشجارٍ نَضيرةٍ وسعفَ نَخْلٍ، وأغصانَ أشجارٍ كثيفةً وصَفصافًا نهريًّا، واَفرحُوا أمامَ الرّبِّ إلهِكُم سَبعةَ أيّامٍ. <verse eid="LEV 23:40" /><verse number="41" style="v" pubnumber="41" sid="LEV 23:41" />وعيِّدوهُ عيدًا للرّبِّ سَبْعةَ أيّامٍ في السَّنةِ. تِلكَ فريضةٌ أبديَّةٌ مدَى أجيالِكُم. <verse eid="LEV 23:41" /><verse number="42" style="v" pubnumber="42" sid="LEV 23:42" />جميعُ بَني إِسرائيلَ يُقيمونَ في المَظالِّ سَبعةَ أيّامٍ، <verse eid="LEV 23:42" /><verse number="43" style="v" pubnumber="43" sid="LEV 23:43" />فتعلَمَ أجيالُكُم أنَّ الرّبَّ أسكنَ بَني إِسرائيلَ في المَظالِّ، حينَ أخرجَهُم مِنْ أرضِ مِصْرَ. هوَ الرّبُّ إلهُكُم“.<verse eid="LEV 23:43" /></para>
  <para style="p">
    <verse number="44" style="v" pubnumber="44" sid="LEV 23:44" />فأخبرَ موسى بَني إِسرائيلَ بأعيادِ الرّبِّ.<verse eid="LEV 23:44" /></para>
  <chapter eid="LEV 23" />
  <chapter number="24" style="c" sid="LEV 24" />
  <para style="s1">العناية بالسرج</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="LEV 24:1" />وكلَّمَ الرّبُّ موسى فقالَ: <verse eid="LEV 24:1" /><verse number="2" style="v" pubnumber="2" sid="LEV 24:2" />”مُرْ بَني إِسرائيلَ أنْ يُقدِّموا إليكَ زيتَ زيتونٍ مَرضوضٍ نقيٍّ للإنارةِ، تُوقِدُ بهِ السُّرُجَ دائمًا. <verse eid="LEV 24:2" /><verse number="3" style="v" pubnumber="3" sid="LEV 24:3" />في خارجِ حِجابِ تابوتِ العَهدِ، في خَيمةِ الاجتِماعِ، يُداوِمُ هرونُ على ترتيبِ السُّرُجِ أمامَ الرّبِّ مِنَ المساءِ إلى الصَّباحِ. هذِهِ فريضةٌ أبديَّةٌ مدَى أجيالِكُم. <verse eid="LEV 24:3" /><verse number="4" style="v" pubnumber="4" sid="LEV 24:4" />على المَنارةِ الطَّاهرةِ يُرتِّبُ هرونُ السُّرُجَ أمامَ الرّبِّ دائمًا.<verse eid="LEV 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="LEV 24:5" />”وخُذْ دقيقًا واَخْبُزهُ اَثني عشَرَ قُرْصًا، كُلُّ قُرْصٍ عُشْرا قُفَّةٍ، <verse eid="LEV 24:5" /><verse number="6" style="v" pubnumber="6" sid="LEV 24:6" />واَجعلْها صَفَّينِ، كُلُّ صَفٍّ سِتَّةُ أقراصٍ مُرتَّبةٍ على المائدةِ الطَّاهرةِ أمامَ الرّبِّ. <verse eid="LEV 24:6" /><verse number="7" style="v" pubnumber="7" sid="LEV 24:7" />واَجعلْ على كلِّ صَفٍّ بَخورًا صافيًا، فيكونَ معَ الخُبزِ عَيّنةً لوَقيدةٍ للرّبِّ. <verse eid="LEV 24:7" /><verse number="8" style="v" pubnumber="8" sid="LEV 24:8" />في كُلِّ يومِ سَبْتٍ تُرتِّبُ الأقراصَ أمامَ الرّبِّ دائمًا عَنْ بَني إِسرائيلَ. هذا عَهدٌ علَيهِم إلى الأبدِ. <verse eid="LEV 24:8" /><verse number="9" style="v" pubnumber="9" sid="LEV 24:9" />فتكونُ الأقراصُ لهرونَ وبَنيه يأكُلونَها في موضِعٍ مُقدَّسٍ، لأنَّها مُقدَّسةٌ كُلَّ التَّقديسِ لَه مِنْ وقائدِ الرّبِّ. هذِهِ فريضةٌ أبديَّةٌ“.<verse eid="LEV 24:9" /></para>
  <para style="s1">مثل على العقاب العادل</para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="LEV 24:10" />وكانَ رَجُلٌ أُمُّه إِسرائيليَّةٌ وأبوهُ مِصْريٌّ ويُقيمُ فيما بَينَ بَني إِسرائيلَ، فخرَجَ وخاصمَ في المَحلَّةِ رَجُلًا إِسرائيليًّا <verse eid="LEV 24:10" /><verse number="11" style="v" pubnumber="11" sid="LEV 24:11" />وجدَّفَ على اَسْمِ الرّبِّ ولعنَهُ، فقادُوه إلى موسى. وكانَ اَسْمُ أمِّهِ شلوميةَ بنتَ ديبري مِنْ عَشيرةِ دانَ. <verse eid="LEV 24:11" /><verse number="12" style="v" pubnumber="12" sid="LEV 24:12" />فألقَوهُ في السِّجنِ حتّى يتبيَّنَ لهُم ما يُريدُ الرّبُّ. <verse eid="LEV 24:12" /><verse number="13" style="v" pubnumber="13" sid="LEV 24:13" />فكلَّمَ الرّبُّ موسى فقالَ: <verse eid="LEV 24:13" /><verse number="14" style="v" pubnumber="14" sid="LEV 24:14" />”يُخرَجُ اللَّاعِنُ إلى خارجِ المَحلَّةِ، ويضَعُ كُلُّ مَنْ سَمِعَه أيديَهُم على رأسِه ويَرجُمُه كُلُّ الجماعةِ. <verse eid="LEV 24:14" /><verse number="15" style="v" pubnumber="15" sid="LEV 24:15" />وقُلْ لِبَني إِسرائيلَ: ”مَنْ لَعَنَ إلهَهُ تَحمَّلَ عاقبةَ خطيئتِهِ، <verse eid="LEV 24:15" /><verse number="16" style="v" pubnumber="16" sid="LEV 24:16" />ومَنْ جدَّفَ على اَسْمِ الرّبِّ، يُقتَلْ قَتلًا. تَرجُمُهُ كُلُّ الجماعةِ، دَخيلًا كانَ أم أصيلًا.<verse eid="LEV 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="LEV 24:17" />”مَنْ قَتلَ إنسانًا، يُقتَلْ قَتلًا، <verse eid="LEV 24:17" /><verse number="18" style="v" pubnumber="18" sid="LEV 24:18" />ومَنْ قتَلَ بَهيمةً، يُعوِّضْ مِثلَها رأسًا بَدلَ رأسٍ.<verse eid="LEV 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="LEV 24:19" />”مَنْ أضرَّ بآخَرَ، يُفعَلْ بهِ كما فعَلَ: <verse eid="LEV 24:19" /><verse number="20" style="v" pubnumber="20" sid="LEV 24:20" />الكَسْرُ بالكَسْرِ والعَينُ بالعَينِ، والسِّنُّ بالسِّنِّ، كالضَّررِ الّذي يُنزِلُه بهِ. وكذلكَ كُلُّ ضَررٍ يُنزِلُهُ الإنسانُ بالإنسانِ ينزِلُ بهِ مِثلُهُ.<verse eid="LEV 24:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="LEV 24:21" />”مَنْ قتَلَ بَهيمَةً يُعَوِّضْها، ومَنْ قتَلَ إنسانًا يُقتَلْ. <verse eid="LEV 24:21" /><verse number="22" style="v" pubnumber="22" sid="LEV 24:22" />حُكْمٌ واحدٌ يكونُ لكُم جميعًا، للدَّخيلِ كما للأصيلِ. أنا الرّبُّ إلهُكُم“.<verse eid="LEV 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="LEV 24:23" />فلمَّا أخبرَ موسى بَني إِسرائيلَ بهذا الكلامِ أخرجوا اللَّاعِنَ إلى خارجِ المحَلَّةِ ورجمُوهُ بالحجارةِ، كما أمرَ الرّبُّ موسى.<verse eid="LEV 24:23" /></para>
  <chapter eid="LEV 24" />
  <chapter number="25" style="c" sid="LEV 25" />
  <para style="s1">السنة السابعة</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="LEV 25:1" />وكلَّمَ الرّبُّ موسى في جبَلِ سيناءَ فقالَ: <verse eid="LEV 25:1" /><verse number="2" style="v" pubnumber="2" sid="LEV 25:2" />”قُلْ لبَني إِسرائيلَ إذا دخلْتُمُ الأرضَ الّتي أُعطِيها لكُم، فليَكُنْ لها سَبْتُ عُطلةٍ للرّبِّ. <verse eid="LEV 25:2" /><verse number="3" style="v" pubnumber="3" sid="LEV 25:3" />سِتَّ سنينَ تَزرعونَ حُقولَكُم، وسِتَّ سنينَ تَقضِبونَ كرومَكُم وتَجمعونَ غِلالَها، <verse eid="LEV 25:3" /><verse number="4" style="v" pubnumber="4" sid="LEV 25:4" />وفي السَّنةِ السَّابعةِ يكونُ للأرضِ سَبْتُ عُطلةٍ مُكرَّسٌ للرّبِّ، فلا تَزرعوا حُقولَكُم ولا تَقضِبوا كرومَكُم. <verse eid="LEV 25:4" /><verse number="5" style="v" pubnumber="5" sid="LEV 25:5" />والحصيدُ النَّابتُ مِنْ تِلقاءِ ذاتِهِ لا تحصدُوه ولا تقطُفوهُ، عِنَبُ كرومِكُم غَيرِ المَقضوبةِ، لأنَّها سَنةُ عطلةٍ للأرضِ. <verse eid="LEV 25:5" /><verse number="6" style="v" pubnumber="6" sid="LEV 25:6" />ولكنَّها معَ ذلِكَ تُطعِمُكُم أنتُم وعبيدَكُم وجواريَكُم وأُجراءَكُم وضُيوفَكُمُ النَّازلينَ فيما بَينَكم <verse eid="LEV 25:6" /><verse number="7" style="v" pubnumber="7" sid="LEV 25:7" />وبهائِمَكُم والوحوشَ الّتي في أرضِكُم.<verse eid="LEV 25:7" /></para>
  <para style="s1">سنة اليوبيل</para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="LEV 25:8" />”واَحْسِبُوا لكُم سَبْعَ سِنينَ سَبْعَ مرَّاتٍ، فيكونَ لكُم تِسْعٌ وأربعونَ سنَةً. <verse eid="LEV 25:8" /><verse number="9" style="v" pubnumber="9" sid="LEV 25:9" />وفي اليومِ العاشرِ مِنَ الشَّهر السَّابعِ، في يومِ الكَفَّارةِ، تنفخونَ في البُوقِ في أرضِكُم كُلِّها. <verse eid="LEV 25:9" /><verse number="10" style="v" pubnumber="10" sid="LEV 25:10" />وتُكرِّسونَ لي سنَةَ الخمسينَ وتنادُونَ بِتحريرِ أهلِ الأرضِ كُلِّها، فتكونُ لكُم يُوبيلًا وترجِعوا، كُلُّ واحدٍ مِنكُم إلى مُلْكِهِ وإلى عَشيرتِهِ. <verse eid="LEV 25:10" /><verse number="11" style="v" pubnumber="11" sid="LEV 25:11" />لا تَزرعوا فِيها ولا تحصدوا الحصيدَ النَّابِتَ مِنْ تِلْقاءِ ذاتِهِ، ولا تقطفوا عِنبَ كرومِكُم غيرِ المَقضوبةِ. <verse eid="LEV 25:11" /><verse number="12" style="v" pubnumber="12" sid="LEV 25:12" />فهيَ يُوبيلٌ، مُقدَّسةً تكونُ لكُم، وفيها تأكلونَ مِمَّا تَغلُّهُ الحُقولُ مِنْ تِلقاءِ ذاتِها. <verse eid="LEV 25:12" /><verse number="13" style="v" pubnumber="13" sid="LEV 25:13" />”وفي سنَةِ اليوبيلِ هذِهِ ترجعونَ، كُلُّ واحدٍ إلى مُلْكِهِ.<verse eid="LEV 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="LEV 25:14" />”إذا بِعتَ مِنْ أحدٍ أوِ اَبتعتَ مِنهُ، فلا يَغبَنْ أحدُكُما الآخَرَ. <verse eid="LEV 25:14" /><verse number="15" style="v" pubnumber="15" sid="LEV 25:15" />بل بِحسَبِ عددِ السِّنينَ، مِنْ بَعدِ سنَةِ اليوبيلِ تشتري مِنهُ، وبِحسَبِ الغَلَّةِ يبيعُكَ. <verse eid="LEV 25:15" /><verse number="16" style="v" pubnumber="16" sid="LEV 25:16" />وبِحسَبِ كثرةِ السِّنينَ تُكثِّرُ لَه الثَّمنَ، وبِحسَبِ قِلَّتِها تُقلِّلُه، لأنَّه يَبيعُكَ غِلالًا مَعدودةً. <verse eid="LEV 25:16" /><verse number="17" style="v" pubnumber="17" sid="LEV 25:17" />فلا يَغبَنْ أحدُكُما الآخَرَ، بلِ اَتَّقوا إلهَكُم. أنا الرّبُّ إلهُكُم. <verse eid="LEV 25:17" /><verse number="18" style="v" pubnumber="18" sid="LEV 25:18" />فاَعمَلوا بفَرائضي وأحكامي واَحفظوها، فتُقيموا بالأرضِ آمنينَ. <verse eid="LEV 25:18" /><verse number="19" style="v" pubnumber="19" sid="LEV 25:19" />وتُخرِجُ الأرضُ ثَمَرَها، فتأكلونَ وتشبعونَ وتُقيمونَ آمنينَ. <verse eid="LEV 25:19" /><verse number="20" style="v" pubnumber="20" sid="LEV 25:20" />”فإنْ قُلتُم. ماذا نأكلُ في السَّنةِ السَّابعةِ إذا كُنَّا لا نزرعُ ولا نجمعُ غِلالَنا؟ <verse eid="LEV 25:20" /><verse number="21" style="v" pubnumber="21" sid="LEV 25:21" />أجبتُكُم إنِّي أباركُ لكُمُ الأرضَ في السَّنةِ السَّادسةِ، فَتُغِلُّ لثلاثِ سِنينَ. <verse eid="LEV 25:21" /><verse number="22" style="v" pubnumber="22" sid="LEV 25:22" />فتَزرعونَ في السَّنةِ الثَّامنةِ وتأكلونَ مِنَ الغَلَّةِ القديمةِ إلى مَجيءِ غَلَّتِها في السَّنةِ التَّاسعةِ.<verse eid="LEV 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="LEV 25:23" />”والأرضُ لا تُباعُ بَيعًا دائمًا، فالأرضُ لي وأنتم غُرَباءُ مُقيمونَ عِندي. <verse eid="LEV 25:23" /><verse number="24" style="v" pubnumber="24" sid="LEV 25:24" />بل في كُلِّ أرضٍ تَملكونَها تُعطُونَ للمالكِ الأصيلِ حَقَّ فِكاكِها. <verse eid="LEV 25:24" /><verse number="25" style="v" pubnumber="25" sid="LEV 25:25" />إذا اَفتقرَ أخوكَ الإسرائيليُّ فباعَ شيئًا مِنْ مُلْكهِ، حَقَّ لأقربِ أقربائِهِ أنْ يَفُكَّ بَيعَهُ. <verse eid="LEV 25:25" /><verse number="26" style="v" pubnumber="26" sid="LEV 25:26" />ومَنْ لا يكونُ لَه أحدٌ يَفُكُّ بَيعَهُ، فلَه أنْ يَفُكَّها هوَ بنفسِهِ إذا تيسَّرَ في يَدهِ مِقدارُ فِكاكِها. <verse eid="LEV 25:26" /><verse number="27" style="v" pubnumber="27" sid="LEV 25:27" />فيَحسِبُ عددَ سنينَ البَيعِ ويدفعُ إلى المُشتري ما يَحقُّ لَه عنِ السِّنينَ المُتَبقِّيةِ إلى سنَةِ اليُوبيلِ ويرجِعُ إلى مُلْكِهِ. <verse eid="LEV 25:27" /><verse number="28" style="v" pubnumber="28" sid="LEV 25:28" />وإنْ كانَ مِقدارُ ما علَيهِ دَفعُهُ غيرَ مُتيسِّرٍ لَه، يبقى مَبيعُهُ في يَدِ مُشتريهِ إلى سنَةِ اليُوبيلِ، وفي سنَةِ اليُوبيلِ يخرُجُ المُشتري مِنه ويرجِعُ إلى مُلْكِهِ.<verse eid="LEV 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="LEV 25:29" />”ومَنْ باعَ بَيتَ إقامةٍ في مدينةٍ لها سُورٌ، فلَه أنْ يَفكَّهُ في السَّنة الأولى مِنْ يومِ بَيعِهِ، <verse eid="LEV 25:29" /><verse number="30" style="v" pubnumber="30" sid="LEV 25:30" />وإلَّا ثبَتَ البيتُ لمُشتريهِ وورَثَتِهِ مدَى أجيالِهِم، ولا يخرُجُ مِنهُ في سنَةِ اليوبيلِ. <verse eid="LEV 25:30" /><verse number="31" style="v" pubnumber="31" sid="LEV 25:31" />وبيوتُ القُرى الّتي لا سُورَ يُحيطُ بِها، تُحسَبُ مِثلَ الحُقولِ، يَفكُّها بائِعُها ويخرُجُ مِنها مُشتريها في سنَةِ اليُوبيلِ إنْ بقيتْ في يَدِهِ.<verse eid="LEV 25:31" /></para>
  <para style="p">
    <verse number="32" style="v" pubnumber="32" sid="LEV 25:32" />”وأمَّا اللَّاويُّونَ، فلَهُم في أيِّ وقتٍ أنْ يَفكُّوا البُيوتَ التي يَملكونها في مُدُنِ سُكْناهُم. <verse eid="LEV 25:32" /><verse number="33" style="v" pubnumber="33" sid="LEV 25:33" />ومَنِ اَشترى بَيتًا يَمِلكُهُ أحدُ اللَّاويِّينَ في مدينةِ سُكناهُ، يخرُجُ مِنهُ في سنَةِ اليُوبيلِ لأنَّ بيوتَ اللَّاويِّينَ في مُدُنِ سُكْناهُم هي مُلْكٌ لهُم فيما بَينَ بَني إِسرائيلَ. <verse eid="LEV 25:33" /><verse number="34" style="v" pubnumber="34" sid="LEV 25:34" />وأمَّا ضواحي مُدُنهِم فلا تُباعُ لأنَّها مُلْكٌ مُؤبَّدٌ لهُم.<verse eid="LEV 25:34" /></para>
  <para style="s1">معاملة الفقير والعبد</para>
  <para style="p">
    <verse number="35" style="v" pubnumber="35" sid="LEV 25:35" />”إذا اَفْتقرَ إِسرائيليٌّ عِندكَ وقصُرَت يَدُهُ عَنِ العَيشِ، فأعِنْهُ وليَعِشْ معَكَ كغريبٍ ومُقيمٍ. <verse eid="LEV 25:35" /><verse number="36" style="v" pubnumber="36" sid="LEV 25:36" />لا تأخُذْ مِنهُ رِبًا ولا رِبحًا، بلِ اَتَّقِ إلهَكَ فيَعيشَ معَكَ. <verse eid="LEV 25:36" /><verse number="37" style="v" pubnumber="37" sid="LEV 25:37" />لا تُقرِضْهُ مالَكَ بِرِبًا ولا تُطعِمْهُ بِرِبحٍ. <verse eid="LEV 25:37" /><verse number="38" style="v" pubnumber="38" sid="LEV 25:38" />أنا الرّبُّ إلهُكُم الّذي أخرجَكُم مِنْ أرضِ مِصْرَ لأُعطيَكُم أرضَ كنعانَ وأكونَ لكُم إلهًا.<verse eid="LEV 25:38" /></para>
  <para style="p">
    <verse number="39" style="v" pubnumber="39" sid="LEV 25:39" />”وإذا اَفْتَقرَ إِسرائيليٌّ عِندَكَ وباعَ نفْسَهُ لكَ، فلا تستَخدِمْهُ خِدمةَ العبيدِ <verse eid="LEV 25:39" /><verse number="40" style="v" pubnumber="40" sid="LEV 25:40" />بل كأجيرٍ ومُقيمٍ يكونُ معَكَ ويخدِمُكَ إلى سنَةِ اليُوبيلِ. <verse eid="LEV 25:40" /><verse number="41" style="v" pubnumber="41" sid="LEV 25:41" />ثُمَّ يخرُجُ مِنْ عِندِكَ، هوَ وبنوهُ معَهُ، ويرجِعُ إلى عَشيرتِه ومُلْكِ آبائِهِ. <verse eid="LEV 25:41" /><verse number="42" style="v" pubnumber="42" sid="LEV 25:42" />فبَنو إِسرائيلَ الّذينَ أخرَجْتُهم مِنْ أرضِ مِصْرَ هُم عِبادي ولا يُباعُونَ بَيعَ العبيدِ. <verse eid="LEV 25:42" /><verse number="43" style="v" pubnumber="43" sid="LEV 25:43" />لا تتسلَّطْ علَيهِ بعُنْفٍ، بلِ اَتَّقِ إلهَكَ.<verse eid="LEV 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" pubnumber="44" sid="LEV 25:44" />”مِنَ الأُمَمِ الّذينَ حَوالَيكُم تَقتَنُونَ العبيدَ والإماءَ. <verse eid="LEV 25:44" /><verse number="45" style="v" pubnumber="45" sid="LEV 25:45" />وتَقتَنونَهُم أيضًا مِنْ أبناءِ الغُرَباءِ المُقيمينَ معَكُم ومِنْ عَشائِرِهمِ الّذينَ عِندَكُم، المولودينَ في أرضِكُم. هؤلاءِ تأخذونَهُم لكُم <verse eid="LEV 25:45" /><verse number="46" style="v" pubnumber="46" sid="LEV 25:46" />وتُورِثونَهُم لِبَنيكُم مِنْ بَعدِكُم مُلْكًا لهُم، فيستعبدونَهُم ما داموا أحياءً، وأمَّا إخوتُكُم بَنو إِسرائيلَ، فلا يتسلَّطْ أحدُهُم على آخَرَ بِعُنْفٍ.<verse eid="LEV 25:46" /></para>
  <para style="p">
    <verse number="47" style="v" pubnumber="47" sid="LEV 25:47" />”وإذا اَغتنى غريبٌ أو مُقيمٌ عِندَكَ واَفتقرَ إِسرائيليٌّ عِندَهُ وباعَ نفْسَهُ لَه أو لأحدٍ مِنْ عَشيرتهِ، <verse eid="LEV 25:47" /><verse number="48" style="v" pubnumber="48" sid="LEV 25:48" />حَقَّ لِواحدٍ مِنْ إخوتِهِ أنْ يفُكَّ بَيعَهُ <verse eid="LEV 25:48" /><verse number="49" style="v" pubnumber="49" sid="LEV 25:49" />أو يَفُكَّهُ عَمُّهُ أو اَبنُ عمِّهِ، أو غيرُهُما مِنْ أقربائِه وعَشيرتِه، أو هوَ نفْسُهُ إذا تيسَّرَ لَه الأمرُ. <verse eid="LEV 25:49" /><verse number="50" style="v" pubnumber="50" sid="LEV 25:50" />فيُحاسِبُ مُشتَريَهُ مِنْ سنَةِ بَيعِهِ إلى سنَةِ اليُوبيلِ، ويكونُ ثَمنُ بيعِهِ على حسَبِ مَجموعِ عددِ السِّنينَ، كما لو كانَ فيها أجيرًا عِندَهُ. <verse eid="LEV 25:50" /><verse number="51" style="v" pubnumber="51" sid="LEV 25:51" />فإنْ بقيَ مِنَ السِّنينَ كثيرٌ إلى سنَةِ اليُوبيلِ، فعلى حسَبِها يدفعُ إلى المُشتري ليَفُكَّ بَيعَهُ. <verse eid="LEV 25:51" /><verse number="52" style="v" pubnumber="52" sid="LEV 25:52" />وإنْ بقيَ منها قليلٌ إلى سنَةِ اليُوبيلِ فعلى حسَبِ السِّنينَ الّتي قضاها في خِدمَتِه يُحاسِبُه ويدفعُ إليهِ أيضًا ما يَفُكُّ بَيعَهُ. <verse eid="LEV 25:52" /><verse number="53" style="v" pubnumber="53" sid="LEV 25:53" />ويكونُ هذا كلُّهُ كما لو كانَ أجيرًا سَنويًّا عِندَهُ. لا يتسلَّطْ علَيه بعُنْفٍ أمامَ عيونِكُم.<verse eid="LEV 25:53" /></para>
  <para style="p">
    <verse number="54" style="v" pubnumber="54" sid="LEV 25:54" />”وإنْ لم يَفُكَّ بَيعَهُ بإحدى تِلكَ الطُّرقِ، يخرُجُ مِنْ عِندِ مُشتَريهِ في سنَةِ اليُوبيلِ هوَ وبَنوهُ معَهُ. <verse eid="LEV 25:54" /><verse number="55" style="v" pubnumber="55" sid="LEV 25:55" />فبَنو إِسرائيلَ عِبادي، أخرَجتُهُم مِنْ أرضِ مِصْرَ. أنا الرّبُّ إلهُهُم“.<verse eid="LEV 25:55" /></para>
  <chapter eid="LEV 25" />
  <chapter number="26" style="c" sid="LEV 26" />
  <para style="s1">جزاء الطاعة</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="LEV 26:1" />”لا تصنَعوا لكُم أوثانًا ولا تَماثيلَ مَنحوتةً، ولا تُقيموا نُصْبًا ولا أحجارًا مُزَخرَفةً في أرضِكُم لِتَسجدوا لها، لأنِّي أنا الرّبُّ إلهُكُم. <verse eid="LEV 26:1" /><verse number="2" style="v" pubnumber="2" sid="LEV 26:2" />اَحتفِظوا لي بأيّامِ السَّبْتِ وتَهَيَّبوا معبَدي المُقَدَّسَ. أنا الرّبُّ.<verse eid="LEV 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="LEV 26:3" />”إنْ سلَكتُم في فرائِضي وحَفِظتُم وصايايَ وعَمِلتُم بِها <verse eid="LEV 26:3" /><verse number="4" style="v" pubnumber="4" sid="LEV 26:4" />أنزَلتُ المطَرَ علَيكُم في حينِهِ، فتُخرِجُ الأرضُ غِلالَها وشجَرُ الحَقلِ ثَمرَهُ <verse eid="LEV 26:4" /><verse number="5" style="v" pubnumber="5" sid="LEV 26:5" />ويتَّصلُ أوانُ دَرْسِ الحِنطةِ بقطافِ العِنَبِ، وقطافُ العِنَبِ بالزَّرعِ، وتأكلونَ طَعامَكُم وتشبعونَ وتُقيمونَ في أرضِكُم آمِنينَ.<verse eid="LEV 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="LEV 26:6" />”وأُلقي السَّلامَ في الأرضِ، فتنامونَ ولا مَنْ يُرعِبُكُم وأُزيلُ الوحوشَ الضَّاريَةَ مِنَ الأرضِ، وحربٌ لا تَعبرُ أرضَكُم. <verse eid="LEV 26:6" /><verse number="7" style="v" pubnumber="7" sid="LEV 26:7" />وتطردونَ أعداءَكُم، فيَسقطونَ أمامَكُم بالسَّيفِ. <verse eid="LEV 26:7" /><verse number="8" style="v" pubnumber="8" sid="LEV 26:8" />تطردُ الخمسَةُ مِنكُم مئةً، والمئةُ عشَرةَ آلافٍ، ويسقطُ أعداؤُكُم أمامَكُم بالسَّيفِ.<verse eid="LEV 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="LEV 26:9" />”وألتَفِتُ إليكُم وأُنمِّيكُم وأُكثِّرُكُم وأُقيمُ عَهدي لكُم. <verse eid="LEV 26:9" /><verse number="10" style="v" pubnumber="10" sid="LEV 26:10" />وتأكلونَ مِنْ قديمِ غِلالِكُم إلى أنْ تُخرِجوه لِتَخزُنوا الجديدَ. <verse eid="LEV 26:10" /><verse number="11" style="v" pubnumber="11" sid="LEV 26:11" />وأجعَلُ مَسكِني فيما بَينَكُم ولا أنبِذُكُم. <verse eid="LEV 26:11" /><verse number="12" style="v" pubnumber="12" sid="LEV 26:12" />وأسيرُ فيما بَينَكُم، وأكونُ لكُم إلهًا، وأنتُم تكونونَ لي شعبًا. <verse eid="LEV 26:12" /><verse number="13" style="v" pubnumber="13" sid="LEV 26:13" />أنا الرّبُّ إلهُكُم الّذي أخرجَكُم مِنْ أرضِ المِصْريِّينَ لِئلَّا تكونوا عبيدًا لهُم، وحطَّمَ أغلالَ نيرِكُم وجعَلَكُم تسيرونَ مَرفُوعي الرَّأسِ.<verse eid="LEV 26:13" /></para>
  <para style="s1">جزاء العصيان</para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="LEV 26:14" />”وإنْ كنتُم لا تسمَعونَ لي ولا تعمَلونَ بجميعِ هذِهِ الوصايا، <verse eid="LEV 26:14" /><verse number="15" style="v" pubnumber="15" sid="LEV 26:15" />ورفَضْتُم فَرائضي، ونبَذْتُم أحكامي، ونقَضْتُم عَهدي ولم تعمَلوا بجميعِ وصايايَ، <verse eid="LEV 26:15" /><verse number="16" style="v" pubnumber="16" sid="LEV 26:16" />فأنا أيضًا أعامِلُكُم بالمِثْلِ، فأجلبُ علَيكُم رُعبًا، وداءً عُضَالًا، وحُمَّى تُفني العينينِ وتُتلِفُ النَّفْسَ، وتزرعونَ زرعَكُم باطلًا فيأكلُهُ أعداؤُكُم. <verse eid="LEV 26:16" /><verse number="17" style="v" pubnumber="17" sid="LEV 26:17" />وأميلُ بوجهي علَيكُم، فتَنهزِمونَ مِنْ أمامِ أعدائِكُم، ويتسلَّطُ علَيكُم مُبغضوكُم، وتهربونَ ولا مَنْ يطردُكُم. <verse eid="LEV 26:17" /><verse number="18" style="v" pubnumber="18" sid="LEV 26:18" />وإنْ كنتُم بَعدَ هذا كُلِّه لا تسمعونَ لي، زِدتُكُم تأديبًا على خطاياكُم سَبعةَ أضعافٍ، <verse eid="LEV 26:18" /><verse number="19" style="v" pubnumber="19" sid="LEV 26:19" />فأُحطِّمُ جاهَكُم وعِزَّكُم، وأجعَلُ سَماءَكُم كالحديدِ وأرضَكُم كالنُّحاسِ <verse eid="LEV 26:19" /><verse number="20" style="v" pubnumber="20" sid="LEV 26:20" />وتستَنفِدونَ قِواكُم عَبَثًا، ولا تُعطي أرضُكُم غَلَّتَها، ولا يُخرِجُ شجَرُ الأرضِ ثَمرَهُ.<verse eid="LEV 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="LEV 26:21" />”وإنْ تَمادَيتُم في مُخالفتي وما سَمِعْتُم لي، زِدْتُكم سَبعةَ أضعافٍ مِنَ الضَّرَباتِ على خطاياكُم <verse eid="LEV 26:21" /><verse number="22" style="v" pubnumber="22" sid="LEV 26:22" />وأطلقتُ علَيكُم وحُوشَ البريَّةِ، فَتُفقِدُكُم أولادَكُم وتُهلِكُ بهائِمَكُم وتُقلِّلُ عددَكُم حتّى تُقفِرَ طُرقاتُكُم.<verse eid="LEV 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="LEV 26:23" />”وإنْ كانَ هذا لا يُؤدِّبُكُم وتَمادَيتُم في مُخالفتي <verse eid="LEV 26:23" /><verse number="24" style="v" pubnumber="24" sid="LEV 26:24" />تَمادَيتُ أنا أيضًا في مُخالفتِكُم وضَرَبْتُكُم سَبعةَ أضعافٍ على خطاياكُم <verse eid="LEV 26:24" /><verse number="25" style="v" pubnumber="25" sid="LEV 26:25" />فأجلبُ علَيكُم حربًا تَنتَقِمُ للعَهدِ الّذي بَيني وبَينَكُم، فتَتَجَمَّعونَ إلى مُدنِكُم هاربينَ وأُرسِلُ الوباءَ فيما بَينَكُم وتُسَلَّمُونَ إلى أيدي أعدائِكُم. <verse eid="LEV 26:25" /><verse number="26" style="v" pubnumber="26" sid="LEV 26:26" />وأقطعُ عَنكُم كفايتَكُم مِنَ الخُبزِ، وهوَ قِوامُ حياتِكُم، فتَخبُزُ عَشْرُ نِساءٍ الخُبزَ في تنُّورٍ واحدٍ ويُوزِّعْنَه بالتَّقتيرِ، وتأكلونَ ولا تشبعونَ.<verse eid="LEV 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="LEV 26:27" />”وإنْ كنتُم بهذا كُلِّه لا تسمعونَ لي وتَماديتُم في مُخالفتي، <verse eid="LEV 26:27" /><verse number="28" style="v" pubnumber="28" sid="LEV 26:28" />تَمادَيتُ أنا أيضًا في مُخالفتِكُم ساخِطًا وأدَّبتُكُم سَبعةَ أضعافٍ على خطاياكُم، <verse eid="LEV 26:28" /><verse number="29" style="v" pubnumber="29" sid="LEV 26:29" />فتأكلونَ لُحومَ بَنيكم وبَناتِكُم، <verse eid="LEV 26:29" /><verse number="30" style="v" pubnumber="30" sid="LEV 26:30" />وأهدِمُ مَعابِدَكُمُ العاليةَ، وأُحطِّمُ مذابحَ بَخورِكُم، وأُلقي جُثَثَكُم على جُثَثِ أصنامِكُم وتَعافُكُم نفْسي. <verse eid="LEV 26:30" /><verse number="31" style="v" pubnumber="31" sid="LEV 26:31" />وأجعَلُ مُدُنَكُم خَرابًا وأماكِنَكُمُ المُقدَّسةَ قَفرًا، ولا أشتَمُّ رائحةَ مُحرَقاتِكُم لمُراضاتي. <verse eid="LEV 26:31" /><verse number="32" style="v" pubnumber="32" sid="LEV 26:32" />وأتركُ الأرضَ قفرًا، فينذَهِلُ لها أعداؤُكُمُ المُقيمونَ فيها. <verse eid="LEV 26:32" /><verse number="33" style="v" pubnumber="33" sid="LEV 26:33" />وأُشتِّتُكُم فيما بَينَ الأُمَمِ، وأشهَرُ وراءَكُم سيفًا، فتصيرُ أرضُكُم قَفرًا ومُدنُكُم خَرابًا. <verse eid="LEV 26:33" /><verse number="34" style="v" pubnumber="34" sid="LEV 26:34" />فتنعمُ الأرضُ براحتِها طُولَ أيّامِ خُلُوِّها مِنكُم، وأنتُم في أرضِ أعدائِكُم. نعم، ترتاحُ الأرضُ وتنعمُ براحتِها <verse eid="LEV 26:34" /><verse number="35" style="v" pubnumber="35" sid="LEV 26:35" />طُولَ أيّامِ خُلُوِّها مِنكُم. فهيَ قَلَّما اَرتاحت في أيّامِ سُبوتِها وأنتُم مُقيمونَ بِها.<verse eid="LEV 26:35" /></para>
  <para style="p">
    <verse number="36" style="v" pubnumber="36" sid="LEV 26:36" />”والباقونَ مِنكُم أُلقي الجَبانةَ في قُلوبِهِم، في أراضي أعدائِهِم، حتّى إنَّ صوتَ ورقةٍ مُتحرِّكةٍ يَهزمُهُم، فيَهربونَ هرَبَهُم مِنَ السَّيفِ ولا مَنْ يطردُهُم. <verse eid="LEV 26:36" /><verse number="37" style="v" pubnumber="37" sid="LEV 26:37" />ويَعثُرُ الواحدُ مِنهمُ بالآخَرِ، كمَنْ يهرُبُ مِنْ أمامِ السَّيفِ ولا مَنْ يطردُهُ، ولا يقومُ لكم قائمةٌ في وجوهِ أعدائِكُم. <verse eid="LEV 26:37" /><verse number="38" style="v" pubnumber="38" sid="LEV 26:38" />وتَبيدونَ بَينَ الأممِ وتبتلِعُكُم أرضُ أعدائِكُم. <verse eid="LEV 26:38" /><verse number="39" style="v" pubnumber="39" sid="LEV 26:39" />والباقونَ مِنكُم يسيرونَ إلى الزَّوالِ عِقابًا على آثامِهِم وآثامِ آبائِهِم في أراضي أعدائِكُم، <verse eid="LEV 26:39" /><verse number="40" style="v" pubnumber="40" sid="LEV 26:40" />حتّى إذا اَعترفوا بآثامِهِم وآثامِ آبائِهِم، وبخيانتِهِم لي وتَماديهِم في مُخالفتي، <verse eid="LEV 26:40" /><verse number="41" style="v" pubnumber="41" sid="LEV 26:41" />بحيثُ تَماديتُ أنا أيضًا في مُخالفتِهِم، فأدخلتُهُم أرضَ أعدائِهِم حتّى تخضعَ قلوبُهُمُ الكافرةُ ويتحَمَّلوا جَزاءَ آثامِهِم <verse eid="LEV 26:41" /><verse number="42" style="v" pubnumber="42" sid="LEV 26:42" />ذكَرْتُ عَهدي معَ يَعقوبَ وإسحَقَ وإبراهيمَ وذكَرْتُ الأرضَ <verse eid="LEV 26:42" /><verse number="43" style="v" pubnumber="43" sid="LEV 26:43" />الّتي أخليتُها مِنهُم لتنعَمَ براحتِها في خُلوِّها مِنهُم، وليَتَحَمَّلوا جَزاءَ آثامِهِم لأنَّهُم رفَضُوا أحكامي ونبذوا فرائضي.<verse eid="LEV 26:43" /></para>
  <para style="p">
    <verse number="44" style="v" pubnumber="44" sid="LEV 26:44" />”وإلى ذلِكَ الحينِ لا أرفُضُهُم كُلَّ الرَّفْضِ وهُم في أرضِ أعدائِهِم، ولا أنبذُهُم بحيثُ أَفنيهِم وأنقضُ عَهدي معَهُم، فأنا الرّبُّ إلهُهُم. <verse eid="LEV 26:44" /><verse number="45" style="v" pubnumber="45" sid="LEV 26:45" />بل أذكرُ عَهدي للأوَّلينَ الّذينَ أخرَجْتُهُم مِنْ أرضِ مِصْرَ، على مشهدٍ مِنَ الأُمَمِ، لأكونَ لهُم إلهًا. أنا الرّبُّ“.<verse eid="LEV 26:45" /></para>
  <para style="p">
    <verse number="46" style="v" pubnumber="46" sid="LEV 26:46" />تلكَ هيَ الفرائِضُ والأحكامُ والشَّرائعُ الّتي وضعَها الرّبُّ لبَني إِسرائيلَ، في جبَلِ سيناءَ، على يدِ موسى.<verse eid="LEV 26:46" /></para>
  <chapter eid="LEV 26" />
  <chapter number="27" style="c" sid="LEV 27" />
  <para style="s1">النذور</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="LEV 27:1" />وكلَّمَ الرّبُّ موسى فقالَ: <verse eid="LEV 27:1" /><verse number="2" style="v" pubnumber="2" sid="LEV 27:2" />”قُلْ لبَني إِسرائيلَ: إذا نذَرَ أحدٌ إنسانًا للرّبِّ وأرادَ أنْ يَفُكَّ نَذْرَهُ، فعلى حسَبِ تَقويمِكَ لهُ. <verse eid="LEV 27:2" /><verse number="3" style="v" pubnumber="3" sid="LEV 27:3" />فيكونُ تَقويمُكَ للذَّكَرِ مِنْ اَبنِ عِشرينَ سنَةً إلى اَبنِ ستِّينَ سنَةً خمسينَ مِثقالَ فِضَّةٍ بالسِّعرِ الرَّسميِّ، <verse eid="LEV 27:3" /><verse number="4" style="v" pubnumber="4" sid="LEV 27:4" />وللأُنثى ثلاثينَ مِثقالًا، <verse eid="LEV 27:4" /><verse number="5" style="v" pubnumber="5" sid="LEV 27:5" />وللذَّكَرِ مِنْ اَبنِ خمْسِ سنينَ إلى اَبنِ عِشرينَ سنَةً عِشرينَ مِثقالًا وللأُنثى عشَرَةَ مثاقيلَ، <verse eid="LEV 27:5" /><verse number="6" style="v" pubnumber="6" sid="LEV 27:6" />وللذَّكَرِ مِنْ اَبنِ شهرٍ إلى اَبنِ خمْسِ سنينَ خَمسةَ مثاقيلَ فضَّةٍ، <verse eid="LEV 27:6" /><verse number="7" style="v" pubnumber="7" sid="LEV 27:7" />وللذَّكَرِ مِنْ اَبنِ ستّينِ فصاعِدًا خَمسةَ عشَرَ مِثقالًا، وللأُنثى عشَرَةَ مثاقيلَ. <verse eid="LEV 27:7" /><verse number="8" style="v" pubnumber="8" sid="LEV 27:8" />فإنْ كانَ النَّاذِرُ يفتقِرُ إلى القيمةِ المَطلوبةِ يُوقَفُ المَنذورُ أمامَ الكاهنِ، فيقَوِّمُهُ الكاهِنُ على حسَبِ ما تَملِكُهُ يدُ النَّاذِرِ.<verse eid="LEV 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="LEV 27:9" />”وإنْ كانَ النَّذْرُ مِنَ البَهائمِ، مِمَّا يُقرَّبُ للرّبِّ قربانًا، فأيَّةُ بهيمةٍ تُعطَى للرّبِّ تكونُ مُقدَّسةً لهُ. <verse eid="LEV 27:9" /><verse number="10" style="v" pubnumber="10" sid="LEV 27:10" />لا يُبدِّلُها ولا يُغيِّرُها، لا جيّدًا برديءٍ ولا رديئًا بجيِّدٍ. فإنْ أبدلَها ببَهيمةٍ تكونُ هيَ والبديلُ مُقدَّستَينِ للرّبِّ. <verse eid="LEV 27:10" /><verse number="11" style="v" pubnumber="11" sid="LEV 27:11" />وإنْ كانت بَهيمةً نَجِسةً، مِمَّا لا يُقَرَّبُ للرّبِّ قُربانًا، فليوقِفِ النَّاذِرُ البَهيمةَ أمامَ الكاهنِ، <verse eid="LEV 27:11" /><verse number="12" style="v" pubnumber="12" sid="LEV 27:12" />فيقوِّمَها الكاهنُ على حسَبِ جُودَتِها أو رَداءَتِها، وكما يُقوِّمُها الكاهنُ تكونُ. <verse eid="LEV 27:12" /><verse number="13" style="v" pubnumber="13" sid="LEV 27:13" />وإنْ أرادَ النَّاذِرُ أنْ يفُكَّها، فَليَزِدْ على تَقويمِ الكاهنِ خُمْسَهُ.<verse eid="LEV 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="LEV 27:14" />”وإنْ كرَّسَ أحدٌ بَيتَهُ للرّبِّ، فيُقوِّمُهُ الكاهنُ على حسَبِ جُودتِه أو رداءَتِهِ، وكما يُقوِّمُهُ الكاهنُ يكونُ. <verse eid="LEV 27:14" /><verse number="15" style="v" pubnumber="15" sid="LEV 27:15" />فإنْ أرادَ الّذي كرَّسَهُ أنْ يفكَّهُ يزيدُ على تَقويمِ الكاهنِ خُمْسَهُ ويكونُ لهُ.<verse eid="LEV 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="LEV 27:16" />”وإنْ كرَّسَ أحدٌ للرّبِّ شيئًا مِنْ حقلٍ يَملُكُهُ، فتكونُ قيمتُهُ على قَدْرِ البِذارِ الّتي تُبذَرُ فيهِ، كُلُّ عِشرينَ كَيلًا مِنَ الشَّعيرِ بخَمسينَ مثقالِ فِضَّةٍ. <verse eid="LEV 27:16" /><verse number="17" style="v" pubnumber="17" sid="LEV 27:17" />فإنْ كرَّسَ حقلَهُ مِنْ سنَةِ اليُوبيلِ، فكما يُقوِّمُه الكاهنُ تكونُ قِيمتُهُ. <verse eid="LEV 27:17" /><verse number="18" style="v" pubnumber="18" sid="LEV 27:18" />وإنْ كُرِّسَ بَعدَ سنَةِ اليُوبيلِ، فيُقوِّمُهُ الكاهنُ معَ التَّخفيضِ على قَدْرِ السِّنينَ الباقيةِ إلى سنَةِ اليُوبيلِ الآتي. <verse eid="LEV 27:18" /><verse number="19" style="v" pubnumber="19" sid="LEV 27:19" />وإنْ أرادَ الّذي كرَّسَهُ للرّبِّ أنْ يَفُكَّ الحقلَ، يَزِدْ على تَقويمِ الكاهنِ خُمْسَه ويكونُ لهُ. <verse eid="LEV 27:19" /><verse number="20" style="v" pubnumber="20" sid="LEV 27:20" />وإنْ كانَ لا يَفكُّهُ، فباعَهُ الكاهنُ لرَجُلٍ آخَرَ، فلا يُفَكُّ بَعدُ، <verse eid="LEV 27:20" /><verse number="21" style="v" pubnumber="21" sid="LEV 27:21" />ويكونُ الحقلُ عِندَ خُروجهِ مِنْ يَدِ المالكِ مُكرَّسًا للرّبِّ كالحقلِ الحَرامِ، ويَصيرُ مُلْكًا للكاهنِ.<verse eid="LEV 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="LEV 27:22" />”وإنْ كرَّسَ أحدٌ للرّبِّ حقلًا اَشتراهُ ولم يَكُنْ مِنْ أملاكِهِ المَوروثةِ، <verse eid="LEV 27:22" /><verse number="23" style="v" pubnumber="23" sid="LEV 27:23" />فليحْسبِ الكاهنُ لَه مِقدارَ القيمةِ على قَدْرِ السِّنينَ الباقيةِ إلى سنَةِ اليُوبيل الآتي، فيَدفعُها الرَّجُلُ في ذلِكَ اليومِ عَنْ مُلْكٍ كرَّسَهُ للرّبِّ. <verse eid="LEV 27:23" /><verse number="24" style="v" pubnumber="24" sid="LEV 27:24" />وفي سنَةِ اليُوبيلِ يَرجِعُ الحقلُ إلى بائِعِهِ كمُلْكٍ مَوروثٍ لهُ.<verse eid="LEV 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="LEV 27:25" />”كُلُّ تَقويمٍ يُجريهِ الكاهنُ يكونُ بالسِّعرِ الرَّسميِّ، أي كُلُّ مِثقالٍ عِشرونَ دِرْهمًا.<verse eid="LEV 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="LEV 27:26" />”لا يجوزُ لأحدٍ أنْ يُكرِّسَ للرّبِّ أبكارَ البَهائمِ، سَواءٌ مِنَ البقَرِ أو مِنَ الغنَمِ، فهيَ مُخصَّصةٌ للرّبِّ. <verse eid="LEV 27:26" /><verse number="27" style="v" pubnumber="27" sid="LEV 27:27" />وإنْ كانَ بِكْرُ البَهيمةِ نَجِسًا، يُفدَى على حسَبِ تَقويمِ الكاهنِ بزيادةِ خُمْسِهِ، وإلَّا يبيعُهُ الكاهنُ على حسَبِ تَقويمِهِ. <verse eid="LEV 27:27" /><verse number="28" style="v" pubnumber="28" sid="LEV 27:28" />وكُلُّ ما يُحرِّمُهُ الإنسانُ للرّبِّ مِنْ جميعِ ما لَهُ مِنْ بَشرٍ أو بَهيمةٍ أو أرضٍ يَرثُها، فلا يُباعُ ولا يُفَكُّ لأنَّهُ قربانٌ مُقدَّسٌ كُلَّ التَّقديسِ للرّبِّ. <verse eid="LEV 27:28" /><verse number="29" style="v" pubnumber="29" sid="LEV 27:29" />حتّى الإنسانُ المُكَرَّسُ للرّبِّ لا يُفدَى، بل يُقتَلُ قَتلًا.<verse eid="LEV 27:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="LEV 27:30" />”عُشْرُ محاصيلِ الأرضِ كُلِّها مِنَ الحَبِّ ومِنْ ثَمَرِ الشَّجَرِ يكونُ للرّبِّ. <verse eid="LEV 27:30" /><verse number="31" style="v" pubnumber="31" sid="LEV 27:31" />وإنْ فَكَّ أحدٌ شيئًا مِنْ عُشْرِهِ، فليَزِدْ علَيهِ خُمسَهُ.<verse eid="LEV 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" pubnumber="32" sid="LEV 27:32" />”وأمَّا البقَرُ والغنَمُ، فالعاشِرُ مِنْ كُلِّ ما يَمرُّ مِنها تَحتَ عصا الرَّاعي يكونُ للرّبِّ <verse eid="LEV 27:32" /><verse number="33" style="v" pubnumber="33" sid="LEV 27:33" />جيّدًا كانَ أم رديئًا. لا يُفحَصُ ولا يُبدَلُ. فإنْ أُبدِلَ يكونُ هوَ وبديلُهُ مُقدَّسًا للرّبِّ لا يُفَكُّ“.<verse eid="LEV 27:33" /></para>
  <para style="p">
    <verse number="34" style="v" pubnumber="34" sid="LEV 27:34" />هذِهِ هيَ الوصايا الّتي أمرَ الرّبُّ بها موسى لبَني إِسرائيلَ في جبَلِ سيناءَ.<verse eid="LEV 27:34" /></para>
  <chapter eid="LEV 27" />
</usx>