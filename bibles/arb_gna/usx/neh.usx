  <para style="toc3">نح</para>
  <para style="toc1">نحميا</para>
  <para style="toc2">نحميا</para>
  <para style="mt1">نحميا</para>
  <chapter number="1" style="c" sid="NEH 1" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="NEH 1:1" />روَى نَحَمْيا بنُ حَكليا، قالَ: في شهرِ كَسْلو في السَّنةِ العشرينَ لأرتَحْشَشْتا المَلِكِ، كُنتُ في قَصرِ شُوشنَ العاصمَةِ. <verse eid="NEH 1:1" /><verse number="2" style="v" pubnumber="2" sid="NEH 1:2" />فجاءَ حناني أحدُ إخوتي معَ رجالٍ مِنْ يَهوذا، فاَستَخْبرتُهم عنْ أورُشليمَ وعنِ الّذينَ نَجَوا مِنَ اليهودِ المسبيِّينَ الباقينَ في بابِلَ. <verse eid="NEH 1:2" /><verse number="3" style="v" pubnumber="3" sid="NEH 1:3" />فقالوا لي: ”الباقونَ مِنهم هناكَ في البلادِ هُم في هَوانٍ وضيقٍ شديدٍ، وسورُ أورُشليمَ مهدومٌ وأبوابُها أُحرِقتْ بالنَّارِ“.<verse eid="NEH 1:3" /></para>
  <para style="s1">صلاة نحميا</para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="NEH 1:4" />فلمَّا سَمِعتُ هذا الكلامَ قعَدتُ أبكي وأنوحُ أيّامًا، وصُمْتُ وصَلَّيتُ أمامَ إلهِ السَّماواتِ، <verse eid="NEH 1:4" /><verse number="5" style="v" pubnumber="5" sid="NEH 1:5" />وقلتُ: ”أيُّها الرّبُّ إلهَ السَّماواتِ الجبَّارُ العظيمُ الرَّهيبُ الّذي تحفظُ العهدَ وترحَمُ مُحبِّيكَ والعاملينَ بوصاياكَ، <verse eid="NEH 1:5" /><verse number="6" style="v" pubnumber="6" sid="NEH 1:6" />أُنظرْ إليَّ واَسمعْ صلاةَ عَبدِكَ الّتي أُصلِّيها اليومَ أمامَكَ، نهارًا وليلًا، عن بَني إِسرائيلَ عَبيدِكَ، مُعترِفًا بخطاياهُمُ الّتي خَطِئوا بها إليكَ كما خَطِئتُ أنا وبيتُ أبي. <verse eid="NEH 1:6" /><verse number="7" style="v" pubnumber="7" sid="NEH 1:7" />أسَأْنا إليكَ وما عَمِلْنا بوصاياكَ وفرائضِكَ وأحكامِكَ الّتي أمرتَ بها موسى عَبدَكَ. <verse eid="NEH 1:7" /><verse number="8" style="v" pubnumber="8" sid="NEH 1:8" />أُذكرْ قولَكَ لَه: إنْ نقضتُم عهدي فسأُشتِّتُكُم بينَ الأممِ، <verse eid="NEH 1:8" /><verse number="9" style="v" pubnumber="9" sid="NEH 1:9" />وإنْ رجَعتُم إليَّ وحَفِظتُم وصايايَ وعَمِلتُم بِها فسأجمعُكُم، ولو نُفيتُم إلى أقاصي الأرضِ، وأردُّكُم إلى المكانِ الّذي اَخترتُه ليقيمَ اَسمي فيه. <verse eid="NEH 1:9" /><verse number="10" style="v" pubnumber="10" sid="NEH 1:10" />فهؤلاءِ شَعبُكَ وعِبادُكَ الّذينَ اَفتديتَهُم بقدرَتِكَ العظيمةِ ويدِكَ القويَّةِ. <verse eid="NEH 1:10" /><verse number="11" style="v" pubnumber="11" sid="NEH 1:11" />فاَسمعْ يا ربُّ صلاتي وصلواتِ عِبادِكَ الّذينَ يَخافونَ اَسمَكَ، ووفِّقني اليومَ لأجِدَ رحمَةً عِندَ المَلِكِ“.</para>
  <para style="p" vid="NEH 1:11">وكنتُ في تِلكَ الأيّامِ ساقيَ المَلكِ.<verse eid="NEH 1:11" /></para>
  <chapter eid="NEH 1" />
  <chapter number="2" style="c" sid="NEH 2" />
  <para style="s1">نحميا في أورشليم</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="NEH 2:1" />وفي شهرِ نيسانَ، في السَّنةِ العشرينَ لأرتَحْشَشْتا المَلكِ، كانَ أمامَه على المائدةِ بين يَديهِ خمرٌ. فأخذتُ الخَمرَ وناوَلْتُ المَلِكَ ولم أكُنْ مِنْ قَبلُ كئيبًا بِحَضرتِهِ. <verse eid="NEH 2:1" /><verse number="2" style="v" pubnumber="2" sid="NEH 2:2" />فقالَ ليَ المَلكُ: ”ما بالُ وَجهِكَ مُكتئِبًا؟ لا أرى أنَّكَ مَريضٌ، فهل هذا كآبةُ قلبٍ؟“ فخِفْتُ خَوفًا شديدًا <verse eid="NEH 2:2" /><verse number="3" style="v" pubnumber="3" sid="NEH 2:3" />وقُلتُ لِلمَلكِ: ”يحيا المَلِكُ إلى الأبدِ. كيفَ لا يكونُ وَجهي مُكتئِبًا والمدينةُ الّتي هيَ موضِعُ مقابرِ آبائي حلَّ بها الخرابُ وأُحرِقت أبوابُها بالنَّارِ؟“ <verse eid="NEH 2:3" /><verse number="4" style="v" pubnumber="4" sid="NEH 2:4" />قالَ المَلِكُ: ”فما طَلبُكَ؟“ فصلَّيتُ إلى إلهِ السَّماءِ <verse eid="NEH 2:4" /><verse number="5" style="v" pubnumber="5" sid="NEH 2:5" />ثُمَّ قلتُ للمَلِكِ: ”إنْ حَسُنَ عِندَكَ أيُّها المَلِكُ، ورضيتَ عليَّ أنا عبدُكَ، تُرسلُني إلى يَهوذا، إلى مَدينةِ مقابرِ آبائي، لِأُعيدَ بِناءَها“. <verse eid="NEH 2:5" /><verse number="6" style="v" pubnumber="6" sid="NEH 2:6" />وحَسُنَ عِندَ المَلِكِ أنْ يُرسِلَني فقالَ لي، والمَلِكةُ جالسةٌ عِندَهُ: ”إلى متى يكونُ سفرُكَ ومتى تعودُ؟“ فعيَّنتُ لَه مَوعِدًا. <verse eid="NEH 2:6" /><verse number="7" style="v" pubnumber="7" sid="NEH 2:7" />وقلتُ للملِكِ: إنْ حَسُنَ عندَكَ فأعطني رَسائِلَ إلى الوُلاةِ في غربيّ الفُراتِ ليأذنوا لي بالعُبورِ إلى يَهوذا، <verse eid="NEH 2:7" /><verse number="8" style="v" pubnumber="8" sid="NEH 2:8" />وأعطني رِسالةً إلى آسافَ حارسِ غابةِ المَلِكِ أنْ يُزوِّدَني بخشبٍ لأبوابِ قَصرِ بَيتِ اللهِ وأسوارِ المدينةِ والبيتِ الّذي أُقيمُ“. فأعطاني المَلِكُ طَلَبي، لأنَّ بركةَ إلهي الصَّالحةَ كانت عليَّ.<verse eid="NEH 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="NEH 2:9" />فتوجَّهتُ إلى الوُلاةِ في غربيّ الفُراتِ وسلَّمتُهم رَسائِلَ المَلِكِ، وكانَ المَلِكُ أرسلَ معي قادةَ جيشٍ وفُرسانًا. <verse eid="NEH 2:9" /><verse number="10" style="v" pubnumber="10" sid="NEH 2:10" />فلمَّا سمِعَ سَنْبلَّطُ الحُوروني وطوبيَّا العَبدُ العمُّوني ساءَهما جدًّا مَجيءُ رجلٍ يطلبُ لبَني إِسرائيلَ خيرًا. <verse eid="NEH 2:10" /><verse number="11" style="v" pubnumber="11" sid="NEH 2:11" />فوصلتُ إلى أورُشليمَ وأقمتُ هناكَ ثَلاثةَ أيّامٍ، <verse eid="NEH 2:11" /><verse number="12" style="v" pubnumber="12" sid="NEH 2:12" />ثُمَّ قمتُ ليلًا ومعي نَفرٌ قليلونَ، ولم أُخبِرْ بما ألهمني إلهي أنْ أفعلَه في أورُشليمَ. ولم يكُنْ معي دابَّةٌ إلَّا الدَّابَّةُ الّتي كنتُ راكِبَها. <verse eid="NEH 2:12" /><verse number="13" style="v" pubnumber="13" sid="NEH 2:13" />وخرجتُ ليلًا مِنْ بابِ الوادي الّذي أمامَ عينِ التِنِّينِ إلى بابِ الزِّبلِ، وأخذتُ أتأمَّلُ أسوارَ أورُشليمَ المُتهدِّمةَ وأبوابَها المُحترقةَ بالنَّارِ. <verse eid="NEH 2:13" /><verse number="14" style="v" pubnumber="14" sid="NEH 2:14" />ثُم عبرْتُ إلى بابِ العَينِ وإلى بِرْكةِ المَلِكِ، ولم يكُنْ للدَّابَّةِ الّتي تحتي مَوضِعٌ للعُبورِ. <verse eid="NEH 2:14" /><verse number="15" style="v" pubnumber="15" sid="NEH 2:15" />ثُمَّ صَعِدتُ في الوادي ليلًا، وأنا أتأمَّلُ السُّورَ، وعُدْتُ ودَخَلتُ مِن بابِ الوادي ورَجَعتُ. <verse eid="NEH 2:15" /><verse number="16" style="v" pubnumber="16" sid="NEH 2:16" />ولم يَعلمِ الوُلاةُ إلى أينَ ذهبتُ، ولا ما أنا فاعِلٌ، ولا كنتُ بعدُ أعلمتُ بِنَوايايَ اليهودَ والكهنةَ والرُّؤساءَ ووُلاةَ الأمرِ وسائِرَ مَنْ باشروا العملَ. <verse eid="NEH 2:16" /><verse number="17" style="v" pubnumber="17" sid="NEH 2:17" />فقلتُ لَهم: ”أنتم تَرونَ ما نحنُ فيه مِنْ سُوءِ الحالِ، كيفَ خَرِبت أورُشليمُ واَحتَرقت أبوابُها بالنَّارِ، فقوموا لِنبنيَ سُورَ أورُشليمَ ونضعَ حَدًّا للعارِ الّذي لَحِقَ بِنا“. <verse eid="NEH 2:17" /><verse number="18" style="v" pubnumber="18" sid="NEH 2:18" />وأعلمتُهم ببركةِ إلهي الصَّالِحَةِ عليَّ، وأيضًا بِما قالهُ ليَ المَلِكُ، فقالوا: ”نقومُ ونبني“. وشَدَّدوا عَزائِمَهم لهذا العملِ الصَّالحِ.<verse eid="NEH 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="NEH 2:19" />فلمَّا سَمِعَ سَنْبلَّطُ الحُوروني وطوبيَّا العبدُ العمُّونيُ وجشمُ العربيُّ سَخِروا منَّا واَستهزأوا بِنا وقالوا: ”ماذا تعملونَ؟ أتتمرَّدونَ على المَلِكِ؟“ <verse eid="NEH 2:19" /><verse number="20" style="v" pubnumber="20" sid="NEH 2:20" />فقلتُ لَهم: ”سننجحُ بِعونِ إلهِ السَّماواتِ، نحنُ عبيدُه وسنقومُ ونبني، وأمَّا أنتم فلا حظَّ لكُم ولا حقَّ ولا شأنَ في أورُشليمَ“.<verse eid="NEH 2:20" /></para>
  <chapter eid="NEH 2" />
  <chapter number="3" style="c" sid="NEH 3" />
  <para style="s1">بناء سور أورشليم</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="NEH 3:1" />فقامَ ألياشِيبُ الكاهنُ العظيمُ معَ زُملائِهِ الكهنَةِ وبَنَوا بابَ الغنَمِ وكرَّسوهُ للرّبِّ وصنعوا مِصْراعيهِ، ورمَّموا السُّور إلى بُرجِ المئَةِ وبُرجِ حَننئيلَ وكرَّسوهُ للرّبِّ. <verse eid="NEH 3:1" /><verse number="2" style="v" pubnumber="2" sid="NEH 3:2" />وبِجانبِهِم بَنى رجالُ أريحا، وبجانِبهِم الآخرِ بَنى زكُّورُ بنُ أمري. <verse eid="NEH 3:2" /><verse number="3" style="v" pubnumber="3" sid="NEH 3:3" />وبَنى بابَ السَّمكِ بَنو هَسناءَةَ، فسقفوهُ وأقاموا مِصْراعيهِ وأقفالَه ومغاليقَه، <verse eid="NEH 3:3" /><verse number="4" style="v" pubnumber="4" sid="NEH 3:4" />وبجانِبهِم رمَّمَ مريموثُ بنُ أوريّا بنُ هَقُّوصَ، وبجانبهِ رمَّمَ مشلامُ بنُ برَخْيا بنِ مَشيزَبئيلَ، وبجانِبِهِ رمَّمَ صادوقُ بنُ بَعْنا. <verse eid="NEH 3:4" /><verse number="5" style="v" pubnumber="5" sid="NEH 3:5" />وبجانِبِهِ رمَّمَ التَّقوعيُّونَ، إلَّا أنَّ زُعماءَهم رفضوا أنْ يخضعوا في هذا العملِ لأوامرِ القائمينَ بهِ. <verse eid="NEH 3:5" /><verse number="6" style="v" pubnumber="6" sid="NEH 3:6" />والبابُ العتيقُ رمَّمَه يُوياداعُ بنُ فاسيحَ ومِشلامُ بنُ بَسُوديا، فَسَقَفاهُ، وأقاما مِصْراعيهِ وأقفالَه ومغاليقَه، <verse eid="NEH 3:6" /><verse number="7" style="v" pubnumber="7" sid="NEH 3:7" />وبجانبهِما رمَّمَ مَلَطْيا الجَبعونيُّ ويادونُ الميرونوتي، معَ أهلِ جَبعونَ والمِصفاةِ، القِسمَ المُمتَدَّ إلى مَقرِّ والي غربيِّ الفُراتِ، <verse eid="NEH 3:7" /><verse number="8" style="v" pubnumber="8" sid="NEH 3:8" />وبِجانبهِما رمَّمَ عُزّيئيلُ بنُ حرَهايا الصَّائِغُ، وبجانبهِ رمَّمَ حننيا العطَّارُ، فَبَلغا ببناءِ أورُشليمَ إلى السُّورِ العَريضِ. <verse eid="NEH 3:8" /><verse number="9" style="v" pubnumber="9" sid="NEH 3:9" />وبجانبهِما رمَّمَ رفايا بنُ حورٍ، رئيسُ نِصفِ مِنطقةِ أورُشليمَ. <verse eid="NEH 3:9" /><verse number="10" style="v" pubnumber="10" sid="NEH 3:10" />وبجانبهِ رمَّمَ يدايا بنُ حرومافَ قُبالةَ بَيتهِ، وبجانبهِ رمَّمَ حطُّوشَ بنُ حَشَبْنيا. <verse eid="NEH 3:10" /><verse number="11" style="v" pubnumber="11" sid="NEH 3:11" />ورمَّمَ مَلْكيَّا بنُ حاريمَ وحشُّوبُ بنُ فحثَ موآبَ السَّاحةَ الثَّانيةَ وبُرجَ الأفرانِ. <verse eid="NEH 3:11" /><verse number="12" style="v" pubnumber="12" sid="NEH 3:12" />وبجانبهِما رمَّمَ شَلُّومُ بنُ هلُّوحيشَ، رئيسُ نِصفِ مِنطقةِ أورُشليمَ الأخرى، هو وبناتُه. <verse eid="NEH 3:12" /><verse number="13" style="v" pubnumber="13" sid="NEH 3:13" />وبابُ الوادي رمَّمه حانونُ وسكَّانُ زانوحَ وأقاموا مِصْراعيهِ وأقفالَه ومغاليقَه وبَنَوا ألفَ ذِراعٍ مِنَ السُّورِ إلى باب الزِّبْلِ. <verse eid="NEH 3:13" /><verse number="14" style="v" pubnumber="14" sid="NEH 3:14" />أمَّا بابُ الزِّبْلِ، فرمَّمَه مَلْكيَّا بنُ ريكابَ، رئيسُ مِنطقةِ بيتِ الكَرم، فأقامَ مِصْراعيهِ وأقفالَه ومغاليقَه. <verse eid="NEH 3:14" /><verse number="15" style="v" pubnumber="15" sid="NEH 3:15" />وبابُ العينِ رمَّمَه شلُّونُ بنُ كلحوزةَ، رئيسُ مِنطقةِ المِصفاةِ فسقفَه وأقامَ مِصْراعيهِ وأقفالَه ومغاليقَه، وبَنى حائِطَ بِرْكةِ سِلوامَ عِندَ جُنينةِ المَلِكِ إلى الدَّرجِ النَّازلِ مِنْ مدينةِ داودَ. <verse eid="NEH 3:15" /><verse number="16" style="v" pubnumber="16" sid="NEH 3:16" />ووراءَه رمَّمَ نَحَمْيا بنُ عَزبوقَ، رئيسُ نِصفِ مِنطقةِ بيتِ صُورَ إلى قُبالةِ مقابرِ داودَ والبِرْكةَ المُصطنعةِ وبيتِ الحَرسِ المَلَكي. <verse eid="NEH 3:16" /><verse number="17" style="v" pubnumber="17" sid="NEH 3:17" />ووراءَه رمَّمَ اللَّاويُّونَ وهُم: رَحومُ بنُ باني، وبجانبهِ رمَّمَ حَشَبْيا، رئيسُ نِصفِ مِنطقةِ قَعيلةَ، باَسمِ مِنطقتهِ، <verse eid="NEH 3:17" /><verse number="18" style="v" pubnumber="18" sid="NEH 3:18" />ووراءَه رمَّمَ بوَّايُ بنُ حينادادَ رئيسُ نِصفِ مِنطقةِ قَعيلةَ الأخرى، <verse eid="NEH 3:18" /><verse number="19" style="v" pubnumber="19" sid="NEH 3:19" />وبجانِبه رمَّمَ عازرُ بنُ يشوعَ، رئيسُ المِصفاةِ، مسافةً أخرى قُبالةَ مَطلعِ بيتِ السِّلاح عِندَ المُنعطفِ. <verse eid="NEH 3:19" /><verse number="20" style="v" pubnumber="20" sid="NEH 3:20" />ووراءهُ شدَّدَ باروكُ بنُ زبَّايَ عَزيمتَهُ ورمَّمَ مَسافةً أخرى مِنْ عِندِ المُنعطَفِ إلى بابِ بيتِ ألياشيبَ الكاهنِ العظيمِ، <verse eid="NEH 3:20" /><verse number="21" style="v" pubnumber="21" sid="NEH 3:21" />ووراءَه رمَّمَ مريموثُ بنُ أُوريَّا بنُ هقُّوصَ مسافةً أخرى مِنْ عِندِ بيتِ ألياشيبَ إلى آخرِ البيتِ، <verse eid="NEH 3:21" /><verse number="22" style="v" pubnumber="22" sid="NEH 3:22" />ووراءَه رمَّمَ الكهنةُ مِنْ أهلِ الغَورِ، <verse eid="NEH 3:22" /><verse number="23" style="v" pubnumber="23" sid="NEH 3:23" />ووراءَهُم رمَّمَ بنيامينُ وحشُّوبُ قُبالَة بيتهِما، ووراءَهُما رمَّمَ عزَرْيا بنُ مَعْسيا بنُ عَنَنْيا عِندَ بيتهِ، <verse eid="NEH 3:23" /><verse number="24" style="v" pubnumber="24" sid="NEH 3:24" />ووراءَه رمَّمَ بنُّويُ بنُ حينادادَ مَسافةً أخرى مِنْ بيتِ عزَرْيا إلى المُنعطَفِ وإلى الزَّاويةِ، <verse eid="NEH 3:24" /><verse number="25" style="v" pubnumber="25" sid="NEH 3:25" />وفالالُ بنُ أوزايَ رمَّمَ مِنْ قُبالةِ المُنعطَفِ وبُرجِ الطَّبقَةِ العُليا مِنْ قصرِ المَلكِ الّذي عِندَ ساحةِ السِّجنِ. ووراءَه فَدايا بنُ فَرعوشَ <verse eid="NEH 3:25" /><verse number="26" style="v" pubnumber="26" sid="NEH 3:26" />وخُدَّامُ بيتِ اللهِ المُقيمونَ بعَوفلَ رمَّموا إلى قُبالةِ بابِ الماءِ نَحو الشَّرقِ والبُرجِ البارزِ إلى الخارجِ. <verse eid="NEH 3:26" /><verse number="27" style="v" pubnumber="27" sid="NEH 3:27" />ووراءَهُم رمَّمَ التَّقوعيُّونَ مُقابِلَ البُرجِ العظيمِ البارزِ إلى الخارجِ مَسافةً أخرى إلى سُورِ عَوفلَ.<verse eid="NEH 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="NEH 3:28" />ومِنْ فوقِ بابِ الخَيلِ رمَّمَ كُلُّ واحدٍ مِنَ الكهنةِ قُبالةَ بَيتهِ، <verse eid="NEH 3:28" /><verse number="29" style="v" pubnumber="29" sid="NEH 3:29" />ووراءَهُم رمَّمَ صادوقُ بنُ إِمِّيرَ قُبالةَ بَيتهِ، ووراءَه رمَّمَ شَمَعْيا بنُ شَكَنْيا حارسُ بابِ الشَّرقِ. <verse eid="NEH 3:29" /><verse number="30" style="v" pubnumber="30" sid="NEH 3:30" />ووراءَه رمَّمَ حَنَنْيا بنُ شَلَمْيا وحانونُ الإبنُ السَّادسُ لصالافَ مَسافةً أخرى مِنَ السُّورِ. ووراءَهُما رمَّمَ مَشُلامُ بنُ بَرَكْيا قُبالةَ غُرفتهِ. <verse eid="NEH 3:30" /><verse number="31" style="v" pubnumber="31" sid="NEH 3:31" />ووراءَهُ رمَّمَ مَلْكِيَّا الصَّائغُ إلى دارِ خُدَّامِ بيتِ اللهِ وبيتِ التُّجَّارِ، قُبالةَ بابِ الحِراسةِ والعِليَّة الّتي عِندَ الزَّاويةِ. <verse eid="NEH 3:31" /><verse number="32" style="v" pubnumber="32" sid="NEH 3:32" />وما بينَ هذِهِ العِليَّةِ وبابِ الغنَمَ رمَّمَه الصَّاغةُ والتُّجَّارُ.<verse eid="NEH 3:32" /></para>
  <para style="s1">معارضة بناء السور</para>
  <para style="p">
    <verse number="33" style="v" pubnumber="33" sid="NEH 3:33" />ولمَّا سَمعَ سَنْبلَّطُ أنّنا نَبني السُّورَ غَضِبَ واَغتاظَ غَيظًا شديدًا، وسَخِرَ مِنَ اليهودِ <verse eid="NEH 3:33" /><verse number="34" style="v" pubnumber="34" sid="NEH 3:34" />وقالَ على مَسمعِ بَني قوَمِه وجيشِ السَّامرةِ: ”ماذا يَعملُ هؤلاءِ اليهودُ الضُعفاءُ؟ هل يُعيدونَ بناءَ المدينةِ؟ هل يظنُّونَ أنَّهم بتقريبِ الذَّبائحِ يُتِمُّونَ العملَ في يومٍ واحدٍ؟ هل يُعيدونَ الحياةَ إلى الحِجارةِ مِنْ كُوَمِ التُّرابِ وهيَ محروقةٌ؟“ <verse eid="NEH 3:34" /><verse number="35" style="v" pubnumber="35" sid="NEH 3:35" />وكانَ طُوبيَّا العمُّونيُّ بجانبهِ فقالَ: ”بل إنَّ ما يَبنونَه سُورٌ، لو قفزَ علَيهِ ثعلبٌ لَهدمَ حِجارتَه“. <verse eid="NEH 3:35" /><verse number="36" style="v" pubnumber="36" sid="NEH 3:36" />فصلَّيتُ وقلتُ: ”إسمعْ يا إلهَنا كيفَ أصبحنا هُزأةً، فرُدَّ تَعييرَهُم على رؤوسهِم واَجعلْهُم غَنيمةً في أرضِ السَّبي، <verse eid="NEH 3:36" /><verse number="37" style="v" pubnumber="37" sid="NEH 3:37" />ولا تسترْ ذنوبَهم، ولا تَمحُ خطيئتَهم مِنْ أمامِكَ، لأنَّهم اَستهزأوا بنا نحن البنَّاؤونَ“. <verse eid="NEH 3:37" /><verse number="38" style="v" pubnumber="38" sid="NEH 3:38" />ولكننا ثابرنا على بناءِ السُّورِ، فاَتصلَ كلُّه واَرتفعَ إلى نِصفِه لأنَّ الشعبَ كانَ مُتحمِّسًا لِلعملِ.<verse eid="NEH 3:38" /></para>
  <chapter eid="NEH 3" />
  <chapter number="4" style="c" sid="NEH 4" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="NEH 4:1" />ولمَّا سَمِعَ سَنْبلَّطُ وطوبيَّا والعَربُ والعمُّونيُّونَ والأشدوديُّونَ بأنَّ سُورَ أورُشليمَ رُمِّمَ، لأنَّ الفجواتِ فيهِ أخذت تُسَدُّ، غضبوا جدًّا <verse eid="NEH 4:1" /><verse number="2" style="v" pubnumber="2" sid="NEH 4:2" />وتحالفوا كلُّهم يدًا واحدةً على أن يأتوا ويحاربوا أورُشليمَ ويُوقعوا فيها الفوضى. <verse eid="NEH 4:2" /><verse number="3" style="v" pubnumber="3" sid="NEH 4:3" />فصلَّينا إلى إلهنا وأقمْنا في وَجهِهم حُرَّاسًا، نهارًا وليلًا حَذَرًا مِنهُم.<verse eid="NEH 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="NEH 4:4" />وقالَ رجالُ يَهوذا: ”ضَعُفت قوَّةُ الحمَّالينَ، والتُّرابُ كثيرٌ، ونحن لا نقدِرُ أنْ نبنيَ السُّورَ“. <verse eid="NEH 4:4" /><verse number="5" style="v" pubnumber="5" sid="NEH 4:5" />وقالَ أعداؤُنا: ”نُباغِتُهم مِنْ حيثُ لا يعلمونَ ولا يرونَ وندخلُ إلى وَسْطِهم، فنقاتلُهُم ونُعطِّلُ العملَ“. <verse eid="NEH 4:5" /><verse number="6" style="v" pubnumber="6" sid="NEH 4:6" />فجاءَ اليهودُ المقيمونَ بِجوارِ أعدائِنا في جميعِ الأماكنِ الّتي رَجِعوا منها إلينا وأنذرونا عَشَراتِ المرَّاتِ. <verse eid="NEH 4:6" /><verse number="7" style="v" pubnumber="7" sid="NEH 4:7" />فسلَّحتُ الشعبَ بالسُّيوفِ والرِّماحِ والقِسيِّ وأقمتُهم على حسابِ عَشائِرهِم وراءَ السُّورِ، في المواضعِ الّتي لم يَكنْ تمَّ بناؤُها. <verse eid="NEH 4:7" /><verse number="8" style="v" pubnumber="8" sid="NEH 4:8" />ورأيتُهم خائفينَ، فقلتُ لهُم ولِرؤسائِهم ووُلاةِ أمرِهِم: ”لا تخافوا هؤلاءِ الأعداءَ. اَذكروا الرّبَّ العظيمَ الرَّهيبَ، وقاتلوا عن إخوانِكم وبنيكم وبناتِكم ونسائِكم وبيوتِكم“.<verse eid="NEH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="NEH 4:9" />ولمَّا سَمِعَ أعداؤُنا بأننا عَلِمنا بما يَنوونَ، وأنَّ اللهَ أبطلَ نيَّتَهم، فارقونا فرجِعنا كلُّنا إلى عملِنا في بِناءِ السُّورِ. <verse eid="NEH 4:9" /><verse number="10" style="v" pubnumber="10" sid="NEH 4:10" />ومِنْ ذلِكَ اليومِ كانَ النِّصفُ مِنْ رجالي يَعملونَ العملَ، والنِّصفُ الآخرُ مُسَلَّحينَ بالرِّماحِ والتُّروسِ والقِسيِّ والدُّروعِ، وكانَ جميعُ أعيانِ بيتِ يَهوذا يُساندونَ <verse eid="NEH 4:10" /><verse number="11" style="v" pubnumber="11" sid="NEH 4:11" />الّذينَ كانوا يَبنونَ في السُّورِ. وكانَ البُناةُ في السُّورِ وحاملو الأثقالِ والمحمِّلونَ يعملونَ باليدِ الواحدةِ، ويُمسكونَ السِّلاحَ باليدِ الأخرى. <verse eid="NEH 4:11" /><verse number="12" style="v" pubnumber="12" sid="NEH 4:12" />وكانَ كُلُّ واحدٍ مِنَ البنَّائينَ يَبني وهوَ مُتقلِّدٌ سيفَه على جَنبهِ، وكانَ الهاتِفُ بالبوقِ بجانِبي. <verse eid="NEH 4:12" /><verse number="13" style="v" pubnumber="13" sid="NEH 4:13" />فقلتُ لهُم ولرؤسائِهِم ووُلاةِ أمرِهِم: ”العملُ ضخمٌ مُتَشعِّبٌ ونحنُ مُتفرِّقونَ على السُّورِ، مُتباعِدونَ بَعضُنا عن بعضٍ. <verse eid="NEH 4:13" /><verse number="14" style="v" pubnumber="14" sid="NEH 4:14" />فالمَوضِعُ الّذي تسمعونَ مِنه صوتَ البُوقِ، هناكَ تجتمعونَ إلينا. إلهُنا يُقاتلُ عنَّا“.<verse eid="NEH 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="NEH 4:15" />فكانَ نِصفُنا يقومُ بالعملِ، والنِّصفُ الآخرُ يحملونَ السِّلاحَ مِن طُلوعِ الفَجرِ إلى ظُهورِ النُّجومِ. <verse eid="NEH 4:15" /><verse number="16" style="v" pubnumber="16" sid="NEH 4:16" />وفي ذلِكَ الوقتِ قلتُ للقيِّمينَ على العملِ: ”لِيَبتْ كلُّ واحدٍ منكم معَ مُعاونيهِ في وسَطِ أورُشليمَ ليكونوا لنا في اللَّيلِ حرَسًا وفي النَّهارِ عُمَّالًا“. <verse eid="NEH 4:16" /><verse number="17" style="v" pubnumber="17" sid="NEH 4:17" />ولم أكُنْ أنا ولا إخواني ولا رجالي ولا الحَرَسُ الّذين ورائي نَنزِعُ ثيابَنا، وكانَ كلُّ واحدٍ مِنَّا يُبقي على سلاحِه بيدهِ.<verse eid="NEH 4:17" /></para>
  <chapter eid="NEH 4" />
  <chapter number="5" style="c" sid="NEH 5" />
  <para style="s1">شكوى الشعب من الظلم</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="NEH 5:1" />وتعالَت صَيحةُ الشَّكوى مِنَ العائِدينَ مِنَ السَّبْي، رِجالًا ونِساءً، على إخوانِهمِ اليَهودِ. <verse eid="NEH 5:1" /><verse number="2" style="v" pubnumber="2" sid="NEH 5:2" />فكانَ بَعضُهم يقولُ: ”نحن وبَنونا وبَناتُنا كثيرونَ، أنُقايضُهُم بالحِنطَةِ لنأكُلَ ونَعيشَ؟“ <verse eid="NEH 5:2" /><verse number="3" style="v" pubnumber="3" sid="NEH 5:3" />وبَعضُهم الآخرُ: ”أنَرْهَنُ حُقولَنا وكُرومَنا وبيوتنا لنأخُذَ حِنطةً في هذِهِ المَجاعةِ؟“ <verse eid="NEH 5:3" /><verse number="4" style="v" pubnumber="4" sid="NEH 5:4" />وقالَ آخرونَ: ”أنَقترِضْ مالًا على حُقولِنا وكرومِنا لنُوفيَ ضريبةَ المَلِكِ؟ <verse eid="NEH 5:4" /><verse number="5" style="v" pubnumber="5" sid="NEH 5:5" />أنبيعُ بنينا وبناتِنا للعبوديَّةِ ونحن وهؤلاءِ العائِدونَ مِنَ السَّبْي مِن نسلٍ واحدٍ وبَنونا كبَنيهم؟ بل ها بعضُ بناتِنا مُستَعبداتٌ وما بأيدينا شيءٌ، وحقولُنا وكرومُنا أصبحت لغيرِنا“.<verse eid="NEH 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="NEH 5:6" />فلمَّا سَمِعتُ صراخَهُم وكلامَهُم هذا غَضِبتُ جدًّا. <verse eid="NEH 5:6" /><verse number="7" style="v" pubnumber="7" sid="NEH 5:7" />فشاورتُ نَفسي ووبَّختُ رؤساءَهُم ووُلاةَ أمرهِم مِن إخوانِهِم اليهودِ وقلتُ لهُم: ”أنتم تأخذونَ الرِّبا مِن إخوتِكُم بَني قومِكُم“. ودَعَوتُ إلى إجتماعٍ عامٍ <verse eid="NEH 5:7" /><verse number="8" style="v" pubnumber="8" sid="NEH 5:8" />وقلتُ لهُم: ”نحنُ على قَدْرِ طاقتِنا اَفتَدَيْنا إخوانَنا اليَهودَ الّذينَ بيعُوا للأممِ. وها أنتُمُ الآنَ تَبيعونَ إخوانكُم للأمَمِ فنَعودُ ونَفْتَديهِمْ نحن“. فَسكتوا وما وجدوا جوابًا. <verse eid="NEH 5:8" /><verse number="9" style="v" pubnumber="9" sid="NEH 5:9" />وقلتُ: ”ما تعملونَه خطأٌ، فخافوا اللهَ إلهَنا حتّى تتفادوا تعييرَ الأممِ أعدائِنا؟ <verse eid="NEH 5:9" /><verse number="10" style="v" pubnumber="10" sid="NEH 5:10" />فأنا وإخواني ورجالي أقرَضْنا الشَّعبَ مالًا وحِنطةً، ولكنَّنا نَعفيهِم مِن هذا الدَّينِ. <verse eid="NEH 5:10" /><verse number="11" style="v" pubnumber="11" sid="NEH 5:11" />وأنتم أيضًا أعيدوا إليهم في هذا اليومِ حُقولَهم وكُرومَهم وزَيتونَهم وبيوتَهم، ولا تطالِبوهُم بالمالِ والحِنطةِ والخَمرِ والزَّيتِ“. <verse eid="NEH 5:11" /><verse number="12" style="v" pubnumber="12" sid="NEH 5:12" />فقالوا: ”نُعيدُها ولا نطلبُ مِنهم شيئًا، وكما تقولُ نعملُ“. ودَعَوتُ الكهَنةَ وحَلَّفْتُهم أنْ يَعملوا بِما أقولُ. <verse eid="NEH 5:12" /><verse number="13" style="v" pubnumber="13" sid="NEH 5:13" />فنفَّضتُ جَيبَ رِدائي وقلتُ: ”هكذا يَنفضُ اللهُ كلَّ مَنْ لا يُشارِكُ في هذا العملِ مِمَّا في بيتِهِ ومِن تَعَبِ يَدَيهِ، فيكونُ كجَيبِ ردائي هذا منفوضًا وفارِغًا“، فقالَتِ الجماعةُ كُلُّها: ”آمينَ“. وحَمَدَتِ الرّبَّ. وعمِلَ الشعبُ بِحسَبِ هذا الكلامِ.<verse eid="NEH 5:13" /></para>
  <para style="s1">نزاهة نحميا</para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="NEH 5:14" />وفوقَ ذلِكَ، فَمِن يومِ أمَرني المَلِكُ أنْ أكونَ واليًا في أرضِ يَهوذا، مِنَ السَّنةِ العِشرينَ إلى السَّنةِ الثانيةِ والثلاثينَ لأرتَحْشَشْتا المَلِكِ، أيّ مُدَّةَ إثنَتَي عَشْرَةَ سنَةً، لم آكلْ أنا ولا إخواني خُبزًا مِن تِلكَ الوظيفةِ. <verse eid="NEH 5:14" /><verse number="15" style="v" pubnumber="15" sid="NEH 5:15" />وأمَّا الوُلاةُ الأوَّلونَ الّذينَ كانوا قَبْلي، فثَقَّلُوا على الشعبِ وكانوا يأخذونَ منِهُم كلَّ يومٍ ما يَزيدُ على أربعينَ قِطعةً مِن الفِضَّةِ لِشراءِ الخُبزِ والخَمرِ. بل كانَ رِجالُهم أيضًا يَظلِمونَ الشَّعبَ. أمَّا أنا فما عَمِلْتُ مِثلَ ذلِكَ لأنِّي أخافُ اللهَ. <verse eid="NEH 5:15" /><verse number="16" style="v" pubnumber="16" sid="NEH 5:16" />وإنَّما صَرفتُ جُهْدي إلى بِناءِ هذا السُّورِ حتّى إنِّي ما اَقتنَيتُ حَقلًا. وكانَ جميعُ رِجالي مُجتمعينَ هناكَ للبِناءِ، <verse eid="NEH 5:16" /><verse number="17" style="v" pubnumber="17" sid="NEH 5:17" />وكانَ على مائدتي مِنَ اليهودِ والولاةِ مئَةٌ وخمسونَ رَجلًا، فضلًا عمَّن جاءَنا مِنَ الأُممِ الّذينَ حولَنا. <verse eid="NEH 5:17" /><verse number="18" style="v" pubnumber="18" sid="NEH 5:18" />وكُنتُ أُهَيِّئُ كلَّ يومٍ ثورًا وستَّةً مِنْ خِيارِ الغنَمِ، ما عدا الطَّيرَ، وفي كُلِّ عشرَةِ أيّامٍ خمرًا كثيرًا. ومعَ هذا كلِّه لم أطلُبْ أُجرةَ مَنصِبي كوَالٍ، لأنَّ الضَّرائِبَ كانَت عِبْئًا ثقيلًا على هؤلاءِ الشَّعبِ. <verse eid="NEH 5:18" /><verse number="19" style="v" pubnumber="19" sid="NEH 5:19" />فاَذكرْني يا إلهي بالخيرِ على جميعِ ما عمِلْتُه لأجلِهم.<verse eid="NEH 5:19" /></para>
  <chapter eid="NEH 5" />
  <chapter number="6" style="c" sid="NEH 6" />
  <para style="s1">التآمر على نحميا</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="NEH 6:1" />ولمَّا سَمِعَ سَنْبلَّطُ وطوبيَّا وجشمُ العربيُّ وسائرُ أعدائِنا بأنِّي بَنيتُ السُّورَ وما بقيت فيهِ فَجوةٌ، ما عدا المَصاريعَ في الأبوابِ، الّتي لم أكُنْ في ذلكَ الوقتِ أقَمْتُها بعدُ، <verse eid="NEH 6:1" /><verse number="2" style="v" pubnumber="2" sid="NEH 6:2" />أرسلَ إليَّ سَنْبلَّطُ وجشمُ يقولانِ: ”تعالَ نتلاقَ معًا في قُرى سَهْلِ أونو“، وكانا يُضمِرانِ ليَ السُّوءَ. <verse eid="NEH 6:2" /><verse number="3" style="v" pubnumber="3" sid="NEH 6:3" />فوجَّهْتُ إليهما رُسُلًا وقُلتُ لهُما: ”أنا أقومُ بِعملٍ كبيرٍ فلا أقدِرُ أنْ أنزِلَ إلى لقائِكُما لِئلَّا يَتعطَّلَ العملُ إذا تَركْتُه“. <verse eid="NEH 6:3" /><verse number="4" style="v" pubnumber="4" sid="NEH 6:4" />وأرسلا إليَّ بِمِثلِ هذِهِ الدَّعوةِ أربعَ مرَّاتٍ وكنتُ في كلِّ مرَّةٍ أُجيبُهُمُ الجوابَ ذاتَه. <verse eid="NEH 6:4" /><verse number="5" style="v" pubnumber="5" sid="NEH 6:5" />فأرسلَ إليَّ سَنْبلَّط مرَّةً خامِسةً معَ خادِمِهِ رسالةً مفتوحَةً في يدِهِ مكْتوبٌ فيها: <verse eid="NEH 6:5" /><verse number="6" style="v" pubnumber="6" sid="NEH 6:6" />”يُشاعُ في الأُممِ وجشمٌ يقولُ، إنَّكَ أنتَ واليهودُ تُضْمِرونَ التَّمرُّدَ على المَلِكِ، ولذلِكَ أنتَ تَبني السُّورَ وأنتَ تكونُ مَلِكًا علَيهِم. <verse eid="NEH 6:6" /><verse number="7" style="v" pubnumber="7" sid="NEH 6:7" />وأقمتَ أيضًا أنبياءَ ليتَنَبَّأوا لكَ في أورُشليمَ قائلينَ: أنتَ مَلِكُ يَهوذا. ولا بُدَّ مِنْ أنْ يَسمعَ المَلِكُ هذا الكلامَ، فتَعالَ الآنَ لنَتَشاوَرَ في الأمرِ معًا. <verse eid="NEH 6:7" /><verse number="8" style="v" pubnumber="8" sid="NEH 6:8" />فأرسَلْتُ إليهِ أقولُ: ”لا شيءَ مِمَّا تقولُه صَحيحٌ وإنَّما هوَ كلامٌ تَختلِقُه مِنْ قلبِكَ“. <verse eid="NEH 6:8" /><verse number="9" style="v" pubnumber="9" sid="NEH 6:9" />وكانوا جميعًا يُخَوِّفونَنا بِقولِهم: ”تَعِبَت أيدِيهِم مِنَ العملِ فلا يَتِمُّ“. فصلَّيتُ وقُلتُ: ”شَدِّدْ يا اللهُ يَديَّ“.<verse eid="NEH 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="NEH 6:10" />ثُمَّ دَخَلْتُ بيتَ شَمْعيا بنِ دلايا بنِ مَهيطَبْئيلَ وهوَ محجوزٌ علَيه فقالَ لي: ”دَعْنا نَجتمِعُ في داخِلِ هَيكلِ بيتِ اللهِ ونُغلِقُ الأبوابَ لأنَّهم قادمونَ ليَقتُلوكَ. في اللَّيلِ هُم قادمونَ ليقتُلوكَ“. <verse eid="NEH 6:10" /><verse number="11" style="v" pubnumber="11" sid="NEH 6:11" />فقلتُ لَه: ”أرَجُلٌ مِثلي يهربُ؟ أمِثلي يدخلُ الهَيكلَ ليُنْقِذَ حياتَه. لا أدخلُ“. <verse eid="NEH 6:11" /><verse number="12" style="v" pubnumber="12" sid="NEH 6:12" />ثُمَّ تحَقَّقْتُ فوَجَدْتُ أنَّ شَمْعيا هذا لم يُرسِلْهُ اللهُ إليَّ، بل أنَّ طُوبيَّا وسَنْبلَّطَ اَستَأجَراهُ ليَنْطِقَ بالنُّبوَّةِ عَليَّ، <verse eid="NEH 6:12" /><verse number="13" style="v" pubnumber="13" sid="NEH 6:13" />لعَلِّي أخافُ وأعملُ بِمَشورَتِهِ وأخطَأُ، فتَسوءُ سُمعتي ليُعَيِّراني.<verse eid="NEH 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="NEH 6:14" />فصلَّيتُ وقلتُ: ”أُذكُرْ يا اللهُ ما فعَلَهُ طوبيَّا وسَنْبلَّطُ وعاقِبْهُما واَذكُرْ نوعاديَةَ النَّبيَّةَ وسائِرَ الأنبياءِ الّذينَ كانوا يُخَوِّفونَني“.<verse eid="NEH 6:14" /></para>
  <para style="s1">إتمام بناء السور</para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="NEH 6:15" />وتمَّ بِناءُ السُّورِ في الخامِسِ والعِشرينَ مِنْ أيلولَ في اَثنينِ وخمسينَ يومًا. <verse eid="NEH 6:15" /><verse number="16" style="v" pubnumber="16" sid="NEH 6:16" />وسَمِعَ جميعُ أعدائِنا بالخَبَرِ، ورأى جميعُ الأمَمِ الّذينَ حولَنا ما قُمْنا بهِ، فَصَغُروا في عيونِ أنفُسِهِم وعلِموا أنَّ هذا العملَ جرَى بِفَضلِ إلهِنا. <verse eid="NEH 6:16" /><verse number="17" style="v" pubnumber="17" sid="NEH 6:17" />وكذلِكَ رؤساءُ يَهوذا في تِلكَ الأيّامِ كانوا على اَتصالٍ مُستمِرٍّ بِطوبيَّا، <verse eid="NEH 6:17" /><verse number="18" style="v" pubnumber="18" sid="NEH 6:18" />لأنَّ كثيرينَ في يَهوذا حالَفُوه لأنَّهُ صِهرُ شكَنْيا بنِ آرَحَ، ويوحانانُ اَبنُه تزَوَّجَ بِنتَ مَشُلامِ بنِ بَرَكْيا. <verse eid="NEH 6:18" /><verse number="19" style="v" pubnumber="19" sid="NEH 6:19" />وكانوا أيضًا يَمتَدحونَ طوبيَّا أمامي ويَنقلونَ كلامي إليه وأرسلَ طوبيَّا رسائِلَ لتَخويفي.<verse eid="NEH 6:19" /></para>
  <chapter eid="NEH 6" />
  <chapter number="7" style="c" sid="NEH 7" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="NEH 7:1" />ولمَّا بُنيَ السُّورُ ورُفعتِ الأبوابُ بمصاريعِها، عيَّنْتُ البوَّابينَ والمغنِّينَ واللَّاويِّينَ، <verse eid="NEH 7:1" /><verse number="2" style="v" pubnumber="2" sid="NEH 7:2" />وولَّيتُ على أورُشليمَ أخي حنانيَ وحنَنْيا قائِدَ القلعةِ وكانَ حنَنْيا رجلًا أمينًا وأكثرَ مخافةً للهِ مِنْ كثيرينَ، <verse eid="NEH 7:2" /><verse number="3" style="v" pubnumber="3" sid="NEH 7:3" />وقُلتُ لهُما: ”لا تُفتحْ أبوابُ أورُشليمَ إلى أنْ تَحْمى الشَّمسُ وتُقفَلُ قبلَ أنْ تَميلَ الشَّمسُ إلى المَغيبِ“. وأقمتُ حُرَّاسًا مِنْ سُكَّانِ أورُشليمَ، بَعضُهُم في مراكزِ الحِراسةِ، والآخرونَ كُلُّ واحدٍ قُبالةَ بيتهِ. <verse eid="NEH 7:3" /><verse number="4" style="v" pubnumber="4" sid="NEH 7:4" />وكانتِ المدينةُ واسعةً وعظيمةً والشَّعبُ قليلًا في وسَطِها، ولم تكُنِ البيوتُ مبنيَّةً بَعدُ.<verse eid="NEH 7:4" /></para>
  <para style="s1">أسماء العائدين من السبي</para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="NEH 7:5" />فأوحى إليَّ إلهي أنْ أجمعَ الشَّعبَ ورؤساءَهُم ووُلاةَ أمرهِم لإحصائِهِم بحسَبِ اَنتسابِهِم. وكُنتُ وجَدتُ سِجلَّ نسَبِ الّذينَ رجَعوا مِنَ السَّبْي قَبلَ سِواهُم، وكانَ مكتوبًا فيهِ: <verse eid="NEH 7:5" /><verse number="6" style="v" pubnumber="6" sid="NEH 7:6" />هؤلاءِ سكَّانُ بابلَ مِنْ شعبِ إِسرائيلَ الّذينَ سباهُم نَبوخذنَصَّرُ مَلِكُ بابِلَ ورجَعوا مِنَ السَّبْي إلى أورُشليمَ ويَهوذا، كُلُّ واحدٍ إلى مدينتِهِ، <verse eid="NEH 7:6" /><verse number="7" style="v" pubnumber="7" sid="NEH 7:7" />معَ زرُبَّابِلَ ويشوعَ ونحَمْيا وعزَرْيا ورَعْميا ونحماني ومُرْدخاي وبِلْشانَ ومِسفارتَ وبِغوايَ ونَحومَ وبَعنةَ. وهذا عددُهُم: <verse eid="NEH 7:7" /><verse number="8" style="v" pubnumber="8" sid="NEH 7:8" />بَنو فَرعوشَ ألفانِ ومئَةٌ واَثنانِ وسبعونَ، <verse eid="NEH 7:8" /><verse number="9" style="v" pubnumber="9" sid="NEH 7:9" />وبَنو شَفَطْيا ثلاثُ مئَةٍ واَثنانِ وسبعونَ، <verse eid="NEH 7:9" /><verse number="10" style="v" pubnumber="10" sid="NEH 7:10" />وبَنو آرحَ ستُّ مئَةٍ واَثنانِ وخمسونَ، <verse eid="NEH 7:10" /><verse number="11" style="v" pubnumber="11" sid="NEH 7:11" />وبَنو فحَثَ موآبَ مِنْ بَني يشوعَ ويوآبَ ألفانِ وثماني مئَةٍ وثمانيةَ عشَرَ. <verse eid="NEH 7:11" /><verse number="12" style="v" pubnumber="12" sid="NEH 7:12" />وبَنو عيلامَ ألفٌ ومئتانِ وأربعةٌ وخمسونَ. <verse eid="NEH 7:12" /><verse number="13" style="v" pubnumber="13" sid="NEH 7:13" />وبَنو زتُّو ثماني مئَةٍ وخمسةٌ وأربعونَ، <verse eid="NEH 7:13" /><verse number="14" style="v" pubnumber="14" sid="NEH 7:14" />وبَنو زكَّايَ سَبْعُ مئَةٍ وستُّونَ، <verse eid="NEH 7:14" /><verse number="15" style="v" pubnumber="15" sid="NEH 7:15" />وبَنو بِنُّوي ستُّ مئةٍ وثمانيةٌ وأربعونَ، <verse eid="NEH 7:15" /><verse number="16" style="v" pubnumber="16" sid="NEH 7:16" />وبَنو بابايَ ستُّ مئَةٍ وثمانيةٌ وعشرونَ، <verse eid="NEH 7:16" /><verse number="17" style="v" pubnumber="17" sid="NEH 7:17" />وبَنو عَزْجدَ ألفانِ وثلاثُ مئَةٍ واَثنانِ وعِشرونَ. <verse eid="NEH 7:17" /><verse number="18" style="v" pubnumber="18" sid="NEH 7:18" />وبَنو أدونيقامَ ستُّ مئَةٍ وسبعةٌ وستُّونَ، <verse eid="NEH 7:18" /><verse number="19" style="v" pubnumber="19" sid="NEH 7:19" />وبَنو بغوايَ ألفانِ وسبعةٌ وستُّونَ، <verse eid="NEH 7:19" /><verse number="20" style="v" pubnumber="20" sid="NEH 7:20" />وبَنو عادينَ ستُّ مئَةٍ وخمسةٌ وخمسونَ، <verse eid="NEH 7:20" /><verse number="21" style="v" pubnumber="21" sid="NEH 7:21" />وبَنو أطِّيرَ لحَزْقِيَّا ثمانيةٌ وتسعونَ، <verse eid="NEH 7:21" /><verse number="22" style="v" pubnumber="22" sid="NEH 7:22" />وبَنو حَشُومَ ثلاثُ مئَةٍ وثمانيةٌ وعشرونَ، <verse eid="NEH 7:22" /><verse number="23" style="v" pubnumber="23" sid="NEH 7:23" />وبَنو بيصايَ ثلاثُ مئَةٍ وأربعةٌ وعشرونَ، <verse eid="NEH 7:23" /><verse number="24" style="v" pubnumber="24" sid="NEH 7:24" />وبَنو حاريفَ مئَةٌ واَثنا عشَرَ، <verse eid="NEH 7:24" /><verse number="25" style="v" pubnumber="25" sid="NEH 7:25" />وبَنو جبعونَ خمسةٌ وتسعونَ، <verse eid="NEH 7:25" /><verse number="26" style="v" pubnumber="26" sid="NEH 7:26" />ورجالُ بَيتَ لحمَ ونطوفةَ مئَةٌ وثمانيةٌ وثمانونَ، <verse eid="NEH 7:26" /><verse number="27" style="v" pubnumber="27" sid="NEH 7:27" />ورجالُ عَناثوتَ مئَةٌ وثمانيةٌ وعشرونَ، <verse eid="NEH 7:27" /><verse number="28" style="v" pubnumber="28" sid="NEH 7:28" />ورجالُ بَيتَ عَزْموتَ اَثنانِ وأربعونَ، <verse eid="NEH 7:28" /><verse number="29" style="v" pubnumber="29" sid="NEH 7:29" />ورجالُ قريةِ يعاريمَ كفيرةَ وبئيروتَ سبعُ مئَةٍ وثلاثَةٌ وأربعونَ، <verse eid="NEH 7:29" /><verse number="30" style="v" pubnumber="30" sid="NEH 7:30" />ورجالُ الرَّامةِ وجبَعَ ستُّ مئَةٍ وواحدٌ وعشرونَ، <verse eid="NEH 7:30" /><verse number="31" style="v" pubnumber="31" sid="NEH 7:31" />ورجالُ مُخْماسَ مئَةٌ واَثنانِ وعشرونَ، <verse eid="NEH 7:31" /><verse number="32" style="v" pubnumber="32" sid="NEH 7:32" />ورجالُ بيتَ إيلَ وعايَ مئَةٌ وثلاثةٌ وعشرونَ، <verse eid="NEH 7:32" /><verse number="33" style="v" pubnumber="33" sid="NEH 7:33" />ورجالُ نَبو الأخرى اَثنانِ وخمسونَ، <verse eid="NEH 7:33" /><verse number="34" style="v" pubnumber="34" sid="NEH 7:34" />وبَنو عِيلامَ الآخرِ ألفٌ ومئتانِ وأربعةٌ وخمسونَ، <verse eid="NEH 7:34" /><verse number="35" style="v" pubnumber="35" sid="NEH 7:35" />وبَنو حاريمَ ثلاثُ مئَةٍ وعشرونَ، <verse eid="NEH 7:35" /><verse number="36" style="v" pubnumber="36" sid="NEH 7:36" />وبَنو أريحا ثلاثُ مئَةٍ وخمسَةٌ وأربعونَ، <verse eid="NEH 7:36" /><verse number="37" style="v" pubnumber="37" sid="NEH 7:37" />وبَنو لُودَ وبَنو حاديدَ وأُونو سبعُ مئَةٍ وواحدٌ وعشرونَ، <verse eid="NEH 7:37" /><verse number="38" style="v" pubnumber="38" sid="NEH 7:38" />وبَنو سَناءَةَ ثلاثةُ آلافٍ وتسعُ مئَةٍ وثَلاثونَ.<verse eid="NEH 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" pubnumber="39" sid="NEH 7:39" />ومِنَ الكهنةِ بَنو يَدْعيا بنِ بَيتِ يَشوعَ تسعُ مئَةٍ وثلاثَةٌ وسبعونَ <verse eid="NEH 7:39" /><verse number="40" style="v" pubnumber="40" sid="NEH 7:40" />وبَنو إِمِّيرَ ألفٌ واَثنانِ وخمسونَ، <verse eid="NEH 7:40" /><verse number="41" style="v" pubnumber="41" sid="NEH 7:41" />وبَنو فشحورَ ألفٌ ومئتانِ وسبعةٌ وأربعونَ، <verse eid="NEH 7:41" /><verse number="42" style="v" pubnumber="42" sid="NEH 7:42" />وبَنو حاريمَ ألفٌ وسبعةَ عشَرَ.<verse eid="NEH 7:42" /></para>
  <para style="p">
    <verse number="43" style="v" pubnumber="43" sid="NEH 7:43" />ومِنَ اللَّاويِّينَ بَنو يَشوعَ وقدميئيلَ مِنْ بني هُودُويا أربعةٌ وسبعونَ، <verse eid="NEH 7:43" /><verse number="44" style="v" pubnumber="44" sid="NEH 7:44" />والمغنُّونَ بَنو آسافَ مئَةٌ وثمانيةٌ وأربعونَ، <verse eid="NEH 7:44" /><verse number="45" style="v" pubnumber="45" sid="NEH 7:45" />والبوَّابونَ بَنو شَلُّومَ وبَنو أطيرَ وبَنو طَلْمونَ وبَنو عقُّوبَ وبَنو حَطِيطا وبَنو شُوبايَ مئَةٌ وثمانيةٌ وثلاثونَ.<verse eid="NEH 7:45" /></para>
  <para style="p">
    <verse number="46" style="v" pubnumber="46" sid="NEH 7:46" />وخدَّامُ الهَيكلِ بَنو صِيحا وبَنو حَسُوفا وبَنو طَباعُوتَ <verse eid="NEH 7:46" /><verse number="47" style="v" pubnumber="47" sid="NEH 7:47" />وبَنو قِيروس وبَنو سِيعا وبَنو فادُونَ <verse eid="NEH 7:47" /><verse number="48" style="v" pubnumber="48" sid="NEH 7:48" />وبَنو لَبانةَ وبَنو حَجايا وبَنو سَلْمايَ <verse eid="NEH 7:48" /><verse number="49" style="v" pubnumber="49" sid="NEH 7:49" />وبَنو حانانَ وبَنو جَديلَ وبَنو جَاحرَ <verse eid="NEH 7:49" /><verse number="50" style="v" pubnumber="50" sid="NEH 7:50" />وبَنو رآيا وبَنو رصِينَ وبَنو نَقُودا <verse eid="NEH 7:50" /><verse number="51" style="v" pubnumber="51" sid="NEH 7:51" />وبَنو جَزامَ وبَنو عَزا وبَنو فاسيحَ. <verse eid="NEH 7:51" /><verse number="52" style="v" pubnumber="52" sid="NEH 7:52" />وبَنو يَسايَ وبَنو مَعُونيمَ وبَنو نَفيشسيمَ <verse eid="NEH 7:52" /><verse number="53" style="v" pubnumber="53" sid="NEH 7:53" />وبَنو بَقبُوقَ وبَنو حَقوقا وبَنو حَرحورَ <verse eid="NEH 7:53" /><verse number="54" style="v" pubnumber="54" sid="NEH 7:54" />وبَنو بَصليتَ وبَنو مَحِيدا وبَنو حَرْشا <verse eid="NEH 7:54" /><verse number="55" style="v" pubnumber="55" sid="NEH 7:55" />وبَنو بَرقوسَ وبَنو سِيسَرا وبَنو تامحَ <verse eid="NEH 7:55" /><verse number="56" style="v" pubnumber="56" sid="NEH 7:56" />وبَنو نَصيحَ وبَنو حَطيفا.<verse eid="NEH 7:56" /></para>
  <para style="p">
    <verse number="57" style="v" pubnumber="57" sid="NEH 7:57" />أمَّا ذُرِّيَّةُ عبيدِ سليمانَ فبَنو سُوطايَ وبَنو سُوفرثَ وبَنو فَريدا <verse eid="NEH 7:57" /><verse number="58" style="v" pubnumber="58" sid="NEH 7:58" />وبَنو يَعلا وبَنو دَرقونَ وبَنو جَدِّيلَ <verse eid="NEH 7:58" /><verse number="59" style="v" pubnumber="59" sid="NEH 7:59" />وبَنو شَفَطْيا وبَنو حَطِّيلَ وبَنو فُوخرةِ الظِّباءِ وبَنو آمونَ. <verse eid="NEH 7:59" /><verse number="60" style="v" pubnumber="60" sid="NEH 7:60" />جميعُ خُدَّامِ الهَيكلِ وذُرِّيَّةُ عبيدِ سليمانَ ثلاثُ مئَةٍ واَثنانِ وتسعونَ.<verse eid="NEH 7:60" /></para>
  <para style="p">
    <verse number="61" style="v" pubnumber="61" sid="NEH 7:61" />وهؤلاءِ الّذينَ رجَعوا مِنْ تَلِّ مِلْحٍ وتَلِّ حَرْشا وكرُوبَ وأدونَ وإِمِّيرَ ولم يقدروا أنْ يُبرهِنوا على أنَّ عشائِرَهُم ينتسبونَ إلى بَني إِسرائيلَ: <verse eid="NEH 7:61" /><verse number="62" style="v" pubnumber="62" sid="NEH 7:62" />بَنو دَلايا وبَنو طوبيَّا وبَنو نَقُودا ستُّ مئَةٍ واَثنانِ وأربعونَ، <verse eid="NEH 7:62" /><verse number="63" style="v" pubnumber="63" sid="NEH 7:63" />ومِنَ الكَهنةِ بَنو حَبابا وبَنو هَقُّوصَ وبَنو بَرزلَّايَ الّذي تزوَّجَ اَمرأةً مِنْ بناتِ برَزِلَّايَ الجِلعاديّ وتسمَّى باَسمِهم <verse eid="NEH 7:63" /><verse number="64" style="v" pubnumber="64" sid="NEH 7:64" />هؤلاءِ بحثوا عَن سِجِلِّ أنسابِهِم فلم يَجِدوهُ، فَحُرِموا مِنَ الكَهنوتِ. <verse eid="NEH 7:64" /><verse number="65" style="v" pubnumber="65" sid="NEH 7:65" />وقالَ لهُم حاكِمُهُمُ اليهوديُّ أنْ لا يأكلوا مِنَ الطَّعامِ المُكرَّسِ للرّبِّ حتّى يقومَ كاهنٌ للأوريمِ والتُّمِّيمِ ويَفصِلَ في الأمرِ. <verse eid="NEH 7:65" /><verse number="66" style="v" pubnumber="66" sid="NEH 7:66" />كُلُّ هؤلاءِ معًا اَثنانِ وأربعونَ ألفًا وثلاثُ مئَةٍ وستُّونَ. <verse eid="NEH 7:66" /><verse number="67" style="v" pubnumber="67" sid="NEH 7:67" />فَضلًا عن عبيدِهِم وإمائِهِم وهُم سبعةُ آلافٍ وثلاثُ مئَةٍ وسبعةٌ وثلاثونَ وعنِ المُغنِّينَ والمُغنِّياتِ وهُم مِئتانِ وخمسةٌ وأربعونَ. <verse eid="NEH 7:67" /><verse number="68" style="v" pubnumber="68" sid="NEH 7:68" />أمَّا جِمالُهم فأربعُ مئَةٍ وخمسةٌ وثلاثونَ، وحَميرُهم ستَّةُ آلافٍ وسبعُ مئَةٍ وعشرونَ.<verse eid="NEH 7:68" /></para>
  <para style="p">
    <verse number="69" style="v" pubnumber="69" sid="NEH 7:69" />وتبرَّعَ بَعضُ رُؤساءِ العَشائرِ للعمَلِ في بناءِ الهَيكلِ، فأعطى الحاكمُ للخزينةِ ألفَ دِرهمِ ذهبٍ وخمسينَ طاسًا وخمسَ مئَةٍ وثَلاثينَ قميصًا للكَهنةِ <verse eid="NEH 7:69" /><verse number="70" style="v" pubnumber="70" sid="NEH 7:70" />والآخرونَ عشرينَ ألفَ دِرهمٍ مِنَ الذَّهبِ وخمسةَ قناطيرَ مِنَ الفِضَّةِ. <verse eid="NEH 7:70" /><verse number="71" style="v" pubnumber="71" sid="NEH 7:71" />أمَّا سائرُ الشَّعبِ فأعطى للخزينةِ عِشرينَ ألفَ دِرهمٍ مِنَ الذَّهبِ وأربعةَ قناطيرَ ونِصفَ القِنطارِ مِنَ الفضَّةِ وسبعةً وستِّينَ قميصًا للكَهنةِ.<verse eid="NEH 7:71" /></para>
  <para style="p">
    <verse number="72" style="v" pubnumber="72" sid="NEH 7:72" />فسكنَ الكَهنةُ واللَّاويُّونَ وبعضُ الشَّعبِ في أورُشليمَ. أمَّا البوَّابونَ والمُغنُّونَ وسائرُ بَني إِسرائيلَ فسكنوا في مُدنِهِم.</para>
  <para style="s1" vid="NEH 7:72">عزرا يقرأ كتاب الشريعة</para>
  <para style="p" vid="NEH 7:72">ولمَّا أقبلَ الشَّهرُ السَّابعُ أقامَ بَنو إِسرائيلَ في مدنِهِم.<verse eid="NEH 7:72" /></para>
  <chapter eid="NEH 7" />
  <chapter number="8" style="c" sid="NEH 8" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="NEH 8:1" />واَجتمعَ الشَّعبُ كُلُّهُ بقلبٍ واحدٍ في السَّاحةِ الّتي أمامَ بابِ المياهِ وقالوا لعزرا الكاهنِ والعالِمِ بالشَّريعةِ، أنْ يُحضِرَ كتابَ شريعةِ موسى الّتي أمرَ بِها الرّبُّ بَني إِسرائيلَ. <verse eid="NEH 8:1" /><verse number="2" style="v" pubnumber="2" sid="NEH 8:2" />فأحضرَ عزرا الكاهنُ كِتابَ الشَّريعةِ أمامَ جميعِ الشَّعبِ الرِّجالِ والنِّساءِ والأولادِ القادرينَ على الفَهْمِ. كانَ ذلِكَ في اليومِ الأوّلِ مِنَ الشَّهرِ السَّابعِ. <verse eid="NEH 8:2" /><verse number="3" style="v" pubnumber="3" sid="NEH 8:3" />وقرأَ عزرا في الكتابِ أمامَ السَّاحةِ الّتي أمامَ بابِ المياهِ، مِنَ الصُّبحِ إلى نِصفِ النَّهارِ، وكُلُّهُم آذانٌ صاغيةٌ إلى كتابِ الشَّريعةِ. <verse eid="NEH 8:3" /><verse number="4" style="v" pubnumber="4" sid="NEH 8:4" />وقامَ عزرا على مِنبرٍ مِنْ خشَبٍ مصنوعٍ لهذا الغرضِ، ووقفَ مَتَّثْيا وشَمَعْ وعنايا وأورِيَّا وحِلْقِيَّا ومَعَسيا عَنْ يمينهِ، وفدايا وميشائيلُ وملْكِيَّا وحَشومُ وحِشْبَدَّانةُ وزكريَّا ومَشُلامُ عَنْ يَسارِهِ. <verse eid="NEH 8:4" /><verse number="5" style="v" pubnumber="5" sid="NEH 8:5" />وفتحَ عزرا الكتابَ بمرأى مِنْ جميعِ الشَّعبِ لأنَّهُ كانَ فوقَ الشَّعبِ كُلِّهِم، فوقفوا جميعُهُم. <verse eid="NEH 8:5" /><verse number="6" style="v" pubnumber="6" sid="NEH 8:6" />وباركَ عزرا الرّبَّ الإلهَ العظيمَ، فأجابَ جميعُ الشَّعبِ: ”آمينَ. آمينَ!“ وهُم رافعونَ أيديَهُم، وركعوا أمامَ الرّبِّ وسجدوا لَه بوجوهِهِم إلى الأرضِ. <verse eid="NEH 8:6" /><verse number="7" style="v" pubnumber="7" sid="NEH 8:7" />ثمَّ وقفوا في أماكنِهم وأخذَ اللَّاويُّونَ يشوعُ وباني وشرَبْيا ويامينُ وعَقُّوبُ وشَبْتايُ وهُودِيَّا ومَعْسِيا وقَلِيْطا وعزَرْيا ويوزابادُ وحنانُ وفلايا واللَّاويُّونَ يُفسِّرونَ لهُمُ الشَّريعةَ. <verse eid="NEH 8:7" /><verse number="8" style="v" pubnumber="8" sid="NEH 8:8" />فقرأوها في كتابِ شريعةِ اللهِ وترجموها لهُم وفسَّروا معناها.<verse eid="NEH 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="NEH 8:9" />وكانَ الشَّعبُ كُلُّهُم يَبكونَ عِندَ سَماعِ كلامِ الشَّريعةِ. فقالَ لهُمُ نحَمْيا الحاكمُ، وعزرا الكاهنُ والعالِمُ بالشَّريعةِ، واللَّاويُّونَ الّذينَ كانوا يفسِّرونَ لهُم الشَّريعةَ: ”هذا يومٌ مُقدَّسٌ للرّبِّ إلهِكُم. لا تنوحوا ولا تبكوا“. <verse eid="NEH 8:9" /><verse number="10" style="v" pubnumber="10" sid="NEH 8:10" />وقالوا لهُم: ”إذهبوا كُلوا ما طابَ لكُم واَشربوا ما حلا، ووزِّعوا مِنه حِصصًا على مَنْ لم يكُنْ عِندَهُ، لأنَّ اليومَ يومٌ مقدَّسٌ لربِّنا. ولا تحزنوا، فالفَرحُ المُعطَى مِنَ الرّبِّ يُقوّيكُم“. <verse eid="NEH 8:10" /><verse number="11" style="v" pubnumber="11" sid="NEH 8:11" />وكانَ اللَّاويُّونَ يُهدِّئونَ الشَّعبَ بقولِهِم: ”أُسكتوا لأنَّ اليومَ يومٌ مقدَّسٌ ولا تحزنوا“. <verse eid="NEH 8:11" /><verse number="12" style="v" pubnumber="12" sid="NEH 8:12" />فاَنصرفَ جميعُ الشَّعبِ ليأكلوا ويشربوا ويوزِّعوا حِصصًا مِمَّا يأكلونَ ويشربونَ، وليفرحوا فرَحًا عظيمًا، لأنَّهُم فهِموا الكَلامَ الّذي تعلّموهُ.<verse eid="NEH 8:12" /></para>
  <para style="s1">عيد المظال</para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="NEH 8:13" />وفي اليومِ الثَّاني اَجتمعَ رؤساءُ عشائرِ الشَّعبِ، والكهنةُ واللَّاويُّونَ، إلى عزرا العالِمِ بالشَّريعةِ ليتفهَّموا كَلامَ الشَّريعةِ، <verse eid="NEH 8:13" /><verse number="14" style="v" pubnumber="14" sid="NEH 8:14" />فوجدوا في كتابِ الشَّريعةِ الّتي أمرَ الرّبُّ بها على لسانِ موسى أنَّ على بَني إِسرائيلَ أنْ يسكنوا المَظالَ في عيدِ المَظالِ، في الشَّهرِ السَّابعِ، <verse eid="NEH 8:14" /><verse number="15" style="v" pubnumber="15" sid="NEH 8:15" />فأذاعوا ونادوا في جميعِ مُدُنِ إِسرائيلَ وفي أورُشليمَ قائلينَ: ”أُخرجوا إلى الجبَلِ واَجلبوا أغصانًا مِنَ الزَّيتونِ والصَّنوبرِ والآسِ والنَّخيلِ وكُلِّ شجَرٍ كثيفٍ واَعملوا المَظالَ كما هوَ مكتوبٌ“. <verse eid="NEH 8:15" /><verse number="16" style="v" pubnumber="16" sid="NEH 8:16" />فخرجَ الشَّعبُ وجلبوا ذلِكَ وعمِلوا لهُم مَظالَّ، كُلُّ واحدٍ على سَطحِهِ وفي دارِهِ، وفي دُورِ بَيتِ اللهِ، وساحةِ بابِ المياهِ، وساحةِ بابِ أفرايمَ. <verse eid="NEH 8:16" /><verse number="17" style="v" pubnumber="17" sid="NEH 8:17" />وعمِلَ كُلُّ الجماعةِ الّذينَ عادوا مِن السَّبْي مَظالَّ وأقاموا فيها. فَمِنْ أيّامِ يَشوعَ بنِ نُونٍ إلى ذلِكَ اليومِ لم يَعمَلْ بَنو إِسرائيلَ مِثلَ ذلِكَ، فكانَ فَرحُهُم عظيمًا جِدًّا. <verse eid="NEH 8:17" /><verse number="18" style="v" pubnumber="18" sid="NEH 8:18" />وكانَ يُتْلى في كتابِ شريعةِ اللهِ كُلَّ يومٍ، مِنَ اليومِ الأوَّلِ إلى اليومِ الأخيرِ، وأقاموا العيدَ سبعةَ أيّامٍ، وفي اليومِ الثَّامِنِ كانَ اَحتفالٌ كما هوَ مرسومٌ في الشَّريعةِ.<verse eid="NEH 8:18" /></para>
  <chapter eid="NEH 8" />
  <chapter number="9" style="c" sid="NEH 9" />
  <para style="s1">إعتراف الشعب بخطاياهم</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="NEH 9:1" />وفي اليومِ الرَّابعِ والعشرينَ مِنَ الشَّهرِ نفْسِهِ اَجتمعَ بَنو إِسرائيلَ للصِّيامِ، وعلَيهِم مُسوحٌ وترابٌ. <verse eid="NEH 9:1" /><verse number="2" style="v" pubnumber="2" sid="NEH 9:2" />واَنفردَ نَسلُ إِسرائيلَ عَن جميعِ الغرباءِ ووقفوا واَعترفوا بخطاياهُم وذنوبِ آبائِهِم. <verse eid="NEH 9:2" /><verse number="3" style="v" pubnumber="3" sid="NEH 9:3" />وقاموا واقفينَ في أماكنِهِم وقرأوا في كتابِ شريعةِ الرّبِّ إلهِهِم رُبعَ النَّهارِ، وفي الرُّبعِ الآخرِ كانوا يعترفونَ بخطاياهُم للرّبِّ إلهِهِم ويسجدونَ لهُ. <verse eid="NEH 9:3" /><verse number="4" style="v" pubnumber="4" sid="NEH 9:4" />ثمَّ قامَ على مِنبرِ اللَّاويِّينَ يشوعُ وباني وقدميئيلُ وشَبَنْيا وبُنِّي وشَرَبْيا وباني وكناني وصرخوا بصوتٍ عظيمٍ إلى الرّبِّ إلهِهِم. <verse eid="NEH 9:4" /><verse number="5" style="v" pubnumber="5" sid="NEH 9:5" />وقالَ اللَّاويُّونَ، يشوعُ وقدميئيلُ وباني وحَشَبَنْيَا وشَرَبْيا وهُودِيَّا وشَبَنْيا وفَتَحْيَا: ”قوموا بارِكوا الرّبَّ إلهَكُم مِنَ الآنَ إلى الأبدِ، ونادوا تبارَكَ اَسمُكَ المجيدُ الّذي هوَ فَوقَ كُلِّ برَكةٍ وتسبيحٍ. <verse eid="NEH 9:5" /><verse number="6" style="v" pubnumber="6" sid="NEH 9:6" />أنتَ يا ربُّ وحدَكَ صَنعْتَ السَّماواتِ وسماءَ السَّماواتِ وكُلَّ جُندِها والأرضَ وكُلَّ ما علَيها والبحارَ وكُلَّ ما فيها، وأنتَ مُحيي هذِهِ كُلِّها، جُندُ السَّماءِ يسجدُ لكَ. <verse eid="NEH 9:6" /><verse number="7" style="v" pubnumber="7" sid="NEH 9:7" />أنتَ الرّبُّ الإلهُ الّذي اَصطفيتَ أبرامَ وأخرَجْتَهُ مِنْ أُورِ الكلدانيِّينَ وجَعلتَ اَسمَهُ إبراهيمَ. <verse eid="NEH 9:7" /><verse number="8" style="v" pubnumber="8" sid="NEH 9:8" />ووجدتَ قلبَهُ أمينًا لكَ، فعاهَدْتَهُ على أنْ تُعطيَ لَه ولنَسلِهِ أرضَ كنعانَ بِمَنْ فيها مِنَ الحِثِّيِّينَ والأموريِّينَ والفرزِّيِّينَ واليبوسيِّينَ والجِرجاشيِّينَ. وأنتَ حقَّقتَ وعدَكَ لأنَّكَ صادِقٌ. <verse eid="NEH 9:8" /><verse number="9" style="v" pubnumber="9" sid="NEH 9:9" />ثمَّ نَظَرتَ إلى مَذلَّةِ آبائِنا في مِصْرَ وسمِعْتَ صُراخَهُم عِندَ البحرِ الأحمرِ، <verse eid="NEH 9:9" /><verse number="10" style="v" pubnumber="10" sid="NEH 9:10" />فأظهرتَ آياتٍ ومُعجزاتٍ في فِرعونَ وجميعِ عبيدِهِ وكُلِّ سُكَّانِ أرضِهِ لأنَّكَ عَلِمْتَ أنَّهُم جاروا علَيهم، وأقمتَ لكَ اَسمًا عظيمًا كما في هذا اليومِ. <verse eid="NEH 9:10" /><verse number="11" style="v" pubnumber="11" sid="NEH 9:11" />وفَلقْتَ البحرَ أمامَهُم فَعَبَروا في وسَطِ البحرِ على أرضٍ يابسةٍ، وطرحتَ مطارِديهِم في الأعماقِ كحجرٍ في مياهٍ عارِمةٍ. <verse eid="NEH 9:11" /><verse number="12" style="v" pubnumber="12" sid="NEH 9:12" />وأرشدتَهُم بِعمودِ سحابٍ في النَّهارِ، وبِعمودِ النَّارِ في اللَّيلِ ليُنيرَ لهُمُ الطَّريقَ الّتي يسيرونَ فيها. <verse eid="NEH 9:12" /><verse number="13" style="v" pubnumber="13" sid="NEH 9:13" />ونَزلتَ على جبَلِ سيناءَ وخاطبْتَهُم مِنَ السَّماءِ وأعطيتَهُم أحكامًا مستقيمةً، وشرائِعَ حَقٍّ، وفرائضَ، ووصايا صالحةً. <verse eid="NEH 9:13" /><verse number="14" style="v" pubnumber="14" sid="NEH 9:14" />وعلَّمْتَهُم أنْ يُقَدِّسوا سبْتَكَ، أمرتَهُم بِوصايا وفرائِضَ وشرائِعَ على لسانِ موسى عبدِكَ. <verse eid="NEH 9:14" /><verse number="15" style="v" pubnumber="15" sid="NEH 9:15" />ورَزقتَهُم خُبزًا مِنَ السَّماءِ في جُوعِهِم، ومياهًا مِنَ الصَّخرِ أخرجْتَ لهُم في عَطَشِهِم، وأمرْتَهُم أن يَدخلوا ليَملِكوا الأرضَ الّتي رَفعْتَ يَدَكَ مُقسِمًا أنْ تُعطيَها لهُم.<verse eid="NEH 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="NEH 9:16" />”ولكِنَّهُم تَجبَّروا هُم وآباؤُنا وعانَدوكَ ولم يُطيعوا أوامرَكَ، <verse eid="NEH 9:16" /><verse number="17" style="v" pubnumber="17" sid="NEH 9:17" />وأبَوا أنْ يسمعوا، ولم يَتَذكَّروا عَجائِبَكَ الّتي صَنعْتَ معَهُم بل عانَدوكَ وفي سيناءَ تَمَرَّدوا وأقاموا رئيسًا ليرجِعوا إلى عُبوديَّتِهِم في مِصْرَ. ولكِنَّكَ إلهٌ غفورٌ، حنونٌ، بطيءُ الغضَبِ، كثيرُ الرَّحمةِ، فما أهملتَهُم. <verse eid="NEH 9:17" /><verse number="18" style="v" pubnumber="18" sid="NEH 9:18" />وصنعوا لهُم عِجْلًا مسبوكًا وقالوا: هذا إلهُنا الّذي أخرَجَنا مِنْ مِصْرَ فكفروا كُفرًا عظيمًا. <verse eid="NEH 9:18" /><verse number="19" style="v" pubnumber="19" sid="NEH 9:19" />ولكِنَّكَ بمراحِمِكَ الكثيرةِ لم تُهمِلْهُم في البرِّيَّةِ، فما فارَقَهُم عمودُ السَّحابِ نهارًا ليُرشدَهُم في الطَّريقِ، ولا عمودُ النَّارِ ليلًا ليُنيرَ علَيهِم في الطَّريقِ الّتي يسيرونَ فيها. <verse eid="NEH 9:19" /><verse number="20" style="v" pubnumber="20" sid="NEH 9:20" />وأعطيتَهُم روحَكَ الصَّالحَ ليعلِّمَهُم، ولم تمنعِ المَنَّ عَنْ أفواهِهِم، وأعطيتَهُم ماءً في عطَشِهِم. <verse eid="NEH 9:20" /><verse number="21" style="v" pubnumber="21" sid="NEH 9:21" />أربعينَ سَنةً عُلْتَهُم في البرِّيَّةِ، فما أعوزَهُم شيءٌ، ولا بلِيَت ثيابُهُم ولا تورَّمت أرجلُهُم. <verse eid="NEH 9:21" /><verse number="22" style="v" pubnumber="22" sid="NEH 9:22" />ووهبتَهُم ممالِكَ وشعوبًا، ومهَّدْتَ لهُم طريقَ الصَّحراءِ فمَلكوا أرضَ سِيحونَ وأرضَ مَلِكِ حَشبونَ وأرضَ عُوجٍ مَلِكِ باشانَ. <verse eid="NEH 9:22" /><verse number="23" style="v" pubnumber="23" sid="NEH 9:23" />وأكثَرْتَ أولادَهُم كنُجومِ السَّماءِ، فَجِئتَ بِهِم إلى الأرضِ الّتي وَعدْتَ آباءَهُم أنْ يدخلوها ويَمتلِكوها <verse eid="NEH 9:23" /><verse number="24" style="v" pubnumber="24" sid="NEH 9:24" />فدخلَ بَنوهُم واَمتلكوا أرضَ كنعانَ الّتي أخضعتَ لهُم سُكَّانَها، ودفَعْتَ شعبَها وملوكَهُم إلى أيديهِم ليفعلوا بِهِم كما يشاؤونَ. <verse eid="NEH 9:24" /><verse number="25" style="v" pubnumber="25" sid="NEH 9:25" />فأخذوا مُدُنًا مُحصَّنةً وأرضًا مُخْصِبةً، واَمتلكوا بيوتًا مملوءةً بالخَيراتِ وآبارًا مَحفورةً وكُرومًا وزيتونًا وأشجارًا مُثمِرةً، وأكلوا وشبِعوا وسَمِنوا وتلذَّذوا بِجودِكَ العظيمِ. <verse eid="NEH 9:25" /><verse number="26" style="v" pubnumber="26" sid="NEH 9:26" />ثمَّ أغضبوكَ وتَمَرَّدوا علَيكَ ونَبذوا شريعتَكَ وقَتلوا أنبياءَكَ الّذينَ أنذروهُم ليردُّوهُم إليكَ، فكفَروا بِكَ كُفرًا عظيمًا. <verse eid="NEH 9:26" /><verse number="27" style="v" pubnumber="27" sid="NEH 9:27" />فأسلَمْتَهُم إلى أيدي خُصومِهِم فأذلُّوهُم، وفي وقتِ ضيقِهِم صرخوا إليكَ فسَمِعْتَ أنتَ مِنَ السَّماءِ صُراخَهُم، وبمراحِمِكَ الكثيرةِ أعطيتَهُم مُخَلِّصينَ، فَخَلَّصوهُم مِنْ أيدي أعدائِهِم. <verse eid="NEH 9:27" /><verse number="28" style="v" pubnumber="28" sid="NEH 9:28" />فلمَّا اَطمأنُّوا عادوا إلى عَملِ الشَّرِّ أمامَكَ، فتركتَهُم في أيدي أعدائِهِم. فتسلَّطَ أعداؤُهُم علَيهِم، فتابوا وصرخوا إليكَ. فاَستجَبْتَ لهُم مِنَ السَّماءِ ونجَّيتَهُم مِرارًا لِكثرةِ مراحِمِكَ. <verse eid="NEH 9:28" /><verse number="29" style="v" pubnumber="29" sid="NEH 9:29" />وأنذرْتَهُم لِتَرُدَّهُم إلى شريعتِكَ، فتَجَبَّروا ولم يسمَعوا لِوَصاياكَ، وخَطِئوا في أحكامِكَ الّتي إذا عَمِلَ بها الإنسانُ يحيا بها، وأعطَوا كتِفًا مُعانِدةً وعاندوا ولم يسمَعوا. <verse eid="NEH 9:29" /><verse number="30" style="v" pubnumber="30" sid="NEH 9:30" />فصَبَرتَ علَيهِم سنينَ كثيرةً، فأوحيتَ إلى أنبيائِكَ أن يُنذِروهُم فما أصغَوا إليهِم، فدَفعتَهُم إلى أيدي شُعوبِ الأرضِ. <verse eid="NEH 9:30" /><verse number="31" style="v" pubnumber="31" sid="NEH 9:31" />ولكنَّكَ لِكثرةِ مراحِمِكَ لم تَقتَلِعْهُم ولم تُهمِلْهُم لأنَّكَ إلهٌ حنونٌ رحيمٌ.<verse eid="NEH 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" pubnumber="32" sid="NEH 9:32" />”فالآنَ يا إلهَنا العظيمَ القادِرَ الرَّهيبَ الحافِظَ العهدَ والرَّحمةَ لا تَصغُرْ في عينَيكَ كُلُّ هذِهِ المَشَقَّاتِ الّتي أصابتْنا نحنُ وملوكَنَا وزُعماءَنا وكهَنَتَنا وأنبياءَنا وآباءَنا وجميعَ شعبِكَ مُنذُ أيّامِ ملوكِ أشُّورَ إلى هذا اليومِ. <verse eid="NEH 9:32" /><verse number="33" style="v" pubnumber="33" sid="NEH 9:33" />وأنتَ عادلٌ ومُحِقٌّ في كُلِّ ما أنزَلْتَهُ بِنا مِنْ نَكَباتٍ، لأننا أثِمْنا. <verse eid="NEH 9:33" /><verse number="34" style="v" pubnumber="34" sid="NEH 9:34" />ملوكُنا وزعماؤُنا وكهَنتُنا وآباؤُنا لم يعمَلوا بشريعتِكَ ولم يُصغوا إلى وصاياكَ وإنذاراتِكَ الّتي أنذرتَهُم بها، <verse eid="NEH 9:34" /><verse number="35" style="v" pubnumber="35" sid="NEH 9:35" />ولا عبَدوكَ في أيّامِ عِزِّهِم والخَيرِ العظيمِ الّذي أعطيتَهُم والأرضِ الواسعةِ المُخصِبةِ الّتي وهبْتَها لهُم، ولم يتوبوا عَنْ تَصَرُّفاتِهِمِ الشِّرِّيرةِ. <verse eid="NEH 9:35" /><verse number="36" style="v" pubnumber="36" sid="NEH 9:36" />وها نحنُ اليومَ عبيدٌ في الأرضِ الّتي أعطيتَها لآبائنا ليأكلوا ثمَرها وخَيرَها، <verse eid="NEH 9:36" /><verse number="37" style="v" pubnumber="37" sid="NEH 9:37" />ها غَلَّتَها الوافرةَ يأخذُها المُلوكُ الّذينَ ولَّيتَهُم علَينا لأننا خَطِئْنا، وهُم مُتَسلِّطونَ على أبدانِنا وعلى بهائِمِنا كما يشاؤونَ، ونحنُ في ضيقٍ شديدٍ“.<verse eid="NEH 9:37" /></para>
  <chapter eid="NEH 9" />
  <chapter number="10" style="c" sid="NEH 10" />
  <para style="s1">شعب إسرائيل يقطع عهدًا</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="NEH 10:1" />ولأجلِ هذا كُلِّهِ نحنُ، شعبَ إِسرائيلَ، نقطعُ عهدًا ونكتُبُ وزعماؤُنا واللَّاويُّونَ والكَهنةُ يَختمونَ.<verse eid="NEH 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="NEH 10:2" />والّذينَ خَتَموا هُمُ الحاكمُ نَحَمْيا بنُ حكَلْيا وصدقيَّا، <verse eid="NEH 10:2" /><verse number="3" style="v" pubnumber="3" sid="NEH 10:3" />والكهَنةُ سَرايا وعزَرْيا ويرْميا <verse eid="NEH 10:3" /><verse number="4" style="v" pubnumber="4" sid="NEH 10:4" />وفَشحورُ وأمَرْيا ومَلْكِيَّا <verse eid="NEH 10:4" /><verse number="5" style="v" pubnumber="5" sid="NEH 10:5" />وحطُّوشُ وشَبنْيا ومَلُّوخُ <verse eid="NEH 10:5" /><verse number="6" style="v" pubnumber="6" sid="NEH 10:6" />وحاريمُ ومَريموثُ وعُوبَدْيا <verse eid="NEH 10:6" /><verse number="7" style="v" pubnumber="7" sid="NEH 10:7" />ودانيالُ وجِنثونُ وباروخُ <verse eid="NEH 10:7" /><verse number="8" style="v" pubnumber="8" sid="NEH 10:8" />ومَشُلَّامُ وأبيَّا وميَّامينُ. <verse eid="NEH 10:8" /><verse number="9" style="v" pubnumber="9" sid="NEH 10:9" />ومَعَزْيا وبِلْجايُ وشَمَعْيا، <verse eid="NEH 10:9" /><verse number="10" style="v" pubnumber="10" sid="NEH 10:10" />واللَّاويُّونَ يشوعُ بنُ أزَنيا وبِنُّوي مِنْ بَني حينادادَ وقدميئيلُ، <verse eid="NEH 10:10" /><verse number="11" style="v" pubnumber="11" sid="NEH 10:11" />وأنسباؤُهُم شبَنْيا وهودِيَّا وقَليطا وفَلايا وحانانُ <verse eid="NEH 10:11" /><verse number="12" style="v" pubnumber="12" sid="NEH 10:12" />ومِيخا ورحوبُ وحشَبْيا <verse eid="NEH 10:12" /><verse number="13" style="v" pubnumber="13" sid="NEH 10:13" />وزكُّورُ وشَرَبْيا وشبَنْيا <verse eid="NEH 10:13" /><verse number="14" style="v" pubnumber="14" sid="NEH 10:14" />وهودِيَّا وباني وبَنينُو، <verse eid="NEH 10:14" /><verse number="15" style="v" pubnumber="15" sid="NEH 10:15" />ورؤساءُ الشَّعبِ فَرعوشُ وفَحَثُ ومُوآبُ وعِيلاَم وزَتُّو وباني <verse eid="NEH 10:15" /><verse number="16" style="v" pubnumber="16" sid="NEH 10:16" />وبُنِّيُّ وعَزْجَدُ وبيبايُ <verse eid="NEH 10:16" /><verse number="17" style="v" pubnumber="17" sid="NEH 10:17" />وأدونيَّا وبَغْوايُ وعادينُ <verse eid="NEH 10:17" /><verse number="18" style="v" pubnumber="18" sid="NEH 10:18" />وآطيرُ وحزَقيَّا وعَزُّورُ <verse eid="NEH 10:18" /><verse number="19" style="v" pubnumber="19" sid="NEH 10:19" />وهودِيَّا وحَشومُ وبيصايُ <verse eid="NEH 10:19" /><verse number="20" style="v" pubnumber="20" sid="NEH 10:20" />وحاريفُ وعناثوثُ ونيبايُ <verse eid="NEH 10:20" /><verse number="21" style="v" pubnumber="21" sid="NEH 10:21" />ومَجفيعاشُ ومَشُلَّامُ وحَزيرُ <verse eid="NEH 10:21" /><verse number="22" style="v" pubnumber="22" sid="NEH 10:22" />ومَشيزَبْئيلُ وصادوقُ ويدُّوعُ <verse eid="NEH 10:22" /><verse number="23" style="v" pubnumber="23" sid="NEH 10:23" />وفَلَطْيا وحانان وعَنايا <verse eid="NEH 10:23" /><verse number="24" style="v" pubnumber="24" sid="NEH 10:24" />وهُوشَعُ وحَنَنْيا وحَشوبُ <verse eid="NEH 10:24" /><verse number="25" style="v" pubnumber="25" sid="NEH 10:25" />وهَلوحِيشُ وفِلْحا وشوبيقُ <verse eid="NEH 10:25" /><verse number="26" style="v" pubnumber="26" sid="NEH 10:26" />ورَحومُ وحَشَبْنا ومَعْسِيا <verse eid="NEH 10:26" /><verse number="27" style="v" pubnumber="27" sid="NEH 10:27" />وأخِيَا وحانانُ وعانانُ <verse eid="NEH 10:27" /><verse number="28" style="v" pubnumber="28" sid="NEH 10:28" />ومَلُّوخُ وحَريمُ وبَعْنةُ.<verse eid="NEH 10:28" /></para>
  <para style="s1">نصُّ العهد</para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="NEH 10:29" />نحنُ، شعبَ إِسرائيلَ وسائرَ الكهَنةِ واللَّاويِّينَ والبوَّابينَ والمُغنِّينَ وخُدَّامَ الهَيكلِ وجميعَ الّذينَ اَنفردوا عَنْ شُعوبِ الأرضِ واَنحازوا إلى شريعةِ اللهِ معَ نِسائِهِم وبَنيهِم وبَناتِهِم مِمَّنْ لهُم معرِفةٌ وفَهمٌ، <verse eid="NEH 10:29" /><verse number="30" style="v" pubnumber="30" sid="NEH 10:30" />نتعهَّدُ معَ زعمائِنا ونُقسِمُ على أنْ نسلُكَ في شريعةِ اللهِ الّتي أُعطيت على لِسانِ موسى عبدِ اللهِ، ونحفَظَ جميعَ وصايا الرّبِّ إلهِنا وأحكامَهُ وفرائضَهُ ونعمَلُ بها، <verse eid="NEH 10:30" /><verse number="31" style="v" pubnumber="31" sid="NEH 10:31" />وأنْ لا نُعطيَ بناتِنا لشعوبِ الأرضِ ولا نأخذَ بناتِهِم لبنينا <verse eid="NEH 10:31" /><verse number="32" style="v" pubnumber="32" sid="NEH 10:32" />وأنْ لا نشتريَ في السَّبتِ ولا في يومٍ مُقدَّسٍ بِضاعةً أو مأكلًا مِنْ أممِ الأرضِ الّذينَ يَجيئونَ بها في يومِ السَّبتِ ليَبيعوا. <verse eid="NEH 10:32" /><verse number="33" style="v" pubnumber="33" sid="NEH 10:33" />ونحنُ نتعهَّدُ أيضًا أنْ نترُكَ غلَّةَ أرضِنا في السَّنةِ السَّابعةِ ولا نُطالبَ بأيِّ دَيْنٍ، وأنْ نفرضَ على أنفسِنا أنْ نُؤدِّيَ ثُلْثَ دِرْهَمٍ في السَّنةِ لِخِدمةِ هَيكلِ إلهِنا: <verse eid="NEH 10:33" /><verse number="34" style="v" pubnumber="34" sid="NEH 10:34" />لِخُبزِ القُربانِ، وللتَّقدِمةِ الدَّائِمةِ، وللمُحرقةِ الدَّائمةِ في السُّبوتِ ورؤوسِ الشُّهورِ والأعيادِ، وللأقداسِ وذبائحِ الخطيئةِ للتَّكفيرِ عَنْ بَني إِسرائيلَ، ولكُلِّ خِدمةٍ في هَيكلِ إلهِنا. <verse eid="NEH 10:34" /><verse number="35" style="v" pubnumber="35" sid="NEH 10:35" />أمَّا إدخالُ الحطَبِ إلى هَيكلِ إلهِنا للإيقادِ على المذبحِ، فنُلقي قُرَعًا بينَ الكهَنةِ واللَّاويِّينَ والشَّعبِ لإدخالِهِ بِحسَبِ عشائرِهِم في أوقاتٍ مُعيَّنةٍ، سنةً فسنةً، على ما هوَ مكتوبٌ في الشَّريعةِ. <verse eid="NEH 10:35" /><verse number="36" style="v" pubnumber="36" sid="NEH 10:36" />ونحنُ نتعهَّدُ أيضًا أنْ نَجيءَ ببواكيرِ أرضِنا وبواكيرِ ثمارِ كُلِّ شجَرٍ، سَنةً فسَنةً، إلى هَيكلِ الرّبِّ، <verse eid="NEH 10:36" /><verse number="37" style="v" pubnumber="37" sid="NEH 10:37" />وأنْ نُقَدِّمَ أبكارَ بَنينا وبهائِمِنا إلى هَيكلِ إلهِنا، للكهَنةِ الّذينَ يَخدمونَ فيهِ، على ما هوَ مكتوبٌ في الشَّريعةِ، وكذلِكَ أبكارَ بقَرِنا وغنَمِنا. <verse eid="NEH 10:37" /><verse number="38" style="v" pubnumber="38" sid="NEH 10:38" />أنْ نَحمِلَ إلى الكَهنةِ، إلى مَخازنِ هَيكلِ إلهِنا، أوائلَ عجينِنا وقرابينِنا وثمَرَ كُلِّ شجَرٍ، وأوائِلَ الخمرِ والزَّيتِ، وإلى اللَّاويِّينَ أعشارَ أرضِنا فيكونُ لهُمُ العُشْرُ في جميعِ مزارِعِنا، <verse eid="NEH 10:38" /><verse number="39" style="v" pubnumber="39" sid="NEH 10:39" />ويكونُ الكَهنَةُ أبناءُ هرونَ معَ اللَّاويِّين حينَ يجمعونَ العُشْرَ، على أنْ يُؤدِّيَ اللَّاويُّونَ عُشْرَ الأعشارِ لهَيكلِ إلهِنا لِتُخْزَنَ في المَخازِنِ <verse eid="NEH 10:39" /><verse number="40" style="v" pubnumber="40" sid="NEH 10:40" />الّتي إليها يَحمِلُ بَنو إِسرائيلَ وبَنو لاويّ بواكيرَ الحِنطةِ والخمرِ والزَّيتِ، حَيثُ تُحفَظُ الآنيةُ المُقَدَّسةُ ويُقيمُ الكهَنةُ والخُدَّامُ والبوَّابونَ والمُغنُّونَ، فنحنُ لا نُهمِلُ هَيكلَ إلهِنا.<verse eid="NEH 10:40" /></para>
  <chapter eid="NEH 10" />
  <chapter number="11" style="c" sid="NEH 11" />
  <para style="s1">الساكنون في أورشليم</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="NEH 11:1" />وسكَنَ زُعماءُ الشَّعبِ في أورُشليمَ، أمَّا سائرُ الشَّعبِ فألقَوا القُرْعةَ لاَختيارِ واحدٍ مِنْ عشَرَةٍ ليَسكُنَ في أورُشليمَ، المدينةِ المقدَّسةِ، على أنْ يَسكُنَ التِّسعةُ الباقونَ في المُدُنِ الأخرى. <verse eid="NEH 11:1" /><verse number="2" style="v" pubnumber="2" sid="NEH 11:2" />وباركَ الشَّعبُ جميعَ الّذين قدَّموا أنفسَهُم طَوعًا لِيَسكنوا في أورُشليمَ.<verse eid="NEH 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="NEH 11:3" />ففي المُدُنِ الأخرى بيَهوذا سكَنَ الشَّعبُ والكهَنةُ واللَّاويُّونَ وخُدَّامُ الهَيكلِ وبَنو عبيدِ سليمانَ، كُلُّ واحدٍ في مُلْكِهِ في مدينتهِ. هؤلاءِ أعيانُ البِلادِ الّذينَ سكنوا في أورُشليمَ، <verse eid="NEH 11:3" /><verse number="4" style="v" pubnumber="4" sid="NEH 11:4" />وهُم مِنْ بَني يَهوذا وبَني بَنيامينَ. فمِنْ بَني يَهوذا عَثايا بنُ عُزِّيَّا بنِ زكريَّا بنِ أمَرْيا بنِ شَفَطْيا بنِ مَهْلَلْئيلَ مِنْ بَني فارِصَ <verse eid="NEH 11:4" /><verse number="5" style="v" pubnumber="5" sid="NEH 11:5" />ومَعْسِيا بنُ باروخَ بنِ كلحوزَةَ بنِ حَزايا بنِ عَدايا بنِ يوياريبَ بنِ زكريَّا بنِ الشِّيلونيّ. <verse eid="NEH 11:5" /><verse number="6" style="v" pubnumber="6" sid="NEH 11:6" />جميعُ بَني فارصَ السَّاكنينَ في أورُشليمَ أربعُ مئَةٍ وثمانيةٌ وسِتُّونَ رجلًا مِنَ الأشدَّاءِ.<verse eid="NEH 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="NEH 11:7" />وهؤلاءِ بَنو بَنيامينَ: سلُّو بنُ مَشُلَّامَ بنِ يوعيدَ بنِ فَدايا بن قُولايا بنِ مَعْسِيا بنِ إيثيئيلَ بنِ يَشَعْيا، <verse eid="NEH 11:7" /><verse number="8" style="v" pubnumber="8" sid="NEH 11:8" />وبَعدَهُ جَبَّايُ سلَّايُ تِسعُ مئَةٍ وثمانيةٌ وعشرونَ <verse eid="NEH 11:8" /><verse number="9" style="v" pubnumber="9" sid="NEH 11:9" />وكانَ يوئيلُ بنُ زكري وكيلًا علَيهِم ويَهوذا بنُ هَسْنوآةَ ثانيًا على المدينةِ.<verse eid="NEH 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="NEH 11:10" />وسكنَ أورُشليمَ مِنَ الكهَنةِ يَدَعْيا بنُ يوياريبَ وياكينُ <verse eid="NEH 11:10" /><verse number="11" style="v" pubnumber="11" sid="NEH 11:11" />وسرايا بنُ حِلْقيَّا بنِ مَشُلامَ بنِ صادوقَ بنِ مرايوثَ بنِ أخيطوبَ، رئيسُ كَهنةِ هَيكلِ اللهِ، <verse eid="NEH 11:11" /><verse number="12" style="v" pubnumber="12" sid="NEH 11:12" />وهُم معَ أنسِبائِهِم ثماني مئَةٍ واَثنانِ وعشرونَ خادِمًا في هَيكلِ اللهِ، وعَدايا بنُ يروحامَ بنِ فلَلْيا بنِ أمْصي بنِ زكريَّا بنِ فشحورَ بنِ مَلْكيَّا، <verse eid="NEH 11:12" /><verse number="13" style="v" pubnumber="13" sid="NEH 11:13" />وهوَ معَ أنسبائِهِ مِنْ رؤساءِ العشائِرِ مئتانِ واَثنانِ وأربعونَ، وعمْشِسايُ بنُ عَزَرْئيلَ بنِ أخزايَ بنِ مَشْليموثَ بنِ إِمِّيرَ، <verse eid="NEH 11:13" /><verse number="14" style="v" pubnumber="14" sid="NEH 11:14" />وهوَ معَ أنسبائِهِ مئَةٌ وثمانيةٌ وعشرونَ رَجلًا مِنَ الجبابرةِ الأشدَّاءِ والوكيلُ علَيهِم زَبْديئيلُ بنُ هَجْدوليمَ.<verse eid="NEH 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="NEH 11:15" />وكانَ مِنَ اللَّاويِّينَ الّذينَ سكنوا أورُشليمَ شَمَعْيا بنُ حشوبَ بنِ عَزْريقامَ بنِ حَشَبْيا بنِ بُوني <verse eid="NEH 11:15" /><verse number="16" style="v" pubnumber="16" sid="NEH 11:16" />وشَبْتايُ ويوزابادُ، وهُما مِنْ رؤساءِ اللَّاويِّينَ القيِّمينَ على العمَلِ الخارجيِّ لهَيكلِ اللهِ. <verse eid="NEH 11:16" /><verse number="17" style="v" pubnumber="17" sid="NEH 11:17" />ومَتَّنْيا بنُ مِيخا بنِ زَبْدي بنِ آسافَ، وهوَ رئيسُ جَوقةِ التَّهليلِ بحَمدِ اللهِ في الصَّلاةِ، وبقْبُقيا مساعِدُهُ مِنْ بَينِ أنسبائِهِ وعَبْدا بنُ شمُّوعَ بنِ جَلالَ بنِ يَدُوثُونَ. <verse eid="NEH 11:17" /><verse number="18" style="v" pubnumber="18" sid="NEH 11:18" />وجميعُ هؤلاءِ اللَّاويِّينَ السَّاكنينَ في أورُشليمَ، المدينةِ المُقدَّسةِ، مِئتانِ وثمانيةٌ وأربعونَ، <verse eid="NEH 11:18" /><verse number="19" style="v" pubnumber="19" sid="NEH 11:19" />والبوَّابونَ عقُّوبُ وطلمونُ وأنسباؤُهُما حارِسو الأبوابِ مئَةٌ واَثنانِ وسَبعونَ.<verse eid="NEH 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="NEH 11:20" />وكانَ سائرُ بَني إِسرائيلَ مِنَ الكَهنَةِ واللَّاويِّينَ يَسكنونَ في مُدُنِ يَهوذا، كُلُّ واحدٍ في مُلْكِهِ. <verse eid="NEH 11:20" /><verse number="21" style="v" pubnumber="21" sid="NEH 11:21" />وأمَّا خُدَّامُ الهَيكلِ فَسكنوا في تَلَّةِ عَوفلَ بأورُشليمَ، وكانَ صيحا وجِشفا وكيلَينِ علَيهِم. <verse eid="NEH 11:21" /><verse number="22" style="v" pubnumber="22" sid="NEH 11:22" />وكانَ وكيل اللَّاويِّينَ في أورُشليمَ على خِدمَةِ هَيكلِ اللهِ عُزِّي بنَ بانيَ بنِ حشَبْيا بنِ متَّنْيا بنِ مِيخا مِنْ بَني آسافَ المُغنِّينَ <verse eid="NEH 11:22" /><verse number="23" style="v" pubnumber="23" sid="NEH 11:23" />لأنَّ وصيَّةَ المَلِكِ فرَضَتْ على هؤلاءِ المُغنّينَ أنْ يتناوبوا على الغِناءِ في هَيكلِ الرّبِّ كُلَّ يومٍ. <verse eid="NEH 11:23" /><verse number="24" style="v" pubnumber="24" sid="NEH 11:24" />وكانَ فَتَحْيا بنُ مَشيزَبْئيلَ مِنْ بَني زارَحَ بنِ يَهوذا مُستشارَ مَلِكِ الفُرسِ في كُلِّ أمورِ الشَّعبِ.<verse eid="NEH 11:24" /></para>
  <para style="s1">الساكنون في المدن الأخرى</para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="NEH 11:25" />وفي القُرى معَ حُقولِها سكنَ مِنْ بَني يَهوذا في قريةِ أربعَ وتوابعِها وديبونَ وتوابِعها ويَقبْصَئيل وقُراها. <verse eid="NEH 11:25" /><verse number="26" style="v" pubnumber="26" sid="NEH 11:26" />وسكنَ مِنهُم في قُرى يشوعَ ومُولادةَ وبَيتَ فالَطَ <verse eid="NEH 11:26" /><verse number="27" style="v" pubnumber="27" sid="NEH 11:27" />وحَصرِ شوعالَ وبِئرَ سبعَ وتوابِعِها. <verse eid="NEH 11:27" /><verse number="28" style="v" pubnumber="28" sid="NEH 11:28" />وفي صَقلغَ ومكونَةَ وتوابِعها، <verse eid="NEH 11:28" /><verse number="29" style="v" pubnumber="29" sid="NEH 11:29" />وفي عينَ رمُّونَ وصرعةَ ويرموثَ <verse eid="NEH 11:29" /><verse number="30" style="v" pubnumber="30" sid="NEH 11:30" />وزانوحَ وعَدلَّامَ وقُراهما، وفي لَخيشَ وحقولِها وعزيقةَ وقُراها وبذلِكَ سكنوا مِنْ بِئرَ سبعَ إلى وادي هِنُّومَ.<verse eid="NEH 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" pubnumber="31" sid="NEH 11:31" />وسكنَ بَنو بَنيامينَ مِنْ جَبعَ إلى مِخْماسَ وعيَّا وبيتَ إيلَ وتوابِعها <verse eid="NEH 11:31" /><verse number="32" style="v" pubnumber="32" sid="NEH 11:32" />وعناثوثَ ونوبٍ وعَنَنْيةَ <verse eid="NEH 11:32" /><verse number="33" style="v" pubnumber="33" sid="NEH 11:33" />وحاصورَ ورامةَ وجتَّايِمَ <verse eid="NEH 11:33" /><verse number="34" style="v" pubnumber="34" sid="NEH 11:34" />وحاديدَ وصَبوعِيمَ ونبَلَّاطَ <verse eid="NEH 11:34" /><verse number="35" style="v" pubnumber="35" sid="NEH 11:35" />ولودٍ وأونو وادي الصُّنَّاعِ <verse eid="NEH 11:35" /><verse number="36" style="v" pubnumber="36" sid="NEH 11:36" />وكانَ مِنَ اللَّاويِّينَ في أرضِ يَهوذا مَنِ اَنتقلوا للسَّكنِ في أرضِ بنيامينَ.<verse eid="NEH 11:36" /></para>
  <chapter eid="NEH 11" />
  <chapter number="12" style="c" sid="NEH 12" />
  <para style="s1">أسماء الكهنة واللاويين</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="NEH 12:1" />وهؤلاءِ همُ الكهَنةُ واللَّاويُّونَ الّذينَ صَعِدوا معَ زَربَّابِلَ بنِ شألتئيلَ ويشوعَ رئيسِ الكَهنةِ: سَرايا ويرْميا وعَزرا <verse eid="NEH 12:1" /><verse number="2" style="v" pubnumber="2" sid="NEH 12:2" />وأمَرْيا ومَلَّوخُ وحَطُّوشُ <verse eid="NEH 12:2" /><verse number="3" style="v" pubnumber="3" sid="NEH 12:3" />وشكَنْيا ورحومُ ومَريموثُ <verse eid="NEH 12:3" /><verse number="4" style="v" pubnumber="4" sid="NEH 12:4" />وعِدُّو وجِنْتويُ وأبيَّا <verse eid="NEH 12:4" /><verse number="5" style="v" pubnumber="5" sid="NEH 12:5" />وميَّامينُ ومَعَدْيا وبلْجةُ <verse eid="NEH 12:5" /><verse number="6" style="v" pubnumber="6" sid="NEH 12:6" />وشمَعْيا ويوياريبُ ويَدَعْيا <verse eid="NEH 12:6" /><verse number="7" style="v" pubnumber="7" sid="NEH 12:7" />وسلُّو وعاموقُ وحِلْقيَّا ويَدَعْيا. هؤلاءِ هُم رؤوسُ الكهَنةِ وأنسباؤُهُم في أيّامِ يشوعَ.<verse eid="NEH 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="NEH 12:8" />واللَّاويُّونَ: يشوعُ وبنُّويُ وقَدميئيلُ وشَرَبْيا ويَهوذا ومَتَّنْيا الّذي كانَ يَتَولَّى التَّهليلَ بِحَمدٍ للهِ وأنسباؤُهُ <verse eid="NEH 12:8" /><verse number="9" style="v" pubnumber="9" sid="NEH 12:9" />وبَقبقْيا وعُنِّي اللَّذانِ وقَفا مُقابِلَهُم في الحِراسةِ. <verse eid="NEH 12:9" /><verse number="10" style="v" pubnumber="10" sid="NEH 12:10" />ويشوعُ رئيسُ الكَهنَةِ ولَدَ يُوياقيمَ ويُوياقيمُ ولَدَ ألياشيبَ وألياشيبُ ولَدَ يُوياداعَ <verse eid="NEH 12:10" /><verse number="11" style="v" pubnumber="11" sid="NEH 12:11" />ويُوياداعُ ولَدَ يوناثانَ ويُوناثانُ ولَدَ يدُّوعَ.<verse eid="NEH 12:11" /></para>
  <para style="s1">رؤساء عشائر الكهنة</para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="NEH 12:12" />وفي أيّامِ يُوياقيمَ كانَ هؤلاءِ الكهَنةُ رؤساءَ عشائِرِهِم: لعشيرةِ سَرايا مَرايا، وليَرْميا حَنَنْيا، <verse eid="NEH 12:12" /><verse number="13" style="v" pubnumber="13" sid="NEH 12:13" />ولِعَزْرا مَشُلامُ، ولأمَرْيا يهوحانانُ، <verse eid="NEH 12:13" /><verse number="14" style="v" pubnumber="14" sid="NEH 12:14" />ولمَليكو يوناثانُ، ولشَبْنيا يوسُفُ، <verse eid="NEH 12:14" /><verse number="15" style="v" pubnumber="15" sid="NEH 12:15" />ولِحَريمَ عَدْنا، ولمَرايوثَ حَلْقايُ، <verse eid="NEH 12:15" /><verse number="16" style="v" pubnumber="16" sid="NEH 12:16" />ولعِدُّو زكريَّا، ولحِنُّثونَ مَشُلَّامُ، <verse eid="NEH 12:16" /><verse number="17" style="v" pubnumber="17" sid="NEH 12:17" />ولأبيَّا زِكْري، ولمِنْيامينَ ومُوعِديا فِلْطايُ، <verse eid="NEH 12:17" /><verse number="18" style="v" pubnumber="18" sid="NEH 12:18" />ولِبلْجةَ شَمُّوعُ، ولِشَمَعْيا يهوناثانُ، <verse eid="NEH 12:18" /><verse number="19" style="v" pubnumber="19" sid="NEH 12:19" />وليوياريبَ مَتْنايُ، وليَدَعْيا عُزِّي، <verse eid="NEH 12:19" /><verse number="20" style="v" pubnumber="20" sid="NEH 12:20" />ولِسَلَّايَ فَلَّايُ، ولعامُوقَ عابِرُ، <verse eid="NEH 12:20" /><verse number="21" style="v" pubnumber="21" sid="NEH 12:21" />ولِحِلْقيَّا حَشَبْيا وليَدَعْيا نثَنَئيلُ.<verse eid="NEH 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="NEH 12:22" />وكانَ رؤساءُ عشائرِ اللَّاويِّينَ في أيّامِ ألياشيبَ ويُوياداعَ ويُوحانانَ ويَدُّوعَ مُدوَّنينَ في سِفْرِ أخبارِ الأيّامِ، وكذلِكَ الكهَنةُ، في أيّامِ داريوسَ الفارسيِّ. <verse eid="NEH 12:22" /><verse number="23" style="v" pubnumber="23" sid="NEH 12:23" />وأمَّا رؤساءُ عشائرِ اللَّاويِّينَ فلم يُدَوَّنوا إلَّا في أيّامِ يوحانانَ بنِ ألياشيبَ.<verse eid="NEH 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="NEH 12:24" />وكانَ رؤساءُ اللَّاويِّينَ: حَشَبْيا وشَرَبْيا ويشوعُ بنُ قَدمئيلَ وأنسباؤُهُم فِرْقةً تَتبادلُ الحَمدَ والتَّهليلَ في هَيكلِ اللهِ بِحسَبِ وصيَّةِ داوُدَ رجلِ اللهِ. <verse eid="NEH 12:24" /><verse number="25" style="v" pubnumber="25" sid="NEH 12:25" />وكانَ مَتَّنيا وبَقْبقْيا وعُوبَديا ومَشُلَّامُ وطَلْمونُ وعَقُّوبُ بوَّابينَ يتولَّونَ الحِراسةَ عِندَ دهاليزِ الأبوابِ. <verse eid="NEH 12:25" /><verse number="26" style="v" pubnumber="26" sid="NEH 12:26" />هؤلاءِ كانوا في أيّامِ يُوياقيمَ بنِ يشوعَ بنِ يُوصاداقَ، وفي أيّامِ نَحَمْيا الحاكمِ، وعزرا الكاهنِ العالِمِ بالشَّريعةِ.<verse eid="NEH 12:26" /></para>
  <para style="s1">تدشين سور أورشليم</para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="NEH 12:27" />فلمَّا دُشِّنَ سُورُ أورُشليمَ دُعي اللَّاويُّونَ مِنْ جميعِ أماكِنِهِم لِلحُضورِ إلى أورُشليمَ ليُدَشِّنوا بالفَرحِ والتَّسبيحِ والغِناءِ، على أنغامِ الصُّنوجِ والرَّبابِ والقياثيرِ. <verse eid="NEH 12:27" /><verse number="28" style="v" pubnumber="28" sid="NEH 12:28" />فاَجتَمعَ المُغنُّونَ بَنو لاويّ مِنْ ضواحي أورُشليمَ ومِنْ قُرى النَّطوفيِّينَ <verse eid="NEH 12:28" /><verse number="29" style="v" pubnumber="29" sid="NEH 12:29" />ومِنْ بَيتِ الجِلْجالِ وحُقولِ جبَعَ وعَزْموتَ، لأنَّ المُغنِّينَ كانوا بَنوا لهُم قُرىً حَولَ أورُشليمَ. <verse eid="NEH 12:29" /><verse number="30" style="v" pubnumber="30" sid="NEH 12:30" />وتَطهَّرَ الكهَنةُ واللَّاويُّونَ بِحسَبِ الشَّريعةِ وكذلِكَ طَهَّروا الشَّعبَ والأبوابَ والسُّورَ.<verse eid="NEH 12:30" /></para>
  <para style="p">
    <verse number="31" style="v" pubnumber="31" sid="NEH 12:31" />فأصْعَدتُ أعيانَ يَهوذا على السُّورِ وعَيَّنْتُ فِرْقتينِ عظيمَتَينِ للتَّسبيحِ للهِ. فسارتِ الأُولى جِهةَ اليمينِ على السُّورِ نحو بابِ الزِّبْلِ. <verse eid="NEH 12:31" /><verse number="32" style="v" pubnumber="32" sid="NEH 12:32" />وبَعدَها سارَ هوشَعْيا ونِصفُ زُعماءِ يَهوذا. <verse eid="NEH 12:32" /><verse number="33" style="v" pubnumber="33" sid="NEH 12:33" />وعزَرْيا وعزرا ومَشُلَّامُ <verse eid="NEH 12:33" /><verse number="34" style="v" pubnumber="34" sid="NEH 12:34" />ويَهوذا وبَنيامينُ وشمَعْيا وإِرْميا. <verse eid="NEH 12:34" /><verse number="35" style="v" pubnumber="35" sid="NEH 12:35" />وسارَ بَنو الكهَنةِ الحامِلونَ الأبواقَ وهُم زكريَّا بنُ يُوناثانَ بنِ شَمَعْيا بنِ مَتَّنْيا بنِ ميخايا بنِ زكُّورَ بنِ آسافَ <verse eid="NEH 12:35" /><verse number="36" style="v" pubnumber="36" sid="NEH 12:36" />وأنسِباؤُه شَمَعْيا وعَزَرْئيلُ ومِلَلايُ وجِلَلايُ وماعايُ ونَثَنئيلُ ويَهوذا وحناني، وهُم حاملونَ آلاتِ الألحانِ الّتي أقَرَّها داوُدُ رجُلُ اللهِ، يتَقَدَّمُهُم عزرا العالِمُ بالشَّريعةِ. <verse eid="NEH 12:36" /><verse number="37" style="v" pubnumber="37" sid="NEH 12:37" />فصَعِدوا عِندَ بابِ العَينِ الّذي مُقابِلَهُم على دَرَجِ مدينةِ داوُد عِندَ مَطْلعِ السُّورِ، فوقَ بَيتِ داوُدَ، إلى بابِ المياهِ جِهَةَ المَشرقِ. <verse eid="NEH 12:37" /><verse number="38" style="v" pubnumber="38" sid="NEH 12:38" />وسارَت فِرْقةُ التَّسبيحِ الأخرى قُبالَتَهُم، وأنا وَراءَها، ونِصفُ الشَّعبِ على السُّورِ مِنْ عِندِ بُرْجِ التَّنانيرِ إلى السُّورِ العريضِ. <verse eid="NEH 12:38" /><verse number="39" style="v" pubnumber="39" sid="NEH 12:39" />ومِنْ فوقِ بابِ أفرايمَ والبابِ العتيقِ وبابِ السَّمَكِ وبُرجِ حَنَنئيلَ وبُرجِ المِئةِ إلى بابِ الغنَمِ، ووقفوا في بابِ السِّجنِ. <verse eid="NEH 12:39" /><verse number="40" style="v" pubnumber="40" sid="NEH 12:40" />ووقَفَت فِرْقتا التَّسبيحِ في بَيتِ اللهِ، وأنا نِصفُ الزُّعَماءِ معي، <verse eid="NEH 12:40" /><verse number="41" style="v" pubnumber="41" sid="NEH 12:41" />وكذلِكَ الكهَنةُ ألياقيمُ ومَعْسِيا ومِنْيامينُ وميخايا وألوعينايُ وزكريَّا وحَنَنْيا، وهُم حاملونَ الأبواقَ، <verse eid="NEH 12:41" /><verse number="42" style="v" pubnumber="42" sid="NEH 12:42" />ومَعْسِيا وشَمَعْيا وألعازارُ وعُزِّي ويُوحانانُ ومَلْكِيَّا وعيلامُ وعازرُ. وغنَّى المُغنُّونَ بأصواتِهِم يقودُهُم يزرَحْيا. <verse eid="NEH 12:42" /><verse number="43" style="v" pubnumber="43" sid="NEH 12:43" />وفي ذلِكَ اليومِ ذبَحوا ذبائِحَ عظيمةً وفرِحوا لأنَّ اللهَ فَرَّحَهُم فرَحًا عظيمًا، وفرِحَتِ النِّساءُ والأولادُ، وسُمِعَ فرَحُ أورُشليمَ مِنْ مسافةٍ بعيدةٍ.<verse eid="NEH 12:43" /></para>
  <para style="p">
    <verse number="44" style="v" pubnumber="44" sid="NEH 12:44" />وأُقيمَ في ذلِكَ اليومِ رِجالٌ على الغُرَفِ الّتي تُخزَنُ فيها القرابينُ والبواكيرُ والعُشورُ، ليجمعوا مِنْ حُقولِ المُدُنِ ما جعَلَتْهُ الشَّريعةُ مِنْ نصيبِ الكهَنةِ واللَّاويِّينَ، لأنَّ بَني يَهوذا فرِحوا بالكهَنةِ واللَّاويِّينَ القائمينَ بعمَلِهِم <verse eid="NEH 12:44" /><verse number="45" style="v" pubnumber="45" sid="NEH 12:45" />في خِدمةِ إلهِهِم ومراسِمِ التَّطهيرِ وتقيَّدَ البوَّابونَ والمُغنُّونَ بما أمرَ بهِ داوُدُ وسليمانُ اَبنُهُ. <verse eid="NEH 12:45" /><verse number="46" style="v" pubnumber="46" sid="NEH 12:46" />فمِنَ القديمِ مِنْ أيّامِ داوُدَ وآسافَ، تمَّ ترتيبُ رؤساءِ المُغَنّينَ وأغاني التَّسبيحِ والاعتراف للهِ. <verse eid="NEH 12:46" /><verse number="47" style="v" pubnumber="47" sid="NEH 12:47" />وكانَ جميعُ بَني إِسرائيلَ في أيّامِ زرُبَّابِلَ ونَحَمْيا يُؤدُّونَ ما علَيهِم للمُغنِّينَ والبوَّابينَ، كُلَّ يومٍ في يَومِهِ. وكانوا يُقدِّمونَ إلى اللَّاويِّينَ عطاياهُمُ المُكَرَّسةَ للرّبِّ، واللَّاويُّونَ يُقدِّمونَ مِنها إلى الكهَنةِ بَني هرونَ.<verse eid="NEH 12:47" /></para>
  <chapter eid="NEH 12" />
  <chapter number="13" style="c" sid="NEH 13" />
  <para style="s1">نحميا وما قام به من إصلاح</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="NEH 13:1" />وفي ذلِكَ اليومِ قُرِئَ في كتابِ موسى على مَسامعِ الشَّعبِ فَوُجدَ فيهِ مكتوبًا أنْ لا يدخلَ العمُّونيُّونَ ولا المُوآبيُّونَ في جماعةِ اللهِ إلى الأبدِ، <verse eid="NEH 13:1" /><verse number="2" style="v" pubnumber="2" sid="NEH 13:2" />لأنَّهُم لم يستَقبلوا بَني إِسرائيلَ بالخبزِ والماءِ، بلِ اَستأجروا علَيهِم بلْعامَ ليلْعَنَهُم فحَوَّلَ إلهنا اللَّعنَةَ بَركَةً. <verse eid="NEH 13:2" /><verse number="3" style="v" pubnumber="3" sid="NEH 13:3" />فلمَّا سمِعوا ما تقولُ الشَّريعةُ فرَزوا كُلَّ دخيلٍ مِنْ بَني إِسرائيلَ.<verse eid="NEH 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="NEH 13:4" />وكانَ ألياشيبُ الكاهنُ مُولَّى قبلَ ذلِكَ على خزينةِ هَيكلِ إلهِنا وهوَ مِنْ أقرِباءِ طوبيَّا، <verse eid="NEH 13:4" /><verse number="5" style="v" pubnumber="5" sid="NEH 13:5" />فهيَّأَ لطوبيَّا غُرْفةً عظيمةً توضَعُ فيها التَّقدِمةُ والبَخورُ والآنيةُ وعُشورُ الحِنطةِ والخمرِ والزَّيتِ، وهذِهِ فريضَةُ الشَّعبِ للَّاويِّينَ والمُغنِّينَ والبوَّابينَ وتقدِمَتُهُم للكهَنةِ. <verse eid="NEH 13:5" /><verse number="6" style="v" pubnumber="6" sid="NEH 13:6" />وفي هذِهِ المُدَّةِ كُلِّها لم أكُنْ أنا في أورُشليمَ لأنِّي في السَّنةِ الثَّانيةِ والثَّلاثينَ لأرتحشَشتا، مَلِكِ بابلَ، دخلْتُ على المَلِكَ، وبَعدَ أيّامٍ اَستأذنتُ مِنهُ <verse eid="NEH 13:6" /><verse number="7" style="v" pubnumber="7" sid="NEH 13:7" />وعُدْتُ إلى أورُشليمَ وعَلِمتُ بالشَّرِّ الّذي فعلَهُ ألياشيبُ حينَ أعدَّ لطوبيَّا غُرْفةً في دُورِ هَيكلِ اللهِ. <verse eid="NEH 13:7" /><verse number="8" style="v" pubnumber="8" sid="NEH 13:8" />فأغضَبَني ذلِكَ جِدًّا وطرحتُ جميعَ آنيةِ بيتِ طوبيَّا مِنَ الغرفةِ خارجًا، <verse eid="NEH 13:8" /><verse number="9" style="v" pubnumber="9" sid="NEH 13:9" />وأمرتُ فطَهَّروا الغُرَفَ، وأعدْتُ إلى هناكَ آنيةَ هَيكلِ اللهِ معَ البَخورِ والتَّقدِمةِ للكهَنةِ.<verse eid="NEH 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="NEH 13:10" />وعلِمْتُ أيضًا أنَّ نصيبَ اللَّاويِّينَ والمُغَنِّينَ مِنْ عُشورِ الحِنطةِ والخمرِ والزّيتِ لم يُعطَ لهُم. فتركوا الخِدمةَ واَنصَرَفوا، كُلُّ واحدٍ إلى أرضِهِ. <verse eid="NEH 13:10" /><verse number="11" style="v" pubnumber="11" sid="NEH 13:11" />فخاصمْتُ وُلاةَ الأمرِ وقُلتُ ”لماذا أهملْتم هَيكلَ اللهِ؟“ ثمَّ جمَعْتُ اللَّاويِّينَ والمغنِّينَ وأعدْتُهُم إلى عمَلِهِم. <verse eid="NEH 13:11" /><verse number="12" style="v" pubnumber="12" sid="NEH 13:12" />ورفَعَ جميعُ شعبِ يَهوذا عُشْرَ الحِنطةِ والخمرِ والزَّيتِ إلى الخزائنِ، <verse eid="NEH 13:12" /><verse number="13" style="v" pubnumber="13" sid="NEH 13:13" />فأقمتُ حُرَّاسًا على الخزائِنِ وهُم شَلَمْيا الكاهِنُ وصادوقُ العالِمُ بالشَّريعةِ وفدَايا اللَّاويُّ ومعَهُم حانانُ بنُ زكُّورَ بنِ متَّنيا، لأنَّهُم كانوا يُعَدُّونَ مِنَ الأمَناءِ ويتولَّونَ التَّوزيعَ على أنسِبائِهِم. <verse eid="NEH 13:13" /><verse number="14" style="v" pubnumber="14" sid="NEH 13:14" />فاَذكُرني يا اللهُ لهذا، ولا تنسَ كم أحسَنْتُ إلى هَيكلِكَ يا إلهي وحَفِظْتُ فرائِضَكَ<verse eid="NEH 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="NEH 13:15" />وفي تِلكَ الأيّامِ رأيتُ في يَهوذا قومًا يَدوسونَ العِنبَ في المعاصِرِ في السَّبْتِ، وآخرينَ يَجيئونَ بأكداسٍ مِنَ القَمحِ يُحَمِّلونَها على الحميرِ، وبِخمرٍ أيضًا وعِنبٍ وتينٍ وما إلى ذلِكَ، ويدخلونَ بهِ أورُشليمَ فأنذرتُهُم أنْ لا يَبيعوا شيئًا في السَّبْتِ. <verse eid="NEH 13:15" /><verse number="16" style="v" pubnumber="16" sid="NEH 13:16" />وكانَ الصُّوريُّونَ المُقيمونَ بأورُشليمَ يجلبونَ السَّمَكَ وكُلَّ نوعٍ مِنَ المبيعاتِ ويَبيعونَ في يومِ السَّبْتِ لبَني يَهوذا. <verse eid="NEH 13:16" /><verse number="17" style="v" pubnumber="17" sid="NEH 13:17" />فخاصمْتُ وُلاةَ الأمرِ في يَهوذا وقُلتُ لهُم: ”ما هذا الشَّرُّ الّذي تفعلونَهُ وتُدَنِّسونَ يومَ السَّبْتِ؟ <verse eid="NEH 13:17" /><verse number="18" style="v" pubnumber="18" sid="NEH 13:18" />أما فعَلَ آباؤُكُم هكذا، فجَلَبَ إلهُنا كُلَّ هذا الشَّرِّ علَينا وعلى هذِهِ المدينةِ؟“ <verse eid="NEH 13:18" /><verse number="19" style="v" pubnumber="19" sid="NEH 13:19" />وأمرتُ بإغلاقِ أبوابِ أورُشليمَ قَبلَ كُلِّ سَبتٍ عِندَ حُلولِ الظَّلامِ وأوصَيتُ بأنْ لا تُفتَحَ إلَّا بَعدَ السَّبْتِ، وأقَمتُ بَعضَ رِجالي على الأبوابِ لِئلَّا يدخُلَ أحَدٌ بِحِمْلٍ في يومِ سبتٍ. <verse eid="NEH 13:19" /><verse number="20" style="v" pubnumber="20" sid="NEH 13:20" />فباتَ التُّجَّارُ وباعةُ جميعِ البضائعِ خارجَ أورُشليمَ مرَّةً أو مرَّتينِ. <verse eid="NEH 13:20" /><verse number="21" style="v" pubnumber="21" sid="NEH 13:21" />فأنذرتُهُم وقلتُ لهُم: ”لماذا تَبيتونَ ليلتَكُم أمامَ السُّورِ؟ لا نَفْعَ مِنِ اَنتظارِكُم طُلوعَ الصَّباحِ. إنْ عُدتُم إلى ذلِكَ فإنِّي أقبضُ علَيكُم“. فمِنْ ذلِكَ الوقتِ لم يعودوا يأتونَ في السَّبْتِ. <verse eid="NEH 13:21" /><verse number="22" style="v" pubnumber="22" sid="NEH 13:22" />وأمرتُ اللَّاويِّينَ بأنْ يتَطَهَّروا بِحسَبِ الشَّريعةِ ويجيئوا ويحرُسوا الأبوابَ حِرْصًا على قداسةِ السَّبْتِ.</para>
  <para style="p" vid="NEH 13:22">اَذكُرني يا اللهُ لهذا أيضًا، واَرحَمْني بِعظيمِ رحمتِكَ.<verse eid="NEH 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="NEH 13:23" />وفي تِلكَ الأيّامِ أيضًا رأيتُ يَهودًا تَزَوَّجوا نِساءً أشدوديَّاتٍ وعمُّونيَّاتٍ وموآبيَّاتٍ، <verse eid="NEH 13:23" /><verse number="24" style="v" pubnumber="24" sid="NEH 13:24" />وكانَ كلامُ أولادِهِم خليطًا مِنْ لُغةِ أشدودَ وسِواها، وما كانوا يُحسِنونَ التكَلُّمَ باليهوديَّةِ. <verse eid="NEH 13:24" /><verse number="25" style="v" pubnumber="25" sid="NEH 13:25" />فخاصَمْتُهُم ولعنْتُهُم وضَربتُ مِنهُم رِجالًا ونَتفْتُ شعرَهُم، واَستَحلَفتُهُم باللهِ أنْ لا يُعطُوا بَناتِهِم لهؤلاءِ الغُرباءِ ولا يأخذوا بَناتِهِم لبَنيهِم ولا لهُم. <verse eid="NEH 13:25" /><verse number="26" style="v" pubnumber="26" sid="NEH 13:26" />وقُلتُ لهُم: ”أما بهذا خَطِئَ سليمانُ مَلِكُ إِسرائيلَ؟ لم يكُنْ في كثيرٍ مِنَ الأمَمِ مَلِكٌ مِثلُهُ، وكانَ مَحبوبًا عِندَ اللهِ فأقامَهُ اللهُ مَلِكًا على جميعِ شعبِ إِسرائيلَ، ومعَ ذلِكَ كانتِ النِّساءُ الأجنَبيَّاتُ سبيلًا لَه إلى الخطيئةِ. <verse eid="NEH 13:26" /><verse number="27" style="v" pubnumber="27" sid="NEH 13:27" />أفنَسْكُتُ لكُم على فِعْلِ هذا الشَّرِّ العظيمِ كُلِّهِ ونخونُ إلهَنا بتَزَوُّجِ النِّساءِ الأجنبيَّاتِ؟“<verse eid="NEH 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="NEH 13:28" />وكانَ واحدٌ مِنْ بَني يُوياداعَ بنِ ألياشيبَ الكاهنِ العظيمِ صِهْرًا لسنْبَلَّطَ الحُوروني، فطَرَدْتُهُ مِنْ عِندي، مِنْ أورُشليمَ.<verse eid="NEH 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="NEH 13:29" />اَذكُرْ يا إلهي وعاقِبْ جميعَ الّذينَ دَنَّسوا الكهَنوتَ وعَهدَك للكهَنةِ واللَّاويِّينَ.<verse eid="NEH 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="NEH 13:30" />أمَّا أنا فَطهَّرتُ الشَّعبَ مِنْ كُلِّ غريبٍ ووضَعْتُ نِظامًا للكهَنةِ واللَّاويِّينَ، كُلُّ واحدٍ في خِدمَتِهِ، <verse eid="NEH 13:30" /><verse number="31" style="v" pubnumber="31" sid="NEH 13:31" />ورَتَّبتُ طريقَةَ التَّبرُّعِ بالحَطَبِ لمَذْبَحِ هَيكلِ اللهِ في الأوقاتِ المُعيَّنةِ وتقدِمةِ بواكيرِ الغِلالِ.</para>
  <para style="p" vid="NEH 13:31">فاَذكُرني يا إلهي بالخيرِ.<verse eid="NEH 13:31" /></para>
  <chapter eid="NEH 13" />
</usx>