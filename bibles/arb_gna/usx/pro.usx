  <para style="toc3">أم</para>
  <para style="toc1">الأمثال</para>
  <para style="toc2">أمثال</para>
  <para style="mt1">الأمثال</para>
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="s1">غاية الأمثال</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 1:1" />هذِهِ أمثالُ سُليمانَ بنِ داوُدَ مَلِكِ إِسرائيلَ،<verse eid="PRO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 1:2" />وغايتُها أنْ تُعَرِّفَكَ الحِكمةَ وحُسنَ الرَّأيِ وتُبَيِّنَ لكَ الكَلامَ المُبينَ،<verse eid="PRO 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 1:3" />وأنْ تُعَلِّمَكَ مَشورَةَ العُقلاءِ</para>
  <para style="p" vid="PRO 1:3">والحَقَّ والعَدلَ والاستِقامةَ،<verse eid="PRO 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 1:4" />وأنْ تهَبَ الفِتيانَ تعقُّلًا</para>
  <para style="p" vid="PRO 1:4">والشَّبابَ معرِفةً وتدبيرًا.<verse eid="PRO 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 1:5" />يسمَعُها الحكيمُ فيزدادُ عِلْمًا</para>
  <para style="p" vid="PRO 1:5">والفهيمُ فيكتَسِبُ هِدايةً<verse eid="PRO 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 1:6" />ويتَبَيَّنُ الأمثالَ وسِرَّ مَعانيها</para>
  <para style="p" vid="PRO 1:6">وأقوالَ الحُكماءِ وأحاجيَّهُم،<verse eid="PRO 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 1:7" />فرأسُ المعرِفةِ مخافةُ الرّبِّ،</para>
  <para style="p" vid="PRO 1:7">والحَمقى يحتَقرونَ الحِكمةَ والفهْمَ.<verse eid="PRO 1:7" /></para>
  <para style="s1">نصائح للشباب</para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 1:8" />إسمَعْ، يا اَبني مَشورَةَ أبيكَ</para>
  <para style="p" vid="PRO 1:8">ولا تُهمِلْ نَصيحةَ أُمِّكَ.<verse eid="PRO 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 1:9" />إكليلُ نِعمةٍ هُما لِرأسِكَ</para>
  <para style="p" vid="PRO 1:9">وقلائِدُ بركَةٍ لعُنُقِكَ.<verse eid="PRO 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 1:10" />إنْ أغراكَ الخاطِئونَ يا اَبني،</para>
  <para style="p" vid="PRO 1:10">فإيَّاكَ أنْ تَقبلَ إغراءَهُم.<verse eid="PRO 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 1:11" />إنْ قالوا: تعالَ نكمُنْ لِلقَتلِ</para>
  <para style="p" vid="PRO 1:11">ونتَرَقَّبْ ضَحيَّةً بريئةً،<verse eid="PRO 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 1:12" />فنبتَلِعُهُم كالهاويةِ وهُم أحياءُ</para>
  <para style="p" vid="PRO 1:12">كالقبرِ وهُم هابِطونَ أصِحَّاءُ،<verse eid="PRO 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 1:13" />فنَحظى بكلِّ شيءٍ نفيسٍ</para>
  <para style="p" vid="PRO 1:13">ونَملأَ بُيوتَنا غنائِمَ،<verse eid="PRO 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 1:14" />ويكونَ حَظُّكَ كحظِّنا،</para>
  <para style="p" vid="PRO 1:14">ولجميعِنا كيسٌ واحدٌ.<verse eid="PRO 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 1:15" />لا تَسِرْ حيثُما يَسيرونَ.</para>
  <para style="p" vid="PRO 1:15">واَمنَعْ قدَمَيكَ عن سُبُلِهِم.<verse eid="PRO 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 1:16" />خطَواتُهُم تسيرُ إلى الشَّرِّ</para>
  <para style="p" vid="PRO 1:16">وتُسْرِعُ إلى إراقةِ الدِّماءِ.<verse eid="PRO 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 1:17" />يَنصِبُونَ شِباكَهُم عبَثًا</para>
  <para style="p" vid="PRO 1:17">أمامَ عَينَي أيٍّ مِنَ الطُّيورِ<verse eid="PRO 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 1:18" />لأنَّ دَمَهُم هوَ الّذي يُراقُ</para>
  <para style="p" vid="PRO 1:18">وبِكمينِهِم هُمُ الّذينَ يَهلكونَ.<verse eid="PRO 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="PRO 1:19" />تِلكَ حالُ الطَّامِعينَ في الكَسْبِ،</para>
  <para style="p" vid="PRO 1:19">يَنالونَهُ على حِسابِ حياتِهِم.<verse eid="PRO 1:19" /></para>
  <para style="s1">نداء الحكمة</para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="PRO 1:20" />الحِكمةُ تَصيحُ في الشَّوارعِ،</para>
  <para style="p" vid="PRO 1:20">وفي السَّاحاتِ تُرسِلُ صوتَها.<verse eid="PRO 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 1:21" />في رُؤوسِ الأسواقِ تُنادي،</para>
  <para style="p" vid="PRO 1:21">وعِندَ مَداخِلِ المدينةِ تقولُ:<verse eid="PRO 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="PRO 1:22" />إلى متى يَعشقُ الجُهَّالُ الجَهلَ،</para>
  <para style="p" vid="PRO 1:22">ويمدَحُ السَّاخِرونَ السُّخريةَ؟</para>
  <para style="p" vid="PRO 1:22">إلى متى يُبغِضُ البُلَداءُ المعرِفةَ؟<verse eid="PRO 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="PRO 1:23" />إرجعُوا واَسمَعوا تَوبيخي،</para>
  <para style="p" vid="PRO 1:23">فأفيضَ مِنْ روحي علَيكُم</para>
  <para style="p" vid="PRO 1:23">وأجعَلَكُم تعرِفونَ كَلامي.<verse eid="PRO 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="PRO 1:24" />دَعَوتُكمُ فرَفَضتُم دَعوَتي،</para>
  <para style="p" vid="PRO 1:24">ومدَدْتُ يَدي فلم يَلتَفِت أحدٌ.<verse eid="PRO 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="PRO 1:25" />طَرَحْتُم كُلَّ عِظَةٍ مِنِّي</para>
  <para style="p" vid="PRO 1:25">وأبَيتُم قُبولَ تَوبيخي،<verse eid="PRO 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="PRO 1:26" />لذلِكَ أضحكُ في بَليَّتِكُم</para>
  <para style="p" vid="PRO 1:26">وأشمَتُ إنْ حلَّ بِكُم رُعبٌ.<verse eid="PRO 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="PRO 1:27" />وإنْ جاءَ الرُّعبُ كالعاصفةِ</para>
  <para style="p" vid="PRO 1:27">وأتَت بَليَّتُكُم كالزَّوبَعةِ</para>
  <para style="p" vid="PRO 1:27">وحَلّت بِكُم شِدَّةٌ وضيقٌ<verse eid="PRO 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="PRO 1:28" />تَدعونَني فلا أُجيبُ،</para>
  <para style="p" vid="PRO 1:28">وتُبكِّرونَ إليَّ فلا تَجِدونَني.<verse eid="PRO 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="PRO 1:29" />ولأنَّكُم أبغَضتُم كُلَّ مَعرفةٍ</para>
  <para style="p" vid="PRO 1:29">وما اَختَرتُم مخافَةَ الرّبِّ،<verse eid="PRO 1:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="PRO 1:30" />وأبَيتُم قُبولَ مَشورَتي</para>
  <para style="p" vid="PRO 1:30">واَسْتَهَنتُم بكُلِّ توبيخٍ مِنِّي،<verse eid="PRO 1:30" /></para>
  <para style="p">
    <verse number="31" style="v" pubnumber="31" sid="PRO 1:31" />فسَتأكُلونَ ثمَرَةَ ضَلالِكُم</para>
  <para style="p" vid="PRO 1:31">وتَشبَعونَ مِن ثمَرِ مَعصيتِكُم.<verse eid="PRO 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" pubnumber="32" sid="PRO 1:32" />فالجُهَّالُ يَقتُلُهُم هَذَيانُهُم،</para>
  <para style="p" vid="PRO 1:32">والكُسالَى في لَهوِهِم يَبيدونَ.<verse eid="PRO 1:32" /></para>
  <para style="p">
    <verse number="33" style="v" pubnumber="33" sid="PRO 1:33" />مَنْ يَسمَعْ لي يسكُنْ مُطمَئِنًّا،</para>
  <para style="p" vid="PRO 1:33">ويَأمَنْ ولا يُرعِبُهُ شَرٌّ.<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s1">جزاء الحكمة</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 2:1" />إنْ تَعَلَّمتَ أقوالي يا اَبني</para>
  <para style="p" vid="PRO 2:1">وصُنْتَ وصايايَ عِندَكَ<verse eid="PRO 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 2:2" />فأَصغَيتَ بِأُذُنِكَ إلى الحِكمةِ</para>
  <para style="p" vid="PRO 2:2">ومِلتَ بِقَلبِكَ إلى الفهْمِ،<verse eid="PRO 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 2:3" />وإنْ نادَيتَ إليكَ الفِطْنةَ</para>
  <para style="p" vid="PRO 2:3">وأرسَلْتَ في طَلَبِ الفهْمِ،<verse eid="PRO 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 2:4" />فسَعَيتَ وراءَهُما كالفِضَّةِ</para>
  <para style="p" vid="PRO 2:4">وبحَثْتَ عَنهُما كالكُنوزِ،<verse eid="PRO 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 2:5" />تَبَيَّنتَ مخافةَ الرّبِّ</para>
  <para style="p" vid="PRO 2:5">ووَجَدتَ معرِفةَ اللهِ.<verse eid="PRO 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 2:6" />هوَ الرّبُّ يَهَبُ الحِكمةَ</para>
  <para style="p" vid="PRO 2:6">ومِنْ فَمِهِ المعرِفةُ والفهْمُ.<verse eid="PRO 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 2:7" />يُوَفِّرُ للمُستَقيمينَ عَونًا</para>
  <para style="p" vid="PRO 2:7">وحِمايةً للسَّالِكينَ في الكَمالِ.<verse eid="PRO 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 2:8" />يَرعى مَسالِكَ المُنصِفينَ،</para>
  <para style="p" vid="PRO 2:8">ويَحرُسُ طريقَ أتقيائِهِ.<verse eid="PRO 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 2:9" />هكذا تَفهَمُ العَدلَ والإِنصافَ</para>
  <para style="p" vid="PRO 2:9">وكُلَّ سبيلٍ صالِحٍ قَويمٍ.<verse eid="PRO 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 2:10" />إذا دخَلَتِ الحِكمةُ قلبَكَ</para>
  <para style="p" vid="PRO 2:10">وتَنَعَّمَت بالمَعرفَةِ نفسُكَ،<verse eid="PRO 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 2:11" />يَحرُسُكَ حُسنُ التَّدبيرِ</para>
  <para style="p" vid="PRO 2:11">ويكونُ الفهْمُ نصيرَكَ.<verse eid="PRO 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 2:12" />فتَنجوَ مِنْ طريقِ الشَّرِّ</para>
  <para style="p" vid="PRO 2:12">ومِنَ النَّاطقينَ بالأكاذيبِ،<verse eid="PRO 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 2:13" />التَّاركينَ طريقَ الاستقامةِ</para>
  <para style="p" vid="PRO 2:13">ليَسلُكُوا طريقَ الظَّلامِ،<verse eid="PRO 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 2:14" />الفرِحينَ باَرتِكابِ المساوِئِ</para>
  <para style="p" vid="PRO 2:14">والمُبتَهِجينَ بأكاذيبِ الشَّرِّ.<verse eid="PRO 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 2:15" />هؤلاءِ سُبُلُهُم مُلتَويةٌ،</para>
  <para style="p" vid="PRO 2:15">وهُم في سُلُوكِهِم مُراوِغونَ.<verse eid="PRO 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 2:16" />وتَنجو مِنَ المرأةِ العاهِرةِ،</para>
  <para style="p" vid="PRO 2:16">مِنَ الفاجِرةِ المَعسولَةِ الكَلامِ،<verse eid="PRO 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 2:17" />الّتي ترَكَت رفيقَ صِباها</para>
  <para style="p" vid="PRO 2:17">ونَسيَت عَهدَها للهِ،<verse eid="PRO 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 2:18" />فهَوَى بَيتُها إلى الموتِ</para>
  <para style="p" vid="PRO 2:18">وطريقُها إلى الظُّلُماتِ.<verse eid="PRO 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="PRO 2:19" />الدَّاخلونَ إليها لا يَعودونَ</para>
  <para style="p" vid="PRO 2:19">ولا يَسيرونَ في سُبُلِ الحياةِ.<verse eid="PRO 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="PRO 2:20" />فاَسلُكْ طريقَ الصَّالِحينَ</para>
  <para style="p" vid="PRO 2:20">ولا تَحِدْ عنْ سُبُلِ الصِّدِّيقينَ<verse eid="PRO 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 2:21" />فالمُستَقيمونَ يَبقَونَ في الأرضِ،</para>
  <para style="p" vid="PRO 2:21">وجماعةُ الأبرارِ لا يُفارِقونَها.<verse eid="PRO 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="PRO 2:22" />أمَّا الأشرارُ فيَنقَرضونَ مِنها،</para>
  <para style="p" vid="PRO 2:22">وكذلِكَ يزولُ الغادِرونَ.<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 3:1" />لا تَنسَ نصيحَتي يا اَبني،</para>
  <para style="p" vid="PRO 3:1">واَحفَظْ وصايايَ في قلبِكَ،<verse eid="PRO 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 3:2" />لأنَّها تزيدُ أيَّامَكَ أيّامًا،</para>
  <para style="p" vid="PRO 3:2">سِنيَّ حياتِكَ سلامًا.<verse eid="PRO 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 3:3" />لا تَترُكِ الرَّحمةَ والأمانةَ،</para>
  <para style="p" vid="PRO 3:3">بلِ اَعْقِدْهُما قِلادةً في عُنُقِكَ</para>
  <para style="p" vid="PRO 3:3">واَكتُبْهُما على لَوحِ قلبِكَ.<verse eid="PRO 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 3:4" />فتَنالَ كُلَّ حُظوَةٍ وإكرامٍ</para>
  <para style="p" vid="PRO 3:4">في أعينِ اللهِ والنَّاسِ.<verse eid="PRO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 3:5" />بكُلِّ قلبِكَ اَطْمَئِنَّ إلى الرّبِّ</para>
  <para style="p" vid="PRO 3:5">ولا تَعتَمِدْ على فِطنَتِكَ.<verse eid="PRO 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 3:6" />أينما سِرْتَ تعَرَّفْ إليهِ،</para>
  <para style="p" vid="PRO 3:6">فيُيَسِّرَ لكَ طريقَكَ.<verse eid="PRO 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 3:7" />لا تَكُنْ حكيمًا في عينَيكَ.</para>
  <para style="p" vid="PRO 3:7">واَتَّقِ الرّبَّ واَنصرفْ عَنِ الشَّرِّ.<verse eid="PRO 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 3:8" />في ذلِكَ صِحَّةٌ لِجسَدِكَ</para>
  <para style="p" vid="PRO 3:8">وتَخفيفٌ لجميعِ آلامِكَ.<verse eid="PRO 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 3:9" />أكرِمِ الرّبَّ مِنْ مالِكَ</para>
  <para style="p" vid="PRO 3:9">ومِنْ بَواكيرِ جميعِ غِلالِكَ،<verse eid="PRO 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 3:10" />فتَمتَلئَ مَخازِنُكَ قمحًا</para>
  <para style="p" vid="PRO 3:10">وتَفيضَ مَعاصِرُكَ خمرًا.<verse eid="PRO 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 3:11" />لا تَرفُضْ مَشورَةَ الرّبِّ</para>
  <para style="p" vid="PRO 3:11">ولا تَكرَهْ تَوبيخَهُ لكَ.<verse eid="PRO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 3:12" />فمَنْ يُحِبُّهُ الرّبُّ يُوَبِّخُهُ</para>
  <para style="p" vid="PRO 3:12">ويرضى بِهِ كأبٍ باَبنِهِ.<verse eid="PRO 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 3:13" />هَنيئًا لِمَنْ يَجِدُ الحِكمةَ،</para>
  <para style="p" vid="PRO 3:13">وبها ينالُ الفهْمَ.<verse eid="PRO 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 3:14" />رِبحُها يفوقُ الفِضَّةَ</para>
  <para style="p" vid="PRO 3:14">وغَلَّتُها تفوقُ الذَّهَبَ.<verse eid="PRO 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 3:15" />هيَ أغلَى مِنْ جميعِ اللَّآلئِ،</para>
  <para style="p" vid="PRO 3:15">وكُلّ كُنوزِكَ لا تُساويها.<verse eid="PRO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 3:16" />في يمينِها طُولُ الأيّامِ،</para>
  <para style="p" vid="PRO 3:16">وفي يسارِها الغِنى والمَجدُ.<verse eid="PRO 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 3:17" />طُرُقُها تقودُ إلى النِّعَمِ،</para>
  <para style="p" vid="PRO 3:17">وجميعُ مَسالِكِها سلامٌ.<verse eid="PRO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 3:18" />شجَرةُ حياةٍ لِلمُتَمَسِّكينَ بِها،</para>
  <para style="p" vid="PRO 3:18">ومنْ يَتَمكَّنُ مِنها فهَنيئًا لهُ.<verse eid="PRO 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="PRO 3:19" />الرّبُّ بالحِكمةِ أسَّسَ الأرضَ،</para>
  <para style="p" vid="PRO 3:19">وبالفهْمِ ثَبَّتَ السَّماواتِ.<verse eid="PRO 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="PRO 3:20" />بِمعرِفَتِهِ تفَجَّرَتِ الينابيعُ</para>
  <para style="p" vid="PRO 3:20">وأمطَرَتِ السَّحائبُ نَدًى.<verse eid="PRO 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 3:21" />عايِنِ الرّأيَ والتَّدبيرَ يا اَبني،</para>
  <para style="p" vid="PRO 3:21">ولا تَدَعْهُما يَغيبانِ عنْ عينَيكَ،<verse eid="PRO 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="PRO 3:22" />لأنَّ فيهِما حياةً لِنفْسِكَ</para>
  <para style="p" vid="PRO 3:22">وقِلادةَ نِعمةٍ لِعُنُقِكَ،<verse eid="PRO 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="PRO 3:23" />فتَسيرَ في طريقِكَ آمِنًا،</para>
  <para style="p" vid="PRO 3:23">فلا تَعثُرَ فيها قدَمُكَ.<verse eid="PRO 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="PRO 3:24" />إذا جِئتَ لِتنامَ فلا تَرتَعِبُ،</para>
  <para style="p" vid="PRO 3:24">بل تنامُ ويحلو نومُكَ.<verse eid="PRO 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="PRO 3:25" />لا تخَفْ مِنْ رُعبٍ مُفاجئٍ</para>
  <para style="p" vid="PRO 3:25">ومِنْ إساءةٍ تأتي مِنَ الأشرارِ،<verse eid="PRO 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="PRO 3:26" />لأنَّ الرّبَّ يكونُ سَنَدًا لكَ</para>
  <para style="p" vid="PRO 3:26">ويَحرُسُ قدَمَكَ فلا تَعثُرُ.<verse eid="PRO 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="PRO 3:27" />لا تَمنَعِ الخَيرَ عَنْ أهلِهِ،</para>
  <para style="p" vid="PRO 3:27">إذا كانَ في مُتَناولِ يَدِكَ.<verse eid="PRO 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="PRO 3:28" />لا تَقُلْ لأحدٍ اَذهَبْ وَعُدْ.</para>
  <para style="p" vid="PRO 3:28">غدًا أُعطيكَ والشَّيءُ عِندَكَ.<verse eid="PRO 3:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="PRO 3:29" />لا تتَحَرَّشْ بأحدٍ جَورًا</para>
  <para style="p" vid="PRO 3:29">وهوَ يُقيمُ مُطمَئِنًّا معَكَ:<verse eid="PRO 3:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="PRO 3:30" />لا تَتَّهمْ أحدًا بِغيرِ سبَبٍ،</para>
  <para style="p" vid="PRO 3:30">ما لم يكُنْ عامَلَكَ بِسُوءٍ.<verse eid="PRO 3:30" /></para>
  <para style="p">
    <verse number="31" style="v" pubnumber="31" sid="PRO 3:31" />لا تُخالِطْ رَجُلَ العُنْفِ،</para>
  <para style="p" vid="PRO 3:31">ولا تَختَرْ مِنْ طُرُقِهِ شيئًا.<verse eid="PRO 3:31" /></para>
  <para style="p">
    <verse number="32" style="v" pubnumber="32" sid="PRO 3:32" />المُراوغونَ يَمقُتُهُمُ الرّبُّ،</para>
  <para style="p" vid="PRO 3:32">وأمَّا المُستقيمونَ فيَسودونَ.<verse eid="PRO 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" pubnumber="33" sid="PRO 3:33" />لَعنةُ الرّبِّ في بُيوتِ الأشرارِ</para>
  <para style="p" vid="PRO 3:33">وبرَكَتُهُ في بُيوتِ الصِّدِّيقينَ.<verse eid="PRO 3:33" /></para>
  <para style="p">
    <verse number="34" style="v" pubnumber="34" sid="PRO 3:34" />بالسَّاخرينَ يَسخَرُ الرّبُّ،</para>
  <para style="p" vid="PRO 3:34">وعلى المَساكينِ يَسكُبُ نِعمَتَهُ.<verse eid="PRO 3:34" /></para>
  <para style="p">
    <verse number="35" style="v" pubnumber="35" sid="PRO 3:35" />الحُكَماءُ يَرِثُونَ مَجدًا،</para>
  <para style="p" vid="PRO 3:35">والجُهَّالُ يرَونَ الهَوانَ.<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s1">فوائد الحكمة</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 4:1" />إسمَعوا أيُّها البَنونَ مَشورَةَ الأبِ،</para>
  <para style="p" vid="PRO 4:1">وأصغوا لِتَكتَسِبوا الفِطنةَ.<verse eid="PRO 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 4:2" />تعليمًا صالحًا أُعطيهِ لكُم،</para>
  <para style="p" vid="PRO 4:2">فلا تُهمِلوا نصيحتي.<verse eid="PRO 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 4:3" />كُنتُ اَبنًا صغيرًا لأبي</para>
  <para style="p" vid="PRO 4:3">ووَلَدًا واحدًا لأُمِّي،<verse eid="PRO 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 4:4" />كانَ يُرشِدُني فيقولُ:</para>
  <para style="p" vid="PRO 4:4">”لِيَتَمسَّكْ قلبُكَ بِكلامي،</para>
  <para style="p" vid="PRO 4:4">واَحفظْ وصايايَ فتَحيا.<verse eid="PRO 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 4:5" />إقتَنِ الحِكمةَ واَقتنِ الفِطنةَ.</para>
  <para style="p" vid="PRO 4:5">ولا تَنسَ ولا تَحِدْ عَنْ كلامي.<verse eid="PRO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 4:6" />لا تَترُكِ الحِكْمةَ فتحرُسَكَ.</para>
  <para style="p" vid="PRO 4:6">أحِبَّها فهي الّتي تَنصُرُكَ.<verse eid="PRO 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 4:7" />الحِكمةُ رأسُ الأشياءِ فاَقتَنِها،</para>
  <para style="p" vid="PRO 4:7">واَقْتَنِ الفِطنَةَ بما ملَكَت يَداكَ.<verse eid="PRO 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 4:8" />إنتَزِعْها فترفَعَكَ إلى العَلاءِ،</para>
  <para style="p" vid="PRO 4:8">واَعتَنِقْها فهيَ الّتي تُمَجِّدُكَ.<verse eid="PRO 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 4:9" />هيَ إكليلُ برَكَةٍ لِرَأسِكَ</para>
  <para style="p" vid="PRO 4:9">وتاجُ مَجدٍ وُهِبَ لكَ“.<verse eid="PRO 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 4:10" />إسمعْ يا اَبني وتعَلَّمْ أقوالي،</para>
  <para style="p" vid="PRO 4:10">فتطُولَ سِنُوّ حياتِكَ.<verse eid="PRO 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 4:11" />أرَيتُكَ طريقَ الحِكمةِ</para>
  <para style="p" vid="PRO 4:11">وهَديتُكَ سَواءَ السَّبيلِ،<verse eid="PRO 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 4:12" />فتَمشي ولا تَضيقُ خَطَواتُكَ،</para>
  <para style="p" vid="PRO 4:12">وإذا أسرعتَ فلا تَعثُرُ.<verse eid="PRO 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 4:13" />تمَسَّكْ بالمَشورَةِ ولا تُرْخِها،</para>
  <para style="p" vid="PRO 4:13">وحافظْ علَيها فإنَّها حياتُكَ.<verse eid="PRO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 4:14" />معَ الأشرارِ لا تتَداخَلْ،</para>
  <para style="p" vid="PRO 4:14">ولا تسلُكْ طريقَ الرُّعاعِ،<verse eid="PRO 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 4:15" />بل تجَنَّبْهُ ولا تَمُرَّ بهِ،</para>
  <para style="p" vid="PRO 4:15">واَبتَعِدْ عَنهُ واَعبُرْ إلى الأمامِ.<verse eid="PRO 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 4:16" />فَهُم لا ينامُونَ إذا لم يُسيئُوا،</para>
  <para style="p" vid="PRO 4:16">وتنقَصِفُ أعمارُهُم إذا لم يُؤذُوا.<verse eid="PRO 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 4:17" />فالشَّرُّ هوَ الخبزُ الّذي يأكلونَ.</para>
  <para style="p" vid="PRO 4:17">والعُنْفُ هوَ الخمرُ الّذي يشربونَ.<verse eid="PRO 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 4:18" />سبيلُ الصِّدِّيقينَ مِثلُ نورِ الفَجرِ،</para>
  <para style="p" vid="PRO 4:18">يتَزايَدُ سُطوعًا إلى الظُّهرِ.<verse eid="PRO 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="PRO 4:19" />أمَّا الأشرارُ فطريقُهُم في ظلامٍ،</para>
  <para style="p" vid="PRO 4:19">لا يَعرِفونَ بأيِّ شيءٍ يَعثُرونَ.<verse eid="PRO 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="PRO 4:20" />إلى كَلامي اَستَمِعْ يا اَبني،</para>
  <para style="p" vid="PRO 4:20">وإلى أوامري أَمِلْ أذُنَيكَ.<verse eid="PRO 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 4:21" />لا تَجعَلْها تَغيبُ عنْ عينَيكَ،</para>
  <para style="p" vid="PRO 4:21">بلِ اَحفَظْها في صميمِ قلبِكَ.<verse eid="PRO 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="PRO 4:22" />فهيَ حياةٌ لِمَنْ يَحظَى بِها،</para>
  <para style="p" vid="PRO 4:22">وهيَ شِفاءٌ لِلجسَدِ كُلِّهِ.<verse eid="PRO 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="PRO 4:23" />مِنْ كُلِّ تكبُّرٍ اَحفَظْ قلبَكَ،</para>
  <para style="p" vid="PRO 4:23">لأنَّ مِنهُ يَنابيعَ الحياةِ.<verse eid="PRO 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="PRO 4:24" />تجَنَّبْ كُلَّ نِفاقٍ في القولِ،</para>
  <para style="p" vid="PRO 4:24">وأَبعِدْ عَنكَ كُلَّ كلامٍ مُراوغٍ.<verse eid="PRO 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="PRO 4:25" />واَنظرْ بعينَيكَ إلى الأمامِ</para>
  <para style="p" vid="PRO 4:25">وسَدِّدْ نَظراتِكَ قُدَّامَكَ.<verse eid="PRO 4:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="PRO 4:26" />بل مَهِّدْ سبيلَ قدَمَيكَ،</para>
  <para style="p" vid="PRO 4:26">فتَثبُتَ جميعُ طُرُقِكَ.<verse eid="PRO 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="PRO 4:27" />لا تَمِلْ يَمينًا ولا شَمالًا،</para>
  <para style="p" vid="PRO 4:27">فتَمنَعَ قدَمَكَ عَنِ الشَّرِّ.</para>
  <para style="p" vid="PRO 4:27">تحذير من الزنى<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 5:1" />أصغِ إلى حِكمتي يا اَبني</para>
  <para style="p" vid="PRO 5:1">وأمِلْ أُذُنَيكَ إلى الفهْمِ،<verse eid="PRO 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 5:2" />فتَحتَفِظَ بِحُسْنِ التَّدبيرِ</para>
  <para style="p" vid="PRO 5:2">وتَصونَ شفتاكَ المَعرِفةَ.<verse eid="PRO 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 5:3" />شَفَتا العاهِرةِ تقطُرانِ العسَلَ</para>
  <para style="p" vid="PRO 5:3">وكلامُها ألينُ مِنَ الزَّيتِ.<verse eid="PRO 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 5:4" />أمَّا عاقِبَتُها فمُرَّةٌ كالعَلقَمِ،</para>
  <para style="p" vid="PRO 5:4">ومَسنونَةٌ كسَيفٍ لَه حَدَّانِ.<verse eid="PRO 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 5:5" />قدَماها تَسيرانِ إلى الموتِ،</para>
  <para style="p" vid="PRO 5:5">وخَطواتُها تَتَمَسَّكُ بعالَمِ الأمواتِ.<verse eid="PRO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 5:6" />سبيلُ الحياةِ لا تُدرِكُهُ،</para>
  <para style="p" vid="PRO 5:6">فتَسيرُ في الضَّلالِ ولا تَرتاحُ.<verse eid="PRO 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 5:7" />والآنَ يا اَبني إستَمِعْ لي</para>
  <para style="p" vid="PRO 5:7">ولا تَحِدْ عَمَّا أقولُهُ لكَ.<verse eid="PRO 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 5:8" />أبعِدْ طريقَكَ عَنْ تِلكَ المَرأةِ</para>
  <para style="p" vid="PRO 5:8">ولا تَقتَرِبْ مِنْ بابِ بيتِها،<verse eid="PRO 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 5:9" />لئلَّا تَهدُرَ كرامَتَكَ للآخَرينَ</para>
  <para style="p" vid="PRO 5:9">وسِنيَّ حياتِكَ لِمَنْ لا يَرحَمُ،<verse eid="PRO 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 5:10" />ويَشبَعَ الأجنَبيُّ مِنْ أموالِكَ،</para>
  <para style="p" vid="PRO 5:10">ويضيعَ تعَبُكَ في بَيتٍ غريبٍ.<verse eid="PRO 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 5:11" />فتَنهَمَّ في أواخِرِ أيّامِكَ</para>
  <para style="p" vid="PRO 5:11">حين يَبلى لَحمُكَ وعظْمُكَ.<verse eid="PRO 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 5:12" />تقولُ: ”أبغَضتُ حُسْنَ المَشورَةِ</para>
  <para style="p" vid="PRO 5:12">واَستهانَ بالتَّوبيخِ قلبي.<verse eid="PRO 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 5:13" />لم أستَمِعْ لِصوتِ مُرشديَّ</para>
  <para style="p" vid="PRO 5:13">ولا أَمَلْتُ أُذُني إلى مُعَلِّميَّ.<verse eid="PRO 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 5:14" />لذلِكَ ساءَ مُقامي جِدًّا</para>
  <para style="p" vid="PRO 5:14">في وسَطِ المَحفلِ والجماعةِ“.<verse eid="PRO 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 5:15" />إمرأتُكَ ماءٌ مُبارَكةٌ</para>
  <para style="p" vid="PRO 5:15">نازِلَةٌ في وسَطِ بِئرِكَ.<verse eid="PRO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 5:16" />فلو فاضتِ الينابيعُ إلى الخارجِ،</para>
  <para style="p" vid="PRO 5:16">كسواقي مياهٍ في السَّاحاتِ،<verse eid="PRO 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 5:17" />فلتكُنْ لكَ دونَ سِواكَ،</para>
  <para style="p" vid="PRO 5:17">دونَ أيٍّ مِنَ الآخرينَ.<verse eid="PRO 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 5:18" />هكذا يُبارَكُ نسلُكَ</para>
  <para style="p" vid="PRO 5:18">وتفرَحُ باَمرأةِ شبابِكَ.<verse eid="PRO 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="PRO 5:19" />فتكونُ لكَ الظَّبْيةَ المحبوبةَ</para>
  <para style="p" vid="PRO 5:19">والوَعْلةَ الحَنونَ الصَّغيرةَ.</para>
  <para style="p" vid="PRO 5:19">يُرويكَ ودادُها كُلَّ حينٍ،</para>
  <para style="p" vid="PRO 5:19">وبِحُبِّها تَهيمُ على الدَّوامِ.<verse eid="PRO 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="PRO 5:20" />فلماذا يا اَبني تهيمُ بالعاهِرةِ،</para>
  <para style="p" vid="PRO 5:20">أو تضمُّ في حِضنِكَ الفاجِرةَ؟<verse eid="PRO 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 5:21" />فطُرُقُ الإنسانِ يَراها الرّبُّ،</para>
  <para style="p" vid="PRO 5:21">وهوَ يُمهِّدُ جميعَ مسالِكِهِ.<verse eid="PRO 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="PRO 5:22" />فيؤخَذُ الشِّرِّيرُ بشرِّهِ</para>
  <para style="p" vid="PRO 5:22">وتُمسِكُهُ حَبائلُ خطيئتهِ.<verse eid="PRO 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="PRO 5:23" />يموتُ لفُقدانِهِ التَّأديبَ</para>
  <para style="p" vid="PRO 5:23">وبِكثرةِ حماقَتِهِ يَتيهُ.<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s1">تحذيرات أخرى</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 6:1" />إنْ كَفِلْتَ يا اَبني أحدًا</para>
  <para style="p" vid="PRO 6:1">وعَقَدْتَ صفقَةً معَ آخرَ،<verse eid="PRO 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 6:2" />وعَلِقْتَ بما نطَقَت شفَتاكَ،</para>
  <para style="p" vid="PRO 6:2">وأُخِذْتَ بأقوالِ فَمِكَ<verse eid="PRO 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 6:3" />بحيثُ وقَعتَ في يَدِهِ،</para>
  <para style="p" vid="PRO 6:3">فاَفعلْ هذا يا اَبني:</para>
  <para style="p" vid="PRO 6:3">تذَلَّلْ وتَوَسَّلْ إليهِ،<verse eid="PRO 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 6:4" />قَبلَ أنْ تُغمِضَ عينَيكَ</para>
  <para style="p" vid="PRO 6:4">ويدُبَّ في جُفونِكَ النُّعاسُ،<verse eid="PRO 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 6:5" />فتنجوَ كالظَّبْيِ مِنَ الشَّرَكِ،</para>
  <para style="p" vid="PRO 6:5">وكالعُصفورِ مِنْ قبضةِ الصَّيَّادِ.<verse eid="PRO 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 6:6" />إذهبْ إلى النَّملةِ يا بَطَّالُ،</para>
  <para style="p" vid="PRO 6:6">وتأَمَّلْ طُرُقَها وكُنْ حكيمًا.<verse eid="PRO 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 6:7" />فَمِنْ غَيرِ قاضٍ ولا رقيبٍ</para>
  <para style="p" vid="PRO 6:7">ولا سيِّدٍ يُسَيطِرُ علَيها<verse eid="PRO 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 6:8" />تُهَيّئُ في الصَّيفِ طَعامَها</para>
  <para style="p" vid="PRO 6:8">وتَجمَعُ في الحصادِ قُوتَها.<verse eid="PRO 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 6:9" />إلى متى تنامُ يا بطَّالُ؟</para>
  <para style="p" vid="PRO 6:9">ومتى تقومُ مِنْ نَومِكَ؟<verse eid="PRO 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 6:10" />بَينَ قليلٍ مِنَ النُّعاسِ</para>
  <para style="p" vid="PRO 6:10">وطيِّ اليديَنِ قليلًا لِلنَّوم.<verse eid="PRO 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 6:11" />يُداهِمُكَ الفَقرُ كَمُهلِكٍ،</para>
  <para style="p" vid="PRO 6:11">والخَسارةُ كرَجُلٍ مُسلَّحٍ.<verse eid="PRO 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 6:12" />مَنْ كانَ لَئيمًا أو كانَ أثيمًا</para>
  <para style="p" vid="PRO 6:12">يَروحُ ويَجيءُ ناطقًا بالكَذِبِ.<verse eid="PRO 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 6:13" />يغمِزُ بِعَينَيهِ ويضرِبُ بِرِجلَيهِ</para>
  <para style="p" vid="PRO 6:13">ويُشيرُ بأصابِعِهِ لِيَخدَعَكَ.<verse eid="PRO 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 6:14" />بقلبٍ كاذبٍ يَزرَعُ الشَّرَّ</para>
  <para style="p" vid="PRO 6:14">ويُلقي الخِصامَ في كُلِّ حينٍ،<verse eid="PRO 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 6:15" />فتَأتيهِ النَّكْبةُ فجأةً،</para>
  <para style="p" vid="PRO 6:15">فينكسِرُ في الحالِ ولا شِفاءَ.<verse eid="PRO 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 6:16" />هُناكَ سِتَّةٌ يُبغِضُها الرّبُّ،</para>
  <para style="p" vid="PRO 6:16">بل سَبعةٌ تَمقُتُها نفسُهُ:<verse eid="PRO 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 6:17" />عينانِ مُتعاليتانِ ولِسانٌ كاذبٌ،</para>
  <para style="p" vid="PRO 6:17">ويَدانِ تَسفُكانِ الدَّمَ البريءَ،<verse eid="PRO 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 6:18" />وقلبٌ يَزرَعُ أفكارَ الشَّرِّ،</para>
  <para style="p" vid="PRO 6:18">وقدمانِ تُسرعانِ إلى المَساوئِ،<verse eid="PRO 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="PRO 6:19" />وشاهِدُ زورٍ يَنشرُ الكَذِبَ،</para>
  <para style="p" vid="PRO 6:19">ويُلقي الخِصامَ بَينَ الإخوةِ.<verse eid="PRO 6:19" /></para>
  <para style="s1">تحذير من الزنى</para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="PRO 6:20" />إحفَظْ يا اَبني وصيَّةَ أبيكَ</para>
  <para style="p" vid="PRO 6:20">ولا تُهمِلْ نَصيحَةَ أُمِّكَ.<verse eid="PRO 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 6:21" />أُعقُدْها في قلبِكَ كُلَّ حينٍ،</para>
  <para style="p" vid="PRO 6:21">وعَلِّقْها يا اَبني في عُنُقِكَ،<verse eid="PRO 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="PRO 6:22" />فتَهديَكَ في مَجيئِكَ ورَواحِكَ</para>
  <para style="p" vid="PRO 6:22">وتُحافِظَ علَيكَ في نَومِكَ،</para>
  <para style="p" vid="PRO 6:22">ومتى اَستَفَقتَ فهيَ تُحَدِّثُكُ.<verse eid="PRO 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="PRO 6:23" />الوصيَّةُ مِصباحٌ والشَّريعَةُ نورٌ،</para>
  <para style="p" vid="PRO 6:23">والتَّوبيخُ والتَّأديبُ طريقُ الحياةِ.<verse eid="PRO 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="PRO 6:24" />فتَحرُسُكَ مِن اَمرأةِ السُّوءِ،</para>
  <para style="p" vid="PRO 6:24">مِنْ مَعسولِ لِسانِ الفاجرةِ.<verse eid="PRO 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="PRO 6:25" />لا تشتَهِ جَمالَها في قلبِكَ</para>
  <para style="p" vid="PRO 6:25">ولا تُؤخَذْ بِسِحرِ جُفونِها.<verse eid="PRO 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="PRO 6:26" />فالزَّانيةُ تُفقِرُكَ إلى الرَّغيفِ،</para>
  <para style="p" vid="PRO 6:26">والمُتَزَوِّجةُ تصطادُ كِرامَ النُّفوسِ.<verse eid="PRO 6:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="PRO 6:27" />أيحضُنُ الإنسانُ نارًا</para>
  <para style="p" vid="PRO 6:27">ولا تحترِقُ بالنَّارِ ثيابُهُ؟<verse eid="PRO 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="PRO 6:28" />أو يدُوسُ كومةً مِنَ الجَمْرِ</para>
  <para style="p" vid="PRO 6:28">ولا تكتَوي بالجَمْرِ قدَماهُ؟<verse eid="PRO 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="PRO 6:29" />هكذا مَنْ يزورُ اَمرأةَ غيرِهِ،</para>
  <para style="p" vid="PRO 6:29">إنْ مَسَّها لا يسلَمُ مِنَ العِقابِ.<verse eid="PRO 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="PRO 6:30" />لا يُحتَقَرُ السَّارِقُ إذا سرَقَ</para>
  <para style="p" vid="PRO 6:30">لِيُشبِعَ نفْسَهُ وهوَ جائِعٌ.<verse eid="PRO 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" pubnumber="31" sid="PRO 6:31" />يَرُدُّ سَبعةَ أضعافٍ إنِ اَفتَضَحَ</para>
  <para style="p" vid="PRO 6:31">ويُعطي كُلَّ أثاثِ بَيتِهِ.<verse eid="PRO 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" pubnumber="32" sid="PRO 6:32" />الزّاني بِمُتَزوِّجَةٍ يُعوِزُهُ الفهْمُ</para>
  <para style="p" vid="PRO 6:32">ويفعَلُ هذا لِهَلاكِ نفْسِهِ.<verse eid="PRO 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" pubnumber="33" sid="PRO 6:33" />يَضرِبُهُ زَوجُها ويَلقى هَوانًا،</para>
  <para style="p" vid="PRO 6:33">وعارُهُ في النَّاسِ لا يُمحَى،<verse eid="PRO 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" pubnumber="34" sid="PRO 6:34" />لأنَّ النَّخوَةَ زينَةُ الرَّجُلِ</para>
  <para style="p" vid="PRO 6:34">فلا يتَوانَى ساعةَ الاَنتقامِ.<verse eid="PRO 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" pubnumber="35" sid="PRO 6:35" />ما منْ فِديةٍ ترفَعُ رأسَهُ،</para>
  <para style="p" vid="PRO 6:35">ومَهما رَشَوتَهُ لا يرضى.<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 7:1" />إحفَظْ كلامي يا اَبْني،</para>
  <para style="p" vid="PRO 7:1">وصُنْ وصايايَ عِندَكَ.<verse eid="PRO 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 7:2" />إحفَظْ وصايايَ فتَحيا.</para>
  <para style="p" vid="PRO 7:2">ونصيحَتي كحَدَقةِ عَينِكَ.<verse eid="PRO 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 7:3" />أُعقُدْها على أصابعِ يدَيكَ،</para>
  <para style="p" vid="PRO 7:3">واَكتُبْها على لَوحِ قلبِكَ.<verse eid="PRO 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 7:4" />قُلْ لِلحِكمةِ أنتِ أُختي،</para>
  <para style="p" vid="PRO 7:4">واَدْعُ الفِطنَةَ مِنْ مَعارِفِكَ،<verse eid="PRO 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 7:5" />فتَحرُسَكَ مِنَ المرأةِ العاهِرةِ</para>
  <para style="p" vid="PRO 7:5">مِنَ الفاجِرةِ المعسُولَةِ الكَلامِ.<verse eid="PRO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 7:6" />تطَلّعتُ مِنْ كُوَّةِ بَيتي،</para>
  <para style="p" vid="PRO 7:6">ومِنْ وراءِ شُبّاكي نظَرتُ،<verse eid="PRO 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 7:7" />فرَأيتُ بَينَ الجُهَّالِ</para>
  <para style="p" vid="PRO 7:7">وتَبَيَّنتُ بَينَ الأغرارِ</para>
  <para style="p" vid="PRO 7:7">فتَى يُعوِزُهُ الفهْمُ<verse eid="PRO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 7:8" />يعبُرُ السُّوقَ عِندَ الزَّاويةِ،</para>
  <para style="p" vid="PRO 7:8">وفي طريقِ بَيتِها يصعَدُ.<verse eid="PRO 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 7:9" />كانَ ذلِكَ عِندَ الغُروبِ</para>
  <para style="p" vid="PRO 7:9">في سَواد اللَّيلِ بَعدَ الأفُولِ.<verse eid="PRO 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 7:10" />فإذا بِاَمرأةٍ تتَلَقَّاهُ،</para>
  <para style="p" vid="PRO 7:10">في زِيِّ زانيةٍ جامِحةِ الهوَى،<verse eid="PRO 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 7:11" />جامحةٍ كثيرةِ التَّنَقُّلِ،</para>
  <para style="p" vid="PRO 7:11">لا تستَقِرُّ في بَيتِها قدَماها.<verse eid="PRO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 7:12" />مرَّةً في الشَّارِعِ ومرَّةً في السَّاحاتِ،</para>
  <para style="p" vid="PRO 7:12">وتكمُنُ عِندَ كُلِّ زاويةٍ.<verse eid="PRO 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 7:13" />فأمسَكَتْهُ وأخذَت تُقبِّلُهُ،</para>
  <para style="p" vid="PRO 7:13">وبصفاقةِ وجهٍ قالَت لهُ:<verse eid="PRO 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 7:14" />”ذَبائحُ السَّلامةِ قَدَّمْتُها،</para>
  <para style="p" vid="PRO 7:14">واليومَ أَوفَيتُ نُذوري،<verse eid="PRO 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 7:15" />فخَرَجْتُ في الحالِ أُنادِيكَ</para>
  <para style="p" vid="PRO 7:15">شَوقًا إلى وجهِكَ فوَجَدتُكَ.<verse eid="PRO 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 7:16" />فرَشْتُ بالكَتَّانِ سريري،</para>
  <para style="p" vid="PRO 7:16">وخُيوطُ نسيجِهِ مِنْ مِصْرَ.<verse eid="PRO 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 7:17" />مَضجَعي عَطَّرتُهُ بالمُرِّ،</para>
  <para style="p" vid="PRO 7:17">وضَمَّخْتُهُ بالعُودِ والقِرفَةِ.<verse eid="PRO 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 7:18" />تعالَ فنَرتَويَ حُبًّا إلى الصُّبحِ،</para>
  <para style="p" vid="PRO 7:18">ونَنعمَ بِلَذائِذِ الحُبِّ.<verse eid="PRO 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="PRO 7:19" />زوجي غائبٌ عَنِ البَيتِ.</para>
  <para style="p" vid="PRO 7:19">مضَى في سفَرٍ طويلٍ.<verse eid="PRO 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="PRO 7:20" />أخذَ كيسًا مِنَ الفِضَّةِ،</para>
  <para style="p" vid="PRO 7:20">ولا يعودُ قَبلَ أيّامٍ كثيرةٍ“.<verse eid="PRO 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 7:21" />فجَذَبَتْهُ بِكثرَةِ مَفاتِنِها،</para>
  <para style="p" vid="PRO 7:21">ودَوَّخَتْهُ بِمَعسولِ كلامِها،<verse eid="PRO 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="PRO 7:22" />فمَشى وراءَها في الحالِ،</para>
  <para style="p" vid="PRO 7:22">كثورٍ يُسَاقُ إلى الذَّبحِ،</para>
  <para style="p" vid="PRO 7:22">أو غزالٍ يسيرُ إلى الأسْرِ.<verse eid="PRO 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="PRO 7:23" />حتّى يَشقَّ كَبِدَهُ السَّهمُ،</para>
  <para style="p" vid="PRO 7:23">أو كعُصفُورٍ يُسرِعُ إلى الفَخِّ</para>
  <para style="p" vid="PRO 7:23">ولا يعرِفُ أنَّهُ في خطَرٍ.<verse eid="PRO 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="PRO 7:24" />فاَسمَعوا لي أيُّها الأبناءُ</para>
  <para style="p" vid="PRO 7:24">وأصغوا إلى كَلِماتِ فَمي!<verse eid="PRO 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="PRO 7:25" />لا تَمِلْ قُلوبُكُم إلى طُرُقِها،</para>
  <para style="p" vid="PRO 7:25">وفي مَسالِكِها لا تَشرُدوا.<verse eid="PRO 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="PRO 7:26" />كم أوقَعَت بأولادِ الحلالِ،</para>
  <para style="p" vid="PRO 7:26">وجميعُ ضحاياها مِنَ العُظَماءِ.<verse eid="PRO 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="PRO 7:27" />بَيتُها طريقٌ إلى عالَمِ الأمواتِ</para>
  <para style="p" vid="PRO 7:27">وهُبوطٌ إلى دَهاليزِ الموتِ.<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s1">تمجيد الحكمة</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 8:1" />إسمَعِ الحِكمةَ تُنادي،</para>
  <para style="p" vid="PRO 8:1">وجَهارًا تَرفَعُ صوتَها.<verse eid="PRO 8:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 8:2" />مِنْ على رُؤوسِ القِمَمِ</para>
  <para style="p" vid="PRO 8:2">وفي الدُّروبِ ومَفارِقِ الطُّرُقاتِ،<verse eid="PRO 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 8:3" />وبجانِبِ الأبوابِ عِندَ مَدخَلِ المدينةِ،</para>
  <para style="p" vid="PRO 8:3">وفي النَّوافذِ ها هيَ تَصيحُ:<verse eid="PRO 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 8:4" />أنا أُناديكُم أيُّها النَّاسُ</para>
  <para style="p" vid="PRO 8:4">وأقولُ لكُم يا بني آدمَ:<verse eid="PRO 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 8:5" />على الجُهَّالِ أنْ يتَعَقَّلوا،</para>
  <para style="p" vid="PRO 8:5">وعلى البُلَداءِ أنْ يتَعَلَّموا الفهْمَ.<verse eid="PRO 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 8:6" />بالكَلامِ الصَّريحِ أنطِقُ فاَسمَعوا،</para>
  <para style="p" vid="PRO 8:6">وبالاَستقامةِ أفتَحُ شفَتَيَّ،<verse eid="PRO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 8:7" />لأنَّ فَمي يلهَجُ بالصِّدْقِ،</para>
  <para style="p" vid="PRO 8:7">وشفَتَيَّ تَمقُتانِ الكَذِبَ.<verse eid="PRO 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 8:8" />كَلامُ فَمي كُلُّه صِدْقٌ،</para>
  <para style="p" vid="PRO 8:8">لا اَلتواءَ فيهِ ولا اَعْوِجاجَ.<verse eid="PRO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 8:9" />كُلُّهُ مُقْنِع لدَى الفهيمِ،</para>
  <para style="p" vid="PRO 8:9">وقويمٌ عِندَ مَنْ وجَدَ المعرِفةَ.<verse eid="PRO 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 8:10" />خُذوا مَشورتي لا الفِضَّةَ،</para>
  <para style="p" vid="PRO 8:10">واَخْتاروا المعرِفةَ لا الذَّهَبَ.<verse eid="PRO 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 8:11" />فالحِكمةُ خَيرٌ مِنَ الّلآلئِ،</para>
  <para style="p" vid="PRO 8:11">وكُلُّ الجواهِرِ لا تُساوِيها.<verse eid="PRO 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 8:12" />تقولُ: أنا معَ رَجاحةِ العقلِ،</para>
  <para style="p" vid="PRO 8:12">وليَ المعرِفَةُ وحُسْنُ التَّدبيرِ.<verse eid="PRO 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 8:13" />مَنْ يَخَفِ الرّبَّ يُبغِضِ الشَّرَّ.</para>
  <para style="p" vid="PRO 8:13">ويُبغضِ الجاهَ والزَّهوَ</para>
  <para style="p" vid="PRO 8:13">وطريقَ الرُّعاعِ وكَلامَ الكَذِبِ.<verse eid="PRO 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 8:14" />ليَ المشورَةُ وحُسْنُ الرَّأيِ.</para>
  <para style="p" vid="PRO 8:14">أنا الفِطنةُ، والجبَروتُ لي.<verse eid="PRO 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 8:15" />بيَ المُلوكُ يَملِكونَ</para>
  <para style="p" vid="PRO 8:15">والحُكَّامُ يحكُمونَ بالعَدلِ.<verse eid="PRO 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 8:16" />بيَ الرُّؤساءُ يَرأسونَ</para>
  <para style="p" vid="PRO 8:16">والأمَراءُ يقضونَ في الأرضِ.<verse eid="PRO 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 8:17" />أُحِبُّ الّذينَ يُحِبُّونَني،</para>
  <para style="p" vid="PRO 8:17">ومَنْ بكَّرَ في طَلَبي وجَدَني.<verse eid="PRO 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 8:18" />الغِنى والكرامةُ معي</para>
  <para style="p" vid="PRO 8:18">ودوامُ الثَّروةِ والرَّخاءُ.<verse eid="PRO 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="PRO 8:19" />ثمَري خَيرٌ مِنَ الذَّهَبِ الإبريزِ</para>
  <para style="p" vid="PRO 8:19">وغَلَّتي خَيرٌ مِنَ الفِضَّةِ النَّقِيَّةِ.<verse eid="PRO 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="PRO 8:20" />أسيرُ في طريقِ الحَقِّ</para>
  <para style="p" vid="PRO 8:20">وأجتازُ مَسالِكَ الإنصافِ،<verse eid="PRO 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 8:21" />فأُورِّثُ مَنْ يُحِبُّونَني</para>
  <para style="p" vid="PRO 8:21">وأملأُ خَزائِنَهم كُنُوزًا.<verse eid="PRO 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="PRO 8:22" />الرّبُّ اَقتناني أوَّلَ ما خَلَقَ</para>
  <para style="p" vid="PRO 8:22">مِنْ قديمِ أعمالِهِ في الزَّمانِ.<verse eid="PRO 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="PRO 8:23" />مِنَ الأزلِ صنَعَني، مِنَ البَدءِ،</para>
  <para style="p" vid="PRO 8:23">مِنْ قَبلِ أنْ كانتِ الأرضُ.<verse eid="PRO 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="PRO 8:24" />وُجِدتُ وما كانَ غَمْرٌ،</para>
  <para style="p" vid="PRO 8:24">ولا مياهٌ في قلبِ الينابيعِ.<verse eid="PRO 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="PRO 8:25" />قَبلَ أنْ تُخْلَقَ الجِبالُ</para>
  <para style="p" vid="PRO 8:25">وقَبلَ التِّلالِ وُجِدْتُ،<verse eid="PRO 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="PRO 8:26" />حينَ لم تكُنْ أرضٌ ولا مياهٌ،</para>
  <para style="p" vid="PRO 8:26">ولا حَفنةٌ مِنْ تُرابِ الكَونِ.<verse eid="PRO 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="PRO 8:27" />وكُنتُ حينَ كوَّنَ السَّماواتِ</para>
  <para style="p" vid="PRO 8:27">وحَوَّقَ حولَ وجهِ الغَمْرِ،<verse eid="PRO 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="PRO 8:28" />وثَبَّتَ الغُيومَ في العَلاءِ</para>
  <para style="p" vid="PRO 8:28">وفَجَّرَ ينابيعَ المياهِ.<verse eid="PRO 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="PRO 8:29" />وكُنتُ حينَ حَوَّطَ البحرَ</para>
  <para style="p" vid="PRO 8:29">فلا تَعبُرُ المياهُ حُدودَهُ،</para>
  <para style="p" vid="PRO 8:29">وحينَ أرسى أساساتِ الأرضِ.<verse eid="PRO 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="PRO 8:30" />وكُنتُ حيالَهُ بأمانٍ،</para>
  <para style="p" vid="PRO 8:30">وفي بَهجةٍ يومًا بَعدَ يومٍ،</para>
  <para style="p" vid="PRO 8:30">ضاحِكًا أمامَهُ كُلَّ حينٍ،<verse eid="PRO 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" pubnumber="31" sid="PRO 8:31" />ضاحِكًا في أرضِهِ الآهلةِ،</para>
  <para style="p" vid="PRO 8:31">ومُبتَهجًا معَ بَني البشَرِ.<verse eid="PRO 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" pubnumber="32" sid="PRO 8:32" />إسمَعوا لي أيُّها الأبناءُ،</para>
  <para style="p" vid="PRO 8:32">فهَنيئًا لِمَنْ يَتبَعُ طُرُقي<verse eid="PRO 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" pubnumber="33" sid="PRO 8:33" />إسمَعوا المَشورَةَ وكُونوا حُكَماءَ،</para>
  <para style="p" vid="PRO 8:33">ولا تَنبِذُوا ما أقُولُهُ لكُم.<verse eid="PRO 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" pubnumber="34" sid="PRO 8:34" />هَنيئًا لِمَنْ يَستَمِعُ إليَّ</para>
  <para style="p" vid="PRO 8:34">ساهِرًا عِندَ بابي كُلَّ يومٍ.</para>
  <para style="p" vid="PRO 8:34">ناطرًا بجانبِ مَدخَلِ داري.<verse eid="PRO 8:34" /></para>
  <para style="p">
    <verse number="35" style="v" pubnumber="35" sid="PRO 8:35" />مَنْ وجَدَني وجَدَ الحياةَ</para>
  <para style="p" vid="PRO 8:35">ونالَ رِضىً مِنَ الرّبِّ.<verse eid="PRO 8:35" /></para>
  <para style="p">
    <verse number="36" style="v" pubnumber="36" sid="PRO 8:36" />مَنْ أخطأني أضَرَّ نفْسَهُ،</para>
  <para style="p" vid="PRO 8:36">ومَنْ أبغَضَني أحبَّ الموتَ.<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s1">الحكمة والجهالة</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 9:1" />الحِكمةُ بنَت بَيتَها</para>
  <para style="p" vid="PRO 9:1">ونحَتَت أعمِدَتَها السَّبعةَ.<verse eid="PRO 9:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 9:2" />ذبَحَت ذبائِحَها ومزَجَت خمرَها،</para>
  <para style="p" vid="PRO 9:2">وهيَّأت مائِدةَ طَعامِها.<verse eid="PRO 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 9:3" />أرسَلَت جَواريَها تُنادي</para>
  <para style="p" vid="PRO 9:3">مِنْ فَوقِ أعالي المدينةِ:<verse eid="PRO 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 9:4" />”حَيِّدْ إلى هُنا يا جاهلُ!“</para>
  <para style="p" vid="PRO 9:4">وتقولُ لِمَنْ يُعوِزُهُ الفهْمُ:<verse eid="PRO 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 9:5" />”تعالَ كُلْ مِنْ طَعامي</para>
  <para style="p" vid="PRO 9:5">واَشربِ الخمرَ الّتي مزَجْتُ“.<verse eid="PRO 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 9:6" />أُتركوا الجَهالةَ فتَحيَوا،</para>
  <para style="p" vid="PRO 9:6">وسيروا في طريقِ الفِطنَةِ.<verse eid="PRO 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 9:7" />مَنْ أدَّبَ السَّاخرَ يُهانُ،</para>
  <para style="p" vid="PRO 9:7">ومَنْ وَبّخَ الشِّرِّيرَ يُعابُ.<verse eid="PRO 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 9:8" />تؤنِّبُ السَّاخرَ فيُبغِضُكَ،</para>
  <para style="p" vid="PRO 9:8">وتَلومُ الحكيمَ فيُحِبُّكَ.<verse eid="PRO 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 9:9" />أفِدِ الحكيمَ فيزدادَ حِكمةً</para>
  <para style="p" vid="PRO 9:9">وعَلِّمِ الصِّدِّيقَ فيزدادَ عِلْمُهُ.<verse eid="PRO 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 9:10" />بَدءُ الحِكْمةِ أنْ تخافَ الرّبَّ</para>
  <para style="p" vid="PRO 9:10">وتتَبَيَّنَ مَعرِفةَ القدُّوسِ.<verse eid="PRO 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 9:11" />بها تَكثُرُ أيّامُكَ</para>
  <para style="p" vid="PRO 9:11">وتتَزايدُ سِنُوّ حياتِكَ.<verse eid="PRO 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 9:12" />إنْ كُنتَ حكيمًا فلِنَفسِكَ،</para>
  <para style="p" vid="PRO 9:12">أو ساخِرًا فعلَيكَ وحدَكَ.<verse eid="PRO 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 9:13" />المَرأةُ البليدَةُ ثرثارَةٌ،</para>
  <para style="p" vid="PRO 9:13">جاهِلةٌ لا تَعرِفُ شيئًا.<verse eid="PRO 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 9:14" />تَجلِسُ عِندَ بابِ بَيتِها</para>
  <para style="p" vid="PRO 9:14">على مَقعَدٍ في أعالي المدينةِ<verse eid="PRO 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 9:15" />وتقولُ لِعابِرِي الطَّريقِ،</para>
  <para style="p" vid="PRO 9:15">السَّائرينَ في حالِ سبيلِهِم:<verse eid="PRO 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 9:16" />”حَيِّدْ إلى هُنا يا جاهلُ“.</para>
  <para style="p" vid="PRO 9:16">وتقولُ لِمَنْ يُعوزُهُ الفهْمُ:<verse eid="PRO 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 9:17" />”تَجَرَّعْ مياهَ العاهِرةِ،</para>
  <para style="p" vid="PRO 9:17">وتَنَعَّمْ بِخُبزها في الخِفيَةِ“.<verse eid="PRO 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 9:18" />ظِلالُ الموتِ، لو يَعرِفُ، عِندَها!</para>
  <para style="p" vid="PRO 9:18">وفي أعماقِ عالَمِ الأمواتِ ضُيوفُها.<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="s1">أمثال سليمان</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 10:1" />الاَبنُ الحكيمُ يُفَرِّحُ أباهُ</para>
  <para style="p" vid="PRO 10:1">والاَبنُ البليدُ حسْرَةٌ لأُمِّهِ.<verse eid="PRO 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 10:2" />كُنوزُ الشَّرِّ لا تُعيلُ العيالَ،</para>
  <para style="p" vid="PRO 10:2">والصِّدْقُ يُنقِذُ مِنَ الموتِ.<verse eid="PRO 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 10:3" />الرّبُّ لا يُقاوِمُ رَغبةَ الصِّدِّيقينَ،</para>
  <para style="p" vid="PRO 10:3">وأمَّا هوى الأشرارِ فيَصُدُّهُ.<verse eid="PRO 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 10:4" />مَنْ عَمِلَ بيدٍ مُرتخيةٍ يَفتَقِرْ،</para>
  <para style="p" vid="PRO 10:4">ومنْ عَمِلَ بيدٍ مُجتَهِدَةٍ يَغتَنِ<verse eid="PRO 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 10:5" />مَنْ يَكُنْ عاقِلًا يحصُدْ في الصَّيفِ،</para>
  <para style="p" vid="PRO 10:5">وأمَّا المَعتوهُ فينامُ في الحصادِ.<verse eid="PRO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 10:6" />البركاتُ تَغمُرُ رأسَ الصِّدِّيقِ،</para>
  <para style="p" vid="PRO 10:6">والعُنْفُ يَملأُ فَمَ الشِّرِّيرِ.<verse eid="PRO 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 10:7" />ذِكْرُ الصِّدِّيقِ برَكةٌ،</para>
  <para style="p" vid="PRO 10:7">واَسمُ الشِّرِّيرِ يَبلَى.<verse eid="PRO 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 10:8" />الحكيمُ القلبِ يقبَلُ الوصايا،</para>
  <para style="p" vid="PRO 10:8">والأحمقُ في كَلامِهِ يتَهوَّرُ.<verse eid="PRO 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 10:9" />مَنْ يَسلُكْ بنزاهةٍ يَسلُكْ مُطمَئِنًّا</para>
  <para style="p" vid="PRO 10:9">ومَنْ يُعوِّجْ طُرُقَهُ يَفتَضِحْ.<verse eid="PRO 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 10:10" />مَنْ يَغمِزُ بالعينِ يُثيرُ الغضَبَ،</para>
  <para style="p" vid="PRO 10:10">والأحمقُ في كَلامِهِ يتَهوَّرُ.<verse eid="PRO 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 10:11" />فَمُ الصِّدِّيقِ يُنبوعُ حياةٍ،</para>
  <para style="p" vid="PRO 10:11">وفمُ الشِّرِّيرِ يَملأُهُ العُنْفُ.<verse eid="PRO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 10:12" />البُغضُ يُثيرُ الخُصوماتِ،</para>
  <para style="p" vid="PRO 10:12">والمَحَبَّةُ تستُرُ كُلَّ الذُّنوبِ.<verse eid="PRO 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 10:13" />الحِكمةُ تُوجَدُ في كلامِ الفهيمِ،</para>
  <para style="p" vid="PRO 10:13">والعصا لِظَهرِ مَنْ يُعوِزُهُ الفهْمُ.<verse eid="PRO 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 10:14" />الحُكَماءُ يَصونونَ المَعرِفةَ،</para>
  <para style="p" vid="PRO 10:14">وكلامُ الأحمقِ هلاكٌ قريبٌ.<verse eid="PRO 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 10:15" />مالُ الغَنيِّ حِصْنُهُ الحَصينُ،</para>
  <para style="p" vid="PRO 10:15">وفَقْرُ الفُقراءِ هلاكُهُم.<verse eid="PRO 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 10:16" />رِزْقُ الصِّدِّيقِ للحياةِ،</para>
  <para style="p" vid="PRO 10:16">وغَلَّةُ الشِّرِّيرِ الخَطيئَةِ.<verse eid="PRO 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 10:17" />مَنْ حَفِظَ المَشورَةَ فسَبيلُهُ الحياةُ،</para>
  <para style="p" vid="PRO 10:17">ومَنْ أهمَلَ التَّوبيخَ فهو ضالٌّ.<verse eid="PRO 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 10:18" />شفَتا الكَذِبِ تُخفيانِ البُغضَ،</para>
  <para style="p" vid="PRO 10:18">والبليدُ يُجاهِرُ بالنَّميمةِ.<verse eid="PRO 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="PRO 10:19" />كثرَةُ الكلامِ لا تَخلو مِنَ الخطأِ،</para>
  <para style="p" vid="PRO 10:19">ومَنْ ضبَطَ شفَتَيهِ فهوَ عاقِلٌ.<verse eid="PRO 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="PRO 10:20" />لِسانُ الصِّدِّيقِ فِضَّةٌ نقِيَّةٌ،</para>
  <para style="p" vid="PRO 10:20">وقلبُ الشِّرِّيرِ لا نَفْعَ فيهِ.<verse eid="PRO 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 10:21" />أقوالُ الصِّدِّيقِ تحفَظُ الكثيرينَ.</para>
  <para style="p" vid="PRO 10:21">وحماقةُ ناقِصِ الفهْمِ تُميتُهُ.<verse eid="PRO 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="PRO 10:22" />برَكَةُ الرّبِّ هيَ الّتي تُغْني،</para>
  <para style="p" vid="PRO 10:22">وكَثرةُ التَّعَبِ لا تزيدُ شيئًا.<verse eid="PRO 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="PRO 10:23" />البليدُ يَلهو بالرَّذيلَةِ،</para>
  <para style="p" vid="PRO 10:23">أمَّا الفهيمُ فبِالحِكمةِ.<verse eid="PRO 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="PRO 10:24" />ما يَخافُهُ الشِّرِّيرُ يقَعُ علَيهِ،</para>
  <para style="p" vid="PRO 10:24">وما يتَمَنَّاهُ الصِّدِّيقُ يَنالُهُ.<verse eid="PRO 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="PRO 10:25" />تَعبُرُ الزَّوبعةُ فيَزولُ الشِّرِّيرُ،</para>
  <para style="p" vid="PRO 10:25">أمَّا الصِّدِّيقُ فيَسودُ إلى الأبدِ.<verse eid="PRO 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="PRO 10:26" />كالحامِضِ لِلأسنانِ والدُّخانِ للعينِ</para>
  <para style="p" vid="PRO 10:26">كذلِكَ البطَّالُ للّذينَ يُرسلونَهُ.<verse eid="PRO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="PRO 10:27" />مَنْ يَخَفِ الرّبَّ فأيّامُهُ تَطولُ،</para>
  <para style="p" vid="PRO 10:27">أمّا سِنُوُّ الأشرارِ فتَقصُرُ.<verse eid="PRO 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="PRO 10:28" />رَجاءُ الصِّدِّيقينَ فرَحٌ لهُم،</para>
  <para style="p" vid="PRO 10:28">وأملُ الأشرارِ يَبيدُ.<verse eid="PRO 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="PRO 10:29" />الرّبُّ حِصنٌ للصَّالحينَ</para>
  <para style="p" vid="PRO 10:29">وهلاكٌ لِفاعِلي الإثْمِ.<verse eid="PRO 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="PRO 10:30" />الصِّدِّيقُ لا يضْطَربُ أبدًا،</para>
  <para style="p" vid="PRO 10:30">والشِّرِّيرُ لا يَستَقِرُّ في الأرضِ.<verse eid="PRO 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" pubnumber="31" sid="PRO 10:31" />فَمُ الصِّدِّيقِ يُنبِتُ الحكمةَ،</para>
  <para style="p" vid="PRO 10:31">أمَّا لِسانُ الكَذِبِ فيُقطَعُ.<verse eid="PRO 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" pubnumber="32" sid="PRO 10:32" />شفَتا الصِّدِّيق تَبوحانِ بما يُرضي،</para>
  <para style="p" vid="PRO 10:32">وفَمُ الشِّرِّيرِ يَنطِقُ بالأكاذيبِ.<verse eid="PRO 10:32" /></para>
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 11:1" />ميزانُ الغِشِّ يَمقُتُهُ الرّبُّ،</para>
  <para style="p" vid="PRO 11:1">والمِعيارُ السَّليمُ يَنالُ رِضاهُ.<verse eid="PRO 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 11:2" />معَ التَطَرُّفِ تَجيءُ الفضيحةُ،</para>
  <para style="p" vid="PRO 11:2">ومعَ الاعتِدالِ الحِكمةُ.<verse eid="PRO 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 11:3" />نزاهةُ المُستقيمينَ تَهديهِم،</para>
  <para style="p" vid="PRO 11:3">واَعوجاجُ الغادرينَ يُهلكُهُم.<verse eid="PRO 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 11:4" />لا يُعينُ المالُ في يومِ العِقابِ،</para>
  <para style="p" vid="PRO 11:4">والصِّدْقُ يُنَجِّي منَ الموتِ.<verse eid="PRO 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 11:5" />صِدْقُ الصَّالحينَ يُيَسِّرُ طريقَهُم،</para>
  <para style="p" vid="PRO 11:5">والأشرارُ بِشَرِّهِم يَسقُطونَ.<verse eid="PRO 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 11:6" />صِدْقُ المُستَقيمينَ يُنقِذُهُم،</para>
  <para style="p" vid="PRO 11:6">والغادرونَ بأهوائِهِم يُؤخذونَ.<verse eid="PRO 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 11:7" />أمَلُ الشِّرِّيرِ يَبيدُ بِموتِهِ،</para>
  <para style="p" vid="PRO 11:7">ورجاءُ الأثيمِ يزولُ.<verse eid="PRO 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 11:8" />الصِّدِّيقُ يخلُصُ مِنَ الضِّيقِ،</para>
  <para style="p" vid="PRO 11:8">فيَحِلُّ الشِّرِّيرُ مكانَهُ.<verse eid="PRO 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 11:9" />كَلامُ النِّفاقِ يُفسِدُ صاحبَهُ.</para>
  <para style="p" vid="PRO 11:9">وبالمَعرِفةِ يخلُصُ الصِّدِّيقونَ.<verse eid="PRO 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 11:10" />بِصلاحِ الصِّدِّيقينَ تَغتَبِطُ المدينَةُ،</para>
  <para style="p" vid="PRO 11:10">بإبادةِ الأشرارِ تَطْرَبُ.<verse eid="PRO 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 11:11" />بِبَركةِ المُستَقيمينَ تعلو المدينةُ،</para>
  <para style="p" vid="PRO 11:11">وبكلامِ الأشرارِ تَنهَدِمُ.<verse eid="PRO 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 11:12" />ناقصُ الفَهْمِ يُهينُ الآخرينَ،</para>
  <para style="p" vid="PRO 11:12">أمَّا الفهيمُ فيَلزَمُ الصَّمتَ.<verse eid="PRO 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 11:13" />السَّاعي بالنَّميمةِ يُفشي السِّرَّ،</para>
  <para style="p" vid="PRO 11:13">والأمينُ القلبِ يَكتُمُهُ.<verse eid="PRO 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 11:14" />بِغيرِ هِدايةٍ يَسقُطُ الشَّعبُ،</para>
  <para style="p" vid="PRO 11:14">وبِكَثرةِ الواعظينَ يخلُصُ.<verse eid="PRO 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 11:15" />مَنْ كَفِلَ الأجنبيَّ نالَهُ السُّوءُ،</para>
  <para style="p" vid="PRO 11:15">ومَنْ لم يَضمَنِ الآخرينَ اَطمَأنَّ.<verse eid="PRO 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 11:16" />المَرأةُ الحنونُ تَحظى بالكرامَةِ،</para>
  <para style="p" vid="PRO 11:16">والشُّرَفاءُ يَحظَونَ بالغِنى.<verse eid="PRO 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 11:17" />الرَّحيمُ يُحسِنُ إلى نَفسِهِ،</para>
  <para style="p" vid="PRO 11:17">والقاسي يُعَكِّرُ مِزاجَهُ.<verse eid="PRO 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 11:18" />الشِّرِّيرُ يكسِبُ أجرًا زائِفًا،</para>
  <para style="p" vid="PRO 11:18">ولِزارعِ العَدلِ ثوابٌ أكيدٌ.<verse eid="PRO 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="PRO 11:19" />العَدلُ يؤدِّي إلى الحياةِ،</para>
  <para style="p" vid="PRO 11:19">ومَنِ اَتَّبعَ السُّوءَ فلِمَوتِهِ.<verse eid="PRO 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="PRO 11:20" />إعوجاجُ القلبِ يَمقُتُه الرّبُّ،</para>
  <para style="p" vid="PRO 11:20">والسِّيرَةُ الصَّالِحةُ مَرضاةٌ لهُ.<verse eid="PRO 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 11:21" />الشِّرِّيرُ لا يتَبَرَّرُ أبدًا،</para>
  <para style="p" vid="PRO 11:21">ونَسلُ الصِّدِّيقِ يَنجو.<verse eid="PRO 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="PRO 11:22" />جمالُ اَمرأةٍ لا خيرَ فيها،</para>
  <para style="p" vid="PRO 11:22">خاتَمٌ مِنْ ذهَبٍ في أنفِ خِنزيرةٍ.<verse eid="PRO 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="PRO 11:23" />ما يتَمَنَّاهُ الصِّدِّيقونَ خَيرٌ كُلُّهُ،</para>
  <para style="p" vid="PRO 11:23">وأملُ الأشرارِ أمَلٌ عابرٌ.<verse eid="PRO 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="PRO 11:24" />هُناكَ مَنْ يُنفِقُ فيزدادُ،</para>
  <para style="p" vid="PRO 11:24">ومَنْ يَدَّخرُ فيَسيرُ إلى الفَقْرِ.<verse eid="PRO 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="PRO 11:25" />مَنْ أعطى بِسخاءٍ يُعطَى،</para>
  <para style="p" vid="PRO 11:25">والّذي يُروي الآخرينَ يُروَى.<verse eid="PRO 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="PRO 11:26" />مَنْ مَنَعَ الحِنطَةَ خاصَمَهُ الشَّعبُ،</para>
  <para style="p" vid="PRO 11:26">ومنْ أعطاها فعَلَيهِ البرَكَةُ.<verse eid="PRO 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="PRO 11:27" />مَنْ يَطلُبِ الخَيرَ يلتَمِسْ رِضا اللهِ،</para>
  <para style="p" vid="PRO 11:27">ومَنْ يَطلبِ السُّوءَ فالسُّوءُ يَلحقُهُ.<verse eid="PRO 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="PRO 11:28" />مَنْ يَتَّكِلْ على غِناهُ يَسقُطْ،</para>
  <para style="p" vid="PRO 11:28">والصِّدِّيقونَ يَزهَونَ كالأغصانِ.<verse eid="PRO 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="PRO 11:29" />مَنْ يُعَكِّرْ بَيتَهُ يَرِثِ الرِّيحَ،</para>
  <para style="p" vid="PRO 11:29">والأحمقُ خادِمٌ للحكيمِ القلبِ.<verse eid="PRO 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="PRO 11:30" />ثمَرَةُ الصِّدِّيقِ شجَرةُ حياةٍ،</para>
  <para style="p" vid="PRO 11:30">ومَنْ كانَ حكيمًا رَبِحَ النَّاسَ.<verse eid="PRO 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" pubnumber="31" sid="PRO 11:31" />الصِّدِّيقُ يُعاقَبُ في الدُّنيا،</para>
  <para style="p" vid="PRO 11:31">فكيفَ الشِّرِّيرُ والخاطئُ.<verse eid="PRO 11:31" /></para>
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 12:1" />مَنْ يُحِبُّ المَشورةَ يُحِبُّ المَعرِفةَ،</para>
  <para style="p" vid="PRO 12:1">ومَنْ يُبغِضُ التَّوبيخَ فهو غبيٌّ.<verse eid="PRO 12:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 12:2" />الرّبُّ يَرضى عَنِ الصَّالِحينَ</para>
  <para style="p" vid="PRO 12:2">ويَدينُ مَنْ يذمُّ الآخرينَ.<verse eid="PRO 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 12:3" />الإنسانُ لا يَثبُتُ بالشَّرِّ</para>
  <para style="p" vid="PRO 12:3">ومَنْ كانَ صِدِّيقًا لا يتَزَعزَعُ.<verse eid="PRO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 12:4" />المرأةُ القديرةُ تاجٌ لِزَوجِها.</para>
  <para style="p" vid="PRO 12:4">والمَعتوهَةُ نَخْرٌ في عِظامِهِ.<verse eid="PRO 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 12:5" />أفكارُ الصِّدِّيقينَ عَدلٌ،</para>
  <para style="p" vid="PRO 12:5">وهدايةُ الأشرارِ مَكْرٌ.<verse eid="PRO 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 12:6" />كَلامُ الأشرارِ كَمينٌ لِلقَتلِ،</para>
  <para style="p" vid="PRO 12:6">أمّا كلامُ المُستَقيمينَ فنَجاةٌ.<verse eid="PRO 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 12:7" />يَنقَلِبُ الأشرارُ فيَزولُونَ،</para>
  <para style="p" vid="PRO 12:7">أمّا بَيتُ الصِّدِّيقينَ فيَثبُتُ.<verse eid="PRO 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 12:8" />الإنسانُ يُمتَدحُ لِتَعَقُّلِهِ،</para>
  <para style="p" vid="PRO 12:8">ولضلالِ قلبِهِ يُحتَقرُ.<verse eid="PRO 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 12:9" />العامِلُ قليلًا ولِنفْسِهِ،</para>
  <para style="p" vid="PRO 12:9">خَيرٌ مِنْ مُكابِدٍ يُعوِزُهُ الخبزُ.<verse eid="PRO 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 12:10" />الصِّدِّيقُ يَصونُ حتَّى حياةَ بَهيمَتِهِ،</para>
  <para style="p" vid="PRO 12:10">أمَّا الشِّرِّيرُ فقلبُهُ لا يَرحَمُ.<verse eid="PRO 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 12:11" />مَنْ فلَحَ أرضَهُ شَبِعَ خُبزًا،</para>
  <para style="p" vid="PRO 12:11">ومَنْ تَبِعَ البَطَّالينَ أعوَزَهُ الفهْمُ.<verse eid="PRO 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 12:12" />مَدْحُ الشِّرِّيرِ مَصيَدَةٌ لهُ،</para>
  <para style="p" vid="PRO 12:12">والثَّناءُ على الصِّدِّيقِ يُفسِدُهُ.<verse eid="PRO 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 12:13" />زَلَلُ الشَّفَتَينِ يُوقِعُ في السُّوءِ،</para>
  <para style="p" vid="PRO 12:13">أمَّا الصِّدِّيقُ فيَخرُجُ مِنَ الضِّيقِ.<verse eid="PRO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 12:14" />مَنْ طابَ كَلامُهُ يُجازَى خَيرًا،</para>
  <para style="p" vid="PRO 12:14">وعلى حُسْنِ أعمالِهِ يُجازَى.<verse eid="PRO 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 12:15" />طريقُ الأحمقِ قويمٌ في عينَيهِ،</para>
  <para style="p" vid="PRO 12:15">أمَّا الحكيمُ فيَسمَعُ ويَتَّعِظُ.<verse eid="PRO 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 12:16" />كدَرُ الأحمقِ يُعرَفُ في الحالِ،</para>
  <para style="p" vid="PRO 12:16">وهَوانُ الرَّجلِ الذَكيِّ يُحيطُهُ الكتمانُ.<verse eid="PRO 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 12:17" />الشَّاهدُ الصَّادِقُ يَنشُرُ الحَقَّ،</para>
  <para style="p" vid="PRO 12:17">والشَّاهدُ الكاذِبُ يُظهِرُ المَكْرَ.<verse eid="PRO 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 12:18" />هُناكَ مَنْ كَلامُهُ كطَعْنِ الحَربةِ،</para>
  <para style="p" vid="PRO 12:18">أمَّا كَلامُ الحكيمِ ففيهِ الشِّفاءُ.<verse eid="PRO 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="PRO 12:19" />القولُ الصَّادِقُ يَثبُتُ إلى الأبدِ،</para>
  <para style="p" vid="PRO 12:19">أمَّا الكَذِبُ فحَبْلُهُ قصيرٌ.<verse eid="PRO 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="PRO 12:20" />المَكْرُ في قلبِ مَنْ يَزرَعُ السُّوءَ،</para>
  <para style="p" vid="PRO 12:20">والفرَحُ لِمَنْ يَعِظُ بالسَّلامِ.<verse eid="PRO 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 12:21" />الصِّدِّيقُ لا يَلحَقُهُ إثْمٌ،</para>
  <para style="p" vid="PRO 12:21">أمَّا الأشرارُ فكلُّهُم سُوءٌ.<verse eid="PRO 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="PRO 12:22" />كَلامُ الكَذِبِ يَمقُتُهُ الرّبُّ،</para>
  <para style="p" vid="PRO 12:22">ويَرضَى عَنِ العامِلينَ بالحَقِّ.<verse eid="PRO 12:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="PRO 12:23" />الرّجلُ الذَّكيُّ يَكتُمُ مَعرِفَتَهُ،</para>
  <para style="p" vid="PRO 12:23">والبليدُ يُعلِنُ حماقةَ قلبِهِ.<verse eid="PRO 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="PRO 12:24" />الأيدي المُجتَهِدةُ تَسودُ،</para>
  <para style="p" vid="PRO 12:24">والمُرتَخيةُ تَخدُمُ بالسُّخرةِ.<verse eid="PRO 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="PRO 12:25" />القلَقُ في قلبِ الإنسانِ يُؤلِمُهُ،</para>
  <para style="p" vid="PRO 12:25">والكَلِمةُ الطَّيِّبَةُ تُفرِّحُهُ.<verse eid="PRO 12:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="PRO 12:26" />الصِّدِّيقُ قُدوَةٌ للآخرينَ،</para>
  <para style="p" vid="PRO 12:26">وطريقُ الأشرارِ تُضَلِّلُهُم.<verse eid="PRO 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="PRO 12:27" />الخامِلُ لا يُصيبُ صيدًا،</para>
  <para style="p" vid="PRO 12:27">وأثمَنُ ما عِندَ الإنسانِ حِرْصُهُ.<verse eid="PRO 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="PRO 12:28" />في السَّبيلِ الصَّادِقِ حياةٌ</para>
  <para style="p" vid="PRO 12:28">وفي الرُّجوعِ عَنهُ موتٌ.<verse eid="PRO 12:28" /></para>
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 13:1" />الابنُ الحكيمُ يَقبَلُ مَشورَةَ أبيهِ،</para>
  <para style="p" vid="PRO 13:1">وأمَّا السَّاخرُ فلا يَسمَعُ التَّأنيبَ.<verse eid="PRO 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 13:2" />مَنْ طابَ كَلامُهُ يُجازَى خَيرًا،</para>
  <para style="p" vid="PRO 13:2">وشهوَةُ الغادِرينَ العُنْفُ.<verse eid="PRO 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 13:3" />مَنْ يَضبُطْ فَمَهُ يَحفَظْ حياتَهُ،</para>
  <para style="p" vid="PRO 13:3">ومَنْ تُثَرثِرْ شَفتاهُ يَهلِكْ.<verse eid="PRO 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 13:4" />البَطَّالُ يتَمَنَّى ولا يَنالُ،</para>
  <para style="p" vid="PRO 13:4">والمُجتهدُ يَنجَحُ فَيَغنى.<verse eid="PRO 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 13:5" />الصِّدِّيقُ يُبغِضُ كَلامَ الكَذِبِ،</para>
  <para style="p" vid="PRO 13:5">أمَّا الشِّرِّيرُ فيُشجِّعُهُ ويَحميهِ.<verse eid="PRO 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 13:6" />الصِدْقُ يَصونُ السَّالكينَ في الكمالِ،</para>
  <para style="p" vid="PRO 13:6">والشَّرُّ يَسبُقُ خطواتِهِم.<verse eid="PRO 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 13:7" />مِنَ الأغنياءِ مَنْ يَدَّعي الفَقرَ،</para>
  <para style="p" vid="PRO 13:7">ومِنَ الفقراءِ مَنْ يَدَّعي الغِنى.<verse eid="PRO 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 13:8" />الغنيُّ يُكَفِّرُ عَنهُ مالُهُ،</para>
  <para style="p" vid="PRO 13:8">والفقيرُ لا يَجِدُ مَنْ يَفديهِ.<verse eid="PRO 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 13:9" />نورُ الصِّدِّيقينَ فرَحٌ كُلُّهُ،</para>
  <para style="p" vid="PRO 13:9">وسِراجُ الأشرارِ يَنطَفئُ.<verse eid="PRO 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 13:10" />التَّطَرُّفُ لا يَلِدُ إلَّا المُشاجرَةَ،</para>
  <para style="p" vid="PRO 13:10">والحِكمةُ عِندَ مَنْ يَتَّعِظُ بِسِواهُ.<verse eid="PRO 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 13:11" />مالُ البَطَّالِ يتَناقصُ،</para>
  <para style="p" vid="PRO 13:11">ومالٌ تَجمَعُهُ باليَدِ يَزدادُ.<verse eid="PRO 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 13:12" />رَجاءٌ مَشكوكٌ فيهِ يُعِلُّ القلبَ،</para>
  <para style="p" vid="PRO 13:12">والأماني إذا تحَقَّقَت شجَرَةُ حياةٍ.<verse eid="PRO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 13:13" />مَنِ اَسْتهانَ بالكَلِمةِ يَهلِكْ،</para>
  <para style="p" vid="PRO 13:13">ومَنِ اَحتَرَمَ الوصيَّةَ يَسلَمْ.<verse eid="PRO 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 13:14" />نصيحةُ الحكيمِ يُنبُوعُ حياةٍ،</para>
  <para style="p" vid="PRO 13:14">وبها تَبتَعِدُ عَنْ أشراكِ الموتِ.<verse eid="PRO 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 13:15" />حُسْنُ التَّعَقُّلِ يُكسِبُ هَيبةً.</para>
  <para style="p" vid="PRO 13:15">وطريقُ الغادِرينَ وَعِرَةٌ.<verse eid="PRO 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 13:16" />الرَّجلُ الذَّكيُّ يعمَلُ بِمَعرِفةٍ،</para>
  <para style="p" vid="PRO 13:16">والكَسولُ يَنشُرُ الحماقَةَ.<verse eid="PRO 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 13:17" />الرَّسولُ الشِّرِّيرُ يُوقِعُ في السُّوءِ،</para>
  <para style="p" vid="PRO 13:17">والسَّفيرُ الأمينُ يأتي بالهَناءِ.<verse eid="PRO 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 13:18" />الفَقرُ والهوانُ لِمَنْ يَنبُذُ المَشورَةَ</para>
  <para style="p" vid="PRO 13:18">والكرامةُ كُلُّها لِمَنْ يَقبَلُ التَّوبيخَ.<verse eid="PRO 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="PRO 13:19" />تحَقُّقُ الأماني يَجلو النَّفْسَ.</para>
  <para style="p" vid="PRO 13:19">واَجتنابُ السُّوءِ يَمقُتُهُ البُلَداءُ.<verse eid="PRO 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="PRO 13:20" />مَنْ سايَرَ الحُكماءَ صارَ حكيمًا،</para>
  <para style="p" vid="PRO 13:20">ومَنْ عاشرَ البُلَداءَ لَحِقَهُ السُّوءُ.<verse eid="PRO 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 13:21" />السُّوءُ يَتبَعُ الخاطِئينَ،</para>
  <para style="p" vid="PRO 13:21">وبالخَيرِ يُجازَى الصِّدِّيقونَ.<verse eid="PRO 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="PRO 13:22" />الصَّالحُ يُورِثُ بَني بَنيهِ،</para>
  <para style="p" vid="PRO 13:22">وثَروةُ الخاطئِ تُحفَظُ للصِّدِّيقينَ.<verse eid="PRO 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="PRO 13:23" />في حُقولِ المُستَقيمينَ طَعامٌ كثيرٌ،</para>
  <para style="p" vid="PRO 13:23">وهُناكَ مَنْ يأخُذُهُ بِغيرِ حَقٍّ،<verse eid="PRO 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="PRO 13:24" />مَنْ يُوَفِّرْ عَصاهُ يُبغِضِ اَبنَهُ،</para>
  <para style="p" vid="PRO 13:24">ولو أحبَّهُ لَسارعَ إلى تأدِيبِهِ.<verse eid="PRO 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="PRO 13:25" />الصِّدِّيقُ يأكلُ حتَّى يَشبَعَ،</para>
  <para style="p" vid="PRO 13:25">أمّا الشِّرِّيرُ فيأكلُ ولا يَشبَعُ.<verse eid="PRO 13:25" /></para>
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 14:1" />المَرأةُ الحكيمةُ تَبني بَيتَها،</para>
  <para style="p" vid="PRO 14:1">والحَمقاءُ تَهدِمُهُ بِيَدَيها.<verse eid="PRO 14:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 14:2" />مَنْ يَخَفِ الرّبَّ يَسلُكْ مُستَقيمًا،</para>
  <para style="p" vid="PRO 14:2">والمُراوِغُ في سُلوكِهِ يَحتَقِرُهُ.<verse eid="PRO 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 14:3" />في كَلامِ الأحمقِ خطَرٌ عظيمٌ،</para>
  <para style="p" vid="PRO 14:3">أمَّا كَلامُ الحُكَماءِ فيَحفَظُهُم.<verse eid="PRO 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 14:4" />حَيثُ لا ثيرانٌ فالمخزَنُ فارِغٌ،</para>
  <para style="p" vid="PRO 14:4">وبِقوَّةِ الثَّورِ تَكثُرُ الغِلالُ.<verse eid="PRO 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 14:5" />الشَّاهِدُ الأمينُ لا يكذِبُ.</para>
  <para style="p" vid="PRO 14:5">وشاهِدُ الزُّورِ يَنشُرُ الكَذِبَ.<verse eid="PRO 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 14:6" />الحِكمةُ عبَثًا يطلُبُها السَّاخرُ،</para>
  <para style="p" vid="PRO 14:6">والمَعرِفةُ لِلفهيمِ سَهلَةُ المَنالِ.<verse eid="PRO 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 14:7" />إبتَعِدْ عَنِ البليدِ كُلَّ الابتِعادِ،</para>
  <para style="p" vid="PRO 14:7">ففي كَلامِهِ لا تَجِدُ مَعرِفةً.<verse eid="PRO 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 14:8" />حِكمةُ الذَّكيِّ في فَهْمِ طريقِهِ،</para>
  <para style="p" vid="PRO 14:8">وحماقةُ البليدِ في مَكْرِهِ.<verse eid="PRO 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 14:9" />اللهُ يَسخَرُ بِأهلِ الإثْمِ،</para>
  <para style="p" vid="PRO 14:9">أمَّا المُستَقيمونَ فيَحُوزونَ رِضاهُ.<verse eid="PRO 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 14:10" />القلبُ يَحفَظُ مَرارَتَهُ لِنَفْسِهِ،</para>
  <para style="p" vid="PRO 14:10">وبِفرَحِهِ لا يُشارِكُ أحدًا.<verse eid="PRO 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 14:11" />بُيوتُ الأشرارِ تَخرَبُ،</para>
  <para style="p" vid="PRO 14:11">وديارُ المُستَقيمينَ تَزدَهِرُ.<verse eid="PRO 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 14:12" />رُبَّ طريقٍ قويمةٍ في عَينَيكَ،</para>
  <para style="p" vid="PRO 14:12">وأواخِرُها تُؤدِّي إلى الموتِ.<verse eid="PRO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 14:13" />حتّى في الضَّحِكِ يكتَئِبُ القلبُ،</para>
  <para style="p" vid="PRO 14:13">وكم مِنْ فرَحٍ آخِرَتُهُ الحَسْرَةُ.<verse eid="PRO 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 14:14" />المُتَقَلِّبُ يَجني ثمَرَةَ سُلوكِهِ،</para>
  <para style="p" vid="PRO 14:14">والرَّجلُ الصَّالِحُ ثمَرَةَ عمَلِهِ.<verse eid="PRO 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 14:15" />الجاهلُ يُصَدِّقُ كُلَّ كَلِمةٍ،</para>
  <para style="p" vid="PRO 14:15">والذَّكيُّ يَنتَبِهُ أينَ يسيرُ.<verse eid="PRO 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 14:16" />الحكيمُ يخافُ ويَبتَعِدُ عَنِ السُّوءِ،</para>
  <para style="p" vid="PRO 14:16">والبليدُ يَجتازُهُ واثقًا بِنَفْسِهِ.<verse eid="PRO 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 14:17" />القليلُ الصَّبرِ يتَصَرَّفُ بِحماقةٍ،</para>
  <para style="p" vid="PRO 14:17">ومَنْ يَذمُّ الآخرينَ يُبغِضُهُ النَّاسُ.<verse eid="PRO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 14:18" />الجُهَّالُ يَختارونَ الحماقةَ،</para>
  <para style="p" vid="PRO 14:18">والأذكياءُ يُكثِرونَ المَعرِفةَ.<verse eid="PRO 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="PRO 14:19" />أهلُ السُّوءِ يُعرِضونَ عَنِ الصَّالِحينَ،</para>
  <para style="p" vid="PRO 14:19">والأشرارُ يتَعالَونَ على الصِّدِّيقينَ.<verse eid="PRO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="PRO 14:20" />الفقيرُ يُبغِضُهُ حتّى قريبُهُ،</para>
  <para style="p" vid="PRO 14:20">والّذينَ يُحِبُّونَ الغِنى كثيرونَ.<verse eid="PRO 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 14:21" />مَنْ يَحتَقِرِ الآخرينَ يَخطَأْ،</para>
  <para style="p" vid="PRO 14:21">ومَنْ يتَحَنَّنْ على المَساكينِ يَهْنأْ.<verse eid="PRO 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="PRO 14:22" />أمَا يَضِلُّ مَنْ يَزرَعُ السُّوءَ؟</para>
  <para style="p" vid="PRO 14:22">الرَّحمةُ والأمانُ لِمَنْ يَزرَعُ الخَيرَ.<verse eid="PRO 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="PRO 14:23" />في التَّعَبِ مَهما يَكُنْ ربحٌ،</para>
  <para style="p" vid="PRO 14:23">وفي ثَرثَرَةِ الشَّفَتَينِ خَسارَةٌ.<verse eid="PRO 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="PRO 14:24" />تاجُ الحُكَماءِ غِنَى مَعرِفتِهِم،</para>
  <para style="p" vid="PRO 14:24">وزِينَةُ البُلَداءِ حماقتُهُم.<verse eid="PRO 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="PRO 14:25" />الشَّاهدُ الأمينُ يُنقِذُ النُّفوسَ،</para>
  <para style="p" vid="PRO 14:25">والشَّاهدُ الكاذِبُ يَنشُرُ المَكْرَ.<verse eid="PRO 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="PRO 14:26" />في مخافَةِ الرّبِّ طُمأْنينَةٌ وعِزٌّ،</para>
  <para style="p" vid="PRO 14:26">والرّبُّ حِمىً لأبنائِهِ.<verse eid="PRO 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="PRO 14:27" />مخافةُ الرّبِّ يُنبوعُ حياةٍ،</para>
  <para style="p" vid="PRO 14:27">وبِها تَبتَعِدُ عَنْ أشراكِ الموتِ.<verse eid="PRO 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="PRO 14:28" />في كثرَةِ الشَّعبِ جَلالُ المُلْكِ.</para>
  <para style="p" vid="PRO 14:28">وفي قِلَّةِ عدَدِهِ هلاكُهُ.<verse eid="PRO 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="PRO 14:29" />البطيءُ عَنِ الغضَبِ كثيرُ الفهْمِ.</para>
  <para style="p" vid="PRO 14:29">والقليلُ الصَّبرِ يُظهِرُ حماقتَهُ.<verse eid="PRO 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="PRO 14:30" />القلبُ الصَّالِحُ حياةُ الجسَدِ،</para>
  <para style="p" vid="PRO 14:30">والغَيرةُ نَخْرٌ للعِظامِ.<verse eid="PRO 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" pubnumber="31" sid="PRO 14:31" />مَنْ يَظلُمِ الوضيعَ يَستهِنْ بِخالِقِهِ.</para>
  <para style="p" vid="PRO 14:31">ويُمَجِّدُهُ مَنْ يتَحَنَّنُ على البائسِ.<verse eid="PRO 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" pubnumber="32" sid="PRO 14:32" />الشِّرِّيرُ تُطيحُ بهِ مَساوِئُهُ،</para>
  <para style="p" vid="PRO 14:32">أمَّا الصِّدِّيقُ فتَحميهِ نَزاهَتُهُ.<verse eid="PRO 14:32" /></para>
  <para style="p">
    <verse number="33" style="v" pubnumber="33" sid="PRO 14:33" />في قلبِ الفهيمِ تَستَقِرُّ الحِكمةُ،</para>
  <para style="p" vid="PRO 14:33">وفي داخلِ البليدِ لا تُودَعُ.<verse eid="PRO 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" pubnumber="34" sid="PRO 14:34" />العَدلُ يرفَعُ شأنَ الأمّةِ،</para>
  <para style="p" vid="PRO 14:34">وعارُ الشُّعوبِ الخطيئةُ.<verse eid="PRO 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" pubnumber="35" sid="PRO 14:35" />يَرضى المَلِكُ عَنِ العبدِ العاقلِ،</para>
  <para style="p" vid="PRO 14:35">وعلى العبدِ المَعتوهِ يُنزِلُ عقابَهُ.<verse eid="PRO 14:35" /></para>
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 15:1" />الجوابُ الرَّقيقُ يَصرِفُ الغضَبَ،</para>
  <para style="p" vid="PRO 15:1">والكَلِمةُ المُوجِعةُ تُثيرُ السُّخْطَ.<verse eid="PRO 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 15:2" />لِسانُ الحكيمِ يَجودُ بالمَعرِفَةِ.</para>
  <para style="p" vid="PRO 15:2">وفَمُ البليدِ يَفيضُ حماقةً.<verse eid="PRO 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 15:3" />عينا الرّبِّ في كُلِّ مكانٍ،</para>
  <para style="p" vid="PRO 15:3">تُراقِبانِ الأشرارَ والأخيارَ.<verse eid="PRO 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 15:4" />صلاحُ اللِّسانِ شجَرةُ حياةٍ،</para>
  <para style="p" vid="PRO 15:4">واَعْوجاجُهُ هلاكٌ للرُّوحِ.<verse eid="PRO 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 15:5" />الأحمقُ يَستَهينُ بِمَشورَةِ أبيهِ،</para>
  <para style="p" vid="PRO 15:5">والرَّجلُ الذَّكيُّ يَقبَلُ التَّوبيخَ.<verse eid="PRO 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 15:6" />بَيتُ الصِّدِّيقِ حِصْنٌ عظيمٌ،</para>
  <para style="p" vid="PRO 15:6">وفي مَنزلِ الشِّرِّيرِ كَدَرٌ.<verse eid="PRO 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 15:7" />شِفاهُ الحُكماءِ تَنشُرُ المَعرِفةَ،</para>
  <para style="p" vid="PRO 15:7">وقلوبُ البُلَداءِ كُلُّها جَهْلٌ.<verse eid="PRO 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 15:8" />ذبيحةُ الأشرارِ يَمقُتُها الرّبُّ،</para>
  <para style="p" vid="PRO 15:8">وصلاةُ المُستَقيمينَ تَحظى بِرِضاهُ.<verse eid="PRO 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 15:9" />طُرُقُ الشِّرِّيرِ يَمقُتُها الرّبُّ،</para>
  <para style="p" vid="PRO 15:9">ويُحِبُّ مَنْ يَتبَعُ العَدلَ.<verse eid="PRO 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 15:10" />تاركُ المَشورَةِ مَصيرُهُ إلى السُّوءِ،</para>
  <para style="p" vid="PRO 15:10">ومَنْ يُبغِضُ التَّوبيخَ آخرتُهُ الموتُ.<verse eid="PRO 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 15:11" />أرضُ الأمواتِ واضِحةٌ للرّبِّ،</para>
  <para style="p" vid="PRO 15:11">فكيفَ قلوبُ بَني البشَرِ.<verse eid="PRO 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 15:12" />السَّاخرُ لا يُحِبُّ مَنْ يُوَبِّخُهُ،</para>
  <para style="p" vid="PRO 15:12">وإلى الحُكَماءِ لا يذهَبُ.<verse eid="PRO 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 15:13" />القلبُ الفرحانُ يُبهِجُ الوجهَ،</para>
  <para style="p" vid="PRO 15:13">وبِحُزنِ القلبِ تنكسِرُ الرُّوحُ.<verse eid="PRO 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 15:14" />قلبُ الفهيمِ يَطلُبُ المَعرِفةَ،</para>
  <para style="p" vid="PRO 15:14">وفَمُ البليدِ يَفيضُ بالحماقَةِ.<verse eid="PRO 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 15:15" />أيّامُ المِسكينِ كُلُّها سُوءٌ،</para>
  <para style="p" vid="PRO 15:15">والطَّيِّبُ القلبِ في عيدٍ دائمٍ.<verse eid="PRO 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 15:16" />القليلُ معَ مَخافَةِ الرّبِّ،</para>
  <para style="p" vid="PRO 15:16">ولا كَنزٌ عظيمٌ معَ الهَمِّ.<verse eid="PRO 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 15:17" />أكلَةٌ مِنَ البُقولِ معَ المَحبَّةِ،</para>
  <para style="p" vid="PRO 15:17">ولا عِجْلٌ مُسَمَّنٌ معَ البُغضِ.<verse eid="PRO 15:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 15:18" />الرَّجلُ الغَضُوبُ يُثيرُ النِّزاعَ،</para>
  <para style="p" vid="PRO 15:18">والبَطيءُ الغَضَبِ يُهَدِّئُ الخِصامَ.<verse eid="PRO 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="PRO 15:19" />طريقُ البَطَّالِ كحَقلٍ مِنْ شَوكٍ</para>
  <para style="p" vid="PRO 15:19">وسبيلُ المُستَقيمينَ مُمَهَّدٌ.<verse eid="PRO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="PRO 15:20" />الابنُ الحكيمُ يُفرِّحُ أباهُ،</para>
  <para style="p" vid="PRO 15:20">والإبنُ البليدُ يُحَقِّرُ أُمَّهُ.<verse eid="PRO 15:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 15:21" />الحماقةُ فرَحٌ لِناقِصِ الفهْمِ،</para>
  <para style="p" vid="PRO 15:21">أمَّا الفهيمُ فيُقَوِّمُ سُلُوكَهُ.<verse eid="PRO 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="PRO 15:22" />بغيرِ رَأيٍ سديدٍ تَخيبُ المَقاصِدُ،</para>
  <para style="p" vid="PRO 15:22">وبِكثرَةِ المُشيرينَ تَتِمُّ.<verse eid="PRO 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="PRO 15:23" />حُسْنُ الجوابِ يُفْرِحُ الإنسانَ،</para>
  <para style="p" vid="PRO 15:23">والكَلِمَةُ في وَقتِها ما أحلاها.<verse eid="PRO 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="PRO 15:24" />سبيلُ العاقلِ تَقودُه إلى الحياةِ،</para>
  <para style="p" vid="PRO 15:24">فيسيرُ بَعيدًا مِنْ عالَمِ الأمواتِ.<verse eid="PRO 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="PRO 15:25" />الرّبُّ يُزيلُ بيوتَ المُتَباهينَ،</para>
  <para style="p" vid="PRO 15:25">ويَحمي حِمى المرأةِ الأرملَةِ.<verse eid="PRO 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="PRO 15:26" />أفكارُ الشِّرِّيرِ يَمقُتُها الرّبُّ،</para>
  <para style="p" vid="PRO 15:26">وكلامُ الأطهارِ يَحظى بِنِعمَتِهِ.<verse eid="PRO 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="PRO 15:27" />المُغتَصِبُ يُعَكِّرُ صَفْوَ بَيتِهِ،</para>
  <para style="p" vid="PRO 15:27">والّذي يَكرَهُ الرَّشوَةَ يحيا.<verse eid="PRO 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="PRO 15:28" />قلبُ الصِّدِّيقِ يتَرَوَّى في الجوابِ،</para>
  <para style="p" vid="PRO 15:28">وفَمُ الشِّرِّير يَفيضُ بالمَساوِئِ.<verse eid="PRO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="PRO 15:29" />الرّبُّ يَبتَعِدُ مِنَ الأشرارِ،</para>
  <para style="p" vid="PRO 15:29">ويستَمِعُ إلى صلاةِ الأبرارِ.<verse eid="PRO 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="PRO 15:30" />العينانِ المُنيرَتانِ تُفَرِّحانِ القلبَ</para>
  <para style="p" vid="PRO 15:30">والسُّمْعَةُ الطَّيِّبةُ تُحيي العِظامَ.<verse eid="PRO 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" pubnumber="31" sid="PRO 15:31" />مَنْ يسمَعْ توبيخَ الحياةِ،</para>
  <para style="p" vid="PRO 15:31">يَكُنْ بينَ الحُكَماءِ مُقامُهُ.<verse eid="PRO 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" pubnumber="32" sid="PRO 15:32" />مَنْ يَنبِذِ المَشورَةَ يَحتَقِرْ نفْسَهُ،</para>
  <para style="p" vid="PRO 15:32">ومَنْ يَسمعِ التَّوبيخَ يكتَسِبِ الفَهْمَ.<verse eid="PRO 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" pubnumber="33" sid="PRO 15:33" />مَخافَةُ الرّبِّ دليلُ حِكمةٍ،</para>
  <para style="p" vid="PRO 15:33">وقَبلَ الكرامةِ التَّواضُعُ.<verse eid="PRO 15:33" /></para>
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 16:1" />للإنسانِ ما يُدَبِّرُ في قلبِهِ،</para>
  <para style="p" vid="PRO 16:1">ومِنَ الرّبِّ جوابُ اللِّسانِ،<verse eid="PRO 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 16:2" />سُلوكُ الإنسانِ مُبَرَّرٌ في عَينَيهِ،</para>
  <para style="p" vid="PRO 16:2">والرّبُّ يَزِنُ ما في النُّفوسِ.<verse eid="PRO 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 16:3" />فَوِّضْ إلى الرّبِّ أعمالَكَ،</para>
  <para style="p" vid="PRO 16:3">فتَتِمُّ جميعُ مَقاصِدِكَ.<verse eid="PRO 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 16:4" />الرّبُّ صنَعَ الجميعَ لِغايةٍ ما،</para>
  <para style="p" vid="PRO 16:4">حتّى الشِّرِّيرَ لِسُوءِ المَصيرِ.<verse eid="PRO 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 16:5" />المُتكبِّرُ يَمقُتُهُ الرّبُّ،</para>
  <para style="p" vid="PRO 16:5">وإلى الأبدِ لا عُذْرَ لهُ.<verse eid="PRO 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 16:6" />بالرَّحمةِ والحَقِّ تَكفيرُ الذُّنوبِ،</para>
  <para style="p" vid="PRO 16:6">وبمَخافَةِ الرّبِّ اَبتِعادٌ عَنِ الشَّرِّ.<verse eid="PRO 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 16:7" />يَرضَى الرّبُّ عَنْ سُلوكِ الإنسانِ،</para>
  <para style="p" vid="PRO 16:7">فيَجعَلُ حتّى أعداءَهُ يُسالِمُونَه.<verse eid="PRO 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 16:8" />القليلُ القليلُ معَ العَدلِ،</para>
  <para style="p" vid="PRO 16:8">ولا الرِّزْقُ الكثيرُ بغيرِ إنصافٍ.<verse eid="PRO 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 16:9" />قلبُ الإنسانِ يَرسُمُ طريقَهُ،</para>
  <para style="p" vid="PRO 16:9">والرّبُّ يُثَبِّتُ خَطَواتِهِ.<verse eid="PRO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 16:10" />القِسمةُ والنَّصيبُ في كَلامِ المَلِكِ،</para>
  <para style="p" vid="PRO 16:10">وفَمُهُ لا يَغشُّ في أحكامِهِ.<verse eid="PRO 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 16:11" />للرّبِّ قَبَّانُ العَدلِ وموَازينُهُ،</para>
  <para style="p" vid="PRO 16:11">وكُلُّ مِعيارٍ سليمٍ مِعيارُهُ.<verse eid="PRO 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 16:12" />فِعْلُ الشَّرِّ يَمقُتُهُ المُلوكُ،</para>
  <para style="p" vid="PRO 16:12">لأنَّ العرشَ بالعَدلِ يَثبُتُ.<verse eid="PRO 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 16:13" />الكَلامُ الصَّادِقُ يُرضي المُلوكَ،</para>
  <para style="p" vid="PRO 16:13">وهُم يُحِبُّونَ القولَ المُستقيمَ.<verse eid="PRO 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 16:14" />غضَبُ المَلِكِ رسولُ الموتِ،</para>
  <para style="p" vid="PRO 16:14">والرَّجلُ الحكيمُ يَستَعطِفُهُ.<verse eid="PRO 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 16:15" />في نورِ وجهِ المَلِكِ حياةٌ،</para>
  <para style="p" vid="PRO 16:15">ورِضاهُ سَحابُ مطَرٍ ربيعيٍّ.<verse eid="PRO 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 16:16" />إقتِناءُ الحكمةِ خَيرٌ مِنَ الذَّهَبِ،</para>
  <para style="p" vid="PRO 16:16">واَقْتِناءُ الفِطنَةِ أفضَلُ مِنَ الفِضَّةِ.<verse eid="PRO 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 16:17" />مَنْ يَسلُكْ مُستَقيمًا يَبتَعِدْ مِنَ الشَّرِّ،</para>
  <para style="p" vid="PRO 16:17">ومَنْ يُبْصِرْ طريقَهُ يَحفَظْ نفْسَهُ.<verse eid="PRO 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 16:18" />قَبلَ الخَيبةِ الكِبرياءُ،</para>
  <para style="p" vid="PRO 16:18">وقبلَ السُّقوطِ تَشامخُ الرُّوحِ.<verse eid="PRO 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="PRO 16:19" />تَواضُعُ الرُّوحِ معَ المَساكينِ،</para>
  <para style="p" vid="PRO 16:19">ولا اَقْتِسامُ الغَنيمةِ معَ المُتكبِّرينَ.<verse eid="PRO 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="PRO 16:20" />المُتَعَقِّلُ في أمرِهِ يَجِدُ خَيرًا،</para>
  <para style="p" vid="PRO 16:20">ومنْ يَتَّكِلْ على الرّبِّ يَهنَأْ.<verse eid="PRO 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 16:21" />الحكيمُ القلبِ يَشتَهِرُ بِفَهمِهِ،</para>
  <para style="p" vid="PRO 16:21">وكلامُهُ العَذبُ يَزيدُهُ عِلْمًا.<verse eid="PRO 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="PRO 16:22" />العقلُ يُنبوعُ حياةٍ لِصاحِبِهِ،</para>
  <para style="p" vid="PRO 16:22">ومَشورَةُ الأحمقِ حماقةٌ.<verse eid="PRO 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="PRO 16:23" />قلبُ الحكيمِ يُرشِدُ فَمَهُ،</para>
  <para style="p" vid="PRO 16:23">ويَزيدُ كَلامَهُ عِلْمًا.<verse eid="PRO 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="PRO 16:24" />الكَلامُ الجميلُ شَهْدُ عسَلٍ،</para>
  <para style="p" vid="PRO 16:24">يَحلُو لِلنَّفْسِ ويَشفي العِظامَ.<verse eid="PRO 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="PRO 16:25" />طريقٌ مُستَقيمَةٌ في عَينَيكَ،</para>
  <para style="p" vid="PRO 16:25">قد يُؤدِّي آخِرُها إلى الموتِ.<verse eid="PRO 16:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="PRO 16:26" />جُوعُ العامِلِ يَعمَلُ لِصالِحِهِ،</para>
  <para style="p" vid="PRO 16:26">لأنَّ جُوعَهُ يحُثُّهُ على العمَلِ.<verse eid="PRO 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="PRO 16:27" />اللَّئيمُ يَنبُشُ عَنِ السُّوءِ،</para>
  <para style="p" vid="PRO 16:27">وكَلامُهُ نارٌ مُتَّقِدَةٌ.<verse eid="PRO 16:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="PRO 16:28" />الكذَّابُ يزرَعُ الخِصامَ،</para>
  <para style="p" vid="PRO 16:28">والنَمَّامُ يُفَرِّقُ الأصحابَ.<verse eid="PRO 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="PRO 16:29" />الرَّجلُ العَنيفُ يُغري صاحِبَهُ،</para>
  <para style="p" vid="PRO 16:29">ويَقودُهُ في طريقٍ غيرِ صالِحٍ.<verse eid="PRO 16:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="PRO 16:30" />يُغمِضُ عَينَيهِ لِيَحسُبَ أكاذيبَهُ،</para>
  <para style="p" vid="PRO 16:30">ويَعَضُّ شفَتَيهِ وكُلُّهُ سُوءٌ.<verse eid="PRO 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" pubnumber="31" sid="PRO 16:31" />الشَّيبَةُ إكليلُ فَخرٍ</para>
  <para style="p" vid="PRO 16:31">للسَّائرينَ في طريقِ الصَّلاحِ.<verse eid="PRO 16:31" /></para>
  <para style="p">
    <verse number="32" style="v" pubnumber="32" sid="PRO 16:32" />البطيءُ الغضَبِ خَيرٌ مِنَ الجَبَّارِ،</para>
  <para style="p" vid="PRO 16:32">ومالِكُ نَفسِهِ مِمَّنْ يأخُذُ مدينَةً.<verse eid="PRO 16:32" /></para>
  <para style="p">
    <verse number="33" style="v" pubnumber="33" sid="PRO 16:33" />القُرعةُ تُلقَى لِتَحكُمَ في الأمورِ،</para>
  <para style="p" vid="PRO 16:33">ومِنَ الرّبِّ جميعُ أحكامِها.<verse eid="PRO 16:33" /></para>
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 17:1" />لُقمةٌ يابسةٌ معَ الطُمَأنينَةِ،</para>
  <para style="p" vid="PRO 17:1">ولا بَيتُ ولائمَ معَ خِصامٍ.<verse eid="PRO 17:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 17:2" />العبدُ العاقلُ يَسودُ الابنَ المَعتُوهَ،</para>
  <para style="p" vid="PRO 17:2">ويُقاسِمُ الإخوةَ أملاكَهُم.<verse eid="PRO 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 17:3" />البُوتَقَةُ تَمتَحِنُ الفِضَّةَ والذَّهبَ،</para>
  <para style="p" vid="PRO 17:3">والرّبُّ يَمتَحِنُ جميعَ القلوبِ.<verse eid="PRO 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 17:4" />يُصغي الشِّرِّيرُ إلى كَلامِ الإثْمِ،</para>
  <para style="p" vid="PRO 17:4">والكذَّابُ إلى كَلامِ الخُبْثِ.<verse eid="PRO 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 17:5" />المُستَهزئُ بالفقيرِ يَستَهينُ بِخالِقِهِ،</para>
  <para style="p" vid="PRO 17:5">ومَنْ يَفرَحْ بالنَّكْبَةِ لا عُذْرَ لهُ.<verse eid="PRO 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 17:6" />بَنو البنينَ إكليلُ جُدودِهِم،</para>
  <para style="p" vid="PRO 17:6">وفَخرُ البنينَ آباؤُهُم.<verse eid="PRO 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 17:7" />الكَلامُ المأثورُ لا يَليقُ بالجاهلِ،</para>
  <para style="p" vid="PRO 17:7">ولا كَلامُ الكَذِبِ بالأميرِ.<verse eid="PRO 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 17:8" />الرّشوَةُ حجَرُ سِخْرٍ للرَّاشي،</para>
  <para style="p" vid="PRO 17:8">فأينما يُرسِلُهُ يَنجَحُ.<verse eid="PRO 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 17:9" />مَنْ يَستُرِ الأخطاءَ يُحِبُّهُ النَّاسُ،</para>
  <para style="p" vid="PRO 17:9">ومَنْ يُرَدِّدْ ذِكرَها يُفَرِّقِ الأصحابَ.<verse eid="PRO 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 17:10" />التَّأنيبُ يؤثِّرُ في الفهيمِ،</para>
  <para style="p" vid="PRO 17:10">أكثرَ مِنْ مِئَةِ جَلدَةٍ في البليدِ.<verse eid="PRO 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 17:11" />المُتَمَرِّدُ لا يطلُبُ غيرَ السُّوءِ،</para>
  <para style="p" vid="PRO 17:11">فيَضْرِبُهُ ملاكٌ لا يَرحَمُ.<verse eid="PRO 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 17:12" />صادِفْ دُبَّةً فقَدَت أولادَها،</para>
  <para style="p" vid="PRO 17:12">ولا بليدًا كُلُّهُ حماقةٌ.<verse eid="PRO 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 17:13" />مَنْ جازَى عَنِ الخَيرِ سُوءًا،</para>
  <para style="p" vid="PRO 17:13">فلن يخرُجَ السُّوءُ مِنْ بَيتِهِ.<verse eid="PRO 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 17:14" />يَبتَدئُ النِّزاعُ كمياهٍ تَنفَجِرُ.</para>
  <para style="p" vid="PRO 17:14">فاَنظُرْ في أمرِهِ قَبلَ أنْ يَحتَدِمَ<verse eid="PRO 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 17:15" />تَبرِئَةُ المُجرمِ وتَجريمُ البريءِ،</para>
  <para style="p" vid="PRO 17:15">كِلاهُما يَمْقُتُهُما الرّبُّ.<verse eid="PRO 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 17:16" />لماذا المالُ في يدِ البليدِ؟</para>
  <para style="p" vid="PRO 17:16">أيَقتني الحِكمةَ ولا فَهْمَ لهُ؟<verse eid="PRO 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 17:17" />الصِّدِّيقُ يُحِبُّ في كُلِّ وقتٍ،</para>
  <para style="p" vid="PRO 17:17">والأخُ يولَدُ ليَومِ الضِّيقِ.<verse eid="PRO 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 17:18" />النَّاقِصُ الفهْمِ يَعقِدُ صَفقَةً،</para>
  <para style="p" vid="PRO 17:18">ويَصيرُ كَفيلًا بِحضورِ شاهدٍ.<verse eid="PRO 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="PRO 17:19" />مَنْ يُحِبُّ المَعصيةَ يُحِبُّ الخِصامَ</para>
  <para style="p" vid="PRO 17:19">ومَنْ يُعْلِ بابَهُ يَجلُبْ علَيهِ الهَدمَ.<verse eid="PRO 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="PRO 17:20" />المُراوغُ لا يَجِدُ خيرًا،</para>
  <para style="p" vid="PRO 17:20">والكذَّابُ يَقَعُ في السُّوءِ.<verse eid="PRO 17:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 17:21" />مَنْ يَلِدُ بليدًا فَلحَسرَتِهِ،</para>
  <para style="p" vid="PRO 17:21">ومَنْ يَلِدُ جاهِلًا لا يَفرَحُ.<verse eid="PRO 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="PRO 17:22" />فرَحُ القلبِ دَواءٌ شافٍ،</para>
  <para style="p" vid="PRO 17:22">وكآبةُ الرُّوحِ تُيبِّسُ العِظامَ.<verse eid="PRO 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="PRO 17:23" />يَرتشي الشِّرِّيرُ في الخِفيَةِ،</para>
  <para style="p" vid="PRO 17:23">وغايَتُهُ تَحويلُ مَجرَى العَدلِ.<verse eid="PRO 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="PRO 17:24" />الفهيمُ يَرى الحِكمةَ مَجرَى العَدلِ.</para>
  <para style="p" vid="PRO 17:24">أمَّا البليدُ فعيناهُ بَعيدَتانِ مِنْها.<verse eid="PRO 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="PRO 17:25" />الابنُ البليدُ كَدَرٌ لأبيهِ،</para>
  <para style="p" vid="PRO 17:25">ومَرارَةٌ للَّتي ولَدَتْهُ.<verse eid="PRO 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="PRO 17:26" />مُعاقَبَةُ الصِّدِّيقِ لا تَجوزُ،</para>
  <para style="p" vid="PRO 17:26">وضَرْبُ الشُّرَفاءِ يُنافي العَدلَ.<verse eid="PRO 17:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="PRO 17:27" />صاحِبُ المَعرِفَةِ يضبطُ كَلامَهُ،</para>
  <para style="p" vid="PRO 17:27">وصاحبُ الفهْمِ وقُورُ الرُّوحِ.<verse eid="PRO 17:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="PRO 17:28" />يَصمُتُ البليدُ فتَحسَبُهُ حكيمًا،</para>
  <para style="p" vid="PRO 17:28">ومَنْ ضَمَّ شفَتَيهِ تَحسَبُهُ فهيمًا.<verse eid="PRO 17:28" /></para>
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 18:1" />الإنسانُ يسعَى وراءَ رغباتِهِ،</para>
  <para style="p" vid="PRO 18:1">ويُشاكِسُ كُلَّ رأيٍ صالحٍ.<verse eid="PRO 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 18:2" />البليدُ لا يحتَفِظُ بما يتَبَيَّنُ لهُ،</para>
  <para style="p" vid="PRO 18:2">بل يكشِفُ كُلَّ ما في قلبِهِ.<verse eid="PRO 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 18:3" />معَ الشَّرِّ هُناكَ الاحتقارُ،</para>
  <para style="p" vid="PRO 18:3">ومعَ الهوانِ يكونُ العارُ.<verse eid="PRO 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 18:4" />كَلامُ الإنسانِ مياهٌ عميقةٌ،</para>
  <para style="p" vid="PRO 18:4">ويُنبوعُ الحِكمةِ نهرٌ فائضٌ.<verse eid="PRO 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 18:5" />مُحاباةُ الشِّرِّيرِ لا تَجوزُ،</para>
  <para style="p" vid="PRO 18:5">ولا حِرمانُ الصِّدِّيقِ مِنَ العدالةِ.<verse eid="PRO 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 18:6" />كَلامُ البليدِ يُثيرُ الخُصومةَ،</para>
  <para style="p" vid="PRO 18:6">ويَجلِبُ عليهِ الضَّرْبَ.<verse eid="PRO 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 18:7" />كَلامُ البليدِ هلاكُهُ،</para>
  <para style="p" vid="PRO 18:7">فهوَ يُوقِعُهُ في الشَّرَكِ.<verse eid="PRO 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 18:8" />كَلِماتُ النَمّامِ كطَعامٍ شهِيٍّ،</para>
  <para style="p" vid="PRO 18:8">يَنزِلُ إلى أعماقِ البَطْنِ.<verse eid="PRO 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 18:9" />المُتراخي في كُلِّ ما يعمَلُ،</para>
  <para style="p" vid="PRO 18:9">هوَ والشَّحاذونَ سَواءٌ.<verse eid="PRO 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 18:10" />إسمُ الرّبِّ بُرْجٌ مَنيعٌ،</para>
  <para style="p" vid="PRO 18:10">يَهرَعُ إليهِ الصِّدِّيقُ فيأمَنُ.<verse eid="PRO 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 18:11" />مالُ الغنيِّ مدينتُهُ المَنيعةُ،</para>
  <para style="p" vid="PRO 18:11">وهوَ في ظَنِّهِ سُورٌ مُرتَفِعٌ.<verse eid="PRO 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 18:12" />قَبلَ الخَيبةِ تَشامُخُ القلبِ،</para>
  <para style="p" vid="PRO 18:12">وقَبلَ الكرامةِ التَّواضُعُ.<verse eid="PRO 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 18:13" />من يُجيبُ قَبلَ أن يسمَعَ،</para>
  <para style="p" vid="PRO 18:13">فحَظُّهُ الحماقَةُ والهَوانُ.<verse eid="PRO 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 18:14" />روحُ الإنسانِ تَسنُدُ ضَعفَهُ،</para>
  <para style="p" vid="PRO 18:14">فإذا اَنكسَرت فمَنْ يُحْييها.<verse eid="PRO 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 18:15" />قلبُ الفهيم يكتَسِبُ المَعرِفةَ،</para>
  <para style="p" vid="PRO 18:15">وأذُنُ الحُكماءِ تَطلبُ العِلمَ.<verse eid="PRO 18:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 18:16" />العطيَّةُ تُوَسِّعُ طريقَ الإنسانِ،</para>
  <para style="p" vid="PRO 18:16">وتَهديهِ إلى مَقامِ العُظماءِ.<verse eid="PRO 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 18:17" />أوَّلُ المُتكلِّمينَ صادِقٌ في تُهمَتِهِ،</para>
  <para style="p" vid="PRO 18:17">إلى أنْ يُناقِشَهُ آخرُ.<verse eid="PRO 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 18:18" />القُرعَةُ تُبطِلُ الخُصوماتِ،</para>
  <para style="p" vid="PRO 18:18">وتَفصِلُ بَينَ الأقوياءِ.<verse eid="PRO 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="PRO 18:19" />الأخُ مدينةٌ منيعةٌ،</para>
  <para style="p" vid="PRO 18:19">تُخاصِمُهُ فيُغلِقُها دونَكَ.<verse eid="PRO 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="PRO 18:20" />مَنْ طابَ كَلامُهُ يُجازَى خَيرًا،</para>
  <para style="p" vid="PRO 18:20">ومِنْ غَلَّةِ ما يقولُهُ يشبَعُ.<verse eid="PRO 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 18:21" />الموتُ والحياةُ في يدِ اللِّسانِ،</para>
  <para style="p" vid="PRO 18:21">ومَنْ أحبَّ الثَّرثَرَةَ أكلَ ثمَرَها.<verse eid="PRO 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="PRO 18:22" />مَنْ وجَدَ زَوجةً وجَدَ خَيرًا،</para>
  <para style="p" vid="PRO 18:22">ونالَ رِضًى مِنَ الرّبِّ.<verse eid="PRO 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="PRO 18:23" />الفقيرُ يتكلَّمُ بِتَضَرُّعٍ،</para>
  <para style="p" vid="PRO 18:23">والغنيُّ يُجاوبُ باَعْتِزازٍ.<verse eid="PRO 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="PRO 18:24" />كثرَةُ الأصحابِ تَضُرُّ،</para>
  <para style="p" vid="PRO 18:24">وكم مِنْ مُحبٍّ أقربُ مِنْ أخٍ.<verse eid="PRO 18:24" /></para>
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 19:1" />الفقيرُ السَّالكُ طريقَ الكمالِ</para>
  <para style="p" vid="PRO 19:1">خَيرٌ مِنْ غنيٍّ طريقُهُ مُعوَجَّةٌ.<verse eid="PRO 19:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 19:2" />الحماسةُ بلا مَعرِفةٍ لا خَيرَ فيها،</para>
  <para style="p" vid="PRO 19:2">ومَنْ عجَّلَ في السَّيرِ زَلَّتْ قدَماهُ.<verse eid="PRO 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 19:3" />حماقَةُ الإنسانِ تتَقَدَّمُهُ في طريقِهِ.</para>
  <para style="p" vid="PRO 19:3">وهوَ في قلبِهِ يَحنَقُ على الرّبِّ.<verse eid="PRO 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 19:4" />المالُ يَزيدُ عدَدَ الأصحابِ،</para>
  <para style="p" vid="PRO 19:4">والفقيرُ يُفارِقُهُ حتّى صاحِبُهُ.<verse eid="PRO 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 19:5" />شاهدُ الزُّورِ لا عُذْرَ لهُ،</para>
  <para style="p" vid="PRO 19:5">وناشرُ الأكاذيبِ لا يَنجُو.<verse eid="PRO 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 19:6" />كثيرونَ يَستَعطِفونَ وجهَ الكريمِ،</para>
  <para style="p" vid="PRO 19:6">وكُلٌّ يُصاحِبُ واهِبَ العَطايا.<verse eid="PRO 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 19:7" />إخوَةُ الفقيرِ جميعًا يُبغِضونَهُ،</para>
  <para style="p" vid="PRO 19:7">فكيفَ لا يبتَعِدُ أصحابُهُ عَنهُ؟</para>
  <para style="p" vid="PRO 19:7">يُناشِدُهُم مِرارًا فلا يُبالُونَ.<verse eid="PRO 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 19:8" />مَنْ كانَ لبيبًا أحبّ نفْسَهُ،</para>
  <para style="p" vid="PRO 19:8">ومَنْ لَزِمَ الفَهْمَ وجَدَ خَيرًا.<verse eid="PRO 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 19:9" />شاهِدُ الزُّورِ لا عُذْرَ لهُ،</para>
  <para style="p" vid="PRO 19:9">وناشِرُ الأكاذيبِ يَبيدُ.<verse eid="PRO 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 19:10" />التَّرَفُ لا يَليقُ بالكسلانِ،</para>
  <para style="p" vid="PRO 19:10">ولا سيادَةُ العبدِ على رؤسائِهِ.<verse eid="PRO 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 19:11" />الإنسانُ العاقِلُ طويلُ البالِ،</para>
  <para style="p" vid="PRO 19:11">وفَخْرُهُ أنْ يصفَحَ عَنِ الخطأِ.<verse eid="PRO 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 19:12" />غَيظُ المَلِكِ كزئيرِ الشِّبْلِ،</para>
  <para style="p" vid="PRO 19:12">ورضاهُ مِثلَ نَدًى على الشُّعوبِ.<verse eid="PRO 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 19:13" />الابنُ البليدُ خَسارَةٌ لأبيهِ،</para>
  <para style="p" vid="PRO 19:13">والمَرأةُ النَقَّاقَةُ وَكْفٌ لا يَنقَطِعُ.<verse eid="PRO 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 19:14" />البَيتُ والمالُ ميراثٌ مِنَ الآباءِ،</para>
  <para style="p" vid="PRO 19:14">والمَرأةُ العاقِلَةُ مِنْ عِندِ الرّبِّ.<verse eid="PRO 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 19:15" />العاطلُ عَنِ العمَلِ لا خَيرَ فيهِ،</para>
  <para style="p" vid="PRO 19:15">والإنسانُ البَطَّالُ يجوعُ.<verse eid="PRO 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 19:16" />مَنْ يَحفَظْ وصيَّةَ الرّبِّ يَحفَظْ نفْسَهُ،</para>
  <para style="p" vid="PRO 19:16">والمُستَهينُ بِطُرُقِهِ يموتُ.<verse eid="PRO 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 19:17" />مَنْ يتَحَنَّنْ على الفقيرِ يُحسِنْ إلى الرّبِّ،</para>
  <para style="p" vid="PRO 19:17">والرّبُّ على إحسانِهِ يُكافِئُهُ.<verse eid="PRO 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 19:18" />أدِّبِ اَبنَكَ ما دُمتَ قادرًا،</para>
  <para style="p" vid="PRO 19:18">ولا تتَأَخّرْ لِئلَّا تَفقِدَهُ.<verse eid="PRO 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="PRO 19:19" />الغَضُوبُ يتَعَرََّضُ لِلعِقابِ،</para>
  <para style="p" vid="PRO 19:19">وإنْ سايَرتَهُ اَزْدادَ وعيدًا.<verse eid="PRO 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="PRO 19:20" />إسمعِ النَّصيحةَ واَقْبلِ المَشورَةَ،</para>
  <para style="p" vid="PRO 19:20">تكُنْ في آخرِ الأمرِ حكيمًا.<verse eid="PRO 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 19:21" />في قلبِ الإنسانِ مَقاصِدُ كثيرةٌ.</para>
  <para style="p" vid="PRO 19:21">ونصيحَةُ الرّبِّ هيَ الّتي تَثبُتُ.<verse eid="PRO 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="PRO 19:22" />جشَعُ الإنسانِ عارُهُ،</para>
  <para style="p" vid="PRO 19:22">والفقيرُ خَيرٌ مِنَ الكَذَّابِ.<verse eid="PRO 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="PRO 19:23" />مَخافةُ الرّبِّ تؤدِّي إلى الحياةِ،</para>
  <para style="p" vid="PRO 19:23">وصاحبُها يشبَعُ ولا يَحِلُّ بهِ سُوءٌ.<verse eid="PRO 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="PRO 19:24" />البَطَّالُ يَغمِسُ يَدَهُ في صَحْنِهِ،</para>
  <para style="p" vid="PRO 19:24">ولا يَرُدُّها حتّى إلى فَمِهِ.<verse eid="PRO 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="PRO 19:25" />إضربِ السَّاخِرَ فيَتَنَبَّهَ الجاهِلُ،</para>
  <para style="p" vid="PRO 19:25">ووبِّخِ الفهيمَ فيَتَبَيَّنَ المَعرِفةَ.<verse eid="PRO 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="PRO 19:26" />مَنْ يُضَيِّقْ على أبيهِ ويَطرُدْ أمَّهُ،</para>
  <para style="p" vid="PRO 19:26">فهوَ وليدُ العَيبِ والعارِ معًا.<verse eid="PRO 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="PRO 19:27" />لا تسمَعْ يا اَبني أيّةَ مَشورَةٍ،</para>
  <para style="p" vid="PRO 19:27">تُضَلِّلُكَ عَنْ كَلامِ المَعرِفةِ.<verse eid="PRO 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="PRO 19:28" />الشَّاهِدُ اللّئيمُ يَسخَرُ بالقضاءِ،</para>
  <para style="p" vid="PRO 19:28">وأفواهُ الأشرارِ تَبتَلِعُ الإثْمَ.<verse eid="PRO 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="PRO 19:29" />العِقابُ للقومِ السَّاخرينَ،</para>
  <para style="p" vid="PRO 19:29">والضَّرْبُ لِظُهورِ الكَسالى.<verse eid="PRO 19:29" /></para>
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 20:1" />الخمرُ مُجُونٌ والسُّكْرُ عَربَدَةٌ،</para>
  <para style="p" vid="PRO 20:1">ومَنْ يَهيمُ بِهِما فلا حِكمةَ لهُ.<verse eid="PRO 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 20:2" />هِياجُ المَلِكِ كزَئيرِ الشِّبْلِ،</para>
  <para style="p" vid="PRO 20:2">فمَنْ تَجاهَلَهُ أخطأَ إلى نفْسِهِ.<verse eid="PRO 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 20:3" />كرامَةُ الإنسانِ اَنقِطاعُهُ عَنِ الخِصامِ،</para>
  <para style="p" vid="PRO 20:3">فالدُّخولُ فيهِ مِنْ طبائِعِ الأحمقِ.<verse eid="PRO 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 20:4" />البطَّالُ لا يفلَحُ أرضَهُ في الخريفِ،</para>
  <para style="p" vid="PRO 20:4">فيَستَعطي في الحصادِ ولا يُعطَى.<verse eid="PRO 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 20:5" />المَشورَةُ في القلبِ مياهٌ عميقةٌ،</para>
  <para style="p" vid="PRO 20:5">والفهيمُ الفهيمُ مَنْ يستخْرِجُها.<verse eid="PRO 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 20:6" />كم مِنَ النَّاسِ يُنادونَ بِصلاحِهِم،</para>
  <para style="p" vid="PRO 20:6">أمَّا الأمينُ فيهم فمَنْ يَجِدُهُ؟<verse eid="PRO 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 20:7" />الصِّدِّيقُ السَّالِكُ طريقَ الكمالِ</para>
  <para style="p" vid="PRO 20:7">يَهنَأُ بَنُوهُ مِنْ بَعدِهِ.<verse eid="PRO 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 20:8" />المَلِكُ الجالِسُ على كُرسِيِّ القضاءِ،</para>
  <para style="p" vid="PRO 20:8">بِنَظْرةٍ مِنهُ يُميِّزُ كُلَّ شَرٍّ.<verse eid="PRO 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 20:9" />أهُناكَ مَنْ يقولُ: ”قلبي نَقيٌّ،</para>
  <para style="p" vid="PRO 20:9">وأنا تطَهَّرتُ مِنْ خطيئتي؟“<verse eid="PRO 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 20:10" />إستعمالُ مِكيالَينِ مِعيارَينِ</para>
  <para style="p" vid="PRO 20:10">كِلاهُما غِشٌّ يَمقُتُهُ الرّبُّ.<verse eid="PRO 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 20:11" />الولَدُ نفْسُهُ يعرِفُ ما يعمَلُ،</para>
  <para style="p" vid="PRO 20:11">هلْ هوَ سليمٌ ومُستَقيمٌ.<verse eid="PRO 20:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 20:12" />الأُذُنُ لِلسَّمعِ والعينُ لِلبصَرِ،</para>
  <para style="p" vid="PRO 20:12">وكِلْتاهُما صنَعَهُما الرّبُّ.<verse eid="PRO 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 20:13" />لا تُحِبُّ النَّومَ لِئلَّا تَفتَقِرَ،</para>
  <para style="p" vid="PRO 20:13">بلِ اَفتَحْ عينَيكَ تشبَعْ خُبزًا.<verse eid="PRO 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 20:14" />يقولُ المُشتري: هذا رَديءٌ،</para>
  <para style="p" vid="PRO 20:14">حينَ يشتَريهِ يتَهَلَّلُ فَرِحًا.<verse eid="PRO 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 20:15" />الذَّهَبُ موجودٌ والَّلآلئُ كثيرَةٌ،</para>
  <para style="p" vid="PRO 20:15">وكَلامُ المَعرِفةِ جوهرَةٌ كريمَةٌ.<verse eid="PRO 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 20:16" />إنْ كفَلْتَ غريبًا تكُنْ غبيًّا،</para>
  <para style="p" vid="PRO 20:16">وإلَّا فخُذْ ثوبَهُ رَهْنًا لكَ.<verse eid="PRO 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 20:17" />خبزُ الكَذِبِ لذيذٌ لِلإنسانِ</para>
  <para style="p" vid="PRO 20:17">إلى أن يمتَلئَ فَمُهُ بالحصَى.<verse eid="PRO 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 20:18" />بالمَشورَةِ تَتِمُّ مَقاصِدُكَ.</para>
  <para style="p" vid="PRO 20:18">وبِغيرِ هُدًى لا تُشَنُّ الحربُ.<verse eid="PRO 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="PRO 20:19" />السَّاعي بالنَّميمةِ يُفشي الأسرارَ،</para>
  <para style="p" vid="PRO 20:19">وأمَّا الثَّرثارُ فلا تُعاشِرْهُ.<verse eid="PRO 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="PRO 20:20" />مَنْ لعَنَ أباهُ أو لعَنَ أمَّهُ</para>
  <para style="p" vid="PRO 20:20">يَنطفِئُ سِراجُهُ في قلبِ الظَّلامِ.<verse eid="PRO 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 20:21" />ميراثُ البخيلِ لا قيمةَ لهُ،</para>
  <para style="p" vid="PRO 20:21">وآخرتُهُ لا بركةَ فيها.<verse eid="PRO 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="PRO 20:22" />لا تَقُلْ: أستَسلِمُ لِلشَّرِّ،</para>
  <para style="p" vid="PRO 20:22">بل ترَجَّ الرّبَّ فيُخَلِّصَكَ.<verse eid="PRO 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="PRO 20:23" />إستِعمالُ مِكيالَينِ يَمقُتُهُ الرّبُّ،</para>
  <para style="p" vid="PRO 20:23">ومَوازينُ الغِشِّ لا تَجوزُ.<verse eid="PRO 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="PRO 20:24" />خَطَواتُ الإنسانِ يُسَيِّرُها الرّبُّ،</para>
  <para style="p" vid="PRO 20:24">فكيفَ يتَبَيَّنُ الإنسانُ طريقَهُ؟<verse eid="PRO 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="PRO 20:25" />لا تتَسَرَّعْ بِنُذُورِكَ للرّبِّ</para>
  <para style="p" vid="PRO 20:25">لِئلَّا تَندَمَ فيما بَعدُ.<verse eid="PRO 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="PRO 20:26" />المَلِكُ الحكيمُ يُبَدِّدُ الأشرارَ،</para>
  <para style="p" vid="PRO 20:26">ويسحَقُهُم بالنَّورَجِ عِقابًا لهُم.<verse eid="PRO 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="PRO 20:27" />الرّبُّ يُنيرُ ضميرَ الإنسانِ،</para>
  <para style="p" vid="PRO 20:27">ويُفَتِّشُ جميعَ دَواخِلِهِ.<verse eid="PRO 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="PRO 20:28" />الرَّحمةُ والحَقُّ يَحفَظانِ المَلِكَ،</para>
  <para style="p" vid="PRO 20:28">وعَرشُهُ يُسانِدُهُ العَدلُ.<verse eid="PRO 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="PRO 20:29" />فَخْرُ الشَّبابِ عزيمَتُهُم،</para>
  <para style="p" vid="PRO 20:29">وبَهاءُ الشُّيوخِ المَشيبُ.<verse eid="PRO 20:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="PRO 20:30" />الشَّرُّ يُطَهِّرُ عُمْقَ الجِراحِ،</para>
  <para style="p" vid="PRO 20:30">والضَّرَباتُ القاسيةُ دَواخلَ الإنسانِ.<verse eid="PRO 20:30" /></para>
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 21:1" />قلبُ المَلِكِ في يدِ الرّبّ</para>
  <para style="p" vid="PRO 21:1">كجدولِ ماءٍ يُميلُهُ حَيثُ شاءَ.<verse eid="PRO 21:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 21:2" />سُلوكُ الإنسانِ مُبَرَّرٌ في عينَيهِ،</para>
  <para style="p" vid="PRO 21:2">والرّبُّ يَزِنُ ما في القُلوبِ.<verse eid="PRO 21:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 21:3" />أنْ تَصنَعَ العَدلَ وتَقضيَ بالإنصافِ</para>
  <para style="p" vid="PRO 21:3">أفضلُ عِندَ الرّبِّ مِنْ تقديمِ ذبيحةٍ.<verse eid="PRO 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 21:4" />تَشامُخُ الإنسانِ مِنْ تكبُّرِ قلبِهِ،</para>
  <para style="p" vid="PRO 21:4">ونيرُ الأشرارِ الخطيئةُ.<verse eid="PRO 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 21:5" />الحريصُ على تَحقيقِ مقاصِدِهِ يَغنَى.</para>
  <para style="p" vid="PRO 21:5">والعَجولُ في أمرهِ يفتَقِرُ.<verse eid="PRO 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 21:6" />جَمْعُ الأموالِ بِكَلامِ الكذِبِ</para>
  <para style="p" vid="PRO 21:6">بُخارٌ يتَبَدَّدُ وشَرَكٌ لِلمَوتِ.<verse eid="PRO 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 21:7" />جَورُ الأشرارِ يَجرُفُهُم بعيدًا،</para>
  <para style="p" vid="PRO 21:7">فهُم يَرفُضونَ العمَلَ بالإنصافِ.<verse eid="PRO 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 21:8" />طريقُ المُذنِبِ كُلُّهُ اَعوجاجٌ،</para>
  <para style="p" vid="PRO 21:8">أمَّا البَريءُ فسُلوكُهُ مُستَقيمٌ.<verse eid="PRO 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 21:9" />زاويةُ السَّطحِ ولا بَيتٌ فسيحٌ</para>
  <para style="p" vid="PRO 21:9">تَسكُنُهُ معَ اَمرأةٍ نَقَّاقَةٍ.<verse eid="PRO 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 21:10" />نفْسُ الشِّرِّيرِ تشتَهي السُّوءَ،</para>
  <para style="p" vid="PRO 21:10">ولا حنانَ عِندَهُ على أحدٍ.<verse eid="PRO 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 21:11" />عاقِبِ السَّاخِرَ فيَتَّعظَ الجاهلُ،</para>
  <para style="p" vid="PRO 21:11">ومِثْلُ الحكيمِ يَنالُ المَعرِفةَ.<verse eid="PRO 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 21:12" />يدخُلُ الصِّدِّيقُ بَيتَ الشِّرِّيرِ</para>
  <para style="p" vid="PRO 21:12">فيُسقِطُ الأشرارَ في السُّوءِ.<verse eid="PRO 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 21:13" />مَنْ سَدَّ أذُنَيهِ عَنْ صُراخِ الفقيرِ،</para>
  <para style="p" vid="PRO 21:13">إنْ صَرخَ هوَ فلا يُستَجابُ.<verse eid="PRO 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 21:14" />العَطيَّةُ في الخَفاءِ تَمنَعُ الغضَبَ،</para>
  <para style="p" vid="PRO 21:14">والرَّشوَةُ في الجَيبِ تُخمِدُ الغَيظَ.<verse eid="PRO 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 21:15" />العمَلُ بالإنصافِ فَرَحٌ للصِّدِّيقِ</para>
  <para style="p" vid="PRO 21:15">وهلاكٌ لِمَنْ يفعَلُ الإثْمَ.<verse eid="PRO 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 21:16" />كُلُّ مَنْ ضَلَّ عَنْ طريقِ التَّعَقُّلِ</para>
  <para style="p" vid="PRO 21:16">أقامَ معَ جماعةِ الأمواتِ.<verse eid="PRO 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 21:17" />مَنْ أحبَّ المَرَحَ لَحِقَتْهُ الحَسْرَةُ،</para>
  <para style="p" vid="PRO 21:17">ومَنْ أحبَّ الخمرَ والولائِمَ لا يَغتَني.<verse eid="PRO 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 21:18" />بالأشرارِ يُفتَدَى الصِّدِّيقونَ،</para>
  <para style="p" vid="PRO 21:18">وبالغادرينَ يُفتَدَى المُستقيمونَ.<verse eid="PRO 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="PRO 21:19" />السُّكْنى في أرضٍ مُقفِرَةٍ،</para>
  <para style="p" vid="PRO 21:19">ولا الكدَرُ معَ اَمرأةٍ نَقَّاقَةٍ.<verse eid="PRO 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="PRO 21:20" />في بَيتِ الحكيمِ كَنزٌ ثمينٌ،</para>
  <para style="p" vid="PRO 21:20">والبليدُ يُنفِقُ مالَهُ بِلا حِسابٍ.<verse eid="PRO 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 21:21" />مَنْ سعَى وراءَ الرَّحمةِ والعَدلِ</para>
  <para style="p" vid="PRO 21:21">وجَدَ الحياةَ والصِّدْقَ والكرامةَ.<verse eid="PRO 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="PRO 21:22" />الحكيمُ يتَسَلَّقُ مدينَةَ الجبابِرةِ</para>
  <para style="p" vid="PRO 21:22">ويَحتَلُّ حِصْنَها الّذي تتَّكِلُ علَيهِ.<verse eid="PRO 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="PRO 21:23" />مَنْ راقبَ فَمَهُ وصانَ لِسانَهُ</para>
  <para style="p" vid="PRO 21:23">حَفِظَ مِنَ المَتاعِبِ نفْسَهُ.<verse eid="PRO 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="PRO 21:24" />المُتَهَوِّرُ يَستَدعي السُّخْريةَ</para>
  <para style="p" vid="PRO 21:24">وتَصرُّفُهُ يَزيدُ الغضَبَ.<verse eid="PRO 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="PRO 21:25" />شَهوَة البَطَّالِ تُذِلُّهُ،</para>
  <para style="p" vid="PRO 21:25">لأنَّ يَدَيهِ تَرفُضانِ العمَلَ.<verse eid="PRO 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="PRO 21:26" />يشتَهي طوالَ لَيلِهِ ونهارِهِ،</para>
  <para style="p" vid="PRO 21:26">فيما الصِّدِّيقُ يُعطي ولا يَبخَلُ.<verse eid="PRO 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="PRO 21:27" />ذَبيحةُ الشِّرِّيرِ يَمقُتُها الرّبُّ،</para>
  <para style="p" vid="PRO 21:27">فكيفَ إذا قَدَّمَها بِكِبرياءٍ.<verse eid="PRO 21:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="PRO 21:28" />شاهِدُ الزُّورِ لا بُدَّ أنْ يَبيدَ،</para>
  <para style="p" vid="PRO 21:28">والصَّادِقُ في كَلامِهِ يَسمَعُهُ النَّاسُ.<verse eid="PRO 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="PRO 21:29" />الشِّرِّيرُ يَعتَزُّ بِما هوَ فيهِ،</para>
  <para style="p" vid="PRO 21:29">ومَنْ يَسلُكْ مُستَقيمًا يتَبَيَّنْ طريقَهُ.<verse eid="PRO 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="PRO 21:30" />ما مِنْ حِكمةٍ ولا فَهْمٍ ولا مَشوَرةٍ،</para>
  <para style="p" vid="PRO 21:30">تَنفَعُ ضِدَّ مشيئَةِ الرّبِّ.<verse eid="PRO 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" pubnumber="31" sid="PRO 21:31" />الفَرَسُ تَهَيّأَ لِيومِ القِتالِ،</para>
  <para style="p" vid="PRO 21:31">أمَّا النَّصْرُ فَمِنَ الرّبِّ.<verse eid="PRO 21:31" /></para>
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 22:1" />الصِّيتُ أفضَلُ مِنَ الغِنى الكثيرِ،</para>
  <para style="p" vid="PRO 22:1">والرَّحمةُ خَيرٌ مِنَ الفضَّةِ والذَّهبِ.<verse eid="PRO 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 22:2" />الغنيُّ والفقيرُ يَتلاقَيانِ،</para>
  <para style="p" vid="PRO 22:2">فكلاهُما صنَعَهُما الرّبُّ.<verse eid="PRO 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 22:3" />الذكيُّ يَرى الشَّرَّ فيَختَبئُ،</para>
  <para style="p" vid="PRO 22:3">والجُهَّالُ يَعبُرونَهُ فيُعاقَبونَ،<verse eid="PRO 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 22:4" />بالتَّواضُعِ ومَخافَةِ الرّبِّ</para>
  <para style="p" vid="PRO 22:4">كُلُّ غنًى وكرامةٍ وحياةٍ.<verse eid="PRO 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 22:5" />في الطَّريقِ الأعوجِ شَوكٌ وفِخاخٌ،</para>
  <para style="p" vid="PRO 22:5">فمَنْ يَبتَعِدُ مِنهُ يَحفَظُ نفْسَهُ.<verse eid="PRO 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 22:6" />هَذِّبِ الطِّفلَ في أوَّلِ طريقِهِ،</para>
  <para style="p" vid="PRO 22:6">فمتى شاخَ لا يَبتَعِدُ مِنهُ.<verse eid="PRO 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 22:7" />الغنيُّ يتَسلَّطُ على الفقيرِ،</para>
  <para style="p" vid="PRO 22:7">والمُقترِضُ عبدٌ لِلمُقرِضِ.<verse eid="PRO 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 22:8" />مَنْ زرَعَ الجَورَ حصَدَ الإثْمَ،</para>
  <para style="p" vid="PRO 22:8">وعصا قُوَّتِهِ تكِلُّ.<verse eid="PRO 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 22:9" />البرَكةُ لِمَن يَدُهُ خَيِّرةٌ،</para>
  <para style="p" vid="PRO 22:9">فيُعطي مِنْ خبزهِ للفقيرِ.<verse eid="PRO 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 22:10" />أُطرُدِ السَّاخِرَ فيَخرُجَ الخِصامُ،</para>
  <para style="p" vid="PRO 22:10">ويَبطُلَ النِّزاعُ والبُغضُ.<verse eid="PRO 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 22:11" />مَنْ أحبَّ طَهارَةَ القلبِ</para>
  <para style="p" vid="PRO 22:11">رَقَّ كَلامُهُ فصادقَهُ المَلِكُ.<verse eid="PRO 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 22:12" />عينا الرّبِّ تَنظُرانِ المَعرِفةَ،</para>
  <para style="p" vid="PRO 22:12">وتَستَبِقانِ كَلامَ الغادِرينَ.<verse eid="PRO 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 22:13" />يقولُ البَطَّالُ: ”في الشَّارِعِ أسَدٌ،</para>
  <para style="p" vid="PRO 22:13">فإذا خرَجتُ خارجًا يَقتُلُني“.<verse eid="PRO 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 22:14" />فَمُ العاهِرةِ حُفرَةٌ عميقَةٌ،</para>
  <para style="p" vid="PRO 22:14">فمَنْ أبغَضَهُ الرّبُّ سقَطَ فيها.<verse eid="PRO 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 22:15" />الحماقةُ تَعلَقُ بِقلبِ الولَدِ،</para>
  <para style="p" vid="PRO 22:15">وعصا التَّأديبِ تُبعِدُهُ مِنها.<verse eid="PRO 22:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 22:16" />مَنْ يَظلُمُ الفقيرَ ليَزيدَ ما عِندَهُ</para>
  <para style="p" vid="PRO 22:16">كمَنْ يُعطي الغنيَّ ليَفتَقِرَ.<verse eid="PRO 22:16" /></para>
  <para style="s1">ثلاثون حكمة</para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 22:17" />أمِلْ أذُنَكَ واَسمَعْ كَلامَ الحُكَماءِ،</para>
  <para style="p" vid="PRO 22:17">ووَجِّهْ قلبَكَ إلى المَعرِفةِ.<verse eid="PRO 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 22:18" />مِنَ الخَيرِ أنْ تَحفَظَها في قلبِكَ</para>
  <para style="p" vid="PRO 22:18">وتفيضَ أيضًا على شفَتَيكَ.<verse eid="PRO 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="PRO 22:19" />أُعَلِّمُكَ إيَّاها اليومَ</para>
  <para style="p" vid="PRO 22:19">فليكُنْ على الرّبِّ اَ تِّكالُكَ.<verse eid="PRO 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="PRO 22:20" />كتَبْتُها في ثلاثينَ حِكمةً</para>
  <para style="p" vid="PRO 22:20">مِنْ حُسْنِ المَشورَةِ والعِلْمِ<verse eid="PRO 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 22:21" />لِتَعرِفَ صِحَّةَ أقوالِ الحَقِّ،</para>
  <para style="p" vid="PRO 22:21">فتُحْسِنَ الرَّدَّ على سائِليكَ.<verse eid="PRO 22:21" /></para>
  <para style="s2">–1–</para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="PRO 22:22" />لا تَقهَرِ الفقيرَ لأنَّهُ فقيرٌ،</para>
  <para style="p" vid="PRO 22:22">ولا تَسحَقِ المِسكينَ في القضاءِ<verse eid="PRO 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="PRO 22:23" />فالرّبُّ يَرُدُّ التُّهمَةَ عَنهُما،</para>
  <para style="p" vid="PRO 22:23">ويَسلُبُ نُفوسَ سالِبيهما.<verse eid="PRO 22:23" /></para>
  <para style="s2">–2–</para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="PRO 22:24" />لا تُصاحبِ الرَّجلَ الغَضُوبَ،</para>
  <para style="p" vid="PRO 22:24">ولا تُرافِقِ الإنسانَ السَّاخِطَ.<verse eid="PRO 22:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="PRO 22:25" />لِئلَّا تألَفَ السَّيرَ في سُبُلِهِ،</para>
  <para style="p" vid="PRO 22:25">وتُوقِعَ نفْسَكَ في الشَّرَكِ.<verse eid="PRO 22:25" /></para>
  <para style="s2">–3–</para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="PRO 22:26" />لا تكُنْ مِمَّن يَعقِدونَ الصَّفَقاتِ،</para>
  <para style="p" vid="PRO 22:26">ولا مِمَّنْ يَكفلونَ الدُّيونَ.<verse eid="PRO 22:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="PRO 22:27" />فإنْ كُنتَ لا تَملِكُ ما تَفي،</para>
  <para style="p" vid="PRO 22:27">يُؤخَذُ فِراشُكَ مِنْ تَحتِكَ.<verse eid="PRO 22:27" /></para>
  <para style="s2">–4–</para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="PRO 22:28" />لا تُزِحِ الحُدودَ القديمةَ،</para>
  <para style="p" vid="PRO 22:28">تِلكَ الّتي وضَعَها آباؤُكَ.<verse eid="PRO 22:28" /></para>
  <para style="s2">–5–</para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="PRO 22:29" />أرَأيتَ ماهِرًا في عمَلِهِ؟</para>
  <para style="p" vid="PRO 22:29">معَ المُلوكِ لا معَ الرُّعاعِ مُقامُهُ.<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="s2">–6–</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 23:1" />إذا جلَسْتَ تأكُلُ معَ الأسيادِ،</para>
  <para style="p" vid="PRO 23:1">فتَبيَّنْ جيِّدًا ما هوَ أمامَكَ،<verse eid="PRO 23:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 23:2" />وضَعْ قَيدًا صارمًا لِشَهيَّتِكَ،</para>
  <para style="p" vid="PRO 23:2">إنْ كُنتَ شَرِهًا في طَعامِكَ.<verse eid="PRO 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 23:3" />لا تَشتَهِ طَيِّباتِهِم أبدًا</para>
  <para style="p" vid="PRO 23:3">لأنَّها طَعامُ الكذِبِ.<verse eid="PRO 23:3" /></para>
  <para style="s2">–7–</para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 23:4" />لا تتعَبْ لِتَصيرَ غنيًّا،</para>
  <para style="p" vid="PRO 23:4">وإلَّا تَخَلَّيتَ عَنِ فِطنَتِكَ.<verse eid="PRO 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 23:5" />فالغنيُّ يَزولُ في طَرْفَةِ عينٍ.</para>
  <para style="p" vid="PRO 23:5">كمَنْ يصنَعُ لِنَفْسِهِ جناحَينِ</para>
  <para style="p" vid="PRO 23:5">ويَطيرُ كالنَّسرِ في السَّماءِ.<verse eid="PRO 23:5" /></para>
  <para style="s2">–8–</para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 23:6" />لا تأكُلْ خبزَ شرِّيرِ العينِ</para>
  <para style="p" vid="PRO 23:6">ولا تَشتهِ أبدًا طَيَّباتِهِ،<verse eid="PRO 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 23:7" />إنْ قالَ: كُلْ واَشْرَب معي،</para>
  <para style="p" vid="PRO 23:7">فقَلبُهُ غَيرُ صادِقٍ معَكَ،</para>
  <para style="p" vid="PRO 23:7">وكما نَوى في نفْسِهِ يكونُ.<verse eid="PRO 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 23:8" />تتَقَيَّأُ اللُّقمةَ الّتي أكلْتَها،</para>
  <para style="p" vid="PRO 23:8">وتستَنكِرُ كَلماتِكَ المَعسولَةَ.<verse eid="PRO 23:8" /></para>
  <para style="s2">–9–</para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 23:9" />في أُذُنِ البليدِ لا تتكلَّمْ،</para>
  <para style="p" vid="PRO 23:9">فهوَ يحتَقِرُ كَلامَكَ المُتَعَقِّلَ.<verse eid="PRO 23:9" /></para>
  <para style="s2">–10–</para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 23:10" />لا تُزِحِ الحُدودَ القديمةَ،</para>
  <para style="p" vid="PRO 23:10">ولا تدخُلْ حُقولَ الأيتامِ.<verse eid="PRO 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 23:11" />لأنَّ الرّبَّ وَليَّهُم قديرٌ،</para>
  <para style="p" vid="PRO 23:11">يَرُدُّ عُدوانَكَ عَنهُم.<verse eid="PRO 23:11" /></para>
  <para style="s2">–11–</para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 23:12" />أمِلْ قلبَكَ إلى المَشورَةِ</para>
  <para style="p" vid="PRO 23:12">وأُذُنَيكَ إلى كَلامِ المَعرِفةِ.<verse eid="PRO 23:12" /></para>
  <para style="s2">–12–</para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 23:13" />لا تَمنَعِ التَّأديبَ عَنِ الولَدِ،</para>
  <para style="p" vid="PRO 23:13">فإنْ ضَرَبْتَه بالعصا لا يموتُ.<verse eid="PRO 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 23:14" />تضرِبُهُ بِعصا التَّأديبِ،</para>
  <para style="p" vid="PRO 23:14">فتُنقِذُ مِنْ عالَمِ الأمواتِ حياتَهُ.<verse eid="PRO 23:14" /></para>
  <para style="s2">–13–</para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 23:15" />إنْ كانَ قلبُكَ يا اَبْني حكيمًا،</para>
  <para style="p" vid="PRO 23:15">فقَلبي يفرَحُ جِدًّا لكَ.<verse eid="PRO 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 23:16" />بل صَدري يَنشَرِحُ يا اَبْني</para>
  <para style="p" vid="PRO 23:16">إذا نطَقَت شَفَتاكَ بالاستِقامةِ.<verse eid="PRO 23:16" /></para>
  <para style="s2">–14–</para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 23:17" />لا يفضُلُ قلبُكَ الخاطئينَ،</para>
  <para style="p" vid="PRO 23:17">بلِ اَتّقِ الرّبَّ نهارًا وليلًا.<verse eid="PRO 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 23:18" />فلا بُدَّ يا اَبني مِنْ آخرةٍ،</para>
  <para style="p" vid="PRO 23:18">ورجاؤُكَ لا يُنكَرُ علَيكَ.<verse eid="PRO 23:18" /></para>
  <para style="s2">–15–</para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="PRO 23:19" />فاَسمَعْ يا اَبني وكُنْ حكيمًا،</para>
  <para style="p" vid="PRO 23:19">وليكُن قلبُكَ دَليلَكَ.<verse eid="PRO 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="PRO 23:20" />لا تكُنْ بَينَ شِرِّيبي الخمرِ،</para>
  <para style="p" vid="PRO 23:20">ولا الّذينَ يأكلونَ كثيرًا.<verse eid="PRO 23:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 23:21" />فالشِّرِّيبُ والأكِّيلُ يَفتَقِرانِ،</para>
  <para style="p" vid="PRO 23:21">وكثرةُ النَّومِ تُلبِسُكَ الخِرَقَ.<verse eid="PRO 23:21" /></para>
  <para style="s2">–16–</para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="PRO 23:22" />إسمَعْ لأبيكَ الّذي ولَدَكَ،</para>
  <para style="p" vid="PRO 23:22">ولا تَحتَقِرْ أُمَّكَ إذا شاخَت.<verse eid="PRO 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="PRO 23:23" />إقتنِ الحَقَّ ولا تَبِعْهُ،</para>
  <para style="p" vid="PRO 23:23">وكذلِكَ الحِكمةَ والمَشورَةَ والفِطنَةَ.<verse eid="PRO 23:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="PRO 23:24" />أبو الصِّدِّيقِ يَبتَهجُ اَبْتِهاجًا،</para>
  <para style="p" vid="PRO 23:24">ومَنْ يَلِدُ حكيمًا يفرَحُ بهِ.<verse eid="PRO 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="PRO 23:25" />فليَفرَحْ أبوكَ وأمُّكَ بكَ،</para>
  <para style="p" vid="PRO 23:25">ولتَبتَهِجْ تلكَ الّتي ولَدَتْكَ.<verse eid="PRO 23:25" /></para>
  <para style="s2">–17–</para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="PRO 23:26" />أعطِني قلبَكَ يا اَبني،</para>
  <para style="p" vid="PRO 23:26">ولتُلاحِظْ عيناكَ طُرُقي.<verse eid="PRO 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="PRO 23:27" />الزَّانيةُ حُفرَةٌ عميقَةٌ،</para>
  <para style="p" vid="PRO 23:27">والفاجِرةُ بِئْرٌ عطشانَةٌ.<verse eid="PRO 23:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="PRO 23:28" />هيَ أيضًا تكمُنُ كالموتِ،</para>
  <para style="p" vid="PRO 23:28">وتَزيدُ الغادرينَ في النَّاسِ.<verse eid="PRO 23:28" /></para>
  <para style="s2">–18–</para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="PRO 23:29" />لِمَنِ الويلُ ولِمَنِ الشَّقاءُ؟</para>
  <para style="p" vid="PRO 23:29">لِمَنِ الخِصامُ ولِمَنِ الفضيحةُ؟</para>
  <para style="p" vid="PRO 23:29">لِمَنِ الجِراحُ مِنْ غَيرِ عِلَّةٍ؟</para>
  <para style="p" vid="PRO 23:29">لِمَنِ اَحْمِرارُ العينَينِ<verse eid="PRO 23:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="PRO 23:30" />إلَّا للّذينَ يُدمِنُونَ الخمرَ</para>
  <para style="p" vid="PRO 23:30">ويَسعَونَ وراءَ المُسكِرِ.<verse eid="PRO 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" pubnumber="31" sid="PRO 23:31" />لا تَنظُرْ إلى الخمرِ إذا اَحْمَرَّت،</para>
  <para style="p" vid="PRO 23:31">إذا تَلألأَت بالكأسِ وطابَ مَذاقُها،<verse eid="PRO 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" pubnumber="32" sid="PRO 23:32" />فهيَ في الآخِرِ تَلدَغُ كالحَيَّةِ</para>
  <para style="p" vid="PRO 23:32">وتَلسَعُ لَسعَةَ العقرَبِ.<verse eid="PRO 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" pubnumber="33" sid="PRO 23:33" />فتَرى عَيناكَ الغَرائِبَ</para>
  <para style="p" vid="PRO 23:33">وتَنطِقَ بِما لا خَيرَ فيهِ.<verse eid="PRO 23:33" /></para>
  <para style="p">
    <verse number="34" style="v" pubnumber="34" sid="PRO 23:34" />وتكونُ كمُضطَجِعٍ في قلبِ البحرِ،</para>
  <para style="p" vid="PRO 23:34">أو كنائِمٍ على رأسِ السَّاريةِ.<verse eid="PRO 23:34" /></para>
  <para style="p">
    <verse number="35" style="v" pubnumber="35" sid="PRO 23:35" />تقولُ: ضَرَبوني وما توَجَّعتُ،</para>
  <para style="p" vid="PRO 23:35">آلموني وما عَرَفتُ، فسأعودُ</para>
  <para style="p" vid="PRO 23:35">إلى الخمرِ متى أستَفيقُ.<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="s2">–19–</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 24:1" />لا تُعاشِرْ أهلَ السُّوءِ</para>
  <para style="p" vid="PRO 24:1">ولا ترغَبْ أنْ تكونَ معَهُم،<verse eid="PRO 24:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 24:2" />لأنَّ قلوبَهُم تلهَجُ بالجَورِ</para>
  <para style="p" vid="PRO 24:2">وشِفاهَهُم تَنطِقُ بالأذى.<verse eid="PRO 24:2" /></para>
  <para style="s2">–20–</para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 24:3" />بالحِكمةِ يُبنَى البَيتُ،</para>
  <para style="p" vid="PRO 24:3">وبالفَهْمِ تتثَبَّتُ أركانُهُ.<verse eid="PRO 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 24:4" />بالمَعرِفةِ تَمتَلِئُ جَوانبُهُ</para>
  <para style="p" vid="PRO 24:4">مِنْ كُلِّ نَفيسٍ شَهيٍّ.<verse eid="PRO 24:4" /></para>
  <para style="s2">–21–</para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 24:5" />الرَّجُلُ الحكيمُ عزيزُ الشَّأْنِ</para>
  <para style="p" vid="PRO 24:5">وصاحِبُ المَعرِفةِ عظيمُ القُدْرةِ.<verse eid="PRO 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 24:6" />بغيرِ هُدًى لا تَشُنَّ حربَكَ،</para>
  <para style="p" vid="PRO 24:6">وبِكثرةِ المُشيرينَ الخلاصُ.<verse eid="PRO 24:6" /></para>
  <para style="s2">–22–</para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 24:7" />الأحمَقُ لا يُدرِكُ الحِكمةَ،</para>
  <para style="p" vid="PRO 24:7">وفي المجالِسِ لا يفتَحُ فَمَهُ.<verse eid="PRO 24:7" /></para>
  <para style="s2">–23–</para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 24:8" />مَنْ فكَّرَ أنْ يفعَلَ السُّوءَ</para>
  <para style="p" vid="PRO 24:8">دعاهُ النَّاسُ ذَميمًا.<verse eid="PRO 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 24:9" />مَقصَدُ الأحمقِ خطيئةٌ،</para>
  <para style="p" vid="PRO 24:9">والسَّاخرُ يَمقُتُهُ النَّاسُ.<verse eid="PRO 24:9" /></para>
  <para style="s2">–24–</para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 24:10" />إذا تَراخَيتَ في يومِ الضِّيقِ</para>
  <para style="p" vid="PRO 24:10">كُنتَ حَقًّا قليلَ العَزيمةِ.<verse eid="PRO 24:10" /></para>
  <para style="s2">–25–</para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 24:11" />أنقِذْ مَنْ يُساقُ إلى الموتِ</para>
  <para style="p" vid="PRO 24:11">ولا تُوَفِّرْ مَنْ يقودُهُم إلى القَتلِ.<verse eid="PRO 24:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 24:12" />فإنْ قُلتَ: ”لا عِلْمَ لي بِهذا“،</para>
  <para style="p" vid="PRO 24:12">فالرّبُّ الّذي يَزِنُ ما في القُلوبِ</para>
  <para style="p" vid="PRO 24:12">ويتَبَيَّنُهُ ويَراكَ ألا يَعرِفُ،</para>
  <para style="p" vid="PRO 24:12">فيُجازيَكَ بِحَسبِ عمَلِكَ؟<verse eid="PRO 24:12" /></para>
  <para style="s2">–26–</para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 24:13" />العسَلُ طَيِّبٌ يا اَبْني،</para>
  <para style="p" vid="PRO 24:13">وشَهْدُ العسَلِ حُلوٌ في حَلقِكَ،<verse eid="PRO 24:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 24:14" />فاَعرِفِ الحِكمةَ تَجدْها هكذا</para>
  <para style="p" vid="PRO 24:14">لا بُدَّ يا اَبْني مِنَ الثَّوابِ،</para>
  <para style="p" vid="PRO 24:14">ورجاؤُكَ لا يُنكَرُ علَيكَ.<verse eid="PRO 24:14" /></para>
  <para style="s2">–27–</para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 24:15" />لا تكمُنْ كالشِّرِّيرِ على بَيتِ الصِّدِّيقِ،</para>
  <para style="p" vid="PRO 24:15">ولا تتَرَبَّصْ بهِ جَورًا.<verse eid="PRO 24:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 24:16" />الصِّدِّيقُ يسقُطُ سَبعَ مرَّاتٍ ويقومُ،</para>
  <para style="p" vid="PRO 24:16">أمّا الشِّرِّيرُ فيُقهَرُ متى عثَرَ.<verse eid="PRO 24:16" /></para>
  <para style="s2">–28–</para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 24:17" />لا تفرَحْ بِسقُوطِ عَدُوِّكَ،</para>
  <para style="p" vid="PRO 24:17">ولا يبتَهِجْ قلبُكَ إذا عثَرَ<verse eid="PRO 24:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 24:18" />لِئلَّا يَرى الرّبُّ ويَستاءَ،</para>
  <para style="p" vid="PRO 24:18">فيَرُدَّ عَنْ عَدوِّكَ غضَبَهُ.<verse eid="PRO 24:18" /></para>
  <para style="s2">–29–</para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="PRO 24:19" />لا تَحسُدْ جماعةَ الأشرارِ</para>
  <para style="p" vid="PRO 24:19">ولا تُعاشِرْ جماعةَ الأشرارِ،<verse eid="PRO 24:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="PRO 24:20" />فأهلُ الشَّرِّ لا آخِرَةَ لهُم،</para>
  <para style="p" vid="PRO 24:20">وسِراجُ الأشرارِ يَنطَفِئُ.<verse eid="PRO 24:20" /></para>
  <para style="s2">–30–</para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 24:21" />إتَّقِ الرّبَّ والمَلِكَ يا اَبني،</para>
  <para style="p" vid="PRO 24:21">ومعَ أهلِ الشَّأنِ لا تتَمادَ.<verse eid="PRO 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="PRO 24:22" />فمِنْهُم بَغتَةً تأتي النَّكْبةُ،</para>
  <para style="p" vid="PRO 24:22">ومَنْ يعلَمُ أيَّ هلاكٍ يُسَبِّبُونَ؟<verse eid="PRO 24:22" /></para>
  <para style="s1">أقوال مأثورة</para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="PRO 24:23" />وإليكَ أيضًا ما قالَهُ الحُكَماءُ:</para>
  <para style="p" vid="PRO 24:23">المُحاباةُ في القضاءِ لا تَجُوزُ.<verse eid="PRO 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="PRO 24:24" />مَنْ قالَ لِلشِّرِّيرِ أنتَ صِدِّيقٌ،</para>
  <para style="p" vid="PRO 24:24">تلعنُهُ الشُّعوبُ وتمقُتُهُ الأُمَمُ.<verse eid="PRO 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="PRO 24:25" />أمَّا الّذينَ يُوَبِّخُونَهُ فيَنعَمُونَ،</para>
  <para style="p" vid="PRO 24:25">وعلَيهِم يَحِلُّ فَيضُ البَركاتِ.<verse eid="PRO 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="PRO 24:26" />مَنْ رَدَّ جوابًا مُقنِعًا لِسائِلِهِ</para>
  <para style="p" vid="PRO 24:26">جديرٌ بِتَقْبيلِ الشَّفَتَينِ.<verse eid="PRO 24:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="PRO 24:27" />دَبِّرْ أمورَكَ وأصلِحْ حَقلَكَ،</para>
  <para style="p" vid="PRO 24:27">وبَعدَ ذلِكَ اَبْنِ بَيتَكَ.<verse eid="PRO 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="PRO 24:28" />لا تَشهَدْ على أحدٍ بِغَيرِ حَقٍّ</para>
  <para style="p" vid="PRO 24:28">ولا تَنطِقْ علَيهِ بِفَتْوى.<verse eid="PRO 24:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="PRO 24:29" />لا تَقُلْ: ”بِمِثْلِ ما عامَلَني أُعامِلُهُ</para>
  <para style="p" vid="PRO 24:29">وأُجازي الإنسانَ بِعمَلِهِ“.<verse eid="PRO 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="PRO 24:30" />مرَرْتُ بِحَقلِ البَطَّالِ</para>
  <para style="p" vid="PRO 24:30">وبِكرْمِ مَنْ أعوَزَهُ الفَهْمُ،<verse eid="PRO 24:30" /></para>
  <para style="p">
    <verse number="31" style="v" pubnumber="31" sid="PRO 24:31" />فإذا الشَّوكُ عَلاهُ كُلَّهُ</para>
  <para style="p" vid="PRO 24:31">والعَوسَجُ غطَّى وجهَهُ،</para>
  <para style="p" vid="PRO 24:31">وجِدارُ حِجارَتهِ اَنْهَدَمَ.<verse eid="PRO 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" pubnumber="32" sid="PRO 24:32" />فنَظَرتُ وتأمَّلتُ في قلبي،</para>
  <para style="p" vid="PRO 24:32">ورأيتُ في ذلِكَ عِبْرَةً:<verse eid="PRO 24:32" /></para>
  <para style="p">
    <verse number="33" style="v" pubnumber="33" sid="PRO 24:33" />بَينَ قليلٍ مِنَ النُّعاسِ وقليلٍ مِنَ النَّومِ</para>
  <para style="p" vid="PRO 24:33">وطيِّ اليدَينِ قليلًا للرُّقادِ<verse eid="PRO 24:33" /></para>
  <para style="p">
    <verse number="34" style="v" pubnumber="34" sid="PRO 24:34" />يُداهِمُكَ الفَقْرُ كَمُهلِكٍ،</para>
  <para style="p" vid="PRO 24:34">والفاقَةُ كرَجُلٍ مُسَلَّحٍ.<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="s1">أمثال أخرى لسليمان</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 25:1" />هذِهِ أيضًا أمثالُ سليمانَ الّتي نظَّمَها رِجالُ حزَقْيا مَلِكِ يَهوذا:<verse eid="PRO 25:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 25:2" />مَجدُ اللهِ في ما يُخفيهِ،</para>
  <para style="p" vid="PRO 25:2">ومَجدُ المُلوكِ في ما يَكشِفونَهُ.<verse eid="PRO 25:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 25:3" />السَّماءُ للعُلوِّ والأرضُ للعُمْقِ،</para>
  <para style="p" vid="PRO 25:3">وقُلوبُ المُلوكِ لا يُكشَفُ أمرُها.<verse eid="PRO 25:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 25:4" />أزِلِ الزَّغلَ مِنَ الفضَّةِ،</para>
  <para style="p" vid="PRO 25:4">فتَصلُحَ إناءُ الصّائغِ.<verse eid="PRO 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 25:5" />أزِلِ الشِّرِّيرَ مِنْ أمامِ المَلِكِ،</para>
  <para style="p" vid="PRO 25:5">فيثبُتَ بالعَدلِ عَرشُهُ.<verse eid="PRO 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 25:6" />لا تكُنْ مُتباهيًا أمامَ المَلِكِ،</para>
  <para style="p" vid="PRO 25:6">ولا تَقِفْ في مكانِ العُظماءِ.<verse eid="PRO 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 25:7" />خَيرٌ أنْ يُقالَ لكَ اَرتَفِعْ إلى هُنا،</para>
  <para style="p" vid="PRO 25:7">مِنْ أنْ يُخْفَضَ مُقامُكَ لَدى الأميرِ.<verse eid="PRO 25:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 25:8" />لا تتَسَرَّعْ بِتَوجيهِ التُّهَمِ</para>
  <para style="p" vid="PRO 25:8">لِئلَّا فيما بَعدُ يَهزِمَكَ خصمُكَ.<verse eid="PRO 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 25:9" />ناقِشِ التُّهمَةَ أوَّلًا معَ خصمِكَ،</para>
  <para style="p" vid="PRO 25:9">ولا تَبُحْ بأسرارِ غَيرِكَ.<verse eid="PRO 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 25:10" />لِئلَّا يُعَيِّرَكَ أحدُ السَّامِعينَ،</para>
  <para style="p" vid="PRO 25:10">أو تَشُوبَ سُمعَتَكَ شائِبَةٌ.<verse eid="PRO 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 25:11" />الكلِمَةُ الّتي تُقالُ في حينِها</para>
  <para style="p" vid="PRO 25:11">تفَّاحَةٌ مِنْ ذَهَبٍ في وِعاءٍ مِنْ فِضَّةٍ.<verse eid="PRO 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 25:12" />تَوبيخُ الحكيمِ في الأُذُنِ السَّامِعةِ</para>
  <para style="p" vid="PRO 25:12">خاتَمٌ مِنْ ذَهَبٍ وحِلْيَةٌ مِنْ إبريزٍ.<verse eid="PRO 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 25:13" />السَّفيرُ الأمينُ يُنعِشُ نفْسَ مُرسِلِهِ</para>
  <para style="p" vid="PRO 25:13">كالماءِ الباردِ في يومِ الحِصادِ.<verse eid="PRO 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 25:14" />عَطيَّةُ زُورٍ تتَهَلَّلُ لها</para>
  <para style="p" vid="PRO 25:14">سَحابٌ وريحٌ بِغيرِ مطَرٍ.<verse eid="PRO 25:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 25:15" />بِطُولِ البالِ يَقتَنِعُ القاضي،</para>
  <para style="p" vid="PRO 25:15">واللِّسانُ اللَّطيفُ يَغلِبُ القويَّ.<verse eid="PRO 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 25:16" />إنْ وجَدْتَ عسَلًا فكُلْ ما يَكفيكَ</para>
  <para style="p" vid="PRO 25:16">لِئلَّا تَزدادَ شبَعًا فتَتَقَيَّأَ.<verse eid="PRO 25:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 25:17" />خَفِّفْ قدَمَكَ عَنْ بَيتِ جارِكَ،</para>
  <para style="p" vid="PRO 25:17">لئلَّا يَشبَعَ مِنْكَ فيكرَهَكَ.<verse eid="PRO 25:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 25:18" />شاهِدُ الزُّورِ على الآخَرينَ</para>
  <para style="p" vid="PRO 25:18">مِطرقةٌ وحَربَةٌ وسَهمٌ مَسنُونٌ.<verse eid="PRO 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="PRO 25:19" />سِنٌّ مَكسورَةٌ ورِجلٌ مَخلُوعَةٌ،</para>
  <para style="p" vid="PRO 25:19">ولا الاتِّكالُ على الغادِرِ يومَ الضِّيقِ.<verse eid="PRO 25:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="PRO 25:20" />كالعُرْي في البَرْدِ والحامِضِ على الجُرْحِ</para>
  <para style="p" vid="PRO 25:20">هكذا الغِناءُ لِقلبٍ كئيبٍ.<verse eid="PRO 25:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 25:21" />إنْ جاعَ مَنْ يُبغِضُكَ فأَطعِمْهُ خبزًا</para>
  <para style="p" vid="PRO 25:21">وإنْ عَطِشَ فاَسقِهِ ماءً،<verse eid="PRO 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="PRO 25:22" />فتَحُطَّ جَمْرًا على رأسِهِ،</para>
  <para style="p" vid="PRO 25:22">والرّبُّ يُحسنُ جَزاءَكَ.<verse eid="PRO 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="PRO 25:23" />ريحُ الشِّمالِ تَمنعُ المطَرَ،</para>
  <para style="p" vid="PRO 25:23">وعِفَّةُ اللِّسانِ عُبوسُ الوجهِ.<verse eid="PRO 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="PRO 25:24" />زاويةُ السَّطحِ ولا بَيتٌ فسيحٌ</para>
  <para style="p" vid="PRO 25:24">تَسكنُهُ معَ اَمرأةٍ نقَّاقةٍ.<verse eid="PRO 25:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="PRO 25:25" />الخَبَرُ السَّارُّ مِنْ بِلادٍ بعيدةٍ</para>
  <para style="p" vid="PRO 25:25">ماءٌ باردٌ لِنَفْسٍ عَطشانةٍ.<verse eid="PRO 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="PRO 25:26" />الصِّدِّيقُ المُتذلِّلُ أمامَ الشِّرِّيرِ</para>
  <para style="p" vid="PRO 25:26">نَبعٌ عكِرٌ وعينٌ آسنةٌ.<verse eid="PRO 25:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="PRO 25:27" />أكْلُ العسَلِ معَ العُظَماءِ لا يَطيبُ،</para>
  <para style="p" vid="PRO 25:27">ومَنْ يَحتَقِرْ أمجادَهُم يتمجَّدْ.<verse eid="PRO 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="PRO 25:28" />مَنْ لا يَضبُطْ نفْسَهُ يكُنْ</para>
  <para style="p" vid="PRO 25:28">كمدينةٍ مفتوحةٍ بِلا حاميةٍ.<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 26:1" />كالثَّلجِ في الصيفِ والمطَرِ في الحصادِ،</para>
  <para style="p" vid="PRO 26:1">هكذا المَجدُ لِمَنْ كانَ بليدًا.<verse eid="PRO 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 26:2" />كالعُصفورِ النَّازِحِ واليَمامةِ في طَيَرانِها،</para>
  <para style="p" vid="PRO 26:2">هكذا اللَّعنةُ مِنْ غيرِ سَبَبٍ.<verse eid="PRO 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 26:3" />السَّوطُ للفَرَسِ واللِّجامُ للحِمارِ،</para>
  <para style="p" vid="PRO 26:3">وأمَّا العصا فلِظَهرِ البليدِ.<verse eid="PRO 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 26:4" />لا تُجاوِبِ البليدَ بمِثلِ حماقتِهِ</para>
  <para style="p" vid="PRO 26:4">لِئلَّا تكونَ في مُستَواهُ.<verse eid="PRO 26:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 26:5" />جاوبِ البليدَ بِمثْلِ حماقتِهِ</para>
  <para style="p" vid="PRO 26:5">لِئلّا يحسبَ نفْسَهُ حكيمًا.<verse eid="PRO 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 26:6" />مَنْ يُرسِلُ كَلامًا معَ البليدِ،</para>
  <para style="p" vid="PRO 26:6">كمَنْ يَقطعُ رِجلَيه ويَركبُ الخطَرَ.<verse eid="PRO 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 26:7" />ساقا المُخَلَّعِ تتَهَدَّلانِ،</para>
  <para style="p" vid="PRO 26:7">وكذلِكَ المثَلُ في فَمِ البليدِ.<verse eid="PRO 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 26:8" />إعطاءُ البليدِ كرامةً</para>
  <para style="p" vid="PRO 26:8">كسُقوطِ حجَرٍ في رُجمَةٍ.<verse eid="PRO 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 26:9" />كالشَّوكِ في يَدِ السَّكرانِ،</para>
  <para style="p" vid="PRO 26:9">هكذا المثَلُ في فَمِ البليدِ.<verse eid="PRO 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 26:10" />مَنْ يَستأجِرُ أيَّ عابِرِ سبيلٍ</para>
  <para style="p" vid="PRO 26:10">كَرامٍ بالقوسِ يطعَنُ كُلَّ إنسانٍ.<verse eid="PRO 26:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 26:11" />يعودُ البليدُ إلى حماقتِهِ،</para>
  <para style="p" vid="PRO 26:11">كما يعودُ الكلبُ إلى قَيئِهِ.<verse eid="PRO 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 26:12" />أرأيتَ حكيمًا في عينَي نفْسِهِ؟</para>
  <para style="p" vid="PRO 26:12">الأمَلُ في البليدِ ولا الأملُ فيهِ.<verse eid="PRO 26:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 26:13" />البَطَّالُ يقولُ ليُبَرِّرَ نفْسَهُ:</para>
  <para style="p" vid="PRO 26:13">”في الطَّريقِ والشَّوارعِ أسَدٌ!“<verse eid="PRO 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 26:14" />البابُ يَدورُ على مِحْوَرِه</para>
  <para style="p" vid="PRO 26:14">مِثلَما البَطَّالُ على فراشهِ،<verse eid="PRO 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 26:15" />البَطَّالُ يغمِسُ يدَه في صَحنِهِ،</para>
  <para style="p" vid="PRO 26:15">ويُتعِبُهُ أنْ يُعيدَها إلى فَمِه.<verse eid="PRO 26:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 26:16" />البَطَّالُ يرَى نفْسَهُ حكيمًا</para>
  <para style="p" vid="PRO 26:16">أكثرَ مِنْ سبعةٍ يُحسِنونَ الجِدالَ.<verse eid="PRO 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 26:17" />مَنْ تَداخَلَ بِتُهمَةٍ لا تَعنيهِ</para>
  <para style="p" vid="PRO 26:17">كمَنْ يُمسِكُ كَلبًا عابِرًا بِأُذُنَيهِ.<verse eid="PRO 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 26:18" />منْ يمكُرُ بِصَديقِهِ ويقولُ: ”أنا أمزَحُ“،<verse eid="PRO 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="PRO 26:19" />كمجنونٍ يَرمي نارًا وسِهامًا وموتًا<verse eid="PRO 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="PRO 26:20" />باَنْقِطاعِ الحطَبِ تَنطَفِئُ النَّارُ،</para>
  <para style="p" vid="PRO 26:20">وبِزَوالِ النَمَّامِ يَهدَأُ الخِصامُ.<verse eid="PRO 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 26:21" />الفَحْمُ لِلجَمرِ والحطَبُ لِلنَّارِ،</para>
  <para style="p" vid="PRO 26:21">والمُخاصِمُ لإثارَةِ التُّهَمِ.<verse eid="PRO 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="PRO 26:22" />كَلِماتُ النَمَّامِ كطَعامٍ شهِيٍّ</para>
  <para style="p" vid="PRO 26:22">يَنزِلُ إلى أعماقِ البَطْنِ.<verse eid="PRO 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="PRO 26:23" />الكلامُ المَعسولُ معَ النيَّةِ السَّيِّئَةِ،</para>
  <para style="p" vid="PRO 26:23">غِشاءٌ مِنْ تِبْرٍ على إناءٍ مِنْ خزَفٍ.<verse eid="PRO 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="PRO 26:24" />المُبغِضُ يُراوغُ بِكَلامِهِ،</para>
  <para style="p" vid="PRO 26:24">وفي قلبِهِ يُضمِرُ المكْرَ.<verse eid="PRO 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="PRO 26:25" />إذا تَعَطَّفَ بِكَلامِهِ فلا تُصَدِّقْهُ،</para>
  <para style="p" vid="PRO 26:25">ففي قلبِهِ عيوبٌ لا تُحصَى.<verse eid="PRO 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="PRO 26:26" />مهما أخفى بُغضَهُ بِخُبْثٍ</para>
  <para style="p" vid="PRO 26:26">اَفْتضَحَ شرَّهُ أمامَ النَّاسِ.<verse eid="PRO 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="PRO 26:27" />مَنْ يَحفُرْ هُوَّةً يسقُطْ فيها،</para>
  <para style="p" vid="PRO 26:27">ومَنْ يُدَحرِجْ حجَرًا يَرجِعْ علَيهِ.<verse eid="PRO 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="PRO 26:28" />لِسانُ الكَذِبِ يُودي بِصاحِبهِ</para>
  <para style="p" vid="PRO 26:28">والفَمُ المُتَملِّقُ يَجلِبُ الخرَابَ.<verse eid="PRO 26:28" /></para>
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 27:1" />لا تُهَلِّلْ لِيومِ الغَدِ،</para>
  <para style="p" vid="PRO 27:1">فهَل تَعرِفُ ما يَلِدُ اليومُ؟<verse eid="PRO 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 27:2" />دعِ الأجنبيَّ يَمدَحُكَ لا فَمُكَ،</para>
  <para style="p" vid="PRO 27:2">والغريبَ لا شَفَتاكَ.<verse eid="PRO 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 27:3" />الحجَرُ ثقيلٌ والرَّملُ ثقيلٌ،</para>
  <para style="p" vid="PRO 27:3">وتقاعُسُ الأحمقِ أثقَلُ مِنهُما.<verse eid="PRO 27:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 27:4" />الغَيظُ قاسٍ والغضَبُ غامِرٌ،</para>
  <para style="p" vid="PRO 27:4">والحسَدُ مَنْ يَقِفُ في وجهِهِ؟<verse eid="PRO 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 27:5" />التَّوبيخُ الّذي تُعلِنُهُ</para>
  <para style="p" vid="PRO 27:5">خيرٌ مِنَ الحُبِّ الَّذي تُضمرُهُ.<verse eid="PRO 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 27:6" />جُروحُ المُحِبِّ أمينَةٌ،</para>
  <para style="p" vid="PRO 27:6">وقُبلاتُ العَدُوِّ خائِنَةٌ.<verse eid="PRO 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 27:7" />النَّفْسُ الشَّبعانةُ تَعافُ العسَلَ،</para>
  <para style="p" vid="PRO 27:7">وللنَّفْسِ الجائِعَةِ كُلُّ مُرٍّ حُلوٌ.<verse eid="PRO 27:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 27:8" />إنسانٌ شاردٌ منْ وطنِهِ</para>
  <para style="p" vid="PRO 27:8">عُصفورٌ شاردٌ مِنْ عُشِّهِ.<verse eid="PRO 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 27:9" />العِطْرُ والبَخُورُ يُفرِّحانِ القلبَ،</para>
  <para style="p" vid="PRO 27:9">ونصيحةُ الصِّدِّيقِ تَحلو للنَّفْسِ.<verse eid="PRO 27:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 27:10" />لا تترُكْ صديقَكَ وصديقَ أبيكَ،</para>
  <para style="p" vid="PRO 27:10">ولا تدخُلْ بَيتَ أخيكَ في يَومِ نَكبَتِكَ.</para>
  <para style="p" vid="PRO 27:10">الجارُ القريبُ خَيرٌ مِنَ الأخِ البعيدِ.<verse eid="PRO 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 27:11" />كُنْ حكيمًا يا اَبْني وفَرِّحْ قلبي،</para>
  <para style="p" vid="PRO 27:11">فأرُدَّ على مَنْ يُحَرِّفُ كَلامي.<verse eid="PRO 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 27:12" />الذَّكيُّ يرَى الشَّرَّ فيَختَبِئُ،</para>
  <para style="p" vid="PRO 27:12">والجُهَّالُ يَعبُرونَهُ فيُعاقَبونَ.<verse eid="PRO 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 27:13" />إنْ كَفِلْتَ غريبًا تكونُ غبِيًّا،</para>
  <para style="p" vid="PRO 27:13">وإلَّا فخُذْ ثَوبَهُ رَهْنًا لكَ.<verse eid="PRO 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 27:14" />مَنْ صَبَّحَ صديقَهُ بِصَوتٍ جَهيرٍ،</para>
  <para style="p" vid="PRO 27:14">كانَ ذلِكَ لَعنَةً لا بركةً.<verse eid="PRO 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 27:15" />كالوَكْفِ المُتواصِلِ في يومٍ مُمْطرٍ،</para>
  <para style="p" vid="PRO 27:15">هكذا المرأةُ النَقَّاقَةُ.<verse eid="PRO 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 27:16" />مَنْ ضَبَطَها يَضبُطُ الرِّيحَ</para>
  <para style="p" vid="PRO 27:16">ويَقبِضُ بِيَمينِهِ على زيتٍ.<verse eid="PRO 27:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 27:17" />الحديدُ يَصقُلُ الحديدَ،</para>
  <para style="p" vid="PRO 27:17">وكذلِكَ العِشْرَةُ بَينَ النَّاسِ.<verse eid="PRO 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 27:18" />مَنْ يَنظُرْ تِينَتَهُ يَأكُلْ ثمَرَها،</para>
  <para style="p" vid="PRO 27:18">ومَنْ يُحافِظْ على سيِّدِهِ يُكرَمْ.<verse eid="PRO 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="PRO 27:19" />الوجهُ في الماءِ يَتَراءى للوجهِ،</para>
  <para style="p" vid="PRO 27:19">وكذلِكَ قلبُ الإنسانِ لِلإنسانِ.<verse eid="PRO 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="PRO 27:20" />الجحيمُ والهاويةُ لا يَشبَعانِ،</para>
  <para style="p" vid="PRO 27:20">وكذلِكَ عَينَا الإنسانِ.<verse eid="PRO 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 27:21" />البُوتَقَةُ تَمتَحِنُ الفِضَّةَ والذَّهَبَ،</para>
  <para style="p" vid="PRO 27:21">كما يَمتَحِنُ المديحُ الإنسانَ.<verse eid="PRO 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="PRO 27:22" />لو دَققْتَ الأحمقَ في هاونٍ</para>
  <para style="p" vid="PRO 27:22">معَ الحُبوبِ، عبَثًا تُفارِقُهُ حَماقتُهُ.<verse eid="PRO 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="PRO 27:23" />إجتَهِدْ في مَعرِفَةِ حالِ غنَمِكَ،</para>
  <para style="p" vid="PRO 27:23">ووَجِّهْ قلبَكَ إلى قُطْعانِكَ.<verse eid="PRO 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="PRO 27:24" />فحُسْنُ الحالِ لا يَدومُ،</para>
  <para style="p" vid="PRO 27:24">ولا المُلكُ إلى جيلٍ فجيلٍ.<verse eid="PRO 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="PRO 27:25" />تَخضرُّ الأرضُ ويظهَرُ الحَشيشُ</para>
  <para style="p" vid="PRO 27:25">ويَنبُتُ العُشْبُ في الجِبالِ.<verse eid="PRO 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="PRO 27:26" />فتَمُدُّكَ الكِباشُ بِمَلبوسِكَ</para>
  <para style="p" vid="PRO 27:26">والتُّيوسُ بِثَمنِ الحَقلِ،<verse eid="PRO 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="PRO 27:27" />ويَكفيكَ لَبَنُ المعَزِ طَعامًا لكَ</para>
  <para style="p" vid="PRO 27:27">وقُوتًا لِعيالِكَ ومعيشَةِ جَواريكَ.<verse eid="PRO 27:27" /></para>
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 28:1" />الشِّرِّيرُ يهربُ ولا مَنْ يُطاردُ،</para>
  <para style="p" vid="PRO 28:1">أمَّا الصِّدِّيقُ فيطمئِنُّ كالشِّبْلِ.<verse eid="PRO 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 28:2" />يَخطَأُ الشَّعبُ فيكثُرُ الحُكَّامُ،</para>
  <para style="p" vid="PRO 28:2">وبالفَهْمِ والمَعرِفةِ يدومُ.<verse eid="PRO 28:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 28:3" />الفقيرُ الَّذي يَظلِمُ الفقراءَ،</para>
  <para style="p" vid="PRO 28:3">مطَرٌ جارِفٌ لا يُبقي على قُوتٍ.<verse eid="PRO 28:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 28:4" />الَّذينَ يُهمِلونَ الشَّريعةَ يَمدَحونَ الأشرارَ،</para>
  <para style="p" vid="PRO 28:4">والَّذينَ يَحفَظونَ الشَّريعَةَ يُخاصمُونَهُم.<verse eid="PRO 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 28:5" />أهلُ السُّوءِ لا يتَبَيَّنونَ الإنصافَ،</para>
  <para style="p" vid="PRO 28:5">ومَنْ يطلبِ الرّبَّ يتَبَيَّنْ كُلَّ شيءٍ.<verse eid="PRO 28:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 28:6" />الفقيرُ السَّالِكُ طريقَ الكمالِ</para>
  <para style="p" vid="PRO 28:6">خيرٌ مِنَ الغنيِّ وطريقُهُ مُعوَجٌّ.<verse eid="PRO 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 28:7" />مَنْ يُناصِرِ الشَّريعةَ فهوَ اَبنٌ فهيمٌ،</para>
  <para style="p" vid="PRO 28:7">ومَنْ يُعاشرِ المُنحَرفينَ يُخجِلْ أباهُ.<verse eid="PRO 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 28:8" />مَنْ يَجمَعْ مالَهُ بِالرِّبَى الزَّائدِ،</para>
  <para style="p" vid="PRO 28:8">فلِمَنْ يَحِنُّ على الفقراءِ جَمعَهُ.<verse eid="PRO 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 28:9" />مَنْ يَصرِفْ أذُنَهُ عَنْ سَماعِ الشّريعَةِ،</para>
  <para style="p" vid="PRO 28:9">فصلاتُهُ نفسُها يَمقُتُها الرّبُّ.<verse eid="PRO 28:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 28:10" />مَنْ ضَلَّلَ المُستَقيمينَ في طريقِ الشَّرِّ</para>
  <para style="p" vid="PRO 28:10">سقَطَ في الحُفْرةِ الّتي حفَرَها.</para>
  <para style="p" vid="PRO 28:10">أمَّا الأبرارُ فيَمتَلِكون خَيرًا.<verse eid="PRO 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 28:11" />الغنيُّ حكيمٌ في عينَي نفْسِهِ،</para>
  <para style="p" vid="PRO 28:11">والفقيرُ الفهيمُ يَستَصغِرُهُ.<verse eid="PRO 28:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 28:12" />في اَنْتِصارِ الصِّدِّيقينَ فَخْرٌ عظيمٌ،</para>
  <para style="p" vid="PRO 28:12">وعِندَ قيامِ الأشرارِ يَختَبِئُ النَّاسُ.<verse eid="PRO 28:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 28:13" />مَنْ أخفَى ذُنُوبَهُ لا يَنجَحُ،</para>
  <para style="p" vid="PRO 28:13">ومَنْ أقرَّ بها وترَكها يُرحَمُ.<verse eid="PRO 28:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 28:14" />مَنْ خضَعَ للرّبِّ يَدومُ هَناؤُهُ،</para>
  <para style="p" vid="PRO 28:14">ومَنْ قَسَّى قلبَهُ يَقَعُ في الشَّرِّ.<verse eid="PRO 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 28:15" />السَّيِّدُ الشِّرِّيرُ على شعبٍ ذليلٍ،</para>
  <para style="p" vid="PRO 28:15">أسدٌ زائرٌ ودُبٌّ جائِعٌ.<verse eid="PRO 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 28:16" />الشُّجاعُ الفاقِدُ الفَهْمِ يُكثِرُ المَظالِمَ،</para>
  <para style="p" vid="PRO 28:16">والّذي يُبغِضُ الجشَعَ يُطيلُ أيّامَهُ.<verse eid="PRO 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 28:17" />المُثقَلُ الضميرِ بِدَمِ الآخرينَ</para>
  <para style="p" vid="PRO 28:17">يهربُ إلى الهاويةِ ولا مَنْ يُمسِكُهُ.<verse eid="PRO 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 28:18" />السَّالِكُ طريقَ الكمالِ يَخلُصُ،</para>
  <para style="p" vid="PRO 28:18">ومَنِ اَعْوجَّتْ طرُقُهُ يسقُطُ في الهاويةِ.<verse eid="PRO 28:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="PRO 28:19" />مَنْ يَفلَحْ أرضَهُ يَشبَعْ خبزًا،</para>
  <para style="p" vid="PRO 28:19">ومَنْ يَتبَعِ البِطالَةَ يَشبَعْ فَقْرًا.<verse eid="PRO 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="PRO 28:20" />الرَّجلُ الأمينُ كثيرُ البرَكاتِ،</para>
  <para style="p" vid="PRO 28:20">ومنِ اَسْتَعجَلَ الغِنى لا عُذرَ لهُ.<verse eid="PRO 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 28:21" />مُحاباةُ النَّاسِ لا تَجوزُ،</para>
  <para style="p" vid="PRO 28:21">ولِكِسْرَةِ خبزٍ يُذنِبُ الإنسانُ.<verse eid="PRO 28:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="PRO 28:22" />الشِّرِّيرُ العينِ يستَعجِلُ الغِنى،</para>
  <para style="p" vid="PRO 28:22">ولا يَعرِفُ أنَّ الخَسارةَ تَأتيهِ.<verse eid="PRO 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="PRO 28:23" />مَنْ يوبِّخْ ينَلْ حُظوةً مِنْ بَعدُ</para>
  <para style="p" vid="PRO 28:23">أكثرَ مِنْ صاحبِ الكَلامِ المَعسولِ.<verse eid="PRO 28:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="PRO 28:24" />مَنْ سَلَبَ أبويهِ وقالَ: لم أَخطَأْ</para>
  <para style="p" vid="PRO 28:24">يكونُ كمنْ مالُهُ حَرامٌ.<verse eid="PRO 28:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="PRO 28:25" />الإنسانُ الجَشِعُ يَجُرُّ إلى الخِصامِ،</para>
  <para style="p" vid="PRO 28:25">والمُتَّكِلُ على الرّبِّ يَغنَى.<verse eid="PRO 28:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="PRO 28:26" />مَنِ اَتَّكلَ على قلبِهِ يكونُ بليدًا،</para>
  <para style="p" vid="PRO 28:26">ومَنْ سَلَكَ طريقَ الحِكمةِ يَنجو.<verse eid="PRO 28:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="PRO 28:27" />مَنْ تَصدَّقَ على الفقيرِ لا يَفتَقِرُ،</para>
  <para style="p" vid="PRO 28:27">ولِمَنْ يتَعافى عَنه لَعَناتٌ كثيرةٌ.<verse eid="PRO 28:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="PRO 28:28" />عِندَ قِيامِ الأشرارِ يتَوارَى النَّاسُ،</para>
  <para style="p" vid="PRO 28:28">وإذا أُبيدوا تكاثَرَ الصِّدِّيقونَ.<verse eid="PRO 28:28" /></para>
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 29:1" />الّذي تُوَبِّخُهُ فيَزدادُ عِنادًا</para>
  <para style="p" vid="PRO 29:1">يَنكسِرُ في الحالِ ولا شِفاءَ.<verse eid="PRO 29:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 29:2" />إذا تكاثَرَ الصِّدِّيقونَ فَرِحَ الشَّعبُ،</para>
  <para style="p" vid="PRO 29:2">وإذا سادَ الأشرارُ ناحَ.<verse eid="PRO 29:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 29:3" />مَنْ يُحِبُّ الحِكمةَ يُفرِّحُ أباهُ،</para>
  <para style="p" vid="PRO 29:3">وعَشيرُ الزَّواني يُبَدِّدُ مالَهُ.<verse eid="PRO 29:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 29:4" />المَلِكُ بالإنصافِ يُثَبِّتُ البِلادَ</para>
  <para style="p" vid="PRO 29:4">وبكثرةِ الضَّرائبِ يُخَرِّبُها.<verse eid="PRO 29:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 29:5" />الرّجلُ الّذي يتَمَلَّقُ غَيرَهُ،</para>
  <para style="p" vid="PRO 29:5">يَنصُبُ فَخًّا لخَطَواتِهِ.<verse eid="PRO 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 29:6" />الشِّرِّيرُ يقَعُ في شَرَكِ مَعصيَتِهِ،</para>
  <para style="p" vid="PRO 29:6">أمَّا الصِّدِّيقُ فيَطرَبُ ويَفرَحُ.<verse eid="PRO 29:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 29:7" />الصِّدِّيقُ يَعتَرِفُ بِضُعفِ الوضيعِ،</para>
  <para style="p" vid="PRO 29:7">أمّا الشِّرِّيرُ فلا يَعتَرفُ بهِ.<verse eid="PRO 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 29:8" />السّاخِرونَ يَفتِنُونَ المدينةَ،</para>
  <para style="p" vid="PRO 29:8">والحُكَماءُ يَصرِفونَ الغضَبَ.<verse eid="PRO 29:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 29:9" />الحكيمُ الّذي يُقاضي الأحمَقَ،</para>
  <para style="p" vid="PRO 29:9">يَدينُهُ ويَذِلُّهُ ولا فائِدةَ.<verse eid="PRO 29:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 29:10" />سافِكُ الدِّماءِ يُبغِضُ الأبرارَ،</para>
  <para style="p" vid="PRO 29:10">أمَّا الشِّرِّيرُ فيَطلُبُ حياتَهُم.<verse eid="PRO 29:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 29:11" />البليدُ يُخرِجُ كُلَّ غَيظِهِ،</para>
  <para style="p" vid="PRO 29:11">والحكيمُ يُهَدِّئُهُ ويَكْبِتُهُ.<verse eid="PRO 29:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 29:12" />إذا أنصَتَ السَّيِّدُ لِكَلامِ الكذِبِ،</para>
  <para style="p" vid="PRO 29:12">فجميعُ مَرؤوسيهِ مِنَ الأشرارِ.<verse eid="PRO 29:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 29:13" />الفقيرُ والأبلَهُ يَتساوَيانِ</para>
  <para style="p" vid="PRO 29:13">والرّبُّ يُنيرُ أعيُنَ كِلَيهِما.<verse eid="PRO 29:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 29:14" />يَحكُمُ المَلِكُ للفقراءِ بالحَقِّ،</para>
  <para style="p" vid="PRO 29:14">يَثْبُتُ عَرشُهُ إلى الأبدِ.<verse eid="PRO 29:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 29:15" />القِصاصُ والتَّوبيخُ سبيلُ الحِكمةِ،</para>
  <para style="p" vid="PRO 29:15">والولدُ المتروكُ على هواهُ يُخزي أمَّهُ.<verse eid="PRO 29:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 29:16" />إذا تَكاثرَ الأشرارُ تَكاثرتِ المَعاصي</para>
  <para style="p" vid="PRO 29:16">ويُشاهِدُ الصِّدِّيقونَ سُقوطَهُم.<verse eid="PRO 29:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 29:17" />أدِّبِ اَبنكَ فيُريحَكَ</para>
  <para style="p" vid="PRO 29:17">ويملأَ نفْسَكَ بالبهجةِ.<verse eid="PRO 29:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 29:18" />حَيثُ لا أنبياءَ يَشرُدُ الشَّعبُ،</para>
  <para style="p" vid="PRO 29:18">وهَنيئًا لِمَنْ يَحفَظُ الشَّريعةَ.<verse eid="PRO 29:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="PRO 29:19" />بالكَلامِ لا يُؤدَّبُ العبدُ،</para>
  <para style="p" vid="PRO 29:19">لأنَّه إنْ فَهِمَ فلا يَستَجيبُ.<verse eid="PRO 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="PRO 29:20" />أرأيتَ مُتَسَرِّعًا في كَلامِهِ؟</para>
  <para style="p" vid="PRO 29:20">الأملُ في البليدِ ولا الأملُ فيهِ.<verse eid="PRO 29:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 29:21" />مَنْ دَلَّلَ عبدَهُ في صِغَرِهِ</para>
  <para style="p" vid="PRO 29:21">اَبْتُليَ بهِ في كِبَرِهِ.<verse eid="PRO 29:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="PRO 29:22" />الغَضوبُ يَجُرُّ إلى الخِصامِ،</para>
  <para style="p" vid="PRO 29:22">والضَيِّقُ الصَّدْرِ كثيرُ المَعاصي.<verse eid="PRO 29:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="PRO 29:23" />تَباهي الإنسانِ يَحطُّ مِنْ شأنِهِ،</para>
  <para style="p" vid="PRO 29:23">والمُتواضِعُ الرُّوحِ يَنالُ مَجدًا.<verse eid="PRO 29:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="PRO 29:24" />شريكُ السَّارِقِ عَدوُّ نفْسِهِ،</para>
  <para style="p" vid="PRO 29:24">يَسمَعُ اللَّعْنَ ولا يَنطِقُ بالحَقِّ.<verse eid="PRO 29:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="PRO 29:25" />مَنْ يُسرِعْ يقَعْ في الشَّرَكِ،</para>
  <para style="p" vid="PRO 29:25">والمُتَّكِلُ على الرّبِّ يَأمَنُ.<verse eid="PRO 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="PRO 29:26" />كثيرونَ يَطلُبونَ رِضى الأسيادِ،</para>
  <para style="p" vid="PRO 29:26">لكِنِ الرّبُّ يُنصِفُ كُلَّ إنسانٍ.<verse eid="PRO 29:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="PRO 29:27" />الإنسانُ الجائِرُ يَمقُتُهُ الصِّدِّيقونَ،</para>
  <para style="p" vid="PRO 29:27">والمُستَقيمُ في سُلوكِهِ يَعيبُهُ الأشرارُ.<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="s1">كلام أجور</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 30:1" />هذا كلامُ أجورَ بنِ ياقةَ مِنْ مَسَّا: قالَ هذا الرَّجلُ لإيثيئيلَ، لإيثيئيلَ وأُكَّالَ: <verse eid="PRO 30:1" /><verse number="2" style="v" pubnumber="2" sid="PRO 30:2" />أنا أغبى النَّاسِ، وتُعوِزُني فِطنَةُ البشَرِ.<verse eid="PRO 30:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 30:3" />ما تعَلَّمْتُ الحِكمةَ ولا عرَفْتُ شيئًا عَنِ القدُّوسِ.<verse eid="PRO 30:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 30:4" />مَنْ صَعِدَ إلى السَّماءِ ونَزَلَ؟</para>
  <para style="p" vid="PRO 30:4">مَنْ جمَعَ الرِّيحَ في راحَتَيهِ؟</para>
  <para style="p" vid="PRO 30:4">مَنْ حصَرَ المياهَ في ثَوبٍ؟</para>
  <para style="p" vid="PRO 30:4">مَنْ أقامَ جميعَ أطرافِ الأرضِ؟</para>
  <para style="p" vid="PRO 30:4">ما اَسْمُهُ؟ ما اَسْمُ اَبنِهِ إنْ كُنتَ تعرفُ؟<verse eid="PRO 30:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="PRO 30:5" />كلامُ اللهِ نَقيٌّ كُلُّهُ، واللهُ دِرْعٌ للمُحتَمينَ بهِ.<verse eid="PRO 30:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 30:6" />لا تَزِدْ على كَلامِ اللهِ. لئلَّا يُوَبِّخَكَ فتَظهَرَ كاذبًا.<verse eid="PRO 30:6" /></para>
  <para style="s1">أمثال أخرى</para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="PRO 30:7" />شيئينِ طَلبتُ مِنكَ يا اللهُ، فلا تمنَعْهُما عنِّي قَبلَ أنْ أموتَ: <verse eid="PRO 30:7" /><verse number="8" style="v" pubnumber="8" sid="PRO 30:8" />أبعِدْ عنِّي السُّوءَ والكذِبَ. لا تُعطني فَقْرًا ولا غِنىً. بل اَرزِقْني مِنَ الخبزِ ما أستَحِقُّ <verse eid="PRO 30:8" /><verse number="9" style="v" pubnumber="9" sid="PRO 30:9" />لِئلَّا أشبَعَ فأكفُرَ وأقولَ مَنْ هوَ الرّبُّ؟ أو لِئلَّا أفتَقِرَ فأسرِقَ وأُدَنِّسَ اَسمَ إلهي.<verse eid="PRO 30:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 30:10" />لا تَشْكُ عبدًا إلى سيِّدِهِ، لئلَّا يَلعَنَكَ ويَشمَتَ بِكَ.<verse eid="PRO 30:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 30:11" />هُناكَ جيلٌ يَلعَنُ أباهُ ولا يُبارِكُ أُمَّهُ.<verse eid="PRO 30:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 30:12" />هُناكَ جيلٌ يَرى نفْسَه طاهرًا، وهوَ مِنْ وسَخِهِ لا يَغتَسِلُ.<verse eid="PRO 30:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 30:13" />هُناكَ جيلٌ مُتَرَفِّعُ العُيونِ ومُتَعالي الجُفونِ.<verse eid="PRO 30:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 30:14" />هُناكَ جيلٌ أسنانُهُ حِرابٌ وأضراسُهُ سكاكينُ، فيأكُلُ المَساكينَ في الأرضِ والبؤساءَ بَينَ البشَرِ.<verse eid="PRO 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 30:15" />للعَلَقَةِ بِنتان تَقولانِ: ”هاتِ، هاتِ“. هُناكَ ثلاثٌ لا تَشبَعُ، والرَّابِعةُ لا تقولُ ”كفَى“: <verse eid="PRO 30:15" /><verse number="16" style="v" pubnumber="16" sid="PRO 30:16" />عالَمُ الأمواتِ والرَّحِمُ العقيمةُ، والأرضُ الّتي لا تَرتَوي، والنَّارُ المُشتَعِلَةُ. <verse eid="PRO 30:16" /><verse number="17" style="v" pubnumber="17" sid="PRO 30:17" />العينُ المُستَهزِئَةُ بالأبِ والمُستَخِفَّةُ بإطاعةِ الأمِّ تَنقُرُها غُربانُ الوادي وتأكُلُها فِراخُ النَّسْرِ.<verse eid="PRO 30:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 30:18" />هُناكَ ثلاثةٌ ما أعجَبَها في نظَري، والرَّابعُ لا أُدركُهُ: <verse eid="PRO 30:18" /><verse number="19" style="v" pubnumber="19" sid="PRO 30:19" />طَيَرانُ النَّسْرِ في السَّماءِ، وزَحْفُ الحَيَّةِ على الصَّخرِ، وسَيرُ السّفينَةِ في عُرْضِ البحرِ، وطريقُ الرَّجلِ إلى قلبِ المَرأةِ، <verse eid="PRO 30:19" /><verse number="20" style="v" pubnumber="20" sid="PRO 30:20" />وهُنالكَ خامِسٌ: سُلوكُ المَرأةِ الزَّانيةِ. فهيَ تَزني وتغتَسِلُ وتقولُ: ”ما فعَلْتُ إثْمًا“.<verse eid="PRO 30:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 30:21" />تَحتَ ثلاثةٍ تَرتَجُّ الأرضُ، وتحتَ الرَّابعِ لا تَقوى على الاحتِمالِ: <verse eid="PRO 30:21" /><verse number="22" style="v" pubnumber="22" sid="PRO 30:22" />عبدٌ صارَ مَلِكًا، وخامِلٌ شَبِعَ خُبزًا، <verse eid="PRO 30:22" /><verse number="23" style="v" pubnumber="23" sid="PRO 30:23" />واَمرأةٌ قبيحَةٌ تزَوَّجَت، وخادِمَةٌ وَرِثَت سيِّدَتَها.<verse eid="PRO 30:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="PRO 30:24" />أربَعَةٌ هيَ الصُّغرى في الأرضِ، ولكِنَّها حكيمةٌ جِدًّا: <verse eid="PRO 30:24" /><verse number="25" style="v" pubnumber="25" sid="PRO 30:25" />النَّمْلُ جماعةٌ لا قُوَّةَ لها، لكِنَّهُ يُهَيِّئُ في الصَّيفِ طَعامَهُ. <verse eid="PRO 30:25" /><verse number="26" style="v" pubnumber="26" sid="PRO 30:26" />والوِبارُ جماعةٌ لا قُدرَةَ لها، لكِنَّها تَجعَلُ في الصَّخْرِ بُيوتَها. <verse eid="PRO 30:26" /><verse number="27" style="v" pubnumber="27" sid="PRO 30:27" />والجَرادُ لا مَلِكَ لَه، لكِنَّهُ يَزحَفُ صَفًّا صَفًّا. <verse eid="PRO 30:27" /><verse number="28" style="v" pubnumber="28" sid="PRO 30:28" />والعَنكبوتُ تُمسِكُ بالأيدي وهيَ في قُصورِ المُلوكِ.<verse eid="PRO 30:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="PRO 30:29" />ثلاثَةٌ جَليلَةُ الخَطَواتِ، والرَّابِعةُ حسَنَةُ السَّيرِ: <verse eid="PRO 30:29" /><verse number="30" style="v" pubnumber="30" sid="PRO 30:30" />الأسدُ جبَّارُ البَهائِمِ، وهوَ لا يَرجِعُ مِنْ وَجهِ أحدٍ، <verse eid="PRO 30:30" /><verse number="31" style="v" pubnumber="31" sid="PRO 30:31" />والدِّيكُ والتَّيسُ والمَلِكُ أمامَ قَومِهِ.<verse eid="PRO 30:31" /></para>
  <para style="p">
    <verse number="32" style="v" pubnumber="32" sid="PRO 30:32" />إنْ رفَعْتَ نفسَكَ تكبّرًا، أو شَمَخْتَ بِأنفِكَ، فضَعْ يدَكَ على قلبِكَ، <verse eid="PRO 30:32" /><verse number="33" style="v" pubnumber="33" sid="PRO 30:33" />لأنَّ خَضَّ اللَّبَنِ يُخرِجُ الزُّبدَةَ، ودَلْكِ الأنفِ يُخرِجُ الدَّمَ، وهياجَ الغضَبِ يَبعَثُ الخِصامَ.<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="s1">نصيحة أم</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="PRO 31:1" />هذا كَلامُ لَمُوئيلَ مَلكِ مسَّا، أدَّبَتْهُ بهِ أمُّهُ:<verse eid="PRO 31:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="PRO 31:2" />ماذا أقولُ لكَ يا اَبني؟</para>
  <para style="p" vid="PRO 31:2">ماذا أقولُ يا اَبنَ أحشائي؟</para>
  <para style="p" vid="PRO 31:2">يا مَنْ نَذَرْتُ لأجلِهِ نُذوري؟<verse eid="PRO 31:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="PRO 31:3" />لا تُبَدِّدْ حَيلَكَ على النِّساءِ،</para>
  <para style="p" vid="PRO 31:3">ولا على ما يُسَبِّبُ هلاكَ المُلوكِ.<verse eid="PRO 31:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="PRO 31:4" />لا يَليقُ بالمُلوكِ، يا لَمُوئيلُ، لا يَليقُ بالمُلوكِ أنْ يَشرَبوا الخمرَ، ولا بالعُظَماءِ أن يُدمِنوا المُسكِرَ، <verse eid="PRO 31:4" /><verse number="5" style="v" pubnumber="5" sid="PRO 31:5" />لِئلَّا يَسكروا فَيَنسَوا حُقوقَ النَّاسِ، ويُهمِلوا دَعوى المَساكينِ.<verse eid="PRO 31:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="PRO 31:6" />أعطِ المُسكِرَ للهالِكينَ، والخمرَ لِأصحابِ النُّفوسِ المُّرَّةِ، <verse eid="PRO 31:6" /><verse number="7" style="v" pubnumber="7" sid="PRO 31:7" />فيَسكروا ويَنسَوا فَقْرَهُم ولا يَذكُروا تَعاسَتَهُم بَعدُ.<verse eid="PRO 31:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="PRO 31:8" />إفتَحْ فَمَكَ دِفاعًا عَنِ المُتألِّمينَ، وعَنْ حُقوقِ جميعِ المُهمَلينَ.<verse eid="PRO 31:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="PRO 31:9" />إفتَحْ فَمَكَ واَحكُمْ بالعَدلِ وأنصِفِ المِسكينَ والبائِسَ.<verse eid="PRO 31:9" /></para>
  <para style="s1">المرأة القديرة</para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="PRO 31:10" />المَرأةُ القديرةُ مَنْ يَجِدُها؟</para>
  <para style="p" vid="PRO 31:10">قيمَتُها تفوقُ اللَّآلئَ.<verse eid="PRO 31:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="PRO 31:11" />إليها يَطْمَئِنُّ قلبُ زَوجِها،</para>
  <para style="p" vid="PRO 31:11">فلا يُعوِزُهُ مَغنَمٌ.<verse eid="PRO 31:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="PRO 31:12" />تَحمِلُ لَه الخَيرَ مِنْ دونِ الشّرِّ،</para>
  <para style="p" vid="PRO 31:12">طُولَ أيّامِ حياتِها.<verse eid="PRO 31:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="PRO 31:13" />تَطلُبُ صُوفًا وكتَّانًا</para>
  <para style="p" vid="PRO 31:13">وتَعملُ بِيَدَينِ راضيَتَيْنِ،<verse eid="PRO 31:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="PRO 31:14" />فتكونُ كالسُّفُنِ التِّجاريَّةِ،</para>
  <para style="p" vid="PRO 31:14">تَجلِبُ طَعامَها مِنْ بعيدٍ.<verse eid="PRO 31:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="PRO 31:15" />تقومُ قبلَ طُلوعِ الفَجرِ</para>
  <para style="p" vid="PRO 31:15">لتُهَيِّئَ لأهلِ بَيتِها طَعامًا، ولِخادِماتِها عمَلًا.<verse eid="PRO 31:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="PRO 31:16" />تتَأمَّلُ حَقلًا فتَشتَريهِ،</para>
  <para style="p" vid="PRO 31:16">وبِثَمَرِ يَدَيها تَغرِسُ كرمًا.<verse eid="PRO 31:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="PRO 31:17" />تتَزَنَّرُ بالقُوَّةِ وتُشَدِّدُ ذِراعَيها.<verse eid="PRO 31:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="PRO 31:18" />تَرَى أنَّ تِجارَتَها رابِحةٌ،</para>
  <para style="p" vid="PRO 31:18">فسِراجُها لا يَنطَفِئُ في اللَّيلِ.<verse eid="PRO 31:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="PRO 31:19" />تُلقي يَدَيها على المِكَبِّ،</para>
  <para style="p" vid="PRO 31:19">وتُمسِكُ بِكفَّيها المِغْزَلَ.<verse eid="PRO 31:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="PRO 31:20" />تَبسُطُ كفَّيها إلى المِسكينِ،</para>
  <para style="p" vid="PRO 31:20">وتمُدُّ يَدَيها إلى البائِسِ.<verse eid="PRO 31:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="PRO 31:21" />لا تَخافُ على أهلِ بَيتِها مِنَ الثَّلْجِ،</para>
  <para style="p" vid="PRO 31:21">فكُلُّ واحدٍ يَلبَسُ حُلَّتَينِ.<verse eid="PRO 31:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="PRO 31:22" />تَصنَعُ لِنَفْسِها أغطيَةً مُوَشَّاةً،</para>
  <para style="p" vid="PRO 31:22">وتَلبَسُ الدِّيباجَ والأرجُوانَ.<verse eid="PRO 31:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="PRO 31:23" />زَوجُها مَعروفٌ في المَجالِسِ،</para>
  <para style="p" vid="PRO 31:23">وهوَ مِنْ مَشايخِ البلدِ.<verse eid="PRO 31:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="PRO 31:24" />تَصنَعُ قُمصانًا وتَبيعُها،</para>
  <para style="p" vid="PRO 31:24">وتَعرِضُ أحزِمَةً على التَّاجِرِ.<verse eid="PRO 31:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="PRO 31:25" />تَلبَسُ العِزَّ والبَهاءَ،</para>
  <para style="p" vid="PRO 31:25">وتَضحَكُ على الأيّامِ الآتيةِ.<verse eid="PRO 31:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="PRO 31:26" />تَفتَحُ فَمَها بالحِكمةِ،</para>
  <para style="p" vid="PRO 31:26">وفي لِسانِها كَلامُ المَعروفِ.<verse eid="PRO 31:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="PRO 31:27" />تُراقبُ سُلوكَ أهلِ بَيتِها،</para>
  <para style="p" vid="PRO 31:27">ولا تَأكُلُ خبزَ البِطالَةِ.<verse eid="PRO 31:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="PRO 31:28" />يَنهَضُ أولادُها فيُبارِكونَها،</para>
  <para style="p" vid="PRO 31:28">وزَوجُها يَمدَحُها فيقولُ:<verse eid="PRO 31:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="PRO 31:29" />”نِساءٌ كثيراتٌ أظهَرنَ قُدْرةً،</para>
  <para style="p" vid="PRO 31:29">وأنتِ تَفَوَّقْتِ علَيهِنَّ جميعًا“.<verse eid="PRO 31:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="PRO 31:30" />الحُسْنُ غُرورٌ والجَمالُ باطِلٌ،</para>
  <para style="p" vid="PRO 31:30">وللمَرأةِ الّتي تَخافُ الرّبَّ كُلُّ المديحِ.<verse eid="PRO 31:30" /></para>
  <para style="p">
    <verse number="31" style="v" pubnumber="31" sid="PRO 31:31" />فأعطُوها مِنْ ثمَرِ يَدَيها،</para>
  <para style="p" vid="PRO 31:31">ولتَمدَحْها أعمالُها في المَجالِسِ.<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>