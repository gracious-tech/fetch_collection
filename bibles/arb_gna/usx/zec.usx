  <para style="toc3">زك</para>
  <para style="toc1">زكريا</para>
  <para style="toc2">زكريا</para>
  <para style="mt1">حجّاي</para>
  <para style="mt1">زكريا</para>
  <chapter number="1" style="c" sid="ZEC 1" />
  <para style="s1">الرّبّ يدعو شعبه</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="ZEC 1:1" />في الشَّهرِ الثَّامِنِ، في السَّنةِ الثَّانيةِ لدَاريّوسَ، كانت كلِمةُ الرّبِّ إلى زكَريَّا بنِ بَرَخِيَّا، بنِ عِدُّو النَّبيِّ، قالَ:<verse eid="ZEC 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="ZEC 1:2" />”الرّبُّ القديرُ غَضِبَ غضَبًا شديدًا على آبائِكُم. <verse eid="ZEC 1:2" /><verse number="3" style="v" pubnumber="3" sid="ZEC 1:3" />فقالَ لي: قُلْ لهُم: إِرْجِعوا إليَّ، فأرجِعَ إليكُم. <verse eid="ZEC 1:3" /><verse number="4" style="v" pubnumber="4" sid="ZEC 1:4" />لا تكونُوا كآبائِكُم الّذينَ ناداهُمُ الأنبياءُ الأوَّلونَ قائِلينَ: توبوا عَنْ طُرُقِكُمُ الشِّرِّيرةِ وأعمالِكُمُ السَّيِّئةِ، يقولُ الرّبُّ. ولكنَّهُم لم يَسمَعوا ولم يُصْغوا إليَّ. <verse eid="ZEC 1:4" /><verse number="5" style="v" pubnumber="5" sid="ZEC 1:5" />فأينَ الآنَ آباؤُكُم؟ والأنبياءُ هل يَحيَونَ إلى الأبدِ؟ <verse eid="ZEC 1:5" /><verse number="6" style="v" pubnumber="6" sid="ZEC 1:6" />لكنْ أقوالي وفرائِضي الّتي أوصَيتُ بِها عَبيدي الأنبياءَ تجاهَلَها آباؤُكُم. ثُمَّ تابُوا وقالوا: عامَلَنا الرّبُّ القديرُ بِحسَبِ طُرُقِنا وأعمالِنا، كما قصدَ أنْ يُعامِلَنا“.<verse eid="ZEC 1:6" /></para>
  <para style="s1">رؤيا الأفراس</para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="ZEC 1:7" />في اليومِ الرَّابعِ والعِشرينَ مِنَ الشَّهرِ الحادي عشَرَ الّذي هوَ شباطُ في السَّنةِ الثَّانيةِ لِداريّوسَ، كانت كلِمةُ الرّبِّ إلى زكَريَّا بنِ بَرَخيَّا بنِ عِدُّو النَّبيِّ، قالَ: <verse eid="ZEC 1:7" /><verse number="8" style="v" pubnumber="8" sid="ZEC 1:8" />”رأيتُ في اللَّيلِ رُؤيا، فإذا بِرَجُلٍ راكبٍ على فرسٍ سَمراءَ، وهوَ واقفٌ بَينَ شجَرِ الآسِ الظَّليلِ. وخَلْفَهُ أفراسٌ سُمْرٌ وشُقْرٌ وبِيضٌ. <verse eid="ZEC 1:8" /><verse number="9" style="v" pubnumber="9" sid="ZEC 1:9" />فقُلتُ لِلملاكِ المُتَكلِّمِ معي: مَنْ هؤلاءِ يا سيِّدي؟ فقالَ لي: أنا أُريكَ مَنْ هؤلاءِ. <verse eid="ZEC 1:9" /><verse number="10" style="v" pubnumber="10" sid="ZEC 1:10" />فأجابَ الرَّجلُ الواقِفُ بَينَ الآسِ: هؤلاءِ هُمُ الّذينَ أرسلَهُمُ الرّبُّ لِيَجولوا في الأرضِ. <verse eid="ZEC 1:10" /><verse number="11" style="v" pubnumber="11" sid="ZEC 1:11" />ثُمَّ قالَ هؤلاءِ لملاكِ الرّبِّ وللواقِفِ بَينَ الآسِ: جُلْنا في الأرضِ، فإذا الأرضُ كُلُّها ساكنةٌ هادِئةٌ.<verse eid="ZEC 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="ZEC 1:12" />”فقالَ مَلاكُ الرّبِّ: أيُّها الرّبُّ القديرُ، إلى متى لا تَرحمُ أُورُشليمَ ومُدُنَ يَهوذا الّتي تكلَّمْتَ علَيها بِغضَبٍ هذِهِ السَّبعينَ سنةً؟ <verse eid="ZEC 1:12" /><verse number="13" style="v" pubnumber="13" sid="ZEC 1:13" />فأجابَهُ الرّبُّ بكلامِ خَيرٍ وتعزيةٍ.<verse eid="ZEC 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="ZEC 1:14" />”فقالَ ليَ الملاكُ: نادِ قائلًا: هذا ما قالَ الرّبُّ القديرُ: ”غِرْتُ على أُورُشليمَ وصِهيَونَ غَيرةً عظيمةً، <verse eid="ZEC 1:14" /><verse number="15" style="v" pubnumber="15" sid="ZEC 1:15" />وأنا غاضبٌ غضَبًا شديدًا على الأُمَمِ ذوي الشَّأنِ، لأنِّي حينَ غضِبتُ قليلًا ساعدوا على الشَّرِّ. <verse eid="ZEC 1:15" /><verse number="16" style="v" pubnumber="16" sid="ZEC 1:16" />لذلِكَ سأرجِعُ على أُورُشليمَ بالمراحِمِ يقولُ الرّبُّ، فيُبْنى بَيتي فيها ويُمَدُّ خيطُ العَمارِ علَيها.<verse eid="ZEC 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="ZEC 1:17" />ونادِ أيضًا قائلًا: هذا ما قال الرّبُّ القديرُ: ”مُدُني ستعودُ تفيضُ خَيرًا، والرّبُّ سيعودُ يُعَزِّي صِهيَونَ ويختارُ أُورُشليمَ“.<verse eid="ZEC 1:17" /></para>
  <chapter eid="ZEC 1" />
  <chapter number="2" style="c" sid="ZEC 2" />
  <para style="s1">رؤيا الأربعة قرون</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="ZEC 2:1" />ورفَعْتُ عينَيَّ فرَأيتُ أربَعةَ قُرونٍ. <verse eid="ZEC 2:1" /><verse number="2" style="v" pubnumber="2" sid="ZEC 2:2" />فقُلتُ للمَلاكِ المُتكلِّمِ معي: ”ما هذِهِ؟“ فقالَ: ”هذِهِ هيَ قُرونُ الأُمَمِ الّذينَ بَعثَروا شعبَ يَهوذا وإِسرائيلَ وأُورُشليمَ“.<verse eid="ZEC 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="ZEC 2:3" />وأراني الرّبُّ أربَعةَ صُنَّاعٍ، <verse eid="ZEC 2:3" /><verse number="4" style="v" pubnumber="4" sid="ZEC 2:4" />فقُلتُ: ”ماذا جاؤُوا يعمَلونَ؟“ فقالَ: ”تِلكَ القُرونُ بَعثَرَت شعبَ يَهوذا، حتّى لم يرفَعْ إنسانٌ رأسَهُ، فجاءَ هؤلاءِ الصُّنَّاعُ لِيَجمَعوا شَملَهُم ويَقضوا بِمَطارِقِهِم على قُرونِ الأُمَمِ الّتي اَرتَفَعَت على أرضِ يَهوذا وبَعثَروا شعبَها“.<verse eid="ZEC 2:4" /></para>
  <para style="s1">رؤيا حبل المساحة</para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="ZEC 2:5" />ورَفَعْتُ عينَيَّ فرَأيتُ رَجُلًا وبيدِهِ حَبلُ مِساحةٍ. <verse eid="ZEC 2:5" /><verse number="6" style="v" pubnumber="6" sid="ZEC 2:6" />فقُلتُ: ”إلى أينَ أنتَ ذاهبٌ؟“ فقالَ لي: ”لأمسَحَ أُورُشليمَ لأرى كم عَرضُها وكم طولُها“. <verse eid="ZEC 2:6" /><verse number="7" style="v" pubnumber="7" sid="ZEC 2:7" />فخرَجَ الملاكُ المُتكلِّمُ معي، وخرَجَ معَهُ ملاكٌ آخَرُ لِلقائِهِ. <verse eid="ZEC 2:7" /><verse number="8" style="v" pubnumber="8" sid="ZEC 2:8" />فقالَ لَه الأوَّلُ: ”أسرِعْ وقُلْ لهذا الفتى: ستكونُ أُورُشليمُ مُتَّسَعًا مِنَ الأرضِ بغيرِ أسوارٍ مِنْ كثرةِ البشَرِ والبَهائِمِ فيها، <verse eid="ZEC 2:8" /><verse number="9" style="v" pubnumber="9" sid="ZEC 2:9" />والرّبُّ وَعدَ أنْ يكونَ لها سُورُ نارٍ مِنْ حَولِها ومَجدًا في داخِلِها“.<verse eid="ZEC 2:9" /></para>
  <para style="s1">دعوة المسبيين إلى العودة</para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="ZEC 2:10" />وقالَ الرّبُّ: ”هَيَّا، هَيَّا، اَهرُبُوا مِنْ أرضِ الشِّمالِ، فأنا الّذي شتَّتكُم في أربعِ رياحِ السَّماءِ. <verse eid="ZEC 2:10" /><verse number="11" style="v" pubnumber="11" sid="ZEC 2:11" />هيَّا إلى النَّجاةِ يا أهلَ أُورُشليمَ المُقيمينَ في بابلَ. <verse eid="ZEC 2:11" /><verse number="12" style="v" pubnumber="12" sid="ZEC 2:12" />مَنْ يمَسُّكُم يَمسُّ حدَقَةَ عينِهِ“. ذلِكَ ما قالَ الرّبُّ القديرُ حينَ أكرمني فأرسلَني إلى الأمَمِ الّذينَ جعَلوكُم غَنيمةً لهُم.<verse eid="ZEC 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="ZEC 2:13" />وقالَ الرّبُّ: ”سأَهزُّ يَدي علَيهِم فيكونونَ غنيمةً لِلّذينَ اَستَعبدُوهُم“. عِندَما يَحدُثُ ذلِكَ تَعلمونَ أنَّ الرّبَّ القديرَ أرسلَني.<verse eid="ZEC 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="ZEC 2:14" />وقالَ الرّبُّ: ”رنِّمي واَفرحي يا بِنتَ صِهيَونَ، فها أنا آتي وأسكُنُ في وسَطِكِ“. <verse eid="ZEC 2:14" /><verse number="15" style="v" pubnumber="15" sid="ZEC 2:15" />في ذلِكَ اليومِ يَنتَمي أُمَمٌ كثيرونَ إلى الرّبِّ ويكونونَ لَه شعبًا، فيسكُنُ في وسَطِكِ. هكذا تَعلَمينَ أنَّ الرّبَّ القديرَ أرسلَني إليكِ. <verse eid="ZEC 2:15" /><verse number="16" style="v" pubnumber="16" sid="ZEC 2:16" />ويُورِّثُ الرّبُّ يَهوذا نَصيبَهُ في الأرضِ المُقدَّسةِ، ويعودُ يختارُ أُورُشليمَ.<verse eid="ZEC 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="ZEC 2:17" />لِيسكُتْ كلُّ بشَرٍ أمامَ وجهِ الرّبِّ، لأنَّهُ أغارَ علَينا مِنْ مَسكِنِهِ المُقدَّسِ.<verse eid="ZEC 2:17" /></para>
  <chapter eid="ZEC 2" />
  <chapter number="3" style="c" sid="ZEC 3" />
  <para style="s1">رؤيا تنصيب يشوع</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="ZEC 3:1" />وأراني الرّبُّ يَشوعَ الكاهنَ العظيمَ واقفًا أمامَ ملاكِ الرّبِّ، والشَّيطانَ واقفًا عنْ يمينِهِ ليُقاوِمَهُ. <verse eid="ZEC 3:1" /><verse number="2" style="v" pubnumber="2" sid="ZEC 3:2" />فقالَ الرّبُّ لِلشَّيطانِ: ”ليَنتهِرْكَ الرّبُّ يا شيطانُ، ليَنتهِرْكَ الرّبُّ الّذي اَختارَ أُورُشليمَ. أمَا هذا شُعلةٌ مُنتَشَلَةٌ مِنَ النَّارِ؟“<verse eid="ZEC 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="ZEC 3:3" />وكانَ يَشوعُ لابسًا ثيابًا قَذِرةً وواقِفًا أمامَ الملاكِ. <verse eid="ZEC 3:3" /><verse number="4" style="v" pubnumber="4" sid="ZEC 3:4" />فقالَ الملاكُ للواقِفينَ أمامَهُ: ”إِنزِعُوا عَنهُ الثِّيابَ القذِرةَ“. ثُمَّ قال ليَشوعَ: ”أنظُرْ نَقَلْتُ إثمَكَ عَنكَ، وسأُلبِسُكَ ثيابًا ناصعةَ البَياضِ“. <verse eid="ZEC 3:4" /><verse number="5" style="v" pubnumber="5" sid="ZEC 3:5" />وقالَ لهُم: ”إِجعَلوا عِمامةً طاهرةً على رأسِهِ“. فجعَلوا العِمامةَ الطَّاهِرةَ على رأسِهِ، وألبَسوهُ الثِّيابَ النَّاصِعةَ البَياضِ، وملاكُ الرّبِّ واقِفٌ.<verse eid="ZEC 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="ZEC 3:6" />فوعَدَ ملاكُ الرّبِّ يَشوعَ قائلًا: <verse eid="ZEC 3:6" /><verse number="7" style="v" pubnumber="7" sid="ZEC 3:7" />”هذا ما قالَ الرّبُّ القديرُ: إنْ سِرْتَ في طُرُقي وعَمِلْتَ بأوامري، فأنتَ أيضًا تَحكُمُ بَيتي وتَسهَرُ على دياري، وأُعطِيكَ أنْ تَقِفَ بَينَ هؤلاءِ الملائِكةِ. <verse eid="ZEC 3:7" /><verse number="8" style="v" pubnumber="8" sid="ZEC 3:8" />فاَسمَعْ يا يَشوعُ الكاهنُ العظيمُ، أنتَ ورفاقُكَ الكهنَةُ القائمونَ أمامَكَ، وهُم أهلُ فَألٍ حسَنٍ: سآتي بِعَبدي الّذي اَسْمُهُ الغُصنُ. <verse eid="ZEC 3:8" /><verse number="9" style="v" pubnumber="9" sid="ZEC 3:9" />وها الحجَرُ الذي جعَلْتُهُ أمامَ يَشوعَ، وهوَ حجرٌ واحدٌ عليهِ سَبعُ أعينٍ، فأفتَحُ سِرَّها وأُزِيلُ إثْمَ هذِهِ الأرضِ في يومٍ واحدٍ. <verse eid="ZEC 3:9" /><verse number="10" style="v" pubnumber="10" sid="ZEC 3:10" />في ذلِكَ اليومِ يَدعو كُلُّ إنسانٍ قريبَهُ إلى تَحتِ كرمَتِهِ، وإلى تَحتِ تينتِهِ.<verse eid="ZEC 3:10" /></para>
  <chapter eid="ZEC 3" />
  <chapter number="4" style="c" sid="ZEC 4" />
  <para style="s1">رؤيا المنارة</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="ZEC 4:1" />ورجَعَ الملاكُ المُتكلِّمُ معي، فأيقظَني كما يُوقَظُ النَّائِمُ <verse eid="ZEC 4:1" /><verse number="2" style="v" pubnumber="2" sid="ZEC 4:2" />وقالَ لي: ”ماذا تَرى؟“ فقُلتُ: ”أرى مَنارةً كُلُّها ذهَبٌ، وكوبُها على رأسِها، وعلَيها سبعَةُ سُرُجٍ وسَبْعُ مساكِبَ للسُّرُجِ الّتي على رأسِها. <verse eid="ZEC 4:2" /><verse number="3" style="v" pubnumber="3" sid="ZEC 4:3" />وعلى المَنارةِ زيتونتانِ، إحداهُما عَنْ يَمينِ الكوبِ والأُخرى عَنْ يسارِهِ“. <verse eid="ZEC 4:3" /><verse number="4" style="v" pubnumber="4" sid="ZEC 4:4" />ثُمَّ قُلتُ للملاكِ: ”ما هذِهِ يا سيِّدي؟“ <verse eid="ZEC 4:4" /><verse number="5" style="v" pubnumber="5" sid="ZEC 4:5" />فأجابَ: ”ألا تَعلَمُ ما هذِهِ؟“ فقُلتُ: ”لا، يا سيِّدي“. <verse eid="ZEC 4:5" /><verse number="6" style="v" pubnumber="6" sid="ZEC 4:6" />فقالَ لي: ”هذِهِ كلِمةُ الرّبِّ إلى زَربَّابِلَ: لا بالقُدرةِ ولا بالقوَّةِ تنجحُ لكنْ بروحي يقولُ الرّبُّ القديرُ. <verse eid="ZEC 4:6" /><verse number="7" style="v" pubnumber="7" sid="ZEC 4:7" />ما أنتَ أيُّها الجبَلُ العظيمُ؟ أمامَ زَربَّابِلَ تصيرُ سَهلًا. وحينَ يضَعُ أوَّلَ حجَرٍ في بَيتي يَهتِفُ النَّاسُ هتافَ الفرحِ“.<verse eid="ZEC 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="ZEC 4:8" />وكانَت كلِمةُ الرّبِّ إليَّ، قالَ: <verse eid="ZEC 4:8" /><verse number="9" style="v" pubnumber="9" sid="ZEC 4:9" />”يَدا زَربَّابِلَ أسَّسَتا هذا البيتَ، وعلى يَدَيهِ يَتِمُّ بِناؤُهُ“. هكذا تَعلَمونَ أنَّ الرّبَّ القديرَ أرسلني إليكُم. <verse eid="ZEC 4:9" /><verse number="10" style="v" pubnumber="10" sid="ZEC 4:10" />فمَنِ الّذي يتَهَرَّبُ مِنَ العمَلِ في ذلِكَ اليومِ؟ هُم سيفرحونَ حينَ يَرونَ خَيطَ العَمارِ بيدِ زَربَّابِلَ. هذِهِ هيَ سَبعُ أعيُنِ الرّبِّ الّتي تجُولُ في الأرضِ كُلِّها.“<verse eid="ZEC 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="ZEC 4:11" />وقُلتُ: ”ما هاتانِ الزَّيتونتانِ على يَمينِ المَنارةِ ويَسارِها؟“ <verse eid="ZEC 4:11" /><verse number="12" style="v" pubnumber="12" sid="ZEC 4:12" />ثُمَّ قُلتُ لَه ثانيةً: ”ما سُنبُلتَا الزَّيتونِ اللَّتانِ عِندَ أنبوبَي الذَّهبِ اللَّذَينِ يُسكَبُ الزَّيتُ مِنهُما؟“ <verse eid="ZEC 4:12" /><verse number="13" style="v" pubnumber="13" sid="ZEC 4:13" />فقالَ: ”أما تعلَمُ ما هاتانِ؟“ فقُلتُ: ”لا يا سيِّدي“. <verse eid="ZEC 4:13" /><verse number="14" style="v" pubnumber="14" sid="ZEC 4:14" />فقالَ: ”هاتانِ ترمُزانِ إلى اللَّذَينِ اَختارَهُما الرّبُّ ومسحَهُما بالزَّيتِ لِيَخدُماهُ، وهوَ ربُّ الأرضِ كُلِّها“.<verse eid="ZEC 4:14" /></para>
  <chapter eid="ZEC 4" />
  <chapter number="5" style="c" sid="ZEC 5" />
  <para style="s1">رؤيا السجل الطائر</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="ZEC 5:1" />وعُدتُ ورفعتُ عينَيَّ فرأيتُ سِجلًا طائرًا. <verse eid="ZEC 5:1" /><verse number="2" style="v" pubnumber="2" sid="ZEC 5:2" />فقالَ ليَ الملاكُ المُتكلِّمُ معي: ”ماذا تَرى؟“ فقُلتُ: ”سِجِلًا طائرًا، طُولُهُ عِشرونَ ذِراعًا وعَرضُهُ عَشْرُ أذرُعٍ“. <verse eid="ZEC 5:2" /><verse number="3" style="v" pubnumber="3" sid="ZEC 5:3" />فقالَ لي: ”في هذا السِّجلِّ كُتبتِ اللَّعنةُ الخارجةُ على وجهِ الأرضِ كُلِّها. فكُلُّ سارقٍ يُطرَحُ جانبًا على ما هوَ مكتوبٌ في صَفحةٍ مِنهُ، وكُلُّ حالفٍ زُورًا يُطرَحُ جانبًا على ما هوَ مكتوبٌ في صفحتِهِ الأخرى. <verse eid="ZEC 5:3" /><verse number="4" style="v" pubnumber="4" sid="ZEC 5:4" />أُرسِلُهُ، يقولُ الرّبُّ القديرُ، فيدخُلُ بيتَ السَّارِقِ وبيتَ الحَالفِ باَسمي زُورًا ويُقيمُ فيهِ ويُفنيهِ معَ خشَبِهِ وحجَرِهِ“.<verse eid="ZEC 5:4" /></para>
  <para style="s1">رؤيا المرأة في القفة</para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="ZEC 5:5" />وتقَدَّمَ الملاكُ المُتكلِّمُ معي وقالَ لي: ”إرفعْ عينَيكَ واَنظُرْ تِلكَ الخارجةَ نحوَنا“. <verse eid="ZEC 5:5" /><verse number="6" style="v" pubnumber="6" sid="ZEC 5:6" />فقُلتُ: ”ما هيَ؟“ فقالَ: ”تِلكَ هيَ القُفَّةُ خارجةً نحوَنا“. وقالَ: ”في هذِهِ القُفَّةِ آثامُ الأرضِ كُلِّها“. <verse eid="ZEC 5:6" /><verse number="7" style="v" pubnumber="7" sid="ZEC 5:7" />ونظرتُ فرأيتُ غِطاءً مِنَ الرَّصاصِ يُرفَعُ عَنِ القُفَّةِ واَمرأة جالسة في وسَطِها. <verse eid="ZEC 5:7" /><verse number="8" style="v" pubnumber="8" sid="ZEC 5:8" />فقالَ: ”هذِهِ هيَ الشَّرُّ“. ثُمَّ ألقاها في وسَطِ القُفَّةِ وألقى كُتلَةَ الرَّصاصِ في فَمِها. <verse eid="ZEC 5:8" /><verse number="9" style="v" pubnumber="9" sid="ZEC 5:9" />ورفعتُ عينَيَّ فرأيتُ اَمرأتَينِ تخرجانِ والرِّيحُ في أجنِحَتهما الّتي كأجنحةِ اللَّقلَقِ، فرفعَتا القُفَّةَ بَينَ الأرضِ والسَّماءِ. <verse eid="ZEC 5:9" /><verse number="10" style="v" pubnumber="10" sid="ZEC 5:10" />فقُلتُ للملاكِ المُتكلِّمِ معي: ”إلى أينَ هُما تذهبانِ بالقُفَّةِ؟“ <verse eid="ZEC 5:10" /><verse number="11" style="v" pubnumber="11" sid="ZEC 5:11" />فقالَ لي: ”لِتَبنيا لها بَيتًا في أرضِ شِنعارَ، ومتى تمَّ بِناؤُهُ تستَقِرُّ القُفَّةُ هُناكَ على قاعِدَتِها“.<verse eid="ZEC 5:11" /></para>
  <chapter eid="ZEC 5" />
  <chapter number="6" style="c" sid="ZEC 6" />
  <para style="s1">رؤيا المركبات</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="ZEC 6:1" />وعُدْتُ ورفعْتُ عينَيَّ فرأيتُ أربعَ مَركباتٍ خارجاتٍ مِنْ بَينِ جبَلينِ، والجبَلانِ جبَلا نُحاسٍ. <verse eid="ZEC 6:1" /><verse number="2" style="v" pubnumber="2" sid="ZEC 6:2" />وفي المَركبةِ الأولى أفراسٌ سُمْرٌ، وفي المَركبةِ الثَّانيةِ أفراسٌ سُودٌ، <verse eid="ZEC 6:2" /><verse number="3" style="v" pubnumber="3" sid="ZEC 6:3" />وفي المَركبةِ الثَّالثةِ أفراسٌ بِيضٌ، وفي المَركبةِ الرَّابعةِ أفراسٌ ذاتُ خُطوطٍ شُقْرٍ. <verse eid="ZEC 6:3" /><verse number="4" style="v" pubnumber="4" sid="ZEC 6:4" />فقُلتُ للملاكِ المُتكلِّمِ معي: ”ما هذِهِ يا سيِّدي؟“ <verse eid="ZEC 6:4" /><verse number="5" style="v" pubnumber="5" sid="ZEC 6:5" />فأجابني: ”هذِهِ رياحُ السَّماءِ الأربعُ وهيَ الآنَ خارجةٌ منْ أمامِ سيِّدِ الأرضِ كُلِّها“. <verse eid="ZEC 6:5" /><verse number="6" style="v" pubnumber="6" sid="ZEC 6:6" />وكانت مَركبةُ الأفراسِ الحُمْرِ خارجةً إلى أرضِ الشَّرقِ. ومَركبةُ الأفراسِ السُّودِ إلى أرضِ الشَّمالِ، ومَركبةُ الأفراسِ البِيضِ إلى أرضِ الغَربِ، ومَركبةُ الأفراسِ المُخطَّطَةِ إلى أرضِ الجَنوبِ، <verse eid="ZEC 6:6" /><verse number="7" style="v" pubnumber="7" sid="ZEC 6:7" />والقويَّةُ مِنها خَرَجتْ وطلَبتِ الذَّهابَ لتجولَ في الأرضِ، فقالَ لها الملاكُ: ”إِذهبي وجُولي في الأرضِ“. فذهبت وجالت في الأرضِ. <verse eid="ZEC 6:7" /><verse number="8" style="v" pubnumber="8" sid="ZEC 6:8" />فناداني الملاكُ وقال لي: ”أُنظرْ. تِلكَ الّتي تخرُجُ إلى أرضِ الشَّمالِ تجعَلُ روحي تُقيمُ في أرضِ الشَّمالِ“.<verse eid="ZEC 6:8" /></para>
  <para style="s1">الإكليل التذكاري</para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="ZEC 6:9" />وكانت كَلِمةُ الرّبِّ إليَّ، قالَ: <verse eid="ZEC 6:9" /><verse number="10" style="v" pubnumber="10" sid="ZEC 6:10" />”خُذْ ما قدَّمَهُ حَلْدايُ وطُوبيَّا ويَدَعْيا مِنْ أهلِ السَّبْي الّذينَ رَجعوا مِنْ بابلَ، واَذهبْ في اليومِ ذاتِهِ إلى بَيتِ يوشيَّا بنِ صفَنْيا. <verse eid="ZEC 6:10" /><verse number="11" style="v" pubnumber="11" sid="ZEC 6:11" />خُذْ مِنهُمُ الفِضَّةَ والذَّهبَ واَصنعْ إكليلًا واَجعلْهُ على رأسِ يَشوعَ بنِ يوصادقَ الكاهنِ العظيمِ، <verse eid="ZEC 6:11" /><verse number="12" style="v" pubnumber="12" sid="ZEC 6:12" />وقُلْ لَه: ”هذا ما قالَ الرّبُّ القديرُ: ذلِكَ الرَّجلُ الّذي اَسمُهُ الغُصْنُ سيَطلَعُ مِنْ تَحتُ ويبني هَيكلَ الرّبِّ. <verse eid="ZEC 6:12" /><verse number="13" style="v" pubnumber="13" sid="ZEC 6:13" />هوَ يَبني هَيكلَ الرّبِّ، وهوَ يَحمِلُ الجلالَ ويَجلِسُ سيِّدًا على كُرسيِّهِ ويكونُ كاهنًا على كرسيِّهِ، وعَهدُ سلامٍ يكونُ بَينَهُما. <verse eid="ZEC 6:13" /><verse number="14" style="v" pubnumber="14" sid="ZEC 6:14" />والإكليلُ يكونُ لِحَلْدايَ وطوبيَّا ويَدَعْيا وحينَ بنِ صفَنْيا تَذْكارًا في هَيكلِ الرّبِّ“.<verse eid="ZEC 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="ZEC 6:15" />ويجيءُ البعيدونَ ويعمَلونَ في بِناءِ هَيكلِ الرّبِّ، فتعلَمونَ أنَّ الرّبَّ القديرَ أرسلَني إليكُم، وسيتِمُّ ذلِكَ إنْ كُنتُم تسمعونَ صوتَ الرّبِّ إلهِكُم كُلَّ السَّماعِ.<verse eid="ZEC 6:15" /></para>
  <chapter eid="ZEC 6" />
  <chapter number="7" style="c" sid="ZEC 7" />
  <para style="s1">مسألة الصوم</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="ZEC 7:1" />وفي السَّنةِ الرَّابعةِ لداريّوسَ المَلِكِ، كانت كلِمةُ الرّبِّ إلى زكريَّا في الرَّابعِ مِنَ الشَّهرِ التَّاسعِ الّذي هوَ كَسلو. <verse eid="ZEC 7:1" /><verse number="2" style="v" pubnumber="2" sid="ZEC 7:2" />وكانَ أهلُ بَيتِ إيلَ أرسَلوا شرَاصِرَ ورجَمَّلَكَ ورِجالَهُ لِيُصَلُّوا أمامَ وجهِ الرّبِّ، <verse eid="ZEC 7:2" /><verse number="3" style="v" pubnumber="3" sid="ZEC 7:3" />وليَسألوا الأنبياءَ والكهنَةَ الّذينَ في بَيتِ الرّبِّ القديرِ، ”هل نبكي على خَرابِ الهَيكلِ في الشَّهرِ الخامسِ، كما نَذرْنا أنْ نفعَلَ مِنْ سنينَ كَثيرةٍ؟“ <verse eid="ZEC 7:3" /><verse number="4" style="v" pubnumber="4" sid="ZEC 7:4" />فكانت إليَّ كلِمةُ الرّبِّ القديرِ قالَ: <verse eid="ZEC 7:4" /><verse number="5" style="v" pubnumber="5" sid="ZEC 7:5" />”قُلْ لجميعِ الشَّعبِ والكهنَةِ: حينَ كُنتُم تَصومونَ وتَنوحونَ في الشَّهر الخامسِ والسَّابعِ في تِلكَ السَّبعينَ سنَةً، هل كانَ صيامُكُم لي أنا؟ <verse eid="ZEC 7:5" /><verse number="6" style="v" pubnumber="6" sid="ZEC 7:6" />وحينَ كُنتُم تأكُلونَ وتشرَبونَ، أمَا كُنتُم تأكلونَ لَكم وتَشرَبونَ لكُم؟“</para>
  <para style="p" vid="ZEC 7:6">ذلِكَ ما نادى بهِ الرّبُّ على ألسنةِ الأنبياءِ الأوَّلينَ، <verse eid="ZEC 7:6" /><verse number="7" style="v" pubnumber="7" sid="ZEC 7:7" />حينَ كانَت أُورُشليمُ آهِلَةً آمِنةً، هيَ ومُدُنُها مِنْ حَولِها، وكانَ النَّاسُ يَسكُنونَ جَنوبَها وسَهلَها.<verse eid="ZEC 7:7" /></para>
  <para style="s1">التمرّد بسبب السبي</para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="ZEC 7:8" />وكانت كلِمةُ الرّبِّ إلى زكريَّا، قالَ: <verse eid="ZEC 7:8" /><verse number="9" style="v" pubnumber="9" sid="ZEC 7:9" />”هذا ما قالَ الرّبُّ القديرُ: أُحكُموا بالعَدلِ واَصنَعوا الرَّأفةَ والمَراحِمَ، بَعضُكُم إلى بَعضٍ. <verse eid="ZEC 7:9" /><verse number="10" style="v" pubnumber="10" sid="ZEC 7:10" />لا تَظلموا الأرمَلَةَ واليَتيمَ والغريبَ والمِسكينَ، ولا يُفكِّرْ واحدُكُم على الآخَرِ بالشَّرِّ“. <verse eid="ZEC 7:10" /><verse number="11" style="v" pubnumber="11" sid="ZEC 7:11" />لكنَّهُم رفَضوا أنْ يُصغوا، وأداروا أكتافَهُم عِنادًا، وسَدُّوا آذانَهُم لِئلَّا يسمعوا، <verse eid="ZEC 7:11" /><verse number="12" style="v" pubnumber="12" sid="ZEC 7:12" />بل جعَلوا قُلوبَهُم كحجَرِ المَاسِ لِئلَّا يسمعوا الشَّريعةَ والكلامَ الّذي أرسلَهُ الرّبُّ القديرُ بِرُوحِهِ على ألسِنَةِ الأنبياءِ الأوَّلينَ، فكانَ غضَبٌ عظيمٌ مِنَ الرّبِّ القديرِ.<verse eid="ZEC 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="ZEC 7:13" />فكما نادَيتُ فما سَمِعوا، كذلِكَ نادَوا هُم فما سَمِعْتُ، <verse eid="ZEC 7:13" /><verse number="14" style="v" pubnumber="14" sid="ZEC 7:14" />بل بَعثرْتُهُم كالزَّوبعةِ في كُلِّ أمَّةٍ لم يَعرِفوها، فأقفرتِ الأرضُ مِنْ بَعدِهِم، لا عابرٌ فيها ولا عائدٌ، وجعَلوا الأرضَ الجَيِّدةَ قَفْرًا“.<verse eid="ZEC 7:14" /></para>
  <chapter eid="ZEC 7" />
  <chapter number="8" style="c" sid="ZEC 8" />
  <para style="s1">وعد الرّبّ بالخلاص</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="ZEC 8:1" />وَكانَت كلِمةُ الرّبِّ القديرِ إلى زَكريَّا، قالَ: <verse eid="ZEC 8:1" /><verse number="2" style="v" pubnumber="2" sid="ZEC 8:2" />”هذا ما قالَ الرّبُّ القديرُ: غِرتُ على صِهيَونَ غَيرةً عظيمةً، وبِغَضَبٍ عظيمٍ غِرْتُ علَيها.<verse eid="ZEC 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="ZEC 8:3" />”وهذا ما قالَ الرّبُّ: سأرجِعُ إلى صِهيَونَ وأسكُنُ في وسَطِ أُورُشليمَ، فتُدعَى أُورُشليمُ مدينةَ الحَقِّ ويُدعَى جبَلُ الرّبِّ القديرِ الجبَلَ المُقدَّسَ.<verse eid="ZEC 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="ZEC 8:4" />”وهذا ما قالَ الرّبُّ القديرُ: يعودُ الشُّيوخُ والعَجائِزُ يَجلِسونَ في ساحاتِ أُورُشليمَ، كُلُّ واحدٍ بيدِهِ عَصاهُ مِنْ كَثرَةِ أيّامِهِ، <verse eid="ZEC 8:4" /><verse number="5" style="v" pubnumber="5" sid="ZEC 8:5" />وتَمتَلئُ أرجاءُ المدينةِ بَنينَ وبَناتٍ يلعبُونَ في رِحابِها.<verse eid="ZEC 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="ZEC 8:6" />”وهذا ما قالَ الرّبُّ القديرُ: إنْ كانَ ذلِكَ عَجيبًا في عُيونِ بَقيَّةِ هذا الشَّعبِ في تِلكَ الأيّامِ، يكونُ عَجيبًا في عينَيَّ أنا أيضًا، يقولُ الرّبُّ القديرُ.<verse eid="ZEC 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="ZEC 8:7" />”وهذا ما قالَ الرّبُّ القديرُ: سأُخَلِّصُ شعبي مِنْ أرضِ المَشرِقِ ومِنْ أرضِ مَغرِبِ الشَّمسِ، <verse eid="ZEC 8:7" /><verse number="8" style="v" pubnumber="8" sid="ZEC 8:8" />وأجِيءُ بِهِم فيسكُنونَ في وسَطِ أُورُشليمَ، ويكونونَ لي شعبًا، وأكونُ لهُم إلهًا بالحَقِّ والصِّدْقِ.<verse eid="ZEC 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="ZEC 8:9" />”وهذا ما قالَ الرّبُّ القديرُ: لِتتَشَدَّدْ أيدِيكُم في هذِهِ الأيّامِ حينَ تسمعونَ هذا الكلامَ الّذي فاهَ بهِ الأنبياءُ يومَ وُضِعَ الأساسُ لبِناءِ بَيتِ الرّبِّ القديرِ. <verse eid="ZEC 8:9" /><verse number="10" style="v" pubnumber="10" sid="ZEC 8:10" />فقبلَ ذلِكَ اليومِ لا البشَرُ ولا البَهائِمُ تَقاضَوا أُجرةً، ولا كانَ لِمَنْ خرَجَ أو دخلَ سلامٌ مِنَ الضَّرَرِ، لأنِّي أثَرتُ كُلَّ واحدٍ على الآخَرِ. <verse eid="ZEC 8:10" /><verse number="11" style="v" pubnumber="11" sid="ZEC 8:11" />أمَّا الآنَ فلا أُعامِلُ بقيَّةَ شعبي كما في تِلكَ الأيّامِ، يقولُ الرّبُّ القديرُ. <verse eid="ZEC 8:11" /><verse number="12" style="v" pubnumber="12" sid="ZEC 8:12" />بل يَزرعونَ زَرعَهُم بسلامٍ، فيُعطي الكَرمُ ثمرَهُ والأرضُ غلَّتَها والسَّماءُ نَداها، وأورِّثُ بقيَّةَ هذا الشَّعبِ جميعَ هذِهِ الخَيراتِ. <verse eid="ZEC 8:12" /><verse number="13" style="v" pubnumber="13" sid="ZEC 8:13" />ويكونُ أنَّكُم، كما كُنتُم لعنةً في الأُمَمِ يا بَيتَ يَهوذا ويا بَيتَ إِسرائيلَ، كذلِكَ تكونونَ بَركةً حينَ أُخلِّصُكُم. فلا تخافوا ولتتشدَّدْ أيديكُم. <verse eid="ZEC 8:13" /><verse number="14" style="v" pubnumber="14" sid="ZEC 8:14" />وكما نَوَيتُ غَيرَ نادمٍ أنْ أُسيءَ إليكُم حينَ أغاظَني آباؤُكُم، يقولُ ربُّ الجُنودِ، <verse eid="ZEC 8:14" /><verse number="15" style="v" pubnumber="15" sid="ZEC 8:15" />فكذلِكَ عُدْتُ فنوَيتُ في هذِهِ الأيّامِ أنْ أُحسِنَ إلى أُورُشليمَ وبَيتِ يَهوذا، فلا تخافوا. <verse eid="ZEC 8:15" /><verse number="16" style="v" pubnumber="16" sid="ZEC 8:16" />وهذِهِ هيَ الأمورُ الّتي يجبُ علَيكُم أنْ تعمَلوها: كلِّموا بَعضُكُم بَعضًا بالحَقِّ، واَقْضُوا في مَحاكِمِكُم بالعَدلِ لِيَحِلَّ السَّلامُ، <verse eid="ZEC 8:16" /><verse number="17" style="v" pubnumber="17" sid="ZEC 8:17" />ولا تفكِّروا شَرًّا في قُلوبِكُم، الواحدُ على الآخَرِ، ولا تُحِبُّوا يَمينَ الزُّورِ. فهذِهِ جميعًا أكرَهُها، يقولُ الرّبُّ“.<verse eid="ZEC 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="ZEC 8:18" />وكانت إليَّ كَلِمةُ الرّبِّ القديرِ. قالَ: <verse eid="ZEC 8:18" /><verse number="19" style="v" pubnumber="19" sid="ZEC 8:19" />”هذا ما قالَ الرّبُّ القديرُ: صَومُ الشَّهرِ الرَّابعِ والخامسِ والسَّابعِ والعاشرِ سيكونُ لبيتِ يَهوذا سُرورًا وفَرحًا وأعيادًا طَيِّبةً. فأحبُّوا الحَقَّ والسَّلامَ“.<verse eid="ZEC 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="ZEC 8:20" />”وهذا ما قالَ الرّبُّ القديرُ: سيأتي شُعوبٌ أيضًا وسُكَّانُ مُدُنٍ كثيرةٍ، <verse eid="ZEC 8:20" /><verse number="21" style="v" pubnumber="21" sid="ZEC 8:21" />ويسيرُ سُكَّانُ المدينةِ الواحدةِ إلى الأخرى ويقولونَ لهُم: نحنُ ذاهبونَ في الحالِ لاَستعطافِ الرّبِّ القديرِ واَلتماسِ وجهِهِ، فتعالَوا معَنا. <verse eid="ZEC 8:21" /><verse number="22" style="v" pubnumber="22" sid="ZEC 8:22" />فيأتي شُعوبٌ كثيرونَ وأمَمٌ أقوياءُ لاَستعطافِ الرّبِّ القديرِ في أُورُشليمَ واَلتماسِ وجهِهِ.<verse eid="ZEC 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="ZEC 8:23" />”وهذا ما قالَ الرّبُّ القديرُ: في تِلكَ الأيّامِ يُمسِكُ عشَرَةُ رجالٍ مِنْ جميعِ الأمَمِ، على اَختلافِ ألسنتِها، بطَرَفِ ثوبِ رَجُلٍ واحدٍ مِنْ يَهوذا ويقولونَ لَه: ”نذهبُ مَعكُم، فنحنُ سَمِعنا أنَّ اللهَ مَعكُم“.<verse eid="ZEC 8:23" /></para>
  <chapter eid="ZEC 8" />
  <chapter number="9" style="c" sid="ZEC 9" />
  <para style="s1">الحكم على الشعوب المجاورة</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="ZEC 9:1" />كلامٌ مُوحًى مِنَ الرّبِّ إلى النَّبيِّ في أرضِ حَدْراخَ ودِمشقَ مَوضِعِ إقامتِهِ، لأنَّ لِلرّبِّ كُلَّ البشَرِ كما لَه كُلُّ أسباطِ إسرائيلَ. <verse eid="ZEC 9:1" /><verse number="2" style="v" pubnumber="2" sid="ZEC 9:2" />ولَه حماةُ الّتي تُتاخِمُ تِلكَ الأرضَ وصُورُ وصَيدونُ بكُلِّ مَناعتِها.<verse eid="ZEC 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="ZEC 9:3" />بَنتْ صُورُ حِصنًا لها وكنَزَتِ الفِضَّةَ كالتُّرابِ، والذَّهبَ كوحلِ الشَّوارِعِ. <verse eid="ZEC 9:3" /><verse number="4" style="v" pubnumber="4" sid="ZEC 9:4" />ها السَّيِّدُ يَمتلِكُها ويَضرِبُ في البحرِ قُدرَتَها فتُؤكَلُ بالنَّارِ. <verse eid="ZEC 9:4" /><verse number="5" style="v" pubnumber="5" sid="ZEC 9:5" />تَرى ذلِكَ أشقَلونُ فتَخافُ، وغزَّةُ فتنحلُّ عزيمتُها، وعقرونُ فتَخزى مِنْ ضَعفِها. ويَبيدُ المُلكُ مِنْ غزَّةَ، وأشقَلونُ لا تُسكنُ، <verse eid="ZEC 9:5" /><verse number="6" style="v" pubnumber="6" sid="ZEC 9:6" />ويَسكُنُ الغُرَباءُ في أشدودَ. وأقضي على كبرياءِ الفلِسطيِّين، يقولُ الرّبُّ، <verse eid="ZEC 9:6" /><verse number="7" style="v" pubnumber="7" sid="ZEC 9:7" />وأُزِيلُ دَمَ الذَّبائحِ مِنْ أفواهِهِم، ولَحمَها الرَّجِسَ مِنْ بَينِ أسنانِهِم. فتبقى مِنهُم بقيَّةٌ لإلهِنا، ويألَفونَ السَّكنَ في يَهوذا، ويكونُ أهلُ عَقرونَ هؤلاءِ كما كانَ اليبوسيُّونَ. <verse eid="ZEC 9:7" /><verse number="8" style="v" pubnumber="8" sid="ZEC 9:8" />وأَنزِلُ في بَيتي وأحرسُهُ مِنَ العابرِ والمُقيمِ، يقولُ الرّبُّ، فلا يَمرُّ على شعبي طاغيةٌ بَعدَ أنْ رأيتُ الآنَ بعينَيَّ ما قاسُوهُ مِنَ الآلامِ.<verse eid="ZEC 9:8" /></para>
  <para style="s1">الملك العتيد</para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="ZEC 9:9" />إِبْتَهِجي يا بنتَ صِهيَونَ، واَهتفي يا بِنتَ أُورُشليمَ ها مَلِكُكِ يأتيكِ عادلًا مُخلِّصًا وديعًا راكبًا على حمارٍ، على جَحشٍ اَبنِ أتانٍ. <verse eid="ZEC 9:9" /><verse number="10" style="v" pubnumber="10" sid="ZEC 9:10" />سأقضي على مَركباتِ الحربِ في أفرايمَ، والخيلِ وأقواسِ القِتالِ في أورُشليمَ، فيَتكلَّمُ مَلِكُكِ بالسَّلامِ للأُمَمِ ويكونُ سُلطانُهُ مِنَ البحرِ إلى البحرِ ومِنَ النَّهرِ إلى أقاصي الأرض.<verse eid="ZEC 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="ZEC 9:11" />ولأجلِ عَهدي المَختومِ بدَمِ الضَّحايا أُطلِقُ أسرَاكِ مِنَ البِئرِ الّتي لا ماءَ فيها، <verse eid="ZEC 9:11" /><verse number="12" style="v" pubnumber="12" sid="ZEC 9:12" />فأقولُ لهُم: إِرجِعوا إلى الحُصنِ أيُّها الأسرَى الّذينَ لهُم رجاءٌ. اليومَ أُخبركُم أنِّي أُبارِكُكُم وأعوِّضُكُم منْ آلامِكُم ضِعفَينِ، <verse eid="ZEC 9:12" /><verse number="13" style="v" pubnumber="13" sid="ZEC 9:13" />فأنا سأَحني يَهوذا قَوسًا لي وأجعَلُ أفرايمَ سِهامًا لها، وأُثيرُ بنيكِ يا صِهيَونُ على بني يونانَ وأُشهِرُكِ كسَيفِ الجبَّارِ. <verse eid="ZEC 9:13" /><verse number="14" style="v" pubnumber="14" sid="ZEC 9:14" />ثُمَّ يَظهرُ الرّبُّ علَيهم وسَهمُهُ يخرُجُ كالبَرقِ، والسَّيِّدُ الرّبُّ يَنفخُ في البُوقِ وينطلِقُ في زوابعِ الجَنوبِ. <verse eid="ZEC 9:14" /><verse number="15" style="v" pubnumber="15" sid="ZEC 9:15" />الرّبُّ القديرُ يُحامي عَنهُم، فيرُوزونَ حجارةَ المِقلاعِ ويتناولونَها بمِلءِ أكُفِّهِم ويشربونَ دِماءَ أعدائِهِم كالخمرِ، ويَمتلئونَ بها كَقِصاعِ المذبَحِ وزواياهُ.<verse eid="ZEC 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="ZEC 9:16" />في ذلِكَ اليومِ يُخَلِّصُ الرّبُّ الإلهُ شعبَهُ كما يُخلِّصُ الرَّاعي غنَمَهُ، فيُقيمونَ في أرضِهِ كالحجارةِ الفريدةِ. <verse eid="ZEC 9:16" /><verse number="17" style="v" pubnumber="17" sid="ZEC 9:17" />فما أطيبَها وما أوفاها تكونُ لهُم. بِحِنطتِها ينمو الفِتيانُ وبِخمرِها العَذارَى.<verse eid="ZEC 9:17" /></para>
  <chapter eid="ZEC 9" />
  <chapter number="10" style="c" sid="ZEC 10" />
  <para style="s1">وعد الله بالخلاص</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="ZEC 10:1" />أُطلبُوا مِنَ الرّبِّ المطَرَ في أوَّلِ الرَّبيعِ، فالرّبُّ هوَ الّذي يُرسِلُ البرُوقَ والمطَرَ الغزيرَ، ويُعطي الخُبزَ لكُلِّ إنسانٍ والعُشْبَ للبَهائِمِ. <verse eid="ZEC 10:1" /><verse number="2" style="v" pubnumber="2" sid="ZEC 10:2" />أمَّا الأوثانُ فعاقِبَتُها الإثْمُ، والعَرافةُ رؤًى كاذبةٌ، والأحلامُ حديثُ سُوءٍ، فباطلًا يكونُ العَزاءُ. لذلِكَ تفرَّقَ الشَّعبُ وعانَوا كغنَمٍ لا راعيَ لها. <verse eid="ZEC 10:2" /><verse number="3" style="v" pubnumber="3" sid="ZEC 10:3" />وكانَ أنِ اَشتدَّ غضَبُ الرّبِّ على الرُّعاةِ والقادةِ، فعاقبَهُم لأنَّ الرّبَّ القديرَ يهتمُّ بقَطيعِهِ بَيت يَهوذا، وسيَجعلُهُ فرسَهُ الكريمةَ في القِتالِ. <verse eid="ZEC 10:3" /><verse number="4" style="v" pubnumber="4" sid="ZEC 10:4" />فمِنهُ يخرُجُ حجَرُ الزَّاويةِ وَوَتدُ الخَيمةِ وقَوسُ القِتالِ، ومِنهُ يخرُجُ كلُّ حاكمٍ. <verse eid="ZEC 10:4" /><verse number="5" style="v" pubnumber="5" sid="ZEC 10:5" />ويكونونَ مَعًا كالجبابرةِ، يَدوسونَ العَدوَّ كالوَحْلِ في الأزقَّةِ، ويُقاتِلونَ فُرسانَهُم فيَخزَونَ.<verse eid="ZEC 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="ZEC 10:6" />سأُقوِّي بَيتَ يَهوذا، وأُخلِّصُ بَيتَ يوسفَ. أُعيدُهُم إليَّ لأنِّي رحَمتُهُم. فأنا الرّبُّ إلهُهُم أُعينُهُم وكأنِّي ما خذَلتُهُم. <verse eid="ZEC 10:6" /><verse number="7" style="v" pubnumber="7" sid="ZEC 10:7" />ويكونُ بَنو أفرايمَ كالجبابرةِ، وتفرحُ قلوبُهُم كما مِنَ الخمرِ. يَراهُم بَنوهُم ويَفرَحُونَ. وتبتهِجُ قلوبُهُم بالرّبِّ.<verse eid="ZEC 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="ZEC 10:8" />أُومِئُ إليهِم وأجمَعُهُم لأنِّي اَفْتَديتُهُم، فيَكثُرونَ كما كَثُروا. <verse eid="ZEC 10:8" /><verse number="9" style="v" pubnumber="9" sid="ZEC 10:9" />أزرَعُهُم بَينَ الشُّعوبِ، فيَذكرونَني في الأقاصي ويَحيَونَ معَ بَنيهِم ويرجِعونَ. <verse eid="ZEC 10:9" /><verse number="10" style="v" pubnumber="10" sid="ZEC 10:10" />أُعيدُهُهم مِنْ أرضِ مِصْرَ، وأجمَعُهُم مِنْ أشُّورَ، وأجيءُ بِهِم إلى أرضِ جَلعادَ ولبنانَ فلا يتَّسعُ لهُم مكانٌ. <verse eid="ZEC 10:10" /><verse number="11" style="v" pubnumber="11" sid="ZEC 10:11" />يَعبُرونَ بحرَ مِصْرَ، فيَضرِبُ الرّبُّ أمواجَ البحرِ ويُجَفِّفُ أعماقَ النَّهرِ. تَنخَفِضُ لهُم كبرياءُ أشُّورَ ويَزولُ صولجانُ مِصْرَ. <verse eid="ZEC 10:11" /><verse number="12" style="v" pubnumber="12" sid="ZEC 10:12" />أجعَلُهُم أقوياءَ بالرّبِّ، وباَسْمِهِ يَسلكونَ. هكذا قالَ الرّبُّ.<verse eid="ZEC 10:12" /></para>
  <chapter eid="ZEC 10" />
  <chapter number="11" style="c" sid="ZEC 11" />
  <para style="s1">سقوط الطغاة</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="ZEC 11:1" />إفتَحْ يا لبنانُ أبوابَكَ،</para>
  <para style="p" vid="ZEC 11:1">فتأكُلَ النِّيرانُ أرزَكَ.<verse eid="ZEC 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="ZEC 11:2" />وَلوِلْ أيُّها السَّروُ</para>
  <para style="p" vid="ZEC 11:2">على سُقوطِ أرزِ لبنانَ،</para>
  <para style="p" vid="ZEC 11:2">ودَمارِ أشجارِه العظيمةِ.</para>
  <para style="p" vid="ZEC 11:2">وَلوِلْ يا بَلُّوطَ باشانَ</para>
  <para style="p" vid="ZEC 11:2">على تكَسُّرِ غاباتِهِ الوارفةِ.<verse eid="ZEC 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="ZEC 11:3" />ها صوتُ ولولَةِ الرُّعاةِ</para>
  <para style="p" vid="ZEC 11:3">على خَرابِ مراعيهِم!</para>
  <para style="p" vid="ZEC 11:3">ها صوتُ زَئيرِ الأشبالِ</para>
  <para style="p" vid="ZEC 11:3">على دَمارِ أعالي الأردُنِّ.<verse eid="ZEC 11:3" /></para>
  <para style="s1">الرعاة</para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="ZEC 11:4" />هذا ما قالَ الرّبُّ إلهي: ”إرْعَ الغنَمَ المُهيَّأةَ لِلذَّبحِ. <verse eid="ZEC 11:4" /><verse number="5" style="v" pubnumber="5" sid="ZEC 11:5" />يَذبَحُها مالِكُوها ولا يُعاقبُونَ، كُلُّ مَنْ يَبيعُها يقولُ: تبارَكَ الرّبُّ! صِرْتُ غنيًّا. حتّى رُعاتُها لا يُشفِقونَ علَيها. <verse eid="ZEC 11:5" /><verse number="6" style="v" pubnumber="6" sid="ZEC 11:6" />أنا لا أُشفِقُ بَعدَ اليومِ على سُكَّانِ الأرضِ، بل سأُسَلِّمُ البشَرَ إلى أيدي مُلوكِهِم ورُعاتِهِم، فيُخربونَ الأرضَ ولا أُنقِذُ أحدًا مِنْ أيديهِم“. هكذا قالَ الرّبُّ.<verse eid="ZEC 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="ZEC 11:7" />فرَعَيتُ الغنَمَ المُهيَّأةَ للذَّبحِ، ورعَيتُها لِتُجَّارِ الغنَمِ وأخَذتُ لي عصَوَينِ، فسَمَّيتُ الواحدةَ نِعمةَ، وسَمَّيتُ الأُخرى صِلَةَ، ورعَيتُ الغنَمَ. <verse eid="ZEC 11:7" /><verse number="8" style="v" pubnumber="8" sid="ZEC 11:8" />وفي شهرٍ واحدٍ أزلْتُ الرُّعاةَ الثَّلاثةَ، لأنَّ نفْسي ضاقَت بِهِم، ونُفوسُهُم أيضًا سئِمَت مِنِّي. <verse eid="ZEC 11:8" /><verse number="9" style="v" pubnumber="9" sid="ZEC 11:9" />فقُلْتُ لِلغَنَمِ: ”لا أرعاكُم. فمَنْ يمُتْ فليَمُتْ، ومَنْ يَتوارَ فليَتوارَ، والبَقيَّةُ فليَأكُلْ بَعضُها لَحمَ بَعضٍ“.<verse eid="ZEC 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="ZEC 11:10" />وأخذتُ عصاتي نِعمةَ وكسَرتُها لأنقُضَ عَهدي الّذي قطعتُهُ معَ جميعِ الشُّعوبِ. <verse eid="ZEC 11:10" /><verse number="11" style="v" pubnumber="11" sid="ZEC 11:11" />فنُقِضَ في ذلِكَ اليومِ، وهكذا علِمَ تُجَّارُ الغنَمِ الّذينَ يُراقبونَني أنَّ هذا تَدبيرٌ مِنَ الرّبِّ. <verse eid="ZEC 11:11" /><verse number="12" style="v" pubnumber="12" sid="ZEC 11:12" />فقُلتُ لهُم: ”إنْ حَسُنَ في عُيونِكُم، فهاتوا أُجرتي وإلَّا فاَمتنِعوا“. فَوَزَنوا أُجرتي ثلاثينَ مِنَ الفِضَّةِ. <verse eid="ZEC 11:12" /><verse number="13" style="v" pubnumber="13" sid="ZEC 11:13" />فقالَ ليَ الرّبُّ: ”ألقِها في الخِزانةِ، وفي بَيتِ الرّبِّ، ثَمنًا كريمًا ثَمَّنوني بهِ“. فأخذتُ الثَّلاثينَ مِنَ الفِضَّةِ وألقيتُها في الخِزانةِ، في بَيتِ الرّبِّ. <verse eid="ZEC 11:13" /><verse number="14" style="v" pubnumber="14" sid="ZEC 11:14" />وكسَرتُ عَصايَ الأخرى صِلةَ، فنقَضْتُ صِلةَ الإخاءِ بَينَ يَهوذا وإِسرائيلَ.<verse eid="ZEC 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="ZEC 11:15" />وقالَ ليَ الرّبُّ: ”عُدْ فخُذْ لكَ أدواتِ راعٍ أحمَقَ، <verse eid="ZEC 11:15" /><verse number="16" style="v" pubnumber="16" sid="ZEC 11:16" />لأنِّي سأُقيمُ راعيًا في الأرضِ لا يفتَقِدُ المَفقودَ، ولا يُفَتِّشُ عَنِ التَّائِهِ، ولا يَجبُرُ المكسُورَ، ولا يُعِينُ المُتعَبَ، بل يأكلُ لَحمَ السِّمانِ مِنَ الغنَمِ ويَنزِعُ أظلافَها.<verse eid="ZEC 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="ZEC 11:17" />وَيلٌ للرَّاعي الأرعَنِ الّذي يُهمِلُ الغنَمَ! لِيكُنِ السَّيفُ على ذِراعِهِ وعلى عَينِهِ اليُمْنى، فتَيبَسَ ذِراعُهُ يَبسًا وتكِلَّ عينُهُ كَلالًا“.<verse eid="ZEC 11:17" /></para>
  <chapter eid="ZEC 11" />
  <chapter number="12" style="c" sid="ZEC 12" />
  <para style="s1">اقتراب خلاص أورشليم</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="ZEC 12:1" />كلامٌ مُوحًى مِنَ الرّبِّ على بَني إِسرائيلَ. يقولُ الرّبُّ، باسِطُ السَّماءِ ومُؤسِّسُ الأرضِ وجابِلُ رُوحِ الإنسانِ فيهِ:<verse eid="ZEC 12:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="ZEC 12:2" />”ها أنا أجعَلُ أُورُشليمَ ويَهوذا أيضًا، في يومِ حِصارِ أُورُشليمَ عتبَةً تَنزَلِقُ علَيها جميعُ الشُّعوبِ مِنْ حَولِها. <verse eid="ZEC 12:2" /><verse number="3" style="v" pubnumber="3" sid="ZEC 12:3" />في ذلِكَ اليومِ، حينَ يجتَمِعُ على أُورُشليمَ جميعُ أُمَمِ الأرضِ، أجعَلُها حجَرًا ثقيلًا لِجميعِ الشُّعوبِ، فكُلُّ شعبٍ يَشيلُهُ يَنشَقُّ شَقًّا. <verse eid="ZEC 12:3" /><verse number="4" style="v" pubnumber="4" sid="ZEC 12:4" />وفي ذلِكَ اليومِ أضرِبُ كُلَّ فَرَسٍ بالذُّعْرِ وراكِبَهُ بالجُنونِ. وأفتَحُ عينَيَّ ساهِرًا على بَيتِ يَهوذا، وأضرِبُ جميعَ خيلِ الشُّعوبِ بالعَصَا. <verse eid="ZEC 12:4" /><verse number="5" style="v" pubnumber="5" sid="ZEC 12:5" />فيقولُ جميعُ بَيتِ يَهوذا في قلوبِهِم إنَّ لِسُكَّانِ أُورُشليمَ قوَّةً بالرّبِّ القديرِ إلهِهِم.<verse eid="ZEC 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="ZEC 12:6" />”في ذلِكَ اليومِ أجعَلُ جميعَ بَيتِ يَهوذا كمَوقِدِ نارٍ في أكوامِ الحطَبِ، وكمِشعَلِ نارٍ في أكداسِ الحِنطَةِ، فيَلتَهِمونَ عَنِ اليمينِ وعَنِ اليسارِ جميعَ الشُّعوبِ مِنْ حَولِهِم، وتَثبُتُ أُورُشليمُ بأمانٍ في مكانِها. <verse eid="ZEC 12:6" /><verse number="7" style="v" pubnumber="7" sid="ZEC 12:7" />ويُخَلِّصُ الرّبُّ سائرَ أهالي يَهوذا قَبلَ سِواهُم، لِئلَّا يُغاليَ في الافتخارِ علَيهِم بَيتُ داوُدَ وسُكَّانُ أُورُشليمَ.<verse eid="ZEC 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="ZEC 12:8" />”في ذلِكَ اليومِ يبسُطُ الرّبُّ حِمايَتَهُ على سُكَّانِ أُورُشليمَ. فيكونُ الهَزيلُ مِنهُم قويًّا كداوُدَ، ويسيرُ بَيتُ داوُدَ أمامَهُم مِثلَ ملاكِ الرّبِّ، مثلَ اللهِ نفسِهِ.<verse eid="ZEC 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="ZEC 12:9" />”في ذلِكَ اليومِ أسعى إلى دَمارِ جميعِ الأُمَمِ القادِمينَ إلى مُهاجمةِ أُورُشليمَ <verse eid="ZEC 12:9" /><verse number="10" style="v" pubnumber="10" sid="ZEC 12:10" />وأفيضُ على بَيتِ داوُدَ، وعلى سُكَّانِ أُورُشليمَ، روحَ الحنانِ والرَّحمةِ، فينظرونَ إلى الّذي طعَنوهُ ويَندُبونَه كمَنْ يَندُبُ وحيدًا لَه، ويتَفَجَّعُونَ علَيهِ كمَنْ يتَفَجَّعُ على اَبنٍ لَه بِكر.<verse eid="ZEC 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="ZEC 12:11" />”في ذلِكَ اليومِ يكونُ النُّواحُ عظيمًا كالنُّواحِ على هدَدْرِمُّونَ في سَهلِ مجَدُّونَ. <verse eid="ZEC 12:11" /><verse number="12" style="v" pubnumber="12" sid="ZEC 12:12" />وتَنوحُ الأرضُ، كُلُّ عَشيرةٍ لِنَفْسِها: عَشيرةُ بَيتِ داوُدَ ونساؤُهُم، وعَشيرةُ بَيتِ ناثانَ ونساؤُهُم. <verse eid="ZEC 12:12" /><verse number="13" style="v" pubnumber="13" sid="ZEC 12:13" />وعَشيرةُ بَيتِ لاوي ونساؤُهُم، وعَشيرةُ شِمعي ونساؤُهُم، <verse eid="ZEC 12:13" /><verse number="14" style="v" pubnumber="14" sid="ZEC 12:14" />وسائرُ العشائِرِ الباقيةِ، كُلُّ عَشيرةٍ لنفْسِها ونساؤُهُم لأنفُسِهِنَّ“.<verse eid="ZEC 12:14" /></para>
  <chapter eid="ZEC 12" />
  <chapter number="13" style="c" sid="ZEC 13" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="ZEC 13:1" />وقالَ الرّبُّ القديرُ: ”في ذلِكَ اليومِ ينفتِحُ يَنبوعٌ لتطهيرِ بَيتِ داوُدَ وسُكَّانِ أُورُشليمَ مِنَ الخطيئةِ والنَّجاسَةِ. <verse eid="ZEC 13:1" /><verse number="2" style="v" pubnumber="2" sid="ZEC 13:2" />وفي ذلِكَ اليومِ أقطعُ أسماءَ الأصنامِ عنِ الأرضِ فلا تُذكَرُ مِنْ بَعدُ، كما أُزيلُ أنبياءَها وروحَهُمُ النَّجِسةَ. <verse eid="ZEC 13:2" /><verse number="3" style="v" pubnumber="3" sid="ZEC 13:3" />فإذا تنبَّأَ أحدٌ فيما بَعدُ، يقولُ لَه أبوهُ وأُمُّهُ اللَّذانِ ولَداهُ: لن تحيا، لأنَّكَ نطَقتَ بالزُّورِ باَسمِ الرّبِّ. فيَطعَنُهُ أبوهُ وأمُّهُ حينَ يتنبَّأُ.<verse eid="ZEC 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="ZEC 13:4" />في ذلِكَ اليومِ يُخزَى الأنبياءُ، كُلُّ واحدٍ مِنْ رؤياهُ إذا تنبَّأَ ولا يلبَسونَ ثوبَ الشَّعْرِ كالأنبياءِ لِيَخدَعوا النَّاسَ، <verse eid="ZEC 13:4" /><verse number="5" style="v" pubnumber="5" sid="ZEC 13:5" />بل يقولُ واحدهُم: ”ما أنا بِنَبيٍّ. أنا رَجلٌ أفلَحُ الأرضَ لأنَّ أحدَهُم اَستَخدَمَني مُنذُ صِبايَ. <verse eid="ZEC 13:5" /><verse number="6" style="v" pubnumber="6" sid="ZEC 13:6" />فيُقالُ لَه: ما هذِهِ الجِراحُ في يدَيكَ؟ فيُجيبُهُم: هيَ جِراحٌ أُصِبتُ بها في بَيتِ أحبَّائي“.<verse eid="ZEC 13:6" /></para>
  <para style="s1">راعي غنم الرّبّ</para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="ZEC 13:7" />وقالَ الرّبُّ القديرُ: ”إِستَفِقْ أيُّها السَّيفُ على راعيَّ، وعلى رَجُلِ رِفْقَتي. إضْرِبِ الرَّاعيَ فتَتَبَدَّدَ الخِرافُ، وأنا أرفَعُ يَدي على الصِّغارِ. <verse eid="ZEC 13:7" /><verse number="8" style="v" pubnumber="8" sid="ZEC 13:8" />وينقرِضُ في كُلِّ الأرضِ ثُلثا سُكَّانِها ويَهلكونَ، والثُّلثُ يبقى فيها. <verse eid="ZEC 13:8" /><verse number="9" style="v" pubnumber="9" sid="ZEC 13:9" />فأُدخِلُ هذا الثُّلثَ في النَّار، وأصهرُهُ صَهْرَ الفِضَّةِ، وأمتحِنُهُ اَمتحانَ الذَّهبِ. هوَ يدعو باَسمي وأنا أستجيبُ لَه. أنا أقولُ: هوَ شعبي، وهوَ يقولُ: الرّبُّ إلهي“.<verse eid="ZEC 13:9" /></para>
  <chapter eid="ZEC 13" />
  <chapter number="14" style="c" sid="ZEC 14" />
  <para style="s1">أورشليم والأمم</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="ZEC 14:1" />ها يومٌ للرّبِّ يأتي، فتُقسِّمُ الأمَمُ ما غَنِموهُ مِنكِ، في وسَطِكِ، يا أُورُشليمُ. <verse eid="ZEC 14:1" /><verse number="2" style="v" pubnumber="2" sid="ZEC 14:2" />ويَجمَعُ الرّبُّ كُلَّ الأُمَمِ علَيكِ، فتُؤخَذينَ وتُنهَبُ بيوتُ شعبِكِ وتُغتَصَبُ نساؤُهُم. يَذهَبُ نِصفُهُم إلى السَّبْي ولا تَنقَرِضُ بَقيَّتهُم مِنَ المدينةِ. <verse eid="ZEC 14:2" /><verse number="3" style="v" pubnumber="3" sid="ZEC 14:3" />ويخرُجُ الرّبُّ ويُحارِبُ تِلكَ الأمَمَ كما في يومِ القِتالِ. <verse eid="ZEC 14:3" /><verse number="4" style="v" pubnumber="4" sid="ZEC 14:4" />وتقِفُ قدماهُ في ذلِكَ اليومِ على جبَلِ الزَّيتونِ، قُبالَةَ أُورُشليمَ مِنَ الشَّرقِ، فيَنْشقُّ جبَلُ الزَّيتونِ مِنَ الشَّرقِ إلى الغَربِ واديًا عظيمًا جدًّا، ويَميلُ نِصفُ الجبَلِ إلى الشَّمالِ ونِصفُهُ إلى الجَنوبِ. <verse eid="ZEC 14:4" /><verse number="5" style="v" pubnumber="5" sid="ZEC 14:5" />وتَهربونَ عَبرَ ذلِكَ الوادي الّذي يَنتهي إلى آصَلَ. تهرُبونَ كما هرَبتُم مِنَ الزِّلزالِ في أيّامِ عُزِّيَّا مَلكِ يَهوذا، ثُمَّ يأتي الرّبُّ إلهُكُم وجميعُ القِدِّيسينَ معَهُ.<verse eid="ZEC 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="ZEC 14:6" />وفي ذلِكَ اليومِ لا يكونُ نورٌ، بلْ بَرَدٌ وجليدٌ. <verse eid="ZEC 14:6" /><verse number="7" style="v" pubnumber="7" sid="ZEC 14:7" />ويكونُ يومٌ واحدٌ، لا نهارٌ لَه ولا ليلٌ، بل نورٌ عِندَ الغُروبِ. أمَّا متى يَحدُثُ ذلِكَ فعِلْمُهُ عِندَ الرّبِّ. <verse eid="ZEC 14:7" /><verse number="8" style="v" pubnumber="8" sid="ZEC 14:8" />وتخرُجُ في ذلِكَ اليومِ مياهٌ حيَّةٌ مِنْ أُورُشليمَ، نِصفُها إلى البحرِ الشَّرقي ونِصفُها إلى البحرِ الغربيِّ، وتَدومُ صَيفًا وشِتاءً. <verse eid="ZEC 14:8" /><verse number="9" style="v" pubnumber="9" sid="ZEC 14:9" />ويكونُ الرّبُّ مَلِكًا على الأرضِ كُلِّها، فيكونُ ربٌّ واحدٌ واَسمُهُ واحدٌ. <verse eid="ZEC 14:9" /><verse number="10" style="v" pubnumber="10" sid="ZEC 14:10" />وتتحوَّلُ الأرضُ إلى سَهلٍ مِنْ جَبْعَ إلى رِمُّونَ في جنوبِ أُورُشليمَ، وترتفِعُ أُورُشليمُ وتَثبتُ في مكانِها، مِنْ بابِ بنيامينَ إلى مَوضِعِ البابِ الأوَّلِ وإلى بابِ الزوايا، ومِنْ بُرجِ حَننئيلَ إلى مَعاصِرِ المَلِكِ. <verse eid="ZEC 14:10" /><verse number="11" style="v" pubnumber="11" sid="ZEC 14:11" />وتُسْكَنُ أُورُشليمُ وتَثبتُ بأمانٍ، ولا يكونُ فيها حَرامٌ مِنْ بَعدُ.<verse eid="ZEC 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="ZEC 14:12" />وهذِهِ هيَ الضَّربةُ الّتي يضرِبُ بها الرّبُّ جميعَ الشُّعوبِ الّذينَ تجنَّدوا لمُحاربةِ أُورُشليمَ: لُحومُهُم تَذوبُ وهُم واقفونَ على أرجلِهِم، وعُيونُهُم تَذوبُ في مَحاجِرِها، وألسِنَتُهُم تَذوبُ في أفواهِهِم. <verse eid="ZEC 14:12" /><verse number="13" style="v" pubnumber="13" sid="ZEC 14:13" />وفي ذلِكَ اليومِ يَنزِلُ بهِم مِنَ الرّبِّ اَضْطرابٌ شديدٌ، فيُمسِكُ الواحدُ يدَ الآخَرِ ويَشدُّ علَيها. <verse eid="ZEC 14:13" /><verse number="14" style="v" pubnumber="14" sid="ZEC 14:14" />ويَهوذا أيضًا تُحارِبُ أُورُشليمَ وتجمعُ ثروةَ جميعِ الأُمَمِ مِنْ حَولِها: الذَّهبُ والفِضَّةُ والمَلابسُ بكثرةٍ عظيمةٍ. <verse eid="ZEC 14:14" /><verse number="15" style="v" pubnumber="15" sid="ZEC 14:15" />وكذلِكَ تَنزِلُ تِلكَ الضَّربةُ بالفرَسِ والبَغلِ والجَمَلِ والحمارِ وسائِرِ البَهائِمِ الّتي في مُعَسكراتِ العَدوِّ.<verse eid="ZEC 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="ZEC 14:16" />ويَجيءُ كُلُّ الباقينَ مِنْ جميعِ الأُمَمِ الّذينَ هاجموا أُورُشليمَ ويصعَدونَ إلى أُورُشليمَ سنَةً بَعدَ سنَةٍ ليَسجدوا للمَلِكِ الرّبِّ القديرِ، وَليعَيِّدوا عيدَ المَظالِّ <verse eid="ZEC 14:16" /><verse number="17" style="v" pubnumber="17" sid="ZEC 14:17" />أمَّا جميعُ الّذينَ لا يصعَدونَ مِنْ أُمَمِ الأرضِ إلى أُورُشليمَ ليَسجُدوا للمَلِكِ الرّبِّ القديرِ، فلا يَنزِلُ علَيهِم مطَرٌ. <verse eid="ZEC 14:17" /><verse number="18" style="v" pubnumber="18" sid="ZEC 14:18" />وأمَّةُ مِصْرَ، إنْ كانت لا تصعَدُ ولا تأتي، تنالُها الضَّربةُ الّتي يضرِبُ بها الرّبُّ الأمَمَ الّذينَ لا يصعَدونَ ليُعَيِّدوا عيدَ المَظالِّ.<verse eid="ZEC 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="ZEC 14:19" />هذا عِقابُ مِصْرَ وجميعِ الأُمَمِ الّذينَ خَطِئوا ولم يَصعَدوا ليُعيِّدوا عيدَ المظالِّ.<verse eid="ZEC 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="ZEC 14:20" />في ذلِكَ اليومِ يُكتَبُ على أجراسِ الخيلِ: ”قُدسٌ للرّبِّ“، وتكونُ القُدورُ في بَيتِ الرّبِّ طاهرةً كالقِصاعِ أمامَ المذبَحِ. <verse eid="ZEC 14:20" /><verse number="21" style="v" pubnumber="21" sid="ZEC 14:21" />بل كلُّ قِدْرٍ في أُورُشليمَ وفي يَهوذا تكونُ قُدسًا للرّبِّ القديرِ، وجميعُ الذَّابحينَ يأتونَ ويأخذونَ مِنها ويطبُخونَ فيها، ولا يكونُ بَعدُ تجَّارٌ في بَيتِ الرّبِّ القديرِ في ذلِكَ اليومِ.<verse eid="ZEC 14:21" /></para>
  <chapter eid="ZEC 14" />
</usx>