  <para style="toc2">قضاة</para>
  <para style="mt1">القضاة</para>
  <chapter number="1" style="c" sid="JDG 1" />
  <para style="s1">بنو إسرائيل في كنعان</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JDG 1:1" />وبَعدَ وفاةِ يشوعَ سألَ بَنو إِسرائيلَ الرّبَّ: ”مَن مِنَّا يصعَدُ أوَّلًا لِمُحارَبةِ الكنعانيِّينَ؟“ <verse eid="JDG 1:1" /><verse number="2" style="v" pubnumber="2" sid="JDG 1:2" />فأجابَهُمُ الرّبُّ: ”بَنو يَهوذا يصعَدونَ أوَّلًا لأنِّي إلى يَدِهِم أسلَمتُ الأرضَ“. <verse eid="JDG 1:2" /><verse number="3" style="v" pubnumber="3" sid="JDG 1:3" />فقالَ بَنو يَهوذا لِبَني شمعونَ إخوتِهِم: ”إصعَدوا معَنا إلى الأرضِ الّتي سَلَّمَها الرّبُّ إلى أيدينا لِنُحاربَ الكنعانيِّينَ، ونحنُ نصعَدُ معكُم أيضًا إلى الأرضِ الّتي سَلَّمَها الرّبُّ إلى أيديكُم“. فذهبَ بَنو شِمعونَ معَهُم. <verse eid="JDG 1:3" /><verse number="4" style="v" pubnumber="4" sid="JDG 1:4" />وحينَ صَعِدَ بَنو يَهوذا، دفَعَ الرّبُّ الكنعانيِّينَ والفِرِزِّيِّينَ إلى أيديهِم، فقَتَلوا مِنْهم في بازَقَ عشَرَةَ آلافِ رَجُلٍ. <verse eid="JDG 1:4" /><verse number="5" style="v" pubnumber="5" sid="JDG 1:5" />وفي بازَقَ صادَفوا أدوني بازَقَ فحارَبوهُ وهزَموا الكنعانيِّينَ والفِرزِّيِّينَ، <verse eid="JDG 1:5" /><verse number="6" style="v" pubnumber="6" sid="JDG 1:6" />فهربَ أدوني بازَقُ، فلَحِقوا بهِ وقبَضوا علَيهِ وقطَعوا أباهِمَ يَديهِ ورِجليهِ <verse eid="JDG 1:6" /><verse number="7" style="v" pubnumber="7" sid="JDG 1:7" />فقالَ أدوني بازَقُ: ”إنَّ سبعينَ مَلِكًا قطَعتُ لهُم أباهمَ أيديهِم وأرجُلِهِم كانوا يَلتَقِطونَ فُتاتَ الطَّعامِ تَحتَ مائدَتي. فكما فعَلتُ عاقبني اللهُ“. فأتوا بهِ إلى أورُشليمَ، فماتَ هُناكَ.<verse eid="JDG 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="JDG 1:8" />وهاجَمَ بَنو يَهوذا أورُشليمَ فاَحتَلُّوها بِحَدِّ السَّيفِ وأحرَقوها بالنَّارِ. <verse eid="JDG 1:8" /><verse number="9" style="v" pubnumber="9" sid="JDG 1:9" />وبَعدَ ذلِكَ حارَبوا المُقيمينَ بالجبَلِ والجَنوبِ والسَّهلِ. <verse eid="JDG 1:9" /><verse number="10" style="v" pubnumber="10" sid="JDG 1:10" />ثمَّ هجَموا على الكنعانيِّينَ المُقيمينَ بِحبرونَ وكانَ اَسمُها قبلًا قريةَ أربَعَ وهزَموا عشائرَ شيشايَ وأخيمانَ وتَلمايَ. <verse eid="JDG 1:10" /><verse number="11" style="v" pubnumber="11" sid="JDG 1:11" />وزحَفوا مِنْ هُناكَ على سُكَّانِ دَبيرَ وكانَ اَسمُها قَبلًا قريةَ سفَرٍ. <verse eid="JDG 1:11" /><verse number="12" style="v" pubnumber="12" sid="JDG 1:12" />فقالَ كالَبُ: ”مَنْ هاجَمَ قريةَ سفَرٍ واَحتَلَّها أُعطيهِ عكسةَ اَبْنَتي زوجَةً“. <verse eid="JDG 1:12" /><verse number="13" style="v" pubnumber="13" sid="JDG 1:13" />فاَحْتَلَّها عُثنيئيلُ بنُ قَنازَ أخو كالَبَ الأصغرُ فأعطاهُ عكسةَ اَبنَتَهُ زوجَةً. <verse eid="JDG 1:13" /><verse number="14" style="v" pubnumber="14" sid="JDG 1:14" />وبَينَما كانَت آتيةً معَهُ حَضَّها على طلَبِ حقلٍ مِنْ أبيها، فنَزَلَت عَنِ الحِمارِ، فقالَ لها كالَبُ أبوها: ”ما لَكِ؟“ <verse eid="JDG 1:14" /><verse number="15" style="v" pubnumber="15" sid="JDG 1:15" />فأجابَتهُ: ”هَبْني بَركَةً. أعطَيتَني أرضًا جَنوبيةً، فأعطِني ينابيعَ ماءٍ“. فأعطاها الينابيعَ العُليا والينابيعَ السُّفلى.<verse eid="JDG 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="JDG 1:16" />وصَعِدَ القَينيُّونَ، أبناءُ حَمي موسى، مِنْ مدينةِ النَّخلِ أريحا معَ بَني يَهوذا إلى برِّيَّةِ يَهوذا الّتي في جَنوبي عَرادَ، وهُناكَ سكَنوا معَ بَني عَماليقَ. <verse eid="JDG 1:16" /><verse number="17" style="v" pubnumber="17" sid="JDG 1:17" />وذهبَ بَنو يَهوذا معَ بَني شِمعونَ إخوتِهِم، فهاجَموا الكنعانيِّينَ المُقيمينَ في صَفاةَ وأبادوها وسَمَّوها حُرمَةَ. <verse eid="JDG 1:17" /><verse number="18" style="v" pubnumber="18" sid="JDG 1:18" />واَفْتتَحَ بَنو يَهوذا غَزَّةَ وأشقَلونَ وعَقرونَ والأراضيَ المُحيطةَ بِها. <verse eid="JDG 1:18" /><verse number="19" style="v" pubnumber="19" sid="JDG 1:19" />وكانَ الرّبُّ معَ بَني يَهوذا فطَرَدوا سُكَّانَ الجبَلِ واَمْتَلكوهُ. أمَّا سُكَّانُ الوادي فلم يقدِروا أنْ يَطرُدوهُم لأنَّهُ كانَت لهُم مَركباتٌ مِنْ حديدٍ. <verse eid="JDG 1:19" /><verse number="20" style="v" pubnumber="20" sid="JDG 1:20" />وأعطَوا لِكالَبَ حبرونَ كما أوصى موسى، فطَرَدَ مِنها بَني عَناقَ الثَّلاثَةَ. <verse eid="JDG 1:20" /><verse number="21" style="v" pubnumber="21" sid="JDG 1:21" />أمَّا اليَبوسيُّونَ المُقيمونَ في أورُشليمَ فلم يَطرُدْهُم بَنو بنيامينَ، فأقاموا معَ بَني بنيامينَ في أورُشليمَ إلى هذا اليومِ.<verse eid="JDG 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="JDG 1:22" />وصَعِدَ بَنو يوسفَ أيضًا إلى بيتَ إيلَ، وكانَ الرّبُّ معَهُم، <verse eid="JDG 1:22" /><verse number="23" style="v" pubnumber="23" sid="JDG 1:23" />واَسْتَطلَعوا تلكَ المدينةَ وكانَ اَسمُها قَبلًا لوزَ. <verse eid="JDG 1:23" /><verse number="24" style="v" pubnumber="24" sid="JDG 1:24" />فرَأوا رَجُلًا خارِجًا مِنها، فقالوا لَه: ”دُلَّنا على مدخلِ المدينةِ فَنُحسِنَ إليكَ“. <verse eid="JDG 1:24" /><verse number="25" style="v" pubnumber="25" sid="JDG 1:25" />فدَلَّهُم علَيهِ فهاجَموها واَحتَلُّوها بِحَدِّ السَّيفِ. وأمَّا الرَّجُلُ فأطلَقوهُ هوَ وعَشيرَتُهُ. <verse eid="JDG 1:25" /><verse number="26" style="v" pubnumber="26" sid="JDG 1:26" />فذهبَ إلى أرضِ الحِثِّيِّينَ وبَنى مدينةً سَمَّاها لُوزَ، وهوَ اَسْمُها إلى هذا اليومِ.<verse eid="JDG 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="JDG 1:27" />ولم يقدِر بَنو منَسَّى أنْ يَطرُدوا أهلَ بيتَ شانَ وتَوابِعِها، وأهلَ تَعنَكَ وتَوابِعِها، ودورَ وتَوابِعِها، ويِبلَعامَ وتَوابِعِها، ومَجِدُّو وتَوابِعِها، فعزَمَ الكنعانيُّونَ على أنْ يَستَقِرُّوا في تلكَ الأرضِ. <verse eid="JDG 1:27" /><verse number="28" style="v" pubnumber="28" sid="JDG 1:28" />ولمَّا قويَ بَنو إِسرائيلَ فرَضوا على الكنعانيِّينَ أعمالَ السُّخرَةِ ولم يَطرُدوهُم. <verse eid="JDG 1:28" /><verse number="29" style="v" pubnumber="29" sid="JDG 1:29" />ولم يقدِرْ بَنو أفرايِمَ أنْ يَطرُدوا الكنعانيِّينَ المُقيمينَ بِجازَرَ. فبَقيَ الكنعانيُّونَ فيما بَينهُم في جازَرَ. <verse eid="JDG 1:29" /><verse number="30" style="v" pubnumber="30" sid="JDG 1:30" />ولم يقدرْ بَنو زَبولونَ أنْ يَطردوا سُكَّانَ قِطرونَ ونَهلولَ، فبَقيَ الكنعانيُّونَ فيما بَينَهُم يُؤدُّونَ لهُم أعمالَ السُّخرَةِ. <verse eid="JDG 1:30" /><verse number="31" style="v" pubnumber="31" sid="JDG 1:31" />ولم يقدِرْ بَنو أشيرَ أنْ يَطردوا أهلَ عكَّا وصيدونَ وأحلَبَ وأكزيبَ وحَلبَةَ وأفيقَ ورَحوبَ، <verse eid="JDG 1:31" /><verse number="32" style="v" pubnumber="32" sid="JDG 1:32" />فأقامَ بَنو أشيرَ بَينَ الكنعانيِّينَ أهلِ الأرضِ لأنَّهُم لم يَطرُدوهُم مِنها. <verse eid="JDG 1:32" /><verse number="33" style="v" pubnumber="33" sid="JDG 1:33" />ولم يقدِرْ بَنو نَفتالي أنْ يَطردوا أهلَ بيتَ شَمسَ وبَيتَ عَناتَ، ولِهذا أقاموا بَينَ الكنعانيِّينَ أهلِ الأرضِ، وكانَ سُكَّانُ بيتَ شمسَ وبَيتَ عَناتَ يُؤدُّونَ لهُم أعمالَ السُّخرَةِ. <verse eid="JDG 1:33" /><verse number="34" style="v" pubnumber="34" sid="JDG 1:34" />وحاصَرَ الأموريُّونَ بَني دانَ في الجبَلِ ولم يَدَعوهُم يَنزِلونَ إلى الوادي. <verse eid="JDG 1:34" /><verse number="35" style="v" pubnumber="35" sid="JDG 1:35" />وعزَمَ الأموريُّونَ على الإقامةِ بِجبَلِ حارَسَ في أيَّلونَ وفي شَعَلبيمَ. واَشتَدَّ ساعِدُ بَني يوسُفَ ففَرَضوا علَيهِم أعمالَ السُّخرَةِ. <verse eid="JDG 1:35" /><verse number="36" style="v" pubnumber="36" sid="JDG 1:36" />وكانَت حُدودُ الأموريِّينَ مِنْ عقبة عَقْرَبِّيمَ حتّى شَمالِ سالَعَ.<verse eid="JDG 1:36" /></para>
  <chapter eid="JDG 1" />
  <chapter number="2" style="c" sid="JDG 2" />
  <para style="s1">الرب يلوم شعبه</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JDG 2:1" />وصَعِدَ ملاكُ الرّبِّ مِنَ الجِلجالِ إلى بوكيمَ وقالَ لِبَني إِسرائيلَ: ”أخرَجتُكُم مِنْ مِصْرَ وأدخَلتُكُمُ الأرضَ الّتي أقسَمْتُ علَيها لآبائِكُم، وقُلتُ إنِّي لا أنقُضُ عَهدي معَكُم إلى الأبدِ <verse eid="JDG 2:1" /><verse number="2" style="v" pubnumber="2" sid="JDG 2:2" />شَرطَ أنْ لا تُعاهِدوا أهلَ هذِهِ الأرضِ وأنْ تَهدِموا مذابِحَهُم، فما سَمِعتُم لِقولي. فماذا فعَلتُم؟ <verse eid="JDG 2:2" /><verse number="3" style="v" pubnumber="3" sid="JDG 2:3" />لِذلِكَ قُلتُ أيضًا إنِّي لا أطرُدُهُم مِنْ أمامِكُم، بل يكونونَ شَوكةً في خَواصِرِكُم وتكونُ آلِهَتُهُم لكُم فَخًّا“. <verse eid="JDG 2:3" /><verse number="4" style="v" pubnumber="4" sid="JDG 2:4" />فلمَّا قالَ ملاكُ الرّبِّ لجميعِ بَني إِسرائيلَ هذا الكلامَ رفَعَ الشَّعبُ أصواتَهُم بالبُكاءِ، <verse eid="JDG 2:4" /><verse number="5" style="v" pubnumber="5" sid="JDG 2:5" />ودَعَوا ذلِكَ المَوضِعَ بوكيمَ، وهُناكَ قدَّموا الذَّبائحَ للرّبِّ.<verse eid="JDG 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="JDG 2:6" />وصرَفَ يَشوعُ بَني إِسرائيلَ، فذهبَ كُلُّ واحدٍ مِنهُم إلى ميراثِهِ لِيَتَملَّكوا الأرضَ. <verse eid="JDG 2:6" /><verse number="7" style="v" pubnumber="7" sid="JDG 2:7" />وعبَدَ الشَّعبُ الرّبَّ كلَّ أيّامِ يَشوعَ وكُلَّ أيّامِ الشُّيوخِ الّذينَ اَمْتَدَّت حياتُهُم إلى ما بَعدَ يَشوعَ وشاهَدوا كُلَّ أعمالِ الرّبِّ العظيمةَ الّتي عَمِلَها لهُم. <verse eid="JDG 2:7" /><verse number="8" style="v" pubnumber="8" sid="JDG 2:8" />وماتَ يَشوعُ بنُ نُونٍ عبدُ الرّبِّ وهوَ اَبنُ مئَةٍ وعَشْرِ سِنينَ <verse eid="JDG 2:8" /><verse number="9" style="v" pubnumber="9" sid="JDG 2:9" />ودُفِنَ في أرضِهِ، في تِمنَةَ حارَسَ بِجبَلِ أفرايِمَ إلى شمالِ جبَلِ جاعَشَ. <verse eid="JDG 2:9" /><verse number="10" style="v" pubnumber="10" sid="JDG 2:10" />وكُلُّ الّذينَ جايَلوا يَشوعَ ماتوا أيضًا واَنضمُّوا إلى آبائِهِم، ونشأَ مِنْ بَعدِهِم جيلٌ آخَرُ لا يَعرِفُ الرّبَّ ولا ما عَمِل لِبَني إِسرائيلَ.<verse eid="JDG 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JDG 2:11" />ففعَلَ بَنو إِسرائيلَ الشَّرَّ في عَينيِ الرّبِّ وعبدوا البَعلَ. <verse eid="JDG 2:11" /><verse number="12" style="v" pubnumber="12" sid="JDG 2:12" />وتَركوا الرّبَّ إلهَ آبائِهِمِ الّذي أخرَجَهُم مِنْ أرضِ مِصْرَ وتَبِعوا آلِهةً أُخرى مِنْ آلِهةِ الشُّعوبِ الّذينَ حَولَهُم، وسَجَدوا لها وأغاظوا الرّبَّ. <verse eid="JDG 2:12" /><verse number="13" style="v" pubnumber="13" sid="JDG 2:13" />تَركوهُ وعبدوا البَعلَ وعَشتاروتَ. <verse eid="JDG 2:13" /><verse number="14" style="v" pubnumber="14" sid="JDG 2:14" />فغَضِبَ الرّبُّ على بَني إِسرائيلَ، فسَلَّمَهُم إلى أيدي الناهِبينَ فنَهَبوهُم، وباعَهُم إلى أعدائِهِمِ الّذينَ حَولَهُم ولم يقدِروا بَعدَ ذلِكَ أنْ يَثبُتوا أمامَهُم. <verse eid="JDG 2:14" /><verse number="15" style="v" pubnumber="15" sid="JDG 2:15" />فكانوا حَيثُما خرجوا لِلحربِ تكونُ يدُ الرّبِّ علَيهِم لِشَرِّهِم، كما قالَ لهُمُ الرّبُّ وأقسَمَ، فتَضايَقوا جِدًّا.<verse eid="JDG 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="JDG 2:16" />فأقامَ الرّبُّ علَيهِم قُضاةً فخَلَّصوهُم مِنْ أيدي الناهِبينَ. <verse eid="JDG 2:16" /><verse number="17" style="v" pubnumber="17" sid="JDG 2:17" />ولِقُضاتِهِم أيضًا لم يَسمَعوا، فخانُوا الرّبَّ باَتِّباعِ آلِهةٍ أُخرى وسَجَدوا لها وحادوا سريعًا عَنِ الطَّريقِ الّتي سَلكَها آباؤُهُم على طاعةِ وصايا الرّبِّ، ولم يعمَلوا مِثلَهُم. <verse eid="JDG 2:17" /><verse number="18" style="v" pubnumber="18" sid="JDG 2:18" />فلمَّا أقامَ الرّبُّ علَيهِم قُضاةً كانَ الرّبُّ معَ القاضي، الّذي كانَ يُخَلِّصُهم مِنْ أيدي أعدائِهِم طُولَ أيّامِهِ، لأنَّ الرّبَّ أشفَقَ على أنينِهِم مِنْ ظالِميهِم ومُضطَهِديهِم. <verse eid="JDG 2:18" /><verse number="19" style="v" pubnumber="19" sid="JDG 2:19" />وإذا ماتَ القاضي كانوا يَرجِعونَ إلى الفَسادِ أكثَرَ مِنْ آبائِهِم، باَتِّباعِ آلِهةٍ أُخرى يَعبُدونَها ويَسجُدونَ لها. لم يَحيدوا عَنْ سُوءِ أعمالِهِم وسُلوكِهِمِ الرديءِ. <verse eid="JDG 2:19" /><verse number="20" style="v" pubnumber="20" sid="JDG 2:20" />فاَشتَدَّ غضَبُ الرّبِّ علَيهِم وقالَ: ”بِما أنَّ هذا الشَّعبَ خالَفَ عَهدي الّذي أمَرتُ بهِ آباءَهُم وما سَمِعوا لِصوتي، <verse eid="JDG 2:20" /><verse number="21" style="v" pubnumber="21" sid="JDG 2:21" />فأنا أيضًا لن أطرُدَ مِنْ أمامِهِم أحدًا مِنَ الأُمَمِ الّتي ترَكَها يَشوعُ عِندَ وفاتِهِ، <verse eid="JDG 2:21" /><verse number="22" style="v" pubnumber="22" sid="JDG 2:22" />لأرى إذا كانَ بَنو إِسرائيلَ يحفَظونَ طريقَ الرّبِّ ويسلكونَها كآبائِهِم أم لا“. <verse eid="JDG 2:22" /><verse number="23" style="v" pubnumber="23" sid="JDG 2:23" />فترَكَ الرّبُّ تِلكَ الأُمَمَ ولم يطرُدْها سريعًا ولم يُسَلِّمْها إلى يَدِ يَشوعَ.<verse eid="JDG 2:23" /></para>
  <chapter eid="JDG 2" />
  <chapter number="3" style="c" sid="JDG 3" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JDG 3:1" />وترَكَ الرّبُّ بعضَ الأُمَمِ لِيَمتحِنَ بِهِم مِنْ بَني إِسرائيلَ جميعَ الّذينَ لم يَعرِفوا الحربَ في أرضِ كنْعانَ. <verse eid="JDG 3:1" /><verse number="2" style="v" pubnumber="2" sid="JDG 3:2" />وفعَلَ ذلِكَ لِيُعَلِّمَ أجيالَ بَني إِسرائيلَ الحربَ، وخُصوصًا الّذينَ لم يَعرِفوها مِنْ قَبلُ. <verse eid="JDG 3:2" /><verse number="3" style="v" pubnumber="3" sid="JDG 3:3" />وهؤلاءِ الأُمَمُ هُم: خَمسُ مُدُنِ الفلِسطيِّينَ وجميعُ الكنعانيِّينَ والصَّيدونيِّين والحِوِّيِّينَ المُقيمينَ في جبَلِ لبنانَ، مِنْ جبَلِ بَعلِ حرمونَ إلى ليبو حَماةَ. <verse eid="JDG 3:3" /><verse number="4" style="v" pubnumber="4" sid="JDG 3:4" />وهؤلاءِ تَركهُمُ الرّبُّ لِيَمتحِنَ بِهِم بَني إِسرائيلَ ويرى إنْ كانوا يَستَمعونَ لِوَصاياهُ الّتي أوصى بِها آباءَهُم على لِسانِ موسى. <verse eid="JDG 3:4" /><verse number="5" style="v" pubnumber="5" sid="JDG 3:5" />فأقامَ بَنو إِسرائيلَ بَينَ الكنعانيِّينَ والحِثِّيِّينَ والأموريِّينَ والفِرْزِّيِّينَ والحِوِّيِّينَ واليَبوسيِّينَ <verse eid="JDG 3:5" /><verse number="6" style="v" pubnumber="6" sid="JDG 3:6" />واَتْخَذوا بَناتِهِم زَوجاتٍ لهُم وأعطَوا بَناتِهِم لِبَنيهِم وعبدوا آلِهَتَهُم.<verse eid="JDG 3:6" /></para>
  <para style="s1">القضاة: عثنيئيل وإهود وشمجر</para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="JDG 3:7" />وفعَلَ بَنو إِسرائيلَ الشَّرَّ في عينَي الرّبِّ ونسَوا الرّبَّ إلهَهُم وعبدوا البَعلَ وعَشتاروتَ. <verse eid="JDG 3:7" /><verse number="8" style="v" pubnumber="8" sid="JDG 3:8" />فاَشتَدَّ غضَبُ الرّبِّ علَيهِم وباعَهُم إلى كوشانَ رِشَعتايِمَ مَلكِ أدومَ فاَستعبَدَهُم ثمانيَ سِنينَ. <verse eid="JDG 3:8" /><verse number="9" style="v" pubnumber="9" sid="JDG 3:9" />فصرَخوا إلى الرّبِّ، فأقامَ لهُم مُخَلِّصًا فخَلَّصَهُم، وهوَ عُثنيئيلُ بنُ قَنازَ أخو كالَبَ الأصغرُ. <verse eid="JDG 3:9" /><verse number="10" style="v" pubnumber="10" sid="JDG 3:10" />وحَلَّ روحُ الرّبِّ علَيهِ، فتَولَّى القضاءَ لِبَني إِسرائيلَ وخرَجَ لِلحربِ فسَلَّمَ الرّبُّ إلى يَدِهِ كوشانَ رِشَعتايِمَ مَلِكَ أدومَ وتغلَّب علَيهِ. <verse eid="JDG 3:10" /><verse number="11" style="v" pubnumber="11" sid="JDG 3:11" />واَستَراحتِ الأرضُ مِنَ الحروبِ أربَعينَ سنَةً، ثُمَّ تُوفِّيَ عُثينئيلُ بنُ قَنازَ.<verse eid="JDG 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="JDG 3:12" />فعادَ بَنو إِسرائيلَ إلى عمَلِ الشَّرِّ في عينَي الرّبِّ، فقَوَّى الرّبُّ علَيهِم عِجْلونَ مَلِكَ مُوآبَ، <verse eid="JDG 3:12" /><verse number="13" style="v" pubnumber="13" sid="JDG 3:13" />فحَشَدَ لِمُحارَبَتِهِم بَني عَمُّونَ وعَماليقَ وحارَبوهُم واَحْتَلوا أريحا مدينةَ النَّخْلِ. <verse eid="JDG 3:13" /><verse number="14" style="v" pubnumber="14" sid="JDG 3:14" />فاَستعبَدَهُم عِجلونُ مَلكُ موآبَ ثمانيَ عشْرَةَ سنَةً.<verse eid="JDG 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="JDG 3:15" />فصَرَخَ بَنو إِسرائيلَ إلى الرّبِّ فأقامَ لهُم مُخَلِّصًا وهوَ إهودُ بنُ جيرا البنيامينيُّ، وكانَ رَجُلًا أعسَرَ، فأرسَلَ بَنو إِسرائيلَ معَهُ هديَّةً إلى عِجلونَ مَلِكِ موآبَ. <verse eid="JDG 3:15" /><verse number="16" style="v" pubnumber="16" sid="JDG 3:16" />فصَنَعَ إهودُ لِنَفسِه سيفًا ذا حَدَّينِ، طُولُهُ ذِراعٌ وتقَلَّدَه تَحتَ ثيابِهِ على جَنبِه الأيمَنِ، <verse eid="JDG 3:16" /><verse number="17" style="v" pubnumber="17" sid="JDG 3:17" />وقدَّمَ الهديَّةَ إلى عِجلونَ مَلِكِ موآبَ، وكانَ عِجلونُ رَجُلًا سَمينًا جِدًّا. <verse eid="JDG 3:17" /><verse number="18" style="v" pubnumber="18" sid="JDG 3:18" />وبَعدَ أنْ قدَّمَ إهودُ الهديَّةَ رافَقَ جماعَتَهُ حامِلي الهديَّةِ قليلًا، <verse eid="JDG 3:18" /><verse number="19" style="v" pubnumber="19" sid="JDG 3:19" />ثُمَّ رجَعَ وحدَهُ مِنْ عِندِ المَنحوتاتِ الّتي عِندَ الجِلجالِ وقالَ لِلمَلِكِ: ”لي كلامُ سِرٍّ إليكَ أيُّها المَلِكُ“. فطَلَب المَلِكُ مِمَّنْ حولَهُ أنْ يَخرُجوا فخرَجوا. <verse eid="JDG 3:19" /><verse number="20" style="v" pubnumber="20" sid="JDG 3:20" />فتَقدَّمَ إليهِ إهودُ وكانَ المَلِكُ جالِسًا في غُرفةٍ صيفيَّةٍ لَه وحدَهُ وقالَ لَه: ”لي كلامٌ إليكَ مِنْ عِندِ اللهِ“. فنهَضَ عِجلونُ عَنْ سريرِهِ. <verse eid="JDG 3:20" /><verse number="21" style="v" pubnumber="21" sid="JDG 3:21" />فمَدَّ إهودُ يدَهُ اليُسرى واَستلَّ السَّيفَ عَنْ جَنبِه الأيمَنِ وطعَنَهُ في بَطنِهِ، <verse eid="JDG 3:21" /><verse number="22" style="v" pubnumber="22" sid="JDG 3:22" />فغاصَت قَبضَةُ السَّيفِ معَ النَّصْلِ وأطبَقَ الشَّحمُ وراءَ النَّصْلِ لأنَّهُ لم يَنزِعِ السَّيفَ مِنْ بَطنِهِ، وخرَجَت أمعاؤُهُ. <verse eid="JDG 3:22" /><verse number="23" style="v" pubnumber="23" sid="JDG 3:23" />وخرَجَ إهودُ إلى الرِّواقِ وأغلَقَ أبوابَ الغُرفةِ وراءَه، وأقفَلَها.<verse eid="JDG 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="JDG 3:24" />فلَّما خرَجَ إهودُ جاءَ عبيدُ المَلِكِ فرأوا أبوابَ الغُرفةِ مُقفَلَةً، فقالوا: ”لعلَّ المَلِكَ يقضي حاجةً في مَخدَعِهِ الصَّيفي“. <verse eid="JDG 3:24" /><verse number="25" style="v" pubnumber="25" sid="JDG 3:25" />فاَنتَظَروا حتّى قَلِقوا لأنَّهُ لم يفتحْ أبوابَ الغُرفةِ، فأخَذوا المفاتيحَ وفتَحوا الأبوابَ فإذا بِمَولاهُم صَريعٌ على الأرضِ مَيتٌ. <verse eid="JDG 3:25" /><verse number="26" style="v" pubnumber="26" sid="JDG 3:26" />وبينَما هُم في حَيرَتِهِم هربَ إهودُ ومَرَّ خَلْفَ المَنحوتاتِ ولجأَ إلى سَعيرةَ. <verse eid="JDG 3:26" /><verse number="27" style="v" pubnumber="27" sid="JDG 3:27" />وعِندَ وُصولِهِ نفَخَ في البوقِ، في جبَلِ أفرايِمَ، فنَزَل بَنو إِسرائيلَ معَهُ مِنَ الجبَلِ وهوَ يتَقدَّمُهُم <verse eid="JDG 3:27" /><verse number="28" style="v" pubnumber="28" sid="JDG 3:28" />فقالَ لهُم: ”إتْبَعوني، لأنَّ الرّبَّ دفَعَ أعداءَكُمُ المُوآبيِّينَ إلى أيديكُم“. فنَزَلوا وراءَهُ واَستَولَوا على معابِرِ الأُردُنِّ إلى موآبَ ولَم يَدَعوا أحدًا يَعبُرُ. <verse eid="JDG 3:28" /><verse number="29" style="v" pubnumber="29" sid="JDG 3:29" />فقَتَلوا مِنَ الموآبيِّينَ في ذلِكَ الوقتِ نحوَ عشَرَةِ آلافِ رَجُلٍ مِنَ الأبطالِ الأشِدَّاءِ ولم يَفلتْ مِنهُم أحدٌ. <verse eid="JDG 3:29" /><verse number="30" style="v" pubnumber="30" sid="JDG 3:30" />فخضَعَ المُوآبيُّونَ لِبَني إِسرائيلَ في ذلِكَ اليومِ واَستَراحتِ الأرضُ مِنَ الحروبِ ثمانينَ سنَةً.<verse eid="JDG 3:30" /></para>
  <para style="p">
    <verse number="31" style="v" pubnumber="31" sid="JDG 3:31" />وبَعدَ إهودَ قامَ شَمجَرُ بنُ عَناتَ، فقتَلَ مِنَ الفلِسطيِّينَ ستَّ مئةِ رَجُلٍ بِمِنساسِ البقَرِ، وخلَّصَ هوَ أيضًا بَني إِسرائيلَ.<verse eid="JDG 3:31" /></para>
  <chapter eid="JDG 3" />
  <chapter number="4" style="c" sid="JDG 4" />
  <para style="s1">دبورة وباراق</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JDG 4:1" />وعادَ بَنو إِسرائيلَ فعَمِلوا الشَّرَّ في عينَي الرّبِّ بَعدَ موتِ إهودَ، <verse eid="JDG 4:1" /><verse number="2" style="v" pubnumber="2" sid="JDG 4:2" />فرَماهُمُ الرّبُّ في يَدِ يابينَ مَلِكِ كنعانَ في حاصورَ. وكانَ قائِدُ جيشِهِ سِيسَرا، وهوَ مُقيمٌ بحَروشةِ هاجويمَ. <verse eid="JDG 4:2" /><verse number="3" style="v" pubnumber="3" sid="JDG 4:3" />فصَرَخَ بَنو إِسرائيلَ إلى الرّبِّ لأنَّ يابينَ المَلِكَ كانَت لَه تِسعُ مئةِ مَركبةٍ مِنْ حديدٍ، فضَيَّقَ علَيهِم عِشرينَ سنَةً بِشِدَّةٍ.<verse eid="JDG 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="JDG 4:4" />وكانَت دَبورَةُ النَّبيَّةُ، زَوجةً لِفيدوتَ قاضيةً على بَني إِسرائيلَ في ذلِكَ الزَّمانِ. <verse eid="JDG 4:4" /><verse number="5" style="v" pubnumber="5" sid="JDG 4:5" />وكانَت تجلِسُ تَحتَ نَخلَةِ دَبورَةَ بَينَ الرَّامةِ وبَيتَ إيلَ في جبَلِ أفرايِمَ، وكانَ بَنو إِسرائيلَ يَصعَدونَ إليها لِتَقضيَ لهُم. <verse eid="JDG 4:5" /><verse number="6" style="v" pubnumber="6" sid="JDG 4:6" />فدَعت باراقَ بنَ أبينوعَمَ مِنْ قادِشِ نَفتالي وقالَت لَه: ”الرّبُّ إلهُ إِسرائيلَ أمرَكَ، فاَذهَبْ إلى جبَلِ تابورَ وخُذْ معَكَ عشَرَةَ آلافِ رَجُلٍ مِنْ بَني نَفتالي ومِنْ بَني زَبولونَ، <verse eid="JDG 4:6" /><verse number="7" style="v" pubnumber="7" sid="JDG 4:7" />فآتيَ إليكَ بسِيسَرا قائِدِ جيشِ يابينَ ومَركباتِه وجُندِهِ إلى نهرِ قَيشونَ وأُسَلِّمَهُ إلى يَدِكَ“. <verse eid="JDG 4:7" /><verse number="8" style="v" pubnumber="8" sid="JDG 4:8" />فقالَ لها باراقُ: ”إذا ذهَبتِ معي ذهَبتُ، وإلَّا فلا“. <verse eid="JDG 4:8" /><verse number="9" style="v" pubnumber="9" sid="JDG 4:9" />فقالَت لَه: ”أذهَبُ معَكَ، لكِنْ لن يكونَ لَكَ فخرٌ في هذِهِ المهمَّةِ، لأنَّ الرّبَّ يرمي سِيسَرا في يَدِ اَمرَأةٍ“. وقامَت دَبورَةُ فذهَبَت معَهُ إلى قادِشَ. <verse eid="JDG 4:9" /><verse number="10" style="v" pubnumber="10" sid="JDG 4:10" />وجمعَ باراقُ مِنْ بَني زَبولونَ وبَني نَفتالي عشَرَةَ آلافِ رَجُلٍ وقادَهُم إلى قادِشَ بِصُحبةِ دَبورَةَ.<verse eid="JDG 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JDG 4:11" />واَنفَرَدَ حابِرُ القَينيُّ مِنْ بَني حوبابَ، حَميُّ موسى، عَنْ القَينيِّينَ ونصَبَ خَيمَتهُ إلى جانبِ شجَرةِ بَلُّوطٍ في صَعْننيمَ الّتي عِندَ قادِشَ. <verse eid="JDG 4:11" /><verse number="12" style="v" pubnumber="12" sid="JDG 4:12" />فأُخبِرَ سِيسَرا أنَّ باراقَ بنَ أبينوعمَ صَعِدَ إلى جبَلِ تابورَ، <verse eid="JDG 4:12" /><verse number="13" style="v" pubnumber="13" sid="JDG 4:13" />فحشدَ سِيسَرا جميعَ مَركباتِهِ وهيَ تِسعُ مئةِ مَركبةٍ مِنْ حديدٍ ودَعا جميعَ الشَّعبِ الّذينَ عِندَه مِنْ حَروشةِ هاجويمَ إلى نهرِ قَيشونَ. <verse eid="JDG 4:13" /><verse number="14" style="v" pubnumber="14" sid="JDG 4:14" />فقالَت دَبورَةُ لِباراقَ: ”قُمْ، لأنَّ الرّبَّ يَدفعُ سِيسَرا اليومَ إلى يَدِكَ، وها هوَ الرّبُّ يتَقَدَّمُكَ“. فنَزَلَ باراقُ مِنْ جبَلِ تابورَ ووَراءَهُ عشَرَةُ آلافِ رَجُلٍ. <verse eid="JDG 4:14" /><verse number="15" style="v" pubnumber="15" sid="JDG 4:15" />وألقى الرّبُّ رُعبًا على سِيسَرا وجميعِ مَركباتِهِ، وقُتِلَ جميعُ عسكرِهِ بِحَدِّ السَّيفِ أمامَ باراقَ. فنزلَ سِيسَرا مِنْ مَركبتِهِ وهربَ على قَدَميهِ. <verse eid="JDG 4:15" /><verse number="16" style="v" pubnumber="16" sid="JDG 4:16" />فتَبِعَ باراقُ وعسكرَهُ إلى حَروشةِ هاجويمَ، وسقَطَ كُلُّ مَنْ كانَ في عسكرِهِ بِحَدِّ السَّيفِ ولم يَبقَ مِنهُم أحدٌ.<verse eid="JDG 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="JDG 4:17" />وهربَ سِيسَرا على قدَميهِ ودخَلَ خَيمةَ ياعيلَ زَوجةِ حابِرَ القَينيِّ، لأنَّهُ كانَ سِلْمٌ بَينَ يابينَ مَلِكِ حاصورَ وبَيتِ حابِرَ القَينيِّ. <verse eid="JDG 4:17" /><verse number="18" style="v" pubnumber="18" sid="JDG 4:18" />فخَرجَت ياعيلُ لاَستِقبالِ سِيسَرا وقالَت لَه: ”تفَضَّلْ، يا سيِّدي، تفَضَّلْ ولا تَخَفْ“. فدخلَ خَيمَتَها، فغَطَّتْهُ بِبِساطٍ. <verse eid="JDG 4:18" /><verse number="19" style="v" pubnumber="19" sid="JDG 4:19" />فقالَ لها: ”إسقيني قليلًا مِنْ ماءٍ فأنا عطشانُ“. ففَتَحَت وِعاءَ اللَّبَنِ وسَقَتهُ ثُمَّ غَطَّتهُ. <verse eid="JDG 4:19" /><verse number="20" style="v" pubnumber="20" sid="JDG 4:20" />فقالَ لها: ”قِفي على بابِ الخَيمَةِ، فإنْ جاءَكِ أحدٌ وسألَكِ: أهُنا أحدٌ؟ أجيبي: لا“. <verse eid="JDG 4:20" /><verse number="21" style="v" pubnumber="21" sid="JDG 4:21" />وفيما هوَ نائِمٌ مُستَرخٍ أخذَت ياعيلُ وتَدَ الخَيمةِ وأمسَكتِ المِطرَقةَ بِيدِها واَقتربَت مِنهُ بِهُدوءٍ وضربَتِ الوتَدَ في صَدْغِهِ حتّى غرَزَ في الأرضِ، فماتَ. <verse eid="JDG 4:21" /><verse number="22" style="v" pubnumber="22" sid="JDG 4:22" />وإذا بِباراقَ مُقبِلٌ يَبحَثُ عَنْ سِيسَرا، فخرَجَت ياعيلُ لاَستِقبالِهِ وقالَت لَه: ”تَعالَ، هُنا الرَّجُلُ الّذي تَطلُبُهُ“. فدخلَ، فإذا بسِيسَرا ساقِطٌ مَيتًا والوَتَدُ في صَدْغِهِ.<verse eid="JDG 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="JDG 4:23" />وأذَلَّ اللهُ في ذلِكَ اليومِ يابينَ مَلِكَ كنعانَ أمامَ بَني إِسرائيلَ. <verse eid="JDG 4:23" /><verse number="24" style="v" pubnumber="24" sid="JDG 4:24" />وأخَذَ بَنو إِسرائيلَ يَزدادونَ قُوَّةً. وثَقُلَت أيديهِم على يابينَ حتّى أبادوه.<verse eid="JDG 4:24" /></para>
  <chapter eid="JDG 4" />
  <chapter number="5" style="c" sid="JDG 5" />
  <para style="s1">نشيد دبورة</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JDG 5:1" />فأنشَدَت دَبورَةُ وباراقُ بنُ أبينوعَمَ:<verse eid="JDG 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="JDG 5:2" />بارِكوا الرّبَّ، لأنَّ بَني إِسرائيلَ قاتَلوا</para>
  <para style="p" vid="JDG 5:2">وبِشجاعةٍ ضَحَّى الشَّعبُ.<verse eid="JDG 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="JDG 5:3" />إستَمِعوا أيُّها المُلوكُ، وأصغوا أيُّها العُظَماءُ!</para>
  <para style="p" vid="JDG 5:3">أنا، أنا للرّبِّ أرنِّمُ،</para>
  <para style="p" vid="JDG 5:3">للرّبِّ إلهِ إِسرائيلَ أُرتِّلُ.<verse eid="JDG 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="JDG 5:4" />حينَ خَرجْتَ يا ربُّ مِنْ سَعيرَ،</para>
  <para style="p" vid="JDG 5:4">ومِنْ صحراءِ أدومَ حينَ صَعِدْتَ</para>
  <para style="p" vid="JDG 5:4">رجَفَتِ الأرضُ وأمطَرَتِ السَّماءُ</para>
  <para style="p" vid="JDG 5:4">ومِنَ الغَيمِ تدَفَّقَتِ المياهُ.<verse eid="JDG 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="JDG 5:5" />تَزَلزَلَتِ الجِبالُ مِنْ وجهِ الرّبِّ،</para>
  <para style="p" vid="JDG 5:5">وسيناءُ أمامَ الرّبِّ إلهِ إِسرائيلَ.<verse eid="JDG 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="JDG 5:6" />في أيّامِ شَمجَرَ بنِ عَناتَ،</para>
  <para style="p" vid="JDG 5:6">وفي أيّامِ ياعيلَ خَطِرَةً كانَتِ المَسالِكُ<verse eid="JDG 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="JDG 5:7" />فحادَ عنها العابرونَ إلى ما هوَ أكثرُ أمْنًا.</para>
  <para style="p" vid="JDG 5:7">أقفرَتِ الأرضُ، ومِنْ بَني إِسرائيلَ خَلَت</para>
  <para style="p" vid="JDG 5:7">حتّى قُمتُ أنا دَبورَةُ،</para>
  <para style="p" vid="JDG 5:7">قُمتُ أُمًّا في إِسرائيلَ.<verse eid="JDG 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="JDG 5:8" />حينَ اَختاروا لهُم آلِهةً أُخرى</para>
  <para style="p" vid="JDG 5:8">بلَغَتِ الحربُ الأبوابَ</para>
  <para style="p" vid="JDG 5:8">هل كانَ دِرعٌ يُرَى أو رُمحٌ</para>
  <para style="p" vid="JDG 5:8">في أربعينَ ألفًا مِنْ إِسرائيلَ؟<verse eid="JDG 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="JDG 5:9" />إلى قادةِ إِسرائيلَ،</para>
  <para style="p" vid="JDG 5:9">إلى الّذينَ تطَوَّعوا مِنَ الشَّعبِ أقولُ: بارِكوا الرّبَّ.<verse eid="JDG 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="JDG 5:10" />أنشِدوا أيُّها الرَّاكبونَ الأتُنَ البِيضَ،</para>
  <para style="p" vid="JDG 5:10">الجالِسونَ على الطَّنافِسِ،</para>
  <para style="p" vid="JDG 5:10">وأنتُم أيُّها السَّائرونَ في الطَّريقِ<verse eid="JDG 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JDG 5:11" />رنِّموا على أصواتِ الجُموعِ</para>
  <para style="p" vid="JDG 5:11">عِندَ آبارِ المياهِ.</para>
  <para style="p" vid="JDG 5:11">هُناكَ يُخبِرونَ باَنتِصاراتِ الرّبِّ،</para>
  <para style="p" vid="JDG 5:11">باَنتِصاراتِ قادةِ إِسرائيلَ</para>
  <para style="p" vid="JDG 5:11">يومَ نزَلَ شعبُ الرّبِّ</para>
  <para style="p" vid="JDG 5:11">إلى ساحةِ المدينةِ.<verse eid="JDG 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="JDG 5:12" />قُومي اَنْهَضي يا دَبورَةُ،</para>
  <para style="p" vid="JDG 5:12">قُومي اَهْتِفي بِنَشيدٍ.</para>
  <para style="p" vid="JDG 5:12">واَنْهَضْ أنتَ يا باراقُ وتقَدَّمِ الأسْرى</para>
  <para style="p" vid="JDG 5:12">يا اَبنَ أبينوعَمَ.<verse eid="JDG 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="JDG 5:13" />بَنو إِسرائيلَ نزَلوا باَعتِزازٍ،</para>
  <para style="p" vid="JDG 5:13">شعبُ الرّبِّ نزَلوا كالأبطالِ.<verse eid="JDG 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="JDG 5:14" />بَنو أفرايِمَ هبَطوا الوادي</para>
  <para style="p" vid="JDG 5:14">وخَلْفَهُم أبطالُ بنيامينَ</para>
  <para style="p" vid="JDG 5:14">ومِنْ ماكيرَ نزَلَ الرُّؤساءُ</para>
  <para style="p" vid="JDG 5:14">ومِنْ زَبولونَ حامِلو الصَّولَجانِ.<verse eid="JDG 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="JDG 5:15" />رُؤساءُ يسَّاكَرَ معَ دَبورَةَ،</para>
  <para style="p" vid="JDG 5:15">كذلِكَ باراقُ.</para>
  <para style="p" vid="JDG 5:15">اَندَفَعوا إلى الوادي وراءَهُ.</para>
  <para style="p" vid="JDG 5:15">لكِنْ بَينَ بَني رَأوبينَ</para>
  <para style="p" vid="JDG 5:15">وقَعَ خِلافٌ شديدٌ.<verse eid="JDG 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="JDG 5:16" />ما بالُكُم قاعِدونَ بَينَ الحَظائرِ</para>
  <para style="p" vid="JDG 5:16">تَسمعونَ صوتَ القطيعِ؟</para>
  <para style="p" vid="JDG 5:16">نعم، بَينَ بَني رَأوبينَ</para>
  <para style="p" vid="JDG 5:16">وقَعَ خِلافٌ شديدٌ.<verse eid="JDG 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="JDG 5:17" />بَنو جادَ بَقَوا شَرقيَّ الأردُنِّ،</para>
  <para style="p" vid="JDG 5:17">وبَنو دانَ بَعيدًا في السُّفنِ</para>
  <para style="p" vid="JDG 5:17">وأشيرُ على ساحِلِ البحرِ</para>
  <para style="p" vid="JDG 5:17">يرتاحُ في المَواني<verse eid="JDG 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="JDG 5:18" />أمَّا بَنو زَبولونَ وبَنو نَفتالي</para>
  <para style="p" vid="JDG 5:18">فخاطَروا بأنفُسِهِم في ساحةِ القِتالِ.<verse eid="JDG 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="JDG 5:19" />جاءَ المُلوكُ وقاتَلوا،</para>
  <para style="p" vid="JDG 5:19">مُلوكُ كنعانَ حارَبوا في تَعنَكَ</para>
  <para style="p" vid="JDG 5:19">عِندَ مياهِ مَجِدُّو</para>
  <para style="p" vid="JDG 5:19">وغَنيمةَ فِضَّةٍ لم يَغنَموا.<verse eid="JDG 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="JDG 5:20" />مِنَ السَّماءِ قاتَلَتِ الكَواكِبُ،</para>
  <para style="p" vid="JDG 5:20">مِنْ مَداراتِها حارَبَت سِيسَرا.<verse eid="JDG 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="JDG 5:21" />نهرُ قَيشونَ جرَفَهُم جَرْفًا،</para>
  <para style="p" vid="JDG 5:21">النَّهرُ القديمُ نَهرُ قَيشونَ.</para>
  <para style="p" vid="JDG 5:21">فَدُوسي يا نفْسي بِعَزمٍ وقوَّةٍ.<verse eid="JDG 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="JDG 5:22" />أقبَلَتِ الخَيلُ مُسرِعةً</para>
  <para style="p" vid="JDG 5:22">بِالسَّنابِكِ تضرِبُ الأرضَ.<verse eid="JDG 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="JDG 5:23" />إلعَنوا ميروزَ يقولُ ملاكُ الرّبِّ،</para>
  <para style="p" vid="JDG 5:23">واَلعَنوا سُكَّانَها.</para>
  <para style="p" vid="JDG 5:23">لأنَّهُم ما جاؤوا لِنُصرَةِ الرّبِّ،</para>
  <para style="p" vid="JDG 5:23">لِنُصرَتِهِ على الجبابِرَةِ.<verse eid="JDG 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="JDG 5:24" />مُبارَكةٌ ياعيلُ بينَ النِّساءِ،</para>
  <para style="p" vid="JDG 5:24">مُباركةٌ هيَ اَمرَأةُ حابِرَ القَينيِّ،</para>
  <para style="p" vid="JDG 5:24">على جميعِ السَّاكناتِ في الخِيامِ.<verse eid="JDG 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="JDG 5:25" />مِنها طلَبَ سِيسَرا ماءً فأعطَتهُ لَبَنًا.<verse eid="JDG 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="JDG 5:26" />قبَضَت كَفُّها على وتَدٍ</para>
  <para style="p" vid="JDG 5:26">ويَمينُها على مِطرَقةٍ.</para>
  <para style="p" vid="JDG 5:26">ضَرَبَت رأسَهُ فشَدَّخَتْهُ.</para>
  <para style="p" vid="JDG 5:26">وحطَّمَت صُدغَهُ وخرَقَتْهُ،<verse eid="JDG 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="JDG 5:27" />سقَطَ عِندَ قدَميها.</para>
  <para style="p" vid="JDG 5:27">عِندَ قدَميها سقَطَ واَنْطَرَحَ،</para>
  <para style="p" vid="JDG 5:27">عِندَ قدَميها سقَطَ وماتَ.<verse eid="JDG 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="JDG 5:28" />أطَلَّت أمُّ سِيسَرا مِنَ النَّافِذَةِ،</para>
  <para style="p" vid="JDG 5:28">صرَخَت مِنْ وراءِ الشُّبَّاكِ.</para>
  <para style="p" vid="JDG 5:28">لِماذا أبطَأت مَركباتُهُ في المَجيءِ؟</para>
  <para style="p" vid="JDG 5:28">لِماذا تَأخَّرَت عَجَلاتُهُ؟<verse eid="JDG 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="JDG 5:29" />فأجابَتها أحكَمُ نِسائِها،</para>
  <para style="p" vid="JDG 5:29">بل هيَ أجابَت نفْسَها:<verse eid="JDG 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="JDG 5:30" />”أصابوا غنيمةً يَقتَسِمونَها،</para>
  <para style="p" vid="JDG 5:30">فتاةٌ، فتاتانِ لِكُلِّ بَطَلٍ.</para>
  <para style="p" vid="JDG 5:30">ثوبٌ، ثوبانِ مَصبوغانِ لسِيسَرا،</para>
  <para style="p" vid="JDG 5:30">مِنديلٌ مُطَرَّزُ الوجهَينِ لِعُنُقي“.<verse eid="JDG 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" pubnumber="31" sid="JDG 5:31" />فليَبِدْ جميعُ أعدائِكَ يا ربُّ،</para>
  <para style="p" vid="JDG 5:31">وليكُنْ مُحِبُّوكَ كالشَّمسِ المُشرِقةِ في بَهائِها.</para>
  <para style="p" vid="JDG 5:31">واَستراحَتِ الأرضُ أربعينَ سنَةً مِنَ الحروبِ.<verse eid="JDG 5:31" /></para>
  <chapter eid="JDG 5" />
  <chapter number="6" style="c" sid="JDG 6" />
  <para style="s1">جدعون</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JDG 6:1" />وعمِلَ بَنو إِسرائيلَ الشَّرَّ في عينَيِّ الرّبِّ، فسَلَّمَهُم إلى قبيلةِ مِديانَ سبْعَ سِنينَ. <verse eid="JDG 6:1" /><verse number="2" style="v" pubnumber="2" sid="JDG 6:2" />فضايَقَهُمُ المِديانيُّونَ، فلَجأوا إلى المَغاوِرِ الّتي في الجِبالِ والكُهوفِ والحُصونِ هرَبًا مِنهُم. <verse eid="JDG 6:2" /><verse number="3" style="v" pubnumber="3" sid="JDG 6:3" />وكانوا إذا زَرَعوا، يصعَدُ إليهِمِ المِديانيُّونَ والعَماليقيُّونَ وأهلُ الصَّحراءِ ويُهاجِمونَهُم. <verse eid="JDG 6:3" /><verse number="4" style="v" pubnumber="4" sid="JDG 6:4" />كانوا يُخَيِّمونَ على أرضِهِم ويُتلِفونَ غَلَّةَ الأرضِ إلى مَدخَلِ غَزَّةَ ولا يُبقونَ قُوتًا في إِسرائيلَ ولا غنَمًا ولا بقَرًا ولا حميرًا. <verse eid="JDG 6:4" /><verse number="5" style="v" pubnumber="5" sid="JDG 6:5" />كانوا يصعدونَ بِماشيَتِهِم وخيامِهِم ويأتونَ الأرضَ ويُفسِدونَها وهُم في كثرَةِ الجَرادِ، لا يُعَدُّونَ هُم ولا جِمالُهُم، <verse eid="JDG 6:5" /><verse number="6" style="v" pubnumber="6" sid="JDG 6:6" />فذَلَّ بَنو إِسرائيلَ جِدًّا أمامَ بَني مِديانَ وصرَخوا إلى الرّبِّ. <verse eid="JDG 6:6" /><verse number="7" style="v" pubnumber="7" sid="JDG 6:7" />ولمَّا صرَخوا إليهِ بِسبَبِ ظُلْمِ المِديانيِّينَ لهُم <verse eid="JDG 6:7" /><verse number="8" style="v" pubnumber="8" sid="JDG 6:8" />أرسَلَ الرّبُّ إليهِم نبيًّا فقالَ لهُم: ”هذا ما يقولُ الرّبُّ إلهُ إِسرائيلَ: أصعَدتُكُم مِنْ مِصْرَ وأخرَجتُكُم مِنْ دارِ العُبوديَّةِ <verse eid="JDG 6:8" /><verse number="9" style="v" pubnumber="9" sid="JDG 6:9" />وأنقَذتُكُم مِنْ أيدي المِصْريِّينَ ومِنْ أيدي جميعِ ظالِميكُم وطَرَدتُهُم مِنْ وجهِكُم وأعطَيتُكُم أرضَهُم. <verse eid="JDG 6:9" /><verse number="10" style="v" pubnumber="10" sid="JDG 6:10" />وقُلتُ لكُم إنِّي أنا الرّبُّ إلهُكُم. لا تعبُدوا آلهَةَ الأموريِّينَ الّذينَ تُقيمونَ بأرضِهِم، فلم تسمَعوا لِصوتي“.<verse eid="JDG 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JDG 6:11" />وجاءَ ملاكُ الرّبِّ وجلَسَ تَحتَ سَنابِلِ البُطمَةِ الّتي في عَفرَةَ وهيَ لِيوآشَ الأبيعَزري، وكانَ جِدعونُ اَبنُهُ يَدوسُ سَنابِلَ الحِنطَةِ في المَعصرَةِ هرَبًا مِنَ المِديانيِّينَ. <verse eid="JDG 6:11" /><verse number="12" style="v" pubnumber="12" sid="JDG 6:12" />فتَراءى لَه ملاكُ الرّبِّ وقالَ لَه: ”الرّبُّ معَكَ أيُّها الجَبَّارُ“. <verse eid="JDG 6:12" /><verse number="13" style="v" pubnumber="13" sid="JDG 6:13" />فقالَ لَه جِدعونُ: ”ناشَدتُكَ يا سيِّدي. إنْ كانَ الرّبُّ معَنا، فلِماذا أصابَنا ما أصابَنا، وأينَ جميعُ مُعجزاتِهِ الّتي حَدَّثَنا بِها آباؤُنا وقالوا لنا إنَّه أخرَجَنا مِنْ أرضِ مِصْرَ. والآنَ خذَلَنا وجعَلَنا في قبضَةِ بَني مِديانَ“. <verse eid="JDG 6:13" /><verse number="14" style="v" pubnumber="14" sid="JDG 6:14" />فاَلتفتَ إليهِ الرّبُّ وقالَ: ”أنا الّذي أُرسِلُكَ فاَذهَبْ بِقُوَّتِكَ هذِهِ وخَلِّصْ بَني إِسرائيلَ مِنْ قبضَةِ مِديانَ“. <verse eid="JDG 6:14" /><verse number="15" style="v" pubnumber="15" sid="JDG 6:15" />فقالَ لَه جِدعونُ: ”ناشَدتُكَ يا سيِّدي. بِماذا أُخَلِّصُ بَني إِسرائيلَ فقَبيلتي أضعَفُ قبيلةٍ في بَني منَسَّى، وأنا الأصغَرُ في بيتِ أبي“. <verse eid="JDG 6:15" /><verse number="16" style="v" pubnumber="16" sid="JDG 6:16" />فقالَ لَه الرّبُّ: ”أنا معَكَ وسَتضرِبُ بَني مِديانَ كما لو كانوا رَجُلًا واحدًا“. <verse eid="JDG 6:16" /><verse number="17" style="v" pubnumber="17" sid="JDG 6:17" />فقالَ لَه: ”إنْ كُنتَ راضيًا عليَّ، فأعطِني عَلامةً أنَّكَ أنتَ الّذي تُكَلِّمُني. <verse eid="JDG 6:17" /><verse number="18" style="v" pubnumber="18" sid="JDG 6:18" />لا تذهبْ مِنْ هُنا حتّى آتيكَ وأضَعَ تَقدِمَتي أمامَكَ“. فقالَ لَه: ”أنا هُنا حتّى تعودَ“.<verse eid="JDG 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="JDG 6:19" />فدخَلَ جِدعونُ وأعَدَّ جَدْيًا مِنَ المعَزِ وقُفَّةَ عجينِ فطيرٍ. وجعَلَ اللَّحمَ في سَلٍّ، ووضَعَ مرَقَ اللَّحمِ في قِدْرٍ، وخرَجَ بِذلِكَ تَحتَ البُطمةِ وأمامَهُ وضَعَ التَّقدِمةَ. <verse eid="JDG 6:19" /><verse number="20" style="v" pubnumber="20" sid="JDG 6:20" />فقالَ لَه ملاكُ اللهِ: ”خُذِ اللَّحمَ والفطيرَ وضَعهُما على هذِهِ الصَّخرةِ وصُبَّ المرَقَ“. ففعَلَ، <verse eid="JDG 6:20" /><verse number="21" style="v" pubnumber="21" sid="JDG 6:21" />فمَدَّ ملاكُ الرّبِّ طرَفَ العصا الّتي بِيدِهِ ومَسَّ اللَّحمَ والفطيرَ، فصَعِدَت نارٌ مِنَ الصَّخرةِ وأكلَتِ اللَّحمَ والفطيرَ. وغابَ ملاكُ الرّبِّ عَنْ عينَيهِ. <verse eid="JDG 6:21" /><verse number="22" style="v" pubnumber="22" sid="JDG 6:22" />فعَلِمَ جِدعونُ أنَّهُ ملاكُ الرّبِّ، فقالَ: ”آهِ، أيُّها الرّبُّ الإلهُ رأيتُ ملاكَ الرّبِّ وجهًا إلى وجهٍ“. <verse eid="JDG 6:22" /><verse number="23" style="v" pubnumber="23" sid="JDG 6:23" />فقالَ لَه الرّبُّ: ”سالِمًا تبقى. لا تَخَفْ فإنَّكَ لا تموتُ“. <verse eid="JDG 6:23" /><verse number="24" style="v" pubnumber="24" sid="JDG 6:24" />فبَنى جِدعونُ هُناكَ مذبَحًا للرّبِّ ودَعاهُ يَهوَهُ شَلومَ، وهوَ إلى هذا اليومِ لا يَزالُ في عَفرَةِ الأبيعَزَريِّينَ.<verse eid="JDG 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="JDG 6:25" />وفي تلكَ اللَّيلةِ ذاتِها قالَ لَه الرّبُّ: ”خُذْ ثورَ أبيكَ وثورًا ثانيًا اَبنَ سبْعِ سِنينَ واَهدُمْ مذبَحَ البَعلِ الذي لأبيكَ واَقْطَعِ الشَّجَرةَ القريبةَ، <verse eid="JDG 6:25" /><verse number="26" style="v" pubnumber="26" sid="JDG 6:26" />واَبنِ للرّبِّ إلهِكَ مذبَحًا حسَنَ البُنيانِ على رأسِ هذِهِ الصَّخرةِ. وخُذِ الثَّورَ الثَّاني وقَدِّمْهُ مُحرَقةً على حطَبِ الشَّجَرةِ الّتي تقطَعُها“. <verse eid="JDG 6:26" /><verse number="27" style="v" pubnumber="27" sid="JDG 6:27" />فأخذَ جِدعونُ عشرَةَ رِجالٍ مِنْ عبيدِهِ وفعَلَ كما أمرَهُ الرّبُّ. ولأنَّهُ خافَ مِنْ أقرِبائِهِ ومِنْ رِجالِ المدينةِ فعَلَ ذلِكَ ليلًا عِوضَ أنْ يفعَلَهُ نهارًا.<verse eid="JDG 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="JDG 6:28" />وبَكَّرَ رِجالُ المدينةِ صباحًا، فوجَدوا مذبَحَ البَعلِ مَهدومًا، والشَّجرةَ القريبةَ مِنهُ مَقطوعةً، والثَّورَ الثَّانيَ مُقَدَّمًا على المذبَحِ المَبنيِّ. <verse eid="JDG 6:28" /><verse number="29" style="v" pubnumber="29" sid="JDG 6:29" />فقالَ بَعضُهُم لِبَعضٍ: ”مَنْ فعَلَ هذا؟“ وحينَ سألوا وبَحَثوا قيلَ لهُم إنَّ جِدعونَ بنَ يوآشَ هوَ الّذي فعَلَ هذا. <verse eid="JDG 6:29" /><verse number="30" style="v" pubnumber="30" sid="JDG 6:30" />فقالَ أهلُ المدينةِ لِيوآشَ: ”هاتِ اَبْنَكَ لِنَقتُلَهُ لأنَّهُ هدَمَ مذبَحَ البَعلِ وقطَعَ الشَّجَرةَ القريبةَ مِنهُ“. <verse eid="JDG 6:30" /><verse number="31" style="v" pubnumber="31" sid="JDG 6:31" />فقالَ يوآشُ لجميعِ الحاضِرينَ: ”أتُدافِعونَ عَنِ البَعلِ وتُنجِدونَهُ؟ مَنْ يُدافِعُ عنهُ يُقْتَلُ قَبلَ طُلوعِ الصَّباحِ. إنْ كانَ البَعلُ إلهًا، فليَنتَقِمْ لِنَفسِهِ مِمَّنْ هدَمَ مذبَحَهُ“. <verse eid="JDG 6:31" /><verse number="32" style="v" pubnumber="32" sid="JDG 6:32" />ودعا يوآشُ جِدعونَ في ذلِكَ اليومِ يَرُبَّعلَ وقالَ: ”لِينتَقِمْ مِنهُ البَعلُ لأنَّهُ هدَمَ مذبَحَهُ“.<verse eid="JDG 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" pubnumber="33" sid="JDG 6:33" />وتحالَفَ بَنو مِديانَ وبَنو عَماليقَ وأهلُ الصَّحراءِ وعبروا الأردُنَّ وخيَّموا في وادي يزرَعيلَ. <verse eid="JDG 6:33" /><verse number="34" style="v" pubnumber="34" sid="JDG 6:34" />وحَلَّ روحُ الرّبِّ على جِدعونَ، فنفَخَ في البوقِ فخرَجَ أهلُ أبيعزَرَ وتَبِعوه. <verse eid="JDG 6:34" /><verse number="35" style="v" pubnumber="35" sid="JDG 6:35" />وأرسَلَ رُسُلًا إلى عَشيرَةِ منَسَّى فاَجتَمَعوا هُم أيضًا وتَبِعوه. وأرسَلَ رُسُلًا إلى عشائِرِ أشيرَ وزَبولونَ ونَفتالي فصَعِدوا جميعًا واَلتَحَقوا بِهِم.<verse eid="JDG 6:35" /></para>
  <para style="p">
    <verse number="36" style="v" pubnumber="36" sid="JDG 6:36" />وقالَ جِدعونُ للهِ: ”إنْ كُنتَ مُخَلِّصَ بَني إِسرائيلَ على يَدي كما قُلتَ، <verse eid="JDG 6:36" /><verse number="37" style="v" pubnumber="37" sid="JDG 6:37" />فَها أنا واضِعٌ جَزَّةَ صوفٍ على البَيدَرِ، فإذا سقَطَ النَّدى على الجَزَّةِ وحدَها وكانَ على الأرضِ حَولَها جَفافٌ، عَلِمتُ أنَّكَ مُخَلِّصٌ بَني إِسرائيلَ على يَدي كما قُلتَ“. <verse eid="JDG 6:37" /><verse number="38" style="v" pubnumber="38" sid="JDG 6:38" />فكانَ كذلِكَ. وبكَّرَ في الغَدِ وعصَرَ الجَزَّةَ فخرَجَ مِنها الماءُ مِلء سَطلٍ. <verse eid="JDG 6:38" /><verse number="39" style="v" pubnumber="39" sid="JDG 6:39" />فقالَ جِدعونُ للهِ: ”لا تَغضَبْ عليَّ. دَعني أتكَلَّمُ فقط هذِهِ المرَّةَ وأُجَرِّبُ هذِهِ المرَّةَ أيضًا بِجَزَّةِ الصُّوفِ: لِيكُن على الجَزَّةِ وحدَها جفافٌ وعلى الأرضِ حَولَها نَدًى“. <verse eid="JDG 6:39" /><verse number="40" style="v" pubnumber="40" sid="JDG 6:40" />ففعَلَ الرّبُّ كذلِكَ في تِلكَ اللَّيلةِ، فكانَ على الجَزَّةِ وحدَها جفافٌ وعلى الأرضِ حَولَها نَدًى.<verse eid="JDG 6:40" /></para>
  <chapter eid="JDG 6" />
  <chapter number="7" style="c" sid="JDG 7" />
  <para style="s1">إنتصار جدعون على المديانيين</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JDG 7:1" />فبَكَّرَ يَربَّعلُ، وهوَ جِدعونُ، وجميعُ القَومِ الّذينَ معَهُ وخيَّموا عِندَ عينِ حَرودَ، وكانَت خيامُ المِديانيِّينَ إلى الشّمالِ نحوَ تَلِّ مورَةَ في الوادي.<verse eid="JDG 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="JDG 7:2" />فقالَ الرّبُّ لِجدعونَ: ”الرِّجالُ الّذينَ معَكَ أكثَرُ مِنْ أنْ أُسلِمَ بَني مِديانَ إلى أيديهِم لِئلَّا يفتَخِرَ عليَّ بَنو إِسرائيلَ ويقولوا: أيدينا خَلَّصَتْنا. <verse eid="JDG 7:2" /><verse number="3" style="v" pubnumber="3" sid="JDG 7:3" />فالآنَ نادِ على مَسامِعِ الشَّعبِ وقُلْ: مَنْ كانَ خائِفًا فليَرجِعْ ويَنصَرِفْ مِنْ جبَلِ جِلعادَ“. فرجَعَ مِنَ الشَّعبِ اَثْنانِ وعِشرونَ ألفًا، وبَقيَ معَهُ عشَرَةُ آلافٍ.<verse eid="JDG 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="JDG 7:4" />فقالَ الرّبُّ لِجِدعونَ: ”ما زالَ الرِّجالُ كثيرينَ. أنزِلْهُم إلى الماءِ وأنا أُجَرِّبُهُم هُناكَ. فالّذي عَنهُ أقولُ: هذا يذهبُ معَكَ، فهوَ يذهبُ، وكُلُّ واحدٍ عَنهُ أقولُ: هذا لا يذهبُ، فهوَ لا يذهبُ“. <verse eid="JDG 7:4" /><verse number="5" style="v" pubnumber="5" sid="JDG 7:5" />فأنزلَ جِدعونُ الرِّجالَ إلى الماءِ، فقالَ لَه الرّبُّ: ”كُلُّ مَنْ شربَ بِلِسانِهِ كما يشربُ الكلبُ أقِمْهُ ناحيةً، وكذلِكَ كُلُّ مَنْ ركَعَ على رُكبَتَيهِ لِيَشربَ“.<verse eid="JDG 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="JDG 7:6" />فكانَ عدَدُ مَنْ شَرِبَ الماءَ مِنْ راحَتِهِ ثَلاثَ مئةِ رَجُلٍ، أمَّا البقيَّةُ فركَعوا على رُكَبِهِم لِيَشرَبوا. <verse eid="JDG 7:6" /><verse number="7" style="v" pubnumber="7" sid="JDG 7:7" />فقالَ الرّبُّ لِجِدعونَ: ”بِهؤلاءِ الثَّلاثِ مئةِ رَجُلٍ الّذينَ شرِبوا بأيديهِم أُخَلِّصُكُم وأدفَعُ بَني مِديانَ إلى يَدِكُم، وأمَّا الآخرونَ فليَرجِعْ كُلُّ واحدٍ إلى بَيتِهِ“. <verse eid="JDG 7:7" /><verse number="8" style="v" pubnumber="8" sid="JDG 7:8" />فأخذَ الثَّلاثُ مئةِ رَجُلٍ زادًا في أيديهِم وحمَلوا أبواقَهُم، وأمَّا الآخَرونَ فصرَفَهُم جِدعونُ، كُلُّ واحدٍ إلى بَيتِهِ، واَصْطَحَبَ الثَّلاثَ مئةِ رَجُلٍ، وكانَت محلَّةُ بَني مِديانَ في الوادي.<verse eid="JDG 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="JDG 7:9" />فقالَ الرّبُّ لِجدعونَ في تِلكَ اللَّيلةِ: ”هاجِمْ خيامَ المِديانيِّينَ لأنِّي أسلَمْتُها إلى يَدِكَ. <verse eid="JDG 7:9" /><verse number="10" style="v" pubnumber="10" sid="JDG 7:10" />وإنْ كُنتَ تخافُ أنْ تَهجُمَ، فتَسَلَّلْ إليهِم معَ فورَةَ خادِمِكَ <verse eid="JDG 7:10" /><verse number="11" style="v" pubnumber="11" sid="JDG 7:11" />واَسْمَع ما يقولونَ، وبَعدَ ذلِكَ تشتَدُّ عزيمَتُكَ وتُهاجِمُهُم“. فتَسَلَّلَ جِدعونُ معَ فورَةَ خادِمِه إلى طرَفِ المُعَسكرِ. <verse eid="JDG 7:11" /><verse number="12" style="v" pubnumber="12" sid="JDG 7:12" />وكانَ المِديانيُّونَ والعَماليقيُّونَ وأهلُ الصَّحراءِ مُخيِّمينَ في الوادي في كثرَةِ الجَرادِ، ولم يكُن لِجِمالِهِم عدَدٌ لأنَّها كانَت كالرَّملِ على شاطِئِ البحرِ. <verse eid="JDG 7:12" /><verse number="13" style="v" pubnumber="13" sid="JDG 7:13" />فلمَّا اَقترَبَ جِدعونُ مِنَ المحلَّةِ سَمِعَ رَجُلًا يَقُصُّ على رفيقِهِ حُلُمًا، قالَ: ”حَلُمْتُ بِرَغيفِ خُبزٍ مِنْ شعيرٍ يتَدحرَجُ إلى مُعَسكرِ بَني مِديانَ، تدحرَجَ حتّى خَيمةٍ وصدَمَها، قلبَها إلى فَوقُ وسَقَطَت“. <verse eid="JDG 7:13" /><verse number="14" style="v" pubnumber="14" sid="JDG 7:14" />فأجابَ صاحبُهُ: ”هذا سيفُ جِدعونَ بنِ يوآشَ، جبَّارِ بَني إِسرائيلَ الّذي دفَعَ اللهُ إلى يدِهِ بَني مِديانَ وكُلَّ المُعَسكرِ“.<verse eid="JDG 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="JDG 7:15" />فلمَّا سَمِعَ جِدعونُ هذا الحُلُمَ وتفسيرَهُ سجدَ للرّبِّ ورجعَ إلى محلَّةِ بَني إِسرائيلَ وقالَ: ”قوموا لأنَّ الرّبَّ دفَعَ محلَّة بَني مِديانَ إلى أيديكُم“. <verse eid="JDG 7:15" /><verse number="16" style="v" pubnumber="16" sid="JDG 7:16" />وقسمَ جِدعونُ الثَّلاثَ مئةِ رَجُلٍ ثَلاثَ فِرَقٍ وجعَلَ أبواقًا في أيديهِم وجِرارًا فارِغَةً فيها مَشاعِلُ، <verse eid="JDG 7:16" /><verse number="17" style="v" pubnumber="17" sid="JDG 7:17" />وقالَ لهُم: ”ها أنا داخِلٌ إلى طرَفِ المحلَّةِ تفعَلونَ تَمامًا كما أفعَلُ. <verse eid="JDG 7:17" /><verse number="18" style="v" pubnumber="18" sid="JDG 7:18" />فمتى نفَختُ في البوقِ أنا وجميعُ مَنْ معي، تَنفُخونَ في الأبواقِ أنتُم أيضًا حَولَ المحلَّةِ كُلِّها وتقولونَ: لِلرّبِّ ولِجِدعونَ“. <verse eid="JDG 7:18" /><verse number="19" style="v" pubnumber="19" sid="JDG 7:19" />ودخَلَ جِدعونُ بِمئةِ رَجُلٍ طرَفَ المحلَّةِ قَبلَ مُنتَصَفِ اللَّيلِ، تَمامًا قَبلَ أنْ يتبَدَّلَ الحُرَّاسُ، فنَفَخوا في الأبواقِ وكسَروا الجِرارَ الّتي بِأيديهِم <verse eid="JDG 7:19" /><verse number="20" style="v" pubnumber="20" sid="JDG 7:20" />ونفَخَ رِجالُ الفِرقَتينِ الباقيَتَينِ في الأبواقِ وكسَروا الجِرارَ، وأخَذوا المَشاعِلَ بأيديهِم اليُسرى والأبواقَ بأيديهِم اليُمنى ونفَخوا فيها، وهتَفوا: ”حربٌ لأجلِ الرّبِّ وجِدعونَ!“ <verse eid="JDG 7:20" /><verse number="21" style="v" pubnumber="21" sid="JDG 7:21" />ووقَفَ كُلُّ رَجُلٍ في مَوضِعِه حَولَ المحلَّةِ، فتَراكَضَ الأعداءُ كُلُّهُم وضَجُّوا بِالصِّياحِ وهرَبوا. <verse eid="JDG 7:21" /><verse number="22" style="v" pubnumber="22" sid="JDG 7:22" />وحينَ نفَخَ الثّلاثُ مئةٍ في الأبواقِ، جعَلَ الرّبُّ كُلَّ واحدٍ مِنَ العَدُوِّ يَطعَنُ رفيقَهُ بِالسَّيفِ في المحلَّةِ كُلِّها، فهرَبوا إلى بَيتَ شِطَّةَ، إلى صَردَةَ حتّى اَنتَهَوا إلى حافَّةِ آبَلِ مَحولَةَ الّتي عِندَ طَبَّاةَ. <verse eid="JDG 7:22" /><verse number="23" style="v" pubnumber="23" sid="JDG 7:23" />فاَجتمَعَ رِجالُ بَني إِسرائيلَ مِنْ عشائِرِ نَفتالي وأشيرَ وكُلِّ منَسَّى وطارَدوا المِديانيِّينَ.<verse eid="JDG 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="JDG 7:24" />وأرسَلَ جِدعونُ رُسُلًا إلى جميعِ جبَلِ أفرايِمَ وقالَ: ”أُخرُجوا لِقِتالِ المِديانيِّينَ، واَستَولوا على مَعابِرِ نهرِ الأُردُنِّ المُؤدِّيةِ إلى بَيتَ بارَةَ حتّى لا يَعبُروها“. فاَجتمَعَ رِجالُ أفرايِمَ كُلُّهُم واَستَولَوا على المَعابِرِ المُؤدِّيةِ إلى بَيتَ بارَةَ. <verse eid="JDG 7:24" /><verse number="25" style="v" pubnumber="25" sid="JDG 7:25" />وقبَضوا على قائِدَينِ مِنْ قادةِ بَني مِديانَ، وهُما عوريبُ وزيبُ، وقتَلوا عوريبَ على صخرةِ عوريبَ، وقتَلوا زيبَ عِندَ مَعصرةِ زيبَ، وطارَدوا المِديانيِّينَ وحمَلوا رأسَي عوريبَ وزيبَ وجاؤُوا بِهِما إلى جِدعونَ في شَرقيِّ الأُردنِّ.<verse eid="JDG 7:25" /></para>
  <chapter eid="JDG 7" />
  <chapter number="8" style="c" sid="JDG 8" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JDG 8:1" />فسَألَ بَنو أفرايمَ جِدعونَ: ”لِماذا فعَلْتَ بِنا هكذا ولم تَدْعُنا حينَ خَرجْتَ لِقِتالِ المِديانيِّينَ؟“ وخاصَموهُ خِصامًا شديدًا. <verse eid="JDG 8:1" /><verse number="2" style="v" pubnumber="2" sid="JDG 8:2" />فقالَ لهُم: ”ما فعَلْتُ بِالنِّسبةِ إلى ما فعَلتُم أنتُم؟ أما بقايا أفرايمَ مِنَ العِنَبِ أفضَلُ مِنْ قِطافِ أبيعزَرَ؟ <verse eid="JDG 8:2" /><verse number="3" style="v" pubnumber="3" sid="JDG 8:3" />إلى أيديكُم دفَعَ اللهُ قائِدَي المِديانيِّينَ عوريبَ وزيبَ. فماذا أمكَنَني أنْ أفعَلَ أحسَنَ مِمَّا أنتُم فعَلتُم؟“ فسكَن غضَبُهُم عَنهُ حينَ قالَ لهُم هذا الكلامَ.<verse eid="JDG 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="JDG 8:4" />وعبَرَ جِدعونُ الأُردُنَّ، هوَ والثَّلاثُ مئةِ رَجلٍ الّذينَ معَهُ وهُم يُطارِدونَ الأعداءَ رُغمَ ما بِهِم مِنْ عَياءٍ. <verse eid="JDG 8:4" /><verse number="5" style="v" pubnumber="5" sid="JDG 8:5" />فقالَ لأهلِ سُكُّوتَ: ”أعطوا الّذينَ معي خُبزًا لأنَّهُم تَعِبوا، وأنا ساعٍ في طَلَبِ زبَحَ وصَلمُنَّاعَ مَلكَي مديانَ“. <verse eid="JDG 8:5" /><verse number="6" style="v" pubnumber="6" sid="JDG 8:6" />فقالَ لَه رؤساءُ سُكُّوتَ: ”هل قبضتَ على زبَحَ وصلمُنَّاعَ حتّى نُعطيَ عَسكرَك خُبزًا؟“ <verse eid="JDG 8:6" /><verse number="7" style="v" pubnumber="7" sid="JDG 8:7" />فقالَ جِدعونُ: ”مِنْ أجلِ هذا الكلامِ سأُهَشِّمُ أجسادَكُم بأشواكِ البرِّيَّةِ والنَّوارِجِ حينَ يُسَلِّمُ الرّبُّ إلى يَدي زبَحَ وصَلمُنَّاعَ“. <verse eid="JDG 8:7" /><verse number="8" style="v" pubnumber="8" sid="JDG 8:8" />وصَعِدَ مِنْ هُناكَ إلى فنوئيلَ فطلَبَ مِنْ أهلِها الشيءَ ذاتَهُ فأجابوهُ كما أجابَهُ أهلُ سُكُّوتَ. <verse eid="JDG 8:8" /><verse number="9" style="v" pubnumber="9" sid="JDG 8:9" />فقالَ لأهلِ فنوئيلَ أيضًا: ”إنْ رَجَعتُ سالِمًا سأهدِمُ بُرجَكُم هذا“.<verse eid="JDG 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="JDG 8:10" />وكانَ زبَحُ وصَلمُنَّاعُ في قَرقَرَ ومعَهُما عَساكِرُهُما نحوَ خَمسةَ عشَرَ ألفَ رَجُلٍ، وهُم جميعُ مَنْ بَقيَ مِنْ عَسكرِ أهلِ الصَّحراءِ كُلِّهِ. وكانَ الّذينَ سقَطوا مِنهُم مئةً وعِشرينَ ألفَ مُقاتِلٍ. <verse eid="JDG 8:10" /><verse number="11" style="v" pubnumber="11" sid="JDG 8:11" />ثُمَّ اَتَّجهَ جِدعونُ في الطَّريقِ على حُدودِ الصَّحراءِ شَرقيَّ نوبَحَ ويُجبَهَةَ وهاجَمَ المُعَسكرَ، وكانوا مُطْمَئنّينَ. <verse eid="JDG 8:11" /><verse number="12" style="v" pubnumber="12" sid="JDG 8:12" />فهرَبَ زبَحُ وصَلمُنَّاعُ، فلِحَقَ جِدعونُ بِهِما وقبَضَ علَيهما، وزَرَعَ الرُّعبَ في المحلَّةِ.<verse eid="JDG 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="JDG 8:13" />ورجَعَ جِدعونُ بنُ يوآشَ مِنَ الحربِ، مِنْ عِندِ قَعلَةَ حارَسَ قَبلَ شُروقِ الشَّمسِ. <verse eid="JDG 8:13" /><verse number="14" style="v" pubnumber="14" sid="JDG 8:14" />وأوقَفَ شابًا مِنْ أهلِ سُكّوتَ واَستَجوبَهُ، فذكَر لَه أسماءَ سبعةٍ وسَبعينَ رَجُلًا مِنْ رؤساءِ سُكُّوتَ وشُيوخِها. <verse eid="JDG 8:14" /><verse number="15" style="v" pubnumber="15" sid="JDG 8:15" />ثُمَّ عادَ إلى أهلِ سُكُّوتَ وقالَ لهُم: ”ها زبَحُ وصَلمُنَّاعُ اللَّذانِ عيَّرتُمونَني بِهِما وقُلتُم: هل قبَضتَ على زبَحَ وصَلمُنَّاعَ حتّى نُعطيَ رِجالَكَ المُتعَبينَ خُبزًا“. <verse eid="JDG 8:15" /><verse number="16" style="v" pubnumber="16" sid="JDG 8:16" />وقبضَ على شُيوخِ المدينةِ وعاقبَهُم بأشواكِ البرِّيَّةِ والنَّوارِجِ. <verse eid="JDG 8:16" /><verse number="17" style="v" pubnumber="17" sid="JDG 8:17" />وهدَمَ بُرجَ فنوئيلَ وقتَلَ رِجالَ المدينةِ.<verse eid="JDG 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="JDG 8:18" />وقالَ جِدعونُ لِزَبحَ وصَلمُنَّاعَ: ”كيفَ كانَ الرِّجالُ الّذينَ قتَلتُما في تابورَ؟“ فقالا لَه: ”كانوا مِثلَكَ، وهَيئَةُ كُلِّ واحدٍ مِنهُم كهَيئةِ أبناءِ المُلوكِ“. <verse eid="JDG 8:18" /><verse number="19" style="v" pubnumber="19" sid="JDG 8:19" />فقالَ: ”هُم إخوتي وأبناءُ أمِّي. لو أبقَيتُما علَيهِم لما كُنتُ أقتُلُكُما“. <verse eid="JDG 8:19" /><verse number="20" style="v" pubnumber="20" sid="JDG 8:20" />ثمَّ قالَ لِيَثَر بِكرِهِ: ”قُمْ فاَقتُلْهُما“. فلم يَشهَرْ سيفَهُ خوفًا لأنَّهُ كانَ صبيًّا بَعدُ. <verse eid="JDG 8:20" /><verse number="21" style="v" pubnumber="21" sid="JDG 8:21" />فقالَ زَبَحُ وصَلمُنَّاعُ لِجدعونَ: ”قُم أنتَ واَقتُلْنا، فكما يكونُ الرَّجُلُ يكونُ بَطشُهُ“. فقامَ جِدعونُ وقتَلَهُما وأخَذَ زينةَ الفِضَّةِ الّتي كانَت في عُنُقي جَمَليهِما.<verse eid="JDG 8:21" /></para>
  <para style="s1">نهاية حياة جدعون</para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="JDG 8:22" />وقالَ رِجالُ بَني إسرائيلَ لِجدعونَ: ”تَسَلَّطْ علَينا أنتَ واَبنُكَ واَبنُ اَبنِكَ لأنَّكَ خلَّصتَنا مِنْ أيدي المِديانيِّينَ“. <verse eid="JDG 8:22" /><verse number="23" style="v" pubnumber="23" sid="JDG 8:23" />فقالَ لهُم: ”لا أنا أتسَلَّطُ علَيكُم ولا اَبْني، بلِ الرّبُّ هوَ الّذي يتَسلَّطُ علَيكُم“. <verse eid="JDG 8:23" /><verse number="24" style="v" pubnumber="24" sid="JDG 8:24" />ثُمَّ قالَ لهُم: ”أقتَرِحُ علَيكُم أمرًا واحدًا: يُعطيني كُلُّ واحدٍ مِنكُم الخَواتِمَ الّتي غَنِمَها“. قالَ ذلِكَ لأنَّ المِديانيِّينَ كالإسماعيليِّينَ كانوا يضعونَ خَواتِمَ مِنْ ذهَبٍ. <verse eid="JDG 8:24" /><verse number="25" style="v" pubnumber="25" sid="JDG 8:25" />فقالوا: ”لَكَ ذلِكَ“. وبَسَطوا رِداءً فألقى علَيهِ كُلُّ واحدٍ مِنهُمُ الخَواتِمَ الّتي غَنِمَها. <verse eid="JDG 8:25" /><verse number="26" style="v" pubnumber="26" sid="JDG 8:26" />وكانَ وزنُ الخَواتِمِ الذَّهَبيَّةِ الّتي طَلَبها ألفًا وسَبعَ مئةِ مِثقالِ ذهَبٍ، ما عدا زينَةَ الفِضَّةِ والحَلَقَ والثِّيابَ الأرجوانيَّةَ الّتي كانَت على مُلوكِ بَني مِديانَ، وما عدا القلائِدَ الّتي كانَت في أعناقِ جِمالِهِم. <verse eid="JDG 8:26" /><verse number="27" style="v" pubnumber="27" sid="JDG 8:27" />فصاغَ جِدعونُ مِنْ ذلِكَ صَنمًا ووَضَعَهُ في مدينتِهِ عَفرَةَ فخانَ الرّبَّ كُلُّ بَني إسرائيلَ بِعبادَةِ هذا الصَّنَمِ الّذي كانَ فَخًّا لِجِدعونَ وبَيتِه. <verse eid="JDG 8:27" /><verse number="28" style="v" pubnumber="28" sid="JDG 8:28" />وخضَعَ المِديانيُّونَ لِبَني إسرائيلَ ولم تَقُمْ لهُم قائِمةٌ مِنْ بَعدُ. واَستَراحَتِ الأرضُ مِنَ الحُروبِ أربعينَ سنَةً في أيّامِ جِدعونَ.<verse eid="JDG 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="JDG 8:29" />وأقامَ جِدعونُ بنُ يوآشَ في بيتِهِ. <verse eid="JDG 8:29" /><verse number="30" style="v" pubnumber="30" sid="JDG 8:30" />وصارَ لَه سبعونَ اَبنًا خرَجوا من صُلْبِهِ لأنَّهُ تَزَوَّجَ نِساءً كثيراتٍ <verse eid="JDG 8:30" /><verse number="31" style="v" pubnumber="31" sid="JDG 8:31" />وولَدَت لَه أيضًا جارِيَتُهُ الّتي في شكيمَ اَبنًا سَمَّاه أبيمالِكَ. <verse eid="JDG 8:31" /><verse number="32" style="v" pubnumber="32" sid="JDG 8:32" />وماتَ جِدعونُ بنُ يوآشَ بِشيخوخةٍ صالِحةٍ ودُفِنَ في قبرِ يوآشَ أبيهِ في عَفرَةَ، مدينةِ الأبيعَزَريِّينَ.<verse eid="JDG 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" pubnumber="33" sid="JDG 8:33" />وبَعدَ موتِ جِدعونَ عادَ بَنو إسرائيلَ يَخونونَ الرّبَّ بِعِبادَةِ البَعلِ، واَتَّخَذوا لأنفُسِهِم بَعلَ بَريثَ إلهًا. <verse eid="JDG 8:33" /><verse number="34" style="v" pubnumber="34" sid="JDG 8:34" />ولم يَذكُرْ بَنو إسرائيلَ الرّبَّ إلهَهُم الّذي أنقَذَهُم مِنْ أيدي جميعِ أعدائِهِمِ المُحيطينَ بِهِم. <verse eid="JDG 8:34" /><verse number="35" style="v" pubnumber="35" sid="JDG 8:35" />ولم يُحسِنوا مُعامَلةَ أهلِ جِدعونَ مُقابِلَ كُلِّ الخَيرِ الّذي صَنَعَهُ إلى إِسرائيلَ.<verse eid="JDG 8:35" /></para>
  <chapter eid="JDG 8" />
  <chapter number="9" style="c" sid="JDG 9" />
  <para style="s1">أبيمالك بن جدعون</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JDG 9:1" />وذهَبَ أبيمالِكُ بنُ يَربَّعَلَ إلى أخوالِهِ في شكيمَ، وقالَ لهُم ولجميعِ قبيلَةِ أبي أمِّهِ: <verse eid="JDG 9:1" /><verse number="2" style="v" pubnumber="2" sid="JDG 9:2" />”قولوا على مَسامِعِ جميعِ أهلِ شكيمَ: أيُّهُما خيرٌ لكُم، أنْ يتَسَلَّطَ علَيكُم سبعونَ رَجُلًا، أي جميعُ بَني يَربَّعَلَ، أم رَجُلٌ واحدٌ؟ واَذكُروا أنِّي أنا مِن لَحمِكُم ودَمِكُم“. <verse eid="JDG 9:2" /><verse number="3" style="v" pubnumber="3" sid="JDG 9:3" />فنَقلَ أخوالُهُ إلى أهلِ شكيمَ هذا الكلامَ، فمالَت قُلوبُهُم نحوَ أبيمالِكَ لأنَّهُم قالوا إنه قريبُنا. <verse eid="JDG 9:3" /><verse number="4" style="v" pubnumber="4" sid="JDG 9:4" />وأعطَوهُ سبعينَ مِنَ الفِضَّةِ مِنْ بيتِ بَعلِ بَريتَ، فاَستأجرَ بِها رِجالًا بطَّالينَ أشقياءَ. <verse eid="JDG 9:4" /><verse number="5" style="v" pubnumber="5" sid="JDG 9:5" />وجاءَ إلى بيتِ أبيهِ في عَفرَةَ وقتلَ إخوتَهُ بَني يَربَّعَلَ، وهُم سبعونَ رَجُلًا على صخرةٍ واحِدةٍ. وبَقيَ يوتامُ أصغَرُ بَني يَربَّعَلَ حَيًّا لأنَّهُ اَختبأَ. <verse eid="JDG 9:5" /><verse number="6" style="v" pubnumber="6" sid="JDG 9:6" />واَجتمَعَ أهلُ شكيمَ وبيتَ مَلُّو ومضَوا إلى أبيمالِكَ وأقاموهُ علَيهِم مَلِكًا عِندَ شَجَرةِ البلُّوطِ الّتي في شكيمَ.<verse eid="JDG 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="JDG 9:7" />فلمَّا عَلِمَ يوتامُ بِذلِكَ ذهَبَ إلى جبَلِ جِرزِّيمَ ووقَفَ على قِمَّتِهِ. رفَعَ صوتَهُ وقالَ لهُم: ”إسمَعوا لي يا أهلَ شكيمَ فيسمعَ اللهُ لكُم. <verse eid="JDG 9:7" /><verse number="8" style="v" pubnumber="8" sid="JDG 9:8" />ذهَبتِ الأشجارُ مرَّةً لِتَمسَحَ علَيها مَلِكًا، فقالَت لِشجَرةِ الزَّيتونِ: كوني علَينا مَلِكَةً. <verse eid="JDG 9:8" /><verse number="9" style="v" pubnumber="9" sid="JDG 9:9" />فقالَتِ الزَّيتونَةُ: أأترُكُ زيتي الّذي مِنْ أجلِه تُكرِمُني الآلِهةُ والنَّاسُ وأذهَبُ لأستَعليَ على الشَّجَرِ؟ <verse eid="JDG 9:9" /><verse number="10" style="v" pubnumber="10" sid="JDG 9:10" />فقالتِ الأشجارُ لِلتِّينَةِ: تَعالَي أنتِ وكوني علَينا مَلِكَةً. <verse eid="JDG 9:10" /><verse number="11" style="v" pubnumber="11" sid="JDG 9:11" />فقالَتِ التِّينَةُ: أأترُكُ حلاوتي وثَمَرتي الطَيِّبَةَ وأذهَبُ لأستَعليَ على الشَّجَرِ؟ <verse eid="JDG 9:11" /><verse number="12" style="v" pubnumber="12" sid="JDG 9:12" />فقالتِ الأشجارُ لِلكَرمةِ: تَعالي أنتِ وكوني علَينا مَلِكَةً. <verse eid="JDG 9:12" /><verse number="13" style="v" pubnumber="13" sid="JDG 9:13" />فقالَتِ الكَرمةُ: أأترُكُ خَمري الّذي يُفَرِّحُ الآلِهةَ والنَّاسَ وأذهَبُ لأستَعليَ على الشَّجَرِ؟ <verse eid="JDG 9:13" /><verse number="14" style="v" pubnumber="14" sid="JDG 9:14" />فقالَتِ الأشجارُ كُلُّها لِلعَوسَجةِ: تَعالي أنتِ وكوني علَينا مَلِكَةً. <verse eid="JDG 9:14" /><verse number="15" style="v" pubnumber="15" sid="JDG 9:15" />فقالَتِ العوسَجةُ: إنْ كُنتِ حَقًّا تَمسَحينَني مَلِكَةً علَيكِ، فتَعالي، وفي ظِلِّي اَستَظِلِّي، وإلَّا فلتَخرُجْ نارٌ مِنَ العوسَجةِ وتَحرُقْ أرزَ لبنانَ.<verse eid="JDG 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="JDG 9:16" />”والآنَ هل عَمِلتُم بِالحَقِّ والاستِقامةِ، فَمَلَّكتُم علَيكُم أبيمالِكَ؟ هل صَنَعتُم خَيرًا إلى يربَّعَلَ وبَيتِهِ وكافأتُموهُ على ما صَنَعت يَداهُ؟ <verse eid="JDG 9:16" /><verse number="17" style="v" pubnumber="17" sid="JDG 9:17" />أبي قاتَلَ عَنكُم وخاطرَ بِنفسِه وأنقَذَكُم مِنْ أيدي المِديانيِّينَ، أمَّا أنتُمُ اليومَ <verse eid="JDG 9:17" /><verse number="18" style="v" pubnumber="18" sid="JDG 9:18" />فَهاجَمتُم بيتَ أبي وذَبَحتُم بَنيهِ السَّبعينَ على صخرةٍ واحدةٍ، ومَلَّكتُم أبيمالِكَ اَبنَ أمَتِهِ على أهلِ شكيمَ لأنَّهُ قريبُكُم، <verse eid="JDG 9:18" /><verse number="19" style="v" pubnumber="19" sid="JDG 9:19" />فإنْ كُنتُم عَمِلْتُم بِالحَقِّ والاستِقامةِ معَ يَربَّعَلَ ومعَ بَيتِهِ في هذا اليومِ فاهنَأوا بِأبيمالِكَ وليَهنَأْ هوَ أيضًا بِكُم، <verse eid="JDG 9:19" /><verse number="20" style="v" pubnumber="20" sid="JDG 9:20" />وإلَّا فَلتَخرُجْ نارٌ مِنْ أبيمالِكَ وتَأكُلْ أهلَ شكيمَ وبَيتَ مِلُّو، ولتَخرُجْ نارٌ مِنْ أهلِ شكيمَ وبَيتَ مِلُّو وتأكُلْ أبيمالِكَ“. <verse eid="JDG 9:20" /><verse number="21" style="v" pubnumber="21" sid="JDG 9:21" />وفَرَّ يوتامُ هارِبًا إلى بيرَ، فأقامَ هُناكَ خوفًا مِنْ أبيمالِكَ أخيهِ.<verse eid="JDG 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="JDG 9:22" />ومَلَكَ أبيمالِكُ على بَني إِسرائيلَ ثَلاثَ سِنينَ. <verse eid="JDG 9:22" /><verse number="23" style="v" pubnumber="23" sid="JDG 9:23" />وألقى اللهُ بِروحِ العِداءِ بينَ أبيمالِكَ وأهلِ شكيمَ، فغَدَرَ أهلُ شكيمَ بأبيمالِكَ <verse eid="JDG 9:23" /><verse number="24" style="v" pubnumber="24" sid="JDG 9:24" />لِيرتَدَّ الظُلمُ الّذي وقَعَ على بَني يَرُبَّعَلَ السَّبعينَ ويكونَ دَمُهُم على أبيمالِكَ أخيهِم الّذي قتَلَهُم وعلى أهلِ شكيمَ الّذينَ شَجَّعوهُ على قتْلِهِم. <verse eid="JDG 9:24" /><verse number="25" style="v" pubnumber="25" sid="JDG 9:25" />فأقامَ أهلُ شكيمَ كمينًا على رُؤوسِ الجِبالِ، فكانوا يَسلُبونَ كُلَّ مَنْ مرَّ بِهِم في الطَّريقِ. وعَلِمَ أبيمالِكُ بِذلِكَ.<verse eid="JDG 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" pubnumber="26" sid="JDG 9:26" />وجاءَ جعَلُ بنُ عابِدٍ معَ إخوتِهِ إلى شكيمَ، فوَثِقَ بهِ أهلُها، <verse eid="JDG 9:26" /><verse number="27" style="v" pubnumber="27" sid="JDG 9:27" />وخَرَجوا إلى البرِّيَّةِ وقطَفوا كُرومَهُم وعصَروا واَحتَفَلوا ودَخَلوا بُيوتَ آلِهتِهِم وأكلوا وشرِبوا ولَعَنوا أبيمالِكَ. <verse eid="JDG 9:27" /><verse number="28" style="v" pubnumber="28" sid="JDG 9:28" />فقالَ جعَلُ بنُ عابِدَ: ”مَنْ هوَ أبيمالِكُ؟ ولِماذا نخدُمُهُ نحنُ في شكيمَ: أما هوَ اَبنُ يَربَّعَلَ ووكيلُهُ زَبولُ؟ فلماذا نخدُمُهُ؟ اَخدُموا رِجالَ حَمورَ أبي شكيمَ. <verse eid="JDG 9:28" /><verse number="29" style="v" pubnumber="29" sid="JDG 9:29" />ليتَ هذا الشَّعبَ في يَدي، فأعزِلَ أبيمالِكَ وأقولَ لَه: أعِدَّ جَيشَكَ واَخرُجْ لِلقِتالِ!“<verse eid="JDG 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" pubnumber="30" sid="JDG 9:30" />وسَمِعَ زَبولُ والي المدينةِ بِكلامِ جعَلَ بنِ عابِدٍ، فاَشْتَدَّ غضَبُهُ <verse eid="JDG 9:30" /><verse number="31" style="v" pubnumber="31" sid="JDG 9:31" />وأرسَلَ في السِّرِّ إلى أبيمالِكَ يقولُ لَه: ”جعَلُ بنُ عابِدٍ وإخوتُهُ جاؤُوا شكيمَ، وهُم يُثيرونَ علَيكَ المدينةَ. <verse eid="JDG 9:31" /><verse number="32" style="v" pubnumber="32" sid="JDG 9:32" />فقُمْ أنتَ والّذينَ معَكَ ليلًا واَكمُنوا في البرِّيَّةِ، <verse eid="JDG 9:32" /><verse number="33" style="v" pubnumber="33" sid="JDG 9:33" />وباكِرًا في الصَّباحِ عِندَ طُلوعِ الشَّمسِ اَهجُمْ على المدينةِ، فيَخرُجَ هوَ وأصحابُهُ إليكَ فتَفعَلَ بِهِم ما تَقدِرُ علَيهِ“.<verse eid="JDG 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" pubnumber="34" sid="JDG 9:34" />فقامَ أبيمالِكُ والّذينَ معَهُ ليلًا وكمَنوا حَولَ شكيمَ في أربَعِ فِرَقٍ. <verse eid="JDG 9:34" /><verse number="35" style="v" pubnumber="35" sid="JDG 9:35" />فخَرجَ جعَلُ بنُ عابِدٍ وأقامَ عِندَ مَدخلِ المدينةِ، فوَثَبَ أبيمالِكُ والّذينَ معَهُ مِنَ المكمَنِ. <verse eid="JDG 9:35" /><verse number="36" style="v" pubnumber="36" sid="JDG 9:36" />ورآهم جعَلُ فقالَ لِزَبولَ: ”أرى كثيرينَ يَنزِلونَ مِن رؤُوسِ الجِبالِ“. فقالَ لَه زَبولُ: ”أنتَ تَرى ظِلَّ الجِبالِ فتَحسَبُهُ رجالًا“. <verse eid="JDG 9:36" /><verse number="37" style="v" pubnumber="37" sid="JDG 9:37" />فعادَ جعَلُ وقالَ: ”ها قومٌ نازِلون مِنْ أعالي الجِبالِ وفِرقَةٌ مُقبِلَةٌ مِنْ جِهَةِ بَلُّوطَةِ العَرَّافينَ“. <verse eid="JDG 9:37" /><verse number="38" style="v" pubnumber="38" sid="JDG 9:38" />فقالَ لَه زَبولُ: ”أينَ الآنَ كلامُكَ؟ أما كُنتَ تَقولُ: مَنْ هوَ أبيمالِكُ حتّى نَخدُمَهُ؟ هذا هوَ الشَّعبُ الّذي اَزْدَرَيتَهُ، فاَخرُجِ الآنَ إليهِ وقاتِلْهُ“. <verse eid="JDG 9:38" /><verse number="39" style="v" pubnumber="39" sid="JDG 9:39" />فخَرجَ جعَلُ قائِدًا أهلَ شكيمَ وحارَبَ أبيمالِكَ. <verse eid="JDG 9:39" /><verse number="40" style="v" pubnumber="40" sid="JDG 9:40" />فهَزمَهُ أبيمالِكُ، فهربَ مِنْ أمامِهِ وسقطَ جرحى كثيرونَ قَبلَ أنْ بَلغوا مدخَلَ المدينةِ. <verse eid="JDG 9:40" /><verse number="41" style="v" pubnumber="41" sid="JDG 9:41" />وأقامَ أبيمالِكُ في أرومَةَ، أمَّا زَبولُ فطَردَ جعَلَ وإخوتَهُ مِنْ شكيمَ.<verse eid="JDG 9:41" /></para>
  <para style="p">
    <verse number="42" style="v" pubnumber="42" sid="JDG 9:42" />وفي الغدِ خرجَ الشَّعبُ إلى البرِّيَّةِ، فعَلِمَ أبيمالِكُ بِذلِكَ. <verse eid="JDG 9:42" /><verse number="43" style="v" pubnumber="43" sid="JDG 9:43" />فأخَذَ رِجالَهُ وقَسَّمَهُم ثَلاثَ فِرَقٍ وكمَنَ لهُم في البرِّيَّةِ. وحينَ رأى الشَّعبَ خارِجينَ مِنَ المدينةِ، اَنقَضَّ علَيهِم. <verse eid="JDG 9:43" /><verse number="44" style="v" pubnumber="44" sid="JDG 9:44" />وتَقَدَّمَ أبيمالِكُ والفِرقَةُ الّتي معَهُ وتَمَركزوا عِندَ بابِ المدينةِ، وأمَّا الفِرقَتانِ الأخرَيانِ فهَجَمَتا على الّذينَ في البرِّيَّةِ وقَضَتا علَيهِم. <verse eid="JDG 9:44" /><verse number="45" style="v" pubnumber="45" sid="JDG 9:45" />وحارَبَ أبيمالِكُ المدينةَ ذلِكَ اليومَ كُلَّهُ واَحتَلَّها، وقتَلَ الّذينَ فيها، وهدَمَها وزَرَعها مِلْحًا.<verse eid="JDG 9:45" /></para>
  <para style="p">
    <verse number="46" style="v" pubnumber="46" sid="JDG 9:46" />فسَمِعَ بِالأمرِ أهلُ مَجدَلِ شكيمَ، فدَخَلوا جميعًا حِصنَ بَيتِ إيلِ بَريتَ. <verse eid="JDG 9:46" /><verse number="47" style="v" pubnumber="47" sid="JDG 9:47" />وعَلِمَ أبيمالِكُ بِوجودِهِم هُناكَ، <verse eid="JDG 9:47" /><verse number="48" style="v" pubnumber="48" sid="JDG 9:48" />فصَعِدَ إلى جبَلِ صَلْمونَ، هوَ والّذينَ معَهُ، وأخذَ فأسًا بَيدِهِ وقطَعَ غُصنًا مِنَ الشَّجَرِ وحمَلهُ على كَتِفِه وقالَ لِلَّذينَ معَهُ: ”تَفعلونَ سريعًا كما أفعَلُ“. <verse eid="JDG 9:48" /><verse number="49" style="v" pubnumber="49" sid="JDG 9:49" />فقَطعَ كُلُّ واحدٍ مِنهُم غُصنًا وتَبِعوا أبيمالِكَ وألقَوا الأغصانَ حَولَ الحُصنِ وأحرَقوهُ بِالنَّارِ، فماتَ أيضًا جميعُ أهلِ مَجدَلِ شكيمَ وكانوا نحوَ ألفِ رَجُلٍ وامرَأةٍ.<verse eid="JDG 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" pubnumber="50" sid="JDG 9:50" />ثُمَّ توَجَّهَ أبيمالِكُ إلى مدينةِ تاباصَ وحاصَرَها واَحتَلَّها. <verse eid="JDG 9:50" /><verse number="51" style="v" pubnumber="51" sid="JDG 9:51" />وكانَ في وسَطِ المدينةِ بُرجٌ مُحَصَّنٌ، فهَربَ إليهِ جميعُ الرِّجالِ والنِّساءِ، ومِنهُم زُعماءُ المدينةِ، وأغلَقوا وراءَهُمُ الأبوابَ وصَعِدوا إلى سَطحِ البُرجِ.<verse eid="JDG 9:51" /></para>
  <para style="p">
    <verse number="52" style="v" pubnumber="52" sid="JDG 9:52" />فزَحَفَ أبيمالِكُ على البُرجِ، فحاصَرَهُ وتَقَدَّمَ إلى مدخَلِهِ لِيَحرُقَهُ بِالنَّارِ، <verse eid="JDG 9:52" /><verse number="53" style="v" pubnumber="53" sid="JDG 9:53" />فألقَتِ اَمرَأةٌ حجَرًا كبيرًا على رأسِهِ فشَدَّخَت جُمجُمتَهُ. <verse eid="JDG 9:53" /><verse number="54" style="v" pubnumber="54" sid="JDG 9:54" />فدَعا في الحالِ حامِلَ سِلاحِهِ، وكانَ شابًّا، وأمرَهُ: ”إستَلَّ سَيفَكَ واَقْتُلْني لِئلَّا يُقالَ إنَّ اَمرَأةً قتَلتْهُ“. فطَعنَهُ الشَّابُّ بِالسَّيفِ فماتَ. <verse eid="JDG 9:54" /><verse number="55" style="v" pubnumber="55" sid="JDG 9:55" />فلمَّا رَأى رِجالُ بَني إِسرائيلَ أنَّ أبيمالِكَ ماتَ، عادَ كُلُّ واحدٍ مِنهُم إلى بَيتِهِ. <verse eid="JDG 9:55" /><verse number="56" style="v" pubnumber="56" sid="JDG 9:56" />ورَدَّ اللهُ على أبيمالِكَ الشَّرَّ الّذي صنَعَ بِأبيهِ حينَ قتَلَ إخوتهُ السَّبعينَ. <verse eid="JDG 9:56" /><verse number="57" style="v" pubnumber="57" sid="JDG 9:57" />وكذلِكَ ردَّ اللهُ الشَّرَّ الّذي صنَعَهُ أهلُ شكيمَ على رؤُوسِهِم، وتَمَّت علَيهِم لَعنةُ يوتامَ بنِ يَربَّعَلَ.<verse eid="JDG 9:57" /></para>
  <chapter eid="JDG 9" />
  <chapter number="10" style="c" sid="JDG 10" />
  <para style="s1">القاضيان: تولع ويائير</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JDG 10:1" />وقامَ بَعدَ أبيمالِكَ لِخَلاصِ بَني إسرائيلَ تُولَعُ بنُ فواةَ بنِ دودو، وهوَ رَجُلٌ مِنْ يسَّاكرَ وكانَ مُقيمًا بِشاميرَ في جبَلِ أفرايمَ. <verse eid="JDG 10:1" /><verse number="2" style="v" pubnumber="2" sid="JDG 10:2" />فتَولَّى القضاءَ لِبَني إِسرائيلَ ثَلاثًا وعِشرينَ سنَةً، وماتَ ودُفِنَ في شاميرَ.<verse eid="JDG 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="JDG 10:3" />وقامَ بَعدَهُ يائيرُ الجِلعاديُّ، فتَولَّى القضاءَ لِبَني إِسرائيلَ اَثنَتينِ وعِشرينَ سنَةً. <verse eid="JDG 10:3" /><verse number="4" style="v" pubnumber="4" sid="JDG 10:4" />وكانَ لَه ثَلاثونَ اَبنًا يركبونَ ثَلاثينَ جَحْشًا، وكانَ لهُم ثَلاثونَ مدينةً تُسَمَّى مَزارِعَ يائيرَ إلى هذا اليومِ، وهيَ في أرضِ جِلعادَ. <verse eid="JDG 10:4" /><verse number="5" style="v" pubnumber="5" sid="JDG 10:5" />وماتَ يائيرُ ودُفِنَ في قامونَ.<verse eid="JDG 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="JDG 10:6" />وعادَ بَنو إسرائيلَ وعَمِلوا الشَّرَّ في عينَيِّ الرّبِّ، وعبَدوا البَعلَ وعشتَروتَ وآلِهةَ آرامَ وصَيدونَ وموآبَ وبَني عَمُّونَ والفِلسطيِّينَ وتَركوا الرّبَّ ولم يَعبُدوهُ. <verse eid="JDG 10:6" /><verse number="7" style="v" pubnumber="7" sid="JDG 10:7" />فاَشْتَدَّ غضَبُ الرّبِّ علَيهِم، فرَماهُم في أيدي الفِلسطيِّينَ وبَني عَمُّونَ. <verse eid="JDG 10:7" /><verse number="8" style="v" pubnumber="8" sid="JDG 10:8" />فظَلَموهُم وقهَروهُم مِنْ تِلكَ السَّنةِ إلى مُدَّةِ ثماني عَشْرةَ سنَةً، ظَلَموا وقهَروا جميعَ بَني إِسرائيلَ المُقيمينَ في شرقيِّ الأردُنِّ، في أرضِ الأموريِّينَ الّتي في جِلعادَ. <verse eid="JDG 10:8" /><verse number="9" style="v" pubnumber="9" sid="JDG 10:9" />وعبَرَ بَنو عَمُّونَ الأردُنَّ لِيُحارِبوا أيضًا بَني يَهوذا وبَني بنيامينَ وبَيتَ أفرايمَ، وكانَ ضيقٌ عظيمٌ على بَني إِسرائيلَ. <verse eid="JDG 10:9" /><verse number="10" style="v" pubnumber="10" sid="JDG 10:10" />فصَرخوا إلى الرّبِّ وقالوا: ”خَطِئْنا إليكَ وتَركناكَ يا إلهَنا وعَبدْنا البَعلَ“. <verse eid="JDG 10:10" /><verse number="11" style="v" pubnumber="11" sid="JDG 10:11" />فقالَ لهُمُ الرّبُّ: ”أما خَلَّصْتُكُم مِنَ المِصريِّينَ والأموريِّينَ وبَني عَمُّونَ والفِلسطيِّينَ؟ <verse eid="JDG 10:11" /><verse number="12" style="v" pubnumber="12" sid="JDG 10:12" />أما ضايَقكُمُ الصَّيدونيُّونَ والعَماليقيُّونَ والعَمُّونيُّونَ، فصَرختُم إليَّ فخَلَّصتُكُم مِنْ أيديهِم؟ <verse eid="JDG 10:12" /><verse number="13" style="v" pubnumber="13" sid="JDG 10:13" />ورُغمَ هذا تَركتُموني وعَبدْتُم آلهةً غريبةً، فلِذلِكَ لا أعودُ أخَلِّصُكُم أيضًا. <verse eid="JDG 10:13" /><verse number="14" style="v" pubnumber="14" sid="JDG 10:14" />إذْهَبوا واَسْتَغيثوا بالآلهةِ الّتي اَختَرتُموها، فلتُخَلِّصكُم هيَ مِنْ ضيقِكُم“. <verse eid="JDG 10:14" /><verse number="15" style="v" pubnumber="15" sid="JDG 10:15" />فقالوا لَه: ”خَطِئنا فاَفعَلْ بِنا كُلَّ ما يَحسُنُ في عينَيكَ، لكِنْ أنقِذْنا هذِهِ المرَّةَ“. <verse eid="JDG 10:15" /><verse number="16" style="v" pubnumber="16" sid="JDG 10:16" />وأزالوا الآلهةَ الغريبةَ مِنْ بَينِهِم وعبدوا الرّبَّ، فرَقَّ قلبُهُ لِبُؤسِهِم.<verse eid="JDG 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="JDG 10:17" />واَجتمَعَ بَنو عَمُّونَ وخيَّموا بِجِلعادَ، واَجتمَعَ بَنو إِسرائيلَ وخيَّموا بِالمِصفاةِ. <verse eid="JDG 10:17" /><verse number="18" style="v" pubnumber="18" sid="JDG 10:18" />فقالَ شُيوخُ جِلعادَ بَعضُهُم لِبعضٍ: ”مَنْ يَبدَأُ الحربَ على بَني عَمُّونَ يكونُ رئيسًا على سُكَّانِ جِلعادَ كُلِّهِم“.<verse eid="JDG 10:18" /></para>
  <chapter eid="JDG 10" />
  <chapter number="11" style="c" sid="JDG 11" />
  <para style="s1">يفتاح الجلعادي</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JDG 11:1" />وكانَ يَفتاحُ الجِلعاديُّ رَجُلًا جبَّارًا، وهوَ اَبنُ اَمرأةٍ بَغيٍّ ولَدتْهُ لِجِلعادَ. <verse eid="JDG 11:1" /><verse number="2" style="v" pubnumber="2" sid="JDG 11:2" />ثُمَّ وَلَدت لَه زَوجتُهُ بَنينَ، فلمَّا كبُروا طَرَدوا يَفتاحَ وقالوا لَه: ”لا ميراثَ لكَ في بَيتِ أبينا، لأنَّكَ اَبنُ اَمرأةٍ غريبةٍ“.<verse eid="JDG 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="JDG 11:3" />فهَربَ يَفتاحُ مِنْ أمامِ إخوتِهِ وأقامَ بأرضِ طُوبٍ، فاَنضَمَّ إليهِ قومٌ بَطَّالونَ، وكانوا يَخرُجونَ معَهُ لِلغَزوِ.<verse eid="JDG 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="JDG 11:4" />وبَعدَ زمَنٍ حارَبَ بَنو عَمُّونَ بَني إسرائيلَ، <verse eid="JDG 11:4" /><verse number="5" style="v" pubnumber="5" sid="JDG 11:5" />فذَهبَ شُيوخُ جِلعادَ لِيأتوا بِيَفتاحَ مِنْ أرضِ طُوبٍ، <verse eid="JDG 11:5" /><verse number="6" style="v" pubnumber="6" sid="JDG 11:6" />وقالوا لَه: ”كُنْ لنا قائدًا، فنُحارِبَ بَني عَمُّونَ“. <verse eid="JDG 11:6" /><verse number="7" style="v" pubnumber="7" sid="JDG 11:7" />فأجابَهُم يَفتاحُ: ”ألم تُبغِضوني وتَطرُدوني مِنْ بَيتِ أبي، فكيفَ جِئتُم إليَّ الآنَ في ضيقَتِكُم؟“ <verse eid="JDG 11:7" /><verse number="8" style="v" pubnumber="8" sid="JDG 11:8" />فقالوا لَه: ”جِئناكَ حتّى تقودَنا وتُحارِبَ بَني عَمُّونَ وتكونَ رئيسًا علَينا وعلى جميعِ سُكَّانِ جِلْعادَ“. <verse eid="JDG 11:8" /><verse number="9" style="v" pubnumber="9" sid="JDG 11:9" />فقالَ لهُم: ”إذا أرجَعتُموني لِمُحارَبةِ بَني عَمُّونَ وغلَبتُهُم بِمَعونةِ الرّبِّ فهل أصيرُ رئيسًا علَيكُم؟“ <verse eid="JDG 11:9" /><verse number="10" style="v" pubnumber="10" sid="JDG 11:10" />فأجابوا: ”ليكُنِ الرّبُّ شاهِدًا بَينَنا إذا كُنّا لا نفعلُ ما تقولُ“. <verse eid="JDG 11:10" /><verse number="11" style="v" pubnumber="11" sid="JDG 11:11" />فمَضى يَفتاحُ معَ شُيوخِ جِلعادَ. وأقامَهُ الشَّعبُ علَيهِم رئيسًا وقائدًا، فثبَّتَ أمامَ الرّبِّ في المِصفاةِ الاتِّفاقَ الّذي قطَعَهُ لِلشُّيوخِ.<verse eid="JDG 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="JDG 11:12" />وأرسلَ يَفتاحُ رُسُلًا إلى مَلِكِ بَني عَمُّونَ قائلًا: ”ما لي ولكَ. أنتَ جِئْتَني لِلحربِ في أرضي“. <verse eid="JDG 11:12" /><verse number="13" style="v" pubnumber="13" sid="JDG 11:13" />فأجابَهُ: ”جِئتُ إلى هُنا لأنَّ بَني إسرائيلَ، حينَ صَعِدوا مِنْ مِصْرَ، أخذوا أرضي، مِنْ أرنونَ إلى اليبُّوقِ إلى الأردُنِّ، فرُدُّوها الآنَ تسلَموا“. <verse eid="JDG 11:13" /><verse number="14" style="v" pubnumber="14" sid="JDG 11:14" />فعادَ يَفتاحُ أيضًا وأرسلَ إليهِ رُسُلًا، <verse eid="JDG 11:14" /><verse number="15" style="v" pubnumber="15" sid="JDG 11:15" />وقالَ لَه: ”هكذا يقولُ يَفتاحُ: لم يأخُذْ بَنو إِسرائيلَ أرضَ موآبَ ولا أرضَ بَني عَمُّونَ، <verse eid="JDG 11:15" /><verse number="16" style="v" pubnumber="16" sid="JDG 11:16" />لأنَّهُم حينَ صَعِدوا مِنْ مِصْرَ ساروا في البرِّيَّةِ إلى البحرِ الأحمرِ وجاؤُوا إلى قادِشَ. <verse eid="JDG 11:16" /><verse number="17" style="v" pubnumber="17" sid="JDG 11:17" />ثُمَّ أرسلوا رُسُلًا إلى مَلِكِ أدومَ يقولونَ: دَعْنا نعبُرُ في أرضِكَ، فرفَضَ فأرسلوا إلى مَلِكِ موآبَ أيضًا يَسألونَهُ، فرفَضَ. فأقاموا في قادِشَ. <verse eid="JDG 11:17" /><verse number="18" style="v" pubnumber="18" sid="JDG 11:18" />ثمَّ ساروا في البرِّيَّةِ وداروا حَولَ أرضِ أدومَ وأرضِ موآبَ وأتَوا أرضَ موآبَ مِنْ جِهَةِ الشَّرقِ وأقاموا في الجانبِ الآخَرِ لِنَهرِ أرنونَ، ولم يَدخُلوا أرضَ موآبَ لأنَّ أرنونَ على حُدودِ موآبَ. <verse eid="JDG 11:18" /><verse number="19" style="v" pubnumber="19" sid="JDG 11:19" />ثُمَّ أرسَلوا رُسُلًا إلى سيحونَ مَلِكِ الأموريِّينَ في حشبونَ يقولونَ لَه: دَعْنا نَعبُرُ في أرضِكَ إلى أرضِنا، <verse eid="JDG 11:19" /><verse number="20" style="v" pubnumber="20" sid="JDG 11:20" />فلم يَثِقْ بِهِم ويَدَعْهُم يَعبُرونَ في أرضِهِ وجمعَ كُلَّ شعبِهِ وخيَّموا في ياهَصَ وحارَبوهُم. <verse eid="JDG 11:20" /><verse number="21" style="v" pubnumber="21" sid="JDG 11:21" />فدَفعَ الرّبُّ إلهُ إِسرائيلَ سيحونَ وكُلَّ شعبِهِ إلى أيدي إِسرائيلَ، فهَزموهُم واَمتَلكوا أرضَ الأموريِّينَ وسُكَّانَها. <verse eid="JDG 11:21" /><verse number="22" style="v" pubnumber="22" sid="JDG 11:22" />واَمتَلكوا جميعَ أراضي الأموريِّينَ مِنْ أرنونَ إلى اليبُّوقِ، ومِنَ البرِّيَّةِ إلى الأردُنِّ. <verse eid="JDG 11:22" /><verse number="23" style="v" pubnumber="23" sid="JDG 11:23" />والآنَ إذا كانَ الرّبُّ إلهُ إِسرائيلَ طرَدَ الأموريِّينَ مِنْ أمامِ شعبِهِ بَني إِسرائيلَ فكيفَ تُريدُ أنْ تَملِكَ مِنَ الأرضِ ما أنتَ تَملِكُهُ؟ <verse eid="JDG 11:23" /><verse number="24" style="v" pubnumber="24" sid="JDG 11:24" />لكَ أنْ تَملِكَ ما أعطاكَ إيَّاهُ كَمُّوشُ إلهُكَ، ونحنُ نَملِكُ أرضَ الّذينَ طرَدهُمُ الرّبُّ إلهُنا مِنْ أمامِنا. <verse eid="JDG 11:24" /><verse number="25" style="v" pubnumber="25" sid="JDG 11:25" />هل أنتَ خَيرٌ مِنْ بالاقَ بنِ صَفُّورَ مَلِكِ موآبَ الّذي لم يُخاصِمْ بَني إِسرائيلَ ولا أثارَ علَيهِم حربًا؟ <verse eid="JDG 11:25" /><verse number="26" style="v" pubnumber="26" sid="JDG 11:26" />وعِنْدما أقامَ بَنو إِسرائيلَ في حَشبونَ وتَوابِعِها وعَروعيرَ وتَوابِعِها وجميعِ المُدُنِ الّتي عِندَ أرنونَ مُدَّةَ ثَلاثِ مئةِ سنَةٍ، لِماذا لم تَستَرجِعوها في تِلكَ المُدَّةِ؟ <verse eid="JDG 11:26" /><verse number="27" style="v" pubnumber="27" sid="JDG 11:27" />أنا لم أُسئْ إليكَ، وإنَّما أنتَ تُناصِبُني الشَّرَّ فتُحارِبُني، فليَقْضِ اليومَ الرّبُّ الديَّانُ بَينَ بَني إِسرائيلَ وبَني عَمُّونَ“. <verse eid="JDG 11:27" /><verse number="28" style="v" pubnumber="28" sid="JDG 11:28" />فلم يسمَعْ مَلِكُ بَني عَمُّونَ لِهذا الكلامِ.<verse eid="JDG 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="JDG 11:29" />وحَلَّ روحُ الرّبِّ على يَفتاحَ فعبَر أرضَ جِلْعادَ وأرضَ منَسَّى إلى مِصفاةِ جِلعادَ ومِنها إلى بَني عَمُّونَ. <verse eid="JDG 11:29" /><verse number="30" style="v" pubnumber="30" sid="JDG 11:30" />ونذَرَ يَفتاحُ نَذْرًا للرّبِّ وقالَ: ”إنْ سَلَّمتَ بَني عَمُّونَ إلى يَدي، <verse eid="JDG 11:30" /><verse number="31" style="v" pubnumber="31" sid="JDG 11:31" />فكُلُّ خارجٍ مِنْ بابِ بَيتي لِلقائي حينَ رُجوعي سالِمًا مِنْ عِندِ بَني عَمُّونَ أُكرِّسُهُ، وأقدِّمُهُ مُحرقَةً للهِ“. <verse eid="JDG 11:31" /><verse number="32" style="v" pubnumber="32" sid="JDG 11:32" />وعبَرَ يَفتاحُ إلى بَني عَمُّونَ لِيُحارِبَهُم، فسلَّمَهُمُ الرّبُّ إلى يَدِهِ، <verse eid="JDG 11:32" /><verse number="33" style="v" pubnumber="33" sid="JDG 11:33" />فضَربَهُم ضَربةً عظيمةً مِنْ عَروعيرَ إلى جِوارِ مَنِّيتَ، عِشرينَ مدينةً، وإلى آبَلِ كراميمَ، واَنْهَزَمَ بَنو عَمُّونَ أمامَ بَني إِسرائيلَ.<verse eid="JDG 11:33" /></para>
  <para style="p">
    <verse number="34" style="v" pubnumber="34" sid="JDG 11:34" />وعادَ يَفتاحُ إلى بَيتِهِ في المِصفاةِ، فإذا اَبنَتُهُ خارِجةٌ لِلقائِهِ بالدُّفوفِ والرَّقصِ، وهيَ وحيدةٌ لَه إذ لم يكُنْ لَه اَبنٌ أوِ اَبنَةٌ سِواها. <verse eid="JDG 11:34" /><verse number="35" style="v" pubnumber="35" sid="JDG 11:35" />فلمَّا رَآها مَزَّقَ ثيابَهُ وقالَ: ”آهِ يا اَبنَتي! جلَبتِ عليَّ الحُزنَ الشَّديدَ وصِرتِ مَصدرًا لِتَعاسَتي، لأنِّي نَذرْتُ نَذْرًا للرّبِّ، ولا سَبيلَ إلى الرُّجوعِ عَنهُ“. <verse eid="JDG 11:35" /><verse number="36" style="v" pubnumber="36" sid="JDG 11:36" />فقالَت لَه: ”يا أبي، إنْ كُنتَ نَذَرتَ نَذْرًا للرّبِّ فاَصنَعْ بي ما وَعَدتَ بهِ، بَعدَما اَنتَقَمَ لكَ الرّبُّ مِنْ أعدائِكَ بَني عَمُّونَ“. <verse eid="JDG 11:36" /><verse number="37" style="v" pubnumber="37" sid="JDG 11:37" />ثُمَّ قالَت لأبيها: ”لي هذِهِ الأُمنيَةُ: أمهِلْني شهرَينِ فأذهَبَ إلى الجِبالِ وأبكي بُتوليَّتي أنا ورَفيقاتي“. <verse eid="JDG 11:37" /><verse number="38" style="v" pubnumber="38" sid="JDG 11:38" />فقالَ لها: ”إذهَبي“. وأرسلَها شهرَينِ، فذهَبَت هيَ ورَفيقاتُها وبكَت بُتوليَّتَها على الجِبالِ. <verse eid="JDG 11:38" /><verse number="39" style="v" pubnumber="39" sid="JDG 11:39" />وعِندَ نِهايةِ الشَّهرَينِ رَجَعَت إلى أبيها، فأتَمَّ بِها النَّذرَ الّذي نَذَرهُ، وهيَ لم تَعرِفْ رَجُلًا. فصارَت عادةً بَينَ بَني إِسرائيلَ <verse eid="JDG 11:39" /><verse number="40" style="v" pubnumber="40" sid="JDG 11:40" />أنَّ بَناتِهِم يذهَبنَ ويَنُحنَ على اَبنةِ يَفتاحَ الجِلعاديِّ أربعةَ أيّامٍ في السَّنةِ.<verse eid="JDG 11:40" /></para>
  <chapter eid="JDG 11" />
  <chapter number="12" style="c" sid="JDG 12" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JDG 12:1" />واَجتمَعَ رِجالُ أفرايمَ وعبَروا إلى صافونَ وقالوا ليَفتاحَ: ”لِماذا ذهبْتَ لِمُحاربةِ بَني عَمُّونَ وما دَعوتَنا لِنَذهبَ معَكَ؟ سَنَحرُقُ علَيكَ بَيتَكَ بالنَّارِ“. <verse eid="JDG 12:1" /><verse number="2" style="v" pubnumber="2" sid="JDG 12:2" />فقالَ لهُم يَفتاحُ: ”كانَ لي ولِشعبي خِصامٌ شديدٌ معَ بَني عَمُّونَ، ودَعوتُكُم فلم تُخَلِّصوني مِنْ أيديهِم. <verse eid="JDG 12:2" /><verse number="3" style="v" pubnumber="3" sid="JDG 12:3" />وحينَ رأيتُ أنَّكُم لم تُخَلِّصوني خاطَرتُ بِروحي وعَبرْتُ إلى بَني عَمُّونَ، فسلَّمَهُمُ الرّبُّ إلى يدي. فلِماذا جِئتُم إليَّ لِتُحارِبوني اليومَ؟“<verse eid="JDG 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="JDG 12:4" />وجمَعَ يَفتاحُ رِجالَ جِلعادَ، فحارَبَ بَني أفرايمَ وهزَمَهُم لأنَّ بَني أفرايمَ قالوا: ”أنتُمُ الجِلعاديُّونَ كُنتُم وسَطَ أفرايمَ ومنَسَّى، وما أنتُم هُنا إلَّا لأنَّكُم هَربتُم مِنْ أفرايمَ“. <verse eid="JDG 12:4" /><verse number="5" style="v" pubnumber="5" sid="JDG 12:5" />فقَطَعَ الجِلعاديُّونَ على بَني أفرايمَ مَعابِرَ الأردُنِّ، فكانَ إذا أحدُ الهارِبينَ مِنْ بَني أفرايمَ قالَ: ”دَعوني أعبُرُ“، يسألُهُ الجِلعاديُّونَ: ”أمِنْ أفرايمَ أنتَ؟“ فيُجيبُ: ”لا“. <verse eid="JDG 12:5" /><verse number="6" style="v" pubnumber="6" sid="JDG 12:6" />فيقولونَ لَه: ”إذًا قُلْ شِبُّولَتْ“ فيقولُ: ”سِبُّولَتْ“، غيرَ مُنتَبِهٍ إلى صِحَّةِ لَفظِها فيَقبِضونَ علَيهِ ويذبَحونَهُ على معابِرِ الأردُنِّ. فقَتلوا في ذلِكَ الوقتِ مِنْ أفرايمَ اَثنَينِ وأربعينَ ألفًا.<verse eid="JDG 12:6" /></para>
  <para style="s1">القضاة: إبصان، وإيلون وعبدون</para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="JDG 12:7" />وتَولَّى يَفتاحُ القضاءَ على إِسرائيلَ ستَّ سِنينَ، وماتَ ودُفِنَ في مَسقطِ رأسِهِ. <verse eid="JDG 12:7" /><verse number="8" style="v" pubnumber="8" sid="JDG 12:8" />وتَولَّى القضاءَ بَعدَهُ إبصانُ مِنْ بَيتَ لَحمَ. <verse eid="JDG 12:8" /><verse number="9" style="v" pubnumber="9" sid="JDG 12:9" />وكانَ لَه ثَلاثونَ اَبنًا وثَلاثونَ اَبنَةً، فزوَّجَ بَناتِهِ الثَّلاثينَ وأدخَلَ ثَلاثينَ كَنَّةً لِبَنيهِ. وكانَت مُدَّةُ قضائِهِ على إِسرائيلَ سَبعَ سِنينَ. <verse eid="JDG 12:9" /><verse number="10" style="v" pubnumber="10" sid="JDG 12:10" />وماتَ إبصانُ ودُفِنَ في بيتَ لَحمَ.<verse eid="JDG 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JDG 12:11" />فتولَّى القضاءَ على إِسرائيلَ بَعدَهُ إيلونُ الزَّبولونيُّ. وكانَت مُدَّةُ قضائِهِ عشْرَ سِنينَ، <verse eid="JDG 12:11" /><verse number="12" style="v" pubnumber="12" sid="JDG 12:12" />وماتَ ودُفِنَ في إيلونَ في أرضِ زَبولونَ.<verse eid="JDG 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="JDG 12:13" />فتَولَّى القضاءَ بَعدَهُ عَبدونُ بنُ هِلِّيلَ الفِرعَتونيُّ. <verse eid="JDG 12:13" /><verse number="14" style="v" pubnumber="14" sid="JDG 12:14" />وكانَ لَه أربعونَ اَبنًا وثَلاثونَ حفيدًا، وكانوا يَملِكونَ سَبعينَ جَحشًا. وكانَت مُدَّةُ قضائِهِ على إِسرائيلَ ثمانيَ سِنينَ، <verse eid="JDG 12:14" /><verse number="15" style="v" pubnumber="15" sid="JDG 12:15" />وماتَ ودُفِنَ في فِرعَتونَ، في أرضِ أفرايمَ، في جبَلِ بَني عَماليقَ.<verse eid="JDG 12:15" /></para>
  <chapter eid="JDG 12" />
  <chapter number="13" style="c" sid="JDG 13" />
  <para style="s1">ولادة شمشون</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JDG 13:1" />وعادَ بَنو إِسرائيلَ وعَمِلوا الشَّرَّ في عينَي الرّبِّ، فسَلَّمَهُمُ الرّبُّ إلى أيدي الفِلسطيِّينَ أربعينَ سنَةً.<verse eid="JDG 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="JDG 13:2" />وكانَ رَجُلٌ مِنْ صَرْعةَ، مِنْ قبيلةِ دانَ اَسمُهُ مَنوحُ، وكانَتِ اَمرأتُهُ عاقِرًا. <verse eid="JDG 13:2" /><verse number="3" style="v" pubnumber="3" sid="JDG 13:3" />فتراءَى ملاكُ الرّبِّ للمرأةِ وقالَ لها: ”أنتِ عاقِرٌ، لكنَّكِ سَتَحمِلينَ وتَلِدينَ اَبنًا. <verse eid="JDG 13:3" /><verse number="4" style="v" pubnumber="4" sid="JDG 13:4" />والآنَ فاَنتَبِهي لا تشربي خمرًا ولا مُسكِرًا ولا تأكُلي شيئًا حَرَّمَتْهُ الشَّريعةُ، <verse eid="JDG 13:4" /><verse number="5" style="v" pubnumber="5" sid="JDG 13:5" />لأنَّكِ سَتَحمِلينَ وتَلِدينَ اَبنًا شَعرُهُ لا يُقَصُّ، لأنَّهُ يكونُ نَذيرًا للهِ مِنْ بَطنِ أمِّهِ، وهوَ يَبدأُ بِخلاصِ بَني إِسرائيلَ مِنْ أيدي الفِلسطيِّينَ“. <verse eid="JDG 13:5" /><verse number="6" style="v" pubnumber="6" sid="JDG 13:6" />فجاءتِ المَرأةُ وقالَت لِزَوجِها: ”جاءَني رَجُلٌ مَنظَرُهُ كمَنظَرِ ملاكِ اللهِ. مُرهِبٌ جِدًّا، فما سَألْتُهُ مِنْ أينَ هوَ، ولا هوَ أخبَرَني باَسمِهِ، <verse eid="JDG 13:6" /><verse number="7" style="v" pubnumber="7" sid="JDG 13:7" />وقالَ لي: سَتَحبَلينَ وتَلدينَ اَبنًا. والآنَ لا تشربي خمرًا ولا مُسكِرًا، ولا تأكُلي شيئًا حَرَّمَتْهُ الشَّريعةُ، لأنَّ الصَّبيَّ يكونُ نَذيرًا للهِ مِنْ بَطنِ أمِّهِ إلى يومِ وفاتِهِ“.<verse eid="JDG 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="JDG 13:8" />فصلَّى مَنوحُ إلى الرّبِّ وقالَ: ”أتوسَّلُ إليكَ ربِّي أنْ يعودَ رَجُلُ اللهِ الّذي أرسَلْتَهُ إلينا كي يُعلِمَنا ما نعمَلُ بالصَّبيِّ المَولودِ“. <verse eid="JDG 13:8" /><verse number="9" style="v" pubnumber="9" sid="JDG 13:9" />فسَمِعَ اللهُ دُعاءَ مَنوحَ، فجاءَ مَلاكُ اللهِ ثانيةً إلى المَرأةِ وهيَ في الحقلِ، ولم يكُن زَوجُها معَها. <verse eid="JDG 13:9" /><verse number="10" style="v" pubnumber="10" sid="JDG 13:10" />فجاءتِ المَرأةُ مُسرِعةً وأخبَرَت زوجَها وقالَت لَه: ”تَراءَى ليَ الرَّجُلُ الّذي أتاني في ذلِكَ اليومِ“. <verse eid="JDG 13:10" /><verse number="11" style="v" pubnumber="11" sid="JDG 13:11" />فقامَ مَنوحُ وتَبِعَ اَمرأتَهُ وجاءَ إلى الرَّجُلِ وسألَهُ: ”أأنتَ الرَّجُلُ الّذي تكَلَّمَ معَ اَمْرَأتي؟“ فأجابَ: ”أنا هوَ“. <verse eid="JDG 13:11" /><verse number="12" style="v" pubnumber="12" sid="JDG 13:12" />فقالَ مَنوحُ: ”والآنَ إذا تحَقَّقَ قولُكَ، فكيفَ يَجبُ أنْ نَتَصرَّفَ في أمرِ الصَّبيِّ؟ وماذا نعمَلُ بهِ؟“ <verse eid="JDG 13:12" /><verse number="13" style="v" pubnumber="13" sid="JDG 13:13" />فقالَ لَه ملاكُ الرّبِّ: ”لِتَمتَنعِ اَمرأتُكَ عَنْ جميعِ ما قُلتُ لها أنْ تَمتَنعَ عَنهُ: فلا تَذُقْ ما يَخرُجُ مِنَ الكرمةِ، ولا تشربْ خمرًا ومُسكِرًا، <verse eid="JDG 13:13" /><verse number="14" style="v" pubnumber="14" sid="JDG 13:14" />ولا تأكُلْ شيئًا حَرَّمَتْهُ الشَّريعةُ، بل لِتَعمَلْ بِكُلِّ ما أمرتُ بهِ“.<verse eid="JDG 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="JDG 13:15" />فقالَ مَنوحُ لِمَلاكِ الرّبِّ: ”دَعنا نُبقيكَ عِندَنا حتّى نُعِدَّ لكَ جَدْيًا مِنَ المعَزِ“. <verse eid="JDG 13:15" /><verse number="16" style="v" pubnumber="16" sid="JDG 13:16" />فقالَ لَه ملاكُ الرّبِّ: ”حتّى لو أبقَيتَني، فلا آكُلُ مِنْ خُبزِكَ، أمَّا إذا شِئتَ أنْ تُقَدِّمَ مُحرَقةً، فقَدِّمْها للرّبِّ“. ولم يكُن مَنوحُ يَعلمُ أنَّهُ ملاكُ الرّبِّ. <verse eid="JDG 13:16" /><verse number="17" style="v" pubnumber="17" sid="JDG 13:17" />فسألَهُ مَنوحُ: ”ما اَسمُكَ؟ حتّى إذا تَمَّ قولُكَ نُكرِمَكَ“. <verse eid="JDG 13:17" /><verse number="18" style="v" pubnumber="18" sid="JDG 13:18" />فأجابَه: ”لِماذا تسألُ عَنِ اَسمي واَسمي عجيبٌ؟“ <verse eid="JDG 13:18" /><verse number="19" style="v" pubnumber="19" sid="JDG 13:19" />فأخذَ مَنوحُ جَدْيَ المعَزِ والتَّقدِمةَ وقدَّمَها للرّبِّ على الصَّخرةِ، فعَمِلَ الملاكُ عملًا عجيبًا ومَنوحُ وزَوجَتُهُ يَنظرانِ. <verse eid="JDG 13:19" /><verse number="20" style="v" pubnumber="20" sid="JDG 13:20" />فكانَ عِندَ اَرتفاعِ اللَّهيبِ عَنِ المذبَحِ نحوَ السَّماءِ أنَّ ملاكَ الرّبِّ صَعِدَ في لَهيبِ المذبَحِ ومَنوحُ وزَوجَتُهُ يَنظرانِ فسقطا على وجهَيهِما إلى الأرضِ.<verse eid="JDG 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="JDG 13:21" />ولم يَعُدْ ملاكُ الرّبِّ يتَراءَى لِمَنوحَ وزَوجَتِهِ، فعَلِمَ مَنوحُ مِنْ ذلِكَ أنَّهُ ملاكُ الرّبِّ. <verse eid="JDG 13:21" /><verse number="22" style="v" pubnumber="22" sid="JDG 13:22" />فقالَ لاَمرأتِهِ: ”سَنموتُ لأنَّنا رأينا اللهَ“. <verse eid="JDG 13:22" /><verse number="23" style="v" pubnumber="23" sid="JDG 13:23" />فأجابَتْهُ: ”لو أنَّ الرّبَّ أرادَ أنْ يُميتَنا لما قَبِلَ مِنْ أيدينا مُحرَقةً وتَقدِمةً، ولا كانَ أرانا جميعَ ما رَأينا، ولما أسمَعَنا ما سَمعناهُ الآنَ“. <verse eid="JDG 13:23" /><verse number="24" style="v" pubnumber="24" sid="JDG 13:24" />ووَلَدتِ المَرأةُ اَبنًا وسَمَّتهُ شَمشونَ. وكبُرَ الصَّبيُّ وباركَهُ الرّبُّ. <verse eid="JDG 13:24" /><verse number="25" style="v" pubnumber="25" sid="JDG 13:25" />وحَلَّ روحُ الرّبِّ علَيهِ ومَلأَهُ قُوَّةً في مَحلَّةِ دانَ، بينَ صَرعَةَ وأشتَأُولَ.<verse eid="JDG 13:25" /></para>
  <chapter eid="JDG 13" />
  <chapter number="14" style="c" sid="JDG 14" />
  <para style="s1">أعمال شمشون الأولى</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JDG 14:1" />ونزَلَ شَمشونُ إلى تِمنَةَ، فرَأى هُناكَ اَمرأةً مِنْ بَناتِ الفِلسطيِّينَ <verse eid="JDG 14:1" /><verse number="2" style="v" pubnumber="2" sid="JDG 14:2" />فصَعِدَ وأخبَرَ أباهُ وأمَّهُ وقالَ: ”رأيتُ في تِمنَةَ اَمرَأةً مِنْ بَناتِ الفِلسطيِّينَ، فاَتَّخِذاها لي زَوجةً. <verse eid="JDG 14:2" /><verse number="3" style="v" pubnumber="3" sid="JDG 14:3" />فقالا لَه: ”أما في عَشيرَتِكَ وفي شعبِكَ كُلِّه اَمرَأةٌ، حتّى تذهَبَ وتتَزوَّجَ اَمرَأةً مِن غَيرِ المَختونينَ؟“ فقالَ شَمشونُ لأبيهِ: ”بل إيَّاها أريدُ، فهيَ وحدَها تُعجِبُني“.<verse eid="JDG 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="JDG 14:4" />ولم يعلَمْ أبوهُ وأمُّهُ أنَّ هذا كانَ مِنْ تدبيرِ الرّبِّ، وأنَّهُ الرّبُّ كانَ يُدَبِّرُ سبَبًا لِيُحارِبَ الفِلسطيِّينَ. وكانَ الفِلسطيُّونَ في ذلِكَ الوقتِ مُتَسلِّطينَ على بَني إِسرائيلَ.<verse eid="JDG 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="JDG 14:5" />فنزَلَ شَمشونُ وأبوهُ وأمُّهُ إلى تِمنَةَ، ولمَّا وصَلوا إلى كُرومِها زأرَ شِبلُ لَبوَةٍ في وجهِهِ. <verse eid="JDG 14:5" /><verse number="6" style="v" pubnumber="6" sid="JDG 14:6" />فحَلَّ علَيهِ روحُ الرّبِّ، ففَسخَهُ كما لو كانَ جَديًّا، وهذا دونَ أنْ يكونَ في يدِهِ شيءٌ، ولم يُخبِرْ أباهُ وأمَّهُ بِما فعَلَ. <verse eid="JDG 14:6" /><verse number="7" style="v" pubnumber="7" sid="JDG 14:7" />ثُمَّ اَستَمَرَّ في طريقِهِ، وحينَ كلَّمَ المَرأةَ أعجَبَتهُ. <verse eid="JDG 14:7" /><verse number="8" style="v" pubnumber="8" sid="JDG 14:8" />ورجَعَ بَعدَ أيّامٍ لِيَتَزوَّجَها، فحادَ لِيَرى جثَّةَ الأسدِ، فإذا في جَوفِ الأسدِ عسَلٌ وسِربٌ مِنَ النَّحلِ. <verse eid="JDG 14:8" /><verse number="9" style="v" pubnumber="9" sid="JDG 14:9" />فأخَذَ مِنهُ على كَفَّيهِ ومَضى وهوَ يأكُلُهُ، وجاءَ إلى أبيهِ وأمِّهِ وأعطاهُما مِنهُ فأكلا، ولم يُخبِرْهُما أنَّهُ أخذَ العسَلَ مِنْ جوفِ الأسدِ.<verse eid="JDG 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="JDG 14:10" />ونزَلَ أبوهُ إلى المَرأةِ الفِلسطيّةِ، وهُناكَ أقامَ شَمشونُ وليمةً كعادةِ جميعِ الفِتيانِ. <verse eid="JDG 14:10" /><verse number="11" style="v" pubnumber="11" sid="JDG 14:11" />فلمَّا رآهُ الفِلسطيُّونَ خافوا، فأحضَروا ثَلاثينَ رَجُلًا لِيُلازِموهُ. <verse eid="JDG 14:11" /><verse number="12" style="v" pubnumber="12" sid="JDG 14:12" />فقالَ لهُم شَمشونُ: ”سأُلقي علَيكُم لُغزًا، فإذا حَلَلتُموهُ لي في سبعةِ أيّامِ الوليمةِ وكشَفْتموهُ أعطَيتُكُم ثَلاثينَ قميصًا وثَلاثينَ حُلَّةً مِنَ الثِّيابِ. <verse eid="JDG 14:12" /><verse number="13" style="v" pubnumber="13" sid="JDG 14:13" />وإذا لم تَقدِروا تُعطونَني ثَلاثينَ قميصًا وثَلاثينَ حُلَّةً مِنَ الثِّيابِ“. فقالوا لَه: ”هاتِ لُغزَكَ لِنَسمَعَهُ“. <verse eid="JDG 14:13" /><verse number="14" style="v" pubnumber="14" sid="JDG 14:14" />فقالَ لهُم: ”خرَجَ مِنَ الآكِلِ أكْلٌ، ومِنَ القويِّ حَلاوةٌ“. ومَرَّت ثَلاثةُ أيّامٍ دونَ أنْ يَحُلُّوا اللُّغزَ.<verse eid="JDG 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="JDG 14:15" />فلمَّا كانَ اليومُ الرَّابعُ قالوا لاَمرَأةِ شَمشونَ: ”خادِعي زوجَكِ حتّى يَحُلَّ لَنا اللُّغزَ لِئلَّا نَحرُقَكِ معَ أهلِكِ بالنَّارِ. هل دَعَوتُمونا كي تَسلُبونا؟“ <verse eid="JDG 14:15" /><verse number="16" style="v" pubnumber="16" sid="JDG 14:16" />فَبكتِ اَمرَأةُ شَمشونَ لَديهِ وقالت: ”إنَّما أنتَ تُبغِضُني ولا تُحِبُّني، لأنَّك ألقَيتَ على بَني شعبي لُغزًا ولم تُطلِعْني علَيهِ“. فقالَ لها: ”لم أُطلعْ علَيهِ أبي وأمِّي، فكيفَ أطلِعُكِ أنتِ علَيهِ؟“ <verse eid="JDG 14:16" /><verse number="17" style="v" pubnumber="17" sid="JDG 14:17" />فَبكتْ لَديهِ سبعةَ أيّامِ الوليمةِ، فلمَّا كانَ اليومُ السَّابِعُ أطلَعَها علَيهِ بَعدَ أنْ ضايَقَتهُ كثيرًا، فأطلَعَت شعبَها على اللُّغزِ. <verse eid="JDG 14:17" /><verse number="18" style="v" pubnumber="18" sid="JDG 14:18" />ففي اليومِ السَّابِعِ، وقَبلَ غُروبِ الشَّمسِ، قالَ رِجالُ المدينةِ لِشَمشونَ: ”أيُّ شيءٍ أحلى مِنَ العسَلِ، وأيُّ شيءٍ أقوى مِنَ الأسدِ؟“ فقالَ لهُم شَمشونُ: ”لولا أنَّكُم حرَثتُم على عِجلَتي لم تكشِفوا لُغزي“. <verse eid="JDG 14:18" /><verse number="19" style="v" pubnumber="19" sid="JDG 14:19" />وحَلَّ علَيهِ روحُ الرّبِّ، فنَزلَ إلى أشقَلونَ وقتَلَ مِنَ الفِلسطيِّينَ ثَلاثيَن رَجُلًا، وأخَذَ ثيابَهُم وأعطى الحُلَلَ لِكاشِفي اللُّغزِ. وبَعدَ ذلِكَ عادَ إلى بَيتِ أبيهِ غاضِبًا مِمَّا حدَثَ. <verse eid="JDG 14:19" /><verse number="20" style="v" pubnumber="20" sid="JDG 14:20" />وصارَت امرَأتُهُ زوجةً لِرَفيقهِ الّذي كانَ يُصاحبُهُ.<verse eid="JDG 14:20" /></para>
  <chapter eid="JDG 14" />
  <chapter number="15" style="c" sid="JDG 15" />
  <para style="s1">إنتقام شمشون</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JDG 15:1" />وبَعدَ أيّامٍ زارَ شَمشونُ اَمرأتَهُ في وقتِ الحصادِ وحمَلَ إليها جَديًا مِنَ المعَزِ، وقالَ لأبيها: ”أريدُ أنْ أدخُلَ على اَمرأتي في غُرفَتِها“. لكِنَّ أباها منَعَهُ مِنْ ذلِكَ وقالَ لَه: <verse eid="JDG 15:1" /><verse number="2" style="v" pubnumber="2" sid="JDG 15:2" />”قُلتَ إنَّكَ أبغَضتَها فزَوَّجتُها مِنْ صاحبِكَ، لكِنْ هذِهِ أختُها الصُّغرى أحسَنُ مِنها، فلتكُن لكَ بدَلًا مِنها“. <verse eid="JDG 15:2" /><verse number="3" style="v" pubnumber="3" sid="JDG 15:3" />فقالَ شَمشونُ: ”أنا بَريءٌ الآنَ مِنَ الفِلسطيِّينَ إذا أنزَلْتُ بِهِم شَرًّا“. <verse eid="JDG 15:3" /><verse number="4" style="v" pubnumber="4" sid="JDG 15:4" />وذهَبَ واَصطادَ ثَلاثَ مِئَةِ ثَعلبٍ وربَطَها ذَنَبًا إلى ذَنَبٍ، وأخَذَ مَشاعِلَ ووضَعَ بينَ كُلِّ ذَنَبينِ مِشعَلًا. <verse eid="JDG 15:4" /><verse number="5" style="v" pubnumber="5" sid="JDG 15:5" />وأوقَدَ المَشاعِلَ وأرسلَها في زَرعِ الفِلسطيِّينَ، فأحرَقتِ الأكداسَ والزَّرعَ حتّى الزَّيتونَ. <verse eid="JDG 15:5" /><verse number="6" style="v" pubnumber="6" sid="JDG 15:6" />فسألَ الفِلسطيُّونَ: ”مَنْ فعَلَ هذا؟“ فكانَ الجَوابُ: ”شَمشونُ صِهرُ الرَّجُلِ الّذي مِنْ تِمنَةَ، لأنَّ هذا الرَّجُلَ أخذَ زوجَةَ شَمشونَ وأعطاها لِصاحبِهِ“. فاَجتمَعَ الفِلسطيُّونَ وأحرَقوا المَرأةَ وأباها بالنَّار. <verse eid="JDG 15:6" /><verse number="7" style="v" pubnumber="7" sid="JDG 15:7" />فقالَ لهُم شَمشونُ: ”حتّى لو فعَلتُم هذا، فأنا لن أكُفَّ عَنكُم حتّى أنتَقِمَ مِنكُم“. <verse eid="JDG 15:7" /><verse number="8" style="v" pubnumber="8" sid="JDG 15:8" />فهاجَمَهُم بِعُنفٍ، وأنزَلَ بِهِمِ الهزيمةَ، ثمَّ نَزَلَ وأقامَ بِمَغارةٍ في سَلْعِ عَيطَمَ.<verse eid="JDG 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="JDG 15:9" />فصَعِدَ الفِلسطيُّونَ وخيَّموا في أرضِ يَهوذا وهجَموا على لَحيٍ. <verse eid="JDG 15:9" /><verse number="10" style="v" pubnumber="10" sid="JDG 15:10" />فسألَهُم رِجالُ يَهوذا: ”لِماذا صَعِدْتُم لِمُحاربَتِنا؟“ فأجابوهُم: ”صَعِدْنا لِنَقبِضَ على شَمشونَ ونفعَلَ بهِ كما فعَلَ بِنا“. <verse eid="JDG 15:10" /><verse number="11" style="v" pubnumber="11" sid="JDG 15:11" />فنزَلَ ثَلاثَةُ آلافِ رَجُلٍ مِنْ يَهوذا وجاؤُوا إلى مَغارةِ سَلْعِ عَيطَمَ وقالوا لِشَمشونَ: ”ألا تَعلَمُ أنَّ الفِلسطيِّينَ يتَسلَّطونَ علَينا، فلِماذا فعَلتَ بِنا ما فعَلتَ؟“ فأجابَ: ”كما فعَلوا بي فعَلتُ بِهِم“. <verse eid="JDG 15:11" /><verse number="12" style="v" pubnumber="12" sid="JDG 15:12" />فقالوا لَه: ”جِئنا لِنَقبِضَ علَيكَ ونُسَلِّمَكَ إلى أيديهِم“. فقالَ لهُم: ”إحلِفوا لي أنَّكُم لَنْ تقتُلوني“. <verse eid="JDG 15:12" /><verse number="13" style="v" pubnumber="13" sid="JDG 15:13" />فقالوا لَه: ”لن نَقتُلَكَ، لكِنْ نَقبِضُ علَيكَ ونُسَلِّمُكَ إلى أيديهِم“. فأوثَقوهُ بِحَبلَينِ جديدَينِ وأصعَدوهُ مِنْ مَغارةِ سَلْعِ عَيطَمَ.<verse eid="JDG 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="JDG 15:14" />ولمَّا وصَلَ إلى لَحيٍ قابَلَهُ الفِلسطيُّونَ بِالصِّياحِ، فحَلَّ علَيهِ روحُ الرّبِّ فذابَ الحَبلانِ اللَّذانِ على ذِراعَيهِ كما لو كانَت خُيوطُ شَمْعٍ اَشتَعَلَت فيها النَّارُ، فاَنحَلَّ الوِثاقُ عَنْ يديهِ. <verse eid="JDG 15:14" /><verse number="15" style="v" pubnumber="15" sid="JDG 15:15" />ووجَدَ شَمشونُ فَكَّ حمارٍ طَريئًا، فتَناوَلَهُ وقَتَلَ بهِ ألفَ رَجُلٍ، <verse eid="JDG 15:15" /><verse number="16" style="v" pubnumber="16" sid="JDG 15:16" />وقالَ: ”بِفَكِّ حمارٍ كدَّستُ أكوامًا وأكوامًا. بِفَكِّ حمارٍ قتَلتُ ألفَ رَجلٍ“. <verse eid="JDG 15:16" /><verse number="17" style="v" pubnumber="17" sid="JDG 15:17" />ولمَّا أتَمَّ كلامَهُ رَمى بِالفَكِّ مِنْ يدِه ودَعا ذلِكَ المكانَ رَمَتَ لَحيٍ.<verse eid="JDG 15:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="JDG 15:18" />وفجأةً أحَسَّ بالعَطَشِ الشَّديدِ، فصرَخَ إلى الرّبِّ وقالَ: ”مَنَحتَ عبدَكَ هذا الخلاصَ العظيمَ، والآنَ ها أنا أهلَكُ عَطَشًا وأقَعُ في أيدي غيرِ المَختونينَ“. <verse eid="JDG 15:18" /><verse number="19" style="v" pubnumber="19" sid="JDG 15:19" />فشَقَّ اللهُ صخرةً هُناكَ في لَحيٍ، فخَرجَت مِنها مياهٌ فشرِبَ ورجَعَت إليهِ روحُه واَنتَعَشَ. لِذلِكَ دُعيَ ذلِكَ المَوضِعُ عَينَ هَقُّوري، وهيَ في لَحيٍ إلى هذا اليومِ. <verse eid="JDG 15:19" /><verse number="20" style="v" pubnumber="20" sid="JDG 15:20" />وكانَ شَمشونُ قاضيًا على بَني إِسرائيلَ أيّامَ الفِلسطيِّينَ عِشرينَ سنَةً.<verse eid="JDG 15:20" /></para>
  <chapter eid="JDG 15" />
  <chapter number="16" style="c" sid="JDG 16" />
  <para style="s1">شمشون ودليلة</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JDG 16:1" />ثمَّ ذهَبَ شَمشونُ إلى غَزَّةَ فصادَفَ هُناكَ اَمرَأةً بَغيًّا، فدَخلَ علَيها. <verse eid="JDG 16:1" /><verse number="2" style="v" pubnumber="2" sid="JDG 16:2" />فقيلَ لأهلِ غَزَّةَ: ”شَمشونُ هُنا“، فأحاطوا بِالمكانِ وكمَنوا لَه كُلَّ اللَّيلِ عِندَ بابِ المدينةِ. وسَكَنوا اللَّيلَ كُلَّهُ وقالوا: ”عِندَ الصُّبحِ نقتُلُهُ“. <verse eid="JDG 16:2" /><verse number="3" style="v" pubnumber="3" sid="JDG 16:3" />فنامَ شَمشونُ إلى نِصفِ اللَّيلِ، ثُمَّ قامَ وأخذَ مِصراعَي بابِ المدينةِ بِقائِمتيهِ وقلَعَ البابَ ومِغلاقَهُ وحمَلَهُ على كَتِفِهِ وصَعِدَ إلى رأسِ الجبَلِ الّذي قُبالَةَ حبرونَ.<verse eid="JDG 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="JDG 16:4" />وبَعدَ ذلِكَ أحبَّ شَمشونُ اَمرَأةً في وادي سورَقَ اَسمُها دليلةُ. <verse eid="JDG 16:4" /><verse number="5" style="v" pubnumber="5" sid="JDG 16:5" />فصَعِدَ إليها زُعماءُ الفِلسطيِّينَ وقالوا لها: ”خادِعيهِ واَعرِفي بِماذا قوَّتُهُ العظيمةُ وكيفَ نتَمكَّنُ مِنهُ حتّى نوثِقَهُ ونتَغلَّبَ علَيهِ، وكُلُّ واحدٍ مِنَّا يدفَعُ إليكِ ألفًا ومئةً مِنَ الفِضَّةِ“. <verse eid="JDG 16:5" /><verse number="6" style="v" pubnumber="6" sid="JDG 16:6" />فقالَت دليلةُ لِشَمشونَ: ”أخبِرني بِماذا قوَّتُكَ العظيمةُ، وبِماذا توثَقُ فتُغلَبُ؟“ <verse eid="JDG 16:6" /><verse number="7" style="v" pubnumber="7" sid="JDG 16:7" />فقالَ لها: ”إذا أوثَقوني بِسبعةِ أوتارٍ طَريئةٍ لم تَجِفَّ بَعدُ، فإنِّي أضعُفُ وأصيرُ كواحدٍ مِنَ النَّاسِ“. <verse eid="JDG 16:7" /><verse number="8" style="v" pubnumber="8" sid="JDG 16:8" />فأعطاها الفِلسطيّونَ سبعةَ أوتارٍ طَريئةٍ لم تَجِفَّ بَعدُ، فشَدَّتهُ بِها، <verse eid="JDG 16:8" /><verse number="9" style="v" pubnumber="9" sid="JDG 16:9" />وكمَنوا لَه عِندَها في الغُرفةِ ثمَّ قالَت لَه: ”هجَمَ علَيكَ الفِلسطيّونَ يا شَمشونُ“. فقطَعَ شَمشونُ الأوتارَ كما يُقطَعُ خَيطُ الكتَّانِ إذا لامَسَتْهُ النَّارُ. ولم يَعلَمِ الفِلسطيّونَ بِماذا قوَّتُهُ.<verse eid="JDG 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="JDG 16:10" />فقالَت لَه دليلةُ: ”خدَعتَني وكَذبْتَ عليَّ، فأخبِرني الآنَ بِماذا توثَقُ؟“ <verse eid="JDG 16:10" /><verse number="11" style="v" pubnumber="11" sid="JDG 16:11" />فقالَ لها: ”إنْ أوثَقوني بِحبالٍ جديدةٍ لم تُستَعمَلْ مِنْ قَبلُ، فإنِّي أضعُفُ وأصيرُ كواحدٍ مِنَ النَّاسِ“. <verse eid="JDG 16:11" /><verse number="12" style="v" pubnumber="12" sid="JDG 16:12" />فأخذَت دليلةُ حِبالًا جديدةً وأوثقَتْهُ بِها، وقالَت لَه: ”هجمَ علَيكَ الفِلسطيّونَ يا شَمشونُ“. وكانَ الكمينُ عِندَها مُختَبِئًا في الغُرفةِ، فقطَعَ شَمشونُ الحِبالَ عَنْ ذِراعَيهِ كما يُقطَعُ الخَيطُ. <verse eid="JDG 16:12" /><verse number="13" style="v" pubnumber="13" sid="JDG 16:13" />فقالَت لَه دليلةُ: ”إلى متى تَخدَعُني وتكذِبُ عليَّ، فأخبِرني بِماذا توثَقُ“. فقالَ لها: ”إذا نُسِجَتِ الخُصَلُ السَّبْعُ في رأسي بِالنَّولِ وشدَدتِها بِالوَتَدِ، فإنِّي أضعُفُ وأصيرُ كواحدٍ مِنَ النَّاسِ“. <verse eid="JDG 16:13" /><verse number="14" style="v" pubnumber="14" sid="JDG 16:14" />وفيما هوَ نائِمٌ أخَذَت دليلةُ الخُصَلَ السَّبْعَ في رأسِهِ ونسَجتْها بِالنَولِ وشَدَّتها إلى الوتَدِ وقالَت لَه: ”هجَمَ علَيكَ الفِلسطيّونَ يا شَمشونُ“. فأفاقَ مِنْ نومِهِ وقَلَعَ وتَدَ النَّسيجِ وما فيهِ.<verse eid="JDG 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="JDG 16:15" />فقالَت لَه دليلةُ: ”كيفَ تقولُ إنَّكَ تُحِبُّني وأنتَ لا تَثِقُ بي؟ وها أنتَ لِلمَرَّةِ الثَّالِثةِ تَخدَعُني ولا تُخبِرُني بِماذا قوَّتُكَ العظيمةُ“. <verse eid="JDG 16:15" /><verse number="16" style="v" pubnumber="16" sid="JDG 16:16" />ولمَّا كانَت تُضايِقُه بِكلامِها كُلَّ يومٍ وتُلِحُّ علَيهِ ضاقَت نفْسُهُ حتّى الموتِ، <verse eid="JDG 16:16" /><verse number="17" style="v" pubnumber="17" sid="JDG 16:17" />فأطلَعَها على كُلِّ ما في قلبِهِ وقالَ لها: ”لم يُقَصَّ شَعري يومًا لأنِّي نَذيرُ اللهِ مِنْ بَطنِ أمِّي، فإنْ قُصَّ شَعري فارَقَتْني قوَّتي وضَعُفتُ وصِرتُ كواحدٍ مِنَ النَّاسِ“.<verse eid="JDG 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="JDG 16:18" />وأحَسَّت دليلةُ أنَّهُ أخبَرَها بِكُلِّ ما في قلبِهِ، فأرسلَت ودَعَت زُعماءَ الفِلسطيِّينَ إليها وقالَت لهُم: ”تَعالَوا إليَّ هذِهِ المرَّةَ فإنَّهُ كاشَفَني بِكُلِّ ما في قلبِهِ“. فأتَوا إليها والِفضَّةُ بأيديهِم. <verse eid="JDG 16:18" /><verse number="19" style="v" pubnumber="19" sid="JDG 16:19" />فأنامَتهُ على رُكبَتَيها ودَعَت رَجُلًا فحَلقَ الخُصَلَ السَّبْعَ في رأسِهِ وبَدأت بِتَعذيبِهِ بَعدَ أنْ فارَقَتهُ قُوَّتُهُ. <verse eid="JDG 16:19" /><verse number="20" style="v" pubnumber="20" sid="JDG 16:20" />وقالَت لَه: ”هجَمَ علَيكَ الفِلسطيّونَ يا شَمشونُ“. فأفاقَ مِنْ نومِهِ وحَسِبَ أنَّهُ كما في السَّابِقِ سَينتَفِضُ في وجهِهِم ويُنقِذُ نفْسَهُ. وهوَ لا يَعلَمُ أنَّ الرّبَّ فارَقَهُ. <verse eid="JDG 16:20" /><verse number="21" style="v" pubnumber="21" sid="JDG 16:21" />فقبضَ علَيهِ الفِلسطيّونَ وقلَعوا عينَيهِ واَقتادوهُ إلى غَزَّةَ وقيَّدوهُ بِسلسلتَينِ مِنْ نُحاسٍ وجعَلوهُ يَطحَنُ في السِّجنِ. <verse eid="JDG 16:21" /><verse number="22" style="v" pubnumber="22" sid="JDG 16:22" />وأخذَ شَعرُ رأسِهِ ينمو مِنْ جديدٍ.<verse eid="JDG 16:22" /></para>
  <para style="s1">موت شمشون</para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="JDG 16:23" />فاَجتَمَعَ زُعماءُ الفِلسطيِّينَ لِيُقدِّموا ذبيحةً عظيمةً لِداجونَ إلهِهِم تعبيرًا عَنِ الفرَحِ، وقالوا: ”سَلَّمَ إلهُنا عَدُوَّنا شَمشونَ إلى أيدينا“. <verse eid="JDG 16:23" /><verse number="24" style="v" pubnumber="24" sid="JDG 16:24" />ولمَّا رَآهُ الشَّعبُ مَجَّدوا إلهَهُم وقالوا: ”سَلَّمَ إلهُنا إلى أيدينا عَدُوَّنا الّذي خَرَّبَ أرضَنا وأكثرَ قتلانا“. <verse eid="JDG 16:24" /><verse number="25" style="v" pubnumber="25" sid="JDG 16:25" />فلمَّا اَمتَلأت قُلوبُهُم زَهْوًا قالوا: ”هاتُوا شَمشونَ لِنَضحكَ علَيهِ“. فَجاؤُوا بِشَمشونَ مِنَ السِّجنِ وضَحِكوا علَيهِ وأقاموهُ بَينَ الأعمِدةِ. <verse eid="JDG 16:25" /><verse number="26" style="v" pubnumber="26" sid="JDG 16:26" />فقالَ شَمشونُ لِلصَّبيِّ الآخِذِ بِيدِهِ: ”دَعني ألمُسُ الأعمِدةَ الّتي يقومُ علَيها هذا البَيتُ حتّى أتَّكِئَ علَيها“. <verse eid="JDG 16:26" /><verse number="27" style="v" pubnumber="27" sid="JDG 16:27" />وكانَ البَيتُ يَغُصُّ بِالرِّجالِ والنِّساءِ، وكانَ هُناكَ جميعُ زُعَماءِ الفِلسطيِّينَ وعلى السَّطحِ نحوَ ثَلاثةِ آلافٍ مِنَ الرِّجالِ والنِّساءِ يتفرَّجونَ على شَمشونَ وهُم يضحكونَ علَيهِ.<verse eid="JDG 16:27" /></para>
  <para style="p">
    <verse number="28" style="v" pubnumber="28" sid="JDG 16:28" />فدعا شَمشونُ الرّبَّ وقالَ: ”يا سيِّدي الرّبَّ اَذكُرني وشَدِّدني هذِهِ المرَّةَ أيضًا يا إلهي، لأنتَقِمَ لِعينَيَّ مِنَ الفِلسطيِّينَ دَفعةً واحدةً“. <verse eid="JDG 16:28" /><verse number="29" style="v" pubnumber="29" sid="JDG 16:29" />ثُمَّ قبضَ على العَمودينِ اللَّذَينِ في الوسَطِ، القائِمِ علَيهِما البَيتُ، آخِذًا أحدَهُما بِيمينِهِ والآخَرَ بِشمالِهِ واَتَّكَأَ علَيهِما <verse eid="JDG 16:29" /><verse number="30" style="v" pubnumber="30" sid="JDG 16:30" />وقالَ: ”عليَّ وعلى الفِلسطيِّينَ لِيَسقُطِ البَيتُ“. ودفَعَ العَمودَينِ بِشِدَّةٍ فسقطَ البَيتُ على الزُّعماءِ وعلى جميعِ النَّاسِ الّذينَ في البَيتِ. فكانَ الموتى الّذينَ قتَلَهُم في موتِهِ أكثرَ مِنَ الّذينَ قتَلَهُم في حياتِهِ. <verse eid="JDG 16:30" /><verse number="31" style="v" pubnumber="31" sid="JDG 16:31" />فنزَلَ إخوتُهُ وجميعُ أهلِ بَيتِهِ، فحَملوهُ وصَعِدوا بهِ ودَفَنوهُ بَينَ صَرعَةَ وأشتأولَ، في قبرِ مَنوحَ أبيهِ. وكانَ تَولَّى القضاءَ على بَني إِسرائيلَ عِشرينَ سنَةً.<verse eid="JDG 16:31" /></para>
  <chapter eid="JDG 16" />
  <chapter number="17" style="c" sid="JDG 17" />
  <para style="s1">معبد ميخا الأفراييمي</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JDG 17:1" />وكانَ رَجُلٌ مِنْ جبَلِ أفرايمَ اَسمُهُ ميخا. <verse eid="JDG 17:1" /><verse number="2" style="v" pubnumber="2" sid="JDG 17:2" />فقالَ لأمِّهِ: ”إنَّ الألفَ والمئةَ مِثقالِ الفِضَّةِ الّتي أُخِذَتْ مِنكِ وسَمِعتُكِ تَلعَنينَ السَّارِقَ بِسبَبِها هيَ معي. أنا أخَذتُها“. فقالَت لَه أمُّهُ: ”باركَكَ الرّبُّ، يا اَبني“. <verse eid="JDG 17:2" /><verse number="3" style="v" pubnumber="3" sid="JDG 17:3" />فرَدَّ لأمِّهِ الألفَ والمئةَ مِثقالِ الفضَّةِ. فقالَت أمُّهُ: ”كرَّستُ الفضَّةَ للرّبِّ حتّى أُبعِدَ اللَّعنةَ عَنكَ لِتَعمَلَ مِنها صنَمًا مَسبوكًا“. <verse eid="JDG 17:3" /><verse number="4" style="v" pubnumber="4" sid="JDG 17:4" />فلمَّا ردَّ الفضَّةَ إلى أمِّهِ أخذَت أمُّهُ مئَتي مِثقالٍ مِنها وأعطَتها إلى الصَّائِغِ فصنَعَ مِنها صنَمًا، وُضِعَ في بَيتِ ميخا. <verse eid="JDG 17:4" /><verse number="5" style="v" pubnumber="5" sid="JDG 17:5" />وكانَ لِميخا بَيتٌ لِلعِبادةِ، فصنَعَ أفودًا وتَرافيمَ وأقامَ أحدَ بَنيهِ كاهنًا لَه. <verse eid="JDG 17:5" /><verse number="6" style="v" pubnumber="6" sid="JDG 17:6" />وفي تِلكَ الأيّامِ لم يكُنْ لإسرائيلَ مَلِكٌ، فكانَ كُلُّ واحدٍ يَعملُ ما يشاءُ.<verse eid="JDG 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="JDG 17:7" />وكانَ هُناكَ فَتًى لاويٌّ مُتَغرِّبٌ، في مدينةِ بَيتَ لَحمَ في يَهوذا. <verse eid="JDG 17:7" /><verse number="8" style="v" pubnumber="8" sid="JDG 17:8" />فذَهبَ مِنَ المدينةِ يَبحَثُ عَنْ مكانٍ يُقيمُ فيهِ، وبَينَما هوَ في طَريقِهِ جاءَ إلى بَيتِ ميخا في جبَلِ أفرايمَ. <verse eid="JDG 17:8" /><verse number="9" style="v" pubnumber="9" sid="JDG 17:9" />فسألَهُ ميخا: ”مِنْ أينَ جِئتَ؟“ فأجابَهُ: ”أنا لاويٌّ مِنْ بَيتَ لَحمَ في يَهوذا. جِئتُ أبحَثُ عَنْ مكانٍ أُقيمُ فيهِ“. <verse eid="JDG 17:9" /><verse number="10" style="v" pubnumber="10" sid="JDG 17:10" />فقالَ لَه ميخا: ”أقِمْ عِندي وكُنْ لي مُشيرًا وكاهنًا، وأنا أُعطيكَ كُلَّ سنَةٍ عشَرَةً مِنَ الفضَّةِ وكِسوَةً مِنَ الثِّيابِ وقُوتَكَ“. <verse eid="JDG 17:10" /><verse number="11" style="v" pubnumber="11" sid="JDG 17:11" />فرَضيَ اللَّاويُّ أنْ يُقيمَ معَ ميخا وكانَ عِندَهُ كأحدِ بَنيهِ. <verse eid="JDG 17:11" /><verse number="12" style="v" pubnumber="12" sid="JDG 17:12" />وجَعَلَهُ ميخا كاهنًا لَه وأسكَنَهُ في بَيتِهِ. <verse eid="JDG 17:12" /><verse number="13" style="v" pubnumber="13" sid="JDG 17:13" />فقالَ ميخا: ”عَلِمتُ الآنَ أنَّ الرّبَّ أحسنَ إليَّ، لأنَّ لي كاهنًا مِنَ اللَّاويِّينَ“.<verse eid="JDG 17:13" /></para>
  <chapter eid="JDG 17" />
  <chapter number="18" style="c" sid="JDG 18" />
  <para style="s1">ميخا وقبيلة دان</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JDG 18:1" />وفي تِلكَ الأيّامِ لم يكُنْ لإسرائيلَ مَلِكٌ. وكانَت قبيلةُ دانَ في تِلكَ الأيّامِ تَطلُبُ مكانًا لِلسُّكنى، لأنَّها إلى ذلِكَ اليومِ لم تكُن نالَت نصيبًا بَينَ قَبائِلِ بَني إِسرائيلَ. <verse eid="JDG 18:1" /><verse number="2" style="v" pubnumber="2" sid="JDG 18:2" />فأرسلَ بَنو دانَ مِنْ قَبيلتِهِم خمسةَ رِجالٍ أشِدَّاءَ مِنْ صَرْعَةَ وأشتَأولَ لِيكشِفوا الأرضَ ويَفحَصوها، وقالوا لهُم: ”إذهَبوا وتَفَحَّصوا الأرضَ“. فجاؤوا إلى جبَلِ أفرايمَ، إلى بَيتِ ميخا، وباتوا هُناكَ. <verse eid="JDG 18:2" /><verse number="3" style="v" pubnumber="3" sid="JDG 18:3" />وبَينَما كانوا في بَيتِ ميخا، عرَفوا صوتَ الفتى اللَّاويِّ، فاَقتَرَبوا مِنهُ وسألوهُ: ”مَنْ جاءَ بِكَ إلى هُنا؟ وماذا تفعَلُ في هذا المكانِ؟ وما عَلاقَتُكَ بهِ؟“ <verse eid="JDG 18:3" /><verse number="4" style="v" pubnumber="4" sid="JDG 18:4" />فأجابَهُم: ”صنَعَ لي ميخا كذا وكذا، واَستَخدَمَني، فصِرْتُ لَه كاهنًا“. <verse eid="JDG 18:4" /><verse number="5" style="v" pubnumber="5" sid="JDG 18:5" />فقالوا لَه: ”إسألْ لنا اللهَ، فنَعلَمَ إنْ كُنا سنَنجَحُ في طريقِنا الّتي نحنُ سائِرونَ فيها؟“ <verse eid="JDG 18:5" /><verse number="6" style="v" pubnumber="6" sid="JDG 18:6" />فقالَ لهُم: ”سِيروا بأمانٍ، فالطَّريقُ الّتي أنتُم سالِكونَ فيها يَرعاها الرّبُّ“.<verse eid="JDG 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="JDG 18:7" />فمَضى الرِّجالُ الخمسةُ وجاؤوا إلى لايشَ ورَأَوا شعبَها هادِئينَ مُطمَئنِّينَ كالصَّيدونيِّينَ. كانوا آمِنينَ هانِئينَ لا شيءَ يُزعِجُهُم في أرضِهِم ولا مَنْ يتَسَلَّطُ علَيهِم. وكانوا بعيدينَ مِنَ الصَّيدونيِّينَ ولا عَلاقَةَ لهُم بأحدٍ. <verse eid="JDG 18:7" /><verse number="8" style="v" pubnumber="8" sid="JDG 18:8" />فرَجَعوا إلى قبيلتِهِم في صَرْعَةَ وأشتأولَ، فسألهُم رِجالُها: ”ما الخبَرُ؟“ <verse eid="JDG 18:8" /><verse number="9" style="v" pubnumber="9" sid="JDG 18:9" />فأجابوهُم: ”قوموا لِمُحاربةِ أهلِ لايشَ لأنَّنا رأينا أرضَهُم صالِحةً جِدًّا، فلا تتَهاوَنوا ولا تَتكاسَلوا عَنِ المَسيرِ لِتدخُلوها وتَمتَلِكوها. <verse eid="JDG 18:9" /><verse number="10" style="v" pubnumber="10" sid="JDG 18:10" />فيها تَجِدونَ شعبًا مُطمَئنًّا، وبِلادًا واسِعةً وها الرّبُّ سَلَّمَها إلى أيديكُم، وهيَ مكانٌ لا يُعوِزُهُ شيءٌ في الأرضِ“.<verse eid="JDG 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JDG 18:11" />فاَرتَحَلَ مِنْ قبيلةِ دانَ، مِنْ صَرْعَةَ وأشتأولَ، ستُّ مئةِ رَجُلٍ مُدَجَّجينَ بِالسِّلاحِ، <verse eid="JDG 18:11" /><verse number="12" style="v" pubnumber="12" sid="JDG 18:12" />وخيَّموا عِندَ قريةِ يَعاريمَ في يَهوذا، ولِذلِكَ دُعيَ ذلِكَ المَوضِعُ مَحلَّةَ دانَ إلى هذا اليومِ، وهو غربيَّ قريةِ يَعاريمَ. <verse eid="JDG 18:12" /><verse number="13" style="v" pubnumber="13" sid="JDG 18:13" />وعَبَروا مِنْ هُناكَ إلى جبَلِ أفرايمَ ودَخَلوا بَيتَ ميخا.<verse eid="JDG 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="JDG 18:14" />فتَكلَّمَ الرِّجالُ الخمسةُ الّذينَ ذهَبوا لِيَتَفَحَّصوا لايشَ وقالوا لأبناءِ قبيلتِهِم: ”أتَعلمونَ أنَّ في هذِهِ البُيوتِ أفودًا وتَرافيمَ وصنَمًا مَسبوكًا؟ فاَعرِفوا الآنَ ماذا تفعلونَ“. <verse eid="JDG 18:14" /><verse number="15" style="v" pubnumber="15" sid="JDG 18:15" />فمالوا إلى هُناكَ، إلى بَيتِ ميخا وسَلَّموا على الفتى اللَّاويِّ. <verse eid="JDG 18:15" /><verse number="16" style="v" pubnumber="16" sid="JDG 18:16" />ووَقَفَ الستُّ مئةِ رَجُلٍ المُدَجَّجونَ بِالسِّلاحِ عِندَ مَدخَلِ البابِ وهُم مِنْ بَني دانَ. <verse eid="JDG 18:16" /><verse number="17" style="v" pubnumber="17" sid="JDG 18:17" />وصَعِدَ الرِّجالُ الخمسةُ الّذينَ تَفَحَّصوا الأرضَ ودخَلوا إلى هُناكَ وأخَذوا الصَّنَمَ المَسبوكَ والأفودَ والتَّرافيمَ بَينَما الكاهنُ واقِفٌ عِندَ مدخَلِ البابِ معَ السِتِّ مئةِ رَجُلٍ المُسلَّحينَ بِعُدَّةَ الحربِ. <verse eid="JDG 18:17" /><verse number="18" style="v" pubnumber="18" sid="JDG 18:18" />فلمَّا دخَلَ أولئكَ الرِّجالُ الخمسةُ بَيتَ ميخا وأخَذوا ما أخَذوهُ سألَهُمُ الكاهنُ: ”ماذا تَفعلونَ؟“ <verse eid="JDG 18:18" /><verse number="19" style="v" pubnumber="19" sid="JDG 18:19" />فأجابوا: ”أُسكُتْ. ضَعْ يدَكَ على فَمِكَ واَذهَبْ معَنا وكُنْ لنا مُشيرًا وكاهنًا. أنْ تكونَ كاهنًا لِسبْطٍ أو عَشيرَةٍ في إِسرائيلَ خَيرٌ لكَ مِنْ أنْ تكونَ كاهنًا لِبيتِ رَجُلٍ واحدٍ“. <verse eid="JDG 18:19" /><verse number="20" style="v" pubnumber="20" sid="JDG 18:20" />وفَرِحَ الكاهنُ وأخذَ الأفودَ والتَّرافيمَ والصَّنَمَ المَسبوكَ والتَحَقَ بِهِم. <verse eid="JDG 18:20" /><verse number="21" style="v" pubnumber="21" sid="JDG 18:21" />ثُمَّ اَنصَرفوا وساقوا الأطفالَ والماشيةَ وكُلَّ ثَمينٍ قُدَّامَهُم.<verse eid="JDG 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="JDG 18:22" />فلمَّا اَبْتَعَدوا عَنْ بَيتِ ميخا اَجتَمَعَ الرِّجالُ الّذينَ كانوا في البُيوتِ، بِالقُربِ مِنْ بَيتِ ميخا، ولَحِقوا بِبَني دانَ <verse eid="JDG 18:22" /><verse number="23" style="v" pubnumber="23" sid="JDG 18:23" />وصاحوا بِهِم. فالتَفَتَ بَنو دانَ وقالوا لميخا: ”ما لكَ تصرُخُ؟“ <verse eid="JDG 18:23" /><verse number="24" style="v" pubnumber="24" sid="JDG 18:24" />فأجابَهُم: ”آلِهَتي الّتي صنَعتُها أخَذتُموها معَ الكاهنِ وذهَبتُم، فماذا بَقيَ لي؟ وتقولونَ لي: ما لكَ؟“ <verse eid="JDG 18:24" /><verse number="25" style="v" pubnumber="25" sid="JDG 18:25" />فقالَ لَه بَنو دانَ: ”لا تُسمِعْنا صوتَكَ، لِئلَّا يغضَبَ هؤلاءِ الرِّجالُ، فتَهلِكَ أنتَ وأهلُ بَيتِكَ“. <verse eid="JDG 18:25" /><verse number="26" style="v" pubnumber="26" sid="JDG 18:26" />ومضى بَنو دانَ في سبيلِهِم. وحينَ رأى ميخا أنَّهُم أقوى مِنهُ عادَ إلى بَيتِهِ.<verse eid="JDG 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="JDG 18:27" />وبَعدَ أنْ أخذَ بَنو دانَ، ما صنَعَ ميخا وكاهنُهُ جاؤوا إلى لايشَ، إلى شعبٍ هادِئٍ مُطمئِنٍّ، فضَربوهُم بِحَدِّ السَّيفِ وأحرَقوا المدينةَ بِالنَّارِ. <verse eid="JDG 18:27" /><verse number="28" style="v" pubnumber="28" sid="JDG 18:28" />ولم يكُن لهُم مُنقِذٌ، لأنَّ المدينةَ بعيدةٌ مِنْ صَيدونَ، ولَم يكُن بَينَهُم وبَينَ أحدٍ عَلاقَةٌ. وكانَتِ المدينةُ في الوادي الّذي لِبَيتِ رَحوبَ، فأعادَ بَنو دانَ بِناءَ المدينةِ وسكَنوها. <verse eid="JDG 18:28" /><verse number="29" style="v" pubnumber="29" sid="JDG 18:29" />وسَمَّوا المدينةَ دانَ باَسْمِ دانَ أبيهِم الّذي وُلِدَ لإسرائيلَ، وكانَ اَسمُها قَبلَ ذلِكَ لايشَ. <verse eid="JDG 18:29" /><verse number="30" style="v" pubnumber="30" sid="JDG 18:30" />ونصَبوا الصَّنَمَ المَسبوكَ، وظَلَّ يوناثانُ بنُ جَرشومَ بنِ منَسَّى، هوَ وبَنوهُ، كهَنةً لِعَشيرةِ بَني دانَ إلى يومِ سَبيِهِم. <verse eid="JDG 18:30" /><verse number="31" style="v" pubnumber="31" sid="JDG 18:31" />وبَقيَ عِندَهُم صَنَمُ ميخا المَسبوكُ طُولَ الأيّامِ الّتي كانَ فيها بَيتُ اللهِ في شيلوهَ.<verse eid="JDG 18:31" /></para>
  <chapter eid="JDG 18" />
  <chapter number="19" style="c" sid="JDG 19" />
  <para style="s1">جريمة بنيامين في جبعة</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JDG 19:1" />وفي تِلكَ الأيّامِ لم يكُن لإِسرائيلَ مَلِكٌ، وكانَ رَجُلٌ لاويٌّ مُقيمًا بِسَفحِ جبَلِ أفرايمَ، فاَتَّخَذَ لَه زَوجَةً مِنْ بَيتَ لَحمَ في يَهوذا، <verse eid="JDG 19:1" /><verse number="2" style="v" pubnumber="2" sid="JDG 19:2" />فاَختَلَفَت معَهُ وخَرجَت مِنْ عِندِهِ إلى بَيتِ أبيها في بَيتَ لَحمَ، في يَهوذا، وأقامَت هُناكَ أربعةَ أشهُرٍ. <verse eid="JDG 19:2" /><verse number="3" style="v" pubnumber="3" sid="JDG 19:3" />ثُمَّ سعى زوجُها في طَلَبِها لِيُطَيِّبَ قلبَها ويَرُدَّها إليهِ، وأخذَ معَهُ خادِمَهُ وحمارينِ، فأدخَلَتهُ بَيتَ أبيها. فلمَّا رآهُ أبوها فَرِحَ بِلِقائِه <verse eid="JDG 19:3" /><verse number="4" style="v" pubnumber="4" sid="JDG 19:4" />واَستَضافَهُ، فأقامَ عِندَهُ ثَلاثةَ أيّامٍ، وأكلوا وشرِبوا وباتوا هُناكَ. <verse eid="JDG 19:4" /><verse number="5" style="v" pubnumber="5" sid="JDG 19:5" />وفي اليومِ الرَّابِعِ بكَّرَ في الصَّباحِ وقامَ لِيَنصَرِفَ فقالَ لَه أبو زَوجَتِهِ: ”أُسنُدْ قلبَكَ بِكِسرَةِ خُبزٍ، ثُمَّ تذهَبُ أنتَ واَمرأتُكَ“. <verse eid="JDG 19:5" /><verse number="6" style="v" pubnumber="6" sid="JDG 19:6" />فجَلسوا وأكلوا معًا وشربوا. ثُمَّ قالَ لَه: ”نَمْ عِندَنا اللَّيلةَ واَستَرِحْ“. <verse eid="JDG 19:6" /><verse number="7" style="v" pubnumber="7" sid="JDG 19:7" />ولمَّا نهَضَ اللَّاويُّ لِيَنصَرِفَ ألحَّ علَيهِ حَمُوهُ لِلبقاءِ عِندَهُ، فعادَ وباتَ هُناكَ. <verse eid="JDG 19:7" /><verse number="8" style="v" pubnumber="8" sid="JDG 19:8" />وبكَّرَ في صباحِ اليومِ الخامِسِ لِيَنصَرِفَ، فقالَ لَه حَمُوهُ: ”أُسنُدْ قلبَكَ بِلُقمةٍ“، فجَلَسوا إلى ما بَعدَ الظُّهرِ وتَغدَّوا معًا. <verse eid="JDG 19:8" /><verse number="9" style="v" pubnumber="9" sid="JDG 19:9" />ونهَضَ الرَّجلُ لِيَنصَرِفَ هو وجاريَتُهُ وخادِمُهُ، فقالَ لَه حَمُوهُ: ”مالَ النَّهارُ إلى الغُروبِ، فبيتوا هُنا، واَستَريحوا. وغدًا تُبكِّرونَ في طريقِكُم وتَمضونَ إلى بَيتِكَ“.<verse eid="JDG 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="JDG 19:10" />فرَفَضَ اللَّاويُّ أنْ يَبيتَ، واَنصرفَ حتّى وصلَ إلى قُبالةِ يَبوسَ الّتي هيَ أورُشليمُ، ومعَهُ زَوجَتُهُ وحمارانِ مَسروجانِ. <verse eid="JDG 19:10" /><verse number="11" style="v" pubnumber="11" sid="JDG 19:11" />وفيما هُم عِندَ يَبوسَ والنَّهارُ مالَ جِدًّا إلى المغيبِ، قالَ الخادِمُ لِسَيِّدِهِ: ”حوِّلْ بِنا إلى مدينةِ اليَبوسيِّينَ هذِهِ، فنَبيتَ فيها“. <verse eid="JDG 19:11" /><verse number="12" style="v" pubnumber="12" sid="JDG 19:12" />فقالَ لَه سيِّدُهُ: ”لا ننزِلُ في مدينةٍ غريبةٍ لا أحدَ فيها مِنْ بَني إِسرائيلَ، لكِنْ لِنَعبُرْ إلى جِبعَةَ“.<verse eid="JDG 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="JDG 19:13" />وقالَ لَه: ”لِنَسِرْ إلى بعضِ هذِهِ الأماكِنِ ونَبيتَ في جِبعَةَ أو في الرَّامةِ“. <verse eid="JDG 19:13" /><verse number="14" style="v" pubnumber="14" sid="JDG 19:14" />وساروا، فغابَتِ الشَّمسُ وهُم عِندَ جِبعَةَ الّتي لِبَني بنيامينَ. <verse eid="JDG 19:14" /><verse number="15" style="v" pubnumber="15" sid="JDG 19:15" />فنَزلوا هُناكَ في ساحةِ المدينةِ ولم يَدْعُهُم أحدٌ إلى بَيتِهِ لِلمَبيتِ.<verse eid="JDG 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="JDG 19:16" />وإذا بِشيخٍ كانَ قادِمًا مِنْ عمَلِهِ في الحقلِ مساءً، وهوَ مِنْ جبَلِ أفرايمَ، ولكِنَّهُ أقامَ في جِبعَةَ معَ أهلِها البنيامينيِّينَ. <verse eid="JDG 19:16" /><verse number="17" style="v" pubnumber="17" sid="JDG 19:17" />فرفَعَ عينَيهِ فرأى هذا المُسافِرَ في ساحةِ المدينةِ، فسألَهُ: ”إلى أينَ أنتَ ذاهبٌ؟ ومِنْ أينَ جِئتَ؟“ <verse eid="JDG 19:17" /><verse number="18" style="v" pubnumber="18" sid="JDG 19:18" />فأجابَهُ: ”نحنُ عابرو طريقٍ مِنْ بَيتَ لَحمَ في يَهوذا، نقصُدُ سَفحَ جبَلِ أفرايمَ لأنِّي مِنْ هُناكَ، لكِنِّي كُنتُ ذَهبْتُ إلى بَيتَ لَحمَ في يَهوذا، وأنا الآنَ راجعٌ إلى البيتِ ولا أحدَ يدعوني إلى منزِلِه. <verse eid="JDG 19:18" /><verse number="19" style="v" pubnumber="19" sid="JDG 19:19" />ومعَنا تِبنٌ وعَلَفٌ لِحَميرِنا، وخُبزٌ وخمرٌ لي ولِزَوجَتي، وخادمي، ولا يُعوِزُنا شيءٌ“. <verse eid="JDG 19:19" /><verse number="20" style="v" pubnumber="20" sid="JDG 19:20" />فقالَ لَه الشَّيخُ: ”أهلًا وسهلًا، ومَهما يُعوِزُك فهوَ عليَّ، ولا تَبِتْ في السَّاحةِ“. <verse eid="JDG 19:20" /><verse number="21" style="v" pubnumber="21" sid="JDG 19:21" />وجاءَ بهِ إلى بَيتِهِ وقدَّمَ لِحَميرِهِم عَلَفًا، وغَسَّلوا أرجُلَهُم وأكلوا وشربوا.<verse eid="JDG 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="JDG 19:22" />وحينَ طابَت قُلوبُهُم أحاطَ رِجالٌ مِنَ المدينةِ، مِنْ رُعاعِ القَومِ، بِالبَيتِ وأخَذوا يَدُقُّونَ البابَ. وقالوا لِلشَّيخِ صاحبِ البَيتِ: ”أخْرِجِ الرَّجُلَ الّذي دخَلَ بَيتَكَ لِنُضاجِعَهُ“. <verse eid="JDG 19:22" /><verse number="23" style="v" pubnumber="23" sid="JDG 19:23" />فخرَجَ إليهِمِ الرَّجُلُ صاحبُ البَيتِ وقالَ لهُم: ”لا يا إخوتي. لا تَفعَلوا شَرًّا بهِ بَعدَما دخَلَ بَيتي. لا تَرتكِبوا هذِهِ الفاحِشةَ. <verse eid="JDG 19:23" /><verse number="24" style="v" pubnumber="24" sid="JDG 19:24" />هذِهِ اَبْنَتي العذراءُ وزَوجَةُ الرَّجُلِ أُخرِجُهُما إليكُم فَضاجِعوهُما واَصْنَعوا بِهِما ما يَحسُنُ في عُيونِكُم، ولا تَرتكِبوا بِحَقِّ الرَّجُلِ هذا الأمرَ الفاحِشَ“. <verse eid="JDG 19:24" /><verse number="25" style="v" pubnumber="25" sid="JDG 19:25" />فرَفَضوا أنْ يَسمَعوا لَه، فأخذَ الرَّجُلُ زَوجَتَهُ وأخرَجَها إليهِم فضاجَعوها وتَمَتَّعوا بِها اللَّيلَ كُلَّهُ إلى الصَّباحِ وتَركوها عِندَ مَطلَعِ الفَجرِ. <verse eid="JDG 19:25" /><verse number="26" style="v" pubnumber="26" sid="JDG 19:26" />فجاءَتِ المَرأةُ عِندَما أقبَلَ الصَّباحُ وسَقَطَت عِندَ بابِ البَيتِ حَيثُ كانَ زَوجُها، وبَقيَت هُناكَ إلى الصَّباحِ.<verse eid="JDG 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" pubnumber="27" sid="JDG 19:27" />فقامَ سيِّدُها في الصَّباحِ وفتَحَ بابَ البَيتِ وخرَجَ لِيذهَبَ في سبيلِهِ، فوجَدَها مَطروحةً أمامَ البابِ ويَداها على العَتَبةِ. <verse eid="JDG 19:27" /><verse number="28" style="v" pubnumber="28" sid="JDG 19:28" />فقالَ لها: ”قُومي بِنا نذهَبُ“. فلم تُجِبْهُ. فحمَلَ جُثَّتَها على حمارِهِ وذهَبَ إلى بَيتِهِ. <verse eid="JDG 19:28" /><verse number="29" style="v" pubnumber="29" sid="JDG 19:29" />ولمَّا دخَلَ بَيتَهُ تناولَ سِكِّينًا وأخذَ جُثَّةَ زَوجَتِهِ فقَطَعَها معَ عِظامِها اَثنَتَي عشْرَةَ قِطعةً ووَزَّعَها في جميعِ أرضِ إِسرائيلَ. <verse eid="JDG 19:29" /><verse number="30" style="v" pubnumber="30" sid="JDG 19:30" />وأوصى رُسُلَهُ أنْ يقولوا لجميعِ بَني إِسرائيلَ: ”هل رَأى أحدٌ مِثلَ هذا مُنذُ أنْ خرَجَ بَنو إِسرائيلَ مِنْ أرضِ مِصْرَ إلى يومِنا هذا فتَأمَّلوا وتَشاوَروا واَحكُموا فيما يَجِبُ عمَلُهُ“.<verse eid="JDG 19:30" /></para>
  <chapter eid="JDG 19" />
  <chapter number="20" style="c" sid="JDG 20" />
  <para style="s1">حرب على بنيامين</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JDG 20:1" />فخرَجَ بَنو إِسرائيلَ كُلُّهُم، واَجتَمَعوا إلى الرّبِّ في المِصفاةِ كرَجُلٍ واحدٍ، مِنْ دانَ إلى بِئرَ سَبعَ وأرضِ جِلعادَ. <verse eid="JDG 20:1" /><verse number="2" style="v" pubnumber="2" sid="JDG 20:2" />واَلتَقى رُؤساءُ الشَّعبِ، وكُلُّ عشائِرِ بَني إِسرائيلَ في مَجمَعِ شعبِ اللهِ وعدَدُهُم أربَعُ مئةِ ألفِ مُقاتِلٍ. <verse eid="JDG 20:2" /><verse number="3" style="v" pubnumber="3" sid="JDG 20:3" />وسَمِعَ بَنو بنيامينَ أنَّ بَني إِسرائيلَ صَعِدوا إلى المِصفاةِ. وقالَ بَنو إِسرائيلَ: ”قُصُّوا علَينا كيفَ وقَعَت هذِهِ الجريمةُ“. <verse eid="JDG 20:3" /><verse number="4" style="v" pubnumber="4" sid="JDG 20:4" />فأجابَ اللَّاويُّ زَوجُ المَرأةِ الّتي قُتِلتْ: ”دَخَلتُ وزَوجَتي إلى جِبعَةَ الّتي لِبَني بنيامينَ لِنَبيتَ فيها، <verse eid="JDG 20:4" /><verse number="5" style="v" pubnumber="5" sid="JDG 20:5" />فاَنقَضَّ عليَّ أهلُ جِبعَةَ وأحاطوا بي، وأنا في البَيتِ ليلًا، وأرادوا قتلي ثُمَّ اَغتَصَبوا زَوجتَي حتّى ماتَت. <verse eid="JDG 20:5" /><verse number="6" style="v" pubnumber="6" sid="JDG 20:6" />فأخَذتُها وقَطَّعتُها ووزَّعتُها في جميعِ أرضِ بَني إِسرائيلَ لأنَّهُم صنَعوا قباحةً وفاحشةً فيها. <verse eid="JDG 20:6" /><verse number="7" style="v" pubnumber="7" sid="JDG 20:7" />وها أنتُم كُلُّكُم هُنا يا بَني إِسرائيلَ، فعَليكُم بِالنُّصحِ والمَشورَةِ“.<verse eid="JDG 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="JDG 20:8" />فنَهضَ الشَّعبُ كرجُلٍ واحدٍ وقالوا: ”لا ينصَرِفْ أحدٌ إلى خَيمَتِهِ، ولا يرجِعْ أحدٌ إلى بَيتِهِ. <verse eid="JDG 20:8" /><verse number="9" style="v" pubnumber="9" sid="JDG 20:9" />وإلَّا هذا ما سنَفعَلُهُ بِجِبعةَ: نصعَدُ بِالقُرعةِ لِمُحاربَتِها. <verse eid="JDG 20:9" /><verse number="10" style="v" pubnumber="10" sid="JDG 20:10" />فنَأخُذُ مِنْ كُلِّ مئةِ رَجُلٍ عشَرَةً مِنْ كُلِّ أسباطِ بَني إِسرائيلَ، ومِنَ الألفِ مئةً، ومِنَ العشَرَةِ آلافِ ألفًا، لِيُؤمِّنوا حاجاتِ الّذينَ يَدخُلونَ جِبعَةَ بنيامينَ لِيُعاقِبوا أهلَها على القباحةِ الّتي فعَلوها في إِسرائيلَ“. <verse eid="JDG 20:10" /><verse number="11" style="v" pubnumber="11" sid="JDG 20:11" />فاَجتَمَعَ جميعُ رِجالِ بَني إِسرائيلَ إلى المدينةِ كرجُلٍ واحدٍ في الرَّأي.<verse eid="JDG 20:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="JDG 20:12" />وأرسَلَ أسباطُ بَني إِسرائيلَ رُسُلًا إلى جميعِ عشائِرِ بَني بنيامينَ يقولونَ لهُم: ”ما هذا الشَّرُّ الّذي صُنِعَ بَينَكُم؟ <verse eid="JDG 20:12" /><verse number="13" style="v" pubnumber="13" sid="JDG 20:13" />سَلِّموا إلينا الأنذالَ الّذينَ في جِبعَةَ فنَقتُلَهُم ونصرِفَ الشَّرَّ عَنْ بَني إِسرائيلَ“. فرفَضَ بَنو بنيامينَ أنْ يَسمَعوا لِقولِ إخوتِهِم بَني إِسرائيلَ، <verse eid="JDG 20:13" /><verse number="14" style="v" pubnumber="14" sid="JDG 20:14" />واَجتَمَعوا مِنَ المُدُنِ إلى جِبعَةَ لِيَخرُجوا ويُحارِبوهُم. <verse eid="JDG 20:14" /><verse number="15" style="v" pubnumber="15" sid="JDG 20:15" />وجَنَّدَ بَنو بنيامينَ في ذلِكَ اليومِ مِنَ المُدُنِ ستَّةً وعِشرينَ ألفَ مُقاتِلٍ، ما عدا أهلَ جِبعَةَ الّذينَ كانوا سَبعَ مئةٍ مِنْ خيرَةِ الرِّجالِ، <verse eid="JDG 20:15" /><verse number="16" style="v" pubnumber="16" sid="JDG 20:16" />وكانَ مِنْ بَينِ جميعِ هؤُلاءِ المُحاربينَ سَبعُ مئةٍ مِنْ خيرِ الرِّجالِ، عُسْرُ الأيدي، يَرمونَ الحجَرَ بالمِقلاعِ على الشَّعرةِ فلا يُخطِئونَ.<verse eid="JDG 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="JDG 20:17" />وجَنَّدَ رِجالُ بَني إسرائيلَ، ما عدا بَني بنيامينَ، أربَعَ مئةِ ألفِ مُقاتِلٍ، كُلُّهُم رِجالُ حربٍ.<verse eid="JDG 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="JDG 20:18" />فقاموا وصَعِدوا إلى بَيتَ إيلَ وسألوا اللهَ: ”مَنْ مِنَّا يصعَدُ أوَّلًا لِقِتالِ بَني بنيامينَ؟“ فقالَ الرّبُّ: ”بَنو يَهوذا أوَّلًا“.<verse eid="JDG 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="JDG 20:19" />فنهَضَ بَنو إِسرائيلَ في الصَّباحِ الباكرِ وخيَّموا عِندَ جِبعَةَ. <verse eid="JDG 20:19" /><verse number="20" style="v" pubnumber="20" sid="JDG 20:20" />وهُناكَ اَستَعَدُّوا لِمُحارَبةِ بَني بنيامينَ. <verse eid="JDG 20:20" /><verse number="21" style="v" pubnumber="21" sid="JDG 20:21" />فخَرَجَ بَنو بنيامينَ مِنْ جِبعَةَ فأسقَطوا مِنْ بَني إِسرائيلَ في ذلِكَ اليومِ اَثنَينِ وعِشرينَ ألفَ رَجُلٍ. <verse eid="JDG 20:21" /><verse number="22" style="v" pubnumber="22" sid="JDG 20:22" />ثمَّ تشَجَّعَ رِجالُ بَني إِسرائيلَ وعادوا فاَستَعَدُّوا لِلقتالِ في المَوضِعِ الّذي اَستَعَدُّوا فيهِ أوَّلَ يومٍ. <verse eid="JDG 20:22" /><verse number="23" style="v" pubnumber="23" sid="JDG 20:23" />لكِنْ قَبلَ ذلِكَ صَعِدَ بَنو إِسرائيلَ فَبكَوا أمامَ الرّبِّ إلى المساءِ وسألوهُ: ”أنَعودُ إلى مُحارَبةِ بَني بنيامينَ إخوتِنا ثانيةً؟“ فأجابَهُمُ الرّبُّ: ”حارِبوهُم“.<verse eid="JDG 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" pubnumber="24" sid="JDG 20:24" />فتَقدَّمَ بَنو إِسرائيلَ في اليومِ الثَّاني لِمُحارَبةِ بَني بنيامينَ. <verse eid="JDG 20:24" /><verse number="25" style="v" pubnumber="25" sid="JDG 20:25" />فخرَجَ علَيهِم بَنو بنيامينَ مِنْ جِبعَةَ في اليومِ الثَّاني، فأسقَطوا مِنهُم أيضًا ثمانيةَ عشَرَ ألفَ رَجُلٍ، كُلُّهُم مُقاتِلونَ. <verse eid="JDG 20:25" /><verse number="26" style="v" pubnumber="26" sid="JDG 20:26" />فصَعِدَ كُلُّ شعبِ إِسرائيلَ إلى بَيتَ إيلَ وبكَوا وأقاموا هُناكَ أمامَ الرّبِّ، وصاموا ذلِكَ اليومَ إلى المساءِ، وقدَّموا مُحرَقاتٍ وذبائِحَ سلامةٍ أمامَ الرّبِّ. <verse eid="JDG 20:26" /><verse number="27" style="v" pubnumber="27" sid="JDG 20:27" />وفي تلكَ الأيّامِ كانَ تابوتُ العَهدِ هُناكَ، <verse eid="JDG 20:27" /><verse number="28" style="v" pubnumber="28" sid="JDG 20:28" />وكانَ فِنحاسُ بنُ ألِعازارَ بنِ هرونَ في ذلِكَ الوقتِ كاهنًا فسألوا الرّبَّ: ”أنعودُ إلى مُحارَبةِ بَني بنيامينَ إخوتِنا أم نكُفُّ؟“ فأجابَهُم: ”حارِبوهُم لأنِّي في غدٍ أُسلِمُهُم إلى أيديكُم“.<verse eid="JDG 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" pubnumber="29" sid="JDG 20:29" />فأقامَ بَنو إِسرائيلَ كمينًا على جِبعَةَ مِنْ جميعِ جهاتِها، <verse eid="JDG 20:29" /><verse number="30" style="v" pubnumber="30" sid="JDG 20:30" />وصَعِدوا على بَني بنيامينَ في اليومِ الثَّالثِ واَستَعَدُّوا لِلقتالِ عِندَ جِبعَةَ كالمَرَّتينِ الأوَّلِيَّيْنِ. <verse eid="JDG 20:30" /><verse number="31" style="v" pubnumber="31" sid="JDG 20:31" />فخَرَجَ بَنو بنيامينَ إليهِم، وكانوا أخلَوا المدينةَ وأخَذوا يَقتُلونَ مِنهُم كالمَرَّتَينِ السَّابِقَتَينِ في الطَّريقَينِ الصَّاعِدَتَينِ، إحداهُما إلى بَيتَ إيلَ والثَّانيةُ إلى جِبعَةَ في الصَّحراءِ فسقَطَ مِنهُم نَحوَ ثَلاثينَ رَجُلًا. <verse eid="JDG 20:31" /><verse number="32" style="v" pubnumber="32" sid="JDG 20:32" />فظَنَّ بَنو بنيامينَ أنَّهُم مُنهَزِمونَ أمامَهُم كما اَنْهَزَموا قَبلًا. وأمَّا بَنو إِسرائيلَ فقالَوا: ”لِنَهرُبْ وراءَنا ونَسحَبُهُم مِنَ المدينةِ إلى الطُّرُقِ“. <verse eid="JDG 20:32" /><verse number="33" style="v" pubnumber="33" sid="JDG 20:33" />وقاموا كُلُّهُم مِنْ مواضِعِهِم واَستَعَدُّوا في بَعلِ تامارَ لِلقِتالِ. وخرَجَ كمينُ بَني إِسرائيلَ مِنْ مكانِهِ، مِنْ عَراءِ جَبْعَ. <verse eid="JDG 20:33" /><verse number="34" style="v" pubnumber="34" sid="JDG 20:34" />وهجَمَ مِنْ قُبالةِ المدينةِ عشَرَةُ آلافٍ مِنْ نُخبَةِ رِجالِ بَني إِسرائيلَ، فاَشتَدَّ القِتالُ ولم يَعلم بَنو بنيامينَ أنَّ النَّكبَةَ أطبَقَت علَيهِم. <verse eid="JDG 20:34" /><verse number="35" style="v" pubnumber="35" sid="JDG 20:35" />فهزَمَ الرّبُّ بَني بنيامينَ أمامَ بَني إِسرائيلَ، وأهلَكَ بَنو إِسرائيلَ مِنهُم في ذلِكَ اليومِ خمسةً وعِشرينَ ألفًا ومئةً، كُلُّهُم مُقاتِلونَ، <verse eid="JDG 20:35" /><verse number="36" style="v" pubnumber="36" sid="JDG 20:36" />فأيقَنَ بَنو بنيامينَ بِالهزيمَةِ.</para>
  <para style="p" vid="JDG 20:36">واَنسحَبَ رِجالُ بَني إِسرائيلَ أمامَ بَني بنيامينَ لأنَّهُم اَعْتَمَدوا على الكمينِ الّذي أقاموهُ على جِبعَةَ، <verse eid="JDG 20:36" /><verse number="37" style="v" pubnumber="37" sid="JDG 20:37" />فاَندَفعَ الكامِنونَ واَقْتَحَموا المدينةَ واَنتَشَروا فيها وضرَبوا جميعَ أهلِها بِحَدِّ السَّيفِ. <verse eid="JDG 20:37" /><verse number="38" style="v" pubnumber="38" sid="JDG 20:38" />وكانَتِ العَلامةُ بَينَ رِجالِ بَني إِسرائيلَ والكمينِ أنَّهُم حينَ يُثيرونَ دُخانًا بِكثرةٍ في المدينةِ <verse eid="JDG 20:38" /><verse number="39" style="v" pubnumber="39" sid="JDG 20:39" />يتَقَهقَرُ رِجالُ بَني إسرائيلَ في الحربِ. وكانَ بَدأَ بَنو بَنيامينَ يُهاجِمونَهُم، فقَتَلوا مِنْهُم ثَلاثينَ رَجُلًا، لأنَّهُم حَسِبوا أنَّهُم مُنهَزِمونَ مِنْ أمامِهِم كما اَنْهَزَموا في المعركةِ السَّالفةِ <verse eid="JDG 20:39" /><verse number="40" style="v" pubnumber="40" sid="JDG 20:40" />وفي تلكَ اللَّحظةِ أخذَ الحريقُ يرتَفِعُ مِنَ المدينةِ كعَمودِ دُخانٍ فالتَفَتَ بَنو بَنيامينَ إلى ورائِهِم فرَأَوا المدينةَ كُتلَةً مِنَ اللَّهيبِ الصَّاعِدِ إلى السَّماءِ. <verse eid="JDG 20:40" /><verse number="41" style="v" pubnumber="41" sid="JDG 20:41" />واَرتَدَّ علَيهِم رِجالُ بَني إِسرائيلَ، فهَرَبوا مذعورينَ لأنَّهُم رَأَوا النَّكبَةَ تَحُلُّ بِهِم. <verse eid="JDG 20:41" /><verse number="42" style="v" pubnumber="42" sid="JDG 20:42" />واَنْهَزَموا أمامَ رِجالِ بَني إِسرائيلَ إلى طريقِ البرِّيَّةِ، فلَحِقوا بِهِم وأطْبَقوا علَيهِم مِنَ المُدُنِ فأهلكوهُم. <verse eid="JDG 20:42" /><verse number="43" style="v" pubnumber="43" sid="JDG 20:43" />وأحاطوا بِهِم وطارَدوهُم وأدركوهُم مِنْ نوحةَ إلى قُبالةِ جِبعَةَ مِنْ جِهَةِ الشَّرقِ. <verse eid="JDG 20:43" /><verse number="44" style="v" pubnumber="44" sid="JDG 20:44" />فسقَطَ مِنْ بَني بنيامينَ ثمانيةَ عشَرَ ألفَ رَجلٍ، كُلُّهُم مِنَ الأشِدَّاءِ. <verse eid="JDG 20:44" /><verse number="45" style="v" pubnumber="45" sid="JDG 20:45" />فوَلَّوا هارِبينَ إلى البرِّيَّةِ، إلى سَلْعِ رِمُّونَ فقبَضَ بَنو إِسرائيلَ في الطَّريقِ على خمسةِ آلافِ رَجُلٍ مِنهُم وطارَدوا الباقينَ إلى جِدعومَ فقَتَلوا مِنهُم ألفي رَجُلٍ. <verse eid="JDG 20:45" /><verse number="46" style="v" pubnumber="46" sid="JDG 20:46" />فكانَ جُملةُ القَتلى مِنْ بَني بنيامينَ في ذلِكَ اليومِ خمسةً وعِشرينَ ألفَ مُقاتِلٍ، جميعُهُم مِنَ الأشِدَّاءِ. <verse eid="JDG 20:46" /><verse number="47" style="v" pubnumber="47" sid="JDG 20:47" />وهرَبَ مِنهُم ستُّ مئةِ رَجُلٍ في طريقِ البرِّيَّةِ إلى سَلْعِ رِمُّون وأقاموا هُناكَ أربعةَ أشهُرٍ. <verse eid="JDG 20:47" /><verse number="48" style="v" pubnumber="48" sid="JDG 20:48" />واَرتَدَّ رِجالُ بَني إِسرائيلَ إلى بَني بنيامينَ وقَتَلوهُم بِحَدِّ السَّيفِ معَ البَهائِمِ، وكُلُّ ما وجَدوا في جميعِ مُدُنِهِم أحرَقوهُ بالنَّارِ.<verse eid="JDG 20:48" /></para>
  <chapter eid="JDG 20" />
  <chapter number="21" style="c" sid="JDG 21" />
  <para style="s1">مصير قبيلة بنيامين</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JDG 21:1" />وحلَفَ رِجالُ بَني إِسرائيلَ في المِصفاةِ وقالوا: ”لا يُزوِّجْ رَجُلٌ مِنَّا اَبنَتَهُ لأحدٍ مِنْ بَني بنيامينَ“. <verse eid="JDG 21:1" /><verse number="2" style="v" pubnumber="2" sid="JDG 21:2" />وقدِمَ الشَّعبُ إلى بَيتَ إيلَ وبَقَوا هُناكَ أمامَ اللهِ إلى المَساءِ ورفَعوا أصواتَهُم وبكَوا بُكاءً شديدًا. <verse eid="JDG 21:2" /><verse number="3" style="v" pubnumber="3" sid="JDG 21:3" />وقالوا: ”لماذا يا ربُّ إلهَ إِسرائيلَ حدَثَ هذا في بَني إِسرائيلَ؟ لماذا فقَدوا اليومَ سِبْطًا مِنْ أسباطِهِم؟“ <verse eid="JDG 21:3" /><verse number="4" style="v" pubnumber="4" sid="JDG 21:4" />وبَكَّرَ الشَّعبُ في الصَّباحِ فبَنوا هُناكَ مذبَحًا وقَدَّموا مُحرَقاتٍ وذبائحَ سلامةٍ، <verse eid="JDG 21:4" /><verse number="5" style="v" pubnumber="5" sid="JDG 21:5" />وسألوا: ”مَنْ هيَ العَشيرَةُ الّتي لم تَصعَدْ إلى المجمَعِ أمامَ الرّبِّ مِنْ جميعِ عشائِرِ بَني إِسرائيلَ؟“ وكانوا حلَفوا يَمينًا مُعَظَّمَةً على مَنْ لا يَصعَدُ إلى الرّبِّ في المِصفاةِ أنَّهُ موتًا يَموتُ. <verse eid="JDG 21:5" /><verse number="6" style="v" pubnumber="6" sid="JDG 21:6" />ونَدِمَ بَنو إِسرائيلَ على ما فعَلوا بِقبيلةِ بنيامينَ إخوتِهِم وقالوا: ”اليومَ اَنقَطَعَت قبيلةٌ مِنْ بَني إِسرائيلَ، <verse eid="JDG 21:6" /><verse number="7" style="v" pubnumber="7" sid="JDG 21:7" />فماذا نفعَلُ لِيكونَ نِساءٌ لِلرِّجالِ الّذينَ بَقَوا مِنهُم أحياءَ، ونحنُ حَلَفْنا بالرّبِّ أنْ لا نُعطيَهُم مِنْ بَناتِنا زَوجاتٍ؟“ <verse eid="JDG 21:7" /><verse number="8" style="v" pubnumber="8" sid="JDG 21:8" />ثُمَّ سألوا: ”أيَّةُ عَشيرَةٍ مِنْ بَني إِسرائيلَ لم تَصعَدْ إلى الرّبِّ في المِصفاةِ؟“ <verse eid="JDG 21:8" /><verse number="9" style="v" pubnumber="9" sid="JDG 21:9" />فتَفَقَّدوا الشَّعبَ فرَأَوا أنَّهُ لم يَحضَرْ أحدٌ مِنْ يابيشَ جِلعادَ. <verse eid="JDG 21:9" /><verse number="10" style="v" pubnumber="10" sid="JDG 21:10" />فأرسلَ المَجمَعُ إلى يابيشَ اَثْني عشَرَ ألفَ رَجُلٍ أشِدَّاءَ وأمَروهُم: ”إذهَبوا واَقتُلوا أهلَ يابيشَ بِحَدِّ السَّيفِ معَ النِّساءِ والأطفالِ. <verse eid="JDG 21:10" /><verse number="11" style="v" pubnumber="11" sid="JDG 21:11" />وهذا ما تعمَلونَهُ: تَقتُلونَ كُلَّ ذَكَرٍ وكُلَّ اَمرَأةٍ ضاجَعَت رَجُلًا“. <verse eid="JDG 21:11" /><verse number="12" style="v" pubnumber="12" sid="JDG 21:12" />فوَجدوا مِنْ سُكَّانِ يابيشَ أربَعَ مئةِ فتاةٍ عذراءَ، فجاءوا بِهِنَّ إلى المَحلَّةِ في شيلوهَ الّتي في أرضِ كنعانَ.<verse eid="JDG 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="JDG 21:13" />وأرسلَ المَجمَعُ إلى بَني بنيامينَ الّذينَ في سَلْعِ رِمُّونَ يَدعونَهُم لِلصُّلحِ. <verse eid="JDG 21:13" /><verse number="14" style="v" pubnumber="14" sid="JDG 21:14" />فجاءَ إليهِم بَنو بنيامينَ في ذلِكَ الوقتِ فأعطَوهُمُ النِّساءَ اللَّواتي لم يَقتُلوهُنَّ مِنْ نِساءِ يابيشَ جِلعادَ، فلم يكُنَّ كافياتٍ. <verse eid="JDG 21:14" /><verse number="15" style="v" pubnumber="15" sid="JDG 21:15" />وأسِفَ الشَّعبُ على بَني بنيامينَ لأنَّ الرّبَّ جعَلَ فَجوَةً في أسباطِ بَني إِسرائيلَ.<verse eid="JDG 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="JDG 21:16" />فقالَ شُيوخُ المَجمَعِ: ”ماذا نفعَلُ بِالباقينَ الّذينَ لم يَحصُلوا على نِساءٍ، والنِّساءُ اَنقَطَعَت في بَني بنيامينَ؟“ <verse eid="JDG 21:16" /><verse number="17" style="v" pubnumber="17" sid="JDG 21:17" />وقالوا: ”ميراثُ بَني بنيامينَ يكونُ لِلنَّاجينَ مِنهُم، فلا يُمْحى سِبْطٌ مِنْ بَني إِسرائيلَ. <verse eid="JDG 21:17" /><verse number="18" style="v" pubnumber="18" sid="JDG 21:18" />أمَّا نحنُ فلا نَقدِرُ أنْ نُزَوِّجَهُم مِنْ بَناتِنا، لأنَّنا حَلَفْنا وقُلْنا: مَلعونٌ مَنْ يُعطي زَوجَةً لأحدٍ مِنْ بَني بنيامينَ“. <verse eid="JDG 21:18" /><verse number="19" style="v" pubnumber="19" sid="JDG 21:19" />ثُمَّ قالوا: ”حانَ عيدُ الرّبِّ السَّنويُّ في شيلوهَ الّتي إلى شَمالِ بَيتَ إيلَ، شرقيَّ الطَّريقِ المُؤدِّيةِ مِنْ بَيتَ إيلَ إلى شكيمَ، جَنوبيَّ لَبونَةَ“. <verse eid="JDG 21:19" /><verse number="20" style="v" pubnumber="20" sid="JDG 21:20" />فأوصَوا بَني بنيامينَ وقالوا لهُم: ”إذهَبوا واَكمُنوا في الكُرومِ <verse eid="JDG 21:20" /><verse number="21" style="v" pubnumber="21" sid="JDG 21:21" />وترَقَّبوا، فإذا خرَجَت بَناتُ شيلوهَ لِلرَّقصِ، فاَخرُجوا مِنَ الكُرومِ واَخطُفوا كُلُّ رَجُلٍ اَمرَأةً مِنهُنَّ، واَذهَبوا إلى أرضِكُم. <verse eid="JDG 21:21" /><verse number="22" style="v" pubnumber="22" sid="JDG 21:22" />فإذا جاءَنا آباؤُهُنَّ وإخوتُهُنَّ لِلشَّكوى نقولُ لهُم: أشفِقوا علَيهِم، كُرْمى لنا، فنَحنُ لم نَغنَمْ في الحربِ زَوجةً لِكُلِّ واحدٍ مِنهُم، ولا أنتُم أعطَيتُموهُنَّ لهُم حتّى تكونوا أثِمتُم بِالرُّجوعِ عَنِ اليمينِ الّتي حَلَفتُموها“. <verse eid="JDG 21:22" /><verse number="23" style="v" pubnumber="23" sid="JDG 21:23" />ففعَلَ بَنو بنيامينَ كذلِكَ واَتَّخَذوا نِساءً بِحسَبِ عَدَدِهِم مِنَ الرَّاقِصاتِ اللَّواتي اَختَطَفوهُنَّ. واَنصَرَفوا ورجَعوا إلى ميراثِهِم وبَنوا المُدُنَ وسَكَنوها. <verse eid="JDG 21:23" /><verse number="24" style="v" pubnumber="24" sid="JDG 21:24" />ثُمَّ رحَلَ بَنو إِسرائيلَ مِنْ هُناكَ، كُلُّ واحدٍ إلى قبيلَتِهِ وعَشيرَتِهِ وأرضِهِ.<verse eid="JDG 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="JDG 21:25" />وفي تلكَ الأيّامِ لم يكُن لِبَني إِسرائيلَ مَلِكٌ، وكانَ كُلُّ واحدٍ مِنهُم يعمَلُ على هَواهُ.<verse eid="JDG 21:25" /></para>
  <chapter eid="JDG 21" />
</usx>