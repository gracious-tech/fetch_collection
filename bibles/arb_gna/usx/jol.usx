  <para style="toc3">يوء</para>
  <para style="toc1">يوئيل</para>
  <para style="toc2">يوئيل</para>
  <para style="mt1">يوئيل</para>
  <chapter number="1" style="c" sid="JOL 1" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JOL 1:1" />هذِهِ كلِمَةُ الرّبِّ الّتي كلَّمَ بها يوئيلَ بنَ فَنوئيلَ:<verse eid="JOL 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="JOL 1:2" />إسمعوا هذا أيُّها الشُّيوخُ، وأصغوا يا جميعَ سُكَّانِ الأرضِ! هل حدثَ مِثلُ هذا في أيّامِكُم أو في أيّامِ آبائِكُم؟<verse eid="JOL 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="JOL 1:3" />أخبروا بهِ بَنيكُم، وليُخبِرْ بَنوكُم بَنيهِم، وبَنوهُمُ الأجيالَ الآتيةَ.<verse eid="JOL 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="JOL 1:4" />فَضلَةُ الزَّحَّافِ أكلَها الجرادُ، وفَضلَةُ الجرادِ أكلَها الجُندُبُ، وفَضلَةُ الجُندُبِ أكلَها النَّملُ.<verse eid="JOL 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="5" sid="JOL 1:5" />أفيقوا أيُّها السَّكارى، واَبكوا وولوِلوا يا جميعَ شاربي الخمرِ، على عصيرِ الكرمةِ لأنَّهُ اَنقطعَ عنْ أفواهِكُم.<verse eid="JOL 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="JOL 1:6" />صَعِدتْ أمَّةٌ على أرضي. هيَ قويَّةٌ ولا عددَ لها: أسنانُها أسنانُ الأسودِ، ولها أنيابُ اللَّبوةِ. <verse eid="JOL 1:6" /><verse number="7" style="v" pubnumber="7" sid="JOL 1:7" />دمَّرت كرمي وقصَفَت تيني. قشَّرتْهُ وطرحَتْهُ فاَبيضَّت أغصانُهُ.<verse eid="JOL 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" pubnumber="8" sid="JOL 1:8" />إنتحبي يا أرضي كعذراءَ اتَّزَرَت بالمِسْحِ على عريسِ صِباها. <verse eid="JOL 1:8" /><verse number="9" style="v" pubnumber="9" sid="JOL 1:9" />اَنقطعتِ التَّقدِمةُ وسكيبُ الخمرِ عَنْ بَيتِ الرّبِّ، والكهَنةُ خُدَّامُ الرّبِّ أخذوا ينوحونَ.<verse eid="JOL 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="JOL 1:10" />خربتِ البرِّيَّةُ وناحتِ الأرضُ، فالحنطةُ تلِفَت والخمرُ نضبت والزَّيتُ نقصَ.<verse eid="JOL 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JOL 1:11" />خَزِيَ الفلَّاحونَ ووَلوَلَ الكرَّامونَ على الحِنطةِ والشَّعيرِ، لأنَّ حَصادَ الحقلِ بادَ. <verse eid="JOL 1:11" /><verse number="12" style="v" pubnumber="12" sid="JOL 1:12" />الكرمُ يَبِسَ، والتِّينُ ذبُلَ، والرُّمانُ والنَّخيلُ والتُّفَّاحُ وجميعُ أشجارِ البرِّيَّةِ ذوت، فذوَى السُّرورُ عنْ بَني البَشَرِ.<verse eid="JOL 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" pubnumber="13" sid="JOL 1:13" />إتَّزِروا بالمُسوحِ واَندُبوا أيُّها الكهَنةُ. وَلوِلوا يا خُدَّامَ المذبَحِ. أدخلوا الهَيكلَ وبيتوا بالمُسوحِ يا خُدَّامَ إلهي. بَيتُ إلهِنا مَحرومٌ منَ التَّقدِمةِ وسكيبِ الخمرِ. <verse eid="JOL 1:13" /><verse number="14" style="v" pubnumber="14" sid="JOL 1:14" />تقدَّسوا للصَّومِ ونادوا على الصَّلاةِ. إجمعوا الشُّيوخَ وجميعَ سُكَّانِ هذِهِ الأرضِ إلى بَيتِ الرّبِّ إلهِكُم واَصرخوا إليهِ.<verse eid="JOL 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="JOL 1:15" />يا لهُ منْ يومٍ! يومُ الرّبِّ قريبٌ. يأتي كالخرابِ منْ عندِ القديرِ.<verse eid="JOL 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" pubnumber="16" sid="JOL 1:16" />أما اَنقطعَ الطَّعامُ أمامَ عُيونِنا؟ أما زالَ الفرحُ والاَبتهاجُ مِنْ بَيتِ إلهِنا؟<verse eid="JOL 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="JOL 1:17" />جَفَّتِ البُذورُ في الأرضِ الخِصْبةِ، وخلَتِ المخازِنُ، واَنهدمتِ الأهراءُ لأنَّ الحِنطةَ نفدَت.<verse eid="JOL 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="JOL 1:18" />كمْ تَئِنُّ البهائمُ! قطعانُ البقَرِ قَلَّ لبَنُها ولا مرعى لها. وقُطعانُ الغَنمِ أيضًا قَلَّما تجِدُ مرعىً.<verse eid="JOL 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" pubnumber="19" sid="JOL 1:19" />إليكَ يا ربُّ أدعو. النَّارُ أكلَت مراتِعَ البرِّيَّةِ، واللَّهيبُ أحرقَ جميعَ أشجارِ الحقلِ.<verse eid="JOL 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" pubnumber="20" sid="JOL 1:20" />بهائِمُ البرِّيَّةِ أيضًا تميلُ إليكَ، لأنَّ مجاريَ المياهِ نضَبت والنَّارُ أكلَت مراتِعَ البرِّيَّةِ.<verse eid="JOL 1:20" /></para>
  <chapter eid="JOL 1" />
  <chapter number="2" style="c" sid="JOL 2" />
  <para style="s1">إقتراب يوم الرّبّ</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JOL 2:1" />أُنفخوا في البُوقِ في صِهيونَ. إهتِفوا في جبلي المُقدَّسِ إرتعِدوا يا جميعَ سُكَّانِ الأرضِ. يومُ الرّبِّ مُقبلٌ وهوَ قريبٌ: <verse eid="JOL 2:1" /><verse number="2" style="v" pubnumber="2" sid="JOL 2:2" />يومُ ظُلمةٍ وغروبٍ! يومُ غَيمٍ وضبابٍ!</para>
  <para style="p" vid="JOL 2:2">ها شعبٌ كثيرٌ عظيمٌ. ينتشرونَ كالعتمةِ على الجبالِ. ما كانَ لهُم شَبيهٌ منذُ الأزَلِ، ولا يكونُ لهُم مِنْ بَعدُ إلى جيلٍ فجيلٍ.<verse eid="JOL 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="3" sid="JOL 2:3" />النَّارُ تأكُلُ ما أمامَهُم واللَّهيبُ يلتهِمُ ما خلفَهُم. الأرضُ أمامَهُم كجنَّةِ عَدْنٍ، وخلفَهُم كبرِّيَّةِ قفرٍ، ولا ينجو مِنهُم شيءٌ.<verse eid="JOL 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="JOL 2:4" />كمنظَرِ الخَيلِ مَنظرُهُم، وكالفُرسانِ الّذينَ يركُضونَ. <verse eid="JOL 2:4" /><verse number="5" style="v" pubnumber="5" sid="JOL 2:5" />يقفزونَ على رُؤوسِ الجِبالِ، كالعجَلاتِ صريرُهُم، وكصوتِ لهيبِ النَّارِ الّتي تأكلُ القَشَّ، وكجيشٍ عظيمٍ مُحتشِدٍ للقتالِ.<verse eid="JOL 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" pubnumber="6" sid="JOL 2:6" />أمامَهُم تَجبُنُ الشُّعوبُ، ومِنَ الخوفِ تصفرُّ جميعُ الوجوهِ.<verse eid="JOL 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" pubnumber="7" sid="JOL 2:7" />كالجَبابرةِ يركُضونَ. كرجالِ الحربِ يتسلَّقونَ السُّورَ. كُلُّهُم يسيرُ في طريقِهِ وعنْ سُبُلِهِ لا يَحيدُ. <verse eid="JOL 2:7" /><verse number="8" style="v" pubnumber="8" sid="JOL 2:8" />لا يتزاحمونَ. يسيرونَ كُلُّ واحدٍ في سبيلِهِ.</para>
  <para style="p" vid="JOL 2:8">بَينَ السِّلاحِ ينقضُّونَ ولا يقَعونَ. <verse eid="JOL 2:8" /><verse number="9" style="v" pubnumber="9" sid="JOL 2:9" />ينساقونَ إلى المدينةِ. يتراكَضونَ على السُّورِ. يَصعَدونَ إلى البيوتِ. يَدخلونَ مِنَ النَّوافِذِ كاللُّصوصِ.<verse eid="JOL 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" pubnumber="10" sid="JOL 2:10" />أمامَهُم ترتجِفُ الأرضُ وترتعِشُ السَّماواتُ. تَسوَدُّ الشَّمسُ والقمرُ، وتمنعُ الكواكبُ ضياءَها.<verse eid="JOL 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JOL 2:11" />الرّبُّ يجهَرُ بصوتِهِ أمامَ جيشِهِ. جُندُهُ كثيرٌ قويٌّ يعملُ بكلِمَتِهِ. يومُ الرّبِّ عظيمٌ مُخيفٌ لا ينتهي.<verse eid="JOL 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" pubnumber="12" sid="JOL 2:12" />يقولُ الرّبُّ. ”توبوا إليَّ بكُلِّ قلوبِكُم، بالصَّومِ والبُكاءِ والنَّدْبِ. <verse eid="JOL 2:12" /><verse number="13" style="v" pubnumber="13" sid="JOL 2:13" />مزِّقوا قلوبَكُم لا ثيابَكُم“.</para>
  <para style="p" vid="JOL 2:13">فتوبوا إلى الرّبِّ. الرّبُّ حنونٌ رحومٌ. بطيءٌ عنِ الغضَبِ، كثيرُ الرَّحمةِ، نادمٌ على السُّوءِ، <verse eid="JOL 2:13" /><verse number="14" style="v" pubnumber="14" sid="JOL 2:14" />لعلَّهُ يرجِعُ ويندمُ ويُبقي وراءَهُ بَركَةً، فتُقَرِّبونَ تَقدِمةً وسكيبَ خمرٍ للرّبِّ إلهِكُم.<verse eid="JOL 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="JOL 2:15" />أُنفخوا في البُوقِ في صِهيونَ، وتقدَّسوا للصَّومِ ونادوا على الصَّلاةِ. <verse eid="JOL 2:15" /><verse number="16" style="v" pubnumber="16" sid="JOL 2:16" />إجمعوا الشَّعبَ وقدِّسوا الجماعةَ. أُحشدوا الشُّيوخَ واَجمعوا الصِّغارَ والأطفالَ. أخرِجوا العريسَ مِنْ مخدعِهِ والعروسَ من خِدْرِها.<verse eid="JOL 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" pubnumber="17" sid="JOL 2:17" />بَينَ الرِّواقِ والمذبَحِ يبكي الكهَنةُ، خُدَّامُ الرّبِّ، ويقولونَ: ”أشفِقْ يا ربُّ على شعبِكَ وميراثِكَ. لا تجعلْهُ عارًا فتتسلَّطَ علَيهِ الأمَمُ ويُقالُ في الشُّعوبِ: أينَ إلهُكَ؟“<verse eid="JOL 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="JOL 2:18" />غارَ الرّبُّ على أرضِهِ وأشفَقَ على شعبِهِ. <verse eid="JOL 2:18" /><verse number="19" style="v" pubnumber="19" sid="JOL 2:19" />قالَ لهُم: ”ها أنا أُرسِلُ إليكُمُ القمحَ والخمرَ والزَّيتَ، فتَشبعونَ مِنها ولا أجعلُكُم مِنْ بَعدُ عارًا في الأُمَمِ، <verse eid="JOL 2:19" /><verse number="20" style="v" pubnumber="20" sid="JOL 2:20" />بل أُبعِدُ عنكُمُ الآتي مِنَ الشَّمالِ، وأطردُهُ إلى أرضٍ قاحلةٍ مُقفِرةٍ، ووجهُهُ إلى البحرِ الشَّرقيِّ وظهرُهُ إلى البحرِ الغربيِّ، فيصعَدُ نَتْنُهُ وتَنبعِثُ رائِحتُهُ الكريهةُ لأنَّهُ اَرتكبَ الفظائعَ“.<verse eid="JOL 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" pubnumber="21" sid="JOL 2:21" />لا تخافي أيَّتُها التُّربةُ. إبتهجي واَفرحي لأنَّ الرّبَّ عمِلَ العظائمَ.<verse eid="JOL 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" pubnumber="22" sid="JOL 2:22" />لا تخافي يا بهائِمَ الحقلِ. مراعي البرِّيَّةِ نبتَت، والشَّجَرُ أطلَعَ ثمرَهُ، والتِّينُ والكَرمُ أعطيا قوّتَهُما.<verse eid="JOL 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" pubnumber="23" sid="JOL 2:23" />وأنتُم يا بَني صِهيونَ اَبتهِجوا واَفرَحوا بالرّبِّ إلهِكُم. أعطاكُمُ المَطرَ المُبكِّرَ بعَدلٍ، وأنزلَ لكُمُ المَطرَ المُبكِّرَ والمُتأخِّرَ كما مِنْ قَبلُ. <verse eid="JOL 2:23" /><verse number="24" style="v" pubnumber="24" sid="JOL 2:24" />فستمتلئُ البيادرُ حِنطةً، وتَفيضُ المعاصِرُ خمرًا وزيتًا.<verse eid="JOL 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" pubnumber="25" sid="JOL 2:25" />وأُعوِّضُ لكُم عَنِ السِّنينَ الّتي أكلَ قوتَها الجرادُ والجُندُبُ والنَّملُ والزَّحَّافُ، وهيَ جيشي العظيمُ الّذي أرسلتُهُ علَيكُم، <verse eid="JOL 2:25" /><verse number="26" style="v" pubnumber="26" sid="JOL 2:26" />فتأكلونَ وتَشبعونَ وتُهلِّلونَ لاَسمِ الرّبِّ إلهِكُمُ الّذي صنعَ معكُمُ العجائبَ. فشعبي لا يَخزَى أبدًا. <verse eid="JOL 2:26" /><verse number="27" style="v" pubnumber="27" sid="JOL 2:27" />فتعلمونَ أنِّي في وسَطِ شعبِ إِسرائيلَ، وأنِّي أنا الرّبُّ إلهُكُم ولا أحدَ غيري، فشعبي لا يَخزَى أبدًا.<verse eid="JOL 2:27" /></para>
  <chapter eid="JOL 2" />
  <chapter number="3" style="c" sid="JOL 3" />
  <para style="s1">الرّبّ يدين الأمم</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JOL 3:1" />أفيضُ روحي على كُلِّ بشَرٍ، فيتنبَّأُ بَنوكُم وبَناتُكُم، ويحلَمُ شيوخُكُم أحلامًا، ويرَى شُبَّانُكُم رؤىً.<verse eid="JOL 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" pubnumber="2" sid="JOL 3:2" />وعلى عبيدي أيضًا، نِساءً ورجالًا، أفيضُ روحي في تلكَ الأيّامِ. <verse eid="JOL 3:2" /><verse number="3" style="v" pubnumber="3" sid="JOL 3:3" />وأصنعُ عجائبَ في السَّماءِ وعلى الأرضِ، دَمًا ونارًا وأعمدةَ دُخانٍ، <verse eid="JOL 3:3" /><verse number="4" style="v" pubnumber="4" sid="JOL 3:4" />فتنقلِبُ الشَّمسُ ظلامًا، والقمرُ دَمًا قَبلَ أنْ يأتيَ يومُ الرّبِّ العظيمُ الهائلُ، <verse eid="JOL 3:4" /><verse number="5" style="v" pubnumber="5" sid="JOL 3:5" />وكُلُّ مَنْ يدعو باَسمِ الرّبِّ يخلُصُ. ففي جبَلِ صِهيونَ وفي أورُشليمَ يَنجو مَنْ يَنجو معَ الباقينَ الّذينَ يدعوهُمُ الرّبُّ.<verse eid="JOL 3:5" /></para>
  <chapter eid="JOL 3" />
  <chapter number="4" style="c" sid="JOL 4" />
  <para style="s1">الله ديّان الشعوب</para>
  <para style="p">
    <verse number="1" style="v" pubnumber="1" sid="JOL 4:1" />فها أنا في تلكَ الأيّامِ وفي ذلِكَ الزَّمانِ، حينَ أُعيدُ سُكَّانَ يَهوذا وأُورُشليمَ مِنَ السَّبي، <verse eid="JOL 4:1" /><verse number="2" style="v" pubnumber="2" sid="JOL 4:2" />أحشدُ جميعَ الأُمَمِ وأُنزِلُهُم إلى وادي يوشافاطَ وأُحاكِمهُم هُناكَ مِنْ أجلِ شعبي وميراثي إِسرائيلَ، لأنَّهُم فَرَّقوهم بَينَ الأُمَمِ واَقتسموا أرضي، <verse eid="JOL 4:2" /><verse number="3" style="v" pubnumber="3" sid="JOL 4:3" />وألقَوا القُرعةَ على شعبي، وقايضوا الصَّبيَّ بالزَّانيةِ، وباعوا الصَّبيَّةَ بالخمرِ ليشربوا.<verse eid="JOL 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" pubnumber="4" sid="JOL 4:4" />فما أنتمُ لي يا سُكَّانَ صورَ وصيدونَ وجميعِ بقاعِ الفلِسطيِّينَ؟ أهذا عِرفانُكُم للجميلِ؟ إنْ كانَ هذا عِرفانُكُمُ الجميلَ، فما أسرعَ ما أردُّ جميلَكُم شَرًّا على رؤوسِكُم. <verse eid="JOL 4:4" /><verse number="5" style="v" pubnumber="5" sid="JOL 4:5" />فأنتمُ أخذتُم فِضَّتي وذهبي وحملتُم مِنِّي ما غلا وطابَ إلى هياكِلِكُم. <verse eid="JOL 4:5" /><verse number="6" style="v" pubnumber="6" sid="JOL 4:6" />وبعتُم بَني يَهوذا وأهلَ أُورُشليمَ عبيدًا لليونانيِّين لتُبعِدوهم عَنْ تُخُومِهِم. <verse eid="JOL 4:6" /><verse number="7" style="v" pubnumber="7" sid="JOL 4:7" />لكنِّي أطلُبُهُم مِنَ الموضِعِ الّذي بعتموهُم فيهِ وأردُّ شَرَّ جميلِكُم على رؤوسِكُم، <verse eid="JOL 4:7" /><verse number="8" style="v" pubnumber="8" sid="JOL 4:8" />وأبيعُ بَنيكُم وبَناتِكُم بأيدي بَني يَهوذا، فيبيعونَهُم للسَّبئيِّينَ، تلكَ الأمَّةِ البعيدةِ. أنا الرّبُّ تكلَّمْتُ.<verse eid="JOL 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" pubnumber="9" sid="JOL 4:9" />نادوا بهذا في الأُمَمِ. تأهَّبوا للقتالِ وحمِّسوا الجبَابرةَ. تقدَّموا أيا جميعَ رجالِ الحربِ، واَصعدوا. <verse eid="JOL 4:9" /><verse number="10" style="v" pubnumber="10" sid="JOL 4:10" />إجعلوا سُكَككُم سيوفًا ومناجِلَكُم رِماحًا وليقُلِ الضَّعيفُ مِنكُم: أنا جبَّارٌ.<verse eid="JOL 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" pubnumber="11" sid="JOL 4:11" />تعالَوا أغيثونا، يا جميعَ الأُمَمِ المجاورةِ واَحتشِدوا هُناكَ. أنزِلْ يا ربُّ جبَابرتَكَ. <verse eid="JOL 4:11" /><verse number="12" style="v" pubnumber="12" sid="JOL 4:12" />أغيروا أيُّها الأُمَمُ واَصعدوا إلى وادي يوشافاطَ، أنا هُناكَ جالسٌ لأدينَ الأُمَمَ المجاورةَ فما أكثرَ ما أساؤوا. <verse eid="JOL 4:12" /><verse number="13" style="v" pubnumber="13" sid="JOL 4:13" />والآنَ أَعْمِلوا المِنجلَ فالحصيدُ نضجَ. تعالَوا دوسوا فتمتلئَ المَعصرةُ وتفيضَ الخوابي.<verse eid="JOL 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" pubnumber="14" sid="JOL 4:14" />إلى وادي حروصَ يا جماهيرُ يا جماهيرُ، فيومُ الرّبِّ اَقتربَ في وادي حروصَ.<verse eid="JOL 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" pubnumber="15" sid="JOL 4:15" />تَسوَدُّ الشَّمسُ والقمرُ وتمنَعُ الكواكبُ ضياءَها. <verse eid="JOL 4:15" /><verse number="16" style="v" pubnumber="16" sid="JOL 4:16" />يزأرُ الرّبُّ مِنْ صِهيونَ، ومِنْ أُورُشليمَ يُطلِقُ صوتَهُ، فترتعِشُ السَّماواتُ والأرضُ، ويكونُ الرّبُّ حِمَى لشعبِهِ بَني إِسرائيلَ وحصنًا لهُم. <verse eid="JOL 4:16" /><verse number="17" style="v" pubnumber="17" sid="JOL 4:17" />فتعرفونَ أنِّي أنا الرّبُّ إلهُكُمُ السَّاكِنُ في صِهيونَ جبَلي المُقدَّسِ، وتكونُ أُورُشليمُ مكانًا مُقدَّسًا، ولا يَعبرُ فيها الأجنبيُّ مِنْ بَعدُ.<verse eid="JOL 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" pubnumber="18" sid="JOL 4:18" />وفي ذلِكَ اليومِ تطفو الخمرُ على الجبالِ، ويجري اللَّبنُ في التِّلالِ، وجميعُ سواقي يَهوذا تسيلُ مياهًا، ويخرجُ معينٌ مِنْ بَيتِ الرّبِّ ويسقي وادي شطيمَ. <verse eid="JOL 4:18" /><verse number="19" style="v" pubnumber="19" sid="JOL 4:19" />وتكونُ مِصْرُ خرابًا، وأدومُ برِّيَّةً مُقفِرةً، لأنَّ سُكَّانَها عنَّفوا بَني يَهوذا، وسَفكوا الدَّمَ الزَّكيَّ في أرضِهِم. <verse eid="JOL 4:19" /><verse number="20" style="v" pubnumber="20" sid="JOL 4:20" />وأمَّا يَهوذا فتَعمُرُ إلى الأبدِ، وأُورُشليمُ إلى جِيلٍ فجِيلٍ، <verse eid="JOL 4:20" /><verse number="21" style="v" pubnumber="21" sid="JOL 4:21" />وأنتقمُ لِدَمِهِم ولا أُبرِئُ سافكيهِ، وأسكُنُ أنا الرّبُّ في صِهيونَ.<verse eid="JOL 4:21" /></para>
  <chapter eid="JOL 4" />
</usx>