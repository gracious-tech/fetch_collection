<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- TarifitABS</book>
  <para style="h">أَيث-ݣلاطيا</para>
  <para style="toc3">ݣل</para>
  <para style="toc2">أيث-ݣلاطيا</para>
  <para style="toc1">ثَبْرَات ن اَرَّاسُوْل بُوْلُس غَار أَيث-ݣَلَاطْيَا</para>
  <para style="mt1">ثَبْرَات ن اَرَّسُوْل بُوْلُس غَار أَيث-ݣَلَاطْيَا</para>
  <chapter number="1" style="c" sid="GAL 1" />
  <para style="s1">لْمُقَدِّمَا</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1" />نش ذ بُوْلُس، نش ذ يجّن ن اَرَّسُوْل ماشي س يِوْذَان نِغ س ڒْخَاضَر ن بْنَاذم؛ لَّا، نش ذ اَرَّسُوْل س عِيْسَى لْمَسِيح أُو عَاوذ س أَربِّـي بَابَاثْنغ إِي د يسكَّرن عِيْسَى زِي ڒْموْث. <verse eid="GAL 1:1" /><verse number="2" style="v" sid="GAL 1:2" /><char style="it">تَارِيغ ثَبْرَات-أَ</char> نش ذ مَارَّا أَيثْمَا يدْجَان اَكِذِي غَار ثْجُوْمَاع ن ڒْمُوْمِنِين يدْجَان ذِي جْوَايه ن ݣَلَاطْيَا.<verse eid="GAL 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3" />أَكِذْوم يِيڒِي اَرْضَا ذ ڒهْنَا زِي أَربِّـي بَابَاثْنغ ذ عِيْسَى لْمَسِيح سِيذِيثْنغ. <verse eid="GAL 1:3" /><verse number="4" style="v" sid="GAL 1:4" />لْمَسِيح يصدّق يخف نّس خ ڒْمُعْصِيّث نّغ س ڒْخَاضَر ن أَربِّـي بَابَاثْنغ حمَا اَذَانغ يسنْجم زِي زْمَان-أَ اَعفَّان إِي ذِي ندْجَا. <verse eid="GAL 1:4" /><verse number="5" style="v" sid="GAL 1:5" />أَغَارس ثِيڒِي لْعَظَمَا إِ نتَّا إِ ڒبْدَا ن ڒبْدَاث. آمِين.<verse eid="GAL 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6" />نش ستْعجِّيبغ ذَايْوم، ذغْيَا ثْسمْحم ذِي أَربِّـي إِي ذَاوم د يڒَاغَان س اَرْضَا ن لْمَسِيح ثْذفَّارم شَان ن لإِنْجِيل نّغْنِي مْزُوَّار! <verse eid="GAL 1:6" /><verse number="7" style="v" sid="GAL 1:7" />وَلَكِن وَار ذِنِّي بُو شَان ن لإِنْجِيل نّغْنِي. غِير ذِنِّي شَان يِوْذَان إِي كنِّيو يسْخرْوَاضن رزُّوْن اَذ سْعوّْجن لإِنْجِيل ن لْمَسِيح. <verse eid="GAL 1:7" /><verse number="8" style="v" sid="GAL 1:8" />وَلَكِن نشِّين مڒَا نْبشَّر-يكنِّيو نِغ يبشَّر-يكنِّيو شَان ن لْمَلَاك زݣ وجنَّا س شَان ن لإِنْجِيل نّغْنِي مَاشِي س ونِّي إِي زِي كنِّيو نْبشَّر زِي قْبڒ، أَتَاف ونِّي إِي كنِّيو غَا يبشَّرن اَذ يتْوَانْعڒ! <verse eid="GAL 1:8" /><verse number="9" style="v" sid="GAL 1:9" />مَامّش ذَاوم ننَّا زِي قْبڒ اَذَاوم ث عَاوْذغ نش ڒخُّو: مڒَا شَان يِجّن يبشَّر-يكنِّيو س شَان لإِنْجِيل نّغْنِي مَاشِي ذ ونِّي إِي تُوْغَا ثْقبْڒم، أَتَاف اَذ يتْوَانْعڒ!<verse eid="GAL 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10" />شُوْف، نش مَا رزُّوْغ ڒخُّو اَخَافِي اَرْضَان يِوْذَان؟ لَّا، رزُّوْغ اَخَافِي يَارْضَا أَربِّـي! مَا نش رزُّوْغ اَذَاسن عجْبغ إِ يِوْذَان؟ لَّا، مَعْلِيك عَاذ رزُّوْغ اَذَاسن عجْبغ إِ يِوْذَان، أَتَاف نش وَار دْجِيغ شَا ذ اَخدَّام ن لْمَسِيح.<verse eid="GAL 1:10" /></para>
  <para style="s1">سِيدْنَا بُوْلُس نتَّا ذ اَرَّسُوْل ن أَربِّـي</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11" />فَا آي أَيثْمَا، يتْخصَّا-كنِّيو اَذ تسّْنم بلِّي لإِنْجِيل نِّي إِي زِي كنِّيو بشَّرغ قَا نتَّا وَار د يُوْسِي شَا زِي بْنَاذم. <verse eid="GAL 1:11" /><verse number="12" style="v" sid="GAL 1:12" />وَار ذَايِي د يُوْسِي زِي حَدّ، وَار ذَايِي ث سْڒمْذن شَا يِوْذَان؛ لَّا، نتَّا يهْوَا-د خَافِي ذ لْوَاحِي زِي عِيْسَى لْمَسِيح.<verse eid="GAL 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13" />أَقَا ثسْڒِيم خَافِي مَامّش تُوْغَا تْعِيشغ زِي قْبڒ وَامِي تُوْغَا تْبَاعغ دِّين ن أَيث-إِسْرَائِيل، يعْنِي مَامّش تُوْغَا تْعدَّابغ جْمَاعث ن ڒْمُوْمِنِين ن أَربِّـي س ومنْغِي، رزُّوْغ اَخَاسن قْضِيغ. <verse eid="GAL 1:13" /><verse number="14" style="v" sid="GAL 1:14" />تُوْغَا نش تْݣَعَّاذغ مْلِيح ذِي دِّين ن أَيث-إِسْرَائِيل عْڒَاين قَاع حْسن زݣ يقْرِينن ينُو. تُوْغَا نش رزُّوْغ اَطَّاس اَذ ݣّغ لْوَاجِب عْلَاحْسَاب لْعَادَاث ن ڒجْذُوْذ ينُو. <verse eid="GAL 1:14" /><verse number="15‏-16" style="v" sid="GAL 1:15-16" />وَلَكِن أَربِّـي زِي قْبڒ تُوْغَا يعْزڒ-اَيِي نش يعْنِي يخْضَر-اَيِي ذݣ وعدِّيس ن يمَّا سّنِّي يڒَاغَا-ٱيِي-د س اَرْضَا نّس. وَامِي خَافِي يَارْضَا نتَّا، يسضْهَار-اَيِي-د مِّيس حمَا اَزَّايس بشَّرغ جَار ڒݣْنُوْس. ڒخْدّنِّي وَار مْشَاوَارغ اَك حَدّ. <verse eid="GAL 1:15-16" /><verse number="17" style="v" sid="GAL 1:17" />وَار ݣَعّْذغ شَا غَار ثنْدِينْت ن لْقُدْس بَاش اَذ ࢲرغ يِنِّي تُوْغَا يدْجَان ذ اَرُّسُل قْبڒ إِ نش. لَّا، نش رُوْحغ نِيشَان غَار ثْمُوْرْث ن وَاعْرَابن أُو سّنِّي ذوْڒغ-د عَاوذ غَار ثنْدِينْت ن دِمَشق.<verse eid="GAL 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 1:18" />ثعْذُو يجّن ثڒْت سْنِين ݣَعّْذغ غَار ثنْدِينْت ن لْقُدْس حمَا اَذ ࢲرغ اَرَّسُوْل بُطْرُس، قِّيمغ اَكِذس يجّن خمّسطَاشَر يوْم. <verse eid="GAL 1:18" /><verse number="19" style="v" sid="GAL 1:19" />نش ذِنِّي وَار ࢲْرِيغ ؤُڒَا ذ يجّن ن اَرَّسُوْل نّغْنِي غِير يَعْقُوْب ؤُمَاس ن سِيذِيثْنغ. <verse eid="GAL 1:19" /><verse number="20" style="v" sid="GAL 1:20" />مِين ذَاوم د تَارِيغ، تَارِيغ-ث-يذ أُو أَربِّـي يخزَّر ذَايِي وَار يدْجِي بُو ذ يخَرِّيقن. <verse eid="GAL 1:20" /><verse number="21" style="v" sid="GAL 1:21" />منْبَعْذ رُوْحغ غَار سُوْرْيَا ذ لْإِقْلِيم ن كِلِيكْيَا. <verse eid="GAL 1:21" /><verse number="22" style="v" sid="GAL 1:22" />تُوْغَا نش عَاذ وَار ذَايِي سِّينن شَا ذݣ وغمْبُوْب ينُو ثِجُوْمَاع ن ڒْمُوْمِنِين ن لْمَسِيح ذِي ثْمُوْرْث ن يَهُوْذِيَا. <verse eid="GAL 1:22" /><verse number="23" style="v" sid="GAL 1:23" />نِثْنِي غِير تسْڒَان خَافِي قَا بُوْلُس نِّي إِي تُوْغَا ذَانغ يتْعدَّابن زِي قْبڒ ڒخُّو نتَّا يتْبشَّار س لإِنْجِيل نِّي إِي خف يرزُّو اَذ يقْضَا. <verse eid="GAL 1:23" /><verse number="24" style="v" sid="GAL 1:24" />سّنِّي أُوْشَا حمّْذن أَربِّـي خَافِي.<verse eid="GAL 1:24" /></para>
  <chapter eid="GAL 1" />
  <chapter number="2" style="c" sid="GAL 2" />
  <para style="s1">أَرَّسُوْل بُوْلُس قبّْڒن-ث اَرُّسُل نّغْنِي</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1" />وَامِي ثعْذُو يجّن اَرْبعْطَاشَر سْنَا، ݣَعّْذغ عَاوذ غَار ثنْدِينْت ن لْقُدْس اَك بَرْنَابَا، ؤُوِيغ اَكِذِي ؤُڒَا ذ <char style="it">ؤُمَاثْنغ</char> تِيتُوْس. <verse eid="GAL 2:1" /><verse number="2" style="v" sid="GAL 2:2" />عْلَاحْسَاب مِين زِي ذَايِي يوصَّا أَربِّـي ذݣ يِجّن ن لْوَاحِي إِي ݣَعّْذغ ذِنِّي سخْبَارغ-ثن خ لْإِنْجِيل إِي زِي تْبشَّارغ جَار ڒݣْنُوْس. وَلَكِن ݣِّيغ مَانَاينِّي غِير إِ يِنِّي يدْجَان ذ يمقّْرَانن <char style="it">ن جْمَاعث</char> حمَا اَذ سّْنغ مِين خذْمغ ذ مِين تُوْغَا خدّْمغ وَار يدْجِي شَا ذ ڒْبَاطڒ. <verse eid="GAL 2:2" /><verse number="3" style="v" sid="GAL 2:3" />تِيتُوْس يدْجَان ذ اَمْعَاشَر ينُو، وَاخَّا نتَّا ذ اَيُوْنَانِي وَار خَاس زيَّارن شَا حمَا اَذ يݣّ طَّهَارث. <verse eid="GAL 2:3" /><verse number="4" style="v" sid="GAL 2:4" />رزُّوْن خَاس خ مَانَاينِّي شَان ن وَاوْمَاثن زَعْمَا تْبُوْصَارن وَاهَا، ؤُذْفن-د جَارَانغ س ثْنُوْفْرَا حمَا اَذ جسّْسن خ لْحُرِّيَا إِي غَارْنغ ذِي لْمَسِيح بَاش اَذَانغ اَرّن اَم يسمْغَان <char style="it">إِ شَّرِيعَا نْسن</char>. <verse eid="GAL 2:4" /><verse number="5" style="v" sid="GAL 2:5" />وَلَكِن نشِّين نُوْݣِي اَذَاسن نݣّ اَرَّاي ؤُڒَا ذ يجّن ن دْقِيقث حمَا اَذ تقِّيم اَكِذْوم لْحَقِيقَا ن لْإِنْجِيل.<verse eid="GAL 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6" />أَمَّا يِنِّي تْغِير-اَوم ذ يمقّْرَانن خَاوم، نِثْنِي وَار اَرْنِين ؤُڒَا ذ يجّن ن وَاوَاڒ زِي مِين بشَّرغ نش. قَّارغ مَانَايَا، مِين مَا عْنَان يِيْنَا غَارِي كِيف-كِيف، يعْنِي أَربِّـي وَار يتݣّ بُو س وُوْذمَاون جَارَانغ. <verse eid="GAL 2:6" /><verse number="7" style="v" sid="GAL 2:7" />وَلَكِن مِين ؤُفِين؟ ؤُفِين يكلّف-اَيِي أَربِّـي بَاش اَذ بشَّرغ إِ ييُوْنَانِيْين مَامّش يكلّف بُطْرُس بَاش اَذ يبشَّر إِ أَيث-إِسْرَائِيل. <verse eid="GAL 2:7" /><verse number="8" style="v" sid="GAL 2:8" />مِينْزِي أَربِّـي إِݣ يسْخدَّامن تّبْشِير ن بُطْرُس اَم اَرَّسُوْل إِ أَيث-إِسْرَائِيل، ذ نتَّا إِݣ يسْخدَّامن عَاوذ تّبْشِير ينُو اَم اَرَّسُوْل إِ يِنِّي يدْجَان ذ ييُوْنَانِيْين. <verse eid="GAL 2:8" /><verse number="9" style="v" sid="GAL 2:9" />يَعْقُوْب ذ بُطْرُس ذ يُوْحَنَّا يتْوَاحْسَابن ذ يمقّْرَانن ذِي جْمَاعث <char style="it">نِّي</char>، فهْمن اَرْضَا إِي ذَايِي يُوْشَا أَربِّـي سدْجْمن خَانغ نش ذ بَرْنَابَا س وفُوْس اَفُوْسِي نْسن اَمْعَاشَر. قبْڒن-اَنغ نشِّين أَ نْرَاح أَ نْبشَّر إِ يِنِّي يدْجَان ذ ييُوْنَانِيْين، نِثْنِي اَذ بشَّرن إِ يِنِّي يدْجَان زِي أَيث-إِسْرَائِيل. <verse eid="GAL 2:9" /><verse number="10" style="v" sid="GAL 2:10" />غِير تَّارن زَّايْنغ أَ نْفكَّار ذݣ يپُـوْبْرِيثن نْسن. مَانَاينِّي رزُّوْغ-ث نِّيث س وُوْڒ ينُو اَث ݣّغ.<verse eid="GAL 2:10" /></para>
  <para style="s1">أَرَّسُوْل بُوْلُس يتْوَاجَاه اَرَّسُوْل بُطْرُس</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11" />فَا وَامِي د يُوْسَا بُطْرُس غَار ثنْدِينْت ن وَانْطَاكْيَا وَاجْهغ-ث اَغمْبُوْب ذݣ وغمْبُوْب لِأَنَّا يݣَّا يجّن ن لْغَالط. <verse eid="GAL 2:11" /><verse number="12" style="v" sid="GAL 2:12" /><char style="it">مِين يعْنَا لْغَالط نِّي؟</char> أَقَا قْبڒ مَا ٱذ د يَاس يجّن ن ڒْحِزب يعْنِي شَان يِوْذَان زِي يَعْقُوْب تُوْغَا بُطْرُس يتتّ اَك ڒْمُوْمِنِين يدْجَان ذ ييُوْنَانِيْين. وَلَكِن وَامِي د يُوْسَا ڒْحِزب نِّي، ئِبْذَا بُطْرُس يتْبعَّاذ خ ييُوْنَانِيْين نِّي ينعْزڒ خَاسن. مَايمِّي؟ لِأَنَّا يݣّْوذ زِي ڒْحِزب نِّي يعْنِي ن طَّهَارث. <verse eid="GAL 2:12" /><verse number="13" style="v" sid="GAL 2:13" />ڒخْدّنِّي ذْفَارن-ث ذِي نِّفَاق نّس يسْرَائِيلِيْين نّغْنِي إِي يُوْمْنن. ؤُڒَا ذ بَرْنَابَا س يِيخف نّس سْبعّْذن-ث زݣ وبْرِيذ نِيشَان ذي نِّفَاق-أَ نْسن.<verse eid="GAL 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 2:14" />وَامِي ثن ࢲْرِيغ وَار ݣُّوْرن شا نِيشَان عْلَاحْسَاب لْحَقِيقَا إِي يدْجَان ذِي لإِنْجِيل، نِّيغ-اَس إِ بُطْرُس زَّاثْسن مَارَّا: شك ذ اَئِسْرَائِيلِي وَلَكِن تْعِيشذ اَمشْنَاو ييُوْنَانِيْين، يعْنِي مَاشِي اَمشْنَاو اَئِسْرَائِلِي. مَامّش غَا ثݣّذ اَذ تْزيَّارذ خ ييُوْنَانِيْين بَاش اَذ عِيشن اَمشْنَاو يسْرَائِيلِيْين؟<verse eid="GAL 2:14" /></para>
  <para style="s1">س لْإِيمَان أُو صَافِي إِي غَا نجْمن يِوْذَان مَاشِي س شَّرِيعَا</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15" />نشِّين ذ يسْرَائِيلِيْين زݣ وَامِي د نخْڒق، نشِّين وَار ندْجِي شَا زِي ڒݣْنُوْس يعصَّان زَعْمَا. <verse eid="GAL 2:15" /><verse number="16" style="v" sid="GAL 2:16" />إِنَّمَا، نسّن بلِّي بْنَاذم وَار يتْوَاسمْصْڒَاح شَا اَك أَربِّـي يعْنِي مڒَا يطَاع إِ شَّرِيعَا ن مُوْسَى؛ لَّا، مَانَايَا إِلَّا س لْإِيمَان زِي عِيْسَى لْمَسِيح. خ مَانَايَا ؤُڒَا ذ نشِّين نُوْمن زِي عِيْسَى لْمَسِيح بَاش أَ نمْصْڒَاح اَك أَربِّـي س لْإِيمَان نِّي إِي زِي نُوْمن، مَاشِي س طَّاعَا ن شَّرِيعَا ن مُوْسَى. لِأَنَّا ؤُڒَا ذ يجّن ن بْنَاذم وَار يتْوَاسمْصْڒَاح شَا اَك أَربِّـي س طَّاعَا ن شَّرِيعَا نِّي.<verse eid="GAL 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 2:17" />فَا نشِّين نْرزُّو أَ نمْصْڒَاح اَك أَربِّـي س لْإِيمَان زِي لْمَسِيح. مڒَا س مَانَايَا منْبَعْد نُوْفَا يخف نّغ اَم ڒݣْنُوْس يعصَّان زَعْمَا، مَا اَتَاف لْمَسِيح يتْشجَّاع-اَنغ غَار ڒْمُعْصِيّث؟ لَّا، عمَّارْص! <verse eid="GAL 2:17" /><verse number="18" style="v" sid="GAL 2:18" />لْعَكْس، نش اَذ يڒِيغ ذ لْعَاصِي مڒَا بْنِيغ عَاوذ نِّظَام نِّي اَقْذِيم ن شَّرِيعَا إِي هذْمغ. <verse eid="GAL 2:18" /><verse number="19" style="v" sid="GAL 2:19" />عْلَاحْسَاب شَّرِيعَا ن مُوْسَى نتَّاث س يِيخف نّس، نش مُّوْثغ زَعْمَا إِ <char style="it">ڒحْكَام ن</char> شَّرِيعَا-يَا <char style="it">خَافِي</char> بَاش اَذ دَّرغ إِ أَربِّـي <char style="it">وَاهَا</char>. <verse eid="GAL 2:19" /><verse number="20" style="v" sid="GAL 2:20" />تْوَاصلّْبغ اَك لْمَسِيح. سَّا اَڒ ثْسَاونْت مَاشِي ذ نش إِ غَا يدَّرن؛ لَّا، ذ لْمَسِيح إِي غَا يدَّرن ذَايِي. ثُوْذَارْث-أَ إِي دَّرغ ڒخُّو ذِي دَّات ينُو، أَقَا دَّرغ-ت س لْإِيمَان ينُو زِي مِّيس ن أَربِّـي إِي ذَايِي يحِبّن يصدّق خَافِي يخف نّس. <verse eid="GAL 2:20" /><verse number="21" style="v" sid="GAL 2:21" />نش ؤُݣِيغ اَذ سْبطّْڒغ اَرْضَا ن أَربِّـي.</para>
  <para style="p" vid="GAL 2:21">شُوْف، مَعْلِيك بْنَاذم يمصْڒَاح اَك أَربِّـي س شَّرِيعَا ن مُوْسَى، أَتَاف يمُّوْث لْمَسِيح خ ڒْبَاطڒ وَاهَا.<verse eid="GAL 2:21" /></para>
  <chapter eid="GAL 2" />
  <chapter number="3" style="c" sid="GAL 3" />
  <para style="s1">لْإِيمَان نِغ شَّرِيعَا؟</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1" />آ أَيث-ݣَلَاطْيَا، مَا ثْبُوْهْڒِيّم نِغ؟ وِي ذَاوم يݣِّين سّْحُوْر؟ نْشرّح-اَوم مْلِيح زَّاث إِ ثِيطَّاوِين نْوم مَامّش يمُّوْث لْمَسِيح خ صَّلِيب. <verse eid="GAL 3:1" /><verse number="2" style="v" sid="GAL 3:2" />أَكنِّيو سّقْسِيغ خ يِجّن ن ثْمسْڒَايْث وَاهَا. مَا يهْوَا-د خَاوم أَرُّوْح يقدّْسن وَامِي ثْطَاعم إِ شَّرِيعَا ن مُوْسَى؟ لَّا، ئِهْوَا-د وَامِي ثسْڒِيم إِ <char style="it">لإِنْجِيل</char> ثُوْمْنم زَّايس. <verse eid="GAL 3:2" /><verse number="3" style="v" sid="GAL 3:3" />مَا ثْبُوْهْڒِيّم مْلِيح نِغ؟ كنِّيو ثبْذَام مْلِيح س <char style="it">ثْزمَّار ن</char> أَرُّوْح يقدّْسن. مَا ثْرزُّوْم ڒخُّو اَذ تْكمّْڒم س ثْزمَّار نْوم ن بْنَاذم؟! <verse eid="GAL 3:3" /><verse number="4" style="v" sid="GAL 3:4" />مَارَّا مِين تْعدّْبم، مَا يرُوْح ذ ڒْبَاطڒ نِغ؟ لَّا، يمْكن مَاشِي ذ صَّح! <verse eid="GAL 3:4" /><verse number="5" style="v" sid="GAL 3:5" />إِذن، مَامّش ذَاوم د يتِيشّ أَربِّـي أَرُّوْح يقدّْسن يتݣّ جَارَاوم لْمُعْجِزَاث؟ وَاش خْمِي تْطَاعَام إِ شَّرِيعَا ن مُوْسَى؟ لَّا، خْمِي تسْڒَام <char style="it">لإِنْجِيل</char> تَامْنم زَّايس.<verse eid="GAL 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6" />
    <char style="it">ئِقَّار لْكِتَاب</char> خ بْرَاهِيم: &lt;أُوْشَا يُوْمن بْرَاهِيم زِي أَربِّـي، ئِكَّر أَربِّـي يسمْصْڒَاح-يث اَكِذس س لْإِيمَان نِّي.&gt; <verse eid="GAL 3:6" /><verse number="7" style="v" sid="GAL 3:7" />فَلِيهَذَا، فهْمث كنِّيو بلِّي يِنِّي يُوْمْنن نِثْنِي ذ ثَارْوَا ن بْرَاهِيم. <verse eid="GAL 3:7" /><verse number="8" style="v" sid="GAL 3:8" />زِي قْبڒ يخْبَار-د أَربِّـي ذِي لْكِتَاب اَذ يسْمصْڒَاح اَكِذس س لْإِيمَان يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل. عْلَاحْسَاب مَانَاينِّي يبشَّر زِي قْبڒ بْرَاهِيم س لإِنْجِيل ينَّا-ٱس قَا اَذ تْوَابَرْكن مَارَّا ڒݣْنُوْس خ سَّبَاب نّش. <verse eid="GAL 3:8" /><verse number="9" style="v" sid="GAL 3:9" />خ مَانَاينِّي يِنِّي يُوْمْنن اَذ تْوَابَرْكن اَك بْرَاهِيم يعْنِي ونِّي ؤُمِي قَّارن اَرْيَاز ن لْإِيمَان.<verse eid="GAL 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10" />شُوْف، مَارَّا يِنِّي يتْعوَّاڒن خ طَّاعَا ن شَّرِيعَا <char style="it">ن مُوْسَى</char> تْوَانَعّْڒن. مَايمِّي؟ ڒَاحقَّاش لْكِتَاب يقَّار: &lt;تْوَانَعّْڒن مَارَّا يِنِّي وَار يخدّْمن شَا زِي مَارَّا ثِمسْڒَايِين إِي يُوْرِين ذِي شَّرِيعَا وَار زَّايْسنْت تݣّن شَا!&gt; <verse eid="GAL 3:10" /><verse number="11" style="v" sid="GAL 3:11" />مَعْرُوْف بلِّي ؤُڒَا ذ يجّن وَار يزمَّر اَذ يمصْڒَاح اَك أَربِّـي س شَّرِيعَا ن مُوْسَى ڒَاحقَّاش <char style="it">لْكِتَاب يقَّار</char>: &lt;ونِّي يدْجَان نِيشَان اَذ يعِيش س لْإِيمَان.&gt; <verse eid="GAL 3:11" /><verse number="12" style="v" sid="GAL 3:12" />وَلَكِن اَبْرِيذ ن شَّرِيعَا ن مُوْسَى وَار يدْجِي شَا اَم وبْرِيذ ن لْإِيمَان ڒَاحقَّاش <char style="it">شَّرِيعَا تْوصَّا</char>: &lt;كُڒ يجّن يخدّْمن س ڒُوْصِيَاث-أَ ذ لْقَوَانِين-أَ يتْخصَّا اَزَّايْسن يعِيش.&gt; <verse eid="GAL 3:12" /><verse number="13" style="v" sid="GAL 3:13" />لْمَسِيح يفكّ-اَنغ زِي نَّعْڒث نِّي يدْجَان ذِي شَّرِيعَا وَامِي يَارَّا يخف نّس ذ يجّن نَّعْڒث عْلَاحْسَاب نشِّين. ڒَاحقَّاش لْكِتَاب يقَّار: &lt;منْعُوْڒ كُڒ يجّن إِي ث غا سْݣَعّْذن خ ثحْنَاشْت.&gt; <verse eid="GAL 3:13" /><verse number="14" style="v" sid="GAL 3:14" />س عِيْسَى لْمَسِيح ثهْوَا-د لْبَرَكَا نِّي إِي زِي تُوْغَا ث يوْعذ أَربِّـي إِ بْرَاهِيم ثُوْوض غَار ڒݣْنُوْس، حمَا س لْإِيمَان اَذَانغ يمُّوْش أَرُّوْح يقدّْسن إِي زِي ذَانغ يوْعذ.<verse eid="GAL 3:14" /></para>
  <para style="s1">ڒْفَارْق يدْجَان جَار شَّرِيعَا ن مُوْسَى ذ ڒْعَهذ ن سِيذْنَا بْرَاهِيم</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15" />آي أَيثْمَا، أَذَاوم ؤُشغ يجّن لْمِثَال زِي لْعَادَاث نّغ. لْوَصِيَا،<note caller="+" style="f"><char style="fr" closed="false">3‏.15 </char><char style="ft" closed="false">لْوَصِيَا نتَّاث ذ يجّن ن ثبْرَات يتݣّ-يت يجّن عْلَاحْسَاب خْمِي غَا يمّث، ئِسَّاوَاڒ ذَايس عْلَاحْسَاب لْوَارَاثَا.</char></note> نتَّاث مڒَا ثُوْرَا ثضْبع، وَار يزمَّر حَدّ اَت يسْبطّڒ نِغ اَذَايس يَرْنِي شَان ن ڒْحَاجث. <verse eid="GAL 3:15" /><verse number="16" style="v" sid="GAL 3:16" />أَمنِّي عَاوذ <char style="it">ڒْعَهذ نِّي يعْنِي</char> لْوُعُوْد إِي ذَاس يُوْشَا أَربِّـي إِ بْرَاهِيم ذ وَايَّاو نّس. <char style="it">لْكِتَاب</char> وَار يقَّار شَا &lt;أَيَّاون نّس&gt;، يعْنِي اَطَّاس إِذْسن. لَّا، يقَّار &lt;أَيَّاو نّس&gt;، يعْنِي يجّن ن بْنَاذم أُو نتَّا ذ لْمَسِيح.<verse eid="GAL 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 3:17" />فَا نش، مِين رزُّوْغ اَذ ينِيغ؟ يعْنِي شَّرِيعَا ن مُوْسَى ثُوْسَا-د اَرْبعْمِيَّا أُو ثْڒَاثِين سْنَا منْبَعْد إِ ڒْعَهذ-أَ <char style="it">اَك بْرَاهِيم</char>. شَّرِيعَا نِّي وَار ثْزمَّر شَا اَذ تسْبطّڒ ڒْعَهذ-أَ <char style="it">اَك بْرَاهِيم</char> إِݣ يݣَّا أَربِّـي. يعْنِي مِين يوْعذ أَربِّـي <char style="it">إِ بْرَاهِيم</char> وَار ث تَارِّي شَا شَّرِيعَا نِّي ذ ڒْبَاطڒ. <verse eid="GAL 3:17" /><verse number="18" style="v" sid="GAL 3:18" />شُوْف، لْوَارث مَعْلِيك يتِيشّ-يث أَربِّـي اَك شَّرِيعَا ن مُوْسَى، أَتَاف وَار ث يتِيشّ شَا اَك ڒْعَهذ <char style="it">نّس إِ بْرَاهِيم</char>. وَلَكِن لَّا، لْوَارث نِّي يوْعذ-يث أَربِّـي إِ بْرَاهِيم س يِجّن ن ڒْعَهذ.<verse eid="GAL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19" />إِيوَا، مَايمِّي ثدْجَا شَّرِيعَا ن مُوْسَى بَعْذَا؟ شَّرِيعَا ثمُّوْش نتَّاث بَاش اَذ يسّن بْنَاذم ڒْمُعْصِيَاث. تُوْغَا ثْصدْجَاح قْبڒ مَا ٱذ د يَاس وَايَّاو <char style="it">ن بْرَاهِيم</char> إِي زِي ث يوْعذ أَربِّـي. شَّرِيعَا نِّي ؤُوِينْت-يت لْمَلَائِكَاث، ثُمَّا يجّن ن لْوَسِيط <char style="it">يعْنِي مُوْسَى</char> يسِيْوض-يت-يد. <verse eid="GAL 3:19" /><verse number="20" style="v" sid="GAL 3:20" />نتَّا ذ لْوَسِيط وَاهَا، يعْنِي وَار يخدّم شَا وَاحْذس. وَلَكِن أَربِّـي نتَّا إِݣ يدْجَان وَاحْذس.<verse eid="GAL 3:20" /></para>
  <para style="s">مِين ثعْنَا ڒْخذْمث ن شَّرِيعَا ن مُوْسَى؟</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21" />إِذن شَّرِيعَا ن مُوْسَى، مَا تْعَارَّاض لْوُعُوْد ن أَربِّـي؟ لَّا وَالُو! شُوْف، مَعْلِيك ثمُّوْش شَان شَّرِيعَا يتِيشّن ثُوْذَارْث إِ بْنَاذم، أَتَاف اَذَانغ ثَارّ نِيشَان اَك أَربِّـي شَّرِيعَا نِّي. <verse eid="GAL 3:21" /><verse number="22" style="v" sid="GAL 3:22" />وَلَكِن لَّا، لْكِتَاب يقَّار بلِّي مَارَّا مِين يدْجَان نتَّا اَمشْنَاو اَمحْبُوْس ن ڒْمُعْصِيّث. مَايمِّي؟ بَاش مِين يوْعذ اَذ يمُّوْش س لْإِيمَان زِي عِيْسَى لْمَسِيح إِ يِنِّي إِي غَا يَامْنن.<verse eid="GAL 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23" />فَا قْبڒ مَا ٱذ د يَاس لْإِيمَان-أَ، تُوْغَا شَّرِيعَا ن مُوْسَى ثْشَرّف-اَنغ يعْنِي نشِّين تُوْغَا ندْجَا اَمشْنَاو يمحْبَاس نّس حتَّا ٱڒ وَامِي إِي د يمظْهَار لْإِيمَان-أَ إِي تُوْغَا د يتَاسن. <verse eid="GAL 3:23" /><verse number="24" style="v" sid="GAL 3:24" />س مَانَاينِّي شَّرِيعَا ن مُوْسَى تُوْغَا تْربَّا-يَانغ حتَّا ٱڒ وَامِي د يُوْسَا لْمَسِيح أُو سّنِّي إِي غَا نْمصْڒَاح اَك أَربِّـي س لْإِيمَان. <verse eid="GAL 3:24" /><verse number="25" style="v" sid="GAL 3:25" />ڒخُّو وَامِي صَافِي يمظْهَار-د لْإِيمَان، وَار ثقِّيم شَا شَّرِيعَا ن مُوْسَى تْربَّا-يَانغ.<verse eid="GAL 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26" />ذِي عِيْسَى لْمَسِيح اَقَا كنِّيو مَارَّا إِذْوم ذ ثَارْوَا ن أَربِّـي س لْإِيمَان. <verse eid="GAL 3:26" /><verse number="27" style="v" sid="GAL 3:27" />لِأَنَّا كنِّيو إِݣ يتْوَاطهَّارن س وَامَان بَاش اَذ تِيڒِيم ذِي لْمَسِيح، أَقَا ثْمُوْنم كنِّيو ذ يجّن اَكِذس. <verse eid="GAL 3:27" /><verse number="28" style="v" sid="GAL 3:28" />وَار ذِنِّي لَّا اَئِسْرَائِيلِي نِغ ذ اَيُوْنَانِي. وَار ذِنِّي لَّا يسْمغ نِغ ذ ونِّي يدْجَان حُرّ. وَار ذِنِّي لَّا اَرْيَاز لَّا ثَمْغَارْث. أَقَا كنِّيو مَارَّا إِذْوم ثْمُوْنم ذ يجّن ذِي عِيْسَى لْمَسِيح. <verse eid="GAL 3:28" /><verse number="29" style="v" sid="GAL 3:29" />مڒَا كنِّيو زِي لْمَسِيح اَتَاف كنِّيو ذ ثَارْوَا ن بْرَاهِيم غَارْوم لْوَارث نِّي عْلَاحْسَاب مِينْزِي ث يوْعذ سِيذِي أَربِّـي.<verse eid="GAL 3:29" /></para>
  <chapter eid="GAL 3" />
  <chapter number="4" style="c" sid="GAL 4" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1" />إِيوَا، مِين خْسغ اَذَاوم ينِيغ؟ ونِّي إِي غَا يوَارْثن شَان ثْمسْڒَايْث نتَّا عَاذ ذ اَمزْيَان، ئِتْوَاحْسَاب نتَّا اَم يجّن ن يِسْمغ وَاخَّا اَتَاف نتَّا ذ بَاب ن كُڒْشِي. <verse eid="GAL 4:1" /><verse number="2" style="v" sid="GAL 4:2" />يعْنِي يتݣّ اَرَّاي إِ ونِّي إِي ث يتْربَّان أُو ذ ونِّي إِي زَّايس يتْكلَّافن اَڒ غَا د ثَاوض ڒْوقْث نِّي إِي ذَاس يحدّ بَابَاس. <verse eid="GAL 4:2" /><verse number="3" style="v" sid="GAL 4:3" />أَمُّو ؤُڒَا ذ نشِّين. وَامِي ندْجَا عَاذ ذ يمزْيَانن، أَم يسمْغَان حكّْمن خَانغ لْقَوَانِين يقْذِيمن ن دُّنشْت-أَ. <verse eid="GAL 4:3" /><verse number="4" style="v" sid="GAL 4:4" />وَلَكِن وَامِي د ثُوْوض ڒْوقْث إِݣ يزمّم أَربِّـي، ئِكَّر نتَّا يسّكّ-د مِّيس يتْوَاخْڒق-د زݣ يِجّن ن ثمْغَارْث، يتْوَاخْڒق-د ثْحكّْم خَاس شَّرِيعَا ن مُوْسَى. <verse eid="GAL 4:4" /><verse number="5" style="v" sid="GAL 4:5" />مَايمِّي؟ حمَا اَذ يقدّم لْفِدْيَا خ يِنِّي خف ثْحكّم شَّرِيعَا ن مُوْسَى بَاش اَذَانغ يتْبنَّا أَربِّـي أَ نِيڒِي ذ ثَارْوَا نّس. <verse eid="GAL 4:5" /><verse number="6" style="v" sid="GAL 4:6" />وَامِي ثْذوْڒم كنِّيو ذ ثَارْوَا ن أَربِّـي، ئِسّكّ-د أَرُّوْح ن مِّيس يُوْذف ذݣ وُوْڒَاون نّغ غَار ذَاخڒ يتْڒَاغَا يقَّار، آ بَابَا آ بَابَا ينُو! <verse eid="GAL 4:6" /><verse number="7" style="v" sid="GAL 4:7" />خ مَانَايَا ڒخُّو شك مَاشِي ذ يسْمغ، شك ذ مِّيس. وَامِي شك ذ مِّيس، أَزَّايس ثْوَارْثذ زِي أَربِّـي.<verse eid="GAL 4:7" /></para>
  <para style="s1">أَمْنُوْس ن اَرَّسُوْل بُوْلُس خ ڒْمُوْمِنِين ن أَيث-ݣَلَاطْيَا</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8" />ذِي ڒْوقْث نِّي يعْذُوْن تُوْغَا وَار ثسِّيْنم شَا أَربِّـي، حكّْمن خَاوم لْأَصْنَام زَعْمَا، ذِي طَّبِيعَا نْسن نِثْنِي مَاشِي ذ أَربِّـيثن ن صَّح. <verse eid="GAL 4:8" /><verse number="9" style="v" sid="GAL 4:9" />وَلَكِن ڒخُّو كنِّيو ثسّْنم أَربِّـي، يعْنِي نتَّا إِي كنِّيو يسّْنن. مَامّش تݣّم عَاوذ ثْذوَّاڒم غَار لْقَوَانِين يقْذِيمن نِّي يتضْعِيفن وَار يتجْهِيذن شَا؟ مَا ثخْسم اَغَارْسن ثْذوْڒم ذ يسمْغَان عَاوذ نِغ؟ <verse eid="GAL 4:9" /><verse number="10" style="v" sid="GAL 4:10" />أَقَا كنِّيو تْبَاعم ؤُسَّان ن دِّين نْسن ذ ڒشْهُوْرَاث ذ ڒْفُصُوْل ذ لْعَامَاث نْسن! <verse eid="GAL 4:10" /><verse number="11" style="v" sid="GAL 4:11" />ݣّْوْذغ، يمْكن مَارَّا ڒْخذْمث ينُو اَكِذْوم ثِيڒِي ذِي ڒْبَاطڒ أُو صَافِي. <verse eid="GAL 4:11" /><verse number="12" style="v" sid="GAL 4:12" />آي أَيثْمَا تْزَاوَاݣغ-كنِّيو، إِڒِيث اَم نش لِأَنَّا نش عَاوذ ذوْڒغ اَم كنِّيو.</para>
  <para style="p" vid="GAL 4:12">كنِّيو وَار ذَايي ثضْڒِيمم شَا ؤُڒَا س يِجّن ن ڒْحَاجث. <verse eid="GAL 4:12" /><verse number="13" style="v" sid="GAL 4:13" />أَقَا ثسّْنم بلِّي نش تْبشَّارغ-كنِّيو س لْإِنْجِيل ذ اَمزْوَارُو عْلَاحْسَاب يجّن ن ڒهْڒَاش ذ لْمَرَض ذِي دَّات ينُو. <verse eid="GAL 4:13" /><verse number="14" style="v" sid="GAL 4:14" />ڒهْڒَاش نِّي ينُو يُوْوِي-اَوم-د يجّن ن تَمَارَا. وَاخَّا اَمنِّي وَار ذَايِي ثْحݣَّارم شَا وَار ذَايِي ثْسحْقَارم شَا. لَّا، ثْرحْبم زَّايِي غَارْوم اَم يِجّن زِي لْمَلَائِكَاث ن أَربِّـي نِغ اَم عِيْسَى لْمَسِيح س يِيخف نّس. <verse eid="GAL 4:14" /><verse number="15" style="v" sid="GAL 4:15" />إِيوَا، مَانِيس ثكَّا ڒفْرَاحث نِّي تُوْغَا غَارْوم؟ أَقَا شهّْذغ خَاوم بلِّي مَعْلِيك تُوْغَا ثْزمَّرم، إِڒِي ثْقڒْعم-د ثِيطَّاوِين نْوم ثُوْشِيم-اَيِي-ثنْت. <verse eid="GAL 4:15" /><verse number="16" style="v" sid="GAL 4:16" />مَا ڒخُّو نش ذ ڒْعَذُو نْوم وَامِي ذَاوم نِّيغ لْحَقِيقَا نِيشَان؟<verse eid="GAL 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17" />يوْذَان-أَ <char style="it">يسعّْوَاجن لْإِنْجِيل، مِين رزُّوْن؟</char> تݣّن اَكِذْوم ڒْخِير اَطَّاس زَعْمَا وَلَكِن عْلَاحْسَاب اَعدِّيس نْسن يمْغَارن. رزُّوْن اَكنِّيو كسْبن بَاش اَكنِّيو سْبعّْذن خَانغ، ثُمَّا كنِّيو إِي ذَايْسن غَا يݣّن ڒْخِير اَطَّاس. <verse eid="GAL 4:17" /><verse number="18" style="v" sid="GAL 4:18" />إِيوَا ڒبْدَا ذ لمْلِيح مڒَا شَان يِجّن يرزُّو اَذَاوم يݣّ ڒْخِير. مَاشِي غِير نش إِي غَا يݣّن مَانَايَا وَاهَا، وَلَكِن لَابُد سَّبَاب ن ڒْخِير-أَ اَذ يِيڒِي ذ اَصبْحَان. <verse eid="GAL 4:18" /><verse number="19" style="v" sid="GAL 4:19" />آ ثَارْوَا ينُو، كسِّيغ خَاوم يجّن ن ومْنُوْس عَاوذ اَمشْنَاو ڒحْرِيق ن ثَارْوَا حتَّا ٱڒ د يخْڒق لْمَسِيح ذَايْوم! <verse eid="GAL 4:19" /><verse number="20" style="v" sid="GAL 4:20" />مشْحَاڒ تْمنِّيغ اَكِذْوم يڒِيغ ڒخُّو بَاش صُّوْت ينُو وَار يتقْسِيح شَا اَكِذْوم اَمُّو لِأَنَّا اَقَايِي تْعدَّابغ س ومْنُوْس عْلَاحْسَاب كنِّيو.<verse eid="GAL 4:20" /></para>
  <para style="s1">ڒْمِثَال خ ثمْغَارِين ن سِيذْنَا بْرَاهِيم</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21" />إِنِيم-اَيِي كنِّيو يتخْسن اَخَاوم ثْحكّم شَّرِيعَا ن مُوْسَى. مَا وَار ثسِّينم مِين ذَايس ذِي شَّرِيعَا نِّي نِغ؟ <verse eid="GAL 4:21" /><verse number="22" style="v" sid="GAL 4:22" />وَاه، لْكِتَاب يقَّار بلِّي بْرَاهِيم غَارس ثْنَاين ن ثَارْوَا نّس، يجّن زِي ثِيسْمغْث يجّن زِي ثنِّي إِي يدْجَان حُرّ. <verse eid="GAL 4:22" /><verse number="23" style="v" sid="GAL 4:23" />مِّيس نِّي إِي د يُوْسِين زِي ثِيسْمغْث يخْڒق-د عْلَاحْسَاب ڒْخَاضَر ن بْنَاذم وَاهَا. وَلَكِن مِّيس إِي د يُوْسِين زِي ثنِّي إِي يدْجَان حُرّ يخْڒق-د عْلَاحْسَاب مِينْزِي يوْعذ أَربِّـي بْرَاهِيم.<verse eid="GAL 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GAL 4:24" />يعْنِي مَانَايَا ذَايس ڒمْعَانِي. ثِمْغَارِين-أَ نِثنْتِي س ثْنَاين ذَايْسنْت ثْنَاين ن ڒْعُهُوْذ. ئِجّن ن ڒْعَهذ نتَّا زݣ وذْرَار ن سِينَا، ئِتَارو ثَارْوَا ذ يسمْغَان. نتَّاث ذ هَاجَر. <verse eid="GAL 4:24" /><verse number="25" style="v" sid="GAL 4:25" />إِيوَا هَاجَر نتَّاث اَمشْنَاو اَذْرَار ن سِينَا إِي د يتَاسن ذِي ثْمُوْرْث ن وَاعْرَابن. نتَّاث ثتْوَاحْسَاب ذ ثَنْدِينْت ن لْقُدْس ذِي ڒْوقْث-أَ لِأَنَّا نتَّاث ذ ثَارْوَا نّس إِݣ يدْجَان ذ يسمْغَان. <verse eid="GAL 4:25" /><verse number="26" style="v" sid="GAL 4:26" />وَلَكِن ثَنْدِينْت ن لْقُدْس إِي يدْجَان ذݣ وجنَّا اَقَات حُرّ، نتَّاث ذ يمَّاثْنغ.<note caller="+" style="f"><char style="fr" closed="false">4‏.26 </char><char style="ft" closed="false">يعْنِي نتَّاث ذ سَارَا ثَمْغَارْث ثَمزْوَارُوْت ن سِيذْنَا بْرَاهِيم. نتَّاث ذ يمَّاس ن سِيذْنَا إِسْحَاق.</char></note> <verse eid="GAL 4:26" /><verse number="27" style="v" sid="GAL 4:27" />مِينْزِي لْكِتَاب يقَّار:</para>
  <para style="q1" vid="GAL 4:27">&lt;سَّعْذ نّمْ يَا ثنِّي وَار يتِيرْون شَا ثَارْوَا!</para>
  <para style="q1" vid="GAL 4:27">عيّض س ڒفْرَاحث يَا ثنِّي وَار ذِي يتِيڒِي ڒحْرِيق ن ثَارْوَا!</para>
  <para style="q1" vid="GAL 4:27">أَقَا ثَارْوَا ن ثنِّي بْڒَا اَرْيَاز</para>
  <para style="q1" vid="GAL 4:27">اَذ اَرْنِين كْتَار زِي ثنِّي غَار يدْجا ورْيَاز.&gt;<verse eid="GAL 4:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28" />فَا آي أَيثْمَا، كنِّيو ذ ثَارْوَا ن ڒْعَاهد اَمشْنَاو إِسْحَاق <char style="it">مِّيس ن بْرَاهِيم</char>. <verse eid="GAL 4:28" /><verse number="29" style="v" sid="GAL 4:29" />ذِي ڒْوقْث نِّي، ونِّي إِي د يخڒْقن عْلَاحْسَاب ڒْخَاضَر وَاهَا ن بْنَاذم يتْعدَّاب <char style="it">إِسْحَاق يعْنِي</char> ونِّي إِي د يخڒْقن س جّْهذ ن أَرُّوْح يقدّْسن. أُو مَانَايَا كِيف-كِيف ذِي ڒْوقْث-أَ. <verse eid="GAL 4:29" /><verse number="30" style="v" sid="GAL 4:30" />وَلَكِن مِين يقَّار لْكِتَاب؟ &lt;أَزّڒ خ ثِيسْمغْث ذ مِّيس ڒَاحقَّاش مِّيس ن ثِيسْمغْث وَار يتْوَارِيث شَا اَكذ مِّيس ن ثنِّي يدْجَان حُرّ.&gt; <verse eid="GAL 4:30" /><verse number="31" style="v" sid="GAL 4:31" />آي أَيثْمَا، س مَانَايَا وَار ندْجِي شَا ذ ثَارْوَا ن ثِيسْمغْث؛ لَّا، نشِّين ذ ثَارْوَا ن ثنِّي يدْجَان حُرّ.<verse eid="GAL 4:31" /></para>
  <chapter eid="GAL 4" />
  <chapter number="5" style="c" sid="GAL 5" />
  <para style="nb">
    <verse number="1" style="v" sid="GAL 5:1" />غَار لْحُرِّيَا يضْڒق-اَنغ-د لْمَسِيح بَاش أَ نِيڒِي حُرّ ذ صَّح. بدّث نِيشَان بَعْدَا، وَار تجَّاث شَا اَخَاوم يبسّڒ عَاوذ يجّن ن دْقڒ ن ثْزَايْڒُوْت ن يسمْغَان.<note caller="+" style="f"><char style="fr" closed="false">5‏.1 </char><char style="ft" closed="false">يعْنِي ذَانِيتَا اَرَّسُوْل بُوْلُس يتْشَابَّاه ثْزَايْڒُوْت ن يسمْغَان ذِي شَّرِيعَا ن سِيذْنَا مُوْسَى، ثْبسّڒ خ أَيث-إِسْرَائِيل اَم يِجّن ن دْقڒ يقْسح.</char></note><verse eid="GAL 5:1" /></para>
  <para style="s1">لْحُرِّيَا ن صَّح ذِي لْمَسِيح</para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2" />صنّْطث! نش ذ بُوْلُس قَّارغ-اَوم مڒَا ثݣِّيم طَّهَارث <char style="it">ن مُوْسَى</char>، أَتَاف لْمَسِيح وَار كنِّيو ينفّع س وَالُو. <verse eid="GAL 5:2" /><verse number="3" style="v" sid="GAL 5:3" />أَذَاوم عَاوْذغ، أَذ ينِيغ إِ كُڒ اَرْيَاز ونِّي إِي غَا يݣّن طَّهَارث <char style="it">ن مُوْسَى</char>، ئِتْخصَّا لَابُد اَذ يطَاع إِ شَّرِيعَا ن مُوْسَى اَمن-ثكْمَاڒ. <verse eid="GAL 5:3" /><verse number="4" style="v" sid="GAL 5:4" />كنِّيو إِي يرزُّوْن صُّلْح س شَّرِيعَا نِّي اَك أَربِّـي، أَقَا ثتْوَاحَرّْمم زِي لْمَسِيح ثْبعّْذم خ اَرْضَا نّس. <verse eid="GAL 5:4" /><verse number="5" style="v" sid="GAL 5:5" />قَا نشِّين لَّا، نتْرَاجَا أَربِّـي اَذَانغ يسمْصْڒَاح اَكِذس س لْإِيمَان، أُو لْأَمَال-أَ نّغ نتَّا س جّْهذ ن أَرُّوْح يقدّْسن. <verse eid="GAL 5:5" /><verse number="6" style="v" sid="GAL 5:6" />لِأَنَّا ذِي عِيْسَى لْمَسِيح يعْنِي بْنَاذم مڒَا يݣَّا طَّهَارث نِغ وَار ت يݣِّي شَا، مَانَايَا وَار ينفّع س وَالُو. مِين ينفّْعن؟ ئِنفّع لْإِيمَان إِݣ يخدّْمن شّْغڒ نّس س ڒمْحِبّث.<verse eid="GAL 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7" />تُوْغَا كنِّيو ثدْجَام ذݣ يِجّن ن وبْرِيذ غَار زَّاث مْلِيح. وِي كنِّيو يسْبدّن بَاش وَار تݣّم شَا اَرَّاي إِ لْحَقِيقَا؟ <verse eid="GAL 5:7" /><verse number="8" style="v" sid="GAL 5:8" />أَرَّاي-أَ إِي تݣّم كنِّيو زَعْمَا مَاشِي زِي أَربِّـي إِي ذَاوم د يتْڒَاغَان. <verse eid="GAL 5:8" /><verse number="9" style="v" sid="GAL 5:9" />غِير ذْرُوْس ن ؤُنْتُوْن<note caller="+" style="f"><char style="fr" closed="false">5‏.9 </char><char style="ft" closed="false">أَنْتُوْن نتَّا ذ اَمْثُوْن.</char></note> يسْݣَعَّاذ-د مَارَّا ڒْعَاجْنث ن ؤُرشْثِي.<note caller="+" style="f"><char style="fr" closed="false">5‏.9 </char><char style="ft" closed="false">أَرشْثِي يعْنِي نتَّا ذ اَرِيْثِي.</char></note> <verse eid="GAL 5:9" /><verse number="10" style="v" sid="GAL 5:10" />نش غَارِي تِّقث ذِي أَربِّـي وَار ثْقبّْڒم بُو شَان ن اَرَّاي نّغْنِي. وَلَكِن ونِّي إِي كنِّيو يسْخرْوَاضن، مِين مَا يعْنَى نتَّا اَث يحَاسب س لْعِقَاب نّس. <verse eid="GAL 5:10" /><verse number="11" style="v" sid="GAL 5:11" />آي أَيثْمَا، نش مَعْلِيك عَاذ سڒْمَاذغ طَّهَارث <char style="it">ن مُوْسَى</char> زَعْمَا، إِيوَا مَايمِّي عَاذ ذَايِي تْعدَّابن نِثْنِي؟ مَعْلِيك لَابُد طَّهَارث-أَ، أَتَاف صَافِي وَار يتِيڒِي بُو وحݣَّار ن صَّلِيب. <verse eid="GAL 5:11" /><verse number="12" style="v" sid="GAL 5:12" />أُو يِنِّي إِي كنِّيو يهدْجْشن <char style="it">خ طَّهَارث-أَ</char> تْمنِّيغ اَذ رَاحن نِثْنِي اَذ قسّن يخف نْسن!<verse eid="GAL 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13" />شُوْف آي أَيثْمَا، ئِڒَاغَا-يَاوم-د أَربِّـي بَاش اَذ تِيڒِيم حُرّ. وَلَكِن وَار تجَّاث شَا لْحُرِّيَا-يَا نْوم اَذ تِيڒِي ذ يجّن ن وبْرِيذ إِي زِي غَا ثْسعِّيفم شّهْوث ن طَّبِيعَا ثَعفَّانْت نْوم؛ لَّا، أَذ تْسخَّارم إِ وَايَاوْيَا س ڒمْحِبّث. <verse eid="GAL 5:13" /><verse number="14" style="v" sid="GAL 5:14" />أَقَا مَارَّا ڒُوْصِيَاث ن شَّرِيعَا ن مُوْسَى مُوْننْت-يد ذَانِيتَا: &lt;أَذ تخْسذ اَجَّار نّش اَمشْنَاو يخف نّش.&gt; <verse eid="GAL 5:14" /><verse number="15" style="v" sid="GAL 5:15" />وَلَكِن مڒَا تْمرْمَاشم اَيَاوْيَا <char style="it">اَم ڒُوْحُوْش</char> وَا يتتّ وَا، حْضَام يخف نْوم اَذ تْسغْڒِيم اَيَاوْيَا.<verse eid="GAL 5:15" /></para>
  <para style="s1">أَرُّوْح يقدّْسن ذ طَّبِيعَا ن بْنَاذم</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16" />فَا نِّيغ-اَوم، تْعِيشث عْلَاحْسَاب ڒْخَاضَر ن أَرُّوْح يقدّْسن ثُمَّا وَار تْسعِّيفم شَا شّهَاوَاث ن طَّبِيعَا ثَعفَّانْت نْوم. <verse eid="GAL 5:16" /><verse number="17" style="v" sid="GAL 5:17" />لِأَنَّا مِين ثْرزُّو طَّبِيعَا ثَعفَّانْت نّغ نتَّا ضد ن مِين يرزُّو أَرُّوْح يقدّْسن. أُو اَمنِّي مِين يرزُّو أَرُّوْح يقدّْسن نتَّا ضد ن مِين ثْرزُّو طَّبِيعَا ثَعفَّانْت نّغ. تْعَارَّاضن إِ وَايَاوْيَا سّنِّي وَار تݣّم شَا ثِمسْڒَايِين-أَ إِي ثخْسم اَذ تݣّم. <verse eid="GAL 5:17" /><verse number="18" style="v" sid="GAL 5:18" />أُو مڒَا ڒْخَاضَر ن أَرُّوْح يقدّْسن ينْده-يكنِّيو، أَتَاف وَار خَاوم ثْحكِّيم شَا شَّرِيعَا.<verse eid="GAL 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19" />ڒخْذَايم ن طَّبِيعَا ثَعفَّانْت نّغ اَقَا تْبَاننْت-يد يعْنِي لْفَسَاذ ذ مِين يسخْنِيزن ذ ڒقْبَاحث، <verse eid="GAL 5:19" /><verse number="20" style="v" sid="GAL 5:20" />ذ لْعِبَادَا ن لْأَصْنَام ذ سّْحُوْر ذ لْعَدَاوَا ذ ؤُمنْغِي ذ لْغِيرَا ذ ؤُغْضَاب ذ لْأَنَانِيَا ذ لْخِلَافَاث ذ لْأَحْزَاب، <verse eid="GAL 5:20" /><verse number="21" style="v" sid="GAL 5:21" />ذ ڒحْسذ ذ وَاطَّاس ن شْرب ذ لْمَدلَّا ن سّكْرَا ذ مِين يتْشَابَّاهن ذِي مَانَايَا. عدْجْمغ-اَوم-د ڒخُّو مَامش تُوْغَا ذَاوم عڒْمغ زِي قْبڒ: يِنِّي يتݣّن ڒخْذَايم-أَ وَار تْوَارِيثن شَا ڒْمُلْك ن أَربِّـي.<verse eid="GAL 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22" />فَا مِين د يتَارو أَرُّوْح يقدّْسن؟ ئِتَارو-د ڒمْحِبّث ذ ڒفْرَاحث ذ ڒهْنَا ذ تَّاسِع ن ڒْخَاضَر ذ ڒْخِير ذ وُوْڒ اَشمْڒَاڒ ذ بْنَاذم ذِي يدْجَا تِّقث <verse eid="GAL 5:22" /><verse number="23" style="v" sid="GAL 5:23" />ذ تَّوَاضُع ذ بْنَاذم يحكّْمن خ شّهْوث نّس. وَار ثدْجِي بُو شَان ن شَّرِيعَا إِݣ يسْبدَّان ثِمسْڒَايِين-أَ. <verse eid="GAL 5:23" /><verse number="24" style="v" sid="GAL 5:24" />أُو يِنِّي يدْجَان ن عِيْسَى لْمَسِيح صَافِي صلّْبن طَّبِيعَا نِّي ثَعفَّانْت نْسن اَكذ شّهْوث ذ ڒْخَاضَر ن طَّبِيعَا-يَا. <verse eid="GAL 5:24" /><verse number="25" style="v" sid="GAL 5:25" />مڒَا نتْعِيش س أَرُّوْح يقدّْسن، أَتَاف لَابُد أَ نُوْيُوْر س ڒْخَاضَر نّس. <verse eid="GAL 5:25" /><verse number="26" style="v" sid="GAL 5:26" />وَار نْسمْغَار شَا يخف نّغ س تَّكبُّر، وَار ذَايْنغ يتِيڒِي شَا ڒحْسذ ذ ثْغنَّانْت جَارَانغ.<verse eid="GAL 5:26" /></para>
  <chapter eid="GAL 5" />
  <chapter number="6" style="c" sid="GAL 6" />
  <para style="s1">ڒُوْصِيَاث ثِنݣُّوْرَا</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1" />آي أَيثْمَا، مڒَا ثُوْفِيم شَان يِجّن <char style="it">زَّايْوم</char> ثْسحْصر-يث ڒْمُعْصِيّث، لَابُد مڒَا ثْجهْذم كنِّيو س أَرُّوْح يقدّْسن اَثِيذ تَارّم غَار وبْرِيذ س يِجّن ن وُوْڒ يسبَّارن. أُو حْضَا يخف نّش ؤُڒَا ذ شك بَاش وَار ثتْوَاغَرِّيذ شَا. <verse eid="GAL 6:1" /><verse number="2" style="v" sid="GAL 6:2" />أَرْبُوْث دْقڒ اَݣ وَايَاوْيَا، س مَانَايَا اَذ تݣّم ڒُوْصِيّث نِّي ن لْمَسِيح. <verse eid="GAL 6:2" /><verse number="3" style="v" sid="GAL 6:3" />شُوْف، مڒَا شَان ن بْنَاذم يتْفكَّار اَذ يفْتَخَر س يِيخف نّس وَلَكِن نتَّا وَار ذَايس وَالُو، أَتَاف يخدّع يخف نّس. <verse eid="GAL 6:3" /><verse number="4" style="v" sid="GAL 6:4" />لَّا، لَابُد مْكُڒ يجّن اَذ يرَاجع نِّيث ڒخْذَايم نّس، ثُمَّا اَتَاف اَذ يفْتَخَر نِيشَان أُو بْڒَا مَا ٱذ يشَابّه يخف نّس ذݣ ومْعَاشَر نّس. <verse eid="GAL 6:4" /><verse number="5" style="v" sid="GAL 6:5" />ڒَاحقَّاش مْكُڒ يجّن اَذ يَارْبُو ڒحْمڒ نّس.<verse eid="GAL 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6" />فَا ونِّي ؤُمِي سڒْمَاذن اَوَاڒ ن أَربِّـي، ئِتْخصَّا اَذ يشَرش نتَّا اَك ونِّي يسڒْمَاذن زِي مَارَّا مِين يدْجَان ذ اَصبْحَان. <verse eid="GAL 6:6" /><verse number="7" style="v" sid="GAL 6:7" />وَار خدّْعث شَا يخف نْوم، أَربِّـي وَار ث يشمّث ؤُڒَا ذ يجّن. يعْنِي مِين مَا يزْرع بْنَاذم، ذ مَانَاينِّي إِي غَا يمْجَار. <verse eid="GAL 6:7" /><verse number="8" style="v" sid="GAL 6:8" />ونِّي إِي غَا يزرْعن مِين ثخْس طَّبِيعَا ثَعفَّانْت نّس اَزَّايس يمْجَار مِين يفنَّان. ونِّي إِي غَا يزرْعن مِين يخس أَرُّوْح يقدّْسن اَزَّايس يمْجَار ثُوْذَارْث ن ڒبْدَا. <verse eid="GAL 6:8" /><verse number="9" style="v" sid="GAL 6:9" />إِيوَا يتْخصَّا وَار نْتِيحڒ شَا ذِي ڒخْذَايم ن ڒْخِير. مَايمِّي؟ ڒَاحقَّاش اَڒ ڒْوقْث نِّي نِيشَان ن ومْجَار أَ نمْجَار يعْنِي مڒَا وَار نفْشِيڒ شَا. <verse eid="GAL 6:9" /><verse number="10" style="v" sid="GAL 6:10" />إِذن مڒْمِي مَا نُوْفَا لْفُرْصَا، لَابُد أَ نݣّ ڒْخِير ذِي مَارَّا يوْذَان خَصَّاتَن اَك أَيثْمَاثْنغ ذِي لْإِيمَان.<verse eid="GAL 6:10" /></para>
  <para style="s1">لْخِتَام ن ثبْرَات-أَ</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11" />أَقَا تْوَاڒَام ڒْحُرُوْف-أَ مشْحَاڒ ذ يمقّْرَانن نِثْنِي، أُو نش تَارِيغ-ثن نِّيث س وفُوْس ينُو!<verse eid="GAL 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 6:12" />يِنِّي يرزُّوْن اَذ فْتَخَرن زِي دَّات، <char style="it">يعْنِي مِين وَار يدْجِين شَا زِي أَرُّوْح يقدّْسن،</char> نِثْنِي تْبسَّاڒن خَاوم بَاش اَذ تݣّم طَّهَارث <char style="it">ن مُوْسَى</char>. مَايمِّي؟ غِير رزُّوْن نِثْنِي وَار تْعدِّيبن شَا خ سَّبَاب ن صَّلِيب ن لْمَسِيح. <verse eid="GAL 6:12" /><verse number="13" style="v" sid="GAL 6:13" />شُوْف، يِنِّي يتݣّن طَّهَارث نِثْنِي س يِيخف نْسن وَار تْطِيعِين شَا إِ شَّرِيعَا نْسن. رزُّوْن كنِّيو اَذ تݣّم طَّهَارث بَاش اَذ فْتَخَارن <char style="it">بلِّي ثݣِّيم لْعَادَا نْسن</char> ذِي دَّات نْوم. <verse eid="GAL 6:13" /><verse number="14" style="v" sid="GAL 6:14" />وَلَكِن نش عمَّارْص اَذ فْتَخَارغ إِلَّا زِي صَّلِيب ن سِيذِيثْنغ عِيْسَى لْمَسِيح. زِي صَّلِيب نّس إِي زِي ثتْوَاصلّب دُّنشْت إِ نش، أُو زَّايس عَاوذ نش إِي زِي تْوَاصلّْبغ إِ دُّنشْت. <verse eid="GAL 6:14" /><verse number="15" style="v" sid="GAL 6:15" />لِأَنَّا بْنَاذم مڒَا يݣَّا طَّهَارث نِغ وَار ت يݣِّي شَا، مَانَايَا وَار ينفّع شَا؛ لَّا، ينفّع مڒَا بْنَاذم يخْڒق-د قَاع ذ جْذِيذ. <verse eid="GAL 6:15" /><verse number="16" style="v" sid="GAL 6:16" />مَارَّا يِنِّي يݣُّوْرن خ مِين تْوصِّيغ نش ذِي ڒُوْصِيْيث-أَ اَتَاف اَغَارْسن يِيڒِي ڒهْنَا ذ اَرَّحْمث اَك شَّعْب ن أَربِّـي.<verse eid="GAL 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17" />سَّا اَڒ ثْسَاونْت يتْخصَّا وَار ذَايِي يتݣّ حَدّ تَمَارَا ڒَاحقَّاش دَّات ينُو ذَايس لْأَثَار ن عِيْسَى.<verse eid="GAL 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18" />آي أَيثْمَا، أَذ يِيڒِي اَك اَرُّوْح نْوم اَرْضَا ن سِيذِيثْنغ عِيْسَى لْمَسِيح. آمِين.<verse eid="GAL 6:18" /></para>
  <chapter eid="GAL 6" />
</usx>