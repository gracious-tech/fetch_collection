<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- TarifitABS</book>
  <para style="h">فليمون</para>
  <para style="toc3">فلم</para>
  <para style="toc2">ثبرات غار فليمون</para>
  <para style="toc1">ثَبْرَات ن اَرَّسُوْل بُوْلُس غَار فِلِيْمُوْن</para>
  <para style="mt1">ثَبْرَات ن اَرَّسُوْل بُوْلُس غَار فِلِيْمُوْن<note caller="+" style="f"><char style="fr" closed="false">1‏.0 </char><char style="ft" closed="false">ثَانِيتَا ذ يجّن ن ثبْرَات إِي يُوْرَا اَرَّسُوْل بُوْلُس غَار ومدُّوْكڒ نّس فِلِيمُوْن عْلَاحْسَاب يج وحنْجِير قَّارن-اَس وَانِيْسَامُو. وَانِيْسَامُو-يَا تُوْغَاث قْبڒ ذ لْعَبْد ن فِلِيمُوْن. يَرْوڒ زِي فِلِيمُوْن أُو منْبَعْد يسّن-يث اَرَّسُوْل بُوْلُس ذِي ڒحْبس، ئِذْوڒ وَانِيْسَامُو ذ ڒْمُوْمن. ؤُڒَا ذ فِلِيمُوْن تُوْغَا يذْوڒ ذ ڒْمُوْمن خ وفُوْس ن بُوْلُس. ڒخُّو اَرَّسُوْل بُوْلُس يسّكّ-د وَانِيْسَامُو غَار فِلِيمُوْن بَاش اَذ مْصڒْحَان جَارَاسن اَم وَاوْمَاثن ذِي عِيْسَى لْمَسِيح.</char></note></para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="s">لْمُقَدِّمَا</para>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />نش ذ بُوْلُس اَقَايِي ذ اَمحْبُوْس عْلَاحْسَاب عِيْسَى لْمَسِيح اَكِذِي ؤُمَاثْنغ تِيْمُوْتَاوُس. <char style="it">تَارِيغ ثَبْرَات-أَ</char> إِ فِلِيْمُوْن يدْجَان ذ اَمْعَاشَر نّغ إِي خَانغ يعِيزّن، <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" />ذ ؤُتْشْمَاثْنغ عَابْـيَا ذ <char style="it">ؤُمَاثْنغ</char> أَرْكِيْـپُّـوْس ونِّي إِي كِذْنغ يتمْعَاشَرن اَم يِجّن ن ؤُمْجَاهذ، أُو عَاوذ ذ جْمَاعث ن ڒْمُوْمِنِين يتْمُوْنَان ذِي ثدَّارْث نّش.<verse eid="PHM 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3" />أَكِذْوم يِيڒِي اَرْضَا ذ ڒهْنَا زِي أَربِّـي بَابَاثْنغ ذ عِيْسَى لْمَسِيح سِيذِيثْنغ.<verse eid="PHM 1:3" /></para>
  <para style="s">طَّالب ن اَرَّسُوْل بُوْلُس غَار فِلِيمُوْن</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />ڒبْدَا تْشكَّرغ أَربِّـي ينُو خْمِي تْفكَّرغ ذَايش ذِي ثْࢲَادْجِيث ينُو. <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />قَا نش تسْڒِيغ خ لْإِيمَان نّش إِي ذَايش زِي سِيذِيثْنغ عِيْسَى ذ ڒمْحِبّث نّش غَار مَارَّا صَّالِحِين. <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />تتَّارغ إِ أَربِّـي خ ثمْعَاشَرْث نّغ ذِي لْإِيمَان اَش ثَاوِي غَار يِجّن ن ڒفْهَامث ثكْمَاڒ خ كُڒ ثَمسْڒَايْث ثَصبْحَانْت إِݣ يدْجَان غَارْنغ ذِي لْمَسِيح. <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />آي ؤُمَا، ڒمْحِبّث إِي غَارش شك تِيشّ-اَيِي-د يجّن ن ڒفْرَاحث ذ ؤُشجَّع ذ اَمقّْرَان مِينْزِي شك ثْسِيْحمِّيذ ؤُڒَاون ن صَّالِحِين.<verse eid="PHM 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />إِذن، مِين يتْخصَّان اَذ تݣّذ زمَّرغ نش اَش أَمَرغ س زْعَامث ذِي لْمَسِيح اَث تݣّذ، <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />وَلَكِن حْسن اَش تَّارغ مَانَايَا س ڒمْحِبّث. إِيوَا نش ذ بُوْلُس اَقَايِي نُمْغَارغ، ڒخُّو اَقَايِي عَاوذ ذِي ڒحْبس عْلَاحْسَاب سِيذِيثْنغ عِيْسَى. <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" />تتَّارغ-شك خ وَانِيسَامُو ونِّي يدْجَان اَم ممِّي، أَرِّيغ-ث نش ذ مِّي وَامِي تُوْغَاث اَكِذِي ذِي ڒحْبس. <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />قْبڒ إِ مَانَايَا تُوْغَا نتَّا وَار ش ينفّع شَا، ڒخُّو يذْوڒ اَذَانغ ينفّع نش ذ شك.<verse eid="PHM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12" />أَقَا نش تَارِّيغ-اَش-ث-يذ اَخْمِي غَا ش د سّكّغ ؤُڒ ينُو. <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />مشْحَاڒ نش تُوْغَا رزُّوْغ اَكِذِي يقِّيم ذَانِيتَا اَذَايِي يعَاون ذݣ ؤُمْشَان نّش زݣ وَامِي دْجِيغ ذَانِيتَا ذِي ڒحْبس-أَ عْلَاحْسَاب لْإِنْجِيل. <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />وَلَكِن نش وَار خْسغ شَا اَذ ݣّغ شَان ن ڒْحَاجث بْڒَا اَرَّاي نّش؛ نش خْسغ ڒْخِير نّش اَذَايِي د يَاس س ڒْخَاضَر نّش مَاشِي س يِجّن ن بزّز زَّايِي لَّا. <verse eid="PHM 1:14" /><verse number="15" style="v" sid="PHM 1:15" />نتَّا يمْكن خ سَّبَاب-أَ إِي خَاك يفَرق ذݣ يِجّن ن لْمُدَّا بَاش اَغَارش د يذْوڒ ڒخُّو إِ ڒبْدَا. <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />وَلَكِن ڒخُّو مَاشِي اَم يسْمغ،<note caller="+" style="f"><char style="fr" closed="false">1‏.16 </char><char style="ft" closed="false">ئِسْمغ نتَّا ذ لْعَبْد يخدّم إِ بَاب نّس بْڒَا تْمنْيَاث.</char></note> نتَّا حْسن زݣ يسْمغ: أَم ؤُمَاش إِي خَاش يعِيزّن. نتَّا يعِيزّ خَافِي، وَلَكِن شك يعِيزّ خَاش كْتَار: <char style="it">ذِي ڒْخذْمث</char> أُو عَاوذ اَم ؤُمَاش ذِي سِيذِيثْنغ.<verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />فَلِهَاذَا، مڒَا ثْحسْبذ-اَيِي ذ اَمْعَاشَر نّش، قْبڒ-يث اَخْمِي ذَايِي ثْقبْڒذ نش. <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />مڒَا يضْڒم-يش ذِي شَا ن ثْمسْڒَايْث نِغ مڒَا ذِنِّي شَان ن ومَرْوَاس جَارَاوم، حْسب-يث خَافِي نش. <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />قَا نش ذ بُوْلُس تَارِيغ مَانَايَا س وفُوْس ينُو: أَذَاش ث خدْجْسغ نش. بْڒَا مَا ٱذَاش ينِيغ قَا تَّارْسغ-اَش ؤُڒَا ذ ثُوْذَارْث نّش. <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />وَاه آي ؤُمَا، خْسغ اَزَّايك ربْحغ يجّن ن نّْفَع ذِي سِيذِيثْنغ، سِيْحْمَا-ٱيِي ؤُڒ ينُو ذِي لْمَسِيح. <verse eid="PHM 1:20" /><verse number="21" style="v" sid="PHM 1:21" />نش تْأَكَادغ س طَّاعَا نّش، س مَانَايَا تَارِيغ-اَش-د <char style="it">ثَبْرَات-أَ</char> سّْنغ شك اَذ تݣّذ كْتَار زِي مِين ذَاش تْطَالَابغ.<verse eid="PHM 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PHM 1:22" />أُو عَاوذ سوْجذ-اَيِي يجّن ن ثْغُوْرْفَات، تْمنِّيغ اَغَارْوم د عقْبغ عْلَاحْسَاب ثْࢲَادْجِيث نْوم.<verse eid="PHM 1:22" /></para>
  <para style="s">لْخِتَام ن ثبْرَات-أَ</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />ئِسَاوَّاض-اَش-د سْڒَام پَـافْرَاس ونِّي إِي كِذِي يدْجَان ذ اَمحْبُوْس عْلَاحْسَاب عِيْسَى لْمَسِيح. <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" /><char style="it">سَاوَّاضن-اَش-د سْڒَام</char> عَاوذ مَرْقُوْس ذ أَرِسْتَارْخُوْس ذ دِيْمَاس ذ لُوْقَا يدْجَان مَارَّا ذ يمْعَاشَرن ينُو.<verse eid="PHM 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25" />أَذ يِيڒِي اَك اَرُّوْح نْوم اَرْضَا ن سِيذِيثْنغ عِيْسَى لْمَسِيح.<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>