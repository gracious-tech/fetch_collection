<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EPH" style="id">- TarifitABS</book>
  <para style="h">أَيث-ؤُفَسُوْس</para>
  <para style="toc3">أفس</para>
  <para style="toc2">أيث-ؤفسوس</para>
  <para style="toc1">ثَبْرَات ن اَرَّسُوْل بُلُوْس غَار ڒْمُوْمِنِين إِي يدْجَان ذِي ثنْدِينْت ن وفَسُوْس</para>
  <para style="mt1">ثَبْرَات ن اَرَّسُوْل بُوْلُس غَار أَيث-ؤُفَسُوْس</para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="s">لْمُقَدِّمَا</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />نش ذ بُوْلُس، نش ذ يجّن ن اَرَّسُوْل ن عِيْسَى لْمَسِيح س ڒْخَاضَر ن أَربِّـي. ؤُرِيغ ثَبْرَات-أَ إِ صَّالِحِين <char style="it">إِي يدْجَان ذِي جْوَايه ن ؤُفَسُوْس</char> إِي يُوْمْنن س عِيْسَى. <verse eid="EPH 1:1" /><verse number="2" style="v" sid="EPH 1:2" />أَكِذْوم يِيڒِي اَرْضَا ذ ڒهْنَا زِي أَربِّـي بَابَاثْنغ ذ عِيْسَى لْمَسِيح سِيذِيثْنغ.<verse eid="EPH 1:2" /></para>
  <para style="s">لْبَرَكَا ن أَربِّـي ثمُّوْش-اَنغ-د ذِي لْمَسِيح</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />أَذ يتْوَابَرَك أَربِّـي، بَابَاس ن سِيذِيثْنغ عِيْسَى لْمَسِيح. أُو ذِي لْمَسِيح يبَرك-اَنغ <char style="it">سِيذِي أَربِّـي</char> زِي مْكُڒ لْبَرَكَا رُوْحِيَا إِݣ يدْجَان ذݣ يجنَّاثن.<note caller="+" style="f"><char style="fr" closed="false">1‏.3 </char><char style="ft" closed="false">ئِجنَّاثن ذ لْجَمع وجنَّا.</char></note> <verse eid="EPH 1:3" /><verse number="4" style="v" sid="EPH 1:4" />شُوْف، ئِخْضَر-اَنغ ذِي لْمَسِيح قْبڒ مَا د يخْڒق دُّنشْت-أَ بَاش أَ نِيڒِي نصْفَا بْڒَا ڒْعِيب زَّاثس. <verse eid="EPH 1:4" /><verse number="5" style="v" sid="EPH 1:5" />س ڒمْحِبّث نّس يزمّم-اَنغ بَاش اَذَانغ يتْبنَّا اَم ثَارْوَا نّس س عِيْسَى لْمَسِيح عْلَاحْسَاب لْغَرَض ن ڒْخَاضَر نّس. <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" />أَذ يتْوَابَرَك اَرْضَا نّس يمْغَارن، ئِفَرغ-يث-يذ خَانغ أَربِّـي س مِّيس يعِيزّن. <verse eid="EPH 1:6" /><verse number="7" style="v" sid="EPH 1:7" />ئِفكّ-اَنغ-د <char style="it">سِيذِي أَربِّـي</char> س لْفِدْيَا نِّي ن مِّيس يعْنِي س يذَامّن نّس بَاش اَذ تْوَاغْفَرنْت ڒْمُعْصِيَاث نّغ عْلَاحْسَاب اَݣْڒَا ن اَرْضَا نّس. <verse eid="EPH 1:7" /><verse number="8" style="v" sid="EPH 1:8" />أَرْضَا-يَا يفَرغ-اَنغ-ث-يذ <char style="it">سِيذِي أَربِّـي</char> س مَارَّا ڒفْهَامث ذ ثُوْسْنَا<note caller="+" style="f"><char style="fr" closed="false">1‏.8 </char><char style="ft" closed="false">ثُوْسْنَا نتَّاث ذ لْمَعْرِيفَا.</char></note> نّس. <verse eid="EPH 1:8" /><verse number="9" style="v" sid="EPH 1:9" />أُو عْلَاحْسَاب لْغَرَض نّس إِݣ يݣَّا ذِي لْمَسِيح يسْبيّن-اَنغ-د ڒْمَعْنَا ينُوْفَّرن ن ڒْخَاضَر نّس. <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" />ڒْمَعْنَا-يَا ينُوْفَّرن يخطّط-يت-يد بَاش اَذ تبْذَا ثْصدْجَاح ذِي ڒْوقْث نّس نِيشَان بَاش اَذ يسْمُوْن أَربِّـي مَارَّا ثِمسْڒَايِين ذِي لْمَسِيح، يعْنِي ثِمسْڒَايِين ذݣ وجنَّا ذ ثْمُوْرْث.<verse eid="EPH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11" />مَارَّا ثِمسْڒَايِين يتݣّ-يثنْت أَربِّـي عْلَاحْسَاب مِين يخطّط ذ مِين يخْضَر نتَّا. نشِّين ذِي عِيْسَى يَارَّا-ٱنغ أَربِّـي أَ نْوَارث عْلَاحْسَاب مِين يزمّم نتَّا س لْغَرَض نّس. <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />حمَا نشِّين إِي يُوْمْنن ذ يمزْوُوْرَا ذِي لْمَسِيح أَ نحْمذ أَربِّـي خ لْعَظَمَا نّس. <verse eid="EPH 1:12" /><verse number="13" style="v" sid="EPH 1:13" />ثُمَّا يسْمُوْن-يكنِّيو-د عَاوذ اَك لْمَسِيح وَامِي ثْصنّْطم إِ وَاوَاڒ ن لْحَقِيقَا يعْنِي لْإِنْجِيل إِي زِي ثْنجْمم. وَامِي ثُوْمْنم يضْبع-يكنِّيو أَربِّـي س طَّبَع نّس يعْنِي س أَرُّوْح يقدّْسن إِي زِي ذَانغ يوْعذ. <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" />أَرُّوْح-أَ نتَّا ذ يجّن ن ڒْعَرْبُوْن يضمّن لْوَارث نّغ اَڒ غَا ث نطّف ثُمَّا أَ نحْمذ أَربِّـي خ لْعَظَمَا نّس.<verse eid="EPH 1:14" /></para>
  <para style="s">أَرَّسُوْل بُوْلُس يتتَّار إِ أَربِّـي خ أَيث-ؤُفَسُوْس</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />خ مَانَايَا، نش زݣ وَامِي تُوْغَا تسْڒِيغ خ لِإِيمَان نْوم زِي سِيذِيثْنغ عِيْسَى ذ ڒمْحِبّث نْوم إِ مَارَّا صَّالِحِين <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" />تْشكَّرغ أَربِّـي خَاوم بْڒَا مَا ٱذ بدّغ أُو <char style="it">ڒبْدَا</char> تْفكَّرغ ذَايْوم ذِي ثْࢲَادْجِيث ينُو. <verse eid="EPH 1:16" /><verse number="17" style="v" sid="EPH 1:17" />حمَا أَربِّـي بَابَاثْنغ عَظِيم ن سِيذِيثْنغ عِيسَى لْمَسِيح اَذَاوم د يُوْش يجّن ن اَرُّوْح ن ڒفْهَامث، كنِّيو اَذ تْعڒْمم خ مِين ينُوْفَّرن بَاش اَد تسّْنم سِيذِي أَربِّـي مْلِيح. <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />أَذَاوم د يُوْش يجّن ن نُّوْر إِ وُوْڒَاون نْوم بَاش اَذ تسّْنم مِين يعْنَا لْأَمَال-أَ إِي زِي ذَاوم د يڒَاغَا، ذ مِين يعْنَا وَاݣْڒَا-يَا ن لْوَارث عَظِيم ن صَّالِحِين، <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />ذ مِين يعْنَا جّْهذ نّس يمْغَارن بْڒَا ڒقْيَاس غَار نشِّين إِي يُوْمْنن. جّْهذ-أَ اَم ونِّي إِݣ يسخْذم أَربِّـي س لْقُوَّا نّس <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" />إِݣ يݣَّا ذِي لْمَسِيح وَامِي ثِيذ يسكَّر زِي ڒْموْث يسْغِيم-يث خ وفُوْسِي نّس ذݣ يجنَّاثن. <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" />ئِسُوْعْڒَا-ث أَربِّـي اَطَّاس خ مَارَّا ڒحْكَام ذ ڒْمخْزن ذ جّْهذ ذ لْممْلَكَا. ئِسُوْعْڒَا-ث نتَّا عَاوذ خ كُڒ يسم إِي تݣّن ذ يسمَاون، مَاشِي غِيڒ ذِي زْمَان-أَ إِي ذِي ندْجَا وَاهَا وَلَكِن عَاوذ ذِي لْأَخِرَا. <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" />يݣَّا أَربِّـي عَاوذ مَارَّا ثِمسْڒَايِين سْوَادَّاي يضَارن نّس يݣِّي-ث ذ اَزدْجِيف إِي يتْرَايَّان خ مَارَّا ثِمسْڒَايِين ذِي جْمَاعث ن ڒْمُوْمِنِين. <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" />جْمَاعث-أَ نتَّاث إِي يدْجَان ذ دَّات ن لْمَسِيح أُو زَّايس نتَّاث إِي يشُّوْر يِيخف نّس أُو ذ نتَّا إِي يشُّوْرن مَارَّا ذِي مِين ذِي مَا.<verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="s">س اَرْضَا ن سِيذِي أَربِّـي إِي زِي غَا ننْجم أُو صَافِي</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />فَا كنِّيو تُوْغَا ثمُّوْثم <char style="it">س وُوْڒَاون نْوم</char> عْلَاحْسَاب ڒْمُعْصِيَاث ذ دّْنُوْب نْوم. <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />ذَايْسنْت إِي تُوْغَا تْعِيشم خْمِي ثݣُّوْرم ذݣ وبْرِيذ ن دُّنشْت-أَ ثْذفَّارم اَرَّايس ن ڒحْكَام إِي يدْجَان جَار وجنَّا ذ ثْمُوْرْث <char style="it">يعْنِي شِّيطَان</char> إِي يدْجَان نتَّا ذ اَرُّوْح نِّي إِݣ يخدّْمن ذݣ يِنِّي إِي يعصَّان أَربِّـي. <verse eid="EPH 2:2" /><verse number="3" style="v" sid="EPH 2:3" />نشِّين مَارَّا تُوْغَا نتْعِيش اَم نِثْنِي ذݣ يِجّن ن ڒْوقْث وَامِي تُوْغَا نتْسعَّاف شّهَاوَاث ن اَرَّاي اَعفَّان ن نّفْس نّغ نْذفَّار مِين يرزُّو ذ مِين يتْفكَّار. تُوْغَانغ اَم مَارَّا يوْذَان يعْنِي نشِّين زݣ يِنِّي إِي غَا يعَاقب سِيذِي أَربِّـي. <verse eid="EPH 2:3" /><verse number="4" style="v" sid="EPH 2:4" />وَلَكِن أَربِّـي س ڒمْحِبّث نّس إِي يݣَّا إِ نشِّين ذ اَرَّحْمث نّس ثَمقّْرَانْت اَطَّاس، <char style="it">مِين ذَانغ يݣَّا نتَّا؟</char> <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />ئِسدَّر-اَنغ اَك لْمَسِيح وَاخَّا نشِّين <char style="it">س وُوْڒَاون نّغ</char> نمُّوْث عْلَاحْسَاب ڒْمُعْصِيَاث نّغ. إِيوَا س اَرْضَا <char style="it">ن سِيذِي أَربِّـي</char> إِي زِي ننْجم. <verse eid="EPH 2:5" /><verse number="6" style="v" sid="EPH 2:6" />ثُمَّا يسكَّر-اَنغ-د اَك لْمَسِيح يسْغِيم-اَنغ ذݣ يمُوْشَان ن وجنَّا س عِيْسَى لْمَسِيح. <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />مَايمِّي؟ حمَا <char style="it">سِيذِي أَربِّـي</char> ذِي زْمَانَاث إِي د غَا يَاسن اَذ د يسْمظْهَار اَݣْڒَا نّس يعْنِي اَرْضَا نّس مشْحَاڒ إِݣ يدْجَا ذ اَمقّْرَان بْڒَا ڒقْيَاس إِي ذَانغ د يسْبيّن ذِي عِيْسَى لْمَسِيح. <verse eid="EPH 2:7" /><verse number="8" style="v" sid="EPH 2:8" />أَقَا س اَرْضَا <char style="it">ن سِيذِي أَربِّـي</char> إِي زِي ثْنجْمم وَامِي ثُوْمْنم. مَانَايَا وَار زَّايْوم د يتكّ شَا زِي كنِّيو؛ لَّا، مَانَايَا يتكّ-د زِي لْهَدِيَا ن أَربِّـي. <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />مَانَايَا مَاشِي عْلَاحْسَاب لْحَسَنَاث نْوم لَّا، بَاش ؤُڒَا ذ يجّن وَار يتفْتَخَر شَا زݣ يِيخف نّس. <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />لِأَنَّا نشِّين ذ ڒْخذْمث ن سِيذِي أَربِّـي، ئِخْڒق-اَنغ-د ذِي عِيْسَى لْمَسِيح بَاش أَ نݣّ ڒخْذَايم ثِصبْحَانِين. نِثنْتِي يسوْجذ-اَنغ-ثنْت-يد أَربِّـي زِي قْبڒ بَاش اَثنْت نخْذم.<verse eid="EPH 2:10" /></para>
  <para style="s">نشِّين ڒْمُوْمِنِين ذ يجّن س عِيْسَى لْمَسِيح</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />إِيوَا عقْڒث بلِّي كنِّيو تُوْغَا ثدْجَام زݣ يِنِّي يتْوَاسمَّان ذ لْكُفَّار زَعْمَا، وَار ثݣِّيم شَا طَّهَارث. أَمنِّي إِي قَّارن ينِّي يتݣّن طَّهَارث (يعْنِي <char style="it">غِير</char> مِين تݣّن ذِي دَّات س يفَاسّن ن بْنَاذم <char style="it">وَاهَا</char>). <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />عقْڒث بلِّي ذِي ڒْوقْث نِّي تْبعَّاذم خ لْمَسِيح تنْعزَاڒم زِي لْجِنْسِيَا ن شَّعْب ن أَربِّـي. أَقَا كنِّيو ذ يبَرَّانِيْين عْلَاحْسَاب ثِمسْڒَايِين نِّي إِي زِي د يوْعذ أَربِّـي ذِي ڒْعُهُوْذ نّس. كنِّيو تُوْغَا ثدْجَام بْڒَا لْأَمَال بْڒَا أَربِّـي ذِي دُّنشْت-أَ. <verse eid="EPH 2:12" /><verse number="13" style="v" sid="EPH 2:13" />وَلَكِن وَامِي ثُوْمْنم زِي عِيْسَى لْمَسِيح، كنِّيو إِي تُوْغَا ثُوْݣّْوْجم اَطَّاس <char style="it">زِي أَربِّـي</char> قْبڒ، صَافِي ڒخُّو يسْقَارّب-يكنِّيو-د غَارس س يذَامّن ن لْمَسِيح.<verse eid="EPH 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 2:14" />شُوْف، لْمَسِيح نتَّا س يِيخف نّس ذ ڒهْنَا نّغ. ذ نتَّا إِݣ يسْمُوْنن <char style="it">أَيث-إِسْرَائِيل ذ ڒݣْنُوْس نّغْنِي يݣَّا</char> ثْنَاين ن شُّعُوْب-أَ ذݣ يِجّن ن شَّعْب. س دَّات ن لْمَسِيح يهْذم ڒْحِيض نِّي إِي تُوْغَا ذَانغ يفرّْقن س لْعَدَاوَا جَارَانغ. <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" />س دَّات نّس يسْبطّڒ شَّرِيعَا نِّي س ڒُوْصِيَاث نّس ذ لْقَوَانِين نّس بَاش اَذ يݣّ ذݣ يِيخف نّس يجّن ن شَّعْب وَاحْذس ذ جْذِيذ ذݣ ومْشَان ن ثْنَاين ن شُّعُوْب نِّي. أَمنِّي يݣَّا ڒهْنَا. <verse eid="EPH 2:15" /><verse number="16" style="v" sid="EPH 2:16" />أَمنِّي يسمْصْڒَاح ثْنَاين ن شُّعُوْب-أَ اَك أَربِّـي يَارِّي-ثن ذ يجّن ن شَّعْب س صَّلِيب، ئِنْغَا زَّايس لْعَدَاوَا جَارَاسن. <verse eid="EPH 2:16" /><verse number="17" style="v" sid="EPH 2:17" />أَقَا يُوْسَا-د عِيْسَى يتْبشَّار نتَّا س لْإِنْجِيل يُوْوِي-اَوم-د ڒهْنَا إِ كنِّيو تُوْغَا يدْجَان ثبعّْذم <char style="it">خ أَربِّـي</char> أُو ذ يِنِّي إِي د يُوْذْسن <char style="it">غَار أَربِّـي</char>. <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />لِأَنَّا س لْمَسِيح اَم نشِّين اَم كنِّيو نْزمَّر أَ نْقَارّب غَار أَربِّـي بَابَاثْنغ س يِجّن ن أَرُّوْح يقدّْسن.<verse eid="EPH 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19" />إِذن، ڒخُّو كنِّيو وَار ثقِّيمم شَا ذ يبَرَّانِيْين نِغ ذ يمزْذَاغ. لَّا، ڒخُّو كنِّيو ذ يمْعَاشَرن اَك صَّالِحِين يعْنِي يُوْشَا-ٱوم أَربِّـي لْجِنْسِيَا اَكِذْسن ثْذوْڒم ذ ڒحْبَاب ن ثدَّارْث ن أَربِّـي. <verse eid="EPH 2:19" /><verse number="20" style="v" sid="EPH 2:20" />ثَدَّارْث-أَ نتَّاث ثبْنَا خ دْسَاس ن يِيزْرَا يدْجَان ذ اَرُّسُل ذ لْأَنْبِيَا. أُو لْمَسِيح س يِيخف نّس اَقَاث ذ اَزْرُو نِّي يدْجَان ذݣ ومْشَان اَصبْحَان ذِي ثْغمَّارْث ن دْسَاس نّس. <verse eid="EPH 2:20" /><verse number="21" style="v" sid="EPH 2:21" />ذَايس ذِي نتَّا إِي يمُوْن مَارَّا ڒبْنِي ن ثدَّارْث-أَ تْݣَعَّاذ ذ يشْتن بَاش اَذ تِيڒِي ذ يجّن ن ثمْزِيذَا ذ ثَمْقدّسْت إِ أَربِّـي. <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />ذَايس عَاوذ ذِي لْمَسِيح يبنَّا-كنِّيو يجّن اَك ونّغْنِي بَاش اَذ تِيڒِيم ذ يجّن ن ثْزدِّيغْث ذَايس إِي غَا يزْذغ أَربِّـي س أَرُّوْح نّس.<verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="s">ئِمظْهَار-د ڒْمَعْنَا ينُوْفَّرن خ لْإِنْجِيل</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />خ مَانَايَا <char style="it">ترْكَاعغ خ يفَادّن ينُو،</char> نش بُوْلُس إِي يدْجَان ذ اَمحْبُوْس عْلَاحْسَاب عِيْسَى لْمَسِيح أُو خَاوم كنِّيو إِي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل...<verse eid="EPH 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 3:2" />مَا ثسْڒَام نِغ لَّا خ لْمسْؤُوْلِيَا نِّي، يعْنِي يجّن ن لْبَرَكَا إِي ذَايِي يُوْشَا أَربِّـي خَاوم كنِّيو؟ <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />يعْنِي ڒْمَعْنَا ينُوْفَّرن خ لْإِنْجِيل يسْمظْهَار-اَيِي-يث-يذ يسهْوَا-ث-يذ خَافِي س لْوَاحِي مَامش ذَاوم ت ؤُرِيغ شْوَايْت زِي قْبڒ. <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" />خْمِي غَا ثغرم مَانَايَا اَذ تسّْنم ڒفْهَامث ينُو إِي غَارِي ذِي ڒْمَعْنَا-يَا ينُوْفَّرن خ لْمَسِيح. <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />ڒْمَعْنَا-يَا وَار ثِيذ يسْمظْهَار شَا أَربِّـي إِ ثَارْوَا ن آدَم ذِي زْمَانَاث إِي يعْذُوْن اَم مَامّش ثِيذ يسْمظْهَار ڒخُّو س أَرُّوْح يقدّْسن إِ اَرُّسُل صَّالِحِين اَك لْأَنْبِيَا. <verse eid="EPH 3:5" /><verse number="6" style="v" sid="EPH 3:6" />ڒْمَعْنَا-يَا ينُوْفَّرن ثَانِيتَا، مِين ثعْنَا؟ أَقَا ؤُڒَا ذ يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل اَذ وَرْثن <char style="it">زِي أَربِّـي</char> اَك أَيث-إِسْرَائِيل س لْإِنْجِيل. نِثْنِي ذ يجّن ن جْمَاعث، مَارَّا اَذ شَرْشن ذِي مِين يوْعذ أَربِّـي ذِي لْمَسِيح.<verse eid="EPH 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7" />ذوْڒغ ذ اَخدَّام ن لْإِنْجِيل-أَ عْلَاحْسَاب لْبَرَكَا ن أَربِّـي وَامِي ذَايِي ت يهْذَا يسخْذم-يت س جّْهذ نّس. <verse eid="EPH 3:7" /><verse number="8" style="v" sid="EPH 3:8" />لْبَرَكَا-يَا يُوْشَا-ٱيِي-ت أَربِّـي وَاخَّا ذ اَمزْيَان إِي دْجِيغ خ مَارَّا صَّالِحِين بَاش نش اَذ بشَّرغ يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل اَذ سّْنن اَݣْڒَا نِّي ن لْمَسِيح إِي وَار يتْوَاشرِّيحن شَا. <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />عَاوذ بَاش اَذ سظْهَارغ مْلِيح إِ مَارَّا يوْذَان مِين يخطّط أَربِّـي ذِي ڒْمَعْنَا نِّي ينُوْفَّرن إِݣ يجَّا نتَّا ذݣ يِخف نّس ذِي زْمَانَاث يعْذُوْن أُو ذ نتَّا ذ لْخَالِق ن مَارَّا مِين يدْجَان ذ ثِمسْڒَايِين. <verse eid="EPH 3:9" /><verse number="10" style="v" sid="EPH 3:10" />مِين يخطّط نتَّا؟ يِنِّي إِݣ يحكّْمن ذ يِنِّي إِݣ يجهْذن ذݣ يجنَّاثن ڒخُّو اَذ سّْنن خ وفُوْس ن جْمَاعث ن ڒْمُوْمِنِين مِين ثعْنَا ڒفْهَامث ن أَربِّـي خ مَارَّا ثِمسْڒَايِين. <verse eid="EPH 3:10" /><verse number="11" style="v" sid="EPH 3:11" />مَانَايَا يدْجَا عْلَاحْسَاب لْغَرَض ن أَربِّـي زِي ڒبْدَا، أُو لْغَرَض-أَ يكمّڒ-يث س عِيْسَى لْمَسِيح سِيذِيثْنغ. <verse eid="EPH 3:11" /><verse number="12" style="v" sid="EPH 3:12" />زَّايس نتَّا أَ نْقَارّب غَار أَربِّـي س زْعَامث ذ تِّقث بْڒَا مَا أَ نݣّْوذ خْمِي زَّايس نْتَامن. <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />فَلِيهَذَا نِّيغ-اَوم وَار تفْشِيڒث شَا عْلَاحْسَاب اَعدّب ينُو خَاوم ڒَاحقَّاش مَانَايَا اَكنِّيو ينْفع.<verse eid="EPH 3:13" /></para>
  <para style="s">أَرَّسُوْل بُوْلُس يتْࢲَادْجَا خ ڒْمُوْمِنِين ن أَيث-ؤُفَسُوْس</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />
    <char style="it">نِّيغ-اَوم</char> خ مَانَايَا نش ترْكَاعغ خ يفَادّن ينُو زَّاث إِ بَابَاثْنغ. <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />زَّايس نتَّا إِي د تكّن يسمَاون ن لْأَصل ن مَارَّا ڒحْبَاب ن وجنَّا ذ ثْمُوْرْث. <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />تتَّارغ إِ أَربِّـي زݣ وَاݣْڒَا نّس اَعْظِيم اَكنِّيو يسجْهذ ذِي نّفْس نْوم س وفُوْس ن أَرُّوْح نّس <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />حمَا لْمَسِيح اَذ يزْذغ ذݣ وُوْڒَاون نْوم س لْإِيمَان. تتَّارغ إِ أَربِّـي عَاوذ اَذ تْوَاࢲُّوْم اَذ تُوْوْثم مْلِيح يࢲوْرَان ذݣ وشَاڒ ن ڒمْحِبّث <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />بَاش اَذ يِيڒِي غَارْوم جّهذ اَك مَارَّا صَّالِحِين اَذ تْزمَّرم اَذ تْفهْمم مشْحَاڒ ثِيڒِيو مشْحَاڒ ثَزيْرَاث مشْحَاڒ ثُوْعْڒَا مشْحَاڒ ثُوْدْجغ <char style="it">ڒمْحِبّث ن لْمَسِيح</char>. <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />أَذ تسّْنم عَاوذ مْلِيح ڒمْحِبّث-أَ ثَانِيتَا ن لْمَسِيح مشْحَاڒ ثمْغر خ مَارَّا ثُوْسْنَا <char style="it">ذِي دُّنشْت-أَ</char> بَاش اَذ تشَّارم س مِين يشُّوْر أَربِّـي.<verse eid="EPH 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20" />إِيوَا سِيذِي أَربِّـي ذ نتَّا إِي يزمَّرن اَذ يݣّ اَطَّاس س وَاطَّاس زِي مِين ذَاس نْتتَّار نِغ ذ مِين نتْخيَّال عْلَاحْسَاب جّْهذ نّس إِي يخدْمن ذَايْنغ. <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />أَغَارس ثِيڒِي لْعَظَمَا ذِي جْمَاعث ن ڒْمُوْمِنِين أُو عَاوذ ذِي عِيْسَى لْمَسِيح زِي لْجِيل غَار لْجِيل إِ ڒبْدَا ن ڒبْدَاث. آمِين!<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="s">نشِّين مَارَّا ذ يجّن ذِي جْمَاعث ن ڒْمُوْمِنِين</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />إِذن فَا نش إِݣ يدْجَان ذ اَمحْبُوْس خ سَّبَاب ن سِيذِيثْنغ اَكنِّيو نْهِيغ بَاش اَذ تُوْيُوْرم نِيشَان عْلَاحْسَاب اَوَاڒ نِّي إِي ذَاوم د يڒَاغَان زݣ وجنَّا. <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" />إِڒِيم بْڒَا تَّكبُّوْر قَاع. إِڒِيم س يِجّن ن تَّوَاضُع. صْبَرم اَك وَايَاوْيَا س تَّاسِع ن ڒْخَاضَر ذ ڒمْحِبّث. <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />ݣّث مَارَّا لْمجْهُوْد نْوم بَاش اَذ تِيڒِيم ذ يجّن ذِي أَرُّوْح يقدّْسن وَامِي ثطّْفم فُوْس ذݣ وفُوْس س ڒهْنَا. <verse eid="EPH 4:3" /><verse number="4" style="v" sid="EPH 4:4" />جْمَاعث ذ يشْتن، أَرُّوْح يقدّْسن ذ يجّن. أَمنِّي أَربِّـي وَامِي ذَاوم د يڒَاغَا، يڒَاغَا-ٱوم-د غَار لْأَمَال ذ يجّن. <verse eid="EPH 4:4" /><verse number="5" style="v" sid="EPH 4:5" />سِيذِيثْنغ ذ يجّن، لْإِيمَان ذ يجّن، طَّهَارث س وَامَان ذ يشْتن. <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />أَربِّـي بَابَاثْنغ ن مَارَّا ذ يجّن. أَقَاث خ مَارَّا، يعدُّو-د خ مَارَّا، أَقَاث ذِي مَارَّا.<verse eid="EPH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7" />شُوْف، كُڒ يجّن زَّايْنغ ثمُّوْش-اَس يِجّن ن لْبَرَكَا عْلَاحْسَاب مَامّش ت يوْزن لْمَسِيح ذ لْهَدِيَا. <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" />خ مَانَايَا يقَّار <char style="it">لْكِتَاب</char>:</para>
  <para style="q1" vid="EPH 4:8">&lt;وَامِي يݣَعّذ غَار ومْشَان نِّي إِي يُوْعْڒَان،</para>
  <para style="q2" vid="EPH 4:8">يُوْوِي اَكِذس خَربِّي ذ يمحْبَاس</para>
  <para style="q2" vid="EPH 4:8">يُوْشَا-ٱسن لْهَدِيَاث إِ يرْيَازن.&gt;<verse eid="EPH 4:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="EPH 4:9" />(مِين يخس اَذ يِينِي بلِّي نتَّا يݣَعّذ؟ يعْنِي يخس اَذ يِينِي بلِّي نتَّا يهْوَا-د عَاوذ غَار يمُوْشَان إِي يُوْدْجْغن ذِي ثْمُوْرْث. <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />وَاه، ونِّي إِي د يهْوَان ذ ونِّي س يِيخف نّس إِݣ يݣَعّْذن قَاع ذݣ وجنَّا ن يجنَّاثن بَاش اَذ يشَّار مَارَّا ثِمسْڒَايِين.) <verse eid="EPH 4:10" /><verse number="11" style="v" sid="EPH 4:11" />ذ نتَّا إِݣ يخْضَرن اَرُّسُل ذ لْأَنْبِيَا ذ يِنِّي إِݣ يتْبشَّارن س لْإِنْجِيل ذ ڒْفُقَهَا ذ يمْسڒْمَاذن. <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />نِثْنِي اَذ سْوجْذن إِ صَّالِحِين اَذ خذْمن شّْغڒ ن أَربِّـي بَاش جْمَاعث ن لْمَسِيح اَذ تجْهذ. <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />أَڒ غَا نِيڒِي مَارَّا ذ يجّن ذِي لْإِيمَان أُو ذِي ثُوْسْنَا خ مِّيس ن أَربِّـي. أَڒ غَا نِيڒِي مَارَّا عَاوذ نمْغر يعْنِي ذ يرْيَازن اَم ڒَعْبَر نِّي يكْمَاڒ ن ڒْقدّْ ن لْمَسِيح. <verse eid="EPH 4:13" /><verse number="14" style="v" sid="EPH 4:14" />أَمنِّي وَار نتْغِيمِي شَا ذ يحنْجِيرن تَاوِينْت-اَنغ ڒمْوَاج تَارَّانْت-اَنغ. نِغ ذ اَرِّيح يتْصُوْض خَانغ يكسِّي-يَانغ سَّا ذ سَّا س كُڒ اَرِّيح زَعْمَا ن وسڒْمذ أُو س ثحْرَايْمِيث ذ يخَرْوِيضن ن يرْيَازن ذ مِين تْشِيطِّينن. <verse eid="EPH 4:14" /><verse number="15" style="v" sid="EPH 4:15" />لَّا، إِنَّمَا، نشِّين خْمِي نسَّاوَاڒ ڒْحَقّ س ڒمْحِبّث لَابُد أَ نمْغر س كُڒ اَبْرِيذ أَ نِيڒِي اَم نتَّا ذ اَزدْجِيف نِّي يتْرَايَّان خَانغ يعْنِي لْمَسِيح. <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" />زَّايس زِي لْمَسِيح دَّات ثكْمَاڒ ن جْمَاعث ثْمُوْن اَقَات ذ يشْتن س قَاع ڒمْفَاسڒ نِّي إِي ذَايس. أُو كُڒ طَّارْف نّس مڒَا يخدّم نِيشَان اَتَاف اَذ يسمْغَار دَّات-أَ أُو س يِيخف نّس اَذ تبْنَا س ڒمْحِبّث.<verse eid="EPH 4:16" /></para>
  <para style="s">أَبْرِيذ ن جْذِيذ ن ڒْمُوْمِنِين</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />أَقَا مِين ذَاوم قَّارغ ذ ؤُزِيَّار-أَ إِي خَاوم تْزيَّارغ ذِي سِيذِيثْنغ، يعْنِي أُو لَابُد وَار ثݣُّوْرم شَا مَامّش ݣُّوْرن ڒݣْنُوْس س ڒَعْقُوْڒ نْسن يخْوَان. <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />نِثْنِي ثْطمّص-يثن ڒفْهَامث زَعْمَا إِي ذَايْسن. نِثْنِي ݣّْوْجن زِي ثُوْذَارْث ن أَربِّـي عْلَاحْسَاب ڒقْفَاڒث نِّي إِي ذَايْسن س ثْغنَّانْت ن وُوْڒَاون نْسن. <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />فلّْسن قَاع ذفَّارن شّهْوث نْسن أُو صَافِي، ذَايْسن يجّن ن زْعَامث اَذ سْخذْمن إِ كُڒ نُّوْع ن مِين يسخْنِيزن.<verse eid="EPH 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20" />وَلَكِن كنِّيو لَّا، مَاشِي اَمنِّي إِي ثْڒمْذم خ لْمَسِيح. <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />وَاه، ثْڒمْذم خ عِيْسَى لْحَقِيقَا إِي يدْجَان ذَايس يعْنِي مڒَا ثسْڒَام خَاس نِيشَان. <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" />إِيوَا <char style="it">تُوْغَا ثْڒمْذم</char> اَذ تْسمْحم ذِي طَّبِيعَا نِّي نْوم تُوْغَا غَارْوم قْبڒ. لِأَنَّا طَّبِيعَا نِّي نْوم ثَرشَّا عْلَاحْسَاب شّهْوث نّس يسْتْوَاغَرّن. <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" /><char style="it">تُوْغَا ثْڒمْذم</char> اَذ تِيڒِيم ذ جْذِيذ زِي ڒفْهَامث ن ڒَعْقُوْڒَاث نْوم <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" />اَذ تݣّم يجّن ن طَّبِيعَا ثنّغْنِي يعْنِي ذ جْذِيذ، ئِجّن ن طَّبِيعَا إِي د غَا يتْوَاخڒْقن اَمشْنَاو ونِّي ن أَربِّـي ذَايس ڒْحَقّ ذَايس مِين يصْفَان.<verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />إِذن لَابُد كُڒ يجّن زَّايْوم اَذ يبعّذ زݣ يخرِّيقن اَذ يسِّيوڒ س ڒْحَقّ اَك وَاجَّار نّس لِأَنَّا نشِّين مَارَّا ذ يجّن ن جْمَاعث إِي ندْجَا. <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />عصّْبث بْڒَا مَا اَذ تݣّم ڒْمُعْصِيّث. وَار تجَّاث شَا ثْفُوْشْت اَخَاوم ثغْڒِي كنِّيو عَاذ تْعصِّيبم. <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />يعْنِي وَار تجَّاث شَا اَبْرِيذ إِ شِّيطَان اَذ يَاذف ذݣ وُوْڒَاون نْوم. <verse eid="EPH 4:27" /><verse number="28" style="v" sid="EPH 4:28" />ونِّي إِݣ يتَاشَارن لَابُد اَذ يبعّذ زِي ثُوْكَّارْذَا نِّي، أَذ يخْذم يجّن ن ڒْخذْمث ذ ثَصبْحَانْت س يفَاسّن نّس بَاش اَذ يعَاون زَّايس ونِّي يتحْذَاجن.<verse eid="EPH 4:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EPH 4:29" />وَار تجَّاث شَا اَذ د يفّغ زݣ وقمُّوْم نْوم شَان وَاوَاڒ ذ اَعفَّان. لَّا، أَذ د يفّغ زَّايس غِير اَوَاڒ اَصبْحَان ونِّي يتْشجَّاعن ذ ونِّي يتْحلَّالن بَاش اَزَّايس سْنفْعن يِنِّي ذَاس يتسْڒَان. <verse eid="EPH 4:29" /><verse number="30" style="v" sid="EPH 4:30" />وَار سْخيَّاقم شَا أَرُّوْح يقدّْسن ن أَربِّـي يعْنِي ونِّي إِي زِي ثتْوَاضبْعم إِ نْهَار نِّي إِي غَا ثْنجّْمم. <verse eid="EPH 4:30" /><verse number="31" style="v" sid="EPH 4:31" />مَارَّا لْعُقْدَا ذ وغْضَاب ذ وعصّب ذ سْذَاع ذ ڒْبَاطڒ سْبعّْذم-ثن خَاوم مَارَّا، أُو كّْسث عَاوذ كُڒ نُّوْع ن ڒقْبَاحث. <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" />تݣّث ڒْخِير اَك وَايَاوْيَا، تْحِنَّام خ وَايَاوْيَا. سمّْحم إِ وَايَاوْيَا مَامّش ذَاوم يغْفَر أَربِّـي ذِي لْمَسِيح.<verse eid="EPH 4:32" /></para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1" />فَلِيهَذَا ݣّم مَامش يتݣّ أَربِّـي مِينْزِي كنِّيو ذ ثَارْوَا نّس يمْعِيزّن. <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" />عِيشم ذِي ڒمْحِبّث مَامش يݣَّا لْمَسِيح وَامِي ذَانغ يحِبّ يصدّق خَانغ يخف نّس اَم يِجّن ن صّذْقث ثُفُوْح ذ يجّن ن دْبِيحث إِ أَربِّـي.<verse eid="EPH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3" />وَا لَابُد وَار يتِيڒِي وَالُو جَارَاوم زِي لْفَسَاد نِغ ذ مِين يسخْنِيزن نِغ ذ طّْمَع ڒَاحقَّاش مَانَايَا مَاشِي مَعْقُوْل إِ صَّالِحِين. <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />أُو لَابُد عَاوذ وَار يتِيڒِي شَا جَارَاوم اَوَاڒ اَعفَّان نِغ ذ وَاوَاڒ يخْوَان نِغ ذ نُّكْتَا ذ ثَعفَّانْت؛ لَّا، ئِتْخصَّا اَذ يِيڒِي شُّكر <char style="it">إِ أَربِّـي</char>. <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />لِأَنَّا ونِّي يتݣّن لْفَسَاد نِغ ذ مِين يسخْنِيزن نِغ ذ مِين يسظْمَاعن، يعْنِي نتَّا ذ ونِّي يعبّْذن لْأَصْنَام، أَقَا تسّْنم بْڒَا شّكّ بلِّي مَارَّا يِنِّي يتݣّن مَانَايَا وَار غَارْسن بُو لْوَارث ذِي ڒْمُلْك ن لْمَسِيح نِغ ذِي أَربِّـي. <verse eid="EPH 5:5" /><verse number="6" style="v" sid="EPH 5:6" />وَار تجَّاث شَان حَدّ اَكنِّيو يشْمث س وَاوَاڒن نّس يخْوَان. لِأَنَّا خ سَّبَاب ن ثْمسْرَايِين-أَ إِ د يهوَّا وغْضَاب ن أَربِّـي خ يِنِّي إِي ث يعصَّان. <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />إِذن وَار تمْعَشَارث شَا اَكِذْسن.<verse eid="EPH 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EPH 5:8" />شُوْف، ذݣ يِجّن ن ڒْوقْث كنِّيو تُوْغَا ذ ثَادْجسْت، ڒخُّو كنِّيو ثْذوْڒم ذ يجّن ن نُّوْر ذِي سِيذِي أَربِّـي. إِيوَا عِيشث اَم ثَارْوَا ن نُّوْر. <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />أَقَا نُّوْر يتَارو-د مِين يدْجَان ذ اَصبْحَان ذ مِين يدْجَان نِيشَان ذ مِين يدْجَان ذ لْحَقِيقَا. <verse eid="EPH 5:9" /><verse number="10" style="v" sid="EPH 5:10" />ميّْزث عَاوذ مِين ذَاس يتعْجِيبن إِ سِيذِي أَربِّـي. <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />وَار شَرّْشم شَا ذِي ڒخْذَايم ن ثَادْجسْت وَار تَارْونْت شَا، فضْحم-ثنْت. <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />يِنِّي وَار يتْطِيعِين شَا. مڒَا نسِّيوڒ خَاسن يجّن ن وَاوَاڒ وَاهَا خ مِين تݣّن س ثْنُوْفْرَا اَتَاف أَ نسذْحَا. <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />وَلَكِن مِين د ينْفضْحن س نُّوْر اَذ د يمظْهَار <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />مِينْزِي ذ نُّوْر إِي د يسْمظْهَارن مَارَّا. خ مَانَايَا يقَّار لْكِتَاب:</para>
  <para style="q1" vid="EPH 5:14">&lt;فَاق شك آ ونِّي يتطّْصن كَّار-د زِي ڒْموْث،</para>
  <para style="q2" vid="EPH 5:14">أَخَاك يشعْشع لْمَسِيح س نُّوْر نّس.&gt;<verse eid="EPH 5:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />إِذن فَا، رَجْعَاث يخف نْوم خْزَرث مَامّش إِي غَا ثْعِيشم. مَاشِي اَذ تْعِيشم اَم يِنِّي إِي ذِي ثدْجَا ڒقْفَاڒث؛ لَّا، عِيشم اَم يِنِّي إِي ذِي ثدْجَا ڒفْهَامث. <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" />سْتَغلَّام ڒْوقْث نْوم مْلِيح لِأَنَّا نْهُوْرَاث-أَ ذ يعفَّانن. <verse eid="EPH 5:16" /><verse number="17" style="v" sid="EPH 5:17" />إِيوَا وَار تِيڒِيم شَا بْڒَا ڒَعْقڒ؛ لَّا، فهْمث مِين يخس سِيذِي أَربِّـي. <verse eid="EPH 5:17" /><verse number="18" style="v" sid="EPH 5:18" />وَار سْكَرث شَا س شْرب إِݣ يتَاوِين غَار لْمَدلَّا ن سّكْرَا؛ لَّا، شَّارم س أَرُّوْح يقدّْسن. <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" />سِيوْڒم اَݣ وَايَاوْيَا س وَاوَاڒن ن زَّبُوْر ذ لْأَمْدَاح ذ يِيزْڒَان رُوْحِيَا. غنّْجم، ݣّم لْمُوْسِيقَا إِ سِيذِي أَربِّـي ذݣ وُوْڒَاون نْوم. <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />شكَّرم ڒبْدَا أَربِّـي بَابَاثْنغ خ مَارَّا ثِمسْڒَايِين ذݣ يِيسم ن سِيذِيثْنغ عِيْسَى لْمَسِيح. <verse eid="EPH 5:20" /><verse number="21" style="v" sid="EPH 5:21" />طَاعم إِ وَايَاوْيَا عْلَاحْسَاب ڒُوقَّر نْوم إِ لْمَسِيح.<verse eid="EPH 5:21" /></para>
  <para style="s">يرْيَازن ذ ثمْغَارِين</para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22" />آ ثِمْغَارِين، طَاعنْت إِ يرْيَازن نْكنْت مَامّش إِي ثْطَاعَانْت إِ سِيذِيثْنغ. <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />ڒَاحقَّاش اَرْيَاز يتْرَايَّا خ ثمْغَارْث نّس مَامْش عَاوذ يتْرَايَّا لْمَسِيح خ جْمَاعث ن ڒْمُوْمِنِين. جْمَاعث-أَ يسنْجمْ-يت لْمَسِيح أُو ذ نتَّاث إِݣ يدْجَان ذ دَّات نّس. <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />أُو مَامّش ثْطَاعَا جْمَاعث ن ڒْمُوْمِنِين إِ لْمَسِيح، أَمنِّي إِي غَا طَاعنْت ثمْغَارِين إِ يرْيَازن نْسنْت ذِي مَارَّا.<verse eid="EPH 5:24" /></para>
  <para style="p">
    <verse number="25‏-26" style="v" sid="EPH 5:25-26" />آي يرْيَازن، حِبّم ثِمْغَارِين نْوم مَامّش يحِبّ لْمَسِيح جْمَاعث ن ڒْمُوْمِنِين يصدّق خَاس يخف نّس حمَا اَت يسِّيصْفَا. يَارِّي-ت ذ ثَمنْقَاوِيث وَامِي ت يسِيرذ س وَامَان ذ وَاوَاڒ نّس. <verse eid="EPH 5:25-26" /><verse number="27" style="v" sid="EPH 5:27" />حمَا لْمَسِيح اَذ يقدّم جْمَاعث ن ڒْمُوْمِنِين إِ يِيخف نّس تْشعْشِيع ذ ثَمْقدّسْت وَار تْوسِّيخ وَار تشْنِيق وَار ذَايس يتِيڒِي بُو شَا ن ڒْعِيب نّغْنِي. <verse eid="EPH 5:27" /><verse number="28" style="v" sid="EPH 5:28" />أَمنِّي كِيف-كِيف لَابُد يرْيَازن اَذ حِبّن ثِمْغَارِين نْسن مَامش تْحِبَّان دَّات نْسن. ونِّي يتْحِبَّان ثَمْغَارْث نّس ذ يخف نّس إِي يتْحِبَّا. <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />شُوْف، عمَّارْص وَار يدْجِي حَدّ يتْعِيفَّا دَّات نّس: لَّا، ئِتْذبَّر-د خَاس يتْحَوَاڒ خَاس. أَمنِّي إِي يتݣ لْمَسِيح اَك جْمَاعث ن ڒْمُوْمِنِين. <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />لِأَنَّا نشِّين ذ طْرُوْفَاث ن دَّات نّس.<verse eid="EPH 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EPH 5:31" />
    <char style="it">لْكِتَاب يقَّار:</char> &lt;خ مَانَايَا اَرْيَاز اَذ يسْمح ذِي بَابَاس ذ يمَّاس اَذ يمُوْن اَك ثمْغَارْث نّس، ثْنَاين إِذْسن اَذ ذوْڒن ذ يجّن.&gt; <verse eid="EPH 5:31" /><verse number="32" style="v" sid="EPH 5:32" />ذݣ وَاوَاڒ-أَ مِيخف نسَّاوَاڒ ذَايس يجّن ن ڒْمَعْنَا ينُوْفَّرن يُودْجغ اَطَّاس. قَّارغ نش بلِّي ڒْمَعْنَا-يَا يسَّاوَاڒ خ لْمَسِيح اَك جْمَاعث ن ڒْمُوْمِنِين. <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />إِنَّمَا، لَابُد كُڒ يجّن زَّايْوم اَذ يحِبّ ثَمْغَارْث نّس اَم مَامّش يتْحِبَّا يخف نّس. ثَمْغَارْث أُو لَابُد اَذ تْوقَّر اَرْيَاز نّس.<verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="s">ئِحنْجِيرن ذ لْوَالِدِين نْسن</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />آي يحنْجِيرن طَاعم إ لْوَالِدِين نْوم ذِي سِيذِيثْنغ، أَقَا مَانَايَا نِيشَان إِݣ يدْجَا. <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" /><char style="it">لْكِتَاب يقَّار:</char> &lt;وقَّر بَابَاش ذ يمَّاش.&gt; وَار ذِنِّي بُو شَان ڒُوْصِيّث نّغْنِي قْبڒ إِ ثَانِيتَا يُوْشَا-د اَكِذس أَربِّـي يجّن ن لْوَعْد. <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" /><char style="it">يعْنِي ينَّا:</char> &lt;حمَا اَغَارك ثِيڒِي مَارَّا مْلِيح، حمَا اَذ يڒِين وُوْسَّان نّش ذِي دُّنشْت-أَ ذ يزيْرَارن.&gt; <verse eid="EPH 6:3" /><verse number="4" style="v" sid="EPH 6:4" />آي يبَابَاثن، وَار سغْضَابم شَا يحنْجِيرن نْوم، ربَّام-ثن خ تَّرْبِيّث ذ وسڒْمذ ن سِيذِيثْنغ.<verse eid="EPH 6:4" /></para>
  <para style="s">ئِسمْغَان ذ أَيثْبَاب ن يسمْغَان</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />آي يسمْغَان، طَاعم إِ أَيثْبَاب نْوم ذِي دُّنشْت-أَ، وقَّرم-ثن ݣّْوْذم-ثن س يِجّن ن وُوْڒ يصْفَا اَمشْنَاو مَّامش ثْطَاعَام إِ لْمَسِيح. <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />طَاعم-اَسن مَاشِي غِير خْمِي ذَاوم تْبدَّان غَار وزدْجِيف وَاهَا اَذَاسن ثْعجْبم؛ لَّا، أَذ تِيڒِيم اَم يسمْغَان ن لْمَسِيح اَذ تݣّم س ڒْخَاضَر نْوم مِين يخس أَربِّـي. <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />خذْمم س يِجّن ن ڒْخَاضَر نْوم اَخْمِي ثْخدّْمم إِ سِيذِيثْنغ مَاشِي إِ يرْيَازن. <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />ئِتْخصَّا كنِّيو اَذ تسّْنم مَارَّا ڒْخِير إِي غَا ثݣّم اَكنِّيو يجَزَا خَاس سِيذِيثْنغ وَاخَّا كنِّيو ذ يسمْغَان نِغ ذ أَيثْبَاب نْسن.<verse eid="EPH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9" />أُو كنِّيو آي أَيثْبَاب ن يسمْغَان اَذَاسن ثݣّم كِيف-كِيف، مَاشِي اَثن تْسِݣّْوْذم. أَقَا ثسّْنم بلِّي بَاب نْوم ذ بَاب نْسن نتَّا ذ يجّن اَقَاث ذݣ وجنَّا، وَار يتݣّ بُو س وُوْذمَاون.<verse eid="EPH 6:9" /></para>
  <para style="s">ڒسْنَاح إِي د يتَاسن زِي سِيذِي أَربِّـي</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />أَقَا اَوَاڒ ينُو اَنݣَّارُو: جهْذث س سِيذِي أَربِّـي أُو س لْقُوَّا نّس ثَمقّْرَانْت. <verse eid="EPH 6:10" /><verse number="11" style="v" sid="EPH 6:11" />ݣّم خَاوم مَارَّا ڒسْنَاح ن أَربِّـي بَاش اَذ تسْبدّم مِين خَاوم يتْشِيطِّين إِبْڒِيس. <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />لِأَنَّا نشِّين وَار نتْمنْغِي شَا ضد إِ يِوْذَان ن ويْسُوْم ذ يذَامّن. لَّا، نتْمنْغَا ضذ ن ثْزمَّار ن ثَادْجسْت-أَ ثَانِيتَا ن زْمَان-أَ ذ يِنِّي إِݣ يحكّْمن ذ يِنِّي إِݣ يجهْذن ذِي ثَادْجسْت-أَ. نشِّين نتْمنْغَا ضذ ن شَّيَاطِين يعفَّانن إِݣ يدْجَان ذݣ يمُوْشَان ن يجنَّاثن. <verse eid="EPH 6:12" /><verse number="13" style="v" sid="EPH 6:13" />س مَانَايَا يْسِيث غَارْوم مَارَّا ڒسْنَاح ن أَربِّـي بَاش وَار تْركّْوِيڒم<note caller="+" style="f"><char style="fr" closed="false">6‏.13 </char><char style="ft" closed="false">بَاش وَار تْركّْوِيڒم شَا يخس اَذ يينِي "بَاش ور تْروِّيڒم شِي."</char></note> شَا ذِي نْهَار ن شَّرّْ. أُو مڒَا ثݣِّيم مَانَايَا مَارَّا، أَتَاف اَذ تْبدّم. <verse eid="EPH 6:13" /><verse number="14" style="v" sid="EPH 6:14" />بدّم بَعْدَا نِيشَان، حزّْمم اَحزَّام نِّي ن لْحَقِيقَا إِي تݣّم ذِي نّصّ. ݣّم عَاوذ ثْجِيلِيت نِّي ن ڒحْذِيذ ن ڒْحَقّ. <verse eid="EPH 6:14" /><verse number="15" style="v" sid="EPH 6:15" />قّْنم ثِسِيڒَا إِ يضَارن نْوم بَاش اَذ تسْوجْذم يخف نْوم اَذ تْبشَّرم س لْإِنْجِيل ن ڒهْنَا. <verse eid="EPH 6:15" /><verse number="16" style="v" sid="EPH 6:16" />أَذ تيْسِيم ڒبْدَا لْإِيمَان نْوم اَم يِجّن ن لْحِمَايَا خ وفُوْس إِي زِي غَا ثْسخْسِيم مَارَّا فْڒِيتْشَاث نِّي يحَرّْقن ن وعفَّان نِّي <char style="it">ن إِبْڒِيس</char>. <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" />يْسِيث عَاوذ لْكَسْك ن وسفْڒث، سْخذْمم اَكِذس سِّيف نِّي ن أَرُّوْح يقدّْسن إِݣ يدْجَان ذ اَوَاڒ ن أَربِّـي. <verse eid="EPH 6:17" /><verse number="18" style="v" sid="EPH 6:18" />مَارَّا ظُّرُوْف إِي ذِي ثدْجَام تَّارم إِ أَربِّـي خَاسن س أَرُّوْح يقدّْسن س مَارَّا لْأَنْوَاع ن ثْࢲَادْجِيث ذ دُّعَاء. سْخذْمم ڒَعْقڒ نْوم ذِي مَانَايَا، أَرّم-د ڒْبَاڒ نْوم س يِجّن ن صّْبَر، تَّارم خ مَارَّا صَّالِحِين. <verse eid="EPH 6:18" /><verse number="19" style="v" sid="EPH 6:19" />تَّارم خَافِي نش عَاوذ مڒْمِي مَا رزْمغ اَقمُّوْم ينُو اَذَايِي مُوْشّن وَاوَاڒن إِي زِي غَا بشَّرغ س ڒْمَعْنَا ينُوْفَّرن ن لْإِنْجِيل. <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />عْلَاحْسَاب لْإِنْجِيل-أَ وَانِيتَا إِي تِيڒِيغ نش ذ يجّن ن سَّفِير شَرّْفغ س سْنَاسڒ. ࢲَّادْجم كنِّيو بَاش اَزَّايس بشَّرغ بْڒَا مَا ٱذ ݣّْوْذغ عْلَاحْسَاب لْوَاجِب ينُو.<verse eid="EPH 6:20" /></para>
  <para style="s">سْڒَام اَنݣَّارُو</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />رزُّوْغ اَذ تسّْنم مَامش دْجِيغ ذ مِين تݣّغ. ذ ؤُمَا تُوْشِيق يعِيزّن إِي ذَاوم غَا يِينِين مَارَّا مَانَايَا. نتَّا ذ يجّن ن وخدَّام نِيشَان ذِي سِيذِيثْنغ. <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />تْسكِّيغ-اَوم-ث-يذ إِ كنِّيو خ سَّبَاب-أَ وَانِيتَا بَاش اَذ تسّْنم مَامش دْجِيغ نش اَذ يشجّع ؤُڒَاون نْوم.<verse eid="EPH 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23" />أَذ يِيڒِي ڒهْنَا إِ أَيثْمَاثْنغ ذ ڒمْحِبّث اَك لْإِيمَان زِي أَربِّـي بَابَاثْنغ ذ سِيذِيثْنغ عِيْسَى لْمَسِيح. <verse eid="EPH 6:23" /><verse number="24" style="v" sid="EPH 6:24" />أَذ يِيڒِي اَرْضَا إِ مَارَّا يِنِّي إِݣ يتْحِبَّان سِيذِيثْنغ عِيْسَى لْمَسِيح س يِجّن ن ڒمْحِبّث وَار ثْفنِّي شَا عمَّارْص.<verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>