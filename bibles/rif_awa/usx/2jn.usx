<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- TarifitABS</book>
  <para style="h">2 يوحنا</para>
  <para style="toc3">2يوح</para>
  <para style="toc2">2 يوحنا</para>
  <para style="toc1">ثَبْرَات وِيس ثْنَاين ن اَرَّسُوْل يُوْحَنَّا</para>
  <para style="mt1">ثَبْرَات وِيس ثْنَاين ن اَرَّسُوْل يُوْحَنَّا</para>
  <chapter number="1" style="c" sid="2JN 1" />
  <para style="s">لْمُقَدِّمَا</para>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1" />نش ذ اَمْغَار، <char style="it">تَارِيغ ثَبْرَات-أَ</char> إِ ثمْغَارْث يتْوَاخْضَرن ذ ثَارْوَا نّس إِي تخْسغ ذِي لْحَقِيقَا.<note caller="+" style="f"><char style="fr" closed="false">1‏.1 </char><char style="ft" closed="false">ثَمْغَارْث-أَ يعْنِي نتَّاث ذ يجّن ن جْمَاعث. ثَارْوَا نّس يعْنِي نِثْنِي ذ ڒْمُوْمِنِين ن جْمَاعث-أَ.</char></note> مَاشِي ذ نش وَاهَا إِي ثن يتخْسن؛ لَّا، تخْسن-ثن قَاع يِنِّي يسّْنن لْحَقِيقَا. <verse eid="2JN 1:1" /><verse number="2" style="v" sid="2JN 1:2" />مَانَايَا عْلَاحْسَاب لْحَقِيقَا إِݣ يزدّْغن ذَايْنغ اَذ تِيڒِي اَكِذْنغ إِ ڒبْدَا.<verse eid="2JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3" />عْلَاحْسَاب لْحَقِيقَا ذ ڒمْحِبّث اَكِذْنغ يِيڒِي اَرْضَا ذ اَرَّاحْمث ذ ڒهْنَا زِي أَربِّـي بَابَاثْنغ ذ عِيْسَى لْمَسِيح ونِّي يدْجَان ذ مِّيس ن بَابَاثْنغ.<verse eid="2JN 1:3" /></para>
  <para style="s">لْحَقِيقَا ذ ڒمْحِبّث</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4" />نش فَرْحغ اَطَّاس وَامِي ؤُفِيغ زِي ثَارْوَا نّمْ يِنِّي يݣُّوْرن ذݣ ؤُبْرِيذ ن لْحَقِيقَا اَم مَامّش ذَانغ يوصَّا بَابَاثْنغ. <verse eid="2JN 1:4" /><verse number="5" style="v" sid="2JN 1:5" />آ ثَمْغَارْث يتْوَاعِيزّن، ڒخُّو تتَّارغ زَّايم أَ نْتخْس اَيَاوْيَا. وَار ذَام د تَارِيغ بُو شَان ن ڒُوْصِيّث ذ جْذِيذ؛ لَّا، نتَّاث ذ ثنِّي تُوْغَا غَارْنغ زݣ ومزْوَارُو. <verse eid="2JN 1:5" /><verse number="6" style="v" sid="2JN 1:6" />إِيوَا اَمُّو إِي ثدْجَا ڒمْحِبّث يعْنِي أَ نݣُّوْر عْلَاحْسَاب ڒُوْصِيَاث نّس. ڒُوْصِيّث-أَ نتَّاث ذ ثنِّي تُوْغَا ثسْڒِيم زݣ ومزْوَارُو. وَا اَمُّو يتْخصَّا اَذَايس ثݣُّوْرم.<verse eid="2JN 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7" />أَقَا اَطَّاس ن يثَرَّاسن نِثْنِي ذ يغدَّارن فّْغن-د غَار دُّنشْت-أَ، نكَّرن بلِّي عِيْسَى لْمَسِيح يمظْهَار-د س دَّات ن بْنَاذم. أَثَرَّاس-أَ إِي يدْجَان اَمُّو نتَّا ذ اَغدَّار وَاهَا ذ دّجَّال إِي يدْجَا. <verse eid="2JN 1:7" /><verse number="8" style="v" sid="2JN 1:8" />حْضَام يخف نْوم حمَا اَذ تْربْحم لْجَائِزَا نْوم ثكْمَاڒ مَاشِي اَذ تخْسَرم مِينْخف نْخدّم. <verse eid="2JN 1:8" /><verse number="9" style="v" sid="2JN 1:9" />ونِّي يرُوْحن غَار ڒݣّْوَاج وَار يقِّيم شَا ذِي تَّعْلِيم ن لْمَسِيح اَتَاف وَار غَارس شَا أَربِّـي. ونِّي يقِّيمن ذِي تَّعْلِيم-أَ اَغَارس يِيڒِي بَابَاثْنغ اَك مِّيس. <verse eid="2JN 1:9" /><verse number="10" style="v" sid="2JN 1:10" />ونِّي إِي غَارْوم د يتَاسن وَار د يتِيوِي اَكِذس تَّعْلِيم-أَ، ئِتْخصَّا-كنِّيو وَار ث ثْسِيذِيفم شَا غَار ثُوْذْرِين نْوم وَار ذَاس ثقَّارم شَا حتَّا ؤُڒَا ذ أَزُوْل. <verse eid="2JN 1:10" /><verse number="11" style="v" sid="2JN 1:11" />ڒَاحقَّاش ونِّي إِي ذَاس غَا ينِين ؤُڒَا ذ أَزُوْل اَتَاف يشَرّش اَكِذس ذِي ڒفْعَايڒ نّس ثِعفَّانِين.<verse eid="2JN 1:11" /></para>
  <para style="s">لْخِتَام ن ثبْرَات-أَ</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12" />عَاذ غَارِي اَطَّاس إِي خْسغ اَذَاوم ثِيذ اَرِيغ إِ كنِّيو وَلَكِن اَذ يِيڒِي حْسن مڒَا وَار سْتعْمِيڒغ شَا ذِي ثِوْڒِيقِين ذ سّْمخ. لَّا، تْمنِّييغ اَغَارْوم د اَسغ اَكِذْوم سِّيوْڒغ اَغمْبُوْب ذݣ وغمْبُوْب بَاش ڒفْرَاحث نّغ اَذ تجَّاون.<verse eid="2JN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13" />تْسَاوَّاضن-اَوم-د سْڒَام ثَارْوَا ن وُوْتْشْمَام يتْوَاخْضَرن.<verse eid="2JN 1:13" /></para>
  <chapter eid="2JN 1" />
</usx>