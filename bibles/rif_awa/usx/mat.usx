<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">Draft I, June 2001, Printed Version</book>
  <para style="h">متى</para>
  <para style="toc3">مت</para>
  <para style="toc2">متى</para>
  <para style="toc1">أَسڒْمذ ن سِيذِيثْنغ عِيْسَى لْكِتَاب ن مَتَّى</para>
  <para style="mt1">أَسڒْمذ ن سِيذِيثْنغ عِيْسَى</para>
  <para style="mt3">لْكِتَاب ن مَتَّى</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">ڒجْذُوْذ ن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />وَا ذ لْكِتَاب ن ڒجْذُوْذ ن عِيْسَى لْمَسِيح، ونِّي يدْجَان زِي دُّوْرِّيث ن دَاود ذ بْرَاهِيم.<verse eid="MAT 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2" />بْرَاهِيم يجَّا-د إِسْحَاق. إِسْحَاق يجَّا-د يَعْقُوْب. يَعْقُوْب يجَّا-د يَهُوْذَا ذ أَيثْمَاس. <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />يَهُوْذَا يجَّا-د فَارِس ذ زَارَح اَك ثمْغَارْث نّس ثَامْرَا. فَارِس يجَّا-د حَصْرُوْن. حَصْرُوْن يجَّا-د أَرَام. <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />أَرَام يجَّا-د عَمِينَادَاب. عَمِينَادَاب يجَّا-د نَسُّوْن. نَسُّوْن يجَّا-د سَلْمُوْن. <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />سَلْمُوْن يجَّا-د بُوْعَزَّا اَك ثمْغَارْث نّس رِيحَاب. بُوْعَزَّا يجَّا-د عُوْبَايْد اَك ثمْغَارْث نّس رَاعُوْث. عُوْبَايْد يجَّا-د يَسَّى. <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" />يَسَّى يجَّا-د دَاود اَزدْجِيذ. دَاود اَزدْجِيذ يجَّا-د سُلِيْمَان زِي ثنِّي تُوْغَا يدْجَان ذ ثَمْغَارْث ن أُوْرْيَاح.<verse eid="MAT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 1:7" />سُلِيْمَان يجَّا-د رَحُبْعَام. رَحُبْعَام يجَّا-د أَبِيَا. أَبِيَا يجَّا-د أَسَا. <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />أَسَا يجَّا-د يَهُوْشَافَاط. يَهُوْشَافَاط يجَّا-د يُوْرَام. يُوْرَام يجَّا-د عُزَّيَا. <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />عُزَّيَا يجَّا-د يُوْثَام. يُوْثَام يجَّا-د أَحَاز. أَحَاز يجَّا-د حِسْقِي. <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />حِسْقِي يجَّا-د مَنَسَّى. مَنَسَّى يجَّا-د أَمُوْن. أَمُوْن يجَّا-د يُوْشِيَا. <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />يُوْشِيَا يجَّا-د يَكُنْيَا ذ أَيثْمَاس ذِي ڒْوقْث نِّي وَامِي تْوَاسُوْفْغن غَار بَابِل.<verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />منْبَعْد إِ ڒْوقْث نِّي وَامِي تْوَاسُوْفْغن غَار بَابِل، يَكُنْيَا يجَّا-د شْعَالْتِيهِيل. شْعَالْتِيهِيل يجَّا-د زَرُبَّابِل. <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />زَرُبَّابِل يجَّا-د أَبِيهُوْد. أَبِيهُوْد يجَّا-د لْيَاقِيم. لْيَاقِيم يجَّا-د عَازُوْر. <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />عَازُوْر يجَّا-د صَادُوْق. صَادُوْق يجَّا-د أَخِيم. أَخِيم يجَّا-د أَلْيُوْد. <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />أَلْيُوْد يجَّا-د لْعِزَار. لْعِزَار يجَّا-د مَتَّان. مَتَّان يجَّا-د يَعْقُوْب. <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />يَعْقُوْب يجَّا-د يُوْسف اَرْيَاز ن مَرْيَم نتَّاث إِي د يجِّين عِيْسَى إِݣ يتْوَاسمَّان س لْمَسِيح.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />ذِنِّي اَرْبعْطَاش ن لْأَجْيَال زِي بْرَاهِيم غَار دَاود. زِي دَاود حتَّا وَامِي تْوَاسُوْفْغن غَار بَابِل اَرْبعْطَاش ن لْأَجْيَال. زݣ وَامِي تْوَاسُوْفْغن غَار بَابِل حتَّا وَامِي د يخْڒق لْمَسِيح اَرْبعْطَاش ن لْأَجْيَال.<verse eid="MAT 1:17" /></para>
  <para style="s">لْخُلُوْق ن سِيذِيثْنغ عِيْسَى لْمَسِيح</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />فَا مَامّش إِي د يخْڒق عِيْسَى لْمَسِيح. يمَّاس مَرْيَم تُوْغَا ثݣَّا لْخُطُوْبَا اَك يُوْسف. منْبَعْد قْبڒ مَا ٱذ مڒْشن جَارَاسن ثيْسِي اَعدِّيس زِي أَرُّوْح يقدّْسن. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />يُوْسف اَنخْضَاب نّس، نِيشَان إِݣ يدْجَا. وَار يخس شَا اَخَاس يضْڒق دِّعَايَا، يرزُّو اَذَاس يدْجف س ثْنُوْفْرَا.<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />وَلَكِن وَامِي يتْفكَّر ذِي ثْمسْڒَايْث نِّي، ثْبدّ-د خَاس يجّن ن لْمَلَائِكَا ذِي ثِيرْجِيث ثنَّا-ٱس: "آ يُوْسف آ مِّيس ن أَيث-دَاود، وَار تݣّْوذ شَا اَذ تِيڒِي مَرْيَم ذ ثَمْغَارْث نّش. أَقَا زِي أَرُّوْح يقدّْسن إِي زِي ثيْسِي اَعدِّيس. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />أَقَا اَذ د تجّ يجّن ن وحنْجِير اَث ثْسمِّيذ عِيْسَى ڒَاحقَّاش نتَّا إِي غَا يسْنجْمن ڒْقُوْم نّس زِي ڒْمُعْصِيَاث نْسن."<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />قَا ذ مَانَايَا مَارَّا إِݣ يوقْعن حمَا اَذ يكمّڒ وَاوَاڒ إِي ينَّا سِيذِي أَربِّـي إِ نَّبي <char style="it">إِشَعْيَا</char> ذݣ يِجّن ن زْمَان: <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />&lt;أَقَا ثَعْزْرِيث اَذ تيْسِي اَعدِّيس، أَذ تجّ يجّن ن وحنْجِير اَذَاس سمَّان إِمَّانْوِيل.&gt; (ڒْمَعْنَا نّس: أَربِّـي اَقَاث اَكِذْنغ.)<verse eid="MAT 1:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />وَامِي د يفَاق يُوْسف زݣ يِضص يݣَّا مِين ذَاس ثنَّا لْمَلَائِكَا ن سِيذِي أَربِّـي، يُوْوِي-د ثَمْغَارْث نّس. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />وَلَكِن وَار غَارس يقَارّب شَا اَڒ وَامِي د ثجَّا مِّيس. ثُمَّا يسمَّا-ث يݣَّا-ٱس عِيْسَى.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">يِنِّي يقَّارن لْعِلم ن يِثْرَان</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />وَامِي د يخْڒق عِيْسَى ذݣ وبِيلَاج ن بَيْت لَحْم ذِي ثْمُوْرْث ن يَهُوْذِيَا ذِي ڒْوقْث ن وزدْجِيذ هِيرُوْدُس، ؤُسِين-د شَان يِوذَان زݣ يِنِّي يقَّارن لْعِلم ن يِثْرَان زِي شَّرْق غَار ثنْدِينْت ن لْقُدْس. <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />نَّان: "مَانِي يدْجَا وحنْجِير نِّي إِي د يخڒْقن اَذ يِيڒِي ذ اَزدْجِيذ ن أَيث-إِسْرَائِيل؟ أَقَا نࢲْرَا يثْرِي نّس ذِي شَّرق، قَا نُوْسَا-د اَذَاس نْسجّذ."<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />وَامِي يسْڒَا وزدْجِيذ هِيرُوْدُس مَانَايَا، ئِخيّق ييْسِي يجّن ن ومْنُوْس ذ اَمقّْرَان نتَّا ذ يمزْذَاغ ن لْقُدْس. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />ئِسْمُوْن مَارَّا اَرُّوْيَاس ن ڒْفُقَهَا <char style="it">ن أَيث-إِسْرَائِيل</char> ذ يمْسڒْمَاذن ن شَّرِيعَا يسّقْسَا-ثن ينَّا-ٱسن: "مَانِي د غَا يخْڒق لْمَسِيح؟"<verse eid="MAT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5" />أَرِّين خَاس نَّان-اَس: "ذِي بَيْت لَحْم ذِي ثْمُوْرْث ن يَهُوْذِيَا، مَامّش يُوْرَا نَّبِي <char style="it">مِيخَا</char> ذݣ يِجّن ن زْمَان:<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />
    <char style="it">أَربِّـي ينَّا:</char> &lt;ؤُڒَا ذ شم،</para>
  <para style="q2" vid="MAT 2:6">آ بَيْت لَحْم ذِي ثْمُوْرْث ن يَهُوْذِيَا،</para>
  <para style="q1" vid="MAT 2:6">وَار ثدْجِيذ بُو ذ ثَمزْيَانْت</para>
  <para style="q2" vid="MAT 2:6">جَار ثْندَّام<note caller="+" style="f"><char style="fr" closed="false">2‏.6 </char><char style="ft" closed="false">ثِندَّام نِثنْتِي ذ ثِنْدِينِين.</char></note> ن يَهُوْذِيَا.</para>
  <para style="q1" vid="MAT 2:6">زَّايم إِي د غَا يفّغ يجّن ن لْحَاكم</para>
  <para style="q2" vid="MAT 2:6">إِي غَا يندْهن شَّعْب ينُو ن أَيث-إِسْرَائِيل.&gt;"<verse eid="MAT 2:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />ڒخْدّنِّي يڒَغَا-يَاسن-د وزدْجِيذ هِيرُوْدُس س ثْنُوْفْرَا إِ يِنِّي يقَّارن لْعِلم ن يِثْرَان، ئِسّقْسَا-ثن يسّن زَّايْسن مڒْمِي تُوْغَا د يمظْهَار يِيثْرِي-يَا. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />سّنِّي يسّكّ-يثن غَار بَيْت لَحْم ينَّا-ٱسن: "رُوْحم ذِنِّي رْزُوْم مْلِيح خ وحنْجِير نِّي. خْمِي ث غَا ثَافم، عڒْمم-اَيِي بَاش اَذ رَاحغ ؤُڒَا ذ نش اَذَاس سجّْذغ."<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />سْڒِين مِين ينَّا وزدْجِيذ، كَّرن رُوْحن ذِنِّي. ئِثْرِي نِّي إِي ࢲْرين ذِي شَّرق يݣُّوْر غَار زَّاث. وَامِي يُوْوض يِثْرِي نِّي، ئِبدّ ذݣ وجنَّا غَار مَانِي يدْجَا وحنْجِير نِّي. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />وَامِي ࢲْرِين يثْرِي نِّي فَرْحن اَطَّاس. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />ؤُذْفن ثَدَّارْث نِّي، ؤُفِين اَحنْجِير نِّي اَك يمَّاس مَرْيَم، ؤُضَان خ يفَادّن نْسن سجّْذن-اَس. كّْسن-د ڒكْنُوْز نْسن، يعْنِي دّْهب ذ تْبَخُوْر لْلُبَان ذ يِجّن ن ڒْحَاجث ذ تُوْفُح قَّارن-اَس مُوْرّْ، ؤُشِين-اَس-ثن ذ لْهَدِيَاث.<verse eid="MAT 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 2:12" />ئِعْڒم-اَسن أَربِّـي ذِي ثِيرْجِيث ينَّا-ٱسن وَار تعْقِيبم شَا غَار وزدْجِيذ هِيرُوْدُس. صَافِي كَّرن ذوْڒن غَار ثْمُوْرْث نْسن خ يِجّن ن وبْرِيذ نّغْنِي.<verse eid="MAT 2:12" /></para>
  <para style="s">ثَرْوڒَا غَار مِصْرَا</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />وَامِي ؤُيُوْرن <char style="it">يِوْذَان نِّي يقَّارن لْعِلم ن يِثْرَان</char>، ثْبدّ-د يجّن ن لْمَلَائِكَا ن سِيذِي أَربِّـي ذِي ثِيرْجِيث غَار يُوْسف ثنَّا-ٱس: "كَّر إِيْسِي اَحنْجِير ذ يمَّاس ارْوڒ غَار مِصْرَا، زذْغم ذِنِّي اَڒ ذَاش غَا ينِيغ ذْوڒ-د. أَقَا اَزدْجيذ هِيرُوْدُس يرزُّو خ وحنْجِير-أَ بَاش اَث ينغ." <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />ئِكَّر يُوْسف يُوْيُوْر س دْجِيڒث غَار مِصْرَا يُوْوِي اَحنْجِير نِّي ذ يمَّاس اَكِذس. <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />ئِقِّيم ذِنِّي حتَّا اَڒ وَامِي يمُّوْث هِيرُوْدُس. قَاع مَانَايَا يوْقع حمَا اَذ يكمّڒ وَاوَاڒ إِݣ ينَّا سِيذِي أَربِّـي إِ نَّبِي ؤُمِي قَّارن <char style="it">هُوْشَع</char> ذݣ يِجّن ن زْمَان: &lt;قَا ڒَاغِيغ-د إِ مِّي باش اَذ د يفّغ زِي مِصْرَا.&gt;<verse eid="MAT 2:15" /></para>
  <para style="s">ڒْموْث ن يحنْجِيرن ن بِيْت لَحْم</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />وَامِي د يَارَّا ڒخْبَار هِيرُوْدُس بلِّي يِنِّي يقَّارن لْعِلم ن يِثْرَان شمْثن-ث، يعصّب اَطَّاس يغْضب. ئِسّكّ بَاش اَذ ينغ يحنْجِيرن نِّي مَارَّا ذِي بَيْت لَحْم ذ نَّوَاحِي نّس إِي غَار ثدْجَا قلّ زِي عَمَاين. مَانَايَا عْلَاحْسَاب ڒْوقْث إِي ذَاسن د يمظْهَار يِيثْرِي نِّي إِ يِنِّي يقَّارن لْعِلم ن يِثْرَان. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />ڒخْدّنِّي يكمّڒ وَاوَاڒ نِّي إِي ينَّا سِيذِي أَربِّـي إِ نَّبي ؤُمِي قَّارن إِرْمِيَا ذݣ يِجّن ن زْمَان:<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />&lt;ثْغُويِّيث تسْڒَان-اَس زِي دْشَار ن رَامَا، ذ يمطَّاون ذ وَاطَّاس ن لْحُزن،</para>
  <para style="q1" vid="MAT 2:18">ذ أَيث-رَاحِيل إِݣ يتْرُوْن خ ثَارْوَا نْسن، وَار خْسن اَثن يعزَّا حَدّ خ ثَارْوَا نْسن يمُّوْثن.&gt;<verse eid="MAT 2:18" /></para>
  <para style="s">تعْقَابن-د زِي مِصْرَا غَار نَاصِرَا</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />وَامِي يمُّوْث وزدْجِيذ هِيرُوْدُس ثْبدّ-د يجّن ن لْمَلَائِكَا ن سِيذِي أَربِّـي غَار يُوْسف ذِي ثِيرْجِيث ذِي مِصْرَا. <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />ثنَّا-ٱس: "كَّر عْقب، أَوِي اَكِذش اَحنْجِير-أَ ذ يمَّاس غَار ثْمُوْرْث ن أَيث-إِسْرَائِيل، أَقَا يِنِّي يخْسن اَذ نْغن اَحنْجِير-أَ قَا مُّوْثن." <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />سّنِّي يكَّر يُوْسف يُوْوِي اَكِذس اَحنْجِير نِّي ذ يمَّاس يذْوڒ غَار ثْمُوْرْث نّس ن أَيث-إِسْرَائِيل. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />وَلَكِن وَامِي يسْڒَا بلِّي اَزدْجِيذ أَرْخِيلَاوُس يخْڒف بَابَاس هِيرُوْدُس ذِي ڒحْكَام ن يَهُوْذِيَا، ئِݣّْوذ اَذ يرَاح ذِنِّي. <char style="it">سِيذِي أَربِّـي</char> يعْڒم-اَس-د عَاوذ ذݣ يِجّن ن ثِيرْجِيث، ئِكَّر يرُوْح غَار جِّهث ن ثْمُوْرْث ن لْجَلِيل. <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />ئِزْذغ ذݣ يِجّن ن وبِيلَاج قَّارن-اَس نَاصِرَا حمَا اَذ يكمّڒ وَاوَاڒ نِّي إِي ينَّا سِيذِي أَربِّـي إِ لْأَنْبِيَا ذݣ يِجّن ن زْمَان: &lt;أَقَا اَذَاس سمَّان نَاصِرِي.&gt;<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">نَّبِي يَحْيَى يسوْجَاذ اَبْرِيذ إِ لْمَسِيح</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />ذِي ڒْوقْث نِّي يمظْهَار-د يَحْيَى، ئِتْطهَّار إِ يِوْذَان س وَامَان يتْبشَّر-يثن ذِي ڒخْڒَا ن يَهُوْذِيَا. <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />ئِقَّار-اَسن: "تُوْبم، أَقَا يُوْذس-د ڒْمُلْك ن وجنَّا." <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />خ يَحْيَى إِݣ ينَّا نَّبي ؤُمِي قَّارن إِشَعْيَا ذݣ يِجّن ن زْمَان:</para>
  <para style="q1" vid="MAT 3:3">&lt;ثْمِيجَّا تْڒَاغَا ذِي ڒخْڒَا ثقَّار:</para>
  <para style="q2" vid="MAT 3:3">سْوجْذث اَبْرِيذ إِ سِيذِي أَربِّـي،</para>
  <para style="q1" vid="MAT 3:3">ݣّم يبْرِيذن نّس نِيشَان.&gt;<note caller="+" style="f"><char style="fr" closed="false">3‏.3 </char><char style="ft" closed="false">خْزَر إِشَعْيَا 40‏:3.</char></note><verse eid="MAT 3:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />يَحْيَى اَرُّوْض نّس خذْمن-ث س شْعَر ن وڒْغم، خ نّصّ نّس يجّن ن وحزَّام ن يِيڒم. ئِتتّ ثْمُوْرْغِي ذ ثَامّنْت ثَحُوْرّشْت. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />تَاسن-د غَارس يمزْذَاغ ن ثنْدِينْت ن لْقُدْس ذ يِنِّي ن يَهُوْذِيَا اَمن-ثكْمَاڒ ذ مَارَّا يِنِّي إِي د ينّْضن إِ يغْزَار ن لأُرْدُن. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />تعْتَارَافن س ڒْمُعْصِيَاث نْسن، يَحْيَى يتْطهَّار-يثن س وَامَان ذݣ يِغْزَار ن لأُرْدُن.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />وَلَكِن وَامِي يࢲْرَا يَحْيَى بلِّي اَطَّاس ن ڒْفُقَهَا ذ يفَرِّسِيْين ذ يصَدُّوْقِيْين تَاسن-د غَارس حمَا اَثَن يطهَّار س وَامَان ينَّا-ٱسن: "يَا ثَارْوَا ن يفِيغرَان، وِي ذَاوم يعڒْمن اَذ تَروْڒم زِي لْغَضَب <char style="it">ن سِيذِي أَربِّـي</char> إِي د غَا يَاسن؟ <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />مڒَا ثْتُوْبم ذ صَّح، ݣّث ڒخْذَايم ثِصبْحَانِين. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />مَاشِي اَذ تِينِيم ذِي نّفْس نْوم قَا نشِّين ذ ثَارْوَا ن بْرَاهِيم أُو صَافِي. مڒَا يخس أَربِّـي ثَارْوَا ن بْرَاهِيم، أَتَاف اَذ ييْسِي يزْرَا-يَا اَثن يَرّ ذ ثَارْوَا ن بْرَاهِيم! <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />أَقَا شَاقُوْر يوْجذ حمَا اَذ يقسّ يࢲوْرَان ن ڒْشجُّوْر. مْكُڒ ثَشجَّارْث إِي وَار يتِيرْون شَا مِين يدْجَان ذ اَصبْحَان اَتَاف اَذ تْوَاقسّ اَذ تْمنْضَار ذِي ثْمسِّي. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />نش تْطهَّارغ-كنِّيو س وَامَان بَاش اَذ تُوْبم، وَلَكِن ونِّي إِي د غَا يَاسن منْبَعْد إِ نش، نتَّا يجْهذ خَافِي. وَار سْذِيهِيدْجغ شَا اَذَاس يْسِيغ ؤُڒَا ذ ثِسِيڒَا نّس. نتَّا اَكنِّيو يطهَّار س أَرُّوْح يقدّْسن ذ <char style="it">يِيڒسَاون ن</char> ثْمسِّي.<note caller="+" style="f"><char style="fr" closed="false">3‏.11 </char><char style="ft" closed="false">س ثْيُوْنَانِيث ن لْأَصل يقَّار "س أَرُّوْح يقدّْسن ذ ثْمسِّي." يمْكن يسَّاوَاڒ ذَانِيتَا خ مِين غَا يوقْعن ذِي ڒخْذَايم ن أَرُّسُل 2‏:3.</char></note> <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />غَارس ثَازَّارْث ذݣ وفُوْس حمَا اَذ يزُوْزَّار ثَافَّا نّس قَاع. أَذ يسْمُوْن ثِحبَّا ن يرْذَان اَثنْت يݣّ ذِي ثْسْرَافْث. مِين وَار ينفّْعن شَا<note caller="+" style="f"><char style="fr" closed="false">3‏.12 </char><char style="ft" closed="false">"مِين وَار ينفّْعن،" يعْنِي ذ اَشَرْفَا نِغ اَڬَرْفَا.</char></note> اَث يسّشْمض ذِي ثْمسِّي إِي وَار يخْسِين عمَّارْص."<verse eid="MAT 3:12" /></para>
  <para style="s">نَّبِي يَحْيَى يتْطهَّار إِ سِيذِيثْنغ عِيْسَى س وَامَان</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />سّنِّي يُوْسَا-د عِيْسَى زِي ثْمُوْرْث ن لْجَلِيل غَار يِغْزَار ن لأُرْدُن بَاش اَث يطهَّار يَحْيَى س وَامَان. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />وَلَكِن يَحْيَى يُوْݣِي ينَّا-ٱس: "نش يتْخصَّا شك إِي ذَايِي غَا يطهَّارن، أُو شك ثُوْسِيذ-د غَارِي؟"<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />ئِنْدق-د عِيْسَى ينَّا-ٱس: "غِير قْبڒ ڒخُّو، ذ مَانَايَا إِݣ يدْجَان نِيشَان حمَا اَذ يكمّڒ مَارَّا مِين يخس سِيذِي أَربِّـي." أُوشَا يقْبڒ يَحْيَى.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />وَامِي يتْوَاطهَّار عِيْسَى يفّغ-د ڒخْدّنِّي زݣ وَامَان نِّي. أَقَا ينُوْرْزم-اَس-د وجنَّا يࢲْرَا أَرُّوْح ن أَربِّـي يهوَّا-د يݣَّا اَم يِجّن ن ثذْبِيرْث ثْمَارْس-د خَاس. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />سّنِّي يڒَاغَا-د يجّن ن صُّوْت زݣ وجنَّا ينَّا-د: "وَا ذ ممِّي يعِيزّن، نش فَرّْحغ زَّايس."<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">إِبْڒِيس يتْجَرَّاب سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />سّنِّي اَرُّوْح نِّي <char style="it">ن أَربِّـي</char> يُوْوِي عِيْسَى غَار ڒخْڒَا حمَا اَث يجَرّب إِبْڒِيس. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />وَامِي يࢲُوْمّ عِيْسَى اَرْبعِين يُوْم جَار دْجِيَاڒِي ذ وُوْسَّان يُوْسَا-ٱس-د جُّوْع. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />ئِكَّر ونِّي يتْجَرَّابن يقَارّب-د غَار عِيْسَى ينَّا-ٱس: "مڒَا شك ذ مِّيس ن أَربِّـي، إِنِي-يَاسن إِ يزْرَا-يَا اَذ ذوْڒن ذ اَغْرُوْم."<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />ئِنْدق-د عِيْسَى ينَّا-ٱس: "لَّا، لْكِتَاب يقَّار: &lt;بْنَاذم وَار يتْعِيش شَا س وغْرُوْم وَاهَا، ئِتْعِيش س مْكُڒ اَوَاڒ إِݣ يقَّار أَربِّـي.&gt;"<note caller="+" style="f"><char style="fr" closed="false">4‏.4 </char><char style="ft" closed="false">خْزَر أَفسَّار ن شَّرِيعَا ن مُوْسَى (التثنية) 8‏:3. س ثَيُوْنَانِيث، يعْنِي بْنَاذم يدَّر س مْكُڒ اَوَاڒ إِي د يتفّْغن زݣ وقمُّوْم ن أَربِّـي.</char></note><verse eid="MAT 4:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />سّنِّي إِبْڒِيس يُوْوِي عِيْسَى غَار ثنْدِينْت ن لْقُدْس، ئِسِيڒِي-ث خ ثْقِيشَّات ن ثمْزِيذَا ثَمقّْرَانْت. <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />ينَّا-ٱس: "شك مڒَا ذ مِّيس ن أَربِّـي نْݣز سَّانِيتَا غَار ثْمُوْرْث. أَقَا لْكِتَاب يقَّار: &lt;قَا أَربِّـي اَذ يوصَّا بَاش اَش حْضَانْت لْمَلَائِكَاث نّس. أَش يْسِينْت خ يفَاسَّن نْسنْت بَاش وَار ثڒْقِيفذ ؤُڒَا ذ يج وزْرُو س وضَار نّش.&gt;"<note caller="+" style="f"><char style="fr" closed="false">4‏.6 </char><char style="ft" closed="false">خْزَر زَّبُوْر 91‏:11‏-12.</char></note><verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />ينَّا-ٱس عِيْسَى: "لَّا، لْكِتَاب يقَّار: &lt;وَار تْجَرَّاب شَا سِيذِي أَربِّـي نّش.&gt;"<note caller="+" style="f"><char style="fr" closed="false">4‏.7 </char><char style="ft" closed="false">خْزَر أَفسَّار ن شَّرِيعَا ن مُوْسَى (التثنية) 6‏:16.</char></note><verse eid="MAT 4:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />سّنِّي إِبْڒِيس يُوْوِي عِيْسَى غَار ثْقِيشَّات ن يِجّن ن وذْرَار يُوْعْڒَا اَطَّاس. ئِسْمظْهَار-اَس-د مَارَّا لْممْلَكَاث ن دُّنشْت-أَ ذ ثُوْصُبْحَانت نْسنْت. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />ينَّا-ٱس: "أَذَاش ؤُشغ مَارَّا ثِيْنَا مڒَا ثوْضِيذ خ يفَادّن نّش ثْسجّْذذ-اَيِي."<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />ئِنْدق-د عِيْسَى ينَّا-ٱس: "رُوْح، بعّذ-اَيِي آ شِّيطَان. أَقَا لْكِتَاب يقَّار: &lt;سجّذ إِ سِيذِي أَربِّـي نّش، عْبذ-يث نتَّا وَاحْذس.&gt;"<note caller="+" style="f"><char style="fr" closed="false">4‏.10 </char><char style="ft" closed="false">خْزَر أَفسَّار ن شَّرِيعَا ن مُوْسَى (التثنية) 6‏:13.</char></note><verse eid="MAT 4:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />سّنِّي يبعّذ خَاس إِبْڒِيس. ؤُسِينْت-يد لْمَلَائِكَاث بْذَانْت تْسخَّارنْت خ عِيْسَى.<verse eid="MAT 4:11" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يتْڒَاغَا-د إِ يمحْضَارن نّس يمزْوُوْرَا</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />وَامِي يسْڒَا عِيْسَى بلِّي يَحْيَى اَقَا يتْوَاحبّس، ئِعْقب <char style="it">غَار نَاصِرَا</char> غَار ثْمُوْرْث ن لْجَلِيل. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />وَلَكِن وَار يقِّيم شَا ذِي نَاصِرَا، ئِرُوْح اَذ يزْذغ ذݣ يِجّن ن وبِيلَاج قَّارن-اَس كَفرْنَاحُوْم إِݣ يدْجَان خ طَّارْف ن ڒبْحَر ن لْجَلِيل، جِّهث ن ثْمُوْرْث ن زَفُلُوْن ذ نَفْتَالِي. <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />أَمنِّي يكمّڒ وَاوَاڒ نِّي إِي ينَّا سِيذِي أَربِّـي إِ نَّبِي ؤُمِي قَّارن إِشَعْيَا ذݣ يِجّن ن زْمَان:<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />&lt;ثَمُوْرْث ن زَفُلُوُن ذ ثْمُوْرْث ن نَفْتَالِي،</para>
  <para style="q2" vid="MAT 4:15">ثِنِّي ؤُمِي قَّارن ثَمُوْرْث ن لْجَلِيل،</para>
  <para style="q1" vid="MAT 4:15">خ وبْرِيذ ن ڒبْحَر ذِي شَّرْق ن يِغْزَار ن لْأُرْدُن،</para>
  <para style="q2" vid="MAT 4:15">مَانِي إِي زدّْغن ؤُڒَا ذ يِنِّي وَار يدْجِين زِي أَيث-إِسْرَائِيل.<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />شَّعْب-أَ إِي يزدّْغن ذِي ثَادْجسْت،</para>
  <para style="q2" vid="MAT 4:16">أَذ يࢲر ثْفَاوْث ذ ثَمقّْرَانْت.</para>
  <para style="q1" vid="MAT 4:16">يِيْنَا يزدّْغن ذِي ثَادْجسْت ن ڒْموْث</para>
  <para style="q2" vid="MAT 4:16">أَذَاسن د يمظْهَار نُّوْر.&gt;<note caller="+" style="f"><char style="fr" closed="false">4‏.16 </char><char style="ft" closed="false">خْزَر إِشَعْيَا 9‏:1‏-2.</char></note><verse eid="MAT 4:16" /></para>
  <para style="b" />
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />زِي سّنِّي يبْذَا عِيْسَى يتْبشَّر يقَّار-اَسن: "تُوْبث، أَقَا يُوْذس-د ڒْمُلْك ن وجنَّا."<verse eid="MAT 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />يݣُّوْر عِيْسَى خ شّطّ ن ڒبْحَر ن لْجَلِيل، يُوْفَا ذِنِّي ثْنَاين ن يحدْجَاقن ن يسڒْمَان نِثْنِي ذ اَوْمَاثن. ئِجّن قَّارن-اَس سِمْعَان تْڒَاغَان-اَس س بُطْرُس، اَكذس ؤُمَاس قَّارن-اَس أَنْدْرُس. نطَّرن ثْرَاشَّا ذِي ڒبْحَر. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />ينَّا-ٱسن عِيْسَى: "ذْفَارم-اَيِي-د، أَقَا ڒخُّو إِي كنِّيو غَا اَرّغ ذ يحدْجَاقن ن يِوْذَان." <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />ڒخْدّنِّي سمْحن ذِي ثْرَاشِّيوِين نْسن ذْفَارن-ث.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />ئِعْذُو اَغِيڒِين، يُوْفَا ثْنَاين ن وَاوْمَاثن نّغْنِي، ئِجّن قَّارن-اَس يَعْقُوْب ئِجّن قَّارن-اَس يُوْحَنَّا. نِثْنِي ذ ثَارْوَا ن يِجّن ن ورْيَاز ؤُمِي قَّارن زَبَادِي. أَقَاثن ذِي ثْغَرَّابُوْت اَك بَابَاثْسن عدّْڒن ثِڒَاشِّيوِين نْسن. ئِڒَاغَا-يَاسن-د عِيْسَى، <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />ذݣ ومْشَان سمْحن ذِي ثْغَرَّابُوْت نْسن ذ بَابَاثْسن ذْفَارن عِيْسَى.<verse eid="MAT 4:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />ئِݣُّوْر عِيْسَى ذِي لْإِقْلِيم ن لْجَلِيل مَارَّا، ئِسڒْمَاذ ذِي ثمْزِيذَاوِين ن أَيث-إِسْرَائِيل يتْبشَّر-يثن س لْإِنْجِيل ن ڒْمُلْك ن أَربِّـي يسْݣنْفَا مَارَّا ڒهْڒَاشَاث ذ دِّعَان ن دَّات ذݣ يِوْذَان. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />ئِفّغ ڒخْبَار نّس ذِي سُوْرْيَا اَمن-ثكْمَاڒ. تَّاوْين-د غَارس مَارَّا يِنِّي يهڒْشن تْعدَّابن س لْأَنْوَاع ن ڒهْڒَاشَاث ذ ڒحْڒِيقَاث، مْكُڒ يمَرْيَاحن ذ يمجْنُوْنن ذ ينشْرُوْفن نتَّا يسْݣنْفَا-ثن. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />ذْفَارن عِيْسَى اَطَّاس ن ڒْغَاشِي زِي لْجَلِيل ذ لْإِقْلِيم ؤُمِي قَّارن دِيكَاپْـلِس ذ ثنْدِينْت ن لْقُدْس ذ يَهُوْذِيَا ذ جِّهث ن شَّرْق ن يِغْزَار ن لْأُرْدُن.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">سِيذِيثْنغ عِيْسَى ذ وسڒْمذ نّس ذݣ وذْرَار</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />وَامِي يࢲْرَا قَاع ڒْغَاشِي نِّي، يُوْڒِي غَار وذْرَار يقِّيم ؤُسِين-د غَارس يمحْضَارن نّس. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />ئِبْذَا يسڒْمَاذ-يثن ينَّا-ٱسن:<verse eid="MAT 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 5:3" />"سَّعْذ نْسن إِ يِنِّي يدْجَان ذ ڒْمُسَاكِين ذݣ اَرُّوْح نْسن، أَقَا ڒْمُلْك وجنَّا إِ نِثْنِي.<verse eid="MAT 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 5:4" />سَّعْذ نْسن إِ يِنِّي يتْرُوْن، أَقَا اَذ تْوَاشجّْعن.<verse eid="MAT 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 5:5" />سَّعْذ نْسن إِ يِنِّي يدْجَان ذ دْرَاوش، أَقَا اَذ وَرْثن دُّنشْت.<verse eid="MAT 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 5:6" />سَّعْذ نْسن إِ يِنِّي يدْجُوْزن يفُّوْذن غَار مِين يدْجَان نِيشَان، ڒَاحقَّاش نِثْنِي اَذ جَّاوْنن.<verse eid="MAT 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 5:7" />سَّعْذ نْسن إِ يِنِّي يرحّْمن، أَقَا اَثن يرْحم <char style="it">أَربِّـي</char> ؤُڒَا ذ نِثْنِي.<verse eid="MAT 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 5:8" />سَّعْذ نْسن إِ يِنِّي غَار يدْجَا وُوْڒ ذ اَشمْڒَاڒ، أَقَا اَذ ࢲرن أَربِّـي.<verse eid="MAT 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 5:9" />سَّعْذ نْسن إِ يِنِّي يصدْجْحن يوْذَان، أَقَا نِثْنِي اَثن سمَّان اَمشْنَاو ثَارْوَا ن أَربِّـي.<verse eid="MAT 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 5:10" />سَّعْذ نْسن إِ يِنِّي يتْوَاعدَّابن خ سَّبَاب ن مِين يدْجَان نِيشَان، أَقَا ڒْمُلْك ن وجنَّا إِ نِثْنِي.<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />سَّعْذ نْوم مڒَا تْزَوَارن-كنِّيو، عدّْبن-كنِّيو، نِغ نَّان ذَايْوم ڒْعِيب س يخَارِّيقن خ سَّبَاب ينُو. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />ضحْشث، فَرْحث. أَقَا غَارْوم يجّن ن لْأَجَار ذ اَمقّْرَان ذݣ وجنَّا ڒَاحقَّاش اَمنِّي إِي تْوَاعدّْبن لْأَنْبِيَا تُوْغَا يدْجَان قْبڒ نْوم.<verse eid="MAT 5:12" /></para>
  <para style="s">ڒمْڒح ذ ثْفَاوْث</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />ذ كنِّيو إِي يدْجَان ذ ڒمْڒح ثَصبْحَانْت ن ثْمُوْرْث. وَلَكِن مڒَا يرُوْح-اَس لْمَذَاق نّس، مَامش ذَاس غَا نݣّ اَذَاس ثِيذ نَارّ؟ أَتَاف وَار ثْصدْجَاح إِ وَالُو، غِير اَت نْضَرن غَار بَارَّا وَاهَا اَخَاس عفّْسن يِوْذَان. <verse eid="MAT 5:13" /><verse number="14" style="v" sid="MAT 5:14" />كنِّيو ذ ثْفَاوث ن دُّنشْت. ئِجّن ن ثنْدِينْت إِي يدْجَان خ وذْرَار وَار ثْزمَّر اَذ تقِّيم ثْنُوْفَّر. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />ئِوْذَان وَار سْرقِّين شَا ڒْقنْدِيڒ حمَا اَخَاس قڒْبن اَقْنُوْش؛ لَّا، تݣّن-ث خ ڒْمَرْفَع حمَا اَذَاسن يُوْش ثْفَاوث إِ مَارَّا ؤُݣ يدْجَان ذِي ثدَّارْث. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />أَمُّو، جّث ڒْقنْدِيڒ نْوم يشعّڒ إِ يِوْذَان حمَا اَذ ࢲرن ڒخْذَايم نْوم ثِصبْحَانِين اَذ حمْذن بَابَاثْوم يدْجَان ذݣ وجنَّا.<verse eid="MAT 5:16" /></para>
  <para style="s">شَّرِيعَا</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />وَار تْفكَّرث شَا بلِّي ؤُسِيغ-د بَاش اَذ قْضِيغ خ شَّرِيعَا ن مُوْسَى نِغ خ مِين نَّان لأَنْبِيَا؛ لَّا، وَار د ؤُسِيغ شَا اَخَاسن قْضِيغ، ؤُسِيغ-د بَاش اَذ كمّْڒغ خ وَاوَاڒ نْسن. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />أَقَا تسْڒَام ڒْحَقّ: وَار يتكّس يجّن ن ڒْحَرْف نِغ ذ يجّن ن ثْنقِّيط زِي شَّرِيعَا اَڒ غَا يتْوَاكّس وجنَّا ذ ثْمُوْرْث أَڒ غَا يتْوَاكمّڒ كُڒْشِي. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />مَارَّا ؤُو غَا يحَرْفن يجّن ن ڒُوْصِيّث ذ ثَمزْيَانْت زِي شَّرِيعَا، سّنِّي اَذ يسڒْمذ إِ يِوْذَان خ مِين يتݣّ نتَّا، أَتَاف اَذ يِيڒِي ذ اَمزْيَان س وَاطَّاس ذِي ڒْمُلْك وجنَّا. وَلَكِن ونِّي غَا يطَاعن إِ شَّرِيعَا يݣَّا زَّايس، سّنِّي اَذ يسڒْمذ إِ يِوْذَان اَذ ݣّن اَم نتَّا، أَتَاف اَذ يِيڒِي ذ اَمقّْرَان س وَاطَّاس ذِي ڒْمُلْك وجنَّا. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />أَقَا قَّارغ-اَوم: مڒَا وَار ثتْطِيْعِيم شَا إِ مِين يقَّار أَربِّـي كْتَار زِي مِين تݣّن يمْسڒْمَاذن ن شَّرِيعَا ذ ڒْحِزب ن يفَرِّيسِيْين، أَتَاف عمَّارْص اَذ تَاذْفم ڒْمُلْك وجنَّا.<verse eid="MAT 5:20" /></para>
  <para style="s">أَعصّب</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />أَقَا ثسْڒِيم ذِي لْكِتَاب بلِّي يتْوَانَّا-يَاسن إِ ڒجْذُوْذ نْوم: وَار نقّ شَا، أَقَا مَارَّا ونِّي إِي غَا ينْغن حَدّ اَتَاف اَذ يتْوَاحْكم.<note caller="+" style="f"><char style="fr" closed="false">5‏.21 </char><char style="ft" closed="false">خْزَر ؤُفُوْغ (الخروج) 20‏:13.</char></note> <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />وَلَكِن نش قَّارغ-اَوم: مَارَّا ؤُو غَا يعَصْبن خ وُوْمَاس اَتَاف اَذ يتْوَاحْكم. ونِّي غَا يِينِين إِ وُوْمَاس: آي اَغْيُوْڒ، أَتَاف اَذ يتْوَاحْكم ذِي لْمَحْكَامَا ثَمقّْرَانْت. ذ ونِّي غَا يِينِين إِ وُوْمَاس: آي اَفْغُوْڒ، أَتَاف يسْذَاهدْج اَذ يرَاح غَار ثْمسِّي ن جَهنَّمَا.<verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />مڒَا ثْرُوْحذ اَذ تْقدّْمذ دْبِيحث إِ أَربِّـي أُوشَا ثْفكَّرذ يجّن ن وُوْمَاش يخيّق خَاش، <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />اجّ دْبِيحث نِّي ذِنِّي غَار ڒْمذْبَح، رُوْح ذ اَمزْوَارُو اَذ تْصڒْحذ اَك وُوْمَاش. عَاذ إِي د غَا ثْذوْڒذ اَذ تْقدّْمذ دْبِيحث نّش إِ أَربِّـي.<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />مڒَا يتْهم-يشك شَا حَدّ منْبَعْد ؤُوِين-اَش-د لْإِسْتِدْعَا حمَا اَكِذس ثْرَاحذ غَار لْمَحْكَامَا، عْذڒ اَكِذس ذغْيَا ذݣ وبْرِيذ بَاش وَار ش يسِيوِّيض شَا غَار ڒْقَاضِي، ڒْقَاضِي نِّي اَذ ئِأَمَر اَمْخَازْنِي، أَمْخَازْنِي نِّي اَش ينْضَر ذِي ڒحْبس. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />أَقَا تسْڒِيذ ڒْحَقّ: وَار سّنِّي د تفّْغذ شَا اَڒ غَا ثْخدْجْسذ صُولْدِي اَنݣَّارُو.<verse eid="MAT 5:26" /></para>
  <para style="s">أَزْنَا</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />ثسْڒِيم ذِي لْكِتَاب بلِّي يتْوَانَّا ذݣ يِجّن ن زْمَان: وَار زنَّا شَا.<note caller="+" style="f"><char style="fr" closed="false">5‏.27 </char><char style="ft" closed="false">خْزَر ؤُفُوْغ (الخروج) 20‏:14.</char></note> <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />وَلَكِن نش قَّارغ-اَوم: مَارَّا ونِّي يخزَّرن غَار شَان ثمْغَارْث س وُوْڒ نّس، أَتَاف يتْوَاحْسَاب يزْنَا. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />مڒَا ثِيطّ نّش ثَفُوْسِيث تْسبَّاب-اَش ذِي شَان ڒفْضِيحث، قْڒع-يت زَعْمَا نْضَر-يت خَاك. حْسن إِ شك اَذ تخْسَرذ يجّن ن طَّارْف زِي دَّات نّش زِي مڒَا ثْمنْضَار دَّات نّش اَمن-ثكْمَاڒ ذِي جَهنَّمَا. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />مڒَا فُوْس نّش اَفُوْسِي يتْسبَّاب-اَش ذِي شَان ڒفْضِيحث، قسّ-يث زَعْمَا نْضَر-يث خَاك. حْسن إِ شك اَذ تخْسَرذ يجّن ن طَّارْف زِي دَّات نّش زِي مڒَا ثْرُوْح دَّات نّش اَمن-ثكْمَاڒ ذِي جَهنَّمَا.<verse eid="MAT 5:30" /></para>
  <para style="s">أَدْجَاف</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />أَقَا يتْوَانَّا ذݣ يِجّن ن زْمَان <char style="it">ذِي لْكِتَاب</char> عَاوذ: ونِّي غَا يدْجْفن إِ ثمْغَارْث نّس، أَتَاف اَذَاس يُوْش ثَبْرَات نّس.<note caller="+" style="f"><char style="fr" closed="false">5‏.31 </char><char style="ft" closed="false">خْزَر أَفسَّار ن شَّرِيعَا ن مُوْسَى (التثنية) 24‏:1.</char></note> <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />وَلَكِن نش قَّارغ-اَوم: مَارَّا ونِّي غَا يدْجْفن إِ ثمْغَارْث نّس، نتَّاث وَار ثزْنِي شَا، أَتَاف يتَارَّا-ت ثزْنَا <char style="it">يعْنِي مڒَا ثْعَاوذ ڒمْڒَاش</char>. ونِّي إِي غَا يمڒْشن اَك ثنِّي يدْجْفن، أَتَاف يزْنَا.<verse eid="MAT 5:32" /></para>
  <para style="s">ثِجَادْجِيث</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />أَقَا ثسْڒِيم ذِي لْكِتَاب عَاوذ بلِّي يتْوَانَّا إِ ڒجْذُوْذ نْوم: قَا وَار تْخَالَاف بُو ثْجَادْجِيث نّش، كمّڒ ثْجَادْجِيث نّش إِي ثجُّوْدْجذ زَّاث إِ سِيذِي أَربِّـي.<note caller="+" style="f"><char style="fr" closed="false">5‏.33 </char><char style="ft" closed="false">خْزَر لْعَدَد 30‏:2.</char></note> <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />وَلَكِن نش قَّارغ-اَوم: وَار تْجَادْجَام شَا عمَّارْص: وَاخَّا س وجنَّا ڒَاحقَّاش نتَّا ذ لْعَارْش ن أَربِّـي؛ <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />ؤُڒَا س ثْمُوْرْث ڒَاحقَّاش خَاس يتْمَارْسن يضَارن نّس؛ وَاخَّا س ثنْدِينْت ن لْقُدْس ڒَاحقَّاش نتَّاث ذ ثَنْدِينْت ن وزدْجِيذ اَمقّْرَان. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />وَار تْجَادْجَا بُو س وزدْجِيف نّش، ڒَاحقَّاش وَار ثْزمَّرذ شَا اَذ تَارَّاذ شَان ن وزُوْطُّو ذ اَشمْڒَاڒ نِغ ذ اَبرْشَان. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />أَذ يِيڒِي وَاوَاڒ نْوم: وَاه نِغ لَّا. مَارَّا مِين غَا ثِينِيم ذ زّْيَادَا، أَتَاف اَࢲْور نّس زِي شِّيطَان.<verse eid="MAT 5:37" /></para>
  <para style="s">خْسث ڒْعَذْيَان نْوم</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />أَقَا ثسْڒِيم ذِي لْكِتَاب مِين يتْوَانَّان ذݣ يِجّن ن زْمَان: ونِّي غَا يكّْسن ثِيطّ إِ شَان يِجّن، أَتَاف اَذَاس كّْسن ثِيطّ. ونِّي غَا يكّْسن ثِغْمسْت إِ شَان يِجّن، أَتَاف اَذَاس كّْسن ثِغْمسْت.<note caller="+" style="f"><char style="fr" closed="false">5‏.38 </char><char style="ft" closed="false">خْزَر ؤُفُوْغ (الخروج) 21‏:24، لْكِتَاب ن أَيث-لَاوِي 24‏:20، ذ أَفسَّار ن شَّرِيعَا ن مُوْسَى (التثنية) 19‏:21.</char></note> <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />وَلَكِن نش قَّارغ-اَوم: وَار تْعَارَّاضم شَا إِ ونِّي يدْجَان ذ اَعفَّان. ونِّي ش غَا يسقّْڒن غَار وغمْبُوْب جِّهث ثَفُوْسِيث ذوَّاڒ-اَس جِّهث نّغْنِي. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />ونِّي يخْسن اَش يَاوِي غَار شْرَاع حمَا اَذَاش يَاوِي ثَقْمِيجَات، ؤُش-اَس ؤُڒَا ذ اَزدْجَاب نّش. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />مڒَا شَان يِجّن زِي ڒْمخْزن يݣَّا خَاك بزّز اَذ تيْسِيذ ڒحْمڒ يجّن ن كِيلُوْمِت، يْسِي-ث شك ثْنَاين كِيلُوْمِت. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />ونِّي ذَاش غَا يتَّارن <char style="it">شَان ثْمسْڒَايْث</char>، ؤُش-اَس-ت. ونِّي د غَا يَاسن غَارك يرزُّو اَذ يرْضڒ وَار ث تَارَّا شَا يخْوَا.<verse eid="MAT 5:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />أَقَا ثسْڒِيم ذِي لْكِتَاب مِين يتْوَانَّان ذݣ يِجّن ن زْمَان: أَذ تخْسذ اَجَّار نّش، أَذ تْعِيفّذ ڒَعْذُو نّش.<note caller="+" style="f"><char style="fr" closed="false">5‏.43 </char><char style="ft" closed="false">خْزَر لْكِتَاب ن أَيث-لَاوِي 19‏:18.</char></note> <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />وَلَكِن قَّارغ-اَوم نش: خْسث ڒْعَذْيَان نْوم، تَّارث إِ أَربِّـي خ يِنِّي كنِّيو يتْعدَّابن، <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />حمَا اَذ تِيڒِيم ذ ثَارْوَا ن بَابَاثْوم إِي يدْجَان ذݣ وجنَّا. ڒَاحقَّاش يتْسُوْمُّوْر-د ثْفُوْشْت خ يِنِّي يصبْحَانن ذ يِنِّي يعفَّانن. ئِتِيشّ اَنْࢲَار إِ يِنِّي يتݣّن ڒْخِير ذ يِنِّي يتݣّن شَّرّْ. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />مڒَا كنِّيو تخْسم غِير يِنِّي إِي كنِّيو يتخْسن، مَان لْأَجَار إِي غَارْوم كنِّيو؟ مَا وَار يدْجِي اَمنِّي إِي تݣّن ؤُڒَا ذ يعشَّارن؟<note caller="+" style="f"><char style="fr" closed="false">5‏.46 </char><char style="ft" closed="false">ئِعشَّارن نِثْنِي ذ يسْرَائِيلِيْين خدّْمن اَك لْمخْزن ن اَرُّوْمَانُوْس جمّْعن ڒَعْشُور. ئِسْرَائِيلِيْين نّغْنِي قَّارن يعشَّارن عْلَاحْسَاب مِين تݣّن عصَّان اَطَّاس. عَاوذ اَزْين اَمقّْرَان ن يعشَّارن اَرنِّين شِي حَاجَا حمَا اَثنْت يْسِين إِ يِيخف نْسن.</char></note> <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />مڒَا تْسدْجَامم غِير خ يمدُّوْكَاڒ نْوم، إِيوَا مِين تݣّم ذ زّْيَادَا؟ أَقَا ؤُڒَا ذ ڒْكُفَّار تݣّن مَانَايَا! <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />إِڒِيث نِيشَان قَاع، أَمشْنَاو مَامش يدْجَا بَابَاثْوم ذݣ وجنَّا.<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">صَّذَقَا</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />غَارْوم اَذ تݣّم ڒْخِير زَّاث إِ يِوْذَان حمَا اَكنِّيو ࢲرن، أَتَاف وَار غَارْوم يتِيڒِي بُو لْأَجَار زِي بَابَاثْوم يدْجَان ذݣ وجنَّا. <verse eid="MAT 6:1" /><verse number="2" style="v" sid="MAT 6:2" />عْلَاحْسَاب مَانَايَا، خْمِي غَا ثْصدّْقذ إِ شَان ن يِجّن، وَار زَّايس تْبرَّاح شَا ذِي ڒْبُوْق اَمشْنَاو مَامّش تݣّن لْمُنَافِقِين ذِي ثمْزِيذَاوِين ذ زْنَاقِي بَاش اَزَّايسن سمْغَارن يِوْذَان. أَقَا تسْڒَام ڒْحَقّ: وَار غَارْسن يتِيڒِي بُو لْأَجَار. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />وَلَكِن شك خْمِي غَا ثْصدّْقذ إِ شَان ن يِجّن، ئِتْخصَّا فُوْس نّش اَࢲڒْمَاض وَار يتسّن مِين يتِيشّ فُوْس اَفُوْسِي نّش. <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />حمَا صَّذَقَا نّش اَذ تْوَاݣّ س ثْنُوْفْرَا. ذ بَابَاش <char style="it">أَربِّـي</char> إِݣ يࢲرّن مِين يتْوَاݣّن س ثْنُوْفْرَا اَتَاف اَذَاش يُوْش لْأَجَار.<verse eid="MAT 6:4" /></para>
  <para style="s">ثْࢲَادْجِيث</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />خْمِي غَا ثࢲَّادْجم، وَار تِيڒِيم شَا اَم لْمُنَافِقِين إِي تخْسن اَذ ࢲَّادْجن اَمن بدّن ذِي ثمْزِيذَاوِين ذ ثْغمُّوْرَا ن زْنَاقِي حمَا اَثن ࢲرن يِوْذَان. أَقَا تسْڒَام ڒْحَقّ: وَار غَارْسن يتِيڒِي بُو لْأَجَار. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />وَلَكِن شك خْمِي غَا ثࢲَّادْجذ، أَذف غَار وخَّام نّش قّن خَاك ثَوَّارْث، ࢲَّادْج إِ بَابَاش يدْجَان مَانِي وَار ث يتْوِيڒِي حَدّ. بَابَاش إِݣ يࢲرّن مِين يتْوَاݣّن س ثْنُوْفْرَا اَتَاف اَش يجَازَا.<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />وَار تْࢲَادْجَام شَا س وَاوَاڒن وَار غَارْسن بُو ڒْمَعْنَا اَمشْنَاو مَامّش تݣّن ڒݣْنُوْس. حسّْبن مڒَا قَّارن اَوَاڒن اَطَّاس، أَتَاف أَربِّـي اَذَاسن يسْتَاجب. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />لَّا، وَار تݣّم شَا اَم نِثْنِي ڒَاحقَّاش أَربِّـي يسّن مِين ثحْذَاجم قْبڒ مَا ذَاس ت ثتَّارم. <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />هَا مَامّش إِي غَا ثࢲَّادْجم:</para>
  <para style="q1" vid="MAT 6:9">آ بَابَاثْنغ يدْجَان ذݣ وجنَّا،</para>
  <para style="q2" vid="MAT 6:9">ذ اَمقّْرَان إِݣ يدْجَا يِسم نّش.<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />أَذ د يَاس ڒْمُلْك نّش،</para>
  <para style="q2" vid="MAT 6:10">أَذ ݣّن ڒْخَاضَر نّش ذِي ثْمُوْرْث،</para>
  <para style="q1" vid="MAT 6:10">مَامش تݣّن ذݣ وجنَّا.<verse eid="MAT 6:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="MAT 6:11" />ؤُش-اَنغ كُڒ نْهَار اَغْرُوْم إِي غَا نحْذَاج.<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />غْفَر-اَنغ ڒْمُعْصِيَاث نّغ إِ نشِّين،</para>
  <para style="q2" vid="MAT 6:12">مَامّش نْسمّح إِ يِنِّي إِي كِذْنغ يخطَّان.<verse eid="MAT 6:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="MAT 6:13" />وَار ذَانغ تݣّ شَا ذِي ڒمْحَاين،</para>
  <para style="q1" vid="MAT 6:13">سنْجم-اَنغ زِي شَّرّْ.</para>
  <para style="q2" vid="MAT 6:13">{ڒَاحقَّاش ڒْمُلْك يدْجَان نّش، ذ ثِزمَّار،</para>
  <para style="q1" vid="MAT 6:13">ذ لْعَظَمَا إِ شك إِ ڒبْدَا. آمِين.}<verse eid="MAT 6:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />مڒَا ثْسمّْحم إِ يِوْذَان ذݣ ؤُخطِّي نِّي إِي كِذْوم يخطَّان، أَتَاف بَابَاثْوم يدْجَان ذݣ وجنَّا ؤُڒَا ذ نتَّا اَذَاوم يغْفَر. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />مڒَا وَار ثْسمّْحم شَا إِ يِوْذَان ذݣ ؤُخطِّي نِّي إِي كِذْوم يخطَّان، أَتَاف بَابَاثْوم ؤُڒَا ذ نتَّا وَار ذَاوم يغفَّر شَا خ دّْنُوْب نْوم.<verse eid="MAT 6:15" /></para>
  <para style="s">أَࢲُوْمِّي</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />خْمِي غَا ثْࢲُوْمّم، وَار تݣّم شَا اَمشْنَاو مَامّش تݣّن لْمُنَافِقِين. تْخيَّاقن حمَا مَارَّا يوْذَان اَثن سّْنن بلِّي ࢲُوْمّن. أَقَا تسْڒَام ڒْحَقّ: أَتَاف وَار غَارْسن يتِيڒِي بُو لْأَجَار. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />وَلَكِن شك خْمِي غَا ثْࢲُوْمّذ، سِيْرذ اَغمْبُوْب نّش مْشض اَشوَّاف نّش، <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />حمَا يوْذَان وَار تسّْنن شَا قَا شك ثْࢲُوْمّذ. وَلَكِن سِيذِي أَربِّـي يدْجَان مَانِي وَار ث يتْوِيڒِي حَدّ، نتَّا إِݣ يسّْنن. أُو سِيذِي أَربِّـي إِݣ يࢲرّن مِين يتْوَاݣّن س ثْنُوْفْرَا اَتَاف اَش يجَازَا.<verse eid="MAT 6:18" /></para>
  <para style="s">وَار كسِّيم شَا اَمْنُوْس</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />وَار سْنُوْفُّوْرث شَا ڒْكنْز نْوم ذِي دُّنشْت-أَ مَانِي يَرشَّا تتّنْت-ث ثْكشَّاوِين ذ مَانِي دْجَان يشفَّارن شَّاثن نْقَابث<note caller="+" style="f"><char style="fr" closed="false">6‏.19 </char><char style="ft" closed="false">شَّاثن نْقَابث، يعْنِي سْنُوْقُّوْبن ڒْحِيض حمَا اَذ اَذْفن اَڒ ذَاخڒ إِ ثدَّارْث.</char></note> تَاشَارن-ث. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />وَلَكِن سْنُوْفَّرث ڒْكنْز نْوم ذݣ وجنَّا مَانِي وَار يَرشِّي شَا وَار ث تتّنْت شَا ثْكشَّاوِين ذ مَانِي وَار دْجِين شَا يشفَّارن شَّاثن نْقَابث تَاشَارن-ث. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />أَقَا مَانِي يدْجَا ڒْكنْز نّش، ذِنِّي إِي غَا يِيڒِي وُوْڒ نّش.<verse eid="MAT 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />ثِيطَّاوِين اَم ثْفَاوْث إِ ثُوْذَارْث نّش. مڒَا غَارك ثِيطَّاوِين صحَّانْت، أَتَاف اَغَارك ثِيڒِي ثْفَاوْث مَارَّا ذِي ثُوْذَارْث نّش. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />وَلَكِن مڒَا ثِيطَّاوِين نّش وَار دْجِينْت شَا مْلِيح، أَتَاف مَارَّا ثُوْذَارْث نّش اَذَايس ثِيڒِي ثَادْجسْت. مڒَا ثْفَاوْث إِي ذَايش ثذْوڒ ذ ثَادْجسْت، شْحَاڒ ذ ثُوْبَّارشنْت إِي تِيڒِي ذ ثَادْجسْت نِّي إِي ذَايش.<verse eid="MAT 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />وَار يزمَّر شَان يِجّن اَذ يِيڒِي ذ اَخدَّام غَار ثْنَاين ن سِيَاذِيس. مَايمِّي؟ إِمَا يجّن اَث يعِيفّ، ئِجّن اَث يخس. نِغ يجّن اَذَايس يطّف، ئِجّن اَث يحݣَّر. أَذ تْخذْمم إِ أَربِّـي نِغ اَذ تْخذْمم إِ ڒوْسخ ن دُّنشْت-أَ، وَار يدْجِي بُو س ثْنَاين.<verse eid="MAT 6:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />خ مَانَايَا اَذَاوم ينِيغ: وَار كسِّيم شَا س ومْنُوْس إِ ثُوْذَارْث نْوم عْلَاحْسَاب مِين غَا ثشّم نِغ ذ مِين غَا ثسْوم نِغ ذ اَرُّوْض إِي غَا ثحْذَاجم إِ دَّات نْوم. مِينْزِي ثُوْذَارْث-أَ تْسݣّْوَا كْتَار زِي مَشَّا. دَّات-أَ تْسݣّْوَا كْتَار زݣ وَارُّوْض. <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />خْزَرث مْلِيح غَار يِجْضَاض وجنَّا. وَار زرّْعن، وَار مجَّارن، وَار خزّْنن ذِي ثسْڒَافِين. وَلَكِن بَابَاثْوم إِي يدْجَان ذݣ وجنَّا إِي ذَاسن يتِّيشّن اَذ شّن. كنِّيو، مَا وَار تْسݣّْوِيم شَا اَطَّاس س وَاطَّاس خ يِجْضَاض؟ <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />أُوْݣ يزمَّرن زَّايْوم اَذ يَرْنِي س ومْنُوْس نّس غِير ثْسَعَّات وَاهَا ذِي ڒْعُمُوْر نّس؟<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />مَايمِّي ثْكسِّيم اَمْنُوْس إِ وَارُّوْض؟ خْزَرث ذِي نْوَار ن ڒخْڒَا مَامّش يݣَّا، وَار يَربّڒ وَار يتْخيِّيض. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />قَّارغ-اَوم نش: ؤُڒَا ذ اَزدْجِيذ سُلِيمَان مشْحَاڒ غَارس ذ اَݣْڒَا وَار يزمَّر شَا اَذ يَرض شَا ن وَارُّوْض يݣَّا اَم نْوَار-أَ وَانِيتَا. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />مڒَا أَربِّـي يتِيشّ اَرُّوْض زَعْمَا إِ اَرْبِيع ن ڒخْڒَا إِݣ يدْجَان نْهَارَا اَذ يحَرق ثِيوشَّا ذݣ وفَرَّان، مَا وَار يتݣّ اَكِذْوم كنِّيو كْتَار؟ ذَايْوم لْإِيمَان نْوم ذ ؤُقْلِيل. <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />وَار كسِّيث بُو س ومْنُوْس اَذ تِينِيم، مِين غَا نشّ؟ نِغ ذ مِين غَا نْسو؟ نِغ ذ مِين غَا نَرض ذ اَرُّوْض؟ <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />مَارَّا مَانَايَا رزُّوْن-ث ڒݣْنُوْس. أَقَا بَابَاثْوم يدْجَان ذݣ وجنَّا يسّن بلِّي تحْذَاجِيم ثِمسْڒَايِين-أَ. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />رزُّوْث ذ اَمزْوَارُو خ ڒْمُلْك ن أَربِّـي ذ ثُوْذَارْث إِݣ يدْجَان نِيشَان، سّنِّي ثِمسْڒَايِين-أَ مَارَّا اَذَاوم مَارْنِينْت. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />وَار كسِّيث بُو س ومْنُوْس إِ مِين غَا يوقْعن ثِيوشَّا، أَقَا ثِيوشَّا اَذ ييْسِي نِّيث س ومْنُوْس إِ يِيخف نّس. ڒْهمّْ إِي د يمظهَّارن نْهَار نِّي اَذ يكْفَا نْهَار نِّي.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">وَار تْعيَّابث بُو يِوْذَان</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />وَار تْعيَّابم حَدّ حمَا وَار كنِّيو يتْعيِّيب شَا أَربِّـي. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />مَامّش غَا ثْعيّْبم اَمنِّي إِ كنِّيو إِي غَا يعيّب أَربِّـي. ڒَعْبَر نِّي إِي ثْسخْذَامم ذ ونِّي إِي كِذْوم غَا يسخْذم أَربِّـي. <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />مَايمِّي تْسحْقَرذ شْوَايْت ن ؤُڒُوْم إِݣ يدْجَان ذِي ثِيطّ ن وُوْمَاش، شك تتُّوْذ اَكشُّوْض إِݣ يدْجَان ذِي ثِيطّ نّش؟ <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />مَامّش تݣّذ ثْزعّْمذ اَذ تِينِيذ إِ وُوْمَاش: اجَّا-ٱيِي اَذَاش د كّْسغ ڒُوْم-أَ إِݣ يدْجَان ذِي ثِيطّ نّش، شك <char style="it">عَاذ</char> تجِّيذ اَكشُّوْض ذِي ثِيطّ نّش؟ <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />آ لْمُنَافِق، كّس ذ اَمزْوَارُو اَكشُّوْض زِي ثِيطّ نّش. عَاذ إِي غَا ثتْوَاڒِيذ مْلِيح حمَا اَذ تكّْسذ ڒُوْم زِي ثِيطّ ن وُوْمَاش. <verse eid="MAT 7:5" /><verse number="6" style="v" sid="MAT 7:6" />وَار تِيشّث شَا مِين يقدّْسن ن أَربِّـي إِ يقْزِينن حمَا وَار غَارْوم د تعْقِيبن اَكنِّيو مزّْقن. وَار نطّرث شَا جُّوْهَر نْوم زَّاث إِ يڒْفَان حمَا وَار خَاسن عفّْسن شَا.<verse eid="MAT 7:6" /></para>
  <para style="s">ثْࢲَادْجِيث إِي غَا يسْتَاجْبن</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />تَّارم، أَتَاف اَذَاوم يمُّوْش. رزُّوْم، أَتَاف اَذ تَافم. سْقرْقُوْبم، أَتَاف اَذَاوم رزْمن. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />مِينْزِي مَارَّا ونِّي غَا يتَّارن اَذَاس يمُّوْش. ونِّي غَا يرْزُوْن اَذ يَاف. ونِّي غَا يسْقرقْبن اَذَاس ثْنُوْرْزم ثوَّارْث. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />مڒَا شَان يِجّن زَّايْوم يتَّار-اَس مِّيس اَغْرُوْم، مَا اَذَاس يُوْش اَزْرُو ذݣ ومْشَان ن وغْرُوْم نِّي؟ لَّا! <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />مڒَا يتَّار-اَس اَسْڒم، مَا اَذَاس يُوْش فِيغر؟ لَّا! <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />مڒَا كنِّيو ذ يعفَّانن ثسّْنم اَذ تُوْشم إِ ثَارْوَا نْوم مِين يدْجَان ذ اَصبْحَان، أَتَاف بَابَاثْوم إِݣ يدْجَان ذݣ وجنَّا يتݣّ كْتَار. ئِتِيشّ مِين يدْجَان ذ اَصبْحَان إِ يِنِّي ذَاس ث يتتَّارن.<verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />ݣّث إِ يِوْذَان مِين ثخْسم اَذَاوم ݣّن. مَانَايَا ذ ڒْمَعْنَا ن شَّرِيعَا ن مُوْسَى ذ تَّعَالِيم ن لْأَنْبِيَا.<verse eid="MAT 7:12" /></para>
  <para style="s">ثَوَّارْث ن ثُوْذَارْث</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />أَذْفث زِي ثوَّارْث يحْصَرن مِينْزِي ثَوَّارْث نِّي يتَاوِين غَار جَهنَّمَا ثِيرِيو اَطَّاس، أَبْرِيذ نّس يسْهڒ. أَطَّاس إِي زَّايس يعدُّوْن. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />وَلَكِن ثَوَّارْث يحْصَرن ذ وبْرِيذ يقسْحن نِثْنِي تَاوْين غَار ثُوْذَارْث. ذْرُوْس إِي غَا يعْذُوْن سّنِّي.<verse eid="MAT 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />حْضَام يخف نْوم زݣ يِنِّي يتَارَّان يخف نْسن ذ لْأَنْبِيَا. تَاسن-د غَارْوم اَم شَان ن يحُوْڒِيْين وَلَكِن ذݣ وُوْڒَاون نْسن ذ وشَّانن يوْعَرن. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />أَثن ثسّْنم س ڒفْعَايڒ نْسن. مَا زمَّرن يِوْذَان اَذ ڒقْذن ثَازَارْث زݣ يسنَّانن، نِغ اَذ كّْسن اَضِيڒ زِي ثْزݣّْوَارْث؟ <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />ثَشجَّارْث ثَصبْحَانْت تَارو مِين يدْجَان ذ اَصبْحَان. ثَشجَّارْث ثَعفَّانْت تَارو مِين يدْجَان ذ اَعفَّان. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />ثَشجَّارْث ثَصبْحَانْت وَار تِيْرو شَا مِين يدْجَان ذ اَعفَّان. ثنِّي ثَعفَّانْت وَار تِيْرو شَا مِين يدْجَان ذ اَصبْحَان. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />مَارَّا ثَشجَّارْث إِي وَار يتِيْرْون شَا مِين يدْجَان ذ اَصبْحَان اَذ تْوَاقسّ اَذ تْمنْضَار ذِي ثْمسِّي. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />أَمُّو س ڒفْعَايڒ نْسن إِي غَا ثسّْنم <char style="it">يِنِّي يتَارَّان يخف نْسن ذ لْأَنْبِيَا</char>.<verse eid="MAT 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />مَاشِي مَارَّا يِنِّي إِي ذَايِي يقَّارن آ سِيذِي آ سِيذِي اَذ اَذْفن غَار ڒْمُلْك وجنَّا؛ لَّا، وَار ث تِيذْفن شَا إِلَّا يِنِّي يتݣّن مِين يخس بَابَا إِݣ يدْجَان ذݣ وجنَّا. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />ذِي يُوْم لْحِسَاب ذ لْعِقَاب اَطَّاس إِي ذَايِي غَا ينِين: آ سِيذِي آ سِيذِي، يَاك س <char style="it">لْحِكْمَا ن</char> يِيسم نّش إِي زِي تُوْغَا نْسڒْمَاذ إِ يِوْذَان؟ يَاك س <char style="it">لْحِكْمَا ن</char> يِيسم نّش إِي زِي تُوْغَا نْسُوْفُوْغ جْنُوْن؟ يَاك س <char style="it">لْحِكْمَا ن</char> يِيسم نّش إِي زِي تُوْغَا نْتݣّ ڒَعْجَايب؟ <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />ڒخْدّنِّي اَذَاسن ينِيغ: تُوْغَايِي نش عمَّارْص وَار كنِّيو سِّينغ شَا. بعّْذث خَافِي آ يِنِّي يتݣّن شَّرّْ!<verse eid="MAT 7:23" /></para>
  <para style="s">ڒبْنِي ن صَّح</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />مَارَّا ونِّي يتْسْڒَان إِ وَاوَاڒ ينُو يخدّم زَّايس، نتَّا اَم يِجّن ن بْنَاذم ذ اَمِيغِيس يبْنَا ثَدَّارْث نّس خ وزْرُو. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />يُوْوْثَا ونْࢲَار، حمْڒن-د يغْزْرَان، ئِصُوْض-د اَرِّيح يجْهذ يعْذُو خ ثدَّارْث نِّي. وَاخَّا اَمنِّي وَار ثوْضِي شَا ڒَاحقَّاش ثبْنَا خ دْسَاس ن وزْرُو. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />مَارَّا ونِّي يتْسْڒَان إِ وَاوَاڒ ينُو وَار زَّايس يخدّم شَا، نتَّا اَم يِجّن ن وفْغُوْڒ يبْنَا ثَدَّارْث نّس خ يِجْذِي. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />يُوْوْثَا ونْࢲَار، حمْڒن-د يغزْرَان، ئِصُوْض-د اَرِّيح يجْهذ يعْذُو خ ثدَّارْث نِّي. ڒخْدّنِّي ثوْضَا، ثقِّيم ذ ڒْخِرْبث."<verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />وَامِي يكمّڒ عِيْسَى اَوَاڒ نّس، تْعجّْبن ڒْغَاشِي زݣ وسڒْمذ نّس <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />مِينْزِي غَارس سُّلْطَا إِي زِي يسڒْمَاذ، وَار يدْجِي بُو اَمشْنَاو يمْسڒْمَاذن نْسن ن شَّرِيعَا.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا يج ؤُمهْڒُوْش يهْڒش س جْذَام</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />وَامِي د يهْوَا عِيْسَى زݣ وذْرَار نِّي ذْفَارن-ث اَطَّاس ن ڒْغَاشِي. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />ئِقَارّب-د غَارس يِجّن ذَايس جْذَام، ئِسجّذ-اَس ينَّا-ٱس: "آ سِيذِي، شك مڒَا ثخْسذ ثْزمَّرذ اَذَايِي ثسِّيصْفِيذ."<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />ئِسرْس خَاس عِيْسَى فُوْس نّس يحَاذَا-ث ينَّا-ٱس: "وَاه نش خْسغ، شك قَا ثْݣنْفِيذ." صَافِي ذݣ ومْشَان يݣنْفَا ومهْڒُوْش نِّي زِي جْذَام نّس. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />ينَّا-ٱس عِيْسَى: "خْزَر، وَار تْخبَّر حَدّ." ينَّا-ٱس: "رُوْح غَار ڒفْقي سظْهَار-اَس يخف نّش. اݣّ صّذْقث نِّي إِي زِي يوصَّا مُوْسَى حمَا اَغَارْسن ثِيڒِي شْهَاذث خ مِين يوقْعن."<verse eid="MAT 8:4" /></para>
  <para style="s">لْإِيمَان ن يِجّن ن وعَسْكَارِي ذ اَمقّْرَان ن اَرُّوْمَانُوْس</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />وَامِي يُوْذف عِيْسَى غَار وبِيلَاج ن كَفرْنَاحُوْم، يُوْسَا-د غَارس يجّن ن وعَسْكَارِي ذ اَمقّْرَان ن اَرُّوْمَانُوْس. ئِطَالب-يث <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />ينَّا-ٱس: "آ سِيذِي، أَقَا غَارِي اَخدَّام ينُو ذ اَنشْرُوْف ذِي ثدَّارْث يتْنزْبَر اَطَّاس ذِي ثَاسُّوْث."<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />ينَّا-ٱس عِيْسَى: "أَذ رَاحغ اَث سْݣنْفِيغ."<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />ئِنْدق-د وعَسْكَارِي نِّي اَمقّْرَان ينَّا-ٱس: "لَّا آ سِيذِي، نش وَار سْذِيهِيدْجغ شَا اَذ تَاذْفذ غَار ثدَّارْث ينُو. إِنِي غِير يجّن ن وَاوَاڒ أُو صَافِي اَتَاف اَذ يݣنْفَا وخدَّام ينُو. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />ؤُڒَا ذ نش س يِيخف ينُو غَارِي يِنِّي خَافِي يحكّْمن. غَارِي ڒْعَسْكَار خ وفُوْس ينُو حكّْمغ خَاسن. أَذ ينِيغ إِ يِجّن: رُوْح، أَذ يرَاح. أَذ ينِيغ إِ يِجّن: أَرَاح-د، أَذ د يَاس. أَذ ينِيغ إِ وخدَّام ينُو: اݣّ ثَا، أَت يݣّ."<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />وَامِي يسْڒَا عِيْسَى إِ مَانَاينِّي يتْعجّب اَطَّاس. ينَّا-ٱسن إِ يِنِّي ث يذْفَارن: "أَقَا تسْڒَام ڒْحَقّ: يِنِّي يدْجَان زِي أَيث-إِسْرَائِيل وَار ذَايْسن ؤُفِيغ بُو لْإِيمَان يمْغَر اَطَّاس اَم وَانِيتَا! <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />أَقَا قَّارغ-اَوم: أَذ د اَسن اَطَّاس ن يِوْذَان زِي شَّرْق ذ ڒْغَرْب اَذ قِّيمن اَك بْرَاهِيم ذ إِسْحَاق ذ يَعْقُوْب غَار مِيسَّا ذِي ڒْمُلْك وجنَّا. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />وَلَكِن يِنِّي تُوْغَا يتْخصَّا اَذ وَرْثن ڒْمُلْك ن أَربِّـي، أَتَاف اَذ منْضَارن غَار بَارَّا ذِي ثَادْجسْت مَانِي غَا يڒِين يمطَّاون ذ وغࢲَّاࢲ ن ثغْمَاس."<verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />ينَّا-ٱس عِيْسَى إِ وعَسْكَارِي نِّي: "رُوْح! أَغَارش يِيڒِي اَنشْت مِين ثُوْمْنذ." ڒخْدّنِّي يݣنْفَا وخدَّام نِّي.<verse eid="MAT 8:13" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا ثَذݣّْوَاڒْث ن بُطْرُس</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />وَامِي يُوْذف عِيْسَى غَار ثدَّارْث ن بُطْرُس، يُوْفَا ثَذݣّْوَاڒْث ن بُطْرُس ذِي ثَاسُّوْث ذَايس ثِمسِّي. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />غِير يحَاذَا-ت س وفُوْس ثْرُوْح خَاس ثْمسِّي، ثكَّر ثبْذَا تْسخَّار خَاس.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />وَامِي ثغْڒِي ثْفُوْشْت غَار ثْمدِّيث، ؤُوِين-د غَار عِيْسَى اَطَّاس ن يِنِّي ذِي دْجَان جْنُوْن. س لْأَمَر نّس يسُوْفُوْغ زَّايْسن جْنُوْن يسْݣنْفَا مَارَّا يِنِّي يهڒْشن. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />مَانَاينِّي حمَا اَذ يكمّڒ وَاوَاڒ إِي ينَّا سِيذِي أَربِّـي إِ نَّبي إِشَعْيَا ذݣ يِجّن ن زْمَان: "ئِيْسِي خَانغ ڒحْرِيقَاث نّغ، يَرْبُو ڒهْڒَاشَاث نّغ."<note caller="+" style="f"><char style="fr" closed="false">8‏.17 </char><char style="ft" closed="false">خْزَر إِشَعْيَا 53‏:4.</char></note><verse eid="MAT 8:17" /></para>
  <para style="s">يِنِّي يذفَّارن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />وَامِي يࢲْرَا عِيْسَى اَطَّاس ن يِوْذَان إِي ذَاس د ينّْضن، يكَّر يُوْمَر يمحْضَارن نّس ينَّا-ٱسن: يَالَّاه أَ نࢲْوَام غَار وجمَّاض-ين.<verse eid="MAT 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 8:19" />ئِقَارّب-د غَارس يجّن ن ومْسڒْمَاذ ن شَّرِيعَا ينَّا-ٱس: "آ لْمُعَلِّيم، نش اَش ذْفَارغ مَانِي مَا ثْرُوْحذ."<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />ينَّا-ٱس عِيْسَى: "ؤُشَّانن غَارْسن يفْرَان نْسن، ئِجْضَاض غَارْسن ڒَعْوَاش نْسن، وَلَكِن مِّيس ن بْنَاذم وَار غَارس ؤُڒَا ذ مَانِي غَا يسُوْمّث اَزدْجِيف نّس."<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />عَاوذ ينَّا-ٱس يج ومحْضَار نّس: "آ سِيذِي، سَمح-اَيِي ذ اَمزْوَارُو اَذ رَاحغ اَذ نضْڒغ بَابَا."<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />ينَّا-ٱس عِيْسَى: "ذْفَار-اَيِي-د." ينَّا-ٱس: "يِنِّي يمُّوْثن اجّ-يثن اَذ نضْڒن يمْتِّينن نْسن."<verse eid="MAT 8:22" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يهدّن ڒبْحَر</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />ئِنْيَا عِيْسَى ذِي ثْغَرَّابُوْت، ذْفَارن-ث يمحْضَارن نّس. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />بْڒَا ڒخْبَر، ثكَّر-د يجّن ن لْعَاصِفَا ثجْهذ اَطَّاس ذِي ڒبْحَر ثبْذَا ثْغَرَّابُوْت تْعمَّر س وَامَان. عِيْسَى نتَّا تُوْغَاث يطّص. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />قَارّْبن غَارس يمحْضَارن، سْفَاقن-ث نَّان-اَس: "آ سِيذِي، نْجَّا-يَانغ اَقَا نشِّين نتْمتَّا!"<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />ينَّا-ٱسن عِيْسَى: "مَايمِّي تݣّْوْذم قَاع اَمُّو؟ لْإِيمَان نْوم ذ ؤُقْلِيل." ڒخْدّنِّي يكَّر يسْبدّ اَرِّيح ذ ڒمْوَاج، يَرْسَا ڒْحَاڒ. <verse eid="MAT 8:26" /><verse number="27" style="v" sid="MAT 8:27" />قِّيمن يرْيَازن نِّي تْعجّْبن ذَايس نَّان: "مِين يعْنَا وَانِيتَان؟ ؤُڒَا ذ اَرِّيح ذ ڒبْحَر تْطَاعَان-اَس؟"<verse eid="MAT 8:27" /></para>
  <para style="s">ثْنَاين ذَايْسن جْنُوْن ذِي ثْمُوْرْث ن يجَرِيثِيْين</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />وَامِي يُوْوض عِيْسَى غَار وجمَّاض-ين ن ڒبْحَر غَار ثْمُوْرْث ن يجَرِيثِيْين، ڒْقَان-ث-يذ ثْنَاين ن يِوْذَان ذَايْسن جْنُوْن فّْغن-د زݣ يمضْڒَان <char style="it">مَانِي زدّْغن</char>. قسْحن، شَّاثن، وَار يزمَّر حَدّ اَخَاسن يكّ خ وبْرِيذ نِّي. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />عيّضن نَّان-اَس: "مِين ثخْسذ زَّايْنغ آ مِّيس ن أَربِّـي؟ مَا ثُوْسِيذ-د اَذَانغ ثْعدّْبذ قْبڒ إِ ڒْوقْث؟"<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />غَار ڒݣّْوَاج شْوَايْت، ذِنِّي يجّن ن ثْحِيمرْث ذ ثَمقّْرَانْت ن يِڒْفَان ثَرْوس.<note caller="+" style="f"><char style="fr" closed="false">8‏.30 </char><char style="ft" closed="false">ئِڒْفَان نِثْنِي ذ لْخَنَازِير نِغ يحلُّوْفن.</char></note> <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />جْنُوْن نِّي تَّارن زِي عِيْسَى نَّان-اَس: "مڒَا ثْسُوْفْغذ-اَنغ، سكّ-اَنغ غَار ثْحِيمرْث-ين ن يِڒْفَان حمَا اَذَايْسن نَاذف." <verse eid="MAT 8:31" /><verse number="32" style="v" sid="MAT 8:32" />ينَّا-ٱسن عِيْسَى <char style="it">إِ جْنُوْن نِّي</char>: "رُوْحم!" ڒخْدّنِّي فّْغن <char style="it">زِي ثْنَاين نِّي ن يِوْذَان</char> ؤُذْفن ذݣ يِيڒْفَان. ثهْوَا ثْحِيمرْث نِّي مَارَّا ذِي ثيْسَارْث غَار ڒبْحَر مُّوْثن ذݣ وَامَان. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />يِنِّي يَروّْسن اَروْڒن رُوْحن غَار وبِيلَاج، سُوْفْغن ڒخْبَار ذِنِّي خ مَارَّا مِين يوقْعن ذ مِين يوقْعن إِ يِوْذَان نِّي ذِي دْجَان جْنُوْن. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />ڒخْدّنِّي فّْغن-د مَارَّا يوْذَان ن وبِيلَاج بَاش اَذ رَاحن اَذ ڒْقَان عِيْسَى. وَامِي ث ࢲْرِين، حشّْمن-ث حمَا اَخَاسن يبعّذ زِي جِّهث نْسن.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا يجّن ن ونشْرُوْف</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />ئِنْيَا عِيْسَى ذِي ثْغَرَّابُوْت، ئِقْضع ڒبْحَر يروّح غَار دْشَار نّس. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />ذِنِّي شَان يِوْذَان ؤُوِين-د غَارس يجّن ن ورْيَاز مُّوْثن-اَس يضَارن، ئِزّڒ ذِي ثَاسُّوْث نّس. وَامِي عِيْسَى يࢲْرَا لْإِيمَان إِي ذَايْسن ينَّا-ٱس إِ ونشْرُوْف نِّي: "وَار تݣّْوذ شَا آ مِّي، قَا تْوَاغْفَرنْت-اَش ڒْمُعْصِيَاث نّش." <verse eid="MAT 9:2" /><verse number="3" style="v" sid="MAT 9:3" />ذِنِّي شَان يمْسڒْمَاذن ن شَّرِيعَا قَّارن ذݣ وُوْڒَاون نْسن: "بْنَاذم-أَ يقَّار اَوَاڒ وَار يحْڒِين خ أَربِّـي."<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />عِيْسَى يسّن مِين تْفكَّرن ذِي ڒَعْقُوْڒَاث نْسن ينَّا-ٱسن: "مَايمِّي تْفكَّرم اَمُّو ذِي مِين وَار يحْڒِين؟ <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />مِين يسهْڒن اَطَّاس اَذَاس ينِيغ <char style="it">إِ ونشْرُوْف-أَ</char>، مَا ٱذَاس ينِيغ: تْوَاغْفَرنْت-اَش ڒْمُعْصِيَاث نّش؟ نِغ مَا ٱذَاس ينِيغ: كَّر شك ؤُيُوْر؟ <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />نش خْسغ اَذ تسّْنم بلِّي مِّيس ن بْنَاذم غَارس سُّلْطَا خ ثْمُوْرْث حمَا اَذ يغْفَر ڒْمُعْصِيَاث." أُوْشَا ينَّا-ٱس إِ ونشْرُوْف نِّي: "كَّر، يْسِي ثَاسُّوْث نّش، رُوْح اَذ تْروّْحذ غَار ثدَّارْث نّش." <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />ئِكَّر ورْيَاز نِّي يروّح. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />وَامِي ࢲْرِين يِوذَان مَانَاينِّي، ݣّْوْذن حمْذن أَربِّـي خ سُّلْطَا إِي ذَاسن يتِيشّ إِ يِوْذَان.<verse eid="MAT 9:8" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يتْڒَاغَا-د إِ مَتَّى</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />وَامِي يُوْيُوْر سّنِّي عِيْسَى، يُوْفَا يجّن ن ورْيَاز قَّارن-اَس مَتَّى يقِّيم ذݣ ومْشَان مَانِي جمّْعن ضَّرِيبَا. ينَّا-ٱس عِيْسَى: "ذْفَار-اَيِي-د!" أُوْشَا يكَّر مَتَّى يذْفَار-يث.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />ئِقِّيم عِيْسَى ذِي ثدَّارْث ن مَتَّى يتتّ نتَّا ذ يمحْضَارن نّس. أَطَّاس ن يعشَّارن ذ يِنِّي يعْصَّان زَعْمَا قِّيمن تتّن اَكِذس. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />وَامِي ࢲْرِين ڒْحِزب ن يفَرِّيسِيْين مَانَاينِّي كَّرن نَّان-اَسن إِ يمحْضَارن نّس: "مَايمِّي يتتّ لْمُعَلِّم نْوم اَك يعشَّارن ذ يِنِّي يعْصَّان؟"<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />ئِسْڒَا-يَاسن عِيْسَى ينَّا-ٱسن: "ئِوْذَان يصحَّان وَار تحْذِيجن بُو وضْبِيب، أَضْبِيب تحْذَاجن-ث يمهْرَاش. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />رُوْحم رْزُوْم خ ڒْمَعْنَا ن لْأَيَا إِي يقَّارن: خْسغ اَذ تْرحْمم يوْذَان، وَار خْسغ بُو اَذ تْغَرْصم إِ ڒبْهَايم."<note caller="+" style="f"><char style="fr" closed="false">9‏.13 </char><char style="ft" closed="false">خْزَر هُوْشَع 6:​6.</char></note> <char style="it">ينَّا-ٱسن:</char> "وَار د ؤُسِيغ شَا اَذ ڒَاغِيغ إِ يِنِّي يدْجَان نِيشَان، ؤُسِيغ-د اَذ ڒَاغِيغ إِ يِنِّي يعْصَّان!"<verse eid="MAT 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />ثُمَّا قَارّْبن-د يمحْضَارن ن يَحْيَى غَار عِيْسَى نَّان-اَس: "مَايمِّي نشِّين ذ ڒْحِزب ن يفَرِّيسِيْين ڒبْدَا نتْࢲُوْمَّا، ئِمحْضَارن نّش وَار تْࢲُوْمِّين شَا؟"<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />ينَّا-ٱسن عِيْسَى: "ئِمدُّوْكَاڒ ن مُوْڒَاي، مَا زمَّرن اَذ خيّْقن ذِي نْهَار نِّي ن ڒْفَارْح نّس؟ لَّا، وَلَكِن اَذ د اَسن وُوْسَّان اَذ يميْسِي مُوْڒَاي زِي ڒْوسْط نْسن. ڒخْدّنِّي اَذ ࢲُوْمّن! <verse eid="MAT 9:15" /><verse number="16" style="v" sid="MAT 9:16" />وَار يدْجِي حَدّ يتْرقَّاع اَرُّوْض ذ ڒْبَاڒِي س يِجّن ن ثْرقِّيعْث ن تُّوْب ذ جْذِيذ، مَايمِّي؟ ڒَاحقَّاش ثَرقِّيعْث نِّي ن جْذِيذ اَذ تْنجْمع أُوْشَا اَذ تْوَاكّس زݣ وَارُّوْض نِّي ن ڒْبَاڒِي. ڒخْدّنِّي اَذ يقِّيم وشَارِّيݣ يمْغَر! <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />ؤُڒَا ذ اَمَان ن وضِيڒ ذ جْذِيذ وَار خدْجْقن شَا ذݣ يڒمَاون يقْذِيمن، حمَا وَار دُّوْقُّوْزن وَار تْزدْجِيعن شَا وَامَان ن وضِيڒ اَذ ضيّْعن يڒمَاون نِّي. وَلَكِن اَمَان ن وضِيڒ ذ جْذِيذ خدْجْقن ذݣ يڒمَاون ذ جْذِيذ. أَمنِّي وَار تْضيِّيع ؤُڒَا ذ يجّن ن ڒْحَاجث: لَّا اَمَان وضِيڒ، لَّا يڒمَاون."<verse eid="MAT 9:17" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا يدْجِيس ن يِجّن ن اَرَّايس</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />وَامِي تُوْغَا عَاذ يقَّار عِيْسَى مَانَايَا، يُوْسَا-د غَارس يجّن ن اَرَّايس يسجّذ-اَس ينَّا-ٱس: "يدْجِي قَا ڒخُّو إِي ثمُّوْث. يَالَّاه اَكِذِي سرْس خَاس فُوْس نّش حمَا اَذ تدَّر." <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />ئِكَّر عِيْسَى يذْفَار-يث نتَّا ذ يمحْضَارن نّس.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />ذِنِّي يجّن ن ثمْغَارْث ثنْعَاش يسݣّْوُسَا زݣ وَامِي إِي ثهْڒش، تَازَّڒ س يذَامّن.<note caller="+" style="f"><char style="fr" closed="false">9‏.20 </char><char style="ft" closed="false">ئِذَامّن نتَّا ذ دّم.</char></note> ثذْفَار عِيْسَى، ثْحَاذَا-يَاس طَّارْف ن وسڒْهَام نّس. <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />ثنَّا قْبڒ ذݣ وُوْڒ نّس: "مڒَا حَاذِيغ غِير اَسڒْهَام نّس اَتَاف اَذ ݣنْفِيغ." <verse eid="MAT 9:21" /><verse number="22" style="v" sid="MAT 9:22" />ئِنقْڒب غَارس عِيْسَى يࢲْرِي-ت أُوْشَا ينَّا-ٱس: "وَار تݣّْوذ شَا آ يدْجِي، شم لْإِيمَان نّمْ يسْݣنْفَا-شم." ثْݣنْفَا ثمْغَارْث نِّي ڒخْدّنِّي.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />وَامِي يُوْوض عِيْسَى غَار ثدَّارْث ن اَرَّايس نِّي، ئِتْوَاڒَا ذِنِّي ڒبْعَاض زِي ڒْغَاشِي يتْزمَّارن لْمُوْسِيقَا ومتِّين أُو ذ يِجّن ن لْهَرَاج. <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />ينَّا-ٱسن عِيْسَى: "فّْغم سَّا! أَقَا ثَحنْجِيرْث-أَ وَار ثمُّوْث شَا، ثطّص وَاهَا!" ڒخْدّنِّي بْذَان ضحّْشن خَاس. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />وَامِي سُوْفْغن يوْذَان نِّي، يُوْذف غَار وخَّام يطّف-اَس ذݣ وفُوْس إِ ثْحنْجِيرْث نِّي أُوْشَا ثكَّر. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />ئِفّغ ڒخْبَار غَار مَارَّا اَيثْبَاب ن ثْمُوْرْث نِّي.<verse eid="MAT 9:26" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا ثْنَاين ن يضَرْغَاڒن ذ يج وزيْنُوْن</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />يُوْيُوْر سّنِّي عِيْسَى، ذْفَارن-ث ثْنَاين ن يضَرْغَاڒن تْڒَاغَان قَّارن: "آ مِّيس ن أَيث-دَاود، رْحم-اَنغ!" <verse eid="MAT 9:27" /><verse number="28" style="v" sid="MAT 9:28" />وَامِي يُوْذف عِيْسَى غَار ثدَّارْث، قَارّْبن غَارس يضَرْغَاڒن نِّي. ينَّا-ٱسن عِيْسَى: "مَا ثُوْمْنم بلِّي نش زمَّرغ اَذ ݣّغ مَانَايَا؟" نَّان-اَس: "وَاه آ سِيذِي." <verse eid="MAT 9:28" /><verse number="29" style="v" sid="MAT 9:29" />أُوْشَا يحْذَا-يَاسن عِيْسَى ثِيطَّاوِين ينَّا-ٱسن: "عْلَاحْسَاب لْإِيمَان نْوم إِي غَا تْوَاݣنْفَام." <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />ڒخْدّنِّي نُوْرْزْمنْت ثِيطَّاوِين نْسن. يعْڒم-اَسن عِيْسَى ينَّا-ٱسن: "غَارْوم اَذ يفّغ ڒخْبَار-أَ غَار شَا حَدّ!" <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />وَلَكِن نِثْنِي رُوْحن سُوْفْغن ڒخْبَار نِّي خ عِيْسَى ذِي ثْمُوْرْث نِّي مَارَّا.<verse eid="MAT 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />ذِي ڒْوقْث إِي ذِي رُوْحن، شَان يِوْذَان ؤُوِين-اَس-د إِ عِيْسَى يجّن ن ورْيَاز ذ اَزيْنُوْن ذَايس جّنّ. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />وَامِي يسُوْفغ عِيْسَى جّنّ نِّي، يبْذَا وزيْنُوْن نِّي يسَّاوَاڒ. قِّيمن تْعجّْبن ڒْغَاشي نِّي نَّان: "عمَّارْص مَا يوْقع مَانَايَا ذِي ثْمُوْرْث ن أَيث-إِسْرَائِيل." <verse eid="MAT 9:33" /><verse number="34" style="v" sid="MAT 9:34" />وَلَكِن ڒْحِزب ن يفَرِّيسِيّْين نَّان: "نتَّا يسُوْفُوْغ جْنُوْن ڒَاحقَّاش اَرَّايس ن جْنُوْن يُوْشَا-ٱس جّْهذ-أَ."<verse eid="MAT 9:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />يُوْيُوْر عِيْسَى ذِي مَارَّا ثِندَّام<note caller="+" style="f"><char style="fr" closed="false">9‏.35 </char><char style="ft" closed="false">ثِندَّام نِثنْتِي ذ ثِنْدِينِين.</char></note> ذ ڒدْشُوْر، ئِسڒْمَاذ ذِي ثمْزِيذَاوِين ن أَيث-إِسْرَائِيل يتْحدَّاث يتْبشَّار س ڒْمُلْك ن أَربِّـي. ئِسْݣنْفَا مَارَّا ڒهْڒَاشَاث ذ دِّيعَان ن دَّات. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />يࢲرّ عِيْسَى ڒْغَاشِي نِّي قّْسن-اَس مِينْزِي تْوَاعدَّابن تْنهْوَاڒن، ݣِّين اَمشْنَاو يحُوْڒِيْين وَار غَارْسن شَا ؤُو ثن غَا يَروْسن. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />ينَّا-ٱسن إِ يمحْضَارن نّس: "ثَفدْجَاحْث اَطَّاس وَلَكِن ذْرُوس يشوَّارن إِي غَا يخذْمن. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />تَّارث زِي بَاب ن ثْفدْجَاحْث اَد يَرْنِي يشوَّارن ذݣ ومَرْجع نّس."<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">سِيذِيثْنغ عِيْسَى يخْضَر ثنْعَاش ن اَرُّسُل</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />ئِڒَاغَا-د عِيْسَى خ ثنْعَاش نِّي ن يمحْضَارن نّس يُوْشَا-ٱسن سُّلْطَا إِي زِي غَا سُوْفْغن جْنُوْن اَذ سْݣنْفَان مَارَّا ڒهْڒَاشَاث ذ ڒحْرِيقَاث ن يِوْذَان. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />ذ يِيْنَا ذ يسمَاون ن ثنْعَاش ن اَرُّسُل: أَمزْوَارُو نْسن قَّارن-اَس سِمْعَان مَعْرُوْف س بُطْرُس ذ وُوْمَاس قَّارن-اَس أَنْدْرُوْس، ذ مِّيس ن زَبَادِي قَّارن-اَس يَعْقُوْب ذ وُوْمَاس قَّارن-اَس يُوْحَنَّا، <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />ذ فِيلِيپَّـاس، ذ بَرْتُلُمَاي، ذ تُوْمَا، ذ مَتَّى زݣ يعشَّارن، ذ يَعْقُوْب مِّيس ن حَلْفَى، ذ تَدِّي، <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />ذ سِمْعَان ؤُمِي قَّارن &lt;لْمُنَاضِل&gt;، ذ يَهُوْذَا إِسْخَرْيُوطِي يعْنِي ونِّي يزّنْزن عِيْسَى.<verse eid="MAT 10:4" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسّكّ اَرُّسُل اَذ حدّْثن</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />ثنْعَاش-أَ ن يرْيَازن يسّكّ-يثن عِيْسَى يوصَّا-ثن ينَّا-ٱسن: "وَار تْرَاحم شَا غَار ثْمُوْرَا ن ڒݣْنُوْس. وَار تِيذْفم بُو ثِندَّام<note caller="+" style="f"><char style="fr" closed="false">10‏.5 </char><char style="ft" closed="false">ثِندَّام نِثنْتِي ذ ثِنْدِينِين.</char></note> ن ثْمُوْرْث ن سَامَرْيَا. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />لَّا، رُوْحث غَار يحُوْڒِيْين نِّي يودَّارن <char style="it">يعْنِي يوْذَان</char> ن أَيث-إِسْرَائِيل. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />خْمِي غَا ثْرَاحم، حدّْثم س ڒْمُلْك وجنَّا اَقَا يُوْذس-د. <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />سْݣنْفَام يمهْڒَاش، سْفَاقم-د يِنِّي يمُّوْثن، سِيصْفَام يِنِّي إِݣ يدْجَا جْذَام، سُوْفْغم جْنُوْن. مَانَايَا يمُّوْش-اَوم بَاطڒ، ؤُڒَا ذ كنِّيو ؤُشم-ث بَاطڒ! <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />وَار دبَّرم وَالُو: لَّا دّْهب، لَّا نُّقَارْث، لَّا نّحَّاس ذݣ وحزَّام نْوم. <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />وَار دبَّرم بُو وقْرَاب خ وبْرِيذ ؤُڒَا ذ ثْنَاين يتْشَامِّيرن، ؤُڒَا ذ ثِسِيڒَا، ؤُڒَا ذ اَعكَّاز. مِينْزِي ونِّي يتْبشَّارن غَارس ڒْحَقّ اَذ يتْخَاڒس اَغْرُوْم نّس. <verse eid="MAT 10:10" /><verse number="11" style="v" sid="MAT 10:11" />خْمِي غَا ثَاذْفم شَان ثنْدِينْت نِغ شَان دْشَار، رْزُوْم خ ونِّي كنِّيو غَا يقبْڒن غَار ثدَّارْث نّس. قِّيمث ذَايس اَڒ غَا ثُوْيُوْرم سّنِّي. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />خْمِي غَا ثَاذْفم غَار شَان ثدَّارْث، سدْجْمم خ اَيثْبَاب نّس. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />مڒَا قبْڒن-كنِّيو اَيثْبَاب نّس، أَتَاف اَكِذْسن ثِيڒِي لْبَرَكَا نْوم. مڒَا وَار كنِّيو قْبِيڒن شَا، أَتَاف وَار كِسن تْغِيمِي شَا لْبَرَكَا نْوم. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />مڒَا وَار كنِّيو قْبِيڒن شَا ذِي شَان ثدَّارْث نِغ ذِي شَان ثنْدِينْت نِغ مڒَا وَار خْسن اَغَارْوم صنّْطن، فّْغث سّنِّي مسْحث ثَعجَّاشْت زݣ يضَارن نْوم. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />أَقَا تسْڒَام ڒْحَقّ: ذِي يُوْم لْحِسَاب ذ لْعِقَاب اَذ يِيڒِي لْعِقَاب ن ثنْدِينْت نِّي كْتَار زِي لْعِقَاب ن ثنْدِينْت <char style="it">ثَعفَّانْت</char> ن سَادُوْم ذ ثنْدِينْت <char style="it">ثَعفَّانْت</char> ن عَمُّوْرَا.<verse eid="MAT 10:15" /></para>
  <para style="s">أَعدّب إِݣ يتكّن خ يمحْضَارن</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />نش اَقَا سّكِّيغ-كنِّيو اَمشْنَاو يحُوْڒِيْين جَار وُوْشَّانن. إِڒِيم ثْفَاقم اَمشْنَاو يفِيغرَان، إِڒِيم ذ نِّيّث اَمشْنَاو يذْبِيرن. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />حْضَام يخف نْوم زݣ يِوْذَان. أَكنِّيو سلّْمن إِ لْمَحْكَامَاث؛ أَكنِّيو ؤُوْثن ذِي ثمْزِيذَاوِين نْسن. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />أَكنِّيو جَرّن غَار لْحُكَّام ذ يزدْجِيذن عْلَاحْسَاب يسم ينُو حمَا اَخَافِي ثْشهْذم غَار نِثْنِي ذ يِنِّي زِي ڒݣْنُوْس. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />خْمِي كنِّيو غَا سلّْمن، بْڒَا مَا ٱذ تيْسِيم اَمْنُوْس ذِي ڒَعْقُوْڒَاث نْوم مِين غَا ثِينِيم نِغ ذ مَامّش إِي غَا ثسِّيوْڒم؛ لَّا، أَوَاڒن نِّي إِي غَا ثِينِيم ذ أَربِّـي إِي ذَاوم ثن غَا يُوْشن ذِي ثْسَعَّات نِّي. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />وَار يدْجِي بُو ذ كنِّيو إِي غَا يسِّيوْڒن؛ لَّا، ذ أَرُّوْح ن بَابَاثْوم إِي غَا يسِّيوْڒن ذݣ ومْشَان نْوم. <verse eid="MAT 10:20" /><verse number="21" style="v" sid="MAT 10:21" />ؤُمَاس اَذ يسلّم ؤُمَاس إِ ڒْموْث. بَابَاس اَذ يسلّم مِّيس. ثَارْوَا اَذ رَاحن ضد لْوَالِيدِين نْسن، أَثن سلّْمن إِ يِنِّي إِي ثن غَا نْغن. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />أَكنِّيو عِيفّن مَارَّا عْلَاحْسَاب يسم ينُو، وَلَكِن ونِّي غَا يصْبَارن غَار ونݣَّارُو اَتَاف اَذ ينْجم. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />مڒَا عَدّْبن-كنِّيو ذِي شَان ثنْدِينْت، اَروْڒم غَار ثْنّغْنِي. أَقَا تسْڒَام ڒْحَقّ: أَذ د يَاس مِّيس ن بْنَاذم، أَتَاف كنِّيو عَاذ وَار ثْكمّْڒم <char style="it">خ مِين كنِّيو وصِّيغ</char> ذِي ثْندَّام ن أَيث-إِسْرَائِيل.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />أَمحْضَار وَار يدْجِي شَا ذ اَمقّْرَان ح لْمُعَلِّم نّس. أَخدَّام وَار يدْجِي شَا ذ اَمقّْرَان خ ؤُوقَّاف نّس. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />بَرَكَا غِير اَذ يِيڒِي ومحْضَار اَم لْمُعَلِّم نّس، أَذ يِيڒِي وخدَّام اَم ؤُوقَّاف نّس. مڒَا ڒَاغَان إِ بَاب ن ثدَّارْث &lt;آ إِبْڒِيس&gt;،<note caller="+" style="f"><char style="fr" closed="false">10‏.25 </char><char style="ft" closed="false">أَوَاڒ-أَ س ثَيُوْنَانِيث نتَّا ذ &lt;بْعَلْزَبُول.&gt;</char></note> إِيوَا مَامّش غَا ڒَاغَان إِ ڒحْبَاب ن ثدَّارْث نّس؟<verse eid="MAT 10:25" /></para>
  <para style="s">ثِيݣّْوْذِي زِي أَربِّـي</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />وَار تݣّْوْذم شَا زَّايْسن. مَارَّا مِين يتْوَاسْنُوْفَّرن اَذ د ينفْضح. مَارَّا مِين ينُوْفَّرن اَذ يتْوَاسّن! <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />مِين ذَاوم قَّارغ ذِي ثَادْجسْت، عَاوْذم-اَس ذِي ثْفَاوْث ن نْهَار. مِين تسْڒَام س ڒْحسّ، عيّْضث زَّايس خ ثْزقَّا. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />وَار تݣّوْذث شَا زݣ يِنِّي ينقّن دَّات وَار زمَّرن اَذ نْغن ؤُڒَا ذ ڒَعْمَر؛ لَّا، ݣّْوْذث زِي أَربِّـي يعْنِي ونِّي يزمَّرن اَذ يدمَّر دَّات ذ ڒَعْمَر ذِي جَهنَّمَا. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />مَا وَار تْمنْزِين ثْنَاين ن يزَاوْجِيون<note caller="+" style="f"><char style="fr" closed="false">10‏.29 </char><char style="ft" closed="false">ئِزَاوْجِيون نِثْنِي ذ يجْضَاض.</char></note> س دُوْرُو؟ وَلَكِن، وَار زَّايْسن يوطِّي ؤُڒَا ذ يجّن غَار ثْمُوْرْث مڒَا وَار يخِيس شَا بَابَاثْوم. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />ؤُڒَا ذ يزُوْطَّان إِي غَارْوم خ وزدْجِيف نْوم يحْسب-يثن أَربِّـي مَارَّا. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />وَار تݣّْوْذم شَا. كنِّيو ثْسݣّْوَام كْتَار س وَاطَّاس خ يزَاوْجِيون.<verse eid="MAT 10:31" /></para>
  <para style="s">ونِّي يشهّْذن خ سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />ونِّي زَّايِي غَا يشهْذن نش زَّاث إِ يِوْذَان، أَتَاف اَزَّايس شهْذغ نش زَّاث إِ بَابَا يدْجَان ذݣ وجنَّا. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />ونِّي ذَايِي غَا ينْكَرن زَّاث إِ يِوْذَان، أَتَاف اَث نْكَرغ نش زَّاث إِ بَابَا يدْجَان ذݣ وجنَّا.<verse eid="MAT 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />وَار تْفكَّرم شَا بلِّي ؤُسِيغ-د اَذ ݣّغ ڒهْنَا ذِي دُّنشْت-أَ. وَار د ؤُسِيغ شَا اَذ ݣّغ ڒهْنَا؛ لَّا، ؤُسِيغ-د اَذ ݣّغ اَمنْغِي. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />ؤُسِيغ-د اَذ سْمنْغغ مِّيس اَك بَابَاس، ذ يدْجِيس اَك يمَّاس، ذ ثْسْڒِيث اَك لَالَّاس. <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />أَذ يِيڒِي ڒَعْذُو ن بْنَاذم ذ ڒحْبَاب إِي كِس يزدّْغن ذِي ثدَّارْث نّس."<note caller="+" style="f"><char style="fr" closed="false">10‏.36 </char><char style="ft" closed="false">خْزَر مِيْخَا 7‏:6.</char></note><verse eid="MAT 10:36" /></para>
  <para style="b" />
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />"ونّي خف يعِيزّ بَابَاس نِغ ذ يمَّاس كْتَار زَّايِي نش، أَتَاف وَار ذَايِي يسْذِيهدْج شَا. ونِّي خف يعِيزّ مِّيس نِغ ذ يدْجِيس كْتَار زَّايِي نش، أَتَاف وَار ذَايِي يسْذِيهدْج شَا. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />ونِّي يتَاݣِين اَذ ييْسِي صَّلِيب نّس<note caller="+" style="f"><char style="fr" closed="false">10‏.38 </char><char style="ft" closed="false">ذِي ڒْوقْث نِّي ن سِيذِيثْنغ عِيْسَى اَرُّوْمَانُوْس نقّن يوْذَان ذِي صَّلِيب، ئِوْذَان تْعدَّابن اَطَّاس ذَايس. ونِّي يذفَّارن سِيذِيثْنغ عِيْسَى يخصَّا-يَاس وَار يتݣّْوذ شَا زِي صَّلِيب نِّي، يعْنِي زِي ڒْموْث ؤُڒَا زݣ وعدّب.</char></note> اَذَايِي يذْفَار نش، أَتَاف وَار ذَايِي يسْذِيهدْج شَا. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />ونِّي غَا يربْحن ثُوْذَارْث نّس، أَتَاف أَت يخْسَر. ونِّي غَا يخْسَرن ثُوْذَارْث نّس خ سَّبَاب ينُو، أَتَاف أَت يرْبح.<verse eid="MAT 10:39" /></para>
  <para style="s">لْأَجَار</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />ونِّي كنِّيو يقبّْڒن، أَتَاف يقْبڒ-اَيِي. ونِّي ذَايِي يقبّْڒن، أَتَاف يقْبڒ ونِّي ذَايِي د يسّكّن. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />ونِّي يقبّْڒن شَان ن نَّبِي ڒَاحقَّاش يسّكّ-يث-يذ أَربِّـي، أَتَاف اَغَارس يِيڒِي لْأَجَار اَمشْنَاو شَان ن نَّبِي. ونِّي يقبّْڒن شَان ن ڒْمُوْمن ڒَاحقَّاش ذ ڒْمُوْمن، أَتَاف اَغَارس يِيڒِي لْأَجَار اَمشْنَاو شَان ن ڒْمُوْمن. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />أَقَا تسْڒَام ڒْحَقّ: ونِّي غَا يُوْشن غِير ڒْكَاس ن وَامَان ذ اَسمَّاض إِ شَان يِجّن زݣ يمزْيَانن-أَ ڒَاحقَّاش ذ اَمحْضَار ينُو، أَتَاف اَذ يَاوِي لْأَجَار نّس وَار ث يتْضيِّيع شَا."<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">سِيذِيثْنغ عِيْسَى ذ سِيذْنَا يَحْيَى</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />وَامِي يكمّڒ عِيْسَى ڒُوْصِيَاث إِ ثنْعَاش ن يمحْضَارن نّس، يُوْيُوْر سّنِّي يرُوْح حمَا اَذ يسڒْمذ اَذ يحدّث ذِي ثْندَّام<note caller="+" style="f"><char style="fr" closed="false">11‏.1 </char><char style="ft" closed="false">ثِندَّام نِثنْتِي ذ ثِنْدِينِين.</char></note> إِي د يُوْذْسن جِّهث نِّي.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />وَامِي يَحْيَى اَقَاث ذِي ڒحْبس، ئِسْڒَا خ ڒخْذَايم ن لْمَسِيح. ئِسّكّ شَان يمحْضَارن نّس غَار عِيْسَى <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />حمَا اَذَاس ينِين: "مَا ذ شك إِي خف نتْسْڒَا اَذ د تَاسذ نِغ أَ نْرَاجَا شَان يِجّن نّغْنِي؟"<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: "عقْبث غَار يَحْيَى عَاوْذم-اَس مِين تسْڒَام ذ مِين تْوَاڒَام: <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />ئِضَرْغَاڒن تْوَاڒَان، ئِزحَّافن ݣُّوْرن، يِنِّي إِي ذِي يدْجَا جْذَام ݣنْفَان، ئِذهْشُوْرن تسْڒَان، يِنِّي يمُّوْثن تْنكَّرن-د، ڒْمُسَاكِين تْوَابشَّارن. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />سَّعْذ ن يِنِّي وَار ذَايِي يتْشكِّين شَا."<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />وَامِي روّْحن يمحْضَارن ن يَحْيَى، عِيْسَى يبْذَا يسَّاوَاڒ خ يَحْيَى يقَّار-اَسن إِ ڒْغَاشِي نِّي: "مِينْخف ثفّْغم اَذ تࢲرم ذِي ڒخْڒَا؟ مَا غَار يج وغَانِيم يتْهزَّا-ث اَرِّيح؟ لَّا! <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />مڒَا لَّا، مِينْخف ثفّْغم اَذ تࢲرم؟ مَا ذ يجّن ن ورْيَاز يَرض اَرُّوْض ذ اَصبْحَان؟ لَّا، يِنِّي إِي غَار يدْجَا وَارُّوْض ذ اَصبْحَان تْعِيشن مْلِيح تِيڒِين ذِي ڒْقُصُوْر ن يزدْجِيذن! <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />مڒَا لَّا، مِينْخف ثفّْغم اَذ تࢲرم؟ مَا ذ يجّن ن نَّبِي؟ قَّارغ-اَوم: وَاه، نتَّا كْتَار زݣ يِجّن ن نَّبِي. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />ذ يَحْيَى إِي خف يسَّاوَاڒ لْكِتَاب:</para>
  <para style="q1" vid="MAT 11:10">أَقَا تْسكِّيغ-د يجّن ن اَرَّسُوْل ينُو زَّاثش،</para>
  <para style="q2" vid="MAT 11:10">حمَا اَذَاش يسوْجذ اَبْرِيذ نّش.<note caller="+" style="f"><char style="fr" closed="false">11‏.10 </char><char style="ft" closed="false">خْزَر مَلَاخِي 3‏:1.</char></note><verse eid="MAT 11:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11" />أَقَا تسْڒَام ڒْحَقّ: زِي مِين د جِّينْت ثمْغَارِين، وَار يدْجِي حَدّ ذ اَمقّْرَان زِي يَحْيَى، وَلَكِن ونِّي إِي يدْجَان ذ اَمزْيَان قَاع ذِي ڒْمُلْك ن وجنَّا نتَّا ذ اَمقّْرَان زِي يَحْيَى.<verse eid="MAT 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 11:12" />زِي ڒْوقْث ن يَحْيَى اَڒ ڒخُّو يوْذَان تمْذحَّاسن اَذ اَذْفن ذِي ڒْمُلْك وجنَّا، يرْيَازن تْمنْغَان بَاش اَغَارْسن يِيڒِي. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />أَقَا شَّرِيعَا ن مُوْسَى<note caller="+" style="f"><char style="fr" closed="false">11‏.13 </char><char style="ft" closed="false">شَّرِيعَا ن مُوْسَى قَّارن-اَس تُوْرَات. ذَايس ڒُوْصِيَاث نِّي إِي د يُوْشَا سِيذِي أَربِّـي إِ يِوْذَان ن أَيث-إِسْرَائِيل خ وفُوس ن سِيذْنَا مُوسَى. تُوْرَات ن سِيذْنَا مُوسَى ذَايس خمْسَا ن لْكُتُب: ئِجّن قَّارن-اَس يمزْوُوْرَا، ئِجّن قَّارن-اَس ؤُفُوْغ، ئِجّن لْكِتَاب ن أَيث-لَاوِي، ئِجّن لْعَدَد، ئِجّن أَفسَّار ن شَّرِيعَا ن مُوسَى.</char></note> ذ قَاع لْأَنْبِيَا سِّيوْڒن خ ڒْمُلْك وجنَّا حتَّا اَڒ ڒْوقْث ن يَحْيَى. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />أُو مڒَا ثخْسم اَذ تْفهْمم، يَحْيَى نتَّا ذ نَّبِي إِلْيَاس نِّي إِي نتْرَاجَا. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />صنّط مْلِيح آ ونِّي يتْسْڒَان.<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />خ مَانَايَا وِي ذِي غَا شَابّْهغ يوْذَان ن ڒْوقْث-أَ؟ نِثْنِي اَم شَا ن يحنْجِيرن إِي يقِّيمن ذِي سَحَا تْڒَاغَان إِ وَايَاوْيَا قَّارن: <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />نتْصُوْض ذِي ثمْجَا،<note caller="+" style="f"><char style="fr" closed="false">11‏.17 </char><char style="ft" closed="false">ثَمْجَا نتَّاث ذ ثَشبَّابْث.</char></note> وَار ثشْضِيحم شَا. نتْعزَّا-كنِّيو، وَار ثتْرُوْم شَا. <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />مِينْزِي يَحْيَى يُوْسَا-د يتْࢲُوْمَّا وَار يسسّ <char style="it">اَمَان ن وضِيڒ</char>، نَّان اَقَا ذَايس جْنُوْن! <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />يُوْسَا-د مِّيس ن بْنَاذم يتتّ يسسّ <char style="it">وَار يتْࢲُوْمِّي شَا</char>، نَّان قَا وَانِيتَا يتتّ يسسّ اَطَّاس، عَاوذ نتَّا ذ اَمدُّوْكڒ ن يعشَّارن ذ يِنِّي يعصَّان. إِنَّمَا، ڒفْهَامث ن أَربِّـي قبّْڒن-تث مَارَّا يِنِّي يفهّْمن."<note caller="+" style="f"><char style="fr" closed="false">11‏.19 </char><char style="ft" closed="false">لْأَيَا-يَا س ثَيُوْنَانِيث ثُوْسَا-د اَمُّو س ڒْحَرْف: ڒخْذَايم ن ڒفْهَامث تِيشّنْت-اَس ڒْحَقّ إِ ڒفْهَامث نِّي.</char></note><verse eid="MAT 11:19" /></para>
  <para style="s">ثِندَّام يكفَّارن</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />سّنِّي يبْذَا عِيْسَى يتْعيَّاب ثِندَّام نِّي إِي ذِي يݣَّا اَطَّاس ن لْمُعْجِزَاث نّس، وَار تُوْبن شَا اَيثْبَاب نْسنْت. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" /><char style="it">ينَّا عِيْسَى</char>: "يَا ڒفْضِيحث نّش يَا أَبِيلَاج ن كُوْرَزِيم! يَا ڒفْضِيحث نّش يَا أَبِيلَاج ن بَيْت صَيْدَا! مَعْلِيك لْمُعْجِزَاث-أَ إِي ذَايْوم يوقْعن، وقْعنْت ذِي <char style="it">ثْندَّام ثِعفَّانِين ن</char> صُوْر ذ صَيْدَا، أَتَاف اَيثْبَاب نْسنْت تُوْبن مشْحَاڒ زݣ وَامِي، ئِڒِي ݣِّين اَرُّوْض ن لْحُزن قِّيمن خ يِيغّذ<note caller="+" style="f"><char style="fr" closed="false">11‏.21 </char><char style="ft" closed="false">ئِغّذ نتَّا ذ ثْنِيفسْث.</char></note> <char style="it">حمَا اَذ د تْبَان تُوْبَا نْسن</char>. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />خ مَانَاينِّي اَذَاوم ينِيغ: أَقَا <char style="it">ثِندَّام ثِعفَّانِين نِّي ن</char> صُوْر ذ صَيْدَا اَذ يڒِينْت حْسن زَّايْوم ذِي يُوْم لْحِسَاب ذ لْعِقَاب. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />ئِي شك آي اَبِيلَاج ن كَفرْنَاحُوْم! مَا تْغِير-اَش اَذ تݣَعّْذذ غَار وجنَّا؟ لَّا، قَا شك اَذ تهْوِيذ غَار لْجَحِيم. ڒَاحقَّاش لْمُعْجِزَاث نِّي إِي ذَايش يوقْعن، مْڒِي وقْعنْت ذِي <char style="it">ثنْدِينْت ثَعفَّانْت نِّي ن</char> سَادُوْم، إِڒِي عَاذ اَقَات ذ ثَنْدِينْت اَڒ نْهَارَا. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />خ مَانَاينِّي اَذَاوم ينِيغ: أَقَا <char style="it">ثَنْدِينْت ثَعفَّانْت نِّي ن</char> سَادُوْم اَذ تِيڒِي حْسن زَّايش ذِي يُوْم لْحِسَاب ذ لْعِقَاب!"<verse eid="MAT 11:24" /></para>
  <para style="s">أَرَّاحث إِ يِنِّي يُوْحْڒن</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />ڒخْدّنِّي يسِّيوڒ عِيْسَى ينَّا: "حمْذغ-شك آ بَابَا آ سِيذِي أَربِّـي ن وجنَّا ذ ثْمُوْرْث ڒَاحقَّاش ثسْنُوْفَّرذ مَانَايَا خ يمِيغِيسن ذ لْعُلَمَا، ثْسظْهَارذ-ث-يد إِ يحنْجِيرن يمزْيَانن. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />وَاه آ بَابَا، ڒَاحقَّاش اَمُّو إِي خَاك يَارْضَا.<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />ئِمُّوْش-ٱيِي كُڒْشِي زِي بَابَا. وَار يسِّين حَدّ مِين يعْنَا مِّيس منْغِير بَابَاس. وَار يسِّين حَدّ مِين يعْنَا بَابَاس منْغِير مِّيس. بَابَاس، أَث سّْنن غِير يِنِّي ؤُمِي يخس مِّيس اَذَاسن ثِيذ يسْمظْهَار.<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />آ يِيْن يُوْحْڒن س دْقڒ إِي ثَرْبُوْم، أَرَحم-د غَارِي مَارَّا كنِّيو نش اَكنِّيو سْريّْحغ. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />اَرْبُوْث خَاوم ثْزَايْڒُوْت<note caller="+" style="f"><char style="fr" closed="false">11‏.29 </char><char style="ft" closed="false">ثزَايْڒُوْت نتَّاث ذ ثْزَاݣْرُوْت. تݣّن-تث خ يِيرَاون ن يفُوْنَاسن ذِي زْمَان شرّْزن زَّايس. قَّارن-اَس عَاوذ ثَغْوَاوْث.</char></note> ينُو، ڒمْذث زَّايِي ڒَاحقَّاش نش ذ اَصبَّار، وَار ذَايِي بُو تَّكبُّر. ڒخْدّنِّي اَذ تَافم أَرَّاحث إِ يِيخف نْوم. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />ڒَاحقَّاش مڒَا ثَرْبُوْم ثْزَايْڒُوْت ينُو نتَّاث اَقَا ثهْوَان، دْقڒ ينُو يفْسُوْس.<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">مِين يدْجَان حَلَال ذِي نْهَار ن سّبْث ن لْعِبَادَا</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />ذݣ وُوْسَّان نِّي ذِي نْهَار ن سّبْث ن لْعِبَادَا يعْذُو عِيْسَى ذݣ وبْرِيذ ذِي ڒْوسْط ن يمنْدِي، ئِمحْضَارن نّس دْجُوْزن ݣُّوْرن تكّْسن ثِيْذرِين تتّن-ثنْت. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />وَامِي ثن ࢲْرِين شَا ن يِوْذَان زِي ڒْحِزب ن يفَرِّيسِيْين نَّان-اَس إِ عِيْسَى: "خْزَر! ئِمحْضَارن نّش تݣّن مِين يدْجَان حْرَام ذِي نْهَار ن سّبْت ن لْعِبَادَا."<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: "مَا وَار ثغْرِيم شَا مِين يݣَّا دَاود وَامِي تُوْغَا يدْجُوْز نتَّا ذ يِنِّي اَكِذس؟ <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />يُوْذف غَار ثمْزِيذَا ن أَربِّـي يُوْفَا ذِنِّي اَغْرُوْم نِّي إِي يدْجَان ذ صّذْقث يشِّي-ث نتَّا ذ يِنِّي إِي كِذس؛ وَاخَّا مَانَاينِّي وَار يدْجِي شَا حَلَال غِير إِ ڒْفُقَهَا وَاهَا. <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />نِغ وَار ثغْرِيم شَا ذِي شَّرِيعَا ن مُوْسَى بلِّي ڒْفُقَهَا تْخَاڒَافن زَعْمَا نْهَار ن سّبْث ن لْعِبَادَا ذِي ثمْزِيذَا ن أَربِّـي بْڒَا مَا ثن يحَاسّب حَدّ؟ <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />قَّارغ-اَوم: ذَانِيتَا ذِنِّي يجّن كْتَار زِي ثمْزِيذَا ن أَربِّـي. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />مْڒِي ثْفهْمم ڒْمَعْنَا ن وَاوَاڒ-أَ إِي يقَّار أَربِّـي: &lt;خْسغ اَذ ترحْمم يوْذَان، وَار خْسغ شَا اَذ تْغَرْصم إِ ڒبْهَايم&gt;،<note caller="+" style="f"><char style="fr" closed="false">12‏.7 </char><char style="ft" closed="false">خْزَر هُوْشَع 6:​6.</char></note> أَتَاف وَار ثْحكّْمم شَا خ يِنِّي وَار يݣِّين مِينْخف. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />ڒَاحقَّاش مِّيس ن بْنَاذم إِݣ يدْجَان ذ لْحَاكم خ نْهَار ن سّبْث."<verse eid="MAT 12:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />يُوْيُور سّنِّي عِيْسَى، يُوْذف غَار يِجّن ن ثمْزِيذَا ن أَيث-إِسْرَائِيل. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />يُوْفَا ذِنِّي يجّن ن ورْيَاز فُوْس نّس يمُّوْث. ڒخْدّنِّي سّقْسَان عِيْسَى رزُّوْن اَث تَاهْمن نَّان-اَس: "مَا حَلَال اَذ تسْݣنْفِيذ شَان يِجّن ذِي نْهَار ن سّبْت ن لْعِبَادَا مَا لَّا؟"<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />ينَّا-ٱسن عِيْسَى: "مڒَا شَان يِجّن زَّايْوم غَارس يج وحُوْڒِي يوْضَا-يَاس ذِي ثْسْرَافْث ذِي نْهَار ن لْعِبَادَا، مَا ثِيذ يطّف اَثِيذ يسِيڒِي مَا لَّا؟ <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />إِيوَا بْنَاذم يسݣّْوَا اَطَّاس س وَاطَّاس زݣ يِج وحُوْڒِي! عْلَاحْسَاب مَانَايَا حَلَال اَذ تݣّذ ڒْخِير ذِي نْهَار ن لْعِبَادَا." <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />ڒخْدّنِّي ينَّا-ٱس عِيْسَى إِ لْمُعَاق نِّي: "سَرّح فُوْس نّش." ئِسَرّح-يث أُوْشَا يذْوڒ وفُوْس نّس يݣنْفَا، مْلِيح اَم وفُوْس نّغْنِي. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />فّْغن يِوْذَان ن ڒْحِزب ن يفَرِّيسِيْين شِيطّْنن جَارَاسن مَامّش غَا ݣّن اَذ نْغن عِيْسَى.<verse eid="MAT 12:14" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يتْوَاجَاه يِنِّي يدْجَان ضد نّس</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />ئِسّن عِيْسَى مَانَاينِّي يُوْيُوْر سّنِّي. ذْفَارن-ث اَبرُّو ن يِوْذَان، ئِسْݣنْفَا مَارَّا يمهْڒَاش نْسن. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />ئِوصَّا-ثن ينَّا-ٱسن وَار تْخبَّارم حَدّ خَافِي. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />مَانَايَا حمَا اَذ يفّغ وَاوَاڒ إِي ينَّا سِيذِي أَربِّـي إِ نَّبي إِشَعْيَا ذݣ يِجّن ن زْمَان:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />&lt;ذ وَانِيتَا ذ اَخدَّام ينُو إِݣ يخْضَرغ،</para>
  <para style="q2" vid="MAT 12:18">ونِّي إِي خَافِي يعِيزّن إِي خف اَرْضِيغ.</para>
  <para style="q1" vid="MAT 12:18">أَذَايس ݣّغ أَرُّوْح يقدّْسن،</para>
  <para style="q2" vid="MAT 12:18">أَذ يخبَّار يِنِّي زِي ڒݣْنُوْس س ڒْحَقّ.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />وَار يتْمنْغِي اَك حَدّ،</para>
  <para style="q2" vid="MAT 12:19">وَار يسْنكَّر بُو ثْغُويِّيث،</para>
  <para style="q1" vid="MAT 12:19">وَار يتْسْڒِي حَدّ إِ وَاوَاڒ نّس ذݣ يبْرِيذن.<verse eid="MAT 12:19" /></para>
  <para style="q2">
    <verse number="20" style="v" sid="MAT 12:20" />وَار يتْرزِّي بُو غَانِيم يميّْڒن،</para>
  <para style="q1" vid="MAT 12:20">وَار يسخْسَاي ثْفَاوْث ن ثفْثِيڒْت يتݣّن دّخَّان،</para>
  <para style="q2" vid="MAT 12:20">أَڒ غَا يرْبح ڒْحَقّ.<verse eid="MAT 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21" />ذݣ يِيسم نّس ڒݣْنُوْس اَذ ݣّن لْأَمَال.&gt;<note caller="+" style="f"><char style="fr" closed="false">12‏.21 </char><char style="ft" closed="false">خْزَر إِشَعْيَا 42‏:1‏-4.</char></note><verse eid="MAT 12:21" /></para>
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />سّنِّي شَان يِوْذَان ؤُوِين-اَس-د إِ عِيْسَى يجّن ن ورْيَاز ذ اَضَرْغَاڒ ذ اَزيْنُوْن ذَايس جّنّ. ئِسْݣنْفَا-ث عِيْسَى حمَا اَذ يسِّيوڒ اَذ يتْوَاڒَا. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />قِّيمن ڒْغَاشِي نِّي تْعجّْبن مَارَّا نَّان: "مَاشِي ذ وَانِيتَا إِݣ يدْجَان ذ مِّيس ن دَاود نِغ؟"<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />تسْڒَان ڒْحِزب ن يفَرِّيسِيْين إِ وَاوَاڒ نْسن نَّان-اَسن: "بْنَاذم-أَ يسُوْفُوْغ جْنُوْن مِينْزِي اَرَّايس ن جْنُوْن ؤُمِي قَّارن بْعَلْزَبُوْل يُوْش-اَس جّْهذ-أَ."<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />ئِسّن عِيْسَى مِين نْوَان ينَّا-ٱسن: "مْكُڒ لْممْلَكَا إِي ذِي تْمنْغَان أَيثْبَاب نّس يجّن اَك ونّغْنِي اَذ تْنهْذم. مْكُڒ ثَنْدِينْت نِغ ذ ثَدَّارْث إِي ذِي تْمنْغَان اَيثْبَاب نّس يجّن اَك ونّغْنِي وَار ثْزمَّر اَذ تقِّيم. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />مڒَا شِّيطَان يسُوْفُوْغ شِّيطَان، أَتَاف اَذ يقْضَا خ يِيخف نّس. مَامّش غَا ثݣّ اَذ تقِّيم لْممْلَكَا نّس؟ <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />نش مڒَا سُوْفُوْغغ جْنُوْن س جّْهذ ن بْعَلْزَبُوْل نِّي زَعْمَا، ئِنِيم-اَيِي كنِّيو مَامّش تݣّن يِوْذَان نْوم سُوْفُوْغن-ثن ؤُڒَا ذ نِثْنِي؟ نِثْنِي س يِيخف نْسن تْبيَّانن بلِّي كنِّيو وَار غَارْوم بُو ڒْحَقّ ذِي مِين ثقَّارم. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />نش، مڒَا سُوْفُوْغغ جْنُوْن س أَرُّوْح ن أَربِّـي، أَقَا ڒْمُلْك ن أَربِّـي يُوْسَا-د غَارْوم. <verse eid="MAT 12:28" /><verse number="29" style="v" sid="MAT 12:29" />إِيوَا مَامّش؟ وَار يزمَّر حَدّ اَذ يهْجم خ ثدَّارْث ن شَان يِجّن يجْهذ بَاش اَذ يَاشَار اَݣْڒَا نّس إِلَّا مڒَا يشدّ-يث ذ اَمزْوَارُو. أُوْشَا اَذَاس يَاوِي مَارَّا مِين غَارس ذِي ثدَّارْث.<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />ونِّي وَار كِذِي يدْجِين شَا، أَتَاف اَقَاث ضد ينُو. ونِّي وَار كِذِي يسْمُوْنن، أَتَاف نتَّا يتْزدْجَاع. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />أَقَا قَّارغ-اَوم: أَذ تْوَاغْفَرنْت مَارَّا ڒْمُعْصِيَاث إِي تݣّن يِوْذَان ذ كُڒ اَوَاڒ نِّي وَار يحْڒِين إِي قَّارن خ أَربِّـي. وَلَكِن ونِّي غَا يِينِين شَان وَاوَاڒ وَار يحْڒِين خ أَرُّوْح يقدّْسن، أَتَاف وَار ذَاس يغفَّر شَا. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />ونِّي غَا يِينِين شَان وَاوَاڒ وَار يحْڒِين خ مِّيس ن بْنَاذم، أَتَاف اَخَاس يغْفَر. وَلَكِن ونِّي غَا يِينِين شَان وَاوَاڒ وَار يحْڒِين خ أَرُّوْح يقدّْسن، أَتَاف وَار خَاس يغفَّر شَا لَّا ذِي دُّنشْت-أَ أُو لَّا ذِي لْأَخِيرَا.<verse eid="MAT 12:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />مڒَا ثَشجَّارْث ذ ثَصبْحَانْت، أَتَاف اَذ تَارو مِين يدْجَان ذ اَصبْحَان. مڒَا ثَشجَّارْث ذ ثَعفَّانْت، أَتَاف اَذ تَارو مِين يدْجَان ذ اَعفَّان. ثَشجَّارْث ثْظهَّار-د س مِين تَارو. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />آ ثَارْوَا يفِيغرَان، مَامّش غَا ثݣّم اَذ تِينِيم اَوَاڒ اَصبْحَان أُو كنِّيو ذ يعفَّانن؟ ڒَاحقَّاش اَقمُّوْم ن بْنَاذم يسَّاوَاڒ مِين يدْجَان ذݣ وُوْڒ نّس. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />بْنَاذم اَصبْحَان يسُوْفُوْغ-د مِين يدْجَان ذ اَصبْحَان زِي ڒْكنْز اَصبْحَان ن وُوْڒ نّس. بْنَاذم اَعفَّان يسُوْفُوْغ-د مِين يدْجَان ذ اَعفَّان زِي ڒْكنْز اَعفَّان ن وُوْڒ نّس.<verse eid="MAT 12:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 12:36" />أَذَاوم ينِيغ: أَقَا يُوْم لْحِسَاب ذ لْعِقَاب اَذ تْوَاحَاسْبن يِوْذَان خ مْكُڒ اَوَاڒ يخْوَان إِي سِّيوْڒن. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />ڒَاحقَّاش عْلَاحْسَاب اَوَاڒن نّش اَقَاش بَرِيء نِغ عْلَاحْسَاب اَوَاڒن نّش اَذ تْوَاعقّْبذ."<verse eid="MAT 12:37" /></para>
  <para style="s">لْعَلَامَا ثَمقّْرَانْت ن سِيذْنَا يُوْنس</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />ڒبْعَاض ن يمْسڒْمَاذن ن شَّرِيعَا ذ ڒْحِزب ن يفَرِّيسِيْين نَّان-اَس إِ عِيْسَى: "آ لْمُعَلِّم، نخْس أَ نْࢲر يجّن ن لْعَلَامَا ذ ثَمقّْرَانْت زَّايك."<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: "ئِوْذَان يعفَّانن ن ڒْوقْث-أَ يخدّْعن أَربِّـي رزُّوْن لْعَلَامَا. ينَّا-ٱسن: لَّا، وَار ذَاسن يتْمُوْشِّي إِلَّا لْعَلَامَا نِّي ن نَّبِي يُوْنس. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />أَمش يسعْذُو يُوْنس ثڒْتِيَّام جَار دْجِيَاڒِي ذ وُوْسَّان ذݣ وعدِّيس ن وسْڒم اَمقّْرَان، أَمنِّي إِي غَا يسعْذُو مِّيس ن بْنَاذم ثڒْتِيَّام جَار دْجِيَاڒِي ذ وُوْسَّان ذݣ وعدِّيس ن ثْمُوْرْث. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />يُوْم لْحِسَاب ذ لْعِقَاب اَذ د كَّرن يمزْذَاغ ن ثنْدِينْت ن نِينْوَى اَك يِوْذَان ن ڒْوقْث-أَ اَخَاسن شثْشَان، ڒَاحقَّاش اَيثْبَاب ن ثنْدِينْت ن نِينْوَى تُوْبن وَامِي ثن ينْهَا نَّبِي يُوْنس. أُو ذَانِيتَا يجّن ذ اَمقّْرَان زِي يُوْنس. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />يُوْم لْحِسَاب ذ لعِقَاب، أَذ تكَّر لْمَلِكَا ن لْجَنُوْب اَك يِوْذَان ن ڒْوقْث-أَ اَخَاسن ثْشثْشَا، ڒَاحقَّاش ثُوْسَا-د نتَّاث زِي ثْمُوْرْث يُوْݣْجن حمَا اَذ تْصنّط إِ ڒفْهَامث ن سُلِيمَان. أُو ذَانِيتَا يجّن ذ اَمقّْرَان زِي سُلِيمَان.<verse eid="MAT 12:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />شُوْف، خْمِي غَا يتْوَاسُوْفغ جّنّ اَعفَّان زِي شَان بْنَاذم، أَتَاف اَذ يݣُّوْر ذݣ يمُوْشَان يُوْزْغن يرزُّو اَمْشَان مَانِي غَا يريّح. مڒَا وَار يُوْفِي شَا، <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />أَتَاف اَذ يِينِي اَقَا نش اَذ رَاحغ اَذ ذوْڒغ غَار ثدَّارْث ينُو مَانِيس إِي فّْغغ. سّنِّي اَغَارس يذْوڒ اَت يَاف ثخْوَا، ثعْذڒ، ثنْقَا. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />أُوْشَا اَذ يرَاح اَذ د يَاوِي سبْعَا ن جْنُوْن نّغْنِي ذ يعفَّانن كْتَار زَّايس حمَا اَذ ذوْڒن كُڒْشِي اَذَايس زذْغن. أَتَاف اَذ تِيڒِي لْحَالَا ثَنݣَّارُوْت ن بْنَاذم نِّي ذ ثَعفَّانْت كْتَار زِي لْحَالَا نّس ثَمزْوَارُوْت. أَمنِّي إِي ذَاسن غَا ثوْقع إِ يِوْذَان يعفَّانن ن ڒْوقْث-أَ."<verse eid="MAT 12:45" /></para>
  <para style="b" />
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />عَاذ يسَّاوَاڒ عِيْسَى اَك ڒْغَاشِي وَامِي غَارس د تُوْسَا يمَّاس ذ أَيثْمَاس، بدّن بَارَّا <char style="it">إِ ثدَّارْث</char> رزُّوْن اَكِذس سِّيوْڒن. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />ينَّا-ٱس شَان يِجّن إِ عِيْسَى: "أَقَا يمَّاش ذ أَيثْمَاش بدّن غَار بَارَّا رزُّوْن اَكِذش سِّيوْڒن."<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />ئِنْدق-د عِيْسَى ينَّا-ٱس إِ ونِّي إِي كِذس يسِّيوْڒن: "مِين عْنَان يمَّا ذ أَيثْمَا؟" <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />ئِسْوِيࢲذ س وفُوْس نّس غَار يمحْضَارن نّس ينَّا: "أَقَا يمَّا ذ أَيثْمَا." <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" /><char style="it">ينَّا-ٱس:</char> "ونِّي يتݣّن س مِين يخس بَابَا إِي يدْجَان ذݣ وجنَّا، أَتَاف نتَّا ذ ؤُمَا ذ ؤُتْشْمَا ذ يمَّا."<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">ڒْمَعْنَا ن ونِّي يزرّْعن</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />نْهَار نِّي، ئِفّغ عِيْسَى زِي ثدَّارْث يقِّيم طَّارْف ن ڒبْحَر. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />مُوْنن-د خَاس اَطَّاس ن ڒْغَاشِي. س زْحَامث نِّي يرُوْح ينْيَا ذݣ يِجّن ن ثْغَرَّابُوْت يقِّيم ذَايس. ئِوْذَان قِّيمن مَارَّا خ شّطّ ن ڒبْحَر. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />ئِقَّار-اَسن اَطَّاس ن ثْمسْڒَايِين س ڒمْعَانِي ينَّا-ٱسن: "<char style="it">صنّْطث! </char> ئِفّغ وفدْجَاح اَذ يزْرع. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />وَامِي يزرّع، ثوْضَا-يَاس شَان زَّرِّيعث خ طَّارْف ن وبْرِيذ، ؤُسِين-د يجْضَاض شِّين-تث. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />شَان زَّرِّيعث ثوْضَا-يَاس جَار يِزْرَا وَار ذِنِّي بُو شَاڒ اَطَّاس. ثغْمِي-د ذغْيَا ڒَاحقَّاش وَار ثُوْدْجِيغ شَا ذِي ثْمُوْرْث اَطَّاس. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />وَلَكِن وَامِي ثْسُوْمَّر ثْفُوْشْت، ثْنزْڒف ڒخْدّنِّي ثِيْسْرَاو ڒَاحقَّاش يࢲوْرَان نّس وَار ؤُوْثِين شَا غَار ڒَادْجغ ن ثْمُوْرْث. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />شَان زَّرِّيعث ثوْضَا جَار يسنَّانن. غْمِين-د اَكِس يسنَّانن نِّي جيّْفن-تث. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />وَلَكِن شَان زَّرِّيعث ثوْضَا خ ثْمُوْرْث ثَصبْحَانْت، ثݣَّا ثِيْذرِين. ڒبْعَاض ݣِّينْت مِيَّا، ڒبْعَاض ݣِّينْت ستِّين، ڒبْعَاض ݣِّينْت ثْڒَاثِين. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />صنّط مْلِيح آ ونِّي يتْسْڒَان."<verse eid="MAT 13:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />قَارّْبن-د غَارس يمحْضَارن نّس نَّان-اَس: "مَايمِّي إِي كِسن ثسَّاوَاڒذ س ڒمْعَانِي؟" <verse eid="MAT 13:10" /><verse number="11" style="v" sid="MAT 13:11" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: "ئِتْوَاسْمح إِ كنِّيو اَذ تسّْنم مِين ينُوْفَّارن ذِي ڒْمُلْك وجنَّا. وَلَكِن نِثْنِي لَّا، وَار ذَاسن يتْوَاسْمح شَا. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />ڒَاحقَّاش ونِّي يدْجَان غَارس يتْمَارْنِي-يَاس، أَغَارس يِيڒِي اَطَّاس. وَلَكِن ونِّي وَار غَار يدْجِي شَا، ئِتْوَاكْسِي-يَاس ؤُڒَا ذ مِين غَارس. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />خ مَانَايَا إِي كِسن سَّاوَاڒغ س ڒمْعَانِي. وَاخَّا خزَّرن، وَار تْوِيڒِين شَا. وَاخَّا تسْڒَان، وَار تسْڒِين شَا وَار فهّْمن إِ شَا. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />أَمنِّي إِي ذَاسن يتْكمَّاڒ وَاوَاڒ ن نَّبِي إِشَعْيَا إِݣ ينَّا ذݣ يِجّن ن زْمَان:</para>
  <para style="q1" vid="MAT 13:14">&lt;شْحَاڒ مَا تسْڒِيم وَار تفْهِيمم،</para>
  <para style="q2" vid="MAT 13:14">شْحَاڒ مَا ثْخزَّرم وَار تْوِيڒِيم.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />ڒَاحقَّاش شَّعْب-أَ، ؤُڒ نّس يذْوڒ اَم وزْرُو،</para>
  <para style="q2" vid="MAT 13:15">عْڒَاين وَار تسْڒِين وَالُو،</para>
  <para style="q1" vid="MAT 13:15">قّْنن ثِيطَّاوِين نْسن.</para>
  <para style="q2" vid="MAT 13:15">حمَا وَار تْوِيڒِين شَا س ثِيطَّاوِين نْسن،</para>
  <para style="q1" vid="MAT 13:15">وَار تسْڒِين شَا س يمجَّان نْسن،</para>
  <para style="q2" vid="MAT 13:15">وَار فهّْمن شَا س وُوْڒَاون نْسن،</para>
  <para style="q1" vid="MAT 13:15">أَغَارِي د ذوْڒن، أَثن سْݣنْفِيغ.&gt;<note caller="+" style="f"><char style="fr" closed="false">13‏.15 </char><char style="ft" closed="false">خْزَر إِشَعْيَا 6‏:9‏-10.</char></note><verse eid="MAT 13:15" /></para>
  <para style="b" />
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />وَلَكِن سَّعْذ نْوم كنِّيو وَامِي ثِيطَّاوِين نْوم تْوَاڒَانْت، سَّعْذ نْوم وَامِي يمجَّان نْوم تسْڒَان. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />أَقَا تسْڒَام ڒْحَقّ: أَطَّاس ن لْأَنْبِيَا ذ ڒْمُوْمِنِين رْزُوْن اَذ ࢲرن مِين تْوَاڒَام، وَلَكِن وَار ث ࢲْرِين شَا. رْزُوْن اَذ سْڒن مِين تسْڒَام، وَلَكِن وَار ث سْڒِين شَا.<verse eid="MAT 13:17" /></para>
  <para style="s">أَسْفْهم ن ڒْمَعْنَا ن ونِّي يزرّْعن</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />إِيوَا صنّْطث ڒْمَعْنَا ن وفدْجَاح نِّي يزرّْعن. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />ئِجّن يتْسْڒَا إِ وَاوَاڒ خ ڒْمُلْك وجنَّا وَار ث يتفْهِيم شَا. يعْنِي نتَّا اَم زَّرِّيعث نِّي إِݣ يوْضَان خ وبْرِيذ. ئِتْرَاح وعفَّان نِّي <char style="it">ن إِبْڒِيس</char>، يتكّس اَوَاڒ نِّي يتْوَازرْعن ذَايس ذݣ وُوْڒ. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />زَّرِّيعث نِّي إِݣ يوْضَان جَار يِزْرَا نتَّاث اَم شَان بْنَاذم إِݣ يتْسْڒَان إِ وَاوَاڒ ن أَربِّـي يقْبڒ-يث س ڒفْرَاحث. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />وَامِي وَار يُوْوْثِي بُو يࢲوْرَان مْلِيح ذغْيَا تْنقْڒَاعن. خْمِي د تَاسنْت شَان ڒمْحَاين نِغ ذ شَان وعدّب خ سَّبَاب ن وَاوَاڒ ن أَربِّـي، ذغْيَا يتفّغ اَبْرِيذ. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />زَّرِّيعث نِّي إِݣ يوْضَان جَار يسنَّانن نتَّاث اَم يِجّن ن بْنَاذم إِي يتْسْڒَان إِ وَاوَاڒ ن أَربِّـي ذَايس اَمْنُوْس ن دُّنشْت، يشمّث-يث طّْمَع ن وَاݣْڒَا، سّنِّي يتْوَاجيّف وَاوَاڒ ن أَربِّـي وَار ينفّع شَا. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />وَلَكِن زَّرِّيعث نِّي إِݣ يوْضَان ذِي ثْمُوْرْث ثَصبْحَانْت نتَّاث اَم شَان بْنَاذم إِݣ يتْسْڒَان إِ وَاوَاڒ ن أَربِّـي، ئِفهّم-اَس يتَارو. ئِجّن يتَارو مِيَّا، ئِجّن ستِّين، ئِجّن ثْڒَاثِين."<verse eid="MAT 13:23" /></para>
  <para style="s">ڒْمَعْنَا ن يسنَّانن</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />ئِسِّيوڒ عِيْسَى س يِجّن ن ڒْمَعْنَا نّغْنِي ينَّا-ٱسن: "ڒْمُلْك وجنَّا يݣَّا اَم يِجّن ن ورْيَاز يزْرع زَّرّيعث ثَصبْحَانْت ذݣ ومَرْجع نّس. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" /><char style="it">ئِجّن ن دْجِيڒث</char> وَامِي طّْصن مَارَّا يوْذَان، يُوْسَا-د ڒَعْذُو نّس يزْرع زَّرِّيعث ن يسنَّانن اَك زَّرِّيعث نِّي ن يِرْذَان ڒخْدّنِّي يَرْوڒ. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />وَامِي د ݣَعّْذن يِرْذَان ݣِّين ثِيْذرِين، ڒخْدّنِّي ݣَعّْذن-د اَكِذْسن ؤُڒَا ذ يسنَّانن. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />ؤُسِين-د يخدَّامن نَّان-اَس إِ بَاب ن ومَرْجع: آ سِيذِي، شك ثْزرْعذ زَّرِّيعث ثَصبْحَانْت ذݣ ومَرْجع نّش. إِيوَا مَانِيس ذَاس د كِّين يسنَّانن-أَ؟ <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />ينَّا-ٱسن: شَان ڒَعْذُو إِݣ يݣِّين مَانَايَا. نَّان-اَس يخدَّامن نّس: مَا ثخْسذ أَ نْرَاح أَ نكّس يسنَّانن-أَ؟ <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />ينَّا-ٱسن: لَّا، بَاش وَار كِذْسن ثْقدْجْعم شَا ؤُڒَا ذ يرْذَان. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />اجّث يرْذَان اَذ مغَرن اَك يسنَّانن. أَخْمِي د غَا يَاوض ڒْوقْث ن ومْجَار اَذَاسن ينِيغ إِ يشوَّارن: اكّْسث يسنَّانن ذ اَمزْوَارُو سْمُوْنم-ثن شدّم-ثن حمَا اَذ حَرْقن. وَلَكِن يرْذَان جمْعم-ثن اَوِيم-ثن غَار ثسْرَافِين ينُو."<verse eid="MAT 13:30" /></para>
  <para style="s">ڒمْعَانِي ن زَّرِّيعث ن بُوْݣَرْذَاڒ ذ ونْتُوْن<note caller="+" style="f"><char style="fr" closed="false">13‏.31 </char><char style="ft" closed="false">أَنْتُون نتَّا ذ اَمْثُون.</char></note></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />ينَّا-ٱسن عِيْسَى يجّن ن ڒْمَعْنَا نّغْنِي: "ڒْمُلْك وجنَّا يݣَّا اَم يِجّن ن زَّرِّيعث ن يِجّن ن نُّوْع ن اَرْبِيع قَّارن-اَس بُوْݣَرْذَاڒ. ييْسِي-ت يجّن ن ورْيَاز يࢲُّو-ت ذݣ ومَرْجع نّس. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />تِيڒِي نتَّاث ذ ثَمزْيَانْت قَاع خ مَارَّا ثِحبَّا. وَلَكِن خْمِي تمْغَر ثْذوّڒ كْتَار زِي مَارَّا اَرْبِيع. ثْذوّڒ ذ ثَشجَّارْث، تَاسن-د يِجْضَاض تݣّن ذَايس ڒَعْوَاش نْسن."<verse eid="MAT 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />ينَّا-ٱسن عِيْسَى يجّن ن ڒْمَعْنَا نّغْنِي: "ڒْمُلْك وجنَّا اَم ؤُنْتُوْن ثيْسِي-ث يِجّن ن ثمْغَارْث ثُوْݣّْوَا زَّايس ڒْمُوْدّ ن وَارن، أَنْتُوْن نِّي يسْݣَعّذ-يث-يذ مَارَّا."<verse eid="MAT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />قَاع مَانَايَا ينَّا-ث عِيْسَى إِ يِوْذَان س ڒمْعَانِي. وَار كِذْسن يسِّيوِيڒ إِلَّا س ڒمْعَانِي وَاهَا. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />حمَا اَذ يكمّڒ وَاوَاڒ إِي ينَّا سِيذِي أَربِّـي إِ نَّبي <char style="it">إِشَعْيَا</char> ذݣ يِجّن ن زْمَان:</para>
  <para style="q2" vid="MAT 13:35">&lt;أَكِسن سِّيوْڒغ س ڒمْعَانِي،</para>
  <para style="q1" vid="MAT 13:35">أَذ سخْبَرغ مِين ينُّوْفَّرن زݣ وَامِي ثدْجَا دُّنشْت.&gt;"<note caller="+" style="f"><char style="fr" closed="false">13‏.35 </char><char style="ft" closed="false">خْزَر زَّبُور 78‏:2.</char></note><verse eid="MAT 13:35" /></para>
  <para style="s">أَسْفْهم ن ڒْمَعْنَا ن يسنَّانن</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />يجَّا عِيْسَى ڒْغَاشِي نِّي يُوْذف غَار ثدَّارْث. ڒخْدّنِّي ؤُسِين-د غَارس يمحْضَارن نّس نَّان-اَس: "فسّر-اَنغ ڒْمَعْنَا ن يسنَّانن ذݣ ومَرْجع."<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: "ونِّي يزرّْعن زَّرِّيعث ثَصبْحَانْت نتَّا ذ مِّيس ن بْنَاذم. <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />أَمَرْجع نتَّا ذ دُّنشْت. زَّرِّيعث ثَصبْحَانْت نتَّاث ذ ثَارْوَا ن ڒْمُلْك وجنَّا. ئِسنَّانن نِثْنِي ذ ثَارْوَا ن وعفَّان نِّي <char style="it">ن إِبْڒِيس</char>. <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />ڒَعْذُو إِݣ يزرّْعن يسنَّانن نتَّا ذ إِبْڒِيس. ڒْوقْث ن ومْجَار نتَّاث ذ ڒفْنَا ن زْمَان. ئِخدَّامن نِثْنِي ذ لْمَلَائِكَاث. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />أَمشْنَاو مَامّش يسْمُوْن وفدْجَاح يسنَّانن يسْحرّق-يثن ذِي ثْمسِّي، أَمنِّي إِي غَا ثِيڒِي ڒفْنَا ن زْمَان. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />أَذ د يسّكّ مِّيس ن بْنَاذم لْمَلَائِكَاث نّس، أَذ كّْسنْت زِي ڒْمُلْك نّس مَارَّا مِين يتْسبَّابن ذِي ڒْمُعْصِيَاث ذ يِنِّي يتݣّن شَّرّْ. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />أَثن نْضَرن ذِي ڒْكُوْشث ن ثْمسِّي مَانِي غَا يڒِين يمطَّاون ذ وغࢲَّاࢲ ن ثغْمَاس. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />وَلَكِن ڒْمُوْمِنِين اَذ شْعشْعن اَم ثْفُوْشْت ذِي ڒْمُلْك ن بَابَاثْسن. صنّط مْلِيح آ ونِّي يتْسْڒَان.<verse eid="MAT 13:43" /></para>
  <para style="s">ڒمْعَانِي ن ڒْكنْز ذ جُّوْهَر ذ ثْرَاشَّا</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />ڒْمُلْك وجنَّا اَمشْنَاو يجّن ن ڒْكنْز يخْزن ذِي شَان ومَرْجع، يُوْفِي-ث شَان حَدّ يعَاوذ يسْنُوْفَّر-يث. أُوْشَا س ڒفْرَاحث نِّي إِي ذَايس، يزّنْز مَارَّا مِين غَارس يسْغَا اَمَرْجع نِّي.<verse eid="MAT 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />ڒْمُلْك وجنَّا اَمشْنَاو يجّن ن تَّاجَر إِي يرزُّو خ جُّوْهَر اَصبْحَان. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />وَامِي يُوْفَا يجّن ن جُّوْهَر يغْڒَان، ئِزّنْز مَارَّا مِين غَارس يسْغِي-ث.<verse eid="MAT 13:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />ڒْمُلْك وجنَّا اَمشْنَاو ثْرَاشَّا ينْضَر-يت <char style="it">يج وبحْرِي</char> ذِي ڒبْحَر، ثطّف مْكُڒ نُّوْع ن وسْڒم. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />وَامِي ثْعمَّر ثْرَاشَّا سُوْفْغن-ت-يد <char style="it">يبحْرِيْين</char> غَار طَّارْف ن ڒبْحَر. قِّيمن، بْذَان تِخْضَارن ݣِّين يسڒْمَان يصبْحَانن ذِي ثْسُوْدْجَاثِين، يسڒْمَان يعفَّانن نْضَرن-ثن. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />أَمُّو إِي غَا يِيڒِي نْهَار إِي ذِي غَا يفْنَا زْمَان: أَذ د اَسنْت لْمَلَائِكَاث اَذ فرْننْت ڒْكُفَّار زِي ڒْمُوْمِنِين؛ <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />أَثْن نْضَرنْت ذِي ڒْكُوْشث ن ثْمسِّي مَانِي غَا يڒِين يمطَّاون ذ وغࢲَّاࢲ ن ثغْمَاس."<verse eid="MAT 13:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />
    <char style="it">ينَّا-ٱسن عِيْسَى إِ يمحْضَارن نّس:</char> "مَا ثْفهْمم مَارَّا مَانَايَا؟" نَّان-اَس: "وَاه آ سِيذِي." <verse eid="MAT 13:51" /><verse number="52" style="v" sid="MAT 13:52" />ينَّا-ٱسن: "كُڒ اَمسڒْمَاذ ن شَّرِيعَا ن مُوْسَى إِݣ يفهْمن ڒْمُلْك وجنَّا نتَّا اَم يِجّن ن بَاب ن ثدَّارْث إِݣ يسُوْفُوْغن ثِمسْڒَايِين ثِقْذِيمِين نِغ ذ جْذِيذ زِي مَانِي يخْزن ڒْكنْز نّس."<verse eid="MAT 13:52" /></para>
  <para style="s">تَازّْڒن خ سِيذِيثْنغ عِيْسَى زݣ وبِيلَاج نّس</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />وَامِي يكمّڒ عِيْسَى ڒمْعَانِي نِّي، يُوْيُوْر سّنِّي. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />ئِذْوڒ غَار ثْمُوْرْث نّس يبْذَا يسڒْمَاذ ذِي ثمْزِيذَا نْسن. تْعجّْبن ذَايس نَّان: "مَانِي يُوْفَا ڒفْهَامث-أَ إِي ذَاس يمُّوْشن ذ لْمُعْجِزَاث-أَ؟ <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />مَا وَار يدْجِي شَا وَانِيتَا ذ مِّيس ن ونجَّار؟ مَا وَار يدْجِي يمَّاس ذ مَرْيَم؟ أَيثْمَاس، ئِجّن قَارن-اَس يَعْقُوْب، ئِجّن ذ يُوْسف، ئِجّن ذ سِمْعَان، ئِجّن ذ يَهُوْذَا مَا لَّا؟ <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />مَا وَار دْجِينْت شَا سُوْيْثْمَاس اَقَاثنْت اَكِذْنغ ذَانِيتَا؟ إِيوَا مَانِيس ذَاس د يكَّا مَارَّا مَانَايَا؟" <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />خ مَانَاينِّي وَار ث قْبِيڒن شَا.</para>
  <para style="p" vid="MAT 13:57">ئِكَّر عِيْسَى ينَّا-ٱسن: "نَّبِي محْتَارم مَانِي مَا، وَلَكِن ذݣ وبِيلَاج نّس ذ ثدَّارْث نّس لَّا!" <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />ئِݣَّا ذِنِّي عِيْسَى ذْرُوْس ن لْمُعْجِزَاث ڒَاحقَّاش لْإِيمَان نْسن ذ وقْلِيل.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">ڒْمُوْث ن سِيذْنَا يَحْيَى</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />ذِي ڒْوقْث نِّي اَزدْجِيذ هِيرُوْدُس يَارَّا-د ڒخْبَار خ عِيْسَى. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />ينَّا-ٱسن إِ يخدَّامن نّس: "وَانِيتَا يعنِّي ذ يَحْيَى نِّي،<note caller="+" style="f"><char style="fr" closed="false">14‏.2 </char><char style="ft" closed="false">يَحْيَى إِي يتْطهَّارن س وَامَان.</char></note> ئِتْوَاسكَّر-د نتَّا زِي ڒْموْث! س مَانَايَا إِي غَارس جّْهذ إِي زِي يتݣّ لْمُعْجِزَاث-أَ."<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />
    <char style="it">قْبڒ إِ مَانَايَا،</char> أَزدْجِيذ هِيرُوْدُس تُوْغَا يطّف يَحْيَى يشدّ-يث يݣِّي-ث ذِي ڒحْبس خ سَّبَاب ن هِيرُوْدِيَا ثَمْغَارْث ن وُوْمَاس فِيلِيپَّـاس. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />ڒَاحقَّاش يقَّار-اَس يَحْيَى إِ وزدْجِيذ هِيرُوْدُس: "حْرَام شك اَذ تَاوِيذ ثَمْغَارْث ن وُوْمَاش." <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />أَزدْجِيذ هِيرُوْدُس يرزُّو اَذ ينغ يَحْيَى، وَلَكِن يݣّْوذ زِي شَّعْب ڒَاحقَّاش يَحْيَى تْوَاڒَان-ث ذ نَّبي. <verse eid="MAT 14:5" /><verse number="6" style="v" sid="MAT 14:6" />وَامِي يݣَّا وزدْجِيذ هِيرُوْدُس ڒْعِيذ لْمِيلَاد نّس، ثكَّر يدْجِيس ن ثمْغَارْث نّس هِيرُوْدِيَا ثشْضح زَّاث إِ ينوْجِيْون، يعْجب-اَس ڒْحَاڒ إِ وزدْجِيذ هِيرُوْدُس. <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />خ مَانَايَا يجُّوْدْج ينَّا-ٱس تَّار-اَيِي مِين ثخْسذ، أَذَام ث ؤُشغ. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />نتَّاث عْلَاحْسَاب مِين ذَاس ثْوصَّا يمَّاس، ثكَّر ثنَّا-ٱس إِ وزدْجِيذ هِيرُوْدُس: "ؤُش-اَيِي-د ذَا اَزدْجِيف ن يَحْيَى خ سِّنِيّث!" <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />ڒخْدّنِّي ينْدم وزدْجِيذ، وَلَكِن يوصَّا اَذَاس ث يُوْش ڒَاحقَّاش تُوْغَا يجُّوْدْج زَّاث إِ ينوْجِيْون ذِي ڒْفَارْح نّس. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />ئِسّكّ غَار ڒحْبس ونِّي ذَاس غَا يقسّن اَزدْجِيف إِ يَحْيَى. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />يُوْوِي-د اَزدْجِيف نّس ذِي سِّنِيّث يُوْشَا-ٱس-ث إِ ثْحنْجِيرْث نِّي، ثْرُوْح ثُوْوِي-يَاس-ث إِ يمَّاس. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />كَّرن يمحْضَارن ن يَحْيَى ؤُسِين-د يْسِين دَّات نّس ݣِّين-ت ذݣ ونْضڒ. سّنِّي ؤُيُوْرن، خْبَرن عِيْسَى س مِين يوقْعن.<verse eid="MAT 14:12" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسشّ خمْسَاڒَاف ن يرْيَازن</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />وَامِي د يَارَّا عِيْسَى ڒخْبَار نِّي، ئِرُوْح سّنِّي وَاحْذس ذِي ثْغَرَّابُوْت غَار يِجّن ن ومْشَان يخْڒَا. أَرِّين-د ڒخْبَار ڒْغَاشِي، ذْفَارن-ث زِي ثْندَّام<note caller="+" style="f"><char style="fr" closed="false">14‏.13 </char><char style="ft" closed="false">ثِندَّام نِثنْتِي ذ ثِنْدِينِين.</char></note> خ يضَارن. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />وَامِي د يضْرَا عِيْسَى زِي ثْغَرَّابُوْت يُوْفَا قَاع اَنشْت نِّي ن يِوْذَان، قّْسن-اَس يسْݣنْفَا يمهْڒَاش نْسن.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />وَامِي يعْذُو ڒْحَاڒ، قَارّْبن غَارس يمحْضَارن نّس نَّان-اَس: "ڒْوقْث ثعْذُو، أَمْشَان-أَ ذ ڒخْڒَا وَاهَا. سكّ يوْذَان-أَ غَار ڒدْشُوْرَاث بَاش اَذ د سْغن مِين غَا شّن."<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />ينَّا-ٱسن عِيْسَى: "مَايمِّي غَا رَاحن؟ ؤُشم-اَسن كنِّيو مِين غَا شّن."<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />نَّان-اَس يمحْضَارن نّس: "نشِّين غَارْنغ ذَا غِير خمْسَا ن ثْخبَّازِين ذ ثْنَاين يسڒْمَان."<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />ينَّا-ٱسن: "أَوِيم-اَيِي-د مَانَاينِّي غَارِي نش." <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />يُوْمَر ڒْغَاشِي نِّي اَذ قِّيمن خ اَرْبِيع. يطّف خمْسَا ن ثْخبَّازِين نِّي ذ ثْنَاين ن يسڒْمَان نِّي، ييْسِي ثِيطَّاوِين نّس غَار وجنَّا يشكَّر أَربِّـي. يرْزَا ثِخبَّازِين نِّي <char style="it">خ ثْنَاين</char> يُوْشَا-ٱسن-ثنْت إِ يمحْضَارن نّس، ڒخْدّنِّي فرْقن-ثنْت خ يِوْذَان نِّي مَارَّا. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />مَارَّا شِّين جِّيوْنن. كَّرن جمْعن مِين خَاسن يشطّن، ثنْعَاش ن ثقْرَابِين عمَّرنْت س يڒقُّوْزن. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />لْعَدَد ن يِنِّي يشِّين نِثْنِي خمْسَاڒَاف ن يرْيَازن بْڒَا ثِمْغَارِين بْڒَا يحنْجِيرن.<verse eid="MAT 14:21" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يݣُّوْر خ ڒمْوَاج ن ڒبْحَر</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />ڒخْدّنِّي يُوْمَر عِيْسَى يمحْضَارن نّس اَذ نْين ذِي ثْغَرَّابُوْت اَذ ࢲْوَان غَار وجمَّاض-ين ن ڒبْحَر، نتَّا يتمْسَافَاض خ ڒْغَاشِي. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />وَامِي خَاسن يمْسَافَاض خ ڒْغَاشِى نِّي، يݣَعّذ غَار وذْرَار اَذ يࢲَّادْج ذِنِّي وَاحْذس. غَار ثْمدِّيث عَاذ اَقَاث ذِنِّي وَاحْذس. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />ثَغَرَّابُوْت نِّي ثݣّْوج اَطَّاس زِي ڒْبَرّ، ڒمْوَاج تَاوِين-تث تَارَّان-تث ڒَاحقَّاش اَرِّيح يتْصُوْض-د زِي جِّهث نّغْنِي. <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" />عْڒَاين يقَارّب-د ڒفْجَر، ئِرُوْح عِيْسَى غَار يمحْضَارن نّس يݣُّوْر خ يضَارن خ وَامَان ن ڒبْحَر. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />وَامِي ث ؤُفِين يݣُّوْر خ يضَارن خ وَامَان ن ڒبْحَر، نْخڒْعن نَّان قَا وَانِيتَا ذ ڒخْيَاڒ! سْنكَّرن ثْغُويِّث س ثِيݣّْوْذِي.<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />ڒخْدّنِّي ينَّا-ٱسن عِيْسَى: "أَهْنَام! أَقَا ذ نش، وَار تݣّوْذم شَا!"<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />ينَّا-ٱس بُطْرُس: "آ سِيذِي مڒَا ذ شك، ڒَاغَا-ٱيِي-د اَغَارك د اَسغ خ وَامَان."<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />ينَّا-ٱس عِيْسَى: "أَرَاح-د!" ئِكَّر يهْوَا-د بُطْرُس زِي ثْغَرَّابُوْت يݣُّوْر خ يضَارن خ وَامَان غَار عِيْسَى. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />وَلَكِن يݣّْوذ وَامِي يࢲْرَا اَرِّيح يتْصُوْض س جّْهذ. ئِبْذَا يغَرّق، يسْنكَّر ثْغُويِّث ينَّا: "آ سِيذِي، عْثق-ٱيِي!" <verse eid="MAT 14:30" /><verse number="31" style="v" sid="MAT 14:31" />ڒخْدّنِّي يُوْشَا-ٱس عِيْسَى فُوْس نّس يطّف-يث ينَّا-ٱس: "لْإِيمَان نّش ذ وقْلِيل وَاهَا، مَايمِّي إِي ذَايِي ثْشكّذ؟" <verse eid="MAT 14:31" /><verse number="32" style="v" sid="MAT 14:32" />صَافِي نْيَان ذِي ثْغَرَّابُوت يرْسَا اَرِّيح نِّي. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />أُوشَا سجّْذن-اَس يِنِّي يدْجَان ذِي ثْغَرَّابُوْت نَّان: "ذ صَّح، شك ذ مِّيس ن أَربِّـي!"<verse eid="MAT 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />وَامِي يزْوَا عِيْسَى نتَّا ذ يمحْضَارن نّس ڒبْحَر، ؤُوْضن غَار ثْمُوْرْث ن ݣَنِيسَارَت. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />أَيثْبَاب ن ثْمُوْرْث نِّي ࢲْرِين عِيْسَى عقْڒن-ث. ڒخْدّنِّي سُوْفْغن ڒخْبَار ذِي مَارَّا ثْمُوْرْث نِّي، ؤُوِين-اَس-د يمهْڒَاش مَارَّا. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />تَّارن-اَس اَثن يجّ اَذ حَاذَان غِير طّْارْف ن وَارُّوْض نّس. صَافِي مَارَّا يِنِّي ث يحَاذَان ݣنْفَان.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">لْعَادَاث إِي وَار د يُوْسِين شَا زِي أَربِّـي</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />سّنِّي ؤُسِين-د ڒْحِزب ن يفَرِّيسِيْين ذ يمْسڒْمَاذن ن شَّرِيعَا غَار عِيْسَى زِي ثنْدِينْت ن لْقُدْس نَّان-اَس: <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />"مَايمِّي يمحْضَارن نّش بطّْڒن لْعَادَاث ن ڒجْذُوْذ نّغ؟ مَايمِّي وَار سِيرِيذن شَا يفَاسّن نْسن قْبڒ مَا ٱذ شّن اَغْرُوْم."<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: "إِيوَا مَايمِّي كنِّيو ثْبطَّاڒم ڒُوْصِيّث ن أَربِّـي حمَا اَذ تسْخذْمم لْعَادَاث نْوم؟ <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />مِينْزِي أَربِّـي ينَّا: وقَّر بَابَاش ذ يمَّاش.<note caller="+" style="f"><char style="fr" closed="false">15‏.4 </char><char style="ft" closed="false">خْزَر ؤُفُوْغ (الخروج) 20‏:12 ذ اَفسَّار ن شَّرِيعَا ن مُوسَى (التثنية) 5‏:16.</char></note> أَقَا ونِّي غَا يُوْكَّرن بَابَاس نِغ ذ يمَّاس، أَتَاف يتْخصَّا-يَاس اَذ يمّث.<note caller="+" style="f"><char style="fr" closed="false">15‏.4 </char><char style="ft" closed="false">خْزَر ؤُفُوْغ (الخروج) 21‏:17 ذ لْكِتَاب ن أَيث لَاوِي 20‏:9.</char></note> <verse eid="MAT 15:4" /><verse number="5‏-6" style="v" sid="MAT 15:5-6" />وَلَكِن كنِّيو ثقَّارم بلِّي وَار يدْجِي بُو لَابُد إِ يِوْذَان اَذ وقَّرن نِغ اَذ عَاوْنن لْوَالِدِين. تْمنْيَاث نِّي إِي غَا ؤُشن إِ لْوَالِدِين نْسن اَثنْت ؤُشن إِ ثمْزِيذَا. أَمُّو كنِّيو ثْبدّْڒم ڒْمَعْنَا ن وَاوَاڒ ن أَربِّـي حمَا اَذ تݣّم مَامّش ذَاوم يعْجب ڒْحَاڒ س لْعَادَاث نْوم. <verse eid="MAT 15:5-6" /><verse number="7" style="v" sid="MAT 15:7" />آ لْمُنَافِقِين! قَا نَّبي إِشَعْيَا ينَّا ڒْحَقّ وَامِي خَاوم يسِّيوڒ ذݣ يِجّن ن زْمَان:<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />&lt;شَّعْب-أَ يتْوقَّر-اَيِي س وقمُّوْم وَاهَا،</para>
  <para style="q2" vid="MAT 15:8">مَاشَا ؤُڒ نّس يݣّْوج خَافِي.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />ئِوْذَان-أَ عبّْذن-اَيِي ذِي ڒْخَاوِي،</para>
  <para style="q2" vid="MAT 15:9">ڒَاحقَّاش سڒْمَاذن ثِمسْڒَايِين يدْجَان ذ ڒُوْصِيَاث ن بْنَاذم وَاهَا.&gt;"<note caller="+" style="f"><char style="fr" closed="false">15‏.9 </char><char style="ft" closed="false">خْزَر إِشَعْيَا 29‏:13.</char></note><verse eid="MAT 15:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />ئِڒَاغَا-د عِيْسَى إِ ڒْغَاشي ينَّا-ٱسن: "صنّْطث <char style="it">مْلِيح</char>، فهْمث: <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />مَا ذِنِّي شَا ن ثْمسْڒَايْث يتَاذْفن اَقمُّوْم تْحَارَّام بْنَاذم؟" ينَّا-ٱسن: "لَّا، مِين د يتفّْغن زݣ وقمُّوْم اَقَا مَانَاينِّي إِݣ يتْحَارَّامن بْنَاذم."<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />قَارّْبن-د غَارس يمحْضَارن نّس نَّان-اَس: "مَا ثسّْنذ بلِّي يفَرِّيسِيْين وَار ذَاسن يعْجِيب بُو ڒْحَاڒ وَامِي سْڒَان إِ وَاوَاڒ نّش؟"<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: "كُڒ اَرْبِيع وَار ث يࢲُّو شَا بَابَا يدْجَان ذݣ وجنَّا اَذ ينقْڒع س يࢲوْرَان نّس. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />اجّم-ثن! نِثْنِي ذ يضَرْغَاڒن تْجَرَّان يضَرْغَاڒن. مڒَا اَضَرْغَاڒ يجَرّ اَضَرْغَاڒ، أَتَاف اَذ وْضَان س ثْنَاين إِذْسن ذِي شَان ثسْرَافْث."<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />ينَّا-ٱس بُطْرُس: "فسّر-اَنغ ڒْمَعْنَا-يَا."<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />ينَّا-ٱس عِيْسَى: "ؤُڒَا ذ كنِّيو عَاذ وَار ثفْهِيمم شَا؟ <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />مَا وَار ثسِّينم بلِّي مِين يتَاذْفن ذݣ وقمُّوْم يتْرَاح غَار وعدِّيس، ئِتفّغ زِي دَّات؟ <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />وَلَكِن مِين د يتفّْغن زݣ وقمُّوْم يتَاس-د زݣ وُوْڒ، أُو ذ مَانَايَا يتْحَرَّامن بْنَاذم. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />ڒَاحقَّاش زݣ وُوْڒ إِي زِي د تكَّانْت لْأَفْكَار ثِعفَّانِين ذ ثْمنْغِيْوْث ذ زّْنَا ذ لْفَسَاد ذ ثُوْكَّارْذَا ذ ࢲُّوْر ذ ڒْبَاطڒ. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />ذ ثِمسْڒَايِين-أَ إِݣ يتْحَارَّامن بْنَاذم، وَلَكِن مڒَا يشَّا س يفَاسّن بْڒَا مَا ثن يسِيرذ، أَتَاف وَار يتْحَارِّيم بُو بْنَاذم."<verse eid="MAT 15:20" /></para>
  <para style="s">لْإِيمَان ن ثمْغَارْث ن أَيْث-كَنْعَان</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />ئِكَّر عِيْسَى يُوْيُوْر سّنِّي يرُوْح غَار جْوَايه ن ثنْدِينْت ن صُوْر ذ ثنْدِينْت ن صَيْدَا. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />ثُوْسَا-د غَارس يجّن ن ثمْغَارْث زِي أَيث-كَنْعَان<note caller="+" style="f"><char style="fr" closed="false">15‏.22 </char><char style="ft" closed="false">ئِوْذَان ن أَيث-كَنْعَان وَار دْجِين شَا زِي أَيث-إِسْرَائِيل.</char></note> ثْزدّغ ذِنِّي. تْرَاغَا ثقَّار-ٱس إِ عِيْسَى: "رْحم-اَيِي آ سِيذِي، آ مِّيس ن أَيث-دَاود! قَا يدْجِي ذَايس يجّن ن جّنّ ذ اَعفَّان يتْعدَّاب-يت اَطَّاس."<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />وَار ذَاس ينِّي عِيْسَى ؤُڒَا ذ يجّن ن وَاوَاڒ. قَارّْبن غَارس يمحْضَارن نّس نَّان-اَس: "ثَمْغَارْث-أَ سُوْفغ-يت خَانغ، <char style="it">زِي صْبَاح</char> نتَّاث ثْذفَّار-اَنغ ثسْغُوْيِيو خَانغ."<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />ينَّا-ٱسن عِيْسَى: "قَا نش تْوَاسّكّغ-د غِير غَار يحُوْڒِيْين يودَّارن، يعْنِى يوْذَان ن أَيث-إِسْرَائِيل."<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />وَلَكِن ثَمْغَارْث نِّي ثُوْسَا-د غَارس ثْسجّذ-اَس ثنَّا-ٱس: "آ سِيذِي، عَاون-اَيِي!"<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />ئِنْدق-د عِيْسَى ينَّا-ٱس: "مَاشِي مَعْقُوْل اَذ يتْوَاكّس وغْرُوْم ن يحنْجِيرن اَذ يمنْضَار إِ يقْزِينن."<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />ثنَّا-ٱس ثمْغَارْث نِّي: "غَارك ڒْحَقّ آ سِيذِي، وَلَكِن ؤُڒَا ذ يقْزِينن نِّي تتّن يفتْوِيتّن ن ؤُغْرُوْم إِݣ يتْوطَّان زِي طَبْڒَا ن أَيثْبَاب نْسن."<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />ئِكَّر عِيْسَى ينَّا-ٱس: "شم آ ثَمْغَارْث، لْإِيمَان نّمْ يجْهذ س وَاطَّاس!" ينَّا-ٱس: "مِين ثْرزُّوْذ اَذ تَافذ." ذِي ثْسَعَّات نِّي ثْݣنْفَا يدْجِيس.<verse eid="MAT 15:28" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسشّ اَرْبعَاڒَاف ن يرْيَازن</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />ئِبعّذ سّنِّي عِيْسَى، يُوْيُوْر خ شّطّ ن ڒبْحَر ن لْجَلِيل. ئِݣَعّذ غَار يِجّن ن وذْرَار يقِّيم ذِنِّي. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />ؤُسِين-د غَارس اَطَّاس ن ڒْغَاشِي. ؤُوِين-د اَكِذْسن يزحَّافن ذ يضَرْغَاڒن ذ يزيْنُوْنن ذ ينشْرُوْفن ذ وَاطَّاس ن يمهْڒَاش نّغْنِي. سرْسن-ثن غَار يضَارن نّس يسْݣنْفَا-ثن. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />تْعجّْبن يِوْذَان نِّي وَامِي ࢲْرِين يزيْنُوْنن سَّاوَاڒن، ئِنشْرُوْفن ݣنْفَان، ئِزحَّافن ݣُّوْرن، ئِضَرْغَاڒن تْوَاڒَان. كَّرن حمْذن أَربِّـي ن أَيث-إِسْرَائِيل.<verse eid="MAT 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />ئِڒَاغَا-د عِيْسَى إِ يمحْضَارن نّس ينَّا-ٱسن: "نش قّْسن-اَيِي يِوْذَان-أَ. ثڒْتِيَّام زݣ وَامِي اَقَاثن اَكِذِي وَار غَارْسن شَا مِين غَا شّن. وَار خْسغ شَا اَثن سّكّغ نِثْنِي وَار شِّين شَا حمَا وَار تسْخِيفّن خ وبْرِيذ."<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />نَّان-اَس يمحْضَارن نّس: "ذِي ڒخْڒَا-يَا مَانِي غَا نَاف اَغْرُوْم إِي زِي غَا نْسشّ قَاع لْعَدَد-أَ ن يِوْذَان؟"<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />ينَّا-ٱسن عِيْسَى: "شْحَاڒ غَارْوم ن وغْرُوْم؟"</para>
  <para style="p" vid="MAT 15:34">نَّان-اَس: "غَارْنغ سبْعَا ن ثشْنِيفِين ذ شَا ن يسڒْمَان ذ يمزْيَانن."<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />يُوْمَر عِيْسَى ڒْغَاشِي اَذ قِّيمن ذِي ثْمُوْرْث. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />ئِطّف سبْعَا نِّي ن ثشْنِيفِين ذ يسڒْمَان نِّي، ئِشكَّر أَربِّـي. يرْزِي-ثن يُوْشِي-ثن إِ يمحْضَارن نّس، ئِمحْضَارن نّس فرْقن-ثن خ ڒْغَاشِي نِّي. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />مَارَّا شِّين جِّيْوْنن، شطّنْت سبْعَا ن ثقْرَابِين عمَّرنْت س يڒقُّوْزن. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />مَارَّا يرْيَازن نِّي إِݣ يشِّين نِثْنِي اَرْبعَاڒَاف إِذْسن بْڒَا ثِمْغَارِين بْڒَا يحنْجِيرن. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />وَامِي يمْسَافَاض خَاسن عِيْسَى خ ڒْغَاشي نِّي، ئِنْيَا ذݣ يِجّن ن ثْغَرَّابُوت يرُوْح غَار جْوَايه ن مَݣْدَلَى.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">ئِوْذَان وَار تفْهِيمن مِين عْنَانْت لْمُعْجِيزَاث ن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />ؤُسِين-د غَار عِيْسَى ڒْحِزب ن يفَرِّيسِيْين ذ ڒْحِزب ن يصَدُّوْقِيْين، تَّارن زَّايس يجّن ن لْعَلَامَا ذ ثَمقّْرَانْت زݣ وجنَّا بَاش اَث جَرّْبن. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: "غَار ڒْمغْرب ثقَّارم <char style="it">ثِيوشَّا</char> اَذ يِيڒِي لْجَاو ذ اَصبْحَان ڒَاحقَّاش اَجنَّا ذ اَزݣّْوَاغ. <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />غَار ڒفْجَر ثقَّارم: نْهَارَا اَذ يِيڒِي ونْࢲَار ذ وَاجَّاج ڒَاحقَّاش اَجنَّا ذ اَزݣّْوَاغ ذَايس اَسيْنُو<note caller="+" style="f"><char style="fr" closed="false">16‏.3 </char><char style="ft" closed="false">أَسيْنُو نتَّا ذ اَسݣْنُو.</char></note> ذ اَبرْشَان. لْحَالَا ن وجنَّا ثسّْنم اَت تْشرّْحم. وَلَكِن لْعَالَامَاث ن زْمَان-أَ لَّا، وَار ثْزمَّرم اَثنْت تْشرّْحم. <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />ئِوْذَان يعفَّانن ن ڒْوقْث-أَ يخدّْعن أَربِّـي تتَّارن لْعَلَامَا ثَمقّْرَانْت، وَلَكِن وَار ذَاسن يتْمُوْشِي إِلَّا لْعَلَامَا نِّي ن نَّبِي يُوْنس." سّنِّي يرُوْح يجِّي-ثن.<verse eid="MAT 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />وَامِي ؤُوْضن يمحْضَارن نّس غَار وجمَّاض-ين <char style="it">ن ڒبْحَر</char> تُّوْن وَار كِسن ؤُوِين شَا اَغْرُوْم. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />ينَّا-ٱسن عِيْسَى: "غَارْوم! حْضَام يخف نْوم زݣ ونْتُوْن<note caller="+" style="f"><char style="fr" closed="false">16‏.6 </char><char style="ft" closed="false">أَنْتُون نتَّا ذ اَمْثُون.</char></note> ن لْأَحْزَاب ن يفَرِّيسِيْين ذ يصَدُّوْقِيْين." <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />سِّيوْڒن جَارَاسن نَّان: "<char style="it">ئِقَّار مَانَايَا ڒَاحقَّاش</char> وَار د نُوْوِي بُو وغْرُوْم."<verse eid="MAT 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8" />ئِسّن عِيْسَى مِينْخف تُوْغَا سَّاوَاڒن ينَّا-ٱسن: "كنِّيو لْإِيمَان نْوم ذ وقْلِيل. مَايمِّي ثقَّارم جَارَاوم وَار غَارْنغ بُو وغْرُوْم؟ <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />مَا عَاذ وَار ثفْهِيمم؟ وَار ثعْقِيڒم خمْسَا نِّي ن ثشْنِيفِين <char style="it">إِݣ يسشّن</char> خمْسَاڒَاف <char style="it">ن يرْيَازن</char>، مشْحَاڒ ن ثقْرَابِين إِي ثشُّوْرم؟ <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" /><char style="it">وَار ثعْقِيڒم</char> سبْعَا نِّي ن ثشْنِيفِين <char style="it">إِݣ يسشّن</char> اَرْبعَاڒَاف <char style="it">ن يرْيَازن</char>، مشْحَاڒ ن ثقْرَابِين إِي ثشُّوْرم؟ <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />مَامّش ثݣِّيم وَار ثفْهِيمم؟ نش وَار سِّيوِيڒغ شَا خ وغْرُوْم. حْضَام يخف نْوم زݣ ونْتُوْن ن لْأَحْزَاب ن يصَدُّوْقِيْين ذ يفَرِّيسِيْين."<verse eid="MAT 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12" />ڒخْدّنِّي عَاذ إِي فهْمن يمحْضَارن بلِّي وَار ذَاسن يسِّيوِيڒ شَا خ ونْتُوْن ن وغْرُوْم؛ لَّا، ينَّا-ٱسن: حْضَام يخف نْوم زِي مِين سڒْمَاذن يفَرِّيسِيْين ذ يصَدُّوْقِيْين.<verse eid="MAT 16:12" /></para>
  <para style="s">بُطْرُس يشهّذ خ لْمَسِيح</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />وَامِي يُوْوض عِيْسَى غَار جِّهث ن ثنْدِينْت ن قَيْصَارِيَا ن فِيلِيبَّاس، ئِسّقْسَا يمحْضَارن نّس ينَّا-ٱسن: "مِين قَّارن يِوْذَان خ مِّيس ن بْنَاذم؟"<verse eid="MAT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14" />نَّان-اَس: "ئِجّن يقَّار شك ذ يَحْيَى،<note caller="+" style="f"><char style="fr" closed="false">16‏.14 </char><char style="ft" closed="false">س ثَيُوْنَانِيث، يَحْيَى إِݣ يتْطهَّارن س وَامَان.</char></note> ئِجّن يقَّار شك ذ إِلْيَاس، ئِجّن يقَّار شك ذ إِرْمِيَا نِغ ذ شَان يِجّن زِي لْأَنْبِيَا."<verse eid="MAT 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15" />ينَّا-ٱسن عِيْسَى إِ يمحْضَارن نّس: "ئِي كنِّيو، مِين ذَايِي د تَارَّام نش؟"<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />ئِنْدق-د سِمْعَان بُطْرُس ينَّا-ٱس: "شك ذ لْمَسِيح، مِّيس ن أَربِّـي يدَّرن."<verse eid="MAT 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17" />ڒخْدّنِّي ينَّا-ٱس عِيْسَى: "سَّعْذ نّش آ سِمْعَان، آ مِّيس ن يُوْنَا! وَار يدْجِي بُو ذ شَا ن بْنَاذم إِي ذَاش د يسْمظْهَارن مَانَايَا منْغِير بَابَا يدْجَان ذݣ وجنَّا. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />نش عَاوذ اَقَا قَّارغ-اَش: شك ذ بُطْرُس، <char style="it">يعْنِي ذ &lt;اَزْرُو.&gt;</char> خ وزْرُو-يَا اَذ بْنِيغ نش جْمَاعث ن ڒْمُوْمِنِين ينُو، ثِوُوْرَّا ن لْجَحِيم وَار زَّايس تِيوِينْت وَالُو! <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />أَذَاش ؤُشغ ڒمْفَاتَح ن ڒْمُلْك وجنَّا. مِين غَا ثْشدّذ ذِي ثْمُوْرْث اَذ يِيڒِي يتْوَاشدّ ذݣ وجنَّا. مِين غَا ثرْزْمذ ذِي ثْمُوْرْث اَذ يِيڒِي يتْوَارْزم ذݣ وجنَّا." <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />ڒخْدّنِّي عِيْسَى يوصَّا يمحْضَارن نّس ينَّا-ٱسن وَار قَّارم إِ حَدّ بلِّي نش ذ لْمَسِيح.<verse eid="MAT 16:20" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسَّاوَاڒ خ ڒْموْث نّس</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />سّنِّي يبْذَا عِيْسَى يسْفهَّام إِ يمحْضَارن نّس بلِّي لَابُد اَذ يرَاح نتَّا غَار ثنْدِينْت ن لْقُدْس اَذ يتْوَاعدّب خ وَاطَّاس ن ثْمسْڒَايِين خ وفُوْس ن يمقّْرَانن ن أَيث-إِسْرَائِيل ذ اَرُّوْيَاس ن ڒْفُقَهَا ذ يمْسڒْمَاذن ن شَّرِيعَا. أَث نْغن، وِيس ثڒْتِيَّام اَذ د يتْوَاسكَّر زِي ڒْمُوْث."<verse eid="MAT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22" />ئِسْبعّذ-يث بُطْرُس وَاحْذس ينْهَا-ث ينَّا-ٱس: "أَش يحْفض أَربِّـي آ سِيذِي! عمَّارص وَار ذَاش يتوْقِيع مَانَايَا."<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />وَلَكِن عِيْسَى ينقْڒب-د غَار بُطْرُس ينَّا-ٱس: "أَݣّْوج خَافِي غَار ذفَّار آ شِّيطَان! شك اَم يِجّن ن وزْرُو ذݣ وبْرِيذ ينُو تْنقْڒَاذغ ذَايس. شك وَار تْفكَّرذ شَا اَمشْنَاو أَربِّـي؛ لَّا، شك تْفكَّرذ اَمشْنَاو بْنَاذم."<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />سّنِّي يسِّيوڒ عِيْسَى اَك يمحْضَارن نّس ينَّا-ٱسن: "ونِّي يخْسن اَذَايِي يذْفَار نش، لَابُد اَذ يسْمح ذݣ يِيخف نّس اَذ يكسِّي صَّلِيب نّس<note caller="+" style="f"><char style="fr" closed="false">16‏.24 </char><char style="ft" closed="false">ذِي ڒْوقْث نِّي ن سِيذِيثْنغ عِيْسَى اَرُّوْمَانُوْس نقّن يوْذَان ذِي صَّلِيب، ئِوْذَان تْعدَّابن اَطَّاس ذَايس. ونِّي يذفَّارن سِيذِيثْنغ عِيْسَى يخصَّا-يَاس وَار يتݣّْوذ شَا زِي صَّلِيب نِّي، يعْنِي زِي ڒْموْث ؤُڒَا زݣ وعدّب.</char></note> اَذَايِي يذْفَار. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />ڒَاحقَّاش ونِّي يخْسن اَذ يسنْجم ثُوْذَارْث نّس اَتَاف اَت يخْسَر. ونِّي غَا يخْسَرن ثُوْذَارْث نّس خ سَّبَاب ينُو اَتَاف اَت يَاف. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />مِينْزِي غَا ينْفع بْنَاذم مڒَا يرْبح دُّنشْت-أَ قَاع وَا يخْسَر ڒَعْمَر نّس؟ مِين غَا يُوْش بْنَاذم ذݣ ومْشَان ن ڒَعْمَر نّس؟ <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />أَقَا مِّيس ن بْنَاذم اَذ د يَاس س لْعَظَمَا ن بَابَاس اَك لْمَلَائِكَاث نّس، أُوشَا اَذ يجَازَا مْكُڒ يجّن عْلَاحْسَاب ڒْخذْمث نّس. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />أَقَا تسْڒَام ڒْحَقّ: ڒبْعَاض زݣ يِنِّي يدْجَان ذَا اَكِذِي وَار تْمتِّين شَا اَڒ غَا ࢲرن مِّيس ن بْنَاذم يُوْسَا-د ذِي ڒْمُلْك نّس."<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">سِيذْنَا مُوْسَى ذ سِيذْنَا إِلْيَاس مظْهَارن-د اَك سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />ثعْذُو ستّييَّام، عِيْسَى يُوْوِي اَكِذس بُطْرُس ذ يَعْقُوْب ذ وُوْمَاس يُوْحَنَّا، يُوْوِي-ثن وَاحذْسن غَار يِجّن ن وذْرَار يُوْعْڒَا. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />ذِنِّي زَّاث إِ ثِيطَّاوِين نْسن يذْوڒ اَم يِجّن ن نُّوْر، أَغمْبُوْب نّس يتْشعْشِيع اَم ثْفُوْشْت. ئِذْوڒ وَارُّوْض نّس ذ اَشمْڒَاڒ يرقّ اَم ثْفَاوْث. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />ئِمظْهَار-اَسن-د ذِنِّي نَّبِي إِلْيَاس ذ نَّبِي مُوْسَى. <char style="it">تْوَاڒَان-ثن</char> سَّاوَاڒن اَك عِيْسَى.<verse eid="MAT 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4" />ئِنْدق-د بُطْرُس ينَّا-ٱس إِ عِيْسَى: "آ سِيذِي، ذ اَصبْحَان اَكِذش نقِّيم ذَانِيتَا. مڒَا ثخْسذ، أَذ ݣّغ ثْڒَاثَا ن يقِيضَان: ئِجّن إِ شك، ئِجّن إِ مُوْسَى، يجّن إِ إِلْيَاس."<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />عَاذ يسَّاوَاڒ بُطْرُس يهْوَا-د خَاسن يِجّن ن وسيْنُو يتْسقْسِيق. ثنْدق-د يجّن ن ثْمِيجَّا زݣ وسيْنُو نِّي ثنَّا-ٱسن: "قَا ذ وَانِيتَا ذ مِّي يعِيزّن، نش فَرْحغ زَّايس. صنّْطث غَارس." <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />وَامِي سْڒِين يمحْضَارن ثْمِيجَّا نِّي ݣّْوْذن سجّْذن غَار ثْمُوْرْث. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />ئِقَارّب غَارْسن عِيْسَى يحَاذَا-ثن ينَّا-ٱسن: "كَّرم وَار تݣّْوْذم شَا." <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />يْسِين ثِيطَّاوِين نْسن غَار وجنَّا وَار ؤُفِين حَدّ إِلَّا عِيْسَى.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />وَامِي د هوَّان زݣ وذْرَار يوصَّا-ثن عِيْسَى ينَّا-ٱسن: "وَار تْعَاوَاذم إِ حَدّ مِين ثࢲْرِيم اَڒ د غَا يكَّر مِّيس ن بْنَاذم زِي ڒْموْث."<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />سّقْسَان-ث يمحْضَارن نّس نَّان-اَس: "مَايمِّي يمْسڒْمَاذن ن شَّرِيعَا قَّارن يتْخصَّا نَّبي إِلْيَاس اَذ د يَاس نتَّا ذ اَمزْوَارُو؟"<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />ينَّا-ٱسن عِيْسَى: "ذ صَّح، ئِتْخصَّا اَذ د يَاس إِلْيَاس اَذ يعْذڒ كُڒْشِي. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />وَلَكِن قَّارغ-اَوم: أَقَا إِلْيَاس نِّي يُوْسَا-د نِثْنِي وَار ث سِّينن شَا، خذْمن ذَايس مِين خْسن. أَمنِّي إِي غَا عدّْبن مِّيس ن بْنَاذم."<verse eid="MAT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13" />أُوشَا فهْمن يمحْضَارن بلِّي يسَّاوَاڒ-اَسن خ يَحْيَى ونِّي يتْطهَّارن س وَامَان.<verse eid="MAT 17:13" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا يج وحنْجِير ذَايس جّنّ</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />وَامِي د ذوْڒن غَار ڒْغَاشِي، يقَارّب يجّن ن ورْيَاز غَار عِيْسَى يوْضَا خ يفَادّن زَّاث نّس. <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />ينَّا-ٱس: "آ سِيذِي رْحم-اَيِي ممِّي، ئِجّن ن جّنّ يتْعدَّاب-يث اَطَّاس. أَطَّاس ن ثْوَاڒَاثِين يتْوطَّا ذِي ثْمسِّي نِغ ذݣ وَامَان. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />ؤُوِيغ-ث-يذ غَار يمحْضَارن نّش وَلَكِن نِثْنِي وَار زمَّرن اَث سْݣنْفَان."<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: "آ يوْذَان ن ڒْوقْث-أَ إِي ذِي وَار يدْجِي بُو لْإِيمَان، آ يِنِّي يفّْغن اَبْرِيذ! مشْحَاڒ إِي كِذْوم غَا قِّيمغ أُو مشْحَاڒ ذَاوم غَا صْبَرغ؟ أَوِيم-اَيِي-ث-يد ذَا." <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />عِيْسَى يسْبدّ جَّن نِّي اَعفَّان، ئِفّغ زݣ وحنْجِير نِّي يݣنْفَا ذِي ثْسَعَّات نِّي.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />قَارّْبن-د يمحْضَارن غَار عِيْسَى وَاحْذس نَّان-اَس: "مَايمِّي زَعْمَا نشِّين تُوْغَا وَار نْزمَّر اَث نْسُوْفغ؟"<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />ينَّا-ٱسن عِيْسَى: "ڒَاحقَّاش لْإِيمَان نْوم ذ ؤُقْلِيل. أَقَا تسْڒَام ڒْحَقّ: مْڒِي ذَايْوم لْإِيمَان غِير اَنشْت يجّن ن ثْحبُّوْشْت ن بُوْݣَرْذَاڒ،<note caller="+" style="f"><char style="fr" closed="false">17‏.20 </char><char style="ft" closed="false">ثَحبُّوْشْت ن بُوْغَرْذَاڒ نتَّاث ذ يجّن ن زَّرِيعث ن اَرْبِيع ذ ثَمزْيَانْت اَطَّاس.</char></note> أَذ تِينِيم إِ وذْرَار-أَ: نقْڒع-د شك سَّانِيتَا رُوْح غَار ذِيهَا اَتَاف اَذ د ينقْڒع. وَار خَاوم يتقْسِيح وَالُو. <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />{نُّوْعَا-يَا ن جّنّ اَذ تْسُوْفْغم غِير س ثْࢲَادْجِيث ذ وࢲُوْمِّي.}"<verse eid="MAT 17:21" /></para>
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />
    <char style="it">ئِمحْضَارن نّس</char> وَامِي د مُوْنن اَكِذس غَار ثْمُوْرْث ن لْجَلِيل يكَّر عِيْسَى ينَّا-ٱسن: "عْڒَاين اَذ يتْوَاسلّم مِّيس ن بْنَاذم غَار يفَاسّن ن يِوْذَان. <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />أَث نْغن، نْهَار وِيس ثڒْتِيَّام اَذ د يتْوَاسكَّر." ڒخْدّنِّي خيّْقن يمحْضَارن س وَاطَّاس س وَاوَاڒ نِّي.<verse eid="MAT 17:23" /></para>
  <para style="s">ضَّرِيبَا ن ثمْزِيذَا ثَمقّْرَانْت</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />وَامِي يُوْوض عِيْسَى ذ يمحْضَارن نّس غَار وبِيلَاج ن كَفرْنَاحُوْم، ؤُسِين-د يِنِّي يجمّْعن ضَّرِيبَا إِ ثمْزِيذَا ثَمقّْرَانْت. قَارّْبن غَار بُطْرُس نَّان-اَس: "مَا وَار يتْخدْجِيس شَا لْمُعَلِّم نْوم ضَّرِيبَا ن ثمْزِيذَا ثَمقّْرَانْت؟"<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />ينَّا-ٱسن بُطْرُس: "وَاه، ئِتْخدْجَاس-يت."</para>
  <para style="p" vid="MAT 17:25">وَامِي يُوْذف بُطْرُس غَار ثدَّارْث، عِيْسَى يزْوَار-اَس س وَاوَاڒ ينَّا-ٱس: "مِين ذَاش يمظْهَارن آ سِمْعَان؟ ؤُو غَا يخدْجْسن ڒَعْشُوْر نِغ ضَّرِيبَا إِ يزدْجِيذن ن ثْمُوْرْث، مَا ذ ثَارْوَا نْسن نِغ ذ يوْذَان عَادِي؟"<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />ينَّا-ٱس بُطْرُس: "ئِوْذَان عَادِي."</para>
  <para style="p" vid="MAT 17:26">ينَّا-ٱس عِيْسَى: "إِيوَا ثَارْوَا نْسن وَار تْخدْجِيسن شَا بَعْدَا. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />وَلَكِن يتْخصَّا وَار نسْخيّق حَدّ. رُوْح غَار ڒبْحَر نْضَر ثِصنَّارْث ذݣ وَامَان، أَسْڒم نِّي إِي غَا ثطّْفذ ذ اَمزْوَارُو، رْزم-اَس اَقمُّوْم اَذَايس ثَافذ يجّن ن ثْپـيَّاسْت ن نُّقَارْث. يْسِي-ت ؤُش-اَسن-ت، خدْجس خَاش ذ خَافِي.<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">لْإِيمَان ذ ڒْمُعْصِيّث</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />ذِي ثْسَعَّات نِّي قَارّْبن-د يمحْضَارن غَار عِيْسَى نَّان-اَس: "ؤُݣ يدْجَان قَاع ذ اَمقّْرَان ذِي ڒْمُلْك وجنَّا؟"<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />ئِڒَاغَا-د عِيْسَى خ يِجّن وحنْجِير ذ اَمزْيَان يسْبدّ-يث ذِي ڒْوسْط نْسن. <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />ينَّا-ٱسن: "أَقَا تسْڒَام ڒْحَقّ: لَابُد إِ كنِّيو اَذ تْذوْڒم اَذ تِيڒِيم اَمشْنَاو يحنْجِيرن يمزْيَانن. مڒَا لَّا، أَتَاف عمَّارْص اَذ تَاذْفم ذِي ڒْمُلْك وجنَّا. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />ونِّي يسمْزَاين يخف نّس اَمشْنَاو اَحنْجِير-أَ، ذ نتَّا إِي غَا يِيڒِين ذ اَمقّْرَان قَاع ذِي ڒْمُلْك وجنَّا. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />ونِّي غَا يقبْڒن شَان وحنْجِير اَم وَانِيتَا عْلَاحْسَاب يسم ينُو، أَخْمِي ذ نش إِݣ يقْبڒ.<verse eid="MAT 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />ونِّي إِي غَا يَاوِين يجّن زݣ يمزْيَانن-أَ إِي زَّايي يتَامْنن غَار ڒْمُعْصِيّث، حْسن إِ نتَّا اَذَاس شدّن يجّن ن وزْرُو ن ثْسِيرْث س وسْغُوْن غَار يِيري نّس اَذ يتْوَاغْرق ذِي ڒَادْجغ ن ڒبْحَر. <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />يَا تَمَارَا ن يِوْذَان خ سَّبَاب ن ثْمسْڒَايِين يتَاوِين غَار ڒْمُعْصِيّث. ثِمسْڒَايِين نِّي اَذ د اَسنْت، وَلَكِن يَا تَمَارَا ن بْنَاذم نِّي إِݣ يتݣّن مَانَاينِّي!<verse eid="MAT 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8" />شك فُوْس نّش نِغ ضَار نّش مڒَا يتْسبَّاب-اَش ذِي شَان ڒْمُعْصِيّث، قسّ-يث زَعْمَا نْضَر-يث. حْسن إِ شك اَذ تَاذْفذ جّنّث س يِجّن ن وفُوْس نِغ س يِجّن ن وضَار زِي مڒَا قِّيمن غَارك ثْنَاين ن يفَاسّن نِغ ثْنَاين ن يضَارن اَذ تْمنْضَارذ ذِي ثْمسِّي إِي وَار يخسِّين شَا عمَّارْص. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />شك ثِيطّ نّش مڒَا تْسبَّاب-اَش ذِي شَان ڒفْضِيحث، قْڒع-يت زَعْمَا نْضَر-يت. حْسن إِ شك اَذ تَاذْفذ جّنّث س يِجّن ن ثِيطّ زِي مڒَا قِّيمنْت غَارك ثْنَاين ن ثِيطَّاوِين اَذ تْمنْضَارذ ذِي جَهنَّامَا ن ثْمسِّي.<verse eid="MAT 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />غَارْوم اَذ تْحݣَّرم شَان حَدّ زݣ يمزْيَانن-أَ. قَّارغ-اَوم: لْمَلَائِكَاث نْسن ذݣ وجنَّا ڒبْدَا خزَّرنْت بَابَا يدْجَان ذݣ وجنَّا. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />{لِأَنَّا مِّيس ن بْنَاذم يُوْسَا-د اَذ ينجَّا يِنِّي يودَّارن.}<verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />مِين ذَاوم يمظْهَارن؟ ئِجّن غَارس مِيَّا ن يحُوْڒِيْين. مڒَا يودَّر-اَس يجّن زَّايسن، أَتَاف اَذ يجّ تسْعَا أُو تسْعِين ذݣ وذْرَار اَذ يرَاح اَذ يرْزُو خ ونِّي يودَّارن. <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />أَقَا تسْڒَام ڒْحَقّ: مڒَا يُوْفِي-ث، أَتَاف اَزَّايس يفَرح كْتَار زِي مِين غَا يفَرح خ تسْعَا أُو تسْعِين نِّي وَار يودَّارن شَا! <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />أَمنِّي ؤُڒَا ذ بَابَاثْوم يدْجَان ذݣ وجنَّا وَار يخس ؤُڒَا ذ يجّن زݣ يمزْيَانن-أَ اَذ يودَّر.<verse eid="MAT 18:14" /></para>
  <para style="s">ؤُمَاش يخْضَا اَكِذش</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />مڒَا يخْضَا اَكِذش وُوْمَاش، رُوْح غَارس نْهَا-ث غِير شك ذ نتَّا غِير س ثْنَاين إِذْوم. مڒَا يݣّ-اَش اَرَّاي، أَتَاف اَذ تِيڒِيذ مْلِيح عَاوذ اَك وُوْمَاش. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />وَلَكِن مڒَا يُوْݣِي اَغَارك يصنّط، أَوِي اَكِذش يجّن نِغ ثْنَاين حمَا اَتَاف لْغَالط نّس سّْنن-ث ثْنَاين نِغ ثْڒَاثَا ن ڒشْهُوْذ.<note caller="+" style="f"><char style="fr" closed="false">18‏.16 </char><char style="ft" closed="false">خْزَر اَفسَّار ن شَّرِيعَا ن مُوسَى (التثنية) 19‏:15.</char></note> <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />وَلَكِن مڒَا يُوْݣِي اَغَارْسن يصنّط، ئِنِي-ث إِ جْمَاعث ن ڒْمُوْمِنِين. أُو مڒَا يُوْݣِي اَغَارْسن يصنّط، حْسب-يث ذ ڒْكَافر نِغ ذ اَخدَّاع.<note caller="+" style="f"><char style="fr" closed="false">18‏.17 </char><char style="ft" closed="false">أَخدَّاع نتَّا س ثَيُوْنَانِيث، ونِّي يجمّْعن ڒَعْشُور.</char></note> <verse eid="MAT 18:17" /><verse number="18" style="v" sid="MAT 18:18" />أَقَا تسْڒَام ڒْحَقّ: مَارَّا مِين غَا ثْشدّم ذِي ثْمُوْرْث اَتَاف اَذ يِيڒِي يتْوَاشدّ ذݣ وجنَّا. مَارَّا مِين غَا ثرْزْمم ذِي ثْمُوْرْث اَتَاف اَذ يِيڒِي يتْوَارْزم ذݣ وجنَّا.<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />قَّارغ-اَوم عَاوذ: مڒَا ثْتَافْقم ثْنَاين زَّايْوم خ ثْمُوْرْث ثتَّارم شَان ڒْحَاجث إِ بَابَا يدْجَان ذݣ وجنَّا، أَتَاف اَذَاوم ت يسْتَاجب. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />ڒَاحقَّاش مَانِي غَا مُوْنن ثْنَاين نِغ ثْڒَاثَا خ سَّبَاب ينُو، نش اَڒ ذِين يڒِيغ ذِي ڒْوسْط نْسن."<verse eid="MAT 18:20" /></para>
  <para style="s">ڒْمَعْنَا ن وخدَّام إِي ذِي وَار يدْجِي اَرَّحْمث</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />ڒخْدّنِّي يقَارّب بُطْرُس غَار عِيْسَى ينَّا-ٱس: "آ سِيذِي، شْحَاڒ ن ثْوَاڒَاثِين إِي كِذِي غَا يخْضَا وُوْمَا بَاش اَذَاس سمْحغ؟ مَا سبْعَا ن ثْوَاڒَاثِين؟"<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />ينَّا-ٱس عِيْسَى: "لَّا، وَار يدْجِي بُو سبْعَا ن ثْوَاڒَاثِين، أَذَاش ينِيغ سبْعِين ؤُوث-يت ذِي سبْعَا ن ثْوَاڒَاثِين! <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />ڒَاحقَّاش ڒْمُلْك وجنَّا يتَاوِي-د ذݣ يِجّن ن وزدْجِيذ يرزُّو اَذ يݣّ ڒحْسَاب اَك يخدَّامن نّس. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />وَامِي يبْذَا ذِي ڒحْسَاب، ؤُوِين-د غَارس يجّن ذَايْس اَطَّاس ن ومَارْوَاس، أَم عشْرَا اَڒَاف <char style="it">مِيلْيَار</char>. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />وَار غَارس مِينْزِي غَا يَرّ اَمَارْوَاس-أَ، ئِوصَّا سِيذس اَذ يمّنْز نتَّا ذ ثَمْغَارْث نّس ذ ثَارْوَا نّس ذ مَارَّا مِين غَارس حمَا اَذ يخدْجس اَمَارْوَاس نِّي. <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />يُوْسَا-د وخدَّام نِّي يسجّذ-اَس إِ سِيذس ينَّا-ٱس: أَهْيَا آ سِيذِي، صْبَار خَافِي. أَذَاش خدْجْسغ مَارَّا مِين ذَايِي تَارْسذ. <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />ڒخْدّنِّي يقّس-اَس إِ سِيذس يذْڒق-اَس، ئِسْمح-اَس ذݣ ومَارْوَاس نِّي.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />ئِفّغ وخدَّام نِّي يُوْفَا يجّن نّغْنِي زݣ يخدَّامن، تُوْغَا يتَارس-اَس شْوَايْت وَاهَا، أَم يِجّن ن <char style="it">مِيلْيُوْن</char>. ئِطّف-يث يبْذَا يتْجيَّاف-يث يقَّار-اَس: خدْجس-اَيِي مِين ذَاش تَارْسغ! <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />يوْضَا-يَاس ومدُّوْكڒ نّس غَار يضَارن ينَّا-ٱس: صْبَار خَافِي شْوَايْت اَش خدْجْسغ. <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />يُوْݣِي، ئِرُوْح نتَّا ينْضَر-يث ذِي ڒحْبس اَڒ غَا يخدْجس اَمَارْوَاس نّس.<verse eid="MAT 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 18:31" />ࢲْرِين يِنِّي كِس يخدّْمن مِين يوقْعن، ئِقّس-اَسن ڒْحَاڒ رُوْحن غَار سِيذِيثْسن عَاوْذن-اَس مِين يوقْعن. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />ئِكَّر يڒَاغَا-يَاس-د سِيذس ينَّا-ٱس: آي اَخدَّام اَعفَّان، مَايمِّي؟ نش سمْحغ-اَش ذِي مَارَّا مِين ذَاش تَارْسغ ڒَاحقَّاش ثتَّارذ-اَيِي. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />ڒَا ذ شك تُوْغَا يتْخصَّا-شك اَذ تْرحْمذ اَمدُّوْكڒ نّش اَمشْنَاو مَامّش ش رحْمغ ؤُڒَا ذ نش." <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />ئِغْضب سِيذس س وَاطَّاس يسلّم اَخدَّام نِّي غَار يِنِّي إِي ث غَا يعدّْبن اَڒ غَا يخدْجس مَارَّا مِين ذَايس ذ اَمَارْوَاس.<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />أَمُّو إِي كِذْوم غَا يݣّ بَابَا إِي يدْجَان ذݣ وجنَّا مڒَا وَار يسْمِيح مْكُڒ يجّن زَّايوم س وُوْڒ نّس إِ وُوْمَاس.<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">طَّلَاق عْلَاحْسَاب مَامّش يقَّار سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />وَامِي يكمّڒ عِيْسَى اَوَاڒ نّس، ئِفّغ زِي ثْمُوْرْث ن لْجَلِيل يُوْوض غَار جْوَايه ن يَهُوْذِيَا ذ وجمَّاض-ين ن يغْزَار ن لْأُرْدُن. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />ذْفَارن-ث يجّن ن لْعَدَد ن يِوْذَان، يسْݣنْفَا يمهْڒَاش نْسن ذِنِّي.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />قَارّْبن-د غَارس شَان يِوْذَان زِي ڒْحِزب ن يفَرِّيسِيْين حمَا اَث جَرّْبن. نَّان-اَس: "مَا حَلَال اَذ يدْجف شَان ورْيَاز إِ ثمْغَارْث نّس ذِي اَيِّي ڒْحَاجث؟"<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: "مَا وَار ثغْرِيم مِين يقَّار لْكِتَاب؟ زݣ وَامِي ثدْجَا دُّنشْت يخْڒق لْخَالِق اَرْيَاز ذ ثمْغَارْث.<note caller="+" style="f"><char style="fr" closed="false">19‏.4 </char><char style="ft" closed="false">خْزَر إِمزْوُورَا (التكوين) 1‏:27.</char></note> <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />ينَّا أَربِّـي: أَقَا اَرْيَاز اَذ يجّ بَابَاس ذ يمَّاس اَذ يمُوْن اَك ثمْغَارْث نّس، أَذ ذوْڒن س ثْنَاين إِذْسن ذ يجّن.<note caller="+" style="f"><char style="fr" closed="false">19‏.5 </char><char style="ft" closed="false">خْزَر إِمزْوُورَا (التكوين) 2‏:24.</char></note> <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />خ مَانَايَا وَار تِيڒِين شَا ذ ثْنَاين؛ لَّا، أَذ يڒِين ذ يجّن. إِذن، مِين يسْمُوْن أَربِّـي وَار ث يسْفَرّق شَا بْنَاذم."<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />نَّان-اَس يفَرِّيسِيْين: "إِيوَا، مَايمِّي يوصَّا مُوْسَى اَرْيَاز اَذ يُوْش ثَبْرَات ن وَادْجَاف إِ ثمْغَارْث نّس اَذَاس يدْجف؟"<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />ينَّا-ٱسن عِيْسَى: "ئِجِّي-كنِّيو مُوْسَى اَذ تدْجْفم إِ ثمْغَارِين نْوم مِينْزِي غَارْوم ؤُڒ يقْسح، وَلَكِن ذݣ ومزْوَارُو وَار تُوْغَا شَا اَمُّو. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />قَّارغ-اَوم نش: مَارَّا ونِّي غَا يدْجْفن إِ ثمْغَارْث نّس اَمن وَار ثزْنِي، يُوْوِي شَان يشْتن نّغْنِي، أَتَاف يزْنَا."<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />نَّان-اَس يمحْضَارن نّس: "مڒَا اَمُّو لْحَالَا ن ورْيَاز اَك ثمْغَارْث نّس، حْسن-اَس اَتَاف وَار يمدْجش شَا."<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />ينَّا-ٱسن عِيْسَى: "زمَّرن اَذ قبْڒن اَوَاڒ-أَ غِير يِنِّي ؤُمِي يُوْشَا أَربِّـي ثِزمَّار اَث قبْڒن. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />ذِنِّي ڒبْعَاض زݣ وَامِي خڒْقن وَار زمَّرن اَذ مڒْشن. ذِنِّي ڒبْعَاض نّغْنِي قّْنن-ثن يِوْذَان. أُو ذِنِّي ڒبْعَاض نّغْنِي ؤُݣِين اَذ مڒْشن خ سَّبَاب ن ڒْمُلْك وجنَّا. ونِّي يزمَّرن اَذ يقْبڒ ثِمسْڒَايِين-أَ اَثنْت يقْبڒ."<verse eid="MAT 19:12" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يتْبَرك يحنْجِيرن يمزْيَانن</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />ؤُوِين-د يِوْذَان شَان يحنْجِيرن ذ يمزْيَانن غَار عِيْسَى حمَا اَخَاسن يسرْس يفَاسّن اَخَاسن يࢲَّادْج، وَلَكِن عَارّْضن-اَسن يمحْضَارن نّس. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />ئِكَّر عِيْسَى ينَّا-ٱسن: "اجّم يحنْجِيرن يمزْيَانن اَغَارِي د اَسن. وَار ذَاسن تْعَارَّاضم شَا ڒَاحقَّاش ڒْمُلْك وجنَّا يتِيڒِي غَار يِنِّي إِي يدْجَان اَم يِيْنَا." <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />يݣَّا خَاسن يفَاسّن نّس يُوْيُوْر سّنِّي.<verse eid="MAT 19:15" /></para>
  <para style="s">أَحنْجِير إِݣ يدْجَان ذ تَّاجَر</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />ئِقَارّب يجّن ن وحنْجِير غَار عِيْسَى ينَّا-ٱس: "آ لْمُعَلِّم، مِين غَا ݣّغ ذ اَصبْحَان حمَا اَغَارِي ثِيڒِي ثُوْذَارْث ن ڒبْدَا؟"<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />ينَّا-ٱس عِيْسَى: "مَايمِّي إِي ذَايِي تسّقْسِيذ خ مِين يصبْحَان؟ غِير يجّن إِݣ يدْجَان ذ اَصبْحَان. مڒَا ثخْسذ اَذ تَاذْفذ ثُوْذَارْث ن ڒبْدَا، اݣّ اَرَّاي س ڒُوْصِيَاث."<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />ينَّا-ٱس وحنْجِير نِّي: "مَان ڒُوْصِيَاث؟"</para>
  <para style="p" vid="MAT 19:18">ينَّا-ٱس عِيْسَى: "وَار نقّ، وَار زنِّي، وَار تَاشَار، وَار شهّذ بُو ࢲُّوْر، <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />وقَّر بَابَاش ذ يمَّاش، خس اَجَّار نّش اَمشْنَاو يخف نّش."<verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />ينَّا-ٱس وحنْجِير نّي: "تْوقَّرغ مَارَّا مَانَايَا. مِين ذَايِي يقِّيمن اَث ݣّغ؟"<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />ينَّا-ٱس عِيْسَى: "مڒَا ثخْسذ اَذ تݣّذ كُڒْشِي نِيشَان، رُوْح زنْز مَارَّا مِين غَارك ذ اَݣْڒَا صدّق-يث خ ڒْمُسَاكِين. سّنِّي اَغَارك يِيڒِي يجّن ن ڒْكنْز ذݣ وجنَّا، ڒخْدّنِّي أَرَاح-د شك ذْفَار-اَيِي-د."<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />أَحنْجِير نِّي، وَامِي يسْڒَا إِ مَانَاينِّي يرُوْح يخيّق اَطَّاس ڒَاحقَّاش غَارس اَطَّاس ن وَاݣْڒَا.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />ينَّا-ٱسن عِيْسَى إِ يمحْضَارن نّس: "أَقَا تسْڒَام ڒْحَقّ: مشْحَاڒ يقْسح خَاس خ تَّاجَر اَذ يَاذف ڒْمُلْك وجنَّا. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />قَّارغ-اَوم عَاوذ: أَقَا يسْهڒ اَذ يعْذُو يجّن ن وڒْغم زِي ثِيطّ ن ثْسيْنفْث قْبڒ مَا ٱذ يَاذف يِجّن ن تَّاجَر ذِي ڒْمُلْك ن أَربِّـي."<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />ئِمحْضَارن ستْعجّْبن اَطَّاس وَامِي سْڒِين مَانَاينِّي، نَّان-اَس: "خْيَار، ؤُݣ يزمَّرن اَذ ينْجم؟"<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />ئِخْزَر غَارْسن عِيْسَى ينَّا-ٱسن: "مَانَايَا وَار ذَاس زمَّرن شَا يِوْذَان، وَلَكِن كُڒْشِي يزمَّر-اَس أَربِّـي."<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />ئِنْدق-د بُطْرُس ينَّا-ٱس: "أَقَا نشِّين نسْمح ذِي كُڒْشِي نذْفَار-يش، مِين غَارْنغ غَا يِيڒِين!؟"<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />ينَّا-ٱسن عِيْسَى: "أَقَا تسْڒَام ڒْحَقّ: ذِي ثُوْذَارْث نّغْنِي خْمِي غَا يقِّيم مِّيس ن بْنَاذم خ لْعَرْش نّس ن لْعَظَمَا، ؤُڒَا ذ كنِّيو ذَايِي د يذْفَارن اَذ تقِّيمم خ ثنْعَاش ن لْعَرْشَاث حمَا اَذ تْحكْمم خ ثنْعَاش ن ثْقبَّاڒ ن أَيث-إِسْرَائِيل. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />أُو مَارَّا يِنِّي يسمّْحن ذِي ثُوْذْرِين نْسن نِغ ذِي أَيثْمَاس نِغ ذِي سُوْيْثْمَاس نِغ ذِي بَابَاس ذ يمَّاس نِغ ذِي ثَارْوَا نْسن نِغ ذݣ يمَرْجعِيون نْسن خ سَّبَاب ينُو نش، أَتَاف اَغَارْسن ثِيڒِي مِيَّا ن ثْسقَّار كْتَار، أَذ وَرْثن ثُوْذَارْث ن ڒبْدَا. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />أَطَّاس إِي يدْجَان ذ يمزْوُوْرَا اَذ ذوْڒن ذ ينݣُّوْرَا، ئِنݣُّوْرَا اَذ ذوْڒن ذ يمزْوُوْرَا."<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">ڒْمَعْنَا ن يخدَّامن ن ومَرْجع وضِيڒ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />"أَقَا ڒْمُلْك وجنَّا اَمشْنَاو يجّن ن بَاب ن ومَرْجع وضِيڒ. ئِفّغ غَار صْبَاح زِيش اَذ يݣّ يخدَّامن ذݣ ومَرْجع وضِيڒ نّس. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />ئِتَافق اَك يخدَّامن نِّي خ يِجّن ن دِينَار إِ نْهَار، ئِسّكّ-يثن غَار ومَرْجع نّس. <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />ئِفّغ-د غَار جْوَايه نِّي ن تسْعَا يُوْفَا يخدَّامن نّغْنِي قِّيمن ذِي ڒْموْقف بْڒَا ڒْخذْمث. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />ينَّا-ٱسن: رُوْحم ؤُڒَا ذ كنِّيو غَار ومَرْجع ينُو، أَتَاف اَذَاوم خدْجْسغ مِين ثسْذَاهدْجم. <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />كَّرن رُوْحن. ئِفّغ-د غَار جْوَايه ن ثنْعَاش عَاوذ غَار جْوَايه ن ثْڒَاثَا وعشِّي يݣَّا نّفْس ڒْخذْمث. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />أُوْشَا يفّغ-د عَاوذ غَار جْوَايه نِّي ن خمْسَا وعشِّي، يُوْفَا يخدَّامن نّغْنِي قِّيمن بْڒَا ڒْخذْمث. ينَّا-ٱسن: مِين كنِّيو يُوْغِين ثقِّيمم ذَا نْهَار اَمن-يكْمَاڒ بْڒَا ڒْخذْمث؟ <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />نَّان-اَس: وَالُو، وَار ذَانغ يسخْذم حَدّ. ينَّا-ٱسن: رُوْحم ؤُڒَا ذ كنِّيو غَار ومَرْجع ينُو.<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />وَامِي ثغْڒِي ثْفُوْشْت، ينَّا-ٱس بَاب ن ومَرْجع إِ ؤُوقَّاف نّس: ڒَاغَا-د إِ يخدَّامن خدْجس-يثن. بْذَا زݣ يِنِّي إِي د يُوْسِين ذ ينݣُّوْرَا عَاذ إِ يمزْوُوْرَا. <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />يِنِّي يبْذَان ڒْخذْمث غَار خمْسَا وعشِّي، يُوْشَا-ٱسن دِينَار دِينَار. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />وَامِي د وْسِين يمزْوُوْرَا تْغِير-اَسن اَذَاسن يُوش كْتَار وَلَكِن لَّا، ؤُڒَا ن نِثْنِي يُوْشَا-ٱسن دِينَار دِينَار. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />وَامِي ذَاسن يُوْشَا دِينَار، مْخيَّاقن اَك بَاب ن ومَرْجع. <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />نَّان-اَس: ئِخدَّامن-أَ إِي د يُوْسِين ذ ينݣُّوْرَا خذْمن يجّن ن ثْسَعَّات وَاهَا، شك ثُوْشِيذ-اَسن اَمشْنَاو نشِّين إِݣ يُوْوْثِين تَمَارَا ن نْهَار اَمن-يكْمَاڒ ذِي ثْفُوْشْت. <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />ئِنْدق-د بَاب ن ومَرْجع ينَّا-ٱس إِ يِجّن زَّايْسن: وَار ش شْمِيثغ شَا آي اَمدُّوْكڒ. يَاش شك ثْتَافْقذ اَكِذِي خ يِجّن ن دِينَار نِغ لَّا؟ <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />يْسِي تخْڒِيسث نّش ؤُيُوْر. خْسغ اَذَاس ؤُشغ إِ وَا إِي د يُوْسِين ذ اَنݣَّارُو اَنشْت نّش. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />مَا وَار غَارِي ڒْحَقّ اَذ ݣّغ مِين خْسغ زِي ثْمسْڒَايِين ينُو؟ نِغ ثْحسْذذ-اَيي وَامِي دْجِيغ صَاخِي؟<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />أَمنِّي يِنِّي يدْجَان ذ ينݣُّوْرَا اَذ ذوْڒن ذ يمزْوُوْرَا؛ يِنِّي يدْجَان ذ ئِمزْوُوْرَا اَذ ذوْڒن ذ ينݣُّوْرَا."<verse eid="MAT 20:16" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسَّاوَاڒ عَاوذ خ ڒْموْث نّس</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />وَامِي يݣَعّذ عِيْسَى غَار ثنْدِينْت ن لْقُدْس، ذݣ وبْرِيذ ئِرُوْح يُوْوِي ثنْعَاش نِّي ن يمحْضَارن نّس وَاحذْسن ينَّا-ٱسن: <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />"أَقَا نتْݣَعَّاذ غَار لْقُدْس مَانِي غَا يتْوَاخْذع مِّيس ن بْنَاذم إِ اَرُّوْيَاس ن ڒْفُقَهَا ذ يمْسڒْمَاذن ن شَّرِيعَا. أَخَاس حكْمن س ڒْموْث، <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />أَث سلّْمن إِ يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل. أَخَاس ضحْشن، اَث ؤُوْثن س وسْغُوْن، اَث صلّْبن. نْهَار وِيس ثڒْتِيَّام اَذ د يتْوَاسْنكَّر زِي ڒْموْث."<verse eid="MAT 20:19" /></para>
  <para style="s">طَّلب ن يمَّاثْسن ن ثَارْوَا ن زَبَادِي</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />ئِجّن ن ثمْغَارْث، نتَّاث ذ يمَّاثْسن ن ثَارْوَا ن زَبدِي، ثْقَارّب غَار عِيْسَى اَك ثْنَاين ن ثَارْوَا ن نّس ثْسجّذ-اَس حمَا اَزَّايس ثتَّار شَان ڒْحَاجث. <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />ينَّا-ٱس عِيْسَى: "مِين ثْرزُّوْذ؟"</para>
  <para style="p" vid="MAT 20:21">ثنَّا-ٱس: "إِن-اَيِي اَذ قِّيمن يِيْنَا ثَارْوَا ينُو س ثْنَاين ذِي ڒْمُلْك نّش يجّن خ وفُوْسِي يجّن خ وࢲڒْمَاض نّش."<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />ئِنْدق-د عِيْسَى <char style="it">ينَّا-ٱسن إِ يَعْقُوْب ذ يُوْحَنَّا</char>: "كنِّيو وَار ثْسِّينم شَا مِين ثتَّارم. مَا ثْزمَّرم اَذ تسْوم زِي ڒْكَاس نِّي إِي زِي غَا سْوغ نش عْڒَاين؟"</para>
  <para style="p" vid="MAT 20:22">نَّان-اَس: "وَاه، نْزمَّر-اَس!"<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />ينَّا-ٱسن: "وَاه، أَتَاف اَذ تسْوم زِي ڒْكَاس ينُو. وَلَكِن اَغِيمِي خ وفُوْسِي ينُو ذ وࢲڒْمَاض ينُو وَار يدْجِي بُو ذ نش إِي ث غَا يُوْشن، أَذ يمُّوْش إِ يِنِّي ؤُمِي ثن يسوْجذ بَابَا."<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />عشْرَا نِّي ن يمحْضَارن وَامِي سْڒِين خ مِين رزُّوْن ثْنَاين نِّي ن وَاوْمَاثن وَار ذَاسن يعْجِيب شَا ڒْحَاڒ. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />ئِڒَاغَا-يَاسن-د عِيْسَى مَارَّا إِذْسن ينَّا-ٱسن: "قَا ثسّْنم اَرُّوْيَاس ن ثْمُوْرَا حكّْمن خ شُّعُوْب نْسن، يِنِّي يمقّْرَانن زَّايْسن تْزيَّرن خَاسن. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />وَلَكِن مَانَاينِّي يتْخصَّا وَار يتِيڒِي شَا جَارَاوم. لَّا، ونِّي يرزُّوْن اَذ يذْوڒ ذ اَمقّْرَان جَارَاوم يتْخصَّا-يَاس اَذ يِيڒِي ذ اَخدَّام نْوم. <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />ونِّي يرزُّوْن اَذ يذْوڒ ذ اَمزْوَارُو جَارَاوم يتْخصَّا-يَاس اَذ يِيڒِي ذ يسْمغ<note caller="+" style="f"><char style="fr" closed="false">20‏.27 </char><char style="ft" closed="false">ئِسْمغ نتَّا ذ لْعَبِيد.</char></note> نْوم. <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />مِّيس ن بْنَاذم ؤُڒَا ذ نتَّا وَار د يُوْسِي شَا حمَا اَخَاس خذْمن يِوْذَان. لَّا، نتَّا يُوْسَا-د حمَا اَخَاسن يخْذم، أَخَاسن يصدّق ثُوْذَارْث نّس حمَا اَذ يسنْجم اَطَّاس زَّايْسن."<verse eid="MAT 20:28" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسْݣنْفَا ثْنَاين ن يضَرْغَاڒن ذِي أَرِيحَا</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />وَامِي فّْغن زِي ثنْدِينْت ن أَرِيحَا، ذْفَارن-د عِيْسَى اَطَّاس ن ڒْغَاشِي. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />ذِنِّي ثْنَاين ن يضَرْغَاڒن قِّيمن خ طَّارْف ن وبْرِيذ. وَامِي سْڒِين إِ عِيْسَى يݣُّوْر-د، سْنكَّرن ثْغُوْيّث قَّارن: "آ سِيذِي آ مِّيس ن أَيث-دَاود، رْحم-اَنغ!" <verse eid="MAT 20:30" /><verse number="31" style="v" sid="MAT 20:31" />زيَّرن خَاسن يِوْذَان نَّان-اَسن سْقَرم، وَلَكِن نِثْنِي قِّيمن سْنكَّرن ثْغُوْيّث عَاذ س جّْهذ قَّارن: "آ سِيذِي آ مِّيس ن أَيث-دَاود، رْحم-اَنغ!"<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />ئِبدّ عِيْسَى، ئِڒَاغَا-يَاسن-د ينَّا-ٱسن: "مِين ثخْسم اَذَاوم ݣّغ؟"<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />نَّان-اَس: "آ سِيذِي، قَا نخْس اَذ نُوْرْزْمنْت ثِيطَّاوِين نّغ!"<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />قّْسن-اَس إِ عِيْسَى يحَاذَا-يَاسن ثِيطَّاوِين نْسن. ذݣ ومْشَان ذوْڒن تْوَاڒَان أُوشَا ذْفَارن-ث.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">سِيذِيثْنغ عِيْسَى يتَاذَاف خ وسْنُوْس غَار لْقُدْس</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />وَامِي قَارّْبن غَار ثنْدِينْت ن لْقُدْس ؤُوْضن غَار وبِيلَاج ن بَيْت فَاجِي زَّاث إِ وذْرَار ن زِّيتُوْن، ئِكَّر عِيْسَى يسّكّ ثْنَاين زݣ يمحْضَارن نّس، <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />ينَّا-ٱسن: "رُوْحم غَار وبِيلَاج-ين يدْجَان زَّاثْوم، أَذ تَافم ذِنِّي ثَغْيُوْڒْث ثقّن اَكِذس اَسْنُوْس. فْسِيم-اَسن اَوِيم-ثن-د غَارِي. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />مڒَا يسِّيوڒ غَارْوم شَان يِجّن ينَّا-ٱوم شَا، إِينِيم-اَس قَا يحْذَاج-يثن سِيذِيثْنغ. ڒخْدّنِّي اَكِوم-ثن-د يسّكّ."<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />أَمُّو يوْقع حمَا اَذ يكمّڒ وَاوَاڒ إِي ينَّا سِيذِي أَربِّـي إِ نَّبي <char style="it">زَكَرِيَا</char> ذݣ يِجّن ن زْمَان:<verse eid="MAT 21:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="MAT 21:5" />"إِيْنِيم-اَس إِ يدْجِيس ن لْقُدْس:</para>
  <para style="q1" vid="MAT 21:5">خْزَر، أَزدْجِيذ نّمْ يُوْسَا-د غَارم، وَار ذَايس بُو تَّكبُّر.</para>
  <para style="q1" vid="MAT 21:5">ئِنْيَا خ يِجّن ن ثغْيُوْڒْث، ذ وسْنُوْس مِّيس ن ثغْيُوْڒْث."<verse eid="MAT 21:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />رُوْحن ثْنَاين نِّي ن يمحْضَارن، ݣِّين مَامش ذَاسن ينَّا عِيْسَى. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />ؤُوِين-د ثَغْيُوْڒْث ذ وسْنُوْس، ݣِّين خَاسن يزدْجُوْبَا نْسن ڒخْدّنِّي ينْيَا عِيْسَى. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />أَطَّاس ن يِوْذَان سُّوْن-اَس اَبْرِيذ س يزدْجُوْبَا نْسن. ئِنّغْنِي قسّن ڒفْرُوْع ن ڒْشجُّوْر سُّوْن زَّايْسن اَبْرِيذ. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />يِنِّي يݣُّوْرن زَّاثس ذ يِنِّي إِي ث يذفَّارن قَّارن:</para>
  <para style="q2" vid="MAT 21:9">"لْعَظَمَا إِ مِّيس ن أَيث-دَاود!</para>
  <para style="q1" vid="MAT 21:9">سَّعْذ ن ونِّي إِي د يُوْسِين عْلَاحْسَاب يسم ن سِيذِي أَربِّـي.</para>
  <para style="q2" vid="MAT 21:9">لْحَمْدُ إِ أَربِّـي يُوْعْڒَان."<verse eid="MAT 21:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />وَامِي يُوْذف عِيْسَى غَار ثنْدِينْت ن لْقُدْس، كَّرن-د اَيثْبَاب ن ثنْدِينْت نَّان: "مِين يعْنَا وَا؟" <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />نَّان ڒْغَاشِي قَا وَانِيتَا ذ نَّبي عِيْسَى زݣ وبِيلَاج ن نَاصِرَا ذِي ثْمُوْرْث ن لْجَلِيل."<verse eid="MAT 21:11" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى ذِي ثمْزِيذَا ثَمقّْرَانْت ن أَيث-إِسْرَائِيل</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />يُوْذف عِيْسَى غَار ثمْزِيذَا ثَمقّْرَانْت يُوْزّڒ خ مَارَّا خ يِنِّي يسَّاغن ذ يِنِّي يزْنُوْزَان. ئِقْڒب-اَسن مِيسَّاث ن يِنِّي يتْصَرَّافن تْمنْيَاث ذ ڒكْرَاسَا ن يِنِّي يزْنُوْزَان يذْبِيرن. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />ينَّا-ٱسن: "لْكِتَاب يقَّار: &lt;ثَدَّارْث ينُو اَذ تِيڒِي ذ ثَدَّارْث ن ثْࢲَادْجِيث.&gt; وَلَكِن كنِّيو ثَارِّيم-تث ذ يفْرِي ن يخوَّانن."<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />ذِي ثمْزِيذَا ثَمقّْرَانْت قَارّْبن-د غَار عِيْسَى يضَرْغَاڒن ذ يزحَّافن أُوشَا يسْݣنْفَا-ثن. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />عصّْبن اَرُّوْيَاس ن ڒْفُقَهَا ذ يمْسڒْمَاذن ن شَّرِيعَا وَامِي ࢲْرِين <char style="it">عِيْسَى</char> لْمُعْجِزَاث إِي يݣَّا، ذ يحنْجِيرن طَّارْف إِ ثمْزِيذَا ثَمقّْرَانْت تْڒَاغَان س جّْهذ قَّارن: "لْعَظَمَا إِ مِّيس ن أَيث-دَاود!" <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />نَّان-اَس إِ عِيْسَى: "مَا تسْڒِيذ مِين خَاك قَّارن؟"</para>
  <para style="p" vid="MAT 21:16">ينَّا-ٱسن عِيْسَى: "وَاه، مَا وَار ثغْرِيم <char style="it">مِين يدْجَان ذِي لْكِتَاب</char>؟ &lt;ثݣِّيذ، <char style="it">آي أَربِّـي</char>، أَش حمْذن يحنْجِيرن ذ يسيْمَان س وقمُّوْم نْسن.&gt;"<note caller="+" style="f"><char style="fr" closed="false">21‏.16 </char><char style="ft" closed="false">خْزَر زَّبُور 8‏:2.</char></note> <verse eid="MAT 21:16" /><verse number="17" style="v" sid="MAT 21:17" />سّنِّي يسْمح ذَايْسن، يفّغ زِي ثنْدِينْت نِّي يرُوْح غَار وبِيلَاج ن بَيْت عَنْيَا يسنْس ذِنِّي.<verse eid="MAT 21:17" /></para>
  <para style="s">ثَشجَّارْث ن ثَازَارْث يُوْزْغن</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />غَار صْبَاح زِيش يݣَعّذ عِيْسَى غَار ثنْدِينْت، نتَّا يدْجُوْز. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />ئِࢲْرَا يجّن ن ثْشجَّارْث ن ثَازَارْث خ وبْرِيذ يرُوْح غَارس يُوْفِي-ت ذَايس ثِيفْرَاي وَاهَا. ينَّا-ٱس: "شم زِي سَّا اَڒ ثْسَاونْت عمَّارْص اَذ تَارْوذ." ڒخْدّنِّي ثُوْزغ ثْشجَّارْث نِّي ن ثَازَارْث.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />ئِمحْضَارن نّس وَامِي ࢲْرِين مِين يوقْعن، تْعجّْبن نَّان-اَس إِ عِيْسَى: "مَامّش ثݣَّا ثْشجَّارْث-أَ ثُوْزغ ذݣ ومْشَان؟"<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: "أَقَا تسْڒَام ڒْحَقّ: مْڒِي ذَايْوم لْإِيمَان وَار ثْشكِّيم شَا، أَتَاف اَذ تݣّم كْتَار زِي مِين يتْوَاݣّن إِ ثْشجَّارْث-أَ. مڒَا ثنِّيم إِ وذْرَار-أَ: نقْڒع-د شك سَّانِيتَا ثْمنْضَارذ ذِي ڒبْحَر، أَتَاف اَذ ينقْڒع. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />ينَّا-ٱسن: مڒَا ثُوْمْنم، أَغَارْوم يِيڒِي مَارَّا مِين غَا ثتَّارم إِ أَربِّـي ذِي ثْࢲَادْجِيث نْوم."<verse eid="MAT 21:22" /></para>
  <para style="s">سُّلْطَا ن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />يُوْذف عِيْسَى ذِي ثمْزِيذَا ثَمقّْرَانْت يسڒْمَاذ ذِنِّي. قَارّْبن-د غَارس اَرُّوْيَاس ن ڒْفُقَهَا ذ يمقّْرَانن زِي أَيث-إِسْرَائِيل نَّان-اَس: "شك مَانِيس ذَاش د ثكَّا سُّلْطَا نِّي إِي زِي تݣّذ ثِمسْڒَايِين-أَ؟ وِي ذَاش يُوْشِين سُّلْطَا نِّي؟"<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: "ؤُڒَا ذ نش اَكنِّيو سّقْسِيغ خ يِجّن ن ثْمسْڒَايْث. مڒَا ثْجَاوْبم-اَيِي-د خَاس، أَتَاف اَذَاوم ينِيغ زِي مَانِيس ذَايِي د ثكَّا سُّلْطَا-يَا إِي زِي تݣّغ ثِمسْڒَايِين-أَ. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />يَحْيَى، مَان سُّلْطَا إِي زِي يطهَّار س وَامَان، مَا زِي أَربِّـي مَا زݣ يِوْذَان؟"</para>
  <para style="p" vid="MAT 21:25">سِّيوْڒن جَارَاسن نَّان: "مڒَا ننَّا-ٱس زِي أَربِّـي، أَتَاف اَذَانغ يِينِي <char style="it">عِيْسَى</char> مَايمِّي وَار زَّايس ثُوْمِينم شَا؟ <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />مڒَا ننَّا-ٱس <char style="it">سُّلْطَا نِّي</char> ثكَّا-د زݣ يِوْذَان، أَتَاف نشِّين أَ نݣّْوذ زِي شَّعْب مِينْزِي مَارَّا شَّعْب تْوَاڒَان بلِّي يَحْيَى نتَّا ذ نَّبِي." <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />كَّرن نَّان-اَس إِ عِيْسَى: "وَار نسِّين شَا."</para>
  <para style="p" vid="MAT 21:27">ئِنْدق-د عِيْسَى ينَّا-ٱسن: "إِيوَا ؤُڒَا ذ نش وَار ذَاوم قَّارغ شَا مَانِيس ذَايِي د ثكَّا سُّلْطَا-يَا إِي زِي تݣّغ ثِمسْڒَايِين-أَ."<verse eid="MAT 21:27" /></para>
  <para style="s">ڒْمَعْنَا ن ثْنَاين ن وَاوْمَاثن</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />"مِين ذَاوم يمظْهَارن؟ ئِجّن ن بْنَاذم غَارس ثْنَاين ن ثَارْوَا نّس. ئِرُوْح غَار ومزْوَارُو ينَّا-ٱس: آ مِّي، رُوْح اَذ تْخذْمذ نْهَارَا ذݣ ومَرْجع ينُو وضِيڒ. <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />ئِنْدق-د مِّيس ينَّا-ٱس: لَّا، وَار تْرَاحغ شَا. وَلَكِن منْبَعْد شْوَايْت ينْدم، ئِرُوْح غَار ومَرْجع. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />ئِرُوْح غَار مِّيس نّغْنِي ينَّا-ٱس مِين ذَاس ينَّا إِ مِّيس نِّي اَمزْوَارُو. يَارَّا خَاس ينَّا-ٱس: وَاخَّا آ بَابَا ينُو. وَلَكِن وَار يرُوْح شَا. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />ؤُو يݣِّين مِين يخس بَابَاثْسن زِي ثْنَاين-أَ؟"</para>
  <para style="p" vid="MAT 21:31">نَّان-اَس: "أَمزْوَارُو."</para>
  <para style="p" vid="MAT 21:31">ينَّا-ٱسن عِيْسَى: "أَقَا تسْڒَام ڒْحَقّ: ئِعشَّارن ذ ثمْغَارِين يفّْغن اَبْرِيذ اَذَاوم يزْوَارن غَار ڒْمُلْك ن أَربِّـي. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />ڒَاحقَّاش يُوْسَا-د غَارْوم يَحْيَى يسظْهَار-اَوم-د اَبْرِيذ ن ڒْحَقّ، وَار زَّايس ثُوْمِينم شَا. وَلَكِن يعشَّارن ذ ثمْغَارِين يفّْغن اَبْرِيذ ؤُمْنن زَّايس. كنِّيو ثࢲْرِيم مَانَاينِّي، وَلَكِن وَار تُوْبم شَا حمَا اَزَّايس ثَامْنم."<verse eid="MAT 21:32" /></para>
  <para style="s">ڒْمَعْنَا ن يخمَّاسن إِي ذِي يدْجَا شَّرّْ</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />"صنّْطث إِ يِجّن ن ڒْمَعْنَا نّغْنِي. ئِجّن ن بَاب ن ثدَّارْث يࢲُّو اَضِيڒ ذݣ يِجّن ن ومَرْجع نّس. ئِنّض-اَس-د ڒْحِيض، ئِݣَّا ذَايس ثَسِيرْث وضِيڒ. ئِبْنَا ذَايس يجّن ن ثْسُوْمْعث إِ ڒْعَسّث. ئِݣَّا ذَايس يخمَّاسن يرُوْح يسَفَر. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />وَامِي د يُوْوض ڒْوقْث ن وڒْقض ن وضِيڒ، ئِكَّر يسّكّ يخدَّامن نّس غَار يخمَّاسن نِّي بَاش اَذَاس د ؤُشن ڒْحَقّ نّس ن وضِيڒ. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />وَلَكِن مِين ݣِّين يخمَّاسن نِّي؟ طّْفن يخدَّامن نّس، ئِجّن ؤُوْثِين-ث، ئِجّن نْغِين-ث، ئِجّن رجْمن-ث. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />ئِكَّر يسّكّ يخدَّامن نّغْنِي كْتَار زݣ ومزْوَارُو. ݣِّين-اَسن يخمَّاسن نِّي مِين ݣِّين إِ يمزْوُوْرَا. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />غَار ونݣَّارُو يكَّر يسّكّ غَارْسن مِّيس. ينَّا اَقَا اَذ ݣّْوْذن ممِّي. <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />وَامِي ؤُفِين يخمَّاسن نِّي مِّيس يُوْسَا-د، نَّان إِ وَايَاوْيَا: أَث نْنغ بَاش اَذَاس نَاوِي اَمَرْجع ن وضِيڒ! <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />طّْفن-ث، نْغِين-ث، نْضَرن-ث-يذ غَار بَرَّا إِ ومَرْجع وضِيڒ.<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />إِيوَا خْمِي إِي د غَا يذْوڒ بَاب ن ومَرْجع، مِين ذَاسن غَا يݣّ إِ يخمَّاسن نِّي؟"<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />نَّان-اَس: "ئِوْذَان نِّي يعفَّانن اَثن ينغ، أُوشَا اَذ يجّ اَمَرْجع وضِيڒ إِ يخمَّاسن نّغْنِي إِي ذَاس غَا ؤُشن ڒْحَقّ نّس وضِيڒ ذِي ڒْوقْث."<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />ينَّا-ٱسن عِيْسَى: "مَا عمَّارْص وَار ثغْرِيم مِين يُوْرِين ذِي لْكِتَاب؟</para>
  <para style="q1" vid="MAT 21:42">&lt;أَزْرُو إِي عِيفّن يبنَّاين،</para>
  <para style="q1" vid="MAT 21:42">يوْقع ذݣ ومْشَان اَصبْحَان ذِي ثْغمَّارْث ن دْسَاس.</para>
  <para style="q1" vid="MAT 21:42">ذ سِيذِي أَربِّـي إِݣ يݣِّين مَانَايَا،</para>
  <para style="q1" vid="MAT 21:42">ذ يجّن ن ڒْحَاجث ذ ثَمقّْرَانْت!&gt;<note caller="+" style="f"><char style="fr" closed="false">21‏.42 </char><char style="ft" closed="false">خْزَر زَّبُور 118‏:22‏-23.</char></note><verse eid="MAT 21:42" /></para>
  <para style="b" />
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />س مَانَايَا قَّارغ-اَوم: ڒْمُلْك ن أَربِّـي اَذَاوم يتْوَاكّس اَذ يمُّوْش إِ يِجّن ن شَّعْب إݣ يتݣّن ڒْخِير. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />ونِّي غَا يوْضَان خ وزْرُو-يَا اَذ يرز. ونِّي خف غَا يوْضَا وزْرُو-يَا اَذ ينڒْبࢲ."<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />وَامِي سْڒِين اَرُّوْيَاس ن ڒْفُقَهَا ذ ڒْحِزب ن يفَرِّيسِيْين إِ ڒمْعَانِي ن عِيْسَى فهْمن بلِّي يسَّاوَاڒ خَاسن. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />رزُّوْن اَث طّْفن، وَلَكِن ݣّْوْذن زِي شَّعْب مِينْزِي تْوَاڒَان عِيْسَى ذ نَّبِي.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">ڒْمَعْنَا ن ومنْسِي اَمقّْرَان</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />ئِسَّاوَاڒ عِيْسَى اَكِذْسن عَاوذ س ڒمْعَانِي، ئِنْدق-د ينَّا-ٱسن: <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />"ڒْمُلْك وجنَّا اَمشْنَاو يج وزدْجِيذ يݣَّا اَمنْسِي ذ اَمقّْرَان ذِي ڒْفَارْح ن مِّيس. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />ئِسّكّ يخدَّامن نّس اَذ د ڒَاغَان إِ يِنِّي خف يعَرض غَار ومنْسِي، وَلَكِن ؤُݣِين اَذ د اَسن. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />ئِسّكّ يخدَّامن نّغْنِي ينَّا-ٱسن: إِينِيم-اَسن إِ يِنِّي يتْوَاعَرْضن: أَقَا نش سْوجْذغ اَمنْسِي ينُو، غَرْصغ يعجْمِيْين<note caller="+" style="f"><char style="fr" closed="false">22‏.4 </char><char style="ft" closed="false">ئِعجْمِيْين نِثْنِي ذ يمْوَاثن.</char></note> ذ يينْدُوْزن ينُو يصحَّان. كُڒْشِي يوْجذ، أَرَاحم-د غَار ڒْفَارْح! <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />وَلَكِن يِنِّي يتْوَاعَرْضن وَار ذَايس ت ؤُوِين شَا: ئِجّن يرُوْح غَار ومَرْجع نّس، ئِجّن غَار تِّجَارَا نّس. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />ئِنّغْنِي طّْفن يخدَّامن ن وزدْجِيذ عدّن خَاسن نْغِين-ثن. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />ئِغْضب وزدْجِيذ يسّكّ ڒْعَسْكَار نّس اَذ نْغن لْمُجْرِمِين نِّي اَذ سْحرْقن ثَنْدِينْت نْسن. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />ينَّا-ٱسن إِ يخدَّامن نّس: أَمنْسِي ن ڒْفَارْح يوْجذ، وَلَكِن يِنِّي يتْوَاعَرْضن وَار ث سْذِيهْيدْجن شَا. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />افّْغث غَار مَانِي تمْسَاݣَارن يبْرِيذن عَرْضم-د غَار ومنْسِي مَارَّا وِي غَا ثَافم ذِنِّي. <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />رُوْحن يخدَّامن نِّي غَار يبْرِيذن ؤُوِين-د مَارَّا ؤُݣ ؤُفِين ذِنِّي، ئِصبْحَانن ذ يعفَّانن، ثْعمَّر سَّاحَا س ينوْجِيْون.<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />يُوْذف وزدْجِيذ حمَا اَذ يࢲر ينوْجِيْون، يُوْفَا ذِنِّي يجّن ن ورْيَاز وَار يَرض بُو وَارُّوْض ن ڒْفَارْح. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" /><char style="it">ئِرُوْح غَارس</char> ينَّا-ٱس: آي اَمدُّوْكڒ، مَامّش ثݣِّيذ ثُوْذْفذ-د بْڒَا اَرُّوْض ن ڒْفَارْح؟ أَرْيَاز نِّي يسْتُوْك. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />أُوْشَا ينَّا-ٱسن وزدْجِيذ إِ يخدَّامن نّس: شَرْفم-ث زݣ يضَارن ذ يفَاسّن نْضَرم-ث بَارَّا غَار ثَادْجسْت مَانِي غَا يڒِين يمطَّاون ذ وغࢲَّاࢲ ن ثغْمَاس."<verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />ينَّا-ٱسن عِيْسَى: "أَقَا اَطَّاس إِݣ يتْوَاعَرْضن، ذْرُوْس إِي غَا يتْوَاخْضَرن."<verse eid="MAT 22:14" /></para>
  <para style="s">ئِفَرِّيسِيْين ذ يِوْذَان ن وزدْجِيذ تْجَرَّابن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />كَّرن يفَرِّيسِييْن مْشَاوَارن جَارَاسن ݣِّين يجّن ن لْخُطَا اَذ طّْفن عِيْسَى خ مِين يقَّار. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />سّكّن غَارس شَان يمحْضَارن نْسن اَك شَان يِوْذَان زِي ڒْحِزب ن وزدْجِيذ هِيرُوْدُس اَذَاس ينِين: "آ لْمُعَلِّم قَا نسّن بلِّي شك نِيشَان إِي ثدْجِيذ. وَار تݣّْوْذذ شَا زݣ يِوْذَان ڒَاحقَّاش وَار تݣّذ بُو س وُوْذمَاون. ثْسڒْمَاذذ س ڒْحَقّ مَامّش يخس أَربِّـي أَ نْعِيش. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />إِينِي-يَانغ، مِين ذَاش يمظْهَارن؟ ثْسمّح شَّرِيعَا نّغ أَ نْخدْجس ضَّرِيبَا إِ وزدْجِيذ قَيْصَر نِغ لَّا؟"<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />ئِسّن عِيْسَى يخَرْوِيضن نِّي إِي ذَايْسن ينَّا-ٱسن: "آ لْمُنَافِقِين، مَايمِّي ذَايِي ثْسوْجَاذم ثَخْشبْث؟ <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />أَوِيم-اَيِي-د دِينَار نِّي <char style="it">ن ضَّرِيبَا</char> حمَا اَث ࢲرغ." كَّرن ؤُوِين-اَس-د يجّن ن دِينَار. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />ينَّا-ٱسن: "وِي يِيڒَان تصْوِيرْث-أَ ذ يِيسم-أَ إِي ذَايس؟"<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />نَّان-اَس: "ن قَيْصَر."</para>
  <para style="p" vid="MAT 22:21">ئِنْدق-د عِيْسَى ينَّا-ٱسن: "مِين يدْجَان ن قَيْصَر ؤُشم-اَس-ث إِ قَيْصَر. مِين يدْجَان ن أَربِّـي ؤُشم-اَس-ث إِ أَربِّـي."<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />وَامِي سْڒِين إِ وجَاوَب نِّي قِّيمن تْعجّْبن ذَايس. سّنِّي سمْحن ذَايس ؤُيُوْرن.<verse eid="MAT 22:22" /></para>
  <para style="s">ئِصَدُّوْقِيْين تْجَرَّابن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />ذِي نْهَار نِّي، قَارّْبن-د غَار عِيْسَى شَان يِوْذَان زِي ڒْحِزب ن يصَدُّوْقِيْين (نِثْنِي قَّارن بلِّي يوْذَان وَار د تكَّرن شَا زِي ڒْموْث). <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />كَّرن نَّان-اَس: "آ لْمُعَلِّم، ئِقَّار-اَنغ مُوْسَى اَرْيَاز مڒَا يمُّوْث وَار ذ يجِّي بُو ثَارْوَا، ثَاجَّاڒْث نّس اَت يَاوِي ؤُڒْوس نّس بَاش اَكِذس د يجّ ثَارْوَا إِ وُوْمَاس نِّي يمُّوْثن. <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />نشِّين تُوْغَا اَكِذْنغ سبْعَا ن وَاوْمَاثن، ئِمْڒش ومزْوَارُو يمُّوْث وَار ذ يجِّي بُو ثَارْوَا. ثَمْغَارْث نِّي يُوْوِي-ت ؤُڒْوس نّس. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />أَمنِّي إِݣ يوقْعن إِ وُوْمَاس وِيس ثْنَاين ذ وِيس ثْڒَاثَا اَڒ وِيس سبْعَا. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />أَڒ ونݣَّارُو ؤُڒَا ذ ثَمْغَارْث نِّي ثمُّوْث. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />يُوْم لْقِيَامَا، ؤُمِي غَا ثِيڒِي ثمْغَارْث نِّي؟ أَقَا ؤُوِين-ت س سبْعَا إِذْسن."<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: "كنِّيو ثخْضَام ڒَاحقَّاش وَار ثسِّينم شَا لْكِتَاب ؤُڒَا ذ جّْهذ ن أَربِّـي. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />خْمِي د غَا كَّرن يِنِّي يمُّوْثن <char style="it">يرْيَازن ذ ثمْغَارِين</char> وَار مدْجْشن شَا وَار تْوَاسْمدْجِيشن شَا؛ لَّا، أَذ يڒِين اَمشْنَاو لْمَلَائِكَاث إِݣ يدْجَان ذݣ وجنَّا. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />وَلَكِن شُوْف، يِنِّي يمُّوْثن اَذ د كَّرن زِي ڒْموْث. مَا عمَّارْص وَار ثغْرِيم مِين ذَاوم يقَّار أَربِّـي؟ <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" /><char style="it">ئِقَّار</char> قَا نش ذ أَربِّـي ن بْرَاهِيم، ذ أَربِّـي ن إِسْحَاق، ذ أَربِّـي ن يَعْقُوْب."<note caller="+" style="f"><char style="fr" closed="false">22‏.32 </char><char style="ft" closed="false">خْزَر ؤُفُوغ (الخروج) 3‏:6.</char></note> <char style="it">ينَّا-ٱسن عِيْسَى:</char> "نتَّا ذ أَربِّـي ن يِنِّي يدَّرن مَاشِي ن يِنِّي يمُّوْثن."<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />سْڒِين يِوْذَان إِ وَاوَاڒ-أَ، ذهْشن ذݣ وسڒْمذ نّس.<verse eid="MAT 22:33" /></para>
  <para style="s">ئِجّن زݣ يفَرِّيسِيْين يتْجَرَّاب سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />كَّرن ڒْحِزب ن يفَرِّيسِيْين وَامِي د اَرِّين ڒخْبَار بلِّي عِيْسَى يبلّع اَقمُّوْم ن يصَدُّوْقِيْين، ڒخْدّنِّي مُوْنن جَارَاسن. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />ئِرُوْح يِجّن زَّايْسن نتَّا يتْشرَّاح شَّرِيعَا، ئِخس اَذ يجَرّب عِيْسَى ينَّا-ٱس: <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />"آ لْمُعَلِّم، مِين ثعْنَا ڒُوْصِيّث إِي يدْجَان ذ ثَمقّْرَانْت قَاع ذِي شَّرِيعَا؟"<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />ينَّا-ٱس عِيْسَى: "أَذ تخْسذ سِيذِي أَربِّـي نّش س مَارَّا وڒ نّش، س مَارَّا اَرُّوْح نّش، س مَارَّا ڒَعْقڒ نّش.<note caller="+" style="f"><char style="fr" closed="false">22‏.37 </char><char style="ft" closed="false">خْزَر أَفسَّار ن شَّرِيعَا ن مُوسَى (التثنية) 6‏:5.</char></note> <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />ذ ثَا ذ ڒُوْصِيّث إِي يدْجَان ذ ثَمقّْرَانْت ذ ثَمزْوَارُوْت. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />ڒُوْصِيّث وِيس ثْنَاين اَم ثنِّي ثَمزْوَارُوْت: أَذ تخْسذ اَجَّار نّش اَمشْنَاو يخف نّش.<note caller="+" style="f"><char style="fr" closed="false">22‏.39 </char><char style="ft" closed="false">خْزَر لْكِتَاب ن أَيث لَاوِي 19‏:18.</char></note> <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />ثْنَاين-أَ ن ڒُوْصِيَاث إِي خف ثبْنَا شَّرِيعَا ن مُوْسَى اَمن-ثكْمَاڒ ذ تَّعَالِيم ن لْأَنْبِيَا."<verse eid="MAT 22:40" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يتْجَرَّاب يفَرِّيسِيْين</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />ڒْحِزب ن يفَرِّيسِيْين اَقَاثن مُوْنن ذِنِّي. ئِكَّر عِيْسَى يسّقْسَا-ثن <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />ينَّا-ٱسن: "مِين ذَاوم يمظْهَارن ذِي لْمَسِيح؟ ؤُو ث يِيڒَان؟"</para>
  <para style="p" vid="MAT 22:42">نَّان-اَس: "ذ مِّيس ن دَاود."<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />ينَّا-ٱسن عِيْسَى: "إِيوَا مَامّش دَاود يقَّار-اَس إِ مِّيس س أَرُّوْح ن أَربِّـي: آ سِيذِي؟ مِينْزِي دَاود ينَّا:<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />سِيذِي أَربِّـي ينَّا-ٱس إِ سِيذِي: قِّيم-د خ وفُوْسِي ينُو</para>
  <para style="q1" vid="MAT 22:44">أَڒ د غَا ݣّغ ڒْعَذْيَان نّش سْوَادَّاي إِ يضَارن نّش.<note caller="+" style="f"><char style="fr" closed="false">22‏.44 </char><char style="ft" closed="false">خْزَر زَّبُور 110‏:1.</char></note><verse eid="MAT 22:44" /></para>
  <para style="b" />
  <para style="p">
    <verse number="45" style="v" sid="MAT 22:45" />مَامّش غَا يِيڒِي <char style="it">لْمَسِيح</char> ذ مِّيس ن دَاود؟ نتَّا دَاود يقَّار-اَس <char style="it">إِ لْمَسِيح</char>: آ سِيذِي."<verse eid="MAT 22:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46" />ؤُڒَا ذ يجّن وَار يزمَّر اَخَاس يَرّ شَا ن وَاوَاڒ. أُو زِي نْهَار نِّي وَار يزْعِيم حَدّ اَث يسّقْسَا عَاذ كْتَار.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">ڒفْضِيحَاث ن يمْسڒْمَاذن ن شَّرِيعَا ذ ڒْحِزب ن يفَرِّيسِيْين</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />ئِسِّيوڒ عِيْسَى اَك يمحْضَارن نّس ذ يِوْذَان <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />ينَّا-ٱسن: "ئِمْسڒْمَاذن ن شَّرِيعَا ذ ڒْحِزب ن يفَرِّيسِيْين قِّيمن-اَس إِ مُوْسَى خ ڒْكُرْسِي نّس، <char style="it">يعْنِي سڒْمَاذن شَّرِيعَا نّس</char>. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />خ مَانَايَا، تݣّث مَارَّا مِين ذَاوم قَّارن، خذْمم زَّايس. وَلَكِن وَار تݣّم شَا اَم نِثْنِي، مَايمِّي؟ لِأَنَّا نِثْنِي وَار تݣّن شَا مِين قَّارن. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />تْشدَّان ڒحْمڒ يذقْڒن يقسْحن خ يِوْذَان حمَا اَث اَرْبُوْن، وَلَكِن وَار تْحِيذِين شَا ڒحْمڒ نِّي ؤُڒَا س ؤُضَاض نْسن. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />مَارَّا مِين تݣّن حمَا اَغَارْسن خْزَرن يِوْذَان: تݣّن ڒحْرُوْز<note caller="+" style="f"><char style="fr" closed="false">23‏.5 </char><char style="ft" closed="false">ڒحْرُوْز-أَ ذَايْسن شَان لْأَيَاث تْشدَّان-ثن يسْرَائِيلِيْين ذݣ وفُوْس، يعْنِي جَار ن ثْغمَّارْث ذ وغِيڒ. تْشدَّان-ثن عَاوذ ذِي ثنْيَارْث، يعْنِي ثَوَارْنَا.</char></note> ذ يمقّْرَانن، اَرنِّين ثِيشْڒُوڒِين <char style="it">إِ يزدْجَابن نْسن</char>. <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />تخْسن يمُوْشَان يمزْوُوْرَا ذِي ڒفْرُوْح ذ ثمْزِيذَاوِين. <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />تخْسن اَخَاسن سدْجْمن ذِي ڒسْوَاق اَذَاسن ڒَاغَان يِوْذَان: آ سِيذِيثْنغ. <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />وَلَكِن كنِّيو، وَار تجَّام حَدّ اَذَاوم يڒَاغَا: آ سِيذِيثْنغ. ڒَاحقَّاش كنِّيو مَارَّا ذ اَوْمَاثن غَارْوم يجّن ن سِيذِيثْوم. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />وَار تْڒَاغَام إِ حَدّ ذِي ثْمُوْرْث: آ بَابَاثْنغ. ڒَاحقَّاش غَارْوم غِير يجّن ن بَابَاثْوم اَقَاث ذݣ وجنَّا. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />وَار تجَّام حَدّ اَذَاوم يڒَاغَا: آي اَمْسڒْمَاذ. ڒَاحقَّاش غَارْوم غِير يجّن ن ومْسڒْمَاذ، نتَّا ذ لْمَسِيح. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />أَمقّْرَان جَارَاوم يتْخصَّا اَذ يِيڒِي ذ اَخدَّام نْوم. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />ونِّي يسمْغَارن يخف نّس، أَتَاف اَذ يِيڒِي ذ اَمزْيَان. ونِّي يسمْزْيَان يخف نّس، أَتَاف اَذ يِيڒِي ذ اَمقّْرَان.<verse eid="MAT 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />يَا ڒفْضِيحث نْوم آي يمْسڒْمَاذن ن شَّرِيعَا ذ ڒْحِزب ن يفَرِّيسِيْين، آ لْمُنَافِقِين! تقّْنم ثَوَّارْث ن ڒْمُلْك وجنَّا خ يِوْذَان. كنِّيو وَار تِيذْفم، وَار تجِّيم وِي غَا يَاذْفن.<verse eid="MAT 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 23:14" />{يَا ڒفْضِيحث نْوم آي يمْسڒْمَاذن ن شَّرِيعَا ذ ڒْحِزب ن يفَرِّيسِيْين، آ لْمُنافِقين! تتّم إِ ثَاجَّاڒِين مَارَّا مِين غَارْسنْت. ثسْمظْهَارم-د يخف نْوم تْࢲَادْجَام اَطَّاس حمَا اَذ تْبيّْنم إِ يِوْذَان بلِّي ثْصبْحم اَطَّاس زَعْمَا. خ مَانَاينِّي اَذ تْوَاعَاقْبم كْتَار.}<verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />يَا ڒفْضِيحث نْوم آي يمْسڒْمَاذن ن شَّرِيعَا ذ ڒْحِزب ن يفَرِّيسِيْين، آ لْمُنَافِقِين! تكّم مَارَّا ڒبْحَر ذ ڒْبَرّ حمَا اَذ تْجَرّم شَان يِجّن غَار دِّين نْوم. أُو خْمي إِي كِوم غَا يِيڒِي، تَارِّيم-ث يسْذَاهدْج ثِمسِّي مَارْثَاين كْتَار زِي مِين ثسْذَاهدْجم كنِّيو.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />يَا ڒفْضِيحث نْوم، آي يضَرْغَاڒن يتْجَرَّان يوْذَان! ثقَّارم: وَار ثْسݣّْوِي وَالُو ثْجَادْجِيث<note caller="+" style="f"><char style="fr" closed="false">23‏.16 </char><char style="ft" closed="false">ثْجَادْجِيث نتَّاث ذ لْحُلف.</char></note> س ثمْزِيذَا ثَمقّْرَانْت، وَلَكِن ونِّي غَا يجَّادْجن س دّْهب ن ثمْزِيذَا ثَمقّْرَانْت يتْخصَّا اَخَاس يكمّڒ خ ثْجَادْجِيث نّس. <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />آي يفْغَار آي يضَرْغَاڒن، مِين يسݣّْوَان كْتَار؟ مَا ذ دّْهب مَا ذ ثَمْزِيذَا ثَمقّْرَانْت إِݣ يُوْشِين لْقِيمَا إِ دّْهب؟ <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" /><char style="it">ثقَّارم عَاوذ:</char> وَار ثسݣّْوِي وَالُو ثْجَادْجِيث س ڒْمذْبَح، وَلَكِن ونِّي غَا يجَّادْجن س دْبِيحَاث يدْجَان خ ڒْمذْبَح، يتْخصَّا اَخَاس يكمّڒ خ ثْجَادْجِيث نّس. <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />آي يضَرْغَاڒن، مِين يسݣّوَان كْتَار: ذ دْبِيحَاث نِغ د ڒْمذْبح يتِيشّن لْقِيمَا إِ دْبِيحَاث؟ <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />خ مَانَايَا، ونِّي يتْجَادْجَان س ڒْمذْبح، يتْجَادْجَا زَّايس ذ مَارَّا مِين خَاس. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />ونِّي يتْجَادْجَان س ثمْزِيذَا ثَمقّْرَانْت، ئِتْجَادْجَا زَّايس ذ أَربِّـي إِي ت يزدّْغن. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />ونِّي يتْجَادْجَان س وجنَّا، يتْجَادْجَا س لْعَرْش ن أَربِّـي ذ ونِّي خَاس يقِّيمن.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />يَا ڒفْضِيحث نْوم، آي يمْسڒْمَاذن ن شَّرِيعَا ذ ڒْحِزب ن يفَرِّيسِيْين، آ لْمُنَافِقِين! تِيشّم ڒَعْشُوْر ؤُڒَا خ نَعْنَاع ذ ؤُوْرَام<note caller="+" style="f"><char style="fr" closed="false">23‏.23 </char><char style="ft" closed="false">أَوْرَام نتَّا ذ يجّن ن ڒْعُشْبث ذَايس دّْوَا.</char></note> ذ ڒْشمُّوْن،<note caller="+" style="f"><char style="fr" closed="false">23‏.23 </char><char style="ft" closed="false">ڒْشمُّون نتَّا ذ ڒْكَيْمُون.</char></note> وَلَكِن وَار تهْتِيمِيم شَا مِين يدْجَان مُهِم قَاع ذِي شَّرِيعَا يعْنِي ڒْحَقّ ذ اَرَّحْمث ذ لْإِيمَان. لَّا، ئِتْخصَّا-ٱوم اَذ تهْتَامم س مَانَايَا بڒَا مَا تتُّوْم ڒَعْشُوْر. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />آي يضَرْغَاڒن يتْجَرَّان يوْذَان! تْصفِّيم يزِي <char style="it">زِي مِين ثْسسّم</char>، ثسْغدْجَايم اَڒْغم!<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />يَا ڒفْضِيحث نْوم آي يمْسڒْمَاذن ن شَّرِيعَا ذ ڒْحِزب ن يفَرِّيسِيْين، آ لْمُنَافِقِين! كنِّيو ثْسِيرِيذم <char style="it">مْلِيح</char> ڒْكَاس ذ طبْصِي غَار بَارَّا، وَلَكِن غَار ذَاخڒ اَقَا شُّوْرن س ثُوْكَّارْذَا ذ طّْمَع! <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />آي اَفَرِّيسِي اَضَرْغَاڒ، ذ اَمزْوَارُو سِيرذ ڒْكَاس غَار ذَاخڒ حمَا اَذ يِيڒِي يسِيرذ غَار بَارَّا.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />يَا ڒفْضِيحث نْوم آي يمْسڒْمَاذن ن شَّرِيعَا ذ ڒْحِزب ن يفَرِّيسِيْين، آ لْمُنَافِقِين! كنِّيو اَمشْنَاو يمضْڒَان يبيّْضن س جِّير. تْمظْهَارن صبْحَان غَار بَارَّا، وَلَكِن نِثْنِي شُّوْرن غَار ذَاخڒ س يِخْسَان ذ مَارَّا مِين يَرشَّان. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />أَمنِّي كنِّيو إِي تْمظْهَارم إِ يِوْذَان نِيشَان إِي ثدْجَام غَار بَارَّا، وَلَكِن غَار ذَاخڒ ثشُّوْرم س نِّفَاق ذ ڒْمُعْصِيَاث.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />يَا ڒفْضِيحث نْوم آي يمْسڒْمَاذن ن شَّرِيعَا ذ ڒْحِزب ن يفَرِّيسِيْين، آ لْمُنَافِقِين! كنِّيو ثْبنَّام يمضْڒَان ن لْأَنْبِيَا، ثْعدّْڒم يمْرَابذن ن ڒْمُوْمِنِين. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />ثقَّارم: مَعْلِيك ندْجَا ذِي ڒْوقْث ن ڒجْذُوْذ نّغ، أَتَاف وَار كِذْسن نْسِيزّڒ شَا يذَامّن<note caller="+" style="f"><char style="fr" closed="false">23‏.30 </char><char style="ft" closed="false">ئِذَامّن نتَّا ذ دّم.</char></note> ن لْأَنْبِيَا. <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />خ مَانَاينِّي ثْشهّْذم خ يِيخف نْوم بلِّي كنِّيو ذ ثَارْوَا ن يِنِّي ينْغِين لْأَنْبِيَا. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />إِيوَا، كمّْڒث كنِّيو خ مِين بْذَان ڒجْذُوْذ نْوم!<verse eid="MAT 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33" />آي يفِيغرَان! آ ثَارْوَا ن ثْفِيغرَاوِين! مَامّش ثْفكَّرم اَذ تَروْڒم زِي لْعِقَاب ن جَهنَّامَا؟ <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />خ مَانَايَا خْزَرم! تْسكِّيغ-اَوم-د لْأَنْبِيَا ذ يمِيغِيسن ذ يمْسڒْمَاذن. ئِجّن زَّايْسن اَث ثنْغم، ئِجّن اَث ثْصلّْبم. ئِجّن زَّايْسن اَث ثُوْوْثم س وسْغُوْن ذِي ثمْزِيذَاوِين، ئِجّن اَخَاس ثَازّْڒم زِي ثنْدِينْت غَار ثنْدِينْت. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />خ مَانَاينِّي اَذ تْوَاعَاقْبم خ مَارَّا يذَامّن إِي يُوْزّْڒن ن ڒْمُوْمِنِين ذِي دُّنشْت-أَ. زݣ يذَامّن ن هَابِيل ڒْمُوْمن أَڒ يذَامّن ن زَكَرِيَا مِّيس ن بَرْخِيَا إِي ثنْغِيم جَار ڒْمذْبَاح ذ ثمْزِيذَا ثَمقّْرَانْت. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />أَقَا تسْڒَام ڒْحَقّ: مَارَّا لْعِقَاب-أَ اَذ د يهْوَا خ يِوْذَان ن ڒْوقْث-أَ!<verse eid="MAT 23:36" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يتْخيَّاق خ ثنْدِينْت ن لْقُدْس</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />يَا لْقُدْس يَا لْقُدْس! ذ شم إِݣ ينقّن لْأَنْبِيَا، ذ شم إِݣ يرجّْمن يِنِّي غَارم د يسّكّ أَربِّـي! نش مشْحَاڒ ن ثْوَاڒَاثِين خْسغ اَذ سْمُوْنغ ثَارْوَا نّمْ اَم شَان ثْيَازِيط يتحْبُوْبُوْضن خ يفِيدْجُوْسن نّس وَلَكِن كنِّيو ثُوْݣِيم. <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />أَقَا ثَدَّارْث نْوم اَذَاوم ثقِّيم ذ ڒْخِرْبث. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />أَذَاوم ينِيغ بلِّي وَار ذَايِي ثْࢲرّم شَا عَاوذ حتَّا ٱڒ نْهَار نِّي إِي غَا ثِينِيم: سَّعْذ يَا ونِّي إِي د يُوْسِين عْلَاحْسَاب يسم ن سِيذِي أَربِّـي!"<note caller="+" style="f"><char style="fr" closed="false">23‏.39 </char><char style="ft" closed="false">خْزَر زَّبُور 118‏:26.</char></note><verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">لْعَلَامَاث ن ڒْفَنَا ن دُّنشْت</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />ئِفّغ عِيْسَى زِي ثمْزِيذَا ثَمقّْرَانْت يبعّذ سّنِّي شْوَايْت. قَارّْبن-د غَارس يمحْضَارن نّس حمَا اَذَاس سظْهَارن ڒبْنِي ن ثمْزِيذَا ثَمقّْرَانْت. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: "مَا تْوَاڒَام قَاع مَانَايَا؟ أَقَا تسْڒَام ڒْحَقّ: وَار ذَا يتْغِيمِي يجّن ن وزْرُو خ ونّغْنِي، مَارَّا مَانَايَا اَذ ينهْذم."<verse eid="MAT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />وَامِي يقِّيم عِيْسَى ذݣ وذْرَار ن زِّيتُوْن، قَارّْبن-د غَارس يمحْضَارن نّس وَاحذْسن نَّان-اَس: "إِنِي-يَانغ شك، مڒْمِي غَا يوْقع مَانَايَا؟ مِين ثعْنَا لْعَلَامَا نِّي خْمِي د غَا ثَاسذ شك، ذ ڒفْنَا ن زْمَان؟"<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />ئِجَاوب-يثن عِيْسَى ينَّا-ٱسن: "حْضَام يخف نْوم حمَا وَار كنِّيو يخدّع حَدّ. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />أَطَّاس إِي د غَا يَاسن س يِيسم ينُو زَعْمَا اَذ ينِين قَا نش ذ لْمَسِيح! أَذ خذْعن اَطَّاس ن يِوْذَان. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />خْمِي غَا ثسْڒَام خ لْحُرُوْب ذ ڒخْبَار ن لْحُرُوْب وَار تݣّْوْذم شَا، لَابُد زِي مَانَايَا. وَلَكِن دُّنشْت-أَ عَاذ وَار ثْفنِّي شَا. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />دُّوْلَا اَذ تهْجم خ دُّوْلَا، لْممْلَكَا اَذ تهْجم خ لْممْلَكَا. أَذ يِيڒِي جُّوْع اَذ يوْقع زِّنْزَال ذݣ وَاطَّاس ن يمُوْشَان. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />مَارَّا مَانَايَا اَذ يِيڒِي اَمشْنَاو ڒحْرِيق اَمزْوَارُو ن ثمْغَارْث يتَارْون.<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />سّنِّي اَكنِّيو سلّْمن يِوْذَان حمَا اَكنِّيو عدّْبن، أَكنِّيو نْغن. مَارَّا دُّوَل اَكنِّيو عِيفّن عْلَاحْسَاب يسم ينُو. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />أَطَّاس إِي غَا يكْفَرن زݣ يِنِّي إِي يُوْمْنن. أَذ زّنْزن اَيَاوْيَا، أَذ عِيفّن اَيَاوْيَا. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />أَذ د مظْهَارن اَطَّاس ن يِوْذَان اَذ اَرّن يخف نْسن ذ لْأَنْبِيَا، أَذ خذْعن اَطَّاس ن يِوْذَان. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />أَذ تنْقس ڒمْحِبّث جَار يِوْذَان مِينْزِي اَذ يكْثَر شَّرّْ. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />وَلَكِن ونِّي غَا يصْبَرن غَار ونݣَّارُو اَتَاف اَذ ينْجم. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />لْإِنْجِيل ن ڒْمُلْك ن أَربِّـي اَخَاس حدّْثن يِوْذَان ذِي مَارَّا ثِمُوْرَا ن دُّنشْت حمَا اَغَارْسن ثِيڒِي شْهَاذث خَافِي. ڒخْدّنِّي إِي د غَا يَاس ڒفْنَا.<verse eid="MAT 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />خْمِي غَا ثࢲرم &lt;مِين يدْجَان ذ اَعفَّان اَطَّاس يهدّْمن&gt; نتَّا يتْبدَّا ذݣ ومْشَان يقدّْسن، يعْنِي مِيْخف يسِّيوڒ نَّبِي دَانْيَال (أَ فْهم آ ونِّي يغْرِين مَانَايَا!)، <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />ڒخْدّنِّي يِنِّي يدْجَان ذِي ثْمُوْرْث ن يَهُوْذِيَا ئِتْخصَّا اَذ اَروْڒن غَار يذُوْرَار. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />ونِّي غَا يِڒِين خ ثْزقَّا نّس يتْخصَّا-ٱس وَار يهكّْوِي شَا غَار ثدَّارْث حمَا اَذ ييْسِي شَان ڒْحَاجث. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />ونِّي غَا يِڒِين ذݣ ومَرْجع يتْخصَّا-ٱس وَار يتعْقِيب شَا غَار ثدَّارْث اَذ ييْسِي تْشَامِّير نّس. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />يَا تَمَارَا خ ثمْغَارِين إِي غَا يِيڒِين س يعدِّيسن ذݣ وُوْسَّان نِّي، ذ ثِنِّي إِي يسُّوْطُوْضن! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />تَّارث إِ أَربِّـي بَاش وَار تَروّْڒم شَا ذِي ڒْمشْتَا نِغ ذِي نْهَار ن لْعِبَادَا. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />ذِي ڒْوقْث نِّي اَتَاف اَذ توْقع يجّن ن تَمَارَا ذ ثَمقّْرَانْت إِي وَار يوْقِيعن عمَّارْص زݣ وَامِي ثدْجَا دُّنشْت-أَ اَڒ ڒخُّو، أُو عمَّارْص اَذ توْقع عَاوذ. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />مَعْلِيك <char style="it">سِيذِي أَربِّـي</char> وَار يسنْقِيس شَا ذِي ڒِيَّام نِّي ن تَمَارَا-يَا إِي د غَا يَاسن، أَتَاف وَار ينجّم ؤُڒَا ذ يجّن. خ سَّبَاب ن يِنِّي يخْضَر <char style="it">أَربِّـي</char>، أَتَاف اَذ يسنْقس ڒِيَّام نِّي إِي د غَا يَاسن.<verse eid="MAT 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />سّنِّي مڒَا ينَّا-ٱوم شَان يِجّن: خْزَرم! أَقَاث ذَانِيتَا لْمَسِيح! نِغ، أَقَاث ذِيهَا! وَار ث تَامْنم شَا. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />أَقَا اَطَّاس إِي د غَا يمظْهَارن س يخَرِّيقن اَذ ينِين اَقَا نش ذ لْمَسِيح نِغ نش زِي لْأَنْبِيَا. أَذ ݣّن لْمُعْجِزَاث ذ ثِمقّْرَانِين ذ ڒَعْجَايب <char style="it">زَعْمَا</char> حمَا اَذ خذْعن يوْذَان. مَعْلِيك زمَّرن يڒِي خذْعن ؤُڒَا ذ يِنِّي يخْضَر أَربِّـي. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />خْزَرم! أَقَا نش عڒْمغ-اَوم خ مَانَايَا قْبڒ مَا ٱذ يوْقع. <verse eid="MAT 24:25" /><verse number="26" style="v" sid="MAT 24:26" />مڒَا نَّان-اَوم: خْزَرم، أَقَاث ذِي ڒخْڒَا! وَار تْرَاحم شَا ذِنِّي. نِغ مڒَا نَّان-اَوم: خْزَرم، أَقَاث غَار ذَاخڒ ذݣ يخَّامن! وَار ثن تَامْنم شَا. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />أَقَا خْمِي د غَا يَاس مِّيس ن بْنَاذم اَتَاف اَذ يِيڒِي اَمشْنَاو اَسَّام إِي د يتفّْغن زِي شَّرْق يتْشعَّاڒ غَار لْغَرْب. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />مَانِي دْجَان يمُوْرْضَاس، ذِنِّي إِݣ يتْمُوْنن يبَاغرِيون.<verse eid="MAT 24:28" /></para>
  <para style="b" />
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />منْبَعْد إِ تَمَارَا ن ڒِيَّام نِّي، ڒخْدّنِّي ثْفُوْشْت اَذ تذْوڒ ذ ثَادْجسْت، ثَزِيرِي وَار تِيشّ بُو ثْفَاوْث. ئِثْرَان اَذ د وْضَان زݣ وجنَّا، يِنِّي يجهْذن ذݣ وجنَّا اَثن يسنْهزّ <char style="it">أَربِّـي</char>.<note caller="+" style="f"><char style="fr" closed="false">24‏.29 </char><char style="ft" closed="false">خْزَر إِشَعْيَا 13‏:10 ذ 34‏:4 ذ حِزْقِيَال 32‏:7.</char></note> <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />أُوْشَا اَذ تْمظْهَار لْعَلَامَا ن مِّيس ن بْنَاذم ذݣ وجنَّا، ڒخْدّنِّي إِي غَا حزْننْت مَارَّا ثِقبَّاڒ ن ثْمُوْرْث. أَذ ࢲرنْت مِّيس ن بْنَاذم يهوَّا-د ذݣ وسيْنُو ن وجنَّا س لْعَظَمَا ذ جّْهذ نّس يمْغَارن. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />أَذ يصُوْض يجّن ن زَّمَّار ذ اَمقّْرَان، أَذ د يسّكّ لْمَلَائِكَاث نّس غَار اَرْبعَا ن يمُوْشَان ن ثْمُوْرْث مَانِيس د يتكّ اَرِّيح: <char style="it">زِي شَّرْق ذ لْغَرْب ذ لْجَنُوْب ذ شَّمَال</char>. أَذ يسْمُوْن يِنِّي يخْضَر زِي ڒَاحدّ ن وجنَّا اَڒ ڒَاحدّ نّس نّغْنِي.<verse eid="MAT 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />ڒمْذم يجّن ن ڒْمَعْنَا زِي ثْشجَّارْث ن ثَازَارْث. غِير ڒفْرُوْع نّس اَذ حبّْبن اَذ ݣّن ثِيفْرَاي، أَتَاف اَذ تسّْنم يَالَّاه اَنبْذُو يقَارّب-د. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />أَمنِّي ؤُڒَا ذ كنِّيو. خْمِي غَا ثࢲرم مَارَّا ثِمسْڒَايِين-أَ يتوْقِيعن اَتَاف اَذ تسّْنم إِلَّا مَانَايَا يُوْذس-د، أَقَاث زَّاث إِ ثوَّارْث. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />أَقَا تسْڒَام ڒْحَقّ: وَار تْمتِّين يِوْذَان ن ڒْوقْث-أَ اَڒ غَا يوْقع مَارَّا مَانَايَا. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />أَذ يفْنَا وجنَّا ذ ثْمُوْرْث، وَلَكِن اَوَاڒن ينُو وَار فنِّين شَا عمَّارْص.<verse eid="MAT 24:35" /></para>
  <para style="b" />
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />شُوْف، نْهَار نِّي نِغ ثْسَعَّات نِّي وَار ت يسِّين ؤُڒَا ذ يجّن، لَّا لْمَلَائِكَاث ذݣ وجنَّا ؤُڒَا ذ مِّيس. يسّن-يت غِير بَابَا وَاحْذس. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />أَمشْنَاو مَامش يوْقع ذِي ڒِيَّام نِّي ن نُوْح، أَمنِّي إِي غَا يوْقع خْمِي د غَا يذْوڒ مِّيس ن بْنَاذم. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />ئِوْذَان ذِي ڒْوقْث نِّي قْبڒ إِ طُّوْفَان،<note caller="+" style="f"><char style="fr" closed="false">24‏.38 </char><char style="ft" closed="false">طُّفَان، يعْنِي لْفَيَضَان يوقْعن ذِي ڒْعَهذ ن سِيذْنَا نُوح.</char></note> تُوْغَا تتّن، سسّن، مدْجْشن تْوَاسْمدْجَاشن، حتَّا اَڒ نْهَار وَامِي يُوْذف نُوْح ذݣ وغَرَّابُو. <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />وَار فْطِينن شَا اَڒ وَامِي د يُوْسَا طُّوْفَان يسْغَرق-يثن مَارَّا. أَمُّو إِي غَا يوْقع خْمِي د غَا يذْوڒ مِّيس ن بْنَاذم. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />أَذ يڒِين ثْنَاين ن يرْيَازن ذݣ ومَرْجع، ئِجّن اَذ يميْسِي يجّن اَذ يقِّيم. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />أَذ يڒِينْت ثْنَاين ن ثمْغَارِين ذِي ثْسِيرْث حرِّينْت ثِحبَّا، ئِشْتن اَذ تْميْسِي يشْتن اَذ تقَّيم.<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />خ مَانَايَا فَاقم بَعْدَا، قَا وَار ثسِّينم شَا مڒْمِي د غَا يذْوڒ سِيذِيثْوم. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />ئِتْخصَّا-ٱوم اَذ تسّْنم مَانَايَا: مْڒِي بَاب ن ثدَّارْث يسّن ثْسَعَّات إِي ذِي د غَا يَاس وشفَّار، ئِڒِي يقِّيم يفَاق حمَا وَار ث يتِيجِّي شَا اَذ د يَاذف ثَدَّارْث نّس. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />خ مَانَايَا، سْوجْذم يخف نْوم مِينْزِي مِّيس ن بْنَاذم اَذ د يَاس ذݣ يِجّن ن ثْسَعَّات وَار ث تْرِيجِيم شَا.<verse eid="MAT 24:44" /></para>
  <para style="s">إِيڒِيم ثوْجْذم خْمِي د غَا يذْوڒ سِيذِيثْوم</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />مِين يعْنَا وخدَّام إِي يدْجَان ذ اَمِيغِيس، ذَايس ڒَامَان؟ نتَّا ذ ونِّي إِݣ يتْكلَّاف سِيذس اَذَاسن يُوْش مَشَّا<note caller="+" style="f"><char style="fr" closed="false">24‏.45 </char><char style="ft" closed="false">مَشَّا نتَّاث ذ لْمَكْلَا.</char></note> إِ يخدَّامن نّس ذِي ڒْوقْث نِيشَان. <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />سَّعْذ ن وخدَّام نِّي، خْمِي د غَا يذْوڒ سِيذس اَث يَاف يخدّم. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />أَقَا تسْڒَام ڒْحَقّ: <char style="it">أَخدَّام نِّي</char> اَث يكلّف سِيذس خ مَارَّا اَݣْڒَا نّس. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />وَلَكِن اَخدَّام نِّي مڒَا ذ اَعفَّان ينوَّا بلِّي سِيذس اَذ يعْظڒ وَار د يتِيس شَا، <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />أَتَاف اَذ يبْذَا يشَّاث يخدَّامن اَذ يشّ اَذ يسو اَذ يِيڒِي اَك يسْكَايْرِيْين وَاهَا. <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />أُوشَا اَذ د يَاس سِيذس ن وخدَّام نِّي ذݣ يِجّن ن نْهَار وَار ث ينْوِي شَا، ذݣ يِجّن ن ثْسَعَّات وَار ث يسِّين شَا. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />أَث يقسّ ذ يوزْوِيزن اَث ينْضَر ذݣ ومْشَان ن لْمُنَافِقِين، ذِنِّي إِي غَا يڒِين يمطَّاون ذ وغࢲَّاࢲ ن ثغْمَاس.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">ڒْمَعْنَا ن عشْرَا ن ثعْزْرِيِين</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />ڒْمُلْك وجنَّا اَمشْنَاو شَان عشْرَا ن ثعْزْرِيِين إِݣ ييْسِين ڒقْنَاذڒ، فّْغنْت اَذ ڒقَّانْت مُوْڒَاي. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />خمْسَا إِذْسنْت ذ ثِفْغَاڒ، خمْسَا إِذْسنْت ذ ثِيمِيغِيسِين. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />ثِفْغَاڒ وَامِي يْسِينْت ڒقْنَاذڒ، وَار يْسِينْت بُو زّشْت ذ زِّيَادَا. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />ثِيمِيغِيسِين نِثنْتِي يْسِينْت اَكِسنْت زِّيَادَا ن زّشْت ذِي ثْزيَّاثِين. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />ئِعْظڒ مُوْڒَاي وَار د يُوْسِي شَا، نِثنْتِي ؤُحْڒنْت طّْصنْت مَارَّا إِذْسنْت.<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />غَار ڒْوسْط ن دْجِيڒث، سْڒِينْت إِ ؤُڒَاغِي يقَّار اَقَا مُوْڒَاي يُوْسَا-د، فّْغنْت اَث ثڒْقَانْت! <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />كَّرنْت ثعْزْرِيِين نِّي سرْغنْت ڒقْنَاذڒ. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />ثِفْغَاڒ نَّانْت إِ ثِيمِيغِيسِين: ؤُشنْت-اَنغ شْوَايْت ن زّشْت ڒَاحقَّاش ڒقْنَاذڒ نّغ عْڒَاين اَذ خْسِين. <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />أَرِّينْت خَاسنْت ثِيمِيغِيسِين نَّانْت-اَسنْت: لَّا، مِينْزِي وَار ذَانغ يتْقدِّي شَا إِ نشِّين ذ كنِّينْت. رُوْحنْت غَار ثْحَانت سْغنْت-يد مِين غَا ثحْذَاجنْت. <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />وَامِي رُوْحنْت ثفْغَاڒ اَذ سْغنْت زّشْت، ئِخْضڒ-د مُوْڒَاي. ؤُذْفنْت اَكِذس ثِنِّي يسْوجْذن غَار ڒْفَارْح، ثْبلّع ثوَّارْث.<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />منْبَعْد ؤُسِينْت-يد ثفْغَار نَّانْت-اَس س جّْهذ: آ سِيذِي آ سِيذِي، رْزم-اَنغ ثَوَّارْث! <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />يَارَّا خَاسنْت مُوْڒَاي ينَّا-ٱسنْت: أَقَا تسْڒَانْت ڒْحَقّ: نش وَار كنِّينْت سِّينغ شَا.<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />إِذن، ئِڒِيم عْلَابَال ڒَاحقَّاش وَار ثسِّينم ؤُڒَا ذ نْهَار نِّي ؤُڒَا ذ ثْسَعَّات نِّي.<verse eid="MAT 25:13" /></para>
  <para style="s">ڒْمَعْنَا ن ثْڒَاثَا ن يخدَّامن</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />
    <char style="it">نْهَار نِّي</char> اَذ يِيڒِي اَم يِجّن ن سِّيّد يرزُّو اَذ يسَفر. ئِڒَاغَا-د إِ يخدَّامن نّس يكلّف-يثن خ وَاݣْڒَا نّس. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />يُوْشَا-ٱسن عْلَاحْسَاب مِين ؤُمِي زمَّرن. يْجّن يَوْشَا-ٱس خمْسَاڒَاف ن ڒُوْزْنَاث ن نُّقَارْث. يْجّن يُوْشَا-ٱس اَڒفَاين. يْجّن يُوْشَا-ٱس اَڒَاف. سّنِّي يرُوْح نتَّا اَذ يسَفر. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />ڒخْدّنِّي يكَّر ونِّي ؤُمِي يُوْشَا خمْسَاڒَاف ن ڒُوْزْنَاث يݣَّا زَّايْسنْت تِّجَارَا، يرْبح خمْسَاڒَاف نّغْنِي. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />أَمنِّي يݣَّا ؤُڒَا ذ ونِّي ؤُمِي يُوْشَا اَڒفَاين، يرْبح اَڒفَاين نّغْنِي. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />وَلَكِن ونِّي ؤُمِي يُوْشَا اَڒَاف ن ڒُوْزْنَاث، ئِرُوْح نتَّا يغْزَا ذِي ثْمُوْرْث يسْنُوْفَّر تْمنْيَاث ن سِيذس.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />وَامِي ثعْذُو خَربِّي ن ڒْوقْث، ئِذْوڒ-د سِيذِيثْسن يتݣّ اَكِذْسن ڒحْسَاب. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />ئِقَارّب-د ونِّي ؤُمِي يُوْشَا خمْسَاڒَاف ن ڒُوْزْنَاث، يَرْنِي-يَاس اَكِذْسنْت خمْسَاڒَاف نّغْنِي. ينَّا-ٱس إِ سِيذس: آ سِيذِي، ثُوْشِيذ-اَيِي شك خمْسَاڒَاف ن ڒُوْزْنَاث، نش ؤُوِيغ-د خمْسَاڒَاف نّغْنِي. <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />ينَّا-ٱس سِيذس: ثݣِّيذ مْلِيح آي اَخدَّام اَصبْحَان، شك ذَايك ڒَامَان. ذَايك ڒَامَان خ ذْرُوْس، ڒخُّو اَش كلّْفغ خ وَاطَّاس. أَذف اَذ تْفَرْحذ اَك سِيذش.<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />عَاوذ يقَارّب-د وخدَّام نِّي ؤُمِي يُوْشَا اَڒفَاين ن ڒُوْزْنَاث ينَّا-ٱس إِ سِيذس: آ سِيذِي، ثُوْشِيذ-اَيِي شك اَڒفَاين ن ڒُوْزْنَاث، نش ؤُوِيغ-د اَڒفَاين نّغْنِي. <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />ينَّا-ٱس سِيذس: ثݣِّيذ مْلِيح، آي اَخدَّام اَصبْحَان، شك ذَايك ڒَامَان. ذَايك ڒَامَان خ ذْرُوْس، ڒخُّو اَش كلّْفغ خ وَاطَّاس. أَذف اَذ تْفَرْحذ اَك سِيذش.<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />ئِقَارّب-د ونِّي ؤُمِي يُوْشَا اَڒَاف ن ڒُوْزْنَاث ينَّا-ٱس إِ سِيذس: آ سِيذِي، نش سّْنغ شك ذ يجّن ن بْنَاذم ثقْسْحذ. ثْمجَّارذ مَانِي وَار ثْزرّْعذ شَا، ثْكسِّيذ مِين وَار تࢲُّوْذ شَا. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />ݣّْوْذغ زَّايك، رُوْحغ سْنُوْفَّرغ تْمنْيَاث نّش ذِي ثْمُوْرْث، أُو اَقَاش تْمنْيَاث نّش.<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />ئِنْدق-د سِيذس ينَّا-ٱس: آي اَخدَّام اَمْشُوْم، آي اَفنْيَان! إِيوَا ثسّْنذ بلِّي نش مجَّارغ مَانِي وَار زرّْعغ، كسِّيغ مِين وَار تࢲُّوْغ. <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />مَايمِّي وَار ثجِّيذ تْمنْيَاث ينُو غَار يصَرَّافن، أَتَاف نش اَذ د اَسغ اَذ يْسِيغ تْمنْيَاث ينُو ذ ڒفْضڒ اَكِسنْت؟ <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" /><char style="it">أُوشَا ينَّا-ٱسن إِ يخدَّامن نّس</char>: كّْسم-اَس اَڒَاف ن ڒُوْزْنَاث نِّي إِ وَانِيتَا، اَرْنِيم-ثنْث إِ ونِّي غَار يدْجَا عشْرَاڒَاف. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />وَاه، ونِّي يدْجَان غَارس يتْمَارْنِي-يَاس، أَغَارس يِيڒِي اَطَّاس. ونِّي وَار غَار يدْجِي شَا، يتْوَاكْسِي-يَاس ؤُڒَا ذ مِين غَارس. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />أَخدَّام-أَ إِي ذِي وَار يدْجِي نّْفَع، نْضَرم-ث بَارَّا غَار ثَادْجسْت. ذِنِّي إِي غَا يڒِين يمطَّاون ذ وغࢲَّاࢲ ن ثغْمَاس.<verse eid="MAT 25:30" /></para>
  <para style="s">يُوْم لْحِسَاب ذ لْعِقَاب</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />خْمِي د غَا يَاس مِّيس ن بْنَاذم س لْعَظَمَا نّس، أَكِذس مَارَّا لْمَلَائِكَاث، أَذ يقِّيم خ لْعَرْش نّس ن لْعَظَمَا. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />أَذ نْجمْعن مَارَّا يوْذَان زَّاثس، أَذ يعْزڒ يوْذَان يجّن زݣ ونّغْنِي اَمشْنَاو مَامّش ونِّي يَروّْسن ڒبْهَايم يتعْزَاڒ يحُوْڒِيْين زِي ثْغَاطِين. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />ئِحُوْڒِيْين اَثن يݣّ خ وفُوْسِي، ثِغَاطِين اَثنْت يݣّ خ وࢲڒْمَاض.<verse eid="MAT 25:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34" />ڒخْدّنِّي يِنِّي يدْجَان خ وفُوْسِي اَذَاسن يِينِي وزدْجِيذ-أَ: آ يِنِّي إِي ذِي يݣَّا بَابَا لْبَرَكَا، أَرَاحم-د كنِّيو وَرْثم ڒْمُلْك إِي ذَاوم يسوْجذ زݣ وَامِي ثدْجَا دُّنشْت. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />ڒَاحقَّاش ثُوْفِيم-اَيِي دْجُوْزغ ثْسّشم-اَيِي. ثُوْفِيم-اَيِي فُّوْذغ ثْسسّْوم-اَيِي. ثُوْفِيم-اَيِي ذ اَغْرِيب ثْسزْذْغم-اَيِي. <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />ثُوْفِيم-اَيِي ذ اَعَرْيَان ثݣِّيم-اَيِي اَرُّوْض. ثُوْفِيم-اَيِي هڒْشغ ثْبدّم اَكِذِي. ثُوْفِيم-اَيِي تْوَاحبّْسغ ثݣِّيم-د غَارِي زِّيَارَا.<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />أَث جَاوْبن يصبْحَانن نِّي اَذَاس ينِين: آ سِيذِي، نشِّين مڒْمِي ش نُوْفَا ثدْجُوْزذ، نْسشّ-يش؟ نِغ ثفُّوْذذ، نْسسّو-يش؟ <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />مڒْمِي ش نُوْفَا ذ اَغْرِيب، نْسزْذغ-يشك؟ نِغ ذ اَعَرْيَان، نݣَّا-ٱش اَرُّوْض؟ <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />مڒْمِي ش نُوْفَا ثْهڒْشذ نِغ ذ اَمحْبُوْس، نُوْسَا-د غَارك؟ <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />أَذ د يَاس وزدْجِيذ اَذَاسن يِينِي: أَقَا تسْڒَام ڒْحَقّ: مِين ثݣِّيم إِ يِجّن ن وُوْمَا ذ اَمزْيَان زݣ أَيثْمَا، ثݣِّيم-اَيِي-ت إِ نش.<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />ڒخْدّنِّي يِنِّي يدْجَان خ وࢲڒْمَاض اَذَاسن يِينِي ؤُزدْجِيذ: آ يِنِّي ينْعڒ أَربِّـي بعّْذم خَافِي! رُوْحم غَار ثْمسِّي إِي وَار يخسِّين عمَّارْص، ئِسْوجْذن إِ شِّيطَان ذ شَّيَاطِين نّس! <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />ڒَاحقَّاش ثُوْفِيم-اَيِي دْجُوْزغ، وَار ذَايِي ثْسشّم شَا. ثُوْفِيم-اَيِي فُّوْذغ، وَار ذَايِي ثْسسّْوم شَا. <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />ثُوْفِيم-اَيِي ذ اَغْرِيب، وَار ذَايِي ثْسزْذْغم شَا. ثُوْفِيم-اَيِي ذ اَعَرْيَان، وَار ذَايِي ثݣِّيم بُو وَارُّوْض. ثُوْفِيم-اَيِي هڒْشغ تْوَاحبّْسغ، وَار غَارِي د ثݣِّيم بُو زِّيَارَا!<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />أَث جَاوْبن ؤُڒَا ذ يِنِّي يدْجَان خ وࢲڒْمَاض اَذَاس ينِين: آ سِيذِي، نشِّين مڒْمِي ش نُوْفَا ثدْجُوْزذ نِغ ثفُّوْذذ نِغ ذ اَغْرِيب نِغ ذ اَعَرْيَان نِغ ثْهڒْشذ نِغ ثتْوَاحبْسذ أُو نشِّين وَار ش نْعِيون شَا؟ <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />أَذ د يَاس وزدْجِيذ اَذَاسن يِينِي: أَقَا تسْڒَام ڒْحَقّ: مِين وَار ثݣِّيم شَا إِ يِجّن ن وُوْمَا ذ اَمزْيَان زݣ أَيثْمَا، وَار ذَايِي ت ثݣِّيم شَا إِ نش. <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />أَذ رَاحن يِيْنَا غَار ثْمسِّي إِي وَار يخسِّين عمَّارْص. وَلَكِن يصبْحَانن اَذ رَاحن غَار ثُوْذَارْث ن ڒبْدَا."<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">ئِجّن ن ثمْغَارْث ثݣَّا اَمَان ن لْوَرْذ إِ سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />وَامِي يكمّڒ عِيْسَى اَوَاڒ نِّي ينَّا-ٱسن إِ يمحْضَارن نّس: <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />"ثسّْنم بلِّي ڒْعِيذ اَمقّْرَان ن أَيث-إِسْرَائِيل يقِّيم-اَس يُوْمَاين. ذَايس إِي غَا يتْوَاسلّم مِّيس ن بْنَاذم اَذ يتْوَاصلّب."<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />سّنِّي مُوْنن اَرُّوْيَاس ن ڒْفُقَهَا ذ يمقّْرَانن ن أَيث-إِسْرَائِيل ذِي ثدَّارْث ن اَرَّايس ن ڒْفُقَهَا ونِّي ؤُمِي قَّارن قِيَافَا. <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />مْشَاوَارن جَارَاسن حمَا اَذ طّْفن عِيْسَى س ثحْرَايْمِيث اَث نْغن. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />نَّان جَارَاسن: ئِتْخصَّا وَار ث نْتطّف شَا ذِي ڒْعِيذ حمَا شَّعْب وَار يتݣّ شَا لْفَوْضَا.<verse eid="MAT 26:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />عِيْسَى اَقَاث ذݣ وبِيلَاج ن بَيْت عَنْيَا ذِي ثدَّارْث ن يِجّن قَّارن-اَس سِمْعَان بُو-جْذَام. <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />ثقَارّب-د غَارس يجّن ن ثمْغَارْث غَارس يجّن ن ثْزيَّات يتْوَاصنْعن س لْمَرْمَر،<note caller="+" style="f"><char style="fr" closed="false">26‏.7 </char><char style="ft" closed="false">لْمَرْمَر نتَّا ذ يجّن ن نُّوْع وزْرُو يتْشَابَّاه ذِي مَرْمُو.</char></note> ذَايس اَمَان ن لْوَرْذ يغْڒَان س وَاطَّاس. ثْفرّغ-اَس-ثن خ وزدْجِيف نّس وَامِي يقِّيم غَار مِيسَّا. <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />وَامِي ت ࢲْرِين يمحْضَارن مِين ثخْذم، ئِقّس-اَسن ڒْحَاڒ نَّان <char style="it">جَارَاسن</char>: "مَايمِّي قَاع اَضيّع-أَ؟ <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />أَتَاف اَمَان نِّي إِڒِي منْزن س وَاطَّاس ن تْمنْيَاث اَذ مُّوْشنْت إِ يمسْعَان!"<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />ئِسّن عِيْسَى مِينْخف سِّيوْڒن <char style="it">جَارَاسن</char> ينَّا-ٱسن: "مَايمِّي ثسْخيَّاقم ثَمْغَارْث-أَ؟ أَقَا مِين ذَايِي ثݣَّا ذ اَصبْحَان اَطَّاس. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />ئِمسْعَان اَقَاثن اَكِذْوم إِ ڒبْدَا، نش وَار كِذْوم تْغِيمِيغ شَا إِ ڒبْدَا. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />ثْفرّغ-اَيِي اَمَان-أَ ن لْوَرْذ خ دَّات ينُو حمَا اَذَايِي ثْسوْجذ إِ ثنْضڒْث ينُو. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />أَقَا تسْڒَام ڒْحَقّ: مَانِي مَا يُوْوض لْإِنْجِيل ذِي دُّنشْت-أَ اَمن-ثكْمَاڒ، أَتَاف اَذ عَاوْذن خ ثَمْغَارْث-أَ ذ مِين ذَايِي ثݣَّا اَم يِجّن ن ذِكْرَا خَاس."<verse eid="MAT 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />أُوْشَا يكَّر يَهُوْذَا إِسْخَريُوطِي ونِّي زِي ثنْعَاش ن اَرُّسُل يرُوْح نتَّا غَار اَرُّوْيَاس ن ڒْفُقَهَا <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />ينَّا-ٱسن: "مِين ذَايِي غَا ثُوْشم مڒَا ؤُوِيغ-اَوم-د عِيْسَى؟" حسْبن-اَس ثْڒَاثِين ن ثْپـيَّاسِين ن نُّقَارْث ؤُشِين-اَس-ثنْت. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />سّنِّي يرزُّو يَهُوْذَا لْفُوْرْصَا مَامّش إِي غَا يݣّ اَذ يزّنْز عِيْسَى.<verse eid="MAT 26:16" /></para>
  <para style="s">أَمنْسِي ن ڒْعِيذ اَمقّْرَان ن أَيث-إِسْرَائِيل</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />نْهَار اَمزْوَارُو ن ڒْعِيذ ن ثفْضِيرْث قَارّْبن-د يمحْضَارن غَار عِيْسَى نَّان-اَس: "مَانِي ثخْسذ اَذَاش نْسوْجذ اَمنْسِي ن ڒْعِيذ اَمقّْرَان؟"<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />ينَّا-ٱسن عِيْسَى: "رُوْحم غَار ثنْدِينْت إِنِيم-اَس إِ فْڒَان قَا ينَّا-يَاش سِيذِيثْنغ ثْسَعَّات ينُو ثِيْوض-د اَكِش إِي غَا عيّْذغ نش ذ يمحْضَارن ينُو." <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />يمحْضَارن ݣِّين مِينْخف ثن يوصَّا عِيْسَى سّنِّي سْوجْذن اَمنْسِي ن ڒْعِيذ.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />ثُوْوض-د ثْمدِّيث، ئِقِّيم عِيْسَى اَك ثنْعَاش ن اَرُّسُل نّس غَار مِيسَّا. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />قِّيمن تتّن ينَّا-ٱسن عِيْسَى: "أَقَا تسْڒَام ڒْحَقّ: يجّن زَّايوم اَذَايِي يزّنْز."<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />أُوْشَا خيّْقن اَطَّاس بْذَان تْسقْسَان-ث ئِج-يج نَّان-اَس: "وَار يدْجِي بُو ذ نّش، يَاش آ سِيذِي؟"<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />ئِنْدق-د عِيْسَى ينَّا-ٱسن: ونِّي إِي كِذِي يسِّيسْنن ذِي طّبْسِي ذ ونِّي إِي ذَايِي غَا يزّنْزن. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />مِّيس ن بْنَاذم اَذَاس يوْقع عْلَاحْسَاب مَامش خَاس يقَّار لْكِتَاب، وَلَكِن يَا ڒفْضِيحث ن بْنَاذم نِّي إِي ث غَا يزّنْزن! حْسن إِ نتَّا مْڒِي وَار د يخْڒِيق شَا."<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />أُوْشَا ينَّا-ٱس يَهُوْذَا يعْنِي ونِّي إِي ث غَا يزّنْزن: "وَار يدْجِي بُو ذ نش، يَاش آ سِيذِي؟"</para>
  <para style="p" vid="MAT 26:25">ينَّا-ٱس عِيْسَى: "ذ شك إِي ث ينَّان."<verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />وَامِي عَاذ تتّن، ئِيْسِي-د اَغْرُوْم يشكَّر أَربِّـي يرْزَا اَغْرُوْم نِّي يُوْشَا-ٱسن-ث إِ يمحْضَارن نّس ينَّا-ٱسن: "يْسِيم-ث شّم-ث، وَا إِݣ يدْجَان ذ دَّات ينُو." <verse eid="MAT 26:26" /><verse number="27" style="v" sid="MAT 26:27" />ييْسِي-د ڒْكَاس يشكَّر أَربِّـي يُوْشَا-ٱسن-ث. ينَّا-ٱسن: "سْوم زَّايس مَارَّا إِذْوم. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />ڒْكَاس-أَ ذَايس يذَامّن<note caller="+" style="f"><char style="fr" closed="false">26‏.28 </char><char style="ft" closed="false">ئِذَامّن نتَّا ذ دّم.</char></note> ن ڒْعَهذ، يعْنِي ذ يذَامّن ينُو إِي غَا يَازّْڒن عْلَاحْسَاب اَطَّاس ن يِوْذَان حمَا اَذَاسن يغْفَر <char style="it">أَربِّـي</char> ڒْمُعْصِيَاث نْسن. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />أَقَا قَّارغ-اَوم: زِي سَّا اَڒ ثْسَاونْت وَار سسّغ شَا زݣ وَامَان-أَ ن وضِيڒ حتَّا اَڒ نْهَار نِّي إِي ثن غَا سْوغ اَكِذْوم زِي جْذِيذ ذِي ڒْمُلْك ن بَابَا."<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />غنّْجن يجّن ن يِزْڒِي ن ڒْعِيذ، سّنِّي فّْغن رُوْحن غَار وذْرَار ن زِّيتُوْن.<verse eid="MAT 26:30" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يسَّاوَاڒ خ ونْكَار ن بُطْرُس</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />ينَّا-ٱسن عِيْسَى إِ يمحْضَارن نّس: "دْجِيڒث-أَ ثَانِيتَا اَذَايِي ثْسمْحم مَارَّا إِذْوم مِينْزِي يقَّار لْكِتَاب: أَذ ؤُوْثغ ونِّي يرَاسّن يحُوْڒِيْين، كُڒ يجّن زِي ثْحِيمرْث مَانِي غَا يَرْوڒ.<note caller="+" style="f"><char style="fr" closed="false">26‏.31 </char><char style="ft" closed="false">خْزَر زَكَرِيَا 13‏:7.</char></note> <verse eid="MAT 26:31" /><verse number="32" style="v" sid="MAT 26:32" />وَلَكِن خْمِي د غَا كَّرغ زِي ڒْموْث، أَذَاوم يزْوَارغ غَار ثْمُوْرْث ن لْجَلِيل."<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />ئِنْدق-د بُطْرُس ينَّا-ٱس: "وَاخَّا اَذَايش غَا سمْحن مَارَّا، نش وَار ذَايش سمْحغ شَا عمَّارْص."<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />ينَّا-ٱس عِيْسَى: "أَقَا تسْڒِيذ ڒْحَقّ: ثَا، دْجِيڒث-أَ قْبڒ مَا ٱذ يدّن ؤُيَازِيض اَتَاف اَذَايِي ثنْكَرذ ثْڒَاثَا ن ثْوَاڒَاثِين."<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />ينَّا-ٱس بُطْرُس: "نش وَار ش نكَّرغ شَا وَاخَّا اَكِذش إِي غَا مّْثغ." أَمنِّي إِي نَّان مَارَّا يمحْضَارن.<verse eid="MAT 26:35" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى يتْࢲَادْجَا ذݣ وذْرَار ن زِّيتُوْن</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />يُوْسَا-د عِيْسَى اَك يمحْضَارن نّس غَار يِجّن ن ومْشَان قَّارن-اَس &lt;ݣَتْسِمَانِي.&gt; ينَّا-ٱسن: "قِّيمم ذَا، نش اَذ رَاحغ ذِيهَا اَذ ࢲَّادْجغ." <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />يُوْوِي اَكِس بُطْرُس ذ ثْنَاين ن ثَارْوَا ن زَبَادِي، ئِبْذَا يتْنخْڒَاع يتْخيَّاق. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />ينَّا-ٱسن: "ڒَعْمَر ينُو عْڒَاين اَذ يدُّوْقّز س لْحُزن. قِّيمم ذَا ثْفَاقم اَكِذِي." <verse eid="MAT 26:38" /><verse number="39" style="v" sid="MAT 26:39" />ئِبعّذ خَاسن شْوَايْت، ئِسجّذ غَار ثْمُوْرْث يبْذَا يتتَّار إِ أَربِّـي ينَّا: "آ بَابَا، مڒَا مُمْكِن سْبعّذ-يث خَافِي ڒْكَاس-أَ ن ڒَعْذَاب. مَاشِي مَامش خْسغ نش؛ لَّا، مَامش يخس ڒْخَاضَر نّش شك."<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />ئِذْوڒ غَار يمحْضَارن-أَ يُوْفِي-ثن طّْصن، ينَّا-ٱس إِ بُطْرُس: "مَا وَار ثْزمَّرم شَا اَكِذِي ثْفَاقم وَاخَّا ذ يجّن ن ثْسَعَّات وَاهَا؟ <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />إِڒِيم عْلَابَال ࢲَّادْجم حمَا وَار تِيذْفم شَا ذِي ڒمْحَاين. ؤُڒ ن بْنَاذم يوْجذ وَلَكِن دَّات نّس ثضْعف." <verse eid="MAT 26:41" /><verse number="42" style="v" sid="MAT 26:42" />ئِبعّذ خَاسن ثْوَاڒَا وِيس ثْنَاين، ئِتَّار إِ أَربِّـي ينَّا: "آ بَابَا، مڒَا ڒْكَاس-أَ ن ڒَعْذَاب وَار خَافِي ثسْبعّْذذ شَا سْوِيغ-ث، أَتَاف اَذ يِيڒِي مِين يخس ڒْخَاضَر نّش."<verse eid="MAT 26:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43" />ئِذْوڒ-د عَاوذ غَارْسن يُوْفِي-ثن طّْصن ڒَاحقَّاش يغلّب خَاسن يِيضص. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />ئِبعّذ خَاسن عَاوذ، يࢲُّودْج ثْوَاڒَا وِيس ثْڒَاثَا ينَّا مَامش ينَّا قْبڒ.<verse eid="MAT 26:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45" />ئِذْوڒ-د غَار يمحْضَارن-أَ ينَّا-ٱسن: "عَاذ ثطّْصم، عَاذ ثْريّْحم؟ صَافِي، بَرَكَا! أَقَا ثُوْوض-د ڒْوقْث نِّي إِي ذِي غَا يتْوَاسلّم مِّيس ن بْنَاذم غَار يفَاسّن ن يِنِّي يعصَّان. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />كَّرم أَ نُوْيُوْرم، قَا ونِّي إِي ذَايِي غَا يزّنْزن اَقَاث يُوْسَا-د."<verse eid="MAT 26:46" /></para>
  <para style="s">أَيث-إِسْرَائِيل ذ يرُوْمَانِيْين تطّْفن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />يَالَّاه عِيْسَى يسَّاوَاڒ يُوْوض-د يَهُوْذَا، ئِجّن زِي ثنْعَاش نِّي ن اَرُّسُل نّس. يُوْوِي-د اَكِذس ڒْغَاشِي اَطَّاس يْسِين ڒسْيُوْف ذ يدبُّوْزن. سّكّن-ثن-د اَرُّوْيَاس ن ڒْفُقَهَا ذ يمقّْرَانن ن أَيث-إِسْرَائِيل. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />ونِّي إِي ث غَا يزّنْزن <char style="it">يعْنِي يَهُوْذَا</char> قْبڒ تُوْغَا يتَافق اَكِذْسن خ يِجّن ن لْعَلَامَا ينَّا-ٱسن: ونِّي خف غَا سدْجْمغ ذ ونِّي إِي خف ثْرزُّوْم، طّْفم-ث." <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />ڒخْدّنِّي يقَارّب يَهُوْذَا غَار عِيْسَى ينَّا-ٱس: "سَّلَام آ سِيذِي." أُوْشَا يسدْجم خَاس.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />ينَّا-ٱس عِيْسَى: "آي اَمدُّوْكڒ، مِينْغَار د ثُوْسِيذ اݣّ-يث." أُوْشَا قَارّْبن-د غَار عِيْسَى حرْثن خَاس، طّْفن-ث.<verse eid="MAT 26:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 26:51" />ئِكَّر-د يِجّن زݣ يِنِّي ذِنِّي يدْجَان اَك عِيْسَى يسْوِيزّذ يجْبذ-د سِّيف، يُوْوْثَا زَّايس يسْمغ ن اَرَّايس ن ڒْفُقَهَا يقسّ-اَس اَمزُّوْغ. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />ينَّا-ٱس عِيْسَى: "أَرّ سِّيف نّش غَار ومْشَان نّس، ڒَاحقَّاش مَارَّا يِنِّي يكسِّين سِّيف تْمتَّان س سِّيف. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />مَا تْغِير-اَش وَار زمَّرغ اَذ تَّارغ إِ بَابَا اَذَايِي د يسّكّ ڒخُّو كْتَار زِي ثنْعَاش ن لْجُيُوْش ن لْمَلَائِكَاث؟ <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />وَلَكِن مَامّش إِي غَا يكمّڒ وَاوَاڒ إِي ينَّا سِيذِي أَربِّـي بلِّي مَانَايَا يتْخصَّا اَذ يوْقع اَمُّو؟"<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />ڒخْدّنِّي ينَّا-ٱسن عِيْسَى إِ يِوْذَان نِّي: "مَا تْغِير-اَوم قَا نش ذ لْمُجْرِم وَامِي د ثيْسِيم ڒسْيُوْف ذ يدبُّوْزن حمَا اَذَايِي ثطّْفم نِغ؟ تُوْغَا تْغِيمِيغ مْكُڒ نْهَار ذِي ثمْزِيذَا ثَمقّْرَانْت، سڒْمَاذغ ذِنِّي وَار ذَايِي ثطِّيفم شَا. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />وَلَكِن مَارَّا مَانَايَا يوْقع حمَا اَذ يكمّڒ مِين يُوْرِين ذِي لْكُتُب ن لْأَنْبِيَا." أُوْشَا سمْحن ذَايس مَارَّا يمحْضَارن نّس اَروْڒن.<verse eid="MAT 26:56" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى زَّاث إِ لْحُكَّام ن أَيث-إِسْرَائِيل</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />يِنِّي يطّْفن عِيْسَى ؤُوِين-ث غَار اَرَّايس ن ڒْفُقَهَا قَّارن-اَس قِيَافَا. مُوْنن اَكِذس يمقّْرَانن ن أَيث-إِسْرَائِيل ذ يمْسڒْمَاذن ن شَّرِيعَا. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />ئِذْفَار-يث بُطْرُس زِي ڒݣّْوَاج، يُوْذف غَار ڒمْرَاح ن ثدَّارْث ن اَرَّايس ن ڒْفُقَهَا. يُوْذف يقِّيم ذِي ڒمْرَاح اَك يعسَّاسن حمَا اَذ يࢲر مِين غَا يوقْعن.<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />أَرُّوْيَاس ن ڒْفُقَهَا ذ مَارَّا جْمَاعث ن لْحُكَّام ن أَيث-إِسْرَائِيل رزُّوْن ؤُو غَا يشهْذن ࢲُّوْر خ عِيْسَى حمَا اَث نْغن. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />وَار ؤُفِين شَا مِينْخف رزُّوْن وَاخَّا اَطَّاس إِي خَاس يشهّْذن ࢲُّوْر. منْبَعْد حْضَارن-د ثْنَاين <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />نَّان: "أَرْيَاز-أَ ينَّا: زمَّرغ اَذ هذْمغ ثَمْزِيذَا ثَمقّْرَانْت ن أَربِّـي، أَت بْنِيغ ذِي ثڒْتِيَّام."<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />أُوْشَا يبدّ اَرَّايس ن ڒْفُقَهَا ينَّا-ٱس إِ عِيْسَى: مَا وَار ثقَّارذ وَالُو شك؟ مِين خَاش شهّْذن يِوْذَان-أَ؟"<verse eid="MAT 26:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MAT 26:63" />ئِقِّيم عِيْسَى يسْقَر وَار ذَاس يِينِّي وَالُو. أُوْشَا ينَّا-ٱس اَرَّايس نِّي: "تتَّارغ زَّايش اَذَانغ ثجَّادْجذ س أَربِّـي يدَّرن حمَا اَذَانغ ثِينِيذ: مَا شك ذ لْمَسِيح، ذ مِّيس ن أَربِّـي؟"<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />ينَّا-ٱس عِيْسَى: "أَقَا ثنِّيذ-ث شك. إِنَّمَا، أَقَا قَّارغ-اَوم: زِي سَّا اَڒ ثْسَاونْت اَذ تࢲرم مِّيس ن بْنَاذم يقِّيم خ وفُوْسِي ن لْقَوِي. أَث ثࢲرم عَاوذ يهوَّا-د اَك وسيْنُو ن وجنَّا."<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />ڒخْدّنِّي اَرَّايس نِّي ن ڒْفُقَهَا يغَرص اَرُّوْض خ يِيخف نّس ينَّا-ٱسن: "مَا ثسْڒِيم-اَس يقَّار لْمُنْكَر خ سِيذِي أَربِّـي؟ وَار نحْذِيج بُو ڒشْهُوْذ! <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />مِين ذَاوم يمظْهَارن؟"</para>
  <para style="p" vid="MAT 26:66">ندْقن-د نَّان: "وَانِيتَا يسْذَاهدْج ڒْموْث!"<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />ڒخْدّنِّي سُّوْسُوْفن خَاس خ وغمْبُوْب شَّاثن-ث س ڒْپُـوْنْيَاث. ڒبْعَاض زَّايسن تْسقَّاڒن-ث، <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />قَّارن-اَس: "إِيوَا آ نَّبِي لْمَسِيح، سّن ؤُو ش يُوْوْثِين زَّايْنغ!"<verse eid="MAT 26:68" /></para>
  <para style="s">بُطْرُس ينكَّر سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />بُطْرُس يقِّيم غَار بَرَّا ذِي ڒمْرَاح. ثْقَارّب غَارس يجّن ن ثْخدَّانْت ثنَّا-ٱس: "ؤُڒَا ذ شك ثدْجِيذ اَك عِيْسَى زِي لْجَلِيل."<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />ئِنْكَر بُطْرُس زَّاث إِ يِوْذَان نِّي مَارَّا ينَّا-ٱس: "وَار سِّينغ شَا مِينْخف ثسَّاوَاڒذ!"<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />ئِفّغ بُطْرُس يرُوْح طَّارْف ن ثوَّارْث ن ڒمْرَاح. ثࢲْرِي-ث يجّن ن ثْخدَّانْت نّغْنِي ثنَّا-ٱسن إِ يِنِّي يحْضَارن ذِنِّي: "أَرْيَاز-أَ يتِيڒِي اَك عِيْسَى زِي نَاصِرَا!"<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />ئِنْكَر بُطْرُس عَاوذ ينَّا-ٱسن: "أَذَاوم جَّادْجغ، أَرْيَاز-أَ وَار ث سِّينغ شَا."<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />منْبَعْد شْوَايْت قَارّْبن-د غَار بُطْرُس يِنِّي يحْضَارن ذِنِّي نَّان-اَس: "شك ذ يجّن زَّايسن، وَار ذَايس بُو شّكّ. تْوَاعقْڒذ غِير ذݣ وَاوَاڒ نّش."<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />ئِكَّر بُطْرُس يبْذَا يتْحَرَّام يخف نّس يتْجَادْجَا يقَّار-اَسن: "نش اَرْيَاز-أَ وَار ث سِّينغ شَا!" ڒخْدّنِّي يدّن ويَازِيض. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />ذِنِّي يفكَّر-د بُطْرُس اَوَاڒ نِّي ن عِيْسَى وَامِي ذَاس ينَّا: قْبڒ مَا ٱذ يدّن ويَازِيض اَتَاف اَذَايِي ثنْكَرذ ثْڒَاثَا ن ثْوَاڒَاثِين. ئِفّغ غَار بَارَّا يرُو يمطَّاون ذ يمدْجَاحن اَطَّاس.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">ڒْموْث ن يَهُوْذَا إِسْخَرْيُوطِي</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />وَامِي يصْبَح ڒْحَاڒ، مَارَّا اَرُّوْيَاس ن ڒْفُقَهَا ذ يمقّْرَانن ن أَيث-إِسْرَائِيل مْشَاوَارن جَارَاسن حمَا اَذ نْغن عِيْسَى. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />شَرْفن-ث ؤُوِين-ث اَث سلّْمن إِ لْحَاكم اَرُّوْمَانِي ؤُمِي قَّارن بِيلَاطُس.<verse eid="MAT 27:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />يَهُوْذَا ونِّي إِݣ يزّنْزن عِيْسَى، وَامِي يࢲْرَا بلِّي عِيْسَى يتْوَاحْكم ينْدم. وَامِي ينْدم يرُوْح غَار اَرُّوْيَاس ن ڒْفُقَهَا ذ يمقّْرَانن ن أَيث-إِسْرَائِيل يَارَّا-ٱسن ثْڒَاثِين نِّي ن ثْپـيَّاسِين ن نُّقَارْث. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />ينَّا-ٱسن: "نش عْصِيغ وَامِي سلّْمغ يجّن إِ ڒْموْث نتَّا وَار يݣِّي مِينْخف!"</para>
  <para style="p" vid="MAT 27:4">نَّان-اَس نِثْنِي: "ونِّي ذ شّْغڒ نّش! نشِّين، مِين ذَانغ يرُوْحن؟"<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />ڒخْدّنِّي ينْضَر تْمنْيَاث نِّي ذِي ثمْزِيذَا ثَمقّْرَانْت، يفّغ سّنِّي يرُوْح يجيّف يخف نّس.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />أَرُّوْيَاس ن ڒْفُقَهَا جمْعن تْمنْيَاث نِّي نَّان: "تْمنْيَاث-أَ ذ تَّمَن ن يذَامّن ن بْنَاذم.<note caller="+" style="f"><char style="fr" closed="false">27‏.6 </char><char style="ft" closed="false">بْنَاذم-أَ نتَّا ذ سِيذِيثْنغ عِيْسَى.</char></note> شَّرِيعَا نّغ وَار ذَانغ ثْسمّح اَثنْت نْسرْس ذِي صّنْدُوْق ن ثمْزِيذَا." <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />مْشَاوَارن جَارَاسن، سْغِين زَّايْسنْت ثَمُوْرْث نِّي ؤُمِي قَّارن &lt;ئِيْير ن ونِّي يتْصنَّاعن ڒقْشُوْع&gt;<note caller="+" style="f"><char style="fr" closed="false">27‏.7 </char><char style="ft" closed="false">&lt;ثَمُورْث ن ونِّي يتْصنَّاعن ڒقْشُوْع&gt; يخس اَذ يِينِي س ثعْرَابْث "حقل الخزّاف." خْزَر عَاوذ لْأَيَا 27‏:10.</char></note> حمَا اَذَايس ݣّن يمضْڒَان إِ ڒْبَارَّانِي. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />س مَانَاينِّي إِي ذَاس قَّارن &lt;ئِيْير يذَامّن&gt; اَڒ ڒخُّو عَاذ.<verse eid="MAT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9" />أَمنِّي يكمّڒ وَاوَاڒ إِݣ ينَّا نَّبِي إِرْمِيَا ذݣ يِجّن ن زْمَان: &lt;جمْعن ثْڒَاثِين نِّي ن ثْپـيَّاسِين، تَّامَان نِّي إِي خف تَافْقن يِوْذَان ن أَيث-إِسْرَائِيل إِي خَاس ݣِّين خ نتَّا. <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />سْغِين زَّايْسنْت ثَمُوْرْث ن ونِّي يتْصنَّاعن ڒقْشُوْع؛ أَمنِّي إِي ذَايِي يوصَّا سِيذِي أَربِّـي.&gt;<verse eid="MAT 27:10" /></para>
  <para style="s">تَاوِين سِيذِيثْنغ عِيْسَى غَار لْحَاكم بِيلَاطُس</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />ئِبدّ عِيْسَى زَّاث إِ لْحَاكم نِّي اَرُّوْمَانِي. ئِسّقْسَا-ث لْحَاكم ينَّا-ٱس: "مَا ذ شك ذ اَزدْجِيذ ن أَيث-إِسْرَائِيل؟"</para>
  <para style="p" vid="MAT 27:11">ينَّا-ٱس عِيْسَى: "أَقَا ثنِّيذ-ت شك."<verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />وَامِي ث تَهَامن اَرُّوْيَاس ن ڒْفُقَهَا ذ يمقّْرَانن ن أَيث-إِسْرَائِيل، وَار خَاسن يَارِّي شَا.<verse eid="MAT 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13" />ينَّا-ٱس بِيلَاطُس: "مَا وَار تسْڒِيذ شَا مِين قَّارن ذ مَارَّا مِين خَاك تْشثْشَان؟"<verse eid="MAT 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14" />وَار خَاسن يَارِّي عِيْسَى بُو وَاوَاڒ. ئِقِّيم لْحَاكم نِّي يتْعجّب اَطَّاس.<verse eid="MAT 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />ذِي مْكُڒ ڒْعِيذ أَمقّْرَان ينُوْم لْحَاكم يضدْجق-اَسن-د إِ يِجّن ن ومحْبُوْس عْلَاحْسَاب ونِّي يخس شَّعْب. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />ذِي ڒْوقْث نِّي غَارْسن يجّن ن ومحْبُوْس مَعْرُوف قَّارن-اَس بَارَابَاس. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />وَامِي مُوْنن يِوْذَان، ئِسّقْسَا-ثن لْحَاكم بِيلَاطُس ينَّا-ٱسن: "مَانْون إِي ثخْسم اَذَاوم د رْخُوْغ، مَا إِ بَارَابَاس نِغ إِ عِيْسَى ونِّي ؤُمِي قَّارن لْمَسِيح؟" <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />تُوْغَا يسّن بِيلَاطُس بلِّي سلّْمن-اَس عِيْسَى ڒَاحقَّاش حسْذن-ث.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />وَامِي يقِّيم لْحَاكم بِيلَاطُس خ ڒْكُرْسِي ن ڒحْكَام، ثسّكّ-د غَارس ثمْغَارْث نّس ثنَّا-ٱس: "تَارك-اَس إِ ورْيَاز-أَ يصْفَان ڒَاحقَّاش عدّْبغ اَطَّاس دْجِيڒث-أَ ذِي ثِيرْجِيث خ سَّبَاب نّس."<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />وَلَكِن اَرُّوْيَاس ن ڒْفُقَهَا ذ يمقّْرَانن ن أَيث-إِسْرَائِيل قڒْبن اَزدْجِيف إِ ڒْغَاشِي حمَا اَذَاسن-د يسُوْفغ بَارَابَاس، عِيْسَى اَذ يمّث.<verse eid="MAT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21" />ئِسّقْسَا-ثن لْحَاكم ينَّا-ٱسن: "مَانْون إِي ثخْسم زِي ثْنَاين-أَ اَذَاس رْخُوْغ؟"</para>
  <para style="p" vid="MAT 27:21">نَّان-اَس: "بَارَابَاس."<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />ينَّا-ٱسن بِيلَاطُس: "إِيوَا، مِين ذَاس غَا ݣّغ إِ عِيْسَى ونِّي ؤُمِي قَّارن لْمَسِيح؟"</para>
  <para style="p" vid="MAT 27:22">نَّان-اَس مَارَّا: "صلّب-يث!"<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />ينَّا-ٱسن بِيلَاطُس: "مَايمِّي؟ مَان لْجَرِيمَا إِݣ يݣّا وَانِيتَا؟"</para>
  <para style="p" vid="MAT 27:23">وَلَكِن اَرنِّين سْنكَّرن ثْغُوْيّث س جّْهذ قَّارن: "صلّب-يث!"<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />وَامِي يُوْفَا بِيلَاطُس بلِّي وَار يقْضِي وَالُو اَرْنِين ذِي لْفَوْضَا، ييْسِي اَمَان يسِيرذ يفَاسّن نّس زَّاث إِ ڒْغَاشِي نِّي ينَّا-ٱسن: "أَقَا نش تْبرِّيغ اَزدْجِيف ينُو زݣ يذَامّن<note caller="+" style="f"><char style="fr" closed="false">27‏.24 </char><char style="ft" closed="false">ئِذَامّن نتَّا ذ دّم.</char></note> ن ورْيَاز-أَ! أَقَاث خ يِيرِي نْوم!"<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />أَرِّين خَاس مَارَّا إِذْسن نَّان-اَس: "ئِذَامّن نّس خ يِيرِي نّغ ذ ثَارْوَا نّغ!"<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />سّنِّي يضْڒق-اَسن-د إِ بَارَابَاس. عِيْسَى ؤُوْثِين-ث س وسْغُوْن، أُوْشَا يسلّم-اَسن-ث بِيلَاطُس حمَا اَث صلّْبن خ صَّلِيب.<verse eid="MAT 27:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />ؤُوِين-ث ڒْعَسْكَار ن لْحَاكم غَار ڒمْرَاح ن ڒقْصَار ن لْحَاكم، سْمُوْنن-د ذِنِّي مَارَّا لْفِرْقَا ن ڒْعَسْكَار نِّي. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />كّْسن-اَس اَرُّوْض نّس، ݣِّين خَاس اَسڒْهَام ذ اَزݣّوَاغ. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />مُوْذن-اَس يجّن ن تَّاج ن يسنَّانن، ݣِّين-اَس-ث خ وزدْجِيف نّس. ݣِّين-اَس غَانِيم ذݣ وفُوْس اَفُوْسِي، وضَان-اَس غَار يْفَادّن بْذَان تْبُوْصَرن خَاس. قَّارن-اَس سَّلَام آي اَزدْجِيذ ن أَيث-إِسْرَائِيل! <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />سُّوْسُوْفن خَاس، يْسِين غَانِيم نِّي بْذَان شَّاثن-ث زَّايس غَار وزدْجِيف.<verse eid="MAT 27:30" /></para>
  <para style="s">تَاوِين سِيذِيثْنغ عِيْسَى حمَا اَث صلّْبن</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 27:31" />وَامِي خَاس كمّْڒن اَبُوْصَار، كّْسن-اَس اَسڒْهَام نِّي ݣِّين-اَس اَرُّوْض نّس ؤُوِين-ث حمَا اَث صلّْبن. <verse eid="MAT 27:31" /><verse number="32" style="v" sid="MAT 27:32" />فّْغن سّنِّي ڒْعَسْكَار ؤُفِين يجّن ن ورْيَاز قَّارن-اَس سِمْعَان زِي ثنْدِينْت ن لْقُرِينَا، ݣِّين خَاس س بزّز اَذ يَرْبُو صَّلِيب ن عِيْسَى. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />ؤُوْضن غَار يِجّن ن ومْشَان قَّارن-اَس &lt;ݣُولْݣُوطَا&gt; (ڒْمَعْنَا ن يِيسم-أَ: أَمْشَان ن جُمْجُمَا).<note caller="+" style="f"><char style="fr" closed="false">27‏.33 </char><char style="ft" closed="false">جُمْجُمَا نتَّاث ذ يغس وزدْجِيف ن ونِّي يمُّوثن.</char></note> <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />ؤُشِين-اَس اَمَان وضِيڒ يخلّط ذَايْسن يجّن ن دّْوَا ذ اَمرْࢲَاݣ. وَامِي ثن يقَّاس، يُوْݣِي اَثن يسو. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />وَامِي ث صلّْبن، ݣِّين لْقُرْعَا خ وَارُّوْض نّس فرْقن-ث جَارَاسن. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />قِّيمن ذِنِّي حْضَان-ث. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />غَار وزدْجِيف نّس ݣِّين-اَس يجّن ن ثڒْوِيحْت ثُوْرَا ذَايس تُّهْمَا نِّي يقَّارن: "وَانِيتَا ذ عِيْسَى، أَزدْجِيذ ن أَيث-إِسْرَائِيل." <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />صلّْبن اَكِذس ثْنَاين ن يشفَّارن، ئِجّن خ وفُوْسِي يجّن خ وࢲڒْمَاض نّس.<verse eid="MAT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39" />ئِوْذَان إِي تكّن سّنِّي تُوْكَّرنْ-ث تْهزَّان اَزدْجِيف نْسن، <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />قَّارن-اَس: "مَا ذ شك إِي غَا يهذْمن ثَمْزِيذَا ثَمقّْرَانْت اَت تبْنِيذ ذِي ثڒْتِيَّام؟ مڒَا شك ذ مِّيس ن أَربِّـي، نجَّا يخف نّش هْوَا-د زݣ وجنَّا زِي صَّلِيب-أَ!"<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />ؤُڒَا ذ اَرُّوْيَاس ن ڒْفُقَهَا اَكِذْسن يمقّْرَانن ن أَيث-إِسْرَائِيل ذ يمْسڒْمَاذن ن شَّرِيعَا تْبُوْصَرن خَاس قَّارن: <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />"ئِسنْجم ينّغْنِي، وَلَكِن وَار يزمَّر شَا <char style="it">ڒخُّو</char> اَذ يسنْجم يخف نّس!" نَّان-اَس: "هْوَا-د آي اَزدْجِيذ ن أَيث-إِسْرَائِيل ڒخُّو زݣ وجنَّا زِي صَّلِيب-أَ حمَا اَزَّايك نَامن! <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />ئِتْوكّڒ خ أَربِّـي؛ مڒَا يرْضَا خَاس أَربِّـي اَث يسنْجم ڒخُّو! ڒَاحقَّاش ينَّا: نش ذ مِّيس ن أَربِّـي." <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />أَمنِّي عَاوذ إِي ث زَوَرن يشفَّارن نِّي إِي كِس يصلّْبن.<verse eid="MAT 27:44" /></para>
  <para style="s">ڒْموْث ن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />غَار ثنْعَاش ن ؤُزِيڒ ثهْوَا-د ثَادْجسْت خ ثْمُوْرْث اَمن-ثكْمَاڒ اَڒ وَامِي عْڒَاين ذ ثْڒَاثَا وعشِّي. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />أَڒ جْوَايه نِّي ن ثْڒَاثَا وعشِّي يرَاغَا عِيْسَى س جّْهذ ينَّا: "<char style="bd">إِيلِي، إِيلِي، لْمَا سبْاقْثَانِي؟</char>" ڒْمَعْنَا ن وَاوَاڒ-أَ: "يَا أَربِّـي، يَا أَربِّـي، مَايمِّي ذَايِي ثْسمْحذ؟"<note caller="+" style="f"><char style="fr" closed="false">27‏.46 </char><char style="ft" closed="false">خْزَر زَّبُور 22‏:1.</char></note> <verse eid="MAT 27:46" /><verse number="47" style="v" sid="MAT 27:47" />سْڒِين-اَس ڒبْعَاض زݣ يِنِّي يحْضَارن ذِنِّي نَّان: "أَقَا يتْڒَاغَا خ نَّبِي إِلْيَاس." <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />ڒخْدّنِّي يرُوْح يجّن زَّايْسن يقْڒع يتَازّڒ، ييْسِي يجّن ن سْپُـوْنْخَا يسغْذص-يت ذݣ وَامَان وضِيڒ ذ يسمَّامن، ئِݣِّي-ت خ يِج وكشُّوْض يُوْشَا-ٱس اَذ يسو. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />نَّان-اَس يِوْذَان نّغْنِي ذِنِّي: "اجّ-يث، أَ نْࢲر مَا ٱذ د يَاس نَّبِي إِلْيَاس مَا ٱث يعْثق نِغ لَّا!" <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />ئِرَاغَا عِيْسَى عَاوذ س يِجّن ن ثْمِيجَّا ثمْغَر أُوْشَا يسلّم بُوْحْبڒ نّس.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />ڒخْدّنِّي إِݣ يقَّرْس اَرّْوَاق ن ثمْزِيذَا ثَمقّْرَانْت خ ثْنَاين، زݣ وجنَّا اَڒ ثْمُوْرْث. يوْقع زِّينْزَال، نْفرْقن يِزْرَا خ ثْنَاين. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />نُوْرْزْمن يمضْڒَان كَّرن-د اَطَّاس ن ڒْمُوْمِنِين يمُّوْثن <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />فّْغن-د زݣ يمضْڒَان. (منْبَعْد <char style="it">إِ ثڒْتِييَّام</char> اَذ د يكَّر عِيْسَى زِي ڒْموْث نِثْنِي اَذ اَذْفن غَار ثنْدِينْت ن لْقُدْس اَذ د مظْهَارن إِ وَاطَّاس ن يِوْذَان.) <verse eid="MAT 27:53" /><verse number="54" style="v" sid="MAT 27:54" />أَعَسْكَارِي نِّي اَمقّْرَان ن اَرُّوْمَانُوْس ذ يِنِّي اَكِذس يحطَّان عِيْسَى ࢲْرِين زِّينْزَال نِّي ذ مِين يوقْعن، ݣّْوْذن اَطَّاس نَّان: "وَانِيتَا ذ مِّيس ن أَربِّـي ذ صَّح!"<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />ذِنِّي اَطَّاس ن ثمْغَارِين خزَّرنت-يد زِي ڒݣّْوَاج. نِثنْتِي تُوْغَا ذْفَارنْت-ث، تْسخَّارنْت خَاس وَامِي تُوْغَاث يدْجَا ذِي ثْمُوْرْث ن لْجَلِيل. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />ذَايْسنْت مَرْيَم ثَمَݣْدَلِيث، ذ مَرْيَم يمَّاس ن يَعْقُوْب اَمزْيَان ذ يُوْسف، ذ يشْتن نّغْنِي نتَّاث ذ يمَّاس ن ثَارْوَا ن زَبَادِي.<verse eid="MAT 27:56" /></para>
  <para style="s">نطّْڒن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />وَامِي د ثُوْوض ثْمدِّيث، يُوْسَا-د يجّن ن تَّاجَر قَّارن-اَس يُوْسف زِي دْشَار ن أَرِيمَاتْيَا. نتَّا س يِيخف نّس تُوْغَا يذْوڒ ذ اَمحْضَار ن عِيْسَى. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />ئِرُوْح غَار لْحَاكم بِيلَاطُس يتَّار-اَس دَّات ن عِيْسَى، ئِكَّر بِيلَاطُس يوصَّا خَاس اَذَاس ت ؤُشن. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />ئِرُوْح يُوْسف يسهْوَا-ت-يد <char style="it">زِي صَّالِب</char>، ئِكفّن-يت س ڒشْفن ينْقَا. <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />ئِسرْس-يت ذݣ ونْضڒ نّس ذ جْذِيذ. نتَّا تُوْغَا يغز-يث <char style="it">زِي قْبڒ</char>ذݣ وزْرُو <char style="it">يݣَّا اَم يِيفْرِي</char>. يسقْنُوْنِّي يجّن ن وزْرُو ذ اَمقّْرَان يَارِّي-ث خ وقمُّوْم ن ونْضڒ نِّي يُوْيُوْر. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />مَرْيَم ثَمَݣْدَلِيث ذ مَرْيَم نِّي نّغْنِي اَقَاثنْت ذِنِّي قِّيمنْت زَّاث إِ ونْضڒ.<verse eid="MAT 27:61" /></para>
  <para style="s">ئِعسَّاسن خ ونْضڒ</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />ثِيوشَّا نّس، يعْنِي نْهَار ن سّبْت ن لْعِبَادَا، رُوْحن اَرُّوْيَاس ن ڒْفُقَهَا ذ ڒْحِزب ن يفَرِّيسِيْين مُوْنن غَار لْحَاكم بِيلَاطُس. <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />نَّان-اَس: "نشِّين نعْقڒ آ سِيذِي، بلِّي وَامِي تُوْغَا يدَّر وغدَّار نِّي ينَّا-د منْبَعْد إِ ثڒْتِيَّام نش اَذ د كَّرغ زِي ڒْموْث." <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />نَّان-اَس: "إِيوَا وصَّا اَذ ݣّن ڒْعَسّث خ ونْضڒ نّس حتَّا اَڒ وِيس ثڒْتِيَّام حمَا وَار د تِيسن يمحْضَارن نّس اَذ يْسِين دَّات نّس اَذ ينِين إِ شَّعْب بلِّي يكَّر-د زِي ڒْموْث. سّنِّي اَذ يوْقع وغْذَار نّس اَنݣَّارُو كْتَار زݣ ونِّي اَمزْوَارُو."<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />ينَّا-ٱسن لْحَاكم بِيلَاطُس: "هَا ڒْعَسْكَار إِي غَا يعسّْسن. رُوْحث ݣّث ڒْعَسّث خ ونْضڒ مَامّش ثخْسم كنِّيو." <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />رُوْحن ݣِّين ڒْعَسّث خ ونْضڒ: شمْعن ثَوَّارْث نّس،<note caller="+" style="f"><char style="fr" closed="false">27‏.66 </char><char style="ft" closed="false">شمْعن ثَوَّارْث ن ونْضڒ، زَعْمَا ݣِّين يجّن ن طَّابَع نِغ يجّن ن لْعَلَامَا خ ثوَّارْث ونْضڒ بَاش مڒَا ثرْزم ثوَّارْث اَذ سّْنن بلِّي ثرْزم.</char></note> جِّين ذِنِّي يعسَّاسن.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">سِيذِيثْنغ عِيْسَى يكَّر-د زِي ڒْموْث</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />وَامِي يعْذُو نْهَار ن سّبْث ن لْعِبَادَا، غَار ڒفْجَر ذِي نْهَار ن ڒْحَد ثُوْسَا-د مَرْيَم ثَمَݣْدَلِيث ذ مَرْيَم نّغْنِي حمَا اَذ ࢲرنْت اَنْضڒ <char style="it">ن عِيْسَى</char>. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />عْلَاغَفْلَا ثنْهزّ ثْمُوْرْث يج ونْهزِّي ذ اَمقّْرَان ڒَاحقَّاش ثهْوَا-د يجّن ن لْمَلَائِكَا ن أَربِّـي زݣ وجنَّا، ثكّس اَزْرُو نِّي <char style="it">خ ثوَّارْث</char> ثقِّيم خَاس. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />ؤُذم نّس يتْشعْشِيع س نُّوْر اَم وَاسَّام، أَرُّوْض نّس نتَّا ذ اَشمْڒَاڒ اَمشْنَاو اَذْفڒ. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />ئِعسَّاسن <char style="it">ن ونْضڒ</char> ݣّْوْذن زَّايس ترْجِيجِين، قِّيمن اَم يمتِّينن.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />ثنْدق-د لْمَلَائِكَا نِّي ثنَّا-ٱسنْت إِ ثمْغَارِين: "وَار تݣّْوْذنْت شَا، نش سّْنغ بلِّي ثْرزُّونْت خ عِيْسَى يتْوَاصلّْبن. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />نتَّا وَار ذَا يدْجِي شَا، ئِكَّر-د زِي ڒْموْث عْلَاحْسَاب مَامّش ينَّا زِي قْبڒ. أَرَاحنْت-يد اَذ تࢲرنْت اَمْشَان نِّي مَانِي تُوْغَا يدْجَا. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />رُوْحنْت ذغْيَا غَار يمحْضَارن نّس إِنِينْت-اَسن اَقَا يكَّر-د زِي ڒْموْث. أَذ يرَاح غَار ثْمُوْرْث ن لْجَلِيل اَكنِّيو يرَاجَا ذِنِّي. ذِنِّي إِي ث غَا ثࢲرم، قَا نِّيغ-اَوم-ث."<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />كَّرنْت نِثنْتِي رُوْحنْت ذغْيَا زݣ ونْضڒ نِّي، ݣّْوْذنْت وَلَكِن فَرْحنْت اَطَّاس. تَازّْڒنْت اَذ سِّيوْضنْت ڒخْبَار-أَ غَار يمحْضَارن ن عِيْسَى.<verse eid="MAT 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9" />سّنِّي يمڒْقَا اَكِسنْت عِيْسَى ينَّا-ٱسنْت: "آزُوْل." قَارّْبنْت غَارس طّْفنْت ذݣ يضَارن نّس سجّْذنْت-اَس.<verse eid="MAT 28:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 28:10" />ڒخْدّنِّي ينَّا-ٱسنْت عِيْسَى: "وَار تݣّْوْذنْت شَا. رُوْحنْت سِيوْضنْت ڒخْبَار إِنِينْت إِ أَيثْمَا: رُوْحث غَار ثْمُوْرْث ن لْجَلِيل ذِنِّي إِي ذَايِي غَا ثࢲرم."<verse eid="MAT 28:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />وَامِي رُوْحنْت نِثنْتِي، ڒبْعَاض ن ڒْعَسْكَار نِّي يتْعسّْسن خ ونْضڒ ذوْڒن غَار ثنْدِينْت سِّيوْضن-اَسن ڒخْبَار إِ اَرُّوْيَاس ن ڒْفُقَهَا خ مَارَّا مِين يوقْعن. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />مُوْنن اَرُّوْيَاس نِّي ن ڒْفُقَهَا اَك يمقّْرَانن ن أَيث-إِسْرَائِيل. وَامِي مْشَاوَارن جَارَاسن، ؤُشِين-اَسن يجّن ن لْعَدَد ن تْمنْيَاث إِ ڒْعَسْكَار نِّي. <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />نَّان-اَسن إِ ڒْعَسْكَار: "أَذ تِينِيم إِ يِوْذَان قَا ؤُسِين-د يمحْضَارن نّس س دْجِيڒث، يْسِين دَّات نّس وَامِي تُوْغَا نشِّين نطّص. <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />أُو مڒَا يَارَّا-د لْحَاكم ڒخْبَار، أَ نمْسفْهَام اَكِذس اَكنِّيو نسْبعّذ خ لْمُشْكِلَا-يَا." <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />كَّرن يْسِين تْمنْيَاث نِّي ڒْعَسْكَار، ݣِّين عْلَاحْسَاب مَامّش ثن وصَّان. أَمنِّي ينْتَاشَر وَاوَاڒ جَار أَيث-إِسْرَائِيل غَار ڒخُّو.<verse eid="MAT 28:15" /></para>
  <para style="s">ڒُوْصِيّث ن سِيذِيثْنغ عِيْسَى ثَنݣَّارُوْت</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />رُوْحن حِيطَاش نِّي ن يمحْضَارن غَار ثْمُوْرْث ن لْجَلِيل غَار وذْرَار نِّي عْلَاحْسَاب مَامّش تُوْغَا ثن يوصَّا عِيْسَى زِي قْبڒ. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />وَامِي ث ࢲْرِين، سجّْذن-اَس وَلَكِن ذِنِّي ڒبْعَاض <char style="it">عَاذ</char> شكّن. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />ئِقَارّب-د غَارْسن عِيْسَى يسِّيوڒ اَكِذْسن ينَّا-ٱسن:</para>
  <para style="p" vid="MAT 28:18">"ثمُّوْش-اَيِي مَارَّا سُّلْطَا ذݣ وجنَّا ذ ثْمُوْرْث. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />إِيوَا رُوْحث غَار يِوْذَان ن مَارَّا ڒݣْنُوْس، أَرّم-ثن ذ يمحْضَارن ينُو. طهَّارم-ثن س وَامَان س يِيسم ن بَابَا ذ مِّيس ذ أَرُّوْح يقدّْسن. <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />سْڒمْذم-اَسن اَذ ݣّن مَارَّا مِينْزِي كنِّيو وصِّيغ. أَقَا نش اَكِذْوم يڒِيغ ڒبْدَا اَڒ غَا يفْنَا زْمَان!"<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>