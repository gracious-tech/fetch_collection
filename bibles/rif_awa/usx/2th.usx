<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TH" style="id">- TarifitABS</book>
  <para style="h">2 أَيث-سلونيك</para>
  <para style="toc3">2سلن</para>
  <para style="toc2">2 أيث-سلونيك</para>
  <para style="toc1">ثَبْرَات وِيس ثْنَاين ن اَرَّسُوْل بُوْلُس غَار أَيث-سَلُوْنِيك</para>
  <para style="mt1">ثَبْرَات وِيس ثْنَاين ن اَرَّسُوْل بُوْلُس غَار أَيث-سَلُوْنِيك</para>
  <chapter number="1" style="c" sid="2TH 1" />
  <para style="s">لْمُقَدِّمَا</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1" />نش ذ بُوْلُس، أَكِذِي سِيلَاس ذ تِيْمُوْتَاوُس، <char style="it">نُوْرَا ثَبْرَات-أَ</char> غَار جْمَاعث ن ڒْمُوْمِنِين ن أَيث-سَلُوْنِيك <char style="it">إِي يُوْمْنن</char> زِي أَربِّـي بَابَاثْنغ ذ عِيْسَى لْمَسِيح سِيذِيثْنغ. <verse eid="2TH 1:1" /><verse number="2" style="v" sid="2TH 1:2" />أَكِذْوم يِيڒِي اَرْضَا ذ ڒهْنَا زِي أَربِّـي بَابَاثْنغ ذ سِيذِيثْنغ عِيْسَى لْمَسِيح.<verse eid="2TH 1:2" /></para>
  <para style="s">لْعِقَاب ن أَربِّـي ذِي يُوْم ن سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3" />آي أَيثْمَا، ئِتْخصَّا أُو لَابُد أَ نْشكَّر أَربِّـي خَاوم ڒبْدَا. قَا مَانَايَا نِيشَان مِينْزِي لْإِيمَان نْوم يتمْغُوْر س وَاطَّاس، مِينْزِي عَاوذ ڒمْحِبّث نْوم ثْرنِّي اَك وَايَاوْيَا. <verse eid="2TH 1:3" /><verse number="4" style="v" sid="2TH 1:4" />خ مَانَايَا ذ كنِّيو إِݣ يدْجَان ذ شَّان نّغ جَار ثْجُمَاع ن ڒْمُوْمِنِين، نسَّاوَاڒ خ صّْبَر نْوم ذ لْإِيمَان نْوم ذِي مَارَّا اَعدّب نِّي ذ مَارَّا ڒمْحَاين نِّي إِي خَاوم إِي تكّن.<verse eid="2TH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5" />مَانَايَا ذ يجّن ن دَّلِيل بلِّي لْحُكم ن أَربِّـي يدْجَا نِيشَان، أُو س دَّلِيل-أَ اَكنِّيو يحْسب ثسْذَاهدْجم ڒْمُلْك نّس إِي خف ثْعدّْبم. <verse eid="2TH 1:5" /><verse number="6" style="v" sid="2TH 1:6" />أَربِّـي نتَّا ذ بَاب ن ڒْحَقّ، أَذ يعدّب س ڒمْحَاين يِنِّي إِي كنِّيو يتْمحَّانن، <verse eid="2TH 1:6" /><verse number="7" style="v" sid="2TH 1:7" />أَذَاوم يُوْش اَرَّاحث اَكِذْنغ كنِّيو يتْوَامحَّانن. مَانَايَا اَذ يِيڒِي خْمِي د غَا يمظْهَار سِيذِيثْنغ عِيْسَى زݣ وجنَّا ذݣ يِجّن ن ثْمسِّي ثْحدّق، أَكِذس د مظْهَارنْت لْمَلَائِكَاث نّس يجهْذن. <verse eid="2TH 1:7" /><verse number="8" style="v" sid="2TH 1:8" />أَذ ينْتَاقم زݣ يِنِّي وَار يسِّينن شَا أَربِّـي ذ يِنِّي وَار يتْطِيعِين شَا إِ لْإِنْجِيل ن سِيذِيثْنغ عِيْسَى. <verse eid="2TH 1:8" /><verse number="9" style="v" sid="2TH 1:9" />أَذ تْوَاعَاقْبن س يِجّن ن لْخَرَاب وَار يفنِّين شَا، أَذ تْوَاحَرّْمن زݣ وغمْبُوْب ن سِيذِيثْنغ ذ لْعَظَمَا ن جّْهذ نّس. <verse eid="2TH 1:9" /><verse number="10" style="v" sid="2TH 1:10" />مَانَايَا اَذ يوْقع ذِي يُوْم نِّي إِي د غَا يَاس سِيذِيثْنغ بَاش اَذ يتْوَاسمْغَار جَار صَّالِحِين نّس، نتَّا اَزَّايس تْعجّْبن مَارَّا يِنِّي يُوْمْنن، ذَايْسن كنِّيو مِينْزِي ثُوْمْنم زِي مِين خَاس نشْهذ.<verse eid="2TH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 1:11" />خ مَانَايَا نْتتَّار إِ أَربِّـي خَاوم ڒبْدَا بَاش اَكنِّيو يَارّ ثسْذَاهدْجم اَڒَاغِي نّس. أُو س جّْهذ نّس اَذَاوم يَارو مَارَّا ڒْخِير إِي ثخْسم أَذ تݣّم، أَذَاوم يَارو كُڒ ڒْخذْمث عَاوذ إِي د تَاسن زِي لْإِيمَان نْوم. <verse eid="2TH 1:11" /><verse number="12" style="v" sid="2TH 1:12" />نْتتَّار-اَس مَانَايَا بَاش يسم ن سِيذِيثْنغ عِيْسَى اَذَايْوم يتْوَاسمْغَار، أَذَايس تْوَامْغَارم عَاوذ كنِّيو عْلَاحْسَاب اَرْضَا ن أَربِّـي نّغ ذ سِيذِيثْنغ عِيْسَى لْمَسِيح.<verse eid="2TH 1:12" /></para>
  <chapter eid="2TH 1" />
  <chapter number="2" style="c" sid="2TH 2" />
  <para style="s">دّجَّال</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1" />أَمَّا يُوْم نِّي خْمِي د غَا يمظْهَار سِيذِيثْنغ عِيْسَى لْمَسِيح نشِّين اَغَارس نْݣَعّذ. آي أَيثْمَا، نقَّار-اَوم <verse eid="2TH 2:1" /><verse number="2" style="v" sid="2TH 2:2" />وَار تنْخْڒِيعم شَا ذغْيَا ذِي ڒَعْقڒ نْوم، وَار تْخيَّاقم شَا عْلَاحْسَاب شَا ن اَرُّوْح <char style="it">ن لْوَاحِي</char> نِغ ذ شَا ن وَاوَاڒ نِغ ذ شَا ن ثبْرَات زَّايْنغ زَعْمَا يقَّارن اَقَا يُوْم ن سِيذِيثْنغ قَا يُوْوض-د. <verse eid="2TH 2:2" /><verse number="3" style="v" sid="2TH 2:3" />لَّا، وَار تجَّام حَدّ اَكنِّيو يشْمث س وَالُو. أَتَاف وَار يزمَّر يُوْم نِّي اَذ د يَاس قْبڒ مَا ٱذ سمْحن اَطَّاس اَطَّاس ن يِوْذَان ذ اَمزْوَارُو ذِي أَربِّـي اَذ د يمظْهَار لْمسْخُوْط مِّيس ن ڒفْنَا. <verse eid="2TH 2:3" /><verse number="4" style="v" sid="2TH 2:4" />نتَّا يتْعَارَّاض إِ أَربِّـي يسمْغَار يخف نّس خ مَارَّا مِينْخف يدْجَا يسم ن أَربِّـي ذ مِين عبّْذن يِوْذَان حتَّا اَذ يقِّيم ذِي ثمْزِيذَا ثَمقّْرَانْت ن أَربِّـي اَذ يعيّض اَذ يِينِي قَا نش ذ أَربِّـي.<verse eid="2TH 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 2:5" />مَا وَار ثعْقِيڒم شَا؟ إِيوَا وَامِي تُوْغَايِي اَكِذْوم قْبڒ قَّارغ-اَوم ثِمسْڒَايِين-أَ. <verse eid="2TH 2:5" /><verse number="6" style="v" sid="2TH 2:6" />كنِّيو ثسّْنم مِين ث يتطّْفن عَاذ بَاش وَار د يتْمظْهَار شَا اَڒ د غَا يَاوض ڒْوقْث نّس نِيشَان. <verse eid="2TH 2:6" /><verse number="7" style="v" sid="2TH 2:7" />شُوْف، ئِجّن ن جّْهذ ينُوْفَّرن ن سَّيِّئَاث يخدّم ڒخُّو، وَلَكِن ذِنِّي يجّن نّغْنِي عَاذ يتطّف-يث حتَّا وَانِيتَا نّغْنِي اَذ يتْوَاكّس زِي ڒْوسْط. <verse eid="2TH 2:7" /><verse number="8" style="v" sid="2TH 2:8" />ثُمَّا اَذ د يمظْهَار لْمسْخُوْط، أَخَاس يصُوْض سِيذِيثْنغ عِيْسَى س وقمُّوْم نّس اَث ينغ، أَث يسْبطّڒ س لْعَظَمَا نّس إِي زِي د غَا يعْقب عِيْسَى. <verse eid="2TH 2:8" /><verse number="9" style="v" sid="2TH 2:9" />لْمسْخُوْط-أَ وَانِيتَا اَذ د يمظْهَار <char style="it">ذِي دُّنشْت-أَ</char> عْلَاحْسَاب ڒخْذَايم ن شِّيطَان س مَارَّا ثِزمَّار ذ لْبُرْهَانَاث ذ ڒَعْجَايب يسْخَرِّيقن <verse eid="2TH 2:9" /><verse number="10" style="v" sid="2TH 2:10" />ذ مَارَّا يبْرِيذن ن شَّرّْ إِي زِي تْوَاشمَّاثن يِنِّي يفنَّان. نِثْنِي اَذ فْنَان مِينْزِي وَار قْبِيڒن شَا اَذ تخْسن لْحَقِيقَا بَاش اَثن يسنْجم أَربِّـي. <verse eid="2TH 2:10" /><verse number="11" style="v" sid="2TH 2:11" />خ مَانَايَا اَذ يسّكّ أَربِّـي اَثن يسْتخِيَّال بَاش اَذ اَمْنن س وخَرِّيق-أَ. <verse eid="2TH 2:11" /><verse number="12" style="v" sid="2TH 2:12" />حمَا اَذ تْوَاحَاسْبن مَارَّا يِنِّي وَار يُوْمِينن شَا س لْحَقِيقَا اَرْضَان س شَّرّْ.<verse eid="2TH 2:12" /></para>
  <para style="s">ڒُوْصِيَاث ثِنݣُّوْرَا</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13" />فَا آي أَيثْمَا إِي خف يعِيزّ سِيذِيثْنغ، لَابُد أَ نْشكَّر أَربِّـي خَاوم مِينْزِي يخْضَر-يكنِّيو ذ يمزْوُوْرَا نِّي يعْنِي ذ يِنِّي إِي تْوَاسْنجْمن س ڒْخذْمث نِّي يسِّيصْفَان ن أَرُّوْح يقدّْسن ذ يِجّن تِّقث نْوم ذِي لْحَقِيقَا. <verse eid="2TH 2:13" /><verse number="14" style="v" sid="2TH 2:14" /><char style="it">أَقَا</char> يڒَاغَا-د خَاوم عْلَاحْسَاب إِ مَانَايَا س لْإِنْجِيل إِي نتْبشَّار بَاش اَذ تْشَرْشم ذِي لْعَظَمَا ن سِيذِيثْنغ عِيْسَى لْمَسِيح.<verse eid="2TH 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TH 2:15" />إِذن آي أَيثْمَا، بدّم نِيشَان، طّْفم ذِي تَّعَالِيم نِّي إِي كنِّيو نْسڒْمذ وَاخَّا س وَاوَاڒ نّغ وَاخَّا س ثبْرَات نّغ.<verse eid="2TH 2:15" /></para>
  <para style="p">
    <verse number="16‏-17" style="v" sid="2TH 2:16-17" />سِيذِيثْنغ عِيْسَى س يِيخف نّس أُو عَاوذ أَربِّـي بَابَاثْنغ ونِّي إِي ذَانغ يُوْشِين س اَرْضَا نّس يجّن ن وشجّع وَار يفنِّين شَا عمَّارْص ذ يجّن ن لْأَمَال يصْبَاح، أَتَاف اَكنِّيو يشجّع س وُوْڒَاون نْوم اَثن يسجْهذ عْلَاحْسَاب ذِي كُڒ ڒْخذْمث ذ كُڒ اَوَاڒ اَصبْحَان.<verse eid="2TH 2:16-17" /></para>
  <para style="b" />
  <chapter eid="2TH 2" />
  <chapter number="3" style="c" sid="2TH 3" />
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1" />أَمَّا ثِمسْڒَايِين نّغْنِي آي أَيثْمَا، تَّارث خَانغ إِ أَربِّـي بَاش اَوَاڒ ن سِيذِيثْنغ اَذ يتنْتَاشَر اَذ يتْوَاسمْغَار مَامّش إِي يوقْعن جَارَاوم. <verse eid="2TH 3:1" /><verse number="2" style="v" sid="2TH 3:2" />تَّارث عَاوذ أَ نفْڒث زݣ يِوْذَان وَار يحْڒِين ذ يعفَّانن مِينْزِي لْإِيمَان وَار يدْجِي شَا ذِي مَارَّا يوْذَان. <verse eid="2TH 3:2" /><verse number="3" style="v" sid="2TH 3:3" />وَلَكِن سِيذِيثْنغ ذَايس تِّقث، أَكنِّيو يسجْهذ اَكنِّيو يحْضَا زِي شَّرّْ. <verse eid="2TH 3:3" /><verse number="4" style="v" sid="2TH 3:4" />نشِّين قَا متْأَكّدِين ذِي سِيذِي أَربِّـي اَقَا مِينْزِي كنِّيو نْوصَّا قَا تݣّم-ث، أَث تݣّم عَاذ. <verse eid="2TH 3:4" /><verse number="5" style="v" sid="2TH 3:5" />أَذ يسِيْوض سِيذِيثْنغ ؤُڒَاون نْوم غَار ڒمْحِبّث ن أَربِّـي، عَاوذ غَار صّْبَر ن لْمَسِيح.<verse eid="2TH 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6" />فَا آي أَيثْمَا، نتْوصَّا-كنِّيو عْلَاحْسَاب يسم ن سِيذِيثْنغ عِيْسَى لْمَسِيح اَذ تْبعّْذم زِي مْكُڒ ڒْمُوْمن يتْبَاعن فَرْق-شّْغڒ، نتَّا وَار يذفَّار شَا تَّعْلِيم إِي ثْقبْڒم زَّايْنغ. <verse eid="2TH 3:6" /><verse number="7" style="v" sid="2TH 3:7" />كنِّيو س يِيخف نْوم ثسّْنم أُو لَابُد اَذ تبْعم اَبْرِيذ نِّي إِي نݣَّا جَارَاوم. نشِّين وَار نتْبِيع شَا فَرْق-شّْغڒ وَامِي تُوْغَانغ اَكِذْوم. <verse eid="2TH 3:7" /><verse number="8" style="v" sid="2TH 3:8" />وَار نشِّي بُو وغْرُوْم اَك حَدّ بَاطڒ. لَّا، نْخدّم دْجِيڒث ذ نْهَار، نشَّاث تَمَارَا نْربّڒ بَاش وَار نتْبسِّيڒ خ حَدّ زَّايْوم. <verse eid="2TH 3:8" /><verse number="9" style="v" sid="2TH 3:9" />نݣَّا مَانَاينِّي مَاشِي وَار غَارْنغ بُو ڒْحَقّ اَذَانغ ثْعَاوْنم؛ لَّا، نْسظْهَار-اَوم-د اَبْرِيذ إِي غَا ثذْفَارم. <verse eid="2TH 3:9" /><verse number="10" style="v" sid="2TH 3:10" />وَاخَّا وَامِي تُوْغَانغ اَكِذْوم نُوْشَا-ٱوم ڒُوْصِيّث-أَ ثَانِيتَا: ونِّي يتَاݣِين اَذ يخْذم وَار يتتّ شَا.<verse eid="2TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 3:11" />لِأَنَّا نتْسْڒَا بلِّي ذِنِّي ڒبْعَاض زَّايْوم تْبَاعن فَرْق-شّْغڒ. وَار خدّْمن شَا شّْغُوْڒَاث نْسن، نِثْنِي تَاذْفن ذِي شّْغُوْڒَاث ن مِيدّن وَاهَا. <verse eid="2TH 3:11" /><verse number="12" style="v" sid="2TH 3:12" />ئِوْذَان-أَ نتْوصَّا-ثن نقَّار-اَسن س يِيْسم ن سِيذِيثْنغ عِيْسَى لْمَسِيح اَذ خذْمن س لْمَعْقُوْل اَذ شّن اَغْرُوْم إِي يدْجَان نْسن. <verse eid="2TH 3:12" /><verse number="13" style="v" sid="2TH 3:13" />أَمَّا كنِّيو آي أَيثْمَا، ݣّث ڒْخِير بْڒَا مَا ٱذ تَاحْڒم.<verse eid="2TH 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TH 3:14" />ونِّي وَار يتْطِيعِين شَا إِ وَاوَاڒ نّغ ذِي ثبْرَات-أَ ݣّم-ث ذِي ڒْبَاڒ نْوم، وَار كِذس ݣُوْرم شَا بَاش اَذ يسذْحَا. <verse eid="2TH 3:14" /><verse number="15" style="v" sid="2TH 3:15" />وَلَكِن وَار ث تْوَاڒَام شَا اَم ڒَعْذُو نْوم؛ لَّا، نْهَام-ث اَم يِجّن زݣ وُوْمَاثْوم.<verse eid="2TH 3:15" /></para>
  <para style="s">لْخِطَام ن ثبْرَات-أَ</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16" />سِيذِيثْنغ ن ڒهْنَا اَذَاوم يُوْش يجّن ن ڒهْنَا ذِي اَيَا ڒْوقْث أُو س مَارَّا ثِمسْڒَايِين. أَذ يِيڒِي سِيذِي أَربِّـي اَكِذْوم مَارَّا. <verse eid="2TH 3:16" /><verse number="17" style="v" sid="2TH 3:17" />سْڒَام-أَ وَانِيتَا ؤُرِيغ-ث نش س وفُوْس ينُو بُوْلُس، ذ تَانِيتَا ذ لْعَلَامَا ينُو يدْجَان ذِي مَارَّا ثِبْرَاثِين ينُو. أَمُّو إِي تَارِيغ نش. <verse eid="2TH 3:17" /><verse number="18" style="v" sid="2TH 3:18" />أَرْضَا ن سِيذِيثْنغ عِيْسَى لْمَسِيح اَكِذْوم يِيڒِي مَارَّا.<verse eid="2TH 3:18" /></para>
  <chapter eid="2TH 3" />
</usx>