<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TH" style="id" />
  <para style="h">1 أَيث-سلونيك</para>
  <para style="toc3">1سلن</para>
  <para style="toc2">1 أيث-سلونيك</para>
  <para style="toc1">ثَبْرَات ثَمزْوَارُوْت ن اَرَّسُوْل بُوْلُس غَار أَيث-سَلُوْنِيك</para>
  <para style="mt1">ثَبْرَات ثَمزْوَارُوْت ن اَرَّسُوْل بُوْلُس غَار أَيث-سَلُوْنِيك</para>
  <chapter number="1" style="c" sid="1TH 1" />
  <para style="s">لْمُقَدِّمَا</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1" />نش ذ بُوْلُس، أَكِذِي سِيلَاس ذ تِيْمُوْتَاوُس. <char style="it">نْتَارِي ثَبْرَات-أَ</char> غَار جْمَاعث ن ڒْمُوْمِنِين ن أَيث-سَلُوْنِيك <char style="it">إِي يُوْمْنن</char> زِي أَربِّـي بَابَاثْنغ ذ عِيْسَى لْمَسِيح سِيذِيثْنغ. أَكِذْوم يِيڒِي اَرْضَا ذ ڒهْنَا.<verse eid="1TH 1:1" /></para>
  <para style="s">بُوْلُس ذ سِيلَاس ذ تِيمُوْتَاوُس تْشكَّرن أَربِّـي</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2" />نشِّين ڒبْدَا نتْشكَّر أَربِّـي خَاوم مَارَّا، نْتتَّار إِ أَربِّـي خَاوم بْڒَا مَا ٱ نْبدّ. <verse eid="1TH 1:2" /><verse number="3" style="v" sid="1TH 1:3" />نتْخمَّام زَّاث ن أَربِّـي يدْجَان ذ بَابَاثْنغ مشْحَاڒ يخدّم لْإِيمَان نْوم، مشْحَاڒ ثربّڒ ڒمْحِبّث نْوم، أُو مشْحَاڒ يصبَّر لْأَمَال نْوم ذِي سِيذِيثْنغ عِيْسَى لْمَسِيح.<verse eid="1TH 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 1:4" />آي أَيثْمَاثْنغ يِنِّي يعِيزّن خ أَربِّـي، نسّن قَا نتَّا يخْضَر-يكنِّيو. <verse eid="1TH 1:4" /><verse number="5" style="v" sid="1TH 1:5" />لِأَنَّا لْإِنْجِيل إِي نتْبشَّار وَار د يُوْسِي شَا غَارْوم س وَاوَاڒن وَاهَا، يُوْسَا-د غَارْوم س ثْزمَّار ذ أَرُّوْح يقدّْسن ذ يِج وقنَّاع يمْغَر. أَقَا ثسّْنم مَامش تُوْغَا نتْعِيش جَارَاوم عْلَاحْسَاب كنِّيو. <verse eid="1TH 1:5" /><verse number="6" style="v" sid="1TH 1:6" />كنِّيو ثبْذَام تݣّم مَامش نْتݣّ نشِّين ذ مَامش يتݣّ سِيذِيثْنغ لِأَنَّا كنِّيو ذِي ڒْوسْط ن وَاطَّاس ن تَمَارَا ثْقبْڒم اَوَاڒ نّغ س ڒفْرَاحث إِي د يُوْسِين زِي أَرُّوْح يقدّْسن. <verse eid="1TH 1:6" /><verse number="7" style="v" sid="1TH 1:7" />أَمُّو ثْذوْڒم ذ يجّن ن لْمِثَال اَث ذفَّرن مَارَّا ڒْمُوْمِنِين إِݣ يدْجَان ذِي لْإِقْلِيم ن مَاسِدُوْنْيَا ذ لْإِقْلِيم ن ؤُخَايَا. <verse eid="1TH 1:7" /><verse number="8" style="v" sid="1TH 1:8" />زَّايْوم كنِّيو إِي د يفّغ صُّوْت ن وَاوَاڒ ن سِيذِيثْنغ. مَاشِي يفّغ-د ذِي مَاسِدُوْنْيَا ذ ؤُخَايَا وَاهَا؛ لَّا، يفّغ-د ڒخْبَر-أَ خ لْإِيمَان نْوم زِي أَربِّـي غَار يِوْذَان ذِي مَارَّا يمُوْشَان. خ مَانَايَا وَار ذَانغ يتْخصِّي شَا اَخَاس نسِّيوڒ <char style="it">مِينْزِي يوْذَان تسْڒَان خَاوم</char>. <verse eid="1TH 1:8" /><verse number="9" style="v" sid="1TH 1:9" />ئِوْذَان نِّي س يِيخف نْسن سُوْفُوْغن خَاوم ڒخْبَار خ مَامش إِي ذَانغ ثْقبْڒم ذ مَامش إِي ثْسمْحم ذِي لْأَصْنَام بَاش اَذ تْعبْذم أَربِّـي يدَّرن إِي يدْجَان ذ صَّح. <verse eid="1TH 1:9" /><verse number="10" style="v" sid="1TH 1:10" />حمَا اَذ تْرَاجَام مِّيس إِي د غَا يَاسن زݣ وجنَّا ونِّي إِي د يسكَّر أَربِّـي زݣ يمتِّينن يعْنِي عِيْسَى إِي ذَانغ يسنْجَامن زݣ وغْضَاب نِّي إِي د غَا يَاسن.<verse eid="1TH 1:10" /></para>
  <chapter eid="1TH 1" />
  <chapter number="2" style="c" sid="1TH 2" />
  <para style="s">ڒْخذْمث ن اَرَّسُوْل بُوْلُس ذِي ثنْدِينْت ن سَلُوْنِيك</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1" />آي أَيثْمَا، كنِّيو س يِيخف نْوم ثسّْنم نّْفَع نِّي إِي د نُوْوِي وَامِي د نُوْسَا غَارْوم. <verse eid="1TH 2:1" /><verse number="2" style="v" sid="1TH 2:2" />ذِي ثنْدِينْت ن فِيلِيپِّـي ثسّْنم بلِّي تْعدَّان خَانغ ذِنِّي تْبُوْصَارن خَانغ. وَلَكِن نشِّين نْزَعم اَكِذْوم، تُوْغَا يتْعَاوَان-اَنغ أَربِّـي بَاش أَ نْبشَّر جَارَاوم س لْإِنْجِيل وَاخَّا شَان يِوْذَان تْعَارَّاضن-اَنغ. <verse eid="1TH 2:2" /><verse number="3" style="v" sid="1TH 2:3" />أَوَاڒ نّغ إِي زِي نتْوصَّا وَار د يتِيس شَا زݣ وغْذَار نِغ زِي مِين يخنْزن نِغ زِي ثحْرَايْمِيث. <verse eid="1TH 2:3" /><verse number="4" style="v" sid="1TH 2:4" />لَّا، ئِضْبع-اَنغ أَربِّـي يكلّف-اَنغ خ وَاوَاڒن-أَ يدْجَان ذِي لْإِنْجِيل. زِي مَانَايَا نسَّاوَاڒ بَاش اَخَانغ يَارْضَا أَربِّـي مَاشِي اَخَانغ اَرْضَان يِوْذَان مِينْزِي ذ نتَّا إِݣ يدْجَان ذ ونِّي يتْميَّازن مِين غَارْنغ ذݣ وُوْڒَاون نّغ. <verse eid="1TH 2:4" /><verse number="5" style="v" sid="1TH 2:5" />شُوْف، قَا ثسّْنم عمَّارْص مَا نْسڒْهَا حَدّ س وَاوَاڒن نِغ عمَّارْص مَا نضْمع حَدّ عْلَاحْسَاب شَا ن سَّبَاب. ئِشهّذ خَانغ أَربِّـي! <verse eid="1TH 2:5" /><verse number="6" style="v" sid="1TH 2:6" />وَار نخْس شَا يرْيَازن اَذَانغ شهَّارن: لَّا كنِّيو، لَّا شَان يرْيَازن نّغْنِي.</para>
  <para style="p" vid="1TH 2:6">نشِّين تُوْغَا نْزمَّر اَخَاوم نْزيَّار س سُّلْطَا نّغ اَم اَرُّسُل. <verse eid="1TH 2:6" /><verse number="7" style="v" sid="1TH 2:7" />وَلَكِن لَّا، نشِّين نْخدّم اَكِذْوم س تَّوَاضُع اَم ثمْغَارْث اَك ثَارْوَا نّس. <verse eid="1TH 2:7" /><verse number="8" style="v" sid="1TH 2:8" />أَمُّو إِي نتْهلَّا ذَايْوم نتْخس-يكنِّيو. نْفَرح وَامِي نْشَرش اَكِذْوم لْإِنْجِيل ذ ثُوْذَارْث نّغ مِينْزِي ثْعِيزَّم خَانغ اَطَّاس.<verse eid="1TH 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 2:9" />آي أَيثْمَا، أَقَا ثْعقْڒم خ ڒْخذْمث نّغ قَا نشِّين نُوْوْثَا خَاس تَمَارَا. وَامِي كنِّيو نتْبشَّار س لْإِنْجِيل ن أَربِّـي، قَا نْخدّم دْجِيڒث ذ نْهَار بَاش وَار نتْبسِّيڒ شَا خ شَان حَدّ زَّايْوم. <verse eid="1TH 2:9" /><verse number="10" style="v" sid="1TH 2:10" />نتْعِيش اَكِذْوم كنِّيو إِي يُوْمْنن س يِجّن ن صّْفَا ذ يِجّن ن وبْرِيذ نِيشَان بْڒَا ڒْعِيب. كنِّيو ذ ڒشْهُوْذ خ مَانَايَا ؤُڒَا ذ أَربِّـي. <verse eid="1TH 2:10" /><verse number="11" style="v" sid="1TH 2:11" />نْتݣّ اَكِذْوم اَم يِجّن ورْيَاز اَك ثَارْوَا نّس. نتْوصَّا-كنِّيو نتْشجَّاع-يكنِّيو نتْزيَّار خَاوم <verse eid="1TH 2:11" /><verse number="12" style="v" sid="1TH 2:12" />بَاش اَذ تُوْيُوْرم س يِجّن ن ثِيشْرِي إِي ذَاس يتِيشّن لْقِيمَا إِ أَربِّـي إِݣ يسْذَاهدْج نتَّا يعْنِي ونِّي إِي ذَاوم د يتْڒَاغَان غَار ڒْمُلْك نّس ذ لْعَظَمَا نّس.<verse eid="1TH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13" />نشِّين نتْشكَّر أَربِّـي <char style="it">خَاوم</char> بْڒَا مَا ٱ نْبدّ وَامِي ثْقبْڒم اَوَاڒ نّس إِي ذَاوم د نْسِيْوض. ثْقبْڒم-ث مَاشِي اَم وَاوَاڒ ن يِوْذَان، ثْقبْڒم-ث اَم وَاوَاڒ ن أَربِّـي نِيشَان. ئِخدّم وَاوَاڒ-أَ عَاوذ ذَايْوم كنِّيو إِي يُوْمْنن. <verse eid="1TH 2:13" /><verse number="14" style="v" sid="1TH 2:14" />آي أَيثْمَا، ثْذوْڒم اَم ثْجُمَاع نِّي ن ڒْمُوْمِنِين ن أَربِّـي ذِي عِيْسَى لْمَسِيح ثِنِّي إِي يدْجَان ذِي ثْمُوْرْث ن يَهُوْذِيَا. لِأَنَّا يوْذَان ن ثْمُوْرْث نْوم تْبُوْصَارن خَاوم اَم أَيث-يَهُوْذِيَا تْبُوْصَارن خ ثْجُمَاع ن ڒْمُوْمِنِين إِي ذِنِّي. <verse eid="1TH 2:14" /><verse number="15‏-16" style="v" sid="1TH 2:15-16" />نِثْنِي نْغِين سِيذِيثْنغ عِيْسَى ذ لْأَنْبِيَا، ؤُڒَا ذ نشِّين سُوْفْغن-اَنغ سّنِّي. وَار خَاسن يَارْضِي شَا أَربِّـي نِثْنِي تْعَارَّاضن إِ مَارَّا يوْذَان، ڒَاحقَّاش وَار ذَانغ تجِّين شَا أَ نسِّيوڒ اَك ڒݣْنُوْس بَاش أَذ نجْمن. أَمنِّي ڒْمُعْصِيَاث نْسن اَرنِّينْت تْعمَّرنْت، لْعِقَاب ن أَربِّـي يوْضَا خَاسن قَاع.<verse eid="1TH 2:15-16" /></para>
  <para style="s">أَرَّسُوْل بُوْلُس ذَايس مزْڒِي اَذ يࢲر ڒْمُوْمِنِين ن أَيث-سَلُوْنِيك</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17" />آي أَيثْمَا، تُوْغَا نْغَاب خَاوم شْوَاي ن ڒْوقْث، وَلَكِن ذݣ وُوْڒَاون نّغ وَار خَاوم نْغِيب شَا. ذِي ڒْوقْث نِّي نتْحَوَاڒ اَطَّاس بَاش أَ د نَاس مِينْزِي ذَايْنغ مزْڒِي اَكنِّيو نْࢲر. <verse eid="1TH 2:17" /><verse number="18" style="v" sid="1TH 2:18" />مشْحَاڒ ن ثْوَاڒَاثِين نخْس اَغَارْوم د نَاس، نش س يِيخف ينُو عَاوذ، وَلَكِن يتْقَاطع-اَنغ-د شِّيطَان ذݣ وبْرِيذ. <verse eid="1TH 2:18" /><verse number="19" style="v" sid="1TH 2:19" />لِأَنَّا ذ كنِّيو إِي يدْجَان ذ لْأَمَال نّغ ذ ڒفْرَاحث نّغ ذ تَّاج نّغ ن شَّان زَّاث إِ سِيذِيثْنغ عِيْسَى خْمِي د غَا يَاس. <verse eid="1TH 2:19" /><verse number="20" style="v" sid="1TH 2:20" />وَاه، ذ كنِّيو إِي يدْجَان ذ شَّان نّغ ذ ڒفْرَاحث نّغ.<verse eid="1TH 2:20" /></para>
  <chapter eid="1TH 2" />
  <chapter number="3" style="c" sid="1TH 3" />
  <para style="p">
    <verse number="1‏-2" style="v" sid="1TH 3:1-2" />إِذن، وَامِي نُوْݣِي أَ نصْبَر عَاذ كْتَار، تُوْغَا نفكَّر حْسن أَ نقِّيم ذِي ثنْدِينْت ن ؤُتِينَا وَاحذْنغ، تِيْمُوْتَاوُس اَثِيذ نسّكّ غَارْوم بَاش اَكنِّيو يسجْهذ اَكنِّيو يشجّع ذِي لْإِيمَان نْوم. نتَّا ذ ؤُمَاثْنغ يخدّم اَكِذْنغ ذِي ڒْخذْمث ن لْإِنْجِيل ن لْمَسِيح. <verse eid="1TH 3:1-2" /><verse number="3" style="v" sid="1TH 3:3" />نسّكّ-يث حمَا ؤُڒَا ذ يجّن وَار يترْجِيجِي شَا س ڒمْحَاين-أَ نْوم؛ أَقَا ثسّْنم بلِّي مَانَايَا إِي خَانغ يُوْرِين. <verse eid="1TH 3:3" /><verse number="4" style="v" sid="1TH 3:4" />وَاه، وَامِي تُوْغَانغ اَكِذْوم قْبڒ نقَّار-اَوم قَا ڒمْحَاين اَخَانغ كّنْت. ذ مَانَايَا إِݣ يوقْعن قَا ثسّْنم كنِّيو. <verse eid="1TH 3:4" /><verse number="5" style="v" sid="1TH 3:5" />خ مَانَايَا، وَامِي ؤُݣِيغ اَذ صْبَرغ عَاذ كْتَار، سّكّغ-د غَارْوم تِيْمُوْتَاوُس بَاش اَذ سّْنغ لْإِيمَان نْوم. ݣّْوْذغ ونِّي يتْغَرَّان تُوْغَا يغَرّ-يكنِّيو س يبْرِيذن نّس أُوْشَا مِين تُوْغَا نخْذم جَارَاوم يمْكن يذْوڒ اَخْمِي وَار نݣِّي وَالُو.<verse eid="1TH 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6" />ڒخُّو يذْوڒ-د غَارْنغ زَّايْوم تِيْمُوْتَاوُس، يُوْوِي-يَانغ-د يجّن ن ڒخْبَار ذ اَصبْحَان خ لْإِيمَان نْوم ذ ڒمْحِبّث نْوم. ينَّا-ٱنغ اَقَا تْخمَّامم ذَايْنغ مْلِيح، ذَايْوم عَاوذ مزْڒِي اَذَانغ ثࢲرم ؤُڒَا ذ نشِّين ذَايْنغ مزْڒِي اَكنِّيو نْࢲر. <verse eid="1TH 3:6" /><verse number="7" style="v" sid="1TH 3:7" />خ مَانَايَا آي أَيثْمَا، نشِّين نتْوَاشجّع س لْإِيمَان نْوم وَاخَّا اَقَانغ ذَانِيتَا ذِي ڒمْحَاين ذ يِج وزيَّار. <verse eid="1TH 3:7" /><verse number="8" style="v" sid="1TH 3:8" />ڒخُّو اَقَا نتْعِيش مْلِيح وَامِي تْبدَّام نِيشَان ذݣ وبْرِيذ ن سِيذِيثْنغ. <verse eid="1TH 3:8" /><verse number="9" style="v" sid="1TH 3:9" />مَامّش إِي غَا نݣّ أَ نْشكَّر أَربِّـي خَاوم؟! مشْحَاڒ ن ڒفْڒَاحث إِي غَارْنغ زَّاث إِ أَربِّـي عْلَاحْسَاب كنِّيو! <verse eid="1TH 3:9" /><verse number="10" style="v" sid="1TH 3:10" />دْجِيڒث ذ نْهَار نْتتَّار-اَس إِ أَربِّـي س وُوْڒَاون نّغ بَاش اَكنِّيو نْࢲر عَاوذ، أَذَاوم نَرْنِي مِين ينقّْصن ذِي لْإِيمَان نْوم.<verse eid="1TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11" />أَذَانغ يرْزم أَربِّـي بَابَاثْنغ اَبْرِيذ غَارْوم نتَّا س يِيخف نّس اَك سِيذِيثْنغ عِيْسَى. <verse eid="1TH 3:11" /><verse number="12" style="v" sid="1TH 3:12" />أَذ يَرْنِي سِيذِيثْنغ ڒمْحِبّث نْوم اَك وَايَاوْيَا اَت يسْفيّض س وَاطَّاس اَك مَارَّا يوْذَان اَم نشِّين نخْس-يكنِّيو. <verse eid="1TH 3:12" /><verse number="13" style="v" sid="1TH 3:13" />أَذَاوم يسجْهذ ؤُڒَاون نْوم بَاش اَذ تِيڒِيم بْڒَا ڒْعِيب اَذ تِيڒِيم مُقدّْسِين زَّاث إِ أَربِّـي بَابَاثْنغ خْمِي د غَا يَاس سِيذِيثْنغ عِيْسَى اَك مَارَّا صَّالِحِين نّس.<verse eid="1TH 3:13" /></para>
  <chapter eid="1TH 3" />
  <chapter number="4" style="c" sid="1TH 4" />
  <para style="s">ئِجّن ن ثُوْذَارْث إِي خف غَا يَارْضَا سِيذِي أَربِّـي</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1" />فَا آي أَيثْمَا عْلَاحْسَاب ثِمسْڒَايِين نّغْنِي، كنِّيو قَا ثْقبْڒم زَّايْنغ مَامش إِي غَا ثْعِيشم بَاش اَخَاوم يَارْضَا أَربِّـي؛ أَمنِّي عَاوذ إِي تْعِيشم. ڒخُّو ذِي عِيْسَى لْمَسِيح نتْحشَّام-يكنِّيو نتْوصَّا-كنِّيو بَاش اَذ تݣّم عَاذ كْتَار.<verse eid="1TH 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 4:2" />شُوْف، ثسّْنم ثِمسْڒَايِين نِّي إِي زِي كنِّيو نْوصَّا س سُّلْطَا ن عِيْسَى لْمَسِيح. <verse eid="1TH 4:2" /><verse number="3" style="v" sid="1TH 4:3" />أَقَا ڒْخَاضَر ن أَربِّـي يتْخصَّا-كنِّيو اَذ تِيڒِيم ثصْفَام اَذ تْبعّْذم زِي لْفَسَاد. <verse eid="1TH 4:3" /><verse number="4" style="v" sid="1TH 4:4" />ئِتْخصَّا اَذ تسّْنم مَامش غَا ثْحكْمم خ دَّات نْوم عْلَاحْسَاب مِين يدْجَان مُقدّس ذَايس اَوقَّار. <verse eid="1TH 4:4" /><verse number="5" style="v" sid="1TH 4:5" />مَاشِي اَذ تْعِيشم ذِي شّهْوث ن دَّات نْوم مَامّش تݣّن ڒݣْنُوْس وَار يسِّينن شَا أَربِّـي. <verse eid="1TH 4:5" /><verse number="6" style="v" sid="1TH 4:6" />عْلَاحْسَاب مَانَايَا يتْخصَّا لَابُد ؤُڒَا ذ يجّن وَار يضدْجم ؤُمَاس وَار ث يتْغشِّي شَا لِأَنَّا ذ سِيذِيثْنغ إِݣ يتْخدْجَاسن خ مَارَّا ثِمسْڒَايِين-أَ مَامّش ذَاوم ث ننَّا قْبڒ نعْڒم-اَوم خَاس. <verse eid="1TH 4:6" /><verse number="7" style="v" sid="1TH 4:7" />مِينْزِي أَربِّـي وَار ذَانغ د يڒَاغِي شَا بَاش أَ نْعِيش ذِي مِين يخنْزن؛ لَّا، ئِڒَاغَا-يَانغ-د أَ نْعِيش ذِي مِين يصْفَان. <verse eid="1TH 4:7" /><verse number="8" style="v" sid="1TH 4:8" />فَلِيهَذَا ونِّي يتَاݣِين اَذ يذْفَار ڒُوْصِيّث-أَ ثَانِيتَان اَتَاف مَاشِي يتَاݣِي إِ بْنَاذم، ئِتَاݣِي إِ أَربِّـي ونِّي إِي ذَاوم د يتِيشّن أَرُّوْح نّس يقدّْسن.<verse eid="1TH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9" />ڒخُّو عْلَاحْسَاب ڒمْحِبّث جَارَاوم وَار نْتحْذِيجِي شَا عَاذ اَذَاوم نَارِي، مَايمِّي؟ مِينْزِي يسڒْمذ-يكنِّيو أَربِّـي س يِيخف نّس اَذ تخْسم اَيَاوْيَا. <verse eid="1TH 4:9" /><verse number="10" style="v" sid="1TH 4:10" />وَاه، ذ صَّح تخْسم مَارَّا أَيثْمَاثْوم إِي كِذْوم يتْعِيشن ذِي لْإِقْلِيم ن مَاسِدُوْنْيَا. وَلَكِن نتْوصَّا-كنِّيو آي أَيثْمَا اَذ تَرْنِيم عَاذ كْتَار. <verse eid="1TH 4:10" /><verse number="11" style="v" sid="1TH 4:11" />نتْوصَّا عَاوذ اَذ تْحَوْڒم بَاش اَذ تْعِيشم ذِي ڒْهُدْنث، أَذ تَاذْفم ذِي شّْغُوْڒَاث نْوم وَاهَا، أَذ تْخذْمم س يفَاسّن نْوم. أَمنِّي إِي كنِّيو نتْوصَّا قْبڒ. <verse eid="1TH 4:11" /><verse number="12" style="v" sid="1TH 4:12" />حمَا اَذ تُوْيُوْرم س لْمَعْقُوْل اَك يِنِّي غَار بَارَّا نْوم <char style="it">وَار يُوْمِينن شَا</char>، وَار تحْذِيجِيم وَالُو زِي حَدّ.<verse eid="1TH 4:12" /></para>
  <para style="s">عْلَاحْسَاب ڒْمُوْمِنِين إِي يمُّوْثن</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13" />فَا آي أَيثْمَا، وَار نخْس شَا اَذ تْقفْڒم إِ يِيخف نْوم عْلَاحْسَاب يِنِّي يطّْصن <char style="it">ذݣ يمضْڒَان</char> بَاش وَار تْخيِّيقم شَا اَم يِنِّي نّغْنِي وَار ذِي يدْجِي بُو لْأَمَال. <verse eid="1TH 4:13" /><verse number="14" style="v" sid="1TH 4:14" />شُوْف، نشِّين نْتَامن بلِّي عِيْسَى يمُّوْث يكَّر-د، نْتَامن عَاوذ بلِّي أَربِّـي عَاذ اَذ ييْسِي يِنِّي يطّْصن <char style="it">ذݣ يمضْڒَان</char> إِي يُوْمْنن <char style="it">زِي لْمَسِيح</char> اَذ يڒِين اَك عِيْسَى. <verse eid="1TH 4:14" /><verse number="15" style="v" sid="1TH 4:15" />عْلَاحْسَاب اَوَاڒ ن سِيذِيثْنغ نقَّار-اَوم قَا نشِّين يعْنِي يِنِّي عَاذ يدَّرن يعْنِي يِنِّي عَاذ يقِّيمن <char style="it">ذِي دُّنشْت-أَ</char> خْمِي د غَا يَاس سِيذِيثْنغ قَا نشِّين وَار نتْݣَعِّيذ شَا ذ يمزْوُوْرَا خ يِنِّي يطّْصن <char style="it">ذݣ يمضْڒَان</char>. <verse eid="1TH 4:15" /><verse number="16" style="v" sid="1TH 4:16" />لِأَنَّا سِيذِيثْنغ اَقَا اَذ د يهْوَا س يِيخف نّس زݣ وجنَّا س يِجّن ن ثْغُوْيّث ثمْغَر ذ يِجّن ن ثْمِيجَّا ن لْمَلَاك نِّي اَمقّْرَان ذ زَّامَّار نِّي يتْصُوْضن ن أَربِّـي، ڒخْدّنِّي يمتِّينن تُوْغَا يُوْمْنن زِي لْمَسِيح اَذ د كَّرن ذ يمزْوُوْرَا. <verse eid="1TH 4:16" /><verse number="17" style="v" sid="1TH 4:17" />سّنِّي نشِّين يعْنِي يِنِّي عَاذ يدَّرن يعْنِي ينِّي عَاذ اَقَانغ <char style="it">ذِي دُّنشْت-أَ</char> اَتَاف اَكِذْسن نتْوَارْفع غَار وجنَّا ذݣ يسيْنُوْثن<note caller="+" style="f"><char style="fr" closed="false">4‏.17 </char><char style="ft" closed="false">ئِسيْنُوثن نِثْنِي ذ يسݣْنُوثن.</char></note> بَاش أَ نْمڒْقَا اَك سِيذِيثْنغ ذِي لْهَوَا. وَا ٱمنِّي اَكِذس نِيڒِي إِ ڒبْدَا. <verse eid="1TH 4:17" /><verse number="18" style="v" sid="1TH 4:18" />إِذن، شجّْعث اَيَاوْيَا س وَاوَاڒن-أَ.<verse eid="1TH 4:18" /></para>
  <chapter eid="1TH 4" />
  <chapter number="5" style="c" sid="1TH 5" />
  <para style="s">يُوْم نِّي ن سِيذِيثْنغ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1" />فَا آي أَيثْمَا، وَار نْتحْذِيجِي شَا اَذَاوم نْتَارِي خ لْأَوْقَات نِغ ذ تَّوَارِيخ. <verse eid="1TH 5:1" /><verse number="2" style="v" sid="1TH 5:2" />أَقَا ثسّْنم مْلِيح بلِّي يُوْم ن سِيذِيثْنغ اَذ د يَاس اَم د يُوْسَا يج وشفَّار س دْجِيڒث. <verse eid="1TH 5:2" /><verse number="3" style="v" sid="1TH 5:3" />أَتَاف خْمِي غَا يِنِين يِوْذَان اَقَا ذِنِّي لْأَمَان ذ ضّْمَان ڒخْدّنِّي اَخَاسن د يهْوَا يجّن ن لْخَرَاب ذغْيَا اَمشْنَاو مَامش د يتَاس ڒحْڒِيق ن ثَارْوَا إِ ثمْغَارْث يتَارْون. أَتَاف وَار زمَّرن نِثْنِي اَذ اَروْڒن.<verse eid="1TH 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 5:4" />وَلَكِن كنِّيو آي أَيثْمَا، وَار ثدْجِيم شَا ذِي ثَادْجسْت بَاش يُوْم نِّي اَخَاوم د يخْضڒ اَم يِج وشفَّار. <verse eid="1TH 5:4" /><verse number="5" style="v" sid="1TH 5:5" />لَّا، كنِّيو مَارَّا ذ ثَارْوَا ن ثْفَاوْث ذ يحنْجِيرن ن نْهَار. وَار ندْجِي شَا ذ ثَارْوَا ن دْجِيڒث نِغ ن ثَادْجسْت. <verse eid="1TH 5:5" /><verse number="6" style="v" sid="1TH 5:6" />إِذن، وَار نْتطّص شَا اَم يِوْذَان نّغْنِي، ئِتْخصَّا أَ نِيڒِي نْفَاق اَغَارْنغ يِيڒِي ڒَعْقڒ. <verse eid="1TH 5:6" /><verse number="7" style="v" sid="1TH 5:7" />شُوْف، يِنِّي يتطّْصن، تطّْصن س دْجِيڒث. يِنِّي يتْغلَّان س شّْرب، تْغلَّان س دْجِيڒث. <verse eid="1TH 5:7" /><verse number="8" style="v" sid="1TH 5:8" />نشِّين لَّا، نشِّين ذ ثَارْوَا ن نْهَار، أَغَارْنغ يِيڒِي ڒَعْقڒ. أَ نݣّ ثْجِيلِيت نِّي ن ڒحْذِيذ يدْجَان نتَّاث ن لْإِيمَان ذ ڒمْحِبّث. أَ نݣّ لْكَاسْك نّغ يدْجَان نتَّا ذ لْأَمَال ن ؤُفكِّي. <verse eid="1TH 5:8" /><verse number="9" style="v" sid="1TH 5:9" />قَا وَار ذَانغ يخْضَر شَا أَربِّـي بَاش اَخَانغ يكّ وغْضَب؛ لَّا، قَا يخْضَر-اَنغ بَاش أَ ننْجم س وفُوْس ن سِيذِيثْنغ عِيْسَى لْمَسِيح. <verse eid="1TH 5:9" /><verse number="10" style="v" sid="1TH 5:10" />نتَّا يمُّوْث خَانغ بَاش أَ ندَّر اَكِذس وَاخَّا نشِّين نْفَاق نِغ نطّص <char style="it">ذݣ ونْضڒ</char>. <verse eid="1TH 5:10" /><verse number="11" style="v" sid="1TH 5:11" />فَلِيهَذَا تْشجَّاعث اَيَاوْيَا تْعَاوَانث اَيَاوْيَا مَامّش تݣّم ڒخُّو.<verse eid="1TH 5:11" /></para>
  <para style="s">ڒُوْصِيَاث ثِنݣُّوْرَا</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12" />فَا آي أَيثْمَا، نقَّار-اَوم وقَّرم يِنِّي يخدّْمن جَارَاوم إِݣ يدْجَان خَاوم نهَّان-كنِّيو. <verse eid="1TH 5:12" /><verse number="13" style="v" sid="1TH 5:13" />ؤُشم-اَسن يجّن ن لْقِيمَا ثمْغَر س ڒمْحِبّث نْوم عْلَاحْسَاب ڒْخذْمث نْسن. إِڒِيم عَاوذ ذِي ڒهْنَا اَك وَايَاوْيَا. <verse eid="1TH 5:13" /><verse number="14" style="v" sid="1TH 5:14" />آي أَيثْمَا، نْهَاث يِنِّي يتْبَاعن فَرْق-شّْغڒ، شجّْعث يِنِّي يتفْشِيڒن، عَاوْنث يِنِّي يتضْعِيفن، صبَّارث اَك مَارَّا. <verse eid="1TH 5:14" /><verse number="15" style="v" sid="1TH 5:15" />أَرّم-د ڒْبَاڒ نْوم، ئِتْخصَّا ؤُڒَا ذ يجّن وَار يتْخدْجِيس شَّرّْ س شَّرّْ نّغْنِي؛ لَّا، ڒبْدَا رزُّوْث مِين يدْجَان ذ اَصبْحَان جَارَاوم ذ جَار يِوْذَان مَارَّا.<verse eid="1TH 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 5:16" />فَرْحم ڒبْدَا، <verse eid="1TH 5:16" /><verse number="17" style="v" sid="1TH 5:17" />تتَّارم إِ أَربِّـي بْڒَا مَا ٱذ تْبدّم، <verse eid="1TH 5:17" /><verse number="18" style="v" sid="1TH 5:18" />شكَّرم-ث ذِي مَارَّا ثِمسْڒَايِين. لِأَنَّا ذ مَانَايَا إِݣ يتْرَاجَا أَربِّـي زَّايْوم ذِي عِيْسَى لْمَسِيح. <verse eid="1TH 5:18" /><verse number="19" style="v" sid="1TH 5:19" />وَار تْسخْسَايم شَا أَرُّوْح يقدّْسن. <verse eid="1TH 5:19" /><verse number="20" style="v" sid="1TH 5:20" />وَار تْسحْقَارم شَا اَوَاڒن نِّي إِي عڒْمن يِوْذَان زِي أَربِّـي قَّارن-ثن. <verse eid="1TH 5:20" /><verse number="21" style="v" sid="1TH 5:21" />لَّا، ميّْزث مَانَاينِّي مَارَّا. طّْفث ذِي مِين يدْجَان ذ اَصبْحَان؛ <verse eid="1TH 5:21" /><verse number="22" style="v" sid="1TH 5:22" />أَݣّْوْجث خ مَارَّا مِين يدْجَان ذ اَعفَّان.<verse eid="1TH 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23" />أَربِّـي نّغ ن ڒهْنَا اَكنِّيو يسِّيصْفَا ذݣ يِيخف نْوم قَاع. بُوْحْبڒ نْوم ذ ڒَعْمَر نْوم ذ دَّات نْوم اَذ قِّيمن كمْڒن بْڒَا ڒْعِيب اَڒ د غَا يَاس سِيذِيثْنغ عِيْسَى لْمَسِيح. <verse eid="1TH 5:23" /><verse number="24" style="v" sid="1TH 5:24" />ونِّي إِي ذَاوم د يتْڒَاغَان ذَايس تِّقث، ذ نتَّا إِي كنِّيو غَا يسِّيوْضن غَار مَانَايَا.<verse eid="1TH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25" />آي أَيثْمَا، تَّارم إِ أَربِّـي خَانغ. <verse eid="1TH 5:25" /><verse number="26" style="v" sid="1TH 5:26" />سدْجْمث خ مَارَّا اَوْمَاثن س يِجّن ن سْڒَام يصْفَا. <verse eid="1TH 5:26" /><verse number="27" style="v" sid="1TH 5:27" />تْوصِّيغ-كنِّيو زَّاث إِ سِيذِيثْنغ حمَا اَذ تْغَرم ثَبْرَات-أَ إِ وَاوْمَاثن مَارَّا. <verse eid="1TH 5:27" /><verse number="28" style="v" sid="1TH 5:28" />أَكِذْوم يِيڒِي اَرْضَا ن سِيذِيثْنغ عِيْسَى لْمَسِيح.<verse eid="1TH 5:28" /></para>
  <chapter eid="1TH 5" />
</usx>