<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="COL" style="id">- TarifitABS</book>
  <para style="h">أَيث-كولوس</para>
  <para style="toc3">كول</para>
  <para style="toc2">أيث-كولوس</para>
  <para style="toc1">ثَبْرَات ن اَرَّسُوْل بُوْلُس غَار أَيث-كُوْلُوْس</para>
  <para style="mt1">ثَبْرَات ن اَرَّسُوْل بُوْلُس غَار أَيث-كُوْلُوْس</para>
  <chapter number="1" style="c" sid="COL 1" />
  <para style="s">لْمُقَدِّمَا</para>
  <para style="p">
    <verse number="1" style="v" sid="COL 1:1" />نش ذ بُوْلُس ذ اَرَّسُوْل ن عِيْسَى لْمَسِيح س ڒْخَاضَر ن أَربِّـي، أَكِذِي ؤُمَاثْنغ تِيْمُوْتَاوُس. <verse eid="COL 1:1" /><verse number="2" style="v" sid="COL 1:2" /><char style="it">تَارِيغ ثَبْرَات-أَ</char> إِ وَاوْمَاثن إِي ذِي يدْجَا لْإِيمَان يدْجَان ذ صَّالِحِين ذِي ثنْدِينْت ن كُوْلُوْس. أَكِذْوم يِيڒِي اَرْضَا ذ ڒهْنَا زِي أَربِّـي بَابَاثْنغ.<verse eid="COL 1:2" /></para>
  <para style="s">شُّكر ذ ثْࢲَادْجِيث ن اَرَّسُوْل بُوْلُس خ ڒْمُوْمِنِين</para>
  <para style="p">
    <verse number="3" style="v" sid="COL 1:3" />نشِّين ڒبْدَا نتْشكَّار أَربِّـي بَابَاس ن سِيذِيثْنغ عِيْسَى لْمَسِيح خْمِي ذَاس نْتتَّار خَاوم. <verse eid="COL 1:3" /><verse number="4" style="v" sid="COL 1:4" />لِأَنَّا نتسْڒَا خَاوم خ لْإِيمَان نْوم إِي ذَايْوم خ عِيْسَى لْمَسِيح ذ ڒمْحِبّث نْوم إِي تݣّم إِ صَّالِحِين مَارَّا. <verse eid="COL 1:4" /><verse number="5‏-6" style="v" sid="COL 1:5-6" />لْإِيمَان-أَ ذ ڒمْحِبّث-أَ تَاسن-د زِي لْأَمَال نِّي يتْوَاخمّْڒن إِ كنِّيو ذݣ وجنَّا. تُوْغَا ثسْڒِيم خَاس ذݣ وَاوَاڒ ن ڒْحَقّ يعْنِي ذِي لْإِنْجِيل إِي غَارْوم د يُوْضن. ذِي مَارَّا دُّنشْت-أَ لْإِنْجِيل-أَ يتَارو يتمْغَار، مَامش عَاوذ يخدّم جَارَاوم زݣ وَامِي إِي ذَاس ثسْڒِيم ثْفهّْمم ذ صَّح اَرْضَا ن أَربِّـي. <verse eid="COL 1:5-6" /><verse number="7" style="v" sid="COL 1:7" />أَمنِّي إِي ث ثْڒمْذم زݣ <char style="it">وُوْمَاثْنغ</char> پَافْرَاس نتَّا ذ اَمْسخَّار يعِيزّن ذِي ڒْخذْمث. ئِخدّم نِيشَان إِ لْمَسِيح عْلَاحْسَاب نّغ. <verse eid="COL 1:7" /><verse number="8" style="v" sid="COL 1:8" />ئِعَاوذ-ٱنغ خَاوم خ ڒمْحِبّث نْوم لْأَصل ن ڒمْحِبّث-أَ ذ أَرُوْح يقدّْسن.<verse eid="COL 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="COL 1:9" />خ مَانَايَا زِي نْهَار نِّي وَامِي تُوْغَا نسْڒَا نشِّين خَاوم، نتْغِيمَا نْتتَّار-اَس إِ أَربِّـي خَاوم بَاش اَذ تْعمَّرم س ثُوْسْنَا<note caller="+" style="f"><char style="fr" closed="false">1‏.9 </char><char style="ft" closed="false">ثُوْسْنَا نتَّاث ذ لْمَعْرِفَا.</char></note> خ ڒْخَاضَر ن أَربِّـي س مَارَّا ڒْعَقڒ ذ ڒفْهَامث إِݣ يتِيشّن أَرُّوْح يقدّْسن. <verse eid="COL 1:9" /><verse number="10" style="v" sid="COL 1:10" />حمَا اَذ تُوْيُوْرم خ يِجّن ن وبْرِيذ إِي ذَاس يتِيشّن إِ سِيذِيثْنغ لْقِيمَا إِي ذَاس يتعْجِيبن مَارَّا. خ وبْرِيذ-أَ اَذ تَارْوم مَارَّا ڒخْذَايم ثِصبْحَانِين اَذ تْمَارْنِيم ذِي ثُوْسْنَا نْوم خ أَربِّـي. <verse eid="COL 1:10" /><verse number="11" style="v" sid="COL 1:11" /><char style="it">نْتتَّار إِ أَربِّـي</char> اَذ تْجهْذم ذِي مَارَّا ثِزمَّار نْوم عْلَاحْسَاب لْقُوَّا نّس يدْجَان عَظِيمَا بَاش اَذ تْبدّم اَذ تصْبَارم مْلِيح س ڒفْرَاحث، <verse eid="COL 1:11" /><verse number="12" style="v" sid="COL 1:12" />بَاش اَذ تْشكَّرم بَابَاثْنغ ونِّي إِي ذَاوم يُوْشِين ڒْحَقّ اَذ تْشَرْشم ذِي لْوَرث ن صَّالِحِين ذِي نُّوْر. <verse eid="COL 1:12" /><verse number="13" style="v" sid="COL 1:13" />ئِسفْڒث-اَنغ زِي ڒحْكَام ن ثَادْجسْت يسِّيوض-اَنغ غَار ڒْمُلْك ن مِّيس يعِيزّن. <verse eid="COL 1:13" /><verse number="14" style="v" sid="COL 1:14" />زَّايس نتَّا يسنْجم-اَنغ يعْنِي يغْفَر-اَنغ ڒْمُعْصِيَاث نّغ.<verse eid="COL 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="COL 1:15" />مِّيس نتَّا ذ صِّفث ن أَربِّـي ونِّي وَار نْزمَّر شَا نشِّين اَث نْࢲر. نتَّا ذ اَمنْزُو<note caller="+" style="f"><char style="fr" closed="false">1‏.15 </char><char style="ft" closed="false">أَمنْزُو نتَّا ذ يفْخدِّي، قَّارن-ث إِ وحنْجِير إِي د يخڒْقن ذ اَمزْوَارُو.</char></note> يحكّم خ قَاع مِين د يتْوَاخڒْقن. <verse eid="COL 1:15" /><verse number="16" style="v" sid="COL 1:16" />زَّايس نتَّا إِي زِي د تْوَاخڒْقنْت قَاع ثِمسْڒَايِين إِݣ يدْجَان ذݣ وجنَّا نِغ ذِي ثْمُوْرْث. وَاخَّا تْبَاننْت-يد نِغ وَار د تْبِيننْت شَا. نِغ ذ لْعَرْشَاث نِغ ذ لْممْلَاكَاث نِغ ذ يِنِّي يحكّْمن نِغ ذ يِنِّي يجهْذن. قَاع ثِمسْڒَايِين-أَ زَّايس إِي د تْوَاخڒْقنْت، تْوَاخڒْقنْت-اَس-د إِ نتَّا. <verse eid="COL 1:16" /><verse number="17" style="v" sid="COL 1:17" />ذ نتَّا إِݣ يدْجَان قْبڒ خ ثْمسْڒَايِين قَاع أُو خ دْسَاس نّس إِي تْمُوْننْت قَاع ثِمسْڒَايِين. <verse eid="COL 1:17" /><verse number="18" style="v" sid="COL 1:18" />ذ نتَّا إِي يدْجَان ذ اَزدْجِيف ن دَّات يعْنِي ن جْمَاعث ن ڒْمُوْمِنِين. ذ نتَّا إِݣ يدْجَان ذ اَمزْوَارُو، ذ نتَّا إِݣ يدْجَان ذ اَمنْزُو زݣ يمتِّينن<note caller="+" style="f"><char style="fr" closed="false">1‏.18 </char><char style="ft" closed="false">سِيذِيثْنغ عِيْسَى نتَّا يقَاق-د ذ اَمزْوَارُو زِي مَارَّا يِنِّي إِي د غَا يفَاقن زݣ يمتِّينن وَار ذوِّيڒن شَا اَذ مّْثن اَغَارْسن ثِيڒِي دَّات ذ جْذِيذ ن لْعَظَمَا. خْزَر ثَبْرَات ثَمزْوَارُوْت غَار أَيث-كُوْرِينْث، ؤُذم وِيس 15، لْأَيَاث 35‏-57.</char></note> بَاش ذ نتَّا إِي غَا يِيڒِين ذ اَمزْوَارُو ذِي ثِمسْڒَايِين قَاع. <verse eid="COL 1:18" /><verse number="19" style="v" sid="COL 1:19" />لِأَنَّا يعْجب-اَس إِ أَربِّـي اَذَايس يسزْذغ ذِي مِّيس قَاع مِين غَارس. <verse eid="COL 1:19" /><verse number="20" style="v" sid="COL 1:20" />ثُمَّا يسمْصْڒَاح أَربِّـي قَاع ثِمسْڒَايِين إِ يِيخف نّس إِݣ يدْجَان ذِي ثْمُوْرْث نِغ ذݣ وجنَّا يعْنِي يݣَّا ڒهْنَا س يذَامّن<note caller="+" style="f"><char style="fr" closed="false">1‏.20 </char><char style="ft" closed="false">ئِذَامّن نتَّا ذ دّم.</char></note> ن مِّيس إِي يُوْزّْڒن خ صَّلِيب.<verse eid="COL 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 1:21" />كنِّيو تُوْغَا قْبڒ تِݣّْوْجم خ أَربِّـي تْمنْغَام اَكِذس س ڒَعْقُوْڒَاث نْوم تݣّم ثِمسْڒَايِين ذ ثِعفَّانِين. <verse eid="COL 1:21" /><verse number="22" style="v" sid="COL 1:22" />وَلَكِن ڒخُّو لَّا، أَربِّـي يسمْصْڒَاح-يكنِّيو اَكِذس س دَّات ن لْمَسِيح يعْنِي س ڒْموْث نّس بَاش اَكنِّيو يقدّم زَّاثس ثصْفَام بْڒَا ڒْعِيب وَار ذِنِّي بُو وِي كنِّيو إِي غَا يتَاهَامن. <verse eid="COL 1:22" /><verse number="23" style="v" sid="COL 1:23" />وَلَكِن لَابُد اَذ تقِّيمم ذِي لْإِيمَان نْوم نِيشَان اَذ تْبدّم خ دْسَاس، وَار ثْسمّْحم شَا ذِي لْأَمَال ن لْإِنْجِيل تُوْغَا إِي تسْڒِيم. لْإِنْجِيل-أَ تْوَابشَّرنْت زَّايس قَاع ثِمسْڒَايِين يتْوَاخڒْقن سْوَادَّاي وجنَّا، أُو نش بُوْلُس ذوْڒغ ذ اَخدَّام نّس.<verse eid="COL 1:23" /></para>
  <para style="s">ڒْخذْمث ن اَرَّسُوْل بُوْلُس ذِي جْمَاعث ن ڒْمُوْمِنِين</para>
  <para style="p">
    <verse number="24" style="v" sid="COL 1:24" />ڒخُّو نش فَرّْحغ خ مِينْخف تْعدَّابغ عْلَاحْسَاب كنِّيو. لِأَنَّا ذِي دَّات-أَ ينُو كسِّيغ ڒْحَقّ ينُو زِي مِين عَاذ ينقّْصن زݣ وعدّب نِّي ن لْمَسِيح عْلَاحْسَاب دَّات نّس يعْنِي جْمَاعث ن ڒْمُوْمِنِين.<note caller="+" style="f"><char style="fr" closed="false">1‏.24 </char><char style="ft" closed="false">ڒْمَعْنَا ن لْجُمْلَا-يَا يقْسح شْوَايْت بَاش اَت نفْهم وَلَكِن ثسَّاوَاڒ خ وعدّب ن ڒْمُوْمِنِين. نشِّين اَغَارْنغ يِيڒِي شَان ن وعدّب اَم ونِّي إِي خَاس يكِّين خ لْمَسِيح. أَرَّسُوْل بُوْلُس مَثَالَان يكَّا خَاس اَطَّاس ن وعدّب ذِي ڒحْبس. وَلَكِن نتَّا مِين مَا يكِّين خَاس يݣِّي-ث س ڒفْرَاحث.</char></note> <verse eid="COL 1:24" /><verse number="25" style="v" sid="COL 1:25" />جْمَاعث-أَ ذوْڒغ غَارس نش ذ يجّن ن وخدَّام نّس عْلَاحْسَاب لْوَاجِب نِّي زِي أَربِّـي إِي ذَايِي د يمُّوْشن بَاش اَكنِّيو بشَّرغ س وَاوَاڒ يكْمَاڒ ن أَربِّـي. <verse eid="COL 1:25" /><verse number="26" style="v" sid="COL 1:26" />أَوَاڒ-أَ نتَّا ذ ڒْمَعْنَا نِّي إِي تُوْغَا ينُوْفَّرن ذِي زْمَانَاث ذ لْجِلَاث يعْذُوْن، ڒخُّو اَرِّين-د خَاس ڒخْبَار صَّالِحِين. <verse eid="COL 1:26" /><verse number="27" style="v" sid="COL 1:27" />نِثْنِي يخْضَر-يثن أَربِّـي بَاش اَذ خبَّارن إِ يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل اَذَاسن ينِين مشْحَاڒ يمْغَر ڒْخِير-أَ لْعَظِيم ن ڒْمَعْنَا ينُوْفَّرن وَانِيتَا. مِين يعْنَى ڒْمَعْنَا-يَا؟ لْمَسِيح نتَّا يدْجَا ذَايْوم، ذ لْأَمَال ن لْعَظَمَا.<verse eid="COL 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="COL 1:28" />لْمَسِيح-أَ نتْبشَّار زَّايس إِ يِوْذَان، نْنهَّا-ثن مَارَّا إِذْسن، نْسڒْمَاذ-يثن س مَارَّا ڒفْهَامث بَاش أَ نْقدّم يوْذَان مَارَّا ذِي لْمَسِيح بْڒَا شَا ن ڒْعِيب <char style="it">إِ أَربِّـي</char>. <verse eid="COL 1:28" /><verse number="29" style="v" sid="COL 1:29" />خ مَانَايَا نش خدّْمغ، تَاحْڒغ ذِي ڒْخذْمث-أَ س مَارَّا جّْهذ نِّي ن لْمَسِيح نتَّا يسْخدَّام-اَيِي س ثْزمَّار نّس.<verse eid="COL 1:29" /></para>
  <chapter eid="COL 1" />
  <chapter number="2" style="c" sid="COL 2" />
  <para style="p">
    <verse number="1" style="v" sid="COL 2:1" />شُوْف، خْسغ اَذ تسّْنم مشْحَاڒ تَاحْڒغ <char style="it">ذِي ڒْخذْمث-أَ</char> عْلَاحْسَاب كنِّيو ذ يِنِّي يدْجَان ذِي ثنْذِينْت ن لَاوْدُكْيَا ذ مَارَّا يِنِّي عمَّارْص مَا ࢲْرِين اَغمْبُوْب ينُو. <verse eid="COL 2:1" /><verse number="2" style="v" sid="COL 2:2" />رزُّوْغ ؤُڒَاون نْوم اَذ تْوَاشجّْعن خْمِي غَا مُوْنن اَك وَايَاوْيَا س ڒمْحِبّث بَاش اَذ تَاوْضم غَار مَارَّا ڒْخِير نِّي إِݣ يدْجَان ذݣ يِجّن ن ڒفْهَامث ثكْمَاڒ ذ يِجّن ن ثُوْسْنَا خ ڒْمَعْنَا ينُوْفَّرن ن أَربِّـي يدْجَان ذِي لْمَسِيح. <verse eid="COL 2:2" /><verse number="3" style="v" sid="COL 2:3" />ذَايس ذِي نتَّا إِي تْوَاسْنُوْفَّرن مَارَّا ڒْكُنُوْز ن ڒفْهَامث ذ مَارَّا ڒْكُنُوْز ن ثُوْسْنَا.<note caller="+" style="f"><char style="fr" closed="false">2‏.3 </char><char style="ft" closed="false">ثُوْسْنَا نتَّاث ذ لْمَعْرِيفَا.</char></note> <verse eid="COL 2:3" /><verse number="4" style="v" sid="COL 2:4" />قَّارغ-اَوم مَانَايَا بَاش وَار د يتِيس حَدّ اَكنِّيو يشْمث س وَاوَاڒ نّس اَذَاوم يسْنعْمِيڒ ذ صَّح. <verse eid="COL 2:4" /><verse number="5" style="v" sid="COL 2:5" />نش وَاخَّا وَار دْجِيغ شَا اَكِذْوم س دَّات ينُو اَقَايِي اَكِذْوم س أَرُّوْح ينُو، فَرّْحغ نش خْمِي تْوَاڒِيغ لْعِبَادَا نْوم نِيشَان تݣّم-ت ثَا س ثَا أُو مشْحَاڒ إِي تْبدَّام ذِي لْإِيمَان نْوم ذِي لْمَسِيح.<verse eid="COL 2:5" /></para>
  <para style="s">لْحُرِّيَا إِي غَارْنغ ذِي ثُوْذَارْث نّغ اَك لْمَسِيح</para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6" />إِذن، مَامّش ثْقبْڒم عِيْسَى لْمَسِيح اَمنِّي إِي غَا ثْعِيشم. <verse eid="COL 2:6" /><verse number="7" style="v" sid="COL 2:7" />ئِتْخصَّا-كنِّيو اَذ تِيڒِيم ثبْنَام خ دْسَاس نّس مْلِيح، أَذ تِيڒِيم ثْجهْذم ذِي لْإِيمَان نْوم مَامّش إِي كنِّيو سڒْمَاذن، أَذ تِيڒِيم تنْفيَّاضم س شُّكر.<verse eid="COL 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 2:8" />أَرّم-د ڒْبَاڒ نْوم ؤُڒَا ذ يجّن مَا يزمَّر اَكنِّيو يسْخَرْوض س لْفلْسَفَا نِغ س وغدَّاڒ نِّي يخْوَان عْلَاحْسَاب تَّقَالِيد ن بْنَاذم نِغ عْلَاحْسَاب لْقَوَانِين يقْذِيمن ن دُّنشْت-أَ قَا مَاشِي عْلَاحْسَاب لْمَسِيح.<verse eid="COL 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="COL 2:9" />لِأَنَّا لْمَسِيح مَارَّا مِين يدْجَان ن أَربِّـي يزْذغ ذِي دَّات نّس. <verse eid="COL 2:9" /><verse number="10" style="v" sid="COL 2:10" />كنِّيو ثُوْذَارْث نْوم ثكْمَاڒ اَك لْمَسِيح يدْجَان نتَّا ذ اَزدْجِيف يتْرَايَّان خ مَارَّا يِنِّي يحكّْمن ذ يِنِّي يجهْذن. <verse eid="COL 2:10" /><verse number="11" style="v" sid="COL 2:11" />ذَايس ذِي نتَّا عَاوذ إِي ذِي ثْطهَّارم وَلَكِن مَاشِي ذ يجّن ن طَّهَارث يݣِّين س يفَاسّن ن بْنَاذم؛ لَّا، ثْطهَّارم طَّبِيعَا نْوم ثَعفَّانْت قَاع س يِجّن ن طَّهَارث يݣِّي-ت لْمَسِيح.<note caller="+" style="f"><char style="fr" closed="false">2‏.11 </char><char style="ft" closed="false">أَرَّسُوْل بُوْلُس يسَّاوَاڒ ذَانِيتَا خ يِجّن ن طَّهَارث غَار ذَاخڒ نّغ يعْنِي ذِي اَرُّوْح نّغ مَاشِي ذ يجّن ن طَّهَارث عَادِي إِي تݣّن يرْيَازن ذِي دَّات.</char></note> <verse eid="COL 2:11" /><verse number="12" style="v" sid="COL 2:12" />يعْنِي ثنْضْڒم اَكِذس س طَّهَارث نْوم ذݣ وَامَان، أُو عَاوذ س طَّهَارث نْوم ذݣ وَامَان ثكَّارم-د اَكِذس زِي ڒْموْث س لْإِيمَان نْوم ذِي ثْزمَّار ن أَربِّـي ونِّي د يسكَّرن عِيْسَى زِي ڒْموْث.<verse eid="COL 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="COL 2:13" />فَا كنِّيو تُوْغَا ثمُّوْثم <char style="it">س وُوْڒَاون نْوم</char> عْلَاحْسَاب ڒْمُعْصِيَاث ذ طَّبِيعَا نْوم وَار يطهَّارن شَا، وَلَكِن أَربِّـي يسدَّر-د كنِّيو اَك لْمَسِيح وَامِي ذَانغ يغْفَر قَاع ڒْمُعْصِيَاث نّغ. <verse eid="COL 2:13" /><verse number="14" style="v" sid="COL 2:14" />ئِمْحَا اَمَارْوَاس نِّي إِݣ يزمّْمن خَانغ اَقَاث ضد نّغ س لْقَانُوْن. مَانَاينِّي ييْسِي-ث يصمَّر-يث خ صَّلِيب. <verse eid="COL 2:14" /><verse number="15" style="v" sid="COL 2:15" />أَربِّـي يكّس ثِزمَّار نِّي ن يِنِّي يحكّْمن ذ يِنِّي يجهْذن يَارِّي-ثن اَخَاسن فُوْرّْجن يِوْذَان يفْضح-يثن يرْبح-يثن خ صَّلِيب.<verse eid="COL 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 2:16" />إِذن وَار تجَّام حَدّ اَكنِّيو يعيّب خ مِين تتّم نِغ خ مِين ثْسسّم نِغ خ شَا ن ڒعْيُوْذَاث إِي تِيڒِين كُڒ عَام نِغ كُڒ شْهَار نِغ خ نْهَار ن سّبْث ن لْعِبَادَا. <verse eid="COL 2:16" /><verse number="17" style="v" sid="COL 2:17" />مَارَّا ثِمسْڒَايِين-أَ نِثنْتِي اَم ثِيڒِي وَاهَا ن ثْمسْڒَايِين نِّي إِي د غَا يَاسن، ثِمسْڒَايِين نِّي ن صَّح ن لْمَسِيح. <verse eid="COL 2:17" /><verse number="18" style="v" sid="COL 2:18" />وَار تجَّام ؤُڒَا ذ يجّن ن بْنَاذم اَكنِّيو يسْبطّڒ خ لْجَائِزَا. نتَّا بْنَاذم نِّي ذ ونِّي إِݣ يسمْغَارن مِين يقسْحن ذِي دِّين، ئِسمْغَار عَاوذ لْعِبَادَا نِّي إِي زِي عبّْذن لْمَلَائِكَاث. ئِسَّاوَاڒ اَطَّاس ثَا س ثَا خ مِين يࢲْرَا زَعْمَا ذِي شَا ن لْوَاحِي نّس. ڒْعَقڒ نّس يُوْفّ يمْغَر س تَّكبُّر. وَار ذِنِّي بُو أَرُّوْح يقدّْسن، ذِنِّي لْأَفْكَار نّس يخْوَان وَاهَا. <verse eid="COL 2:18" /><verse number="19" style="v" sid="COL 2:19" />بْنَاذم نِّي يسخْصَار لْعَلَاقَا اَك ونِّي يتْرَايَّان ذ اَزدْجِيف. أَزدْجِيف نِّي نتَّا يتْدبَّار إِ دَّات نّس اَمن-ثكْمَاڒ وَامِي نتَّاث ثْمُوْن س يپُـوْرْصُوْثن ذ ڒمْفَاسڒ نّس بَاش دَّات اَذ تمْغَر عْلَاحْسَاب مِين يخس أَربِّـي اَذ تمْغَر.<verse eid="COL 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 2:20" />كنِّيو مڒَا ثمُّوْثم اَك لْمَسِيح إِ لْقَوَانِين نِّي يقْذِيمن ن دُّنشْت-أَ، مَايمِّي ذَاس تݣّم اَرَّاي إِ لْقَانُوْن نِّي اَخْمِي عَاذ تْعِيشم زَّايس ذِي دُّنشْت-أَ؟ <verse eid="COL 2:20" /><verse number="21" style="v" sid="COL 2:21" />يعْنِي: "وَار كسِّي شَا س وفُوْس، وَار تْقَاسَا شَا، وَار تْحَاذَا شَا." <verse eid="COL 2:21" /><verse number="22" style="v" sid="COL 2:22" />لْقَاوَنِين-أَ يِيْنَا سَّاوَاڒن خ شَان ثْمسْڒَايِين إِي غَا يفْنَان خْمِي غَا تْوَاشّنْت، نِثْنِي ذ لْقَوَانِين ذ وسڒْمذ ن يِوْذَان وَاهَا. <verse eid="COL 2:22" /><verse number="23" style="v" sid="COL 2:23" />ذ صَّح، تْغِيڒ-اَسن إِ يِوْذَان لْقَوَانِين نِّي اَم ذَايْسن ڒفْهَامث زَعْمَا خ سَّبَاب ن لْوَاجِب ن لْعِبَادَا نْسن ذ دِّين نْسن يقْسح أُو عَاوذ مشْحَاڒ تْزيَّارن خ دَّات ن بْنَاذم. وَلَكِن لْقَوَانِين-أَ وَار تْعِيوِينن ؤُڒَا ذ يجّن ن بْنَاذم بَاش وَار يتْسِيعِّيف شَا شّهَوَاث ن دَّات نّس.<verse eid="COL 2:23" /></para>
  <chapter eid="COL 2" />
  <chapter number="3" style="c" sid="COL 3" />
  <para style="s">لْقَوَانِين ن يِجّن ن ثُوْذَارْث ذ جْذِيذ</para>
  <para style="p">
    <verse number="1" style="v" sid="COL 3:1" />إِذن فَا وَامِي تْوَاسْنكَّارم كنِّيو اَك لْمَسِيح أُو لَابُد اَذ ترْزُوْم س وُوْڒَاون نْوم ثِمسْڒَايِين نِّي يدْجَان ذݣ وجنَّا مَانِي يقِّيم لْمَسِيح غَار وفُوْسِي ن أَربِّـي. <verse eid="COL 3:1" /><verse number="2" style="v" sid="COL 3:2" />رزُّوْث س وُوْڒَاون نْوم ثِمسْڒَايِين نِّي يدْجَان ذݣ وجنَّا، مَاشِي ثِنِّي ذِي ثْمُوْرْث. <verse eid="COL 3:2" /><verse number="3" style="v" sid="COL 3:3" />مِينْزِي زَعْمَا كنِّيو ثمُّوْثم، ثُوْذَارْث نْوم اَقَا ثْنُوْفَّر اَك لْمَسِيح ذِي أَربِّـي. <verse eid="COL 3:3" /><verse number="4" style="v" sid="COL 3:4" />خْمِي د غَا يمظْهَار لْمَسِيح يعْنِي ونِّي يدْجَان ذ ثُوْذَارْث نْوم، ڒخْدّنِّي اَكِذس تْمظْهَارم ؤُڒَا ذ كنِّيو ذِي لْعَظَمَا.<verse eid="COL 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="COL 3:5" />خ مَانَايَا نْغث مِين يدْجَان ذَايْوم ذِي طَّبِيعَا نْوم ن دُّنشْت-أَ يعْنِي لْفَسَاد ذ مِين يخنْزن ذ شّهْوث ذ ڒْخَاضَر اَعفَّان ذ طْمَاع إِݣ يدْجَان نتَّا اَم لْعِبَادَا ن لْأَصْنَام. <verse eid="COL 3:5" /><verse number="6" style="v" sid="COL 3:6" />عْلَاحْسَاب ثِمسْڒَايِين-أَ إِي د غَا يَاسن <char style="it">نْهَار ن</char> وغْضَاب ن أَربِّـي. <verse eid="COL 3:6" /><verse number="7" style="v" sid="COL 3:7" />تُوْغَا قْبڒ ثُوْيُوْرم خ يبْرِيذن-أَ ثْعِيشم ذَايْسن. <verse eid="COL 3:7" /><verse number="8" style="v" sid="COL 3:8" />وَلَكِن ڒخُّو ثِمسْڒَايِين نِّي يتْخصَّا اَخَاوم ثنْت ثسْبعّْذم قَاع يعْنِي اَعصَّاب ذ وغْضَاب ذ شَّرّْ ذ ڒْبَاطڒ ذ وَاوَاڒن يعفَّانن إِي ثقَّارم س وقمُّوْم نْوم. <verse eid="COL 3:8" /><verse number="9" style="v" sid="COL 3:9" />وَار سْخرِّيقم شَا خ وَايَاوْيَا ڒَاحقَّاش ثْبدّْڒم طَّبِيعَا نِّي نْوم تُوْغَا غَارْوم قْبڒ ذَايس يخَرْوِيضن وَاهَا. <verse eid="COL 3:9" /><verse number="10" style="v" sid="COL 3:10" />ڒخُّو كنِّيو ثݣِّيم يجّن ن طَّبِيعَا نّغْنِي ذ جْذِيذ عَاذ تْذوَّاڒ-د ذ جْذِيذ، ڒْمَعْرِيفَا نّس اَم صِّفث ن لْخَالِق نّس. <verse eid="COL 3:10" /><verse number="11" style="v" sid="COL 3:11" />وَار يتْغِيمِي بُو ويُوْنَانِي نِغ ذ اَئِسْرَائِيلِي، نِغ ذ ونِّي يطهَّارن نِغ ذ ونِّي وَار يطهِّيرن شَا، نِغ ذ اَبَرْبَرِي نِغ ذ اَوحْشِيو،<note caller="+" style="f"><char style="fr" closed="false">3‏.11 </char><char style="ft" closed="false">حَرْفِيَان اَوَاڒ-أَ اَوحْشِيْو نتَّا ذ اَسْقُوْثِي يعْنِي شَان يِوْذَان ذ يهَمَاجِيْين تُوْغَا زدّْغن غَار شَّمَال ن لْيُوْنَان ذ لْإِيرَان.</char></note> نِغ ذ يسْمغ نِغ ذ ونِّي يدْجَان حُرّ. لَّا، لْمَسِيح نتَّا ذ مَارَّا، أَقَاث ذِي مَارَّا.<verse eid="COL 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 3:12" />إِذن كنِّيو ذ شَّعْب مُقدّس يخْضَر-يكنِّيو أَربِّـي ثْعِيزّم خَاس. لَابُد اَذَايْوم ثِيڒِي لْحَنَانَا ذ ڒْخِير ذ تَّوَاضُع ذ صّْبَر أُو مَارَّا بْڒَا تَّكبُّر. <verse eid="COL 3:12" /><verse number="13" style="v" sid="COL 3:13" />صْبَارث اَك وَايَاوْيَا. مڒَا شَان يِجّن زَّايْوم غَارس شَان لْمُشْكِل إِي زَّايس غَا يشثْشَا خ ونّغْنِي، ئِتْخصَّا يجّن اَذ يسْمح إِ ونّغْنِي. مَامّش ذَاوم يغْفَر أَربِّـي إِ كنِّيو، أَمنِّي إِي غَا ثْسمْحم إِ يِوْذَان. <verse eid="COL 3:13" /><verse number="14" style="v" sid="COL 3:14" />كْتَار مَارَّا زِي ثْمسْڒَايِين-أَ ثِيْنَا يتْخصَّا اَذ تسْخذْمم ڒمْحِبّث جَارَاوم مِينْزِي ڒمْحِبّث-أَ تَاس-د اَم يِجّن ن وسْغُوْن إِݣ يسْمُوْنن مَارَّا ثِمسْڒَايِين-أَ ذݣ يِشْتن.<verse eid="COL 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="COL 3:15" />اجّم ڒهْنَا ن لْمَسِيح اَذ يحْكم ذݣ وُوْڒَاون نْوم مِينْزِي كنِّيو ذ يجّن ن جْمَاعث يڒَاغَا-يَاوم-د اَڒ ڒهْنَا-يَا. كنِّيو عَاوذ شكَّرم أَربِّـي. <verse eid="COL 3:15" /><verse number="16" style="v" sid="COL 3:16" />اجّم اَوَاڒن ن لْمَسِيح اَذَايْوم زذْغن س مَارَّا لْبَرَكَا نْسن. س مَارَّا ڒفْهَامث يتْخصَّا يجّن اَذ يسفْهم ونّغْنِي، ئِجّن اَذ ينْهَا ونّغْنِي. غنّْجم س وَاوَاڒن ن زَّبُوْر ذ لْأَمْدَاح ذ يِيزْڒَان رُوْحِيَا اَكِذس ثݣّم يجّن ن شُّكر ذݣ وُوْڒَاون نْوم إِ أَربِّـي. <verse eid="COL 3:16" /><verse number="17" style="v" sid="COL 3:17" />مَارَّا مِين تݣّم س وَاوَاڒن نِغ س لْحَسَانَاث، ئِتْخصَّا اَذ تݣّم مَانَايَا مَارَّا عْلَاحْسَاب يسم ن سِيذِيثْنغ عِيْسَى اَزَّايس تْشكَّرم أَربِّـي بَابَاثْنغ.<verse eid="COL 3:17" /></para>
  <para style="s">ڒُوْصِيَاث ن ڒْمُوْمِنِين يتْذفَّارن لْمَسِيح</para>
  <para style="p">
    <verse number="18" style="v" sid="COL 3:18" />آ ثِمْغَارِين، طَاعنْت إِ يرْيَازن نْكنْت مِينْزِي مَانَايَا إِݣ يدْجَان ذ لْمَعْقُوْل زِي أَربِّـي.<verse eid="COL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="COL 3:19" />آي يرْيَازن، حِبّم ثِمْغَارِين نْوم وَار يدْجِي اَكِسنْت تْوَاقْسْحم.<verse eid="COL 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 3:20" />آي يحنْجِيرن، طَاعم إِ لْوَالِدِين نْوم ذِي مَارَّا ثِمسْڒَايِين مِينْزِي مَانَايَا يتْعجِيب-اَس إِ سِيذِي أَربِّـي.<verse eid="COL 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 3:21" />آي يبَابَاثن، وَار تْقهَّارم شَا ثَارْوَا نْوم بَاش وَار تفْشِيڒن شَا.<verse eid="COL 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="COL 3:22" />آي يسمْغَان، طَاعث إِ أَيثْبَاب نْوم ن دُّنشْت-أَ ذِي مَارَّا ثِمسْڒَايِين. طَاعم-اَسن مَاشِي غِير خْمِي ذَاوم تْبدَّان غَار وزدْجِيف وَاهَا حمَا اَذَاسن تْعجْبم؛ لَّا، طَاعم-اَسن س ڒْخَاضَر نْوم اَكِذْوم ثِيڒِي يجّن ن ثِيݣّْوْذِي ذِي سِيذِيثْنغ. <verse eid="COL 3:22" /><verse number="23" style="v" sid="COL 3:23" />مَارَّا مِين تݣّم، تݣّم-ث س ڒْخَاضَر نْوم مَامّش ذَاس ثْخدّْمم إِ سِيذِيثْنغ مَاشِي إِ يرْيَازن. <verse eid="COL 3:23" /><verse number="24" style="v" sid="COL 3:24" />كنِّيو ثسّْنم لْجَائِزَا نْوم اَذ تِيڒِي ذ يجّن ن لْوَارث زِي سِيذِيثْنغ. نتَّا ؤُمِي ثْخدّْمم نتَّا ذ سِيذِيثْنغ لْمَسِيح. <verse eid="COL 3:24" /><verse number="25" style="v" sid="COL 3:25" />شُوْف، ونِّي يضدْجْمن اَتَاف اَذ يشّ اَعْمُوْذ خ مِين يضدْجم. <char style="it">أَربِّـي</char> وَار يتݣّ بُو س وُوْذمَاون جَار يِوْذَان.<verse eid="COL 3:25" /></para>
  <chapter eid="COL 3" />
  <chapter number="4" style="c" sid="COL 4" />
  <para style="p">
    <verse number="1" style="v" sid="COL 4:1" />آي أَيثْبَاب ن يسمْغَان، ذبَّرم خَاسن خ يسمْغَان نْوم س مِين يدْجَان نِيشَان ذ ڒْحَقّ نْسن اَقَا كنِّيو ثسّْنم إِلَّا غَارْوم بَاب نْوم ذݣ وجنَّا.<verse eid="COL 4:1" /></para>
  <para style="s">ڒُوْصِيَاث ثِنݣُّوْرَا</para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2" />تݣّم لْمجْهُوْد س ثْࢲَادْجِيث نْوم، إِڒِيم عْلَابَال ذِي ثْࢲَادْجِيث نْوم شكَّرم أَربِّـي. <verse eid="COL 4:2" /><verse number="3" style="v" sid="COL 4:3" />ذِي نّفْس ن ڒْوقْث تَّارم-اَس إِ أَربِّـي خَانغ بَاش اَذ يرْزم ثَوَّارْث إِ وَاوَاڒ نّغ أَ نْبشَّر س ڒْمَعْنَا ينُوْفَّرن ن لْمَسِيح إِي خف إِي دْجِيغ نش ذِي ڒحْبس. <verse eid="COL 4:3" /><verse number="4" style="v" sid="COL 4:4" />تَّارم-اَس إِ أَربِّـي بَاش اَزَّايس سْفهْمغ مْلِيح <char style="it">إِ يِوْذَان</char> عْلَاحْسَاب مِين لَابُد اَذ ينِيغ. <verse eid="COL 4:4" /><verse number="5" style="v" sid="COL 4:5" />عِيشث س ڒفْهَامث اَك يِنِّي يدْجَان غَار بَارَّا نْوم <char style="it">وَار يُوْمِينن شَا</char>، سْتَغلَّام ڒْوقْث نْوم مْلِيح. <verse eid="COL 4:5" /><verse number="6" style="v" sid="COL 4:6" />أُو لَابُد اَوَاڒ نْوم اَذ يِيڒِي ڒبْدَا يشُّوْر س اَرْضَا يمدْجْحن س ڒمْڒح بَاش اَذ تسّْنم مَامش غَا ثَارّم خ كُڒ يجّن.<verse eid="COL 4:6" /></para>
  <para style="s">لْخِتَام ن ثبْرَات-أَ</para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7" />ؤُمَاثْنغ تُوْشِيق اَكنِّيو يخبَّر خ مَارَّا مِين تݣّغ ذَانِيتَا. نتَّا يعِيزّ خَافِي، ئِتْسخَّار إِ أَربِّـي س يِجّن ن تِّقث. نتَّا ذ اَخدَّام يتمْعَشَارن اَكِذِي ذِي ڒْخذْمث ن سِيذِيثْنغ. <verse eid="COL 4:7" /><verse number="8" style="v" sid="COL 4:8" />سّكّغ-ث-يذ غَارْوم خ شّْغڒ-أَ وَانِيتَا بَاش اَذ تسّْنم مَامش ندْجَا نشِّين اَذ يشجّع ؤُڒَاون نْوم. <verse eid="COL 4:8" /><verse number="9" style="v" sid="COL 4:9" />أَكِذس ؤُمَاثْنغ وَنِيسَامُو نتَّا إِي خَانغ يعِيزّن ذَايس تِّقث، نتَّا زِي ثْمُوْرْث نْوم. يِيْنَا اَكنِّيو خبَّرن مَارَّا مِين يوقْعن ذݣ ومْشَان-أَ.<verse eid="COL 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="COL 4:10" />ئِسَاوَّاض-اَوم-د سْڒَام أَرِسْتَارْخُوْس ونِّي إِي كِذِي يدْجَان ذِي ڒحْبس-أَ. ئِسَاوَّاض-اَوم-د سْڒَام ؤُڒَا ذ مَرْقُس مِّيس ن عْزِيزس ن بَرْنَابَاس. تُوْغَا وصِّيغ-كنِّيو خ مَرْقُس-أَ مڒَا يُوْسَا-د غَارْوم رحّْبث زَّايس. <verse eid="COL 4:10" /><verse number="11" style="v" sid="COL 4:11" />ئِسَاوَّاض-اَوم-د سْڒَام عَاوذ عِيْسَى ونِّي ؤُمِي قَّارن يُوْسْتُوْس. ذ يِيْنَا وَاهَا إِݣ يدْجَان ذ يسْرَائِيلِيْين زݣ يِنِّي يتمْعَشَارن اَكِذِي ذِي ڒْخذْمث-أَ عْلَاحْسَاب ڒْمُلْك ن أَربِّـي، تْشجَّاعن-اَيِي اَطَّاس.<verse eid="COL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 4:12" />ئِسَاوَّاض-اَوم-د سْڒَام پَـافْرَاس نتَّا إِݣ يدْجَان زِي ثْمُوْرْث نْوم، نتَّا ذ يجّن ن وخدَّام ن عِيْسَى لْمَسِيح. ڒبْدَا يتَاحڒ ذِي ثْࢲَادْجِيث عْلَاحْسَاب كنِّيو بَاش اَذ تْبدّم خ دْسَاس اَذ تِيڒِيم ثمْغَرم ذِي لْإِيمَان نْوم وَار غَارْوم يتِيڒِي بُو شّكّ ذِي مَارَّا مِين يخس أَربِّـي. <verse eid="COL 4:12" /><verse number="13" style="v" sid="COL 4:13" />نش شهّْذغ خَاس يربّڒ خَاوم مْلِيح ذ يِنِّي عَاوذ يدْجَان ذِي ثنْدِينْت ن لَاوْدُكْيَا ذ يِنِّي يدْجَان ذِي ثنْدِينْت ن يِيرَاپُـلِيس.<verse eid="COL 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="COL 4:14" />ئِسَاوَّاض-اَوم-د سْڒَام اَمْعِيزّ نّغ لُوْقَا إِݣ يدْجَان ذ اَضْبِيب، أَكِذس دِيمَاس. <verse eid="COL 4:14" /><verse number="15" style="v" sid="COL 4:15" />سِيوْضم-اَسن سْڒَام ينُو إِ أَيثْمَاثْنغ إِي يدْجَان ذِي ثنْدِينْت ن لَاوْدُكْيَا ذ <char style="it">وُوْتْشْمَاثْنغ</char> نُوْمِيبْـيَا ذ جْمَاعْث ن ڒْمُوْمِنِين إِي يدْجَان ذِي ثدَّارْث نّس.<verse eid="COL 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 4:16" />خْمِي غَا ثغرم ثَبْرَات-أَ كنِّيو جَارَاوم، عَاوذ خْزَرم جْمَاعث ن ڒْمُوْمِنِين اَت غَرن ذِي لَاوْدُكْيَا. خْزَرم عَاوذ كنِّيو ثَبْرَات نْسن زِي لَاوْدُكْيَا اَت تغَرم.<verse eid="COL 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="COL 4:17" />إِنِيم-اَس إِ أَرْكِيپُّـوْس أُو لَابُد اَذ تْكمّْڒذ لْوَاجِب ن ڒْخذْمث إِي ثْقبْڒذ زِي سِيذِيثْنغ.<verse eid="COL 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="COL 4:18" />قَا نش ذ بُوْلُس س ثِيرَا ن وفُوْس ينُو إِي زِي ذَاوم د سَاوَّاضغ سْڒَام ڒخُّو. فقْذم-اَيِي-د س سْنَاسڒ ينُو <char style="it">ن ڒحْبس-أَ</char>. أَكِذْوم يِيڒِي اَرْضَا.<verse eid="COL 4:18" /></para>
  <chapter eid="COL 4" />
</usx>