<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- TarifitABS</book>
  <para style="h">يعيبرانيين</para>
  <para style="toc3">عب</para>
  <para style="toc2">يعيبرانيين</para>
  <para style="toc1">ثَبْرَات غَار يعِيبْرَانِيْين</para>
  <para style="mt1">ثَبْرَات غَار يعِيبْرَانِيْين</para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="s">سِيذِي أَربِّـي يسَّاوَاڒ اَكِذْنغ س مِّيس</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />ذِي زْمَان يسَّاوَاڒ أَربِّـي اَك ڒجْذُوْذ نّغ س وقمُّوْم ن لْأَنْبِيَا س وَاطَّاس ن ثْوَاڒَاثِين س وَاطَّاس ن يبْرِيذن. <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />وَلَكِن ذِي لْأَيَّام-أَ ينݣُّوْرَا يسَّاوَاڒ اَكِذْنغ س وقمُّوْم ن مِّيس يعْنِي ونِّي إِي يخْضَر اَذ يوَارث مَارَّا ثِمسْڒَايِين، زَّايس إِي د يخْڒق أَربِّـي دُّنشْت. <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />نتَّا ذ نُّوْر ن لْعَظَمَا ن أَربِّـي ذ صِّفث ن طَّبِيعَا نّس بْڒَا اَخطِّي. س جّْهذ ن وَاوَاڒ نّس إِي زِي يربُّو مَارَّا ثِمسْڒَايِين. وَامِي يحلّ ڒْمُعْصِيَاث ن بْنَاذم يسِّيصْفَا-ثنْت، سّنِّي يقِّيم خ وفُوْسِي ن أَربِّـي سُبْحَانَا وَتَعَالَى.<verse eid="HEB 1:3" /></para>
  <para style="s">لْعَظَمَا ن مِّيس ن أَربِّـي خ لْمَلَائِكَاث</para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4" />فَا مِّيس يذْوڒ يمْغَر اَطَّاس خ لْمَلَائِكَاث مِينْزِي يسم نِّي إِي ذَاس يسْوَارث أَربِّـي يمْغَر اَطَّاس خ يِيسمَاون نْسنْت.<verse eid="HEB 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 1:5" />أَربِّـي عَمَّارْص وَار ذَاس ينِّي إِ شَان ن لْمَلَاك زِي لْمَلَائِكَاث اَقَا شك ذ مِّي، نْهَارَا نش ذوْڒغ ذ بَابَاش.</para>
  <para style="p" vid="HEB 1:5">عمَّارْص وَار ينِّي <char style="it">خ شَان ن لْمَلَاك</char> قَا نش اَذ يڒِيغ ذ بَابَاس، نتَّا اَذ يِيڒِي ذ مِّي.<verse eid="HEB 1:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="HEB 1:6" />أُو عَاوذ أَربِّـي وَامِي د يتَاوِي مِّيس اَمنْزُو<note caller="+" style="f"><char style="fr" closed="false">1‏.6 </char><char style="ft" closed="false">أَمنْزُو نتَّا ذ يفْخدِّي، قَّارن-ث إِ وحنْجِير إِي د غَا يخڒْقن ذ اَمزْوَارُو.</char></note> غَار دُّنشْت-أَ يقَّار: أَذَاس سجّْذنْت مَارَّا لْمَلَائِكَاث.<verse eid="HEB 1:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="HEB 1:7" />خْمِي يسَّاوَاڒ خ لْمَلَائِكَاث يقَّار:</para>
  <para style="q2" vid="HEB 1:7">&lt;ئِخدْجق-د لْمَلَائِكَاث نّس ذ اَرِّيح،</para>
  <para style="q2" vid="HEB 1:7">ذ يمْسخَّارن نّس ذ اَحَذُوْق ن ثْمسِّي.&gt;<verse eid="HEB 1:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="HEB 1:8" />وَلَكِن خ مِّيس يقَّار <char style="it">ذِي لْكِتَاب</char>:</para>
  <para style="q1" vid="HEB 1:8">&lt;آي أَربِّـي، ڒْعَرْش نّش اَذ يدُوْم إِ ڒبْدَا ن ڒبْدَاث،</para>
  <para style="q2" vid="HEB 1:8">ڒْحَقّ اَذ يِيڒِي ذ ثَغْرِيث ن ڒحْكَام نّش.<verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />تْحِبِّيذ مِين يصڒْحن، تْعِيفِّيذ شَّرّْ.</para>
  <para style="q2" vid="HEB 1:9">س مَانَايَا أَربِّـي يعْنِي أَربِّـي نّش،</para>
  <para style="q1" vid="HEB 1:9">ئِذْهن-اَش س زّشْت ن ڒفْرَاحث،</para>
  <para style="q2" vid="HEB 1:9">ئِسِيڒِي-يِش ذݣ وجنَّا خ يمْعَشَارن نّش.&gt;<verse eid="HEB 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 1:10" />ئِقَّار عَاوذ: &lt;آي أَربِّـي، ذݣ ومزْوَارُو ثْسرْسذ دْسَاسَاث ن دُّنشْت-أَ، ثݣِّيذ يجنَّاثن<note caller="+" style="f"><char style="fr" closed="false">1‏.10 </char><char style="ft" closed="false">ئِجنَّاثن نِثْنِي ذ لْجَمَع ن وجنَّا، يعْنِي ذ سّْمَوَاث.</char></note> س وفُوْس نّش.<verse eid="HEB 1:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="HEB 1:11" />يِيْنَا اَذ فْنَان شك اَذ تْدُوْمذ،</para>
  <para style="q2" vid="HEB 1:11">مَارَّا اَذ رْشَان اَم وَارُّوْض.<verse eid="HEB 1:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="HEB 1:12" />أَثن ثْضفْسذ اَم وزدْجَاب ذ اَخَرْطِيط،</para>
  <para style="q2" vid="HEB 1:12">أَذ تْوَابدّْڒن اَم وَارُّوْض.</para>
  <para style="q1" vid="HEB 1:12">شك لَّا، وَار تْبدِّيڒذ شَا،</para>
  <para style="q2" vid="HEB 1:12">ئِسݣّْوُوْسَا نّش عمَّارْص اَذ فْنَان.&gt;<verse eid="HEB 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 1:13" />إِيوَا عمَّارْص أَربِّـي وَار ينِّي إِ شَان ن لْمَلَاك زِي لْمَلَائِكَاث: &lt;قِّيم-د خ وفُوْسِي ينُو اَڒ د غَا ݣَّغ ڒْعَذْيَان نّش سْوَادَّاي يضَارن نّش.&gt;<verse eid="HEB 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 1:14" />لْمَلَائِكَاث، نِثنْتِي مِين عْنَانْت؟ نِثنْتِي ذ اَرُّوْحَاث تْوَاسّكّنْت-يد اَذ سخَّارنْت إِ يِنِّي إِي غَا يوَارْثن اَسنْجم.<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s">أَسنْجم نّغ يمْغَارن اَطَّاس</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />خ مَانَايَا لَابُد أَ د نَارّ ڒْبَاڒ نّغ إِ مِين نتْسْڒَا بَاش وَار نْتفّغ شَا اَبْرِيذ. <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />شُوْف، <char style="it">شَّرِيعَا نِّي ن مُوْسَى</char> تُوْغَا ؤُوِينْت-تِيد لْمَلَائِكَاث، تْسيْطَر خَانغ تْعَاقَاب-اَنغ يعْنِي مڒَا نعْصَا نِغ مڒَا وَار نْطِيع شَا. <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />ڒخُّو اَسنْجم نّغ يمْغَارن، مَامّش إِي غَا نݣّ أَ ننْجم زِي لْعِقَاب يعْنِي مڒَا نغْفڒ خ وسنْجم-أَ؟ أَوَاڒ ن وسنْجم-أَ يبْشَر-يث-يذ ذ اَمزْوَارُو سِيذِيثْنغ، ثُمَّا شهْذن خَاس يِنِّي إِي ذَاس يصنّْطن سِّيوْضن-ث-يذ إِ نشِّين. <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />ئِشهّذ خَاس ؤُڒَا ذ أَربِّـي س لْعَلَامَاث ذ لْبُرْهَانَاث ذ وَاطَّاس ن لْأَنْوَاع ن لْمُعْجِيزَاث. س لْإِذن نّس عَاوذ يفرق لْقُدْرَاث رُوْحِيَاث ن اَرُّوْح يقدّْسن.<verse eid="HEB 2:4" /></para>
  <para style="s">ونِّي إِي يدْجَان ذ زَّعِيم ن وسنْجم نّغ</para>
  <para style="p">
    <verse number="5‏-6" style="v" sid="HEB 2:5-6" />ڒخُّو نشِّين نسَّاوَاڒ خ دُّنشْت-أَ إِي تُوْغَا نتْرَاجَا. شُوْف، أَربِّـي مَاشِي إِ لْمَلَائِكَاث ؤُمِي يُوْشَا ڒحْكَام خ دُّنشْت-أَ لَّا. أَقَا ذِنِّي يجّن ن ومْشَان ذِي لْكِتَاب مَانِي يشْهذ يجّن خ مَانَايَا يقَّار:</para>
  <para style="q1" vid="HEB 2:5-6">&lt;تْفكَّرذ شك ذݣ يرْيَازن، مَاشَا مِين سْوَان؟</para>
  <para style="q1" vid="HEB 2:5-6">مِّيس ن بْنَاذم، مَايمِّي إِي ذَايس غَا يتْهِلَّان؟<verse eid="HEB 2:5-6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />ثݣِيذ-ث عْڒَاين اَم لْمخْلُوْقَاث وجنَّا يُوْعْڒَان،</para>
  <para style="q1" vid="HEB 2:7">ثُوْشِيذ-اَس تَّاج ن ڒُوقَّار ذ وَاطَّاس ن شَّان،<verse eid="HEB 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 2:8" />ثݣِّيذ سْوَادَّاي يضَارن نّس مَارَّا مِين يدْجَان.&gt;</para>
  <para style="b" vid="HEB 2:8" />
  <para style="p" vid="HEB 2:8">وَامِي يݣَّا أَربِّـي مَارَّا سْوَادَّاي يضَارن نّس، وَار ثقِّيم ؤُڒَا ذ يجّن ن ثْمسْڒَايْث وَار خَاس يحكِّيم شَا. إِنَّمَا، عَاذ ذِي ڒْوقْث-أَ وَار نتْوِيڒِي شَا مَارَّا سْوَادَّاي يضَارن ن بْنَاذم. <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />وَلَكِن عِيْسَى وَاه، نتْوَاڒَا-ث ڒخُّو س تَّاج نّس ن ڒُوقَّار ذ وَاطَّاس ن شَّان. مَايمِّي؟ لِأَنَّا عِيْسَى ذݣ يِجّن ن ڒْوقْث تُوْغَا يسهْوَا-ث-يذ أَربِّـي شْوَايْت سْوَادَّاي إِ لْمَلَائِكَاث يعْنِي وَامِي يصْبَر إِ ڒَعْذَاب ن ڒْموْث. بَاش نتَّا س اَرْضَا ن أَربِّـي اَذ يقَّاس ڒْموْث، ڒْموْث نِّي اَذ تِيڒِي ن مَارَّا يوْذَان.<verse eid="HEB 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 2:10" />زِي أَربِّـي إِي تِيڒِينْت مَارَّا ثِمسْڒَايِين-أَ أُو نتَّا ؤُمِي تِيڒِينْت. ذ أَربِّـي نتَّا إِي يَارِّين عِيْسَى وَار ذَايس بُو ڒْعِيب س ڒَعْذَاب نِّي نّس إِي خَاس يعْذُوْن حمَا أَربِّـي اَذ د يَاوِي اَطَّاس ن ثَارْوَا غَار لْعَظَمَا نّس. غَارس ڒْمَعْنَا مَانَايَا ڒَاحقَّاش عِيْسَى نتَّا ذ زَّعِيم ن وسنْجم ن ثَارْوَا-يَا. <verse eid="HEB 2:10" /><verse number="11" style="v" sid="HEB 2:11" />أَقَا ونِّي يسِّيصْفَان يوْذَان زِي ڒْمُعْصِيَاث نْسن أُو ذ يِوْذَان نِّي يتْوَاسِّيصْفَان، بَابَاثْسن ذ يجّن. خ مَانَايَا وَار خَاسن يتْعفَّر شَا اَذَاسن يِينِي آي أَيثْمَا. <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />لَّا، يقَّار-اَس <char style="it">إِ أَربِّـي</char>: &lt;أَذ سِّيوْڒغ خ يِيسم نّش اَك أَيثْمَا، ذِي ڒْوسْط ن جْمَاعث اَش حمْذغ س يغنِّيجن.&gt;<verse eid="HEB 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 2:13" />أُو عَاوذ يقَّار: &lt;نش اَذ تيّْقغ ذِي أَربِّـي.&gt;</para>
  <para style="p" vid="HEB 2:13">ئِقَّار عَاوذ: &lt;أَقَايِي نش ذ ثَارْوَا ينُو إِي ذَايِي يُوْشَا أَربِّـي.&gt;<verse eid="HEB 2:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />إِذن ثَارْوَا-يَا نِثْنِي ذ يوْذَان ذَايْسن مَارَّا اَيْسُوْم ذ يذَامّن. خ مَانَايَا عِيْسَى ؤُڒَا ذ نتَّا ذَايس ثِمسْڒَايِين-أَ. أَمُّو س ڒْموْث نّس يسْبطّڒ زَّعِيم ن ڒْموْث يعْنِي ذ إِبْڒِيس. <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />أُو عَاوذ عِيْسَى اَذ د يضْڒق إِ يِنِّي يدْجَان ذ يسمْغَان زِي ڒخْڒُوْق يعْنِي يِنِّي خَاسن ثْحكّم ثِيݣّْوْذِي زِي ڒْموْث أُوْشَا اَذ يڒِين حُرّ.<verse eid="HEB 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 2:16" />شُوْف، نسّن بلِّي عِيْسَى وَار يتْعِيوِين شَا لْمَلَائِكَاث؛ لَّا، ئِتْعَاوَان ثَارْوَا ن بْرَاهِيم. <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />خ مَانَايَا تُوْغَا وَا لَابُد أَربِّـي اَذ يَارّ عِيْسَى اَم أَيثْمَاس ذِي مَارَّا بَاش اَذ يِيڒِي ذ ڒفْقِي اَمقّْرَان ذَايس اَرَّحْمث ذَايس تِّقث يخدّم إِ أَربِّـي. أُو عَاوذ <char style="it">ڒفْقِي-يَا</char> اَذ يقدّم لْفِدْيَا حمَا اَذ تْوَاغْفَرنْت ڒْمُعْصِيَاث ن يِوْذَان. <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />وَامِي نتَّا س يِيخف نّس يتْوَاعدّب ذِي ڒمْحَاين، ئِزمَّر اَذ يعَاون يِنِّي يدْجَان ذِي ڒمْحَاين.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s">سِيذِيثْنغ عِيْسَى يمْغَارن خ نَّبِي مُوْسَى</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />آي اَيثْمَا صَّالِحِين، ذ كنِّيو إِي يدْجَان ذ يمْعَشَارن ذݣ ؤُڒَاغِي نِّي إِي د يُوْسِين زݣ وجنَّا. فكَّرث مْلِيح ذِي عِيْسَى، نتَّا ذ اَرَّسُوْل نتَّا ذ ڒفْقِي اَمقّْرَان ن لْإِيمَان إِي خَاس نْشهّذ نشِّين. <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />ئِخْذم عِيْسَى س لْإِذن ن ونِّي إِي ثِيد يعيّْنن مَامّش يݣَّا نَّبِي مُوْسَى ؤُڒَا ذ نتَّا يخْذم س لْإِذن ن أَربِّـي ذِي اَيثْبَاب ن ثدَّارْث ثكْمَاڒ ن أَربِّـي.<verse eid="HEB 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 3:3" />شُوْف، عِيْسَى يُوْفِي-ث يسْذَاهدْج لْعَظَمَا كْتَار زِي نَّبِي مُوْسَى مَامّش يدْجَا بَاب ن ثدَّارْث يسْذَاهدْج شَّان كْتَار زِي أَيثْبَاب ن ثدَّارْث نِّي إِي ذِنِّي د يُوْرو. <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />لِأَنَّا كُڒ ثَدَّارْث غَارس ونِّي إِي ثن د يُوْرْون أُو مَارَّا يجِّي-ثن-د أَربِّـي.<verse eid="HEB 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 3:5" />تُوْغَا نَّبِي مُوْسَى يخدّم نِيشَان ذ اَمْسخَّار، ئِتْعَاوَان اَيثْبَاب ن ثدَّارْث ثكْمَاڒ ن أَربِّـي، ئِشهّذ خ ثْمسْڒَايِين تُوْغَا عَاذ إِي غَا يتْوَابشَّرن ذِي لْمُسْتَقْبل. <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />وَلَكِن لْمَسِيح نتَّا ذ مِّيس يحكّم خ اَيثْبَاب ن ثدَّارْث ن أَربِّـي، ئِتْكلَّاف زَّايْسن نِيشَان. أُو نشِّين ذ اَيثْبَاب-أَ ن ثدَّارْث نّس يعْنِي مڒَا نطّف مْلِيح ذِي زْعَامث نّغ أُو ذِي لْأَمَال نّغ إِي خف نْتفْتَاخَر.<verse eid="HEB 3:6" /></para>
  <para style="s">أَرَّاحث ن يِنِّي يتَامْنن</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />خ مَانَايَا اَمُّو يقَّار أَرُّوْح يقدّْسن: نْهَارَا مڒَا ثسْڒِيم إِ صُّوْت ن أَربِّـي، <verse eid="HEB 3:7" /><verse number="8" style="v" sid="HEB 3:8" />وَار سقْسِيحث شَا ؤُڒَاون نْوم مَامش إِي ݣِّين أَيث-إِسْرَائِيل وَامِي ذَايِي عْصَان ذِي ڒْوقْث نِّي ن ڒْمِحْنث ذِي ڒخْڒَا. <verse eid="HEB 3:8" /><verse number="9" style="v" sid="HEB 3:9" />ذݣ ومْشَان نِّي ڒجْذُوْذ نْوم زعّْمن-اَيِي س ثْغنَّانْت اَذ ࢲرن نش مِين عنِّيغ، وَاخَّا ؤُڒَا ذِي اَرْبعِين يسݣّْوُوْسَا ࢲْرِين ڒخْذَايم ينُو. <verse eid="HEB 3:9" /><verse number="10" style="v" sid="HEB 3:10" />خ مَانَاينِّي سْعصّْبن-اَيِي يِوْذَان ن زْمَان نِّي. نِّيغ نش قَا ڒبْدَا تْبعَّاذن خَافِي س وُوْڒَاون نْسن، ئِبْرِيذن ينُو وَار ثن سِّينن شَا نِثْنِي. <verse eid="HEB 3:10" /><verse number="11" style="v" sid="HEB 3:11" />سّنِّي جُّوْدْجغ س وغْضَاب ينُو نِّيغ عمَّارْص اَذ اَذْفن ذِي اَرَّاحث ينُو.<verse eid="HEB 3:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />آي اَيثْمَا، حْضَام يخف نْوم بَاش ؤُڒَا ذ يجّن زَّايْوم وَار غَارس يتِيڒِي وُوْڒ ذ اَبرْشَان نِغ وَار ذَايس يتِيڒِي بُو لْإِيمَان بَاش وَار يتْبعِّيذ شَا نتَّا خ أَربِّـي يدَّرن. <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />لَّا، مڒَا نْزمَّر أَ نِيْنِي &lt;نْهَارَا&gt;، أَتَاف اَذ تْشجّْعم اَيَاوْيَا كُڒ نْهَار بَاش وَار ذِنِّي يتِيڒِي حَدّ زَّايْوم اَذ يذْوڒ يقْسح وُوْڒ نّس اَث تخْذع ڒْمُعْصِيْث نّس. <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />أَقَا نشِّين أَ نِيڒِي ذ يمْعَشَارن ذِي لْمَسِيح يعْنِي مڒَا نقِّيم نطّف مْلِيح اَڒ ونݣَّارُو ذِي تِّقث نِّي إِي تُوْغَا غَارْنغ ذ اَمزْوَارُو. <verse eid="HEB 3:14" /><verse number="15" style="v" sid="HEB 3:15" />مَامّش يقَّار لْكِتَاب: &lt;نْهَارَا مڒَا ثسْڒِيم إِ صُّوْت نّس، وَار سقْسِيحث شَا ؤُڒَاون نْوم مَامش إِي ݣِّين أَيث-إِسْرَائِيل وَامِي ث عْصَان.&gt;<verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />شُوْف، مِين عْنَان يِنِّي يسْڒِين ؤُݣِين اَذ ݣّن اَرَّاي إِ أَربِّـي؟ يَاش ذ يوْذَان نِّي مَارَّا إِݣ يسُوْفغ <char style="it">نَّبِي</char> مُوْسَى زِي مِصْرَا نِغ؟ <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />مِين عْنَان يِنِّي يسْعصَّابن أَربِّـي ذِي اَرْبعِين يسْݣُّوُوْسَا نِّي؟ يَاش ذ يِنِّي يعْصَان أَربِّـي منْضَارن ذِنِّي ذِي ڒخْڒَا نِّي اَم يمُّوْضَاس نِغ؟ <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />أُو مِين عْنَان يِنِّي إِي خف يجُّوْدْج أَربِّـي ينَّا-ٱسن عمَّارْص اَذ اَذْفن ذِي أَرَّاحث ينُو؟ يَاش ذ يِنِّي وَار يتْطِيعِين شَا نِغ؟ <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />إِيوَا نشِّين نتْوَاڒَا بلِّي تُوْغَا وَار زمَّرن شَا اَذ اَذْفن ذِي <char style="it">أَرَّاحث ن سِيذِي أَربِّـي</char> مِينْزِي ؤُݣِين اَذ اَمْنن.<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />إِذن فَا عَاذ نْزمَّر أَ نَاذف ذِي اَرَّاحث ن سِيذِي أَربِّـي مِينْزِي ذَانغ يوْعذ. وَا لَابُد أَ نݣّْوذ بَاش وَار يتْغِيمِي ؤُڒَا ذ يجّن زَّايْوم وَار ذِنِّي د يخطّڒ. <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />لِأَنَّا ڒخْبَار-أَ ن ڒْخِير إِي ذَانغ د يتْوَابشَّرن إِ نشِّين، ؤُڒَا ذ ڒجْذُوْذ نّغ تْوَابشَّرن زَّايس. وَلَكِن وَار سْتنْفِيْعن شَا زَّايس وَامِي ؤُݣِين اَزَّايس اَمْنن. <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />شُوْف، أَرَّاحث نِّي مِيخف يسَّاوَاڒ أَربِّـي اَتَاف نْتَاذف ذَايس نشِّين إِي يُوْمْنن. ئِسِّيوڒ أَربِّـي خ مَانَايَا وَامِي ينَّا: &lt;قَا نش جُّوْدْجغ س وغْضَاب ينُو نِّيغ عمَّارْص اَذ اَذْفن ذِي اَرَّاحث ينُو.&gt; مَان اَرَّاحث؟ يعْنِي ثنِّي ن سِيذِي أَربِّـي وَامِي يكمّڒ ڒخْذَايم نّس يخْڒق-د دُّنشْت-أَ.<note caller="+" style="f"><char style="fr" closed="false">4‏.3 </char><char style="ft" closed="false">لْكِتَاب ن يمزْوُوْرَا 2: 2‏-3: وَامِي يكمّڒ أَربِّـي مَارَّا ڒْخذْمث نّس، يريّح ذِي نْهَار وِيس سبْعَا يعْنِي نْهَار ن سّبْث. سّنِّي يبَرك أَربِّـي نْهَار نِّي يَارِّي-ث مُقدّس ڒَاحقَّاش ذَايس يكمّڒ مَارَّا مِين د يخْڒق.</char></note><verse eid="HEB 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 4:4" />إِيوَا ذݣ يِجّن ن لْأَيَا اَمنِّي إِݣ ينَّا خ نْهَار وِيس سبْعَا: ينَّا: &lt;ذِي نْهَار وِيس سبْعَا إِݣ يريّح أَربِّـي زِي مَارَّا ڒخْذَايم نّس.&gt; <verse eid="HEB 4:4" /><verse number="5" style="v" sid="HEB 4:5" />أُو عَاوذ ذِي لْأَيَا نِّي نّغْنِي إِي خف نسِّيوڒ قْبڒ ينَّا: &lt;عمَّارْص اَذ اَذْفن ذِي اَرَّاحث ينُو.&gt;<verse eid="HEB 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 4:6" />إِذن عَاذ قِّيمن ڒبْعَاض ن يِوْذَان اَذ اَذْفن ذِي اَرَّاحث-أَ <char style="it">ن سِيذِي أَربِّـي</char>، يِنِّي يتْوَابشَّرن زِي قْبڒ وَار ؤُذِيفن شَا ذِنِّي لِأَنَّا وَار ؤُمِينن شَا. <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />س مَانَايَا تُوْغَا يسجّل أَربِّـي يجّن ن ڒْوقْث نّغْنِي بَاش أَ نَاذف ذِي اَرَّاحث نّس، ڒْوقْث نِّي يسمَّا-يَاس أَربِّـي &lt;نْهَارَا.&gt; منْبَعْد إِ وَاطَّاس ن لْقُرُوْن إِݣ يسِّيوڒ أَربِّـي س نَّبِي دَاود وَامِي ينَّا مَامش ننَّا قْبڒ: &lt;نْهَارَا مڒَا ثسْڒِيم إِ صُّوْت ن أَربِّـي، وَار سقْسِيحث شَا ؤُڒَاون نْوم.&gt;<verse eid="HEB 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8" />شُوْف، مَعْلِيك <char style="it">نَّبِي</char> يَشُوْعَا تُوْغَا يسِّيوض ڒجْذُوْذ نّغ غَار يِجّن ن اَرَّاحث، أَتَاف أَربِّـي وَار يسِّيوڒ شَا خ يِجّن ن نْهَار نّغْنِي منْبَعْد إِ وَاطَّاس ن لْقُرُوْن. <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />فَلِهَذَا عَاذ يقِّيم يجّن ن سّبْث، يعْنِي ذ يجّن ن ڒْوقْث ن اَرَّاحث إِ شَّعْب ن أَربِّـي. <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />لِأَنَّا ونِّي يُوْذْفن ذِي اَرَّاحث ن أَربِّـي اَقَا يتْريَّاح زِي ڒْخذْمث نّس مَامّش يريّح أَربِّـي زِي ڒْخذْمث نِّي نّس. <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />إِذن وَا لَابُد أَ نݣّ لْمجْهُوْد نّغ بَاش أَ نَاذف ذِي اَرَّاحث نِّي حمَا ؤُڒَا ذ يجّن وَار يوطِّي ذِي نّفْس ن ڒْمُعْصِيّث.<verse eid="HEB 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12" />أَقَا اَوَاڒ ن أَربِّـي يدَّر نتَّا يفْسُوْس، ئِقْضع اَطَّاس كْتَار زِي سِّيف ن ثْنَاين ن جِّهَاث. ئِتَاذف اَڒ ذَاخڒ يفرّق بُوْحْبڒ ذ اَرُّوْح ذ مَانِي تْمُوْنن ڒمْفَاسڒ، ئِتَاذف غَار وَاذُوْف. ئِتْميَّاز جَار لْأَفْكَار ذ لْأَغْرَاض ن وُوْڒ. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />وَار ذِنِّي ؤُڒَا ذ يجّن ن ثْمسْڒَايْث زِي مِين د يتْوَاخڒْقن ثْنُوْفَّار زِي أَربِّـي. قَاع ثِمسْڒَايِين تْوَافضْحنْت-يد تْوَاظْهَارنْت-يد إِ ثِيطَّاوِين ن ونِّي ؤُمِي غَا نُوْش ڒحْسَاب نّغ. <verse eid="HEB 4:13" /><verse number="14" style="v" sid="HEB 4:14" />إِذن نشِّين أَ نطّف مْلِيح ذِي لْإِيمَان نّغ إِي خف نْشهّذ مِينْزِي غَارْنغ يجّن ن ڒفْقِي اَمقّْرَان يمْغر يُوْذف ذݣ يجنَّاثن يعْذُو-ثن، نتَّا ذ عِيْسَى مِّيس ن أَربِّـي.<verse eid="HEB 4:14" /></para>
  <para style="s">سِيذِيثْنغ عِيْسَى نتَّا ذ ڒفْقِي اَمقّْرَان</para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 4:15" />شُوْف، وَار غَارْنغ بُو يجّن ن ڒفْقِي اَمقّْرَان نتَّا وَار يزمَّر شَا اَذ يحسّ زِي ضُّوْعف نّغ. وَاه، غَارْنغ يجّن ڒفْقِي كِّينْت خَاس مَارَّا ڒمْحَاين؛ نتَّا اَم نشِّين وَلَكِن وَار يݣِّي بُو ڒْمُعْصِيّث. <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />فَلِهَذَا أَ نْقَارّب س زْعَامث غَار ڒْعَرْش ن أَربِّـي ذَايس اَرْضَا بَاش أَ نَاف ذِنِّي اَرَّاحْمث ذ يجّن ن اَرْضَا إِي ذَانغ غَا يعَاوْنن ذِي ڒْوقْث ن ؤُحْذَاجِي نّغ.<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />شُوْف، كُڒ ڒفْقِي اَمقّْرَان تِيخْضَارن-ث-يد زݣ يرْيَازن، تِيشّن-اَس ڒْوقْث ن ڒْخذْمث نّس بَاش اَذ يخْذم زَّاث إِ أَربِّـي عْلَاحْسَاب يوْذَان اَذ يقدّم صّذْقث ذ دْبِيحَاث خ ڒْمُعْصِيَاث. <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />ئِزمَّر نتَّا اَذ يحِيْنّ خ يِنِّي وَار يفهّْمن شَا ذ يِنِّي يفّْغن اَبْرِيذ مِينْزِي نتَّا س يِيخف نّس ذَايس ضُّوْعف. <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />خ مَانَايَا وَا لَابُد اَذ يقدّم دْبِيحَاث خ ڒْمُعْصِيَاث نّس نِّيث مَامّش إِي ثنْت يتْقدَّام خ يِوْذَان.<verse eid="HEB 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 5:4" />عَاوذ وَار ذِنِّي حَدّ إِي غَا يسمْغَارن يخف نّس اَذ يخْذم س شَّان-أَ يعْنِي ذ ڒفْقِي اَمقّْرَان؛ لَّا، ذ أَربِّـي إِي ذَاس يتِيشّن ڒْحَقّ نِّي مَامّش ذَاس ث يُوْشَا إِ <char style="it">ڒفْقِي نِّي ؤُمِي قَّارن</char> هَارُوْن.<note caller="+" style="f"><char style="fr" closed="false">5‏.4 </char><char style="ft" closed="false">هَارُوْن نتَّا ذ ؤُمَاس ن سِيذْنَا مُوْسَى.</char></note> <verse eid="HEB 5:4" /><verse number="5" style="v" sid="HEB 5:5" />أَمُّو ؤُڒَا ذ عِيْسَى وَار يسمْغَار شَا يخف نّس اَذ يخْذم س لْعَظَمَا-يَا يعْنِي ذ ڒفْقِي اَمقّْرَان؛ لَّا، ينَّا-ٱس أَربِّـي: &lt;أَقَا شك ذ مِّي، نْهَارَا نش ذوْڒغ ذ بَابَاش.&gt; <verse eid="HEB 5:5" /><verse number="6" style="v" sid="HEB 5:6" />عَاوذ يقَّار أَربِّـي ذݣ يِجّن ن ومْشَان نّغْنِي: &lt;شك ذ ڒفْقِي إِ ڒبْدَا اَمشْنَاو لْفِرْقَا نِّي ن ڒفْقِي ؤُمِي قَّارن مَلِكِيصَادِق.&gt;<verse eid="HEB 5:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />ذݣ وُوْسَّان نِّي إِي ذِي تُوْغَا يدَّر عِيْسَى ذِي ثْمُوْرْث-أَ، ئِتْࢲَادْجَا يتْڒَاغَا خ أَربِّـي س جّْهذ أُو س يمطَّاون يتتَّار-اَس إِ ونِّي يزمَّرن اَث يسنْجم زِي ڒْموْث. أَربِّـي يتْصنَّاط-اَس وَامِي عِيْسَى يتݣّْوذ زَّايس. <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />وَاخَّا نتَّا ذ <char style="it">مِّيس ن أَربِّـي</char> إِي يدْجَا، يڒْمذ طَّاعَا س وعدّب نِّي إِي خَاس يكِّين. <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />وَامِي يعْذُو اَعدّب نِّي بْڒَا ڒْمُعْصِيّث، ئِذْوڒ نتَّا ذ ڒْعُنْصَر ن وسنْجم يعْنِي يزمَّر اَذ يسنْجم مَارَّا يِنِّي إِي ث يتْطَاعَان. <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />سّنِّي يَارِّي-ث أَربِّـي ذ ڒفْقِي اَمقّْرَان اَمشْنَاو لْفِرْقَا نِّي ن ڒفْقِي مَلِكِيصَادِق.<verse eid="HEB 5:10" /></para>
  <para style="s">يَالَّاهث أَ نُوْيُوْرث غَار زَّاث حمَا أَ نمْغَر</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />عَاذ نْزمَّر أَ نِينِي اَطَّاس خ ثْمسْڒَايِين-أَ وَلَكِن يقْسح اَكنِّيو نْسفْهم. مَايمِّي؟ لِأَنَّا كنِّيو ثْذقْڒم اَذ تْفهْمم. <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />شُوْف، وَا لَابُد كنِّيو ڒخُّو اَذ تِيڒِيم ذ يمْسڒْمَاذن وَلَكِن عَاذ يتْخصَّا-يَاوم يجّن اَكنِّيو يسْغَر س ثْغُوْرِي نِّي ثَمزْوَارُوْت زݣ وَاوَاڒ ن أَربِّـي. كنِّيو تحْذَاجَام اَغِي<note caller="+" style="f"><char style="fr" closed="false">5‏.12 </char><char style="ft" closed="false">أَغِي نتَّا ذ اَشفَّاي ذِي ڒبْعَاض ن يمُوْشَان ذِي أَرِّيف.</char></note> وَاهَا، مَاشِي لْمَكْلَا ذ صَّح. <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />كُڒ يجّن عَاذ ذ اَسيْمِي يتْعِيش س ؤُغِي وَاهَا، يعْنِي وَار يفهّم شَا إِ ؤُسڒْمذ خ مِين يصڒْحن. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />وَلَكِن لْمَكْلَا ن صَّح تتّن-تث غِير يِنِّي وَار يدْجِين شَا ذ يسيْمَان. نِثْنِي زمَّرن إِ لْمَكْلَا نِّي ن صَّح مِينْزِي ڒبْدَا خدّْمن إِ ثْغُوْرِي نِّي إِي قَّارن تْميَّازن جَار مِين يدْجَان ذ اَصبْحَان ذ جَار مِين يدْجَان ذ اَعفَّان.<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />خ مَانَايَا وَار نتْغِيمِيث شَا ذِي تَّعْلِيم-أَ اَمزْوَارُو خ لْمَسِيح، أَ نُوْيُوْرث غَار زَّاث بَاش أَ نمْغَر. وَار نْتَاعْقِيب شَا غَار دْسَاس. يعْنِي وَار نسَّاوَاڒ شَا عَاذ خ تُّوْبَا نِّي ن سَّايِأَث، نِغ خ مَامّش غَا نݣّ أَ نَامن زِي أَربِّـي، <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />نِغ خ يبْرِيذن بَاش اَذ تْوَاطهَّارن يِوْذَان س وَامَان، نِغ خ مَامّش غَا نݣّ أَ نْسرْس يفَاسّن نّغ خ يِوْذَان، نِغ خ لْقِيَامَا ن يمتِّينن، نِغ خ لْحِسَاب نِّي وَار يفنِّين شَا. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />إِيوَا، أَ نُوْيُوْرث غَار زَّاث يعْنِي مڒَا يخس أَربِّـي.<verse eid="HEB 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4" />أَمَّا يِنِّي مِيخف يشعْشع نُّوْر، قَّاسن لْهَادِيَا ن وجنَّا، شَرّْشن ذِي أَرُّوْح يقدّْسن، <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />ذُوْقن عَاوذ زِي لْبَرَكَا ن وَاوَاڒ ن أَربِّـي ذ لْقُدُوْرَاث ن زْمَان إِي د غَا يَاسن. <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />يِيْنَا مڒَا فّْغن اَبْرِيذ، وَار يدْجِي وِي ثن د غَا يَارّن غَار تُّوْبَا. مَايمِّي؟ لِأَنَّا يِيْنَا اَذ يڒِين اَم تْصلَّابن مِّيس ن أَربِّـي عَاوذ خ صَّلِيب تْعيَّابن-ث زَّاث إِ يِوْذَان.<verse eid="HEB 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7" />شُوْف، مڒَا ثَمُوْرْث يشَّاث خَاس ونْࢲَار اَطَّاس نتَّاث ثْسسّ تِيشّ ثَفدْجَاحْث، أَتَاف اَذ تَاوِي يجّن ن لْبَرَكَا زِي أَربِّـي. <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />وَلَكِن مڒَا ثَمُوْرْث نِّي ثْسغْمَاي-د غِير يسنَّانن ذ ثْزݣّْوَارْث، أَتَاف نتَّاث ذ وَالُو اَقَات ذِي لْخَطَر اَذ تْوَانْعڒ، أَڒ ونݣَّارُو اَت سْحَرْقن س ثْمسِّي.<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />آي يمْعِيزّن ينُو، وَاخَّا نسَّاوَاڒ اَمُّو نشِّين متْأَكدِّين زَّايْوم يعْنِي خ ثْمسْڒَايِين ثِصبْحَانِين إِي زِي غَا تْنجْمم. <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />إِيوَا أَربِّـي، مَا يتِيشّ ڒْحَقّ مَا لَّا؟ وَاه، أَربِّـي وَار يتتُّو شَا ڒْخذْمث نْوم ذ ڒمْحِبّث نِّي ذَاس د ثْسظْهَارم وَامِي ثْعَاوْنم صَّالِحِين. أُو عَاذ تݣّم مَانَايَا. <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />نخْس اَذ تْحَوْڒم كنِّيو س وُوْڒ كُڒ يجّن اَم قْبڒ بَاش اَذ تِيڒِيم كنِّيو متْأَكدِّين ذِي لْأَمَال نْوم اَڒ ونݣَّارُو. <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />وَار نخْس شَا اَذ تْعݣْزم. ئِتْخصَّا اَذ تِيڒِيم اَم يِنِّي يتْوَارَاثن س صّْبَر ذ لْإِيمَان نْسن خ ثْمسْڒَايِين نِّي إِي زِي ثن يوْعذ <char style="it">أَربِّـي</char>.<verse eid="HEB 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />شُوْف، وَامِي أَربِّـي يوْعذ بْرَاهِيم <char style="it">خ ڒْعَهذ نِّي</char>، ئِجُّوْدْج أَربِّـي اَذ يشّ يخف نّس. مَايمِّي؟ لِأَنَّا وَار ذِنِّي حَدّ يمْغَر كْتَار زِي أَربِّـي. <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />ينَّا-ٱس: &lt;نش جُّوْدْجغ قَا اَش بَرْكغ س يِجّن ن لْبَرَكَا ثمْغَر، أَذ سمْغَارغ دُّوْرِّيث نّش.&gt; <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />إِيوَا اَمُّو وَامِي يرَاجَا بْرَاهِيم س يِجّن ن صّْبَر يُوْوض-اَس-د مِين زِي ث يوْعذ أَربِّـي.<verse eid="HEB 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 6:16" />لِأَنَّا يوْذَان تْجُوْدْجن س يِجّن ذ اَمقّْرَان زَّايْسن. أُو س يِجّن ن ثْجَادْجِيث اَذ حَقّن مَارَّا لْقَدِيَاث نْسن اَذ كمّْڒنْت. <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />خ مَانَايَا يضْمن أَربِّـي مَانَاينِّي س يِجّن ن ثْجَادْجِيث إِ يِنِّي إِي غَا يوَارْثن مِين زِي ثن يوْعذ. يعْنِي يخس اَذَاسن د يسظْهَار مْلِيح طَّبِيعَا ن لْغَرَض نّس عمَّارْص اَذ تْوَابدّڒ. <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />ثْنَاين ن ثْمسْڒَايِين-أَ وَار تْوَابدِّيڒنْت شَا،<note caller="+" style="f"><char style="fr" closed="false">6‏.18 </char><char style="ft" closed="false">مِين عْنَانْت ثْنَاين ن ثْمسْڒَايِين-أَ؟ يعْنِي مِين يوْعذ ذ مِين خَاس يجُّوْدْج.</char></note> أَربِّـي وَار يزمَّر اَخَاسنْت يسْخَرّق. زِي ثْنَاين ن ثْمسْڒَايِين-أَ اَزَّايْسنْت إِي غَا نتْوَاشجّع نشِّين إِي نَرْوڒ بَاش اَغَارس نْنُوْفَّر. زَّايْسنْت إِي غَا نطّف س جّْهذ ذِي لْأَمَال إِي ذَانغ يتْوَابشَّرن. <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />لْأَمَال-أَ يتِيڒِي غَارْنغ اَم يِجّن ن ؤُڒِيزِيم ن وغَرَّابُو ن ڒَعْمَار نّغ، يرْسق س جّْهذ وَار يضدْجق. يُوْذف لْأَمَال-أَ يعْذُو غَار ذفَّار ن اَرّْوَاق ن وخَّام اَمْقدّس اَطَّاس. <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />ذݣ ومْشَان نِّي يُوْذف عِيْسَى ذِنِّي ذ اَمزْوَارُو عْلَاحْسَاب نشِّين، ئِذْوڒ ذ ڒفْقِي اَمقّْرَان إِ ڒبْدَا اَمشْنَاو لْفِرْقَا نِّي ن ڒفْقِي ؤُمِي قَّارن مَلِكِيصَادِق.<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s">لْفِرْقَا ن ڒفْقِي اَمقّْرَان مَلِكِيصَادِق</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />شُوْف، مَلِكِيصَادِق نِّي تُوْغَاث نتَّا ذ اَزدْجِيذ ن ثنْدِينْت ن سَالِيم<note caller="+" style="f"><char style="fr" closed="false">7‏.1 </char><char style="ft" closed="false">ثَنْدِينْت ن سَالِيم نتَّاث ذ ثَنْدِينْت ن لْقُدْس.</char></note> ذ ڒفْقِي ن سِيذِي أَربِّـي يُوْعْڒَان. ئِرُوْح يمڒْقَا اَك بْرَاهِيم يبَرك-يث. مَانَايَا يوْقع وَامِي د يتْروَّاح بْرَاهِيم زِي ڒْحَرْب نِّي إِي ذِي يغْڒب يزدْجِيذن. <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />يُوْشَا-ٱس بْرَاهِيم إِ مَلِكِيصَادِق ڒَعْشُوْر، عشْرَا ذِي مِيَّا زِي مَارَّا. ذ اَمزْوَارُو ڒْمَعْنَا ن يِيسم-أَ ن مَلِكِيصَادِق يخس اَذ يِينِي &lt;أَزدْجِيذ ن صُّلْح.&gt; أُو عَاوذ نتَّا ذ لْمَلِك ن ثنْدِينْت ن سَالِيم يعْنِي ذ اَزدْجِيذ ن ڒهْنَا. <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />وَار غَارس نْتِيف لَّا بَابَاس لَّا يمَّاس لَّا ڒجْذُوْذ نّس. وَار غَارس نْتِيف اَمزْوَارُو ن ڒِيَّام نّس ؤُڒَا ذ اَنݣَّارُو ن ثُوْذَارْث نّس. نتَّا يتْشَابَّاه ذِي مِّيس ن أَربِّـي، ئِدَّر اَم ڒفْقِي اَمقّْرَان إِ ڒبْدَا. <verse eid="HEB 7:3" /><verse number="4" style="v" sid="HEB 7:4" />إِيوَا فكَّرث نتَّا مشْحَاڒ ذ اَمقّْرَان، وَاخَّا ذ جدِّيثْنغ اَمقّْرَان بْرَاهِيم يُوْشَا-ٱس ڒَعْشُوْر، عشْرَا ذِي مِيَّا زِي مَارَّا اَݣْڒَا نِّي إِݣ يرْبح زݣ يزدْجِيذن نِّي!<verse eid="HEB 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 7:5" />ذِنِّي عَاوذ يجّن ن ڒُوْصِيّث ذِي شَّرِيعَا ن مُوْسَى تْوصَّا يِنِّي يدْجَان ذ ڒْفُقَهَا زِي أَيث-لَاوِي اَذ يْسِين ڒَعْشُوْر زݣ يِوْذَان يعْنِي زِي أَيثْمَاثْسن، وَاخَّا ؤُڒَا ذ أَيثْمَاثْسن يجِّي-ثن-د جدِّيثْسن اَمقّْرَان بْرَاهِيم. <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />وَلَكِن اَرْيَاز-أَ مَلِكِيصَادِق وَار يدْجِي شَا زِي أَيث-لَاوِي، ئِيْسِي ڒَعْشُوْر زِي بْرَاهِيم أُوْشَا مَلِكِيصَادِق يبَرك بْرَاهِيم ونِّي ؤُمِي غَار دْجَان لْوُعُوْد. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />أُو بْڒَا شّكّ ونِّي اَمقّْرَان اَذ يُوْش لْبَرَكَا إِ ونِّي اَمزْيَان. <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />أَيث-لَاوِي إِݣ يكسِّين ڒَعْشُوْر يعْنِي نِثْنِي ذ يوْذَان عَادِي تْمتَّان. وَلَكِن مَلِكِيصَادِق إِݣ ييْسِين ڒَعْشُوْر نِّي يشهّذ خَاس لْكِتَاب بلِّي نتَّا يدَّر. <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />إِيوَا نْزمَّر أَ نِينِي لَاوِي نتَّا س يِيخف نّس إِي يكسِّي ڒَعْشُوْر زݣ يِوْذَان، يسّكّ-يث خ وفُوْس ن بْرَاهِيم غَار مَلِكِيصَادِق لِأَنَّا بْرَاهِيم نتَّا ذ جدِّيس اَمقّْرَان. <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />مَامّش مَانَايَا؟ وَامِي بْرَاهِيم يمڒْقَا اَك مَلِكِيصَادِق، تُوْغَا لَاوِي عَاذ غَار ذَاخڒ ن دَّات ن بْرَاهِيم يعْنِي جدِّيس اَمقّْرَان.<verse eid="HEB 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />إِذن، مَعْلِيك شّْغڒ نِّي إِي خدّْمن ڒْفُقَهَا ن أَيث-لَاوِي وَار ذَاس ينْقِيس وَالُو، مَايمِّي عَاذ تُوْغَا غَا نحْذَاج اَذ د يَاس يجّن ن ڒفْقِي نّغْنِي اَمشْنَاو لْفِرْقَا ن مَلِكِيصَادِق، مَاشِي زِي لْفِرْقَا نِّي <char style="it">عَادِي</char> ن هَارُوْن <char style="it">ن أَيث-لَاوِي</char>؟ <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />أُو شُوْف، مڒَا يبدّڒ شّْغڒ نِّي إِي خدّْمن ڒْفُقَهَا ن أَيث-لَاوِي اَتَاف وَا لَابُد اَذ تْبدّڒ عَاوذ شَان ڒْحَاجث ذِي شَّرِيعَا. <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />لِأَنَّا ونِّي إِي خف نسَّاوَاڒ يعْنِي عِيْسَى نتَّا يُوْسَا-د زِي ثقْبِيڒْث نّغْنِي <char style="it">مَاشِي زِي ثقْبِيڒْث ن أَيث-لَاوِي</char>. زِي ثقْبِيڒْث نّس عمَّارْص وَار يخْذِيم شَان يِجّن ذ ڒفْقِي غَار ڒْمذْبَاح. <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />لِأَنَّا نسّن سِيذِيثْنغ يُوْسَا-د زِي ثقْبِيڒْث ن أَيث-يَهُوْذَا. عمَّارْص مَا ينَّا مُوْسَى اَذ د فّْغن ڒْفُقَهَا زِي ثقْبِيڒْث نِّي.<verse eid="HEB 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15" />ڒخُّو مَارَّا مَانَايَا يتْوَاظْهَار-د مْلِيح وَامِي د يمظْهَار يجّن ن ڒفْقِي نّغْنِي، <char style="it">يعْنِي ذ عِيْسَى،</char> اَمشْنَاو لْفِرْقَا ن مَلِكِيصَادِق. <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />يعْنِي مَاشِي عْلَاحْسَاب يجّن ن ڒُوْصِيّث خ ڒجْذُوْذ نّس زِي شَّرِيعَا إِي ث يَارِّين ذ ڒفْقِي؛ لَّا، نتَّا ذ ڒفْقِي عْلَاحْسَاب جّْهذ ن ثُوْذَارْث نّس عمَّارْص اَذ تفْنَا. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />أَقَا يشهّذ خَاس لْكِتَاب: &lt;شك ذ ڒفْقِي إِ ڒبْدَا اَمشْنَاو لْفِرْقَا ن مَلِكِيصَادِق.&gt;<verse eid="HEB 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 7:18" />ڒُوْصِيّث نِّي ذ ثَقْذِينْت ثتْوَابدّڒ وَامِي ثتْوَاحْسَاب ثضْعف بْڒَا نّْفَع. <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />ئِفّغ-د يجّن لْأَمَال حْسن <char style="it">زِي ڒُوْصِيّث نِّي</char>، زَّايس إِي غَا نْقَارّب غَار أَربِّـي ڒَاحقَّاش شَّرِيعَا ن مُوْسَى وَار د تَارِّي ؤُڒَا ذ يجّن ڒْحَاجث وَار ذَايس بُو ڒْعِيب.<verse eid="HEB 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20" />
    <char style="it">لْأَمَال-أَ</char> وَانِيتَا مَاشِي وَاحْذس، أَكِذس يجّن ن ثْجَادْجِيث. يِنِّي يذوْڒن قْبڒ ذ ڒْفُقَهَا اَرِّين-ثن ذ ڒْفُقَهَا بْڒَا ثْجَادْجِيث. <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />وَلَكِن عِيْسَى يَارِّي-ث أَربِّـي ذ ڒفْقِي س يِجّن ن ثْجَادْجِيث وَامِي ذَاس ينَّا: &lt;أَقَا سِيذِي أَربِّـي يجُّوْدْج أُو عمَارْص اَذ يبدّڒ اَرَّاي نّس، ينَّا-ٱس قَا شك ذ ڒفْقِي إِ ڒبْدَا.&gt; <verse eid="HEB 7:21" /><verse number="22" style="v" sid="HEB 7:22" /><char style="it">ثْجَادْجِيث نِّي ن أَربِّـي</char> ذ نتَّاث إِݣ يَارِّين عِيْسَى اَذ يضمّن يجّن ن ڒْعَهذ حْسن <char style="it">زِي ڒْعَهذ نِّي اَقْذِيم</char>.<verse eid="HEB 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23" />ڒْفُقَهَا نِّي ن أَيث-لَاوِي نِثْنِي اَطَّاس إِذْسن، مَايمِّي؟ لِأَنَّا ڒْموْث وَار ثن تجِّي شَا اَذ دُوْمن ذِي ڒْخذْمث نْسن. <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />وَلَكِن عِيْسَى ڒْخذْمث نّس ن ڒفْقِي اَذ تقِّيم وَار تْوَاكِّيس شَا لِأَنَّا نتَّا يتْدُوْمَا إِ ڒبْدَا. <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />خ مَانَايَا يِنِّي زَّايس يتْقَارَّابن غَار أَربِّـي يزمَّر عِيْسَى اَثن يسنْجم إِ ڒبْدَا. مَايمِّي؟ لِأَنَّا نتَّا يدَّر إِ ڒبْدَا اَذَايْسن يتْشَفَاع.<verse eid="HEB 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26" />شُوْف، ئِجّن ن ڒفْقِي اَمقّْرَان اَم وَانِيتَا ذ نتَّا إِي نحْذَاج. نتَّا عَظِيم، بْڒَا ڒْعِيب، ئِصْفَا، ئِنعْزڒ زݣ يِوْذَان إِي ݣِّين ڒْمُعْصِيّث، ئِتْوَاسمْغَار يُوْعْڒَا خ يجنَّاثن. <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />نتَّا مَاشِي اَم ڒْفُقَهَا نِّي نّغْنِي يمقّْرَانن تحْذَاجَان نِثْنِي اَذ قدّْمن دْبِيحَاث كُڒ نْهَار يعْنِي خ ڒْمُعْصِيَاث نْسن أُو منْبَعْد خ ڒْمُعْصِيَاث ن يِوْذَان. مَايمِّي؟ لِأَنَّا يݣَّا مَانَايَا <char style="it">عِيْسَى</char> يشْتن ن ثْوَاڒَا إِ ڒبْدَا قَاع وَامِي يقدّم يخف نّس ذ لْفِدْيَا خ يِوْذَان. <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />لِأَنَّا شَّرِيعَا ن مُوْسَى تَارَّا يرْيَازن س ضُّوْعف نْسن اَذ يڒِين ذ ڒْفُقَهَا يمقّْرَانن. وَلَكِن أَربِّـي س ثْجَادْجِيث نّس إِي د يُوْسِين منْبَعْد إِ شَّرِيعَا ن مُوْسَى يَارَّا مِّيس ذ ڒفْقِي اَمقّْرَان يذْوڒ نتَّا بْڒَا ڒْعِيب قَاع إِ ڒبْدَا.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s">سِيذِيثْنغ عِيْسَى ذ ڒفْقِي اَمقّْرَان ن يِجّن ن ڒْعَهذ ذ جْذِيذ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />إِيوَا، مِين يدْجَان مُهِم ذِي مِين نقَّار؟ يعْنِي يجّن ن ڒفْقِي اَمقّْرَان اَم ونِّي إِي خف نسِّيوڒ اَقَاث غَارْنغ نشِّين. ئِقِّيم نتَّا خ وفُوْسِي ن لْعَرْش ن أَربِّـي سُبْحَانَا وَتَعَالَى ذݣ وجنَّا. <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />نتَّا يخدّم ذِي ثمْزِيذَا نِّي يعْنِي ذ اَقِيضُوْن نِّي ن صَّح لْعَظِيم إِي يݣَّا سِيذِي أَربِّـي مَاشِي بْنَاذم.<verse eid="HEB 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3" />شُوْف، كُڒ ڒفْقِي اَمقّْرَان تِيخْضَارن-ث بَاش اَذ يقدّم صّذْقث ذ دْبِيحَاث. خ مَانَايَا وَا لَابُد ڒفْقِي وَانِيتَا <char style="it">يعْنِي ذ عِيْسَى</char> اَذ يقدّم شَان ن ڒْحَاجث. <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />مَعْلِيك يدْجَا نتَّا ذِي ثْمُوْرْث-أَ، أَتَاف وَار يزمَّر اَذ يخْذم ذ ڒفْقِي لِأَنَّا ذَانِيتَا ڒْفُقَهَا ن أَيث-لَاوِي يتْقدَّامن صّذْقَاث عْلَاحْسَاب شَّرِيعَا ن مُوْسَى. <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />يِيْنَا خدّْمن شّْغڒ نْسن ذݣ يِجّن ن ثمْزِيذَا نتَّاث اَم يِجّن ن ثِيڒِي يتمْشَابَّاهن ذِي مِين يدْجَان ذݣ وجنَّا. خ مَانَاينِّي أَربِّـي يعْڒم إِ مُوْسَى وَامِي يبْذَا يسْبدَّا اَقِيْضُوْن نِّي اَمقّْرَان ينَّا-ٱس: &lt;فكَّر بَاش اَذ تݣّذ مَارَّا مِين ذَاش خَطّغ ذِي لْخَرِيطَا نِّي ذݣ وذْرَار.&gt; <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />وَلَكِن شّْغڒ نِّي ن ڒفْقِي إِي ذَاس يُوْشَا إِ عِيْسَى يمْغَار اَطَّاس خ شّْغڒ نِّي اَقْذِيم ن ڒْفُقَهَا نّغْنِي. أُو ڒْعَهذ-أَ إِي خف يتْشَفَاع نتَّا يمْغَار اَطَّاس خ ونِّي اَقْذِيم لِأَنَّا يبدّ خ يِجّن ن دْسَاس ن لْوُعُوْد إِي يدْجَان حْسن.<verse eid="HEB 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7" />مَعْلِيك ڒْعَهذ نِّي اَمزْوَارُو وَار ذَاس ينْقِيس وَالُو، أَتَاف وَار رزُّوْن شَا خ وِيس ثْنَاين. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />لِأَنَّا أَربِّـي يُوْفَا يوْذَان نِّي ذ ينقْسِيْين وَامِي ينَّا:</para>
  <para style="b" vid="HEB 8:8" />
  <para style="q1" vid="HEB 8:8">&lt;أَقَا تَاسن-د وُوْسَّان، يقَّار-يث سِيذِي أَربِّـي،</para>
  <para style="q1" vid="HEB 8:8">أَذَايْسن ݣّغ يجّن ن ڒْعَهذ ذ جْذِيذ</para>
  <para style="q1" vid="HEB 8:8">إِ أَيث-إِسْرَائِيل ذ أَيث-يَهُوْذَا.<verse eid="HEB 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 8:9" />مَاشِي اَم ڒْعَهذ نِّي إِي ݣِّيغ اَك ڒجْذُوْذ نْسن،</para>
  <para style="q1" vid="HEB 8:9">وَامِي ثن طّْفغ زݣ يفَاسّن نْسن،</para>
  <para style="p" vid="HEB 8:9">أَثن سُوْفْغغ زِي ثْمُوْرْث ن مِصْرَا.</para>
  <para style="q1" vid="HEB 8:9">لِأَنَّا نِثْنِي وَار طِّيفن شَا ذِي ڒْعَهذ ينُو،</para>
  <para style="q1" vid="HEB 8:9">أُوْشَا نش سمْحغ ذَايْسن، يقَّار-يث سِيذِي أَربِّـي.<verse eid="HEB 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 8:10" />ذ وَانِيتَا ذ ڒْعَهذ إِي غَا ݣّغ اَك أَيث-إِسْرَائِيل</para>
  <para style="q1" vid="HEB 8:10">منْبَعْد إِ ڒْوقْث نِّي، يقَّار-يث سِيذِي أَربِّـي.</para>
  <para style="q1" vid="HEB 8:10">أَذَاسن سِيذْفغ ڒُوْصِيَاث ينُو ذِي ڒَعْقُوْڒَاث نْسن،</para>
  <para style="q1" vid="HEB 8:10">أَغَارْسن يڒِينْت ذ ثِيْرَا خ وُوْڒَاون نْسن.</para>
  <para style="q1" vid="HEB 8:10">أَذ يڒِيغ ذ أَربِّـي نْسن اَذ يڒِين ذ شَّعْب ينُو.<verse eid="HEB 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 8:11" />مَاشِي كُڒ يجّن اَذَاس يسڒْمذ إِ وَاجَّار نّس،</para>
  <para style="q1" vid="HEB 8:11">نِغ إِ وُوْمَاس اَذَاس يِينِي: سّن سِيذِي أَربِّـي.</para>
  <para style="p" vid="HEB 8:11">لَّا، مَارَّا إِذْسن اَذَايِي سّْنن نش،</para>
  <para style="q1" vid="HEB 8:11">س ومزْيَان نْسن اَڒ ومقّْرَان نْسن.<verse eid="HEB 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 8:12" />أَقَا نش اَذَاسن غْفَرغ إِ شَّرّْ نْسن،</para>
  <para style="q1" vid="HEB 8:12">ڒْمُعْصِيَاث نْسن وَار ذَايْسنْت تْفكَّرغ شَا عَاذ.&gt;<verse eid="HEB 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13" />وَامِي يسِّيوڒ أَربِّـي خ يِجّن ن ڒْعَهذ ذ جْذِيذ، صَافِي ونِّي اَمزْوَارُو يسْبطَّاڒ-يث. أُو ونِّي إِݣ يتْوَاسْبطَّاڒن ڒخُّو يذوّڒ ذ اَقْذِيم، أَتَاف ذغْيَا اَذ يتْوَاكّس وَار يتْغِيمِي شَا.<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s">لْعِبَادَا ثَمزْوَارُوْت ذݣ وقِيْضُوْن اَمقّْرَان</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />ڒْعَهذ نِّي اَمزْوَارُو تُوْغَا غَارس شَان ن لْقَوَانِين ن لْعِبَادَا أُو ذ يجّن ن ومْشَان اَمْقدّس ذِي دُّنشْت-أَ. <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />يعْنِي سوْجَاذن يجّن ن وقِيْضُوْن اَمقّْرَان <char style="it">ذَايس ثْنَاين ن يخَّامن</char>. ذݣ وخَّام اَمزْوَارُو ݣِّين ذَايس ڒْقنْدِيڒ ذ طَّبْڒَا مَانِي سْرُوْسَان اَغْرُوْم نِّي يتْقدَّامن ذ صّذْقث إِ أَربِّـي. أَخَّام نِّي قَّارن-اَس &lt;أَخَّام اَمْقدّس.&gt; <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />ثُمَّا ذِنِّي يجّن ن اَرّْوَاق،<note caller="+" style="f"><char style="fr" closed="false">9‏.3 </char><char style="ft" closed="false">أَرّْوَاق-أَ نتَّا ذ اَرّْوَاق وِيس ثْنَاين.</char></note> غَار ذفَّار نّس ذِنِّي يج ن وخَّام وِيس ثْنَاين قَّارن-اَس &lt;أَخَّام اَمْقدّس اَطَّاس.&gt; <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />ذَايس ڒْمجْمَار ن تْبَخُوْر يشلّل س دّْهب، أُو ذ تَابُوْت ن ڒْعَهذ مَارَّا يغزْذِيسن نّس أُو ذ ثِيسِي نّس شلّْلن س دّْهب. ذِي <char style="it">تَابُوْت-أَ</char> ذَايس اَقْنُوْش يتْوَاصنّع س دّْهب، أَقْنُوْش نِّي ذَايس اَغْرُوْم ؤُمِي قَّارن لْمَنَّا. <char style="it">تَابُوْت-أَ</char> عَاوذ ذَايس ثَغْرِيث ن هَارُوْن ثْنوَّار، ذ ثڒْوِيحِين ن عشْرَا ن ڒُوْصِيَاث. <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />ثَقبَّارْث ن تَابُوْت-أَ خَاس ثْنَاين ن لْمخْلُوْقَاث ن لْعَظَمَا ݣِّين اَم مُوْنِيكُوْث غَارْسن اَفْرِيون. ثِيڒِي ن وَافْرِيون نْسن ثْغطَّا ثَقبَّارْث-أَ ثَانِيتَا ن اَرَّاحْمث. وَلَكِن نشِّين ذِي ڒْوقْث-أَ وَار نْزمَّر أَ نْوصّف ثِمسْڒَايِين-أَ ثَا س ثَا.<verse eid="HEB 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6" />وَامِي سْوجْذن مَارَّا ثِمسْڒَايِين-أَ اَمُّو، تُوْغَا تَاذْفن ڒْفُقَهَا غَار وخَّام اَمزْوَارُو كُڒ نْهَار ذِي لْأَوْقَات نّس، تݣّن شّْغڒ نْسن. <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />وَلَكِن اَخَّام نِّي وِيس ثْنَاين يتْرَاح ذِنِّي غِير ڒفْقِي اَمقّْرَان، ئِجّن ن ثْوَاڒَا ذِي لْعَام أُو صَافِي. وَا لَابُد اَكِذس يَاوِي شَا ن يذَامّن بَاش اَثن يقدّم خ يِيخف نّس أُو خ دّْنُوْب إِي ݣِّين شَّعْب بْڒَا مَا ثنْت سّْنن. <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />مِين ذَانغ د يسْبِيّن أَرُّوْح يقدّْسن ذِي مَانَايَا؟ ئِسْبِيّن-اَنغ-د مڒَا عَاذ يقِّيم وقِيْضُوْن نِّي اَمقّْرَان، أَتَاف وَار ينُّوْرْزم شَا وبْرِيذ غَار مِين يدْجَان ذ اَمْقدّس اَطَّاس. <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />مَارَّا مَانَايَا يتِيشّ يجّن لْمِثَال إِ ڒْوقْث-أَ إِي ذِي ندْجَا ڒخُّو. شّْغڒ نِّي إِي تُوْغَا تݣّن ذِنِّي خْمِي تْقدَّامن صّذْقث ذ دْبِيحَاث وَار يزمَّر شَا اَذ يسِّيصْفَا ضَّمِيڒ ن ونِّي يعبّْذن. <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />مَانَايَا غِير ذَايس شَان ن لْقَوَانِين ن شَّرِيعَا خ لْمَكْلَا ذ ثْسسِّي ذ ڒُوْضُو. لْقَوَانِين-أَ وَار دْجِين شَا خ وُوْڒَاون ن بْنَاذم، خدّْمن حتَّا ڒْوقْث ن ڒْعَهذ ذ جْذِيذ أُو صَافِي.<verse eid="HEB 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />فَا لْمَسِيح وَامِي د يحْضَار ذ ڒفْقِي اَمقّْرَان ن ثْمسْڒَايِين-أَ إِي د يُوْسِين، يعْنِي يُوْذف اَقِيضُوْن نِّي يدْجَان عَظِيم وَار ذَاس ينْقِيس وَالُو وَار ث بْنِين شَا يفَاسّن ن بْنَاذم، وَار يدْجِي شَا زِي مِين د يتْوَاخڒْقن ذِي دُّنشْت-أَ. <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />يُوْذف يجّن ن ثْوَاڒَا أُو صَافِي غَار وخَّام اَمْقدّس اَطَّاس. نتَّا وَار يُوْذِيف شَا س يذَامّن ن يغَايْذن نِغ ذ ئِينْدُوْزن؛ لَّا، يُوْذف س يذَامّن نّس نِّيث يخدْجس خَانغ لْفِدْيَا بَاش أَ ننْجم إِ ڒبْدَا. <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />شُوْف، ئِذَامّن ن يغَايْذن ذ ئِينْدُوْزن ذ يِيغّذ<note caller="+" style="f"><char style="fr" closed="false">9‏.13 </char><char style="ft" closed="false">ئِغّذ نتَّا ذ ثْنِيفسْث.</char></note> ن ثْفُوْنَاسْت تْرُوْشَّان زَّايْسن يِنِّي يخنْزن يسِّيصْفَا-ثن بَاش اَذ ذوْڒن ذ يمنْقَاوِيْين. <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />مڒَا اَمنِّي، مشْحَاڒ إِي ذَانغ غَا سِّيصْفَان يذَامّن ن لْمَسِيح كْتَار! نتَّا يرُوْح س أَرُّوْح نِّي يتْدُوْمَان إِ ڒبْدَا يقدّم يخف نّس بْڒَا ڒْعِيب إِ أَربِّـي، ئِذَامّن نّس اَذَانغ سِّيصْفَان ضَّمِير نّغ زِي سَّايِأَث بَاش أَ نعْبذ أَربِّـي يدَّرن.<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />فَلِيهَذَا نتَّا لْمَسِيح يتْشَفَاع جَارَانغ ذ أَربِّـي س يِجّن ن ڒْعَهذ ذ جْذِيذ بَاش يِنِّي ؤُمِي د يڒَاغَا أَربِّـي اَتَاف اَذ اَوِين لْوَارث إِي زِي ثن يوْعذ يتْدُوْمَان إِ ڒبْدَا. لِأَنَّا لْمَسِيح يمُّوْث ذ لْفِدْيَا حمَا اَذَاسن يضْڒق اَذ يڒِين حُرّ زِي ڒْمُعْصِيَاث إِي ݣِّين سْوَادَّاي إِ ڒْعَهذ نِّي اَمزْوَارُو.<verse eid="HEB 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16" />شُوْف، عْلَاحْسَاب لْوَصِيَا لَابُد اَذ د اَوِين شْهَادَا ن لْوَفَات ن ونِّي يݣِّين لْوَصِيَا. <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />لِأَنَّا لْوَصِيَا وَار ثْصدْجح شَا إِلَّا مڒَا يمُّوْث بَاب نّس. مڒَا عَاذ يدَّر بَاب نّس يعْنِي ونِّي إِي ت يُوْرِين اَتَاف وَار ثْصدْجح شَا. <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />خ مَانَايَا تُوْغَا وَاخَّا ذ ڒْعَهذ اَمزْوَارُو وَار يصدْجح شَا حتَّا وَامِي ؤُزّْڒن يذَامّن. <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />أَقَا نَّبِي مُوْسَى وَامِي يغْرَا كُڒ ڒُوْصِيّث إِ مَارَّا شَّعْب، ثُمَّا ييْسِي يذَامّن ن ئِينْدُوْزن ذ يغَايْذن يخلّط-يثن اَك وَامَان، ثُمَّا يرُوْشّ زَّايْسن لْكِتَاب س يِيخف نّس ذ مَارَّا شَّعْب س ثَاضُوْفْث ثَزݣّْوَاغْث ذ وزُوْي.<note caller="+" style="f"><char style="fr" closed="false">9‏.19 </char><char style="ft" closed="false">زُوْي نتَّا ذ يجّن ن اَرْبِيع. غطّْسن-ث ذݣ يذَامّن تْرُوْشَّان زَّايس.</char></note> <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />ينَّا-ٱسن قَا يِيْنَا ذ يذَامّن ن ڒْعَهذ إِي ذَاوم يُوْمَر أَربِّـي اَذ تݣّم. <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />أَمنِّي عَاوذ يرُوْشّ اَقِيضُوْن اَمقّْرَان س يذَامّن-أَ ذ مَارَّا ڒقْشُوْع إِي ذَايس سْتَعْمَاڒن ذِي لْعِبَادَا. <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />أُو ذ صَّح عْلَاحْسَاب شَّرِيعَا ن مُوْسَى عْڒَاين مَارَّا ثِمسْڒَايِين اَذ تْوَاسِّيصْفَانْت س يذَامّن. أُو بْڒَا مَا ٱذ اَزّْڒن يذَامّن اَتَاف ڒْمُعْصِيَاث وَار تْوَاغْفِيرنْت شَا.<verse eid="HEB 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />إِذن، ثِمسْڒَايِين-أَ يتْشَابَّاهن ذِي ثْمسْڒَايِين نِّي ن وجنَّا تُوْغَا تْوَاسِّيصْفَانْت س دْبِيحَاث. وَلَكِن ثِمسْڒَايِين نِّي س يِيخف نْسنْت ن وجنَّا لَّا؛ تْوَاسِّيصْفَانْت نِثنْتِي س يِجّن ن نُّوْع ن دْبِيحَاث حْسن زِي ثِنِّي نّغْنِي. <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />شُوْف، لْمَسِيح وَار يُوْذِيف شَا اَخَّام نِّي اَمْقدّس اَطَّاس إِي يبْنَان س يفَاسّن ن بْنَاذم يتْشَابَّاهن وَاهَا ذݣ ونِّي ن صَّح؛ لَّا، نتَّا يُوْذف ذݣ وجنَّا نِّيث اَذ يحْضَار زَّاث إِ أَربِّـي عْلَاحْسَاب نشِّين. <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />وَار يُوْذِيف شَا ذݣ وجنَّا بَاش اَذ يتْقدَّام يخف نّس اَطَّاس ن ثْوَاڒَاثِين اَمشْنَاو مَامش يتݣّ ڒفْقِي نِّي اَمقّْرَان خْمِي يتَاذف كُڒ لْعَام غَار وخَّام اَمْقدّس اَطَّاس س يذَامّن مَاشِي نّس. <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />مَعْلِيك اَمنِّي تُوْغَا اَتَاف لَابُد لْمَسِيح يتْوَاعدَّاب اَطَّاس ن ثْوَاڒَاثِين زݣ وَامِي تْوَاخْڒق دُّنشْت-أَ. وَلَكِن لَّا، ئِهْوَا-د نتَّا يجّن ن ثْوَاڒَا اَڒ ونݣَّارُو ن زْمَانَاث بَاش اَذ يسْبطّڒ ڒْمُعْصِيَاث وَامِي يقدّم يخف نّس ذ دْبِيحث. <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />ڒْموْث يتْمتَّا-ت بْنَاذم يجّن ن ثْوَاڒَا، ثُمَّا يذفَّار-يت لْحِسَاب ذ لْعِقَاب. <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />أَمُّو لْمَسِيح، يتْوَاقدّم ذ دْبِيحث يجّن ن ثْوَاڒَا بَاش اَذ يَارْبُو ڒْمُعْصِيَاث ن وَاطَّاس ن يِوْذَان. ثُمَّا اَذ د يهْوَا وِيس مَرّْثَاين.<note caller="+" style="f"><char style="fr" closed="false">9‏.28 </char><char style="ft" closed="false">سِيذِيثْنغ عِيْسَى اَذ د يهْوَا وِيس مَرّْثَاين غَار دُّنشْت-أَ ذِي نْهَار اَنݣَّارُو.</char></note> مَايمِّي؟ مَاشِي عْلَاحْسَاب ڒْمُعْصِيّث ن يِوْذَان عَاوذ؛ لَّا، أَذ د يهْوَا بَاش اَذ يسنْجم يِنِّي إِي ث يتْرَاجَان.<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="s">سِيذِيثْنغ عِيْسَى إِݣ يسنْجَامن مَاشِي ذ شَّرِيعَا</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />شُوْف، شَّرِيعَا ن مُوْسَى نتَّاث غِير ذ يجّن ن ثِيڒِي ن ثْمسْڒَايِين ثِصبْحَانِين إِي د غَا يَاسن، وَار ثدْجِي شَا نتَّاث ذ ثِمسْڒَايِين نِّي ذ صَّح. خ مَانَايَا، دْبِيحَاث نِّي ن شَّرِيعَا إِي تݣّن زِي لْعَام غَار لْعَام وَار زمَّرنْت عمَّارْص اَذ سِّيصْفَانْت يِنِّي يتْقَارَّابن غَار أَربِّـي اَذ يڒِين بْڒَا ڒْعِيب. <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />دْبِيحَاث نِّي مَعْلِيك زمَّرنْت اَذ سِّيصْفَانْت، أَتَاف صَافِي سْبدّن-ثنْت نِغ لَّا؟ لِأَنَّا يِنِّي يعبّْذن اَتَاف اَذ قِّيمن ذ يمنْقَاوِيْين يجّن ن ثْوَاڒَا إِ ڒبْدَا، أَتَاف ضَّمِير نْسن وَار يتْعدِّيب شَا س ڒْمُعْصِيّث. <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />وَلَكِن دْبِيحَاث نِّي مِين عْنَانْت؟ نِثنْتِي تْفكَّارنْت-اَنغ كُڒ لْعَام س ڒْمُعْصِيّث. <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />لِأَنَّا يذَامّن ن ئِينْدُوْزن ذ يغَايْذن وَار زمَّرن شَا اَذ كّْسن ڒْمُعْصِيّث، وَار يتمْكِين شَا.<verse eid="HEB 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />خ مَانَايَا، وَامِي د يُوْسَا لْمَسِيح غَار دُّنشْت-أَ ينَّا-ٱس <char style="it">إِ أَربِّـي</char>:</para>
  <para style="q1" vid="HEB 10:5">&lt;ثسْوجْذذ-اَيِي يجّن ن دَّات،</para>
  <para style="q1" vid="HEB 10:5">وَار ثرْزُوْذ شَا دْبِيحَاث ذ صّذْقث لَّا.<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />تُوْغَا وَار ذَاش يتعْجِيب بُو ڒْحَاڒ اَذَاش سْشمْضن لْحَيَوَانَاث،</para>
  <para style="q1" vid="HEB 10:6">أَذَاش قدّْمن صّذْقث خ ڒْمُعْصِيّث.<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />أُوْشَا نِّيغ، آي أَربِّـي اَقَايِي ؤُسِيغ-د</para>
  <para style="q1" vid="HEB 10:7">اَذ ݣّغ ڒْخَاضَر نّش،</para>
  <para style="q1" vid="HEB 10:7">مَامش خَافِي يُوْرَا ذِي لْكِتَاب.&gt;<verse eid="HEB 10:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="HEB 10:8" />ذ اَمزْوَارُو ينَّا-ٱس قَا دْبِيحَاث ذ صّذْقث وَار ثنْت ثرْزُوْذ شَا شك، وَار ذَاش يتعْجِيب بُو ڒْحَاڒ اَذَاش شمْضن لْحَيَوَانَاث اَذَاش قدّْمن صّذْقث خ ڒْمُعْصِيّث. (ثِيْنَا تْقدَّامن-ثنْت عْلَاحْسَاب شَّرِيعَا.) <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />ثُمَّا ينَّا-ٱس اَقَايِي ؤُسِيغ-د اَذ ݣّغ ڒْخَاضَر نّش. يعْنِي اَذ يكّس دْبِيحَاث نِّي ثِمزْوُوْرَا اَذ يݣّ ذݣ ومْشَان نْسنْت دْبِيحث وِيس ثْنَاين <char style="it">ن لْمَسِيح</char>. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />أُو س ڒْخَاضَر نِّي نشِّين نتْوَاسِّيصْفَا س دْبِيحث ن دَّات ن عِيْسَى لْمَسِيح، ئِجّن ن ثْوَاڒَا إِ ڒبْدَا.<verse eid="HEB 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />ڒفْقِي كُڒ نْهَار يتْغِيمَا نتَّا يتݣّ شّْغڒ-أَ نّس، يعْنِي يتْقدَّام اَطَّاس ن ثْوَاڒَاثِين نّفْس ن دْبِيحَاث، وَلَكِن دْبِيحَاث نِّي وَار زمَّرنْت شَا اَذ كّْسنْت ڒْمُعْصِيّث. <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />لْمَسِيح لَّا، نتَّا يقدّم يجّن ن دْبِيحث وَاحْذس خ ڒْمُعْصِيّث يجّن ن ثْوَاڒَا إِ ڒبْدَا، أُوْشَا يقِّيم نتَّا خ وفُوْسِي ن أَربِّـي. <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />سّنِّي يقِّيم يتْرَاجَا ڒْعَذْيَان نّس اَذ يڒِين سْوَادَّاي يضَارن نّس. <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />لِأَنَّا يِنِّي يتْذوَّاڒن ذ صَّالِحِين يسِّيصْفَا-ثن ذݣ يِجّن ن ثْوَاڒَا إِ ڒبْدَا س يِجّن ن دْبِيحث أُو صَافِي بَاش اَذ يڒِين بْڒَا ڒْعِيب.<verse eid="HEB 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15" />فَا يشهّذ-اَنغ أَرُّوْح يقدّْسن خ مَانَايَا. ذ اَمزْوَارُو يقَّار:<verse eid="HEB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />&lt;ذ وَانِيتَا ذ ڒْعَهذ إِي غَا ݣّغ اَك أَيث-إِسْرَائِيل</para>
  <para style="q1" vid="HEB 10:16">منْبَعْد إِ ڒْوقْث نِّي، ئِقَّار-يت سِيذِي أَربِّـي.</para>
  <para style="q1" vid="HEB 10:16">أَذَاسن سِيذْفغ ڒُوْصِيَاث ينُو ذݣ وُوْڒَاون نْسن،</para>
  <para style="q1" vid="HEB 10:16">أَغَارْسن يڒِينْت ذ ثِيْرَا خ ڒَعْقُوْڒَاث نْسن.&gt;<verse eid="HEB 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 10:17" />سّنِّي يَرْنِي ينَّا:</para>
  <para style="q1" vid="HEB 10:17">&lt;ڒْمُعْصِيَاث نْسن ذ سَّايِأَث نْسن وَار ذَايْسنْت تْفكَّرغ شَا عَاذ.&gt;<verse eid="HEB 10:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="HEB 10:18" />ثِيْنَا، مڒَا تْوَاغْفَرنْت مَاشِي عَاذ اَذ يقدّم شَان يِجّن دْبِيحث خ ڒْمُعْصِيّث.<verse eid="HEB 10:18" /></para>
  <para style="s">يَالَّاهث أَ نَاذْفث غَار أَربِّـي س لْإِيمَان</para>
  <para style="p">
    <verse number="19‏-20" style="v" sid="HEB 10:19-20" />إِذن فَا آي أَيثْمَا، غَارْنغ يجّن ن زْعَامث بَاش أَ نَاذف غَار ؤُخَّام اَمْقدّس اَطَّاس س يذَامّن ن عِيْسَى يعْنِي س يِجّن ن وبْرِيذ ذ جْذِيذ يدَّرن، ئِنُّوْرْزم-اَنغ وَامِي يقَّارْص اَرّْوَاق نِّي يعْنِي دَّات نّس.<note caller="+" style="f"><char style="fr" closed="false">10‏.19‏-20 </char><char style="ft" closed="false">وَامِي يمُّوْث سِيذِيثْنغ عِيْسَى خ صَّلِيب، ذِي ڒْوقْث نِّي إِݣ يقَّارْص اَرّْوَاق ذِي ثمْزِيذَا ثَمقّْرَانْت. أَرّْوَاق نِّي اَقَاث جَار ؤُخَّام اَمْقدّس ذ ؤُخَّام اَمْقدّس اَطَّاس، ذ ونِّي إِݣ يدْجَان ذ ڒْحِيض جَارَاسن. ئِمُّوْث سِيذِيثْنغ عِيْسَى أُو صَافِي ينُّوْرْزم وبْرِيذ جَار يخَّامن نِّي.</char></note> <verse eid="HEB 10:19-20" /><verse number="21‏-22" style="v" sid="HEB 10:21-22" />غَارْنغ يجّن ن ڒفْقِي اَمقّْرَان يمْغَار نتَّا يحكّم خ ثدَّارْث ن أَربِّـي. عْلَاحْسَاب ڒفْقِي-يَا إِي غَارْنغ، أَ نْقَارّبث غَار أَربِّـي س يِجّن ن وُوْڒ ذ اَشمْڒَاڒ ذ يِجّن ن تِّقث ثجْهذ. عَاوذ ؤُڒَاون نّغ اَذ يڒِين تْوَارُوْشّن بَاش ضَّمِير نّغ اَذ يتْوَاسِّيصْفَا وَار يتْعدِّيب شَا س ڒْمُعْصِيّث. أُو عَاوذ دَّات نّغ اَذ تِيڒِي تْوَاسِيڒذ س وَامَان يصْفَان. <verse eid="HEB 10:21-22" /><verse number="23" style="v" sid="HEB 10:23" />أَ نطّف بْڒَا مَا أَ نضْڒق ذِي لْأَمَال نِّي إِي خف نْشهّذ لِأَنَّا أَربِّـي إِي ذَانغ يوعْذن ذَايس تِّقث. <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />نشِّين أَ نْخمّم مْلِيح مَامّش إِي غَا نݣّ أَ نْوصَّا اَيَاوْيَا خ ڒمْحِبّث ذ لْحَسَنَاث. <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />أَ نْمُوْن اَك وَايَاوْيَا مَاشِي أَ نسْمح ذِي لْوَاجِب-أَ اَم مَامّش نُّوْمن [نِّيْمن] ڒبْعَاض ن يِوْذَان. لَّا، أَ نْشجّع اَيَاوْيَا، أُو كْتَار عَاذ خْمِي نتْوَاڒَا نْهَار ن سِيذِيثْنغ يقَارّب-د.<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />شُوْف، نشِّين مڒَا نتْعِيش س ڒْمُعْصِيّث س ڒْخَاضَر نّغ أُو نسّن لْحَقِيقَا، أَتَاف وَار غَارْنغ بُو شَان دْبِيحث اَذ تكّس ڒْمُعْصِيّث نّغ. <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />لَّا، نشِّين غِير نتْرَاجَا يجّن ن لْحِسَاب ذ لْعِقَاب س ثِيݣّْوْذِي ذ يِجّن ن ثْمسِّي ثْحدّق اَذ تشّ ڒْعَذْيَان ن أَربِّـي. <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />ونِّي تُوْغَا يخڒْفن ذِي شَّرِيعَا ن مُوْسَى، مڒَا شهْذن خَاس ثْنَاين نِغ ثْڒَاثَا ن ڒشْهُوْذ اَتَاف اَذ يمّث بْڒَا مَا ث رحْمن. <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />ئِي كنِّيو، مِين تْفكَّرم؟ مشْحَاڒ إِي غَا يِيڒِي لْعِقَاب إِݣ يسْذَاهدْج ونِّي يسحْقَارن مِّيس ن أَربِّـي، ئِسخْنز يذَامّن ن ڒْعَهذ نِّي إِي زِي يتْوَاسِّيصْفَا، يزبّڒ أَرُّوْح ن اَرْضَا! <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />أَقَا نشِّين نسّن بلِّي ذ أَربِّـي إِݣ ينَّان قَا ذ نش إِݣ يتنْتَاقَامن اَثن خدْجْسغ. <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />مڒَا يجّن حكّْمن خَاس يفَاسّن ن أَربِّـي يدَّرن، أَتَاف مَانَايَا يسَاݣّْوَاذ.<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />فَا عقْڒث خ وُوْسَّان نِّي يعْذُوْن وَامِي خَاوم د يشعْشع نُّوْر. ثصْبَارم خ يِجّن ن ؤُمنْغِي يقْسح، ثْوَاجْهَام اَعدّب. <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />ڒبْعَاض ن ثْوَاڒَاثِين تْزبَّاڒن-كنِّيو تْعدَّابن-كنِّيو، ئِوْذَان تْفُوْرُّوْجن خَاوم. ڒبْعَاض ن ثْوَاڒَاثِين تْعَاوَانم يِنِّي يتْوَاعدَّابن تْبدَّام اَكِذْسن. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />لِأَنَّا يمحْبَاس قِّيمن ذَايْوم ذݣ وُوْڒ. عَاوذ ثصْبَارم س ڒفْرَاحث وَامِي ذَاوم كّْسِين اَݣْڒَا نْوم، تُوْغَا تسّْنم عَاذ اَغَارْوم يِيڒِي يجّن ن وَاݣْڒَا حْسن زݣ ونّغْنِي، يتْدُوْمَان.<verse eid="HEB 10:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="HEB 10:35" />إِذن ٱجّث تِّقث نْوم، نتَّاث اَذَاوم د ثَاوِي يجّن ن لْأَجَر يمْغَر. <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />أَقَا يتْخصَّا اَذ تصْبَارم، مَايمِّي؟ بَاش خْمِي غَا ثݣّم ڒْخَاضَر ن أَربِّـي، أَتَاف اَغَارْوم يِيڒِي مِينْزِي إِي كنِّيو يوْعذ. <verse eid="HEB 10:36" /><verse number="37" style="v" sid="HEB 10:37" />لِأَنَّا ثقِّيم ذْرُوْسْت ن ڒْوقْث اَذ د يَاوض ونِّي إِي د يتَاسن وَار يتْعطَّاڒ شَا. <verse eid="HEB 10:37" /><verse number="38" style="v" sid="HEB 10:38" />وَلَكِن ونِّي يدْجَان نِيشَان اَذ يعِيش س لْإِيمَان. مڒَا يعْقب غَار ذفَّار اَتَاف وَار خَاس رطِّيغ شَا.<verse eid="HEB 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 10:39" />وَلَكِن نشِّين مَاشِي زݣ يِنِّي يتْعقَابن غَار ذفَّار بَاش أَ نفْنَا؛ لَّا، نشِّين زݣ يِنِّي يتَامْنن أَ نْسنْجم ڒَعْمَار نّغ.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s">لْإِيمَان ذ يِنِّي إِي زَّايس يتْعِيشن</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />فَا لْإِيمَان نتَّا ذ يجّن ن تِّقث يجهْذن ذِي مِين نتْرَاجَا، نشِّين متْأَكدِّين ذِي ثْمسْڒَايِين وَاخَّا وَار ثنْت نتْوِيڒِي شَا. <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />س لْإِيمَان-أَ إِي تْوَاشكَّرن يوْذَان ن زْمَان.<verse eid="HEB 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3" />س لْإِيمَان إِي نْفهّم قَا دُّنشْت ثتْوَاخْڒق-د س وَاوَاڒ ن أَربِّـي يعْنِي مِين ذَايس نتْوَاڒَا وَار د يكِّي شَا زِي مِين د يتْبَانن.<verse eid="HEB 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4" />س لْإِيمَان يكَّر <char style="it">نَّبِي</char> هَابِيل يقدّم يجّن ن دْبِيحث إِي زِي خَاس يَارْضَا أَربِّـي حْسن زِي ثنِّي ن <char style="it">وُوْمَاس</char> قَابِيل. عْلَاحْسَاب لْإِيمَان-أَ يتْشكَّر-يث أَربِّـي يقْبڒ-يث نتَّا نِيشَان وَامِي خَاس يسِّيوڒ أَربِّـي مْلِيح خ مِين يقدّم. أُو <char style="it">نَّبِي</char> هَابِيل س لْإِيمَان نّس نتَّا عَاذ يسَّاوَاڒ وَاخَّا يمُّوْث.<verse eid="HEB 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5" />س لْإِيمَان يكَّر <char style="it">نَّبِي</char> أَخْنُوْخ يتْوَاخْضف غَار وجنَّا حمَا وَار يتْوِيڒِي شَا ڒْموْث. وَار ث ؤُفِين شَا، ئِيْسِي-ث أَربِّـي غَارس. أُو قْبڒ مَا ٱذ يتْوَاخْضف يتْوَاشكَّر اَم يِجّن يَارْضَا خَاس أَربِّـي.<verse eid="HEB 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 11:6" />إِيوَا ؤُڒَا ذ يجّن وَار يزمَّر اَخَاس يَارطَّا أَربِّـي بْڒَا لْإِيمَان. مِينْزِي ونِّي إِي غَا يقَارّْبن غَار أَربِّـي لَابُد اَذ يَامن بلِّي نتَّا يدْجَا أُو ذ نتَّا إِݣ يتْجَزَان يِنِّي خَاس يرزُّوْن س وُوْڒَاون نْسن.<verse eid="HEB 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7" />س لْإِيمَان <char style="it">نَّبِي</char> نُوْح وَامِي ذَاس يعْڒم أَربِّـي خ ثْمسْڒَايِين نِّي وَار ثنْت ࢲْرِين يِوْذَان عمَّارْص، ئِكَّر نتَّا س يِجّن ن ثِيݣّْوْذِي ذ يِجّن ن ڒحْيَا يݣَّا اَغَرَّابُو بَاش اَذ يسنْجم أَيثْبَاب ن ثدَّارْث نّس.<note caller="+" style="f"><char style="fr" closed="false">11‏.7 </char><char style="ft" closed="false">تُوْغَا سِيذْنَا نُوْح ذ يجّن ن بْنَاذم نِيشَان نتَّا ذ ڒْمُوْمن وَاحْذس جَار يِوْذَان ن زْمَان نّس، يݣُّوْر نِيشَان ذݣ وبْرِيذ ن أَربِّـي. وَامِي يخْزَر أَربِّـي غَار ثْمُوْرْث يُوْفِي-ت ثْعمَّر س شَّرّْ ڒَاحقَّاش يوْذَان مَارَّا فّْغن اَبْرِيذ. ئِكَّر أَربِّـي ينَّا-ٱس إِ سِيذْنَا نُوْح قَا يُوْوض-د ڒفْنَا ن مَارَّا ن مِين يدَّرن ذِي دُّنشْت-أَ ڒَاحقَّاش يوْذَان تْمنْغَان اَطَّاس ذِي ثْمُوْرْث. عْلَاحْسَاب مَانَايَا اَثن مْحِيغ نِثْنِي ذ ثْمُوْرْث. ٱݣّ إِ يِيخف نّش يج وغَرَّابُو ذَايس ثْڒَاثَا ن طّبْقَاث يشْتن خ ثنّغْنِي. أَقَا نش اَذَاوم د سّكّغ ڒْفَيَضَان ن وَامَان خ ثْمُوْرْث بَاش اَذ قْضِيغ خ مَارَّا مِينْذِي إِݣ يدْجَا اَرُّوْح ذ مَارَّا مِين يدْجَان خ ثْمُوْرْث اَذ يمّث. وَلَكِن شك اَكِش ݣّغ ڒْعَهذ، أَذ تَاذْفذ ذݣ وغَرَّابُو شك ذ ثَارْوَا نّش ذ ثمْغَارْث نّش ذ ثمْغَارِين ن ثَارْوَا نّش. ئِكَّر سِيذْنَا نُوْح يݣَّا مَارَّا س مِينْزِي ث يوصَّا سِيذِي أَربِّـي. </char></note> وَامِي يݣَّا مَانَاينِّي نتَّا يعيّب دُّنشْت، ئِوَارث صُّلْح نِّي إِي د يتَاسن س لْإِيمَان.<verse eid="HEB 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8" />س لْإِيمَان يكَّر <char style="it">نَّبِي</char> بْرَاهِيم يطَاع-اَس إِ أَربِّـي وَامِي ذَاس د يڒَاغَا اَذ يرَاح غَار يِجّن ن ومْشَان إِي غَا يقْبڒ ذ لْوَارث. ئِفّغ نتَّا تُوْغَا وَار يسِّين شَا مَانِي غَا يرَاح. <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />س لْإِيمَان يرُوْح نتَّا يزْذغ ذِي ثْمُوْرْث نِّي إِي زِي ث يوْعذ أَربِّـي، نتَّا أَقَاث ذِنِّي اَم شَا ن وبَرَّانِي. ئِتْعِيش ذݣ يقِيضَان اَكِذس <char style="it">ممِّيس</char> إِسْحَاق ذ <char style="it">وَايَّاو نّس</char> يَعْقُوْب، تْوَارَاثن اَكِذس عْلَاحْسَاب مِين زِي ثن يوْعذ. <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />ڒَاحقَّاش بْرَاهِيم يتْرَاجَا ثَنْدِينْت نِّي غَار دْجَان دْسَاسَاث يتْدُوْمَان، ئِخَطّ-يت أَربِّـي يبْنَا-ت.<verse eid="HEB 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11" />س لْإِيمَان سَارَا س يِيخف نّس يمُّوْش-اَس جّْهذ اَذ تيْسِي اَعدِّيس وَاخَّا نتَّاث ثْنُوْمْغَار، مِينْزِي ثكَّر نتَّاث ثْحسّب ونِّي إِي ت يوعْذن ذَايس تِّقث. <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />ثُمَّا زِي بْرَاهِيم ذ يجّن ن ورْيَاز يوْسَار يكمّڒ، يجَّا-د يجّن ن دُّوْرِّيث اَم يِيْثْرَان يدْجَان ذݣ وجنَّا اَم يِجْذِي يدْجَان خ شّطّ ن ڒبْحَر وَار يزمَّر حَدّ اَت يحسّب.<verse eid="HEB 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13" />يِيْنَا مَارَّا مُّوْثن ذِي لْإِيمَان نِّي نْسن قْبڒ مَا ذَاسن د اَوْضنْت ثْمسْڒَايِين نِّي إِي زِي ثن يوْعذ. وَلَكِن ࢲْرِين-ثنْت رحّْبن زَّايْسنْت زِي ڒݣّْوَاج، عْتَرْفن بلِّي نِثْنِي ذ يبَرَّانِيْين ذ يعزَّابن ذِي ثْمُوْرْث-أَ. <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />ئِوْذَان إِي سَّاوَاڒن اَمُّو يتظْهَار-د بلِّي رزُّوْن خ يِجّن ن ثْمُوْرْث اَذ تِيڒِي ذ ثَمُوْرْث نْسن. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />مَعْلِيك تُوْغَا تْخمَّامن ذِي ثْمُوْرْث نِّي مَانِيس د فّْغن، إِڒِي غَارْسن لْفُرْصَا اَذ د عقْبن. <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />وَلَكِن لَّا، رزُّوْن خ يِجّن ن ثْمُوْرْث حْسن زِي ثنِّي، يعْنِي يشْتن ذݣ وجنَّا. خ مَانَاينِّي أَربِّـي وَار يسذْحِي شَا اَذَاس ينِين قَا شك ذ أَربِّـي نّغ مِينْزِي نتَّا يسوْجذ-اَسن يجّن ن ثنْدِينْت.<verse eid="HEB 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17" />س لْإِيمَان يكَّر <char style="it">نَّبِي</char> بْرَاهِيم اَذ يقدّم ذ دْبِيحث س <char style="it">ممِّيس</char> إِسْحَاق وَامِي ث يجَرّب أَربِّـي. يعْنِي تُوْغَا يتْقدَّام ذ دْبِيحث س ممِّيس وَاحْذس إِي زِي يوْعذ أَربِّـي بْرَاهِيم، <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />تُوْغَا ينَّا-ٱس قَا س إِسْحَاق إِي زِي غَا تْوَاحسّب دُّوْرِّيث نّش. <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />ئِحسّب بْرَاهِيم بلِّي يزمَّر أَربِّـي اَذ د يسكَّر مِّيس زݣ يمتِّينن. مَانَاينِّي ذَايس ڒمْعَانِي مِينْزِي وَاه، ممِّيس يذْوڒ-د إِ بْرَاهِيم اَم يِجّن زِي ڒْموْث.<verse eid="HEB 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20" />س لْإِيمَان يكَّر <char style="it">نَّبِي</char> إِسْحَاق يبَرك ثَارْوَا نّس يَعْقُوْب ذ عَسُو عْلَاحْسَاب لْمُسْتَقْبل نْسن.<verse eid="HEB 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21" />س لْإِيمَان يكَّر <char style="it">نَّبِي</char> يَعْقُوْب وَامِي تُوْغَا يتْمتَّا يبَرك ثَارْوَا <char style="it">ن مِّيس</char> يُوْسف ئِج-ئِج، يعبّذ نتَّا خْمِي يتْسنَّاذ خ ثغْڒِيث نّس.<verse eid="HEB 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22" />س لْإِيمَان يكَّر <char style="it">نَّبِي</char> يُوْسف غَار ونݣَّارُو ن ثُوْذَارْث نّس، ئِسِّيوڒ خ وُوْفُوْغ ن أَيثْ-إِسْرَائِيل زِي مِصْرَا يوصَّا-ٱثن اَذ يْسِين اَكِذْسن يخْسَان نّس.<verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />س لْإِيمَان كَّرن لْوَالِدِين ن <char style="it">نَّبِي</char> مُوْسَى سْنُوْفَّرن ممِّيثْسن وَامِي د يخْڒق مِينْزِي ࢲْرِين بلِّي نتَّا يصْبَح اَطَّاس، وَار ݣّْوِيذن شَا زِي مِين ذَاسن يوصَّا وزدْجِيذ.<verse eid="HEB 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24" />س لْإِيمَان يكَّر <char style="it">نَّبِي</char> مُوْسَى وَامِي يمْغَار يُوْݣِي اَذَاس ڒَاغَان ممِّيس ن يدْجِيس <char style="it">ن لْمَلِك</char> فِرْعُوْن. <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />ئِخْضَر اَخَاس بُوْصَارن <char style="it">يمِصْرِيْين</char> اَك شَّعْب ن أَربِّـي، وَار يقْبِيڒ شَا اَذ يفَرح ذݣ وفلّس نِّي وَار يتْدُوْمِين شَا. <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />ئِفْهم مڒَا سحْقَارن-ث عْلَاحْسَاب لْمَسِيح يعْنِي مَانَاينِّي غَارس لْقِيمَا كْتَار زِي مِين غَارْسن ذ لْكُنُوْز ذِي مِصْرَا. أَقَا نتَّا يخزَّر غَار زَّاث ذِي لْجَائِزَا نّس.<verse eid="HEB 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 11:27" />س لْإِيمَان يكَّر مُوْسَى يفّغ زِي مِصْرَا، وَار يݣّْوِيذ شَا زݣ وغْضَاب ن وزدْجِيذ نِّي. ئِطّف ذِي لْإِيمَان نّس اَم يِجّن يتْوَاڒَان <char style="it">أَربِّـي</char> نتَّا وَار يزمَّر اَث يࢲر حَدّ. <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />س لْإِيمَان يكَّر نتَّا يݣَّا ڒْعِيذ اَمقّْرَان يرُوْشّ ثِوُّوْرَا س يذَامّن ن ڒْعِيذ حمَا عَزْڒَاين وَار ينقّ شَا يمنْزَا<note caller="+" style="f"><char style="fr" closed="false">11‏.28 </char><char style="ft" closed="false">ئِمنْزَا نِثْنِي ذ يفْخدَّان، قَّارن-ث إِ يحنْجِيرن إِي د خْدْجْقن ذ يمزْوُوْرَا.</char></note> ن أَيثْ-إِسْرَائِيل.<verse eid="HEB 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29" />س لْإِيمَان يكَّر شَّعْب يࢲْوَا غَار وجمَّاض-ين ن ڒبْحَر أَزݣّْوَاغ س يضَارن نْسن، ثِيْسِي نّس ثݣَّا اَمشْنَاو ثَمُوْرْث يُوْزْغن. وَلَكِن وَامِي جَرّْبن يمِصْرِيْين اَذ عْذُوْن سّنّي ينْفيّض-د خَاسن ڒبْحَر غرْقن.<verse eid="HEB 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30" />س لْإِيمَان يكَّر شَّعْب ڒخْدّنِّي وْضَان ڒحْيُوْض ن ثنْدِينْت ن أَرِيحَا وَامِي ذَاس ينّض شَّعْب سبْعِيَّام.<verse eid="HEB 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="HEB 11:31" />س لْإِيمَان ثَحنْجِيرْث نِّي ؤُمِي قَّارن رِيحَاب إِي تُوْغَا يفّْغن اَبْرِيذ ثكَّر نتَّاث ثْرحّب س لْمُخَبَارَاث <char style="it">ن أَيثْ-إِسْرَائِيل</char>. س مَانَاينِّي وَار ثمُّوْث شَا اَك يِنِّي وَار يتْطِيعِين شَا.<verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />إِيوَا مِين غَا ينِيغ عَاذ؟ وَار غَارِي بُو ڒْوقْث اَذ سِّيوْڒغ خ جَعْذُوْن نِغ ذ بَارَاك نِغ ذ شَمْشُوْن نِغ ذ يَافْتَا نِغ ذ <char style="it">نَّبِي</char> دَاود نِغ ذ <char style="it">نَّبِي</char> صَمْوِيل نِغ ذ مَارَّا لْأَنْبِيَا. <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />س لْإِيمَان كَّرن نِثْنِي ربْحن لْممْلَاكَاث، حكْمن س ڒْحَقّ، حرْثن خ لْوُعُوْد، بلّْعن يقمُّوْمن ن سْبُوْعَاث، <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />سخْسِين اَحَذُوْق ن ثْمسِّي، فڒْثن زِي ڒقْضع ن سِّيف. ضُّوْعف نْسن يذْوڒ ذ جّْهذ، جهْذن ذِي ڒْحَرْب ؤُزّْڒن خ ڒْعَسْكَار ن ثْمُوْرَا نّغْنِي. <verse eid="HEB 11:34" /><verse number="35" style="v" sid="HEB 11:35" />ڒبْعَاض ن ثمْغَارِين يْسِينْت-يد يمتِّينن نْسنْت إِي د كَّرن زِي ڒْموْث. ڒبْعَاض ن يِوْذَان مَارّْثن-ثن، وَلَكِن نِثْنِي ؤُݣِين اَذ تْوَاضڒْقن بَاش اَذ ربْحن يجّن ن لْقِيَامَا حْسن. <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />ڒبْعَاض ن يِوْذَان حݣَّرن-ثن، ؤُوْثِين-ثن س وسْغُوْن، شَرْفن-ثن س سْنَاسڒ، حبّْسن-ثن. <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />رجْمن-ثن س وزْرُو، قسّن-ثن خ ثْنَاين س ڒْمنْشَار، نْغِين-ثن س سِّيف. ݣُّوْرن س يِڒمَاون ن يحُوْڒِيْين ذ يغَايْذن. نِثْنِي ذ يمسْعَان، تْوَاعدَّابن، تنْعدَّان خَاسن. <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />نِثْنِي دُّنشْت-أَ وَار ثن ثسْذَاهدْج شَا. تْعزَّابن ذِي ڒخْڒَاوَاث ذ يذُوْرَار ذ يخُوْبَاش ذ يِيْفْرَان ن ثْمُوْرْث.<verse eid="HEB 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39" />مَارَّا يِيْنَا تْوَاشكَّرن س لْإِيمَان نْسن. إِنَّمَا، ؤُڒَا ذ يجّن زَّايْسن تُوْغَا <char style="it">عَاذ</char> وَار ذَاس د يُوْوِيض شَا مِين زِي ث يوْعذ <char style="it">أَربِّـي</char>. <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />تُوْغَا أَربِّـي يذبَّر-اَنغ-د إِ نشِّين زِي قْبڒ يجّن ن ڒْحَاجث حْسن بَاش نِثْنِي وَار تِيوِيضن شَا غَار ونݣَّارُو يعْنِي اَذ يڒِين كمْڒن بْڒَا نشِّين.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="s">أَربِّـي ذ بَابَاثْنغ أُو سِيذِيثْنغ عِيْسَى ذ زَّعِيم نّغ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />إِذن عْلَاحْسَاب نِثْنِي، يعْنِي ڒشْهُوْذ نِّي ن لْإِيمَان إِي خَانغ يتنّْضن اَم يِجّن ن ؤُمُوْنِي ذ اَمقّْرَان، لَابُد أَ نكَّر أَ نكّس كُڒ دْقڒ ذ كُڒ ڒْمُعْصِيّث إِي ذَانغ يسحْصَارن. أَ نَازّْڒث س صْبَار ثَازّْڒَا نِّي إِي ذَانغ يتْرَاجَان غَار زَّاث. <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />أُو لَابُد أَ نْخزَّر مْلِيح غَار عِيْسَى زَّعِيم نّغ ذ نتَّا إِي ذَانغ غَا يسِّيوْضن نِيشَان غَار ونݣَّارُو. عِيْسَى س ڒفْرَاحث نِّي إِي تُوْغَا ث يتْرَاجَان غَار زَّاث، ئِصْبَر خ صَّلِيب يعيّب اَحݣَّار ن صَّلِيب نِّي سّنِّي يقِّيم خ وفُوْسِي ن ڒْعَرْش ن أَربِّـي. <verse eid="HEB 12:2" /><verse number="3" style="v" sid="HEB 12:3" />فكَّرث مْلِيح ذِي عِيْسَى نتَّا مشْحَاڒ يصْبَر خ شّْمَايث إِي ذَاس يعَارّْضن بَاش كنِّيو وَار تِيحْڒم شَا وَار تفْشِيڒم شَا.<verse eid="HEB 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 12:4" />وَامِي ثْمنْغم ضد إِ ڒْمُعْصِيّث، وَار ثْعِيرّْضم شَا بَاش اَذ اَزّْڒن يذَامّن نْوم لَّا. <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />كنِّيو ثتُّوْم اَوَاڒ نِّي <char style="it">زِي لْكِتَاب</char> إِي كنِّيو غَا يشجّْعن، ئِسَّاوَاڒن اَكِذْوم اَم ثَارْوَا نّس ينَّا-ٱوم:</para>
  <para style="q1" vid="HEB 12:5">&lt;آ مِّي، وَار تْقهَّار شَا تَّرْبِـيَّا ن سِيذِي أَربِّـي،</para>
  <para style="q1" vid="HEB 12:5">وَار تفْشِيڒ شَا مڒَا نتَّا ينهَّا-شك.<verse eid="HEB 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 12:6" />مِينْزِي سِيذِي أَربِّـي يتْربَّا ونِّي خَاس يعِيزّن،</para>
  <para style="q1" vid="HEB 12:6">ئِنهَّا ونِّي إِي خف يَارْضَا يتْوَاحْسَاب اَم مِّيس.&gt;<verse eid="HEB 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7" />صْبَرث خ تَّرْبِـيَّا ن أَربِّـي، ئِتݣّ اَكِذْوم اَم ثَارْوَا نّس. مِين يعْنَا مِّيس-أَ وَار ث يتْربِّـي شَا بَابَاس؟ <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />يَاش مَارَّا يوْذَان تْوَاربَّان نِغ؟ مَعْلِيك كنِّيو وَار كنِّيو يربِّـي شَا أَربِّـي، أَتَاف كنِّيو اَم ثَارْوَا ن ڒحْرَام مَاشِي ذ ثَارْوَا ن لْحَلَال. <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />أُو عَاوذ نشِّين مَارَّا تُوْغَا غَارْنغ لْوَالِدِين ذِي دُّنشْت-أَ إِي ذَانغ يتْربَّان نتْسذْحَا زَّايْسن. إِيوَا نشِّين مڒَا أَ ندَّر، أَتَاف أَ نْسذْحَا زِي بَابَاثْنغ ن وجنَّا كْتَار نِغ لَّا؟ <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />شُوْف، لْوَالِدِين تْربَّان-اَنغ ذݣ يِجّن ن ڒْوقْث، تݣّن مَامّش ذَاسن يتْغِيڒ مْلِيح. وَلَكِن أَربِّـي يتْربَّا-يَانغ خ نّْفَع نّغ بَاش أَ نْشَرش ذِي طَّبِيعَا نّس يدْجَان عَظِيم. <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />ذِي ڒْوقْث نّس كُڒ تَّرْبِـيّث تْغِيڒ-اَنغ ثقْسح مَاشِي ذ ثَصبْحَانْت. وَلَكِن منْبَعْد اَذ تَارو يجّن ن ثْفدْجَاحْث ن ڒْخِير ذ يجّن ن ڒهْنَا إِ يِنِّي إِي ت غَا يڒمْذن.<verse eid="HEB 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />خ مَانَايَا سْجهْذث يفَاسّن نْوم يرْخُوْن ذ يفَادّن نْوم يفشْڒن. <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />سݣّْذث يبْرِيذن نْوم نِيشَان بَاش يضَارن نْوم يزحَّافن وَار تْغِيمِين شَا ذ ينعْذَام اَذ ݣنْفَان.<verse eid="HEB 12:13" /></para>
  <para style="s">أَبْرِيذ ن ڒْمُوْمِنِين</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />ݣّث لْمجْهُوْد بَاش اَذ تْعِيشم ذِي ڒهْنَا اَك مَارَّا يوْذَان أُو بَاش اَذ تِيڒِيم ثصْفَام. بْڒَا أَ نِيڒِي نصْفَا وَار ذِنِّي حَدّ إِي غَا يࢲرن مَاوْلَانَا. <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />أَرّم-د ڒْبَاڒ نْوم بَاش وَار يتْغِيمِي حَدّ وَار يخطّڒ غَار اَرْضَا ن أَربِّـي، نِغ عَاوذ وَار يغمِّي شَان ن وࢲْوَار ذ اَمرْزَاݣ اَذ يݣّ لْمَشَاكِيل اَذ يضيّع اَطَّاس ن يِوْذَان. <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />أَرّم-د ڒْبَاڒ نْوم بَاش وَار يتݣّ شَان يِجّن زَّايْوم لْفَسَاد، نِغ شَان يِجّن وَار غَارس يتِيڒِي بُو أَربِّـي اَم عَسُو نِّي يرُوْح نتَّا يزّنْز ڒْحَقّ نّس زِي لْبَرَكَا ن بَابَاس خ يِجّن ن طّبْصِي ن لْمَكْلَا. <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />أَقَا ثسّْنم منْبَعْد يعْقب-د عَسُو-يَا يرزُّو اَذ يوَارث لْبَرَكَا نِّي يُوْݣِي-يَاس بَابَاس. وَار يُوْفِي مَامّش تِيد غَا يَارّ وَاخَّا يتتَّار-اَس-ت س يمطَّاون.<verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />شُوْف، كنِّيو وَار ثْقَارّْبم شَا غَار يجّن ن وذْرَار إِي غَا تْحَاذَام س وفُوْس ذَايس ثِمسِّي ثْحدّق ذَايس ثَادْجسْت ذَايس ثُوْبَرْشَانْت ذَايس اَرِّيح اَطَّاس. <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />ئِتفّغ-د زَّايس يجّن ن صُّوْت ن زَّامَّار ذ يِجّن ن ثْمِيجَّا ثسَّاوَاڒ اَوَاڒن يسَاݣّْوَاذن إِ يِنِّي ذَاس يتْسْڒَان، تتَّارن-تث وَار ذَاسن ثقَّار بُو شَان ن وَاوَاڒن نّغْنِي. <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />مِينْزِي تُوْغَا نِثْنِي وَار زمَّرن شَا اَذ صْبَرن إِ مِين ذَاسن ثْوصَّا ثْمِيجَّا نِّي، ثنَّا-ٱسن قَا لْحَيَوَان نِّي إِي غَا يحَاذَان اَذْرَار-أَ اَتَاف أُو لَابُد اَذ يتْوَارْجم س وزْرُو. <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />مِين تْوَاڒَان ذِنِّي يسَاݣّْوَاذ اَطَّاس، حتَّا ؤُڒَا ذ نَّبِي مُوْسَى ينَّا اَقَايِي ترْجِيجِيغ س ثِيݣّْوْذِي.<verse eid="HEB 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22" />وَلَكِن كنِّيو ثْقَارّْبم-د غَار وذْرَار ن صِيَان يعْنِي ثَنْدِينْت ن أَربِّـي يدَّرن ذ لْقُدْس ن وجنَّا، ذَايس اَڒَاف ن ؤُرُوْفَاث ن لْمَلَائِكَاث. <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" /><char style="it">ثْقَارّْبم-د</char> غَار يِنِّي يتْمُوْنن ذِي ڒفْرَاحث يعْنِي غَار جْمَاعث ن يِنِّي يخْضَر أَربِّـي إِي د يخڒْقن ذ يمزْوُوْرَا يسمَاون نْسن تْوَازمّن ذݣ وجنَّا. <char style="it">ثْقَارّْبم-د</char> غَار أَربِّـي ونِّي يدْجَان ذ ڒْقَاضِي خ مَارَّا يوْذَان. <char style="it">ثْقَارّْبم-د</char> غَار اَرُّوْحَاث ن صَّالِحِين يَارِّي-ثن <char style="it">أَربِّـي</char> بْڒَا ڒْعِيب. <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" /><char style="it">ثْقَارّْبم-د</char> غَار عِيْسَى ونِّي يتْشَفَاعن ذَايْنغ س يِجّن ن ڒْعَهذ ذ جْذِيذ. <char style="it">ثْقَارّْبم-د كنِّيو</char> غَار يذَامّن نّس يتْوَارُوْشّن إِي قَّارن يجّن ن وَاوَاڒ حْسن زݣ ونِّي ن نَّبِي هَابِيل.<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />أَرّم-د ڒْبَاڒ نْوم وَار تْجِيهِيڒم شَا اَوَاڒ ن ونِّي يسَّاوَاڒن، مَايمِّي؟ لِأَنَّا أَيث-إِسْرَائِيل وَار فڒْثن شَا وَامِي جهْڒن اَوَاڒ ن ونِّي تُوْغَا ثن يوصَّان ذِي ثْمُوْرْث. أُو نشِّين عَاذ كْتَار، مڒَا نُوْݣِي أَ نْطَاع إِ ونِّي ذَانغ يوصَّان زݣ وجنَّا اَتَاف عمَّارْص أَ نفْڒث. <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />ذِي ڒْوقْث نِّي يعْذُوْن صُّوْت ن أَربِّـي يسنْهزّ ثَمُوْرْث، وَلَكِن ڒخُّو يوْعذ ينَّا قَا عَاذ اَذ د تَاس يجّن ن ڒْوقْث نش اَذ سنْهزّغ ثَمُوْرْث ؤُڒَا ذ يجنَّاثن. <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />أَوَاڒ نِّي نّس يعْنِي &lt;عَاذ اَذ د تَاس يجّن ن ڒْوقْث&gt; اَتَاف نتَّا يسَّاوَاڒ خ شَا ن ثْمسْڒَايِين يتنْهزَّان اَذ تْوَاكّْسنْت يعْنِي ذ ثِمسْڒَايِين نِّي إِي د يتْوَاخڒْقن بَاش ثِمسْڒَايِين نِّي إِي وَار يتنْهزِّين شَا اَتَاف اَذ قِّيمنْت.<verse eid="HEB 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28" />خ مَانَايَا أَ نْشكَّر أَربِّـي ڒَاحقَّاش نقْبڒ يجّن ن ڒْمُلْك وَار يتنْهزِّين شَا. أَمُّو اَذَاس نْقدّم إِ أَربِّـي يجّن ن لْعِبَادَا س ڒُوقَّار ذ ثِيݣّْوْذِي اَخَاس يَارْضَا نتَّا، <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />مِينْزِي أَربِّـي نّغ نتَّا ذ يجّن ن ثْمسِّي يسْحَرَّاقن.<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s">ڒُوْصِيَاث ثِنݣُّوْرَا</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />قِّيمث تْحِبَّاث اَيَاوْيَا اَم وَاوْمَاثن. <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />وَار تتُّوْث شَا اَذ تْرحّْبم زِي مِدّن مِينْزِي ڒبْعَاض إِي ݣِّين مَانَاينِّي تْرحَّابن زِي لْمَلَائِكَاث بْڒَا مَا ثنْت سّْنن. <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />خمّْمث ذݣ يمحْبَاس اَمشْنَاو كنِّيو إِي كِذْسن ثتْوَاحبّْسم ذ يِنِّي إِي خف تْبُوْصَارن اَمشْنَاو كنِّيو ثتْوَاعدَّابم.<verse eid="HEB 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4" />وقَّارث ڒمْڒَاش مَارَّا. قَامَا ن ڒمْڒَاش اَذ تِيڒِي س نِّيّث بْڒَا ڒْغدْڒَان. أَقَا أَربِّـي اَذ يعَاقب يِنِّي يفسّْذن ذ يِنِّي يزنَّان. <verse eid="HEB 13:4" /><verse number="5" style="v" sid="HEB 13:5" />أَذ تْعِيشم بْڒَا مَا ٱذ تْحِبّم تْمنْيَاث، أَذ تْقنْعم س مِين غَارْوم. أَربِّـي س يِيخف نّس ينَّا قَا عمَّارْص اَش جّغ، عمَّارْص اَذَايك سمْحغ. <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />س مَانَاينِّي نقَّار س زْعَامث قَا نش سِيذِي أَربِّـي يتْعَاوَان-اَيِي مَاشِي اَذ ݣّْوْذغ. مِين ذَايِي غَا يݣّ بْنَاذم؟<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />عقْڒث خ يِنِّي إِي خَاوم يتْرَايَّان يعْنِي يِنِّي يسِّيوْڒن اَكِذْوم س وَاوَاڒ ن أَربِّـي. فكَّرث ذِي مِين ؤُرْون نِثْنِي س ثُوْذَارْث نْسن، ݣّث مَامّش إِي ݣِّين نِثْنِي س لْإِيمَان نْسن. <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />عِيْسَى لْمَسِيح نتَّا ذ يجّن، أَمشْنَاو إِضنَّاظ اَمشْنَاو نْهَارَا اَمشْنَاو إِ ڒبْدَا. <verse eid="HEB 13:8" /><verse number="9" style="v" sid="HEB 13:9" />أَرّم-د ڒْبَاڒ نْوم بَاش وَار تْذفَّارم شَا لْأَنْوَاع ن ؤُسڒْمذ فشْكل.</para>
  <para style="p" vid="HEB 13:9">شُوْف، ذ لمْلِيح اَذ يجْهذ وُوْڒ نّغ س اَرْضَا مَاشِي س لْمَكْلَا دِّينِيَا، يِنِّي إِي ت يتتّن وَار زَّايس سْتنْفِيعن شَا. <verse eid="HEB 13:9" /><verse number="10" style="v" sid="HEB 13:10" />نشِّين غَارْنغ يجّن ن ڒْمذْبَاح، زِي ڒْمذْبَاح-أَ وَار غَارْسن بُو ڒْحَقّ اَزَّايس شّن يِنِّي يخدّْمن ذݣ وقِيضُوْن اَمقّْرَان. <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />لِأَنَّا ڒفْقِي اَمقّْرَان يتَاوِي-د اَكِذس يذَامّن ن لْحَيَوَانَاث غَار وخَّام اَمْقدّس اَطَّاس اَمشْنَاو يجّن ن صّذْقث خ ڒْمُعْصِيّث، وَلَكِن لْحَيَوَانَاث نِّي يمُّوْثن سْحَرَّاقن-ثن غَار ڒݣّْوَاج ن مَانِي قِّيمن يِوْذَان ذݣ يقِيضَان نْسن. <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />أَمُّو عَاوذ عِيْسَى، ثكَّا خَاس تَمَارَا نِّي غَار ڒݣّْوَاج ن ثوَّارْث ن ثنْدِينْت بَاش اَذ يسِّيصْفَا شَّعْب س يذَامّن نّس. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />خ مَانَايَا أَ نْرَاح غَار <char style="it">عِيْسَى</char> غَار ڒݣّْوَاج ن يقِيضَان أَ نَارْبُو اَحݣَّار نِّي إِي خف يصْبَر نتَّا. <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />مِينْزِي ذَانِيتَا وَار غَارْنغ بُو ثنْدِينْت يتْدُوْمَان؛ لَّا، نْرزُّو خ ثنْدِينْت نِّي إِي د غَا يَاسن.<verse eid="HEB 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 13:15" />إِذن لَابُد س عِيسَى إِي زِي غَا نحْمذ أَربِّـي ذِي مْكُڒ ڒْوقْث. ذ ثَانِيتَا ذ دْبِيحث إِي غَا نْقدّم إِ أَربِّـي، يعْنِي مڒَا نعْتَرف س يِيسم نّس. <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />أُو وَار تتُّوْث شَا اَذ تݣّم ڒْخِير اَذ تْشَرْشم اَك ينّغْنِي مِينْزِي س دْبِيحَاث-أَ اَم ثِيْنَا إِي ذَاس يتعْجِيبن إِ أَربِّـي. <verse eid="HEB 13:16" /><verse number="17" style="v" sid="HEB 13:17" />طَاعث إِ يِنِّي خَاوم يتْرَايَّان، ݣّم-اَسن اَرَّاي مِينْزِي ذ يِنِّي إِݣ يحطَّان ڒَعْمَار نْوم. أَذ ؤُشن نِثْنِي ڒحْسَاب خ مَانَايَا إِ أَربِّـي. طَاعث إِ يِيْنَا بَاش ڒْخذْمث نْسن اَزَّايس فَرْحن وَار خَاسن تْبسِّيڒ شَا. مڒَا ثݣِّيم ثَغنَّانْت اَتَاف وَار كنِّيو ينفّع وَالُو.<verse eid="HEB 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />تَّارث إِ أَربِّـي خَانغ. أَقَا نشِّين متْأَكدِّين ضَّمِير نّغ مرْتَاح، نْرزُّو أَ نخْذم س ڒحْيَا مَارَّا ثِمسْڒَايِين. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />تتَّارغ-اَوم س وُوْڒ ينُو خَصَّاتَان اَذ تࢲَّادْجم بَاش ذغْيَا اَغَارْوم د ذوْڒغ.<verse eid="HEB 13:19" /></para>
  <para style="s">لْخِتَام ن ثبْرَات-أَ</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />أَربِّـي ذَايس ڒهْنَا، ذ نتَّا إِي د يَارِّين سِيذِيثْنغ عِيْسَى زݣ يمتِّينن س يذَامّن ن ڒْعَهذ إِݣ يتْدُوْمَان إِ ڒبْدَا، عِيْسَى-يَا ذ اَمكْسَا اَمقّْرَان ن يحُوْڒِيْين. <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />أَذَاوم يذبَّر أَربِّـي مَارَّا ثِمسْڒَايِين ثِصبْحَانِين بَاش اَذ تݣّم ڒْخَاضَر نّس. أَذَايْنغ يخْذم مِين ذَاس يتعْجِيبن زَّاثس، س سِيذِيثْنغ عِيْسَى لْمَسِيح إِي غَار غَا ثِيڒِي لْعَظَمَا إِ ڒبْدَا ن ڒبْدَاث. آمِين.<verse eid="HEB 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />فَا آي أَيثْمَا تتَّارغ-اَوم اَذ تصْبَرم إِ وَاوَاڒ ينُو إِي زِي كنِّيو تْوصِّيغ مِينْزِي ؤُرِيغ-اَوم-د غِير يجّن ن ثبْرَات ذ ثَمزْيَانْت. <verse eid="HEB 13:22" /><verse number="23" style="v" sid="HEB 13:23" />ئِتْخصَّا اَذ تسّْنم بلِّي ضڒْقن-اَس-د إِ وُوْمَاثْنغ تِيْمُوْتَاوُس. أَكنِّيو ࢲرغ اَكِذس يعْنِي مڒَا يُوْسَا-د ذغْيَا. <verse eid="HEB 13:23" /><verse number="24" style="v" sid="HEB 13:24" />سِيوْضم-اَسن سْڒَام إِ مَارَّا يِنِّي إِي خَاوم يتْرَايَّان ذ مَارَّا صَّالِحِين. يِيْنَا زِي إِطَالْيَا سَاوَّاضن-اَوم-د سْڒَام. <verse eid="HEB 13:24" /><verse number="25" style="v" sid="HEB 13:25" />أَكِذْوم يِيڒِي اَرْضَا مَارَّا إِذْوم.<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>