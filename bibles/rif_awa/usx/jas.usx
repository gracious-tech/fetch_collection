<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- TarifitABS</book>
  <para style="h">يعقوب</para>
  <para style="toc3">يعق</para>
  <para style="toc2">ثبرات غار يعقوب</para>
  <para style="toc1">ثَبْرَات ن اَرَّسُوْل يَعْقُوْب</para>
  <para style="mt1">ثَبْرَات ن اَرَّسُوْل يَعْقُوْب</para>
  <chapter number="1" style="c" sid="JAS 1" />
  <para style="s1">أَرَّسُوْل يَعْقُوْب يتْسدْجَام خ ڒْمُوْمِنِين</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1" />نش ذ يَعْقُوْب ذ ڒْعَبْذ ن أَربِّـي ذ ڒْعَبْذ ن سِيذِيثْنغ عِيْسَى لْمَسِيح، تْسدْجَامغ خ ثنْعَاش ن ثْقبَّاڒ <char style="it">ن ڒْمُوْمِنِين</char> إِي يتمْزدْجَاعن خ ثْمُوْرَا.<verse eid="JAS 1:1" /></para>
  <para style="s1">لْإِيمَان ذ ڒمْحَاين</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2" />آي أَيثْمَا، فَرْحم اَطَّاس خْمِي غَا ثِيڒِيم ذِي لْأَنْوَاع ن ڒمْحَاين. <verse eid="JAS 1:2" /><verse number="3" style="v" sid="JAS 1:3" />كنِّيو ثسّْنم مَارَّا ڒمْحَاين-أَ إِي ثْسعْذُوْم عْلَاحْسَاب لْإِيمَان نْوم تَاوِينْت-يد صّْبَار. <verse eid="JAS 1:3" /><verse number="4" style="v" sid="JAS 1:4" />أُو لَابُد صّْبَار-أَ اَذَايْوم يكمّڒ شّْغڒ نّس حمَا ٱذ تمْغَارم اَذ تْعمَّرم س لْإِيمَان وَار ذَاوم ثْنقِّيص ؤُڒَا ذ يجّن ن ڒْحَاجث. <verse eid="JAS 1:4" /><verse number="5" style="v" sid="JAS 1:5" />مڒَا شَان يِجّن زَّايْوم يتْخصَّا-يَاس ڒفْهَامث، أَذَاس ت يتَّار إِ أَربِّـي نتَّا اَذَاس ت يُوْش. مِينْزِي نتَّا يفَاسّن نّس رزّْمن وَار يتْحݣَّر حَدّ. <verse eid="JAS 1:5" /><verse number="6" style="v" sid="JAS 1:6" />وَلَكِن مَانَايَا يتْخصَّا-يَاس اَذَاس ث يتَّار س لْإِيمَان بْڒَا مَا ٱذ يشكّ ڒَاحقَّاش ونِّي يتْشكَّان يݣَّا اَم ڒْمُوْجث ن ڒبْحَر يسْهَاجَا-ت اَرِّيح يتَاوِي-ت يتَارَّا-ت-يد. <verse eid="JAS 1:6" /><verse number="7" style="v" sid="JAS 1:7" />بْنَاذم-أَ يتْخصَّا-يَاس وَار يتْفكِّير شَا بلِّي سِيذِي أَربِّـي اَذَاس يُوْش شَان ڒْحَاجث. <verse eid="JAS 1:7" /><verse number="8" style="v" sid="JAS 1:8" />ئِتْشكَّا، كُڒ ڒَعْقڒ نّس مِين ذَاس يقَّار منْبَعْد يتْذوَّاخ ذݣ يبْرِيذن نّس مَارَّا.<verse eid="JAS 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9" />فَا يتْخصَّا-يَاس إِ ڒْمسْكِين إِݣ يُوْمْنن اَذ يفْتَخَر مِينْزِي يسْݣَعّذ-يث أَربِّـي. <verse eid="JAS 1:9" /><verse number="10" style="v" sid="JAS 1:10" />ئِتْخصَّا-يَاس إِ تَّاجَر إِݣ يُوْمْنن اَذ يفْتَخَر مِينْزِي نتَّا يسهْوَا-ث أَربِّـي، ڒَاحقَّاش تَّاجَر يݣَّا اَم نْوَار ن اَرْبِيع وَار يتْدُوْمِّين شَا. <verse eid="JAS 1:10" /><verse number="11" style="v" sid="JAS 1:11" />تْسُوْمَّار-د ثْفُوْشْت، س ڒحْمُو نّس يسّشْمَاضن ثْسَازَّاغ اَرْبِيع، ئِوطَّا نْوَار نّس يتْرَاح زِّين نّس. أَمُّو إِي ذَاس يتوْقِيع إِ تَّاجَر-أَ، نتَّا يتِيْسْرَاو اَخْمِي يخدّم شّْغڒ نّس.<verse eid="JAS 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12" />سَّعْذ ن ونِّي يصْبَارن خ ڒمْحَاين اَتَاف خْمِي غَا ينْجح اَذ ييْسِي تَّاج ن ثُوْذَارْث ونِّي إِي زِي يعَاهذ أَربِّـي يِنِّي إِي ث يتْحِبَّان. <verse eid="JAS 1:12" /><verse number="13" style="v" sid="JAS 1:13" />مڒَا يتْوَاغَرَّا شَان يِجّن، ئِتْخصَّا-يَاس وَار يقَّار شَا قَا ذ أَربِّـي إِي ذَايِي يتْغَرَّان. لَّا، أَربِّـي وَار يتْغَرِّي حَدّ، وَار يتْوَاغَرِّي شَا س شَّرّْ. <verse eid="JAS 1:13" /><verse number="14" style="v" sid="JAS 1:14" />نتَّا بْنَاذم يتْوَاغَرَّا س سَّبَاب ن شّهْوث نّس ثَعفَّانْت، نتَّاث إِي ث يتْجَرَّان نتَّاث إِي ث يخدّْعن. <verse eid="JAS 1:14" /><verse number="15" style="v" sid="JAS 1:15" />ثُمَّا شّهْوث-أَ وَامِي ثيْسِي اَعدِّيس ثُوْرو-د ڒْمُعْصِيّث، ثُمَّا ڒْمُعْصِيّث-أَ وَامِي ثمْغَار ثجَّا-د ڒْموْث.<verse eid="JAS 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16" />آي أَيثْمَا يمْعِيزّن ينُو، وَار خدّْعث شَا يخف نْوم. <verse eid="JAS 1:16" /><verse number="17" style="v" sid="JAS 1:17" />مَارَّا ثِمُوْشَا ثِيصبْحَانِين ذ لْهَدِيَاث يكمْڒن تكّنْت-يد زݣ وجنَّا، تَاسنْت-يد زِي أَربِّـي بَابَاس ن نُّوْر. نتَّا وَار يتْبدِّيڒ شَا اَم ثِيڒِي نِّي إِݣ يݣُّوْرن. <verse eid="JAS 1:17" /><verse number="18" style="v" sid="JAS 1:18" />وَامِي يخس نتَّا، ئِكَّر يَارَّا-ٱنغ ذ ثَارْوَا نّس إِي د يجَّا س وَاوَاڒ ن لْحَقِيقَا حمَا أَ نِيڒِي نشِّين ذ يمزْوُوْرَا زِي مِين د يخْڒق.<verse eid="JAS 1:18" /></para>
  <para style="s">ونِّي يتْصنَّاطن غَار وَاوَاڒ ن أَربِّـي يتْخصَّا-ٱس ٱث يݣّ</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19" />شُوْف آي أَيثْمَا ينُو يمْعِيزّن، ئِتْخصَّا كُڒ يجّن اَذ يتْسڒَا ٱطَّاس، أَذ يفكَّر قْبڒ مَا ٱذ يسِّيوڒ، وَار يتْعَصِّيب شَا ذغْيَا. <verse eid="JAS 1:19" /><verse number="20" style="v" sid="JAS 1:20" />مِينْزِي اَعصّب ن بْنَاذم وَار د يسِيوِّيض شَا مِين يدْجَان ذ ڒْحَقّ غَار أَربِّـي. <verse eid="JAS 1:20" /><verse number="21" style="v" sid="JAS 1:21" />بعّْذث خ مَارَّا مِين يدْجَان ذ اَعفَّان ذ مِين يدْجَان ذ شَّرّْ. بْڒَا تَّكبُّر قبّْڒث اَوَاڒ نِّي <char style="it">ن أَربِّـي</char> يتْوَاࢲُّوْن ذَايْوم يزمَّر اَذ يسنْجم ڒَعْمَار نْوم.<verse eid="JAS 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22" />فَا مَاشِي اَذ تسْڒم إِ وَاوَاڒ ن أَربِّـي أُو صَافِي؛ ئِتْخصَّا-كنِّيو اَزَّايس ثْخدّْمم حمَا وَار ثْخدّْعم شَا يخف نْوم. <verse eid="JAS 1:22" /><verse number="23‏-24" style="v" sid="JAS 1:23-24" />مَثَلَان، ئِجّن يخزَّر ذݣ وغمْبُوْب نّس مْلِيح ذِي ثِيسِيث وَاهَا. وَامِي يخْزَر مْلِيح، ئِرُوْح يتُّو ذغْيَا يخف نّس مَامّش يدْجَا. أَمُّو إِݣ يدْجَا ونِّي يتْسْڒَان إِ وَاوَاڒ ن أَربِّـي وَار زَّايس يخدّم شَا. <verse eid="JAS 1:23-24" /><verse number="25" style="v" sid="JAS 1:25" />وَلَكِن ونِّي يخزَّرن ذِي شَّرِيعَا يكمْڒن ثنِّي إِي ذِي ثدْجَا لْحُرِّيَا، ئِتطّف ذَايس وَار يتتُّو شَا مِين يتْسْڒَا يخدّم زَّايس، أَتَاف اَزَّايس يَاوِي لْبَرَكَا ذِي مِين يتݣّ. <verse eid="JAS 1:25" /><verse number="26" style="v" sid="JAS 1:26" />ونِّي يتْحَسَّابن يخف نّس غَارس دِّين وَار يحطِّي شَا يِيڒس نّس، أَتَاف يخدّع يخف نّس وَاهَا وَار غَارس بُو دِّين. <verse eid="JAS 1:26" /><verse number="27" style="v" sid="JAS 1:27" />دِّين يصْفَان إِي ينْقَان غَار أَربِّـي بَابَاثْنغ مِين يعْنَا؟ يعْنِي بْنَاذم يتْرَاح غَار يُوْجِيڒن ذ ثَاجَّاڒِين اَثن يعَاون ذݣ وزيَّار نْسن، أَذ يحْضَا يخف نّس حمَا وَار ث تْوسِّيخ شَا دُّنشْت-أَ.<verse eid="JAS 1:27" /></para>
  <chapter eid="JAS 1" />
  <chapter number="2" style="c" sid="JAS 2" />
  <para style="s1">ؤُذمَاون تْسبَّابن إِ ڒْمُعْصِيّث</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1" />آي أَيثْمَا، كنِّيو ثُوْمْنم زِي سِيذِيثْنغ عِيْسَى لْمَسِيح إِي غَار ثدْجَا لْعَظَمَا، وَار تݣّث شَا س وُوْذْمَاون جَار يوْذَان. <verse eid="JAS 2:1" /><verse number="2" style="v" sid="JAS 2:2" />مَثَلَان، يُوْذف-د يجّن ن تَّاجَر غَار جْمَاعث نْوم يݣَّا ثْخَاذنْت ن دّْهب ذݣ وفُوْس نّس يَرض اَرُّوْض يصْبَاح. ئِذْفَار-يث-يد يجّن ذ ڒْمسْكِين اَرُّوْض نّس يوسّخ. <verse eid="JAS 2:2" /><verse number="3" style="v" sid="JAS 2:3" />كنِّيو ذغْيَا ثقَّارم-اَس إِ ونِّي يݣِّين اَرُّوْض ذ اَصبْحَان: قِّيم شك ذَانِيتَا ذݣ ومْشَان-أَ اَصبْحَان. ثقَّارم-اَس عَاوذ إِ ڒْمسْكِين: شك بدّ ذِيهَا نِغ قِّيم ذَانِيْتَا ذِي ثْمُوْرْث غَار يضَارن نّغ. <verse eid="JAS 2:3" /><verse number="4" style="v" sid="JAS 2:4" />يعْنِي تݣّم س وُوْذمَاون اَك وَايَاوْيَا تْميَّازم جَار يِوْذَان س لأَفْكَار ثِعفَّانِين.<verse eid="JAS 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5" />شُوْف آي أَيثْمَا يمْعِيزّن ينُو، مَا وَار ثسِّينم شَا أَربِّـي يخْضَر ڒْمُسَاكِين ن دُّنشْت-أَ حمَا اَذ يڒِين ذ تْوَاجَر س لْإِيمَان نْسن اَذ وَرْثن ذِي ڒْمُلْك إِي زِي يوْعذ أَربِّـي يِنِّي إِي ث يتْحِبَّان؟ <verse eid="JAS 2:5" /><verse number="6" style="v" sid="JAS 2:6" />وَلَكِن كنِّيو ثْحݣَّرم ڒْمُسَاكِين! مَا وَار ثسِّينم شَا ذ تْوَاجَر إِي كنِّيو إِي ضدْجْمن، تْجَرَّان-كنِّيو غَار لْمَحَاكِيم؟ <verse eid="JAS 2:6" /><verse number="7" style="v" sid="JAS 2:7" />مَا وَار ثسِّينم شَا بلِّي ذ نِثْنِي إِݣ يسَّاوَاڒن س ڒْعِيب ذݣ يِيسم اَصبْحَان ن لْمَسِيح ونِّي إِي زِي ذَاوم تْڒَاغَان يِوْذَان؟<verse eid="JAS 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8" />ڒُوْصِيّث ن وزدْجِيذ يزدْجِيذن إِي د يُوْسِين ذِي لْكِتَاب ثقَّار: "أَذ تخْسذ اَجَّار نّش اَمشْنَاو يخف نّش." كنِّيو اَذ تݣّم مْلِيح مڒَا ثْخدّْمم زَّايس. <verse eid="JAS 2:8" /><verse number="9" style="v" sid="JAS 2:9" />وَلَكِن مڒَا تݣّم س وُوْذمَاون جَار يِوذَان، أَقَا كنِّيو تݣّم ڒْمُعْصِيّث، ثْحكّم خَاوم شَّرِيعَا بلِّي ثعْصَام. <verse eid="JAS 2:9" /><verse number="10" style="v" sid="JAS 2:10" />لِأَنَّا ونِّي يخدّْمن ذِي شَرِيعَا-يَا مَارَّا، مڒَا يخْضَا غِير ذݣ يِجّن ن ڒُوْصِيّث نّس اَتَاف نتَّا يخْضَا ذِي شَرِيعَا اَمن-ثكْمَاڒ. <verse eid="JAS 2:10" /><verse number="11" style="v" sid="JAS 2:11" />لِأَنَّا ونِّي ينَّان: &lt;وَار زنَّا شَا&gt; ينَّا عَاوذ &lt;وَار نقّ شَا.&gt; مڒَا ثنْغِيذ وَار ثزْنِيذ شَا، أَتَاف ثعْصِيذ س شَّرِيعَا.<verse eid="JAS 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 2:12" />إِيوَا سِّيوْڒث ݣّث اَم يِوْذَان إِي خف غَا يحْكم أَربِّـي س شَّرِيعَا نِّي إِي ذِي ثدْجَا لْحُرِّيَا. <verse eid="JAS 2:12" /><verse number="13" style="v" sid="JAS 2:13" />نْهَار ن لْحِيسَاب أَربِّـي وَار يرحّم شَا ونِّي وَار يرحّْمن شَا؛ أَرَّحْمث ثْغدْجب لْحِيسَاب.<verse eid="JAS 2:13" /></para>
  <para style="s1">مِين يعْنَا لْإِيمَان بْڒَا لْحَسَانَاث؟</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14" />آي أَيثْمَا، مِين ث غَا ينفْعن بْنَاذم مڒَا يقَّار نش ذ ڒْمُوْمن وَلَكِن ڒخْذَايم<note caller="+" style="f"><char style="fr" closed="false">2‏.14 </char><char style="ft" closed="false">ذِي لْأَيَاث-أَ نسَّاوَاڒ خ يِجّن ن بْنَاذم يقَّار نش ذ ڒْمُوْمن ذَايِي لْإِيمَان، وَلَكِن ذِي ڒخْذَايم نّس وَار غَارس شَا لْحَسَنَاث. يعْنِي نتَّا ذ لْمُنَفِيق وَاهَا.</char></note> نّس وَار د تسْبيِّيننْت شَا بلِّي نتَّا ذ ڒْمُوْمن؟ مَا ذ لْإِيمَان-أَ إِي ث غَا يسْنجْمن؟ <char style="it">لَّا عمَّارْص!</char> <verse eid="JAS 2:14" /><verse number="15" style="v" sid="JAS 2:15" />أَقَا يشْتن ن وُوْتْشْمَاثْنغ نِغ ذ يِجّن ن وُوْمَاثْنغ وَار غَارس بُو اَرُّوْض إِي غَا يَرض ذَايس جُّوْع. <verse eid="JAS 2:15" /><verse number="16" style="v" sid="JAS 2:16" />ثنِّيذ-اَس شك نِغ ذ حَدّ نّغْنِي: "رُوْح اَذ تشّذ اَذ تَرْضذ اَرُّوْض. أَش يعَاون أَربِّـي اَخَاك يسْهڒ." يعْنِي شك وَار ذَاس ثُوْشِيذ شَا مِين ثحْذَاج دَّات نّس. مَان نّْفَع ذِي مَانَايَا؟ <verse eid="JAS 2:16" /><verse number="17" style="v" sid="JAS 2:17" />لْإِيمَان نّش اَمنِّي مڒَا وَار د يسْبيّن شَا ڒخْذَايم نّس يتْوَاحْسَاب يمُّوْث.<verse eid="JAS 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18" />ئِمْكن شَان يِجّن اَذ يِينِي: "إِيوَا شك ذَايش لْإِيمَان نّش، نش غَارِي ڒخْذَايم ينُو." <char style="it">نش قَّارغ:</char> "شك سْبيّن-اَيِي-د مَامّش يݣَّا لْإِيمَان نّش بْڒَا ڒخْذَايم نّش، نش اَذَاش سْبيّْنغ مَامّش يݣَّا لْإِيمَان ينُو س ڒخْذَايم ينُو." <verse eid="JAS 2:18" /><verse number="19" style="v" sid="JAS 2:19" />شك تَامْنذ بلِّي أَربِّـي نتَّا ذ يجّن؟ إِيوَا مْلِيح، وَلَكِن ؤُڒَا ذ شَّيَاطِين تَامْنن س مَانَاينِّي ترْجِيجِين.<verse eid="JAS 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JAS 2:20" />آي اَرْيَاز، شك ثْقفْڒذ! مَا نش اَذَاوم د سْبيّْنغ بلِّي لْإِيمَان بْڒَا ڒخْذَايم وَار ذَايس بُو نّْفَع؟ <verse eid="JAS 2:20" /><verse number="21" style="v" sid="JAS 2:21" />خْزَر غَار جدِّيثْنغ بْرَاهِيم، أَقَا يحْسب-يث أَربِّـي نِيشَان س مِين يݣَّا بْرَاهِيم وَامِي يقدّم مِّيس إِسْحَاق خ ڒْمذْبح. <verse eid="JAS 2:21" /><verse number="22" style="v" sid="JAS 2:22" />أَقَا تْوَاڒِيذ لْإِيمَان ن بْرَاهِيم يخدّم اَك ڒخْذَايم نّس، أُوْشَا لْإِيمَان نّس يذْوڒ يكْمَاڒ س ڒخْذَايم-أَ إِي يݣَّا. <verse eid="JAS 2:22" /><verse number="23" style="v" sid="JAS 2:23" />ذ وَا ذ ڒْمَعْنَا ن وَاوَاڒ نِّي ن أَربِّـي ذِي لْكِتَاب وَامِي ينَّا: "أُوْشَا يُوْمن بْرَاهِيم زِي أَربِّـي، ئِكَّر أَربِّـي يسمْصْڒَاح-يث اَكِذس س لْإِيمَان نِّي." أَمنِّي إِݣ يجَّا أَربِّـي بْرَاهِيم ذ اَمدُّوْكڒ نّس. <verse eid="JAS 2:23" /><verse number="24" style="v" sid="JAS 2:24" />كنِّيو يسْبيّن-اَوم-د أَربِّـي يحسّب بْنَاذم نِيشَان مَاشِي غِير س لْإِيمَان نّس أُو صَافِي، ؤُڒَا س ڒخْذَايم نّس.<verse eid="JAS 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25" />أَمنِّي ؤُڒَا ذ ثَحنْجِيرْث نِّي ؤُمِي قَّارن رِيحَاب تُوْغَا ثفّغ اَبْرِيذ، يحْسب-يت أَربِّـي نِيشَان س مِين ثݣَّا وَامِي ثْرحّب زِي ثْنَاين نِّي ن لْمُخَابَرَات، <char style="it">ثْسنْجم-يثن</char> ثسّكّ-يثن خ يِجّن ن وبْرِيذ نّغْنِي. <verse eid="JAS 2:25" /><verse number="26" style="v" sid="JAS 2:26" />شُوْف، دَّات ن بْنَاذم بْڒَا بُوْحْبڒ ثمُّوث، أَمنِّي لْإِيمَان بْڒَا ڒخْذَايم يمُّوْث.<verse eid="JAS 2:26" /></para>
  <chapter eid="JAS 2" />
  <chapter number="3" style="c" sid="JAS 3" />
  <para style="s1">شَّرّْ إِي يدْجَان ذݣ يِيڒس</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1" />آي أَيثْمَا، ئِتْخصَّا وَار زَّايْوم يتِيڒِي بُو اَطَّاس ن يمْسڒْمَاذن، أَقَا ثسّْنم بلِّي نشِّين يمْسڒْمَاذن اَتَاف اَخَانغ يزيَّار أَربِّـي ذِي لْحِسَاب. <verse eid="JAS 3:1" /><verse number="2" style="v" sid="JAS 3:2" />مَارَّا إِذْنغ نْتݣّ اَطَّاس ن لْغَالَط. مڒَا شَان يِجّن وَار يخطِّي شَا ذݣ وَاوَاڒ نّس قَاع، أَتَاف وَانِيتَا ذ يجّن ن بْنَاذم نِيشَان يكْمَاڒ. ئِزمَّر اَذ يحْكم خ دَّات نّس مَارَّا.<verse eid="JAS 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JAS 3:3" />خْمِي نْتݣّ سْڒِيمث ذݣ وقمُّوْم ن يكِيْدَّارن، نْندّه-يثن مَانِي مَا نخْس. <verse eid="JAS 3:3" /><verse number="4" style="v" sid="JAS 3:4" />شُوْف عَاوذ، أَغَرَّابُو وَاخَّا ذ اَمقّْرَان اَطَّاس يذفّع-يث أَرِّيح يجهْذن، وَلَكِن اَرَّايس يزمَّر اَث ينْده س يِجّن ن دْمَام ذ اَمزْيَان اَث ينْده مَانِي مَا يخس.<verse eid="JAS 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 3:5" />ؤُڒَا ذ يڒس نّغ نتَّا ذ يجّن ن ثْمسْڒَايْث ذ ثَمزْيَانْت ذِي دَّات نّغ، وَلَكِن يتفْتَاخَر س ثْمسْڒَايِين ثِمقّْرَانِين. شُوْف، ئِجّن ن ڒْغَابث ذ ثَمقّْرَانْت ثسْحَرّق-يت يجّن ن ثْڒُوْقِيت ذ ثَمزْيَانْت! <verse eid="JAS 3:5" /><verse number="6" style="v" sid="JAS 3:6" />ئِڒس نتَّا ذ يجّن ن ثْمسِّي ذَايس شَّرّْ اَطَّاس يسْوسَّاخ مَارَّا مِين غَارْنغ ذِي دَّات نغ. ئِسْرُوْغَا ثِمسِّي ذِي مَارَّا ثُوْذَارْث نّغ، عَاوذ نتَّا س يِيخف نّس ثسْرُوْقّ-يث ثْمسِّي ن جَهنَّمَا.<verse eid="JAS 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 3:7" />ئِزمَّر بْنَاذم اَذ يربَّا ڒُحُوْش ذ يِجْضَاض ذ مِين يتنْحُوْرُوْذن ذ مِين يتْعِيشن ذِي ڒبْحر مْكُڒ نُّوْع، أُو ذ صَّح نتَّا يتْربَّا-ثن. <verse eid="JAS 3:7" /><verse number="8" style="v" sid="JAS 3:8" />وَلَكِن بْنَاذم وَار يزمَّر اَذ يربَّا يڒس نّس، مَايمِّي؟ نتَّا ذ يجّن ن شَّرّْ وَار يدْجِي ؤُو إِي ث غَا يسْبدّن يعمَّر س سّم ينقّن.<verse eid="JAS 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 3:9" />زَّايس إِي نْحمّذ سِيذِي أَربِّـي بَابَاثْنغ. مَا زَّايس عَاوذ إِي زِي غَا ننْعڒ يرْيَازن إِي د يخْڒق أَربِّـي خ صِّفث نّس؟ <verse eid="JAS 3:9" /><verse number="10" style="v" sid="JAS 3:10" />وَاش زݣ يِجّن ن وقمُّوْم إِي زِي غَا نْسُوْفغ شُّكر ذ نَّعْڒث؟ لَّا آي أَيثْمَا، مَانَايَا يتْخصَّا وَار يتِيڒِي شَا. <verse eid="JAS 3:10" /><verse number="11" style="v" sid="JAS 3:11" />مَا زمَّرن اَذ فّْغن وَامَان ذ يمِيزِيضن ذ يمرْزَاݣن زݣ يِجّن ن ڒْعُنْصَر؟ <verse eid="JAS 3:11" /><verse number="12" style="v" sid="JAS 3:12" />لَّا آي أَيثْمَا. مَا ثزمَّر ثْشجَّارْث ن ثَازَارْث اَذ تَارو زِّيتُون، نِغ ثْزَايَارْث وضِيڒ اَذ تَارو ثَازَارْث؟ لَّا. ؤُڒَا ذ ڒْعُنْصَر اَمدْجَاح وَار يزمَّر اَذ د يسُوْفغ اَمَان ذ يمِيزِيضن.<verse eid="JAS 3:12" /></para>
  <para style="s1">ثَانِيتَا ذ ڒفْهَامث ن صَّح إِي د يُوْسِين زِي أَربِّـي</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13" />مَا ٱكِذْوم ونِّي إِي ذِي ثدْجَا ڒفْهَامث ذ ثُوْسْنَا؟<note caller="+" style="f"><char style="fr" closed="false">3‏.13 </char><char style="ft" closed="false">ثُوْسْنَا نتَّاث ذ لْمَعْرِفَا.</char></note> ئِتْخصَّا-يَاس اَذ د يسْمظْهَار مَانَايَا س مَامّش يتْعِيش س لْمَعْقُوْل ذ لْحَسَانَاث نّس إِݣ يتݣّ اَك يِجّن ن تَّوَاضُع إِي د يتَاسن س ڒفْهَامث. <verse eid="JAS 3:13" /><verse number="14" style="v" sid="JAS 3:14" />وَلَكِن مڒَا ذَايْوم ڒحْسذ ذ اَعفَّان ذ لْأَنَانِيَا، وَار تفْتَخَارث شَا س يِيخف نْوم. يعْنِي يتْخصَّا-يَاوم كنِّيو وَار ثسْخرِّيقم شَا خ لْحَقِيقَا. <verse eid="JAS 3:14" /><verse number="15" style="v" sid="JAS 3:15" />نُّوْع ن ڒفْهَامث-أَ وَار د تْهوِّي شَا زݣ وجنَّا؛ لَّا، نتَّاث ن دُّنشْت-أَ ن يِوذَان ن شِّيطَان. <verse eid="JAS 3:15" /><verse number="16" style="v" sid="JAS 3:16" />مِينْزِي مَانِي مَا يدْجَا ڒحْسذ ذ لْأَنَانِيَا، ذِنِّي ؤُڒَا ذ ڒْفَوْضَا ذ كُڒ شَّرّْ.<verse eid="JAS 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 3:17" />ڒفْهَامث إِي د يهوَّان زݣ وجنَّا، مِين ذَايس مُهِم قَاع اَذ تِيڒِي ثصْفَا. نتَّاث عَاوذ ذَايس ڒهْنَا ذ صّْبَار، وَار ذَايس تِيڒِي بُو ثْغنَّانْت. ثشُّوْر س أَرَّحْمث ذ لْحَسَنَاث، وَار ذَايس بُو وُوْذمَاون نِغ ذ نِّفَاق. <verse eid="JAS 3:17" /><verse number="18" style="v" sid="JAS 3:18" />يِنِّي يسمْصْڒَاحن يوْذَان زرّْعن مَانَاينِّي، أَتَاف اَذ مْجَرن يجّن ن ثْفدْجَاحْث ن ڒْحَقّ.<verse eid="JAS 3:18" /></para>
  <chapter eid="JAS 3" />
  <chapter number="4" style="c" sid="JAS 4" />
  <para style="s1">ئِبْرِيذن ن دُّنشْت-أَ تْعَارَّاضن إِ أَربِّـي</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1" />إِيوَا يخَرْوِيضن ذ يمنْغِيْون يتِيڒِين جَارَاوم، مَانِيس د تكّن؟ تكّن-د زِي شّهَاوَاث نْوم ثِعفَّانِين إِي يتْمنْغَان غَار ذَاخڒ نْوم. <verse eid="JAS 4:1" /><verse number="2" style="v" sid="JAS 4:2" />خْمِي وَار تِيفم شَا كنِّيو خ مِينْخف ثْرزُّوْم، أَتَاف ثْنقّم. تْمنْغَام تمْنَاقَارم جَارَاوم، مَايمِّي؟ لِأَنَّا كنِّيو وَار ثْزمَّرم شَا اَذ تَاوْضم غَار مِين ثْعشّْقم. وَار غَارْوم شَا، مَايمِّي؟ لِأَنَّا كنِّيو وَار تتَّارم شَا إِ أَربِّـي. <verse eid="JAS 4:2" /><verse number="3" style="v" sid="JAS 4:3" />خْمِي ذَاس تتَّارم وَار ذَاوم د يتِيشّ شَا، مَايمِّي؟ لِأَنَّا كنِّيو تْغَالَّاطم ذِي مِين ذَاس تتَّارم، ثخْسم اَذ تْسعّْفم شّهَاوَاث نْوم أُو صَافِي.<verse eid="JAS 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JAS 4:4" />آ يِنِّي يخدّْعن، كنِّيو مَا وَار ثسِّينم شَا بلِّي ونِّي يتخْسن دُّنشْت-أَ ذ ونِّي ذ ڒْعَذُو ن أَربِّـي؟ وَاه، ونِّي يخْضَرن دُّنشْت-أَ قَا نتَّا نِيشَان ذ ڒْعَذُو ن أَربِّـي. <verse eid="JAS 4:4" /><verse number="5" style="v" sid="JAS 4:5" />اَوَاڒ ن لْكِتَاب يقَّار: &lt;أَرُّوْح نِّي إِي ذَايْنغ يݣَّا أَربِّـي يْعِيزّ خَاس اَطَّاس.&gt; مَا تْغِير-أَوم اَوَاڒ نِّي وَار غَارس بُو ڒْمَعْنَا؟ <verse eid="JAS 4:5" /><verse number="6" style="v" sid="JAS 4:6" />وَلَكِن نتَّا يَرْنِي-يَانغ-د اَرْضَا <char style="it">زَّايس</char>. س مَانَايَا يقَّار لْكِتَاب: &lt;أَربِّـي اَقَاث ضد ن يِنِّي يسمْغَارن يخف نْسن، يِنِّي يسمْزَاين يخف نْسن يتِيشّ-اَسن اَرْضَا <char style="it">نّس</char>.&gt;<verse eid="JAS 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7" />س مَانَايَا طَاعث إِ أَربِّـي. عَرّْضث إِ إِبْڒِيس، أَزَّايْوم يَرْوڒ. <verse eid="JAS 4:7" /><verse number="8" style="v" sid="JAS 4:8" />أَذْسث غَار أَربِّـي، نتَّا اَغَارْوم د يَاذس. آ يِنِّي يخْضَان، سِيرْذث يفَاسّن نْوم. آ يِنِّي كُڒ ڒَعْقڒ مِين ذَاوم يقَّار، سصْفَاث ؤُڒَاون نْوم. <verse eid="JAS 4:8" /><verse number="9" style="v" sid="JAS 4:9" />خيّْقم، حزْنم، تْرُوْم. بدّْڒم ثَضحَّاشْت نْوم غَار يمطَّاون ذ ڒفْرَاحْث نْوم غَار وخِيّق. <verse eid="JAS 4:9" /><verse number="10" style="v" sid="JAS 4:10" />سمْزْيث يخف نْوم زَّاث إِ سِيذِي أَربِّـي، نتَّا اَكنِّيو يسمْغَار.<verse eid="JAS 4:10" /></para>
  <para style="s1">وَار تْعيَّاب شَا ؤُمَاش</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11" />آي أَيثْمَا، وَار قَّارث بُو ڒْبَاطڒ خ وَايَاوْيَا. مِينْزِي ونِّي يقَّارن ڒْبَاطڒ خ وُوْمَاس نِغ يتْعيَّاب-يث، أَتَاف يقَّار ڒْبَاطڒ خ شَّرِيعَا يتْعيَّاب-يت. خْمِي تْعيَّابذ شَّرِيعَا اَتَاف شك وَار زَّايس ثخدّْمذ شَا؛ لَّا، أَتَاف شك ذ ڒْقَاضِي نّس وَاهَا. <verse eid="JAS 4:11" /><verse number="12" style="v" sid="JAS 4:12" />ذِنِّي يجّن إِݣ يݣِّين شَّرِيعَا نتَّا عَاوذ ذ ڒْقَاضِي، <char style="it">نتَّا ذ أَربِّـي</char>. نتَّا وَاحْذس إِݣ يزمَّرن اَذ يسنْجم يزمَّار اَذ يسفْنَا، وَلَكِن مِين ثعْنِيذ شك تْعيَّابذ اَجَّار نّش؟<verse eid="JAS 4:12" /></para>
  <para style="s1">ذݣ وفُوْس ن أَربِّـي إِي ذِي ثدْجَا ثُوْذَارْث نّغ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13" />صنّْطث مْلِيح آ يِنِّي يقَّارن، "يَالَّاهث أَ نْرَاح نْهَارَا نِغ ثِيوشَّا غَار ثنْدِينْت-ين نِغ غَار ثنْدِينْت-أَ، أَ نْسعْذُو ذِنِّي لْعَام أَ نݣّ تِّجَارَا بَاش أَ نرْبح." <verse eid="JAS 4:13" /><verse number="14" style="v" sid="JAS 4:14" />إِيوَا، مَا ثسّْنم مِين غَا يوقْعن ثِيوشَّا؟ لَّا، أَقَا ثُوْذَارْث نْوم تݣّ اَم يِجّن ن ثْسيْنُوْت، تْمظْهَار-د ذغْيَا، ذغْيَا تْرَاح. <verse eid="JAS 4:14" /><verse number="15" style="v" sid="JAS 4:15" />ئِتْخصَّا-يَاوم اَذ تِينِيم اَمُّو: &lt;مڒَا يخس سِيذِي أَربِّـي أَ ندَّر، أَ نݣّ شّْغڒ-أَ نِغ ذ شّْغڒ-ين.&gt; <verse eid="JAS 4:15" /><verse number="16" style="v" sid="JAS 4:16" />وَلَكِن ڒخُّو كنِّيو تفْتَخَارم، تْسمْغَارم يخْف نْوم. مَارَّا تَّكبُّر-أَ ٱم وَانِيتَا نتَّا ذ شَّرّْ. <verse eid="JAS 4:16" /><verse number="17" style="v" sid="JAS 4:17" />ونِّي يتْوَاڒَان شَان ن ڒْخِير اَث يݣّ، مڒَا وَار ث يݣِّي شَا يتْوَاحْسَاب-اَس ذ ڒْمُعْصِيّث.<verse eid="JAS 4:17" /></para>
  <chapter eid="JAS 4" />
  <chapter number="5" style="c" sid="JAS 5" />
  <para style="s1">شَّرّْ ن تْوَاجَر يضدْجْمن يوْذَان</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1" />يَلَّاهث آ تْوَاجَر، صنّْطث مْلِيح! تْرُوْث، سْغُوْيث خ لْمُصِيبَاث إِي خَاوم د غَا يهْوَان. <verse eid="JAS 5:1" /><verse number="2" style="v" sid="JAS 5:2" />أَݣْڒَا نْوم يخْسَر، أَرُّوْض نْوم شِّين-ث ثْكشَّاوِين. <verse eid="JAS 5:2" /><verse number="3" style="v" sid="JAS 5:3" />دّْهب نْوم ذ نُّقَارْث نْوم اَرْشَانْت، ثَرْشِيث نِّي اَذ تشْهذ ضد نْوم اَذ تشّ اَيْسُوْم نْوم اَم ثْمسِّي. كنِّيو ثْخزّْنم اَݣْڒَا س وَاطَّاس إِ يِيخف نْوم ذِي ڒْعَهذ-أَ اَنݣَّارُو.<verse eid="JAS 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JAS 5:4" />إِيوَا، كنِّيو وَار تْخدْجِيسم شَا يشوَّارن إِي ذَاوم يمجَّارن ذݣ يمَرْجعِيون نْوم، تخْڒِيسث نْسن ثسْغُوْيِو-د تْشثْشَا زَّايْوم. ثْغُوْيّث نِّي ن يشوَّارن يتسْڒَا-يَاس سِيذِي أَربِّـي لْعَلَمِين. <verse eid="JAS 5:4" /><verse number="5" style="v" sid="JAS 5:5" />كنِّيو تْعِيشم ذِي دُّنشْت-أَ س وفلّس ذ شّهْوث نْوم. ثْذوْڒم ثْصَاحّم ثْوجْذم اَم يينْدُوْزن ذِي نْهَار نِّي إِي ذِي ذَاسن غَا غَرْصن. <verse eid="JAS 5:5" /><verse number="6" style="v" sid="JAS 5:6" />ثْحكْمم خ يِنِّي يدْجَان نِيشَان، ثنْغِيم-ثن بْڒَا مَا ذَاوم عَارّْضن.<verse eid="JAS 5:6" /></para>
  <para style="s1">لَابُد صّْبَار ذݣ وعدّب</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7" />آي أَيثْمَا، صْبَارث اَڒ د غَا يَاس سِيذِيثْنغ. خْزَرث غَار وفدْجَاح مَامّش يتْرَاجَا ثَفدْجَاحْث ن ثْمُوْرْث نّس، ئِتْرَاجَا-ت س يِجّن ن صّْبَار اَڒ غَا يُوْوث ونْࢲَار اَمزْوَارُو ذ ونِّي اَنݣَّارُو. <verse eid="JAS 5:7" /><verse number="8" style="v" sid="JAS 5:8" />ؤُڒَا ذ كنِّيو صْبَارث شجّْعث يخف نْوم مِينْزِي سِيذِيثْنغ عْڒَاين اَذ د يعْقب.<verse eid="JAS 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9" />آي أَيثْمَا، وَار سَّاوَاڒث شَا ذݣ وَايَاوْيَا حمَا وَار تْوَاعِيقِيبم شَا؛ قَا ونِّي يتحْكَامن يبدّ-د غَار ثوَّارْث. <verse eid="JAS 5:9" /><verse number="10" style="v" sid="JAS 5:10" />آي أَيثْمَا، ذْفَارث اَبْرِيذ ن لْأَنْبِيَا يِنِّي إِݣ يسِّيوْڒن س يِيسم ن سِيذِي أَربِّـي نِثْنِي تْوَاعدّْبن صبَّارن. <verse eid="JAS 5:10" /><verse number="11" style="v" sid="JAS 5:11" />أَقَا ثسّْنم يِنِّي يصْبَارن نْتحْسَاب-يثن غَارْسن سَّعْذ. كنِّيو ثسْڒِيم خ صّْبَار نِّي ن نَّبِي أَيُوْب، ثسّْنم مَامّش ث يبَرك سِيذِي أَربِّـي ذݣ ونݣَّارُو مِينْزِي سِيذِي أَربِّـي نتَّا ذ اَحْنِين ذ اَرَحِيم.<verse eid="JAS 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12" />آي أَيثْمَا، أَقَا مِين يدْجَان مُهِم. وَار تْجَادْجَام شَا س وجنَّا نِغ س ثْمُوْرْث نِغ س شَان ثْمسْڒَايْث نّغْنِي. إِيوَا، خْمِي غَا ثِينِيم وَاه، ئِنِيث وَاه. خْمِي غَا ثِينِيم لَّا، ئِنِيث لَّا. حمَا وَار خَاوم د يهوِّي شَا لْعِقَاب.<verse eid="JAS 5:12" /></para>
  <para style="s1">جّْهذ ن ثْࢲَادْجِيث</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13" />مڒَا ذِين شَان يجّن جَارَاوم يتْوَاعدَّاب، ئِتْخصَّا-يَاس اَذ يࢲَّادْج. مڒَا ذِين شَان يِجّن جَارَاوم يفَرّح، ئِتْخصَّا-يَاس اَذ يغنّج إِ أَربِّـي. <verse eid="JAS 5:13" /><verse number="14" style="v" sid="JAS 5:14" />مڒَا ذِين شَان يِجّن جَارَاوم يتْنزْبَار، ئِتخصَّا-يَاس اَذ د يڒَاغَا خ يمقّْرَانن ن جْمَاعْث ن ڒْمُوْمِنِين اَخَاس ࢲَّادْجن اَث دهْنن س زّشْت س يِيسم ن سِيذِيثْنغ. <verse eid="JAS 5:14" /><verse number="15" style="v" sid="JAS 5:15" />أُو ثْࢲَادْجِيث نِّي ثنِّي يتْقدَّامن س لْإِيمَان اَذ تسْݣنْفَا ونِّي يدْجَان عِيَّان. سّنِّي سِيذِيثْنغ اَث يسْبدّ. مڒَا يݣَّا ڒْمُعْصِيّث، أَذَاس يغْفَر. <verse eid="JAS 5:15" /><verse number="16" style="v" sid="JAS 5:16" />عْتَرْفث س ڒْمُعْصِيَاث نْوم كنِّيو إِ وَايَاوْيَا، ࢲَّادْجث خ وَايَاوْيَا حمَا ٱذ تْݣنْفَام. ثْࢲَادْجِيث ن بْنَاذم إِݣ يدْجَان نِيشَان نتَّاث ذَايس جّْهذ اَطَّاس نتَّاث ثفْسُوْس.<verse eid="JAS 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 5:17" />تُوْغَا نَّبِي إِلْيَاس نتَّا ذ بْنَاذم اَم نشِّين، ئِتْࢲَادْجَا اَطَّاس حمَا وَار يشِّيث بُو ونْࢲَار. ئِكَّا ثڒْت سْنِين ذ وزْين وَار يُوْوْثِي بُو ونْࢲَار خ ثْمُوْرْث. <verse eid="JAS 5:17" /><verse number="18" style="v" sid="JAS 5:18" />منْبَعْد عَاوذ يࢲُّوْدْج، يُوْوْثَا ونْࢲَار خ ثْمُوْرْث ثصْڒَاح ثْفدْجَاحْث نّس.<verse eid="JAS 5:18" /></para>
  <para style="p">
    <verse number="19‏-20" style="v" sid="JAS 5:19-20" />آي أَيثْمَا، شَان يِجّن زَّايْوم يفّغ اَبْرِيذ ن لْحَقِيقَا. مڒَا يَارِّي-ث-يد شَان يِجّن نّغْنِي، ئِتْخصَّا-كنِّيو ٱذ تسّْنم بلِّي ونِّي إِي ثِيذ يَارِّين زݣ وبْرِيذ نّس ن ڒْبَاطڒ اَتَاف يسنْجم-يث زِي ڒفْنَا نّس اَتَاف اَذ تْوَاغْفَرنْت اَطَّاس ن ڒْمُعْصِيَاث.<verse eid="JAS 5:19-20" /></para>
  <chapter eid="JAS 5" />
</usx>