<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ACT" style="id">,23 May 2003, Printed Version</book>
  <para style="h">ارسل</para>
  <para style="toc3">ڒخ</para>
  <para style="toc2">ڒخذايم</para>
  <para style="toc1">ڒخْذَايم ن اَرُّسُل</para>
  <para style="mt1">ڒخْذَايم ن اَرُّسُل</para>
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="s">لْمَسِيح يتْݣَعَّاذ غَار وجنَّا</para>
  <para style="p">
    <verse number="1‏-2" style="v" sid="ACT 1:1-2" />آ سِي تَاوْفِيلُوْس، لْكِتَاب اَمزْوَارُو إِي ؤُرِيغ نش ذَايس مَارَّا مِين يݣَّا عِيْسَى ذ مِين يسڒْمَاذ اَڒ نْهَار نِّي وَامِي يتْوَارْفع. نتَّا قْبڒ <char style="it">مَا ٱذ يتْوَارْفع</char>، ئِوصَّا س أَرُّوْح يقدّْسن اَرُّسُل إِي تُوْغَا يخْضَر ينَّا-ٱسن مِين غَا ݣّن. <verse eid="ACT 1:1-2" /><verse number="3" style="v" sid="ACT 1:3" />وَامِي يعْذُو ڒَعْذَاب ن ڒْموْث نّس، يتْمظْهَار-اَسن-د خ يِجّن ن اَرْبعِين يُوْم يسفْهَام-يثن مبْڒَا شّكّ نتَّا اَقَا يدَّر. ئِتَاس-د غَارْسن يسَّاوَاڒ اَكِذْسن خ ڒْمُلْك ن أَربِّـي. <verse eid="ACT 1:3" /><verse number="4" style="v" sid="ACT 1:4" />وَامِي تُوْغَا اَكِذْسن يتتّ، ئِوصَّا-ثن ينَّا-ٱسن: "وَار تفّْغم شَا زِي ثنْدِينْت ن لْقُدْس. رَاجَام اَڒ د غَا يَاس مِين يوْعذ بَابَا إِي خف ذَاوم تُوْغَا سِّيوْڒغ. <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" />يعْنِي يَحْيَى يطهَّار إِ يِوْذَان س وَامَان، كنِّيو وَار ذَاوم يقِّيم شَا اَذ تْوَاطهَّارم س أَرُّوْح يقدّْسن."<verse eid="ACT 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />وَامِي مُوْنن <char style="it">اَرُّسُل</char> اَك عِيْسَى نَّان-اَس: "آ سِيذِي، مَا ذݣ وُوْسَّان-أَ إي د غَا ثَارّذ ڒحْكَام غَار أَيث-إِسْرَائِيل؟"<verse eid="ACT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 1:7" />ينَّا-ٱسن عِيْسَى: "وَار ذَاوم يتْوَاسْمح شَا اَذ تسّْنم لْأَوْقَات نِغ ذ تَّوَارِيخ تُوْغَا يݣَّا بَابَا س سُّلْطَا نّس. <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" />وَلَكِن اَخْمِي خَاوم د غَا يهْوَا أَرُّوْح يقدّْسن، أَغَارْوم يِيڒِي جّْهذ. أَخَافِي ثْشهْذم ذِي ثنْدِينْت ن لْقُدْس ذ مَارَّا ثِمُوْرَا ن يَهُوْذِيَا ذ سَمَارْيَا اَڒ طَّارْف ونݣَّارُو ن دُّنشْت-أَ."<verse eid="ACT 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 1:9" />غِير يكمّڒ عِيْسَى اَوَاڒ نّس، ئِتْوَارْفع غَار وجنَّا. قِّيمن تْخزَّرن ذَايس أُوْشَا يودَّار-اَسن ذݣ وسيْنُو.<note caller="+" style="f"><char style="fr" closed="false">1‏.9 </char><char style="ft" closed="false">أَسيْنُو نتَّا ذ اَسݣْنُو.</char></note> <verse eid="ACT 1:9" /><verse number="10" style="v" sid="ACT 1:10" />قِّيمن تْخزَّرن مْلِيح وَامِي يُوْڒِي غَار وجنَّا، عْلَاغَفْلَا ؤُفِين اَكِذْسن ثْنَاين ن يثَرَّاسن بدّن، غَارْسن اَرُّوْض ذ اَشمْڒَاڒ.<note caller="+" style="f"><char style="fr" closed="false">1‏.10 </char><char style="ft" closed="false">ئِثَرَّاسن-أَ نِثْنِي ذ لْمَلَايْكَاث، غَارْسن صِّفث ن بْنَاذم.</char></note><verse eid="ACT 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 1:11" />نَّان-اَسن: "آي يرْيَازن ن ثْمُوْرْث ن لْجَلِيل، مَايمِّي عَاذ ثْبدّم ذَانِيتَا تْخزَّرم ذݣ وجنَّا؟ قَا عِيْسَى-يَا وَانِيتَا إِي ذَاوم يتْوَارْفْعن غَار وجنَّا، مَامّش ث ثࢲْرِيم يݣَعّذ غَار وجنَّا اَمنِّي إِي د غَا يذْوڒ."<verse eid="ACT 1:11" /></para>
  <para style="s">تِيخْضَارن ونِّي غَا يِيڒِين ذݣ ومْشَان ن يهُوْذَا</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />سّنِّي ذوْڒن-د اَرُّسُل زݣ وذْرَار ن زِّيتُوْن غَار ثنْدِينْت ن لْقُدْس إِي يݣّْوْجن س يِجّن ن كِيلُوْمِت. <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" />وَامِي ؤُوْضن، ݣَعّْذن غَار ثْغُوْرْفَات<note caller="+" style="f"><char style="fr" closed="false">1‏.13 </char><char style="ft" closed="false">ثْغُوْرْفَات نتَّاث ذ يجّن ن وخَّام خ ثدَّارْث ذݣ وجنَّا.</char></note> مَانِي تِيڒِين: بُطْرُس ذ يُوْحَنَّا ذ يَعْقُوْب ذ أَنْدْرُوْس، ذ فِيلِيپَّـاس ذ تُوْمَا، ذ بَارْتُوْلُوْمَاي ذ مَتَّى، ذ يَعْقُوْب مِّيس ن حَلْفَى ذ سِمْعَان لْمُنَاضِل، ذ يَهُوْذَا مِّيس ن يَعْقُوْب. <verse eid="ACT 1:13" /><verse number="14" style="v" sid="ACT 1:14" />يِيْنَا كُڒ نْهَار تْمُوْنن مَارَّا س يِجّن ن لْفِكْرَا تْࢲَادْجَان، اَكِذْسن شَان ن ثمْغَارِين ذ مَرْيَم يمَّاس ن عِيْسَى ذ اَيثْمَاس.<verse eid="ACT 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15" />ذݣ وُوْسَّان نِّي يكَّر بُطْرُس يبدّ ذِي ڒْوسْط ن ڒْمُوْمِنِين (ذِنِّي شَان مِيَّا أُو عِشْرِين إِذْسن) ينَّا-ٱسن: <verse eid="ACT 1:15" /><verse number="16" style="v" sid="ACT 1:16" />"آي اَيثْمَا، تُوْغَا يتْخصَّا اَذ يكمّڒ وَاوَاڒ ن أَرُّوْح يقدّْسن إِي د يُوْسِين خ يِيڒس ن نَّبِي دَاود ذݣ يِجّن ن زْمَان وَامِي يسِّيوڒ خ يَهُوْذَا يعْنِي ونِّي يزنْزن عِيْسَى يسْبيّن-اَسن اَبْرِيذ يُوْوِي يِنِّي إِي ث يطّْفن. <verse eid="ACT 1:16" /><verse number="17" style="v" sid="ACT 1:17" />يَهُوْذَا-يَا تُوْغَا يتْوَاحْسَاب زَّايْنغ، يُوْذف اَكِذْنغ ذِي ڒْخذْمث ن أَربِّـي. <verse eid="ACT 1:17" /><verse number="18" style="v" sid="ACT 1:18" />س تْمنْيَاث نّس إِݣ يطّف ن لْحَرَام، ئِرُوْح يسْغَا زَّايْسنْت يجّن ن ثْمُوْرْث. ذِنِّي إِي يوْضَا س جّْهذ خ وُوْذم نّس، ئِدُّوْقّز-اَس وعدِّيس منْضَارن-اَس-د مَارَّا وَاذَان نّس. <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />أَرِّين-اَس-د ڒخْبَار مَارَّا اَيثْبَاب ن لْقُدْس. خ مَانَاينِّي سمَّان-اَس إِ ثْمُوْرْث نِّي س وَاوَاڒ نْسن &lt;حَقل دَمَّا&gt; يعْنِي &lt;ئِيْير ن يذَامّن.&gt;<note caller="+" style="f"><char style="fr" closed="false">1‏.19 </char><char style="ft" closed="false">نتَّا ذ يݣر ن دّم. يعْنِي ذ يسم ن يِج ومَرْجع.</char></note><verse eid="ACT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20" />ئِقَّار لْكِتَاب ن زَّبُوْر: أَربِّـي اَذ يخْڒَا ثَدَّارْث ن ونِّي وَار ذَايس يزدّغ حَدّ. ئِقَّار عَاوذ: ڒْخذْمث نّس اَت يطّف يجّن نّغْنِي.<verse eid="ACT 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 1:21" />إِذن، ئِتْخصَّا أَ نخْضَر يجّن ن ورْيَاز زݣ يِنِّي تُوْغَا يدْجَان اَكِذْنغ مَارَّا ڒْوقْث نِّي وَامِي سِيذِيثْنغ عِيْسَى يتَاذف يتفّغ خَانغ. <verse eid="ACT 1:21" /><verse number="22" style="v" sid="ACT 1:22" />يعْنِي زݣ وَامِي إِي ث يطهَّار يَحْيَى س وَامَان اَڒ وَامِي يتْوَارْفع خَانغ غَار وجنَّا. أَرْيَاز-أَ يتْخصَّا اَكِذْنغ يشْهذ قَا <char style="it">عِيْسَى</char> يكَّر-د زِي ڒْموْث."<verse eid="ACT 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23" />كَّرن قدّْمن ثْنَاين ن يِوْذَان: يجّن قَّارن-اَس مَاتْيَاس يجّن قَّارن-اَس يُوْسف. يُوْسف نِّي عَاوذ قَّارن-اَس بَارْسَابَا نِغ يُوْسْتُوْس. <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />تَّارن-اَس إِ أَربِّـي، نَّان-اَس: "آ سِيذِي أَربِّـي قَا شك ثسّْنذ مِين يدْجَان ذݣ وُوْڒَاون ن يِوْذَان مَارَّا. سظْهَار-اَنغ-د ونِّي إِي ثِيخْضَرذ زِي ثْنَاين-أَ. <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />أَكِذْنغ يِيڒِي ذِي ڒْخذْمث-أَ، أَذ يذْوڒ ذ اَرَّسُوْل ذݣ ومْشَان ن يَهُوْذَا ونِّي إِݣ يسمْحن ذِي ڒْخذْمث-أَ يرُوْح غَار ومْشَان نّس <char style="it">اَعفَّان</char>." <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />أُوْشَا ݣِّين لْقُرْعَا، لْقُرْعَا نِّي ثُوْسَا-د ذِي مَاتْيَاس، اَرْنِين-ث-يذ غَار حِيطَاش نّي ن اَرُّسُل.<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="s">أَرُّوْح يقدّْسن يهوَّا-د خ ڒْمُوْمِنِين</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />وَامِي د يُوْوض ڒْعِيذ ن نْهَار وِيس خمْسِين،<note caller="+" style="f"><char style="fr" closed="false">2‏.1 </char><char style="ft" closed="false">ڒْعِيذ ن نْهَار وِيس خمْسِين ذ يجّن ن ڒْعِيذ ن أَيث-إِسْرَائِيل يتَاس-اَسن-د خمْسِين يُوْم منْبَعْد إِ ڒْعِيذ اَمقّْرَان نْسن.</char></note> مُوْنن مَارَّا <char style="it">ڒْمُوْمِنِين</char> ذݣ يِجّن ن ومْشَان. <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />عْلَاغَفْلَا يهْوَا-د يجّن ن ڒْحسّ زݣ وجنَّا اَم اَرِّيح إِي يتْصُوْضن س جّْهذ، يُوْذف ذِي مْكُڒ جِّهث ن ثدَّارْث مَانِي قِّيمن. <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />ࢲْرِين يڒسَاون اَم يصْفضَاون ن ثْمسِّي يرُوْح كُڒ يِيڒس وَاحْذس يمَارْس يج يج خ كُڒ يجّن زَّايْسن. <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />شُّوْرن س أَرُّوْح يقدّْسن مَارَّا إِذْسن، بْذَان سَّاوَاڒن س لُّغَاث وَار يدْجِين بو نْسن اَمشْنَاو مَامّش ذَاسن يُوْشَا أَرُّوْح اَذ سِّيوْڒن.<verse eid="ACT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5" />ذِنِّي شَان يرْيَازن زِي أَيث-إِسْرَائِيل تݣّْوْذن أَربِّـي تْزُوْرَان غَار لْقُدْس، نِثْنِي زِي مَارَّا ثِمُوْرَا ن دُّنشْت-أَ. <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />يرْيَازن نِّي وَامِي سْڒَان إِ ڒْحسّ نِّي ؤُسِين-د مُوْنن ذِنِّي قِّيمن تْعجّْبن، مْكُڒ يجّن يتسْڒَا إِ لُّغَا نّس. <verse eid="ACT 2:6" /><verse number="7" style="v" sid="ACT 2:7" />ذهّْشن تْعجّْبن نَّان جَارَاسن: "مَارَّا يوْذَان-أَ إِي سَّاوَاڒن لْأَصل نْسن زِي ثْمُوْرْث ن لْجَلِيل نِغ لَّا؟ <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />مَامّش مْكُڒ يجّن زَّايْنغ يتسْڒَا إِ لُّغَا ن ثْمُوْرْث نّس؟ <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />يعْنِي ثَمُوْرْث ن بَارْدْيَا ذ مَادْيَا ذ عِيلَام، ذ يمزْذَاغ ن مِيسِيبُوْطَامْيَا<note caller="+" style="f"><char style="fr" closed="false">2‏.9 </char><char style="ft" closed="false">أَوَاڒ-أَ قَّارن-اَس س ثعْرَابْث </char><char style="it">النَّهْرِين</char>.</note> ذ يَهُوْذِيَا ذ كَپْدُوْكْيَا، ذ پُـنْطُس ذ آسْيَا، <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />ذ فْرِيْجْيَا ذ پَـامْفِيلْيَا، ذ مِصْرَا ذ جْوَايه ن لْقُرِينَا ذِي لِيبْـيَا، ذ يِنِّي يتْزُوْرَان زِي ثنْدِينْت ن رُوْمَا. <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />ذ أَيث-إِسْرَائِيل ذ يِنِّي يسڒْمن ذِي دِّين ن أَيث-إِسْرَائِيل، ذ أَيث-كْرِيت ذ وَاعْرَابن. نشِّين مَارَّا نتْسْڒَا-يَاسن سَّاوَاڒن س لُّغَاث نّغ خ ثْمسْڒَايِين ثِمقّْرَانِين ن أَربِّـي."<verse eid="ACT 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 2:12" />ذهْشن شّكّن، بْذَان سَّاوَاڒن جَارَاسن نَّان: "مِين يخس اَذ يِينِي مَانَايَا؟" <verse eid="ACT 2:12" /><verse number="13" style="v" sid="ACT 2:13" />ڒبْعَاض ضحْشن خَاسن نَّان قَا سْوِين اَطَّاس ن وَامَان وضِيڒ.<verse eid="ACT 2:13" /></para>
  <para style="s">لْخُطْبَا ثَمزْوَارُوْت ن اَرَّسُوْل بُطْرُس</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />بُطْرُس اَقَاث اَك حِيطَاش نِّي ن اَرُّسُل، ئِكَّر يسِّيوڒ س جّْهذ ينَّا-ٱسن: "آي يرْيَازن ن أَيث-إِسْرَائِيل ذ مَارَّا يمزْذَاغ ن لْقُدْس، ئِتْخصَّا اَذ تسّْنم اَذ تْصنّْطم مْلِيح إِ وَاوَاڒن ينُو. <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />ئِوْذَان-أَ وَار سْوِين شَا وَار غلَّان شَا س شّْرب اَمشْنَاو مَامّش ثْحسّْبم مِينْزِي ثْسَعَّات-أَ عَاذ ذ تسْعَا ن صْبَاح وَاهَا! <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />لَّا، يسِّيوڒ نَّبِي وَائِل خ مَانَايَا ذݣ يِجّن ن زْمَان وَامِي ينَّا:<verse eid="ACT 2:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ACT 2:17" />أَربِّـي ينَّا: ذݣ وُوْسَّان ينݣُّوْرَا</para>
  <para style="q" vid="ACT 2:17">أَذ فَرْغغ أَرُّوْح ينُو خ مَارَّا يوْذَان.</para>
  <para style="q" vid="ACT 2:17">ثَارْوَا نْوم ذ يِيسِّيثْوم اَذ سِّيوْڒن س مِين عڒْمن زِي أَربِّـي.</para>
  <para style="q" vid="ACT 2:17">ئِحنْجِيرن نْوم اَذ ࢲْرن لْوَحِي،</para>
  <para style="q" vid="ACT 2:17">ئِوسُّوْرَا نْوم اَذ اَرْجَان ثِيرْجَا.<verse eid="ACT 2:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ACT 2:18" />ذݣ وُوْسَّان نِّي اَذ فَرْغغ أَرُّوْح ينُو</para>
  <para style="q" vid="ACT 2:18">خ لْعِبَاد ينُو يرْيَازن ذ ثمْغَارِين،</para>
  <para style="q" vid="ACT 2:18">أَذ سِّيوْڒن س مِين عڒْمن زِي أَربِّـي.<verse eid="ACT 2:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ACT 2:19" />أَذ ݣّغ ڒَعْجَايب ذݣ وجنَّا ذ لْعَلَامَاث ذِي ثْمُوْرْث،</para>
  <para style="q" vid="ACT 2:19">أَذ يڒِين يذَامّن ذ ثْمسِّي ذ وَاطَّاس ن دّخَّان.<verse eid="ACT 2:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ACT 2:20" />ثْفُوْشْت اَذ تذْوڒ ذ ثَادْجسْت، ثَزِيرِي اَذ تذْوڒ ذ يذَامّن</para>
  <para style="q" vid="ACT 2:20">قْبڒ إِي د غَا يَاس نْهَار نِّي اَمقّْرَان لْعَضِيم ن سِيذِي أَربِّـي.<verse eid="ACT 2:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ACT 2:21" />سّنِّي مَارَّا ونِّي إِي غَا يڒَاغَان س يِيسم ن سِيذِي أَربِّـي اَتَاف اَذ ينْجم.<verse eid="ACT 2:21" /></para>
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22" />آي يرْيَازن ن أَيث-إِسْرَائِيل، صنّْطث إِ مِين ذَاوم غَا ينِيغ. عِيْسَى-يَا زِي نَاصِرَا مِين يعْنَا نتَّا؟ نتَّا ذ يجّن ن ورْيَاز يتْوَاظْهَار-د زِي أَربِّـي إِ كنِّيو س لْمُعْجِيزَاث ذ لْبُرْهَانَاث ذ لْعَلَامَاث إِݣ يݣَّا أَربِّـي خ وفُوْس ن عِيْسَى جَارَاوم مَامّش ثسّْنم. <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" />ئِي كنِّيو مِين ذَاس ثݣِّيم؟ وَامِي يتْوَاسلّم عْلَاحْسَاب مَامّش يخس أَربِّـي ذ مَامّش تُوْغَا يسّن نتَّا، كنِّيو ثْصلّْبم-ث ثنْغِيم-ث س يفَاسّن ن لْكُفَّار. <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" />وَلَكِن أَربِّـي نتَّا يسكَّر-يث-يذ يضْڒق-اَس زي ڒحْرِيق نِّي ن ڒْموْث خْمِي تَارو، أَقَا ڒْموْث وَار ذَاس ثْزمَّر. <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" />لِأَنَّا يسِّيوڒ خَاس <char style="it">نَّبِي</char> دَاود ذݣ يِجّن ن زْمَان وَامِي ينَّا:</para>
  <para style="q" vid="ACT 2:25">قَا تْوَاڒِيغ سِيذِي أَربِّـي زَّاثِي إِ ڒبْدَا،</para>
  <para style="q" vid="ACT 2:25">أَقَاث خ وفُوْسِي ينُو بَاش وَار ترْجِيجِيغ.<verse eid="ACT 2:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="ACT 2:26" />خ مَانَايَا يفَرّح وُوْڒ ينُو، ئِزهُّو يِيڒس ينُو.</para>
  <para style="q" vid="ACT 2:26">دَّات ينُو اَذ تْعِيش ذِي لْأَمَل.<verse eid="ACT 2:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="ACT 2:27" />وَار ثْسمّْحذ شَا ذِي ڒَعْمَار ينُو ذِي لْأَخِرَا،</para>
  <para style="q" vid="ACT 2:27">وَار تجِّيذ شَا لْعَظِيم نّش اَذ يكِيشّو.<verse eid="ACT 2:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="ACT 2:28" />ثْسظْهَارذ-اَيِي-د يبْرِيذن ن ثُوْذَارْث،</para>
  <para style="q" vid="ACT 2:28">أَذَايِي ثسْفَرْحذ س وَاطَّاس خْمِي غَا ࢲرغ اَغمْبُوْب نّش.<verse eid="ACT 2:28" /></para>
  <para style="b" />
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29" />آي اَيثْمَا، أَذَاوم ينِيِغ صَّرَاحَا: دَاود زِي سَّلَف صَّالِحِين، نتَّا يمُّوْث يتْوَانْضڒ. أَنْضڒ نّس اَقَّاث اَكِذْنغ اَڒ نْهَارَا. <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />أَزدْجِيذ دَاود تُوْغَا ذ نَّبي يعْنِي يسّن بلِّي يوْعذ-يث أَربِّـي ينَّا-ٱس اَقَا اَذ سْغِيمغ يجّن زِي دُّوْرِّيث نّش خ لْعَرْش نّش. <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />دَاود يعْڒم زِي أَربِّـي مِين غَا يوقْعن، ئِسِّيوڒ خ لْقِيَامَا ن لْمَسِيح بلِّي وَار ذَايس يسمّح شَا ذِي لْأَخِرَا، وَار تْكِيشِّيو شَا دَّات نّس. <verse eid="ACT 2:31" /><verse number="32" style="v" sid="ACT 2:32" />عِيْسَى-يَا وَانِيتَا يسكَّر-يث-يذ أَربِّـي زِي ڒْموْث، أَقَا نشِّين مَارَّا نْشهّذ خ مَانَايَا. <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />وَامِي يتْوَارْفع غَار وفُوْسِي ن أَربِّـي،<note caller="+" style="f"><char style="fr" closed="false">2‏.33 </char><char style="ft" closed="false">مَانَايَا يخس اَذ يِينِي يجّن ن ومْشَان غَارس شَّان ذ اَمقّْرَان. </char></note> ئِيْسِي زِي بَابَاس أَرُّوْح يقدّْسن إِي زِي ث يوْعذ، ئِسْفَرغ-د <char style="it">عِيسَى </char> مَانَايَا إي تْوَاڒَام ڒخُّو ذ مَانَايَا إي ثسْڒَام. <verse eid="ACT 2:33" /><verse number="34" style="v" sid="ACT 2:34" />قَا دَاود وَار يتْوَارْفع شَا غَار وجنَّا، نتَّا س يِيخْف نّس إِي ينَّان:</para>
  <para style="q1" vid="ACT 2:34">سِيذِي أَربِّـي ينَّا-ٱس إِ سِيذِي: قِّيم-د خ وفُوْسِي ينُو،<verse eid="ACT 2:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ACT 2:35" />أَڒ د غَا ݣّغ ڒْعَذْيَان نّش سْوَادَّاي إِ يضَارن نّش.<verse eid="ACT 2:35" /></para>
  <para style="b" />
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36" />إِيوَا كنِّيو يتْخصَّا اَذ تسّْنم مَارَّا أَيث-إِسْرَائِيل مبْڒَا شّكّ، قَا عِيْسَى-يَا وَانِيتَا إِي ثْصلّْبم يݣِّي-ث أَربِّـي ذ سِيذِيثْنغ ذ لْمَسِيح."<verse eid="ACT 2:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37" />ئِوذَان نِّي وَامِي سْڒِين إِ وَاوَاڒ-أَ، ؤُڒَاون نْسن شمْضن. كَّرن نَّان-اَس إِ بُطْرُس ذ اَرُّسُل نّغْنِي: "آي اَيثْمَا، مِين غَا نݣّ؟"<verse eid="ACT 2:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 2:38" />ينَّا-ٱسن بُطْرُس: "تُوْبث، تْوَاطهَّارث س وَامَان كُڒ يجّن زَّايْوم عْلَاحْسَاب يسم ن عِيْسَى لْمَسِيح حمَا اَذ تْوَاغْفَرنْت ڒْمُعْصِيَاث نْوم، أَتَاف اَذَاوم يمُّوْش أَرُّوْح يقدّْسن ذ لْهَدِيَا. <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />لِأَنَّا يُوْشَا-اَوم ڒْعَهذ إِ كنِّيو ذ ثَارْوَا نْوم ذ مَارَّا يِنِّي يݣّْوْجن، يعْنِي إِ مَارَّا يِنِّي إِي خف د غَا يڒَاغَا سِيذِي أَربِّـي." <verse eid="ACT 2:39" /><verse number="40" style="v" sid="ACT 2:40" />يعْڒم-اَسن بُطْرُس اَطَّاس يوصَّا-ٱثن ينَّا-ٱسن: "سْنجْمث يخْف نْوم زݣ يِوْذَان ن ڒْوقْث-أَ ذِي دْجَان يخَرْوِيضن." <verse eid="ACT 2:40" /><verse number="41" style="v" sid="ACT 2:41" />سّنِّي يِنِّي يقبْڒن اَوَاڒ نّس رُوْحن تْوَاطهَّارن س وَامَان. نْهَار نِّي مَارْنِين شَان ثڒْتْاَڒَاف إِذْسن غَار ڒْمُوْمِنِين.<verse eid="ACT 2:41" /></para>
  <para style="s">مَامّش تْعِيشن ڒْمُوْمِنِين يمزْوُوْرَا</para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 2:42" />
    <char style="it">ڒْمُوْمِنِين</char> ڒبْدَا تسْڒَان إِ تَّعْلِيم ن اَرُّسُل، تْمُوْنن اَݣ وَايَاوْيَا اَم وَاوْمَاثن، تتّن اَغْرُوْم اَݣ وَايَاوْيَا، تْࢲَادْجَان. <verse eid="ACT 2:42" /><verse number="43" style="v" sid="ACT 2:43" />أَرُّسُل تݣّن اَطَّاس ن لْمُعْجِيزَاث ذ لْبُرْهَانَاث، ئِوْذَان تْعجّْبن زَّايْسن مَارَّا. <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" />تْمُوْنن مَارَّا ڒْمُوْمِنِين شَرّْشن مَارَّا اَݣ وَايَاوْيَا. <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />زْنُوْزَان اَݣْڒَا نْسن ذ ڒحْوَايج نْسن، فرّْقن خ مْكُڒ يجّن مِين يحْذَاج. <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />تْمُوْنن مَارَّا إِذْسن مكُڒ نْهَار ذِي ثمْزِيذَا ثَمقّْرَانْت ن أَيث-إِسْرَائِيل. تتّن اَغْرُوْم مَارَّا ذِي ثُوْذْرِين نْسن، تتّن مشَّا س ڒفْرَاحث ذ ڒْخَاضَر نْسن. <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />حمّْذن أَربِّـي، رطَّان خَاسن يِوْذَان مَارَّا. كُڒ نْهَار يَرنِّي-يَاسن سِيذِي أَربِّـي ذِي لْعَدَد ن يِنِّي ينجّْمن.<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="s">أَرَّسُوْل بُطْرُس يسْݣنْفَا يجّن ن ونشْرُوْف</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />
    <char style="it">ئِجّن ن نْهَار</char> غَار ثْڒَاثَا وعشِّي ذي ڒْوقْث ن ثْࢲَادْجِيث، بُطْرُس ذ يُوْحَنَّا ݣَعّْذن غَار ثمْزِيذَا ثَمقّْرَانْت ن أَيث-إِسْرَائِيل. <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />ؤُفِين ذِنِّي يجّن ن ورْيَاز ذ اَنشْرُوْف يخْڒق-د اَمنِّي. تَاوِين-ث-يذ يِوْذَان غَار ثوَّارْث ن ثمْزِيذَا ؤُمِي قَّارن &lt;ثَوَّارْث ثَصبْحَانْت&gt;، سْرُوْسَان-ث ذِنِّي مْكُڒ نْهَار اَذ يتَّار غَار ينِّي يتَاذْفن غَار ثمْزِيذَا ثَمقّْرَانْت. <verse eid="ACT 3:2" /><verse number="3" style="v" sid="ACT 3:3" />وَامِي يࢲْرَا ونشْرُوْف نِّي بُطْرُس ذ يُوْحَنَّا تَاذْفن غَار ثمْزِيذَا ثَمقّْرَانْت، ئِبْذَا يتتَّار-اَسن صَّذَقَا. <verse eid="ACT 3:3" /><verse number="4" style="v" sid="ACT 3:4" />بُطْرُس ذ يُوْحَنَّا خزَّرن ذَايس مْلِيح، ينَّا-ٱس بُطْرُس: "خْزَر-د غَارْنغ!" <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />ئِخْزَر غَارْسن، ئِتْغِيڒ-اَس اَذَاس ؤُشن شَان ڒْحَاجث. <verse eid="ACT 3:5" /><verse number="6" style="v" sid="ACT 3:6" />ئِنْدق-د بُطْرُس ينَّا-ٱس: "نش وَار غَاري نُّقَارْث نِغ ذ دّْهب. وَلَكِن زِي مِين غَارِي نش اَذَاش ث ؤُشغ. ينَّا-ٱس: عْلَاحْسَاب يسم ن عِيْسَى لْمَسِيح زي نَاصِرَا، كَّر ؤُيُوْر!" <verse eid="ACT 3:6" /><verse number="7" style="v" sid="ACT 3:7" />يُوْشَا-ٱس فُوْس يطّف-يث زݣ وفُوْس نّس اَفُوْسِي يسْݣَعّذ-يث، ڒخْدّنِّي ثِشْعبِين<note caller="+" style="f"><char style="fr" closed="false">3‏.7 </char><char style="ft" closed="false">ثِشْعبْث نتَّاث ذ ثَڬْعبْث وضَار.</char></note> نّس ذ يضَارن نّس ݣنْفَان. <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />ئِنخْضف يبدّ خ يضَارن نّس يبْذَا يݣُّوْر. يُوْذف اَكِذْسن غَار ثمْزِيذَا ثَمقّْرَانْت يݣُّوْر ينطّو يحمّذ أَربِّـي. <verse eid="ACT 3:8" /><verse number="9" style="v" sid="ACT 3:9" />وَامِي ث ࢲْرِين مَارَّا يوْذَان يݣُّوْر يحمّذ أَربِّـي، <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />عقْڒن-ث نَّان ذ وَانِيتَا تُوْغَا يتْغِيمَان يتتَّار زَّاث إِ ثمْزِيذَا ثَمقّْرَانْت غَار ثوَّارْث ؤُمِي قَّارن &lt;ثَوَّارْث ثَصبْحَانْت.&gt; قِّيمن تْعجّْبن اَطَّاس، ذهّْشن زِي مِين ذَاس يوقْعن.<verse eid="ACT 3:10" /></para>
  <para style="s">لْخُطْبَا وِيس ثْنَاين ن اَرَّسُوْل بُطْرُس</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />
    <char style="it">أَرْيَاز نِّي يݣنْفَان</char> يطّف ذِي بُطْرُس ذ يُوْحَنَّا. مَارَّا يوْذَان نِّي قِّيمن ذهّْشن، رُوْحن غَارْسن تَازّْڒن غَار ومْشَان ؤُمِي قَّارن &lt;أَسْقِيف ن سُلِيمَان.&gt; <verse eid="ACT 3:11" /><verse number="12" style="v" sid="ACT 3:12" />وَامِي ثن يࢲْرَا بُطْرُس ينَّا-ٱسن: "آي يرْيَازن ن أَيث-إِسْرَائِيل، مَايمِّي ثتْعجّْبم خ مَانَايَا؟ مَايمِّي ذَايْنغ تْخزَّرم اَمُّو؟ مَا تْفكَّرم س جّْهذ نّغ نِغ س طَّاعَا نّغ إِي زِي نَارَّا اَرْيَاز-أَ يݣُّوْر؟ <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />لَّا، ذ أَربِّـي ن ڒجْذُوْذ نّغ يعْنِي أَربِّـي ن بْرَاهِيم ذ أَربِّـي ن إِسْحَاق ذ أَربِّـي ن يعْقُوْب. لِأَنَّا ذ نتَّا إِي د يسْبيّْنن لْعَظَمَا نّس ذݣ وخدَّام نّس عِيْسَى. وَلَكِن ذ كنِّيو إي ث يسلّْمن إ لْحُكَّام ثنْكَرم-ث زَّاث إِ بِيلَاطُوْس وَامِي تُوْغَا يرزُّو اَذَاس يضْڒق. <verse eid="ACT 3:13" /><verse number="14" style="v" sid="ACT 3:14" />ونِّي يدْجَان عَظِيم ذ صَّالِح ثنْكَرم-ث، ونِّي يدْجَان ذ اَمحْبُوْس ذ لْمُجْرِيم<note caller="+" style="f"><char style="fr" closed="false">3‏.14 </char><char style="ft" closed="false">خْزَر مَتَّى 27‏:15‏-26 ذ مَرْقُس 15‏:7‏-15 ذ لُوْقَا 23‏:13‏-25 ذ يُوْحَنَّا 18‏:38‏-40.</char></note> ثتَّارم خَاس <char style="it">إِ بِيلَاطُوْس</char> اَذَاوم د يتْوَاضْڒق. <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />ثنْغِيم ونِّي يدْجَان ذ لْأَصل ن ثُوْذَارْث، وَلَكِن أَربِّـي يسكَّر-يث-يذ زِي ڒْموْث، نشِّين نشْهذ خَاس. <verse eid="ACT 3:15" /><verse number="16" style="v" sid="ACT 3:16" />ذݣ يِيسم ن عِيسى يعْنِي ذ لْإِيمَان س يِيسم نّس، أَقَا اَرْيَاز-أَ إِي تْوَاڒَام إِي ثسّْنم يذْوڒ يجْهذ. س لْإِيمَان نّس ذِي عِيْسَى إِي زِي يݣنْفَا قَاع مَامّش تْوَاڒَام مَارَّا كنِّيو.<verse eid="ACT 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17" />ڒخُّو سّْنغ آي أَيثْمَا بلِّي ثݣِّيم مَانَاينِّي إِ عِيْسَى س ڒقْفَاڒث نْوم كنِّيو ذ اَرُّوْيَاس نْوم. <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />أَمُّو يكمّڒ وَاوَاڒ نّس إِي ينَّا أَربِّـي إِ مَارَّا لْأَنْبِيَا زِي قْبڒ، يعْنِي يتْخصَّا لْمَسِيح نّس اَذ يتْوَاعدّب. <verse eid="ACT 3:18" /><verse number="19‏-20" style="v" sid="ACT 3:19-20" />س مَانَايَا تُوْبث، ذوْڒث غَار أَربِّـي حمَا اَذ تْوَاكّْسنْت ڒْمُعْصِيَاث نْوم. حمَا اَذ د تَاس ثْسَعَّات ن لْفَرَج زِي سِيذِي أَربِّـي، أَذ د يسّكّ لْمَسِيح إِي تُوْغَا ذَاوم يتْوَاخْضَرن زِي قْبڒ يعْنِي عِيْسَى. <verse eid="ACT 3:19-20" /><verse number="21" style="v" sid="ACT 3:21" />ئِتْخصَّا نتَّا اَذ يقّيم ذݣ وجنَّا اَڒ ڒْوقْث إِي ذِي غَا يتْوَاعْذڒ كُڒْشِي عْلَاحْسَاب اَوَاڒن ن لْأَنْبِيَا صَّالِحِين إِي ذَاسن ينَّا أَربِّـي ذݣ يِجّن ن زْمَان. <verse eid="ACT 3:21" /><verse number="22" style="v" sid="ACT 3:22" />أَقَا ينَّا مُوْسَى: أَذَاوم د يُوْش سِيذِي أَربِّـي نْوم يجّن ن نَّبِي زݣ أَيثْمَاثْوم اَم نش. ئِتْخصَّا اَذ تْصنّْطم إِ مَارَّا مِين ذَاوم غَا يِيني. <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />قَا مَارَّا ونِّي وَار ذَاس يتْصنِّيطم شَا غَار نَّبِي نِّي اَذ يتْوَاكّس زِي ڒْقُوْم اَذ ينهْذم.<verse eid="ACT 3:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="ACT 3:24" />أَقَا نَّبِي صَامْوِيل ذ مَارَّا لْأَنْبِيَا إِي ثِيذ يذْفَارن خبَّارن خ وُوْسَّان-أَ يِيْنَا إِي ذِي ندْجَا. <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />كنِّيو ذ دُّوْرِّيث ن لْأَنْبِيَا. كنِّيو ذ ثَارْوَا ن ڒْعَهذ نِّي إِݣ يݣَّا أَربِّـي اَك ڒجْذُوْذ نْوم. ينَّا-ٱس أَربِّـي إِ بْرَاهِيم: زِي دُّوْرِّيث نّش إي زِي غَا بَرْكغ مَارَّا ڒݣْنُوْس ن ثْمُوْرْث-أَ. <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />وَامِي ذَاوم د يُوْشَا أَربِّـي اَخدَّام نّس <char style="it">عِيسَى، </char> ذ اَمزْوَارُو يسّكّ-اَوم-ث-يذ إِ كنِّيو بَاش اَكنِّيو يبَرك، يعْنِي اَذ يسْبعّذ مْكُڒ يجّن زَّايْوم خ شَّرّْ نّس."<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="s">بُطْرُس ذ يُوْحَنَّا زَّاث إِ لْحُكَّام ن أَيث-إِسْرَائِيل</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />ؤُسِين-د ڒْحِزب ن يصَدُّوْقِيْين ذ ڒْفُقَهَا ذ ؤُمقّْرَان ن يعسَّاسن ن ثمْزِيذَا ثَمقّْرَانْت ن أَيث-إِسْرَائِيل، ؤُفِين بُطْرُس ذ يُوْحَنَّا سَّاوَاڒن اَك يِوْذَان. <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />وَار ذَاسن يعْجِيب بُو ڒْحَاڒ قَاع وَامِي ؤُفِين بُطْرُس ذ يُوْحَنَّا سڒْمَاذن تْحدَّاثن إِ يِوْذَان خ عِيْسَى قَّارن بلِّي يوْذَان اَذ د كَّرن زِي ڒْموْث. <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />كَّرن طّْفن بُطْرُس ذ يُوْحَنَّا سِيذْفن-ثن ذِي ڒحْبس جِّين-ثن ذِنِّي اَڒ ثِيوشَّا مِينْزِي يعْذُو ڒْحَاڒ. <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />أَطَّاس ن يِوْذَان إِي يسْڒِين إِ وَاوَاڒ نْسن ؤُمْنن. يرْيَازن نِّي إِي يُوْمْنن <char style="it">ڒخُّو</char> ؤُوْضن غَار يِجّن خمْسَاڒَاف إِذْسن.<verse eid="ACT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5" />ثِيوشَّا نّس مُوْنن ذِي لْقُدْس يمقّْرَانن ن أَيث-إِسْرَائِيل ذ اَرُّوْيَاس نْسن ذ يمْسڒْمَاذن ن شَّرِيعَا. <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />تُوْغَا ذِنِّي حَنِين إِݣ يدْجَان ذ اَرَّايس ن ڒْفُقَهَا ذ قِيَافَا ذ يُوْحَنَّا ذ إِسْكَنْدَر ذ يِنِّي يدْجَان زِي ڒحْبَاب ن اَرَّايس ن ڒْفُقَهَا. <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />ؤُوِين-د بُطْرُس ذ يُوْحَنَّا سْبدّن-ثن ذِي ڒْوسْط نْسن نَّان-اَسن: "مَان جّْهذ نِغ ذ يِيسم إِي زِي تݣّم مَانَايَا؟"<verse eid="ACT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 4:8" />بُطْرُس يشُّوْر-د س أَرُّوْح يقدّْسن ڒخْدّنِّي ينَّا-ٱسن: "آ لْحُكَّام آي يمقّْرَانن ن شَّعْب! <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />مَا تݣّم-اَنغ لْإِسْتِجْوَاب نْهَارَا عْلَاحْسَاب يجّن ن ڒْخِير إِي نݣَّا ذݣ ونشْرُوْف-أَ عْلَاحْسَاب مَامّش يݣنْفَا؟ <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />إِيوَا يتْخصَّا اَذ تسّْنم كنِّيو ذ مَارَّا أَيث-إِسْرَائِيل بلِّي اَرْيَاز-أَ إِي ذَا يبدّن زَّاثْوم يݣّنْفَا س يِيسم ن عِيْسَى لْمَسِيح زِي نَاصِرَا. كنِّيو ثْصلّْبم-ث، وَلَكِن أَربِّـي يسكَّر-يث-يذ زِي ڒْموْث. <verse eid="ACT 4:10" /><verse number="11" style="v" sid="ACT 4:11" />عِيْسَى-يَا نتَّا ذ اَزْرُو نِّي إِي ثْعِيفّم كنِّيو يبنَّاين. ڒخُّو يذْوڒ ذ اَزْرُو اَصبْحَان اَقَاث ذِي ثْغمَّارْث ن دْسَاس. <verse eid="ACT 4:11" /><verse number="12" style="v" sid="ACT 4:12" />وَار يزمَّر حَدّ اَذ ينْجم بْڒَا زَّايس نتَّا. لِأَنَّا وَار ذِنِّي ؤُڒَا ذ يجّن ن يِيسم نّغْنِي جَار إِ يرْيَازن ذِي دُّنشْت-أَ اَزَّايس نتْوَاسنْجم إِلَّا نتَّا."<verse eid="ACT 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13" />خْزَرن لْحُكَّام نِّي ذِي زْعَامث ن بُطْرُس ذ يُوْحَنَّا ؤُفِين-ثن وَار غْرِين شَا نِثْنِي ذ يوْذَان عَادِي. قِّيمن تْعجّْبن، عقْڒن-ثن تُوْغَاثن اَك عِيْسَى. <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />عَاوذ تْوَاڒَان اَرْيَاز نِّي يݣنْفَا يبدّ ذِنِّي اَكِذْسن، وَار ؤُفِين مِين غَا ينِين. <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />لْحُكَّام نِّي ؤُمَرن بُطْرُس ذ يُوْحَنَّا اَذ فّْغن بَارَّا اَذ جّن جْمَاعث نِّي ن لْحُكَّام اَذ مْشَاوَارن وَاحذْسن. <verse eid="ACT 4:15" /><verse number="16" style="v" sid="ACT 4:16" />نَّان: "مِين غَا نݣّ إِ ثْنَاين-أَ ن يرْيَازن؟ وَار نْزمَّر شَا أَ ننْكَر لْمُعْجِيزَا-يَا إِي ݣِّين اَقَا ثْمظْهَار-اَسن-د إِ مَارَّا يمزْذَاغ ن لْقُدْس. <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />وَلَكِن لَابُد اَذَاسن نعْڒم بَاش سَّا اَڒ تْسَاونْت وَار سِّيوِيڒن غَار حَدّ عْلَاحْسَاب يسم ن عِيْسَى بَاش وَار يتنْتَاشَار شَا ؤُسڒْمذ-أَ ذِي شَّعب." <verse eid="ACT 4:17" /><verse number="18" style="v" sid="ACT 4:18" />سِيذْفن-ثن-د، ؤُمَرن-ثن نَّان-اَسن وَار سَّاوَاڒث وَار سڒْمَاذث حَدّ عْلَاحْسَاب يسم ن عِيْسَى.<verse eid="ACT 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 4:19" />ئِنْدق-د بُطْرُس ذ يُوْحَنَّا نَّان-اَسن: "حكْمث كنِّيو، مَا مْلِيح زَّاث إِ أَربِّـي أَ نْطَاع إِ وَاوَاڒ نّس نِغ إِ وَاوَاڒ نْوم؟ <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />وَار نْزمَّر شَا أَ نجّ خ مِين نࢲْرَا نِغ خ مِين نسْڒَا."<verse eid="ACT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 4:21" />اَرْنِين سِيݣّْوْذن-ثن، ڒخْدّنِّي ضڒْقن-اَسن. وَار ؤُفِين مَامّش ذَاسن غَا ݣّن اَثن عَاقْبن مِينْزِي مَارَّا يوْذَان حمّْذن أَربِّـي خ مِين يوقْعن. <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />أَرْيَاز-أَ يݣنْفَان س لْمُعْجِيزَا نِّي غَارس كْتَار زِي اَرْبعِين يسݣّْوُوْسَا.<verse eid="ACT 4:22" /></para>
  <para style="s">ڒْمُوْمِنِين تتَّارن زْعَامث زِي أَربِّـي</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />غِير ضڒْقن-اَسن-د إِ بُطْرُس ذ يُوْحَنَّا، رُوْحن غَار يمدُّوْكَاڒ نْسن عَاوْذن-اَسن مَارَّا مِين ذَاسن نَّان اَرُّوْيَاس ن ڒْفُقَهَا ذ يمقّْرَانن ن أَيث-إِسْرَائِيل. <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />وَامِي سْڒِين إِ مَانَايَا، تَّارن إِ أَربِّـي ذِي ثْࢲَادْجِيث مَارَّا إِذْسن نَّان-اَس: "يَا مَوْلَانَا ذ شك يخڒْقن اَجنَّا ذ ثْمُوْرْث ذ ڒبْحَر ذ مَارَّا مِين ذَايْسن. <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />ذ شك إِي ينَّان س أَرُّوْح يقدّْسن س يِيڒس ن جدِّيثْنغ دَاود ڒْعَبْذ نّش وَامِي ينَّا:</para>
  <para style="q1" vid="ACT 4:25">مَايمِّي ڒݣْنُوْس غضْبن اَطَّاس؟</para>
  <para style="q2" vid="ACT 4:25">مَايمِّي يوْذَان تْشِيطِينن ذِي ڒْخَاوِي؟<verse eid="ACT 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 4:26" />سوْجَاذن يزدْجِيذن ن ثْمُوْرْث يخف نْسن،</para>
  <para style="q1" vid="ACT 4:26">مُوْنن اَرُّوْيَاس اَك وَايَاوْيَا،</para>
  <para style="q1" vid="ACT 4:26">بَاش اَذ عَارّْضن إِ سِيذِي أَربِّـي ذ لْمَسِيح نّس.<verse eid="ACT 4:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="ACT 4:27" />لِأَنَّ ذ صَّح <char style="it">اَزدْجِيذ</char> هِيرُدُوْس ذ <char style="it">لْحَاكم</char> بُنْطْيُوْس بِيلَاطُس مُوْنن اَك أَيث-إِسْرَائِيل ذ يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل ذِي ثنْدِينْت-أَ. تَافْقن ضد إِ وخدَّام نّش يقدّْسن عِيْسَى إِي ثِيخْضَرذ. <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />ݣِّين قَاع مِين تُوْغَا ثْزمّْمذ اَذ يوْقع س وفُوْس ذ ڒْخَاضَر نّش. <verse eid="ACT 4:28" /><verse number="29" style="v" sid="ACT 4:29" />آ سِيذي، ڒخُّو خْزَر مَامّش ذَانغ تْهدَّاذن، ؤُش-اَنغ إِ نشِّين لْعِبَاد نّش أَ نسِّيوڒ س وَاوَاڒ نّش س زْعَامث. <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />سَرّح فُوْس نّش بَاش اَذ تسْݣنْفِيذ اَذ تسْبيّْنذ لْمُعْجِزَاث ذ لْبُرْهَانَاث عْلَاحْسَاب يسم ن عِيْسَى اَخدَّام نّش يقدّْسن."<verse eid="ACT 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31" />وَامِي كمّْڒن ثْࢲَادْجِيث نِّي ينْهزّ ومْشَان نِّي مَانِي مُوْنن، شُّوْرن نِثْنِي مَارَّا س أَرُّوْح يقدّْسن سَّاوَاڒن س وَاوَاڒ ن أَربِّـي س يِجّن ن زْعَامث.<verse eid="ACT 4:31" /></para>
  <para style="s">ڒْمُوْمِنِين شَرّْشن مَارَّا جَارَاسن</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />جْمَاعث نِّي ن ڒْمُوْمِنِين غَارْسن ؤُڒ نْسن ذ ڒَعْقڒ نْسن كِيف-كِيف. ؤُڒَا ذ يجّن زَّايْسن وَار يحسّب مِين غَارس نّس وَاحْذس، شَرّْشن مَارَّا ثِمسْڒَايِين جَارَاسن. <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" />شهّْذن اَرُّسُل س يِجّن ن جّْهذ ذ اَمقّْرَان خ لْقِيَامَا إِي يݣَّا سِيذِيثْنغ عِيْسَى وَامِي يكَّر زِي ڒْموْث. أَربِّـي يݣَّا خَاسن مَارَّا يجّن ن لْبَرَكَا ثمْغَار.<verse eid="ACT 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 4:34" />وَار يدْجِي ؤُڒَا ذ يجّن زَّايْسن مَا يحْذَاج. لِأَنَّا يِنِّي إِي غَار يدْجَا ثِمُوْرَا ذ ثُوْذْرِين تْرَاحن زْنُوْزَان-ثنْت تَاوِين-د تْمنْيَاث نِّي، <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />سْرُوْسَان-ثنت غَار يضَارن ن اَرُّسُل تْفرَّاقنْت-ثنْت عْلَاحْسَاب مْكُڒ يجّن مِين يحْذَاج. <verse eid="ACT 4:35" /><verse number="36" style="v" sid="ACT 4:36" />ذِنِّي يجّن قَّارن-اَس يُوْسف، عَاوذ سمَّان-ث اَرُّسُل س بَرْنَابَا يعْنِي &lt;ونِّي يتْشجَّاعن.&gt; نتَّا زِي شُّرْفَا ن اَيث-لَاوِي ذ مِّيس ن ثنْدِينْت ن قُبْرُص. <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />ئِكَّر يزّنْز يجّن ن ثْمُوْرْث إِي غَارس، يُوْوِي-د تْمنْيَاث نِّي يسرْس-يثنْت غَار يضَارن ن اَرُّسُل.<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="s">أَنَاس ذ ثمْغَارْث نّس سَافُوْرَا</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />ئِكَّر يِجّن ن ورْيَاز قَّارن-اَس أَنَاس ثَمْغَارث نّس قَّارن-اَس سَافُوْرَا، ئِرُوْح يزّنْز يجّن ن ثْمُوْرْث نّس. <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />يُوْوِي-د تْمنْيَاث، شَا يسْنُوْفَّر-يثنْت غَارس، شَا يُوْوِي-ثنْت يسرْس-يثنت غَار يضَارن ن اَرُّسُل. ثَمْغَارث نّس ثَرْݣب قَاع خ مَانَاينِّي.<verse eid="ACT 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 5:3" />ينَّا-ٱس بُطْرُس: "آي أَنَاس، مَايمِّي ثجِّيذ شِّيطَان اَش يغَرّ يُوْذف ذݣ وُوْڒ نّش ثسْخرّْقذ خ أَرُّوْح يقدّْسن ثسْنُوْفَّرذ شَان ن تْمنْيَاث إِ يِيخف نّش زِي تْمنْيَاث ن ثْمُوْرْث نِّي؟ <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />ثَمُوْرث نِّي تُوْغَا ثدْجَا نّش مَارَّا قْبڒ إِي ت غَا ثزّنْزذ؟ وَامِي ثْزّنْزذ ثَمُوْرْث نِّي، تْمنْيَاث نِّي مَارَّا دْجَانْت نّش كُلْشِي." ينَّا-ٱس: "مَايمِّي ثنْوِيذ ذݣ وُوْڒ نّش مَانَايَا؟ قَا وَار يدْجِي ثسْخرّْقذ خ يِوْذَان، قَا ثسخرّْقذ خ أَربِّـي."<verse eid="ACT 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 5:5" />وَامِي يسْڒَا أَنَاس إِ وَاوَاڒ نِّي، ئِوْضَا غَار ثْمُوْرْث يمُّوْث ذِنِّي. ئِوْذَان مَارَّا إِي د يارِّين ڒخْبَار-أَ ݣّْوْذن اَطَّاس. <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />ؤُسِين-د شَّبَاب كفّْنن أَنَاس س ڒشْفن ؤُوِين-ث نضْڒن-ث.<verse eid="ACT 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7" />عْذُوْنْت شَان ثْڒَاثَا ن ثْسَعَّاثِين ثُوْسَا-د ثمْغَارْث ن أَنَاس وَار د ثَارِّي بُو ڒخْبَار خ مِين يوقْعن. <verse eid="ACT 5:7" /><verse number="8" style="v" sid="ACT 5:8" />ئِنْدق-د بُطْرُس ينَّا-ٱس: "إِن-اَيي، مَا ٱنِشْتُوْيَا وَاهَا إِي زِي ثزّنْزم ثَمُوْرْث نِّي؟"</para>
  <para style="p" vid="ACT 5:8">ثنَّا-ٱس نتَّاث: "وَاه، أَنِشْتُوْيَا وَاه."<verse eid="ACT 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9" />ينَّا-ٱس بُطْرُس: "مَايمِّي ثْتَافْقم اَذ تْزَعْمم اَذ تࢲرم اَرُّوْح ن سِيذِي أَربِّـي مِين غَا يݣّ؟" ينَّا-ٱس: "يِنِّي ينضْڒن اَرْيَاز نّمْ ذوْڒن-د اَقَاثن غَار ثوَّارْث، أَشم يْسِين ؤُڒَا ذ شم." <verse eid="ACT 5:9" /><verse number="10" style="v" sid="ACT 5:10" />صَافِي ثوْضَا ڒخْدّنِّي، ثمُّوْث ذِنِّي غَار يضَارن ن بُطْرُس. ؤُذْفن شَّبَاب نِّي ؤُفِين-ت ثمُّوْث، يْسِين-ت نضْڒن-ت اَݣ وغزْذِيس ن ورْيَاز نّس. <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />مَارَّا جْمَاعث ن ڒْمُوْمِينِين ذ مَارَّا يِنِّي يسْڒِين خ مَانَايَا ݣّْوْذن اَطَّاس.<verse eid="ACT 5:11" /></para>
  <para style="s">أَرُّسُل سْݣنْفَان اَطَّاس ن يِوْذَان</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />أَرُّسُل تݣّن اَطَّاس ن لْمُعْجِيزَاث ذ لْبُرْهَانَاث جَار يِوذَان، تْمُوْنن مَارَّا ذݣ وسقِّيف ن سُلِيمَان <char style="it">ذِي ثمْزِيذَا ثَمقّْرَانْت</char>. <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />زݣ يِوْذَان نِّي إِي وَار يُوْمِينن شَا وَار يزْعِيم حَدّ اَكِذْسن يِيڒِي اَك ڒْمُوْمِنِين وَلَكِن وَاخَّا ٱمنِّي تحْتَارَامن-ثن اَطَّاس. <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />مَارْنِين-د اَطَّاس ن يِوْذَان إِي يُوْمْنن زِي سِيذِيثْنغ، زَّايْسن يجّن ن لْعَدَد ن يرْيَازن ؤُڒَا ذ ثمْغَارِين.<verse eid="ACT 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 5:15" />ئِوْذَان سُوْفُوْغن-د يمهْڒَاش نْسن غار زْنَاقِي، سْرُوْسَان-ثن خ ثَاسُّوْث ذ يجَرْثِيڒن حمَا اَخْمِي سّنِّي د غَا يعْذُو بُطْرُس، يمْكن اَذ يڒْقف ڒبْعَاض زَّايْسن س ثِيڒِي نّس. <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />تَاسن-د اَطَّاس ن يِوْذَان زِي ڒدْشُوْرَاث إِي يُوْذْسن غَار لْقُدْس، تَاوِين-د يمهْرَاش نْسن ذ يِنِّي يتْعدَّابن جْنُوْن يعفَّانن نِثْنِي تْݣنْفَان مَارَّا.<verse eid="ACT 5:16" /></para>
  <para style="s">أَيث-إِسْرَائِيل تْعدَّابن اَرُّسُل</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />ئِكَّر اَرَّايس ن ڒْفُقَهَا ذ مَارَّا يِنِّي كِس يدْجَان نِثْنِي زِي ڒْحِزب ن يصَدُّوْقِيْين، حسْذن اَرُّسُل اَطَّاس. <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />طّْفن-ثن ݣِّين-ثن ذِي ڒحْبس. <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />وَلَكِن س دْجِيرث يجّن ن لْمَلَائِكَا ن سِيذِي أَربِّـي ثرْزم-اَسن ثِوُّوْرَا ن ڒحْبس، ثْسُوْفغ-يثن ثنَّا-ٱسن: <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />"رُوْحم بدّث ذِي ثمْزِيذَا ثَمقّْرَانْت، حدّْثم إِ يِوْذَان س مَارَّا اَوَاڒن ن ثُوْذَارْث-أَ <char style="it">ن جْذِيذ</char>." <verse eid="ACT 5:20" /><verse number="21" style="v" sid="ACT 5:21" />ذ مَانَاينِّي إِي ݣِّين، ؤُذْفن غَار ڒفْجَر غَار ثمْزِيذَا ثَمقّْرَانْت بْذَان سڒْمَاذن.</para>
  <para style="p" vid="ACT 5:21">منْبَعْد يرُوْح اَرَّايس ن ڒْفُقَهَا ذ مَارَّا يِنِّي كِس يدْجَان سْمُوْنن-د جْمَاعث ن لْحُكَّام ن أَيث-إِسْرَائِيل يعْنِي مَارَّا يمقّْرَانن نْسن، سّنِّي سّكّن <char style="it">يعسَّاسن ن ثمْزِيذَا</char> اَذ د اَوِين اَرُّسُل زي ڒحْبس. <verse eid="ACT 5:21" /><verse number="22" style="v" sid="ACT 5:22" />وَامِي ؤُوْضن يعسَّاسن نِّي غَار ڒحْبس وَار ثن ؤُفِين شَا ذِنِّي. ذوْڒن-د سِّيوْضن ڒخْبَار، <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />نَّان-اَسن: "نُوْفَا ثِوُّوْرَا ن ڒحْبس بلّْعنْت مْلِيح، ذ يعسَّاسن ن ڒحْبس بدّن زَّاث إِ ثوُّوْرَا نِّي. نشِّين وَامِي نُوْذف غَار ذَاخڒ وَار ذِنِّي نُوْفِي حَدّ." <verse eid="ACT 5:23" /><verse number="24" style="v" sid="ACT 5:24" />وَامِي سْڒِين إِ وَاوَاڒ-أَ اَرُّوْيَاس ن ڒْفُقَهَا ذ ومقّْرَان ن يعسَّاسن ن ثمْزِيذَا ثَمقّْرَانْت يسْمض-اَسن ڒَعْجب ذݣ وُوْڒ فكَّرن مَانِي غَا يَاوض مَانَايَا؟<verse eid="ACT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 5:25" />يُوْسَا-د غَارْسن يجّن ينَّا-ٱسن: "يرْيَازن نِّي إِي ثݣِّيم ذِي ڒحْبس اَقَاثن ذِي ثمْزِيذَا ثَمقّْرَانْت سڒْمَاذن يوْذَان!" <verse eid="ACT 5:25" /><verse number="26" style="v" sid="ACT 5:26" />ڒخْدّنِّي يرُوْح ومقّْرَان نِّي ن يعسَّاسن اَك يمْخَازْنِيْين نّس ؤُوِين-د اَرُّسُل بڒَا لْعُنْف مِينْزِي ݣّْوْذن زِي شَّعب اَثن رجْمن س وزْرُو.<verse eid="ACT 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 5:27" />وَامِي د سِيذْفن اَرُّسُل، سْبدّن-ثن زَّاث إِ جْمَاعث ن لْحُكَّام ن أَيث-إِسْرَائِيل. ينَّا-ٱسن اَرَّايس ن ڒْفُقَهَا: <verse eid="ACT 5:27" /><verse number="28" style="v" sid="ACT 5:28" />"نشِّين نُوْمَر-يكنِّيو وَار ثسڒْمَاذم شَا عْلَاحْسَاب يسم نِّي <char style="it">ن عِيْسَى</char>. وَلَكِن كنِّيو ثْعمَّارم لْقُدْس س تَّعْلِيم نْوم. ثخْسم اَذ تݣّم ڒْموْث ن ورْيَاز-أَ خ يِيڒي نّغ."<verse eid="ACT 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 5:29" />ئِنْدق-د اَرَّسُوْل بُطْرُس ذ اَرُّسُل نّغْنِي نَّان-اَسن: "ئِتْخصَّا-يَانغ أَ نْطَاع إِ أَربِّـي مَاشِي إِ يِوْذَان! <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />أَربِّـي ن ڒجْذُوْذ نّغ يسكَّر-د عِيْسَى ونِّي إِي ثنْغِيم كنِّيو ثْرفْعم-ث خ ثحْنَاشْت. <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />يرْفع-يث أَربِّـي اَغَارس يݣِّي-ث خ وفُوْسِي نّس بَاش اَذ يحْكم اَذ يسنْجم، أَذ يُوْش تُوْبَا إِ أَيث-إِسْرَائِيل اَذ يغْفَر ڒْمُعْصِيَاث نْسن. <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />خ ثْمسْڒَايِين-أَ نْشهّذ خَاسنْت نشِّين ذ أَرُّوْح يقدّْسن، أَرُّوْح-أَ يُوْشِي-ث أَربِّـي إِ يِنِّي ذَاس يتْطَاعَان."<verse eid="ACT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33" />وَامِي سْڒِين إِ وَاوَاڒَ-أَ خيّْقن غضْبن رزُّوْن اَثن نْغن. <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />ئِكَّر-د يجّن ن وفَرِّسِي، نتَّا ذ اَمسڒْمَاذ ن شَّرِيعَا قَّارن-اَس ݣَامْلِيل يتحْتَارَام-يث شَّعْب مَارَّا. ئِبدّ ذِي ڒْوسْط ن جْمَاعث ن لْحُكَّام ن أَيث-إِسْرَائِيل، ئِتَّار-اَسن اَذ سُوْفْغن اَرُّسُل شْوَايْت ن ڒْوقْث غَار بَارَّا. <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />ينَّا-ٱسن: "آي يرْيَازن ن أَيث-إِسْرَائِيل، حْضَام يخف نْوم زِي مِين ثخْسم اَذ تݣّم إِ يِوْذَان-أَ! <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />قْبڒ إِ وُوْسَّان-أَ، ئِكَّر-د يجّن ن ورْيَاز قَّارن-اَس أَثُوْدَّاس. يَارَّا يخف نّس ذ اَمقّْرَان، ذْفَارن-ث شَان اَرْبعَا مِيَّا ن يرْيَازن. وَلَكِن نْغِين-ث، مَارَّا يِنِّي إي ث يذْفَارن مْسفْرَاقن ذوْڒن ذ وَالُو. <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />منْبَعْد إِ ورْيَاز-أَ <char style="it">أَثُوْدَّاس</char>، ئِكَّر-د يجّن نّغْنِي قَّارن-اَس يَهُوْذَا زِي ثْمُوْرْث ن لْجَلِيل ذِي ڒِيَّام ن لْإِحْصَاءْ ن يمزْذَاغ ن أَيث-إِسْرَائِيل. ئِجْمع اَكِذس يجّن ن لْعَدَد ن يِوْذَان، وَلَكِن نْغِين-ث ؤُڒَا ذ نتَّا، يِنِّي إِي ث يذْفَارن كُڒ يجّن مَانِس يكَّا. <verse eid="ACT 5:37" /><verse number="38" style="v" sid="ACT 5:38" />ڒخُّو اَكنِّيو نصْحغ اَذ تْبعّْذم إِ يِوْذَان-أَ، أَثن ثجّم. مِين نوَّان نِغ ذ مِين خدّْمن، مڒَا زَّايْسن وَاهَا اَذ يقْضَا. <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />مڒَا مَانَايَا زِي أَربِّـي وَار ثْزمَّرم شَا اَخَاسن ثقْضَام. غَارْوم اَذ تَافم يخف نْوم تْمنْغَام اَك أَربِّـي!"<verse eid="ACT 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 5:40" />سْڒِين يِوْذَان نِّي غَار ݣَامْلِيل. ؤُوِين-د اَرُّسُل عَانّن-اَسن اَعْمُوْذ نَّان-اَسن: "قَا عمَّارْص اَذ تْعَاوْذم اَذ تسِّيوْڒم عْلَاحْسَاب يسم ن عِيْسَى." ڒخْدّنِّي ضڒْقن-اَسن.<verse eid="ACT 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="ACT 5:41" />فَرْحن اَرُّسُل وَامِي فّْغن زِي جْمَاعث نِّي ن لْحُكَّام ن أَيث-إِسْرَائِيل، حسّْبن بلِّي غَارْسن لْهِمَّا خ لْإِهَانَا نِّي إِي ذَاسن يوقْعن خ يِيسم ن عِيْسَى. <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />قِّيمن مكُڒ نْهَار تْرَاحن غَار ثمْزِيذَا ثَمقّْرَانْت، تْرَاحن زِي ثدَّارْث اَڒ ثدَّارْث سڒْمَاذن تْبشَّارن س عِيْسَى بلِّي نتَّا ذ لْمَسِيح.<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="s">أَرُّسُل تِيخْضَارن سبْعَا ن صَّحَابَا ذِي ثنْدِينْت ن لْقُدْس</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />ذݣ وُوْسَّان نِّي لْعَدَد ن يمحْضَارن يمَارْنِي. ڒْمُوْمِنِين إِي سَّاوَاڒن س لُّغَا ثَيُوْنَانِيث تْشثْشَان زݣ يِنِّي يسَّاوَاڒن لْعِبْرِيَا، قَّارن قَا نشِّين ثَاجَّاڒِين نّغ وَار ذَاسنْت تِيشّن بُو ڒْحَقّ نْسنْت خْمِي فرّْقن لْمُعْوَانَا مْكُڒ نْهَار. <verse eid="ACT 6:1" /><verse number="2" style="v" sid="ACT 6:2" />كَّرن ثنْعَاش نِّي ن اَرُّسُل سْمُوْنن مَارَّا يمحْضَارن نَّان-اَسن: "نشِّين اَرُّسُل مَاشِي مَعْقُوْل أَ نسْمح ذݣ وَاوَاڒ ن أَربِّـي بَاش أَ نفرق لْمُعْوَانَا. <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />آي اَيثْمَا، كَّرم اَوِيم-د سبْعَا ن يرْيَازن زَّايْوم اَذ تِيڒِي ثسّْنم-ثن اَقَاثن مْلِيح، أَذ يڒِين شُّوْرن س أَرُّوْح يقدّْسن ذ ڒفْهَامث. نشِّين اَثن نْكلّف س لْمُهِمَّا-يَا <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />بَاش نشِّين <char style="it">اَرُّسُل</char> أَ نُوْش ڒْوقْث نّغ إِ ثْࢲَادْجِيث ذ وحدّث."<verse eid="ACT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5" />ئِعْجب-اَسن ڒْحَاڒ إِ مَارَّا جْمَاعث. كَّرن يخْضَرن يجّن ن ورْيَاز قَّارن-اَس سْتِيفَان، نتَّا يشُّوْر س لْإِيمَان ذ أَرُّوْح يقدّْسن. ئِخْضَرن فِيلِيپَّـاس ذ بْرُوْكُوْرُس ذ نِيكَانُوْر ذ تِيمُوْن ذ پَـرْمِينَاس ذ نِيكُوْلَاس زݣ وَانْطَاكْيَا، تُوْغَا يسْڒم نتَّا ذِي دِّين ن أَيث-إِسْرَائِيل. <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" /><char style="it">سبْعَا-يَا ن صَّحَابَا</char> قدّْمن-ثن غَار اَرُّسُل، ࢲُّوْدْجن خَاسن سرْسن خَاسن يفَاسّن نْسن <char style="it">بَرَكن-ثن</char>.<note caller="+" style="f"><char style="fr" closed="false">6‏.6 </char><char style="ft" closed="false">خْمِي ڒْمُوْمِنِين تْࢲَادْجَان خ شَان يِجّن خ شَان سَّبَاب سْرُوْسَان خَاس يفَاسّن، يعْنِي ثَا ذ يجّن ن لْعَلَامَا بلِّي اَذَاس ؤُشن جّْهذ ذ لْبَرَكَا. </char></note> <verse eid="ACT 6:6" /><verse number="7" style="v" sid="ACT 6:7" />ئِنْتَاشَار وَاوَاڒ ن أَربِّـي، مَارْنِين-د اَطَّاس ن يمحْضَارن ذِي لْقُدْس، ؤُمْنن اَطَّاس ن ڒْفُقَهَا ن أَيث-إِسْرَائِيل <char style="it">زِي لْإِنْجِيل</char>.<verse eid="ACT 6:7" /></para>
  <para style="s">طّْفن سْتِيفَان زِي سبْعَا نِّي ن صَّحَابَا يخْضَرن اَرُّسُل</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />سْتِيفَان نِّي نتَّا يشُّوْر س لْبَرَكَا ن أَربِّـي ذ جّْهذ، ئِخدّم جَار يِوْذَان لْبُرْهَانَاث ذ لْمُعْجِيزَات ذ ثِمقّْرَانِين. <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />كَّرن ڒبْعَاض زِي ثمْزِيذَا ؤُمي قَّارن &lt;لْبَرْتِينُوْن.&gt;<note caller="+" style="f"><char style="fr" closed="false">6‏.9 </char><char style="ft" closed="false">ئِوْذَان قَّارن بلِّي لْبَرْتِينُون نِثْنِي ذ شَان ن يسْرَائِيلِيْين إِي تُوْغَا حبْسن-ثن اَرُّوْمَانُوس ؤُوِين-ثن غَار ثنْدِينْت ن رُوْمَا. منْبَعْد ضڒْقن-اَسن-د سُوفْغن-ثن زِي رُوْمَا. عقْبن-د غَار إِسْرَائِيل ذ يمُوشَان نّغْنِي.</char></note> نِثْنِي ذ يسْرَائِيلِيْين ن ثنْدِينْت ن لْقُرِينَا ذ ثنْدِينْت ن إِسْكَنْدَرِيَا ذ ينّغْنِي زِي لْإِقْلِيم ن كِيلِيكْيَا ذ لْإِقْلِيم ن آسْيَا. بْذَان تمْنَاقَارن اَك سْتِيفَان، <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />وَلَكِن وَار زمَّرن اَذ قَاوّْمن ڒفْهَامث ذ أَرُّوْح إِي زِي يسَّاوَاڒ.<verse eid="ACT 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 6:11" />كَّرن ؤُشِين اَرّشْوث إِ شَان يرْيَازن بَاش اَذ ينِين قَا نشِّين نسْڒَا إِ سْتِيفَان نتَّا يقَّار اَوَاڒ وَار يحْڒِين خ مُوْسَى ذ أَربِّـي! <verse eid="ACT 6:11" /><verse number="12" style="v" sid="ACT 6:12" />وَامِي سْعصّْبن يوْذَان ؤُڒَا ذ يمقّْرَانن ن أَيث-إِسْرَائِيل ذ يمْسڒْمَاذن ن شَّرِيعا، طّْفن سْتِيفَان ؤُوِين-ث غَار جْمَاعث ن لْحُكَّام ن أَيث-إِسْرَائِيل. <verse eid="ACT 6:12" /><verse number="13" style="v" sid="ACT 6:13" />ؤُوِين-د يوْذَان اَخَاس شهْذن ࢲُّوْر قَّارن "قَا بْنَاذم-أَ يقَّار اَوَاڒ وَار يحْڒِين خ ومْشَان-أَ اَمْقدّس ذ شَّرِيعَا ن مُوْسَى! <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />نسْڒَا-يَاس يقَّار بلِّي عِيْسَى زِي نَاصِرَا اَذ يهْذم اَمْشَان-أَ اَذ يبدّڒ لْعَادَاث نِّي إِي ذَانغ د يجَّا مُوْسَى." <verse eid="ACT 6:14" /><verse number="15" style="v" sid="ACT 6:15" />خزَّرن ذَايس ذِي سْتِيفَان مَارَّا يِنِّي إِي ذِنِّي يدْجَان ذِي جْمَاعث ن لْحُكَّام ن أَيث-إِسْرَائِيل، ؤُفِين اَغمْبُوْب نّس اَم وغمْبُوْب ن لْمَلَائِكَا.<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="s">سْتِيفَان يتْوَاجَه جْمَاعث ن لْحُكَّام ن أَيث-إِسْرَائِيل</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />ئِكَّر اَرَّايس ن ڒْفُقَهَا ينَّا-ٱس إِ سْتِيفَان: "مَا ذ صَّح مَانَايَا؟"<verse eid="ACT 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 7:2" />ينَّا-ٱسن سْتِيفَان: "آي أَيثْمَا! آ يِنِّي يمْغَارن! صنّْطث غَاڒِي. وَامِي تُوْغَا يدْجَا جدِّيثْنغ بْرَاهِيم ذِي ثْمُوْرْث نِّي ن مِيسُوْبُوْطَامْيَا قْبڒ مَا ٱذ يزْذغ ذِي ثنْدِينْت ن حَارَان، ئِمظْهَار-اَس-د أَربِّـي لْعَظِيم <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />ينَّا-ٱس: كَّر، فّغ شك سَّا زِي ثْمُوْرْث-أَ نّش، اجّ ڒحْبَاب نّش رُوْح غَار ثْمُوْرْث نِّي إِي ذَاش د غَا سظْهَارغ.<verse eid="ACT 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 7:4" />ئِكَّر بْرَاهِيم يُوْيُوْر زِي ثْمُوْرْث نِّي ن يكَلْدَانِيْين، <char style="it">يعْنِي مِيسُوْبُوْطَامْيَا،</char> ئِرُوْح يزْذغ ذِي ثنْدِينْت ن حَارَان. وَامِي يمُّوْث بَابَاس، يُوْوِي-ث أَربِّـي غَار ثْمُوْرْث-أَ مَانِي ثزدّْغم رخُّو. <verse eid="ACT 7:4" /><verse number="5" style="v" sid="ACT 7:5" />وَلَكِن وَار ذَاس يُوْشِي ؤُڒَا ذ شّْبَار زِي ثْمُوْرْث-أَ اَث يمْلك. ذِي ڒْوقْث نِّي بْرَاهِيم وَار غَارس بُو ثَارْوَا. وَاخَّا اَمنِّي يوْعذ-يث أَربِّـي ينَّا-ٱس: أَذَاش ؤُشغ ثَمُوْرْث-أَ اَذ تِيڒِي نّش شك ذ دُّوْرِّيث نّش منْبَعْد إِ شك.<verse eid="ACT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 7:6" />أَمُّو إِي ذَاس ينَّا أَربِّـي: دُّوْرِّيث نّش اَذ عِيشن ذِي ثْمُوْرْث ن مِيدّن، أَذ يڒِين ذ يسمْغَان<note caller="+" style="f"><char style="fr" closed="false">7‏.6 </char><char style="ft" closed="false">ئِسمْغَان نِثْنِي ذ لْعَبِيد.</char></note> ن أَيثْبَاب ن ثْمُوْرْث نِّي، أَخَاسن سّكّن تَمَارَا اَرْبعمِيَّا يسݣّْوُوْسَا. <verse eid="ACT 7:6" /><verse number="7" style="v" sid="ACT 7:7" />وَلَكِن أَربِّـي يقَّار: اَذ عَقْبغ يوْذَان ن ثْمُوْرْث نِّي إِي ثن يݣِّين ذ يسمْغَان، منْبَعْد اَذ فّْغن سّنِّي <char style="it">دُّوْرِّيث نّش</char> اَذ تِيڒِي عبّْذن-اَيِي ذݣ ومْشَان-أَ.<note caller="+" style="f"><char style="fr" closed="false">7‏.7 </char><char style="ft" closed="false">أَمْشَان-أَ يخس اَذ يِينِي ثَمُورْث ن أَيث-إِسْرَائِيل.</char></note><verse eid="ACT 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 7:8" />فَا أَربِّـي يُوْشَا-ٱس ڒْعَهذ نِّي ن طَّهَارث إِ بْرَاهِيم. بْرَاهِيم يجَّا-د إِسْحَاق، ئِطهَّار-يث نْهَار وِيس ثْمنْيَام. إِسْحَاق يجَّا-د يعْقُوْب. يعْقُوْب يجَّا-د ثنْعَاش ن ڒجْذُوْذ نّغ. <verse eid="ACT 7:8" /><verse number="9" style="v" sid="ACT 7:9" />ڒجْذُوْذ نّغ حسّْذن <char style="it">ؤُمَاثْسن</char> يُوْسف، زّنْزن-ث اَذ يذْوڒ ذ يسْمغ ذِي مِصْرَا. وَلَكِن أَربِّـي اَقَاث اَكِذس، <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />ئِفكّ-يث زِي مَارَّا تَمَارَا نّس. يُوْشَا-اَس لْحِكْمَا، ئِسْعِيزّ-يث غَار فِيرْعُوْن يعْنِي اَزدْجِيذ ن مِصْرَا. ئِݣِّي-ث فِيرْعُوْن اَذ يحْكم خ مِصْرَا ذ ڒقْصَار نّس يكْمَاڒ.<verse eid="ACT 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 7:11" />ثُمَّا يوْقع بُوْهيُّوْف ذِي مَارَّا ثِمُوْرَا ن مِصْرَا ذ كَنْعَان. ثكَّا خَاسن تَمَارَا ذ ثَمقّْرَانْت، ڒجْذُوْذ نّغ وَار ؤُفِين مِين غَا شّن. <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />وَامِي يسْڒَا يعْقُوْب مِصْرَا ذَايس ذِنِّي يرْذَان، ئِسّكّ ڒجْذُوْذ نّغ ذِنِّي ثْوَاڒَا ثَمزْوَارُوْت. <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />وَامِي رُوْحن ذِنِّي ثْوَاڒَا وِيس ثْنَاين، ينَّا-ٱسن يُوْسف إِ اَيثْمَاس اَقَا نش ذ ؤُمَاثْوم يُوْسف، ڒخْدّنِّي عقْڒن-ث. سّنِّي إِݣ يسّن فِيرْعُوْن ڒحْبَاب ن يُوْسف. <verse eid="ACT 7:13" /><verse number="14" style="v" sid="ACT 7:14" />يُوْسف يسّكّ اَذ د اَوِين بَابَاس يعْقُوْب ذ ڒحْبَاب نّس، ذَايْسن خمْسَا أُو سبْعِين إِذْسن. <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />ئِهْوَا-د يعْقُوْب غَار مِصْرَا مَانِي يمُّوْث نتَّا ذ ڒجْذُوْذ نّغ. <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />مّيْسِين-د سّنِّي ؤُوِين-ثن غَار ثْمُوْرْث ن شَكِيم، نضْڒن-ثن ذِنِّي ذݣ ونْضڒ نِّي إِي تُوْغَا يسْغَا بْرَاهِيم س شَان ن نُّقَارْث خ اَيث-حَمُّوْر ذِي شَكِيم.<verse eid="ACT 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17" />ثُمَّا وَامِي د ثْقَارّب ڒْوقْث نِّي إِي ذِي غَا يكمّڒ أَربِّـي اَوَاڒ نّس مِينْزِي تُوْغَا يوْعذ بْرَاهِيم، ئِكْثَر شَّعْب نّغ ذِي مِصْرَا يمَارْنِي-د اَطَّاس. <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />ئِمظْهَار-د يجّن ن وزدْجِيذ نّغْنِي ذِي مِصْرَا نتَّا وَار يسِّين شَا يُوْسف. <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />ئِخدّع شَّعْب نّغ يسّكّ-يت خ ڒجْذُوْذ نّغ، ئِتݣّ خَاسن بسِّيف بَاش اَذ نْضَرن يسيْمَان نْسن غَار بَارَّا حمَا اَذ مّْثن. <verse eid="ACT 7:19" /><verse number="20" style="v" sid="ACT 7:20" />ذِي ڒْوقْث نِّي يخْڒق-د مُوْسَى، نتَّا ذ اَصبْحَان اَطَّاس. ئِتْوَاربَّا ثڒْت شْهُوْر ذِي ثدَّارْث ن بَابَاس. <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />وَامِي ث نْضَرن غَار بَارَّا، ثيْسِي-ث يدْجِيس ن فِيرْعُوْن ثْربَّا-ث ثَارِّي-ث ذ مِّيس. <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />أُوْشَا سْڒمْذن-اَس إِ مُوْسَى مَارَّا مِين سّْنن يمِصْرِين، ئِذْوڒ غَارس جّْهذ ذِي مِين يقَّار ذ مِين يتݣّ.<verse eid="ACT 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23" />ثُمَّا وَامِي يكمّڒ اَرْبعِين يسݣّْوُوْسَا، يرزُّو اَذ يفْقذ اَيثْمَاس يعِنِي أَيث-إِسْرَائِيل. <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />ئِࢲْرَا يِجّن ن ومِصْرِي يعدّ خ يِجّن ن وئِسْرَائِيلِي، ئِرُوْح نتَّا يذَافع خ ونِّي يتْوَاضڒْمن، ئِنْتَاقم-اَس ينْغَا اَمِصْرِي نّي. <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />نتَّا ينْوَا اَيثْمَاس أَيث-إِسرائيل اَذ فهْمن بلِّي اَثن يسنْجم أَربِّـي خ وفُوْس نّس، وَلَكِن نِثْنِي وَار فْهِيمن شَا. <verse eid="ACT 7:25" /><verse number="26" style="v" sid="ACT 7:26" />ثِيوشَّا نّس يُوْفَا ثْنَاين يسْرَائِيلِيْين تْمنْغَان جَارَاسن يخس اَثن يسْمصْڒَاح ينَّا-ٱسن: كنِّيو ذ اَوْمَاثن، مَايمِّي تْعدَّام خ وَايَاوْيَا؟ <verse eid="ACT 7:26" /><verse number="27" style="v" sid="ACT 7:27" />يكَّر-د ونِّي يتْعدَّان، يعَانّ-يث ينَّا-ٱس: ؤُو ش يݣِّين شك ذ اَرَّايس نِغ ذ ڒْقَاضِي خَانغ؟ <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />مَا ثْرزُّوْذ اَذَايِي ثنْغذ اَم ثنْغِيذ أَمِصْرِي نِّي ن إِضنَّاظ؟ <verse eid="ACT 7:28" /><verse number="29" style="v" sid="ACT 7:29" />وَامِي يسْڒَا مُوْسَى مَانَايَا، ئِكَّر يَرْوڒ يرُوْح غَار ثْمُوْرْث ن مِدْيَان يعِيش ذِنِّي ذ اَبَرَّانِي. خڒْقن-د غَارس ذِنِّي ثْنَاين ن يحنْجِيرن.<verse eid="ACT 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30" />ثُمَّا وَامِي عْذُوْن اَرْبعِين يسݣُّوُوْسَا، ثْبدّ-د غَارس يجّن ن لْمَلَائِكَا زݣ وحَذُوْق ن ثْمسِّي ثْرقّ ذݣ ؤُخْشَاب<note caller="+" style="f"><char style="fr" closed="false">7‏.30 </char><char style="ft" closed="false">مَاشِي مَعْرُوْف مِين يعْنَا وخْشَاب-أَ، وَلَكِن يمْكن ذ شَان اَرْبِيع اَم ثَابْغَا نِغ اَم شَان ثْشجَّارْث ثَمزْيَانْت ذَايس يسنَّانن.</char></note> ذِي صَّحْرَا زَّاث إِ وذْرَار ن سِينَا. <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />وَامِي يࢲْرَا مُوْسَى مَانَاينِّي يتْعجّب، ئِقَارّب غَارس اَذ يخْزَر. ئِسْڒَا إِ صُّوْت ن سِيذِي أَربِّـي يقَّار-اَس: <verse eid="ACT 7:31" /><verse number="32" style="v" sid="ACT 7:32" />نش ذ أَربِّـي ن ڒجْذُوْذ نّش، ذ أَربِّـي ن بْرَاهِيم ذ إسْحاق ذ يعْقُوْب. ئِبْذَا مُوْسَى يترْجِيجِي س ثِيݣّْوْذِي وَار يزْعِيم شَا اَذ يخْزَر.<verse eid="ACT 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 7:33" />ينَّا-ٱس سِيذِي أَربِّـي: كّس ثِيسِيڒَا زݣ يضَارن نّش قَا اَمْشَان-أَ مَانِي ثْبدّذ نتَّا مُقدّس. <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />أَقَا ࢲْرِيغ ڒَعْذَاب ن شَّعْب ينُو يدْجَان ذِي مِصْرَا، سْڒِيغ إِ يغُوْيَان نْسن اَقَا هْوِيغ-د اَثن سْنجْمغ. ڒخُّو اَرَاح-د شك اَش سّكّغ غَار مِصْرَا.<verse eid="ACT 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35" />مُوْسَى-يَا نْكَرن-ث نَّان-اَس: ؤُو ش يݣِّين شك ذ اَرَّايس نِغ ذ ڒْقَاضِي خَانغ؟ وَلَكِن نتَّا يسّكّ-يث أَربِّـي اَذ يِيڒِي ذ اَرَّايس ذ ونِّي إِي ثن غَا يسْنجْمن. ئِسّكّ-يث أَربِّـي خ وفُوْس ن لْمَلَائِكَا نِّي إِي ذَاس د يمظْهَارن ذݣ ؤُخْشَاب نِّي. <verse eid="ACT 7:35" /><verse number="36" style="v" sid="ACT 7:36" />مُوْسَى-يَا ذ نتَّا إِي ثن يسُوْفْغن س ڒَعْجَايب ذ لْمُعْجِيزَاث إِي يݣَّا ذِي مِصْرَا، ذِي ڒبْحَر اَزݣّْوَاغ، ؤُڒَا ذِي صَّحْرا اَرْبعِين يسݣّْوُوْسَا.<verse eid="ACT 7:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 7:37" />ذ مُوْسَى-يَا إِي ذَاسن ينَّان إِ أَيث-إِسرائيل: أَذَاوم د يُوْش أَربِّـي يجّن ن نَّبِي زݣ اَيثْمَاثْوم اَم نش. <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />ذ نتَّا <char style="it">مُوْسَى</char> إِي يݣُّوْرن اَك جْمَاعث ن أَيث-إِسْرَائِيل إِݣ يمُوْنن ذِي صَّحْرَا. ذ نتَّا مِيكذ ثسِّيوڒ لْمَلَائِكَا خ وذْرَار ن سِينَا ذ ڒجْذُوْذ نّغ. ذ نتَّا إي خف د هْوَان وَاوَاڒن يدَّرن حمَا اَذَانغ ثن يُوْش.<verse eid="ACT 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39" />وَلَكِن ڒجْذُوْذ نّغ ؤُݣِين اَذَاس طَاعن ؤُݣِين اَث قبْڒن، نْوَان ذݣ وُوْڒَاون نْسن اَذ ذوْڒن غَار مِصْرَا. <verse eid="ACT 7:39" /><verse number="40" style="v" sid="ACT 7:40" />نَّان-اَس إِ هَارُون:<note caller="+" style="f"><char style="fr" closed="false">7‏.40 </char><char style="ft" closed="false">هَارُون نتَّا ذ ومَاس ن سِيذْنَا مُوْسَى.</char></note> صْنع-اَنغ لْأَصْنَامَاث حمَا اَذ يڒِين ذ أَربِّـيثن نّغ اَثن نيْسِي غَار زَّاث نّغ. وَار نسِّين شَا مَانِيس يكَّا مُوْسَى-يَا إي ذَانغ د يسُوْفْغن زِي مِصْرَا! <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />ذِي ڒِيَّام نِّي صنْعن يجّن ن لْأَصْنَام خ تصْوِيرْث ن وينْدُوْز. قدّْمن-اَس دْبِيحث، فَرْحن اَطَّاس خ مِين ݣِّين س يفَاسّن نْسن.<verse eid="ACT 7:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 7:42" />ئِبعّذ خَاسن أَربِّـي، يجِّي-ثن اَذ عبّْذن يثْرَان ن وجنَّا اَم مَامّش يقَّار لْكِتَاب ن لْأَنْبِيَا:</para>
  <para style="q1" vid="ACT 7:42">"آي أَيث-إِسْرَائِيل، وَامِي تْقدَّامم دْبِيحث ذ تضْحِيّث</para>
  <para style="q2" vid="ACT 7:42">ذِي اَرْبعِين يسݣّْوُوْسَا نِّي ذِي صَّحْرَا،</para>
  <para style="q2" vid="ACT 7:42">مَا ثݣِّيم-اَيِي-ت إِ نش نِغ؟<verse eid="ACT 7:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43" />لَّا، ثيْسِيم اَقِيضُوْن ن لْأَصْنَام ؤُمِي قَّارن مُوْلُوْخ،</para>
  <para style="q2" vid="ACT 7:43">ذ يِيثْرِي ن أَربِّـي نْوم ؤُمِي قَّارن رَفَان.</para>
  <para style="q2" vid="ACT 7:43">ذ يِيْنَا ذ لْأَصْنَامَاث إِي ثݣِّيم بَاش اَثن ثْعبْذم!</para>
  <para style="q1" vid="ACT 7:43">خ مَانَايَا نش اَخَاوم اَزّْڒغ اَغِيرِين إِ ثْمُوْرْث ن بَابِل."<verse eid="ACT 7:43" /></para>
  <para style="b" />
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44" />غَارْسن غَار ڒجْذُوْذ نّغ ثَمْزِيذَا وقِيضُوْن ن أَربِّـي ذِي صَّحْرا. ئِݣِّي-ت مُوْسَى اَمش إِي ث يُوْمَر أَربِّـي عْلَاحْسَاب شّْكل إِي تُوْغَا يࢲْرَا. <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />ثَمْزِيذَا نِّي وقِيضُوْن ثمُّوْش-اَسن إِ ڒجْذُوْذ نّغ. نِثْنِي يْسِين-ت اَكِذْسن اَك يَشُوْع<note caller="+" style="f"><char style="fr" closed="false">7‏.45 </char><char style="ft" closed="false">سِيذْنَا يَشُوْع تُوْغَا نتَّا ذ اَخدَّام ن سِيذْنَا مُوْسَى، يحْكم خ أَيث-إِسْرَائِيل وَامِي يمُّوْث سِيذْنَا مُوْسَى.</char></note> غَار ثْمُوْرْث-أَ ن ڒݣْنُوْس إِي خف يُوْزّڒ أَربِّـي زَّاث إِ ڒجْذُوْذ نّغ. ثقِّيم اَمنِّي اَڒ وُوْسَّان ن دَاود. <verse eid="ACT 7:45" /><verse number="46" style="v" sid="ACT 7:46" />دَاود يرْضَا خَاس أَربِّـي ينَّا-ٱس: آ سِيذِي أَربِّـي ن جدِّيثْنغ يَعْقُوْب، اَجّ-اَيِي اَذ ذبَّرغ يجّن ن ومْشَان اَذَايس ثِيڒِي ثْزدِّيغْث نّش. <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />وَلَكِن يرُوْح سُلِيمَان يبْنَا نتَّا يجّن ن ثدَّارْث إِ أَربِّـي. <verse eid="ACT 7:47" /><verse number="48" style="v" sid="ACT 7:48" />وَاخَّا اَمنِّي قَا أَربِّـي يُوْعْڒَان وَار يزدّغ شَا ذِي ثُوْذْرِين إِي بنَّان س يفَاسّن. أَمش ينَّا نَّبِي <char style="it">إِشَعْيَا</char>:<verse eid="ACT 7:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="ACT 7:49" />ئِقَّار سِيذِي أَربِّـي اَجنَّا ذ لْعَرْش ينُو،</para>
  <para style="q2" vid="ACT 7:49">ذ ثَمُوْرْث مِيخ سْرُوْسِيغ يضَارن ينُو.</para>
  <para style="q1" vid="ACT 7:49">مَامّش ثݣَّا ثدَّارْث إِي ذَايِي غَا ثبْنَام؟</para>
  <para style="q2" vid="ACT 7:49">مَانِي غَا يِيڒِي ومْشَان ن اَرَّاحث ينُو؟<verse eid="ACT 7:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="ACT 7:50" />مَا وَار يدْجي شَا ذ فُوْس ينُو إِي د يخڒْقن مَانَايَا كُڒْشِي؟<verse eid="ACT 7:50" /></para>
  <para style="b" />
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51" />
    <char style="it">ينَّا-ٱسن سْتِيفَان:</char> آ يِنِّي إِي ذِي ثدْجَا ثْغنَّانْت، قَا ؤُڒَاون نْوم ذ يمجَّان نْوم قّْنن!<note caller="+" style="f"><char style="fr" closed="false">7‏.51 </char><char style="ft" closed="false">س ڒْمَعْنَا ن ثْيُوْنَانِيث يقَّار ؤُڒَاون نْوم ذ يمجَّان نْوم وَار طهَّارن شَا.</char></note> كنِّيو تݣّم مَامّش إِي ݣِّين ڒجْذُوْذ نْوم، كِيف-كِيف. ڒبْدَا تْعَارَّاضم-اَس إِ أَرُّوْح يقدّْسن. <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />مَا ينْجم شَان ن نَّبِي وَار ث عدّْبن شَا ڒجْذُوْذ نْوم؟ نِثْنِي نْغِين ؤُڒَا ذ لْأَنْبِيَا نِّي ن زْمَان إِي ينَّان قَا ٱذ د يَاس ونِّي يدْجَان صَّالِح، يعْنِي ونِّي ڒخُّو ثْخذْعم كنِّيو ثنْغِيم-ث.<note caller="+" style="f"><char style="fr" closed="false">7‏.52 </char><char style="ft" closed="false">ونِّي خذْعن نْغِين-ث نتَّا ذ سِيذِيثْنغ عِيْسَى.</char></note> <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />ثطّْفم شَّرِيعَا خ وفُوْس ن لْمَلَائِكَاث، كنِّيو وَار زَّايس ثݣَّيم شَا."<verse eid="ACT 7:53" /></para>
  <para style="s">ڒْموْث ن سْتِيفَان</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />وَامِي سْڒِين جْمَاعث نِّي ن لْحُكَّام ن أَيث-إِسْرَائِيل اَوَاڒ ن سْتِيفَان، خيّْقن غضْبن، تْغࢲَّاࢲن غَارس ثِيغْمَاس. <verse eid="ACT 7:54" /><verse number="55" style="v" sid="ACT 7:55" />سْتِيفَان يشُّوْر س أَرُّوْح يقدّْسن، يخْزَر غَار وجنَّا يࢲْرَا لْعَظَمَا ن أَربِّـي يُوْفَا عِيْسَى يبدّ خ وفُوْسِي ن أَربِّـي. <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />ينَّا: "أَقَا تْوَاڒِيغ اَجنَّا ينُوْرْزم ذ مِّيس ن بْنَاذم يبدّ خ وفُوْسِي ن أَربِّـي."<verse eid="ACT 7:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57" />سْنكَّرن ثْغُوْيّث س جّْهذ بلّْعن خ يمجَّان نْسن، هجْمن خَاس مَارَّا إِذْسن. <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />سُوْفْغن-ث بَارَّا إِ ثنْدِينْت بْذَان رجّْمن-ث س وزْرُو. سرْسن يزدْجُوْبَا نْسن غَار يضَارن ن يِجّن ن شَّاب قَّارن-اَس شَاوُل. <verse eid="ACT 7:58" /><verse number="59" style="v" sid="ACT 7:59" />قِّيمن رجّْمن سْتِيفَان س وزْرُو نتَّا ينَّا: "آ سِيذِيثْنغ عِيْسَى، قْبڒ بُوْحْبڒ ينُو!" <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />يوْضَا خ يفَادّن ينَّا-ٱس س جّْهذ: "آ سِيذِي، وَار خَاسن حسّب شَا ڒْمُعْصِيّث-أَ!" وَامِي ينَّا مَانَايَا صَافِي يفّغ-يث بُوْحْبڒ نّس.<verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="s">شَاوُل يتْعدَّاب جْمَاعث ن ڒْمُوْمِنِين</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />وَامِي نْغِين سْتِيفَان، ئِجّن قَّارن-اَس شَاوُل اَقَاث ذِنِّي <char style="it">يحْضَار</char> يتَافق اَكِذْسن. نْهَار نِّي بْذَان تْعدَّابن جْمَاعث ن ڒْمُوْمِنِين ذِي ثنْدِينْت ن لْقُدْس. مسْفْرَاقن مَارَّا ڒْمُوْمِنِين رُوْحن غَار جْوَايه ن يَهُوْذِيَا ذ سَامَرْيَا كُڒ يجّن مَانِي يرُوْح، وَار يقِّيم حَدّ ذِي لْقُدْس إِلَّا اَرُّسُل. <verse eid="ACT 8:1" /><verse number="2" style="v" sid="ACT 8:2" />شَان ن يرْيَازن إِي تݣّْوْذن أَربِّـي نضْڒن سْتِيفَان حزْنن خَاس اَطَّاس. <verse eid="ACT 8:2" /><verse number="3" style="v" sid="ACT 8:3" />شَاوُل نتَّا يرزُّو اَذ يقْضَا خ جْمَاعث ن ڒْمُوْمِنِين، يتَاذف زِي ثدَّارث غَار ثدَّارْث يسُوْفُوْغ-د يرْيَازن ذ ثمْغَارِين يتݣّ-يثن ذِي ڒحْبس.<verse eid="ACT 8:3" /></para>
  <para style="s">تْبشَّارن س لْإِنْجِيل ذِي ثنْدِينْت ن سَمَارْيَا</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4" />ڒْمُوْمِنِين نِّي يمسْفْرَاقن تْرَاحن زݣ ومْشَان غَار ومْشَان تْبشَّارن س وَاوَاڒ ن أَربِّـي. <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" />فِيلِيپَّـاس يرُوْح غَار ثنْدِينْت ن سَمَارْيَا، ئِتْحدَّاث إِ يمزْذَاغ نّس س لْمَسِيح. <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />سّنِّي مَارَّا ڒْغَاشِي نِّي وَامِي سْڒِين إِ وَاوَاڒ نّس وَامِي ࢲْرِين لْمُعْجِيزَاث نِّي يݣَّا، قِّيمن تْصنَّاطن-اَس مْلِيح غَار مِين يقَّار. <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />جْنُوْن يعفَّانن فّْغن زݣ وَاطَّاس ن يِوْذَان سْنكَّرن ثْغُوْيّث س جّْهذ. أَطَّاس ن يزحَّافن ذ يِنِّي ؤُمِي مُّوْثن يضَارن ݣنْفَان. <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />فَرّْحن اَطَّاس ذِي ثنْدِينْت نِّي.<verse eid="ACT 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9" />ذِنِّي ذِي ثنْدِينْت نِّي يجّن ن وسحَّار قّارن-اَس سِمْعَان مشْحَاڒ زݣ وَامِي يسْخدَّام سّْحُوْر. ئِسذْهَاش مَارَّا يوْذَان ن أَيث-سَمَارْيَا، يَارَّا يخف نّس ذ اَمقّْرَان. <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />تسْڒَان-اَس مَارَّا يوْذَان س ومزْيَان ذ ومقّْرَان نَّان خَاس: "أَرْيَاز-أَ نتَّا ذ جّْهذ نِّي اَمقّْرَان ن أَربِّـي إِي يدْجَان عَظِيم!" <verse eid="ACT 8:10" /><verse number="11" style="v" sid="ACT 8:11" />تسْڒَان-اَس مِنْزِي يسذْهَاش-يثن اَطَّاس ن ڒْوقْث س سّْحُوْر نّس. <verse eid="ACT 8:11" /><verse number="12" style="v" sid="ACT 8:12" />وَلَكِن وَامِي ثن يبشَّر فِيلِيپَّـاس س ڒْمُلْك ن أَربِّـي ذ يِيسم ن عِيْسَى لْمَسِيح ڒخْدّنِّي ؤُمْنن تتْوَاطهَّارن س وَامَان س يرْيَازن ذ ثمْغَارِين. <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />سِمْعَان نتَّا س يِيخْف نّس يُوْمن يتْوَاطهَّار س وَامَان. ئِمُوْن اَك فِيلِيپَّـاس يتْعجّب سِمْعَان وَامِي يࢲْرَا لْمُعْجِزَاث ذ لْبُرْهَانَاث ذ ثِمقّْرَانِين إِݣ يتوْقِيعن.<verse eid="ACT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14" />وَامِي د اَرِّين ڒخْبَر اَرُّسُل ذِي لْقُدْس قَا اَيث-سَامَرْيَا قبْڒن اَوَاڒ ن أَربِّـي، كَّرن سّكّن غَارْسن بُطْرُس ذ يُوْحَنَّا. <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />وَامِي ؤُوْضن، تَّارن-اَس إِ أَربِّـي اَذَاسن يُوْش أَرُّوْح يقدّْسن. <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />عَاذ وَار د يهْوِي أَرُّوْح ؤُڒَا خ يِجّن زَّايْسن مِينْزِي تُوْغَا تْوَاطهَّارن س وَامَان عْلَاحْسَاب يسم ن سِيذِيثْنغ عِيْسَى أُو صَافِي. <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />ثُمَّا بُطْرُس ذ يُوْحَنَّا سرْسن خَافْسن يفَاسّن نْسن أُوْشَا يمُّوْش-اَسن أَرُّوْح يقدّْسن.<verse eid="ACT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18" />وَامِي سرْسن اَرُّسُل يفَاسّن نْسن خ يِوْذَان يتْوَاڒَا سِمْعَان بلِّي يمُّوْش-اَسن اَرُّوْح يقدّْسن، ئِكَّر سِيمْعَن يرزُّو اَذَاسن يُوْش تْمنْيَاث <char style="it">إِ اَرُّسُل</char>. <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />ينَّا-ٱسن: "ؤُشم-اَيي ؤُڒَا ذ نش جّْهذ-أَ حمَا ونِّي إِي خف غَا سرْسغ يفَاسّن ينُو اَذَاس يمُّوْش أَرُّوْح يقدّْسن."<verse eid="ACT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20" />ئِكَّر بُطْرُس ينَّا-ٱس: "لَّا، جْمع نُّقَارْث نّش قَا اَذ تِيڒِي ذ ثِمسِّي اَكِذش ذِي ڒفْنَا مِنْزِي ثنْوِيذ اَذ تسْغذ لْهَدِيَا ن أَربِّـي س تْمنْيَاث! <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />وَار غَارك يتِيڒِي بُو ومْشَان ؤُڒَا ذ ڒْحَقّ ذِي ڒْخذْمث-أَ ڒَاحقَّاش ؤُڒ نّش وَار يدْجِي شَا نِيشَان اَك أَربِّـي. <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />تُوْب زِي شَّرّْ نّش، تَّار إِ سِيذِي أَربِّـي يمْكن اَذَاش يغْفَر مِين ثنْوِيذ ذݣ وُوْڒ نّش. <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />تْوَارِيغ شك ثشُّوْرذ س ثَارْزُوْݣِي ن ڒحْسذ، شك ذ اَمحْبُوْس ن شَّرّْ."<verse eid="ACT 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24" />ينَّا-ٱس سِمْعَان: "تَّارث اَكِذِي غَار سِيذِي أَربِّـي حمَا وَار ذَايِي توْقِيع ؤُڒَا ذ يجّن ن ڒْحَاجث زِي مِين ثنِّيم."<verse eid="ACT 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25" />وَامِي بُطْرُس ذ يُوْحَنَّا شهْذن <char style="it">خ عِيْسَى</char> بشَّرن نِثْنِي س وَاوَاڒ ن سِيذِي أَربِّـي، كَّرن ذوْڒن غَار لْقُدْس بشَّرن س لْإِنْجِيل ذݣ وَاطَّاس ن ڒدْشُوْرَاث ذِي سَمَارْيَا.<verse eid="ACT 8:25" /></para>
  <para style="s">فِيلِيپَّـاس اَك يِجّن ن لْوَزِير ن ثْمُوْرْث ن لْحَبَشَا</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />ئِجّن لْمَلَائِكَا ن سِيذِي أَربِّـي ثسِّيوڒ-د غَار فِيلِيپَّـاس ثنَّا-ٱس: "كَّر، رُوْح غَار لْجَنُوْب اكّ خ وبْرِيذ نِّي ن ڒخْڒَا يتَاوِين زِي لْقُدْس غَار غَزَّا." <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />ئِكَّر يرُوْح، ئِمْسڒْقَا ذِنِّي اَك يِجّن ن ورْيَاز نتَّا ذ اَحْبَاشِي ذ اَخَاصْيُوْنِي.<note caller="+" style="f"><char style="fr" closed="false">8‏.27 </char><char style="ft" closed="false">أَخَاصِيُوْنِي يعْنِي س ثعْرَابْث &lt;خَصِيٌّ&gt; أُو &lt;eunuque&gt; س ثْفْرَانْسِيسْت.</char></note> نتَّا زݣ يمقّْرَانن ن لْمَلِكَا ن لْحَبَشَا قَّارن-اَس نتَّاث كَنْدَاكَا، نتَّا إِݣ يتْكلَّافن خ صّنْدُوْق ن تْمنْيَاث ن لْمَلِكَا نِّي. تُوْغَا يرُوْح غَار لْقُدْس اَذ يعْبذ أَربِّـي، <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />ئِذْوڒ-د غَار لْحَبَشَا ينْيَا خ وكَارُّو نّس يقَّار ذِي لْكِتَاب ن نَّبي إِشَعْيَا.<verse eid="ACT 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 8:29" />ينَّا-ٱس أَرُّوْح ن أَربِّـي إِ فِيلِيپَّـاس: "يَالَّاه، مُوْن اَك وكَارُّو-يِين."<verse eid="ACT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 8:30" />يُوْزّڒ فِيلِيپَّـاس غَار وحَبَاشِي نِّي يتسْڒَا-يَاس يقَّار ذِي لْكِتَاب ن نَّبِي إِشَعْيَا. ينَّا-ٱس: "مَا ثْفهْمذ مِين ثقَّارذ؟"<verse eid="ACT 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 8:31" />ينَّا-ٱس وحَبَاشِي نِّي: "نش، مَامّش غَا ݣّغ اَذ فهْمغ مڒَا وَار ذَايي يسفْهم شَان يِجّن؟ يَالَّاه نيْ-د اَكِذِي ذݣ وكَارُّو-يَا." <verse eid="ACT 8:31" /><verse number="32" style="v" sid="ACT 8:32" />أَقَا لْأَيَاث نِّي إِي يقَّار وحَبَاشِي ذِي لْكِتَاب:</para>
  <para style="q" vid="ACT 8:32">&lt;نتَّا اَمشْنَاو اَحُوْڒِي إِي تَاوِين اَذَاس غَرْصن،</para>
  <para style="q" vid="ACT 8:32">أَمشْنَاو يزْمَار إِي يذْوڒ ذ اَزيْزُوْن</para>
  <para style="q2" vid="ACT 8:32">زَّاث إِ ينِّي يتْڒَاسّن ثَاضُوْفْث نّس،</para>
  <para style="q" vid="ACT 8:32">أَمّن وَار يرزّم شَا نتَّا اَقمُّوْم نّس.<verse eid="ACT 8:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="ACT 8:33" />ضڒْمن-ث، كْسِين-اَس ڒحَقّ نّس.</para>
  <para style="q" vid="ACT 8:33">وَار غَارس ثدْجِي دُّوْرِّيث اَخَاس يِيڒِي وَاوَاڒ.</para>
  <para style="q" vid="ACT 8:33">ثُوْذَارْث نّس تْوَاكّس خ ثْمُوْرْث-أَ.&gt;<verse eid="ACT 8:33" /></para>
  <para style="b" />
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34" />ئِسّقْسَا وحَبَاشِي نِّي فِيلِيپَّـاس ينَّا-ٱس: "تتَّارغ زَّايك اَذَايِي ثِينِيذ، مِيخف يسَّاوَاڒ نَّبِي-يَا؟ مَا خ يِيخف نّس نِغ خ شَان حَدّ نّغْنِي؟"<verse eid="ACT 8:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 8:35" />ئِتْشَرَّاح-اَس فِيلِيپَّـاس، ئِبْذَا-يَاس زِي لْأَيَاث-أَ ذِي لْكِتَاب يتْبشَّار-يث س عِيْسَى. <verse eid="ACT 8:35" /><verse number="36" style="v" sid="ACT 8:36" />ݣُّوْرن ذݣ وبْرِيذ ؤُوْضن غَار شَان وَامَان. ينَّا-ٱس وحَبَاشِي نِّي: "أَقَاش اَمَان مُوْجُوْد، مِين ذَايِي يُوْغن نش وَار تْوَاطهَّارغ شَا س وَامَان-أَ؟"<verse eid="ACT 8:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 8:37" />{ينَّا-ٱس فِيلِيپَّـاس: "شك مڒَا ثُوْمْنذ س مَارَّا ؤُڒ نّش قَا ثْزمَّرذ اَذ تْوَاطهَّارذ س وَامَان-أَ." يَارَّا خَاس ينَّا-ٱس: "وَاه، نش تَامْنغ بلِّي عِيْسَى لْمَسِيح نتَّا ذ مِّيس ن أَربِّـي."}<verse eid="ACT 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 8:38" />يُوْمَر وحَبَاشِي اَذ سْبدّن اَكَارُّو نِّي. هْوَان س ثْنَاين إِذْسن غَار وَامَان، فِيلِيپَّـاس يطهَّار-اَس إِ وحَبَاشِي نِّي س وَامَان. <verse eid="ACT 8:38" /><verse number="39" style="v" sid="ACT 8:39" />وَامِي د ݣَعّْذن زݣ وَامَان نِّي، أَرُّوْح ن سِيذِيثْنغ يرْفع فِيلِيپَّـاس سّنِّي. وَار يقِّيم شَا وحَبَاشِي نِّي يتْوَاڒَا فِيلِيپَّـاس كْتَار عَاذ، يُوْيُوْر خ وبْرِيذ نّس س ڒفْرَاحث. <verse eid="ACT 8:39" /><verse number="40" style="v" sid="ACT 8:40" />فِيلِيپَّـاس يُوْفَا يخف نّس ذِي ثنْدِينْت ن وَاشْدُوْد، ئِتْرَاح زݣ ومْشَان غَار ومْشَان يتْبشَّار س لْإِنْجِيل ذِي مَارَّا يبِيلَاجن حتَّا ٱڒ وَامِي يُوْوض غَار ثتْدِينْت ن قَيْصَارِيَا.<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="s">ئِتَامن شَاوْل س سِيذِيثْنغ عِيْسَى</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />شَاوْل عَاذ يتْهدَّاذ س ڒْموْث يمحْضَارن ن سِيذِيثْنغ. ئِكَّر يرُوْح غَار اَرَّايس ن ڒْفُقَهَا، <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />ئِتَّار زَّايس اَرُّخْصَاث اَثنْت ييْسِي غَار ثمْزِيذَاوِين ن أَيث-إِسْرَائِيل ذِي دِمَشق بَاش يِنِّي غَا يَاف ذفَّارن اَبْرِيذ ن عِيْسَى س ثمْغَارِين ذ يرْيَازن اَثن يَاوِي ذ يمحْبَاس غَار لْقُدْس. <verse eid="ACT 9:2" /><verse number="3" style="v" sid="ACT 9:3" />وَامِي يݣُّوْر غَار دِمَشق يقِّيم-اَس شْوَايْت اَذ يَاوض، عْلَاغَفْلَا ينّض-اَس-د يجّن ن نُّوْر يتْشعْشِيع-د خَاس زݣ وجنَّا. <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />ئِوْضَا غَار ثْمُوْرْث، ئِتسْڒَا إِ يِجّن ن ثْمِيجَّا ثقَّار-اَس-د: "آ شَاوُل آ شَاوُل، مَايمِّي ذَايِي تْعدَّابذ؟"<verse eid="ACT 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5" />يَارَّا خَاس شَاوْل ينَّا-ٱس: "مِين ثعْنِيذ شك آ سِيذِي؟"</para>
  <para style="p" vid="ACT 9:5">ثنَّا-ٱس ثْمِيجَّا نِّي: "نش ذ عِيْسَى ونِّي إِي تْعدَّابذ." <verse eid="ACT 9:5" /><verse number="6" style="v" sid="ACT 9:6" />ينَّا-ٱس: "كَّر اَذف غَار ثنْدِينْت، أَذَاش يتْوَانَّا ذِنِّي مِين يتْخصَّا اَذ تݣّذ."<verse eid="ACT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7" />يرْيَازن نِّي يسَفَارن اَك شَاوُل بدّن ذِنِّي ذوْڒن وَار سِّيوِيڒن شَا. سْڒِين إِ ثْمِيجَّا وَلَكِن وَار تْوِيڒِين حَدّ. <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />ئِكَّر شَاوُل زِي ثْمُوْرْث يرْزم ثِيطَّاوِين نّس يذْوڒ وَار يتْوِيڒِي وَالُو. طّْفن-ث زݣ وفُوْس نّس ؤُوِين-ث غَار دِمَشق. <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />ئِقِّيم ذِنِّي ثڒْتِيَّام وَار يتتّ شَا، وَار يسسّ شَا، وَار يتْوِيڒِي شَا.<verse eid="ACT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10" />ذِنِّي ذِي دِمَشق يجّن ن ومحْضَار قَّارن-اَس أَنَاس. ئِمظْهَار-اَس-د سِيذِيثْنغ ذِي لْوَاحِي ينَّا-ٱس: "آي أَنَاس."</para>
  <para style="p" vid="ACT 9:10">يَارَّا خَاس ينَّا-ٱس: "أَقَايِي آ سِيذِي."<verse eid="ACT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 9:11" />ينَّا-ٱس سِيذِيثْنغ: "كَّر رُوْح غَار زّنْقث نِّي ؤُمِي قَّارن &lt;أَبْرِيذ يسݣّْذن&gt;، رْزُو ذِنِّي ذِي ثدَّارْث ن يَهُوْذَا خ يِجّن ن ورْيَاز زِي ثنْدِينْت ن طَرْسُوْس، ئِسم نّس شَاوُل. نتَّا يتْࢲَادْجَا ذِنِّي. <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" />تُوْغَا يࢲْرَا ذِي لْوَحِي يجّن ن ورْيَاز قَّارن-اَس أَنَاس اَذ د يَاس اَخَاس يسرْس يفَاسّن نّس بَاش اَذ يذْوڒ يتْوَاڒَا."<verse eid="ACT 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13" />يَارَّا خَاس أَنَاس ينَّا-ٱس: "آ سِيذِي، نش خبَّرن-اَيي اَطَّاس ن يِوْذَان خ بْنَاذم-أَ <char style="it">شَاوُل</char>، مشْحَاڒ يعدّب نتَّا ڒْمُوْمِنِين نّش صَّالِحِين ذِي لْقُدْس. <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />ڒخُّو اَقَاث ذَا، ؤُشِين-اَس اَرُّخْصَا اَرُّوْيَاس ن ڒْفُقَهَا حمَا اَذ يطّف مَارَّا يِنِّي يعبّْذن س يِيسم نّش."<verse eid="ACT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 9:15" />ينَّا-ٱس سِيذِيثْنغ: "لَّا رُوْح، قَا اَرْيَاز-أَ ذ نش إِي ث يخْضَرن اَث سّكّغ حمَا اَذ يسِّيوض يسم ينُو إِ ينِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل، ذ يزدْجِيذن نْسن، ذ يسْرَائِيلِيْين. <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" />نش اَذَاس د سظْهَارغ مشْحَاڒ إِي غَا يتْوَاعدّب أُو لَابُد خ سَّبَاب ن يِيسم ينُو نش."<verse eid="ACT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17" />ئِرُوْح أَنَاس يُوْذف ثَدَّارْث نِّي يسرْس يفَاسّن نّس خ شَاوُل ينَّا-ٱس: "آي ؤُمَا شَاوُل، نش قَا يسّكّ-اَيي-د سِيذِيثْنغ عِيْسَى، ونِّي إِي ذَاش د يمظْهَارن ذݣ وبْرِيذ نِّي إِي د ثُوْوِيذ. ئِسّكّ-اَيي-د غَارك حمَا اَذ تْذوْڒذ تْوَاڒِيذ اَذ تشَّارذ س أَرُّوْح يقدّْسن." <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />ڒخْدّنِّي ثوْضَا-يَاس-د يجّن ن ڒْحَاجث زِي ثِيطَّاوِين نّس اَم ثقْشُوْرْث، يذْوڒ يتْوَاڒَا. ئِكَّر يتْوَاطهَّار س وَامَان. <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />وَامِي يشَّا، ئِذْوڒ-د غَارس جّْهذ نّس.</para>
  <para style="s" vid="ACT 9:19">شَاوُل يتْبشَّار ذِي ثنْدِينْت ن دِمَشق</para>
  <para style="p" vid="ACT 9:19">ئِقِّيم شَاوُل ڒبْعَاض ن وُوْسَّان اَك يمحْضَارن ذِي دِمَشق. <verse eid="ACT 9:19" /><verse number="20" style="v" sid="ACT 9:20" />ڒخْدّنِّي يبْذَا يتْحدَّاث ذِي ثمْزِيذَاوِين ن أَيث-إِسْرَائِيل يقَّار-اَسن قَا عِيْسَى ذ مِّيس ن أَربِّـي. <verse eid="ACT 9:20" /><verse number="21" style="v" sid="ACT 9:21" />تْعجّْبن مَارَّا ينِّي يتسْڒَان قَّارن: مَا وَار يدْجي ذ وَانِيتَا يرْزُوْن اَذ يقْضَا خ يِنِّي يتْڒَاغَان خ يِيسم-أَ ن عِيْسَى ذِي لْقُدْس؟ مَا وَار يدْجِي غَارْسن إِي د يُوْسَا ذَانِيتَا بَاش اَثن يطّف اَثن يَاوِي غَار اَرُّوْيَاس ن ڒْفُقَهَا؟ <verse eid="ACT 9:21" /><verse number="22" style="v" sid="ACT 9:22" />شَاوُل نتَّا يَرْنِي يتْحدَّاث س جّْهذ، يسذْهَاش أَيث-إِسْرَائِيل إِݣ يزدّْغن ذِي دِمَشق، ئِسبيّن-اَسن-د س وَاوَاڒ نّس قَا عِيْسَى ذ لْمَسِيح.<verse eid="ACT 9:22" /></para>
  <para style="p">
    <verse number="23‏-24" style="v" sid="ACT 9:23-24" />وَامِي عْذُوْن اَطَّاس ن وُوْسَّان، مْشَاوَارن أَيث-إِسْرَائِيل جَارَاسن حمَا اَذ نْغن شَاوُل، نتَّا يَارَّا-د ڒخْبَار. دْجِيڒث ذ نْهَار حطَّان ثِوُّوْرَا ن ثنْدِينْت حمَا اَث نْغن. <verse eid="ACT 9:23-24" /><verse number="25" style="v" sid="ACT 9:25" />ئِجّن ن دْجِيڒث يمحْضَارن نّس سرْوْڒن-ث، سهْوَان-ث-يذ س يسغْوَان ذݣ يِجّن ن وقْبُوْب<note caller="+" style="f"><char style="fr" closed="false">9‏.25 </char><char style="ft" closed="false">ئِقْبُوْبن تݣّن-ثن خ وسَرْذُوْن نقْڒن ذَايْسن يمنْدِي، يرْذَان، ئِبَاون، ثِنِيفِين أُو ذ ڒحْوَايج نّغْنِي.</char></note> <char style="it">زݣ يِجّن ن ثْبُوْرْجَات</char> ن صُّوْر ن ثنْدِينْت.<verse eid="ACT 9:25" /></para>
  <para style="s">شَاوُل ذِي ثنْدِينْت ن لْقُدْس</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />وَامِي د يُوْوض شَاوُل غَار لْقُدْس يرزُّو اَذ يمُوْن اَك يمحْضَارن، وَلَكِن ݣّْوْذن زَّايس مَارَّا وَار ذَايس تِّيقن شَا نتَّا ذ اَمحْضَار ن صَّح. <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />بَرْنَابَا يكَّر يكلّف زَّايس يُوْوِي-ث غَار اَرُّسُل. ئِعَاوذ-اَسن خَاس مَامّش ذَاس د يمظْهَار سِيذِيثْنغ إِ شَاوُل ذݣ وبْرِيذ نِّي ذ مَامّش إِي كِس يسِّيوڒ ذ مَامّش يتْحدَّاث س زْعَامث عْلَاحْسَاب يسم ن عِيْسَى ذِي دِمَشق. <verse eid="ACT 9:27" /><verse number="28" style="v" sid="ACT 9:28" />سّنِّي صَافِي، ئِتْرَاح يتَاس-د شَاوُل اَكِذْسن ذِي لْقُدْس، يتْحدَّاث س يِجّن ن زْعَامث عْلَاحْسَاب يسم ن سِيذِيثْنغ. <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />ئِسَّاوَاڒ اَك يسْرَائِيلِيْين يِنِّي يسَّاوَاڒن س لُّغَا ثَيُوْنَانِيث يتمْنَاقَار اَكِذْسن، سّنِّي نِثْنِي رزُّوْن اَث نْغن. <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />وَامِي د اَرِّين ڒخْبَار اَيثْمَاثْنغ، ؤُوِين-ث غَار قَيْصَارِيَا سّنِّي سّكّن-ث غَار ثنْدِينْت ن طَرْسُوْس.<verse eid="ACT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31" />ذِي ڒْوقْث نّي جْمَاعث ن ڒْمُوْمِنِين ذِي مَارَّا جْوَايه ن يَهُوْذِيَا ذ لْجَلِيل ذ سَمَارْيَا هْنَان. تْوَاجهْذن، تݣّْوْذن زِي سِيذِي أَربِّـي، تْوَاشجَّاعن س أَرُّوْح يقدّْسن، تْمَارْنِين <char style="it">ذِي لْعَدَد</char>.<verse eid="ACT 9:31" /></para>
  <para style="s">أَݣنْفِي ن يِجّن ن بْنَاذم قَّارن-اَس عِيْنْيَاس</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32" />بُطْرُس يتْرَاح زݣ ومْشَان غَار ومْشَان، ئِرُوْح يࢲْرَا ڒْمُوْمِنِين صَّالِحِين إِي زدّْغن ذݣ وبِيلَاج ن لُوْدَّا. <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />يُوْفَا ذِنِّي يجّن ن ورْيَاز قَّارن-اَس عِيْنْيَاس، نتَّا يزّڒ ثْمنْيَا يسݣّْوُوْسَا ذِي ثَاسُّوْث مُّوْثن-اَس يضَارن. <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />ينَّا-ٱس بُطْرُس: "آ عِيْنْيَاس، قَا شك يسْݣنْفَا-شك عِيْسَى لْمَسِيح! كَّر جْمع ثَاسُّوْث نّش." ڒخْدّنِّي يكَّر يبدّ خ يضَارن. <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />مَارَّا يوْذَان إِي زدّْغن ذݣ وبِيلَاج ن لُوْدَّا ذ ڒوْضَا ن شَارُوْن ࢲْرِين-ث تُوْبن غَار سِيذِي أَربِّـي.<verse eid="ACT 9:35" /></para>
  <para style="s">طَابِيتَا تْنكَّر-د زِي ڒْموْث</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />ذِي ثنْدِينْت ن يَافَا ذِنِّي يجّن ن ثْمحْضَارْث قَّارن-اَس طَابِيتَا (ڒْمَعْنَا ن يِيسم-أَ، &lt;ثِيغِيت ن وزْغَار&gt;). تݣّ ڒْخِير اَطَّاس تْعَاوَان يمسْعَان. <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />ذِي ڒْوقْث نّي ثهْڒش ثمُّوْث، يْسِينْت-تث سِيرْذنْت-تث سْݣَعّْذن-تث غَار يِجّن ن ثْغُوْرْفَات.<verse eid="ACT 9:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 9:38" />سْڒِين يمحْضَارن ذِي ثنْدِينْت ن يَافَا بلِّي بُطْرُس اَقَاث ذݣ وبِيلَاج ن لُوْدَّا. لُوْدَّا ثُوْذس-د إِ يَافَا، سّكّن غَارس ثْنَاين ن يِوْذَان حشْمن-ث نَّان-اَس: "عَافك اَرْوَاح اَكِذْنغ ذغْيَا!" <verse eid="ACT 9:38" /><verse number="39" style="v" sid="ACT 9:39" />ئِكَّر بُطْرُس يرُوْح اَكِذْسن. وَامِي يُوْوض سْݣَعّْذن-ث غَار ثْغُوْرْفَات نِّي. نّْضنْت-اَس-د إِ نتَّا مَارَّا ثَاجَّاڒِين، تْرُوْنت سظْهَارنْت-اَس يتْشَامِّيرن ذ يزدْجُوْبَا تُوْغَا ثْخيّض طَابِيتَا وَامِي تُوْغَا ثدْجَا اَكِذْسنْت. <verse eid="ACT 9:39" /><verse number="40" style="v" sid="ACT 9:40" />سّنِّي يسُوْفغ-يثن بُطْرُس مَارَّا زِي ثْغُوْرْفَات، يوْضَا خ يفَادّن يبْذَا يتْࢲَادْجَا. ئِخْزَر غَار دَّات نّس ينَّا-ٱس: "يَا طَابِيتَا، كَّر!" أُوْشَا نتَّاث ثرْزم ثِيطَّاوِين نّس، وَامِي ثࢲْرَا بُطْرُس ثكَّر ثقِّيم. <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />ئِسِيغ-اَس فُوْس نّس، ئِسكَّر-يت-يد. ئِڒَاغَا-د إِ ڒْمُوْمِنِين صَّالِحِين ذ ثَاجَّاڒِين ينَّا-ٱسن اقَا ثدَّر. <verse eid="ACT 9:41" /><verse number="42" style="v" sid="ACT 9:42" />ئِفّغ ڒخْبَار ذِي ثنْدِينْت ن يَافَا مَارَّا، ؤُمْنن زي سِيذِيثْنغ اَطَّاس ن يِوْذَان. <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />ئِقِّيم بُطْرُس ذِي يَافَا اَطَّاس ن وُوْسَّان اَك يِجّن ن بُو-يِيڒْمَاون<note caller="+" style="f"><char style="fr" closed="false">9‏.43 </char><char style="ft" closed="false">بُو-يِيڒمَاون نتَّا يخدّم ذݣ يِيڒمَاون ن لْحَيَوَان.</char></note> قَّارن-اَس سِمْعَان.<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="s">أَرَّسُوْل بُطْرُس ذ كُوْرْنِينْيُوْس</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />ذِي ثنْدِينْت ن قَيْصَارِيَا تُوْغَا ذِنِّي يجّن ن ورْيَاز قَّارن-اَس كُوْرْنِينْيُوْس. نتَّا ذ يجّن ن وعَسْكَارِي ذ اَمقّْرَان ن اَرُّوْمَانُوْس اَقَاث ذݣ يِجّن ن لْفِرْقَا ن ڒْعَسْكَار ؤُمِي قَّارن &lt;أَطَالْيَان.&gt; <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />ذَايس دِّين يتݣّْوذ أَربِّـي، نتَّا ذ مَارَّا اَيثْبَاب ن ثدَّارْث نّس. ئِتݣّ ڒْخِير اَطَّاس ذݣ يِنِّي يحْذَاجن، وَار يخطِّي شَا ثْࢲَادْجِيث نّس.<verse eid="ACT 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 10:3" />ئِجّن ن نْهَار غَار ثْڒَاثَا وعشِّي، يࢲْرَا نِيشَان ذِي لْوَحِي يجّن ن لْمَلَاك ن أَربِّـي يتَاذف-د خَاس يتْڒَاغَا-يَاس-د: "آ كُوْرْنِينْيُوْس."<verse eid="ACT 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 10:4" />ئِخْزَر ذَايس كُوْرْنِينْيُوْس مْلِيح يݣّْوذ ينَّا-ٱس: "آ سِيذِي، مِين ثْرزُّوْذ؟"</para>
  <para style="p" vid="ACT 10:4">ينَّا-ٱس لْمَلَاك نِّي: "قَا ثْࢲَادْجِيث نّش ذ صَّذَقَا نّش اَقَا يقْبڒ-يثنْت زَّايك أَربِّـي، نتَّا قَا يفْقذ-يشك. <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />سكّ ڒخُّو يرْيَازن غَار ثنْدِينْت ن يَافَا اَذَاش د اَوِين يجّن ن بنَاذم يسم نّس سِمْعَان ؤُمِي قَّارن بُطْرُس. <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />أَقَاث ذ اَنوْجِي غَار يِجّن ن بُو-يِيڒْمَاون قَّارن-اَس سِمْعَان، ثَدَّارْث نّس اَقَات خ طَّارْف ن ڒبْحَر."<verse eid="ACT 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 10:7" />وَامِي يرُوْح لْمَلَاك نِّي إِي كِيس د يسِّيوْڒن، ئِڒَاغَا-د إِ ثْنَاين زݣ يخدَّامن نّس ذ يِجّن ن وعسْكَارِي ذَايس دِّين، يتِيڒِي ڒبْدَا اَكِذس. <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />ئِعَاوذ-اَسن مَارَّا مِين يوقْعن، ئِسّكّ-يثن غَار ثنْدِينْت ن يَافَا.<verse eid="ACT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />ثِيوشَّا نّس، يِنِّي يتْوَاسّكّن زي كُوْرْنِينْيُوْس غَار ثنْدِينْت ن يَافَا وَامِي عْڒَاين اَذ اَوْضن ذِنِّي، يُوْڒِي بُطْرُس غَار ثْزقَّا<note caller="+" style="f"><char style="fr" closed="false">10‏.9 </char><char style="ft" closed="false">ثَزقَّا نتَّاث ذ سّْظَاح ن ثدَّارْث.</char></note> غَار وزْين ن نْهَار اَذ يࢲَّادْج. <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />ئِدْجُوْز اَطَّاس يخس اَذ يشّ. وَامِي عَاذ سوْجَاذن-اَس مشَّا يُوْحَا-يَاس-د أَربِّـي ذِي لْوَاحِي. <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />ئِࢲْرَا اَجنَّا ينُوْرْزم سْهوَّان-د زَّايس غَار ثْمُوْرْث يجّن ن ڒْحَاجث ثݣَّا اَم ثْشُوْقّت ذ ثَمقّْرَانْت تْوَاشدّ زِي ثْغمُّوْرَا نّس س اَربْعَا. <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />ذَايس مَارَّا لْحَيَوَانَاث يݣُّوْرن خ اَرْبعَا ن يضَارن ذ مِين يتنْحُوْرُوْذن خ وعدِّيس ذ يجْضَاض ن وجنَّا. <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />ثنْدق-د يجّن ن ثْمِيجَّا ثنَّا-ٱس: "كَّر آ بُطْرُس، غَرص، اشّ!"<verse eid="ACT 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 10:14" />ينَّا-ٱس نتَّا: "لَّا وَالُو آ سِيذِي! نش عمَّارْص مَا شِّيغ مِين يدْجَان حْرَام نِغ مكْرُوْه."<verse eid="ACT 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 10:15" />ثنْدق-د ثْمِيجَّا نِّي وِيس مَرّْثَاين ثنَّا-ٱس: "شك وَار تْحَرَّام شَا مِين يحدْجڒ أَربِّـي يَارِّي-ث حَلَال!"<verse eid="ACT 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 10:16" />ئِوْقع مَانَايَا ثْڒَاثَا ن ثْوَاڒَاثِين، سّنِّي ثْنجْمع ثْشُوْقّت نِّي ثذْوڒ غَار وجنَّا. <verse eid="ACT 10:16" /><verse number="17" style="v" sid="ACT 10:17" />ئِقِّيم بُطْرُس يتْخمَّام يتْعجّب ذِي ڒْمَعْنَا ن لْوَحِي-يَا إِي يࢲْرَا، ڒخْدّنِّي يرْيَازن نِّي إِي د يسّكّ كُوْرْنِينْيُوْس ؤُفِين ثَدَّارْث ن سِمْعَان بدّن غَار ثوَّارْث نّس. <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />ڒَاغَان نَّان: "سِمْعَان ونِّي ؤُمِي قَّارن بُطْرُس، مَا ٱقَاث ذِنِّي ذ اَنوْجِي؟"<verse eid="ACT 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 10:19" />بُطْرُس عَاذ يتْخمَّام ذِي لْوَحِي نِّي ينَّا-ٱس أَرُّوْح <char style="it">ن أَربِّـي</char>، "قَا ثْڒَاثَا ن يرْيَازن رزُّوْن خَاك. <verse eid="ACT 10:19" /><verse number="20" style="v" sid="ACT 10:20" />كَّر هْوَا غَارْسن، رُوْح اَكِذْسن بْڒَا مَا ٱذَايْسن ثْشكّذ قَا ذ نش إِي ثن د يسّكّن."<verse eid="ACT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 10:21" />ئِهْوَا-د بُطْرُس غَار يرْيَازن نِّي ينَّا-ٱسن، "أَقَا ذ نش إِي خف ثْرزُّوْم. مَايمِّي غَارِي د ثُوْسِيم؟"<verse eid="ACT 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 10:22" />نَّان-اَس: "قَا نشِّين يسّكّ-اَنغ-د كُوْرْنِينْيُوْس يجّن ن وعَسْكَارِي ذ اَمقّْرَان ن اَرُّوْمَانُوْس. نتَّا ذ يجّن ن ورْيَاز نِيشَان يتݣّْوذ أَربِّـي، تْوقَّارن-ث مَارَّا ڒْقُوْم ن أَيث-إِسْرَائِيل. ينَّا-ٱس يجّن ن لْمَلَاك ن أَربِّـي: سكّ غَار بُطْرُس، اَذ د يَاس غَار ثدَّارْث نّش اَذَاس ثْصنّْطذ مِين ذَاش غَا يِينِي." <verse eid="ACT 10:22" /><verse number="23" style="v" sid="ACT 10:23" />ئِكَّر بُطْرُس يسِيذف-يثن غَار ذَاخڒ يسْنوْجو-يثن.</para>
  <para style="p" vid="ACT 10:23">ثِيوشَّا نّس يرُوْح اَكِذْسن بُطْرُس. مُوْنن اَكِذس ڒبْعَاض ن اَيثْمَاس زِي ثنْدِينْت ن يَافَا. <verse eid="ACT 10:23" /><verse number="24" style="v" sid="ACT 10:24" />فَرْوِيشَّا نّس<note caller="+" style="f"><char style="fr" closed="false">10‏.24 </char><char style="ft" closed="false">فَرْوِيشَّا تْوَاحْسَاب ثَاسْيَاضن.</char></note> يُوْوض بُطْرُس غَار ثنْدِينْت ن قَيْصَارِيَا. ئِتْرَاجَا-ثن ذِنِّي كُوْرْنِينْيُوس، أَكِذس ڒبْعَاض ن ڒحْبَاب نّس ذ ڒبْعَاض ن يمدُّوْكَاڒ نّس إِي د يعَرض. <verse eid="ACT 10:24" /><verse number="25" style="v" sid="ACT 10:25" />وَامِي يُوْوض بُطْرُس غَار ثدَّارْث نِّي، ئِفّغ-د غَارس كُوْرْنِينْيُوْس يوْضَا-يَاس غَار يضَارن نّس يسجّذ-اَس. <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />ئِسْبدّ-يث بُطْرُس خ يضَارن ينَّا-ٱس: "لَّا، كَّر بدّ. قَا نش ذ بْنَاذم اَم نش اَم شك."<verse eid="ACT 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 10:27" />يُوْذف بُطْرُس يسَّاوَاڒ اَكِذس يُوْفَا ذِنِّي اَطَّاس ن يِوْذَان مُوْنن. <verse eid="ACT 10:27" /><verse number="28" style="v" sid="ACT 10:28" />ينَّا-ٱسن: "قَا ثسّْنم بلِّي يسْرَائِيلِيْين غَارْسن حْرَام اَذ خلّْطن اَك ڒْبَارَّانِي نِغ اَذ اَذْفن ثَدَّارْث نْسن. وَلَكِن أَربِّـي يسْفَاهم-اَيِي-د قْبڒ وَار قَّارغ إِ حَدّ قَا شك حْرَام نِغ مكْرُوْه. <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />وَامِي ذَايِي د ثْڒَاغِيم ؤُسِيغ-د بْڒَا مَا ٱذ ينِيغ لَّا. أَكنِّيو سّقْسِيغ، مَايمِّي غَارِي د ثسّكّم؟"<verse eid="ACT 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30" />ئِنْدق-د كُوْرْنِينْيُوْس ينَّا-ٱس: "قَا نش اَرْبعِييَّام زݣ وَامِي غَار ثْڒَاثَا وعشِّي اَم ڒْوقْث-أَ، تُوْغَا تْࢲَادْجِيغ ذِي ثدَّارْث ينُو. عْلَاغَفْلَا يبدّ-د زَّاثِي يجّن ن وثَرَّاس غَارس اَرُّوْض يتْشعْشِيع. <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />ئِقَّار-اَيِي-د: آ كُوْرْنِينْيُوْس! قَا أَربِّـي يسْتَاجب-اَش إِ ثْࢲَادْجِيث نّش، صَّذَقَا نّش يفكَّر ذَايس. <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />سكّ غَار ثنْدِينْت ن يَافَا، أَوِي-د سِمْعَان ونِّي ؤُمي قَّارن بُطْرُس. أَقَاث ذِنِّي ذ اَنوْجِي ذِي ثدَّارْث ن يِجّن ن بُو-يِيڒْمَاون قَّارن-اَس سِمْعَان خ طَّارْف ن ڒبْحَر. <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />إِيوَا خ مَانَايَا إِي غَارك د سّكّغ ذغْيَا، ثݣِّيذ مْلِيح وَامِي د ثُوْسِيذ. نشِّين ڒخُّو مَارَّا اَقَانغ نحْضَار زَّاث إِ أَربِّـي بَاش أَ نْصنّط مَارَّا مِينْزِي شك يوصَّا سِيذِي أَربِّـي."<verse eid="ACT 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34" />ئِبْذَا بُطْرُس يسَّاوَاڒ ينَّا-ٱسن: "ذ صَّح تْوَاڒِيغ أَربِّـي وَار يتݣّ شَا س وُوْذمَاون جَار يِوْذَان. <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />أَربِّـي يقبّڒ يوْذَان زِي مْكُڒ ڒْݣنْس يِنِّي إِي ث يتݣّْوْذن تݣّن مِين يدْجَان نِيشَان. <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />ثسّْنم أَربِّـي يسّكّ-د اَوَاڒ نّس غَار أَيث-إِسْرَائِيل يتْبشَّار-يثن س لْإِنْجِيل ن ڒهْنَا س عِيْسَى لْمَسِيح، نتَّا ذ سِيذِيثْنغ ن مَارَّا يوْذَان. <verse eid="ACT 10:36" /><verse number="37‏-38" style="v" sid="ACT 10:37-38" />كنِّيو قَا ثسّْنم مِين يوقْعن ذِي مَارَّا ثَمُوْرْث ن يَهُوْذِيَا. أَقَا نَّبِي يَحْيَى تُوْغَا يتْبشَّر يوْذَان حمَا اَذ تْوَاطهَّارن س وَامَان. سّنِّي زِي ثْمُوْرْث ن لْجَلِيل يبْذَا عِيْسَى نَاصِرِي يتْبشَّار يشُّوْر-يث أَربِّـي س جّْهذ ذ أَرُّوْح يقدّْسن. نتَّا يتْرَاح زݣ ومْشَان غار ومْشَان يتݣّ ڒْخِير، ئِسْݣنْفَا مَارَّا ينِّي يتْعدَّاب إِبْڒِيس مِنْزِي أَربِّـي اَقَاث اَكِذس. <verse eid="ACT 10:37-38" /><verse number="39" style="v" sid="ACT 10:39" />نشِّين ذ ڒشْهُوْذ خ مَارَّا مِين يتݣّ عِيْسَى ذِي ثْمُوْرْث ن أَيث-إِسْرَائِيل ذ ثنْدِينْت ن لْقُدْس. نْغِين-ث وَامِي ث رفْعن خ ثحْنَاشْت.<note caller="+" style="f"><char style="fr" closed="false">10‏.39 </char><char style="ft" closed="false">ثَحْنَاشْت-أَ نتَّاث ذ ثَحْنِيْث نِّي خف صلّْبن سِيذِيثْنغ عِيْسَى.</char></note> <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />نْهَار وِيس ثڒْتِيَّام يسكَّر-يث-يذ أَربِّـي زِي ڒْموْث يسْمظْهَار-يث-يذ. <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />مَاشِي يسْمظْهَار-يث-يذ أَربِّـي إِ مَارَّا شَّعْب؛ لَّا، ئِسْمظْهَار-يث-يذ إِ ڒشْهُوْذ إِي يخْضَر زِي قْبڒ يعْنِي نشِّين إِي كِذس يشِّين إِي كِذس يسْوِين وَامِي د يكَّر زِي ڒْموْث. <verse eid="ACT 10:41" /><verse number="42" style="v" sid="ACT 10:42" />نشِّين يوصَّا-يَانغ عِيْسَى اَ نْبشَّر شَّعْب، أَ نشْهذ بلِّي أَربِّـي يخْضَر-يث اَذ يحَاسب يِنِّي يدَّرن ذ يِنِّي يمُّوْثن. <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />مَارَّا لْأَنْبِيَا شهّْذن خَاس نَّان قَا مَارَّا يِنِّي زَّايس غَا يَامْنن اَذ تْوَاغْفَرنْت ڒْمُعْصِيَاث نْسن س يِيسم نّس."<verse eid="ACT 10:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />وَامِي عَاذ يسَّاوَاڒ بُطْرُس ذِي مَانَايَا، يُوْسَا-د أَرُّوْح يقدّْسن يهْوَا-د خ مَارَّا ينِّي يتسْڒَان إِ وَاوَاڒ نّس. <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />ڒْمُوْمِنِين زݣ أَيث-إِسْرَائِيل إِي د يُوْسِين اَك بُطْرُس قِّيمن تْعجّْبن وَامِي ؤُفِين أَرُّوْح يقدّْسن يتْوَافيّض ؤُڒَا خ يِنِّي وَار يدْجِين شَا ذ يسْرَائِيلِيْين. <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />ڒَاحقَّاش سْڒِين-اَسن سَّاوَاڒن س لُّغَاث <char style="it">وَار يدْجِين بُو نْسن</char> حمّْذن أَربِّـي.</para>
  <para style="p" vid="ACT 10:46">أُوْشَا ينَّا بُطْرُس: <verse eid="ACT 10:46" /><verse number="47" style="v" sid="ACT 10:47" />"مَا ذِنِّي شَان بْنَاذم إِي غَا يسْبدّن يوْذَان-أَ بَاش وَار تتْوَاطهِّيرن شَا س وَامَان؟ يِيْنَا يمُّوْش-اَسن أَرُّوْح يقدّْسن اَم نشِّين اَم نِثْنِي!" <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />س مَانَايَا يوصَّا-اَثن <char style="it">بُطْرُس</char> اَذ تْوَاطهَّارن س وَامَان عْلَاحْسَاب يسم ن عِيْسَى لْمَسِيح. سّنِّي تَّارن زَّايس اَكِذْسن يقِّيم شَان وُوْسَّان.<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="s">أَرَّسُوْل بُطْرُس يتْخبَّر جْمَاعث ن ڒْمُوْمِنِين ذِي لْقُدْس</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />منْبَعْد، اَرُّسُل ذ ؤُوْمَاثن يِنِّي يدْجَان ذِي يَهُوْذِيَا سْڒِين قَا ؤُڒَا ذ يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل قبْڒن اَوَاڒ ن أَربِّـي. <verse eid="ACT 11:1" /><verse number="2‏-3" style="v" sid="ACT 11:2-3" />وَامِي يݣَعّذ بُطْرُس غَارْسن غَار لْقُدْس ڒخْدّنِّي كَّرن ڒْمُوْمِنِين نِّي ن عِيْسَى ينِّي يتِيشّن لْهِمَّا اَطَّاس إِ طَّهَارث شِّين-ث س ڒْهمّْ نَّان-اَس: "مَايمِّي ثُوْذْفذ غَار ثدَّارْث ن يِنِّي وَار يطهَّارن شَا ثشِّيذ اَكِذْسن اَغْرُوْم؟"<verse eid="ACT 11:2-3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 11:4" />ئِبْذَا بُطْرُس يتْفسَّار-اَسن ثَا س ثَا ينَّا-ٱسن: <verse eid="ACT 11:4" /><verse number="5" style="v" sid="ACT 11:5" />"نش وَامِي تُوْغَا دْجِيغ ذِي ثنْدِينْت ن يَافَا تْࢲَادْجِيغ يُوْحَا-اَيي-د أَربِّـي، ذِي لْوَحِي نِّي سْهوَّان-د زݣ وجنَّا غَار ثْمُوْرْث يجّن ن ڒْحَاجث ثݣَّا اَم ثْشُوْقّت ذ ثَمقّْرَانْت تْوَاشدّ زِي ثْغمُّوْرَا نّس س اَربْعَا ثُوْسَا-د غَارِي. <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />خْزَرغ ذَايس مْلِيح ؤُفِيغ لْحَيَوَانَاث يݣُّوْرن خ اَرْبعَا ن يضَارن ذ ڒُوْحُوْش ذ مِين يتنْحُوْرُوْذن خ وعدِّيس ذ يجْضَاض ن وجنَّا. <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />ثُمَّا سْڒِيغ إِ يِجّن ن ثْمِيجَّا ثقَّار-اَيِي: كَّر آ بُطْرُس، غَرص، اشّ! <verse eid="ACT 11:7" /><verse number="8" style="v" sid="ACT 11:8" />نِّيغ-اَس: لَّا وَالُو آ سِيذِي! نش عمَّارص وَار ݣِّيغ ذݣ وقمُّوْم ينُو مِين يدْجَان حْرَام نِغ مكْرُوْه. <verse eid="ACT 11:8" /><verse number="9" style="v" sid="ACT 11:9" />ثنْدق-د ثْمِيجَّا نِّي زݣ وجنَّا وِيس مَرّْثَاين ثنَّا-ٱيِي: شك وَار تْحَرَّام شَا مِين يحدْجڒ أَربِّـي يَارِّي-ث حَلَال! <verse eid="ACT 11:9" /><verse number="10" style="v" sid="ACT 11:10" />ئِوْقع-اَيِي مَانَاينِّي ثْڒَاثَا ن ثْوَاڒَاثِين، سّنِّي ينجْمع كُڒْشِي غَار وجنَّا.<verse eid="ACT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 11:11" />ذِي ثْسَعَّات نِّي بدّن ثْڒَاثَا ن يرْيَازن غَار ثدَّارْث نِّي مَانِي دْجِيغ ذ اَنوْجِي، تْوَاسّكّن-د غَارِي زِي ثنْدِينْت ن قَيْصَارِيَا. <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />ثُمَّا يوصَّا-ٱيِي أَرُّوْح ن أَربِّـي ينَّا-ٱيِي رُوْح اَكِذْسن بْڒَا مَا ٱذَايْسن ثْشكّذ. ؤُوِيغ اَكِذِي ستَّا-يَا ن يَايثْمَا، نُوْذف غَار ثدَّارْث ن كُوْرْنِينْيُوْس. <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />ئِعَاوذ-اَنغ نتَّا مَامّش يࢲْرَا يجّن ن لْمَلَاك يبدّ-د ذِي ثدَّارْث نّس ينَّا-ٱس: سكّ يرْيَازن غَار ثنْدِينْت ن يَافَا اَذ د اَوِين سّنِّي سِمْعَان ؤُمي قَّارن بُطْرُس. <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />أَذَاش يِينِي اَوَاڒن إِي زِي غَا ثْنجْمذ شك ذ مَارَّا اَيثْبَاب ن ثدَّارْث نّش. <verse eid="ACT 11:14" /><verse number="15" style="v" sid="ACT 11:15" />ثُمَّا وَامِي بْذِيغ سَّاوَاڒغ، يُوْسَا-د أَرُّوْح يقدّْسن يهْوَا-د خَاسن مَامّش خَانغ د يهْوَا ذݣ ومزْوَارُو. <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" />فكَّرغ-د مِين ينَّا سِيذِيثْنغ وَامِي ينَّا قَا يَحْيَى يطهَّار إِ يِوْذَان س وَامَان، كنِّيو قَا اَذ تْوَاطهَّارم س أَرُّوْح يقدّْسن. <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />إِيوَا مڒَا يُوْشَا-ٱسن أَربِّـي إِ نِثْنِي اَمشْنَاو مِين ذَانغ يُوْشَا إِ نشِّين وَامِي نُوْمن زِي سِيذِيثْنغ عِيْسَى لْمَسِيح، مِين عْنِيغ نش بَاش اَذ عَارّْضغ إِ أَربِّـي؟"<verse eid="ACT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18" />يِنِّي يحْضَارن وَامِي سْڒِين إِ وَاوَاڒ-أَ، سْقَارن حمْذن أَربِّـي نَّان: "خْيَار، ؤُڒَا ذ يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل يُوْشَا-ٱسن أَربِّـي تُّوْبَا اَغَارْسن ثِيڒِي ثُوْذَارْث!"<verse eid="ACT 11:18" /></para>
  <para style="s">جْمَاعث ن ڒْمُوْمِنِين يدْجَان ذِي ثنْدِينْت ن وَانْطَاكْيَا</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />عْلَاحْسَاب اَعدّب نِّي إِي يوقْعن وَامِي يتْوَانغ سْتِيفَان، ڒْمُوْمِنِين كُڒ يجّن مَانِي يرُوْح: ئِجّن يرُوْح ٱڒ فِينِيقْيَا، ئِجّن يرُوْح اَڒ قُبْرُص، ئِجّن يرُوْح اَڒ وَانْطَاكْيَا. وَار تْبشِّيرن ذِنِّي حَدّ س وَاوَاڒ ن أَربِّـي إِلَّا يسْرَائِيلِيْين. <verse eid="ACT 11:19" /><verse number="20" style="v" sid="ACT 11:20" />وَلَكِن ڒبْعَاض ن يرْيَازن زِي قُبْرُص ذ لْقُرِينَا ؤُسِين-د غَار وَانْطَاكْيَا بْذَان سَّاوَاڒن اَك ييُوْنَانِيْين تْبشَّارن-ثن س سِيذِيثْنغ عِيْسَى. <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />سِيذِي أَربِّـي اَقَاث اَكِذْسن، اَطَّاس ن يِوْذَان ؤُمْنن ذوْڒن-د غَار سِيذِيثْنغ. <verse eid="ACT 11:21" /><verse number="22" style="v" sid="ACT 11:22" />يُوْوض ڒخْبَار-أَ غَار جْمَاعث ن ڒْمُوْمِنِين ذِي لْقُدْس، كَّرن سّكّن بَرْنَابَا غَار وَانْطَاكْيَا. <verse eid="ACT 11:22" /><verse number="23" style="v" sid="ACT 11:23" />وَامِي د يُوْوض، يُوْفَا مَامّش ثن يبَرك أَربِّـي. ئِفَرح يبْذَا يتْشجَّاع-يثن مَارَّا بَاش اَذ قِّيمن ذݣ وبْرِيذ ن سِيذِيثْنغ س مَارَّا وُوْڒَاون نْسن. <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />بَرْنَابَا نتَّا ذ يجّن ن ورْيَاز ذ اَصبْحَان يشُّوْر س أَرُّوْح يقدّْسن يتَامن اَطَّاس، خَربِّي ن يِوْذَان ؤُمْنن زِي سِيذِيثْنغ.<verse eid="ACT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25" />ئِرُوْح بَرْنَابا غَار ثنْدِينْت ن طَرْسُوْس يرزُّو خ شَاوُل. <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />وَامِي ث يُوْفَا يُوْوِي-ث-يذ اَكِذس غَار ثنْدِينْت-أَ ن وَانْطَاكْيَا. سعْذُوْن عَام يكْمَاڒ اَك جْمَاعث ن ڒْمُوْمِنِين، سڒْمَاذن اَطَّاس ن يِوْذَان. ذَانِيتَا ذِي وَانْطَاكْيَا-يَا إِي تْوَاسمَّان يمحْضَارن ثْوَاڒَا ثَمزْوَارُوْت س &lt;ئِمَسِيْحِيْين.&gt;<verse eid="ACT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27" />ذِي ڒِيَّام نِّي هْوَان-د شَان ن لْأَنْبِيَا زِي لْقُدْس غَار وَانْطَاكْيَا. <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" />ئِكَّر يجّن زَّايْسن قَّارن-اَس غَابُوْس، ئِخْبَر <char style="it">إِ ڒْمُوْمِنِين ذِنِّي</char> س مِين ذَاس ينَّا أَرُّوْح ن أَربِّـي. ينَّا-ٱسن قَا ٱذ يوْقع يجّن ن بُوْهيُّوْف ذ اَمقّْرَان خ ثْمُوْرْث مَارَّا (أُو ذ صَّح يوْقع مَانَاينِّي ذِي ڒْوقْث ن لْمَلِك قَيْصَار كْلُوْدْيُوْس). <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />كَّرن يمحْضَارن تَافْقن جَارَاسن كُڒ يجّن زَّايْسن اَذ سّكّن شْوَايْت ن لْمُعَاوَنَا عْلَاحْسَاب ثِزمَّار نْسن غَار اَيثْمَاثْسن إِݣ يزدّْغن ذِي يَهُوْذِيَا. <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />أَمنِّي إِي ݣِّين جَارَاسن، ؤُشِين لْمُعَاوَنَا نِّي إِ بَرْنَابَا ذ شَاوُل اَت سِّيوْضن إِ يمقّْرَانن ن جْمَاعث ن ڒْمُوْمِنِين إِي يدْجَان ذِنِّي.<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="s">أَرَّسُوْل بُطْرُس ينجّم زݣ وفُوْس ن لْمَلِك هِيرُدُوْس</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />ذِي ڒْوقْث نِّي، أَزدْجِيذ هِيرُدُوْس يبْذَا يتْعدَّاب ڒبْعَاضِيث زِي جْمَاعث ن ڒْمُوْمِنِين. <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />نتَّا يُوْمَر أُوْشَا نْغِين س سِّيف يَعْقُوْب ؤُمَاس ن يُوْحَنَّا. <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />وَامِي يُوْفَا مَانَاينِّي يعْجب-اَسن إِ أَيث-إِسْرَائِيل يكَّر يطّف ؤُڒَا ذ بُطْرُس. ذِي ڒِيَّام ن ڒْعِيذ ن ثفْضِيرْث إِي ذِي يوْقع مَانَاينِّي. <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />ئِطّف-يث يݣِّي-ث ذِي ڒحْبس، ئِسلّم-يث إِ اَربْعَا ن لْفِرْقَاث ن ڒْعَسْكَار اَث حْضَان، مْكُڒ لْفِرْقَا ذَايس اَربْعَا. ئِنْوَا اَخَاس يحْكم زَّاث إِ شَّعْب منْبَعْد إِ ڒْعِيذ اَمقّْرَان. <verse eid="ACT 12:4" /><verse number="5" style="v" sid="ACT 12:5" />تْعسَّاسن خ بُطْرُس ذِي ڒحْبس، جْمَاعث ن ڒْمُوْمِنِين تتَّارن خَاس إِ أَربِّـي.<verse eid="ACT 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6" />دْجِيڒث نِّي إِي ذِي د غَا يصبّح هِيرُدُوْس اَذ يحْكم خ بُطْرُس زَّاث إِ شَّعْب، تُوْغَا بُطْرُس يطّص جَار ثْنَاين ن ڒْعَسْكَار يشدّ س ثْنَاين ن سْنَاسڒ. ڒْعَسْكَار نّغْنِي غَار ثوَّارْث تْعسَّاسن خ ڒحْبس. <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />ڒخْدّنِّي ثْمظْهَار-د ذِنِّي يجّن ن لْمَلَائِكَا ن سِيذِي أَربِّـي، ئِتْشعْشِيع-د يجّن ن نُّوْر ذِي ڒحْبس. لْمَلَائِكَا نِّي ثُوْوْثَا بُطْرُس غَار وغزْذِيس نّس، ثسْفَاق-يث-يذ ثنَّا-ٱس: "كَّر ذغْيَا!" أُوْشَا سْنَاسڒ نِّي فسْينْت زݣ يفَاسّن نّس. <verse eid="ACT 12:7" /><verse number="8" style="v" sid="ACT 12:8" />ثنَّا-ٱس لْمَلَائِكَا نِّي: "كَّر حزّم، قّن ثِسِيڒَا نّش." ئِݣَّا بُطْرُس مِين ذَاس ثنَّا. ثنَّا-ٱس عَاوذ: "اݣّ اَزدْجَاب نّش، ذْفَار-اَيِي-د."<verse eid="ACT 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 12:9" />ئِكَّر بُطْرُس يفّغ يذْفَار-يت، وَار يسّين شَا مِين تݣّ لْمَلَائِكَا نِّي مَا ذ صَّح مَا لَّا، ئِتْغِير-اَس يوْحَا-يَاس-د أَربِّـي. <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />عْذُوْن خ وعسَّاس اَمزْوَارُو ذ وِيس ثْنَاين. ؤُوْضن غَار ثوَّارْث ن ڒحْذِيذ ثنِّي يتَاوِين غَار ثنْدِينْت، ثرْزم وَاحْذس فّْغن. ڒخْدّنِّي وَامِي ݣُّوْرن ذݣ يِجّن ن زّنْقث ثسْمح ذَايس لْمَلَائِكَا نِّي. <verse eid="ACT 12:10" /><verse number="11" style="v" sid="ACT 12:11" />ذِنِّي إِي د يَارَّا بُطْرُس ڒْبَاڒ نّس ينَّا: "ڒخُّو سّْنغ مَانَايَا ذ صَّح قَا يسّكّ-اَيِي-د سِيذِي أَربِّـي لْمَلَائِكَا نّس، ئِسنْجم-اَيي-د زݣ يفَاسّن ن هِيرُدُوْس ذ مَارَّا مِين خْسن اَذَايِي ݣّن أَيث-إِسْرَائِيل."<verse eid="ACT 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12" />وَامِي يفْطن ذِي مَانَايَا، يرُوْح غَار ثدَّارْث ن مَرْيَم يمَّاس ن يُوْحَنَّا ؤُمِي قَّارن مَرْقُس، تْمُوْنن ذِنِّي اَطَّاس ن يِوْذَان تْࢲَادْجَان. <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />بُطْرُس تُوْغَا يسْقرْقُوْب ذِي ثوَّارْث ن بَارَّا، ثْرُوْح غَارس يجّن ن ثْخدَّانْت قَّارن-اَس رُوْدَا اَذَاس ترْزم. <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />وَامِي ثعْقڒ اَوَاڒ ن بُطْرُس ثْفَرح اَطَّاس، وَلَكِن قْبڒ مَا ٱذ ترْزم ثَوَّارْث ثعْقب-د غَارْسن ثُوْزّڒ ثنَّا-ٱسن قَا بُطْرُس اَقَاث غَار ثوَّارْث <char style="it">يسْقرْقُوْب</char>. <verse eid="ACT 12:14" /><verse number="15" style="v" sid="ACT 12:15" />نَّان-اَس: "مَا ثبُوْهْرِيّذ نِغ؟" وَلَكِن نتَّاث متْأَكّدَا بلِّي مِين ثنَّا نِيشَان. نَّان-اَس: "وَقِلَا وَانِيتَا ذ بُوْحْبڒ ن بُطْرُس وَاهَا."<verse eid="ACT 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16" />ئِقِّيم بُطْرُس يسْقرْقُوْب عَاذ ذِي ثوَّارْث. وَامِي ذَاس رزْمن ؤُفِين-ث ذ نتَّا، قِّيمن تْعجّْبن. <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />ئِقَّار-اَسن س وفُوْس سْتُوْكَاث، سّنِّي يعَاوذ-اَسن مَامّش إِي ث يسُوْفغ سِيذِي أَربِّـي زِي ڒحْبس. ينَّا-ٱسن: "خبَّرم يَعْقُوْب ذ اَيثْمَاثْنغ س مِين يوقْعن." ئِفّغ يرُوْح غَار يِجّن ن ومْشَان نّغْنِي.<verse eid="ACT 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18" />وَامِي يصْبَح ڒْحَاڒ يوْقع يجّن ن ومنْغِي ذ اَمقّْرَان جَار ڒْعَسْكَار مَانِيس يكَّا بُطْرُس. <verse eid="ACT 12:18" /><verse number="19" style="v" sid="ACT 12:19" />هِيرُدُوْس يسّكّ اَخَاس رْزُوْن، وَار ث يُوْفِي شَا. وَامِي ذَاسن يݣَّا لْإِسْتِجْوَاب إِ يعسَّاسن نِّي، يُوْمَر اَثن نْغن.</para>
  <para style="s" vid="ACT 12:19">ڒْموْث ن وزدْجِيذ هِيرُدُوْس</para>
  <para style="p" vid="ACT 12:19">سّنِّي يفّغ وزدْجِيذ هِيرُدُوْس زِي ثْمُوْرْث ن يَهُوْذِيَا يرُوْح غَار ثنْدِينْت ن قَيْصَارِيَا يقِّيم ذِنِّي. <verse eid="ACT 12:19" /><verse number="20" style="v" sid="ACT 12:20" />تُوْغَا يغْضب خ يمزْذَاغ ن ثنْدِينْت ن صُوْرْ ذ ثنْدِينْت ن صَيْدَا. كَّرن يمزْذَاغ نِّي رزُّوْن اَذ مصْڒَاحن اَك وزدْجِيذ هِيرُدُوْس لِأَنَّا لْمَكْلَا نْسن تكّ-د زِي ثْمُوْرْث ن وزدْجِيذ. تَّارن-اَس مَانَايَا وَامِي رُوْحن مسْفهَامن اَك بْلَاسْتُوْس يدْجَان نتَّا ذ نَائِب ن هِيرُدُوْس. <verse eid="ACT 12:20" /><verse number="21" style="v" sid="ACT 12:21" />ذݣ يِجّن ن ڒْمُنَاسَبَا، ئِكَّر هِيرُدُوْس يرْسَا اَرُّوْض إِي تݣّن يزدْجِيذن يقِّيم خ لْعَرْش يبْذَا يسْتخْطَاب خ يمزْذَاغ ن ثْمُوْرْث نِّي. <verse eid="ACT 12:21" /><verse number="22" style="v" sid="ACT 12:22" />كَّرن نِثْنِي عيّْضن س جّْهذ قَّارن: "شك ثْمِيجَّا نّش اَم يِجّن زِي أَربِّـيثن مَاشِي اَم بْنَاذم!" <verse eid="ACT 12:22" /><verse number="23" style="v" sid="ACT 12:23" />ڒخْدّنِّي يجّن ن لْمَلَائِكَا ن سِيذِي أَربِّـي ثْسهْڒش هِيرُدُوْس وَامِي وَار يحْمِيذ شَا أَربِّـي. غࢲّن-ث يمِيغْزِيْون<note caller="+" style="f"><char style="fr" closed="false">12‏.23 </char><char style="ft" closed="false">ئِمِيغْزِيْون نِثْنِي ذ سِينْتَاث تِيڒِينْت ذݣ وعدِّيس ن بْنَاذم.</char></note> يمُّوْث نتَّا.<verse eid="ACT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24" />وَلَكِن أَوَاڒ ن أَربِّـي يتنْتَاشر نتَّا يَرنِّي. <verse eid="ACT 12:24" /><verse number="25" style="v" sid="ACT 12:25" />بَرْنَابَا ذ شَاوُل ذوْڒن-د زِي لْقُدْس وَامِي كمّْڒن ڒْخذْمث نْسن، ؤُوِين-د اَكِذْسن يُوْحَنَّا ؤُمِي قَّارن مَرْقُس.<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="s">ڒْمُوْمِنِين سّكّن-د بَرْنَابَا ذ شَاوُل اَذ بشَّرن</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />ذِي جْمَاعث ن ڒْمُوْمِنِين ذِي ثنْدِينْت ن وَانْطَاكْيَا ذِنِّي لْأَنْبِيَا ذ يمْسڒْمَاذن. نِثْنِي ذ بَرْنَابَا، ذ سِمْعَان ونِّي ؤُمِي قَّارن أَبرْشَان، ذ لُوْقْيُوْس زِي لْقُرِينَا، ذ مَنَاهن ونِّي إِݣ يربَّان اَك وزدْجِيذ هِيرُدُوْس زِي ثمْزِي نّس، ذ شَاوُل. <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />وَامِي عبّْذن سِيذِي أَربِّـي تْࢲُوْمَّان، ينَّا-ٱسن أَرُّوْح يقدّْسن: حُوْزم-اَيِي-د بَرْنَابَا ذ شَاوُل إِ ڒْخذْمث نِّي ؤُمِي ثن يخْضَرغ. <verse eid="ACT 13:2" /><verse number="3" style="v" sid="ACT 13:3" />وَامِي ࢲُوْمّن ࢲُّوْدْجن، ڒخْدّنِّي سرْسن خَاسن يفَاسّن نْسن سّكّن-ثن.<verse eid="ACT 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />ئِسّكّ-يثن أَرُّوْح يقدّْسن رُوْحن غَار ثنْدِينْت ن سُلُوْكْيَا. سّنِّي سَفَرن ذݣ وغَرَّابُو غَار ثيْزِيرْث ن قُبْرُص. <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />وَامِي ؤُوْضن غَار ثنْدِينْت ن سَلَامِيس بْذَان تْبشَّارن س وَاوَاڒ ن أَربِّـي ذِي ثمْزِيذَاوِين ن أَيث-إِسْرَائِيل، ئِتْعَاوَان-يثن يُوْحَنَّا نِّي.<verse eid="ACT 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6" />ؤُيُوْرن ذِي ثيْزِيرْث نِّي اَمن-ثكْمَاڒ اَڒ وَامِي ؤُوْضن غار ثنْدِينْت ن پَـافُوْس. ؤُفِين ذِنِّي يجّن ن وسحَّار نتَّا ذ اَئِسْرَائِيلِي يَارَّا يخْف نّس ذ نَّبي قَّارن-اَس بنْيَشُوْع. <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />ئِتِيڒِي اَك لْعَامِل ونِّي ؤُمِي قَّارن سَرْجْيُوْس بُوْلُس. لْعَامِل نِّي نتَّا ذ يجّن ن ورْيَاز ذ اَمِيغِيس، ئِڒَاغَا-د إِ بَرْنَابَا ذ شَاوُل يخس اَذَاس سْڒمْذن اَوَاڒ ن أَربِّـي. <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />وَلَكِن يعَارّض-اَسن ؤُسحَّار نِّي بنْيَشُوْع (ونِّي ؤُمِي قَّارن س ثْيُوْنَانِيث أُلِيمَاس). نتَّا يرزُّو اَذ يسْبعّذ لْعَامِل خ لْإِيمَان. <verse eid="ACT 13:8" /><verse number="9" style="v" sid="ACT 13:9" />ئِكَّر شَاوُل يعْنِي بُوْلُس يشُّوْر س أَرُّوْح يقدّْسن يخْزَر ذݣ وسحَّار نِّي مْلِيح؛ <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />ينَّا-ٱس: "شك ذ مِّيس ن إِبْڒِيس. شك ذ ڒَعْذُو ن قَاع مِين يدْجَان نِيشَان، ثشُّوْرذ س لْحِيلَا ذ ثحْرَايْمشْت! مَا عَاذ ثْرزُّوْذ اَذ تْعوّْجذ يبْرِيذن إِي يدْجَان نِيشَان ن سِيذِي أَربِّـي؟ <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />سَّا ٱڒ ثْسَاونْت سِيذِي أَربِّـي اَقَاث ضذ نّش، أَذ تْضَرْغْڒذ اَتَاف وَار ثْࢲرّذ شَا ثْفَاوْث ن ثْفُوْشْت اَڒ يِجّن ن لْمُدَّا." ڒخْدّنِّي ثكَّا-ٱس-د ثَاشْبَابْث إِ ؤُسحَّار نِّي خ ثِيطَّاوِين يتْوَاڒَا ثَادْجسْت، ئِقِّيم يتنّض ذِنِّي يرزُّو ؤُو ث غَا يسْݣوّْذن س وفُوْس. <verse eid="ACT 13:11" /><verse number="12" style="v" sid="ACT 13:12" />ئِࢲْرَا مَانَاينِّي لْعَامِل ڒخْدّنِّي يُوْمن، ئِقِّيم يذهّش س تَّعْلِيم ن سِيذِيثْنغ.<verse eid="ACT 13:12" /></para>
  <para style="s">بُوْلُس ذ بَرْنَابَا تْبشَّارن ذِي وَانْطَاكْيَا ذ پِــيْسِيْدْيَا</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />ئِنْيَا بُوْلُس ذ يمدُّوْكَاڒ نّس ذݣ وغَرَّابُو، رُوْحن زِي ثنْدِينْت نِّي ن پَـافُوْس غَار ثنْدِينْت ن بَارْجَا ذِي پَـامْفِيْلْيَا. ئِسْمح ذَايْسن ذِنِّي يُوْحَنَّا يذوْڒ-د غَار لْقُدْس. <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />نِثْنِي فّْغن زِي ثنْدِينْت ن بَارْجَا رُوْحن غَار ثنْدِينْت ن وَانْطَاكْيَا ذِي جْوَايه ن پِــيْسِيْدْيَا. ؤُذْفن قِّيمن ذِي ثمْزِيذَا ن أَيث-إِسْرَائِيل ذِي نْهَار ن سّبْث. <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />منْبَعْد إِ ثْغُوْرِي زِي لْكُتُب ن شَّرِيعَا ن مُوْسَى ذ لْأَنْبِيَا، سّكّن اَرُّوْيَاس ن ثمْزِيذَا اَوَاڒ نْسن إِ بَرْنَابَا ذ شَاوُل نَّان-اَسن: "آي اَيثْمَا، مڒَا غَارْوم شَان وَاوَاڒ إِي زِي غَا ثْشجّْعم شَّعْب-أَ، إِنِيم-اَسن-ث."<verse eid="ACT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 13:16" />ئِكَّر يشيَّر-اَسن بُوْلُس س ؤُفُوْس ينَّا-ٱسن: "آي يرْيَازن ن اَيث-إِسْرَائِيل آي يِنِّي يتݣّْوْذن أَربِّـي، صنّْطث. <verse eid="ACT 13:16" /><verse number="17" style="v" sid="ACT 13:17" />فَا أَربِّـي إِي يدْجَان خ شَّعْب ن أَيث-إِسْرَائِيل يخْضَر نتَّا ڒجْذُوْذ نّغ، يَرْنِي لْعَدَد نْسن وَامِي نِثْنِي تُوْغَا زدّْغن ذِي مِصْرَا. ئِسُوْفغ-يثن سّنِّي س جّْهذ نّس. <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />ثُمَّا يصْبَر اَكِذْسن ذݣ وعصَّاي نْسن شَان اَرْبعِين سْنَا ذِي صَّحْرَا. <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />ثُمَّا يقْضَا خ سبْعَا ن ڒݣْنُوْس ذِي ثْمُوْرْث ن كَنْعَان، ثَمُوْرْث نِّي يسْوَارْث-يت إِ ڒجْذُوْذ نّغ. <verse eid="ACT 13:19" /><verse number="20" style="v" sid="ACT 13:20" />مَارَّا مَانَاينِّي يكَّا خَاسن يجّن اَرْبعْمِيَّا و خمْسِين سْنَا. ثُمَّا يݣَّا خَاسن ڒْقُوْضَاث اَڒ ڒْوقْث نِّي ن نَّبي صَامْوِيل. <verse eid="ACT 13:20" /><verse number="21" style="v" sid="ACT 13:21" />ثُمَّا تَّارن-اَس إِ أَربِّـي اَغَارْسن يِيڒِي يجّن ن وزدْجِيذ نْسن، سّنِّي يُوْشَا-اَسن شَاوُل مِّيس ن قَيْس زِي أَيث-بنْيَامِين. يحْكم خَاسن نتَّا اَرْبعِين يسݣّْوُسَا. <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />ثُمَّا يكّس-يث أَربِّـي، يَارَّا دَاود ذ اَزدْجِيذ خَاسن. ئِشْهذ خَاس ينَّا قَا ؤُفِيغ دَاود مِّيس ن يَسَّى نتَّا ذ يجّن ن ورْيَاز يقْبڒ ڒْخَاضَر ينُو اَذ يݣّ مَارَّا مِين خْسغ.<verse eid="ACT 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 13:23" />ثُمَّا زِي دُوْرِّيث ن دَاود يسّكّ-د أَربِّـي عِيْسَى غَار أَيث-إِسْرَائِيل يعْنِي ونِّي إِي ثن غَا يسْنجْمن، مَامّش ثن يوْعذ زِي قْبڒ. <verse eid="ACT 13:23" /><verse number="24" style="v" sid="ACT 13:24" />قْبڒ مَا ٱذ يرَاح غَارْسن عِيْسَى، تُوْغَا ذِنِّي يَحْيَى يتْبشَّار مَارَّا شَّعْب ن أَيث-إِسْرَائِيل حمَا اَذ تُوْبن اَذ تْوَاطهَّارن س وَامَان. <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" />وَامِي يَحْيَى عْڒَاين اَذ يكمّڒ ڒْخذْمث نّس ينَّا-ٱسن: مِين ذَايِي تَارِّيم كنِّيو؟ قَا نش وَار دْجِيغ شَا ذ ونِّي إِي تْرَاجَام! منْبَعْد إِ نش اَذ د يَاس يجّن وَار سْذِهدْجغ اَذَاس فسْيغ ؤُڒَا ذ يفِيڒَان ن ثْسِيڒَا يقّن ذݣ يضَارن نّس."<verse eid="ACT 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26" />
    <char style="it">ينَّا-ٱسن بُوْلُس:</char> "آي اَيثْمَا، آ ثَارْوَا ن بْرَاهِيم، آي يِنِّي يتݣّْوْذن أَربِّـي! قَا ذ نشِّين ؤُمِي د يسّكّ أَربِّـي اَوَاڒ-أَ إِي زِي غَا ننْجم. <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />قَا يمزْذَاغ ن لْقُدْس ذ اَرُّوْيَاس نْسن وَار عْقِيڒن شَا عِيْسَى-يَا، وَار فْهِيمن شَا اَوَاڒن ن لْأَنْبِيَا ذِي لْكُتُب إِي قَّارن ذِي ثمْزِيذَاوِين زِي سّبْث غَار سّبْث. وَامِي حكْمن خ عِيْسَى س ڒْموْث فّْغن-د وَاوَاڒن نِّي إِي نَّان لْأَنْبِيَا. <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" />وَاخَّا وَار ؤُفِين ؤُڒَا ذ يجّن ن سَّبَاب إِي زِي غَا خَاس حكْمن س ڒْموْث، وَلَكِن تَّارن إِ بِيلَاطُوْس اَث ينغ. <verse eid="ACT 13:28" /><verse number="29" style="v" sid="ACT 13:29" />وَامِي ݣِّين مَارَّا مِين تُوْغَا خَاس ؤُرِين لْأَنْبِيَا، سهْوَان-ث-يذ زِي ثحْنَاشْت سرْسن-ث ذݣ ونْضڒ. <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />وَلَكِن أَربِّـي يسكَّر-يث-يذ زِي ڒْموْث. <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" />ثُمَّا يمظهَّار-د عِيْسَى ذݣ وَاطَّاس ن نْهُوْرَاث إِ يِنِّي تُوْغَا يݣَعّْذن اَكِذس زِي ثْمُوْرْث ن لْجَلِيل غَار ثنْدِينْت ن لْقُدْس. ڒخُّو يِيْنَا يدْجَان ذ ڒشْهُوْذ نّس غَار شَّعْب.<verse eid="ACT 13:31" /></para>
  <para style="p">
    <verse number="32‏-33" style="v" sid="ACT 13:32-33" />فَا نشِّين نتْبشَّار-يكنِّيو س مَانَايَا. يعْنِي أَربِّـي وَامِي د يسكَّر عِيْسَى زِي ڒْموْث صَافِي يكمّڒ مِين زِي تُوْغَا يوْعذ ڒجْذُوْذ نّغ، ئِكمّڒ-يث اَكِذْنغ نشِّين يدْجَان ذ ثَارْوَا نْسن. أَقَا يُوْرَا ذِي لْكِتَاب ن زَّابُوْر ذݣ يِزْڒِي وِيس ثْنَاين:</para>
  <para style="q1" vid="ACT 13:32-33">أَقَا شك ذ مِّي، نْهَارَا نش ذوْڒغ ذ بَابَاش.<verse eid="ACT 13:32-33" /></para>
  <para style="b" />
  <para style="p">
    <verse number="34" style="v" sid="ACT 13:34" />فَا أربِّي يسكَّر-د عِيْسَى زِي ڒْموْث يعْنِي عمَّارص اَذ يكِيشّو. أَمنِّي يقَّار لْكِتَاب: &lt;أَذَاوم ؤُشغ لْبَرَكَا ثَمْقدّسْت، لْبَرَكَا ذ صَّح إِي زِي وعْذغ <char style="it">نَّبِي</char> دَاود.&gt; <verse eid="ACT 13:34" /><verse number="35" style="v" sid="ACT 13:35" />أَمنِّي يقَّار عَاوذ لْكِتَاب: &lt;وَار تجِّيذ شَا لْعَظِيم نّش اَذ يكِيشّو.&gt;<verse eid="ACT 13:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 13:36" />لِأَنَّا دَاود ذِي زْمَان نّس وَامِي يكمّڒ مِين يخس أَربِّـي صَافِي يمُّوْث، ئِتْوَانْضڒ طَّارف إِ ڒجْذُوْذ نّس صَافِي يكِيشّو. <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />وَلَكِن ونِّي د يسكَّر أَربِّـي زِي ڒْموْث نتَّا لَّا وَار يكِيشّو شَا.<verse eid="ACT 13:37" /></para>
  <para style="p">
    <verse number="38‏-39" style="v" sid="ACT 13:38-39" />إِذن آي اَيثْمَا، رزُّوْغ اَذ تسّْنم س وَاوَاڒ-أَ بلِّي س عِيْسَى-يَا إِي زِي غَا تْوَاغْفَرنْت ڒْمُعْصِيَاث. مَارَّا ونِّي زَّايس غَا يَامْنن اَس تْوَاغْفَرنْت مَارَّا ڒْمُعْصِيَاث نّس؛ لْغُفْرَان-أَ وَانِيتَا وَار يزمَّر شَا اَذ يِيڒِي س شَّرِيعَا ن مُوْسَى. <verse eid="ACT 13:38-39" /><verse number="40" style="v" sid="ACT 13:40" />إِيوَا حْضَاث يخف نْوم بَاش وَار ذَاوم يتوْقِيع شَا مِين ؤُرِين لْأَنْبِيَا:<verse eid="ACT 13:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41" />خْزَارث آ يِنِّي يتْبُوْصَارن، تْعجّْبث فْنَاث.</para>
  <para style="q2" vid="ACT 13:41">ذِي ڒِيَّام نْوم اَذ ݣّغ شَان ثْمسْڒَايِين</para>
  <para style="q2" vid="ACT 13:41">وَاخَّا يخبَّر-يكنِّيو حَدّ زَّايْسنْت،</para>
  <para style="q2" vid="ACT 13:41">وَار ث تِيمْنم شَا."<verse eid="ACT 13:41" /></para>
  <para style="b" />
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42" />وَامِي كَّرن بُوْلُس ذ بَرْنَابَا اَذ د فّْغن زِي ثمْزِيذَا نِّي ن أَيث-إِسْرَائِيل، تَّارن زَّايْسن يِوْذَان نِّي اَذَاسن حدّْثن س مَانَاينِّي نْهَار ن سّبْت إِي د غَا يَاسن. <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />وَامِي د تفّْغن زِي ثمْزِيذَا، ذْفَارن-ثن اَطَّاس ن يسْرَائِيلِيْين ذ يِنِّي يسڒْمن ذِي دِّين ن أَيث-إِسْرَائِيل إِي تݣّْوْذن أَربِّـي. بُوْلُس ذ بَرْنَابَا سِّيوْڒن اَكِذْسن شجّْعن-ثن حمَا اَذ ارْنِين ذي اَرْضَا ن أَربِّـي.<verse eid="ACT 13:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44" />وَامِي د ثُوْوض سّبْث نِّي، مُوْنن عْڒَاين مَارَّا اَيثْبَاب ن ثنْدِينْت حمَا اَذ صنّْطن إِ وَاوَاڒ ن سِيذِي أَربِّـي. <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" />أَيث-إِسْرَائِيل وَامِي ؤُفِين ڒْغَاشِي اَطَّاس بْذَان حسّْذن اَطَّاس اَرُّسُل بْذَان تْعَارَّاضن إِ وَاوَاڒ ن بُوْلُس، تُوْكَّرن-ث. <verse eid="ACT 13:45" /><verse number="46" style="v" sid="ACT 13:46" />بُوْلُس ذ بَرْنَابَا نَّان-اَسن س يِجّن ن زْعَامث: "نشِّين تُوْغَا يتْخصَّا اَذَاوم نسِّيوڒ إِ كنِّيو ذ يمزْوُوْرَا س وَاوَاڒ ن أَربِّـي. وَامِي ثُوْݣِيم، ثْحكْمم خ يِيخف نْوم بلِّي كنِّيو وَار ثسْذِيهدْجم شَا ثُوْذَارْث ن ڒبْدَا، ڒخُّو قَا نشِّين أَ نْرَاح غَار يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل. <verse eid="ACT 13:46" /><verse number="47" style="v" sid="ACT 13:47" />لِأَنَّا سِيذِي أَربِّـي يوصَّا-يَانغ ينَّا-ٱنغ:</para>
  <para style="q1" vid="ACT 13:47">&lt;أَرِّيغ-شك ذ ثْفَاوْث إِ مَارَّا ڒݣْنُوْس،</para>
  <para style="q1" vid="ACT 13:47">حمَا يوْذَان اَذ نجْمن حتَّا اَڒ طَّارف ن دُّنشْت.&gt;"<verse eid="ACT 13:47" /></para>
  <para style="b" />
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48" />يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل وَامِي سْڒِين مِين ينَّا <char style="it">بُوْلُس</char>، فَرْحن حمّْذن إِ وَاوَاڒ ن سِيذِي أَربِّـي. ؤُمْنن مَارَّا يِنِّي يخْضَر أَربِّـي إِ ثُوْذَارْث ن ڒبْدَا. <verse eid="ACT 13:48" /><verse number="49" style="v" sid="ACT 13:49" />ئِنْتَاشَر وَاوَاڒ ن سِيذِي أَربِّـي ذِي ثْمُوْرْث نِّي مَارَّا. <verse eid="ACT 13:49" /><verse number="50" style="v" sid="ACT 13:50" />وَلَكِن يسْرَائِيلِيْين سَامَرن ثِمْغَارِين إِي ذَايْسنْت دِّين غَارْسنْت لْمَرْتَبَا، عَاوذ سَامَرن يمقّْرَانن ن ثنْدِينْت. تݣّن سَّبَاب إِ يِوْذَان حمَا اَذ عدّْبن بُوْلُس ذ بَرْنَابَا أُوْشَا ؤُزّْڒن خَاسن زِي جِّهث نِّي. <verse eid="ACT 13:50" /><verse number="51" style="v" sid="ACT 13:51" />كَّرن بُوْلُس ذ بَرْنَابَا مسْحن ثَعجَّاشْت زݣ يضَارن نْسن <char style="it">اَم يِجّن ن شْهَاذث</char> خَاسن، رُوْحن غَار ثنْدِينْت ن إِكُوْنْيَا. <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />ئِمحْضَارن يدْجَان ذِنِّي شُّوْرن س ڒفْرَاحث ذ أَرُّوْح يقدّْسن.<verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="s">بُوْلُس ذ بَرْنَابَا تْبشَّارن ذِي ثنْدِينْت ن إِكُوْنْيَا</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />ذِي ثنْدِينْت ن إِكُوْنْيَا ؤُذْفن بُوْلُس ذ بَرْنَابَا س ثْنَاين إِذْسن غَار ثمْزِيذَا ن أَيث-إِسْرَائِيل، ؤُمْنن اَطَّاس ن يسْرَائِيلِيْين ذ ييُوْنَانِيْين س تّبْشِير نْسن. <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />وَلَكِن يسْرَائِيلِيْين إِي يُوْݣِين اَذ اَمْنن سَامَرن يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل خ اَيثْمَاثْنغ، عمَّرن-اَسن اَزدْجِيف. <verse eid="ACT 14:2" /><verse number="3" style="v" sid="ACT 14:3" />بُوْلُس ذ بَرْنَابَا قِّيمن ذِنِّي اَطَّاس ن ڒْوقْث تْبشَّارن س سِيذِيثْنغ س يِجّن ن زْعَامث. يݣَّا سِيذِيثْنغ لْمُعْجِيزَاث ذ لْبُرْهَانَاث خ يفَاسّن ن بُوْلُس ذ بَرْنَابَا بَاش اَذ يسْبيّن اَوَاڒن نِّي إِي تْبشَّارن خ اَرْضَا ن سِيذِيثْنغ ذ صَّح. <verse eid="ACT 14:3" /><verse number="4" style="v" sid="ACT 14:4" />مسْفْرَاقن اَيثْبَاب ن ثنْدِينْت-أَ ن إِكُوْنْيَا خ ثْنَاين. ڒبْعَاض إِذْسن اَقَاثن اَك يسْرَائِيلِيْين، ڒبْعَاض إِذْسن اَقَاثن اَك اَرُّسُل. <verse eid="ACT 14:4" /><verse number="5" style="v" sid="ACT 14:5" />كَّرن يسْرَائِيلِيْين ذ يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل تَافْقن اَك اَرُّوْيَاس نْسن بَاش اَذ عدّن خ اَرُّسُل اَثن رجْمن س وزْرُو. <verse eid="ACT 14:5" /><verse number="6‏-7" style="v" sid="ACT 14:6-7" />اَرِّين-د ڒخْبَار <char style="it">اَرُّسُل</char>، اَروْڒن غَار ثنْدِينْت ن لِيسْتْرَا ذ ثنْدِينْت ن دِرْبَا ذ مَارَّا جْوَايه إِي ذَاسنْت د يُوْذْسن تْبشَّارن ذِنِّي ذِي لْوِلَايَا ن لِيكَاوْنِيَا.<verse eid="ACT 14:6-7" /></para>
  <para style="s">رجّْمن اَرَّسُوْل بُوْلُس س وزْرُو ذِي ثنْدِينْت ن لِيسْتْرَا</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />ذِي ثنْدِينْت ن لِيسْتْرَا ذِنِّي يجّن ن ورْيَاز ذ اَنشْرُوْف مُّوْثن-اَس يضَارن، زݣ وَامِي د يخْڒق عمَّارْص مَا يُوْيُوْر. <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />ئِتسْڒَا إِ وَاوَاڒ ن بُوْلُس. ئِخْزَر ذَايس مْلِيح بُوْلُس، يُوْفَا ذَايس لْإِيمَان إِي زِي غَا يݣنْفَا. <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />يڒَاغَا-د س يِجّن ن ثْمِيجَّا ثجْهذ ينَّا-ٱس: "كَّر، بدّ نِيشَان خ يضَارن نّش!" ڒخْدّنِّي ينخْضف يبْذَا يݣُّوْر.<verse eid="ACT 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 14:11" />وَامِي ࢲْرِين ڒْغَاشِي نِّي مِين يݣَّا بُوْلُس، عيّْضن س لُّغَا ن لِيقُوْنْيَا نَّان قَا أَربِّـيثن ذوْڒن ذ يوْذَان هْوَان-د غَارْنغ! <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />سمَّان-اَس إِ بَرْنَابَا &lt;زَافَس&gt;، سمَّان-اَس إِ بُوْلُس &lt;هِرْمِس&gt;<note caller="+" style="f"><char style="fr" closed="false">14‏.12 </char><char style="ft" closed="false">ئِسمَاون-أَ &lt;زَافَس&gt; ذ &lt;هِرْمِس&gt; نِثْنِي ذ لْأَصْنَام ن ييُوْنَانِيْين. </char></note> لِأَنَّا ذ بُوْلُس إِݣ يتْبشَّارن اَطَّاس. <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" />يُوْسَا-د ڒمْقدّم ن لْأَصْنَام زَافَس ونِّي إِݣ يتِيڒِين ذِي زَّاوْيِث زَّاث إِ ثنْدِينْت، يُوْوِي-د يينْدُوْزن يُوْوِي-د ثِقبِّيضِين ن نْوَار غَار ثوُّوْرَا ن ثنْدِينْت، ئِخس نتَّا ذ شَّعْب اَذَاسن قدّْمن دْبِيحث إِ بَرْنَابَا ذ بُوْلُس.<verse eid="ACT 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14" />أَرُّسُل نِّي يعْنِي بَرْنَابَا ذ بُوْلُس وَامِي سْڒِين اَوَاڒ نِّيي كَّرن شرّْݣن اَرُّوْض نْسن. ؤُذْفن ذِي ڒْوسْط ن يِوْذَان عيّْضن نَّان-اَسن: <verse eid="ACT 14:14" /><verse number="15" style="v" sid="ACT 14:15" />"آي يرْيَازن، مَايمِّي تݣّم مَانَايَا؟ قَا نشِّين ذ يوْذَان وَاهَا اَم كنِّيو اَم نشِّين كِيف-كِيف. نُوْوِي-اَوم-د يجّن ن وَاوَاڒ ذ اَصبْحَان بَاش اَذ تْبعّْذم إِ ثْمسْڒَايِين-أَ وَار ينفّْعن شَا، أَذ تْذوْڒم غَار أَربِّـي يدَّرن إِي د يخڒْقن اَجنَّا ذ ثْمُوْرْث ذ ڒبْحَر ذ مَارَّا مِين ذَايْسن. <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />ذِي زْمَانَاث يعْذُوْن، أَربِّـي يجَّا مَارَّا ڒݣْنُوْس اَذ ذْفَارن يبْرِيذن إِي خْسن. <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />وَلَكِن أَربِّـي يسْبيَّان-اَوم-د يخف نّس س مِين يخدّم، يعْنِي يتݣّ ڒْخِير يتِيشّ-اَوم اَنْࢲَار زݣ وجنَّا ذ ثْفدْجَاحْث ذِي ڒْوقْث نّس. ئِتشَّار-اَوم ؤُڒَاون نْوم س ڒفْرَاحث." <verse eid="ACT 14:17" /><verse number="18" style="v" sid="ACT 14:18" />س وَاوَاڒ-أَ بُوْلُس ذ بَرْنَابَا سْبدّن-ثن، وَلَكِن ڒْغَاشِي نِّي قسْحن س وَاطَّاس عْڒَاين قدّْمن-اَسن دْبِيحث.<verse eid="ACT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19" />منْبَعْد ؤُسِين-د شَان يسْرَائِيلِيْين زِي وَانْطَاكْيَا ذ إِكُوْنْيَا تْسَامَرن ڒْغَاشِي نِّي، اَرجْمن بُوْلُس س وزْرُو جَرّن-ث بَارَّا إِ ثنْدِينْت تْغِيڒ-اَسن يمُّوْث. <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />وَلَكِن وَامِي خَاس مُوْنن يمحْضَارن، ئِكَّر-د يدَّر وَا سّنِّي يُوْذف غَار ثنْدِينْت. ثِيوشَّا نّس يفّغ اَك بَرْنَابَا يرُوْح غَار ثنْدِينْت ن دِرْبَا.<verse eid="ACT 14:20" /></para>
  <para style="s">تعْقَابن-د غَار ثنْدِينْت ن وَانْطَاكْيَا ذِي سُوْرْيَا</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21" />بشَّارن ذِي ثنْدِينْت نِّي <char style="it">ن دِرْبَا</char>، أَرِّين اَطَّاس ن يِوْذَان ذ يمحْضَارن. سّنِّي ذوْڒن غَار ثنْدِينْت ن لِيسْتْرَا ذ إِكُوْنْيَا ذ وَانْطَاكْيَا. <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />ݣِّين ؤُڒ ذݣ يمحْضَارن نِّي، شجّْعن-ثن بَاش اَذ اَرْنِين ذِي لْإِيمَان نْسن. قَّارن-اَسن: أُو لَابُد اَخَانغ ثكّ اَطَّاس ن تَمَارَا بَاش نشِّين <char style="it">ڒْمُوْمِنِين</char> أَ نَاذف ذِي ڒْمُلْك ن أَربِّـي. <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />بُوْلُس ذ بَرْنَابَا يخْضَرن يمقّْرَانن ذِي مْكُڒ جْمَاعث ن ڒْمُوْمِنِين ڒخْدّنِّي ࢲُّوْدْجن، ࢲُوْمّن، جِّين-ثن ذݣ وفُوْس ن سِيذِي أَربِّـي إِي زِي ؤُمْنن.<verse eid="ACT 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 14:24" />سّنِّي عْذُوْن خ جْوَايه ن پِــيْسِيْدْيَا، ؤُوْضن غَار جْوَايه ن پَـامْفِيلْيَا. <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />وَامِي تْبشَّرن س وَاوَاڒ ن أَربِّـي ذِي ثنْدِينْت ن بَارْجَا، عْذُوْن غَار ثنْدِينْت ن وَاطَالْيَا. <verse eid="ACT 14:25" /><verse number="26" style="v" sid="ACT 14:26" /><char style="it">وَامِي كمّْڒن ڒْخذْمث نِّي ذِنِّي،</char> عقْبن سّنِّي ذݣ وغَرَّابُو غَار ثنْدِينْت ن وَانْطَاكْيَا مَانِيس د ؤُسِين قْبڒ، زِي مَانِيس تْوَاكلّْفن س ڒْخذْمث نِّي س اَرْضَا ن أَربِّـي. <verse eid="ACT 14:26" /><verse number="27" style="v" sid="ACT 14:27" />وَامِي ؤُوْضن ذِنِّي، سْمُوْنن جْمَاعث ن ڒْمُوْمِنِين عَاوْذن-اَسن مَارَّا مِين يݣَّا أَربِّـي خ وفُوْس نْسن ذ مَامّش يرْزم-اَسن ثَوَّارْث ن لْإِيمَان إِ يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل. <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />سعْذُوْن اَطَّاس ن ڒْوقْث ذِنِّي اَك يمحْضَارن.<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="s">لْعَلَاقَا يدْجَان جَار يمَسِحِيْين ذ شَّرِيعَا ن مُوْسَى</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />ؤُسِينْ-د شَا ن يرْيَازن زِي يَهُوْذِيَا سڒْمَاذن اَيثْمَاثْنغ <char style="it">ذݣ وَانْطَاكْيَا</char> نَّان-اَسن: "وَار ثْزمَّرم شَا اَذ تْنجْمم إِلَّا مڒَا ثݣِّيم طَّهَارث عْلَاحْسَاب شَّرِيعَا ن مُوْسَى." <verse eid="ACT 15:1" /><verse number="2‏-3" style="v" sid="ACT 15:2-3" />ئِرُوْح بُوْلُس ذ بَرْنَابَا تمْنَاقَارن اَك <char style="it">يِنِّي إِي د يُوْسِين زِي يَهُوْذِيَا</char>، ئِوْقع جَارَاسن يجّن ن لْخِلَاف ذ اَمقّْرَان. كَّرن جْمَاعث نِّي ن ڒْمُوْمِنِين <char style="it">ذݣ وَانْطَاكْيَا</char> يخْضَرن بُوْلُس ذ بَرْنَابَا بَاش اَثن سّكّن اَك ڒبْعَاض ن ڒْمُوْمِنِين نْسن غَار ثنْدِينْت ن لْقُدْس بَاش اَذ سّقْسَان اَرُّسُل ذ يمقّْرَانن ن جْمَاعث ن ڒْمُوْمِنِين خ لْخِلَاف-أَ إِݣ يوقْعن. وَامِي سّكّن بُوْلُس ذ بَرْنَابَا غَار لْقُدْس خ وبْرِيذ نْسن عْذُوْن خ فِنِيقِيَا ذ سَمَارْيَا. خبَّرن اَيثْمَاثنغ يدْجَان ذِنِّي خ مَامّش إِݣ ؤُمْنن ؤُڒَا ذ يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل. ڒخْبَار نِّي يسْفَرح-يثن اَطَّاس مَارَّا. <verse eid="ACT 15:2-3" /><verse number="4" style="v" sid="ACT 15:4" />وَامِي ؤُوْضن غَار لْقُدْس، رحّْبن زَّايْسن جْمَاعث ن ڒْمُوْمِنِين ذ يمقّْرَانن ن جْمَاعث-أَ ذ ارُّسُل. ذِنِّي بُوْلُس ذ بَرْنَابَا عَاوْذن-اَسن إِ نِثْنِي مَارَّا مِين يݣَّا أَربِّـي خ وفُوْس نْسن.<verse eid="ACT 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 15:5" />وَلَكِن كَّرن شَان ن ڒْمُوْمِنِين ڒْحِزب نْسن زݣ يفَرِّيسِيْين نَّان: ئِتْخصَّا وَا لَابُد اَذ طهَّارن يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل، أَثن ثْوصَّام اَذ طَاعن إِ شَّرِيعا ن مُوْسَى.<verse eid="ACT 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6" />مُوْنن اَرُّسُل ذ يمقّْرَانن ن جْمَاعث ن ڒْمُوْمِنِين حمَا اَذ خْزَرن ذِي لْخِلَاف-أَ. <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" />وَامِي مْنَاقَاشن اَطَّاس، ئِكَّر بُطْرُس يبدّ ينَّا-ٱسن: "آي اَيثْمَا، أَقَا كنِّيو ثسّْنم مشْحَاڒ زݣ وَامِي إِي ذَايِي يخْضَر أَربِّـي زَّايْوم بَاش يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل اَذ سْڒن زݣ وقمُّوْم ينُو اَوَاڒ ن لْإِنْجِيل اَذ اَمْنن. <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" />أَربِّـي ذ نتَّا إِݣ يسّْنن ؤُڒ ن بْنَاذم، يسظْهَار-د نتَّا بلِّي يقْبڒ-يثن يعْنِي يُوْشَا-ٱسن أَرُّوْح يقدّْسن مَامّش ذَانغ ث يُوْشَا إِ نشّْين. <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />وَار يݣِّي بُو س وُوْذمَاون جَارَانغ، ئِسِيرذ-اَسن ؤُڒَاون نْسن وَامِي ؤُمْنن. <verse eid="ACT 15:9" /><verse number="10" style="v" sid="ACT 15:10" />ڒخُّو كنِّيو مَايمِّي ثْزَعْمم اَذ تࢲرم أَربِّـي مِين غَا يݣّ، تݣّم دْقڒ ن ثْزَايْڒُوْت<note caller="+" style="f"><char style="fr" closed="false">15‏.10 </char><char style="ft" closed="false">ثزَايْڒُوْت نتَّاث ذ ثْزَاݣْرُوْت. تݣّن-تث خ يِيرَاون ن يفُوْنَاسن ذِي زْمَان شرّْزن زَّايس. قَّارن-اَس عَاوذ ثَغْوَاوْث. زَعْمَا نتَّاث ذ شَّرِيعَا ن مُوْسَى، ثذْقڒ خ يِوْذَان مِنْزِي ذَايس اَطَّاس ن ڒُوْصِيَاث.</char></note> خ يِيرِي ن يمحْضَارن؟ دْقڒ نِّي تُوْغَا وَار نْزمَّر اَث نيْسِي لَّا نشِّين ؤُڒَا ذ ڒجْذُوْذ نّغ. <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />نشِّين مِين نْتَامن؟ نْتَامن بلِّي نشِّين أَ ننْجم س اَرْضَا ن سِيذِيثْنغ عِيْسَى مَامّش غَا نجْمن ؤُڒَا ذ يِنِّي <char style="it">وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل</char>."<verse eid="ACT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12" />مَارَّا جْمَاعث نِّي ذِنِّي إِي قِّيمن وَار نِّين وَالُو، تسْڒَان إِ بَرْنَابَا ذ بُوْلُس سَّاوَاڒن خ لْمُعْجِيزَاث ذ لْبُرْهَانَاث يݣَّا أَربِّـي خ وفُوْس نْسن جَار يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل.<verse eid="ACT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 15:13" />وَامِي كمّْڒن اَوَاڒ نْسن، ئِنْدق-د يَعْقُوْب ينَّا-ٱسن: "آي اَيثْمَا، صنّْطم غَارِي مْلِيح! <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />ئِعَاوذ-اَنغ سِمْعَان خ مَامّش ذݣ ومزْوَارُو يفْقذ أَربِّـي يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل يخْضَر شَا زَّايْسن اَذ يڒِين ذ شَّعْب نّس. <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />مَانَايَا يُوْسَا-د اَك لْأَنْبِيَا مِين نَّان ذِي زْمَان، مَامّش يقَّار لْكِتَاب:<verse eid="ACT 15:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="ACT 15:16" />منْبَعْد إِ مَانَايَا نش اَذ د ذوْڒغ،</para>
  <para style="q1" vid="ACT 15:16">أَقِيضُوْن ن دَاود إِي يوْضَان اَث سْبدّغ،</para>
  <para style="q1" vid="ACT 15:16">مِين زَّايس ينْهذْمن اَث سْݣَعّْذغ اَث عذْڒغ.<verse eid="ACT 15:16" /></para>
  <para style="q1">
    <verse number="17‏-18" style="v" sid="ACT 15:17-18" />بَاش ينِّي يقِّيمن زݣ يِوْذَان اَذ رْزُوْن خ سِيذِي أَربِّـي،</para>
  <para style="q1" vid="ACT 15:17-18">بَاش مَارَّا يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل</para>
  <para style="q1" vid="ACT 15:17-18">يِنِّي إِي ييْسِين يسم ينُو اَخَاس رْزُوْن.</para>
  <para style="q2" vid="ACT 15:17-18">أَمُّو يقَّار سِيذِي أَربِّـي</para>
  <para style="q2" vid="ACT 15:17-18">ثِمسْڒَايِين-أَ إِي دْجَانْت زِي زْمَان،</para>
  <para style="q2" vid="ACT 15:17-18">ڒخُّو يسْمظْهَار-يثنْت-يد."<verse eid="ACT 15:17-18" /></para>
  <para style="b" />
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19" />
    <char style="it">ينَّا-ٱسن يعْقُوْب:</char> "خ مَانَايَا نش تْوَارِيغ وَار نْسقْسَاح شَا خ يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل إِݣ يتَامْنن ڒخُّو زِي أَربِّـي. <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />وَلَكِن اَذَاسن نَارِي <char style="it">ثَبْرَات-أَ</char> حمَا اَذ بعّْذن خ لْمَكْلَا يتْوَاقدّْمن إِ لْأَصْنَام ذ لْفَسَاد ذ مِين يتْوَاجيّْفن ذ يذَامّن. <verse eid="ACT 15:20" /><verse number="21" style="v" sid="ACT 15:21" />لِأَنَّا زِي زْمَان تْحدَّاثن إِ يِوْذَان س شَّرِيعَا ن مُوْسَى ذِي مْكُڒ ثنْدِينْت، قَّارن-ت زِي سّبْث غَار سّبْث ذِي ثمزِيذَاوِين ن أَيث-إِسْرَائِيل."<verse eid="ACT 15:21" /></para>
  <para style="s">ثَبْرَات إِ ڒْمُوْمِنِين إِي وَار يدْجِين شَا ذ يسْرَائِيلِيْين</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />خ مَانَايَا اَرُّسُل ذ يمقّْرَانن ن جْمَاعث ن ڒْمُوْمِنِين ذ مَارَّا جْمَاعث ن ڒْمُوْمِنِين ݣِّين اَذ يخْضَرن شَان ن يرْيَازن نْسن، أَثن سّكّن اَك بُوْلُس ذ بَرْنَابَا غَار ثنْدِينْت ن وَانْطَاكْيَا. ئِخْضَرن يجّن ؤُمِي قَّارن سِيلَاس ذ يِجّن قَّارن-اَس يَهُوْذَا يعْنِي ونِّي ؤُمِي قَّارن بَارْسَابَا، غَارْسن يجّن ن ومْشَان ذ اَمقّْرَان جَار ڒْمُوْمِنِين. <verse eid="ACT 15:22" /><verse number="23" style="v" sid="ACT 15:23" />سّكّن اَكِذْسن ثَبْرَات-أَ نَّان-اَسن:</para>
  <para style="p" vid="ACT 15:23">"آي اَيثْمَاثْنغ وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل إِݣ يزدّْغن ذِي وَانْطَاكْيَا ذ سُوْرْيَا ذ لْإِقْلِيم ن كِيلِيكْيَا، نتْسدْجَام خَاوم نشِّين إِي يدْجَان ذ اَرُّسُل ذ يمقّْرَانن ن جْمَاعث ن ڒْمُوْمِنِين.<verse eid="ACT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 15:24" />نتْسْڒَا بلِّي شَان يِوْذَان زَّايْنغ ؤُسِين-د غَارْوم بْڒَا لْإِذن نّغ، سدّْعن-كنِّيو، سِيذْفن ذَايْوم شّكّ س وَاوَاڒ نْسن. <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />نشِّين مَارَّا نْتَافق، نِيخْضَر شَان ن يرْيَازن اَثن د نسّكّ غَارْوم اَك يمْعِيزّن نّغ بَرْنَابَا ذ بُوْلُس. <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />يرْيَازن-أَ غَامَرن س ثُوْذَارْث نْسن خ يِيسم ن سِيذِيثْنغ عِيْسَى لْمَسِيح. <verse eid="ACT 15:26" /><verse number="27" style="v" sid="ACT 15:27" />خ مَانَايَا نسّكّ-اَوم-د ؤُڒَا ذ يَهُوْذَا-يَا ذ سِيلَاس-أَ بَاش اَذَاوم ينِين س وقمُّوْم نْسن مِين ذَاوم د نُوْرَا ذِي ثبْرَات-أَ. <verse eid="ACT 15:27" /><verse number="28" style="v" sid="ACT 15:28" />نشِّين ذ أَرُّوْح يقدّْسن نتْوَاڒَا مْلِيح وَار خَاوم نتّݣّ بُو دْقڒ اَطَّاس إِلَّا مِين يدْجَان وَا لَابُد. <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />يعْنِي اَذ تْبعّْذم خ لْمَكْلَا يتْوَاقدّْمن إِ لْأَصْنَام، ذ يذَامّن، ذ مِين يتْوَاجيّْفن، ذ لْفَسَاد. مڒَا ثْبعّْذم خ ثْمسْڒَايِين-أَ وَا اَتَاف ثݣِّيم مْلِيح. اَكنِّيو يعَاون أَربِّـي."<verse eid="ACT 15:29" /></para>
  <para style="b" />
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />يِيْنَا يتْوَاسّكّن غَار وَانْطَاكْيَا صَافِي ؤُوْضن ذِنِّي، سْمُوْنن جْمَاعث ن ڒْمُوْمِنِين ؤُشِين-اَسن ثَبْرَات نِّي. <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />وَامِي ت غْرِين جْمَاعث نِّي فَرْحن اَطَّاس لِأَنَّا ثْشجّع-يثن. <verse eid="ACT 15:31" /><verse number="32" style="v" sid="ACT 15:32" />يَهُوْذَا ذ سِيلَاس نِثْنِي ذ لْأَنْبِيَا، تْشجَّاعن ڒْمُوْمِنِين س وَاطَّاس ن وَاوَاڒن، ݣِّين ذَايْسن ؤُڒ. <verse eid="ACT 15:32" /><verse number="33" style="v" sid="ACT 15:33" />قِّيمن ذِنِّي يجّن ن لْمُدَّا، منْبَعْد سّكّن-ثن ڒْمُوْمِنِين نِّي ذِي ڒهْنَا غَار يِنِّي إِي ثن د يسّكّن. <verse eid="ACT 15:33" /><verse number="34" style="v" sid="ACT 15:34" />{وَلَكِن سِيلَاس يݣَّا اَذ يقِّيم ذِنِّي.} <verse eid="ACT 15:34" /><verse number="35" style="v" sid="ACT 15:35" />بُوْلُس ذ بَرْنَابَا قِّيمن ذِي ثنْدِينْت ن وَانْطَاكْيَا، سڒْمَاذن تْبشَّارن س وَاوَاڒ ن سِيذِي أَربِّـي، نِثْنِي ذ وَاطَّاس ن يِوْذَان.<verse eid="ACT 15:35" /></para>
  <para style="s">لْخِلَاف جَار اَرَّسُوْل بُوْلُس ذ بَرْنَابَا</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />ثعْذُو يجّن ن ڒْوقْث، ينَّا-ٱس بُوْلُس إِ بَرْنَابَا: يَالَّاه، أَ نذْوڒ غَار اَيثْمَاثْنغ ذِي كُڒ ثنْدِينْت مَانِي نْبشَّر س وَاوَاڒ ن سِيذِي أَربِّـي أَ نࢲر مَامّش دْجَان. <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />بَرْنَابَا يخس اَكِذْسن يَاوِي يُوْحَنَّا ونِّي ؤُمِي قَّارن مَرْقُس. <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" />وَلَكِن بُوْلُس وَار ذَاس يعْجِيب شَا اَث اَوِين اَكِذْسن مِنْزِي مَرْقُس تُوْغَا يسْمح ذَايْسن ذِي پَـامْفِيلْيَا وَار كِيسن يقِّيم شَا ذِي ڒْخذْمث نِّي. <verse eid="ACT 15:38" /><verse number="39" style="v" sid="ACT 15:39" />وَار تَافْقن قَاع ذِي ثْمسْڒَايْث-أَ، كُڒ يجّن مَانِس يكَّا. بَرْنَابَا يسَفَر اَك مَرْقُس ذݣ وغَرَّابُو غَار قُبْرُص. <verse eid="ACT 15:39" /><verse number="40" style="v" sid="ACT 15:40" />بُوْلُس نتَّا يخْضَر سِيلَاس، فّْغن نِثْنِي كلّْفن-ثن ڒْمُوْمِنِين خ ڒْخذْمث نِّي نَّان اَخَاوم يَارْضَا سِيذِيثْنغ. <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />ئِرُوْح غَار سُوْرْيَا ذ لْإِقْلِيم ن كِيلِيكْيَا يتݣّ ؤُر ذي ثْجُمَاع ن ڒْمُوْمِنِين.<verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="s">يتْمُوْن تِيْمُوْتَاوُس اَك اَرَّسُوْل بُوْلُس ذ سِيلَاس</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />يُوْوض بُوْلُس غَار ثنْدِينْت ن دِرْبَا ذ ثنْدِينْت ن لِيْسْتْرَا، يُوْفَا ذِنِّي يجّن ن ومحْضَار قَّارن-اَس تِيْمُوْتَاوُس. يمَّاس نتَّاث ذ ثَئِسْرَائِيلِيث ذ ڒْمُوْمْنَا، بَابَاس ذ اَيُوْنَانِي. <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />أَيثْمَاثْنغ إِي يدْجَان ذِي ثنْدِينْت ن إِكُوْنْيَا ذ لِيسْتْرَا سِّيوْڒن مْلِيح خ تِيْمُوْتَاوُس. <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />يݣَّا-ٱس طَّهَارث بُوْلُس وَامِي يخس اَث يَاوِي اَكِذس. يݣَّا-ٱس اَمنِّي عْلَاحْسَاب يسْرَائِيلِيْين يدْجَان ذݣ يمُوْشَان نِّي نِثْنِي مَارَّا سّْنن بلِّي بَابَاس ذ اَيُوْنَانِي.<verse eid="ACT 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 16:4" />خْمِي يݣُّوْر <char style="it">بُوْلُس ذ يمدُّوْكَاڒ نّس</char> زݣ وبِيلَاج غَار وبِيلَاج يقَّار-اَسن ڒُوْصِيَاث نِّي ثِنِّي إِي ݣِّين اَرُّسُل ذ يمقّْرَانن ن جْمَاعث ن ڒْمُوْمِنِين ذِي لْقُدْس<note caller="+" style="f"><char style="fr" closed="false">16‏.4 </char><char style="ft" closed="false">ڒُوْصِيَاث-أَ ذ ثَبْرَات نِّي إِي يدْجَان ذݣ وُوْذم وِيس 15 ذِي لْأَيَاث 28 ذ 29.</char></note> حمَا ٱثنْت ذْفَارن يِوْذَان. <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />أَمنِّي ثِجُمَاع ن ڒْمُوْمِنِين تجْهِيذنْت ذِي لْإِيمَان، كُڒ نْهَار يَرنِّي لْعَدَد نْسنْت.<verse eid="ACT 16:5" /></para>
  <para style="s">لْوَاحِي نِّي إِي د يهْوَان زِي أَربِّـي إِ بُوْلُس ذِي ثنْدِينْت ن تْرَاوْس</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />بُوْلُس ذ يمدُّوْكَاڒ نّس كِّين خ جْوَايه ن فْرِيْجْيَا ذ ݣَالَاطْيَا، وَار ثن يجِّي شَا أَرُّوْح يقدّْسن ٱذ بشَّرن س وَاوَاڒ ن أَربِّـي ذِي لْإِقْلِيم ن آسْيَا. <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />وَامِي ؤُوْضن غَار لْحُدُوْد ن مِيْسْيَا، قدْجْبن اَذ اَذْفن لْإِقْلِيم ن بِيثِينْيَا وَلَكِن وَار ثن يجِّي شَا اَرُّوْح ن عِيْسَى. <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />س مَانَايَا سمْحن ذِي مِيسْيَا هْوَان غَار ثنْدِينْت ن تْرَاوْس. <verse eid="ACT 16:8" /><verse number="9" style="v" sid="ACT 16:9" />ذِي دْجِيڒث نِّي يهْوَا-د يجّن ن لْوَاحِي خ بُوْلُس يࢲْرَا ذَايس يجّن ن وثَرَّاس زِي لْإِقْلِيم ن مَاسِدُوْنْيَا يبدّ يتْطَلَاب-يث يقَّار-اَس زْوَا-د غَارْنغ غَار مَاسِدُوْنْيَا عَاوْن-اَنغ. <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />وَامِي صَافِي يࢲْرَا لْوَاحِي نِّي بُوْلُس، نكَّر نشِّين نْسوْجذ حمَا أَ نْسَفر ڒخْدّنِّي غَار لْإِقْلِيم ن مَاسِدُوْنْيَا. نفْهم بلِّي أَربِّـي يتْڒَاغَا-د خَانغ اَثن نْبشَّر س لْإِنْجِيل ذِنِّي.<verse eid="ACT 16:10" /></para>
  <para style="s">أَرَّسُوْل بُوْلُس ذ سِيلَاس تْبشَّارن ذِي ثنْدِينْت ن فِيلِيپِّـي</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />سّنِّي نْسَفر ذݣ وغَرَّابُو زِي ثنْدِينْت ن تْرَاوْس، نْرُوْح نِيشَان غَار ثنْدِينْت ن سَامُوْتْرَاكْيَا. ثِيوشَّا نّس نْرُوْح غَار ثنْدِينْت ن نِيَاپُـوْلِيس. <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />سّنِّي نْرُوْح غَار فِيلِيپِّـي، نتَّاث ذ يجّن ن ثنْدِينْت ثُوْسَا-د ذِي لْوِلَايَا ثَمزْوَارُوْت ن لْإِقْلِيم ن مَاسِدُوْنْيَا، سْتَعْمَارن-تث يرُوْمَانِيْين. نقِّيم ذِنِّي ذِي ثنْدِينْت نِّي ڒبْعَاض ن وُوْسَّان.<verse eid="ACT 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 16:13" />ذِي نْهَار ن سّبْث ن لْعِبَادَا نفّغ زِي ثوَّارْث ن ثنْدِينْت نْرُوْح غَار طَّارف ن يِغْزَار، تْغِيڒ-اَنغ أَ نَاف ذِنِّي يجّن ن ومْشَان ن ثْࢲَادْجِيث. نقِّيم نسَّاوَاڒ اَك ثمْغَارِين نِّي إِي نُوْفَا ذِنِّي يمُوْنن. <verse eid="ACT 16:13" /><verse number="14" style="v" sid="ACT 16:14" />أَكِذْسنْت ذِنِّي يجّن ن ثمْغَارْث ثسْڒَا-يَانغ قَّارن-اَس لِيدْيَا. نتَّاث زِي ثنْدِينْت ن ثِيَاتْرَا ثزْنُوْزَا ثْشُوْقّت نِّي إِي يغْڒَان لُّوْن نّس ذ لِّيلَا،<note caller="+" style="f"><char style="fr" closed="false">16‏.14 </char><char style="ft" closed="false">لِيلَا نتَّاث ذ بَنفْسَاجِي.</char></note> ثْعبّذ أَربِّـي. يرْزم-اَس سِيذِي أَربِّـي ؤُڒ نّس بَاش اَذ تْصنّط إِ وَاوَاڒ ن بُوْلُس. <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />وَامِي ثتْوَاطهَّار س وَامَان نتَّاث ذ ڒحْبَاب نّس، ثتَّار زَّايْنغ ثنَّا-ٱنغ: "أَرَاحم-د غَار ثدَّارْث ينُو قِّيمم اَكِذِي يعْنِي مڒَا ثْتيّْقم بلِّي نش ؤُمْنغ زِي سِيذِي أَربِّـي." ثْحشّم-اَنغ نتَّاث اَڒ وَامِي نقْبڒ.<verse eid="ACT 16:15" /></para>
  <para style="s">أَرَّسُوْل بُوْلُس ذ سِيلَاس تْوَاحبّْسن ذِي ثنْدِينْت ن فِيلِيـپِّـي</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16" />
    <char style="it">ئِجّن ن نْهَار</char> وَامِي نْرُوْح غَار ومْشَان نِّي مَانِي تْࢲَادْجَان يِوْذَان، ثْمڒْقَا ٱكِذْنغ يجّن ن ثِيسْمغْث نتَّات ذ ثَكهَّانْت تَاوِي-د س سِّحر نّس اَطَّاس ن تْمنْيَاث إِ اَيثْبَاب نّس. <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />تْبَاع-اَنغ-د نشِّين ذ بُوْلُس تْعيَّاض ثقَّار قَا يرْيَازن-أَ عبّْذن أَربِّـي يُوْعْڒَان، تْبشَّارن-كنِّيو س وبْرِيذ إِي زِي غَا ثْنجْمم! <verse eid="ACT 16:17" /><verse number="18" style="v" sid="ACT 16:18" />ثݣَّا مَانَاينِّي اَطَّاس ن نْهُوْرَاث، بُوْلُس وَار ذَاس يعْجِيب بُو ڒْحَاڒ. ئِنقْڒب-د غَارس ينَّا-ٱس إِ جّنّ نِّي إِي ذَايس: "نش تَامَرغ-شك عْلَاحْسَاب يسم ن عِيْسَى لْمَسِيح اَزَّايس ثفّْغذ." ڒخْدّنِّي يفّغ جّنّ نِّي زَّايس ذݣ ومْشَان.<verse eid="ACT 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19" />أَيثْبَاب ن ثِيسْمغْث نِّي وَامِي ؤُفِين ثَوَّارْث ن لْمَنْدَا نْسن صَافِي ثْبلّْع خَاسن، كَّرن طّْفن بُوْلُس ذ سِيلَاس جَرّن-ثن غَار سَّاحَا غَار لْحُكَّام. <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />قدّْمن-ثن غَار لْحُكَّام نَّان-اَسن: "يرْيَازن-أَ ذ يسْرَائِيلِيْين تݣّن-اَنغ ڒْفَوْضَا ذِي ثنْدِينْت. <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />سڒْمَاذن لْعَادَاث وَار نْزمَّر شَا اَثنْت نقْبڒ نِغ اَزَّايْسنْت نخْذم مِنْزِي نشِّين ذ يرُوْمَانِيْين." <verse eid="ACT 16:21" /><verse number="22" style="v" sid="ACT 16:22" />ڒخْدّنِّي مُوْنن ڒْغَاشِي هجْمن خ بُوْلُس ذ سِيلَاس، لْحُكَّام نِّي شرّْݣن-اَسن اَرُّوْض ؤُمَرن خَاسن بَاش اَذَاسن ؤُشن اَعْمُوْذ. <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />ؤُوْثِين-ثن اَطَّاس س وعْمُوْذ نْضَرن-ثن ذِي ڒحْبس. نَّان-اَس إِ لْحَارِس ن ڒحْبس عسّ خَاسن مْلِيح. <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />وَامِي يسْڒَا نتَّا اَوَاڒ-أَ، ئِرُوْح يݣِّي-ثن غَار ذَاخڒ قَاع ن ڒحْبس يقّن-يثن زݣ يضَارن نْسن غَار يكشُّوْضن يذقْڒن.<verse eid="ACT 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25" />غَار ڒْوسْط ن دْجِيڒث بُوْلُس ذ سِيلَاس تْࢲَادْجَان تْغنَّاجن يزْڒَان إِ أَربِّـي، تسْڒَان-اَسن يمحْبَاس. <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />عْلَاغَفْلَا يوْقع يجّن ن زِّنْزَال ذ اَمقّْرَان اَڒ وَامِي نْهزّن ؤُڒَا ذ دْسَاسَاث ن ڒحْبس. نُوْرْزْمنْت ثوُّوْرَا نّس مَارَّا، عَاوذ نُوْفْسْڒنْت-اَسن سْنَاسڒ إِ يمحْبَاس مَارَّا. <verse eid="ACT 16:26" /><verse number="27" style="v" sid="ACT 16:27" />وَامِي د يفَاق لْحَارِس ن ڒحْبس زݣ يِضص يُوْفَا ثِوُّوْرَا ن ڒحْبس نُوْرْزْمنْت تْغِيڒ-اَس يمحْبَاس نِّي اَروْڒن، ئِجْبذ-د سِّيف حمَا ٱذ ينغ يخف نّس. <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />ئِڒَاغَا-يَاس-د بُوْلُس س جّْهذ ينَّا-ٱس: "لَّا! غَارك اَذ تْضَرّذ يخف نّش، قَا نشِّين عَاذ اَقَانغ ذَا مَارَّا إِذْنغ!"<verse eid="ACT 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29" />ينَّا لْحَارِس ن ڒحْبس شعّْڒم ڒفْنَارَاث. ئِرُوْح يتَازّڒ غَار بُوْلُس ذ سِيلَاس يسجّذ-اَسن غَار يضَارن نْسن يبْذَا يترْجِيجِي. <verse eid="ACT 16:29" /><verse number="30" style="v" sid="ACT 16:30" />ئِسُوْفغ-يثن-د ينَّا-ٱسن: "آ سِيَاذِي، مِين غَا ݣّغ بَاش اَذ نجْمغ؟" <verse eid="ACT 16:30" /><verse number="31" style="v" sid="ACT 16:31" />نَّان-اَس: "أَمن زِي سِيذِيثْنغ عِيْسَى اَذ تْنجْمذ شك ذ ڒحْبَاب نّش." <verse eid="ACT 16:31" /><verse number="32" style="v" sid="ACT 16:32" />بْذَان تْبشَّرن-ث نتَّا ذ مَارَّا ڒحْبَاب نّس س وَاوَاڒ ن سِيذِيثْنغ. <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />ذِي ثْسَعَّات نِّي س دْجِيڒث، يُوْوِي-ثن لْحَارِس ن ڒحْبس يمْسح-اَسن يجَارِّيحن. ڒخْدّنِّي يتْوَاطهَّار س وَامَان نتَّا ذ مَارَّا ڒحْبَاب نّس. <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />يُوْوِي-ثن غَار ثدَّارْث نّس يُوْشَا-اَسن اَذ شّن. ئِفَرح نتَّا ذ مَارَّا ڒحْبَاب نّس مِينْزِي ؤُمْنن زِي أَربِّـي.<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />وَامِي د يصْبح ڒْحَاڒ، لْحُكَّام سّكّن يمْخَازْنِيْين غَار لْحَارِس ن ڒحْبس نَّان-اَس: ضْڒق-اَسن إِ يرْيَازن-أَ! <verse eid="ACT 16:35" /><verse number="36" style="v" sid="ACT 16:36" />لْحَارِس يخبَّر بُوْلُس ينَّا-ٱس قَا ؤُمَرن-كنِّيو لْحُكَّام اَذ تْوَاضڒْقم. صَافِي فّْغث، رُوْحث ذِي ڒهْنَا!<verse eid="ACT 16:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37" />ينَّا-ٱسن بُوْلُس إِ يمْخَازْنِيْين نِّي: "ؤُوْثِين-اَنغ زَّاث إِ يِوْذَان بْڒَا ڒْقَانُوْن نْضَرن-اَنغ ذِي ڒحْبس، وَلَكِن نشِّين غَارْنغ لْجِنْسِيَا ن رُوْمَا. ڒخُّو نِثْنِي، مَا رزُّوْن اَذَانغ سُوْفْغن وَار د يتَارِّي حَدّ ڒخْبَار؟" <char style="it">ينَّا-ٱسن:</char> "لَّا، ئِتْخصَّا ٱذ د اَسن لْحُكَّام نِّي س يِيخف نْسن اَذَانغ سُوْفْغن!"<verse eid="ACT 16:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38" />ئِمْخَازْنِيْين نِّي رُوْحن عَاوْذن-اَسن اَوَاڒ-أَ إِ لْحُكَّام، لْحُكَّام نِّي نْخڒْعن وَامِي سّْنن بلِّي بُوْلُس ذ سِيلَاس ذ يرُوْمَانِيْين. <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />ؤُسِين-د غَارْسن تتَّارن زَّايْسن اَذَاسن سَامْحن، سُوْفْغن-ثن زِي ڒحْبس تَّارن زَّايْسن اَذ فّْغن زِي ثنْدِينْت. <verse eid="ACT 16:39" /><verse number="40" style="v" sid="ACT 16:40" />وَامِي فّْغن زِي ڒحْبس رُوْحن غَار ثدَّارْث ن لِيْدْيَا. ࢲْرين ذِنِّي اَيثْمَاثْسن شجّْعن-ثن، سّنِّي ؤُيُوْرن.<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="s">تْوَاعدَّابن بُوْلُس ذ سِيلَاس ذِي ثنْدِينْت ن سَالُوْنِيك</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />عْذُوْن خ ثنْدِينْت ن ومْفِيپُـوْلِيس ذ ثنْدِينْت ن وپُـوْلُوْنْيَا، ؤُوْضن غَار ثنْدِينْت ن سَالُوْنِيك مَانِي ثدْجَا ذِنِّي يجّن ن ثمْزِيذَا ن أَيث-إِسْرَائِيل. <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />يُوْذف بُوْلُس غَار ثمْزِيذَا نِّي مَامّش يتݣّ ڒبْدَا. ثْڒَاثَا ن سِيمَانَاث كُڒ نْهَار ن سّبْث ن لْعِبَادَا يتمْنَاقَاش اَكِذْسن يقَّار-اَسن مِين يُوْرِين ذِي لْكُتُب. <verse eid="ACT 17:2" /><verse number="3" style="v" sid="ACT 17:3" />ئِسفْهَام-يثن يسْبيَّان-اَسن دَّلِيل خ مَامّش أُو لَابُد لْمَسِيح اَذ يتْوَاعدّب اَذ د يكَّر زِي ڒْموْث. ينَّا-ٱسن قَا عِيْسَى-يَا إِي زِي كنِّيو تْبشَّارغ نتَّا س يِيخف نّس ذ لْمَسِيح. <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />قْتَانْعن ڒبْعَاض زَّايْسن مُوْنن اَك بُوْلُس ذ سِيلَاس. أَكِذْسن خَربِّي ن ييُوْنَانِيْين إِي يتݣّْوْذن أَربِّـي. أَكِذْسن عَاوذ اَطَّاس ن ثمْغَارِين زِي ثِنِّي إِي غَار ثدْجَا لْمَرْتَبَا.<verse eid="ACT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5" />وَلَكِن يسْرَائِيلِيْين نّغْنِي حسْذن-ثن، رُوْحن سْمُوْنن-د زِي سُّوْق يجّن ن لْمجْمُوْع ن يكْرُوْشَّارن يعفَّانن بَاش اَذ ݣّن سّْدَع، سْنكَّرن ڒْفَوْضَا ذِي ثنْدِينْت. هجْمن خ ثدَّارْث ن يِجّن قَّارن-اَس يَاسِين رزُّوْن خ بُوْلُس ذ سِيلَاس حمَا اَثن سلّْمن إِ ڒْغَاشِي. <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />وَامِي وَار ثن ؤُفِين شَا، جَرّن يَاسِين ذ ڒبْعَاض ن اَيثْمَاثْنغ غَار لْحُكَّام ن ثنْدِينْت. سْنكَّرن ثْغُوْيّث قَّارن: "يرْيَازن نِّي إِي ݣِّين لْفِتْنَا ذِي مَارَّا دُّنشْت، ڒخُّو اَقَاثن ذَا <verse eid="ACT 17:6" /><verse number="7" style="v" sid="ACT 17:7" />ذ ينوْجِيون غَار يَاسِين <char style="it">وَانِيتَا</char>. مَارَّا يِـيْنَا عصَّان ڒْقَانُوْن ن لْمَلِك قَيْصَر قَّارن قَا ذِنِّي يجّن ن وزدْجِيذ نّغْنِي قَّارن-اَس عِيْسَى." <verse eid="ACT 17:7" /><verse number="8" style="v" sid="ACT 17:8" />وَامِي شَّعْب ذ لْحُكَّام ن ثنْدِينْت سْڒِين إِ مَانَايَا، ئِكَّر يجّن ن سّْدَع ذ اَمقّْرَان. <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />سّنِّي طّْفن لْكَفَالَا زِي يَاسِين ذ ينّغْنِي، ضڒْقن-اَسن.<verse eid="ACT 17:9" /></para>
  <para style="s">أَرَّسُوْل بُوْلُس ذ سِيلَاس ذِي ثنْدِينْت ن بِيرْيَا</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />سّنِّي س دْجِيڒث نِّي اَيثْمَاثْنغ سّكّن بُوْلُس ذ سِيلَاس غَار ثنْدِينْت ؤُمِي قَّارن بِيرْيَا. وَامِي ؤُوْضن، ؤُذْفن غَار ثمْزِيذَا ن أَيث-إِسْرَائِيل. <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />أَيث-بِيرْيَا نِثْنِي حْسن زݣ اَيث-سَالُوْنِيك، قبّْڒن اَوَاڒ ن أَربِّـي ذغْيَا س ڒفْرَاحث. قَّارن ذِي لْكُتُب كُڒ نْهَار بَاش اَذ سّْنن اَوَاڒ نِّي إِي قَّارن بُوْلُس ذ سِيلَاس مَا ذ صَّح نِغ لَّا. <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />ؤُمْنن اَطَّاس زَّايْسن. ؤُمْننْت خَربِّي ن ثمْغَارِين ثِيُوْنَانِيِين غَارْسنْت لْمَرْتَبَا، ؤُمْنن عَاوذ اَطَّاس ن ييُوْنَانِيْين.<verse eid="ACT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 17:13" />ئِسْرَائِيلِيْين نِّي ذِي ثنْدِينْت ن سَالُوْنِيك اَرِّين-د ڒخْبَار بُوْلُس يتْبشَّار س وَاوَاڒ ن أَربِّـي ذِي ثنْدِينْت ن بِيرْيَا. ؤُسِين-د غَار بِيرْيَا بْذَان تݣّن يخَارْوِيضن سْهَاجن خَاس ڒْغَاشِي. <verse eid="ACT 17:13" /><verse number="14" style="v" sid="ACT 17:14" />ڒخْدّنِّي اَيثْمَاثْنغ سّكّن بُوْلُس غَار ڒبْحَر، ئِقِّيم سِيلَاس ذ تِيْمُوْتَاوُس ذِي ثنْدِينْت ن بِيرْيَا. <verse eid="ACT 17:14" /><verse number="15" style="v" sid="ACT 17:15" />يرْيَازن نِّي إِي رُوْحن اَك بُوْلُس سِّيوْضن-ث غَار ثنْدِينْت ن ؤُتِينَا سّنِّي ذوْڒن-د. ئِوصَّا-ثن بُوْلُس ينَّا-ٱسن: إِنِيم-اَسن إِ سِيلَاس ذ تِيْمُوْتَاوُس اَرَاحم-د غَارِي ذغْيَا.<verse eid="ACT 17:15" /></para>
  <para style="s">أَرَّسُوْل بُوْلُس يتْبشَّار ذِي ثنْدِينْت ن ؤُتِينَا</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />بُوْلُس وَامِي تُوْغَا يتْرَاجَا سِيَلَاس ذ تِيْمُوْتَاوُس ذِي ثنْدِينْت نِّي ن ؤُتِينَا يتْوَاڒَا ثَنْدِينْت نِّي ثْعمَّر س لْأَصْنَامَاث وَار ذَاس يعْجِيب بُو ڒْحَاڒ. <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />ئِتمْنَاقَاش ذِي ثمْزِيذَا اَك يسْرَائِيلِيْين ذ ينّغْنِي يتݣّْوْذن أَربِّـي، ئِتمْنَاقَاش عَاوذ اَك يِنِّي إِي كذ يتمْسڒْقَا كُڒ نْهَار ذِي سَّاحَا ن ثنْدِينْت. <verse eid="ACT 17:17" /><verse number="18" style="v" sid="ACT 17:18" />شَان لْفَلَسِفَا ؤُمِي قَّارن يبِيكُوْرِيْين ذ شَان لْفَلَسِفَا نّغْنِي ؤُمِي قَّارن يرِيوَاقِيْين بْذَان تمْنَاقَاشن اَك بُوْلُس نَّان ڒبْعَاض زَّايْسن، مِين يخس اَذ يِينِي وَانِيتَا يتْـپـڒْپِـيڒن وَاهَا؟ نَّان يِوْذَان نّغْنِي يمْكن يتْبشَّار س أَربِّـيثن ن دُّوَل. نَّان مَانَايَا مِينْزِي بُوْلُس يتْبشَّار س عِيْسَى ذ لْقِيَامَا. <verse eid="ACT 17:18" /><verse number="19" style="v" sid="ACT 17:19" />ؤُوِين بُوْلُس ندْهن-ث غَار لْمَجْلِس نْسن ؤُمِي قَّارن أَرْيُوْبَاݣُوْس نَّان-اَس: "نْرزُّو أَ نسّن تَّعْلِيم-أَ ن جْذِيذ إِي زِي ثْسڒْمَاذذ شك. <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />ثِمسْڒَايِين-أَ نتْعجّب ذَايْسنْت، عمَّارص وَار نسْڒِي خ مِين ثقَّارذ شك. نخْس أَ نسّن ڒْمَعْنَا نْسنْت." <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />(إِيوَا مَارَّا يمزْذَاغ ن ؤُتِينَا نِغ ذ ڒْبَارَّانِي إِي ذَايس يزذْغن سْعدُّوْن مَارَّا ڒْوقْث نْسن ذݣ وَاوَاڒ نِغ ذݣ وصنّط ن شَان ڒْحَاجث ذ جْذِيذ.)<verse eid="ACT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22" />ڒخْدّنِّي يبدّ بُوْلُس ذِي ڒْوسْط ن لْمَجْلِس ينَّا-ٱسن: "آي يرْيَازن ن ؤُتِينَا، نش تْوَاڒِيغ كنِّيو ثْشغْڒم اَطَّاس ذِي دِّين. <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />أَخْمِي تْسَارِيغ نش، خزَّرغ مْلِيح ذِي زَّاوْيَاث نْوم مَانِي ثْعبّْذم. ࢲْرِيغ ذِنِّي يجّن ن ڒْمذْبَح ؤُرِينْت ذَايس ثِيْرَا، ثِيْرَا نِّي قَّارنْت: <char style="bd">أَربِّـي نِّي إي وَار يتْوَاسّْنن شَا</char>. شُوْف، أَربِّـي نِّي إِي ثْعبّْذم كنِّيو وَار ث ثسِّينم شَا، أَذَاوم ينِيغ نش مِين يعْنَا. <verse eid="ACT 17:23" /><verse number="24" style="v" sid="ACT 17:24" />ئِخْڒق-د دُّنشْت-أَ ذ مَارَّا مِين ذَايس، نتَّا ذ سِيذِي أَربِّـي ن وجنَّا ذ ثْمُوْرْث. وَار يزدّغ شَا ذِي زَّاوْيَاث نِّي إِݣ بنَّان يِوْذَان س يفَاسّن نْسن. <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />وَار خَاس تْسخِّيرن شَا يفَاسّن ن بْنَاذم، نتَّا وَار يتحْذِيجِي وَالُو. ذ نتَّا إِي د يتِيشّن إِ مَارَّا يوْذَان ثُوْذَارْث ذ بُوْحْبڒ ذ مَارَّا ثِمسْڒَايِين نّغْنِي. <verse eid="ACT 17:25" /><verse number="26" style="v" sid="ACT 17:26" />زݣ يِجّن ن بْنَاذم إِي زِي د يخْڒق مَارَّا ڒݣْنُوْس بَاش اَذ زذْغن ذِي دُّنشْت-أَ اَمن-ثكْمَاڒ. ئِحدّ-اَسن نْهُوْرَاث ن تَّارِيخ نْسن ذ مَانِي إِي غَا زذْغن. <verse eid="ACT 17:26" /><verse number="27" style="v" sid="ACT 17:27" />يݣَّا-ٱسن اَمُّو أَربِّـي حمَا يوْذَان اَخَاس رْزُوْن اَغَارس سْوِيزّْذن س يفَاسّن نْسن اَث اَفن. إِنَّمَا، نتَّا كُڒ يجّن زَّايْنغ وَار خَاس يݣّْوِيج شَا. <verse eid="ACT 17:27" /><verse number="28" style="v" sid="ACT 17:28" />زَّايس نتَّا إِي ندَّر، زَّايس نتَّا إِي نْتنْهزَّا، زَّايس نتَّا إِي ندْجَا. مَامّش نَّان ؤُڒَا ذ ڒبْعَاض ن شُّعَرَاء نْوم قَا نشِّين ذ ثَارْوَا نّس.<verse eid="ACT 17:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 17:29" />شُوْف، نشِّين مڒَا ذ ثَارْوَا ن أَربِّـي، ئِتْخصَّا-يَانغ وَار نتْفكِّير شَا بلِّي ونِّي يُوْعْڒَان قَا نتَّا اَم دّْهب نِغ اَم نُّقَارْث نِغ اَم وزْرُو. أَربِّـي وَار يدْجِي شَا ذ لْأَصْنَام إِݣ يتْصنَّاع بْنَاذم س لْفِكْرَا نّس ذ ثْزمَّار نّس. <verse eid="ACT 17:29" /><verse number="30" style="v" sid="ACT 17:30" />مَانَايَا أَربِّـي وَار ت يُوْوِي شَا ذِي زْمَان ن ڒقْفَاڒث، وَلَكِن ڒخُّو يُوْمَر مَارَّا يوْذَان ذِي مْكُڒ اَمْشَان بَاش اَذ تُوْبن. <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />مَايمِّي؟ أَربِّـي يزمّم يجّن ن نْهَار إِي ذِي غَا يحَاسب مَارَّا يوْذَان س ڒْحَقّ خ وفُوْس ن بْنَاذم نِّي إِݣ يخْضَر. يُوْشَا-ٱسن دَّلِيل إِ مَارَّا يوْذَان خ مَانَايَا وَامِي ثِيذ يسكَّر زِي ڒْموْث."<verse eid="ACT 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32" />يِيْنَا وَامِي تسْڒَان خ يِوْذَان اَذ د كَّرن زِي ڒْموْث ذِي لْقِيَامَا ضحْشن ڒبْعَاض خَاسن، وَلَكِن ڒبْعَاض نّغْنِي نَّان-اَس قَا نشِّين نخْس اَذَاش نْصنّط ثْوَاڒَا نّغْنِي خ مَانَايَا. <verse eid="ACT 17:32" /><verse number="33" style="v" sid="ACT 17:33" />سّنِّي يفّغ بُوُلُس زِي ڒْوسْط نْسن. <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />ڒبْعَاض زَّايْسن ؤُمْنن مُوْنن اَك بُوْلُس. زَّايْسن دِيُوْنِيسْيُوْس زِي لْمَجْلِس ن أَرْيُوْبَاݣُوْس ذ يِجّن ن ثمْغَارْث قَّارن-اَس دَامَارِيس ذ ينّغْنِي اَكِذْسن.<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="s">أَرَّسُوْل بُوْلُس ذِي ثنْدِينْت ن كُوْرِينْث</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />منْبَعْد يفّغ بُوْلُس زِي ثنْدِينْت ن ؤُتِينَا يرُوْح غَار ثنْدِينْت ن كُوْرِينْث. <verse eid="ACT 18:1" /><verse number="2‏-3" style="v" sid="ACT 18:2-3" />يُوْفَا ذِنِّي يجّن ن وئِسْرَائِيلِي نتَّا ذ مِّيس ن لْإِقْلِيم ن پُـنْطُس قَّارن-اَس أَكِيلَاس. نتَّا تُوْغَا يُوْسَا-د ذݣ وُوْسَّان نِّي زِي ثْمُوْرْث ن إِطَاليَا نتَّا ذ ثمْغَارْث نّس ؤُمي قَّارن پْـرِسْكِيلَا. لِأَنَّا لْمَلِك كْلُوْدْيُوْس تُوْغَا يُوْمَر خ مَارَّا أَيث-إِسْرَائِيل اَثن سُوْفْغن زِي رُوْمَا. ئِرُوْح بُوْلُس غَار وَاكِيلَاس ذ پْـرِسْكِيلَا اَثن يࢲر. ئِقِّيم اَكِذْسن، ئِخدّم اَكِذْسن مِنْزِي نِثْنِي ڒْخذْمث نْسن ذ يشْتن تݣّن يقِيظَان. <verse eid="ACT 18:2-3" /><verse number="4" style="v" sid="ACT 18:4" />مْكُڒ نْهَار ن سّبْث ن لْعِبَادَا بُوْلُس يتمْنَاقَاش اَك أَيث-إِسْرَائِيل ذ ييُوْنَانِيْين ذِي ثمْزِيذَا بَاش اَثن يسقْنع. <verse eid="ACT 18:4" /><verse number="5" style="v" sid="ACT 18:5" />وَامِي د يخْضڒ سِيلَاس ذ تِيْمُوْتَاوُس زِي لْإِقْلِيم ن مَاسِدُوْنْيَا، ئِبْذَا بُوْلُس يخدّم غِير س تّبْشِير أُو صَافِي، ئِشهّذ إِ أَيث-إِسْرَائِيل بلِّي عِيْسَى نتَّا ذ لْمَسِيح. <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />وَامِي بْذَان تْعَارَّاضن-اَس تْبُوْصَارن خَاس، ئِمْسح اَرُّوْض نّس <char style="it">اَم يِجّن ن شْهَاذث</char> خَاسن ينَّا-ٱسن: "ئِذَامّن نْوم خ يِيڒَاون نْوم، قَا نش تْبرِّيغ اَزدْجِيف ينُو زَّايْوم. سَّا ٱڒ ثْسَاونْت اَذ رَاحغ غَار يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل."<verse eid="ACT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 18:7" />ئِفّغ-د سّنِّي يرُوْح غَار ثدَّارْث ن يِجّن ورْيَاز يعبّْذن أَربِّـي قَّارن-اَس تِيتُوْس يُوْسْتُوْس، ثَدَّارْث نّس اَقَات طَّارْف إِ ثمْزِيذَا نِّي. <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" />ڒفْقِي ن ثمْزِيذَا نِّي قَّارن-اَس كْرِيسْپُـوْس، يُوْمن س سِيذِيثْنغ نتَّا ذ مَارَّا ڒحْبَاب نّس. خَربِّي ن يِوْذَان زِي ثنْدِينْت ن كُوْرِينْث وَامِي سْڒِين <char style="it">إِ وَاوَاڒ ن بُوْلُس</char>، ؤُمْنن تْوَاطهَّارن س وَامَان.<verse eid="ACT 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9" />ئِجّن ن دْجِيڒث يُوْحَا-يَاس-د سِيذِي أَربِّـي إِ بُوْلُس ينَّا-ٱس: "وَار تݣّْوذ شَا، سِيوڒ وَار سْتُوْكَا شَا. <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" />نش اَقَايِي اَكِذش، شك وَار ش يتْضَرِّي حَدّ زݣ يِنِّي خَاك د غَا يهجْمن مِينْزِي نش غَارِي اَطَّاس ن شَّعْب ينُو ذِي ثنْدِينْت-أَ." <verse eid="ACT 18:10" /><verse number="11" style="v" sid="ACT 18:11" />ئِقِّيم ذِنِّي بُوْلُس عَام أُو ستّ-شْهُور يسڒْمَاذ نتَّا اَوَاڒ ن أَربِّـي إِ يِوْذَان.<verse eid="ACT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />وَلَكِن ذِي ڒْوقْث نِّي ن ݣَالْيُوْن لْعَامِل ن لْإِقْلِيم ن ؤُخَايَا، مُوْنن يسْرَائِيلِيْين هجْمن خ بُوْلُس ؤُوِين-ث غَار لْمَحْكَامَا. <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />نَّان اَرْيَاز-أَ يسْقنّع يوْذَان اَذ عبْذن أَربِّـي ضد إِ ڒْقَانُوْن. <verse eid="ACT 18:13" /><verse number="14" style="v" sid="ACT 18:14" />وَامِي عْڒَاين اَذ يسِّيوڒ بُوْلُس يكَّر لْعَامِل ݣَالْيُون ينَّا-ٱسن إِ يسْرَائِيلِيْين نِّي: "مَعْلِيك ثْشثْشَام خ شَان ن شَّرّْ نِغ خ شَان ن لْجَرِيمَا ذ ثَعفَّانْت، أَتَاف غَارْوم ڒْحَقّ اَغَارْوم صنّْطغ. <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />وَلَكِن مَانَايَا ذ لْخِلَاف جَارَاوم كنِّيو ذݣ وَاوَاڒن ذ يِيسمَاون ذ شَّرِيعَا نْوم. حلّم مَانَايَا نِّيث جَارَاوم. بْڒَا مَا ٱذ يڒيِغ نش ذ ڒْقَاضِي خ ثْمسْڒَايِين-أَ جَارَاوم." <verse eid="ACT 18:15" /><verse number="16" style="v" sid="ACT 18:16" />سّنِّي يُوزّڒ-د خَاسن زِي لْمَحْكَامَا. <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />كَّرن مَارَّا إِذْسن طّْفن سَاسْتِين رفْقِي ن ثمْزِيذَا ن أَيث-إِسْرَائِيل ؤُوْثِين-ث زَّاث إِ لْمَحْكَامَا. ݣَالْيُوْن نتَّا وَار ث يشْقِي شَا مَانَاينِّي قَاع.<verse eid="ACT 18:17" /></para>
  <para style="s">ئِتعْقَاب اَرَّسُوْل بُوْلُس غَار وَانْطَاكْيَا</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />ئِقِّيم عَاذ بُوْلُس اَطَّاس ن وُوْسَّان ذِي ثنْدِينْت ن كُوْرِينْث. سّنِّي يمْسَافَاض خ اَيثْمَاس ذِنِّي، ئِنْيَا ذݣ ؤُغَرَّابُو يرُوْح غَار سُوْرْيَا اَكِذس پْـرِسْكِيلَا ذ وَاكِيلَاس. تُوْغَا يحفّ بُوْلُس اَشوَّاف نّس ذِي <char style="it">ڒمْوِيِّـي ؤُمِي قَّارن</char> كَنْغَرْيَا مِينْزِي تُوْغَا خَاس ڒْعَهذ <char style="it">إِي يݣَّا اَك سِيذِي أَربِّـي</char>. <verse eid="ACT 18:18" /><verse number="19" style="v" sid="ACT 18:19" />ؤُوْضن غَار ثنْدِينْت ن ؤُفَسُوْس، يجَّا بُوْلُس ذِنِّي <char style="it">پْـرِسْكِيلَا ذ وَاكِيلَاس</char>، سّنِّي يُوْذف غَار ثمْزِيذَا بَاش اَذ يمْنَاقَاش اَك يسْرَائِيلِيْين. <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />تَّارن زَّايس يسْرَائِيلِيْين-أَ اَذ يقِّيم عَاذ كْتَار وَلَكِن نتَّا يُوْݣِي. <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />وَامِي خَاسن يمْسَافَاض ينَّا-ٱسن قَا مڒَا يخس أَربِّـي، عَاذ ٱذ د عقْبغ. سّنِّي ينْيَا ذݣ ؤُغَرَّابُو يفّغ زِي ثنْدِينْت نِّي ن ؤُفَسُوْس. <verse eid="ACT 18:21" /><verse number="22" style="v" sid="ACT 18:22" />وَامِي يُوْوض غَار ثنْدِينْت ن قَيْصَارِيَا، ئِݣَعّذ <char style="it">غَار لْقُدْس</char> يسدْجم خ جْمَاعث ن ڒْمُوْمِنِين، سّنِّي يُوْيُوْر غَار ثنْدِينْت ن وَانْطَاكْيَا. <verse eid="ACT 18:22" /><verse number="23" style="v" sid="ACT 18:23" />وَامِي إِي ذَايس يكَّا شَان ڒْوقْث، ئِفّغ يعْذُو ذِي جْوَايه ن ݣَالَاطْيَا ذ جْوَايه ن فْرِيجْيَا يتݣّ ؤُڒ ذݣ يمحْضَارن نِّي إِي يدْجَان ذِنِّي مَارَّا.<verse eid="ACT 18:23" /></para>
  <para style="s">أَپُـوْلُوْس يتْبشَّار ذِي ثنْدِينْت ن ؤُفَسُوْس ذ لْإِقْلِيم ن ؤُخَايَا</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />ئِجّن ن ؤُئِسْرَائِيلِي قَّارن-اَس أَپُـوْلُوْس نتَّا يخْڒق ذِي ثنْدِينْت ن إِسْكَنْدَارِيَا، يُوْسَا-د غَار ثنْدِينْت ن ؤُفَسُوْس. نتَّا يفْسُوْس ذݣ وَاوَاڒ يغْرَا اَطَّاس ذِي لْكُتُب. <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />أَرْيَاز-أَ يڒْمذ خ وبْرِيذ ن سِيذِيثْنغ، ئِسَّاوَاڒ س جّْهذ ذ اَمقّْرَان، ئِسڒْمَاذ نِيشَان خ عِيْسَى. وَلَكِن يسّن غِير خ وطهَّار نِّي ن وَامَان إِݣ يسخْذم نَّبِي يَحْيَى. <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />ئِبْذَا يسَّاوَاڒ ذِي ثمْزِيذَا ن أَيث-إِسْرَائِيل س زْعَامث. سْڒِين-اَس پْـرِسْكِيلا ذ وَاكِيلَاس، ؤُوِين-ث اَكِذْسن غَار ثدَّارْث نْسن بْذَان سْفهَّامن-ث حْسن خ وبْرِيذ ن أَربِّـي.<verse eid="ACT 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 18:27" />وَامِي يخس أَپُـوْلُوْس اَذ يسَفَر غَار لْإِقْلِيم ن ؤُخَايَا، شجّْعن-ث اَيثْمَاس ؤُرِين-اَسن يجّن ن ثبْرَات إِ يمحْضَارن نِّي ن ذِنِّي بَاش اَزَّايس رحْبن. وَامِي يُوْوض <char style="it">غَار لْإِقْلِيم نِّي</char> يعَاون اَطَّاس يِنِّي يُوْمْنن س اَرْضَا ن أَربِّـي. <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />لِأَنَّا نتَّا يتمْنَاقَاش س جّْهذ اَك يسْرَائِيلِيْين زَّاث إِ يِوْذَان، نِثْنِي وَار زمَّرن شَا اَث جَاوْبن نِيشَان مِينْزِي يسْبيّن-اَسن-د اَوَاڒن زِي لْكُتُب بلِّي نتَّا عِيْسَى ذ لْمَسِيح.<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="s">أَرَّسُوْل بُوْلُس يتْحدَّاث ذِي ثنْدِينْت ن ؤُفَسُوْس</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />أَپُـوْلُوْس وَامِي يدْجَا ذِي ثنْدِينْت ن كُوْرِينْث <char style="it">ذِي لْإِقْلِيم ن ؤُخَايَا</char>، ئِكَّر <char style="it">اَرَّسُوْل</char> بُوْلُس يكَّا خ وبْرِيذ ن يذُوْرَار يُوْوض غَار ثنْدِينْت ن ؤُفَسُوْس. يُوْفَا ذِنِّي شَان يمحْضَارن <verse eid="ACT 19:1" /><verse number="2" style="v" sid="ACT 19:2" />ينَّا-ٱسن: "مَا يهْوَا-د خَاوم أَرُّوْح يقدّْسن وَامِي ثُوْمْنم؟"</para>
  <para style="p" vid="ACT 19:2">نَّان-اَس: "لَّا، نشِّين عمَّارْص وَار خَاس نسْڒِي شَا خ أَرُّوْح يقدّْسن."<verse eid="ACT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 19:3" />ينَّا-ٱسن: "مَامّش ثݣِّيم وَامِي ثْتْوَاطهَّارم س وَامَان؟"</para>
  <para style="p" vid="ACT 19:3">نَّان-اَس: "نشِّين نتْوَاطهَّار س وَامَان عْلَاحْسَاب مَامّش يخدّم نَّبِي يَحْيَى."<verse eid="ACT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 19:4" />ينَّا-ٱسن بُوْلُس: "قَا يَحْيَى يتْطهَّار س وَامَان إِ يِنِّي يتُوْبن، ئِقَّار-اَسن اَمْنث زݣ ونِّي إِي د غَا يَاسن منْبَعْد إِ نش، يعْنِي عِيْسَى." <verse eid="ACT 19:4" /><verse number="5" style="v" sid="ACT 19:5" />سْڒِين إِ مَانَايَا رُوْحن تْوَاطهَّارن س وَامَان عْلَاحْسَاب يسم ن سِيذِيثْنغ عِيْسَى. <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />وَامِي خَاسن يسرْس بُوْلُس يفَاسّن نّس، ئِهْوَا-د خَاسن أَرُّوْح يقدّْسن. بْذَان سَّاوَاڒن س لُّغَاث <char style="it">وَار يدْجِين بُو نْسن</char>، سَّاوَاڒن س مِينْزِي عڒْمن زِي أَربِّـي. <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />يرْيَازن نِّي نِثْنِي شَان ثنْعَاش إِذْسن.<verse eid="ACT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8" />سّنِّي بُوْلُس يُوْذف غَار ثمْزِيذَا ن أَيث-إِسْرَائِيل، ئِسَّاوَاڒ ذِنِّي س زْعَامث شَان ن ثڒْت-شْهُوْر. ئِتمْنَاقَاش اَكِذْسن بَاش اَثن يسقْنع خ ڒْمُلْك ن أَربِّـي. <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" />ڒبْعَاض زَّايْسن طّْفن اَكِذس ثَغنَّانْت ؤُݣِين اَذ اَمْنن، تُوْكَّارن ذِي تَّعْلِيم ن سِيذِيثْنغ زَّاث إِ يِوْذَان. سّنِّي يفّغ-د بُوْلُس زِي ثمْزِيذَا نِّي يُوْوِي اَكِذس يمحْضَارن نّس، كُڒ نْهَار يسڒْمَاذ-يثن ذِي لْمَرْكز ن تِيرَانُّوْس. <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />ئِقِّيم بُوْلُس يتݣّ مَانَاينِّي عَامَاين. مَارَّا يمزْذَاغ ن لْإِقْلِيم ن آسْيَا سْڒِين إِ وَاوَاڒ ن سِيذِي أَربِّـي، أَيث-إِسْرَائِيل ذ ييُوْنَانِيْين س ثْنَاين إِذْسن.<verse eid="ACT 19:10" /></para>
  <para style="s">ثَارْوَا ن ڒفْقِي قَّارن-اَس سْكِيـبَا</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11" />أَربِّـي يتݣّ لْمُعْجِيزَاث ذ ثِيمقّْرَانِين خ وفُوْس ن بُوْلُس. <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />ئِوْذَان كسِّين ڒزْيُوْف ذ ثِبَانْتِيوِين تْحَاذَان زَّايْسنْت بُوْلُس سْرُوْسَان-ثنْت خ يمهْڒَاش. ڒخْدّنِّي ڒهْرَاشَاث نِّي تْݣنْفَان، عَاوذ تفّْغن زَّايْسن جْنُوْن نِّي يعفَّانن إِي ذَايْسن.<verse eid="ACT 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 19:13" />ذِنِّي شَان يسْرَائِيلِيْين نِثْنِي ذ يسحَّارن تْرَاحن زݣ ومْشَان غَار ومْشَان. تْجَرَّابن اَذ سْخذْمن يسم ن سِيذِيثْنغ عِيْسَى بَاش اَذ سُوْفْغن جْنُوْن يعفَّانن زݣ يِوْذَان. نَّان-اَسن قَا تْأَمَرغ-كنِّيو عْلَاحْسَاب يسم ن عِيْسَى إِي زِي يتْحدَّاث بُوْلُس، فّْغث! <verse eid="ACT 19:13" /><verse number="14" style="v" sid="ACT 19:14" />أَمنِّي إِي تݣّن يجّن ن سبْعَا ن ثَارْوَا ن يِجّن ن ؤُئِسْرَائِيلِي قَّارن-اَس سْكِيـبَا، نتَّا زِي اَرُّوْيَاس ن ڒْفُقَهَا.<verse eid="ACT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 19:15" />ئِجّن ن نْهَار ينْدق-د جّنّ نِّي اَعفَّان ينَّا-ٱسن قَا نش سّْنغ عِيْسَى مِين يعْنَا، سّْنغ بُوْلُس مِين يعْنَا، كنِّيو مِين ثعْنَام؟ <verse eid="ACT 19:15" /><verse number="16" style="v" sid="ACT 19:16" />ڒخْدّنِّي ينْظو خَاسن ورْيَاز نِّي إِي ذِي يدْجَا جّنّ اَعفَّان يغْڒب-يثن مَارَّا يجْهذ خَاسن. اَروْڒن زِي ثدَّارْث نِّي ذ يعَرْيَانن جَرّْحن. <verse eid="ACT 19:16" /><verse number="17" style="v" sid="ACT 19:17" />أَرِّين-اَسن-د ڒخْبَار مَارَّا يمزْذَاغ ن ؤُفَسُوْس، يعْنِي أَيث-إِسْرَائِيل ذ ييُوْنَانِيْين س ثْنَاين إِذْسن. ثڒْقف-يثن ثِيݣّْوْذِي أُوْشَا يتْوَاسمْغَار يسم ن سِيذِيثْنغ عِيْسَى اَطَّاس.<verse eid="ACT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 19:18" />ؤُسِين-د اَطَّاس زݣ يِنِّي إِي يُوْمْنن ڒخُّو، ڒخْذَايم نْسن إِي تُوْغَا ݣِّين ثِعفَّانِين عْتَارْفن زَّايْسنْت. <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" />أَطَّاس ن يِوْذَان تُوْغَا ݣِّين سّْحُوْر ؤُوِين-د لْكُتُب نْسن سْحَرّْقن-ثن غَار بَرَّا زَّاث إِ كُڒْشِي. وَامِي حسْبن تَّمَن ن لْكُتُب نِّي، ؤُفِين خمْسِين اَڒَاف ن دِّينَار. <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" />أَمنِّي اَوَاڒ ن سِيذِي أَربِّـي يتنْتَاشر يَرنِّي غَارس جّْهذ اَطَّاس.<verse eid="ACT 19:20" /></para>
  <para style="s">توْقِيع يجّن ن ڒْفَوْضَا ذِي ثنْدِينْت ن ؤُفَسُوْس</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />منْبَعْد إِ مَانَايَا، يعوّڒ بُوْلُس اَذ يسَفَر غَار لْقُدْس، أَذ يكّ خ لْإِقْلِيم ن مَاسِدُوْنْيَا ذ لْإِقْلِيم ن ؤُخَايَا. ينَّا: خْمِي غَا اَوْضغ ذِنِّي، ئِتْخصَّا-ٱيِي عَاوذ اَذ رَاحغ غَار ثنْدِينْت ن رُوْمَا! <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />ئِسّكّ غَار مَاسِدُوْنْيَا ثْنَاين زݣ يِنِّي إِي ث يتْعَاوَانن يجّن قَّارن-اَس تِيْمُوْتَاوُس يجّن قَّارن-اَس أَرِيسْطُوْس، نتَّا بُوْلُس يقِّيم يجّن ن ڒْوقْث ذِي لْإِقْلِيم ن آسْيَا.<verse eid="ACT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />ذِي ڒْوقْث نِّي ثوْقع يجّن ن ڒْفَوْضَا ثمْغَار خ سَّبَاب ن وبْرِيذ <char style="it">ن سِيذِيثْنغ</char>. <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />ذِنِّي يجّن ن ورْيَاز قَّارن-اَس دِمِيتْرِيُوْس. نتَّا يضبَّاع نُّقَارْث، ئِتْصنَّاع مُوْنِيكُوْث س نُّقَارْث يتمْشَابَّاهن ذِي زَّاوْيِث ن لْأَصْنَام ؤُمِي قَّارن ثَارْطَمِيسْت. دِمِيتْرِيُوْس-أَ يسْربَّاح اَطَّاس يِيْنَا يتْصنَّاعن مُوْنِيكُوْث-أَ. <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />يڒَاغَا-د خ يِنِّي يخدّْمن ذِي مَانَاينِّي ذ يِنِّي يتْصنَّاعن ثِمسْڒَايِين نّغْنِي اَمنِّي. ينَّا-ٱسن: "آي يرْيَازن، ثسّْنم بلِّي نْربّح اَطَّاس ن تْمنْيَاث ذِي صّنْعَاث-أَ. <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />أَقَا تْوَاڒَام تسْڒَام بُوْلُس-أَ يسْقنّع اَطَّاس ن يِوْذَان ذِي ثنْدِينْت-أَ ن ؤُفَسُوْس عْڒَاين ؤُڒَا ذِي مَارَّا لْإِقْلِيم ن آسْيَا، ئِسُوْفُوْغ-يثن زݣ وبْرِيذ نّغ. ئِقَّار-اَنغ قَا لْأَصْنَام-أَ يتْوَاصنْعن س يفَاسّن قَا وَار دْجِين شَا ذ أَربِّـيثن. <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />خَطَر مَانَايَا خ صّنْعَاث نّغ اَتَاف وَار غَارس بُو لْقِيمَا. خَطَر عَاوذ ؤُڒَا خ زَّاوْيِث ثَمقّْرَانْت ن أَربِّـي نّغ ثَارْطَمِيسْت اَتَاف اَذ تْنقْضع. أَتَاف نتَّاث عَاوذ يمْكن وَار ذَايس تْغِيمِي لْعَظَمَا نّس قَاع، ثَانِيتَا إِي عبّْذن يمزْذَاغ ن لْإِقْلِيم-أَ ن آسْيَا مَارَّا ذ دُّنشْت اَمن-ثكْمَاڒ."<verse eid="ACT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28" />وَامِي سْڒِين إِ وَاوَاڒ-أَ، غضْبن اَطَّاس سْنكَّرن ثْغُوْيّث قَّارن ثَارْطَمِيسْت ن أَيث-ؤُفَسُوْس مشْحَاڒ ثمْغَار! <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />ثوْقع يجّن ن ڒْفَوْضَا ذ ثَمقّْرَانْت ذِي ثنْدِينْت نِّي اَمن-ثكْمَاڒ. مُوْنن يِوْذَان-أَ ؤُزّْڒن غَار فُوْرْبُو جَرّن اَكِذْسن ثْنَاين ن يمدُّوْكَاڒ ن بُوْلُس إِي كِذس يتْسَفَارن، ئِجّن قَّارن-اَس غَايُوْس يجّن قَّارن-اَس أَرِيسْتَارْخُوْس، نِثْنِي زِي أَيث-مَاسِدُوْنْيَا. <verse eid="ACT 19:29" /><verse number="30" style="v" sid="ACT 19:30" />يرزُّو بُوْلُس اَذ يحْضَار زَّاث إِ ڒْغَاشِي نِّي، وَار ث جِّين شَا يمحْضَارن نّس. <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />حتَّا شَان ن يمْخَازْنِيْين ذ يمقّْرَانن زِي لْإِقْلِيم نِّي ن آسْيَا إِي دْجَان ذ يمدُّوْكَاڒ ن بُوْلُس سّكّن غَارس تَّارن زَّايس نَّان-اَس وَار تْرَاح شَا غَار فُوْرْبُو نِّي.<verse eid="ACT 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 19:32" />مْخَرْوَاضن مَارَّا يوْذَان إِي ذِنِّي يمُوْنن، سْنكَّرن ثْغُوْيّث كُڒ يجّن مِين يقَّار. أَزْين اَمقّْرَان وَار يسِّين مِيخف ذِين مُوْنن. <verse eid="ACT 19:32" /><verse number="33" style="v" sid="ACT 19:33" />ذِنِّي جَار ڒْغَاشِي نِّي يجّن ن بْنَاذم قَّارن-اَس إِسْكَنْدر. عَانن-ث يسْرَائِيلِيْين غَار زَّاث، ڒَاغَان-اَس-د ڒبْعَاض زَّايْسن حمَا اَذ يسِّيوڒ. ئِتْشيَّار-اَسن إِ ڒْغَاشِي نِّي س يفَاسّن يرزُّو اَثن يسْبدّ بَاش اَذ يذَافع س يِجّن ن وَاوَاڒ. <verse eid="ACT 19:33" /><verse number="34" style="v" sid="ACT 19:34" />وَامِي ࢲْرِين ڒْغَاشِي نِّي نتَّا ذ اَئِسْرَائِيلِي، مُوْنن مَارَّا إِذْسن شَان ثْنَاين ثْسَعَّاثِين سْنكَّرن ثْغُوْيّث نَّان ثَارْطَمِيسْت ن اَيث-ؤُفَسُوْس مشْحَاڒ ثمْغَار!<verse eid="ACT 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35" />يُوْسَا-د نَائِب ن لْحَاكم ن ثنْدِينْت يهدّن ڒْغَاشِي نِّي ينَّا-ٱسن: "آي يرْيَازن ن ؤُفَسُوْس، مَا ذِنِّي شَا حَدّ إِي وَار يسِّينن شَا بلِّي ثَنْدِينْت-أَ ن ؤُفَسُوْس ذ نتَّاث إِي يحطَّان زَّاوْيِث ن ثَارْطَمِيسْت ثَمقّْرَانْت ذ وزْرُو نّس اَمْقدّس إِي د يوْضَان زݣ وجنَّا؟ <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />مَانَايَا وَار ذَايس بُو شّكّ. إِذن يتْخصَّا كنِّيو اَذ تْهدّْنم، وَار خدّْمث شَا بْڒَا ڒَعْقڒ. <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />ثُوِيم-د ذَانِيتَا يرْيَازن-أَ، وَار خوّْنن شَا زَّاوْيَاث وَار نِّين بُو ڒْعِيب ذِي أَربِّـي نّغ. <verse eid="ACT 19:37" /><verse number="38" style="v" sid="ACT 19:38" />مڒَا يخس دِيمِيتْرِيُوْس ذ يِنِّي إِي كِذس يتْصنَّاعن <char style="it">نُّقَارْث</char> اَذ شثْشَان خ شَان يِجّن، أَقَا لْمَحْكَامَا مُوْجُوْد أُو لْعَامِل مُوْجُوْد اَذ رَاحن اَذ شثْشَان س ڒْقَانُوْن. <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />مڒَا غَارْوم شَا وشثْشِي نّغْنِي، أَخَاس حكْمن ذِي لْمَجْلِس ن ثنْدِينْت. <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />ڒخُّو اَقَانغ ذِي لْخَطَر أَ نتْوَاحْكم مَارَّا إِذْنغ خ ڒْفَوْضَا يتوْقِيعن نْهَارَا، نشِّين وَار غَارْنغ بُو شَان ن سَّبَاب خ سّْدَع-أَ." <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />وَامِي ينَّا اَوَاڒ-أَ يسّكّ يِنِّي يمُوْنن اَذ روّْحن.<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="s">أَرَّسُوْل بُوْلُس اَقَاث ذِي لْيُوْنَان ذ لْإِقْلِيم ن مَاسِدُوْنْيَا</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />ثْكمّڒ ڒْفَوْضَا نِّي، منْبَعْد بُوْلُس يڒَاغَا-د خ يمحْضَارن يشجّع-يثن. سّنِّي يمْسَافَاض خَاسن، ئِرُوْح يسَفَر غَار لْإِقْلِيم ن مَاسِدُوْنْيَا. <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />ئِتْشجَّاع يمحْضَارن ذِنِّي س وَاطَّاس ن وَاوَاڒن. وَامِي يعْذُو ذِي جْوَايه نِّي، يُوْوض غَار لْيُوْنَان <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />يكَّا ذِنِّي ثڒْت-شْهُوْر. وَامِي عْڒَاين اَذ ئِني بُوْلُس ذݣ وغَرَّابُو اَذ يرَاح غَار سُوْرْيَا، شِيطّْنن يسْرَائِيلِيْين بَاش اَث نْغن. خ مَانَايَا نتَّا يݣَّا اَذ يعْقب خ وبْرِيذ ن مَاسِدُوْنْيَا. <verse eid="ACT 20:3" /><verse number="4" style="v" sid="ACT 20:4" />ئِسَفَر اَكِذس سُوْپَـاتْرُوْس مِّيس ن پِـيْرُو زِي ثنْدِينْت ن بِيْرْيَا، ذ أَرِيسْتَارْخُوْس ذ سَاكُوْنْدُوْس نِثْنِي زِي ثنْدِينْت ن سَالُوْنِيك، ذ غَايُوْس زِي ثنْدِينْت ن دِرْبَا، ذ تِيْمُوْتَاوُس ذ تُوْشِيق ذ تْرِيْفُوْمُو نِثْنِي زِي لْإِقْلِيم ن آسْيَا. <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />يِيْنَا يزْوَارن-اَنغ تْرَجَان-اَنغ ذِي ثنْدِينْت ن تْرَاوْس. <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />وَامِي يعْذُو ڒْعِيذ ن ثفْضِيرْث، ننْيَا ذݣ ؤُغَرَّابُو نفّغ زِي ثنْدِينْت ن فِيلِيپِّـي. منْبَعْد إِ خمْسِيَّام نذْفَار-يثن غَار ثنْدِينْت ن تْرَاوْس، نقِّيم ذِنِّي سبْعِيَّام.<verse eid="ACT 20:6" /></para>
  <para style="s">أَرَّسُوْل بُوْلُس يسكَّر-د يجّن ن وحنْجِير ‬زِي ڒْموْث</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />ذݣ وَاسّ اَمزْوَارُو ن سِيمَانَا<note caller="+" style="f"><char style="fr" closed="false">20‏.7 </char><char style="ft" closed="false">عْلَاحْسَاب تَقَالِيد ن يسْرَائِيلِيْين، مَانَايَا يوْقع نْهَار ن سّبْث س دْجِيڒث. عْلَاحْسَاب تَقَالِيد ن ييُوْنَانِيْين، ئِوْقع نْهَار ن ڒْحَد س دْجِيڒث.</char></note> نْمُوْن نشِّين أَ نشّ اَغْرُوْم، ئِسِّيوڒ بُوْلُس اَك يِوْذَان. ئِقِّيم يسَّاوَاڒ اَڒ ؤُزْين ن دْجِيڒث مِينْزِي ثِيوشَّا نّس ينْوَا ٱذ يسَفَر. <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />ذِنِّي اَطَّاس ن ڒقْنَاذڒ ذِي ثْغُوْرْفَات نِّي مَانِي نْمُوْن. <verse eid="ACT 20:8" /><verse number="9" style="v" sid="ACT 20:9" />ذِنِّي يجّن ن وحنْجِير قَّارن-اَس يُوْتِكُوْس يقِّيم نتَّا خ ثنْهَارْث ن ثْبُوْرْجَات.<note caller="+" style="f"><char style="fr" closed="false">20‏.9 </char><char style="ft" closed="false">ثَنْهَارْث ن ثْبُوْرْجَات قَّارن-اَس عَاوذ بَاذُو ن ڒْكَازِي نِغ اَݣدِّيم ن سَارْجم.</char></note> يڒْهَا بُوْلُس يتمْهَارْوَاض، أَحنْجِير نِّي يطّف-يث يِضص يغلّب خَاس يِيضص نِّي أُوْشَا يوْضَا زِي ثْڒَاثَا ن طّْبَقَاث اَڒ ثْمُوْرْث ؤُفِين-ث يمُّوْث. <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />ئِهْوَا-د بُوْلُس يُوْذَاڒ غَارس ييْسِي-يث-يذ س يفَاسّن. ينَّا-ٱسن: وَار تݣّْوْذم شَا، أَقَا يعْقب-اَس-د بُوْحْبڒ نّس. <verse eid="ACT 20:10" /><verse number="11" style="v" sid="ACT 20:11" />ئِرُوْح بُوْلُس يݣَعّذ سنّج، يرْزَا اَغْرُوْم يشَّا. ئِسِّيوڒ اَطَّاس اَڒ وَامِي ذ ڒفْجَر يكَّر يُوْيُوْر. <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />ئِوْذَان نِّي تْوَاشجّْعن اَطَّاس وَامِي اَحنْجِير نِّي سْروّْحن-ث يدَّر.<verse eid="ACT 20:12" /></para>
  <para style="s">أَرَّسُوْل بُوْلُس يتْسَفَر زِي تْرَاوْس غَار مِيلِيتُوْس</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />ئِتَافق بُوْلُس اَكِذْنغ بَاش نشِّين أَ نْسَفَر غَار ثنْدِينْت ن وَاسُّوْس ذݣ وغَرَّابُو نتَّا اَذ د يَاس خ يضَارن، منْبَعْد أَ نمْسڒْقَا ذِنِّي اَث نسْني اَكِذْنغ ذݣ وغَرَّابُو. <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />وَامِي خَانغ د يحْرث ذِي ثنْدِينْت ن وَاسُّوْس، نسْني-يث-يذ اَكِذْنغ ذݣ وغَرَّابُو نْرُوْح غَار ثنْدِينْت ن مِيتِيلِينِي. <verse eid="ACT 20:14" /><verse number="15" style="v" sid="ACT 20:15" />سّنِّي نْسَفَر ذݣ وغَرَّابُو، ثِيوشَّا نس نُوْوض غَار ثيْزِيرْث ن كِيُوْس. وِيس ثڒْتِيَّام نُوْوض زَّاث إِ ثيْزِيرْث ن سَامُوْس. وِيس اَرْبعِيَّام نُوْوض غَار ثنْدِينْت ن مِيلِيتُوْس.<verse eid="ACT 20:15" /></para>
  <para style="s">أَرَّسُوْل بُوْلُس يتمْصَافَاض خ يمقّْرَانن ن ڒْمُوْمِنِين</para>
  <para style="p">
    <verse number="16‏-17" style="v" sid="ACT 20:16-17" />زِي ثنْدِينْت نِّي ن مِيلِيتُوْس يسّكّ بُوْلُس غَار ثنْدِينْت ن ؤُفَسُوْس يڒَاغَا-د خ يمقّْرَانن ن جْمَاعث ن ڒْمُوْمِنِين بَاش اَغَارس د اَسن. تُوْغَا يݣَّا بُوْلُس اَذ يكّ خ ڒبْحَر خ وغزْذِيس ن ثنْدِينْت ن ؤُفَسُوْس إِݣ يدْجَان ذِي لْإِقْلِيم ن آسْيَا بَاش وَار يتْعطَّڒ شَا ذِنِّي. ئِتْقدْجِيق بَاش اَذ يَاوض ذغْيَا غَار ثنْدِينْت ن لْقُدْس يمْكن قْبڒ إِ ڒْعِيذ ن نْهَار وِيس خمْسِين.<note caller="+" style="f"><char style="fr" closed="false">20‏.16‏-17 </char><char style="ft" closed="false">ڒْعِيذ ن نْهَار وِيس خمْسِين ذ يجّن ن ڒْعِيذ ن أَيث-إِسْرَائِيل يتَاس-د خمْسِين يُوْم منْبَعْد إِ ڒْعِيذ اَمقّْرَان نْسن.</char></note> <verse eid="ACT 20:16-17" /><verse number="18" style="v" sid="ACT 20:18" />وَامِي غَارس د ؤُسِين يمقّْرَانن نِّي ينَّا-ٱسن: "كنِّيو قَا ثسّْنم مَامّش تْعِيْشغ مَارَّا ڒْوقْث نِّي إِي تُوْغَا ٱكِذْوم قِّيمغ، زِي نْهَار نِّي اَمزْوَارُو إِي د ؤُذْفغ غَار آسْيَا. <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />خدّْمغ إِ سِيذِي أَربِّـي بْڒَا تَّكبُّر، س يمطَّاون ينُو كِّينْت خَافِي ڒمْحَاين وَامِي خَايِي شِيْطّْنن يسْرَائِيلِيْين. <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />وَار زَّايْوم سْنُوْفَّرغ وَالُو، نش تْخبَّرغ-كنِّيو س مَارَّا مِين كنِّيو غَا ينفْعن. سڒْمَاذغ-اَوم-ث زَّاث إِ يِوْذَان أُو عَاوذ زِي ثدَّارْث غَار ثدَّارْث. <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />عدْجْمغ إِ يسْرَائِيلِيْين ذ ييُوْنَانِيْين بَاش اَذ تُوْبن غَار أَربِّـي اَذ اَمْنن س سِيذِيثْنغ عِيْسَى. <verse eid="ACT 20:21" /><verse number="22" style="v" sid="ACT 20:22" />نش نْهَارَا ݣُّوْرغ غَار ثنْدِينْت ن لْقُدْس ذ أَرُّوْح إِي ذَايِي يتَاوِيِن ذِنِّي، وَار سِّينغ مِين ذَايِي غَا يوقْعن. <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />إِنَّمَا، ذِي مْكُڒ ثنْدِينْت يعدْجم-اَيي-د أَرُّوْح يقدّْسن قَا يتْرَاجَا-ٱيِي ڒحْبس ذ تَمَارَا. <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" />وَلَكِن وَار تِيشّغ بُو لْهِمَّا إِ ثُوْذَارْث ينُو. نش اَذ كمّْڒغ مِينْخف د ؤُسِيغ ذ ڒْخذْمث إِي زِّي ذَايِي يكلّف سِيذِيثْنغ عِيْسَى، يعْنِي اَذ شهْذغ خ لْإِنْجِيل ن اَرْضَا ن أَربِّـي.<verse eid="ACT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25" />ڒخُّو كنِّيو ؤُمِي بشَّرغ س ڒْمُلْك ن أَربِّـي سّْنغ نش بلِّي ؤُڒَا ذ يجّن زَّايْوم مَا ٱذ يࢲر اَغمْبُوْب ينُو سَّا ٱڒ ثْسَاونْت. <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />خ مَانَايَا قَّارغ-اَوم نش زِي نْهَارَا تْبرِّيغ يخف ينُو زݣ يذَامّن نْوم مَارَّا. <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />لِأَنَّا نش وَار زَّايْوم سْنُوْفَّرغ وَالُو زِي مَارَّا مِين ينوَّا أَربِّـي اَث يݣّ. <verse eid="ACT 20:27" /><verse number="28" style="v" sid="ACT 20:28" />حْضَاث يخف نْوم. حْضَاث ثْحِيمرْث نْوم، ثنِّي إِي زِي كنِّيو يكلّف أَرُّوْح يقدّْسن. اَروْسث جْمَاعث ن ڒْمُوْمِنِين ن أَربِّـي قَا نتَّا يسغ-يت س يذَامّن نّس.<verse eid="ACT 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 20:29" />شُوْف، سّْنغ خْمِي غَا ؤُيُوْرغ نش اَذ د اَذْفن جَارَاوم شَان ن وُوْشَّانن يوْعَارن وَار رحّْمن شَا ثْحِيمرْث. <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />عَاوذ زَّايْوم اَذ د مظْهَارن شَان يثَرَّاسن اَذ سْعوّْجن لْحَقِيقَا حمَا ٱذ جَرّن غَارْسن يمحْضَارن. <verse eid="ACT 20:30" /><verse number="31" style="v" sid="ACT 20:31" />إِيوَا إِڒِيث عْلَابَال! وَار تتُّوْم شَا نش ثڒْت-سْنِين إِي كِذْوم كِّيغ، قِّيمغ تْوصِّيغ مْكُڒ يجّن زَّايْوم دْجِيڒث ذ وَاسّ س يمطَّاون ينُو.<verse eid="ACT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32" />آي اَيثْمَا، ڒخُّو اَخَاوم ودِّيغ، إِڒِيث اَݣ أَربِّـي ذ وَاوَاڒن ن أَرْضَا نّس. أَوَاڒن-أَ ذَايْسن ثِزمَّار اَذَاوم ؤُشن جّْهذ اَذَاوم ؤُشن ڒْوَاڒث اَك مَارَّا ڒْمُوْمِنِين صَّالِحِين. <verse eid="ACT 20:32" /><verse number="33" style="v" sid="ACT 20:33" />نش عمَّارص وَار ضْمِيْعغ إِ يِيخف ينُو شَان ن دّْهب نِغ ذ نُّقَارْث نِغ ذ اَرُّوْض ن شَان حَدّ. <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />كنِّيو ثسّْنم نش تُوْغَا خذْمغ س يفَاسّن ينُو بَاش اَغَارِي يِيڒِي مِين حْذَاجغ نش ذ مِين حْذَاجن يِنِّي اَكِذِي. <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />س مَارَّا مَانَايَا سْمظْهَارغ-اَوم-د مَامّش يتْخصَّا-يَانغ أَ نخْذم مْلِيح بَاش أَ نْعَاون يِنِّي يحْذَاجن. أَ نْفكَّر ذݣ وَاوَاڒ ن سِيذِيثْنغ عِيْسَى إِي ينَّا: سَّعْذ ن ونِّي يتِيشّن كْتَار زݣ ونِّي يقبّْڒن."<verse eid="ACT 20:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36" />وَامِي ينَّا بُوْلُس ثِمسْڒَايِين-أَ، يرْكع خ يفَادّن ذ يِنِّي مَارَّا نتَّا يࢲُّوْدْج. <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />ذرّْعن-اَس إِ بُوْلُس بْذَان تْسدْجَامن خَاس، تْرُوْن مَارَّا إِذْسن. <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />خيّْقن اَطَّاس س وَارَاڒ نِّي إِي ذَاسن ينَّا وَار ثْࢲرّم شَا اَغمْبُوْب ينُو سَّا ٱڒ ثْسَاونْت. سّنِّي ؤُوِين-ث غَار وغَرَّابُو.<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="s">أَرَّسُوْل بُوْلُس يتْسَفَر غَار ثنْدِينْت ن لْقُدْس</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />وَامِي خَاسن د نُوْيُوْر سّنِّي، ننْيَا ذݣ وغَرَّابُو نْرُوْح نِيشَان غَار ثيْزِيرْث ن كُوْس. ثِيوشَّا نّس نُوْوض غَار ثيْزِيرْث ن رُوْدُس. سّنِّي نُوْيُوْر غَار ثنْدِينْت ن بَاطَارَا. <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />نُوْفَا ذِنِّي يجّن ن وغَرَّابُو يتْرَاح غَار جْوَايه ن فِينِيقْيَا، ننْيَا ذَايس نُوْيُوْر. <verse eid="ACT 21:2" /><verse number="3" style="v" sid="ACT 21:3" />ثْمظْهَار-اَنغ-د ثيْزِيرْث ن قُبْرُص خ وࢲڒْمَاض نّغ. نعْذُو-ت، نْرُوْح غَار سُوْرْيَا نظْرَا ذِي ثنْدِينْت ن صُوْر مِينْزِي اَغَرَّابُو يتْخصَّا اَذ يسرْس سّڒْعَث ذِنِّي. <verse eid="ACT 21:3" /><verse number="4" style="v" sid="ACT 21:4" />وَامِي نرْزُو خ يمحْضَارن، نُوْفِي-ثن ذِنِّي نقِّيم اَكِذْسن سبْعِيَّام. عْلَاحْسَاب مِين عڒْمن نِثْنِي زِي أَرُّوْح، قَّارن-اَس إِ بُوْلُس وَار تْݣَعَّاذ شا شك غَار ثنْدِينْت ن لْقُدْس. <verse eid="ACT 21:4" /><verse number="5" style="v" sid="ACT 21:5" />وَامِي ذَانغ ثقْضَا ذِنِّي ڒْوقْث نّغ نكَّر نفّغ بَاش أَ نْسِيْغِي خ ؤُسَفَر نّغ. مَارَّا يمحْضَارن رُوْحن اَكِذْنغ غَار بَارَّا ن ثنْدِينْت س ثمْغَارِين نْسن ذ ثَارْوَا نْسن، نرْكع خ يفَادّن نّغ خ يِجْذِي ن ڒبْحَر نࢲُّوْدْج. <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />وَامِي نمْسَافَاض خَاسن ننْيَا ذݣ وغَرَّابُو، نِثْنِي روّْحن غَار ثُوْذْرِين نْسن.<verse eid="ACT 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7" />سّنِّي نْسِيْغِي خ ؤُسَفَر نّغ ذِي ڒبْحَر زِي ثنْدِينْت نِّي ن صُوْر نخْضڒ غَار ثنْدِينْت ن بَطْلَيْمُوْس. نْسدْجم خ اَيثْمَاثْنغ ذِنِّي، نقِّيم اَكِذْسن يجّن ن نْهَار. <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" />ثِيوشَّا نّس نْرُوْح غَار ثنْدِينْت ن قَيْصَارِيَا نُوْذف نقِّيم ذِي ثدَّارْث ن لْمُبْشِر فِيلِيپَّـاس. نتَّا ذ يجّن زِي سبْعَا <char style="it">ن صَّحَابَا ن اَرُّسُل ن لْقُدْس.</char> <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />نتَّا غَارس اَرْبعَا ن ثْحنْجِيرِين ذ ثِعْزْرِيِين سَّاوَاڒنْت س مِين عدْجْمنْت زِي أَربِّـي. <verse eid="ACT 21:9" /><verse number="10" style="v" sid="ACT 21:10" />وَامِي نقِّيم اَكِذْسن شَان وُوْسَّان، يُوْسَا-د غَارْنغ يجّن ن نَّبِي زِي يَهُوْذِيَا قَّارن-اَس غَابُوْس. <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />ئِقَارّب-د غَارْنغ ييْسِي اَحزَّام ن بُوْلُس، ئِشدّ يضَارن ذ يفَاسّن إِ يِيخف نّس ينَّا: "ئِقَّار أَرُّوْح يقدّْسن: أَمُّو يسْرَائِيلِيْين ن لْقُدْس اَذ قّْنن بَاب ن ؤُحزَّام-أَ، أَث سلّْمن إِ يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل."<verse eid="ACT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12" />نشِّين ذ يِوْذَان وَامِي نسْڒَا مَانَايَا نْحشّم بُوْلُس بَاش وَار يتْرِيح شَا غَار ثنْدِينْت ن لْقُدْس. <verse eid="ACT 21:12" /><verse number="13" style="v" sid="ACT 21:13" />ينَّا-ٱنغ: "مِين كنِّيو يُوْغِين؟ مَايمِّي إِي ذَايِي ثحْفَرم ذݣ وُوْڒ س يمطَّاون نْوم؟ نش اَقَايِي مُوْجُوْد مَاشِي اَذَايِي قّْنن وَاهَا. نش اَقَايِي مُوْجُوْد اَذ مّْثغ ذِي لْقُدْس عْلَاحْسَاب يسم ن سِيذِيثْنغ عِيْسَى!" <verse eid="ACT 21:13" /><verse number="14" style="v" sid="ACT 21:14" />وَامِي نُوْفَا نشِّين وَار ث نْسقْنِيع شَا، نسْقَار ننَّا: مِين يخس سِيذِي أَربِّـي اَث يݣّ ذ ونِّي نتَّا!<verse eid="ACT 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15" />منْبَعْد ڒخْدّنِّي، نْسوْجذ يخف نّغ أَ نْݣَعّذ غَار ثنْدِينْت ن لْقُدْس. <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" />ؤُوِين-اَنغ شَان ن يمحْضَارن زِي ثنْدِينْت ن قَيْصَارِيَا بَاش أَ نْنوْجو غَار يِجّن ن بْنَاذم قَّارن-اَس مْنَاسُوْن نتَّا زِي ثنْدِينْت ن قُبْرُص. نتَّا زݣ يمحْضَارن يمزْوُوْرَا.<verse eid="ACT 21:16" /></para>
  <para style="s">أَرَّسُوْل بُوْلُس يتمْسڒْقَا اَك اَرَّسُوْل يَعْقُوْب</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />وَامِي نُوْوض غَار لْقُدْس، رحّْبن زَّايْنغ اَيثْمَاثْنغ س ڒفْرَاحث. <verse eid="ACT 21:17" /><verse number="18" style="v" sid="ACT 21:18" />ثِيوشَّا نّس يُوْذف اَكِذْنغ بُوْلُس غَار اَرَّسُوْل يَعْقُوْب، حْضَارن ذِنِّي مَارَّا يمقّْرَانن ن جْمَاعث ن ڒْمُوْمِنِين. <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />ئِسدْجم خَاسن بُوُلُس، ئِعَاوْذ-اَسن ثَا س ثَا ينَّا-ٱسن مِين يݣَّا أَربِّـي خ وفُوْس نّس جَار يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل.<verse eid="ACT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 21:20" />وَامِي سْڒِين إِ مَانَاينِّي، حمْذن أَربِّـي نَّان-اَس إِ بُوْلُس: "شُوْف آي ؤُمَاثْنغ مشْحَاڒ ن ؤُڒُوْفَاث ن يسْرَائِيلِيْين إِي يُوْمْنن! مَارَّا إِذْسن رزُّوْن اَذ ݣّن لْوَاجِب عْلَاحْسَاب شَّريعا <char style="it">نّغ</char>. <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />ئِتْوَانَّا-يَاسن زَعْمَا شك ثْسڒْمَاذذ مَارَّا يسْرَائِيلِيْين إِي زدّْغن ذِي لْخَرِيج اَذ سمْحن ذِي مُوْسَى، ثقَّارذ-اَسن وَار طهَّارث شَا إِ ثَارْوَا نْوم، وَار ذفَّارث شَا لْعَادَاث نّغ. <verse eid="ACT 21:21" /><verse number="22" style="v" sid="ACT 21:22" />بْڒَا شّكّ اَذ سْڒن قَا شك إِلَّا ثُوْسِيذ-د. إِيوَا، مَامّش غَا نݣّ؟ <verse eid="ACT 21:22" /><verse number="23" style="v" sid="ACT 21:23" />إِذن، مِين ذَاش غَا نِيْنِي اݣّ-يث. <char style="it">شُوْف،</char> غَارْنغ اَرْبعَا ن يرْيَازن ݣِّين ڒْعَهذ <char style="it">اَك سِيذِي أَربِّـي</char>. <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />أَوِي يِيْنَا خدْجس خَاسن اَخْمِي غَا ثݣّم مَارَّا كنِّيو ڒُوْضُو نِّي اَصبْحَان<note caller="+" style="f"><char style="fr" closed="false">21‏.24 </char><char style="ft" closed="false">ڒُوْضُو-يَا اَصبْحَان ذ يجّن ن نُّوْع ن ڒُوْضُو مَاشِي عَادِي، تݣّن-ث بَاش اَذ سِّيصْفَان يخف نْسن مْلِيح. ئِتكّ سِيمَانَا، تْخَادْجَاسن خَاس اَطَّاس ن تْمنْيَاث.</char></note> بَاش نِثْنِي اَذ حفّن اَذ ذوْڒن ذ يقشُّوْرَا. أَمُّو اَذ سّْنن مَارَّا مِين خَاك يتْوَانَّان وَار يدْجِي بُو ذ صَّح. شك س يِيخف نّش ثْذفَّارذ شَّرِيعَا نّغ. <verse eid="ACT 21:24" /><verse number="25" style="v" sid="ACT 21:25" />وَلَكِن عْلَاحْسَاب ڒْمُوْمِنْين نِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل، نُوْرَا-يَاسن ثَبْرَات نُوْمَر-يثن اَذ بعّْذن خ لْمَكْلَا يتْوَاقدّْمن إِ لْأَصْنَام، ذ يذَامّن، ذ مِين يتْوَاجيّْفن، ذ لْفَسَاد."<verse eid="ACT 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26" />ثِيوشَّا نّس يُوْوِي بُوْلُس يرْيَازن نِّي اَكِذس، يݣَّا ڒُوْضُو نِّي اَصبْحَان اَكِذْسن. يُوْذف غَار ثمْزِيذَا ثَمقّْرَانْت اَذ يعْڒم ڒْفُقَهَا خ ڒْوقْث إِي ذِي غَا كمّْڒن نْهُوْرَاث نِّي يقِّيمن خ وصفِّي نْسن، يعْنِي ڒْوقْث إِي غَا قدّْمن ڒْفُقَهَا دْبِيحَاث إِ اَرْبعَا-يَا.<verse eid="ACT 21:26" /></para>
  <para style="s">تطّْفن اَرَّسُوْل بُوْلُس ذِي ثمْزِيذَا ثَمقّْرَانْت</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />وَامِي عْڒَاين اَذ كمّْڒن سبْعَا نِّي ن نْهُوْرَاث ن ڒُوْضُو، شَان يسْرَائِيلِيْين زِي لْإِقْلِيم ن آسْيَا ࢲْرِين بُوْلُس ذِي ثمْزِيذَا ثَمقّْرَانْت سَامَرن خَاس مَارَّا ڒْغَاشِي نِّي تمْزَاحَامن خَاس. <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />سْنكَّرن ثْغُوْيّث قَّارن: "آي يرْيَازن ن أَيث-إِسْرَائِيل! قَا اَرْيَاز-أَ ونِّي يسڒْمَاذن يوْذَان مَارَّا ذِي مْكُڒ اَمْشَان يرزُّو اَذ عَارّْضن شَّعْب نّغ ذ شَّرِيعَا نّغ ذ ومْشَان-أَ نّغ! عَاوذ يسِيذف-د ييُوْنَانِيْين غَار ثمْزِيذَا ثَمقّْرَانْت، ئِسخْنَاز اَمْشَان-أَ مُقدّس." <verse eid="ACT 21:28" /><verse number="29" style="v" sid="ACT 21:29" /><char style="it">نَّان مَانَاينِّي</char> مِنْزِي تُوْغَا ࢲْرِين اَكِذس ذِي ثنْدِينْت يجّن ن بْنَاذم قَّارن-اَس تْرِيْفُوْمُو زِي أَيث-ؤُفَسُوْس، ئِتْغِيڒ-اَسن بُوْلُس يسِيذف-يث غَار ثمْزِيذَا ثَمقّْرَانْت.<verse eid="ACT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30" />ثكَّر ڒْفَوْضَا ذِي ثنْدِينْت مَارَّا. كَّرن يِوْذَان نِّي ؤُزّْرن غَار بُوْلُس طّْفن-ث، جَرّن-ث زِي ثمْزِيذَا ثَمقّْرَانْت غَار بَارَّا ڒخْدّنِّي بلّْعن ثِوُّوْرَا. <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />وَامِي رزُّوْن اَث نْغن، يُوْوض ڒخْبَار غَار اَرَّايس ن ڒْعَسْكَار ن اَرُّوْمَانُوْس ثكَّر يجّن ن ڒْفَوْضَا ذِي لْقُدْس مَارَّا. <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />ئِرُوْح نتَّا ذغْيَا يُوْوِي اَكِذس ڒْعَسْكَار ذ يمقّْرَانن نْسن يُوْزّڒ غَارْسن. ئِسْرَائِيلِيْين وَامِي ࢲْرِين اَرَّايس ذ ڒْعَسْكَار نّس، بدّن وَار قِّيمن شَا عَاذ شَّاثن بُوْلُس.<verse eid="ACT 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 21:33" />ئِقَارّب اَرَّايس نِّي غَار بُوْلُس يطّف-يث، يُوْمَر اَث قّْنن س ثْنَاين ن سْنَاسڒ. ئِسّقْسَا خَاس ينَّا-ٱسن: وَانِيتَا مِين يعْنَا ذ مِين يݣَّا؟ <verse eid="ACT 21:33" /><verse number="34" style="v" sid="ACT 21:34" />ڒْغَاشِي نِّي سْنكَّرن ثْغُوْيّث كُڒ يجّن مِين يقَّار. وَامِي اَرَّايس نِّي وَار يفْهِيم شَا نِيشَان مَان سَّبَاب ن سّْدَع نِّي، يُوْمَر اَث سِيڒِين غَار لْقشْلَا. <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />وَامِي يُوْوض بُوْلُس غَار دّْرُوْج، اَرْبُوْن-ث ڒْعَسْكَار سِيڒِين-ث عْلَاحْسَاب اَمنْغِي نِّي ن يِوْذَان. <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />مِنْزِي ذفَّارن-ث سْنكَّرن ثْغُوْيّث قَّارن يْسِيم خَانغ وَانِيتَا!<verse eid="ACT 21:36" /></para>
  <para style="s">أَرَّسُوْل بُوْلُس يتْذَافَاع خ يِيخف نّس</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />وَامِي عْڒَاين اَذ سِيذْفن بُوْلُس غَار لْقشْلَا نِّي، ينَّا-ٱس إِ اَرَّايس ن ڒْعَسْكَار: "سْمح-اَيِي اَش ينِيغ يجّن ن وَاوَاڒ."</para>
  <para style="p" vid="ACT 21:37">ينَّا-ٱس اَرَّايس نِّي إِ بُوْلُس: "مَامّش تݣّذ شك ثسَّاوَاڒذ ثَيُوْنَانِيث؟ <verse eid="ACT 21:37" /><verse number="38" style="v" sid="ACT 21:38" />مَا وَار ثدْجِيذ شَا شك ذ اَمِصْرِي نِّي إِي يݣِّين لْفِتْنَا ذِي ڒِيَّام نِّي وَامِي ثْسُوْيُوْرذ اَربْعَا اَڒَاف ن لْإِرْهَابِيْين غَار ڒخْڒَا؟"<verse eid="ACT 21:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39" />ينَّا-ٱس بُوْلُس: "لَّا، نش ذ اَئِسْرَائِيلِي، لْجِنْسِيَا ينُو زِي ثنْدِينْت مَعْرُوْفَا ن طَرْسُوْس ذِي لْإِقْلِيم ن كِيلِيكْيَا. تتَّارغ زَّايش اَذَايِي ثْسمْحذ اَذ سِّيوْڒغ اَك يِوْذَان-أَ." <verse eid="ACT 21:39" /><verse number="40" style="v" sid="ACT 21:40" />وَامِي إِي ث يجَّا اَرَّايس ن ڒْعَسْكَا اَذ يسِّيوڒ، ئِبدّ بُوْلُس خ دّْرُوْج يشيَّر-اَسن س يفَاسّن نّس. نِثْنِي سْقَارن، ئِسِّيوڒ اَكِذْسن س لُّغَا لْعِبْرِيَا ينَّا-ٱسن:<verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />"آي اَيثْمَا آي يمْغَارن، صنّْطث-اَيِي مْلِيح ڒخُّو بَاش اَذ ذَافْعغ خ يِيخف ينُو!" <verse eid="ACT 22:1" /><verse number="2" style="v" sid="ACT 22:2" />وَامِي سْڒِين إِ بُوْلُس يسَّاوَاڒ س لُّغَا لْعِبْرِيَا أُوْشَا قضْعن ڒْحسّ. ينَّا-ٱسن: <verse eid="ACT 22:2" /><verse number="3" style="v" sid="ACT 22:3" />"نش ذ اَئِسْرَائِيلِي خڒْقغ ذِي ثنْدِينْت ن طَرْسُوْس ذِي لْإِقْلِيم ن كِيلِيكْيَا، وَلَكِن نش يْمِيغ ذِي ثنْدِينْت-أَ ذَانِيتَا. غْرِيغ غَار يضَارن ن لْأُسْتَاد ݣَامْليِيل تْوَاربِّيغ س شَّرِيعَا ن ڒجْذُوْذ نّغ مَامّش ذَانغ ثْوصَّا ثَا س ثَا كُڒْشِي. رزُّوْغ اَذ ݣّغ لْوَاجِب اَك أَربِّـي س وُوْڒ ينُو مَامش ثْرزُّوْم اَذ تݣّم كنِّيو مَارَّا نْهَارَا.<verse eid="ACT 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 22:4" />نش تُوْغَا تْعدَّابغ يِنِّي يذْفَارن اَبْرِيذ-أَ حتَّا وَامِي مُّوْثن. طّْفغ يرْيَازن ذ ثمْغَارِين ݣِّيغ-ثن ذِي ڒحْبس. <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />أَرَّايس ن ڒْفُقَهَا ذ مَارَّا جْمَاعث ن يمقّْرَانن ن أَيث-إِسْرَائِيل نِثْنِي ذ ڒشْهُوْذ خ مَانَاينِّي. ؤُشِين-اَيِي اَرُّخْصَاث اَثنْت سِّيوْضغ غَار اَيثْمَاثْسن ذِي ثنْدِينْت ن دِمَشق. رُوْحغ ذِنِّي اَذ طّْفغ يوْذَان <char style="it">ن وبْرِيذ-أَ</char> اَثن د اَوِيغ غَار لْقُدْس بَاش اَذ تْوَاعَاقْبن.<verse eid="ACT 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6" />نش تُوْغَا ݣُّوْرغ ذݣ وبْرِيذ قَارّْبغ غَار دِمَشق، تُوْغَا عْڒَاين ذ اَزْين ن نْهَار. عْلَاغَفْلَا ينّض-اَيِي-د يجّن ن نُّوْر يتْشعْشِيع زݣ وجنَّا. <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />ؤُضِيغ غَار ثْمُوْرْث سْڒِيغ إِ يِجّن ن ثْمِيجَّا ثقَّار-اَيي-د: آ شَاوُل آ شَاوُل، مَايمِّي ذَايِي تْعدَّابذ؟ <verse eid="ACT 22:7" /><verse number="8" style="v" sid="ACT 22:8" />نِّيغ-اَس نش: مِين ثعْنِيذ شك آ سِيذِي؟ ينَّا-ٱيِي نش ذ عِيْسَى زي نَاصِرَا ذ ونِّي إِي تْعدَّابذ.<verse eid="ACT 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 22:9" />يِنِّي كِذِي يدْجَان ࢲْرِين نُّوْر نِّي وَلَكِن وَار فْهِيمن شَا إِ ثْمِيجَّا ن ونِّي إِي كِذِي د يسَّاوَاڒن.<verse eid="ACT 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 22:10" />نِّيغ-اَس نش: مِين غَا ݣّغ آ سِيذِي؟ ينَّا-ٱيِي سِيذِيثْنغ: كَّر اَذف غَار دِمَشق، أَذَاش يتْوَانَّا ذِنِّي مَارَّا مِين يُوْرِين اَذ تݣّذ.<verse eid="ACT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 22:11" />نُّوْر نِّي تُوْغَا يتْسقْسِيق يجْهذ خَافِي، ذوْڒغ وَار تْوِيڒِيغ وَالُو. طّْفن-اَيِي زݣ وفُوْس ينُو يِنِّي كِذِي يدْجَان، سِّيوْضن-اَيِي غَار دِمَشق. <verse eid="ACT 22:11" /><verse number="12‏-13" style="v" sid="ACT 22:12-13" />يُوْسَا-د غَارِي ذِنِّي يجّن قَّارن-اَس أَنَاس. نتَّا ذَايس دِّين، يتْطَاعَا إِ شَرِيعَا. سَّاوَاڒن خَاس مْلِيح مَارَّا يسْرَائِيلِيْين إِي زدّْغن ذِي دِمَشق. ئِبدّ-د زَّاثِي ينَّا-ٱيِي: آي ؤُمَا شَاوُل، ڒخُّو اَذ تْذوْڒذ اَذ تْوَاڒِيذ! ڒخْدّنِّي ݣنْفِيغ تْوَاڒِيغ نتَّا. <verse eid="ACT 22:12-13" /><verse number="14" style="v" sid="ACT 22:14" />ينَّا-ٱيِي: أَربِّـي ن ڒجْذُوْذ نّغ يخْضَر-يشك نتَّا بَاش اَذ تسّْنذ مِين يخس، أَذ تْوَاڒِيذ <char style="it">س ثِيطَّاوِين نّش</char> اَخدَّام نّس صَّالِح اَذ تْصنّْطذ إِ يِجّن ن وَاوَاڒ زݣ وقمُّوْم نّس. <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />شك اَخَاس ثِيڒِيذ ذ شَّاهذ غَار مَارَّا يوْذَان عْلَاحْسَاب مِين ثࢲْرِيذ ذ مِين ثسْڒِيذ. <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />ئِي ڒخُّو مِين تْرَاجِيذ؟ كَّر اَذ تْوَاطهَّارذ س وَامَان، سِيرذ زِي ڒْمُعْصِيَاث نّش خْمِي غَا ثْڒَاغِيذ خ يِيسم نّس.<verse eid="ACT 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17" />وَامِي ذوْڒغ غَار ثنْدِينْت ن لْقُدْس تْࢲَادْجِيغ ذِي ثمْزِيذَا ثَمقّْرَانْت، ئِهْوَا-د خَافِي يجّن ن لْوَحِي. <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />ࢲْرِيغ <char style="it">سِيذِيثْنغ</char> ينَّا-ٱيِي: كَّر فّغ ذغْيَا زِي لْقُدْس مِينْزِي شْهَاذث نّش خَافِي وَار ت قبّْڒن شَا. <verse eid="ACT 22:18" /><verse number="19" style="v" sid="ACT 22:19" />نِّيغ-اَس: آ سِيذِي، نِثْنِي سّْنن بلِّي تُوْغَا تْرَاحغ زِي ثمْزِيذَا غَار ثمْزِيذَا تْحبَّاسغ شَّاثغ يِنِّي زَّايك يُوْمْنن. <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" />حْضَارغ نش وَامِي سِيزّْڒن يذَامّن ن سْتِيفَان<note caller="+" style="f"><char style="fr" closed="false">22‏.20 </char><char style="ft" closed="false">سْتِيفَان نتَّا زِي سبْعَا نِّي ن صَّحَابَا ن اَرُّسُل ذِي ثنْدِينْت ن لْقُدْس. نْغِين-ث يسْرَائِيلِيْين.</char></note> ونِّي خَاك يشهّْذن. وَافْقغ خ ڒْموْث نّس، حْضِيغ-اَسن ؤُڒَا ذ اَرُّوْض ن يِنِّي إِي ث ينْغِين. <verse eid="ACT 22:20" /><verse number="21" style="v" sid="ACT 22:21" />ينَّا-ٱيي سِيذِي: رُوْح، شك اَش سّكّغ غَار يمُوْشَان ݣّْوْجن اَطَّاس، غَار يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل."<verse eid="ACT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />سْڒِين مْلِيح إِ بُوْلُس حتَّا اَڒ وَامِي ينَّا اَوَاڒ-أَ اَنݣَّارُو. ڒخْدّنِّي سْنكَّرن خَاس ثْغُوْيّث نَّان: مْحَاث اَرْيَاز-أَ زِي دُّنشْت-أَ، وَار يسْذِيهدْج شَا اَذ يقِّيم عَاذ يدَّر! <verse eid="ACT 22:22" /><verse number="23" style="v" sid="ACT 22:23" />سْنكَّرن ثْغُوْيّث، نظَّارن يزدْجُوْبَا نْسن، زُّوْزَّارن ثَعجَّاشْت غَار وجنَّا. <verse eid="ACT 22:23" /><verse number="24" style="v" sid="ACT 22:24" />ئِكَّر اَرَّايس ن ڒْعَسْكَار يُوْمَر اَذ سِيذْفن بُوْلُس غَار لْقشْلَا، أَث ؤُوْثن س وسْغُوْن اَذَاس ݣّن لْإِسْتِجْوَاب مَايمِّي خَاس سْنكَّرن ثْغُوْيّث قَاع اَمُّو. <verse eid="ACT 22:24" /><verse number="25" style="v" sid="ACT 22:25" />وَامِي ث شدّن بَاش اَث ؤُوْثن، ينَّا-ٱس بُوْلُس إِ ومقّْرَان ن ڒْعَسْكَار يبدّن ذِنِّي: "مَا قَانُوْنِي اَذ تُوْوْثم يجّن ن بْنَاذم س وسْغُوْن غَارس لْجِينْسِيَا ن اَرُّوْمَانُوْس مڒَا وَار خَاس ثْحكِّيمم شَا؟"<verse eid="ACT 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26" />وَامِي يسْڒَا ومقّْرَان نِّي ن ڒْعَسْكَار مَانَاينِّي، ئِرُوْح غَار اَرَّايس ن ڒْعَسْكَار ينَّا-ٱس: "مِين تݣّذ شك اَمُّو؟ قَا ٱرْيَاز نِّي غَارس لْجِينْسِيَا ن أَرُوْمَانُوْس!"<verse eid="ACT 22:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27" />يُوْسَاَ-د اَرَّايس نِّي ينَّا-ٱس: "إِن-اَيِي شك، مَا غَارك لْجِينْسِيَا ن أَرُوْمَانُوْس؟"</para>
  <para style="p" vid="ACT 22:27">يَارَّا خَاس بُوْلُس: "وَاه، نش اَقَات غَارِي."<verse eid="ACT 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 22:28" />ينَّا-ٱس اَرَّايس نِّي: "قَا نش سْغِيغ لْجِينْسِيَا ينُو س وَاطَّاس ن تْمنْيَاث."</para>
  <para style="p" vid="ACT 22:28">ينَّا-ٱس بُوْلُس: "نش خڒْقغ-د زَّايس." <verse eid="ACT 22:28" /><verse number="29" style="v" sid="ACT 22:29" />ڒخْدّنِّي بعّْذن خَاس ذغْيَا يِنِّي يخْسن اَس ݣّن لْإِسْتِجْوَاب. ئِݣّْوذ وَاخَّا ذ اَرَّايس نِّي وَامِي يسّن بلِّي يشدّ يجّن غَارس لْجِينْسِيَا ن أَرُوْمَانُوْس.<verse eid="ACT 22:29" /></para>
  <para style="s">أَرَّسُوْل بُوْلُس زَّاث إِ جْمَاعث ن لْحُكَّام ن أَيث-إِسْرَائِيل</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />ثِيوشَّا نّس، يرزُّو اَرَّايس نِّي ن ڒْعَسْكَار اَذ يسّن مَايمِّي أَيث-إِسْرَائِيل تَاهَامن بُوْلُس، ئِرُوْح يُوْمَر اَرُّوْيَاس ن ڒْفُقَهَا ذ مَارَّا جْمَاعث ن لْحُكَّام ن أَيث-إِسْرَائِيل اَذ مُوْنن. ڒخْدّنِّي يسُوْفغ-د بُوْلُس يُوْوِي-ث-يذ غَارْسن يسْبدّ-يث زَّاثْسن.<verse eid="ACT 22:30" /></para>
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />ئِخْزَر مْلِيح بُوْلُس غَار جْمَاعث ن لْحُكَّام ن أَيث-إِسْرَائِيل ينَّا-ٱسن: "آي اَيثْمَا، قَا نش ݣِّيغ لْوَاجِب نِيْشَان اَك أَربِّـي، زِي قْبڒ حتَّا نْهَارَا نش ضَّمِير ينُو مرْتَاح." <verse eid="ACT 23:1" /><verse number="2" style="v" sid="ACT 23:2" />ئِكَّر أَنَاس أَرَّايس ن ڒْفُقَهَا يُوْمَر يِنِّي يبدّن اَك بُوْلُس اَث ؤُوْثن غَار وقمُّوْم. <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" />ڒخْدّنِّي ينَّا-ٱس بُوْلُس: "شك ثݣِّيذ اَم ڒْحِيض يرْشَان يجِّيَارن س جِّير، أَش يُوْوث أَربِّـي! ثقِّيمذ شك ذِنِّي اَخَافِي ثْحكْمذ عْلَاحْسَاب شَّرِيعَا، وَلَكِن ڒخُّو تْخَالَافذ شَّرِيعَا وَامِي ثن ثُوْمَرذ اَذَايِي ؤُوْثن."<verse eid="ACT 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4" />نَّان-اَس إِ بُوْلُس يِنِّي ذِنِّي يحْضَارن: "مَا تُوْكَّارذ شك اَرَّايس ن ڒْفُقَهَا ن أَربِّـي؟!"<verse eid="ACT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 23:5" />ينَّا-ٱسن بُوْلُس: "آي اَيثْمَا، قَا نش وَار ث سِّينغ شَا تُوْغَاث ذ اَرَّايس ن ڒْفُقَهَا مِنْزِي لْكِتَاب يقَّار: &lt;أَرَّايس ن شَّعْب، وَار ذَايس قَّار بُو ڒْعِيب.&gt;"<verse eid="ACT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6" />وَامِي يسّن بُوْلُس قَا شَا زَّايْسن زِي ڒْحِزْب ن يصَدُّوْقِيْين شَا نّغْنِي زِي ڒْحِزب ن يفَرِّسِيْين، ئِكَّر يڒَاغَا-د س جّْهذ ذِي جْمَاعث نِّي ن لْحُكَّام جَارَاسن ينَّا-ٱسن: "آي اَيثْمَا، قَا نش ذ اَفَرِّيسِي مِّيس ن يفَرِّيسِيْين! أَقَا تْحَاكَامم خَافِي وَامِي نش غَارِي لْأَمَال اَذ د كَّرن يِوْذَان زِي ڒْموْث ذِي لْقِيَامَا." <verse eid="ACT 23:6" /><verse number="7" style="v" sid="ACT 23:7" />وَامِي ينَّا مَانَايَا يوْقع يجّن ن لْخِلَاف جَار يفَرِّسِيْين ذ يصَدُّوْقِيْين، جْمَاعث نِّي ن لْحُكَّام مسْفْرَاقن جَارَاسن. <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" />(مِنْزِي يصَدُّوْقِيْين قَّارن قَا وَار ذِنِّي لَّا لْقِيَامَا، لَّا لْمَلَايْكَاث، لَّا جْنُوْن، وَلَكِن يفَرِّسِيْين قَّارن مَارَّا مَانَايَا يدْجَا.)<verse eid="ACT 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 23:9" />ئِوْقع يجّن ن سّْدَع يمْغَار، كَّرن ڒبْعَاض زݣ يمْسڒْمَاذن ن شَّرِيعَا نِثْنِي ذ يفَرِّيسِيْين تمْنَاقَارن س جّْهذ قَّارن: "نشِّين وَار ذَاس نْتِيف بُو شَان لْغَالط ذِي بْنَاذم-أَ، يمْكن يسِّيوڒ اَكِذس شَان ن جّنّ نِغ ذ شَان ن لْمَلَائِكَا."<verse eid="ACT 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 23:10" />وَامِي بْذَان تْمنْغَان س جّْهذ عْلَاحْسَاب لْخِلَاف نِّي، ئِݣّْوذ اَرَّايس ن ڒْعَسْكَار اَذ مزْقن بُوْلُس. يُوْمَر ڒْعَسْكَار نّس اَذ هْوَان اَذ د خضْفن بُوْلُس زِي ڒْوسْط نْسن، أَث سِيڒِين غَار لْقشْلَا. <verse eid="ACT 23:10" /><verse number="11" style="v" sid="ACT 23:11" />دْجِيرث نِّي يبدّ-د سِيذِيثْنغ غَار بُوْلُس ينَّا-ٱس: "اݣّ زْعَامث! مَامّش إِي زَّايِي ثْشهْذذ ذِي ثنْدِينْت ن لْقُدْس، أُو لَابُد عَاوذ اَزَّايِي ثْشهْذذ ذِي ثنْدِينْت ن رُوْمَا."<verse eid="ACT 23:11" /></para>
  <para style="s">أَيث-إِسْرَائِيل تْشِيطِّينن بَاش اَذ نْغن اَرَّسُوْل بُوْلُس</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />وَامِي د يصْبح ڒْحَاڒ شِيطّْنن أَيث-إِسْرَائِيل، وعْذن أَربِّـي حَرّْمن يخف نْسن وَار تتّن وَار سسّن اَڒ غَا نْغن بُوْلُس. <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />كْتَار زِي اَرْبعِين إِذْسن إِݣ يشِيطّْنن ذِي مَانَايَا. <verse eid="ACT 23:13" /><verse number="14" style="v" sid="ACT 23:14" />رُوْحن غَار اَرُّوْيَاس ن ڒْفُقَهَا ذ يمقّْرَانن ن أَيث-إِسْرَائِيل نَّان-اَسن: "نشِّين نوْعذ أَربِّـي نْحَرّم يخف نّغ وَار نْتتّ وَالُو اَڒ غَا نْنغ بُوْلُس نشِّين. <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />ڒخُّو جْمَاعث ن لْحُكَّام ذ كنِّيو تَّارم زِي اَرَّايس ن ڒْعَسْكَار ن اَرُّوْمَانُوْس بَاش اَغَارْوم د يسّكّ بُوْلُس. ݣّث يخف نْوم ثخْسم اَكِذس ثݣّم لْإِسْتِجْوَاب مْلِيح. نشِّين اَقَانغ مُوْجُوْد بَاش اَث نْنغ قْبڒ إِي د غَا يَاوض."<verse eid="ACT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16" />مِّيس ن وتْشْمَاس ن بُوْلُس يَارَّا-د ڒخْبَار خ مِين شِيطِّينن يِوْذَان نِّي، ئِرُوْح غَار لْقشْلَا يُوْذف ذِنِّي يعَاوذ-اَس مَانَاينِّي إِ بُوْلُس. <verse eid="ACT 23:16" /><verse number="17" style="v" sid="ACT 23:17" />ئِڒَاغَا-د بُوْلُس خ يِجّن ن وعَسْكَارِي ذ اَمقّْرَان ن اَرُّوْمَانُوْس ينَّا-ٱس: "أَوِي اَحنْجِير-أَ غَار اَرَّايس نْوم اَقَا غَارس شَان وَاوَاڒ اَذَاس ث يِينِي."<verse eid="ACT 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 23:18" />يُوْوِي-ث غَار اَرَّايس ن ڒْعَسْكَار ينَّا-ٱس قَا يڒَاغَا-د خَافِي بُوْلُس اَمحْبُوْس نِّي يتَّار زَّايِي ينَّا-ٱيِي اَذَاش د اَوِيغ اَحنْجِير-أَ اَقَا غَارس شَان وَاوَاڒ اَذَاش ث يِينِي.<verse eid="ACT 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19" />أَرَّايس نِّي ن ڒْعَسْكَار يطّف اَحنْجِير نِّي ذݣ وفُوْس، يُوْوِي-ث غَار شَان ثْغمَّارْث وَاحْذس ينَّا-ٱس: "مِين تخْسذ اَذَايِي ثِينِيذ؟"<verse eid="ACT 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20" />ينَّا-ٱس وحنْجِير نِّي: "ئِسْرَائِيلِيْين تَّافَاقن جَارَاسن بَاش اَزَّايك تَّارن اَذ د تسّكّذ ثِيوشَّا بُوْلُس غَار جْمَاعث ن لْحُكَّام نْسن. ݣِّين يخف نْسن اَخْمِي خْسن اَذَاس ݣّن لْإِسْتِجْوَاب مْلِيح. <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />وَار ثن تجَّا شَا اَش سْقنْعن قَا ذِنِّي كْتَار زِي اَرْبعِين ن يرْيَازن وجّْذن إِ بُوْلُس، وعْذن أَربِّـي حَرّْمن يخف نْسن وَار تتّن وَار سسّن اَڒ ث غَا نْغن. أَقَا نِثْنِي وجّْذن، غِير تْرَاجَان اَذ تْوَافْقذ خ طَّلب نْسن!"<verse eid="ACT 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22" />ئِسّكّ اَرَّايس-أَ ن ڒْعَسْكَار اَحنْجِير نِّي ينَّا-ٱس: "وَار تْعَاوَاذ إِ حَدّ بلِّي شك ثنِّيذ-اَيِي إِ نش ڒخْبَار-أَ."<verse eid="ACT 23:22" /></para>
  <para style="s">تَاوِين اَرَّسُوْل بُوْلُس غَار لْوَالِي فِيلِيكْس</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23" />ڒخْدّنِّي يڒَاغَا-د اَرَّايس نِّي ن ڒْعَسْكَار إِ ثْنَاين ن يمقّْرَانن نّس ينَّا-ٱسن: "سْوجْذث مِيّتَاين ن ڒْعَسْكَار ذ سبْعِين ن يِنِّي إِي ينْيِين خ يِيْسَان ذ مِيّتَاين زݣ يِنِّي يكسِّين يكشُّوْضن غَارْسن ثِيشّط ن وُوْزّڒ، أَذ تْرَاحم غَار تسْعَا ن دْجِيڒث غَار ثنْدِينْت ن قَيْصَارِيَا. <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />سْوجْذث إِ بُوْلُس مِينْخف غَا يني بَاش اَث تْسِيوْضم ذِي لْأَمَان أُو ضّْمَان غَار لْوَالِي فِيلِيكس."<verse eid="ACT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 23:25" />أُوْشَا يُوْرَا يجّن ن ثبْرَات إِ لْوَالِي فِيلِيكس ينَّا-ٱس ذَايس: <verse eid="ACT 23:25" /><verse number="26" style="v" sid="ACT 23:26" />"آ سِي لْوَالِي فِيلِيكس، نش كْلُوْدْيُوْس لِيسْيَاس تْسدْجَامغ خَاك. <verse eid="ACT 23:26" /><verse number="27" style="v" sid="ACT 23:27" />أَرْيَاز-أَ طّْفن-ث أَيث-إِسْرَائِيل تُوْغَا عْڒَاين اَث نْغن. وَامِي د اَرِّيغ ڒخْبَار قَا نتَّا غَارس لْجِينْسِيَا ن اَرُّوْمَانُوْس، رُوْحغ نش ذ ڒْعَسْكَار ينُو نْسنْجم-يث-يذ. <verse eid="ACT 23:27" /><verse number="28" style="v" sid="ACT 23:28" />رزُّوْغ اَذ سّْنغ نش تُّهْمَاث إِي خَاس ݣِّين، ؤُوِيغ-ث غَار جْمَاعث ن لْحُكَّام نْسن. <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />ؤُفِيغ تُّهْمَاث نِّي نِثنْتِي ذ شَان ثْمسْڒَايِين خ شَّرِيعَا نْسن وَاهَا. وَار خَاس ؤُفِيغ بُو شَان تُّهْمَا يسْذَاهدْج خَاس ڒْموْث نِغ ذ ڒحْبس. <verse eid="ACT 23:29" /><verse number="30" style="v" sid="ACT 23:30" />وَامِي د اَرِّيغ ڒخْبَار شِيطّْنن خَاس، سّكّغ-ث-يذ غَارك ذغْيَا. ؤُمَرغ يِنِّي خَاس إِي ݣِّين تُّهْمَاث اَذَاش عَاوْذن مِين غَارْسن ضد نّس."<verse eid="ACT 23:30" /></para>
  <para style="p">
    <verse number="31‏-33" style="v" sid="ACT 23:31-33" />سّنِّي نفْذن ڒْعَسْكَار عْلَاحْسَاب مِين زِي ثن يُوْمَر. ؤُوِين بُوْلُس س دْجِيڒث غَار ثنْدِينْت ن أَنتِيپَـاتْرِيس. ثِيوشَّا نّس ذوْڒن-د ڒبْعَاض ن ڒْعَسْكَار غَار لْقشْلَا نْسن، يِنِّي إِي ينْيِين خ يِيْسَان كمّْڒن خ وبْرِيذ نْسن اَك بُوْلُس ؤُوْضن غَار قَيْصَارِيَا. كلّْفن ذِنِّي لْوَالِي خ بُوْلُس سلّْمن-اَس ثَبْرَات نِّي. <verse eid="ACT 23:31-33" /><verse number="34‏-35" style="v" sid="ACT 23:34-35" />وَامِي ت يغْرَا لْوَالِي ينَّا-ٱس إِ بُوْلُس مَان لْإِقْلِيم إِي غَار تْوَاحْسَابذ شك؟ وَامِي ذَاس ينَّا بُوْلُس نش زِي لْإِقْلِيم ن كِيلِيكْيَا ينَّا-ٱس لْوَالِي: "نش اَذ يڒِيغ خ لْجلْسَا نّش خْمِي د غَا اَوْضن يِنِّي إِي خَاك غَا ينِين تُّهْمَا." سّنِّي يُوْمَر اَخَاس عسّْسن ذِي ڒقْصَاڒ ن هِيرُوْدُوْس.<verse eid="ACT 23:34-35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="s">تْحَاكَامن خ اَرَّسُوْل بُوْلُس زَّاث إِ لْوَالِي فِيلِيكْس</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />منْبَعْد إِ خمْسِييَّام يهْوَا-د <char style="it">غَار قَيْصَارِيَا</char> اَرَّايس ن ڒْفُقَهَا أَنَاس اَكِذس ڒبْعَاض ن يمقّْرَانن ن أَيث-إِسْرَائِيل ذ يجّن ن لْمُحَامِي قَّارن-اَس تَارْتُوْلُوْس، تَاهَّامن بُوْلُس غَار لْوَالِي. <verse eid="ACT 24:1" /><verse number="2‏-3" style="v" sid="ACT 24:2-3" />ڒَاغَان-د خ بُوْلُس، ئِبْذَا تَارْتُوْلُوْس يتَاهَام-يث يقَّار: "آ سِي لْوَالِي فِيلِيكْس، نشِّين زِي سَّبَاب نّش نتْعِيش ذݣ يِجّن ن ڒهْنَا ذ اَمقّْرَان، أُو س وعْذڒ نّش ثْصڒْحذ مْلِيح ثُوْذَارْث نّغ ذِي ثْمُوْرْث-أَ. نشِّين نْقبّڒ مَانَايَا، نْشكَّر-يشك اَطَّاس ذي كُڒ ڒْوقْث ذ كُڒ اَمْشَان. <verse eid="ACT 24:2-3" /><verse number="4" style="v" sid="ACT 24:4" />وَلَكِن وَار خْسغ شَا اَش سْعطَّرغ اَطَّاس، تتَّارغ زَّايك عْلَاحْسَاب ڒْخَاضَر نّش اَغَارْنغ ثسْڒذ شْوَايْت.<verse eid="ACT 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 24:5" />أَرْيَاز-أَ وَانِيتَا نُوْفِي-ث يتْخَارْوَاض وَاهَا يتݣّ لْفِيتْنَا جَار مَارَّا يسْرَائِيلِيْين إِي دْجَان ذِي مَارَّا دُّنشْت. نتَّا ذ يجّن ن اَرَّايس ن لْبِدْعَا ن نَّصَارَا. <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />عَاوذ يرزُّو اَذ يسخْنز حتَّا ثَمْزِيذَا ثَمقّْرَانْت. نشِّين نطّف-يث {نخْس اَخَاس نحْكم عْلَاحْسَاب شَّرِيعَا نّغ. <verse eid="ACT 24:6" /><verse number="7" style="v" sid="ACT 24:7" />وَلَكِن يُوْسَا-د اَرَّايس ن ڒْعَسْكَار لِيسْيَاس يكّس-اَنغ-ث زݣ وفُوْس نّغ س لْقُوَّا. <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />يُوْمَر يِنِّي يتݣّن تُّهْمَاث بَاش اَغَارك د اَسن.} أَخْمِي ذَاس غَا ثݣّذ شك س يِيخف نّش لْإِسْتِجْوَاب اَذ تسّْنذ مِينْخف ث نْتَاهَام نشِّين." <verse eid="ACT 24:8" /><verse number="9" style="v" sid="ACT 24:9" />تَافْقن يسْرَائِيلِيْين خ تُّهْمَاث نِّي، قَّارن قَا مَانَاينِّي يݣِّي-ث ذ صَّح.<verse eid="ACT 24:9" /></para>
  <para style="s">أَرَّسُوْل بُوْلُس يتْذَافَاع خ يِيخف نّس</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />ئِشيَّر-اَس لْوَالِي إِ بُوْلُس بَاش اَذ يسِّيوڒ. ئِنْدق-د بُوْلُس ينَّا-ٱس: "نش سّْنغ مشْحَاڒ زݣ وَامِي شك ثْحكّْمذ خ ثْمُوْرْث-أَ. خ مَانَايَا فَرّْحغ بَاش اَذ ذَافْعغ خ يِيخف ينُو. <verse eid="ACT 24:10" /><verse number="11" style="v" sid="ACT 24:11" />ثْزمَّرذ اَذ تسّقْسِيذ نش يَالَّاه ثنْعَاشَر يُوْم زݣ وَامِي ݣَعّْذغ غَار لْقُدْس مَاشِي كْتَار، بَاش اَذ عبْذغ أَربِّـي. <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />وَار ذَايِي ؤُفِين شَا تْمنْغِيغ اَك شَان حَدّ ذِي ثمْزِيذَا ثَمقّْرَانْت، نِغ تْسَامَرغ ڒْغَاشِي ڒَا ذِي ثمْزِيذَاوِين ؤُڒَا ذِي ثنْدِينْت. <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />وَار غَارْسن بُو دَّلِيل خ تُّهْمَاث-أَ إِي خَافِي تْقدَّامن ڒخُّو. <verse eid="ACT 24:13" /><verse number="14" style="v" sid="ACT 24:14" />وَلَكِن قَّارغ-اَش نش تَعْتَرَافغ زَّاثش عبّْذغ أَربِّـي ن ڒجْذُوْذ نّغ عْلَاحْسَاب اَبْرِيذ-أَ إِي حسّْبن نِثْنِي زَعْمَا ذ لْبِدْعَا. تَامْنغ س مَارَّا مِين يتَافَاقن اَك شَّرِيعَا ذ مِين د يُوْرِين ذِي لْكُتُب ن لْأَنْبِيَا. <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />غَارِي لْأَمَال زِي أَربِّـي مَامش غَارْسن يدْجَا غَار يرْيَازن-أَ، يعْنِي اَذ د كَّرن زِي ڒْموْث صَّالِحِين ذ ضَّالِمِين. <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />فَلِهَاذَا تݣّغ مَارَّا جّْهذ ينُو بَاش اَذ عِيْشغ س يِجّن ن ضَّمِير مرْتَاح زَّاث إِ أَربِّـي ذ يِوْذَان.<verse eid="ACT 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17" />منْبَعْد إِ وَاطَّاس ن يسݣّْوُوْسَا عقْبغ-د <char style="it">غَار ثنْدِينْت ن لْقُدْس</char> ؤُوِيغ-د شَان ن صَّذَقَا إ لْأُمَّا ينُو، قدّْمغ شَا ن دْبِيحَاث. <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />وَامِي ذَايِـي ؤُفِين ذِي ثمْزِيذَا ثَمقّْرَانْت تݣّغ ڒُوْضُو. وَار ؤُفِين اَكِذِي بُو ڒْغَاشِي، وَار تݣّغ بُو سّْدَع. وَلَكِن ذِنِّي شَان ن يسْرَائِيلِيْين زِي لْإِقْلِيم ن آسْيَا، <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />ئِتْخصَّا نِثْنِي اَغَارك د اَسن س يِيخف نْسن ذَانِيتَا بَاش اَذ ينِين تُّهْمَاث إِي غَارْسن ضد ينُو. <verse eid="ACT 24:19" /><verse number="20" style="v" sid="ACT 24:20" />نِغ اَذَاش ينِين يِيْنَا إِي ذَا يبدّن مَان لْجَرِيمَا إي خَافِي ؤُفِين وَامِي بدّغ زَّاث إِ جْمَاعث ن لْحُكَّام نْسن. <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" />وَاش يمْكن خ وَاوَاڒ نِّي إِي نِّيغ س وڒَاغِي جَارَاسن وَامِي بدّغ ذِنِّي؟ نِّيغ-اَسن اَقَا كنِّيو تْحَاكَامم خَافِي نْهَارَا مِينْزِي تَامْنغ بلِّي يوْذَان اَذ د كَّرن زِي ڒْموْث ذِي لْقِيَامَا."<verse eid="ACT 24:21" /></para>
  <para style="s">ئِقِّيم اَرَّسُوْل بُوْلُس ذِي ڒحْبس ن قَيْصَارِيَا</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />فِيلِيكْس نتَّا يسّن مْلِيح خ وبْرِيذ-أَ <char style="it">ن عِيْسَى</char>، وَلَكِن ئِأَجّل لْحُكم نّس ينَّا-ٱسن: "حتَّا اَذ د يَاس اَرَّايس ن ڒْعَسْكَار لِيسْيَاس عَاذ إِي غَا حكْمغ خ مَانَايَا." <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />يُوْمَر يجّن ن ومقّْرَان ن ڒْعَسْكَار ينَّا-ٱس: "عسّ خ بُوْلُس ذِي ڒحْبس." ينَّا-ٱس: "وَلَكِن ؤُش-اَس شْوَايْت ن لْحُرِّيَا، اجّ يمدُّوْكَاڒ نّس اَغَارس د اَسن بَاش اَذَايس تْهِيلَّان."<verse eid="ACT 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24" />عْذُوْن شَان وُوْسَّان، يُوْسَا-د فِيلِيكْس اَكِذس ثَمْغَارْث نّس دْرُوْسِيلَا، نتَّاث ذ ثَئِسْرَائِيلِيث. ئِڒَاغَا-د خ بُوْلُس يصنّط-اَس وَامِي يسَّاوَاڒ خ لْإِيمَان زِي عِيْسَى لْمَسِيح. <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />وَامِي يسِّيوڒ بُوْلُس خ مِين يدْجَان نِيشَان، ذ مَامّش غَا يحْكم بْنَاذم خ يِيْخف نّس، ذ يُوْم لْحِسَاب ذ لْعِقَاب إِي د غَا يَاسن أُوْشَا ئِنخْڒع فِيلِيكْس ينَّا-ٱس: "صَافِي ڒخُّو، عْقب. خْمِي غَارِي غَا ثِيڒِي لْفُرْصَا اَخَاك د ڒَاغِيغ." <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />نتَّا عَاوذ فِيلِيكْس يرزُّو زِي بُوْلُس اَرّشْوث. س مَانَايَا يتْڒَاغَا-د خَاس اَطَّاس ن ثْوَاڒَاثِين يسَّاوَاڒ اَكِذس. <verse eid="ACT 24:26" /><verse number="27" style="v" sid="ACT 24:27" />عْذُوْن ثْنَاين ن يسݣّْوُوْسَا، ئِذْوڒ-د بُوْرْكْيُوْس فَسْتُوْس ذݣ ومْشَان ن لْوَالِي فِيلِيكْس. وَلَكِن فِيلِيكْس يݣَّا-ٱسن ڒْخَاضَر إِ يسْرَائِيلِيْين، يجَّا بُوْلُس ذِي ڒحْبس.<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="s">أَرَّسُوْل بُوْلُس يتسْتَانَاف دَّعْوث نّس غَار لْمَلِك قَيْصَر</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />فَسْتُوْس نتَّا يذْوڒ ذ لْوَالِي ذِي لْإِقْلِيم. وَامِي ثعْذُو ثڒْتِيَّام يݣَعّذ زِي ثنْدِينْت نِّي ن قَيْصَارِيَا غَار ثنْدِينْت ن لْقُدْس. <verse eid="ACT 25:1" /><verse number="2‏-3" style="v" sid="ACT 25:2-3" />أَرُّوْيَاس ن ڒْفُقَهَا ذ يمقّْرَانن ن أَيث-إِسْرَائِيل قدّْمن-اَس تُّهْمَاث نْسن ضذ إِ بُوْلُس. حشّْمن-ث تَّارن زَّايس اَذَاسن يݣّ ڒْخَاضَر نْسن بَاش اَثِيذ يَاوِي غَار لْقُدْس وَلَكِن نِثْنِي وجّْذن-اَس إِ بُوْلُس بَاش اَث نْغن ذݣ وبْرِيذ نِّي. <verse eid="ACT 25:2-3" /><verse number="4" style="v" sid="ACT 25:4" />ينَّا-ٱسن لْوَالِي قَا بُوْلُس اَقَاث ذِي ثنْدِينْت ن قَيْصَارِيَا ذ اَمحْبُوْس، ڒخُّو نش اَذ ذوْڒغ ذِنِّي. <verse eid="ACT 25:4" /><verse number="5" style="v" sid="ACT 25:5" />أُو لَابُد اَكِذِي رَاحن زَّايْوم ڒبْعَاض ن يمقّْرَانن نْوم. مڒَا يخْضَا ورْيَاز نِّي ذِي شَان ڒْحَاجث، قدّْمم-اَيِي-د تُّهْمَاث إِي غَارْوم ضذ نّس ذِنِّي.<verse eid="ACT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6" />ئِقِّيم فَسْتُوْس ذِي لْقُدْس مَا ثْمنييَّام مَا عشْرييَّام، منْبَعْد يهْوَا غَار قَيْصَارِيَا. ثِيوشَّا نّس، يݣَّا لْجلْسَا ذِي لْمَحْكَامَا يُوْمَر اَذَاس د اَوِين بُوْلُس. <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />وَامِي د يحْضَار ذِنِّي، مُوْنن-د خَاس يسْرَائِيلِيْين نِّي إي د يُوْسِين زِي لْقُدْس. تَاهَامن-ث س وَاطَّاس ن ثْمسْڒَايِين إِي وْعَارنْت وَلَكِن وَار غَارْسن بُو دَّلِيل.<verse eid="ACT 25:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 25:8" />ئِبْذَا بُوْلُس يتْذَافَاع خ يِيخف نّس ينَّا: "نش وَار خْضِيغ شَا ذِي مَانَاينِّي، نِغ ذِي شَّرِيعَا ن أَيث-إِسْرَائِيل نِغ ذِي ثمْزِيذَا ثَمقّْرَانْت نِغ ذِي لْمَلِك قَيْصَر."<verse eid="ACT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9" />وَلَكِن لْوَالِي فَسْتُوْس يرزُّو اَذ يݣّ ڒْخَاضَر إِ أَيث-إِسْرَائِيل أُوْشَا ينَّا-ٱس إِ بُوْلُس: "مَا ثخْسذ اَذ تْݣَعّْذذ غَار ثنْدِينْت ن لْقُدْس اَخَاك حكْمغ ذِنِّي نش خ تُّهْمَاث-أَ؟"<verse eid="ACT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 25:10" />ينَّا-ٱس بُوْلُس: "نش اَقَايِي بدّغ ذِي لْمَحْكَامَا-يَا ن لْمَلِك قَيْصَر، ئِتْخصَّا ذَا إِي غَا تْوَاحَاكْمغ. قَا أَيث-إِسْرَائِيل وَار ذَايْسن خْضِيغ شَا، مَامّش ثسّْنذ شك. <verse eid="ACT 25:10" /><verse number="11" style="v" sid="ACT 25:11" />مڒَا خْضِيغ يعْنِي ݣِّيغ شَان ڒْحَاجث سْذَاهدْجغ خَاس ڒْموْث وَار زمَّرغ اَزَّايس اَروْڒغ. وَلَكِن مڒَا تُّهْمَاث-أَ إِي خَافِي قدّْمن وَار دْجِينْت شَا ذ صَّح، ؤُڒَا ذ يجّن مَا غَارس ڒْحَقّ اَذَايي يسلّم إِ نِثْنِي. نش تسْتَانَافغ دَّعْوث ينُو غَار لْمَلِك قَيْصَر."<verse eid="ACT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12" />لْوَالِي فَسْتُوْس يسِّيوڒ اَك يمْشَاوَارن نّس أُوْشَا ينَّا-ٱس إِ بُوْلُس: "مڒَا شك دَّعْوث نّش ثسْتَانْفذ-ت غَار قَيْصَر، قَا غَار قَيْصَر إِي غَار غَا ثْرَاحذ."<verse eid="ACT 25:12" /></para>
  <para style="s">فَسْتُوْس يسَّاوَاڒ اَك ؤُزدْجِيذ أَغْرِيبَاس خ لْقَضِيَا ن بُوْلُس</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />عْذُوْن ڒبْعَاض ن وُوْسَّان، يُوْسَا-د وزدْجِيذ أَغْرِيبَاس اَكِذس <char style="it">وتْشْمَاس</char> بْرِيْنْكَا غَار ثنْدِينْت ن قَيْصَارِيَا بَاش اَذ سدْجْمن خ لْوَالِي فَسْتُوْس. <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />وَامِي ذِنِّي إِي قِّيمن اَطَّاس ن وُوْسَّان، ئِسِّيوڒ فَسْتُوْس اَك وزدْجِيذ خ لْقَضِيَا ن بُوْلُس. ينَّا-ٱس: "ذَانِيتَا يجّن ن ورْيَاز يجِّي-ث فِيلِيكْس ذ اَمحْبُوْس. <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />وَامِي رُوْحغ نش غَار لْقُدْس قدّْمن-اَيِي-د تُّهْمَاث اَرُّوْيَاس ن ڒْفُقَهَا ذ يمقّْرَانن ن أَيث-إِسْرَائِيل، تَّارن زَّايِي اَخَاس حكْمغ خ لْمُجْرِيم. <verse eid="ACT 25:15" /><verse number="16" style="v" sid="ACT 25:16" />نِّيغ-اَسن: عْلَاحْسَاب لْعَادَا ن اَرُّوْمَانُوْس وَار تْسلِّيمن حَدّ حتَّا ٱذ يمْقَابَاڒ اَك يِنِّي إِي خَاس يݣِّين تُّهْمَا، أَغَارس ثِيڒِي لْفُرْصَا اَذ يذَافع خ يِيخف نّس. <verse eid="ACT 25:16" /><verse number="17" style="v" sid="ACT 25:17" />إِذن، ثِيوشَّا نّس مُوْنن-د ذَانِيتَا قَا ݣِّيغ لْجلْسَا نّس ذِي لْمَحْكَامَا. تُوْغَا وَار عطَّاڒغ شَا، ؤُمَرغ بَاش اَثِيذ اَوِين. <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />كَّرن سِّيوْڒن ينِّي خَاس يقدّْمن تُّهْمَاث، ؤُفِيغ تُّهْمَاث نِّي إِي ݣِّين ضذ إِ بُوْلُس وَار دْجِينْت شَا ذ شَان لْجَرِيمَاث إِي تُوْغَا خْسغ اَذ سّْنغ نش. <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />لَّا، منْغن اَكِذس خ شَان ثْمسْڒَايِين ذِي دِّين نْسن ذ يِجّن ن ورْيَاز قَّارن-اَس عِيْسَى، قَا يمُّوْث وَلَكِن بُوْلُس يقَّار لَّا نتَّا يدَّر! <verse eid="ACT 25:19" /><verse number="20" style="v" sid="ACT 25:20" />وَامِي ودَّرغ نش وَار ؤُفِيغ مَامّش غَا بحْثغ ذِي ثْمسْڒَايِين-أَ، نِّيغ-اَس إِ بُوْلُس: مَا ٱذ تْرَاحذ غَار لْقُدْس اَخَاك حكْمغ ذِنِّي خ تُّهْمَاث-أَ؟ <verse eid="ACT 25:20" /><verse number="21" style="v" sid="ACT 25:21" />بُوْلُس يُوْݣِي، ئِكَّر يسْتَانف دَّعْوث نّس غَار قَيْصَر. ؤُمَرغ نش اَذ يقِّيم ذ اَمحْبُوْس اَڒ ث غَا سّكّغ إِ لْمَلِك قَيْصَر."<verse eid="ACT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22" />ينَّا-ٱس وزدْجِيذ أَغْرِيبَاس إِ فَسْتُوْس: "نش س يِيخف ينُو خْسغ اَذاس صنّْطغ إِ ورْيَاز-أَ."</para>
  <para style="p" vid="ACT 25:22">ينَّا-ٱس فَسْتُوْس: "ثِيوشَّا اَذَاس ثْصنّْطذ."<verse eid="ACT 25:22" /></para>
  <para style="s">أَرَّسُوْل بُوْلُس زَّاث إِ وزدْجِيذ أَغْرِيبَاس</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />ثِيوشَّا نّس، وَامِي د يُوْسَا وزدْجِيذ أَغْرِيبَاس ذ بْرِيْنْكَا س يجّن ن شَّان ذ اَمقّْرَان، ؤُذْفن غَار وخَّام ذ اَمقّْرَان ن ويْرَاو اَكِذس اَرُّوْيَاس ن ڒْعَسْكَار ن اَرُّوْمَانُوْس ذ يمقّْرَانن ن ثنْدِينْت. ڒخْدّنِّي يُوْمَر فَسْتُوْس ؤُوِين-د بُوْلُس. <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />ينَّا فَسْتُوْس: "آ سِي اَزدْجِيذ أَغْرِيبَاس ذ يرْيَازن يحْضَارن اَكِذْنغ مَارَّا! أَقَا تْوَاڒَام اَرْيَاز-أَ زَّاثْوم خَاس إِي ذَايِي قدّْمن تُّهْمَاث مَارَّا لْأُمَّا ن أَيث-إِسْرَائِيل ذِي لْقُدْس ؤُڒَا ذَانِيتَا <char style="it">ذِي قَيْصَارِيَا</char>. سْنكَّرن خَاس ثْغُوْيّث قَّارن لَابُد وَانِيتَا وَار يتْغِيمِي شَا عَاذ اَذ يدَّر! <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />نش وَار خَاس ؤُفِيغ بُو شَان ڒْحَاجث يسْذَاهدْج خَاس ڒْموْث. وَامِي يسْتَانف دَّعْوث نّس غَار لْمَلِك قَيْصَر، خْسغ اَغَارس ث سّكّغ. <verse eid="ACT 25:25" /><verse number="26" style="v" sid="ACT 25:26" />وَلَكِن نش وَار خَاس ؤُفِيغ بُو شَان ن تُّهْمَا نِيشَان حمَا اَذَاس ت اَرِيغ إِ سِي لْمَلِك قَيْصَر. س مَانَايَا سحْضَارغ-ث-يذ زَّاثْوم، خَاصَّتَن شك آ سِي اَزدْجِيذ أَغْرِيبَاس، بَاش مڒَا ثݣِّيم-اَس لْإِسْتِجْوَاب اَذ سّْنغ مِين خَاس غَا اَرِيغ. <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />نش تْوَاڒِيغ مَاشِي مَعْقُوْل اَذ سّكّغ شَان ومحْبُوْس بْڒَا مَا ٱذ اَرِيغ تُّهْمَاث إِي خَاس قدّْمن."<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="s">بُوْلُس يتْذَافَاع خ يِيخف نّس زَّاث إِ وزدْجِيذ أَغْرِيبَاس</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />ينَّا-ٱس وزدْجِيذ أَغْرِيبَاس إِ بُوْلُس: "قَا نشِّين نسْمح-اَش اَذ تْدَافْعذ خ يِيخف نّش."</para>
  <para style="p" vid="ACT 26:1">ئِشيَّر بُوْلُس س وفُوْس نّس يبْذَا يتْذَافَاع خ يِيخف نّس ينَّا-ٱس: <verse eid="ACT 26:1" /><verse number="2" style="v" sid="ACT 26:2" />"آ سَّعْذ ينُو نش آ سِي اَزدْجِيذ أَغْرِيبَاس وَامِي ذَايِي ثجِّيذ ٱذ ذَافْعغ خ يِيخف ينُو نْهَارَا زَّاثش شك خ مَارَّا تُّهْمَاث إِي زَّايِي تَهَامن أَيث-إِسْرَائِيل. <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />خَاصَّتَن مِينْزِي شك ثسّْنذ مَارَّا لْعَادَاث ن أَيث-إِسْرَائِيل ذ لْخِلَافَاث نْسن. س مَانَايَا تتَّارغ زَّايك اَذ تصْبَارذ اَذَايِي ثْصنّْطذ.<verse eid="ACT 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4" />قَا مَارَّا أَيث-إِسْرَائِيل سّْنن مَامّش تُوْغَا ثدْجَا ثُوْذَارْث ينُو زِي ثمْࢲِي ينُو إِي عِيشغ ذِي ثْمُوْرْث ينُو، عَاوذ ؤُڒَا ذِي ثنْدِينْت ن لْقُدْس. <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" />نِثْنِي سّْنن-اَيِي اَطَّاس زݣ وَامِي. مڒَا خْسن اَخَافِي شهْذن نش عِيشغ ذ اَفَرِّيسِي، ڒْحِزب نِّي يقسْحن اَطَّاس ذِي دِّين نّغ. <verse eid="ACT 26:5" /><verse number="6" style="v" sid="ACT 26:6" />شُوْف، مَايمِّي إِي دْجِيغ نش نْهَارَا ذِي لْمَحْكَامَا-يَا؟ لِأَنَّا غَارِي لْأَمَل زِي ڒْعَهذ نِّي إِي ذَانغ يُوْشَا أَربِّـي زِي ڒجْذُوْذ نّغ. <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />دْجِيڒث ذ نْهَار ثنْعَاش ن ثْقبَّاڒ ن أَيث-إِسْرَائِيل عبّْذن أَربِّـي مِنْزِي غَارْسن لْأَمَل ڒْعَهذ نِّي اَذ يِيڒِي. شُوْف، آ سِي اَزدْجِيذ، لْأَمَل-أَ نتَّا ذ تُّهْمَا إِي خَافِي نَّان أَيث-إِسْرَائِيل! <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />مَايمِّي ثنْوِيم قَا أَربِّـي وَار يتمْكِين شَا اَذ د يسْنكَّر يِنِّي يمُّوْثن زِي ڒْموْث؟<verse eid="ACT 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9" />نش قنْعغ س يِيخف ينُو تُوْغَا ضَارُوْرِي اَذ ݣّغ مَارَّا مِين زمَّرغ بَاش اَذ عَارّْضغ إِ يِيْسم ن عِيْسَى زِي نَاصِرَا. <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />أَمنِّي إِي ݣِّيغ ذِي ثنْدِينْت ن لْقُدْس. س اَرُّخْصَا ن اَرُّوْيَاس ن ڒْفُقَهَا تْحبَّاسغ اَطَّاس ن ڒْمُوْمِنِين صَّالِحِين. خْمِي خَاسن تَاحْكَامن س ڒْموْث، نش تَافَاقغ خ مَانَاينِّي. <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />مشْحَاڒ ن ثْوَاڒَاثِين تْرَاحغ زِي ثمْزِيذَا غَار ثمْزِيذَا تْعدَّابغ-ثن، رزُّوْغ اَذ سِّيوْڒن س بزّز ڒْعِيب ذِي أَربِّـي. س وغْضَاب نِّي ينُو تْرَاحغ حتَّا غَار ثْندَّام ذِي لْخَرِيج بَاش اَثن عدّْبغ ذِنِّي.<verse eid="ACT 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12" />س مَانَايَا إِي رُوْحغ <char style="it">يجّن ن نْهَار</char> غَار ثنْدِينْت ن دِمَشق، يْسِيغ-د اَرُّوْخْصَا ن اَرُّوْيَاس ن ڒْفُقَهَا ذ تّسْرِيح نْسن. <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />آ سِي اَزدْجِيذ، وَامِي ݣُّوْرغ غَار وزْين نْهَار ࢲْرِيغ يجّن ن نُّوْر ذݣ وجنَّا ثْفَاوْث نّس تْسقْسِيق كْتَار زِي ثْفُوْشْت، ئِنّض-اَيِي-د يتْشَعشِيع خَافِي نش ذ يِنِّي إِي كِذِي يݣُّوْرن. <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />نوْضَا مَارَّا غَار ثْمُوْرْث، سْرِيغ إِ يِجّن ن ثْمِيجَّا ثسَّاوَاڒ س لُّغَا لْعِبْرِيَا ثقَّار-ٱيِي-د: آ شَاوُل آ شَاوُل، مَايمِّي ذَايِي تْعدَّابذ؟ تݣّذ اَم ونِّي إِي ذِي ثدْجَا ثْغنَّانْت يسُوْݣُّوْر-يث أَربِّـي س ثْسنَّانْت.<note caller="+" style="f"><char style="fr" closed="false">26‏.14 </char><char style="ft" closed="false">لْجُمْلَا-يَا ثقَّار حَرْفِيَا س ثْيُوْنَانِيث: ئِقْسح خَاك اَذ تُوْوْثذ س يضَارن ثِيشّط وكشُّوْض قَا تْوَاشُوْكّذ زَّايس.</char></note> <verse eid="ACT 26:14" /><verse number="15" style="v" sid="ACT 26:15" />نِّيغ-اَس: مِين ثعْنِيذ شك آ سِيذِي؟ ينَّا-ٱيِي قَا نش ذ عِيْسَى ونِّي إِي تْعدَّابذ. <verse eid="ACT 26:15" /><verse number="16" style="v" sid="ACT 26:16" />ڒخُّو كَّر، بدّ خ يضَارن نّش. أَقَا نش مظْهَارغ-اَش-د بَاش اَش د يخْضَرغ اَذ تْذوْڒذ ذ اَخدَّام ينُو اَذ تِيڒِيذ ذ يجّن ن شَّاهذ خ مِين زَّايِي ثࢲْرِيذ ذ مِين عَاذ ذَاش د غَا سْبيّْنغ. <verse eid="ACT 26:16" /><verse number="17" style="v" sid="ACT 26:17" />أَش سْنجْمغ زِي لْأُمَّا نّش، أَش سْنجْمغ عَاوذ زݣ يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل. أَش سّكّغ غَارْسن <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" />بَاش اَذَاسن ثرزْمذ ثِيطَّاوِين نْسن، أَثن ثسْبعّْذذ زِي ثَادْجسْت غَار نُّوْر، اَثن ثسْبعّْذذ زِي سُّلْطَا ن شِّيطَان غَار أَربِّـي. أَمُّو اَذَاسن تْوَاغْفَرنْت ڒْمُعْصِيَاث نْسن اَغَارْسن يِيڒِي ومْشَان اَك صَّالِحِين يعْنِي س لْإِيمَان إِي ذَايِي إِي ݣِّين.<verse eid="ACT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19" />نش آ سِي اَزدْجِيذ أَغْرِيبَاس، وَار عْصِيغ شَا لْوَحِي نِّي إِي خَافِي د يهْوَان زݣ وجنَّا. <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" />لَّا، تْبشَّارغ ذ اَمزْوَارُو يمزْذَاغ ن ثنْدِينْت ن دِمَشق، عَاذ ذ يمزْذَاغ ن ثتْدِينْت ن لْقُدْس ذ مَارَّا جْوَايه ن ثْمُوْرْث ن يَهُوْذِيَا، ذ اَنݣَّارُو مَارَّا يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل. تْبشَّارغ-ثن اَذ تُوْبن اَذ ذوْڒن غَار أَربِّـي، أَذ خذْمن ڒخْذَايم ن تُّوْبَا يدْجَان ن صَّح. <verse eid="ACT 26:20" /><verse number="21" style="v" sid="ACT 26:21" />خ مَانَايَا طّْفن-اَيِي أَيث-إِسْرَائِيل ذِي ثمْزِيذَا ثَمقّْرَانْت، خْسن اَذَايِي نْغن. <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />وَلَكِن أَربِّـي يعَاون-اَيِي-د زِي قْبڒ حتَّا نْهَارَا. أَمُّو اَقَايِي نش ذَانِيتَا بدّغ، تْبشَّارغ س ومزْيَان ذ ومقّْرَان. قَّارغ غِير ثِمسْڒَايِين نِّي إِي نَّان لْأَنْبِيَا ذ مُوْسَى لَابُد اَذ وقْعنْت. <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" />يعْنِي، لْمَسِيح وَا لَابُد اَذ يتْوَاعدّب اَذ يبشَّر لْأُمَّا نّغ س نُّوْر ذ مَارَّا يِنِّي وَار يدْجِين شَا زِي أَيث-إِسْرَائِيل لِأَنَّا ذ نتَّا إِي د غَا يكَّرن ذ اَمزْوَارُو زِي ڒْموْث."<verse eid="ACT 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />بُوْلُس نتَّا اَقَاث عَاذ يسَّاوَاڒ يتْذَافَاع خ يِيخف نّس، ئِكَّر لْوَالِي فَسْتُوْس ينَّا-ٱس س جّْهذ: "آ بُوْلُس، شك مَا ثفْلِيپَّـاذ؟ ثْغُوْرِي نّش ثمْغَار قَا ثسْبُوْهڒِي-يِش!"<verse eid="ACT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25" />ينَّا-ٱس بُوْلُس: "آ سِي لْوَالِي فَسْتُوْس، لَّا نش وَار فْلِيپَّـاغ شَا. مِين قَّارغ ذ صَّح أُو س ڒَعْقڒ. <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />أَزدْجيذ أَغْرِيبَاس يسّن نتَّا مْلِيح خ مَانَايَا، نش رزُّوْغ اَكِذس سِّيوْڒغ س صَرَاحَا مَارَّا. نش مسْتقْنع وَار ثقِّيم ؤُڒَا ذ يجّن ن ڒْحَاجث زِي مَانَايَا وَار ت يسِّين شَا، لِأَنَّا وَار ثوْقِيع شَا ذِي شَان ن ثْغمَّارْث وَاهَا. <verse eid="ACT 26:26" /><verse number="27" style="v" sid="ACT 26:27" />آ سِي اَزدْجيذ أَغْرِيبَاس، شك مَا تَامْنذ س لْأَنْبِيَا؟ نش سّْنغ إِلَّا شك تَامْنذ."<verse eid="ACT 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28" />ينَّا-ٱس وزدْجِيذ أَغْرِيبَاس: "مَا س شْوَايْت ن ڒْوقْث ثَا شك ثنْوِيذ اَذَايِي ثَارّذ ذ اَمَسِيحِي؟"<verse eid="ACT 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 26:29" />ينَّا-ٱس بُوْلُس: "س شْوَايْت ن ڒْوقْث ثَا نِغ س وَاطَّاس، نش تتَّارغ زِي أَربِّـي إِ شك ذ يِنِّي إِي ذَايِي يتسْڒَان نْهَارَا اَذ تْذوْڒم اَم نش وَلَكِن بْڒَا سْنَاسڒ-أَ."<verse eid="ACT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30" />ئِكَّر ؤُزدْجِيذ ذ لْوَالِي ذ بْرِيْنْكَا ذ يِنِّي كِذْسن يقِّيمن. <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />فّْغن، نَّان إِ وَايَاوْيَا قَا بْنَاذم-أَ وَار يتݣّ شَا مِينْخف يسْذَاهدْج ڒْموْث نِغ ذ ڒحْبس." <verse eid="ACT 26:31" /><verse number="32" style="v" sid="ACT 26:32" />ينَّا-ٱس وزدْجِيذ أَغْرِيبَاس إِ لْوَالِي فَسْتُوْس: "بْنَاذم-أَ مَعْلِيك وَار يسْتَانف دَّعْوث نّس غَار قَيْصَر اَتَاف تُوْغَاث يتْوَاضْڒق."<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="s">ئِتْرَاح اَرَّسُوْل بُوْلُس غَار ثنْدِينْت ن رُوْمَا</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />وَامِي ؤُمَرن اَذَانغ سّكّن ذݣ وغَرَّابُو غَار ثْمُوْرْث ن إِطَالْيَا، سلّْمن بُوْلُس ذ ڒبْعَاض ن يمحْبَاس اَكِذس يجّن ن وعَسْكَارِي ذ اَمقّْرَان ن اَرُّوْمَانُوْس قَّارن-اَس يُوْلْيُوْس. نتَّا يُوْسَا-د زِي ڒْعَسْكَار نِّي ؤُمِي قَّارن &lt;لْفِرْقَا ن قَيْصَر.&gt; <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />نْݣَعّذ ذݣ يِجّن ن وغَرَّابُو يتْرَاحن ذِي ڒْوقْث نِّي زِي ڒْمُوْيِـي ن أَدْرَمِيت غَار ڒْمُوْيَاوَاث ن لْإِقْلِيم ن آسْيَا. ئِرُوْح اَكِذْنغ أَرِيْسْتَارْخُوْس، نتَّا زِي أَيث-مَاسِدُوْنْيَا زِي ثنْدِينْت ن سَالُوْنِيكْ.<verse eid="ACT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 27:3" />ثِيوشَّا نّس، وَامِي نُوْوض غَار ثنْدِينْت ن صَيْدَا يݣَّا ڒْخِير يُوْلْيُوْس ذِي بُوْلُس يجّ-يث اَذ يرَاح غَار يمدُّوْكَاڒ نّس بَاش اَذَايس تهِيلَّان. <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />سّنِّي نفّغ نْرُوْح ذݣ وغَرَّابُو ذِي جِّهث نِّي مَانِي يهدّن ڒبْحَر ن ثيْزِيرْث ن قُبْرُص، مِينْزِي اَرِّيح يشَّاث-اَنغ-د غَار وغمْبُوْب نّغ. <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />وَامِي نعْذُو ڒبْحَر نِّي إِي يدْجَان زَّاث إِ لْإِقْلِيم ن كِيلِيكْيَا ذ لْإِقْلِيم ن پَـامْفِيلْيَا، نُوْوض غَار ثنْدِينْت ن مِيْرَا ذِي لْإِقْلِيم ن لِيكْيَا. <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />يُوْفَا ذِنِّي وعَسْكَارِي نِّي اَمقّْرَان يجّن ن وغَرَّابُو يُوْسَا-د زِي ثنْدِينْت ن إِسْكَنْدَارِيَا يتْرَاح ذِي ڒْوقْث نِّي غَار ثْمُوْرْث ن إِطَالْيَا، ئِسْني-اَنغ ذَايس. <verse eid="ACT 27:6" /><verse number="7" style="v" sid="ACT 27:7" />أَطَّاس ن وُوْسَّان نشِّين يݣُّوْر زَّايْنغ وغَرَّابُو وَلَكِن يُوْيُوْر غِير شْوَايْت ن وبْرِيذ وَاهَا، منْبَعْد نعْذُو طَّارْف إِ ثنْدِينْت ن كَنِيْدُوْس. وَامِي اَرِّيح وَار ذَانغ يجِّي شَا أَ نْكمّڒ خ وبْرِيذ نِّي، نعْذُو سْوَادَّاي ن ثيْزِيرْث ن كْرِيت جِّهث ن قَابُو ن سَالْمُوْن. <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />س بزّز نُوْݣُّوْر طَّارْف طَّارْف ن ڒْبَرّ منْبَعْد نُوْوض غَار يِجّن ن ومْشَان قَّارن-اَس &lt;ڒْمَرْسَاث ثِصبْحَانِين&gt; نتَّا يُوْذس إِ وبِيلَاج ن لِيسْيَا.<verse eid="ACT 27:8" /></para>
  <para style="p">
    <verse number="9‏-10" style="v" sid="ACT 27:9-10" />ؤُسَّان ن ڒْعِيذ صَافِي عْذُوْن، تُوْغَا نعْظڒ اَطَّاس ن ڒْوقْث حتَّا وَامِي يذْوڒ وسَفَر نّغ ذِي ڒبْحَر ذَايس لْخَطَر. ئِكَّر بُوْلُس يعْڒم-اَسن ينَّا-ٱسن: "آ سِيَاذِي، قَا نش تْوَاڒِيغ اَسَفَر نّغ اَذ يِيڒِي ذ يجّن ن لْمُصِيبَا ذ يجّن ن ثْخسَّارْث ذ ثَمقّْرَانْت، مَاشِي غِير اَغَرَّابُو ذ سّڒْعَاث وَاهَا، وَلَكِن عَاوذ ؤُڒَا ذ ثُوْذَارْث نّغ." <verse eid="ACT 27:9-10" /><verse number="11" style="v" sid="ACT 27:11" />وَلَكِن اَعَسْكَارِي نِّي اَمقّْرَان وَار ذَاس يݣِّي شَا اَرَّاي إِ بُوْلُس، يݣَّا اَرَّاي إِ بَاب ن وغَرَّابُو ذ اَرَّايس نّس. <verse eid="ACT 27:11" /><verse number="12" style="v" sid="ACT 27:12" />لِأَنَّا ڒْمَرْسَا نِّي ذ ثَعفَّانْت بَاش اَذَايس سعْذُوْن ڒْمشْتَا ذِنِّي. خ مَانَايَا اَزْين اَمقّْرَان ݣِّين اَذ ؤُيُوْرن سّنِّي ذݣ وغَرَّابُو، تْمنَّان اَذ اَوْضن غَار وبِيلَاج ن فِيْنِيْكس اَذَايس سعْذُوْن ڒْمشْتَا. نتَّاث ذ يجّن ن ڒْمَرْسَا ذِي ثيْزِيرْث ن كْرِيت تظْهُوْر غَار لْجَانُوْب ذ شَّمَال ذِي جِّهث ن لْغَرْبِي.<verse eid="ACT 27:12" /></para>
  <para style="s">لْعَاصِفَا ذِي ڒبْحَر</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13" />وَامِي د يصُوْض يجّن ن اَرِّيح يفْسُوْس زِي لْجَنُوْب، ئِتْغِيڒ-اَسن ؤُفِين مِين رزُّوْن. سْݣَعّْذن-د اَڒِيزِيم<note caller="+" style="f"><char style="fr" closed="false">27‏.13 </char><char style="ft" closed="false">أَرِيزِيم نتَّا ذ اَݣرْزِيم وغَرَّابُو. أَرِيزِيم-أَ تْشدَّان-ث س وسْغُوْن. خْمِي يخس اَذ يُوْيُوْر وغَرَّابُو سْݣَعَّاذن-ث-يذ.</char></note> ن وغَرَّابُو رُوْحن ذِي ڒبْحَر طَّارف إِ ڒْبَرّ ن ثيْزِيرْث نِّي ن كْرِيت. <verse eid="ACT 27:13" /><verse number="14" style="v" sid="ACT 27:14" />وَلَكِن منْبَعْد شْوَايت يكَّر-د يجّن ن اَرِّيح يجْهذ يهْوَا-د زِي ثيْزِيرْث نِّي، أَرِّيح نِّي قَّارن-اَس &lt;أَسْمَاوِي.&gt;<note caller="+" style="f"><char style="fr" closed="false">27‏.14 </char><char style="ft" closed="false">أَسْمَاوِي نتَّا ذ اَرِّيح، ڒبْعَاض قَّارن-اَس أَغْمِي.</char></note> <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />لْعَاصِفَا نِّي ثُوْوِي اَغَرَّابُو، وَامِي وَار نْزمَّر شَا أَ نُوْيُوْر غَار زَّاث نجَّا اَغَرَّابُو نِّي اَث يَاوِي اَرِّيح. <verse eid="ACT 27:15" /><verse number="16" style="v" sid="ACT 27:16" />نْنُوْفَّر زِي اَرِّيح وَامِي نعْذُو سْوَادَّاي ن يِجّن ن ثيْزِيرْث ذ ثَمزْيَانْت قَّارن-اَس كَوْدَا. ئِزيَّار خَانغ اَطَّاس ڒْحَاڒ وَلَكِن نْركّن ثَغَرَّابُوْت ن لْإِغَاثَا، <verse eid="ACT 27:16" /><verse number="17" style="v" sid="ACT 27:17" />نسْݣَعّذ-يت-يد غَار وغَرَّابُو. ئِخدَّامن شدّن اَغَرَّابُو س يسغْوَان سْوَادَّاي بَاش وَار يتْرزِّي شَا. وَامِي ݣّْوْذن اَغَرَّابُو اَذ يُوْيُوْر اَذ ينَّاغ ذݣ يِجْذِي ن ڒبْحَر ن سُرْت، سهْوَان-د ڒقْڒُوْع<note caller="+" style="f"><char style="fr" closed="false">27‏.17 </char><char style="ft" closed="false">ڒقْڒَع وغَرَّابُو نتَّا ذ يجّن ن ڒْبَاشّ ن ثْشُوْقّت يتِيڒِي غَار وغَرَّابُو يتْصُوْض ذَايس اَرِّيح يݣُّوْر.</char></note> وغَرَّابُو جِّين اَرِّيح اَث يَاوِي. <verse eid="ACT 27:17" /><verse number="18" style="v" sid="ACT 27:18" />ثرْنِي لْعَاصِفَا نِّي، ثِيوشَّا نّس بْذَان نطَّارن سّڒْعَاث ذِي ڒبْحَر. <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />نْهَار وِيس ثڒْتِيَّام نْضَارن ڒْقشّ وغَرَّابُو ذِي ڒبْحَر س يفَاسّن نْسن. <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />ثقِّيم اَمنِّي لْعَاصِفَا نِّي، أَطَّاس ن وُوْسَّان وَار نࢲْرِي ثْفُوْشْت ؤُڒَا ذ يِيثْرَان. نشِّين ذݣ ونݣَّارُو نفْقذ لْأَمَل بلِّي أَ ننْجم.<verse eid="ACT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21" />وَامِي كِّين اَطَّاس ن ڒْوقْث وَار شِّين شَا اَغْرُوْم، ئِكَّر بُوْلُس ينَّا-ٱسن: "آي يرْيَازن، مَعْلِيك ذَايِي ثݣِّيم اَرَّاي وَار ثفِّيغم شَا زِي ثيْزِيرْث ن كْرِيت، أَتَاف قَا وَار خَاوم ثكِّي شَا تَمَارَا-يَا نِغ ذ ثْخسَّارْث-أَ. <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />ڒخُّو تتَّارغ زَّايْوم اَذ تِيڒِيم ذ يرْيَازن اَقَا وَار يتْمتِّي حَدّ زَّايْوم، غِير اَغَرَّابُو-يَا اَذ يرز وَاهَا. <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />شُوْف، دْجِيڒث-أَ ثَانِيتَا قَا ثْمظْهَار-اَيِي-د يجّن ن لْمَلَائِكَا ن أَربِّـي، أَربِّـي ونِّي ؤُمِي خدّْمغ نتَّا ذ بَاب ينُو. <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />ثنَّا-ٱيِي لْمَلَائِكَا نِّي: آ بُوْلُس وَار تݣّْوْذ شَا! وَا لَابُد اَذ تْبدّذ غَار لْمَلِك قَيْصَر. خْزَر عَاوذ، يِنِّي إِي كِذش يتْسَفَارن مَارَّا يسنْجم-يثن أَربِّـي اَكِذش." <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" /><char style="it">ينَّا-ٱسن بُوْلُس:</char> "إِيوَا إِڒِيث ذ يرْيَازن! قَا نش تَامْنغ زِي أَربِّـي مِين ذَايِي ينَّا اَذ يِيڒِي قَا ٱذ يِيڒِي. <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />وَلَكِن لَابُد اَذ ينَّاغ وغَرَّابُو-يَا غَار طَّارْف ن شَان ثيْزِيرْث."<verse eid="ACT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />ذِي دْجِيڒث نِّي وِيس اَربعْطَاشَر يُوْم نشِّين عَاذ نُوْݣُّوْر نْودَّر ذِي ڒبْحَر ن وَادْرِيَاتِيكِي، غَار ؤُزْين ن دْجِيڒث تْغِيڒ-اَسن إِ يخدَّامن ن وغَرَّابُو قَا تْقرَّابن غَار ڒْبَرّ. <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />عْبَرن ڒَادْجغ ن ڒبْحَر ؤُفِين سبْعَا أُو ثْڒَاثِين مِيتْرُو. ثعْذُو شْوَايْت ن ڒْوقْث، عَاوذ عْبَرن ؤُفِين <char style="it">غِير</char> سبْعَا أُو عِشْرِين مِيتْرُو. <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />ݣّْوْذن اَغَرَّابُو اَذ يڒْقف يزْرَا، نْضَرن زِي پُـوْپَّـا<note caller="+" style="f"><char style="fr" closed="false">27‏.29 </char><char style="ft" closed="false">پُـوْپَّـا قَّارن-ت إِ ذفَّار ن وغَرَّابُو.</char></note> ن وغَرَّابُو اَربْعَا ن يڒِيزَام<note caller="+" style="f"><char style="fr" closed="false">27‏.29 </char><char style="ft" closed="false">ئِڒِيزَام نِثْنِي ذ يݣرْزَام.</char></note> قِّيمن تْࢲَادْجَان بَاش اَذ يصْبح ڒْحَاڒ. <verse eid="ACT 27:29" /><verse number="30" style="v" sid="ACT 27:30" />ئِخدَّامن ن وغَرَّابُو وَامِي رزُّوْن اَذ اَروْڒن زَّايس، سهْوَان ثَغَرَّابُوْت ن لْإِغَاثَا غَار وَامَان سْنعْمِيڒن اَخْمِي خْسن اَذ نْضَرن يڒِيزَام زِي پْـرُوْبَا<note caller="+" style="f"><char style="fr" closed="false">27‏.30 </char><char style="ft" closed="false">پْـرُوْبَا قَّارن-ت إِ زَّاث وغَرَّابُو.</char></note> وغَرَّابُو. <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />ينَّا-ٱس بُوْلُس إِ وعَسْكَارِي نِّي اَمقّْرَان ذ ڒْعَسْكَار نِّي اَكِذس: "مڒَا وَار قِّيمن شَا يخدَّامن-أَ ذݣ وغَرَّابُو، وَار ثْزمَّرم شَا اَذ تْنجْمم." <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />ڒخْدّنِّي ڒْعَسْكَار قسّن يسغْوَان ن ثْغَرَّابُوْت ن لْإِغَاثَا جِّين-تث اَخَاسن ثْبعّذ.<verse eid="ACT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33" />وَامِي يبْذَا اَذ يصْبح ڒْحَاڒ، ئِكَّر بُوْلُس يتَّار زَّايْسن مَارَّا اَذ شّن شَا ن ڒْحَاجث ينَّا-ٱسن: "ثعْذُو اَرْبعْطَاشَر يُوْم تْرَاجَام وَاهَا ثدْجُوْزم، وَار ثشِّيم وَالُو. <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />ڒخُّو تتَّارغ زَّايْوم اَذ تشّم شَان ڒْحَاجث بَاش اَذ تقِّيمم ثدَّرم، وَار يوطِّي ؤُڒَا ذ يجّن ن وزُوْطُّو زݣ وزدْجِيف نْوم." <verse eid="ACT 27:34" /><verse number="35" style="v" sid="ACT 27:35" />وَامِي ينَّا اَوَاڒ-أَ، ئِكَّر ييْسِي-د اَغْرُوْم يشكَّر أَربِّـي زَّاثْسن مَارَّا، يرز-يث يبْذَا يتتّ-يث. <verse eid="ACT 27:35" /><verse number="36" style="v" sid="ACT 27:36" />شجّْعن مَارَّا إِذْسن شِّين. <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" />نشِّين لْعَدَد نّغ ذݣ وغَرَّابُو مِيّتَاين أُو ستَّا أَو سبْعِين ن يِوْذَان. <verse eid="ACT 27:37" /><verse number="38" style="v" sid="ACT 27:38" />وَامِي شِّين جِّيْوْنن، نْضَرن يرْذَان ذِي ڒبْحَر بَاش اَذ سْفسّن اَغَرَّابُو.<verse eid="ACT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39" />وَامِي د يصْبح ڒْحَاڒ، تْوَاڒَان شَا ن ثْمُوْرْث نِثْنِي وَار ت سِّينن شَا. ࢲْرِين يجّن ن لْخَلِيج ذِنِّي، شّطّ نّس ذَايس يجْذِي. ݣِّين اَغَارس سْقَارّْبن اَغَرَّابُو مڒَا زمَّرن-اَس. <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />قضْون يڒِيْزَام جِّين-ثن ذي ڒبْحَر، سرْخُوْن يسغْوَان إِي زِي تْوَاركّْنن دْمَامَاث.<note caller="+" style="f"><char style="fr" closed="false">27‏.40 </char><char style="ft" closed="false">دْمَامَاث نِّي نِثْنِي اَم ثْنَاين ن ڒمْقَادّف يمْغَارن تِيڒِين اَڒ ذفَّار وغَرَّابُو. ئِخدَّامن سْنقْڒَابن زَّايْسن لْإِتِجَاه وغَرَّابُو.</char></note> سْݣَعّْذن ڒقْڒَع ن زَّاث إِ اَرِّيح يتْصُوْضن، وجّْهن غَار ڒْبَرّ. <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />وَلَكِن اَغَرَّابُو يكَّا ذݣ يِجّن ن ويدِّيم ن يِجْذِي ذِي ڒْوسْط ن وَامَان ينُّوْغ ذَايس ذِنِّي. پْـرُوْبَا نّس ثنُّوْغ مْلِيح وَار تنْهزِّي شَا. پُـوْپَّـا نّس ثبْذَا تْرزَّا شَّاثن-ت ڒمْوَاج.<verse eid="ACT 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42" />ڒْعَسْكَار نْوَان اَذ نْغن يمحْبَاس بَاش وَار زَّايْسن يتْعُوْمِّي حَدّ اَذ يَرْوڒ. <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />وَلَكِن اَعسْكَارِي نِّي اَمقّْرَان يخس اَذ يسنْجم بُوْلُس، ئِسْبدّ-يثن خ مِين خْسن اَذ ݣّن. يُوْمَر يِنِّي يسّْنن اَذ عُوْمّن اَذ نضْون ذ يمزْوُوْرَا حمَا اَذ فّْغن غَار ڒْبَرّ. <verse eid="ACT 27:43" /><verse number="44" style="v" sid="ACT 27:44" />ئِنّغْنِي اَثن ذْفَارن خ ثْفڒْوِين نِغ خ ثڒْوِيحِين وغَرَّابُو. أَمنِّي إِي ݣِّين بَاش اَذ فّْغن مَارَّا إِذْسن غَار ڒْبَرّ اَذ نجْمن.<verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="s">أَرَّسُوْل بُوْلُس ذِي ثيْزِيرْث ن مَالْطَا</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />وَامِي ننْجم نُوْوض غَار ڒْبَرّ، نُوْفَا يسم ن ثيْزِيرْث نِّي قَّارن-اَس مَالْطَا. <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />ئِبَرْبَرِيْين ن ثْمُوْرْث نِّي ݣِّين ذَايْنغ ڒْخِير اَطَّاس. رحْبن زَّايْنغ مَارَّا، شعّْڒن-اَنغ ثِمسِّي مِينْزِي تُوْغَا ثسْمض عَاوذ يشَّاث ونْࢲَار. <verse eid="ACT 28:2" /><verse number="3" style="v" sid="ACT 28:3" />بُوْلُس يجْمع-د يكشُّوْضن، وَامِي ثن يسرْس ذِي ثْمسِّي يفّغ-د يجّن ن وفِيغر زِي ڒحْمُو، ئِقّس-اَس يڒْسق-اَس ذݣ وفُوْس. <verse eid="ACT 28:3" /><verse number="4" style="v" sid="ACT 28:4" />وَامِي ࢲْرِين يبَرْبَرِيْين فِيغر يڒْسق ذݣ وفُوْس ن بُوْلُس، نَّان جَارَاسن: نِيشَان اَرْيَاز-أَ وَانِيتَا ينْغَا شَان يِجّن. أَربِّـي نّغ ؤُمِي قَّارن &lt;لْإِرَادَا&gt; وَار ث يجِّي شَا اَذ يدَّر وَاخَّا ينْجم زِي ڒبْحَر. <verse eid="ACT 28:4" /><verse number="5" style="v" sid="ACT 28:5" />وَلَكِن بُوْلُس ينْضَر فِيغر نِّي ذِي ثْمسِّي وَار ذَاس يوْقِيع وَالُو. <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />ئِبَرْبَرِيْين نِّي تْرَاجَان مَا ٱذ يُوْفّ وَا إِمَا ذغْيَا اَذ يوْضَا اَذ يمّث. وَامِي ث رَاجَان اَطَّاس تْوَاڒَان-ث وَار ذَاس يوْقِيع وَالُو، ئِبدّڒ اَرَّاي نْسن نَّان وَانِيتَا ذ شَان يِجّن زِي أَربِّـيثن نّغ!<verse eid="ACT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7" />ڒْبَرّ-أَ وَانِيتَا يُوْذس غَار شَا ن ثْمُوْرَا ن اَرَّايس ن ثيْزِيرْث نِّي، نتَّا قَّارن-اَس پُـوْبْلِيُوْس. يرْحب زَّايْنغ، ئِسْنوْجو-اَنغ يكَرم-اَنغ ثڒْتِيَّام. <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />بَابَاس ن پُـوْبْلِيُوْس يتْنزْبَار ذِي ثَاسُّوْث يهْڒش س ثْمسِّي يتَازّڒ-اَس وعدِّيس. ئِرُوْح غَارس بُوْلُس غَار وخَّام نّس يࢲُّوْدْج، ئِسرْس خَاس يفَاسّن نّس يسْݣنْفَا-ث. <verse eid="ACT 28:8" /><verse number="9" style="v" sid="ACT 28:9" />يوْقع مَانَاينِّي، سّنِّي ؤُسِين-د غَارس يمهْرَاش ن ثيْزِيرْث نِّي مَارَّا يسْݣنْفَا-ثن بُوْلُس. <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />وقَّرن-اَنغ ؤُشِين-اَنغ اَطَّاس ن ثْمسْڒَايِين. وَامِي نكَّر أَ نفّغ ذݣ وغَرَّابُو، ذبَّرن-اَنغ-د ڒْقشّ نِّي إِي نحْذَاج.<verse eid="ACT 28:10" /></para>
  <para style="s">أَرَّسُوْل بُوْلُس يتَاوض غَار ثنْدِينْت ن رُوْمَا</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />منْبَعْد إِ ثڒْت شْهُوْر، نْݣَعّذ ذݣ يِجّن ن وغَرَّابُو زِي إِسْكَنْدَارِيَا تُوْغَا يسعْذُو ڒْمشْتَا ذِي ثيْزِيرْث نِّي. أَغَرَّابُو نِّي خ وغمْبُوْب نّس ذَايس لْأَصْنَام سمَّان-ثن &lt;ئِشْنِيون ن أَربِّـي.&gt; <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />نُوْوض غَار ثنْدِينْت ن سَرَقُوْسَا نقِّيم ذَايس ثڒْتِيَّام. <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />سّنِّي نْرُوْح ذݣ وغَرَّابُو غَار ثنْدِينْت ن رِيدْجو. ثِيوشَّا نّس، ئِكَّر-د يجّن ن اَرِّيح زِي لْجَنُوْب، نْهَار وِيس ثڒْتِيَّام نُوْوض غَار ڒْمُوْيِي ن بُوْتِسُوْلِي. <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />نُوْفَا ذِنِّي ڒبْعَاض ن اَيثْمَاثْنغ، عَرْضن-اَنغ أَ نقِّيم اَكِذْسن سبْع-يَّام. أَمنِّي إِي نُوْوض غَار ثنْدِينْت ن رُوْمَا.<verse eid="ACT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 28:15" />غَارْسن ڒخْبَار غَار اَيثْمَاثْنغ ذِي رُوْمَا نُوْسَا-د، فّْغن-د اَذَانغ د ڒْقَان حتَّا غَار سُّوْق ن وَابْيَان أُو حتَّا غَار ثْڒَاثَا ن ثُوْذْرِين ن يمْسَافَرن. وَامِي ثن يࢲْرَا بُوْلُس، ئِشكَّر أَربِّـي ئِتْوَاشجّع. <verse eid="ACT 28:15" /><verse number="16" style="v" sid="ACT 28:16" />نُوْذف ثَنْدِينْت ن رُوْمَا، ئِسْمح-اَس ڒْمخْزن إِ بُوْلُس اَذ يزْذغ وَاحْذس اَكِذس يقِّيم يجّن ن وعَسْكَارِي اَخَاس يعسّس.<verse eid="ACT 28:16" /></para>
  <para style="s">أَرَّسُوْل بُوْلُس يتْبشَّار ذِي ثنْدِينْت ن رُوْمَا</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />ثعْذُو ثڒْتِيَّام، يڒَاغَا-د بُوْلُس خ يمقّْرَانن ن أَيث-إِسْرَائِيل. وَامِي د مُوْنن ينَّا-ٱسن: "آي اَيثْمَا، نش وَار ݣِّيغ وَالُو ضد إِ شَّعْب نّغ نِغ ضد إِ لْعَادَاث ن ڒجْذُوْذ نّغ. وَاخَّا اَمنِّي طّْفن-اَيِي ذِي لْقُدْس سلّْمن-اَيِي إِ يفَاسّن ن اَرُّوْمَانُوْس. <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />نِثْنِي ݣِّين-اَيِي لْإِسْتِجْوَاب، خْسن اَذَايِي ضڒْقن مِينْزِي وَار خَافِي ؤُفِين بُو شَان تُّهْمَا إِي خف سْذَاهدْجغ ڒْموْث. <verse eid="ACT 28:18" /><verse number="19" style="v" sid="ACT 28:19" />وَامِي أَيث-إِسْرَائِيل عَارّْضن قَا وَار ؤُفِيغ إِلَّا اَذ سْتَانْفغ دَّعْوث ينُو غَار لْمَلِك قَيْصَر. وَلَكِن نش وَار ݣِّيغ بُو شَان تُّهْمَا خ لْأُمَّا ينُو. <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />إِذن خ مَانَايَا تَّارغ-كنِّيو اَكنِّيو ࢲرغ اَكِذْوم سِّيوْڒغ. أَقَا عْلَاحْسَاب لْأَمَل ن أَيث-إِسْرَائِيل إِي تْوَاشدّغ س سّنْسْڒث-أَ."<verse eid="ACT 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21" />نَّان-اَس: "وَار ذَانغ ذ ثُوْوِيض خَاك ؤُڒَا ذ يجّن ن ثبْرَات زِي جْوَايه ن يَهُوْذِيَا. زݣ يِنِّي إِي د يُوْسِين زِي اَيثْمَاثْنغ سّنِّي وَار ذَانغ يسِّيوڒ حَدّ خَاش، وَار خَاك ينِّي حَدّ ڒْعِيب. <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />وَلَكِن نخْس اَذَاش نْصنّط لْأَفْكَار نّش، مِينْزِي نسّن اَطَّاس ن يِوْذَان ذِي مْكُڒ اَمْشَان تْعَارَّاضن إِ ڒْحِزب-أَ وَانِيتَا."<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />تَّافْقن اَذ مڒْقن يجّن ن نْهَار، تْمَارْنِين-د ينّغْنِي ؤُسِين-د غَارس اَطَّاس إِذْسن غَار ثدَّارْث مَانِي يقِّيم بُوْلُس. ئِبْذَا يتْحدَّاث-يثن زِي صْبَاح اَڒ وَامِي د يُوْوض وعشِّي نتَّا يشهّذ س ڒْمُلْك ن أَربِّـي، ئِخس اَثن يسقْنع س شَّرِيعَا ن مُوْسَى ذ لْكُتُب ن لْأَنْبِيَا خ عِيْسَى. <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />ڒبْعَاض زَّايْسن قْتَانْعن س مِين ينَّا، ڒبْعَاض زَّايْسن وَار ؤُمِيْنن شَا. <verse eid="ACT 28:24" /><verse number="25" style="v" sid="ACT 28:25" />نِثْنِي وَار مسْفْهِيمن شَا اَك وَايَاوْيَا. قْبڒ مَا ٱذ فّْغن سّنِّي، ينَّا-ٱسن بُوْلُس اَوَاڒ-أَ ذ اَنݣَّارُو: "أَرُّوْح يقدّْسن ينَّا ڒْحَقّْ إِ ڒجْذُوْذ نْوم س يِيڒس ن نَّبِي إِشَعْيَا، ينَّا:<verse eid="ACT 28:25" /></para>
  <para style="q2">
    <verse number="26" style="v" sid="ACT 28:26" />&lt;رُوْح غَار شَّعْب-أَ إِنِي-يَاسن:</para>
  <para style="q1" vid="ACT 28:26">شْحَاڒ مَا تسْڒَام وَار ثْفهّْمم، شْحَاڒ مَا ثْخزَّرم وَار تْوِيڒِيم.<verse eid="ACT 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27" />ڒَاحقَّاش شَّعْب-أَ، ؤُڒَاون نْسن ذوْڒن اَم وزْرُو،</para>
  <para style="q1" vid="ACT 28:27">عْڒَاين وَار تسْڒِين وَالُو، قّْنن ثِيطَّاوِين نْسن.</para>
  <para style="q1" vid="ACT 28:27">حمَا وَار تْوِيڒِين س ثِيطَّاوِين نْسن،</para>
  <para style="q1" vid="ACT 28:27">وَار تسْڒِين س يمجَّان نْسن، وَار فهّْمن س وُوْڒَاون نْسن،</para>
  <para style="q1" vid="ACT 28:27">أَغَارِي د ذوْڒن اَثن سْݣنْفِيغ.&gt;<verse eid="ACT 28:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28" />إِيوَا يتْخصَّا اَذ تسّْنم ؤُڒَا ذ يِنِّي وَار يدْجِين شَا ذ يسْرَائِيلِيْين أَربِّـي اَثن يسنْجم، نِثْنِي اَذَاس سْڒن." <verse eid="ACT 28:28" /><verse number="29" style="v" sid="ACT 28:29" />{وَامِي ينَّا اَوَار-أَ، فّْغن أَيث-إِسْرَائِيل زَّايس تمْنَاقَارن س جّْهذ جَارَاسن.}<verse eid="ACT 28:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30" />ئِقِّيم بُوْلُس عَامَاين ذِي ثدَّارْث نِّي يتْخدْجَاس ڒكْرَا نتَّا س يِيخف نّس. ئِتْرحَّاب س يِنِّي إِي غَارس د يݣُّوْرن مَارَّا. <verse eid="ACT 28:30" /><verse number="31" style="v" sid="ACT 28:31" />ئِتْحدَّاث-يثن س ڒْمُلْك ن أَربِّـي، ئِسڒْمَاذ خ سِيذِيثْنغ عِيْسَى لْمَسِيح س يِجّن ن زْعَامث ذ لْحُرِّيَا.<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>