<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TI" style="id">- TarifitABS</book>
  <para style="h">1 تيموتاوس</para>
  <para style="toc3">1تيم</para>
  <para style="toc2">1 تيموتاوس</para>
  <para style="toc1">ثَبْرَات ثَمزْوَارُوْت ن اَرَّسُوْل بُوْلُس غَار تِيمُوْتَاوُس</para>
  <para style="mt1">ثَبْرَات ثَمزْوَارُوْت ن اَرَّسُوْل بُوْلُس غَار تِيمُوْتَاوُس</para>
  <chapter number="1" style="c" sid="1TI 1" />
  <para style="s">لْمُقَدِّمَا</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1" />نش ذ بُوْلُس ذ اَرَّسُوْل ن عِيْسَى لْمَسِيح س لْأَمَر ن أَربِّـي ونِّي إِي ذَانغ يسنْجَامن ذ عِيْسَى لْمَسِيح نتَّا ذ لْأَمَال نّغ. <verse eid="1TI 1:1" /><verse number="2" style="v" sid="1TI 1:2" /><char style="it">تَارِيغ ثَبْرَات-أَ</char> إِ تِيْمُوْتَاوُس ونِّي إِي يدْجَان اَم ممِّي ذ صَّح ذِي لْإِيمَان. أَكِذش يِيڒِي اَرْضَا ذ اَرَّاحْمث ذ ڒهْنَا زِي أَربِّـي بَابَاثْنغ ذ عِيْسَى لْمَسِيح سِيذِيثْنغ.<verse eid="1TI 1:2" /></para>
  <para style="s">يِنِّي يسڒْمَاذن يخَرِّيقن وَاهَا</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3" />نش وَامِي رُوْحغ غَار لْإِقْلِيم ن مَسِدُوْنْيَا وصِّيغ-شك اَذ تقِّيمذ ذِي ثنْدِينْت ن ؤُفَسُوْس بَاش اَذ تنْهِيذ شَان يرْيَازن اَذَاسن ثِينِيذ وَار سڒْمَاذم شَا ثِمسْڒَايِين إِݣ يتْخَلَافن ذِي لْإِيمَان. <verse eid="1TI 1:3" /><verse number="4" style="v" sid="1TI 1:4" />أَذَاسن ثِينِيذ وَار ذفَّارم شَا ثِحُوْجَا نِغ ذ ثَشجَّارْث نِّي وَار يقطِّين شَا خ ڒجْذُوْذ نْوم. ثِمسْڒَايِين-أَ اَم ثِيْنَا غِيڒ تْسجَّاعنْت-اَنغ بَاش أَ نْودَّار ذِي لْأَفْكَار يخْوَان، وَار ذَانغ ثْسِيوِّيْضنْت شَا غَار مِين يتْخطّط أَربِّـي مِينْزِي مِين ذَانغ يسَاوَّاضن غَار أَربِّـي نتَّا ذ لْإِيمَان. <verse eid="1TI 1:4" /><verse number="5" style="v" sid="1TI 1:5" />مِين يعنَا لْغَرَض ن ڒُوْصِيّث-أَ؟ لْغَرَض نّس ذ يجّن ن ڒمْحِبّث إِي د يتَاسن زݣ وُوْڒَاون يصْفَان ذ يِجّن ن ضَّمِير ذ اَصبْحَان ذ يِجّن ن لْإِيمَان بْڒَا نِّفَاق. <verse eid="1TI 1:5" /><verse number="6" style="v" sid="1TI 1:6" />ڒبْعَاض فّْغن زِي ثْمسْڒَايِين-أَ ؤُذْفن ذݣ وَاوَاڒن إِي يخْوَان. <verse eid="1TI 1:6" /><verse number="7" style="v" sid="1TI 1:7" />رزُّوْن اَذ دوْڒن ذ يمْسڒْمَاذن ن شَّرِيعَا، وَلَكِن وَار فهّْمن شَا مِين قَّارن ؤُڒَا ذ مِينْخف تْأَكَّادن اَطَّاس.<verse eid="1TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8" />شَّرِيعَا-يَا مڒَا يسْتعْمل-يت بْنَاذم نِيشَان، نشِّين نسّن-يت ذ ثَصبْحَانْت. <verse eid="1TI 1:8" /><verse number="9" style="v" sid="1TI 1:9" />نسّن شَّرِيعَا-يَا عَاوذ وَار د ثخْرِيق شَا إِ يِنِّي يسمْصْڒَاحن اَك أَربِّـي. لَّا، ثخْڒق-د إِ يِنِّي يدْجَان ذ يعفَّانن ذ يِنِّي إِي ذِي ثدْجَا ثْغنَّانْت ذ يِنِّي وَار يذفِّيرن شَا أَربِّـي ذ يِنِّي يعصَّان ذ يِنِّي وَار يصْفِين شَا ذ يِنِّي وَار غَار يدْجِي بُو دِّين ذ يِنِّي ينقّن بَابَاثْسن ذ يمَّاثْسن ذ يِنِّي ينقّن يوْذَان <verse eid="1TI 1:9" /><verse number="10" style="v" sid="1TI 1:10" />ذ يِنِّي يتݣّن لْفَسَاد ذ يرْيَازن يفسّْذن اَك وَايَاوْيَا ذ يِنِّي يتَاشَارن يوْذَان حمَا اَثن اَرّن ذ يسمْغَان ذ يِنِّي يقَّارن يخَرِّيقن ذ يِنِّي يشهّْذن ࢲُّوْر نِغ ذ يِنِّي يتݣّن شَان ن ثْمسْڒَايِين نّغْنِي يدْجَان ضد إِ تَّعْلِيم ن لْإِيمَان يدْجَان نِيشَان. <verse eid="1TI 1:10" /><verse number="11" style="v" sid="1TI 1:11" />تَّعْلِيم-أَ يدْجَان نِيشَان اَث نَاف ذِي لْإِنْجِيل ن أَربِّـي لْعَظِيم إِݣ يتْوَابَرْكن. لْإِنْجِيل-أَ يكلّف-اَيِي-د خَاس نش اَم يِجّن ن لْأَمَنَا.<verse eid="1TI 1:11" /></para>
  <para style="s">أَرَّسُوْل بُوْلُس يتْشكَّر سِيذِيثْنغ خ اَرْضَا نّس</para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12" />تْشكَّرغ سِيذِيثْنغ عِيْسَى لْمَسِيح ونِّي إِي ذَايِي يُوْشِين جّْهذ نّس يُوْفَا ذَايِي تِّقث يسِيذف-اَيِي غَار ڒْخذْمث نّس. <verse eid="1TI 1:12" /><verse number="13" style="v" sid="1TI 1:13" />نش قْبڒ تُوْغَا قَّارغ اَوَاڒن وَار يحْڒِين خ أَربِّـي تْعدَّابغ ڒْمُوْمِنِين، نش ذ يجّن بْنَاذم يضدْجْمن. وَاخَّا تُوْغَا خذْمغ مَانَاينِّي يسظْهَار-اَيِي-د أَربِّـي اَرَّاحْمث نّس لِأَنَّا خذْمغ مَانَاينِّي س ڒقْفَاڒث ينُو بْڒَا مَا ٱذ سّْنغ مِين يدْجَان نِيشَان، ؤُڒ ينُو وَار ذَايس بُو لْإِيمَان. <verse eid="1TI 1:13" /><verse number="14" style="v" sid="1TI 1:14" />أَرْضَا ن سِيذِيثْنغ ينْفيّض-د خَافِي س وَاطَّاس ذ وَاطَّاس، أَكِذس يجّن ن لْإِيمَان ذ يِجّن ن ڒمْحِبّث إِݣ يدْجَان ذِي عِيْسَى لْمَسِيح.<verse eid="1TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 1:15" />أَقَا يجّن ن وَاوَاڒ ذَايس تِّقث أُو لَابُد اَذ يتْوَاقْبڒ مَارَّا، يعْنِي عِيْسَى لْمَسِيح يُوْسَا-د غَار دُّنشْت-أَ بَاش اَذ يسنْجم يِنِّي يعصَّان، زَّايْسن نش إِݣ يدْجَان ذ لْعَاصِي ذ اَمقّْرَان خَاسن مَارَّا. <verse eid="1TI 1:15" /><verse number="16" style="v" sid="1TI 1:16" />وَامِي نش ذ لْعَاصِي ذ اَمقّْرَان خَاسن مَارَّا يسظْهَار-اَيِي-د أَربِّـي اَرَّحْمث نّس بَاش عِيْسَى لْمَسِيح اَزَّايِي د يسْمظْهَار مَارَّا صْبَار نّس اَذ يِيڒِي مَانَايَا ذ يجّن ن لْمِثَال إِ يِنِّي إِي زَّايس غَا يَامْنن اَغَارْسن ثِيڒِي ثُوْذَارْث ن ڒبْدَا. <verse eid="1TI 1:16" /><verse number="17" style="v" sid="1TI 1:17" />اَزدْجِيذ نّغ اَغَارس ثِيڒِي لْعَظَمَا إِ ڒبْدَا ن ڒبْدَاث، ونِّي عمَّارْص اَذ يفْنَا عمَّارْص اَذ يمّث ونِّي وَار ث يتْوِيڒِي حَدّ ونِّي يدْجَان ذ أَربِّـي وَاحْذس. آمِين.<verse eid="1TI 1:17" /></para>
  <para style="s">لْمَسْؤُلِيَا إِݣ يتِيشّ اَرَّسُوْل بُوْلُس إِ تِيمُوْتَاوُس</para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18" />آ وُلِدِي تِيْمُوْتَاوُس، أَذَاش ؤُشغ لْمَسْؤُلِيَا-يَا ثَانِيتَان عْلَاحْسَاب اَوَاڒن نِّي إِي خَاش نَّان لْأَنْبِيَا زِي قْبڒ بَاش خْمِي خَاسن غَا ثْعقْڒذ اَتَاف اَذ تْمنْغذ مْلِيح اَمنْغِي-يَا اَصبْحَان، <verse eid="1TI 1:18" /><verse number="19" style="v" sid="1TI 1:19" />أَتَاف اَغَارش يِيڒِي لْإِيمَان نّش ذ يِجّن ضَّمِير ذ اَصبْحَان. مَاشِي اَم ڒبْعَاضِيث سمْحن ذِي مَانَايَا أُوْشَا لْإِيمَان نْسن يغَرق اَم يِج وغَرَّابُو ذِي ڒبْحَر. <verse eid="1TI 1:19" /><verse number="20" style="v" sid="1TI 1:20" />زَّايْسن حِمِّيت ذ إِسْكَنْدر، جِّيغ-ثن نش إِ شِّيطَان حمَا اَذ تْوَاربَّان وَار قَّارن شَا اَوَاڒن نِّي وَار يحْڒِين خ أَربِّـي.<verse eid="1TI 1:20" /></para>
  <chapter eid="1TI 1" />
  <chapter number="2" style="c" sid="1TI 2" />
  <para style="s">ڒُوْصِيَاث خ لْعِبَادَا</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1" />ذ اَمزْوَارُو تْوصِّيغ-كنِّيو اَذ تتَّارم إِ أَربِّـي اَث تدْعِيم اَث طلْبم اَث تْشكَّرم خ مَارَّا يوْذَان <verse eid="1TI 2:1" /><verse number="2" style="v" sid="1TI 2:2" />ذ يزدْجِيذن ذ مَارَّا يِنِّي يحكّْمن بَاش أَ نْعِيشث ذݣ يِجّن ن ڒهْنَا بْڒَا سّْدَع ذݣ يِجّن ن طَّاعَا ن أَربِّـي ذ يِجّن ن لْمَعْقُوْل. <verse eid="1TI 2:2" /><verse number="3" style="v" sid="1TI 2:3" />مَانَايَا ذ اَصبْحَان يَارْضَا خَاس أَربِّـي إِي ذَانغ د يسْنجْمن، <verse eid="1TI 2:3" /><verse number="4" style="v" sid="1TI 2:4" />يخس مَارَّا يوْذَان اَذ تْوَاسْنجْمن اَذ اَوْضن اَذ سّْنن لْحَقِيقَا. <verse eid="1TI 2:4" /><verse number="5" style="v" sid="1TI 2:5" />لِأَنَّا ذِنِّي يجّن ن أَربِّـي وَاحْذس ذ يِجّن لْوَاسِيط وَاحْذس جَار أَربِّـي ذ يِوْذَان يعْنِي اَرْيَاز-أَ ذ عِيْسَى لْمَسِيح. <verse eid="1TI 2:5" /><verse number="6" style="v" sid="1TI 2:6" />نتَّا يصدّق ثُوْذَارْث نّس ذ يجّن ن لْفِدْيَا بَاش اَزَّايس يسنْجم مَارَّا يوْذَان، مَانَايَا اَذ يتْوَاشْهذ ذِي ڒْوقْث نّس. <verse eid="1TI 2:6" /><verse number="7" style="v" sid="1TI 2:7" />خ مَانَاينِّي إِي تْوَاخْضَرغ نش بَاش اَذ حدّْثغ اَذ يڒِيغ ذ اَرَّسُوْل اَذ يڒِيغ ذ اَمْسڒْمَاذ عْلَاحْسَاب لْإِيمَان ذ ڒْحَقّ جَار يِنِّي وَار يدْجِين شَا زِّي أَيث-إِسْرَائِيل. قَّارغ لْمَعْقُوْل مَاشِي ذ يخَرِّيقن. <verse eid="1TI 2:7" /><verse number="8" style="v" sid="1TI 2:8" />فَلِيهَذَا خْسغ يرْيَازن ذِي مَارَّا يمُوْشَان اَذ ࢲَّادْجن اَذ يْسِين يفَاسّن نْسن يصْفَان غَار وجنَّا بْڒَا مَا ٱذ تْعصّْبن بْڒَا مَا ٱذ تْمنْغَان.<verse eid="1TI 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 2:9" />أَمنِّي عَاوذ خْسغ ثِمْغَارِين اَذَايْسنْت يِيڒِي لْإِحْتِرَام اَذَايْسنْت يِيڒِي ڒحْيَا ذ لْمَعْقُوْل، مَاشِي اَذ قِّيمنْت س وشوَّاف يضْڒق اَطَّاس نِغ س دّْهب ذ جُّوْهَار ذ وَارُّوْض إِي يغْڒَان. <verse eid="1TI 2:9" /><verse number="10" style="v" sid="1TI 2:10" />لَّا، أَذ صَارنْت يخف نْسنْت س لْحَسَانَاث إِݣ يدْجَان لَابُد ذِي ثمْغَارِين نِّي يقَّارن قَا نشِّين نْعبّذ أَربِّـي.<verse eid="1TI 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 2:11" />ثَمْغَارْث أُو لَابُد اَذ تڒْمذ س طَّاعَا ذ ڒْهُدْنث. <verse eid="1TI 2:11" /><verse number="12" style="v" sid="1TI 2:12" />نش وَار تجِّيغ شَا ثَمْغَارْث اَذ تْسڒْمذ اَرْيَاز نِغ اَخَاس ثحْكم؛ لَّا، لَابُد اَذ تِيڒِي مْهدْنَا. <verse eid="1TI 2:12" /><verse number="13" style="v" sid="1TI 2:13" />مَايمِّي؟ أَربِّـي يخْڒق-د آدَم ذ اَمزْوَارُو، عَاذ إِي د يخْڒق حَوَّا. <verse eid="1TI 2:13" /><verse number="14" style="v" sid="1TI 2:14" />عَاوذ آدَم وَار ث يشْمِيث شَا شِّيطَان، ذ ثَمْغَارْث يتْوَاشمْثن ثعْصَا أَربِّـي. <verse eid="1TI 2:14" /><verse number="15" style="v" sid="1TI 2:15" />ثَمْغَارْث اَذ تْوَاسنْجم عْلَاحْسَاب ثَارْوَا وَلَكِن يتْخصَّا وَا لَابُد اَذ قِّيمنْت نِثنْتِي ذِي لْإِيمَان ذ ڒمْحِبّث ذ ڒصْفِيّث عْلَاحْسَاب لْمَعْقُوْل.<verse eid="1TI 2:15" /></para>
  <chapter eid="1TI 2" />
  <chapter number="3" style="c" sid="1TI 3" />
  <para style="s">يِنِّي يتْرَايَّان خ جْمَاعث ن ڒْمُوْمِنِين</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1" />أَقَا يجّن ن وَاوَاڒ ذَايس تِّقث يعْنِي ونِّي يرزُّوْن اَذ يِيڒِي ذ اَرَّايس ن جْمَاعث قَا يرزُّو يجّن ن ثْمسْڒَايْث ذ ثَصبْحَانْت. <verse eid="1TI 3:1" /><verse number="2" style="v" sid="1TI 3:2" />فَا اَرَّايس ن جْمَاعث مَاشِي اَم يِجّن ن بْنَاذم إِي تْعيَّابن يِوْذَان. أُو لَابُد اَغَارس ثِيڒِي يجّن ن ثمْغَارْث وَاهَا. أُو لَابُد اَذ يحْكم خ يِيخف نّس اَذَايس يِيڒِي لْمَعْقُوْل ذ لْإِحْتِرَام اَذ يتْرحَّاب زݣ ينوْجِيون اَغَارس ثِيڒِي ثْزمَّار اَذ يسڒْمذ يوْذَان. <verse eid="1TI 3:2" /><verse number="3" style="v" sid="1TI 3:3" />ئِتْخصَّا وَار يتݣّ شَا لْمَدلَّا ن سّكْرَا، وَار يشِّيث شَا اَذ يِيڒِي تْرَانْكِيڒ. ئِتْخصَّا وَار يتْمنْغِي شَا س وَاوَاڒ، وَار يظمّع شَا ذِي تْمنْيَاث. <verse eid="1TI 3:3" /><verse number="4" style="v" sid="1TI 3:4" />أَذ يِيڒِي ذ يجّن ن بْنَاذم إِݣ يحكّْمن خ ثدَّارْث نّس مْلِيح، تْطَاعَان-اَس يحنْجِيڒن نّس تْسذْحَان-ث. <verse eid="1TI 3:4" /><verse number="5" style="v" sid="1TI 3:5" />إِيوَا بْنَاذم-أَ مڒَا وَار يسِّين شَا اَذ يحْكم خ ثدَّارْث نّس، مَامّش إِي غَا يݣّ اَذ يتْرَايَا خ جْمَاعث ن ڒْمُوْمِنِين ن أَربِّـي؟ <verse eid="1TI 3:5" /><verse number="6" style="v" sid="1TI 3:6" />أَرَّايس-أَ، مَاشِي يَالَّاه إِي يسْڒم اَذ يُوْفّ س تَّكبُّر <char style="it">خ ڒْخذْمث-أَ</char> اَذ يوْضَا ذِي لْعُقُوْبَا نِّي ن إِبْڒِيس. <verse eid="1TI 3:6" /><verse number="7" style="v" sid="1TI 3:7" />أُو لَابُد عَاوذ اَث وقَّرن يِنِّي يدْجَان ن بَارَّا وَار يدْجِين شَا ذ ڒْمُوْمِنِين بَاش وَار خَاس تْعيِّيبن شَا يِوْذَان وَار يوطِّي شَا ذِي ثخْشبْث نِّي ن إِبْڒِيس.<verse eid="1TI 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8" />أَمنِّي عَاوذ يمْسخَّارن أُو لَابُد اَذ يڒِين مْوقّرِين اَغَارْسن يِيڒِي وَاوَاڒ، أَتَاف وَار سسّن شَا اَطَّاس ن شّْرب وَار ظمّْعن شَا ذِي ڒوْسخ ن دُّنشْت-أَ. <verse eid="1TI 3:8" /><verse number="9" style="v" sid="1TI 3:9" />ئِمْسخَّارن-أَ يتْخصَّا لَابُد اَذ طّْفن ذِي ڒْمَعْنَا ينُوْفَّرن ن لْإِيمَان س يِجّن ن ضَّمِير يصْفَا. <verse eid="1TI 3:9" /><verse number="10" style="v" sid="1TI 3:10" />ذ اَمزْوَارُو اَذ تْوَاجَرّْبن. مڒَا وَار ذِنِّي شَان ن ثْمسْڒَايْث ضذ نْسن، أَتَاف اَذ ذوْڒن ذ يمْسخَّارن.<verse eid="1TI 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 3:11" />أَمنِّي عَاوذ ثِمْغَارِين يتْخصَّا اَذ يڒِينْت مْوقّرِينْت وَار ذَايْسنْت تِيڒِي شَا نَّمِيمَا اَذ حكّْمنْت خ يِيخف نْسنْت اَذَايْسنْت ثِيڒِي تِّقث ذِي مَارَّا ثِمسْڒَايِين.<verse eid="1TI 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 3:12" />ئِمْسخَّارن يتْخصَّا أُو لَابُد اَذ يڒِين ذ يرْيَازن ن يِجّن ن ثمْغَارْث وَاهَا، أَذ حكّْمن خ يحنْجِيرن ذ ثُوْذْرِين نْسن مْلِيح. <verse eid="1TI 3:12" /><verse number="13" style="v" sid="1TI 3:13" />أَقَا يمْسخَّارن إِݣ يخدّْمن مْلِيح اَذ ربْحن إِ يِيخف نْسن يجّن ن دَّرَجَا ذ ثَصبْحَانْت ذ يِجّن ن تِّقث ذِي لْإِيمَان نْسن إِݣ يدْجَان ذِي عِيْسَى لْمَسِيح.<verse eid="1TI 3:13" /></para>
  <para style="s">سَّبَاب ن ڒُوْصِيَاث-أَ ن اَرَّسُوْل بُوْلُس</para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14" />ثِمسْڒَايِين-أَ تَارِيغ-ثنْت-يد إِ شك، نش تْمنِّيغ اَغَارش د اَسغ ذغْيَا. <verse eid="1TI 3:14" /><verse number="15" style="v" sid="1TI 3:15" />مڒَا طوّْلغ اَطَّاس وَار ذِنِّي د ؤُسِيغ شَا، أَتَاف اَذ تسّْنذ شك مَامش إِي غَا سُوْݣُوْرن يِوْذَان يخف نْسن ذِي ثدَّارْث ن أَربِّـي يعْنِي جْمَاعث ن ڒْمُوْمِنِين ن أَربِّـي يدَّرن ذ نتَّاث إِي يدْجَان ذ اَپِـيلَار ذ دْسَاس ن لْحَقِيقَا.<verse eid="1TI 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TI 3:16" />أُو بْڒَا شّكّ مشْحَاڒ ثدْجَا ذ ثَمقّْرَانْت ڒْمَعْنَا ينُوْفَّرن ن لْإِيمَان:</para>
  <para style="q1" vid="1TI 3:16">نتَّا، ذ بْنَاذم إِي د يمظْهَارن،</para>
  <para style="q1" vid="1TI 3:16">ذ أَرُّوْح إِي خَاس يشهْذن.</para>
  <para style="q1" vid="1TI 3:16">نتَّا، ذ لْمَلَائِكَاث إِي ذَايس يخْزَرن،</para>
  <para style="q1" vid="1TI 3:16">ذ ڒݣْنُوْس إِي زَّايس يتْوَابشَّرن.</para>
  <para style="q1" vid="1TI 3:16">نتَّا، ذِي دُّنشْت-أَ يِنِّي إِي زَّايس يُوْمْنن،</para>
  <para style="q1" vid="1TI 3:16">ذ لْعَظَمَا ن وجنَّا إِي ث يقبْڒن.<verse eid="1TI 3:16" /></para>
  <chapter eid="1TI 3" />
  <chapter number="4" style="c" sid="1TI 4" />
  <para style="s">ڒُوْصِيَاث ن اَرَّسُوْل بُوْلُس إِ تِيمُوْتَاوُس</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1" />فَا يقَّار أَرُّوْح يقدّْسن نِيشَان بْڒَا شّكّ ذݣ وُوْسَّان-أَ ينݣُّوْرَا اَذ سمْحن شَا ن يِوْذَان ذِي لْإِيمَان نِيشَان اَذ ݣّن اَرَّاي إِ جْنُوْن يغدَّارن ذ مِين سڒْمَاذن شَّيَاطِين. <verse eid="1TI 4:1" /><verse number="2" style="v" sid="1TI 4:2" />أَذ يِيڒِي مَانَايَا س نِّفَق ن يرْيَازن يسْخَرِّيقن، ضَّمِيڒ نْسن صَافِي يحَرق مَامش إِي ث يحَرق يجّن ن وَارْشم<note caller="+" style="f"><char style="fr" closed="false">4‏.2 </char><char style="ft" closed="false">أَرْشم ن وُوْزّڒ ذ يجّن وُوْزّڒ تݣّذ ذِي ثْمسِّي تقّْذذ زَّايس.</char></note> ن وُوْزّڒ يسّشْمَاضن. <verse eid="1TI 4:2" /><verse number="3" style="v" sid="1TI 4:3" />نِثْنِي اَذ سْبدّن يوْذَان بَاش وَار مدْجْشن شَا، قَّارن-اَسن عَاوذ قَا شَا ن لْمَكْلَاث ممْنُوْع اَثنْت شّن. وَلَكِن لْمَكْلَاث نِّي يخْڒق-يثنْت-يد أَربِّـي اَثنْت نقْبڒ نشِّين إِݣ يتَامْنن نسّن لْحَقِيقَا. <verse eid="1TI 4:3" /><verse number="4" style="v" sid="1TI 4:4" />قَا مَارَّا مِين د يخْڒق أَربِّـي ذ اَصبْحَان. مڒَا نقْبڒ-يث نشِّين س شُّكر اَتَاف وَار ذَايس مِين غَا نْعِيفّ. <verse eid="1TI 4:4" /><verse number="5" style="v" sid="1TI 4:5" />أَقَا مَانَايَا يحدْجڒ حَلَال عْلَاحْسَاب اَوَاڒ ن أَربِّـي ذ ثْࢲَادْجِيث. <verse eid="1TI 4:5" /><verse number="6" style="v" sid="1TI 4:6" />ثِمسْڒَايِين-أَ مڒَا ثسْبيَّانذ-ثنْت-يد إِ أَيثْمَاثْنغ اَذ تِيڒِيذ شك ذ يجّن ن وخدَّام ذ اَصبْحَان ن عِيْسَى لْمَسِيح، أَذ تِيڒِيذ تْوَاربِّيذ س وَاوَاڒن ن لْإِيمَان ذ تَّعْلِيم نِّي اَصبْحَان إِي ثْذفَّارذ شك.<verse eid="1TI 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1TI 4:7" />فَا اَوْݣّْوج شك خ ثْحُوْجَا نِّي يدْجَان ضد لْإِيمَان إِي تْعَاوَاذنْت ثْوسُّوْرَا وَاهَا، ستْرِينَار يخف نّش عْلَاحْسَاب لْإِيمَان. <verse eid="1TI 4:7" /><verse number="8" style="v" sid="1TI 4:8" />مڒَا ثسْتْرِينَارذ يخف نّش س اَرِّيَاضَا، أَذ تَاوِيذ يجّن ن اَرْبَاح اَش ينفّع شْوَايْت. مڒَا ثسْتْرِينَارذ س لْإِيمَان، أَذ تَاوِيذ يجّن ن اَرْبَاح اَش ينفّع إِ ثْمسْڒَايِين مَارَّا. لْإِيمَان-أَ يوْعذ-يش عْلَاحْسَاب ثُوْذَارْث-أَ يدْجَان ڒخُّو ذ ثنِّي إِي د غَا يَاسن. <verse eid="1TI 4:8" /><verse number="9" style="v" sid="1TI 4:9" />أَوَاڒ-أَ ذَايس تِّقث أُو لَابُد اَذ يتْوَاقْبڒ يكْمَاڒ. <verse eid="1TI 4:9" /><verse number="10" style="v" sid="1TI 4:10" />خ مَانَايَا نشِّين نْخدّم نربّڒ لِأَنَّا نݣَّا لْأَمَال نّغ ذِي أَربِّـي يدَّرن ونِّي يسنْجَامن مَارَّا يوْذَان خَاصَّتَان ذ يِنِّي يتَامْنن.<verse eid="1TI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11" />ثِمسْڒَايِين-أَ تْوصَّا خَاسنْت شك سڒْمَاذ-يثنْت. <verse eid="1TI 4:11" /><verse number="12" style="v" sid="1TI 4:12" />وَار تجَّا حَدّ اَش يسحْقَر عْلَاحْسَاب ثمْࢲِي نّش. لَّا، شك لَابُد اَذَاسن تِيڒِيذ إِ ڒْمُوْمِنِين ذ لْمِثَال عْلَاحْسَاب اَوَاڒن نّش ذ ثِيشْرِي نّش ذ ڒمْحِبّث نّش ذ لْإِيمَان ذ ڒصْفِيّث. <verse eid="1TI 4:12" /><verse number="13" style="v" sid="1TI 4:13" />حتَّا ٱڒ د غَا يَاسغ نش سْخدَّام يخف نّش مْلِيح س ثْغُوْرِي ن لْكُتُب ذ وحدّث ذ وسڒْمذ. <verse eid="1TI 4:13" /><verse number="14" style="v" sid="1TI 4:14" />وَار تْفرَّاط شَا ذِي لْقُدْرَا نِّي إِي ذَاش يمُّوْشن عْلَاحْسَاب اَوَاڒ نِّي اَصبْحَان إِي خَاش نَّان لْأَنْبِيَا وَامِي اَيْرَاو ن يمقّْرَانن ن جْمَاعث ن ڒْمُوْمِنِين سرْسن خَاش يفَاسّن نْسن.<verse eid="1TI 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 4:15" />طبّق ثِمسْڒَايِين-أَ، سلّم-اَسنْت يخف نّش قَاع بَاش اَذ ࢲرن مَارَّا يوْذَان نَّجَاح نّش. <verse eid="1TI 4:15" /><verse number="16" style="v" sid="1TI 4:16" />خْزَر ذِي ثُوْذَارْث نّش ذ ثْمسْڒَايِين إِي ثْسڒْمَاذذ، ارْنِي ذَايْسنْت. لِأَنَّا مڒَا ثݣِّيذ مَانَايَا اَذ تسْنجْمذ يخف نّش ذ يِنِّي إِي ذَاش يتْسْڒَان.<verse eid="1TI 4:16" /></para>
  <chapter eid="1TI 4" />
  <chapter number="5" style="c" sid="1TI 5" />
  <para style="s">ڒُوْصِيَاث إِ تِيمُوْتَاوُس عْلَاحْسَاب ڒْمُوْمِنِين</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1" />وَار نهَّا شَا يجّن ن ؤُوسَّار س ڒقْسَاحث؛ لَّا، سِيوڒ اَكِذس اَم بَابَاش. ئِحنْجِيرن اݣّ-يثن اَم اَيثْمَاش. <verse eid="1TI 5:1" /><verse number="2" style="v" sid="1TI 5:2" />ثِوسُّوْرَا اݣّ-يثنْت اَم يمَّاثَاش. ثِحنْجِيرِين اݣّ-يثنْت اَم سُوْيْثْمَاش س يِجّن ن وُوْڒ يصْفَا.<verse eid="1TI 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3" />وقَّر ثَاجَّاڒِين إِݣ يدْجَان ذ ثَاجَّاڒِين ذ صَّح.<note caller="+" style="f"><char style="fr" closed="false">5‏.3 </char><char style="ft" closed="false">ثَاجَّاڒِين، يعْنِي ثِمْغَارِين ؤُمِي مُّوْثن يرْيَازن.</char></note> <verse eid="1TI 5:3" /><verse number="4" style="v" sid="1TI 5:4" />شُوْف، ثَاجَّاڒْث نِّي مڒَا غَارس يحنْجِيرن نِغ ذ اَيَّاون اَتَاف ذ نِثْنِي إِي ت غَا يعَاوْنن اَذ ڒمْذن ذ اَمزْوَارُو اَذ سْخدّْمن لْإِيمَان نْسن اَك لْعَئِلَا نْسن اَذ اَرّن ڒْخِير إِ لْوَالِدِين نْسن. أَقَا مَانَايَا يَارْضَا خَاس أَربِّـي. <verse eid="1TI 5:4" /><verse number="5" style="v" sid="1TI 5:5" />قَا ثَاجَّاڒْت ن صَّح ثنِّي وَار غَار يدْجِي حَدّ اَقَا ذ نتَّاث يتݣّن لْأَمَال نّس ذِي أَربِّـي تْغِيمَا تدْعَا أَربِّـي تتَّار-اَس دْجِيڒث ذ نْهَار. <verse eid="1TI 5:5" /><verse number="6" style="v" sid="1TI 5:6" />وَلَكِن ثنِّي يتْعِيشن ذِي شّهْوث وَاهَا، قَا نتَّاث ثمُّوْث وَاخَّا ثدَّر. <verse eid="1TI 5:6" /><verse number="7" style="v" sid="1TI 5:7" />ثِمسْڒَايِين-أَ تْوصَّا-ثنْت بَعْدَا شك بَاش اَذ قِّيمن يِوْذَان بْڒَا ڒْعِيب. <verse eid="1TI 5:7" /><verse number="8" style="v" sid="1TI 5:8" />شُوْف، ونِّي وَار يتْذبِّيرن خ ڒحْبَاب نّس خَاصَّتَان خ لْعَئِلَا نّس اَتَاف نتَّا ينْكَر لْإِيمَان، ونِّي وَار يُوْمِينن قَاع اَتَاف حْسن زَّايس.<verse eid="1TI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9" />وَار تجَّا ؤُڒَا ذ يشْتن اَذ تْسجّل اَك ثَاجَّاڒِين غَار لْمُعَاوَنَا إِلَّا مڒَا غَارس زِي ستِّين يسݣّْوُوْسَا اَڒ ثْسَاونْت، إِلَّا مڒَا تُوْغَا غَارس يجّن ن ورْيَاز وَاهَا. <verse eid="1TI 5:9" /><verse number="10" style="v" sid="1TI 5:10" />لَابُد اَذ تِيڒِي مَعْرُوْفَا س لْحَسَانَاث نّس يعْنِي مڒَا ثربَّا ثَارْوَا نّس، تْرحَّاب س ينوْجِيون، ثْسِيڒِيذ يضَارن ن صَّالِحِين، تْعَاوَان يِنِّي يتْزيَّارن، ثْذفَّار مَارَّا ثِمسْڒَايِين ثِصبْحَانِين.<verse eid="1TI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11" />فَا ثَاجَّاڒِين ثِمزْيَانِين وَار ثنْت تْسجَّال شَا عْلَاحْسَاب لْمُعَاوَنَا. نِثنْتِي خْمِي غَا ثذْفَارنْت شّهَاوَاث نْسنْت كْتَار زِي لْمَسِيح اَتَاف رزُّوْنْت اَذ مڒْشنْت. <verse eid="1TI 5:11" /><verse number="12" style="v" sid="1TI 5:12" />أَمُّو اَذ تْوَاحكْمنْت مِينْزِي سمْحنْت ذِي لْوَعذ نْسنْت إِي ݣِّينْت ذ اَمزْوَارُو. <verse eid="1TI 5:12" /><verse number="13" style="v" sid="1TI 5:13" />عَاوذ اَذ ذوْڒنْت ذ ثِمعْݣَازِين ݣُّوْرنْت زِي ثَدَّارْث غَار ثدَّارْث تݣّنْت فَرْق-شّْغڒ. مَاشِي ذ ثِمعْݣَازِين وَاهَا، تْعَاوَاذنْت ڒخْبُوْرَاث تَاذْفنْت ذِي شّْغُوْرَاث ن مِيدّن قَّارنْت ثِمسْڒَايِين وَار يتْخصَّا شَا اَذ تْوَانَّانْت. <verse eid="1TI 5:13" /><verse number="14" style="v" sid="1TI 5:14" />إِذن، خْسغ ثَاجَّاڒِين ثِمزْيَانِين اَذ مڒْشنْت اَذ د جّنْت يحنْجِيرن اَذ سُوْݣُوْرنْت ثَدَّارْث نْسنْت مْلِيح وَار تجِّينْت بُو شَان لْفُرْصَا إِ ڒْعَذُو اَخَاسنْت يسِّيوڒ س ڒْعِيب. <verse eid="1TI 5:14" /><verse number="15" style="v" sid="1TI 5:15" />مِينْزِي ذِنِّي ڒبْعَاض صَافِي فّْغنْت اَبْرِيذ ذْفَارنْت شِّيطَان.<verse eid="1TI 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TI 5:16" />ثَمْغَارْث ذ ڒْمُوْمْنَا مڒَا تِيڒِينْت اَكِذس شَان تَاجَّاڒِين اَذَايْسنْت تْهِيلَّا أُو لَابُد اَكِذس قِّيمنْت اَخَاسنْت ثْذبَّر. ثِيْنَا، مَاشِي ذ جْمَاعث ن ڒْمُوْمِنِين اَخَاسنْت تَرْبُو؛ لَّا، أَذ تَرْبُو غِير خ ثِنِّي يدْجَان ذ ثَاجَّاڒِين حْذَاجنْت ذ صَّح.<verse eid="1TI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17" />ئِمقّْرَانن ن جْمَاعث ن ڒْمُوْمِنِين يِنِّي يتحْكَامن مْلِيح أُو لَابُد اَثن تْوقَّرم ذ ضُوْبْلِي، خَاصَّتَان يِنِّي يخدّْمن اَطَّاس ذݣ وحدّث ذ وسڒْمذ. <verse eid="1TI 5:17" /><verse number="18" style="v" sid="1TI 5:18" />أَقَا لْكِتَاب يقَّار: وَار ذَاس تݣّ بُو ثَشْمَانْت إِ ؤُفُوْنَاس نِّي يتْصَرْوَاثن. أَقَا عَاوذ اَخدَّام غَارس ڒْحَقّ اَذ يتْخَاڒس. <verse eid="1TI 5:18" /><verse number="19" style="v" sid="1TI 5:19" />وَار قبّڒ شَا تُّوْهْمث ضد إِ ؤُمقّْرَان ن جْمَاعث ن ڒْمُوْمِنِين إِلَّا مڒَا ذِنِّي ثْنَاين نِغ ثْڒَاثَا ن ڒشْهُوْذ تَهَامن-ث. <verse eid="1TI 5:19" /><verse number="20" style="v" sid="1TI 5:20" />ئِمقّْرَانن إِݣ يعصَّان نْهَا-ثن شك زَّاث إِ مَارَّا يوْذَان بَاش ينِّي ينّغْنِي اَذ ݣّْوْذن بَعْدَا. <verse eid="1TI 5:20" /><verse number="21" style="v" sid="1TI 5:21" />أَقَا عڒْمغ-اَش زَّاث إِ أَربِّـي ذ عِيْسَى لْمَسِيح ذ لْمَلَائِكَاث يتْوَاخْضَرن قَا لَابُد اَذ تݣّذ ثِمسْڒَايِين-أَ بْڒَا مَا ٱذ تݣّذ ڒْفَرْز اَك شَان حَدّ بْڒَا مَا ٱذ تݣّذ عَاوذ س وُوْذمَاون.<verse eid="1TI 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1TI 5:22" />ئِفَاسّن نّش وَار تْقدْجِيق شَا اَثن تْسرْسذ خ شَان حَدّ،<note caller="+" style="f"><char style="fr" closed="false">5‏.22 </char><char style="ft" closed="false">ئِمقّْرَانن ن جْمَاعث ن ڒْمُوْمِنِين سْرُوْسَان يفَاسّن نْسن خ ڒْمُوْمِنِين بَاش اَذ قبْڒن لْقُدْرَاث زِي أَرُّوْح ن أَربِّـي، أَذ ݣنْفَان زِي ڒهْرَاشَاث، أَثن كلّْفن خ لْمسْؤُلِيَاث ن جْمَاعث.</char></note> وَار شَرّش شَا ذِي ڒْمُعْصِيَاث ن مِيدّن. قِّيم شك ثصْفِيذ.<verse eid="1TI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23" />وَار سسّ شَا اَمَان وَاهَا، سو عَاوذ ذْرُوْس ن وَامَان وضِيڒ عْلَاحْسَاب ثَكْرِيشْت نّش ذ ڒهْرَاشَاث إِي ش يڒقّْفن.<verse eid="1TI 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24" />شَا ن ڒْمُعْصِيَاث ن يرْيَازن تْوَامظْهَارنْت-يد تِيزْوَارنْت-يد إِ لْعِقَاب نْسن، وَلَكِن ڒْمُعْصِيَاث ن يرْيَازن نّغْنِي اَخَاسن د خضْڒنْت منْبَعْد. <verse eid="1TI 5:24" /><verse number="25" style="v" sid="1TI 5:25" />أَمُّو عَاوذ شَان ن لْحَسَانَاث تْوَامظْهَارنْت-يد، عَاذ شَان ن لْحَسَانَاث نّغْنِي وَار زمَّرنْت شَا اَذ قِّيمنْت تْوَانُوْفَّرنْت.<verse eid="1TI 5:25" /></para>
  <chapter eid="1TI 5" />
  <chapter number="6" style="c" sid="1TI 6" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1" />مَارَّا يِنِّي يدْجَان ذ يسمْغَان ثْذقّڒ خَاسن ثْزَايْڒُوْت نِّي<note caller="+" style="f"><char style="fr" closed="false">6‏.1 </char><char style="ft" closed="false">ئِسمْغَان تْعدَّابن اَطَّاس اَم ثْزَاݣْڒُوْت نِّي ن وكشُّوْض إِي زِي شرّْزن دّْوَاب.</char></note> وَا لَابُد اَذ فكَّرن بلِّي اَيثْبَاب نْسن سْذَاهدْجن مَارَّا مِين يدْجَان ذ اَوقَّر بَاش يوْذَان وَار تْعيِّيبن شَا يسم ن أَربِّـي ذ تَّعْلِيم نّغ. <verse eid="1TI 6:1" /><verse number="2" style="v" sid="1TI 6:2" />ئِسمْغَان ؤُمِي غَار يدْجَا اَيثْبَاب نْسن ذ ڒْمُوْمِنِين وَا لَابُد اَذَاسن تْصنَّاطن إِ اَيثْبَاب نْسن مَاشِي اَذَاسن اَݣِين اَذَاسن ينِين لَّا قَا نشِّين ذ اَوْمَاثن. لَّا، أَذَاسن خذْمن كْتَار لِأَنَّا اَيثْبَاب نْسن ذ نِثْنِي إِي غَا يربْحن زِي ڒْخذْمث نِّي أُو نِثْنِي تَامْنن تْوَاعِيزّن.</para>
  <para style="s" vid="1TI 6:2">يِنِّي يسڒْمَاذن يخَرِّيقن تْعجِيبنْت-اَسن تْمنْيَاث</para>
  <para style="p" vid="1TI 6:2">ثِمسْڒَايِين-أَ سڒْمَاذ-يثنْت شك، زيَّار خَاسنْت. <verse eid="1TI 6:2" /><verse number="3" style="v" sid="1TI 6:3" />مڒَا شَان ورْيَاز يسڒْمذ شَان ڒْحَاجث نّغْنِي وَار يتِيفِيق شَا اَك وَاوَاڒن نِيشَان ن سِيذِيثْنغ عِيْسَى لْمَسِيح ذ تَّعْلِيم خ لْإِيمَان، <verse eid="1TI 6:3" /><verse number="4" style="v" sid="1TI 6:4" />اَتَاف نتَّا يُوْفّ س تَّكبُّوْر وَار يفهّم وَالُو قَاع. ئِهْڒش يرزُّو غِير اَمْخَرْوَاض ذ ؤُمْنَقَار خ وَاوَاڒن إِي زِي د يتَاس ڒحْسذ ذ ؤُمنْغِي ذ ڒْبَاطڒ ذ لْأَفْكَار ذ ثِعفَّانِين. <verse eid="1TI 6:4" /><verse number="5" style="v" sid="1TI 6:5" />يرْيَازن-أَ تْهوَّاڒن جَارَاسن س ڒَعْقُوْڒَاث نْسن يعوّْجن ثْودَّر-اَسن لْحَقِيقَا. تْفكَّرن بلِّي لْإِيمَان ذ يجّن ن وبْرِيذ بَاش اَذ ربْحن تْمنْيَاث.<verse eid="1TI 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 6:6" />فَا لْإِيمَان إِي ذِي ثدْجَا ڒقْنَاعث نتَّا ذ يجّن ن اَرْبَاح ذ اَمقّْرَان. <verse eid="1TI 6:6" /><verse number="7" style="v" sid="1TI 6:7" />ڒَاحقَّاش نشِّين وَار د نُوْوِي وَالُو إِ دُّنشْت-أَ، وَار نْزمَّر اَزَّايس نِيْسِي وَالُو. <verse eid="1TI 6:7" /><verse number="8" style="v" sid="1TI 6:8" />فَلِيهَذَا نشِّين نجِّيْون س مِين غَا نشّ ذ مِين غَا نَرض ذ اَرُّوْض أُو صَافِي.<verse eid="1TI 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 6:9" />يِنِّي يرزُّوْن اَذ يڒِين ذ تْوَاجَر اَتَاف اَذ تْوَاغَرَّان اَذ وْضَان ذݣ يِجّن ن ثخْشبْث ذ وَاطَّاس ن شّهَاوَاث إِݣ يسْبُوْهْڒُوْين إِݣ يسفْشَاذن إِݣ يسْغرَّاقن يرْيَازن ذِي اَرّْوِينَا ذ ڒفْنَا. <verse eid="1TI 6:9" /><verse number="10" style="v" sid="1TI 6:10" />لِأَنَّا ڒمْحِبّث ن تْمنْيَاث نتَّا ذ لْأَصل ن وَاطَّاس ن لْأَنْوَاع ن شَّرّْ. ڒبْعَاض ن يِوْذَان إِݣ يتخْسن تْمنْيَاث اَقَا فّْغن اَبْرِيذ سْنُوْقُّوْبن يخف نْسن س وَاطَّاس ن ڒحْرِيقَاث.<verse eid="1TI 6:10" /></para>
  <para style="s">ڒُوْصِيَاث ثِنݣُّوْرَا زِي اَرَّسُوْل بُوْلُس إِ تِيمُوْتَاوُس</para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11" />فَا شك آي اَرْيَاز ن أَربِّـي، ارْوڒ زِي مَارَّا مَانَايَا ذْفَار مِين يدْجَان نِيشَان ذ مِين ذَاس يتعْجِيبن إِ أَربِّـي ذ لْإِيمَان ذ ڒمْحِبّث ذ تَّاسِع ن ڒْخَاضَر ذ تَّوَاضُع. <verse eid="1TI 6:11" /><verse number="12" style="v" sid="1TI 6:12" />مْنغ اَمنْغِي نِّي اَصبْحَان ن لْإِيمَان، طّف ذِي ثُوْذَارْث نِّي وَار يفنِّين شَا اَڒ ذَاش د يڒَاغَا أَربِّـي وَامِي ثْشهْذذ شْهَاذث نِّي ثَصبْحَانْت زَّاث إِ وَاطَاس ن ڒشْهُوْذ. <verse eid="1TI 6:12" /><verse number="13" style="v" sid="1TI 6:13" />تْوصِّيغ-شك زَّاث إِ أَربِّـي ونِّي يسدَّرن قَاع ثِمسْڒَايِين أُو زَّاث إِ عِيْسَى لْمَسِيح ونِّي يشهْذن شْهَاذث نِّي ثَصبْحَانْت زَّاث إِ لْحَاكم بُوْنْطُوْس بِلَاطُوْس. <verse eid="1TI 6:13" /><verse number="14" style="v" sid="1TI 6:14" />تݣّ س ڒُوْصِيّث-أَ بْڒَا ڒْعِيب بْڒَا شَا ن وخْشِيْو ٱڒ د غَا يمظْهَار سِيذِيثْنغ عِيْسَى لْمَسِيح. <verse eid="1TI 6:14" /><verse number="15" style="v" sid="1TI 6:15" />أَثِيذ يسْمظْهَار أَربِّـي ذِي ڒْوقْث إِي ذِي يخس نتَّا يعْنِي أَربِّـي ذ ونِّي إِݣ يتْوَابَرْكن ذ ونِّي إِݣ يتحْكَامن وَاحْذس نتَّا ذ اَزدْجِيذ ن يزدْجِيذن ذ مَوْلَانَا ن لْمَوْلَانَاث. <verse eid="1TI 6:15" /><verse number="16" style="v" sid="1TI 6:16" />ذ نتَّا وَاحْذس إِي وَار يتْمتِّين عمَّارْص، ئِزدّغ ذݣ يِجّن ن نُّوْر إِي وَار يزمَّر حَدّ اَغَارس د يقَارّب يعْنِي ونِّي ؤُمِي عمَّارْص وَار ث يࢲْرِي بْنَاذم وَار يزمَّر اَث يࢲر. ذ نتَّا إِي غَا يِيڒِي ؤُوقَّر ذ جّْهذ إِ ڒبْدَا. آمِين.<verse eid="1TI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17" />يِنِّي إِݣ يدْجَان ذ تْوَاجَر ذِي دُّنشْت-أَ إِي ذِي ندْجَا تْوصَّا-ثن بَاش وَار ذَايْسن يتِيڒِي شَا تَّكبُّر بَاش وَار تݣّن شَا لْأَمَال نْسن ذݣ وَاݣْڒَا ذِي وَار ثدْجِي بُو تِّقث. لَّا، أَذ يِيڒِي لْأَمَال نْسن ذِي أَربِّـي ونِّي إِي ذَانغ يتْذبَّرن مَارَّا ثِمسْڒَايِين س ڒْخِير اَزَّايْسنْت نْفَرح. <verse eid="1TI 6:17" /><verse number="18" style="v" sid="1TI 6:18" />تْوصَّا-ثن اَذ ݣّن ڒْخِير اَذ يڒِين ذ تْوَاجَر عْلَاحْسَاب لْحَسَانَاث اَذ يڒِين صَاخِيِين اَذ يڒِين وجْذن بَاش اَذ صدّْقن اَذ ذبَّرن. <verse eid="1TI 6:18" /><verse number="19" style="v" sid="1TI 6:19" />أَمنِّي إِي غَا خمْڒن اَݣْڒَا إِ يِيخف نْسن اَم يِجّن ن دْسَاس يجهْذن إِ ثُوْذَارْث إِي د غَا يَاسن بَاش اَذ طّْفن مْلِيح ذِي ثُوْذَارْث نِّي إِي يدْجَان ذ ثُوْذَارْث ن صَّح.<verse eid="1TI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20" />آ تِيْمُوْتَاوُس، حْضَا مِينْخف تْكلَّافذ قْبڒ. أَوْݣّْوج زِي مِين تْپـرْپِـيرن يِنِّي وَار يُوْمِينن شَا ذ لْأَفْكَار نِّي إِي ذَانغ يتْعَارَّاضن قَّارن-اَس لْعَرْفَانِيَا<note caller="+" style="f"><char style="fr" closed="false">6‏.20 </char><char style="ft" closed="false">لْعَرْفَانِيَا نتَّاث ذ يجّن ن نُّوْع ن لْفلْسَفَا.</char></note> وَلَكِن مَانَاينِّي ذ يخَرِّيقن وَاهَا. <verse eid="1TI 6:20" /><verse number="21" style="v" sid="1TI 6:21" />ذِنِّي ڒبْعَاض ذْفَارن لْعَرْفَانِيَا-يَا زَعْمَا منْبَعْد فّْغن اَبْرِيذ ن لْإِيمَان. أَغَارْوم يِيڒِي اَرْضَا إِ كنِّيو.<verse eid="1TI 6:21" /></para>
  <chapter eid="1TI 6" />
</usx>