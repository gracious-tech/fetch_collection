<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Aromanian Frasherot</book>
  <para style="h">Mateu</para>
  <para style="toc1">Evanghelu Dupã Mateu</para>
  <para style="toc2">Mateu</para>
  <para style="toc3">Mat</para>
  <para style="mt1">Evanghelu Dupã Mateu</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">Gheonologhia al Isus Hristos</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Cartea a farãljei al Isus Hristos, hiljilu al David, hiljilu al Abraham. <verse eid="MAT 1:1" /><verse number="2" style="v" sid="MAT 1:2" />Al Abraham lji s-amintã Isacu, al Isac lji s-amintã Iacovu. Al Iacovu lji s-amintã Iuda shi fratslji a lui, <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />al Iuda lji s-amintã di la Tamara Perezu sh-Zarah. Al Perezu lji s-amintã Hezromu, al Hezromu lji s-amintã Aramu, <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />al Aramu lji s-amintã Aminadabu, al Aminadabu lji s-amintã Nahsonu, al Nahsonu lji s-amintã Salmonu, <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />al Salmonu lji s-amintã Boazu di la Rahabi, al Boazu lji s-amintã Obedu di la Ruth, al Obedu lji s-amintã Iesseu, <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" />al Iesseu lji s-amintã Davidu amirã. Al amirãlu David lji s-amintã Solomonu di la muljearea tsi eara al Uriah, <verse eid="MAT 1:6" /><verse number="7" style="v" sid="MAT 1:7" />al Solomonu lji s-amintã Roboamu, al Roboamu lji s-amintã Abiahu, al Abiahu lji s-amintã Asafu, <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />al Asafu lji s-amintã Iosafatu, al Iosafatu lji s-amintã Ioramu, al Ioramu lji s-amintã Uziau, <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />al Uziau lji s-amintã Iothamu, al Iothamu lji s-amintã Ahazu, al Ahazu lji s-amintã Ezekia, <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />al Ezekia lji s-amintã Manaseu, al Manaseu lji s-amintã Amonu, al Amonu lji s-amintã Iosia, <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />al Iosia lji s-amintã Iekonia shi fratslji a lui tu chirolu a mutariljei tu Babilon.<verse eid="MAT 1:11" /></para>
  <para style="s">Mutarea tu Babilon</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />Dupã mutarea tu Babilon, al Iehonia lji s-amintã Sealtielu, al Sealtielu lji s-amintã Zorobabelu, <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />al Zorobabelu lji s-amintã Abihudu, al Abihudu lji s-amintã Eliakimu, al Eliakimu lji s-amintã Azoru, <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />al Azoru lji s-amintã Sadocu, al Sadocu lji s-amintã Achimu, al Achimu lji s-amintã Eliudu, <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />al Eliudu lji s-amintã Eleazaru, al Eleazaru lji s-amintã Mathanu, al Mathanu lji s-amintã Iacovu, <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />al Iacovu lji s-amintã Iosifu, bãrbatilu ali Marii, di la ea s-amintã Isusul, tsi s-acljimã Hristos. <verse eid="MAT 1:16" /><verse number="17" style="v" sid="MAT 1:17" />Ashã cã tuti gheneratsili di la Abrahamu pãnã la Davidu s-fac patrusprãdzatsi di gheneratsi, shi di la Davidu pãnã la mutarea tu Babilon, patrusprãdzatsi di gheneratsi, shi di la mutarea tu Babilon pãnã la Hristolu, patrusprãdzatsi di gheneratsi.<verse eid="MAT 1:17" /></para>
  <para style="s1">Amintarea al Isus Hristos</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Amintarea al Isus Hristolu fu ashã: Maria, muma a lui, eara susita al Iosif, ma nãinti tsi s-apãrnjea s-bãna deadun, armasi greauã di la Duhlu Sãmtu. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Atumtsea Iosiful, susitlu a ljei, tsi eara un om ndreptu sh-nu vrea s-u arushina nãintea a oaminjlor, apofãsi s-u alasã ascumtã.<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />Ma, iarã minduea singur aestu lucru, lji s-afãnisi tu yis un anghil di la Domnul sh-lji dzãsi: “Iosif, hiljilu al David, s-nu ai fricã s-u ljeai Maria ca muljearea a ta, cã tsi s-acãtsã tu nãsã easti lucru di la Duhlu Sãmtu. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Shi ea va s-amintã un ficior, sh-tini va lji badzã numa Isus, cã elu va s-ascapã populu a lui di amãrtiili a lor.”<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Shi tutã aestã s-featsi tra si mplineascã zborlu a Domnului dupã prufitlu tsi dzãtsi: <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />“Ia, virghina va armãnã greauã sh-va amintã un ficior, tsi va lj-bagã numa Emanuel,” tsi va s-dzãcã: “Dumnidzãlu cu noi.” <verse eid="MAT 1:23" /><verse number="24" style="v" sid="MAT 1:24" />Sh-Iosiful, dupã tsi si sculã di somnu, featsi ashã cum lu avea ursit anghilu a Domnului, sh-u lo ningã nãsu muljearea a lui. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Ma elu nu u cunuscu, pãnã-cãndu ea amintã ficiorlu a ljei sh-elu s-acljimã Isus.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s1">Shtiutslji dit Rãsãrit</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Dupã tsi Isusul s-amintã tu Betlehem a Iudeiljei tu chirolu al amirãlu Herod, ia, niscãntsã shtiuts di la Rãsãrit agiumsirã la Ierusalem, <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />dzãcãnda: “Iu easti amirãlu a Iudeilor, tsi s-amintã? Cã vidzum steaua a lui la Rãsãrit sh-vinãm s-nã ncljinãm.”<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Amirãlu Herod, cãndu avdzã aesti zboari, s-tulburã, sh-deadun cu nãsu tut Ierusalemlu. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Sh-dupã tsi lã adunã tuts mãrlji a preftsãlor shi scriblji a popului, lji ntribã cã iu prindi s-aminta Hristolu. <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />Sh-elji lji dzãsirã: “Tu Betlehemlu a Iudeiljei, cã ashã easti scriatã di la prufitlu: <verse eid="MAT 2:5" /><verse number="6" style="v" sid="MAT 2:6" /><note caller="-" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="MIC 5:2">Mic 5:2</ref>.</char></note>‘Sh-tini, Betlehem, loc al Iuda, nu eshti ma njic di printslji a Iudeiljei, cã di la tini va easã un prints, tsi va pascã populu a meu, Israelu.’”<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Atumtsea Herodul lã acljimã pri ascumtu shtiutslji, sh-lã ntribã cu mari cãshtigã, di chirolu cãndu lu avea vidzutã steaua di prota oarã. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Sh-lji pitricu la Betlehem sh-lã dzãsi: “Imnats shi ntribats ghini ti cilimeanlu. Sh-cãndu s-lu aflats, dimãndats-nji tsi s-yin sh-mini s-mi ncljinu.”<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />Sh-elji, dupã tsi lu avdzãrã amirãlu, fudzirã. Sh-ia, steaua tsi avea vidzutã la rãsãrit, s-dutsea nãintea a lor pãnã s-dãnãsi la loclu iu eara cilimeanlu. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Elji, cãndu u vidzurã steaua, s-hãrsirã multu. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Sh-dupã tsi intrarã tu casã, vidzurã cilimeanlu cu Maria, muma a lui, cãdzurã pri dzinucljiu shi si ncljinarã. Deapoea discljisirã ayishtearea a lor sh-durusirã: furii, timeamã shi njir. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Dupã tsi Dumnidzãlu lã dimãndã tu yis tsi s-nu s-turna la Herod, elji s-turnarã tu loclu a lor pri unã altã cali.<verse eid="MAT 2:12" /></para>
  <para style="s1">Fudzirea tu Eghyptu</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Tora, dupã tsi shtiutslji s-nchisirã, ia, un anghil a Domnului lji si fãnirusi tu yis al Iosif shi lj-dzãsi: “Scoalã-ti, ljea cilimeanlu shi muma a lui sh-fudzi tu Eghyptu, shi shedz aclo pãnã s-tsã dzãc mini, cã Herodul va lu caftã cilimeanlu ti vãtãmari.”<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />Elu, si sculã, lo cilimeanlu sh-muma a lui noaptea shi fudzi tu Eghyptu. <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />Armasi aclo pãnã muri Herodul, tsi si mplinea tsi eara dzãsã di Domnul prit prufitlu: <note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="HOS 11:1">Hos 11:1</ref>.</char></note>“Lu acljimai hiljilu a meu di Eghyptu.”<verse eid="MAT 2:15" /></para>
  <para style="s1">Vãtãmarea a Cilimenjilor</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Atumtsea Herodul, vidzãnda cã shtiutslji lu avea arãs, s-nãrãi multu sh-ordinã si s-vatãmã tuts cilimenjlji mascuri tsi eara tu Betlehem shi tu tuti locurili di anvãrliga a lui, di la doi anji sh-nghios, dupã chirolu tsi lu avea aflatã di la shtiutslji. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Atumtsea si mplini atsea tsi eara dzãs di la prufitlu Ieremia cã: <verse eid="MAT 2:17" /><verse number="18" style="v" sid="MAT 2:18" /><note caller="-" style="x"><char style="xo" closed="false">2:18 </char><char style="xt" closed="false"><ref loc="JER 31:15">Ier 31:15</ref>.</char></note>“Tu Ramã s-avdzã unã zghileari, unã vãitari, un plãngu shi patathimã mari. Rahela vãita hiljilji a ljei sh-nu va si s-diznjeardã, cã elji nu suntu ma.”<verse eid="MAT 2:18" /></para>
  <para style="s1">Turnarea dit Eghyptu</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Dupã tsi Herodul muri, ia un anghil a Domnului si lj-fãnirusi tu yis al Iosif tu Eghyptu, <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />shi lj dzãsi: “Scoal-ti, ljea cilimeanlu sh-muma a lui sh-imnã tu loclu al Israel cã atselji tsi vrea s-lu vãtãma cilimeanlu au muritã.”<verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />Sh-elu si sculã, lo cilimeanlu sh-muma a lui shi s-dusi tu loclu al Israel. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Ma, cãndu avdzã cã Arhelaul, domnea la Iudea tu loclu al Herod, tatãl a lui, avu fricã si s-ducã aclo. Shi, dupã tsi s-urnipsi di la Dumnidzãlu tu yis, s-dusi tu loclu a Galileiljei. <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />Sh-dupã tsi agiumsi aclo, shidzu la un cãsãbã tsi s-acljima Nazaret, tsi si mplinea atsea tsi eara dzãsã di la prufitsilji: <note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="MRK 1:24">Mrc 1:24</ref>; <ref loc="LUK 2:39">Luc 2:39</ref>; <ref loc="JHN 1:45">Ioan 1:45</ref>.</char></note>“Elu va si s-acljeamã Nazareas.”<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s1">Ioan Pãtidzãtorlu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Tu atseali dzãli vini Ioan Pãtidzãtorlu, tsi predica tu irnjia a Iudeiljei, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />shi dzãtsea: “Mitãnjiusits-vã, cã amirãriljea a tserurilor easti aproapi!” <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Sh-ti Ioanul avea gritã prufitlu Isaia cãndu dzãsi:</para>
  <para style="q1" vid="MAT 3:3">
    <note caller="-" style="x">
      <char style="xo" closed="false">3:3 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 40:3">Isa 40:3</ref>.</char>
    </note>“Boatsea atsilui tsi aurlã tu irnjii:</para>
  <para style="q2" vid="MAT 3:3">‘Ndridzets-u calea a Domnului,</para>
  <para style="q2" vid="MAT 3:3">ndriptats cãljurili a lui.’”<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Ioanul avea nviscutã un stranji di lãna a cãmilãljei sh-un brãn di chealã la mesi. Elu s-hrãnea cu carcaletsi shi njeari-agrã. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Atumtsea oaminjlji a Ierusalemlui, di tutã Iudea sh-di locurili a Iordanlui s-dutsea cãtrã nãsu, <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />shi s-pãtidza di la nãsu, tu arãulu Iordan mãrtirsinda amãrtiili a lor.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Ma elu, vidzãnda cã multsã Farisei shi Sadutsei ma yinea s-pãtidza la nãsu, lã dzãsi a lor: “Pulji di nãpãrtitsi, cai vã ari nvitsatã tsi s-ascãpats di nãrirea a Domnului tsi ma yini? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Dats fruti buni trã mitãnjiusirea a voastrã! <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Sh-nu dzãtsets cu mintea a voastrã: ‘Noi avem Abrahamul ca tatã.’ Cã mini ma vã dzãc cã Dumnidzãlu poati s-da hilji a Abrahamului sh-dit aesti chetri. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Sh-tora tupoara easti tu rãdãtsina a ponjilor. Cathi pom, tsi nu da fruti buni, va si s-talji sh-va si s-arucã tu foc. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />Mini ma vã pãtedz cu apã, trã mitãnjiusiri, ma atsel tsi yini dupã mini easti ma mari di mini, sh-mini nu escu axiu nitsi s-tsãn sandalili a lui. Elu va s-vã pãteadzã cu Duhlu Sãmtu sh-cu foc. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Elu tsãni tu mãnã lupata sh-va curã tut grãnarlu a lui, grãnlu a lui va lu adunã tu hãmbar, ma cotsala va lu ardã tu foc niastes.”<verse eid="MAT 3:12" /></para>
  <para style="s1">Pãtidzarea al Isus</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Atumtsea vini Isusul dit Galilea tu Iordan la Ioanul tra si s-pãteadz di la nãsu. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Ma Ioanul lu ncuntrã dzãcãnda: “Mini prindi s-mi pãtedzu di la tini, sh-tini ma yinji la mini?” <verse eid="MAT 3:14" /><verse number="15" style="v" sid="MAT 3:15" />Sh-Isusul, apãndisinda, lji dzãsi: “Alasã si s-facã tora, cã ashã mplinim cathi ndriptati.” Atumtsea elu lu alãsã.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Sh-Isusul, macãt s-pãtidzã, ishi dit apã. Shi ia, tserurili s-discljisirã, sh-elu vidzu Duhlu a Dumnidzãlui dipunãnda ca un purumbu, yininda pristi nãsu. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Shi ia, unã boatsi dit tser tsi lj-dzãsi: “Aestu easti Hiljiu a meu vrut, di la cai escu hãrsit.”<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">Cãrtearea al Isus</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Atumtsea Duhlu lu adusi Isusul tu irnjii, tsi draclu s-lu cãrtea. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Shi dupã tsi tsãnu pãreasinji patrudzãtsi di dzãli sh-patrudzãtsi di noptsã, ma napoi u acãtsã foama. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Atumtsea cãrtitorlu, dupã tsi lji s-apruche, lji dzãsi: “Ma s-hii Hiljiu a Dumnidzãlui, dzã tsi chetrili aesti si s-facã pãnji.” <verse eid="MAT 4:3" /><verse number="4" style="v" sid="MAT 4:4" />Ma elu lj-apãndisi: “Scritura dzãtsi: ‘Omlu nu bãneadzã mash cu pãni, ma cu cathi zbor tsi easi dit <note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="DEU 8:3">Deut 8:3</ref>.</char></note>gura a Dumnidzãlui.’” <verse eid="MAT 4:4" /><verse number="5" style="v" sid="MAT 4:5" />Atumtsea draclu lu adusi tu sãmtul cãsãbã sh-lu bãgã tu mãyeaua a templui, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />sh-lji dzãsi: “Ma s-hii Hiljiu a Dumnidzãlui, arucã-ti nghios, cã Scritura dzãtsi: ‘Elu va da ordin a anghiljilor a lui trã tini, sh-atselji va ti tsãnã tu mãnjili a lor tsi s-nu agudeshti cu ciciorlu a tãu vãrã <note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PSA 91:11">Ps 91:11</ref>,<ref loc="PSA 91:12">12</ref>.</char></note>cheatrã.’” <verse eid="MAT 4:6" /><verse number="7" style="v" sid="MAT 4:7" />Isusul lj-dzãsi: “Scritura dzãtsi tutashã: <note caller="-" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="DEU 6:16">Deut 6:16</ref>.</char></note>‘S-nu lu cãrteshti Domnul, Dumnidzãlu a tãu.’” <verse eid="MAT 4:7" /><verse number="8" style="v" sid="MAT 4:8" />Draclu lu dusi dinou pri un munti multu analtu sh-lji aspusi tuti amirãriljili a lumiljei sh-mãrirea a lor, <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />sh-lji dzãsi: “Mini va tsã li dau tuti aesti, macã tini cadz pri dintsã nãintea a mea sh-va-nji ti-ncljinji.” <verse eid="MAT 4:9" /><verse number="10" style="v" sid="MAT 4:10" />Atumtsea Isusul lji dzãsi: “Fudzi, Satane, cã easti scriatã: ‘<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="DEU 6:13">Deut 6:13</ref>.</char></note>Alavdã Domnul, Dumnidzãlu a tãu, sh-huzmitipsea mash nãsu.’” <verse eid="MAT 4:10" /><verse number="11" style="v" sid="MAT 4:11" />Atumtsea draclu lu alãsã, sh-ia, s-apruchearã anghilji tra s-lji huzmitipsea.<verse eid="MAT 4:11" /></para>
  <para style="s1">Isusul tu Galilea</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Cãndu Isusul avdzã cã Ioanul fu bãgat tu hapsi, s-trapsi tu Galilea. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Deapoea alãsã Nazaretul shi s-dusi s-bãneadzã la Capernaum, cãsãbã ningã amari, tu sinurili al Zabulon shi Neftali, <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />tsi si mplineascã tsi eara dzãsã di la prufitlu Isaia cai dzãsi: <verse eid="MAT 4:14" /><verse number="15" style="v" sid="MAT 4:15" /><note caller="-" style="x"><char style="xo" closed="false">4:15,16 </char><char style="xt" closed="false"><ref loc="ISA 9:1-2">Isa 9:1-2</ref>.</char></note>“Loclu al Zabulon sh-loclu al Neftali, mardzina a amariljei, loclu napãrti di Iordan, Galilea a pãngãnjilor, <verse eid="MAT 4:15" /><verse number="16" style="v" sid="MAT 4:16" />populu tsi bãna tu scutidi ari vidzutã unã lunjinã mari, sh-pristi atselji tsi stãtea tu loclu a aumbriljei a moartiljei, arãsãri lunjina.” <verse eid="MAT 4:16" /><verse number="17" style="v" sid="MAT 4:17" />Di atumtsea Isusul apãrnji s-predica shi s-dzãtsea: “Mitãnjiusits-vã cã amirãriljea a tserurilor easti aproapi.”<verse eid="MAT 4:17" /></para>
  <para style="s1">Protslji Ucenitsi</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Cãndu ma fudzea ningã amarea a Galileiljei, Isusul vidzu doi frats: Simonul tsi s-acljima Petru, sh-Andrea, frati-su, tsi ma arca plãsili tu amari cã eara piscari. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Sh-lã dzãsi a-lor: “Haidets dupã mini sh-mini va vã facã piscari di oaminji.” <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Sh-dinãoarã elji alãsarã plãsili sh-lu urmarã.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Sh-cum s-dusi ma nclo, vidzu doi altsã frats: Iacovul, hiljiu al Zebedeu sh-Ioanul, fratili a lui, tu varcã deadun cu Zebedeu tatili a lor, tsi ma ndridzea plãsili. Sh-lji acljimã. <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />Elji alãsarã trãoarã varca sh-tatãl a lor shi s-dusirã dupã nãsu.<verse eid="MAT 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Isusul strãbãtea tutã Galilea, nvitsãnda tu sinagodzili a lor, predicãnda evanghelu a amirãriljei sh-vindicãnda itsi lãngoari sh-itsi niputeari eara tu popul. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Ashã anamea a lui si arãspãndi tu tutã Siria, sh-lji adutsea tuts lãndzitslji tsi s-munduea di niputeari sh-dureari soi di soi, demonizatsi, epileptitsi sh-paralizatsi, sh-elu lji vindica. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Sh-un multsãmi mari di oaminji njidzea dupã nãsu dit Galilea, dit Decapoli, dit Ierusalem, dit Iudea sh-di napãrti di Iordan.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">Ahurhita a Nvitsãturãljei tu Munti</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Sh-cãndu Isusul vidzu multsãmea, s-alinã pri munti, sh-dupã tsi shidzu, s-apruchearã di nãsu ucenitsilji a lui. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />Sh-elu discljisi gura, sh-lji-nvitsã ashã.</para>
  <para style="s1" vid="MAT 5:2">Ghinicuvintãrili</para>
  <para style="p" vid="MAT 5:2">Elu dzãsi: <verse eid="MAT 5:2" /><verse number="3" style="v" sid="MAT 5:3" />“Ghinicuvintats suntu atselji oarfãnjlji tu duh, cã a lor easti amirãriljea a tserurilor. <verse eid="MAT 5:3" /><verse number="4" style="v" sid="MAT 5:4" />Ghinicuvintats suntu atselji tsi vãiteascã, cã elji va s-diznjeardã. <verse eid="MAT 5:4" /><verse number="5" style="v" sid="MAT 5:5" />Ghinicuvintats suntu atselji froninji, cã elji va mushtineadzã loclu. <verse eid="MAT 5:5" /><verse number="6" style="v" sid="MAT 5:6" />Ghinicuvintats suntu atselji tsi au foami shi seati ti ndriptati, cã elji va s-fãnãteascã. <verse eid="MAT 5:6" /><verse number="7" style="v" sid="MAT 5:7" />Ghinicuvintats suntu atselji njiluitslji, cã elji va aflã njilã. <verse eid="MAT 5:7" /><verse number="8" style="v" sid="MAT 5:8" />Ghinicuvintats suntu atselji cai suntu curats tu inimã, cã elji va lu veadã Dumnidzãlu. <verse eid="MAT 5:8" /><verse number="9" style="v" sid="MAT 5:9" />Ghinicuvintats suntu atselji tsi aducã pacea, cã elji va s-acljeamã hiljilji a Dumnidzãlui. <verse eid="MAT 5:9" /><verse number="10" style="v" sid="MAT 5:10" />Ghinicuvintats suntu atselji avinatslji trã ndriptati, cã a lor easti amirãriljea a tserurilor. <verse eid="MAT 5:10" /><verse number="11" style="v" sid="MAT 5:11" />Ghinicuvintats va-hits voi cãndu va vã ngiurã, sh-va vã avinã, sh-arãdãnda, va dzãc tuti arãli contra voi, trã itia a mea. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />Hãrsits-vã shi harãcupsits-vã, cã mari easti arãsplata a voastrã tu tseruri, cã ashã lji avinarã sh-prufitsilji nãintea a voastrã.”<verse eid="MAT 5:12" /></para>
  <para style="s1">Sarea sh-Lunjina</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />“Voi hits sarea a loclui. Ma, macã sarea s-aspardzi cum poati su amintã njiurizma? Nu fatsi ti tsiva, di cãt ti arcari, shi su calcã oaminjlji.<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />Voi hits lunjina a lumiljei. Un cãsãbã adratã pri munti nu poati si s-ascundã. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Tutashã nu s-aprindi un cãndilã tra si s-bagã sum vasã, ma tra si s-bagã pri shandan shi s-facã lunjinã trã tuts tsi suntu la casã. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Ashã s-lunjineadzã lunjina a voastrã nãintea a oaminjlor, tra s-veadã faptili a voastri atseali buni, shi s-mãreascã Tatãl a vostru tsi easti tu tseruri.”<verse eid="MAT 5:16" /></para>
  <para style="s1">Mplinirea a Legiljei</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />“Nu minduits cã mini vinj s-aspargu legea icã prufitsilji. Mini nu vinj s-aspargu, ma s-li mplinescu. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Cã dealihea vã dzac: Pãnã cãndu tserlu shi loclu s-treacã, nitsi unã iotã sh-nitsi unã chicutã nu va s-treacã di legea, ma nãinti tsi si mplineascã tuti. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Atsel tsi va ncalcã un di aesti ordini ma njitsi, sh-va s-aibã nvitsatã oaminji, elu va s-acljeamã ma njiclu tu amirãriljea a tserurilor. Ma atsel tsi va li bagã tu practicã sh-va lã li-nveatsã a alantsãlor, va s-acljeamã ma marli tu amirãriljea a tserurilor. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Trã atsea mini ma vã dzãc: macã ndriptatea a voastrã nu va s-u treacã atsea a Scribilor sh-a Fariseilor, voi nu va s-intrats tu amirãriljea a tserurilor.<verse eid="MAT 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />Voi avets avdzãtã cã fu dzãsã a vecljilor: ‘Nu vãtãmats. Caitsido tsi vatãmã va s-hibã sum giudicatã.’ <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Ma mini ma vã dzãc: Caitsido tsi s-nãrãeashti fãrã sibepi cu fratili a lui, va s-hibã giudicatã. Sh-cai lji dzãtsi a fratilui a lui: ‘Fãrã di-minti,’ va hibã sum giudicata al Sinedriu, sh-cai va lji dzãcã: ‘Glare,’ va hibã tu foclu a Colasiljei.<verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />Macã tini aduts doara a ta la altar, sh-aclo aduts aminti cã fratili a tãu ari tsiva contra tini, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />alasã aclo doara a ta, nãintea a altarlui, sh-duti ma nãinti puituea-ti cu fratili a tãu sh-deapoea toarnã-ti sh-dã doara a ta.<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />Puituea-ti cu contrarlu a tãu, pãnã cãndu eshti la un cali cu nãsu, tsi s-nu ti prida contrarlu a tãu la giudicãtorlu, sh-giudicãtorlu s-ti prida la gardianlu sh-tini s-agiundzi tu hapsi. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Dealihea tsã dzãc cã nu va eshi di-aclo, ni plãtit sutãljea a fundu.<verse eid="MAT 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />Voi avets avdzãtã cã a vecljilor fu dzãsã: ‘Nu ncãlcats curuna.’ <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Ma mini ma vã dzãc cã caitsido tsi mutreashti unã muljeari tra s-u aibã, ari ncãlcatã curuna cu nãsã tu inima a lui. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Macã ocljiul a tãu atsel ndreptu ti dutsi tu amãrtii, scoati-l shi arucã-l diparti di tini. Cã easti ma ghini ti tini tsi s-cheri un di mãdularili a tali, di cãt si s-arucã tu Colasi tut truplu a tãu. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Sh-macã mãna a ta atsea ndreapta ti dutsi tu amãrtii, si-u talji shi si-u arutsi diparti di tini. Cã ma ghini easti s-cherã un din mãdularili a tali, di cãt si s-arucã tu Colasi tut truplu a tãu.<verse eid="MAT 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />Fu dzãsã tutashã: ‘Cai alasã muljearea a lui, s-lji da cartea a dispãrtsãriljei.’ <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Ma mini ma vã dzãc: Caitsido tsi u alasã muljearea a lui, di cãt trã itia a putãnsiriljei, u fatsi s-ncalcã curuna. Caitsido tsi si nsoari cu unã muljeari alãsatã ncalcã curuna.<verse eid="MAT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />Voi avets avdzãtã tutashã cã a vecljilor fu dzãsã: ‘Nu fã spigiurari arãdioasi, ma mplinea spigiurarea a ta tsi lji ai faptã a Domnului.’ <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Ma mini ma vã dzãc: Nu spigiurats-vã dip, nitsi pri tserlu, cã easti thronlu a Dumnidzãlui, <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />nitsi pri loclu, cã easti scamnul a cicioarilor a lui, nitsi pri Ierusalemlu cã easti cãsãbãlu a Amirãlu atsel marlui. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Nu ti spigiur nitsi pri caplu a tãu, cã nu ai fuchii s-alãgheshti icã s-lãeshti macari sh-un hir di per. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Ma zborlu a tãu s-hibã: ‘Ie, ie’ icã ‘Nu, nu.’ Cã itsido ma multu yini di la slablu. <verse eid="MAT 5:37" /><verse number="38" style="v" sid="MAT 5:38" />Voi avets avdzãtã cã fu dzãsã: ‘Ocljiu ti ocljiu sh-dinti ti dinti.’ <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Ma mini ma vã dzãc: Nu lji ncuntreadzã a arãului (cu arãu)<note caller="-" style="x"><char style="xo" closed="false">5:39 </char><char style="xt" closed="false"><ref loc="ROM 12:21">Rom 12:21</ref>.</char></note>. Macã vãrã ti agudeashti pri fatsa atsea nandreapta, toarnã-lji sh-alanta. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Sh-macã vãrã va ti ducã tu giudic, tra s-ljea tunica a ta, dã-lji sh-mantelul. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Sh-macã vãrã ti strindzi sã imnji unã milje, tini fã doauã cu nãsu. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Dã-lji atsilui tsi ts-caftã, sh-nu arnisea s-lji dai atsilui tsi ts-caftã mprumutã. <verse eid="MAT 5:42" /><verse number="43" style="v" sid="MAT 5:43" />Voi avets avdzãtã cã fu dzãsã: ‘S-vrei aproapili a tãu shi s-aurãshti neamiclu a tãu.’ <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Ma mini ma vã dzãc: S-vrets neamitsilji a voshtri, <note caller="+" style="f"><char style="fr" closed="false">5:44 </char><char style="ft" closed="false">Tu alti manuscrisi easti scriatã “ghinicuvintats atselji tsi vã blãsteam, fãtsets-vã ghini atsilor tsi vi aurã.”</char></note>ghinicuvintats atselji tsi vã blastimã. Fãtsets ghini atsilor tsi vã aurãscu, sh-rugats-vã trã atselji tsi vã fac arãu, sh-vã aĝunescu, <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />tra s-hits hiljilji a Tatãlui a vostru tsi easti tu tseruri. Cã elu fatsi s-easã soarili a lui pri bunjilji shi pri arãljilji, sh-fatsi s-da ploai pri ndreptsãlji shi pri nidreptsãlji. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Cã ma s-vrets mash atselji tsi vã vor, tsi arãsplatã va avets? Nu fac ashã shi taxidarlji? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Sh-macã salutats mash fratslji a voshtri, tsi ma multã dicãt altsãlji fãtsets voi? Nu fac ashã sh-pãngãnjlji? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />S-hits ashã perfectsã ashã cum easti perfect sh-Tatãl a vostru tserescu.”<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">Nvitsãturã ti Dicunji, Rugãciunea sh-Pãreasinji</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />Isusul dzãsi: “Bãgats mintea s-nu fãtsets ghini nãintea a oaminjlor, tsi elji s-vã alavdã a voauã, altã soi nu va vã arãsplãtits di la Tatãl a vostru tsi easti tu tseruri.<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />Cãndu s-dai dicunji, nu bati trumpeta nãintea a ta, ashã cum fac ipucritslji tu sinagogã sh-pri cãljuri, tra s-hibã tinjisits di oaminjlji. Dealihea vã dzãc ca elji tora u-au loatã arãsplata a lor. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Cãndu fatsi ghini, astãnga a ta s-nu shtii tsi fatsi a andrepta a ta. <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />Cãndu u fats buneatsa a ta, s-facã pri ascumtu. Sh-Tatãl a tãu tsi veadi pri ascumtu, elu va-ti arãsplãteascã a tsãia nãintea a tutulor.<verse eid="MAT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />Sh-cãndu vã rugats, nu vã fãtsets ca ipucritslji cã a lor lã arãseashti s-roagã mproshtsã tu sinagogã, sh-tu pãdzili a cãljurilor tra s-hibã vidzut di oaminjlji. Dealihea vã dzãc cã elji tora u au loat arãsplata a lor. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Ma tini cãndu ti rodzi intrã tu udãlu a tãu, ncljidi usha sh-roagã-ti a Tatãlui a tãu pri ascumtu. Sh-Tatãl a tãu tsi veadi pri ascumtu va ti arãsplãteascã nãintea a tutulor. <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" />Cãndu vã rugats s-nu ufilisits idyili zboari ca pãngãnjlji, cã elji minduescu cã va si-mplineascã rugãciunea cã au dzãsã multi zboari. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Nu vã fãtsets ca atselji, cã Tatãl a vostru li shtii tuti di tsi avets ananghi, ma nãinti tsi voi s-li cãftats.<verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />Ma voi rugats-vã ashã:</para>
  <para style="q1" vid="MAT 6:9">‘Tatãl a nostru tsi eshti tu tseruri,</para>
  <para style="q2" vid="MAT 6:9">si sãmtseascã numa a ta.<verse eid="MAT 6:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="MAT 6:10" />S-yinã amirãriljea a ta. Si s-facã vrearea a ta tu loc, ashã di cum tu tser.<verse eid="MAT 6:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="MAT 6:11" />Pãnea a noastrã di cathi dzuã, dã-nã-u a noauã azã.<verse eid="MAT 6:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="MAT 6:12" />Sh-ljeartã-nã amãrtiili a noastri, ashã di-cum sh-noi lã ljirtãm a amãrtioshilor a noshtri.<verse eid="MAT 6:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="MAT 6:13" />Sh-nu nã alasã s-cãdem tu cãrteari, ma nã ascapã di atsel arãu. [Cã a ta easti amirãriljea, putearea, sh-mãrirea di totãna]<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="ft" closed="false">Tu alti manuscrisi nu sã aflã atseli zboari.</char></note>. Amin.’<verse eid="MAT 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />Cã macã voi lã ljirtats a oaminjlor amãrtiili a lor, Tatãl a vostru dit tser va vã li ljeartã sh-a voauã. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Ma, macã voi nu lã ljirtats a oaminjlor amãrtiili a lor, nitsi Tatãl a vostru nu va li ljeartã amãrtiili a voastri.<verse eid="MAT 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />Sh-cãndu s-tsãnets pãreasinji s-nu vã spunets nvirinats ca ipucritslji. Cã elji aspargã fãtsili tsi s-aspunã a oaminjlor cã tsãnã pãreasinji. Dealihea vã dzãc cã elji tora u-au loatã arãsplata a lor. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Iarã tini, cãndu s-tsãnji pãreasinji, aundzi caplu sh-aspealã fatsa a ta, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />tra s-nu lã aspunji a oaminjlor cã tini ma tsãnji pãreasinji, ma a Tatãlui a tãu pri ascumtu sh-Tatãl a tãu cai mutreashti pri ascumtu, va ti arãsplãteascã nãintea a tutulor.”<verse eid="MAT 6:18" /></para>
  <para style="s">Ayishtearea Tsereascã</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />“Nu adunats trã voi ayishteari pri loc, iu li aspargã molitsa sh-arudzina, sh-iu furlji sapã shi furã. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Ma adunats trã voi ayishteari tu tser, iu nitsi molitsa, nitsi arudzina nu li aspargu, sh-iu furlji nu sapã shi nu furã. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Cã iu easti ayishtearea a voastrã, aclo va hibã sh-inima a voastrã.<verse eid="MAT 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />Lunjina a truplui easti ocljiu. Macã ocljiul a tãu easti curat, tut truplu va hibã lunjinat. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Macã ocljiul a tãu easti arãu, tut truplu a tãu va hibã tu scutidi. Macã lunjina tsi easti la tini easti scutidi, cãt ma mari va hibã scutidlu!<verse eid="MAT 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />Vãrã nu poati s-huzmitipseascã la doi domnji. Cã icã va s-lu aurascã unlu sh-alantu va lu va, icã va armãnã pistimen la unlu, sh-va dispretsueascã alantu. Nu pots s-huzmitipseshti a Dumnidzãlui sh-a pãradzlor.”<verse eid="MAT 6:24" /></para>
  <para style="s1">S-nu Avets Gaile</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />“Trã atsea ma vã dzãc: Nu minduits ti bana a voastrã, tsi va mãcats shi tsi va bets, nitsi ti truplu a vostru trã atsea tsi va nvishtets. Vahi nu easti bana ma scumpã di cãt hrana, sh-truplu ma scumpu di nvishtearea? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Mutrits puljilji a tserlui, elji nu seaminã, nitsi seatsirã, nu adunã tu hãmbãri, cu tut atsea Tatãl a vostru dit tser lji hrãneashti. Nu custusits voi ma multu di cãt atselji? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Sh-cai di voi cu tut cãshtiga a lui poati s-adavgã la stãtura a lui macari un cubit singur?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />Cãtse vã cãrtits di nvishtearea a voastrã? Mutrits cum creascã zãmbãtslji a cãmpului, nu lucreadzã sh-nitsi torcu. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Sh-ma vã dzãc cã nitsi Solomonul, cu tutã mãrirea a lui, nu eara nviscutã ca vãrã di elji. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Tora macã Dumnidzãlu u-nveashti ashã iarba a cãmpului tsi azã easti sh-mãni va si s-arucã tu cireapu, vahi nu va vã-nveascã a voauã ma multu, oaminji pisti-putsãn? <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />Nu vã cãrtits dzãcãnda: ‘Tsi va mãcãm icã tsi va bem, icã cu tsi va nã nvishtem?’ <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Cã suntu pãngãnjlji tsi caftã tuti aesti lucri. Tatãl a vostru di tser shti ghini cã voi avets ananghi trã tuti aesti lucri. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Ma, nãinti di tuti cãftats amirãriljea a Dumnidzãlui shi ndriptatea a lui sh-tuti aesti ananghi va s-vã adavgã a voauã. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />S-nu avets gaile trã dzua di mãni. Cã dzua di mãni va si s-cãshtigheadzã di nãsã. Lj-agiundzi a dzuãljei cãshtiga a ljei.”<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">Nvitsãtura di Giudicãtsili Nindreapti</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />Isusul dzãsi: “Nu giudicats, tra s-nu s-hits giudicats. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Cã voi va vã giudicats dupã giudicata tsi voi fãtsets, sh-cu metrul tsi misurats, va vã misurats. <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />Cãtse vedz paljilu tu ocljiul a fratilui a tãu, sh-nu vedz grenda tu ocljiul a tãu? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Icã, cum pots s-lji dzãtsi a fratilui a tãu: ‘Ashteaptã s-tsã scot paljiul dit ocljiu’, cãndu ai unã grendã tu ocljiul a tãu? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Ipucrite, scoati ma nãinti grenda dit ocljiul a tãu, sh-deapoea va vedz curatã tra s-lji scots paljiul dit ocljiul a fratilui a tãu. <verse eid="MAT 7:5" /><verse number="6" style="v" sid="MAT 7:6" />Nu lã dats a cãnjilor tsi easti sãmtã sh-nu lã-arucats mãrgãritãrili a voastri nãintea a portsilor, tsi s-nu li ncalcã cu cicioari shi si s-toarnã contra voi shi s-vã disicã.”<verse eid="MAT 7:6" /></para>
  <para style="s1">Cãftarea shi Asunarea</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />“Dicunjats sh-va vã da, cãftats sh-va aflats, asunats la ushã shi va vã si discljidã. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Cai dicunji, ljea. Cai caftã, aflã, sh-atsilui tsi asuni va lji si discljidã.<verse eid="MAT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9" />Ari vãrã om namisa di voi, tsi ma s-lji caftã hiljiu pãni, s-lji da cheatrã? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Icã ma s-lji caftã peshti, s-lji da nãpãrticã? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Atumtsea, macã voi tsi hits arãi shtits s-dats doari buni a hiljilor a voshtri, ahãt ma multu Tatãl a vostru, tsi easti tu tseruri, va lã da lucri buni atsilor tsi lj-caftã. <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" />Itsido tsi voi vrets s-vã facã oaminjlji, fãtsets-li sh-voi atsilor, cã aestã easti Legea sh-Prufitsilji.<verse eid="MAT 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />Intrats pri poarta atsea strimta, cã largã easti poarta sh-mari easti calea tsi ti dutsi tu aspãrdzeari, sh-multsã suntu atselji tsi intrã prit nãsã. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Cã strimtã easti poarta sh-greauã easti calea tsi dutsi tu banã! Sh-putsãnji suntu atselji tsi u-aflã.”<verse eid="MAT 7:14" /></para>
  <para style="s1">Prufitsilji Arãdioshi</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />“Afirits-vã di prufitsilji arãdioshi, tsi yin la voi nviscuts ca oi, ma di nãuntru suntu luchi arãchitori. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Voi va lji cunushtets di frutili a lor. S-adunã vahi aua dit pãljuri, icã hits dit schinji? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Ashã itsi pom bun da fruti buni, iarã pomlu atsel arãu da fruti arali. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Nu poati un pom bun s-da fruti arali, nitsi un pom arãu s-da fruti buni <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Itsi pom tsi nu da fruti buni, s-talji shi s-arucã tu foc. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Voi va lji cunushtets prufitsilji di frutili a lor.<verse eid="MAT 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />Nu itsi om tsi nj-dzãtsi: ‘Doamne, Doamne,’ va intrã tu amirãriljea a tserurilor. Ma va intrã singur atsel tsi fatsi vrearea a Tatãlui a meu tsi easti tu tseruri. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Multsã va nji dzãcã tu atsea dzuã: ‘Doamne, Doamne, nu prufitipsimã tu numa a ta? Nu l-aĝunim demonjlji tu numa a ta? Sh-nu avem faptã multi thavmati tu numa a ta?’ <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Sh-atumtsea va lã spunã a lor: ‘Mini nu vã am cunuscut pute. Dipãrtats-vã di la mini, voi tuts, tsi avets lucrat anapuda.’”<verse eid="MAT 7:23" /></para>
  <para style="s1">Casa pri Cheatrã</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />“Trã atsea caitsido tsi li avdi aesti zboari a meali sh-li mplineashti, undzeashti cu un om mintimen, tsi u-ari adratã casa a lui pri cheatrã. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Sh-deadi ploai, vini nãcarea, suflarã vimturi, shi s-plãscãnirã pri atsea casã, ma ea nu cãdzu, cã eara thimiljeatã pri cheatrã. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />Iarã caitsido tsi lã avdi zboarili sh-nu li mplineashti, undzeashti cu un glar, tsi u adrã casa a lui tu arinã. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Sh-deadi ploai, vini nãcarea, suflarã vimturi, s-plãscãnirã pri atsea casã sh-ea cãdzu, sh-aspãrdzearea a ljei eara mari.”<verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Tora, cãndu Isusul ascãpã di-aesti zboari, multsãnjili armasirã ciudisiti di nvitsãtura a lui, <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />cã elu lã nvitsa ca un om cu puteari, sh-nu ca scriblji.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">Vindicarea a Leproslui.</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Tora cãndu Isusul dipunã dit munti, multsãnji mãri lu urma. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Sh-ia, un lepros vini sh-si ncljinã, dzãcãnda: “Doamne, ma s-vrei tini pots s-mi curi.” <verse eid="MAT 8:2" /><verse number="3" style="v" sid="MAT 8:3" />Sh-Isusul teasi mãna, deadi di nãsu sh-lji-dzãsi: “Ie, mini voi, curã-ti!” Sh-tu atsea oarã s-vindicã di lepra a lui. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Atumtsea Isusul lji dzãsi: “Vedzi, s-nu lj-spunji a vãrui, ma duti nãintea a preftului, sh-dã doara tsi ari ursitã Moisiul tsi aestã s-hibã mãrtirii trã caitsido.”<verse eid="MAT 8:4" /></para>
  <para style="s1">Tsenturionlu al Capernaum</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Cãndu Isusul intrã tu Capernaum, lji vini un tsenturion pãrãcãlsinda, <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />shi lji dzãsi: “Doamne, sclavul a meu easti ashtirnat la casã paralizat sh-ma s-mundueashti multu.” <verse eid="MAT 8:6" /><verse number="7" style="v" sid="MAT 8:7" />Sh-Isusul lji dzãsi: “Va yin sh-va lu vindicã.” <verse eid="MAT 8:7" /><verse number="8" style="v" sid="MAT 8:8" />Tsenturionlu lj-apãndisi: “Doamne, mini nu escu axiu tsi tini s-intsri tu streaha a mea, ma dzã mash un zbor shi sclavlu a meu va s-vindicã. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Cã sh-mini escu un om sum autoritatea altsãlor, sh-lji-am suldatslji sum mini. Ma s-lji dzãc a unui: ‘Duti!’, elu s-dutsi, shi ma s-lji dzãc a altui: ‘Haidi!’, elu yini, shi ma s-lji dzãc a sclavlui a meu: ‘Fã aestã!’, elu u-fatsi.” <verse eid="MAT 8:9" /><verse number="10" style="v" sid="MAT 8:10" />Cãndu Isusul avdzã aestã, s-ciudisi sh-lã dzãsi atsilor tsi lu urma: “Dealihea ma vã dzãc, cã iuva tu Israel nu aflai un pisti ahãntã mari. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Mini ma vã dzãc cã multsã va yin di la rãsãrit sh-di la ascãpitat, sh-va s-apunã la measã cu Abrahamul, cu Isacul sh-cu Iacovul tu amirãriljea a tserurilor, <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />ma hiljilji a amirãriljei, atselji aleptsã di la Dumnidzãlu, va hibã arucats tu scutidlu di nafoarã. Aclo va hibã plãngul sh-cãrtsãnirea a dintsãlor.” <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />Atumtsea Isusul lji dzãsi a tsenturionlui: “Du-ti, shi s-facã ashã cum pistipsishi!” Sclavul s-vindicã tu atsea oarã.<verse eid="MAT 8:13" /></para>
  <para style="s1">Soacra a Petrului</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Deapoea Isusul intrã tu casa a lui Petru sh-vidzu soacra a lui tsi eara tu pat cu hevri. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Cãndu elu lji bãgã mãna hevrili u-alãsarã. Sh-ea si sculã sh-ahurhi s-lji huzmitipsea a lui. <verse eid="MAT 8:15" /><verse number="16" style="v" sid="MAT 8:16" />Cãndu vini seara, lji adusirã multsã demonizatsi, sh-elu cu zbor aĝuni duhurili sh-vindicã tuts lãndzitslji, <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />tsi ashã si mplineascã zborlu a prufitlui Isaia cãndu dzãsi<note caller="-" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="ISA 53:4">Isa 53:4</ref>.</char></note>:</para>
  <para style="q1" vid="MAT 8:17">“Elu li lo niputerili a noastri</para>
  <para style="q2" vid="MAT 8:17">sh-li purtã lãngoarili a noastri.”<verse eid="MAT 8:17" /></para>
  <para style="s1">Urmarea al Isus</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Cãndu Isusul vidzu anvãrliga di nãsu multsãnji mãri, ordinã s-treacã di napãrti. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Atumtsea un scrib s-apruche sh-lji dzãsi: “Nvitsãtore, mini va ti urmedzu iutsido tsi va ti duts.” <verse eid="MAT 8:19" /><verse number="20" style="v" sid="MAT 8:20" />Sh-Isusul lji dzãsi: “Vulpili au guvãli a lor, sh-puljilji a tserlui au cuibairili, ma Hiljiu a Omlui nu ari iu s-bagã caplu.” <verse eid="MAT 8:20" /><verse number="21" style="v" sid="MAT 8:21" />Deapoea un din ucenitsilji a lui lji dzãsi: “Doamne, dã-nji volje ma nãinti s-mi duc s-ngrop tatãl a meu.” <verse eid="MAT 8:21" /><verse number="22" style="v" sid="MAT 8:22" />Ma Isusul lji dzãsi: “Urmeadzã-mã, sh-alasã mortsãlji s-ngroapã mortsãlji a lor.”<verse eid="MAT 8:22" /></para>
  <para style="s1">Isusul Muljeadzi Furtuna</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Dupã tsi elu s-alinã tu varcã, ucenitsilji a lui lu-urmarã. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Sh-ia, tu amari si sculã unã furtunã mari, sh-vãljurili ma anvãlea varca, ma Isusul durnjea. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />S-apruchearã la nãsu ucenitsilji a lui, lu dishtiptarã shi lji dzãsirã: “Doamne, ascapã-nã, cã noi ma nã nicãm.” <verse eid="MAT 8:25" /><verse number="26" style="v" sid="MAT 8:26" />Isusul lã dzãsi a lor: “Cãtse avets fricã, voi oaminj cu pisti-putsãnã?” Cum si sculã, aurlã a vimturilor sh-a amariljei shi s-featsi tãtseari mari. <verse eid="MAT 8:26" /><verse number="27" style="v" sid="MAT 8:27" />Atumtsea oaminjlji s-thãvmãtisirã sh-dzãsirã: “Cai easti aestu, tsi ma lu ascultã vimturili shi amarea?”<verse eid="MAT 8:27" /></para>
  <para style="s1">Demonizatlu Gadarean</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Cãndu Isusul agiumsi tu alantã parti tu loclu a Gadarenjilor, lji ishirã nãinti doi demonizats tsi avea ishitã di murmintsã. Elji eara ahãntu turbatsi, cãt nitsunu nu putea s-tritsea pri atsea cali. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Sh-ia, elji ahurhirã s-aurlã: “Tsi ai cu noi, Isus, Hiljiu a Dumnidzãlui? Ai vinit aoa s-nã mundueshti ma nãinti di oara tsi prindi?” <verse eid="MAT 8:29" /><verse number="30" style="v" sid="MAT 8:30" />Sh-nu multu diparti di nãshi un cupii mari di portsi ma pãshtea. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Atumtsea demonjlji s-rugarã a lui: “Macã nã aĝuneshti, alasã-nã s-intrãm tu atsea cupii di portsi.” <verse eid="MAT 8:31" /><verse number="32" style="v" sid="MAT 8:32" />Elu lã dzãsi a lor: “Dutsets-vã!” Ashã elji dupã tsi ishirã, intrarã tu atsea cupii di portsi. Ia, tutã cupia s-arcã di ripã tu amari, shi s-nicarã tu apã. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Atselji tsi lã pãshtea fudzirã tu cãsãbã sh-cãndu agiumsirã aclo spusirã tuti aesti, sh-atsea tsi avea undzitã cu demonizatslji. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Atumtsea, tutã cãsãbãlu ishi nãintea a Isusului. Cãndu lu vidzurã lji si rugarã tsi s-dipãrta dit loclu a lor.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s1">Paralizatlu al Capernaum</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Isusul dupã tsi intrã tu varcã, tricu tu alantã parti, shi vini tu cãsãbãlu a lui. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Sh-ia, lji adusirã un om paralizat tu pat, sh-Isusul cãndu vidzu pistea tsi avea elji, lji dzãsi a paralizatlui: “S-ai curaiu, hilje, amãrtiili a tali suntu ljirtati!” <verse eid="MAT 9:2" /><verse number="3" style="v" sid="MAT 9:3" />Atumtsea niscantsã scribi dzãsirã cu mintea a lor: “Aestu ma blastimã!” <verse eid="MAT 9:3" /><verse number="4" style="v" sid="MAT 9:4" />Ma Isusul cunuscãnda minduirili a lor lã dzãsi: “Cãtse minduits lucri arali tu ininjli a voastri? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Tsi easti ma lishor trã dzãtseari: ‘Amãrtiili a tali suntu ljirtati,’ icã: ‘Scoalã-ti sh-imnã’? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Ma tora tra si shtits cã Hiljiu a Omlui ari puteari pri loc s-ljeartã amãrtiili,” lji dzãsi a paralizatlui: “Scoalã-ti, ljea patlu sh-duti la casã a ta.” <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />Sh-elu si sculã shi s-dusi la casã a lui. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Multsãnjili cãndu lu vidzurã aestã, s-ciudisirã sh-mãrirã Dumnidzãlu, tsi avea datã a oaminjlor ahtari puteari.<verse eid="MAT 9:8" /></para>
  <para style="s1">Acljimarea al Mateu</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Deapoea cãndu s-dusi Isusul nclo, vidzu un om tsi shidea la yimbruchi, acljimatã Mateu, sh-lji-dzãsi: “Urmeadzã-mi!” Sh-elu si sculã sh-lu urmã.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Cãndu Isusul shidea la measã la casã, vinirã multsã taxidari sh-amãrtioshi, s-apunarã sh-mãcarã deadun cu nãsu sh-cu ucenitsilji a lui. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Fariseilji cãndu vidzurã aestã, lji dzãsirã a ucenitsilor a lui: “Cãtse nvitsãtorlu a vostru mãcã cu taxidarlji sh-cu amãrtioshlji?” <verse eid="MAT 9:11" /><verse number="12" style="v" sid="MAT 9:12" />Cãndu Isusul avdzã aesti, lã dzãsi a lor: “Nu suntu sãnãtoshlji tsi au ananghi di doctor ma atselji lãndzitslji. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Tora dutsets-vã sh-nvitsats tsi va s-dzãc: ‘Mini voi njilã sh-nu curbani.’<note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="HOS 6:6">Hos 6:6</ref>.</char></note> Cã nu vinj s-acljem trã mitãnjusiri ndreptsãlji, ma amãrtioshlji.”<verse eid="MAT 9:13" /></para>
  <para style="s1">Zborlu di Pãreasinj</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Atumtsea s-apurchearã ucenitsilji a Ioanului shi ntribarã: “Cãtse noi sh-Fariseilji tsãnem pãreasinji di multi ori, iarã ucenitsilji a tãlji nu tsãn pãreasinji?” <verse eid="MAT 9:14" /><verse number="15" style="v" sid="MAT 9:15" />Isusul lã dzãsi a lor: “Pot numtarlji s-aibã jali, pãnã cãndu dzinirli easti cu nãshi? Ma va yin chirolu cãndu va lu ljea dzinirli di la elji sh-atumtsea elji va s-aĝiuneadzã. <verse eid="MAT 9:15" /><verse number="16" style="v" sid="MAT 9:16" />Vãrã nu bagã tu stranjiu vecljiu un peatic nou, cã altã soi arupi stranjiu shi azmuldzearea s-fatsi ma mari. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Vãrã nu bagã yinlu atsel noulu tu folji veclji, cã altã soi foljilji va creapã, yinlu va s-vearsã sh-foljilji va chearã. Ma yinlu atsel nou s-bagã tu folji noi, ashã s-veaglji un-alantu.”<verse eid="MAT 9:17" /></para>
  <para style="s1">Isusul Vindicã unã Muljeari sh-Nyeadzi unã Featã</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Cãndu Isusul lj-dzãtsea aestã, s-apruche un di mãrlji a sinagogãljei, cãdzu pri dintsã nãintea a lui sh-lji-dzãsi: “Macãt nj-muri hiljea, haidi sh-bagã mãna pri nãsã sh-ea va bãneadzã.” <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Isusul si sculã shi s-dusi dupã nãsu deadun cu ucenitsilji a lui.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />Sh-ia, unã muljeari tsi di doisprãdzatsi di anji lj-cura sãndzili, lji s-apruche di nãpoi sh-bãgã mãna tu mardzina a stranjilui a lui. <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />Cã dzãtsea cu mintea a ljei: “Ma s-bagã mãna la stranjiu a lui, va mi vindicã.” <verse eid="MAT 9:21" /><verse number="22" style="v" sid="MAT 9:22" />Isusul s-turnã, lu vidzu sh-lji dzãsi: “S-ai curaiu hiljea a mea, pistea a ta ti vindicã.” Shi tu ora atsea muljearea s-vindicã.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Cãndu Isusul agiumsi la casa a marlui a sinagogãljei sh-vidzu fluerãtorlji sh-multsãmea tulburatã, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />lã-dzãsi a-lor: “Dipãrtats-vã cã feata nu ari murit, ma doarmi.” Sh-elji arãsir cu nãsu. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Deapoea, cãndu multsãmea u-scoasirã nafoarã, elu intrã, u-acãtsã di mãnã sh-ea si sculã. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Sh-hãbarea aishtei anami s-arãspãndi tu tut loclu.<verse eid="MAT 9:26" /></para>
  <para style="s1">Vindicarea a Orghilor sh-a Mutlui</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Cãndu Isusul ma fudzea di aclo, doi orghi lu urma aurlãnda sh-dzãcãnda: “Njiluia-nã noi, Hiljiu al David!” <verse eid="MAT 9:27" /><verse number="28" style="v" sid="MAT 9:28" />Cãndu Isusul agiumsi la casã, orghilji s-apruchearã sh-elu lã dzãsi a lor: “Pistipsits voi cã mini pot s-u fac aestã?” Elji apãndisirã: “Ie, Doamne.” <verse eid="MAT 9:28" /><verse number="29" style="v" sid="MAT 9:29" />Atumtsea elu bãgã mãna la ocljilji a lor, dzãcãnda: “Si s-facã dupã pistea a voastrã.” <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Deapoea a lor lã si discljisirã ocljilji. Sh-Isusul lã ordinã dzãcãnda: “Videts s-nu shtibã vãrã om.” <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Ma elji macãt ishirã u arãspãndirã anamea a lui tu tut loclu.<verse eid="MAT 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Cãndu elji ma isha, lji adusirã un bãrbat mut shi demonizat. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Dupã tsi Isusul aĝuni demonul, mutlu grãi. Sh-multsãnjili s-ciudisirã sh-dzãsirã: “Nu easti vidzut pute un ahtar lucru tu Israel!” <verse eid="MAT 9:33" /><verse number="34" style="v" sid="MAT 9:34" />Ma Fariseilji dzãtsea: “Elu aĝuneashti demonjlji cu agiutarea a marlui a demonjilor.”<verse eid="MAT 9:34" /></para>
  <para style="s1">Sitsirarea sh-Lucrutorlji</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Isusul tritsea pri tuti cãsãbadzli sh-hoarili, nvitsãnda tu sinagodzãli a lor, predicãnda evanghelul a amirãriljei, shi vindicãnda tuti lãngoarili sh-tuti niputearili tu popul. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Cãndu vidzu multsãnjili avea njilã trã nãshi, cã eara nvirinati sh-arãspãnditi ca oili fãrã picurar. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Atumtsea elu lã dzãsi a ucenitsilor a lui: “Sitsirarea easti dealihea multu, iarã lucrutorlji suntu putsãnji. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Rugats-vã, a Domnului a sitsirãrilor s-pitreacã lucrutori la sitsirãrili a lui.”<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">Doisprãdzatslji sh-Misiunea a lor</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Atumtsea Isusul lã acljimã di doisprãdzatsi ucenitsilji a lui ningã nãsu, sh-lã deadi autoritati s-li aĝuneascã duhurili atseali nicuarati, shi s-vindicã itsi lãngoari sh-itsi niputeari. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />Aesti suntu numili a doisprãdzatsi apostulji: protlu Simonul acljimat Petru, shi Andrea, fratili a lui, Iacovul hiljiu al Zebedeu, shi Ioanul, fratili a lui, <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Filipul sh-Bartolomeu, Toma sh-Mateu taxidarlu, Iacovul hiljiu al Alfeu, sh-Tadeul, <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Simon Cananeanlu, sh-Iuda Iscariotul atsel tsi deapoea lu prideadi.<verse eid="MAT 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Aeshti suntu di doisprãdzatslji tsi Isusul lji pitricu sh-lã ordinã dzãcãnda: “Nu vã dutsets cãtrã pãngãnjlji sh-nu intrats tu vãrã cãsãbã di-a Samaritenjilor. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Ma dutsets-vã ma ghini la oili atseali chiruti di la casa al Israel. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Dutsets-vã sh-predicats, dzãcãnda: ‘Amirãriljea a tserurilor s-apruche.’ <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Vindicats lãndzitslji, curats leproshlji, nyeats mortsãlji, aĝunits demonjlji. Ca doarã loatã, ca doarã s-dats. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Nu adunats furii, nitsi asimi, nitsi bãcãr tu punga a voastrã, <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />nitsi trastu ti cali, nitsi doauã pãreclji di tunicã, nitsi sandali, nitsi ciumagã, cã lucrutorlu easti axiu ti hranea a lui. <verse eid="MAT 10:10" /><verse number="11" style="v" sid="MAT 10:11" />Tu cathi cãsãbã icã hoarã tsi s-intrats, ntribats macã ari aclo vãrã om axiu, shi shãdets aclo pãnã-cãndu s-vã nchisits. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Shi cãndu s-intrats tu casã, salutats-lji. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Sh-macã atsea casã easti axiu, va yinã pacea a voastrã pri ea, iarã macã nu easti axiu, pacea a voastrã va s-toarnã nãpoi la voi. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Sh-macã vãrã nu vã ashteaptã, sh-nu lã ascultã zboarili a voastri, ishinda di atsea casã icã di atsel cãsãbã, scuturats puhlu di cicioarili a voastri. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Dealihea ma vã dzãc cã tu dzua a giudicatãljei loclu a Sodomiljei sh-a Gomoriljei va hibã cu ma multã lishureatsã di atsel cãsãbã.<verse eid="MAT 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />Ia, mini ma vã-pitrec ca oili tu mesea a luchilor. S-hits mintimenji ca nãpãrtitsli sh-curats ca purunghilji. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />Afiritsi-vã di oaminjlji cã va vã prida nãintea a sinedriului a lor, sh-va vã batã tu sinagodzãli a lor. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Sh-va vã ducã nãintea a guvernatorilor sh-nãintea a amiradzlor trã itia a mea, tra s-mãrtirsits nãintea a lor sh-a pãngãnjilor. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Sh-cãndu s-vã prida tu mãnjili a lor, nu vã minduits cã tsi va grits, cã tu atsea oarã va vã si-da atsea tsi prindi s-dzãtsets. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Cã nu va s-hits voi tsi grits, ma Duhlu a Tatãlui a vostru tsi va greascã trã voi. <verse eid="MAT 10:20" /><verse number="21" style="v" sid="MAT 10:21" />Tora fratili va prida fratili la moarti, sh-tatili hiljiu a lui, cilimenjlji va si scoalã contra a pãrintsãlor, sh-va lji vatãmã. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Sh-tuts va vã aurascã trã numa mea, ma atsel tsi va aravdã pãnã tu soni va ascapã. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Cãndu s-vã aĝuneascã tu un cãsãbã, fudzits tu un altã, cã dealihea vã dzãc, cã nu va s-bitisits tricãnda cãsãbadzli a Israelui ma nãinti tsi s-yinã Hiljiu a Omlui.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />Uceniclu nu easi prisupru di nvitsãtorlu a lui, nitsi huzmichearlu prisupru di nicuchirlu a lui. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Lj-agiundzi a uceniclui s-facã ca nvitsãtorlu a lui, sh-a huzmichearlui ca nicuchirlu a lui. Macã nicuchirlu a casiljei lu acljimarã Belzebub, ahãntu ma multu va s-lji acljeamã ashã atselji a casiljei a lui!<verse eid="MAT 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />S-nu avets fricã, cã nu ari tsiva anvãlitã tsi nu s-dizvãleascã, sh-vãrã tsiva ascumtu tsi nu va s-facã cunuscutã. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Atsea tsi mini vã dzãc tu scutidi, dzãtsets-u tu lunjinã, sh-atsea tsi avdzãts cu ureclji, predicats-u pri citii. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Sh-nu vã aspãrats di atselji tsi vatãmã truplu, cã nu pot s-vatãmã suflitul. S-vã aspãratsã ma multu di atsel tsi poati s-vã chearã suflitlu sh-truplu tu Colasi. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Nu s-vindu vahi doi harabelji ti un aspru? Cu tut atsea vãrã di elji nu cadi mpadi fãrã di vrearea a Tatãlui a vostru. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Ma a voauã sh-perlji dit capã vã suntu numirati. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />S-nu avets fricã! Voi custusits ma multu di multsã harabelji.<verse eid="MAT 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />Trã atsea, caitsido tsi va mãrtirseascã ti mini nãintea a oaminjlor, sh-mini va mãrtirsescu nãintea a Tatãlui a meu, tsi easti tu tseruri. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Ma caitsido tsi va mi aleapid nãintea a oaminjlor, sh-mini va lu aleapid nãintea a Tatãlui a meu tsi easti tu tseruri. <verse eid="MAT 10:33" /><verse number="34" style="v" sid="MAT 10:34" />S-nu vã minduits cã mini am vinit s-aducã pacea pri loc. Nu vinj s-aducã pacea, ma spata. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Cã mini vinj s-dispartu hiljiu di tatãl, hiljea di muma, sh-nveasta di soacra, <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />sh-neamitsilji a Omlui va hibã atselji dit casa a lui.<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />Atsel tsi va tatãl, icã muma ma multu dicãt mini, nu easti axiu trã mini. Sh-atsel tsi va hiljiu icã hiljea ma multu dicãt mini, nu easti axiu trã mini. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Sh-atsel tsi nu ljea crutsea a lui sh-nu yini dupã mini, nu easti axiu trã mini. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Cai va s-tsãnã bana a lui va u-chearã, ma atsel tsi va u-chearã trã mini va u-aflã.<verse eid="MAT 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />Atsel tsi vã aproachi, mi aproachi mini, sh-atsel tsi mi aproachi mini, aproachi atsel tsi mi ari pitricut. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Atsel tsi aproachi un prufit tu numa a prufitlui, va ljea arãsplata a prufitlui. Sh-atsel tsi aproachi ndreptul tu numa a ndreptului, va ljea arãsplata a ndreptului. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Sh-caitsido tsi lj-da ti beari un putir di apã aratsi a vãrui di aeshti njitsi, tu numa a unui ucenic, dealihea vã dzãc cã elu nu va chearã pute arãsplata a lui.”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">Hãbarea di la Ioan Pãtidzãtorlu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Dupã tsi Isusul bitisi darea a dimãndãciunilor a lui a doisprãdzatsi di ucenitsi a lui, fudzi di atsel loc trã nvitsari sh-trã predicari tu cãsãbadzli di Galilea. <verse eid="MAT 11:1" /><verse number="2" style="v" sid="MAT 11:2" />Ioanul, tsi avea avdzãt tu hapsi si zbura di faptili a Hristolui, pitricu doi di ucenitsilji a lui <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />tra s-lji dzãtsea: “Eshti tini atsel tsi prindi s-yin, icã prindi s-ashtiptãm vãrã altu?” <verse eid="MAT 11:3" /><verse number="4" style="v" sid="MAT 11:4" />Sh-Isusul apãndisi a lor: “Imnats shi spunets-lji a Ioanului aesti tsi avdzãts sh-videts: <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />Orghilji ma ved, shcljiochlji ma imnã, leproshlji suntu curats, surdzãlji ma avdu, mortsãlji ma s-nyeadzã sh-evanghelu ma s-preadicã la oarfãnji. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Ca hara di atsel tsi nu va si zurliseascã di mini!” <verse eid="MAT 11:6" /><verse number="7" style="v" sid="MAT 11:7" />Sh-cãndu elji ma s-dipãrta, Isusul apãrnji s-lã dzãtsea ali multsãmi trã Ioanul: “Tsi vrets s-videts tu irnjii? Cãlamlu tsi lu ascuturã vimtul? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Cãtse avets ishit s-videts? Omlu nviscut cu stranji moali? Ia, atselji tsi si nvescu cu stranji moali bãneadzã tu pãlatili a amiradzlor. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Atumtsea, cãtse ishit afoarã s-videts? Un prufit? Ie, mini vã dzãc, elu easti ma multu di un prufit. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Cã aestu easti atsel ti cai easti scriatã<note caller="-" style="x"><char style="xo" closed="false">11:10 </char><char style="xt" closed="false"><ref loc="MAL 3:1">Mal 3:1</ref>.</char></note>:</para>
  <para style="q1" vid="MAT 11:10">‘Ia mini ma vã pitrec mãndatorlu a meu nãintea a fatsãljei a ta;</para>
  <para style="q2" vid="MAT 11:10">elu va u-fac etimu calea a ta nãintea a ta.’<verse eid="MAT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11" />Dealihea ma vã dzãc: Di atselji tsi suntu amintats di muljeri nu ari ishit pute vãrã ma mari di Ioan Pãtidzãtorlu. Ma, ma njiclu tu amirãriljea a tserurilor easti ma mari di elu. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Sh-di tu dzãlili al Ioan Pãtidzãtorlu sh-pãnã tora amirãriljea a tserurilor ma s-rebilipseashti sh-rebilji u-arãchescu. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Tuts Prufitsilji sh-Legea au prufitipsitã pãnã la Ioanul. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />Sh-macã vrets s-lu aprucheats, elu easti Elia, tsi va yinã. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Cai ari ureclji ti avdzãri, si-avdã <verse eid="MAT 11:15" /><verse number="16" style="v" sid="MAT 11:16" />Cu cai s-u undzescu aestã gheneratã? Undzeashti cu cilimenjlji tsi sta prit pãdzi sh-aurlã a sotsilor a lor <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />dzãcãnda:</para>
  <para style="q1" vid="MAT 11:17">‘Noi avem bãtut flueara ti voi</para>
  <para style="q2" vid="MAT 11:17">ma voi nu giucat;</para>
  <para style="q1" vid="MAT 11:17">ahurhim s-vãitãm</para>
  <para style="q2" vid="MAT 11:17">ma voi nu plãmsit.’<verse eid="MAT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 11:18" />Vini Ioanul tsi nitsi mãca, nitsi bea, sh-elji dzãc: ‘Elu ari un demon.’ <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Vini Hiljiu a Omlui, tsi mãca sh-bea sh-elji dzãc: ‘Ia un mãcãtor sh-un biutor, oaspili a taxidarilor sh-a amãrtioshilor.’ Ma mintimeniljea easti aspus ndreaptã di la hiljilji a ljei.”<verse eid="MAT 11:19" /></para>
  <para style="s1">Trei Cãsãbadzi ni-mitãnjusiti</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Atumtsea, Isusul apãrnji s-vãrgheascã atseali cãsãbadzi, iu eara faptã ma multi di thavmatili a lui, cã atseali nu eara mitãnjusiti, dzãcãnda: <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />“Cavai di tini, Corazin! Cavai di tini, Betsaida! Cã, macã tu Tiro sh-tu Sidon va eara faptã thavmatili tsi s-featsir tu voi, di cu chiro va eara mitãnjusitã cu sac sh-cu cinushi. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Trã-atsea mini ma vã dzãc cã tu dzua a giudicatãljei, Tiro sh-Sidon va s-giudicã cu ma multã lishuredzi dicãt voi. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Sh-tini, Capernaum, tsi ti sculash pãnã tu tser, va ti dipunji pãnã tu Colasi. Cã macã va eara faptã tu Sodom thavmatili atseali mãrili tsi s-featsirã la tini, atsea va eara sh-azã tu aestã dzuã. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Trã atsea mini ma vã dzãc cã dzua a giudicatãljei a Sodomiljei va hibã ma lishoarã di a tsãia.”<verse eid="MAT 11:24" /></para>
  <para style="s1">Giuglu al Hristos</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Tu atsel chiro Isusul apãrnji sh-dzãsi: “Mini ti alavdu, Tatãl, Domnul a tserlui sh-a loclui, cã li ascumsesh aesti lucri a mintimenlui sh-a nvitsatlui, sh-lji li discupirish a njitsilor. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Ie, Tate, cã ashã ts-arãseashti a tsãia. <verse eid="MAT 11:26" /><verse number="27" style="v" sid="MAT 11:27" />Itsido nji si easti datã tu mãnã di la Tatãl a meu, sh-vãrã nu lu cunoashti Hiljiu, dicãt mash Tatãl, sh-vãrã nu lu cunoashti Tatãl, dicãt mash Hiljiu sh-atsel tsi Hiljiu va lji-lu discoapirã. <verse eid="MAT 11:27" /><verse number="28" style="v" sid="MAT 11:28" />Yinits la mini, tuts voi cãpãitsi sh-munduitsi, sh-mini va vã discurmu. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Loats pri voi giuglu a meu shi nvitsats di la mini, cã mini escu inimã-moali sh-tapin, sh-voi va aflats arihati tu suflitli a voastri. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Cã giuglu a meu easti moali shi sartsina a mea easti lishoarã!”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">Isus, Domnul a Sãmbãtãljei</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Tu atsel chiro Isusul ma tritsea unã Sãmbãtã prit siminãturili cu grãn. Sh-ucenitsilji a lui, agiunji apãrnjirã s-arupã schicuri shi s-li mãcã. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Ma Fariseilji, cãndu vidzurã aestã, lji dzãsirã: “Ia, ucenitsilji a tãlji ma facã atsea tsi nu easti volje s-facã Sãmbãta.” <verse eid="MAT 12:2" /><verse number="3" style="v" sid="MAT 12:3" /><note caller="-" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1 Sam 21:1-6</ref>.</char></note>Sh-elu lã dzãsi a lor: “Nu avets cãntatã cã tsi featsi Davidul cãndu avu foami, elu sh-atselji tsi eara cu nãsu? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Elu intrã tu casa a Dumnidzãlui sh-mãcã pãnji sãmtsãti, tsi nu prindea s-li mãca nitsi elu sh-nitsi elji tsi eara cu nãsu, dicãt mash preftsãlji. <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" /><note caller="-" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="NUM 28:9-10">Num 28:9-10</ref>.</char></note>Icã nu avets cãntatã tu lege cã tu templu, cathi Sãmbãtã, preftsãlji calcã Sãmbãta sh-cu tutatsea nu suntu vinovats? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Sh-mini ma vã dzãc cã aoa easti un ma mari dicãt templu. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Sh-ma s-avets shtiutã cã tsi va s-dzãcã<note caller="-" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="MAT 9:13">Mat 9:13</ref>; <ref loc="HOS 6:6">Hos 6:6</ref>.</char></note>: ‘Mini voi njilã sh-nu curbani,’ nu va aveat condamnat nivinovatslji. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Cã Hiljiu a Omlui easti Domnu sh-a Sãmbãtãljei.”<verse eid="MAT 12:8" /></para>
  <para style="s1">Vindicarea a Omlui cu Mãna Uscat</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Deapoea, dupã tsi s-dipãrtã di aclo, Isusul intrã tu sinagoga a lor, <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />sh-ia, aclo eara un bãrbat a cui s-eara uscatã mãna. Elji lu ntribarã Isusul, cu nãeti tsi s-lu acuza ma napoi: “Easti volje tsi tsiniva s-vindicã dzua di sãmbãtã?” <verse eid="MAT 12:10" /><verse number="11" style="v" sid="MAT 12:11" />Sh-elu lã dzãsi a lor: “Easti vãrã di voi tsi ari unã oai, shi aestã lji cadi tu groapã dzua di Sãmbãtã, sh-elu nu va u-acatsã shi s-u-scoatã afoarã? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Ia ashã, cãt ma multu custeadzi omlu di oaia! Trã atsea, easti volje s-fatsã ghini Sãmbãta” <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />Atumtsea elu lji dzãsi a Omlui: “Tindi mãna a ta!” Elu u-timsi sh-mãna a lui s-featsi sãnãtoasã ca alanta. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Atumtsea Fariseilji, dupã tsi ishirã afoarã, fãtsea plan contra a lui cum s-lu vãtãma. <verse eid="MAT 12:14" /><verse number="15" style="v" sid="MAT 12:15" />Ma cãndu Isusul nvitsã aestã, fudzi di aclo sh-unã multsãmi mari lu urma sh-elu lji vindicã tuts. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />Sh-lã ordinã atselji si nu aspunea cai eara elu, <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />tra si mplineascã tsi eara dzãsã di la prufitlu Isaia tsi dzãtsea<note caller="-" style="x"><char style="xo" closed="false">12:17 </char><char style="xt" closed="false"><ref loc="ISA 42:1-4">Isa 42:1-4</ref>.</char></note>:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />“Ia, huzmichearlu a meu, tsi mini lu alepshu, vrutlu a meu, tu cai mini escu hãrsit.</para>
  <para style="q2" vid="MAT 12:18">Mini va lu-bag Duhlu a meu pristi nãsu sh-elu va aspunã ndriptatea la lumea.<verse eid="MAT 12:18" /></para>
  <para style="q2">
    <verse number="19" style="v" sid="MAT 12:19" />Elu nu va si ncaci sh-nitsi va aurlã sh-vãrã nu va avdã boatsea a lui pri pãdzi.<verse eid="MAT 12:19" /></para>
  <para style="q2">
    <verse number="20" style="v" sid="MAT 12:20" />Elu nu va lu frãngã cãlamlu atsel cãlcatlu sh-nu va u-astingã cãndila tsi fatsi fum, pãnã-cãndu elu s-nu aibã faptã s-amintã ndriptatea.<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />Sh-oaminjlji va nãdãeascã tu numa a lui.”<verse eid="MAT 12:21" /></para>
  <para style="s1">Blãstemlu a Fariseilor</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Atumtsea lji adusirã un demonizat, tsi eara orbu sh-mut. Sh-Isusul lu vindicã sh-ashã elu videa shi zbura. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Sh-multsãmea s-ciudisea sh-dzãtsea: “Nacã aestu easti Hiljiu al David?” <verse eid="MAT 12:23" /><verse number="24" style="v" sid="MAT 12:24" />Ma Fariseilji, cãndu avdzãrã aestã, dzãsirã: “Aestu lã aĝuneashti demonjlji mash cu fuchia al Belzebub, printsul a demonjilor.” <verse eid="MAT 12:24" /><verse number="25" style="v" sid="MAT 12:25" />Sh-Isusul, cunuscãnda minduirili a lor, lã dzãsi: “Cathi amirãrilji, tsi s-disparti tu nãsã, s-dutsi cãtrã aspãrdzeari, sh-cathi cãsãbã icã casã, tsi s-disparti tu nãsã, nu va s-ducã multu. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Atumtsea, macã draclu aĝuneashti draclu, elu easti dispãrtsãtã tu nãsã, sh-cum poati s-dãnãseascã amirãriljea a lui? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Sh-macã mini aĝunescu dratslji cu agiutarea al Belzebub, cu agiutarea a cui lã aĝunescu hiljilji a voshtri? Trã atsea elji va hibã giudicãtorlji a voshtri. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Ma, macã mini aĝunescu dratslji cu agiutarea al Duhlu a Dumnidzãlui, atumtsea amirãriljea al Dumnidzãu ari vinitã la voi. <verse eid="MAT 12:28" /><verse number="29" style="v" sid="MAT 12:29" />Icã, cum poati vãrã s-intrã tu casa a vãrtoslu shi s-lji furã ayishtearea a lui, ma s-nu lu ari ligatã ma nãinti vãrtoslu? Mash atumtsea elu va poatã s-lji furã casa. <verse eid="MAT 12:29" /><verse number="30" style="v" sid="MAT 12:30" />Cai nu easti cu mini, easti contra di mini sh-cai nu adunã cu mini hãrgiueashti. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Trã atsea mini ma vã dzãc: Cathi amãrtii sh-blãstem va lã si ljeartã a oaminjlor, ma blãstemlu contra a Duhlui nu va lji si ljeartã a lor. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Sh-caitsido tsi greashti contra a Hiljilui a Omlui va s-ljeartã, ma atsel tsi greashti contra a Duhlui Sãmtu nu va s-ljeartã nitsi tu aestã etã, nitsi tu atsea tsi va yinã.<verse eid="MAT 12:32" /></para>
  <para style="s1">Pomlu sh-Frutili</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />Icã fãtsets bun pomlu, sh-atumtsea frutlu a lui va s-hibã bun, icã fãtsets arãu pomlu sh-frutlu a lui va hibã arãu. Cã pomlu s-cunoashti di frutlu. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Pulji di nãpãrtitsi! Cum putets s-grits ghini, cãndu hits arãi? Cã gura greashti di mplinãtatea a inimãljei. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Omlu atsel bunlu dit ayishtearea atsea buna a inimãljei a lui, scoati lucri buni, ma omlu atsel arãulu scoati lucri arali dit ayishtearea a lui arauã. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />Ma mini ma vã dzãc cã tu dzua a giudicatãljei caitsido va da lugurii trã cathi zbor digeaba tsi au dzãsã. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Cã dupã zboarili a tali va ti ndriptãtseshti, sh-dupã zboarili a tali va ti condamnji.”<verse eid="MAT 12:37" /></para>
  <para style="s1">Semnul al Iona</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Atumtsea niscãntsã scribi sh-Farisei lj-dzãsirã: “Nvitsãtore, noi vrem s-videm vãrã semnu di la tini.” <verse eid="MAT 12:38" /><verse number="39" style="v" sid="MAT 12:39" />Ma elu apãndisinda lã dzãsi a lor: “Aestã farã anapudã sh-curunã-cãlcatã caftã un semnu, ma vãrã semnu nu va lji si da, di cãt semnul al prufitlu Iona. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Cã, ashã cum Iona armasi trei dzãli sh-trei noptsã tu pãnticlu a peshtilui atsel marli, ashã sh-Hiljiu a Omlui va s-hibã trei dzãli sh-trei noptsã tu inima a loclui. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Bãnãtorlji di Ninive va si scoalã la giudicatã deadun cu aestã farã sh-va u-condamnã, cã elji s-mitãnjiusirã cu predicarea al Iona. Sh-ia, aoa easti un ma mari di Iona. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Amirãroanjea di sud va si scoalã la giudicatã deadun cu aestã farã sh-va u-condamnã, cã ea vini dit mardzina ma diparti a loclui ti avdzãri mintimeniljea al Solomonu sh-ia, aoa easti un ma mari di Solomonul. <verse eid="MAT 12:42" /><verse number="43" style="v" sid="MAT 12:43" />Tora cãndu duhlu nicurat ari ishit dit un om, imnã prit locuri fãrã di apã, cãftãnda arihati, ma nu u aflã. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />Atumtsea dzãtsi: ‘Va mi tornu la casa a mea, di iu am ishitã.’ Ma cãndu agiundzi u-aflã goalã, cãtãrsitã shi stulsitã. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Atumtsea s-dutsi sh-ljea cu nãsu shapti duhuri alti ma arali dicãt elu, tsi intrã sh-bãneadzã aclo. Ashã catandisea di ma napoi a aishtui om s-fatsi ma arãu di atsea di ma nãinti. Ashã va s-undzeascã sh-cu aestã farã anapuda.”<verse eid="MAT 12:45" /></para>
  <para style="s1">Fumealja al Isus</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Cãndu Isusul ninga lji grea ali multsãmi, ia muma a lui sh-fratslji a lui ma stãtea nafoarã sh-cãfta si zbura cu nãsu. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Sh-un lji dzãsi: “Ia, muma a ta sh-fratslji a tãlji suntu aclo nafoarã sh-vor sã zburãscã cu tini.” <verse eid="MAT 12:47" /><verse number="48" style="v" sid="MAT 12:48" />Ma elu apãndisinda, lji dzãsi atsilui tsi lji grãi: “Cai easti muma a mea sh-cai suntu fratslji a melji?” <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Timsi mãna a lui cãtrã ucenitsilji a lui sh-dzãsi: “Ia, muma a mea sh-fratslji a melji. <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Cã caitsido tsi fatsi vrearea a Tatãlui a meu tsi easti tu tseruri, nji easti frat, sor sh-mumã.”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">Parabola a Siminãtorlui</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Tu atsea dzuã, Isusul ishi di la casã shi shidzu ningã amari. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Multsãnji mãri s-adunarã anvãrliga di nãsu sh-elu s-alinã tu unã varcã shi shidzu, sh-tut populu stãtea mprostu mardzina di amari. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Sh-elu lã aspusi multi lucri a lor tu parabolã: “Ia, un siminãtor ishi tra s-seaminã. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Iarã ma simina, niscãnti di simintsãli cãdzurã ningã cali. Puljilji vinirã sh-li mãcarã. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Niscãnti alti cãdzurã tu un loc chitros, iu nu avea multã tsarã, sh-fitrusirã trãoarã cã nu avea tsarã multã. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Ma cãndu ishi soarili s-pãlirã shi s-uscarã cã nu avea arãdãtsinã. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Altili cãdzurã prit schinji, schinjilji criscurã sh-lji acãtsarã anasa. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Ma, atsea simintsã tsi cãdzu tu loc bunã deadi carpo, unã sutã di ori, alanta shaidzãtsi di ori sh-alanta treidzãtsi di ori. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Cai ari ureclji trã avdzãri, s-avdã!”<verse eid="MAT 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Atumtsea ucenitsilji s-apruchearã di Isus sh-lji dzãsirã: “Cãtse lã zburashti a lor cu parabolã?” <verse eid="MAT 13:10" /><verse number="11" style="v" sid="MAT 13:11" />Sh-elu lã apãndisi a lor: “Cã a voauã vã si easti datã s-cunushtets mistiryili a amirãriljei a tserurilor, iarã a lor nu lã si easti datã. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Cã atsilui tsi ari, va lji si da sh-altã sh-va lji artirseascã. Iarã atsilui tsi nu ari, va lji si ljea sh-atsea tsi ari. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Trã atsea mini lã zburãscu a lor cu parabolã, cã mutrescu sh-nu ved, ascultã sh-nu avdu sh-nitsi cã aduchescu. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />Ashã tu elji si mplineashti prufitsia al Isaia, tsi dzãtsi:</para>
  <para style="q1" vid="MAT 13:14">
    <char style="it">‘Voi dealihea va avdzãts, ma nu va aduchits,</char></para>
  <para style="q2" vid="MAT 13:14">
    <char style="it">dealihea va mutrits, ma nu va videts.</char><verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />
    <char style="it">Cã inima a popului aishtui easti ni sãmtsãt,</char></para>
  <para style="q2" vid="MAT 13:15">
    <char style="it">elji suntu faptã grelji di ureclji</char></para>
  <para style="q2" vid="MAT 13:15">
    <char style="it">sh-au ncljisã ocljilji,</char></para>
  <para style="q1" vid="MAT 13:15">
    <char style="it">tra s-nu veadã cu oclji</char></para>
  <para style="q2" vid="MAT 13:15">
    <char style="it">s-nu avdã cu ureclji,</char></para>
  <para style="q1" vid="MAT 13:15">
    <char style="it">s-nu giudicã cu inima</char></para>
  <para style="q2" vid="MAT 13:15">
    <char style="it">shi s-nu s-toarnã,</char></para>
  <para style="q2" vid="MAT 13:15">
    <char style="it">sh-mini s-lji vindicã.’</char><verse eid="MAT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />Ma ca hara di ocljilji a voshtri cã ved sh-urecljili a voastri cã avdu. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Cã alihea vã dzãc cã multsã prufits sh-ndreptsã vrurã s-li veadã atseali tsi voi ma videts sh-nu li vidzurã, shi s-li avdu atseali tsi voi avdzãts shi nu li avdzãrã!<verse eid="MAT 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />Trã atsea voi aduchits parabola a siminãtorlui. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Cãndu vãrã avdi zborlu a amirãriljei sh-nu lu aducheashti, yini slablu sh-lji arãcheashti atsea tsi eara siminatã tu inima a lui. Atsea easti simintsa siminat ningã cali. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Shi simintsa tu loclu chitros, easti atsel tsi avdi zborlu sh-lu aproachi trãoarã cu harauã. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />Ma, nu ari arãdãtsinã pri nãsã sh-easti ti putsãn chiro. Cãndu yini munduirea icã avinarea trã itia a zborlui, s-apãrãtseashti trãoarã. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Shi simintsa cãdzut tu schinji easti atsel tsi ascultã zborlu, ma nvirinarea a lumiljei aishtei sh-arãdearili a ayishterilor, astup zborlu, sh-ea s-fatsi nifructoasã. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Ma atsea simintsã tsi cadi tu loc bun, easti atsel cai ascultã zborlu, lu aducheashti sh-da carpo. Sh-un fatsi unã sutã di ori, altu shaidzãtsi di ori shi altu treidzãtsi di ori.”<verse eid="MAT 13:23" /></para>
  <para style="s1">Parabola a Ordzului</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Elu l-pripunã a lor un altã parabolã: “Amirãriljea a tserurilor lj-undzeashti a unui om tsi siminã simintsã bunã tu agrul a lui. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Ma, iarã oaminjlji ma durnjea, vini neamiclu a lui shi siminã ordzu prit grãn sh-fudzi. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Cãndu grãnlu criscu sh-featsi carpo s-vidzu sh-ordzul. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />Sh-huzmichearlji a nicuchirlui a casiljei s-apruchearã la nãsu sh-lji dzãsirã: ‘Doamne, nu ai siminatã simintsã bunã tu agrul a tãu? Di iu ishi ordzul?’ <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />Sh-elu lã apãndisi a lor: ‘Aestã lu ari faptã neamiclu.’ Atumtsea huzmichearlji lji dzãsirã: ‘Vrei tini s-nidzem shi s-li scutem?’ <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />Ma elu dzãsi: ‘Nu, cã scutãnda ordzul, deadun cu nãsu va scutets sh-grãnlu. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Alãsats s-creascã deadun pãnã la sitsirari. La chirolu a sitsirariljei va lã dzãc a sitsirãtorilor: Adunats ma nãinti ordzul, ligats-lu tu mãnuclji tra si-u ardem, sh-grãnlu bãgats-lu tu hãmbarea a mea.’”<verse eid="MAT 13:30" /></para>
  <para style="s1">Parabola al Gãrnutsu di Sinap sh-a Mãeauãljei</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Elu lã pripunã a lor un parabolã altã dzãcãnda: “Amirãriljea a tserurilor lj-undzeashti a unui gãrnuts di sinapi, tsi lu ia un om sh-lu seamni tu agrul a lui. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Elu easti ma njic di tuti simintsãli, ma dupã tsi creashti, easti ma mari dicãt tuti erghili, shi s-fatsi un pom, ahãntu cãt puljilji a tserlui yin sh-aflã streahã tu dedzãli a lui.” <verse eid="MAT 13:32" /><verse number="33" style="v" sid="MAT 13:33" />Elu lã dzãsi a lor unã parabolã altã: “Amirãriljea a tserurilor undzeashti cu mãeaua tsi u-ljea unã muljeari sh-acatsi aloatlu cu trei misuri di fãrinã pãnã cãndu aloatlu s-hibã etimu.” <verse eid="MAT 13:33" /><verse number="34" style="v" sid="MAT 13:34" />Isusul tuti aesti lucri lã-li dzãsi a multsãnjilor tu parabolã. Sh-nu lã zbura a lor tsiva fãrã parabolã, <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />tsi si mplinea tsi eara dzãsã di la prufitlu:</para>
  <para style="q1" vid="MAT 13:35">
    <char style="it">“Mini va discljid gura a mea prit parabolã</char></para>
  <para style="q2" vid="MAT 13:35">
    <char style="it">sh-va disvãlescu lucrili atseali ascumtili di tu adrarea a lumiljei.</char>”<verse eid="MAT 13:35" /></para>
  <para style="s1">Explicarea a Parabolãljei</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Atumtsea Isusul, dupã tsi alãsã multsãnjili, s-turnã la casã sh-ucenitsilji a lui lji-s-apruchearã sh-lji dzãsirã: “Nã aspunã parabola a ordzului dit agru.” <verse eid="MAT 13:36" /><verse number="37" style="v" sid="MAT 13:37" />Sh-elu apãndisinda lã dzãsi a lor: “Atsel tsi seaminã simintsã bunã easti Hiljiu a Omlui. <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />Agrul easti lumea, simintsa atsea buna suntu hiljilji a amirãriljei sh-ordzul suntu hiljilji a arãului. <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />Neamiclu tsi u-ari siminatã easti draclu, iarã sitsirarea easti bitisita a lumiljei shi sitsirãtorilji suntu anghilji. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />Ashã cum s-adunã ordzul shi s-ardi tu foc, ashã va hibã tu bitisita a lumiljei: <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Hiljiu a Omlui va pitreacã anghilji a lui sh-elji va adunã dit amirãriljea a lui tuti scandalili sh-atselji tsi facã anapudii <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />sh-va lji arucã tu cireaplu di foc. Aclo va hibã plãngul sh-cãrtsãnirea a dintsãlor. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Atumtsea ndreptsãlji va strãlutseascã ca soarili tu amirãriljea a Tatãlui a lor. Cai ari ureclji trã avdzãri, s-avdã!”<verse eid="MAT 13:43" /></para>
  <para style="s1">Trei Paraboli</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />“Atumtsea, amirãriljea a tserurilor undzeashti ca unã ayishteari ascumtã tu un agru, tsi un om u-aflã sh-u ascundi. Di haraua tsi ari, s-dutsi, vindi itsi-ari sh-acumpãrã agrul atsel.<verse eid="MAT 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />Tutashã, amirãriljea a tserurilor undzeashti ca un prãmãteftu tsi s-dutsi caftã mãrgãritãri buni. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Cãndu aflã un mãrgãritar cu mari tinjii, s-dutsi sh-vindi itsi ari sh-lu acumpãrã.<verse eid="MAT 13:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />Amirãriljea a tserurilor undzeashti tutashã cu plasa arcatã tu amari, tsi adunã multi soi di peshti. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Cãndu ea easti umplutã, piscarlji u-scoatã mardzina di amari sh-apãrnjeascã s-adun tu coshuri atselji bunjilji, sh-atselji tsi nu suntu buni lji arucã nclo. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Ashã va s-undzeascã tu bitisita a lumiljei. Va yinã anghilji sh-va li dispartã anapudzlji di ndreptsãlji <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />sh-va lji arucã tu cireaplu di foc. Aclo va-hibã plãngul sh-cãrtsãnirea a dintsãlor.”<verse eid="MAT 13:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />Isusul lã ntribã atselji: “Li-aduchit tuti aesti?” Elji lji apãndisirã: “Ie.” <verse eid="MAT 13:51" /><verse number="52" style="v" sid="MAT 13:52" />Sh-elu lã dzãsi a lor: “Trã aestã cathi scrib, tsi s-fatsi un ucenic tu amirãriljea a tserurilor lj-undzeashti a unui nicuchir di casã tsi scoati nafoarã dit ayishtearea a lui lucrili atseali nali sh-atseali vecljili.”<verse eid="MAT 13:52" /></para>
  <para style="s1">Nipistipsirea al Nazaret</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Dupã tsi Isusul lji avea bitisitã aesti paraboli, fudzi di aclo. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />Dupã tsi vini tu patria a lui, lji nvitsa oaminjlji tu sinagoga a lor, sh-elji s-ciudisea shi ntriba: “Di iu lj-vinirã aishtui aestã mintimenilji sh-aestã puteari ti thavmati? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Nu easti aestu hiljiu a lemnarlui? Nu s-acljeamã muma a lui Maria, sh-fratslji a lui Iacov, Iose, Simon sh-Iuda? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Sh-surãrili a lui nu suntu tuti la noi? Atumtsea di iu lji vinirã aishtui tuti aesti?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Shi si cihtisea cu nãsu. Ma Isusul lã dzãsi a lor: “Un prufit nu easti nitinjisit, dicãt mash tu patria a lui sh-tu casa a lui.” <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />Sh-trã itia a nipistipsiriljei a lor, elu nu featsi aclo multi thavmati mãri.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s1">Moartea al Ioan Pãtidzãtorlu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Tu atsel chiro Herodu, <note caller="+" style="f"><char style="fr" closed="false">14:1 </char><char style="ft" closed="false">tetrarcu easti numã veaclji. </char></note>domnitorlu a Galileiljei, avdzã ti anamea al Isus, <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />sh-lã dzãsi a huzmichearilor a lui: “Aestu easti Ioan Pãtidzãtorlu. Elu s-nyie dit mortsã sh-trã atsea puterili suprãnaturali ma lucreadzã la nãsu.” <verse eid="MAT 14:2" /><verse number="3" style="v" sid="MAT 14:3" />Herodul, lu avea acãtsat Ioanul, lji avea bãgatã prãnghili sh-lu avea hãpsãnit, trã itia a Herodiadãljei, muljearea al Filipu, fratili a lui. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Cã Ioanul lji dzãtsea: “Nu easti volje s-bãnedz cu nãsã!” <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Sh-cu tutã cã vrea s-lu vãtãma, Herodul avea fricã di populu tsi lu lugursea Ioanul prufit. <verse eid="MAT 14:5" /><verse number="6" style="v" sid="MAT 14:6" />Cãndu ma si sãrbãtorea dzua a amintariljei a Herodului, hiljea a Herodiadãljei giucã nãintea a oaspitslor shi lj-arsi a Herodului ahãntu multu, <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />cãt elu lji tãxi a ljei cu spigiurari cã va lji dãdea itsi va lji cãfta. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Shi ea, pimtã di muma a ljei, dzãsi: “Dã-nji aoa, tu unã tãpsii caplu al Ioan Pãtidzãtorlu.” <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />Amirãlu si-nvirinã, ma trã itia a spigiurariljei nãintea a acljimatslor tsi eara cu nãsu la measã, ordinã s-lji lu aduc. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Ashã elu pitricu un tu hapsi s-lji talji caplu al Ioan Pãtidzãtorlu. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Sh-caplu a lui lu adusirã tu unã tãpsii sh-lji-lu deadirã ali feati, shi ea lji-lu deadi ali mumi. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Deapoea vinirã ucenitsilji al Ioan, loarã truplu a lui sh-lu ngruparã. Atumtsea, elji s-dusirã shi lj-aspusirã al Isus.<verse eid="MAT 14:12" /></para>
  <para style="s1">Multsirea di Prota a Pãnjilor</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Cãndu Isusul li avdzã aesti, s-nchisi di-aclo cu unã varcã shi s-dusi singur tu un loc ermu, sh-multsãmea cãndu avdzã s-dusi dupã nãsu pri cicioari dit cãsãbadz. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Sh-Isusul, cãndu ishi dit varcã, vidzu unã multsãmi mari, avu njilã trã elji sh-vindicã lãndzitslji a lor. <verse eid="MAT 14:14" /><verse number="15" style="v" sid="MAT 14:15" />Deapoea cãtrã seara ucenitsilji a lui s-apruchearã di nãsu sh-lji dzãsirã: “Aestu loc easti ermu sh-oara tricu. Alasã multsãmea s-ducã prit hoari shi s-acumpãrã trã mãcari.” <verse eid="MAT 14:15" /><verse number="16" style="v" sid="MAT 14:16" />Isusul lã dzãsi a lor: “Nu easti ananghi s-ducã. Dats-lã voi s-mãcã!” <verse eid="MAT 14:16" /><verse number="17" style="v" sid="MAT 14:17" />Sh-elji lji dzãsirã: “Noi aoa nu avem altã tsiva dicãt tsintsi pãnji sh-doi peshti.” <verse eid="MAT 14:17" /><verse number="18" style="v" sid="MAT 14:18" />Sh-elu lã dzãsi: “Adutsets-li aoa la mini.” <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Atumtsea lã ordinã multsãnjili s-sheadã mpadi pri iarbã. Deapoea lo tsintsi pãnjili sh-doi peshtili sh-dupã tsi sculã ocljilji cãtrã tser, li ghinicuvãntã, li frãmsi pãnjili sh-li deadi a ucenitsilor, sh-ucenitsilji a multsãnjilor. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Sh-tuts mãcarã shi s-fãnãtirã. Deapoea ucenitsilji adunarã bucãtsili tsi armasirã sh-umplurã doisprãdzatsi di coshuri mplini. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Sh-atselji tsi mãcarã eara anvãrliga di tsintsi njilji di bãrbats, ni misurat muljerili sh-cilimenjlji.<verse eid="MAT 14:21" /></para>
  <para style="s1">Isusul Imnã pri Apã</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Trãoarã dupã aestã Isusul lã ordinã ucenitsilji a lui s-intrã tu varcã shi s-arucã di napãrti, pãnã-cãndu elu s-alasã s-fugã multsãnjili. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Dupã tsi alãsã multsãmea s-fugã, s-alinã singur pri munti s-roagã. Sh-cãndu tunicã elu eara aclo singur dip. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Tu aestã oarã varca eara tu mesea di amari, shi s-plãscãnea di vãljurili cã vimtul eara contra. <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" />Cãtrã apiritã, Isusul s-dusi aproapi di nãshi, imnãnda pri amari. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Ucenitsilji vidzãnda cãtrã elu tsi imna pri amari, ahurhirã s-aurlã di fricã sh-dzãsirã: “Easti vãrã fantazmã!” <verse eid="MAT 14:26" /><verse number="27" style="v" sid="MAT 14:27" />Ma trãoarã Isusul lã grãi a lor: “Arihãtipsits-vã! Mini escu, s-nu avets fricã!” <verse eid="MAT 14:27" /><verse number="28" style="v" sid="MAT 14:28" />Sh-Petrul lj-dzãsi: “Doamne, macã eshti tini, mi ursea s-yin la tini pri apã!” <verse eid="MAT 14:28" /><verse number="29" style="v" sid="MAT 14:29" />Elu lj-dzãsi: “Haidi!” Sh-Petrul dipunã dit varcã sh-imnã pri apã, s-njidzea la Isusul. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Ma, vidzãnda cã vimtul eara vãrtos, s-aspãre, sh-apãrnjinda s-afundã aurlã: “Doamne, ascapã-mi!” <verse eid="MAT 14:30" /><verse number="31" style="v" sid="MAT 14:31" />Sh-Isusul lj-timsi trãoarã mãna, lu acãtsã shi lj-dzãsi: “Om putsãn-pistimen, cãtse fushi nisigur?” <verse eid="MAT 14:31" /><verse number="32" style="v" sid="MAT 14:32" />Apoea, cãndu intrarã tu varcã, vimtul pãpsi. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Atumtsea elji tsi eara tu varcã si ncljinarã la nãsu, dzãcãnda: “Dealihea tini eshti Hiljiu a Dumnidzãlui!” <verse eid="MAT 14:33" /><verse number="34" style="v" sid="MAT 14:34" />Apoea, dupã tsi agiumsirã tu alantã parti, vinirã tu loclu a Ghenezaretlui. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Sh-oaminjlji atsilui loc, macãt lu cunuscurã, pitricurã zbor tu tutã loclu di anvãrliga. Sh-adusirã la elu tuts nipututslji. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Sh-lji-si rugarã tra s-putea s-bãga mãna tu mardzina a stranjilui a lui, shi tuts atselji tsi bãgarã mãna la stranjiu s-vindicarã.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s1">Adetsili a Protsilor</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Atumtsea scriblji sh-Fariseilji vinirã di Ierusalem la Isusul sh-lu ntribarã: <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“Cãtse ucenitsilji a tãlji ncalcã adetea a aushlor? Cã nu aspealã mãnjili nãinti tsi s-mãcã.” <verse eid="MAT 15:2" /><verse number="3" style="v" sid="MAT 15:3" />Iarã elu lã apãndãsi a lor: “Sh-voi cãtse ncãlcats ordinlu a Dumnidzãlui trã adetea a voastrã? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Dumnidzãlu ari ordinatã ashã: ‘Tinjisea tatãl sh-muma,’ shi: ‘Atsel tsi va blãsteam tatãl sh-muma s-condamnã cu moarti.’ <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Iarã voi dzãtsets: Caitsido tsi lj-dzãtsi a tatãlui sh-a mumãljei: ‘Itsido tsi aveam trã tini, lji easti datã a Dumnidzãlui,’ <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />elu nu easti ma strimtu s-tinjiseascã tatãl sh-muma a lui. Ashã voi avets dispretsuit zborlu a Dumnidzãlui trã adetea a voastrã. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Ipucrits, ghini prufitipsi Isaia trã voi cãndu dzãsi<note caller="-" style="x"><char style="xo" closed="false">15:7 </char><char style="xt" closed="false"><ref loc="ISA 29:13">Isa 29:13</ref>.</char></note>:<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />‘Populu aestu ma nji s-aproachi cu gura<note caller="+" style="f"><char style="fr" closed="false">15:8 </char><char style="fq" closed="false">nji s-aproachi cu gura </char><char style="ft" closed="false">Aestu stih nu s-aflã tu vecljili manuscrisi. </char></note></para>
  <para style="q2" vid="MAT 15:8">sh-mi tinjiseashti cu budzãli,</para>
  <para style="q2" vid="MAT 15:8">ma inima a lor easti diparti di mini.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />Sh-digeaba mi tinjiseascã,</para>
  <para style="q2" vid="MAT 15:9">nvitsãnda nvitsãturili tsi suntu reguli a oaminjlor.’”<verse eid="MAT 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Deapoea acljimã multsãmea aproapi di nãsu sh-lã dzãsi: “Ascultats sh-aduchits! <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Omlu nu s-lãvusheashti di atsea tsi lj-intrã n-gurã, ma di atsea tsi lj-easi dit gurã s-lãvusheashti.” <verse eid="MAT 15:11" /><verse number="12" style="v" sid="MAT 15:12" />Atumtsea ucenitsilji a lui s-apruchearã shi lj-dzãsirã: “Shtii cã Fariseilji, cãndu li avdzãrã aesti zboari si scandalizarã?” <verse eid="MAT 15:12" /><verse number="13" style="v" sid="MAT 15:13" />Ma elu apãndisinda lã dzãsi: “Itsi simintsã tsi Tatãl a meu tserescu nu ari siminatã, va si scoatã cu arãdãtsinã. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Alãsats-lji atselji! Elji suntu orghi, cãlãuzlji a orghilor. Macã un orbu lj-cãlãuzãshti a unui altu orbu, doilji va s-cadã tu groapã.” <verse eid="MAT 15:14" /><verse number="15" style="v" sid="MAT 15:15" />Atumtsea Petrul lj-dzãsi: “Nã aspunã sh-a noauã aestã parabolã.” <verse eid="MAT 15:15" /><verse number="16" style="v" sid="MAT 15:16" />Sh-Isusul dzãsi: “Sh-voi nu avets aduchit ninga? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Nu aduchits cã itsi intrã tu gurã treatsi tu pãnticã sh-dutsi tu duvaleti? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Iarã atseali tsi easã dit gurã, easã dit inimã, sh-atseali lãvushescu omlu. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Cã dit inimã easã minduirili atseali arali, vãtãmãrili, ncãlcarea a curuniljei, putãnsirea, furãrili, mãrtiriili arãdioasi sh-blãstimãrili. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Aesti suntu atseali tsi lãvushescu omlu. Iarã s-mãtsã cu mãnjili niaspilati nu s-lãvushashti omlu.”<verse eid="MAT 15:20" /></para>
  <para style="s1">Pistea ali Muljeari Pãngãnã</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Deapoea Isusul, dupã tsi s-dipãrtã di aclo, s-nchisi cãtrã pãrtsãli a Tirlui sh-a Sidonlui. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Sh-ia, unã muljeari Caneanitã tsi avea vinit dit atseali pãrtsi, ahurhii s-aurlã dzãcãnda: “Njiluea-mi mini, Doamne, Hiljiu al David! Feata a mea easti multã arãu, easti demonizat!” <verse eid="MAT 15:22" /><verse number="23" style="v" sid="MAT 15:23" />Ma elu nu lj-apãndisi dip. Sh-ucenitsilji a lui lji s-apruchearã sh-lji si rugarã dzãcãnda: “Sãlãghea-u atsea, cã ma aurlã dupã noi.” <verse eid="MAT 15:23" /><verse number="24" style="v" sid="MAT 15:24" />Iarã elu lã apãndisi: “Mini escu pitricut, mash di oili atseali chiruti a casiljei al Israel.” <verse eid="MAT 15:24" /><verse number="25" style="v" sid="MAT 15:25" />Ma ea vini shi si ncljinã, dzãcãnda: “Doamne, agiutã-mi!” <verse eid="MAT 15:25" /><verse number="26" style="v" sid="MAT 15:26" />Isusul apãndisi: “Nu easti ghini s-ljeai pãnea a cilimenjilor shi s-lu arutsã la cãtsãlji a cãnjilor.” <verse eid="MAT 15:26" /><verse number="27" style="v" sid="MAT 15:27" />Ma ea dzãsi: “Easti alihea, Doamne, cã sh-cãtsãljilji a cãnjilor mãcã sãrmili tsi cadã di la measa a nicuchirilor a lor.” <verse eid="MAT 15:27" /><verse number="28" style="v" sid="MAT 15:28" />Atumtsea Isusul lj-apãndisi dzãcãnda: “Muljeari, mari easti pistea a ta! Si s-facã ashã cum vrei.” Sh-tu atsea oarã hiljea a ljei s-vindicã.<verse eid="MAT 15:28" /></para>
  <para style="s1">Multsirea a Doauã a Pãnjilor</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Deapoea, dupã tsi s-nchisi di aclo, Isusul vini ningã amarea a Galileiljei, s-alinã pri munti shi shidzu aclo. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Shi lji s-apruchearã multsãnji mãri tsi adutsea cu nãshi shcljiochi, orghi, sãcats, muts, sh-multsã altsã, lji bãgarã la cicioarili al Isus sh-elu lji vindicã. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Multsãnjili s-ciudisea cãndu videa cã mutsãlji grea, sãcatsilji s-vindica, shcljiochili imna sh-orghilji videa. Sh-mãrea Dumnidzãlu al Israel. <verse eid="MAT 15:31" /><verse number="32" style="v" sid="MAT 15:32" />Sh-Isusul lj-acljimã ucenitsilji a lui ningã nãsu sh-lã dzãsi: “Mini am njilã di multsãmea, cã s-featsirã trei dzãli tsi sta cu mini shi nu ari tsiva ti mãcari. Nu voi s-lji nchisescu aĝiunji, s-nu lishineadzã n-cali.” <verse eid="MAT 15:32" /><verse number="33" style="v" sid="MAT 15:33" />Sh-ucenitsilji a lui lji dzãsirã: “Ma iu va s-aflã tu aestu loc ermu ahãnti pãnji tra s-fãnãteascã unã multsãmi ahãntã mari?” <verse eid="MAT 15:33" /><verse number="34" style="v" sid="MAT 15:34" />Sh-Isusul lã dzãsi a lor: “Cãti pãnji avets?” Elji dzãsirã: “Shapti shi ndoi peshti njitsi.” <verse eid="MAT 15:34" /><verse number="35" style="v" sid="MAT 15:35" />Atumtsea elu ordinã multsãnjili s-sheadã mpadi. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Deapoea lo atseali shapti pãnji sh-peshtilji, shi hãristisi Dumnidzãlu, li pãrtsã, sh-li deadi a ucenitsilor a lui sh-elji a multsãmiljei. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Sh-tuts mãcarã shi s-fãnãtirã, sh-cu bucãtsili tsi armasirã umplurã shapti coshuri mplini. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Sh-atselji tsi mãcarã eara patru njilji di bãrbats, ni misurat muljerili sh-cilimenjlji. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Deapoea, dupã tsi deadi cali a multsãmiljei, s-alinã tu varcã shi s-dusi cãtrã loclu Magdala.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">Maeaua a Fariseilor</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Deapoea lji s-apruchearã Fariseilji sh-Saduceilji tra s-lu cãrtea Isusul shi lj-cãftarã s-lã aspunã un semnu dit tser. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />Iarã elu lã apãndisi a lor: “La searã voi dzãtsets: ‘Va hibã chirolu bun, cã tserlu easti roshu.’ <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Sh-dimineatsa dzãtsets: ‘Azã va hibã furtunã, cã tserlu easti roshu sh-nurat.’ Voi shtits s-aduchits fatsa a tserlui, ma nu putets s-aduchits seamnili a chirolui. <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Unã gheneratã anapudã sh-curunã-cãlcatã cafti un semnu, ma nu va lji si da vãrã semnu dicãt mash semnul a prufitlui Iona.” Sh-elu lji alãsã sh-fudzi.<verse eid="MAT 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Cãndu ucenitsilji a lui agiumsirã tu alantã parti a amariljei, vidzurã cã avea agãrshitã s-ljea pãni. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Iarã Isusul lã dzãsi a lor: “Bãgats mintea sh-afirits-vã di maeaua a Fariseilor sh-a Sadutseilor!” <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />Sh-elji s-minduirã un cu-alantu dzãcãnda: “Nu avem loatã pãni.” <verse eid="MAT 16:7" /><verse number="8" style="v" sid="MAT 16:8" />Ma Isusul lji achicãsi sh-lã dzãsi a lor: “Oaminji pisti-putsãn, trã tse zburãts cu un-alantu cã nu avets loat pãni? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Nu avets achicãsit ninga sh-nu adutsets aminti tsintsi pãnji ti tsintsi njilji di bãrbats sh-cãti coshuri avets umplutã? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Sh-nitsi atseali shapti pãnji ti patru njilji di bãrbats sh-cãti coshuri avets umplut? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Cum nu aduchits cã nu eara zborlu ti pãnea cãndu vã dzãshã s-vã afirits di maeaua a Fariseilor sh-a Sadutseilor?” <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />Atumtsea elji aduchirã cã elu nu lã avea dzãsã s-afireascã di maeaua a pãniljei, ma di nvitsãtura a Fariseilor sh-a Sadutseilor.<verse eid="MAT 16:12" /></para>
  <para style="s1">Aspunearea al Petru</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Cãndu Isusul, agiumsi tu loclu a Cezareiljei al Filip lã ntribã ucenitsilji a lui: “Cai dzãc oaminjlji cã easti Hiljiu a Omlui?” <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" />Sh-elji dzãsirã: “Niscãntsã dzãc cã easti Ioan Pãtidzãtorlu, altsã Elia, altsã Ieremia, icã un di prufitsilji.” <verse eid="MAT 16:14" /><verse number="15" style="v" sid="MAT 16:15" />Elu lji ntribã: “Ma voi, cai dzãtsets cã escu mini?” <verse eid="MAT 16:15" /><verse number="16" style="v" sid="MAT 16:16" />Sh-Simon Petrul apãndisi: “Tini eshti Hristolu, Hiljiu a Dumnidzãlui atsilui yiului.” <verse eid="MAT 16:16" /><verse number="17" style="v" sid="MAT 16:17" />Ma Isusul lj-apãndisi a lui: “Hãrãcop eshti tini, Simon, hiljiu al Iona, cã aestã nu ts-lu dizvãli nitsi truplu nitsi sãndzili, ma Tatãl a meu tsi easti tu tseruri. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Sh-mini ma tsã dzãc tutashã cã tini eshti Petrul, tsi va s-dzãc cheatra pri cai mini va s-adarã bisearica a mea sh-portsãli a Colasiljei nu va u-azvingu. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Sh-mini va tsã dau cljeili a amirãriljei a tserurilor. Sh-itsi ai ligat pri loc, va hibã ligat pri tseruri, sh-itsi ai dizligat pri loc, va hibã dizligat tu tseruri.” <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />Atumtsea lã ursi ucenitsilji a lui tsi s-nu dzãtsea a vãrui cã elu eara Hristos.<verse eid="MAT 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Di atsea oarã Isusul ahurhi s-lã aspunã a ucenitsilor a lui cã prindi s-dutsea la Ierusalem, s-munduea multã ti itia a aushlor, a mãrlor a preftsãlor sh-a scribilor, cã lipseashti si s-vãtãma sh-va s-nyea a treia dzuã. <verse eid="MAT 16:21" /><verse number="22" style="v" sid="MAT 16:22" />Atumtsea Petrul lu lo di unã parti sh-ahurhi s-lu vãrgheascã dzãcãnda: “Doamne, s-ti afireascã Dumnidzãlu! Aestã nu va s-undzeascã pute!” <verse eid="MAT 16:22" /><verse number="23" style="v" sid="MAT 16:23" />Ma elu s-turnã shi lj-dzãsi a Petrului: “Dipãrteadzã-ti di la mini, Drac! Tini eshti cicãrdisiri ti mini, cã nu ai tu minti lucrili a Dumnidzãlui, ma lucrili a oaminjlor.”<verse eid="MAT 16:23" /></para>
  <para style="s1">Tsãnearea a Crutsiljei</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Atumtsea Isusul lã dzãsi a ucenitsilor a lui: “Macã vãrã va yinã dupã mini, si s-aleapidã, s-u ljea crutsea a lui shi s-mi urmeadzã. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Cã atsel tsi va ascapã bana a lui, va u-chearã, ma atsel tsi va u-chearã bana a lui trã mini, va u-aflã atsea. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Tsi amintatic ari omlu macã amintã lumea tutã sh-deapoea u-cheari suflitlu a lui? Icã tsi poati s-da omlu trã alãxirea a suflitlui a lui? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Cã Hiljiu a Omlui va yinã tu mãrirea a Tatãlui a lui deadun cu anghilji a lui, sh-atumtsea elu va lji arãsplãteascã a-cathiunu dupã faptili a lui. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Dealihea vã dzãc cã niscãntsã di atselji tsi ma sta aoa nu va moarã ni vidzutã ma nãinti Hiljiu a Omlui yininda tu amirãriljea a lui.”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">Fãnirusirea al Isus</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Dupã shasi dzãli Isusul lo cu nãsu Petrul, Iacovul, sh-Ioanul fratili a lui, sh-lji alinã pri un munti analtu dinãparti. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Shi elu s-alãxi nãintea a lor. Lji si strãlutsi fatsa ca soarili shi stranjili a lui s-featsirã albã ca lunjina. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Sh-ia, lã si fãnirusirã a lor Moisiul sh-Elia tsi zbura cu nãsu. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />Atumtsea Petrul lji dzãsi al Isus: “Doamne, easti ghini tsi noi him aoa. Ma s-vrei, mini va fac aoa trei tendi, unã trã tini, unã trã Moisiul sh-unã trã Elia.” <verse eid="MAT 17:4" /><verse number="5" style="v" sid="MAT 17:5" />Cãndu elu zbura ninga, ia un nior lunjinos lã anvãli sh-dit nior s-avdzã unã boatsi tsi dzãtsea: “Aestu easti Hiljiu a meu vrut, di la cai escu hãrsit, ascultats-lu!” <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />Ucenitsilji cãndu u-avdzãrã aestã, cãdzurã pri dintsã mpadi shi s-aspãrarã multu. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Sh-Isusul s-apruche, bãgã mãna pri nãshi sh-lã dzãsi: “Sculats-vã sh-nu vã aspãrats!” <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Sh-elji sculãnda ocljilji, nu vidzurã om, mash Isusul singur.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Deapoea cãndu ma dipuna dit munti, Isusul lã ursi dzãcãnda: “S-nu lji dzãtsets a vãrui trã aestã viziuni pãnã cãndu Hiljiu a Omlui s-nyeadzã dit mortsã.” <verse eid="MAT 17:9" /><verse number="10" style="v" sid="MAT 17:10" />Atumtsea ucenitsilji a lui lu ntribarã: “Cãtse scriblji dzãc cã prindi s-yinã ma nãinti Elia?” <verse eid="MAT 17:10" /><verse number="11" style="v" sid="MAT 17:11" />Sh-Isusul lã apãndisi: “Dealihea cã Elia va yinã ma nãinti sh-va adarã napoi itsido. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Ma mini vã dzãc, cã Elia ari vinitã sh-elji nu lu cunuscurã, ma featsirã cu nãsu cum vrurã. Ashã cã Hiljiu a Omlui va s-mundueascã di nãshi.” <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Atumtsea ucenitsilji lu aduchirã cã lã avea zburãtã di Ioan Pãtidzãtorlu.<verse eid="MAT 17:13" /></para>
  <para style="s1">Vindicarea a Ficiorlui Demonizat</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Cãndu elji vinirã aproapi di multsãmea, un bãrbat s-apruche sh-dzinucljãnda nãintea a lui, <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />dzãsi: “Doamne, s-ai njilã ti hiljiu a meu cã easti epileptic, tradzi multu sh-di multi ori cadi tu foc icã tu apã. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Tora mini lu-dush la ucenitsilji a tãlji, ma elji nu puturã s-lu vindicã.” <verse eid="MAT 17:16" /><verse number="17" style="v" sid="MAT 17:17" />Sh-Isusul apãndisinda, dzãsi: “O farã fãrã pisti sh-anapudã! Pãnã cãndu va armãnã cu voi? Pãnã cãndu va vã aravdã?” Adutsets-lu aoa la mini! <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Sh-Isusul lu vãrghi demonul sh-elu ishi dit ficiorlu, sh-di atsea oarã ficiorlu s-vindicã. <verse eid="MAT 17:18" /><verse number="19" style="v" sid="MAT 17:19" />Atumtsea ucenitsilji lji s-apruchearã al Isus sh-dinãparti lu ntribarã: “Cãtse noi nu putum s-lu aĝunim?” <verse eid="MAT 17:19" /><verse number="20" style="v" sid="MAT 17:20" />Sh-Isusul lã dzãsi a lor: “Di pistipsirea atsea njica a voastrã. Cã dealihea mini ma vã dzãc: ma s-avets pisti cãt gãrnutslu di sinapi va lji dzãtsets a muntilui aishtui: ‘Mutã-ti di aoa, aclo,’ sh-elu va si s-mutã. Sh-tsiva nu va hibã niputut di voi. <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />[Sh-aestu soi di demon nu easi di cãt mash cu rugãciunji sh-cu pãreasinj.]”<verse eid="MAT 17:21" /></para>
  <para style="s1">Isusul Prividzu di a Doaua Oarã Moartea a Lui</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Cãndu elji s-afla tu Galilea, Isusul lã dzãsi: “Hiljiu a Omlui va s-prida tu mãnjili a oaminjlor, <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />sh-va lu vatãmã, sh-tu dzua a treia va s-nyeadzã.” Sh-elji s-nvirinarã multu.<verse eid="MAT 17:23" /></para>
  <para style="s1">Plãtirea a Taxiljei</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Cãndu agiumsirã tu Capernaum, taxidarlji di doauã dhrahmadzi a templui lji s-apruchearã a Petrului, sh-lji dzãsirã: “Nvitsãtorlu a vostru nu u plãteashti taxa a templui?” <verse eid="MAT 17:24" /><verse number="25" style="v" sid="MAT 17:25" />Sh-elu dzãsi: “Ie!” Sh-cãndu intrã n-casã, Isusul lu ashtiptã protlu sh-lji dzãsi: “Cum mindueshti tini Simon? Di la cai ljea taxili icã hãracili amirãrilji a loclui? Di la hiljilji a lor icã di la xenjilji?” <verse eid="MAT 17:25" /><verse number="26" style="v" sid="MAT 17:26" />Petrul lji dzãsi: “Di la xenjilji.” Isusul dzãsi: “Hiljilji atumtsea nu prindi s-plãtescu. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Cu tut atsea tsi s-nu lji cicãrdisim atselji, du-ti la amari, arucã greplu sh-ljea protlu pescu tsi va yinã nsus, ljea-lu, discljid-lji gura, sh-va s-aflji un statiru. Ljea-lu sh-plãtea taxa a lor ti tini sh-ti mini.”<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">Ma Marli tu Amirãriljea a Tserlui</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Tu atsea oarã ucenitsilji s-apruchearã a Isusului sh-lu ntribarã: “Cai easti cama marli tu amirãriljea a tserurilor?” <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />Sh-Isusul dupã tsi acljimã un cilimean njic ningã nãsu, lu bãgã namisa di nãshi, <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />sh-dzãsi: “Dealihea ma vã dzãc, macã nu vã alãxits sh-nu vã fãtsets ca cilimenjlji atselji njitslji, voi nu va intrats pute tu amirãriljea a tserurilor. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Cai va s-apleacã ca aestu cilimean njic, easti cama marli tu amirãriljea a tserlui. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />Sh-caitsido tsi lu aproachi un cilimean njic ca aestu tu numa a mea, mi aproachi mini. <verse eid="MAT 18:5" /><verse number="6" style="v" sid="MAT 18:6" />Ma atsel tsi va s-fac s-cadã tu amãrtii un di aeshti njitslji, tsi pistipsescu la mini, va hibã ma ghini trã nãsu s-lji spindzira di gushi unã cheatrã di la moarã, shi s-neacã tu apa a amariljei. <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />Cavai di dunjeaua tsi fatsi oaminjlji s-cadã tu amãrtii. Cã cicãrdisirili va yinã, ma cavai di atsel om, tsi trã sibepea a lui va yinã atseali cicãrdisiri! <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />Tora macã mãna a ta, icã ciciorlu a tãu ti cicãrdiseashti trã amãrtii, talji-l sh-arucã-l diparti di tini. Easti ma ghini s-intsri tu banã fãrã unã mãnã icã scljiopu, di cãt s-ai doauã mãnji sh-doauã cicioari shi s-ti arucã tu foclu di totãna. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Tutashã, macã ocljiu a tãu s-cicãrdiseashti trã amãrtii, scoati-l sh-arucã-l diparti di tini. Cã easti ma ghini s-intsri cu un ocljiu tu banã, di cãt s-ai doi oclji shi s-ti arucã tu Gehena a foclui.<verse eid="MAT 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />Afirits-vã s-nu dispretsuits vãrã di aeshti njitslji, cã mini ma vã dzãc cã anghilji a lor tu tseruri mutrescu totãna fatsa a Tatãlui a meu tsi easti tu tseruri. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />[Cã Hiljiu a Omlui vini ti ascãpari atsea tsi eara chirutã.]<note caller="+" style="f"><char style="fr" closed="false">18:11 </char><char style="ft" closed="false">atselu stih nu s-aflã tu alanti manuscrisi</char></note><verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />Cum minduits? Macã un om ari unã sutã di oi, sh-unã di nãsi cheari cala, nu va li alasã di noaudzãtsi nouãli tu munti, shi s-caftã atsea tsi chiru cala? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Sh-cãndu va u aflã, dealihea vã dzãc cã elu va s-hãrseascã ma multu ti aestã dicãt di noaudzãtsi nouãli, tsi nu avea chirutã cala. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Ashã easti vrearea a Tatãlui a vostru tsi easti tu tseruri, tsi vãrã di aeshti njitslji s-nu chearã.<verse eid="MAT 18:14" /></para>
  <para style="s1">Nvitsãtura di Ljirtari</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />Macã fratili a tãu amãrtiseashti contra tini, duti sh-vãrghea-lu cãndu hits singuri voi doilji, macã ti ascultã, tini lu amintash fratili a tãu, <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />macã nu ti ascultã, ljea cu tini ninga un icã doi oaminji, tsi cathi zbor si siguripseascã prit gura a doi icã a trei martiri.<note caller="-" style="x"><char style="xo" closed="false">18:16 </char><char style="xt" closed="false"><ref loc="DEU 19:15">Deut 19:15</ref>.</char></note> <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Macã deapoea arniseashti s-ti ascultã, dzã-lji a-bisearicãljei, sh-macã arniseashti s-ascultã sh-bisearica, prilucrats-lu ca pãngãn icã ca taxidar. <verse eid="MAT 18:17" /><verse number="18" style="v" sid="MAT 18:18" />Dealihea vã dzãc cã tuti lucrili tsi va avets ligat pristi loc, va hibã ligati sh-tu tser, sh-tsi avets dizligat pri loc, va hibã dizligati sh-tu tser. <verse eid="MAT 18:18" /><verse number="19" style="v" sid="MAT 18:19" />Ma vã dzãc tutashã, cã macã doi di voi s-uidisescu pri loc trã itsido tsi caftã, aestã va s-facã a lor di la Tatãl a meu tsi easti tu tseruri. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Cã, iutsido tsi doi icã trei suntu adunatsi tu numa a mea, mini escu aclo namisa di elji.”<verse eid="MAT 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Atumtsea Petrul s-apruche la Isusul sh-lji dzãsi: “Doamne, macã fratili a meu amãrtiseashti cãtrã mini, cãti ori prindi s-lu ljeartã? Pãnã di shapti ori?” <verse eid="MAT 18:21" /><verse number="22" style="v" sid="MAT 18:22" />Isusul lji-dzãsi: “Mini nu tsã dzãc pãnã di shapti ori, ma pãnã shaptidzãtsi di ori cãti shapti. <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />Trã atsea, amirãriljea a tserurilor undzeashti ca un amirã tsi vrea s-fãtsea luguriili cu huzmichearilji a lui. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Dupã tsi apãrnji s-fãtsea lugurii, lj-adusirã un tsi lj-mprumuta dzatsi njilji di talentsã. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Sh-metsi aestu nu avea tsi s-plãtea, nicuchirlu a lui ursi s-vindea elu cu muljearea a lui, cilimenjlji a lui, sh-tuti tsi avea, shi s-plãtea mprumutlu. <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />Atumtsea huzmichearlu lj-cãdzu pri dzinuclji sh-lji si rugã, dzãcãnda: ‘Doamne, s-ai arãvdari cu mini sh-mini va ts-li plãtescu tuti!’ <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Nicuchirlu lu njilui huzmichearlu a lui, lji lu ljirtã mprumutlu sh-lu-alãsã. <verse eid="MAT 18:27" /><verse number="28" style="v" sid="MAT 18:28" />Ma huzmichearlu atsel cum ishi, aflã un altu huzmichear tsi lji-avea ti dari unã sutã di denari. Dupã tsi lu acãtsã di grumadzu ma lu zgruma, dzãcãnda-lji: ‘Plãtea-nji mprumutlu tsi nj-ai.’ <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />Atumtsea huzmichearlu sotslu a lui, cãdzu pri dzinuclji sh-lji si rugã, dzãcãnda-lji: ‘Ai arãvdari cu mini, sh-va ts-li plãtescu tuti.’ <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />Ma elu nu vru, meti lu bãgã tu hapsi, pãnã cãndu elu s-plãtea mprumutlu. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Ma alantsã huzmicheari, cãndu lu vidzurã tsi s-featsi, si nvirinarã shi s-dusirã lji dzãsirã a nicuchirlui a lor tutã tsi fu faptã. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />Atumtsea nicuchirlu a lui lu acljimã sh-lji dzãsi: ‘Huzmichear arãu, mini ts-ljirtai tutã aestu mprumut, cã tini nji fãtseshi rigeai. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Nu lipsea sh-tini s-aveai njilã trã sotslu a tãu, ashã cum avui mini njilã trã tini?’ <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Sh-nicuchirlu a lui nãrãitã, lu prideadi atsel tu mãna a tiranjilor, pãnã cãndu s-plãtea tut mprumutlu. <verse eid="MAT 18:34" /><verse number="35" style="v" sid="MAT 18:35" />Ashã va s-facã cu voi sh-Tatãl a meu tserescu, macã cathi un di voi nu lu ljearti cu tutã inimã fratili a lui.”<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">Dispãrtsãri</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Dupã tsi Isusul li ascãpã ti spuneari aesti nvitsãturi, s-nchisi di Galilea, sh-vini tu loclu a Iudeiljei, napãrti di Iordan. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Multsãnji mãri l-urma sh-elu lji vindicã aclo. <verse eid="MAT 19:2" /><verse number="3" style="v" sid="MAT 19:3" />Atumtsea lji s-apruchearã niscãntsã Farisei s-lu cãrtea, sh-lji dzãsirã: “Easti tu lege tsi bãrbatlu s-u dispartã muljearea di itsido itii?” <verse eid="MAT 19:3" /><verse number="4" style="v" sid="MAT 19:4" />Sh-elu apãndisinda lã dzãsi a lor: “Nu avets cãntatã cã atsel cai lji adrã di tu apãrnjitã <char style="it">‘lji adrã mascru sh-theaminã.’</char><note caller="-" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="GEN 1:27">Ahr 1:27</ref>; <ref loc="GEN 5:2">5:2</ref>.</char></note> <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />Sh-Dumnidzãlu dzãsi: <char style="it">‘Trã aestã bãrbatul va s-alasã tatãl sh-muma a lui sh-va si s-mpriuneadzã cu muljearea a lui, sh-amindoilji va hibã un trup singur’</char>?<note caller="-" style="x"><char style="xo" closed="false">19:5 </char><char style="xt" closed="false"><ref loc="GEN 2:24">Ahr 2:24</ref>.</char></note> <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Sh-ashã elji nu suntu ma doi, ma un trup. Atsea tsi Dumnidzãlu ari mpriunatã, omlu s-nu u-dispartã.” <verse eid="MAT 19:6" /><verse number="7" style="v" sid="MAT 19:7" />Elji lji dsãsirã: “Atumtsea cãtse Moisiul ursi s-lji si da cartea di dispãrtsãri shi si-u alasã.”<note caller="-" style="x"><char style="xo" closed="false">19:7 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">Deut 24:1-4</ref>.</char></note> <verse eid="MAT 19:7" /><verse number="8" style="v" sid="MAT 19:8" />Elu lã dzãsi a-lor: “Moisiul vã deadi volje s-li alãsats muljerili a voastri trã itia a nchitririljei a ininjilor a voastri. Ma tu ahurhitã nu eara ashã. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Ma mini vã dzãc cã caitsido tsi u-alasã muljearea a lui, dicãt mash trã itia a putãnsiriljei, shi si nsoari cu unã altã, ncalcã curuna. [Sh-atsel tsi si nsoari cu muljeari alãsatã, ncalcã curuna.]”<note caller="+" style="f"><char style="fr" closed="false">19:8-9 </char><char style="ft" closed="false">nu sã aflã tu altã manuscrisi</char></note> <verse eid="MAT 19:9" /><verse number="10" style="v" sid="MAT 19:10" />Ucenitsilji a lui lji dzãsirã: “Macã cunditsili a bãrbatlui cãtrã muljearea suntu ahtãri, ma ghini si nu si nsoarã dip.” <verse eid="MAT 19:10" /><verse number="11" style="v" sid="MAT 19:11" />Ma elu lã dzãsi a lor: “Nu tuts lã aduchescu aesti zboari, ma singur atselji a cui lã easti datã. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Suntu eunuchi<note caller="+" style="f"><char style="fr" closed="false">19:12 </char><char style="ft" closed="false">eunuchi suntu atselji oaminji tsi nu poatã si nsoarã shi nu poatã s-facã cilimenji.</char></note>, cai suntu amintats ashã dit pãnticlu a mumãljei, shi suntu eunuchi cai suntu faptã di la oaminji, shi suntu eunuchi cai au apofãsitã singur s-facã eunuchi trã amirãriljea a tserurilor. Atsel tsi poati s-aducheascã, s-aducheascã.”<verse eid="MAT 19:12" /></para>
  <para style="s1">Isusul Ghinicuvãteadzi Cilimenjlji</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Atumtsea adusirã cilimenji njitsi la Isusul tra s-bãga mãnjili pri nãshi, shi s-ruga, ma ucenitsilji a lui lji vãrghirã. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Atumtsea Isusul dzãsi: “Alãsats cilimenjlji atselji njitslji s-yinã la mini sh-nu li nchidicats, cã a lor easti amirãriljea a tserurilor.” <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Atumtsea elu bãgã mãnjili pri elji, sh-deapoea s-nchisi di aclo.<verse eid="MAT 19:15" /></para>
  <para style="s1">Avutlu Tinir</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Sh-ia, s-apruche un la Isusul sh-lu ntribã: “Nvitsãtore, tsi buneatsã prindi s-fac tsi s-amintã bana eternã?” <verse eid="MAT 19:16" /><verse number="17" style="v" sid="MAT 19:17" />Sh-elu dzãsi: “Cãtse mi ntreghi tsi easti bun? Singur un easti bun. Macã vrei s-intsri tu banã, veaglji dimãndãrili.” <verse eid="MAT 19:17" /><verse number="18" style="v" sid="MAT 19:18" />Elu ntribã: “Cai?” Atumtsea, Isusul lj-apãndisi: “<char style="it">Nu vatãmã, nu ncalcã curuna, nu furã, nu dã mãrtirii arãdioasã,</char> <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" /><char style="it">tinjisea tatãl a tãu sh-muma a ta, shi s-vrei aproapilu a tãu ca cum ti vrei tini.</char>” <verse eid="MAT 19:19" /><verse number="20" style="v" sid="MAT 19:20" />Tinirlu lj-dzãsi: “Tuti aesti lucri mini li am vigljeatã. Tsi nji lipseashti altã?” <verse eid="MAT 19:20" /><verse number="21" style="v" sid="MAT 19:21" />Isusul lj-dzãsi: “Macã vrei s-hii perfectu, duti sh-vindi tsi ai, sh-dã-li a niavutslor, shi tini va s-ai un ayishteari tu tser. Deapoea haidi sh-urmeadzã-mi.” <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" />Ma tinirlu cãndu li avdzã aesti zboari, fudzi nvirinat, cã avea multã aveari. <verse eid="MAT 19:22" /><verse number="23" style="v" sid="MAT 19:23" />Atumtsea, Isusul lã dzãsi a ucenitsilor a lui: “Dealihea vã dzãc cã un avut cu zori va s-intrã tu amirãriljea a tserurilor. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Sh-nãpoi ma va dzãc: Easti ma lishoarã s-treacã cãmila tu guva a aclui, dicãt avutlu s-intrã tu amirãriljea a Dumnidzãlui.” <verse eid="MAT 19:24" /><verse number="25" style="v" sid="MAT 19:25" />Cãndu li avdzãrã aesti zboari, ucenitsilji a lui s-ciudisirã multu shi ntribarã: “Atumtsea, cai va s-ascapã vahi?” <verse eid="MAT 19:25" /><verse number="26" style="v" sid="MAT 19:26" />Sh-Isusul mutrinda cãtrã nãshi dzãsi: “Trã oaminjlji aestã easti nipututã, ma trã Dumnidzãlu itsido easti putut.” <verse eid="MAT 19:26" /><verse number="27" style="v" sid="MAT 19:27" />Atumtsea Petrul lj-apãndisi: “Ia, noi li alãsãm tuti sh-vinim dupã tini, ma tsi va s-amintãm noi?” <verse eid="MAT 19:27" /><verse number="28" style="v" sid="MAT 19:28" />Sh-Isusul lã-dzãsi a lor: “Dealihea ma vã dzãc, tu adãrãtura atsea noaua, cãndu Hiljiu a Omlui va sheadã pri thronlu a mãririljei a lui, sh-voi tsi mi avets urmat, va shidets pi doisprãdzatsi thronuri ti guidicari di doisprãdzatsi fãrili a Israelui. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Sh-caitsido tsi ari alãsat trã numa a mea cãsi, fratsi, surãri, tatã, mumã, [muljeari]<note caller="+" style="f"><char style="fr" closed="false">19:29 </char><char style="ft" closed="false">nu s-aflã tu cathi manuscrisi.</char></note>, cilimenji, agri, va ljea unã sutã di ori ma multu, sh-va aibã banã eternã. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Ma multsã di protslji va hibã tu coadã, sh-atselji di tu coadã va hibã protslji.”<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">Parabola cu Lucrutorlji</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />“Amirãriljea a tserurilor undzeashti cu un nicuchir di casã tsi ishi curund dimineatsa s-puituea lucrutori ti ayinjea a lui. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Dupã tsi s-ndreapsi tu pãzari cu lucrutorlji cãti un denar n-dzuã, lji pitricu la ayinjea a lui. <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />Apoea ishi anvãrliga di oara noauã dimineatsa, sh-vidzu altsã tsi stãtea tu pãzari fãrã lucru. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Sh-lã dzãsi a lor: ‘Dutsets-vã sh-voi la ayinjea a mea sh-mini va vã dau cãtã easti dhichea.’ <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Sh-elji s-dusirã. Elu ishi anvãrliga di njeadzãdzuã sh-pi trei ti-mirindi, featsi unã soi. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Cãndu ishi nãpoi cãtrã oara tsintsi ti-mirindi, aflã altsã tsi stãtea ni fãrã lucru, sh-lji ntribã: ‘Cãtse shidets aoa tutã dzua ni faptã tsiva?’ <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />Elji lji dzãsirã: ‘Cã vãrã nu nã puitui.’ Sh-elu lã dzãsi a lor: ‘Dutsets-vã shi voi la ayinji.’ <verse eid="MAT 20:7" /><verse number="8" style="v" sid="MAT 20:8" />Cãndu vini seara, nicuchirlu a ayinjiljei, lji dzãsi a administratorlui a lui: ‘Acljeamã lucrutorlji shi fã plãtirea a lor, apãrnjinda di la atselji di ma nãpoi sh-pãnã la atselji di prota.’ <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />Sh-cãndu vinirã atselji di la oara tsintsi, loarã cãti un denar cathiunu. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Cãndu vinirã protslji, minduirã cã va loa ma multu, ma sh-atselji loarã cãti un denar cathiunu. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Luãnda, murmurea contra a nicuchirlui a casiljei, <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />dzãcãnda: ‘Aeshti di ma nãpoi lucrarã mash unã oarã sh-tini lji plãtish ca noi, tsi trapsim greulu sh-cãloarea a dzuãljei.’ <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />Ma elu lj-apãndisi a unui di nãshi: ‘Oaspe, mini nu ma ts-fac nindriptati. Noi nu featsim pãzari ti un denar tu dzuã? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Ljea atsea tsi easti a ta sh-imnã. Mini voi s-lji dau aishtui di ma nãpoi cãt a tsãia. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Nu am ndriptati mini s-facã tsi voi cu atsea a mea? Cãtse ti fats ocljiu ni fãnãtit, cã mini escu giumertu?’ <verse eid="MAT 20:15" /><verse number="16" style="v" sid="MAT 20:16" />Ashã atselji di ma nãpoi va hibã protslji sh-atselji protslji va hibã atselji di ma nãpoi.”<verse eid="MAT 20:16" /></para>
  <para style="s1">Isusul Prividzu di a Treia Oarã Moartea a Lui</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Deapoea cãndu Isusul ma s-alina cãtrã Ierusalem, lji lo dinãparti di doisprãdzatsi ucenitsilji sh-pri cali lã dzãsi a lor: <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“Ia noi nã alinãm tu Ierusalem, sh-Hiljiu a Omlui va s-prida la mãrlji a preftsãlor sh-a scribilor. Elji va lu condamnã cu moarti, <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />va lu prida tu mãnjili a pãngãnjilor tsi s-lu pizueascã, va lu zãpãleascã shi va lu crutsiseascã. Ma elu a treia dzuã va s-nyeadzã dit mortsã.”<verse eid="MAT 20:19" /></para>
  <para style="s1">Ntribarea a Hiljilor al Zebedeu</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Atumtsea, muma a hiljilor a Zebedeului s-apruche la Isus deadun cu hiljilji a ljei, cãdzu pri dintsã sh-lji-cãftã tsiva. <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />Sh-elu lj-dzãsi: “Tsi vrei?” Ea apãndisi: “Ursea tsi aeshti doi hiljilji a melji s-apunã un di nandreapta sh-altu di nastãnga tu amirãriljea a ta.” <verse eid="MAT 20:21" /><verse number="22" style="v" sid="MAT 20:22" />Sh-Isusul apãndisi: “Voi nu shtits tsi cãftats. Putets s-bets voi cupa tsi mini va beu? [Shi s-vã pãtidzats cu pitedzlu cu cai mini va mi pitedz?]<note caller="+" style="f"><char style="fr" closed="false">20:22 </char><char style="ft" closed="false">aesti zboari nu s-aflã tu tuti manuscrisili.</char></note>” Elji dzãsirã: “Ie, putem.” <verse eid="MAT 20:22" /><verse number="23" style="v" sid="MAT 20:23" />Elu lã dzãsi a lor: “Voi dealihea va s-bets cupa a mea. [Shi va s-vã pãtidzats cu pitedzlu cu cai mini va mi pitedz.]<note caller="+" style="f"><char style="fr" closed="false">20:23 </char><char style="ft" closed="false">aesti zboari nu s-aflã tu tuti manuscrisili. </char></note> Ma nu easti tu mãna a mea tra s-shidets di nandreapta a mea icã di nastãnga a mea, cã atseali locuri suntu trã atselji tsi s-etimãsirã di la Tatãl a meu.” <verse eid="MAT 20:23" /><verse number="24" style="v" sid="MAT 20:24" />Sh-cãndu avdzãrã aesti zboari di dzatsi alantsã s-nãrãirã cu doilji frats. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Isusul lji acljimã ningã nãsu sh-lã dzãsi: “Voi lu shtits cã protslji a natsiunilor lji domneascã atselji sh-mãrlji au puteari pri nãshi, <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />ma namisa di voi nu va hibã ashã! Cathiun di voi tsi va s-hibã mari, s-hibã huzmichearlu a vostru, <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />shi caitsido di voi tsi va s-hibã protlu, prindi s-hibã sclavlu a vostru, <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />cã sh-Hiljiu a Omlui nu vini tra s-lji huzmitipseascã, ma huzmitipseascã sh-di dari bana a lui ca arãscumpãrari trã multsã.”<verse eid="MAT 20:28" /></para>
  <para style="s1">Doi Orghi di Ierico</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Cãndu elji ma ishea di Ierico, un multsãmi mari ma njidzea dupã Isusul. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Sh-ia, doi orghi eara apunats ningã cali. Cãndu avdzãrã cã ma tritsea Isusul, apãrnjirã s-aurlã: “Njiluia-nã noi, Doamne, Hiljiu al David!” <verse eid="MAT 20:30" /><verse number="31" style="v" sid="MAT 20:31" />Multsãmea lji vãrghea tra s-pãpsea, ma elji aurla ma multu: “Njiluia-nã noi, Doamne, Hiljiu al David!” <verse eid="MAT 20:31" /><verse number="32" style="v" sid="MAT 20:32" />Atumtsea Isusul chindrui lji acljimã sh-lã ntribã: “Tsi vrets s-fac trã voi?” <verse eid="MAT 20:32" /><verse number="33" style="v" sid="MAT 20:33" />Elji dzãsirã: “Doamne, s-nã si discljidã ocljilji.” <verse eid="MAT 20:33" /><verse number="34" style="v" sid="MAT 20:34" />Sh-Isusul aspusi njilã trã nãshi, bãgã mãna pri ocljilji a lor, sh-tu atsea oarã a lor lã vini videarea a ocljilor sh-elji lu urmarã.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">Intrarea al Isus tu Ierusalem</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Cãndu lji s-apruchearã a Ierusalemlui sh-agiumsirã tu Betafaghe, aproapi di Muntili a Masnjilor, Isusul pitricu doi ucenitsi, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />dzãcãnda a lor: “Imnats tu hoara tsi easti nãintea a voastrã, sh-atsia va aflats unã gumarã ligatã sh-gumãriclu cu nãsã. Dizligats-lji sh-adutsets-lji la mini! <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Sh-macã vãrã vã dsãtsi tsiva, dzãtsets-lji cã, ‘Domnul ari ananghi trã nãshi,’ sh-atsel va li sãlãgheascã trãoarã.” <verse eid="MAT 21:3" /><verse number="4" style="v" sid="MAT 21:4" />Tora aestã s-featsi tra si mplineascã tsi eara dzãsã di la prufitlu:<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />“Dzãtsets-lji a hiljiljei a Sionlui:</para>
  <para style="q2" vid="MAT 21:5">‘Ia, ma ts-yini amirãlu a tãu,</para>
  <para style="q1" vid="MAT 21:5">inimã-moali, ncãlicat pri unã gumarã,</para>
  <para style="q2" vid="MAT 21:5">njicã ca un gumãric, fãtat di un pravdã ti ngãrcari.’”<note caller="-" style="x"><char style="xo" closed="false">21:5 </char><char style="xt" closed="false"><ref loc="ZEC 9:9">Zac 9:9</ref>.</char></note><verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Ucenitsilji s-dusirã sh-featsirã ashã cum lji avea ursit Isusul. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Adusirã gumara sh-gumãriclu, ashtirnarã pri nãsi mantelili a lor sh-Isusul s-alinã. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Sh-unã multsãmi multu mari ashtirna mantelili a lor pri cali, iarã altsãlji frãndzea dedzi di ponji sh-li ashtirna pri cali. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Multsãnjili tsi yinea nãinti sh-atseali tsi lu urma, aurla, dzãcãnda:</para>
  <para style="q1" vid="MAT 21:9">“Hosana, a Hiljilui al David!</para>
  <para style="q2" vid="MAT 21:9">
    <char style="it">Ghinicuvintat s-hibã atsel tsi yini tu numa a Domnului!</char></para>
  <para style="q2" vid="MAT 21:9">Hosana tu locurili multi analti!”<note caller="-" style="x"><char style="xo" closed="false">21:9 </char><char style="xt" closed="false"><ref loc="PSA 118:25-26">Ps 118:25-26</ref>.</char></note><verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Cãndu intrã Isusul tu Ierusalem, tutã cãsãbãlu si sculã pri cicioari, sh-dzãsi: “Cai easti aestu?” <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />Shi multsãmea apãndisi: “Aestu easti Isusul, prufitlu di Nazaretul a Galileiljei.”<verse eid="MAT 21:11" /></para>
  <para style="s1">Isus Curã Templu</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Deapoea Isusul intrã tu templu sh-lji aĝuni tuts atselji tsi vindea sh-acumpãra tu templu sh-arãsturnã measili a alãxitorilor di pãradz shi scamnili a vinditorilor a purunghilor. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Sh-lã dzãsi a lor: “Easti scriatã:</para>
  <para style="q1" vid="MAT 21:13">‘Casa a mea va s-acljemã casã di rugãciuni,’<note caller="-" style="x"><char style="xo" closed="false">21:13 </char><char style="xt" closed="false"><ref loc="ISA 56:7">Isa 56:7</ref>; <ref loc="JER 7:11">Ier 7:11</ref>.</char></note></para>
  <para style="q2" vid="MAT 21:13">ma voi u avets turnatã ca unã pishtireauã di furii.”<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Atumtsea vinirã la nãsu tu templu orghi shi shcljiochi sh-Isusul lji vindicã. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Ma mãrlji a preftsãlor shi scriblji s-nãrãirã cãndu vidzurã thavmatili tsi elu avea faptã shi cilimenjlji tsi dzãtsea cu harauã tu templu: “Hosana a Hiljilui al David!” <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />Sh-lji dzãsirã: “Ma avdzã tini tsi dzãc aeshti?” Isusul lã dzãsi a lor: “Ie! Nu avets cãntatã pute:</para>
  <para style="q1" vid="MAT 21:16">‘Dit gura a njitsilor sh-a bebilor tini ai adratã alãvdari’<note caller="-" style="x"><char style="xo" closed="false">21:16 </char><char style="xt" closed="false"><ref loc="PSA 8:2">Ps 8:2</ref>.</char></note>?”<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />Sh-dupã tsi lji alãsã atselji, ishi dit cãsãbã cãtrã Betania, sh-aclo tricu noaptea.<verse eid="MAT 21:17" /></para>
  <para style="s">Hiclu atsel Uscat</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Dimineatsa curund, cãndu ma s-turna tu cãsãbã, lu lo foama. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Pri cali vidzu un hic sh-lji si-apruche, ma nu aflã tsiva, dicãt mash frãndzãli sh-dzãsi: “S-nu s-leagã frut pute la tini di totãna!” Sh-hiclu s-uscã trãoarã. <verse eid="MAT 21:19" /><verse number="20" style="v" sid="MAT 21:20" />Sh-cãndu vidzurã aestã ucenitsilji s-ciudisirã sh-dzãsirã: “Cum s-uscã hiclu trãoarã!” <verse eid="MAT 21:20" /><verse number="21" style="v" sid="MAT 21:21" />Sh-Isusul apãndisi: “Dealihea vã dzãc, ma s-avets pisti shi s-nu vã ndoits, va s-fãtsets nu mash atsea tsi mini lji-feciu a hiclui, ma sh-canda s-lji dzãtsets aishtui munti: ‘Scoal-ti di aclo sh-arucã-ti tu amari’, aestã va si s-facã. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Sh-itsido tsi s-cãftats tu rugãciuni, pistipsinda, va u-loats.”<verse eid="MAT 21:22" /></para>
  <para style="s">Autoritatea al Isus</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Cãndu intrã tu templu, mãrlji a preftsãlor sh-aushlji a popului lji s-apruchearã cãndu ma lji nvitsa, sh-lu ntribarã: “Cu tsi autoritati li fatsi tini aesti lucri? Sh-cai ts-ari datã aestã autoritati?” <verse eid="MAT 21:23" /><verse number="24" style="v" sid="MAT 21:24" />Sh-Isusul apãndisi: “Sh-mini va vã fac unã ntribari, sh-macã voi va nj-apãndisits, mini tutashã va vã dzãc, cã cu tsi autoritati li fac tuti aesti lucri. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Pitedzlu a Ioanului di iu vini? Dit tser icã di la oaminjlji?” Sh-elji minduea namisa di nãshi, dzãcãnda: “Ma s-lji dzãtsem dit tser, elu va nã dzãcã: ‘Cãtse atumtsea nu lji pistipsit?’ <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Macã va lj-dzãtsem, ‘di la oaminjlji,’ avem fricã di multsãmea, cã tuts lu acljeam Ioanul prufit.” <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />Sh-lji-apãndisirã a Isusului, dzãcãnda: “Nu shtim.” Atumtsea elu lã dzãsi a lor: “Nitsi mini nu va vã dzãc cã cu tsi autoritati li fac aesti lucri.”<verse eid="MAT 21:27" /></para>
  <para style="s">Parabola a Doi Hilji</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />“Tsi minduits? Un om avea doi hilji sh-cum s-dusi cãtrã protlu, lji dzãsi: ‘Hilje, duti azã s-lucredzi tu ayinji!’ <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />Elu apãndisi: ‘Nu voi,’ ma, ma nãpoi s-mitãnjusi shi s-dusi. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />Deapoea tatãl s-turnã cãtrã a doilu shi lj-dzãsi sh-a lui unã soi. Sh-elu lj-apãndisi sh-dzãsi: ‘Ie, doamne,’ ma nu s-dusi. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />Cai di dolji lu featsi vrearea a tatãlui?” Elji lj-dzãsirã: “Protlu.” Isusul lã dzãsi a lor: “Dealihea vã dzãc cã taxidarlji sh-putanili va intrã nãinti di voi tu amirãriljea a tserurilor.” <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Cã Ioanul vini la voi trã spuneari calea a ndriptatiljei, sh-voi nu lu pistipsit, iarã taxidarlji sh-putanili l-pistipsirã. Cu tut atsea, voi nitsi dupã tsi li avets vidzutã aesti lucri, nu vã mitunjãsit sh-nu pistipsit.<verse eid="MAT 21:32" /></para>
  <para style="s1">Parabola a Ayinjearilor Arãi</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />“Ascultats unã altã parabolã. Eara un nicuchir di unã casã, tsi siminã un ayinji, sh-u anvãrligã cu gardu shi sãpã un loc di stultsinari aua, sh-adrã un pirĝu di vigljeari. Ayinjea u-pistipsi la niscãntsã ayinjeari sh-fudzi diparti. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Cãndu vini chirolu ti adunari, elu pitricu huzmichearlji a lui la ayinjearlji ti loari partea a lui di fruti. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Ma ayinjearlji lji acãtsarã huzmichearilji a lui, unu lu bãturã, alantu lu vãtãmarã, sh-a treilu lu vãtãmarã cu chetri. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Nãpoi pitricu altsã huzmicheari, ma multsã di protslji, sh-ayinjearlji featsirã cu nãshi un soi. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Tu soni, elu pitricu hiljiu a lui, dzãcãnda: ‘Di hiljiu a meu va aibã rispect.’ <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />Ma ayinjearlji cãndu lu vidzurã hilji-su, dzãsirã un cu-alantu: ‘Aestu easti mushtinitorlu. Haidets, s-lu vãtãmãm shi s-lom mushtinirea a lui.’ <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Sh-lu acãtsarã, lu arcarã nafoarã di ayinji sh-lu vãtãmarã. <verse eid="MAT 21:39" /><verse number="40" style="v" sid="MAT 21:40" />Tora, cãndu va yinã nicuchirlu a ayinjiljei, tsi va-l fac a ayinjearilor aishtor?” <verse eid="MAT 21:40" /><verse number="41" style="v" sid="MAT 21:41" />Elji dzãsirã: “Elu va lji vatãmã di tuts arãlji, sh-va lã-u da ayinjea la altsã ayinjeari, tsi va s-da frutili tu chirolu tsi prindi.” <verse eid="MAT 21:41" /><verse number="42" style="v" sid="MAT 21:42" />Isusul lã dzãsi a lor: “Nu avets cãntatã pute la Scriturili:</para>
  <para style="q1" vid="MAT 21:42">
    <char style="it">‘Cheatra tsi masturlji u-scoasirã ca nilipsitã,</char></para>
  <para style="q2" vid="MAT 21:42">
    <char style="it">s-featsi cheatra a chioshlui.</char></para>
  <para style="q1" vid="MAT 21:42">
    <char style="it">Aestu easti ciudia tsi Domnul featsi</char></para>
  <para style="q2" vid="MAT 21:42">
    <char style="it">sh-easti thãvmãtisit tu ocljilji a noshtri’</char>?<note caller="-" style="x"><char style="xo" closed="false">21:42 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">Ps 118:22-23</ref>.</char></note><verse eid="MAT 21:42" /></para>
  <para style="m">
    <verse number="43" style="v" sid="MAT 21:43" />Trã atsea mini ma vã dzãc a voauã, cã va vã si ljea amirãriljea a Dumnidzãlui, sh-va lji si da a unui popul tsi va da fruti. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Sh-atsel tsi va s-cadã pri aestã cheatrã, va si s-frãngã, sh-atsel pri cai va cadã cheatra va si sãrãmã.” <verse eid="MAT 21:44" /><verse number="45" style="v" sid="MAT 21:45" />Sh-mãrlji a preftsãlor sh-Fariseilji cãndu li avdzãrã parabolili a lui, aduchirã cã ma grea trã nãshi. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Sh-cãfta s-lu acãtsa, ma avea fricã di populu, cã elji lu lugursea prufit.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">Parabola a Numtãljei</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Sh-Isusul ahurhi s-lã zbura nãpoi a lor cu parabolã, dzãcãndã: <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />“Amirãriljea a tserurilor lj-undzeashti a unui amirã, cai etimãsi numta a hiljilui. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Sh-pitricu huzmichearlji a lui s-lã greascã a acljimatslor tu numtã, ma elji nu vrurã s-yinã. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />Pitricu altsã huzmicheari dzãcãnda: ‘Dzãtsets-lã a acljimatslor: Ia, mini am ndreaptã uspetsea, yitsãlji sh-nãmaljili grasi suntu tãljati, sh-itsido easti etimu. Haidets pi numtã.’ <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />Ma elji nu vrurã s-avdã shi s-dusirã, un tu agrul a lui sh-alantu tu lucrili a lui. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Sh-alantsãlji dupã tsi acãtsarã huzmichearilji a lui, lji ngiurarã sh-lji vãtãmarã. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Atumtsea amirãlu cãndu avdzã aestã, s-nãrãi sh-pitricu armata a lui lji afãnisi atselji vãtãmãtori sh-arsi cãsãbãlu a lor. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Atumtsea lã dzãsi a huzmichearilor a lui: ‘Numta easti etimã, ma acljimatsilji nu furã axii. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Dutsets-vã la crutsisirea a cãljurilor sh-acljimats pi numtã caitsido tsi s-aflats.’ <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Sh-huzmichearlji ishir pri cãljuri, adunarã tuts atselji tsi aflarã, arãi sh-bunji, sh-loclu a numtãljei s-umplu cu acljimats. <verse eid="MAT 22:10" /><verse number="11" style="v" sid="MAT 22:11" />Atumtsea amirãlu intrã s-veadã acljimatsilji, sh-vidzu aclo un om tsi nu avea nviscut stranjili di numtã. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Amirãlu lj-dzãsi: ‘Oaspe cum intrash aoa ni avut stranji di numtã?’ Sh-elu ncljisi gura. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />Atumtsea amirãlu lã dzãsi a huzmichearilor: ‘Ligats-lu di mãnji sh-di cicioari sh-arucats-lu tu scutidlu di nafoarã. Aclo va hibã plãngul sh-cãrtsãnirea a dintsãlor.’” <verse eid="MAT 22:13" /><verse number="14" style="v" sid="MAT 22:14" />Isusul ncljisi zborlu a lui, dzãcãnda: “Multsã suntu acljimats, ma putsãnji suntu aleptsã.”<verse eid="MAT 22:14" /></para>
  <para style="s1">Hala a Taxilor</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Atumtsea Fariseilji s-dipãrtarã shi s-minduirã, cum s-lu acãtsa tu cãbati. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Sh-pitricurã ucenitsilji a lor deadun cu Herodianjlji s-lji dzãtsea: “Nvitsãtore, noi shtim cã tini eshti alihios, sh-tsi nvetsi calea a Dumnidzãlui dupã alihea, sh-nu ti mealã di vãrã, cã tini nu vedz pãrearea di nafoarã a oaminjlor. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Dzã-nã tora, cum mindueshti? Easti ndreptu si s-plãteascã taxa a Cesarului, icã nu?” <verse eid="MAT 22:17" /><verse number="18" style="v" sid="MAT 22:18" />Ma Isusul cunuscãnda arãutatea a lor, lã dzãsi: “Cãtse mi cãrtits, ipucrits? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Spunets-nji denarlu a taxãljei.” Atumtsea elji lji aspusirã un denar. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />Sh-elu lã dzãsi a lor: “A cui easti aestã fatsã sh-aestã scriturã?” <verse eid="MAT 22:20" /><verse number="21" style="v" sid="MAT 22:21" />Elji lj-dzãsirã: “A Cesarului.” Atumtsea elu lã dzãsi a lor: “Dats-lã a Cesarului tsi easti a Cesarului sh-a Dumnidzãlui tsi easti a Dumnidzãlui.” <verse eid="MAT 22:21" /><verse number="22" style="v" sid="MAT 22:22" />Sh-elji cãndu avdzãrã aestã, s-ciudisirã, lu alãsarã sh-fudzirã.<verse eid="MAT 22:22" /></para>
  <para style="s1">Saduceilji sh-Nyearea</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Tu atsea dzuã vinirã la nãsu Saduceilji, tsi nu pistipsescu tu nyeari, sh-lu ntribarã, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />dzãcãnda: “Nvitsãtore, Moisiul ari dzãsã: Macã vãrã moari sh-nu alasã cilimenji, fratili a lui si nsoarã cu muljearea a lui, tra s-lji alasã mushtinitori a fratilui a lui. <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Tora trã noi eara shapti frats, protlu si-nsurã sh-muri. Nu alãsã mushtinitori, sh-u alãsã muljeari-sa a fratilui a lui. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Ashã sh-a doilu, sh-a treilu, pãnã la a shaptilu. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Tu soni, muri sh-muljearea. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Tu nyeari, a cui di aeshti shapti va hibã muljearea? Cã tuts u avurã muljeari.” <verse eid="MAT 22:28" /><verse number="29" style="v" sid="MAT 22:29" />Ma Isusul apãndisi: “Hits tu cãbati cã nu u cunushtets nitsi Scritura, nitsi putearea a Dumnidzãlui. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Tu nyeari oaminjlji nitsi va si-nsoarã sh-nitsi va si s-mãritã, ma elji va hibã ca anghilji tu tseruri. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Tora, trã nyearea a mortsãlor, nu avets cãntatã tsi vã easti dzãsã di la Dumnidzãlu: <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />‘Mini escu Dumnidzãlu al Abraham, Dumnidzãlu al Isac sh-al Iacov’? Dumnidzãlu nu easti Dumnidzãlu a mortsãlor ma a yiilor.”<note caller="-" style="x"><char style="xo" closed="false">22:32 </char><char style="xt" closed="false"><ref loc="EXO 3:6">Ex 3:6</ref>.</char></note> <verse eid="MAT 22:32" /><verse number="33" style="v" sid="MAT 22:33" />Sh-multsãmea, cãndu li avdza aesti s-ciudisea di nvitsãtura a lui.<verse eid="MAT 22:33" /></para>
  <para style="s1">Ordinlu atsel Marili</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Tora Fariseilji cãndu avdzãrã cã Isusul avea astupatã gura a Sadutseilor, s-adunarã deadun. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Sh-un di atselji, nvitsãtor di lege, ntribãnda, l-bãgã tu provã: <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“Nvitsãtore, cai easti ordinlu ma mari tu Lege?” <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />Sh-Isusul dzãsi: “‘S-vrei Domnul, Dumnidzãlu a tãu, cu tutã inima a ta, cu tutã suflitlu a tãu, sh-cu tutã mintea a ta.’<note caller="-" style="x"><char style="xo" closed="false">22:37 </char><char style="xt" closed="false"><ref loc="DEU 6:5">Deut 6:5</ref>.</char></note> <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Aestã easti protlu sh-ma marli ordin. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Sh-a doilu unã soi ca aestu easti: ‘S-vrei aproapilu a tãu un soi ca cum ti vrei tini.’<note caller="-" style="x"><char style="xo" closed="false">22:39 </char><char style="xt" closed="false"><ref loc="LEV 19:18">Lev 19:18</ref>.</char></note> <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Di aesti doi ordini si-spindzurã Legea sh-Prufitsilji.”<verse eid="MAT 22:40" /></para>
  <para style="s1">Hristolu, Hiljiu al David sh-Domnul a Lui</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Tora cãndu s-adunarã Fariseilji, Isusul lji ntribã: <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />“Cum minduits voi trã Hristolu? Hiljiu a cui easti?” Elji dzãsirã: “Al David.” <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />Elu lã dzãsi a lor: “Ma cum, atumtsea Davidul, tu Duh, lu acljeamã ‘Domnu’? Davidul dzãsi:<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />‘Domnul lj-ari dzãsã a Domnului a meu:</para>
  <para style="q2" vid="MAT 22:44">Apun-ti tu nandreapta a mea pãnã</para>
  <para style="q1" vid="MAT 22:44">cãndu mini s-bagã dushmanjlji a tãlji</para>
  <para style="q2" vid="MAT 22:44">ca scamnã sum cicioarili a tali.’<note caller="-" style="x"><char style="xo" closed="false">22:44 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Ps 110:1</ref>.</char></note><verse eid="MAT 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 22:45" />Macã Davidul lu acljeami ‘Domnu’, cum poati s-hibã hiljiu a lui?” <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />Sh-vãrã nu putu s-lji apãndisea, sh-di atsea dzuã vãrã nu cutidza s-lu ntriba ma.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">Isusul Vãrgheashti Scriblji sh-Fariseilji</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Atumtsea Isusul lã grãi a multsãnjilor sh-a ucenitsilor a lui, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />shi dzãsi: “Scriblji sh-Fariseilji shidzurã pri scamnul al Moisiu. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Trã atsea, vigljeats shi fãtsets itsi vã dzãc, ma nu fãtsets cum fac elji, cã dzãc, ma nu fac. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Elji leagã sartsinji greali tsi s-poarta cu zori sh-li bagã pri pãltãrili a oaminjlor, ma elji nu vor s-li minã nitsi cu dzeaditlu a lor. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />Ma tuti faptili a lor li facã tra si s-veadã di oaminjlji, li lãrdzescu filacterili a lor sh-li lundzescu hirili a stranjilor a lor. <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Arsescu protili locuri la uspetsi sh-protili locuri tu sinagodzi, <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />sh-ncljinãciunjili tu pãdzi, shi s-acljeamã ‘Rabbi’ di oaminjlji. <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />Ma voi, nu alãsats s-vã acljeamã ‘Rabbi’, cã mash un easti Nvitsãtorlu a vostru, sh-voi tuts hits frats. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Sh-pristi loc nu acljimats vãrã ‘tatãl’ a vostru, cã mash un easti Tatãlu a vostru. Elu easti tu tseruri. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Nu alãsats s-vã acljeamã nvitsãtor, cã un easti nvitsãtorlu a vostru: Hristolu. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Ma marili di voi prindi s-hibã huzmichearlu a vostru. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Cã cai va s-analtsã, va si apleacã, sh-cai va s-apleacã, va si analtsã.<verse eid="MAT 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />Ma cavai di voi Scribi sh-Farisei ipucrits! Cã ncljidets amirãriljea a tserurilor nãintea a oaminjlor. Cã nitsi voi nu intrats, nitsi nu alãsats atselji tsi vor s-intrã.<verse eid="MAT 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 23:14" />[Cavai di voi Scribi sh-Farisei ipucrits! Cã mãcats tu cãsili a veduvilor, shi trã ocljilji a lumiljei fãtsets rugãciunji lundzi, trã atsea voi va s-hits giudicats.]<note caller="+" style="f"><char style="fr" closed="false">23:14 </char><char style="ft" closed="false">aestu stih nu s-aflã tu alanti manuscrisi</char></note><verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />Cavai di voi Scribi sh-Farisei ipucrits! Cã tritsets amarea sh-loclu ti fãtseari prozelits, sh-cãndu vãrã, s-fatsi ahtar lu fãtsets hiljiu a Gehenãljei, sh-di doauã ori ma arãu di voi.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />Cavai di voi, cãlãuzi orghi tsi dzãtsets: ‘Macã vãrã si spigiurã pri templu nu easti tsiva, macã si spigiurã pri furia a templui prindi s-tsãnã spigiurarea.’ <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Glari sh-orghi! Cai easti ma mari: furia ama templu tsi sãmtsashti furia? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Voi ninga dzãtsets: ‘Ma atsel tsi va si spigiurã pri altar nu easti tsiva, macã si spigiurã pri doara tsi easti pri nãsu, prindi s-tsãnã spigiurarea.’ <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Orghi! Cai easti ma mari: doara ama altarlu tsi sãmtsashti doara? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Ma atsel tsi va si spigiurã pri altar, si spigiurã pri nãsu sh-pri tuti lucrili tsi suntu pristi nãsu. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Atsel tsi si spigiurã trã templu, si spigiurã trã nãsu sh-trã Dumnidzãlu tsi bãneadzã aclo. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Ma atsel tsi va si spigiurã pri tser, si spigiurã pri thronlu al Dumnidzãu sh-pri atsel tsi shãdi pri nãsu.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />Cavai di voi Scribi sh-Farisei ipucritsi! Cã voi lugursits a dzatsea di mentã, di mãrar, di chimion sh-alãsats dupã mãnã lucrili atseali ma greali a legiljei: ndriptatea, njila sh-pistea. Aesti lucri prindi s-li fãtsets ni alãsat dupã mãnã altãli. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Cãlãuzi orghi, tsi sticurats biutura tra s-mutats cunuplu, sh-ascãpitats cãmila!<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />Cavai di voi Scribi sh-Farisei ipucritsi! Cã curats partea di nafoarã a cupãljei, sh-a piatãljei, iarã di nãuntru suntu mplini di arãchiri sh-di zãlumi. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Fariseu orbu! Curã ma nãinti di nãuntru cupa sh-piata, sh-di nafoarã va hibã curatã.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />Cavai di voi Scribi sh-Farisei ipucrits! Cã undzits ca murmintsãlji alghiti, tsi di nafoarã s-veadã mushati, ma nãuntru suntu mplinji di oasili a mortsãlor sh-cu multã lãvushiturã. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Ashã shi voi di nafoarã vã aspunets a oaminjlor ca ndreptsã, ma di nãuntru hits mplinji di ipucrizii sh-di anapudii.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />Cavai di voi Scribi sh-Farisei ipucrits! Cã adrats murmintsãlji a prufitsilor shi stulsits murmintsãlji a ndreptsãlor, <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />sh-dzãtsets: ‘Ma s-aveam bãnat tu chirolu a pãpãnjilor a noshtri, nu va earam pãrtashi cu nãshi, la vãtãmarea a prufitsilor.’ <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Zburãnda ashãtsi voi mãrtirsits contra di voi, cã hits hiljilji atsilor tsi vãtãmarã prufitsilji. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Voi u-tritsets misura a pãpãnjilor a voshtri.<verse eid="MAT 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33" />Sherchi, pulji di nãpãrtitsi! Cum va s-ascãpats di giudicarea a Gehenãljei? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Trã atsea, ia mini ma pitrec la voi prufits, shtiutsi shi scribii. Voi niscantsã di nãshi va lji vãtãmats, sh-va lji crutsisits. Niscãntsã altsã va lji bãtets tu sinagodzãli a voastri, sh-va lji avinats dit un cãsãbã tu altu, <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />tra s-cadã pri voi tutã sãndzili a ndreptsãlor, virsatã pri loc, di la sãndzili a ndreptului Abel pãnã la sãndzili al Zaharia, hiljiu al Barahia, tsi voi lu vãtãmat namisa di templu sh-di altar. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Dealihea ma vã dzãc cã tuti aesti lucri va s-cadã pri aestã farã.<verse eid="MAT 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />Ierusalem, Ierusalem, tsi lji vatsãnji prufitsilji sh-li vatsãnji cu chetri atselji pitricutslji la tini! Di cãti ori am vrutã s-adun hiljilji a tãlji ashãtsi cum aduni clocea puljilji a ljei sum areapti, ma voi nu vrutã! <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Ia, templu a vostru ma armãni shcretã. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Cã mini ma vã dzãc, cã di tora sh-nclo nu va mi videts ma pãnã cãndu s-dzãtsets: <char style="it">‘Ghinicuvintat s-hibã atsel tsi yini tu numa a Domnului!’</char>”<note caller="-" style="x"><char style="xo" closed="false">23:39 </char><char style="xt" closed="false"><ref loc="PSA 118:26">Ps 118:26</ref>.</char></note><verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">Nvitsarea Prufeticã, Seamnili a Chirolui dit Soni</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Tora cãndu Isusul ishi dit templu sh-ma s-dipãrta, ucenitsilji a lui lji s-apruchearã tra s-lji spunea adãrãturili a templui. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Ma Isusul lã dzãsi a lor: “Nu li videts voi tuti aesti? Dealihea ma vã dzãc, cã aoa nu va armãnã vãrã cheatrã pristi cheatrã, cã tuti va hibã surpati.” <verse eid="MAT 24:2" /><verse number="3" style="v" sid="MAT 24:3" />Deapoea cãndu elu shidzu tu Muntili a Masnjilor, lji s-apruchearã singur ucenitsilji u lui sh-lji dzãsirã: Nã-aspunã cãndu va s-undzeascã aesti lucri? Sh-cai va hibã semnu a vinitãljei a ta sh-a bitisitãljei a etiljei? <verse eid="MAT 24:3" /><verse number="4" style="v" sid="MAT 24:4" />Sh-Isusul apãndisi: “Afirits-vã s-nu vã arãdã vãrã! <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Cã multsã va yinã tu numa a mea, sh-va dzãcã: ‘Mini escu Hristolu,’ sh-va s-arãdã multsã oaminji. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Atumtsea va avdzãts di alumti sh-di hãbãri trã alumti. Afirits-vã, sh-nu vã aspãrats, cã aesti tuti prindi si s-facã, ma bitisita ninga nu va aibã vinitã. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Va si scoalã natsiunea contra a natsiuniljei, amirãriljea contra a amirãriljei, va aibã urfanji di pãni, sh-cutremburi tu multi locuri. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Ma tuti aesti lucri va hibã apãrnjita a durerilor a amintariljei. <verse eid="MAT 24:8" /><verse number="9" style="v" sid="MAT 24:9" />Atumtsea va vã prida tu munduiri sh-va vã vatãmã, sh-di tuti natsiunili va vã aurascã trã itia a numãljei a mea. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Atumtsea multsã va s-dipãrteadzã di pisti, va vindã un-alantu, sh-va aurascã un-alantu. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Va easã multsã prufits arãdioshi, sh-va arãdã multsã oaminji. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Sh-macã va s-multseascã anapudiiljea, a multsãlor va lã arãtseascã vrearea. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Ma atsel tsi va aravdã pãnã tu soni, atsel va s-ascapã. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Sh-evanghelu aestu a amirãriljei va hibã predicat pri tutã lumea, ca unã mãrtirii la tuti natsiunili sh-atumtsea va hibã bitisita.”<verse eid="MAT 24:14" /></para>
  <para style="s1">Munduirea Atsea Marea</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />“Cãndu s-videts lãhtarea a shcretuiriljei, tsi easti pridzãs di prufitlu Daniel, sh-ljea loc tu loclu atsel sãmtu (cai cãntã s-aducheascã), <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />atumtsea atselji tsi suntu tu Iudea, s-fugã pri muntsã. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />Cai s-alfã pri taratsã a casiljei, s-nu dipunã s-ljea tsiva di casã. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />Cai easti pri agru s-nu s-toarnã s-ljea mantelul a lui. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Ma cavai di muljerili atseali greali sh-atseali tsi va lji da sinã a cilimeanlui tu atseali dzãli. <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Rugats-vã tsi fudzirea a voastrã s-nu hibã iarna, icã Sãmbãta. <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Cã atumtsea va aibã unã munduiri ahãntã mari, cãt nu ari undzit pute di tu ahurhita a lumiljei, pãnã azã, sh-nu va aibã vãrãoarã. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Sh-ma nu si shcurteadzã atseali dzãli, nu va ascapã vãrã om, ma trã itia a aleptsilor atseali dzãli va si shcurteadzã. <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />Atumtsea macã vãrã va vã dzãcã: ‘Ia, Hristolu easti aoa,’ icã: ‘Easti aclo,’ s-nu pistipsits. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Cã va easã hristoshi arãdioshi sh-prufits arãdioshi, sh-va facã seamni mãri, sh-ahãnti ciudii cãt, ma s-putea s-arãdã sh-aleptsilji. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Ia, adutsets-vã aminti cã mini vã hãbãrsii ma nãinti. <verse eid="MAT 24:25" /><verse number="26" style="v" sid="MAT 24:26" />Sh-macã vã dzãcã: ‘Ia, Hristolu easti tu irnjii,’ nu dutsets-vã aclo. ‘Ia, easti tu udãdzili atseali ascumti,’ nu pistipsits-lã. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Cã ca ascãpirarea tsi easi di tu rãsãrit shi si aspuni pãnã tu ascãpitat, ashã va hibã sh-vinita a Hiljilui a Omlui. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Cã aclo iu suntu cufumili, aclo va s-adunã sh-vulturilji.”<verse eid="MAT 24:28" /></para>
  <para style="s1">Vinita a Hiljilui al Dumnidzãu</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />“Tora dupã nvirinarea atsilor dzãli,</para>
  <para style="q1" vid="MAT 24:29">‘soarili va si scutidiseascã,</para>
  <para style="q2" vid="MAT 24:29">sh-luna nu va da lunjina a ljei.</para>
  <para style="q1" vid="MAT 24:29">Stealili va cadã dit tser,</para>
  <para style="q2" vid="MAT 24:29">sh-puterili a tserurilor va si trunduescu.’<note caller="-" style="x"><char style="xo" closed="false">24:29 </char><char style="xt" closed="false"><ref loc="ISA 13:10">Isa 13:10</ref>; <ref loc="ISA 34:4">34:4</ref>.</char></note><verse eid="MAT 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />Atumtsea va s-aspunã tu tser semnul a Hiljilui a Omlui. Tuti natsiunili a loclui va plãngã, cãndu s-veadã Hiljilu a Omlui yininda pristi norilji a tserlui cu puteari sh-mãriri mari. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Sh-elu va li pitreacã anghilji a lui cu boatsi vãrtoasi di trumpetã, sh-elji va adunã aleptsilji a lui di patru vimturili, di unã mardzinã a tserlui pãnã la alantã. <verse eid="MAT 24:31" /><verse number="32" style="v" sid="MAT 24:32" />Tora di la hiclu nvitsats aestã parabolã: cãndu tora dedzili a lui s-muljeadzã, shi scoatã frãndzãli, s-u shtits cã vearea easti aproapi. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Ashãtsi sh-voi, cãndu s-videts tuti aesti lucri, si shtits cã elu easti aproapi, ningã ushã. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Dealihea ma vã dzãc cã nu va treacã aestã gheneratã ni faptã tuti aesti. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Tserlu shi loclu va treacã, ma zboarili a meali nu va treacã.”<verse eid="MAT 24:35" /></para>
  <para style="s1">Bãgats Oarã di Vinita a Hiljilui a Omlui!</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />“Iarã di dzua atsea sh-di oara atsea vãrã nu shtii, nitsi anghilji dit tser, nitsi Hiljilu, ma singur Tatãl. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Shi ashã cum tu dzãlili al Noe, ashã va hibã sh-la vinita a Hiljiu a Omlui. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Cã ashã cum tu dzãlili atseali di cama nãinti a nicariljei, oaminjlji mãca sh-bea, si-nsura shi s-mãrta, pãnã cãndu Noeul intrã tu varcã. <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />Elji nu aduchirã tsiva, pãnã cãndu vini nicarea sh-lji lo tuts. Ashã va hibã sh-tu vinita a Hiljilui a Omlui. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Atumtsea doi va hibã la agru, unlu va s-ljea, sh-alantu va s-alasã. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Doauã muljeri va s-matsinã la moarã, unã va s-ljea, sh-alanta va s-alasã. <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />Stats dishtiptat, cã nu shtits tu tsi oarã va yinã Domnul a vostru. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Ma si shtits aestã, cã ma s-shtiea nicuchirlu a casiljei tu tsi oarã a noaptiljei va yinea furlu, va armãnea dishtiptat sh-nu va lu alãsa s-lji intra tu casã. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Trã aestã voi s-hits etimãsits, cã Hiljiu a Omlui va yinã tu atsea oarã cãndu voi nu lu ashtiptats.”<verse eid="MAT 24:44" /></para>
  <para style="s1">Parabola Atsilor Doi Huzmicheari</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />“Cai easti atsel huzmichear pistimen sh-mintimen? Easti atsel tsi nicuchirlu l-bãgã pristi huzmichearlji a lui, tra s-lã da hranã tu oara tsi prindi. <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Ca hara di atsel huzmichear tsi, cãndu s-toarnã nicuchirlu a lui, s-lu aflã fãcãnda ashã. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Dealihea ma vã dzãc cã elu va lji pistipseascã atsilui huzmichear tutã ayishtearea a lui. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Ma, macã aestu huzmichear arãu dzãtsi tu inima a lui: ‘Domnul a meu amãni s-yinã,’ <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />sh-ahurheashti s-batã sotslji a lui, sh-mãcã sh-bea cu biutorlji, <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />domnulu aishtui huzmichear va yinã tu dzua atsea, cãndu elu nu lu ashteapti, sh-tu oara atsea cãndu elu nu u-shtii. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Elu va lu condamnã cu aspru sh-va lji da tihea a ipucritsilor. Aclo va hibã plãngul sh-cãrtsãnirea a dintsãlor.”<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">Parabola a Dzatsi Virghinilor</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />“Atumtsea amirãriljea a tserurilor va s-undzeascã cu dzatsi virghini, tsi li loarã cãndilili a lor sh-ishirã nãintea a dzinirlui. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Tsintsi di eali eara glari sh-tsintsi mintimeni. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Glarili, cãndu loarã cãndilili a lor, nu loarã cu nãsi sh-untulemlu. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Iarã mintimenili, deadun cu cãndilili, loarã sh-untulemlu tu vasili a lor. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Sh-metsi dzinirli ma s-amãna, lã vini somnu a tutulor sh-durnjirã. <verse eid="MAT 25:5" /><verse number="6" style="v" sid="MAT 25:6" />Ma cãtrã njeadzã-noapti s-avdzã un griri: ‘Ia, ma yini dzinirli, ishits s-lu adunats!’ <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />Atumtsea tuti virghinili s-dishtiptarã shi ndreapsirã cãndilili a lor. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Sh-glarli lã dzãsirã a mintimenilor: ‘Dats-nã di untulemlu a vostru, cã cãndilili a noastri ma s-astingã.’ <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />Ma mintimenili apãndisirã: ‘Nu, cã nu va nã-agiungã, nitsi a noauã nitsi a voauã. Ma ghini njidzets la vindutorlji sh-acumpãrats.’ <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />Sh-cãndu eali s-dusirã s-acumpãrã, yini dzinirli. Virghinili tsi eara etimi, intrarã deadun cu nãsu la numtã, sh-usha si ncljisi. <verse eid="MAT 25:10" /><verse number="11" style="v" sid="MAT 25:11" />Ma napoi vinirã sh-alanti virghini, dzãcãnda: ‘Doamne, doamne, discljidi usha.’ <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />Ma elu apãndisi: ‘Dealihea ma vã dzãc, cã nu vã cunoscu.’ <verse eid="MAT 25:12" /><verse number="13" style="v" sid="MAT 25:13" />Trã atsea stats dishtiptat, cã nu shtits nitsi dzua nitsi oara cãndu va yinã.”<verse eid="MAT 25:13" /></para>
  <para style="s1">Parabola di Talentsãli</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />“Amirãriljea a tserurilor undzeashti tutashã ca un om, tsi cãndu ma s-nchisea ti un cãlãtorii lã acljimã huzmichearlji sh-lã pistipsi a lor avearea a lui. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />A unui lji deadi tsintsi talentsã, a altui doi sh-a altui un, a cuitsido dupã putearea a lui sh-fudzi pri cali. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Trãoarã atsel tsi avea loatã tsintsi talentsã s-dusi, sh-featsi pãzari sh-amintã tsintsi altsã. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Tutashã sh-atsel tsi avea loatã doi talentsã amintã doi altsã. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Iarã atsel tsi avea loatã un, s-dusi, disfeatsi unã groapã tu loc sh-ascumsi talentul a nicuchirlui a lui. <verse eid="MAT 25:18" /><verse number="19" style="v" sid="MAT 25:19" />Dupã multu chiro, s-turnã nicuchirlu a huzmichearilor sh-featsi luguriili cu elji. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Sh-atsel tsi avea loatã tsintsi talentsã lj-ishi nãinti sh-lji adusi tsintsi altsã, dzãcãnda: ‘Doamne, tini nji ai pistipsitã tsintsi talentsã, ia cu atseali mini amintai tsintsi altsã.’ <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />Sh-nicuchirlu lj-dzãsi: ‘Bravo, huzmichear bun sh-pistimen. Tini fushi pistimen ti lucri njitsi, mini va ti bag pri mãri lucri. Haidi s-hãrseshti cu nicuchirlu a tãu!’ <verse eid="MAT 25:21" /><verse number="22" style="v" sid="MAT 25:22" />Deapoea vini sh-atsel tsi avea loatã doi talentsã sh-dzãsi: ‘Doamne, tini nji ai pistipsitã doi talentsã. Ia, cu atseali mini amintai doi altsã.’ <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />Sh-nicuchirlu a lui lj-dzãsi: ‘Bravo, huzmichear bun sh-pistimen. Tini fushi pistimen tu lucri njitsi, mini va ti bag pri mãri lucri. Haidi s-hãrseshti cu nicuchirlu a tãu!’ <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />Tu bitisitã vini sh-atsel tsi avea loatã mash un talentu sh-dzãsi: ‘Doamne, mini lu shtiam cã eshti om aspru, tsi seatsiri aclo iu nu ai siminatã sh-adunji iu nu ai siminatã, <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />trã atsea avui fricã sh-mi dush sh-lu ascumshu talentul a tãu tu loc. Ia, mini ma ts-u tornu atsel tsi easti a tãu.’ <verse eid="MAT 25:25" /><verse number="26" style="v" sid="MAT 25:26" />Sh-nicuchirlu apãndisi: ‘Huzmichear anapud sh-timbel! Tini lu shtiai cã mini seatsir aclo iu nu am siminatã sh-adun aclo iu nu am mpãrtsãtã. <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Tini prindea s-lji-aveai datã pãradzli a meali la bancã sh-ashã, tu turnarea a mea mini va lji aveam loatã cu amintatic. <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />Trã atsea loats aishtui talentul shi dats-lu atsilui tsi ari dzatsi talentsã. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Cã atsilui tsi ari va lji si artirseascã ma multã sh-va aibã multu. Ma atsilui tsi nu ari, va-lj si ljea sh-atsea tsi ari. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Arucats-lu tu scutidlu di nafoarã aestu huzmichear arãu. Aclo va hibã plãngul sh-cãrtsãnirea a dintsãlor.’”<verse eid="MAT 25:30" /></para>
  <para style="s1">Bitisita ti Nvitsarea Prufeticã, Oili sh-Cãprili</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />“Cãndu s-yinã Hiljiu a Omlui tu mãrirea a lui, deadun cu tuts anghilji, atumtsea va s-apunã pri thronlu a mãririljei a lui. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Sh-tuti natsiunili va s-adunã nãintea a lui, sh-elu va li dispartã unlu di alantu ashã cum disparti picurarlu oili di cãprili. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Sh-oili va li bagã di nandreapta a lui sh-cãprili di nastãnga. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />Atumtsea Amirãlu va l-dzãcã atsilor tsi va hibã di nandreapta a lui: ‘Haidets ghinicuvintats a Tatãlui a meu. Mushtinits-u amirãriljea tsi s-featsi etimu trã voi di la adrarea a lumiljei. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Cã avui foami sh-nji deaditã ti mãcari, avui seati sh-nji deaditã ti beari, earam xen sh-mi priadunat, <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />earam dizviscut sh-mi nviscut, earam lãndzit sh-voi mi vindicat, earam tu hapsi sh-vinitã la mini.’ <verse eid="MAT 25:36" /><verse number="37" style="v" sid="MAT 25:37" />Atumtsea ndreptsãlji va lji apãndiseascã: ‘Doamne, cãndu ti vidzum agiun sh-ti hrãnim, icã sitos shi s-deadimã ti beari? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Sh-cãndu ti vidzum xen sh-ti priadunãm, icã dizviscut sh-ti nviscum? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Sh-cãndu ti vidzum lãndzit icã tu hapsi sh-vinim la tini?’ <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />Sh-Amirãlu apãndisi: ‘Dealihea ma vã dzãc: Di cãti ori lji-u-avets faptã aestã a vãrui di aeshti fratsi a melji ma njitsi, aestã nji-u featsit a njia.’ <verse eid="MAT 25:40" /><verse number="41" style="v" sid="MAT 25:41" />Deapoea elu va lã dzãcã sh-atsilor tsi va hibã di nastãnga: ‘Dipãrtats-vã di mini, blãstimats, tu foc di totãna, etimãsit ti draclu sh-anghilji a lui. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Cã aveam foami sh-nu nji deadit ti mãcari, avui seati sh-nu nji deadit ti beari, <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />earam xen sh-nu mi priadunat, dizviscut sh-nu mi nviscut, lãndzit sh-tu hapsi sh-nu vinit s-mi mutreat.’ <verse eid="MAT 25:43" /><verse number="44" style="v" sid="MAT 25:44" />Atumtsea elji va lji apãndiseascã: ‘Doamne, cãndu ti vidzum cu foami icã cu seati, icã xen, icã dizviscut, icã lãndzit, icã tu hapsi sh-nu ti agiutãm?’ <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />Atumtsea elu va lã apãndiseascã: ‘Dealihea vã dzãc: Di cãti ori tsi nu lji-u avets faptã aestã a vãrui di aeshti ma njitsi, aestã nu nji-u avets faptã a njia.’ <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />Sh-elji va s-ducã tu munduiri di totãna, ma ndreptsãlji va aibã bana eternã.”<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">Planlu a Preftsãlor</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Cãndu Isusul bitisi tuti aesti zboari, lã dzãsi a ucenitsilor a lui: <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />“Voi shtits cã dupã doauã dzãli easti Pashtili, sh-deapoea Hiljiu a Omlui va s-prida ti crutsisiri.” <verse eid="MAT 26:2" /><verse number="3" style="v" sid="MAT 26:3" />Atumtsea mãrlji a preftsãlor, sh-aushlji a popului s-adunarã tu uborlu a arhipreftlui tsi s-acljima Caiafa. <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />Sh-apofãsirã s-lu acãtsa Isusul cu tirtipi shi s-lu vatãmã, <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />ma dzãtsea: “Nu tu sãrbãtoari, tra s-nu s-facã vãrã mintiturã tu popul.”<verse eid="MAT 26:5" /></para>
  <para style="s">Uspetsi tu Betania</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Cãndu Isusul eara tu Betania, tu casa al leproslu Simon, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />s-apruche unã muljeari cu un vas di alabastru cu untulem di njir multu scumpã, shi lji-lu virsã pri caplu a lui, cãndu elu ma shidea ndupirat la measã. <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />Cãndu ucenitsilji a lui vidzurã aestã, s-nãrãirã shi ntribarã: “Cãtse tut aestu hãrgiuiri digeaba? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Aestu untulem, putea si s-vindea multã scumpu sh-pãradzlji si s-dea a niavutslor.” <verse eid="MAT 26:9" /><verse number="10" style="v" sid="MAT 26:10" />Ma Isusul lu achicãsi aestã sh-lã dzãsi a lor: “Cãtse u tulburatsã aestã muljeari? Ea featsi un lucru bun trã mini. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Cã oarfãnjlji va lji avets totãna cu voi, ma mini nu va mi avets totãna. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Cã, virsãnda aestu untulem njirusit pri truplu a meu, ea lu ndreapsi truplu a meu trã ngrupari. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Dealihea mini ma vã dzãc cã iutsido tsi va hibã predicat aestu evanghelu tu tutã lumea, va si aspunã cã tsi featsi aestã muljeari, trã amintirea a ljei.”<verse eid="MAT 26:13" /></para>
  <para style="s1">Pridarea al Isus</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Atumtsea un di atselji doisprãdzatsi, acljimat Iuda Iscariotul, s-dusi la mãrlji a preftsãlor, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />sh-lã dzãsi a lor: “Tsi va nji dats tsi mini s-vã lu dau?” Sh-elji lj-misurarã treidzãtsi pãradz, di asimi. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Sh-di atumtsea elu cãfta oara s-lu prida.<verse eid="MAT 26:16" /></para>
  <para style="s1">Tsina a Pashtiljei</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Tu prota dzuã a Adzãmilor, ucenitsilji s-apruchearã a Isusului sh-lu ntribarã: “Iu vrei s-ndridzem trã mãcari Pashtili?” <verse eid="MAT 26:17" /><verse number="18" style="v" sid="MAT 26:18" />Sh-elu apãndisi: “Dutsets-vã tu cãsãbã la fileanu sh-dzãtsets-lji: ‘Nvitsãtorlu dzãtsi: Chirolu a meu easti aproapi. Va facã Pashtili la casa a ta deadun cu ucenitsilji a melji.’” <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Atumtsea ucenitsilji featsirã ashã cum lã avea dimãndatã Isusul shi etimãsirã Pashtili. <verse eid="MAT 26:19" /><verse number="20" style="v" sid="MAT 26:20" />Sh-cãndu ntunicã, elu shidzu la measã deadun cu doisprãdzatslji. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Cãndu ma mãca, dzãsi: “Dealihea mini ma vã dzãc, cã un di voi va mi vindã.” <verse eid="MAT 26:21" /><verse number="22" style="v" sid="MAT 26:22" />Elji si nvirinarã multu sh-cathiun di nãshi ahurhi s-dzãcã: “Nacã escu mini, Doamne?” <verse eid="MAT 26:22" /><verse number="23" style="v" sid="MAT 26:23" />Sh-elu apãndisi: “Atsel tsi ari muljeatã deadun cu mini mãshcãtura tu cãtsãn, elu va mi vindã. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Ashã cum easti scriatã trã nãsu, Hiljiu a Omlui s-dutsi. Ma cavai di atsel om tsi prida Hiljiu a Omlui! Trã nãsu va eara ma ghini s-nu eara amintat pute.” <verse eid="MAT 26:24" /><verse number="25" style="v" sid="MAT 26:25" />Sh-Iuda, atsel tsi va lu pridea, lu ntribã sh-lji dzãsi: “Rabbi, nacã escu mini atsel?” Elu lji dzãsi: “Tini ma dzãtsi!” <verse eid="MAT 26:25" /><verse number="26" style="v" sid="MAT 26:26" />Sh-iarã elji ma mãca, Isusul lo pãnea, u-ghinicuvãntã, u frãmsi, sh-u deadi a ucenitsilor a lui sh-dzãsi: “Loats shi mãcats, aestã easti truplu a meu.” <verse eid="MAT 26:26" /><verse number="27" style="v" sid="MAT 26:27" />Deapoea lo cupa, hãristisi, sh-u-deadi a lor dzãcãnda: “Bets di aestã tuts. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Aestu easti sãndzili a meu a pisti-ligãturiljei, tsi easti virsatã trã multsã trã ljirtarea a amãrtiilor. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Sh-mini ma vã dzãc, cã di tora sh-nclo mini nu va beau ma di aestu carpo a ayitãljei, pãnã tu atsea dzuã cãndu deadun cu voi, va s-beau di nou tu Amirãriljea a Tatãlui a meu.” <verse eid="MAT 26:29" /><verse number="30" style="v" sid="MAT 26:30" />Sh-dupã tsi cãntarã himnul, ishirã nafoarã la muntili a Masnjilor.<verse eid="MAT 26:30" /></para>
  <para style="s">Prihãbãrsirea a Petrului trã Alipidarea</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Atumtsea Isusul lã dzãsi a lor: “Aestã noapti tuts voi va mi apãrãsits, cã easti scriatã:</para>
  <para style="q1" vid="MAT 26:31">‘<char style="it">Va agudescu picurarlu sh-oili a cupiiljei va s-arãspãndeascã.</char>’<note caller="-" style="x"><char style="xo" closed="false">26:31 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">Zac 13:7</ref>.</char></note><verse eid="MAT 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 26:32" />Ma dupã tsi s-hiu nyeatã, va mi duc nãinti di voi tu Galilea.” <verse eid="MAT 26:32" /><verse number="33" style="v" sid="MAT 26:33" />Atumtsea Petrul apãndisi: “Sh-canda tuts s-vã apãrãtseascã, mini nu va s-vã apãrãtsescu pute!” <verse eid="MAT 26:33" /><verse number="34" style="v" sid="MAT 26:34" />Isusul lj-dzãsi a lui: “Dealihea ma tsã dzãc cã tu noaptea aestã, ma nãinti tsi s-cãntã cucotlu, tini va mi aleapidz di trei ori.” <verse eid="MAT 26:34" /><verse number="35" style="v" sid="MAT 26:35" />Petrul lji dzãsi: “Sh-ca s-prindi s-mor cu tini, nu va ti aleapid pute.” Ashã dzãsirã sh-tuts ucenitsilji.<verse eid="MAT 26:35" /></para>
  <para style="s1">Isusul tu Ghetsemani</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Atumtsea Isusul s-dusi deadun cu nãshi tu un loc, tsi s-acljima Ghetsemani, sh-lã dzãsi a ucenitsilor: “Shidets aoa, iarã mini ma mi duc aclo tra s-mi rog.” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Sh-lo cu nãsu Petrul sh-doi hiljilji al Zebedeu, sh-apãrnji si nvirineadzã shi s-aibã mari sicleti. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Atumtsea elu lã dzãsi a lor: “Suflitlu a meu easti multu nvirinat, pãnã tu moarti. Armãnets aoa shi stats dishtiptat deadun cu mini.” <verse eid="MAT 26:38" /><verse number="39" style="v" sid="MAT 26:39" />Sh-cum s-dusi niheamã ma nãinti, cãdzu cu fatsa pri loc shi s-rugã dzãcãnda: “Tatãl a meu, macã easti putut, dipãrteadz-u di la mini aestã cupã, cu tutã atsea, nu cum voi mini, ma cum vrei tini.” <verse eid="MAT 26:39" /><verse number="40" style="v" sid="MAT 26:40" />Deapoea s-turnã la ucenitsilji sh-lji aflã durnjinda, sh-lji dzãsi al Petru: “Ma cum, nu putut s-vigljeats cu mini macari unã oarã? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Stats dishtiptat sh-rugats-vã, s-nu cãdets tu cãrtiri, cã duhlu easti etimu, ma truplu easti niputut.” <verse eid="MAT 26:41" /><verse number="42" style="v" sid="MAT 26:42" />S-dusi a doaua oarã shi s-rugã dzãcãnda: “Tatãl a meu, macã nu easti putut tsi aestã cupã s-fugã di la mini fãrã s-bea di mini, si s-facã vrearea a ta!” <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />Deapoea s-turnã sh-lji aflã nãpoi tsi durnjea, cã ocljilji a lor eara somnusiti. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Sh-dupã tsi lã alãsã, s-dusi nãpoi shi s-rugã di-a treia oarã, dzãcãnda idyili zboari. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />Deapoea s-turnã la ucenitsilji a lui sh-lã dzãsi a lor: “Tora ninga durnjits sh-vã discurmats? Ia vini oara, sh-Hiljiu a Omlui va s-prida tu mãnjili a amãrtioshilor. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Sculats-vã, s-nidzem. Ia, atsel tsi ma mi prida easti aproapi.”<verse eid="MAT 26:46" /></para>
  <para style="s1">Acãtsarea al Isus</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Sh-iarã Isusul ma grea, ia Iuda, un di doisprãdzatslji, vini sh-deadun cu nãsu unã multsãmi mari cu spãtsi sh-cu ciumãdzi, pitricuts di mãrlji a preftsãlor sh-di aushlji a popului. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Tora atsel tsi lu pridea lã avea datã a lor un semnu, dzãcãnda: “Atsel tsi mini va l-bashu, elu easti, acãtsats-lu.” <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Shi trãoarã s-apruche la Isusul sh-lji dzãsi: “Salut, Nvitsãtore!”, sh-lu bãshe. <verse eid="MAT 26:49" /><verse number="50" style="v" sid="MAT 26:50" />Isusul lji dzãsi: “Oaspe, tsi ai tu minti s-fats?” Atumtsea elji s-apruchearã, bãgarã mãnjili pri Isusul sh-lu acãtsarã. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Shi ia, un di atselji tsi eara cu Isusul, timsi mãna, scoasi spata a lui, agudi huzmichearlu a arhipreftlui sh-lji tãlje ureaclja. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />Atumtsea Isusul lji dzãsi: “Toarnã spata tu loclu a ljei, cã tuts atselji tsi ljea spata, di spata va moarã. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Minduits voi, cã mini nu pot s-mi rog a Tatãlui a meu, dinãoarã s-nji pitreacã ma multã di doisprãdzatsi di leghionji di anghilji? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Ma atumtsea cum va si mplineascã Scriturili, cã dupã eali ashã prindi s-facã?” <verse eid="MAT 26:54" /><verse number="55" style="v" sid="MAT 26:55" />Tu atsea oarã Isusul lã dzãsi a multsãnjilor: “Voi ishit s-mi acãtsats mini cu spãtsi sh-cu ciumãdzi, ca un fur. Ia, cathi dzuã shideam cu voi nvitsãnda tu templu, sh-voi nu mi acãtsat. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Ma tuti aesti s-featsirã tsi si mplineascã Scriturili a prufitsilor.” Atumtsea tuts ucenitsilji lu alãsarã sh-fudzirã.<verse eid="MAT 26:56" /></para>
  <para style="s1">Isusul Nãintea a Sinedriului</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Sh-atselji tsi lu avea acãtsatã Isusul, lu dusirã la Caiafa, arhipreftulu iu eara adunatã scriblji sh-aushlji. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Sh-Petrul lu urmã di diparti pãnã tu uborlu a arhipreftlui, shi-dupã tsi intrã atsia, s-apunã deadun cu vigljitorlji s-veadã tsi va s-undzeascã. <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />Tora mãrlji a preftsãlor, sh-tut sinedriul cãfta vãrã mãrtirii arãdioasã contra al Isus, ti vãtãmari, <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />ma nu aflarã tsiva, cu tutã cã vinirã multsã martiri arãdioshi. Ma napoi vinirã doi altsã martiri arãdioshi, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />tsi dzãsirã: “Aestu ari dzãsã: ‘Mini pot s-aspargu templul a Dumnidzãlui shi s-lu adar ti trei dzãli.’” <verse eid="MAT 26:61" /><verse number="62" style="v" sid="MAT 26:62" />Atumtsea arhipreftul si s-culã sh-lji dzãsi: “Nu ma apãndiseshti dip ti atseali tsi ma mãrtirsescu aeshti contra tini?” <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Iarã Isusul tãtsea. Sh-arhipreftul grãi: “Mini ma mi spigiur pri Dumnidzãlu atsel yiulu s-nã dzãtsi macã tini eshti Hristolu, Hiljiu a Dumnidzãlui.” <verse eid="MAT 26:63" /><verse number="64" style="v" sid="MAT 26:64" />Isusul lji dzãsi: “Tini ma dzãtsi! Sh-mini ma vã dzãc cã di tora sh-ma nclo voi va lu videts Hiljiu a Omlui tsi sheadi di nandreapta a Puteariljei, sh-yininda pri norilji a tserlui.”<note caller="-" style="x"><char style="xo" closed="false">26:64 </char><char style="xt" closed="false"><ref loc="DAN 7:13">Dan 7:13</ref>.</char></note> <verse eid="MAT 26:64" /><verse number="65" style="v" sid="MAT 26:65" />Atumtsea arhipreftul arupsi stranjili a lui, dzãcãnda: “Elu blãstimã! Trã tsi nã lipsescu tora martirlji? Ia, tora lu avdzãtã blãstemlu a lui. <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Cum vã si pari a voauã?” Sh-elji apãndisirã: “Elu easti cãbatar trã moarti!” <verse eid="MAT 26:66" /><verse number="67" style="v" sid="MAT 26:67" />Atumtsea lu ascuchearã pri fatsã, lu agudirã cu shupleacã, shi niscãntsã altsã lji-l-deadirã cu bushlu, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />dzãcãnda: “Hristose, prufitipsea! Cai ti agudi?”<verse eid="MAT 26:68" /></para>
  <para style="s1">Alipidearea a Petrului</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Iarã Petrul shidea nafoarã, tu ubor unã huzmichearã s-apruche dzãcãnda: “Sh-tini earai cu Isus Galileanlu.” <verse eid="MAT 26:69" /><verse number="70" style="v" sid="MAT 26:70" />Ma elu lu alipidã nãintea a tutulor dzãcãnda: “Nu shtiu tsi dzãtsi!” <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />Sh-cãndu elu ma ishea la poartã, vidzu unã altã huzmichearã sh-lã dzãsi atsilor tsi eara aclo: “Sh-aestu eara cu Isus Nazareanlu!” <verse eid="MAT 26:71" /><verse number="72" style="v" sid="MAT 26:72" />Ma Petrul lu alipidã nãpoi spigiurãnda: “Mini nu lu cunoscu atsel om.” <verse eid="MAT 26:72" /><verse number="73" style="v" sid="MAT 26:73" />Dupã putsãn s-apruchearã sh-atselji tsi shidea aclo, sh-lji dzãsirã a Petrului: “Dealihea, sh-tini eshti un di atselji, cã grailu a tãu ti aspuni!” <verse eid="MAT 26:73" /><verse number="74" style="v" sid="MAT 26:74" />Atumtsea elu ahurhi s-blastimã shi si spigiurã, dzãcãnda: “Mini nu lu cunoscu atsel om!” Sh-tu oara atsea cãntã cucotlu. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />Atumtsea Petrul adusi aminti atsea tsi lji avea dzãsã Isusul: “Ma nãinti tsi s-cãntã cucotlu, va mi aleapidz di trei ori.” Sh-elu ishi afoarã sh-plãmsi cu amãreatsã.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">Spindzurarea al Iuda</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Cãndu vini dimineatsa, tuts mãrlji a preftsãlor sh-aushlji a popului featsirã plan contra al Isus tsi s-lu vãtãma. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Sh-ashã cum lu ligarã, lu dusirã sh-lu prideadirã la Pilat, guvernatorlu romac. <verse eid="MAT 27:2" /><verse number="3" style="v" sid="MAT 27:3" />Atumtsea, Iuda tsi lu avea pridatã, cãndu lu vidzu cã lu giudicarã Isusul, s-pishmãnipsi, sh-lji turnã nãpoi treidzãtsi di asimi la mãrlji a preftsãlor sh-la aushlji, <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />dzãcãnda: “Feciu amãrtii cã vindui un sãndzi fãrã cãbati.” Ma elji dzãsirã: “Tsi nã mealã a noauã? Lucru ti tini!” <verse eid="MAT 27:4" /><verse number="5" style="v" sid="MAT 27:5" />Sh-ashã Iuda, l-arcã pãradzlji di asimi la templu shi s-dusi si-spindzura. <verse eid="MAT 27:5" /><verse number="6" style="v" sid="MAT 27:6" />Ma mãrlji a preftsãlor adunarã aesti pãradzi di asimi sh-dzãsirã: “Nu prindi s-lji bãgãm tu ayishtearea a templui, cã easti pãhãlu a sãndzilui.” <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Dupã tsi featsirã plan, cu aesti pãradzi acumpãrarã agrul a pociarlui di murmintsãlji a xenjilor. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Trã atsea agrul aestu s-acljeami pãnã tu dzua di azã: “Agrulu a sãndzilui.” <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Atumtsea si mplini atsea tsi fu dzãsã prit prufitlu Ieremia: “<char style="it">Sh-loarã treidzãtsi di pãradzili di asimi, pãhãlu tsi lu avea tinjisitã hiljilji al Israel,</char> <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" /><char style="it">sh-li deadirã trã agrul a pociarlui ashã cum mi dimãndã Domnul.</char>”<verse eid="MAT 27:10" /></para>
  <para style="s1">
    <note caller="-" style="x">
      <char style="xo" closed="false">27:11 </char>
      <char style="xt" closed="false">
        <ref loc="ZEC 11:12-13">Zac 11:12-13</ref>.</char>
    </note>Isusul Nãintea al Pilat</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Sh-Isusul stãtu nãintea a guvernatorlui sh-elu lu ntribã: “Tini eshti amirãlu a Iudeilor?” Sh-Isusul lji dzãsi: “Tini ma dzãts.” <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />Deapoea mãrlji a preftsãlor sh-aushlji lu acuzarã, ma elu nu apãndisi dip. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Atumtsea Pilatul lu-ntribã: “Nu avdzã cãti mãrtirii dzãc contra di tini?” <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />Ma elu nu apãndisi la nitsi un zbor, ashãtsi guvernatorlu s-ciudisi multu. <verse eid="MAT 27:14" /><verse number="15" style="v" sid="MAT 27:15" />Cu sibepea a sãrbãtoariljei guvernatorlu avea ca adeti tsi s-lji sãlãghea a popului un hãpsãnit, atsel tsi vrea populu. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Avea atumtsea tu hapsi, un hãpsãnit cu anami, cu numa Baraba. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Cãndu s-adunarã oaminjlji, Pilatul lã ntribã atselji: “Cai vrets s-vã sãlãghescu, Baraba, ama Isusul, tsi s-numeashti Hristos?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Cã elu shtia ghini cã elji lu avea pridatã di inati. <verse eid="MAT 27:18" /><verse number="19" style="v" sid="MAT 27:19" />Sh-iarã elu shidea pri scamnu la giudicatã, muljearea a lui lj-pitricu zbor: “Nu ti mintea dip cu lucrul atsilui ndreptu, cã azã am traptã multã tu yis trã itia a lui.” <verse eid="MAT 27:19" /><verse number="20" style="v" sid="MAT 27:20" />Ma mãrlji a preftsãlor sh-aushlji lji umplurã mintea a multsãmiljei tsi s-cãfta Baraba, sh-Isusul si s-vãtãma. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />Sh-guvernatorlu lã ntribã: “Cai di doilji vrets s-vã sãlãghescu?” Elji dzãsira: “Baraba!” <verse eid="MAT 27:21" /><verse number="22" style="v" sid="MAT 27:22" />Pilatlu lã dzãsi a lor: “Tsi s-fac, cu Isusul, tsi s-acljeami Hristos?” Tuts lji apãndisirã: “S-crutsiseascã!” <verse eid="MAT 27:22" /><verse number="23" style="v" sid="MAT 27:23" />Ma guvernatorlu ntribã: “Cãtse, tsi arãu ari faptã?” Ma elji aurla ma multu: “S-crutsiseascã!” <verse eid="MAT 27:23" /><verse number="24" style="v" sid="MAT 27:24" />Atumtsea Pilatlu, vidzãnda cã nu ma agiundzea iuva, sh-aurlarea ma s-fãtsea ma vãrtoasã, lo apã sh-aspilã mãnjili nãintea a lor, dzãcãnda: “Mini escu ni-vinovat di sãndzili a aishtui ndreptu, easti lucrul a vostru.” <verse eid="MAT 27:24" /><verse number="25" style="v" sid="MAT 27:25" />Sh-tut populu apãndisinda dzãsi: “S-hibã sãndzili a lui pristi noi sh-pristi cilimenjlji a noshtri!” <verse eid="MAT 27:25" /><verse number="26" style="v" sid="MAT 27:26" />Atumtsea elu lã sãlãghi a-lor Baraba. Dupã tsi Isusul lu bãturã, lu prideadi tsi s-lu crutsisea. <verse eid="MAT 27:26" /><verse number="27" style="v" sid="MAT 27:27" />Atumtsea suldatslji a guvernatorlui, dupã tsi dusirã Isusul tu pretorium, adunarã ningã nãsu tutã cohorta. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Sh-cum lu disviscurã, lji arcarã pri pãltari un mantel roshu amirãrescu. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Sh-lji mplãtirã unã curunã di schinji, lji-u bãgarã pri cap, sh-lji deadirã un bãstun tu mãna atsea ndreapta sh-dzinucljãnda nãintea a lui, arãdea dzãcãnda: “Salut, amirãlu a Iudeilor!” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Deapoea lu ascuchearã, lji loarã bãstunlu sh-cu atsel lu agudea n-capã. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Dupã tsi lu pizuirã, lji-lu mutarã mantelul, lu nviscurã cu stranjili a lui, sh-lu dusirã ti crutsisiri.<verse eid="MAT 27:31" /></para>
  <para style="s1">Crutsisirea</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Sh-cara ishirã afoarã, aflarã un om dit Tsirenea, tsi s-acljima Simon, sh-lu strimsirã s-purta crutsea al Isus. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Cãndu agiumsirã tu loclu tsi s-acljima Golgota, tsi va s-dzãcã “Loclu a Cafcãljei”, <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />lji deadirã s-bea yinã puscã misticat cu heari. Ma elu, dupã tsi u bãgã tu gurã, nu vrea s-u bea. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />Dupã tsi lu crutsisirã, mpãrtsãrã cu soarti stranjili a lui, [tra si mplineascã tsi eara dzãsã di la prufitlu: “Mpãrtsãrã namisa di nãshi stranjili a meali sh-arcarã soarti di tunica a mea.”]<note caller="+" style="f"><char style="fr" closed="false">27:35 </char><char style="ft" closed="false">aesti zboari di tu bitisitã nu s-aflã tu manuscrisili atseali vecljili. Aesti zboari s-aflã tu Psalmu 22:18</char></note> <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Deapoea shidzurã sh-lu vigljea. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Pristi caplu a lui, bãgarã tutashã scriatã acuza ti giudicata a lui: “Aestu easti Isusul, Amirãlu a Iudeilor.” <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Atumtsea s-crutsisirã deadun cu nãsu sh-doi rebilji, unlu tu nandreapta sh-alantu tu nastãnga. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />Sh-atselji tsi tritsea cãtrã aclo, lu ngiura giucãnda caplu, <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />sh-dzãcãnda: “Tini tsi lu aspardzã templul sh-lu adarã ti trei dzãli, ascapã-ti! Macã eshti Hiljiu a Dumnidzãlui, dipunã-ti di crutsi!” <verse eid="MAT 27:40" /><verse number="41" style="v" sid="MAT 27:41" />Tutashã, sh-mãrlji a preftsãlor, deadun cu scriblji sh-cu aushlji, s-pizuea sh-dzãtsea: <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“Elu ascãpã altsã, ma tora nu poati si s-ascapã. Macã easti amirãlu a Israelui, s-dipunã tora di crutsi sh-noi va pistipsim la nãsu. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Elu ari pistipsitã tu Dumnidzã, sh-macã elu lu va s-lu ascapã tora, cã ari dzãsã: ‘Mini escu Hiljiu a Dumnidzãlui.’” <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Tutashã, lu ngiura sh-rebiljilji tsi eara crutsisit cu nãsu. <verse eid="MAT 27:44" /><verse number="45" style="v" sid="MAT 27:45" />Di tu njeadzãdzuã<note caller="+" style="f"><char style="fr" closed="false">27:45 </char><char style="ft" closed="false">tu gãrtseashti atsea oarã easti a shasea.</char></note> pãnã la oara trei ti mirindi<note caller="+" style="f"><char style="fr" closed="false">27:45 </char><char style="ft" closed="false">tu gãrtseashti atsea oarã easti a noaua.</char></note> scutidlu anvãli tut loclu. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Anvãrliga di oara trei dupã prãndzu<note caller="+" style="f"><char style="fr" closed="false">27:46 </char><char style="ft" closed="false">tu gãrtseashti atsea oarã easti a noaua.</char></note>, Isusul aurlã cu boatsi analtã, dzãcãnda: “Eli, Eli, lema sabacthani?”,<note caller="-" style="x"><char style="xo" closed="false">27:46 </char><char style="xt" closed="false"><ref loc="PSA 22:1">Ps 22:1</ref>.</char></note> tsi va s-dzãcã: “Dumnidzãlu a meu, Dumnidzãlu a meu, cãtse mi ai alãsatã?” <verse eid="MAT 27:46" /><verse number="47" style="v" sid="MAT 27:47" />Sh-niscãntsã di atselji tsi shidea aclo, cãndu lu avdzãrã, dzãsirã: “Aestu ma lji greashti al Elia.” <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Sh-tu atsea oarã, un di atselji s-dusi dalaga, lo un sfungu, lu mulje tu yin acrã shi, dupã tsi lu bãgã tu mãyeaua di un cãlami, lji deadi s-bea. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Ma alantsã dzãtsea: “Alãsats-lu s-videm va yinã Elia s-lu ascapã.” <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />Sh-Isusul aurlã ninga unã oarã cu boatsi analtã, sh-deadi suflitlu. <verse eid="MAT 27:50" /><verse number="51" style="v" sid="MAT 27:51" />Sh-ia, velul a templui s-arupsi pi doauã pãrtsã di nsus pãnã nghios, loclu cutremburã shi shcãnghili s-disicarã, <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />murmintsãlji s-disfeatsirã, sh-multi di trupuri a sãmtsãlor tsi avea murit, s-nyearã. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Elji ishirã dit murmintsã dupã nyearea a Isusului, intrarã tu sãmtul cãsãbã shi s-aspusirã la multsã. <verse eid="MAT 27:53" /><verse number="54" style="v" sid="MAT 27:54" />Tora tsenturionlu sh-atselji tsi deadun cu nãsu vigljea Isusul, cãndu vidzurã cutremburarea sh-atseali tsi s-featsirã, s-aspãrarã multu, sh-dzãsirã: “Dealihea aestu eara Hiljiu a Dumnidzãlui!” <verse eid="MAT 27:54" /><verse number="55" style="v" sid="MAT 27:55" />Aclo eara sh-multi muljeri tsi mutrea di diparti. Eali avea urmatã Isusul di Galilea tsi s-lji huzmitipsea. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Namisa di nãsi eara Maria Magdalena, Maria, muma al Iacov sh-al Iosif, sh-muma a hiljilor al Zebedeu.<verse eid="MAT 27:56" /></para>
  <para style="s1">Ngruparea al Isus</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Sh-cum ntunicã, vini un om avut di Arimatea, cu numa Iosif, cai eara sh-nãsu uceniclu al Isus. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Elu s-dusi la Pilatlu sh-lji cãftã truplu al Isus. Atumtsea Pilatul deadi ordin tsi s-lj dãdea truplu. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Sh-Iosiful, dupã tsi lu lo truplu lu anvãrti cu unã pãndzã curatã <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />sh-lu bãgã tu murmintul atsel noulu, tsi elu avea disfaptã tu un cheatrã. Deapoea arucuti unã cheatrã mari tu intrata a murmintului, sh-fudzi. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Sh-Maria Magdalena sh-alanta Marii shidea aclo, nãintea a murmintului. <verse eid="MAT 27:61" /><verse number="62" style="v" sid="MAT 27:62" />Sh-tu alantã dzuã, tsi eara dupã dzua a adãrariljei, mãrlji a preftsãlor sh-Fariseilji s-adunarã la Pilatul, <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />dzãcãnda: “Doamne, nã adusim a minti cã atsel arãditor, cãndu eara yiu, dzãsi: ‘Dupã trei dzãli mini va mi nyedz.’ <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Trã atsea dã ordin tsi murmintul si s-veaglji ghini pãnã tu dzua a treia, s-nu yinã ucenitsilji a lui noaptea shi s-lu furã truplu sh-deapoea s-lji dzãcã a popului: ‘Si-sculã dit mortsã,’ sh-ashã arãdearea di ma napoea, va s-eara ma arãu di atsea di ma nãinti.” <verse eid="MAT 27:64" /><verse number="65" style="v" sid="MAT 27:65" />Pilatlu lji dzãsi a lor: “Vigljitorlji lã avets, dutsets-vã shi siguripsits-lu, cum vã si veadi ma ghini.” <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Sh-elji s-dusirã sh-lu siguripsirã murmintul, bãgarã vigljitorlji sh-vulusirã cheatra.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">Nyearea</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Tu bitisita a Sãmbãtãljei, cãndu ma apirea prota dzuã a stãmãnãljei, Maria Magdalena sh-alantã Marii s-dusirã s-videa murmintul. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />Sh-ia s-featsi un mari cutrembur, sh-un anghil a Domnului dipusi dit tser, vini sh-arucuti cheatra di la intrata a murmintului shi shidzu pri nãsã. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Videarea a lui eara ca ascãpirarea sh-nvishtearea a lui albã ca neaua. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Sh-di frica a lui, vigljitorlji trimurarã sh-armasirã ca mortsã, <verse eid="MAT 28:4" /><verse number="5" style="v" sid="MAT 28:5" />ma anghilu lã dzãsi a muljerilor: “S-nu avets fricã, cã mini shtiu cã voi cãftats Isusul, tsi s-crutsisi. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Elu nu easti aoa, cã s-nyie, dupã cum vã avea dzãsã. Yinitsã, s-videts loclu iu eara bãgatã Domnul. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Dutsets-vã trãoarã sh-dzãtsets a ucenitsilor a lui cã elu s-nyie dit mortsã. Sh-ia, ma neadzi nãintea a voastrã tu Galilea. Aclo va lu videts. Ia, vã-u aspush.” <verse eid="MAT 28:7" /><verse number="8" style="v" sid="MAT 28:8" />Eali, s-dipãrtarã trãoarã di la murmintul cu fricã sh-cu harauã marii, shi s-dusirã trãoarã s-dutsea hãbarea la ucenitsilji a lui. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Niashtiptat Isusul lã ishi nãinti sh-lã dzãsi: “Sãnãtati!” Atumtsea eali s-apruchearã, lji acãtsarã cicioarili, shi si ncljinarã. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Atumtsea Isusul lã dzãsi a lor: “S-nu avets fricã, dutsets-vã dzãtsets a fratsilor a melji tsi s-ducã tu Galilea sh-aclo va mi veadã.”<verse eid="MAT 28:10" /></para>
  <para style="s1">Hãbãrsirea Nialihioasã a Suldatsilor</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Dupã tsi elji ma s-dutsea, niscãntsã di vigljitorlji, agiumsirã tu cãsãbã sh-dzãsirã la mãrlji a preftsãlor tuti atseali tsi eara faptã. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Atumtsea aeshti featsirã plan cu aushlji sh-apofãsirã s-lã da a suldatsilor multsã pãradzi, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />dzãcãnda a lor: “Dzãtsets: ‘Ucenitsilji a lui vinirã noaptea sh-lu furarã truplu, cãndu noi durnjeam.’ <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Sh-macã aestã va lu avdã guvernatorlu, noi va lu cãndãrsim atsel, sh-va lu fãtsem tsi voi s-nu avets mirachi.” <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />Sh-elji loarã pãradzli sh-featsirã ashã cum lji nvitsarã, sh-aestu zbor s-arãspãndi la Iudeilji pãnã tu dzua di azã.<verse eid="MAT 28:15" /></para>
  <para style="s1">Fãnirusirea al Isus tu Galilea</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Deapoea di unsprãdzatsi ucenitsi s-dusirã tu Galilea, tu muntili atsel iu avea dimãndatã Isusul, <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />sh-cãndu lu vidzurã, si ncljinarã, ma niscãntsã si ndoirã. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Deapoea Isusul s-apruche, sh-lã dzãsi a lor: “A njia nji si easti datã cathi puteari tu tser sh-pri loc. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Dutsets-vã sh-nvitsats ucenitsi di tuti fãrili, pãtidzãnda tu numa a Tatãlui, sh-a Hiljilui sh-a Sãmtului Duh, <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />shi s-nveatsã s-facã tuti aesti tsi mini am dimãndatã. Sh-ia, mini escu cu voi tuti dzãlili, pãnã tu bitisita a etiljei.”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>