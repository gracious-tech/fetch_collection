<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- Aromanian Frasherot</book>
  <para style="h">Uvreilji</para>
  <para style="toc1">Epistola Cãtrã Uvreilji</para>
  <para style="toc2">Uvreilji</para>
  <para style="toc3">Uvr</para>
  <para style="mt1">Epistola Cãtrã Uvreilji</para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="s1">Hristos, Hiljiu al Dumnidzãu ma Mari Dicãt Anghilji</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />Dumnidzãlu lã zburã di cu ntãnjea a strãushilor a noshtri di multi ori sh-tu multi soi prit prufitsilji. <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />Tu dzãlili di soni nã grãi prit Hiljiu, cai l-bãgã mushtinitor a tuti lucrilor sh-prit nãsu adrã tutã dunjeaua. <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />Hiljilu hinda strãlutsirea a mãririljei sh-urma a hintsãljei a Dumnidzãlui, tsãni tuti aesti prit fuchia a zborlui a lui. Cum featsi spãstrirea a amãrtiilor, elu shidzu tu nandreapta a Mãreatsiljei tu anãltsãnji. <verse eid="HEB 1:3" /><verse number="4" style="v" sid="HEB 1:4" />Hiljiu s-featsi multu ma analtu di anghilji sh-numa tsi mushtini easti ma multumãritã dicãt elji.<verse eid="HEB 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 1:5" />Cã a cui di anghilji lji dzãsi vãrãoarã: “Tini eshti Hiljiu a meu! Mini azã ti am amintat”?<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="PSA 2:7">Ps 2:7</ref>.</char></note></para>
  <para style="p" vid="HEB 1:5">Sh-dinou:</para>
  <para style="q1" vid="HEB 1:5">“Mini va lji hiu Tatã sh-elu va nji hibã Hiljiu”?<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="2SA 7:14">2 Sam 7:14</ref>; <ref loc="1CH 17:13">1 Cro 17:13</ref>.</char></note><verse eid="HEB 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 1:6" />Sh-dinou, cãndu Dumnidzãlu s-lu pitreac protlu-amintat tu dunjeauã, dzãtsi:</para>
  <para style="q1" vid="HEB 1:6">“S-lu alavdã tuts anghilji a Dumnidzãlui.”<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="DEU 32:33">Deut 32:33</ref>.</char></note><verse eid="HEB 1:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="HEB 1:7" />Iarã trã anghilji dzãtsi:</para>
  <para style="q1" vid="HEB 1:7">“Elu lã fatsi anghilji a lui ca vimturi,</para>
  <para style="q2" vid="HEB 1:7">sh-huzmichearlji a lui ca fleaca di foc.”<note caller="-" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="PSA 104:4">Ps 104:4</ref>.</char></note><verse eid="HEB 1:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 1:8" />Trã Hiljilu a lui elu dzãtsi:</para>
  <para style="q1" vid="HEB 1:8">“Thronlu a tãu, Dumnidzale,</para>
  <para style="q2" vid="HEB 1:8">easti tu eta a etilor,</para>
  <para style="q1" vid="HEB 1:8">shi schiptrul a ndriptatiljei</para>
  <para style="q2" vid="HEB 1:8">easti schiptrul a amirãriljei a ta.<verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />Ai vrutã ndriptatea sh-ai auratã anapudiiljea,</para>
  <para style="q2" vid="HEB 1:9">trã aestã Dumnidzãlu, Dumnidzãlu a tãu,</para>
  <para style="q2" vid="HEB 1:9">ti aumsi cu untulemnul a harauãljei pristi sotslji a tãlji.”<note caller="-" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="PSA 45:6">Ps 45:6</ref>,<ref loc="PSA 45:7">7</ref>.</char></note><verse eid="HEB 1:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="HEB 1:10" />Shi:</para>
  <para style="q1" vid="HEB 1:10">“Tini Doamne tu apãrnjitã ai thimiljeatã loclu,</para>
  <para style="q2" vid="HEB 1:10">sh-faptili a mãnjilor a tali suntu tserurili.<verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />Eali va chearã, iarã tini va armãnji.</para>
  <para style="q2" vid="HEB 1:11">Tuti ca stranjiu va s-nvicljeadzã.<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />Tini va li adunji ca un stranjiu</para>
  <para style="q2" vid="HEB 1:12">sh-va s-alãxeascã,</para>
  <para style="q1" vid="HEB 1:12">iarã tini eshti idyiul,</para>
  <para style="q2" vid="HEB 1:12">sh-anjili a tali nu va bitiseascã pute.”<note caller="-" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="PSA 102:25-27">Ps 102:25-27</ref>.</char></note><verse eid="HEB 1:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13" />Cã a cui di anghilji lji ari dzãsã vãroarã:</para>
  <para style="q1" vid="HEB 1:13">“Shedz tu nandreapta a mea</para>
  <para style="q2" vid="HEB 1:13">pãnã-cãndu s-li bagã dushmanjlji a tãlji</para>
  <para style="q2" vid="HEB 1:13">ca ashtirnut la cicioarili a meali”?<note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Ps 110:1</ref>.</char></note><verse eid="HEB 1:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="HEB 1:14" />Vahi nu suntu tuts duhuri tsi huzmitipsescu, pitricuts trã huzmitipsiri trã buna atsilor cai va mushtineadzã ascãparea?<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s1">Prihãbãrsirea tra s-nu Arnisim Ascãparea</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />Trã aestã noi prindi s-bãgãm mintea ma multu la atseali tsi avdzãm tra s-nu chirem tsiva cala. <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />Cã, macã zborlu dzãsã prit anghilji, ishi s-hibã niminat, sh-itsi cãlcari a legiljei icã niascultari lo arãsplatã ndreaptã, <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />cum va lj-fudzim noi a giudicatãljei, ma s-nu bãgãm mintea la unã ascãpari ahãnt mari? Aestã ascãpari, ashãtsi cum s-aspusi di ma nãinti prit Domnul, nã si alihipsi di atselji tsi u-avdzãrã. <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />Tu oara aestã Dumnidzãlu mãrtirsea cum prit seamni, cum prit thavmati sh-cu faptili a fuchiiljei sh-cu mpãrtsãrili a doarurilor a Duhlui Sãmtu dupã vrearea a lui.<verse eid="HEB 2:4" /></para>
  <para style="s1">Isusul, Calea ti Ascãpari</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />Dumnidzãlu nu u-sumbãgã a anghililor lumea tsi va yin, trã cai ma zburãm. <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />Iuva tu Scrituri s-mãrtirseashti:</para>
  <para style="q1" vid="HEB 2:6">“Tsi easti omlu tsi lu aduts aminti,</para>
  <para style="q2" vid="HEB 2:6">icã tsi easti hiljiu a Omlui tsi s-ai cãshtigã trã nãsu?<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />Tini lu fãtsesh atsel di putsãn chiro niheamã ma njic dicãt anghilji,</para>
  <para style="q2" vid="HEB 2:7">cu mãriri sh-cu tinjii l-ncurunashi.<verse eid="HEB 2:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 2:8" />Tuti li sumbãgash la cicioarili a lui.”<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="PSA 8:4-6">Ps 8:4-6</ref>.</char></note></para>
  <para style="m" vid="HEB 2:8">Cãndu Dumnidzãlu li sumbãgã tuti sum cicioarili a lui, elu nu alãsã tsiva ni sumbãgatã. Ma tora nu videm ninga, cã a lui lji suntu sumbãgats tuts. <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />Ghini-ma, videm atsel cai s-featsi di putsãn chiro niheamã ma njic di anghilji, Isusul, ncurunat cu mãriri sh-cu tinjii trã itia a munduiriljei a moartiljei, prit harul al Dumnidzãu s-ngusta moartea trã caitsido. <verse eid="HEB 2:9" /><verse number="10" style="v" sid="HEB 2:10" />Cã lji lipsea atsilui, trã itia a cui suntu tuti sh-prit cai suntu tuti, tsi, aducãnda multsã hilji shi-hilje tu mãriri, s-perfexioneadzã prit munduiri ahurhitorlu a ascãpariljei a lor. <verse eid="HEB 2:10" /><verse number="11" style="v" sid="HEB 2:11" />Cã atsel tsi sãmtsashti sh-atselji cai suntu sãmtsãsits, suntu tuts dit un, sh-trã atsea nu si arushineadzã s-lji acljeamã frats sh-surãri, <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />dzãcãnda:</para>
  <para style="q1" vid="HEB 2:12">“Va u-dimãndu numa a ta la fratslji shi surãrili a meali</para>
  <para style="q2" vid="HEB 2:12">sh-tu mesea a cuvãndului va ti alavdu.”<note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="PSA 22:22">Ps 22:22</ref>.</char></note><verse eid="HEB 2:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13" />Sh-adãvgã:</para>
  <para style="q1" vid="HEB 2:13">“Mini va pistipsescu tu nãsu.”<note caller="-" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="ISA 8:17">Isa 8:17</ref>.</char></note></para>
  <para style="m" vid="HEB 2:13">Sh-nãpoi adãvgã:</para>
  <para style="q1" vid="HEB 2:13">“Ia, mini sh-cilimenjlji tsi nji deadi Dumnidzãlu.”<note caller="-" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="ISA 8:18">Isa 8:18</ref>.</char></note><verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />Trã atsea, metsi cilimenjlji au idyiul sãndzi sh-trup sh-elu tutashã fu pãrtashi tu idyili lucri, cu nãeti tsi prit moartea s-afãniseascã atsel cai ari putearea a moartiljei, va s-dzãcã draclu, <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />shi s-lji sãlãghea tuts atselji tsi di frica a moartiljei eara tu sclãyii trã tutã bana. <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />Cã sigur elu nu da agiutari trã anghilji, ma da agiutari trã dupãyinitura al Abraham. <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />Trã aestã elu prindea s-lji undzea a fratsilor tu tuti, tra s-fãtsea arhipreftul njilãos sh-pistimen tu atseali lucri tsi au s-fac cu Dumnidzãlu tra s-arãsplãteascã amãrtiili a lumiljei. <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />Cã metsi elu trapsi cãndu s-cãrti, poati s-agiutã atselji cai s-cãrtescu.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s1">Hristos ma Mari Dicãt Moisiu</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />Trã aestã, frats sh-surãri sãmtsã, pãrtashi la acljimarea tsereascã, bãgats mintea la apostulu sh-la arhipreftul a mãrtirsiriljei a noastrã, la Isus. <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />Elu eara pistimen cãtrã atsel tsi lu featsi ashã cum easti sh-Moisiu tu casa al Dumnidzãu. <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />Isusul easti axiu cu ma multu tinjii dicãt Moisiul, metsi atsel cai adrã casa ari ma multu tinjii di casa tsi elu adrã. <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />Cathi casã s-adari di tsiniva, ma atsel cai li adrã tuti easti Dumnidzãlu. <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />Moisiul dealihea fu pistimen tu tutã casa al Dumnidzãu ca huzmichear, trã mãrtiria atsilor lucri tsi prindea s-dzãtsea, <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />ma Hristolu easti pistimen ca Hiljiu pristi casa a lui sh-casa a lui him noi, ma s-tsãnem cutedzlu sh-nãdia tu cai ni alãvdãm.<verse eid="HEB 3:6" /></para>
  <para style="s1">Dispustusiri ti Populu a Dumnidzãlui</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />Trã atsea, ashã cum dzãtsi Duhlu Sãmtu:</para>
  <para style="q1" vid="HEB 3:7">“Azã, ma avdzãts boatsea a lui,<verse eid="HEB 3:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 3:8" />nu li nchitrits ininjli a voastri</para>
  <para style="q2" vid="HEB 3:8">ca tu rebilipsiri, tu dzua a cãrteariljei tu irnjii,<verse eid="HEB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9" />cãndu pãrintsãlji a voshtri mi bãgarã</para>
  <para style="q2" vid="HEB 3:9">tu provã sitãxinda sh-macã vidzurã faptili a meali<verse eid="HEB 3:9" /></para>
  <para style="q2">
    <verse number="10" style="v" sid="HEB 3:10" />trã patrudzãtsi di anji.</para>
  <para style="q1" vid="HEB 3:10">Tr-atsea mi inãtusii cu aestã farã sh-dzãshã:</para>
  <para style="q2" vid="HEB 3:10">‘Totãna cher tu inima a lor</para>
  <para style="q2" vid="HEB 3:10">sh-elji nu li cunuscurã cãljurili a meali.’<verse eid="HEB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11" />Ashã cum mi giurai tu inatea a mea:</para>
  <para style="q2" vid="HEB 3:11">‘Elji nu va intrã pute tu dispustusirea a mea!’”<note caller="-" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="PSA 95:7-11">Ps 95:7-11</ref>.</char></note><verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />Bãgats mintea, frats sh-surãri, tra s-nu s-aflã la vãrã di voi unã inimã arauã sh-nipistimenã, tsi s-dipãrteadzã di Dumnidzãlu atsel yiulu. <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />Ma ghini incurajats un-alantu cathi dzuã, pãnã cãndu s-dzãtsi aestã “azã”, tra s-nu nchitreascã vãrã di voi di arãdearea a amãrtiiljei. <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />Cã him faptsã urtatsi a Hristolui, macã va u tsãnem niminat pãnã tu soni cãndãrsirea a ahurhitãljei, <verse eid="HEB 3:14" /><verse number="15" style="v" sid="HEB 3:15" />iarã s-dzãtsi:</para>
  <para style="q1" vid="HEB 3:15">“Azã, ma s-avdzãts boatsea a lui,</para>
  <para style="q2" vid="HEB 3:15">nu nchitrits ininjli a voastri</para>
  <para style="q2" vid="HEB 3:15">ca tu dzua a rebilipsiriljei.”<note caller="-" style="x"><char style="xo" closed="false">3:15 </char><char style="xt" closed="false"><ref loc="PSA 95:7-10">Ps 95:7-10</ref>.</char></note><verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />Cã, cai furã atselji tsi, cãndu avdzãrã s-rebilipsirã? Nu furã atselji cai ishirã dit Eghyptu prit Moisiu? <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />Sh-cu cai s-inãtusi trã patrudzãtsi di anji? Vahi, nu cu atselji cai amãrtisirã, cufumli a cãror cai cãdzurã tu irnjii? <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />Sh-trã cai s-giurã cã nu va intrã tu dispustusirea a lui, mash trã atselji cai furã nicãndãrsitsi? <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />Ashãtsi, videm cã elji nu puturã s-intrã trã itia a nipistipsiriljei.<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />Trã atsea, metsi armãni un tãxiri tra s-intrã tu dispustusirea a lui, s-avem fricã cã, nacã vãrã di voi armãni nafoarã. <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />Cã sh-a noauã nã si easti dimãndatã bunã-hãbarea ashãtsi di cum sh-a lor, ma trã elji nu avu axii zborlu tsi avdzãrã, cã nu si mpriunarã prit pistea cu atselji tsi lu avdzãrã. <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />Noi tsi pistipsim intrãm tu dispustusiri, ashã cum Dumnidzãlu ari dzãsã:</para>
  <para style="q1" vid="HEB 4:3">“Cum mi giurai tu inatea a mea:</para>
  <para style="q2" vid="HEB 4:3">‘Nu va intrã pute tu dispustusirea a mea.’”<note caller="-" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="PSA 95:11">Ps 95:11</ref>.</char></note></para>
  <para style="m" vid="HEB 4:3">Cu tutã cã faptili a lui s-bitisirã di tu adrarea a lumiljei. <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />Cã elu ari dzãsã tu un loc ashãtsi anvãrliga di dzua a shaptea: “Sh-Dumnidzãlu dispustusi tu dzua a shaptea di tuti faptili a lui.” <verse eid="HEB 4:4" /><verse number="5" style="v" sid="HEB 4:5" />Sh-dinou tu aestu loc dzãsi: “Nu va intrã pute tu dispustusirea a mea!”<note caller="-" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="PSA 95:11">Ps 95:11</ref>. </char></note><verse eid="HEB 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 4:6" />Trã atsea, armãni tsi niscãntsã va intrã tu atsea dispustusiri, iarã atselji cai loarã buna-hãbari ma nãinti nu intrã trã itia a niascultariljei. <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />Dumnidzãlu apofãseashti unã dzuã, “Azã”, dzãcãnda cu gura al David dupã multu chiro, ashã cum s-dzãsi di ma nãinti:</para>
  <para style="q1" vid="HEB 4:7">“Azã, ma s-avdzãts boatsea a lui,</para>
  <para style="q2" vid="HEB 4:7">s-nu li nchitrits ininjli a voastri.”<note caller="-" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="PSA 95:7">Ps 95:7</ref>,<ref loc="PSA 95:8">8</ref>.</char></note><verse eid="HEB 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8" />Cã macã Iosueu lã featsi atselji s-dispustuseascã, Dumnidzãlu nu va grea dupã aesti lucri ti unã altã dzuã. <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />Ashãtsi armãni un dispustusiri di Sãmbãta trã populu al Dumnidzãu, <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />cã atsel cai intrã tu dispustusirea a lui dispustusi sh-elu idyiul di faptili a lui, ashãtsi di cum featsi sh-Dumnidzãlu. <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />S-nã cupãsim, trã intrari tu atsea dispustusiri tra s-nu cadã vãrã tu idyiul urnechi a niascultariljei.<verse eid="HEB 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12" />Zborlu a Dumnidzãlui easti yiu sh-lucrutor, sh-ma struxitã di itsi spatã cu doauã tãljituri, shi si pitrundi pãnã tu dispãrtsarea a suflitlui sh-a duhlui, a noadilor sh-a mãduuãljei, sh-poati s-giudicã minduirili sh-vrearili a inimãljei. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />Sh-nu ari fãpturã ascumtã nãintea a lui, ma tuti lucrili suntu aspusã sh-discupiriti tu ocljilji atsilui a cui noi va lji dãm lugurii.<verse eid="HEB 4:13" /></para>
  <para style="s1">Hristos, Arhipreftu a Nostru Njilãos</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />Ashãtsi avãnda un arhipreftu mari cai ari strãbãtutã tserurili, Isusul, Hiljiu al Dumnidzãu, s-tsãnem ghini mãrtiria a noastrã. <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />Cã noi nu avem un arhipreftu tsi nu tradzi deadun cu noi tu slãbintsãli a noastri, ma un cai ari fut cãrtit la tuti unã soi ca noi, ma tsi nu amãrtisi. <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />S-nã apruchem cu curaiu di thronlu a harului, tra s-lom njilã shi s-aflãm har trã agiutari tu chirolu tsi prindi.<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />Cã cathi arhipreftu cai s-ljea di la oaminjlji, s-arãdãpseashti trã oaminjlji la atseali lucri cai au s-facã cu Dumnidzãlu, trã adutseari doari sh-curbãnsiri trã amãrtiili. <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />Elu easti ti cãdãri s-aspunã njilã trã atselji cai suntu nishtiuts sh-arãshi cã sh-elu idyiul si sumbãgã a slãbintsãljei, <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />sh-trã aestã slãbintsã elu easti strimtu s-aducã curbãnji trã amãrtiili, cum trã populu, ashãtsi sh-trã nãsu idyiul. <verse eid="HEB 5:3" /><verse number="4" style="v" sid="HEB 5:4" />Sh-vãrã nu u ljea singur aestã tinjii, ma u ljea cãndu easti acljimat di la Dumnidzãlu, ashã di cum sh-Aaron.<verse eid="HEB 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 5:5" />Ashã sh-Hristolu nu s-multumãri singur tra si s-facã arhipreftu, ma fu Elu cai lji dzãsi:</para>
  <para style="q1" vid="HEB 5:5">“Tini eshti Hiljiu a meu!</para>
  <para style="q2" vid="HEB 5:5">Mini azã ti am amintat.”<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="PSA 2:7">Ps 2:7</ref>.</char></note><verse eid="HEB 5:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 5:6" />Ashã dzãtsi sh-tu un altu loc:</para>
  <para style="q1" vid="HEB 5:6">“Tini eshti preftu di daima</para>
  <para style="q2" vid="HEB 5:6">dupã arada al Melchisedec.”<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="PSA 110:4">Ps 110:4</ref>.</char></note><verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />Tu chirolu a banãljei a lui umineascã, adusi cu aurlari vãrtoasi sh-cu lãcrinji, cum rugãciunji sh-cum giurãri cãtrã atsel cai poati s-lu ascãpa di moartea shi s-ascultã trã itia a fricãljei cãtrã Dumnidzãlu, <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />cu tutã cã eara hiljiu, nvitsã ascultarea di atseali tsi trapsi. <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />Dupã tsi s-featsi perfectu, s-featsi itii trã ascãpari di daima trã tuts atselji cai lu asculta, <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />sh-numit di la Dumnidzãlu arhipreftu dupã arada al Melchisedec.<verse eid="HEB 5:10" /></para>
  <para style="s1">Prispuneari tra s-nu Alasã Pistea</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />Ti aesti lucri avem multi ti dzãtseari sh-suntu greali ti sitãxiri cu zboari, metsi hits faptã aĝalnitsi ti aduchiri. <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />Cã tora voi cu chirolu prindi s-earats nvitsãtori, cu tutã atsea aveats ananghi ninga s-vã nveats tsiniva nvitsãturili di prota dzãsi di la Dumnidzãlu shi hits tu atsea situati s-avets ananghi ti lapti, nu ti hranã vãrtoasã. <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />Cã caitsido cai bãneadzã cu lapti, nu l-achicãseashti cum prindi zborlu a ndriptatiljei cã easti cilimean. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />Iarã hranea atsea vãrtoasa easti trã mãrlji, trã atselji cai au simtsurili nvitsati trã aduchiri bunili sh-arãli.<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />Trã atsea alãsãnda dinãpoi nvitsãtura di ahurhitã trã Hristolu, s-nidzem cãtrã atsea cai easti ma perfectã fãrã s-bãgãm dinou timeljilu a mitãnjusiriljei di faptili moarti sh-di pistea cãtrã Dumnidzãlu, <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />trã nvitsãtura a pãtedzilor, ti bãgarea prisupru a mãnjilor, ti nyearea a mortsãlor sh-ti giudicata atsea di totãna. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />Sh-aestã va u-fãtsem cu voljea al Dumnidzãu.<verse eid="HEB 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4" />Cã easti niputut trã atselji cai unãoarã s-lunjinarã shi ngustarã doara tsereascã, shi s-featsirã pãrtashi a Duhlui Sãmtu, <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />shi ngustarã bunlu zbor al Dumnidzãu sh-putearea a etiljei tsi yini, <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />sh-cãdzurã tra s-hibã dinou tu mitãnjiusiri, cã elji lu crutsiseascã Hiljilu a Dumnidzãlui dinou trã nãshi sh-lu arushineadzã la tutã dunjaua. <verse eid="HEB 6:6" /><verse number="7" style="v" sid="HEB 6:7" />Loclu tsi soarbi ploaia cãndu da di multi ori pristi nãsu sh-da ierghi ti hãiri trã atselji cai lucreadzã, ljea ghinicuvintarea al Dumnidzãu. <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />Iarã, cãndu da pãljuri shi schinji, easti fãrã hãiri sh-aproapi di blãstem sh-bitisita easti ardeari.<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />Ma, macã zburãm ashãtsi trã voi, multu vruts, him cãndãrsits ti lucri ma buni cai duc tu ascãpari. <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />Cã Dumnidzãlu nu easti nindreptu tra s-agãrsheascã faptul a voastru sh-vrearea tsi aspusitã trã numa a lui cãndu lã huzmitipsit sh-ninga ma lã huzmitipsits a sãmtsãlor. <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />Noi vrem tsi cathiun di voi s-aspunã idyiul zel pãnã tu soni trã agiundzearea ntreagã a sigurantsãljei a nãdiiljei, <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />tra s-nu vã fãtsets aĝalnitsi, ma imitatori atsilor tsi, prit pistea sh-arãvdarea mushtinescu tãxirili.<verse eid="HEB 6:12" /></para>
  <para style="s1">Tãxirili al Dumnidzãlu</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />Cãndu Dumnidzãlu lj-tãxi al Abraham, metsi nu avea vãrã altu ma mari pri cai si giura, s-giurã ti nãsu idyiul,<note caller="-" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="GEN 22:16">Ahr 22:16</ref>.</char></note> <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />dzãcanda: “Fãrã di altã, mini va ti umplu cu ghinicuvintãri multu sh-va ts-multsãscu dupãyinitorlji.”<note caller="-" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="GEN 22:17">Ahr 22:17</ref>.</char></note> <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />Ashãtsi, avãnda arãvdari, Abrahamul agiumsi tãxirea.<verse eid="HEB 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 6:16" />Oaminjlji si giurã la un ma mari, sh-giurarea faptã trã alihipsiri easti bitisita a cathi niachicãsiri. <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />Ashãtsi Dumnidzãlu, vrãnda s-lã aspunã sh-ma multã a mushtinitorilor a tãxiriljei, nialãxirea a nãetiljei a lui, bãgã chifili spigiurarea, <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />tsi prit doauã lucri nialãxiti, tu cai nu poati tsi Dumnidzãlu s-arãdã, noi cai aflãm streahã la elu, s-avem mari curaiu trã acãtsari nãdia cai sta nãintea a noastrã. <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />Aestã nãdii u-avem ca angurã a suflitlui, sigur sh-niminatã, tsi intrã pãnã nãuntru di altar ma nclo di velu. <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />Aclo intrã Isusul ma nãinti di noi trã hãtãrea a noastrã, shi s-featsi arhipreftu di daima dupã arada al Melchisedec.<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s1">Preftul Melchisedec</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />Cã aestu Melchisedec, amirã al Salem, preftu al Dumnidzãu atsilui Multu Analtu, atsel tsi adunã Abrahamul, anda elu ma s-turna di dãrãmarea a amiradzlor, sh-lu ghinicuvãntã,<note caller="-" style="x"><char style="xo" closed="false">7:1 </char><char style="xt" closed="false"><ref loc="GEN 14:17-20">Ahr 14:17-20</ref>.</char></note> <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />sh-aishtui Abrahamu lji deadi un a dzãtsea parti di tuti. Nãinti di tuti, numa a lui, tradus eara “amirãlu a ndriptatiljei”, ma napoea eara shi “amirãlu al Salem”, tsi va s-dzãcã “amirãlu a paciljei.” <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />Fãrã di tatã, fãrã di mumã sh-fãrã di ghenealoghii sh-niavãnda nitsi apãrnjita a dzãlilor sh-nitsi bitisita a banãljei, ma tsi undzea cu Hiljiu al Dumnidzãu, elu armãni preftu di daima.<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />Tora videts cãt di mari easti aestu a cui Abrahamul, patriarhul, lji deadi a dzatsea a pljeashcãljei. <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />Dealihea, atselji di hiljilji al Levi cai ljea priftsãljea, au ordin dupã legea s-ljea a dzatsea di la populu, va s-dzãcã di la fratslji a lor, cu tutã cã au ishit dit truplu al Abraham. <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />Melchisedec tsi nu easti dit fara a lor, ari loatã a dzatsea di la Abraham sh-ari ghinicuvintat atsel cai avea tãxirili. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />Tora fãrã ndoiri ma njiclu easti ghinicuvintat di ma marli. <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />Sh-tu aestã arasti ljea a dzatsea oaminjlji tsi mor, iarã tu atsel arasti ljea a dzatsea atsel cai aspuni cã bãneadzã. <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />Putem s-dzãtsem ashã cã, Levi, atsel cai ljea a dzatsea, prit Abrahamul ari dat a dzatsea, <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />cã eara ninga tu truplu a tatãlui a lui Abraham cãndu elu s-adunã cu Melchisedec.<verse eid="HEB 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />Trã atsea, macã perfectsionarea va eara prit priftsãljea a Levitslor (cã populu pri nãsã u lo legea), tsi ananghi va eara s-yinea un altu preftu dupã arada al Melchisedec sh-nu dupã arada al Aaron? <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />Cã, cãndu s-alãxeashti priftsãljea, neapãrat s-fatsi sh-alãxirea a legiljei. <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />Cã atsel trã cai suntu dzãsi aesti lucri, easti di unã altã soi, di la cai vãrã nu lji ari huzmitipsit a altarlui. <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />Cã si shti cã Domnul a nostru ari ishit dit Iuda, soi trã cai Moisiu nu zburã vãrã oarã ti priftsãljea. <verse eid="HEB 7:14" /><verse number="15" style="v" sid="HEB 7:15" />Aestu lucru s-fatsi ma limpid macã si scoalã un altu preftu dupã undzearea al Melchisedec, <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />cai s-featsi ahtar preftu nu dupã legea a unui ordin a truplui, ma dupã fuchia a unei banã tsi nu s-aspardzi. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />Cã Scritura dzãtsi:</para>
  <para style="q1" vid="HEB 7:17">“Tini eshti preftu di daima</para>
  <para style="q2" vid="HEB 7:17">dupã arada al Melchisedec.”<note caller="-" style="x"><char style="xo" closed="false">7:17 </char><char style="xt" closed="false"><ref loc="PSA 110:4">Ps 110:4</ref>.</char></note><verse eid="HEB 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 7:18" />Cã di unã parti ari un anulari a ordinlui di ma nãinti, trã itia a slãbintsãljei sh-a niufilisiriljei a lui, <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />cã legea nu featsi tsiva perfectã, sh-di alantã parti, easti intrarea a unei nãdii ma bunã, prit cai nã apruchem di Dumnidzãlu.<verse eid="HEB 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20" />Sh-aestã nu s-featsi ni fãrã spigiurari, cã atselji cai suntu faptsã preftsã, suntu faptsã ahtãri ni faptã spigiurarea, <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />iarã elu s-featsi preftu cu spigiurari prit atsel tsi lji dzãsi:</para>
  <para style="q1" vid="HEB 7:21">“Domnul si spigiurã sh-nu va alãxeascã minti:</para>
  <para style="q2" vid="HEB 7:21">‘Tini eshti preftu di daima.’”<note caller="-" style="x"><char style="xo" closed="false">7:21 </char><char style="xt" closed="false"><ref loc="PSA 110:4">Ps 110:4</ref>.</char></note><verse eid="HEB 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 7:22" />Ashãtsi Isusul s-featsi chifili ti unã pisti-ligãturã ma bunã.<verse eid="HEB 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23" />Sh-atselji cai suntu faptsã preftsã, suntu ma multsã la numir dupã cã moartea nu li alãsa preftsã di daima. <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />Ma Isusul cai bãneadzã trã totãna, u ari priftsãljea di daima. <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />Trã aestã itii easti ti cãdãri tsi s-lji-ascapã didip atselji tsi lji s-aproachi al Dumnidzãu prit nãsu, cã totãna bãneadzã tra s-anamiseadzã trã elji.<verse eid="HEB 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26" />Ahtar arhipreftu hãrzãeam sh-noi: sãmtã, fãrã cãbati, nilãvushit, un cai ari fut dispãrtsãtã di amãrtioshlji shi s-anãltsã ma nsus di tseruri. <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />Elu nu ari ananghi cathi dzuã, ca arhipreftsãlji, tsi s-aducã ma nãinti curbãnji trã amãrtiili a lui sh-ma napoi trã atseali a popului, cã aestã u featsi unã oarã sh-di totãna cãndu elu idyiul s-featsi ca curbani. <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />Cã legea arãdãpsi ca arhipreftsã oaminji cai au slãbintsã, iarã zborlu a spigiurariljei, tsi yini dupã Legea, arãdãpsi Hiljiu, cai easti perfectu di daima.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s1">Hristolu, Arhipreftu a Unei Pisti-ligãturi ma Bunã</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />Tora lucrul ma important tsi ma dzãtsem easti aestu: Noi avem un ahtar arhipreftu, cai shidzu tu nandreapta a thronlui a Mãririljei tu tser, <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />huzmichear a Loclui ma Sãmtu sh-a tendãljei alihioasã, cai u sculã Domnul, nu un om. <verse eid="HEB 8:2" /><verse number="3" style="v" sid="HEB 8:3" />Cathi arhipreftu s-arãdãpseashti ti adutseari doari sh-curbãnji, trã aestã lipseashti tsi sh-aestu s-aibã tsiva tra s-aducã. <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />Ashãtsi, macã va eara Elu pri loc, nu va eara vãrã preftu, cã suntu preftsãlji cai aducã doari dupã lege. <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />Aeshti fac unã huzmitipsiri dupã icoana sh-aumbra a lucrilor tsereshti, ashã dupã cum fu dzãsã al Moisiu di la Dumnidzãlu, cãndu eara etimu trã sculari tenda cã: “Mutrea, va li fats tuti dupã modelul tsi s-ts-aspusi tu munti.”<note caller="-" style="x"><char style="xo" closed="false">8:5 </char><char style="xt" closed="false"><ref loc="EXO 25:40">Ex 25:40</ref>.</char></note> <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />Ma tora, Isusul ari loat unã huzmitipsiri ma aleaptã, ahãntu cãt easti misit a unei pisti-ligãturã ma bun, cã easti nthimiljeat pri ma buni tãxiri.<verse eid="HEB 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7" />Cã, macã pisti-ligãtura di prota va eara fãrã cusuri, atumtsea nu va s-cãfta loc di un altu. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />Cã Dumnidzãlu lji vãrgheashti sh-lã dzãtsi:</para>
  <para style="q1" vid="HEB 8:8">“Ia, ma yin dzãlili, dzãtsi Domnul,</para>
  <para style="q2" vid="HEB 8:8">cãndu va fac cu casa al Israel</para>
  <para style="q2" vid="HEB 8:8">sh-cu casa al Iuda unã noauã pisti-ligãturã,<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />nu ca pisti-ligãtura tsi feciu cu pãrintsãlji a lor,</para>
  <para style="q2" vid="HEB 8:9">tu dzua cãndu mini lã acãtsai mãna</para>
  <para style="q2" vid="HEB 8:9">ti scuteari dit loclu al Eghyptu,</para>
  <para style="q1" vid="HEB 8:9">cã elji nu armasirã niminatã la pisti-ligãtura a mea,</para>
  <para style="q2" vid="HEB 8:9">sh-ashãtsi mini lji apãrãtsii,</para>
  <para style="q2" vid="HEB 8:9">dzãsi Domnul.<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />Aestã easti pisti-ligãtura tsi va fac cu casa al Israel</para>
  <para style="q2" vid="HEB 8:10">dupã atseali dzãli, dzãtsi Domnul.</para>
  <para style="q1" vid="HEB 8:10">Va bag legili a meali tu mintea a lor</para>
  <para style="q2" vid="HEB 8:10">sh-va li scriu tu ininjli a lor.</para>
  <para style="q1" vid="HEB 8:10">Va hiu Dumnidzãlu a lor</para>
  <para style="q2" vid="HEB 8:10">sh-elji va hibã populu a meu.<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />Sh-vãrã nu va nveatsã aproapili a lui sh-vãrã fratili a lui dzãcãnda: ‘Cunoashti-l Domnul!’,</para>
  <para style="q2" vid="HEB 8:11">cã tuts va mi cunoascã, di la njiclu, pãnã la marili a lor.<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />Mini va lã ljeartã nindriptãtsili a lor,</para>
  <para style="q2" vid="HEB 8:12">shi trã amãrtiili a lor nu va nji aduc aminti vãrã oarã.”<verse eid="HEB 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13" />Dzãcãnda pisti-ligãtura “noauã”, Dumnidzãlu nviclje atsea di prota, sh-atsea cai s-nvicljeadzi sh-ausheashti easti ningã chireari.<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s1">Curbãnsita a Hristolui Easti Un sh-Perfectu</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />Sigur cã sh-pisti-ligãtura di prota avea reguli ti huzmitipsirea dumnidzeascã sh-tenda sãmtã a loclui. <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />Cã, s-etimãsi unã tendã, atsea di prota iu eara cum shindanlu, ashã sh-measa, sh-bãgarea a pãniljei nãinti. Aestã s-acljima “Loclu Sãmtu.” <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />Sh-dupã velu a doaua eara unã tendã, atsea tsi s-acljima “Sãmta a Sãmtsãlor.” <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />Aclo eara un altar di furii trã timeamã sh-arca a Pisti-ligãturiljei, anvãrligat di tuti pãrtsãli cu furii sh-tu cai eara un cupã di furii. Nãuntru avea manã sh-puleanlu al Aaron tsi avea nciulitã sh-tablili a pisti-ligãturiljei. <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />Prisupru di Arcã eara heruvinjlji a Mãririljei, fãcãnda aumbrã la loclu a arãscumpãririljei. Trã aesti nu va zburãm tora detaliat.<verse eid="HEB 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6" />Tora hinda adrati ashãtsi aesti lucri, tu tenda atsea di prota intra dipriunã preftsãlji fãcãnda huzmitipsirili prifteshti. <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />Tu tenda a doaua intra unã oarã ntru an mash arhipreftul, nu fãrã di sãndzi, cai u-adutsea ti elu sh-ti amãrtiili a popului cai li fãtsea di nishtirea. <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />Duhlu Sãmtu nã spuni aestã: cã cala cãtrã Sãmta a Sãmtsãlor, ninga nu eara fãnurisit, iarã ma stãtea ninga la tenda atsea di prota. <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />Atsea easti icoana di chirolu di tora sh-aspuni cã, doarili sh-curbãnjlji tsi aduc, nu pot s-facã perfectu conshtintsa atsilor cai facã huzmitipsirea dumnidzeascã. <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />Atselji au s-facã mash cu mãcãri, cu biuturi, cu aspilari soi di soi sh-cu reguli di nafoarã a truplui, arãdãpsiti pãnã tu chirolu di un ordin ndreptu.<verse eid="HEB 9:10" /></para>
  <para style="s1">Sãndzili al Hristos</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />Ma Hristolu cãndu vini ca arhipreftu a bunãtãtsilor tsi vinirã, prit unã tendã ma mari sh-ma perfectã, nu faptã cu mãna, va s-dzãcã nu aishtei fãpturi, <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />sh-nu prit sãndzili a tsachilor sh-a yitsãljilor, ma prit sãndzili a lui, intrã unã oarã sh-ti totãna tu Sãmta a Sãmtsãlor amintãnda unã arãscumpãrari di daima. <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />Cã, macã sãndzili a tsachilor sh-a dãmaljilor, sh-cinusha a unei yitsauã pruscuteashti atselji cai suntu lãvushitsi, lji sãmtsashti trã chischinipsirea a truplui, <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />ahãntu ma multu sãndzili a Hristolui, cai prit Duhlu di daima s-curbãnsi ni fãrã amãrtii a Dumnidzãlui, va chischinipseadzã conshtintsa a voastrã di faptili atseali moarti trã huzmitipsirea a Dumnidzãlui atsilui yiu.<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />Trã aestã elu easti misitlu a unei pisti-ligãturã noauã, cu nãeti cã, metsi undzi unã moarti trã arãscumpãrarea di cãlcãrili tsi s-featsirã tu pisti-ligãtura di prota, atselji acljimatslji s-ljea tãxirea a mushtiniriljei eternã. <verse eid="HEB 9:15" /><verse number="16" style="v" sid="HEB 9:16" />Cã aclo iu easti un testamentu, prindi s-alihipseascã moartea atsilui tsi featsi testamentul. <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />Cã un testamentu easti axiu cãndu oaminjlji au moartã, cã nu ari fuchii cãndu ninga bãneadzã atsel tsi fatsi testamentul. <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />Trã atsea sh-prota pisti-ligãturã nu s-alihipsi fãrã di sãndzi. <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />Cã, cãndu s-dimãndarã a tut popului tuti ordinli di la Moisiu, luãnda sãndzili a yitsãljilor sh-a tsachilor, deadun cu apã sh-cu lãnã roshi apreasã sh-cu hisop, elu pruscuti sh-cartea sh-tut populu.<note caller="-" style="x"><char style="xo" closed="false">9:19 </char><char style="xt" closed="false"><ref loc="EXO 24:3">Ex 24:3</ref>,<ref loc="EXO 24:6-8">6-8</ref>.</char></note> <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />Ashãtsi elu dzãsi: “Aestu easti sãndzili a pisti-ligãturiljei, tsi ordinã trã voi Dumnidzãlu.”<note caller="-" style="x"><char style="xo" closed="false">9:20 </char><char style="xt" closed="false"><ref loc="EXO 24:8">Ex 24:8</ref>. </char></note> <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />Tutashã, elu pruscuti cu sãndzi sh-tenda sh-tuti vasili ti huzmitipsiri. <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />Dupã legea, aproapi tuti lucrili s-chischinipsescu cu sãndzi, sh-fãrã virsarea a sãndzilui nu ari ljirtari.<verse eid="HEB 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />Prindea tsi copilji a lucrilor tsi suntu tu tser si chischinipseadzã prit aesti curbãnsiri, iarã lucrili tsereshti prit curbãnsiri ma buni di aesti. <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />Cã Hristolu nu intrã tu Sãmta a Sãmtsãlor adrat di mãna, tsi easti icoana a atsiljei alihioasã, ma tamam tu tser tra s-fãniruseascã tora nãintea a Dumnidzãlui trã noi. <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />Hristolu nu intrã si s-curbãnseascã di multi ori, ashãtsi dupã cum intrã arhipreftul la Sãmta a Sãmtsãlor cathi an cu sãndzi tsi nu easti a lui, ma a prãvdzãlor, <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />cã va prindea tsi Hristolu va s-munduea di multi ori di tu thimiljiusirea a etiljei. Ma tora tu bitisita a etilor, mash unã oarã easti fãnirusitã trã ashtirdzearea a amãrtiiljei prit curbãnsirea a lui. <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />Dupã cum easti apofãsitã ti oaminjlji tra s-moarã mash unã oarã, sh-dupã aestã yini giudicata, <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />ashãtsi sh-Hristolu, cum s-curbãnsi unã oarã ti amãrtiili a multsãlor, va si aspunã di a doaua oarã, fãrã di amãrtii trã atselji tsi lu ashteaptã ti ascãpari.<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="s1">Curbãnsirea al Hristos Unãoarã sh-trã Tuts</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />Legea easti aumbra a bunilor tsi yin, sh-nu suntu lucrili alihioasi, cã nu poati pute tsi cu idyili curbãnsiri, cai li aduc cathi an dipriunã, s-perfexioneadzã atselji cai s-aproachi a Dumnidzãlui. <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />Aljumtrea va avea dãnãsit curbãnsirea, cã atselji cai aduc curbãnji metsi eara curats unã oarã, nu va avea vãrã conshtintsã ti amãrtiili a lor. <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />Ma la atseali curbãnsiri cathi an s-aduc aminti amãrtiili, <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />cã easti niputut tsi sãndzili dãmaljilor sh-a tsachilor s-ashteargã amãrtiili. <verse eid="HEB 10:4" /><verse number="5" style="v" sid="HEB 10:5" />Trã atsea, intrãnda tu lumi Hristolu dzãtsi:</para>
  <para style="q1" vid="HEB 10:5">“Curbãnsiri sh-doari nu vrushi,</para>
  <para style="q2" vid="HEB 10:5">ma un trup nji etimãsishi.<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />Scrumãri sh-curbãnsiri trã amãrtia nu ti arsirã.<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />Atumtsea dzãsh: ‘Ia, ma yin, Dumnidzale,</para>
  <para style="q2" vid="HEB 10:7">ti fãtseari vrearea a ta,</para>
  <para style="q2" vid="HEB 10:7">di cum easti scriat tu pergamenã trã mini.’”<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="PSA 40:6-8">Ps 40:6-8</ref>.</char></note><verse eid="HEB 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 10:8" />Ma nsus dzãtsi: Curbãnsiri sh-doari, shi scrumãri sh-curbãnsiri ti amãrtii, tsi s-da dupã legea, nu vrushi sh-nu arsishi. <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />Deapoea elu adãvgã: “Ia ma yin s-fac vrearea a ta.”<note caller="-" style="x"><char style="xo" closed="false">10:9 </char><char style="xt" closed="false"><ref loc="PSA 40:6-8">Ps 40:6-8</ref>.</char></note> Elu arucã nclo protlu tra s-bagã a doaua. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />Di aestã vreari him sãmtsãsits, prit curbãnsirea a truplui al Isus Hristos, tsi s-featsi unã oarã sh-ti totãna. <verse eid="HEB 10:10" /><verse number="11" style="v" sid="HEB 10:11" />Dealihea, cathi preftu sta pri cicioari cathi dzuã aducãnda huzmitipsiri sh-di multi ori idyili curbãnsiri, cai nu pot pute s-mut amãrtiili. <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />Iarã Hristolu, aducãnda mash unã curbãnsiri di totãna trã amãrtiili, shidzu tu na ndreapta a Dumnidzãlui, <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />ashtiptãnda pãnã cãndu si bagã dushmanjlji a lui ca scamnu la cicioarili a lui. <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />Cã, mash cu unã curbãnsiri elu perfectsioneadzi di totãna atselji cai ma si sãmtseascã. <verse eid="HEB 10:14" /><verse number="15" style="v" sid="HEB 10:15" />Ma, a noauã nã-u mãrtirseashti sh-Duhlu Sãmtu, tsi ari dzãsã:<verse eid="HEB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />“Aestã easti pisti-ligãtura tsi va fac cu elji</para>
  <para style="q2" vid="HEB 10:16">dupã atseali dzãli, dzãsi Domnul,</para>
  <para style="q1" vid="HEB 10:16">va li bag legili a meali tu ininjli a lor</para>
  <para style="q2" vid="HEB 10:16">sh-va li scriu tu mintili a lor.”<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="JER 31:33">Ier 31:33</ref>.</char></note><verse eid="HEB 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 10:17" />Deapoea adãvgã:</para>
  <para style="q1" vid="HEB 10:17">“Amãrtiili sh-anapudiilji a lor</para>
  <para style="q2" vid="HEB 10:17">nu va li aduc aminti vãrã oarã.”<note caller="-" style="x"><char style="xo" closed="false">10:17 </char><char style="xt" closed="false"><ref loc="JER 31:34">Ier 31:34</ref>. </char></note><verse eid="HEB 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 10:18" />Sh-iu ari ljirtari aishtor lucri, nu ari ma curbãnsiri trã amãrtii.<verse eid="HEB 10:18" /></para>
  <para style="s1">S-nã Apruchem a Dumnidzãlui Prit Pisti</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />Ashãtsi, frats sh-surãri, avãnda curaiu trã intrari tu Sãmta a Sãmtsãlor prit sãndzili al Isus, <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />prit unã cali noauã sh-yii cai u adrã trã noi prit velu, tsi va s-dzãcã prit truplu a lui, <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />avãnda un mari preftu pristi casa al Dumnidzãu, <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />s-nã apruchem cu inimã curatã cu sigurantsã ntreagã a pistiljei, avãnda ininjli aspilati di conshtintsa atsea araua sh-avãnda truplu aspilatã cu apã limpidã. <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />Ashãtsi, s-tsãnem niminatã mãrtirsirea a nãdiiljei, cã pistimen easti atsel cai tãxi, <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />s-avem angãtan trã un-alantu tra s-dãm curaiu la un-alantu trã vreari sh-trã fapti buni, <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />fãrã s-apãrãtsim adunãrili, ashã cum u-au adetea niscãntsã, ma dãnda curaiu a unui-alantu, sh-ahãntu ma multu cã tora videts Dzua a Domnului tsi ma s-aproachi.<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />Cã, macã noi bãnãm amãrtisinda cu vreari dupã tsi lom cunushtearea ntreagã a alihiljei, nu armãni ma curbãnsiri trã amãrtii. <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />Din contra, nã ashteapti giudicata atsea fricoasa sh-un foc apreasã tsi easti etimu s-ardã atselji tsi ncuntreadzã Dumnidzãlu. <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />Caitsido tsi calcã legea al Moisiu, moari fãrã njilã cu mãrtiria a doi icã trei martirii.<note caller="-" style="x"><char style="xo" closed="false">10:28 </char><char style="xt" closed="false"><ref loc="DEU 19:15">Deut 19:15</ref>.</char></note> <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />Cãt ma greauã condamnã minduits cã va s-axizeascã atsel tsi va calcã Hiljilu al Dumnidzãu sh-nu va tinjiseashti sãndzili a pisti-ligãturiljei cu cai si sãmtsã shi ngiurã Duhlu a harului? <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />Cã noi lu cunushtem atsel tsi dzãsi: “A mea easti arãzgãnarea, mini va s-arãsplãtescu,” sh-adãvgã: “Va lu giudicã Domnul populu a lui.”<note caller="-" style="x"><char style="xo" closed="false">10:30 </char><char style="xt" closed="false"><ref loc="DEU 32:35">Deut 32:35</ref>,<ref loc="DEU 32:36">36</ref>. </char></note> <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />Ti aspãrari easti, s-cadzã tu mãnjili a Dumnidzãlui atsilui yiu.<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />Adutsets aminti dzãlili di ma nãinti, tsi dupã tsi vã lunjinat, arãvdat unã alumtã mari ti multã munduiri. <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />Cãti-vãrãoarã vã featsit pãrãstãsiri trã oaminjlji, cum prit pizuirea, ashã sh-prit munduirea sh-cãti-vãrãoarã vã featsit pãrtashi cu atselji tsi s-munduea unã soi. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />Voi aspusit njilã trã hãpsãnitslji sh-aprucheat cu harauã archirea a aveariljei a voastrã, shtinda cã avets trã voi unã aveari ma bunã cai armãni di totãna. <verse eid="HEB 10:34" /><verse number="35" style="v" sid="HEB 10:35" />Ashãtsi, nu arucats nclo curaiul a vostru, cai ari unã arãsplatã mari. <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />Cã voi avets ananghi trã arãvdari, cu nãeti tsi, dupã cum s-avets faptã vrearea al Dumnidzãu, s-loats tãxirea. <verse eid="HEB 10:36" /><verse number="37" style="v" sid="HEB 10:37" />Cã:</para>
  <para style="q1" vid="HEB 10:37">“Ninga putsãn, multu putsãn,</para>
  <para style="q2" vid="HEB 10:37">sh-atsel tsi prindi s-yin,</para>
  <para style="q2" vid="HEB 10:37">va yin sh-nu va amãn.<note caller="-" style="x"><char style="xo" closed="false">10:37 </char><char style="xt" closed="false"><ref loc="ISA 26:20">Isa 26:20</ref>.</char></note><verse eid="HEB 10:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38" />Sh-ndreptul a meu dit pistea va bãneadzã,</para>
  <para style="q2" vid="HEB 10:38">sh-ma si s-trag nãpoi,</para>
  <para style="q2" vid="HEB 10:38">suflitlu a meu nu va aibã arsiri pri nãsu.”<note caller="-" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="HAB 2:3">Hab 2:3</ref>,<ref loc="HAB 2:4">4</ref>.</char></note><verse eid="HEB 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 10:39" />Ma noi nu him di atselji tsi s-trag nãpoi trã chireari, ma di atselji cai au pisti sh-suntu la ascãpats.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s1">Prit Pisti</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />Tora pistea easti sigurantsa a lucrilor tsi s-nãdãescu, sh-cãndãrsirea trã lucrili cai nu s-ved. <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />Cã prit pisti loarã mãrtirii bunã vecljilji. <verse eid="HEB 11:2" /><verse number="3" style="v" sid="HEB 11:3" />Prit pisti aduchim cã dunjeaua easti adrat prit zborlu al Dumnidzãu, ashãtsi cã, atsea tsi s-veadi nu easti adrat di lucri tsi s-ved. <verse eid="HEB 11:3" /><verse number="4" style="v" sid="HEB 11:4" />Prit pisti Abel lji adusi al Dumnidzãu un curbani ma bun dicãt Cain. Elu prit pisti lo mãrtirii cã easti ndreptu, cãndu Dumnidzãlu mãrtirsi trã doarili a lui. Prit pisti, Abel, cu tutã cã ari murit, zburashti ninga. <verse eid="HEB 11:4" /><verse number="5" style="v" sid="HEB 11:5" />Prit pisti Enocu si strãmutã di aestã banã tra s-nu videa moartea sh-nu si aflã ma, cã Dumnidzãlu u strãmutã. Cã, ma nãinti tsi si strãmuta, avea loat mãrtirii cã lji avea arsit al Dumnidzãu.<note caller="-" style="x"><char style="xo" closed="false">11:5 </char><char style="xt" closed="false"><ref loc="GEN 5:24">Ahr 5:24</ref>. </char></note> <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />Fãrã di pisti easti niputut s-lji ariseshti a Dumnidzãlui, cã atsel tsi lji s-aproachi al Dumnidzãu, prindi s-pistipseascã cã Dumnidzãlu easti sh-arãsplãteashti atselji cai lu caftã. <verse eid="HEB 11:6" /><verse number="7" style="v" sid="HEB 11:7" />Prit pisti, cãndu Noe lo hãbari trã atseali lucri tsi ninga nu s-videa. Elu avãnda frica a Dumnidzãlui, adrã un pampor ti ascãpari casa a lui. Prit pisti elu condamnã lumea shi s-featsi mushtinitor a ndriptatiljei tsi yini prit pistea.<verse eid="HEB 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8" />Prit pisti cãndu s-acljimã Abrahamu, s-cãndãrsi tra si s-ducã cãtrã un loc trã loari mushtinirea sh-fudzi fãrã si shtibã cã iu njidzea. <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />Prit pisti bãnã ca xen la loclu tãxit cum s-eara loc xen, bãnãnda tu tendi deadun cu Isacu sh-cu Iacovu, tsi eara deadun cu nãsu mushtinitori la idyia tãxiri, <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />cã ashtipta cãsãbãlu cu thimelji, architectu sh-adãrãtor a cui easti Dumnidzãlu. <verse eid="HEB 11:10" /><verse number="11" style="v" sid="HEB 11:11" />Prit pisti sh-Sara cai eara stearpã sh-lji avea tricut chirolu a amintariljei, lo fuchii tra s-armãnea greauã, cã u lugursi pistimen atselu tsi lji tãxi. <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />Trã atsea, dit un singur om, sh-aestã dit un om tsi eara ningã moarti, s-amintarã multsã dupãyinitori ca stealili a tserlui sh-ca arina ninumirat tsi easti ningã mealu di amari. <verse eid="HEB 11:12" /><verse number="13" style="v" sid="HEB 11:13" />Tuts aeshti murirã cu pisti, ni loat tãxirili, ma vidzãnda di diparti sh-salutãnda. Elji mãrtirsirã cã suntu xenji sh-tricãtor pri loc. <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />Atselji cai grãiescu ahtãri zboari, aspunã cã caftã unã vãtani. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />Canda, dealihea s-avea tu minti atsea di la cai ishirã, va avea chiro si s-toarnã, <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />ma tora, elji vor unã vãtani ma bunã, va s-dzãcã tsereascã. Trã atsea, a Dumnidzãlui nu lji yini rushãni di elji tsi s-acljeami Dumnidzãlu a lor, cã lã ari etimãsit a lor un cãsãbã. <verse eid="HEB 11:16" /><verse number="17" style="v" sid="HEB 11:17" />Prit pisti Abrahamul, cãndu s-bãgã tu provã, lji deadi ca curbani Isacul, sh-elu cai lo tãxirili, eara etimu s-lji dea hiljiu a lui atsel singurlu, <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />cu tutã cã Dumnidzãlu lj-avea dzãsã: “Dit Isac va s-acljeamã dupãyinitura a ta.” <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />Abrahamul minduea cã Dumnidzãlu eara putut tra s-nyea sh-dit mortsã, ashãtsi s-dzãtsem cã Abrahamul lo hiljlu a lui dit mortsã. <verse eid="HEB 11:19" /><verse number="20" style="v" sid="HEB 11:20" />Prit pisti Isacu ghinicuvãntã Iacovul sh-Esaul trã lucrili tsi va yinã. <verse eid="HEB 11:20" /><verse number="21" style="v" sid="HEB 11:21" />Prit pisti Iacovul, cãndu ma murea, ghinicuvãntã cathiunu di hiljilji al Iosif shi si ncljinã andupirat pri mãyeaua a bãstunlui a lui. <verse eid="HEB 11:21" /><verse number="22" style="v" sid="HEB 11:22" />Prit pisti Iosiful, tu bitisita a banãljei, adusi aminti ishirea a hiljilor di Israel sh-deadi ordin ti oasili a lui.<verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />Prit pisti Moisiu, dupã tsi s-amintã, s-ascumsi ti trei meshi di pãrintsãlji a lui, metsi vidzurã cã cilimeanlu eara mushat sh-nu avurã fricã ordinlu a amirãlui. <verse eid="HEB 11:23" /><verse number="24" style="v" sid="HEB 11:24" />Prit pisti Moisiul, cãndu s-featsi mari, arnisi tsi si s-acljeamã hiljiu a hiljiljei al Faraon. <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />Elu aleapsi si munduea deadun cu populu a Dumnidzãlui, dicãt s-gusta ti shcurtu chiro hãrsirea a amãrtiiljei. <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />Elu u lugursi pizuirea al Hristos ma mari aveari dicãt ayishtearili al Eghyptu, cã mutrea cãtrã arãsplãtirea. <verse eid="HEB 11:26" /><verse number="27" style="v" sid="HEB 11:27" />Prit pisti elu alãsã Eghyptu fãrã fricã di inatea al amirãlu, sh-armasi niminat, cã videa atselu cai eara nividzut. <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />Prit pisti elu sãrbãtori Pashtili shi-pruscutirea a sãndzilui, cu nãeti tsi afãnsitorlu s-nu cãrtea prots-amintatslji al Israel. <verse eid="HEB 11:28" /><verse number="29" style="v" sid="HEB 11:29" />Prit pisti Israelitsi tricurã Amarea atsea Roshea, ca pri un loc uscat, ma cãndu vrurã Eghyptenjlji s-treacã, s-nicarã. <verse eid="HEB 11:29" /><verse number="30" style="v" sid="HEB 11:30" />Prit pisti cãdzurã murili al Ierico, dupã tsi Israelitslji lj-vinirã anvãrliga di shapti dzãli. <verse eid="HEB 11:30" /><verse number="31" style="v" sid="HEB 11:31" />Prit pisti putana Rahaba, nu chiru deadun cu atselji cai eara nicãndãrsitsi, cã ashtiptã spiunjlji cu pace.<verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />Tsi s-dzãc ma? Cã nu va nji agiundzea chirolu si aspuneam trã Ghideonu, trã Barac, trã Samson, trã Yefti, trã David, trã Samuel sh-trã prufitsilji. <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />Prit pisti elji azvimsirã amirãrilji, featsirã ndriptati, agiumsirã tãxirili, astuparã gurili a ljundarilor, <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />asteasirã fuchia a foclui, ascãparã di lipida a spatãljei, dit slaghi s-featsirã vãrtoshi, s-nvãrtushirã tu alumtã sh-azvimsirã oastili atseali xeni. <verse eid="HEB 11:34" /><verse number="35" style="v" sid="HEB 11:35" />Niscãnti muljeri loarã prit nyearea mortsãlji a lor, ma altsã s-tirãnsirã, cã arnisirã ascãparea tra s-agiundzea nyearea ti unã banã ma bunã. <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />Iarã altsã trapsirã pizuiri sh-zãpãliri, meti prãnghi sh-hapsi. <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />S-vãtãmarã cu chetsri, s-tãljearã cu priunã, murirã vãtãmats di spatã, alãgarã nviscuts cu cheali di oi sh-cu cheali di cãpri, hinda tu niaveari, suschirats sh-tirãnsits. <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />Lumea nu eara axiu trã elji. Elji alãgarã prit irnjii, prit muntsã, prit pishtirei sh-prit gãvrili a loclui. <verse eid="HEB 11:38" /><verse number="39" style="v" sid="HEB 11:39" />Tuts aeshti, cu tutã cã loarã mãrtirii prit pisti, ninga nu loarã tãxirea, <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />cã Dumnidzãlu prividzu trã noi tsiva ma bun, tsi elji s-nu agiungã la perfectsiuni fãrã di noi.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="s1">S-Urmãm Exemplu al Hristos</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />Trã atsea sh-noi, hinda anvãrligats di un nior ahãntu mari di martiri, arcãnda nclo itsi greutati sh-amãrtia tsi nã anvãrligheadzã dipriunã, s-alãgãm cu arãvdari la cala tsi avem nãinti, <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />avãnda mutrita cãtrã Isus, apãrnjitorlu sh-mplinãtorlu a pistiljei, cai trã haraua tsi eara nãintea a lui, arãvdã crutsea, dispretsui arushinea shi shidzu tu nandreapta a thronlui a Dumnidzãlui. <verse eid="HEB 12:2" /><verse number="3" style="v" sid="HEB 12:3" />Trã atsea, minduits trã atsel cai arãvdã ahtari ncuntrari di amãrtioshlji pristi nãsu, tra s-nu vã apustusits shi s-vã slãghits tu ininjli a voastri. <verse eid="HEB 12:3" /><verse number="4" style="v" sid="HEB 12:4" />Cã voi ninga nu avets arãvdat pãnã tu sãndzi, alumtãnda contra a amãrtiiljei. <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />Sh-voi avets agãrshat didip zboarili di inimusiri cai Dumnidzãlu vã da ca hilji a lui:</para>
  <para style="q1" vid="HEB 12:5">“Hiljiu a meu, nu u dispretsuea vãrghirea a Domnului</para>
  <para style="q2" vid="HEB 12:5">sh-nu ti nvirinã cãndu ti vãrgheshti di elu,<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />cã, Domnul atsel tsi lu va, lu ndreadzi</para>
  <para style="q2" vid="HEB 12:6">shi zãpãleashti cathiunu cai lu aproachi ca hiljiu a lui.”<note caller="-" style="x"><char style="xo" closed="false">12:6 </char><char style="xt" closed="false">Prov 3:11,12.</char></note><verse eid="HEB 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7" />Macã voi va u arãvdats vãrghirea, Dumnidzãlu va vã mutreascã ca hilji, cã cai easti atsel hiljiu tsi nu lu vãrgheashti tatãl? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />Macã nu va vã vãrghits ashã cum s-vãrgheascã tuts altsãlji, atumtsea hits copilji, nu hits hilji. <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />Sh-macã tinjisim pãrintsãlji a noshtri trupeshti cãndu nã vãrgheascã, nu prindi sh-ninga ma multu s-nã sumbãgãm a Tatãl a nostru suflitescu trã bãnari? <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />Cã dealihea elji nã vãrghirã trã niscãnti dzãli ashã cum minduirã ti ma ghini, iarã elu nã vãrgheashti trã buna a noastrã tra s-nã fãtsem pãrtashi tu sãmtsãljea a lui. <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />Cathi vãrgheari tu ahurhitã, si pari cã nu adutsi harauã, ma nvirinari, iarã deapoea da frutili a paciljei sh-a ndriptatiljei atsilor tsi suntu ndreptsã prit nãsã. <verse eid="HEB 12:11" /><verse number="12" style="v" sid="HEB 12:12" />Trã atsea, nvãrtushits mãnjili atseali curmati sh-dzinucljili atselji slabi. <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />Fãtsets cãrãri ndreapti trã cicioarili a voastri, cu nãeti tsi atsel cai shcljioapi s-nu si s-facã ma arãu, ma si s-vindicã.<verse eid="HEB 12:13" /></para>
  <para style="s1">Acljimari ti Unã Bãnari Sãmtã</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />Fãtsets pace cu caitsido shi sãmtsiri, cã fãrã di ea vãrã nu va veadã Domnul. <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />Bãgats oarã tsi vãrã s-nu armãnã fãrã di harul a Dumnidzãlui, tra s-nu creascã vãrã arãdãtsinã amarã shi s-vã minteascã sh-deapoea s-pãnĝãneascã sh-altsã, <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />tra s-nu hibã vãrã curvar icã anapud ca Esau, cai ti unã mãcari vindu ndreptul a lui prot-amintat. <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />Voi shtits cã sh-ma napoi, cãndu vru s-mushtineadzã ghinicuvintarea, lji si arnisi. Elu nu aflã loc trã mitãnjiusiri, cu tutã cã u cãftã cu lãcrinj. <verse eid="HEB 12:17" /><verse number="18" style="v" sid="HEB 12:18" />Cã voi nu hits aprucheat di muntili cai s-ahuleashti cu mãna shi s-ardi di foc, nitsi di scutidlu, nitsi di negura sh-nitsi di furtuna, <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />nitsi di asunarea a trumpetãljei sh-nitsi di boatsea a zboarilor trã cai atselji tsi li-au avdzãtã, si spigiurarã tra si nu adavgã a lor nitsi un zbor altu. <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />Elji nu putea s-arãvda ordinlu: “Sh-unã pravdã s-ahuleascã muntili, va si s-vatãmã cu cheatrã.”<note caller="-" style="x"><char style="xo" closed="false">12:20 </char><char style="xt" closed="false"><ref loc="EXO 19:12">Ex 19:12</ref>,<ref loc="EXO 19:13">13</ref>.</char></note> <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />Sh-ahãt fricuitoarã eara pãrearea, cãt Moisiu dzãsi: “Escu lãhtãrsit sh-escu trimurãnda.”<note caller="-" style="x"><char style="xo" closed="false">12:21 </char><char style="xt" closed="false"><ref loc="DEU 9:19">Deut 9:19</ref>.</char></note> <verse eid="HEB 12:21" /><verse number="22" style="v" sid="HEB 12:22" />Din contra, voi hits aprucheat di muntili Sion sh-di cãsãbãlu a Dumnidzãlui atsel yiu, di Ierusalemlu atsel dit tser sh-di njilji sh-dzatsi-njilji anghilji di sãrbãtoarea <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />di adunarea a cilimenjilor atsilor prots-amintat, cai suntu scriats tu tseruri, sh-di Dumnidzãlu, giudicãtorlu a tutulor sh-di duhurili a ndreptsãlor cai suntu fapts perfects. <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />Voi hits aprucheat di Isus, misitlu a unei pisti-ligãturã noauã, sh-di sãndzili tsi pruscuteashti, cai zburashti ma ghini di sãndzili al Abel.<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />Bãgats mintea tra s-nu arnisits atsel tsi zburashti! Cã, macã nu lji ascãparã atselji cai arnisirã s-asculta atsel cai hãbãrsea pri loc, ahtãt ma putsãn va ascãpãm noi ma s-lji arnisim atsilui cai hãbãrseashti dit tser. <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />Atumtsea boatsea a lui trundui loclu, iarã tora ari tãxit dzãcãnda: “Ninga unã oarã mini va trunduescu nu mash loclu, ma sh-tserlu.”<note caller="-" style="x"><char style="xo" closed="false">12:26 </char><char style="xt" closed="false"><ref loc="HAG 2:6">Hag 2:6</ref>.</char></note> <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />Sh-aestã “ninga unã oarã” aspuni alãxirea a lucrilor atsilor minati, ca lucri tsi suntu fapti, cu nãeti tsi s-armãnã atseali cai suntu niminati. <verse eid="HEB 12:27" /><verse number="28" style="v" sid="HEB 12:28" />Trã atsea, luãnda un amirãrilji niminatã, s-hãristisim sh-prit aestã s-lji huzmitipsim a Dumnidzãlui cu arsiri, cu alãvdari sh-cu fricã, <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />cã Dumnidzãlu a nostru easti un foc tsi ardi.<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s1">Urnimili di Soni</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />Vrearea frãtseascã s-armãnã ntrã voi. <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />Nu agãrshits ghini-ashtiptarea, cã prit nãsã niscãntsã farã s-shtibã ashtiptarã anghilji. <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />Adutsets aminti hãpsãnitslji, canda s-eara ligats deadun cu elji, sh-atselji cai s-tirãnseascã, metsi sh-voi idyilji avets un trup ca elji. <verse eid="HEB 13:3" /><verse number="4" style="v" sid="HEB 13:4" />Mãrtarea s-hibã tinjisitã di tuts, sh-patlu a mãrtariljei nipãnĝãnit, cã Dumnidzãlu va s-giudicã putãnjsitorlji sh curunã-cãlcatslji. <verse eid="HEB 13:4" /><verse number="5" style="v" sid="HEB 13:5" />Purtarea a voastrã s-hibã nu prit vrearea a pãrãlui, hinda hãristisits cu atsea tsi avets, cã Dumnidzãlu ari dzãsã: “Pute nu va ti alasã sh-nu va ti apãrãtsescu.”<note caller="-" style="x"><char style="xo" closed="false">13:5 </char><char style="xt" closed="false"><ref loc="DEU 31:6">Deut 31:6</ref>.</char></note> <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />Ashãtsi noi, avãnda curaiu s-dzãtsem: “Domnul easti agiutorlu a meu sh-nu va am fricã. Tsi va nji fac omlu?”<note caller="-" style="x"><char style="xo" closed="false">13:6 </char><char style="xt" closed="false">Ps 108:18.</char></note> <verse eid="HEB 13:6" /><verse number="7" style="v" sid="HEB 13:7" />Adutsets aminti mãrlji a voshtri cai vã dimãndarã zborlu a Dumnidzãlui. Mutrits cu cãshtiga bitisita a banãljei a lor sh-urmats pistea a lor. <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />Isus Hristos easti idyiul aieri, azã sh-di tutã eta. <verse eid="HEB 13:8" /><verse number="9" style="v" sid="HEB 13:9" />Nu vã arãdets cu soi di soi di nvitsãturi xeani, cã easti ghini tsi inima si nvãrtusheascã prit harul, nu prit mãcãrili tu cai nu vidzurã hãiri atselji cai alãgarã dupã eali. <verse eid="HEB 13:9" /><verse number="10" style="v" sid="HEB 13:10" />Noi avem un altar tu cai nu au ndreptul s-mãcã atselji cai huzmitipsescu tu tendã. <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />Cã trupurili a nimaljilor atsilor, tsi sãndzili a lor u adutsi trã amãrtii arhipreftul la Sãmta a Sãmtsãlor, s-ardã tuti nafoarã dit cãmpu. <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />Trã atsea sh-Isusul tra si sãmtseascã populu prit sãndzili a lui, s-mundui nafoarã di poarta a cãsãbãlui. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />Ashãtsi, s-ishim la nãsu nafoarã tu cãmpu, tsãnãnda arushinea cai elu tsãnu, <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />cã nu avem aoa un cãsãbã di totãna, ma cãftãm atselu tsi va yinã. <verse eid="HEB 13:14" /><verse number="15" style="v" sid="HEB 13:15" />Prit Isus, s-lji adutsem dipriunã al Dumnidzãu unã curbani di alãvdari, va s-dzãcã frutlu a budzãlor tsi mãrtirsescu<note caller="+" style="f"><char style="fr" closed="false">13:15 </char><char style="ft" closed="false">va s-dzãc sh-alãvdari.</char></note> numa a lui. <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />Sh-nu agãrshits buneatsa sh-mpãrtsãrea cu altsã atsea tsi avets, cã cu ahtãri curbãnji s-hãrseashti Dumnidzãlu.<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />Cãndãrsits-vã a mãrlor a voshtri sh-sumbãgats-vã a lor, cã elji sta dishtiptats pristi suflitli a voastri, ca atselji cai va da lugurii, cu nãeti tra s-u facã aestã cu harauã sh-nu suschirãnda, cã aestã va eara fãrã di ufelii trã voi. <verse eid="HEB 13:17" /><verse number="18" style="v" sid="HEB 13:18" />Rugats-vã trã noi cã him cãndãrsits cã avem conshtintsã bunã, vrãnda s-nã purtãm ghini la tuti lucrili. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />Sh-vã fãtsem rigeai ma multã s-vã rugats cu nãeti tsi cãt ma curundu s-mi tornu la voi.<verse eid="HEB 13:19" /></para>
  <para style="s1">Salutãrili di Soni</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />Tora, Dumnidzãlu a paciljei, atsel cai adusi nsus dit mortsã, Domnul a nostru Isus, Picurarlu atsel marli a oilor, prit sãndzili a pisti-ligãturiljei atsiljei di totãna, <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />s-vã facã axiu la itsi lucru bun, tra s-fãtsets vrearea a lui, fãcãnda tu noi atsea tsi easti arsitã nãintea a lui, prit Isus Hristos, a cui s-lji hibã mãrirea tu eta a etilor. Amin.<verse eid="HEB 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />Tora vã fac rigeai, frats sh-surãri, arãvdats aestu zbor ti curaiu, cã sh-vã scriai pi shcurtu. <verse eid="HEB 13:22" /><verse number="23" style="v" sid="HEB 13:23" />Si shtits cã fratili a nostru Timote easti sãlãghit dit hapsi, sh-macã elu yini curundu, va vã vedu deadun cu nãsu. <verse eid="HEB 13:23" /><verse number="24" style="v" sid="HEB 13:24" />Salutats-lã tuts mãrlji a voshtri sh-tuts populu a Dumnidzãlui. Vã pitrec sãnãtati sh-atselji di Italia. <verse eid="HEB 13:24" /><verse number="25" style="v" sid="HEB 13:25" />Harul s-hibã cu voi tuts!<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>