<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Dũya Translation Project</book>
  <para style="h">Umarku</para>
  <para style="toc1">Isarhe Iyiki Ize iyi Umarku aka atsɛng</para>
  <para style="toc2">Umarku</para>
  <para style="toc3">Umar</para>
  <para style="mt2">Isarhe iyiki Ize iyi</para>
  <para style="mt1">Umarku</para>
  <para style="mt2">aka atsɛng</para>
  <para style="imt">Utsutson ri itsi ubvur Umarku</para>
  <para style="ip">Awu Umarku, uwuruwi undzumu itsoka iki igburh Uyohana Umarku atsɛng ubvur uwurɛ. Unga awu undzumu uwɛrhu Ubitru uner itser Uyesu (urhi <char style="xt"><ref loc="1PE 5:13">1Ubi 5.13</ref></char>). Agbaashia atsɛng ubvur uwurɛ na adɔrha atsɛng abvur aki Isarhe Iyiki Ize iyi Uyesu ikitatake.</para>
  <para style="ip">Ubvur uwurɛ utirhi nggu Isarhe Iyiki Ize iyi Uyesu Ukiristo, Ungwɛ̃ Unum. Ubvur ha udɛyiwe ugɛ Uyesu awu uner uwuku utɔ̃itser nu uner ijee. Ubvur uwurɛ udzowe iker akarhãrhã ri itsi abinkɛ Uyesu aka akorhe unangmgbɔ arherhanga nu imesanga. Arherhe aki imaataka ikitatake adzowuke isarhe itser Uyesu ru usatinga ukpu imaatak ru upfung na adɔrha akpe na asok.</para>
  <para style="iot">Abinkɛ aka awe umɔ</para>
  <para style="io1">Ititirhi itser Uyesu <char style="ior">(<ref loc="MRK 1:1-13">1.1-13</ref>)</char></para>
  <para style="io1">Itser Uyesu ru Ugarhirhi <char style="ior">(<ref loc="MRK 1:14-9:50">1.14—9.50</ref>)</char></para>
  <para style="io1">Itser Uyesu ru Urusharhima <char style="ior">(<ref loc="MRK 10:1-52">10.1-52</ref>)</char></para>
  <para style="io1">Usati Uyesu ukpu imaatak <char style="ior">(<ref loc="MRK 11:1-15:47">11.1—15.47</ref>)</char></para>
  <para style="io1">Isisok Uyesu ra akpe <char style="ior">(<ref loc="MRK 16:1-20">16.1-20</ref>)</char></para>
  <chapter number="1" style="c" sid="MRK 1"/>
  <para style="s1">Isarhe Uyohana Uner Ubɔtisima</para>
  <para style="r">(<ref loc="MAT 3:1-12">Umat 3.1-12</ref>; <ref loc="LUK 3:1-9">Irh 3.1-9</ref>,<ref loc="LUK 3:15-17">15-17</ref>; <ref loc="JHN 1:19-28">Uyoh 1.19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1"/>Itirhi Isarhe Iyiki Ize iyi Uyesu Ukiristo, Ungwɛ̃ Unum.<verse eid="MRK 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 1:2"/>Umbɔ aka atsɛng ru ubvur uner uwuku usɔm Arherhu-Num Uishaya ri itsinga agɛ,</para>
  <para style="q1" vid="MRK 1:2">&lt;&lt;Umum iwuri idene ungwɛ̃ itsermum agbaashia ru ungo.</para>
  <para style="q2" vid="MRK 1:2">Unga awuri igbishuwa atsĩndĩngo.<note caller="+" style="f"><char style="fr" closed="false">1.2 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="MAL 3:1">Umrh 3.1</ref></char>.</note><verse eid="MRK 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3"/>Urhɛm uwɔɔ uyisa ra arhum ugɛ,</para>
  <para style="q1" vid="MRK 1:3">&lt;Agbishuwe utsĩndĩ Uteijee,</para>
  <para style="q2" vid="MRK 1:3">aka agbisha avii atsĩndĩnga arhika.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">1.3 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="ISA 40:3">Uish 40.3</ref></char>.</note><verse eid="MRK 1:3"/></para>
  <para style="m">
    <verse number="4" style="v" sid="MRK 1:4"/>Nggee Uyohana aba, asorhuwe ubɔtisima ra arhum na adzowe isarhe iyi idzidzipa iyiki itsũwe arhim. <verse eid="MRK 1:4"/><verse number="5" style="v" sid="MRK 1:5"/>Anera arhɛrhɛ abi abĩ Uyahudiya, nu aner Urusharhima adzek azĩ ru unga. Asɔm arhimmbɔ, unga asorhuwe umbɔ ubɔtisima ra Azɛ̃ Urdun.<verse eid="MRK 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6"/>Uyohana atsim atorho igwar urhakumi, abow ikpɔm ubvur nú upfurhsĩnga, ubinghanga uwu asusu nggu utoo arhum. <verse eid="MRK 1:6"/><verse number="7" style="v" sid="MRK 1:7"/>Isarhanga hã iyɛ ugɛ, &lt;&lt;Uwɔɔ ruwɔ aka iba ru undzingmum agɔnga umum, uwuruwi umum isi ídɛ̃ɛ̃ inggarhukũ arhi abadaknga. <verse eid="MRK 1:7"/><verse number="8" style="v" sid="MRK 1:8"/>Umum isorhuwa umbi ubɔtisima nggu amɛ̃, bɔr unga awuri ikũ Ipfu Isarsatangge asorhuwa.&gt;&gt;<verse eid="MRK 1:8"/></para>
  <para style="s1">Ubɔtisima nu undeya Uyesu</para>
  <para style="r">(<ref loc="MAT 3:13-17">Umat 3.13-17</ref>; <ref loc="MAT 4:1-11">4.1-11</ref>; <ref loc="LUK 3:21-22">Irh 3.21-22</ref>; <ref loc="LUK 4:1-13">4.1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9"/>Ri ivang hã Uyesu adzeka ru Unazarat ra abĩ Ugarhirhi, Uyohana asorhuwe unga ubɔtisima ra Azɛ̃ Urdun. <verse eid="MRK 1:9"/><verse number="10" style="v" sid="MRK 1:10"/>Uyesu aka awuri idzeka ra amɛ̃, unga anyã afã aka ayanga, Ipfu Isarsatangge ru nyaku unurhɛu icipuwa nu unga. <verse eid="MRK 1:10"/><verse number="11" style="v" sid="MRK 1:11"/>Urhɛm udzeka afã ugɔr ugɛ, &lt;&lt;Ungo uwu Ungwɛ̃mum iki ĩbema. Nggu ungo umum igũibɛn akarhãrhã.&gt;&gt;<verse eid="MRK 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12"/>Kanying Ipfu-Num ikũna unga idzek izĩngge ra arhum. <verse eid="MRK 1:12"/><verse number="13" style="v" sid="MRK 1:13"/>Unga awu umɔ utsɛku inuma isɔka inaa, Ushaitan aka adeya unga. Unga awu nggu íjuɛ arhum, bɔr ípfu itser-Num itɔ̃we unga itser.<verse eid="MRK 1:13"/></para>
  <para style="s1">Uyisa angwɛ̃ imesa abi inggbaashia</para>
  <para style="r">(<ref loc="MAT 4:12-22">Umat 4.12-22</ref>; <ref loc="LUK 4:14-15">Irh 4.14-15</ref>; <ref loc="LUK 5:11">5.11</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14"/>Umbɔ aka agbange Uyohana ru ugborzĩ amaa, Uyesu azĩ atsĩã Ugarhirhi, anu idzowe Isarhe Iyiki Ize iyi Unum. <verse eid="MRK 1:14"/><verse number="15" style="v" sid="MRK 1:15"/>Agɛ, &lt;&lt;Ivanga iki ibangge! Nggayɛ Iyɛrhu Unum iki iyongge. Àka adzipa, na awe ru imangmang ri Isarhe Iyiki Ize!&gt;&gt;<verse eid="MRK 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16"/>Uyesu aka azɛ̃rhã atɔng ru ubang Ukau Ugarhirhi, unga anyã Usiman nu ungwɛ̃mbɔ Uandarawu anu itang igber ru ukau ha, umbɔ awu abika adɛm abɛrh. <verse eid="MRK 1:16"/><verse number="17" style="v" sid="MRK 1:17"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Àka aba adɔsa umum, umum itsu umbi awu abika adzui anera.&gt;&gt; <verse eid="MRK 1:17"/><verse number="18" style="v" sid="MRK 1:18"/>Kanying umbɔ aneke itang igbermbɔ na adɔsa unga.<verse eid="MRK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19"/>Unga aka agɔpa azĩ ukunjiir, unga anyã Uyaku ungwɛ̃ Uzabadi nu ungwɛ̃mbɔ Uyohana ru ukhukhɔɔ, adɛ̃ɛ̃ igbishu igbermbɔ. <verse eid="MRK 1:19"/><verse number="20" style="v" sid="MRK 1:20"/>Asi idãrhũmbɔ unga ayisa umbɔ. Umbɔ aneke utɛmbɔ Uzabadi nggu abi itser imang ru ukhukhɔɔ ha na adɔsa unga.<verse eid="MRK 1:20"/></para>
  <para style="s1">Uyesu awayiwe ipfu iyiki ibewe</para>
  <para style="r">(<ref loc="LUK 4:31-37">Irh 4.31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21"/>Uyesu nggu angwɛ̃ imesanga atsĩmbɔ Ukafanahum, unum ukpuku uwosha uku uwe, Uyesu atsĩ ru ubã ifɛn-Num atirhi imesuwe. <verse eid="MRK 1:21"/><verse number="22" style="v" sid="MRK 1:22"/>Anera adzeidzeu ri imesanga, ubinkutsu amesuwe umbɔ ru nyaku uner ijee. Asi iwea ru nyaku uwuku umesuwe Ikpem. <verse eid="MRK 1:22"/><verse number="23" style="v" sid="MRK 1:23"/>Umɔ hã uner uwɔɔ ru ubã ifɛn-Nummbɔ awuri ipfu iyiki ibewe itsu ivum igɛ, <verse eid="MRK 1:23"/><verse number="24" style="v" sid="MRK 1:24"/>&lt;&lt;Iyee! Ungo ubee use nggu umɛn Uyesu uner Unazarat? Ungo uba itsĩme umɛn? Umum ihwɛng ungo uwu usarkasar uwu Unum!&gt;&gt;<verse eid="MRK 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25"/>Uyesu atsɛrhi ipfu iyiki ibewe ha agɛ, &lt;&lt;Unukutata! Upfudzeka ru utsak ha!&gt;&gt; <verse eid="MRK 1:25"/><verse number="26" style="v" sid="MRK 1:26"/>Ipfu iyiki ibewe ha iyung utsak ha nggu uvɔm ni itsu ivum idzengge ru utsak ha.<verse eid="MRK 1:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 1:27"/>Anera kishoo adzeidzeu na arhusa adɔka agɛ, &lt;&lt;Awu use nuwi ikɛi? Imesa iyiki ifa nu ijee! Atsu ípfu iyiki ibewe idɔsa arherhanga!&gt;&gt; <verse eid="MRK 1:27"/><verse number="28" style="v" sid="MRK 1:28"/>Kanying isarhanga itɛ̃rhã imaangge ananga ra abĩ Ugarhirhi.<verse eid="MRK 1:28"/></para>
  <para style="s1">Uyesu akerhuwe uzɔma Ubitru</para>
  <para style="r">(<ref loc="MAT 8:14-15">Umat 8.14-15</ref>; <ref loc="LUK 4:38-39">Irh 4.38-39</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29"/>Umbɔ aka adzeka ru ubã ifɛn-Num hã, umbɔ azĩ nggu Uyaku nu Uyohana atsĩmbɔ ri iyambɔ Ubitru nu Uandarawu. <verse eid="MRK 1:29"/><verse number="30" style="v" sid="MRK 1:30"/>Uya utsɛ̃ Ubitru iyora imani unga anu inũ, umbɔ asɔme unga kanying. <verse eid="MRK 1:30"/><verse number="31" style="v" sid="MRK 1:31"/>Nggee unga azĩ adzur uboknga abera unga. Imani iyor ha ikerhungge, unga asok atɔ̃we umbɔ itser.<verse eid="MRK 1:31"/></para>
  <para style="s1">Uyesu akerhuwe anera arhɛrhɛ</para>
  <para style="r">(<ref loc="MAT 8:16-17">Umat 8.16-17</ref>; <ref loc="LUK 4:40-41">Irh 4.40-41</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32"/>Nu urhɛɛ ha, unuma uku utsĩ anera akũ arhɛrha abi írhãrhã aba ru Uyesu, nu abi ípfu iyiki ibewe. <verse eid="MRK 1:32"/><verse number="33" style="v" sid="MRK 1:33"/>Arhɛrha anera ru utepa akɔng nu angwĩ iyaa. <verse eid="MRK 1:33"/><verse number="34" style="v" sid="MRK 1:34"/>Uyesu akerhuwe abi ikpũ írhãrhã. Ikɛi atsusuwe ípfu iyiki ibewe ra anera arhɛrhɛ, asi ibeenga ípfu iyiki ibewe irherha arherhe ubinkutsu ngge ihwɛngngge unga.<verse eid="MRK 1:34"/></para>
  <para style="s1">Uyesu azĩ afɛn-Num ra anangkɛ <optbreak/> anera aka ashimbɔ</para>
  <para style="r">(<ref loc="LUK 4:42-44">Irh 4.42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35"/>Ri igɔ̃kpeka, uzĩ na ubɔrkpɔ, Uyesu asok, aneke iya ha na azĩã ra anangkɛ anera aka ashimbɔ, umɔ unga aka afɛn-Num. <verse eid="MRK 1:35"/><verse number="36" style="v" sid="MRK 1:36"/>Usiman nu abirabɛ aka awu nggu unga azĩmbɔ ibea unga. <verse eid="MRK 1:36"/><verse number="37" style="v" sid="MRK 1:37"/>Umbɔ aka anyã unga, umbɔ agɛ, &lt;&lt;Kishoo adɛ̃ɛ̃ ibea ungo.&gt;&gt;<verse eid="MRK 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Umɛn izĩmɛn iteuyɛ iki ikhapa nggimi, umum idzowe isarhe umɔ ikɛi. Ubin hã ru ukpɔ uku ukũ umum uba.&gt;&gt; <verse eid="MRK 1:38"/><verse number="39" style="v" sid="MRK 1:39"/>Nggee unga azɛ̃rhã amaa Ugarhirhi adzowe isarhe ra abã ifɛn-Nummbɔ na atsusuwe ípfu iyiki ibewe ra anera.<verse eid="MRK 1:39"/></para>
  <para style="s1">Uyesu akerhuwe uner ingbim</para>
  <para style="r">(<ref loc="MAT 8:1-4">Umat 8.1-4</ref>; <ref loc="LUK 5:12-16">Irh 5.12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40"/>Uner ingbim uwɔɔ aba ru Uyesu, atararhu ashɔ̃rhã unga agɛ, &lt;&lt;Ungo uba ubeengo, ungo udɛ̃ɛ̃ ukerhuwango umum nu usara umum.&gt;&gt;<verse eid="MRK 1:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41"/>Umɔ Uyesu agũ atorh, aberu uboknga abangu utsa ha. Agɛ, &lt;&lt;Umum ĩbeemum, ukerhe!&gt;&gt; <verse eid="MRK 1:41"/><verse number="42" style="v" sid="MRK 1:42"/>Kanying ingbimnga ikerhungge.<verse eid="MRK 1:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 1:43"/>Uyesu asoyiwe unga na avange atonga akarhãrhã agɛ, <verse eid="MRK 1:43"/><verse number="44" style="v" sid="MRK 1:44"/>&lt;&lt;Niba usɔmukɔ unera. Bɔr uzĩ, udɛyiwe itsingo ru uwuku udzowe idɛm-Num nu udzowe idɛm-Num iyi Umusa aka amesuwa umbi ri ikikerhe, ra anera ahwɛng ugɛ ungo uku ukerhungo.&gt;&gt; <verse eid="MRK 1:44"/><verse number="45" style="v" sid="MRK 1:45"/>Unga aka ikorhe rimi, utsak ha akpurha adzek adɛ̃ɛ̃ isisɔme anera, amaa ananga kishoo. Akɛrɛ ha atsu Uyesu asi idɛ̃ɛ̃ atsĩã uteu ukpɔɔ ri inyĩnyã anera, akpurha aseiyi ru awiya anangkɛ anera aka ashimbɔ umɔ. Rimi hã anera anang adzeyi ri inang aba ru unga.<verse eid="MRK 1:45"/></para>
  <chapter eid="MRK 1"/>
  <chapter number="2" style="c" sid="MRK 2"/>
  <para style="s1">Uyesu akerhuwe uner ishai iyor</para>
  <para style="r">(<ref loc="MAT 9:1-8">Umat 9.1-8</ref>; <ref loc="LUK 5:17-26">Irh 5.17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1"/>Inuma ukunjiir iki itɔng, Uyesu abvui atsĩã Ukafanahum ikɛi, anera aka agũ ugɛ unga aka aba ri iya. <verse eid="MRK 2:1"/><verse number="2" style="v" sid="MRK 2:2"/>Anera arhɛrhɛ akɔng atɔke ubãã, atsu ananga asi ibɔrke ru angwĩ ubãã, Uyesu adzowe umbɔ isarhe. <verse eid="MRK 2:2"/><verse number="3" style="v" sid="MRK 2:3"/>Inera inaa iki itsã uner irhãrhĩ ishai iyor akũ aba. <verse eid="MRK 2:3"/><verse number="4" style="v" sid="MRK 2:4"/>Umbɔ aka asi ikpombɔ udĩ ukpuku utsutsĩ ru Uyesu, anera aka arhɛmbɔ, umbɔ afũ ati akang uvi iya ha ra anankɛ Uyesu aka adɛ̃ɛ̃, na acipuwe uner ishai iyor ha nu ufarnga aka anu. <verse eid="MRK 2:4"/><verse number="5" style="v" sid="MRK 2:5"/>Uyesu aka anyã imangmangmbɔ, unga agɔr uner ishai iyor ha agɛ, &lt;&lt;Ungwɛ̃mum, aka atsũwãmbɔ arhimngo.&gt;&gt;<verse eid="MRK 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6"/>Abika amesuwe Ikpem asei umɔ ra anang hã akaifɛrhkɔ ra amɛnmbɔ agɛ, <verse eid="MRK 2:6"/><verse number="7" style="v" sid="MRK 2:7"/>&lt;&lt;Awu use utsu utsak uwurɛ arherhe rimi? Unga aka arhenu Unum! Ungamɔ awe ru ijee iyiki itsũwe arhim? Asi iwea Unum ikiyikanga?&gt;&gt;<verse eid="MRK 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8"/>Kanying Uyesu ahwɛnga ubinkpi umbɔ aka akaifɛrhkɔ ra amɛnmbɔ, unga agɔr umbɔ agɛ, &lt;&lt;Awu use utsu umbi awe ru ikpũ ifɛrhkɔ ha? <verse eid="MRK 2:8"/><verse number="9" style="v" sid="MRK 2:9"/>Akasong aka ayoa, umbɔ aka idɛyiwe uner ishai iyor ha, &lt;Aka atsũwãmbɔ arhimngo,&gt; use igɔr ugɛ, &lt;Usisok unyangu ufarngo uzɛ̃rhã?&gt; <verse eid="MRK 2:9"/><verse number="10" style="v" sid="MRK 2:10"/>Bɔr umum ibee umbi ahwɛng ugɛ Ungwɛ̃-Ner awea ri ijee iyiki itsũwe arhim ru upfung.&gt;&gt; Umɔ unga agɔr uner ishai iyor ha agɛ, <verse eid="MRK 2:10"/><verse number="11" style="v" sid="MRK 2:11"/>&lt;&lt;Umum ĩgɔr ungo, usisok, unyangu ufarngo uzĩ ri iya.&gt;&gt; <verse eid="MRK 2:11"/><verse number="12" style="v" sid="MRK 2:12"/>Unga asok, anyangu ufarnga azɛ̃rhã adzeka ri inyĩnyã anera kishoo. Akɛrɛ ha atsu umbɔ adzeidzeu na akpoi Unum agɛ, &lt;&lt;Umɛn inasi inyãmɛn ifɛrhɛ rimi.&gt;&gt; <figure style="fig" alt="Jesus tells the paralytic to stand and walk" file="dn00444b.tif" size="col" loc="2.12" copy="Darwin Dunham" ref="2.12">Uyesu agɔr uner ishai iyor ha ugɛ unga asisok</figure><verse eid="MRK 2:12"/></para>
  <para style="s1">Uyisa ukpu Urhawi</para>
  <para style="r">(<ref loc="MAT 9:9-13">Umat 9.9-13</ref>; <ref loc="LUK 5:27-32">Irh 5.27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13"/>Uyesu abvui adzek azĩã ru ubang Ukau Ugarhirhi. Anera arhɛrhɛ aka azĩ akɔng adziira unga, unga amesuwe umbɔ. <verse eid="MRK 2:13"/><verse number="14" style="v" sid="MRK 2:14"/>Unga aka azɛ̃rhã atɔng, unga anyã Urhawi ungwɛ̃ Uharhfa aka asei ra anang akika ayɛi ikirbi abĩ. Uyesu agɔr unga agɛ, &lt;&lt;Udɔsa umum,&gt;&gt; unga asok adɔsa unga.<verse eid="MRK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15"/>Uyesu nu angwɛ̃ imesanga asei igha urhɛɛ ri iya Urhawi nggu abika ayɛi ikirbi abĩ nu abirabɛ aka anyanga umbɔ awu abi arhim arhɛrhɛ. Anera arhɛrhɛ aka adɔsa unga. <verse eid="MRK 2:15"/><verse number="16" style="v" sid="MRK 2:16"/>Ivangyɛ abika amesuwe Ikpem aka awu abi Ufarisi, aka anyã unga aka asei igha ubingha nggu abi arhim hã nu abika ayɛi ikirbi abĩ, umbɔ arhusa angwɛ̃ imesanga agɛ, &lt;&lt;Awu use utsu unga asei igha ubingha nggu abika ayɛi ikirbi abĩ nu abi arhim?&gt;&gt;<verse eid="MRK 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17"/>Uyesu aka agũ rimi, unga agɔr umbɔ agɛ, &lt;&lt;Abika aker asi ibeembɔ uner agɔu, abi irhãrhã ukpekũ abee uner agɔu. Umum isi ĩbamum iyisa abika arhurhika, bɔr umum ĩba iyisa abi arhim.&gt;&gt;<verse eid="MRK 2:17"/></para>
  <para style="s1">Arhusu Uyesu ikpem ighabin</para>
  <para style="r">(<ref loc="MAT 9:14-17">Umat 9.14-17</ref>; <ref loc="LUK 5:33-39">Irh 5.33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18"/>Angwɛ̃ imesu Uyohana Uner Ubɔtisima nu abi Ufarisi adɛ̃ɛ̃ ikpem ighabin. Anera abɔɔ aba arhusu Uyesu agɛ, &lt;&lt;Awu use utsu Angwɛ̃ imesu Uyohana nu abi Ufarisi akpemmbɔ ighabin, bɔr abingo asi ikpemmbɔ?&gt;&gt;<verse eid="MRK 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Awu use utsu awɛrhu utsak uwuku ufa akpem ighabin unga aba ana awu nggu umbɔ? Asi íkpemmbɔ ri ivangyɛ unga aka awu nggu umbɔ. <verse eid="MRK 2:19"/><verse number="20" style="v" sid="MRK 2:20"/>Ivanga niyɔ ibarɔ umbɔ awuri isoyiwe utsak uwuku ufa ha ru umbɔ, unum hã nukpɔ umbɔ aka ikpem ighabin.<verse eid="MRK 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21"/>&lt;&lt;Unera asi íkũ utatorho uku ufa abipunga atorho aka agbe. Unga aba akorhunga, utatorho uwuku ufa ha uwuri ishĩrhã avaate atorho aka agbe ha, ivivaar ha iwuri inangge iyi inggbaashia. <verse eid="MRK 2:21"/><verse number="22" style="v" sid="MRK 2:22"/>Ikɛi unera asi ítsuka amɛ̃ inebi aka afa ra ambãĩ aka agbe. Unga aba akorhunga rimi, amɛ̃ inebi aka afa ha awuri iyare ambãĩ aka agbe ha, ambãĩ ha nu amɛ̃ inebi ha awuri iwe ibɛm. Amɛ̃ inebi aka afa, awuri itsu ake ra ambãĩ aka afa.&gt;&gt;<verse eid="MRK 2:22"/></para>
  <para style="s1">Uteijee uwu unum ukpuku uwosha</para>
  <para style="r">(<ref loc="MAT 12:1-8">Umat 12.1-8</ref>; <ref loc="LUK 6:1-5">Irh 6.1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23"/>Ru unum ukpuku uwosha ukpɔɔ, Uyesu nu angwɛ̃ imesanga azɛ̃rhã atɔng ri icang arhkama. Angwɛ̃ imesanga aka azɛ̃rhã nggu unga, atirhi igbiu atsi arhkama. <verse eid="MRK 2:23"/><verse number="24" style="v" sid="MRK 2:24"/>Abi Ufarisi agɔr unga agɛ, &lt;&lt;Unyã, awu use utsu umbɔ azharhuwe Ikpem unum ukpuku uwosha?&gt;&gt;<verse eid="MRK 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25"/>Unga agɔr umbɔ agɛ, &lt;&lt;Umbi anasi ivarhumbi ubin Udauda aka akorhe ri ivangyɛ umbɔ aka agũ imerh nggu awɛrhu uzɛ̃rhãnga? <verse eid="MRK 2:25"/><verse number="26" style="v" sid="MRK 2:26"/>Ri inum Uabiata aka awu Ukugɔng Uwuku Udzowe Idɛm-Num, Udauda atsĩ ri Iya-Num, atãiwe usarkasar uborodi, ikɛi na abɔr adzowe awɛrhu uzɛ̃rhãnga, ukpurukpi uku usi imɛ̃kpɔ unera atãinga ukpɔ, uner uwuku udzowe idɛm-Num ukpekũ awuri itãi.&gt;&gt;<verse eid="MRK 2:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27"/>Mɔcɛ unga agɔr umbɔ agɛ, &lt;&lt;Angwɛ̃we unum ukpuku uwosha ra anera, asi ingwɛ̃mbɔ anera awembɔ abi unum ukpuku uwosha. <verse eid="MRK 2:27"/><verse number="28" style="v" sid="MRK 2:28"/>Nggee Ungwɛ̃-Ner unga awu Uteijee uwu unum ukpuku uwosha.&gt;&gt;<verse eid="MRK 2:28"/></para>
  <chapter eid="MRK 2"/>
  <chapter number="3" style="c" sid="MRK 3"/>
  <para style="s1">Uner ushai ubok ru Ukafarnahum</para>
  <para style="r">(<ref loc="MAT 12:9-14">Umat 12.9-14</ref>; <ref loc="LUK 6:6-11">Irh 6.6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1"/>Ivang iyɔɔ unga aka atsĩ ru abã ifɛn-Num, uner uwɔɔ umɔ nggu uboknga ushushai. <verse eid="MRK 3:1"/><verse number="2" style="v" sid="MRK 3:2"/>Abɔɔ abee ubinkpi umbɔ aka ikũ akpo uvau ru Uyesu. Umbɔ atsu asumbɔ nu unga use unga awuri ikikerhuka utsak ha ru unum ukpuku uwosha. <verse eid="MRK 3:2"/><verse number="3" style="v" sid="MRK 3:3"/>Uyesu agɔr uner uwuku ushai ubok ha agɛ, &lt;&lt;Udzek udɛ̃ɛ̃ ra asumbɔ kishoo.&gt;&gt;<verse eid="MRK 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 3:4"/>Uyesu arhusa umbɔ agɛ, &lt;&lt;Imɛ̃ɛ̃ umbɔ akorhu use ru unum ukpuku uwosha, akorhi iyiki ize use akorhi iyiki ibewe, afɔrhe urhɛ use afɛre umgbɔ?&gt;&gt; Bɔr umbɔ asei ukutata.<verse eid="MRK 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 3:5"/>Unga arhi adziira umbɔ ra avɔm, amɛnnga adake ra amɛn aka akermbɔ, unga agɔr uner ushai ubok ha agɛ, &lt;&lt;Unamu ubokngo.&gt;&gt; Unga anamu uboknga udzek, Kanying ukpɔ ukerhukpɔ. <verse eid="MRK 3:5"/><verse number="6" style="v" sid="MRK 3:6"/>Mɔcɛ abi Ufarisi adzek akɛki itsũwã nggu aner Uhiridu, abee udĩ ukpuku ufɛr Uyesu.<verse eid="MRK 3:6"/></para>
  <para style="s1">Ikikɔng idɔsu Uyesu</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7"/>Uyesu adzek nggu angwɛ̃ imesanga azĩmbɔ ubang ukau, arhɛrha anera adzeku Ugarhirhi adɔsa unga. <verse eid="MRK 3:7"/><verse number="8" style="v" sid="MRK 3:8"/>Umbɔ aka agũ abinkɛ unga aka akorhe kishoo, anera arhɛrhɛ aka adzeku Uyahudiya aba ru unga, nu Urusharhima, nu Uidumiya, nu abi ugar Azɛ̃ Urdun, nu aner Utaya nu Usidon. <verse eid="MRK 3:8"/><verse number="9" style="v" sid="MRK 3:9"/>Anera aka arhɛmbɔ, unga agɔr angwɛ̃ imesanga akpowe ukhukhɔɔ amɛ̃ uwuku uci adzowe unga, utsur anera afĩĩmbɔ unga. <verse eid="MRK 3:9"/><verse number="10" style="v" sid="MRK 3:10"/>Unga akerhuka anera arhɛrhɛ, nggee abi irhãrhã abee izĩ ra asu abanga unga. <verse eid="MRK 3:10"/><verse number="11" style="v" sid="MRK 3:11"/>Ivangyɛ ípfu iyiki ibewe iki inyã unga, ngge igba nú abĩ ra anangnga ni itsui ivum igɛ, &lt;&lt;Ungo uwu Ungwɛ̃ Unum!&gt;&gt; <verse eid="MRK 3:11"/><verse number="12" style="v" sid="MRK 3:12"/>Bɔr unga avange ngge niba idɛyikungge unera unerwi unga aka awe.<verse eid="MRK 3:12"/></para>
  <para style="s1">Isɛng abi itser Uyesu usɔkdũmɛn</para>
  <para style="r">(<ref loc="MAT 10:1-4">Umat 10.1-4</ref>; <ref loc="LUK 6:12-16">Irh 6.12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13"/>Uyesu afũã igũ na ayisa abirabɛ unga aka abee, umbɔ aba ru unga. <verse eid="MRK 3:13"/><verse number="14" style="v" sid="MRK 3:14"/>Unga asɛng usɔkdũmɛn umbɔ aka iwe abi itser Uyesu ugɛ umbɔ awe nggu unga, nú unga adene umbɔ adzek adzise isarhe. <verse eid="MRK 3:14"/><verse number="15" style="v" sid="MRK 3:15"/>Umbɔ awuri iyiyɛimbɔ ijee iyiki itsusuwe ípfu iyiki ibewe. <verse eid="MRK 3:15"/><verse number="16" style="v" sid="MRK 3:16"/>Umbɔ hã abɛ, usɔkdũmɛn hã unga aka asɛng, Usiman, uwu ha Uyesu aki iyisa Ubitru, <verse eid="MRK 3:16"/><verse number="17" style="v" sid="MRK 3:17"/>nu Uyaku ungwɛ̃ Uzabadi nu ungwɛ̃mbɔ Uyohana, abirabɛ Uyesu iki iyisa ugɛ Ubuwarnaji, agbena agburh &lt;&lt;Angwɛ̃ Igbigbashu Inai,&gt;&gt; <verse eid="MRK 3:17"/><verse number="18" style="v" sid="MRK 3:18"/>nu Uandarawu, nu Ufirhibu, nu Ubatorhomi, nu Umatiyu, nu Utoma, nu Uyaku ungwɛ̃ Uharhfa, nu Utaddiyu, nu Usiman uner Ukan'ana, <verse eid="MRK 3:18"/><verse number="19" style="v" sid="MRK 3:19"/>nu Uyahuda Uiskariyoti uwuku ugha adaknga.<verse eid="MRK 3:19"/></para>
  <para style="s1">Uyesu nu Uba'arhzaburh</para>
  <para style="r">(<ref loc="MAT 12:22-32">Umat 12.22-32</ref>; <ref loc="LUK 11:14-23">Irh 11.14-23</ref>; <ref loc="LUK 12:10">12.10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20"/>Mɔcɛ Uyesu abvui atsĩ ri iya. Anera abvui akɔng ikɛi, utsɛku unga nu angwɛ̃ imesanga asi idɛ̃ɛ̃ aghambɔ ubingha. <verse eid="MRK 3:20"/><verse number="21" style="v" sid="MRK 3:21"/>Abi iyambɔ aka agũ rimi, asok azĩmbɔ idzur unga. Anera anu igɔr agɛ, &lt;&lt;Unga aka azhɔmu ukpong!&gt;&gt;<verse eid="MRK 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22"/>Abika amesuwe Ikpem igambɔ adzeku Urusharhima aba agɔr agɛ, &lt;&lt;Awu Uba'arhzaburh uyɛrhe ípfu iyiki ibewe unga atsĩ ru unga! Akũ ijeenga ikɛi atsusuwe ipfu iyiki ibewe idzek.&gt;&gt;<verse eid="MRK 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23"/>Nggee Uyesu ayisa umbɔ na arherhuwe umbɔ unyaka arherhe agɛ, &lt;&lt;Ushaitan awuri ikorha aguse na awayiwe Ushaitan? <verse eid="MRK 3:23"/><verse number="24" style="v" sid="MRK 3:24"/>Iyɛrhe iba igaungge itsingge, iyɛrha ha isi ídɛ̃ɛ̃ngge. <verse eid="MRK 3:24"/><verse number="25" style="v" sid="MRK 3:25"/>Iya iba igauke itsike, iya ha isi ídɛ̃ɛ̃ke. <verse eid="MRK 3:25"/><verse number="26" style="v" sid="MRK 3:26"/>Rimi Ushaitan aba ugapa itsinga, unga asi ídɛ̃ɛ̃nga, imimashanga iki ibangge. <verse eid="MRK 3:26"/><verse number="27" style="v" sid="MRK 3:27"/>Idzidzɛrhe, unera asi ídɛ̃ɛ̃ atsĩã ri iya uner uwuku uker akarhuka abinnga, awuri itirhi abow uner uwuku uker ha. Mɔcɛ unga awuri idɛ̃ɛ̃ avura abin iya ha. <verse eid="MRK 3:27"/><verse number="28" style="v" sid="MRK 3:28"/>Umum idɛyiwa umbi idzidzɛrhe, kishoo arhim nu irhenu Unum anera aki ikorhe, awuri itsitsũwũkumbɔ ake. <verse eid="MRK 3:28"/><verse number="29" style="v" sid="MRK 3:29"/>Bɔr ubɛn uwuku urhenu Ipfu Isarsatangge asi ítsũwũkumbɔ unga, awu ra arhim aki ugbagbaa.&gt;&gt;<verse eid="MRK 3:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 3:30"/>Unga arherhe rimi, ubinkutsu umbɔ aka agɔr agɛ, &lt;&lt;Unga awe ru ipfu iyiki ibewe.&gt;&gt;<verse eid="MRK 3:30"/></para>
  <para style="s1">Uya Uyesu nu angwɛ̃mbɔ</para>
  <para style="r">(<ref loc="MAT 12:46-50">Umat 12.46-50</ref>; <ref loc="LUK 8:19-21">Irh 8.19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31"/>Mɔcɛ uya Uyesu nggu angwɛ̃mbɔ aba atsĩ. Adɛ̃ɛ̃ nú awiya, na adene uwɔɔ unga ayisuwe Uyesu. <verse eid="MRK 3:31"/><verse number="32" style="v" sid="MRK 3:32"/>Ikikɔnga isei adziira unga, umbɔ adɛyiwe unga agɛ, &lt;&lt;Uyango nu anapumbi abeea ungo ra awiya.&gt;&gt;<verse eid="MRK 3:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33"/>Unga arhusa umbɔ agɛ, &lt;&lt;Awu umbɔ ungamɔ awu uyamum nu angwɛ̃mɛn?&gt;&gt;<verse eid="MRK 3:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 3:34"/>Unga arhi abirabɛ aka asei adziira unga na agɛ, &lt;&lt;uyamum uwi nggu angwɛ̃mɛn! <verse eid="MRK 3:34"/><verse number="35" style="v" sid="MRK 3:35"/>Ubɛn unera aka ikorhu ubinkpi Unum aka abema, unga awu ungwɛ̃mɛn nu unapumɛn nu uyamum.&gt;&gt;<verse eid="MRK 3:35"/></para>
  <chapter eid="MRK 3"/>
  <chapter number="4" style="c" sid="MRK 4"/>
  <para style="s1">Unyaka arherhe uner uwuku <optbreak/> udoi abin</para>
  <para style="r">(<ref loc="MAT 13:1-23">Umat 13.1-23</ref>; <ref loc="LUK 8:4-15">Irh 8.4-15</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1"/>Ikɛi Uyesu atirhi imesuwe nú ubang ukau. Ikikɔnga iki ikɔng idziir unga irhɛngge, unga asok atsĩ ukhukhɔɔ amɛ̃ asei ru ukau, ikikɔng anera idɛ̃ɛ̃ umɔ nú ubang ukau ha. <verse eid="MRK 4:1"/><verse number="2" style="v" sid="MRK 4:2"/>Unga akũ unyaka arherhe amesuwe umbɔ abina arhɛrhɛ, agɔr umbɔ agɛ, <verse eid="MRK 4:2"/><verse number="3" style="v" sid="MRK 4:3"/>&lt;&lt;Àka akpeto! Uner irham adzek azĩ idoi ikpũnga. <verse eid="MRK 4:3"/><verse number="4" style="v" sid="MRK 4:4"/>Unga aka adɛ̃ɛ̃ inna ikpũ hã, ikpũ iyɔɔ igba nú utsĩndĩ, anunu aba akpɔuke iyi ha. <verse eid="MRK 4:4"/><verse number="5" style="v" sid="MRK 4:5"/>Iyɔɔ igbei ru ukpɔrha, abĩ asi iweke akarhãrhã. Ngge imɛr kanying ubinkutsu, abĩ anang hã asi ighorke. <verse eid="MRK 4:5"/><verse number="6" style="v" sid="MRK 4:6"/>Unum uku urhang, imani ikoikungge ikpũ iyi ha, ubinkutsu ngge ishingge ra anũnang. <verse eid="MRK 4:6"/><verse number="7" style="v" sid="MRK 4:7"/>Ikpũ iyɔɔ igba ri ididɔk, ididɔk iseng itong iyi ha, ngge isi ighwɛrngge ikpũrhã. <verse eid="MRK 4:7"/><verse number="8" style="v" sid="MRK 4:8"/>Iyɔɔ ikɛi igba ra abĩ aka aze. Imɛr idzeka, iseng ni ighwɛr ikpũrhã, iyɔɔ isɔka itaitaar, iyɔɔ isɔka utɔ̃tɔ̃ĩ, iyɔɔ ananaka.&gt;&gt;<verse eid="MRK 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9"/>Mɔcɛ Uyesu agɛ, &lt;&lt;Ubɛn unera aka awu ra ato akika agũ, neke unga agũ.&gt;&gt;<verse eid="MRK 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10"/>Ivangyɛ Uyesu aka asei ikiyikanga, angwɛ̃ imesanga usɔkdũmɛn nu abɔɔ aka adɔsa unga arhusa agben unyaka arherhe ha. <verse eid="MRK 4:10"/><verse number="11" style="v" sid="MRK 4:11"/>Unga adɛyiwe umbɔ agɛ, &lt;&lt;Aka adzaambɔ umbi ihwɛng iwiwɔk Iyɛrhe-Num. Bɔr abirabɛ aka awu ra awiya, abina kishoo awuri irherhuwe umbɔ ru unyaka arherhe. <verse eid="MRK 4:11"/><verse number="12" style="v" sid="MRK 4:12"/>Ngge itsu,</para>
  <para style="q1" vid="MRK 4:12">&lt;&lt; &lt;Umbɔ awuri irhirhimbɔ,</para>
  <para style="q2" vid="MRK 4:12">bɔr asi ínyãmbɔ,</para>
  <para style="q1" vid="MRK 4:12">awuri igũmbɔ ikɛi</para>
  <para style="q2" vid="MRK 4:12">na asi íhwɛngmbɔ,</para>
  <para style="q1" vid="MRK 4:12">utsur umbɔ adzipa na atsũwũkumbɔ arhimmbɔ!&gt; <note caller="+" style="f"><char style="fr" closed="false">4.12 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="ISA 6:9">Uish 6.9</ref>,<ref loc="ISA 6:10">10</ref></char>.</note>&gt;&gt;<verse eid="MRK 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13"/>Unga agɔr umbɔ agɛ, &lt;&lt;Umbi asi ihwɛngmbi agben unyaka arherhe ha? Ude umbi awuri ikorhu uguse na ahwɛng agben unyaka arherhe akɔɔ? <verse eid="MRK 4:13"/><verse number="14" style="v" sid="MRK 4:14"/>Uner irham hã adoi Arherhu-Num. <verse eid="MRK 4:14"/><verse number="15" style="v" sid="MRK 4:15"/>Abɔɔ awu ru nyaki ikpũyɛ iki igba nú utsĩndĩ, anangkɛ umbɔ aka adoi arherha ha, kanying Ushaitan aba atsũwũka arherhe ha aka adoi ru umbɔ. <verse eid="MRK 4:15"/><verse number="16" style="v" sid="MRK 4:16"/>Abirabɛ aka awu ru nyaki ikpũ iyiriyɛ umbɔ aka adoi nú abĩ ifa, agũ arherha ha, kanying umbɔ ayɛi ake nggu itɛnamɛn. <verse eid="MRK 4:16"/><verse number="17" style="v" sid="MRK 4:17"/>Bɔr umbɔ aka ashimbɔ ra anũnang, umbɔ adãrhĩ ivanga ukunjiir. Ivang ayetnum use uver iki iba ri itsi arherha ha, kanying umbɔ abvui azĩmbɔ ra andzing. <verse eid="MRK 4:17"/><verse number="18" style="v" sid="MRK 4:18"/>Ikɛi abɔɔ, awu ru nyaki ikpũyɛ iki idoi ri ididɔk, agũ arherhe ha, <verse eid="MRK 4:18"/><verse number="19" style="v" sid="MRK 4:19"/>bɔr igũ ighong abin upfung, nu irhirhɛm ibee iwu ru ubin nu ikpona abina akɔɔ itsĩ ikɛnke arherha ha ighwighwɛr. <verse eid="MRK 4:19"/><verse number="20" style="v" sid="MRK 4:20"/>Abɔɔ, awu ru nyaki ikpũyɛ iki idoi na abĩ aka aze, agũ arherha ha, na ayɛi ake akũ atɔ̃ itser nggu ake, aghwɛr ikpũrhã iyɔɔ isɔka itaitaar, iyɔɔ isɔka utɔ̃tɔ̃ĩ, iyɔɔ ananaka.&gt;&gt;<verse eid="MRK 4:20"/></para>
  <para style="s1">Irhirhang afafã</para>
  <para style="r">(<ref loc="LUK 8:16-18">Irh 8.16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Umbi aka isaka agaar irhirhang awɔkmbi ru ikikĩĩ? Use atsuke ngge ra ada ukoma? Ishingge rimi, ugɛse umbi aka isaka aden ngge ru anang idɛ̃ɛ̃ke afafã? <verse eid="MRK 4:21"/><verse number="22" style="v" sid="MRK 4:22"/>Abinkɛ aka awu ri iwɔk, umbɔ awuri inyãmbɔ ake, abinkɛ aka awoyi ikɛi, awuri inyinyãmbɔ ake nu awiya. <verse eid="MRK 4:22"/><verse number="23" style="v" sid="MRK 4:23"/>Ubɛn unerwi aka awu ra ato akika agũ, neke unga agũ.&gt;&gt;<figure style="fig" alt="Lamp on a mortar" file="hk00152b.tif" size="col" loc="4.23" copy="Horace Knowles" ref="4.21">Irhirhang nu utsur</figure><verse eid="MRK 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24"/>Na agɔr umbɔ agɛ, &lt;&lt;Àka akpeto na agũ. Ugbiu ha ungo uku ukũ umei, awuri ikũ umgbɔ amei adzaa ungo, awuri itomuwambɔ ungo. <verse eid="MRK 4:24"/><verse number="25" style="v" sid="MRK 4:25"/>Uwuruwi aka awe ru ihwihwɛng awuri itomuwe unga akpo arhɛrhɛ. Uwuruwi aka ashia, awuri iyɛse ungwɛ̃rhĩ ihwihwɛng ha unga aka awerangge.&gt;&gt;<verse eid="MRK 4:25"/></para>
  <para style="s1">Unyaka arherhe ikpũ iyiki isiseng</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26"/>Na agɔr agɛ, &lt;&lt;Iyɛrhe Unum iwuri iminɛ. Unera adoi ikpũ nu icangnga. <verse eid="MRK 4:26"/><verse number="27" style="v" sid="MRK 4:27"/>Utsuu nu atenum, unga arha na asok, utsɛki ikpũ hã iki imɛr iseng, uner ha asi ihwɛnga ubinkpi uku ukorhe. <verse eid="MRK 4:27"/><verse number="28" style="v" sid="MRK 4:28"/>Abĩ nibikake atsu ikpũ imɛr, atirhi akũ agam adzeka, na akũ azang adzeka, nu azanga akũ ishaanga idzeka. <verse eid="MRK 4:28"/><verse number="29" style="v" sid="MRK 4:29"/>Ivang ishaanga iki ikɔ̃, unga aka ikũ ikon agbɛr, ivang iyiki igbɛr iki iwe.&gt;&gt;<verse eid="MRK 4:29"/></para>
  <para style="s1">Unyaka arherhe ishaa umustad</para>
  <para style="r">(<ref loc="MAT 13:31-32">Umat 13.31-32</ref>,<ref loc="MAT 13:34">34</ref>; <ref loc="LUK 13:18-19">Irh 13.18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30"/>Uyesu ikɛi agɛ, &lt;&lt;Umum ikpangu Iyɛrhe Unum nggu use, umum ikũ unyaka arherhe akasong idɛyiwe ngge iki iwe? <verse eid="MRK 4:30"/><verse number="31" style="v" sid="MRK 4:31"/>Iwu ru nyaki ishaa ikpũ umastad, iyiriyɛ ngge iki iwe iyiki icia ri ikpũ abin iyiki idoi nu abĩ. <verse eid="MRK 4:31"/><verse number="32" style="v" sid="MRK 4:32"/>Umbɔ aka idoi ngge, ngge iki isaki iseng igɔngngge abinkɛ umbɔ aka adoi ra abĩ, nggu abokngge akagɔng anunu aka isaka acipuwa akang ashiake nu ake.&gt;&gt;<verse eid="MRK 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33"/>Nggu urhɛrhɛ unyaka arherhe Uyesu aka akũ asɔme anera Arherhu-Num, ri ihwihwɛngmbɔ. <verse eid="MRK 4:33"/><verse number="34" style="v" sid="MRK 4:34"/>Asi isɔmuka umbɔ ubin rimi ru umbɔ uku ushikpɔ ru unyaka arherhe. Bɔr ivangyɛ unga aka awu nggu angwɛ̃ imesanga ikiyikambɔ, unga aka isaka asɔmuka umbɔ agbena.<verse eid="MRK 4:34"/></para>
  <para style="s1">Uyesu adɔɔte ugba inai</para>
  <para style="r">(<ref loc="MAT 8:23-27">Umat 8.23-27</ref>; <ref loc="LUK 8:22-25">Irh 8.22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35"/>Ru unum hã urhɛɛ uku uwe, unga agɔr angwɛ̃ imesanga agɛ, &lt;&lt;Umɛn inggar udiku ukpɔrɔ.&gt;&gt; <verse eid="MRK 4:35"/><verse number="36" style="v" sid="MRK 4:36"/>Umbɔ abɔre ikikɔng anera, umbɔ ashupa unga nggu umbɔ, ru ukhukhɔɔ amɛ̃ unga aka asei ru umgbɔ. Akhukhɔɔ akɔɔ ikɛi awu umɔ. <verse eid="MRK 4:36"/><verse number="37" style="v" sid="MRK 4:37"/>Nggaa ugba ukom ukerketakpɔ usoyi, amɛ̃ ukau ha ukwɛr ukhukhɔɔmbɔ, utsɛku umgbɔ ubɔr ukunjiir ri ididɛɛ ra amɛ̃. <verse eid="MRK 4:37"/><verse number="38" style="v" sid="MRK 4:38"/>Uyesu awu ru urhɔ ra akpok ukhukhɔɔ nu ubin ukpuku utsorhi itsi. Angwɛ̃ imesanga azita unga agɔr agɛ, &lt;&lt;A umarhem, ungo usi igũo ighong umɛn iki iwuri itsĩmɛn?&gt;&gt;<verse eid="MRK 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39"/>Unga asok, atsɛrhu ugba ukukom hã agɔr amɛ̃ ukau ukugɔng hã agɛ, &lt;&lt;Unukutata! Udɔɔr!&gt;&gt; Mɔcɛ ugbaa ukpekpɔ, ananga kishoo anukutata uku ughwɔɔw.<verse eid="MRK 4:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 4:40"/>Unga agɔr angwɛ̃ imesanga agɛ, &lt;&lt;Awu use utsu umbi agũ iwei rimi? Umbi ana ashimbi ri imangmang?&gt;&gt;<verse eid="MRK 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41"/>Umbɔ agũ iwei akarhãrhã agɔr adɔkambɔ agɛ, &lt;&lt;Awu ungaa nuwi? Ugba ukom nu ubvun amɛ̃ agũna unga!&gt;&gt;<verse eid="MRK 4:41"/></para>
  <chapter eid="MRK 4"/>
  <chapter number="5" style="c" sid="MRK 5"/>
  <para style="s1">Uyesu akerhuwe uner ipfu iyiki ibewe</para>
  <para style="r">(<ref loc="MAT 8:28-34">Umat 8.28-34</ref>; <ref loc="LUK 8:36-39">Irh 8.36-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1"/>Umbɔ azĩ atsĩ ugar ukau abĩ Ugarasa. <verse eid="MRK 5:1"/><verse number="2" style="v" sid="MRK 5:2"/>Ivang Uyesu aka adzeku ukhukhɔɔ, unga agbang nggu uner ipfu iyiki ibewe aka adzeka ra anang aka adzak aner. <verse eid="MRK 5:2"/><verse number="3" style="v" sid="MRK 5:3"/>Uner ha asei ra anang akika adzak aner, unera asi idɛ̃ɛ̃ abowpa unga uko nggu inyãwã. <verse eid="MRK 5:3"/><verse number="4" style="v" sid="MRK 5:4"/>Umbɔ aka isaka abow aboknga nu adaknga nggu inyãwã, bɔr unga aka isaka apupuwe ngge na abvũĩwe azɔu aki adaknga. Unera ashia ri iker iyiki ikpɔm unga. <verse eid="MRK 5:4"/><verse number="5" style="v" sid="MRK 5:5"/>Nu utsuu na atenum unga aghɛta ra anang akika adzak aner nu ígũ anu itsuyi ívum na akũ atarh angwãi iyornga.<verse eid="MRK 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6"/>Unga aka anyã Uyesu ukukaa, unga atĩtser aba atararhu ra anangnga. <verse eid="MRK 5:6"/><verse number="7" style="v" sid="MRK 5:7"/>Atsarhi irhaknga atsu ívum agɛ, &lt;&lt;Awu use utoma ungo nggu umum, Uyesu, Ungwɛ̃ Unum uwuku Ugɔng? Uyirh itsok Unum ugɛ ungo usi ídzaango umum uver!&gt;&gt; <verse eid="MRK 5:7"/><verse number="8" style="v" sid="MRK 5:8"/>Ubinkutsu Uyesu aka agɔra unga agɛ, &lt;&lt;Upfudzeka ru utsak uwurɛ, ungo ipfu iyiki ibewe!&gt;&gt;<verse eid="MRK 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9"/>Uyesu arhusa unga agɛ, &lt;&lt;Itsokngo igburh ungamɔ?&gt;&gt;</para>
  <para style="p" vid="MRK 5:9">Unga agɛ, &lt;&lt;Itsokmum igburh Ukpusha, ubinkutsu umɛn iwu irhɛɛmɛn.&gt;&gt; <verse eid="MRK 5:9"/><verse number="10" style="v" sid="MRK 5:10"/>Unga ashɔ̃rhũ Uyesu akarhãrhã utsur unga awayika umbɔ adzembɔ ra anang hã.<verse eid="MRK 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11"/>Arhede arhɛrhɛ aka adɛ̃ɛ̃ ughãwã akhapa ri igũa. <verse eid="MRK 5:11"/><verse number="12" style="v" sid="MRK 5:12"/>Ípfu iyiki ibewe ha ishɔ̃rhũ Uyesu igɛ, &lt;&lt;Uma udena umɛn izĩ ru arhede akɔrɔ, itsĩ ra ake.&gt;&gt; <verse eid="MRK 5:12"/><verse number="13" style="v" sid="MRK 5:13"/>Nggee unga abemuka ípfu iyiki ibewe ha idzek izĩngge ru ikpui arhede ha. Ikpui arhede ha itsĩngge anaka agɔnga avaa, ake asok atĩtser, ahwarha acipa atsĩke ru ukau atsĩmke ra amɛ̃.<verse eid="MRK 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14"/>Abi idzɛu arhede ha atĩ azĩ asɔme uteumbɔ nu ukpuku ukhapa umɔ adzise isarhe, anera adzeyi aba inyã ubinkpi uku ukorhe. <verse eid="MRK 5:14"/><verse number="15" style="v" sid="MRK 5:15"/>Umbɔ aka aba atsĩ ru Uyesu umbɔ anyã utsak ha ukpui ípfu iyiki ibewe ha iki iwe ru unga, asei umɔ atsim atorho ri iyornga amɛnnga awu uku urhirhiki, iwei ifɛr umbɔ. <verse eid="MRK 5:15"/><verse number="16" style="v" sid="MRK 5:16"/>Abirabɛ aka anyã ifɛrha ha iki ikorhe adzowe isarhe abinkɛ aka akorhe nggu uner ukpui ípfu iyiki ibewe nu ikpui arhede ha. <verse eid="MRK 5:16"/><verse number="17" style="v" sid="MRK 5:17"/>Mɔcɛ anera atirhi ishɔ̃rhũ Uyesu unga abɔre abĩmbɔ.<verse eid="MRK 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18"/>Uyesu awuri itsĩ ru ukhukhɔɔ amɛ̃ nukpi, utsak ha ípfu iyiki ibewe ha iki idzeku unga ashɔ̃rhũ Uyesu ama aneke unga adɔsa unga. <verse eid="MRK 5:18"/><verse number="19" style="v" sid="MRK 5:19"/>Bɔr Uyesu asi inekuka unga. Agɔr unga agɛ, &lt;&lt;Uzĩ ri iya ra angwɛ̃mbi, usɔme umbɔ abin aka agɔngkɛ Uteijee aka akorhuwa ungo, nu atorhkɛ unga aka agũ ru ungo.&gt;&gt; <verse eid="MRK 5:19"/><verse number="20" style="v" sid="MRK 5:20"/>Nggee utsak ha, azĩ atsĩrhã ri iteu usɔka umbɔ iki iyisa Udikaforhi adzise isarhe, abinkɛ Uyesu aka akorhuwe unga. Anera kishoo adzeidzeu.<verse eid="MRK 5:20"/></para>
  <para style="s1">Unapa Uyayiru nu utsɛrh uwuku <optbreak/> urhong adzirh</para>
  <para style="r">(<ref loc="MAT 9:18-26">Umat 9.18-26</ref>; <ref loc="LUK 8:40-56">Irh 8.40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21"/>Ikɛi ivang Uyesu aka agar ugar ukpɔrɔ ru ukhukhɔɔ amɛ̃, anera arhɛrhɛ akɔng adziir unga nu ubang ukau ha. <verse eid="MRK 5:21"/><verse number="22" style="v" sid="MRK 5:22"/>Mɔcɛ unying ra anggbaashi ubã ifɛn-Num itsoka igburh Uyayiru, aba umɔ. Unga aka anyã Uyesu, unga agba ra adaknga, <verse eid="MRK 5:22"/><verse number="23" style="v" sid="MRK 5:23"/>ashɔ̃rhã unga agɛ, &lt;&lt;Ungwɛ̃rhũ unapmum akpurha abɔr akpe. Umum ishɔ̃rhã ungo uba utsorhu ubokngo nu unga akerhe na abɛk.&gt;&gt; <verse eid="MRK 5:23"/><verse number="24" style="v" sid="MRK 5:24"/>Nggee Uyesu azĩã nggu unga.</para>
  <para style="p" vid="MRK 5:24">Anera arhɛrhɛ aka afĩĩ adɔsa unga. <verse eid="MRK 5:24"/><verse number="25" style="v" sid="MRK 5:25"/>Utsɛrh uwɔɔ umɔ aghong irhãrhã umɛ̃ɛ̃ imɛka usɔkdũmɛn. <verse eid="MRK 5:25"/><verse number="26" style="v" sid="MRK 5:26"/>Irhãrhãnga ighong unga akarhãrhã ri ivangyɛ abi agɔu arhɛrhɛ aka anɛta unga. Afɛre ubinkpi unga aka awerakpɔ kishoo, bɔr asi igũa ugarh, irhãrhã ikpurhi idɛ̃ɛ̃ ititoma. <verse eid="MRK 5:26"/><verse number="27" style="v" sid="MRK 5:27"/>Ivangyɛ unga aka agũ isarhe Uyesu, unga adɔsa unga ra andzing ri ikikɔnga, aba abanga atorho Uyesu, <verse eid="MRK 5:27"/><verse number="28" style="v" sid="MRK 5:28"/>ubinkutsu unga akaifɛrhkɔ ra amɛnnga agɛ, &lt;&lt;Umum ĩba ĩbangumum atorhanga ukpekũ, umum iwuri ikerhumum.&gt;&gt; <verse eid="MRK 5:28"/><verse number="29" style="v" sid="MRK 5:29"/>Kanying umɛ̃ɛ̃nga udɛ̃ɛ̃kpɔ, nu unga agũã ri iyornga aka akerhunga ru ayetnumnga.<verse eid="MRK 5:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 5:30"/>Kanying Uyesu agũ ijee iki idze ru unga. Unga adzipa ri ikikɔnga arhusa agɛ, &lt;&lt;Ungamɔ abanga atorhamum?&gt;&gt;<verse eid="MRK 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31"/>Angwɛ̃ imesanga agɔr unga agɛ, &lt;&lt;Ungo unyã anera arhɛrhɛ afĩĩa ungo riminɛ ungo ugɔr ugɛ, &lt;Ungaa abanga umum?&gt; &gt;&gt;<verse eid="MRK 5:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32"/>Bɔr Uyesu arhi adziir abee inyã uwuku ukorhu ubin hã. <verse eid="MRK 5:32"/><verse number="33" style="v" sid="MRK 5:33"/>Mɔcɛ utsɛrh ha, aka ahwɛng ubinkpi uku ukorhuwe unga, aba nggu iwei nu izang iyor, agba ra anangnga adɛyiwe unga kishoo idzidzɛrhe. <verse eid="MRK 5:33"/><verse number="34" style="v" sid="MRK 5:34"/>Unga agɔr unga agɛ, &lt;&lt;A unapmum, imangmango ngge ikerhuwa ungo. Uzĩ uku utɔɔ, ayetnumngo aka amaake.&gt;&gt;<verse eid="MRK 5:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35"/>Uyesu ana awu ra arherhe nukpi, nu anera adzeki iya Uyayiru unggbaashi ubã ifɛn-Num hã, aba agɔr agɛ, &lt;&lt;Unapungo aka akpea. Awu use utsu ungo unu idzowe umarhem ayetnum?&gt;&gt;<verse eid="MRK 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36"/>Bɔr Uyesu akwɛɛte arherhambɔ, agɔr unggbaashi ubã ifɛn-Num hã agɛ, &lt;&lt;Niba ugũa iwei, uwe ru imangmang ukpekũ.&gt;&gt;<verse eid="MRK 5:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 5:37"/>Asi ineke unera azĩã nggu unga, akpurha akũ Ubitru, nu Uyaku, nu Uyohana ungwɛ̃mbɔ Uyaku. <verse eid="MRK 5:37"/><verse number="38" style="v" sid="MRK 5:38"/>Ivang umbɔ aka azĩ atsĩ ri iya unggbaashi ubã ifɛn-Num hã, Uyesu anyã idzidzunambɔ, nu anera aka aciu akpe atsui ivum. <verse eid="MRK 5:38"/><verse number="39" style="v" sid="MRK 5:39"/>Unga atsĩ agɔr umbɔ agɛ, &lt;&lt;Awu use utsu umbi aciu akpe na atsui ívum rimi? Una hã anasi ikpea awu ru urhɔ!&gt;&gt; <verse eid="MRK 5:39"/><verse number="40" style="v" sid="MRK 5:40"/>Bɔr umbɔ anyĩrhã unga.</para>
  <para style="p" vid="MRK 5:40">Nggee unga atsu umbɔ adzek ra awiya, unga akũ utesa nu uyisa una hã nu angwɛ̃ imesanga hã abika awu nggu unga, atsĩ ra anangkɛ una hã aka awe. <verse eid="MRK 5:40"/><verse number="41" style="v" sid="MRK 5:41"/>Adzur ubok una hã agɔr agɛ, &lt;&lt;Tarhita kumi!&gt;&gt; agbena agburh &lt;&lt;Unakuci, umum igɔr ungo, usisok!&gt;&gt; <verse eid="MRK 5:41"/><verse number="42" style="v" sid="MRK 5:42"/>Kanying una hã asok azɛ̃rhã adziir. Imɛknga iwu usɔkdũmɛn. Akɛrɛ ha atsu umbɔ adzeidzeu akarhãrhã. <verse eid="MRK 5:42"/><verse number="43" style="v" sid="MRK 5:43"/>Uyesu agbiite atombɔ akarhãrhã ugɛ umbɔ niba adɛyikumbɔ unera. Ikɛi unga agɔr umbɔ adzowe ubingha ru una hã.<verse eid="MRK 5:43"/></para>
  <chapter eid="MRK 5"/>
  <chapter number="6" style="c" sid="MRK 6"/>
  <para style="s1">Akpɛ̃mbɔ Uyesu ru Unazarat</para>
  <para style="r">(<ref loc="MAT 13:53-58">Umat 13.53-58</ref>; <ref loc="LUK 4:16-30">Irh 4.16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1"/>Uyesu asoka umɔ abvui azĩã Unazarat utepunga, angwɛ̃ imesanga azĩ nggu unga. <verse eid="MRK 6:1"/><verse number="2" style="v" sid="MRK 6:2"/>Unum ukpuku uwosha uku uwe, unga atirha amesuwe ru ubã ifɛn-Num, anera arhɛrhɛ aka agũ unga, adzeidzeu na arhusa agɛ, &lt;&lt;Utsak uwurɛ akpo abin akɛrɛ ri inɛ̃ɛ̃? Adzowe unga itsoi iyɛrɛ ri inɛ̃ɛ̃ unga aka anu ikorha abin idzeu? <verse eid="MRK 6:2"/><verse number="3" style="v" sid="MRK 6:3"/>Uwɛrɛ ha asi iwea ukapinta ha, ungwɛ̃ Umaryamu, ungwɛ̃mbɔ Uyaku, nu Uyusuf, nu Uyahuda nu ikɛi Usiman? Asi iwea anapumbɔ abɛ nggu umɛn?&gt;&gt; Umbɔ akpɛ̃mbɔ unga.<verse eid="MRK 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Uwuku usɔm Arherhu-Num aka isaka akpoa igɔng ru ubɛn ananga, akpurha asheru utepunga nu anernga nu abi iyanga.&gt;&gt; <verse eid="MRK 6:4"/><verse number="5" style="v" sid="MRK 6:5"/>Unga asi idɛ̃ɛ̃ akorhunga abin idzeu nggɔɔ ha, unga akpurha atsorhuwe abok nu abi irhãrhã ukunjiir akerhuwe umbɔ.<verse eid="MRK 6:5"/></para>
  <para style="s1">Uyesu adene angwɛ̃ imesanga</para>
  <para style="r">(<ref loc="MAT 10:5-15">Umat 10.5-15</ref>; <ref loc="LUK 9:1-6">Irh 9.1-6</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 6:6"/>Unga adzeidzeu umbɔ aka ashimbɔ ri imangmang.</para>
  <para style="p" vid="MRK 6:6">Mɔcɛ Uyesu atsĩrhã adziir íteu iyiki ici umɔ hã amesuwe anera. <verse eid="MRK 6:6"/><verse number="7" style="v" sid="MRK 6:7"/>Unga ayisa angwɛ̃ imesanga usɔkdũmɛn hã azĩ ru unga, unga adene umbɔ ivaivaa na adzowe umbɔ ijee ri itsi ípfu iyiki ibewe.<verse eid="MRK 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 6:8"/>Unga agɔr umbɔ agɛ, &lt;&lt;Niba anyangumbi ubin ru uzɛ̃rhã hã, umbi akpurha akpɔm igbong, niba akpɔmmbi ubingha, use ijara, use uhwɛk ri íbvuk atorhambi. <verse eid="MRK 6:8"/><verse number="9" style="v" sid="MRK 6:9"/>Àka atsu abadak bɔr niba akpɔmmbi atorho akɔɔ. <verse eid="MRK 6:9"/><verse number="10" style="v" sid="MRK 6:10"/>Ubɛn iya umbi aka itsĩ, àka asei umɔ utsɛku unumkpi umbi aka isok ru uteu ha. <verse eid="MRK 6:10"/><verse number="11" style="v" sid="MRK 6:11"/>Ubɛn anangkɛ umbɔ aka asi iyɛimbɔ umbi use aba asi ikpembɔ ato ru umbi, àka awashuwe uzurhu adakmbi ivangyɛ umbi aka isok, umgbɔ uwu ideka iyiki ibewe ra atsimbɔ.&gt;&gt;<verse eid="MRK 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12"/>Umbɔ adzek adzowe isarhe ugɛ anera adzipa. <verse eid="MRK 6:12"/><verse number="13" style="v" sid="MRK 6:13"/>Umbɔ atsusuwe ípfu iyiki ibewe írhɛirhɛ, na adzukuwe atsei ra abi írhãrhã arhɛrhɛ akerhuwe umbɔ.<verse eid="MRK 6:13"/></para>
  <para style="s1">Akpe Uyohana Uner Ubɔtisima</para>
  <para style="r">(<ref loc="MAT 14:1-12">Umat 14.1-12</ref>; <ref loc="LUK 9:7-9">Irh 9.7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14"/>Uyɛrhe Uhiridu aka agũ abin akɛrɛ kishoo, ubinkutsu umbɔ ahwɛng itsok Uyesu imaa ananga. Abɔɔ agɛ, &lt;&lt;Uyohana Uner Ubɔtisima unga asok ra akpe. Ngge itsu unga awe ru ijee iyiki ikorha abin idzeu ha.&gt;&gt;<verse eid="MRK 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15"/>Abɔɔ agɛ, &lt;&lt;Awu uner uwuku usɔm Arherhu-Num Uirhiya.&gt;&gt;</para>
  <para style="p" vid="MRK 6:15">Abɔɔ igambɔ agɛ, &lt;&lt;Awu uner uwuku usɔm Arherhu-Num uwɔɔ, uwu abi isha.&gt;&gt;<verse eid="MRK 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16"/>Ivangyɛ Uhiridu aka agũ akɛrɛ, unga agɛ, &lt;&lt;Uyohana, unerwi umum iki izharhuwe itsinga, unga asoka akpe!&gt;&gt;<verse eid="MRK 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 6:17"/>Ubinkutsu Uhiridu nibikanga atsumbɔ adzur Uyohana, abow unga na atsuke ru ugborzĩ, ri itsi Uhirudiya. Utsɛrha ungwɛ̃mbɔ Ufirhibu unga aka apfuna. <verse eid="MRK 6:17"/><verse number="18" style="v" sid="MRK 6:18"/>Uyohana aka isaka arherhu Uhiridu agɛ, &lt;&lt;Asi izea ungo uku upfunu utsɛrha ungwɛ̃mbi.&gt;&gt; <verse eid="MRK 6:18"/><verse number="19" style="v" sid="MRK 6:19"/>Nggee Uhirudiya agũ avɔm Uyohana na abee ifɛre unga. Bɔr Uhiridu asi ibemuka. <verse eid="MRK 6:19"/><verse number="20" style="v" sid="MRK 6:20"/>Ubinkutsu Uhiridu agũ iwei Uyohana na agana unga, ahwɛnga Uyohana arhika na awu usarkasar uner. Ubɛn ivangyɛ Uhiridu aka igũ arherhu Uyohana, unga aka isaka adzununga, rimi hã unga anang agũibɛn ikpeto ru unga.<verse eid="MRK 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21"/>Ri imimasha ivanga ibangge ru Uhirudiya. Ru unum imar Uhiridu ivangyɛ unga aka azek irhowa, ayisa ayɛrhe abĩnga kishoo nu akagɔng abi iwa, nu akakũ abi Ugarhirhi. <verse eid="MRK 6:21"/><verse number="22" style="v" sid="MRK 6:22"/>Ivangyɛ unapa Uhirudiya aka atsĩ azer azer, ake atsĩ ra amɛn Uhiridu nu atsennga.</para>
  <para style="p" vid="MRK 6:22">Nggee uyɛrhe agɔr una hã agɛ, &lt;&lt;Urhusa umum ubinkpi ungo uku ubee, umum iwuri ĩdzaamum ungo.&gt;&gt; <verse eid="MRK 6:22"/><verse number="23" style="v" sid="MRK 6:23"/>Unga ayirh nggu uyirh abemuwe una hã agɛ, &lt;&lt;Ubɛn ubinkpi ungo uku urhusa umum iwuri ĩdzaamum ungo, utsɛku uteng iyɛrhamum.&gt;&gt;<verse eid="MRK 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24"/>Una hã adzek azĩ arhusu uyanga agɛ, &lt;&lt;Umum iwuri irhusu use?&gt;&gt;</para>
  <para style="p" vid="MRK 6:24">Uyanga agɔr unga agɛ, &lt;&lt;Itsi Uyohana Uner Ubɔtisima.&gt;&gt;<verse eid="MRK 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25"/>Kanying una hã abvui atĩ azĩã ru uyɛrhe agɔr agɛ, &lt;&lt;Umum ibee icɛrɛ ungo udzaa itsi Uyohana Uner Ubɔtisima ri itɛ̃rhĩ.&gt;&gt;<verse eid="MRK 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26"/>Amɛn Uyɛrhe aghong akarhãrhã, bɔr uyirhnga aka ayirh ra asu atsennga, itsu unga asi idɛ̃ɛ̃ akɛna unga. <verse eid="MRK 6:26"/><verse number="27" style="v" sid="MRK 6:27"/>Nggee kanying unga adene undɔsu uyɛrhe akũ itsi Uyohana akũ aba. Utsa ha azĩ azharhe itsi Uyohana ru ugborzĩ. <verse eid="MRK 6:27"/><verse number="28" style="v" sid="MRK 6:28"/>Akũ itsi ha ri itɛ̃rhĩ akũ aba. Adzowe ru una hã, unga ayɛi adzowe ru uyanga. <verse eid="MRK 6:28"/><verse number="29" style="v" sid="MRK 6:29"/>Angwɛ̃ imesu Uyohana aka agũ isarhe ha, umbɔ aba ashupu ukom Uyohana adzake.<verse eid="MRK 6:29"/></para>
  <para style="s1">Uyesu afuka anera anakagɔnga atɔ̃ɔ̃</para>
  <para style="r">(<ref loc="MAT 14:13-21">Umat 14.13-21</ref>; <ref loc="LUK 9:10-17">Irh 9.10-17</ref>; <ref loc="JHN 6:1-14">Uyoh 6.1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30"/>Uner itser Uyesu akɔng adziir Uyesu na adɛyiwe unga kishoo abinkɛ umbɔ aka akorhe na amesuwe. <verse eid="MRK 6:30"/><verse number="31" style="v" sid="MRK 6:31"/>Mɔcɛ, anera arhɛrhɛ aka anu iba na adzek utsɛku umbɔ asi ikpombɔ ivang igha ubin, unga agɔr umbɔ agɛ, &lt;&lt;Àka aba nggu umum umɛn izĩ ra anangkɛ anera aka ashimbɔ umɔ, umɛn iwosha ukunjiir.&gt;&gt;<verse eid="MRK 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 6:32"/>Nggee umbɔ atsĩ ukhukhɔɔ amɛ̃ azĩmbɔ anangkɛ anera aka ashimbɔ umɔ. <verse eid="MRK 6:32"/><verse number="33" style="v" sid="MRK 6:33"/>Bɔr umbɔ aka isoka anang hã, anera arhɛrhɛ aka anyã umbɔ ahwɛngmbɔ umbɔ. Atĩ ra adak adzeyi ri íteu kishoo, anggbaashia azĩ atsĩmbɔ ru umbɔ. <verse eid="MRK 6:33"/><verse number="34" style="v" sid="MRK 6:34"/>Uyesu aka acipa ru ukhukhɔɔ anyã arhɛrha anera aka akɔng. Unga agũ atorh umbɔ, ubinkutsu umbɔ awu ru nyaki ídɔi iki ishingge ru uner idzɛu. Nggee unga atirha amesuwe umbɔ abina arhɛrhɛ.<verse eid="MRK 6:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35"/>Unum uku uyo itsitsĩ, nggee angwɛ̃ imesanga aba agɔr unga agɛ, &lt;&lt;Anera ashimbɔ ra anang akɛrɛ, nggayɛ unum uku uwuri itsĩkpɔ. <verse eid="MRK 6:35"/><verse number="36" style="v" sid="MRK 6:36"/>Udene anera umbɔ atsĩ íteu nu ícang iyiki ikhapa nggimi agoi ubin umbɔ aka igha.&gt;&gt;<verse eid="MRK 6:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37"/>Bɔr unga agɔr umbɔ agɛ, &lt;&lt;Umbi àka adzowe umbɔ ubin umbɔ agha.&gt;&gt;</para>
  <para style="p" vid="MRK 6:37">Umɔ umbɔ agɔr unga agɛ, &lt;&lt;Ugɛ umɛn izĩ igoi ubingha ukpu imang uner itser afɛ̃ɛ̃ utɔrɔk! Umɛn izĩ ifɛre imang iyɛrɛ ru ubingha ni idzowe umbɔ agha?&gt;&gt;<verse eid="MRK 6:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38"/>Unga agɔr umbɔ agɛ, &lt;&lt;Umbi awu ra aborodi asong nggu umbi? Àka azĩ arhi.&gt;&gt;</para>
  <para style="p" vid="MRK 6:38">Umbɔ aka azĩ arhi, umbɔ agɛ, &lt;&lt;Aborodi atɔ̃ɔ̃, nu abɛrh avaa.&gt;&gt;<verse eid="MRK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39"/>Uyesu atsu umbɔ agɔr anera asei ukpukpusha nu ubĩĩ uku usum. <verse eid="MRK 6:39"/><verse number="40" style="v" sid="MRK 6:40"/>Nggee umbɔ asei ukpukpusha abɔɔ ananaka abɔɔ isɔka itɔ̃itɔ̃ɔ̃. <verse eid="MRK 6:40"/><verse number="41" style="v" sid="MRK 6:41"/>Unga aka anyangu aborodi ha ikitɔ̃nake nu abɛrh ha ikivarhake, aberi itsinga arhi afã, atar uwɛɛ na atsɔku uborodi ha. Mɔcɛ unga adzise angwɛ̃ imesanga umbɔ akũ azĩ adene anera. Ikɛi unga agashuwe abɛrh ha ikivarhake ru umbɔ kishoo. <verse eid="MRK 6:41"/><verse number="42" style="v" sid="MRK 6:42"/>Kishoo agha, ashuurmbɔ. <verse eid="MRK 6:42"/><verse number="43" style="v" sid="MRK 6:43"/>Angwɛ̃ imesa arhɔ̃yĩ awushu uborodi ha nu abɛrh ha atɔk azĩnga usɔkdũmɛn. <verse eid="MRK 6:43"/><verse number="44" style="v" sid="MRK 6:44"/>Irhɛ anera aka agha ubingha ha, akatsak awu anakagɔnga atɔ̃ɔ̃.<verse eid="MRK 6:44"/></para>
  <para style="s1">Uyesu azɛ̃rhũ uzɛ̃rhã afafã nu amɛ̃</para>
  <para style="r">(<ref loc="MAT 14:22-36">Umat 14.22-36</ref>; <ref loc="JHN 6:15-21">Uyoh 6.15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45"/>Kanying Uyesu atsu angwɛ̃ imesanga atsĩ ru ukhukhɔɔ amɛ̃ agbaashia azĩ ugar Ubetsaida, na asoyiwe ikikɔnga. <verse eid="MRK 6:45"/><verse number="46" style="v" sid="MRK 6:46"/>Unga aka asoyiwe umbɔ amaa, unga afũã igũ azĩã ifɛn-Num.<verse eid="MRK 6:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 6:47"/>Urhɛɛ uku uwe, ukhukhɔɔ amɛ̃ hã uwe ra ateu ukau, unga awu ikiyikanga nu abĩ. <verse eid="MRK 6:47"/><verse number="48" style="v" sid="MRK 6:48"/>Unga anyã angwɛ̃ imesanga atɛ̃wã ikpikpayi, ugba ukɛnkpɔ umbɔ izĩ ra asu. Utsar ukpu akara ataar aki utsuu unga azĩã ru umbɔ, azɛ̃rhã afafã nu amɛ̃ ukau ha. Unga abee ifara umbɔ atɔng, <verse eid="MRK 6:48"/><verse number="49" style="v" sid="MRK 6:49"/>bɔr umbɔ aka anyã unga azɛ̃rhã afafã nu ukau amɛ̃ hã, umbɔ atsar ugɛ awu imãrhã. Umbɔ atsu ivum, <verse eid="MRK 6:49"/><verse number="50" style="v" sid="MRK 6:50"/>Umbɔ aka anyã unga, umbɔ agbipa kishookambɔ.</para>
  <para style="p" vid="MRK 6:50">Kanying unga arherhe arherhe nggu umbɔ agɛ, &lt;&lt;Àka aker amɛnmbi! Awu umum. Niba agũmbi iwei!&gt;&gt; <verse eid="MRK 6:50"/><verse number="51" style="v" sid="MRK 6:51"/>Unga atsĩã ru ukhukhɔɔ nggu umbɔ, mɔcɛ ugbaka ukpekpɔ. Umbɔ adzeidzeu akarhãrhã, <verse eid="MRK 6:51"/><verse number="52" style="v" sid="MRK 6:52"/>umbɔ asi ihwɛngmbɔ agben aki ubingha ukpu inera anakagɔnga atɔ̃ɔ̃ hã, ubinkutsu, amɛnmbɔ asi iyɛike.<verse eid="MRK 6:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53"/>Umbɔ aka agar ukau ha, umbɔ acipa ra abĩ Ujanisarat, abope ukhukhɔɔ amɛ̃ hã nu angwĩ ukau ukugɔng hã. <verse eid="MRK 6:53"/><verse number="54" style="v" sid="MRK 6:54"/>Ubɛn umbɔ aka adzek ru ukhukhɔɔ amɛ̃ hã, kanying anera ahwɛngmbɔ ugɛ awu Uyesu. <verse eid="MRK 6:54"/><verse number="55" style="v" sid="MRK 6:55"/>Umbɔ atĩna adzeyiwa ra abĩmbɔ kishoo akũna abi irhãrhã ra afarmbɔ akũ azĩ kishoo ra anangkɛ Uyesu aka awe. <verse eid="MRK 6:55"/><verse number="56" style="v" sid="MRK 6:56"/>Kishoo anangkɛ unga aka izĩ, iteu iki igɔng, use iteu iki ici, umbɔ angwɛ̃we abi irhãrhã ra angwĩ anang izɛɛ. Na ashɔ̃rhã unga ru abi irhãrhã hã abangu utɛm ibang atorhanga. Kishoo abirabɛ aka akpo ibibanga akerhumbɔ.<verse eid="MRK 6:56"/></para>
  <chapter eid="MRK 6"/>
  <chapter number="7" style="c" sid="MRK 7"/>
  <para style="s1">Ugau anggbaashi</para>
  <para style="r">(<ref loc="MAT 15:1-9">Umat 15.1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1"/>Abi Ufarisi nu abɔɔ abika amesuwe Ikpem aka adzeku Urusharhima aba akɔng adziir Uyesu. <verse eid="MRK 7:1"/><verse number="2" style="v" sid="MRK 7:2"/>Na anyã angwɛ̃ imesanga agha ubingha nggu abok arhim, asi isorhmbɔ abokmbɔ aka awu agbeyambɔ.<verse eid="MRK 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3"/>Abi Ufarisi nggu abi Uyahuda kishoo aka isaka asorh abokmbɔ akata na adɔrha agha ubingha, ubinkutsu awu ugau agbeyi akakũmbɔ. <verse eid="MRK 7:3"/><verse number="4" style="v" sid="MRK 7:4"/>Ivangyɛ umbɔ aka idzeki izɛɛ abvui aba ri iya, asi íghambɔ ubin, umbɔ awuri igbaashia adɔsa agbeyambɔ asorh ayormbɔ kata. Na asorh akpɛwa nu ídzum amɛ̃ nu atɛ̃rhĩ nu andzoma nu atseu.<verse eid="MRK 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5"/>Nggee abi Ufarisi nu abika amesuwe Ikpem arhusu Uyesu agɛ, &lt;&lt;Awu use utsu angwɛ̃ imesango asi idɔsumbɔ ugau akakũ na anu igha abin nggu abok arhim?&gt;&gt;<verse eid="MRK 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Irhikungge Uishaya aka asɔm Arherhu-Num ra atsimbi abi ukpukpeta agɛ,</para>
  <para style="q1" vid="MRK 7:6">&lt;&lt; &lt;Aner abɛrɛ adzaa umum igɔng ra angwĩ,</para>
  <para style="q2" vid="MRK 7:6">bɔr amɛnmbɔ aderke nggu umum.<verse eid="MRK 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7"/>Umbɔ adzaa umum igɔng ibɛm,</para>
  <para style="q2" vid="MRK 7:7">anu imesuwe ikpem anera ugɛɛ Unum adzowe umbɔ.&gt;<note caller="+" style="f"><char style="fr" closed="false">7.7 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="ISA 29:13">Uish 29.13</ref></char>.</note><verse eid="MRK 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8"/>&lt;&lt;Umbi aka atarkumbi ikpem Unum, umbi adɔsa agau anera.&gt;&gt;<verse eid="MRK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9"/>Na agɔr umbɔ agɛ, &lt;&lt;Umbi aka akpombi anang umbi aka angwɛ̃we Ikpem Unum ngge itsú umbi idɔsa agaumbi! <verse eid="MRK 7:9"/><verse number="10" style="v" sid="MRK 7:10"/>Umusa agɔr agɛ, &lt;Udzowe imor ru utɛngo nu uyango,&gt;<note caller="+" style="f"><char style="fr" closed="false">7.10 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="EXO 20:12">Idzi 20.12</ref>; <ref loc="DEU 5:16">Iva 5.16</ref></char>.</note> nu &lt;Ikɛi, uwuruwi aka arhenu utɛnga use uyanga, awu ufang umbɔ afɛre unga.&gt;<note caller="+" style="f"><char style="fr" closed="false">7.10 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="EXO 21:17">Idzi 21.17</ref>; <ref loc="LEV 20:9">Urha 20.9</ref></char>.</note> <verse eid="MRK 7:10"/><verse number="11" style="v" sid="MRK 7:11"/>Bɔr umbi aka isaka agɔr agɛ unera aba agɔr utɛnga use uyanga agɛ, &lt;Ubin hã uwu izũwã iyi Unum.&gt; <verse eid="MRK 7:11"/><verse number="12" style="v" sid="MRK 7:12"/>Rimi hã, umbi akɛnmbi unga ikorhu ubɛn ubin ayike utɛnga use uyanga. <verse eid="MRK 7:12"/><verse number="13" style="v" sid="MRK 7:13"/>Rimi hã umbi afɔ̃rhũwe Arherhu-Num na adɔsa agbeyi ha umbi aki imesuwe angwɛ̃mbi. Ikɛi umbi aki ikorhe abin arhɛrhɛ ru nyaka ha.&gt;&gt;<verse eid="MRK 7:13"/></para>
  <para style="s1">Abinkɛ aki itsu unera asi isara</para>
  <para style="r">(<ref loc="MAT 15:10-20">Umat 15.10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14"/>Ikɛi Uyesu ayisu ikikɔng hã iba ru unga agɔr umbɔ agɛ, &lt;&lt;Ubɛn unera akpeto ru umum, aka ahwɛng akɛrɛ. <verse eid="MRK 7:14"/><verse number="15" style="v" sid="MRK 7:15"/>Asi iwea abin awiya aki itsĩ ru unera atsu unga asi isara, abinkɛ aka idzeyiwa ra amɛn unera atsu unga asi isara ra asu Unum.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">7.15 </char><char style="ft" closed="false">Abvur akɔɔ aki itsɛng abok aki isha agɔrke ikɛi ugɛ, </char><char style="fv" closed="false">16</char><char style="fqa" closed="false">Kishoo uner ato aka agũ, unga agũ!</char></note><verse eid="MRK 7:15"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17"/>Unga aka asok ri ikikɔng hã na atsĩã ri iya, angwɛ̃ imesanga arhusa unga agben unyaka arherhe ha. <verse eid="MRK 7:17"/><verse number="18" style="v" sid="MRK 7:18"/>Unga agɔr umbɔ agɛ, &lt;&lt;Umbi adzuna? Umbi asi ihwɛngmbi ugɛ abinkɛ aka adzeka awiya atsĩ ru unera asi ítsu unga asi isara ra asu Unum? <verse eid="MRK 7:18"/><verse number="19" style="v" sid="MRK 7:19"/>Abin hã asi itsĩke ra amɛnnga bɔr atsĩ ra anaanga, na adzek ri iyornga.&gt;&gt; Ra arherhe akɛrɛ Uyesu adɛyiwe ugɛ abingha kishoo awu asarsatake.<verse eid="MRK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20"/>Agɛ, &lt;&lt;Ubinkpi iki idzeyiwa ra amɛn unera awu ukpɔ utsu unga asi isara ra asu Unum. <verse eid="MRK 7:20"/><verse number="21" style="v" sid="MRK 7:21"/>Ubinkutsu iwu ru unɔrkang amɛn unera, ifɛrhkɔ iyiki ibewe iki idzeyiwa, arhim irha ukutsɛrh use ukutsak, nu ivɛu, nu ifɛr uner nu itoma-dak, <verse eid="MRK 7:21"/><verse number="22" style="v" sid="MRK 7:22"/>nu ikpona, nu iyiki ibewe, nu irhirhɛm, nu anyɔna, nu unyɛ̃ɛ̃ nu idakuwe itsok, nu iberi itsi nu ibemitsi, nu ikɛi ishera amɛn. <verse eid="MRK 7:22"/><verse number="23" style="v" sid="MRK 7:23"/>Kishoo abin aka abewe akɛrɛ adzeyiwa ra amɛn unera, ake atsu unera asi isara ra asu Unum.&gt;&gt;<verse eid="MRK 7:23"/></para>
  <para style="s1">Imangmang utsɛrh uwɔɔ</para>
  <para style="r">(<ref loc="MAT 15:21-28">Umat 15.21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24"/>Uyesu abɔruka anang hã na asok azĩã abĩ Utaya nu Usidon. Atsĩ ri iya ikɔɔ asi ibeenga unera ahwɛng, rimi hã unga afɔr iwiwoi adaka. <verse eid="MRK 7:24"/><verse number="25" style="v" sid="MRK 7:25"/>Idzidzɛrhe, kanying utsɛrh uwɔɔ, uwuruwi ungwɛ̃rhũ unapunga aka awe ru ipfu iyiki ibewe aka agũ isarhe ri itsinga, aba agba ra adaknga. <verse eid="MRK 7:25"/><verse number="26" style="v" sid="MRK 7:26"/>Awu utsɛrh abĩ Uherhini, amar unga udiku ugbɛr uwu Ufinikiya. Unga ashɔ̃rhũ Uyesu ama atsũwe ipfu iyiki ibewe ru unapunga.<verse eid="MRK 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 7:27"/>Uyesu agɔr unga agɛ, &lt;&lt;Uneke awɛkaci agbaashia agha kishoo ubinkpi umbɔ aka abee, ubinkutsu isi irhikungge umbɔ anyangu ubingha awɛkaci atsuke íjui.&gt;&gt;<verse eid="MRK 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28"/>Bɔr utsɛrh ha agɛ, &lt;&lt;Ĩĩ, Uteijee, bɔr ru adak utebur íjui iki isaki ighangge awushu ubingha aka idze ra abok awɛkaci agbei.&gt;&gt;<verse eid="MRK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29"/>Uyesu agɔr unga agɛ, &lt;&lt;Iwu idzidzɛrhe, uzĩ ri iya, ipfu iyiki ibewe iki idzengge ru unapungo.&gt;&gt;<verse eid="MRK 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30"/>Unga abvui azĩ ri iya anyã unapa anu nu ukoma, ipfu iyiki ibewe iki idzengge ru unga.<verse eid="MRK 7:30"/></para>
  <para style="s1">Uyesu akerhuwe ugbau uwuku <optbreak/> ufɔr arherhe adaka</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31"/>Mɔcɛ Uyesu adzek udiku ugbɛr Utaya adɔsu udiku Usidon, azĩã Ukau Ugarhirhi nu utsĩndĩ uku uzĩ iteu usɔka umbɔ iki iyisa Udikaforhi. <verse eid="MRK 7:31"/><verse number="32" style="v" sid="MRK 7:32"/>Nggɔɔ ha umbɔ aka akowe unga uner igbau uwuku ufɔr arherhe adaka, umbɔ ashɔ̃rhã unga atsorhu ubok nu uner ha.<verse eid="MRK 7:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 7:33"/>Nggee Uyesu adarhu uner igbau ha akũ azĩã, adzeka ri ikikɔng hã, atsu itoknga ra ato utsak ha. Unga atar aci akũ abanguwe arhɛm utsak ha. <verse eid="MRK 7:33"/><verse number="34" style="v" sid="MRK 7:34"/>Na abere arhi afafã agbiir uwoi ughorghotakpɔ, agɔr unga agɛ, &lt;&lt;Iffata!&gt;&gt; Agbena agɛ, &lt;&lt;Uyanga!&gt;&gt; <verse eid="MRK 7:34"/><verse number="35" style="v" sid="MRK 7:35"/>Kanying unga aka arherhe rimi, ato utsak ha ayanga, urhɛmnga ugarhe unga atirhunga arherhe azezee.<verse eid="MRK 7:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 7:36"/>Uyesu atsu umbɔ niba adɛyikumbɔ unera. Bɔr ubɛn unga aka ikɛn umbɔ, umbɔ anang adɛ̃ɛ̃ isɔme anera. <verse eid="MRK 7:36"/><verse number="37" style="v" sid="MRK 7:37"/>Anera agũ na adzeidzeu kishoo agɛ, &lt;&lt;Heee! Akorhe ubɛn abina azezerake. Atsu ugbau agũã arherhe, uwuku ufɔr arherhe, arherhe azezee.&gt;&gt;<verse eid="MRK 7:37"/></para>
  <chapter eid="MRK 7"/>
  <chapter number="8" style="c" sid="MRK 8"/>
  <para style="s1">Uyesu afuka anera anaka agɔnga anaa</para>
  <para style="r">(<ref loc="MAT 15:32-39">Umat 15.32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1"/>Ri inum hã anera abɔɔ arhɛrhɛ akɔng. Umbɔ aka ashimbɔ ru ubinkpi umbɔ aka igha, Uyesu ayisa angwɛ̃ imesanga umbɔ azĩ ru unga na agɔr umbɔ agɛ, <verse eid="MRK 8:1"/><verse number="2" style="v" sid="MRK 8:2"/>&lt;&lt;Umum igũ atorh anera abɛrɛ. Unum untaar nukpi umbɔ awu nggu umum na ashimbɔ ru ubingha. <verse eid="MRK 8:2"/><verse number="3" style="v" sid="MRK 8:3"/>Umum ĩba isoyikũ umbɔ azĩ ri iya nggu imerh, umbɔ awuri igbambɔ nu utsĩndĩ, ubinkutsu abɔɔ adzeki inang iyiki ider.&gt;&gt;<verse eid="MRK 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4"/>Angwɛ̃ imesanga agɔr unga agɛ, &lt;&lt;Umɛn ínyã ubingha ri inɛɛ ukpu umɛ̃ɛ̃ ighigha anera abɛrɛ ra arhum akɛrɛ?&gt;&gt;<verse eid="MRK 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5"/>Uyesu arhusa umbɔ agɛ, &lt;&lt;Umbi awe ru ípo uborodi isong?&gt;&gt;</para>
  <para style="p" vid="MRK 8:5">Umbɔ agɛ, &lt;&lt;Utɔɔva.&gt;&gt;<verse eid="MRK 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6"/>Unga agɔr ikikɔng hã iseisa abĩ. Ivangyɛ unga aka anyangu aborodi ha utɔɔva, atar uwɛɛ ru Unum, na atsɔka ake agasha adzise angwɛ̃ imesa umbɔ adene ru anera, umbɔ akorhe rimi hã. <verse eid="MRK 8:6"/><verse number="7" style="v" sid="MRK 8:7"/>Umbɔ awembɔ ru angwɛ̃rhã abɛrh ukunjiir, unga atar uwɛɛ ra ake ikɛi, unga agɔr umbɔ agashuwe ikikɔnga. <verse eid="MRK 8:7"/><verse number="8" style="v" sid="MRK 8:8"/>Anera agha ashur, angwɛ̃ imesa arhɔ̃ĩ akika abubɔr ake atɔk azĩnga utɔɔva. <verse eid="MRK 8:8"/><verse number="9" style="v" sid="MRK 8:9"/>Irhɛ anera aka agha, atsĩmbɔ anaka agɔnga anaa. Mɔcɛ Uyesu asoyika anera umbɔ azĩmbɔ. <verse eid="MRK 8:9"/><verse number="10" style="v" sid="MRK 8:10"/>Kanying unga atsĩ ukhukhɔɔ amɛ̃ nu angwɛ̃ imesanga, azĩã abĩ Udarhmanuta.<verse eid="MRK 8:10"/></para>
  <para style="s1">Ibee atsar</para>
  <para style="r">(<ref loc="MAT 16:1-4">Umat 16.1-4</ref>; <ref loc="LUK 12:54-56">Irh 12.54-56</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11"/>Abi Ufarisi abɔɔ aba atirhi uning nggu Uyesu. Avira unga, umbɔ abee unga akorhuwe abin idzeu ake awu utsar ugɛ unga adzeka afã. <verse eid="MRK 8:11"/><verse number="12" style="v" sid="MRK 8:12"/>Unga agbɛr usepa ughoghor na agɛ, &lt;&lt;Awu use utsu umbi aner undan ukpirɛ abee inyã atsar? Umum indɛyiwa umbi idzidzɛrhe, utsar ushikpɔ umbɔ aka idɛyiwe ukpɔ.&gt;&gt; <verse eid="MRK 8:12"/><verse number="13" style="v" sid="MRK 8:13"/>Mɔcɛ unga abɔruka umbɔ, atsĩ ukhukhɔɔ amɛ̃, agar azĩã ugar ukpɔrɔ.<verse eid="MRK 8:13"/></para>
  <para style="s1">Uguga abi Ufarisi nu Uhiridu</para>
  <para style="r">(<ref loc="MAT 16:5-12">Umat 16.5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14"/>Angwɛ̃ imesu Uyesu ayirukumbɔ asi ikũmbɔ uborodi. Akpurha awe ru ipoa unying ukpekũ ru ukhukhɔɔ amɛ̃ hã. <verse eid="MRK 8:14"/><verse number="15" style="v" sid="MRK 8:15"/>Uyesu agbiite atombɔ agɛ, &lt;&lt;Àka akpɔm amɛnmbi nggu uga abi Ufarisi nu uwu Uhiridu.&gt;&gt;<verse eid="MRK 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16"/>Angwɛ̃ imesa ha atirhi irherhe nggu adɔka agɛ, &lt;&lt;Arherhe rimi ubinkutsu umɛn iki isi ikũmɛn uborodi.&gt;&gt;<verse eid="MRK 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17"/>Unga ahwɛng arherhakɛ umbɔ aka arherhe, unga arhusa umbɔ agɛ, &lt;&lt;Awu use utsu umbi anu igɔr ugɛ umbi ashimbi ru uborodi? Utsɛku icɛrɛ umbi asi inyã ahwɛngmbi? Amɛnmbi awe ru igbau? <verse eid="MRK 8:17"/><verse number="18" style="v" sid="MRK 8:18"/>Umbi awu ra asu na asi inyãmbi, na awembi ra ato na asi igũmbi? Umbi asi iyitumbi, <verse eid="MRK 8:18"/><verse number="19" style="v" sid="MRK 8:19"/>ivangyɛ umum iki igashuwe anera anaka agɔnga atɔ̃ɔ̃ nggu aborodi atɔ̃ɔ̃? Azĩnga asong umbi aka akarha akika abɔr?&gt;&gt;</para>
  <para style="p" vid="MRK 8:19">Umbɔ agɛ, &lt;&lt;Usɔkdũmɛn.&gt;&gt;<verse eid="MRK 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20"/>&lt;&lt;Ivangyɛ umum iki itsɔku ipo aborodi utɔɔva ha, umum iki igashuwe anera anaka agɔnga anaa, azĩng akagɔng asong umbi aka akarha atɔk?&gt;&gt;</para>
  <para style="p" vid="MRK 8:20">Umbɔ agɔr unga agɛ, &lt;&lt;Utɔɔva.&gt;&gt;<verse eid="MRK 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21"/>Unga agɔr umbɔ agɛ, &lt;&lt;Utsɛku icɛrɛ umbi asi ihwɛngmbi?&gt;&gt;<verse eid="MRK 8:21"/></para>
  <para style="s1">Akerhuwe uner ibvuta ru Ubetsaida</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22"/>Umbɔ aka aba Ubetsaida, abɔɔ akũ uner ibvuta ashɔ̃rhũ Uyesu abangu uner ibvuta ha. <verse eid="MRK 8:22"/><verse number="23" style="v" sid="MRK 8:23"/>Unga adzur ubok uner ibvuta ha akũna unga adzek azĩã undzing utepa. Ivangyɛ unga aka ashapa aci ra asu utsak ha na atsorhu ubok nu unga, Uyesu arhusa agɛ, &lt;&lt;Ungo udɛ̃ɛ̃ unyãɔ ubin ukpɔɔ?&gt;&gt;<verse eid="MRK 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24"/>Unga abera asunga na agɛ, &lt;&lt;Inyãmum anera, umbɔ awu ru nyaka acucii iki izɛ̃rhã.&gt;&gt;<verse eid="MRK 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25"/>Uyesu abvui abanga asu utsak ha. Mɔcɛ utsak ha ayangi ikpor asunga ugeii, asunga akerhuke, unga anyã abina uku ushashaki. <verse eid="MRK 8:25"/><verse number="26" style="v" sid="MRK 8:26"/>Uyesu adene unga azĩã ri iya, agɛ, &lt;&lt;Niba ubvui uzĩɔ udiku utepa.&gt;&gt;<verse eid="MRK 8:26"/></para>
  <para style="s1">Ubitru adeku Uyesu unga awu Ukiristo</para>
  <para style="r">(<ref loc="MAT 16:13-20">Umat 16.13-20</ref>; <ref loc="LUK 9:18-21">Irh 9.18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27"/>Uyesu nggu angwɛ̃ imesanga azĩmbɔ, atsĩrhĩ iteu iki ici iyi Ukaisariya Ufirhibi. Nu utsĩndĩ unga arhusa angwɛ̃ imesanga agɛ, &lt;&lt;Anera anu igɔr agɛ umum iwu ungamɔ?&gt;&gt;<verse eid="MRK 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28"/>Umbɔ agɔr unga agɛ, &lt;&lt;Abɔɔ agɛ ungo uwu Uyohana Uner Ubɔtisima, abɔɔ agɛ, ungo uwu uner uwuku usɔm Arherhu-Num Uirhiya, abɔɔ agɛ ungo uwu unying ra abika asɔm Arherhu-Num.&gt;&gt;<verse eid="MRK 8:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29"/>Unga arhusa umbɔ agɛ, &lt;&lt;Bɔr umbi agɔr ugɛ umum iwu ungamɔ?&gt;&gt; Ubitru agɔr unga agɛ, &lt;&lt;Ungo uwu Ukiristo.&gt;&gt;<verse eid="MRK 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30"/>Uyesu agbiite atombɔ utsur umbɔ adɛyikumbɔ unera ubinkpi unga aka awe.<verse eid="MRK 8:30"/></para>
  <para style="s1">Uyesu asɔm ikpũ akpekɛ <optbreak/> unga aka ikpe</para>
  <para style="r">(<ref loc="MAT 16:21-28">Umat 16.21-28</ref>; <ref loc="LUK 9:22-27">Irh 9.22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31"/>Unga atirha amesuwe umbɔ agɛ, &lt;&lt;Ungwɛ̃-Ner awuri ihwa uver ra abina arhɛrhɛ nu akakũ nu ateiya abika adzowe idɛm-Num, nu abika amesuwe Ikpem, awuri ikpɛ̃mbɔ unga. Awuri ifɛre unga, ru unum untaar unga awuri isoka nggu urhɛ.&gt;&gt; <verse eid="MRK 8:31"/><verse number="32" style="v" sid="MRK 8:32"/>Arherhe akɛrɛ ha ra awiya. Nggee Ubitru adarha unga azĩ ri ifɛna atirhi itsɛrha unga.<verse eid="MRK 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 8:33"/>Bɔr Uyesu adzipa arhi angwɛ̃ imesa ha, atsɛrhu Ubitru agɛ, &lt;&lt;Usɔkɔ ru umum Ushaitan! Ungo uwu utarh ukpuku ukwɛr itok ru umum, ifɛrhkɔngo iwe ru nyaki iyi anera, isi iwengge ru nyaki iyi Unum.&gt;&gt;<verse eid="MRK 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34"/>Mɔcɛ unga ayisa anera nu angwɛ̃ imesanga aba ru unga, unga agɔr umbɔ agɛ, &lt;&lt;Unera aba abeenga idɔsa umum, awu ufang unga akpɛ̃ɛ̃ itsinga na ashipu igãrhãmau ucuciianga adɔsa umum. <verse eid="MRK 8:34"/><verse number="35" style="v" sid="MRK 8:35"/>Ubɛn unerwi aka abee ifɔrh urhɛnga, umgbɔ uwuri igwir, bɔr uwuku ugwirhuwe urhɛnga ru ubokmum nu Isarhe Iyiki Ize afufɔrh umgbɔ. <verse eid="MRK 8:35"/><verse number="36" style="v" sid="MRK 8:36"/>Izea iwu use unera akpo abin upfung kishoo na asi ikpoa urhɛnga? <verse eid="MRK 8:36"/><verse number="37" style="v" sid="MRK 8:37"/>Use unera awuri ikũ use ukpɔ uwe ifare urhɛnga? <verse eid="MRK 8:37"/><verse number="38" style="v" sid="MRK 8:38"/>Unera aba agũã atsakmum nu arherhamum ru udan ukpuku ushe irhirhika ukpirɛ ukpu itoma-dak nu arhim, Ungwɛ̃-Ner awuri igigũa atsak uner ha ri ivangyɛ unga aka iba ri ikpikpoi Utɛnga nggu ípfu itser-Num isarsatangge.&gt;&gt;<verse eid="MRK 8:38"/></para>
  <chapter eid="MRK 8"/>
  <chapter number="9" style="c" sid="MRK 9"/>
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1"/>Unga agɔr umbɔ agɛ, &lt;&lt;Umum indɛyiwa umbi idzidzɛrhe, abɔɔ rabɔ adɛ̃ɛ̃ nggimi awuri inyãmbɔ ijee Iyɛrhe afã kata na adɔrha akpe.&gt;&gt;<verse eid="MRK 9:1"/></para>
  <para style="s1">Idzidzipu iyor Uyesu</para>
  <para style="r">(<ref loc="MAT 17:1-13">Umat 17.1-13</ref>; <ref loc="LUK 9:28-36">Irh 9.28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2"/>Inuma utɔ̃ĩ iki imaa Uyesu akũ Ubitru, nu Uyaku, nu Uyohana, afũ igũ iyiki ider ikiyikambɔ. Umɔ iyor Uyesu idzipa iwiwengge ra asumbɔ. <verse eid="MRK 9:2"/><verse number="3" style="v" sid="MRK 9:3"/>Atorhanga ikɛi awu akaterha uku upɛ̃rhɛ̃ng uku unyar-nyar, anangke isisorh unera ru upfung ukpirɛ. <verse eid="MRK 9:3"/><verse number="4" style="v" sid="MRK 9:4"/>Mɔcɛ abika asɔm Arherhu-Num Uirhiya nu Umusa akapɛng ra asumbɔ, adɛ̃ɛ̃ arherhe nggu Uyesu.<verse eid="MRK 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 9:5"/>Ubitru agɔr Uyesu agɛ, &lt;&lt;A umarhem, azea umɛn iki iwe ri nggimi, uneke umɛn itar atsurha ataar, unying uwu ungo, unying uwu Umusa, unying uwu Uirhiya.&gt;&gt; <verse eid="MRK 9:5"/><verse number="6" style="v" sid="MRK 9:6"/>Unga asi ihwɛngnga ubinkpi unga aka arherhe, ubinkutsu umbɔ agũ iwei akarhãrhã.<verse eid="MRK 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7"/>Mɔcɛ amɛɛ adzek aba atsire umbɔ, urhɛm udzek ra amɛɛ ha, ugɔr ugɛ, &lt;&lt;Uwɛrɛ awu Ungwɛ̃mum, uwu umum iki ibema. Àka akpe ato ru unga!&gt;&gt;<verse eid="MRK 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 9:8"/>Kanying, umbɔ aka arhi adzipa, asi inyãmbɔ unera akpurha anyã Uyesu ikiyikanga nggu umbɔ.<verse eid="MRK 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9"/>Umbɔ aka azɛ̃rhã acipuwa ru igũ hã, Uyesu agbiite atombɔ ugɛ niba adɛyikumbɔ unera ubinkpi umbɔ aka anyã utsɛku Ungwɛ̃-Ner aka isoka akpe. <verse eid="MRK 9:9"/><verse number="10" style="v" sid="MRK 9:10"/>Ngge itsu umbɔ angwɛ̃ arherhe ha ra amɛnmbɔ, na arhusa adɔkambɔ agɛ, &lt;&lt;Awu use uwu agben isoka akpe?&gt;&gt;<verse eid="MRK 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 9:11"/>Umbɔ arhusa unga agɛ, &lt;&lt;Awu use utsu abika amesuwe Ikpem anu igɔr ugɛ awu ufang uner uwuku usɔm Arherhu-Num Uirhiya agbaashia aba?&gt;&gt;<verse eid="MRK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Awu idzidzɛrhe Uirhiya agbaashia aba agbishi ifɛrhɛ kishoo. Awu use utsu itsɛng igɔr igɛ awu ufang Ungwɛ̃-Ner ahwa uver urhɛrhɛ umbɔ akpɛ̃mbɔ unga? <verse eid="MRK 9:12"/><verse number="13" style="v" sid="MRK 9:13"/>Bɔr umum indɛyiwa umbi Uirhiya aka abanga, anera akorhuwe unga ubinkpi umbɔ aka abee, ru nyaka ngge iki itsɛng ri itsinga.&gt;&gt;<verse eid="MRK 9:13"/></para>
  <para style="s1">Ikikerhe uwɛkuci uwu <optbreak/> ipfu iyiki ibewe</para>
  <para style="r">(<ref loc="MAT 17:14-23">Umat 17.14-23</ref>; <ref loc="LUK 9:37-45">Irh 9.37-45</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14"/>Uyesu nggu angwɛ̃ imesanga hã ikitatambɔ abvui aba ra angwɛ̃ imesanga, umbɔ anyã nggaa ikikɔng iki idzipa umbɔ nu abika amesuwe Ikpem adɛ̃ɛ̃ uning nggu umbɔ. <verse eid="MRK 9:14"/><verse number="15" style="v" sid="MRK 9:15"/>Kanying umbɔ aka anyã Uyesu, kishoo ikikɔng hã idzedzeu akarhãrhã, asok atĩtser azĩ aghwe unga.<verse eid="MRK 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 9:16"/>Uyesu arhusa angwɛ̃ imesanga agɛ, &lt;&lt;Umbi adɛ̃ɛ̃ uning use nggu umbɔ?&gt;&gt;<verse eid="MRK 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17"/>Uner uwɔɔ ri ikikɔng hã adzipuwe agɛ, &lt;&lt;A umarhem, nggawi umum ikũwã ungo ungwɛ̃mum, uwuruwi aka awe ru ipfu iyiki ibewe iki ikɛnngge unga arherhe. <verse eid="MRK 9:17"/><verse number="18" style="v" sid="MRK 9:18"/>Ivangyɛ ngge iki isok ru unga, iki isaki itare unga ra abĩ. Itsu unga adzeyi ufuu ra angwĩnga, anu ishang anyĩ, iyornga idɛ̃ɛ̃ ikerketangge. Umum ĩgɔr angwɛ̃ imesango ama atsũwe, bɔr umbɔ afɔr adambɔ.&gt;&gt;<verse eid="MRK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Umbi abi udan ukpirɛ, abika asheri imangmang, abi amɛn aka abewe. Umum iki isei ĩdãrhũmum nggu umbi, ukang umbi aka awe ru imangmang ru umum? Utsɛku ukang umum iki ibima nggu ida imangmangmbi? Ukũ ungwɛ̃ hã uba nggɛɛ ru umum.&gt;&gt;<verse eid="MRK 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 9:20"/>Nggee umbɔ akũ unga aba. Ivangyɛ ipfu iyiki ibewe iki inyã Uyesu, kanying ngge ikwɛr ungwɛ̃ hã iyornga izang. Unga agba agɔ̃rhã, ufuu ikɛi udzeyi ra angwĩnga.<verse eid="MRK 9:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 9:21"/>Uyesu arhusu utɛ ungwɛ̃ hã agɛ, &lt;&lt;Ukang ifɛrhɛ ha iki itirhi ru unga?&gt;&gt;</para>
  <para style="p" vid="MRK 9:21">Utɛ ungwɛ̃ hã agɛ, &lt;&lt;Itirhi unga ana awu uwɛkuci ukunjiir. <verse eid="MRK 9:21"/><verse number="22" style="v" sid="MRK 9:22"/>Iki isaki itare unga ru urha, nu amɛ̃, ibee ifɛre unga. Bɔr ungo uba udɛ̃ɛ̃ ukorhukɔ ubin, uma ugũ atorh umɛn uma uyika umɛn.&gt;&gt;<verse eid="MRK 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23"/>Uyesu agɔr unga agɛ, &lt;&lt;Awu use utsu ungo urhusa ugɛ umum ĩba idɛ̃ɛ̃ imɛ̃mum? Ubɛn ifɛrhɛ iwengge ru uwuruwi aka awe ru imangmang.&gt;&gt;<verse eid="MRK 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24"/>Kanying utɛ ungwɛ̃ hã atsarhi irhaknga agɛ, &lt;&lt;Umum iwemum ri imangmang, uma uyika umum ingbiki iwerangge!&gt;&gt;<verse eid="MRK 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25"/>Uyesu aka anyã ikikɔng hã iki itĩ iba, unga atsɛrhi ipfu iyiki ibewe ha agɛ, &lt;&lt;Ungo ipfu iyiki ibewe iyiki itsu igbau ni ikɛn arherhe, umum itsu ungo upfudzek ru unga, niba ubvui utsĩɔ̃ ru unga ikɛi!&gt;&gt;<verse eid="MRK 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26"/>Ipfu iyiki ibewe ha itsu ivum, izung ungwɛ̃ hã mɔcɛ ngge idzekngge. Ungwɛ̃ hã anu ru nyaku ukom, nggee irhɛ anera igɔr ugɛ, &lt;&lt;Aka akpea.&gt;&gt; <verse eid="MRK 9:26"/><verse number="27" style="v" sid="MRK 9:27"/>Bɔr Uyesu adzur uboknga aberuwe unga nu adaknga, unga asok adɛ̃ɛ̃.<verse eid="MRK 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28"/>Uyesu aka atsĩ ri iya, angwɛ̃ imesanga arhusa unga ikiyikambɔ agɛ, &lt;&lt;Awu use utsu umɛn isi idɛ̃ɛ̃ itsũwũkumɛn ipfu iyiki ibewe ha?&gt;&gt;<verse eid="MRK 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Ikpũ idzidzek iyɛrɛ iwuri iwe ri ifɛn-Num ukpekũ.&gt;&gt;<verse eid="MRK 9:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30"/>Umbɔ asokmbɔ ra anang hã, azɛ̃rhã atɔng ru Ugarhirhi. Uyesu asi ibeenga anera ahwɛng anangkɛ umbɔ aka awe, <verse eid="MRK 9:30"/><verse number="31" style="v" sid="MRK 9:31"/>ubinkutsu anu imesuwe angwɛ̃ imesanga. Agɔr umbɔ agɛ, &lt;&lt;Awuri ighambɔ adak Ungwɛ̃-Ner adzowe unga ra abok anera. Umbɔ awuri ifɛre unga, inuma itaar iki itɔng unga awuri isoka.&gt;&gt; <verse eid="MRK 9:31"/><verse number="32" style="v" sid="MRK 9:32"/>Bɔr umbɔ asi ihwɛngmbɔ agben arherhanga, na agũ iwei irhusa unga.<verse eid="MRK 9:32"/></para>
  <para style="s1">Ungaa awu uwuku ugɔnga?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Umat 18.1-5</ref>; <ref loc="LUK 9:46-48">Irh 9.46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33"/>Ivangyɛ umbɔ aka azĩ atsĩ Ukafanahum, ivangyɛ unga aka awe ri iya, unga arhusa umbɔ agɛ, &lt;&lt;Umbi adɛ̃ɛ̃ uning use ru utsĩndĩ?&gt;&gt; <verse eid="MRK 9:33"/><verse number="34" style="v" sid="MRK 9:34"/>Bɔr umbɔ anukutata, ubinkutsu nu utsĩndĩ umbɔ adɛ̃ɛ̃ uning ugɛ ungaa awu uwuku ugɔnga ru umbɔ.<verse eid="MRK 9:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 9:35"/>Uyesu asei, na ayisa umbɔ usɔkdũmɛn hã, agɔr umbɔ agɛ, &lt;&lt;Ubɛn unera aka abee iwu ukugɔngmbi, awu ufang unga awu uwuku ucia, ikɛi na awu ugãrhãmbi kishoo.&gt;&gt;<verse eid="MRK 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 9:36"/>Unga ashupu ungwɛ̃rhũ uwɛkuci atsu unga adɛ̃ɛ̃ ra ateumbɔ. Unga ashupa unga awuma ra aboknga, agɔr umbɔ agɛ, <verse eid="MRK 9:36"/><verse number="37" style="v" sid="MRK 9:37"/>&lt;&lt;Uwuku uyɛi ungwɛ̃rhũ uwɛkuci ru nyaku uwɛrɛ ri itsokmum, ayɛi umum nukpɔ, uwuruwi aka ayɛi umum ayɛi uwuku udena umum ĩba.&gt;&gt;<verse eid="MRK 9:37"/></para>
  <para style="s1">Uwuruwi aka asi ikpɛ̃ɛ̃ umɛn <optbreak/> awu uwu umɛn</para>
  <para style="r">(<ref loc="LUK 9:49-50">Irh 9.49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38"/>Uyohana agɔr unga agɛ, &lt;&lt;A umarhem, umɛn inyã uner uwɔɔ anu itsusuwe ipfu iyiki ibewe ri itsokngo, umɛn ikɛnmɛn unga, ubinkutsu asi iwea nggu umɛn.&gt;&gt;<verse eid="MRK 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39"/>Bɔr Uyesu agɔr unga agɛ, &lt;&lt;Àka niba akɛnmbi unga. Unera asi íkorhunga ubin idzeu ri itsokmum amaa na arherhunga iki ibewe ri itsimum. <verse eid="MRK 9:39"/><verse number="40" style="v" sid="MRK 9:40"/>Ubɛn unerwi aka asi ikpɛ̃ɛ̃ umɛn awu uwu umɛn. <verse eid="MRK 9:40"/><verse number="41" style="v" sid="MRK 9:41"/>Umum indɛyiwa umbi idzidzɛrhe, kishoo uwuku udzaa umbi ukpɛwa amɛ̃ aka ahwa ri itsokmum ugɛ umbi awu abi Ukiristo, umum indɛyiwa umbi idzidzɛrhe awuri ikpoa ugbɛtanga.<verse eid="MRK 9:41"/></para>
  <para style="s1">Abin aka itsu igbigba ra arhim</para>
  <para style="r">(<ref loc="MAT 18:6-9">Umat 18.6-9</ref>; <ref loc="LUK 17:1-2">Irh 17.1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42"/>&lt;&lt;Ubɛn uwuruwi aka itsu unying ra awɛkaci abika awe ru imangmang ru umum agba ra arhim, ugba umbɔ abope ukɔ igɔ ru urhɔk uner ha na atsuke unga ru ukau ukugɔng. <verse eid="MRK 9:42"/><verse number="43" style="v" sid="MRK 9:43"/>Ubokngo uba utsu ungo ugbaɔ ra arhim, uzharhuwe ukpɔ. Azea ungo utsĩ urhɛ uwu ugbagbaa nggu uboka unying nu ungo uku ineke abokngo ikivarhake atsĩ idzũ urhakpi uku usi írhimkpɔ.<note caller="+" style="f"><char style="fr" closed="false">9.43 </char><char style="ft" closed="false">Abvur akɔɔ aki itsɛng abok aki isha agɔrke ikɛi ugɛ, </char><char style="fv" closed="false">44</char><char style="fqa" closed="false">Ra anangkɛ adzudzi iki igha, ake asi íkpeke, urha ikɛi usi írhimkpɔ.</char></note> <verse eid="MRK 9:43"/><verse number="45" style="v" sid="MRK 9:45"/>Udakngo uba utsu ungo igba ra arhim, uzharhuwe ukpɔ. Azea ungo utsĩ urhɛ uwu ugbagbaa nggu igbeta nu ungo iki itsĩ idzũ urhakpi uku usi írhimkpɔ nggu adakngo avaa.<note caller="+" style="f"><char style="fr" closed="false">9.45 </char><char style="ft" closed="false">Abvur akɔɔ aki itsɛng abok aki isha agɔrke ikɛi ugɛ, </char><char style="fv" closed="false">46</char><char style="fqa" closed="false">Ra anangkɛ adzudzi iki igha, ake asi íkpeke, urha ikɛi usi írhimkpɔ.</char></note> <verse eid="MRK 9:45"/><verse number="47" style="v" sid="MRK 9:47"/>Ishaa usungo iba itsu ungo ugba ra arhim, uhoote ukpɔ. Azea ungo utsĩ Iyɛrhe Unum nggu usua unying nu ungo uku itsĩ ri idzũ urha nggu asu avaa. <verse eid="MRK 9:47"/><verse number="48" style="v" sid="MRK 9:48"/>Umɔ,</para>
  <para style="q1" vid="MRK 9:48">&lt;&lt; &lt;Adzudzimbɔ asi íkpeke,</para>
  <para style="q2" vid="MRK 9:48">nu urha ikɛi usi írhimkpɔ.&gt;<note caller="+" style="f"><char style="fr" closed="false">9.48 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="ISA 66:24">Uish 66.24</ref></char>.</note><verse eid="MRK 9:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49"/>&lt;&lt;Asare anera kishoo nggu urha ru nyaka umbɔ aka ikũ angwã asare idɛm.<verse eid="MRK 9:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50"/>&lt;&lt;Angwã aze, bɔr ake aba ashike ri itonga angwã, ungo ukorhu uguse nu utsu ake atonga ikɛi? Àka awe ra angwã ra atsimbi, na asei uku ughwɔɔw nggu adɔka.&gt;&gt;<verse eid="MRK 9:50"/></para>
  <chapter eid="MRK 9"/>
  <chapter number="10" style="c" sid="MRK 10"/>
  <para style="s1">Igau itsɛrh</para>
  <para style="r">(<ref loc="MAT 19:1-12">Umat 19.1-12</ref>; <ref loc="LUK 16:18">Irh 16.18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1"/>Mɔcɛ Uyesu asoka ra anang hã na azĩã ugbɛr uwu Uyahudiya agar Azɛ̃ Urdun. Ikɛi anera arhɛrhɛ abvui akɔng ru unga, unga amesuwe umbɔ ru nyaka unga aka abayi.<verse eid="MRK 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2"/>Abi Ufarisi abɔɔ aba avira unga, arhusa agɛ, &lt;&lt;Ri Ikpem imɛ̃ngge unera agau nggu utsɛ̃nga?&gt;&gt;<verse eid="MRK 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Umusa atsu umbi akorhu use?&gt;&gt;<verse eid="MRK 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4"/>Umbɔ agɛ, &lt;&lt;Umusa agɔr umɛn agɛ unera awuri idɛ̃ɛ̃ atsɛng ubvur igau itsɛrh awayika utsɛ̃nga.&gt;&gt;<verse eid="MRK 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Itsã itsimbi itsu Umusa atsɛnga umbi akɛrɛ ha. <verse eid="MRK 10:5"/><verse number="6" style="v" sid="MRK 10:6"/>Bɔr ri inggbaashia &lt;Unum amuna umbɔ ukutsak nggu ukutsɛrh.&gt;<note caller="+" style="f"><char style="fr" closed="false">10.6 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="GEN 1:27">Ing 1.27</ref></char>.</note> <verse eid="MRK 10:6"/><verse number="7" style="v" sid="MRK 10:7"/>&lt;Nggee, unera awuri ineke utɛnga nu uyanga, na anyapa nggu utsɛ̃nga. <verse eid="MRK 10:7"/><verse number="8" style="v" sid="MRK 10:8"/>Umbɔ ikivarhambɔ awuri iwu iyora unying.&gt;<note caller="+" style="f"><char style="fr" closed="false">10.8 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="GEN 2:24">Ing 2.24</ref></char>.</note> Nggee umbɔ asi iwembɔ ivaa bɔr awu iyora unying. <verse eid="MRK 10:8"/><verse number="9" style="v" sid="MRK 10:9"/>Nggee, ubinkpi Unum aka agbopa, unera niba agashuka.&gt;&gt;<verse eid="MRK 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10"/>Ivangyɛ umbɔ aka awu ri iya, ikɛi, angwɛ̃ imesa arhusu Uyesu arherhe ha. <verse eid="MRK 10:10"/><verse number="11" style="v" sid="MRK 10:11"/>Unga agɔr umbɔ agɛ, &lt;&lt;Ubɛn uwuku ugau itsɛrh nggu utsɛ̃nga na apfunu utsɛrh uwukuse, unga awu ra arhim itoma-dak ru unga. <verse eid="MRK 10:11"/><verse number="12" style="v" sid="MRK 10:12"/>Iwe rimi hã ukutsɛrh aba agau itsɛrh nggu utsaka, na azĩ itsɛrh uner uwukuse, unga atoma-dak.&gt;&gt;<verse eid="MRK 10:12"/></para>
  <para style="s1">Angwɛ̃rhã awɛkaci nu Uyesu</para>
  <para style="r">(<ref loc="MAT 19:13-15">Umat 19.13-15</ref>; <ref loc="LUK 18:15-17">Irh 18.15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13"/>Anera aka akũ angwɛ̃rhã awɛkaci aba ru Uyesu abanga umbɔ, bɔr angwɛ̃ imesanga atsɛrha umbɔ. <verse eid="MRK 10:13"/><verse number="14" style="v" sid="MRK 10:14"/>Uyesu aka anyã rimi, avɔm afɛr unga. Unga agɔr umbɔ agɛ, &lt;&lt;Àka aneke angwɛ̃rhã awɛkaci aba ru umum, niba akɛnmbi umbɔ, Iyɛrhe-Num iwu iyi ikpũmbɔ. <verse eid="MRK 10:14"/><verse number="15" style="v" sid="MRK 10:15"/>Umum indɛyiwa umbi idzidzɛrhe, ubɛn unera aka asi iyɛisa Iyɛrhe-Num ru nyaku uwɛkuci, asi ídɛ̃ɛ̃ atsĩã ri ngge.&gt;&gt; <verse eid="MRK 10:15"/><verse number="16" style="v" sid="MRK 10:16"/>Mɔcɛ unga ashupa awɛkaci ha ra aboknga awuma na atsorhe abok nu atsimbɔ na atsuke umbɔ idorh.<verse eid="MRK 10:16"/></para>
  <para style="s1">Uwɛdzɛm uner ubin</para>
  <para style="r">(<ref loc="MAT 19:16-30">Umat 19.16-30</ref>; <ref loc="LUK 18:18-30">Irh 18.18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17"/>Uyesu atirhi isisok ra anang hã nukpi, utsak uwɔɔ atĩ aba, atararhu ra anangnga, arhusa unga agɛ. &lt;&lt;A umarhem uwuku uze, umum ikorhu use ni ikpo urhɛ uwu ugbagbaa?&gt;&gt;<verse eid="MRK 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18"/>Uyesu agɔr unga agɛ, &lt;&lt;Awu use utsu ungo uyisa umum uwuku uze? Uwuku uze ashia, Unum ukpekũ awu uwuku uze. <verse eid="MRK 10:18"/><verse number="19" style="v" sid="MRK 10:19"/>Ungo uhwɛngo íkpem iyɛrɛ, &lt;Niba ufɛrɔ unera, niba utomungo-dak, niba uvɛpɔ ivɛu, niba ugbɛrɔ angwĩ utsukukɔ unera, niba ughaɔ urha, udzowe igɔng ru utɛngo nu uyango.&gt;<note caller="+" style="f"><char style="fr" closed="false">10.19 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="EXO 20:12">Idzi 20.12</ref>; <ref loc="DEU 5:16-20">Iva 5.16-20</ref></char>.</note>&gt;&gt;<verse eid="MRK 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20"/>Uwɛdzɛm hã agɔr unga agɛ, &lt;&lt;A umarhem, umum iki idɔsumum akɛrɛ ha kishoo rimɔ̃ɔ̃ utirhi ri iwɛ̃nci.&gt;&gt;<verse eid="MRK 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21"/>Uyesu arhi unga na abema unga, agɔr unga agɛ, &lt;&lt;Ungo usheru ubina unying ukpekũ. Uzĩ, ugoshe abinngo kishoo, udzowe uhwɛka ra atsũwã, ungo uwuri iweɔ ru ugbɛta urhɛrhɛ ra afã, mɔcɛ uba udɔsa umum.&gt;&gt;<verse eid="MRK 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 10:22"/>Igũ rimi itsu ungwɛ̃dzɛm hã ashepa asunga, azĩ nggu ida amɛn, ubinkutsu unga awu uner ubin akarhãrhã.<verse eid="MRK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23"/>Uyesu arhi adziir angwɛ̃ imesanga, agɔr umbɔ agɛ, &lt;&lt;Aghong abika awu ru ubin aki ikpo itsĩ Iyɛrhe Unum!&gt;&gt;<verse eid="MRK 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24"/>Angwɛ̃ imesanga adzeidzeu ra arherha ha. Uyesu ikɛi agɔr umbɔ agɛ, &lt;&lt;Umbi awɛkaci, aghong akarhãrhã unera atsĩ ri Iyɛrhe Unum! <verse eid="MRK 10:24"/><verse number="25" style="v" sid="MRK 10:25"/>Ighɔrhungge urhakumi utsĩ atɔng ra angwĩ inepurha, nu uner ubin aka itsĩ ri Iyɛrhe Unum.&gt;&gt;<verse eid="MRK 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26"/>Angwɛ̃ imesa ha adzeidzeu akarhãrhã arhusa adɔka agɛ, &lt;&lt;Ungamɔ awuri idɛ̃ɛ̃ akpo ififɔrh?&gt;&gt;<verse eid="MRK 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27"/>Uyesu arhi umbɔ na agɛ, &lt;&lt;Ra anera ngge isi ímɛ̃ngge, bɔr ru Unum imɛ̃ngge. Ubɛn ubina umɛ̃ɛ̃kpɔ ra anang Unum.&gt;&gt;<verse eid="MRK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28"/>Ubitru agɔr unga agɛ, &lt;&lt;Nggayɛ umɛn ineke abina kishoo ni adɔsa ungo!&gt;&gt;<verse eid="MRK 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29"/>Uyesu agɛ, &lt;&lt;Umum indɛyiwa umbi idzidzɛrhe, unera ashia uwuruwi aka neke iyanga, use angwɛ̃mbɔ use anapumbɔ use uyanga use utɛnga use awɛkacinga use icang irhamnga ri itsimum nu Isarhe Iyiki Ize, <verse eid="MRK 10:29"/><verse number="30" style="v" sid="MRK 10:30"/>na asi ikpoa iya, angwɛ̃mbɔ, anapumbɔ, uya, awɛkaci nu icang irham idikunga unaka ru udan ukpirɛ, unga ikpoa uver ikɛi, ru upfung ukpuku uba unga ikpoa urhɛ uwu ugbagbaa. <verse eid="MRK 10:30"/><verse number="31" style="v" sid="MRK 10:31"/>Bɔr anera arhɛrhɛ aka awu abi inggbaashi, awuri iwu ãmaata. Ãmaata ikɛi, awuri iwu anggbaashi.&gt;&gt;<verse eid="MRK 10:31"/></para>
  <para style="s1">Uyesu abvui arherha arherhe <optbreak/> ra akpekɛ unga aka ikpe</para>
  <para style="r">(<ref loc="MAT 20:17-19">Umat 20.17-19</ref>; <ref loc="LUK 18:31-34">Irh 18.31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32"/>Umbɔ awu ru utsĩndĩ uwuku afũrhã azĩ Urusharhima. Uyesu agbaashia nu udĩ hã. Angwɛ̃ imesa adzeidzeu, nu abika adɔsa unga agũ iwei. Ikɛi unga ayisa angwɛ̃ imesanga usɔkdũmɛn hã ri ibanga adɛyiwe umbɔ ubinkpi iki ikorhe nggu unga. <verse eid="MRK 10:32"/><verse number="33" style="v" sid="MRK 10:33"/>&lt;&lt;Nggayɛ umɛn izĩ ufã Urusharhima. Umɔ awuri ighambɔ adak Ungwɛ̃-Ner adzowe unga ra abok ateiya abika adzowe idɛm-Num, na abika amesuwe Ikpem. Awuri itsu unga ufai akpe na adzowe unga ra atsen abi Uyahuda. <verse eid="MRK 10:33"/><verse number="34" style="v" sid="MRK 10:34"/>Umbɔ awuri iyɛia unga na ashau aci atsuke ra asunga, awuri ikwɛre unga ugwɛɛ na afɛre unga. Inuma itaar iki itɔng unga awuri isoka nggu urhɛ.&gt;&gt;<verse eid="MRK 10:34"/></para>
  <para style="s1">Ubinkpi Uyaku nu Uyohana aka afɛna</para>
  <para style="r">(<ref loc="MAT 20:20-28">Umat 20.20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35"/>Mɔcɛ angwɛ̃ Uzabadi, Uyaku nu Uyohana, aba ru unga. Agɔr unga agɛ, &lt;&lt;A umarhem, umɛn ibee ungo ukorhuwa ubɛn ubina umɛn iki ifɛna ungo.&gt;&gt;<verse eid="MRK 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36"/>Unga arhusa umbɔ agɛ, &lt;&lt;Umbi abee umum ikorhuwa umbi use?&gt;&gt;<verse eid="MRK 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37"/>Umbɔ agɛ, &lt;&lt;Umɛn ishɔ̃rhã ungo neke unying ru umɛn asei nú ubok ughango, uwu uvaa asei nú ubok uferango ri ikpikpoingo.&gt;&gt;<verse eid="MRK 10:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38"/>Bɔr Uyesu agɔr umbɔ agɛ, &lt;&lt;Umbi asi ihwɛngmbi ubinkpi umbi aka arhusa. Umbi awuri idɛ̃ɛ̃ ahwambi ru ukpɛwa uverkpi umum iki ihwa, use umbi awuri idɛ̃ɛ̃ akorhumbi ikpũ ubɔtisima uverkpi umbɔ aka ikorhuwa umum?&gt;&gt;<verse eid="MRK 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39"/>Umbɔ agɛ, &lt;&lt;Ĩĩ, umɛn idɛ̃ɛ̃ ikorhumɛn.&gt;&gt; Uyesu agɔr umbɔ agɛ, &lt;&lt;Ĩĩ, umbi awuri ihwambi ru ukpɛwa umum iki ihwa na awuri akorhumbi ubɔtisima hã umbɔ aka ikorhuwa umum, <verse eid="MRK 10:39"/><verse number="40" style="v" sid="MRK 10:40"/>bɔr isei nu ubok ughamum use ubok uferamum asi iwea umum ĩbemuwa. Inang iyɛrɛ iwu iyi abirabɛ umbɔ aka asɛng agbishuwe rimɔ̃ɔ̃.&gt;&gt;<verse eid="MRK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41"/>Ivangyɛ angwɛ̃ imesa ha usɔka aka agũ rimi, umbɔ agũ avɔm nggu Uyaku nu Uyohana. <verse eid="MRK 10:41"/><verse number="42" style="v" sid="MRK 10:42"/>Uyesu ayisa umbɔ ananga unying agɔr umbɔ agɛ, &lt;&lt;Umbi ahwɛngmbi ugɛ abirabɛ umbɔ aka anyanga umbɔ awu ayɛrhe atsen abi Uyahuda, anu idɛyiwe anera iyɛrhe, anggbaashimbɔ ikɛi anu ikũ ijee adarh umbɔ. <verse eid="MRK 10:42"/><verse number="43" style="v" sid="MRK 10:43"/>Bɔr isi íwengge rimi ru umbi. Ubɛn uwuku ubee igɔng ru umbi awu ufang unga awu ugãrhãmbi. <verse eid="MRK 10:43"/><verse number="44" style="v" sid="MRK 10:44"/>Ikɛi ubɛn unera aka abee iwu unggbaashi, awu ufang unga awuri iwu ugãrhã ra anera kishoo. <verse eid="MRK 10:44"/><verse number="45" style="v" sid="MRK 10:45"/>Ungwɛ̃-Ner asi ibanga umbɔ atɔ̃we unga itser, bɔr unga awuri iwu ugãrhã, na adzowe urhɛnga afɔrh anera arhɛrhɛ.&gt;&gt;<verse eid="MRK 10:45"/></para>
  <para style="s1">Uner itapa akpoa inyã anang</para>
  <para style="r">(<ref loc="MAT 20:29-34">Umat 20.29-34</ref>; <ref loc="LUK 18:35-43">Irh 18.35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46"/>Uyesu nu angwɛ̃ imesanga aka azĩ atsĩ Ujeriko. Umbɔ nu anera arhɛrhɛ, awuri idze utepa, uner itapa agburh Ubartimawu agbena agburh &lt;&lt;ungwɛ̃ Utimawu,&gt;&gt; asei nu ubang utsĩndĩã anu ifɛn. <verse eid="MRK 10:46"/><verse number="47" style="v" sid="MRK 10:47"/>Ivangyɛ unga aka agũ ugɛ Uyesu uner Unazarat unga atɔng, unga atsarhi irhaknga ayisa agɛ, &lt;&lt;Uyesu Ungwɛ̃ Udauda ugũ atorh umum!&gt;&gt;<verse eid="MRK 10:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48"/>Anera abɔɔ arhɛrhɛ atsɛrha unga agɛ, &lt;&lt;Unu ukutata!&gt;&gt; Bɔr unga agbisha atsarhi irhaknga akarhãrhã ayisa agɛ, &lt;&lt;A Ungwɛ̃ Udauda, uma ugũ atorh umum!&gt;&gt;<verse eid="MRK 10:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49"/>Uyesu atsurha adɛ̃ɛ̃ na agɛ, &lt;&lt;Àka ayisuwa unga.&gt;&gt; Umbɔ ayisu uner itapa ha, agɔr unga agɛ, &lt;&lt;Ugɔm! Usisok, ayisa ungo.&gt;&gt; <verse eid="MRK 10:49"/><verse number="50" style="v" sid="MRK 10:50"/>Unga atare untamanga, na akatasok ater isha, azĩã ru Uyesu.<verse eid="MRK 10:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51"/>Uyesu arhusa unga agɛ, &lt;&lt;Ungo ubee umum ikorhuwa ungo use?&gt;&gt;</para>
  <para style="p" vid="MRK 10:51">Uner itapa ha agɛ, &lt;&lt;A Uteiya, umum ibee inyã anang.&gt;&gt;<verse eid="MRK 10:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52"/>Uyesu agɔr unga agɛ, &lt;&lt;Uzĩɔ. Imangmangngo ngge ikerhuwa ungo.&gt;&gt; Kanying unga ayɛisa inyĩnyãnga na adɔsu Uyesu umbɔ uzĩmbɔ nu utsĩndĩ.<verse eid="MRK 10:52"/></para>
  <chapter eid="MRK 10"/>
  <chapter number="11" style="c" sid="MRK 11"/>
  <para style="s1">Uyesu atsĩ Urusharhima nggu ininang</para>
  <para style="r">(<ref loc="MAT 21:1-11">Umat 21.1-11</ref>; <ref loc="LUK 19:28-40">Irh 19.28-40</ref>; <ref loc="JHN 12:12-19">Uyoh 12.12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1"/>Umbɔ aka aba akhapa ru Urusharhima ru Ubetafaji ru Ubetani Igũ Acucii Uzaitun, Uyesu adene angwɛ̃ imesanga avaa. <verse eid="MRK 11:1"/><verse number="2" style="v" sid="MRK 11:2"/>Agɔr umbɔ agɛ, &lt;&lt;Àka azĩ ru ungwɛ̃rhũ uteu ukpɔɔ ra asumbi, ubɛn itsitsĩmbi, umbi awuri inyãmbi ungwɛ̃ uzhika umbɔ aka abow, unera aka anasi ifũã umgbɔ. Àka agarha umgbɔ akũ aba. <verse eid="MRK 11:2"/><verse number="3" style="v" sid="MRK 11:3"/>Unera aba arhusunga umbi agɛ, &lt;Awu use umbi akorhe rimi?&gt; Àka agɔr unga agɛ, &lt;Uteijee unga abeea umgbɔ unga awuri ibvui adene umgbɔ uba kanying.&gt; &gt;&gt;<verse eid="MRK 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4"/>Umbɔ azĩ anyã ungwɛ̃ uzhika uku udɛ̃ɛ̃ ru ubang utsĩndĩã, ubow ra angwĩ iya. Umbɔ atirhi igarha umgbɔ. <verse eid="MRK 11:4"/><verse number="5" style="v" sid="MRK 11:5"/>Abirabɛ aka adɛ̃ɛ̃ umɔ arhusa umbɔ agɛ, &lt;&lt;Awu use utsu umbi agarhu ungwɛ̃ uzhika ha?&gt;&gt; <verse eid="MRK 11:5"/><verse number="6" style="v" sid="MRK 11:6"/>Umbɔ adzipa arherhe ubinkpi Uyesu aka adɛyiwe umbɔ. Aner ha neke umbɔ akũ ungwɛ̃ uzhika ha azĩmbɔ. <verse eid="MRK 11:6"/><verse number="7" style="v" sid="MRK 11:7"/>Ivangyɛ umbɔ aka akũ ungwɛ̃ uzhika ha aba ru Uyesu na abɛtuwe antamambɔ nu undzingmgbɔ, Uyesu afũ asei nu umgbɔ. <verse eid="MRK 11:7"/><verse number="8" style="v" sid="MRK 11:8"/>Anera arhɛrhɛ abɛtuwe antamambɔ nu utsĩndĩã, abɔɔ agbɛyi ayerhe ri icang abɛtuwe nu utsĩndĩã. <verse eid="MRK 11:8"/><verse number="9" style="v" sid="MRK 11:9"/>Abika awu ra asunga na abika aba ra andzingnga atsui ivum agɛ,</para>
  <para style="q1" vid="MRK 11:9">&lt;&lt;Ikpikpoi iwe ru Unum!<note caller="+" style="f"><char style="fr" closed="false">11.9 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="PSA 118:26">Amb 118.26</ref></char>.</note></para>
  <para style="q1" vid="MRK 11:9">Idorh iwe nggu unga aka aba ri itsok Uteijee!<verse eid="MRK 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10"/>Idorh iwe ri ibiba iyɛrhe utɛmɛn Udauda!</para>
  <para style="q1" vid="MRK 11:10">Ikpikpoi iwe afafã ra afã.&gt;&gt;<verse eid="MRK 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11"/>Uyesu aka atsĩ Urusharhima, azĩã ri Iya-Num atsĩ arhisa abina kishoo. Nggayɛ unum uku utsĩkpɔ, nggee unga abvui adzek azĩã Ubetani nggu angwɛ̃ imesanga usɔkdũmɛn.<verse eid="MRK 11:11"/></para>
  <para style="s1">Uyesu atsuke ikponum ru uvorhvo</para>
  <para style="r">(<ref loc="MAT 21:18-19">Umat 21.18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12"/>Ukpe unum uvaa umbɔ aka asoku Ubetani, imerh ifɛr Uyesu. <verse eid="MRK 11:12"/><verse number="13" style="v" sid="MRK 11:13"/>Unga aka anyã ucucii uvorhvo ukukaa uku ukpusha ayerhe udɛ̃ɛ̃, unga azĩa ibee ikpũrhã ru umgbɔ. Ivangyɛ unga aka azĩ atsĩ ru umgbɔ, unga asi ikpoa ubin, ayerhe ukpekũ ake akpusha adɛ̃ɛ̃, ubinkutsu, asi iwea ivang ikpũrhũ uvorhvo. <verse eid="MRK 11:13"/><verse number="14" style="v" sid="MRK 11:14"/>Mɔcɛ unga agɔr uvorhvo ha agɛ, &lt;&lt;Unera niba abvui aghaa ikpũrhãngo ugbagbaa!&gt;&gt; Angwɛ̃ imesa igambɔ agũmbɔ ubinkpi unga aka arherhe.<verse eid="MRK 11:14"/></para>
  <para style="s1">Uyesu asare Iya-Num</para>
  <para style="r">(<ref loc="MAT 21:12-17">Umat 21.12-17</ref>; <ref loc="LUK 19:45-48">Irh 19.45-48</ref>; <ref loc="JHN 2:13-22">Uyoh 2.13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15"/>Umbɔ aka atsĩ Urusharhima, Uyesu atsĩ ri Iya-Num atirha awayiwe abika agoi igoi nu abika agugoyiwe umɔ. Akwɛr atsime atebur abika afaruwe uhwɛk nu anang isei abika agoyiwe anurhɛu. <verse eid="MRK 11:15"/><verse number="16" style="v" sid="MRK 11:16"/>Akɛna anera ikũ ubin ukpuku ugoiwe atɔng ra angwĩ Iya-Num. <verse eid="MRK 11:16"/><verse number="17" style="v" sid="MRK 11:17"/>Unga amesuwe anera agɛ, &lt;&lt;Itsɛng Arherhu-Num isi igɔrngge ugɛ,</para>
  <para style="q1" vid="MRK 11:17">&lt;&lt; &lt;Awuri iyisi iyamum</para>
  <para style="q2" vid="MRK 11:17">iya ifɛn-Num ri idũa kishoo?<note caller="+" style="f"><char style="fr" closed="false">11.17 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="ISA 56:7">Uish 56.7</ref></char>.</note>&gt;</para>
  <para style="q1" vid="MRK 11:17">Nggayɛ umbi atsu ike iwu utai uwoyi avɛu.<note caller="+" style="f"><char style="fr" closed="false">11.17 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="JER 7:11">Uiri 7.11</ref></char>.</note>&gt;&gt;<verse eid="MRK 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18"/>Ateiya abika adzowe idɛm-Num nu abika amesuwe Ikpem aka agũ arherhe akɛrɛ umbɔ abee utsĩndĩ uwuku ufɛre unga, na agũ iwei unga ubinkutsu anera kishoo adzeidzeu imesanga.<verse eid="MRK 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19"/>Urhɛɛ uku uwe, Uyesu nu angwɛ̃ imesanga adzembɔ ru uteu ha.<verse eid="MRK 11:19"/></para>
  <para style="s1">Ucucii uvorhvo uwuku usherhe</para>
  <para style="r">(<ref loc="MAT 21:20-22">Umat 21.20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20"/>Ru ukpeeka, umbɔ aka atɔng, umbɔ anyã ucucii uvorhvo ha uku ukoyi kishoo nggu anunanga. <verse eid="MRK 11:20"/><verse number="21" style="v" sid="MRK 11:21"/>Ubitru ayita na agɔr Uyesu agɛ, &lt;&lt;A umarhem, urhi unyã! Ucucii uvorhvo ha ungo uku utsuke ikponum hã uku usherhumgbɔ!&gt;&gt;<verse eid="MRK 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Àka awe ru imangmang ru Unum! <verse eid="MRK 11:22"/><verse number="23" style="v" sid="MRK 11:23"/>Umum indɛyiwa umbi idzidzɛrhe, unera aba agɔr igũ iyɛrɛ agɛ, &lt;Utang itsingo ugba ru ukau ukugɔng,&gt; unga aba asi icicanga ra amɛnnga nu ubinkpi unga aka arherhe, na awea ri imangmang awuri ikorhukumbɔ unga. <verse eid="MRK 11:23"/><verse number="24" style="v" sid="MRK 11:24"/>Nggee umum idɛyiwa umbi, ubɛn ubinkpi umbi aka ifɛna ru ifɛn-Num, aka awe ru imangmang ugɛ umbi aka akpombi ukpɔ, ukpɔ iwuri iwu ukpumbi. <verse eid="MRK 11:24"/><verse number="25" style="v" sid="MRK 11:25"/>Ikɛi ubɛn ivangyɛ umbi aka idɛ̃ɛ̃ na afɛn-Num, umbi aba awembi ra avɔm nggu unera, àka atsũwe uner ha, nu Utɛmbi uwu afã atsũwã umbi ra arhimmbi.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">11.25 </char><char style="ft" closed="false">Abvur akɔɔ aki itsɛng abok aki isha agɔrke ikɛi ugɛ, </char><char style="fv" closed="false">26 </char><char style="fqa" closed="false">Bɔr itsitsũwe iba ishingge, rimi hã, Utɛmbi uwu afã asi ítsũwanga arhim umbi.</char></note><verse eid="MRK 11:25"/></para>
  <para style="s1">Acucang ijee Uyesu</para>
  <para style="r">(<ref loc="MAT 21:23-27">Umat 21.23-27</ref>; <ref loc="LUK 20:1-8">Irh 20.1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27"/>Umbɔ aka abvui atsĩ Urusharhima, Uyesu atsĩ azɛ̃rhã ri irhɛrh Iya-Num nukpi, umɔ ateiya abika adzowe idɛm-Num, nu abika amesuwe Ikpem nu anggbaashi anera aba ru unga. <verse eid="MRK 11:27"/><verse number="28" style="v" sid="MRK 11:28"/>Agɔr unga agɛ, &lt;&lt;Ungo ukũ ijee iyikisong unu ikorhe ifɛrhɛ iyɛrɛ ha? Ikɛi ungaa adzaa ungo ijee iyiki ikorhi ifɛrha ha?&gt;&gt;<verse eid="MRK 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Umum irhusa umbi ubina unying. Àka adzipuwa umum, umum idɛyiwa umbi umum ikũ ijee ungaa ikũ ikorha abin hã. <verse eid="MRK 11:29"/><verse number="30" style="v" sid="MRK 11:30"/>Ubɔtisima Uyohana udzeka afã use udzeka anera? Àka adɛyiwa umum!&gt;&gt;<verse eid="MRK 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31"/>Umbɔ akɛki itsũwã nggu adɔkambɔ, agɛ, &lt;&lt;Umɛn iba igɔr ugɛ, &lt;Udzek ra afã,&gt; unga awuri irhusa umɛn agɛ, &lt;Awu use utsu umbi ashimbi ri imangmang ru unga?&gt; <verse eid="MRK 11:31"/><verse number="32" style="v" sid="MRK 11:32"/>Bɔr umɛn iba igɔr ugɛ, &lt;Udzek ra anera,&gt; umɛn igũ iwei anera abɛrɛ, ubinkutsu, umbɔ anyangu Uyohana awu uner uwuku usɔm Arherhu-Num.&gt;&gt;<verse eid="MRK 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 11:33"/>Nggee umbɔ agɔr Uyesu agɛ, &lt;&lt;Umɛn isi ihwɛngmɛn.&gt;&gt;</para>
  <para style="p" vid="MRK 11:33">Uyesu agɔr umbɔ agɛ, &lt;&lt;Umum igamum isi ídɛyiwamum umbi umum ikũ ijee iyikisong ikorha abin hã.&gt;&gt;<verse eid="MRK 11:33"/></para>
  <chapter eid="MRK 11"/>
  <chapter number="12" style="c" sid="MRK 12"/>
  <para style="s1">Unyaka arherhe aki abi irham imang</para>
  <para style="r">(<ref loc="MAT 21:33-46">Umat 21.33-46</ref>; <ref loc="LUK 20:9-19">Irh 20.9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1"/>Uyesu arherhe unyaka arherhe adzise umbɔ, agɛ, &lt;&lt;Utsa uwɔɔ akau icang inebi, adzin ufɔm adzipuwe icang hã, asim ughwee ri ifa ukpuku upayi amɛ̃ ikpũrhũ inebi ha, ikɛi atar akang utsurha udedetamgbɔ uwu idzɛu. Mɔcɛ unga atsu abɔɔ abi irham imang ri icang hã, na azĩã abĩ akase. <verse eid="MRK 12:1"/><verse number="2" style="v" sid="MRK 12:2"/>Ivang iyiki ikɔng inebi ha iki iwe, unga adene ugãrhãnga azĩ ra abi irham imang ri icang hã, ayɛise ikpũrhũ inebi ri icang hã. <verse eid="MRK 12:2"/><verse number="3" style="v" sid="MRK 12:3"/>Bɔr abi irham imang hã adzur ugãrhã hã, akwɛr unga, na awayiwe unga nggu abok aka atãrhã. <verse eid="MRK 12:3"/><verse number="4" style="v" sid="MRK 12:4"/>Mɔcɛ unga adene ugãrhũ uwɔɔ, umbɔ akwɛr uwu ha ni itsia, na ayɛia unga. <verse eid="MRK 12:4"/><verse number="5" style="v" sid="MRK 12:5"/>Unga anang adene uwɔɔ, uwu ha umbɔ afɛrkumbɔ unga. Unga adene abɔɔ arhɛrhɛ, abi irham imang hã akwɛr abɔɔ, na afɛre abɔɔ.<verse eid="MRK 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6"/>&lt;&lt;Unga abɔra unera unying unga aka idene, ungwɛ̃nga aka abema. Unga adene unga uwu imaataka, na agɛ, &lt;Awuri idzowukumbɔ igɔng ru ungwɛ̃mum.&gt;<verse eid="MRK 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7"/>&lt;&lt;Bɔr abi irham imang hã agɔr adɔkambɔ agɛ, &lt;Uwuku ugha ukam icang hã nuwi. Àka aba umɛn ifɛre unga, nu icanga iwu iyimɛn.&gt; <verse eid="MRK 12:7"/><verse number="8" style="v" sid="MRK 12:8"/>Nggee umbɔ adzur unga afɛre unga, na atare ukoma ru undzing ufɔm icang hã.&gt;&gt;<verse eid="MRK 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9"/>Uyesu arhusa umbɔ agɛ, &lt;&lt;Uner icang hã awuri ikorha aguse? Awuri iba atsĩme abi irham imang hã na adzowe icang hã ra abɔɔ. <verse eid="MRK 12:9"/><verse number="10" style="v" sid="MRK 12:10"/>Umbi aka avarhumbi ri itsɛng Arherhu-Num akirakɛ aka agɔr ugɛ,</para>
  <para style="q1" vid="MRK 12:10">&lt;&lt; &lt;Utarhkpi abi idzin aka akpɛ̃,</para>
  <para style="q2" vid="MRK 12:10">ukpɔ uwu utarh ãgboki idzin.<verse eid="MRK 12:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11"/>Uteijee ha unga akorha akɛrɛ,</para>
  <para style="q2" vid="MRK 12:11">awu ubin igbigba ra asumɛn.&gt;<note caller="+" style="f"><char style="fr" closed="false">12.11 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="PSA 118:22">Amb 118.22</ref>,<ref loc="PSA 118:23">23</ref></char>.</note>&gt;&gt;<verse eid="MRK 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12"/>Mɔcɛ umbɔ abee udĩ ukpuku udzur unga, ubinkutsu umbɔ ahwɛngmbɔ ugɛ arherhe unyaka arherhe ha iwu ra atsimbɔ. Bɔr umbɔ agũ iwei anera, ngge itsu umbɔ neke unga na azĩmbɔ.<verse eid="MRK 12:12"/></para>
  <para style="s1">Arhusu ifai ikirbi abĩ ru Ukaisar</para>
  <para style="r">(<ref loc="MAT 22:15-22">Umat 22.15-22</ref>; <ref loc="LUK 20:20-26">Irh 20.20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13"/>Akɛrɛ aka amaa umbɔ adene abi Ufarisi abɔɔ nu aner Uhiridu umbɔ azĩ adeyi Uyesu ri irhɛm arherhanga. <verse eid="MRK 12:13"/><verse number="14" style="v" sid="MRK 12:14"/>Umbɔ aba agɔr unga agɛ, &lt;&lt;A umarhem, umɛn ihwɛngmɛn ungo urhiku uner. Anera kishoo awu ubina unying ru ungo, ubinkutsu amɛ̃ngo ashike nggu iwiwe uner, bɔr ungo umesuwe utsĩndĩ Unum ri idzidzɛrhe. Ungo unyã imɛ̃ngge umɛn ifase ikirbi abĩ ru Ukaisar use isi imɛ̃ngge? <verse eid="MRK 12:14"/><verse number="15" style="v" sid="MRK 12:15"/>Umɛn ifai use umɛn neke ififai?&gt;&gt;</para>
  <para style="p" vid="MRK 12:15">Bɔr Uyesu ahwɛnga ukpukpetambɔ. Unga agɔr umbɔ agɛ, &lt;&lt;Awu use utsu umbi andeya umum? Àka akũwã ishaa imang hã umbɔ iki ikũ afai ikirbi abĩ ru umum inya.&gt;&gt; <verse eid="MRK 12:15"/><verse number="16" style="v" sid="MRK 12:16"/>Umbɔ aka akowe ishaa imang hã, unga arhusa umbɔ agɛ, &lt;&lt;Uzirhzĩ ukpirɛ nu itsok ikɛrɛ iwu iki ungamɔ?&gt;&gt;</para>
  <para style="p" vid="MRK 12:16">Umbɔ agɛ, &lt;&lt;Iki Ukaisar.&gt;&gt;<verse eid="MRK 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Àka adzowe Ukaisar ubin ukpunga na adzowe Unum ubin ukpu Unum.&gt;&gt;</para>
  <para style="p" vid="MRK 12:17">Umbɔ adzeidzeu akarhãrhã ru unga. <figure style="fig" alt="Coin called Denarius" file="gt00059.tif" size="col" loc="12.17" copy="Gordon Thompson" ref="12.13-17">Ishaa imang umbɔ aki iyisa udinari</figure><verse eid="MRK 12:17"/></para>
  <para style="s1">Arhusa arherhe isoka akpe</para>
  <para style="r">(<ref loc="MAT 22:23-33">Umat 22.23-33</ref>; <ref loc="LUK 20:27-40">Irh 20.27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18"/>Abi Usaduki abɔɔ, abika agɔr agɛ isok ra akpe ishingge, aba ru Uyesu nggu irhirhusa. <verse eid="MRK 12:18"/><verse number="19" style="v" sid="MRK 12:19"/>Agɔr unga agɛ, &lt;&lt;A umarhem, Umusa atsɛnga umɛn ugɛ unera aba akpea na abɔre utsɛ̃nga ashia ra awɛkaci, awu ufang ungwɛ̃mbɔ anyangu utsɛ̃rhãpfu ha amare awɛkaci ru ungwɛ̃mbɔ. <verse eid="MRK 12:19"/><verse number="20" style="v" sid="MRK 12:20"/>Abɔɔ rabɔ utɔɔva awu angwɛ̃ uyi akatsak. Uwu inggbaashia apfuna, na akpe ashia ru ungwɛ̃. <verse eid="MRK 12:20"/><verse number="21" style="v" sid="MRK 12:21"/>Uwu uvaa ikɛi apfunu utsɛ̃rhãpfu ha, iganga akpea, ashia ru ungwɛ̃. Uwu untaar rimi hã. <verse eid="MRK 12:21"/><verse number="22" style="v" sid="MRK 12:22"/>Rimi hã kishookambɔ utɔɔva ha, asi ibɔrukumbɔ ungwɛ̃. Ri imimasha utsɛ̃rhãpfu ha ikɛi akpea. <verse eid="MRK 12:22"/><verse number="23" style="v" sid="MRK 12:23"/>Ri isok ra akpe awuri iwu utsɛrha ungamɔ ru umbɔ? Ubinkutsu kishookambɔ utɔɔva apfunumbɔ unga.&gt;&gt;<verse eid="MRK 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Umbi asi igbambi irhak umbi aka asi ihwɛngmbi itsɛng Arherhu-Num use ijeenga? <verse eid="MRK 12:24"/><verse number="25" style="v" sid="MRK 12:25"/>Ivangyɛ abika akpukpe aka isok, asi ípfunumbɔ use adzowukumbɔ ipfuna, umbɔ awuri iwe ru nyaki ípfu itser-Num ra afã. <verse eid="MRK 12:25"/><verse number="26" style="v" sid="MRK 12:26"/>Ra arherhi isok ra akpe, umbi anasi ivarhumbi akɛrɛ ha ru ubvur Umusa, ri isarhe ufum uku ugar urha? Unum aka agɔr Umusa agɛ, &lt;Umum iwu Unum uwu Uibrahim, nu uwu Uishaku, nu ikɛi uwu Uyakubu.&gt;<note caller="+" style="f"><char style="fr" closed="false">12.26 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="EXO 3:6">Idzi 3.6</ref></char>.</note> <verse eid="MRK 12:26"/><verse number="27" style="v" sid="MRK 12:27"/>Unga asi iwea Unum uwu abika akpe, bɔr unga awu uwu abi urhɛ. Umbi agba irhak iki ibewe!&gt;&gt;<verse eid="MRK 12:27"/></para>
  <para style="s1">Ikpem iki igɔng</para>
  <para style="r">(<ref loc="MAT 22:34-40">Umat 22.34-40</ref>; <ref loc="LUK 10:25-28">Irh 10.25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28"/>Utsa uwɔɔ uwuku umesuwe Ikpem aba agũ umbɔ adɛ̃ɛ̃ uning nggu adɔka. Unga aka agũ ugɛ Uyesu adzowe umbɔ irhɛm iyiki ize, unga arhusa unga agɛ, &lt;&lt;Kishoo ikpem, iyikisong iwu iki igɔnga?&gt;&gt;<verse eid="MRK 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29"/>Uyesu agɔr unga agɛ, &lt;&lt;Iki igɔnga iwu nggɛɛ agɛ, &lt;Àka agũ umum umbi abi Uisrairha, Uteijee Unummɛn, awu Uteijee unying. <verse eid="MRK 12:29"/><verse number="30" style="v" sid="MRK 12:30"/>Ubemu Uteijee Unumngo nggu amɛnngo kishoo, nggu urhɛngo kishoo, nu ihwihwɛngngo kishoo, nu nggu ikerngo kishoo.&gt;<note caller="+" style="f"><char style="fr" closed="false">12.30 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="DEU 6:4">Iva 6.4</ref>,<ref loc="DEU 6:5">5</ref></char>.</note> <verse eid="MRK 12:30"/><verse number="31" style="v" sid="MRK 12:31"/>Iyi ivaa ha igɛ, &lt;Ubemu undɔkango ru nyaka ungo uku ubemi itsingo.&gt;<note caller="+" style="f"><char style="fr" closed="false">12.31 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="LEV 19:18">Urha 19.18</ref></char>.</note> Íkpem iyɔɔ isi inangngge iyɛrɛ ha.&gt;&gt;<verse eid="MRK 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32"/>Uwuku umesuwe ikpem ha agɔr Uyesu agɛ, &lt;&lt;Ungo urhika ra arherhango uku urherhe ugɛ Unum awu unying uwɔɔ ashia bɔr unga. <verse eid="MRK 12:32"/><verse number="33" style="v" sid="MRK 12:33"/>Ubema unga nggu amɛnngo kishoo, nu ihwihwɛngngo kishoo nu ikerngo, nu ubemu udɔkango ru nyaki itsingo, ananga izũwã iyiki ikpikpĩĩ nu idɛm-Num.&gt;&gt;<verse eid="MRK 12:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34"/>Uyesu aka agũ unga arherha arherhe itsoi, unga agɔr unga agɛ, &lt;&lt;Ungo uku ukhapungo nggu Iyɛrhe Unum.&gt;&gt; Mɔcɛ unera asi irhusunga ubin ukpɔɔ.<verse eid="MRK 12:34"/></para>
  <para style="s1">Arhusa arherhe ri itsi Ukiristo</para>
  <para style="r">(<ref loc="MAT 22:41-46">Umat 22.41-46</ref>; <ref loc="MAT 23:1-36">23.1-36</ref>; <ref loc="LUK 20:41-47">Irh 20.41-47</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35"/>Uyesu aka adɛ̃ɛ̃ amesuwe ru ufɔm Iya-Num unga arhusa agɛ, &lt;&lt;Awu use utsu abika amesuwe Ikpem anu igɔr agɛ Ukiristo awu ungwɛ̃ Udauda? <verse eid="MRK 12:35"/><verse number="36" style="v" sid="MRK 12:36"/>Udauda nibikanga, ri ijee Ipfu Isarsatangge unga agɔr agɛ,</para>
  <para style="q1" vid="MRK 12:36">&lt;&lt; &lt;Uteijee agɔr Uteijeemum agɛ,</para>
  <para style="q2" vid="MRK 12:36">usei ru ubok ughamum,</para>
  <para style="q1" vid="MRK 12:36">&lt;&lt;Utsɛku umum iki itsu anggamtsakngo</para>
  <para style="q2" vid="MRK 12:36">ru andaidakngo.&gt;&gt; &gt;<note caller="+" style="f"><char style="fr" closed="false">12.36 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="PSA 110:1">Amb 110.1</ref></char>.</note><verse eid="MRK 12:36"/></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37"/>Udauda nibikanga ayisu Ukiristo agɛ, &lt;Uteijee.&gt; Awuri ikorha aguse ru Uteijee awu ungwɛ̃ ru Udauda?&gt;&gt;</para>
  <para style="p" vid="MRK 12:37">Nggaa ikikɔng anera ikpeto ru unga nggu itɛnamɛn.<verse eid="MRK 12:37"/></para>
  <para style="s1">Uyesu ayare igoi abika amesuwe Ikpem</para>
  <para style="r">(<ref loc="MAT 23:1-36">Umat 23.1-36</ref>; <ref loc="LUK 11:37-54">Irh 11.37-54</ref>; <ref loc="LUK 20:45-47">20.45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38"/>Ri imesanga, Uyesu agɔr agɛ, &lt;&lt;Àka akpɔm amɛnmbi nggu abika amesuwe Ikpem, umbɔ abee itsĩm atorho akagɔng azɛ̃rhã, abee anera aghwe umbɔ ri inang izɛɛ, <verse eid="MRK 12:38"/><verse number="39" style="v" sid="MRK 12:39"/>ikɛi umbɔ abee anera adzise umbɔ anang isei aka aze ra abã ifɛn-Num, nu anang isei aka aze ra anang irhowa. <verse eid="MRK 12:39"/><verse number="40" style="v" sid="MRK 12:40"/>Umbɔ awu abika aghawe abin atsɛ̃rhãpfu na avur ayambɔ, na adarhi ider ifɛn-Num iyi igbana. Ikpũ umbɔ awuri itsu umbɔ ufai akarhãrhã.&gt;&gt;<verse eid="MRK 12:40"/></para>
  <para style="s1">Izũwũ utsɛ̃rhãpfu</para>
  <para style="r">(<ref loc="LUK 21:1-4">Irh 21.1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41"/>Uyesu asei ri ifɛna ra anangkɛ umbɔ iki itsu izũwã ri Iya-Num, azɛrhe anera iki itsuyiwe uhwɛk ri ijara izũwã. Abɔɔ abi ubin arhɛrhɛ atsu uhwɛk urhɛrhɛ. <verse eid="MRK 12:41"/><verse number="42" style="v" sid="MRK 12:42"/>Mɔcɛ utsũwũ utsɛ̃rhãpfu uwɔɔ, aba atsuke ungwɛ̃rhĩ íshaa imang ivaa iki isi iwengge ubin.<verse eid="MRK 12:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 12:43"/>Uyesu ayisa angwɛ̃ imesanga aba ru unga, agɔr umbɔ agɛ, &lt;&lt;Umum indɛyiwa umbi idzidzɛrhe, ubinkpi utsũwã utsɛ̃rhãpfu uwurɛ aka atsu ri ijara izũwã hã, inangngge iyimbɔ aka adzowe kishoo. <verse eid="MRK 12:43"/><verse number="44" style="v" sid="MRK 12:44"/>Kishoo adzowe ra arhɛrha abinmbɔ aka awe, bɔr unga ri itsũwãnga, unga adzowe kishoo ubinkpi unga aka awe ra ukpɔ.&gt;&gt;<verse eid="MRK 12:44"/></para>
  <chapter eid="MRK 12"/>
  <chapter number="13" style="c" sid="MRK 13"/>
  <para style="s1">Uyesu asɔm ikpũ isisipa Iya-Num</para>
  <para style="r">(<ref loc="MAT 24:1-35">Umat 24.1-35</ref>; <ref loc="LUK 21:5-33">Irh 21.5-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1"/>Uyesu adzeka ri Iya-Num nukpi, unying ra angwɛ̃ imesanga agɔr unga agɛ, &lt;&lt;A umarhem, urhi unyã nggaa atarh akɛrɛ, nu ídzin iyɛrɛ!&gt;&gt;<verse eid="MRK 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2"/>Uyesu agɔr unga agɛ, &lt;&lt;Ungo unyãɔ nggaa ídzin iyɛrɛ? Awuri isipuwe ngge kishoo. Asi ínekukumbɔ utarh unying nu undɔkakpɔ.&gt;&gt;<verse eid="MRK 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3"/>Uyesu asei ni itsi Igũ Acucii Uzaitun iki idɛ̃ɛ̃ ra asu Iya-Num. Ubitru, Uyaku, Uyohana nu Uandarawu arhusa unga ri iwɔk agɛ, <verse eid="MRK 13:3"/><verse number="4" style="v" sid="MRK 13:4"/>&lt;&lt;Usɔma umɛn, ifɛrha ha ikorhu ukang? Utsara uwu uguse umbɔ aka inyã ri ivangyɛ ngge iki itirhi ikorhe?&gt;&gt;<verse eid="MRK 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Àka arhi anyã, utsur unera arhɛma umbi. <verse eid="MRK 13:5"/><verse number="6" style="v" sid="MRK 13:6"/>Anera arhɛrhɛ aka idzeka ri itsokmum, anu igɔr agɛ, &lt;Umum iwu unga,&gt; umbɔ awuri irhɛm anera arhɛrhɛ. <verse eid="MRK 13:6"/><verse number="7" style="v" sid="MRK 13:7"/>Ivangyɛ umbi aka igũ isarhe iwa nu ugbugbewangge, niba asoyimbi amɛnmbi. Awu ufang akɛrɛ ha akorhe, bɔr imimasha ina ishingge kata. <verse eid="MRK 13:7"/><verse number="8" style="v" sid="MRK 13:8"/>Abi abĩ akɔɔ asok adɛ̃ɛ̃ igamtsak nggu abi abĩ akɔɔ, iyɛrhe iso idɛ̃ɛ̃ igamtsak nggu iyɛrhe. Abĩ awuri izizusa ri inanga irhɛirhɛ, nu ikpo imerh iwuri itsĩwãngge. Awu ititirhi uver imar.<verse eid="MRK 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9"/>&lt;&lt;Awu ufang umbi adzɛu. Awuri ikũna umbi azĩ ra abi ijee iyɛrhe na akwɛr umbi ra abã ifɛn-Num. Awuri ikũna umbi azĩ ra asu anggbaashi nu ayɛrhe ri itsimum, ubinkutsu umbi awuri iwu idekamum ra asumbɔ. <verse eid="MRK 13:9"/><verse number="10" style="v" sid="MRK 13:10"/>Awu ufang umbɔ aka igbaashia adzowe Isarhe Iyiki Ize ri idũa kishoo kata, ri imimasha idɔrhi iba. <verse eid="MRK 13:10"/><verse number="11" style="v" sid="MRK 13:11"/>Ubɛn ivangyɛ umbɔ aka idzur umbi akũ azĩ ra aya ayɛrhe, àka niba agũmbi ighong ru ubinkpi umbi aka irherhe. Àka arherhu ubɛn ubinkpi umbɔ aka idzaa umbi ri ivang hã, ubinkutsu, asi íwea umbi irherhe ri ivang hã, awu Ipfu Isarsatangge.<verse eid="MRK 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 13:12"/>&lt;&lt;Ungwɛ̃yi awuri idzowe ungwɛ̃mbɔ umbɔ afɛre, utei ikɛi awuri idzowe ungwɛ̃nga. Awɛkaci ikɛi awuri iwu ri igamtsak nggu ateimbɔ utsɛku umbɔ aka itsu umbɔ afɛre umbɔ. <verse eid="MRK 13:12"/><verse number="13" style="v" sid="MRK 13:13"/>Anera kishoo awuri ikpɛ̃na umbi ri itsokmum. Bɔr uwuku ubima utsɛku imimasha awuri ikpoa ififɔrh.<verse eid="MRK 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14"/>&lt;&lt;Ivangyɛ umbi aka inyã ubin ishĩ ukpuku ukũ itsitsĩme udɛ̃ɛ̃kpɔ ra anangkɛ aka asi imɛ̃ke, abika awu ru Uyahudiya atĩrhã azĩ ri ígũ, neke uner uwuku uvarhe ahwɛng.<note caller="+" style="f"><char style="fr" closed="false">13.14 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="DAN 9:27">Udan 9.27</ref>; <ref loc="DAN 11:31">11.31</ref>; <ref loc="DAN 12:11">12.11</ref></char>.</note> <verse eid="MRK 13:14"/><verse number="15" style="v" sid="MRK 13:15"/>Uwuruwi aka awe ri itsi uvi niba acipuwanga inyãngu ubin ri iya. <verse eid="MRK 13:15"/><verse number="16" style="v" sid="MRK 13:16"/>Uwuruwi aka awe ra arhum ikɛi niba abvui abanga inyãngu untamanga. <verse eid="MRK 13:16"/><verse number="17" style="v" sid="MRK 13:17"/>Atorhmbi akatsɛrh abika awu ra ana nu abika akpɔm awɛkaci ri ivang hã! <verse eid="MRK 13:17"/><verse number="18" style="v" sid="MRK 13:18"/>Àka afɛn-Num utsur ifɛrhɛ ha ikorhungge ri idoyi. <verse eid="MRK 13:18"/><verse number="19" style="v" sid="MRK 13:19"/>Ri ivang hã awuri ihwambɔ ayetnum akarhãrhã akirakɛ aka anasi ikorhuke udzur ri ivangyɛ Unum aka amunu upfunga, utsɛku icɛrɛ. Asi íbvui akorhumbɔ ikpũ hã ugbagbaa. <verse eid="MRK 13:19"/><verse number="20" style="v" sid="MRK 13:20"/>Uteijee aba asi ishɔyika inum hã, unera unying asi íbɛka. Bɔr ru ubok abirabɛ unga aka asɛng, unga ashɔyika inum hã. <verse eid="MRK 13:20"/><verse number="21" style="v" sid="MRK 13:21"/>Ri ivang hã unera aba agɔra umbi agɛ, &lt;Àka anyã, Ukiristo uwi!&gt; use &lt;Àka anyã, nggawɔ!&gt; niba awembi ri imangmang ra ake. <verse eid="MRK 13:21"/><verse number="22" style="v" sid="MRK 13:22"/>Ukiristo igbɛrangwĩ nu abika asɔm Arherhu-Num igbɛrangwĩ awuri idzidzeka, awuri idɛyiwe atsar nu abin idzeu akũ arhɛm anera nggu abirabɛ Unum aka asɛng, umbɔ aba adɛ̃ɛ̃ amɛ̃ɛ̃mbɔ. <verse eid="MRK 13:22"/><verse number="23" style="v" sid="MRK 13:23"/>Nggee, àka arhi! Umum iki idɛyiwamum abina kishoo ake adɔrha aba.<verse eid="MRK 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24"/>&lt;&lt;Bɔr ri ivang hã, ayetnum akika aba ha aka imaa,</para>
  <para style="q1" vid="MRK 13:24">&lt;&lt; &lt;awuri itsu ishaa unum iwu uzĩ.</para>
  <para style="q2" vid="MRK 13:24">Ufɛ̃ ikɛi usi írhangmgbɔ.<verse eid="MRK 13:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="MRK 13:25"/>Ídzɛɛr idzeka afã igbei.</para>
  <para style="q1" vid="MRK 13:25">Ikɛi awuri izizusa nggaa abinkɛ aka awu afafã ra afã.&gt;<note caller="+" style="f"><char style="fr" closed="false">13.25 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="ISA 13:10">Uish 13.10</ref>; <ref loc="ISA 34:4">34.4</ref></char>.</note><verse eid="MRK 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 13:26"/>&lt;&lt;Mɔcɛ Ungwɛ̃-Ner aka icipuwa ra amɛɛ nggu nggaa ijee nu imor. <verse eid="MRK 13:26"/><verse number="27" style="v" sid="MRK 13:27"/>Mɔcɛ unga awuri idene ípfu itsernga nggu atsom aki irhak ayisa, na awuri ikɔng abirabɛ umbɔ aka asɛng ra anggbokunga anaa, udiku igɔ̃kpee nu udiku urhɛɛ nu unɔr nu ufã, udzur ru ubandzin upfunga udiku ukpɛrɛ uzĩ udiku ukpɔrɔ.<verse eid="MRK 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28"/>&lt;&lt;Àka amesu ubin ukpɔɔ ru ucucii uvorhvo. Umbi aba anyã aboke apfum adzeka nggu ayerhe aka afa, umbi ihwɛng ugɛ isung amɛka iki iyongge. <verse eid="MRK 13:28"/><verse number="29" style="v" sid="MRK 13:29"/>Rimi hã ikɛi umbi aba anyãmbi ifɛrhɛ iyɛrɛ itirhungge, umbi ahwɛng ugɛ ivanga iki iyongge, iki ibangge ra angwĩã. <verse eid="MRK 13:29"/><verse number="30" style="v" sid="MRK 13:30"/>Umum indɛyiwa umbi idzidzɛrhe, udan ukpirɛ usi ítɔngkpɔ utsɛku ifɛrhɛ ha kishoo iki ikorhe. <verse eid="MRK 13:30"/><verse number="31" style="v" sid="MRK 13:31"/>Afã nggu abĩ awuri itɔngke, bɔr arherhamum asi ítɔngke.<verse eid="MRK 13:31"/></para>
  <para style="s1">Unera asi ihwɛnga unum ibiba Ukiristo</para>
  <para style="r">(<ref loc="MAT 24:36-44">Umat 24.36-44</ref>; <ref loc="LUK 17:26-30">Irh 17.26-30</ref>,<ref loc="LUK 17:34-35">34-35</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32"/>&lt;&lt;Unera asi ihwɛnga unum hã use ivang hã, ípfu itser-Num ra afã isi ihwɛngngge, Ungwɛ̃-Ner asi ihwɛnga, Utɛ ukpekũ unga ahwɛng. <verse eid="MRK 13:32"/><verse number="33" style="v" sid="MRK 13:33"/>Àka arhi, àka agbisha adzɛu, ubinkutsu umbi asi ihwɛngmbi ivanga ngge iki ikorhe. <verse eid="MRK 13:33"/><verse number="34" style="v" sid="MRK 13:34"/>Awuri iwe ru nyaku uner uzɛ̃rhã. Ivangyɛ unga aka isok, unga idzowe iya ra agãrhãnga, ubɛn unera awea ri itsernga aka itɔ̃. Mɔcɛ unga aka itsu uner idzɛu, unga agbisha adzɛu.<verse eid="MRK 13:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 13:35"/>&lt;&lt;Nggee àka adɛ̃ɛ̃ adzɛu, ubinkutsu umbi asi ihwɛngmbi ivangyɛ uner iya ha aka ibvui aba, use ru urhɛɛka, use ri ikɔtsuuka, use ri ivang ikɔ iki igbɛr ukpee, use ru unkpeeka. <verse eid="MRK 13:35"/><verse number="36" style="v" sid="MRK 13:36"/>Utsur unga aba umbi asi ihwɛngmbi, unga akpo umbi awu ru urhɔ. <verse eid="MRK 13:36"/><verse number="37" style="v" sid="MRK 13:37"/>Ubinkpi umum iki idɛyiwa umbi, umum indɛyiwe ubɛn unera, aka agbisha asei adzɛu!&gt;&gt;<verse eid="MRK 13:37"/></para>
  <chapter eid="MRK 13"/>
  <chapter number="14" style="c" sid="MRK 14"/>
  <para style="s1">Anggbaashi akɛki itsũwã <optbreak/> iyiki ifɛre Uyesu</para>
  <para style="r">(<ref loc="MAT 26:1-5">Umat 26.1-5</ref>; <ref loc="LUK 22:1-2">Irh 22.1-2</ref>; <ref loc="JHN 11:45-53">Uyoh 11.45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1"/>Abɔr inuma ivaa umbɔ azek Irhowa Iyiki Igar Utɔng nu iyi Uborodi Ukpuku Usheru Uguga, ateiya abika adzowe idɛm-Num nu abika amesuwe Ikpem abee utsĩndĩwi umbɔ aka idzur Uyesu ri iwɔk afɛre unga. <verse eid="MRK 14:1"/><verse number="2" style="v" sid="MRK 14:2"/>Umbɔ anu igɔr agɛ, &lt;&lt;Bɔr asi íwea ri ivang irhowa, utsur anera awuri isoyi amɛnmbɔ.&gt;&gt;<verse eid="MRK 14:2"/></para>
  <para style="s1">Adzukuwe Uyesu atsei isung <optbreak/> ru Ubetani</para>
  <para style="r">(<ref loc="MAT 26:6-13">Umat 26.6-13</ref>; <ref loc="JHN 12:1-8">Uyoh 12.1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3"/>Uyesu awe ru Ubetani ri iya utsa uwɔɔ umbɔ iki iyisa Usiman uner ingbim, awuri igha ubingha nukpi, utsɛrh uwɔɔ aba nggu ungwɛ̃rhũ udzoma utɔk nggu atsei isung aki imang akarhãrhã aki ikũ unardi ayang. Unga ayar udzoma hã atsuke atsei ha ri itsi Uyesu.<verse eid="MRK 14:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 14:4"/>Abɔɔ aka awe umɔ agũ avɔm agɔr adɔkambɔ agɛ, &lt;&lt;Awu use utsu umbɔ atare atsei isung ha ibɛm rimi? <verse eid="MRK 14:4"/><verse number="5" style="v" sid="MRK 14:5"/>Uda umbɔ agoshe atsei ha atsĩke imang itser unera iyi amɛka, umbɔ aka idzowe atsũwã.&gt;&gt; Umbɔ atsɛrhu utsɛrh ha ri ifuw.<verse eid="MRK 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6"/>Bɔr Uyesu agɛ, &lt;&lt;Àka aneke unga. Awu use utsu umbi arherha unga? Awu ubin uku uze unga aka akorhuwa umum. <verse eid="MRK 14:6"/><verse number="7" style="v" sid="MRK 14:7"/>Atsũwã awu nggu umbi ubɛn unum, umbi adɛ̃ɛ̃ ayikukumbi umbɔ ri ivangyɛ umbi aka abee. Bɔr umum iwuri iwe nggu umbi ivanga ukunjiir. <verse eid="MRK 14:7"/><verse number="8" style="v" sid="MRK 14:8"/>Akorhu ubinkpi ikernga iki imɛ̃. Adzukuwa atsei agbishi iyormum iyiki idzidzake. <verse eid="MRK 14:8"/><verse number="9" style="v" sid="MRK 14:9"/>Umum indɛyiwa umbi idzidzɛrhe, kishoo anangkɛ umbɔ aka idzowe Isarhe Iyiki Ize iyɛrɛ ru upfunga, awuri isɔmmbɔ ubinkpi utsɛrh uwurɛ aka akorhe umbɔ ayita unga.&gt;&gt;<verse eid="MRK 14:9"/></para>
  <para style="s1">Uyahuda Uiskariyoti Agha-dak Uyesu</para>
  <para style="r">(<ref loc="MAT 26:14-16">Umat 26.14-16</ref>; <ref loc="LUK 22:3-6">Irh 22.3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10"/>Mɔcɛ Uyahuda Uiskariyoti, unying ra angwɛ̃ imesa usɔkdũmɛn hã, azĩ ru ateiya abika adzowe idɛm-Num nu unga agha-dak Uyesu na adzowe ru umbɔ. <verse eid="MRK 14:10"/><verse number="11" style="v" sid="MRK 14:11"/>Umbɔ aka agũ rimi umbɔ agɔm anggɔm na abemuwe unga uhwɛk. Nggee Uyahuda abee utsĩndĩã unga aka idzowe unga ru ubok.<verse eid="MRK 14:11"/></para>
  <para style="s1">Irhowa Iyiki Igar Utɔng iyi imaatak</para>
  <para style="r">(<ref loc="MAT 26:17-25">Umat 26.17-25</ref>; <ref loc="LUK 22:7-14">Irh 22.7-14</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Uyoh 13.21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12"/>Ru unum ukpu inggbaashia ukpu Irhowu Uborodi Ukpuku Usheru Uguga, unum ukpuku ungwãni ungwɛ̃ itsurhi iyi Irhowa Iyiki Igar Utɔng, angwɛ̃ imesu Uyesu arhusa unga agɛ, &lt;&lt;Ri inɛ̃ɛ̃ ungo uku ubee umɛn izĩ ĩgbishuwa ungo igha Irhowa Iyiki Igar Utɔng?&gt;&gt;<verse eid="MRK 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13"/>Nggee unga adene angwɛ̃ imesanga avaa, agɔr umbɔ agɛ, &lt;&lt;Àka atsĩ ru utepa, nggɔɔ umbi awuri igbopumbi utsak uwɔɔ aka atsã idzuma amɛ̃. Àka adɔsa unga. <verse eid="MRK 14:13"/><verse number="14" style="v" sid="MRK 14:14"/>Iya ikɛ unga aka itsĩ, àka agɔr uteiya ha agɛ, &lt;Umarhem arhusa ugɛ ubã atsen ungwɛ̃kpɔ, umum iki igha Irhowa Iyiki Igar Utɔng nggu angwɛ̃ imesamum?&gt; <verse eid="MRK 14:14"/><verse number="15" style="v" sid="MRK 14:15"/>Unga awuri idɛyiwanga nggaa ubã afã ukpɔɔ umbɔ aka atsu abin iya amaambɔ. Àka igbishuwa ubinghamɛn umɔ.&gt;&gt;<verse eid="MRK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16"/>Angwɛ̃ imesa ha aka asok atsĩmbɔ ru utepa, anyã abina awe ru nyaku Uyesu aka asɔme umbɔ. Nggee umbɔ agbishu ubingha Irhowa Iyiki Igar Utɔng.<verse eid="MRK 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17"/>Urhɛɛ uku uwe, Uyesu nggu angwɛ̃ imesanga usɔkdũmɛn hã aba ri iya ha. <verse eid="MRK 14:17"/><verse number="18" style="v" sid="MRK 14:18"/>Awuri igha ubingha nukpi, Uyesu agɔr agɛ, &lt;&lt;Umum indɛyiwa umbi idzidzɛrhe, unying ru umbi aka agha nggu umum awuri ighadak umum.&gt;&gt;<verse eid="MRK 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19"/>Amɛnmbɔ atirhuke igũ ighong, anu igɔr unga anyinganying agɛ, &lt;&lt;Asi iwea umum, use awu umum?&gt;&gt;<verse eid="MRK 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Unying ru umbi usɔkdũmɛn hã, uwuruwi aka agha ri itɛ̃rhĩ unying nggu umum. <verse eid="MRK 14:20"/><verse number="21" style="v" sid="MRK 14:21"/>Ungwɛ̃-Ner awuri ikpe ru nyaka umbɔ aka atsɛng ri itsinga. Bɔr atorh uner ha aka ighadak Ungwɛ̃-Ner! Ugba umbɔ asi imarmbɔ unga.&gt;&gt;<verse eid="MRK 14:21"/></para>
  <para style="s1">Ubingha urhɛɛ Uteijee</para>
  <para style="r">(<ref loc="MAT 26:26-30">Umat 26.26-30</ref>; <ref loc="LUK 22:14-23">Irh 22.14-23</ref>; <ref loc="1CO 11:23-25">1Uko 11.23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22"/>Umbɔ aka adɛ̃ɛ̃ igha ubingha, Uyesu anyangu uborodi, atar uwɛɛ ru Unum, abvũ adzowe ra angwɛ̃ imesanga agɛ, &lt;&lt;Àka ayɛi uwɛrɛ atãi. Awu iyormum.&gt;&gt;<verse eid="MRK 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23"/>Na anyangu ukpɛwa amɛ̃ inebi, atar uwɛɛ ru Unum na adzowe ru umbɔ, kishoo ahwa ru umgbɔ.<verse eid="MRK 14:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 14:24"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Akɛrɛ awu adzirhmum aki ibibemuwe-Num nggu anernga, aka idze ru ubok anera arhɛrhɛ. <verse eid="MRK 14:24"/><verse number="25" style="v" sid="MRK 14:25"/>Umum indɛyiwa umbi idzidzɛrhe, umum isi íbvui ihwamum amɛ̃ inebi akɛrɛ utsɛku unumkpi umum iki ihwa akika afa akɔɔ ri Iyɛrhe Unum.&gt;&gt;<verse eid="MRK 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26"/>Umbɔ aka amaa itsũwe ubom ru Unum, umbɔ adzek azĩmbɔ Igũ Acucii Uzaitun.<verse eid="MRK 14:26"/></para>
  <para style="s1">Ubitru awuri itsɛyi Uyesu</para>
  <para style="r">(<ref loc="MAT 26:31-35">Umat 26.31-35</ref>; <ref loc="LUK 22:31-34">Irh 22.31-34</ref>; <ref loc="JHN 13:36-38">Uyoh 13.36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27"/>Uyesu agɔr angwɛ̃ imesanga agɛ, &lt;&lt;Kishookambi awuri itĩ na abɔra umum ikiyikami, ru nyaki itsɛng Arherhu-Num iki igɔr igɛ,</para>
  <para style="q1" vid="MRK 14:27">&lt;&lt; &lt;Umum ikwɛr uner uwuku udzɛu idɔi,</para>
  <para style="q2" vid="MRK 14:27">idɔsa ikɛi iwuri isitungge.&gt;<note caller="+" style="f"><char style="fr" closed="false">14.27 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="ZEC 13:7">Uzak 13.7</ref></char>.</note><verse eid="MRK 14:27"/></para>
  <para style="m">
    <verse number="28" style="v" sid="MRK 14:28"/>Bɔr ivangyɛ umum iki isok ra akpe, umum inggbaashia izĩ Ugarhirhi ru umbi adɔrha atsĩ umɔ.&gt;&gt;<verse eid="MRK 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29"/>Ubitru agɔr unga agɛ, &lt;&lt;Kishoo aba atĩna na abɔrambɔ ungo, umum isi ínekamum ungo.&gt;&gt;<verse eid="MRK 14:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30"/>Uyesu agɔr unga agɛ, &lt;&lt;Umum indɛyiwa ungo idzidzɛrhe, irherɛ, ru untsua ukpirɛ, ungo uwuri itsɛyingo ihwɛng umum idiki itaar ni ikɔ idɔrhi igbɛr ukpee idiki ivaa.&gt;&gt;<verse eid="MRK 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31"/>Bɔr Ubitru abvui arherhe akarhãrhã agɛ, &lt;&lt;Umbɔ aba awuri ifɛre umum nggu ungo, umum isi ítsɛyimum ihwɛng ungo.&gt;&gt; Kishoo angwɛ̃ imesanga arherhe rimi hã.<verse eid="MRK 14:31"/></para>
  <para style="s1">Uyesu ru Ugetsemani</para>
  <para style="r">(<ref loc="MAT 26:36-46">Umat 26.36-46</ref>; <ref loc="LUK 22:39-46">Irh 22.39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32"/>Azĩmbɔ anangkɛ umbɔ iki iyisa Ugetsemani, Uyesu agɔr angwɛ̃ imesanga agɛ, &lt;&lt;Àka asei nggimi umum izĩ ifɛn-Num.&gt;&gt; <verse eid="MRK 14:32"/><verse number="33" style="v" sid="MRK 14:33"/>Unga akũ Ubitru, nggu Uyaku nu Uyohana. Awu umɔ nukpi unga atirhunga igũ ighong akarhãrhã. <verse eid="MRK 14:33"/><verse number="34" style="v" sid="MRK 14:34"/>Unga agɔr umbɔ agɛ, &lt;&lt;Igũ ighongyɛ iki iwe ra amɛnmum idɛ̃ɛ̃ ifɛrngge umum. Àka asei nggimi na adzɛu.&gt;&gt;<verse eid="MRK 14:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35"/>Unga aka azĩ ra asu ukunjiir, na agba nu abĩ, afɛn-Num ugɛ ngge iba imɛ̃ngge, umbɔ anyanguwe ivang ayetnum akɛrɛ ru unga. <verse eid="MRK 14:35"/><verse number="36" style="v" sid="MRK 14:36"/>Unga agɛ, &lt;&lt;Abba,<note caller="+" style="f"><char style="fr" closed="false">14.36 </char><char style="ft" closed="false">Abba ri idũ Uaramayak igburh &lt;&lt;Utɛ&gt;&gt;.</char></note> Utɛ, ubɛn ubina imɛ̃ngge ru ungo. Unyanguwa ukpɛwa ayetnum akɛrɛ ru umum. Bɔr asi iwea ubinkpi umum iki ibee, bɔr awu ubinkpi ungo uku ubee.&gt;&gt;<verse eid="MRK 14:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37"/>Mɔcɛ unga abvui aba anyã angwɛ̃ imesa ha ikitatambɔ awu ru urhɔ. Unga agɔr Ubitru agɛ, &lt;&lt;Ungo uwu ru urhɔ? Ungo usi idɛ̃ɛ̃ idzɛupɔ ukara unying? <verse eid="MRK 14:37"/><verse number="38" style="v" sid="MRK 14:38"/>Àka adzɛu na afɛn-Num utsur umbi agbambi ru undeya. Idzidzɛrhe ipfu ibemungge bɔr iyor isi ikerngge.&gt;&gt;<verse eid="MRK 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39"/>Abvui azĩa ifɛn-Num, arherhe irhɛm iyi inggbaashia. <verse eid="MRK 14:39"/><verse number="40" style="v" sid="MRK 14:40"/>Mɔcɛ unga abvui aba ikɛi, akpo umbɔ awu ru urhɔ asumbɔ awu nggu urhɔ akarhãrhã. Umbɔ ashimbɔ nu ubinkpi umbɔ aka isɔme unga.<verse eid="MRK 14:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41"/>Ivangyɛ unga aka abvui aba ide untaar, unga agɔr umbɔ agɛ, &lt;&lt;Umbi ana awu ru urhɔ nu iwiwosha? Iki imɛ̃ mɔnɔ! Ivanga iki ibangge. Unyã, umbɔ aka agha-dak Ungwɛ̃-Ner na atsuke unga ra abok abi arhim. <verse eid="MRK 14:41"/><verse number="42" style="v" sid="MRK 14:42"/>Àka asisok umɛn izĩmɛn! Uwuku ugha adakmum uwi aka abanga!&gt;&gt;<verse eid="MRK 14:42"/></para>
  <para style="s1">Adzur Uyesu</para>
  <para style="r">(<ref loc="MAT 26:47-56">Umat 26.47-56</ref>; <ref loc="LUK 22:47-53">Irh 22.47-53</ref>; <ref loc="JHN 18:3-12">Uyoh 18.3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43"/>Uyesu awu ra arherhe nukpi, umbɔ anyã Uyahuda, unying ra angwɛ̃ imesanga usɔkdũmɛn hã. Unga aba nggu anera arhɛrhɛ aka akpɔm igbong nu akon akika ader. Ateiya abika adzowe idɛm-Num, abika amesuwe Ikpem nu akakũmbɔ aka adene umbɔ.<verse eid="MRK 14:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MRK 14:44"/>Uyahuda, uwuku ugha adak Uyesu, aka asɔmuka umbɔ agɛ, &lt;&lt;Uwuruwi umum iki ishor atamnga, awu unga nuwɔ. Aka adzur akũ azĩ. Aka angwɛ̃dzɛn na adzɛu unga.&gt;&gt; <verse eid="MRK 14:44"/><verse number="45" style="v" sid="MRK 14:45"/>Uyahuda aka aba, unga adarha azĩã ru Uyesu, agɔr unga agɛ, &lt;&lt;A umarhem!&gt;&gt; na ashor atamnga. <verse eid="MRK 14:45"/><verse number="46" style="v" sid="MRK 14:46"/>Anera adzur Uyesu akpɔm unga uku ungbongbong. <verse eid="MRK 14:46"/><verse number="47" style="v" sid="MRK 14:47"/>Bɔr unying ra awɛ imesu Uyesu uwuku ukhapa ru unga, awɔɔr ikon iki idernga, azharhuwe uto ugãrhũ Ukugɔng Uwuku Udzowe Idɛm-Num.<verse eid="MRK 14:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 14:48"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Umbi adzeka nggu igbong nu akon aka ader adzur umum ugɛ umum iwu uvɛu? <verse eid="MRK 14:48"/><verse number="49" style="v" sid="MRK 14:49"/>Ubɛn unuma umum iwu nggu umbi ri Iya-Num imesuwa umbi, umbi asi idzurmbi umum. Bɔr awu ufang itsɛng Arherhu-Num itsuifɛr.&gt;&gt; <verse eid="MRK 14:49"/><verse number="50" style="v" sid="MRK 14:50"/>Mɔcɛ kishoo angwɛ̃ imesa ha atĩ abɔre unga.<verse eid="MRK 14:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51"/>Uwɛdzɛm nuwɔ, atamu untama ukpekũ na adɔsu Uyesu. Ri ivangyɛ umbɔ aka adzur unga, <verse eid="MRK 14:51"/><verse number="52" style="v" sid="MRK 14:52"/>unga aneke untamanga ra abokmbɔ na atĩ igbĩrhĩ.<verse eid="MRK 14:52"/></para>
  <para style="s1">Uyesu nggu abi udzepurhe</para>
  <para style="r">(<ref loc="MAT 26:57-68">Umat 26.57-68</ref>; <ref loc="LUK 22:54-55">Irh 22.54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Uyoh 18.13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53"/>Akũ Uyesu azĩ ru Ukugɔng Uwuku Udzowe Idɛm-Num, nu ateiya abika adzowe idɛm-Num, nu ikɛi abika amesuwe Ikpem nu akakũ akɔng. <verse eid="MRK 14:53"/><verse number="54" style="v" sid="MRK 14:54"/>Ubitru adɔsa unga, bɔr ukukaa-ukukaa. Atsĩ ru ufɔm iya Ukugɔng Uwuku Udzowe Idɛm-Num. Umɔ unga aka asei iwɛr urha nggu adogerhi ha.<verse eid="MRK 14:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MRK 14:55"/>Ateiya abika adzowe idɛm-Num nu kishoo abi udzepurhe abee ubinkpi uku iwe ideka ri itsi Uyesu, umbɔ afɛre unga, bɔr umbɔ asi ikpombɔ. <verse eid="MRK 14:55"/><verse number="56" style="v" sid="MRK 14:56"/>Anera arhɛrhɛ aka adzowe ideka igbɛrangwĩ, bɔr angwĩmbɔ asi iweke unying.<verse eid="MRK 14:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57"/>Mɔcɛ abɔɔ asok adɛ̃ɛ̃, adzowe ideka igbɛrangwĩ ru unga agɛ, <verse eid="MRK 14:57"/><verse number="58" style="v" sid="MRK 14:58"/>&lt;&lt;Umɛn igũ unga agɔr agɛ, &lt;Umum iwuri isipuwe Iya-Num ikɛrɛ anera aka adzin, ni idzin ikɔɔ ri inuma itaar, ikirikɛ iki isi iwengge idzin unera.&gt; &gt;&gt; <verse eid="MRK 14:58"/><verse number="59" style="v" sid="MRK 14:59"/>Kishoo rimi hã idekambɔ isi iwengge unying.<verse eid="MRK 14:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60"/>Mɔcɛ Ukugɔng Uwuku Udzowe Idɛm-Num asok adɛ̃ɛ̃ ra ateumbɔ, arhusu Uyesu agɛ, &lt;&lt;Ungo usi ídzipungo arherhe? Awu use uwe ri idekayɛ umbɔ aka adzowe ri itsingo?&gt;&gt; <verse eid="MRK 14:60"/><verse number="61" style="v" sid="MRK 14:61"/>Bɔr Uyesu anukutata asi idzipuka, Ukugɔng Uwuku Udzowe Idɛm-Num hã abvui arhusa unga agɛ, &lt;&lt;Awu ungo uwu Ukiristo Ungwɛ̃ Uwu Idorh?&gt;&gt;<verse eid="MRK 14:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62"/>Uyesu agɔr unga agɛ, &lt;&lt;Awu umum. Ikɛi umbi awuri inyãmbi Ungwɛ̃-Ner aka isei nu ubok ugha Uwu Ijee, ikɛi awuri iba nu amɛɛ afafã ra afã.&gt;&gt;<verse eid="MRK 14:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63"/>Ukugɔng Uwuku Udzowe Idɛm-Num hã avapuwe atorhanga, na agɛ, &lt;&lt;Umɛn ibee ideka iyikisong ikɛi? <verse eid="MRK 14:63"/><verse number="64" style="v" sid="MRK 14:64"/>Umbi agũmbi unga aka arhenu Unum! Awu use uwu itsũwãmbi?&gt;&gt;</para>
  <para style="p" vid="MRK 14:64">Anera kishoo arherhe agɛ, &lt;&lt;Agbaa! Afɛre unga!&gt;&gt; <verse eid="MRK 14:64"/><verse number="65" style="v" sid="MRK 14:65"/>Mɔcɛ abɔɔ atirha ashau aci atsuyiwe unga, abope asunga, ikɛi akwɛre unga ugwɛɛ, anu igɔr unga agɛ, &lt;&lt;Udɛyiwa umɛn, ungaa akwɛr ungo!&gt;&gt; Mɔcɛ adogerhi abi udzepurhe ha akũ unga azĩmbɔ na akwɛr unga.<verse eid="MRK 14:65"/></para>
  <para style="s1">Ubitru agɛ Uyesu asi iwea uwu unga</para>
  <para style="r">(<ref loc="MAT 26:69-75">Umat 26.69-75</ref>; <ref loc="LUK 22:56-62">Irh 22.56-62</ref>; <ref loc="JHN 18:15-18">Uyoh 18.15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66"/>Ubitru iganga awu unɔr ufɔm iya ha, unaa uwɔɔ ra anang itser Ukugɔng Uwuku Udzowe Idɛm-Num aba. <verse eid="MRK 14:66"/><verse number="67" style="v" sid="MRK 14:67"/>Unga aka anyã Ubitru aka asei iwɛr urha, unga angwɛ̃dzɛn na arhi unga, na agɛ, &lt;&lt;Ungo uwu nggu Uyesu uner Unazarat ha!&gt;&gt;<verse eid="MRK 14:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68"/>Bɔr Ubitru atsɛyinga agɛ, &lt;&lt;Umum isi ihwɛng ubinkpi ungo uku urherhe.&gt;&gt; Unga aka arherhe rimi amaa, unga asok atsĩ ru udzepurhe iya ha. Kanying ikɔ igbɛr ukpee.<verse eid="MRK 14:68"/></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69"/>Unna hã aka abvui anyã unga umɔ, unga adɛyiwe abirabɛ aka adɛ̃ɛ̃ umɔ agɛ, &lt;&lt;Uwɛrɛ awu nggu umbɔ.&gt;&gt; <verse eid="MRK 14:69"/><verse number="70" style="v" sid="MRK 14:70"/>Ikɛi Ubitru abvui atsɛyinga.</para>
  <para style="p" vid="MRK 14:70">Ivanga ukunjiir iki itɔng, abirabɛ aka adɛ̃ɛ̃ akhapa ru Ubitru agɔr unga agɛ, &lt;&lt;Asi iwea ubin itsɛyi, ungo uwu nggu umbɔ, ungo usi iwea uner Ugarhirhi?&gt;&gt;<verse eid="MRK 14:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71"/>Mɔcɛ Ubitru atirhunga ifuw atsukuka ikponum nu itsinga, ayirh uyirh ra asumbɔ agɛ, &lt;&lt;Umum isi ihwɛng utsakwi umbi aka anu irherhe ri itsinga.&gt;&gt;<verse eid="MRK 14:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72"/>Kanying ikɔ ibvui igbɛr ukpee ide uvaa. Mɔcɛ Ubitru ayita arherhe Uyesu aka adɛyiwe unga agɛ, &lt;&lt;Ungo itsɛyingo ihwɛng umum idiki itaar ri ikɔ idɔrhi igbɛr ukpee idiki ivaa.&gt;&gt; Ngge unga atsĩã iciu akpe.<verse eid="MRK 14:72"/></para>
  <chapter eid="MRK 14"/>
  <chapter number="15" style="c" sid="MRK 15"/>
  <para style="s1">Akũ Uyesu azĩ ru ugomna Ubirhatu</para>
  <para style="r">(<ref loc="MAT 27:1-2">Umat 27.1-2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="LUK 23:1-5">Irh 23.1-5</ref>; <ref loc="JHN 18:28-38">Uyoh 18.28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1"/>Ri igɔ̃kpeeka ateiya abika adzowe idɛm-Num nu akakũ, nu abika amesuwe Ikpem, nu kishoo abi itser udzepurhe akɛki itsũwã. Umbɔ abow Uyesu akũna unga azĩmbɔ ra asu Ubirhatu.<verse eid="MRK 15:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 15:2"/>Ubirhatu arhusa unga agɛ, &lt;&lt;Awu ungo uwu uyɛrhe abi Uyahuda?&gt;&gt;</para>
  <para style="p" vid="MRK 15:2">Uyesu agɔr unga agɛ, &lt;&lt;Ungo uku urherhungo.&gt;&gt;<verse eid="MRK 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3"/>Ateiya abika adzowe idɛm-Num hã, agbɛyi urherhe atsuke unga ra abina arhɛrhɛ. <verse eid="MRK 15:3"/><verse number="4" style="v" sid="MRK 15:4"/>Ngge ikɛi Ubirhatu arhusa unga agɛ, &lt;&lt;Unyã arhɛrha abinmbɔ aka agbɛyi atsuka ungo. Ungo usi ídzipungo arherhe?&gt;&gt;<verse eid="MRK 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5"/>Bɔr Uyesu asi idzipunga arherhe. Ubirhatu adzeidzeu.<verse eid="MRK 15:5"/></para>
  <para style="s1">Atsu ufai akpe ru Uyesu</para>
  <para style="r">(<ref loc="MAT 27:15-26">Umat 27.15-26</ref>; <ref loc="LUK 23:13-25">Irh 23.13-25</ref>; <ref loc="JHN 18:39-19:16">Uyoh 18.39—19.16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6"/>Icɛ awu ugau ugomna aka isaka atsũwe unerwi umbɔ aka abow ru ugborzĩ, uwuruwi anera aki ibee ru unum Irhowa Iyiki Igar Utɔng. <verse eid="MRK 15:6"/><verse number="7" style="v" sid="MRK 15:7"/>Uwɔɔ ruwɔ itsoka igburh Ubaraba, uvau isoyamɛn nu ifɛr uner itsu umbɔ agbange unga ru ugborzĩ hã nggu abɔɔ. <verse eid="MRK 15:7"/><verse number="8" style="v" sid="MRK 15:8"/>Ikikɔnga iba ifɛn Ubirhatu unga akorhuwe ubin unga aka abayi ikikorhe.<verse eid="MRK 15:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 15:9"/>Unga agɔr umbɔ agɛ, &lt;&lt;Umbi abee umum itsũwã Uyɛrha abi Uyahuda ru umbi?&gt;&gt; <verse eid="MRK 15:9"/><verse number="10" style="v" sid="MRK 15:10"/>Unga ahwɛnga agɛ awu unyɛ̃ɛ̃ utsu ateiya abika adzowe idɛm-Num atsuke Uyesu ru uboknga. <verse eid="MRK 15:10"/><verse number="11" style="v" sid="MRK 15:11"/>Bɔr ateiya abika adzowe idɛm-Num atsu anera agɔr agɛ aneke Uyesu ru ugborzĩ, na atsũwe Ubaraba ru umbɔ.<verse eid="MRK 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 15:12"/>Ubirhatu arhusa umbɔ agɛ, &lt;&lt;Umum iwuri ikorhe uguse nggu uwuruwi umbi iki iyisa Uyɛrhe abi Uyahuda?&gt;&gt;<verse eid="MRK 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13"/>Umbɔ atsarhi irhakmbɔ agɛ, &lt;&lt;Anyapuwe unga!&gt;&gt;<verse eid="MRK 15:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14"/>Ubirhatu arhusa umbɔ agɛ, &lt;&lt;Awu use utsu? Ashɔyi use arherhunga?&gt;&gt; Umbɔ agbisha atsarhi irhakmbɔ agɛ, &lt;&lt;Anyapuwe unga!&gt;&gt;<verse eid="MRK 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15"/>Ubirhatu aka abee itsu umbɔ agɔm unga, atsũwũka Ubaraba. Unga aka atsu umbɔ akwɛre ugwɛɛ ru Uyesu amaa, unga adzowuka unga umbɔ anyapuwe.<verse eid="MRK 15:15"/></para>
  <para style="s1">Abi iwa ayɛɛi Uyesu</para>
  <para style="r">(<ref loc="MAT 27:27-31">Umat 27.27-31</ref>; <ref loc="JHN 19:2-3">Uyoh 19.2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16"/>Abi iwa akũ Uyesu azĩ ru udzepurhe ugomna, umbɔ iki iyisa agɛ, &lt;&lt;Upiretoriyum.&gt;&gt; Na akɔng kishoo ukpui abi iwa ha. <verse eid="MRK 15:16"/><verse number="17" style="v" sid="MRK 15:17"/>Atsime atorho aka abãrhã akagɔng aki iyɛrhe nú Uyesu, ikɛi akare ifur iyɛrhe iyi ídidɔk, atsime ni itsinga. <verse eid="MRK 15:17"/><verse number="18" style="v" sid="MRK 15:18"/>Umbɔ atirhi ighwe unga agɛ, &lt;&lt;Urhɛngo uder, Uyɛrha abi Uyahuda!&gt;&gt; <verse eid="MRK 15:18"/><verse number="19" style="v" sid="MRK 15:19"/>Ikɛi anu ikũ igbong akwɛr unga ni itsia, atang aci atsuyiwe ru unga. Na atangarhu agɛ umbɔ anu idzowe unga igɔng. <verse eid="MRK 15:19"/><verse number="20" style="v" sid="MRK 15:20"/>Umbɔ aka ayɛɛia unga rimi amaa, umbɔ atsimuwe atorho aka abãrhã akagɔng hã, na atsime atorhanga. Mɔcɛ umbɔ akũna unga adzek azĩmbɔ inyinyapuwe.<verse eid="MRK 15:20"/></para>
  <para style="s1">Anyapuwe Uyesu</para>
  <para style="r">(<ref loc="MAT 27:32-44">Umat 27.32-44</ref>; <ref loc="LUK 23:26-43">Irh 23.26-43</ref>; <ref loc="JHN 19:17-27">Uyoh 19.17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21"/>Utsa uwɔɔ adzeku Usayirin, itsoknga igburh Usiman utɛmbɔ Uarhekzanda nu Urhufɔ, adzek ri ibang abĩ hã na atɔng ru uteu ha. Umbɔ atsu unga inggang unga atsã igãrhãmau ucucii Uyesu. <verse eid="MRK 15:21"/><verse number="22" style="v" sid="MRK 15:22"/>Akũ Uyesu azĩ ra anangkɛ umbɔ iki iyisa Ugorhgota, agbena agburh, &lt;&lt;Anang Apfupfu Aghow Itsi.&gt;&gt; <verse eid="MRK 15:22"/><verse number="23" style="v" sid="MRK 15:23"/>Mɔcɛ umbɔ adzowe unga amɛ̃ inebi aka asarhe nggu isung, bɔr unga akpɛ̃ɛ̃ ihwihwaa. <verse eid="MRK 15:23"/><verse number="24" style="v" sid="MRK 15:24"/>Mɔcɛ umbɔ anyapuwe unga. Umbɔ agasha atorhanga ra adɔkambɔ, atang isɛng ra atsimbɔ anyã ubinkpi ubɛn unera aka ikpo.<verse eid="MRK 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 15:25"/>Awu ra akara utɔɔrha aki ukpee umbɔ aka inyapuwe unga. <verse eid="MRK 15:25"/><verse number="26" style="v" sid="MRK 15:26"/>Umbɔ atsɛng isarhe iyiki irhena unga agɛ, <char style="sc">&lt;&lt;UYƐRHA ABI UYAHUDA.&gt;&gt;</char> <verse eid="MRK 15:26"/><verse number="27" style="v" sid="MRK 15:27"/>Anyapuwe avɛu avaa nggu unga, unying nu ubok ughanga, uwu uvaa ikɛi nu ubok uferanga.<note caller="+" style="f"><char style="fr" closed="false">15.27 </char><char style="ft" closed="false">Abvur akɔɔ aki itsɛng abok aki isha agɔrke ikɛi ugɛ, </char><char style="fv" closed="false">28 </char><char style="fqa" closed="false">Akɛrɛ ake atsuafɛr itsɛng hã iki igɔr igɛ, &lt;&lt;Avarha unga ra abi avau.&gt;&gt;</char></note><verse eid="MRK 15:27"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29"/>Anera aka atɔng, arhena unga, azung atsimbɔ agɛ, &lt;&lt;Ĩhĩĩ! Ungo iki isipuwe Iya-Num, nu udzine ike ikɛi ri inuma itaar, <verse eid="MRK 15:29"/><verse number="30" style="v" sid="MRK 15:30"/>ucipuwa ru igãrhãmau ucuciia ha ufɔrh itsingo!&gt;&gt;<verse eid="MRK 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31"/>Rimi hã ikɛi ateiya abika adzowe idɛm-Num nu abika amesuwe Ikpem ani iyɛɛia unga ra adɔkambɔ agɛ, &lt;&lt;Afɔrhuka abɔɔ, bɔr asi idɛ̃ɛ̃ afɔrha itsinga! <verse eid="MRK 15:31"/><verse number="32" style="v" sid="MRK 15:32"/>Uneke Ukiristo uwurɛ, uyɛrhe abi Uisrairha, acipuwa icɛrɛ ru igãrhãmau ucuciia uwurɛ, ru umɛn inyã ni iwe ru imangmang!&gt;&gt; Avɛu ha umbɔ aka anyapuwe nggu unga arherhu nggaa urhena atsuke unga.<verse eid="MRK 15:32"/></para>
  <para style="s1">Akpe Uyesu</para>
  <para style="r">(<ref loc="MAT 27:45-56">Umat 27.45-56</ref>; <ref loc="LUK 23:44-49">Irh 23.44-49</ref>; <ref loc="JHN 19:28-30">Uyoh 19.28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33"/>Ri idzingga atenuma, uzĩ itsirkpɔ abĩã kishoo, utsɛku akara ataar aki urhɛɛ. <verse eid="MRK 15:33"/><verse number="34" style="v" sid="MRK 15:34"/>Ra akara ataar, Uyesu atsarhi irhaknga ikerketangge agɛ, &lt;&lt;Erhoi, Erhoi, urhama sabaktani?&gt;&gt; Agbena agburh, &lt;&lt;A Unummum, a Unummum, awu use utsu ungo uneka umum?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">15.34 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="PSA 22:1">Amb 22.1</ref></char>.</note><verse eid="MRK 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35"/>Abika adɛ̃ɛ̃ ukhapa umɔ aka agũ rimi, umbɔ agɛ, &lt;&lt;Àka agũ, unga adɛ̃ɛ̃ iyisu uner uwuku usɔm Arherhu-Num Uirhiya.&gt;&gt;<verse eid="MRK 15:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 15:36"/>Unying ru umbɔ atĩ, azĩ abii usoso ra amɛ̃ inebi akika agbata, avaki igbong, abera adzowe ru Uyesu ahwa. Unga agɛ, &lt;&lt;Àka adidɛ̃ɛ̃! Umɛn inyãni use Uirhiya awuri iba acipuka unga.&gt;&gt;<verse eid="MRK 15:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37"/>Uyesu atsarhi irhaknga ikerketangge, atsu ivum na akpea.<verse eid="MRK 15:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38"/>Urhaburhe ha ukpuku uwe ru Iya-Num uvaar agbɛra avaa udzur afafã uba utsĩ ra abĩ. <verse eid="MRK 15:38"/><verse number="39" style="v" sid="MRK 15:39"/>Ivang unggbaashi abi iwa uwuku udɛ̃ɛ̃ ra asu Uyesu aka anyã ikpũ akpea, umɔ unga agɔr agɛ, &lt;&lt;Icicang ishingge, utsak uwurɛ awu Ungwɛ̃ Unum!&gt;&gt; <figure style="fig" alt="Temple curtain tearing from top to bottom" file="gt00041.tif" size="col" loc="15.39" copy="Gordon Thompson" ref="15.38">Ututaa ukpu Iya-Num uvaar ugbɛra avaa</figure><verse eid="MRK 15:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40"/>Akatsɛrh abɔɔ adɛ̃ɛ̃ ukukaa na azɛrhe. Ru umbɔ ha awu umbɔ Umaryamu Umagadarha, nu Umaryamu uyisa Uyaku ungwɛ̃mbɔ Uyesu uku ucia nu Uyusuf, nu Usarhomi. <verse eid="MRK 15:40"/><verse number="41" style="v" sid="MRK 15:41"/>Umbɔ atirhi idɔsa unga ru Ugarhirhi anu itɔ̃ itser iyike unga. Akatsɛrh abɔɔ ikɛi arhɛrhɛ abika aba nggu unga azĩ Urusharhima awu umɔ.<verse eid="MRK 15:41"/></para>
  <para style="s1">Igwirhuwe Uyesu</para>
  <para style="r">(<ref loc="MAT 27:57-61">Umat 27.57-61</ref>; <ref loc="LUK 23:50-56">Irh 23.50-56</ref>; <ref loc="JHN 19:38-42">Uyoh 19.38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42"/>Urhɛɛ uku uwe, umbɔ adɛ̃ɛ̃mbɔ igbisha abin udãã awu unum ukpuku uwosha. <verse eid="MRK 15:42"/><verse number="43" style="v" sid="MRK 15:43"/>Utsa uwɔɔ agburh Uyusuf uner Uarimatiya, unga awu ra abi itser ru udzepurhe, awea ri itsu amɛn ibiba Iyɛrhe Unum. Aker amɛn azĩ ru Ubirhatu ashɔ̃rhã unga adzowe iyor Uyesu. <verse eid="MRK 15:43"/><verse number="44" style="v" sid="MRK 15:44"/>Ubirhatu adzeidzeu unga aka agũ ugɛ Uyesu aka akpea. Unga ayisu unggbaashi abi iwa ha arhusa use awu idzidzɛrhe Uyesu aka akpe. <verse eid="MRK 15:44"/><verse number="45" style="v" sid="MRK 15:45"/>Unga aka agũ ra angwĩ unggbaashi abi iwa ha, mɔcɛ unga adzowuka ukom iyora ru Uyusuf. <verse eid="MRK 15:45"/><verse number="46" style="v" sid="MRK 15:46"/>Nggee Uyusuf azĩ agoi atorho, acipu iyor Uyesu, akũ atorha ha abow iyor ha, atsuke ngge ru udzakkpi umbɔ aka atsɛ̃ɛ̃ ru utarh. Unga agɔ̃rhũ utarh ukpɔɔ afɔme angwĩ udzak ha. <verse eid="MRK 15:46"/><verse number="47" style="v" sid="MRK 15:47"/>Umaryamu uwuku udzeku Umagadarha nu Umaryamu uyisa Uyusuf adɛ̃ɛ̃ azɛrhe anangkɛ umbɔ aka angwɛ̃we iyor Uyesu.<verse eid="MRK 15:47"/></para>
  <chapter eid="MRK 15"/>
  <chapter number="16" style="c" sid="MRK 16"/>
  <para style="s1">Isisok Uyesu ra akpe</para>
  <para style="r">(<ref loc="MAT 28:1-8">Umat 28.1-8</ref>; <ref loc="LUK 24:1-12">Irh 24.1-12</ref>; <ref loc="JHN 20:1-10">Uyoh 20.1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1"/>Unum ukpuku Uwosha uku utɔng, Umaryamu Umagadarha nu Umaryamu uyisa Uyaku, nu ikɛi Usarhomi, agoi abin isung akirakɛ umbɔ aka izĩ adzukuwe ri iyor Uyesu. <verse eid="MRK 16:1"/><verse number="2" style="v" sid="MRK 16:2"/>Ru unum ukpu inggbaashia ri inuma utɔɔva, ru ukpeeka ri ivangyɛ ishaa unum iki idzek, umbɔ atirhumbɔ izĩ ru udzaka. <verse eid="MRK 16:2"/><verse number="3" style="v" sid="MRK 16:3"/>Umbɔ aka awu ru utsĩndĩ, umbɔ agɔr adɔkambɔ agɛ, &lt;&lt;Ungamɔ awuri igɔ̃rhuwe utarha ra angwĩ udzaka?&gt;&gt;<verse eid="MRK 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 16:4"/>Bɔr umbɔ aka azĩ atsĩ umɔ, umbɔ abera asumbɔ anyã nggaa utarh ha uku ugɔ̃rhũkpɔ. <verse eid="MRK 16:4"/><verse number="5" style="v" sid="MRK 16:5"/>Umbɔ aka atsĩ ru udzaka, umbɔ anyã uwɛdzɛm aka atsim atorho aka aterha asei udiku ubok ugha, umbɔ agũ iwei.<verse eid="MRK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6"/>Ungwɛdzɛm hã agɔr umbɔ agɛ, &lt;&lt;Àka niba agũmbi iwei. Umbi abee Uyesu uner Unazarat uwuruwi umbɔ aka anyapuwe. Aka asoka! Ashia nggimi. Àka anyã anangkɛ umbɔ aka angwɛ̃we unga. <verse eid="MRK 16:6"/><verse number="7" style="v" sid="MRK 16:7"/>Àka azĩ adɛyiwe angwɛ̃ imesanga nu Ubitru, unga agbaashia azĩ Ugarhirhi ru umbi. Nggɔɔ ha umbi aka inyã unga, ru nyaka unga aka asɔma umbi.&gt;&gt;<verse eid="MRK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8"/>Akatsɛrh ha atĩ adzek ru adzak ha, adzunumbɔ na azang ayormbɔ, asi irherhumbɔ arherhe nggu unera, ubinkutsu umbɔ agũ iwei.<verse eid="MRK 16:8"/></para>
  <para style="s2">[Abvur itsɛng abok akɔɔ aki isha ashike ru ubvur Umar 16.9-20]</para>
  <para style="s1">Uyesu adzeka ru Umaryamu</para>
  <para style="r">(<ref loc="MAT 28:9-10">Umat 28.9-10</ref>; <ref loc="JHN 20:11-18">Uyoh 20.11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9"/>Ivangyɛ Uyesu aka asoka akpe ru unkpeka ru unum ukpu inggbaashia ri inuma utɔɔva, agbaashia adzeka ru Umaryamu Umagadarha, utsɛrh ha Uyesu aka atsũwe ípfu iyiki ibewe utɔɔva. <verse eid="MRK 16:9"/><verse number="10" style="v" sid="MRK 16:10"/>Unga azĩ asɔme abirabɛ aka awu nggu Uyesu, umbɔ agũ ighong na aciu akpe. <verse eid="MRK 16:10"/><verse number="11" style="v" sid="MRK 16:11"/>Umbɔ aka agũ ugɛ Uyesu aka asoka nggu urhɛ, ikɛi unga nibikanga anyã Uyesu, umbɔ asi ibemumbɔ.<verse eid="MRK 16:11"/></para>
  <para style="s1">Uyesu adzeka ra angwɛ̃ imesa avaa</para>
  <para style="r">(<ref loc="LUK 24:13-35">Irh 24.13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12"/>Akɛrɛ aka amaa Uyesu adzipa adzeka ru nyaku uner uwɔɔ ra angwɛ̃ imesa abɔɔ avaa ri ivangyɛ umbɔ aka azɛ̃rhã adzek ru uteu ha adɔsu utsĩndĩã azĩmbɔ. <verse eid="MRK 16:12"/><verse number="13" style="v" sid="MRK 16:13"/>Ikivarhambɔ abvui aba asɔme abimbɔ, bɔr utsɛku icɛrɛ umbɔ ashimbɔ ri imangmang ri isarhe ha.<verse eid="MRK 16:13"/></para>
  <para style="s1">Uyesu adzowe angwɛ̃ imesanga itser</para>
  <para style="r">(<ref loc="MAT 28:16-20">Umat 28.16-20</ref>; <ref loc="LUK 24:36-49">Irh 24.36-49</ref>; <ref loc="JHN 20:19-23">Uyoh 20.19-23</ref>; <ref loc="ACT 1:6-8">Aiy 1.6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14"/>Ri imaatak Uyesu aka adzeka ru umbɔ usɔka nu unying hã ri ivangyɛ umbɔ aka asei igha ubingha. Unga atsɛrha umbɔ ri ida imangmangmbɔ, nu iker itsimbɔ, umbɔ aka asi ibemumbɔ arherhe abirabɛ aka agbaashia anyã unga ri isisoknga.<verse eid="MRK 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 16:15"/>Ikɛi unga agɔr umbɔ agɛ, &lt;&lt;Àka atsĩ ru upfunga kishoo adzowe Isarhe Iyiki Ize ra anera kishoo. <verse eid="MRK 16:15"/><verse number="16" style="v" sid="MRK 16:16"/>Ubɛn unera aka awea ri imangmang, umbɔ asorhukumbɔ unga ubɔtisima, awuri ikpikpoa ififɔrh, bɔr ubɛn unera aka akpɛ̃ɛ̃ iwe ru imangmang awuri itsitsĩm. <verse eid="MRK 16:16"/><verse number="17" style="v" sid="MRK 16:17"/>Atsar akɛ aka idɔsa abika awuri imangmang, ri itsokmum, umbɔ awuri itsũwũkumbɔ ípfu iyiki ibewe, awuri irherhumbɔ idũ iyiki ifa. <verse eid="MRK 16:17"/><verse number="18" style="v" sid="MRK 16:18"/>Awuri inyãngumbɔ íbvui ra abokmbɔ, ikɛi umbɔ aba ahwambɔ umau, ake asi íkorhuke ubin ru umbɔ. Umbɔ aba atsorha abokmbɔ ra abi irhãrhã, umbɔ awuri ikerhumbɔ.&gt;&gt;<verse eid="MRK 16:18"/></para>
  <para style="s1">Uyesu afũã ra afã</para>
  <para style="r">(<ref loc="LUK 24:50-53">Irh 24.50-53</ref>; <ref loc="ACT 1:9-11">Aiy 1.9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19"/>Uteijee Uyesu aka amaa irherhuwe umbɔ arherhe ha, ashupa unga akũ afũmbɔ ra afã, unga aseisa nu ubok ugha Unum. <verse eid="MRK 16:19"/><verse number="20" style="v" sid="MRK 16:20"/>Mɔcɛ angwɛ̃ imesanga adzek adzise isarhe ubɛn ananga, Uteijee atɔ̃ itser nggu umbɔ, akorha abin idzeu atsu arherhambɔ awu idzidzɛrhe.<verse eid="MRK 16:20"/></para>
  <chapter eid="MRK 16"/>
</usx>
