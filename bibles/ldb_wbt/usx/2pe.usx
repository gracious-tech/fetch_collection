<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2PE" style="id">- Dũya Translation Project</book>
  <para style="h">2 Ubitru</para>
  <para style="toc1">Ubvur uwu uvaa Ubitru aka atsɛng</para>
  <para style="toc2">2 Ubitru</para>
  <para style="toc3">2Ubi</para>
  <para style="mt2">Ubvur uwu uvaa</para>
  <para style="mt1">Ubitru</para>
  <para style="mt2">aka atsɛng</para>
  <para style="imt">Utsutson ri itsi ubvur uwu uvaa Ubitru aka atsɛng</para>
  <para style="ip">Awu Ubitru uner itser Uyesu atsɛng ubvur uwurɛ. Abɔɔ akaifɛrhkɔ ugɛ atsɛng ubvur uwurɛ ra amɛk aki 65-68 udzur ru unumkpi umbɔ aka amar Uyesu.</para>
  <para style="ip">Ubitru atsɛng ubvur uwurɛ agbiite ato abika adɔsa ri itsi abika amesuwe imesi igbɛrangwĩ nu abin aka abewe ha umbɔ iki ikorhe. Ubitru amesuwe anera ugɛ umbɔ adɛ̃ɛ̃ aker ri iwe ru ihwihwɛng iyi idzidzɛrhe iyi Unum nu iyi Uteijee Uyesu Ukiristo, ihwihwɛng iyiriyɛ iki idzek ra abirabɛ aka agũ na anyã Uyesu nggu asumbɔ. Uner uku utsɛng ubvur uwurɛ awe ru ighongamɛn ikɛi ri imesayɛ abɔɔ aka amesuwe ugɛ Ukiristo asi íbvui abanga. Unga agɔr ugɛ ubin hã uku utsu Ukiristo anasi ibanga, awu Unum &lt;&lt;asi ibeenga unera atsim, bɔr ubɛn unera adzipa.&gt;&gt;</para>
  <para style="iot">Abinkɛ aka awe umɔ</para>
  <para style="io1">Utsutson ri itsi ubvur ha <char style="ior">(<ref loc="2PE 1:1-2">1.1-2</ref>)</char></para>
  <para style="io1">Uyisa nu itser abika adɔsa <char style="ior">(<ref loc="2PE 1:3-21">1.3-21</ref>)</char></para>
  <para style="io1">Abika amesuwe imesi igbɛrangwĩ <char style="ior">(<ref loc="2PE 2:1-22">2.1-22</ref>)</char></para>
  <para style="io1">Ibiba Ukiristo iyi imaataka <char style="ior">(<ref loc="2PE 3:1-18">3.1-18</ref>)</char></para>
  <chapter number="1" style="c" sid="2PE 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2PE 1:1"/>Ubvur uwirɛ udzeku Usiman Ubitru, ugãrhã nu uner itser Uyesu Ukiristo, uzĩ ra abika ayɛi imangmang ru nyaka umɛn ru ubok irhirhika Uyesu Ukiristo Unum uwuku ufɔrh umɛn.<verse eid="2PE 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2PE 1:2"/>Umata nu ididɔɔr irhɛirhɛ ima iwe nggu umbi ri ihwihwɛng Unum nu Uyesu Uteijeemɛn.<verse eid="2PE 1:2"/></para>
  <para style="s1">Useng ri imangmang</para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 1:3"/>Nggu nggaa ijee Unum aka adzaa umɛn ubɛn ubin umɛn iki ibee ri ibibɛkmɛn iyi iwei Unum. Umɛn iyɛi akɛrɛ kishoo ri ihwihwɛngnga, unga aka ayisa umɛn izĩ ru unga ru ubok ikpikpoinga nu iyiki izenga. <verse eid="2PE 1:3"/><verse number="4" style="v" sid="2PE 1:4"/>Ra akɛrɛ ha unga aka adzaanga nggaa uzeze ibibemuwenga, ngge itsú ru ubokngge umbi adɛ̃ɛ̃ awe ru nyaka unga, na ashɔɔte umbi ri ididakuwe iyi ikpona iyiki ibewe iki ikũ iba ru upfung.<verse eid="2PE 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2PE 1:5"/>Nggee, àka atsu amɛnmbi atoma ri imangmang atɔ̃ itser iyiki ize, itser iyiki izembi aka atoma nggu ihwihwɛng, <verse eid="2PE 1:5"/><verse number="6" style="v" sid="2PE 1:6"/>nu ihwihwɛng aka atomi ikpɔm atsi, ri ikpɔm atsi aka atomu ibibima, ri ibibima aka atoma iwei Unum. <verse eid="2PE 1:6"/><verse number="7" style="v" sid="2PE 1:7"/>Ri iwei Unum, aka atomu inna nggu adɔka, ri inna nggu adɔka aka atomu ibibema.<verse eid="2PE 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 1:8"/>Umbi aba awembi ri ikpũ amɛn akɛrɛ ha irhɛirhɛ, ihwihwɛng Uteijeemɛn Uyesu Ukiristo iwuri itsu umbi ashimbi ri ighɛrha nu ida ighwighwɛr. <verse eid="2PE 1:8"/><verse number="9" style="v" sid="2PE 1:9"/>Bɔr ubɛn unera aka asi ikpoa ikpũ amɛn akɛrɛ ha, asi ikpang anyãã, awu uner ibvuta, na ayiruka ugɛ umbɔ aka asare unga ra arhimnga aka agbe.<verse eid="2PE 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 1:10"/>Nggee, umbi aze angwɛ̃mɛn nu anapumɛn, awu ufang umbi akorhe ubɛn ubinkpi uku idɛyiwe ugɛ idzidzɛrhe Unum unga ayisa umbi na asɛng umbi. Umbi aba akorhumbi akɛrɛ ha umbi asi ígbambi igba. <verse eid="2PE 1:10"/><verse number="11" style="v" sid="2PE 1:11"/>Nu umbi awuri iyɛimbi nggaa udɔrhi ri itsĩ Iyɛrhe iyi ugbagbaa iyi Uteijeemɛn Uyesu Ukiristo uwuku ufɔrh umɛn.<verse eid="2PE 1:11"/></para>
  <para style="s1">Ikpeto ra Arherhu-Num</para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 1:12"/>Nggee ubɛn ivang umum iwuri iyituwa umbi abin akɛrɛ, umum ihwɛng umbi ahwɛngmbi ake. Umbi aka atar aseimbi icɛrɛ ra arherhe idzidzɛrhekɛ umbi aka awe. <verse eid="2PE 1:12"/><verse number="13" style="v" sid="2PE 1:13"/>Umum inyã irhikungge umum iyituwa umbi ubɛn ivang utsɛku umum iki ineke iyor iyɛrɛ, <verse eid="2PE 1:13"/><verse number="14" style="v" sid="2PE 1:14"/>ubinkutsu, umum ihwɛng isi índãrhũmum ni itsuke ngge ri ibanga, ru nyaka Uteijeemɛn Uyesu Ukiristo aka adɛyiwa umum. <verse eid="2PE 1:14"/><verse number="15" style="v" sid="2PE 1:15"/>Nggee, ubɛn ubinkpi umum iki ikorhe, umum iwuri imina asumum ni ikorhe, ngge itsú umbi ayitu ake ri ivangyɛ umum iki ibɔre upfung ukpirɛ.<verse eid="2PE 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 1:16"/>Ubinkutsu, umɛn isi ĩdɔsumɛn atsĩndĩ atsutson itsoi aka atãrhã ivangyɛ umɛn iki isɔma umbi ijee nu ibiba Uteijeemɛn Uyesu Ukiristo, bɔr umɛn inyãmɛn ikpikpoinga ra asumɛn. <verse eid="2PE 1:16"/><verse number="17" style="v" sid="2PE 1:17"/>Ivangyɛ unga aka ayɛi ikpikpoi nu imor idzeku Unum Utɛ ra anang hã, umɛn ĩgũmɛn irhak iki idzeku unga uner ikpikpoi igɔr igɛ, &lt;&lt;Uwɛrɛ awu Ungwɛ̃mum, uwuruwi umum iki ibema. Amɛnmum agũibɛn unga akarhãrhã.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">1.17 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="MAT 17:5">Umat 17.5</ref>; <ref loc="MRK 9:7">Umar 9.7</ref>; <ref loc="LUK 9:35">Irh 9.35</ref></char>.</note> <verse eid="2PE 1:17"/><verse number="18" style="v" sid="2PE 1:18"/>Umɛn ĩgũmɛn irhak ha iki idzeka afã ri ivang hã umɛn iki iwu nggu unga ni itsi usarkasar igũ hã.<verse eid="2PE 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2PE 1:19"/>Akɛrɛ kishoo atsu umɛn itoma iwe ru ikeramɛn ra arherhe abika asɔm Arherhu-Num aka arherhe awu idzidzɛrhe. Imɛ̃ngge umbi akpeto ra arherha ha aka awe ru nyaki irhirhang iki irhange anang uzĩ, utsɛku ukpee iki isar nu idzɛɛr ukpee idɛ̃ɛ̃ ra amɛnmbi. <verse eid="2PE 1:19"/><verse number="20" style="v" sid="2PE 1:20"/>Ri kishoo, awu ufang umbi ahwɛng ugɛ abika asɔm Arherhu-Num hã umbɔ aka atsɛng ra abvur ha, asi isɔmmbɔ ake ri itsoimbɔ. <verse eid="2PE 1:20"/><verse number="21" style="v" sid="2PE 1:21"/>Ubinkutsu, isɔm Arherhu-Num asi ibake ri ibibee unera, bɔr Ipfu Isarsatangge ngge itsĩ ra amɛn anera ngge itsu umbɔ asɔm Arherhu-Num.<verse eid="2PE 1:21"/></para>
  <chapter eid="2PE 1"/>
  <chapter number="2" style="c" sid="2PE 2"/>
  <para style="s1">Abi imesa igbɛrangwĩ nu itsitsimmbɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 2:1"/>Bɔr abika asɔm Arherhu-Num igbɛrangwĩ ikɛi awembɔ ra anera, ru nyaka abi imesi igbɛrangwĩ aka idzeka ru umbi. Umbɔ awuri ighɔ̃rhã akũwã umbi imesa iyɔɔ ri iwɔk iyiki itsitsim, uko umbɔ atsɛyimbɔ ihwɛng Uteijee uwuku ugoi umbɔ. Ikorhe rimi hã iwuri iyar umbɔ ikũ izĩ itsitsime. <verse eid="2PE 2:1"/><verse number="2" style="v" sid="2PE 2:2"/>Anera arhɛrhɛ aka idɔsa atsĩndĩ atsakmbɔ. Atsu abɔɔ akwɛɛte utsĩndĩ idzidzɛrhe. <verse eid="2PE 2:2"/><verse number="3" style="v" sid="2PE 2:3"/>Ri ikponambɔ abi imesa ha awuri ikũ arherhe igbɛrangwĩ ha umbɔ aka akorhe akũ akpo ubin ru umbi. Ufaimbɔ uku udãrhũkpɔ uku uyurhi ra atsimbɔ nu itsitsimmbɔ iwuri iba ifetem.<verse eid="2PE 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2PE 2:4"/>Ubinkutsu, Unum asi inekuka arhim ípfu itser-Num ivangyɛ ngge iki igba, bɔr atsukuka ngge ru ughwee urha ru uzĩ, utsɛku unum uku utsu uvau. <verse eid="2PE 2:4"/><verse number="5" style="v" sid="2PE 2:5"/>Unga asi inekuka arhim abi upfung ukpu isha, ivangyɛ unga aka akũ inai atsime anera ru upfung aka asi idɔsumbɔ Unum. Bɔr aganuwe Unuhu ukpekũ uner isarhe irhirhika, nu inera utɔɔva abɔɔ. <verse eid="2PE 2:5"/><verse number="6" style="v" sid="2PE 2:6"/>Unga atsĩmka nggaa iteu Usɔdɔm nu Ugomora akpĩĩwe ukpɔ uwe atɔɔ, na atsu umbɔ awe ru nyaka abinkɛ aka ikorhe ra abirabɛ aka asi idɔsumbɔ Unum. <verse eid="2PE 2:6"/><verse number="7" style="v" sid="2PE 2:7"/>Unga afɔrhuka Urhutu, uner uwuku urhurhika ha, aka agũ ighong akarhãrhã ri itser itoma-dak aner Usɔdɔm abirabɛ aka asi idɔsumbɔ ikpem. <verse eid="2PE 2:7"/><verse number="8" style="v" sid="2PE 2:8"/>Ubinkutsu uner uwuku urhurhika ha aka asei ra ateumbɔ ubɛn unuma, amɛn irhirhikanga aghong akarhãrhã unga aka anyã na agũ ida idɔsi ikpemmbɔ. <verse eid="2PE 2:8"/><verse number="9" style="v" sid="2PE 2:9"/>Akɛrɛ ha aba awe rimi, mɔcɛ Uteijee ahwɛnga udĩkpi unga aka ishɔɔte abika arhurhika abi Unum ri iviviri na ahwɛnga udĩkpi unga aka itsu ufai ra abi amɛn aka abewe utsɛku unum ukpuku uvarha arherhe. <verse eid="2PE 2:9"/><verse number="10" style="v" sid="2PE 2:10"/>Akɛrɛ awu undzumu idzidzɛrhe ri itsi abika adɔsi ikpona amɛn aki arhim na arheni iyɛrhe.</para>
  <para style="p" vid="2PE 2:10">Abɛrɛ abika amesuwe igbɛrangwĩ hã ashimbɔ ra atsak! Atsã itsi. Umbɔ asi igũmbɔ iwei umbɔ iki irhena abi ikpikpoi. <verse eid="2PE 2:10"/><verse number="11" style="v" sid="2PE 2:11"/>Uko ípfu itser-Num iki iwe ikerketangge ni iwe ru ijee akarhãrhã, isi irhenungge urhena ra abi ikpikpoi ra asu Uteijee. <verse eid="2PE 2:11"/><verse number="12" style="v" sid="2PE 2:12"/>Bɔr aner abɛrɛ arhena abinkɛ umbɔ aka asi ihwɛngmbɔ. Awe ru nyaka íjuɛ arhum iki ishingge ri ifɛrhkɔ. Amar ngge ukpekũ umbɔ adzui na atsĩme ngge. Rimi hã awuri itsĩme umbɔ ru nyaka íjuɛ arhum.<verse eid="2PE 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2PE 2:13"/>Awuri idzowe ugbɛtambɔ ukpu ayetnum, ri itsi ayetnumkɛ umbɔ aka adzowe abɔɔ. Anyanga ugɛ awu abin aka aze, umbɔ niba ikorhe iki ibewembɔ ra atenum. Isiseimbɔ ru umbi iwu ubin ishĩ. Agha na ahwa nggu umbi na akorha abin ibemi atsimbɔ aka abee ra asumbi. <verse eid="2PE 2:13"/><verse number="14" style="v" sid="2PE 2:14"/>Nggu asu aki itoma-dak, umbɔ asi inekukumbɔ ikorha arhim, umbɔ arhɛm abika asheri iker ri imangmang, awu abika ahwɛng atsĩndĩ ikpona, ikpũmbɔ asei ri ikponum. <verse eid="2PE 2:14"/><verse number="15" style="v" sid="2PE 2:15"/>Umbɔ aka abɔrukumbɔ utsĩndĩ idzidzɛrhe, adɔsu utsĩndĩ Ubarha'am ungwɛ̃ Ubeyor, uwuku ubemu itosa iki ibewe. <verse eid="2PE 2:15"/><verse number="16" style="v" sid="2PE 2:16"/>Bɔr uzhika atsɛrha unga ri iyiki ibewanga utsɛku uzhika uku urherha, ijuɛ irherha arherhe nggu unera ru urhɛm uner, itsu amɛn uwuku usɔm Arherhu-Num hã aneke izhɔ̃ma.<verse eid="2PE 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 2:17"/>Abi ha awu ru nyaka akwiukɛ aka ashike ra amɛ̃ na awu ru nyaki iburyɛ ugba iki ikɛn. Aka agbishukumbɔ anang iseimbɔ ru uzĩ ukpuku ufĩrhã. <verse eid="2PE 2:17"/><verse number="18" style="v" sid="2PE 2:18"/>Ubinkutsu aner abɛrɛ, ru ugbugbuwa uku atãrhã umbɔ iki idɛyiwe iberi itsimbɔ, umbɔ abee ikũ ikpũ amɛnmbɔ akika atãrhã aki ikponi iyor igbiir abirabɛ aka anasi idãrhũmbɔ ri ishishɔɔr ra abika abubɛk ra amɛn arhim. <verse eid="2PE 2:18"/><verse number="19" style="v" sid="2PE 2:19"/>Umbɔ abemuwe umbɔ ififɔn, bɔr umbɔ abɛ awu agãrhã ri ikorhe iyiki itãrhã. Unera awu ugãrhã ra arhim nu iki itãrhã iki idzur amɛnnga. Ubinkutsu umbi awu agãrhã ru ubɛn ubin uku udarh umbi. <verse eid="2PE 2:19"/><verse number="20" style="v" sid="2PE 2:20"/>Umbɔ aba ashɔɔrmbɔ ri itser iki itãrhã iyi upfung ri ihwɛng Uteijee Uyesu Ukiristo Uwuku Ufɔrh umɛn, bɔr adzeka ri itser aner abika adakuwe upfung ukpirɛ, unga abvui ikɛi atsĩã ra abin aka abewe ha, utsɛku ake aka ahwawe itsinga, idzidzɛrhe uner ha asei iseinga iyi inggbaashia izengge iyi imaataka. <verse eid="2PE 2:20"/><verse number="21" style="v" sid="2PE 2:21"/>Azea anera abɛrɛ aba asi ihwɛngmbɔ utsĩndĩ uwuku urhurhika ri inggbaashia, nu umbɔ aka ihwɛng utsĩndĩ hã na abvui azĩ ra andzing anekukumbɔ idɔsa asarkasar arherhe ha umbɔ aka adzowe umbɔ. <verse eid="2PE 2:21"/><verse number="22" style="v" sid="2PE 2:22"/>Ru umbɔ nyaka arherhe ha iwu idzidzɛrhe, ugɛ, &lt;&lt;Ijui igoi ugoi ni ibvui irhɛne ugoi ha.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">2.22 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="PRO 26:11">Uny 26.11</ref></char>.</note> Nu aki umbɔ iki igɔr agɛ, &lt;&lt;Arhede umbɔ aka asorhuwe iyorke abvui atsĩ ru ughɛ̃ɛ̃.&gt;&gt;<verse eid="2PE 2:22"/></para>
  <chapter eid="2PE 2"/>
  <chapter number="3" style="c" sid="2PE 3"/>
  <para style="s1">Unum ukpu Uteijee ukpɔ ubarɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 3:1"/>Ubvurmum uwu uvaa uwi, uba ru umbi aze awɛrhamum. Ra abvur ha ikivarhake umum itsɛng iyituwa umbi abinkɛ umbi aka ikaifɛrhkɔ idzidzɛrhe. <verse eid="2PE 3:1"/><verse number="2" style="v" sid="2PE 3:2"/>Umum ibee umbi ayitu irhɛm asarkasar abika asɔm Arherhu-Num abi isha aka arherhe ra arherhu Uteijee Uwuku Ufufɔrh aka atsuka ra angwĩ abi itser Uyesu.<verse eid="2PE 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 3:3"/>Undzumu ubinkpi umum iki ibee iyituwa umbi ĩgɛ ri imimasha upfung anera abika ayɛɛi idzidzɛrhe awuri idzeka, awuri idɔsi ikponi iyiki ibewambɔ. <verse eid="2PE 3:3"/><verse number="4" style="v" sid="2PE 3:4"/>Umbɔ awuri igɔr agɛ, &lt;&lt;Ibiba ha iwuri iwu ukang, Uyesu aka abemuwa? Uko rimɔ̃ɔ̃ atokamɛn aka akpembɔ, bɔr abina awu ru nyaka ake aka awe asi ifaruke udzur ri inggbaashia umbɔ aka amunu upfung.&gt;&gt; <verse eid="2PE 3:4"/><verse number="5" style="v" sid="2PE 3:5"/>Bɔr umbɔ adzum ayiruwe ugɛ isha rimɔ̃ɔ̃ awu ri irhɛm Unum aka akũ amuna afã nu abĩ ake adzek ra amɛ̃ na adziirte ake nggu amɛ̃. <verse eid="2PE 3:5"/><verse number="6" style="v" sid="2PE 3:6"/>Mɔcɛ akũ amɛ̃ akɛrɛ ha ikɛi adɛke na atsĩme upfung hã nggu nggaa inai. <verse eid="2PE 3:6"/><verse number="7" style="v" sid="2PE 3:7"/>Awe ri irhɛm hã afã nu abĩkɛ umɛn iki inyã icɛrɛ aka adɛ̃ɛ̃ idzɛu urha, ru unum ukpuku utsu uvau umbɔ aka itsĩme abika asheri iwei Unum.<verse eid="2PE 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 3:8"/>Bɔr ubina unying àka niba ayirukumbi, aze awɛrhamum, nggu Uteijee unuma unying uwe ru nyaki imɛka unaku ugɔnga, nu imɛka unaku ugɔnga iwe ru nyaku unuma unying. <verse eid="2PE 3:8"/><verse number="9" style="v" sid="2PE 3:9"/>Uteijee asi idɔ̃rhũnga ri itsuifɛr ubinkpi unga aka abemuwe, ru nyaka abɔɔ aka akaifɛrhkɔ. Unga adɔngamɛn nggu umbi, asi ibeenga unera atsim, bɔr ubɛn unera adzipa.<verse eid="2PE 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 3:10"/>Bɔr unum ukpu Uteijee uwuri iba ru nyaku uvɛu. Afã awuri igwirke ru nggaa ubvun, abin afã nggu abĩ awuri ikpikpĩĩ atsim, nu abĩ nu ubɛn ubin uku uwe ru ake awuri igwigwir.<verse eid="2PE 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2PE 3:11"/>Ngge iki iwe ugɛ ubɛn abinkɛ aka adziira umɛn awuri itsĩme riminɛ, imɛ̃ngge umbi anera awu agusembi? Imɛ̃ngge umbi asei asasar ri ibibɛk iwei Unum. <verse eid="2PE 3:11"/><verse number="12" style="v" sid="2PE 3:12"/>Umbi àka isei na afosi ibiba unum ukpu Unum na abee ukpɔ uba ifetem. Unum hã afã awuri ikpĩĩ ru urha, na abin afã nu abĩ awuri ititɛ̃ɛ̃ ri imani urha. <verse eid="2PE 3:12"/><verse number="13" style="v" sid="2PE 3:13"/>Bɔr ri idɔsi ibibemuwenga, umɛn ifosa afã aka afa nu abĩ aka afa, anangkɛ irhirhika iki iwe umɔ.<verse eid="2PE 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2PE 3:14"/>Nggee, aze awɛrhamum, àka adzɛu akɛrɛ ha, àka atsu asumbi na asei iseimbi ra asu Unum iyiki isheru uvau, àka adɔɔr nggu unga. <verse eid="2PE 3:14"/><verse number="15" style="v" sid="2PE 3:15"/>Àka ayita ra amɛnmbi ugɛ idɔngamɛn Uteijee ri ibiba ugɛ ra anera akpo ififɔrh. Ru nyaku uze ungwɛ̃mɛn Uburhu aka atsɛnga umbi ri itsoiyɛ Unum aka adzowe unga. <verse eid="2PE 3:15"/><verse number="16" style="v" sid="2PE 3:16"/>Atsɛng ikpũ arherhe unying ra abvurnga kishoo. Abvurnga hã awe ra abina akɔɔ aka aghong ihwihwɛng, abika asheri ihwihwɛng ashimbɔ ri imangmang iyiki iker, umbɔ iki idzipuwe agbenke ru nyaka umbɔ aki idzipuwe abvur Arherhu-Num akɔɔ, rimi hã ikowe umbɔ itsitsim.<verse eid="2PE 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 3:17"/>Nggee, aze awɛrhamum, ngge iki iwe ugɛ umbi aka ahwɛngmbi akɛrɛ ha, àka angwɛ̃dzɛn nggu ikpũ anerabɛ aka abɔrukumbɔ idɔsu Unum, utsur imesambɔ iyi igbɛrangwĩ idarhngge amɛnmbi, itsu umbi agbambi igba ri ididɛ̃ɛ̃mbi. <verse eid="2PE 3:17"/><verse number="18" style="v" sid="2PE 3:18"/>Bɔr àka aseng ri imimutu nu ihwihwɛng Uteijeemɛn Uyesu Ukiristo uwuku ufɔrh umɛn. Ikpikpoi iwu iyi unga icɛrɛ nu ugbagbaa. Iwerimi.<verse eid="2PE 3:18"/></para>
  <chapter eid="2PE 3"/>
</usx>
