<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Dũya Translation Project</book>
  <para style="h">Umatta</para>
  <para style="toc1">Isarhe Iyiki Ize iyi Umatta aka atsɛng</para>
  <para style="toc2">Umatta</para>
  <para style="toc3">Umat</para>
  <para style="mt2">Isarhe Iyiki Ize iyi</para>
  <para style="mt1">Umatta</para>
  <para style="mt2">aka atsɛng</para>
  <para style="imt">Utsutson ri itsi ubvur Umatta</para>
  <para style="ip">Awu Umatta atsɛng ubvur uwurɛ. Unga awu utsa Uyahuda, unying ra angwɛ̃ imesu Uyesu.</para>
  <para style="ip">Ubvur uwurɛ udɛyiwe ugɛ Uyesu unga awu Ukiristo ha umbɔ aka abemuwa ru ibibemuwe-Num iyiki igbe, unga awu unerwi abi Uyahuda aka atsu amɛnmbɔ ugɛ ibanga. Idikinga irhɛirhɛ ubvur uwurɛ uku uyisu Uyesu ugɛ, &lt;&lt;Ungwɛ̃ Udauda&gt;&gt;. Nu ngge iki iwe ugɛ Isarhe Iyiki Ize ha isi ikpongge iyiyɛi akarhãrhã ra abi Uyahuda, rimi hã icicang ishingge Isarhe Iyiki Ize iyi Uyesu Ukiristo iwu iyi anera kishoo ru upfunga, ra abi Uyahuda nu abirabɛ aka asi iwembɔ abi Uyahuda.</para>
  <para style="ip">Ru ubvur Umatta, atsɛng imesu Uyesu ra agbɛr akagɔng atɔ̃ɔ̃. Aki inggbaashia awu imesu Uyesu ni itsi igũ, iyiriyɛ iki idɛyiwe ikpũ isisei ha abika adɔsa aka isei ri ibibɛkmbɔ (arherhe aki <char style="xt"><ref loc="MAT 5-7">5—7</ref></char>). Ikɛi imesa iyɔɔ iwengge ri itsi itseryɛ uner itser Uyesu iki imɛ̃ɛ̃ unga akorhe (arherhe aki 10). Ikɛi atsɛngmbɔ nyaka arherhe urhɛrhɛ ri itsi iyɛrha afã (arherhe aki 13). Nu imesa ri itsi amɛnkɛ aka amɛ̃ɛ̃ uner uku udɔsa awerake nu ikpũ ifɛrhɛ ha iki imɛ̃ɛ̃ unga akorhe (arherhe aki 18). Ra arherhe aki imaataka, Umatta adɛyiwe nggaa itseryɛ Uyesu aka adzowe abika adɔsa, ngge iwu itser iyiki idzowe Isarhe Iyiki Ize.</para>
  <para style="iot">Abinkɛ aka awe umɔ</para>
  <para style="io1">Atoku Uyesu nu imarnga <char style="ior">(<ref loc="MAT 1:1-2:23">1.1—2.23</ref>)</char></para>
  <para style="io1">Udũwã Uyohana Uner Ubɔtisima <char style="ior">(<ref loc="MAT 3:1-12">3.1-12</ref>)</char></para>
  <para style="io1">Isorhu ubɔtisima Uyesu nu iviviranga <char style="ior">(<ref loc="MAT 3:13-4:11">3.13—4.11</ref>)</char></para>
  <para style="io1">Itser Uyesu ru Ugarhirhi <char style="ior">(<ref loc="MAT 4:12-18:35">4.12—18.35</ref>)</char></para>
  <para style="io1">Izizĩ Uyesu ru Urusharhima <char style="ior">(<ref loc="MAT 19:1-20:34">19.1—20.34</ref>)</char></para>
  <para style="io1">Usati Uyesu ukpu imaatak ru Urusharhima <char style="ior">(<ref loc="MAT 21:1-27:31">21.1—27.31</ref>)</char></para>
  <para style="io1">Inyinyapuwe Uyesu nu akpenga <char style="ior">(<ref loc="MAT 27:32-66">27.32-66</ref>)</char></para>
  <para style="io1">Isisok Uyesu nu idzidzekanga <char style="ior">(<ref loc="MAT 28:1-20">28.1-20</ref>)</char></para>
  <chapter number="1" style="c" sid="MAT 1"/>
  <para style="s1">Ubvur atoku Uyesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1"/>Ubvur unang Uyesu Ukiristo, ungwɛ̃ Udauda uwuruwi aka awu ungwɛ̃ Uibrahim.<verse eid="MAT 1:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="MAT 1:2"/>Uibrahim unga awu utɛ Uishaku,</para>
  <para style="li1" vid="MAT 1:2">Uishaku unga awu utɛ Uyakubu,</para>
  <para style="li1" vid="MAT 1:2">Uyakubu unga awu utɛ Uyahuda nu angwɛ̃mbɔ,<verse eid="MAT 1:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="MAT 1:3"/>Uyahuda unga awu utɛ Ufereza nu Uzera, uyisumbɔ aka awu Utamar,</para>
  <para style="m" vid="MAT 1:3">Ufereza unga awu utɛ Uhezuron,</para>
  <para style="li1" vid="MAT 1:3">Uhezuron unga awu utɛ Uaram,<verse eid="MAT 1:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="MAT 1:4"/>Uaram unga awu utɛ Uamminadab,</para>
  <para style="li1" vid="MAT 1:4">Uamminadab unga awu utɛ Unashon</para>
  <para style="li1" vid="MAT 1:4">Unashon unga awu utɛ Usarhmon,<verse eid="MAT 1:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="MAT 1:5"/>Usarhmon unga awu utɛ Ubo'aza. Urahab unga amar Ubo'aza,</para>
  <para style="li1" vid="MAT 1:5">Ubo'aza unga awu utɛ Uobida. Urut unga amar Uobida,</para>
  <para style="li1" vid="MAT 1:5">Uobida unga awu utɛ Ujesse,<verse eid="MAT 1:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="MAT 1:6"/>Ujesse unga awu utɛ Uyɛrhe Udauda.</para>
  <para style="p" vid="MAT 1:6">Udauda unga awu utɛ Usorhomon. Utsɛrha Uriya unga amar Usorhomon,<verse eid="MAT 1:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="MAT 1:7"/>Usorhomon unga awu utɛ Urhehobowam,</para>
  <para style="li1" vid="MAT 1:7">Urhehobowam unga awu utɛ Uabijah,</para>
  <para style="li1" vid="MAT 1:7">Uabijah unga awu utɛ Uasa,<verse eid="MAT 1:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="MAT 1:8"/>Uasa unga awu utɛ Uyehoshafat,</para>
  <para style="li1" vid="MAT 1:8">Uyehoshafat unga awu utɛ Uyoram,</para>
  <para style="li1" vid="MAT 1:8">Uyoram unga awu utɛ Uazariya,<verse eid="MAT 1:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="MAT 1:9"/>Uazariya unga awu utɛ Uyotam,</para>
  <para style="li1" vid="MAT 1:9">Uyotam unga awu utɛ Uahaz,</para>
  <para style="li1" vid="MAT 1:9">Uahaz unga awu utɛ Uhezekiya,<verse eid="MAT 1:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="MAT 1:10"/>Uhezekiya unga awu utɛ Umanasse,</para>
  <para style="li1" vid="MAT 1:10">Umanasse unga awu utɛ Uaman,</para>
  <para style="li1" vid="MAT 1:10">Uaman unga awu utɛ Uyosiya,<verse eid="MAT 1:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="MAT 1:11"/>Uyosiya unga awu utɛ Uyekoniya nu angwɛ̃mbɔ ri ivangyɛ umbɔ aka akarha umbɔ azĩ abĩ akase ru Ubabirha.<verse eid="MAT 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12"/>Umbɔ aka akarha umbɔ azĩ atsĩ abĩ akase ru Ubabirha,</para>
  <para style="li1" vid="MAT 1:12">Uyekoniya unga awu utɛ Usheyarhtiyerh,</para>
  <para style="li1" vid="MAT 1:12">Usheyarhtiyerh unga awu utɛ Uzerubaberh,<verse eid="MAT 1:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="MAT 1:13"/>Uzerubaberh unga awu utɛ Uabihudu,</para>
  <para style="li1" vid="MAT 1:13">Uabihudu unga awu utɛ Uerhiyakim,</para>
  <para style="li1" vid="MAT 1:13">Uerhiyakim unga awu utɛ Uazor,<verse eid="MAT 1:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="MAT 1:14"/>Uazor unga awu utɛ Uzadak,</para>
  <para style="li1" vid="MAT 1:14">Uzadak unga awu utɛ Uakim,</para>
  <para style="li1" vid="MAT 1:14">Uakim unga awu utɛ Uarhiyud,<verse eid="MAT 1:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="MAT 1:15"/>Uarhiyud unga awu utɛ Uerhiyeza,</para>
  <para style="li1" vid="MAT 1:15">Uerhiyeza unga awu utɛ Umatana,</para>
  <para style="li1" vid="MAT 1:15">Umatana unga awu utɛ Uyakubu,<verse eid="MAT 1:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="MAT 1:16"/>Uyakubu unga awu utɛ Uyusuf utsaka Umaryamu, uya Uyesu, umbɔ aki iyisa Ukiristo.<verse eid="MAT 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17"/>Kishoo andanna udzur ri Uibrahim uba utsĩ Udauda awu usɔka na anaa. Udzur nu Udauda uba utsĩ ri ivangyɛ umbɔ aka akarha abi Uisrairha azĩ abĩ akase ru Ubabirha, andanna awu usɔka na anaa. Udzur umɔ uba utsĩ Ukiristo, andanna awu usɔka na anaa.<verse eid="MAT 1:17"/></para>
  <para style="s1">Imar Uyesu Ukiristo</para>
  <para style="r">(<ref loc="LUK 2:1-7">Irh 2.1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18"/>Imar Uyesu Ukiristo iwe riminɛ. Uyanga Umaryamu awu ukarh Uyusuf. Umbɔ anasi ipfunumbɔ, nu umbɔ anyã unga awu ra anaa ru ubok Ipfu Isarsatangge. <verse eid="MAT 1:18"/><verse number="19" style="v" sid="MAT 1:19"/>Ukarhnga Uyusuf arhiku uner asi ibeenga idzowe unga atsa ra asu anera, unga akaifɛrhkɔ iyiki ibɔre unga ri iwɔk.<verse eid="MAT 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20"/>Bɔr unga ana akaifɛrhkɔ akɛrɛ ha na arheyirhɔ anyã ipfu itser Uteijee kapɛɛng ru unga ni igɔr unga igɛ, &lt;&lt;A Uyusuf ungwɛ̃ Udauda, niba ugũo iwei iyɛi Umaryamu unga awu utsɛ̃ngo, ubinkutsu anaa hã unga aka akɔ̃ adzeki Ipfu Isarsatangge. <verse eid="MAT 1:20"/><verse number="21" style="v" sid="MAT 1:21"/>Awuri imar ungwɛ̃ nu ungo utare itsoknga igburh Uyesu, ubinkutsu unga awuri ifɔrh anernga ra arhimmbɔ.&gt;&gt;<verse eid="MAT 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22"/>Kishoo akɛrɛ ha akorhe rimi ngge itsuifɛr ubinkpi Uteijee aka arherhe ra angwĩ uwuku usɔm Arherhu-Num agɛ, <verse eid="MAT 1:22"/><verse number="23" style="v" sid="MAT 1:23"/>&lt;&lt;Unakugbĩrhĩ awuri ikɔ̃ anaa na amar ungwɛ̃ umbɔ ayisi itsoknga Uimmanuwerh,&gt;&gt; agbena agburh &lt;&lt;Unum awu nggu umɛn.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">1.23 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="ISA 7:14">Uish 7.14</ref></char>.</note><verse eid="MAT 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24"/>Ivangyɛ Uyusuf aka azir ru urhɔ, unga adɔsa arherhe ha ipfu itser Uteijee iki irherhe na ayɛi Umaryamu unga awea utsɛ̃nga. <verse eid="MAT 1:24"/><verse number="25" style="v" sid="MAT 1:25"/>Bɔr asi irhaa nggu unga utsɛku unga aka amar ungwɛ̃nga. Uyusuf atare itsoknga igburh Uyesu.<verse eid="MAT 1:25"/></para>
  <chapter eid="MAT 1"/>
  <chapter number="2" style="c" sid="MAT 2"/>
  <para style="s1">Abika ahwɛng ídzɛɛr adzek <optbreak/> udiki inyɛ̃num aba iyepa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1"/>Ivangyɛ umbɔ aka amar Uyesu ru uteu Ubaitarhami ru Uyahudiya ri ivang Uhiridu aka awu uyɛrhe, abika ahwɛng ídzɛɛr adzeki igɔ̃kpee aba Urusharhima. <verse eid="MAT 2:1"/><verse number="2" style="v" sid="MAT 2:2"/>Na arhusa agɛ, &lt;&lt;Ungwɛ̃ hã umbɔ aka amar awe rinɛɛ uyɛrhe abi Uyahuda? Umɛn inyãmɛn idzɛrnga ri igɔ̃kpee nu umɛn ĩba idzowe unga igɔng.&gt;&gt;<verse eid="MAT 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3"/>Ivangyɛ Uyɛrhe Uhiridu aka agũ rimi, amɛnnga adake nu kishoo abi Urusharhima. <verse eid="MAT 2:3"/><verse number="4" style="v" sid="MAT 2:4"/>Ivangyɛ unga aka akɔng kishoo ateiya abika adzowe idɛm-Num nu abika amesuwe Ikpem, unga arhusa umbɔ anangkɛ umbɔ aka imar Ukiristo. <verse eid="MAT 2:4"/><verse number="5" style="v" sid="MAT 2:5"/>Umbɔ agɔr unga agɛ, &lt;&lt;Ru uteu Ubaitarhami ru Uyahudiya. Ubinkpi uwuku usɔm Arherhu-Num aka atsɛng,<verse eid="MAT 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6"/>&lt;&lt; &lt;Bɔr ungo, Ubaitarhami ra abĩ Uyahuda,</para>
  <para style="q2" vid="MAT 2:6">ungo usi iweɔ uwuku uci ri iteu Uyahuda.</para>
  <para style="q1" vid="MAT 2:6">Ubinkutsu awu ru ungo</para>
  <para style="q2" vid="MAT 2:6">uyɛrhu uwɔɔ aka idzeka,</para>
  <para style="q1" vid="MAT 2:6">uwuruwi aka idarh anermum Uisrairha.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">2.6 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="MIC 5:2">Umik 5.2</ref></char>.</note><verse eid="MAT 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7"/>Mɔcɛ Uhiridu aghɔ̃rhã ayisa abika ahwɛng ídzɛɛr ha arhusa abee ihwɛng ivangyɛ umbɔ aka anyã idzɛɛr ha. <verse eid="MAT 2:7"/><verse number="8" style="v" sid="MAT 2:8"/>Mɔcɛ unga adene umbɔ azĩmbɔ Ubaitarhami agɔr umbɔ agɛ, &lt;&lt;Àka azĩ angwɛ̃dzɛn na arhisuwa irheng ungwɛ̃ hã. Ivangyɛ umbi aka anyãmbi unga, umbi aba asɔma umum nu umum igamum izĩ indzowe unga igɔng.&gt;&gt;<verse eid="MAT 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9"/>Umbɔ aka agũ arherhe uyɛrhe amaa, umbɔ azĩmbɔ udĩmbɔ. Idzɛɛr ha umbɔ aka anyã ri igɔ̃kpee ha izɛ̃rhã ra asumbɔ, umbɔ adɔsa ngge utsɛku ngge iki iba idɛ̃ɛ̃ ra anangkɛ ungwɛ̃ hã aka awe. <verse eid="MAT 2:9"/><verse number="10" style="v" sid="MAT 2:10"/>Ivangyɛ umbɔ aka anyã idzɛɛr ha, umbɔ agɔm anggɔm akarhãrhã. <verse eid="MAT 2:10"/><verse number="11" style="v" sid="MAT 2:11"/>Umbɔ aka atsĩ ri iya ha, umbɔ anyã irheng ungwɛ̃ hã nggu uyanga Umaryamu, umbɔ atararhu ra anangnga adzowe unga igɔng. Mɔcɛ umbɔ agarha akpokambɔ adzowe ízũwã uzinarhi nu atsei umbɔ iki iyisa ufirankisen nu umur. <verse eid="MAT 2:11"/><verse number="12" style="v" sid="MAT 2:12"/>Umbɔ aka awu ri irheyirhɔ, Unum adɛyika umbɔ niba ibvui azĩmbɔ ru Uhiridu. Umbɔ adɔsu udĩ ukpɔɔ azĩmbɔ abĩmbɔ.<verse eid="MAT 2:12"/></para>
  <para style="s1">Atĩ azĩmbɔ Umasar</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13"/>Umbɔ aka azĩmbɔ, Uyusuf arheyirhɔ anyã ipfu itser Uteijee iki igɔr unga igɛ, &lt;&lt;Usisok, ushupu irheng ungwɛ̃ hã nu uyanga na atĩ azĩmbi abĩ Umasar. Àka asei nggɔɔ ha utsɛku umum iki indɛyiwa umbi. Uhiridu awuri ibeenga irheng ungwɛ̃ hã na afɛre unga.&gt;&gt; <verse eid="MAT 2:13"/><verse number="14" style="v" sid="MAT 2:14"/>Nggee unga asok ashupu irheng ungwɛ̃ hã nu uyanga ru untsuuka akũ azĩã Umasar. <verse eid="MAT 2:14"/><verse number="15" style="v" sid="MAT 2:15"/>Umbɔ asei nggɔɔ ha utsɛku Uhiridu aka akpe. Akɛrɛ ha akorhe rimi ngge itsuifɛr ubinkpi Uteijee aka arherhe ra angwĩ uner uwuku usɔm Arherhu-Num agɛ, &lt;&lt;Umum iyisu ungwɛ̃mum adzek ru Umasar.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">2.15 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="HOS 11:1">Uho 11.1</ref></char>.</note><verse eid="MAT 2:15"/></para>
  <para style="s1">Afɛyiwe awɛkaci ru Uyahudiya</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16"/>Ivangyɛ Uhiridu aka ahwɛng ugɛ abika ahwɛng ídzɛɛr ha arhɛm unga, unga agũ avɔm akarhãrhã. Unga atsu umbɔ afɛyiwe irheng awɛkatsa kishoo ru Ubaitarhami nu ikãwãngge, udzur ra awɛkatsa abi imɛka ivaa uba ra andzing. Unga akorha akɛrɛ ha ubinkutsu udzur ri ivang hã abika ahwɛng ídzɛɛr ha aka asɔme unga imar ungwɛ̃ hã iki iwe imɛka ivaa. <verse eid="MAT 2:16"/><verse number="17" style="v" sid="MAT 2:17"/>Ivang hã niyɔ ngge iki itsuifɛr ubinkpi uner uwuku usɔm Arherhu-Num Uirimiya aka arherhe agɛ,<verse eid="MAT 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18"/>&lt;&lt;Agũmbɔ urhɛm ru Urama,</para>
  <para style="q2" vid="MAT 2:18">ididɔng nu ifakpe irhɛirhɛ,</para>
  <para style="q1" vid="MAT 2:18">Urahirha unga adɛ̃ɛ̃ iciu akpe angwɛ̃nga,</para>
  <para style="q2" vid="MAT 2:18">na akpɛ̃ɛ̃ iyɛi idɔngamɛn ru unera,</para>
  <para style="q1" vid="MAT 2:18">ubinkutsu aka ashembɔ.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">2.18 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="JER 31:15">Uiri 31.15</ref></char>.</note><verse eid="MAT 2:18"/></para>
  <para style="s1">Abvui azĩ Unazarat</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19"/>Uhiridu aka akpe, Uyusuf arheyirhɔ ru Umasar anyã ipfu itser Uteijee iki igɔr unga igɛ, <verse eid="MAT 2:19"/><verse number="20" style="v" sid="MAT 2:20"/>&lt;&lt;Usok ushupu irheng ungwɛ̃ hã nu uyanga ukũ uzĩ abĩ Uisrairha. Abika abee ifɛr ungwɛ̃ hã aka akpembɔ.&gt;&gt;<verse eid="MAT 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21"/>Nggee unga asok, ashupu ungwɛ̃ nu uyanga akũ azĩã abĩ Uisrairha. <verse eid="MAT 2:21"/><verse number="22" style="v" sid="MAT 2:22"/>Bɔr unga aka agũ ugɛ Uarkirhayu ungwɛ̃ Uhiridu aka anyangu ukam utɛnga awu uyɛrhe Uyahudiya, unga agũã iwei izĩ nggɔɔ ha. Bɔr unga aka arheyirhɔ umbɔ agbiite atonga, unga atsĩã ru Ugarhirhi. <verse eid="MAT 2:22"/><verse number="23" style="v" sid="MAT 2:23"/>Azĩ aseisa ru uteu ukpɔɔ umbɔ iki iyisa Unazarat. Ngge itsuifɛr ubinkpi abika asɔm Arherhu-Num aka arherhe agɛ, &lt;&lt;Awuri iyisa unga uner Unazarat.&gt;&gt;<verse eid="MAT 2:23"/></para>
  <chapter eid="MAT 2"/>
  <chapter number="3" style="c" sid="MAT 3"/>
  <para style="s1">Isarhe Uyohana Uner Ubɔtisima</para>
  <para style="r">(<ref loc="MRK 1:1-8">Umar 1.1-8</ref>; <ref loc="LUK 3:1-18">Irh 3.1-18</ref>; <ref loc="JHN 1:19-28">Uyoh 1.19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1"/>Ivang hã niyɔ Uyohana Uner Ubɔtisima aka aba adzowe isarhe ra arhum Uyahudiya, <verse eid="MAT 3:1"/><verse number="2" style="v" sid="MAT 3:2"/>anu igɔr agɛ, &lt;&lt;Àka adzipa, Iyɛrhe afã iki iyongge!&gt;&gt; <verse eid="MAT 3:2"/><verse number="3" style="v" sid="MAT 3:3"/>Uner ha nuwɔ uwuku usɔm Arherhu-Num Uishaya aka arherhe ra arherhanga agɛ,</para>
  <para style="q1" vid="MAT 3:3">&lt;&lt;Urhɛm uwɔɔ uyisa ra arhum ugɛ,</para>
  <para style="q2" vid="MAT 3:3">&lt;Àka agbishuwe udĩ Uteijee,</para>
  <para style="q1" vid="MAT 3:3">àka avii atsĩndĩã uku urhirhiki ru unga!&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3.3 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="ISA 40:3">Uish 40.3</ref></char>.</note><verse eid="MAT 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4"/>Atorho Uyohana awu igwar urhakumi, abow ikpɔm ubvur nu upfurhsĩnga. Ubinghanga uwu asusu nu utoo arhum. <verse eid="MAT 3:4"/><verse number="5" style="v" sid="MAT 3:5"/>Mɔcɛ aner Urusharhima nu abi Uyahudiya kishoo nu abĩ akɔɔ ru ugbɛr Azɛ̃ Urdun adzeyi aba ru unga. <verse eid="MAT 3:5"/><verse number="6" style="v" sid="MAT 3:6"/>Adɛ̃ɛ̃ asɔm arhimmbɔ nu unga asorhuwe umbɔ ubɔtisima ra Azɛ̃ Urdun.<verse eid="MAT 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7"/>Bɔr unga aka anyã abi Ufarisi nu abi Usaduki arhɛrhɛ aka aba ra anangkɛ unga aka adɛ̃ɛ̃ isorhu ubɔtisima, unga agɔr umbɔ agɛ, &lt;&lt;Umbi angwɛ̃ íbvui! Ungaa adɛyiwa umbi itĩ avɔm Unum aka iba unuma? <verse eid="MAT 3:7"/><verse number="8" style="v" sid="MAT 3:8"/>Àka atɔ̃ itseryɛ iki idɛyiwe idzidzipambi. <verse eid="MAT 3:8"/><verse number="9" style="v" sid="MAT 3:9"/>Àka aneke ikaifɛrhkɔ ra amɛnmbi agɛ, &lt;Uibrahim unga awu utɛmɛn.&gt; Umum idɛyiwa umbi Unum awea ri ijee unga aka itsu atarh akɛrɛ ake awe awɛkaci ru Uibrahim. <verse eid="MAT 3:9"/><verse number="10" style="v" sid="MAT 3:10"/>Aka atsumbɔ anggãi ru unang acucii. Ubɛn ucucii uku usi ighwɛrmgbɔ ikpũrhã iyiki ize, awuri igbɛr umgbɔ atsu ru urha.<verse eid="MAT 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11"/>&lt;&lt;Umum ikorhuwa umbi ubɔtisima nggu amɛ̃ utsar idzidzipambi. Bɔr uwuruwi aka ananga umum ijee nggawɔ awuri iba ru undzingmum, abadaknga umum isi ímɛ̃ɛ̃mum ishipa. Unga awuri isorhuwa umbi ubɔtisima nggu Ipfu Isarsatangge nu urha. <verse eid="MAT 3:11"/><verse number="12" style="v" sid="MAT 3:12"/>Akpɔm nggu utaknga, awuri itsɛki ishaa itsemnga na akarha ngge atsuku ungbanga na akpĩĩwe uhweenga ru urhakpi uku usi írhimkpɔ.&gt;&gt;<verse eid="MAT 3:12"/></para>
  <para style="s1">Ubɔtisima Uyesu</para>
  <para style="r">(<ref loc="MRK 1:9-11">Umar 1.9-11</ref>; <ref loc="LUK 3:21-22">Irh 3.21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13"/>Mɔcɛ Uyesu aka adzeku Ugarhirhi aba ru Uyohana asorhuwe unga ubɔtisima ra Azɛ̃ Urdun. <verse eid="MAT 3:13"/><verse number="14" style="v" sid="MAT 3:14"/>Uyohana abee ikɛn unga, agɔr agɛ, &lt;&lt;Umum ibee ungo usorhuwa umum ubɔtisima, ungo usok uba ru umum?&gt;&gt;<verse eid="MAT 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15"/>Bɔr Uyesu agɔr unga agɛ, &lt;&lt;Uneke ngge iwe rimi icɛrɛ. Azea umɛn ikorhe ri iminɛ ngge itsuifɛr kishoo ubinkpi Unum aka abee.&gt;&gt; Mɔcɛ Uyohana abemuwe unga.<verse eid="MAT 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16"/>Umbɔ aka asorhuwe Uyesu ubɔtisima, unga adzeka ra amɛ̃. Kanying afã ayanga, unga anyã Ipfu-Num iki icipuwa ru nyaku unurhɛu, iba isei nu unga. <verse eid="MAT 3:16"/><verse number="17" style="v" sid="MAT 3:17"/>Mɔcɛ urhɛm udzeka afã ugɔr ugɛ, &lt;&lt;Uwɛrɛ unga awu Ungwɛ̃mum ukpekũ iki ibema. Nggu unga umum igũibɛn akarhãrhã.&gt;&gt; <figure style="fig" alt="Spirit of God descend like a dove" file="DN00410b.tif" size="col" loc="3.17" copy="Dn" ref="3.16">Ipfu-Num iki icipuwa ru nyaku unurhɛu</figure><verse eid="MAT 3:17"/></para>
  <chapter eid="MAT 3"/>
  <chapter number="4" style="c" sid="MAT 4"/>
  <para style="s1">Undenggũ adeyi Uyesu</para>
  <para style="r">(<ref loc="MRK 1:12-13">Umar 1.12-13</ref>; <ref loc="LUK 4:1-13">Irh 4.1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1"/>Mɔcɛ Ipfu-Num idarh Uyesu izĩngge ra arhum ru Undenggũ adeya unga. <verse eid="MAT 4:1"/><verse number="2" style="v" sid="MAT 4:2"/>Uyesu akpem igha ubin inuma isɔka inaa nu utsuu nu atenum. Unga aka amaa, imerh ifɛr unga. <verse eid="MAT 4:2"/><verse number="3" style="v" sid="MAT 4:3"/>Mɔcɛ Undenggũ aba agɔr unga agɛ, &lt;&lt;Ungo uba uwu Ungwɛ̃ Unum, utsu atarh akɛrɛ awu uborodi.&gt;&gt;<verse eid="MAT 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4"/>Uyesu agɔr unga agɛ, &lt;&lt;Itsɛng Arherhu-Num igɔr igɛ, &lt;Asi iwea ubingha ukpekũ itsu unera abɛk, bɔr ubɛn urhɛm arherhe uku udzeka ra angwĩ Unum.&gt;<note caller="+" style="f"><char style="fr" closed="false">4.4 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="DEU 8:3">Iva 8.3</ref></char>.</note>&gt;&gt;<verse eid="MAT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5"/>Mɔcɛ Undenggũ ashupa unga azĩ adɛ̃ɛ̃ afafã nu usarkasar uteu ni itsi uvi Iya-Num. <verse eid="MAT 4:5"/><verse number="6" style="v" sid="MAT 4:6"/>Agɔr unga agɛ, &lt;&lt;Ungo uba uwu Ungwɛ̃ Unum, utersha ugba nu abĩ. Ubinkutsu itsɛng Arherhu-Num igɔrngge ugɛ,</para>
  <para style="q1" vid="MAT 4:6">&lt;&lt; &lt;Unga awuri itsu ípfu itsernga ngge ingwɛ̃dzɛn</para>
  <para style="q2" vid="MAT 4:6">ni ikaa ungo,</para>
  <para style="q1" vid="MAT 4:6">ngge iwuri ikpɔm ungo ra afafã ra abokngge,</para>
  <para style="q2" vid="MAT 4:6">utsur ungo ukwɛrɔ undaidakngo nu utarh.&gt;<note caller="+" style="f"><char style="fr" closed="false">4.6 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="PSA 91:11">Amb 91.11</ref>,<ref loc="PSA 91:12">12</ref></char>.</note> &gt;&gt; <figure style="fig" alt="Jesus standing on top of Temple" file="dn00405b.tif" size="col" copy="Darwin Dunham" ref="4.5-7">Uyesu adɛ̃ɛ̃ ni itsi uvi Iya-Num</figure><verse eid="MAT 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7"/>Uyesu agɔr unga agɛ, &lt;&lt;Itsɛng Arherhu-Num igɔrngge ikɛi ugɛ, &lt;Ungo niba ivirungo Uteijee Unumngo!&gt;<note caller="+" style="f"><char style="fr" closed="false">4.7 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="DEU 6:16">Iva 6.16</ref></char>.</note>&gt;&gt;<verse eid="MAT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8"/>Undenggũ ashupa unga ikɛi aden ni itsi igũ iyɔɔ iderdetangge, adɛyiwe unga iyɛrhe upfung nu igɔngngge. <verse eid="MAT 4:8"/><verse number="9" style="v" sid="MAT 4:9"/>Unga agɔr unga agɛ, &lt;&lt;Kishoo abina akɛrɛ umum iwuri idzaamum ungo, ungo uba utararhu nu udzaango umum igɔng.&gt;&gt;<verse eid="MAT 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10"/>Uyesu agɔr unga agɛ, &lt;&lt;Usɔkɔ ru umum, Ushaitan! Ubinkutsu itsɛng Arherhu-Num igɔrngge ugɛ, &lt;Udzowe igɔng ru Uteijee Unumngo, nu uwu ugãrhãnga ukpekũ.&gt;<note caller="+" style="f"><char style="fr" closed="false">4.10 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="DEU 6:13">Iva 6.13</ref></char>.</note>&gt;&gt;<verse eid="MAT 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11"/>Mɔcɛ Undenggũ abɔruka unga, nu ípfu itser-Num iba itɔ̃we unga itser.<verse eid="MAT 4:11"/></para>
  <para style="s1">Uyesu atirhi itsernga ru Ugarhirhi</para>
  <para style="r">(<ref loc="MRK 1:14-15">Umar 1.14-15</ref>; <ref loc="LUK 4:14-15">Irh 4.14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12"/>Uyesu aka agũ ugɛ umbɔ aka atsuke Uyohana ru ugborzĩ, unga abvui azĩã Ugarhirhi. <verse eid="MAT 4:12"/><verse number="13" style="v" sid="MAT 4:13"/>Abɔruka Unazarat, azĩ asesa ru Ukafanahum, ukpurukpi uku uwe nggɔɔ ra angwĩ ukau ukugɔng ra abĩ Uzeburhun nu Unaftarhi. <verse eid="MAT 4:13"/><verse number="14" style="v" sid="MAT 4:14"/>Ngge itsuifɛr ubinkpi uner uwuku usɔm Arherhu-Num Uishaya aka arherhe agɛ,<verse eid="MAT 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15"/>&lt;&lt;Abĩ Uzeburhun nu abĩ Unaftarhi,</para>
  <para style="q2" vid="MAT 4:15">aka awu utsĩndĩ ukau ukugɔng,</para>
  <para style="q2" vid="MAT 4:15">ugar Azɛ̃ Urdun,</para>
  <para style="q1" vid="MAT 4:15">Ugarhirhi aka awu atsen abi Uyahuda,<verse eid="MAT 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16"/>umɔ abika asei ru uzĩ</para>
  <para style="q2" vid="MAT 4:16">aka anyãmbɔ nggaa irhirhang.</para>
  <para style="q1" vid="MAT 4:16">Nu abirabɛ aka asei ra abĩ aki uzirhzĩ akpe,</para>
  <para style="q2" vid="MAT 4:16">irhirhang iki irhangngge ru umbɔ.&gt;&gt;<verse eid="MAT 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17"/>Udzur ri ivang hã Uyesu aka atirhi idzowe isarhe, agɔr agɛ, &lt;&lt;Àka adzipa, Iyɛrhe afã iki iyongge!&gt;&gt;<verse eid="MAT 4:17"/></para>
  <para style="s1">Uyesu ayisu inera inaa abika adzui abɛrh</para>
  <para style="r">(<ref loc="MRK 1:16-20">Umar 1.16-20</ref>; <ref loc="LUK 5:1-11">Irh 5.1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18"/>Uyesu azɛ̃rhã nu ubang Ukau Ugarhirhi nukpi, unga anyã inera ivaa angwɛ̃yi, Usiman uwuruwi umbɔ aki iyisa Ubitru nu Uandarawu ungwɛ̃mbɔ. Anu itang igber ru ukau, ubinkutsu umbɔ awu abika adzui abɛrh. <verse eid="MAT 4:18"/><verse number="19" style="v" sid="MAT 4:19"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Àka aba adɔsa umum, nu umum iwuri itsu umbi awu abika adzui anera.&gt;&gt; <verse eid="MAT 4:19"/><verse number="20" style="v" sid="MAT 4:20"/>Ivanga unying umbɔ aneke igbermbɔ na adɔsa unga.<verse eid="MAT 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21"/>Unga aka abɔre anang hã na azĩ anyã inera ivaa angwɛ̃yi ikɛi, Uyaku ungwɛ̃ Uzabadi nu Uyohana ungwɛ̃mbɔ. Awu ru ukhukhɔɔ amɛ̃ nggu utɛmbɔ Uzabadi, adɛ̃ɛ̃ igbishi ígbermbɔ. Uyesu ayisa umbɔ. <verse eid="MAT 4:21"/><verse number="22" style="v" sid="MAT 4:22"/>Kanying umbɔ anekukumbɔ ukhukhɔɔ ha ru utɛmbɔ na adɔsa unga.<figure style="fig" alt="Person throwing a fishing net into water" file="lb00209b.tif" size="col" loc="4.22" copy="Louise Bass" ref="4.18-22">Unera adɛ̃ɛ̃ itang igber ra amɛ̃</figure><verse eid="MAT 4:22"/></para>
  <para style="s1">Uyesu akerhuwe abi irhãrhã</para>
  <para style="r">(<ref loc="LUK 6:17-19">Irh 6.17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23"/>Uyesu azɛ̃rhã amaa Ugarhirhi, amesuwe ra abã ifɛn-Nummbɔ, adzowe Isarhe Iyiki Ize iyi Iyɛrhe Unum, na akerhuwe ubɛn irhãrhã nu ikpũ ighighong anera. <verse eid="MAT 4:23"/><verse number="24" style="v" sid="MAT 4:24"/>Isarhe ri itsinga itɛ̃rhã imaangge abĩ Usuriya, anera akũ abika agũ ighighong akarhãrhã na ahwa ayetnum nggu ikpũ írhãrhã, nu abi ípfu iyiki ibewe, nu abi irhãrhĩ izurh, nu abika afɔr uzɛ̃rhã adambɔ, unga akerhuwe umbɔ. <verse eid="MAT 4:24"/><verse number="25" style="v" sid="MAT 4:25"/>Anera arhɛrhɛ aka adzeku Ugarhirhi, nu iteu usɔka umbɔ iki iyisa Udikaforhi, nu Urusharhima, nu Uyahudiya nu ugar Azɛ̃ Urdun adɔsa unga.<verse eid="MAT 4:25"/></para>
  <chapter eid="MAT 4"/>
  <chapter number="5" style="c" sid="MAT 5"/>
  <para style="s1">Idorh ni itsi igũa</para>
  <para style="r">(<ref loc="LUK 6:20-23">Irh 6.20-23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1"/>Ivangyɛ Uyesu aka anyã ikikɔng anera arhɛrhɛ, unga afũ asei ni itsi igũa. Angwɛ̃ imesanga aba ru unga. <verse eid="MAT 5:1"/><verse number="2" style="v" sid="MAT 5:2"/>Unga atirha amesuwe umbɔ agɛ,<verse eid="MAT 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3"/>&lt;&lt;Idorh iwu iyi abirabɛ aka awe atsũwã ri ipfumbɔ,</para>
  <para style="q2" vid="MAT 5:3">ubinkutsu Iyɛrhe afã iwu iyimbɔ<verse eid="MAT 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4"/>Idorh iwu iyi abi ighongamɛn,</para>
  <para style="q2" vid="MAT 5:4">ubinkutsu awuri idɔngukumbɔ amɛnmbɔ.<verse eid="MAT 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5"/>Idorh iwu iyi abika adɔɔr,</para>
  <para style="q2" vid="MAT 5:5">ubinkutsu ukam upfung</para>
  <para style="q2" vid="MAT 5:5">uwuri iwe ukpumbɔ.<verse eid="MAT 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6"/>Idorh iwu iyi abirabɛ aka agũ imerh</para>
  <para style="q2" vid="MAT 5:6">nu ugɔ̃ irhirhika,</para>
  <para style="q1" vid="MAT 5:6">ubinkutsu umbɔ awuri ishurmbɔ.<verse eid="MAT 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7"/>Idorh iwu iyi abika acucorhe,</para>
  <para style="q2" vid="MAT 5:7">ubinkutsu awuri icorhukumbɔ umbɔ.<verse eid="MAT 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8"/>Idorh iwu iyi abi amɛn aka atɛn,</para>
  <para style="q2" vid="MAT 5:8">ubinkutsu umbɔ awuri inyãmbɔ Unum.<verse eid="MAT 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9"/>Idorh iwu iyi abika atsu ididɔɔr,</para>
  <para style="q2" vid="MAT 5:9">ubinkutsu awuri iyisa umbɔ angwɛ̃ Unum.<verse eid="MAT 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10"/>Idorh iwu iyi abika ahwa uver ri irhirhika,</para>
  <para style="q2" vid="MAT 5:10">ubinkutsu Iyɛrhe afã iwu iyimbɔ.<verse eid="MAT 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11"/>&lt;&lt;Idorh iwu iyimbi ivang anera iki irhena umbi, ayɔm umbi, na arherhuwa umbi ikpũ iki ibewe ri itsimum. <verse eid="MAT 5:11"/><verse number="12" style="v" sid="MAT 5:12"/>Àka agɔm akarhãrhã, ubinkutsu umbi awuri ikpo itosa irhɛirhɛ ra afã, ubinkutsu rimi hã umbɔ aka ayɔm abika asɔm Arherhu-Num abi inggbaashia.<verse eid="MAT 5:12"/></para>
  <para style="s1">Angwã nu irhirhang</para>
  <para style="r">(<ref loc="MRK 9:50">Umar 9.50</ref>; <ref loc="LUK 14:34-35">Irh 14.34-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13"/>&lt;&lt;Umbi awu angwã abĩã. Bɔr angwã aba ashike nu itonga ake, awuri ikorha aguse na atsu ake awe angwã ikɛi? Awuri ishike ru ugarh, awuri ititare ake na anera azɛ̃rhã nu ake.<verse eid="MAT 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14"/>&lt;&lt;Umbi awu irhirhang upfung. Uteukpi uku udzin nu igũ asi ídɛ̃ɛ̃ awɔmbɔ ukpɔ. <verse eid="MAT 5:14"/><verse number="15" style="v" sid="MAT 5:15"/>Unera asi ítsu irhirhang na awɔka ngge ri ikikĩĩ. Nu ngge iki iwe rimi, awuri idene ngge idɛ̃ɛ̃ ra anang idɛ̃ɛ̃ngge nu ngge irhange ubɛn unera ri iya. <verse eid="MAT 5:15"/><verse number="16" style="v" sid="MAT 5:16"/>Rimi hã, àka aneke irhirhangmbi irhang ra anera, ngge ítsu umbɔ anyã itser iyiki izembi na akpoi Utɛmbi uwu afã.<verse eid="MAT 5:16"/></para>
  <para style="s1">Itsuifɛr iyi Ikpem</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17"/>&lt;&lt;Niba akaimbi ifɛrhkɔ ugɛ umum ĩba ififɔ̃rhuwe Íkpem Umusa use itsɛng abika asɔm Arherhu-Num. Umum isi ĩbamum ififɔ̃rhuwe ngge, bɔr umum ĩba itsu ngge itsuifɛr. <verse eid="MAT 5:17"/><verse number="18" style="v" sid="MAT 5:18"/>Umum indɛyiwa umbi idzidzɛrhe, utsɛku afã nu abĩ awuri imaa, uko ishia ra arherhe Íkpem Umusa isi ífɔ̃rhũngge utsɛku umbɔ aki itsu abina kishoo atsuafɛr. <verse eid="MAT 5:18"/><verse number="19" style="v" sid="MAT 5:19"/>Uwuruwi aka azharhuwe ungwɛ̃rhi ishia unying ri Ikpem na amesuwe anera akorha ngge, awuri iyisa unga uku ucia ri Iyɛrhe afã, bɔr uwuruwi aka adɔsa ngge na amesuwe ngge, awuri iyisa unga nggaa uner ri Iyɛrha afã. <verse eid="MAT 5:19"/><verse number="20" style="v" sid="MAT 5:20"/>Umum idɛyiwa umbi ugɛ irhirhikambi iba isi inangngge iyi abika amesuwe Ikpem nu abi Ufarisi, umbi asi ítsĩmbi ri Iyɛrhe afã.<verse eid="MAT 5:20"/></para>
  <para style="s1">Imesa ri itsi avɔm</para>
  <para style="r">(<ref loc="LUK 12:57-59">Irh 12.57-59</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21"/>&lt;&lt;Umbi aka agũmbi umbɔ aka adɛyiwe atokamɛn isha agɛ, &lt;Àka niba afɛrmbi unera,<note caller="+" style="f"><char style="fr" closed="false">5.21 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="EXO 5:21">Idzi 5.21</ref></char>.</note> nu uwuruwi aka afɛr uner awuri itsu uvau nu unga.&gt; <verse eid="MAT 5:21"/><verse number="22" style="v" sid="MAT 5:22"/>Bɔr umum idɛyiwa umbi uwuruwi aka agũ avɔm nggu undɔkanga awuri itsu uvau nu unga. Ikɛi uwuruwi aka ayisu undɔkanga agɛ, &lt;Ibɛm,&gt; umbɔ awuri ikũna unga azĩ ra anang aka atsu uvau. Bɔr uwuruwi aka agɔr undɔkanga agɛ, &lt;Ugugge!&gt; unga awuri itsĩ ri igbaigba idzũũ urha.<verse eid="MAT 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23"/>&lt;&lt;Nggee, ungo uba udɛ̃ɛ̃ngo idzowe izũwã nu uyitta ugɛ uwɔɔ awu ra avɔm nggu ungo, <verse eid="MAT 5:23"/><verse number="24" style="v" sid="MAT 5:24"/>uneke izũwã hã ra asu ubeu ha kata. Ugbaashia uzĩ umbi agbisha nggu uner ha. Mɔcɛ nu uba adzowe izũwãngo.<verse eid="MAT 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25"/>&lt;&lt;Unera aba atsuka arherhe ri itsingo ru udzepurhe uku uvarha arherhe, àka agbisha nu utsĩndĩ ifetem, iba ishingge rimi unga awuri igbopuwe ungo nggu uwuku atsu uvau, uwuku utsu uvau atsuke ungo ra abok ambow umbɔ agbange ungo ru ugborzĩ. <verse eid="MAT 5:25"/><verse number="26" style="v" sid="MAT 5:26"/>Umum indɛyiwa ungo idzidzɛrhe, ungo usi ídzekɔ umɔ utsɛku ungo iki ifai umaa ukobo ha umbɔ aka atsu ungo ififai.<verse eid="MAT 5:26"/></para>
  <para style="s1">Imesa ri itsi arhim itoma-dak</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27"/>&lt;&lt;Umbi aka agũmbi umbɔ aka agɔr agɛ, &lt;Niba utomungo-dak.&gt;<note caller="+" style="f"><char style="fr" closed="false">5.27 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="EXO 20:14">Idzi 20.14</ref></char>.</note> <verse eid="MAT 5:27"/><verse number="28" style="v" sid="MAT 5:28"/>Bɔr umum idɛyiwa umbi ugɛ ubɛn unera aba arhisa ukutsɛrh irhi anyɔna, unga aka atomunga-dak nggu utsɛrh ha ra amɛnnga. <verse eid="MAT 5:28"/><verse number="29" style="v" sid="MAT 5:29"/>Usungo ukpu ubok ugha uba uwuri itsuka ungo ra arhim, uhor ukpɔ utare. Ugba ungo ushiɔ ru ugau ukpɔɔ ukpu iyorngo nu umbɔ aka itare iyorngo kishoo ri idzũũ urha. <verse eid="MAT 5:29"/><verse number="30" style="v" sid="MAT 5:30"/>Ubok ughango uba itsukakpɔ arhim ru ungo, uzharha ukpɔ utare. Ugba ungo ushiɔ ru ugau ukpɔɔ ri iyorngo nu iyorngo kishoo iki itsĩ ri idzũũ urha.<verse eid="MAT 5:30"/></para>
  <para style="s1">Izharhuwe itsɛrh</para>
  <para style="r">(<ref loc="MAT 19:9">Umat 19.9</ref>; <ref loc="MRK 10:11-12">Umar 10.11-12</ref>; <ref loc="LUK 16:18">Irh 16.18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31"/>&lt;&lt;Aka agɔrmbɔ ugɛ, &lt;Uwuruwi aka itsũwe utsɛ̃nga, awu ufang unga adzowe ubvur izharhuwe itsɛrh.&gt;<note caller="+" style="f"><char style="fr" closed="false">5.31 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="DEU 24:1">Iva 24.1</ref></char>.</note> <verse eid="MAT 5:31"/><verse number="32" style="v" sid="MAT 5:32"/>Bɔr umum idɛyiwa umbi ugɛ ubɛn unera aka atsũwe utsɛ̃nga ri ida iwe ru uvau itoma-dak, atsuke unga ru utsĩndĩ itoma-dak. Nu uwuruwi aka apfunu utsɛrh uwuku uwuwayi ha, uner ha atoma-dak.<verse eid="MAT 5:32"/></para>
  <para style="s1">Uyirh</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33"/>&lt;&lt;Ikɛi umbi aka agũmbi umbɔ aka adɛyiwe atokamɛn agɛ, &lt;Àka niba azharhukumbi uyirh, bɔr imɛ̃ɛ̃ngge ungo utsufɛr ubinkpi ungo uku uyirhe Uteijee.&gt; <verse eid="MAT 5:33"/><verse number="34" style="v" sid="MAT 5:34"/>Bɔr umum idɛyiwa umbi ugɛ niba ayirhmbi uyirh. Niba ayirhmbi nggu afã, ubinkutsu afã awu anang isei Unum. <verse eid="MAT 5:34"/><verse number="35" style="v" sid="MAT 5:35"/>Niba ayirhmbi nggu upfung, ubinkutsu awu ubin uku utsorhe andaidaknga, use nggu Urusharhima, ubinkutsu awu uteu Uyɛrhe Ukugɔng. <verse eid="MAT 5:35"/><verse number="36" style="v" sid="MAT 5:36"/>Niba uyirhɔ nggu itsingo, ubinkutsu ungo usi ídɛ̃ɛ̃ utsu igwar unying iwengge iki iterha use iki ifĩrhã. <verse eid="MAT 5:36"/><verse number="37" style="v" sid="MAT 5:37"/>Imɛ̃ɛ̃ngge umbi agɔr agɛ &lt;Ĩĩ&gt; use &lt;Ĩ'ĩ&gt;. Ubɛn ubinkpi uku utɔngkpɔ rimi idzeku uwuku ubewe ha.<verse eid="MAT 5:37"/></para>
  <para style="s1">Ififai</para>
  <para style="r">(<ref loc="LUK 6:29-30">Irh 6.29-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38"/>&lt;&lt;Umbi aka agũmbi umbɔ aka agɔr agɛ, &lt;Unera aba atsũwũka usungo, umbɔ atsũwe usu ukpunga, nu unera aba atsũwũka unyĩĩngo, umbɔ atsũwe unyĩĩ ukpunga.&gt;<note caller="+" style="f"><char style="fr" closed="false">5.38 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="EXO 21:24">Idzi 21.24</ref>; <ref loc="LEV 24:20">Urha 24.20</ref>; <ref loc="DEU 19:21">Iva 19.21</ref></char>.</note> <verse eid="MAT 5:38"/><verse number="39" style="v" sid="MAT 5:39"/>Bɔr umum idɛyiwa umbi ugɛ niba afaimbi iyiki ibewe nggu iyiki ibewe. Unera aba akwɛra ungo nu utam ubok ugha, udzipuwe utam ukpu uvaa ikɛi. <verse eid="MAT 5:39"/><verse number="40" style="v" sid="MAT 5:40"/>Unera aba atsuka arherhango ra anang aka atsu uvau na abeenga ivur atorhango, udzowe nggu atorho akagɔnga ikɛi. <verse eid="MAT 5:40"/><verse number="41" style="v" sid="MAT 5:41"/>Unera aba atsu ungo uzɛ̃rhũngo ru ukirhomita unying, uzĩ nggu unga akirhomita avaa. <verse eid="MAT 5:41"/><verse number="42" style="v" sid="MAT 5:42"/>Udzowe uwuruwi aka aba ibibee ru ungo, niba udzipukɔ undzing nu uwuruwi aka abee ikɔw ru ungo.<verse eid="MAT 5:42"/></para>
  <para style="s1">Àka abema anggamtsakmbi</para>
  <para style="r">(<ref loc="LUK 6:27-28">Irh 6.27-28</ref>,<ref loc="LUK 6:32-36">32-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43"/>&lt;&lt;Umbi aka agũmbi umbɔ aka agɔr agɛ, &lt;Ubemu undɔkango nu ukpɛ̃ɔ uwuku ukpɛ̃ ungo.&gt;<note caller="+" style="f"><char style="fr" closed="false">5.43 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="EXO 19:18">Idzi 19.18</ref></char>.</note> <verse eid="MAT 5:43"/><verse number="44" style="v" sid="MAT 5:44"/>Bɔr umum idɛyiwa umbi ugɛ, àka abemu uwuku ukpɛ̃ umbi na afɛne-Num ru abika adzaa umbi uver. <verse eid="MAT 5:44"/><verse number="45" style="v" sid="MAT 5:45"/>Rimi hã umbi awuri iwe ru nyaka angwɛ̃ idzidzɛrhe abi Utɛmbi ra afã. Unga atsu unum urhang ra abika aze nu abika abewe, na atsu inai idoi ra abika arhurhika nu abirabɛ aka asi irhikumbɔ. <verse eid="MAT 5:45"/><verse number="46" style="v" sid="MAT 5:46"/>Umbi aba abema abirabɛ aka abema umbi ukpekũ, umbi awuri ikpo ikpũ ugbɛtu ukusong? Use abika ayɛi ikirbi abĩ asi ikorhumbɔ rimi? <verse eid="MAT 5:46"/><verse number="47" style="v" sid="MAT 5:47"/>Umbi aba akpurha aghwe anermbi, umbi akorhu use anang abɔɔ? Abi uzĩ asi ikorhumbɔ rimi hã? <verse eid="MAT 5:47"/><verse number="48" style="v" sid="MAT 5:48"/>Àka awe andzumunga ri irhirhika, ru nyaku Utɛmbi uwu afã aka awu undzumunga ri irhirhika.<verse eid="MAT 5:48"/></para>
  <chapter eid="MAT 5"/>
  <chapter number="6" style="c" sid="MAT 6"/>
  <para style="s1">Adzowe izũwã</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1"/>&lt;&lt;Àka angwɛ̃dzɛn utsur itser iyi irhirhikambi iwengge iyi anera aka inyã. Umbi aba akorhe rimi, umbi asi íkpombi itosa ru Utɛmbi uwu afã.<verse eid="MAT 6:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2"/>&lt;&lt;Ngge itsu ivangyɛ ungo uku uwuri idzowe abika abubee, niba urherhungo ake ra awiya, ru nyaka abi ukpukpeta aki ikorhe ra abã ifɛn-Num nu atsĩndĩ ngge itsú anera akpoi umbɔ. Umum indɛyiwa umbi idzidzɛrhe, umbɔ aka ayɛi itosambɔ niyɔ. <verse eid="MAT 6:2"/><verse number="3" style="v" sid="MAT 6:3"/>Bɔr ivangyɛ ungo uku iyike uner uwuku ububee, niba uneke uner uwɔɔ ahwɛnga ubinkpi ungo uku ikorhe. <verse eid="MAT 6:3"/><verse number="4" style="v" sid="MAT 6:4"/>Ngge ítsu izũwã ungo ima iwe ri iwɔk. Mɔcɛ Utɛngo, uwuku unyã ri iwɔk, ama adzaa itosango.<verse eid="MAT 6:4"/></para>
  <para style="s1">Ifɛn-Num</para>
  <para style="r">(<ref loc="LUK 11:2-4">Irh 11.2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5"/>&lt;&lt;Ivang ifɛn-Nummbi, àka niba awembi ru nyaka abi ukpukpeta, umbɔ abemi idɛ̃ɛ̃ na afɛn-Num ra abã ifɛn-Num nu atsĩndĩ ru anera anyã umbɔ. Umum indɛyiwa umbi idzidzɛrhe, umbɔ aka ayɛimbɔ undzumu itosambɔ. <verse eid="MAT 6:5"/><verse number="6" style="v" sid="MAT 6:6"/>Bɔr ivangyɛ ungo iki ifɛn-Num, utsĩ ru ubãngo nu ufɔme angwĩ ubãã, ufɛnu Utɛngo uwuku uwe ri iwɔk. Utɛngo uwuku unyã ri iwɔk awuri idzidzaanga itosango. <verse eid="MAT 6:6"/><verse number="7" style="v" sid="MAT 6:7"/>Ivangyɛ umbi aka ifɛn-Num, àka niba adarhumbi ider arherhe ru nyaka abirabɛ aka asi ihwɛngmbɔ Unum. Umbɔ akaifɛrhkɔ ugɛ arherhe urhɛrhɛ uwuri itsu umbɔ agũ. <verse eid="MAT 6:7"/><verse number="8" style="v" sid="MAT 6:8"/>Niba awembi ru nyaka umbɔ. Utɛmbi ahwɛnga ubinkpi umbi aka abee nu umbi adɔrha afɛna unga.<verse eid="MAT 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9"/>&lt;&lt;Àka afɛn-Num riminɛ,</para>
  <para style="q1" vid="MAT 6:9">&lt;&lt; &lt;A Utɛmɛn ra afã,</para>
  <para style="q1" vid="MAT 6:9">atsam itsokngo isarsatake.<verse eid="MAT 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10"/>Iyɛrhango iba,</para>
  <para style="q1" vid="MAT 6:10">ubinkpi ungo uku ubee umbɔ akorhe</para>
  <para style="q2" vid="MAT 6:10">ru upfung ru nyaka umbɔ iki ikorhe ra afã.<verse eid="MAT 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11"/>Uma udzaa ubinghamɛn ukpu irherɛ.<verse eid="MAT 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12"/>Uma utsũwe arhimmɛn,</para>
  <para style="q2" vid="MAT 6:12">ru nyaka umɛn iki isaki itsũwe abika ashɔng umɛn.<verse eid="MAT 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13"/>Niba udarh umɛn uzĩɔ ru undeya,</para>
  <para style="q1" vid="MAT 6:13">bɔr ufɔrh umɛn ri iyiki ibewe.&gt;<verse eid="MAT 6:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 6:14"/>Umbi aba atsũwũkumbi anera aka ashɔng umbi, Utɛmbi uwu afã awuri itsũwãnga umbi. <verse eid="MAT 6:14"/><verse number="15" style="v" sid="MAT 6:15"/>Bɔr umbi aba asi itsũwũkumbi anera aka ashɔng umbi, rimi hã Utɛmbi asi ítsũwũka arhimmbi.<verse eid="MAT 6:15"/></para>
  <para style="s1">Ikpem ighabin</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16"/>&lt;&lt;Ivangyɛ umbi aka ikpem ighabin, niba asherhumbi unyɛ̃ɛ̃mbi ru nyaka abi ukpukpeta aki ikorhe, umbɔ aka isaka asherhu unyɛ̃ɛ̃mbɔ ra anera anyã umbɔ aka akpem ighabin. Umum indɛyiwa umbi idzidzɛrhe, umbɔ aka ayɛimbɔ undzumu itosambɔ. <verse eid="MAT 6:16"/><verse number="17" style="v" sid="MAT 6:17"/>Bɔr ivangyɛ ungo uku ukpemɔ̃ ighabin, usorh asungo nu ukpai itsingo nu udzuka atsei, <verse eid="MAT 6:17"/><verse number="18" style="v" sid="MAT 6:18"/>utsur anera ahwɛngmbɔ ungo uku ukpem ighabin, bɔr Utɛngo ukpekũ, aka awu ri iwɔk. Nu unga, Utɛngo aka anyã ri iwɔk, awuri idzidzaanga itosango.<verse eid="MAT 6:18"/></para>
  <para style="s1">Iwe ru ubin ra afã</para>
  <para style="r">(<ref loc="LUK 12:33-34">Irh 12.33-34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19"/>&lt;&lt;Niba akɔng abin angwɛ̃mbi ru upfung, anangkɛ adzurh nu ivivɔ̃ɔ̃ iki idakuwe ake, nu avɛu aki itsĩ avɛu ivɛu. <verse eid="MAT 6:19"/><verse number="20" style="v" sid="MAT 6:20"/>Bɔr àka atsu amɛnmbi ri ikpo ugbɛta ra afã, anangkɛ adzurh nggu ivivɔ̃ɔ̃ asi ídakuke ake, anangkɛ avɛu asi ítsĩ avɛumbɔ. <verse eid="MAT 6:20"/><verse number="21" style="v" sid="MAT 6:21"/>Ubinkutsu, anangkɛ abinmbi aka awe, umɔ amɛnmbi aka iwe ikɛi.<verse eid="MAT 6:21"/></para>
  <para style="s1">Irhirhang iyor</para>
  <para style="r">(<ref loc="LUK 11:34-36">Irh 11.34-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22"/>&lt;&lt;Asu ake awu irhirhang iyor. Asungo aba akerke, iyorngo kishoo iwuri itɔk nggu irhirhang. <verse eid="MAT 6:22"/><verse number="23" style="v" sid="MAT 6:23"/>Bɔr asungo aba asi ikerke, iyorngo kishoo iwuri iwe ru uzĩ. Uba irhirhang ru ungo iwu uzĩ, nggaa uzĩ hã uwu uguse!<verse eid="MAT 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24"/>&lt;&lt;Unera asi ídɛ̃ɛ̃ atɔ̃wũka itser ra ateiya avaa. Unga awuri ibema unying na akpɛ̃ɛ̃ uwɔrɔ, unga awuri idzowe itsinga ru unying na akpɛ̃ɛ̃ uwɔrɔ. Ungo usi ídɛ̃ɛ̃ udzowukɔ itsingo ru Unum nu uhwɛk.<verse eid="MAT 6:24"/></para>
  <para style="s1">Niba agũmbi ighong</para>
  <para style="r">(<ref loc="LUK 12:23-31">Irh 12.23-31</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25"/>&lt;&lt;Nggee umum idɛyiwa umbi, niba agũmbi ighong ru ibibɛkmbi nu ubinkpi umbi aka igha, use ubinkpi umbi aka ihwa, use atorhakɛ umbi aka itsim nu ayormbi. Urhɛ usi inangmgbɔ ubingha? Iyor isi inangge atorho? <verse eid="MAT 6:25"/><verse number="26" style="v" sid="MAT 6:26"/>Àka anyã anunu afã. Asi idoike asi igbɛrke asi ikɔng atsuke ra angban. Bɔr Utɛmbi uwu afã unga adzowe ighigha ake. Umbi asi iwu ru ugarh anangmbi ake? <verse eid="MAT 6:26"/><verse number="27" style="v" sid="MAT 6:27"/>Ungamɔ ru umbi igũ ighongnga idɛ̃ɛ̃ itomungge ivanga unying ri inumyɛ unga aka ibɛk?<verse eid="MAT 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28"/>&lt;&lt;Awu use utsu umbi agũ ighong atorho? Àka arhi ífur arhum iki iseng. Isi itɔ̃ngge itser use inuw abin. <verse eid="MAT 6:28"/><verse number="29" style="v" sid="MAT 6:29"/>Bɔr umum idɛyiwa umbi, uyɛrhe Usorhomon ri igɔngnga kishoo unga anasi igbɛra idzam ru nyaki ifur unying. <verse eid="MAT 6:29"/><verse number="30" style="v" sid="MAT 6:30"/>Unum aba agbɛruka idzam nu ubĩĩ arhum rimi, uku uwe irherɛ nu udã umbɔ akpĩĩwe ru urha, asi ígbɛranga umbi idzam, umbi abi imangmang iyiki ici? <verse eid="MAT 6:30"/><verse number="31" style="v" sid="MAT 6:31"/>Nggee niba agũmbi ighong agɛ, &lt;Umɛn igha usee?&gt; use &lt;Umɛn ihwa usee?&gt; use &lt;Umɛn itsim usee?&gt; <verse eid="MAT 6:31"/><verse number="32" style="v" sid="MAT 6:32"/>Abi uzĩ abee ikpũ abin akɛrɛ ha. Rimi hã Utɛmbi uwu afã ahwɛnga umbi abeembi abin hã. <verse eid="MAT 6:32"/><verse number="33" style="v" sid="MAT 6:33"/>Bɔr àka agbaashia abee Iyɛrhe Unum nu irhirhikanga, nu abin hã kishoo awuri idzaambɔ umbi ikɛi. <verse eid="MAT 6:33"/><verse number="34" style="v" sid="MAT 6:34"/>Nggee niba agũmbi ighong iyi udã, ubinkutsu udã uwu nggu ayetnumkpɔ. Ubɛn unuma ayetnum amɛ̃ɛ̃ke nggu ukpɔ.<verse eid="MAT 6:34"/></para>
  <chapter eid="MAT 6"/>
  <chapter number="7" style="c" sid="MAT 7"/>
  <para style="s1">Uneke itsu uvau ra anera</para>
  <para style="r">(<ref loc="LUK 6:37-38">Irh 6.37-38</ref>,<ref loc="LUK 6:41-42">41-42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1"/>&lt;&lt;Àka aneke itsu uvau ra anera, utsur umbɔ atsukambɔ umbi uvau. <verse eid="MAT 7:1"/><verse number="2" style="v" sid="MAT 7:2"/>Ikpũ uvauwi umbi aki itsuke anera, ikpũ iyi ha umbɔ aka itsuka umbi. Ugbiuwi umbi aka akũ amei, awuri ikũ umgbɔ ha amei adzaa umbi.<verse eid="MAT 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3"/>&lt;&lt;Awu use utsu ungo urhi umbumbin ru usu undɔkango nu usi inyãɔ̃ ungbũngkũ uku uwe ru usungo? <verse eid="MAT 7:3"/><verse number="4" style="v" sid="MAT 7:4"/>Ungo ukorhu uguse nu ugɔr undɔkango ugɛ, &lt;Uneke umum itsũwã umbumbin ru usungo,&gt; nggayɛ ungbũngkũwi uwu ru usu ukpungo? <verse eid="MAT 7:4"/><verse number="5" style="v" sid="MAT 7:5"/>Ungo uner ukpukpeta, utirhu utsũwe ungbũngkũ ru usungo, mɔcɛ nu urhi utai nu utsũwe umbumbin ru usu undɔkango.<verse eid="MAT 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6"/>&lt;&lt;Àka niba adzowukumbi íjui abin aka asar. Niba atarkumbi abinarhɔ aki imang ra arhede. Ake awuri ijang adak na adzipa anayiwa umbi.<verse eid="MAT 7:6"/></para>
  <para style="s1">Arhusa, abee, akwɛr angwĩ ubã</para>
  <para style="r">(<ref loc="LUK 11:9-13">Irh 11.9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7"/>&lt;&lt;Àka afɛna awuri idzaambɔ umbi. Àka abee umbi awuri ikpikpombi. Àka akwɛr angwĩ ubã awuri itsuruwambɔ umbi. <verse eid="MAT 7:7"/><verse number="8" style="v" sid="MAT 7:8"/>Ubɛn unerwi aka afɛna awuri iyɛisa, unga uwuku ububee awuri ikpoa, nu unga uwuku ukwɛr angwĩ ubã awuri itsurukumbɔ unga.<verse eid="MAT 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9"/>&lt;&lt;Awu ungamɔ ru umbi, ungwɛ̃nga aba arhusa uborodi, unga awuri idzowe unga utarh? <verse eid="MAT 7:9"/><verse number="10" style="v" sid="MAT 7:10"/>Use unga aba arhusu ubɛrh, unga awuri idzowe unga ibvui? <verse eid="MAT 7:10"/><verse number="11" style="v" sid="MAT 7:11"/>Umbi abi amɛn aka abewe aba ahwɛngmbi idzowe angwɛ̃mbi abin aka aze, iwuri iwe iguse Utɛmbi ra afã aka idzowe abin aka aze ra abirabɛ aka ifɛna unga! <verse eid="MAT 7:11"/><verse number="12" style="v" sid="MAT 7:12"/>Nggee ubɛn ubinkpi umbi aka abee anera akorhuwa umbi, àka akorhuwe umbɔ rimi hã. Akɛrɛ kishoo ake awu Íkpem Umusa nu abika asɔm Arherhu-Num.<verse eid="MAT 7:12"/></para>
  <para style="s1">Angwĩ akika apare nu akika atɛi</para>
  <para style="r">(<ref loc="LUK 11:9-13">Irh 11.9-13</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13"/>&lt;&lt;Àka atsĩ ra angwĩ ubã aka apare. Ubinkutsu anera arhɛrhɛ abika atsĩ ra angwĩ aka atɛi nu utsĩndĩ uwuku uzĩ itsitsĩm, utɛi. <verse eid="MAT 7:13"/><verse number="14" style="v" sid="MAT 7:14"/>Bɔr angwĩ ubã akika apare nu utsĩndĩ uwuku uzĩ ibibɛk ughong uzãrhã. Abika adɔsa umgbɔ asi irhɛmbɔ.<verse eid="MAT 7:14"/></para>
  <para style="s1">Ucucii nu ikpũrhãngge</para>
  <para style="r">(<ref loc="LUK 6:43-44">Irh 6.43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15"/>&lt;&lt;Àka angwɛ̃dzɛn nggu abika asɔm Arherhu-Num igbɛrangwĩ. Umbi awuri inyã umbɔ ru nyaki ídɔi, bɔr idzidzɛrhe umbɔ awu íjui ngbako iyɛ imerh iki ifɛr akarhãrhã. <verse eid="MAT 7:15"/><verse number="16" style="v" sid="MAT 7:16"/>Umbi awuri ihwɛng umbɔ ri ikpũ itsermbɔ. Awuri idɛ̃ɛ̃ akɔɔrmbɔ ikpũrhã inebi ru ucucii ididɔk, use awuri ikpombɔ uvorhvo ri ididɔk? <verse eid="MAT 7:16"/><verse number="17" style="v" sid="MAT 7:17"/>Rimi hã ubɛn ucucii uwuku uze uku usaku ughwɛr ikpũrhã iyiki ize, bɔr ucucii uku ubewe uku usaku ughwɛr ikpũrhã iyiki ibewe. <verse eid="MAT 7:17"/><verse number="18" style="v" sid="MAT 7:18"/>Ucucii uwuku uze usi ídɛ̃ɛ̃ ughwɛrmgbɔ ikpũrhã iyiki ibewe, rimi hã ucucii uwuku ubewe usi ídɛ̃ɛ̃ ughwɛrmgbɔ ikpũrhã iyiki ize. <verse eid="MAT 7:18"/><verse number="19" style="v" sid="MAT 7:19"/>Ubɛn ucucii uku usi íghwɛrmgbɔ ikpũrhã iyiki ize, umbɔ awuri igbɛr atsuku urha. <verse eid="MAT 7:19"/><verse number="20" style="v" sid="MAT 7:20"/>Nggee, awu ikpũrhãke awuri itsu umbi ahwɛng ake.<verse eid="MAT 7:20"/></para>
  <para style="s1">Umum isi ihwɛng umbi</para>
  <para style="r">(<ref loc="LUK 13:25-27">Irh 13.25-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21"/>&lt;&lt;Asi iwea ubɛn unera aka igɔr umum agɛ, &lt;A Uteijee, a Uteijee,&gt; awuri itsĩ ri Iyɛrhe afã, bɔr awu uwuruwi ukpekũ aka akorhu ubinkpi Utɛmum uwuku uwu ra afã aka abee. <verse eid="MAT 7:21"/><verse number="22" style="v" sid="MAT 7:22"/>Ru unum hã anera arhɛrhɛ awuri igɔr umum agɛ, &lt;A Uteijee, a Uteijee! Umɛn isi isɔmmɛn Arherhu-Num ri itsokngo, nu ri itsokngo umɛn iki iwayiwe ípfu iyiki ibewe ri ikorha abin idzeu arhɛrhɛ?&gt; <verse eid="MAT 7:22"/><verse number="23" style="v" sid="MAT 7:23"/>Mɔcɛ umum iki igɔr umbɔ ugɛ, &lt;Umum isi ihwɛng umbi. Àka asombi ru umum, umbi abika akorhe iki ibewe.&gt;<verse eid="MAT 7:23"/></para>
  <para style="s1">Uner idzin itsoi nu uguge uner idzin</para>
  <para style="r">(<ref loc="LUK 6:47-49">Irh 6.47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24"/>&lt;&lt;Nggee uwuku ugũ arherhamum na atɔ̃ itser nggu ake, unga awu ru nyaku uner itsoi uwuruwi aka adzin iyanga ni ifa. <verse eid="MAT 7:24"/><verse number="25" style="v" sid="MAT 7:25"/>Mɔcɛ inai idoi, amɛ̃ adzek, ugba uso ukwɛr iya ha. Ike isi igbake ubinkutsu, adzin ike ni ifa. <verse eid="MAT 7:25"/><verse number="26" style="v" sid="MAT 7:26"/>Bɔr uwuku ugũ arherhamum na akpɛ̃ɛ̃ itɔ̃ itser nggu ake, unga awu ru nyaku ugugge uwuruwi aka adzin iyanga nu uzuzeu. <verse eid="MAT 7:26"/><verse number="27" style="v" sid="MAT 7:27"/>Inai idoi, amɛ̃ adzek, ugba uso ukwɛr iya ha, igbigba ike ibewungge.&gt;&gt;<verse eid="MAT 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28"/>Ivangyɛ Uyesu aka amaa irherhe abin akɛrɛ, ikikɔnga idzedzeu imesanga, <verse eid="MAT 7:28"/><verse number="29" style="v" sid="MAT 7:29"/>ubinkutsu unga amesuwe umbɔ ru nyaku unerwi aka awe ru ijee, asi iwea ru nyaka abika amesuwe Ikpemmbɔ.<verse eid="MAT 7:29"/></para>
  <chapter eid="MAT 7"/>
  <chapter number="8" style="c" sid="MAT 8"/>
  <para style="s1">Uner ingbim</para>
  <para style="r">(<ref loc="MRK 1:40-45">Umar 1.40-45</ref>; <ref loc="LUK 5:12-16">Irh 5.12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1"/>Ivangyɛ Uyesu aka acipuwa ri igũ hã, anera arhɛrhɛ aka adɔsa unga. <verse eid="MAT 8:1"/><verse number="2" style="v" sid="MAT 8:2"/>Uner ingbim uwɔɔ aba atararhu ra anangnga na agɔr agɛ, &lt;&lt;A uteiya, ungo uba ubemungo, ungo udɛ̃ɛ̃ usarango umum.&gt;&gt;<verse eid="MAT 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3"/>Uyesu aberu uboknga abanga unga na agɛ, &lt;&lt;Umum ĩbeemum, usar!&gt;&gt; Kanying ingbimnga ikerhungge. <verse eid="MAT 8:3"/><verse number="4" style="v" sid="MAT 8:4"/>Mɔcɛ Uyesu agɔr unga agɛ, &lt;&lt;Niba udɛyikɔ unera. Bɔr uzĩ, udɛyiwe itsingo ru uwuku udzowe idɛm-Num, nu udzowe izũwã ru nyaki Íkpem Umusa iki itsu. Ngge iwe ideka ru umbɔ ugɛ ungo uku ukerhungo.&gt;&gt;<verse eid="MAT 8:4"/></para>
  <para style="s1">Imangmang unggbaashi <optbreak/> abi iwa Uroma</para>
  <para style="r">(<ref loc="LUK 7:1-10">Irh 7.1-10</ref>; <ref loc="JHN 4:43-54">Uyoh 4.43-54</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5"/>Ivangyɛ Uyesu aka atsĩ ru Ukafanahum, uteiya abi iwa Uroma uwɔɔ aba ashɔ̃rhũ Uyesu ama ayike unga. <verse eid="MAT 8:5"/><verse number="6" style="v" sid="MAT 8:6"/>Agɛ, &lt;&lt;A uteiya, ugãrhãmum ashai iyor awe ri iya, anu igũ ighong akarhãrhã.&gt;&gt;<verse eid="MAT 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7"/>Uyesu agɔr unga agɛ, &lt;&lt;Umum iwuri iba ikerhukũ unga.&gt;&gt;<verse eid="MAT 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8"/>Unggbaashi abi iwa Uroma ha agɔr agɛ, &lt;&lt;A uteiya, umum isi imɛ̃ɛ̃mum ungo iki iba ri iyamum. Bɔr urherhu urhɛm ukpekũ, ugãrhãmum hã awuri ikerhunga. <verse eid="MAT 8:8"/><verse number="9" style="v" sid="MAT 8:9"/>Umum iwe ru ubok ijee, abi iwa abɔɔ awu ru ubokmum. Igɔr uwɛrɛ inggɛ, &lt;Uzĩ,&gt; unga azĩã, nu uwɔrɔ inggɛ, &lt;Uba,&gt; unga abanga. Umum iba igɔr ugãrhãmum inggɛ, &lt;Ukorhe riminɛ,&gt; unga akorhe.&gt;&gt;<verse eid="MAT 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10"/>Ivangyɛ Uyesu aka agũ rimi, unga adzeidzeu na agɔr abika adɔsa unga agɛ, &lt;&lt;Umum indɛyiwa umbi idzidzɛrhe, ru Uisrairha kishoo umum inasi ikpomum uwuku uwe ru imangmang ikerketangge ru nyaki iyɛrɛ ha. <verse eid="MAT 8:10"/><verse number="11" style="v" sid="MAT 8:11"/>Umum igɔr umbi ugɛ anera arhɛrhɛ awuri idzeki igɔ̃kpee nu udiku urhɛɛ, aba asei nggu Uibrahim, Uishaku nu Uyakubu agha irhowa ri Iyɛrhe afã. <verse eid="MAT 8:11"/><verse number="12" style="v" sid="MAT 8:12"/>Bɔr awuri itare irhɛ abi Uisrairha ra awiya ru uzĩ, anangkɛ umbɔ aka iciu akpe nggu itãi anyĩ.&gt;&gt;<verse eid="MAT 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13"/>Mɔcɛ Uyesu agɔr uteiya abi iwa Uroma hã agɛ, &lt;&lt;Uzĩ! Iwuri ikorhungge ru nyaka ungo uku uwe ru imangmango.&gt;&gt; Kanying ugãrhãnga akerhunga ri ivang hã.<verse eid="MAT 8:13"/></para>
  <para style="s1">Uyesu akerhuwe anera arhɛrhɛ</para>
  <para style="r">(<ref loc="MRK 1:29-31">Umar 1.29-31</ref>; <ref loc="LUK 4:38-39">Irh 4.38-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14"/>Ivangyɛ Uyesu aka atsĩ ri iya Ubitru, unga anyã uya utsɛrha Ubitru anu nu ukoma iyora imani. <verse eid="MAT 8:14"/><verse number="15" style="v" sid="MAT 8:15"/>Unga abangu uboknga imani iyor ha inekungge unga. Uya ha asok akorhuwe unga ubingha.<verse eid="MAT 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16"/>Urhɛɛ uku uwe, umbɔ akũ anera arhɛrhɛ abika awe ru ípfu iyiki ibewe aba ru unga. Unga akũ irhɛm awayiwe ngge na akerhuwe abi irhãrhã kishoo. <verse eid="MAT 8:16"/><verse number="17" style="v" sid="MAT 8:17"/>Akorha akɛrɛ ngge itsuifɛr ubinkpi umbɔ aka arherhe ra angwĩ uner uwuku usɔm Arherhu-Num Uishaya agɛ,</para>
  <para style="q1" vid="MAT 8:17">&lt;&lt;Unga nyanguwe irhãrhãmɛn,</para>
  <para style="q2" vid="MAT 8:17">unga akerhuwe ighongamɛn.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">8.17 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="ISA 53:4">Uish 53.4</ref></char>.</note><verse eid="MAT 8:17"/></para>
  <para style="s1">Ayetnum akika adɔsu Uyesu</para>
  <para style="r">(<ref loc="LUK 9:57-62">Irh 9.57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18"/>Ivangyɛ Uyesu aka anyã nggaa ikikɔng anera iki idzipa unga, unga atsu umbɔ agar ukau ha azĩ ugar ukpɔrɔ. <verse eid="MAT 8:18"/><verse number="19" style="v" sid="MAT 8:19"/>Mɔcɛ uner uwuku umesuwe Ikpem aba agɔr unga agɛ, &lt;&lt;A umarhem, umum idɔsa ungo izĩ ubɛn anang ungo iki izĩ.&gt;&gt;<verse eid="MAT 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20"/>Uyesu adzipa agɔr unga agɛ, &lt;&lt;Íjui ngbako iyiki ici iwengge ri ingwĩngge, anunu ikɛi aweke ra ashiyake, bɔr Ungwɛ̃-Ner ashia ra anangkɛ unga aka itsu itsinga.&gt;&gt;<verse eid="MAT 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21"/>Ungwɛ̃ imesa uwɔɔ agɔr unga agɛ, &lt;&lt;A uteiya, uneka umum inggbaashia izĩ ĩdzake utɛmum.&gt;&gt;<verse eid="MAT 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22"/>Bɔr Uyesu agɔr unga agɛ, &lt;&lt;Udɔsa umum, uneke abika akpe adzake abika akpembɔ.&gt;&gt; <figure style="fig" alt="Fox with babies in foxhole/den" file="bk00051b.tif" size="col" loc="8.22" copy="Louise Bass and Horace Knowles" ref="8.20">Ijui ngbako iyiki ici nggu angwɛ̃ngge</figure><verse eid="MAT 8:22"/></para>
  <para style="s1">Uyesu adɔɔte ugba inai</para>
  <para style="r">(<ref loc="MRK 4:35-41">Umar 4.35-41</ref>; <ref loc="LUK 8:22-25">Irh 8.22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23"/>Mɔcɛ unga atsĩ ukhukhɔɔ amɛ̃, angwɛ̃ imesanga adɔsa unga. <verse eid="MAT 8:23"/><verse number="24" style="v" sid="MAT 8:24"/>Kanying ugba ukerketakpɔ usoyi ru ukau amɛ̃ hã, amɛ̃ asoyi atsĩrhã ru ukhukhɔɔ ha. Bɔr Uyesu awu ru urhɔ. <verse eid="MAT 8:24"/><verse number="25" style="v" sid="MAT 8:25"/>Angwɛ̃ imesa azĩ azita unga, agɔr agɛ, &lt;&lt;A uteiya, ufɔrha umɛn! Umɛn iki iwuri itsĩmmɛn!&gt;&gt;<verse eid="MAT 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26"/>Unga agɔr umbɔ agɛ, &lt;&lt;Umbi abi imangmang iyiki ici, awu use utsu umbi agũ iwei rimi?&gt;&gt; Mɔcɛ unga asok atsɛrhu ugba nu ubvun ukau ha. Ukpɔ kishoo udɔɔr uku utata.<verse eid="MAT 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27"/>Anera adzeidzeu na arhusa agɛ, &lt;&lt;Awu ikpũ uner uwukusong nuwi? Ugba nu ubvun ukau ikɛi agũna unga!&gt;&gt;<verse eid="MAT 8:27"/></para>
  <para style="s1">Ikikerhuwe inera ivaa <optbreak/> abi ipfu iyiki ibewe</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28"/>Ivangyɛ unga aka atsĩ ugar ukpɔrɔ ra abĩ abi Ugadara, inera ivaa abi ipfu iyiki ibewe aka adzek ra anang adzak anera agbopa unga. Umbɔ awu ubin iwei akarhãrhã, ngge itsu anera asi idɛ̃ɛ̃ adɔsumbɔ utsĩndĩ hã. <verse eid="MAT 8:28"/><verse number="29" style="v" sid="MAT 8:29"/>Umbɔ atsu ivum agɛ, &lt;&lt;A Ungwɛ̃ Unum, ungo uba itser use ru umɛn? Ungo uba idzaa umɛn uver ri ivanga idɔrhi iwe?&gt;&gt;<verse eid="MAT 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30"/>Ukhapa ru umbɔ, ukpui arhede arhɛrhɛ udɛ̃ɛ̃ ughãwã. <verse eid="MAT 8:30"/><verse number="31" style="v" sid="MAT 8:31"/>Ípfu iyiki ibewa ha ishɔ̃rhũ Uyesu igɛ, &lt;&lt;Ungo uba uwayikɔ umɛn, utsu umɛn itsĩ ru ukpui arhede ukpɔrɔ.&gt;&gt;<verse eid="MAT 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32"/>Mɔcɛ unga agɔr ngge agɛ, &lt;&lt;Àka azĩ!&gt;&gt; Ngge idze izĩ ru ukpui arhede ha, ake asok atĩ acipa nu ughoghor abang ukau ha agba atsĩ ra amɛ̃ akpeke. <verse eid="MAT 8:32"/><verse number="33" style="v" sid="MAT 8:33"/>Abi ughãwã arhede ha atĩ atsĩ ru utepa adzowe isarhe ha kishoo, nu ubinkpi uku ukorhe ra abi ipfu iyiki ibewa ha. <verse eid="MAT 8:33"/><verse number="34" style="v" sid="MAT 8:34"/>Mɔcɛ kishoo anera ru utepa adzek agbangu Uyesu. Ivangyɛ umbɔ aka anyã unga, umbɔ ashɔ̃rhã unga ama asoka ra abĩmbɔ.<verse eid="MAT 8:34"/></para>
  <chapter eid="MAT 8"/>
  <chapter number="9" style="c" sid="MAT 9"/>
  <para style="s1">Uyesu akerhuwe uner ushayi iyor</para>
  <para style="r">(<ref loc="MRK 2:1-12">Umar 2.1-12</ref>; <ref loc="LUK 5:17-26">Irh 5.17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1"/>Uyesu atsĩ ukhukhɔɔ amɛ̃, agar azĩ uteunga. <verse eid="MAT 9:1"/><verse number="2" style="v" sid="MAT 9:2"/>Aner abɔɔ akũ uner ishayi iyor aba ru unga, anu nu ufar. Ivangyɛ Uyesu aka anyã imangmangmbɔ, unga agɔr ushayi iyor ha agɛ, &lt;&lt;Niba ugũo ighong ungwɛ̃ ha, umbɔ aka atsũwãmbɔ arhimngo.&gt;&gt;<verse eid="MAT 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3"/>Mɔcɛ abɔɔ abika amesuwe Ikpem agɔr adɔkambɔ agɛ, &lt;&lt;Utsak uwurɛ arhenu Unum!&gt;&gt;<verse eid="MAT 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4"/>Bɔr Uyesu ahwɛnga ubinkpi umbɔ aka akaifɛrhkɔ, unga agɛ, &lt;&lt;Awu use utsu umbi akaifɛrhkɔ iyiki ibewe ra amɛnmbi rimi? <verse eid="MAT 9:4"/><verse number="5" style="v" sid="MAT 9:5"/>Akasong asi ighongke irherhe, igɔr ugɛ, &lt;Umbɔ aka atsũwãmbɔ arhimngo,&gt; use igɔr ugɛ, &lt;Usisok uzɛ̃rhã?&gt; <verse eid="MAT 9:5"/><verse number="6" style="v" sid="MAT 9:6"/>Bɔr umum ibee umbi ahwɛng ugɛ Ungwɛ̃-Ner awea ri ijee iyiki itsũwe arhim ru upfung.&gt;&gt; Mɔcɛ unga agɔr ushayi iyor ha agɛ, &lt;&lt;Usisok ufetu ufarngo uzĩ ri iya.&gt;&gt; <verse eid="MAT 9:6"/><verse number="7" style="v" sid="MAT 9:7"/>Nu utsa ha asok azĩã ri iyanga. <verse eid="MAT 9:7"/><verse number="8" style="v" sid="MAT 9:8"/>Ivangyɛ ikikɔng anera iki inyã rimi iwei ifɛr umbɔ. Umbɔ akpoi Unum, aka adzowe anera ikpũ ijee ha.<verse eid="MAT 9:8"/></para>
  <para style="s1">Uyesu ayisu Umatiyu</para>
  <para style="r">(<ref loc="MRK 2:13-17">Umar 2.13-17</ref>; <ref loc="LUK 5:27-32">Irh 5.27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9"/>Uyesu awu ru azɛ̃rhã na anyã utsawɔɔ agburh Umatiyu asei ra anang aka ayɛi ikirbi abĩ. Uyesu agɔr unga agɛ, &lt;&lt;Udɔsa umum.&gt;&gt; Mɔcɛ Umatiyu asok adɔsa unga.<verse eid="MAT 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10"/>Uyesu asei ighabin ri iya Umatiyu, abika ayɛi ikirbi abĩ nu abirabɛ umbɔ aka anyanga umbɔ awu abi arhim arhɛrhɛ, aba agha nggu unga nu angwɛ̃ imesanga. <verse eid="MAT 9:10"/><verse number="11" style="v" sid="MAT 9:11"/>Ivangyɛ abi Ufarisi aka anyã rimi, umbɔ arhusa angwɛ̃ imesanga agɛ, &lt;&lt;Awu use utsu umarhemmbi asei igha ubingha nggu abika ayɛi ikirbi abĩ nu abi arhim?&gt;&gt;<verse eid="MAT 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12"/>Ivangyɛ Uyesu aka agũ rimi, unga agɛ, &lt;&lt;Abika aker asi ibeembɔ uner agɔu, bɔr abi irhãrhã abee. <verse eid="MAT 9:12"/><verse number="13" style="v" sid="MAT 9:13"/>Àka azĩ amesa agben itsɛng Arherhu-Num akirakɛ aka agɔr ugɛ, &lt;Umum ibee umbi awe ra atorh, isi ĩbeemum idɛm-Num.&gt;<note caller="+" style="f"><char style="fr" closed="false">9.13 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="HOS 6:6">Uho 6.6</ref></char>.</note> Umum isi ĩbamum iyisa abika akaifɛrhkɔ ugɛ umbɔ arhika, umum ĩba iyisa abirabɛ aka ahwɛng ugɛ umbɔ awu abi arhim.&gt;&gt;<verse eid="MAT 9:13"/></para>
  <para style="s1">Arhusa arherhe ikpem ighabin</para>
  <para style="r">(<ref loc="MRK 2:18-22">Umar 2.18-22</ref>; <ref loc="LUK 5:33-39">Irh 5.33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14"/>Mɔcɛ angwɛ̃ imesa Uyohana aba arhusa unga, agɛ, &lt;&lt;Umɛn nggu abi Ufarisi ikpemmɛn ighabin, bɔr awu use utsu angwɛ̃ imesango asi ikpemmbɔ?&gt;&gt;<verse eid="MAT 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15"/>Mɔcɛ Uyesu agɔr umbɔ agɛ, &lt;&lt;Awu use itsu awɛrhu uner utsɛrh uwuku ufa awe ru idamɛn nu uner ha ana awe nggu umbɔ? Ivanga niyɔ ibarɔ awuri inyãnguwe uner utsɛrh uwuku ufa ha na abɔre umbɔ. Ivang hã niyɔ umbɔ aka ikpem ighabin.<verse eid="MAT 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16"/>&lt;&lt;Unera asi íkũ atorho aka afa asɔr abipa atorho aka agbe. Ubinkutsu, aka afa ha awuri ishĩrhã avaate aka agbe ha. Ivivaar ha iwuri inangge iyi inggbaashia. <verse eid="MAT 9:16"/><verse number="17" style="v" sid="MAT 9:17"/>Ikɛi unera asi ítsuka amɛ̃ inebi aka afa ra ambãĩ aka agbe. Umbɔ aba akorhumbɔ, ambãĩ hã awuri iyar. Amɛ̃ inebi ha awuri igba, ambãĩ hã awuri iwe ibɛm. Ĩ'ĩ, aka isaka atsu amɛ̃ inebi aka afa ra ambãĩ aka afa, nu ake asi íyarke ra amɛ̃ inebi adzek agbake.&gt;&gt;<verse eid="MAT 9:17"/></para>
  <para style="s1">Ukom unakutsɛrh nu ukutsɛrh <optbreak/> uwuku ughong</para>
  <para style="r">(<ref loc="MRK 5:21-43">Umar 5.21-43</ref>; <ref loc="LUK 8:40-56">Irh 8.40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18"/>Uyesu anu isɔme umbɔ akɛrɛ ha, unggbaashi uwɔɔ ru ubã ifɛn-Nummbɔ aba atararhu ra anangnga na agɛ, &lt;&lt;Unapmum anai ikpe. Bɔr uba utsorhu ubokngo nu unga awuri ibɛka.&gt;&gt; <verse eid="MAT 9:18"/><verse number="19" style="v" sid="MAT 9:19"/>Uyesu asok azĩã nggu unga, nu angwɛ̃ imesanga adɔsa unga.<verse eid="MAT 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20"/>Mɔcɛ utsɛrh uwɔɔ aka atsĩã imɛka usɔkdũmɛn nggu irhãrhã umɛ̃ɛ̃ aba ra andzing aba abangu ifɛn atorho Uyesu. <verse eid="MAT 9:20"/><verse number="21" style="v" sid="MAT 9:21"/>Unga agɔr ra amɛnnga agɛ, &lt;&lt;Umum ĩba ĩbangumum ifɛn atorhanga umum iwuri ikerhumum.&gt;&gt;<verse eid="MAT 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22"/>Ivangyɛ Uyesu aka adzipa anyã unga. Unga agɛ, &lt;&lt;Niba ugũo ighong unapmum. Imangmangngo ngge ikerhuwa ungo.&gt;&gt; Kanying utsɛrh ha akerhunga.<verse eid="MAT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23"/>Ivangyɛ Uyesu aka aba atsĩ ri iya unggbaashi ha, anyã abika abar aserhwa nu ikikɔng anera iki igwarha arherhe. <verse eid="MAT 9:23"/><verse number="24" style="v" sid="MAT 9:24"/>Unga agɛ, &lt;&lt;Àka asombi. Una hã anasi ikpea bɔr awe ru urhɔ.&gt;&gt; Bɔr umbɔ anyĩrhã unga. <verse eid="MAT 9:24"/><verse number="25" style="v" sid="MAT 9:25"/>Anera aka adzek amaa, unga atsĩ adzur ubok una hã, una hã asok adɛ̃ɛ̃. <verse eid="MAT 9:25"/><verse number="26" style="v" sid="MAT 9:26"/>Isarhe arherhe ha itɛ̃rhã imaangge abĩ hã.<verse eid="MAT 9:26"/></para>
  <para style="s1">Uyesu akerhuwe uner ibvuta <optbreak/> nu igbau</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27"/>Uyesu aka azɛ̃rhã aneke anang hã, abi ibvuta avaa adɔsa na atsarhi irhakmbɔ agɔr agɛ, &lt;&lt;Ucorhuwa umɛn Ungwɛ̃ Udauda!&gt;&gt;<verse eid="MAT 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28"/>Ivangyɛ Uyesu aka atsĩ ri iya, abi ibvuta ha aba ru unga, unga arhusa umbɔ agɛ, &lt;&lt;Umbi awembi ri imangmang ugɛ umum idɛ̃ɛ̃ ikorhuwamum akɛrɛ?&gt;&gt;</para>
  <para style="p" vid="MAT 9:28">Umbɔ agɔr unga agɛ, &lt;&lt;Ĩĩ, Uteijee.&gt;&gt;<verse eid="MAT 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29"/>Unga abanga asumbɔ na agɛ, &lt;&lt;Ri imangmangmbi neke ngge ikorhe ru umbi.&gt;&gt; <verse eid="MAT 9:29"/><verse number="30" style="v" sid="MAT 9:30"/>Asumbɔ ayanguke. Uyesu agbiite atombɔ akarhãrhã agɛ, &lt;&lt;Niba adɛyikumbi unera akɛrɛ ha.&gt;&gt; <verse eid="MAT 9:30"/><verse number="31" style="v" sid="MAT 9:31"/>Bɔr umbɔ adzek atɛ̃rhã arherhe ha amaa kishoo abĩ hã.<verse eid="MAT 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32"/>Umbɔ aka adzek ra awiya, umbɔ akũ uner uwɔɔ aka awe ru ipfu iyiki ibewe iki ikɛnngge unga arherhe aba ru Uyesu. <verse eid="MAT 9:32"/><verse number="33" style="v" sid="MAT 9:33"/>Ivangyɛ umbɔ aka awayiwe ipfu iyiki ibewe ha idze, uner igbau ha atirhunga arherhe. Ikikɔng anera idzedzeu ni igɔr igɛ, &lt;&lt;Anasi inyãmbɔ ikpũ ifɛrhɛ rimi ru Uisrairha.&gt;&gt;<verse eid="MAT 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34"/>Bɔr abi Ufarisi agɛ, &lt;&lt;Nggu ijee uyɛrhe ípfu iyiki ibewe unga iki ikũ atsusuwe ípfu iyiki ibewe.&gt;&gt;<verse eid="MAT 9:34"/></para>
  <para style="s1">Abi itsera awu ukunjiir</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35"/>Uyesu adɔsi iteu iyiki igɔng nu iyiki ici kishoo, amesuwe ra abã ifɛn-Nummbɔ. Adzowe Isarhe Iyiki Ize iyi Iyɛrhe afã, na akerhuwe anera ru kishoo ikpũ irhãrhã nu ighighong. <verse eid="MAT 9:35"/><verse number="36" style="v" sid="MAT 9:36"/>Ivangyɛ unga aka anyã anera aka akɔng arhɛrhɛ, unga agũ atorh umbɔ, ubinkutsu, umbɔ awe ru uver akarhãrhã na ashimbɔ ru uner uwuku uyike. Umbɔ awe ru nyaki ídɔiyɛ iki ishingge ru uner idzɛu. <verse eid="MAT 9:36"/><verse number="37" style="v" sid="MAT 9:37"/>Mɔcɛ unga agɔr angwɛ̃ imesanga agɛ, &lt;&lt;Igbɛra abin iwe irhɛirhɛ, bɔr abi itsera awe ukunjiir. <verse eid="MAT 9:37"/><verse number="38" style="v" sid="MAT 9:38"/>Àka ashɔ̃rhũ Uteijee uwu igbɛra abin, unga adene abi itser ri icang igbɛra abinnga.&gt;&gt;<verse eid="MAT 9:38"/></para>
  <chapter eid="MAT 9"/>
  <chapter number="10" style="c" sid="MAT 10"/>
  <para style="s1">Uyesu ayisa angwɛ̃ imesanga</para>
  <para style="r">(<ref loc="MRK 3:13-19">Umar 3.13-19</ref>; <ref loc="LUK 6:12-16">Irh 6.12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1"/>Unga aka ayisa angwɛ̃ imesa usɔkdũmɛn aba ru unga, unga adzowe umbɔ ijee iyiki itsũwe ípfu iyiki ibewe na akerhuwe ubɛn ikpũ irhãrhã nu ighighong.<verse eid="MAT 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 10:2"/>Atsok abi itser Uyesu ha akɛ usɔkdũmɛn hã, uwu inbgaashia, Usiman uwu umbɔ iki iyisa Ubitru, nu Uandarawu ungwɛ̃mbɔ, Uyaku ungwɛ̃ Uzabadi nu Uyohana ungwɛ̃mbɔ, <verse eid="MAT 10:2"/><verse number="3" style="v" sid="MAT 10:3"/>Ufirhibu, Ubatorhomi, Utoma nu Umatiyu uner uwuku uyɛisu ikirbi abĩ, Uyaku ungwɛ̃ Uharhfa, Utaddiyu, <verse eid="MAT 10:3"/><verse number="4" style="v" sid="MAT 10:4"/>Usiman uner Ukan'ana nu Uyahuda Uiskariyoti, uwuku ugha adaknga.<verse eid="MAT 10:4"/></para>
  <para style="s1">Uyesu adene angwɛ̃ imesanga</para>
  <para style="r">(<ref loc="MRK 6:7-13">Umar 6.7-13</ref>; <ref loc="LUK 9:1-6">Irh 9.1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5"/>Uyesu adene usɔkdũmɛn hã agɛ, &lt;&lt;Niba azĩmbi ra atsen abi Uyahuda use atsĩ ru ubɛn uteu Usamariya. <verse eid="MAT 10:5"/><verse number="6" style="v" sid="MAT 10:6"/>Àka azĩ ri ídɔi iyiki igwir iyi Uisrairha. <verse eid="MAT 10:6"/><verse number="7" style="v" sid="MAT 10:7"/>Ri izizĩmbi, àka adzowe isarhe iyɛrɛ agɛ, &lt;Iyɛrhe afã iki iyongge.&gt; <verse eid="MAT 10:7"/><verse number="8" style="v" sid="MAT 10:8"/>Àka akerhuwe abi irhãrhã, àka azituwe abika akpe, àka asare abi ingbim, àka atsusuwe ípfu iyiki ibewe. Umbi ayɛi ijee ha izũwã, àka atɔ̃ itser nggu ngge izũwã. <verse eid="MAT 10:8"/><verse number="9" style="v" sid="MAT 10:9"/>Niba akpɔmmbi uzinarhi use uazurhfa use ubinkpi uku uwu ru nyaku uhwɛk ri ibvukmbi. <verse eid="MAT 10:9"/><verse number="10" style="v" sid="MAT 10:10"/>Niba nyangumbi ukpoka ru uzɛ̃rhã hã, use atorho avaa, use abadak avaa use igbong, ubinkutsu, uner itser amɛ̃ɛ̃ ikpo ubingha.<verse eid="MAT 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11"/>&lt;&lt;Ubɛn uteu ukugɔng use uku uci umbi aka itsĩ, àka abee uner uwuku urhurhika umɔ. Àka asei ri iyanga utsɛku isisokmbi. <verse eid="MAT 10:11"/><verse number="12" style="v" sid="MAT 10:12"/>Ivangyɛ umbi aka itsĩ ri iya ha, àka aghwe umbɔ. <verse eid="MAT 10:12"/><verse number="13" style="v" sid="MAT 10:13"/>Iya ha iba ibemuke umbi, neke ididɔɔrambi iwe umɔ, bɔr ike iba isi ibemuke, ididɔɔrambi ibvui iba ru umbi. <verse eid="MAT 10:13"/><verse number="14" style="v" sid="MAT 10:14"/>Unera aba asi iyɛisa umbi use akpea ato ra arherhambi, àka awashuwe uzurhu uwu adakmbi ivangyɛ umbi aka idze ri iya ha use uteu ha. <verse eid="MAT 10:14"/><verse number="15" style="v" sid="MAT 10:15"/>Umum indɛyiwa umbi idzidzɛrhe, uver uteu ha use iya ha uwuri unangkpɔ ukpu aner Usɔdɔm nu Ugomora ru unum ukpuku uvarha arherhe.<verse eid="MAT 10:15"/></para>
  <para style="s1">Ayetnum akɔ abarɔ</para>
  <para style="r">(<ref loc="MRK 13:9-13">Umar 13.9-13</ref>; <ref loc="LUK 12:11-12">Irh 12.11-12</ref>; <ref loc="LUK 21:12-19">21.12-19</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16"/>&lt;&lt;Umum idena umbi adzek ru nyaka ídɔi ra ateu íjui ngbako. Nggee àka awe ru itsoi ru nyaki íbvui na ashimbi ri iki ibewe ru nyaka anurhɛu.<verse eid="MAT 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 10:17"/>&lt;&lt;Àka akpɔm amɛnmbi nggu anera, umbɔ awuri iden umbi ra ateu akakũ na akwɛr umbi ra abã ifɛn-Nummbɔ. <verse eid="MAT 10:17"/><verse number="18" style="v" sid="MAT 10:18"/>Ri itsimbi aka adɔsa umum, umbɔ awuri ikũna umbi azĩ ra asu agomna nu ayɛrhe ru nyaka abi idekamum ru umbɔ nu atsen abi Uyahuda. <verse eid="MAT 10:18"/><verse number="19" style="v" sid="MAT 10:19"/>Bɔr ivangyɛ umbɔ aka idzur umbi, niba agũmbi ighong ubinkpi umbi aka irherhe use umbi irherhe uguse. Ri ivang hã awuri idzaambɔ ubinkpi umbi aka irherhe. <verse eid="MAT 10:19"/><verse number="20" style="v" sid="MAT 10:20"/>Asi íwea umbi irherhe, bɔr Ipfu Utɛmbi ngge irherhe ra angwĩmbi.<verse eid="MAT 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21"/>&lt;&lt;Ungwɛ̃yi awuri idzowe ungwɛ̃mbɔ umbɔ afɛre, utei ikɛi awuri idzowe ungwɛ̃nga. Awɛkaci ikɛi awuri iwu ri igamtsak nggu ateimbɔ utsɛku umbɔ aka itsu umbɔ afɛre umbɔ. <verse eid="MAT 10:21"/><verse number="22" style="v" sid="MAT 10:22"/>Anera kishoo awuri ikpɛ̃na umbi ri itsokmum. Bɔr kishoo uwuku ubima utsɛku imimasha awuri ikpoa ififɔrh. <verse eid="MAT 10:22"/><verse number="23" style="v" sid="MAT 10:23"/>Umbɔ aba adzaambɔ umbi uver ra anang akɔɔ, àka atĩ azĩ anang akɔɔ. Umum indɛyiwa umbi idzidzɛrhe, Ungwɛ̃-Ner awuri ibanga nu umbi anasi imaambi itsĩrhĩ iteu Uisrairha kishoo.<verse eid="MAT 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24"/>&lt;&lt;Ungwɛ̃ imesa asi inanga umarhemnga, use ugãrhã ananga uteiyanga. <verse eid="MAT 10:24"/><verse number="25" style="v" sid="MAT 10:25"/>Ungwɛ̃ imesa awe ra anggɔm unga aka awe ru nyaku umarhemnga nu ugãrhã ru nyaku uteiyanga. Umbɔ aba ayisa umum iki iwe uteiyambi ugɛ Uba'arhzaburh uyɛrhe ípfu iyiki ibewe, awuri iyisa umbi nggu itsok ha anangmbɔ umum!<verse eid="MAT 10:25"/></para>
  <para style="s1">Unerwi aka amɛ̃ umbɔ agũ iwei unga</para>
  <para style="r">(<ref loc="LUK 12:8-9">Irh 12.8-9</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26"/>&lt;&lt;Nggee niba agũmbi iwei umbɔ. Ubin ushikpɔ umbɔ aka afɔm, ukpɔ uku usi ídzekpɔ, use ri iwɔk umbɔ aka asi íhwɛngmbɔ. <verse eid="MAT 10:26"/><verse number="27" style="v" sid="MAT 10:27"/>Abinkɛ umum iki isɔma umbi ru uzĩ, àka asɔme ake ri irhirhang. Abinkɛ aka akhɛwa ra atombi, àka adũwã ake ra atsi uvi. <verse eid="MAT 10:27"/><verse number="28" style="v" sid="MAT 10:28"/>Niba agũmbi iwei abika afɛre iyor bɔr asi ídɛ̃ɛ̃ afɛrmbɔ ipfu. Nu ngge iki iwe rimi, aka agũ iwei uwuruwi aka idɛ̃ɛ̃ afɛre iyor nu ipfu kishoo ri idzũ urha. <verse eid="MAT 10:28"/><verse number="29" style="v" sid="MAT 10:29"/>Asi iwea ahwirhgɔm avaa umbɔ aki igoshe ukobo unying? Nggee unying usi ígbamgbɔ ra abĩ Utɛmbi aka asi íhwɛnga umgbɔ. <verse eid="MAT 10:29"/><verse number="30" style="v" sid="MAT 10:30"/>Nu uko ígwar itsimbi umbɔ aka avuvarha ngge. <verse eid="MAT 10:30"/><verse number="31" style="v" sid="MAT 10:31"/>Nggee niba agũmbi iwei, umbi anangmbi ahwirhgɔm ugarh idiki irhɛirhɛ.<verse eid="MAT 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32"/>&lt;&lt;Ubɛn unera aka adɛyiwe itsinga ugɛ unga awu uwu umum ra asu anera, umum iwuri idɛyikũ unga awu uwu umum ra asu Utɛmum ra afã. <verse eid="MAT 10:32"/><verse number="33" style="v" sid="MAT 10:33"/>Bɔr ubɛn unera aka atsɛyinga ihwɛng umum ra asu anera, umum iwuri itsitsɛyimum ihwɛng unga ra asu Utɛmum ra afã.<verse eid="MAT 10:33"/></para>
  <para style="s1">Asi iwea ididɔɔr bɔr awu ifuw</para>
  <para style="r">(<ref loc="LUK 12:51-53">Irh 12.51-53</ref>; <ref loc="LUK 14:26-27">14.26-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34"/>&lt;&lt;Niba akaimbi ifɛrhkɔ ugɛ umum ĩba itsu ididɔɔr ru upfung. Umum isi ĩbamum itsu ididɔɔr, bɔr ikũ ifuw. <verse eid="MAT 10:34"/><verse number="35" style="v" sid="MAT 10:35"/>Ubinkutsu, umum ĩba itsu ifuw ru,</para>
  <para style="q1" vid="MAT 10:35">&lt;&lt; &lt;ungwɛ̃ nu utɛnga,</para>
  <para style="q2" vid="MAT 10:35">unai nu uyanga,</para>
  <para style="q1" vid="MAT 10:35">utsɛn ungwɛ̃ nu ukokanga.<verse eid="MAT 10:35"/></para>
  <para style="q2">
    <verse number="36" style="v" sid="MAT 10:36"/>Anggamtsak unera awuri iwe abi iyanga.&gt;<note caller="+" style="f"><char style="fr" closed="false">10.36 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="MIC 7:6">Umik 7.6</ref></char>.</note><verse eid="MAT 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37"/>&lt;&lt;Uwuruwi aka abemu uyanga use utɛnga ananga umum asi imɛ̃ɛ̃ iwe uwu umum. Uwuruwi aka abemu ungwɛ̃nga use unapunga ananga umum, asi imɛ̃ɛ̃ iwe uwu umum. <verse eid="MAT 10:37"/><verse number="38" style="v" sid="MAT 10:38"/>Ubɛn unera aka asi ishupu igãrhãmau ucuciianga adɔsunga umum, asi imɛ̃ɛ̃ iwe uwu umum. <verse eid="MAT 10:38"/><verse number="39" style="v" sid="MAT 10:39"/>Uwuruwi aka akpo urhɛnga, unga awuri igwirhe umgbɔ, nu uwuruwi aka agwirhuwe urhɛnga ri itsimum, awuri ikpoa umgbɔ.<verse eid="MAT 10:39"/></para>
  <para style="s1">Itser itosa</para>
  <para style="r">(<ref loc="MRK 9:41">Umar 9.41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40"/>&lt;&lt;Uwuruwi aka ayɛi umbi, ayɛi umum. Uwuruwi aka ayɛi umum ayɛi uwuku udena umum. <verse eid="MAT 10:40"/><verse number="41" style="v" sid="MAT 10:41"/>Uwuruwi aka ayɛi uwuku usɔm Arherhu-Num ri itsernga, awuri iyɛisa itosa uner uwuku usɔm Arherhu-Num. Nu ubɛn uwuku uyɛi uner uwuku urhika ri irhirhikanga awuri iyɛisa itosa iyi uner uwuku urhika. <verse eid="MAT 10:41"/><verse number="42" style="v" sid="MAT 10:42"/>Nu uwuruwi aka adzowe uko ukpɛwa amɛ̃ aka aghɛnga ru ubɛn unera ra abɛrɛ aka awe angwɛ̃ imesamum, umum indɛyiwa umbi idzidzɛrhe, awuri ikpoa itosanga.&gt;&gt;<verse eid="MAT 10:42"/></para>
  <chapter eid="MAT 10"/>
  <chapter number="11" style="c" sid="MAT 11"/>
  <para style="s1">Uyesu nu Uyohana Uner Ubɔtisima</para>
  <para style="r">(<ref loc="LUK 7:18-35">Irh 7.18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1"/>Uyesu aka amaa imesuwe angwɛ̃ imesanga usɔkdũmɛn hã, unga adzek umɔ azĩ amesuwe na adzowe isarhe ra abĩ Ugarhirhi.<verse eid="MAT 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2"/>Ivangyɛ Uyohana ru ugborzĩ aka agũ abinkɛ Ukiristo aka akorhe, unga adene angwɛ̃ imesanga <verse eid="MAT 11:2"/><verse number="3" style="v" sid="MAT 11:3"/>azĩ arhusa unga agɛ, &lt;&lt;Awu ungo uwu uwuku ububa ha, use umɛn itsu asumɛn ru uwɔɔ?&gt;&gt;<verse eid="MAT 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4"/>Uyesu adzipa agɛ, &lt;&lt;Àka abvui azĩ adɛyiwe Uyohana ubinkpi umbi aka agũ na anyã. <verse eid="MAT 11:4"/><verse number="5" style="v" sid="MAT 11:5"/>Abi ibvuta anyãmbɔ, akatarhu azɛ̃rhũmbɔ uzɛ̃rhã, abi ingbim akerhumbɔ, abi igbau agũmbɔ, ikom isongge nggu urhɛ, adzowukumbɔ Isarhe Iyiki Ize ra atsũwã. <verse eid="MAT 11:5"/><verse number="6" style="v" sid="MAT 11:6"/>Idorh iwu iyi uwu ha aka asi ikpɛ̃ɛ̃ umum ri itsi abinkɛ umum iki ikorhe.&gt;&gt;<verse eid="MAT 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7"/>Ivangyɛ awɛ imesu Uyohana aka azĩmbɔ, Uyesu atirha arherhe nggu ikikɔnga ri itsi Uyohana agɛ, &lt;&lt;Umbi azĩ izɛrhu use ra arhum? Ubĩĩ uku uder ugba iki ifɛu? <verse eid="MAT 11:7"/><verse number="8" style="v" sid="MAT 11:8"/>Iba ishingge rimi, ude umbi adzek azĩ izɛrhu use? Utsa uwɔɔ aka atsim atorho aka aze? Ĩ'ĩ, abika atsim atorho aka aze asei ra adzepurhe iyɛrhe. <verse eid="MAT 11:8"/><verse number="9" style="v" sid="MAT 11:9"/>Ude umbi adzek azĩ izɛrhu use? Uwuku usɔm Arherhu-Num? Ĩĩ, umum idɛyiwa umbi, ananga uwuku usɔm Arherhu-Num. <verse eid="MAT 11:9"/><verse number="10" style="v" sid="MAT 11:10"/>Unga hã uwi umbɔ aka atsɛng ra Arherhu-Num ri itsinga agɛ,</para>
  <para style="q1" vid="MAT 11:10">&lt;&lt; &lt;Umum iwuri idene ungwɛ̃ itsermum agbaashia ru ungo.</para>
  <para style="q2" vid="MAT 11:10">Unga awuri igbishuwa atsĩndĩngo.&gt;<note caller="+" style="f"><char style="fr" closed="false">11.10 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="MAL 3:1">Umrh 3.1</ref></char>.</note><verse eid="MAT 11:10"/></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11"/>Umum indɛyiwa umbi idzidzɛrhe, ra abirabɛ akatsɛrh aka amar asi itsĩmbɔ Uyohana Uner Ubɔtisima. Bɔr uwuruwi aka awu uku ucia ri Iyɛrhe afã, ananga unga. <verse eid="MAT 11:11"/><verse number="12" style="v" sid="MAT 11:12"/>Udzur ri ivang Uyohana Uner Ubɔtisima uba utsĩ irherɛ, Iyɛrhe afã iwe ru uver, abika adzowe uver ha umbɔ abee ivur ngge ri iker. <verse eid="MAT 11:12"/><verse number="13" style="v" sid="MAT 11:13"/>Ubinkutsu kishoo itsɛng abika asɔm Arherhu-Num nu Íkpem Umusa irherhungge arherhe akɛrɛ utsɛku ivang Uyohana. <verse eid="MAT 11:13"/><verse number="14" style="v" sid="MAT 11:14"/>Umbi aba ibemumbi ubinkpi umum iki irherhe, Uyohana unga awu Uirhiya ha umbɔ aka arherhe ugɛ unga awuri ibanga. <verse eid="MAT 11:14"/><verse number="15" style="v" sid="MAT 11:15"/>Neke uner uwuku uwu ra ato aka agũ, unga agũ.<verse eid="MAT 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16"/>&lt;&lt;Umum ikpangu udan ukpirɛ nggu use? Awu ru nyaka awɛkaci iki isei ra anang izɛɛ na ayisa abɔɔ agɛ,<verse eid="MAT 11:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17"/>&lt;&lt; &lt;Umɛn ibara umbi aserhuwa,</para>
  <para style="q2" vid="MAT 11:17">umbi akpɛ̃mbi izer.</para>
  <para style="q1" vid="MAT 11:17">Umɛn itsũ ubom akpe,</para>
  <para style="q2" vid="MAT 11:17">umbi akpɛ̃mbi iciu akpe.&gt;<verse eid="MAT 11:17"/></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18"/>Uyohana aka aba, asi itsuka amɛnnga ri ighigha nu ihwihwa, umbɔ agɛ, &lt;Unga awe ru ipfu iyiki ibewe.&gt; <verse eid="MAT 11:18"/><verse number="19" style="v" sid="MAT 11:19"/>Ungwɛ̃-Ner aka aba agha na ahwa, umbɔ agɛ, &lt;Àka anyã uner uwuku ubvun igha abin nu ihwihwa akarhãrhã, uwɛrhɛ abika ayɛi ikirbi abĩ nu abi arhim!&gt; Bɔr awu itser unera iwuri idɛyiwe ugɛ unga awea ri itsoi.&gt;&gt;<verse eid="MAT 11:19"/></para>
  <para style="s1">Atorh iteuyɛ iki inasi idzipungge</para>
  <para style="r">(<ref loc="LUK 10:13-15">Irh 10.13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20"/>Mɔcɛ Uyesu aka atirhi itsɛyi iteuyɛ unga aka akorhe irhɛ abin idzeu ri ngge, ubinkutsu, anera asi idzipumbɔ. <verse eid="MAT 11:20"/><verse number="21" style="v" sid="MAT 11:21"/>&lt;&lt;Atorhngo, Ukorazin! Atorhngo Ubetsaida! Agɛ itser idzeu ha umbɔ aka atɔ̃ ru umbi, umbɔ atɔ̃mbɔ ngge ru Utaya nu Usidon, umbɔ awuri idzipumbɔ iki ifitem, umbɔ awuri itsim ashaka atorho, na asei ra atɔɔ. <verse eid="MAT 11:21"/><verse number="22" style="v" sid="MAT 11:22"/>Bɔr umum idɛyiwa umbi, ru unum ukpuku uvarha arherhe, uvermbi uwuri inangkpɔ ukpu Utaya nu Usidon. <verse eid="MAT 11:22"/><verse number="23" style="v" sid="MAT 11:23"/>Ungo igango, Ukafanahum, ungo ukaifɛrhkɔ ugɛ awuri ibera ungo afũ afã? Ĩ'ĩ, awuri ikũna ungo acipa ra anang isei abika akpukpe. Itser idzeuyɛ umbɔ aka atɔ̃ ru ungo umbɔ aba atɔ̃ ngge ru Usɔdɔm, ukpɔ uba uwe umɔ utsɛku irherɛ. <verse eid="MAT 11:23"/><verse number="24" style="v" sid="MAT 11:24"/>Bɔr umum idɛyiwa umbi ru unum ukpuku uvarha arherhe, uvermbi uwuri inangkpɔ ukpu Usɔdɔm.&gt;&gt;<verse eid="MAT 11:24"/></para>
  <para style="s1">Àka aba ru umum na akpo iwiwosha</para>
  <para style="r">(<ref loc="MAT 10:21-22">10.21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25"/>Ri ivang hã Uyesu awu ra anggɔm ri Ipfu Isarsatangge, agɔr agɛ, &lt;&lt;Umum ikpoi ungo Utɛ, Uteijee uwu afã nggu abĩ, ungo uku uwɔkɔ ifɛrhɛ iyɛrɛ ru abi itsoi nu abi idzursu, nu usɔme ake ra awɛkaci. <verse eid="MAT 11:25"/><verse number="26" style="v" sid="MAT 11:26"/>A Utɛ, akɛrɛ ha awu ubinkpi ungo uku ugũibɛn ikorha ukpɔ.<verse eid="MAT 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27"/>&lt;&lt;Utɛmum adzaa abina kishoo ru umum. Unera asi ihwɛnga amɛn Ungwɛ̃ɛ̃, Utɛ ikiyikanga ahwɛng. Unera asi ihwɛngnga amɛn Utei, Ungwɛ̃ɛ̃ ukpekũ nu uwuruwi Ungwɛ̃ hã aka isɔme unga.<verse eid="MAT 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28"/>&lt;&lt;Àka aba ru umum, kishoo umbi abika agũ azhe na agũ imor, umum iwuri idzaamum umbi iwiwosha. <verse eid="MAT 11:28"/><verse number="29" style="v" sid="MAT 11:29"/>Àka adzowe atsimbi na amesa ru umum, ubinkutsu, umum iwu uner inna nu ididɔɔr ra amɛnmum, nu umbi awuri ikpombi iwiwosha ra amɛnmbi. <verse eid="MAT 11:29"/><verse number="30" style="v" sid="MAT 11:30"/>Ubinkutsu, idzowe itsimbi ru umum asi iwea ubin uku ughong, abinmum asi imorke.&gt;&gt;<verse eid="MAT 11:30"/></para>
  <chapter eid="MAT 11"/>
  <chapter number="12" style="c" sid="MAT 12"/>
  <para style="s1">Uteijee uwu unum ukpuku uwosha</para>
  <para style="r">(<ref loc="MRK 2:23-28">Umar 2.23-28</ref>; <ref loc="LUK 6:1-5">Irh 6.1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1"/>Ri ivang hã Uyesu azɛ̃rhã atɔng ri ícang uarhkama ru unum ukpuku uwosha. Angwɛ̃ imesanga agũ imerh umbɔ atirhi igbiu isha arhkama hã atãi. <verse eid="MAT 12:1"/><verse number="2" style="v" sid="MAT 12:2"/>Ivang abi Ufarisi aka anyã rimi, umbɔ agɔr unga agɛ, &lt;&lt;Unyã! Angwɛ̃ imesango aka azharhuwe Ikpem unum ukpuku uwosha.&gt;&gt;<verse eid="MAT 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3"/>Unga agɔr umbɔ agɛ, &lt;&lt;Umbi anasi ivarhumbi ubinkpi Udauda aka akorhe ri ivangyɛ unga nggu awɛrhu uzɛ̃rhãnga aka agũ imerh? <verse eid="MAT 12:3"/><verse number="4" style="v" sid="MAT 12:4"/>Unga aka atsĩ ru Iya-Num anyangu usarkasar uborodi atãi nggu awɛrhu uzɛ̃rhãnga, ukpurukpi ri Ikpem awu abika adzowe idɛm-Num ukpekũ iki itãi. <verse eid="MAT 12:4"/><verse number="5" style="v" sid="MAT 12:5"/>Use umbi anasi ivarhumbi ri Íkpem Umusa ugɛ abika adzowe idɛm-Num ri itser unum ukpuku uwosha ri Iya-Num aka adakuwe unum ukpuku uwosha na ishimbɔ ru uvau? <verse eid="MAT 12:5"/><verse number="6" style="v" sid="MAT 12:6"/>Umum idɛyiwa umbi uwuruwi aka ananga Iya-Num awu nggimi. <verse eid="MAT 12:6"/><verse number="7" style="v" sid="MAT 12:7"/>Umbi aba ahwɛngmbi agben itsɛng Arherhu-Num hã iki igɔr igɛ, &lt;Umum ibee umbi awe ra atorh, isi ĩbeemum idɛm-Num,&gt;<note caller="+" style="f"><char style="fr" closed="false">12.7 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="HOS 6:6">Uho 6.6</ref></char>.</note> Umbi aba asi itsumbi uvau ra abika asheru uvau. <verse eid="MAT 12:7"/><verse number="8" style="v" sid="MAT 12:8"/>Ubinkutsu Ungwɛ̃-Ner awu Uteijee unum ukpuku uwosha.&gt;&gt;<verse eid="MAT 12:8"/></para>
  <para style="s1">Uner ushayi ubok</para>
  <para style="r">(<ref loc="MRK 3:1-6">Umar 3.1-6</ref>; <ref loc="LUK 6:6-11">Irh 6.6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9"/>Adzeka anang hã unga atsĩã ru ubã ifɛn-Nummbɔ. <verse eid="MAT 12:9"/><verse number="10" style="v" sid="MAT 12:10"/>Uner uwɔɔ uboka uku ushayi awu umɔ. Umbɔ abee udĩkpi umbɔ aka ikpo Uyesu nggu uvau, umbɔ arhusa unga agɛ, &lt;&lt;Ri Ikpem imɛ̃ngge umbɔ akerhuwe ru unum ukpuku uwosha?&gt;&gt;<verse eid="MAT 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11"/>Unga agɔr umbɔ agɛ, &lt;&lt;Unera ru umbi aba awuri idɔi ngge igba ru ughwee ru unum ukpuku uwosha, uner idɔi ha asi ídzur akpɔm ngge atsũwũka? <verse eid="MAT 12:11"/><verse number="12" style="v" sid="MAT 12:12"/>Unera ananga idɔi akarhãrhã! Nggee asi iwea izharhuwe Ikpem ri ikorhi iyiki ize ru unum ukpuku uwosha.&gt;&gt;<verse eid="MAT 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13"/>Mɔcɛ unga agɔr utsak ha agɛ, &lt;&lt;Unamu ubokngo udzek.&gt;&gt; Nggee unga anamu uboknga udzek, ukpɔ ukerhe uwe ru nyaku ukpu uvaa. <verse eid="MAT 12:13"/><verse number="14" style="v" sid="MAT 12:14"/>Bɔr abi Ufarisi adzek akɛki itsũwã umbɔ aka ifɛre Uyesu.<verse eid="MAT 12:14"/></para>
  <para style="s1">Itsuifɛr isɔm Arherhu-Num Uishaya</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15"/>Ivang Uyesu aka ahwɛng rimi, unga abɔruka anang hã. Arhɛrhɛ aka adɔsa unga, unga akerhuwe irhãrhãmbɔ. <verse eid="MAT 12:15"/><verse number="16" style="v" sid="MAT 12:16"/>Unga agbiite atombɔ ugɛ niba adɛyikumbɔ iwiwenga ru unera. <verse eid="MAT 12:16"/><verse number="17" style="v" sid="MAT 12:17"/>Akɛrɛ ake atsuafɛr ubinkpi uku urherhe ra angwĩ uwuku usɔm Arherhu-Num Uishaya agɛ,<verse eid="MAT 12:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18"/>&lt;&lt;Unyã ugãrhãmum uwi umum iki isɛng,</para>
  <para style="q2" vid="MAT 12:18">uwu umum iki ĩbema,</para>
  <para style="q1" vid="MAT 12:18">ru unga umum iki igũibɛn.</para>
  <para style="q2" vid="MAT 12:18">Umum iwuri itsuke Ipfumum nu unga,</para>
  <para style="q2" vid="MAT 12:18">nu unga atsu abĩã ahwɛng irhirhika.<verse eid="MAT 12:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19"/>Asi ísoyinga isa use itsuyi ivum,</para>
  <para style="q2" vid="MAT 12:19">asi ígũmbɔ urhɛmnga nu atsĩndĩ.<verse eid="MAT 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20"/>Asi íbvũã ugamwi uku uwuri ibvũ,</para>
  <para style="q2" vid="MAT 12:20">utɔngviwi uku uwuri irhim,</para>
  <para style="q2" vid="MAT 12:20">unga asi írhĩwũka.</para>
  <para style="q1" vid="MAT 12:20">Unga awuri ikorha akɛrɛ</para>
  <para style="q2" vid="MAT 12:20">utsɛku unga aka itsu irhirhika igha inggbaashi.<verse eid="MAT 12:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21"/>Abĩã awuri ifosa ri itsoknga.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">12.21 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="ISA 42:1-4">Uish 42.1-4</ref></char>.</note><verse eid="MAT 12:21"/></para>
  <para style="s1">Uyesu nu Uba'arhzaburh</para>
  <para style="r">(<ref loc="MRK 3:20-30">Umar 3.20-30</ref>; <ref loc="LUK 11:14-23">Irh 11.14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22"/>Mɔcɛ umbɔ akũ uner ibvuta aka afɔr arherhe adaka awe ru ipfu iyiki ibewe aba. Uyesu akerhuwe unga, ngge itsu unga arherha arherhe na anyã ikɛi. <verse eid="MAT 12:22"/><verse number="23" style="v" sid="MAT 12:23"/>Anera kishoo adzeidzeu na agɛ, &lt;&lt;Awu Ungwɛ̃ Udauda nuwi?&gt;&gt;<verse eid="MAT 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24"/>Bɔr abi Ufarisi aka agũ akɛrɛ ha, umbɔ agɛ, &lt;&lt;Nggu ijee Uba'arhzaburh uyɛrhe ípfu iyiki ibewe utsak uwurɛ aka isaka akũ atsusuwe ípfu iyiki ibewe ha.&gt;&gt;<verse eid="MAT 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25"/>Uyesu ahwɛnga ifɛrhkɔmbɔ unga agɔr umbɔ agɛ, &lt;&lt;Ubɛn iyɛrhe iki igau agbɛra avaa iwuri itsĩm, nu ubɛn uteu use iya iki igau nggu adɔkake isi ídɛ̃ɛ̃ke. <verse eid="MAT 12:25"/><verse number="26" style="v" sid="MAT 12:26"/>Ushaitan aba atsũwũka Ushaitan, awe ri ifuw nggu itsikamnga. Iyɛrhanga idɛ̃ɛ̃ iguse? <verse eid="MAT 12:26"/><verse number="27" style="v" sid="MAT 12:27"/>Umum iba ikũ ijee Uba'arhzaburh itsusuwe ípfu iyiki ibewe, abimbi akũ ijee iyikisong atsusuwe? Angwɛ̃ imesambi awuri itsuka umbi uvau ra arherhe akɛrɛ. <verse eid="MAT 12:27"/><verse number="28" style="v" sid="MAT 12:28"/>Umum ĩba ikũ ijee Ipfu-Num itsusuwe ípfu iyiki ibewe, mɔcɛ Iyɛrhe Unum iki ibangge ru umbi.<verse eid="MAT 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29"/>&lt;&lt;Use ikɛi, unera awuri ikorha aguse na adɛ̃ɛ̃ atsĩ ri iya uner uwuku uker avur abinnga? Awuri igbaashia abow unga kata na adɛ̃ɛ̃ akarha abin iyanga.<verse eid="MAT 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30"/>&lt;&lt;Uwuruwi aka asi iwea nggu umum, akpɛ̃ɛ̃ umum. Uwuruwi aka asi ikɔnga nggu umum, asusituwe. <verse eid="MAT 12:30"/><verse number="31" style="v" sid="MAT 12:31"/>Nggee umum ĩdɛyiwa umbi, awuri itsũwũkumbɔ anera ru kishoo ikpũ arhim nu urhena ru Unum, bɔr uwuruwi aka arhenu Ipfu-Num, asi ítsũwũkumbɔ arhimnga. <verse eid="MAT 12:31"/><verse number="32" style="v" sid="MAT 12:32"/>Ubɛn unera aba arherhunga urhɛm uku ubewe ri itsi Ungwɛ̃-Ner, awuri itsũwũkumbɔ unga, bɔr uwuruwi aka arheni Ipfu Isarsatangge, asi ítsũwũkumbɔ unga icɛrɛ use ivang iyiki ibiba.<verse eid="MAT 12:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33"/>&lt;&lt;Ucucii uku uze uku isaku ughwɛr ikpũrhã iyiki ize, ucucii uku ubewe uku isaku ughwɛr ikpũrhã iyiki ibewe. Aka isaka ahwɛng ucucii ri ikpũrhãngge. <verse eid="MAT 12:33"/><verse number="34" style="v" sid="MAT 12:34"/>Umbi abi amɛn íbvui, umbi awuri ikorha uguse na adɛ̃ɛ̃ arherhe iyiki ize nggu amɛn aka abewambi? Ubinkpi uku uwe ra amɛn, ukpɔ uku idzeyiwa ra angwĩ. <verse eid="MAT 12:34"/><verse number="35" style="v" sid="MAT 12:35"/>Uner uwuku uze aka isaka akũ abin aka aze adzeka ra anang aka aze unga aka angwɛ̃ ru unga. Uner uwuku ubewe aka isaka akũ abin aka abewe adzeka ra anang aka abewe unga aka angwɛ̃ ru unga. <verse eid="MAT 12:35"/><verse number="36" style="v" sid="MAT 12:36"/>Umum idɛyiwa umbi ugɛ ru unum ukpuku uvarha arherhe, awuri ivarhukumbɔ ubɛn unera ra arherhe akatãrhãkɛ unga aka arherhe. <verse eid="MAT 12:36"/><verse number="37" style="v" sid="MAT 12:37"/>Ubinkutsu, irhɛm arherhango ake itsu ungo ushɔɔr, ake itsu ungo utsĩm.&gt;&gt;<verse eid="MAT 12:37"/></para>
  <para style="s1">Utsar ukpu Uyunana</para>
  <para style="r">(<ref loc="MRK 8:11-12">Umar 8.11-12</ref>; <ref loc="LUK 11:29-32">Irh 11.29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38"/>Mɔcɛ abi Ufarisi abɔɔ nu abika amesuwe Ikpem agɔr unga agɛ, &lt;&lt;A umarhem, umɛn ibee inyã utsar idzeu ru ungo.&gt;&gt;<verse eid="MAT 12:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39"/>Unga agɔr umbɔ agɛ, &lt;&lt;Abika abewe, abika asheru Unum, abi undan ukpirɛ arhusu utsar idzeu! Bɔr asi ídɛyikumbɔ umbɔ utsar, akpurha adɛyiwe utsar ukpu uwuku usɔm Arherhu-Num Uyunana. <verse eid="MAT 12:39"/><verse number="40" style="v" sid="MAT 12:40"/>Ru nyaku Uyunana aka amaa inuma itaar utsuu nu atenum ra anaa ubɛrh ukugɔng, rimi hã Ungwɛ̃-Ner aka imaa inuma itaar utsuu nu atenum awe ru anɔnɔr abĩ. <verse eid="MAT 12:40"/><verse number="41" style="v" sid="MAT 12:41"/>Aner Unineba awuri iso adɛ̃ɛ̃mbɔ ru unum ukpuku uvarha arherhe nggu udan ukpirɛ na awuri itsu uvau ru ukpɔ, ubinkutsu, umbɔ adzipumbɔ ri udũwã Uyunana. Icɛrɛ uwuku unang Uyunana uwi nggimi. <verse eid="MAT 12:41"/><verse number="42" style="v" sid="MAT 12:42"/>Ru unum ukpuku uvarha arherhe Usarauniya uwu Unɔr awuri iso adɛ̃ɛ̃ nggu undan ukpirɛ na atsuke uvau ru ukpɔ, ubinkutsu unga adzeka anang akika ader aba igũ itsoi Usorhomon. Nggayɛ uwuruwi aka anangnga Usorhomon awu nggimi.<verse eid="MAT 12:42"/></para>
  <para style="s1">Ibiba ipfu iyiki ibewe</para>
  <para style="r">(<ref loc="LUK 11:24-26">Irh 11.24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43"/>&lt;&lt;Ivangyɛ ipfu iyiki ibewe iba idzek ru unera, iki isaki iyarhe ri inang iyiki ikoi ibee ikpo iwiwosha ni isi ikpongge. <verse eid="MAT 12:43"/><verse number="44" style="v" sid="MAT 12:44"/>Ngge igɔr igɛ, &lt;Umum ibvui izĩ ri iyakɛ umum iki idzek.&gt; Ngge iba ikpo unera ashia umɔ ri iya ha, ngge inyã umbɔ aka ayar na agbishumbɔ iya ha. <verse eid="MAT 12:44"/><verse number="45" style="v" sid="MAT 12:45"/>Mɔcɛ ngge ibvui izĩ ikarhe ípfu iyiki ibewe iyɔɔ utɔɔva, iyiriyɛ iki ibewe inangngge ngge, ngge kishoo iba isei umɔ. Isisei utsa ha iyi imaataka iwuri ibewe inangge iyi inggbaashia. Iwuri iwe rimi nggu undan ukpuku ubewe ukpirɛ.&gt;&gt;<verse eid="MAT 12:45"/></para>
  <para style="s1">Uya nu angwɛ̃mbɔ Uyesu</para>
  <para style="r">(<ref loc="MRK 3:31-35">Umar 3.31-35</ref>; <ref loc="LUK 8:19-21">Irh 8.19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46"/>Uyesu aka awe ra arherhe nggu ikikɔng, uyanga nu angwɛ̃mbɔ aba adɛ̃ɛ̃ ra awiya, abee arherha arherhe nggu unga. <verse eid="MAT 12:46"/><verse number="47" style="v" sid="MAT 12:47"/>Uwɔɔ agɔr unga agɛ, &lt;&lt;Uyango nu angwɛ̃mbi adɛ̃ɛ̃ ra awiya, abee irherha arherhe nggu ungo.&gt;&gt;<verse eid="MAT 12:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48"/>Unga agɔr unga agɛ, &lt;&lt;Uwukusong awu uyamum, nu abikasong awu angwɛ̃mɛn?&gt;&gt; <verse eid="MAT 12:48"/><verse number="49" style="v" sid="MAT 12:49"/>Ayottu uboknga ra angwɛ̃ imesanga agɛ, &lt;&lt;Unyã uyamum uwi nu angwɛ̃mɛn. <verse eid="MAT 12:49"/><verse number="50" style="v" sid="MAT 12:50"/>Ubɛn unerwi aka akorhu ubinkpi Utɛmum ra afã aka abema, unga awu ungwɛ̃mɛn nu unapumɛn nu uyamum.&gt;&gt;<verse eid="MAT 12:50"/></para>
  <chapter eid="MAT 12"/>
  <chapter number="13" style="c" sid="MAT 13"/>
  <para style="s1">Unyaka arherhe uner uwuku udoi abin</para>
  <para style="r">(<ref loc="MRK 4:1-20">Umar 4.1-20</ref>; <ref loc="LUK 8:4-15">Irh 8.4-15</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1"/>Ru unum hã Uyesu adzeki iya azĩ aseisa ru ubang ukau. <verse eid="MAT 13:1"/><verse number="2" style="v" sid="MAT 13:2"/>Ikikɔng anera irhɛirhɛ iki ikɔng idziranga, itsu unga atsĩ ru ukhukhɔɔ amɛ̃ asei umɔ. Ikikɔnga idɛ̃ɛ̃ ru ubang ukau ha. <verse eid="MAT 13:2"/><verse number="3" style="v" sid="MAT 13:3"/>Mɔcɛ unga adɛyiwe umbɔ abina arhɛrhɛ ru unyaka arherhe agɛ, &lt;&lt;Uner irham azĩ inna ikpũnga. <verse eid="MAT 13:3"/><verse number="4" style="v" sid="MAT 13:4"/>Unga adɛ̃ɛ̃ inna ikpũ hã, ikpũ iyɔɔ igbei nu utsĩndĩ anunu aba akpɔuke iyi ha kanying. <verse eid="MAT 13:4"/><verse number="5" style="v" sid="MAT 13:5"/>Iyɔɔ igbei ru ukpɔrha, abĩ asi iweke akarhãrhã. Ngge imɛr kanying ubinkutsu, abĩ anang hã asi ighorke. <verse eid="MAT 13:5"/><verse number="6" style="v" sid="MAT 13:6"/>Bɔr ivangyɛ unum uku umani iyi ha ikoingge, ubinkutsu, ngge iki ishingge ra anũnang. <verse eid="MAT 13:6"/><verse number="7" style="v" sid="MAT 13:7"/>Ikpũ iyɔɔ igbei ri ididɔk, ngge isɛng itong ngge iyi ha. <verse eid="MAT 13:7"/><verse number="8" style="v" sid="MAT 13:8"/>Ikpũ iyɔɔ igba ra abĩ aka aze, anangkɛ ngge iki ighwɛr ikpũrhã ananaka, iyɔɔ isɔka utɔ̃tɔ̃ĩ use isɔka itaitaar. <verse eid="MAT 13:8"/><verse number="9" style="v" sid="MAT 13:9"/>Unga uwuku awe ra ato, neke unga agũ.&gt;&gt;<verse eid="MAT 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10"/>Angwɛ̃ imesa ha aba arhusa unga agɛ, &lt;&lt;Awu use utsu ungo urherhuwe anera arherhe ru unyaka arherhe?&gt;&gt;<verse eid="MAT 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11"/>Unga agɔr umbɔ agɛ, &lt;&lt;Ihwɛng abinkɛ aka awɔk aki Iyɛrhe afã aka adzaa ru umbi, bɔr asi iwea umbɔ. <verse eid="MAT 13:11"/><verse number="12" style="v" sid="MAT 13:12"/>Uwuruwi aka awe ru ihwihwɛng awuri itomuwe unga akpo arhɛrhɛ. Uwuruwi aka ashia, awuri iyɛse ungwɛ̃rhĩ ihwihwɛng ha unga aka awerangge. <verse eid="MAT 13:12"/><verse number="13" style="v" sid="MAT 13:13"/>Umum irherhuwe umbɔ arherhe nggu unyaka arherhe ubinkutsu,</para>
  <para style="q1" vid="MAT 13:13">&lt;&lt;Umbɔ awuri irhimbɔ,</para>
  <para style="q2" vid="MAT 13:13">bɔr asi ínyãmbɔ,</para>
  <para style="q1" vid="MAT 13:13">na awuri igũmbɔ,</para>
  <para style="q2" vid="MAT 13:13">bɔr asi íhwɛngmbɔ.<verse eid="MAT 13:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 13:14"/>Irhɛm uwuku usɔm Arherhu-Num Uishaya iki itsuifɛrngge ra atsimbɔ. Iki igɔr igɛ,</para>
  <para style="q1" vid="MAT 13:14">&lt;&lt; &lt;Umbi awuri igũmbi</para>
  <para style="q2" vid="MAT 13:14">na asi íhwɛngmbi,</para>
  <para style="q1" vid="MAT 13:14">umbi awuri irhimbi</para>
  <para style="q2" vid="MAT 13:14">na asi ínyãmbi.<verse eid="MAT 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15"/>Ubinkutsu, amɛn anera abɛrɛ awe akerketake,</para>
  <para style="q2" vid="MAT 13:15">aghong umbɔ agũ nggu atombɔ,</para>
  <para style="q2" vid="MAT 13:15">aka abvurkumbɔ asumbɔ.</para>
  <para style="q1" vid="MAT 13:15">Iba isi iwengge rimi, umbɔ awuri anyãmbɔ nggu asumbɔ,</para>
  <para style="q2" vid="MAT 13:15">umbɔ awuri igũmbɔ nggu atombɔ,</para>
  <para style="q2" vid="MAT 13:15">na ahwɛngmbɔ nggu amɛnmbɔ,</para>
  <para style="q1" vid="MAT 13:15">na adzipa aba ru umum ikerhuwe umbɔ.&gt;<note caller="+" style="f"><char style="fr" closed="false">13.15 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="ISA 6:9">Uish 6.9</ref>,<ref loc="ISA 6:10">10</ref></char>.</note><verse eid="MAT 13:15"/></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16"/>Bɔr idorh iwe iyi asumbi ubinkutsu, ake adɛ̃ɛ̃ anyãke, nu atombi ubinkutsu ake adɛ̃ɛ̃ agũke. <verse eid="MAT 13:16"/><verse number="17" style="v" sid="MAT 13:17"/>Umum indɛyiwa umbi idzidzɛrhe, abika asɔm Arherhu-Num nu abika arhurhika arhɛrhɛ aka abee inyã ubinkpi umbi aka anyã bɔr asi inyãmbɔ, use agũ ubinkpi umbi aka agũ, bɔr asi igũmbɔ.<verse eid="MAT 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18"/>&lt;&lt;Àka akpeto na agũ agben unyaka arherhe uner uwuku unna ikpũ abin hã. <verse eid="MAT 13:18"/><verse number="19" style="v" sid="MAT 13:19"/>Ivangyɛ ubɛn unera aka agũ arherhe Iyɛrhe afã na asi ihwɛnga ake, Undenggũ unga aka isaka aba avur ubinkpi umbɔ aka adoi ra amɛnnga. Iwu ikpũ iyiki igba ru utsĩndĩ. <verse eid="MAT 13:19"/><verse number="20" style="v" sid="MAT 13:20"/>Iyiriyɛ iki igba ra ukpɔrha, iwe ru nyaku uwuku ugũ arherhe ha na ayɛi nggu anggɔm. <verse eid="MAT 13:20"/><verse number="21" style="v" sid="MAT 13:21"/>Bɔr unga aka ashia ra anũnang, asi idãrhũnga. Ivang arherhe ha aki ikũ uver nggu ayetnum uba, unga awuri izĩ ra andzing. <verse eid="MAT 13:21"/><verse number="22" style="v" sid="MAT 13:22"/>Iyiriyɛ iki igba ra anang ididɔk ngge iwe ru nyaku uwuku ugũ arherhe ha, bɔr iwãrhãna abin upfung ri ibee iwe ru ubin ibɛrh ni ikɛnngge arherhe ha ighwɛr ikpũrhã. <verse eid="MAT 13:22"/><verse number="23" style="v" sid="MAT 13:23"/>Bɔr iyiriyɛ iki igba ra abĩ aka aze iwe ru nyaku uwuku ugũ arherha ha na ahwɛnga ake. Unga aghwɛr ikpũrhã, ananaka, isɔka utɔ̃tɔ̃ĩ, use isɔka itaitaar idikunga nggu ubinkpi umbɔ aka adoi.&gt;&gt;<verse eid="MAT 13:23"/></para>
  <para style="s1">Unyaka arherhe ubĩĩ ri itsem</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24"/>Uyesu abvui adzowe umbɔ unyaka arherhe akɔɔ agɛ, &lt;&lt;Iyɛrhe afã iwu ru nyaku unerwi aka anna ikpũ iyiki ize ri icangnga. <verse eid="MAT 13:24"/><verse number="25" style="v" sid="MAT 13:25"/>Bɔr ivangyɛ anera kishoo aka awu ru urhɔ, unggamtsaknga azĩ adoi ikpũ ubĩĩ ri icang itsem hã na azĩã. <verse eid="MAT 13:25"/><verse number="26" style="v" sid="MAT 13:26"/>Ivangyɛ ikpũ abin hã iki imɛr, umɔ ubĩĩ igakpɔ umɛr.<verse eid="MAT 13:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27"/>&lt;&lt;Agãrhũ uner icang hã aba agɔr unga agɛ, &lt;A uteiya, ungo usi idosɔ ikpũ iyiki ize ri icangngo? Ubĩĩ udzekɛ ukpɔ?&gt;<verse eid="MAT 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28"/>&lt;&lt;Unga agɛ, &lt;Awu unggamtsakmum unga akorha aki ha.&gt;</para>
  <para style="p" vid="MAT 13:28">&lt;&lt;Agãrhã ha agɛ, &lt;Ungo ubeengo umɛn izĩ izɔnge ubĩã hã?&gt;<verse eid="MAT 13:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29"/>&lt;&lt;Unga agɛ, &lt;Ĩ'ĩ, ubinkutsu, umbi aba awuri izɔngmbi ubĩĩ ri itsem hã, umbi adɛ̃ɛ̃ abvurhkumbi itsema nggu ubĩã hã. <verse eid="MAT 13:29"/><verse number="30" style="v" sid="MAT 13:30"/>Àka aneke ake aseng urhɔnga utsɛku ivang iyiki ititeng. Ri ivang hã umum iwuri ĩdɛyikũ abi aka ateng hã, umbɔ agbaashia ateng ubĩã hã apfuma, aboyi atsã atsã, umbɔ akpĩĩwe, bɔr akarhi itsema aba atsuku ungbanmum.&gt; &gt;&gt;<verse eid="MAT 13:30"/></para>
  <para style="s1">Unyaka arherhe ishaa ikpũ iyiki ici</para>
  <para style="r">(<ref loc="MRK 4:30-32">Umar 4.30-32</ref>; <ref loc="LUK 13:18-19">Irh 13.18-19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31"/>Unga abvui adɛyiwe umbɔ unyaka arherhe akɔɔ agɛ, &lt;&lt;Iyɛrhe afã iwe ru nyaki ishaa ikpũ iyiki ici, utsa uwɔɔ aka anyanga adoi ri icangnga. <verse eid="MAT 13:31"/><verse number="32" style="v" sid="MAT 13:32"/>Ngge iwu iyiki icia ri ikpũ abin, bɔr ngge iki imɛr iseng, ngge iwu ucucii uwuku ugɔng, anunu akang ashiyake ra aboka.&gt;&gt;<verse eid="MAT 13:32"/></para>
  <para style="s1">Unyaka arherhe aki uga</para>
  <para style="r">(<ref loc="LUK 13:20-21">Irh 13.20-21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33"/>Unga abvui adzowe umbɔ unyaka arherhe akɔɔ agɛ, &lt;&lt;Iyɛrhe afã iwu ru nyaku ungwɛ̃rhũ uga ukutsɛrh aka akayi nggu agbiu isɔka ivaa aki akɔ̃ abvurh, umgbɔ ufuyiwe kishoo agbiu ha.&gt;&gt;<verse eid="MAT 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34"/>Uyesu adɛyiwe ikikɔng anera kishoo abin akɛrɛ nggu unyaka arherhe. Unga asi irherhunga ubin ukpɔɔ umɔ uku usi iwekpɔ unyaka arherhe. <verse eid="MAT 13:34"/><verse number="35" style="v" sid="MAT 13:35"/>Ngge itsuifɛr ubin uwuku usɔm Arherhu-Num aka arherhe agɛ,</para>
  <para style="q1" vid="MAT 13:35">&lt;&lt;Umum irherha arherhe nggu unyaka arherhe,</para>
  <para style="q2" vid="MAT 13:35">abinkɛ aka awɔk utirhi ri imimunu upfung.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">13.35 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="PSA 78:2">Amb 78.2</ref></char>.</note><verse eid="MAT 13:35"/></para>
  <para style="s1">Agben unyaka arherhe <optbreak/> ubĩĩ ru itsem</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36"/>Mɔcɛ unga abɔre ikikɔng anera na atsĩã ri iya. Angwɛ̃ imesanga aba agɔr unga agɛ, &lt;&lt;Udɛyiwa umɛn agben unyaka arherhe ubĩĩ ri icang itsem.&gt;&gt;<verse eid="MAT 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37"/>Unga agɛ, &lt;&lt;Uwuruwi aka adoi ikpũ iyiki ize awu Ungwɛ̃-Ner. <verse eid="MAT 13:37"/><verse number="38" style="v" sid="MAT 13:38"/>Icang hã ngge iwe upfung, ikpũ iyiki ize ha iwe angwɛ̃ Iyɛrhe afã. Ubĩĩ uwe angwɛ̃ Undenggũ. <verse eid="MAT 13:38"/><verse number="39" style="v" sid="MAT 13:39"/>Nu unggamtsak uwuku udoi ubĩĩ hã, awu Undenggũ. Ivang iyiki iteng hã, awe imimaa upfung, abika atuteng hã awe ípfu itser-Num.<verse eid="MAT 13:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40"/>&lt;&lt;Ru nyaka umbɔ iki ikarhu ubĩĩ akpĩĩwe ru urha, iwuri iwe rimi ri imimaa upfung. <verse eid="MAT 13:40"/><verse number="41" style="v" sid="MAT 13:41"/>Ungwɛ̃-Ner awuri idene ípfu itsernga ngge idze, iwuri ikpotuwe Iyɛrhe afãnga ubɛn ubin uku utsu igba ra arhim nu kishoo abika akorhi iyiki ibewe. <verse eid="MAT 13:41"/><verse number="42" style="v" sid="MAT 13:42"/>Umbɔ awuri itare abika abewunga ri ikon urha, ra anangkɛ umbɔ aka iciu akpe na atãi anyĩ. <verse eid="MAT 13:42"/><verse number="43" style="v" sid="MAT 13:43"/>Mɔcɛ abika arhika awuri irhang ru nyaki ishaa unum ri Iyɛrhe Utɛmbɔ. Unga uwuku awe ra ato, neke unga agũ.<verse eid="MAT 13:43"/></para>
  <para style="s1">Unyaka arherhe abin <optbreak/> ugarh ri iwɔk</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44"/>&lt;&lt;Iyɛrhe afã iwu ru nyaka abin ugarh aka awɔk ri icang. Ivangyɛ unera aka akpo ake, unga awɔke ake ikɛi, agɔm na azĩ agoshe kishoo abinnga na agoi icang hã.<verse eid="MAT 13:44"/></para>
  <para style="s1">Unyaka arherhe utarh ukpuku <optbreak/> uwe ru ugarh</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45"/>&lt;&lt;Iyɛrhe afã iwu ru nyaku uner igoi uwuku ubee atarhkɛ aka awu ru ugarh. <verse eid="MAT 13:45"/><verse number="46" style="v" sid="MAT 13:46"/>Ivangyɛ unga aka akpo utarh ugarh ha akarhãrhã, unga azĩ agoshuka kishoo abinkɛ unga aka awe ra ake na agoi utarh ugarh ha.<verse eid="MAT 13:46"/></para>
  <para style="s1">Unyaka arherhe itang igber</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47"/>&lt;&lt;Iyɛrhe afã iwe ru nyaki itang igber iyiki idzui abɛrh. Umbɔ iki itang ru ukau ukugɔng ngge idzui kishoo ikpũ abɛrh. <verse eid="MAT 13:47"/><verse number="48" style="v" sid="MAT 13:48"/>Ivangyɛ ngge iki itɔk, abi udɛm agbiir azĩ ru ubang ukau ukugɔng hã. Mɔcɛ umbɔ asei na atɛng abɛrh aka azea atsuku uzing na atare akika abewe. <verse eid="MAT 13:48"/><verse number="49" style="v" sid="MAT 13:49"/>Iwuri iwe rimi ri imimashu upfung. Ípfu itser-Num iwuri iba igashuwe abika abewe nggu abika arhurhika. <verse eid="MAT 13:49"/><verse number="50" style="v" sid="MAT 13:50"/>Umbɔ awuri itare abika abewunga ri ikon urha, ra anangkɛ umbɔ aka iciu akpe na atãi anyĩ.&gt;&gt;<verse eid="MAT 13:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51"/>Uyesu arhusa agɛ, &lt;&lt;Umbi ahwɛngmbi akɛrɛ ha kishoo?&gt;&gt;</para>
  <para style="p" vid="MAT 13:51">Umbɔ agɛ, &lt;&lt;Ĩĩ.&gt;&gt;<verse eid="MAT 13:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52"/>Unga agɔr umbɔ agɛ, &lt;&lt;Nggee ubɛn uwuku umesuwe Ikpem umbɔ aka adɛyiwe unga Iyɛrhe afã, awe ru nyaku utei iya aka akũ abin adzeka ru angbannga aka afa nu aka agbe.&gt;&gt;<verse eid="MAT 13:52"/></para>
  <para style="s1">Akpɛ̃mbɔ Uyesu ru Unazarat</para>
  <para style="r">(<ref loc="MRK 6:1-6">Umar 6.1-6</ref>; <ref loc="LUK 4:16-30">Irh 4.16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53"/>Ivangyɛ Uyesu aka amaa unyaka arherhe akɛrɛ, unga abɔruka anang hã. <verse eid="MAT 13:53"/><verse number="54" style="v" sid="MAT 13:54"/>Ivangyɛ unga aka aba utepunga, unga atirhi imesuwe anera ru ubã ifɛn-Nummbɔ. Umbɔ adzeidzeu na arhusa agɛ, &lt;&lt;Utsak uwurɛ akpo itsoi iyɛrɛ rinɛɛ rimi nu ijee iyiki ikorha abin idzeu? <verse eid="MAT 13:54"/><verse number="55" style="v" sid="MAT 13:55"/>Asi iwea uwɛrɛ ha awu ungwɛ̃ ukapinta ha? Asi iwea uyanga umbɔ iki iyisa Umaryamu? Asi iwea angwɛ̃mbɔ rabɛ, umbɔ Uyaku nu Uyusuf nu Usiman nu Uyahuda? <verse eid="MAT 13:55"/><verse number="56" style="v" sid="MAT 13:56"/>Asi iwea kishoo anapumbɔ rabɛ nggu umɛn? Awu rinɛɛ unga aka akpo kishoo abin akɛrɛ ha?&gt;&gt; <verse eid="MAT 13:56"/><verse number="57" style="v" sid="MAT 13:57"/>Mɔcɛ umbɔ agũ avɔm nggu unga.</para>
  <para style="p" vid="MAT 13:57">Bɔr Uyesu agɔr umbɔ agɛ, &lt;&lt;Awu ru ubɛn unera aka adzowe uner uwuku usɔm Arherhu-Num igɔng, bɔr asi iwea abi utepunga, nu abi iyanga.&gt;&gt;<verse eid="MAT 13:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58"/>Awu ida imangmangmbɔ itsu unga asi ikorhunga abin idzeu arhɛrhɛ nggɔɔ ha.<verse eid="MAT 13:58"/></para>
  <chapter eid="MAT 13"/>
  <chapter number="14" style="c" sid="MAT 14"/>
  <para style="s1">Akpe Uyohana Uner Ubɔtisima</para>
  <para style="r">(<ref loc="MRK 6:14-29">Umar 6.14-29</ref>; <ref loc="LUK 9:7-9">Irh 9.7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1"/>Ri ivang hã Uyɛrhe Uhiridu aka agũ arherhe ri itsi Uyesu. <verse eid="MAT 14:1"/><verse number="2" style="v" sid="MAT 14:2"/>Unga agɔr abika atɔ̃we unga itser agɛ, &lt;&lt;Awu Uyohana Uner Ubɔtisima unga asok ra akpe! Ngge itsu unga awuri ijee iyiki ikorha abin idzeu akɛrɛ.&gt;&gt;<verse eid="MAT 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3"/>Ubinkutsu Uhiridu aka adzur Uyohana agbang ru ugborzĩ ri itsi Uhirudiya utsɛrha ungwɛ̃mbɔ Ufirhibu. <verse eid="MAT 14:3"/><verse number="4" style="v" sid="MAT 14:4"/>Ubinkutsu Uyohana adɛyiwe Uhiridu agɛ, &lt;&lt;Isi imɛ̃ngge ungo uku upfunu Uhirudiya!&gt;&gt; <verse eid="MAT 14:4"/><verse number="5" style="v" sid="MAT 14:5"/>Uhiridu abee ifɛre Uyohana, bɔr agũ iwei anera, ubinkutsu umbɔ aka anyangu Uyohana awu uwuku usɔm Arherhu-Num.<verse eid="MAT 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6"/>Unum imar Uhiridu uku uba uwe, unapa Uhirudiya azer azer ri irhowa ha atsu Uhiridu agũibɛn akarhãrhã. <verse eid="MAT 14:6"/><verse number="7" style="v" sid="MAT 14:7"/>Nggee unga ayirh na abemuwe idzowe una hã kishoo ubinkpi unga aka ifɛna. <verse eid="MAT 14:7"/><verse number="8" style="v" sid="MAT 14:8"/>Uyisa una hã adzowe itsũwã, agɛ, &lt;&lt;Udzaa umum itsi Uyohana Uner Ubɔtisima ri itɛ̃rhãzɔu.&gt;&gt; <verse eid="MAT 14:8"/><verse number="9" style="v" sid="MAT 14:9"/>Amɛn uyɛrhe aghong, bɔr ri itsi atsen irhowa ha nu uyirh ha utsu unga atsu umbɔ adzowe ubinkpi una hã aka abee. <verse eid="MAT 14:9"/><verse number="10" style="v" sid="MAT 14:10"/>Unga adene umbɔ azĩ azharhukumbɔ itsi Uyohana ru ugborzĩ. <verse eid="MAT 14:10"/><verse number="11" style="v" sid="MAT 14:11"/>Akũ itsi ha nu itɛ̃rhãzɔu aba adzowe ru una hã, unga atsã akowuka uyanga. <verse eid="MAT 14:11"/><verse number="12" style="v" sid="MAT 14:12"/>Angwɛ̃ imesu Uyohana aba ashupu ukomnga adzake. Mɔcɛ umbɔ azĩ asɔme Uyesu.<verse eid="MAT 14:12"/></para>
  <para style="s1">Uyesu adzowe ubingha inera <optbreak/> anakagɔnga atɔ̃ɔ̃</para>
  <para style="r">(<ref loc="MRK 6:30-44">Umar 6.30-44</ref>; <ref loc="LUK 9:10-17">Irh 9.10-17</ref>; <ref loc="JHN 6:1-14">Uyoh 6.1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13"/>Ivang Uyesu aka agũ rimi, unga asok atsĩ ukhukhɔɔ amɛ̃ agar azĩã anangkɛ anera aka ashimbɔ awe ikiyikanga. Bɔr ikikɔng anera iki igũ rimi, umbɔ adzeka ri íteu adɔsa unga ra adak. <verse eid="MAT 14:13"/><verse number="14" style="v" sid="MAT 14:14"/>Ivangyɛ unga aka adzeku ukhukhɔɔ ha anyã anera aka akɔng arhɛrhɛ, unga agũ atorh umbɔ na akerhuwe abi irhãrhãmbɔ.<verse eid="MAT 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15"/>Urhɛɛ uku uwe, angwɛ̃ imesanga aba agɔr unga agɛ, &lt;&lt;Anang akɛrɛ ashike ru uner, nggayɛ urhɛɛ uku uwekpɔ. Usoyiwe ikikɔnga umbɔ azĩmbɔ, ngge itsú umbɔ atsĩ ri iteu azĩ agoi ubingha.&gt;&gt;<verse eid="MAT 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16"/>Uyesu agɛ, &lt;&lt;Isi imɛ̃ngge umbɔ azĩmbɔ. Àka adzowe umbɔ ubin umbɔ agha.&gt;&gt;<verse eid="MAT 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17"/>Umbɔ agɔr agɛ, &lt;&lt;Umɛn ikpurhi iwe ru ípo uborodi itɔ̃ɔ̃ nu abɛrh avaa.&gt;&gt;<verse eid="MAT 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18"/>Unga agɛ, &lt;&lt;Àka akũwã ake ru umum nggimi.&gt;&gt; <verse eid="MAT 14:18"/><verse number="19" style="v" sid="MAT 14:19"/>Na agɔr anera asei nu ubĩĩ. Unga anyangu ípo uborodi atɔ̃ɔ̃ hã na abɛrh ha ikivarhake. Abera asunga arhi afã, atar uwɛɛ ru Unum. Unga atsɔka adzowe ra angwɛ̃ imesanga, umbɔ agashuwe ra anera. <verse eid="MAT 14:19"/><verse number="20" style="v" sid="MAT 14:20"/>Umbɔ kishoo agha ashur, nu angwɛ̃ imesanga arhɔ̃yĩ awushunga. Ake atɔk azĩnga usɔkdũmɛn. <verse eid="MAT 14:20"/><verse number="21" style="v" sid="MAT 14:21"/>Irhɛɛ anera aka agha ubingha ha akatsak atsĩmbɔ anaka agɔnga atɔ̃ɔ̃, asi ivarhumbɔ akatsɛrh nu awɛkaci.<figure style="fig" alt="Fish and bread" file="gt00052.tif" size="col" loc="14.21" copy="Gordon Thompson" ref="14.21">Abɛrh nggu uborodi</figure><verse eid="MAT 14:21"/></para>
  <para style="s1">Uyesu azɛ̃rhũ uzɛ̃rhã nu amɛ̃</para>
  <para style="r">(<ref loc="MRK 6:45-52">Umar 6.45-52</ref>; <ref loc="JHN 6:15-21">Uyoh 6.15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22"/>Kanying Uyesu atsu angwɛ̃ imesanga abɔre unga na atsĩ ukhukhɔɔ amɛ̃ agbaashia azĩmbɔ ugar ukpɔrɔ. Unga asoyiwe ikikɔnga. <verse eid="MAT 14:22"/><verse number="23" style="v" sid="MAT 14:23"/>Unga aka asoyiwe umbɔ amaa, unga afũã ni itsi igũa ikiyikanga azĩã ifɛn-Num. Urhɛɛ uwekpɔ, unga awe ru nggɔɔ ha ikiyikanga. <verse eid="MAT 14:23"/><verse number="24" style="v" sid="MAT 14:24"/>Ri ivang hã ukhukhɔɔ ha uku uzĩ udermgbɔ ru ukau ukugɔng hã, ugba unyaikpɔ utsu amɛ̃ uni ikwɛr umgbɔ.<verse eid="MAT 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25"/>Ivanga iwu akara ataar aki utsuu, umbɔ anyã Uyesu aka azɛ̃rhã nu amɛ̃ ukau ukugɔng azĩã ru umbɔ. <verse eid="MAT 14:25"/><verse number="26" style="v" sid="MAT 14:26"/>Ivang angwɛ̃ imesanga aka anyã unga azɛ̃rhã nu afafã amɛ̃, umbɔ agũ iwei. Agɛ, &lt;&lt;Awu imãrhã!&gt;&gt; Atsu ivum iwei iki ifɛrmbɔ.<verse eid="MAT 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27"/>Kanying Uyesu agɔr umbɔ agɛ, &lt;&lt;Àka aker amɛnmbi! Awu umum. Niba agũmbi iwei.&gt;&gt;<verse eid="MAT 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28"/>Mɔcɛ Ubitru agɔr unga agɛ, &lt;&lt;A Uteijee, aba awu ungo, utsu umum izɛ̃rhã nu afafã amɛ̃ ĩba ru ungo.&gt;&gt;<verse eid="MAT 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29"/>Uyesu agɛ, &lt;&lt;Uba.&gt;&gt;</para>
  <para style="p" vid="MAT 14:29">Mɔcɛ Ubitru adzeku ukhukhɔɔ ha, atirhu uzɛ̃rhã nu afafã amɛ̃ azĩã ru Uyesu. <verse eid="MAT 14:29"/><verse number="30" style="v" sid="MAT 14:30"/>Bɔr unga aka anyã ugba, unga agũ iwei na atirhunga ididɛɛ. Unga atsu ivum, agɛ, &lt;&lt;A Uteijee, ufɔrh umum!&gt;&gt;<verse eid="MAT 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31"/>Kanying Uyesu anamu uboknga adzur unga, agɛ, &lt;&lt;Ungo uner imangmang iyiki ici, awu use utsu ungo ucang?&gt;&gt;<verse eid="MAT 14:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32"/>Ivangyɛ umbɔ aka atsĩ ukhukhɔɔ ha, ugba ha ukpe unu. <verse eid="MAT 14:32"/><verse number="33" style="v" sid="MAT 14:33"/>Mɔcɛ abirabɛ aka awe ru ukhukhɔɔ ha adzowe unga igɔng, agɛ, &lt;&lt;Idzidzɛrhe ungo uwu Ungwɛ̃ Unum.&gt;&gt;<verse eid="MAT 14:33"/></para>
  <para style="s1">Uyesu akerhuwe abi irhãrhã <optbreak/> ru Ujanisarat</para>
  <para style="r">(<ref loc="MRK 6:53-56">Umar 6.53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34"/>Ivangyɛ umbɔ aka agar ukau ha, umbɔ acipa ru abĩ Ujanisarat. <verse eid="MAT 14:34"/><verse number="35" style="v" sid="MAT 14:35"/>Aner ha ahwɛngmbɔ ugɛ Uyesu awu umɔ, umbɔ adene umbɔ adɛyiwe anera aka awu ra abĩ hã. Umbɔ akũ kishoo abi irhãrhã aba ru unga. <verse eid="MAT 14:35"/><verse number="36" style="v" sid="MAT 14:36"/>Umbɔ ashɔ̃rhã unga aneke abi irhãrhã amaa abangu ifɛn atorho akagɔnga. Nu kishoo abirabɛ aka abanga ake, akerhumbɔ.<verse eid="MAT 14:36"/></para>
  <chapter eid="MAT 14"/>
  <chapter number="15" style="c" sid="MAT 15"/>
  <para style="s1">Isisar nu ida isisar</para>
  <para style="r">(<ref loc="MRK 7:1-13">Umar 7.1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1"/>Mɔcɛ abi Ufarisi abɔɔ nu abika amesuwe Ikpem adzeku Urusharhima aba ru Uyesu arhusa agɛ, <verse eid="MAT 15:1"/><verse number="2" style="v" sid="MAT 15:2"/>&lt;&lt;Awu use utsu angwɛ̃ imesango azharhuwe agbeyi atokamɛn? Asi isorhmbɔ abokmbɔ na adɔrha agha ubingha.&gt;&gt;<verse eid="MAT 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3"/>Bɔr Uyesu agɔr umbɔ agɛ, &lt;&lt;Awu use utsu agbeyambi atsu umbi azharhuwe Ikpem Unum? <verse eid="MAT 15:3"/><verse number="4" style="v" sid="MAT 15:4"/>Ubinkutsu Unum agɛ, &lt;Udzowe imor ru utɛngo nu uyango,&gt;<note caller="+" style="f"><char style="fr" closed="false">15.4 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="EXO 20:12">Idzi 20.12</ref>; <ref loc="DEU 5:16">Iva 5.16</ref></char>.</note> nu &lt;Ubɛn unera aka arhenu utɛnga use uyanga awu ufang umbɔ afɛre unga.&gt;<note caller="+" style="f"><char style="fr" closed="false">15.4 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="EXO 21:17">Idzi 21.17</ref>; <ref loc="LEV 20:9">Urha 20.9</ref></char>.</note> <verse eid="MAT 15:4"/><verse number="5" style="v" sid="MAT 15:5"/>Bɔr umbi amesuwe ugɛ ubɛn unera aba awea ru ubinkpi unga aka iyike utɛnga use uyanga, na adɛ̃ɛ̃ agɔr umbɔ agɛ, &lt;Ubin hã uwu izũwã iyi Unum.&gt; <verse eid="MAT 15:5"/><verse number="6" style="v" sid="MAT 15:6"/>Rimi hã umbi agɛ asi iwea ufang unga idzowe imor utɛnga nggu ukpɔ. Agbeyambi atsu umbi anyanga Arherhu-Num awe ibɛm. <verse eid="MAT 15:6"/><verse number="7" style="v" sid="MAT 15:7"/>Umbi abi ukpukpeta! Irhikungge uwuku usɔm Arherhu-Num Uishaya aka asɔm arherhe ri itsimbi agɛ,<verse eid="MAT 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8"/>&lt;&lt; &lt;Aner abɛrɛ adzaa umum igɔng nggu angwĩmbɔ ukpekũ,</para>
  <para style="q2" vid="MAT 15:8">bɔr amɛnmbɔ aderke nggu umum.<verse eid="MAT 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9"/>Umbɔ adzaa umum igɔng ibɛm,</para>
  <para style="q2" vid="MAT 15:9">anu imesuwe ikpem anera ugɛɛ Unum adzowe umbɔ.&gt; <note caller="+" style="f"><char style="fr" closed="false">15.9 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="ISA 29:13">Uish 29.13</ref></char>.</note>&gt;&gt;<verse eid="MAT 15:9"/></para>
  <para style="s1">Abinkɛ aka awuri itsu ida isisar</para>
  <para style="r">(<ref loc="MRK 7:14-23">Umar 7.14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10"/>Uyesu ayisi ikikɔnga iba ru unga agɔr umbɔ agɛ, &lt;&lt;Àka akpeto na ahwɛng. <verse eid="MAT 15:10"/><verse number="11" style="v" sid="MAT 15:11"/>Asi iwea ubinkpi iki itsĩ ra angwĩ unera itsu unga asi isara, bɔr ubinkpi uku idzeka ra angwĩnga, ukpɔɔ utsu unga &lt;asi isara.&gt; &gt;&gt;<verse eid="MAT 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12"/>Mɔcɛ angwɛ̃ imesanga aba ru unga arhusa agɛ, &lt;&lt;Ungo uhwɛngngo abi Ufarisi agũ avɔm umbɔ aka agũ arherha akɛrɛ?&gt;&gt;<verse eid="MAT 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13"/>Unga agɛ, &lt;&lt;Ubɛn ubinkpi Utɛmum ra afã aka asi idosa, awuri ibvurhuwe. <verse eid="MAT 15:13"/><verse number="14" style="v" sid="MAT 15:14"/>Àka aneke umbɔ, umbɔ awu abi ibvuta abika adarh abi ibvuta. Uner ibvuta aba adarha uner ibvuta, umbɔ ikivarhambɔ awuri igba ru ughwee.&gt;&gt;<verse eid="MAT 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15"/>Ubitru agɔr unga agɛ, &lt;&lt;Usɔma umɛn agben unyaka arherhe ha.&gt;&gt;<verse eid="MAT 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16"/>Mɔcɛ Uyesu agɛ, &lt;&lt;Umbi anasi ihwɛngmbi? <verse eid="MAT 15:16"/><verse number="17" style="v" sid="MAT 15:17"/>Umbi asi ihwɛngmbi ubɛn ubinkpi uku utsĩ ra angwĩ unera, utsĩ ra ananga nu udzekpɔ ri iyornga? <verse eid="MAT 15:17"/><verse number="18" style="v" sid="MAT 15:18"/>Bɔr ubinkpi uku idzeka ra angwĩ, udzeka ra amɛnnga, ukpɔɔ ha utsu unera asi isara. <verse eid="MAT 15:18"/><verse number="19" style="v" sid="MAT 15:19"/>Ubinkutsu, ifɛrhkɔ iyiki ibewe iki isaki idzeyiwa ra amɛn unera, ifɛr uner, itoma-dak, iyiki itãrhã, ivɛu, igbɛrangwĩ, nu idakuwe itsok unera. <verse eid="MAT 15:19"/><verse number="20" style="v" sid="MAT 15:20"/>Akɛrɛ atsu unera asi isara, bɔr igha ubin nggu abok aka ada isisorh asi ítsu unera asi isara.&gt;&gt;<verse eid="MAT 15:20"/></para>
  <para style="s1">Imangmang utsɛrh uwɔɔ</para>
  <para style="r">(<ref loc="MRK 7:24-30">Umar 7.24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21"/>Uyesu aka abɔre anang hã na azĩã abĩ Utaya nu Usidon. <verse eid="MAT 15:21"/><verse number="22" style="v" sid="MAT 15:22"/>Utsɛrh Ukan'ana aka asei ra abĩ hã aba ru unga, na atsarhi irhaknga agɛ, &lt;&lt;Ucorhuwa umum! Uteijee, Ungwɛ̃ Udauda, ipfu iyiki ibewe inu idzowe unapmum uver.&gt;&gt;<verse eid="MAT 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23"/>Uyesu asi iyanuka urhɛm. Nggee angwɛ̃ imesanga aba ashɔ̃rhã unga agɛ, &lt;&lt;Udene unga azĩã, ubinkutsu arharuwe atomɛn nggu ivum adɔsa umɛn.&gt;&gt;<verse eid="MAT 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24"/>Mɔcɛ Uyesu agɔr utsɛrh ha agɛ, &lt;&lt;Adena umum ri ídɔi Uisrairha iki igwir ukpekũ.&gt;&gt;<verse eid="MAT 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25"/>Bɔr utsɛrh ha aba atararhu ru unga, agɛ, &lt;&lt;A Uteijee, uma uyika umum!&gt;&gt;<verse eid="MAT 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26"/>Uyesu agɛ, &lt;&lt;Isi irhikungge umbɔ anyangu ubingha awɛkaci atsuke íjui.&gt;&gt;<verse eid="MAT 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27"/>Unga agɛ, &lt;&lt;Ĩĩ, Uteijee, bɔr íjui iki isaki ighangge awushu ubingha aki idzeku utebur iyi uteiya agbei nu abĩ.&gt;&gt;<verse eid="MAT 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28"/>Mɔcɛ Uyesu agɔr unga agɛ, &lt;&lt;A atsɛrh ha, imangmango iwe akarhãrhã! Ibibeeango ikpongge.&gt;&gt; Kanying unapunga akerhunga.<verse eid="MAT 15:28"/></para>
  <para style="s1">Uyesu akerhuwe anera arhɛrhɛ</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29"/>Uyesu abɔre umɔ na adɔsu udiku ubang Ukau Ugarhirhi. Mɔcɛ unga afũ igũ aseisa. <verse eid="MAT 15:29"/><verse number="30" style="v" sid="MAT 15:30"/>Nggaa ikikɔng iba ru unga, akũ akatarhu, nu abi ibvuta, nu abika akaikai, nu abika afɔr arherhe adambɔ, nu abɔɔ arhɛrhɛ, aden umbɔ ra adaknga, nu unga akerhuwe umbɔ. <verse eid="MAT 15:30"/><verse number="31" style="v" sid="MAT 15:31"/>Anera adzeidzeu umbɔ aka anyã agbau arherha arherhe, abika akaikai ayormbɔ akerhuke, akatarhu azɛ̃rhũmbɔ uzɛ̃rhã, abi ibvuta anyãmbɔ. Nu umbɔ kishoo akpoi Unum uwu Uisrairha.<verse eid="MAT 15:31"/></para>
  <para style="s1">Uyesu afuka anera <optbreak/> anakagɔnga anaa</para>
  <para style="r">(<ref loc="MRK 8:1-10">Umar 8.1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32"/>Uyesu ayisa angwɛ̃ imesanga aba ru unga na agɛ, &lt;&lt;Umum icorhuwe aner abɛrɛ. Awu unum untaar nukpi umbɔ aka awe nggu umum ashimbɔ ru ubingha. Umum isi ĩbeemum isoyiwe umbɔ nggu imerh, utsur umbɔ agbeimbɔ ru udĩ.&gt;&gt;<verse eid="MAT 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33"/>Angwɛ̃ imesanga agɛ, &lt;&lt;Umɛn ikpo ubingha ri inɛɛ ra arhum akɛrɛ uku imɛ̃ ifuka arhɛrha anera abɛrɛ?&gt;&gt;<verse eid="MAT 15:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34"/>Uyesu arhusa umbɔ agɛ, &lt;&lt;Umbi awe ru ípo uborodi isong?&gt;&gt;</para>
  <para style="p" vid="MAT 15:34">Umbɔ agɛ, &lt;&lt;Utɔɔva nu ungwɛ̃rhã abɛrh ukunjiir.&gt;&gt;<verse eid="MAT 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35"/>Unga atsu ikikɔnga iseisa abĩ. <verse eid="MAT 15:35"/><verse number="36" style="v" sid="MAT 15:36"/>Mɔcɛ unga anyangu ípo uborodi ha utɔɔva nu abɛrh ha, unga aka atar uwɛɛ ru Unum. Mɔcɛ na atsɔka ukpɔ adzowe angwɛ̃ imesanga, umbɔ agashuwe ikikɔng anera. <verse eid="MAT 15:36"/><verse number="37" style="v" sid="MAT 15:37"/>Kishoo agha ashur. Angwɛ̃ imesanga arhɔ̃yĩ awushunga ra abĩ ake atɔk azĩnga utɔɔva. <verse eid="MAT 15:37"/><verse number="38" style="v" sid="MAT 15:38"/>Abirabɛ aka agha akatsak awu anakagɔnga anaa, asi ivarhumbɔ akatsɛrh nu awɛkaci. <verse eid="MAT 15:38"/><verse number="39" style="v" sid="MAT 15:39"/>Uyesu aka asoyiwe ikikɔng anera amaa, unga atsĩ ukhukhɔɔ amɛ̃ azĩã abĩ Umagadan.<verse eid="MAT 15:39"/></para>
  <chapter eid="MAT 15"/>
  <chapter number="16" style="c" sid="MAT 16"/>
  <para style="s1">Umbɔ abee utsar</para>
  <para style="r">(<ref loc="MRK 8:11-13">Umar 8.11-13</ref>; <ref loc="LUK 12:54-56">Irh 12.54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1"/>Abi Ufarisi nu abi Usaduki aba aviru Uyesu, arhusa unga ugɛ unga akorhu ubin idzeu ukpu uwu utsar uku udzeka afã.<verse eid="MAT 16:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2"/>Unga agɛ, &lt;&lt;Urhɛɛ uba uwekpɔ, umbi aka isaka agɔr agɛ, &lt;Ananga awuri izeke udã, afã awe uku uzhããĩ.&gt; <verse eid="MAT 16:2"/><verse number="3" style="v" sid="MAT 16:3"/>Nu unkpeeka umbi aba anyã afã awe uku uzhããĩ na atsir nggu ufin inai, umbi aka isaka agɔr agɛ, &lt;Irherɛ inai iwuri idoingge.&gt; Umbi adɛ̃ɛ̃ ahwɛngmbi agben afã, bɔr umbi asi ihwɛngmbi atsarkɛ aka idɛyiwe agben abinkɛ aka anu ikorhe inum iyɛrɛ. <verse eid="MAT 16:3"/><verse number="4" style="v" sid="MAT 16:4"/>Abika abewe, abika asheru Unum, abi undan ukpirɛ arhusu utsar idzeu! Bɔr asi ídɛyikumbɔ umbɔ utsar, akpurha adɛyiwe utsar ukpu uwuku usɔm Arherhu-Num Uyunana.&gt;&gt; Uyesu abɔre umbɔ na azĩã.<verse eid="MAT 16:4"/></para>
  <para style="s1">Uga abi Ufarisi nu uwu <optbreak/> abi Usaduki</para>
  <para style="r">(<ref loc="MRK 8:14-21">Umar 8.14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5"/>Ivangyɛ umbɔ aka agar ukau ha, angwɛ̃ imesa ayirukumbɔ ikpɔm uborodi. <verse eid="MAT 16:5"/><verse number="6" style="v" sid="MAT 16:6"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Àka angwɛ̃dzɛn, àka akpɔm amɛnmbi nggu uga abi Ufarisi nu abi Usaduki.&gt;&gt;<verse eid="MAT 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7"/>Umbɔ arherhe nggu adɔkambɔ agɛ, &lt;&lt;Unga arherhe rimi ubinkutsu, awu umɛn iki isi ikpɔmmɛn uborodi.&gt;&gt;<verse eid="MAT 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8"/>Uyesu ahwɛnga ubinkpi umbɔ aka anu irherhe unga arhusa agɛ, &lt;&lt;Umbi abi imangmang iyiki ici, awu use utsu umbi arherhe nggu adɔka ugɛ umbi ashimbi ru uborodi? <verse eid="MAT 16:8"/><verse number="9" style="v" sid="MAT 16:9"/>Utsɛku icɛrɛ umbi anasi ihwɛngmbi? Umbi aka ayirukumbi umum iki ikũ ípo uborodi itɔ̃ɔ̃ ifuka anera anakagɔnga atɔ̃ɔ̃? Azĩnga asong umbi aka arhɔ̃yĩ atɔk? <verse eid="MAT 16:9"/><verse number="10" style="v" sid="MAT 16:10"/>Ikɛi ípo uborodi utɔɔva uku uwe ubingha anera anakagɔnga anaa. Azĩnga asong umbi aka arhɔ̃yĩ atɔk? <verse eid="MAT 16:10"/><verse number="11" style="v" sid="MAT 16:11"/>Awu use utsu umbi asi idɛ̃ɛ̃ ahwɛngmbi ugɛ umum isi irherhumum arherhe uborodi? Umum igɔr ugɛ àka akpɔm amɛnmbi nggu uga abi Ufarisi nu abi Usaduki.&gt;&gt; <verse eid="MAT 16:11"/><verse number="12" style="v" sid="MAT 16:12"/>Mɔcɛ umbɔ aka ahwɛng ugɛ asi igɔra umbɔ ikpɔm amɛn ru uga uborodi, bɔr agɔr umbɔ ikpɔm amɛn ri imesa abi Ufarisi nu abi Usaduki.<verse eid="MAT 16:12"/></para>
  <para style="s1">Ubitru adekuwe Uyesu <optbreak/> unga awu Ukiristo</para>
  <para style="r">(<ref loc="MRK 8:27-30">Umar 8.27-30</ref>; <ref loc="LUK 9:18-21">Irh 9.18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13"/>Ivangyɛ Uyesu aka aba ra abĩ abi Ukaisariya Ufirhibi, unga arhusa angwɛ̃ imesanga agɛ, &lt;&lt;Anera ani igɔr ugɛ Ungwɛ̃-Ner awu ungamɔ?&gt;&gt;<verse eid="MAT 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14"/>Umbɔ agɛ, &lt;&lt;Abɔɔ agɔr ugɛ Uyohana Uner Ubɔtisima, abɔɔ agɛ Uirhiya, abɔɔ agɛ Uirimiya use uwɔɔ ra abika asɔm Arherhu-Num.&gt;&gt;<verse eid="MAT 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15"/>Unga arhusa umbɔ agɛ, &lt;&lt;Bɔr umbi agɔr ugɛ umum iwu ungamɔ?&gt;&gt;<verse eid="MAT 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16"/>Ubitru agɛ, &lt;&lt;Ungo uwu Ukiristo Ungwɛ̃ Unum uwu urhɛ.&gt;&gt;<verse eid="MAT 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17"/>Uyesu agɔr unga agɛ, &lt;&lt;Ungo uwu uner idorh, Usiman ungwɛ̃ Ujona! Asi iwea unera adɛyiwa ungo akɛrɛ ha, awu Utɛmum uwuku uwe ra afã. <verse eid="MAT 16:17"/><verse number="18" style="v" sid="MAT 16:18"/>Umum idɛyiwa ungo ugɛ ungo uwu Ubitru, agbena agɛ ifa. Nu ifa iyɛrɛ umum iki idzin ikikɔng abika adɔsa, iyiriyɛ ijee akpe isi ínangge ingge. <verse eid="MAT 16:18"/><verse number="19" style="v" sid="MAT 16:19"/>Umum iwuri ĩdzaamum ungo ijee iki idzeki Iyɛrhe afã. Ubɛn ubinkpi ungo iki ibow ru upfung, awuri ibow ukpɔ ra afã. Ubɛn ubinkpi ungo iki igarhuwe ru upfung, awuri igarhuwe ukpɔ ra afã.&gt;&gt; <verse eid="MAT 16:19"/><verse number="20" style="v" sid="MAT 16:20"/>Mɔcɛ unga agbiite ato angwɛ̃ imesanga utsur umbɔ adɛyikumbɔ unera agɛ unga awu Ukiristo.<verse eid="MAT 16:20"/></para>
  <para style="s1">Uyesu asɔm ikpũ akpenga aka ikpe</para>
  <para style="r">(<ref loc="MRK 8:31-9:1">Umar 8.31—9.1</ref>; <ref loc="LUK 9:22-27">Irh 9.22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21"/>Udzur ri ivang hã Uyesu atirhi idɛyiwe angwɛ̃ imesanga ugɛ awu ufang unga awuri izĩ Urusharhima na ahwa ayetnum ra abina arhɛrhɛ ru abok akakũ, nu ateiya abika adzowe idɛm-Num, nu abika amesuwe Ikpem. Awu ufang umbɔ afɛre unga, ru unum untaar unga awuri isok abɛka.<verse eid="MAT 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22"/>Ubitru agbiira unga azĩ ri ifɛna atirhi itsɛrha unga agɛ, &lt;&lt;Ishingge Uteijee! Akɛrɛ asi íkorhuke nggu ungo!&gt;&gt;<verse eid="MAT 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23"/>Uyesu adzipa agɔr Ubitru agɛ, &lt;&lt;Usɔkɔ ru umum Ushaitan! Ungo uwu utarh ukpuku ukwɛr itok ru umum, ifɛrhkɔngo iwe ru nyaki iyi anera, isi iwengge ru nyaki iyi Unum.&gt;&gt;<verse eid="MAT 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24"/>Mɔcɛ Uyesu agɔr angwɛ̃ imesanga agɛ, &lt;&lt;Uba unera abeenga idɔsa umum, awu ufang unga akpɛ̃ɛ̃ itsikamnga, na ashupu igãrhãmau ucuciianga adɔsa umum. <verse eid="MAT 16:24"/><verse number="25" style="v" sid="MAT 16:25"/>Ubɛn unerwi aka abee ifɔrh urhɛnga, umgbɔ uwuri igwirmgbɔ. Bɔr uwuku ugwirhuwe urhɛnga ru umum awuri ikpoa umgbɔ. <verse eid="MAT 16:25"/><verse number="26" style="v" sid="MAT 16:26"/>Awu use izea unera aki ikpo abin upfung kishoo na ashia ru urhɛ uwu ugbagbaa? Use unera awuri ikũ use afaru urhɛnga uwu ugbagbaa? <verse eid="MAT 16:26"/><verse number="27" style="v" sid="MAT 16:27"/>Ungwɛ̃-Ner awuri ibanga nggu ikpikpoi Utɛnga nggu ípfu itsernga, mɔcɛ unga aka ifai ubɛn unera itsernga aka atɔ̃. <verse eid="MAT 16:27"/><verse number="28" style="v" sid="MAT 16:28"/>Umum indɛyiwa umbi idzidzɛrhe, abɔɔ rabɔ adɛ̃ɛ̃ nggimi asi íkpembɔ utsɛku umbɔ aka inyã ibiba Ungwɛ̃-Ner ri Iyɛrhanga.&gt;&gt;<verse eid="MAT 16:28"/></para>
  <chapter eid="MAT 16"/>
  <chapter number="17" style="c" sid="MAT 17"/>
  <para style="s1">Idzidzipu iyor Uyesu</para>
  <para style="r">(<ref loc="MRK 9:2-13">Umar 9.2-13</ref>; <ref loc="LUK 9:28-36">Irh 9.28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1"/>Inuma utɔ̃ĩ iki imaa Uyesu akũ Ubitru, Uyaku nu Uyohana ungwɛ̃mbɔ Uyaku, umbɔ azĩ ni itsi igũ iyɔɔ iderdetangge, anangkɛ umbɔ aka awe ikiyikambɔ. <verse eid="MAT 17:1"/><verse number="2" style="v" sid="MAT 17:2"/>Umɔ unga adzipa awuwea ra asumbɔ. Asunga arhang ru nyaki ishaa unum, atorhanga awe aka aterha uku upɛ̃rhɛng ru nyaki irhirhang. <verse eid="MAT 17:2"/><verse number="3" style="v" sid="MAT 17:3"/>Kanying Umusa nu Uirhiya akapɛɛng ru umbɔ, adɛ̃ɛ̃ arherhe nggu Uyesu.<verse eid="MAT 17:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4"/>Ubitru agɔr Uyesu agɛ, &lt;&lt;A Uteijee, izengge umɛn iki iwe nggimi. Ungo uba ubeengo, umum itar atsurha ataar nggimi, unying uwu ungo, unying uwu Umusa nu unying uwu Uirhiya.&gt;&gt;<verse eid="MAT 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5"/>Adɛ̃ɛ̃ ra arherhe nukpi nggaa amɛɛ aka arhang atsire umbɔ, nu urhɛm ra amɛɛ ha uku ugɔr ugɛ, &lt;&lt;Uwɛrɛ awu Ungwɛ̃mum, uwuruwi umum iki ibema. Amɛnmum agũibɛn nggu unga akarhãrhã. Àka akpeto ru unga!&gt;&gt;<verse eid="MAT 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6"/>Ivang angwɛ̃ imesa ha aka agũ rimi, iwei ifɛr umbɔ, umbɔ akwɛr asumbɔ atsim ra abĩ. <verse eid="MAT 17:6"/><verse number="7" style="v" sid="MAT 17:7"/>Bɔr Uyesu aba abanga umbɔ agɛ, &lt;&lt;Àka asisok. Niba agũmbi iwei.&gt;&gt; <verse eid="MAT 17:7"/><verse number="8" style="v" sid="MAT 17:8"/>Umbɔ aka abera atsimbɔ asi inyãmbɔ uner uwɔɔ, akpurha anyã Uyesu.<verse eid="MAT 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9"/>Umbɔ aka awe ru utsĩndĩ uwuku ucipuwa ni itsi igũ hã, Uyesu atsu umbɔ agɛ, &lt;&lt;Niba adɛyikumbi unera ubinkpi umbi aka anyã utsɛku Ungwɛ̃-Ner aka isok ra akpe.&gt;&gt;<verse eid="MAT 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10"/>Angwɛ̃ imesa ha arhusa unga agɛ, &lt;&lt;Awu use utsu abika amesuwe Ikpem agɔr ugɛ awu ufang uner uwuku usɔm Arherhu-Num Uirhiya aka igbaashia aba?&gt;&gt;<verse eid="MAT 17:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11"/>Unga agɔr umbɔ agɛ, &lt;&lt;Awu idzidzɛrhe Uirhiya aka iba, unga igbishu ubɛn ubin. <verse eid="MAT 17:11"/><verse number="12" style="v" sid="MAT 17:12"/>Bɔr umum idɛyiwa umbi, Uirhiya aka abanga, bɔr umbɔ asi ihwɛngmbɔ unga, na akorhuwe unga ubinkpi umbɔ aka abee. Rimi hã Ungwɛ̃-Ner aka ihwa ayetnum ru ubokmbɔ.&gt;&gt; <verse eid="MAT 17:12"/><verse number="13" style="v" sid="MAT 17:13"/>Mɔcɛ angwɛ̃ imesa ha ahwɛng ugɛ unga arherhe arherha ha ri itsi Uyohana Uner Ubɔtisima.<verse eid="MAT 17:13"/></para>
  <para style="s1">Ikerhuwe uwɛkuci ri ipfu <optbreak/> iyiki ibewe</para>
  <para style="r">(<ref loc="MRK 9:14-29">Umar 9.14-29</ref>; <ref loc="LUK 9:37-43a">Irh 9.37-43a</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14"/>Ivangyɛ umbɔ aka azĩ atsĩ ra anang ikikɔnga, uner uwɔɔ aba ru Uyesu atararhu ra anangnga. <verse eid="MAT 17:14"/><verse number="15" style="v" sid="MAT 17:15"/>Na agɛ, &lt;&lt;A Uteijee, uma ugũ atorh ungwɛ̃mum, awuri irhãrhĩ unggbunggbuwa, aka ahwa uver akarhãrhã. Idikunga irhɛirhɛ unga iki igbei ru urha use ra amɛ̃. <verse eid="MAT 17:15"/><verse number="16" style="v" sid="MAT 17:16"/>Umum iki ikũna unga izĩ ra angwɛ̃ imesango, bɔr umbɔ asi idɛ̃ɛ̃ akerhukumbɔ unga.&gt;&gt;<verse eid="MAT 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17"/>Uyesu agɛ, &lt;&lt;Umbi abi udan ukpirɛ, abika asheri imangmang, abi amɛn aka abewe. Umum iki isei ĩdãrhũmum nggu umbi, ukang umbi aka awe ru imangmang ru umum? Utsɛku ukang umum iki ibima nggu ida imangmangmbi? Ukũ ungwɛ̃ hã uba nggɛɛ ru umum.&gt;&gt; <verse eid="MAT 17:17"/><verse number="18" style="v" sid="MAT 17:18"/>Uyesu atsɛrhi ipfu iyiki ibewa ha idzengge ru ungwɛ̃ hã. Kanying ungwɛ̃ hã akerhunga.<verse eid="MAT 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19"/>Mɔcɛ angwɛ̃ imesa ha aba ru Uyesu ri ivangyɛ anera aka ashimbɔ nggu unga, agɔr unga agɛ, &lt;&lt;Awu use utsu umɛn ifɔr itsũwe ipfu iyiki ibewa ha idamɛn?&gt;&gt;<verse eid="MAT 17:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Imangmangmbi iwe ukunjiir ngge itsu. Umum indɛyiwa umbi idzidzɛrhe, umbi aba awembi ri imangmang ukunjiir ru nyaki ishaa umastad, umbi adɛ̃ɛ̃ agɔrmbi igũ iyɛrɛ agɛ, &lt;Usoku nggɛɛ uzĩ ru nggɔɔ,&gt; ngge iwuri iso izĩngge. Ubin usi ínangkpɔ umbi.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">17.20 </char><char style="ft" closed="false">Abvur akɔɔ aki itsɛng abok aki isha agɔrke ikɛi ugɛ, </char><char style="fv" closed="false">21 </char><char style="fqa" closed="false">Bɔr ikpũ ipfu iki ibewe iyɛrɛ isi ídzengge, awu ikpem igha ubin nu ifɛn-Num ukpekũ iwuri itsu ngge idzek.</char></note><verse eid="MAT 17:20"/></para>
  <para style="s1">Uyesu arherha arherhe <optbreak/> akpenga ikɛi</para>
  <para style="r">(<ref loc="MRK 9:30-32">Umar 9.30-32</ref>; <ref loc="LUK 9:43b-45">Irh 9.43b-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22"/>Ivangyɛ angwɛ̃ imesa ha aka akɔng ra abĩ Ugarhirhi, unga agɔr umbɔ agɛ, &lt;&lt;Awuri ighambɔ adak Ungwɛ̃-Ner adzowe unga ra abok anera. <verse eid="MAT 17:22"/><verse number="23" style="v" sid="MAT 17:23"/>Umbɔ awuri ifɛre unga, ru unum untaar unga awuri isok abɛka.&gt;&gt; Amɛn angwɛ̃ imesa ha aghong.<verse eid="MAT 17:23"/></para>
  <para style="s1">Ifai ikirbi Iya-Num</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24"/>Uyesu nu angwɛ̃ imesanga aka atsĩ ru Ukafanahum, abika ayɛi ikirbi Iya-Num akpo Ubitru arhusa unga agɛ, &lt;&lt;Umarhemmbi asi ífaisa ikirbi Iya-Num?&gt;&gt;<verse eid="MAT 17:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25"/>Unga agɛ, &lt;&lt;Afasa.&gt;&gt;</para>
  <para style="p" vid="MAT 17:25">Ivangyɛ Ubitru aka aba ri iya, Uyesu atirhi arherha arherhe nggu unga agɛ, &lt;&lt;Ungo unyã uguse Usiman? Ayɛrhe ayɛi ikirbi abĩ ru ungamɔ, ra awɛkacimbɔ use ra abikase?&gt;&gt;<verse eid="MAT 17:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26"/>Ubitru agɛ, &lt;&lt;Ra abikase.&gt;&gt;</para>
  <para style="p" vid="MAT 17:26">Mɔcɛ Uyesu agɛ, &lt;&lt;Awɛkacimbɔ asi ífaimbɔ nukpɔ. <verse eid="MAT 17:26"/><verse number="27" style="v" sid="MAT 17:27"/>Bɔr utsur umɛn iwemɛn ru uvau ra anera abɛrɛ, uzĩ ru ukau ukugɔng utang igber. Uyanga angwĩ ubɛrh ha ungo uku utirhu udzur. Ungo ikpoɔ ishaa imang uazurhfa. Ukũ ishaa imang uazurhfa ha ufai imang iyi Iya-Numngo nggu iyi umum.&gt;&gt;<verse eid="MAT 17:27"/></para>
  <chapter eid="MAT 17"/>
  <chapter number="18" style="c" sid="MAT 18"/>
  <para style="s1">Uwuku ugɔnga ri Iyɛrhe afã</para>
  <para style="r">(<ref loc="MRK 9:33-37">Umar 9.33-37</ref>,<ref loc="MRK 9:42-48">42-48</ref>; <ref loc="LUK 9:46-48">Irh 9.46-48</ref>; <ref loc="LUK 17:1-2">17.1-2</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1"/>Ri ivang hã angwɛ̃ imesa ha aba arhusu Uyesu agɛ, &lt;&lt;Ungamɔ awu uwuku ugɔnga ri Iyɛrhe afã?&gt;&gt;<verse eid="MAT 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2"/>Unga ayisu ungwɛ̃rhũ uwɛkuci atsu unga adɛ̃ɛ̃ ra ateumbɔ, <verse eid="MAT 18:2"/><verse number="3" style="v" sid="MAT 18:3"/>na agɛ, &lt;&lt;Umum idɛyiwa umbi idzidzɛrhe umbi aba asi idzipa awembi ru nyaka awɛkaci, umbi asi ítsĩmbi Iyɛrhe afã. <verse eid="MAT 18:3"/><verse number="4" style="v" sid="MAT 18:4"/>Nggee, uwuruwi aka arhɛrhi itsinga ru nyaku ungwɛ̃ uwurɛ unga awu uwuku ugɔnga ri Iyɛrhe afã.<verse eid="MAT 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 18:5"/>&lt;&lt;Ubɛn unera aka ayɛisa ungwɛ̃rhũ uwɛkuci ru nyaku uwɛrɛ ri itsokmum, ayɛi umum. <verse eid="MAT 18:5"/><verse number="6" style="v" sid="MAT 18:6"/>Bɔr uwuruwi aka atsu unying ra awɛkaci abɛrɛ abika awe ru imangmang ru umum atsĩã ra arhim, ugba umbɔ abope nggaa ukɔ igɔ ru urhɔknga na atare unga atsĩ ru ukau ukugɔng.<verse eid="MAT 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7"/>&lt;&lt;Atorh upfung ri itsi abinkɛ aka atsu anera atsĩ ra arhim! Awu ufang abin hã aka iba, bɔr atorh uwu ha aka itsu ake aba. <verse eid="MAT 18:7"/><verse number="8" style="v" sid="MAT 18:8"/>Uba ubokngo use udakngo uni itsu ungo utsĩ ra arhim, uzharha ukpɔ utare. Ugba ungo utsĩ ru urhɛ ukpu ugbagbaa nggu ubokngo unying use udakngo unying nu umbɔ aka itare ungo utsĩ ru urha ukpu ugbagbaa nggu aboka avaa use adaka avaa. <verse eid="MAT 18:8"/><verse number="9" style="v" sid="MAT 18:9"/>Nu usungo uba itsu ungo utsĩ ra arhim, ukhor utare. Ugba ungo utsĩ ru urhɛ ukpu ugbagbaa nggu usua unying nu umbɔ aka itsuke ungo ri idzũ urha nggu asua avaa.<verse eid="MAT 18:9"/></para>
  <para style="s1">Unyaka arherhe aki idɔi iyiki igwir</para>
  <para style="r">(<ref loc="LUK 15:3-7">Irh 15.3-7</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10"/>&lt;&lt;Àka arhi anyã niba akwɛɛrkumbi unying ra angwɛ̃rhã awɛkaci abɛrɛ. Umum idɛyiwa umbi, ípfu itsermbɔ ubɛn unum ini irhi asu Utɛmum uwuku uwe ra afã.<note caller="+" style="f"><char style="fr" closed="false">18.10 </char><char style="ft" closed="false">Abvur akɔɔ aki itsɛng abok aki isha agɔrke ikɛi ugɛ, </char><char style="fv" closed="false">11 </char><char style="fqa" closed="false">Nu Ungwɛ̃-Ner aba ifɔrh abirabɛ aka agwir.</char></note><verse eid="MAT 18:10"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12"/>&lt;&lt;Umbi akaifɛrhkɔ aguse? Unera aba awe ru ídɔi unaka, unying igwirngge, unga asi ínekuka isɔka utɔɔrha nu utɔɔrha ra abang igũa na azĩã abee unying hã iki igwir? <verse eid="MAT 18:12"/><verse number="13" style="v" sid="MAT 18:13"/>Unga aba anyã ngge, umum indɛyiwa umbi idzidzɛrhe, unga awuri igɔm iyi ha iki iyikangge ananga isɔka utɔɔrha nu utɔɔrha iki isi igwirngge. <verse eid="MAT 18:13"/><verse number="14" style="v" sid="MAT 18:14"/>Rimi hã asi iwea ibibemu Utɛmbi ra afã unying ra awɛkaci abɛrɛ agwir.<verse eid="MAT 18:14"/></para>
  <para style="s1">Uba ungwɛ̃mbi agbaa uvau ru ungo</para>
  <para style="r">(<ref loc="LUK 17:3">Irh 17.3</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15"/>&lt;&lt;Ungwɛ̃mbi use unapumbi aba agbaa uvau ru ungo, uzĩ usɔme unga uvaunga, ungo nu unga ukpekũ. Unga aba agũã, ungo uku ubvui ukũ unga ubango ri iwɛrhɛ nggu ungo. <verse eid="MAT 18:15"/><verse number="16" style="v" sid="MAT 18:16"/>Bɔr unga aba asi igũã, ungo ubee unera unying use ivaa umbi azĩ, ngge itsú ideka iyi inera ivaa use itaar imɛ̃ngge ifɛr arherhe.<note caller="+" style="f"><char style="fr" closed="false">18.16 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="DEU 19:15">Iva 19.15</ref></char>.</note> <verse eid="MAT 18:16"/><verse number="17" style="v" sid="MAT 18:17"/>Ungwɛ̃mbi aba akpɛ̃ɛ̃ igũ umbɔ, ungo udɛyiwe ikikɔng abika adɔsa, unga aba akpɛ̃ɛ̃ igũ ikikɔng abika adɔsa ha, unyanga unga ru nyaku unerwi aka asi idɔsunga Unum use uwuku uyɛi ikirbi abĩ.<verse eid="MAT 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18"/>&lt;&lt;Umum indɛyiwa umbi idzidzɛrhe, ubɛn ubinkpi umbi aka abow ru upfung awuri ibow ukpɔ ra afã. Ikɛi ubɛn ubinkpi umbi aka agarhuwe ru upfung awuri igarhuwe ukpɔ ra afã.<verse eid="MAT 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19"/>&lt;&lt;Umum ibvui idɛyiwa umbi, inera ivaa ru umbi ru upfung ukpirɛ aba ibema ifɛnu ubin ru Utɛmum uwu afã, awuri ikorhuka umbɔ. <verse eid="MAT 18:19"/><verse number="20" style="v" sid="MAT 18:20"/>Ubinkutsu inera ivaa use ataar aba akɔngmbɔ ri itsokmum, umum iwu nggu umbɔ.&gt;&gt;<verse eid="MAT 18:20"/></para>
  <para style="s1">Unyaka arherhe ugãrhã <optbreak/> uwuku ushe ra atorh</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21"/>Mɔcɛ Ubitru aba agɔr Uyesu agɛ, &lt;&lt;A Uteijee, idikunga isong ungwɛ̃mɛn aka igba uvau ru umum, umum itsũwe unga? Awu idikunga utɔɔva?&gt;&gt;<verse eid="MAT 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22"/>Uyesu agɔr unga agɛ, &lt;&lt;Umum idɛyiwa ungo, asi iwea idiku utɔɔva, bɔr isɔka utɔɔva nu utɔɔva.<verse eid="MAT 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23"/>&lt;&lt;Nggee, Iyɛrhe afã iwe ru nyaku uyɛrhe uwɔɔ aka abee ivarha abinnga aka awe ra abok agãrhãnga abee umbɔ afase. <verse eid="MAT 18:23"/><verse number="24" style="v" sid="MAT 18:24"/>Uyɛrhe ha aka atirhi avarhe, umbɔ akũ uner uwɔɔ aba ru unga, uwuruwi aka angwɛ̃ uvɛrh nggaa ibɛi uazurhfanga iyi anaka agɔnga usɔka. <verse eid="MAT 18:24"/><verse number="25" style="v" sid="MAT 18:25"/>Unga aka afɔr ifai adaka, uyɛrhe ha agɛ agoshe unga nu utsɛ̃nga, nu awɛkacinga, nu kishoo abinkɛ unga aka awurake na akũ afase uvɛrhnga.<verse eid="MAT 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26"/>&lt;&lt;Ugãrhã hã atararhu ra asu uyɛrhe ha ashɔ̃rhã agɛ, &lt;Umaa udɔng amɛnngo nggu umum, umum iwuri ifasamum abina kishoo.&gt; <verse eid="MAT 18:26"/><verse number="27" style="v" sid="MAT 18:27"/>Uyɛrhe ha agũ atorh unga, afɔ̃rhũwe uvɛrh ha na atsũwe unga azĩã.<verse eid="MAT 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28"/>&lt;&lt;Bɔr utsak ha aka adzek, anyã ugãrhũ itsernga aka angwɛ̃ uvɛrh unga íshaa imang unaka unying ukpekũ. Unga adzur urhɔk utsak ha akpɔm na agɛ, &lt;Ufai ubinkpi umum iki idɔsa ungo.&gt;<verse eid="MAT 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29"/>&lt;&lt;Udɔki itsernga atararhu na ashɔ̃rhã unga agɛ, &lt;Udɔng amɛnngo nggu umum, umum iwuri ifasamum uvɛrhngo.&gt;<verse eid="MAT 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30"/>&lt;&lt;Bɔr unga akpɛ̃ɛ̃. Akũ utsak ha azĩ agbanguka ru ugborzĩ utsɛku unga aka ifai uvɛrh ha. <verse eid="MAT 18:30"/><verse number="31" style="v" sid="MAT 18:31"/>Ivangyɛ andɔki itsernga abɔɔ aka anyã ubinkpi unga aka akorhe, umbɔ asi igũmbɔ ibɛn, umbɔ azĩ asɔmukumbɔ uyɛrhe ha kishoo ubinkpi uku ukorhe.<verse eid="MAT 18:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32"/>&lt;&lt;Mɔcɛ uyɛrhe ayisu ugãrhã hã agɛ, &lt;Ungo uwu ugãrhũ uwu amɛn aka abewe, umum itsũwũkũ kishoo uvɛrhngo ri ishishɔ̃rhãyɛ ungo uku ushɔ̃rhã umum. <verse eid="MAT 18:32"/><verse number="33" style="v" sid="MAT 18:33"/>Isi imɛ̃ngge ungo uku igũ atorh udɔki itserngo ru nyaka umum iki igũ atorh ungo?&gt; <verse eid="MAT 18:33"/><verse number="34" style="v" sid="MAT 18:34"/>Uyɛrhe agũ avɔm akarhãrhã, atsu umbɔ adzowe unga ayetnum utsɛku unga aka ifai uvɛrh ha.<verse eid="MAT 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35"/>&lt;&lt;Rimi hã Utɛmum ra afã aka ikorhe nggu uwuku ukpɛ̃ɛ̃ itsũwe undɔka ra amɛnnga.&gt;&gt;<verse eid="MAT 18:35"/></para>
  <chapter eid="MAT 18"/>
  <chapter number="19" style="c" sid="MAT 19"/>
  <para style="s1">Ifɛre itsɛrh</para>
  <para style="r">(<ref loc="MRK 10:1-12">Umar 10.1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1"/>Ivangyɛ Uyesu aka amaa irherha akɛrɛ, unga abɔruka abĩ Ugarhirhi na azĩã abĩ Uyahudiya aka awu ugar Azɛ̃ Urdun. <verse eid="MAT 19:1"/><verse number="2" style="v" sid="MAT 19:2"/>Nggaa ikikɔng anera idɔsa unga, unga akerhuwe umbɔ.<verse eid="MAT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3"/>Abi Ufarisi abɔɔ aba ru unga avira unga. Arhusa unga agɛ, &lt;&lt;Ri ikpemmɛn imɛ̃ngge unera awayiwe utsɛ̃nga ri ikorhe ubɛn ubin?&gt;&gt;<verse eid="MAT 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4"/>Unga agɔr umbɔ agɛ, &lt;&lt;Umbi anasi ivarhumbi itsɛng Arherhu-Num? Atsɛng ri inggbaashia ugɛ, &lt;Unum amuna umbɔ ukutsak nggu ukutsɛrh,&gt;<note caller="+" style="f"><char style="fr" closed="false">19.4 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="GEN 1:27">Ing 1.27</ref></char>.</note> <verse eid="MAT 19:4"/><verse number="5" style="v" sid="MAT 19:5"/>na agɛ, &lt;Ngge iki iwe rimi, unera awuri ineke utɛnga nu uyanga na awu nggu utsɛ̃nga, umbɔ ikivarhambɔ awuri iwu iyora unying&gt;<note caller="+" style="f"><char style="fr" closed="false">19.5 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="GEN 2:24">Ing 2.24</ref></char>.</note>? <verse eid="MAT 19:5"/><verse number="6" style="v" sid="MAT 19:6"/>Nggee umbɔ asi iwembɔ ivaa, bɔr umbɔ awe iyora unying. Nggee, ubinkpi Unum aka agbopa, unera niba agashuka.&gt;&gt;<verse eid="MAT 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7"/>Umbɔ arhusa agɛ, &lt;&lt;Awu use utsu Umusa atsu ugɛ adzowe ubvur uwuku ufɛr itsɛrh awayiwe utsɛrh ha azĩã?&gt;&gt;<verse eid="MAT 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Umusa abemuwa umbi igau itsɛrh ubinkutsu amɛn aka akermbi atsu. Bɔr isi iwengge rimi ri inggbaashia. <verse eid="MAT 19:8"/><verse number="9" style="v" sid="MAT 19:9"/>Umum idɛyiwa umbi ugɛ ubɛn unera aka awayiwe utsɛ̃nga aka asi itomunga-dak, na apfunu utsɛrh uwukuse, atoma-dak.&gt;&gt;<verse eid="MAT 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10"/>Angwɛ̃ imesa ha agɔr unga agɛ, &lt;&lt;Iba iwe rimi arherhe ukutsak nggu utsɛ̃nga, ida ipfuna ngge inang.&gt;&gt;<verse eid="MAT 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Asi iwea ubɛn unera awuri idɛ̃ɛ̃ ayɛi arherhe akɛrɛ, bɔr abirabɛ Unum aka adzowe ngge. <verse eid="MAT 19:11"/><verse number="12" style="v" sid="MAT 19:12"/>Ubinkutsu abɔɔ awu akpirh, amar umbɔ rimi. Abɔɔ, anera akorhuwe, asi idɛ̃ɛ̃ apfunumbɔ. Abɔɔ Iyɛrhe afã itsu umbɔ akpɛ̃mbɔ ipfuna. Uwuku udɛ̃ɛ̃ ayɛi arherhe akɛrɛ unga ayɛi.&gt;&gt;<verse eid="MAT 19:12"/></para>
  <para style="s1">Uyesu atsuke idorh ra awɛkaci</para>
  <para style="r">(<ref loc="MRK 10:13-16">Umar 10.13-16</ref>; <ref loc="LUK 18:15-17">Irh 18.15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13"/>Mɔcɛ umbɔ akũ angwɛ̃rhã awɛkaci aba ru Uyesu atsorhuwe aboknga nu umbɔ na afɛne-Num ru umbɔ. Bɔr angwɛ̃ imesanga atsɛrha abika akũ awɛkaci ha aba.<verse eid="MAT 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14"/>Uyesu agɛ, &lt;&lt;Àka aneke angwɛ̃rhã awɛkaci aba ru umum. Àka niba akɛnmbi umbɔ, Iyɛrhe afã iwu iyi ikpũmbɔ.&gt;&gt; <verse eid="MAT 19:14"/><verse number="15" style="v" sid="MAT 19:15"/>Unga atsorhuwe umbɔ aboknga, mɔcɛ unga azĩã.<verse eid="MAT 19:15"/></para>
  <para style="s1">Uwɛdzɛm uner ubin</para>
  <para style="r">(<ref loc="MRK 10:17-31">Umar 10.17-31</ref>; <ref loc="LUK 18:18-30">Irh 18.18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16"/>Mɔcɛ uner uwɔɔ aba ru Uyesu arhusa agɛ, &lt;&lt;A umarhem, ubin uku uze ukusong umum iki ikorhe ni ikpo urhɛ uwu ugbagbaa?&gt;&gt;<verse eid="MAT 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17"/>Uyesu agɔr unga agɛ, &lt;&lt;Ungo urhusa umum ubin uwuku uze? Ubin uwuku uze uwu unying. Ungo uba ubeengo ikpo urhɛ uwu ugbagbaa, ungo udɔsi íkpem.&gt;&gt;<verse eid="MAT 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18"/>Unga arhusu Uyesu agɛ, &lt;&lt;íkpem iyikisong?&gt;&gt;</para>
  <para style="p" vid="MAT 19:18">Uyesu agɛ, &lt;&lt; &lt;Niba ufɛrɔ unera, niba utomungo-dak, niba uvɛpɔ ivɛu, niba ugbɛrɔ angwĩ utsukukɔ unera, <verse eid="MAT 19:18"/><verse number="19" style="v" sid="MAT 19:19"/>udzowe imor ru utɛngo nu uyango,&gt;<note caller="+" style="f"><char style="fr" closed="false">19.19 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="EXO 20:12-16">Idzi 20.12-16</ref>; <ref loc="DEU 5:16-20">Iva 5.16-20</ref></char>.</note> nu &lt;ubemu udɔkango ru nyaki itsikamngo.&gt; <note caller="+" style="f"><char style="fr" closed="false">19.19 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="LEV 19:18">Urha 19.18</ref></char>.</note>&gt;&gt;<verse eid="MAT 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20"/>Uwɛdzɛm hã agɛ, &lt;&lt;Umum iki idɔsumum akɛrɛ kishoo. Umum ĩbɔr use?&gt;&gt;<verse eid="MAT 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21"/>Uyesu agɔr unga agɛ, &lt;&lt;Ungo uba ubeengo iwe undzumunga, ungo uzĩ, ugoshe abinngo, udzowe uhwɛka ra atsũwã, nu uba udɔsa umum. Mɔcɛ ungo iweɔ ru ugbɛta urhɛrhɛ ra afã.&gt;&gt;<verse eid="MAT 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22"/>Ivangyɛ uwɛdzɛm ha aka agũ rimi, unga azĩ nggu ighongamɛn, ubinkutsu awe ru ubin akarhãrhã.<verse eid="MAT 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23"/>Mɔcɛ Uyesu agɔr angwɛ̃ imesanga agɛ, &lt;&lt;Umum indɛyiwa umbi idzidzɛrhe, aghong uner ubin aka itsĩ ri Iyɛrhe afã. <verse eid="MAT 19:23"/><verse number="24" style="v" sid="MAT 19:24"/>Ikɛi umum idɛyiwa umbi, ugba urhakumi utsĩ ra angwĩ inepurha nu uner ubin aka itsĩ ri Iyɛrhe-Num.&gt;&gt;<verse eid="MAT 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25"/>Ivang angwɛ̃ imesa ha aka agũ rimi, umbɔ adzeidzeu akarhãrhã, na arhusa agɛ, &lt;&lt;Ungamɔ awuri idɛ̃ɛ̃ akpo ififɔrh?&gt;&gt;<verse eid="MAT 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26"/>Bɔr Uyesu arhi umbɔ na agɛ, &lt;&lt;Anera asi ídɛ̃ɛ̃ akorhumbɔ akɛrɛ, bɔr Unum adɛ̃ɛ̃ akorhunga abina kishoo.&gt;&gt;<verse eid="MAT 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27"/>Ubitru agɔr unga agɛ, &lt;&lt;Nggayɛ umɛn ineke abina kishoo ni idɔsa ungo! Umɛn iwuri ikpo usemɛn?&gt;&gt;<verse eid="MAT 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Umum indɛyiwa umbi idzidzɛrhe, ru unumkpi umbɔ aka itsu abina kishoo awe aka afa, ivang Ungwɛ̃-Ner aka isei ru anang isei aki ijee iyi ikpikpoi, umbi abika adɔsa umum, awu umbi awuri isei nu anang isei ijee usɔkdũmɛn, umbi awuri itsu uvau anui usɔkdũmɛn aki Uisrairha. <verse eid="MAT 19:28"/><verse number="29" style="v" sid="MAT 19:29"/>Nu ubɛn unerwi aka aneke iyanga, use angwɛ̃mbɔ, use anapumbɔ, utei use uyi, use awɛkaci, use ícang ri itsimum awuri ikpo ananga rimi hã idikunga unaka, ikɛi unga awuri ikpoa urhɛ uwu ugbagbaa. <verse eid="MAT 19:29"/><verse number="30" style="v" sid="MAT 19:30"/>Bɔr anera arhɛrhɛ aka awu anggbaashi, awuri iwe amaata, amaata ikɛi awuri iwe anggbaashi.<verse eid="MAT 19:30"/></para>
  <chapter eid="MAT 19"/>
  <chapter number="20" style="c" sid="MAT 20"/>
  <para style="s1">Unyaka arherhe abi itser <optbreak/> imang ri icang</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1"/>&lt;&lt;Iyɛrhe afã iwe ru nyaku uteiya icang aka adzek ru unkpeeka atsu abi itser imang ri icangnga. <verse eid="MAT 20:1"/><verse number="2" style="v" sid="MAT 20:2"/>Unga abemuwe ifai ishaa imang iki iwe imang itser unuma unying, na adene umbɔ azĩmbɔ ri icangnga.<verse eid="MAT 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3"/>&lt;&lt;Ra akara utɔɔrha aki ukpee ikɛi unga adzek anyã abɔɔ aka asei ibɛm ra angwĩ izɛɛ, <verse eid="MAT 20:3"/><verse number="4" style="v" sid="MAT 20:4"/>unga adɛyiwe umbɔ agɛ, &lt;Umbi ikɛi àka azĩ atɔ̃ itser ri icangmum, umum ifasũ umbi ubinkpi uku umɛ̃ɛ̃.&gt; <verse eid="MAT 20:4"/><verse number="5" style="v" sid="MAT 20:5"/>Nggee umbɔ azĩmbɔ.</para>
  <para style="p" vid="MAT 20:5">&lt;&lt;Unga adzek ra atenuma ra akara usɔkdũmɛn, ikɛi ra akara ataar akorhe rimi hã. <verse eid="MAT 20:5"/><verse number="6" style="v" sid="MAT 20:6"/>Ra akara atɔ̃ɔ̃ unga abvui adzek anyã abɔɔ aka adɛ̃ɛ̃ ibɛm. Unga arhusa umbɔ agɛ, &lt;Awu use utsu umbi adɛ̃ɛ̃ asi itɔ̃mbi itser?&gt;<verse eid="MAT 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7"/>&lt;&lt;Umbɔ agɔr unga agɛ, &lt;Unera asi idzaanga umɛn itser iyiki itɔ̃.&gt;</para>
  <para style="p" vid="MAT 20:7">&lt;&lt;Unga agɔr umbɔ agɛ, &lt;Umbi ikɛi àka azĩ atɔ̃ itser ri icangmum.&gt;<verse eid="MAT 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8"/>&lt;&lt;Urhɛɛ uku uwe, uteiya icang hã ayisu uwuku uyike unga agɛ, &lt;Uyisa abi itser icang hã, ufase umbɔ imang itsermbɔ. Utirhi ra amaataka uzĩ ra anggbaashia.&gt;<verse eid="MAT 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9"/>&lt;&lt;Abi itserbɛ aka azĩ ra akara atɔ̃ɔ̃ aba, umbɔ afai umbɔ ishaa imang. <verse eid="MAT 20:9"/><verse number="10" style="v" sid="MAT 20:10"/>Abirabɛ aka agbaashia azĩ, afosi iyɛi anangmbɔ rimi. Bɔr ubɛn unera ayɛi ishaa imang. <verse eid="MAT 20:10"/><verse number="11" style="v" sid="MAT 20:11"/>Ivangyɛ umbɔ aka ayɛi ngge, umbɔ abvun arherhe ru uteiya icang hã. <verse eid="MAT 20:11"/><verse number="12" style="v" sid="MAT 20:12"/>Agɛ, &lt;Abirabɛ aka aba ri imaata, atɔ̃ itser iyi ukara unying ukpekũ, nu ungo ufai umbɔ uku kpengkpeng nggu umɛn iki ihwa uver itɔ̃ itser ru imani unuma.&gt;<verse eid="MAT 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13"/>&lt;&lt;Bɔr unga agɔr unyinga umbɔ agɛ, &lt;A uwee, umum isi ighamum urha ungo. Umɛn isi ikpangmɛm umum ifai ungo ishaa imang? <verse eid="MAT 20:13"/><verse number="14" style="v" sid="MAT 20:14"/>Uyɛi imangngo uzĩɔ. Umum ibee ifai abika aba imaata uku kpengkpeng nggu ungo. <verse eid="MAT 20:14"/><verse number="15" style="v" sid="MAT 20:15"/>Use ishimum ri ijee iyiki ikorhu ubinkpi umum iki ibee nggu imangmum? Use ungo ugũ unyɛ̃ɛ̃ umum iki idzise izũwã akarhãrhã?&gt;<verse eid="MAT 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16"/>&lt;&lt;Rimi hã amaataka aka awe anggbaashia, nu anggbaashia awe amaataka.&gt;&gt;<verse eid="MAT 20:16"/></para>
  <para style="s1">Ikɛi Uyesu arherha arherhe <optbreak/> ra akpenga</para>
  <para style="r">(<ref loc="MRK 10:32-34">Umar 10.32-34</ref>; <ref loc="LUK 18:31-34">Irh 18.31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17"/>Uyesu nu angwɛ̃ imesanga aka azɛ̃rhã azĩ ufã Urusharhima. Unga agbiira umbɔ azĩ ri ifɛna ikiyikambɔ, agɔr umbɔ agɛ, <verse eid="MAT 20:17"/><verse number="18" style="v" sid="MAT 20:18"/>&lt;&lt;Umɛn izĩ ifũrhũwe Urusharhima. Awuri ighadak Ungwɛ̃-Ner adzowe unga ru ubok ateiya abika adzowe idɛm-Num nu abika amesuwe Ikpem. Umbɔ awuri itsu unga ufai akpe. <verse eid="MAT 20:18"/><verse number="19" style="v" sid="MAT 20:19"/>Mɔcɛ umbɔ aka idzowe unga ra atsen abi Uyahuda. Umbɔ ayɛia unga, akũ asharhe akwɛr unga, anyapuwe unga. Ru unum untaar unga awuri isoka ra akpe.&gt;&gt;<verse eid="MAT 20:19"/></para>
  <para style="s1">Ifɛn iyi uyambɔ Uyaku nu Uyohana</para>
  <para style="r">(<ref loc="MRK 10:35-45">Umar 10.35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20"/>Mɔcɛ uya angwɛ̃ Uzabadi aba ru Uyesu nggu angwɛ̃nga, atararhu ra anangnga na afɛnu ubin ukpɔɔ.<verse eid="MAT 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21"/>Unga arhusa unga agɛ, &lt;&lt;Ungo ubee use?&gt;&gt; Unga agɛ, &lt;&lt;Utsu awɛkaci abɛrɛ ikivarhambɔ asei, unying ru ubok ughango, uwu uvaa nu ubok uferango ri Iyɛrhango.&gt;&gt;<verse eid="MAT 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22"/>Bɔr Uyesu agɔr umbɔ agɛ, &lt;&lt;Umbi asi ihwɛngmbi ubinkpi umbi aka afɛna. Umbi adɛ̃ɛ̃ ahwambi ru ukpɛwa ha uwu ayetnumkɛ umum iki ihwa?&gt;&gt;</para>
  <para style="p" vid="MAT 20:22">Umbɔ agɔr unga agɛ, &lt;&lt;Umɛn imɛ̃mɛn.&gt;&gt;<verse eid="MAT 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Idzidzɛrhe umbi awuri ahwambi ru ukpɛwamum, bɔr isei ru ubok ugha nu ubok uferamum asi iwea umum itsũ idzowe. Anang hã awe aki abi Utɛmum ra afã aka agbishuwe.&gt;&gt;<verse eid="MAT 20:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24"/>Ivang angwɛ̃ imesa abɔrɔ usɔka aka agũ, umbɔ agũ avɔm abɔrɔ ha ikivarhambɔ. <verse eid="MAT 20:24"/><verse number="25" style="v" sid="MAT 20:25"/>Bɔr Uyesu ayisa umbɔ ananga unying na agɛ, &lt;&lt;Umbi ahwɛngmbi ayɛrha atsen abi Uyahuda aki isaka adɛyiwe iyɛrhe ri itsi anermbɔ, anggbaashimbɔ adɛyiwe umbɔ ijee. <verse eid="MAT 20:25"/><verse number="26" style="v" sid="MAT 20:26"/>Bɔr isi íwengge rimi ru umbi. Ubɛn uwuku ubee igɔng ru umbi awu ufang unga awu ugãrhãmbi. <verse eid="MAT 20:26"/><verse number="27" style="v" sid="MAT 20:27"/>Nu uwuruwi aka abee iwu unggbaashi ru umbi, awu ufang unga awu ugãrhãmbi. <verse eid="MAT 20:27"/><verse number="28" style="v" sid="MAT 20:28"/>Ru nyaku Ungwɛ̃-Ner asi ibanga umbɔ atɔ̃we unga itser, bɔr unga awuri iwu ugãrhã, na adzowe urhɛnga afɔrh anera arhɛrhɛ.&gt;&gt;<verse eid="MAT 20:28"/></para>
  <para style="s1">Abi ibvuta avaa akpombɔ <optbreak/> inyã anang</para>
  <para style="r">(<ref loc="MRK 10:46-52">Umar 10.46-52</ref>; <ref loc="LUK 18:35-43">Irh 18.35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29"/>Uyesu nu angwɛ̃ imesanga aka abɔre Ujeriko, nggaa ikikɔng anera adɔsa unga. <verse eid="MAT 20:29"/><verse number="30" style="v" sid="MAT 20:30"/>Abi ibvuta avaa aka asei nu ubang utsĩndĩã. Ivangyɛ umbɔ aka agũ ugɛ Uyesu unga atɔng, umbɔ atsarhi irhakmbɔ agɛ, &lt;&lt;A Uteijee, Ungwɛ̃ Udauda! Ugũ atorh umɛn!&gt;&gt;<verse eid="MAT 20:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31"/>Ikikɔnga itsɛrha umbɔ ugɛ umbɔ anukutata, bɔr umbɔ atoma atsarhi irhakmbɔ agɛ, &lt;&lt;A Uteijee, Ungwɛ̃ Udauda! Ugũ atorh umɛn!&gt;&gt;<verse eid="MAT 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32"/>Uyesu adɛ̃ɛ̃ na ayisa umbɔ agɛ, &lt;&lt;Umbi abee umum ikorhuwa umbi use?&gt;&gt;<verse eid="MAT 20:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33"/>Umbɔ agɔr unga agɛ, &lt;&lt;A Uteijee, umɛn ibee inyã anang.&gt;&gt;<verse eid="MAT 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34"/>Uyesu agũ atorh umbɔ na abanga asumbɔ. Kanying umbɔ anyã ananga na adɔsa unga.<verse eid="MAT 20:34"/></para>
  <chapter eid="MAT 20"/>
  <chapter number="21" style="c" sid="MAT 21"/>
  <para style="s1">Itsitsĩ iyi ininang</para>
  <para style="r">(<ref loc="MRK 11:1-11">Umar 11.1-11</ref>; <ref loc="LUK 19:28-40">Irh 19.28-40</ref>; <ref loc="JHN 12:12-19">Uyoh 12.12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1"/>Umbɔ aka akhapa ru Urusharhima aba atsĩ Ubetafaji nú Igũ Acucii Uzaitun. Uyesu adene angwɛ̃ imesanga avaa, <verse eid="MAT 21:1"/><verse number="2" style="v" sid="MAT 21:2"/>agɔr umbɔ agɛ, &lt;&lt;Àka atsĩ ru uteu uku uci ha ra asumbi, utɛm itsitsĩmbi, umbi awuri inyãmbi uzhika umbɔ aka abow nggu ungwɛ̃mgbɔ. Àka agarha ake akũwã ru umum. <verse eid="MAT 21:2"/><verse number="3" style="v" sid="MAT 21:3"/>Unera aba arhusunga umbi, àka adɛyiwe unga agɛ, &lt;Uteijee unga abee ake,&gt; awuri idzaanga ake kanying.&gt;&gt;<verse eid="MAT 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4"/>Akɛrɛ akorhe rimi ngge itsuifɛr ubinkpi uner uwuku usɔm Arherhu-Num aka arherhe agɛ,<verse eid="MAT 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5"/>&lt;&lt;Àka asɔme aner Urusharhima,</para>
  <para style="q2" vid="MAT 21:5">&lt;Àka anyã, uyɛrhambi uwi aba ru umbi!</para>
  <para style="q1" vid="MAT 21:5">Unga adɔɔr, awu idzui uzhika,</para>
  <para style="q2" vid="MAT 21:5">nú undzing ungwɛ̃ uzhika.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">21.5 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="ZEC 9:9">Uzak 9.9</ref></char>.</note><verse eid="MAT 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6"/>Angwɛ̃ imesa ha azĩ akorhe ru nyaka Uyesu aka agɔr umbɔ. <verse eid="MAT 21:6"/><verse number="7" style="v" sid="MAT 21:7"/>Umbɔ akũ uzhika ha nggu ungwɛ̃mgbɔ aba, abɛtuwe atorhambɔ nú ungwɛ̃ɛ̃, Uyesu afũ asei. <verse eid="MAT 21:7"/><verse number="8" style="v" sid="MAT 21:8"/>Anera arhɛrhɛ aka abɛtuwe atorhambɔ nú utsĩndĩã, abɔɔ agbɛyi abok acucii abɛtuwe nú utsĩndĩã. <verse eid="MAT 21:8"/><verse number="9" style="v" sid="MAT 21:9"/>Anera abika awu ra asunga nu abirabɛ aka adɔsa unga ra andzing atsarhi irhakmbɔ agɛ,</para>
  <para style="q1" vid="MAT 21:9">&lt;&lt;Ikpikpoi iwe<note caller="+" style="f"><char style="fr" closed="false">21.9 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="PSA 118:26">Amb 118.26</ref></char>.</note> nggu Ungwɛ̃ Udauda!</para>
  <para style="q2" vid="MAT 21:9">Idorh iwe nggu uwuku uba ri itsok Uteijee!</para>
  <para style="q1" vid="MAT 21:9">Ikpikpoi iwe afafã ra afã!&gt;&gt;<verse eid="MAT 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10"/>Ivangyɛ Uyesu aka atsĩ Urusharhima, utepa kishoo udzunukpɔ nu urhusa ugɛ, &lt;&lt;Awu ungamɔ nuwi?&gt;&gt;<verse eid="MAT 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11"/>Anera agɛ, &lt;&lt;Uwɛrɛ awu Uyesu uwuku usɔm Arherhu-Num aka adzeku Unazarat ukpu Ugarhirhi.&gt;&gt;<verse eid="MAT 21:11"/></para>
  <para style="s1">Uyesu asare Iya-Num</para>
  <para style="r">(<ref loc="MRK 11:15-19">Umar 11.15-19</ref>; <ref loc="LUK 19:45-48">Irh 19.45-48</ref>; <ref loc="JHN 2:13-22">Uyoh 2.13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12"/>Uyesu atsĩ ri Iya-Num awayiwe kishoo abika agoyiwe nu abika agugoyi umɔ. Ayii atebur iyi abika afaru uhwɛk akwɛr atsĩme, nu atebur abika agoyiwe anurhɛu iya. <verse eid="MAT 21:12"/><verse number="13" style="v" sid="MAT 21:13"/>Agɔr umbɔ agɛ, &lt;&lt;Itsɛng Arherhu-Num igɔr igɛ, &lt;Awuri iyisi iyamum iwu iya ifɛn-Num,&gt;<note caller="+" style="f"><char style="fr" closed="false">21.13 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="ISA 56:7">Uish 56.7</ref></char>.</note> bɔr umbi adzipa ake iwe anang awoi avɛu.<note caller="+" style="f"><char style="fr" closed="false">21.13 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="JER 7:11">Uiri 7.11</ref></char>.</note>&gt;&gt;<verse eid="MAT 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14"/>Abi ibvuta nu akatarhu aba ru unga ri Iya-Num, unga akerhuwe umbɔ. <verse eid="MAT 21:14"/><verse number="15" style="v" sid="MAT 21:15"/>Bɔr ivang ateiya abika adzowe idɛm-Num nu abika amesuwe Ikpem anyã abin idzeukɛ unga aka akorhe, na anyã awɛkaci atsui ivum ri Iya-Num agɛ, &lt;&lt;Ikpikpoi iwe nggu Ungwɛ̃ Udauda,&gt;&gt; umɔ umbɔ agũ avɔm.<verse eid="MAT 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16"/>Agɔr unga agɛ, &lt;&lt;Ungo ugũo ubin awɛkaci abɛrɛ aka adɛ̃ɛ̃ arherhe?&gt;&gt;</para>
  <para style="p" vid="MAT 21:16">Uyesu agɔr umbɔ agɛ, &lt;&lt;Ĩĩ, umbi anasi ivarhumbi ri itsɛng Arherhu-Num iki igɔr ugɛ,</para>
  <para style="q1" vid="MAT 21:16">&lt;&lt; &lt;Awu ungo umesuwe angwɛ̃rhã awɛkaci</para>
  <para style="q2" vid="MAT 21:16">nu írheng awɛkaci</para>
  <para style="q2" vid="MAT 21:16">umbɔ akpoi ungo?&gt;<note caller="+" style="f"><char style="fr" closed="false">21.16 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="PSA 8:2">Amb 8.2</ref></char>.</note>&gt;&gt;<verse eid="MAT 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17"/>Mɔcɛ unga abvui azĩã Ubetani, anangkɛ unga aka arha nu untsuua ha.<verse eid="MAT 21:17"/></para>
  <para style="s1">Ikponum ucucii uvorhvo</para>
  <para style="r">(<ref loc="MRK 11:12-14">Umar 11.12-14</ref>,<ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18"/>Ri igɔ̃kpeeka, unga awu ru utsĩndĩ uwuku ubvui uba utepa, imerh ifɛr unga. <verse eid="MAT 21:18"/><verse number="19" style="v" sid="MAT 21:19"/>Unga aka anyã ucucii uvorhvo nu ibang utsĩndĩã, unga azĩ ru ucucii ha asi ikpoa ubin akpurha anyã ayerhe. Mɔcɛ unga agɔr ucucii ha agɛ, &lt;&lt;Ungo usi íbvui ughwɛrɔ ikpũrhã!&gt;&gt; Kanying ucuciia ha ukoyimgbɔ.<verse eid="MAT 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20"/>Ivang angwɛ̃ imesanga aka anyã rimi, umbɔ adzeidzeu akarhãrhã. Agɛ, &lt;&lt;Awu use utsu ucuciia ha udiki ikoyi iki ifefetem?&gt;&gt;<verse eid="MAT 21:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Umum indɛyiwa umbi idzidzɛrhe, umbi aba awembi ri imangmang na asi icangmbi, umbi adɛ̃ɛ̃ akorha anangmbi ubinkpi umum iki ikorhuwe ucucii uvorhvo uwurɛ. Uko umbi adɛ̃ɛ̃ agɔrmbi uko igũ iyɛrɛ agɛ, &lt;Ugɔ̃rhũ itsingo utsĩ ru ukau ukugɔng,&gt; ngge iwuri ikorhungge. <verse eid="MAT 21:21"/><verse number="22" style="v" sid="MAT 21:22"/>Umbi aba awembi ri imangmang, ubɛn ubina umbi aka ifɛna ri ifɛn-Num, umbi awuri ikpombi.&gt;&gt;<verse eid="MAT 21:22"/></para>
  <para style="s1">Arhusu ijee Uyesu</para>
  <para style="r">(<ref loc="MRK 11:27-33">Umar 11.27-33</ref>; <ref loc="LUK 20:1-8">Irh 20.1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23"/>Uyesu aka atsĩ ru ufɔm Iya-Num na adɛ̃ɛ̃ imesuwe, mɔcɛ ateiya abika adzowe idɛm-Num nu akakũ anera aba ru unga. Arhusa unga agɛ, &lt;&lt;Ungo ukũ ijee iyikisong ukorha abin akɛrɛ? Ungaa adzaa ungo ijee ha?&gt;&gt;<verse eid="MAT 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Umum irhusa umbi ubina unying. Umbi aba adɛyiwambi umum, umum idɛyiwamum umbi ijee iyikisong umum iki ikũ ikorha abin hã. <verse eid="MAT 21:24"/><verse number="25" style="v" sid="MAT 21:25"/>Ubɔtisima Uyohana udzek ri inɛ̃ɛ̃ umgbɔ? Udzek ra afã, use udzek ra anera?&gt;&gt;</para>
  <para style="p" vid="MAT 21:25">Umbɔ arherhe nggu adɔka agɛ, &lt;&lt;Umɛn iba igɔr ugɛ, &lt;Udzek ra afã,&gt; unga awuri irhusa umɛn agɛ, &lt;Awu use utsu umbi ashimbi ri imangmang ru unga?&gt; <verse eid="MAT 21:25"/><verse number="26" style="v" sid="MAT 21:26"/>Bɔr umɛn iba igɔr ugɛ, &lt;Udzek ra anera,&gt; umɛn igũ iwei anera abɛrɛ, ubinkutsu, umbɔ anyangu Uyohana awu uner uwuku usɔm Arherhu-Num.&gt;&gt;<verse eid="MAT 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27"/>Nggee umbɔ agɔr Uyesu agɛ, &lt;&lt;Umɛn isi ihwɛngmɛn.&gt;&gt;</para>
  <para style="p" vid="MAT 21:27">Mɔcɛ unga agɔr umbɔ agɛ, &lt;&lt;Umum igamum isi ídɛyiwamum umbi umum ikũ ijee iyikisong ikorha abin hã.<verse eid="MAT 21:27"/></para>
  <para style="s1">Unyaka arherhe aki uner <optbreak/> awɛkatsa avaa</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28"/>&lt;&lt;Umbi anyã aguse? Unera nuwɔ awu ra awɛkaci avaa akatsa. Unga azĩ ru uwu inggbaashia agɛ, &lt;A ungwɛ̃mum, irherɛ uzĩ utɔ̃itser ri icang inebi.&gt;<verse eid="MAT 21:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29"/>&lt;&lt;Ungwɛ̃ hã agɛ, &lt;Umum isi ízĩmum,&gt; bɔr unga abvui akaifɛrhkɔ ra amɛnnga na asok azĩã.<verse eid="MAT 21:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30"/>&lt;&lt;Mɔcɛ utɛmbɔ azĩã ru uwu uvaa, arherhe rimi hã. Ungwɛ̃ hã agɛ, &lt;Ĩĩ, umum izĩmum,&gt; bɔr asi izĩã.<verse eid="MAT 21:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31"/>&lt;&lt;Uwukusong akorhu ubinkpi utɛmbɔ aka abee?&gt;&gt;</para>
  <para style="p" vid="MAT 21:31">Umbɔ agɛ, &lt;&lt;Uwu inggbaashia.&gt;&gt;</para>
  <para style="p" vid="MAT 21:31">Uyesu agɔr umbɔ agɛ, &lt;&lt;Umum indɛyiwa umbi idzidzɛrhe, abika iyɛi ikirbi abĩ nu anggoyi awuri igbaashia atsĩmbɔ ri Iyɛrhe afã ru umbi. <verse eid="MAT 21:31"/><verse number="32" style="v" sid="MAT 21:32"/>Ubinkutsu, Uyohana aba adɛyiwa umbi utsĩndĩ uwuku urhurhika, umbi ashimbi ri imangmang ru unga, bɔr abika ayɛi ikirbi abĩ nu anggoyi awembɔ ri imangmang ru unga. Umbi uko umbi aka anyã akɛrɛ, asi idzipumbi na iwembi ri imangmang ru unga.<verse eid="MAT 21:32"/></para>
  <para style="s1">Unyaka arherhe abi irham imang</para>
  <para style="r">(<ref loc="MRK 12:1-12">Umar 12.1-12</ref>; <ref loc="LUK 20:9-19">Irh 20.9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33"/>&lt;&lt;Àka akpeto ru unyaka arherhe akɔɔ. Unera nuwɔ akau icang inebi. Adzin ufɔm adzipu icanga, asim ughwee ri ifa ukpuku upayi amɛ̃ inebi ha ri ngge, na atar akang utsurha udedetamgbɔ uwu idzɛu. Adzowe icanga ra abi irham imang, na azĩã uzɛ̃rhã. <verse eid="MAT 21:33"/><verse number="34" style="v" sid="MAT 21:34"/>Ivang iyiki igbigbɛr iki iwe, unga adene agãrhãnga umbɔ azĩmbɔ ra abi irham imang hã ayɛise ikpũrhã icangnga.<verse eid="MAT 21:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 21:35"/>&lt;&lt;Abi irham imang hã adzur agãrhũ utsak ha akwɛr unying, na afɛre unying, na atang atarh ru uwu untaar. <verse eid="MAT 21:35"/><verse number="36" style="v" sid="MAT 21:36"/>Mɔcɛ unga abvui adene agãrhã abɔɔ ru umbɔ aka anangmbɔ abi inggbaashia. Bɔr abi irham imang hã akorhe ru nyaka umbɔ aka akorhe nggu abi inggbaashia. <verse eid="MAT 21:36"/><verse number="37" style="v" sid="MAT 21:37"/>Ri imimasha kishoo, unga adene ungwɛ̃nga, agɛ, &lt;Awuri idzowukumbɔ imor ru ungwɛ̃mum.&gt;<verse eid="MAT 21:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38"/>&lt;&lt;Bɔr abi irham imang hã aka anyã ungwɛ̃ hã, umbɔ agɔr adɔkambɔ agɛ, &lt;Uwɛrɛ unga awu ru ukam icang hã. Umɛn ifɛre unga ni icanga iwu iyimɛn!&gt; <verse eid="MAT 21:38"/><verse number="39" style="v" sid="MAT 21:39"/>Nggee umbɔ adzur unga, atare unga ru undzing ufɔm icang hã, afɛre unga.<verse eid="MAT 21:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40"/>&lt;&lt;Nggee, ivang uner icang hã aba abanga, unga awuri ikorha aguse nggu abi irham imang hã?&gt;&gt;<verse eid="MAT 21:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41"/>Umbɔ agɔr unga agɛ, &lt;&lt;Awuri ifɛruka abika abewa ha, na adzowe icanga ra abi irham imang abɔɔ, abirabɛ aka awuri idzowe ugau ikpũrhã icangnga ri ivangngge.&gt;&gt;<verse eid="MAT 21:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Umbi anasi ivarhumbi ri itsɛng Arherhu-Num? Igɔr ugɛ,</para>
  <para style="q1" vid="MAT 21:42">&lt;&lt; &lt;Utarhkpi abi idzin aka akpɛ̃,</para>
  <para style="q2" vid="MAT 21:42">ukpɔ uwu utarh ãgboki idzina.</para>
  <para style="q1" vid="MAT 21:42">Akɛrɛ awu ubinkpi Uteijee aka akorhe,</para>
  <para style="q2" vid="MAT 21:42">na awu ubin idzeu ra asumɛn.&gt;<verse eid="MAT 21:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43"/>&lt;&lt;Nggee umum idɛyiwa umbi, awuri ivurmbɔ Iyɛrhe Unum ru umbi na adzowe abika aghwɛr ikpũrhã iyi Iyɛrhe Unum. <verse eid="MAT 21:43"/><verse number="44" style="v" sid="MAT 21:44"/>Uner ha aka igba ni itsi utarh iyɛrɛ, akpurha ashaka. Nu uwuruwi utarh ha uku igba nú unga, ukpurhu ugɔke unga.&gt;&gt;<verse eid="MAT 21:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45"/>Ivang ateiya abika adzowe idɛm-Num nu abi Ufarisi aka agũ unyaka arherhe Uyesu aka adzowe, umbɔ ahwɛngmbɔ ugɛ arherhe ri itsimbɔ. <verse eid="MAT 21:45"/><verse number="46" style="v" sid="MAT 21:46"/>Umbɔ abee udĩ ukpuku udzur unga, bɔr umbɔ agũ iwei, ubinkutsu, ikikɔng anera anyanga unga awu uner uwuku usɔm Arherhu-Num.<figure style="fig" alt="Grape farm with watchtower and winepress" file="lb00103b.tif" size="span" loc="21.46" copy="Louise Bass" ref="21.33">Icang inebi nu utsurha uwuku uder uwu idzɛu nu ughwee ukpuku ukpai amɛ̃ inebi</figure><verse eid="MAT 21:46"/></para>
  <chapter eid="MAT 21"/>
  <chapter number="22" style="c" sid="MAT 22"/>
  <para style="s1">Unyaka arherhe aki irhowu ipfuna</para>
  <para style="r">(<ref loc="LUK 14:15-24">Irh 14.15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1"/>Uyesu abvui arherhuwe umbɔ unyaka arherhe agɛ, <verse eid="MAT 22:1"/><verse number="2" style="v" sid="MAT 22:2"/>&lt;&lt;Iyɛrhe afã iwu ru nyaku uyɛrhe uwɔɔ aka akorhuwe irhowa ipfuna ru ungwɛ̃nga. <verse eid="MAT 22:2"/><verse number="3" style="v" sid="MAT 22:3"/>Adene agãrhãnga azĩ ayisuwe abirabɛ umbɔ aka aghwi umbɔ ipfuna hã aba, bɔr umbɔ akpɛ̃mbɔ ibibanga.<verse eid="MAT 22:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4"/>&lt;&lt;Mɔcɛ unga abvui adene agãrhã abika arhɛɛ agɛ, &lt;Àka adɛyiwe abirabɛ umbɔ aka aghwi ugɛ umum iki ikorhumum ubinghaa. Iki ingwã ínak iyiki itsak nggu angwɛ̃ inak aka agɔnga, abina kishoo iki igbisha imaamum. Àka aba irhowa ha!&gt;<verse eid="MAT 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5"/>&lt;&lt;Bɔr umbɔ asi inyãmbɔ ngge iwengge ifɛrhɛ, na azĩmbɔ. Uwɔɔ azĩã usinga, uwɔɔ azĩã igoyi igoi ri izɛɛ. <verse eid="MAT 22:5"/><verse number="6" style="v" sid="MAT 22:6"/>Abɔɔ adzur agãrhãnga, ayɔm na afɛre umbɔ. <verse eid="MAT 22:6"/><verse number="7" style="v" sid="MAT 22:7"/>Uyɛrhe ha agũ avɔm. Unga adene abi iwanga, umbɔ afɛrkumbɔ umbɔ abika afɛyi aner ha na akpĩĩwe uteumbɔ kishoo.<verse eid="MAT 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8"/>&lt;&lt;Mɔcɛ unga agɔr agãrhãnga agɛ, &lt;Aka amaambɔ izek irhowa ha, bɔr abirabɛ umum iki ighwi isi imɛ̃ngge umbɔ aba. <verse eid="MAT 22:8"/><verse number="9" style="v" sid="MAT 22:9"/>Àka adzek adɔsa atsĩndĩ aka agbopa ayisa kishoo abirabɛ umbi aka akpo, umbɔ aba irhowa ha.&gt; <verse eid="MAT 22:9"/><verse number="10" style="v" sid="MAT 22:10"/>Nggee agãrhã hã adzek adɔsa atsĩndĩã ayisa kishoo abirabɛ umbɔ aka akpo, abika aze nu abika abewe, anang irhowa ha atɔk nggu atsen.<verse eid="MAT 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11"/>&lt;&lt;Bɔr ivangyɛ uyɛrhe aka atsĩ abee inyã abi irhowa ha, umɔ unga anyã uner uwɔɔ aka asi itsima atorho irhowa. <verse eid="MAT 22:11"/><verse number="12" style="v" sid="MAT 22:12"/>Uyɛrhe arhusu uner ha agɛ, &lt;A uwee, ungo ukorhu uguse nu utsĩwã nggimi ushiɔ ra atorho irhowa?&gt; Bɔr uner ha asi idzipunga urhɛm.<verse eid="MAT 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13"/>&lt;&lt;Mɔcɛ uyɛrhe agɔr abi itsernga agɛ, &lt;Àka abow aboknga nu adaknga, na atare unga adzek atsĩ ru uzĩ, anangkɛ anera aka iciu akpe na atãi anyĩ.&gt;<verse eid="MAT 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14"/>&lt;&lt;Ubinkutsu awuri ighwi anera arhɛrhɛ, bɔr ukunjiir umbɔ aka isɛng.&gt;&gt;<verse eid="MAT 22:14"/></para>
  <para style="s1">Irhusu ifai ikirbi abĩ ru Ukaisar</para>
  <para style="r">(<ref loc="MRK 12:13-17">Umar 12.13-17</ref>; <ref loc="LUK 20:20-26">Irh 20.20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15"/>Mɔcɛ abi Ufarisi adzek akɛki itsũwãyɛ umbɔ aka ideya unga ru irhɛmnga. <verse eid="MAT 22:15"/><verse number="16" style="v" sid="MAT 22:16"/>Umbɔ adene angwɛ̃ imesambɔ nggu aner Uhiridu agɛ, &lt;&lt;A umarhem, umɛn ihwɛngmɛn ungo uwu uner idzidzɛrhe, ikɛi ungo uni imesuwe ubinkpi Unum aka abee nggu idzidzɛrhe. Ubinkutsu ungo usi itsukɔ amɛnngo ri ifɛrhkɔ anera use ubinkpi umbɔ aka awe. <verse eid="MAT 22:16"/><verse number="17" style="v" sid="MAT 22:17"/>Udɛyiwa umɛn, imɛ̃ngge umɛn ifai ikirbi abĩ ru Ukaisar, use isi imɛ̃ngge?&gt;&gt;<verse eid="MAT 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18"/>Bɔr Uyesu ahwɛnga ifɛrhkɔ iyiki ibewambɔ, unga agɔr umbɔ agɛ, &lt;&lt;Umbi abi ukpukpeta, awu use utsu umbi adeya umum? <verse eid="MAT 22:18"/><verse number="19" style="v" sid="MAT 22:19"/>Àka adɛyiwa umum ishaa imangyɛ umbi iki ikũ afai ikirbi abĩ.&gt;&gt; Umbɔ akowe unga ishaa imang hã, <verse eid="MAT 22:19"/><verse number="20" style="v" sid="MAT 22:20"/>unga arhusa umbɔ agɛ, &lt;&lt;Uzirhzĩ ukpi nu itsok ikɛrɛ iwu iki ungaa?&gt;&gt;<verse eid="MAT 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21"/>Umbɔ agɛ, &lt;&lt;Iki Ukaisar.&gt;&gt; Mɔcɛ unga agɔr umbɔ agɛ, &lt;&lt;Àka adzowe Ukaisar abinkɛ aka awe aki Ukaisar, ikɛi àka adzowe Unum abinkɛ aka awe aki Unum.&gt;&gt;<verse eid="MAT 22:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22"/>Umbɔ aka agũ rimi, umbɔ adzeidzeu. Nggee umbɔ abɔre unga na azĩmbɔ.<verse eid="MAT 22:22"/></para>
  <para style="s1">Irhusa isisok ra akpe</para>
  <para style="r">(<ref loc="MRK 12:18-27">Umar 12.18-27</ref>; <ref loc="LUK 20:27-40">Irh 20.27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23"/>Ru unum hã abi Usaduki, abika agɔr ugɛ isok ra akpe ishingge, aba ru unga arhusa agɛ, <verse eid="MAT 22:23"/><verse number="24" style="v" sid="MAT 22:24"/>&lt;&lt;A umarhem, Umusa agɔr agɛ, &lt;Unera aba akpe na ashia ra awɛkaci, awu ufang ungwɛ̃mbɔ apfunu utsɛrh ha amare awɛkaci ru unga.&gt; <verse eid="MAT 22:24"/><verse number="25" style="v" sid="MAT 22:25"/>Umɔ abɔɔ rabɔ awu angwɛ̃yi utɔɔva ru umɛn. Uwu inggbaashia apfuna na akpea, asi imara awɛkaci, abɔruka utsɛrh ha ru ungwɛ̃mbɔ. <verse eid="MAT 22:25"/><verse number="26" style="v" sid="MAT 22:26"/>Rimi hã iki iwe nggu ungwɛ̃mbɔ uwu uvaa nu uwu untaar, uzĩ itsĩ ru uwu utɔɔva. <verse eid="MAT 22:26"/><verse number="27" style="v" sid="MAT 22:27"/>Ri imimasha utsɛrh ha akpea. <verse eid="MAT 22:27"/><verse number="28" style="v" sid="MAT 22:28"/>Ru unumkpi abika akpe aka isok ra akpe, utsɛrh ha awuri iwu uwu ungaa ru umbɔ utɔɔva ha? Ubinkutsu, kishookambɔ utɔɔva aka apfuna unga.&gt;&gt;<verse eid="MAT 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Umbi agba irhak, ubinkutsu, umbi asi ihwɛngmbi itsɛng Arherhu-Num use ijee Unum. <verse eid="MAT 22:29"/><verse number="30" style="v" sid="MAT 22:30"/>Ri isok ra akpe anera asi ípfunumbɔ, asi ídzowukumbɔ ipfuna. Anera awuri iwe ru nyaka ípfu itser-Num ra afã. <verse eid="MAT 22:30"/><verse number="31" style="v" sid="MAT 22:31"/>Bɔr arherhi isisok abika akpukpe, umbi anasi ivarhumbi ubinkpi Unum aka adɛyiwa umbi? <verse eid="MAT 22:31"/><verse number="32" style="v" sid="MAT 22:32"/>Unga agɔr agɛ, &lt;Umum iwu Unum uwu Uibrahim, Unum uwu Uishaku, nu Unum uwu Uyakubu.&gt;<note caller="+" style="f"><char style="fr" closed="false">22.32 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="EXO 3:6">Idzi 3.6</ref></char>.</note> Unga asi iwea Unum uwu abika akpukpe bɔr awu Unum uwu abi urhɛ.&gt;&gt;<verse eid="MAT 22:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33"/>Ivangyɛ ikikɔnga iki igũ rimi, umbɔ adzeidzeu imesanga.<verse eid="MAT 22:33"/></para>
  <para style="s1">Ikpem iyiki igɔnga</para>
  <para style="r">(<ref loc="MRK 12:28-34">Umar 12.28-34</ref>; <ref loc="LUK 10:25-28">Irh 10.25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34"/>Abi Ufarisi aka agũ ugɛ Uyesu aka atsu abi Usaduki awu uku uvep, umbɔ akɔng. <verse eid="MAT 22:34"/><verse number="35" style="v" sid="MAT 22:35"/>Unying ru umbɔ uwuku uhwɛng Ikpem akarhãrhã, avira arhusa unga agɛ, <verse eid="MAT 22:35"/><verse number="36" style="v" sid="MAT 22:36"/>&lt;&lt;A umarhem, ikpem iyikisong iwu iyiki igɔnga ri Íkpem Umusa?&gt;&gt; <verse eid="MAT 22:36"/><verse number="37" style="v" sid="MAT 22:37"/>Uyesu agɔr unga agɛ, &lt;&lt; &lt;Ubemu Uteijee Unumngo nggu amɛnngo kishoo nu ipfungo kishoo nu adzɛnngo kishoo.&gt;<note caller="+" style="f"><char style="fr" closed="false">22.37 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="DEU 6:5">Iva 6.5</ref></char>.</note> <verse eid="MAT 22:37"/><verse number="38" style="v" sid="MAT 22:38"/>Ikpem iyɛrɛ ngge iwu iyi inggbaashia nu iyiki igɔnga. <verse eid="MAT 22:38"/><verse number="39" style="v" sid="MAT 22:39"/>Nu iyi uvaa iwu ru nyaki iyi unggbaashi ha igɛ, &lt;Ubemu undɔkango ru nyaki itsikamngo.&gt;<note caller="+" style="f"><char style="fr" closed="false">22.39 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="LEV 19:18">Urha 19.18</ref></char>.</note> <verse eid="MAT 22:39"/><verse number="40" style="v" sid="MAT 22:40"/>Kishoo Íkpem Umusa nu imesa abika asɔm Arherhu-Num iyurhi nú atsi íkpem iyɛrɛ ikivarhangge.&gt;&gt;<verse eid="MAT 22:40"/></para>
  <para style="s1">Ukiristo awu ungwɛ̃ ungaa?</para>
  <para style="r">(<ref loc="MRK 12:35-37">Umar 12.35-37</ref>; <ref loc="LUK 20:41-44">Irh 20.41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41"/>Ivangyɛ abi Ufarisi aka akɔng ananga unying, Uyesu arhusa umbɔ agɛ, <verse eid="MAT 22:41"/><verse number="42" style="v" sid="MAT 22:42"/>&lt;&lt;Ifɛrhkɔ umbi iwu use ri itsi Ukiristo? Unga awu ungwɛ̃ ungamɔ?&gt;&gt;</para>
  <para style="p" vid="MAT 22:42">Umbɔ agɛ, &lt;&lt;Ungwɛ̃ Udauda.&gt;&gt;<verse eid="MAT 22:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43"/>Unga agɔr umbɔ agɛ, &lt;&lt;Awu use utsu Udauda ri ijee Ipfu-Num ayisa unga agɛ, &lt;Uteijee&gt;? Ubinkutsu, unga agɛ,<verse eid="MAT 22:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44"/>&lt;&lt; &lt;Uteijee agɔr Uteijeemum agɛ,</para>
  <para style="q2" vid="MAT 22:44">&lt;&lt;Usei ru ubok ughamum,</para>
  <para style="q1" vid="MAT 22:44">utsɛku umum iki itsu anggamtsakngo</para>
  <para style="q2" vid="MAT 22:44">ru andaidakngo.&gt;&gt; &gt;<note caller="+" style="f"><char style="fr" closed="false">22.44 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="PSA 110:1">Amb 110.1</ref></char>.</note><verse eid="MAT 22:44"/></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45"/>Udauda aba ayisu Ukiristo agɛ, &lt;Uteijee,&gt; awu use utsu Ukiristo awu ungwɛ̃nga?&gt;&gt; <verse eid="MAT 22:45"/><verse number="46" style="v" sid="MAT 22:46"/>Unera asi idɛ̃ɛ̃ adzipuka unga urhɛm. Udzur ru unum hã, asi ikpombɔ unera aka abvui arhusa unga arherhe.<verse eid="MAT 22:46"/></para>
  <chapter eid="MAT 22"/>
  <chapter number="23" style="c" sid="MAT 23"/>
  <para style="s1">Ifakpe utɔɔva</para>
  <para style="r">(<ref loc="MRK 12:38-40">Umar 12.38-40</ref>; <ref loc="LUK 11:37-54">Irh 11.37-54</ref>; <ref loc="LUK 20:45-47">20.45-47</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1"/>Mɔcɛ Uyesu agɔr ikikɔnga nu angwɛ̃ imesanga agɛ, <verse eid="MAT 23:1"/><verse number="2" style="v" sid="MAT 23:2"/>&lt;&lt;Abika imesuwe Ikpem nggu abi Ufarisi asei nú anang isei Umusa. <verse eid="MAT 23:2"/><verse number="3" style="v" sid="MAT 23:3"/>Nggee awu ufang umbi adɔsa umbɔ na akorhe ubɛn ubinkpi umbɔ aka amesuwa umbi. Bɔr àka aneke ikorhe abinkɛ umbɔ iki ikorhe. Umbɔ asi ikorhumbɔ abinkɛ umbɔ iki imesuwe. <verse eid="MAT 23:3"/><verse number="4" style="v" sid="MAT 23:4"/>Umbɔ aka isaka abow abin aka amor atsake nú acɛi anera, bɔr umbɔ nibikambɔ asi ikũ itokmbɔ ayikukumbɔ umbɔ.<verse eid="MAT 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5"/>&lt;&lt;Ubɛn ubinkpi umbɔ aka ikorhe abee anera anyã. Abinkɛ umbɔ aka aboyi nú ashimbɔ nu abokmbɔ awe aki Arherhu-Num, unyã umbɔ aka akorha ake agɔgɔng. Nu arhurhukɛ umbɔ aka asɔr ri ifɛn atorhambɔ, atsu ake adeder. <verse eid="MAT 23:5"/><verse number="6" style="v" sid="MAT 23:6"/>Umbɔ abee anang isei akagɔng ri irhowa nu ra abã ifɛn-Num. <verse eid="MAT 23:6"/><verse number="7" style="v" sid="MAT 23:7"/>Na agɔm anera aghwe umbɔ ri inang izɛɛ, na agɔm umbɔ ayisa umbɔ agɛ, &lt;Amarhem.&gt;<verse eid="MAT 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8"/>&lt;&lt;Bɔr umbi, awu ufang umbɔ asi íyisumbɔ umbi &lt;Amarhem,&gt; ubinkutsu, umbi awu ru uwuku umesuwe unying, umbi awu angwɛ̃yi. <verse eid="MAT 23:8"/><verse number="9" style="v" sid="MAT 23:9"/>Àka niba ayisumbi unera ra abĩ agɛ, &lt;Utɛ,&gt; ubinkutsu, umbi awu ru Utɛ unying, unga awu ra afã. <verse eid="MAT 23:9"/><verse number="10" style="v" sid="MAT 23:10"/>Use ayisa umbi agɛ, &lt;Uwuku umesuwe,&gt; ubinkutsu, umbi awu ru uwuku umesuwa umbi unying, Ukiristo ha. <verse eid="MAT 23:10"/><verse number="11" style="v" sid="MAT 23:11"/>Uwuruwi aka uwu ukugɔnga ru umbi, awu ufang unga awu ugãrhãmbi. <verse eid="MAT 23:11"/><verse number="12" style="v" sid="MAT 23:12"/>Ubɛn unerwi aka aberi itsinga, awuri irhɛrhuwe ike. Bɔr uwuruwi aka arhɛrhuwe itsinga, awuri ibiberuwe ike.<verse eid="MAT 23:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13"/>&lt;&lt;Atorhmbi, abika amesuwe Ikpem nu abi Ufarisi, abi ukpukpeta! Umbi afɔmukumbi angwĩ aka atsĩ ru Iyɛrhe afã ra asu anera. Umbi nibikambi asi itsĩmbi, na akɛnmbi abika abee itsitsĩ.<note caller="+" style="f"><char style="fr" closed="false">23.13 </char><char style="ft" closed="false">Abvur akɔɔ aki itsɛng abok aki isha agɔrke ikɛi ugɛ, </char><char style="fv" closed="false">14 </char><char style="fqa" closed="false">Atorhmbi, abika amesuwe Ikpem nu abi Ufarisi, umbi abi ukpukpeta! Umbi aka isaka abvur abin atsɛ̃rhãpfu, ikɛi umbi agɔm ifɛn-Num iyiki ider ra anera anyã ugɛ umbi awu abika aze. Unum awuri itsuka umbi uvau akarhãrhã.</char></note><verse eid="MAT 23:13"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15"/>&lt;&lt;Atorhmbi, abika amesuwe Ikpem nu abi Ufarisi, abi ukpukpeta! Umbi aka isaka azɛ̃rhã ra akau akagɔng nú abĩ azĩmbi ibee uner uwuku udzipa unying. Ivangyɛ umbi aka ikpo unying, umbi atsu unga ada idiki ivaa ananga umbi aka awe abi idzũũ urha.<figure style="fig" alt="Pharisee with written Word of God on forehead" file="hk00274b.tif" size="col" loc="23.15" copy="Horace Knowles" ref="23.15">Utsa Ufarisi nggu itsɛng Arherhu-Num ri ishinga</figure><verse eid="MAT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16"/>&lt;&lt;Atorhmbi, abi ibvuta abika adarh anera! Umbi iki igɔr agɛ, &lt;Ubɛn uwuku uyirh Iya-Num, asi iwea ifɛrhɛ. Bɔr ubɛn uwuku uyirh nggu uzinarhi ukpu Iya-Num, awu ufang unga iki ikorhu ubinkpi unga aka ayirh.&gt; <verse eid="MAT 23:16"/><verse number="17" style="v" sid="MAT 23:17"/>Umbi agugge abi ibvuta! Ukpuku usong unang, uzinarhi use Iya-Num iki isare uzinarhi hã? <verse eid="MAT 23:17"/><verse number="18" style="v" sid="MAT 23:18"/>Ikɛi umbi aki igɔr agɛ, &lt;Ubɛn uwuku uyirh nggu ubeu Iya-Num, asi iwea ifɛrhɛ. Bɔr ubɛn uwuku uyirh nggu izũwãyɛ umbɔ aka angwɛ̃ nú ubeu ha, awu ufang unga akorhu ubinkpi unga aka ayirh.&gt; <verse eid="MAT 23:18"/><verse number="19" style="v" sid="MAT 23:19"/>Umbi abi ibvuta! Uwukusong anang, izũwã, use ubeu uwuku utsu izũwã isar? <verse eid="MAT 23:19"/><verse number="20" style="v" sid="MAT 23:20"/>Nggee, uwuku uyirh nggu ubeu ayirh nggu umgbɔ nu ubɛn ubin uku unu umɔ. <verse eid="MAT 23:20"/><verse number="21" style="v" sid="MAT 23:21"/>Nu unga uwuku uyirh nggu Iya-Num, ayirh nggu ike nu unga uwuruwi aka asei umɔ. <verse eid="MAT 23:21"/><verse number="22" style="v" sid="MAT 23:22"/>Nu ubɛn uwuku uyirh afã, ayirh anang isei Unum nu uwuku usei nú ake.<verse eid="MAT 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23"/>&lt;&lt;Atorhmbi, abika amesuwe Ikpem Umusa nu abi Ufarisi, abi ukpukpeta! Umbi aka isaka adzowe izũwã abin akaci, ru nyaka ayerhu udzau akaci. Na akwɛɛrkumbi abin aka amora ri Íkpem Umusa, ru nyaki izharha arherhe idzidzɛrhe, atorh, nu imangmang. Imɛ̃ɛ̃ngge umbi akorha abina akɛrɛ na asi ikwɛɛrkumbi akɔɔ. <verse eid="MAT 23:23"/><verse number="24" style="v" sid="MAT 23:24"/>Umbi abika adarh anera ri ibvuta, umbi aki isaka asɛkmbi amurhu, bɔr angurhũmbi arhakumi!<verse eid="MAT 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25"/>&lt;&lt;Atorhmbi, abika amesuwe Ikpem nu abi Ufarisi, abi ukpukpeta! Umbi aka isaka asorhe andzing akpɛwa nu atɛ̃rhãzɔu. Bɔr ru unɔrkang atɔk nggu abinkɛ umbi aka akpo ri inggang nu ibemitsi. <verse eid="MAT 23:25"/><verse number="26" style="v" sid="MAT 23:26"/>Ungo uner ibvuta, Ufarisi! Ugbaashia usorh unɔrkang ukpɛwa nu itɛ̃rhãzɔu. Ungo uba ukorhungo rimi, awiya awuri iwu atɛtɛn.<verse eid="MAT 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27"/>&lt;&lt;Atorhmbi, abika amesuwe Ikpem nu abi Ufarisi, abi ukpukpeta! Umbi awe ru nyaka adzakɛ umbɔ iki itsu abĩ aka aterha, aka aze izɛrhe ra awiya, bɔr ru unɔrkang atɔk nggu apfupfu ikom anera nu ubɛn ikpũ arhim. <verse eid="MAT 23:27"/><verse number="28" style="v" sid="MAT 23:28"/>Rimi hã, anera aka isaka anyã umbi awu abika arhurhika ra awiya, bɔr ru unɔrkang umbi awu abi ukpukpeta nu iki ibewe.<verse eid="MAT 23:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29"/>&lt;&lt;Atorhmbi, abika amesuwe Ikpem nu abi Ufarisi, abi ukpukpeta! Umbi aka isaka adzin adzak aki abika asɔm Arherhu-Num na agberhe idzam adzak abika arhurhika. <verse eid="MAT 23:29"/><verse number="30" style="v" sid="MAT 23:30"/>Nu umbi aka isaka agɔr agɛ, &lt;Agɛ umɛn iwe ri ivang atokamɛn, umɛn ĩba isi itsĩmɛn ubok ri ifɛr abika asɔm Arherhu-Num.&gt; <verse eid="MAT 23:30"/><verse number="31" style="v" sid="MAT 23:31"/>Rimi hã umbi adekuwe atsimbi ugɛ umbi awu angwɛ̃ abika afɛr abika asɔm Arherhu-Num. <verse eid="MAT 23:31"/><verse number="32" style="v" sid="MAT 23:32"/>Àka amasha amɛn aka atãrhã aki atokambi aka atirhi!<verse eid="MAT 23:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33"/>&lt;&lt;Umbi íbvui! Umbi angwɛ̃ ighwɛr! Umbi awuri ikorha aguse na adzek ru uvau idzũ urha? <verse eid="MAT 23:33"/><verse number="34" style="v" sid="MAT 23:34"/>Nggee umum idene abika asɔm Arherhu-Num nu abi itsoi nu abi imesa aba ru umbi. Abɔɔ umbi awuri ifɛr na anyapuwe, abɔɔ umbi awuri ikwɛr ra abã ifɛn-Nummbi na akɛn umbɔ atsĩrhĩ íteu. <verse eid="MAT 23:34"/><verse number="35" style="v" sid="MAT 23:35"/>Nggee awuri itsuke adzirh abika arhurhika kishoo umbɔ aka afɛr ru upfung abvui aba ra atsimbi, udzur ra adzirh Uhabirha uner uwuku urhika uba utsĩ Uzakariya ungwɛ̃ Uberikiya, uwuruwi umbi aka afɛr ra ateu Iya-Num nu ubeu idɛm-Num. <verse eid="MAT 23:35"/><verse number="36" style="v" sid="MAT 23:36"/>Umum indɛyiwa umbi idzidzɛrhe, kishoo akɛrɛ awuri ikorhe nggu aner ivang iyɛrɛ.<verse eid="MAT 23:36"/></para>
  <para style="s1">Amɛn Uyesu aghong ru Urusharhima</para>
  <para style="r">(<ref loc="LUK 13:34-35">Irh 13.34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37"/>&lt;&lt;Oka Urusharhima, Urusharhima! Ungo ufɛr abika asɔm Arherhu-Num nu utang atarh ra abirabɛ umbɔ aka adene umbɔ aba ru umbi. Idiki isong umum iki ibee ikɔng angwɛ̃mbi ananga unying, ru nyaki inũ iki isaki ikɔng angwɛ̃ngge ra afɛkngge, bɔr umbi akpɛ̃mbi. <verse eid="MAT 23:37"/><verse number="38" style="v" sid="MAT 23:38"/>Unyã ucɛ, aneke iyambi arhanga. <verse eid="MAT 23:38"/><verse number="39" style="v" sid="MAT 23:39"/>Umum idɛyiwa umbi, umbi asi íbvui anyãmbi umum utsɛku umbi aka igɔr agɛ, &lt;Idorh iwe nggu uwuku uba ri itsok Uteijee.&gt; <note caller="+" style="f"><char style="fr" closed="false">23.39 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="PSA 118:26">Amb 118.26</ref></char>.</note>&gt;&gt;<verse eid="MAT 23:39"/></para>
  <chapter eid="MAT 23"/>
  <chapter number="24" style="c" sid="MAT 24"/>
  <para style="s1">Atsar aki imimasha upfung</para>
  <para style="r">(<ref loc="MRK 13:1-37">Umar 13.1-37</ref>; <ref loc="LUK 21:5-33">Irh 21.5-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1"/>Uyesu aka adzek ri Iya-Num azɛ̃rhã azĩã, ri ivang hã angwɛ̃ imesanga aba ru unga, adɛyiwe unga ídzin Iya-Num. <verse eid="MAT 24:1"/><verse number="2" style="v" sid="MAT 24:2"/>Unga agɔr umbɔ agɛ, &lt;&lt;Umbi anyãmbi abin akɛrɛ kishoo? Umum indɛyiwa umbi idzidzɛrhe, utarh unying asi íneke ukpɔ utsorhukpɔ nú udɔka. Ubɛn unying awuri isisipuwe.&gt;&gt;<verse eid="MAT 24:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3"/>Uyesu aka asei ni Igũ Acucii Uzaitun, angwɛ̃ imesanga ikiyikambɔ aba agɔr unga agɛ, &lt;&lt;Usɔma umɛn, ifɛrhɛ ha iwu ri ivang iyiki isong? Awu use uwu utsar ibibango nu imimaa upfunga?&gt;&gt;<verse eid="MAT 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Àka arhi, utsur unera arhɛma umbi. <verse eid="MAT 24:4"/><verse number="5" style="v" sid="MAT 24:5"/>Anera arhɛrhɛ awuri iba ri itsokmum, awuri igɔr agɛ, &lt;Umum iwu Ukiristo,&gt; awuri irhɛm anera arhɛrhɛ. <verse eid="MAT 24:5"/><verse number="6" style="v" sid="MAT 24:6"/>Umbi awuri igũmbi isarhe iwa nu ugbugbewangge, bɔr niba agũmbi iwei. Awu ufang ikpũ abin hã akorhe, bɔr imimaa ina ishingge. <verse eid="MAT 24:6"/><verse number="7" style="v" sid="MAT 24:7"/>Abĩ akɔɔ asok adɛ̃ɛ̃ ifuw nggu abĩ akɔɔ, iyɛrhe iso idɛ̃ɛ̃ ifuw nggu iyɛrhe iyɔɔ. Ukoi uwuri itsu imerh ri inanga irhɛrhɛ. Nu upfunga uwuri izizusa ri inanga irhɛrhɛ. <verse eid="MAT 24:7"/><verse number="8" style="v" sid="MAT 24:8"/>Kishoo akɛrɛ ha awu ititirhi uver imar.<verse eid="MAT 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9"/>&lt;&lt;Mɔcɛ umbɔ aka idzowe umbi umbɔ adzaa umbi uver na afɛre umbi. Abĩã kishoo awuri ikpɛ̃ke umbi ri itsimum. <verse eid="MAT 24:9"/><verse number="10" style="v" sid="MAT 24:10"/>Ri ivang hã anera arhɛrhɛ imangmangmbɔ iwuri iwe uku ughɛɛng, umbɔ awuri ighadak na akpɛ̃na adɔka. <verse eid="MAT 24:10"/><verse number="11" style="v" sid="MAT 24:11"/>Abika asɔm Arherhu-Num igbɛrangwĩ awuri idzeka na arhɛm anera arhɛrhɛ. <verse eid="MAT 24:11"/><verse number="12" style="v" sid="MAT 24:12"/>Ititoma iyiki ibewe iwuri itsu ibibema anera arhɛrhɛ iwe uku ughɛɛng. <verse eid="MAT 24:12"/><verse number="13" style="v" sid="MAT 24:13"/>Bɔr uwuku ubima utsɛku imimasha awuri ikpoa ififɔrh. <verse eid="MAT 24:13"/><verse number="14" style="v" sid="MAT 24:14"/>Isarhe Iyiki Ize iyɛrɛ iyi Iyɛrhe, awuri idũwã ngge ru upfunga kishoo, ngge iwe ideka ra abĩã kishoo, mɔcɛ imimasha iba.<verse eid="MAT 24:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15"/>&lt;&lt;Umbi aba anyãmbi ubin uku utãrhã uku udakuwe anang, ukpurukpi uner uwuku usɔm Arherhu-Num Udaniyɛrh aka arherhe, udɛ̃ɛ̃kpɔ ri Iya-Num, neke uner uwuku uvarhe ahwɛng. <verse eid="MAT 24:15"/><verse number="16" style="v" sid="MAT 24:16"/>Mɔcɛ abirabɛ aka awe ru Uyahudiya atĩ azĩ ri igũ. <verse eid="MAT 24:16"/><verse number="17" style="v" sid="MAT 24:17"/>Uwuruwi aka awu afafã ni itsi uvi niba acipuwanga inyãngu ubin uku uwe ri iya. <verse eid="MAT 24:17"/><verse number="18" style="v" sid="MAT 24:18"/>Uwuruwi aka awe ra arhum niba abvui abanga inyãngu untamanga. <verse eid="MAT 24:18"/><verse number="19" style="v" sid="MAT 24:19"/>Atorhmbi akatsɛrh abika awu ra ana nu abika akpɔm awɛkaci ri ivang hã! <verse eid="MAT 24:19"/><verse number="20" style="v" sid="MAT 24:20"/>Àka afɛn-Num utsur utser ha uwekpɔ ri ivang ighɛnga use unum ukpuku uwosha abi Uyahuda. <verse eid="MAT 24:20"/><verse number="21" style="v" sid="MAT 24:21"/>Ubinkutsu, umbɔ awuri inyãmbɔ ayetnum akarhãrhã akirakɛ umbɔ aka anasi inyãmbɔ ake udzur ri imimunu upfunga uba utsĩ icɛrɛ. Asi íbvui anyãmbɔ akɔɔ aka anangke aki ha. <verse eid="MAT 24:21"/><verse number="22" style="v" sid="MAT 24:22"/>Agɛ umbɔ asi izharhukũmbɔ inum hã uku ugbim, unera asi íbɛka, bɔr ri itsi abirabɛ umbɔ aka asɛng umbɔ awuri izharhukũmbɔ inum hã.<verse eid="MAT 24:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23"/>&lt;&lt;Ri ivang hã unera aba agɔra umbi agɛ, &lt;Àka anyã, Ukiristo uwi!&gt; use &lt;Nggawɔ nggɔɔ!&gt; niba awembi ri imangmang. <verse eid="MAT 24:23"/><verse number="24" style="v" sid="MAT 24:24"/>Ubinkutsu akiristo igbɛrangwĩ nu abika asɔm Arherhu-Num igbɛrangwĩ awuri idzekambɔ, umbɔ awuri ikorhumbɔ atsar akagɔng nu abin idzeu arhɛm anera nu abirabɛ Unum aka asɛng, ngge iba idɛ̃ɛ̃ iwengge. <verse eid="MAT 24:24"/><verse number="25" style="v" sid="MAT 24:25"/>Àka anyã, umum iki idɛyiwamum umbi ngge idɔrhi iwe.<verse eid="MAT 24:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26"/>&lt;&lt;Nggee unera aba agɔra umbi agɛ, &lt;Unggawɔ ra arhum,&gt; niba adzembi, use agɔr umbi agɛ, &lt;Nggawi ru ubã,&gt; niba awembi ri imangmang. <verse eid="MAT 24:26"/><verse number="27" style="v" sid="MAT 24:27"/>Ubinkutsu, ibiba Ungwɛ̃-Ner iwuri iwe ru nyaki irhirhang iki irhange afã kishoo udiki igɔ̃kpee izĩ itsĩ udiku urhɛɛ. <verse eid="MAT 24:27"/><verse number="28" style="v" sid="MAT 24:28"/>Anangkɛ ukom uku uwe, anang hã amgbɛpɛ iki ikɔng.<verse eid="MAT 24:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29"/>&lt;&lt;Kanying inum ayetnum hã aki imaa,</para>
  <para style="q1" vid="MAT 24:29">&lt;&lt; &lt;ishaa unum iwuri iwu uzĩ,</para>
  <para style="q2" vid="MAT 24:29">nu ufɛ̃ usi írhangmgbɔ,</para>
  <para style="q1" vid="MAT 24:29">nu ídzɛr idzek afafã igba,</para>
  <para style="q2" vid="MAT 24:29">nu umbɔ awuri izusa abin aka amor aka awu ra afã.&gt;<note caller="+" style="f"><char style="fr" closed="false">24.29 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="ISA 13:10">Uish 13.10</ref>; <ref loc="ISA 34:4">34.4</ref></char>.</note><verse eid="MAT 24:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30"/>&lt;&lt;Mɔcɛ utsar ukpu Ungwɛ̃-Ner uku idzeka afafã, nu idũa ru upfunga kishoo awuri ididɔng. Umbɔ awuri inyãmbɔ Ungwɛ̃-Ner aka iba ra amɛɛ nggu ijee nu ikpikpoi akarhãrhã. <verse eid="MAT 24:30"/><verse number="31" style="v" sid="MAT 24:31"/>Nu unga awuri idene ípfu itsernga nggu atsom aki irhak ayisa, na awuri ikɔng abirabɛ umbɔ aka asɛng ra anggbokunga anaa, udiku igɔ̃kpee nu udiku urhɛɛ nu unɔr nu ufã, udzur ru ubandzin upfunga udiku ukpɛrɛ uzĩ udiku ukpɔrɔ.<verse eid="MAT 24:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32"/>&lt;&lt;Àka amesu ubin ru ucucii uvorhvo, ivangyɛ aboka aka ipfum adzeka na aghwɛr ayerhe aka afa, umbi ahwɛng ugɛ idoi iki iyongge. <verse eid="MAT 24:32"/><verse number="33" style="v" sid="MAT 24:33"/>Iwu rimi ikɛi, ivangyɛ umbi aka anyãmbi kishoo abin hã, umbi ahwɛng ugɛ ivanga iki iyongge, idɛ̃ɛ̃ ra angwĩã. <verse eid="MAT 24:33"/><verse number="34" style="v" sid="MAT 24:34"/>Umum indɛyiwa umbi idzidzɛrhe, udan ukpirɛ usi ítɔngkpɔ utsɛku ifɛrhɛ ha kishoo iki ikorhe. <verse eid="MAT 24:34"/><verse number="35" style="v" sid="MAT 24:35"/>Afã nggu abĩ awuri itɔngke, bɔr arherhamum asi ítɔngke.<verse eid="MAT 24:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36"/>&lt;&lt;Unera asi ihwɛnga unum hã use ivang hã, ípfu itser-Num ra afã isi ihwɛngngge, Ungwɛ̃-Ner asi ihwɛnga, Utɛ ukpekũ unga ahwɛng. <verse eid="MAT 24:36"/><verse number="37" style="v" sid="MAT 24:37"/>Ru nyaku inum Unuhu iki iwe, ngge iwuri iwe rimi ri ibiba Ungwɛ̃-Ner. <verse eid="MAT 24:37"/><verse number="38" style="v" sid="MAT 24:38"/>Ri inumyɛ amɛ̃ isok upfung aka awe, anera agha na ahwa, apfuna na adzise ipfuna, utsɛku unumkpi Unuhu aka atsĩ ru ukhukhɔɔ amɛ̃. <verse eid="MAT 24:38"/><verse number="39" style="v" sid="MAT 24:39"/>Umbɔ asi ihwɛngmbɔ utsɛku amɛ̃ aka aba akarha umbɔ. Ngge iwuri iwe rimi hã ru unum ibiba Ungwɛ̃-Ner. <verse eid="MAT 24:39"/><verse number="40" style="v" sid="MAT 24:40"/>Inera ivaa iwe ru usi, awuri inyãnguwe unying na aneke unying. <verse eid="MAT 24:40"/><verse number="41" style="v" sid="MAT 24:41"/>Akatsɛrh ivaa awuri idɛ̃ɛ̃ igɔ nu ukɔ igɔ urhɔnga, awuri inyãnguwe unying na aneke unying.<verse eid="MAT 24:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42"/>&lt;&lt;Nggee, àka adɛ̃ɛ̃ adzɛu, umbi asi ihwɛngmbi awu unum ukusong Uteijee aka iba. <verse eid="MAT 24:42"/><verse number="43" style="v" sid="MAT 24:43"/>Bɔr àka ahwɛng ugɛ uner iya aba ahwɛnga ivangyɛ uvɛu aka iba ru untsuuka, unga awuri isei uku urhi asi íneke umbɔ atsĩ ayarmbɔ iyanga. <verse eid="MAT 24:43"/><verse number="44" style="v" sid="MAT 24:44"/>Nggee umbi igambi awu ufang umbi adzɛu, ubinkutsu, Ungwɛ̃-Ner awuri iba ri ivangyɛ umbi aka asi ikaimbi ifɛrhkɔ.<verse eid="MAT 24:44"/></para>
  <para style="s1">Ugãrhã uwuku urhika <optbreak/> nu uwuku uda irhirhika</para>
  <para style="r">(<ref loc="LUK 12:41-48">Irh 12.41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45"/>&lt;&lt;Ungamɔ ucɛ, awu ugãrhã uwuku urhurhika nu uwu itsoi, uwuruwi uteiyanga aka atsu unga idzɛu agãrhã iyanga, unga adzise ubinghambɔ uku kpengkpeng ri ivangngge? <verse eid="MAT 24:45"/><verse number="46" style="v" sid="MAT 24:46"/>Anggɔm awe aki ugãrhã hã uteiyanga aka iba anyã unga adɛ̃ɛ̃ itsernga rimi hã. <verse eid="MAT 24:46"/><verse number="47" style="v" sid="MAT 24:47"/>Umum indɛyiwa umbi idzidzɛrhe, awuri itsuke ugãrhã hã arhise abinnga kishoo. <verse eid="MAT 24:47"/><verse number="48" style="v" sid="MAT 24:48"/>Bɔr ugãrhã hã aba awu uku ubewe, unga awuri igɔr itsinga agɛ, &lt;Uteiya asi íbanga ifetem.&gt; <verse eid="MAT 24:48"/><verse number="49" style="v" sid="MAT 24:49"/>Mɔcɛ unga atirhi ikwɛr agãrhã abɔrɔ, unga agha na ahwa nggu abi afĩrhã. <verse eid="MAT 24:49"/><verse number="50" style="v" sid="MAT 24:50"/>Uteiya ugãrhã hã aba ru unumkpi unga aka asi itsara. Ri ivangyɛ unga aka asi ihwɛngnga. <verse eid="MAT 24:50"/><verse number="51" style="v" sid="MAT 24:51"/>Uteiya awuri ikwɛr unga iyiki ibewe na agbange unga nggu abi ukpukpeta, umɔ umbɔ aka iciu na atãi anyĩmbɔ.<verse eid="MAT 24:51"/></para>
  <chapter eid="MAT 24"/>
  <chapter number="25" style="c" sid="MAT 25"/>
  <para style="s1">Unyaka arherhe aki <optbreak/> anakagbĩrhĩ usɔka aka anasi <optbreak/> ihwɛngmbɔ ukutsak</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1"/>&lt;&lt;Mɔcɛ Iyɛrhe afã iwuri iwe ru nyaka anakagbĩrhĩ usɔka aka anasi ihwɛngmbɔ ukutsak anyangu írhirhangmbɔ azĩ igbangu utsak uku ufa. <verse eid="MAT 25:1"/><verse number="2" style="v" sid="MAT 25:2"/>Atɔ̃ɔ̃ ru umbɔ awu agugge nu atɔ̃ɔ̃ awu abi itsoi. <verse eid="MAT 25:2"/><verse number="3" style="v" sid="MAT 25:3"/>Agugge ha anyangu írhirhangmbɔ bɔr asi inyangumbɔ atsei. <verse eid="MAT 25:3"/><verse number="4" style="v" sid="MAT 25:4"/>Abi itsoi ha igambɔ anyangu írhirhangmbɔ nggu atsei ra andzoma. <verse eid="MAT 25:4"/><verse number="5" style="v" sid="MAT 25:5"/>Utsak uku ufa ha asi ibanga ifitem, kishoo agbɛu na arhambɔ urhɔ.<verse eid="MAT 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6"/>&lt;&lt;Ri ikɔtsuuka umbɔ agũ urhɛm ukerketakpɔ uku ugɔr ugɛ, &lt;Utsak uku ufa ha uwi aka abanga! Àka aba agbanga unga!&gt;<verse eid="MAT 25:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7"/>&lt;&lt;Mɔcɛ anakagbĩrhĩ usɔka ha asok agbishi írhirhangmbɔ. <verse eid="MAT 25:7"/><verse number="8" style="v" sid="MAT 25:8"/>Agugge ha agɔr abi itsoi ha agɛ, &lt;Àka ama adzaa atseimbi ukunjiir, írhirhangmɛn iki iwuri irhim.&gt;<verse eid="MAT 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9"/>&lt;&lt;Abi itsoi ha agɛ, &lt;Ĩ'ĩ, asi ímɛ̃ke umɛn nggu umbi. Ugba umbi azĩ ru abika agoyiwe atsei agoi akimbi.&gt;<verse eid="MAT 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10"/>&lt;&lt;Bɔr ivangyɛ umbɔ aka adzek azĩ igoi atsei ha, utsak uku ufa ha atsĩwãnga. Anakagbĩrhĩ aka agbisha abinmbɔ atsĩmbɔ irhowa nggu unga na afɔmukumbɔ angwĩ ubãã.<verse eid="MAT 25:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11"/>&lt;&lt;Kata abɔrɔ adɔrha aba agɛ, &lt;A uteiya! A uteiya! Uma utsuruwa angwĩ ubãã!&gt;<verse eid="MAT 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12"/>&lt;&lt;Bɔr unga agɛ, &lt;Umum indɛyiwa umbi idzidzɛrhe, umum isi ihwɛng umbi.&gt;<verse eid="MAT 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13"/>&lt;&lt;Nggee, àka adɛ̃ɛ̃ adzɛu, umbi asi ihwɛngmbi unuma use ivanga.<verse eid="MAT 25:13"/></para>
  <para style="s1">Unyaka arherhe agãrhã ataar</para>
  <para style="r">(<ref loc="LUK 19:11-27">Irh 19.11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14"/>&lt;&lt;Ikɛi, Iyɛrha afã iwuri iwe ru nyaku unera aka izĩ uzãrhã, na ayisa agãrhãnga agashuwe umbɔ uhwɛk. <verse eid="MAT 25:14"/><verse number="15" style="v" sid="MAT 25:15"/>Utsa ha ahwɛnga ubinkpi agãrhãnga aki idɛ̃ɛ̃ akorhe, nggee unga adzowe unying ibɛi uazurhfa itɔ̃ɔ̃, uwu uvaa ikɛi ibɛi uazurhfa ivaa, uwu untaar ibɛi uazurhfa unying. Mɔcɛ unga azĩã uzɛ̃rhãnga. <verse eid="MAT 25:15"/><verse number="16" style="v" sid="MAT 25:16"/>Utsa ha aka ayɛi ibɛi uazurhfa itɔ̃ɔ̃ hã kanying kanying unga akũ azĩ agoyi igoi adzipa nggu uhwɛk ha, akpo ighigha ibɛi uazurhfa itɔ̃ɔ̃. <verse eid="MAT 25:16"/><verse number="17" style="v" sid="MAT 25:17"/>Nggee ikɛi, uwu ibɛi uazurhfa ivaa ha, akpo ighigha ibɛi uazurhfa ivaa. <verse eid="MAT 25:17"/><verse number="18" style="v" sid="MAT 25:18"/>Bɔr uwu ha aka ayɛi ibɛi uazurhfa unying hã azĩ asim abĩ awɔkuka uhwɛk uteiyanga.<verse eid="MAT 25:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19"/>&lt;&lt;Ivanga iki iderngge, uteiya agãrhã hã aba ayisa agãrhãnga umbɔ avarhuwe ubinkpi umbɔ aka akorhe. <verse eid="MAT 25:19"/><verse number="20" style="v" sid="MAT 25:20"/>Uner uwuku uyɛi ibɛi uazurhfa itɔ̃ɔ̃ akũ ibɛi uazurhfa itɔ̃ɔ̃ aba agɛ, &lt;A Uteiya, ungo udzaa umum ibɛi uazurhfa itɔ̃ɔ̃. Unyã, umum ikpo ighigha ibɛi uazurhfa itɔ̃ɔ̃ itoma.&gt;<verse eid="MAT 25:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21"/>&lt;&lt;Uteiyanga agɛ, &lt;Ungo udɛ̃ɛ̃, ugãrhã uwuku uze uwu idzidzɛrhe! Ungo uweɔ ri idzidzɛrhe ru ubin uku uci. Umum indzaamum ijee iyiki ikpɔm abina arhɛrhɛ. Uba ugɔmanggɔm nggu uteiyango.&gt;<verse eid="MAT 25:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22"/>&lt;&lt;Uner uwuku uyɛi ibɛi uazurhfa ivaa ha ikɛi aba agɛ, &lt;A Uteiya, Ungo udzaa umum ibɛi uazurhfa ivaa. Unyã nggayɛ umum ikpo ighigha ibɛi uazurhfa ivaa itoma.&gt;<verse eid="MAT 25:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23"/>&lt;&lt;Uteiyanga agɛ, &lt;Ungo udɛ̃ɛ̃ ugãrhã uwuku uze uwu idzidzɛrhe! Ungo uweɔ ri idzidzɛrhe nggu ubin uku uci. Umum indzaamum ijee iyiki ikpɔm abina arhɛrhɛ. Uba ugɔmanggɔm nggu uteiyango!&gt;<verse eid="MAT 25:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24"/>&lt;&lt;Mɔcɛ uner uwuku uyɛi ibɛi uazurhfa unying hã aba agɛ, &lt;A Uteiya, umum ihwɛng amɛnngo aghong ifɛrhɛ. Ungo udɛ̃ɛ̃ ugbugbɛrɔ ra anangkɛ ungo uku usi idosɔ. Ungo udɛ̃ɛ̃ urhɔ̃ĩngo ra anangkɛ ungo uku usi inãngo ikpũ. <verse eid="MAT 25:24"/><verse number="25" style="v" sid="MAT 25:25"/>Nggee umum igũ iwei izĩ iwɔke ibɛi uazurhfango ra abĩ. Unyã ibɛi uazurhfango iyɛ.&gt;<verse eid="MAT 25:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26"/>&lt;&lt;Uteiyanga agɛ, &lt;Ungo ugãrhũ uwuku ubewe, ughɛrha! Ungo uhwɛngo umum iki isaki ĩgbɛtũ ra anangkɛ umum iki isi idoimum ni irhɔ̃ĩmum ra anangkɛ umum iki isi inãmum ikpũ. <verse eid="MAT 25:26"/><verse number="27" style="v" sid="MAT 25:27"/>Azea mɔcɛ, ugɛ ungo uba utsuke uhwɛka ru ubanki. Ivangyɛ umum iki ibvui iba, umum itsũ ngge nggu ighigha!<verse eid="MAT 25:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28"/>&lt;&lt; &lt;Àka ayɛise ibɛi uazurhfa unying hã ru unga, aka atomuwe ru uwɔrɔ uwu ibɛi uazurhfa usɔka. <verse eid="MAT 25:28"/><verse number="29" style="v" sid="MAT 25:29"/>Uwuruwi aka awe ru ihwihwɛng awuri itomuwe unga akpo arhɛrhɛ. Uwuruwi aka ashia, awuri iyɛse ungwɛ̃rhĩ ihwihwɛng ha unga aka awerangge. <verse eid="MAT 25:29"/><verse number="30" style="v" sid="MAT 25:30"/>Na atare ugãrhã ibɛm hã ra awiya ru uzĩ uku ugburhuk. Umɔ umbɔ aki iciu akpe nggu itãi anyĩ.&gt;<verse eid="MAT 25:30"/></para>
  <para style="s1">Ídɔi nggu íbũ</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31"/>&lt;&lt;Ivangyɛ Ungwɛ̃-Ner aka iba ri ikpikpoinga nggu ípfu itsernga kishoo, unga awuri isei nú anang isei iyɛrhe aki ikpikpoi. <verse eid="MAT 25:31"/><verse number="32" style="v" sid="MAT 25:32"/>Awuri ikɔng abi upfung ukpirɛ kishoo ra anangnga, unga awuri igasha umbɔ awuwembɔ ru nyaku uner ughãwã aka igashi ídɔi nggu íbũ. <verse eid="MAT 25:32"/><verse number="33" style="v" sid="MAT 25:33"/>Unga awuri itsu ídɔi ru ubok ugha na atsu íbũ ru ubok uferanga.<verse eid="MAT 25:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34"/>&lt;&lt;Mɔcɛ Uyɛrhe awuri igɔr abika awe ru ubok ughanga agɛ, &lt;Àka aba, umbi abi Utɛmum aka atsuka umbi idorh. Àka ayɛi ukamkpi Unum aka igbishuwa umbi udzur ri imimunu upfung. <verse eid="MAT 25:34"/><verse number="35" style="v" sid="MAT 25:35"/>Umum iki igũ imerh, umbi adzaa umum ubingha, umum iki igũ ugɔ̃ amɛ̃, umbi adzaa umum ubin umum ihwa, iwu utsen, umbi ayɛi umum ra ayambi. <verse eid="MAT 25:35"/><verse number="36" style="v" sid="MAT 25:36"/>Umum ishimum ra atorho, umbi adzaa umum atorho, aghonga umum, umbi anɛta umum, iwe ru ugborzĩ, umbi aba ayepa umum.&gt;<verse eid="MAT 25:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37"/>&lt;&lt;Mɔcɛ abika arhurhika awuri igɔr agɛ, &lt;A Uteijee, ukang umɛn iki inyã ungo ugũ imerh ni ĩdzaa ungo ubingha, use ungo ugũ ugɔ̃ amɛ̃, umɛn ĩdzaa ungo ubin ungo uhwa? <verse eid="MAT 25:37"/><verse number="38" style="v" sid="MAT 25:38"/>Ukang umɛn iki inyã ungo uku uwu utsen ni iyɛi ungo, use ungo ushiɔ ra atorho, umɛn indzaa ungo atorho? <verse eid="MAT 25:38"/><verse number="39" style="v" sid="MAT 25:39"/>Ukang ungo uku ughong iyor use ungo uwe ru ugborzĩ umɛn izĩ iyepa ungo?&gt;<verse eid="MAT 25:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40"/>&lt;&lt;Mɔcɛ Uyɛrhe awuri igɔr umbɔ agɛ, &lt;Umum indɛyiwa umbi idzidzɛrhe, ubɛn ubinkpi umbi aka akorhuwe unying ra angwɛ̃mɛn use anapumɛn abika asheru ugarh ru umbi, umbi akorhuwa umum.&gt;<verse eid="MAT 25:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41"/>&lt;&lt;Mɔcɛ unga awuri igɔr abɔrɔ ru ubok uferanga agɛ, &lt;Àka asombi ru umum umbi abi ikponum. Àka azĩ atsĩ ru urha ukpu ugbagbaa umbɔ aka ataiwe Undenggũ nggu ípfu itsernga. <verse eid="MAT 25:41"/><verse number="42" style="v" sid="MAT 25:42"/>Umum iki igũ imerh, umbi asi idzaambi umum ubingha, umum iki igũ ugɔ̃ amɛ̃, umbi asi idzaambi umum ubin umum ihwa. <verse eid="MAT 25:42"/><verse number="43" style="v" sid="MAT 25:43"/>Iwu utsen, umbi asi iyɛi umum atsĩmbi ri iya, ishimum ra atorho umbi asi idzaambi atorho ru umum, aghonga umum, ikɛi umum iwe ru ugborzĩ, umbi asi iba ayepumbi umum.&gt;<verse eid="MAT 25:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44"/>&lt;&lt;Umbɔ ikɛi awuri igɔr agɛ, &lt;A Uteijee, ukang umɛn iki inyã ungo ugũ imerh use ugɔ̃ amɛ̃ use ungo uwu utsen use ungo ushiɔ ra atorho use aghonga ungo use ungo uwe ru ugborzĩ, umɛn isi iyikamɛn ungo?&gt;<verse eid="MAT 25:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45"/>&lt;&lt;Unga awuri igɔr agɛ, &lt;Umum indɛyiwa umbi idzidzɛrhe, ubɛn ubinkpi umbi aka asi ikorhukumbi unying ra abɛrɛ aka asheru ugarh, umbi asi ikorhuwambi umum nukpɔ.&gt;<verse eid="MAT 25:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46"/>&lt;&lt;Mɔcɛ umbɔ awuri ikpo ayetnum aki ugbagbaa, bɔr abika arhurhika awuri ikpo urhɛ uwu ugbagbaa.&gt;&gt;<verse eid="MAT 25:46"/></para>
  <chapter eid="MAT 25"/>
  <chapter number="26" style="c" sid="MAT 26"/>
  <para style="s1">Umbɔ akɛki ifɛre Uyesu</para>
  <para style="r">(<ref loc="MRK 14:1-2">Umar 14.1-2</ref>; <ref loc="LUK 22:1-2">Irh 22.1-2</ref>; <ref loc="JHN 11:45-53">Uyoh 11.45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1"/>Ivangyɛ Uyesu aka amaa irherha abina akɛrɛ ha kishoo, unga agɔr angwɛ̃ imesanga agɛ, <verse eid="MAT 26:1"/><verse number="2" style="v" sid="MAT 26:2"/>&lt;&lt;Umbi ahwɛngmbi, Irhowa Iyiki Igar Utɔng ibɔr inuma ivaa, umɔ awuri idzowe Ungwɛ̃-Ner umbɔ anyapuwe unga.&gt;&gt;<verse eid="MAT 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3"/>Mɔcɛ ateiya abika adzowe idɛm-Num nu akakũ anera akɔng ri iya Ukugɔng Uwuku Udzowe Idɛm-Num, itsoka igburh Ukayafa. <verse eid="MAT 26:3"/><verse number="4" style="v" sid="MAT 26:4"/>Umbɔ avarhe idzur Uyesu ri iwɔk afɛre unga. <verse eid="MAT 26:4"/><verse number="5" style="v" sid="MAT 26:5"/>Bɔr umbɔ agɛ, &lt;&lt;Asi íwea ri ivang irhowa, utsur anera asoyimbɔ amɛn.&gt;&gt;<verse eid="MAT 26:5"/></para>
  <para style="s1">Adzukuwe Uyesu atsei ru Ubetani</para>
  <para style="r">(<ref loc="MRK 14:3-9">Umar 14.3-9</ref>; <ref loc="LUK 7:37-38">Irh 7.37-38</ref>; <ref loc="JHN 12:1-8">Uyoh 12.1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6"/>Ivangyɛ Uyesu aka awe ru Ubetani ri iya Usiman uwuruwi ingbimnga iki ikerhe, <verse eid="MAT 26:6"/><verse number="7" style="v" sid="MAT 26:7"/>utsɛrh uwɔɔ aba ru Uyesu nggu undzoma utarh uku utɔk nggu atsei isung aki imang akarhãrhã. Unga awupuwe atsei ha ri itsinga ri ivangyɛ unga aka asei nu anang ubingha.<verse eid="MAT 26:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8"/>Ivang angwɛ̃ imesanga aka anyã rimi, umbɔ agũ avɔm na arhusa adɔkambɔ agɛ, &lt;&lt;Akɛrɛ awu inyar! <verse eid="MAT 26:8"/><verse number="9" style="v" sid="MAT 26:9"/>Imɛ̃ɛ̃ngge umbɔ agoshe atsei isung hã ru uhwɛk urhɛrhɛ na adzowe atsũwã.&gt;&gt;<verse eid="MAT 26:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10"/>Uyesu agɔr umbɔ agɛ, &lt;&lt;Awu use utsu umbi ayɔm utsɛrh ha? Unga akorhuwa umum ubin uku uze. <verse eid="MAT 26:10"/><verse number="11" style="v" sid="MAT 26:11"/>Atsũwã awu nggu umbi ubɛn ivang, bɔr umum isi íwemum nggu umbi ubɛn ivang. <verse eid="MAT 26:11"/><verse number="12" style="v" sid="MAT 26:12"/>Atseikɛ unga awupuwa umum, unga agbishuwa iyormum umbɔ aka idzake. <verse eid="MAT 26:12"/><verse number="13" style="v" sid="MAT 26:13"/>Umum indɛyiwa umbi idzidzɛrhe, kishoo anangkɛ umbɔ aka idzowe Isarhe Iyiki Ize iyɛrɛ ru upfunga, umbɔ awuri isɔmmbɔ ubinkpi utsɛrh uwurɛ aka akorhe ri ayita unga.&gt;&gt;<verse eid="MAT 26:13"/></para>
  <para style="s1">Uyahuda abemuka ighadak Uyesu</para>
  <para style="r">(<ref loc="MRK 14:10-11">Umar 14.10-11</ref>; <ref loc="LUK 22:3-6">Irh 22.3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14"/>Mɔcɛ unying ru umbɔ usɔkdũmɛn hã itsoknga igburh Uyahuda Uiskariyoti, azĩ ra ateiya abika adzowe idɛm-Num, <verse eid="MAT 26:14"/><verse number="15" style="v" sid="MAT 26:15"/>arhusa agɛ, &lt;&lt;Umbi awuri idzaa umum use umum ĩba ĩdzaamum unga ru umbi?&gt;&gt; Nggee umbɔ avarhuwe unga íshaa imang uazurhfa isɔka itaar. <verse eid="MAT 26:15"/><verse number="16" style="v" sid="MAT 26:16"/>Udzur ri ivang hã Uyahuda abee udĩkpi unga aka ighadak Uyesu.<verse eid="MAT 26:16"/></para>
  <para style="s1">Ubingha Uteijee</para>
  <para style="r">(<ref loc="MRK 14:12-26">Umar 14.12-26</ref>; <ref loc="LUK 22:7-23">Irh 22.7-23</ref>; <ref loc="JHN 13:21-30">Uyoh 13.21-30</ref>; <ref loc="1CO 11:23-26">1Uko 11.23-26</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17"/>Ru unum inggbaashia ukpu Irhowu Uborodi ukpuku Usheru Uguga, angwɛ̃ imesa aba ru Uyesu arhusa unga agɛ, &lt;&lt;Ra anang akasong ungo uku ubee umɛn igbishuwa ungo ugha Irhowa Iyiki Igar Utɔng?&gt;&gt;<verse eid="MAT 26:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18"/>Unga agɛ, &lt;&lt;Àka atsĩ ru utepa, àka azĩ ru utsa uwɔɔ, àka agɔr unga agɛ, &lt;Umarhem agɛ, ivangmum iki iyongge. Umum igha Irhowa Iyiki Igar Utɔng ri iyango nggu angwɛ̃ imesamum.&gt; &gt;&gt; <verse eid="MAT 26:18"/><verse number="19" style="v" sid="MAT 26:19"/>Nggee angwɛ̃ imesanga akorhu ubinkpi Uyesu aka agɔr umbɔ na akorhuwe ubingha Irhowa Iyiki Igar Utɔng.<verse eid="MAT 26:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20"/>Urhɛɛ uku uwe, Uyesu asei igha ubingha nggu angwɛ̃ imesanga usɔkdũmɛn. <verse eid="MAT 26:20"/><verse number="21" style="v" sid="MAT 26:21"/>Asei ighigha ha nukpi, unga agɛ, &lt;&lt;Umum indɛyiwa umbi idzidzɛrhe, unying ru umbi awuri ighaa adakmum.&gt;&gt;<verse eid="MAT 26:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22"/>Amɛnmbɔ aghong akarhãrhã na atirhi irhusa unga anyinganying agɛ, &lt;&lt;A Uteijee, awu umum?&gt;&gt;<verse eid="MAT 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23"/>Uyesu agɛ, &lt;&lt;Uwuruwi aka atsĩ ubok ri itɛ̃rhĩ nggu umum, unga awuri ighaa adakmum. <verse eid="MAT 26:23"/><verse number="24" style="v" sid="MAT 26:24"/>Ungwɛ̃-Ner awuri ikpe ru nyaka umbɔ aka atsɛng ri itsinga. Bɔr atorh uner ha aka ighadak Ungwɛ̃-Ner! Ugba umbɔ asi imarmbɔ unga.&gt;&gt;<verse eid="MAT 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25"/>Mɔcɛ Uyahuda, uwuruwi aka igha adaknga agɛ, &lt;&lt;A umarhem, awu umum?&gt;&gt;</para>
  <para style="p" vid="MAT 26:25">Uyesu agɛ, &lt;&lt;Awu ungo urherhe.&gt;&gt;<verse eid="MAT 26:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26"/>Umbɔ ana asei ighigha ha, Uyesu anyangu uborodi, atar uwɛɛ na atsɔka ukpɔ. Adzowe angwɛ̃ imesanga agɛ, &lt;&lt;Àka ayɛi, atãi. Uwɛrɛ awu iyormum.&gt;&gt;<verse eid="MAT 26:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27"/>Mɔcɛ unga anyangu ukpɛwa, atar uwɛɛ, na adzowe ru umbɔ, agɛ, &lt;&lt;Àka ahwa ru umgbɔ kishookambi. <verse eid="MAT 26:27"/><verse number="28" style="v" sid="MAT 26:28"/>Akɛrɛ awu adzirhmum aki ibibemuwe-Num, akirakɛ aka adzek awupa ra anera arhɛrhɛ, atsũwe arhimmbɔ. <verse eid="MAT 26:28"/><verse number="29" style="v" sid="MAT 26:29"/>Umum indɛyiwa umbi, umum isi íbvui ihwamum amɛ̃ ikpũrhã inebi akɛrɛ utsɛku unumkpi umum iki ihwa aka afa nggu umbi ri Iyɛrhe Utɛmum.&gt;&gt;<verse eid="MAT 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30"/>Umbɔ aka amaa itsũwe ubom ru Unum, umbɔ adzek azĩmbɔ Igũ Acucii Uzaitun.<verse eid="MAT 26:30"/></para>
  <para style="s1">Uyesu agɛ Ubitru awuri itsɛyinga <optbreak/> ihwɛng unga</para>
  <para style="r">(<ref loc="MRK 14:27-31">Umar 14.27-31</ref>; <ref loc="LUK 22:31-34">Irh 22.31-34</ref>; <ref loc="JHN 13:36-38">Uyoh 13.36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31"/>Mɔcɛ Uyesu agɔr umbɔ agɛ, &lt;&lt;Ru untsuu akpirɛ umbi kishoo awuri itĩ ri itsi ubinkpi uku ikorhe nggu umum. Itsɛng Arherhu-Num igɔr igɛ,</para>
  <para style="q1" vid="MAT 26:31">&lt;&lt; &lt;Umum iwuri ikwɛr uner ughãwãã,</para>
  <para style="q2" vid="MAT 26:31">nu ukpui ídɔi ha iwuri isita.&gt;<note caller="+" style="f"><char style="fr" closed="false">26.31 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="ZEC 13:7">Uzak 13.7</ref></char>.</note><verse eid="MAT 26:31"/></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32"/>Bɔr ivangyɛ umum iki isok ra akpe, umum inggbaashia izĩ Ugarhirhi ru umbi adɔrha atsĩ umɔ.&gt;&gt;<verse eid="MAT 26:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33"/>Ubitru agɛ, &lt;&lt;Kishoo aba atĩmbɔ ri itsi ubinkpi uku ikorhe nggu ungo, umum isi ítĩmum.&gt;&gt;<verse eid="MAT 26:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34"/>Uyesu agɔr unga agɛ, &lt;&lt;Umum indɛyiwa ungo idzidzɛrhe, ru untsuu akpirɛ, ungo uwuri itsɛyingo ihwɛng umum idiki itaar ri ikɔ idɔrhi igbɛr ukpee.&gt;&gt;<verse eid="MAT 26:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35"/>Ubitru agɔr unga agɛ, &lt;&lt;Uko umbɔ awuri ifɛre umum nggu ungo, umum isi ítsɛyimum ihwɛng ungo.&gt;&gt; Rimi hã angwɛ̃ imesa abɔɔ kishoo aka arherhe.<verse eid="MAT 26:35"/></para>
  <para style="s1">Ru Ugetsemani</para>
  <para style="r">(<ref loc="MRK 14:32-42">Umar 14.32-42</ref>; <ref loc="LUK 22:39-46">Irh 22.39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36"/>Mɔcɛ Uyesu nu angwɛ̃ imesanga azĩmbɔ anang akɔɔ umbɔ iki iyisa Ugetsemani. Unga agɔr umbɔ agɛ, &lt;&lt;Àka asei nggimi, umum izĩ ifɛn-Num nggɔɔ.&gt;&gt; <verse eid="MAT 26:36"/><verse number="37" style="v" sid="MAT 26:37"/>Unga akũ nggu Ubitru nu angwɛ̃ Uzabadi avaa, unga atirhunga igũ idamɛn nu ighongamɛn. <verse eid="MAT 26:37"/><verse number="38" style="v" sid="MAT 26:38"/>Unga agɔr umbɔ agɛ, &lt;&lt;Igũ ighongyɛ iki iwe ra amɛnmum idɛ̃ɛ̃ ifɛrngge umum. Àka asei nggimi na adzɛu nggu umum.&gt;&gt;<verse eid="MAT 26:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39"/>Unga aka agɔpa azĩ ukunjiir unga agba akwɛr anaanga atsim nú abĩ afɛn-Num agɛ, &lt;&lt;A Utɛmum, ngge iba imɛ̃ngge, ungo unyanguwe ukpɛwa ayetnum akɛrɛ ru umum. Bɔr ukorhu ubinkpi ungo uku ubee, asi iwea ubinkpi umum iki ibee.&gt;&gt;<verse eid="MAT 26:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40"/>Mɔcɛ unga abvui aba ra angwɛ̃ imesanga, akpo umbɔ aka arhambɔ urhɔ. Unga agɔr Ubitru agɛ, &lt;&lt;A Ubitru, umbi asi idɛ̃ɛ̃ adzɛumbi nggu umum ukara unying? <verse eid="MAT 26:40"/><verse number="41" style="v" sid="MAT 26:41"/>Àka adzɛu na afɛn-Num utsur umbi agbambi ru undeya. Idzidzɛrhe ipfu ibemungge, bɔr iyor isi ikerngge.&gt;&gt;<verse eid="MAT 26:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42"/>Unga abvui azĩã ifɛn-Num idevaa agɛ, &lt;&lt;A Utɛmum, uba ayetnum akɛrɛ asi ítɔngke utsɛku umum iki ihwa ake, umum ikorhumum ubinkpi ungo uku ubee.&gt;&gt;<verse eid="MAT 26:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43"/>Unga abvui aba akpo umbɔ ikɛi awe ru urhɔ, umbɔ asi idɛ̃ɛ̃ ayangumbɔ asumbɔ. <verse eid="MAT 26:43"/><verse number="44" style="v" sid="MAT 26:44"/>Nggee unga abɔre umbɔ na azĩã ifɛn-Num ide untaar, abvui arherhe ubinkpi unga aka arherhe ri inggbaashia.<verse eid="MAT 26:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45"/>Mɔcɛ unga abvui aba ra angwɛ̃ imesa ha agɔr umbɔ agɛ, &lt;&lt;Utsɛku icɛrɛ umbi ana awu ru urhɔ na adɛ̃ɛ̃ iwosha? Àka anyã, ivanga iki iyongge umbɔ aka idzowe Ungwɛ̃-Ner ru abok abi arhim. <verse eid="MAT 26:45"/><verse number="46" style="v" sid="MAT 26:46"/>Àka asisok umɛn izĩmɛn! Uwuku ugha adakmum uwi aka abanga!&gt;&gt;<verse eid="MAT 26:46"/></para>
  <para style="s1">Adzur Uyesu</para>
  <para style="r">(<ref loc="MRK 14:43-50">Umar 14.43-50</ref>; <ref loc="LUK 22:47-53">Irh 22.47-53</ref>; <ref loc="JHN 18:3-12">Uyoh 18.3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47"/>Unga ana awu ra arherhe, Uyahuda, unying ru umbɔ usɔkdũmɛn hã, aba atsĩ. Unga aba nggu anera arhɛrhɛ aka akpɔm nggu akon aka ader nu ígbong. Ateiya abika adzowe idɛm-Num nu akakũ anera aka adene umbɔ. <verse eid="MAT 26:47"/><verse number="48" style="v" sid="MAT 26:48"/>Umɔ uwuku ughadaknga hã aka asɔmuka umbɔ utsara agɛ, &lt;&lt;Uwuruwi umum iki ishor atamnga, awu uner ha nuwɔ umbi aka idzur.&gt;&gt; <verse eid="MAT 26:48"/><verse number="49" style="v" sid="MAT 26:49"/>Uyahuda aka aba, unga akpurha azĩ ru Uyesu agɛ, &lt;&lt;A umarhem, umum ighwe ungo!&gt;&gt; Na ashor atamnga.<verse eid="MAT 26:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50"/>Uyesu agɔr unga agɛ, &lt;&lt;A uwee, ukorhu ubinkpi uku ukũna ungo uba.&gt;&gt;</para>
  <para style="p" vid="MAT 26:50">Mɔcɛ anera aba, adzur Uyesu akpɔm unga. <verse eid="MAT 26:50"/><verse number="51" style="v" sid="MAT 26:51"/>Unying ra angwɛ̃ imesa Uyesu agbiir ikon iki idernga, agbɛr uto ugãrhũ Ukugɔng Uwuku Udzowe Idɛm-Num, azharhuwe.<verse eid="MAT 26:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52"/>Uyesu agɔr unga agɛ, &lt;&lt;Utsuke ikon iki iderngo ru udapa. Ubɛn uwuku ugbiir ikon iki ider, awu ikon iki ider ifɛr unga. <verse eid="MAT 26:52"/><verse number="53" style="v" sid="MAT 26:53"/>Umbi akaifɛrhkɔ ugɛ umum ishimum ri ijeea umum iki iyisu Utɛmum kanying unga adene ípfu itser-Num anakagɔnga? <verse eid="MAT 26:53"/><verse number="54" style="v" sid="MAT 26:54"/>Bɔr itsɛng Arherhu-Num iki igɔr ugɛ awu ufang akɛrɛ ha akorhe, iwuri ikorhe igusengge ni itsuifɛr?&gt;&gt;<verse eid="MAT 26:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55"/>Mɔcɛ Uyesu agɔr ikikɔng anera agɛ, &lt;&lt;Umum iwu uner uwuku uvui abin anera ri iker, umbi aka idzeka nggu akon aka ader nu ígbong adzur umum? Ubɛn unum umum isei ru ufɔm Iya-Num imesuwe imesa, umbi asi idzurmbi umum. <verse eid="MAT 26:55"/><verse number="56" style="v" sid="MAT 26:56"/>Bɔr kishoo akɛrɛ akorhe ngge itsuifɛr abinkɛ aka atsɛng ra abvur abika asɔm Arherhu-Num.&gt;&gt; Mɔcɛ angwɛ̃ imesanga kishoo atĩ abɔrukumbɔ unga.<verse eid="MAT 26:56"/></para>
  <para style="s1">Uyesu ra anang abi udzepurhe</para>
  <para style="r">(<ref loc="MRK 14:53-65">Umar 14.53-65</ref>; <ref loc="LUK 22:54-55">Irh 22.54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Uyoh 18.13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57"/>Abika adzur Uyesu akũna unga azĩ ru Ukayafa, Ukugɔng Uwuku Udzowe Idɛm-Num, anangkɛ abika amesuwe Ikpem nu akakũ anera aka akɔng. <verse eid="MAT 26:57"/><verse number="58" style="v" sid="MAT 26:58"/>Bɔr Ubitru adɔsa unga ukuka, utsɛku umbɔ aka azĩ atsĩ ru ufɔm iya Ukugɔng Uwuku Udzowe Idɛm-Num. Unga atsĩ asei nggu abi idzɛu ha abee inyã imimasha ubinkpi umbɔ aka ikorhe.<verse eid="MAT 26:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59"/>Ateiya abika adzowe idɛm-Num nu abi udzepurhe kishoo abee igbɛrangwĩyɛ umbɔ aka itsuke Uyesu na akpo udĩ ukpuku ufɛre unga. <verse eid="MAT 26:59"/><verse number="60" style="v" sid="MAT 26:60"/>Anera arhɛrhɛ aka adzeka, agbɛyangwĩ atsuke unga, bɔr umbɔ asi ikpombɔ udĩ ukpuku ufɛr unga.</para>
  <para style="p" vid="MAT 26:60">Ri imimaa, anera avaa adzeka, <verse eid="MAT 26:60"/><verse number="61" style="v" sid="MAT 26:61"/>agɛ, &lt;&lt;Utsak uwurɛ agɔr agɛ, &lt;Umum idɛ̃ɛ̃ ibupukũ Iya-Num, ni ibvui idzine ri inuma itaar.&gt; &gt;&gt;<verse eid="MAT 26:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62"/>Mɔcɛ, Ukugɔng Uwuku Udzowe Idɛm-Num asok agɔr Uyesu agɛ, &lt;&lt;Ungo usi ídzipungo arherhe? Awu use aner abɛrɛ aka arherha atsuka ungo?&gt;&gt; <verse eid="MAT 26:62"/><verse number="63" style="v" sid="MAT 26:63"/>Bɔr Uyesu awu uku uvep.</para>
  <para style="p" vid="MAT 26:63">Ukugɔng Uwuku Udzowe Idɛm-Num agɔr unga agɛ, &lt;&lt;Umum itsu ungo nggu uyirh ri itsok Unum uwu urhɛ, usɔma umɛn, awu ungo uwu Ukiristo Ungwɛ̃ Unum?&gt;&gt;<verse eid="MAT 26:63"/></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64"/>Uyesu agɔr unga agɛ, &lt;&lt;Awu ungo urherhe. Bɔr umum isɔma umbi kishoo, utirhi ucɛrɛ umbi awuri inyãmbi Ungwɛ̃-Ner aka isei ru ubok ugha Nggaa Unum na awuri iba ra amɛɛ afafã.&gt;&gt;<verse eid="MAT 26:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65"/>Mɔcɛ Ukugɔng Uwuku Udzowe Idɛm-Num hã avapuwe atorhanga na agɛ, &lt;&lt;Unga aka arhenu Unum! Awu use umɛn iki ibee ikɛi? Àka anyã, icɛrɛ umbi aka agũmbi unga aka arhenu Unum. <verse eid="MAT 26:65"/><verse number="66" style="v" sid="MAT 26:66"/>Umbi anyã aguse?&gt;&gt;</para>
  <para style="p" vid="MAT 26:66">Umbɔ agɛ, &lt;&lt;Imɛ̃ngge umbɔ afɛre unga.&gt;&gt;<verse eid="MAT 26:66"/></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67"/>Mɔcɛ umbɔ atang aci atsuyiwe ru asunga na akũ ikpoi akwɛr unga. Abɔɔ akwɛre unga inkpai, <verse eid="MAT 26:67"/><verse number="68" style="v" sid="MAT 26:68"/>na agɛ, &lt;&lt;A Ukiristo! Udɛyiwa umɛn, uwukusong akwɛr ungo ikpoi?&gt;&gt;<verse eid="MAT 26:68"/></para>
  <para style="s1">Ubitru atsɛyi ihwɛng Uyesu</para>
  <para style="r">(<ref loc="MRK 14:66-72">Umar 14.66-72</ref>; <ref loc="LUK 22:56-62">Irh 22.56-62</ref>; <ref loc="JHN 18:15-18">Uyoh 18.15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69"/>Ri ivang hã Ubitru asei ru ufɔm iya ha, nu una igãrhã aba ru unga agɔr unga agɛ, &lt;&lt;Ungo uwu nggu Uyesu uner Ugarhirhi uwurɛ!&gt;&gt;<verse eid="MAT 26:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70"/>Bɔr Ubitru atsɛyinga ra anangmbɔ kishoo agɛ, &lt;&lt;Umum isi ihwɛng ubinkpi ungo uku urherhe!&gt;&gt;<verse eid="MAT 26:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71"/>Mɔcɛ unga adzek azĩã ru angwĩ ufɔma, umɔ una uwɔɔ aka anyã unga, agɔr abika adɛ̃ɛ̃ umɔ agɛ, &lt;&lt;Utsak uwurɛ awu nggu Uyesu uner Unazarat!&gt;&gt;<verse eid="MAT 26:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72"/>Ubitru atsɛyi ikɛi nggu uyirh agɛ, &lt;&lt;Umum isi ihwɛng utsa ha.&gt;&gt;<verse eid="MAT 26:72"/></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73"/>Adãrhã ukunjiir, abirabɛ aka adɛ̃ɛ̃ umɔ aba agɔr Ubitru agɛ, &lt;&lt;Idzidzɛrhe ungo uwu unying ru umbɔ, ikpũ arherhango ake akũ ungo adzeka.&gt;&gt;<verse eid="MAT 26:73"/></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74"/>Mɔcɛ unga ayirh agɛ, &lt;&lt;Ikponum ru umum, umum inba ihwɛng utsak uwurɛ!&gt;&gt;</para>
  <para style="p" vid="MAT 26:74">Kanying ikɔ igbɛrkpee. <verse eid="MAT 26:74"/><verse number="75" style="v" sid="MAT 26:75"/>Mɔcɛ Ubitru aka ayita arherhe Uyesu aka arherhe nggu unga agɛ, &lt;&lt;Ungo uwuri itsɛyingo ihwɛng umum idikunga itaar, nu ikɔ idɔrhi igbɛrkpee.&gt;&gt; Ubitru adzek aciu akpe akarhãrhã.<verse eid="MAT 26:75"/></para>
  <chapter eid="MAT 26"/>
  <chapter number="27" style="c" sid="MAT 27"/>
  <para style="s1">Uyahuda ayapuwe itsikamnga</para>
  <para style="r">(<ref loc="MRK 15:1">Umar 15.1</ref>; <ref loc="LUK 23:1-2">Irh 23.1-2</ref>; <ref loc="JHN 18:28-32">Uyoh 18.28-32</ref>; <ref loc="ACT 1:18-19">Aiy 1.18-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1"/>Ri igɔ̃ ukpeeka, kishoo ateiya abika adzowe idɛm-Num nu akakũ anera akɛki itsũwã iyiki ifɛr Uyesu. <verse eid="MAT 27:1"/><verse number="2" style="v" sid="MAT 27:2"/>Umbɔ abow unga, akũna unga azĩ adzowe unga ru Ubirhatu, ugomna.<verse eid="MAT 27:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3"/>Ivangyɛ Uyahuda, uwuku ughadaknga, aka anyã umbɔ aka atsu Uyesu ufai akpe, unga agɔr ra amɛnnga agɛ, &lt;&lt;Uhwɛngrimi.&gt;&gt; Unga abvui aba ra ateiya abika adzowe idɛm-Num nu akakũ aner ha. Abvui adzowuka íshaa imang uazurhfa isɔka itaar ha. <verse eid="MAT 27:3"/><verse number="4" style="v" sid="MAT 27:4"/>Agɛ, &lt;&lt;Umum iwu ra arhim, ubinkutsu, umum iki ighadak adzirh uwuku usheru uvau.&gt;&gt;</para>
  <para style="p" vid="MAT 27:4">Bɔr umbɔ agɔr unga agɛ, &lt;&lt;Akɛrɛ awu use ru umɛn? Umei imesungo.&gt;&gt;<verse eid="MAT 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5"/>Nggee Uyahuda atare uhwɛk uazurhfa ha ru Iya-Num na adzek azĩã. Mɔcɛ unga azĩ ayapuwe itsikamnga.<verse eid="MAT 27:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6"/>Bɔr ateiya abika adzowe idɛm-Num akarhu uhwɛka na agɛ, &lt;&lt;Ri ikpem isi imɛ̃ngge umbɔ atsuke uhwɛk ha ru uhwɛk Iya-Num, uwu ukpu adzirh.&gt;&gt; <verse eid="MAT 27:6"/><verse number="7" style="v" sid="MAT 27:7"/>Nggee umbɔ akɛka na akũ uhwɛka agoi idɛɛ iyɔɔ, ayisi idɛɛ ha agɛ idɛɛ uner uwuku udzin anui. Anang akika adzake ikom atsen. <verse eid="MAT 27:7"/><verse number="8" style="v" sid="MAT 27:8"/>Ngge itsu umbɔ ayisi idɛɛ ha ugɛ Idɛɛ Adzirh utsɛku irherɛ. <verse eid="MAT 27:8"/><verse number="9" style="v" sid="MAT 27:9"/>Mɔcɛ ubinkpi uwuku usɔm Arherhu-Num Uirimiya aka arherhe utsu ufɛrkpɔ ugɛ, &lt;&lt;Umbɔ anyangu íshaa imang uazurhfa isɔka itaar, uhwɛk ha aner Uisrairha aka abema umbɔ afai ri itsinga nukpɔ, <verse eid="MAT 27:9"/><verse number="10" style="v" sid="MAT 27:10"/>umbɔ akũ ngge agoi idɛɛ uner uwuku udzin anui ru nyaku Uteijee aka atsuka umum.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">27.10 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="ZEC 11:12">Uzak 11.12</ref>,<ref loc="ZEC 11:13">13</ref>; <ref loc="JER 19:1-13">Uiri 19.1-13</ref>; <ref loc="JER 32:6-9">32.6-9</ref></char>.</note><verse eid="MAT 27:10"/></para>
  <para style="s1">Uyesu adɛ̃ɛ̃ ra anang Ubirhatu</para>
  <para style="r">(<ref loc="MRK 15:2-15">Umar 15.2-15</ref>; <ref loc="LUK 23:3-24">Irh 23.3-24</ref>; <ref loc="JHN 18:33-19:16">Uyoh 18.33—19.16</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11"/>Uyesu adɛ̃ɛ̃ ra asu ugomna nukpi, ugomna arhusa unga agɛ, &lt;&lt;Ungo uwu uyɛrhe abi Uyahuda?&gt;&gt;</para>
  <para style="p" vid="MAT 27:11">Uyesu agɔr unga agɛ, &lt;&lt;Awu ungo urherhe.&gt;&gt;<verse eid="MAT 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12"/>Bɔr ateiya abika adzowe idɛm-Num nu akakũ anera atsuke unga uvau, unga asi idzipunga urhɛm. <verse eid="MAT 27:12"/><verse number="13" style="v" sid="MAT 27:13"/>Mɔcɛ Ubirhatu arhusa unga agɛ, &lt;&lt;Ungo usi igũo abin avaukɛ umbɔ aka atsuka ungo?&gt;&gt; <verse eid="MAT 27:13"/><verse number="14" style="v" sid="MAT 27:14"/>Bɔr Uyesu asi idzipuka urhɛm ru arherhanga, utsɛku ugomna aka adzeidzeu akarhãrhã.<verse eid="MAT 27:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15"/>Umɔ awu ugau ugomna ri Irhowa Iyiki Igar Utɔng, unga atsũwe uner uvau unying uwuruwi umbɔ aka asɛng. <verse eid="MAT 27:15"/><verse number="16" style="v" sid="MAT 27:16"/>Ri ivang hã umbɔ awu ru ugbau unera, anera kishoo ahwɛngmbɔ unga, itsoka igburh Ubaraba ru ugborzĩ. <verse eid="MAT 27:16"/><verse number="17" style="v" sid="MAT 27:17"/>Nggee ivangyɛ anera aka akɔng, Ubirhatu arhusa umbɔ agɛ, &lt;&lt;Umbi abee umum itsũwã umbi ungamɔ, Ubaraba use Uyesu umbɔ iki iyisa Ukiristo?&gt;&gt; <verse eid="MAT 27:17"/><verse number="18" style="v" sid="MAT 27:18"/>Unga ahwɛnga awu unyɛ̃ɛ̃ utsu umbɔ adzowe Uyesu ru unga.<verse eid="MAT 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19"/>Ubirhatu aka asei ra anang isei aka avarha arherhanga, utsɛ̃nga adene umbɔ adɛyiwe unga agɛ, &lt;&lt;Utsũ ubokngo ra arherhe utsak ha ashia ru uvau, ngge itsu umum igũ uver akarhãrhã irherɛ ru urhɔmum iki irhei ri itsinga.&gt;&gt;<verse eid="MAT 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20"/>Bɔr ateiya abika adzowe idɛm-Num nu akakũ atsu anera agɔr agɛ atsũwe Ubaraba na afɛre Uyesu.<verse eid="MAT 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21"/>Ugomna iganga abvui arhusa umbɔ agɛ, &lt;&lt;Uwuku usong ru umbɔ ikivarhambɔ umbi aka abee umum itsũwã?&gt;&gt;</para>
  <para style="p" vid="MAT 27:21">Umbɔ agɛ, &lt;&lt;Ubaraba.&gt;&gt;<verse eid="MAT 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22"/>Ubirhatu arhusa umbɔ agɛ, &lt;&lt;Umum ikorhi iguse nggu Uyesu umbɔ iki iyisa Ukiristo?&gt;&gt;</para>
  <para style="p" vid="MAT 27:22">Kishookambɔ agɛ, &lt;&lt;Unyapuwe unga!&gt;&gt;<verse eid="MAT 27:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23"/>Ubirhatu arhusa umbɔ agɛ, &lt;&lt;Awu use utsu? Unga akorhu use iyiki ibewe?&gt;&gt;</para>
  <para style="p" vid="MAT 27:23">Bɔr anera abvui atsarhi irhakmbɔ agɛ, &lt;&lt;Unyapuwe unga!&gt;&gt;<verse eid="MAT 27:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24"/>Ivangyɛ Ubirhatu aka anyã unga asi idɛ̃ɛ̃ akorhunga ubin, ikɛi anera agbisha abee isoyi amɛn, unga anyangu amɛ̃ asorh aboknga ra asu anera. Agɛ, &lt;&lt;Umum amɛ̃mum ashike ra adzirh utsak uwurɛ, akɛrɛ awu ra abokmbi!&gt;&gt;<verse eid="MAT 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25"/>Anera kishoo agɛ, &lt;&lt;Adzirhnga awe ru urhɔkmɛn nggu angwɛ̃mɛn!&gt;&gt;<verse eid="MAT 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26"/>Mɔcɛ unga atsũwũka Ubaraba ru umbɔ. Unga atsu abi iwa akwɛre ugwɛɛ ru Uyesu, na adzowuka umbɔ anyapuwe unga.<verse eid="MAT 27:26"/></para>
  <para style="s1">Abi iwa ayɛɛi Uyesu</para>
  <para style="r">(<ref loc="MRK 15:16-20">Umar 15.16-20</ref>; <ref loc="JHN 19:2-3">Uyoh 19.2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27"/>Mɔcɛ abi iwa ugomna akũ Uyesu azĩmbɔ ru udzepurhe ugomna, akɔng kishoo abi iwa adziira unga. <verse eid="MAT 27:27"/><verse number="28" style="v" sid="MAT 27:28"/>Atsimuwe atorhanga na atsĩme atorho aka abãrhã akagɔng. <verse eid="MAT 27:28"/><verse number="29" style="v" sid="MAT 27:29"/>Atsɛrhi ifur iyɛrhe iyi ídidɔk atsime ni itsinga. Atsu unga akpɔm igbong ru ubok ughanga na atangarhu ra anangnga. Ayɛɛia unga agɛ, &lt;&lt;Urhɛngo uder Uyɛrhe abi Uyahuda!&gt;&gt; <verse eid="MAT 27:29"/><verse number="30" style="v" sid="MAT 27:30"/>Ashau aci atsuyiwe unga, ayɛi ugam akwɛr ni itsinga ikɛi. <verse eid="MAT 27:30"/><verse number="31" style="v" sid="MAT 27:31"/>Umbɔ aka ayɛɛi unga amaa, umbɔ atsimuwe atorho aka abãrhã hã na atsĩme atorhanga. Mɔcɛ umbɔ akũna unga azĩmbɔ inyapuwe unga.<verse eid="MAT 27:31"/></para>
  <para style="s1">Anyapuwe Uyesu</para>
  <para style="r">(<ref loc="MRK 15:21-32">Umar 15.21-32</ref>; <ref loc="LUK 23:26-43">Irh 23.26-43</ref>; <ref loc="JHN 19:17-27">Uyoh 19.17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32"/>Umbɔ aka adzek, umbɔ agbopu utsak Usayirin uwɔɔ, itsoka igburh Usiman. Umbɔ atsu unga atsã igãrhãmau ucucii ha. <verse eid="MAT 27:32"/><verse number="33" style="v" sid="MAT 27:33"/>Umbɔ azĩ atsĩ anangkɛ umbɔ aki iyisa Ugorhgota, agbena agburh &lt;&lt;Anang Apfupfu Aghow Itsi.&gt;&gt; <verse eid="MAT 27:33"/><verse number="34" style="v" sid="MAT 27:34"/>Umɔ umbɔ adzowe Uyesu amɛ̃ inebi uku ukpere ugɛ unga ahwa, bɔr unga aka abanga agũ, unga akpɛ̃ɛ̃ ihwihwaa. <verse eid="MAT 27:34"/><verse number="35" style="v" sid="MAT 27:35"/>Ivangyɛ umbɔ aka anyapuwe unga, umbɔ atang isɛng agasha atorhanga.<note caller="+" style="f"><char style="fr" closed="false">27.35 </char><char style="ft" closed="false">Abvur akɔɔ aki itsɛng abok aki isha agɔrke ikɛi ugɛ, </char><char style="fqa" closed="false">Akorha akɛrɛ ngge itsú ubinkpi uner uwuku usɔm Arherhu-Num aka arherhe utsufɛr ugɛ, &lt;&lt;Umbɔ agasha atorhamum nggu adɔkambɔ na atang isɛng ra ake.&gt;&gt;</char></note> <verse eid="MAT 27:35"/><verse number="36" style="v" sid="MAT 27:36"/>Mɔcɛ umbɔ asei umɔ adzɛu unga. <verse eid="MAT 27:36"/><verse number="37" style="v" sid="MAT 27:37"/>Ra afafã igãrhãmau ucucii ha ukhapa ri itsinga, umbɔ atsɛng isarhe uvaunga agɛ, <char style="sc">&lt;&lt;UWƐRƐ AWU UYESU, UYƐRHE ABI UYAHUDA.&gt;&gt;</char> <verse eid="MAT 27:37"/><verse number="38" style="v" sid="MAT 27:38"/>Anyapuwe avɛu avaa nggu unga, unying ru ubok ughanga uwu uvaa ru ubok uferanga. <verse eid="MAT 27:38"/><verse number="39" style="v" sid="MAT 27:39"/>Anera aka atɔng, arhena unga azung atsimbɔ, <verse eid="MAT 27:39"/><verse number="40" style="v" sid="MAT 27:40"/>agɛ, &lt;&lt;Ĩhĩĩ! Ungo iki isipuwe Iya-Num, nu udzine ike ikɛi ri inuma itaar, ucipuwa nu igãrhãmau ucuciia ha ufɔrh itsingo, ungo uba uwu Ungwɛ̃ Unum!&gt;&gt;<verse eid="MAT 27:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41"/>Rimi hã ikɛi ateiya abika adzowe idɛm-Num nu abika amesuwe Ikpem nu akakũ anera ayɛɛia unga. <verse eid="MAT 27:41"/><verse number="42" style="v" sid="MAT 27:42"/>Agɛ, &lt;&lt;Unga afɔrhe abɔɔ, bɔr asi idɛ̃ɛ̃ afɔrha itsinga! Unga aba awu Uyɛrhe Uisrairha, unga acipuwa icɛrɛ ru igãrhãmau ucucii ha, nu umɛn iwe ru imangmang ru unga. <verse eid="MAT 27:42"/><verse number="43" style="v" sid="MAT 27:43"/>Unga awe ru imangmang ru Unum. Uneke Unum afɔrhe unga icɛrɛ, unga aba abeenga. Unga agɛ, &lt;Umum iwu Ungwɛ̃ Unum.&gt; &gt;&gt; <verse eid="MAT 27:43"/><verse number="44" style="v" sid="MAT 27:44"/>Rimi hã avɛu ha umbɔ aka anyapuwe nggu unga arherhuwe unga arherhe aka atãrhã.<verse eid="MAT 27:44"/></para>
  <para style="s1">Akpe Uyesu</para>
  <para style="r">(<ref loc="MRK 15:33-41">Umar 15.33-41</ref>; <ref loc="LUK 23:44-49">Irh 23.44-49</ref>; <ref loc="JHN 19:28-30">Uyoh 19.28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45"/>Utirhi ri idzingga atenuma, uzĩ utsirkpɔ abĩã kishoo utsɛku akara ataar aki urhɛɛ. <verse eid="MAT 27:45"/><verse number="46" style="v" sid="MAT 27:46"/>Ru akara ataar ikɛi Uyesu atsarhi irhaknga ikerketangge agɛ, &lt;&lt;Erhoi, Erhoi,<note caller="+" style="f"><char style="fr" closed="false">27.46 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="PSA 22:1">Amb 22.1</ref></char>.</note> urhama sabaktani?&gt;&gt; agbena agburh, &lt;&lt;A Unummum, a Unummum, awu use utsu ungo uneka umum?&gt;&gt;<verse eid="MAT 27:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47"/>Abika adɛ̃ɛ̃ umɔ aka agũ rimi, umbɔ agɛ, &lt;&lt;Unga adɛ̃ɛ̃ iyisu uner uwuku usɔm Arherhu-Num Uirhiya.&gt;&gt;<verse eid="MAT 27:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 27:48"/>Kanying uwɔɔ atĩ azĩ anyangu usoso. Abii ra amɛ̃ inebi akika agbata, avaki igbong, adzowe Uyesu ugɛ unga ayam. <verse eid="MAT 27:48"/><verse number="49" style="v" sid="MAT 27:49"/>Bɔr abɔɔ agɛ, &lt;&lt;Àka aneke unga, umɛn inyãni use Uirhiya awuri afɔrhuka unga.&gt;&gt;<verse eid="MAT 27:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50"/>Mɔcɛ Uyesu aka abvui atsarhi irhaknga ikerketangge atsu ivum, na atsũwũka ipfunga.<verse eid="MAT 27:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51"/>Ru ivang hã urhaburhe ukpu Iya-Num uvaar akpɛrha avaa udzur ri itsia uba utsĩ abĩã. Abĩ azusa, ífa iyata. <verse eid="MAT 27:51"/><verse number="52" style="v" sid="MAT 27:52"/>Adzak ayar atsuri, ayor asarkasar anera arhɛrhɛ abika akpe asok nggu urhɛ, <verse eid="MAT 27:52"/><verse number="53" style="v" sid="MAT 27:53"/>umbɔ adzeka ra adzakmbɔ. Ivangyɛ Uyesu aka asok ra akpe, abika akpe ha atsĩmbɔ asarkasar uteu Urusharhima, anera arhɛrhɛ aka anyã umbɔ.<verse eid="MAT 27:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54"/>Ri ivang hã uteiya abi iwa Uroma nu abɔɔ abika adɛ̃ɛ̃ adzɛu Uyesu anyã izizusa abĩ nu ikɛi abinkɛ aka akorhe, umbɔ agũ iwei akarhãrhã, na agɛ, &lt;&lt;Idzidzɛrhe uwɛrɛ ha awu Ungwɛ̃ Unum!&gt;&gt;<verse eid="MAT 27:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55"/>Akatsɛrh arhɛrhɛ aka awe umɔ, adɛ̃ɛ̃ ukuka na azɛrhe ubinkpi uku ukorhe. Umbɔ adzeku Ugarhirhi adɔsu Uyesu akorhuwe unga ubinkpi unga aka abee. <verse eid="MAT 27:55"/><verse number="56" style="v" sid="MAT 27:56"/>Ru umbɔ awu umbɔ Umaryamu Umagadarha, nu Umaryamu uyisa Uyaku nu Uyusuf, angwɛ̃ Uzabadi.<verse eid="MAT 27:56"/></para>
  <para style="s1">Igwirhuwe iyor Uyesu</para>
  <para style="r">(<ref loc="MRK 15:42-47">Umar 15.42-47</ref>; <ref loc="LUK 23:50-56">Irh 23.50-56</ref>; <ref loc="JHN 19:38-42">Uyoh 19.38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57"/>Urhɛɛ uku uyo, uner ubin uwɔɔ, utsa Uarimatiya aba umɔ, itsoknga igburh Uyusuf. Unga awu ungwɛ̃ imesu Uyesu. <verse eid="MAT 27:57"/><verse number="58" style="v" sid="MAT 27:58"/>Azĩ ru Ubirhatu, ashɔ̃rhã unga adzowe ukom Uyesu. Ubirhatu atsu umbɔ adzowe ukoma ru unga. <verse eid="MAT 27:58"/><verse number="59" style="v" sid="MAT 27:59"/>Uyusuf ashupu ukom hã, akũ atorho aka afa abɛrh, <verse eid="MAT 27:59"/><verse number="60" style="v" sid="MAT 27:60"/>atsuke ukpɔ ru udzak uku ufa ukpurukpi unga aka atsɛ̃ ri ifɛn utarh. Unga agɔ̃rhũ nggaa utarh afɔme angwĩ udzaka na azĩã. <verse eid="MAT 27:60"/><verse number="61" style="v" sid="MAT 27:61"/>Umaryamu Umagadarha nu Umaryamu uwɔɔ asei akhapa umɔ ra angwĩ udzak ha.<verse eid="MAT 27:61"/></para>
  <para style="s1">Abika adzɛu udzak ha</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62"/>Ukpe unum uvaa, unum ukpuku ugbisha abin uku utɔng, ateiya abika adzowe idɛm-Num nu abi Ufarisi akɔng ra anang Ubirhatu, <verse eid="MAT 27:62"/><verse number="63" style="v" sid="MAT 27:63"/>agɛ, &lt;&lt;A Uteiya! Umɛn iyitumɛn ubinkpi uner uwuku urhɛm aner ha aka arherhe, unga aka ana awe nggu urhɛ, unga agɛ, &lt;Inuma itaar iba iwengge umum iwuri isokũ ra akpe.&gt; <verse eid="MAT 27:63"/><verse number="64" style="v" sid="MAT 27:64"/>Ngge itsu umbɔ adzɛu udzak ha utsɛku inuma itaar, utsur angwɛ̃ imesanga azĩ avɛu ukomnga na agɔr anera ugɛ unga aka asoka ra akpe. Irhirhɛm iyi imaataka iwuri ibewe inangngge iyi inggbaashia.&gt;&gt;<verse eid="MAT 27:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65"/>Ubirhatu agɔr umbɔ agɛ, &lt;&lt;Àka akarha abi iwa azĩ adzɛu kishoo ri ikermbi.&gt;&gt; <verse eid="MAT 27:65"/><verse number="66" style="v" sid="MAT 27:66"/>Nggee umbɔ azĩ avinu udzak ha, akwɛr utsar iyɛrhe nú utarh udzak ha, atsu abi iwa adzɛu anang hã.<verse eid="MAT 27:66"/></para>
  <chapter eid="MAT 27"/>
  <chapter number="28" style="c" sid="MAT 28"/>
  <para style="s1">Isisok Uyesu ra akpe</para>
  <para style="r">(<ref loc="MRK 16:1-8">Umar 16.1-8</ref>; <ref loc="LUK 24:1-12">Irh 24.1-12</ref>; <ref loc="JHN 20:1-10">Uyoh 20.1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1"/>Unum ukpuku Uwosha uku utɔng, ru unkpeka unum ukpu inggbaashia ru inuma utɔɔva, Umaryamu Umagadarha nu Umaryamu uwɔrɔ azĩmbɔ iyepu udzak ha.<verse eid="MAT 28:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2"/>Umɔ nggaa izizusa abĩ iki izusa, ipfu itser Uteijee idzeka afã, izĩngge ru udzak ha, igɔ̃rhuwe utarh ha umbɔ aka atsĩme udzak ha, isei nú ukpɔ. <verse eid="MAT 28:2"/><verse number="3" style="v" sid="MAT 28:3"/>Idzidzeka ngge irhang ru nyaki inai iki inyaka, atorha ake awu uku upɛ̃rhɛng ugɛɛ aghwitu urhurhu. <verse eid="MAT 28:3"/><verse number="4" style="v" sid="MAT 28:4"/>Abi idzɛu aka anyã ngge, iwei ifɛr umbɔ, azang ayormbɔ agbei ra abĩ ugɛɛ ikom.<verse eid="MAT 28:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5"/>Bɔr ipfu itser-Num hã igɔr akatsɛrh ha igɛ, &lt;&lt;Àka niba agũmbi iwei, umum ihwɛng umbi abee Uyesu uwuruwi umbɔ aka anyapuwe. <verse eid="MAT 28:5"/><verse number="6" style="v" sid="MAT 28:6"/>Unga ashia nggimi, unga aka asoka, ru nyaka unga aka arherhe. Àka aba anyã anangkɛ unga aka anu. <verse eid="MAT 28:6"/><verse number="7" style="v" sid="MAT 28:7"/>Mɔcɛ àka azĩ ifetem azĩ asɔme angwɛ̃ imesanga ugɛ, &lt;Unga aka asoka ra akpe, nggawɔ agbaashia azĩ Ugarhirhi ru umbi. Nggɔɔ ha umbi awuri inyãmbi unga.&gt; Àka agũ, umum iki idɛyiwamum umbi.&gt;&gt;<verse eid="MAT 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8"/>Nggee akatsɛrh ha iki ifefetem asokmbɔ ru udzaka, agũ iwei nggu anggɔm, atĩ azĩ idɛyiwe angwɛ̃ imesanga. <verse eid="MAT 28:8"/><verse number="9" style="v" sid="MAT 28:9"/>Kanying Uyesu agbopa umbɔ. Agɔr umbɔ agɛ. &lt;&lt;Ighwe umbi!&gt;&gt; Umbɔ agɔpa aba awuma adaknga, adzowe unga igɔng. <verse eid="MAT 28:9"/><verse number="10" style="v" sid="MAT 28:10"/>Mɔcɛ Uyesu agɔr umbɔ agɛ, &lt;&lt;Àka niba agũmbi iwei. Àka azĩ asɔme angwɛ̃mɛn umbɔ azĩ Ugarhirhi. Nggɔɔ ha umbɔ aka inyã umum.&gt;&gt;<verse eid="MAT 28:10"/></para>
  <para style="s1">Ubinkpi abi idzɛu aka arherhe</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11"/>Akatsɛrh ha awe ru uzɛ̃rhã, abɔɔ abi idzɛu udzak ha atsĩmbɔ utepa, asɔme ateiya abika adzowe idɛm-Num kishoo ubinkpi uku ukorhe. <verse eid="MAT 28:11"/><verse number="12" style="v" sid="MAT 28:12"/>Ivangyɛ ateiya abika adzowe idɛm-Num nu akakũ anera akɔng akɛki itsũwã, umbɔ adzowe abi iwa ha uhwɛk urhɛrhɛ. <verse eid="MAT 28:12"/><verse number="13" style="v" sid="MAT 28:13"/>Agɔr umbɔ agɛ, &lt;&lt;Àka agɔr agɛ, &lt;Angwɛ̃ imesanga aba avɛu ukomnga ru untsuuka, ri ivangyɛ umbi aka awe ru urhɔ.&gt; <verse eid="MAT 28:13"/><verse number="14" style="v" sid="MAT 28:14"/>Arherha akɛrɛ aba atsĩke ra ato ugomna, umɛn iwuri irherhumɛn arherhe nggu unga, umbi asi íhwambi uver.&gt;&gt; <verse eid="MAT 28:14"/><verse number="15" style="v" sid="MAT 28:15"/>Nggee abi iwa ha ayɛi uhwɛka na akorhe ru nyaka umbɔ aka agɔr umbɔ akorhe. Nu arherhe akɛrɛ atɛ̃rhã amaake abi Uyahuda aba atsĩ irherɛ.<verse eid="MAT 28:15"/></para>
  <para style="s1">Itseryɛ Uyesu aka adzowe <optbreak/> angwɛ̃ imesanga</para>
  <para style="r">(<ref loc="MRK 16:14-18">Umar 16.14-18</ref>; <ref loc="LUK 24:36-49">Irh 24.36-49</ref>; <ref loc="JHN 20:19-23">Uyoh 20.19-23</ref>; <ref loc="ACT 1:6-8">Aiy 1.6-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16"/>Mɔcɛ angwɛ̃ imesa ha usɔka nu unying hã azĩmbɔ Ugarhirhi, azĩmbɔ ri igũ hã Uyesu aka agɔr umbɔ izĩ. <verse eid="MAT 28:16"/><verse number="17" style="v" sid="MAT 28:17"/>Umbɔ aka anyã unga, umbɔ adzowe unga igɔng, bɔr abɔɔ acucang. <verse eid="MAT 28:17"/><verse number="18" style="v" sid="MAT 28:18"/>Mɔcɛ Uyesu aba ru umbɔ agɔr umbɔ agɛ, &lt;&lt;Aka adzaambɔ umum ijeea kishoo iyi afã nggu abĩ. <verse eid="MAT 28:18"/><verse number="19" style="v" sid="MAT 28:19"/>Nggee àka azĩ akũ anera kishoo ru upfunga aba adɔsa umum. Àka asorhuwe umbɔ ubɔtisima ri itsok Utɛ nu iki Ungwɛ̃ nu iki Ipfu Isarsatangge.<note caller="+" style="f"><char style="fr" closed="false">28.19 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="ACT 8:16">Aiy 8.16</ref>; <ref loc="ACT 19:5">19.5</ref></char>.</note> <verse eid="MAT 28:19"/><verse number="20" style="v" sid="MAT 28:20"/>Àka amesuwe umbɔ adɔsa kishoo abinkɛ umum iki itsuka umbi. Idzidzɛrhe umum iwe nggu umbi, utsɛku imimashu upfung.&gt;&gt;<verse eid="MAT 28:20"/></para>
  <chapter eid="MAT 28"/>
</usx>
