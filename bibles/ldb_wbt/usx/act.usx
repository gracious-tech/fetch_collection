<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ACT" style="id">- Dũya Translation Project</book>
  <para style="h">Abi Itser-Yesu</para>
  <para style="toc1">Ubvur Ikikorhe Abi Itser-Yesu</para>
  <para style="toc2">Abi Itser-Yesu</para>
  <para style="toc3">Aiy</para>
  <para style="mt1">Ubvur Ikikorhe <optbreak/> Abi Itser-Yesu</para>
  <para style="imt">Utsutson ri itsi ubvur Ikikorhe Abi Itser-Yesu</para>
  <para style="ip">Abika awe ru ihwihwɛng abemumbɔ ugɛ awu Irhuka uwɛrhu uzãrhã Uburhu uner itser Uyesu unga atsɛng <char style="it">Ubvur Ikikorhe Abi Itser-Yesu</char> nu <char style="it">Ubvur uwu Irhuka</char> (<char style="xt"><ref loc="ACT 16:10-17">16.10-17</ref>; <ref loc="ACT 20:5-15">20.5-15</ref>; <ref loc="ACT 21:1-18">21.1-18</ref>; <ref loc="ACT 27:1-28:16">27.1—28.16</ref></char>). Anera arhɛrhɛ aka arherha arherhe ri itsi ivangyɛ umbɔ aka atsɛng ubvur uwurɛ. Abɔɔ abemumbɔ ugɛ atsɛng ubvur ha ivanga unying nggu <char style="it">Ubvur uwu Irhuka.</char></para>
  <para style="ip">Ubvur ha udɛyiwe ititirhi agbeyi abika adɔsa ra abi Uyahuda ru Urusharhima nu ititɛ̃rhãngge ra abirabɛ aka asi iwembɔ abi Uyahuda ubɛn ananga ru upfunga.</para>
  <para style="ip">
    <char style="it">Ubvur ikikorhe abi itser Uyesu</char> awe ru nyaku udaar ra abinkɛ Uyesu aka akorhe ri ivangyɛ unga aka awe ru upfung nu ikɛi abinkɛ abi itser Uyesu aka adɛ̃ɛ̃ ikorhe. Ipfu Isarsatangge itɔ̃ itser akarhãrhã ri idzowe abi itser Uyesu ijee iyiki idũwũ Isarhe Iyiki Ize ha. Ubvur ha udɛyiwe ra awiya ri itsi ibibɛk nu itsermbɔ Ubitru nggu Uburhu nu abɔɔ abika adzowe Isarhe Uyesu. Ubɛn anangkɛ umbɔ aka adũwũ Isarhe Iyiki Ize iyɛrɛ, anera aki isaka awe ru imangmang, bɔr igha inggbaashi iyɛrɛ iki isaki iba nggu uver.</para>
  <para style="iot">Abinkɛ aka awe umɔ</para>
  <para style="io1">Udũwã ri itsi Isarhe Iyiki Ize <char style="ior">(<ref loc="ACT 1:1-26">1.1-26</ref>)</char></para>
  <para style="io1">Udũwã ri itsi Isarhe Iyiki Ize ru Urusharhima <char style="ior">(<ref loc="ACT 2:1-8:3">2.1—8.3</ref>)</char></para>
  <para style="io1">Ititɛ̃rhã Isarhe Iyiki Ize ru Uyahuda nu Usamariya <char style="ior">(<ref loc="ACT 8:4-12:25">8.4—12.25</ref>)</char></para>
  <para style="io1">Uzãrhã Uburhu ukpu inggbaashia ukpu idzowe Isarhe Iyiki Ize <char style="ior">(<ref loc="ACT 13:1-14:28">13.1—14.28</ref>)</char></para>
  <para style="io1">Ikikɔng abika adɔsa ru Urusharhima <char style="ior">(<ref loc="ACT 15:1-35">15.1-35</ref>)</char></para>
  <para style="io1">Uzãrhã Uburhu ukpu uvaa ukpu idzowe Isarhe Iyiki Ize <char style="ior">(<ref loc="ACT 15:36-18:22">15.36—18.22</ref>)</char></para>
  <para style="io1">Uzãrhã Uburhu ukpu untaar ukpu idzowe Isarhe Iyiki Ize <char style="ior">(<ref loc="ACT 18:23-21:16">18.23—21.16</ref>)</char></para>
  <para style="io1">Adzur uburhu ru Urusharhima <char style="ior">(<ref loc="ACT 21:17-23:22">21.17—23.22</ref>)</char></para>
  <para style="io1">Agbange Uburhu ru Ukasariya <char style="ior">(<ref loc="ACT 23:23-26:32">23.23—26.32</ref>)</char></para>
  <para style="io1">Akũ Uburhu azĩmbɔ Uroma <char style="ior">(<ref loc="ACT 27:1-28:31">27.1—28.31</ref>)</char></para>
  <chapter number="1" style="c" sid="ACT 1"/>
  <para style="s1">Akũ Uyesu afũ azĩmbɔ ra afã</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1"/>A uze Utiyofirhu, ru ubvurmum uwu inggbaashia, umum itsɛng abina kishoo akirakɛ Uyesu aka atirha akorhe na amesuwe <verse eid="ACT 1:1"/><verse number="2" style="v" sid="ACT 1:2"/>utsɛku unumkpi umbɔ aka ashupa unga afũ azĩ ra afã. Ipfu Isarsatangge iki idarh unga amaa itsu itser ra abi itser Uyesu unga aka asɛng. <verse eid="ACT 1:2"/><verse number="3" style="v" sid="ACT 1:3"/>Unga aka ahwa ayetnum amaa, unga adɛyiwe itsinga ra abi itser Uyesu ha na akorhi ikpũ abinkɛ aka atsu umbɔ anyã unga awea ru urhɛ. Unga adzeyiwa ru umbɔ inuma isɔka inaa na arherhe arherhe Iyɛrhe Unum. <verse eid="ACT 1:3"/><verse number="4" style="v" sid="ACT 1:4"/>Ivanga niyɔ unga aka asei ighigha nggu umbɔ, unga agɔr umbɔ agɛ, &lt;&lt;Àka niba adzembi ru Urusharhima, bɔr àka adzɛu izũwũ Utɛmum aka abemuwa, umum iki irherha ngge ri igigũmbi. <verse eid="ACT 1:4"/><verse number="5" style="v" sid="ACT 1:5"/>Uyohana asorhuwe anera ubɔtisima nggu amɛ̃, bɔr inuma ukunjiir iki iba, awuri isorhuwa umbi ubɔtisima nggu Ipfu Isarsatangge.&gt;&gt;<verse eid="ACT 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6"/>Nggee umbɔ aka akɔng, umbɔ arhusa unga agɛ, &lt;&lt;A Uteijee, awu icɛrɛ ungo iki ibvui udzowe iyɛrhe Uisrairha?&gt;&gt;<verse eid="ACT 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 1:7"/>Bɔr unga agɔr umbɔ agɛ, &lt;&lt;Asi iwea umbi awuri ihwɛng ivanga use inumyɛ Utɛ aka angwɛ̃ ri ijeenga. <verse eid="ACT 1:7"/><verse number="8" style="v" sid="ACT 1:8"/>Bɔr umbi awuri iyɛimbi ijee ri ivangyɛ Ipfu Isarsatangge iki icipuwa nu umbi, umbi awuri iwu idekamum ru Urusharhima, nu kishoo abĩ Uyahudiya nu aki Usamariya, uzĩ utsĩ ra abĩã kishoo.&gt;&gt;<verse eid="ACT 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 1:9"/>Unga aka arherha akɛrɛ ha amaa, umbɔ ashupa unga ra asumbɔ afũ afafã, nu amɛɛ atsirke unga ri inyĩnyãmbɔ.<verse eid="ACT 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 1:10"/>Umbɔ aka atsu asumbɔ arhi izizĩnga ra afã, kanying inera ivaa itsim atorho akika aterha idɛ̃ɛ̃ ikhapa nggu umbɔ. <verse eid="ACT 1:10"/><verse number="11" style="v" sid="ACT 1:11"/>Iner ha igɔr umbɔ ugɛ, &lt;&lt;Umbi abi Ugarhirhi, awu use utsu umbi adɛ̃ɛ̃ nggimi anu irhi afã? Uyesu ha umbɔ aka ashupa ru umbi ha akũ azĩmbɔ ra afã, awuri ibvui abanga ru nyaka umbi aka anyã ififũnga ra afã.&gt;&gt;<verse eid="ACT 1:11"/></para>
  <para style="s1">Asɛng Umatiya unga ayɛi itser Uyahuda</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12"/>Mɔcɛ umbɔ abvui azĩ Urusharhima adzeku Igũ Acucii Uzaitun, iyiriyɛ iki ikhapa ru Urusharhima, iderngge iki iyongge ukirhomita unying. <verse eid="ACT 1:12"/><verse number="13" style="v" sid="ACT 1:13"/>Umbɔ aka azĩ atsĩ, umbɔ afũmbɔ ru ubã afã ra anangkɛ umbɔ aka asei. Awu umbɔ Ubitru, Uyohana, Uyaku nu Uandarawu, Ufirhibu nu Utoma, Ubatorhomi nu Umatiyu, Uyaku ungwɛ̃ Uharhfa nu Usiman Uzarhoti, nu Uyahuda ungwɛ̃ Uyaku. <verse eid="ACT 1:13"/><verse number="14" style="v" sid="ACT 1:14"/>Abɛrɛ ha kishoo aka isaka atsu atsimbɔ akɔng ri ifɛn-Num nggu amɛn unying, nggu akatsɛrh abɔɔ nu Umaryamu, uyisa Uyesu, nu angwɛ̃mbɔ Uyesu.<verse eid="ACT 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15"/>Inum hã niyɔ Ubitru aka asok adɛ̃ɛ̃ ri ikikɔng abika adɔsa, iyiriyɛ iki iyongge inera unaka ni isɔka ivaa, na agɛ, <verse eid="ACT 1:15"/><verse number="16" style="v" sid="ACT 1:16"/>&lt;&lt;Umbi angwɛ̃mɛn nu anapumɛn, awu ufang ngge iki itsuifɛr Arherhu-Num aki Ipfu Isarsatangge iki irherhe ishaisha ra angwĩ Udauda, ri itsi Uyahuda, unga aka agbaashia ra abika adzur Uyesu. <verse eid="ACT 1:16"/><verse number="17" style="v" sid="ACT 1:17"/>Unga uwi awe ru umɛn, awea ri itser ri itser iyɛrɛ.&gt;&gt;<verse eid="ACT 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 1:18"/>Nggu itosayɛ unga aka akpo iyi amɛn aka abewe, Uyahuda akũ agoi idɛɛ, umɔ unga aka agba nggu itsia, iyora iyar iyanga, abina anaanga kishoo adzeka awiya. <verse eid="ACT 1:18"/><verse number="19" style="v" sid="ACT 1:19"/>Kishoo anera ru Urusharhima agũmbɔ akɛrɛ ha, nggee umbɔ ayisi idɛɛ ha agɛ &lt;&lt;Uakarhdama,&gt;&gt; ri idũmbɔ agbena agburh &lt;&lt;Idɛɛ Adzirh.&gt;&gt;<verse eid="ACT 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20"/>Unga agɔr agɛ, &lt;&lt;Ubinkutsu atsɛngmbɔ ru Ubvur Ambom ugɛ,</para>
  <para style="q1" vid="ACT 1:20">&lt;&lt; &lt;Uneke iyanga ima iwu arhang,</para>
  <para style="q2" vid="ACT 1:20">utsur unera aseisa umɔ,&gt;<note caller="+" style="f"><char style="fr" closed="false">1.20 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="PSA 69:25">Amb 69.25</ref></char>.</note></para>
  <para style="m" vid="ACT 1:20">nu,</para>
  <para style="q1" vid="ACT 1:20">&lt;&lt; &lt;Uneke itsernga ikɛi uner uwɔɔ ama anyangu ukam.&gt;<note caller="+" style="f"><char style="fr" closed="false">1.20 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="PSA 109:8">Amb 109.8</ref></char>.</note><verse eid="ACT 1:20"/></para>
  <para style="m">
    <verse number="21" style="v" sid="ACT 1:21"/>Nggee awu ufang umɛn isɛng unera unying ra aner abɛrɛ aka awu nggu umɛn ri ivanga kishoo Uteijee Uyesu aka awu nggu umɛn, <verse eid="ACT 1:21"/><verse number="22" style="v" sid="ACT 1:22"/>udzur ri ivangyɛ Uyohana aka asorhuwe unga ubɔtisima uba utsĩ ri ivangyɛ umbɔ aka ashupuwe unga ra ateumɛn. Awu ufang umɛn isɛng unera aka awe ru ideka isisoknga ra akpe nggu umɛn.&gt;&gt;<verse eid="ACT 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23"/>Nggee umbɔ aden inera ivaa, Uyusuf umbɔ iki iyisa Ubarsabba, ikɛi umbɔ iki iyisa Ujustu, nu Umatiya. <verse eid="ACT 1:23"/><verse number="24" style="v" sid="ACT 1:24"/>Mɔcɛ umbɔ afɛn-Num agɛ, &lt;&lt;A Uteijee, ungo uhwɛng amɛn anera kishoo. Ra abɛrɛ ikivarhambɔ, udɛyiwa uwuruwi ungo uku usɛng <verse eid="ACT 1:24"/><verse number="25" style="v" sid="ACT 1:25"/>unga anyangi itser uner itser Uyesu, iyi Uyahuda aka aneke na azĩã anang hã aka awe akinga.&gt;&gt; <verse eid="ACT 1:25"/><verse number="26" style="v" sid="ACT 1:26"/>Mɔcɛ umbɔ atang isɛng ru umbɔ. Umatiya unga agha, nggee umbɔ atoma unga nggu abi itser Uyesu, udom hã.<verse eid="ACT 1:26"/></para>
  <chapter eid="ACT 1"/>
  <chapter number="2" style="c" sid="ACT 2"/>
  <para style="s1">Ipfu Isarsatangge iba ru unum Upentiko</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1"/>Unum irhowu Upentiko iki iwe, abika adɔsa kishoo akɔng ananga unying. <verse eid="ACT 2:1"/><verse number="2" style="v" sid="ACT 2:2"/>Kanying umbɔ agũ irhak iki idzeka afã ru nyaku ugba ukom, udzeka afã uba utɔkpɔ iyakɛ umbɔ aka asei. <verse eid="ACT 2:2"/><verse number="3" style="v" sid="ACT 2:3"/>Mɔcɛ umbɔ anyã ubina ru nyaki ikon urha, uku ugasha ucipuwa ra atsimbɔ unying anying. <verse eid="ACT 2:3"/><verse number="4" style="v" sid="ACT 2:4"/>Nu kishoo awu nggu Ipfu Isarsatangge, atsĩmbɔ irherhe idũ abikase Ipfu-Num iki idzowe umbɔ ijeea. <figure style="fig" alt="The coming of the Holy Spirit" file="DN00498b.tif" size="col" loc="ACT 2" copy="Horace Knowles" ref="2.3">Ibiba Ipfu Isarsatangge iyi Unum</figure><verse eid="ACT 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5"/>Ri ivang hã ru Urusharhima abi Uyahuda abi iwei Unum aka asei umɔ adzeka ru ubɛn abĩ upfung ukpirɛ. <verse eid="ACT 2:5"/><verse number="6" style="v" sid="ACT 2:6"/>Umbɔ aka agũ ubvun ugba ha, anera aka akɔng adzunumbɔ, ubinkutsu ubɛn unera agũ umbɔ arherhe idũnga. <verse eid="ACT 2:6"/><verse number="7" style="v" sid="ACT 2:7"/>Umbɔ adzeidzeu akarhãrhã, na arhusa agɛ, &lt;&lt;Kishoo abika arherha arherha ha, asi iwembɔ aner Ugarhirhi? <verse eid="ACT 2:7"/><verse number="8" style="v" sid="ACT 2:8"/>Awu use utsu ubɛn unera ru umɛn agũ umbɔ arherhe idũnga? <verse eid="ACT 2:8"/><verse number="9" style="v" sid="ACT 2:9"/>Umɛn abɛ iwu abi Upartiya, nu Umadiya nu Uerhama, nu aner abĩ Umesofotamiya, nu abi Uyahudiya nu abi Ukafadokiya, nu abi Upanta nu abi Uasiya, <verse eid="ACT 2:9"/><verse number="10" style="v" sid="ACT 2:10"/>nu abi Ufirijiya nu abi Upamfirhiya, aka adzeka abĩ Umasar, nu ikɛi abɔɔ aka akhapa ru abĩ Urhibiya aka akhapa ru Usayirin. Umɛn abɔɔ idzeku Uroma, <verse eid="ACT 2:10"/><verse number="11" style="v" sid="ACT 2:11"/>ru umɛn hã, abɔɔ awu abi Uyahuda na abirabɛ aka adzipa adɔsa agbeyambɔ, ikɛi abɔɔ awu abi Ukarita nu abi Urharaba, kishoo iki igũ umbɔ anu irherhe abin idzeu Unum ri idũmɛn!&gt;&gt; <verse eid="ACT 2:11"/><verse number="12" style="v" sid="ACT 2:12"/>Kishoo adzeidzeu na adzunumbɔ, agɔr adɔkambɔ agɛ, &lt;&lt;Agben akɛrɛ ha awu use?&gt;&gt;<verse eid="ACT 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 2:13"/>Bɔr abɔɔ umɔ ayɛia umbɔ agɛ, &lt;&lt;Ahwa adɛ afĩrhã!&gt;&gt;<figure style="fig" file="ldb GPS_Pentecost_B&amp;W.jpg" size="span" copy="WBT" ref="2.6-11">Upentiko</figure><verse eid="ACT 2:13"/></para>
  <para style="s1">Ubitru adzowe isarhe ra anera</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14"/>Bɔr Ubitru abere nggu umbɔ udom hã, atsarhi irhaknga arherhe arherhe nggu anera agɛ, &lt;&lt;Umbi abimɛn abi Uyahudiya nu kishoo abi Urusharhima, umum idɛyiwa umbi arherhe akɛ, àka akpeto ru ubinkpi umum iki irherhe. <verse eid="ACT 2:14"/><verse number="15" style="v" sid="ACT 2:15"/>Anera abɛrɛ asi ifĩrhũmbɔ adɛ ru nyaka umbi aka akaifɛrhkɔ, nggayɛ awu akara utɔɔrha aki ukpee! <verse eid="ACT 2:15"/><verse number="16" style="v" sid="ACT 2:16"/>Ĩ'ĩ, awu ubin hã nukpi uner uwuku usɔm Arherhu-Num Uyowɛrh aka arherhe agɛ,<verse eid="ACT 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 2:17"/>&lt;&lt; &lt;Unum agɔr agɛ, ri inum iyiki imimasha,</para>
  <para style="q2" vid="ACT 2:17">umum iwuri itsuke Ipfumum ra anera kishoo.</para>
  <para style="q1" vid="ACT 2:17">Nu awɛkacimbi akatsɛrh na akatsak</para>
  <para style="q2" vid="ACT 2:17">awuri isɔm Arherhu-Num,</para>
  <para style="q1" vid="ACT 2:17">na awɛdzɛmmbi awuri inyãmbɔ irhi,</para>
  <para style="q2" vid="ACT 2:17">nu akakũmbi ikɛi awuri irheyimbɔ urhɔ.<verse eid="ACT 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 2:18"/>Ra agãrhãmum akatsɛrh nu akatsak,</para>
  <para style="q2" vid="ACT 2:18">umum iwuri itsuke Ipfumum ri inum hã,</para>
  <para style="q2" vid="ACT 2:18">nu umbɔ ikɛi awuri isɔmmbɔ Arherhu-Num.<verse eid="ACT 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ACT 2:19"/>Umum iwuri idɛyiwe abin idzeu afafã ra afã,</para>
  <para style="q2" vid="ACT 2:19">na atsar anɔnɔr nu abĩ,</para>
  <para style="q2" vid="ACT 2:19">adzirh, nu urha, nu ikɛi azoo aka afĩrhã asok arhɛrhɛ.<verse eid="ACT 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ACT 2:20"/>Ishaa unum iwuri idzipa iwu uzĩ,</para>
  <para style="q2" vid="ACT 2:20">ufɛ̃ ikɛi uwuri iwu uku uzhãĩ ru nyaka adzirh,</para>
  <para style="q2" vid="ACT 2:20">kata ibiba nggaa ikpikpoi unum ukpu Uteijee.<verse eid="ACT 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ACT 2:21"/>Nu ubɛn unera aka afɛn Uteijee</para>
  <para style="q2" vid="ACT 2:21">awuri ikpoa ififɔrh.&gt;<note caller="+" style="f"><char style="fr" closed="false">2.21 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="JOL 2:28-32">Uyow 2.28-32</ref></char>.</note><verse eid="ACT 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22"/>&lt;&lt;Umbi abimɛn abi Uisrairha, àka akpeto ra arherhe akɛrɛ, Uyesu aka awu uner Unazarat unerwi Unum aka asɛng unga akorha abin idzeu, nu abin igbigba na atsar, akirakɛ Unum aka akorhe ru umbi ri itsinga, ru nyaka umbi itsikammbi aka ahwɛng. <verse eid="ACT 2:22"/><verse number="23" style="v" sid="ACT 2:23"/>Utsak uwurɛ adzowe unga ru umbi ri ikikorhu Unum ikɛi ri itsernga nu ihwihwɛngnga, umbi akũ akusa akwɛr anyapuwe unga nu igãrhãmau ucucii, afɛre unga ra abok abi arhim. <verse eid="ACT 2:23"/><verse number="24" style="v" sid="ACT 2:24"/>Bɔr Unum asoyika unga na ashɔɔrka unga ru uver akpe, ubinkutsu akpe asi idɛ̃ɛ̃ akpɔmke unga. <verse eid="ACT 2:24"/><verse number="25" style="v" sid="ACT 2:25"/>Udauda arherhunga arherhe ri itsinga agɛ,</para>
  <para style="q1" vid="ACT 2:25">&lt;&lt; &lt;Ubɛn ivang umum inyã Uteijee awu nggu umum.</para>
  <para style="q2" vid="ACT 2:25">Ubinkutsu unga awe ru ubok ughamum,</para>
  <para style="q2" vid="ACT 2:25">umum isi ízusumum.<verse eid="ACT 2:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 2:26"/>Nggee amɛnmum agɔm anggɔm,</para>
  <para style="q2" vid="ACT 2:26">arhɛmmum agũibɛn akarhãrhã</para>
  <para style="q2" vid="ACT 2:26">iyormum ikɛi iwuri iwosha ri ifosa,<verse eid="ACT 2:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 2:27"/>Ubinkutsu, ungo usi ínekango umum ru udzak,</para>
  <para style="q2" vid="ACT 2:27">use ungo ineke Usarkasar Unerngo avɔ̃ɔ̃.<verse eid="ACT 2:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 2:28"/>Ungo uku utsu umum ihwɛng utsĩndĩ urhɛ,</para>
  <para style="q2" vid="ACT 2:28">ungo uwuri itɔka umum nggu anggɔm ra anangngo.&gt;<note caller="+" style="f"><char style="fr" closed="false">2.28 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="PSA 16:8-11">Amb 16.8-11</ref></char>.</note><verse eid="ACT 2:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29"/>&lt;&lt;Umbi abimɛn abi Uisrairha, umum iwemum ri ikeramɛn iki idɛyiwa umbi ugɛ utoka atokamɛn Udauda aka akpea nu umbɔ aka adzakukumbɔ unga, ikɛi udzaknga uwu nggu umɛn uba utsĩ irherɛ. <verse eid="ACT 2:29"/><verse number="30" style="v" sid="ACT 2:30"/>Bɔr unga awu uner uwuku usɔm Arherhu-Num, na ahwɛnga Unum aka abemuka unga nggu uyirh agɛ, unga awuri itsu unangnga unying nu utarh isei iyɛrhanga. <verse eid="ACT 2:30"/><verse number="31" style="v" sid="ACT 2:31"/>Unga aka anyã, arherha arherhe isisok Ukiristo ra akpe, agɛ asi ínekukumbɔ iyornga ru udzak, iyornga ikɛi isi ívɔ̃ngge. <verse eid="ACT 2:31"/><verse number="32" style="v" sid="ACT 2:32"/>Unum aka asoyika Uyesu ha nggu urhɛ, nu umɛn kishoo iwu ideka umɔ ni idzidzɛrha ha. <verse eid="ACT 2:32"/><verse number="33" style="v" sid="ACT 2:33"/>Unum adzowe unga imor nu ubok ughanga, unga aka ayɛi ibibemuwe Ipfu Isarsatangge ru Utɛ, na awupuwa ubinkpi umbi aka anyã na agũ icɛrɛ. <verse eid="ACT 2:33"/><verse number="34" style="v" sid="ACT 2:34"/>Udauda asi ifũã ra afã, bɔr unga agɔr agɛ,</para>
  <para style="q1" vid="ACT 2:34">&lt;&lt; &lt;Uteijee agɔr Uteijeemum agɛ,</para>
  <para style="q2" vid="ACT 2:34">&lt;&lt;Usei nu ubok ughamum,<verse eid="ACT 2:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="ACT 2:35"/>utsɛku umum iki itsu anggamtsakngo</para>
  <para style="q2" vid="ACT 2:35">awu ubin uku utsorhe andaidakngo.&gt;&gt; &gt;<note caller="+" style="f"><char style="fr" closed="false">2.35 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="PSA 110:1">Amb 110.1</ref></char>.</note><verse eid="ACT 2:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36"/>&lt;&lt;Nggee, uneke aner Uisrairha ahwɛng ugɛ, Unum aka atsu Uyesu uwuruwi, umbi aka anyapuwe nu ucucii awu Uteijee na awu Ukiristo ikɛi.&gt;&gt;<verse eid="ACT 2:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37"/>Anera aka agũ rimi, amɛnmbɔ agbɛra adzɛu, na agɔr Ubitru nu abi itser Uyesu abɔɔ, agɛ, &lt;&lt;Umbi angwɛ̃mɛn, umɛn ikorhi uguse?&gt;&gt;<verse eid="ACT 2:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 2:38"/>Ubitru agɔr umbɔ agɛ, &lt;&lt;Àka adzipa ra arhimmbi umbɔ asorhuwa umbi ubɔtisima ri itsok Uyesu Ukiristo ngge atsũwe arhimmbi. Ikɛi umbi awuri iyɛimbi izũwũ Ipfu Isarsatangge. <verse eid="ACT 2:38"/><verse number="39" style="v" sid="ACT 2:39"/>Ubinkutsu ibibemuwe ha iwu iyimbi nu angwɛ̃mbi nu kishoo abi anang aka ader, umbɔ abirabɛ Uteijee Unummɛn aka awuri iyisa umbɔ.&gt;&gt;<verse eid="ACT 2:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40"/>Nggu irhɛm iyɔɔ irhɛirhɛ unga aka adzowe itsũwã na afituwe umbɔ agɛ, &lt;&lt;Àka afɔrh atsimbi ru ubinkpi uku udzɛu abi amɛn akatãrhã aki udan ukpirɛ.&gt;&gt; <verse eid="ACT 2:40"/><verse number="41" style="v" sid="ACT 2:41"/>Abika ayɛi isarhanga hã umbɔ akorhuwe umbɔ ubɔtisima, ru unum hã umbɔ ayombɔ inera anaka agɔnga ataar (3,000) atoma ri irhɛɛmbɔ.<verse eid="ACT 2:41"/></para>
  <para style="s1">Iwɛrhɛ abika adɔsa</para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 2:42"/>Umbɔ atsu atsimbɔ ri ikpeto ri imesa abi itser Uyesu, nu iwɛrhɛ abika adɔsa, nu itsɔku uborodi ri ifɛn-Num. <verse eid="ACT 2:42"/><verse number="43" style="v" sid="ACT 2:43"/>Unum akorha abin igbigba na abin idzeu arhɛrhɛ ru ubok abi itser Uyesu, nu ubɛn unera agũ idzeu. <verse eid="ACT 2:43"/><verse number="44" style="v" sid="ACT 2:44"/>Kishoo abika adɔsa awu unying, nu abinmbɔ kishoo awu aki adɔkambɔ. <verse eid="ACT 2:44"/><verse number="45" style="v" sid="ACT 2:45"/>Agoyiwe abin ukammbɔ, na agashuwe uhwɛka ra adɔkambɔ uku kpengkpeng ri itsũwãmbɔ. <verse eid="ACT 2:45"/><verse number="46" style="v" sid="ACT 2:46"/>Ubɛn unum umbɔ anu ikɔng ru ufɔm Iya-Num nggu amɛn unying. Agha ubingha ananga unying ra ayambɔ, agha na ahwa nggu anggɔm nu itɛnamɛn, <verse eid="ACT 2:46"/><verse number="47" style="v" sid="ACT 2:47"/>akpoi Unum na awe ru izama ra anera kishoo. Ubɛn unuma Uteijee anu itomuwe umbɔ abika afɔrh.<verse eid="ACT 2:47"/></para>
  <chapter eid="ACT 2"/>
  <chapter number="3" style="c" sid="ACT 3"/>
  <para style="s1">Akerhuwe ukatarhu nú angwĩ ufɔm Iya-Num</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1"/>Unuma nukpɔ Ubitru nu Uyohana azɛ̃rhã azĩ ri Iya-Num ri ivang ifɛn-Num ra akara ataar ra atenuma. <verse eid="ACT 3:1"/><verse number="2" style="v" sid="ACT 3:2"/>Icɛ unera nuwɔ amar unga akatarhu, ubɛn unuma umbɔ asaka ashupa unga azĩ adene ru angwĩ ufɔm Iya-Num umbɔ iki iyisa agɛ, &lt;&lt;Angwĩ Ufɔm Aka aze,&gt;&gt; nu unga afɛn uhwɛk ru abika azĩ ru ufɔm Iya-Num. <verse eid="ACT 3:2"/><verse number="3" style="v" sid="ACT 3:3"/>Unga aka anyã Ubitru nu Uyohana aka awuri itsitsĩ, unga afɛnu uhwɛk ru umbɔ. <verse eid="ACT 3:3"/><verse number="4" style="v" sid="ACT 3:4"/>Umbɔ Ubitru nggu Uyohana aka atsu asumbɔ arhi unga, mɔcɛ Ubitru agɔr unga agɛ, &lt;&lt;Urhi umɛn!&gt;&gt; <verse eid="ACT 3:4"/><verse number="5" style="v" sid="ACT 3:5"/>Nggee amɛn ukatarhu ha azĩke udikambɔ, akaifɛrhkɔ iyɛi ubin ru umbɔ.<verse eid="ACT 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 3:6"/>Bɔr Ubitru agɛ, &lt;&lt;Umum ishimum ru uhwɛk, bɔr ubinkpi umum iki iwurakpɔ ukpɔ umum iki ĩdzaa ungo. Ri itsok Uyesu Ukiristo uwu Unazarat usisok, uzɛ̃rhuzɛ̃rhã.&gt;&gt; <verse eid="ACT 3:6"/><verse number="7" style="v" sid="ACT 3:7"/>Akũ ubok akpɔm ubok ughanga abera unga, kanying adaknga ri ikpor adaknga awu akeketake. <verse eid="ACT 3:7"/><verse number="8" style="v" sid="ACT 3:8"/>Unga ater isha! Asok adɛ̃ɛ̃, na atirhi uzɛ̃rhã atsĩ ru ufɔm Iya-Num nggu umbɔ, azɛ̃rhã na atengasha na akpoi Unum ikɛi. <verse eid="ACT 3:8"/><verse number="9" style="v" sid="ACT 3:9"/>Ivangyɛ kishoo anera aka anyã unga aka azɛ̃rhã na akpoi Unum, <verse eid="ACT 3:9"/><verse number="10" style="v" sid="ACT 3:10"/>umbɔ ikɛi ahwɛngmbɔ ugɛ awu unga anu isei ru Angwĩ Ufɔm Iya-Num Aka Aze. Umbɔ adzeidzeu akarhãrhã nggu ubinkpi uku ikorhe nggu unga.<verse eid="ACT 3:10"/></para>
  <para style="s1">Isarhe Ubitru ra angwĩ iya Usorhomon</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11"/>Ukatarhu ha aka akpɔm abokmbɔ Ubitru nu Uyohana, mɔcɛ anera kishoo adzeidzeu na atĩ abambɔ ru umbɔ ru anangkɛ umbɔ iki iyisa agɛ angwĩ iya Usorhomon. <verse eid="ACT 3:11"/><verse number="12" style="v" sid="ACT 3:12"/>Ubitru aka anyã rimi, unga agɔr umbɔ agɛ, &lt;&lt;Umbi aner Uisrairha, awu use utsu akɛrɛ atsu umbi adzeidzeu? Awu use utsu ikɛi umbi arhi umɛn ugɛɛ awu ijeemɛn use awu idɔsu Unummɛn itsu ukatarhu ha azɛ̃rhũ uzɛ̃rhã? <verse eid="ACT 3:12"/><verse number="13" style="v" sid="ACT 3:13"/>Unum uwu Uibrahim, Uishaku nu Uyakubu, Unum uwu atokamɛn, unga akpoi ugãrhãnga Uyesu, uwu ha umbi aka adzowe unga umbɔ afɛre, ikɛi umbi aka akpɛ̃mbi unga ra asu Ubirhatu, nggayɛ unga abee itsuwe unga. <verse eid="ACT 3:13"/><verse number="14" style="v" sid="ACT 3:14"/>Umbi akpɛ̃mbi Usarkasar ha Uner Uwuku Arhurhika, na afɛna umbɔ atsũwã umbi uner uwuku ufɛr aner. <verse eid="ACT 3:14"/><verse number="15" style="v" sid="ACT 3:15"/>Umbi afɛre uner uwuku udzowe urhɛ, bɔr Unum azituka unga ra akpe. Umɛn iwu ideka ra akɛrɛ ha. <verse eid="ACT 3:15"/><verse number="16" style="v" sid="ACT 3:16"/>Awu imangmang ru itsok Uyesu, ngge itsu utsak uwurɛ umbi aka ahwɛng na anyã awu akerketawɔ. Awu itsok Uyesu nu imangmangyɛ iki iba ru unga, ngge idzowe utsak uwurɛ ikikerhe, umbi kishoo aka anyãmbi.<verse eid="ACT 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17"/>&lt;&lt;Umbi abimɛn, umum ihwɛng awu ida ihwihwɛng itsu umbi akorhe rimi, ru nyaka anggbaashimbi. <verse eid="ACT 3:17"/><verse number="18" style="v" sid="ACT 3:18"/>Bɔr awu akɛrɛ ha Unum aka atsu ake atsuafɛr ra arherhakɛ unga aka arherhe ra angwĩ abika asɔm Arherhu-Num kishoo, agɛ Ukiristo awuri ihwa uver. <verse eid="ACT 3:18"/><verse number="19" style="v" sid="ACT 3:19"/>Nggee àka adzipa ra arhimmbi, na adɔsu Unum, nggee itsú umbɔ asorhe arhimmbi, <verse eid="ACT 3:19"/><verse number="20" style="v" sid="ACT 3:20"/>nu unga ama adene Ukiristo ha, uwuruwi unga aka asɛng unga awu uwu umbi, Uyesu ififɔrhmbi. <verse eid="ACT 3:20"/><verse number="21" style="v" sid="ACT 3:21"/>Awu ufang unga asei ra afã utsɛku ivangyɛ Unum aka ifaruwe abina kishoo, ru nyaka unga aka abemuwe ishaisha ra angwĩ asarkasar abika asɔm Arherhu-Num. <verse eid="ACT 3:21"/><verse number="22" style="v" sid="ACT 3:22"/>Ubinkutsu Umusa agɔr agɛ, &lt;Uteijee Unummbi awuri iberuwanga umbi uner uwuku usɔm Arherhu-Num uwɔɔ ra abimbi, ru nyaka umum, awu ufang umbi aka igũ ubinkpi unga aka awuri idɛyiwa umbi kishoo. <verse eid="ACT 3:22"/><verse number="23" style="v" sid="ACT 3:23"/>Ubɛn unerwi aka asi ikpea ato ru uner uwuku usɔm Arherhu-Num hã, awuri itsũwũkumbɔ unga ra anernga.&gt;<note caller="+" style="f"><char style="fr" closed="false">3.23 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="DEU 18:15">Iva 18.15</ref>,<ref loc="DEU 18:18">18</ref>,<ref loc="DEU 18:19">19</ref></char>.</note><verse eid="ACT 3:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 3:24"/>&lt;&lt;Idzidzɛrhe, kishoo abika asɔm Arherhu-Num, udzur ru Usamairha uba ra asu, kishoo arherhambɔ arherhe aki inum iyɛrɛ. <verse eid="ACT 3:24"/><verse number="25" style="v" sid="ACT 3:25"/>Umbi awu abika agha ukam abika asɔm Arherhu-Num, nu ukam ibibemuwe-Num ra atokambi. Unga aka agɔr Uibrahim agɛ, &lt;Ru unangngo anera kishoo ru upfung awuri ikpo idorh.&gt;<note caller="+" style="f"><char style="fr" closed="false">3.25 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="GEN 22:18">Ing 22.18</ref>; <ref loc="GEN 26:4">26.4</ref></char>.</note> <verse eid="ACT 3:25"/><verse number="26" style="v" sid="ACT 3:26"/>Unum aka aberuwe ugãrhãnga, unga agbaashia adene unga aba ru umbi, ru umbi akpo idorh ri idzipuwe ubɛn unera ru umbi ru utsĩndĩ uwuku ubewanga.&gt;&gt;<verse eid="ACT 3:26"/></para>
  <chapter eid="ACT 3"/>
  <chapter number="4" style="c" sid="ACT 4"/>
  <para style="s1">Ubitru nggu Uyohana ra asu <optbreak/> abi udzepurhe</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1"/>Ivangyɛ umbɔ Ubitru nggu Uyohana aka adɛ̃ɛ̃ arherhe nggu anera, abika adzowe idɛm-Num nu anggbaashi abi idzɛu Iya-Num nu abi Usaduki aba ru umbɔ. <verse eid="ACT 4:1"/><verse number="2" style="v" sid="ACT 4:2"/>Umbɔ agũ avɔm, ubinkutsu abi itser Uyesu anu imesuwe anera ugɛ ikom iwuri isongge nggu urhɛ ru nyaku Uyesu aka asok ra akpe. <verse eid="ACT 4:2"/><verse number="3" style="v" sid="ACT 4:3"/>Umbɔ adzur umbɔ Ubitru nu Uyohana agbange utsɛku ukpe unum uvaa, ubinkutsu urhɛɛ uku uwekpɔ. <verse eid="ACT 4:3"/><verse number="4" style="v" sid="ACT 4:4"/>Bɔr anera arhɛrhɛ abika agũ isarhe ha awe ru imangmang, nu irhɛɛ abika adɔsa iyongge anaka agɔnga atɔ̃ɔ̃.<verse eid="ACT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5"/>Unum uvaa, ayɛrhe nu akakũ nu abika amesuwe ikpem umbɔ akɔng ru Urusharhima. <verse eid="ACT 4:5"/><verse number="6" style="v" sid="ACT 4:6"/>Uhanana Ukugɔng Uwuku Udzowe Idɛm-Num awu umɔ, nggu Ukayafa, nu Uyohana, nu Uarhekzanda, nu ikɛi kishoo abirabɛ aka awu ru ubã abika adzowe idɛm-Num. <verse eid="ACT 4:6"/><verse number="7" style="v" sid="ACT 4:7"/>Atsu umbɔ akũ Ubitru nu Uyohana aba adɛ̃ɛ̃ ra ateumbɔ, na atirhi irhusa umbɔ agɛ, &lt;&lt;Umbi akũ ijee iyikisong use itsok iyikisong akũ akorha akɛrɛ ha?&gt;&gt;<verse eid="ACT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 4:8"/>Mɔcɛ Ubitru, awu nggu Ipfu Isarsatangge, unga agɔr umbɔ agɛ, &lt;&lt;Umbi ayɛrhe nu akakũ anera! <verse eid="ACT 4:8"/><verse number="9" style="v" sid="ACT 4:9"/>Umbi ayisa umɛn irherɛ, arhusa umɛn icicorhayɛ umbɔ aka akerhuwe ukatarhu uwurɛ, umbi abee ihwɛng ubinkpi uku ukerhuwe unga? <verse eid="ACT 4:9"/><verse number="10" style="v" sid="ACT 4:10"/>Umɛn ibee umbi nu abi Uisrairha kishoo ahwɛng ugɛ, awu ri itsok Uyesu Ukiristo uwu Unazarat, uwuruwi umbi aka afɛre unga ri inyapuwe unga nu igãrhãmau ucicii, uwuruwi Unum aka asoyiwe ra akpe, atsu utsak uwirɛ akerhe adɛ̃ɛ̃ akerketawɔ ra asumbi. <verse eid="ACT 4:10"/><verse number="11" style="v" sid="ACT 4:11"/>Uyesu ha unga awu</para>
  <para style="q1" vid="ACT 4:11">&lt;&lt; &lt;Utarhkpi umbi abi idzin aka akpɛ̃,</para>
  <para style="q2" vid="ACT 4:11">ukpɔ uwu utarh angboki idzin.&gt;<note caller="+" style="f"><char style="fr" closed="false">4.11 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="PSA 118:22">Amb 118.22</ref></char>.</note><verse eid="ACT 4:11"/></para>
  <para style="m">
    <verse number="12" style="v" sid="ACT 4:12"/>Asi íkpombɔ ififɔrh ru uner uwɔɔ, asi idzowukumbɔ itsok ikɔɔ ru upfung umɛn iki ikpo ififɔrh ri ike.&gt;&gt;<verse eid="ACT 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13"/>Ivangyɛ ateiya aka anyã ikeramɛn Ubitru nu Uyohana, umbɔ ahwɛngmbɔ ugɛ umbɔ asi itsĩmbɔ imesa, umbɔ adzeidzeu, na adiki ihwɛng agɛ umbɔ awu nggu Uyesu. <verse eid="ACT 4:13"/><verse number="14" style="v" sid="ACT 4:14"/>Bɔr umbɔ aka anyã utsa uwuku ukerhe ha adɛ̃ɛ̃ nggu umbɔ, umbɔ asi ikpombɔ ubinkpi umbɔ aka irherhe. <verse eid="ACT 4:14"/><verse number="15" style="v" sid="ACT 4:15"/>Nggee umbɔ atsu umbɔ adzembɔ ru udzepurhe ha, na akɛki itsũwã nggu adɔka. <verse eid="ACT 4:15"/><verse number="16" style="v" sid="ACT 4:16"/>Umbɔ arhusa agɛ, &lt;&lt;Umɛn ikorhi uguse nggu anera abɛrɛ? Ubinkutsu anera ru Urusharhima aka ahwɛngmbɔ ugɛ aka akorhumbɔ nggaa abin idzeu ru abok anera abɛrɛ, umɛn isi ídɛ̃ɛ̃ itsɛyimɛn. <verse eid="ACT 4:16"/><verse number="17" style="v" sid="ACT 4:17"/>Bɔr utsur arherhe ha atsĩ amaake ra anera, umɛn igbiite atombɔ utsur umbɔ abvui arherhumbɔ arherhe nggu anera ri itsok ha.&gt;&gt;<verse eid="ACT 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 4:18"/>Mɔcɛ umbɔ ayisa abi itser Uyesu ha atsu umbɔ niba abvui arherhumbɔ arherhe, use imesa ri itsok Uyesu. <verse eid="ACT 4:18"/><verse number="19" style="v" sid="ACT 4:19"/>Bɔr Ubitru nu Uyohana adzipa agɛ, &lt;&lt;Àka avarhe nibikambi irhikungge ra anang Unum umɛn ĩdɔsa arherhambi ni ineke ĩdɔsa Arherhu-Num? <verse eid="ACT 4:19"/><verse number="20" style="v" sid="ACT 4:20"/>Ubinkutsu, umɛn isi ídɛ̃ɛ̃ inekukumɛn irherhe ubinkpi umɛn iki igũ ni inyã ikɛi.&gt;&gt;<verse eid="ACT 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 4:21"/>Umbɔ aka atoma aziya umbɔ, umbɔ atsũwe umbɔ azĩmbɔ. Asi ikpombɔ ubinkpi umbɔ aka ikorhe na adzowe umbɔ uver, ubinkutsu anera kishoo akpoi Unum ru ubinkpi uku ukorhe. <verse eid="ACT 4:21"/><verse number="22" style="v" sid="ACT 4:22"/>Utsa ukatarhu uwuku ukpo idzeu ikikerhe ha, imɛknga iki inangngge isɔka inaa.<verse eid="ACT 4:22"/></para>
  <para style="s1">Ifɛn-Num abika adɔsa</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23"/>Ivangyɛ umbɔ aka atsũwe umbɔ Ubitru nu Uyohana azĩmbɔ ra abimbɔ, umbɔ asɔme kishoo abinkɛ ateiya abika adzowe idɛm-Num nu akakũ aka adɛyiwe umbɔ. <verse eid="ACT 4:23"/><verse number="24" style="v" sid="ACT 4:24"/>Ivangyɛ umbɔ aka agũ rimi, umbɔ atsarhi irhakmbɔ ri ifɛn-Num nggu amɛn unying agɛ, &lt;&lt;A Uteijee uner ijee kishoo, ungo umuna afã nggu abĩ nu akau akagɔng, nu abina kishoo aka awe ra ake. <verse eid="ACT 4:24"/><verse number="25" style="v" sid="ACT 4:25"/>Arherhango ri Ipfu Isarsatangge, ungo uku urherhe ra angwĩ ugãrhãngo, utokamɛn Udauda ugɛ,</para>
  <para style="q1" vid="ACT 4:25">&lt;&lt; &lt;Awu use utsu abĩã kishoo agũ uvɔm</para>
  <para style="q2" vid="ACT 4:25">nu anera akaifɛrhkɔ iyiki itãrhã?<verse eid="ACT 4:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 4:26"/>Ayɛrhe ru upfung agbopa atsimbɔ abee iwa,</para>
  <para style="q2" vid="ACT 4:26">nu anggbaashi abĩã akɔng ananga unying</para>
  <para style="q1" vid="ACT 4:26">awe ru igamtsa nggu Uteijee,</para>
  <para style="q2" vid="ACT 4:26">nu ikɛi Ukiristonga.&gt;<note caller="+" style="f"><char style="fr" closed="false">4.26 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="PSA 2:1">Amb 2.1</ref>,<ref loc="PSA 2:2">2</ref></char>.</note><verse eid="ACT 4:26"/></para>
  <para style="m">
    <verse number="27" style="v" sid="ACT 4:27"/>Awu idzidzɛrhe, uyɛrhe Uhiridu nu Ubuntu Ubirhatu agbopumbɔ itsi nggu atsen abi Uyahuda nu aner Uisrairha ru uteu ukpirɛ. Awembɔ ri ikpikpɛ̃ɛ̃ nggu ugãrhãngo Uyesu usarkasar, uwuruwi ungo uku usɛng unga awu Ukiristo. <verse eid="ACT 4:27"/><verse number="28" style="v" sid="ACT 4:28"/>Umbɔ akorhe abinkɛ kishoo ijeengo nu ibibemango iki itsu ishaisha ugɛ ngge ikorhe. <verse eid="ACT 4:28"/><verse number="29" style="v" sid="ACT 4:29"/>A Uteijee, ungo ugũo iziziyambɔ ra atsimɛn nu uma uyike agãrhãngo nggu ikeramɛn irherha arherhango. <verse eid="ACT 4:29"/><verse number="30" style="v" sid="ACT 4:30"/>Uberu ubokngo ukpuku ukerhe ikɛi ukorhu nggaa abin idzeu nu igbigba ri itsok ugãrhãngo Uyesu usarkasar.&gt;&gt;<verse eid="ACT 4:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31"/>Umbɔ aka afɛn-Num amaa, anangkɛ umbɔ aka akɔng adiki izizusa. Mɔcɛ atsuke umbɔ kishoo Ipfu Isarsatangge, umbɔ adɛ̃ɛ̃mbɔ irherha Arherhu-Num nggu ikeramɛn.<verse eid="ACT 4:31"/></para>
  <para style="s1">Abika adɔsa agasha abinmbɔ <optbreak/> nggu adɔka</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32"/>Mɔcɛ kishoo abika adɔsa amɛnmbɔ awu unying. Ubɛn unera asi iwea ru ubin ukamnga, bɔr umbɔ agasha abinkɛ umbɔ aka awurake nggu adɔka. <verse eid="ACT 4:32"/><verse number="33" style="v" sid="ACT 4:33"/>Nggu ijee nggaa abi itser Uyesu aka adɛ̃ɛ̃ arherhe isisok Uteijee Uyesu ra akpe, nu imimuta irhɛirhɛ iki iwu ru umbɔ kishoo. <verse eid="ACT 4:33"/><verse number="34" style="v" sid="ACT 4:34"/>Unera asi ibee ubin adaka ru umbɔ. Ubinkutsu abi icang irham nu abi aya agoyiwe ake na akũ uhwɛka <verse eid="ACT 4:34"/><verse number="35" style="v" sid="ACT 4:35"/>aba adzowe ra abi itser Uyesu, umbɔ agashuwe anera ri itsũwãmbɔ.<verse eid="ACT 4:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36"/>Rimi hã uner itsok Uyusuf aka akorhe awu unang Urhawi, adzeku Usayifuru, uwuruwi abi itser Uyesu iki iyisa unga Ubarnaba, agbena agburh &lt;&lt;Uner uwuku Ufituwe.&gt;&gt; <verse eid="ACT 4:36"/><verse number="37" style="v" sid="ACT 4:37"/>Unga aka agoshe icangnga iyɔɔ, unga akũ uhwɛka aba adzowe abi itser Uyesu.<verse eid="ACT 4:37"/></para>
  <chapter eid="ACT 4"/>
  <chapter number="5" style="c" sid="ACT 5"/>
  <para style="s1">Uhananiya nu Usafiratu</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1"/>Unera nuwɔ itsoka igburh Uhananiya, nggu utsɛ̃nga Usafiratu, agoshe icang irhammbɔ iyɔɔ. <verse eid="ACT 5:1"/><verse number="2" style="v" sid="ACT 5:2"/>Nggu ihwihwɛng utsɛ̃nga, unga atsũ uhwɛka angwɛ̃ ukpunga na akũ ukpuku ubɔr aba angwɛ̃we ra adak abi itser Uyesu.<verse eid="ACT 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 5:3"/>Mɔcɛ Ubitru agɛ, &lt;&lt;A Uhananiya, awu use utsu ungo uneke Ushaitan atsĩ ra amɛnngo? Ungo ugbɛrangwĩ utsuke Ipfu Isarsatangge, ungo ikɛi utsũɔ̃ ubin ukpɔɔ ru uhwɛk icanga? <verse eid="ACT 5:3"/><verse number="4" style="v" sid="ACT 5:4"/>Isi iwengge iyingo ungo udɔrhu ugoshe? Ungo uku ugoshe ikɛi, uhwɛka usi iwekpɔ ri ijeengo? Awu use utsu ungo ukaifɛrhkɔ iyiki ikorhu ubin hã? Ungo usi igbɛrangwĩ utsukukɔ unera, ungo ugbɛr utsuke Unum.&gt;&gt;<verse eid="ACT 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 5:5"/>Ivangyɛ Uhananiya aka agũ rimi, unga agba nu abĩ akpea. Nggaa iwei ifɛr anera kishoo aka agũ ubinkpi uku ukorhe. <verse eid="ACT 5:5"/><verse number="6" style="v" sid="ACT 5:6"/>Mɔcɛ awɛdzɛm aba, akũ atorho abvur ukom iyornga, na akũna unga adzek adzake.<verse eid="ACT 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7"/>Aka ayoka akara ataar nu utsɛ̃nga atsĩwã, asi ihwɛngnga ubinkpi uku ukorhe. <verse eid="ACT 5:7"/><verse number="8" style="v" sid="ACT 5:8"/>Ubitru arhusa unga agɛ, &lt;&lt;Udɛyiwa umum, awu uhwɛk ha nukpi kishoo umbi aka agoshe icang hã?&gt;&gt;</para>
  <para style="p" vid="ACT 5:8">Unga agɛ, &lt;&lt;Ĩĩ, uhwɛk ngge niyɔ.&gt;&gt;<verse eid="ACT 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9"/>Ubitru agɔr unga agɛ, &lt;&lt;Awu use utsu umbi agbopa atsimbi na aviri Ipfu Uteijee? Unyã! Adak abika adzake utsakngo akɔ ra angwĩ ubã, umbɔ awuri itsã ungo adzek ikɛi.&gt;&gt;<verse eid="ACT 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 5:10"/>Kanying unga agba nu adak Ubitru akpea. Mɔcɛ awɛdzɛm aka atsĩwã aba anyã unga aka akpea, umbɔ ashupa unga adzek azĩ adzak akhapuwe ru udzak utsaknga. <verse eid="ACT 5:10"/><verse number="11" style="v" sid="ACT 5:11"/>Nggaa iwei akarhãrhã ifɛr kishoo abika adɔsa nu kishoo abika agũ ifɛrha ha.<verse eid="ACT 5:11"/></para>
  <para style="s1">Abi itser Uyesu akerhuwe anera</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12"/>Abi itser Uyesu akorhuwe abin idzeu nu abin igbigba ra anera arhɛrhɛ. Nu abi imangmang kishoo aki isaka akɔng ra Angwĩ Iya Usorhomon. <verse eid="ACT 5:12"/><verse number="13" style="v" sid="ACT 5:13"/>Bɔr uner uwɔɔ asi itsĩ atomunga ru umbɔ, kishoo rimi hã anera ana adzowe umbɔ imor. <verse eid="ACT 5:13"/><verse number="14" style="v" sid="ACT 5:14"/>Irhɛ akatsak nu akatsɛrh abika awe ru imangmang ru Uteijee ikpurhi idɛ̃ɛ̃ ititoma ri irhɛmbɔ. <verse eid="ACT 5:14"/><verse number="15" style="v" sid="ACT 5:15"/>Ubinkpi abi itser Uyesu aka akorhe utsu anera akũ abi irhãrhã adzeka ra atsĩndĩ, abɛta umbɔ nu atakarha nu afarmbɔ, ugɛ Ubitru aba atɔnga, usakanga uma utɔng nu abɔɔ. <verse eid="ACT 5:15"/><verse number="16" style="v" sid="ACT 5:16"/>Anera arhɛrhɛ aka adzeyi ri iteu iyiki ikhapa ru Urusharhima, akɔng akũ abi irhãrhã aba nu abirabɛ ípfu iyiki ibewe iki idzowe umbɔ uver, nu kishoo akerhumbɔ.<verse eid="ACT 5:16"/></para>
  <para style="s1">Adzowe abi itser Uyesu uver</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17"/>Ukugɔng Uwuku Udzowe Idɛm-Num nu kishoo abirabɛ aka awu nggu unga, awu abi ukpui Usaduki, agũ unyɛ̃ɛ̃ abi itser Uyesu akarhãrhã. <verse eid="ACT 5:17"/><verse number="18" style="v" sid="ACT 5:18"/>Ngge itsu umbɔ asok adzur abi itser Uyesu atsuke umbɔ ru ugborzĩ. <verse eid="ACT 5:18"/><verse number="19" style="v" sid="ACT 5:19"/>Bɔr ru untsuuka ipfu itser Uteijee itsuruwe angwĩ ubã ugborzĩ hã ikũna umbɔ idzekngge. Igɔr umbɔ igɛ, <verse eid="ACT 5:19"/><verse number="20" style="v" sid="ACT 5:20"/>&lt;&lt;Àka azĩ adɛ̃ɛ̃ ru ufɔm Iya-Num na adɛyiwe anera undzuma arherhe akɛrɛ aki urhɛ uwuku ufa.&gt;&gt;<verse eid="ACT 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 5:21"/>Ukpekpeka, umbɔ atsĩ ru ufɔm Iya-Num, ru nyaka ngge iki idɛyiwe umbɔ, umbɔ atirhi imesuwe anera.</para>
  <para style="p" vid="ACT 5:21">Mɔcɛ Ukugɔng Uwuku Udzowe Idɛm-Num nu abirabɛ aka awu nggu unga aka aba atsĩ, umbɔ akɔng abi udzepurhe, aka awu akakũ Uisrairha kishoo, na adene itser ugɛ akũ abi itser Uyesu ha ru ugborzĩ hã aba. <verse eid="ACT 5:21"/><verse number="22" style="v" sid="ACT 5:22"/>Bɔr abi idzɛu Iya-Num azĩ atsĩ ru ugborzĩ hã, abeea umbɔ, umbɔ ashimbɔ umɔ, umbɔ azĩ asɔme umbɔ <verse eid="ACT 5:22"/><verse number="23" style="v" sid="ACT 5:23"/>agɛ, &lt;&lt;Umɛn inyã ugborzĩ ugbang uku kpengkpeng, abi idzɛu ikɛi adɛ̃ɛ̃ adzɛu angwĩ ubã, bɔr umɛn iki itsuri, umɛn isi inyãmɛn unera ru ugborzĩ hã.&gt;&gt; <verse eid="ACT 5:23"/><verse number="24" style="v" sid="ACT 5:24"/>Anggbaashi abi idzɛu Iya-Num nu ateiya abika adzowe idɛm-Num aka agũ rimi, amɛnmbɔ aghong akarhãrhã, akaifɛrhkɔ ubinkpi uku ikorhe ri ifɛrhɛ iyɛrɛ ha.<verse eid="ACT 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 5:25"/>Mɔcɛ utsa uwɔɔ aba agɔr umbɔ agɛ, &lt;&lt;Àka anyã! Abi ha abɛ umbi aka atsuku ugborzĩ adɛ̃ɛ̃ ru ufɔm Iya-Num, anu imesuwe anera.&gt;&gt; <verse eid="ACT 5:25"/><verse number="26" style="v" sid="ACT 5:26"/>Mɔcɛ unggbaashi abi idzɛu Iya-Num nggu abi idzɛu ha azĩ akũ abi itser Uyesu aba, bɔr asi ikũmbɔ ri inggang. Anggbaashi ha anu igũ iwei anera utsur umbɔ atang umbɔ atarh.<verse eid="ACT 5:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 5:27"/>Umbɔ aka akũ abi itser Uyesu aba, atsu umbɔ adɛ̃ɛ̃ ra asu abi itser udzepurhe, mɔcɛ Ukugɔng Uwuku Udzowe Idɛm-Num anu irhusa umbɔ. <verse eid="ACT 5:27"/><verse number="28" style="v" sid="ACT 5:28"/>Agɛ, &lt;&lt;Umɛn ivangamɛn umbi akarhãrhã igɛ umbi niba abvui amesukumbi anera ri itsok ikɛrɛ ha. Bɔr nggayɛ umbi aka amaakumbi Urusharhima kishoo nggu imesambi ikɛi umbi abee itsuka umɛn uvau adzirh utsa ha!&gt;&gt;<verse eid="ACT 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 5:29"/>Bɔr Ubitru nu abi itser Uyesu abɔɔ agɛ, &lt;&lt;Awu ufang umɛn iki idɔsa arherhu Unum inangmɛn arherhe anera! <verse eid="ACT 5:29"/><verse number="30" style="v" sid="ACT 5:30"/>Unum uwu atokamɛn unga asoyiwe Uyesu ra akpe, uwuruwi umbi aka afɛre ri inyapuwe unga ni igãrhãmau ucucii. <verse eid="ACT 5:30"/><verse number="31" style="v" sid="ACT 5:31"/>Unum aka aberuwe unga, atsu unga asei ru ubok ughanga, awu unggbaashi na awu Uner Uwuku Ufɔrh ikɛi na atsuruwe Uisrairha utsĩndĩ idzidzipambɔ ikɛi akpo itsũwe arhim. <verse eid="ACT 5:31"/><verse number="32" style="v" sid="ACT 5:32"/>Umɛn iwu ideka ri ifɛrha iyɛrɛ ha, iwu rimi ikɛi Ipfu Isarsatangge, iyiriyɛ Unum aka adzowe abika adɔsa unga.&gt;&gt;<verse eid="ACT 5:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33"/>Ivangyɛ umbɔ aka agũ rimi, umbɔ agũ avɔm akarhãrhã na abee ifɛre umbɔ. <verse eid="ACT 5:33"/><verse number="34" style="v" sid="ACT 5:34"/>Bɔr utsa Ufarisi uwɔɔ itsoka igburh Ugamarhiyerh, uwuku umesuwe Íkpem Umusa, uwuruwi anera kishoo aki asaka adzowe unga imor, asok adɛ̃ɛ̃ ru udzepurhea, atsu umbɔ akũ abi itser Uyesu adzeka awiya kata. <verse eid="ACT 5:34"/><verse number="35" style="v" sid="ACT 5:35"/>Mɔcɛ unga agɔr abi udzepurhe ha agɛ, &lt;&lt;Umbi abimɛn Uisrairha àka angwɛ̃dzɛn na arhi anyã ubinkpi umbi aka abee ikorhuwe anera abɛrɛ. <verse eid="ACT 5:35"/><verse number="36" style="v" sid="ACT 5:36"/>Ivanga niyɔ isha uner uwɔɔ aka adzeka, itsoka igburh Utuda, anyangi itsinga awu ubin ukpɔɔ. Anera ayombɔ anaka anaa aki idɔsa unga, bɔr afɛrkumbɔ unga, na asitukumbɔ abika adɔsa unga, ake awu imimashambɔ. <verse eid="ACT 5:36"/><verse number="37" style="v" sid="ACT 5:37"/>Akɛrɛ ha aka amaa ikɛi, uwɔɔ itsoka igburh Uyahuda utsa Ugarhirhi adzeka ri ivangyɛ umbɔ aka adɛ̃ɛ̃ ivarhe irhɛ anera atsu anera adɔsa unga umbɔ awe ru igamtsa nggu agomnati. Unga ikɛi afɛrkumbɔ unga, abika adɔsa unga kishoo asitumbɔ. <verse eid="ACT 5:37"/><verse number="38" style="v" sid="ACT 5:38"/>Nggee, umum idzaa umbi itsũwã, àka adzembi ru utsĩndĩ anera abɛrɛ, àka neke umbɔ azĩmbɔ! Ubinkutsu ibibemambɔ use itsermbɔ iba iwu iyi anera, iwuri isitungge. <verse eid="ACT 5:38"/><verse number="39" style="v" sid="ACT 5:39"/>Bɔr itsermbɔ ha iba idzeku Unum, umbi asi ídɛ̃ɛ̃ akɛnmbi umbɔ, utsur umbi awembi ri ifuw nggu Unum.&gt;&gt; Nggee umbɔ ayɛimbɔ itsũwã Ugamarhiyerh.<verse eid="ACT 5:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 5:40"/>Umbɔ ayisa abi itser Uyesu ha, atsu umbɔ akwɛre umbɔ ugwɛɛ. Na avange atombɔ utsur umbɔ arherhumbɔ arherhe ri itsok Uyesu, na atsũwe umbɔ azĩmbɔ.<verse eid="ACT 5:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="ACT 5:41"/>Abi itser Uyesu ha asok azĩmbɔ agɔm akarhãrhã agɛ Unum anyã umbɔ amɛ̃ɛ̃mbɔ ihwa uver nu atsa ri itsok Uyesu. <verse eid="ACT 5:41"/><verse number="42" style="v" sid="ACT 5:42"/>Ubɛn unuma, umbɔ asi inekukumbɔ imesuwe anera ri idzowe Isarhe Iyiki Ize ri Iya-Num nu aya ugɛ Uyesu unga awu Ukiristo.<verse eid="ACT 5:42"/></para>
  <chapter eid="ACT 5"/>
  <chapter number="6" style="c" sid="ACT 6"/>
  <para style="s1">Asɛng inera utɔɔva</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1"/>Ri inum hã angwɛ̃ imesa anu ititoma arhɛrhɛ, umɔ abi Uyahuda abika agũ idũ abi Uherhini atsĩmbɔ ibvun arherhe ri itsi abi Uyahuda abika agũ idũ abi Ibrani ubinkutsu abika agau ubingha ubɛn unuma anu irhi atsɛ̃rhãpfu abi idũ Uherhini uku ungwaan. <verse eid="ACT 6:1"/><verse number="2" style="v" sid="ACT 6:2"/>Nggee umbɔ usɔkdũmɛn hã ayisa anera kishoo angwɛ̃ imesa agɛ, &lt;&lt;Isi irhikungge umɛn ineke isarhe Arherhu-Num ni itsĩmɛn igashu ubingha. <verse eid="ACT 6:2"/><verse number="3" style="v" sid="ACT 6:3"/>Umbi angwɛ̃mɛn nu anapumɛn, àka asɛng inera utɔɔva ra abimbi abirabɛ umbɔ aka ahwɛng umbɔ awu nggu Ipfu-Num nu itsoi. Umɛn iki idzowe itser iyɛrɛ ru umbɔ, <verse eid="ACT 6:3"/><verse number="4" style="v" sid="ACT 6:4"/>nu umɛn itsu amɛnmɛn ri ifɛn-Num ni imesuwe Arherhu-Num.&gt;&gt;<verse eid="ACT 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5"/>Abika adɔsa kishoo agũibɛn ubinkpi umbɔ aka arherhe. Mɔcɛ umbɔ asɛng Uistifanu, uwuruwi aka awe ru imangmang akarhãrhã na awu nggu Ipfu Isarsatangge, nu Ufirhibu nu Uburokora nu Unikano, nu Utimon, nu Ubarmina, nu Unikorha aka adzeku Uantakiya, adzipa atsĩ agbeyi abi Uyahuda. <verse eid="ACT 6:5"/><verse number="6" style="v" sid="ACT 6:6"/>Umbɔ akũ anera abɛrɛ aba aden ra asu abi itser Uyesu, umbɔ aka afɛn-Num na atsoyiwe umbɔ abok.<verse eid="ACT 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7"/>Nggee Arherhu-Num atɛ̃rhã. Irhɛ angwɛ̃ imesa ru Urusharhima ikpurhi idɛ̃ɛ̃ itoma akarhãrhã, nu arhɛrhɛ abika adzowe idɛm-Num adɔsumbɔ imangmang hã.<verse eid="ACT 6:7"/></para>
  <para style="s1">Adzur Uistifanu</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8"/>Uistifanu, awu nggu imimuta nu ijee akarhãrhã, akorha abin akagɔng aki idzeu nu aki igbigba ra anera. <verse eid="ACT 6:8"/><verse number="9" style="v" sid="ACT 6:9"/>Bɔr abɔɔ abi ubã ifɛn-Num ukpɔɔ umbɔ iki iyisa agɛ Ubã Ifɛn-Num Abika Adzek Ukam, asoyimbɔ uning nggu Uistifanu. Abɛrɛ ha awu abi Uyahuda abika adzeku Usayirin nu Uarhekzandiriya, nu ikɛi abika adzeka abĩ Ukirhikiya, nu aki Uasiya. <verse eid="ACT 6:9"/><verse number="10" style="v" sid="ACT 6:10"/>Bɔr afɔr uning adambɔ nggu itsoi iyi Ipfu-Num iki idzowe unga arherhe.<verse eid="ACT 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 6:11"/>Mɔcɛ umbɔ aghɔ̃rhã agɔr anera abɔɔ ri iwɔk umbɔ agɛ, &lt;&lt;Umɛn igũ Uistifanu anu irhenu Umusa na arhenu Unum ikɛi.&gt;&gt;<verse eid="ACT 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 6:12"/>Nggee umbɔ asoyiwe amɛn anera nu akakũ nu abika amesuwe ikpem. Umbɔ asok adzur Uistifanu akũ azĩmbɔ ra asu abi udzepurhe. <verse eid="ACT 6:12"/><verse number="13" style="v" sid="ACT 6:13"/>Umbɔ akũ anera abi ideka igbɛrangwĩ aba, umbɔ agɔr agɛ, &lt;&lt;Utsak uwurɛ ubɛn unuma unga anu irherhi iyiki itãrhã ru usarkasar anang akɛrɛ nu Íkpem Umusa ikɛi. <verse eid="ACT 6:13"/><verse number="14" style="v" sid="ACT 6:14"/>Umɛn igũ unga agɔr agɛ Uyesu uner Unazarat ha awuri ibibupuwe anang akɛrɛ na afaruwe agbeyi Umusa aka abɔra umɛn.&gt;&gt;<verse eid="ACT 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 6:15"/>Kishoo abika asei ru udzepurhe ha awing asumbɔ arhi Uistifanu, anyã asunga awu ru nyaka aki ipfu itser-Num.<verse eid="ACT 6:15"/></para>
  <chapter eid="ACT 6"/>
  <chapter number="7" style="c" sid="ACT 7"/>
  <para style="s1">Arherhe Uistifanu ru udzepurhe</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1"/>Mɔcɛ Ukugɔng Uwuku Udzowe Idɛm-Num arhusu Uistifanu agɛ, &lt;&lt;Arherha akɛrɛ ha awu idzidzɛrhe?&gt;&gt;<verse eid="ACT 7:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 7:2"/>Uistifanu agɛ, &lt;&lt;Umbi angwɛ̃mɛn nu atesmɛn, àka akpeto ru umum! Unum uwuku ukpukpoi adzeka ru utokamɛn Uibrahim ri ivangyɛ unga aka awu ra abĩ Umesofotamiya, unga anasi iseisa ru Uharan. <verse eid="ACT 7:2"/><verse number="3" style="v" sid="ACT 7:3"/>Unum agɔr unga agɛ, &lt;Uso ra abĩmbi, ubɔre abimbi, uzĩ abĩkɛ umum iki idɛyiwa ungo.&gt;<note caller="+" style="f"><char style="fr" closed="false">7.3 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="GEN 12:1">Ing 12.1</ref></char>.</note><verse eid="ACT 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 7:4"/>&lt;&lt;Nggee unga asoka abĩ abi Ukarhdi, azĩ aseisa ru Uharan. Utɛnga aka akpe amaa, Unum adene unga aba ra abĩkɛ umbi aka asei umɔ icɛrɛ. <verse eid="ACT 7:4"/><verse number="5" style="v" sid="ACT 7:5"/>Unum asi idzowuka Uibrahim ukam abĩ hã, uko ider udaka unying. Bɔr Unum abemuka unga agɛ unga awuri itsu abĩ hã awu akinga nggu unangnga iki idɔsu undzingnga, nggayɛ Uibrahim ana ashia ru ungwɛ̃ ri ivang hã. <verse eid="ACT 7:5"/><verse number="6" style="v" sid="ACT 7:6"/>Unum arherhe nggu unga agɛ, &lt;Unangngo awuri iwemgbɔ atsen ra abĩ akase, abi abĩ hã awuri itsu umbɔ igãrhã, awuri idzowe umbɔ ayetnum imɛka inaka inaa. <verse eid="ACT 7:6"/><verse number="7" style="v" sid="ACT 7:7"/>Umum iwuri itsukukũ uver ra abĩ hã umbɔ aka iwu igãrhã. Akɛrɛ ha aka imaa ikɛi, unang Uibrahim awuri idze adzaa umum igɔng ra anang akɛrɛ.&gt;<note caller="+" style="f"><char style="fr" closed="false">7.7 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="GEN 15:13">Ing 15.13</ref>,<ref loc="GEN 15:14">14</ref></char>.</note> <verse eid="ACT 7:7"/><verse number="8" style="v" sid="ACT 7:8"/>Unum adzowe Uibrahim ibibemuwe utsar ukpu usorhe. Uibrahim aka amar Uishaku, unga asorhuwe unga ru unum ukpu utɔrɔk. Uishaku unga amar Uyakubu, Uyakubu amar atokamɛn usɔkdũmɛn.<verse eid="ACT 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9"/>&lt;&lt;Atokamɛn hã agũ unyɛ̃ɛ̃ ungwɛ̃mbɔ aka agburh Uyusuf, umbɔ agoshe unga azĩã igãrhã ru Umasar. Bɔr Unum awu nggu unga, <verse eid="ACT 7:9"/><verse number="10" style="v" sid="ACT 7:10"/>atsũwũka unga ri inyãyernga kishoo. Unum ikɛi atsu Uyusuf awu uner itsoi awe ru izama ra asu Ufir'auna uyɛrhe Umasar, nggee unga atsu unga awu ugomna Umasar ru udzepurhenga kishoo.<verse eid="ACT 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 7:11"/>&lt;&lt;Mɔcɛ imerh itsĩngge abĩ Umasar kishoo nu Ukan'ana, itoma nggu ayetnum akarhãrhã, itsu atokamɛn ashimbɔ ru ubingha. <verse eid="ACT 7:11"/><verse number="12" style="v" sid="ACT 7:12"/>Ivangyɛ Uyakubu aka agũ ugɛ ubingha uwekpɔ ru Umasar, unga adene atokamɛn azĩmbɔ Umasar uzɛ̃rhã ukpu inggbaashia. <verse eid="ACT 7:12"/><verse number="13" style="v" sid="ACT 7:13"/>Ru uzɛ̃rhãmbɔ ukpu uvaa Uyusuf adɛyiwe itsikamnga ru angwɛ̃mbɔ, mɔcɛ Ufir'auna ikɛi ahwɛng abi iyambɔ Uyusuf. <verse eid="ACT 7:13"/><verse number="14" style="v" sid="ACT 7:14"/>Akɛrɛ aka amaa Uyusuf atsu umbɔ ayisuwe utɛnga Uyakubu asok aba ru unga, nu kishoo abi iyambɔ, awu isɔka utɔɔva na atɔ̃ɔ̃. <verse eid="ACT 7:14"/><verse number="15" style="v" sid="ACT 7:15"/>Mɔcɛ Uyakubu azĩã Umasar. Ru nggɔɔ ha unga nggu atokamɛn aka akpe, <verse eid="ACT 7:15"/><verse number="16" style="v" sid="ACT 7:16"/>na akũ akom ayormbɔ azĩmbɔ Ushekem, adzake umbɔ ru udzak ukpu Uibrahim aka agoi nggu uhwɛk uazurhfa ru ubok awɛ Uhamor ru Ushekem.<verse eid="ACT 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17"/>&lt;&lt;Bɔr ivangyɛ iki itsuifɛr iyi ibibemuwe-Num ru Uibrahim iki iyok, anermɛn atɛ̃rhã akarhãrhã ra abĩ Umasar. <verse eid="ACT 7:17"/><verse number="18" style="v" sid="ACT 7:18"/>Mɔcɛ uyɛrhe uwɔɔ ru Umasar, uwuruwi aka asi ihwɛngnga Uyusuf agha iyɛrhe Umasar. <verse eid="ACT 7:18"/><verse number="19" style="v" sid="ACT 7:19"/>Unga agha urha unangmɛn na ayɔm atokamɛn na atsu umbɔ atãyĩwe irheng angwɛ̃mbɔ ngge ikpeyi.<verse eid="ACT 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 7:20"/>&lt;&lt;Ivang hã niyɔ umbɔ aka amar Umusa, unga awu uzeze ungwɛ̃. Anɛta unga afɛ̃ɛ̃ ataar ri iya utɛnga. <verse eid="ACT 7:20"/><verse number="21" style="v" sid="ACT 7:21"/>Umbɔ aka angwɛ̃we unga ra awiya, unapa Ufir'auna unga ashupa unga akpɔm ru nyaku ungwɛ̃nga. <verse eid="ACT 7:21"/><verse number="22" style="v" sid="ACT 7:22"/>Amesuwe Umusa ri kishoo itsoi abi Umasar na awe ru ijee ra arherhe nu ikikorhe.<verse eid="ACT 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23"/>&lt;&lt;Ivangyɛ Umusa aka atsĩ imɛka isɔka inaa, unga avarhe na asok azĩã iyepa angwɛ̃mbɔ abi Uisrairha. <verse eid="ACT 7:23"/><verse number="24" style="v" sid="ACT 7:24"/>Unga aka anyã utsa Umasar aka adɛ̃ɛ̃ iyɔm ungwɛ̃mbɔ, unga azĩ ayɛsuwe ungwɛ̃mbɔ afɛruka utsa Umasar ha. <verse eid="ACT 7:24"/><verse number="25" style="v" sid="ACT 7:25"/>Umusa akaifɛrhkɔ agɛ abimbɔ awuri ihwɛngmbɔ ugɛ Unum awuri ikũ unga akũ afɔrh umbɔ, bɔr umbɔ asi ihwɛngmbɔ. <verse eid="ACT 7:25"/><verse number="26" style="v" sid="ACT 7:26"/>Unum uvaa, Umusa aba anyã abi Uisrairha avaa aka adɛ̃ɛ̃ ifuw. Unga abee igbopa atsimbɔ akũwe umbɔ ididɔɔr, agɔr agɛ, &lt;Umbi anerabɛ, umbi awu angwɛ̃yi. Awu use utsu umbi ayɔm adɔka?&gt;<verse eid="ACT 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 7:27"/>&lt;&lt;Bɔr uwuku uyɔm undɔkanga hã ayiru Umusa adene ri ifɛna na agɛ, &lt;Ungaa atsu ungo uwu uyɛrhamɛn, nu uwuku utsu uvau ru umɛn? <verse eid="ACT 7:27"/><verse number="28" style="v" sid="ACT 7:28"/>Ungo ubee ifɛre umum ru nyaka ungo uku ufɛr utsa Umasar arhɛkɛ ha?&gt; <verse eid="ACT 7:28"/><verse number="29" style="v" sid="ACT 7:29"/>Ivangyɛ Umusa aka agũ rimi, unga atĩ azĩã Umidiyan, umɔ unga awea utsen ru nggɔɔ ha unga amar awɛkaci avaa akatsa.<verse eid="ACT 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30"/>&lt;&lt;Imɛka isɔka inaa iki itɔng, ipfu itser-Num idzeka ra asu Umusa ra arhum ri ikon urha iki igar ru ufum uku ukhapa ri Igũ Usinai. <verse eid="ACT 7:30"/><verse number="31" style="v" sid="ACT 7:31"/>Ivangyɛ Umusa aka anyã rimi, unga adzeidzeu umɔ. Unga aka agɔpa azĩ na agbisha arhi, unga agũ urhɛm Uteijee uku ugɔr ugɛ, <verse eid="ACT 7:31"/><verse number="32" style="v" sid="ACT 7:32"/>&lt;Awu umum Unum uwu atokango, Unum uwu Uibrahim, nu Uishaku nu Uyakubu.&gt;<note caller="+" style="f"><char style="fr" closed="false">7.32 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="EXO 3:6">Idzi 3.6</ref></char>.</note> Iyor Umusa izang unga afɔr irhi adaka.<verse eid="ACT 7:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 7:33"/>&lt;&lt;Mɔcɛ Uteijee agɔr unga agɛ, &lt;Utsũwe abadakngo, anangkɛ ungo uku udɛ̃ɛ̃ umɔ awu asarkasar abĩ. <verse eid="ACT 7:33"/><verse number="34" style="v" sid="ACT 7:34"/>Idzidzɛrhe, umum inyãmum ayetnum anermum ru Umasar. Umum iki igũmum akpembɔ, umum icipuwa iba ishɔɔte umbɔ. Icɛrɛ uba umum idena ungo ubvui uzĩ Umasar.&gt;<note caller="+" style="f"><char style="fr" closed="false">7.34 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="EXO 3:5">Idzi 3.5</ref>,<ref loc="EXO 3:7">7</ref>,<ref loc="EXO 3:8">8</ref>,<ref loc="EXO 3:10">10</ref></char>.</note><verse eid="ACT 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35"/>&lt;&lt;Awu Umusa ha nuwi umbɔ aka akpɛ̃ na agɛ, &lt;Ungaa atsuka ungo uwu uyɛrhamɛn nu uwu uwuku utsu uvau ru umɛn?&gt; Unga hã Unum aka adene unga awu unggbaashi na awu uwuku ufɔrh, ru ubok ipfu itser-Num hã iki idzeka ru unga ru ufum hã. <verse eid="ACT 7:35"/><verse number="36" style="v" sid="ACT 7:36"/>Unga akũna umbɔ adzeku Umasar na akorha abin idzeu nu abin igbigba ru Umasar, ru Ukau uku Ubãrhã nu ikɛi ra arhum imɛka isɔka inaa.<verse eid="ACT 7:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 7:37"/>&lt;&lt;Umusa ha unga agɔr abi Uisrairha agɛ, &lt;Unum awuri idzaanga umbi uner uwuku usɔm Arherhu-Num ra anermbi ru nyaka umum.&gt;<note caller="+" style="f"><char style="fr" closed="false">7.37 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="DEU 18:15">Iva 18.15</ref></char>.</note> <verse eid="ACT 7:37"/><verse number="38" style="v" sid="ACT 7:38"/>Unga awu nggu ikikɔng atokamɛn abi Uisrairha ra arhum, nggu ipfu itser-Num hã iki irherha arherhe nggu unga ni Igũ Usinai, nu nggu atokamɛn, na ayɛi arherhe urhɛ aka adzeku Unum akũ akũwã umɛn.<verse eid="ACT 7:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39"/>&lt;&lt;Bɔr atokamɛn akpɛ̃mbɔ idɔsa arherhanga hã. Akpɛ̃mbɔ unga, na agũ ikpona ibvui izĩ abĩ Umasar ra amɛnmbɔ. <verse eid="ACT 7:39"/><verse number="40" style="v" sid="ACT 7:40"/>Agɔr Uharuna agɛ, &lt;Ugbishuwa umɛn anum abirabɛ aka idarh umɛn. Umusa ha aka akũna umɛn adzeka ra abĩ Umasar, umɛn isi ihwɛngmɛn ubinkpi uku ukpo unga!&gt;<note caller="+" style="f"><char style="fr" closed="false">7.40 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="EXO 32:1">Idzi 32.1</ref></char>.</note> <verse eid="ACT 7:40"/><verse number="41" style="v" sid="ACT 7:41"/>Ivang hã niyɔ umbɔ aka agbishu ugberhe usaku ungwɛ̃ inak. Adzowe idɛm ru umgbɔ anu izek irhowa agɔm anggɔm nu ubinkpi umbɔ aka akũ abokmbɔ agbisha. <verse eid="ACT 7:41"/><verse number="42" style="v" sid="ACT 7:42"/>Bɔr Unum adzipu undzingnga nggu umbɔ. Na aneke umbɔ atsĩ idzowe igɔng ru ídzɛr afã ngge iwu anummbɔ. Akɛrɛ ha awu uku kpengkpeng nggu ubinkpi umbɔ aka atsɛng ru abvur abika asɔm Arherhu-Num agɛ,</para>
  <para style="q1" vid="ACT 7:42">&lt;&lt; &lt;Umbi angwãmbi ijuɛ</para>
  <para style="q2" vid="ACT 7:42">na adzaambi umum idɛm</para>
  <para style="q2" vid="ACT 7:42">ri imɛka isɔka inaa ra arhum, umbi abi iya Uisrairha?<verse eid="ACT 7:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43"/>Umbi azɛ̃rhã nggu ishia Umorhek</para>
  <para style="q2" vid="ACT 7:43">nu idzɛɛr ugberhe Urifan,</para>
  <para style="q2" vid="ACT 7:43">agberhe aki ha umbi aka agbisha adzowe ake igɔng.</para>
  <para style="q1" vid="ACT 7:43">Ngge iki iwu rimi, umum iwiwayiwe umbi ra abĩmbi,&gt;<note caller="+" style="f"><char style="fr" closed="false">7.43 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="AMO 5:25">Uamɔ 5.25</ref></char>.</note> ifaru Ubabirha itɔng.<verse eid="ACT 7:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44"/>&lt;&lt;Atokamɛn awe ru utsurha uwuruwi uku utsu umbɔ ahwɛng ideka Unum ru umbɔ ra arhum. Awu umgbɔ, uwu utsurhawi Unum aka atsu Umusa agbisha, ikɛi umbɔ agbisha umgbɔ uku kpengkpeng ubinkpi Unum aka adɛyiwe Umusa. <verse eid="ACT 7:44"/><verse number="45" style="v" sid="ACT 7:45"/>Utsurha ha ruwɔ atokamɛn aka akũ umgbɔ aba ra abĩ akɛrɛ umbɔ aka ayɛi ri ivang Ujoshuwa, Unum aka awayiwe atsen ra asumbɔ. Umgbɔ uwu umɔ uba utsĩ ivang Udauda, <verse eid="ACT 7:45"/><verse number="46" style="v" sid="ACT 7:46"/>unga aka awe ru imimuta Unum, na afɛna agɛ unga amaa adzine anang ru Unum uwu utokamɛn Uyakubu. <verse eid="ACT 7:46"/><verse number="47" style="v" sid="ACT 7:47"/>Bɔr awu Usorhomon unga adzine iya ha.<verse eid="ACT 7:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 7:48"/>&lt;&lt;Rimi hã Nggaa Uwuku Ugɔng asi iseisa ri iyakɛ aki anera iki idzin. Ubin ukpu uner uwuku usɔm Arherhu-Num aka agɔr agɛ,<verse eid="ACT 7:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="ACT 7:49"/>&lt;&lt; &lt;Afã awu anang isei iyɛrhamum,</para>
  <para style="q2" vid="ACT 7:49">nu upfung uwu anangkɛ umum iki iden andaidakmum.</para>
  <para style="q1" vid="ACT 7:49">Ikpũ iya iyikisong umbi aka idzina umum?</para>
  <para style="qr" vid="ACT 7:49">Uteijee agɔr.</para>
  <para style="q2" vid="ACT 7:49">Use anang akasong awu anang akika uwoshamum?<verse eid="ACT 7:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="ACT 7:50"/>Asi iwea abokmum adzin abin akɛrɛ ha kishoo?&gt;<note caller="+" style="f"><char style="fr" closed="false">7.50 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="ISA 66:1">Uish 66.1</ref>,<ref loc="ISA 66:2">2</ref></char>.</note><verse eid="ACT 7:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51"/>&lt;&lt;Umbi agbau abi igbĩrhĩ anera, nggu amɛn akika asheru usorhe nu ato! Umbi awe ru nyaka atokambi, ubɛn ivang umbi asi idɔsumbi Ipfu Isarsatangge. <verse eid="ACT 7:51"/><verse number="52" style="v" sid="ACT 7:52"/>Ra abika asɔm Arherhu-Num, uwukusong atokambi asi idzowukumbɔ unga uver? Afɛrkumbɔ abirabɛ aka arherhe arherhe ri itsi uwuku ububa Uwuku Arhurhika ha. Nu umbi igambi aghambi adaknga, umbi afɛre unga. <verse eid="ACT 7:52"/><verse number="53" style="v" sid="ACT 7:53"/>Umbi ayɛimbi Íkpem iyiki itsu itser ru ubok ípfu itser-Num bɔr umbi asi idɔsumbi.&gt;&gt;<verse eid="ACT 7:53"/></para>
  <para style="s1">Atang atarh nu Uistifanu</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54"/>Ivangyɛ umbɔ aka agũ rimi, amɛnmbɔ adak akarhãrhã, afar anyĩmbɔ agũ avɔm nggu unga. <verse eid="ACT 7:54"/><verse number="55" style="v" sid="ACT 7:55"/>Bɔr Uistifanu awu nggu Ipfu Isarsatangge, awing asunga arhi afã anyã ikpikpoi Unum, nu Uyesu aka adɛ̃ɛ̃ nu ubok ugha Unum. <verse eid="ACT 7:55"/><verse number="56" style="v" sid="ACT 7:56"/>Uistifanu agɛ, &lt;&lt;Àka anyã, umum inyã afã atsuri nu Ungwɛ̃-Ner adɛ̃ɛ̃ nu ubok ugha Unum.&gt;&gt;<verse eid="ACT 7:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57"/>Bɔr umbɔ akũ abok abvure atombɔ, atsarhi irhakmbɔ atsuyi ivum awirhi azĩ ru unga, <verse eid="ACT 7:57"/><verse number="58" style="v" sid="ACT 7:58"/>akũna unga adzek azĩ undzing utepa, adɛ̃ɛ̃ atang unga atarh nu unga. Abika adzowe ideka igbɛrangwĩ hã angwɛ̃we atorhambɔ nggu uwɛdzɛm uwɔɔ agburh Ushawurhu.<verse eid="ACT 7:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="ACT 7:59"/>Umbɔ aka adɛ̃ɛ̃ itang atarh nu unga, umɔ Uistifanu afɛn-Num agɛ, &lt;&lt;A Uteijee Uyesu, uyɛi ipfumum.&gt;&gt; <verse eid="ACT 7:59"/><verse number="60" style="v" sid="ACT 7:60"/>Mɔcɛ unga atararhu, na atsarhi irhaknga agɛ, &lt;&lt;A Uteijee niba ukpɔmmɔ arhim akɛrɛ nu atsimbɔ.&gt;&gt; Unga aka arherhe rimi amaa, na akpea.<verse eid="ACT 7:60"/></para>
  <chapter eid="ACT 7"/>
  <chapter number="8" style="c" sid="ACT 8"/>
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1"/>Ushawurhu awu umɔ abemuka ifɛr Uistifanu.</para>
  <para style="s1" vid="ACT 8:1">Uver ha utsu abika adɔsa asitumbɔ</para>
  <para style="p" vid="ACT 8:1">Ru unum hã nggaa uver utsĩkpɔ ra abika adɔsa ru Urusharhima, asituwe umbɔ kishoo ra abĩ abi Uyahudiya nu aki Usamariya, akpurha abɔre abi itser Uyesu. <verse eid="ACT 8:1"/><verse number="2" style="v" sid="ACT 8:2"/>Mɔcɛ aner Unum adzake Uistifanu, aciu akpenga akarhãrhã. <verse eid="ACT 8:2"/><verse number="3" style="v" sid="ACT 8:3"/>Bɔr Ushawurhu akpurha adɛ̃ɛ̃ idzowe uver ra abika adɔsa akarhãrhã. Atsĩrhã aya aya, adzui akatsak nu akatsɛrh atsuyiwe umbɔ ru ugborzĩ.<verse eid="ACT 8:3"/></para>
  <para style="s1">Ufirhibu ru Usamariya</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4"/>Abɔrɔ ha umbɔ aka asituwe adzowe Isarhe Iyiki Ize ri inangyɛ umbɔ aka azĩ. <verse eid="ACT 8:4"/><verse number="5" style="v" sid="ACT 8:5"/>Ufirhibu azĩã uteu Usamariya, adzowe isarhe Ukiristo umɔ. <verse eid="ACT 8:5"/><verse number="6" style="v" sid="ACT 8:6"/>Anera aka agũ, na anyã abin idzeukɛ unga aka akorhe umbɔ angwɛ̃ amɛnmbɔ ru ubinkpi unga iki irherhe. <verse eid="ACT 8:6"/><verse number="7" style="v" sid="ACT 8:7"/>Ípfu iyiki ibewe itsuyi ivum ni idzeyingge ru ayor anera arhɛrhɛ, akerhuwe abi ishayi iyor na akatarhu arhɛrhɛ. <verse eid="ACT 8:7"/><verse number="8" style="v" sid="ACT 8:8"/>Nggee umbɔ agɔm anggɔm akarhãrhã ru uteu ha.<verse eid="ACT 8:8"/></para>
  <para style="s1">Usiman uner igoka</para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9"/>Unera nuwɔ itsoka igburh Usiman anu itser igoka adzowe idzeu ra anera kishoo ru uteu Usamariya. Anu iberi itsinga agɛ unga awu nggaa uner. <verse eid="ACT 8:9"/><verse number="10" style="v" sid="ACT 8:10"/>Nu anera kishoo, uwuku ugɔng nu uwuku uci, atsu amɛnmbɔ nu unga anu igɔr agɛ, &lt;&lt;Utsak uwurɛ awe ru ijee iyi Unum umbɔ iki iyisa nggaa Ijee.&gt;&gt; <verse eid="ACT 8:10"/><verse number="11" style="v" sid="ACT 8:11"/>Umbɔ adɔsa unga ubinkutsu aka adera unga aka anu ikorhuwe umbɔ abin idzeu nggu igbigba igokanga. <verse eid="ACT 8:11"/><verse number="12" style="v" sid="ACT 8:12"/>Bɔr umbɔ aka awe ru imangmang ri Isarhe Iyiki Ize iyiriyɛ Ufirhibu aka arherhe iyi Iyɛrhe Unum nu iyi itsok Uyesu Ukiristo, asorhuwe umbɔ ubɔtisima, akatsak nu akatsɛrh. <verse eid="ACT 8:12"/><verse number="13" style="v" sid="ACT 8:13"/>Usiman nibikanga awea ri imangmang, umbɔ aka asorhuwe unga ubɔtisima ikɛi unga adɔsunga Ufirhibu ubɛn anang. Unga aka anyã Ufirhibu akorha atsar nu abin idzeu, unga adzeidzeu akarhãrhã.<verse eid="ACT 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14"/>Abi itser Uyesu aka awe ru Urusharhima aka agũ abi Usamariya aka ayɛimbɔ Arherhu-Num, umbɔ adene umbɔ Ubitru nggu Uyohana azĩ ru umbɔ. <verse eid="ACT 8:14"/><verse number="15" style="v" sid="ACT 8:15"/>Umbɔ aka azĩ atsĩ, umbɔ afɛne-Num ru umbɔ ama ayɛi Ipfu Isarsatangge, <verse eid="ACT 8:15"/><verse number="16" style="v" sid="ACT 8:16"/>ubinkutsu, Ipfu Isarsatangge ina isi icipuwangge nu unyinga umbɔ kata, akpurha akorhuwe umbɔ ubɔtisima ri itsok Uteijee Uyesu. <verse eid="ACT 8:16"/><verse number="17" style="v" sid="ACT 8:17"/>Mɔcɛ Ubitru nu Uyohana atsorhuwe abok nu umbɔ, umbɔ ayɛi Ipfu Isarsatangge.<verse eid="ACT 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18"/>Usiman aka anyã ugɛ awu itsorha abok abi itser Uyesu iki isaki itsu ikpo Ipfu-Num, unga adzowe umbɔ uhwɛk. <verse eid="ACT 8:18"/><verse number="19" style="v" sid="ACT 8:19"/>Na agɛ, &lt;&lt;Udzaa umum ijee ha igamum, umum ĩba itsorhumum ubok nu ubɛn unera unga akpo Ipfu Isarsatangge.&gt;&gt;<verse eid="ACT 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20"/>Ubitru agɔr unga agɛ, &lt;&lt;Uhwɛkngo nggu ungo aka atsim, ungo ukaifɛrhkɔ ugɛ ungo ukũ uhwɛk uyɛi izũwũ Unum! <verse eid="ACT 8:20"/><verse number="21" style="v" sid="ACT 8:21"/>Ungo ushiɔ ru ugau ri itser iyɛrɛ, ubinkutsu, amɛnngo asi irhikuke ra asu Unum. <verse eid="ACT 8:21"/><verse number="22" style="v" sid="ACT 8:22"/>Udzipa ru iyiki ibewa iyɛrɛ nu ufɛn-Num ru Uteijee. Use unga awuri itsũwãnga ungo ri ikpũ ifɛrhkɔ iyɛrɛ ra amɛnngo. <verse eid="ACT 8:22"/><verse number="23" style="v" sid="ACT 8:23"/>Ubinkutsu umum inyã amɛnngo awu nggu unyɛ̃ɛ̃ akarhãrhã aka abow ra arhim.&gt;&gt;<verse eid="ACT 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24"/>Mɔcɛ Usiman agɛ, &lt;&lt;Àka afɛnuwa umum Uteijee, utsur abin hã umbi aka arherhe akorhuke nggu umum.&gt;&gt;<verse eid="ACT 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25"/>Ivangyɛ umbɔ Ubitru nggu Uyohana aka amaa idzowe isarhe Arherhu Uteijee, umbɔ abvui azĩmbɔ Urusharhima, adzowe Isarhe Iyiki Ize ri iteu Usamariya irhɛirhɛ.<verse eid="ACT 8:25"/></para>
  <para style="s1">Ufirhibu nu uner Uitiyofiya</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26"/>Icɛ ipfu itser Uteijee igɔr Ufirhibu igɛ, &lt;&lt;Uso uzĩ unɔr utsĩndĩ arhum uwuku udzeku Urusharhima uzĩ Ugaza.&gt;&gt; <verse eid="ACT 8:26"/><verse number="27" style="v" sid="ACT 8:27"/>Nggee unga asok adzek azĩã, unga agbopu uner Uitiyofiya uwuruwi aka awu unggbaashi, abika angwɛ̃ kishoo abin Ukadi uyɛrhe Uitiyofiya, aka awu ukutsɛrh. Aka azĩ Urusharhima idzowe igɔng. <verse eid="ACT 8:27"/><verse number="28" style="v" sid="ACT 8:28"/>Unga awu ru utsĩndĩ uwuku uzĩ usoi, asei ru ikar inyãwãnga anu ivarhu ubvur uwuku usɔm Arherhu-Num Uishaya. <verse eid="ACT 8:28"/><verse number="29" style="v" sid="ACT 8:29"/>Ipfu-Num igɔr Ufirhibu igɛ, &lt;&lt;Uzĩ ukhapa nu ikar inyãwã iyɔrɔ.&gt;&gt;<verse eid="ACT 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 8:30"/>Ufirhibu atĩ azĩ nu ikar inyãwã hã agũ utsa ha adɛ̃ɛ̃ ivarhe ubvur uwuku usɔm Arherhu-Num Uishaya. Ufirhibu arhusa unga agɛ, &lt;&lt;Ungo ugũ utaingo ubinkpi ungo uku uvarhe?&gt;&gt;<verse eid="ACT 8:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 8:31"/>Unga agɛ, &lt;&lt;Umum ikorhi iguse, unera aba asi igbisha adɛyiwanga umum?&gt;&gt; Na ayisu Ufirhibu afũ ikar inyãwã hã umbɔ asei.<verse eid="ACT 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 8:32"/>Uner Uitiyofiya ha adɛ̃ɛ̃ ivarhe ubvur Arherhu-Num aka agɔr ugɛ,</para>
  <para style="q1" vid="ACT 8:32">&lt;&lt;Adarh unga ru nyaki idɔi azĩmbɔ ingwĩngwã,</para>
  <para style="q2" vid="ACT 8:32">ru nyaku ungwɛ̃ itsurhi iki unukutata ru ubok uwuku ukone igwar iyorngge,</para>
  <para style="q2" vid="ACT 8:32">unga asi iyangunga angwĩnga.<verse eid="ACT 8:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="ACT 8:33"/>Akwɛɛte unga na akɛnmbɔ unga idzidzɛrhanga.</para>
  <para style="q2" vid="ACT 8:33">Ungaa idɛ̃ɛ̃ arherhe arherhe ri itsi unangnga?</para>
  <para style="q2" vid="ACT 8:33">Ubinkutsu anyangu urhɛnga adzembɔ ru upfung.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">8.33 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="ISA 53:7">Uish 53.7</ref>,<ref loc="ISA 53:8">8</ref></char>.</note><verse eid="ACT 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34"/>Uner Uitiyofiya ha arhusu Ufirhibu, agɛ, &lt;&lt;Udɛyiwa umum, kabɔɔ, uner uwuku usɔm Arherhu-Num hã arherhe arherhe ha ri itsi ungaa, ri itsinga use ri itsi uner uwukuse?&gt;&gt; <verse eid="ACT 8:34"/><verse number="35" style="v" sid="ACT 8:35"/>Mɔcɛ Ufirhibu atirhi nu ugbɛr itsɛng Arherhu-Num uwu ha adzowe unga Isarhe Iyiki Ize iyi Uyesu.<verse eid="ACT 8:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 8:36"/>Umbɔ awe ru uzɛ̃rhã nú utsĩndĩ hã, azĩ anyã amɛ̃, Uner Uitiyofiya ha agɛ, &lt;&lt;Unyã amɛ̃ akɛ! Awu use ikɛn umum isi ísorhmum ubɔtisima?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">8.36 </char><char style="ft" closed="false">Abvur akɔɔ aki itsɛng abok aki isha agɔrke ikɛi ugɛ, </char><char style="fv" closed="false">37 </char><char style="fqa" closed="false">Ufirhibu agɛ, &lt;&lt;Ungo uba udzowukɔ imangmang nggu amɛn unying, awuri ikorhuwambɔ ungo ubɔtisima.&gt;&gt; Mɔcɛ utsa ha agɔr agɛ, &lt;&lt;Umum idzowukũ imangmang ugɛ Uyesu Ukiristo awu Ungwɛ̃ Unum.&gt;&gt;</char></note> <verse eid="ACT 8:36"/><verse number="38" style="v" sid="ACT 8:38"/>Unga atsu umbɔ ajimu ikar inyãwã hã ngge idɛ̃ɛ̃. Umbɔ Ufirhibu nggu utsa ha ikivarhambɔ acipa atsĩmbɔ ra amɛ̃. Mɔcɛ Ufirhibu asorhuwe ubɔtisima ru utsa ha. <verse eid="ACT 8:38"/><verse number="39" style="v" sid="ACT 8:39"/>Ivangyɛ umbɔ aka adzeka ra amɛ̃, Ipfu Uteijee ishupungge Ufirhibu, Uner Uitiyofiya ha asi ibvui anyã unga ikɛi, bɔr azĩã uzɛ̃rhãnga na agɔm anggɔm. <verse eid="ACT 8:39"/><verse number="40" style="v" sid="ACT 8:40"/>Ufirhibu, anyã itsinga, ru Uazotu. Umɔ unga atsĩrhã ri kishoo iteu, adzise Isarhe Iyiki Ize azĩ atsĩã Ukaisariya.<figure style="fig" alt="Philip's Travel" file="ldb GPS_PhilipsTravelsSmall_B&amp;W.jpg" size="span" copy="WBT" ref="8.5-40">Uzɛ̃rhũ Ufirhibu</figure><verse eid="ACT 8:40"/></para>
  <chapter eid="ACT 8"/>
  <chapter number="9" style="c" sid="ACT 9"/>
  <para style="s1">Ushawurhu adɔsu Uyesu</para>
  <para style="r">(<ref loc="ACT 22:6-16">Aiy 22.6-16</ref>; <ref loc="ACT 26:12-18">26.12-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1"/>Ri ivang hã Ushawurhu anu igha unggbaashi nggu iziya angwɛ̃ imesu Uteijee. Unga asok azĩã ru Ukugɔng Uwuku Udzowe Idɛm-Num, <verse eid="ACT 9:1"/><verse number="2" style="v" sid="ACT 9:2"/>ashɔ̃rhã unga amaa atsɛng abvur adzowe anggbaashi abã ifɛn-Num ru Udimashku, ubinkutsu unga aba azĩ akpoa abika adɔsu Utsĩndĩ Uteijee, akatsak use akatsɛrh, unga abow umbɔ akũ aba Urusharhima. <verse eid="ACT 9:2"/><verse number="3" style="v" sid="ACT 9:3"/>Unga aka azɛ̃rhã azĩ akhapa nggu Udimashku, kanying irhirhang idzeka afã irhang idzipa unga. <verse eid="ACT 9:3"/><verse number="4" style="v" sid="ACT 9:4"/>Unga agba anu nu abĩ na agũ urhɛm ukpɔɔ uku ugɔr unga ugɛ, &lt;&lt;A Ushawurhu, a Ushawurhu, awu use utsu ungo udzaa umum uver?&gt;&gt;<verse eid="ACT 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5"/>Ushawurhu arhusa agɛ, &lt;&lt;Awu ungo ungaa Uteijee?&gt;&gt;</para>
  <para style="p" vid="ACT 9:5">Urhɛm hã ugɔr ugɛ, &lt;&lt;Awu umum Uyesu uwuruwi ungo uku udɛ̃ɛ̃ idzowe uver. <verse eid="ACT 9:5"/><verse number="6" style="v" sid="ACT 9:6"/>Icɛrɛ usisok utsĩ ru utepa, nggɔɔ ha umbɔ awuri idɛyiwambɔ ubinkpi awu ufang ungo iki ikorhe.&gt;&gt;<verse eid="ACT 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7"/>Abika azɛ̃rhã nggu Ushawurhu afɔr arherhe adambɔ, umbɔ agũmbɔ urhɛm hã na asi inyãmbɔ unera. <verse eid="ACT 9:7"/><verse number="8" style="v" sid="ACT 9:8"/>Ushawurhu asoka abĩ na ayanga asunga bɔr asi idɛ̃ɛ̃ anyã ubin. Nggee umbɔ akpɔm aboknga adarh unga atsĩ ru Udimashku. <verse eid="ACT 9:8"/><verse number="9" style="v" sid="ACT 9:9"/>Unga amaa inuma itaar, asunga awu ibvuta, asi ighaa na asi ihwaa ubin ikɛi.<verse eid="ACT 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10"/>Ungwɛ̃ imesa Uyesu nuwɔ ru Udimashku itsoka igburh Uhananiya. Uteijee ayisa unga ru irhi agɛ, &lt;&lt;A Uhananiya!&gt;&gt; Unga anyũwã agɛ, &lt;&lt;Umumwi, Uteijee.&gt;&gt;<verse eid="ACT 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 9:11"/>Uteijee ha agɔr unga agɛ, &lt;&lt;Usisok utsĩ ri iya Uyahuda nu utsĩndĩ uwɔ umbɔ iki iyisa agɛ uku Urhirhiki urhusa ugɛ use uner Utarsu itsoka iki igburh Ushawurhu awu umɔ, unggawɔ adɛ̃ɛ̃ ifɛn-Num mɔnɔ. <verse eid="ACT 9:11"/><verse number="12" style="v" sid="ACT 9:12"/>Ru irhi unga aka anyã unerwi aka agburh Uhananiya aka aba atsorhu ubok nu unga, unga abvui anyãã ikɛi.&gt;&gt;<verse eid="ACT 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13"/>Uhananiya agɛ, &lt;&lt;A Uteijee, umum iki nggũshumum arherhe utsak uwirɛ ra anera arhɛrhɛ, nu amɛn aka abewe unga aki ikorhuwe abika adɔsa ungo akarhãrhã ru Urusharhima. <verse eid="ACT 9:13"/><verse number="14" style="v" sid="ACT 9:14"/>Nggayɛ ikɛi ateiya abika adzowe idɛm-Num aka adzowukumbɔ unga ijee iyiki idzui kishoo abirabɛ aka afɛn ungo.&gt;&gt;<verse eid="ACT 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 9:15"/>Bɔr Uteijee agɔr Uhananiya agɛ, &lt;&lt;Uzĩ! Awu utsa ha uwi umum iki isɛng unga aka itɔ̃ itser iyiki idzowe isarhe itsokmum ra atsen abi Uyahuda nu ayɛrhambɔ nu aner Uisrairha. <verse eid="ACT 9:15"/><verse number="16" style="v" sid="ACT 9:16"/>Umum iwuri idɛyikũ unga ikpũ ayetnumkɛ awu ufang unga aka ihwa ri itsokmum.&gt;&gt;<verse eid="ACT 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17"/>Nggee Uhananiya asok azĩã azĩ atsĩ ri iya. Atsorha aboknga nu Ushawurhu, na agɛ, &lt;&lt;A ungwɛ̃mɛn Ushawurhu, Uteijee Uyesu uwuruwi aka adzeka ru ungo nu utsĩndĩ ibibango nggimi unga adena umum ĩba ru ungo ubvui unyã anang ikɛi nu uwe nggu Ipfu Isarsatangge.&gt;&gt; <verse eid="ACT 9:17"/><verse number="18" style="v" sid="ACT 9:18"/>Kanying, abina ru nyaka afeka abɛrh ahwor ra asu Ushawurhu agba, mɔcɛ unga abvui anyã anang. Unga asok, umbɔ asorhuwe unga ubɔtisima. <verse eid="ACT 9:18"/><verse number="19" style="v" sid="ACT 9:19"/>Unga aka agha ubingha amaa, unga akpo iker iyornga.</para>
  <para style="p" vid="ACT 9:19">Ushawurhu amaa inum iyɔɔ asei nggu angwɛ̃ imesa ru Udimashku. <verse eid="ACT 9:19"/><verse number="20" style="v" sid="ACT 9:20"/>Kanying Ushawurhu atirhunga idzowe isarhe Uyesu ra abã ifɛn-Num abi Uyahuda agɛ Uyesu awu Ungwɛ̃ Unum. <verse eid="ACT 9:20"/><verse number="21" style="v" sid="ACT 9:21"/>Kishoo abika agũ unga adzeidzeu na arhusa agɛ, &lt;&lt;Asi iwea unga afɛyiwe abika afɛn uner ha, Uyesu, ru Urusharhima? Unga asi ibanga idzui anera nggimi akũ azĩ ra ateiya abika adzowe idɛm-Num?&gt;&gt; <verse eid="ACT 9:21"/><verse number="22" style="v" sid="ACT 9:22"/>Bɔr isarhe Ushawurhu ikpurhi idɛ̃ɛ̃ ititoma ri iker nu ijee, itsu abi Uyahuda abika asei ru Udimashku adzeidzeu na adzuna, unga aka adɛyiwe idzidzɛrhe ugɛ Uyesu awu Ukiristo.<verse eid="ACT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23"/>Inuma irhɛirhɛ iki imaa, abi Uyahuda akɛki itsũwã iyiriyɛ umbɔ aka ifɛre Ushawurhu. <verse eid="ACT 9:23"/><verse number="24" style="v" sid="ACT 9:24"/>Bɔr Ushawurhu aka agũ ubinkpi umbɔ aka arherhe. Nu utsuu na atenum, atsu asumbɔ adzɛu ingwĩ utepa abee ifɛre unga. <verse eid="ACT 9:24"/><verse number="25" style="v" sid="ACT 9:25"/>Bɔr angwɛ̃ imesanga ashupa unga ru uzĩng ru untsuuka acipuwe unga ra angwĩ ubandzin ufɔm utepa. <figure style="fig" alt="Paul lowered in a basket" file="lb00333b.tif" size="col" loc="ACT 9.25" copy="Horace Knowles" ref="9.25">Acipuwe Uburhu ra angwĩ ubandzin ufɔm utepa</figure><verse eid="ACT 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26"/>Ivangyɛ unga aka abvui aba atsĩ Urusharhima, unga abee igbopi itsi nggu awɛ imesu Uyesu, bɔr kishoo agũ iwei unga, umbɔ asi idzowukumbɔ imangmang ugɛ unga awu ungwɛ̃ imesa idzidzɛrhe. <verse eid="ACT 9:26"/><verse number="27" style="v" sid="ACT 9:27"/>Bɔr Ubarnaba akũna unga akũ azĩã ra abi itser Uyesu. Adɛyiwe umbɔ Ushawurhu aka anyã Uteijee nu utsĩndĩ nu Arherhu Uteijee nggu Ushawurhu, nu Isarhe Iyiki Ize Ushawurhu adũwã ri itsok Uyesu ru Udimashku asi igũa iwei. <verse eid="ACT 9:27"/><verse number="28" style="v" sid="ACT 9:28"/>Nggee Ushawurhu asei nggu umbɔ na azɛ̃rhã nggu umbɔ ru Urusharhima, adzowe isarhe ri itsok Uteijee asi igũa iwei. <verse eid="ACT 9:28"/><verse number="29" style="v" sid="ACT 9:29"/>Ikɛi unga anu irherha arherhe na awe ru uning nggu abi Uyahuda abika agũ idũ abi Uherhini, bɔr umbɔ abee utsĩndĩ uwuku ufɛre unga. <verse eid="ACT 9:29"/><verse number="30" style="v" sid="ACT 9:30"/>Abika adɔsa aka ahwɛng rimi, umbɔ akũna unga azĩmbɔ Ukaisariya adene unga azĩã Utarsu.<verse eid="ACT 9:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31"/>Mɔcɛ abika adɔsa ru Uyahudiya, nu Ugarhirhi, nu Usamariya, akpombɔ ididɔɔr. Umbɔ akpo iker nu ififita akarhãrhã ri Ipfu Isarsatangge, atɛ̃rhã awu arhɛrhɛ nggu iwei Uteijee.<verse eid="ACT 9:31"/></para>
  <para style="s1">Ubitru akerhuwe Uiniya</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32"/>Ubitru aka azɛ̃rhã amaa abĩã kishoo, unga azĩã ra abika adɔsa ha ru Urhidda. <verse eid="ACT 9:32"/><verse number="33" style="v" sid="ACT 9:33"/>Umɔ unga aka agbopa nggu uner uwɔɔ agburh Uiniya, uwuruwi aka aghong irhãrhĩ iyiki ishayi iyor anu imɛka utɔrɔk. <verse eid="ACT 9:33"/><verse number="34" style="v" sid="ACT 9:34"/>Ubitru agɔr unga agɛ, &lt;&lt;A Uiniya, Uyesu Ukiristo aka akerhuwanga ungo. Uso ufetu ufarngo.&gt;&gt; Kanying Uiniya asoka. <verse eid="ACT 9:34"/><verse number="35" style="v" sid="ACT 9:35"/>Kishoo aner Urhidda nu abi abĩ Usharon anyã unga aka akerhunga, umbɔ adzipa awu abi Uteijee.<verse eid="ACT 9:35"/></para>
  <para style="s1">Ubitru azituwe ukom Utabita</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36"/>Ru Ujopa ungwɛ̃ imesu Uyesu nuwɔ, itsoka igburh Utabita, agbena agburh &lt;&lt;Udooka,&gt;&gt; uwuku udzowe itsinga ri itɔ̃ itser iyiki ize, na ayike atsũwã. <verse eid="ACT 9:36"/><verse number="37" style="v" sid="ACT 9:37"/>Ri ivang hã unga aghong akpea, umbɔ aka asorhuwe iyornga na angwɛ̃we unga ru ubã afã. <verse eid="ACT 9:37"/><verse number="38" style="v" sid="ACT 9:38"/>Urhidda ukhapa nggu Ujopa angwɛ̃ imesa aka agũ agɛ Ubitru awe ru Urhidda, umbɔ adene inera ivaa izĩ ru unga ashɔ̃rhã unga agɛ, &lt;&lt;Kabɔɔ uba ru umɛn ifetem!&gt;&gt;<verse eid="ACT 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 9:39"/>Ubitru asok azĩã nggu umbɔ, unga aka azĩ atsĩ umbɔ akũna unga afũmbɔ ru ubã afã hã. Kishoo atsɛ̃rhãpfu adɛ̃ɛ̃ adziira unga, aciu akpe adɛyiwe atorho ha Udooka aka adzise umbɔ unga aka awu nggu umbɔ.<verse eid="ACT 9:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 9:40"/>Ubitru atsu umbɔ kishoo adzek ra awiya, unga atar arhuk na afɛn-Num. Adzipa udiku ukom utsɛrh ha, agɛ, &lt;&lt;A Utabita, usisok.&gt;&gt; Unga ayanga asunga, unga aka anyã Ubitru unga asok asei isei. <verse eid="ACT 9:40"/><verse number="41" style="v" sid="ACT 9:41"/>Ubitru adzowe uboknga ayike unga asok adɛ̃ɛ̃ nu adaknga. Mɔcɛ unga ayisa abika adɔsa na atsɛ̃rhãpfu ha adzowuka Utabita ru umbɔ nggu urhɛ. <verse eid="ACT 9:41"/><verse number="42" style="v" sid="ACT 9:42"/>Isarhe iyɛrɛ itɛ̃rhã kishoo ru Ujopa, anera arhɛrhɛ aka adzowe imangmang ru Uteijee. <verse eid="ACT 9:42"/><verse number="43" style="v" sid="ACT 9:43"/>Ubitru asei inuma irhɛirhɛ ru Ujopa ri iya uwɔɔ uner itser abvur ijuɛ itsoka igburh Usiman.<verse eid="ACT 9:43"/></para>
  <chapter eid="ACT 9"/>
  <chapter number="10" style="c" sid="ACT 10"/>
  <para style="s1">Ukonerhiyu ayisu Ubitru</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1"/>Unera nuwɔ ru Ukaisariya itsoka igburh Ukonerhiyu, unga awu uteiya abi iwa ru ukpui Uitarhiya ra abi iwa Uroma. <verse eid="ACT 10:1"/><verse number="2" style="v" sid="ACT 10:2"/>Unga nu abi iyanga kishoo awu abika adzowe igɔng na agũ iwei Unum, atsu itsinga akarhãrhã ri idzowe izũwã irhɛirhɛ ra atsũwã, na afɛn-Num ubɛn ivang. <verse eid="ACT 10:2"/><verse number="3" style="v" sid="ACT 10:3"/>Unuma nukpɔ aka ayoka akara ataar ra atenuma, unga anyã ipfu itser-Num ru irhi, iki igɔr unga igɛ, &lt;&lt;A Ukonerhiyu!&gt;&gt;<verse eid="ACT 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 10:4"/>Unga atsu asunga ri iwei na arhusa agɛ, &lt;&lt;A Uteijee, awu use?&gt;&gt;</para>
  <para style="p" vid="ACT 10:4">Ipfu itser-Num igɔr unga igɛ, &lt;&lt;Unum aka agũã ifɛn-Numngo nu iyiyikeyɛ ungo uku iyike atsũwã. Unga ayɛi ngge ru nyaku izũwã. <verse eid="ACT 10:4"/><verse number="5" style="v" sid="ACT 10:5"/>Udene anera icɛrɛ umbɔ azĩ Ujopa ayisuwa Usiman uwu ha umbɔ iki iyisa unga Ubitru. <verse eid="ACT 10:5"/><verse number="6" style="v" sid="ACT 10:6"/>Unggawɔ asei nggu Usiman uwuku utɔ̃itser abvur ijuɛ, uwuruwi iyanga iki iwe ru ubang ukau ukugɔng.&gt;&gt;<verse eid="ACT 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 10:7"/>Ivangyɛ ipfu itser-Num iyiki irherha arherhe nggu unga iki izĩngge, Ukonerhiyu ayisa agãrhãnga avaa, nu uner iwa uwuku udɔsu Unum ra abika atɔ̃ itsernga. <verse eid="ACT 10:7"/><verse number="8" style="v" sid="ACT 10:8"/>Unga aka amaa idɛyiwe umbɔ abina kishoo aka akorhe na adene umbɔ azĩmbɔ Ujopa.<verse eid="ACT 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9"/>Ra atenuma unum uvaa agãrhũ Ukonerhiyu awe ru uzɛ̃rhã umbɔ aka ayo ru utepa, Ubitru afũ ni itsi uvi abee ifɛn-Num. <verse eid="ACT 10:9"/><verse number="10" style="v" sid="ACT 10:10"/>Imerh ifɛr unga, unga abee igha ubin, bɔr umbɔ aka adɛ̃ɛ̃ ikorhu ubingha, unga anyã irhi. <verse eid="ACT 10:10"/><verse number="11" style="v" sid="ACT 10:11"/>Unga anyã afã aka atsuri, unga anyã ubina ru nyaka atorho ukoma atɛtɛi uku ucipuwa nu abĩ nggu angbokake anaa aka ayurhi. <verse eid="ACT 10:11"/><verse number="12" style="v" sid="ACT 10:12"/>Ru ake ubɛn ikpũ ijuɛ iyi adaka anaa iwu umɔ, nu iyiki ikaikai, íbvui nu ígwer nu anunu afafã. <verse eid="ACT 10:12"/><verse number="13" style="v" sid="ACT 10:13"/>Mɔcɛ unga agũ urhɛm uku ugɔr unga ugɛ, &lt;&lt;A Ubitru, uso, ungwãnu utãi.&gt;&gt;<verse eid="ACT 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 10:14"/>Bɔr Ubitru agɛ, &lt;&lt;ĩ'ĩ Uteijee! Umum inasi ighamum ubin arhim use ukpurukpi uku usi isarkpɔ.&gt;&gt;<verse eid="ACT 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 10:15"/>Unga abvui agũ urhɛm hã idevaa, uku ugɔr ugɛ, &lt;&lt;Ubinkpi Unum aka asare ukpɔ, niba ugɔrɔ ukpɔ ugɛ usi isarkpɔ.&gt;&gt;<verse eid="ACT 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 10:16"/>Ifɛrhɛ iyɛrɛ ha ikorhe idiki itaar, nu kanying umbɔ unyangu atorha ha afũmbɔ ra afã. <figure style="fig" alt="The animals Peter saw" file="gt00113.tif" size="col" loc="10.16" copy="Gordon Thompson" ref="10.9-16">Íjuɛyɛ Ubitru aka anyã</figure><verse eid="ACT 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17"/>Amɛn Ubitru ana awe ri icang agben irhi ha umbɔ aka adɛyiwe unga, aner ha Ukonerhiyu aka adene arhusa na adɛ̃ɛ̃ ra angwĩ iya. <verse eid="ACT 10:17"/><verse number="18" style="v" sid="ACT 10:18"/>Umbɔ ayisa arhusa agɛ, &lt;&lt;Usiman uwuruwi umbɔ iki iyisa Ubitru asei umɔ?&gt;&gt;<verse eid="ACT 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 10:19"/>Ubitru ana awe ri ifɛrhkɔ irhi ha, Ipfu-Num igɔr unga igɛ, &lt;&lt;Usiman, inera itaar iyɛ idɛ̃ɛ̃ ibeea ungo. <verse eid="ACT 10:19"/><verse number="20" style="v" sid="ACT 10:20"/>Nggee uso ucipa uzĩ ru umbɔ. Niba ucango izĩ nggu umbɔ, ubinkutsu awu umum idene umbɔ.&gt;&gt;<verse eid="ACT 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 10:21"/>Ubitru acipa azĩ ru aner ha, agɔr umbɔ agɛ, &lt;&lt;Awu umum umbi aka abee. Awu use utsu umbi aba?&gt;&gt;<verse eid="ACT 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 10:22"/>Aner ha agɛ, &lt;&lt;Umɛn idzeku Ukonerhiyu uteiya abi iwa. Arhiku uner na agũ iwei Unum, awuri imor ra asu abi Uyahuda kishoo. Usarkasar ipfu itser-Num itsu unga adena itser ugɛ ungo uba ri iyanga, unga awuri igigũa ubinkpi ungo iki irherhe.&gt;&gt; <verse eid="ACT 10:22"/><verse number="23" style="v" sid="ACT 10:23"/>Mɔcɛ Ubitru akũna umbɔ atsĩ, ayɛi umbɔ awu atsen ri iyanga.</para>
  <para style="s1" vid="ACT 10:23">Ubitru ri iya Ukonerhiyu</para>
  <para style="p" vid="ACT 10:23">Unum untaar Ubitru azĩã nggu umbɔ, nu abika adɔsa abɔɔ aka adzeku Ujopa azĩ urhɔnga. <verse eid="ACT 10:23"/><verse number="24" style="v" sid="ACT 10:24"/>Unum unaa umbɔ atsĩmbɔ Ukaisariya. Ukonerhiyu aka afosi ibibambɔ ayisa abimbɔ kishoo nu awɛrhanga abi idzidzɛrhe. <verse eid="ACT 10:24"/><verse number="25" style="v" sid="ACT 10:25"/>Ubitru awuri itsĩ ri iya nukpi, Ukonerhiyu agbanga unga atararhu ra asunga, adzowe unga igɔng. <verse eid="ACT 10:25"/><verse number="26" style="v" sid="ACT 10:26"/>Bɔr Ubitru atsu unga asisok agɛ, &lt;&lt;Usisok! Umum iwu unera ukpekũ ru nyaka ungo.&gt;&gt;<verse eid="ACT 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 10:27"/>Ubitru aka adɛ̃ɛ̃ arherhe nggu unga, atsĩ akpo anera arhɛrhɛ aka akɔng. <verse eid="ACT 10:27"/><verse number="28" style="v" sid="ACT 10:28"/>Unga agɔr umbɔ agɛ, &lt;&lt;Umbi ahwɛngmbi ugɛ isi imɛ̃ngge uner Uyahudiya agbopi itsi use unga azĩ iyepa atsen abi Uyahuda. Bɔr Unum aka adɛyiwanga umum agɛ umum niba iyisumum unera igɛ asi isara, use asi itɛna. <verse eid="ACT 10:28"/><verse number="29" style="v" sid="ACT 10:29"/>Nggee ivangyɛ umbɔ aka adene ugɛ umum ĩba, umum isi ikpɛ̃mum. Icɛrɛ umum ibee irhusa awu use utsu umbi ayisa umum.&gt;&gt;<verse eid="ACT 10:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30"/>Ukonerhiyu agɛ, &lt;&lt;Inuma inaa iki itɔng ru nyaki ivang iyɛrɛ nu akara ataar aki urhɛɛ. Umum iwuri ifɛn-Num ri iyamum, kanying umum inyã unera aka adɛ̃ɛ̃ ra asumum atsim atorho aka aterha ake arhang. <verse eid="ACT 10:30"/><verse number="31" style="v" sid="ACT 10:31"/>Uner ha agɛ, &lt;A Ukonerhiyu, Unum aka agũã ifɛn-Numngo na ayitunga ungo iki iyike atsũwã. <verse eid="ACT 10:31"/><verse number="32" style="v" sid="ACT 10:32"/>Udene itser ru Ujopa umbɔ ayisuwa Usiman, uwuruwi umbɔ iki iyisa Ubitru. Unga awu utsen ri iya Usiman, uwuku utɔ̃itser abvur ijuɛ uwuruwi iyanga iki iwe ru ubang ukau azɛ̃ akagɔng.&gt; <verse eid="ACT 10:32"/><verse number="33" style="v" sid="ACT 10:33"/>Ngge itsu kanying umum idene umbɔ ayisa ungo, aze ungo uku uba. Icɛrɛ Umɛn abɛ ikɔng kishoo ra asu Unum, umɛn iwuri ikpeto ru ubɛn ubinkpi Uteijee aka atsuka ungo udɛyiwa umɛn.&gt;&gt;<verse eid="ACT 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34"/>Mɔcɛ Ubitru atirhi irherhuwe umbɔ arherhe agɛ, &lt;&lt;Idzidzɛrhe umum ihwɛng Unum asi itɛnga asu. <verse eid="ACT 10:34"/><verse number="35" style="v" sid="ACT 10:35"/>Bɔr ayɛi anera ra abĩã kishoo abika agũ iwei unga na akorhu ubinkpi uku urhika. <verse eid="ACT 10:35"/><verse number="36" style="v" sid="ACT 10:36"/>Umbi ahwɛngmbi itseryɛ Unum aka adene ra aner Uisrairha, agɛ Isarhe Iyiki Ize iyi ididɔɔr iba ru ubok Uyesu Ukiristo, unga aka awu Uteijee kishoo. <verse eid="ACT 10:36"/><verse number="37" style="v" sid="ACT 10:37"/>Umbi ahwɛngmbi ubinkpi uku ukorhe umaa abĩ Uyahudiya kishoo, utirhi ru Ugarhirhi ri ivangyɛ Uyohana aka idzowe isarhe iyi ubɔtisima. <verse eid="ACT 10:37"/><verse number="38" style="v" sid="ACT 10:38"/>Umbi ahwɛngmbi ubinkpi uku ukorhe Unum aka adzukuwe atsei na atsuke Ipfu Isarsatangge nu ijee ru Uyesu uwu Unazarat, unga aka azɛ̃rhã akorhi iyiki ize akerhuwe kishoo abirabɛ aka awe ru ijee Undenggũ, ubinkutsu Unum awu nggu unga.<verse eid="ACT 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 10:39"/>&lt;&lt;Umɛn iwu ideka ru ubɛn ubinkpi unga aka akorhe ra abĩ abi Uyahuda, nu Urusharhima. Umbɔ afɛre unga ri inyinyapuwe unga ni igãrhãmau ucucii. <verse eid="ACT 10:39"/><verse number="40" style="v" sid="ACT 10:40"/>Bɔr Unum asoyika unga ra akpe ru unum ukpu untaar na atsu unga adzeka umbɔ anyã unga. <verse eid="ACT 10:40"/><verse number="41" style="v" sid="ACT 10:41"/>Asi iwea anera kishoo anyã unga, akpurha adzeka ra abirabɛ Unum aka asɛng umɛn iwu ideka, umɛn iki igha ni ihwa nggu unga aka asoka akpe. <verse eid="ACT 10:41"/><verse number="42" style="v" sid="ACT 10:42"/>Unga atsu umɛn idzowe isarhe ra anera ni idɛyiwe anera ugɛ, awu unga hã nuwi Unum aka asɛng unga awuri itsu uvau abi urhɛ na abika akpe. <verse eid="ACT 10:42"/><verse number="43" style="v" sid="ACT 10:43"/>Abika asɔm Arherhu-Num kishoo adzowukumbɔ ideka ri itsinga agɛ, ubɛn unera aka adzowuka imangmang ru unga awuri ikpoa itsũwe arhim ri itsoknga.&gt;&gt;<verse eid="ACT 10:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44"/>Ubitru awu ra arherhe nukpi, Ipfu Isarsatangge icipuwangge nu abirabɛ aka anu igosha arherhanga kishoo. <verse eid="ACT 10:44"/><verse number="45" style="v" sid="ACT 10:45"/>Abi usorhe abi Uyahuda abika adɔsa, abirabɛ aka aba nggu Ubitru, adzeidzeu umbɔ aka anyã atsen abi Uyahuda ayɛimbɔ izũwã Ipfu Isarsatangge. <verse eid="ACT 10:45"/><verse number="46" style="v" sid="ACT 10:46"/>Ubinkutsu umbɔ agũ umbɔ anu irherhi idũ iyikise na adzowe igɔng ru Unum.</para>
  <para style="p" vid="ACT 10:46">Mɔcɛ Ubitru agɛ, <verse eid="ACT 10:46"/><verse number="47" style="v" sid="ACT 10:47"/>&lt;&lt;Unera awea unga aka ikɛn isorhuwe ubɔtisima nggu amɛ̃ ra anera abɛrɛ umbɔ aka ayɛi Ipfu Isarsatangge ru nyaka umɛn iki ikpo?&gt;&gt; <verse eid="ACT 10:47"/><verse number="48" style="v" sid="ACT 10:48"/>Nggee unga atsu umbɔ asorhuwe umbɔ ubɔtisima ri itsok Uyesu Ukiristo. Mɔcɛ umbɔ ashɔ̃rhã unga ama asei nggu umbɔ inuma ukunjiir.<verse eid="ACT 10:48"/></para>
  <chapter eid="ACT 10"/>
  <chapter number="11" style="c" sid="ACT 11"/>
  <para style="s1">Ubitru adɛyiwe ikikorhanga <optbreak/> ri ididɔsa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1"/>Abi itser Uyesu na abika adɔsa ra abĩ abi Uyahudiya kishoo agũ ugɛ atsen abi Uyahuda ikɛi ayɛimbɔ Arherhu-Num. <verse eid="ACT 11:1"/><verse number="2" style="v" sid="ACT 11:2"/>Nggee Ubitru aka azĩ ufã Urusharhima, abi usorhe abi Uyahuda abi imangmang azɔka unga arherhe. <verse eid="ACT 11:2"/><verse number="3" style="v" sid="ACT 11:3"/>Na agɛ, &lt;&lt;Awu use utsu ungo uzĩ ru abika ashimbɔ ru usorhe ugha ubingha nggu umbɔ?&gt;&gt;<verse eid="ACT 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 11:4"/>Mɔcɛ Ubitru atirha asɔme umbɔ uku kpengkpeng ubinkpi uku ukorhe. <verse eid="ACT 11:4"/><verse number="5" style="v" sid="ACT 11:5"/>Unga agɛ, &lt;&lt;Umum iwu ru uteu Ujopa idɛ̃ɛ̃ ifɛn-Num, ni inyã irhi. Umum inyã ubina uku ucipuwa ru nyaka atorho ukoma uwuku ugɔng aka adzeka afã nggu angbokake anaa ayurhi, aba ra anangkɛ umum iki iwe. <verse eid="ACT 11:5"/><verse number="6" style="v" sid="ACT 11:6"/>Umum iki ingbiki irhi umum inyã ijuɛ iyi adaka anaa nu ijuɛ arhum iyiki ibewe, nu iyiki ikaikai, nu anunu. <verse eid="ACT 11:6"/><verse number="7" style="v" sid="ACT 11:7"/>Mɔcɛ umum igũ urhɛm ukpɔɔ uku ugɔr umum ugɛ, &lt;A Ubitru, usisok ungwãnu utãi.&gt;<verse eid="ACT 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 11:8"/>&lt;&lt;Bɔr umum ĩgɔr ĩgɛ, &lt;Ĩ'ĩ a Uteijee! Ubinkpi uku usi isarkpɔ use utɛnkpɔ unasi itsĩkpɔ ra angwĩmum.&gt;<verse eid="ACT 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 11:9"/>&lt;&lt;Mɔcɛ urhɛm hã udzeka afã urherhe idevaa, ugɛ, &lt;Ubinkpi Unum aka asare niba ugɔrɔ ugɛ usi isarkpɔ.&gt; <verse eid="ACT 11:9"/><verse number="10" style="v" sid="ACT 11:10"/>Akɛrɛ ha akorhe idiki itaar, na ashupa abin hã afũmbɔ ra afã ikɛi.<verse eid="ACT 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 11:11"/>&lt;&lt;Ri ivang hã inera itaar umbɔ aka adene umbɔ adzeku Ukaisariya aba ru umum, adɛ̃ɛ̃ nu angwĩ iyakɛ umum iki iwe. <verse eid="ACT 11:11"/><verse number="12" style="v" sid="ACT 11:12"/>Ipfu-Num igɔr umum igɛ umum ĩdɔsa umbɔ niba icicang umum izĩ nggu umbɔ. Angwɛ̃mɛn utɔ̃ĩ hã aka azĩ nggu umum, umɛn izĩ itsĩ ri iya utsak uwurɛ. <verse eid="ACT 11:12"/><verse number="13" style="v" sid="ACT 11:13"/>Unga adɛyiwa umɛn unga aka anyã ipfu itser-Num iki idɛ̃ɛ̃ ri iyanga, ni igɔr igɛ, &lt;Udene umbɔ azĩ ayisuwa Usiman ru Ujopa uwuruwi umbɔ iki iyisa Ubitru. <verse eid="ACT 11:13"/><verse number="14" style="v" sid="ACT 11:14"/>Unga awuri iba asɔma ungo isarheyɛ ungo nu iyango kishoo aki ikpo ififɔrh.&gt;<verse eid="ACT 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 11:15"/>&lt;&lt;Umum iki itirhi arherhe, Ipfu Isarsatangge icipuwa nu atsimbɔ ru nyaka ngge iki icipuwa nu atsimɛn ri inggbaashia. <verse eid="ACT 11:15"/><verse number="16" style="v" sid="ACT 11:16"/>Mɔcɛ umum iyita Arherhu Uteijee aka agɔr agɛ, &lt;Uyohana akorhu ubɔtisima nggu amɛ̃, bɔr awuri isorhuwa umbi ubɔtisima nggu Ipfu Isarsatangge.&gt; <verse eid="ACT 11:16"/><verse number="17" style="v" sid="ACT 11:17"/>Nggee Unum aba adzowe umbɔ izũwã uku kpengkpeng ubinkpi unga aka adzaa umɛn, iki iwe ru imangmang ru Uteijee Uyesu Ukiristo, umum igburh ungamɔ umum iki ikɛn Unum?&gt;&gt;<verse eid="ACT 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18"/>Umbɔ aka agũ rimi, umbɔ asi ikpombɔ ubinkpi umbɔ aka irherhe, umbɔ akpoi Unum agɛ, &lt;&lt;Ugũ uko atsen abi Uyahuda Unum akorhuka umbɔ utsĩndĩ idzidzipa nu ikpo urhɛ.&gt;&gt;<verse eid="ACT 11:18"/></para>
  <para style="s1">Abika adɔsa ru Uantakiya</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19"/>Uver uku utsu abika adɔsa asita ri ifɛre Uistifanu abɔɔ azĩ abĩ Ufinikiya, nu aki Usayifuru, nu uteu Uantakiya, adzowe isarhe Arherhu-Num ra abi Uyahuda ukpekũ. <verse eid="ACT 11:19"/><verse number="20" style="v" sid="ACT 11:20"/>Aner Usayifuru nu Usayirin abika adɔsa azĩ Uantakiya adɛyiwe abi Uherhini, ikɛi arherha ha, adzowe umbɔ Isarhe Iyiki Ize iyi Uteijee Uyesu. <verse eid="ACT 11:20"/><verse number="21" style="v" sid="ACT 11:21"/>Ubok Uteijee uwu nggu umbɔ, anera arhɛrhɛ ikɛi awe ru imangmang na adzipa awe abi Uteijee.<verse eid="ACT 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22"/>Isarhe ubinkpi uku ikorhe ru Uantakiya izĩ itsĩngge ra ato abika adɔsa aka awe ru Urusharhima, umbɔ adene Ubarnaba azĩã ru Uantakiya. <verse eid="ACT 11:22"/><verse number="23" style="v" sid="ACT 11:23"/>Unga aka azĩ atsĩ anyã imimutayɛ Unum aka ikorhuwe umbɔ, unga agɔm anggɔm na adɛyiwe umbɔ kishoo adɛ̃ɛ̃ aker nggu amɛnmbɔ ru Uteijee. <verse eid="ACT 11:23"/><verse number="24" style="v" sid="ACT 11:24"/>Ubarnaba awu uner uwuku uze, awu nggu Ipfu Isarsatangge nu imangmang, nu anera arhɛrhɛ aka aba atoma awu abi Uteijee.<verse eid="ACT 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25"/>Mɔcɛ Ubarnaba azĩ ibee Ushawurhu ru Utarsu. <verse eid="ACT 11:25"/><verse number="26" style="v" sid="ACT 11:26"/>Ivangyɛ unga aka anyã unga, unga akũna unga abanga Uantakiya. Amaa amɛka unying umbɔ Ubarnaba nggu Ushawurhu aki ikɔng nggu abika adɔsa amesuwe anera arhɛrhɛ. Awu ru Uantakiya umbɔ aka atirhi iyisa angwɛ̃ imesu Uyesu nggu itsok &lt;&lt;Abi Ukiristo.&gt;&gt;<verse eid="ACT 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27"/>Ri ivang hã abika asɔm Arherhu-Num abɔɔ aka adzeku Urusharhima aba Uantakiya. <verse eid="ACT 11:27"/><verse number="28" style="v" sid="ACT 11:28"/>Unera unying ru umbɔ, itsoka igburh Uagabu. Asok abera adɛ̃ɛ̃ na arherha arherhe ru ubok ijee Ipfu-Num. Agɛ ikpũ imerh niyɔ igɔigɔng iwuri itɛ̃rhã ru upfunga kishoo. Ikpũ imerh ha itsuifɛr ri ivangyɛ Ukarhaudiyu aka awu uyɛrhe. <verse eid="ACT 11:28"/><verse number="29" style="v" sid="ACT 11:29"/>Angwɛ̃ imesa ha, akɛki itsũwã nggu adɔkambɔ agɛ, umbɔ akɔng abin adene ake azĩ ayike abika adɔsa ru Uyahudiya, ubɛn unera ri ikernga. <verse eid="ACT 11:29"/><verse number="30" style="v" sid="ACT 11:30"/>Umbɔ akorhe rimi hã, adene izũwãmbɔ izĩ ra akakũmbɔ ru ubokmbɔ Ubarnaba nu Ushawurhu.<verse eid="ACT 11:30"/></para>
  <chapter eid="ACT 11"/>
  <chapter number="12" style="c" sid="ACT 12"/>
  <para style="s1">Idzeu Ubitru iyi igbigba ru ugborzĩ</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1"/>Ivang ha niyɔ Uyɛrhe Uhiridu aka adzui abika adɔsa abɔɔ, abee idzowe umbɔ uver. <verse eid="ACT 12:1"/><verse number="2" style="v" sid="ACT 12:2"/>Unga atsu umbɔ afɛre Uyaku ungwɛ̃mbɔ Uyohana nggu ikon iyiki ider. <verse eid="ACT 12:2"/><verse number="3" style="v" sid="ACT 12:3"/>Unga aka anyã agɛ abi Uyahuda agũibɛn ubinkpi unga aka akorhe, unga adzur Ubitru ikɛi. Akɛrɛ akorhe ri ivang Irhowa Uborodi ukpuku Usheru Uguga. <verse eid="ACT 12:3"/><verse number="4" style="v" sid="ACT 12:4"/>Umbɔ aka adzur unga amaa, unga atsuke unga ru ugborzĩ, nu ubok abi iwa usɔka nu utɔ̃ĩ umbɔ adzɛu unga inera inaa inaa. Uhiridu akaifɛrhkɔ ikũna unga azĩ ra asu anera umbɔ atsu uvaunga, Irhowa Iyiki Igar Utɔng ha iba imaangge.<verse eid="ACT 12:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 12:5"/>Nggee Ubitru aka awe ru ugborzĩ, abika adɔsa atsu amɛnmbɔ ifɛne-Num ru unga.<verse eid="ACT 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6"/>Ru untsua ha Uhiridu aka akaifɛrhkɔ agɛ ukpe uba usarkpɔ unga awuri ikũ Ubitru akũ aba avarhuwe arherhanga. Unga anu ra ateu abi iwa avaa, abope nggu inyãwã ivaa, nu abika adzɛu ugborzĩ, ikɛi abɔɔ adɛ̃ɛ̃ ra angwĩ ubã adzɛu. <verse eid="ACT 12:6"/><verse number="7" style="v" sid="ACT 12:7"/>Kanying ipfu itser Uteijee akapɛng, irhirhang irhange ugbora. Ipfu itser-Num ikwɛr Ubitru ri igbɔmnga izita unga. Igɔr igɛ, &lt;&lt;Usisok, ifetem!&gt;&gt; Inyãwã hã igarhungge ra abok Ubitru.<verse eid="ACT 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 12:8"/>Mɔcɛ ipfu itser-Num igɔr unga igɛ, &lt;&lt;Utsim atorhango, nu utsu abadakngo.&gt;&gt; Ubitru akorhe rimi hã. Ipfu itser-Num igɔr unga igɛ, &lt;&lt;Utama atorhango udɔsa umum.&gt;&gt; <verse eid="ACT 12:8"/><verse number="9" style="v" sid="ACT 12:9"/>Ubitru adɔsa unga adzek ru ugborzĩ, asi ihwɛngnga ugɛ ubinkpi ipfu itser-Num hã iki ini ikorhe uwu idzidzɛrhe, unga akaifɛrhkɔ ugɛ unga anyã irhi. <verse eid="ACT 12:9"/><verse number="10" style="v" sid="ACT 12:10"/>Umbɔ aka atɔng abi idzɛu abi inggbaashia nu abi uvaa aba ra angwĩ ufɔm utepa aka awu nggu angwĩ ubã azɔu. Angwĩ ubã atsuri nibikake, nu umbɔ adzek ra ake. Umbɔ aka azɛ̃rhã nú ider utsĩndĩã unying, kanying ipfu itser-Num hã igwirngge ri inyĩnyã Ubitru.<verse eid="ACT 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11"/>Mɔcɛ Ubitru aka atsĩ ra amɛnnga, na agɛ, &lt;&lt;Icɛrɛ umum iki ihwɛng idzidzɛrhe ugɛ, Uteijee unga adene ipfu itsernga ngge ifɔrh umum ru ubok Uhiridu, ikɛi nu kishoo iyiki ibeweyɛ anggbaashi abi Uyahuda aka abee ikorhuwa umum.&gt;&gt;<verse eid="ACT 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12"/>Ivangyɛ Ubitru aka ahwɛng akɛrɛ ha, unga azĩã ri iya Umaryamu uyisa Uyohana umbɔ iki iyisa Umarku, ra anangkɛ anera aka akɔng arhɛrhɛ anu ifɛn-Num. <verse eid="ACT 12:12"/><verse number="13" style="v" sid="ACT 12:13"/>Ubitru aka akwɛr angwĩ ufɔm ha, una igãrhã agburh Uroda asok aba irhi awu ungaa nuwi. <verse eid="ACT 12:13"/><verse number="14" style="v" sid="ACT 12:14"/>Unga aka ahwɛng urhɛm Ubitru, anggɔm anyaike unga asi itsurunga ananga unga abvui atĩ atsĩ ri iya adɛyiwe umbɔ agɛ, &lt;&lt;Ubitru uwɔ adɛ̃ɛ̃ ra angwĩ udzepurhe rɔ!&gt;&gt;<verse eid="ACT 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 12:15"/>Umbɔ agɔr unga agɛ, &lt;&lt;Ungo uku uzhɔma!&gt;&gt; Unga ana agɔr ugɛ awu Ubitru. Umbɔ agɛ, &lt;&lt;Awu ufang awu ipfu itsernga.&gt;&gt;<verse eid="ACT 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16"/>Bɔr Ubitru akpurha adɛ̃ɛ̃ ikwɛr angwĩ iya, umbɔ aka atsuri angwĩ ubã hã na anyã unga, umbɔ adzeidzeu. <verse eid="ACT 12:16"/><verse number="17" style="v" sid="ACT 12:17"/>Ubitru akorhuwe umbɔ utsara nggu uboknga umbɔ anu utata, na adɛyiwe umbɔ ikikorhe Uteijee aka akũna unga adzek ru ugborzĩ. Unga agɛ, &lt;&lt;Àka adɛyiwe Uyaku nu abika adɔsa abɔɔ abin hã.&gt;&gt; Unga agɔr rimi mɔcɛ unga adzek azĩã anang akɔɔ.<verse eid="ACT 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18"/>Ru unkpeka, idzidzuna isi iwengge ukunjiir ra abi iwa ri ifɛrhɛ ha iki ikorhe nggu Ubitru. <verse eid="ACT 12:18"/><verse number="19" style="v" sid="ACT 12:19"/>Uhiridu aka abeea unga asi ikpoa, unga arhusa abi idzɛu ha ubinkpi uku ukorhe nggu Ubitru, na atsu umbɔ afɛre umbɔ.</para>
  <para style="s1" vid="ACT 12:19">Akpe Uhiridu</para>
  <para style="p" vid="ACT 12:19">Mɔcɛ Uhiridu adzeka abĩ Uyahudiya azĩã Ukaisariya aseisa umɔ kata. <verse eid="ACT 12:19"/><verse number="20" style="v" sid="ACT 12:20"/>Uhiridu awe ri ifuw nggu aner Utaya nu abi Usidon, umbɔ asok aba akɔng ananga unying abee irherha arherhe nggu unga. Na akpo ibibema ru Ubirhatu, unggbaashi abi itser ri iya uyɛrhe, umbɔ azĩmbɔ ru uyɛrhe Uhiridu abee isei uku utɔɔ, ubinkutsu umbɔ atsu amɛnmbɔ nú abĩ iyɛrha ha na akpo ubingha.<verse eid="ACT 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 12:21"/>Unumkpi umbɔ aka ungwɛ̃ Uhiridu atsim atorhi iyɛrhanga, asei nu utarh iyɛrhe arherhe arherhe nggu anera. <verse eid="ACT 12:21"/><verse number="22" style="v" sid="ACT 12:22"/>Ikikɔnga iki igũ urhɛmnga, umbɔ atsarhi irhakmbɔ agɛ, &lt;&lt;Heee! Urhɛm unum nukpi usi iwekpɔ urhɛm unera.&gt;&gt; <verse eid="ACT 12:22"/><verse number="23" style="v" sid="ACT 12:23"/>Kanying, ipfu itser Uteijee ikwɛr unga ubinkutsu unga asi idzowuka igɔng ru Unum, adzudzi agha unga, utsɛku unga aka akpe.<verse eid="ACT 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24"/>Bɔr Arherhu-Num akpurha adɛ̃ɛ̃ ititoma na atɛ̃rhã.<verse eid="ACT 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 12:25"/>Ivangyɛ umbɔ Ubarnaba nu Ushawurhu aka amaa itsermbɔ, umbɔ abvui aba ru Urusharhima, umbɔ akũ nggu Uyohana uwuruwi umbɔ iki iyisa Umarku.<verse eid="ACT 12:25"/></para>
  <chapter eid="ACT 12"/>
  <chapter number="13" style="c" sid="ACT 13"/>
  <para style="s1">Idene usoi Ubarnaba nu Ushawurhu</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1"/>Ra abika adɔsa ru Uantakiya umɔ abika asɔm Arherhu-Num abɔɔ nu abika amesuwe awu umɔ, Ubarnaba nu Usimiyon uwuruwi umbɔ iki iyisa Uwuku Ufĩrhã, nu Urhushiyu aka adzeku Usayirin nu Umanayen uwuruwi aka awu uwɛrhɛ uyɛrhe Uhiridu udzur ri ingwɛ̃nci, nu ikɛi Ushawurhu. <verse eid="ACT 13:1"/><verse number="2" style="v" sid="ACT 13:2"/>Umbɔ aka anu idzowe igɔng Uteijee na akpem igha ubin, Ipfu Isarsatangge ha igɔr umbɔ igɛ, &lt;&lt;Àka asɛnga umum Ubarnaba, nu Ushawurhu, umbɔ awu abi itseryɛ umum iki iyisa umbɔ aka itɔ̃.&gt;&gt; <verse eid="ACT 13:2"/><verse number="3" style="v" sid="ACT 13:3"/>Umbɔ aka akpem igha ubin na afɛn-Num amaa, umbɔ atsorhuwe abok nu umbɔ na adene umbɔ azĩmbɔ.<verse eid="ACT 13:3"/></para>
  <para style="s1">Ru Usayifuru</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4"/>Ipfu Isarsatangge idene Uburhu nu Ubarnaba, umbɔ azĩmbɔ Usarhukiya, umɔ umbɔ atsĩ ukhukhɔɔ amɛ̃ azĩmbɔ Usayifuru. <verse eid="ACT 13:4"/><verse number="5" style="v" sid="ACT 13:5"/>Ivangyɛ umbɔ aka azĩ atsĩ Usarhami, umbɔ adzowe isarhe Arherhu-Num ra abã ifɛn-Num aki abi Uyahuda. Uyohana, umbɔ iki iyisa Umarku, awu nggu umbɔ anu iyike umbɔ ri itser.<verse eid="ACT 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6"/>Umbɔ aka azɛ̃rhã amaa umpfũwã hã kishoo aba atsĩ Upafo, umɔ umbɔ aka agbopu utsa Uyahudiya uwɔɔ uner igoka uwuku usɔm Arherhu-Num igbɛrangwĩ itsoka igburh Ubar-Joshuwa, <verse eid="ACT 13:6"/><verse number="7" style="v" sid="ACT 13:7"/>uwuruwi aka awu nggu ugomna Usarjiyu Uburhu, unga awu uner itsoi. Ugomna ayisu Ubarnaba nu Ushawurhu abee igũ Arherhu-Num. <verse eid="ACT 13:7"/><verse number="8" style="v" sid="ACT 13:8"/>Bɔr uner igoka ha Uarhima, itsoknga rikɔ ri idũ abi Uherhini, awe ri igamtsa nggu Ushawurhu nu Ubarnaba, abee ikɛn ugomna utsur unga adzowuka imangmang. <verse eid="ACT 13:8"/><verse number="9" style="v" sid="ACT 13:9"/>Mɔcɛ Ushawurhu, uwu umbɔ iki iyisa Uburhu, awu nggu Ipfu Isarsatangge, atsu asunga arhi Uarhima, <verse eid="ACT 13:9"/><verse number="10" style="v" sid="ACT 13:10"/>na agɛ, &lt;&lt;Ungo uwu ungwɛ̃ Undenggũ unggamtsak kishoo abin akika aze. Ungo uwu nggu ikpũ igbɛrangwĩ iyiki ibewe ukpekũ. Ungo udɛ̃ɛ̃ idzipu atsĩndĩ idzidzɛrhe uwu Uteijee umgbɔ uwu igbɛrangwĩ! <verse eid="ACT 13:10"/><verse number="11" style="v" sid="ACT 13:11"/>Icɛrɛ ubok Uteijee uwe ri igamtsa nggu ungo. Ungo uwuri iwu uner itapa, ungo usi ínyãɔ irhirhang ishaa unum ri ivanga.&gt;&gt;</para>
  <para style="p" vid="ACT 13:11">Kanying ibur nu uzĩ utsirkpɔ unga, unga anu ibibãrhã, abee uwuruwi aka ikpɔm ubok adarh unga. <verse eid="ACT 13:11"/><verse number="12" style="v" sid="ACT 13:12"/>Ivangyɛ ugomna aka anyã abinkɛ aka akorhe, unga adzowuka imangmang, ubinkutsu unga adzeidzeu akarhãrhã ri imesa ri itsi Uteijee.<verse eid="ACT 13:12"/></para>
  <para style="s1">Ru Uantakiya aki Upisidiya</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13"/>Uburhu nu awɛrhu uzɛ̃rhãnga atsĩ ukhukhɔɔ amɛ̃ asoku Upafo azĩmbɔ Uperga ru abĩ Upamfirhiya, anangkɛ Uyohana Umarku aka abɔre umbɔ na abvui azĩã Urusharhima. <verse eid="ACT 13:13"/><verse number="14" style="v" sid="ACT 13:14"/>Asoku Uperga azĩmbɔ Uantakiya ru abĩ Upisidiya. Ru unum ukpuku uwoshambɔ atsĩ ru ubã ifɛn-Num asei. <verse eid="ACT 13:14"/><verse number="15" style="v" sid="ACT 13:15"/>Umbɔ aka amaa ivarhe ubvur Íkpem Umusa nu abvur abika asɔm Arherhu-Num, anggbaashi ubã ifɛn-Num hã adene itser ru umbɔ agɛ, &lt;&lt;Umbi angwɛ̃mɛn, umbi aba awembi ri irhɛm iyiki ififitayɛ umbi aka idzowe anera, umbi ama arherhe.&gt;&gt;<verse eid="ACT 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 13:16"/>Uburhu aka abera adɛ̃ɛ̃, aberu uboknga na atirha arherhe agɛ, &lt;&lt;Umbi abimɛn abi Uisrairha, nu atsen abi Uyahuda nu abi iwei Unum, àka akpeto ru umum! <verse eid="ACT 13:16"/><verse number="17" style="v" sid="ACT 13:17"/>Unum uwu aner Uisrairha unga asɛng atokamɛn, aberuwe umbɔ ri ivangyɛ umbɔ aka awu ra abĩ Umasar, unga akũna umbɔ adzek umɔ nggu ijee iyiki igɔng. <verse eid="ACT 13:17"/><verse number="18" style="v" sid="ACT 13:18"/>Abima nggu umbɔ imɛka isɔka inaa ra arhum. <verse eid="ACT 13:18"/><verse number="19" style="v" sid="ACT 13:19"/>Unga aka amaa ivur abĩã utɔɔva ru Ukan'ana na adzowe ukam abĩmbɔ ra aner Uisrairha. <verse eid="ACT 13:19"/><verse number="20" style="v" sid="ACT 13:20"/>Akɛrɛ ha ayoke imɛka anaka anaa ni isɔka itɔ̃ɔ̃ (450).</para>
  <para style="p" vid="ACT 13:20">&lt;&lt;Akɛrɛ ha aka amaa, Unum aberuwe abɔɔ ru umbɔ awe abika atsu uvau utsɛku ivang uner uwuku usɔm Arherhu-Num Usamairha. <verse eid="ACT 13:20"/><verse number="21" style="v" sid="ACT 13:21"/>Mɔcɛ aner Uisrairha abee umbɔ atsime umbɔ uyɛrhe, Unum atsũwe Ushawurhu ungwɛ̃ Ukish, uner unang Ubanjami, uwuruwi aka awu uyɛrhe imɛka isɔka inaa. <verse eid="ACT 13:21"/><verse number="22" style="v" sid="ACT 13:22"/>Umbɔ aka atsũwe Ushawurhu, Unum atsime Udauda awu uyɛrhambɔ. Arherhu-Num ri itsi Udauda agɔr agɛ, &lt;Umum ikpo Udauda ungwɛ̃ Ujesse, awu uner ikɔkmum, unga awuri ikorha abina kishoo aki amɛnmum.&gt;<verse eid="ACT 13:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 13:23"/>&lt;&lt;Awe ru unang utsak uwurɛ Unum aka akowe abi Uisrairha uwuku ufufɔrh, Uyesu, ru nyaka unga aka abemuwe. <verse eid="ACT 13:23"/><verse number="24" style="v" sid="ACT 13:24"/>Ivangyɛ Uyesu aka aba Uyohana aka adzowuka abi Uisrairha kishoo isarhe idzidzipa nu isorhu ubɔtisima. <verse eid="ACT 13:24"/><verse number="25" style="v" sid="ACT 13:25"/>Ivangyɛ itser Uyohana iki iyo imimaa, unga agɛ, &lt;Umbi akaifɛrhkɔ ugɛ umum iwu ungamɔ? Umum isi iwemum unga hã. Ĩ'ĩ. Bɔr uwɔɔ ruwɔ aka iba ru undzingmum, uwuruwi arhi abadaknga umum isi ímɛ̃mum igarhuwe ake.&gt;<verse eid="ACT 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26"/>&lt;&lt;Umbi abimɛn, anang Uibrahim, nu atsen abi Uyahuda nu abi iwei Unum ru umbi, awu ru umɛn umbɔ aka adene arherhe ififɔrh akɛrɛ. <verse eid="ACT 13:26"/><verse number="27" style="v" sid="ACT 13:27"/>Aner Urusharhima nu ayɛrhambɔ, umbɔ asi ihwɛngmbɔ ugɛ unga awu Uner Uwuku Ufɔrh ha. Umbɔ ikɛi asi ihwɛngmbɔ arherhe abika asɔm Arherhu-Num umbɔ iki ivarhe ubɛn unum ukpuku uwosha. Bɔr umbɔ atsu arherhe abika asɔm Arherhu-Num atsuafɛr, ri itsu uvau akpe ru Uyesu. <verse eid="ACT 13:27"/><verse number="28" style="v" sid="ACT 13:28"/>Umbɔ aka asi ikpombɔ uvau uwuku ufɛr unga, rimi hã umbɔ ngipu Ubirhatu umbɔ afɛre unga. <verse eid="ACT 13:28"/><verse number="29" style="v" sid="ACT 13:29"/>Ikikorhambɔ iki itsuifɛr kishoo ubinkpi umbɔ aka atsɛng ri itsinga, umbɔ acipuwe unga nu igãrhãmau ucucii, adzake unga ru ughwee utarh. <verse eid="ACT 13:29"/><verse number="30" style="v" sid="ACT 13:30"/>Bɔr Unum asoyika unga ra akpe ha. <verse eid="ACT 13:30"/><verse number="31" style="v" sid="ACT 13:31"/>Inuma irhɛirhɛ unga aka adzeyiwa ra abirabɛ aka adzeku Ugarhirhi adɔsa unga azĩ Urusharhima. Abirabɛ icɛrɛ umbɔ awu idekanga ra anera.<verse eid="ACT 13:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 13:32"/>&lt;&lt;Umɛn idɛyiwa umbi Isarhe Iyiki Ize. Ubinkpi Unum aka abemuwe atokamɛn, <verse eid="ACT 13:32"/><verse number="33" style="v" sid="ACT 13:33"/>unga aka atsu ake atsuafɛr ru umɛn, angwɛ̃mbɔ, ri isoyiwe Uyesu ra akpe. Ru nyaka ngge iki itsɛng ru ubom ukpu uvaa ru Ubvur Abom igɛ,</para>
  <para style="q1" vid="ACT 13:33">&lt;&lt; &lt;Ungo uwu ungwɛ̃mum,</para>
  <para style="q2" vid="ACT 13:33">irherɛ umum iki iwu Utɛngo.&gt;<note caller="+" style="f"><char style="fr" closed="false">13.33 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="PSA 2:7">Amb 2.7</ref></char>.</note><verse eid="ACT 13:33"/></para>
  <para style="m">
    <verse number="34" style="v" sid="ACT 13:34"/>Idzidzɛrhe Unum aka asoyiwe unga ra akpe ha utsur unga avɔ̃ɔ̃, arherhe ri írhɛm iyɛrɛ agɛ,</para>
  <para style="q1" vid="ACT 13:34">&lt;&lt; &lt;Umum iwuri idzaamum umbi usarkasar ídorh iyi idzidzɛrhe umum iki ibemuwe Udauda.&gt;<note caller="+" style="f"><char style="fr" closed="false">13.34 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="ISA 55:3">Uish 55.3</ref></char>.</note><verse eid="ACT 13:34"/></para>
  <para style="m">
    <verse number="35" style="v" sid="ACT 13:35"/>Nggee unga agɔr ru ubom ukpɔɔ agɛ,</para>
  <para style="q1" vid="ACT 13:35">&lt;&lt; &lt;Ungo usi íneke Usarkasarngo avɔ̃ɔ̃.&gt;<note caller="+" style="f"><char style="fr" closed="false">13.35 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="PSA 16:10">Amb 16.10</ref></char>.</note><verse eid="ACT 13:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 13:36"/>&lt;&lt;Udauda aka amaa itseryɛ Unum aka adzowe unga ri ivangnga. Mɔcɛ unga akpea, umbɔ adzake unga nggu atokanga, iyornga ivɔ̃ngge. <verse eid="ACT 13:36"/><verse number="37" style="v" sid="ACT 13:37"/>Bɔr uwuruwi Unum aka asoyiwe unga ra akpe asi ivɔ̃ɔ̃.<verse eid="ACT 13:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 13:38"/>&lt;&lt;Umbi abimɛn, àka akpeto! Umɛn iwu nggimi ni idũwũwa umbi ugɛ atsũwe arhimmbi iwu ru ubok Uyesu. <verse eid="ACT 13:38"/><verse number="39" style="v" sid="ACT 13:39"/>Ru uboknga kishoo uwuruwi aka awe ru imangmang, umbɔ aka atsũwũkumbɔ arhimnga, akirakɛ Íkpem Umusa iki isi idɛ̃ɛ̃ itsũwũkũngge. <verse eid="ACT 13:39"/><verse number="40" style="v" sid="ACT 13:40"/>Àka angwɛ̃dzɛn utsur abin hã abvur abika asɔm Arherhu-Num aka arherhe akorhuke ru umbi. Agɔr agɛ,<verse eid="ACT 13:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41"/>&lt;&lt; &lt;Àka anyã, umbi abika ayɛi itser Unum!</para>
  <para style="q2" vid="ACT 13:41">Àka adzeidzeu na akpe,</para>
  <para style="q1" vid="ACT 13:41">umum iwuri ikorhu ubin ukpɔɔ ri inummbi,</para>
  <para style="q2" vid="ACT 13:41">ukpurukpi umbi asi ídzowukumbi imangmang,</para>
  <para style="q2" vid="ACT 13:41">ru unerwi aka idɛyiwa umbi.&gt; <note caller="+" style="f"><char style="fr" closed="false">13.41 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="HAB 1:5">Uha 1.5</ref></char>.</note>&gt;&gt;<verse eid="ACT 13:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42"/>Uburhu nu Ubarnaba aka azɛ̃rhã awuri idzidzek ru ubã ifɛn-Num hã, anera ashɔ̃rhã umbɔ ama aba arherhe arherhe ra abin hã ikɛi unum ukpuku uwosha iki iba. <verse eid="ACT 13:42"/><verse number="43" style="v" sid="ACT 13:43"/>Ivangyɛ umbɔ aka asoyiwe anera, abi Uyahuda arhɛrhɛ nu atsen abi Uyahuda aka adzipa atsĩ agbeyi abi Uyahuda adɔsu Uburhu nu Ubarnaba, nu umbɔ ikivarhambɔ adzowe umbɔ itsũwã umbɔ adɛ̃ɛ̃ aker ri imimutu Unum.<verse eid="ACT 13:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44"/>Unum ukpuku uwosha ukpɔɔ uku ukɔru uba irhɛɛ anera ru utepa idzek ikɔng inũ igosha Arherhu Uteijee. <verse eid="ACT 13:44"/><verse number="45" style="v" sid="ACT 13:45"/>Ivangyɛ abi Uyahuda aka anyã ikikɔng anera irhɛirhɛ, umbɔ agũ unyɛ̃ɛ̃ akarhãrhã, umbɔ adzuse igbɛrangwĩ nu ubinkpi Uburhu aka arherhe umbɔ atsĩmbɔ irhena unga.<verse eid="ACT 13:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="ACT 13:46"/>Mɔcɛ Uburhu nu Ubarnaba asi igũmbɔ iwei, agɔr agɛ, &lt;&lt;Umbi abi Uyahuda imɛ̃ɛ̃ngge umɛn itirhi isarhe Arherhu-Num nggu umbi. Bɔr umbi aka akpɛ̃mbi na anyanga atsimbi asi imɛ̃mbi ikpo urhɛ uwu ugbagbaa, umɛn izĩ ra atsen abi Uyahuda. <verse eid="ACT 13:46"/><verse number="47" style="v" sid="ACT 13:47"/>Ubinkutsu ubin hã nukpɔ Uteijee aka atsuka umɛn agɛ,</para>
  <para style="q1" vid="ACT 13:47">&lt;&lt; &lt;Umum iki isɛng ungo uwu irhirhang ra atsen abi Uyahuda,</para>
  <para style="q2" vid="ACT 13:47">ugɛ umbi awuri ikũ ififɔrh azĩ atsĩ ri imimashu upfung.&gt;<note caller="+" style="f"><char style="fr" closed="false">13.47 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="ISA 49:6">Uish 49.6</ref></char>.</note>&gt;&gt;<verse eid="ACT 13:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48"/>Ivangyɛ atsen abi Uyahuda aka agũ rimi, umbɔ agɔm anggɔm na akpoi Arherhu Uteijee, abirabɛ umbɔ aka asɛng umbɔ aka ikpo urhɛ uwu ugbagbaa adzowe imangmang.<verse eid="ACT 13:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="ACT 13:49"/>Arherhu Uteijee atɛ̃rhã amaake abĩã kishoo. <verse eid="ACT 13:49"/><verse number="50" style="v" sid="ACT 13:50"/>Bɔr abi Uyahuda azɔka akatsɛrh abɔɔ abi iwei Unum abirabɛ umbɔ iki isaka adzowe umbɔ igɔng na abika agɔng abɔɔ ru utepa. Asoyikumbɔ uver ru umbɔ Uburhu nu Ubarnaba, awayiwe umbɔ ru abĩmbɔ. <verse eid="ACT 13:50"/><verse number="51" style="v" sid="ACT 13:51"/>Nggee umbɔ awashuwe uzurhu adakmbɔ umgbɔ uwu utsar ikpikpɛ̃ɛ̃ ra atsi abi utepa, na azĩmbɔ Uikoniya. <verse eid="ACT 13:51"/><verse number="52" style="v" sid="ACT 13:52"/>Nu angwɛ̃ imesa agɔm akarhãrhã, awu nggu Ipfu Isarsatangge.<figure style="fig" file="ldb GPS_Paul1_B&amp;W.jpg" size="span" copy="WBT" ref="13.1—14.28">Uzɛ̃rhũ Uburhu ukpu inggbaashia</figure><verse eid="ACT 13:52"/></para>
  <chapter eid="ACT 13"/>
  <chapter number="14" style="c" sid="ACT 14"/>
  <para style="s1">Uburhu nu Ubarnaba ru Uikoniya</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1"/>Ubina unying uku ukorhe ru Uikoniya. Uburhu nu Ubarnaba aka atsĩ ru ubã ifɛn-Num abi Uyahuda. Adzowe isarhe nggu ijee ru nggaa ikikɔng anera abi Uyahuda nu Atsen abi Uyahuda awe ru imangmang. <verse eid="ACT 14:1"/><verse number="2" style="v" sid="ACT 14:2"/>Bɔr abi Uyahuda abirabɛ aka akpɛ̃ iwe ru imangmang asoyiwe amɛn atsen abi Uyahuda adakuwe amɛnmbɔ nggu umbɔ Uburhu nu Ubarnaba. <verse eid="ACT 14:2"/><verse number="3" style="v" sid="ACT 14:3"/>Bɔr abi itser Uyesu asei adãrhã umɔ, adzowe isarhe ri ikeramɛn imimuta ru Uteijee. Nu unga abemunga isarhambɔ ri idzowe umbɔ ijee umbɔ akorha abin idzeu nu abin igbigba. <verse eid="ACT 14:3"/><verse number="4" style="v" sid="ACT 14:4"/>Abi uteu ha agau agbɛra avaa, abɔɔ adɔsu undzing abi Uyahuda, abɔɔ adɔsu undzing abi itser Uyesu. <verse eid="ACT 14:4"/><verse number="5" style="v" sid="ACT 14:5"/>Mɔcɛ atsen abi Uyahuda nu abi Uyahuda atoma nggu anggbaashimbɔ abee idzowe abi itser Uyesu uver na atange umbɔ atarh. <verse eid="ACT 14:5"/><verse number="6" style="v" sid="ACT 14:6"/>Ivangyɛ abi itser Uyesu aka agũ rimi, umbɔ atĩ azĩmbɔ iteu Urhistira nu Udarbe ru Urhikoniya nu ikãwãngge. <verse eid="ACT 14:6"/><verse number="7" style="v" sid="ACT 14:7"/>Umɔ umbɔ adɛ̃ɛ̃mbɔ idzowe Isarhe Iyiki Ize.<verse eid="ACT 14:7"/></para>
  <para style="s1">Uburhu nu Ubarnaba ru Urhistira nu Udarbe</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8"/>Ru Urhistira unera nuwɔ awu ukatarhu, amar unga ukatarhu anasi izɛ̃rhũnga uzɛ̃rhã. <verse eid="ACT 14:8"/><verse number="9" style="v" sid="ACT 14:9"/>Unga agũshu isarhe Uburhu. Uburhu atsu asu nu unga, anyã imangmangnga imɛ̃ngge umbɔ akerhuwe unga, <verse eid="ACT 14:9"/><verse number="10" style="v" sid="ACT 14:10"/>na atsarhi irhaknga agɛ, &lt;&lt;Usisok udɛ̃ɛ̃ nu adakngo!&gt;&gt; Ukatarhu ha ater isha atirhunga uzɛ̃rhã.<verse eid="ACT 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 14:11"/>Ivangyɛ ikikɔnga iki inyã ubinkpi Uburhu aka akorhe, umbɔ atsarhi irhakmbɔ ivanga unying arherhe ri idũ Urhikoniya agɛ, &lt;&lt;Anum acipuwambɔ ru umɛn ru asaka anera!&gt;&gt; <verse eid="ACT 14:11"/><verse number="12" style="v" sid="ACT 14:12"/>Umbɔ atar itsok Ubarnaba agɛ Uzeyu, Uburhu umbɔ atare unga agburh Uherme, ubinkutsu unga awu uyɛrhe arherha ha. <verse eid="ACT 14:12"/><verse number="13" style="v" sid="ACT 14:13"/>Uwuku udzowe idɛm-Zeyu, uwuruwi ugbor ishiyanga uku uwu ra awiya ukhapa ru utepa, akũ ínak iyiki itsak nu ífur akũ aba ra angwĩ utepa ubinkutsu unga nu anera arhɛrhɛ abee idzowe idɛm ru abi itser Uyesu.<verse eid="ACT 14:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14"/>Bɔr abi itser Uyesu Ubarnaba nu Uburhu aka agũ rimi, amɛnmbɔ aghong umbɔ avapuwe atorhambɔ na atĩ atsĩ ri ikikɔnga, atsarhi irhakmbɔ atsu ivum agɛ, <verse eid="ACT 14:14"/><verse number="15" style="v" sid="ACT 14:15"/>&lt;&lt;Umbi anera, awu use utsu umbi akorhe rimi hã? Umɛn ikpurhi iwu anera, ru nyaka umbi. Umɛn ikũ Isarhe Iyiki Ize ikũwã umbi, idɛyiwa umbi idzidzipa ra abin aka atãrhã akɛrɛ na awe abi Unum uwu urhɛ, uwuruwi aka amuna afã nu abĩ, nu akau akagɔng, nu kishoo abinkɛ aka awe ra ake. <verse eid="ACT 14:15"/><verse number="16" style="v" sid="ACT 14:16"/>Ivang iyi isha, unga aneke abĩã kishoo azɛ̃rhã ru udĩkpi umbɔ aka abee. <verse eid="ACT 14:16"/><verse number="17" style="v" sid="ACT 14:17"/>Bɔr unga asi inekuka idɛyiwe ugɛ unga awu umɔ ri ikorhe abin aka aze ra anera. Unga acorhuwa umɛn ri idzaa inai ra afã nu abingha, adzaa umbi ubingha umbi agha, na atsu umbi agɔm anggɔm ra amɛnmbi.&gt;&gt; <verse eid="ACT 14:17"/><verse number="18" style="v" sid="ACT 14:18"/>Uko nggu arherha akɛrɛ umbɔ agũ uver kata na akɛn anera abɛrɛ ikorhuwe umbɔ idɛm.<verse eid="ACT 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19"/>Mɔcɛ abi Uyahuda abɔɔ adzeku Uantakiya nu Uikoniya aba adzipa amɛn ikikɔnga. Umbɔ atang atarh nu Uburhu na adɔ̃rhã unga azĩmbɔ ru undzing utepa, akaifɛrhkɔ agɛ unga aka akpea. <verse eid="ACT 14:19"/><verse number="20" style="v" sid="ACT 14:20"/>Bɔr angwɛ̃ imesa aka akɔng akan adziira unga, unga asoka na azɛ̃rhã atsĩã ru utepa. Unum uvaa unga nu Ubarnaba azĩmbɔ Udarbe.<verse eid="ACT 14:20"/></para>
  <para style="s1">Ibvui iba Uantakiya aki Usuriya</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21"/>Umbɔ adzowe Isarhe Iyiki Ize ru utepa na akpo angwɛ̃ imesa arhɛrhɛ. Mɔcɛ umbɔ abvui azĩmbɔ Urhistira, nu Uikoniya nu Uantakiya aki Upisidiya, <verse eid="ACT 14:21"/><verse number="22" style="v" sid="ACT 14:22"/>afituwe angwɛ̃ imesa ha umbɔ adɛ̃ɛ̃ aker ri imangmangmbɔ hã. Agɔr agɛ, &lt;&lt;Awu ufang umɛn iki ihwa uver urhɛrhɛ ni idɔrhi ikpo itsĩ Iyɛrhe Unum.&gt;&gt; <verse eid="ACT 14:22"/><verse number="23" style="v" sid="ACT 14:23"/>Uburhu nu Ubarnaba asɛnge umbɔ akakũ ukpui abika adɔsa, nggu ikpem igha ubin nu ifɛn-Num umbɔ aka ayɛruwe umbɔ ru Uteijee, uwuruwi umbɔ aka awe ri imangmang ru unga. <verse eid="ACT 14:23"/><verse number="24" style="v" sid="ACT 14:24"/>Amaa uzɛ̃rhã adɔsa udika abĩ Upisidiya, aba atsĩ abĩ Upamfirhiya, <verse eid="ACT 14:24"/><verse number="25" style="v" sid="ACT 14:25"/>umbɔ aka adũwã Arherhu-Num ru Uperga, mɔcɛ umbɔ azĩmbɔ Uatarhiya.<verse eid="ACT 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 14:26"/>Adzeku Uatarhiya atsĩ ukhukhɔɔ amɛ̃ abvui azĩmbɔ Uantakiya, anangkɛ umbɔ aka abee iwembɔ imimutu Unum ri itseryɛ umbɔ aka atɔ̃ amaa. <verse eid="ACT 14:26"/><verse number="27" style="v" sid="ACT 14:27"/>Umbɔ aka azĩ atsĩ Uantakiya, umbɔ akɔng abika adɔsa asɔme kishoo ubinkpi Unum aka akorhe ru ubokmbɔ nu amɛnkɛ umbɔ aka atsuruwe utsĩndĩ imangmang ra atsen abi Uyahuda igambɔ. <verse eid="ACT 14:27"/><verse number="28" style="v" sid="ACT 14:28"/>Umbɔ asei adermbɔ ru nggɔɔ ha nggu angwɛ̃ imesa.<verse eid="ACT 14:28"/></para>
  <chapter eid="ACT 14"/>
  <chapter number="15" style="c" sid="ACT 15"/>
  <para style="s1">Abi udzepurhe Urusharhima</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1"/>Aner abɔɔ adzeku Uyahudiya aba ru Uantakiya anu imesuwe abika adɔsa agɛ, &lt;&lt;Umbɔ aba asi isorhuwambɔ umbi usorhe ru nyaki Íkpem Umusa iki iwe, umbi asi íkpombi ififɔrh.&gt;&gt; <verse eid="ACT 15:1"/><verse number="2" style="v" sid="ACT 15:2"/>Awu uning akarhãrhã umbɔ Uburhu nu Ubarnaba aka akorhe nggu aner ha ra arherhe akɛrɛ. Nggee umbɔ asɛng umbɔ Uburhu nu Ubarnaba nu abɔɔ umbɔ azĩ Urusharhima ra abi itser Uyesu nu akakũ abika adɔsa ri itsi arherhe ha. <verse eid="ACT 15:2"/><verse number="3" style="v" sid="ACT 15:3"/>Abika adɔsa ha azĩ adene umbɔ azĩmbɔ, na adɔsa udika abĩ Ufinikiya nu aki Usamariya, umbɔ asɔm arherhe atsen abi Uyahuda aka adzipa azĩ ru Unum. Arherha akɛrɛ atsu abika adɔsa kishoo agɔm anggɔm akarhãrhã. <verse eid="ACT 15:3"/><verse number="4" style="v" sid="ACT 15:4"/>Ivangyɛ umbɔ aka azĩ atsĩ Urusharhima, abika adɔsa nu abi itser Uyesu nu akakũ ayɛi umbɔ, Uburhu nu Ubarnaba asɔme umbɔ kishoo ubinkpi Unum aka akorhe ra abokmbɔ.<verse eid="ACT 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 15:5"/>Bɔr abika adɔsa abɔɔ abika awu ru ugbɛr uwu abi Ufarisi asok adɛ̃ɛ̃ na agɛ, &lt;&lt;Awu ufang abi imangmang ra atsen umbɔ asorhuwe umbɔ usorhe na adɔsi Íkpem Umusa.&gt;&gt;<verse eid="ACT 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6"/>Abi itser Uyesu na akakũ akɔng arherha arherhe ri itsi arherhe ha. <verse eid="ACT 15:6"/><verse number="7" style="v" sid="ACT 15:7"/>Umbɔ aka amaa uning akarhãrhã, mɔcɛ Ubitru asok adɛ̃ɛ̃ na agɔr umbɔ agɛ, &lt;&lt;Umbi angwɛ̃mɛn, umbi ahwɛngmbi rimɔ̃ɔ̃ Unum asɛng umum ru umbi agɛ atsen abi Uyahuda agũ Isarhe Iyiki Ize ru ubokmum na awe ru imangmang. <verse eid="ACT 15:7"/><verse number="8" style="v" sid="ACT 15:8"/>Unum aka ahwɛng amɛn anera, adeyiwa agɛ unga aka ayɛisa umbɔ ri idzowe umbɔ Ipfu Isarsatangge ru nyaka unga aka adzaa umɛn. <verse eid="ACT 15:8"/><verse number="9" style="v" sid="ACT 15:9"/>Unga asi iyotunga ugɛ umɛn iwiwemɛn nggu umbɔ unga asaruka amɛnmbɔ ri imangmangmbɔ. <verse eid="ACT 15:9"/><verse number="10" style="v" sid="ACT 15:10"/>Nggee, awu use utsu umbi anu iviru Unum ri itsorhuwe abin aka amor ru atsi angwɛ̃ imesa abɛrɛ umɛn nu atesmɛn iki isi idɛ̃ɛ̃ itsãmɛn? <verse eid="ACT 15:10"/><verse number="11" style="v" sid="ACT 15:11"/>Ĩ'ĩ! Umɛn ihwɛng ugɛ awu imimuta Uteijee Uyesu ngge inu ifɔrha umɛn, ru nyaka ngge iki ifɔrhe umbɔ.&gt;&gt;<verse eid="ACT 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12"/>Kishoo ikikɔng anera inũ ukutata na akpeto ru Ubarnaba nu Uburhu umbɔ aka asɔme umbɔ abin idzeu nu igbigbayɛ Unum aka akorhuwe atsen abi Uyahuda ru ubokmbɔ. <verse eid="ACT 15:12"/><verse number="13" style="v" sid="ACT 15:13"/>Ivangyɛ umbɔ aka amaa arherhe ha, Uyaku agɛ, &lt;&lt;Umbi angwɛ̃mɛn, aka akpeto ru umum. <verse eid="ACT 15:13"/><verse number="14" style="v" sid="ACT 15:14"/>Usiman asɔma umɛn ikikorhu Unum unga aka atirha asɛng abɔɔ ra atsen abi Uyahuda umbɔ awu abinga. <verse eid="ACT 15:14"/><verse number="15" style="v" sid="ACT 15:15"/>Akɛrɛ ha awu uku kpengkpeng nggu arherhe abika asɔm Arherhu-Num. Umbɔ aka atsɛng agɛ,<verse eid="ACT 15:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16"/>&lt;&lt; &lt;Akɛrɛ ha aka imaa umum ibvui ĩbamum</para>
  <para style="q2" vid="ACT 15:16">iba idzin utsurha Udauda uku ugba.</para>
  <para style="q1" vid="ACT 15:16">Umum ibvui iberukũ igbigbangge,</para>
  <para style="q2" vid="ACT 15:16">umum ibvui itarukũ.<verse eid="ACT 15:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17"/>Nggee anera abika abɔr aka ibeea umum Uteijee,</para>
  <para style="q2" vid="ACT 15:17">nu kishoo atsen abi Uyahuda umum iki isɛng umbɔ awu abimum.&gt;</para>
  <para style="q1" vid="ACT 15:17">Awu Uteijee uwuku ukorha abin hã arherhe arherhe akɛrɛ.<verse eid="ACT 15:17"/></para>
  <para style="q2">
    <verse number="18" style="v" sid="ACT 15:18"/>Ahwɛngmbɔ akɛrɛ ha ishaisha.<verse eid="ACT 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19"/>&lt;&lt;Nggee, aba awu inyĩnyãmum, isi imɛ̃ngge umɛn ipare atsen abi Uyahuda abika adzipa aba udiku Unum. <verse eid="ACT 15:19"/><verse number="20" style="v" sid="ACT 15:20"/>Bɔr umɛn itsɛnge umbɔ ubvur isɔme umbɔ niba aghambɔ ubinkpi umbɔ aka ayɛruwe ru ugberhe, use itoma-dak, nu atãi ijuɛyɛ umbɔ aka ashĩrhũwe urhɔka, use atãi adzirh. <verse eid="ACT 15:20"/><verse number="21" style="v" sid="ACT 15:21"/>Ubinkutsu aka avarhukumbɔ Íkpem Umusa ru ubɛn utepa ishaisha, na avarhumbɔ ra abã ifɛn-Nummbɔ ubɛn unum ukpuku uwosha.&gt;&gt;<verse eid="ACT 15:21"/></para>
  <para style="s1">Ubvur akakũ uzĩ ru atsen abika adzipa</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22"/>Mɔcɛ abi itser Uyesu nggu akakũ nu kishoo abika adɔsa, anyã azea umbɔ asɛng anera ra adɔkambɔ adene umbɔ azĩ Uantakiya nggu Uburhu nu Ubarnaba. Umbɔ asɛng Uyahuda uwu umbɔ iki iyisa Ubarsabba, nu Usirha, ikivarhambɔ aka awu anggbaashi ra abika adɔsa. <verse eid="ACT 15:22"/><verse number="23" style="v" sid="ACT 15:23"/>Nggu umbɔ adene ubvur uwurɛ uwu utsɛng ugɛ,</para>
  <para style="pmo" vid="ACT 15:23">Abi itser Uyesu nu akakũ abika adɔsa, angwɛ̃mbi,</para>
  <para style="pmo" vid="ACT 15:23">Uzĩ ra abika adɔsa atsen abi Uyahuda ru Uantakiya, ra abĩ Usuriya nu aki Ukirhikiya,</para>
  <para style="pmo" vid="ACT 15:23">Ighwe.<verse eid="ACT 15:23"/></para>
  <para style="pm">
    <verse number="24" style="v" sid="ACT 15:24"/>Umɛn igũ abɔɔ adzeku umɛn asoyiwa amɛnmbi nggu arherhambɔ, adzunuwa umbi nggu ubinkpi umbɔ iki irherhe, asi iwea umɛn idene umbɔ. <verse eid="ACT 15:24"/><verse number="25" style="v" sid="ACT 15:25"/>Nggee umɛn iki ibema ni inyã azea umɛn isɛng abɔɔ idene umbɔ aba ru umbi nggu awɛrhamɛn umbɔ Ubarnaba nggu Uburhu, <verse eid="ACT 15:25"/><verse number="26" style="v" sid="ACT 15:26"/>abirabɛ aka adzowe urhɛmbɔ ri itsok Uteijeemɛn Uyesu Ukiristo ha. <verse eid="ACT 15:26"/><verse number="27" style="v" sid="ACT 15:27"/>Nggee umɛn idene umbɔ Uyahuda nggu Usirha aba ru umbi asɔma umbi abin hã ra angwĩmbɔ umɛn iki itsɛng. <verse eid="ACT 15:27"/><verse number="28" style="v" sid="ACT 15:28"/>Ipfu Isarsatangge nu umɛn inyã azea umɛn niba itsukamɛn umbi imoryɛ iki inangngge umbi, umɛn ikpurhi isɔma umbi abinkɛ aka awu ufang. <verse eid="ACT 15:28"/><verse number="29" style="v" sid="ACT 15:29"/>Umbi niba aghambi ubinkpi umbɔ aka ayɛruwe nu agberhe, use atãi ijuɛyɛ umbɔ aka ashĩrhũwe urhɔka, use itãi adzirh, use itoma-dak. Umbi aba atsammbi atsimbi ra abin akɛrɛ, umbi akorhe iyiki ize nukpɔ.</para>
  <para style="p" vid="ACT 15:29">Aka azĩ uku utɔɔ.<verse eid="ACT 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30"/>Umbɔ adene umbɔ itser ha abvui azĩmbɔ Uantakiya, anangkɛ umbɔ aka akɔng abika adɔsa adzowe umbɔ ubvur ha. <verse eid="ACT 15:30"/><verse number="31" style="v" sid="ACT 15:31"/>Ivangyɛ anera aka avarhu ubvur ha, umbɔ agɔm anggɔm nggu itɛnamɛn nu arherhe ififitayɛ umbɔ aka avarhe. <verse eid="ACT 15:31"/><verse number="32" style="v" sid="ACT 15:32"/>Uyahuda nu Usirha, umbɔ awu abika asɔm Arherhu-Num, arherha arherhe ififita na afituwe abika adɔsa nggu irhɛm arherhe. <verse eid="ACT 15:32"/><verse number="33" style="v" sid="ACT 15:33"/>Umbɔ aka amaa ivang iyɔɔ umɔ, umbɔ adene abika adɔsa azĩ nggu igũibɛn iyi ididɔɔr ra abirabɛ aka adene umbɔ.<note caller="+" style="f"><char style="fr" closed="false">15.33 </char><char style="ft" closed="false">Abvur akɔɔ aki itsɛng abok aki isha agɔrke ikɛi ugɛ, </char><char style="fv" closed="false">34 </char><char style="fqa" closed="false">bɔr Usirha abee idɛ̃ɛ̃ umɔ.</char></note> <verse eid="ACT 15:33"/><verse number="35" style="v" sid="ACT 15:35"/>Uburhu nu Ubarnaba asei adãrhũmbɔ ivang ru Uantakiya nu aner abɔɔ arhɛrhɛ aka amesuwe na adzowe isarhe Arherhu Uteijee.<verse eid="ACT 15:35"/></para>
  <para style="s1">Igigau Uburhu nu Ubarnaba</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36"/>Ivanga ukunjiir iki itɔng Uburhu agɔr Ubarnaba agɛ, &lt;&lt;Uba umɛn izĩmɛn ubɛn iteuyɛ umɛn iki idzowe isarhe Arherhu Uteijee izĩ iyepa angwɛ̃mɛn nu anapumɛn, ni inyãni ubinkpi umbɔ iki ikorhe.&gt;&gt; <verse eid="ACT 15:36"/><verse number="37" style="v" sid="ACT 15:37"/>Ubarnaba abee ikũ nggu Uyohana, umbɔ iki iyisa Umarku, umbɔ azĩ urhɔnga. <verse eid="ACT 15:37"/><verse number="38" style="v" sid="ACT 15:38"/>Bɔr Uburhu asi ikaifɛrhkɔ ugɛ izengge umbɔ akũna unga, ubinkutsu, unga asi idɛ̃ɛ̃nga nggu umbɔ ri itser ru Upamfirhiya. <verse eid="ACT 15:38"/><verse number="39" style="v" sid="ACT 15:39"/>Uning igigau utsotsoramgbɔ, utsu umbɔ agaumbɔ. Ubarnaba akũ Umarku umbɔ atsĩ ukhukhɔɔ amɛ̃ azĩmbɔ Usayifuru. <verse eid="ACT 15:39"/><verse number="40" style="v" sid="ACT 15:40"/>Bɔr Uburhu asɛng Usirha umbɔ azĩmbɔ, abika adɔsa afɛne umbɔ Uteijee unga atsu imimutanga idzɛu umbɔ. <verse eid="ACT 15:40"/><verse number="41" style="v" sid="ACT 15:41"/>Unga adɔsa udika abĩ Usuriya nu aki Ukirhikiya, afita abika adɔsa. <figure style="fig" alt="Paul 2" file="ldb GPS_Paul2_B&amp;W.jpg" size="span" copy="WBT" ref="15.36—18.22">Uzɛ̃rhũ Uburhu ukpu uvaa</figure><verse eid="ACT 15:41"/></para>
  <chapter eid="ACT 15"/>
  <chapter number="16" style="c" sid="ACT 16"/>
  <para style="s1">Utimoti agbopu Uburhu nu Usirha</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1"/>Uburhu agbaashia aba Udarbe mɔcɛ na azĩ uteu Urhistira, anangkɛ ungwɛ̃ imesa uwɔɔ itsoka igburh Utimoti. Uyanga awu una Uyahudiya uwuku ududɔsa, bɔr utɛnga awu utsa Uherhini. <verse eid="ACT 16:1"/><verse number="2" style="v" sid="ACT 16:2"/>Abika adɔsa ru Urhistira nu Uikoniya arherhi iyiki ize ri itsinga. <verse eid="ACT 16:2"/><verse number="3" style="v" sid="ACT 16:3"/>Uburhu abee ikũ unga azĩ uzɛ̃rhã, nggee unga atsu umbɔ asorhuwe unga usorhe, ubinkutsu abi Uyahuda abi anang hã kishoo ahwɛngmbɔ utɛ Utimoti awu utsa Uherhini. <verse eid="ACT 16:3"/><verse number="4" style="v" sid="ACT 16:4"/>Umbɔ aka azɛ̃rhã atsĩrhĩ iteu, anu idɛyiwe anera abinkɛ abi itser Uyesu nu akakũ ru Urusharhima, adɛyiwe abika adɔsa, adɔsa ake. <verse eid="ACT 16:4"/><verse number="5" style="v" sid="ACT 16:5"/>Ngge itsu abika adɔsa atoma awu akerketambɔ ri imangmang, nu irhɛmbɔ inũ ititoma ubɛn unuma.<verse eid="ACT 16:5"/></para>
  <para style="s1">Uburhu anyã izĩ Umakidoniya ri irhi</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6"/>Uburhu nu awɛrhu uzɛ̃rhãnga azĩ udika abĩ Ufirijiya na aki Ugarhatiya, ubinkutsu Ipfu Isarsatangge ikɛnngge umbɔ idzowe isarhe Uteijee ru abĩ Uasiya. <verse eid="ACT 16:6"/><verse number="7" style="v" sid="ACT 16:7"/>Ivangyɛ umbɔ aka aba atsĩ nu atsom abĩ Umisiya, umbɔ abee izĩ abĩ Ubitiniya, bɔr Ipfu Uyesu ikɛnngge umbɔ. <verse eid="ACT 16:7"/><verse number="8" style="v" sid="ACT 16:8"/>Nggee umbɔ adɔsa udika abĩ Umisiya acipa azĩmbɔ uteu Utoruwa. <verse eid="ACT 16:8"/><verse number="9" style="v" sid="ACT 16:9"/>Nu untsuuka Uburhu anyã irhi uner abĩ Umakidoniya aka adɛ̃ɛ̃ na ashɔ̃rhã unga agɛ, &lt;&lt;Uma uba Umakidoniya uba uyika umɛn.&gt;&gt; <verse eid="ACT 16:9"/><verse number="10" style="v" sid="ACT 16:10"/>Uburhu aka anyã irhi ha, kanying umɛn ingbika abinmɛn izĩmɛn Umakidoniya, ubinkutsu umɛn inyã Unum unga ayisa umɛn idzowe Isarhe Iyiki Ize ru umbɔ.<verse eid="ACT 16:10"/></para>
  <para style="s1">Urhidiya awea ri imangmang</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11"/>Umɛn isok ru ukhukhɔɔ amɛ̃ idzeku Utoruwa uku urhirhiki izĩmɛn Usamutarkiya. Unum uvaa umɛn itsĩmɛn Uniyaforhi. <verse eid="ACT 16:11"/><verse number="12" style="v" sid="ACT 16:12"/>Umɛn idze umɔ izĩmɛn uteu Ufirhipi, ukpuku uwe anang isei abi Uroma uteu ukugɔnga ra abĩ Umakidoniya. Umɛn imaa inuma umɔ.<verse eid="ACT 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 16:13"/>Ru unum ukpuku uwosha umɛn idzeka angwĩ utepa izĩmɛn ru ubang azɛ̃, anangkɛ umɛn iki itsar ugɛ awu anang ifɛn-Num. Umɛn isei ni irherha arherhe ra akatsɛrh aka akɔng umɔ. <verse eid="ACT 16:13"/><verse number="14" style="v" sid="ACT 16:14"/>Utsɛrh uwɔɔ ra abika akpeto itsoka igburh Urhidiya, unga awu una uteu Utiyatira anu igoyiwe atorho undzuna, uwuku udzowe igɔng ru Unum. Uteijee ayanguwe amɛnnga unga akpeto ru ubinkpi Uburhu aka arherhe. <verse eid="ACT 16:14"/><verse number="15" style="v" sid="ACT 16:15"/>Ivangyɛ umbɔ aka asorhuwe unga ubɔtisima nggu aner iyanga, unga ayisa umɛn izĩ ri iyanga agɛ, &lt;&lt;Umbi aba abemumbi agɛ umum iwu uwuku uwe ru imangmang ru Uteijee, àka aba acipa ri iyamum.&gt;&gt; Unga aka agbiir amɛnmɛn umɛn ibemumɛn.<verse eid="ACT 16:15"/></para>
  <para style="s1">Agbang Uburhu nu Usirha ru ugborzĩ</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16"/>Unum ukpɔɔ umɛn izĩ ra anang ifɛn-Num ni igbopu una uwɔɔ awu ugãrhã awuri ipfu iyiki ibewe iyi irhi. Unga aka isaka akposhuwe uhwɛk ru ateiyanga akarhãrhã ri itser irhi ha. <verse eid="ACT 16:16"/><verse number="17" style="v" sid="ACT 16:17"/>Unga anu idɔsu Uburhu nu umɛn, atsu ivum, anu igɔr agɛ, &lt;&lt;Abɛrɛ awu agãrhũ Unum Uwuku Ugɔng anu idɛyiwa umbi utsĩndĩ uwuku ufɔrh.&gt;&gt; <verse eid="ACT 16:17"/><verse number="18" style="v" sid="ACT 16:18"/>Anu ikorhe rimi inuma irhɛirhɛ utsɛku Uburhu agũ avɔm, na adzipa agɔr ipfu iyiki ibewe ha agɛ, &lt;&lt;Umum itsu ungo ri itsok Uyesu Ukiristo upfudzeka ru unga!&gt;&gt; Kanying ipfu iyiki ibewe ha idzekngge ru unga.<verse eid="ACT 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19"/>Ivangyɛ ateiya una hã aka anyã utsĩndĩ ikpo uhwɛkmbɔ uku uborhmgbɔ, mɔcɛ umbɔ adzur Uburhu nu Usirha agbĩrhã umbɔ azĩmbɔ ra anang izɛɛ ra asu abi ijee. <verse eid="ACT 16:19"/><verse number="20" style="v" sid="ACT 16:20"/>Umbɔ aka akũna umbɔ azĩ ra abika atsu uvau abi Uroma na agɛ, &lt;&lt;Aner abɛrɛ awu abi Uyahuda, adɛ̃ɛ̃ isoyiwe amɛn utepmɛn. <verse eid="ACT 16:20"/><verse number="21" style="v" sid="ACT 16:21"/>Anu imesuwa agbeyakɛ aka asi imɛ̃ke ri ikpemyɛ umɛn abi Uroma iki iyɛi use umɛn ĩdɔsa.&gt;&gt;<verse eid="ACT 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 16:22"/>Anera akɔng nu atsimbɔ Uburhu nu Usirha, abika atsu uvau atsuke anera atsimuwe atorhambɔ na akwɛr umbɔ. <verse eid="ACT 16:22"/><verse number="23" style="v" sid="ACT 16:23"/>Umbɔ aka akwɛr umbɔ akarhãrhã amaa, atsuke umbɔ ru ugborzĩ, atsu uner idzɛu angwɛ̃dzɛn na adzɛu umbɔ. <verse eid="ACT 16:23"/><verse number="24" style="v" sid="ACT 16:24"/>Unga aka ayɛi itsera, unga atsuke umbɔ ru unɔrkang ugbora, atsuke adakmbɔ ru ukhɔɔ.<verse eid="ACT 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25"/>Ayoka ikɔ untsuuka Uburhu nu Usirha afɛn-Num atsusa abom ikpoi Unum, abirabɛ umbɔ aka agbange ru ugborzĩ hã akpeto ru umbɔ. <verse eid="ACT 16:25"/><verse number="26" style="v" sid="ACT 16:26"/>Kanying nggaa izizusa abĩ itsu atarh idzin ugbor uzĩ hã azusa. Kanying kishoo angwĩ ubã ugbor uzĩ atsuri, kishoo inyãwã iyiriyɛ umbɔ aka abow abi ugbora igarhe. <verse eid="ACT 16:26"/><verse number="27" style="v" sid="ACT 16:27"/>Uner adzɛu ugborzĩ hã aka azir ru urhɔ anyã angwĩ ubã agbora adɛ̃ɛ̃ iyɛm, unga awɔɔr ikonnga abee ifɛre itsinga, ubinkutsu akaifɛrhkɔ agɛ abirabɛ umbɔ aka agbange ru ugborzĩ hã aka atĩmbɔ. <verse eid="ACT 16:27"/><verse number="28" style="v" sid="ACT 16:28"/>Bɔr Uburhu atsarhi irhaknga atsu ivum agɛ, &lt;&lt;Niba unayikɔ itsingo! Umɛn abɛ kishoo iwu umɔ!&gt;&gt;<verse eid="ACT 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29"/>Uner udzɛu ugborzĩ hã agɔr umbɔ akũ irhirhang aba, mɔcɛ unga asok adɛr atsĩ azang iwei ifɛr unga atararhu ra asu Uburhu nu Usirha. <verse eid="ACT 16:29"/><verse number="30" style="v" sid="ACT 16:30"/>Mɔcɛ unga akũna umbɔ adzeka ra awiya na arhusa agɛ, &lt;&lt;Umbi anggbaashi, umum ikorhu use aka awu ufang ni ikpo ififɔrh?&gt;&gt;<verse eid="ACT 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31"/>Umbɔ agɛ, &lt;&lt;Uwe ru imangmang ru Uteijee Uyesu, ungo uwuri ikpikpoɔ ififɔrh, ungo nu abi iyango.&gt;&gt; <verse eid="ACT 16:31"/><verse number="32" style="v" sid="ACT 16:32"/>Mɔcɛ umbɔ arherhe Arherhe Uteijee asɔme unga nu abirabɛ aka awu ri iyanga kishoo. <verse eid="ACT 16:32"/><verse number="33" style="v" sid="ACT 16:33"/>Ru untsuua ha ri ivang hã uner idzɛu ugbor ha aka akũna umbɔ azĩ asorhe isɔɔmbɔ. Kanying unga nu abi iyanga kishoo asorhuwe umbɔ ubɔtisima. <verse eid="ACT 16:33"/><verse number="34" style="v" sid="ACT 16:34"/>Unga akũna umbɔ atsĩã ri iyanga akowe umbɔ ubingha. Unga nu abi iyanga kishoo agɔm anggɔm ubinkutsu umbɔ kishoo awembɔ ri imangmang ru Unum.<verse eid="ACT 16:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35"/>Ukpe uku usar, abika atsu uvau adene ambow ikow agɛ, &lt;&lt;Atsũwe aner abɛrɛ.&gt;&gt; <verse eid="ACT 16:35"/><verse number="36" style="v" sid="ACT 16:36"/>Nggee uner idzɛu ugbor ha adɛyiwe Uburhu agɛ, &lt;&lt;Abika atsu uvau agɔr agɛ atsũwe umbi. Icɛrɛ aka adzek. Azĩ uku utɔɔ.&gt;&gt;<verse eid="ACT 16:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37"/>Bɔr Uburhu agɔr uner idzɛu ugbor ha agɛ, &lt;&lt;Akwɛr umɛn ra asu anera na asi ivarhumbɔ arherhe, umɛn abɛ iwu aner Uroma, na atsuke umɛn ru ugborzĩ. Icɛrɛ umbɔ awuri itsũwe umɛn ri iwɔk? Ĩ'ĩ, rinɛɛ! Uneke umbɔ aba nibikambɔ aba atsũwe umɛn idzek.&gt;&gt;<verse eid="ACT 16:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38"/>Ambow ikow ha azĩ asɔme abika atsu uvau arherha akɛrɛ ha. Abika atsu uvau aka agũ agɛ Uburhu nu Usirha awu aner Uroma, iwei ifɛr umbɔ. <verse eid="ACT 16:38"/><verse number="39" style="v" sid="ACT 16:39"/>Nggee umbɔ aba ashɔ̃rhã umbɔ Uburhu nu Usirha, atsũwe umbɔ, na adene umbɔ adzek ru ugborzĩ, na ashɔ̃rhã umbɔ ama adzek ru utepa. <verse eid="ACT 16:39"/><verse number="40" style="v" sid="ACT 16:40"/>Ivangyɛ umbɔ Uburhu nu Usirha aka adzek ru ugborzĩ hã, umbɔ abvui azĩmbɔ ru iya Urhidiya, umɔ umbɔ aka akɔng nggu abika adɔsa na afituwe umbɔ. Mɔcɛ umbɔ abɔrukumbɔ utepa.<verse eid="ACT 16:40"/></para>
  <chapter eid="ACT 16"/>
  <chapter number="17" style="c" sid="ACT 17"/>
  <para style="s1">Uburhu nu Usirha ru Utasarhonika</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1"/>Uburhu nu Usirha aka azɛ̃rhã adɔsa udiku iteu Uamfiporhi nu Uafirhoniya, aba atsĩ uteu Utasarhonika, anangkɛ ubã ifɛn-Num abi Uyahuda uku uwe. <verse eid="ACT 17:1"/><verse number="2" style="v" sid="ACT 17:2"/>Ru nyaku Uburhu aka abayi, atsĩ ru ubã ifɛn-Num hã, inum iyiki iwiwosha itaar umbɔ aka anu irhisi itsɛng Arherhu-Num nggu umbɔ. <verse eid="ACT 17:2"/><verse number="3" style="v" sid="ACT 17:3"/>Unga anu isɔme umbɔ na adɛyiwe umbɔ idzidzɛrhe agɛ awu ufang Ukiristo aka ihwa uver na asoku udzak. Uburhu agɔr umbɔ agɛ, &lt;&lt;Uyesu ha umum iki inu indɛyiwa umbi unga awu Ukiristo.&gt;&gt; <verse eid="ACT 17:3"/><verse number="4" style="v" sid="ACT 17:4"/>Abɔɔ abi Uyahuda abemumbɔ arherhe Uburhu nu Usirha, nu arhɛrhɛ abi Uherhini abika agũ iwei Unum nu akatsɛrh akagɔng atomi itsi nggu umbɔ.<verse eid="ACT 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5"/>Bɔr abi Uyahuda abikase agũ unyɛ̃ɛ̃, umbɔ akɔng awɛ ugbau ra atsĩndĩ, umbɔ aka akɔng kishoo ahwita abi utepa. Akũ avɔm atsĩ ri iya Ujason abee Uburhu nu Usirha abee ikũna umbɔ adzeka ra anera. <verse eid="ACT 17:5"/><verse number="6" style="v" sid="ACT 17:6"/>Bɔr umbɔ aka asi inyãmbɔ umbɔ, umbɔ adarhu Ujason nu abika adɔsa abɔɔ akũna umbɔ azĩmbɔ ra asu abi ijee utepa, atsuyi ivum agɛ, &lt;&lt;Aner abɛrɛ abika asoyi amɛn ubɛn ananga ru upfung nggabɛ aka abambɔ nggimi. <verse eid="ACT 17:6"/><verse number="7" style="v" sid="ACT 17:7"/>Ujason ayɛi umbɔ akũ atsĩ ri iyanga. Kishoo akpɛ̃mbɔ idɔsi ikpem Ukaisar, anu igɔr agɛ uyɛrhe uwɔɔ, itsoknga igburh Uyesu.&gt;&gt; <verse eid="ACT 17:7"/><verse number="8" style="v" sid="ACT 17:8"/>Umbɔ aka agũ rimi, anera nu abi ijee utepa agũ avɔm akarhãrhã. <verse eid="ACT 17:8"/><verse number="9" style="v" sid="ACT 17:9"/>Mɔcɛ umbɔ atsu Ujason na anera abɔɔ afai uhwɛk na aneke umbɔ azĩmbɔ.<verse eid="ACT 17:9"/></para>
  <para style="s1">Uburhu nu Usirha ru Ubiriya</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10"/>Utsuu uku ufin abika adɔsa adene Uburhu nu Usirha azĩmbɔ Ubiriya. Umbɔ aka azĩ atsĩ umɔ, umbɔ atsĩ ru ubã ifɛn-Num abi Uyahuda. <verse eid="ACT 17:10"/><verse number="11" style="v" sid="ACT 17:11"/>Abi Ubiriya awu ra amɛn akika agũ arherhe ha anangmbɔ abi Utasarhonika, ubinkutsu ayɛi arherhe ha aboka avaa avaa. Anu itsu asumbɔ ri itsɛng Arherhu-Num ubɛn unuma abee inyã ubinkpi Uburhu aka arherhe uwu idzidzɛrhe. <verse eid="ACT 17:11"/><verse number="12" style="v" sid="ACT 17:12"/>Abi Uyahuda arhɛrhɛ awe ru imangmang, nu abi Uherhini, akatsɛrh abika agɔng nu ikɛi akatsak.<verse eid="ACT 17:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 17:13"/>Bɔr abi Uyahuda ru Utasarhonika aka agũ agɛ Uburhu adɛ̃ɛ̃ idzowe isarhe Arherhu-Num ru Ubiriya, umbɔ asok azĩmbɔ umɔ ikɛi. Umbɔ aka azĩ atsĩ, ahwita anera asoyiwe amɛnmbɔ. <verse eid="ACT 17:13"/><verse number="14" style="v" sid="ACT 17:14"/>Kanying kanying abika adɔsa akũ Uburhu azĩ ru ubang ukau azɛ̃ akagɔng, bɔr Usirha nu Utimoti aseimbɔ ru Ubiriya. <verse eid="ACT 17:14"/><verse number="15" style="v" sid="ACT 17:15"/>Abirabɛ aka azĩ adene Uburhu akũna unga azĩ atsĩmbɔ Uatina. Abvui aba akũ nggu itser Uburhu aka adene umbɔ ugɛ Usirha nu Utimoti aba akpo unga iki ifefetem.<verse eid="ACT 17:15"/></para>
  <para style="s1">Uburhu ru Uatina</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16"/>Uburhu aka adɛ̃ɛ̃ adzɛu umbɔ ru Uatina, amɛnnga aghong akarhãrhã unga aka anyã utepa nggu agberhe arhɛrhɛ. <verse eid="ACT 17:16"/><verse number="17" style="v" sid="ACT 17:17"/>Nggee unga aka isaka arherha arherhe ru ubã ifɛn-Num nggu abi Uyahuda nu abi Uherhini abɔɔ abika agũ iwei Unum, ikɛi ubɛn unuma unga iki irherha arherhe nggu abirabɛ unga iki ikpo ra anang izɛɛ. <verse eid="ACT 17:17"/><verse number="18" style="v" sid="ACT 17:18"/>Rimi hã ikɛi abi ifɛrhkɔ itsoi umbɔ iki iyisa Uabikuriya nu Usitokiya anu irherha arherhe nggu unga. Abɔɔ arhusa agɛ, &lt;&lt;Uwɛrɛ uner ugbugbewa uwurɛ abee igɔr agɛ use?&gt;&gt; Abɔɔ agɛ, &lt;&lt;Awu uner uwuku udzowe isarhe anum abɔɔ abĩ akase.&gt;&gt; Ubinkutsu umbɔ arherhe rimi Uburhu anu idzowe Isarhe Iyiki Ize iyi Uyesu, nu isok ra akpe. <verse eid="ACT 17:18"/><verse number="19" style="v" sid="ACT 17:19"/>Mɔcɛ umbɔ akũna unga azĩmbɔ udzepurhe anang ikikɔngyɛ umbɔ aki iyisa Igũ Uarasa agɔr unga agɛ, &lt;&lt;Uba udɛyiwa umɛn imesa iyiki ifa iyɛ ungo uku unu imesuwe. <verse eid="ACT 17:19"/><verse number="20" style="v" sid="ACT 17:20"/>Ungo ukũ itsen arherhe ake atsĩ ra atomɛn, umɛn ibee ihwɛng agbena.&gt;&gt; <verse eid="ACT 17:20"/><verse number="21" style="v" sid="ACT 17:21"/>Kishoo aner Uatina nu atsen abika asei umɔ, anyangi ivangmbɔ asi ikorhumbɔ ubin bɔr anu irherhe na agosha abin aka afa.<verse eid="ACT 17:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22"/>Uburhu asok adɛ̃ɛ̃ ra asu ikikɔnga, na agɛ, &lt;&lt;Umbi aner Uatina! Umum inyã umbi awu abika abema agbeyi akarhãrhã nu afɛna kishoo. <verse eid="ACT 17:22"/><verse number="23" style="v" sid="ACT 17:23"/>Ubinkutsu ivangyɛ umum iki izɛ̃rhã imaa utepa umum inyãmum abinkɛ umbi iki idzowe igɔng nu ake, ikɛi umum inyãmum ubeu idɛm anummbi nggu itsɛng iki igɔr igɛ, <char style="sc">&lt;UZĨ RU UNUMWI UMBƆ AKA ASI IHWƐNGMBƆ.&gt;</char> Ubinkpi umbi aka asi ihwɛngmbi na adzowe igɔng ru ukpɔ, awu unga umum iki inu idɛyiwa umbi.<verse eid="ACT 17:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 17:24"/>&lt;&lt;Unumwi aka amunu upfung nu kishoo abinkɛ aka awu umɔ awu Uteijee afã nu abĩ na asi iseisa ra aya-Numkɛ anera iki idzin. <verse eid="ACT 17:24"/><verse number="25" style="v" sid="ACT 17:25"/>Unga asi ibeenga anera ayike unga, asi ibeenga ubin, ubinkutsu, awu unga adzowe anera kishoo urhɛ nu uwoyi nu abina kishoo. <verse eid="ACT 17:25"/><verse number="26" style="v" sid="ACT 17:26"/>Awu ru unera unying unga aka amunu idũa kishoo, agɛ umbɔ asei ra ananga kishoo ru upfung, unga angwɛ̃ ivangyɛ umbɔ aka isei atsĩ nu inangyɛ umbɔ aka isei. <verse eid="ACT 17:26"/><verse number="27" style="v" sid="ACT 17:27"/>Unum akorhe rimi ngge itsú anera ibeea unga, na awuri ima abãrhã azĩmbɔ ru unga, na awuri ikpombɔ unga. Idzidzɛrhe, asi idera nggu ubɛn unera ru umɛn. <verse eid="ACT 17:27"/><verse number="28" style="v" sid="ACT 17:28"/>&lt;Ubinkutsu, iwu ru unga umɛn iki iwe ru urhɛ, ni izɛ̃rhã, ni ibɛk.&gt; Ru nyaka abika atsɛng ambommbi abɔɔ aki igɔr agɛ, &lt;Umɛn iwu unangnga.&gt;<verse eid="ACT 17:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 17:29"/>&lt;&lt;Ngge iki iwe ugɛ umɛn iwu unang Unum, asi imɛ̃ɛ̃ umɛn ikaifɛrhkɔ ugɛ Unum awu ru uzirhzĩ uzinarhi use uazurhfa use atarh, ubinkpi unera iki ikorhe ri itsoinga. <verse eid="ACT 17:29"/><verse number="30" style="v" sid="ACT 17:30"/>Ri iyi isha Unum asi ibeenga idzowe anera uver ihwihwɛng iki ishingge ru umbɔ, bɔr icɛrɛ unga atsu anera kishoo ubɛn ananga umbɔ adzipa. <verse eid="ACT 17:30"/><verse number="31" style="v" sid="ACT 17:31"/>Ubinkutsu unga aka angwɛ̃ɛ̃ unumkpi unga aka iba atsu uvau iyi idzidzɛrhe ru upfunga ru ubok uwɔɔ unga aka asɛng. Unga aka adɛyiwa arherhe ha iwuri iwe rimi ra anera kishoo ri isoyiwe uner ha ra akpe.&gt;&gt;<verse eid="ACT 17:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32"/>Ivangyɛ umbɔ aka agũ arherhe isisok ra akpe, abɔɔ acata, bɔr abɔɔ agɛ, &lt;&lt;Umɛn ibee ibvui igũ ubinkpi ungo uku irherhe ra arherha akɛrɛ.&gt;&gt; <verse eid="ACT 17:32"/><verse number="33" style="v" sid="ACT 17:33"/>Awu umɔ Uburhu aka abɔre umbɔ. <verse eid="ACT 17:33"/><verse number="34" style="v" sid="ACT 17:34"/>Bɔr abɔɔ ukunjiir agbopa nggu Uburhu awe abi imangmang. Ru umbɔ ha awu Udiyonisiyu, uner itser ru udzepurhe, nu utsɛrh uwɔɔ itsoka igburh Udamari, na abɔɔ nggu umbɔ.<verse eid="ACT 17:34"/></para>
  <chapter eid="ACT 17"/>
  <chapter number="18" style="c" sid="ACT 18"/>
  <para style="s1">Uburhu ru Ukorinti</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1"/>Akɛrɛ ha aka amaa, Uburhu abɔruka Uatina na azĩã Ukorinti. <verse eid="ACT 18:1"/><verse number="2" style="v" sid="ACT 18:2"/>Nggɔɔ ha unga aka agbopa nggu utsa Uyahuda uwɔɔ itsoka igburh Uakirha, unga awu uner abi abĩ Ufontu. Unga nu utsɛ̃nga Ubiriskirha anai idzeka abĩ Uitarhiya, ubinkutsu Ukarhaudiyu atsu abi Uyahuda kishoo adzembɔ ru Uroma. Uburhu azĩ inyã umbɔ. <verse eid="ACT 18:2"/><verse number="3" style="v" sid="ACT 18:3"/>Ubinkutsu itsermbɔ iwu unying iyiki isɔr utenti, mɔcɛ unga aseisa umbɔ atɔ̃ itser urhɔnga. <verse eid="ACT 18:3"/><verse number="4" style="v" sid="ACT 18:4"/>Ubɛn unum ukpuku uwosha Uburhu atsĩã arherhe ru ubã ifɛn-Num abee igbiir amɛn abi Uyahuda na Atsen abi Uyahuda.<verse eid="ACT 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5"/>Ivangyɛ umbɔ Usirha nu Utimoti aka adzeku Umakidoniya aba, Uburhu adzowe ivanga kishoo ri idzowe isarhe, adekuwe abi Uyahuda agɛ Uyesu unga awu Ukiristo. <verse eid="ACT 18:5"/><verse number="6" style="v" sid="ACT 18:6"/>Bɔr abi Uyahuda aka asi ibemumbɔ na irhena unga, unga azusu uzurhu ra atorhanga agɔr umbɔ agɛ, &lt;&lt;Adzirhmbi awu ra atsimbi! Umum ishimum ru uvau. Icɛrɛ umum iwuri izĩ ra Atsen abi Uyahuda.&gt;&gt;<verse eid="ACT 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 18:7"/>Mɔcɛ unga asok azĩã ri iya uwɔɔ itsoka igburh Utitiyu Ujustu, uwuku udzowe igɔng Unum. Iyanga iki ikhapa ru abã ifɛn-Num. <verse eid="ACT 18:7"/><verse number="8" style="v" sid="ACT 18:8"/>Ukiribu, unggbaashi ubã ifɛn-Num, awea ri imangmang ru Uteijee, unga nggu aner iyanga kishoo. Abi Ukorinti abɔɔ arhɛrhɛ aka agũ unga awembɔ ri imangmang, umbɔ akorhuwe umbɔ ubɔtisima.<verse eid="ACT 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9"/>Untsuuka nukpɔ Uteijee arherhe arherhe nggu Uburhu ru irhi agɔr unga agɛ, &lt;&lt;Niba ugũo iwei, udzowe isarhe, niba unuɔ ukutatata. <verse eid="ACT 18:9"/><verse number="10" style="v" sid="ACT 18:10"/>Ubinkutsu umum iwu nggu ungo, unera ashia aka itsu ubok akorhuwa ungo ifɛrhɛ, anermum awu arhɛrhɛ ru utepu ukpirɛ.&gt;&gt; <verse eid="ACT 18:10"/><verse number="11" style="v" sid="ACT 18:11"/>Nggee Uburhu asei umɔ amɛka nu utenga, amesuwe umbɔ Arherhu-Num.<verse eid="ACT 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12"/>Ivangyɛ Ugarhiyo aka awu unggbaashi abĩ Uakaya, abi Uyahuda agbopa atsimbɔ igamtsa nggu Uburhu akũna unga azĩmbɔ ru udzepurhe uku uvarha arherhe. <verse eid="ACT 18:12"/><verse number="13" style="v" sid="ACT 18:13"/>Agɔr agɛ, &lt;&lt;Utsak uwurɛ atsu anera adzowe igɔng ru Unum ru utsĩndĩwi Íkpem iki ikɛnngge.&gt;&gt;<verse eid="ACT 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14"/>Uburhu aka abee irherha arherhe, Ugarhiyo agɔr abi Uyahuda agɛ, &lt;&lt;Uda unga akorhu ubin ukpɔɔ uku usi izekpɔ use ukpuku ubewe ri Íkpem, umum igũmum na umbi. <verse eid="ACT 18:14"/><verse number="15" style="v" sid="ACT 18:15"/>Bɔr ngge iki iwu uning ru irhɛm, atsutsok nu Íkpemmbi, umbi aka azĩ arherhe amaa nibikambi. Umum ishimum ra amɛn aka atsu uvau ri ikpũ abin akɛrɛ.&gt;&gt; <verse eid="ACT 18:15"/><verse number="16" style="v" sid="ACT 18:16"/>Mɔcɛ unga awayika umbɔ ru udzepurhe uku uvarha arherhanga. <verse eid="ACT 18:16"/><verse number="17" style="v" sid="ACT 18:17"/>Mɔcɛ umbɔ kishoo adzur Usostanu unggbaashi ubã ifɛn-Num, akwɛre unga ugwɛɛ ru udzepurhe uku uvarha arherhe. Bɔr Ugarhiyo asi irhisa.<verse eid="ACT 18:17"/></para>
  <para style="s1">Ubiriskirha, Uakirha nu Uaporho</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18"/>Uburhu asei ru uteu Ukorinti inuma irhɛirhɛ. Na aneke abika adɔsa na atsĩ ukhukhɔɔ amɛ̃ azĩmbɔ abĩ Usuriya, umbɔ Ubiriskirha nu Uakirha azĩ urhɔnga nggu unga. Bɔr uyirhkpi unga aka ayirh utsu umbɔ akone itsinga ru uteu Ukankiriya unga adɔrha azĩ. <verse eid="ACT 18:18"/><verse number="19" style="v" sid="ACT 18:19"/>Umbɔ aka azĩ atsĩ ru Uafisa, umɔ Uburhu aka abɔre umbɔ Ubiriskirha nu Uakirha. Unga atsĩã ru ubã ifɛn-Num arherha arherhe nggu abi Uyahuda. <verse eid="ACT 18:19"/><verse number="20" style="v" sid="ACT 18:20"/>Ivangyɛ umbɔ aka ashɔ̃rhã unga ama adãrhã nggu umbɔ, unga asi ibemunga. <verse eid="ACT 18:20"/><verse number="21" style="v" sid="ACT 18:21"/>Bɔr unga aka awuri ibɔre umbɔ, unga abemuwe agɛ, &lt;&lt;Umum ibvui inbamum ru umbi Unum aba abemunga.&gt;&gt; Mɔcɛ unga atsĩ ukhukhɔɔ amɛ̃ adzeka ru Uafisa. <verse eid="ACT 18:21"/><verse number="22" style="v" sid="ACT 18:22"/>Unga aka acipa ru uteu Ukaisariya, unga afũã ighwe abika adɔsa ru Urusharhima, mɔcɛ unga acipa azĩã uteu Uantakiya.<verse eid="ACT 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 18:23"/>Unga aka adãrhã amaa ru Uantakiya, Uburhu asok atsĩrhã ra abĩ Ugarhatiya na abĩ Ufirijiya, adɔsu ititeu ayike angwɛ̃ imesa adɛ̃ɛ̃ aker.<verse eid="ACT 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24"/>Ivang hã utsa abi Uyahuda uwɔɔ itsoka igburh Uaforho, aba ru Uafisa. Unga awu uner uteu Uarhekzandiriya ru Umasar. Unga ahwɛnga arherhe afina na ahwɛng itsɛng Arherhu-Num akarhãrhã. <verse eid="ACT 18:24"/><verse number="25" style="v" sid="ACT 18:25"/>Aka amesukumbɔ unga ru utsĩndĩ Uteijee, unga aka isaka anyar asunga arherhe uku urhirhiki ri itsi Uyesu, bɔr unga akpurha ahwɛng ubɔtisima Uyohana. <verse eid="ACT 18:25"/><verse number="26" style="v" sid="ACT 18:26"/>Unga atirha adzowe isarhe nggu ikernga kishoo ru ubã ifɛn-Num. Umbɔ Ubiriskirha nu Uakirha aka agũ arherhanga, umbɔ akũna unga azĩmbɔ ri iyambɔ na atoma adɛyiwe unga utsĩndĩ Unum.<verse eid="ACT 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 18:27"/>Ivangyɛ Uaporho aka abee izĩ abĩ Uakaya, abika adɔsa afituwe unga na atsɛnge ubvur ra angwɛ̃ imesa ru Uakaya umbɔ ayɛi unga. Unga aka azĩ atsĩ umɔ unga amɛna ayike abirabɛ aka awe ru imangmang ru Unum ru ubok imimuta. <verse eid="ACT 18:27"/><verse number="28" style="v" sid="ACT 18:28"/>Ubinkutsu unga ananga abi Uyahuda ra asu anera nggu ijee arherhe akarhãrhã, adɛyiwe umbɔ ri itsɛng Arherhu-Num agɛ Uyesu unga awu Ukiristo.<figure style="fig" alt="Paul 3" file="ldb GPS_Paul3_B&amp;W.jpg" size="span" copy="WBT" ref="18.23—21.7">Uzɛ̃rhũ Uburhu ukpu untaar</figure><verse eid="ACT 18:28"/></para>
  <chapter eid="ACT 18"/>
  <chapter number="19" style="c" sid="ACT 19"/>
  <para style="s1">Uburhu ru Uafisa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1"/>Ivangyɛ Uaforho aka awu ru Ukorinti, Uburhu azɛ̃rhã ru utsĩndĩ abĩã azĩ atsĩ Uafisa, umɔ unga akpo angwɛ̃ imesa abɔɔ. <verse eid="ACT 19:1"/><verse number="2" style="v" sid="ACT 19:2"/>Arhusa umbɔ agɛ, &lt;&lt;Umbi ayɛimbi Ipfu Isarsatangge ri ivangyɛ umbi aka awuri imangmang?&gt;&gt; Umbɔ agɔr unga agɛ, &lt;&lt;Ĩ'ĩ, umɛn isi igũmɛn ugɛ Ipfu Isarsatangge iwengge.&gt;&gt;<verse eid="ACT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 19:3"/>Nggee Uburhu arhusa agɛ, &lt;&lt;Asorhuwa umbi ikpũ ubɔtisima uwukusong rimi?&gt;&gt;</para>
  <para style="p" vid="ACT 19:3">Umbɔ agɛ, &lt;&lt;Ikpũ ubɔtisima Uyohana.&gt;&gt;<verse eid="ACT 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 19:4"/>Uburhu agɛ, &lt;&lt;Ubɔtisima Uyohana uwe uwu idzidzipa. Unga adɛyiwe anera umbɔ awe ru imangmang ru uwuruwi aka iba ru undzingnga, awu unga hã awu Uyesu.&gt;&gt; <verse eid="ACT 19:4"/><verse number="5" style="v" sid="ACT 19:5"/>Umbɔ aka agũ rimi, umbɔ asorhuwe umbɔ ubɔtisima ri itsok Uteijee Uyesu. <verse eid="ACT 19:5"/><verse number="6" style="v" sid="ACT 19:6"/>Ivangyɛ Uburhu aka atsorhuwe umbɔ abok, Ipfu Isarsatangge icipuwangge nu umbɔ, umbɔ atsĩmbɔ irherha arherhe ri idũ iyikise na asɔm Arherhu-Num. <verse eid="ACT 19:6"/><verse number="7" style="v" sid="ACT 19:7"/>Umbɔ kishoo ayombɔ inera usɔkdũmɛn.<verse eid="ACT 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8"/>Uburhu atsĩ ru ubã ifɛn-Num adzowe isarhe nggu ikeramɛn afɛ̃ɛ̃ ataar, anu arherhe na agbiir amɛnmbɔ aba ra arherhe Iyɛrhe Unum. <verse eid="ACT 19:8"/><verse number="9" style="v" sid="ACT 19:9"/>Bɔr abɔɔ abi itsi iki iker akpɛ̃mbɔ iwe ru imangmang, na arherhe iyiki ibewe ru Utsĩndĩ Uteijee ra asu anera. Nggee Uburhu abɔruka umbɔ, na akũ angwɛ̃ imesa azĩ amesuwe umbɔ ubɛn unuma ru ubã imesa Utiranu. <verse eid="ACT 19:9"/><verse number="10" style="v" sid="ACT 19:10"/>Akɛrɛ ha anu ikorhe rimi utsɛku imɛka ivaa, ngge itsu kishoo abi Uyahuda nu abi Uherhini abika asei ra abĩ Uasiya agũ Arherhu Uteijee.<verse eid="ACT 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11"/>Unum anu ikorha abin idzeu akɔɔ awuweke ru ubok Uburhu, <verse eid="ACT 19:11"/><verse number="12" style="v" sid="ACT 19:12"/>utsɛku umbɔ aki ikũ ushanga atorho nu atorhi itser iyɛ iki ibanga unga akũ azĩ ru abi irhãrhã akerhe, nu ípfu iyiki ibewe ikɛi ibɔrukungge umbɔ.<verse eid="ACT 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 19:13"/>Abɔɔ abi Uyahuda abika azɛ̃rhã atsĩrhĩ iteu atsusuwe ípfu iyiki ibewe abee ikũ itsok Uteijee Uyesu akorhe rimi hã. Agɔr agɛ, &lt;&lt;Umum itsũ umbi ri itsok Uyesu, Uburhu aka adũwã, àka apfu adzek.&gt;&gt; <verse eid="ACT 19:13"/><verse number="14" style="v" sid="ACT 19:14"/>Angwɛ̃ Usikeba utɔɔva uner Uyahudiya ateiya abika adzowe idɛm-Num nuwɔ, anu ikorhe rimi hã. <verse eid="ACT 19:14"/><verse number="15" style="v" sid="ACT 19:15"/>Unuma nukpɔ ipfu iyiki ibewe igɔr umbɔ igɛ, &lt;&lt;Uyesu umum ihwɛng unga, umum ikɛi ihwɛng Uburhu, umbi awu umbɔ ungaa?&gt;&gt; <verse eid="ACT 19:15"/><verse number="16" style="v" sid="ACT 19:16"/>Mɔcɛ uner ha aka awuri ipfu iyiki ibewe ha ater isha afũã nu umbɔ atɔnga ikermbɔ kishoo. Akwɛr umbɔ adzek igbĩrhĩ ri iya ha atĩ nggu isisɔɔ.<verse eid="ACT 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 19:17"/>Ivangyɛ kishoo abi Uyahuda nu abi Uherhini abika asei ru Uafisa aka agũ ubinkpi uku ukorhe, iwei ifɛr umbɔ kishoo, umbɔ adzowe igɔng ru itsok Uteijee Uyesu. <verse eid="ACT 19:17"/><verse number="18" style="v" sid="ACT 19:18"/>Arhɛrhɛ abika awe ru imangmang aba akũ angwĩmbɔ asɔm itser iyiki ibeweyɛ umbɔ aka akorhe ru awiya. <verse eid="ACT 19:18"/><verse number="19" style="v" sid="ACT 19:19"/>Anera arhɛrhɛ abi igoka akarha abvurmbɔ akpĩĩwe ra asu anera kishoo. Uhwɛk abvur ha utsĩkpɔ íshaa imang uazurhfa anaka agɔnga isɔka itɔ̃ɔ̃ (50,000). <verse eid="ACT 19:19"/><verse number="20" style="v" sid="ACT 19:20"/>Ru utsĩndĩ hã Arherhu Uteijee aka adzek atɛ̃rhã akarhãrhã nggu ijee.<verse eid="ACT 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21"/>Akɛrɛ ha aka akorhe kishoo amaa, Uburhu abee izĩ Urusharhima, awuri izɛ̃rhã atɔng udika abĩ Umakidoniya nu aki Uakaya. Agɛ, &lt;&lt;Umum iba izĩ itsĩ imaamum nggɔɔ ha, awu ufang umum izĩ iyepa Uroma ikɛi.&gt;&gt; <verse eid="ACT 19:21"/><verse number="22" style="v" sid="ACT 19:22"/>Unga adene abika ayike unga ikivarhambɔ, Utimoti nu Uarastu, azĩmbɔ Umakidoniya, unga iganga asei ivanga ukunjiir ra abĩ Uasiya.<verse eid="ACT 19:22"/></para>
  <para style="s1">Ubvun ru Uafisa</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23"/>Ivang hã iki iyo ubvun uku ugɔng usomgbɔ ra abika adɔsu Utsĩndĩ hã. <verse eid="ACT 19:23"/><verse number="24" style="v" sid="ACT 19:24"/>Uner unai uwɔɔ itsoka igburh Udimitiriyu, uwuruwi aki ikũ uazurhfa anak azirhzĩ iya ugberhe Uartemi. Unga nu abi itsernga akposhu uhwɛk ri itsermbɔ ha akarhãrhã. <verse eid="ACT 19:24"/><verse number="25" style="v" sid="ACT 19:25"/>Unga akɔng umbɔ, nu abika atɔ̃ ikpũ itser ha, na agɛ, &lt;&lt;Umbi anermɛn, àka ahwɛng ugɛ nggu itser iyɛrɛ umɛn iki ikpo abin. <verse eid="ACT 19:25"/><verse number="26" style="v" sid="ACT 19:26"/>Umbi anyãmbi na agũmbi asi iwea ri nggimi ru uteu Uafisa ukpekũ, abĩ Uasiya kishoo abɔr ukunjiir, Uburhu uwurɛ aka igbiite amɛnmbɔ na anu igɔr agɛ anum abɛ umbɔ iki ikũ abok agbisha asi iwembɔ anum. <verse eid="ACT 19:26"/><verse number="27" style="v" sid="ACT 19:27"/>Ighighong iwe asi íwea igba abĩ itsermɛn ukpekũ, bɔr iya-num nggaa Uartemi awuri itsu ike ishike ru ugarh, nu Uartemi nibikanga, umbɔ iki idzowe igɔng ra abĩ Uasiya nu upfunga kishoo, awuri ishia ri igɔng.&gt;&gt;<verse eid="ACT 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28"/>Ivangyɛ umbɔ aka agũ rimi, avɔm afɛr umbɔ akarhãrhã, umbɔ atirhi itsarhi irhakmbɔ agɛ, &lt;&lt;Igɔng iwe nggu Uartemi aki Uafisa!&gt;&gt; <verse eid="ACT 19:28"/><verse number="29" style="v" sid="ACT 19:29"/>Kanying utepa kishoo udzunukpɔ. Agbĩrhũ Ugayu nu Uaristaku, aner Umakidoniya, abirabɛ aka awu awɛrhu uzɛ̃rhũ Uburhu. Anera kishoo atĩ azĩmbɔ ra anang ikikɔnga. <verse eid="ACT 19:29"/><verse number="30" style="v" sid="ACT 19:30"/>Uburhu abee itsĩ ra anang ikikɔnga, bɔr angwɛ̃ imesa akɛnmbɔ unga. <verse eid="ACT 19:30"/><verse number="31" style="v" sid="ACT 19:31"/>Anggbaashi abɔɔ ra abĩ Uasiya, abirabɛ aka awu awɛrhu Uburhu, adene itser ashɔ̃rhã unga agɛ unga niba atsĩã ra anang ikikɔnga.<verse eid="ACT 19:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 19:32"/>Anera aka akɔng umɔ adzunumbɔ, abɔɔ asi ihwɛngmbɔ ubinkpi uku utsu umbɔ akɔng. Abɔɔ atsarhi irhakmbɔ arherhe arherhe, abɔɔ anu irherha akimbɔ awuweke. <verse eid="ACT 19:32"/><verse number="33" style="v" sid="ACT 19:33"/>Abi Uyahuda ayiru Uarhekzanda ra asu abɔɔ ri ikikɔnga unga atsu ivum abee unga arherha arherhe. Unga aberu uboknga umbɔ anukutata ru unga ikaa itsinga ra anera. <verse eid="ACT 19:33"/><verse number="34" style="v" sid="ACT 19:34"/>Bɔr umbɔ aka ahwɛng agɛ unga awu utsa Uyahuda, umbɔ atsarhi irhakmbɔ kishoo agɛ, &lt;&lt;Igɔng iwe nggu Uartemi ukpu Uafisa.&gt;&gt; Akorhe rimi ayombɔ akara avaa.<verse eid="ACT 19:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35"/>Bɔr uner itsɛng utepa atsu umbɔ anukutata, na agɛ, &lt;&lt;Umbi aner Uafisa, upfunga kishoo usi ihwɛngkpɔ ugɛ uteu Uafisa ukpuku udzɛu iya nggaa Uartemi, nu asarkasar utarh ha uku udzeka afã uba ugba? <verse eid="ACT 19:35"/><verse number="36" style="v" sid="ACT 19:36"/>Iki isi iwengge ubin itsɛyi nggu abin akɛrɛ, imɛ̃ngge umbi adɔɔr amɛnmbi niba azangmbi. <verse eid="ACT 19:36"/><verse number="37" style="v" sid="ACT 19:37"/>Nggayɛ anerabɛ umbi aka akũ aba nggimi, asi ivɛumbɔ ivɛu ra aya-num, asi irhenumbɔ unummɛn Uartemi. <verse eid="ACT 19:37"/><verse number="38" style="v" sid="ACT 19:38"/>Bɔr Udimitiriyu nu awɛrhi itsernga aba awembɔ ru ubin ukpuku ughong amɛnmbɔ nggu ubɛn unera, udzepurhe ukpuku uvarha arherhe ukpi utsurirɛ, ikɛi abika atsu uvau, adɛ̃ɛ̃ azĩ atsumbɔ arherhe ri itsimbɔ. <verse eid="ACT 19:38"/><verse number="39" style="v" sid="ACT 19:39"/>Aba awu ubin ukpɔɔ umbi aka abee, àka ahwɛng ugɛ awuri irherha ake ru udzepurhe ukpuku uvarha arherhe. <verse eid="ACT 19:39"/><verse number="40" style="v" sid="ACT 19:40"/>Ngge iki iwe rimi, igbaigba iwe ru umɛn, ubinkutsu awuri itsumbɔ arherhamɛn ri isoyamɛn irherɛ, ni isi ídɛ̃ɛ̃ isɔmmɛn awu use utsu isoyamɛn hã. Ni isi ítsɛngamɛn awu use utsu isoyamɛn hã.&gt;&gt; <verse eid="ACT 19:40"/><verse number="41" style="v" sid="ACT 19:41"/>Unga aka arherhe rimi amaa, na asoyika ikikɔnga.<verse eid="ACT 19:41"/></para>
  <chapter eid="ACT 19"/>
  <chapter number="20" style="c" sid="ACT 20"/>
  <para style="s1">Uburhu abvui azĩ <optbreak/> Umakidoniya ru Uherha</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1"/>Ivangyɛ isoya amɛn hã iki idɔɔr, Uburhu ayisa angwɛ̃ imesa ha, unga aka amaa ifituwe umbɔ, aghwe umbɔ unuma na azĩã abĩ Umakidoniya. <verse eid="ACT 20:1"/><verse number="2" style="v" sid="ACT 20:2"/>Unga aka azɛ̃rhã ri inang hã, arherhuwe irhɛm irhɛirhɛ iyiki ififita ra anera, na amasha atsĩã abĩ Uherha. <verse eid="ACT 20:2"/><verse number="3" style="v" sid="ACT 20:3"/>Umɔ unga asei afɛ̃ɛ̃ ataar, na abee itsĩ ukhukhɔɔ amɛ̃ azĩ abĩ Usuriya, na agũ ugɛ abi Uyahuda aka adzɛu abee ikorhe iyiki ibewe nggu unga ri ivang hã, nggee unga abvui adɔsu udiku Umakidoniya. <verse eid="ACT 20:3"/><verse number="4" style="v" sid="ACT 20:4"/>Abika azĩ nggu unga awu Usopata ungwɛ̃ Upuru aka adzeku Ubiriya, Uaristaku nu Usakundu aner Utasarhonika, nu Ugayu uner Udarbe, nu Utimoti ikɛi, nu Utikiku nu Uturofimu aner abĩ Uasiya. <verse eid="ACT 20:4"/><verse number="5" style="v" sid="ACT 20:5"/>Aner abɛrɛ agbaashia asok azĩmbɔ idzɛu umɛn ru Utoruwa. <verse eid="ACT 20:5"/><verse number="6" style="v" sid="ACT 20:6"/>Bɔr umɛn itsĩ ukhukhɔɔ amɛ̃ ru Ufirhipi umbɔ aka amaa Irhowa Uborodi Ukpuku Usheru Uguga, umɛn imaa inuma itɔ̃ɔ̃ ni ikpo umbɔ ru Utoruwa. Umɔ umɛn isei inuma utɔɔva.<verse eid="ACT 20:6"/></para>
  <para style="s1">Uyutiku asok ra akpe</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7"/>Ru unum inggbaashia ri inuma utɔɔva umɛn ikɔng itsɔku uborodi. Uburhu adzowe isarhe ru umbɔ, unga abee isisok ukpe unum uvaa, adɛ̃ɛ̃ adzowe isarhe utsɛku ikɔ untsuuka. <verse eid="ACT 20:7"/><verse number="8" style="v" sid="ACT 20:8"/>Atseu irhirhang awu arhɛrhɛ ru ubã afã hã umɛn iki ikɔng. <verse eid="ACT 20:8"/><verse number="9" style="v" sid="ACT 20:9"/>Ungwɛ̃dzɛm uwɔɔ itsoknga igburh Uyutiku, asei nu angwĩ ugba, agbɛu urhɔ ri ivangyɛ Uburhu aka anu idzowe isarhe iyiki ider. Urhɔ uku unyangu Uyutiku, unga ashɔɔr ri iya afã ugbɛr uwu untaar aba agba umbɔ ashupa unga ukoma. <verse eid="ACT 20:9"/><verse number="10" style="v" sid="ACT 20:10"/>Uburhu acipuwa nu abĩ, aba agbapfu nu ungwɛ̃dzɛm hã na akarha unga awuma na agɛ, &lt;&lt;Niba agũmbi ighong. Awu nggu urhɛnga!&gt;&gt; <verse eid="ACT 20:10"/><verse number="11" style="v" sid="ACT 20:11"/>Mɔcɛ unga abvui afũã ni iya afã. Unga atsɔku uborodi, atãi, na adɛ̃ɛ̃nga arherhe utsɛku ukpe uku usar, unga azĩã. <verse eid="ACT 20:11"/><verse number="12" style="v" sid="ACT 20:12"/>Umbɔ akũ ungwɛ̃dzɛm hã azĩmbɔ nggu urhɛnga, na akpo idɔngamɛn akarhãrhã.<verse eid="ACT 20:12"/></para>
  <para style="s1">Uzɛ̃rhãmbɔ adzeku Utoruwa <optbreak/> azĩ Umirhetu</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13"/>Umɛn iso izĩmɛn ru ukhukhɔɔ amɛ̃, umɛn idzur udĩ izĩmɛn Uassu. Umɛn itsar ishupu Uburhu umɔ, ubinkutsu unga avarhe rimi ri inggbaashia, unga aka azɛ̃rhã na adak azĩ. <verse eid="ACT 20:13"/><verse number="14" style="v" sid="ACT 20:14"/>Unga aka akpo umɛn ru Uassu, umɛn ishupa unga izĩmɛn Umitirhen. <verse eid="ACT 20:14"/><verse number="15" style="v" sid="ACT 20:15"/>Unum uvaa umɛn izɛ̃rhã ru ukhukhɔɔ ĩba itɔng ifɛn Ukiyo. Unum untaar ikɛi umɛn igar izĩ Usamo, unum unaa umɛn itsĩ ru Umirhetu. <verse eid="ACT 20:15"/><verse number="16" style="v" sid="ACT 20:16"/>Uburhu asi ibeenga itsĩ ru Uafisa utsur ivanga imaangge ru Uasiya, azang abee itsĩ ru Urusharhima, ngge iba imɛ̃ngge, ru unum irhowu Upentiko. <figure style="fig" alt="Big boat with many people inside (first ship in NT)" file="lb00217b.tif" size="col" loc="20.16" copy="Louise Bass" ref="20.13">Ukhukhɔɔ amɛ̃ ukugɔng nggu anera arhɛrhɛ umɔ</figure><verse eid="ACT 20:16"/></para>
  <para style="s1">Uburhu aghwe unggbaashi <optbreak/> nu akakũ ididɔsa</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17"/>Awu ru Umirhetu, Uburhu aka ayisa akakũ ri ikikɔng abika adɔsa ru Uafisa. <verse eid="ACT 20:17"/><verse number="18" style="v" sid="ACT 20:18"/>Ivangyɛ umbɔ aka aba atsĩ, unga agɔr umbɔ agɛ, &lt;&lt;Umbi ahwɛngmbi ikpũ isiseimum ri ivanga kishoo umum iki iwu nggu umbi, udzur ru unumkpi umum iki itsĩ ra abĩ Uasiya. <verse eid="ACT 20:18"/><verse number="19" style="v" sid="ACT 20:19"/>Umum itɔ̃ itser Uteijee nggu ididɔɔr akarhãrhã nu anyĩ. Nu ngge iki iwe ugɛ abi Uyahuda atsu umum ayetnum nggu andeya. <verse eid="ACT 20:19"/><verse number="20" style="v" sid="ACT 20:20"/>Umbi ahwɛngmbi umum isi ibvurmum angwĩ ri ĩdzaa umbi kishoo isarhayɛ iki iyika umbi bɔr umum imesuwa umbi ra ayambi nu awiya ikɛi. <verse eid="ACT 20:20"/><verse number="21" style="v" sid="ACT 20:21"/>Umum isɛmmum abi Uyahuda nu atsen abi Uyahuda ugɛ awu ufang umbɔ adzipa aba ru Unum na atsu amɛnmbɔ ru Uteijeemɛn Uyesu.<verse eid="ACT 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 20:22"/>&lt;&lt;Nu icɛrɛ, Ipfu-Numyɛ iki iyira umum iwuri izĩ Urusharhima, isi ihwɛng ubinkpi iki ikorhe nggu umum umɔ. <verse eid="ACT 20:22"/><verse number="23" style="v" sid="ACT 20:23"/>Umum ikpurhi ihwɛng ugɛ ubɛn uteu Ipfu Isarsatangge iki igbiitangge atomum ugɛ ugborzĩ nu uver ukpɔ udzɛu umum. <verse eid="ACT 20:23"/><verse number="24" style="v" sid="ACT 20:24"/>Bɔr umum isi inyã urhɛmum uwekpɔ ubin. Umum ikpurhi ibee imaa itseryɛ Uteijee Uyesu aka adzaa umum, idekuwe arherhe Isarhe Iyiki Ize iyi imimutu Unum.<verse eid="ACT 20:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25"/>&lt;&lt;Icɛrɛ umum ihwɛng ubɛn unera ru umbi umum iki izɛ̃rhã idũwã isarhe Iyɛrhe Unum, asi ínyãã asumum ikɛi. <verse eid="ACT 20:25"/><verse number="26" style="v" sid="ACT 20:26"/>Nggee, umum idɛyiwa umbi irherɛ ugɛ, umum ishimum ru uvau adzirh anera kishoo. <verse eid="ACT 20:26"/><verse number="27" style="v" sid="ACT 20:27"/>Ubinkutsu, umum isi ibvurmum angwĩmum ri isɔma umbi kishoo abinkɛ Unum aka abee. <verse eid="ACT 20:27"/><verse number="28" style="v" sid="ACT 20:28"/>Àka adzɛu atsimbi nu kishoo ukpui abika adɔsa, Ipfu Isarsatangge iki itsũ umbi awu anggbaashimbɔ. Àka adzɛu abika adɔsu Unum, abirabɛ unga aka akũ adzirh Ungwɛ̃nga agoi. <verse eid="ACT 20:28"/><verse number="29" style="v" sid="ACT 20:29"/>Umum ihwɛngmum ĩba isokũ, íjui ngbako iwuri itsĩngge ru umbi isi ínekũngge ukpui idɔi ha. <verse eid="ACT 20:29"/><verse number="30" style="v" sid="ACT 20:30"/>Abɔɔ ru umbi asok adɛ̃ɛ̃ idzidzunuwe idzidzɛrhe ha abee igbiir amɛn angwɛ̃ imesa azĩ ru umbɔ. <verse eid="ACT 20:30"/><verse number="31" style="v" sid="ACT 20:31"/>Nggee àka adɛ̃ɛ̃ adzɛu! Àka ayita ugɛ imɛka itaar nu utsuu na atenum umum isi ibvurmum angwĩmum ri isɛm umbi kishoo nggu anyĩ.<verse eid="ACT 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32"/>&lt;&lt;Icɛrɛ umum iyɛruwe umbi ru Unum. Àka aneke urhɛm imimutanga ngge idɛ̃ɛ̃ idzin umbi ni idzaa umbi ukam ru abirabɛ aka awe asarkasar kishoo. <verse eid="ACT 20:32"/><verse number="33" style="v" sid="ACT 20:33"/>Umum inasi igũmum unyɛ̃ɛ̃ uhwɛk unera use atorhanga. <verse eid="ACT 20:33"/><verse number="34" style="v" sid="ACT 20:34"/>Umbi nibikambi ahwɛngmbi umum ikũ abokmum itɔ̃ itser ifai itsũwãmum nu iyi abirabɛ aka awu nggu umum. <verse eid="ACT 20:34"/><verse number="35" style="v" sid="ACT 20:35"/>Ra abina kishoo umum iki ikorhe, umum idɛyiwa umbi ugɛ awu ufang umbi atɔ̃ ikpũ itser iyiki itso ha ayike abika asheri iker, na ayita Arherhu Uteijee Uyesu aka agɔr agɛ, &lt;Idzidzowe iwe ru idorh inangngge iyiyɛi.&gt; &gt;&gt;<verse eid="ACT 20:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36"/>Ivangyɛ unga aka irherhe rimi, unga atararhu nggu umbɔ kishoo na afɛn-Num. <verse eid="ACT 20:36"/><verse number="37" style="v" sid="ACT 20:37"/>Umɔ umbɔ kishoo aciu akpe na awumu Uburhu na ashor unga. <verse eid="ACT 20:37"/><verse number="38" style="v" sid="ACT 20:38"/>Ubinkpi uku utsu amɛnmbɔ aghong akarhãrhã, awu arherhakɛ unga aka arherhe ugɛ umbɔ asi íbvui anyãmbɔ asunga ikɛi. Mɔcɛ umbɔ azĩ adene unga nu ukhukhɔɔ amɛ̃.<verse eid="ACT 20:38"/></para>
  <chapter eid="ACT 20"/>
  <chapter number="21" style="c" sid="ACT 21"/>
  <para style="s1">Uburhu ru Urusharhima</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1"/>Ivangyɛ umɛn iki ibɔre umbɔ, itsĩ ukhukhɔɔ amɛ̃ izĩmɛn Ukosi. Unum uvaa umɛn izĩmɛn Urod, idzek umɔ izĩmɛn Upatara. <verse eid="ACT 21:1"/><verse number="2" style="v" sid="ACT 21:2"/>Umɛn iki ikpo ukhukhɔɔ amɛ̃ uwuku uzĩ abĩ Ufinikiya, umɛn itsĩ izĩmɛn. <verse eid="ACT 21:2"/><verse number="3" style="v" sid="ACT 21:3"/>Umɛn iki itirhi inyã Usayifuru, umɛn itɔng udiku unɔrmgbɔ, umɛn izĩmɛn Usuriya. Umɛn icipa ru Utaya, ubinkutsu ru ukhukhɔɔ amɛ̃ umɛn ucipuwe abinke. <verse eid="ACT 21:3"/><verse number="4" style="v" sid="ACT 21:4"/>Umɛn iki ikpo angwɛ̃ imesa umɔ, umɛn isei umɔ inuma utɔɔva. Mɔcɛ ru ubok Ipfu-Num umbɔ adɛyiwe Uburhu unga niba azĩã Urusharhima. <verse eid="ACT 21:4"/><verse number="5" style="v" sid="ACT 21:5"/>Bɔr ivang iyiki isisokmɛn iki iwe, umɛn iso idɛ̃ɛ̃mɛn uzɛ̃rhãmɛn. Angwɛ̃ imesa kishoo nu atsɛ̃mbɔ nu awɛkacimbɔ akũna umɛn azĩ adena nu undzing utepa. Mɔcɛ umɛn iki itar arhu nu ubang ukau ukugɔng ni ifɛn-Num. <verse eid="ACT 21:5"/><verse number="6" style="v" sid="ACT 21:6"/>Umɛn ighwe unuma ra adɔka imaa ni itsĩ ukhukhɔɔ amɛ̃, umbɔ abvui azĩmbɔ ra ayambɔ.<verse eid="ACT 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7"/>Umɛn itsĩmɛn uzɛ̃rhãmɛn idzeku Utaya, itsĩmɛn Utorhemayi, umɔ umɛn iki ighwe ighwe nggu angwɛ̃mɛn nu anapumɛn, umɛn imaa unuma unying nggu umbɔ. <verse eid="ACT 21:7"/><verse number="8" style="v" sid="ACT 21:8"/>Unum uvaa umɛn isok izĩmɛn Ukaisariya. Umɛn itsĩ isei ri iya Ufirhibu uwuku udzowe Isarhe Iyiki Ize, unying ru umbɔ utɔɔva ha umbɔ aka asɛng umbɔ ayike abi itser ru Urusharhima. <verse eid="ACT 21:8"/><verse number="9" style="v" sid="ACT 21:9"/>Unga awu ra anakatsɛrh anaa aka anasi ipfunumbɔ awu abika asɔm Arherhu-Num.<verse eid="ACT 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 21:10"/>Umɛn iki imaa inum iyɔɔ umɔ, uwuku usɔm Arherhu-Num itsoka igburh Uagabu, adzeka abĩ Uyahudiya aba atsĩ. <verse eid="ACT 21:10"/><verse number="11" style="v" sid="ACT 21:11"/>Unga aka aba atsĩ, unga anyangu ikpɔm Uburhu, abow adaknga na aboknga na agɛ, &lt;&lt;Ubinkpi Ipfu Isarsatangge iki igɔr igɛ, &lt;Riminɛ anggbaashi abi Uyahuda ru Urusharhima aka ibow uner ikpɔm iyɛrɛ, na atsuke unga ra abok Atsen abi Uyahuda.&gt; &gt;&gt;<verse eid="ACT 21:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12"/>Ivangyɛ umɛn iki igũ rimi, umɛn nu abi anang hã ishɔ̃rhũ Uburhu unga niba azĩã Urusharhima. <verse eid="ACT 21:12"/><verse number="13" style="v" sid="ACT 21:13"/>Mɔcɛ Uburhu agɛ, &lt;&lt;Awu use utsu umbi aciu na adakuwe amɛnmum? Umum iki igbishi imaamum, ibibow ukpekũ isi iwengge ubin, bɔr afɛre umum ru Urusharhima ri itsok Uteijee Uyesu.&gt;&gt; <verse eid="ACT 21:13"/><verse number="14" style="v" sid="ACT 21:14"/>Umɛn iki isi idɛ̃ɛ̃ ikɛnmɛn unga, umɛn inumɛn ukutata, ni ĩgɔr igɛ, &lt;&lt;Uneke ibibemu Uteijee iwe.&gt;&gt;<verse eid="ACT 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15"/>Akɛrɛ ha aka amaa umɛn ingbika abinmɛn izĩmɛn Urusharhima. <verse eid="ACT 21:15"/><verse number="16" style="v" sid="ACT 21:16"/>Angwɛ̃ imesa abɔɔ adzeku Ukaisariya aba adena umɛn, akũna umɛn azĩmbɔ ru Umanason, uwuruwi umɛn iki icipa ri iyanga. Unga awu uner Usayifuru unying ra angwɛ̃ imesa abi inggbaashia.<verse eid="ACT 21:16"/></para>
  <para style="s1">Uburhu aka atsĩ Urusharhima</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17"/>Ivangyɛ umɛn iki itsĩ Urusharhima, angwɛ̃mɛn nu anapumɛn ayɛi umɛn nggu ibibema. <verse eid="ACT 21:17"/><verse number="18" style="v" sid="ACT 21:18"/>Unum uvaa Uburhu nggu umɛn izĩmɛn inyã Uyaku, nu kishoo akakũ awu umɔ. <verse eid="ACT 21:18"/><verse number="19" style="v" sid="ACT 21:19"/>Uburhu aka aghwe umbɔ amaa, unga adɛyiwe umbɔ agbɛgbɛra agbɛra abinkɛ Unum aka akorhuwe Atsen abi Uyahuda ru ubok itseryɛ unga aka atɔ̃.<verse eid="ACT 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 21:20"/>Umbɔ aka agũ rimi amaa, umbɔ akpoi Unum, na agɔr Uburhu agɛ, &lt;&lt;A ungwɛ̃mɛn, urhi unyã, irhɛ anaka agɔnga abi Uyahuda asong abika awe ru imangmang! Kishoo atsu amɛnmbɔ ri idɔsi Íkpem! <verse eid="ACT 21:20"/><verse number="21" style="v" sid="ACT 21:21"/>Aka asɔmukumbɔ arherhango, ugɛ ungo umesuwe kishoo abi Uyahuda abika asei ra atsen abi Uyahuda umbɔ aneke Íkpem Umusa, ungo ugɔr umbɔ ugɛ, umbɔ niba asorhukumbɔ usorhe ra awɛkacimbɔ, use adɔsa agbeyi abi Uyahuda. <verse eid="ACT 21:21"/><verse number="22" style="v" sid="ACT 21:22"/>Umɛn ikorhu ugusemɛn? Nggayɛ umbɔ awuri igũmbɔ agɛ ungo uku ubango. <verse eid="ACT 21:22"/><verse number="23" style="v" sid="ACT 21:23"/>Nggee ukorhu ubinkpi umɛn iki idɛyiwa ungo, inera niyɔ inaa iwu nggu umɛn aka ayirh uyirh. <verse eid="ACT 21:23"/><verse number="24" style="v" sid="ACT 21:24"/>Utsĩ ra anera abɛrɛ, uzĩ umbɔ asare umbi ivanga unying ru ungo ufai uhwɛkmbɔ, ngge itsú umbɔ akone atsimbɔ. Rimi hã itsu ubɛn unera awuri ihwɛngnga ugɛ kishoo abinkɛ umbɔ aka arherhe ri itsingo asi iweke idzidzɛrhe, bɔr awuri inyĩnyãmbɔ ungo uku udɔsi Íkpem. <verse eid="ACT 21:24"/><verse number="25" style="v" sid="ACT 21:25"/>Atsen abi Uyahuda abika awe ru imangmang, umɛn iki itsɛng abvur idɛyiwe umbɔ ugɛ umɛn ibee umbɔ niba aghambɔ ubinkpi umbɔ aka ayɛruwe ru agberhe, use adzirh, asi ítãimbɔ ijuɛyɛ umbɔ aka ashĩrhũ urhɔkngge, asi ítomumbɔ-dak.&gt;&gt;<verse eid="ACT 21:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26"/>Unum untaar Uburhu akũna anera abɛrɛ umbɔ asare unga nggu umbɔ. Mɔcɛ unga atsĩã ri Iya-Num, adɛyiwe abika adzowe idɛm-Num unumkpi uku utsufɛr isisarmbɔ. Ru unum hã ubɛn unera ru umbɔ aka idzowe izũwũ idɛm.<verse eid="ACT 21:26"/></para>
  <para style="s1">Adzur Uburhu</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27"/>Inuma utɔɔva ha iki iyo imimaa, abi Uyahuda abɔɔ aka adzeka abĩ Uasiya anyã Uburhu ri Iya-Num. Umbɔ ahwita anera ri ikikɔnga kishoo umbɔ adzur unga. <verse eid="ACT 21:27"/><verse number="28" style="v" sid="ACT 21:28"/>Atsu ivum agɛ, &lt;&lt;Umbi aner Uisrairha, àka ayika umɛn! Uner ha nuwi aki azɛ̃rhã amesuwe anera kishoo awe ru igamtsa ra anermɛn nu Íkpemmɛn nu anang akɛrɛ. Asi iwea akɛrɛ ha ukpekũ, bɔr unga aka akũ Atsen abi Uyahuda abɔɔ atsĩwã ru ufɔm Iya-Num aba atsuke arhim ru usarkasar anang akɛrɛ.&gt;&gt; <verse eid="ACT 21:28"/><verse number="29" style="v" sid="ACT 21:29"/>Umbɔ agɛ iwe rimi umbɔ aka anyãmbɔ Uburhu nggu Uturofimu, uner Uafisa, ru utepa. Umbɔ akaifɛrhkɔ agɛ Uburhu unga akũna unga atsĩ ru ufɔm Iya-Num.<verse eid="ACT 21:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30"/>Uteu ha kishoo udzunukpɔ, anera asok atĩ aba akɔng. Azĩ adzur Uburhu, agbĩrhã unga adzek ru ufɔm Iya-Num, umbɔ afɔmukumbɔ angwĩ ufɔma kanying. <verse eid="ACT 21:30"/><verse number="31" style="v" sid="ACT 21:31"/>Abee ifɛre unga nukpi, mɔcɛ isarhe izĩ itsĩngge ru ukugɔng abi iwa Uroma igɛ Urusharhima kishoo uku udzunukpɔ. <verse eid="ACT 21:31"/><verse number="32" style="v" sid="ACT 21:32"/>Kanying unga akarha abi iwa Uroma na ateiyambɔ, atĩ azĩmbɔ ri ikikɔnga. Ivangyɛ anera aka anyã ukugɔng nu abi iwanga, umbɔ anekukumbɔ ikwɛr Uburhu.<verse eid="ACT 21:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 21:33"/>Ukugɔng abi iwa ha aba adzur Uburhu atsu umbɔ abow unga nggu inyãwã ivaa. Mɔcɛ na arhusa agɛ, &lt;&lt;Unga awu ungamɔ, na akorhu use?&gt;&gt; <verse eid="ACT 21:33"/><verse number="34" style="v" sid="ACT 21:34"/>Ikikɔnga itsuyi ivum igwarha arherhe, abɔɔ agɛ akɛrɛ abɔɔ agɛ akɔrɔ. Uteiya abi iwa ha aka asi idɛ̃ɛ̃ adzura usu arherhe ha igwarha arherhe irhɛngge, unga atsu umbɔ akũ Uburhu azĩmbɔ aya abi iwa. <verse eid="ACT 21:34"/><verse number="35" style="v" sid="ACT 21:35"/>Ivangyɛ Uburhu aka aba atsĩ ru abeu angwĩ iyaa, abi iwa ashupa unga, umbɔ aka anyã anera abee ifɛre unga. <verse eid="ACT 21:35"/><verse number="36" style="v" sid="ACT 21:36"/>Ikikɔng anera iki idɔsa umbɔ inũ itsuyi ivum igɛ, &lt;&lt;Afɛre unga, afɛre unga!&gt;&gt;<verse eid="ACT 21:36"/></para>
  <para style="s1">Uburhu arherhe arherhe <optbreak/> nggu ikikɔnga</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37"/>Umbɔ aka akũ Uburhu ayo itsĩ ra aya abi iwa, unga ashɔ̃rhã ukugɔng abi iwa ha agɛ, &lt;&lt;Kabɔɔ ungo uma uneka umum irherha arherhe nggu ungo?&gt;&gt;</para>
  <para style="p" vid="ACT 21:37">Unga agɔr unga agɛ, &lt;&lt;Ungo uhwɛngo idũ abi Uherhini? <verse eid="ACT 21:37"/><verse number="38" style="v" sid="ACT 21:38"/>Asi iwea ungo uwu utsa Umasar ha isha uwuku ukũ isoyamɛn uba akũ anera anaka agɔng anaa abika afɛr aner ukũ azĩ ra arhum?&gt;&gt;<verse eid="ACT 21:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39"/>Uburhu agɔr unga agɛ, &lt;&lt;Umum iwu utsa Uyahudiya, idzeku Utarsu ra abĩ Ukirhikiya, umum iwu ungwɛ̃ undzumu uteu ukugɔng. Kabɔɔ uma uneka umum irherha arherhe nggu anera abɛrɛ.&gt;&gt;<verse eid="ACT 21:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 21:40"/>Unga aka aneke unga arherhe, Uburhu adɛ̃ɛ̃ nu abeu ha aberu uboknga ra anera umbɔ anu ukutata. Umbɔ aka anu ukutata, unga arherhe arherhe nggu umbɔ ri idũ abi Uyahuda.<figure style="fig" alt="Rome" file="ldd GPS_Paul4_B&amp;W.jpg" size="span" copy="WBT" ref="21.17—28.14">Uburhu azɛ̃rhã azĩ Uroma</figure><verse eid="ACT 21:40"/></para>
  <chapter eid="ACT 21"/>
  <chapter number="22" style="c" sid="ACT 22"/>
  <para style="nb">
    <verse number="1" style="v" sid="ACT 22:1"/>Uburhu agɛ, &lt;&lt;Umbi angwɛ̃mɛn nu atesmɛn, àka akpeto ru umum ikaa itsimum.&gt;&gt;<verse eid="ACT 22:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 22:2"/>Ivangyɛ umbɔ aka agũ unga arherhewe umbɔ ri idũ abi Uyahuda, umbɔ agbisha anu ukutata.</para>
  <para style="p" vid="ACT 22:2">Mɔcɛ Uburhu agɛ, <verse eid="ACT 22:2"/><verse number="3" style="v" sid="ACT 22:3"/>&lt;&lt;Umum iwu utsa Uyahudiya. Amar umum ru Utarsu ra abĩ aki Ukirhikiya, bɔr akpɔm umum ru utepu ukpirɛ. Umum itsĩ imesa ru ubok Ugamarhiyerh. Amesuwa umum abina kishoo aki Íkpem atokamɛn. Umum iwemum ri itsu amɛn ri idɔsu Unum, ru nyaka umbi kishoo aki ikorhe irherɛ. <verse eid="ACT 22:3"/><verse number="4" style="v" sid="ACT 22:4"/>Idzowukũ uver ra abika adɔsu utsĩndĩ uwirɛ, ifɛyiwe umbɔ, idzui akatsak nu akatsɛrh itsuyikumum umbɔ ru ugborzĩ, <verse eid="ACT 22:4"/><verse number="5" style="v" sid="ACT 22:5"/>ru nyaku Ukugɔng Uwuku Udzowe Idɛm-Num nu ikikɔng akakũ abi Uyahuda kishoo aka iwu idekamum. Umum iyɛisũ abvur ru umbɔ iwuri ikũ izĩ ru abimbɔ ru Udimashku. Umum izĩ umɔ ibee idzui abirabɛ aka adɔsu utsĩndĩ uwurɛ ikũ iba Urusharhima, umbɔ adzowe umbɔ ayetnum.<verse eid="ACT 22:5"/></para>
  <para style="s1">Uburhu aka adzipa adɔsu Uteijee</para>
  <para style="r">(<ref loc="ACT 9:1-19">Aiy 9.1-19</ref>; <ref loc="ACT 26:12-18">26.12-18</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6"/>&lt;&lt;Umum iwu ru uzɛ̃rhã, iki iyokũ itsĩ Udimashku ra atenuma, kanying nggaa irhirhang ra afã irhang idzipa umum. <verse eid="ACT 22:6"/><verse number="7" style="v" sid="ACT 22:7"/>Umum ĩgba inũ nu abĩ ni igũ urhɛm uku ugɔr umum ugɛ, &lt;A Ushawurhu! A Ushawurhu! Awu use utsu ungo udzaa umum uver?&gt;<verse eid="ACT 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 22:8"/>&lt;&lt;Umum irhusa inggɛ, &lt;Awu ungo ungamɔ Uteijee?&gt;</para>
  <para style="p" vid="ACT 22:8">&lt;&lt;Mɔcɛ urhɛm hã ugɔr umum ugɛ, &lt;Awu umum Uyesu uner Unazarat uwuruwi ungo uku unu idzowe uver.&gt; <verse eid="ACT 22:8"/><verse number="9" style="v" sid="ACT 22:9"/>Abirabɛ aka awu nggu umum anyãmbɔ irhirhang hã, bɔr asi igũmbɔ urhɛm hã uku unu arherhe nggu umum.<verse eid="ACT 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 22:10"/>&lt;&lt;Nggee umum irhusa inggɛ, &lt;A Uteijee, umum ikorhi uguse?&gt;</para>
  <para style="p" vid="ACT 22:10">&lt;&lt;Mɔcɛ Uteijee agɔr umum agɛ, &lt;Usisok, utsĩ ru Udimashku. Umɔ umbɔ aka idɛyiwa kishoo ubinkpi umum iki itsu ungo ikorhe.&gt; <verse eid="ACT 22:10"/><verse number="11" style="v" sid="ACT 22:11"/>Iker irhirhang hã iki itsu umum itapa, abirabɛ aka awu nggu umum akpɔm abokmum adarh umum atsĩ Udimashku.<verse eid="ACT 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12"/>&lt;&lt;Utsa uwɔɔ agburh Uhananiya aba inyã umum. Awu uner uwuku udzowe itsinga idɔsu Unum ri Íkpem Umusa, abi Uyahuda kishoo abika awu umɔ aka isaka adzowe unga igɔng. <verse eid="ACT 22:12"/><verse number="13" style="v" sid="ACT 22:13"/>Unga aba adɛ̃ɛ̃ akhapa ru umum agɔr umum agɛ, &lt;A ungwɛ̃mɛn Ushawurhu, ukpo inyã anang!&gt; Kanying asumum ayanga, umum idɛ̃ɛ̃ inyã unga.<verse eid="ACT 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 22:14"/>&lt;&lt;Mɔcɛ unga agɛ, &lt;Unum uwu atokamɛn asɛng ungo, ungo uhwɛng amɛnnga, nu unyã Uner Uwuku Urhurhika ha nu ugũ urhɛm ra angwĩnga. <verse eid="ACT 22:14"/><verse number="15" style="v" sid="ACT 22:15"/>Ubinkutsu ungo uwuri iwu idekanga ru ubɛn unera, ru ubinkpi ungo uku unyã nu ugũ. <verse eid="ACT 22:15"/><verse number="16" style="v" sid="ACT 22:16"/>Icɛrɛ ungo udzɛu use? Usisok, usorhu ubɔtisima, nu usorh arhimngo adzek ri ifɛn ri itsoknga.&gt;<verse eid="ACT 22:16"/></para>
  <para style="s1">Uyisa Uburhu</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17"/>&lt;&lt;Umum iki ibvui iba Urusharhima iwe ri ifɛn-Num ru ufɔm Iya-Num, umum inyã irhi <verse eid="ACT 22:17"/><verse number="18" style="v" sid="ACT 22:18"/>ni inyã Uteijee aka arherhe nggu umum agɛ, &lt;Ifetem! Udzekɔ ru Urusharhima kanying, ubinkutsu, umbɔ asi íyɛimbɔ idekango ri itsimum.&gt;<verse eid="ACT 22:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 22:19"/>&lt;&lt;Umum igɔr ugɛ, &lt;A Uteijee, umbɔ nibikambɔ ahwɛngmbɔ umum iki itsĩrhã abã ifɛn-Num itsuke abika awe ru imangmang ru ungo, ru ugborzĩ na ikwɛre umbɔ ugwɛɛ. <verse eid="ACT 22:19"/><verse number="20" style="v" sid="ACT 22:20"/>Nu ivang umbɔ aka ifɛr Uistifanu uwu idekango, umum nibikami idɛ̃ɛ̃ umɔ, umum iwu ru undzingmbɔ ru ubinkpi umbɔ aka akorhe, awu umum idzɛu atorho abika afɛr unga.&gt;<verse eid="ACT 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 22:21"/>&lt;&lt;Mɔcɛ Uteijee agɔr umum agɛ, &lt;Uso uzĩ, umum iwuri idena ungo uzĩ nggɔɔ ra anang akika ader ra atsen abi Uyahuda.&gt; &gt;&gt;<verse eid="ACT 22:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22"/>Ikikɔnga ikpeto ru Uburhu utsɛku unga aka arherhe akɛrɛ. Mɔcɛ umbɔ atsarhi irhakmbɔ atsui ívum agɛ, &lt;&lt;Afɛre ikpũ uner uwurɛ! Isi imɛ̃ngge unga abɛk!&gt;&gt;<verse eid="ACT 22:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 22:23"/>Umbɔ aka atsuyi ívum atsimuwe antamambɔ atãyĩwe, asoyi uzurhu ru ugba. <verse eid="ACT 22:23"/><verse number="24" style="v" sid="ACT 22:24"/>Ukugɔng abi iwa ha atsu umbɔ akũ Uburhu azĩmbɔ ru aya abi iwa. Atsu umbɔ akwɛre ugwɛɛ, abee unga asɔm ubinkpi uku utsu ikikɔnga itsuyiwe unga ivum rimi. <verse eid="ACT 22:24"/><verse number="25" style="v" sid="ACT 22:25"/>Umbɔ aka agbiir aboknga abow na abee ikwɛr unga, Uburhu agɔr uteiya abi iwa aka adɛ̃ɛ̃ akhapa umɔ agɛ, &lt;&lt;Imɛ̃ngge ungo ukwɛre ugwɛɛ ru uner Uroma umbɔ aka anasi itsu umbɔ uvau ru unga?&gt;&gt;<verse eid="ACT 22:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26"/>Ivangyɛ uteiya abi iwa ha aka agũ rimi, unga azĩ ru ukugɔng hã azĩ agɔr unga agɛ, &lt;&lt;Ungo ubee ikorhu uguse? Utsak uwurɛ awu uner Uroma.&gt;&gt;<verse eid="ACT 22:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27"/>Ukugɔng hã aba agɔr Uburhu agɛ, &lt;&lt;Usɔma umum idzidzɛrhe, ungo uwu uner Uroma?&gt;&gt;</para>
  <para style="p" vid="ACT 22:27">Uburhu agɔr agɛ, &lt;&lt;Ĩĩ.&gt;&gt;<verse eid="ACT 22:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 22:28"/>Mɔcɛ ukugɔng hã agɛ, &lt;&lt;Umum ikũ uhwɛk urhɛrhɛ ikpo iwe uner Uroma.&gt;&gt;</para>
  <para style="p" vid="ACT 22:28">Uburhu agɛ, &lt;&lt;Umum iwu undzumu ungwɛ̃ Uroma.&gt;&gt;<verse eid="ACT 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 22:29"/>Abika abee irhusa unga urherhe abvui azĩmbɔ ra andzing kanying. Ukugɔng hã aka ahwɛng agɛ Uburhu awu uner Uroma, iwei ifɛr unga, nggayɛ unga aka abowpa unga.<verse eid="ACT 22:29"/></para>
  <para style="s1">Uburhu ra asu abi udzepurhe</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30"/>Unum uvaa, ukugɔng hã abee ihwɛng ubinkpi Uburhu aka ikorhuwe abi Uyahuda umbɔ atsu arherhanga. Unga agarhuwe abok Uburhu na atsu ateiya abika adzowe idɛm-Num nu abi udzepurhe abi Uyahuda kishoo akɔng. Mɔcɛ unga akũ Uburhu aba adɛ̃ɛ̃ ra asumbɔ.<verse eid="ACT 22:30"/></para>
  <chapter eid="ACT 22"/>
  <chapter number="23" style="c" sid="ACT 23"/>
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1"/>Uburhu arhi abi udzepurhe ha ra asumbɔ na agɛ, &lt;&lt;Umbi angwɛ̃mɛn, umum iki itɔ̃ itsermum ĩba itsĩ irherɛ ra amɛn aka aze kishoo ra asu Unum.&gt;&gt; <verse eid="ACT 23:1"/><verse number="2" style="v" sid="ACT 23:2"/>Akɛrɛ ha atsu Uhananiya Ukugɔng Uwuku Udzowe Idɛm-Num, atsu abika adɛ̃ɛ̃ ayo nggu Uburhu akwɛr unga nu angwĩnga. <verse eid="ACT 23:2"/><verse number="3" style="v" sid="ACT 23:3"/>Mɔcɛ Uburhu agɔr unga agɛ, &lt;&lt;Unum unga awuri ikwɛr ungo, uner ukpukpeta!<note caller="+" style="f"><char style="fr" closed="false">23.3 </char><char style="ft" closed="false">Agbena agburh uparharhi ubandzin.</char></note> Ungo usei nu utsu umum uvau ri idɔsi Íkpem Umusa, bɔr ungo nibikango uzharhukɔ Íkpema ungo uku utsu umbɔ akwɛr umum.&gt;&gt;<verse eid="ACT 23:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4"/>Abirabɛ aka adɛ̃ɛ̃ akhapa ru Uburhu agɔr unga agɛ, &lt;&lt;Ukugɔng Uwuku Udzowe Idɛm-Num ungo uku urhena?&gt;&gt;<verse eid="ACT 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 23:5"/>Uburhu agɛ, &lt;&lt;Umbi angwɛ̃mɛn, umum isi ihwɛng unga aka awu Ukugɔng Uwuku Udzowe Idɛm-Num. Ubinkutsu itsɛng Arherhu-Num igɔrngge ugɛ, &lt;Niba arhenumbɔ uyɛrhe.&gt; <note caller="+" style="f"><char style="fr" closed="false">23.5 </char><char style="ft" closed="false">Àka anyã ikɛi: </char><char style="xt"><ref loc="EXO 22:28">Idzi 22.28</ref></char>.</note>&gt;&gt;<verse eid="ACT 23:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6"/>Ivangyɛ Uburhu aka anyã ugɛ abɔɔ awu abi Usaduki, abɔɔ ikɛi awu abi Ufarisi, unga atsarhi irhaknga ru udzepurhe ha agɛ, &lt;&lt;Umbi angwɛ̃mɛn, umum iwu uner Ufarisi, ungwɛ̃ Ufarisi. Umum idɛ̃ɛ̃ umbɔ avarhuwa umum arherhe ri itsi umum iki ifosa ugɛ abika akpe awuri isok ra akpe.&gt;&gt; <verse eid="ACT 23:6"/><verse number="7" style="v" sid="ACT 23:7"/>Ivangyɛ unga aka arherhe akɛrɛ ha, uning usomgbɔ ra abi Ufarisi nu abi Usaduki, ikikɔnga igashungge. <verse eid="ACT 23:7"/><verse number="8" style="v" sid="ACT 23:8"/>Abi Usaduki awembɔ ri imangmang ugɛ isok ra akpe ishingge, ípfu itser-Num ishingge use ípfu ishingge. Abi Ufarisi awembɔ ri imangmang ugɛ kishoo aweke.<verse eid="ACT 23:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 23:9"/>Isoyamɛn igɔigɔng isongge. Abɔɔ abika amesuwe Ikpem ru ukpui ukpu Ufarisi asok adɛ̃ɛ̃ uning akarhãrhã agɛ, &lt;&lt;Umɛn isi ikpomɛn utsak uwurɛ nggu uvau. Ungaa ahwɛng, use awu ipfu use ipfu itser-Num irherha arherhe nggu unga?&gt;&gt; <verse eid="ACT 23:9"/><verse number="10" style="v" sid="ACT 23:10"/>Uning utsotsoramgbɔ uku usoyi, ukugɔng abi iwa ha agũ iwei ugɛ utsur umbɔ ashakukumbɔ Uburhu. Unga atsu abi iwa ha acipa avur Uburhu ri inggang akũ azĩmbɔ aya abi iwa.<verse eid="ACT 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11"/>Utsuu uku ufin, Uteijee adɛ̃ɛ̃ akhapa ru Uburhu, na agɛ, &lt;&lt;Uker amɛnngo! Ru nyaka ungo uku udzowe idekamum ru Urusharhima, nggee awu ufang ungo iki idekuwe umum ru Uroma.&gt;&gt;<verse eid="ACT 23:11"/></para>
  <para style="s1">Avarhi itsũwã iyiki ifɛr Uburhu</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12"/>Ukpee unum uvaa, abi Uyahuda akɔng avarhe ifɛre Uburhu ayirh uyirh ugɛ umbɔ asi íghambɔ asi íhwambɔ ubin, utsɛku umbɔ aka ifɛr Uburhu. <verse eid="ACT 23:12"/><verse number="13" style="v" sid="ACT 23:13"/>Anang umbɔ isɔka inaa umbɔ aka avarhi ikorhe iyiki ibewe ha. <verse eid="ACT 23:13"/><verse number="14" style="v" sid="ACT 23:14"/>Umbɔ asok azĩmbɔ ru ateiya abika adzowe idɛm-Num nu akakũ anera, na agɛ, &lt;&lt;Umɛn iki iyirh nggaa uyirh, igɛ umɛn isi íghamɛn ubin utsɛku umɛn iki ifɛr Uburhu. <verse eid="ACT 23:14"/><verse number="15" style="v" sid="ACT 23:15"/>Nggee, umbi nggu abi udzepurhe, àka adene itser umbɔ adɛyiwe ukugɔng abi iwa ha, umbɔ akũna unga akũwã ru umbi, àka akpeta ugɛ umbi abee ibvui arhusa arherhanga hã agũni ikɛi. Umɛn iki igbishi imaamɛn, umɛn iwuri ifɛre unga, unga adɔrha aba atsĩ.&gt;&gt;<verse eid="ACT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16"/>Bɔr ungwɛ̃ unapumbɔ Uburhu aka adɛ̃ɛ̃ na agũ arherhe aka abewe ha, unga atsĩ ru aya abi iwa asɔmuka Uburhu.<verse eid="ACT 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 23:17"/>Mɔcɛ Uburhu ayisu unying ra ateiya abi iwa Uroma agɛ, &lt;&lt;Ukũ ungwɛ̃dzɛm uwurɛ uzĩ ru uku ugɔngmbi, abee idɛyiwe unga ubin ukpɔɔ.&gt;&gt; <verse eid="ACT 23:17"/><verse number="18" style="v" sid="ACT 23:18"/>Nggee uteiya abi iwa Uroma ha akũ ungwɛ̃dzɛm hã azĩã ru uku ugɔngmbɔ na agɛ, &lt;&lt;Uburhu uwɔrɔ ru ugborzĩ ukpɔrɔ, ayisa umum ugɛ, umum ikũ ungwɛ̃dzɛm uwurɛ iba ru ungo, ubinkutsu unga awuri isɔma ungo ubin ukpɔɔ.&gt;&gt;<verse eid="ACT 23:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19"/>Ukugɔng hã adzur ubok ungwɛ̃dzɛm hã, akũna unga azĩã ri ifɛna arhusa unga ikiyikanga agɛ, &lt;&lt;Ungo ubee isɔma umum use?&gt;&gt;<verse eid="ACT 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20"/>Unga agɛ, &lt;&lt;Abi Uyahuda abee igɔr ungo ukũ Uburhu uzĩ ru udzepurhe udã, akpeta ugɛ umbɔ abee igbisha arhusa arherhe Uburhu. <verse eid="ACT 23:20"/><verse number="21" style="v" sid="ACT 23:21"/>Bɔr niba ubemukɔ, ubinkutsu inera itɔngngge isɔka inaa iki iwoi adzɛu unga. Aka ayirhmbɔ ugɛ umbɔ asi íghambɔ ubin utsɛku umbɔ aka ifɛre unga. Icɛrɛ umbɔ adzɛu ibibemango ukpekũ.&gt;&gt;<verse eid="ACT 23:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22"/>Nggee ukugɔng hã adene ungwɛ̃dzɛm hã azĩã, na agbiite atonga agɛ, &lt;&lt;Niba udɛyikɔ unera ugɛ ungo uku usɔmango umum arherhe akɛrɛ.&gt;&gt;<verse eid="ACT 23:22"/></para>
  <para style="s1">Adene Uburhu azĩã ru ugomna Uferhi</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23"/>Mɔcɛ unggbaashi ha ayisa ateiya abi iwa Uroma avaa agɔr umbɔ agɛ, &lt;&lt;Àka agbisha abinmbi, umum idena umbi azĩ Ukaisariya ra akara utɔɔrha aki utsuu irherɛ, nggu abi iwa inaka ivaa, nu abi iwa abɔɔ isɔka utɔɔva abika afũ inyãwã, nu abi iwa inaka ivaa abika atang iwa nggu asawa. <verse eid="ACT 23:23"/><verse number="24" style="v" sid="ACT 23:24"/>Àka akpowe ínyãwãyɛ Uburhu aka ifũ, umbi afɔrh unga akũ azĩ ru ugomna Uferhi.&gt;&gt;<verse eid="ACT 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 23:25"/>Unggbaashi abi iwa ha atsɛng ubvur riminɛ agɛ,<verse eid="ACT 23:25"/></para>
  <para style="pmo">
    <verse number="26" style="v" sid="ACT 23:26"/>Udzeku Ukarhaudiya Urhisiya,</para>
  <para style="pmo" vid="ACT 23:26">Uzĩ ru nggaa uner uwuku ugɔng ugomna Uferhi,</para>
  <para style="pmo" vid="ACT 23:26">Umum ighwe ungo.<verse eid="ACT 23:26"/></para>
  <para style="pmo">
    <verse number="27" style="v" sid="ACT 23:27"/>&lt;&lt;Uner uwurɛ abi Uyahuda adzur unga abee ifɛre unga, umum iso nggu abi iwamum umɛn ifɔrhe unga, ubinkutsu umum igũ unga awu utsa Uroma. <verse eid="ACT 23:27"/><verse number="28" style="v" sid="ACT 23:28"/>Umum iki ibee igũ uvauwi uku utsu umbɔ atsu arherhanga, nggee umum ikũna unga izĩ ru udzepurhembɔ. <verse eid="ACT 23:28"/><verse number="29" style="v" sid="ACT 23:29"/>Umum igũ umbɔ arhena unga ra arherhe íkpemmbɔ, bɔr umum isi ikpomum unga akorhunga ubinkpi uku utsu akpe use ugborzĩ. <verse eid="ACT 23:29"/><verse number="30" style="v" sid="ACT 23:30"/>Ivangyɛ umum iki ĩgũ iyiki ibeweyɛ umbɔ aka atsar ikorhe nggu utsa ha, kanying umum idene umbɔ akũ unga aba ru ungo. Ikɛi umum itsu abika atsu arherhe ri itsinga umbɔ aba asɔm ubinkpi umbɔ aka anyã unga akorhe ra asungo.&gt;&gt;<verse eid="ACT 23:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31"/>Nggee abi iwa, atɔ̃ itsermbɔ ru nyaka umbɔ aka atsuke, akũ Uburhu azĩmbɔ Uantifatiri nu untsuuka. <verse eid="ACT 23:31"/><verse number="32" style="v" sid="ACT 23:32"/>Unum uvaa abi iwa abika afũ inyãwã akũna unga azĩmbɔ ra asu, ra abɔɔ abvui azĩmbɔ ru aya abi iwambɔ. <verse eid="ACT 23:32"/><verse number="33" style="v" sid="ACT 23:33"/>Abi iwa abika afũ inyãwã aka azĩ atsĩ Ukaisariya, umbɔ adzowe ubvur ha ru ugomna, na atsuke Uburhu ru uboknga. <verse eid="ACT 23:33"/><verse number="34" style="v" sid="ACT 23:34"/>Ugomna hã aka avarhu ubvur ha na arhusu Uburhu ugɛ unga adzek udika abĩ akasong. Unga aka agũ agɛ Uburhu adzeka abĩ Ukirhikiya, <verse eid="ACT 23:34"/><verse number="35" style="v" sid="ACT 23:35"/>unga agɛ, &lt;&lt;Umum iwuri ĩgũmum arherhango, ri ivang abika atsu arherhe ri itsingo aka iba.&gt;&gt; Mɔcɛ unga atsu umbɔ adzɛu unga ru udzepurhe iyɛrhe Uhiridu aka adzin.<verse eid="ACT 23:35"/></para>
  <chapter eid="ACT 23"/>
  <chapter number="24" style="c" sid="ACT 24"/>
  <para style="s1">Atsu arherhu Uburhu ra asu Uferhi</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1"/>Inuma itɔ̃ɔ̃ iki imaa Ukugɔng Uwuku Udzowe Idɛm-Num Uhananiya azĩ Ukasariya nggu akakũ abɔɔ nu urhoya uwɔɔ itsoka igburh Utarturhu, atsu arherhe Uburhu ru ugomna. <verse eid="ACT 24:1"/><verse number="2" style="v" sid="ACT 24:2"/>Ivang umbɔ aka ayisu Uburhu atsĩ, urhoya Utarturhu atsu arherhe Uburhu ra asu ugomna Uferhi agɛ, &lt;&lt;Awu itsoingo itsu umɛn igũibɛn ididɔɔr iyiki ider, ikɛi ihwihwɛng iyi unuma itsu igbigbisha iba ra abĩmɛn. <verse eid="ACT 24:2"/><verse number="3" style="v" sid="ACT 24:3"/>Ra afɛna kishoo nu inanga, a uteiya Uferhi, umɛn itar uwɛɛ urhɛrhɛ ru ungo. <verse eid="ACT 24:3"/><verse number="4" style="v" sid="ACT 24:4"/>Bɔr umum isi ĩbeemum igha ivangngo, umum ishɔ̃rhã ungo uma udɔng amɛnngo ukpeto ru umɛn ukunjiir.<verse eid="ACT 24:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 24:5"/>&lt;&lt;Umɛn ikpo utsak uwurɛ awu uner uwuku utsuyi ifuw, anu ikũ isoyamɛn atsĩwã ra abi Uyahuda ru ubɛn ananga ru upfung. Unga awu unggbaashi agbeyi abi Unazarat. <verse eid="ACT 24:5"/><verse number="6-8" style="v" sid="ACT 24:6-8"/>Abee itsu arhim ri Iya-Num, nggee umɛn idzur unga. Ungo uba urhusungo unga nibikango, ungo uwuri igũo idzidzɛrhe kishoo ubinkpi umɛn iki irherhe ri itsinga.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">24.6-8 </char><char style="ft" closed="false">Abvur akɔɔ aki itsɛng abok aki isha agɔrke ikɛi ugɛ, </char><char style="fqa" closed="false">Umɛn ibee itsuke unga uvau ru nyaki Ikpemmɛn iki igɔr. Bɔr Urhisiya unggbaashi aba avur unga ra abokmɛn ri inggang. Na agɔr abika atsu arherhe ri itsinga aba arherhe ra anangngo.</char></note><verse eid="ACT 24:6-8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 24:9"/>Abi Uyahuda awu ru undzing akɛrɛ ha, agɔr ugɛ ífɛrha ha iwu idzidzɛrhe.<verse eid="ACT 24:9"/></para>
  <para style="s1">Uburhu akaa itsinga <optbreak/> ra asu ugomna Uferhi</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10"/>Ivangyɛ ugomna aka adzowe unga ijee arherhe Uburhu agɛ, &lt;&lt;Umum ikaa itsimum nggu itɛnamɛn ubinkutsu umum ihwɛng ungo uku umaa imɛka irhɛirhɛ ungo uku uvarhuwe arherhe ra abĩ akɛrɛ. <verse eid="ACT 24:10"/><verse number="11" style="v" sid="ACT 24:11"/>Ungo uba ugbishu urhisɔ, ungo ihwɛngngo ugɛ anasi itɔnga inuma usɔkdũmɛn umum iki izĩ ĩzdowe igɔng ri Iya-Num ru Urusharhima. <verse eid="ACT 24:11"/><verse number="12" style="v" sid="ACT 24:12"/>Abika atsu arherhamum asi ikpombɔ umum idɛ̃ɛ̃mum uning nggu unera ri Iya-Num, use isoyiwe amɛn anera ra abã ifɛn-Num, use ra anang akɔɔ ru utepa. <verse eid="ACT 24:12"/><verse number="13" style="v" sid="ACT 24:13"/>Asi ídɛ̃ɛ̃ adɛyiwambɔ ungo ubinkpi umbɔ aka akũ atsu arherhamum. <verse eid="ACT 24:13"/><verse number="14" style="v" sid="ACT 24:14"/>Bɔr umum isɔma ungo ra awiya, umum idzowe igɔng ru Unum uwu atokamɛn ru Utsĩndĩ hã, umbɔ aka ayisa ukpui uku ukpɛ̃. Bɔr umum iwemum ri imangmang ri kishoo abinkɛ aka awe ri Íkpem Umusa nu ru abvur abika asɔm Arherhu-Num. <verse eid="ACT 24:14"/><verse number="15" style="v" sid="ACT 24:15"/>Ififosamum ru Unum iwu unying nggu anera abɛrɛ, ugɛ abika arhurhika awuri isok ra akpe nu abika ada irhirhika. <verse eid="ACT 24:15"/><verse number="16" style="v" sid="ACT 24:16"/>Ngge itsu ubɛn ivang umum inũ itsu amɛnmum uku ushashaki ra asu Unum nu unera.<verse eid="ACT 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17"/>&lt;&lt;Imɛka irhɛrhɛ iki imaa, umum ibvui iba Urusharhima ikũ ízũwã abin ĩba indzowe anera ayike atsũwãmɛn, ni indzowe ídɛm-Num. <verse eid="ACT 24:17"/><verse number="18" style="v" sid="ACT 24:18"/>Umum iki imaamum isare itsikammum ivangyɛ abɛrɛ ha aka aba akpo umum ru ufɔm Iya-Num. Isi iwemum ri ikikɔng anera, isi isoyikũ amɛn anera. <verse eid="ACT 24:18"/><verse number="19" style="v" sid="ACT 24:19"/>Bɔr abi Uyahuda rabɔ adzeka abĩ Uasiya, awu umɔ, imɛ̃ngge umbɔ aba ra anangngo aba atsu arherhamum umbɔ aba awembɔ ra arherhe nggu umum. <verse eid="ACT 24:19"/><verse number="20" style="v" sid="ACT 24:20"/>Use ungo uneke anera abɛrɛ asɔm uvauwi umbɔ aka akpo ru umum ivangyɛ umum iki idɛ̃ɛ̃ ra asu abi udzepurhe. <verse eid="ACT 24:20"/><verse number="21" style="v" sid="ACT 24:21"/>Arherhambɔ awu unying ukpekũ umbɔ aka itsu umum uvau, umum iki itsarhi irhakmum ra asumbɔ ĩgɔr inggɛ, &lt;Awu arherhe isisok ra akpe umbɔ aka avarha arherhamum ra asumbi irherɛ.&gt; &gt;&gt;<verse eid="ACT 24:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22"/>Mɔcɛ Uferhi, uwuku uhwɛng Utsĩndĩ Uyesu akarhãrhã, agɔpuwe unuma agɔr umbɔ agɛ, &lt;&lt;Utsɛku unumkpi ukugɔng Urhisiya aka iba kata, umum idɔrhi izharhuwa arherhango.&gt;&gt; <verse eid="ACT 24:22"/><verse number="23" style="v" sid="ACT 24:23"/>Unga atsu uteiya abi iwa Uroma adzɛu Uburhu na aneke unga agayi iyornga na aneke awɛrhanga adzowe ubinkpi unga aka abee.<verse eid="ACT 24:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24"/>Inum iyɔɔ iki imaa Uferhi aba nggu utsɛ̃nga Udurusirha, una Uyahuda. Adene umbɔ akũ Uburhu aba, ru unga akpeto ra arherhe Uburhu aki imangmang ru Ukiristo Uyesu. <verse eid="ACT 24:24"/><verse number="25" style="v" sid="ACT 24:25"/>Ivangyɛ Uburhu aka anu idɛyiwe irhirhika, nu ikpɔm amɛn, nu nggaa unum ukpuku uvarha arherhe uku iba, itsu iwei ifɛr Uferhi, unga agɔr Uburhu agɛ, &lt;&lt;Iki iwu mɔnɔ icɛrɛ! Ubvui uzĩɔ̃. Umum iba ikpomum ivanga, umum idene umbɔ ayisuwa ungo.&gt;&gt; <verse eid="ACT 24:25"/><verse number="26" style="v" sid="ACT 24:26"/>Ri ivang hã unga atsu amɛnnga Uburhu awuri idzowe unga uhwɛk igha angwĩ, ngge itsu Uferhi ayisa unga ubɛn ivang asei irhɛrh nggu unga.<verse eid="ACT 24:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 24:27"/>Imɛka ivaa iki imaa Ufokiyu Ufestu awea ugomna ru ugarh Uferhi. Uferhi abee itɛnamɛn ra abi Uyahuda, unga aneke Uburhu ru ugborzĩ.<verse eid="ACT 24:27"/></para>
  <chapter eid="ACT 24"/>
  <chapter number="25" style="c" sid="ACT 25"/>
  <para style="s1">Arherhe ra asu Ufestu</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1"/>Inuma itaar iki imaa Ufestu aka atsĩ ra abĩ hã, asoku Ukaisariya azĩã Urusharhima, <verse eid="ACT 25:1"/><verse number="2" style="v" sid="ACT 25:2"/>umɔ ateiya abika adzowe idɛm-Num nu anggbaashi abi Uyahuda atsu arherhe Uburhu ru unga. <verse eid="ACT 25:2"/><verse number="3" style="v" sid="ACT 25:3"/>Umbɔ ashɔ̃rhũ Ufestu unga ama atsu umbɔ akũ Uburhu abvui azĩ Urusharhima, ubinkutsu aka agbisha abee iwoi na afɛre unga ru utsĩndĩ. <verse eid="ACT 25:3"/><verse number="4" style="v" sid="ACT 25:4"/>Bɔr Ufestu agɔr umbɔ agɛ, &lt;&lt;Adzudzɛu Uburhu ru Ukaisariya, umum nibikami isi ídãrhũmum ni ibvui izĩ umɔ. <verse eid="ACT 25:4"/><verse number="5" style="v" sid="ACT 25:5"/>Utsak uwurɛ aba awea ru uvau, anggbaashimbi abɔɔ aba umɛn izĩmɛn urhɔnga, azĩ atsu arherhe ri itsinga.&gt;&gt;<verse eid="ACT 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6"/>Inuma isi inangngge utɔrɔk, use usɔka, unga aka amaa nggu umbɔ, unga abvui azĩã Ukaisariya. Ukpee unum uvaa unga asei nú udzepurhe uku uvarha arherhe, atsu umbɔ akũ Uburhu aba ra asunga. <verse eid="ACT 25:6"/><verse number="7" style="v" sid="ACT 25:7"/>Ivang Uburhu aka adzeka, anggbaashi abi Uyahuda abika adzeku Urusharhima aba adɛ̃ɛ̃ adziira unga, atsuyi urherhe arhɛrhɛ uwuku utso ri itsinga, akirakɛ aka ashike ru idzidzɛrhe.<verse eid="ACT 25:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 25:8"/>Mɔcɛ Uburhu akaa itsinga agɔr agɛ, &lt;&lt;Umum isi igbamum uvau ri Íkpem abi Uyahuda use ri Iya-Num use ru Ukaisar.&gt;&gt;<verse eid="ACT 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9"/>Bɔr Ufestu abee itɛnne amɛn abi Uyahuda, unga agɔr Uburhu agɛ, &lt;&lt;Ungo ubeengo izĩ Urusharhima umbɔ avarhuwa arherhango ra asumum ru nggɔɔ ha?&gt;&gt;<verse eid="ACT 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 25:10"/>Uburhu agɛ, &lt;&lt;Umum iwu ra asu Ukaisar, ru udzepurhe uku uvarha arherhe, anangkɛ ngge iki imɛ̃ɛ̃ umbɔ avarhuwa umum arherhe. Umum isi ikorhumum iyiki ibewe ra abi Uyahuda, ungo nibikango uhwɛngo rimi hã. <verse eid="ACT 25:10"/><verse number="11" style="v" sid="ACT 25:11"/>Umum ĩba ikorhumum ubinkpi uku umɛ̃ɛ̃ akpe, umbɔ afɛre umum, umum isi ikpɛ̃mum akpe. Bɔr idzidzɛrhe iba ishingge ra arherhe ha abi Uyahuda aka atsu ru umum, unera asi ídɛ̃ɛ̃ adzowuka umum ru umbɔ. Umum ifɛna akũ arherhamum izĩ ru Ukaisar!&gt;&gt;<verse eid="ACT 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12"/>Ufestu aka akɛki itsũwã nggu abi udzepurhenga, mɔcɛ unga agɛ, &lt;&lt;Ungo ugɔr ugɛ akũ arherhango azĩ ru Ukaisar. Ungo uwuri izĩ ru Ukaisar.&gt;&gt;<verse eid="ACT 25:12"/></para>
  <para style="s1">Uburhu ra asu Uagiripa nu Ubani</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13"/>Inuma ukunjiir iki itɔng uyɛrhe Uagiripa nu Ubani abambɔ Ukaisariya, aba ighwe ugomna Ufestu. <verse eid="ACT 25:13"/><verse number="14" style="v" sid="ACT 25:14"/>Umbɔ amaa inuma irhɛirhɛ nggɔɔ ha, Ufestu arherhe arherhe Uburhu nggu uyɛrhe agɛ, &lt;&lt;Unera nuwɔ Uferhi aka aneka unga ru ugborzĩ. <verse eid="ACT 25:14"/><verse number="15" style="v" sid="ACT 25:15"/>Ivangyɛ umum iki iwe ru Urusharhima, ateiya abika adzowe idɛm-Num nu anggbaashi abi Uyahuda atsu arherhe utsak uwurɛ, ashɔ̃rhã umum ima itsu ubinkpi uku iwu uvau akpe ru unga.<verse eid="ACT 25:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 25:16"/>&lt;&lt;Umum idɛyiwe umbɔ ugɛ umɛn abi Uroma iki isaki isi idzowukumɛn unera ra abika atsu arherhe ri itsinga, bɔr awuri idzowukumbɔ ivang unga akaa itsinga ra asumbɔ ra arherha ha. <verse eid="ACT 25:16"/><verse number="17" style="v" sid="ACT 25:17"/>Ivangyɛ umbɔ aka aba nggimi nggu umum, umum isi idãrhũmum, unum uvaa umum isei nú utarh iyɛrhe ni itsu umbɔ akũ uner ha aba. <verse eid="ACT 25:17"/><verse number="18" style="v" sid="ACT 25:18"/>Abika atsu arherhe ha aka asok arherhe, umbɔ asi irherhumbɔ abin aka abewe akirakɛ umum iki ikau ra amɛnmum. <verse eid="ACT 25:18"/><verse number="19" style="v" sid="ACT 25:19"/>Bɔr umbɔ akpurha awu ru uning ra agbeyi ha umbɔ aka amesuwe, nu utsa uwɔɔ agburh Uyesu aka akpea, bɔr Uburhu agɔr agɛ awea ru urhɛ. <verse eid="ACT 25:19"/><verse number="20" style="v" sid="ACT 25:20"/>Umum iki isi ikpomum usu uku udɔsa arherhe ha, umum irhusa unga ugɛ use unga abemunga izĩ Urusharhima umbɔ avarhuwe arherhanga umɔ nggu abin akɛrɛ. <verse eid="ACT 25:20"/><verse number="21" style="v" sid="ACT 25:21"/>Bɔr Uburhu aka abee uyɛrhe Ukaisar unga azharhuwe arherhanga, umum itsu umbɔ adzɛu unga utsɛku ivangyɛ umum iki idene unga azĩ ru Ukaisar.&gt;&gt;<verse eid="ACT 25:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22"/>Mɔcɛ uyɛrhe Uagiripa agɔr Ufestu agɛ, &lt;&lt;Umum ibee igũ ru utsa ha nibikami.&gt;&gt;</para>
  <para style="p" vid="ACT 25:22">Ufestu agɛ, &lt;&lt;Udã ungo uwuri igũo unga.&gt;&gt;<verse eid="ACT 25:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23"/>Unum untaar Uagiripa nu Ubani adzek ri ijee iyɛrhambɔ, aba nggu akagɔng abi iwa nu anggbaashi abi utepa atsĩwã udzepurhe iyɛrhe. Mɔcɛ Ufestu atsu umbɔ akũ Uburhu atsĩwã. <verse eid="ACT 25:23"/><verse number="24" style="v" sid="ACT 25:24"/>Ufestu agɛ, &lt;&lt;A uyɛrhe Uagiripa, nu kishoo abirabɛ aka awu nggimi nggu umɛn, umbi anyã utsak uwurɛ! Abi Uyahuda kishoo aka atsu arherhe ri itsinga ru umum ru Urusharhima nu nggimi ru Ukaisariya, atsuyi ivum agɛ isi imɛ̃ngge umbɔ neke unga abɛk. <verse eid="ACT 25:24"/><verse number="25" style="v" sid="ACT 25:25"/>Bɔr umum inyã unga asi ikorhunga ubinkpi umbɔ aka ifɛre unga. Ubinkutsu unga nibikanga abee arherhanga azĩ ra asu uwuku ugɔng Ukaisar, umum idene unga azĩã Uroma. <verse eid="ACT 25:25"/><verse number="26" style="v" sid="ACT 25:26"/>Bɔr umum ishimum ru undzumu ubinkpi umum iki itsɛnge uyɛrhe uwuku ugɔng ru Uroma ri itsinga. Ngge iki iwe rimi umum ikũ unga iba ru umbi kishoo, undzumunga ru ungo uyɛrhe Uagiripa, inggɛ umɛn ĩba irhi arherhe ha imaamɛn umum ima ikpo ubinkpi umum iki itsɛng. <verse eid="ACT 25:26"/><verse number="27" style="v" sid="ACT 25:27"/>Ubinkutsu ri inyĩnyãmum, awu ijijam umbɔ adene uner ugborzĩ ru uwuku ugɔng Ukaisar na asi ikpombɔ undzumu arherhe ha umbɔ aka itsɛng.&gt;&gt;<verse eid="ACT 25:27"/></para>
  <chapter eid="ACT 25"/>
  <chapter number="26" style="c" sid="ACT 26"/>
  <para style="s1">Uburhu akaa itsinga ra asu Uagiripa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1"/>Mɔcɛ Uagiripa agɔr Uburhu agɛ, &lt;&lt;Adzaambɔ ijeea ungo ukaa itsingo.&gt;&gt;</para>
  <para style="p" vid="ACT 26:1">Nggee Uburhu aberu uboknga, atirhi arherhe agɛ, <verse eid="ACT 26:1"/><verse number="2" style="v" sid="ACT 26:2"/>&lt;&lt;A uyɛrhe Uagiripa, umum inyãmum iwu ra andzui iki iwe ugɛ awu ru ungo umum idɛ̃ɛ̃ ikaa itsimum irherɛ ru urherhe anggbaashi abi Uyahuda iki irherhe ri itsimum, <verse eid="ACT 26:2"/><verse number="3" style="v" sid="ACT 26:3"/>undzumunga ugɛ ungo uhwɛngo ibibayi abi Uyahuda nu abinkɛ umbɔ iki iwe ru uning ra ake. Nggee, uma udɔɔr amɛnngo ukpeto ru umum.<verse eid="ACT 26:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4"/>&lt;&lt;Abi Uyahuda kishoo ahwɛngmbɔ ikpũ isiseimum utirhi ri iwɛdzɛmmum, ra abĩmɛn nu ru Urusharhima uba utsĩ irherɛ. <verse eid="ACT 26:4"/><verse number="5" style="v" sid="ACT 26:5"/>Ahwɛngmbɔ umum utirhi ri iwɛdzɛm. Umbɔ aba abemumbɔ, adɛ̃ɛ̃ idzowukumbɔ ideka ri itsimum ugɛ umum iwu ru ukpui agbeyamɛn ukpuku uwu utsotsorakpɔ, umum iwu utsa Ufarisi. <verse eid="ACT 26:5"/><verse number="6" style="v" sid="ACT 26:6"/>Ubinkutsu umbɔ avarhuwa umum arherhe irherɛ, awu ififosa ru ubinkpi Unum aka abemuwe atokamɛn. <verse eid="ACT 26:6"/><verse number="7" style="v" sid="ACT 26:7"/>Awu ibibemuwe ha riyɛ idũmɛn usɔkdũmɛn aka afosa abee inyã ngge itsuifɛr. Ngge itsu umbɔ aka amina asumbɔ adɔsu Unum ru utsuu ra atenum. A uyɛrhe, awu ififosa ha itsu anggbaashi abi Uyahuda agɔr agɛ umum iwu ru uvau. <verse eid="ACT 26:7"/><verse number="8" style="v" sid="ACT 26:8"/>Awu use utsu umbi ashimbi ri imangmang ugɛ Unum adɛ̃ɛ̃ asoyika abika akpe?<verse eid="ACT 26:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9"/>&lt;&lt;Umum nibikami isha inyã ugɛɛ awu ufang umum ikorha abina arhɛrhɛ akika akpɛ̃ itsok Uyesu uner Unazarat. <verse eid="ACT 26:9"/><verse number="10" style="v" sid="ACT 26:10"/>Ubinkpi umum iki ikorhe nukpɔ ru Urusharhima, umum iki ikpo ijee ra ateiya abika adzowe idɛm-Num iyiki igbange asarkasar anera arhɛrhɛ ru ugborzĩ. Ivangyɛ umbɔ aka itsu ufai akpe ru umbɔ, umum iwu ru undzing abika atsu ufai ha. <verse eid="ACT 26:10"/><verse number="11" style="v" sid="ACT 26:11"/>Ivanga irhɛirhɛ umum iki ĩdɔsa abã ifɛn-Num kishoo idzise umbɔ uver, ni ibee itsu umbɔ arheni itsok Uyesu. Umum igũ avɔm nggu umbɔ akarhãrhã nggee umum ikɛn umbɔ ri iteu iyɔɔ iyi abĩ akase idzowe umbɔ uver.<verse eid="ACT 26:11"/></para>
  <para style="s1">Uburhu asɔm idzidzipanga</para>
  <para style="r">(<ref loc="ACT 9:1-19">9.1-19</ref>; <ref loc="ACT 22:6-16">22.6-16</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12"/>&lt;&lt;Ru uzɛ̃rhã ukpu ifɛrha ha umum iwuri izĩ Udimashku, ri ijee ateiya abika adzowe idɛm-Num. <verse eid="ACT 26:12"/><verse number="13" style="v" sid="ACT 26:13"/>Aka ayoka atenuma, a uyɛrhe, umum iwu ru utsĩndĩ ni inyã irhirhang iyɔɔ iki inangngge irhirhang ishaa unum irhang idzeka afã, iba idzipa umum nggu awɛrhu uzɛ̃rhãmum. <verse eid="ACT 26:13"/><verse number="14" style="v" sid="ACT 26:14"/>Umɛn kishookamɛn igba ra abĩ, nu umum igũ urhɛm ukpɔɔ ri idũ abi Uyahuda, uku ugɔr umum ugɛ, &lt;A Ushawurhu, a Ushawurhu, awu use utsu ungo udzaa umum uver? Ungo ukpurhu unayiwe itsingo, ru nyaki inak iki igbopi itsingge nggu igbong uner ughãwã.&gt;<verse eid="ACT 26:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 26:15"/>&lt;&lt;Mɔcɛ umum irhusa inggɛ, &lt;Awu ungo ungaa Uteijee?&gt;</para>
  <para style="p" vid="ACT 26:15">&lt;&lt;Uteijee agɔr umum agɛ, &lt;Awu umum Uyesu uwu ungo uku udzowe uver. <verse eid="ACT 26:15"/><verse number="16" style="v" sid="ACT 26:16"/>Bɔr icɛrɛ usisok udidɛ̃ɛ̃ nu adakngo. Umum idzeka ru ungo ibee isɛng ungo uwu uner itsermum nu uwu ideka ubinkpi ungo uku unyã ru umum nu abinkɛ umum iki idɛyiwa ungo. <verse eid="ACT 26:16"/><verse number="17" style="v" sid="ACT 26:17"/>Umum iwuri ifɔrhamum ungo ra anerngo nu atsen abi Uyahuda umum iki idena ungo uzĩ ru umbɔ. <verse eid="ACT 26:17"/><verse number="18" style="v" sid="ACT 26:18"/>Ungo iyanguwe asumbɔ, umbɔ adzipa adzek ru uzĩ aba ri irhirhang, na adzeki ijee Ushaitan aba ru Unum, ngge itsú umbɔ ama akpo itsũwe arhim, na ama akpo anang nggu abirabɛ umbɔ aka asɛng umbɔ ru ubok imangmangmbɔ ru umum.&gt;<verse eid="ACT 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19"/>&lt;&lt;Nggee a uyɛrhe Uagiripa, umum isi ikpɛ̃mum idɔsa irhiyɛ iki idzeka afã iba ru umum. <verse eid="ACT 26:19"/><verse number="20" style="v" sid="ACT 26:20"/>Umum itirhi idzowe isarhe ra aner Udimashku imaa ni idzowe aner Urusharhima nu Uyahudiya kishoo, ikɛi ni indzowe isarhe ra atsen abi Uyahuda, inggɛ umbɔ adzipa aba ru Unum, akorha abinkɛ aka idɛyiwe idzidzipambɔ. <verse eid="ACT 26:20"/><verse number="21" style="v" sid="ACT 26:21"/>Ngge itsu abi Uyahuda adzur umum ru ufɔm Iya-Num abee ifɛre umum. <verse eid="ACT 26:21"/><verse number="22" style="v" sid="ACT 26:22"/>Bɔr Unum unga ayika umum ĩba itsĩ irherɛ, ngge itsu umum iwu nggimi ni indzowe ideka ra akagɔng nu akaci. Isi irherhumum abin akase bɔr abin abika asɔm Arherhu-Num nu Umusa aka arherhe agɛ iwuri ikorhe rimi, <verse eid="ACT 26:22"/><verse number="23" style="v" sid="ACT 26:23"/>ugɛ awu ufang Ukiristo ahwa uver, na awu unggbaashi uwuku usok ra akpe, na adũwũ irhirhang ififɔrh ra anernga nu atsen abi Uyahuda.&gt;&gt;<verse eid="ACT 26:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24"/>Uburhu anu ikaa itsinga nukpi Ufestu abvutuwe arherhe Uburhu. Atsarhi irhaknga agɛ, &lt;&lt;A Uburhu, ungo uku uzhɔma! Idzursungo akarhãrhã iki idzipukungge itsingo.&gt;&gt;<verse eid="ACT 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25"/>Bɔr Uburhu agɛ, &lt;&lt;A uteiya Ufestu, isi izhɔmum ukpong. Ubinkpi umum iki irherhe uwu idzidzɛrhe nu uwu ubin ukpuku uyɛi. <verse eid="ACT 26:25"/><verse number="26" style="v" sid="ACT 26:26"/>Ungo uyɛrhe ungo uhwɛngo abina akɛrɛ, umum isi igũmum iwei irherha ake ru ungo. Umum ihwɛng ungo uku ugũo abin hã kishoo, ubinkutsu, asi ikorhumbɔ ake ri iwɔk. <verse eid="ACT 26:26"/><verse number="27" style="v" sid="ACT 26:27"/>A uyɛrhe Uagiripa, ungo udzowukɔ imangmang abika asɔm Arherhu-Num? Umum ihwɛng ungo ubemungo.&gt;&gt;<verse eid="ACT 26:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28"/>Mɔcɛ Uagiripa agɔr Uburhu agɛ, &lt;&lt;Ungo utsar ugɛ ri ungwɛ̃rhĩ ivang iyɛrɛ ungo ubee itsu umum iwu uner Ukiristo?&gt;&gt;<verse eid="ACT 26:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 26:29"/>Uburhu agɛ, &lt;&lt;Ivang iki ici use iyiki ider, umum ifɛn-Num asi íwea ungo ukpekũ, bɔr kishoo abika akpeto ru umum irherɛ, awe ru nyaka umum, bɔr niba awembɔ ri inyãwã iyɛrɛ.&gt;&gt;<verse eid="ACT 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30"/>Uyɛrhe nu ugomna nu Ubani na abirabɛ aka asei nggu umbɔ asisok. <verse eid="ACT 26:30"/><verse number="31" style="v" sid="ACT 26:31"/>Umbɔ aka adzek ru ubã ha, umbɔ anu arherhe nggu adɔka, umbɔ agɔr agɛ, &lt;&lt;Utsak uwurɛ asi ikorhunga ubinkpi uku umɛ̃ɛ̃ igbigbang ru ugborzĩ use akpe.&gt;&gt;<verse eid="ACT 26:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 26:32"/>Uagiripa agɔr Ufestu agɛ, &lt;&lt;Utsak uwurɛ abee umbɔ akũ arherhanga azĩ ra asu Ukaisar, uda umbɔ atsũwũkumbɔ unga.&gt;&gt;<verse eid="ACT 26:32"/></para>
  <chapter eid="ACT 26"/>
  <chapter number="27" style="c" sid="ACT 27"/>
  <para style="s1">Uburhu atsĩ ukhukhɔɔ amɛ̃ <optbreak/> azĩã Uroma</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1"/>Ivanga iki iwe umɛn iki igar izĩ abĩ Uitarhiya, umbɔ atsuke Uburhu nu abi ugborzĩ abɔɔ ru ubok uteiya abi iwa Uroma uwɔɔ itsoka igburh Ujurhiyo, unying ru ukpui abi iwa Ukaisar. <verse eid="ACT 27:1"/><verse number="2" style="v" sid="ACT 27:2"/>Umɛn iki itsĩ ukhukhɔɔ amɛ̃ uku udzeku Uadiramitiyum, uku uwuri utsĩrhĩ ifɛn akau iteu iyɔɔ iyiki iwe ra abĩ Uasiya, umɛn itsĩ uzɛ̃rhã ru ukau azɛ̃ akagɔng. Uaristaku, utsa Utasarhonika ra abĩ Umakidoniya, awu nggu umɛn.<verse eid="ACT 27:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 27:3"/>Unum uvaa umɛn itsĩmɛn Usidon. Ujurhiyo amutuwe Uburhu, aneke unga azĩ anyã awɛrhanga umbɔ adzowe ubinkpi unga aka abee. <verse eid="ACT 27:3"/><verse number="4" style="v" sid="ACT 27:4"/>Umɛn iki isok umɔ ru ukhukhɔɔ amɛ̃ hã itsĩmɛn azɛ̃ akagɔng, ugba ukɛnkpɔ umɛn uzɛ̃rhã. Nggee umɛn ikɔre udiku undzing Usayifuru ra anangkɛ ugba usi ikerkpɔ. <verse eid="ACT 27:4"/><verse number="5" style="v" sid="ACT 27:5"/>Umɛn iki igar ukau azɛ̃ akagɔng hã ukpuku ukhapa ra abĩ Ukirhikiya nu Upamfirhiya, umɛn icipa ru uteu Umira ra abĩ Urhikiya. <verse eid="ACT 27:5"/><verse number="6" style="v" sid="ACT 27:6"/>Umɔ uteiya abi iwa Uroma aka akpo ukhukhɔɔ uwɔɔ uku udzeku Uarhekzandiriya uwuri izĩ abĩ Uitarhiya, unga atsu umɛn ru uwu ha. <verse eid="ACT 27:6"/><verse number="7" style="v" sid="ACT 27:7"/>Umɛn uzɛ̃rhã uku utɔɔɔ imaa inuma irhɛirhɛ nggu uver, umɛn iki ikhapa ru uteu Ukinidu, ugba ukɛnkpɔ umɛn izĩ ra asu, umɛn ikɔre udiku ubang ukau Ukirit afɛn akirakɛ aka ashike ru ugba uku uker, aka akhapa ru Usarhmoni. <verse eid="ACT 27:7"/><verse number="8" style="v" sid="ACT 27:8"/>Umɛn igũ uver ni itɔng ubang ukau Ukirit izĩ itsĩ anang akɔɔ umbɔ iki iyisa Anang Akika Ufɔrh, aka akhapa ru uteu Urhasiya.<verse eid="ACT 27:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9"/>Uzɛ̃rhãmɛn ughawe ivanga irhɛirhɛ. Mɔcɛ igbigba iwe ru uzɛ̃rhã hã. Ubinkutsu unum ikpem igha ubin uku utɔngkpɔ. Nggee Uburhu adzowe umbɔ itsũwã agɛ, <verse eid="ACT 27:9"/><verse number="10" style="v" sid="ACT 27:10"/>&lt;&lt;Umum inyã uzɛ̃rhã hã uwuri iwu igba abĩ ra asu, ukhukhɔɔmɛn nu abinmɛn nu urhɛmɛn uwuri igba abĩ.&gt;&gt; <verse eid="ACT 27:10"/><verse number="11" style="v" sid="ACT 27:11"/>Bɔr uteiya abi iwa asi ibemunga ubinkpi Uburhu aka arherhe, akpurha atsu amɛnnga ru uner ukhukhɔɔ nu uteiya ukhukhɔɔ ha. <verse eid="ACT 27:11"/><verse number="12" style="v" sid="ACT 27:12"/>Ngge iki isi izengge umbɔ agha idoi ru anang hã, irhɛmbɔ ibemumbɔ izɛ̃rhã azĩ ra asu, afosi izĩ atsĩ Ufinikiya, ngge iba imɛ̃ngge umbɔ agha idoyi umɔ. Akɛrɛ awu anang idɛ̃ɛ̃ akɔɔ aki akhukhɔɔ ru Ukirit aka arhi udiku unɔr uwu urhɛɛ nu ufã uwu urhɛɛ.<verse eid="ACT 27:12"/></para>
  <para style="s1">Ufin inai nu ugba ukau</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13"/>Ivangyɛ ugba ukpuku udzek unɔr utirhi ifɛu uku utɔɔɔ, anera atsar agɛ ubinkpi umbɔ aka abee uku ukpokpɔ, nggee umbɔ agbiir uzɔu ukpuku ukpɔm ukhukhɔɔ ha adɔsu ifɛn ukau uku ukhapa ru Ukirit. <verse eid="ACT 27:13"/><verse number="14" style="v" sid="ACT 27:14"/>Isi idãrhũngge ugba ukpɔɔ ugɔgɔngakpɔ ukpurukpi umbɔ iki iyisa ugba ufã uwu igɔ̃kpee, uku udzeku umpfũwã abĩ hã. <verse eid="ACT 27:14"/><verse number="15" style="v" sid="ACT 27:15"/>Ugba ha uku ukwɛr ukhukhɔɔ ha umgbɔ ufɔr irhi udiku ugba ha uda umgbɔ, umɛn idiki neke ugbaka uyii umɛn. <verse eid="ACT 27:15"/><verse number="16" style="v" sid="ACT 27:16"/>Umɛn iki idɔsu udiku umpfũwã uku uci umbɔ iki iyisa Ukauda, afɛnkɛ aka ashike ru ugba, umɛn igũ uver ni idɔrhi igbiir ukhukhɔɔ uwuku uci uwuku ukhapa ru ukhukhɔɔ ha. <verse eid="ACT 27:16"/><verse number="17" style="v" sid="ACT 27:17"/>Ivangyɛ anera aka agbiir ukhukhɔɔ ha atsĩ ru ukugɔnga, mɔcɛ umbɔ akũ arhi aboyi adzipa ukhukhɔɔ ukugɔng hã utsur umgbɔ uyarmgbɔ. Ikɛi umbɔ acipukumbɔ utatorho atorho ukhukhɔɔ ha na aneke ugba uyii ukhukhɔɔ ha. Umbɔ akorhe rimi ubinkutsu agũ iwei utsur umbɔ atsĩmbɔ uzuzeu Usiriti. <verse eid="ACT 27:17"/><verse number="18" style="v" sid="ACT 27:18"/>Unum uvaa ugba utsokpɔ akarhãrhã, utsu umbɔ atirhi akarh abinkɛ aka awe ru ukhukhɔɔ ha atsuyiwe ra amɛ̃. <verse eid="ACT 27:18"/><verse number="19" style="v" sid="ACT 27:19"/>Ru unum untaar, umbɔ atãyĩwe abin akɔɔ ikɛi aki itser ukhukhɔɔ ha. <verse eid="ACT 27:19"/><verse number="20" style="v" sid="ACT 27:20"/>Umɛn iki imaa inuma isi inyãmɛn ishaa unum use ídzɛɛr, nggaa ugba ukpu ufin inai ukpurhu udɛ̃ɛ̃ ikwɛr umɛn, umɛn isi ifosumɛn ibibɛk.<verse eid="ACT 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21"/>Aka adera anera aka asi ighambɔ ubingha, Uburhu asok adɛ̃ɛ̃ ra ateumbɔ na agɛ, &lt;&lt;Umbi anera, uda umbi agũmbi arherhamum iki igɔr ugɛ niba asombi ru ubang umpfũwã abĩ Ukirit, uda umɛn isi itsĩmɛn igba abĩ nggu ididak iyɛrɛ. <verse eid="ACT 27:21"/><verse number="22" style="v" sid="ACT 27:22"/>Bɔr icɛrɛ umum idzaa umbi itsũwã àka awe ri ikeramɛn, unera asi íkpea ru umbi, bɔr ukhukhɔɔ ha uwuri iyar ukpekũ. <verse eid="ACT 27:22"/><verse number="23" style="v" sid="ACT 27:23"/>Ubinkutsu utsuu ukpu arhɛkɛ ipfu itser iyiki idzeku Unum uwuruwi umum iki iwu uwu unga ni itɔ̃ itsernga, idɛ̃ɛ̃ akhapa ru umum, <verse eid="ACT 27:23"/><verse number="24" style="v" sid="ACT 27:24"/>igɔr igɛ, &lt;Niba ugũo iwei, Uburhu. Awu ufang ungo iki idɛ̃ɛ̃ ra asu Ukaisar umbɔ avarhuwa arherhango, nggayɛ Unum ri imimutanga aka afɔrhuka abirabɛ aka uzɛ̃rhã nggu ungo.&gt; <verse eid="ACT 27:24"/><verse number="25" style="v" sid="ACT 27:25"/>Nggee àka awe ri ikeramɛn, ubinkutsu umum iwemum ri imangmang ru Unum abin hã umbɔ aka arherhuwa umum, iwuri iwe rimi hã. <verse eid="ACT 27:25"/><verse number="26" style="v" sid="ACT 27:26"/>Bɔr awu ufang ugba utare umɛn nu ubang umpfũwã abĩ akɔɔ.&gt;&gt;<verse eid="ACT 27:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27"/>Ru utsuu ukpu usɔka na anaa, ugba ukpurhu adɛ̃ɛ̃ ikikɛn umɛn ru ukau akagɔng Umeditereniya, aka ayoka ikɔtsuuka abika akpai ukhukhɔɔ ha akaifɛrhkɔ agɛ umɛn iki ikhapumɛn abĩ. <verse eid="ACT 27:27"/><verse number="28" style="v" sid="ACT 27:28"/>Umbɔ amei ighor amɛ̃ anyã ake atsĩke adaka unaka nu isɔka ivaa. Umɛn iki igɔpa izĩ ukunjiir umbɔ amei ikɛi, akpo ighor amɛ̃ adaka isɔka utɔɔrha. <verse eid="ACT 27:28"/><verse number="29" style="v" sid="ACT 27:29"/>Agũ iwei utsur ukhukhɔɔ ha ugbopumgbɔ nggu atarh, umbɔ acipuwe azɔu akika amor anaa udiku undzing ukhukhɔɔ ha, utsur umgbɔ uzɛ̃rhumgbɔ uzɛ̃rhã iki ifefetem. Umbɔ atsĩmbɔ ifɛn-Num ukpee usar ifetem. <verse eid="ACT 27:29"/><verse number="30" style="v" sid="ACT 27:30"/>Abika akpai ukhukhɔɔ ha abee itĩ adzek ru ukhukhɔɔ ha. Nggee umbɔ acipuwe ukhukhɔɔ uwuku uci, akpeta agɛ umbɔ awuri icipuwe azɔu akika amor ra asu ukhukhɔɔ ukugɔng. <verse eid="ACT 27:30"/><verse number="31" style="v" sid="ACT 27:31"/>Mɔcɛ Uburhu agɔr uteiya abi iwa Uroma nu abi iwa ha agɛ, &lt;&lt;Anera abɛrɛ aba asi idɛ̃ɛ̃mbɔ ru ukhukhɔɔ ha, umbi asi íbɛkmbi.&gt;&gt; <verse eid="ACT 27:31"/><verse number="32" style="v" sid="ACT 27:32"/>Igũ rimi itsu abi iwa azharhuwe arhi ukhukhɔɔ uku uci ha, aneke umgbɔ uzĩmgbɔ.<verse eid="ACT 27:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33"/>Ukpee uku uwuri isar Uburhu ashɔ̃rhã umbɔ kishoo ama agha ubingha, agɔr agɛ, &lt;&lt;Irherɛ awu unum ukpu usɔka nu anaa nukpi umbi aka asei ri iwei, asi ighambi ubin. <verse eid="ACT 27:33"/><verse number="34" style="v" sid="ACT 27:34"/>Nggee umum ishɔ̃rhã umbi àka agha ubingha na abɛk. Igwar unermbi unying isi ígwirngge ri itsinga.&gt;&gt; <verse eid="ACT 27:34"/><verse number="35" style="v" sid="ACT 27:35"/>Unga aka arherhe rimi amaa, unga anyangu uborodi atar uwɛɛ ru Unum ra asumbɔ kishoo. Mɔcɛ unga azharhe atirha atãi. <verse eid="ACT 27:35"/><verse number="36" style="v" sid="ACT 27:36"/>Kishookambɔ akpo ikeramɛn na agha ubingha. <verse eid="ACT 27:36"/><verse number="37" style="v" sid="ACT 27:37"/>Umɛn kishoo ru ukhukhɔɔ ha iwu inera inaka ivaa ni isɔka utɔɔva nu utɔ̃ĩ (276). <verse eid="ACT 27:37"/><verse number="38" style="v" sid="ACT 27:38"/>Umbɔ aka agha ashur, umbɔ atsũwe imor ukhukhɔɔ ha atare ishaa abin ra amɛ̃.<verse eid="ACT 27:38"/></para>
  <para style="s1">Ukhukhɔɔ ha uyarmgbɔ</para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39"/>Ivangyɛ ukpee uku usar abika akpai ukhukhɔɔ ha asi ihwɛngmbɔ abĩkɛ umbɔ aka awe, bɔr umbɔ anyã avarha akɔɔ aka awe ru uzuzeu, umbɔ abee ikũ ukhukhɔɔ ha azĩ afata umɔ. <verse eid="ACT 27:39"/><verse number="40" style="v" sid="ACT 27:40"/>Umbɔ atenge arhisa kishoo aki azɔu akika amor, abɔre ake ru ukau. Ri ivang hã umbɔ agarhuwe ubin ukpuku udzipu ukhukhɔɔ ha. Umɔ umbɔ aberuwe utatorho aka awe ra asu ukhukhɔɔ ha na akũ adzur ugba uku iyira umgbɔ ra asu na azĩmbɔ udika abĩ. <verse eid="ACT 27:40"/><verse number="41" style="v" sid="ACT 27:41"/>Bɔr ukhukhɔɔ ha ukwɛr uzuzeu utsĩ ra amɛ̃ ukãã ufɔr idzidzipa udamgbɔ, ukhukhɔɔ ha utirhi iyata udiku undzing itso amɛ̃ aka aker uke.<verse eid="ACT 27:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42"/>Abi iwa abee ifɛre abi ugborzĩ, utsur uwɔɔ ru umbɔ akwɛr izoyi adzek atĩã. <verse eid="ACT 27:42"/><verse number="43" style="v" sid="ACT 27:43"/>Bɔr uteiya abi iwa Uroma abee ifɔrhe Uburhu, akɛna umbɔ. Atsu umbɔ kishoo uwuruwi aka ahwɛnga ikwɛr izoyi unga ateer isha atsĩ ra amɛ̃ akwɛr izoyi agar nu abĩ. <verse eid="ACT 27:43"/><verse number="44" style="v" sid="ACT 27:44"/>Uteiya abi iwa ha atsu abika abubɔr afũ uakatako, abɔɔ afũ avɛtu ukhukhɔɔ ha. Rimi umbɔ kishoo aka afɔrh azĩ atsĩ nu abĩ.<verse eid="ACT 27:44"/></para>
  <chapter eid="ACT 27"/>
  <chapter number="28" style="c" sid="ACT 28"/>
  <para style="s1">Nu ubang umpfũwã abĩ Umarhta</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1"/>Umɛn iki ifɔrh itsĩ ubang umpfũwã abĩ hã, umɛn irhusa igũ itsok anang hã igburh Umarhta. <verse eid="ACT 28:1"/><verse number="2" style="v" sid="ACT 28:2"/>Abi anang hã amatuwa umɛn akarhãrhã. Inai idoi, ananga aghɛnga, umbɔ ataiwa umɛn urha na ayɛi umɛn iwɛr urha. <verse eid="ACT 28:2"/><verse number="3" style="v" sid="ACT 28:3"/>Uburhu akarh itokũ atsuyi ru urha. Imanu urha itsu ighwɛr idze ikpɔɔr ni izũrhã nu uboknga. <verse eid="ACT 28:3"/><verse number="4" style="v" sid="ACT 28:4"/>Ivangyɛ abi umpfũwã hã aka anyã ngge iki izũrhã nu ubok Uburhu, umbɔ agɔr adɔkambɔ agɛ, &lt;&lt;Idzidzɛrhe utsak uwurɛ awu uner uwuku ufɛyi aner, àka anyã unga aka abɛk ru ukau ukpuku ugɔng, rimi hã kishoo iyiki ibewe ina idɔsa unga awuri ikpea.&gt;&gt; <verse eid="ACT 28:4"/><verse number="5" style="v" sid="ACT 28:5"/>Bɔr Uburhu azusu uboknga atsukuka ibvui ha ru urha, isi inayikungge unga. <verse eid="ACT 28:5"/><verse number="6" style="v" sid="ACT 28:6"/>Anera akau ra amɛnmbɔ agɛ anang hã awuri isengke use unga awuri igba ra abĩ akpe, bɔr umbɔ aka adãrhã asi inyã ifɛrhɛ ikorhungge nggu unga, umbɔ agɛ awu unum.<verse eid="ACT 28:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7"/>Ídɛɛ niyɔ ikhapa umɔ ra anang hã, iwu iyi Upubirhiyu, unga awu uyɛrhe umpfũwã hã. Unga ayɛi umɛn ri iyanga, na akorhuwa umɛn inna inuma itaar. <verse eid="ACT 28:7"/><verse number="8" style="v" sid="ACT 28:8"/>Utɛ Upubirhiyu aghonga unga, iyora imani anu nggu isurhã. Uburhu atsĩ ru unga afɛne-Num nu unga, atsorha abok nu unga na akerhuwe unga. <verse eid="ACT 28:8"/><verse number="9" style="v" sid="ACT 28:9"/>Ivangyɛ ifɛrha ha iki ikorhe, kishoo abi irhãrhã aka abɔr ru umpfũwã abĩ hã aka aba, akerhumbɔ. <verse eid="ACT 28:9"/><verse number="10" style="v" sid="ACT 28:10"/>Umbɔ adzaa umɛn igɔng ra atsĩndĩã arhɛrhɛ. Umɛn iki iwuri isok ru ukhukhɔɔ amɛ̃ ukugɔng, umbɔ akɔng abinkɛ umɛn iki ibee adzaa umɛn.<verse eid="ACT 28:10"/></para>
  <para style="s1">Uburhu ru Uroma</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11"/>Afɛ̃ɛ̃ ataar aka amaa umɛn isok ru ukhukhɔɔwi uku ugha idoyi ru umpfũwã abĩ hã, uwuku udzeku Uarhekzandiriya. Ra asu ukhukhɔɔ ha umbɔ aka atsɛ̃ uzirhzĩ akãrhghwɛ̃ anum. <verse eid="ACT 28:11"/><verse number="12" style="v" sid="ACT 28:12"/>Umɛn iki itsĩ uteu Usiraku umɛn imaa inuma itaar umɔ. <verse eid="ACT 28:12"/><verse number="13" style="v" sid="ACT 28:13"/>Umɔ umɛn isok izĩmɛn ru uteu Urigiyum. Umɛn imaa unuma unying, ukpee uku usar ugba ukpu unɔr uba, unum uvaa umɛn itsĩmɛn Uputiyorhi. <verse eid="ACT 28:13"/><verse number="14" style="v" sid="ACT 28:14"/>Ru Uputiyorhi umɛn iki igbopa angwɛ̃mɛn nu anapumɛn umbɔ ashɔ̃rhã umɛn imaa inuma utɔɔva nggu umbɔ. Ri imimasha umɛn ĩba itsĩ Uroma. <verse eid="ACT 28:14"/><verse number="15" style="v" sid="ACT 28:15"/>Angwɛ̃mɛn nu anapumɛn ru Uroma aka agũ isarhamɛn, umbɔ adzek aba agbanga umɛn. Abɔɔ adzeki Izɛɛ Uaffiyu, abɔɔ adzeka anangkɛ umbɔ iki iyisa Aya Atsen Ataar. Uburhu aka anyãmbɔ unga atar uwɛɛ ru Unum, na awe ru ikeramɛn. <verse eid="ACT 28:15"/><verse number="16" style="v" sid="ACT 28:16"/>Ivangyɛ umɛn iki itsĩ Uroma, umbɔ abemuwe Uburhu unga azĩ asei ikiyikanga nggu uner iwa abirabɛ aka adzɛu unga ri iyakɛ umbɔ aka afai uhwɛk.<verse eid="ACT 28:16"/></para>
  <para style="s1">Isarhe Uburhu ru Uroma</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17"/>Inuma itaar iki imaa, Uburhu ayisa anggbaashi abi Uyahuda umɔ. Umbɔ aka akɔng Uburhu agɔr umbɔ agɛ, &lt;&lt;Umbi angwɛ̃mɛn nu anapumɛn, umum ihwɛngmum isi igbamum uvau ra anermɛn use ra agbeyi atokamɛn, bɔr umbɔ adzur umum ru Urusharhima adzowe umum ra abok abi ijee Uroma. <verse eid="ACT 28:17"/><verse number="18" style="v" sid="ACT 28:18"/>Umbɔ aka arhisa umum abee itsũwe umum, ubinkutsu, asi ikpombɔ umum nggu uvau uwu ubinkpi umbɔ aka ifɛre umum. <verse eid="ACT 28:18"/><verse number="19" style="v" sid="ACT 28:19"/>Bɔr anggbaashi abi Uyahuda aka akpɛ̃mbɔ, ngge iwu ufang ru umum ikũ arherhunga umɛn izĩmɛn ra asu Ukaisar. Isi iwengge ugɛ umum itsu arherhe abimɛn. <verse eid="ACT 28:19"/><verse number="20" style="v" sid="ACT 28:20"/>Akɛrɛ ha atsu umum ibee inyã umbi ni ikɛki itsũwã nggu umbi. Ubinkutsu awu ubinkpi abi Uisrairha aka afosa itsu umbɔ abow umum nggu inyãwã iyɛrɛ.&gt;&gt;<verse eid="ACT 28:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21"/>Umbɔ agɔr unga agɛ, &lt;&lt;Umɛn isi ikpomɛn ubvur uku udzeku Uyahudiya uba ru umɛn ri itsingo, use ungwɛ̃mɛn use unapumɛn uwɔɔ aba nggimi nggu isarhe iyiki ibewe ri itsingo. <verse eid="ACT 28:21"/><verse number="22" style="v" sid="ACT 28:22"/>Bɔr umɛn ibee igũ ubinkpi ungo iki irherhe, ubinkutsu umɛn ihwɛng anera ri inanga kishoo arherhe iyiki ibewe ru ukpui ukpɛrɛ ha.&gt;&gt;<verse eid="ACT 28:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23"/>Nggee umbɔ atsũ unumkpi umbɔ aka igbopa nggu Uburhu. Unum hã uku uwe umbɔ awu arhɛrhɛ aka aba ra anangkɛ Uburhu aka asei. Udzur ru ukpeeka uba utsĩ urhɛɛ unga akpurha adɛ̃ɛ̃ idɛyiwe umbɔ arherhe ri itsi Iyɛrhe Unum abee itsu umbɔ ahwɛng Uyesu ru utsĩndĩ Íkpem Umusa na abvur abika asɔm Arherhu-Num. <verse eid="ACT 28:23"/><verse number="24" style="v" sid="ACT 28:24"/>Abɔɔ abemumbɔ ubin hã unga aka arherhe, bɔr abɔɔ ashimbɔ ri imangmang. <verse eid="ACT 28:24"/><verse number="25" style="v" sid="ACT 28:25"/>Nggee umbɔ atsĩmbɔ uning nggu adɔkambɔ, na atirhi ibɔre anang hã, Uburhu aka amaa irherhuwe umbɔ arherhe agɛ, &lt;&lt;Ipfu Isarsatangge irherhe idzidzɛrhe ru atokamɛn ra angwĩ uner uwuku usɔm Arherhu-Num Uishaya igɛ,<verse eid="ACT 28:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 28:26"/>&lt;&lt; &lt;Uzĩ ra anera abɛrɛ, ugɔr ugɛ,</para>
  <para style="q1" vid="ACT 28:26">&lt;&lt;Umbi awuri igũmbi ubɛn unuma bɔr asi íhwɛngmbi,</para>
  <para style="q2" vid="ACT 28:26">umbi awuri irhirhi umbi ubɛn unuma bɔr asi ínyãmbi.&gt;&gt;<verse eid="ACT 28:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27"/>Ubinkutsu amɛn anera abɛrɛ awu akerketake,</para>
  <para style="q2" vid="ACT 28:27">aka afɔmukumbɔ atombɔ,</para>
  <para style="q2" vid="ACT 28:27">umbɔ aka abvurkumbɔ asumbɔ,</para>
  <para style="q1" vid="ACT 28:27">utsur umbɔ anyãmbɔ nggu asumbɔ,</para>
  <para style="q2" vid="ACT 28:27">utsur umbɔ agũmbɔ nggu atombɔ,</para>
  <para style="q2" vid="ACT 28:27">na ahwɛngmbɔ nggu amɛnmbɔ,</para>
  <para style="q1" vid="ACT 28:27">na idzipa aba ru umum ikerhukũ umbɔ.&gt;<verse eid="ACT 28:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28"/>&lt;&lt;Umum ibee umbi ahwɛng agɛ Unum aka adene isarhe ififɔrh iyɛrɛ ra atsen abi Uyahuda, nu umbɔ awuri ikpembɔ ato.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">28.28 </char><char style="ft" closed="false">Abvur akɔɔ aki itsɛng abok aki isha agɔrke ikɛi ugɛ, </char><char style="fv" closed="false">29 </char><char style="fqa" closed="false">Unga aka arherhe rimi, mɔcɛ abi Uyahuda asok umɔ adɛ̃ɛ̃mbɔ uning utsotsoramgbɔ nggu adɔkambɔ!</char></note><verse eid="ACT 28:28"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30"/>Imɛka ivaa Uburhu asei ri iyakɛ umbɔ aka afai uhwɛk, ayɛi kishoo abika aba ru unga. <verse eid="ACT 28:30"/><verse number="31" style="v" sid="ACT 28:31"/>Unga adzowe isarhe Iyɛrhe-Num, amesuwe abin aki Uteijee Uyesu Ukiristo asi igũa iwei, unera asi ikɛna unga.<verse eid="ACT 28:31"/></para>
  <chapter eid="ACT 28"/>
</usx>
