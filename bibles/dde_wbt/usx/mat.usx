<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Dondo</book>
  <para style="h">MATAYI</para>
  <para style="toc3">Mat</para>
  <para style="toc2">Matayi</para>
  <para style="toc1">Musamu Wumbote wu Matayi</para>
  <para style="mt2">Masumu wumbote wu</para>
  <para style="mt1">Matayi</para>
  <para style="imt">Nkotolo</para>
  <para style="ip">Wu ni Masumu Wumbote wusonika Matayi. Matayi ni kitoti kimpaku Yesu ki katumisa, mwanki ka mukitula mulongoki andi. Matayi wudi wumosi mu zintumwa Yesu ba katambika mu bateela ti: yendeeno lu longa Musamu Wumbote, mpe mu zakika luzingu mu Klisto.</para>
  <para style="ip">Matayi wuta mu mukanda bewuwu bwedi Yesu kabutukila, na misamu mikahidika ha butoto bewuwu, myo mi kalonga ku bantu, bumosi mpe mfwilu na mfulukulu andi mu bafwa. Yesu wulonga bantu nkatika mu kibakala, wunyakisa zimbevo, wukuma mpeve zimbi mpe wuhidika misamu mimingi milembolo bakula bantu.</para>
  <para style="ip">Matayi wusonika Musamu Wumbote bewuwu mu dyambu di zinkayi zandi zi Bayudayo, mu balonka ti wukedika Yesu ni mvulusi yi basamuna ku mimbikudi mi Nzambi bonso bu bata wo mu Masonama. Mpe mimvimba mi bata mu dyambu dyandi tekila kiza ha butoto. Wukedika ti musamu bewowo wuhilama. Ni yandi ntinu waakwiza. Misamu myamyomyo misidi ti babingi bazimbakani nkumbu andi mu mutumisina bwabu ti: «Mwana Davidi», mu dyambu ti ni Davidi wudi nkatika ntinu yiyinene yi bisi-Isaeli, badi bantu bavwihulu ku Nzambi. Kansi, mpeleko Yesu wulonka ku bisi-Isaeli, Kimfumu ki Nzambi bwedi kidi, ni mfumu zi yawu bende zi mubisa. Yesu bu kafwa, bakuma milongoki myandi mu badika mu bwesa lembolo kota dyaka mu bifulu byawu bi lusambulu. Mboki yawu bamana mwangana ha luse lu butoto bebubu, mu kwe samuni ku bantu bamvimba Masumu Wumbote.</para>
  <para style="iot">Tala bonso budi ndandani yi misamu mu buuku disonika Matayi:</para>
  <para style="io1">1) Bambuta zi bantu na mbutukulu yi Yesu 1-2</para>
  <para style="io1">2) Ndongolo yi Yoane mbotiki (<char style="xt"><ref loc="MAT 3:1-12">3.1-12</ref></char>)</para>
  <para style="io1">3) Mbotokolo yi Yesu, na bwedi nkadyampemba kasosila mu mubwisa mu masumu (<char style="xt"><ref loc="MAT 3:13-4:11">3.13–4.11</ref></char>)</para>
  <para style="io1">4) Yesu wuyenda zakala ku Ngalili (<char style="xt"><ref loc="MAT 4:12-18:35">4.12–18.35</ref></char>)</para>
  <para style="io1">5) Yesu totokidi mu Ngalili mu kwe zakala ku Yelusalemi (<char style="xt"><ref loc="MAT 19:1-20:34">19.1–20.34</ref></char>)</para>
  <para style="io1">6) Lumingu lu mansukina lu Yesu ha butoto: mfundusu andi na lufwa lwandi (<char style="xt"><ref loc="MAT 21:1-27:66">21.1–27.66</ref></char>)</para>
  <para style="io1">7) Mfulukulu yi Yesu mu bafwa (<char style="xt"><ref loc="MAT 28:1-20">28.1-20</ref></char>)</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">Kinkulu ki kanda di Yesu-Klisto</para>
  <para style="r">(<ref loc="LUK 3:23-38">Luk 3.23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Tala bonso bubela kinkulu ki kanda di Yesu-Klisto, mutekolo wu Davidi, Davidi yandi bende wuba mutekolo wu Abalahami.<verse eid="MAT 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="MAT 1:2" />Abalahami wubuta Isaaki, Isaaki wubuta Yakobi, Yakobi wubuta Yuda na zimpangi zandi mpe,<verse eid="MAT 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 1:3" />Yuda wubuta baala bole na Tamali: Falesi na Zala, Falesi wubuta Heselomi, Heselomi wubuta Alami,<verse eid="MAT 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 1:4" />Alami wubuta Aminadabi, Aminadabi wubuta Nasoni, Nasoni wubuta Salamoni,<verse eid="MAT 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 1:5" />Salamoni wubuta na Lahabi, Bozi. Bozi wubuta na Luti, Obedi. Obedi wubuta Yese,<verse eid="MAT 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 1:6" />Yese wubuta ntinu Davidi.</para>
  <para style="p" vid="MAT 1:6">Ntinu Davidi wubuta na mukento wu Uli, Solomo.<verse eid="MAT 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 1:7" />Solomo wubuta Loboami, Loboami wubuta Abia, Abia wubuta Asafi,<verse eid="MAT 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 1:8" />Asafi wubuta Yosafati. Yosafati wubuta Yolami. Yolami wubuta Oziya,<verse eid="MAT 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 1:9" />Oziya wubuta Yoatami, Yoatami wubuta Akazi, Akazi wubuta Ezekiase,<verse eid="MAT 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 1:10" />Ezekiase wubuta Manase, Manase wubuta Amoni, Amoni wubuta Yosiase,<verse eid="MAT 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 1:11" />Yosiase wubuta Yekoniani na zimpangi zandi, mu ntangu yi banata bantu ba Isayeli mu kinanga ku nsi yi Babiloni.<note caller="+" style="f"><char style="fr" closed="false">1.11 </char><char style="ft" closed="false">Taleeno <char style="xt"><ref loc="2KI 24:10-16">2 Min 24.10-16</ref></char>. Kinanga ki ba-Isaeli ku nsi yi Babiloni.</char></note><verse eid="MAT 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 1:12" />Bu bamana nata bantu ba Isaeli ku nsi yi Babiloni, kumanima, Yekoniani wubuta Salatieli, Salatyeli wubuta Zolobabeli,<verse eid="MAT 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 1:13" />Zolobabeli wubuta Abiwudi, Abiwudi wubuta Eliakimi, Eliakimi wubuta Azoli,<verse eid="MAT 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="MAT 1:14" />Azoli wubuta Sadoki, Sadoki wubuta Akimi, Akimi wubuta Eliwudi,<verse eid="MAT 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 1:15" />Eliwudi wubuta Eleazali, Eleazali wubuta Matani, Matani wubuta Yakobi,<verse eid="MAT 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 1:16" />Yakobi wubuta Yosefi, mulumi wu Maliya, ngudi yi buta Yesu, wu bakwe tumisinanga ti Klisto.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Lutangu lu zimbandu kumi na ya ziba kutonina ku Abalahami natee ku Davidi, mpe mbandu kumi na ya kutonina ku Davidi natee mu nkwendolo awu ku kinanga ku nsi yi Babiloni, mboki mbandu kumi na ya mu ntangu yi baba ku kinanga natee mbutukulu yi Klisto.<verse eid="MAT 1:17" /></para>
  <para style="s">Mbutukulu yi Yesu-Klisto</para>
  <para style="r">(<ref loc="LUK 2:1-7">Luk 2.1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Mbutukulu yi Yesu-Klisto ebu yi beela. Maliya, ngudi andi, wutambula nsilulu yi makwela ku Yosefi, kansi tekila bazakala nzo yimosi, wuyiza baka zimi mu lulendo lu Mpeve Yilongo. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Yosefi, mulumi andi, wuba muntu wuludedomo na katya mu muvweza ha meso ma bantu ko, wubaka makani me kabikisa makwela mu kinsweki. <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />Bu kedi yindulanga bobo, mbazi yimosi yi mfumu yiyiza muyenikina mu ndozi, na yi muteela ti: «Yosefi, mwana wu Davidi, kuyenandi bunkuta mu kwela Maliya ko, mu dyambu ti mu lulendo lu Mpeve Yilongo ka bakidi zimi. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Mwana wu bakala kaabuta, nkumbu yi Yesu waamuhaana, mu dyambu ti yandi waakuula bantu mu masumu mawu.<note caller="+" style="f"><char style="fr" closed="false">1.21 </char><char style="ft" closed="false">Yesu, mu Kingeleke, Yoswa, mbangudulu Mfumu wudi (hoti heeni) mpulusu.</char></note>»<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Misamu mimvimba mihilama bonso Mfumu kateela myo mu munwa wu mumbikudi ti:<verse eid="MAT 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="MAT 1:23" />«Tala, Ndumba yilembolo teka hilulu yaabaka zimi, na waabuta mwana wu bakala.</para>
  <para style="q1" vid="MAT 1:23">Nkumbu yi Emanueli baamuhaana.<note caller="+" style="f"><char style="fr" closed="false">1.23 </char><char style="ft" closed="false">Lulendi tanga mu <char style="xt"><ref loc="ISA 7:14">Yes 7.14</ref> </char>.</char></note>»</para>
  <para style="m" vid="MAT 1:23">Yina mbangudulu «Nzambi wu neto.»<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Yosefi bu kavumbuka, wuhidika mimvimba bonso bu muteela mbazi yi Mfumu, na wubonga mukento na wumutuula mu nzo andi. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Kansi kavukisa mfulu nandi ko natee bu kabuta mwana, wu kaahaana nkumbu yi Yesu.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">Bandwenga bayiza tala Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Yesu wubutuka ku mbanza Betelemi, mu kizunga ki Yuda, buna Elode wu ntinu. Bandwenga bafuma ku esete<note caller="+" style="f"><char style="fr" closed="false">2.1 </char><char style="ft" closed="false">Tangeeno mu</char><char style="xt"><ref loc="1SA 16:1">1 Sam 16.1</ref></char>, Betelemi yidi mbanza yi ntinu David. Bandwenga, bangudulu bantu baa na madyela. Lulendi tanga mpe mu kibuku: <char style="xt"><ref loc="MAT 7">7</ref>; <ref loc="MAT 13">13</ref>; <ref loc="MAT 16">16</ref></char>.</note> bayiza ku mbanza yi Yelusalemi <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />na bafuula ti: «Kadi ntinu yi Bayudayo yi butukudi kwedi yidi e? Yeto tuyeni lubwetete lwandi lutotokidi ku esete, ni twizidi mu mufukimina.» <verse eid="MAT 2:2" /><verse number="3" style="v" sid="MAT 2:3" />Ntinu Elode bu kayuwa musamu bewowo, mayindu mandi mayiza ba yeku-yeku, bumosi mpe na bantu bamvimba ba mbanza yi Yelusalemi. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Ni katumisa zimfumu zinganga-Nzambi na milongisi mi Misiku, na wubafuula ti: kwedi Mesiya kaabutukila e? <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />Bamuvutudila ti: «Ku Betelemi mu kizunga ki Yuda, mu dyambu ti wudi wusonama mu buuku di mimbikudi ti:<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />“Ngeye Betelemi, mbanza yi kizunga ki Yuda,</para>
  <para style="q1" vid="MAT 2:6">Wuvudidi mfunu ha kati di zimbanza zi Yuda ko,</para>
  <para style="q1" vid="MAT 2:6">kansi ni mu ngeye mwaadukila Mfumu</para>
  <para style="q1" vid="MAT 2:6">ya twaadisa Isaeli, mukangu ani.”»<verse eid="MAT 2:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 2:7" />Buna Elode wutumisa bandwenga mu kinsweki, na wubafuula mwanki katoma zaba bumbote nkye ntangu lubwetete luyenikini. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Mboki wubatambika ku mbanza Betelemi, na wubateela ti: «Yendeeno lusosa mutoma zaba bumbote misamu mitadidi mwa mwana bewowo wunsombe. Bu lwaamuyena, yizeno lunteela, mwanki meno mpe nenda na mufukimina.» <verse eid="MAT 2:8" /><verse number="9" style="v" sid="MAT 2:9" />Bu bamana yuwa ntinu, ni bayenda. Lubwetete belolo lu bayena ku esete, lwedi kwe batekididi ku mutwala awu, natee bu lu yenda tula na lutelama ha kibuka kibela mwa mwana wunsombe. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Bu bayena lubwetete, batoma yena kyese kikingi. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Bu bakota mu kati di nzo, bayena mwa mwana wunsombe na ngudi andi Maliya. Bamufukimina na bamukembila, mboki banyanguna bifunda byawu na bamuhaana minkayulu emi: wola, maaka mamfuku yimbote na mile. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Ku manima, Nzambi wubalwengisa mu ndozi balembolo hyokila dyaka ku ntinu Elode. Ni bavutuka ku nsi awu mu nzila yihiika.<verse eid="MAT 2:12" /></para>
  <para style="s1">Yosefi na Maliya batinisa na mwana ku Ngipiti</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Bandwenga bu bavutuka, mbazi yimosi yi Mfumu yiyiza yenikina Yosefi mu ndozi, na yi muteela ti: «Telama, bonga mwana na ngudi andi, na tinisa ku nsi yi Ngipiti, zakala kooko natee bu nakuteela ti vutuka. Mu dyambu ti, ntinu Elode wuna sosa mu hondisa mwana.» <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />Yosefi wutelama, wubonga mwana na ngudi andi mu kati dimpimpa, ni batinisa ku nsi yi Ngipiti. <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />Bayenda bazakala kooko natee ntinu Elode bu kafwa. Misamu mimvimba mihilama bonso Mfumu kateela myo mu munwa wu mumbikudi ti: «Ntumisi mwana ani mu totoka ku nsi yi Ngipiti.»<verse eid="MAT 2:15" /></para>
  <para style="s1">Ntinu Elode wuhondisa baala bafyoti ku mbanza yi Betelemi</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Elode bu kayena ti bandwenga bamuhunini, wubaka mankesi mavula kitezo. Na wuhaana lutumu mu honda mu mbanza Betelemi mpe mu kizunga kyandi kimvimba baala babakala baba na mvula zole natee kubanda, bonso ntangu yi bamuhaana ku bandwenga. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Mwanki misamu mita mumbikudi Yelemiya myenda detila ti:<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />«Miloko mina yuwakana ku mbanza yi Lama,</para>
  <para style="q1" vid="MAT 2:18">bidilu na manyongo mamingi.</para>
  <para style="q1" vid="MAT 2:18">Ni Lakeli wuna dila baala bandi,</para>
  <para style="q1" vid="MAT 2:18">Na katiidi ko ba mubomba, mu dyambu ti bafwidi.»<verse eid="MAT 2:18" /></para>
  <para style="s1">Yosefi, Maliya na mwana bavutuka ku Isaeli</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Ku manima ma lufwa lu ntinu Elode, mbazi yimosi yi Mfumu yi yenikina Yosefi mu ndozi ku nsi yi Ngipiti. <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />Yimuteela ti: «Telama, bonga mwana na ngudi andi, vutuka ku nsi yi Isaeli, mu dyambu ti yobobo bedi sosa mu hondisa mwana bafwidi.» <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />Yosefi wutelama, wubonga mwana na ngudi andi, ni kavutuka ku nsi yi Isaeli. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Kansi, bu kayuwa ti Akelawuse wuna yaala nsi yi Yuda ha kibuka ki tata andi Elode, wuyena bunkuta mu kwenda kooko. Nzambi wumulwengisa mu ndozi, mboki wuyenda ku kizunga ki Ngalili. <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />Wuyenda zakala ku mbanza Nazaleti, mwanki misamu mita mimbikudi myenda detila: «Baamutumisina mwisi-Nazaleti.»<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">Ndongolo yi Yoane Mbotiki</para>
  <para style="r">(<ref loc="MRK 1:1-8">Mlk 1.1-8</ref>; <ref loc="LUK 3:1-18">Luk 3.1-18</ref>; <ref loc="JHN 1:19-28">Yoa 1.19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Mu ntangu beyoyo, Yoane Mumbotiki wutotoka ku nsi yinkatu, mu kizunga ki Yuda, ku kedi longila. <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />Wedi tanga ti: «Viluleeno madyela, kadi Kimfumu ki mazulu kyeka lukufi!» <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Ni Yoane mumbikudi Yesaya kateela ti:</para>
  <para style="q1" vid="MAT 3:3">«Ni ndinga yi muntu yina bokana ku nsi yinkatu:</para>
  <para style="q1" vid="MAT 3:3">Kubikeeno nzila yi Mfumu,</para>
  <para style="q1" vid="MAT 3:3">mpe sungikeeno nzila zandi!»<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Yoane wuba na kinkutu ki mika mi kibulu ki nkumbu samo, na wuba wulwata mu luketo lwandi, melika yi mukanda wu kibulu. Makonko na nyosi yi mpanda kedi kwe dyengi. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Bantu ba mbanza yi Yelusalemi, bantu ba kizunga kimvimba ki Yuda na bantu ba bizunga bi bela-bela na nzadi yi Yolodani, bedi kwendanga ku yandi, <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />bafungula masumu mawu ha meso ma bantu bamvimba, na Yoane wedi babotikanga mu nzadi yi Yolodani.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Yoane bu kayena Bafalisi na Basaduki bayiza babingi ku yandi mu botoko, wubateela ti: «Kanda di zimpidi! Nani wululwengisi mu tina nganzi zi Nzambi zeka bela-bela e? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Lonkeeno mimbutu mina lonka ti luviludi madyela, <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />na lubanzandi muta kaka ko ti: “Abalahami, nkaka eto yidi!” Mu dyambu nina luteela ti mu matadi bemama Nzambi lendi duukisa baala ba Abalahami! <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Bwabu kiibi kikubamani mu zenga miti mu myanzi: ni hahoho myonso miti mikwe lembolo butanga mbutu zimbote mya kwangu mpe mya tubu ku tiya. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />Meno, nina lubotika mu mamba mwanki luvilula madyela, kansi yondowo wuna kwiza ku manima ani, wumvudidi lulendo: Niidi wulunga ko mu munyanguna misinga mi nsampatu zandi. Yandi waalubotika mu Mpeve Yilongo na mu tiya. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Simbidi ha kooko kwandi muti we yengisila, wuna hambisa mbutu zibele na bititi mu yonzika zo mu kati di kilundulu<note caller="+" style="f"><char style="fr" closed="false">3.12 </char><char style="ft" closed="false">Kilundulu ki zimbutu, bonso nzo hoti tanda di bakwe lundilanga nguba hoti madezo</char></note>, mpe wuna yoka bititi ku tiya tukwe lembolo zimanga.»<verse eid="MAT 3:12" /></para>
  <para style="s">Mbotokolo yi Yesu</para>
  <para style="r">(<ref loc="MRK 1:9-11">Mlk 1.9-11</ref>; <ref loc="LUK 3:21-22">Luk 3.21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Yesu bu kafuma ku kizunga ki Ngalili, wuyiza ku Yoane ku nzadi yi Yolodani, mwanki ka mu botika. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Kansi Yoane katya ko ti kamubotika, wumuteela ti: «Meno nketi kwiza ku ngeye mu botoko, kadi ngeye wizidi ku meno!»<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Yesu wumuvutudila ti: «Bika bwabu bubela bobo. Kadi bumbote mu lungisa bonso budi luzolo lu Nzambi.» Yoane ni katambula. <verse eid="MAT 3:15" /><verse number="16" style="v" sid="MAT 3:16" />Yesu bu katumbu botoko, wutomboka mu mamba. Mu ntangu beyoyo kwandi yulu dizibuka na wuyena Mpeve yi Nzambi yikulumuka ku yandi mu kifwani ki bembe. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Mboki ndinga yiyuwakana tuuka ku yulu: «Yandi ewu ni mwana ani wu ntomini tya, kyese kyani kimvimba mu yandi kidi.»<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s1">Nkadyampempa wutonta Yesu ku nsi yinkatu</para>
  <para style="r">(<ref loc="MRK 1:12-13">Mlk 1.12-13</ref>; <ref loc="LUK 4:1-13">Luk 4.1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Mboki, Mpeve Yilongo yinata Yesu ku nsi yinkatu, mwanki nkadyampemba ka mutonta. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Ku manima, Yesu wumina nsoki mu bilumbu makumaya (40), mpimpa na mwini. Nsatu ni yi mubaka. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Nkadyampemba wufinama na wumuteela ti: «Tala ti ngeye Mwana Nzambi wudi, tuma matadi bemama ma kituka mampa.» <verse eid="MAT 4:3" /><verse number="4" style="v" sid="MAT 4:4" />Yesu wumuvutudila ti: «Basonika: “Luzingu lu muntu luu kaka mu dimpa ko, kansi mu mpova zimvimba zikwe duukanga ha munwa wu Nzambi.”»<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Nkadyampemba wumunata ku Yelusalemi, mbanza yi longo, wumutuula ha nsongi yi nzo-Nzambi <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />na wumuteela ti: «Tala ti Mwana Nzambi wudi, wukituba ku nsi, mu dyambu ti basonika:</para>
  <para style="q1" vid="MAT 4:6">“Nzambi waahaana mu dyambu dyaku ntumunu ku zimbazi zandi,</para>
  <para style="q1" vid="MAT 4:6">mpe baakuyaka mu moko mawu,</para>
  <para style="q1" vid="MAT 4:6">mwanki kuulu kwaku kulembolo koyama ha tadi.”»<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Yesu wumuvutudila ti: «Basonika mpe: “Wulendi tonta Mfumu Nzambi aku ko.”» <verse eid="MAT 4:7" /><verse number="8" style="v" sid="MAT 4:8" />Nkadyampemba wubwesa munata dyaka ha yulu mulandu na wumulonka nsi zimvimba zi ha nza na minkembo myawu, <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />na wumuteela ti: «Nina kuhaana bimvimba bebibi, tala ti wumfukimini na wunsambidi.» <verse eid="MAT 4:9" /><verse number="10" style="v" sid="MAT 4:10" />Yesu wumuvutudila ti: «Satana, katuka ha nidi! Mu dyambu ti basonika: “Mfumu Nzambi aku kaka fweti fukimina, mpe Yandi kaka fweti sadila.”» <verse eid="MAT 4:10" /><verse number="11" style="v" sid="MAT 4:11" />Nkadyampemba wusala musisa, mboki mbazi ziyiza ku Yesu mu musadisa.<verse eid="MAT 4:11" /></para>
  <para style="s1">Yesu wutona kisalu kyandi ku Ngalili</para>
  <para style="r">(<ref loc="MRK 1:14-15">Mlk 1.14-15</ref>; <ref loc="LUK 4:14-15">Luk 4.14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Yesu bu kayuwa ti batuudidi Yoane mu boloko, wuyenda ku kuzunga ki Ngalili. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Wusisa mbanza Nazaleti, na wuyenda zakala ku mbanza yi Kapenawumi ha kumu di dyanga di Ngalili, mu kizunga ki Zabuloni na ki Nefatali. <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />Mwanki misamu mi ta mumbikudi Yesaya myenda detila:<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />«Kizunga ki Zabuloni na ki Nefatali,</para>
  <para style="q1" vid="MAT 4:15">nzila yi mubu, simu dihiika di nzadi yi Yolodani,</para>
  <para style="q1" vid="MAT 4:15">Ngalili yi balembolo ba Bayudayo!<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />Bantu bakwe zinganga mu tombe</para>
  <para style="q1" vid="MAT 4:16">bayeni kya kikingi!</para>
  <para style="q1" vid="MAT 4:16">Mpe bantu bakwe zinganga mu nsi yi tombe ki lufwa,</para>
  <para style="q1" vid="MAT 4:16">kya kisesomokini mu dyambu dyawu!»<verse eid="MAT 4:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="MAT 4:17" />Tuuka ntangu beyoyo, Yesu wutona mulonga,</para>
  <para style="q1" vid="MAT 4:17">mu ta ti: «Viluleeno madyela, kadi Kimfumu ki mazulu kyeka lukufi!»<verse eid="MAT 4:17" /></para>
  <para style="s">Yesu wutumisa milongoki mintete</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Yesu bu kedi kwe yendi ha kumu di dyanga di Ngalili, wuyena mpangi zole ziba bilobi bi mbizi, Simoni, wu bakwe tumisinanga Petelo na Andele mpangi andi, bedi loosanga mpwasa mu dyanga. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Wubateela ti: «Ndandeeno, mpe naasa ti luba bilobi bi bantu.» <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Hansi na nsi, basala sisa zimpwasa zawu na bamulanda. <verse eid="MAT 4:20" /><verse number="21" style="v" sid="MAT 4:21" />Bu kayenda mwa kitatu, wuyena dyaka zimpangi zole, Zaki na Yoane, baala ba Zebedayi. Baba mu kati di mulungu na tata awu Zebedayi, bedi hidikanga zimpwasa. Yesu wubatumisa <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />hansi na nsi basala sisa mulungu na tata awu, ni bamulanda.<verse eid="MAT 4:22" /></para>
  <para style="s1">Yesu wulonga na wunyakisa</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Yesu wuzyeta mu kizunga kimvimba ki Ngalili, wedi kwe longingi mu zinzo zi lusambulu zi Bayudayo na wusamuna Musamu Wumbote wu Kimfumu ki Nzambi na wunyakisa bimbevo bimvimba bi bantu na byeta bimvimba. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Kikuumu kyandi kimwangana mu nsi yimvimba yi Siliya, na bedi mutwadilanga bantu bedi kwamusungu mu bimbevo na mpasi zimumpila-mumpila: banga zimpeve zimbi, banga bimbevo binzyeta na banga mbolokoto. Yesu wubanyakisa. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Mpumbu yi bantu babingi bamulanda, bafuma ku kizunga ki Ngalili na ki Dekapoli, ku Yelusalemi na ku Yuda na ku ndambu yihiika yi nzadi yi Yolodani.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s1">Ndongolo yi Yesu ha yulu mulandu</para>
  <para style="r">(<ref loc="MRK 3:13">Mlk 3.13</ref>; <ref loc="LUK 6:12-13">Luk 6.12-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Yesu bu kayena mukangu, wutomboka ha yulu mulandu, wuzakala. Milongoki myandi miyiza ha kabela, <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />mboki wutona mu balonga ebu:<verse eid="MAT 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />«Kyese ku yobobo ba bamputu mu kimpeve,</para>
  <para style="q1" vid="MAT 5:3">kadi kimfumu ki mazulu kyawu kidi!<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Kyese ku yobobo bana dila, kadi bana bombwa!<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Kyese ku yobobo ba na lembami, kadi bana tambula nsi yi lusila Nzambi nsilulu!<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Kyese ku yobobo bana yena nsatu na mpwila yi lunungu, kadi bana yukutusu!<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Kyese ku yobobo bakwe fwilanga bahiika nkenda, kadi Nzambi waabafwila nkenda!<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Kyese ku yobobo bana mitima mivedila, kadi bana yena Nzambi!<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Kyese ku yobobo bakwe tukisanga kiyenge, kadi bana batumisina baala ba Nzambi!<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Kyese ku yobobo ba ku nsye mfyetokoso mu dyambu di lunungu, kadi Kimfumu ki Mazulu kyawu kidi!<verse eid="MAT 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 5:11" />Kyese ku yeno ti bana lutuka, bana lufyetikisa, na bana luhunina misamu mimvimba mimbi mu dyambu dyani.<verse eid="MAT 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 5:12" />Yangalaleeno mu kilumbu bekyokyo na duzumukeeno mu kyese, mu dyambu ti musendo eno waaba wuwunene ku mazulu. Bwabobo mpe bedi zominanga mimbikudi mi lutekidila.»<verse eid="MAT 5:12" /></para>
  <para style="s">Kuba bonso munga na kya ku nza</para>
  <para style="r">(<ref loc="MRK 9:50">Mlk 9.50</ref>; <ref loc="LUK 14:34-35">Luk 14.34-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />«Yeno bonso munga wu nza ludi. Kansi, tala ti weka na zubulu, bwedi tulendi we vutudila nzenzo e? Wusidi dyaka kisalu ko, mbote bu balosidi wo ku mbazi na bantu badyeti wo.»<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />«Yeno bonso kya ku nza ludi. Mbanza yidi ha yulu mulandu yilendi swekama ko. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Bakwe lemisanga mwinda mu tuula wo ku nsye kisiku ko. Kansi bafweti we tentika ha yulu kitentokolo ki mwinda, mwanki ka kyenzola bantu bamvimba ba mu nzo. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Ni hahoho, bika mwinda eno wulezima ha ntadisi yi bantu, mwanki bayena mavanga meno mambote na bazitisa Tata eno wu ku mazulu.»<verse eid="MAT 5:16" /></para>
  <para style="s">Yesu na Misiku</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />«Lubanzandi ko ti meno nayizidi mu katula Misiku mi Mose na mambu ma mimbikudi. Nayizidi mu katula myo ko, kansi mu lungisa myo. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Kedika nina luteela: tekila yulu na butoto bihyoka, nakani kisono kimosi kifyoti hoti mwa kima kivudi bukeke ki musiku kilendi katuka ko, natee mimvimba bu milungidi. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Ni hahoho, wonso waatinguna mwa musiku wuvudidi bukeke, na waalonga ku bantu mu hidika bo, yandi waaba muntu wuvudidi bukeke mu Kimfumu ki mazulu. Kansi wonso waavumina na waalonga ku bantu bahiika bavumina wo, yandi waaba muntu wuwunene mu Kimfumu ki mazulu. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Meno nalutedidi ti: tala ti lunungu lweno lu hyokidi lu Bafalisi na milongisi mi Misiku ko, yeno lwaakota mu kimfumu ki mazulu ko.»<verse eid="MAT 5:20" /></para>
  <para style="s">Ndongosolo mu dyambu di mankesi</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />«Yeno luyuwa ti zinkaka zeno zi ta ebu: “kuhondandi ko, wonso waahonda munandi muntu fweti fundusu ha ntadisi yi ba mimfundisi.” <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Kansi meno nalutedidi ti wonso muntu waabakila munandi mankesi fweti fundusu ha ntadisi yi ba mimfundisi, wonso muntu waatuka munandi ti “kihulu” fweti fundusu ha ntadisi yi kimvuka ki bakuluntu ba Bayudayo, na wonso waamuteela ti: “Kilawuki” fweti tubu ku tiya tu mbungulu. <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />Tala ti wenzi haana munkayulu aku ha ziku di bakwe yokilanga munkayulu, mboki bambukidi moyo ti musamu wu naaku na mpwanaku, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />teka bika ntete munkayulu aku hoho, ha mutwala wu ziku di bakwe yokilanga munkayulu, yenda wuyuwasana na munaku, mboki vutuka wuhaana munkayulu aku ku Nzambi. <verse eid="MAT 5:24" /><verse number="25" style="v" sid="MAT 5:25" />Tala ti wuna kwenda na mutantu aku mu nzila, yuwasaneeno bu lwakidi mu nzila, mwanki kalembolo kuyekola mu moko ma mumfundisi. Mpe mumfundisi kakuyekola mu moko ma mbulumbulu, mboki mbulumbulu waakutuula mu boloko. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Kedika nina kuteela, wulendi duuka mu boloko ko, tala ti kumeni mu futa mfuka aku ko, natee ku mbongo yi kisengo yimanunu.»<verse eid="MAT 5:26" /></para>
  <para style="s">Ndongosolo mu dyambu di kinsuza</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />«Yeno luyuwa ba ta ti: “Kusadilandi kinsuza ko.” <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Kansi meno nina luteela ti: wonso muntu waatala mpe waazinina mukento wu munandi, sidi kinsuza nandi mu kati di mutima andi. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Tala ti diisu dyaku dilubakala dina kubwisanga mu masumu, katula dyo na loosa dyo kitatu naku, mu dyambu ti bumbote ku ngeye mu katulu kinama kimosi kwandi ki nitu aku, na mu bika ti nitu aku yimvimba yitubu ku tiya tu mbungulu. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Tala ti kooko kwaku kulubakala kukwe kubwisanga mu masumu, tabula ko na loosa ko kitatu naku, mu dyambu ti bumbote ku ngeye mu katulu kinama kimosi kwandi ki nitu aku, na mu bika ti nitu aku yimvimba yitubu ku tiya tu mbungulu.»<verse eid="MAT 5:30" /></para>
  <para style="s">Ndongosolo mu dyambu dimfwilu yi makwela</para>
  <para style="r">(<ref loc="MAT 19:9">Mat 19.9</ref>; <ref loc="MRK 10:11-12">Mlk 10.11-12</ref>; <ref loc="LUK 16:18">Luk 16.18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />«Ebu ba ta dyaka ti: “Dyonso bakala dyaakuma mukento andi fweti muhaana mukanda wu mfwilu yi makwela.” <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Kansi meno nina luteela ti: dyonso bakala dyaakuma mukento andi ku makwela, tala ti ka mu dyambu di kinsuza ko, wakasindikidi ka sadila kinsuza, mpe dyonso bakala dikwedidi mukento wuba kumini ku makwela, sadidi mpe kinsuza.»<verse eid="MAT 5:32" /></para>
  <para style="s1">Ndongosolo mu dyambu dye dya ndefi</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />«Yeno luyuwa ba ta dyaka ku zinkaka zeno ti: “Kudyandi ndefi yi walembolo vumina ko, kansi lungisa mimvimba mi wudididi ndefi ha ntadisi yi Mfumu.” <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Kansi meno nina luteela ti: kamudyanga ndefi: mu nkumbu yi yulu ko, mu dyambu ti kyandu ki kintinu ki Nzambi kidi, <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />ka mu nkumbu yi butoto ko, mu dyambu ti butoto ni kifulu kikwe tentikanga Nzambi bitambi byandi, ka mu nkumbu yi Yelusalemi ko, kadi Yelusalemi ni mbanza yi Ntinu yiyinene. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Kudilandi mpe mutu aku ndefi ko, mu dyambu ti wulendi kitula ka mulengi wumosi wu mutu aku wumpembe hoti wundombe ko. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Bika mpova eno yiba ninga tala ti “ninga”, kaani tala ti “kaani”, misamu mimvimba mi waatentika ha yulu mikwe fumanga ku Munga Mbi.»<verse eid="MAT 5:37" /></para>
  <para style="s1">Ndongosolo mu dyambu dye vutula mbi mu mimbi</para>
  <para style="r">(<ref loc="LUK 6:29-30">Luk 6.29-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />«Yeno luyuwa ba ta ti: “Muntu kamana kutobola diisu, ngeye mpe mutobola dyo, na kamana kukatula dinu ngeye mpe mukatula dyo.” <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Kansi meno nina luteela ti: “Luvutulandi mbi mu mimbi ko. Tala ti muntu wukubendi mbata ha bundi di mimbakala, mutambila mpe dihiika. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Tala ti muntu tiidi mu kwe kufunda ha ntadisi yi mumfundisi mwanki ka kubonga kinkutu kyaku, bika kabonga mpe kiyunga kyaku. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Tala ti muntu wukukwikisi mu kwenda kilometele kimosi, yenda nandi kilometele zole. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Haana ku yondowo wu kulombidi kima, kubisandi mu defisa kima ku muntu wu kulombidi kyo.”»<verse eid="MAT 5:42" /></para>
  <para style="s1">Kuzola mitantu myeno</para>
  <para style="r">(<ref loc="LUK 6:27-28">Luk 6.27-28</ref>,<ref loc="LUK 6:32-36">32-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />«Yeno luyuwa ba ta ti: “Fweti zola mfinangani aku na fweti bela mutantu aku.” <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Kansi meno nina luteela ti: zoleeno mitantu myeno na sambidilangeeno bakwe lufyetikisanga. <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />Ni bwabobo lwaabela baala ba Tata eno di ku mazulu. Mu dyambu ti yandi kwe teekisanga mwini ku bantu bambote na bambi, mpe kwe nokisanga mvula ku bantu ba ludedomo na balembolo ba na ludedomo. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Ti lutiidi kwandi bakwe lutyanga, nkye ndandu lwaabaka e? Mitoti mimpaku mpe bwabobo kwandi bakwe sanga. <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Tala ti zimpangi zeno kwandi lukwe haananga mbote, nkye dyambu dingitukulu lukwe hidikanga e? Balembolo ba Bayudayo mpe bwabobo kwandi bakwe sanga. <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Bwabu beno bantu balunga, bonso Tata eno di ku mazulu wudi wulunga.»<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s1">Ndongosolo mu kabudila bamputu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />Kebeeno kweno! Bu lukwe hidikanga misamu mikwe tyanga Nzambi, lusangandi bo mu kiyenikisa ha meso ma bantu ko. Nganunu lwaatambula musendo ha ntadisi yi Tata eno wu ku mazulu ko. <verse eid="MAT 6:1" /><verse number="2" style="v" sid="MAT 6:2" />Bu kwe kabilanga bamputu, kamusikanga hungu ha ntadisi aku ko, bonso bukwe sanga bantu ba diisu ku nsye lukaya mu zinzo zi lusambulu zi Bayudayo na mu zinzila, mwanki bantu ba bazitisa. Kedika nina luteela: yawu batambudi musendo awu. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Kansi bu kwe sadisanga bamputu, kooko kwaku kulumoso ku zabandi ko nki kooko kwaku kulubakala kuna sa. <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />Mwanki lusadusu lu wuna haana luba mu mansweki, mboki Tata aku wuna kutala mu mansweki, waakusenda.<verse eid="MAT 6:4" /></para>
  <para style="s1">Ndongosolo mu dyambu di lusambulu</para>
  <para style="r">(<ref loc="LUK 11:2-4">Luk 11.2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />Bu lukwe sambilanga, lubandi bonso bantu ba diisu ku nsye lukaya ko, batiidi mu sambila kimantela mu zinzo zi lusambulu zi Bayudayo na mu mahambu ma zibala-bala, mwanki bantu ba batala. Kedika nina luteela: yawu batambudi musendo awu. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Kansi ngeye, bu wasambila, kota mu kati di kihinga kyaku, zibika mwelo aku, sambila Tata aku wu momo mu mansweki, mboki Tata aku wuna kutala mu mansweki, waakusenda.<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />Bu lukwe sambilanga, lutangandi misamu mimingi ko bonso bukwe sanga bantu balembolo ba Bayudayo, bakwe bazanga ti bu bata misamu mimingi mbo batambula mvutu yimbote mu lusambulu lwawu. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Lusandi bonso yawu ko, mu dyambu ti Tata eno zebi nsatu zeno, tekila lumulomba. <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />Ebu lufweti sambidilanga:</para>
  <para style="q1" vid="MAT 6:9">«Tata eto wu ku mazulu!</para>
  <para style="q1" vid="MAT 6:9">Bika nkumbu aku yiba yilongo,<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />bika Kimfumu kyaku kiza,</para>
  <para style="q1" vid="MAT 6:10">bika luzolo lwaku luvangama ha butoto bonso mu mazulu.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Tuhaana, bindya byeto bilumbu ka lumbu,<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />Tulemvokila masumu meto,</para>
  <para style="q1" vid="MAT 6:12">bonso yeto mpe, tukwe lemvokilanga bakwe tusanga bubi,<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />wutukotisandi mu mpukumunu ko</para>
  <para style="q1" vid="MAT 6:13">kansi wututanina Munga Mbi.»</para>
  <para style="q1" vid="MAT 6:13">[Kadi kimfumu kyaku kidi, na lulendo</para>
  <para style="q1" vid="MAT 6:13">na nkembo mimvu ka mimvu. Ameni.]<verse eid="MAT 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />Ti lukwe lemvokila bantu mbi awu, Tata eno wu ku mazulu waalulemvokila mpe. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Tala ti lulemvokidi bantu ko, Tata eno kaalulemvokila mbi eno ko.<verse eid="MAT 6:15" /></para>
  <para style="s1">Ndongolo mu dyambu diminunu yi nsoki</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />Bu lukwe minanga nsoki, lubangandi na kiini ki kyadi ko, bonso bantu ba diisu ku nsye lukaya, luse lwawu lukwe kitukanga lukyadi mu lonka ku bantu ti nsoki kana mina. Kedika nina luteela: yawu batambudi musendo awu. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Kansi bukwe minanga nsoki, kukusanga mananasi ku mutu aku, mpe sukulanga kiini kyaku, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />mwanki wulembolo lonka ku bantu ti nsoki wuna mina, kansi ku Tata aku wu momo mu mansweki. Mboki, Tata aku wuna kutala mu mansweki, waakusenda.<verse eid="MAT 6:18" /></para>
  <para style="s1">Kuyonzika bimvwama ku yulu</para>
  <para style="r">(<ref loc="LUK 12:33-34">Luk 12.33-34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />Luyonzikangandi bimvwama ha nza beyiyi ko, ha na zinsyedi na mbungi yikwe sanga ti bima biseka, mpe ha na mivi mikwe bulanga bibaka mu yiba. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Kansi, yonzikangeeno bimvwama ku yulu, kulembolo ba zinsyedi na mbungi yikwe sanga ti bima biseka, mpe kulembolo ba na mivi mikwe bulanga bibaka mu yiba. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Kedika, honso ha kimvwama kyaku, hahoho mpe ha mutima aku.<verse eid="MAT 6:21" /></para>
  <para style="s">Kya ku nitu</para>
  <para style="r">(<ref loc="LUK 11:34-36">Luk 11.34-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />Diisu dyaku ni mwinda wu nitu aku: tala ti dimbote didi, nitu aku yimvimba yaaba mu kya, <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />kansi ti dibeela didi, nitu aku yimvimba yaaba mpe mu kati di tombe. Tala ti ku kya ku naaku kufukamani mu tombe, tombe bekyokyo kyaaba na bokoboko!<verse eid="MAT 6:23" /></para>
  <para style="s">Kusadila Nzambi hoti mbongo</para>
  <para style="r">(<ref loc="LUK 16:13">Luk 16.13</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />Kunani muntu wulendi sadila mfumu zole ko. Mu dyambu ti, mbo kabela wumosi na waatya wuhiika, hoti mbo kayekama ku wumosi na mbo kanyafuna wuhiika. Lulendi sadila ha kimosi Nzambi na mbongo ko.<verse eid="MAT 6:24" /></para>
  <para style="s">Kuba na kiminu mu Nzambi</para>
  <para style="r">(<ref loc="LUK 12:22-31">Luk 12.22-31</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />Ni hahoho nina luteela ti: Ka lukikwamisandi mu dyambu di luzingu lweno mu bye dya na mu bye nwa, mpe mu dyambu di nitu zeno mu bye lwata. Kedika, luzingu luhyokidi mfunu na bindya, mpe nitu yi hyokidi mfunu na binkutu. <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Taleeno zinuni zi ku yulu: zikwe kunanga ko, zikwe yonzikanga mu bilundulu ko, kansi Tata eno wu ku mazulu kwe ze dikilanga. Kadi yeno luhyokidi zinuni mfunu kwe e? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Nani mu yeno mu nyongono zandi lenda bwesa fyoti mwa ndambu bilumbu mu luzingu lwandi e?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />Nki lukwe kikwamisinanga mu dyambu di binkutu e? Taleeno bwedi bifulu bimfuba bikwe kudilanga: bikwe salanga ko, bikwe syetanga ko. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Kansi nina luteela ti: Kaati Solomo mu bimvwama byandi bimvimba, kasala lwaata binkutu bivudidi ntoko bonso kifulu kimosi mu bifulu bebibi ko. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Tala ti Nzambi bwabobo kakwe lwikilanga bititi bidi bubedidi mu mfuba na mbazi bina tubu ku tiya, bila nki kalembolo lusila bo e? Yeno bantu ba kiminu kifyoti ludi!<verse eid="MAT 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 6:31" />Lukikwamisangandi ko mu ta ti: «Nki twaadya e? Nki twaanwa e? Na nki twaalwata e?» <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />Ni bantu balembolo ba Bayudayo, bakwe kwe sosingi bima bimvimba bebyobyo, ntangu zimvimba. Kansi Tata eno wu ku yulu zebi ti bii neeno nsatu. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Soseeno ntete Kimfumu ki Nzambi na lunungu lwandi, mbo kaluhaana bima bimvimba bihiika bisidi.<verse eid="MAT 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 6:34" />Lukikwamisangandi mu kilumbu ki mbazi, mu dyambu ti kilumbu ki mbazi, kyaaba na misamu myandi. Kadi kilumbu ki na mpasi zandi.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s1">Ka mufundisanga ko</para>
  <para style="r">(<ref loc="LUK 6:37-38">Luk 6.37-38</ref>,<ref loc="LUK 6:41-42">41-42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />Ka mufundisa ko, mwanki balembolo lufundisa. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Mu dyambu ti baalufundisa bonso bu lukwe fundisilanga bahiika, mpe kitezo ki lukwe tezilanga bahiika, kyakyokyo mpe baalutezila. <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />Mu dyambu di nki wuna yenina kititi kii mu diisu di mpangi aku, kansi wuna yena kibuku kibaya kii mu diisu dyaku ko e? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Bwedi lenda teela ku mpangi aku ti: «Bika na katula kititi kii mu diisu dyaku», kansi ngebende wuna kibuku kibaya mu diisu dyaku e? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Ngeye muntu wu diisu ku nsye lukaya wudi! Katula ntete kibuku kibaya kii mu diisu dyaku, mboki mbo wuyena bwedi lenda katudila kititi kii mu diisu di mpangi aku.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />Ka luhaanandi bima bilongo ku zimbwa ko, na lulosandi misanga mintalu ku zingulu ko, mu dyambu ti zilenda mye dyatikisa, na zilenda lubangumukina mu lukaakuna.<verse eid="MAT 7:6" /></para>
  <para style="s1">Wonso waalomba waatambula</para>
  <para style="r">(<ref loc="LUK 11:9-13">Luk 11.9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />Lombeeno na baaluhaana, soseeno mpe lwaabaka, konkoteeno na baaluzibudila. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Ni hahoho, wonso waalomba, waatambula, mboki wonso waasosa waabaka na baazibudila ku yondowo waakonkota. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />Nani ha kati dyeno, lenda haana tadi ku mwana andi tala ti wumulombidi dimpa e? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Hoti nyoka tala ti wumulombidi mbizi e? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Mpeleko yeno nkatika bantu bambi ludi, luzebi muhaana bima bimbote ku baala beno. Bila nki Tata eno wu ku mazulu kalendi lembolo haanina bima bimbote ku yobobo bana mu lomba byo e?<verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />Mimvimba mi lutiidi ti bantu ba luhiidikila, yeno mpe bahidikileeno myo. Mu dyambu ti Misiku midi, na mi misonama mu buuku di mimbikudi.<verse eid="MAT 7:12" /></para>
  <para style="s1">Mwelo wufyetama</para>
  <para style="r">(<ref loc="LUK 13:24">Luk 13.24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />Kotileeno ha mwelo wufyetama. Kadi mwelo wuwunene na nzila yisadila bikwe natanga ku mbungulu, mpe babingi bakwe kotilanga yo. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Kansi mwelo wufyetama na nzila yifyetama bikwe natanga ku luzingu, na bafyuma kwandi baayena yo.<verse eid="MAT 7:14" /></para>
  <para style="s1">Mimbikudi mi luvunu</para>
  <para style="r">(<ref loc="LUK 6:43-44">Luk 6.43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />Kebeeno kweno na mimbikudi mi luvunu. Bakwe kwizanga ku yeno mu kifwani ki mameme, kansi ku kati dyawu baa bonso zingo zikwe dyanga bantu. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Mu mimbutu myawu lwaabazabila. Bakwe helanga mbutu zi miti mi vinu mu miti mi nsende ko, hoti mbutu zi fike mu zimpanga ko. <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Muti wumbote wukwe butanga mbutu zimbote, kansi muti wumbi wukwe butanga mbutu zimbi. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Muti wumbote wulendi buta mbutu zimbi ko, na muti wumbi wulendi buta mbutu zimbote ko. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Wonso muti wukwe lembolo butanga mbutu zimbote wufweti kwangu mpe wufweti tubu ku tiya. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Kedika, mu mimbutu myawu lwaazabila mimbikudi mi luvunu.<verse eid="MAT 7:20" /></para>
  <para style="s1">Kilumbu kimfundusu</para>
  <para style="r">(<ref loc="LUK 13:25-27">Luk 13.25-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />Ka bamvimba ko bakwe ntumisinanga ti: «Mfumu, Mfumu!» Baakota mu Kimfumu ki mazulu, kansi yobobo kwandi bakwe sadilanga luzolo lu Tata ani wu ku mazulu. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Kilumbu kyaaba mfundusu, babingi baanteela ti: «Mfumu, Mfumu, ka mu nkumbu aku ko twedi bikudilanga e? Ka mu nkumbu aku ko twedi kuminanga mpeve zimbi e? Ka mu nkumbu aku ko twedi sidilanga bimangu bibingi e?» <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Buna mbo nabateela ti: «Meno naluzebi ko, nkatukileeno, yeno lukwe sadilanga mambi!»<verse eid="MAT 7:23" /></para>
  <para style="s1">Nzo zole</para>
  <para style="r">(<ref loc="LUK 6:47-49">Luk 6.47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />Ni hahoho, wonso muntu kwe yuwanga mambu mani ma nakwe zonzanga na kwe sadilanga mo, fwanakani na bakala dimosi di madyela, wu tunga nzo andi ha yulu matadi. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Mvula bu yi noka, kikuka kiyiza, kitembo kingolo ki kukula na biyiza bwa mu nzo beyoyo, kansi bibwisa yo ko, mu dyambu ti wutunga lufulu andi ha yulu matadi. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />Kansi muntu wukwe yuwanga mambu mani ma nakwe zonzanga, na kwe lembolo sadilanga mo, fwaanakani na muntu wu kizengi tungidi nzo andi ha yulu munyenge. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Mvula bu yinoka, kikuka kiyiza, kitembo kingolo ki kukula na biyiza bwa mu nzo beyoyo, na nzo yibwa mpe bimvimba bimana bwonzomoka.<verse eid="MAT 7:27" /></para>
  <para style="s1">Yesu wulonga mu lulendo</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Yesu bu kamanisa mu haana malongi bemomo, bantu batoma yituku mu ndongosolo andi, <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />mu dyambu ti wedi longilanga mu lulendo, ka bonso milongisi mi Misiku myawu ko.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s1">Yesu wunyakisa muntu wuba na bwazi</para>
  <para style="r">(<ref loc="MRK 1:40-45">Mlk 1.40-45</ref>; <ref loc="LUK 5:12-16">Luk 5.12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Yesu bu kakulumuka mulandu, mpumbu yiyinene yi bantu yi mulanda. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Mboki, muntu wumosi wuba na bwazi wufinama, wufukama ha ntadisi andi, na wuta ti: «Mfumu, tala ti tiidi, wulendi mvedisa.» <verse eid="MAT 8:2" /><verse number="3" style="v" sid="MAT 8:3" />Yesu wulambula kooko, wumusimba na wuta ti: «Ntiidi, bika wuvedila.» Hansi na nsi, kimbevo kibwazi kitumbu mu manisa. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Mboki Yesu wumuteela ti: «Toma yuwa: kutandi wo ku muntu ko! Kansi, yenda wuyenika ku Nganga-nzambi na muhaana munkayulu wu mvutululu yi matondo, bonso busonika wo Mose. Bwabobo bantu bamvimba baazabila ti nyeki.»<verse eid="MAT 8:4" /></para>
  <para style="s1">Yesu wunyakisa mundongo wu mfumu yi zimbulumbulu nkama</para>
  <para style="r">(<ref loc="LUK 7:1-10">Luk 7.1-10</ref>; <ref loc="JHN 4:43-54">Yoa 4.43-54</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Yesu bu kedi kota mu mbanza Kapenawumi, mfumu yimosi yi zimbulumbulu nkama wufinama na wumubombidila, <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />mu muteela ti: «Mfumu mundongo ani wulambalala kadi ku nzo, kimbevo kimbolokoto ki nandi, na wuna kwama bubwingi.» <verse eid="MAT 8:6" /><verse number="7" style="v" sid="MAT 8:7" />Yesu wumuteela ti: «Nina kwiza mu munyakisa.» <verse eid="MAT 8:7" /><verse number="8" style="v" sid="MAT 8:8" />Kansi wuvutula ti: «Mfumu niidi wulunga ko ti wukota mu nzo ani, kansi ta kwandi mpova yimosi, kisadi kyani kyaanyaka. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Mu dyambu ti meno bende nii ku nsye lutumu lu zimfumu zani zi luyalu, mpe nii na zimbulu-mbulu ku nsye lutumu lwani. Ni namana ta ku wumosi: “Yenda!” Waakwenda, ni namana ta ku wuhiika: “Yiza!” Waakwiza, mpe namana ta ku mundongo ani: “sala kisalu eki”, kyaakasala.» <verse eid="MAT 8:9" /><verse number="10" style="v" sid="MAT 8:10" />Yesu bu kayuwa misamu bemyomyo, wuyituku na wubangumuka ku bantu bedi kwe mulandingi na wubateela ti: «Kedika mu kati di bantu ba-Isaeli nayeni kiminu ki mutindu bewuwu ko. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Nkatika nina luteela, bantu babingi baafuma ku esete na ku wesete na baazakala kintwadi ha meza mu Kimfumu ki mazulu na Abalahami, Isaaki na Yakobi. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Kansi yobobo bavwidi Kimfumu, baatubu ku mbazi mu kati di tombe, kwakoko kwaaba bidilu na nkwetosolo yi meno.»<verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />Mboki Yesu wuta ku mfumu yi zimbulumbulu nkama ti: «Vutuka ku nzo aku, bika bu vangama bonso bu kiminu kyaku.» Mu kilokola bekyokyo kwandi mundongo wunyaka.<verse eid="MAT 8:13" /></para>
  <para style="s1">Yesu wunyakisa zimbevo</para>
  <para style="r">(<ref loc="MRK 1:29-34">Mlk 1.29-34</ref>; <ref loc="LUK 4:38-41">Luk 4.38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Yesu wuyenda ku nzo yi Petelo. Wuyenda bwana buko bu Petelo wulambalala mu dyambu di yuku-yuku. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Yesu wumusimba mu kooko na yuku-yuku diduuka, mboki wutelama na wubakubikila meza.<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Ntangu bu yidyama, batwadila Yesu bantu babingi baba na zimpeve zimbi. Wukuma mpeve zimbi mu mpova, na wunyakisa zimbevo zimvimba, <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />mwanki misamu mi ta mumbikudi Yesaya myenda detila:</para>
  <para style="q1" vid="MAT 8:17">«Bongidi byeta byeto,</para>
  <para style="q1" vid="MAT 8:17">na lweti bimbevo byeto.»<verse eid="MAT 8:17" /></para>
  <para style="s1">Batiidi mu landa Yesu</para>
  <para style="r">(<ref loc="LUK 9:57-62">Luk 9.57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Yesu bu kayena kamba di bantu di muzungidila, wuhaana luve mu sabuka ku simu dikaka di dyanga. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Mulongisi wumosi wu Misiku wuyiza muteela ti: «Mulongisi, nakwe kulandi konso-konso ku waakwendisa.» <verse eid="MAT 8:19" /><verse number="20" style="v" sid="MAT 8:20" />Yesu wumuteela ti: «Mibaku mi na miduka, nuni zi yulu zi na mazanza, kansi Mwana Muntu ka na kibuka kye humina ko.»<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Wumosi mu milongoki myandi wumuteela ti: «Mfumu, mpeka luve nateka kwenda ziika tata ani.» <verse eid="MAT 8:21" /><verse number="22" style="v" sid="MAT 8:22" />Kansi Yesu wumuteela ti: «Bika bafwa bazika ba nawu bafwa, kansi ngeye ndanda.»<verse eid="MAT 8:22" /></para>
  <para style="s1">Yesu wudingimisa kitembo</para>
  <para style="r">(<ref loc="MRK 4:35-41">Mlk 4.35-41</ref>; <ref loc="LUK 8:22-25">Luk 8.22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Yesu wukota mu kati di mulungu, milongoki myandi mpe mimulanda. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Bayitukulu kwawu, kitembo kingolo kikukula ha dyanga, na bipo bimamba byedi tona mu fuka mulungu. Kansi Yesu wuba kwandi kutolo. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Milongoki mifinama ha kabeela. Bamusungika, ni bata ti: «Mfumu, tuvuukisa, nganunu twaafwa!» <verse eid="MAT 8:25" /><verse number="26" style="v" sid="MAT 8:26" />Wubateela ti: «Nki luna yenina bunkuta e? Yeno bantu ba kiminu kifyoti ludi!» Wutelama, wubamina kitembo na mamba ma dyanga, mpe bitumbu huza napii. <verse eid="MAT 8:26" /><verse number="27" style="v" sid="MAT 8:27" />Bamvimba bayituku bubwingi na bata ti: «Nani kadi Muntu bewuwu, wuna tuma kitembo na mamba ma dyanga, mpe bina mutumimina!»<verse eid="MAT 8:27" /></para>
  <para style="s1">Yesu wunyakisa bantu bole baba na mpeve zimbi</para>
  <para style="r">(<ref loc="MRK 5:1-20">Mlk 5.1-20</ref>; <ref loc="LUK 8:26-39">Luk 8.26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Yesu bu katula ku simu di kaka di dyanga di kizunga ki bisi-Ngadala, bantu bole baba na mpeve zimbi baduuka ku kati di ndyamu na bayiza mubwana. Baba na kinganzina kihyoka kitezo na kuba muntu ko wedi sosanga mu hyokila mu nzila beyoyo. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Buna batona mu bulana ti: «Mwana Nzambi, nkye dyambu ngeye na yeto e? Wizidi kuku mu tukwamisa tekila kilokola kitula e?»<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Mwa kitatu nawu, kuba na mukangu wu zingulu wedi kwe sosi bindya. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Na mpeve zimbi zi bombidila Yesu na zita ti: «Tala ti tiidi mu tukuma, tutambika mu kati di kamba di zingulu bezizi.» <verse eid="MAT 8:31" /><verse number="32" style="v" sid="MAT 8:32" />Yesu wubateela ti «Yendeeno». Baduuka, na bayenda kota mu kati di zingulu. Buna, mukangu wumvimba wu zingulu wulundumuka tuuka ku yulu mulandu natee ziyenda bwa mu dyanga, mboki zimana fwa mu mamba. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Minkengi mi zingulu bu miwoka, miyenda mwangisa nsangu ku mbanza mu misamu mimvimba mihyoka, na mitudila bantu bebobo baba na mpeve zimbi. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Ni hahoho, bantu bamvimba bambanza baduuka mu kwe bwana Yesu. Bu bamuyena na bamubombidila ka katuka mu kizunga kyawu.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s1">Yesu wunyakisa muntu wubela mbolokoto</para>
  <para style="r">(<ref loc="MRK 2:1-12">Mlk 2.1-12</ref>; <ref loc="LUK 5:17-26">Luk 5.17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Yesu wukota mu kati di mulungu, wusabuka dyanga na wuyenda ku mbanza yi kakwe zakidilanga<note caller="+" style="f"><char style="fr" closed="false">9.1 </char><char style="fq" closed="false">Mbanza yi kakwe zakidilanga </char><char style="ft" closed="false">Mu Malako 2.1, ni mbanza yi Kapenawumi bakwe banzilanga ti mbanza yi Yesu.</char></note>. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Bamutwadila bakala dimosi diba na kimbevo ki mbolokoto, diba dilambalala ha yulu kipoyi. Yesu bu kayena kiminu kyawu, wuta ku mbevo ti: «Mwana ani, lwata kibakala! Masumu maku ma lemvokolo.» <verse eid="MAT 9:2" /><verse number="3" style="v" sid="MAT 9:3" />Mwa ndambu yi milongisi mi Misiku myedi nyunguta yawu na yawu ti: «Bakala bedidi, wuna safula<note caller="+" style="f"><char style="fr" closed="false">9.3 </char><char style="fq" closed="false">Safula </char><char style="ft" closed="false">Bonso Kusamvula </char></note> Nzambi.» <verse eid="MAT 9:3" /><verse number="4" style="v" sid="MAT 9:4" />Yesu wuzaba mabanza mawu ni kata ti: «Bila nki luna bela na mayindu mambi mu mitima myeno e? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Nkye dyambu dilutidi nayakiyaki mu ta ti: “Masumu maku malemvokolo” hoti “Telama na yenda e”? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Mwanki luzaba ti Mwana Muntu wuna lulendo lwe lemvokila masumu ha luse lu butoto.» Wuteela ku muntu wuba na mbolokoto ti: «Telama, bonga kipoyi kyaku na vutuka ku nzo aku!» <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />Bakala bedyodyo ditumbu telama, na divutuka ku nzo andi. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Bantu bamvimba bu bayena bobo, babaka bunkuta, ni bakembila Nzambi wuheeni ku bantu lulendo lungitukulu lubobobo.<verse eid="MAT 9:8" /></para>
  <para style="s1">Mbokolo yi Matayi</para>
  <para style="r">(<ref loc="MRK 2:13-17">Mlk 2.13-17</ref>; <ref loc="LUK 5:27-32">Luk 5.27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Yesu bu kakatuka huma behoho, na bukedi hyoka, wuyena bakala dimosi, nkumbu andi Matayi, wuzakala ha kibuka ki kisalu ki mitoti mimpaku. Wumuteela ti: «Ndanda!» Ni katumbu telama na wumulanda. <verse eid="MAT 9:9" /><verse number="10" style="v" sid="MAT 9:10" />Yesu bu kaba wuzakala ha meza mu nzo yi Matayi mu dya, mitoti mimpaku mimingi na minsumuki miyiza zakala ha meza, kintwadi na Yesu na milongoki myandi. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Bafalisi bu bayena bobo, ni bateela milongoki myandi ti: «Bila nki mulongisi eno kena diila ha kimosi na mitoti mimpaku na minsumuki e?» <verse eid="MAT 9:11" /><verse number="12" style="v" sid="MAT 9:12" />Kansi Yesu wubayuwa, ni kabateela ti: «Ka bantu ba muhinya ko ba na nsatu yi mumbuki, kansi ni bambevo. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Yendeeno lu longoka mbangudulu yi musamu ewu: “Meno Nkenda ntiidi, kansi ka munkayulu wuyoko ko.” Mu dyambu ti nayizidi mu tumisa bantu balunungu ko, kansi minsumuki.»<verse eid="MAT 9:13" /></para>
  <para style="s1">Kumina nsoki</para>
  <para style="r">(<ref loc="MRK 2:18-22">Mlk 2.18-22</ref>; <ref loc="LUK 5:33-39">Luk 5.33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Milongoki mi Yoane miyenda fuula Yesu ti: «Bila nki yeto na Bafalisi tukwe mininanga nsoki, kansi milongoki myaku mikwe minanga nsoki ko e?» <verse eid="MAT 9:14" /><verse number="15" style="v" sid="MAT 9:15" />Yesu wubavutudila ti: «Luna banza ti bakundi ba kikwedi balendi ba mu kyadi, mu ntangu kikwedi ka nawu kintwadi e? Kansi, mu bilumbu bina kwiza, bu baabonga kikwedi ha kati dyawu, mbo bamina nsoki.<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />Kunaani muntu kwe tunganga kitende ki mulele wumoona mu kinkutu kintama, mu dyambu ti kitende kimona kyaakyakuna ndambu yi kinkutu mpe kukyakuka kwahyoka dyaka bunene. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Mpe bakwe tuulanga malamu mansonso mu mitumbu mintama ko, mu dyambu ti malamu mansonso malenda bula mitumbu, mboki malamu mamwangana ha nsi mpe mitumbu mi hombidi. Kansi, mu mitumbu mimona bakwe tuulanga malamu mansonso, ni bwabobo bya bibyole bikwe lundiminanga.»<verse eid="MAT 9:17" /></para>
  <para style="s1">Yesu wufulukisa mwana wu Yayilo na wunyakisa mukento wusimba kinkutu kyandi</para>
  <para style="r">(<ref loc="MRK 5:21-43">Mlk 5.21-43</ref>; <ref loc="LUK 8:40-56">Luk 8.40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Yesu bu kedi bazonzilanga bobo, mfumu yimosi yi Bayudayo yiyiza mu fukimina, na wumuteela ti: «Mwana ani wu mukento fwidi malu-malu yi kwa, kansi yiza wumutentika moko mbo kazinga!» <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Yesu wutelama, wumulanda na milongoki myandi.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />Mukento wumosi wuba na kimbevo kye kwe totokingi menga, kizingila mvula kumi na zole. Bu kafinama kumanima ma Yesu, wusimba mu sukina kinkutu kyandi. <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />Mu dyambu ti wuyindula: «Namana simba kwandi kinkutu kyandi, naanyaka!» <verse eid="MAT 9:21" /><verse number="22" style="v" sid="MAT 9:22" />Buna Yesu wubangumuka, wumuyena na wumuteela ti: «Mwana ani, lwata kibakala! Kiminu kyaku ki kuvukisi.» Hansi na nsi mukento bewowo wunyaka.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Yesu bu kayenda tula ku nzo yi Mfumu yi Bayudayo, wuyena bantu bedi sikanga matuutu na mukangu wedi dila mu ngolo. <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />Wubateela ti: «Duukeeno, mu dyambu ti mwana ndumba bewuwu kafwidyandi ko, kansi tolo kwandi kabwidi.» Ni bamusehila. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Bu bamana duukisa mpumbu yi bantu, Yesu wukota, na wusimba kooko ku mwana ndumba, na wutelama. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Kikuumu ki mwangana mu kizunga bekyokyo kimvimba.<verse eid="MAT 9:26" /></para>
  <para style="s1">Yesu wunyakisa mpofo zole</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Yesu wukatuka hoho na wuyenda. Bu kedi kwe yenzi, mpofo zole zimulanda, zilokana ti: «Mwana Davidi, tufwila nkenda!»<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Bu kayenda tula ku nzo, mpofo za zizole zifinama ha kabela, na Yesu wubafuula ti: «Lukwikidi ti ndendi bwe hidika e?» Bavutula ti: «Ninga, Mfumu!» <verse eid="MAT 9:28" /><verse number="29" style="v" sid="MAT 9:29" />Yesu ni kasimba meso mawu na wuta ti: «Bika mimvimba mi vangama bonso budi kiminu kyeno.» <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Meso mawu ni mazibuka. Kansi, Yesu wubakanikina na wubateela ti: «Tomeno yuwa, kani muntu wumosi ko waazaba musamu bewuwu.» <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Kansi, bu batumbu duuka kwandi, bamwangisa nsangu zi Yesu mu kizunga bekyokyo kimvimba.<verse eid="MAT 9:31" /></para>
  <para style="s1">Yesu wunyakisa baba</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Mu ntangu yi yenda bantu ya babole bebobo, batwadila Yesu bakala dimosi diba baba, mu dyambu ti wuba na mpeve yimbi. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Yesu bu kaduukisa mpeve yimbi, baba ditona mu zonza. Mpumbu yi bantu yiyituku, yita ti: «Twaayeni misamu mi bubu ko mu nsi yi Isaeli!» <verse eid="MAT 9:33" /><verse number="34" style="v" sid="MAT 9:34" />Kansi Bafalisi bata ti: «Mu lulendo lu mfumu yi mpeve zimbi kana kumina mpeve zimbi!»<verse eid="MAT 9:34" /></para>
  <para style="s1">Yesu wufwila bantu kyadi</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Yesu wuzyeta ku mbanza zimvimba na mabwala mamvimba, wedi kwe longingi mu zinzo zi lusambulu zi Bayudayo na wusamuna Musamu Wumbote wu Kimfumu ki Nzambi na wunyakisa bimbevo bimvimba bi bantu na byeta bimvimba. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Bu kayena mpumbu yi bantu, wubafwila kyadi, mu dyambu ti baba nanokina mpe nahongolo, bonso mameme malembolo ba na mumvungi. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Wuteela milongoki myandi ti: «Kisalu ki ngyonzokolo kikinene kidi, kansi bisadi bikeke bidi. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Buna lombeeno ku Mfumu yi kisalu ki ngyonzokolo kafidisa bisadi mu yonzika mimbutu.»<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s1">Zintumwa kumi na zole</para>
  <para style="r">(<ref loc="MRK 3:13-19">Mlk 3.13-19</ref>; <ref loc="LUK 6:12-16">Luk 6.12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Yesu wutumisa kumi na myole yi milongoki myandi, na wubahaana lulendo lwe kuma mpeve zimbi, na mu nyakisa bimbevo na byeta bimvimba. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />Nkumbu zi zintumwa kumi na zole ezi: wuntete Simoni, wukahaana nkumbu yi Petelo na Andele mpangi andi, Zaki na mpangi andi Yoane, baala ba Zebedayi, <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Filipi na Batelemi, Toma na Matayi, kitoti kimpaku, Zaki mwana wu Alefe na Tade, <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Simoni mu-Zeloti na Yuda Isikalyoti, yondowo wuyekola Yesu.<verse eid="MAT 10:4" /></para>
  <para style="s1">Kisalu ki milongoki kumi na myole</para>
  <para style="r">(<ref loc="MRK 6:7-13">Mlk 6.7-13</ref>; <ref loc="LUK 9:1-6">Luk 9.1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Milongoki kumi na myole bemyomyo, Yesu wubafidisa na wubahaana ndwengosolo ezi: «Lwendandi ku bantu balembolo ba Bayudayo, na lukotandi mu zimbanza zi bisi-Samaliya ko. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Kansi yendeeno ku mameme mazimbala mu bantu ba-Isaeli. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Yendeeno, longeeno na teeno ti: “Kimfumu ki mazulu kyeka lukufi!” <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Nyakiseeno bambevo, fulukiseeno bafwa, vediseeno ba na bwazi na kumeeno mpeve zimbi. Baluheeni ka mufuta kima ko, yeno mpe haaneeno ka mulomba kima ko. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />Ka lunatandi mbongo ko, ni zi ba ziwola, zipalata, hoti zinsongo mu melika zeno, <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />ka nkutu yi nzyetolo ko, ka binkutu byole ko, ka nsampatu ko, ka muti ko. Mu dyambu ti kisadi fweni baka bindya byandi.<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />Mu yonso mbanza hoti bwala bu lwaakota, soseeno mu zaba ti kuu na muntu wulenda lutambula, na beeno mu nzo andi natee kilumbu ki lwaakwenda. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Bu lwaakota mu nzo, bahaaneeno mbote. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Tala ti bantu ba nzo beyoyo balutambudi, bika kiyenge kyeno kiba nawu, tala ti balutambudi ko, bika kiyenge kyeno ki luvutukila. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Tala ti balutambudi ko mpe babisidi mu luyuwa, duukeeno mu nzo beyoyo hoti mu mbanza beyoyo, na kubuleeno fundu-fundu di mu bitambi byeno. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Nina luteela ti: mu kilumbu kyaaba mfundusu, bantu bambanza beyoyo baatambula kitumbu kivudidi ngolo na ki mbanza Sodomo na Ngomola.<verse eid="MAT 10:15" /></para>
  <para style="s1">Mfyetokoso zina kwiza ku mutwala</para>
  <para style="r">(<ref loc="MRK 13:9-13">Mlk 13.9-13</ref>; <ref loc="LUK 21:12-17">Luk 21.12-17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />Meno, nina lutambika bonso mameme ha kati di zingo. Beeno nayelele bonso nyoka, na mpembe bonso mabembe. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />Kebeeno kweno, mu dyambu ti bantu baalunata mu zinzo zi lufundusu, na baaluzuba bikoti mu zinzo zi lusambulu zi Bayudayo. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Baalunata ha ntadisi yi zintinu na ha ntadisi yi minyaadi mu dyambu dyani, dyaaba hwahwa ku yeno mu nteela kimbangi ha ntadisi awu na ha ntadisi yiyobo balembolo ba Bayudayo. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Kansi, bu baaluyekola, lukikwamisandi ko mu zaba bwedi lwaazonzila, na nki lwaata, mbo lubaka mu kilokola bekyokyo kwandi mpova zi lwaaduukisa: <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />kayeeno ko lwaazonza, kansi ni Mpeve yi Tata eno ya zonza mu yeno.<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />Mpangi yaayekola mpangi andi mwanki bamuhonda, na tata waasa bumosi ku mwana andi, baala baanangumukina bibuti byawu, na baabahondisa. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Bantu bamvimba baalubela mu dyambu di nkumbu ani. Kansi wonso waatatamana natee ku nsukunu, waavuuka. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Bu baalufyetikisa ku mbanza yimosi, tineeno ku yihiika. Kedika nina luteela ti: Lwaakimanisina mu hyokila mu mbanza zimvimba zi Isaeli ko tekila Mwana Muntu kiza.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />Mulongoki kaahyoka mulongisi andi ko, nakani kisadi kaahyoka mfumu andi ko. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Bulendi ba ti mulongoki kaba bonso mulongisi andi, na kisadi bonso mfumu andi. Tala ti batumisini mfumu yinzo, Belizebuli, buna bwedi balembolo tukila bantu ba mu nzo andi!<verse eid="MAT 10:25" /></para>
  <para style="s1">Yondowo wu lufweti tiina</para>
  <para style="r">(<ref loc="LUK 12:2-7">Luk 12.2-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />Lubayenandi bunkuta ko, mu dyambu ti mimvimba mi miswama myaayenika, na mansweki mamvimba maazabakana. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Mi naluteedidi mu mpimpa, zabikiseeno myo mu mwini, mi balunyungutini ha kutu, longileeno myo ku yulu miludi mi nzo. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Lubandi na bunkuta ku yobobo bakwe hondanga nitu, kansi balendi honda mwela ko. Mbote muyena bunkuta ku yondowo wulenda honda nitu na mwela, na wulenda tuba byo ku tiya tu mbungulu. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Kadi bakwe yadikanga maseke mole mu mbongo yi kisengo yimosi ko e? Kansi kunaani dimosi ha kati dyawu dilendi sonoka ha nsi tala ti ka luzolo lu Tata eno ko. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Lutangu lu milengi lu ku mutu eno lwa nazebi. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Buna, luyenandi bunkuta ko, luvudidi maseke mamingi mfunu!<verse eid="MAT 10:31" /></para>
  <para style="s1">Kutambula hoti kubisa Yesu</para>
  <para style="r">(<ref loc="LUK 12:8-9">Luk 12.8-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />Wonso muntu watambula ha meso ma bantu ti yandi mulongoki ani kadi, Meno mpe naamutambula ha ntadisi yi Tata ani wu ku mazulu, <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />kansi wonso waambisa ha meso ma bantu, meno mpe naamubisa ha ntadisi di Tata ani wu ku mazulu.<verse eid="MAT 10:33" /></para>
  <para style="s1">Yesu wuna twala nkabani</para>
  <para style="r">(<ref loc="LUK 12:51-53">Luk 12.51-53</ref>; <ref loc="LUK 14:26-27">14.26-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />Luna banza ti meno nayizidi mu lu haana kiyenge ehaha ha butoto: kaani, nayizidi ehaha ha butoto ka mu luhaana kiyenge ko, kansi mvita. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Nkabani natwedi ha kati di mwana wu bakala na tata andi, mwana wu mukento na ngudi andi, buko bu mukento na kikwezi kyandi ki mukento, <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />mboki mutantu aku waaba mwisi nzo aku. <verse eid="MAT 10:36" /><verse number="37" style="v" sid="MAT 10:37" />Wonso waavula tya tata andi hoti ngudi andi kuhyoka meno kafwanani mu ba naani ko, na yondowo wa vula tya mwana andi wu bakala hoti wu mukento kuhyoka meno kafwanani mu ba naani ko. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Wonso walembolo nanguna kulunsi dyandi mu ndanda, kafwanani mu ba naani ko. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Wonso muntu waasosa mu vuukisa luzingu lwandi, lwaakahombisa. Kansi yondowo waahombisa luzingu lwandi mu dyambu dyani lwaakavuukisa.<verse eid="MAT 10:39" /></para>
  <para style="s1">Musendo ku bana tambula Yesu</para>
  <para style="r">(<ref loc="MRK 9:41">Mlk 9.41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />Wonso muntu waalutambula ntambudi, na tambudi yondowo wu mfidisi. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Wonso muntu waatambula mumbikudi, mu dyambu ti mumbikudi kadi, waatambula musendo bonso wu mumbikudi, na wonso waatambula muntu wu lunungu ha ntadisi yi Nzambi mu dyambu ti wu lunungu kadi, waatambula musendo bonso muntu wu lunungu. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Kedika nina luteela: wonso muntu waahaana ka mwa mbungu yi mamba ma kyozi ku mwa baala bafyoti bebaba, mu dyambu ti milongoki myani midi, waatambula musendo andi.»<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s1">Yoane Mbotiki fidisi milongoki myandi ku Yesu</para>
  <para style="r">(<ref loc="LUK 7:18-35">Luk 7.18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Yesu bu kamanisa mu haana ndwengosolo andi ku milongoki myandi kumi na myole, wukatuka hoho na wuyenda mu longa na mu samuna Musamu Wumbote ku zimbanza zi kizunga.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Yoane bu kayuwa mu boloko, nsangu zi Klisto na mimvimba mi kedi kwe hidiki, wufila milongoki myandi, <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />mu kwe mufuula ti: «Kadi ngeye ni muntu bewowo waakwiza, hoti tufweti kingila wuhiika e?» <verse eid="MAT 11:3" /><verse number="4" style="v" sid="MAT 11:4" />Yesu wubavutudila ti: «Yendeeno luyaala mpolo ku Yoane mu mimvimba mi luyeni na mi luyudi: <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />zimpofo zena yena, bana byeta mu malu bana dyata bumbote, banga bwazi bana vedoso, bafwa makutu bana yuwa, bafwa bana fuluka, na Musamu Wumbote wa bana samuna ku bamputu. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Kyese ku muntu walembolo bika kiminu kyadi mu dyambu dyani!»<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Milongoki mi Yoane bu bavutuka, Yesu wutona mu zonzila Yoane ku mpumbu yi bantu na wubafuula ti: «Nani luyenda tala ku nsi yinkatu e? Dyadya dyedi ningusu ku mupepe e? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Nani kwandi luyenda tala e? Muntu wuba wulwata binkutu bintoko e? Bantu bakwe lwaatanga binkutu bintoko mu zinzo zi zintinu bakwe zinganga. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Kadi nani kwandi luyenda yena ku nsi yinkatu e? Mumbikudi e? Ninga, meno nina luteela ti, yandi hyokidi mumbikudi.» <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Mu dyambu di Yoane basonikina ti:</para>
  <para style="q1" vid="MAT 11:10">«Nina tambika ntumwa ani ku mutwala aku,</para>
  <para style="q1" vid="MAT 11:10">mu ku kubikila <note caller="+" style="f"><char style="fr" closed="false">11.10 </char><char style="ft" closed="false">Kutanga mpe mu Luka 1:16-17</char></note>nzila.»<verse eid="MAT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11" />Kedika nina luteela, mu bantu bamvimba ba ha nza, kunaani muntu wu hyokidi Yoane Mumbotiki mfunu. Kansi, wumuvudi bu fyoti mu Kimfumu ki Nzambi, yandi wumuvudidi bunene. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Kutonina mu ntangu yi Yoane Mumbotiki natee mu kilumbu kibubu, Kimfumu ki mazulu kina kwamusu mu zimvita, ni yobobo bavudi ngolo bana bonga kyo. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Mimbikudi mimvimba na Misiku mi Mose mi samuna Kimfumu ki Nzambi natee mu ntangu yi Yoane. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />Tala ti lulendi we tambula, Yoane ni Eliya wu basamuna ti waakwiza. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Wonso wuu na makutu mu yuwa, bika kayuwa!<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />«Na nani ndendi fwanikisa bantu ba mbandu beyiyi e? Bafwanakani na baala bafyoti bazakadi mu byanzala, mboki bana teela ku baala bahiika ti:<verse eid="MAT 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />“Yeto tusikidi tutu,</para>
  <para style="q1" vid="MAT 11:17">kansi yeno lukinini ko!</para>
  <para style="q1" vid="MAT 11:17">Yeto tuyimbidi mikunga mi kyadi,</para>
  <para style="q1" vid="MAT 11:17">kansi yeno ludididi ko!”<verse eid="MAT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 11:18" />Yoane bu kayiza, kedi dyanga ko, mpe kedi nwanga ko, kansi yeno luta ti: “Mpeve yimbi yi nandi!” <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Mwana Muntu wizidi, wuna dya, mpe wuna nwa, kansi luna ta ti: “Taleeno kweno muntu bewuwu, kidye na kinwe kidi, nkayi zandi ni mitoti mimpaku na minsumuki!” Kansi ndwenga zi Nzambi zikwe yenikanga zidedama mu mavanga mandi.»<verse eid="MAT 11:19" /></para>
  <para style="s1">Mbanza zi lembolo kwikila mu Yesu</para>
  <para style="r">(<ref loc="LUK 10:13-15">Luk 10.13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Buna Yesu wusemba zimbanza zi kasila bimangu bibingi, mu dyambu ti zivilula madyela ko. Wubateela ti: <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />«Kyadi ku ngeye, Kolazine! Kyadi ku ngeye, Betesayida! Mu dyambu ti bimangu bihilama ku yeno ni bihilama ku Tile na ku Sidoni, nganunu ntama balwata nsaku na bayobila bombe, mu lonka ti baviludi madyela. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Ni hahoho, kilumbu kyaaba mfundusu, kitumbu ki lwaabaka kyaavudila ngolo na ki zimbanza yi Tile na Sidoni. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Ngeye Kapenawumi, wuna banza ti baakuzangula natee ku yulu e? Kani, baakukulula natee ku nsi yi bafwa! Mu dyambu ti bimangu bihilama ku kweno ni bihilama ku Sodomo, nganunu mbanza beyoyo yakidi natee kilumbu ki bubedidi. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Ni hahoho, nina luteela ti, mu kilumbu kyaaba mfundusu, kitumbu ki lwaabaka kyaavudila ngolo na ki mbanza yi Sodomo.»<verse eid="MAT 11:24" /></para>
  <para style="s1">Yizeno ku meno mwanki lu huma</para>
  <para style="r">(<ref loc="LUK 10:21-22">Luk 10.21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Mu ntangu beyoyo, Yesu wuta ti: «Nina ku kembila, Tata, Mfumu yi yulu na butoto, mu dyambu ti zabikisi ku mwa baala bafyoti misamu bemyomyo mi wusweka ku bandwenga na ku banga madyela. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Ninga Tata, mu dyambu ti ngeye bwabobo wutidi bubela.<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />Tata ani wumpeka bima bimvimba. Kunani muntu zebi Mwana, tala ti ka Tata ko, mpe kunaani muntu zebi Tata tala ti ka Mwana ko, na ku yondowo Mwana katiidi mu muzabikisa.<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />Yizeno ku meno, yeno bamvimba lu balebakana mu dyambu di bizitu, meno nina luhaana mvundulu. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Lwaateeno ntumunu ani na tambuleeno ndongosolo zani, meno nidi wulembama mpe nidi na mutima wukuluka, mboki meno nina haana mvundulu ku myela myeno. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Mu dyambu ti ntumunu ani yilembama yidi, na kizitu kyani kilenga kidi.»<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">Yesu na saba</para>
  <para style="r">(<ref loc="MRK 2:23-28">Mlk 2.23-28</ref>; <ref loc="LUK 6:1-5">Luk 6.1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Mu kilumbu ki saba, Yesu wedi wuhyokila mu mfuba zibele. Milongoki myandi mibaka nsatu, na mitona mu kwe hedi mbutu zibele, na mu kwe dye zo. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Bafalisi bu bayena bobo bata ti: «Tala milongoki myaku mina hidika misamu mi bakanikina mu kilumbu ki saba!» <verse eid="MAT 12:2" /><verse number="3" style="v" sid="MAT 12:3" />Yesu wubavutudila ti: «Lutanga ko misamu mihidika Davidi bu kaba na nsatu, yandi mpe na bantu baba nandi kintwadi e? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Wukota mu nzo-Nzambi, mpe badya mampa ma minkayulu, mpeleko zinganga-Nzambi kwandi zii na luve lwe dya mo, kansi ka yandi na bantu baba nandi kintwadi ko. <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Hoti lutanga mu Misiku mi Mose ko ti, mu kilumbu ki saba, zinganga-Nzambi zikwe salanga mu nzo-Nzambi bakwe tingunanga musiku wu saba, kondo mu baka kibila e? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Kansi, meno nina luteela ti, ehaha, ha na kima kivudidi bunene na nzo-Nzambi! <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Tala ti lutomini zaba mbangudulu eyi: Meno mutima wumbote ntiidi, ka munkayulu ko, nganunu luheeni kitumbu ku bantu balembolo sa kibila ko. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Mu dyambu ti Mwana Muntu wudi Mfumu yi saba.»<verse eid="MAT 12:8" /></para>
  <para style="s1">Yesu wunyakisa bakala diba na kooko kusyoka</para>
  <para style="r">(<ref loc="MRK 3:1-6">Mlk 3.1-6</ref>; <ref loc="LUK 6:6-11">Luk 6.6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Yesu wukatuka hoho na wukota mu nzo yi lusambulu yi Bayudayo. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Muba na bakala dimosi diba na kooko kusyoka. Bafuula ku Yesu ti: «Nganunu bufwanakani mu nyakisa mu kilumbu ki saba e?» Mwanki ba baka kibila kiba mufundila. <verse eid="MAT 12:10" /><verse number="11" style="v" sid="MAT 12:11" />Yesu wubavutudila ti: «Nkye muntu ha kati dyeno wuna dimeme dimosi, na dibwidi mu kati dibulu mu kilumbu ki saba, kakwe dye tombola ko e? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Bwedi, muntu kavudidi dimeme mfunu ko e? Buna, bufwanakani mu hidika musamu wumbote mu kilumbu ki saba.»<verse eid="MAT 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13" />Buna, wuta ku muntu ti: «Lambula kooko kwaku.» Ni kalambula ko, mboki kooko kwandi ku hilama bonso bu ba kuhiika. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Bafalisi baduuka, na bamusila mfundu mu zaba bwedi bamuhondila.<verse eid="MAT 12:14" /></para>
  <para style="s">Yesu ni Kisadi ki soola Nzambi</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Yesu bu kayuwa musamu bewowo, wusisa kifulu bekyokyo na mpumbu yiyinene yi bantu yi mulanda. Wunyakisa mbevo zimvimba, <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />kansi Yesu wubakanikina mu ngolo mu lembolo muzabikisa ku bantu. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Mwanki misamu mi ta mumbikudi Yesaya myenda detila:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />«Ki ni kisadi kyani ki nasodidi,</para>
  <para style="q1" vid="MAT 12:18">ki ntomini tya na kyese kyani kimvimba kii mu yandi.</para>
  <para style="q1" vid="MAT 12:18">Nina tuula Mpeve ani mu yandi</para>
  <para style="q1" vid="MAT 12:18">na wuna samuna lunungu ku nsi zimvimba.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Kaasosa mayuma ko na kaazangula ndinga ko,</para>
  <para style="q1" vid="MAT 12:19">baayuwa mbembo andi mu nzila ko.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Kaabokola dyadya di fumbama ko</para>
  <para style="q1" vid="MAT 12:20">na kaazima mwinda wuna lembolo toma lema ko.</para>
  <para style="q1" vid="MAT 12:20">Bwabobo kaasadila natee bu kanungisi lunungu,<verse eid="MAT 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21" />na nsi zimvimba zaasa kivuvu kyawu mu nkumbu andi.»<verse eid="MAT 12:21" /></para>
  <para style="s1">Mvutu yi Yesu ku Bafalisi</para>
  <para style="r">(<ref loc="MRK 3:22-30">Mlk 3.22-30</ref>; <ref loc="LUK 11:14-23">Luk 11.14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Bamutwadila bakala dimosi diba mpofo na baba, mu dyambu ti mpeve yimbi yi ba nandi. Yesu wumunyakisa, ni katona mu zonza na mu yena. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Mpumbu yi bantu yiyituku na yita ti: «Yanduwu ka mwana wu Davidi ko e?» <verse eid="MAT 12:23" /><verse number="24" style="v" sid="MAT 12:24" />Bafalisi bu bayuwa bobo bata ti: «Muntu bewuwu mu lulendo lu Belizebuli<note caller="+" style="f"><char style="fr" closed="false">12.24 </char><char style="ft" closed="false">Belizebuli: nkumbu yihiika yi Satana</char></note>, mfumu yi mpeve zimbi, kana kumina mpeve zimbi!» <verse eid="MAT 12:24" /><verse number="25" style="v" sid="MAT 12:25" />Kansi Yesu wuzaba mayindu mawu na wubateela ti: «Tala ti bantu bakintinu kimosi bakabukidi yawu na yawu kimwangani. Yonso mbanza hoti nzo yidi ti bantu ba bakabuka yawu na yawu, yilendi tatamana mu zingila ko. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Tala ti Satana wuna kuma satana, wu wukabuka yandi bende. Bwedi kimfumu kyandi kyaatatamana mu zingila e? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Tala ti meno, mu lulendo lu Belizebuli nina kwe kumini mpeve zimbi, baala beno mu lulendo lu nani bakwe zi kuminanga e? Ni hahoho, baala beno baaba mimfundisi myeno. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Kansi, tala ti mu Mpeve yi Nzambi nina kumina mpeve zimbi, kedika Kimfumu ki Nzambi bwabu ki tudidi ku yeno.<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />Kunani muntu wulenda kota mu nzo yi muntu wuu na ngolo mu muzika mvwilu andi yimvimba, tala ti ka mubindikidi ntete misinga ko. Ni bwabobo kaamuzikila mvwilu andi yimvimba yi mu nzo andi. <verse eid="MAT 12:29" /><verse number="30" style="v" sid="MAT 12:30" />Wonso lembolo ba nani kintwadi, mbeni ani kadi, mpe yondowo kwe lembolo yonzikanga kintwadi nani, kwe mwangisanga. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Ni hahoho nina luteela ti: Balendi lemvokila bantu bahidikidi masumu, na basafudi Nzambi: kansi wonso waasafula Mpeve Yilongo kalendi tambula ndemvokolo ko. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Wonso waatyaka Mwana Muntu, baamulemvokila, kansi wonso waatyaka Mpeve Yilongo, baamulemvokila ko, ni yiba mu ntangu beyiyi hoti mu ntangu yina kwiza.<verse eid="MAT 12:32" /></para>
  <para style="s1">Kadi muti na mbutu zandi</para>
  <para style="r">(<ref loc="LUK 6:43-45">Luk 6.43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />Mu baka mbutu zimbote, muti wufweti ba wumbote. Tala ti muti wumbi wuu naku, mbutu mpe zimbi waabaka. Mu dyambu ti, bakwe zabilanga muti mu mbutu zandi. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Kanda di zimpidi! Bwedi lulendi teela misamu mimbote, yeno luu nkatika bantu bambi e? Mu dyambu ti mikwe duukisanga munwa, myamyomyo mifulukidi mu mutima. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Muntu wumbote, kwe duukisanga misamu mimbote mu mutima andi wuu wufuluka mu misamu mimbote, kansi muntu wumbi kwe duukisanga misamu mimbi mu mutima andi wuu wufuluka mu misamu mimbi. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />Nkatika nina luteela ti: mu kilumbu kimfundusu, kadi muntu waavutula zimvutu mu misamu mimvimba milembolo fwanakana mi ka duukisa ha munwa andi. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Kadi ni mu misamu mikwe duukisanga ha munwa aku ba ku nungisina, mpe ni mu misamu mikwe duukisanga ha munwa aku ba ku bedisila.»<verse eid="MAT 12:37" /></para>
  <para style="s1">Bafalisi balombidi kidimbu</para>
  <para style="r">(<ref loc="MRK 8:11-12">Mlk 8.11-12</ref>; <ref loc="LUK 11:29-32">Luk 11.29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Mwa ndambu yi milongisi mi Misiku na Bafalisi bateela Yesu ti: «Mulongisi, tutidi wu tulonka kidimbu kingitukulu, tuyena kyo.» <verse eid="MAT 12:38" /><verse number="39" style="v" sid="MAT 12:39" />Yesu wubateela ti: «Mbandu beyiyi yimbi na yi kinsuza yina sosa kidimbu, kansi ku kidimbu ki kaka kiba lulonka ko, tala ti ka ki mumbikudi Yona ko. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Kadi bonso Yona wusa bilumbu bitatu na mpimpa zitatu mu kati di moyo wu mbizi yiyinene, Mwana Muntu mpe waasa bilumbu bitatu na mpimpa zitatu ku nsye butoto. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Mu kilumbu kimfundusu, bantu bambanza yi Ninive baatelama ha kimosi na mbandu beyiyi, babedisa yo, mu dyambu ti bisi-Ninive bavilula madyela bu bayuwa ndongolo yi Yona. Kansi, ehaha, ha na muntu wuvudidi Yona! <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Mu kilumbu ki mfundusu, ntinu yi mukento yi nsi yi Sude yaatelama ha ntadisi yi mbandu beyiyi, waabedisa yo, mu dyambu ti wufuma ku nsi zi sukina butoto mu kwiza yuwa mambu ma ntinu Solomo ma fuluka mu ndwenga. Kansi, ehaha, ha na muntu wuvudidi ntinu Solomo!<verse eid="MAT 12:42" /></para>
  <para style="s1">Mvutukulu yi mpeve yimbi mu muntu</para>
  <para style="r">(<ref loc="LUK 11:24-26">Luk 11.24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />Tala ti mpeve yimbi yi totokidi mu muntu, yakwe dyengila ku nsi yinkatu mu kwe sosa kibuka ki kaaba. Tala ti kabeki kyo ko, <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />mbo yita ti: “Mbote bu navutukidi ku nzo ani yi nasisidi.” Bu yaavutuka, bweni yo yimpamba, yikombolo na yihidiku bumbote. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Ni hahoho, bu yakwe landa mpeve nsambwadi zihiika zi muvudidi bubi, bu zaakwiza kintwadi nandi, zaakota mpe zaazakala momo. Ku manima kitezo ki muntu bewowo kyaalutila ku koba na bu kabedi ntete. Bwabobo mpe bwaaba ku mbandu beyiyi yimbi.»<verse eid="MAT 12:45" /></para>
  <para style="s1">Ngudi na mpangi zi Yesu</para>
  <para style="r">(<ref loc="MRK 3:31-35">Mlk 3.31-35</ref>; <ref loc="LUK 8:19-21">Luk 8.19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Yesu bu kedi zonza ntete ku mpumbu yi bantu, ngudi andi na mpangi zandi baba batelama ha mbazi na basosa mu zonza nandi. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Muntu wumosi wuteela Yesu ti: «Ngudi aku na mpangi zaku ha mbazi baa batelama, mpe batiidi mu zonza naku.» <verse eid="MAT 12:47" /><verse number="48" style="v" sid="MAT 12:48" />Kansi Yesu wuvutula ti: «Nani wuu ngudi ani mpe banani baa zimpangi zani e?» <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Mboki wulambula kooko ku milongoki myandi na wuta ti: «Taleeno! Ngudi ani na zimpangi zani eba! <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Mu dyambu ti, wonso muntu kwe sadilanga luzolo lu Tata ani wu ku mazulu, yandi wuu mpangi ani, kibusi kyani mpe ngudi ani.»<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s1">Kingana ki kisadi ki mfuba</para>
  <para style="r">(<ref loc="MRK 4:1-9">Mlk 4.1-9</ref>; <ref loc="LUK 8:4-8">Luk 8.4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Kilumbu bekyokyo kwandi, Yesu wutotoka mu nzo, na wuyenda zakala ha kumu di mubu. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Mpumbu yi bantu yiyiza kutakana ha kabela. Wukota mu mulungu na wuzakala, mpe mpumbu yi bantu yiba yitelama ha kumu. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Wubalonga misamu mimingi mu bingana, na wubateela ti: «Kisadi kimfuba kiyenda mu kwe mwanga nswanga. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Bu kedi kwe mwangi nswanga, ndambu yi nswanga yibwa ha sambu di nzila: banuni bayena yo na badya yo. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Ndambu yihiika yibwa ha butoto bu ba na matadi na butoto buba bubwingi ko. Yi tumbu mena, mu dyambu ti butoto buba busunda ko. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Kansi mwini bu wuteka, wuyoka na wuyumisa yo, mu dyambu ti yiba na myanzi ko. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Na ndambu yihiika yibwa ha kati di bititi binsende. Bititi binsende bikula na bifyetikisa yo. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Kansi zihiika zibwa ha butoto bumbote, zibuta mbutu mu bikanka: bikanka bihiika bibuta nkama, bihiika makumasambanu, na bihiika dyaka makumatatu.» <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Na Yesu wuta dyaka ti: «Wonso wuu na makutu mu yuwa, bika kayuwa!»<verse eid="MAT 13:9" /></para>
  <para style="s1">Mu dyambu di nki, Yesu kazonzila mu bingana</para>
  <para style="r">(<ref loc="MRK 4:10-12">Mlk 4.10-12</ref>; <ref loc="LUK 8:9-10">Luk 8.9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Milongoki mifinama ha bela Yesu na bamufuula ti: «Bila nki kwe bazonzilanga mu bingana e?» <verse eid="MAT 13:10" /><verse number="11" style="v" sid="MAT 13:11" />Wubavutudila ti: «Yeno baluhaana luve mu zaba mansweki ma kimfumu ki mazulu, kansi yawu ba bahaana lo ko. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Kedika, baahaana ku yondowo tekidi na kima, mpe waaba na byo bibingi, kansi yondowo lembolo ba na kima, baamubonga mwa ndambu yo yitekidi nandi. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Ni hahoho nakwe bazonzilanga mu bingana: mu dyambu ti bana tala, kansi bana yena ko, mboki bana yuwa, kansi bana yuwa ko mpe bana bakula ko. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />Mwanki misamu mi ta mumbikudi Yesaya myenda detila:</para>
  <para style="q1" vid="MAT 13:14">Luna toma yuwa, kansi luna bakula ko,</para>
  <para style="q1" vid="MAT 13:14">Luna toma tala, kansi luna yena ko.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Mu dyambu ti mitima mi bantu bebaba myeka ngolo.</para>
  <para style="q1" vid="MAT 13:15">Bakengi makutu mawu,</para>
  <para style="q1" vid="MAT 13:15">na bazimini meso mawu,</para>
  <para style="q1" vid="MAT 13:15">mwanki balembolo yena mu meso mawu,</para>
  <para style="q1" vid="MAT 13:15">balembolo yuwa mu makutu mawu,</para>
  <para style="q1" vid="MAT 13:15">na balembolo bakula mu mitima myawu,</para>
  <para style="q1" vid="MAT 13:15">mwanki balembolo vutuka ku meno mpe na banyakisa.<verse eid="MAT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />Kansi kyese ku yeno mu dyambu ti, meso meno mena yena, mpe makutu meno mena yuwa! <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Kedika nina luteela, mimbikudi mimingi na bantu baludedomo batya mu yena mi luna yena, kansi bayena ko, na batya mu yuwa mi luna yuwa, kansi bayuwa myo ko.<verse eid="MAT 13:17" /></para>
  <para style="s1">Mbangudulu yi kingana ki muntu wuyenda mwanga nswanga</para>
  <para style="r">(<ref loc="MRK 4:13-20">Mlk 4.13-20</ref>; <ref loc="LUK 8:11-15">Luk 8.11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />Yuweno mbangudulu yi kingana ki muntu wuyenda mwanga nswanga. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Bantu bakwe yuwanga mambu ma Kimfumu ki mazulu na bakwe lembolo bakulanga mo, bafwanakani na nswanga yibwa ha ndambu yi nzila. Nkadyampemba bu kaakwiza wubakatudi mo mu mitima myawu. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Bahiika bafwanakani bonso nswanga yibwa ha butoto bu matadi, ni yobobo bakwe yuwanga mambu mpe bakwe tumbu tambulanga mo mu kyese, <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />kansi malendi mena myanzi mu yawu bende ko, bakwe kwikilanga mu mwa ntangu yifyoti. Mboki, misamu mi mpasi hoti mfyetokoso ti zi batudidi mu dyambu di mambu ma Nzambi, bakwe bwisanga kiminu kyawu. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Bahiika dyaka bafwanakani bonso nswanga yibwa ha kati di nsende: bakwe yuwanga Mambu ma Nzambi, kansi nsatu yi bimvimba bi ha nza na mpukumunu yi bimvwama, bikwe sanga ti Mambu ma Nzambi maba mafyetakana mu luzingu lwawu, na makwe butanga mimbutu ko. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Bahiika dyaka bafwanakani bonso nswanga yibwa ha butoto bumbote: ni yobobo bakwe yuwanga Mambu ma Nzambi mpe bakwe bakulanga mo, bakwe butanga mimbutu: wumosi nkama, wuhiika makumasambanu, na wuhiika dyaka makumatatu.»<verse eid="MAT 13:23" /></para>
  <para style="s1">Kingana ki kititi kimbi</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Yesu wubateela kingana kihiika: «Kimfumu ki mazulu kifwanakani bonso muntu kunini nswanga yimbote mu mfuba andi. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Kansi mu mpimpa, bantu bamvimba bu balambalala, mbeni andi wuyiza na wukuna kititi kimbi ha kati dibele na wuyenda kwandi. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Nswanga bu yimena na bu yi duukisa mbutu, kititi kimbi kimena mpe. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />Bisadi byandi biyiza muteela ti: “Mfumu, kadi wukunini nswanga yimbote mu mfuba aku ko e? Kwedi kufumini bwabu kititi bekiki kimbi e?” <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />Wuvutula ti: “Mbeni siidi bobo.” Buna bisadi bimufuula ti: “Tiidi twenda tuvuza kititi bekyokyo kimbi e?” <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />Wuvutula ti: “Kaani! Mu dyambu ti bu luvuzidi kititi bekyokyo kimbi, lulenda vuza mpe bele. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Bikeeno bimenina ha kimosi natee bu tuna yonzika. Mu ntangu yaaba ngyonzokolo, naateela ku biyonziki ti: Katuleeno ntete kititi kimbi na kangeeno kyo mu mwita<note caller="+" style="f"><char style="fr" closed="false">13.30 </char><char style="fq" closed="false">Mwita </char><char style="ft" closed="false">Kiko ki bititi kidi </char></note> mwanki luyoka kyo, mboki yonzikeno mbutu zibele mu kati di kilundulu.”»<verse eid="MAT 13:30" /></para>
  <para style="s1">Kingana ki nswanga yi mutaade</para>
  <para style="r">(<ref loc="MRK 4:30-32">Mlk 4.30-32</ref>; <ref loc="LUK 13:18-19">Luk 13.18-19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Yesu wubateela dyaka kingana kihiika ti: «Kimfumu ki mazulu kifwanakani bonso nswanga yi mwa muti wu nkumbu mutaade, yi bongidi muntu mpe kunini yo mu mfuba andi. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Mpeleko nswanga beyoyo yivudidi bukeke mu nswanga zimvimba, kansi bu yimenini, yavula bunene mu mwa miti mimvimba mi mfuba. Bu yeka mwa muti, banuni bakwiza tunga mazanza mawu mu bintala byandi.»<verse eid="MAT 13:32" /></para>
  <para style="s1">Kingana ki kima kikwe vimbisanga kiputi ki mampa</para>
  <para style="r">(<ref loc="MRK 4:33-34">Mlk 4.33-34</ref>; <ref loc="LUK 13:20-21">Luk 13.20-21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Yesu wubateela dyaka kingana kihiika: «Kimfumu ki mazulu kifwanakani bonso kima kikwe vimbisanga kiputi ki mampa ki bongidi mukento na vukidi kyo na bitezo bibingi bi faline natee kimvimba bu kivimbidi.»<verse eid="MAT 13:33" /></para>
  <para style="s1">Bwedi Yesu kedi sadilanga bingana</para>
  <para style="r">(<ref loc="MRK 4:33-34">Mlk 4.33-34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Yesu wusadila bingana mu zonza ku mpumbu zi bantu misamu bemyomyo mimvimba, na ka bazonzila kondo ku bingana ko. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Mwanki misamu mi ta mumbikudi myenda detila:</para>
  <para style="q1" vid="MAT 13:35">Nina bazonzila mu bingana,</para>
  <para style="q1" vid="MAT 13:35">«Nina samuna misamu miswama tuka mbadukulu yi nza.»<verse eid="MAT 13:35" /></para>
  <para style="s1">Yesu wubangula kingana ki kititi kimbi</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Mboki Yesu wusala sisa mpumbu zi bantu na wuyenda ku nzo. Milongoki myandi mifinama na mi muteela ti: «Tubangudila kingana ki kititi kimbi ki mu mfuba.» <verse eid="MAT 13:36" /><verse number="37" style="v" sid="MAT 13:37" />Yesu wubateela ti: «Yondowo wukwe kunanga nswanga yimbote, ni Mwana Muntu, <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />mfuba, ni nza, nswanga yimbote yena lonka baala ba ki Kimfumu ki Nzambi, na nswanga yimbi yena lonka baala ba Munga Mbi, <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />mbeni yikwe kunanga nswanga yimbi, ni nkadyampemba, ngyonzokolo, ni nsukunu yi nza, bisadi byayonzika, ni zimbazi. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />Bonso bu bakwe katudilanga kititi kimbi mu tuba kyo ku tiya, bwabobo mpe bwaabeela nsukunu yi nza: <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Mwana Muntu waatambika zimbazi zandi, zaakatula mu Kimfumu kyandi bamvimba bakwe bwisanga ba nawu mu masumu na yobobo bakwe hidikanga mimbi, <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />mpe wuna balosa mu kati di kifuudu ki tiya tungolo, kwakoko babingi baadila na baakwetisa meno. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Kansi bantu baludedomo baalezima bonso ntangu mu Kimfumu ki Tata awu. Wonso wuna makutu mu yuwa, bika kayuwa!<verse eid="MAT 13:43" /></para>
  <para style="s1">Kimvwama ki sweko</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />Kimfumu ki mazulu kifwanakani na kimvwama ki baswekidi mu mfuba. Muntu bu kabakudi kyo na bwesi toma kye sweka. Mu kyese bekyokyo wenzi teka bima bimvimba bii nandi, mboki sumbidi mfuba beyoyo.<verse eid="MAT 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />Kimfumu ki mazulu kifwanakani dyaka bonso munkiti wumosi wuna kwe sosi palata zimbote. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Bu kabeki palata yi nkatika ntalu yiyingi, wenzi teka bima bimvimba bi nandi, mboki sumbidi yo.<verse eid="MAT 13:46" /></para>
  <para style="s1">Kingana ki mpwasa</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />Kimfumu ki mazulu kifwanakani dyaka bonso mpwasa yi balosidi mu mubu na yibeki mbizi zimpila mu mpila. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Bu yifulukidi, bilobi babendidi yo natee ha kumu di mamba, mboki bazakadi mu soola zimbizi: zimbote batudidi zo mu mikuta mpe balosidi zimbi. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Bwabobo mpe bwaaba mu nsukunu yi nza: zimbazi zaakwiza hambisa bantu bambi na bantu ba lunungu, <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />mu loosa bantu bambi mu kati di kifuudu ki tiya tungolo, kwakoko baadidila na baakwetisila meno.<verse eid="MAT 13:50" /></para>
  <para style="s1">Bimvwama binkulu na bimoona</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />Yesu wubafuula ti: Misamu myo mimvimba myalubakudi e?» Bavutula ti: «Ninga.» <verse eid="MAT 13:51" /><verse number="52" style="v" sid="MAT 13:52" />Wubateela ti: «Ni hahoho, ti mulongisi wu Misiku weka mulongoki wu Kimfumu ki mazulu, fwanakani na mfumu yi nzo yikwe bonganga mu kati di kimvwama kyandi bima bimoona na bima bintama.»<verse eid="MAT 13:52" /></para>
  <para style="s1">Bantu ba Nazaleti bakwikila Yesu ko</para>
  <para style="r">(<ref loc="MRK 6:1-6">Mlk 6.1-6</ref>; <ref loc="LUK 4:16-30">Luk 4.16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Yesu bu kamana bateela bingana bebyobyo, wuyenda kwandi. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />Wuyenda ku mbanza yi kakudila. Wulonga mu kati di nzo yi lusambulu yi Bayudayo, bamvimba bedi mu yuwa, bayituku na bata ti: «Kwedi kabakidi ndwenga zi mutindu bewuwu e? Bwedi kalendi hidikila bimangu bibubu e? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Wuwu kaa mwana wu kisadi ki mabaya ko e? Ngudi andi ka ni Maliya ko e? Zaki, Yosefi, Simoni na Yuda, ka zimpangi zandi ko e? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Bibusi byandi, bakwe zakalanga neto ko e? Kwedi kabakidi lulendo lu mpila beyoyo e?» <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Kansi mimvimba bemyomyo mi bakakidila mu kwikila mu Yesu. Yesu wubateela ti: «Mumbikudi bakwe muzitisanga mu nsi andi na mu nzo andi ko.» <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />Yesu kasa bimangu bibingi koko ko mu dyambu ti baba na lukwikulu ko.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s1">Lufwa lu Yoane Mumbotiki</para>
  <para style="r">(<ref loc="MRK 6:14-29">Mlk 6.14-29</ref>; <ref loc="LUK 9:7-9">Luk 9.7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Mu ntangu beyoyo, Elode munyadi mu Ngalili, wuyuwa nsangu zi Yesu. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />Na wuteela bisadi byandi ti: «Ni Yoane Mumbotiki: wufulukidi mu bafwa! Ni hahoho kaa na lulendo mu sa bimangu.»<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Mu dyambu ti Elode wukangisa Yoane, bamumbidika syeni na bamutuula mu boloko. Mu dyambu di Elodiade, mukento wu mpangi andi Filipi. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Kadi Yoane wuteela Elode ti: «Wuu na luve ko mukwela Elodiade!» <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Elode wedi sosanga mu hondisa Yoane, kansi wedi yenanga mukangu bunkuta, mu dyambu ti bedi bongilanga Yoane bonso mumbikudi.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />Mu kilumbu ki mukembo wu mbutukulu yi Elode, mwana wu Elodiade wu mukento wukina ha ntadisi yi bantu ba katumisa ku mukembo andi. Wutoma yangidika Elode, <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />mboki Elode ni kadya ndefi mu muhaana kyonso kima ki kaamulomba. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Mu nsindusulu yi ngudi andi, wulomba ti: «Mpana, butusidi bubu, mutu wu Yoane Mumbotiki mu ndonga!» <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />Ntinu wukota mu kyadi, kansi mu dyambu di ndefi yi kadya ha meso ma bantu ba katumisa ku mukembo andi, wutuma ba mutwadila wo. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Wutambika muntu mu kwe tabula mutu wu Yoane Mumbotiki mu boloko. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Batwala mutu andi mu ndonga, na bahaana wo ku mwana ndumba, ni kanata wo ku ngudi andi. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Milongoki mi Yaone bayiza bonga nitu andi na bazika yo, mboki bayenda yadila Yesu mpolo.<verse eid="MAT 14:12" /></para>
  <para style="s1">Yesu wudikila mafunda matanu ma babakala</para>
  <para style="r">(<ref loc="MRK 6:30-44">Mlk 6.30-44</ref>; <ref loc="LUK 9:10-17">Luk 9.10-17</ref>; <ref loc="JHN 6:1-14">Yoa 6.1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Yesu bu kayuwa musamu bewowo, wukatuka hoho na wukota mu mulungu, wuyenda ha kibuka kilembolo ba bantu. Kansi mpumbu zi bantu bu bayuwa wo, basisa zimbanza zawu na bamulanda mu malu. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Bu katotoka mu mulungu, wuyena mpumbu yiyinene yi bantu. Wukota mu kyadi, na wunyakisa zimbevo zawu.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />Nkokila bu yitula, milongoki mifinama ha kabela na mi muteela ti: «Bwisi butonini mu yila, mboki kibuka kitudi ha kima ko. Vutula bantu bamvimba mwanki benda mu mabwala mu sumba bima bye dya.» <verse eid="MAT 14:15" /><verse number="16" style="v" sid="MAT 14:16" />Yesu wubavutudila ti: «Ka nkinzi ko ti Benda, bahaaneeno yeno bende bindya!» <verse eid="MAT 14:16" /><verse number="17" style="v" sid="MAT 14:17" />Kansi bamuvutudila ti: «Mampa matanu na mbizi zole kwandi zi neto.» <verse eid="MAT 14:17" /><verse number="18" style="v" sid="MAT 14:18" />Yesu wubateela ti: «Ntwadileno byo ehaha.» <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Mboki, wutuma ti bantu bazakala ha yulu bititi, wubonga mampa ma matanu na mbizi zole, wusendola meso ku yulu ni kasakumuna byo. Bu kamana bye bukuna ni kahaana byo ku milongoki myandi mwanki bakabula ku mpumbu zi bantu. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Bamvimba badya, bayukuta, na batota mikuta kumi na myole mi baludisa mu bibuku bisadila. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Bantu ba dya, baba kampe mafunda matanu ma babakala, kondo mutanga bakento na baala bafyoti.<verse eid="MAT 14:21" /></para>
  <para style="s1">Yesu wudyata ha mukanda mamba</para>
  <para style="r">(<ref loc="MRK 6:45-52">Mlk 6.45-52</ref>; <ref loc="JHN 6:15-21">Yoa 6.15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Mboki kumanima, Yesu wutuma ku milongoki myandi bakota mu mulungu na batekila ku simu dihiika, mu ntangu yi kedi vutula mpumbu yi bantu. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Bu kamana bavutula, wutomboka ha yulu mulandu mu sambila. Bwisi bu buyila, wuba hoho yandi kaka. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />Mulungu wuba nkatika kitatu na kumu, wuningusu mu bipo bimamba, mu dyambu ti kitembo kingolo ki babwana. <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" />Mu minkyelo mi bwisi, Yesu wuyenda ku ndambusu yi bela milongoki myandi na wedi kwe dyati ha mukanda mamba. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Bamilongoki bu bamuyena wuna kwe dyati ha mukanda mamba, bayena bunkuta bubwingi na bata ti: «Wu mukuyu wudi!» Na mu bunkuta bebobo yawu babulana. <verse eid="MAT 14:26" /><verse number="27" style="v" sid="MAT 14:27" />Kansi Yesu wutumbu bateela ti: «Lwateeno kibakala! Meno kwani, lubandi na bunkuta ko!» <verse eid="MAT 14:27" /><verse number="28" style="v" sid="MAT 14:28" />Petelo wumuteela ti: «Mfumu, tala ti ngeye wudi, tuma niza ku wudi ha mukanda mamba.» <verse eid="MAT 14:28" /><verse number="29" style="v" sid="MAT 14:29" />Yesu wumuteela ti: «Yiza!»</para>
  <para style="p" vid="MAT 14:29">Petelo wutotoka mu mulungu na wedi kwe dyati ha mukanda mamba mu kwenda kubela Yesu. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Kansi bu kayena ti kitembo kina kukula mungolo, wubaka bunkuta. Na wutona mu dyama, wulookana ti: «Mfumu, mvuukisa!» <verse eid="MAT 14:30" /><verse number="31" style="v" sid="MAT 14:31" />Yesu wutumbu lambula kooko, wumusimba na wuta ti: «Ngeye muntu wu kiminu kifyoti wudi! Bila nki sididi maketiketi e?» <verse eid="MAT 14:31" /><verse number="32" style="v" sid="MAT 14:32" />Ya babole bu bamaka mu mulungu, kitembo ki dingama. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Yobobo baba mu mulungu bafukama ha ntadisi yi Yesu na bata ti: «Nkatika, ngeye wu Mwana Nzambi!»<verse eid="MAT 14:33" /></para>
  <para style="s1">Yesu wunyakisa zimbevo ku Ngenezaleti</para>
  <para style="r">(<ref loc="MRK 6:53-56">Mlk 6.53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Bu bamana sabuka dyanga, batula ku kizunga ki Ngenezaleti. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Bantu ba kizunga bekyokyo babakula Yesu ni bayenda mwangisa nsangu zi nyizulu andi mu kizunga kimvimba. Mboki bamutwadila zimbevo zimvimba. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Bamubombidila mwanki basimba kwandi mu sukina kinkutu kyandi. Bantu bamvimba basimba kyo, banyaka.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s1">Bafalisi na kinkulu</para>
  <para style="r">(<ref loc="MRK 7:1-13">Mlk 7.1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Buna Bafalisi na milongisi mi Misiku bafuma ku mbanza Yelusalemi, bayiza yenikina Yesu na bamuteela ti: <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />«Bila nki milongoki myaku mikwe lembolo vumininanga kinkulu ki zinkaka zeto e? Mu dyambu ti bakwe sukulanga moko ko tekila ba dya.» <verse eid="MAT 15:2" /><verse number="3" style="v" sid="MAT 15:3" />Yesu wubavutudila ti: «Kadi yeno, bila nki lukwe tinguninanga ntumunu zi Nzambi, na lukwe sadilanga kwandi kinkulu kyeno e? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Mu dyambu ti, Nzambi wuta ti: “Vumina tata aku na ngudi aku, mpe Yondowo singidi tata andi hoti ngudi andi bafweti mu honda.” <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Kadi yeno, lukwe tanga ti muntu teedi ku tata andi hoti ku ngudi andi ti: “Kima ki naketi kuhaana mu kusadisa, munkayulu we haana ku Nzambi”, <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />na luheeni luve ku muntu bewowo mu lembolo vumina tata andi [hoti ngudi andi]. Ni bwabobo lukwe bikilanga Mambu ma Nzambi mu sadila kinkulu kyeno. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Yeno banga diisu ku nsye lukaya! Yesaya wutoma lubikudila, bu kata ti:<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />“Bantu bebaba</para>
  <para style="q1" vid="MAT 15:8">bakwe nzitisanga kwandi mu bikoba,</para>
  <para style="q1" vid="MAT 15:8">kansi mitima myawu mitatuka na meno.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />Mumpamba bakwe nzitisilanga,</para>
  <para style="q1" vid="MAT 15:9">Mu dyambu ti Misiku mi bakwe longanga, ntumunu zi bantu kwandi zidi.”»<verse eid="MAT 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Mboki Yesu wutumisa mpumbu yi bantu na wubateela ti: «Yuweno na bakuleeno: <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Ka bikwe kotanga mu munwa ko bikwe sumunanga muntu, kansi ni bikwe duukanga mu munwa bikwe sumunanga muntu.» <verse eid="MAT 15:11" /><verse number="12" style="v" sid="MAT 15:12" />Buna milongoki myandi miyiza muteela ti: «Zebi ti misamu miteedi mitesisi Bafalisi sakuba e?» <verse eid="MAT 15:12" /><verse number="13" style="v" sid="MAT 15:13" />Wuvutula ti: «Wonso muti wulembolo kuna Tata ani di ku mazulu waabavuza. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Babikeeno: mpofo zinani zidi. Tala ti mpofo wuna nata munandi mpofo, ya babole baa kwe bwa mu bulu.» <verse eid="MAT 15:14" /><verse number="15" style="v" sid="MAT 15:15" />Petelo wumuteela ti: «Tuhaana mbangudulu yi kingana bekiki.» <verse eid="MAT 15:15" /><verse number="16" style="v" sid="MAT 15:16" />Yesu wuvutula ti: «Yeno mpe lusidi dyaka na madyela ko e? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Yeno luzebi ko ti kyonso kima kikwe kotanga mu munwa wu muntu, mu moyo kikwe kwendanga, kumanima muntu mbo kalosa kyo ku mbazi e? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Kansi misamu mikwe duukanga ha munwa mikwe fumanga ku nsye mutima wu muntu, na myamyomyo mikwe sumunanga muntu. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Ni ku nsye mutima ku kwe fumanga mbanzulu zimbi, kuhonda, kinsuza, kindumba, bwivi, bimbangi bi luvunu, na bituku. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Misamu myamyomyo mikwe sumunanga muntu, kansi kudya kulembolo sukudulu moko kulendi sumuna muntu ko.»<verse eid="MAT 15:20" /></para>
  <para style="s1">Kiminu ki mukento mwisi-Kaana</para>
  <para style="r">(<ref loc="MRK 7:24-30">Mlk 7.24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Mboki Yesu wukatuka huma behoho na wuyenda ku kizunga ki zimbanza Tile na Sidoni. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Mukento wumosi wu mwisi-Kaana wedi zakalanga mu kizunga bekyokyo, wuyiza ku yandi na wuzonza mu ndinga yingolo ti: «Mfumu, Mwana Davidi, wumfwila nkenda! Mpeve yimbi yina toma kwamisa mwana ani wu mukento!» <verse eid="MAT 15:22" /><verse number="23" style="v" sid="MAT 15:23" />Kansi Yesu kamuvutudila nakani musamu ko. Milongoki myandi mifinama mu muteela ti: «Muvutula, mu dyambu ti lusuku kana kwe tusidi kumanima.» <verse eid="MAT 15:23" /><verse number="24" style="v" sid="MAT 15:24" />Yesu wuvutula ti: «Ku mameme mazimbala ma nzo yi Isaeli kaka bamfidisa.»<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />Kansi mukento bewowo wuyiza fukama ha ntadisi andi na wuta ti: «Mfumu, nsadisa!» <verse eid="MAT 15:25" /><verse number="26" style="v" sid="MAT 15:26" />Wumuvutudila ti: «Ka bumbote ko mu bonga dimpa di baala, na mulosa dyo ku baala bambwa.» <verse eid="MAT 15:26" /><verse number="27" style="v" sid="MAT 15:27" />Mukento wumuvutudila ti: «Mfumu, wukedika wudi. Kansi baala bambwa bakwe dyanga nsyebodi zimampa zikwe sotokanga ku nsye meza ma zimfumu zawu.» <verse eid="MAT 15:27" /><verse number="28" style="v" sid="MAT 15:28" />Buna Yesu wumuteela ti: «Ee, mama! Kiminu kyaku kikinene kidi! Bika musamu wu naaku nsatu wuhilama bonso butidi.» Mu kilokola bekyokyo kwandi, mwana andi wu mukento wunyaka.<verse eid="MAT 15:28" /></para>
  <para style="s1">Yesu wunyakisa mbevo zizingi</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Yesu wukatuka huma behoho na wedi kwe yenzi mu kumu di mubu wu Ngalili. Wutomboka ha yulu mulandu na wuzakala. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Mpumbu zi bantu zi yiza ha kaba, na bamutwadila bikata, zimpofo, baa na byeta, mababa, na mbevo zizingi zihiika mpe. Bayiza batuula ha malu ma Yesu, na wubanyakisa. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Mpumbu zi bantu zi yituku bu bayena ti mababa mazonzidi, bikata bidyeti, baa na byeta banyeki, mpe zimpofo ziyeni. Bantu ba zitisa Nzambi yi Isaeli.<verse eid="MAT 15:31" /></para>
  <para style="s1">Yesu wudikila mafunda maya ma babakala</para>
  <para style="r">(<ref loc="MRK 8:1-10">Mlk 8.1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Yesu wutumisa milongoki myandi, na wubateela ti: «Kyadi kikingi nina yenina mpumbu yi bantu beyiyi, mu dyambu ti ki ni kilumbu ki bitatu ki baa kintwadi nani, mpe bana kima kye dya ko. Mpe ntiidi mu bavutula na nsatu ko, balenda kwenda yena mpasi mu nzila.» <verse eid="MAT 15:32" /><verse number="33" style="v" sid="MAT 15:33" />Milongoki mi mufuula ti: «Kwedi twabakila dimpa dilenda dya na yukutisa nza mpumbu yi bantu beyiyi e? Kibuka kitudi ha kima ko.» <verse eid="MAT 15:33" /><verse number="34" style="v" sid="MAT 15:34" />Yesu wubafuula ti: «Mampa makwa maa neeno e?» Bamuvutudila ti: «Nsambwadi, na mwa mbizi zifyoti.» <verse eid="MAT 15:34" /><verse number="35" style="v" sid="MAT 15:35" />Wulomba ku mpumbu yi bantu bazakala ha nsi. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Mboki wubonga mampa nsambwadi na zimbizi, wuvutula matondo. Wubukuna mo na wuhaana mo ku milongoki myandi. Mboki milongoki mi kabula byo ku mpumbu yi bantu. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Bamvimba badya, bayukuta, na batota mikuta nsambwadi mi baludisa mu bibuku bisadila. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Bantu badya, baba mafunda maya ma babakala, kondo mutanga bakento na baala bafyoti. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Ku manima, Yesu wumana vutula mpumbu yi bantu, mboki wukota mu mulungu, na wuyenda ku kizunga ki Mangadana.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s1">Bafalisi na basaduki bana lomba kidimbu</para>
  <para style="r">(<ref loc="MRK 8:11-13">Mlk 8.11-13</ref>; <ref loc="LUK 12:54-56">Luk 12.54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Bafalisi na basaduki bayiza kubeela Yesu mu mutonta, na bamulomba ka balonka kidimbu kyaafuma ku yulu. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />Kansi Yesu wubavutudila ti: [«Bwisi bu bukwe yilanga, lukwe tanga ti: “Ntangu yimbote yaaba, mu dyambu ti yulu dimbwaki didi.” <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Mpe mumene, lukwe tanga ti: “Bubedidi mvula yaanoka, mu dyambu ti yulu dilomba didi.” Luzebi mu tanga bidimbu bi ku yulu, kansi bwedi luna lembolo bakudila bidimbu bi ntangu beyiyi e?] <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Mbandu beyiyi yimbi na yi kinsuza yina sosa kidimbu, kansi ku kidimbu ki kaka kiba lulonka ko, tala ti ka ki mumbikudi Yona ko.» Mboki wusala basisa na wuyenda kwandi.<verse eid="MAT 16:4" /></para>
  <para style="s1">Kima ki Bafalisi na basaduki kikwe vimbisanga kiputi</para>
  <para style="r">(<ref loc="MRK 8:14-21">Mlk 8.14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Milongoki bu basabuka ku simu dihiika, bazimbakana mu nata mampa. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Yesu wubateela ti: «Kebeno kweno! Mu kima ki Bafalisi na basaduki kikwe vimbisanga kiputi.» <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />Milongoki mi banza yawu na yawu ti: «Kana zonzila bobo mu dyambu ti tutwedi mampa ko.» <verse eid="MAT 16:7" /><verse number="8" style="v" sid="MAT 16:8" />Yesu wubakula mayindu mawu, na wubateela ti: «Bila nki luna telasana ti luu na mampa ko e? Yeno bantu ba kiminu kifyoti ludi! <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Luna bakula ko e? Luna bambuka moyo ko mu mampa matanu mu mafunda matanu ma babakala, na lutangu lu mikuta mi luyonzika e? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Na mampa nsambwadi mu mafunda maya ma babakala na lutangu lu mikuta mi luyonzika e? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Bwedi luna lembolo bakudila ti ka mu dyambu di mampa ko na luzonzidi e? Kansi kebeeno kweno mu kima ki Bafalisi na basaduki kikwe vimbisanga kiputi!»<verse eid="MAT 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12" />Buna milongoki mi bakula ti ka mu dyambu di kima kikwe vimbisanga kiputi ki mampa ko kabalwengisila, kansi mu ndongosolo yi Bafalisi na basaduki.<verse eid="MAT 16:12" /></para>
  <para style="s1">Petelo wubakula ti Yesu ni Klisto</para>
  <para style="r">(<ref loc="MRK 8:27-30">Mlk 8.27-30</ref>; <ref loc="LUK 9:18-21">Luk 9.18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Yesu wuyenda ku kizunga ki mbanza yi Kayisali yi Filipi. Wufuula milongoki myandi ti: «Mu nzonzolo zi bantu, Mwana Muntu nani kadi e?» <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" />Bamuvutudila ti: «Bantu bana ta ti Yoane Mumbotiki wudi, bahiika ti Eliya, bahiika dyaka ti Yelemiya hoti wumosi mu mimbikudi.» <verse eid="MAT 16:14" /><verse number="15" style="v" sid="MAT 16:15" />Na wubafuula ti: «Mbo yeno bwedi luna ta e? Meno nani nidi e?» <verse eid="MAT 16:15" /><verse number="16" style="v" sid="MAT 16:16" />Simoni Petelo wumuvutudila ti: «Ngeye ni Klisto, mwana wu Nzambi yi Moyo!» <verse eid="MAT 16:16" /><verse number="17" style="v" sid="MAT 16:17" />Yesu wumuteela ti: «Kyese kyaku, Simoni mwana wu Yona, mu dyambu ti ka nsuni na menga ko bi kubakusi misamu bemyomyo, kansi Tata ani wu ku mazulu. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Bwabu meno nakuteedidi ti, ngeye ni Petelo (mpila mosi tadi), mpe ha yulu tadi bedyodyo naatungila dibundu dyani, mpe myelo mi nsi yi bafwa milendi sa kima ko ha ntadisi andi. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Nina kuhaana nsabi zi Kimfumu ki mazulu: Mimvimba mi waakanga ha butoto myaakangama ku mazulu, mpe mi waanyanguna ha butoto myaanyanguka ku mazulu.» <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />Mboki Yesu wotoma kanikina milongoki myandi mulembolo we ta ku kani muntu ti yandi ni Klisto.<verse eid="MAT 16:20" /></para>
  <para style="s1">Yesu wuzaabisa lufwa na mfulukulu andi</para>
  <para style="r">(<ref loc="MRK 8:31-34">Mlk 8.31-34</ref>; <ref loc="LUK 9:22">Luk 9.22</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Tuka ntangu beyoyo, Yesu wutona mu zabikisa ku milongoki myandi ti fweti kwenda ku Yelusalemi, waayena mpasi zizingi ku bakuluntu, ku zimfumu zinganga-Nzambi na milongisi mi Misiku. Baamuhonda na mu kilumbu kitatu, waafuluka mu bafwa. <verse eid="MAT 16:21" /><verse number="22" style="v" sid="MAT 16:22" />Petelo wunata Yesu ha luhengo na wutona mu musemba ti: «Mfumu! Bika Nzambi ka kukeba. Kaani, misamu bemyomyo milendi kutudila ko!» <verse eid="MAT 16:22" /><verse number="23" style="v" sid="MAT 16:23" />Kansi, Yesu wubangumuka na wuteela Petelo ti: «Satana, nkatukila! Kikaku wudi mu nzila ani, mabanza maku ka mabanza ma Nzambi ko, kansi ma bantu.»<verse eid="MAT 16:23" /></para>
  <para style="s1">Bwedi tulenda landila Yesu</para>
  <para style="r">(<ref loc="MRK 8:34-9:1">Mlk 8.34–9.1</ref>; <ref loc="LUK 9:23-27">Luk 9.23-27</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Ku manima, Yesu wuta ku milongoki myandi ti: «Tala ti muntu tiidi mu ba mulongoki ani , kakizimbakana yandi bende, kananguna kulunsi dyandi na kandanda. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Mu dyambu ti wonso muntu waasosa mu vukisa luzingu lwandi, lwaakahombisa. Kansi wonso muntu waahombisa luzingu lwandi mu dyambu dyani, lwaakavuukisa. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Nkye ndandu kwandi ku muntu beki bimvwama bi nza yimvimba, tala ti hombisi luzingu lwandi e? Hoti, nki muntu kalenda haana mu hingisa luzingu lwandi e? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Mwana Muntu waakwiza mu mukembo wu Tata andi na zimbazi zandi, buna waasenda muntu-muntu bonso buu mavanga mandi. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Wukedika nina luteela, mwa ndambu bantu mu yobobo ba haha, baakifwila ko tala ti bayeni ko Mwana Muntu wuna kwiza bonso ntinu.»<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s1">Yesu wukituka</para>
  <para style="r">(<ref loc="MRK 9:2-13">Mlk 9.2-13</ref>; <ref loc="LUK 9:28-36">Luk 9.28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Bilumbu bisambanu bihyoka, Yesu wubonga Petelo, Zaki na Yoane mpangi andi, na wubanata ha lweka ku yulu mulandu wuwula. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Wukituka ha ntadisi awu, kini kyandi kyedi lezima bonso ntangu, na binkutu byandi bikituka na vekoveko bonso kya. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Bu bayitukulu kwawu, Eliya na Mose bayenika na bedi mokana nandi. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />Petelo wuteela Yesu ti: «Mfumu, bumbote ti tuzakala haha. Tala ti tiidi, nina tunga zinzo zitatu zi bikapu, yimosi yi yaku, yimosi yi Mose na yimosi yi Eliya.» <verse eid="MAT 17:4" /><verse number="5" style="v" sid="MAT 17:5" />Bu kedi zonza bobo, tuti dimpembe dyedi lezima diyiza bafuka. Mpe ndinga yimosi yi yuwakana ku nsye tuti: «Yandi ewu ni mwana ani wu ntomini tya, kyese kyani kimvimba mu yandi kidi. Muyuwileeno!»<verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />Milongoki bu bayuwa ndinga beyoyo, bayena bunkuta bubwingi, ni bafulamana kini ha nsi. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Kansi Yesu wufinama, wubasimba na wubateela ti: «Telameeno, luyenandi bunkuta ko!» <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Bu basendola meso, bayena Yesu yandi kwandi kaka.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Mu ntangu yi bedi kulumuka mulandu, Yesu wubahaana ntumunu eyi: «Luteelandi misamu mi luyeni ku kani muntu ko, natee Mwana Muntu bu kaafuluka mu bafwa.»<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />Mboki, milongoki mifuula Yesu ti: «Bila nki milongisi mi Misiku mikwe teelanga ti Eliya fweti kwiza ntete e?» <verse eid="MAT 17:10" /><verse number="11" style="v" sid="MAT 17:11" />Wubavutudila ti: «Wu kedika wudi ti Eliya fweti kwiza mu sungika misamu bemimi mimvimba. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Kansi meno nina luteela ti: Eliya wuyiza, na bamubakudi ko, bamuhidika misamu mi batya mu muhidika. Bwabobo mpe yawu baayenisina Mwana Muntu mpasi.» <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Mu kilokola bekyokyo, milongoki mibakula ti ni Yoane Mumbotiki kedi bazonzila.<verse eid="MAT 17:13" /></para>
  <para style="s1">Yesu wunyakisa mwana wu ba na kimbevo ki nzyeta</para>
  <para style="r">(<ref loc="MRK 9:14-29">Mlk 9.14-29</ref>; <ref loc="LUK 9:37-43a">Luk 9.37-43a</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Bu batula huma habeela mpumbu yi bantu, bakala dimosi diyiza fukama ha ntadisi yi Yesu, <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />na wuta ti: «Mfumu, fwila mwana ani wu bakala nkenda. Kimbevo kinzyeta kii nandi mpe wuna kwamusu bubwingi: sungula kwe bwanga ku tiya na mu mamba. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Namutwedi ku milongoki myaku, kansi balembakani mu munyakisa.» <verse eid="MAT 17:16" /><verse number="17" style="v" sid="MAT 17:17" />Yesu wuta ti: «Mbandu yi bantu balembolo ba na kiminu na bambi! Ntangu zi kwa naaba neeno e? Mpe ntangu zi kwa naaluvibidila e? Mutwaleeno ehaha.» <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Yesu wubamina mpeve yimbi, mpeve yimbi yiduuka mu mwana, mboki mwana wunyaka hansi na nsi.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Buna milongoki mifinama ku Yesu, na mimufuula ha lweka ti: «Bila nki yeto tulembakani mu kuma mpeve yimbi beyoyo e?» <verse eid="MAT 17:19" /><verse number="20" style="v" sid="MAT 17:20" />Yesu wubateela ti: «Mu dyambu ti kiminu kyeno kifyoti kidi. Kedika nina luteela: Tala ti luna kiminu ki bonso nswanga yi mwa muti wu mutaade, lulenda tuma mulandu bewuwu ti: “Katuka ehaha, na yenda ekuna”, na waakatuka. Kunani kima ki lulenda lembakana. [<verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />Kansi mu lusambulu na mu minunu yi nsoki kaka mpeve yimbi beyiyi yilenda duukila.»]<verse eid="MAT 17:21" /></para>
  <para style="s1">Yesu wuzabikisa lufwa na mfulukulu andi</para>
  <para style="r">(<ref loc="MRK 9:30-32">Mlk 9.30-32</ref>; <ref loc="LUK 9:43-45">Luk 9.43-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Kilumbu kimosi, bu bayenda kutakana ku Ngalili, Yesu wuteela milongoki myandi ti: «Baayekola Mwana Muntu mu moko ma bantu: <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />baamuhonda, kansi kilumbu kitatu waafuluka.» Milongoki mitoma yena kyadi kikingi.<verse eid="MAT 17:23" /></para>
  <para style="s1">Yesu wufuta mpaku yi nzo-Nzambi</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Bu bayenda tula ku mbanza Kapenawumi, yobobo bedi totanga mpaku yi nzo-Nzambi bafinama ku Petelo na bamuteela ti: «Bila nki, Mulongisi eno kakwe lembolo futilanga mpaku yi nzo-Nzambi e?» <verse eid="MAT 17:24" /><verse number="25" style="v" sid="MAT 17:25" />Petelo wuvutula ti: «Ninga, ya kakwe futanga.» Mu ntangu Petelo yi kedi kota mu nzo, Yesu wumutekidila muzonza mu muteela ti: «Simoni, bwedi wuna banzila e? Nani fweti futa mpaku ku zintinu zi ha nza beyiyi e? Bisi-nsi hoti banzenza e?» <verse eid="MAT 17:25" /><verse number="26" style="v" sid="MAT 17:26" />Petelo wumuvutudila ti: «Banzenza.» Yesu wumuteela ti: «Bisi-nsi balendi futa mpaku ko. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Kansi mulembolo batesisa masakuba, yenda ku mubu, loosa ndoba mu mamba, mboki bonga mbizi yintete yi waabaka, na muzibula munwa andi: waayena kima kimosi, kii mbongo zi bisengo. Bonga zo, na yenda bahaana zo, mwanki wufuta mpaku yi yani na yi yaku.»<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s1">Nani hyokidi bunene ha kati dyeno</para>
  <para style="r">(<ref loc="MRK 9:33-37">Mlk 9.33-37</ref>; <ref loc="LUK 9:46-48">Luk 9.46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Mu kilokola bekyokyo kwandi, milongoki miyenda ha ntadisi yi Yesu, na mimufuula ti: «Nani hyokidi mfunu mu Kimfumu ki mazulu e?» <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />Yesu wutumisa mwa mwana wufyoti na wumutuula ha kati dyawu, <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />na wuta ti: «Kedika nina luteela, tala ti lusenzi ndyatulu eno ko na ti lukitukidi bonso mwana wufyoti ko, lwaakota mu Kimfumu ki mazulu ko. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Ni hahoho, wonso muntu waakikulula bonso mwana wufyoti, ni yandi waavula mfunu mu Kimfumu ki mazulu. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />Na wonso muntu waatambula mu nkumbu ani mwana wufyoti bonso yanduwu, meno bende katambudi.<verse eid="MAT 18:5" /></para>
  <para style="s1">Misamu mikwe tukisanga masakuba</para>
  <para style="r">(<ref loc="MRK 9:42-48">Mlk 9.42-48</ref>; <ref loc="LUK 17:1-2">Luk 17.1-2</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />Kansi wonso muntu waabwisa mu masumu wumosi mu baala bebaba bafyoti bakwe kwikilanga mu meno, bumbote ku yandi ba mukanga tadi didinene mu nsingu na ba mu dyamisa ku nsye mamba ma mubu. <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />Nza kyadi kikingi, mu dyambu ti mu na misamu mikwe tesisanga bantu masakuba! Ninga tuzebi ti misamu bemyomyo milendi kondo ko. Kansi kyadi ku muntu wukwe mye tukisanga. <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />Tala ti kooko kwaku hoti kulu kwaku kukwe kubwisanga mu masumu, tabula ko na loosa ko kitatu naku, bufwanakani mu kota mu luzingu lukedika na kooko kumosi hoti na kulu kumosi, na mu tubu ku tiya tu mbungulu na moko maku ma mamole hoti malu maku ma mamole. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Tala ti diisu dyaku dikwe kubwisanga mu masumu katula dyo na loosa dyo kitatu naku, bufwanakani mu kota mu luzingu lukedika na diisu dimosi, na mu tubu ku tiya tu mbungulu na meso ma mamole.<verse eid="MAT 18:9" /></para>
  <para style="s1">Kingana ki dimeme di zimbala na di yenika</para>
  <para style="r">(<ref loc="LUK 15:3-7">Luk 15.3-7</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />Kebeno kweno mu yina wumosi mu baala bafyoti bebaba. Ninga! Nalutedidi ti zimbazi zawu mu mazulu ntangu zimvimba zikwe yenanga Tata ani di ku mazulu. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />[ Kadi Mwana Muntu wizidi mu vukisa bantu bazimbala.]<verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />Bwedi luna banzila e? Tala ti muntu wuu na nkama yi mameme, na zimbisi dimosi, kaasala sisa mameme makumivwa na vwa ko mu mulandu, mu kwe sosa dimeme bedyodyo di zimbadi e? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Bu kaayena dyo, yandi waavula yangalala mu dimeme bedyodyo, kansi ka mu mameme makumivwa na vwa ko malembolo zimbala. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Bumosi mpe, Tata eno wu ku mazulu katiidi ko ti mwana wumosi wuzimbala mu baala bebaba bafyoti.<verse eid="MAT 18:14" /></para>
  <para style="s1">Kulemvolika munaku</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />Tala ti mpangi aku wukusidi bubi, yenda wumusemba ha yeno bole. Tala ti wukuyuwidi, wumuvutudi mu nzila yimbote. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Kansi, tala ti kakuyuwidi ko, bonga muntu wumosi hoti bole lwenda, mwanki ludedikisa mimvimba ha ntadisi yi zimbangi zole hoti zitatu. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Kansi, tala ti bisidi mu bayuwila, yenda wuta wo ku dibundu, tala ti bisidi mu yuwila dibundu, mubongila bonso muntu wu lembolo ba Muyudayo na mutoti wumpaku.<verse eid="MAT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />Kedika naluteedidi, mimvimba mi lwaakanga ha butoto, myaakangama ku yulu. Mpe mi lwaanyanguna ha butoto myaanyanguka ku yulu.<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />Nina luteela dyaka ti, tala ti bantu bole ha butoto bayuwasani mu lomba kyonso-kyonso kima mu lusambulu, Tata ani wu ku mazulu waabahaana kyo. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Mu dyambu ti honso ha kutakani bantu bole hoti batatu mu nkumbu ani, ha kati dyawu nidi.»<verse eid="MAT 18:20" /></para>
  <para style="s1">Kingana ki kisadi kibisa mu lemvokila mpangi andi</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Ni hahoho Petelo kayendila kubeela Yesu na wumufuula ti: «Mfumu, nkumbu zikwa mfweti lemvokila mpangi ani, tala ti wumpidikidi misamu mimbi e? Nkumbu nsambwadi e?» <verse eid="MAT 18:21" /><verse number="22" style="v" sid="MAT 18:22" />Yesu wumuteela ti: «Kaani! Nakuteedidi ko ti natee nkumbu nsambwadi, kansi natee nkumbu makumi nsambwadi ku bwesa sa bobo nkumbu nsambwadi. <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />Ni hahoho, Kimfumu ki mazulu kifwanakani bonso ntinu yimosi yi sosa mu zaba bwedi mindongo myandi mi sadila mbongo zandi. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Bu katona mu sadila bobo, bamutwadila mundongo wumosi wedi mudefa mafunda na mafunda ma mbongo. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Kadi kaba na mbongo ze mufuta ko, mfumu andi wutuma ba muyadika, yandi na mukento andi, na baala bandi na bimvimba biba nandi, mwanki kafuta mfuka andi. <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />Buna mundongo wubwa ha malu mandi na wufulamana ha ntadisi andi, mpe wumuteela ebu: “Mulemvo aku mfumu, vibidila kwandi, zimvimba zakwa naakufuta!” <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Mfumu wumuyenina kyadi, wumuyambudila mfuka na wumubiika kenda kwandi. <verse eid="MAT 18:27" /><verse number="28" style="v" sid="MAT 18:28" />Mundongo bu katotoka, wuyena wumosi mu bakwe salanga nandi, wedi mudefa makumole ma mbongo zi bisengo. Wumuvikitina ha dinga, wutona mu mufyeta mingadi na wumuteela ti: “Mfuta mfuka ani!” <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />Munandi wubwa ha malu mandi na wumubombidila ebu: “Vibidila kwandi zakwa naakufuta!” <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />Kansi yandi wutumbu bisa na wuyenda mutuula mu boloko natee bu kamana futa mfuka andi. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Banandi bahiika ba bakwe salanga, bu bayena bobo, batoma yena kyadi kikingi, na bayenda yadila mfumu awu mpolo mu mimvimba mihyoka. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />Buna mfumu wutumisa mundongo bewowo na wumuteela ti: “Mundongo wumbi wudi! Nakuyambudila mfuka aku yimvimba, mu dyambu ti wumbombidila. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Kansi ngeye wulendi yenina munaku kyadi ko, bonso bu nakuyenina ngeye kyadi.” <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Mfumu andi wubaka mankesi, na wumutuula mu boloko natee bu kamana futa mfuka andi.»<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />Mboki Yesu wuta dyaka ti: «Bwabobo mpe Tata ani wu ku mazulu kaalusendila tala ti lulemvokidi mpangi eno mu mutima wumosi ko.»<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s1">Ndongosolo mu dyambu di mpondolo yi makwela</para>
  <para style="r">(<ref loc="MRK 10:1-12">Mlk 10.1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Yesu bu kamanisa mu longa, wusisa mbanza yi Ngalili na wuyenda ku kizunga ki Yuda, kii kusimu dihiika di nzadi yi Yolodani. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Mpumbu yiyinene yi bantu yimulanda, na wubanyakisa koko.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Bafalisi bayiza mutonta, ni bamufuula ti: Nganunu, bakala wuu na luve mu kuma mukento andi mu kyonso-kyonso kibila e? <verse eid="MAT 19:3" /><verse number="4" style="v" sid="MAT 19:4" />Yesu wubavutudila ti: «Kadi yeno lutanga ko masonama mana ta ti: “Ku mbadukulu, Nzambi wuhidika mukento na bakala,” <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />wuta dyaka ti: “Ni hahoho, bakala kaafweti sisa nzo yi ngudi andi na tata andi mu kwenda ba na mukento andi mpe ya babole baaba muntu wumosi.” <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Buna babwesa ba bantu bole ko, kansi muntu wumosi. Muntu kalendi hambisa yobobo babundidi Nzambi ko! <verse eid="MAT 19:6" /><verse number="7" style="v" sid="MAT 19:7" />Bamuteela ti: Bila nki Mose katumina bakala mu haana ku mukento mukanda we hondila makwela mu ntangu yi ka mukumini e?» <verse eid="MAT 19:7" /><verse number="8" style="v" sid="MAT 19:8" />Wubateela ti: «Mu dyambu di mutima ngolo eno, Mose kaluhaanina luve lwe kuma bakento beno. Kansi ku mbadukulu, bubela bo ko. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Kansi, kedika nina luteela ti: Dyonso bakala dyaakuma mukento andi, tala ti ka mu dyambu di kinsuza ko, na kwedidi wuhiika, sadidi kinsuza.»<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />Milongoki myandi mi muteela ti: «Tala ti bwabobo bakala kafweti sa ku mukento andi, buna bumbote kwandi mu ba mpumpa!» <verse eid="MAT 19:10" /><verse number="11" style="v" sid="MAT 19:11" />Wubateela ti: «Ka bamvimba ko balendi bakula ndongosolo beyiyi, kansi ni yobobo kwandi Nzambi ba kahaana lulendo lwe bakula yo.» <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Ku na bantu, tuka mbutukulu awu, balendi kwela ko, ku na bahiika bakwe lembolo kwelanga mu dyambu ti bantu ba bakitula bobo, bahiika dyaka, mu luzolo lu yawu bende, babisa mukwela mu dyambu di Kimfumu ki mazulu. Wonso lenda bakula ka bakula!<verse eid="MAT 19:12" /></para>
  <para style="s1">Yesu na baala bafyoti</para>
  <para style="r">(<ref loc="MRK 10:13-16">Mlk 10.13-16</ref>; <ref loc="LUK 18:15-17">Luk 18.15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Bantu banata baala bafyoti ku Yesu, mwanki kabatentika moko na kabasambidila. Kansi milongoki mi babamina. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Yesu ni kabateela ti: «Bikeno baala biza ku meno, lubakakidilandi ko mu dyambu ti kimfumu ki Nzambi kifwanakani ku yobobo ba bonso yawu.» <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Bu kabatentika moko na wuyenda kwandi.<verse eid="MAT 19:15" /></para>
  <para style="s1">Yesu na muntu wumvwama</para>
  <para style="r">(<ref loc="MRK 10:17-31">Mlk 10.17-31</ref>; <ref loc="LUK 18:18-30">Luk 18.18-30</ref>; <ref loc="LUK 13:30">13.30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Muntu wumosi wuyenda ha ba Yesu na wumufuula ti: «Mulongisi, nki bimbote nafweti sa mu tambula luzingu lu mimvu ka mimvu e?» <verse eid="MAT 19:16" /><verse number="17" style="v" sid="MAT 19:17" />Yesu wumuvutudila ti: «Bila nki wuna mfudila mu myo mitadidi misamu mimbote e? Wumosi kwandi wudi wumbote. Tala ti tiidi mu tambula luzingu, vumina mina.» <verse eid="MAT 19:17" /><verse number="18" style="v" sid="MAT 19:18" />Wufuula Yesu ti: «Myedi e?» Yesu ni kamuvutudila ti: «Kuhondandi ko, kusadilandi kinsuza ko, kuyibandi ko, kutandi kimbangi ki luvunu ko, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />zitisa tata aku na ngudi aku, mboki zola mfinangani aku bonso ngebende.» <verse eid="MAT 19:19" /><verse number="20" style="v" sid="MAT 19:20" />Toko bedyodyo wuvutula ti: «Mimvimba mya nkwe vuminanga, nki bikaka nafweti sa dyaka e?» <verse eid="MAT 19:20" /><verse number="21" style="v" sid="MAT 19:21" />Yesu wumuteela ti: «Tala ti tiidi mu ba wulunga, yenda, yadika bima byaku bimvimba, kaba byo ku bamiwelo, mbo wubaka kimvwama ki mazulu. Ku manima, yiza, mboki ndanda.» <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" />Toko bedyodyo bu kayuwa bobo, wuyenda na kyadi kyonso, mu dyambu ti wuba na bimvwama bibingi.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Yesu wuteela milongoki myandi ti: «Kedika nina luteela, mpasi ku mvwama mu kota mu kimfumu ki mazulu. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Nalutedidi dyaka ti: bulutidi nayaki-yaki ku kibulu ki nkumbu yi samo mu lutila ha mwa bulu di ntumbu, kansi kamvwama ko mu kota mu kimfumu ki Nzambi.» <verse eid="MAT 19:24" /><verse number="25" style="v" sid="MAT 19:25" />Milongoki bu bayuwa bobo, bayituku bubwingi na bata ti: «Nani kwandi bwabu lenda baka mpulusu e?» <verse eid="MAT 19:25" /><verse number="26" style="v" sid="MAT 19:26" />Yesu wu basungimina na wubateela ti: «Misamu mikwe lembananga bantu, mii mpasi ku Nzambi ko.»<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Buna Petelo wumuteela ti: «Bwabu yeto tumeni sisa bimvimba mu kulanda, mu yeto bwedi bwaabeela e?» <verse eid="MAT 19:27" /><verse number="28" style="v" sid="MAT 19:28" />Yesu wubateela ti: «Kedika nina luteela: Mwana Muntu bu kaazakala ha kyandu kyandi kinkembo ki kintinu andi mu nza yimoona, yeno lundendi lwaazakala mpe mu byandu kumi na byole bi kintinu mu fundisa makanda kumi na mole ma Isaeli. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Na wonso muntu waasisa, nzo andi, mpangi zandi zi babakala, bibusi byandi, tata andi, ngudi andi na baala bandi, na mfuba zandi mu dyambu di nkumbu ani, waabwesa baka byo kuhyoka nkumbu nkama, na waatambula luzingu lu mimvu ka mimvu. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Kansi babingi batekila baazimunina, mboki babingi bazimunina baatekila.»<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s1">Kingana ki bisadi bimfuba yi vinu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />«Kimfumu ki mazulu kifwanakani bonso mfumu yimosi yi nzo yi duuka mu mene na mene mu kwe sosa bisadi bya kwe sala mukomoto ku mfuba andi yi vinu. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Wuyuwasana na bisadi mu bafuta mufutu wu kilumbu kimosi. Ni kabatambika ku mfuba andi yi vinu. <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />Mu ngunga yi vwa yi mene, wuduuka dyaka, na wuyenda bwana ha kibuka bekyokyo kwandi bantu bahiika, bedi lembolo sa kima. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Wubateela ti: “Yeno mpe, yendeeno lusala ku mfuba ani yi vinu na mbo nalufuta mufutu wufwanakani.” <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Ni bayenda. Mu ntangu ha mbata<note caller="+" style="f"><char style="fr" closed="false">20.5 </char><char style="fq" closed="false">Ntangu ha mbata </char><char style="ft" closed="false">Ntangu ha mbata mutu, mbangudulu ni ngunga yi midi. </char></note> wubwesa duuka, mboki mu ngunga yi tatu yi nkokila wubwesa duuka dyaka, mu kadi ntangu wuteela bumosi ku bantu ba kayena. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Bu kaduuka mu ngunga yi tanu yi nkokila, wuyena dyaka bantu bahiika ha kibuka bekyokyo kwandi. Wubateela ti: “Bila nki kilumbu kimvimba luzakididi kweno haha wulembolo sa kima e?” <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />Bamuvutudila ti: “Kunani muntu wutubongidi mu kwe sala mukomoto.” Wubateela ti: “Yeno mpe, yendeeno ku mfuba ani yi vinu.”<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />Nkokila bu yitula, mfumu yi mfuba wuteela ku munkebi wu mvwilu andi ti: “Tumisa bisadi na bafuta mufutu awu, tonina ku bazimunini na mbo wumanisina ku yobobo baatekidingi.” <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />Yobobo ba kabonga mu ngunga yi tanu yi nkokila bayiza, mpe kadi muntu wubaka mufutu wu kilumbu kimosi. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Bantete bu bayiza, babanzila ti yawu mufutu wuhyokidi baabaka, kansi yawu mpe babahaana, ku kadi muntu, mufutu wu kilumbu kimosi. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Bu babaka wo, bavungutila mfumu yi nzo, <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />na bata ti: “Bisadi bebyobyo bi zimunini, yawu ngunga yimosi kwandi basedi, wubaheeni mufutu wumosi na yeto tuyeni mpasi mu sala kilumbu kimvimba ku nsye mbangasi yi mwini!” <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />Kansi mfumu yi mfuba wuvutula ku wumosi mu yawu ti: “Mukundi ani, na kuhidikidi musamu wumbi ko. Tuyuwasani naaku ko ti mu mufutu wu kilumbu kimosi wasadila e? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Bonga mufutu aku na nkatukila. Meno ntiidi mu futa mufutu wumosi ku ngeye na ku kisadi ki zimunini. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Bwedi, nii na luve ko mu hidika myonso mi ntiidi mu mbongo zani e? Hoti musoki wuna nyenina mu dyambu ti muntu wumbote nidi e?” <verse eid="MAT 20:15" /><verse number="16" style="v" sid="MAT 20:16" />Ni hahoho, baatekila baazimunina, mboki baazimunina baatekila.»<verse eid="MAT 20:16" /></para>
  <para style="s1">Mu nkumbu yi tatu, Yesu wuzabikisa lufwa na mfulukulu andi</para>
  <para style="r">(<ref loc="MRK 10:32-34">Mlk 10.32-34</ref>; <ref loc="LUK 18:31-34">Luk 18.31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Yesu bu kedi tomboka ku mbanza Yelusalemi, wunata milongoki myandi kumi na myole ha luhengo na wubateela bu bedi kwe yenzi ti: <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />«Tuna tomboka ku Yelusalemi. Mwana Muntu baamuyekola mu moko ma zimfumu zinganga-Nzambi na milongisi mi Misiku. Baamuzengila lufwa, <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />na baamuyekola ku bantu balembolo ba Bayudayo, mwanki baamuseha, baamuzuba bikoti mboki baamukoma ha kulunsi. Kansi mu kilumbu kibitatu waafuluka mu bafwa.»<verse eid="MAT 20:19" /></para>
  <para style="s1">Ndombolo yi ngudi yi Yoane na yi Zaki</para>
  <para style="r">(<ref loc="MRK 10:35-45">Mlk 10.35-45</ref>; <ref loc="LUK 22:25-27">Luk 22.25-27</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Buna ngudi yi baala ba Zebedayi wuyenda na baala bandi ha ba Yesu. Wufukama ha ntadisi yi Yesu mu mulomba dyambu dimosi. <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />Yesu wumufuula ti: «Nki tiidi e?» Wumuvutudila ti: «Sa ti baala bani ya babole bebaba bazakala ha ndambu aku, wumosi ku kooko kwaku kulumoso na wuhiika ku kooko kwaku ku lubakala mu kimfumu kyaku.» <verse eid="MAT 20:21" /><verse number="22" style="v" sid="MAT 20:22" />Yesu wuvutula ti: «Luzebi mi luna ndomba ko. Lulendi nwa mbungu yi naanwa meno e?» Bamuvutudila ti: «Tulendi ye nwa.» <verse eid="MAT 20:22" /><verse number="23" style="v" sid="MAT 20:23" />Wubateela ti: «Wu makedika, mbungu ani ya lwaanwa. Kansi ka meno ko nina luve mu zenga nani lendi zakala ku kooko kwani ku lumoso mpe ku kooko kwani ku lubakala. Bibuka bebyobyo bidi bi yobobo Tata ani ba kakubikila byo.»<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Bu bayuwa bobo, milongoki kumi mihiika mifwemina mpangi za zizole. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Yesu wubatumisa na wubateela ti: «Luzebi ti Mfumu zi zinsi zikwe bayaalanga mu ngolo zimvimba, mpe minyadi mikwe bayenisanga mpasi zizingi. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Kansi kaabubelandi bobo mu yeno. Yondowo tiidi mu ba muntu wumfunu ha kati dyeno ka ba kisadi kyeno, <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />na yondowo tiidi mu ba wuntete ha kati dyeno ka ba mundongo eno: <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />bwabobo mpe, Mwana Muntu ka yizidi ko ku bantu mwanki ba mu sadila, kansi mu sadila bantu na mu haana luzingu andi bonso mufutu mu kuula bantu babingi.»<verse eid="MAT 20:28" /></para>
  <para style="s1">Yesu wunyakisa mpofo zole ku Yeliko</para>
  <para style="r">(<ref loc="MRK 10:46-52">Mlk 10.46-52</ref>; <ref loc="LUK 18:35-43">Luk 18.35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Yesu na milongoki myandi bu bedi duuka mu mbanza yi Yeliko, kamba di bantu dibalanda. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Mpofo zole ziba zi zakala ha ntendo yi nzila, bu bayuwa ti Yesu wuna hyoka, batona mu bulana ti: «[Mfumu], Mwana Davidi, tufwila nkenda!» <verse eid="MAT 20:30" /><verse number="31" style="v" sid="MAT 20:31" />Kamba di bantu dyedi ba bamina mwanki bakanga minwa myawu, kansi babulana dyaka mungolo ti: «Mfumu, Mwana Davidi, tufwila nkenda!» <verse eid="MAT 20:31" /><verse number="32" style="v" sid="MAT 20:32" />Yesu wutelama, wubatumisa na wubafuula ti: «Nki lutidi na lusila e?» <verse eid="MAT 20:32" /><verse number="33" style="v" sid="MAT 20:33" />Bamuvutudila ti: «Mfumu, sa ti meso meto mazibuka!» <verse eid="MAT 20:33" /><verse number="34" style="v" sid="MAT 20:34" />Yesu wubafwila nkenda, na wusimba meso mawu, hansi na nsi, batona mu bwesa yena, na bamulanda.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s1">Nkotolo yi Yesu ku Yelusalemi</para>
  <para style="r">(<ref loc="MRK 11:1-11">Mlk 11.1-11</ref>; <ref loc="LUK 19:28-40">Luk 19.28-40</ref>; <ref loc="JHN 12:12-19">Yoa 12.12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Bu baba bela-bela na mbanza Yelusalemi na bu batula ha bwala Betefaze, ku mulandu wu Olive, Yesu wutambika milongoki myandi myole. <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />Wubateela ti: «Yendeeno ha bwala bu ku mutwala. Lwaayena mbuluku yi nkento yi yikangama ha muti na mwana andi. Nyanguneeno zo, mpe ntwadileno zo. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Tala ti muntu wuluteedidi dyambu, muteeleeno ti: “Mfumu wuna zo nsatu.” Hansi na nsi waabika zo zenda.»<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Misamu bemyomyo mitula mwanki mita mimbikudi myenda detila:<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />«Teeno ku bantu ba mbanza yi Syoni:</para>
  <para style="q1" vid="MAT 21:5">“Ntinu eno yina kwiza ku yeno,</para>
  <para style="q1" vid="MAT 21:5">wu wufuluka mu lembami,</para>
  <para style="q1" vid="MAT 21:5">tentamani ha yulu mbuluku yinkento,</para>
  <para style="q1" vid="MAT 21:5">na ha yulu mwana mbuluku.”»<verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Milongoki miyenda hidika bonso Yesu kabatumina mu kwe sa. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Banata mbuluku yi nkento na mwana andi. Batentika binkutu awu ha yulu awu. Mboki, Yesu wuzakala ha yulu. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Kamba di bantu didingi dyedi kwe yadi binkutu byawu mu nzila, mpe bahiika bedi kwe zengi mwa bintala bi miti na bedi kwe bye yadi mu nzila. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Kamba di bantu dyedi kwe tekidi na dyedi kwe landi Yesu ku manima dyedi kwe tengi mu ngolo ti: «Ozana! Mwana Davidi! Bika Nzambi kasakumuna muntu wuna kwiza mu nkumbu yi Mfumu! Ozana! Nkembo ku Nzambi yi mu mazulu mahyokidi kuzangama!»<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Yesu bu kakota mu mbanza Yelusalemi, mbanza yimvimba yiningana, na bedi kwe te ti: «Muntu bewuwu nani kadi e?» <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />Kamba di bantu divutula ti: «Ni mumbikudi Yesu, mwisi Nazaleti mu kizunga ki Ngalili.»<verse eid="MAT 21:11" /></para>
  <para style="s1">Yesu wukuma mintekisi mu nzo-Nzambi</para>
  <para style="r">(<ref loc="MRK 11:15-19">Mlk 11.15-19</ref>; <ref loc="LUK 19:45-48">Luk 19.45-48</ref>; <ref loc="JHN 2:13-22">Yoa 2.13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Yesu wukota mu nzo-Nzambi. Wukuma minteki na bisumbi biba momo. Wumwangisa meza ma bedi hyakisanga mbongo na byandu bi minteki mi mabembe. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Mboki wubateela ti: «Wusonama: “Nzo ani, nzo yi lusambulu baatumisina yo.” Kansi, yeno lukitudi yo kiswamunu ki bimpumbulu!»<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Zimpofo na baba na byeta bayenda ha ntadisi andi mu kati di nzo-Nzambi na wubanyakisa. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Zimfumu zinganga-Nzambi na milongisi mi Misiku babaka mankesi bu bayena misamu mingitukulu mi kasa na baala bafyoti bedi lookananga mu nzo-Nzambi ti: «Ozana! Mwana Davidi!» <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />Ni bamuteela ti: «Wuna yuwa misamu mi bena ta e?» Yesu wubavutudila ti: «Ninga, Yeno lutanga mambu masonama mu buuku di Nzambi ko ti: “Mu munwa wu baala bafyoti na wu baala bansombe wuna kemboso bonso bu wutya.”»<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />Mboki wusala basisa na wutotoka mu mbanza mu kwenda ku bwala bu Betani ku kayenda lambidila.<verse eid="MAT 21:17" /></para>
  <para style="s1">Yesu wusinga muti wu fike</para>
  <para style="r">(<ref loc="MRK 11:12-14">Mlk 11.12-14</ref>,<ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Mu mene na mene, Yesu bu kedi vutuka ku mbanza, wubaka nsatu. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Wuyena muti wu fike mu nzila na wufinama, kansi makaya na makaya kwandi kayena. Wusinga muti wu fike ti: «Waabwesa buta dyaka mbutu ko!» Hansi na nsi, muti wu fike wutumbu yuma. <verse eid="MAT 21:19" /><verse number="20" style="v" sid="MAT 21:20" />Milongoki bu bayena bobo bayituku, ni bata ti: «Bwedi muti wu fike bewuwu wutumbu yumina hansi na nsi e?» <verse eid="MAT 21:20" /><verse number="21" style="v" sid="MAT 21:21" />Yesu wubavutudila ti: «Kedika nina luteela, tala ti kiminu ki neeno, na lusidi maketiketi ko, lulendi hidika misamu minsidi ku muti wu fike bewuwu. Lulendi ta mpe ku mulandu bewuwu ti: “Katuka hoho na yenda wu kituba mu mubu”, bwabobo mpe bwaavangama. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Tala ti lukwikidi, mimvimba mi lwaalomba mu lusambulu mya lwaatambula.»<verse eid="MAT 21:22" /></para>
  <para style="s1">Kwedi kufuma lutumu lu Yesu?</para>
  <para style="r">(<ref loc="MRK 11:27-33">Mlk 11.27-33</ref>; <ref loc="LUK 20:1-8">Luk 20.1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Yesu wukota mu nzo-Nzambi bu katona mu longa, zimfumu zinganga-Nzambi na bakuluntu bamukangu bayenda ku kabela na bamufuula ti: «Tuteela, mu lutumu lu nani wuna hidikila misamu bemimi e? Mpe nani wukuheeni lutumu belulu e?» <verse eid="MAT 21:23" /><verse number="24" style="v" sid="MAT 21:24" />Yesu wubavutudila ti: «Meno mpe kyuhu kimosi nina luziika, tala ti lumvutudidi mvutu, naaluteela mu lutumu lu nani, nina hidikila myo. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Nani wutambika Yoane mu botika e? Nzambi hoti bantu e?» Banyunguta yawu na yawu na bata ti: «Ni twaavutula ti “Nzambi”, mbo katufuula ti: “Mu dyambu di nki lulembolo mukwikila e?” <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Tumana vutula ti: “Bantu”, tufweti tiina mukangu, mu dyambu ti mu mabanza mawu, Yoane mumbikudi wuba.» <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />Ni hahoho bavutula ku Yesu ti: «Tu zebyeto ko.» Buna Yesu wubavutudila ti: «Meno mpe naaluteela ko mu lutumu lu nani, nina hidikila misamu bemimi.<verse eid="MAT 21:27" /></para>
  <para style="s1">Kingana ki baala bole</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />Bwabu, bwedi luna banzila musamu bewuwu e? Bakala dimosi diba na baala bole ba babakala. Wuteela mwana wuntete ti: “Mwana ani, yenda wusala bubedidi ku mfuba yi vinu.” <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />Mwana bewowo wumuvutudila ti: “Kaani, naakwendani ko”! Kansi kumanima, wusanza mabanza na wuyenda ku mfuba yi vinu. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />Tata wuteela bobo mpe ku mwana andi wunzole. Yandi wuvutula ti: “Ninga tata, naakwenda”, kansi kayendandi ko. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />Nani mu ya babole wuhidika luzolo lu tata e?» Bavutula ti: «Ni wuntete». Buna Yesu wubateela ti: «Kedika nina luteela, mitoti mimpaku na zinsuza baalutekidila mu Kimfumu ki Nzambi. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Mu dyambu ti Yoane wuyiza ku yeno mu lulonka nzila yi lunungu, kadi yeno lumukwikila ko. Kansi mitoti mimpaku na zinsuza bamukwikila. Mpeleko luyena bo, kansi luviluleeno madyela ko, na lumukwikileeno ko.<verse eid="MAT 21:32" /></para>
  <para style="s1">Kingana ki bisadi bimbi bimfuba yi vinu</para>
  <para style="r">(<ref loc="MRK 12:1-12">Mlk 12.1-12</ref>; <ref loc="LUK 20:9-19">Luk 20.9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />Yuweno kingana kihiika eki: Kuba na mfumu yimosi yikuna mfuba yi miti mi vinu. Wuzunga yo mu lupangu, wutima bulu mu kamunanga mbutu zi vinu mpe wutunga nzo yi kibanga yi munkengi. Mboki, wuhaana yo ku bisadi bi vinu mwanki bafutilanga yo, mpe wuyenda mu nzyetolo. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Ntangu yi nyonzokolo bu yifwana, wutambika mindongo myandi ku bisadi bimfuba yi vinu, mwanki benda babonga mimbutu mi mfuba andi. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Kansi bisadi bimfuba yi vinu babwila mindongo myandi, batuuta wumosi nkuba, bahonda wuhiika mu muwinda matadi ku wu mitatu. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Wubwesa tambika dyaka mindongo mimingi mihiika kuhyoka lutangu luntete. Kansi bisadi bimfuba yi vinu, ba bahidika misamu mi ba sa ku bantete. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Ku manima, wubatambika mwana andi, na wuta ti: “Baavumina mwana ani.” <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />Kansi bisadi bi mfuba yi vinu bu bayena mwana, bateelasana yawu na yawu ti: “Taleno wabyadila fwa! Tokweno, tumuhondeno, mwanki tu byadila fwa dyandi!” <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Bamubwila, bamutuba ku mbazi yi mfuba yi vinu na bamuhonda.<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />Yesu wubafuula ti: Bwabu mfumu yi mfuba yi miti mi vinu bu kaakwiza, nki kaasa ku bisadi bimfuba yi vinu e?» <verse eid="MAT 21:40" /><verse number="41" style="v" sid="MAT 21:41" />Bamuvutudila ti: «Mbo kahondisa bimpumbulu bebibi kondo ku manyongo na mbo kahaana mfuba ku bisadi bihiika bi vinu, yobobo bamuhaananga mbutu mu ntangu yi fwanakani.»<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Mboki Yesu wubateela ti: «Yeno lutanga ko masonama mata ti:</para>
  <para style="q1" vid="MAT 21:42">“Tadi dinyafuna bituungi bi nzo</para>
  <para style="q1" vid="MAT 21:42">dyeka tadi divudidi mfunu.</para>
  <para style="q1" vid="MAT 21:42">Mu dyambu ti Mfumu wusidi ti bubela bobo:</para>
  <para style="q1" vid="MAT 21:42">musamu wungitukulu wudi ha meso meto!”<verse eid="MAT 21:42" /></para>
  <para style="m">
    <verse number="43" style="v" sid="MAT 21:43" />Ni hahoho, nina luteela ti: Mbo balukatula Kimfumu ki Nzambi, na mbo bahaana kyo ku mukangu waabuta mimbutu. [<verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Wonso muntu waabwa ha yulu tadi bedyodyo waamwangana, na wonso wu dyaabwila, dyaamukosona.»]<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />Bu bamana yuwa bingana bebyobyo, zimfumu zinganga-Nzambi na Bafalisi babakula ti yawu kedi zonzilanga, <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />basosa mu mukanga, kansi batiina mpumbu yi bantu, mu dyambu ti bedi mubongila bonso mumbikudi.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s1">Kingana ki ndambisa yi makwela</para>
  <para style="r">(<ref loc="LUK 14:15-24">Luk 14.15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Yesu wubazonzila dyaka mu kingana na wubateela ti: <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />«Kimfumu ki mazulu kifwanakani bonso: Ntinu yimosi wuhidikisa ndambisa yi makwela yi mwana andi wu bakala. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Wutambika mindongo myandi mu kwe teela yobobo ba katumisa ku ndambisa, kansi batya mu kwiza ko. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />Wutambika dyaka mindongo mihiika na wubahaana ntumunu eyi: “Yendeeno luteela ku yobobo bantumisi ku ndambisa ti: Bindya byani byankubikidi, ngombe zani zimbakala na bibulu byani bihiika bitoloka bya mpondidi, bimvimba bikubamani. Yizeeno ku ndambisa yi makwela!” <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />Kansi ba katumisa bayena wo mfunu ko na bayenda ku bisalu byawu: wumosi wuyenda ku mfuba andi, wuhiika wuyenda teka kwandi, <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />na bahiika babwila mindongo, babayenisa mpasi na babahonda. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Ntinu wubaka mankesi, wutambika zimbulumbulu zandi mu kwe honda mimpondi bemyomyo na mu yoka mbanza awu. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Mboki wuteela mindongo myandi ti: “Ndambisa yi makwela yi kubamani, kansi yobobo ba ntumisi bafwanakani mu dya yo ko. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Yendeeno mu mahambu ma nzila, na tumiseno yobobo bamvimba ba luna yena, biza ku ndambisa.” <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Mindongo myandi miyenda mu mahambu ma nzila, bakutikisa bamvimba ba bayena, bambote na bambi. Nzo yi makwela yi fuluka mu bantu. <verse eid="MAT 22:10" /><verse number="11" style="v" sid="MAT 22:11" />Ntinu wukota mu tala bantu ba katumisa, na wuyena bakala dimosi dilembolo lwata kinkutu ki mukembo wu makwela. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Wumufuula ti: “Mukundi ani, bwedi kotididi mumu wulembolo lwata kinkutu ki mukembo wu makwela e?” Kansi muntu bewowo ka muhaana mvutu ko. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />Buna ntinu wuta ku bisadi byandi ti: “Mubindikeno malu na moko, mpe mutubeno ku mbazi ku na mpimpa yi na bokoboko. Ni kwakoko ku bidilu na nkwetosolo yi meno.” <verse eid="MAT 22:13" /><verse number="14" style="v" sid="MAT 22:14" />Mu dyambu ti babingi batumusu, kansi bafyuma basoolo.»<verse eid="MAT 22:14" /></para>
  <para style="s1">Mpaku yi Kayisali</para>
  <para style="r">(<ref loc="MRK 12:13-17">Mlk 12.13-17</ref>; <ref loc="LUK 20:20-26">Luk 20.20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Bafalisi bayenda kutakana mu zaba bwedi balendi lebikila Yesu mutambu mu baka kibila mu mpova zandi. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Bamutambikila milongoki myawu, na bantu ba kimvuka ki Elode. Bantu bebobo bafuula Yesu ti: «Mulongisi, tuzebi ti makedika kwe tanga nakwe longanga nzila yi Nzambi mu makedika, na wukwe tinanga muntu ko mpe ngeye wuswasikisanga bantu ko. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Tuteeleti, bwedi wuna banzila mu musamu bewuwu: nganunu Misiku myeto mikwe tuhaananga luve mu futa mpaku yi Kayisali hoti kaani e?» <verse eid="MAT 22:17" /><verse number="18" style="v" sid="MAT 22:18" />Kansi Yesu wubakula makani mawu mambi, na wubateela ti: «Bantu ba diisu ku nsye lukaya, bila nki luna ntontila e? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Ndongiseeno mbongo zi bakwe futilanga mpaku.» Bamulonka mbongo zimosi zi kisengo, <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />na Yesu wubafuula ti: «Hambo kini na nkumbu binani bidi bisonama mumu e?» <verse eid="MAT 22:20" /><verse number="21" style="v" sid="MAT 22:21" />Bamuvutudila ti: «Bi Kayisali bidi.» Buna Yesu wubateela ti: «Vutuleno bi Kayisali ku Kayisali, bi Nzambi ku Nzambi.» <verse eid="MAT 22:21" /><verse number="22" style="v" sid="MAT 22:22" />Bayituku mu mvutu yi kabahaana. Basala mu sisa na bayenda kwawu.<verse eid="MAT 22:22" /></para>
  <para style="s1">Kyuhu mu mfulukulu yi bafwa</para>
  <para style="r">(<ref loc="MRK 12:18-27">Mlk 12.18-27</ref>; <ref loc="LUK 20:27-40">Luk 20.27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Mu kyo kwa kilumbu, Basaduki, bantu bakwe lembolo kwikilanga mu mfulukulu yi bafwa, bayiza ha ntadisi yi Yesu mu mufuula ti: <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />«Mulongisi, Mose wuta ti: “Tala ti bakala difwidi wulembolo saa buta, mpangi andi yi bakala fweti kwela mufwidi mwanki kahaana nkuna ku yondowo wu fwidi.”<verse eid="MAT 22:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 22:25" />Kansi, ha kati dyeto kuba na zimpangi nsambwadi. Wuntete wukwela na wufwa, kasa buta mwana ko na wusisa mukento andi ku mpangi andi. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Buba bumosi ku mpangi andi yi nzole, mboki yi mitatu natee yi nsambwadi. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Ku manima ma ya bamvimba, mukento mpe wuyiza fwa. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Mu kilumbu ki mfulukulu yi bafwa, mukento wunani waaba e? Mu dyambu ti yawu nsambwadi bamukwela!» <verse eid="MAT 22:28" /><verse number="29" style="v" sid="MAT 22:29" />Yesu wubavutudila ti: «Kuhunuka lusa, mu dyambu ti luzebi masonama na lulendo lu Nzambi ko. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Mu dyambu ti, haaba mfulukulu mu bafwa, bakento na babakala baakwela ko, kansi baaba bonso zimbazi zi mazulu. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Mu myo mitadidi mfulukulu yi bafwa, lutanga misamu miluteela Nzambi ko e? Wuta ti: <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />“Meno nidi Nzambi yi Abalahami, Nzambi yi Isaaki na Nzambi yi Yakobi.” Ka Nzambi yi bafwa ko, kansi Nzambi yi bamoyo.»<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Kamba di bantu dyedi muyuwa bayituku mu ndongosolo andi.<verse eid="MAT 22:33" /></para>
  <para style="s1">Musiku wu vudidi bunene</para>
  <para style="r">(<ref loc="MRK 12:28-34">Mlk 12.28-34</ref>; <ref loc="LUK 10:25-28">Luk 10.25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Bafalisi bu bayuwa ti Yesu kangisi basaduki mu nwa, ni bakutakana. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Wumosi ha kati dyawu, mulongisi wu Misiku wusosa mu mutonta, wumufuula ti: <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />«Mulongisi, nkye mwina wuhyokidi bunene mu Misiku e?»<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />Wumuvutudila ti: «“Zola Mfumu Nzambi aku mu mutima aku wumvimba, mu mwela aku wumvimba na mu madyela maku mamvimba.”<verse eid="MAT 22:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 22:38" />Ni mwina bewowo wuntete na wuvudidi bunene. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Wunzole wumufwanakani, ni ewu: “zola mfinangani aku bonso ngebende.” <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Mina mimvimba mi Mose na masonama mu mabuuku ma mimbikudi bi kangamani mu mina bemyomyo mya mimyole.»<verse eid="MAT 22:40" /></para>
  <para style="s1">Klisto na Davidi</para>
  <para style="r">(<ref loc="MRK 12:35-37">Mlk 12.35-37</ref>; <ref loc="LUK 20:41-44">Luk 20.41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Bafalisi bu baba bakutakana, Yesu wubaziika kyuhu eki: <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />«Nki luna banza mu dyambu di Klisto e? Mwana wu nani wudi e?» Bamuvutudila ti: «Wu Davidi.» <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />Yesu wubateela ti: «Bwedi Davidi, wutwadusu ku Mpeve Yilongo, kalendi mutumisina “Mfumu e?” Mu dyambu ti wuta ti:<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />“Mfumu Nzambi wuta ku Mfumu ani ti:</para>
  <para style="q1" vid="MAT 22:44">Yiza zakala ha lweka lu lubakala lwani,</para>
  <para style="q1" vid="MAT 22:44">Natee bu nasa ti mitantu myaku miba bitentokolo bi bitambi byaku.”<verse eid="MAT 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 22:45" />Tala ti Davidi wuna mutumisina “Mfumu”, bwedi kalendi bwesa bela dyaka mwana andi e?» <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />Ka muntu ko wu muhaana mvutu, mpe tuka kilumbu bekyokyo nakani muntu kedi bwesa muzika dyaka byuhu ko.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s1">Yesu wusemba milongisi mi Misiku na Bafalisi</para>
  <para style="r">(<ref loc="MRK 12:38-39">Mlk 12.38-39</ref>; <ref loc="LUK 11:43">Luk 11.43</ref>,<ref loc="LUK 11:46">46</ref>; <ref loc="LUK 20:45-46">20.45-46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Yesu wuta ku kamba di bantu na ku milongoki myandi ti: <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />«Milongisi mi Misiku na Bafalisi ba bahaana kiyeko mu bangula mina mi Mose. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Lufweti batumimina na lufweti sadila mimvimba mi bakwe lulonganga, kansi lulandandi nkadulu awu ko, mu dyambu ti mi bakwe tanga, bakwe mye sadilanga ko. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Yawu bakwe kanganga bifunda bi kizitu mpe bakwe twikanga byo ha mahembo ma bantu, kansi yawu bende bakwe nikunanga nakani mulembo wumosi ko mu simba byo. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />Misamu mimvimba bemyomyo bakwe mye hidikilanga, mwanki bantu ba bayena. Ni hahoho, bakwe yikanga bunene bu mimbamba misonama bibuku bi mambu ma Nzambi, mi bakwe kanganga ha mbunzu na mu moko mawu. Mpe bakwe yikanga nsongi zi biyunga byawu mwanki biba bibila. <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Bakwe tyanga mu zakala mu byandu bintete mu ntangu yi minkembo mi zindambisa na mu byandu bintete mu zinzo zi lusambulu zi Bayudayo, <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />bakwe tyanga benda bahekingi mbote zi buzitu mu byanzala, na bantu benda batumisiningi ti: “Mulongisi”. <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />Kansi yeno, lutambulandi ko ba lutumisina ti: “Mulongisi”, mu dyambu ti Mulongisi wumosi kwandi wuu neeno, yeno na yeno mpangi na mpangi ludi. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Na lutumisinandi nakani muntu ko ha butoto ti: “tata”, mu dyambu ti “Tata” dimosi kwandi dii neeno, ni dyadyodyo di ku yulu. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Lutambulandi ko ba lutumisina ti: “Ntwadisi”, mu dyambu ti “Ntwadisi” yimosi kwandi yii neeno, ni Klisto. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Yondowo hyokidi mfunu ha kati dyeno fweti ba kisadi kyeno. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Wonso waakizangula baamukulula na wonso waakikulula baamuzangula.»<verse eid="MAT 23:12" /></para>
  <para style="s1">Yesu wusemba milongisi mi Misiku na Bafalisi</para>
  <para style="r">(<ref loc="MRK 12:40">Mlk 12.40</ref>; <ref loc="LUK 11:39-52">Luk 11.39-52</ref>; <ref loc="LUK 20:45-47">20.45-47</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />«Kyadi ku yeno milongisi mi Misiku na Bafalisi, yeno lu bantu ba diisu ku nsye lukaya! Yeno lukwe kanganga mwelo wu Kimfumu ki mazulu ku bantu, yeno bende lukwe kotanga mo ko, mpe lukwe kakidilanga yobobo batidi mu kota momo, bakota.»<verse eid="MAT 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 23:14" />[«Kyadi ku yeno milongisi mi Misiku na Bafalisi, lu bantu ba diisu ku nsye lukaya! Lukwe zyonanga bima bimvimba bi mafoola, na lukwe sanga zinsambulu zizila mu kiyenikisa. Ni hahoho, lwaatambula mfundusu yi hyokidi kitezo.»]<verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />«Kyadi ku yeno milongisi mi Misiku na Bafalisi, lu bantu ba diisu ku nsye lukaya! Lukwe zyetanga mu bifulu bimvimba bii ha butoto na bi mubu mu baka nakani wumosi wu viludi madyela, na bu lumubeki, lumukitudi mwana waatubu ku tiya tu mbungulu, kuhyokidi bitezo byole na yeno.»<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />«Kyadi ku yeno, mintwadisi mi zimpofo! Lukwe tanga ti: “Tala ti muntu didi ndefi mu nkumbu nzo-Nzambi, yi mfunu ko, kansi tala ti muntu didi ndefi mu wola di nzo-Nzambi, fweti vumina ndefi andi.” <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Yeno bizengi na zimpofo zi nani ludi! Nki bihyokidi mfunu, wola, hoti nzo-Nzambi yikwe sanga ti wola diba di longo e? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Lukwe tanga dyaka ti: “Tala ti muntu didi ndefi ha ziku di bakwe yokilanga minkayulu, yi mfunu ko, kansi tala ti muntu didi ndefi mu minkayulu mi ha ziku bedyodyo, fweti vumina ndefi andi.” <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Yeno zimpofo zi nani ludi! Nki bihyokidi mfunu, munkayulu, hoti ziku di bakwe yokilanga minkayulu e? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Wonso didi ndefi ha ziku di bakwe yokilanga minkayulu, didi yo mu nkumbu yi ziku di bakwe yokilanga minkayulu, na mu nkumbu yi bimvimba bi ha yulu ziku, <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />wonso didi ndefi mu nkumbu yi nzo-Nzambi, yandi didi yo mu nkumbu yi nzo-Nzambi, mpe mu nkumbu yi yondowo kwe zinganga momo, <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />wonso didi ndefi mu nkumbu yi mazulu, didi yo mu nkumbu yi kyandu ki kintinu ki Nzambi, mpe mu nkumbu yi yondowo wu wuzakala hoho.»<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />«Kyadi ku yeno milongisi mi Misiku na Bafalisi, lu bantu ba diisu ku nsye lukaya! Lukwe haananga kibuku ki kumi-kumi ki bikola bi bonso manzulu, na mwa makaya ma mfuku yimbote mpe na mwa mbutu zi mumpila-mumpila, kansi lukwe zimbakananga mu sadila misamu mi lutidi mfunu mu Misiku bonso: lunungu, nkenda na kiminu. Misamu myamyomyo lufweti sadila, ka mu zimbakana minkaka ko. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Yeno mintwadisi mifwa meso ludi! Lukwe kyenzanga malamu mu katula nzi, na lukwe minanga kibulu ki nkumbu samo.»<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />«Kyadi ku yeno milongisi mi Misiku na Bafalisi, lu bantu ba diisu ku nsye lukaya! Lukwe toma sukulanga manima ma mbungu na ndonga zeno, kansi ku kati ku fuluka mu bima bibwivi na mpwila zimbi. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Ngeye mufalisi wufwa meso wudi! Teka sukula ntete kati di mbungu, mboki manima mandi maavedila.»<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />«Kyadi ku yeno milongisi mi Misiku na Bafalisi, lu bantu ba diisu ku nsye lukaya! Lufwanakani bonso zindyamu zii bakusidi mpemba, zikwe yenikanga zimbote ku mbazi, kansi ku kati zi zifuluka mu bihisi bi zimvumbi, na bima bi mumpila-mumpila bimana bola. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Yeno mpe bumosi, lukwe yenikanga ku mbazi bonso bantu baludedomo, kansi ku kati ludi bafuluka mu diisu ku nsye lukaya, mpe mu misamu mimbi.»<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />«Kyadi ku yeno milongisi mi Misiku na Bafalisi, lu bantu ba diisu ku nsye lukaya! Lukwe tungilanga mimbikudi zindyamu zintoko, mpe lukwe tomisanga zindyamu zi bantu ba lunungu, <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />na lukwe tanga ti: “Tala ti tuzinga mu ntangu yi matata meto, nganunu tuba kintwadi nawu ko mu tengola menga ma ba mimbikudi.” <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Bwabu, lulonkidi yeno bende ti baala ba yobobo bahonda mimbikudi ludi. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Ee! Tatamaneeno mu manisa kisalu kitona matata meno. <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />Yeno zinyoka ludi, kanda di zimpidi! Bwedi lulendi tinina kitumbu ki tiya tu mbungulu e? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Ni hahoho, meno nalutambikidi mimbikudi, bantu ba ndwenga na milongisi mi Misiku. Lwaahonda na lwaakoma ha kulunsi bahiika, mpe lwaazuba bikoti bahiika dyaka mu kati di zinzo zi lusambulu zi Bayudayo, na lwaabayenisa mpasi mu mbanza ka mbanza. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Mwanki, kitumbu ki menga ma bantu ba lunungu ma matengolo ha butoto ki lubwila, tuuka menga ma Abeli, wuba muntu lunungu natee ku menga ma Zakaliya, mwana Balaki wu bahonda ha kati-kati di ziku di bakwe yokilanga minkayulu na kibuka kilongo. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Kedika nina luteela: kitumbu ki misamu bemimi mimvimba kyaabwa ku mbandu beyiyi!»<verse eid="MAT 23:36" /></para>
  <para style="s1">Yesu wudila mu dyambu di mbanza yi Yelusalemi</para>
  <para style="r">(<ref loc="LUK 13:34-35">Luk 13.34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />«Yelusalemi! Yelusalemi! Ngeye kwe hondanga mimbikudi mpe kwe hondanga mu matadi bantu bakwe ku tambikanga Nzambi! Ntangu zizingi natiidi mu kutikisa baala baku bonso nsusu bu kakwe kosilanga baala bandi ku nsye mahahi mandi, kansi lutiidi eno bo ko! <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Nkatika bwabu, nzo eno ya baabwongola. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Ni hahoho, nina luteela ti: Lwaabwesa nyena ko natee kilumbu ki lwaata ti: “Bika Nzambi kasakumuna muntu wuna kwiza mu nkumbu yi Mfumu!”»<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s1">Mwangusunu yi nzo-Nzambi</para>
  <para style="r">(<ref loc="MRK 13:1-2">Mlk 13.1-2</ref>; <ref loc="LUK 21:5-6">Luk 21.5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Yesu bu kaduuka mu nzo-Nzambi, na bu kedi kwe yenzingi, milongoki myandi miyenda ku kabela na mi mulonka bwedi batungila nzo-Nzambi. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Kansi Yesu wubateela ti: «Bimvimba bebyobyo bya luna yena e? Kedika nina luteela, kwaabwesa saala kaa tadi dimosi ha yulu tadi nandi ko, bimvimba byaamana mwangana.»<verse eid="MAT 24:2" /></para>
  <para style="s1">Mpasi na nkwamusu</para>
  <para style="r">(<ref loc="MRK 13:3-13">Mlk 13.3-13</ref>; <ref loc="LUK 21:7-19">Luk 21.7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Yesu wuba wuzakala ha mulandu wu Olive. Milongoki myandi miyenda ku kabela na bamufuula ha luhengo ti: «Tuteeleti nkye kilumbu misamu bemimi myaahilama mpe nkye kidimbu kyaalonka nyizulu aku na nsukunu yi nza e?» <verse eid="MAT 24:3" /><verse number="4" style="v" sid="MAT 24:4" />Yesu wubavutudila ti: «Kebeeno kweno! Muntu ka luhukumunandi. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Mu dyambu ti babingi baakwiza mu nkumbu ani, na baaluteela ti: “Meno nii Klisto!” Na bantu babingi baahukumuna. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Lwaayuwa bu bazonzila zimvita na manyungu-nyungu ma zimvita, luyenandi bunkuta ko, mu dyambu ti mimvimba mifweti teka hilama. Kansi yaaba mpe nsukunu yi nza ko. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Bantu ba nsi yimosi baanwanisa bantu ba nsi yihiika, bantu bantinu yimosi baanwanisa bantu bantinu yihiika. Mu bizunga bibingi malema maaba na butoto bwaazakama. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Misamu bemimi mimvimba myaaba bonso ntonono yi misongo mi mukento weka lukufi mu buta. <verse eid="MAT 24:8" /><verse number="9" style="v" sid="MAT 24:9" />Ni hahoho, bantu baaluyekola mwanki baluyenisa mpasi na baaluhonda. Bantu bamvimba baalubela mu dyambu di nkumbu ani. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Mu ntangu beyoyo, bantu babingi baabwisa kiminu kyawu, baafundasana, mpe baabelasana yawu na yawu. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Mimbikudi mi luvunu mimingi myaakwiza na myaahukumuna bantu babingi. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Mu dyambu ti misamu mimbi myaanyeeka, mpe luzolo lu bantu babingi lwaalebakana. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Kansi wonso waatatamana natee ku nsukunu, yandi waavulusu. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Musamu wumbote wu Kimfumu waasamunu mu nza yimvimba mwanki wuba kimbangi ku bantu ba nsi zimvimba. Ku manima nsukunu yi nza mbo yi tuula.<verse eid="MAT 24:14" /></para>
  <para style="s1">Mpasi zi kingitukulu</para>
  <para style="r">(<ref loc="MRK 13:14-23">Mlk 13.14-23</ref>; <ref loc="LUK 21:20-24">Luk 21.20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />Mu ntangu yi lwaayena “kimwangisi kinsisi” kizakala ha kibuka ki longo, kyo kizonzila mumbikudi Danyeli, buna bika muntu wuna tanga ka bakula, <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />ni hahoho, yobobo baaba ku Yuda bafweti tinina ku milandu, <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />yondowo waaba ku yulu muludi wu nzo ka kulumukandi mu kwiza bonga bima bi mu kati di nzo andi ko, <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />na yondowo waaba ku mfuba kalendi vutuka ku nzo andi ko mu kwiza bonga kiyunga kyandi. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Mu bilumbu bebyobyo, nkye mpila kyadi ku bakento baaba na mazimi na baanwika baala mabene! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Sambileno mwanki ntinunu eno yilembolo ba mu ntangu(nsungi) yi kyozi kingolo hoti mu kilumbu ki saba! <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Mu dyambu ti, mu ntangu beyoyo mpasi zihyokidi kitezo zaaba, mpe kutonina ku mbadukulu yi nza natee mu ntangu beyiyi, mpasi zibobo twaayeni zo ko, mpe zaabwesa ba ko. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Tala ti Nzambi kabonga nzengolo ko mu kufika bilumbu bebyobyo, kunaani muntu wuketi vuuka. Kansi wukufika byo mu dyambu di yobobo ba kasoola. <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />Tala ti muntu wulutedidi ti: “Taleeno Klisto ewu eha!” Hoti “Ehana kadi!”, lumukwikilandi ko. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Mu dyambu ti zi klisto zi luvunu na mimbikudi mi luvunu myaatelema, baahidika bidimbu na bimangu bingitukulu mu hukumuna bantu, bulendi ba mpe na yobobo ba kasoola. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Tomeno yuwa, meno nalulwengisi.<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />Tala ti baluteedidi ti: “Ku nsi yinkatu kadi!” Lwendandi. Hoti tala ti baluteedidi ti: “Eku ka swamina!”, lubakwikilandi ko. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Kadi, bonso mpedamu bu yikwe pedamanga ku yulu mu kyenzola ndambu yikwe totokilanga ntangu natee ku yikwe dyaminanga, bwabobo mpe bwaakwizila Mwana Muntu. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Honso ha mvumbi, hahoho mpe haayonzimina nuni zikwe dyanga mvumbi.<verse eid="MAT 24:28" /></para>
  <para style="s1">Nyizulu yi Mwana muntu</para>
  <para style="r">(<ref loc="MRK 13:24-27">Mlk 13.24-27</ref>; <ref loc="LUK 21:25-28">Luk 21.25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />Ku manima ma bilumbu bebyobyo kwandi, ntangu yaabwesa lezima ko, ngonda yaabwesa kyenzola ko, na zimbwetete zaasotoka tuka ku yulu, na bima bii na lulendo mu mazulu byaaningana.<verse eid="MAT 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />Ni hahoho, kidimbu ki Mwana Muntu kyaayenika ku yulu, makanda mamvimba ma ha butoto maaba mu kyadi na manyongo, baayena Mwana Muntu wuna kwiza mu matuti ma ku yulu, mu lulendo na mu nkembo wuwunene. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Bu ba sika kulumenta didinene, Mwana Muntu waatambika zimbazi zandi, mpe yawu baayonzika yobobo baakasoodidi ku ndambu za ziya zi nza, baafuma mu nsuka zimvimba zi ha butoto.<verse eid="MAT 24:31" /></para>
  <para style="s1">Kingana ki muti wu fike</para>
  <para style="r">(<ref loc="MRK 13:28-31">Mlk 13.28-31</ref>; <ref loc="LUK 21:29-33">Luk 21.29-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />Bakuleno ndongosolo eyi yi kingana ki muti wu fike: bu lukwe yenanga ti bintala byandi bivwembamani na makaya mandi matonini mu sasa, luzebi ti ntangu yi ntombo yeka lukufi. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Bumosi mpe ku yeno, bu lwaayena misamu bemyomyo mimvimba, zabeeno ti Mwana Muntu weka lukufi, na weka ha myelo mi nzo zeno. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Kedika nina luteela, mbandu beyiyi yaahyoka ko tala ti mimvimba mi lungidi ko. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Yulu na butoto byaahyoka, kansi mambu mani maahyoka ko.<verse eid="MAT 24:35" /></para>
  <para style="s1">Kilumbu kyaakwiza Mwana Muntu</para>
  <para style="r">(<ref loc="MRK 13:32-37">Mlk 13.32-37</ref>; <ref loc="LUK 17:26-30">Luk 17.26-30</ref>,<ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />Mu dyambu ditadidi kilumbu na ntangu, ka muntu ko zebi, ka zimbazi zi mazulu ko, ka Mwana ko, kansi Tata kaka zebi. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Bonso bubela mu ntangu yi Nowa, bwabobo mpe bwaabeela mu kilumbu kyaakwiza Mwana Muntu. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Mu dyambu ti, tekila nyamba yiyinene yiza, bantu badya na banwa, bakwela na bakwedisa baala bawu natee kilumbu ki kota Nowa mu nzaza, <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />na bazaba ko nki byaabatudila natee nyamba yiyinene bu yiyiza na yi kukumuna bamvimba. Bwabobo mpe bwaabeela kilumbu kyaakwiza Mwana Muntu. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Babakala bole baaba mu mfuba: wumosi baabonga, wukaka baamusisa. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Bakento bole baanika ha kimosi mbutu: wumosi baabonga, wukaka baamusisa. <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />Kebeno kweno, mu dyambu ti luzebi kilumbu kyaakwiza Mfumu eno ko. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Zabeno ti: tala ti mfumu yinzo lendi zaba mu nkye kilokola ki mpimpa mwivi kaakwiza, fweti sunga tolo na kalendi mubiika ko kakota mu nzo andi. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Ni hahoho, yeno mpe, beno bakubama mu dyambu ti Mwana Muntu waakwiza mu kilokola ki lulembolo zaba.<verse eid="MAT 24:44" /></para>
  <para style="s1">Kisadi ki kwikama na kilembolo ba kikwikama</para>
  <para style="r">(<ref loc="LUK 12:41-48">Luk 12.41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />Nani wudi mundongo wukwikama na wundwenga, mfumu kasoodidi mutwadisa bisadi byandi, na mu bahaana mu ntangu yi fwanakani bindya e? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Kyese ku mundongo bewowo, mfumu bu kaavutuka, waamubwana buna wuna sala! <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Kedika nina luteela: Mbo kamuhaana kiyeko kye twadisa mvwilu andi yimvimba. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Kansi, tala ti mundongo wumbi wudi na teedi ku nsye mutima andi ti: “Mfumu ani kana tumbu vutuka ko”, <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />mboki tonini mu tuta banandi ba kisalu nkuba, mpe na mu kwe dye na mu kwe nwe na minkolo mbungu, <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />Mfumu yi mundongo bewowo, waavutuka mu kilumbu ki kana lembolo mu kingila, na mu kilokola ki ka lembolo zaba, <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />mbo kamukuma na mbo kamuhaana kitumbu ki bantu ba diisu ku nsye lukaya, kwakoko ku bidilu na nkwetosolo yi meno.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s1">Kingana ki ndumba kumi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />Kimfumu ki Mazulu kyaafwanakana bonso ndumba kumi zi bonga minda myawu mu kwe bwana kikwedi. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Batanu ha kati dyawu baba bizengi mpe batanu bahiika baba na madyela. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Ndumba zi bizengi babonga minda myawu, kansi banata mazi ko, <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />yobobo baba na madyela, babonga minda myawu mpe banata mazi mu mwa zimbwata. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Kikwedi bu kazingila mu kwiza, ndumba zimvimba zibaka tolo, ni zilambalala. <verse eid="MAT 25:5" /><verse number="6" style="v" sid="MAT 25:6" />Mu kati-kati di mpimpa, ndinga yi yuwakana: “kikwedi yanduwu wizidi! Duukeeno mu kwe mubwana!” <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />Buna ndumba zimvimba zi vukumuka mpe zi kubika minda myawu. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Ndumba bezozo zi bizengi ziteela ku ziba na madyela ti: “Tuhaaneeno mwa ndambu yi mazi meno, mu dyambu ti minda myeto mitonini mu zima!” <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />Kansi ndumba zimadyela zibateela ti: “Kaani, ma tulungila ko mu yeno na yeto. Bufweni lwenda lusumba ku yobobo bakwe tekisanga mo.” <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />Mu ntangu yi bayenda mu kwe me sumba, kikwedi kisala hingani. Ndumba za zitanu ziba zikubama zikota nandi mu kati di nzo yi mukembo wu makwela, na bakanga mwelo. <verse eid="MAT 25:10" /><verse number="11" style="v" sid="MAT 25:11" />Ku manima, ndumba zihiika zitula na babulana ti: “Mfumu, Mfumu, tuzibudila!” <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />Kansi kikwedi kibavutudila ti: “Kedika nina luteela, naluzebi ko.” <verse eid="MAT 25:12" /><verse number="13" style="v" sid="MAT 25:13" />Yesu wuta ti: Buna kayeno meso, mu dyambu ti luzebi kilumbu na kilokola ko.<verse eid="MAT 25:13" /></para>
  <para style="s1">Kingana ki bisadi bitatu</para>
  <para style="r">(<ref loc="LUK 19:11-27">Luk 19.11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />Kimfumu ki mazulu kifwanakani bonso muntu wumosi, wukubama mu kwenda ku nzyetolo, na wutumisa mindongo myandi mu basisila mvwilu andi. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Wuhaana ku wuntete talanta<note caller="+" style="f"><char style="fr" closed="false">25.15 </char><char style="ft" closed="false">Talanta: yifwanakani na mufutu wu mvula kumi yi kisadi kimosi</char></note> zitanu, zole ku wuhiika, mpe yimosi ku wu mitatu, bonso bubela ngolo zi muntu-muntu, mboki wuyenda ku nzyetolo. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Yondowo wu baka talanta zitanu wuyenda butisa zo na wubaka ndandu yi talanta zitanu zihiika. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Bumosi mpe ku yondowo wu baka talanta zole, wubaka ndandu yi talanta zole zihiika. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Kansi ku yondowo wu baka talanta yimosi, wuyenda timuna bulu ha butoto na wusweka talanta yi mfumu andi.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />Bilumbu bibingi bihyoka, kumanima, mfumu yi mindongo wuvutuka, na wubafuula mu zaba bwedi basadidi mbongo bezozo. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Yondowo wu baka talanta zitanu, wumutwadila talanta zitanu zihiika na wumuteela ti: “Mfumu, talanta zitanu wusala nsisila, zibutidi ndandu yi talanta zitanu zihiika.” <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />Mfumu andi wumuteela ti: “Bumbote siidi! Mundongo wumbote wudi na wukwikama! Mu dyambu ti bedi wukwikama mu bima bifyoti, bwabu nina kuhaana bivudidi. Yiza wuyangalala kintwadi na mfumu aku.” <verse eid="MAT 25:21" /><verse number="22" style="v" sid="MAT 25:22" />Yondowo wu baka talanta zole, wuyiza na wumuteela ti: “Mfumu, talanta zole wusala nsisila, tala, zibutidi ndandu yi talanta zole zihiika.” <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />Mfumu andi wumuteela ti: “Bumbote siidi! Mundongo wumbote wudi na wukwikama! Mu dyambu ti bedi wukwikama mu bima bifyoti, bwabu nina kuhaana bivudidi. Yiza wuyangalala kintwadi na mfumu aku.” <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />Mboki yondowo wu baka talanta yimosi, wuyiza na wumuteela ti: “Mfumu, meno nzebi ti ngeye muntu wumbalu wudi: ngeye kwe yonzikanga ho ha wulembolo kuna, mpe kwe totanga ho ha wulembolo mwanga. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Bunkuta nayeni, ni nayenzi sweka talanta aku ku nsye butoto. Buna, bonga byaku bi wuvwidi.” <verse eid="MAT 25:25" /><verse number="26" style="v" sid="MAT 25:26" />Mfumu andi wumuteela ti: “Mundongo wumbi na wukilenga, ngeye zebi ti nakwe yonzikanga bima ho ha na lembolo kuna, mpe nakwe totanga ho ha na lembolo mwanga. <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Bila nki wulembolo tudila mbongo zani mu nzo yi kiswekolo ki mbongo, nganunu bu mvutukidi za naketi bakila ndandu bu naketi bonga zo. <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />Muzikeeno talanta beyoyo yi nandi, mpe haneeno yo ku yondowo wuna talanta kumi. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Ni hahoho, mbo bahaana ku yondowo teekidi na bima, na wuna ba na byo bibingi, kansi yondowo lembolo ba na kima, mbo ba muzika mpe kyo kiteekidi nandi. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Nganunu mundongo wumpamba bewuwu, mutubeno ku mbazi ku mpimpita yina bokoboko. Kwakoko kwaaba bidilu na nkwetosolo yi meno.”<verse eid="MAT 25:30" /></para>
  <para style="s1">Mfundusu yi mansukina</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />Mu ntangu yaakwiza Mwana Muntu mu nkembo andi, ha kimosi na zimbazi zimvimba, waazakala ha kyandu ki kintinu kyandi kinkembo. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Makanda mamvimba ma bantu ma ha butoto maayonzama ha ntadisi andi, na waahambisa mu ndambu zole bonso mimvungi bu mikwe hambisilanga mameme na zinkombo, <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />waatuula mameme ku kooko kwandi ku lubakala, na zinkombo ku kooko kwandi ku lumoso. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />Buna ntinu waata ku yobobo baaba ku kooko kwandi ku lubakala ti: “Yizeno, yeno basakumunu ku Tata ani, mpe tambuleeno Kimfumu ki kalukubikila tuka mbadukulu yi nza. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Mu dyambu ti nabedi na nsatu, yeno lumpeeni bindya, nabedi na mpwila yi mamba, yeno lumpeeni mamba me nwa, nabedi nzenza, yeno lumbweni, <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />nabedi mpene, yeno lundwikidi, nabedi wubeela, yeno lunsadisi, nabedi mu boloko, yeno luyizidi mu ntala.” <verse eid="MAT 25:36" /><verse number="37" style="v" sid="MAT 25:37" />Bantu balunungu baamuvutudila ti: “Mfumu, nkye ntangu tukuyeni bu wubedi na nsatu, mboki tukuheeni bindya e? Hoti wubedi na mpwila yi mamba, mboki tukuheeni mamba me nwa e? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Nkye ntangu tukuyeni nzenza, mboki tukubweni e? Hoti wubedi mpene, mboki tukulwikidi e? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Nkye ntangu tukuyeni wubeela, hoti mu boloko, mboki tuyizidi mu kutala e?” <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />Ntinu waabavutudila ti: “Kedika nina luteela, bu luhidikidi bo ku wumosi mu mwa baala bebaba bafyoti, hoti ku wumosi mu zimpangi zani, ku meno luhidikidi bo.”<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />Mboki waata ku yobobo baaba ku kooko kwandi ku lumoso ti: “Lunkatukila, yeno bantu basingu! Yendeeno ku tiya tu mbungulu tu mimvu ka mimvu tubakubikila nkadyampemba na zimbazi zandi. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Mu dyambu ti, nabedi na nsatu, kansi lumpeeni bindya ko, nabedi na mpwila yi mamba, kansi lumpeeni mamba me nwa ko, <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />nabedi nzenza, kansi lumbweni ko, nabedi mpene, kansi lundwikidi ko, nabedi wubeela, na mu boloko, kansi luyizi ntala ko.” <verse eid="MAT 25:43" /><verse number="44" style="v" sid="MAT 25:44" />Buna baamuvutudila ti: “Nkye ntangu tukuyena wuba na nsatu, hoti na mpwila yi mamba, wuba nzenza hoti mpene, wuba wubeela hoti mu boloko, na tulembolo ku sadisa e?” <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />Ntinu waabavutudila ti: “Kedika nina luteela, tala ti luhidikidi bo ko ku wumosi mu mwa baala bebaba bafyoti, kuu meno lulembolo bwe hidika.” <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />Mpe yababa, baatambula kitumbu ki mimvu ka mimvu, kansi bantu balunungu, baatambula luzingu lu mimvu ka mimvu.»<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s1">Bakotila Yesu manenga</para>
  <para style="r">(<ref loc="MRK 14:1-2">Mlk 14.1-2</ref>; <ref loc="LUK 22:1-2">Luk 22.1-2</ref>; <ref loc="JHN 11:45-53">Yoa 11.45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Yesu bu kamanisa mu zonza misamu bemyomyo mimvimba, wuteela milongoki myandi ti: <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />«Luzebi ti bilumbu byole kwandi bisidi mu kembila mukembo wu Pake, na Mwana Muntu waayekolo mwanki baamukoma ha kulunsi.»<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Ni hahoho, zimfumu zinganga-Nzambi na mbuta zi bantu zi Bayudayo bakutakana ku nzo yi Kayifa, nkuluntu yi zinganga-Nzambi, <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />babonga nzengolo mu kangusu Yesu mu madyela, mwanki ba muhonda. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Kansi bata ti: «Tumukangandi ha kati di mukembo ko, mwanki mukangu wulembolo nangumuka.»<verse eid="MAT 26:5" /></para>
  <para style="s1">Mukento wubulumuna Yesu mananasi ha yulu mutu</para>
  <para style="r">(<ref loc="MRK 14:3-9">Mlk 14.3-9</ref>; <ref loc="JHN 12:1-8">Yoa 12.1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Yesu bu kaba ku Betani, ku nzo yi Simoni, yondowo wubela kimbevo ki bwazi, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />mu ntangu Yesu yi kaba ha meza, mukento wumosi wuyenda ha ntadisi andi, wuba na mbwata yi alabati yifuluka mu mananasi mantalu, na wumubulumuna mo ha yulu mutu. <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />Milongoki myandi bu bayena bobo, bafwema na bata ti: «Bila nki mu fukisa mo e? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Nganunu kuteka batekidi mo mu ntalu yiyingi, mboki baheeni mbongo ku bamputu!»<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Yesu wubakula mayindu mawu, wubateela ti: «Bila nki luna kwamisina mukento bewuwu e? Musamu wu kampidikidi nkatika wumbote wudi. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Mu dyambu ti bamputu baaba neeno ntangu zimvimba, kansi meno naaba neeno ntangu zimvimba ko. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Mukento bewuwu bulumuni mananasi mu nitu ani, mu nkubikila nzikulu ani. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Kedika nina luteela, mu nza yimvimba, konso ku baasamuna musamu wumbote bewuwu, mbo bazonzila mpe musamu wumpidikidi mukento bewuwu mu mubambukila moyo.»<verse eid="MAT 26:13" /></para>
  <para style="s1">Yuda wusosa mu yekola Yesu</para>
  <para style="r">(<ref loc="MRK 14:10-11">Mlk 14.10-11</ref>; <ref loc="LUK 22:3-6">Luk 22.3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Ku manima, wumosi ha kati di milongoki kumi na myole, yondowo wuba kwe tumisinanga ti Yuda Isikalyoti, wuyenda ku bakuluntu ba zinganga-Nzambi <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />na wubateela ti: «Nki lwaampana tala ti naaluyekodidi Yesu e?» Buna bamuhaana makumatatu ma mbongo zi bisengo. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Kutona kilokola bekyokyo kwandi, wusosa bwedi kalendi bayekodila Yesu.<verse eid="MAT 26:16" /></para>
  <para style="s1">Milongoki mi kubika bindya bi Pake</para>
  <para style="r">(<ref loc="MRK 14:12-21">Mlk 14.12-21</ref>; <ref loc="LUK 22:7-13">Luk 22.7-13</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Yoa 13.21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Kilumbu kintete ki mukembo wu mampa ma kiputi kilembolo vimba, milongoki miyiza fuula Yesu ti: «Kwedi tiidi tukukubikila bindya bi Pake e?» <verse eid="MAT 26:17" /><verse number="18" style="v" sid="MAT 26:18" />Wuvutula ti: «Yendeeno ku mbanza, ku nzo kingandi. Muteeleeno ti: “Mulongisi ebu kateedi: Kilokola kyani kyeka lukufi, ku nzo aku naakembidila Pake na milongoki myani.”» <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Milongoki mihidika mimvimba mi bateela Yesu, ni bakubika Pake.<verse eid="MAT 26:19" /></para>
  <para style="s">Yesu wudya Pake na milongoki myandi</para>
  <para style="r">(<ref loc="MRK 14:17-26">Mlk 14.17-26</ref>; <ref loc="LUK 22:14-23">Luk 22.14-23</ref>; <ref loc="JHN 13:21-30">Yoa 13.21-30</ref>; <ref loc="1CO 11:23-25">1 Ko 11.23-25</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Mpimpa buyitula, Yesu wuba na milongoki kumi na myole ha meza. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Bu bedi dyanga, wubateela ti: «Kedika nina luteela, wumosi ha kati dyeno waanyekola.» <verse eid="MAT 26:21" /><verse number="22" style="v" sid="MAT 26:22" />Milongoki miyena kyadi kikingi, na wumosi-wumosi wutona mu mufuula ti: «Mfumu, kadi ni meno e?» <verse eid="MAT 26:22" /><verse number="23" style="v" sid="MAT 26:23" />Wuvutula ti: «Yondowo waatuula nani kooko mu ndonga, yandi waanyekola. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Mwana Muntu waafwa, bonso budi busonama mu yandi. Kansi nkya mpila kyadi ku muntu bewowo waamuyekola. Buba bumbote ku muntu bewowo mulembolo butuka.» <verse eid="MAT 26:24" /><verse number="25" style="v" sid="MAT 26:25" />Yuda, yondowo wedi mu yekola, wufuula ti: «Mulongisi, kadi ni meno e?» Yesu wumuvutudila ti: «Ngebende teedi wo.»<verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Mu ntangu yi bedi dya, Yesu wubonga dimpa, bu kamana vutula matondo, wubukuna dyo na wuhaana dyo ku milongoki myandi, wuta ti: «Bongeno na dyeno, yi ni nitu ani.» <verse eid="MAT 26:26" /><verse number="27" style="v" sid="MAT 26:27" />Mboki wubonga mbungu, bu kamana vutula matondo, wubahaana yo, wuta ti: «Nweno yo yeno bamvimba, <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />ma ni menga mani, menga ma luwawanu lumona, matengolo mu bantu babingi, mu dyambu di ndemvokolo yi masumu. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Wukedika nina luteela, naabwesa nwa dyaka vinu ko, natee kilumbu ki naanwa vinu dinsonso mu Kimfumu ki Tata ani.» <verse eid="MAT 26:29" /><verse number="30" style="v" sid="MAT 26:30" />Bu bamana yimbila mikunga, baduuka mu kwenda ku ndambusu yi mulandu wu Olive.<verse eid="MAT 26:30" /></para>
  <para style="s1">Yesu wuzabikisa ti Petelo waamubisa</para>
  <para style="r">(<ref loc="MRK 14:27-31">Mlk 14.27-31</ref>; <ref loc="LUK 22:31-34">Luk 22.31-34</ref>; <ref loc="JHN 13:36-38">Yoa 13.36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Buna Yesu wubateela ti: «Mu mpimpa beyiyi kwandi, yeno bamvimba lwaabwa, mu dyambu ti wusonama: “Naahonda mumvungi wu mameme, mpe kamba dimvimba di mameme dyaamwangana.”<verse eid="MAT 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 26:32" />Kansi bu naafuluka mu bafwa, naalutekidila ku kizunga ki Ngalili.» <verse eid="MAT 26:32" /><verse number="33" style="v" sid="MAT 26:33" />Petelo wumuteela ti: «Kati bamvimba bakusisidi, meno kilendi saala kusisa ko!» <verse eid="MAT 26:33" /><verse number="34" style="v" sid="MAT 26:34" />Yesu wumuteela ti: «Kedika nina kuteela: Mu mpimpa yi bubedidi kwandi, nsusu ya kikubila ko, ngeye waambisa nkumbu tatu.» <verse eid="MAT 26:34" /><verse number="35" style="v" sid="MAT 26:35" />Petelo wumuteela ti: «Kati kufwa, naafwa naku, meno ndendi saala kubisa ko!» Mpe bamvimba bata bobo.<verse eid="MAT 26:35" /></para>
  <para style="s1">Yesu wusambila ku Ngetesemane</para>
  <para style="r">(<ref loc="MRK 14:32-42">Mlk 14.32-42</ref>; <ref loc="LUK 22:39-46">Luk 22.39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Ku manima, Yesu wutula na milongoki myandi ha kibuka ki bakwe tumisinanga ti Ngetesemane, na wubateela ti: «Zakaleeno ehaha, meno bu nina kwenda ehane mu kwe sambila.» <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Mboki wubonga Petelo na baala ya babole ba Zebedayi. Wutona muyena kyadi na kingongo. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Buna wubateela ti: «Nkatika kyadi kikingi nina yena mu mutima ani mu dyambu di lufwa, saleno ehaha na kayeno meso nani.» <verse eid="MAT 26:38" /><verse number="39" style="v" sid="MAT 26:39" />Mboki wuyenda mwa kitatu, mpe wufukama na wutula luse lwandi ha nsi mu sambila, na wuta ti: «Tata ani, tala ti bulendi ba, ntatudila mbungu beyiyi. Kansi, ka bonso bu natidi ko, kadi sa bonso buu luzolo lwaku.» <verse eid="MAT 26:39" /><verse number="40" style="v" sid="MAT 26:40" />Bu kavutuka ku kasisa milongoki myandi, wuyenda babwana ku nsye tolo, na wuteela Petelo ti: «Lulembakani mu kaya meso ka mwa kilokola kimosi nani e? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Kayeeno meso na sambileeno mwanki lu lembolo bwa mu ntontolo. Mpeve yii na kinzodila, kansi nitu yii na lebakani.»<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Wuyenda dyaka mwa kitatu nkumbu yinzole na wusambila ebu: «Tata ani, tala ti bulendi ba, ntatudila mbungu beyiyi mwanki na lembolo ye nwa, bika ti luzolo lwaku luhilama!» <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />Mboki wuvutuka dyaka kubela milongoki myandi, na wuyenda babwana ku nsye tolo, meso mawu maba nkatika kizitu beni mu tolo. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Yesu wusala basisa dyaka, wuyenda mwa kitatu mu sambila mu nkumbu yi tatu, wubwesa ta dyaka misamu bemyomyo kwandi. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />Mboki wuvutuka kubela milongoki myandi, na wubateela ti: «Lutatamani kweno mu bwa tolo na luna huma kweno e? Bwabu kilokola kifweni, Mwana Muntu wabayekodi bwabu mu moko ma minsumuki. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Telameeno, twendeeno, yondowo wuna nyekola tudidi!»<verse eid="MAT 26:46" /></para>
  <para style="s1">Bakengi Yesu</para>
  <para style="r">(<ref loc="MRK 14:43-50">Mlk 14.43-50</ref>; <ref loc="LUK 22:47-53">Luk 22.47-53</ref>; <ref loc="JHN 18:3-12">Yoa 18.3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Kakimanisina mu zonza ko, Yuda, wumosi mu milongoki kumi na myole wutula na mpumbu yi bantu yi ba na mbele zi zimvita, mpe na bibono. Babatambika ku zimfumu zinganga-nzambi na zinkuluntu zi Bayudayo. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Yuda, yondowo wedi yekola Yesu, wubahaana kidimbu eki: «Yondowo wu naafiba, ni yandowo, mukangeeno.» <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />Buna wuyenda ha ntadisi yi Yesu na wumuteela ti: «Mbote Mulongisi!» Na wumufiba. <verse eid="MAT 26:49" /><verse number="50" style="v" sid="MAT 26:50" />Yesu wumuteela ti: «Nkayi ani, musamu wu wizi hidika, hidika wo.» Buna bafinama, basimba Yesu, ni bamukanga. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Wumosi mu yobobo baba na Yesu kintwadi wuduukisa mbele yi mvita, na wukata mundongo wu mfumu yi nganga-Nzambi, na wumuzenga kutu. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />Yesu ni kamuteela ti: «Vutula mbele yi mvita mu lukutu lwandi, mu dyambu ti bantu bamvimba bakwe nwaninanga mu mbele yi mvita mu mbele yi mvita mpe baafwila. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Wuzebi ko ti ndendi bombidila Tata ani ka nsadisa, mpe waantambikila, hansi na nsi, zimbazi zizingi kuhyoka lutangu lu mpumbu kumi na zole e? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Bwedi mambu masonama maakwendila detila, mo mana ta ti: bufweni bubela bobo e?»<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Mboki, Yesu wuteela mpumbu yi bantu ti: «Kadi kimpumbulu nidi, mwanki lwiza lunkanga na mbele zimvita na bibono e? Bilumbu bimvimba nabedi neeno mu nzo-Nzambi mu lulonga, na lusosidi mu mbwila ko.» <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Kansi mimvimba bemimi mina hilama, mwanki misamuna mimbikudi myenda detila. Buna milongoki mimvimba misala musisa na miwoka.<verse eid="MAT 26:56" /></para>
  <para style="s1">Yesu ha ntadisi yi bakuluntu ba Bayudayo</para>
  <para style="r">(<ref loc="MRK 14:53-65">Mlk 14.53-65</ref>; <ref loc="LUK 22:54-55">Luk 22.54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Yoa 18.13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Bantu bebobo ba kanga Yesu, bamunata ku nzo yi mfumu yi zinganga-Nzambi, Kayifa, kumana kutakana milongisi mi Misiku na zimbuta zi Bayudayo. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Petelo wedi kwe mulandi mwa kitatu natee ku nzo yi mfumu yi zinganga-Nzambi. Wukota ku lupangu na wuzakala na minkebi, mu tala bwedi musamu bewowo waamanisina.<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />Zimfumu zinganga-Nzambi na kimvuka ki bakuluntu ba Bayudayo basosa kimbangi ki luvunu mu Yesu, mwanki bamuzengila lufwa, <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />kansi bamubakila kyo ko, mpeleko bantu babingi bayiza ta bimbangi bi luvunu. Ku manima, bantu bole bayiza <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />na bata ti: «Muntu bewuwu wuta ti: “Ndendi bula nzo-Nzambi, na kutunga yo dyaka mu bilumbu bitatu.”» <verse eid="MAT 26:61" /><verse number="62" style="v" sid="MAT 26:62" />Mfumu yi zinganga-Nzambi wutelama na wuta ku Yesu ti: «Wuna vutula mvutu ko e? Nkye mvutu wuna vutula mu kimbangi ki kibena ta mu dyambu dyaku e?» <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Kansi Yesu wuba na swii. Mfumu yi zinganga-Nzambi wumuteela ti: «Mu nkumbu yi Nzambi yi moyo, nina kulomba wututeela ti ngeye ni Klisto, Mwana Nzambi!» <verse eid="MAT 26:63" /><verse number="64" style="v" sid="MAT 26:64" />Yesu wumuvutudila ti: «Ngeye wuna ta wo. Kansi nina luteela ti: tuka ntangu beyiyi, lwaayena Mwana Muntu wuzakadi ku kooko ku lubakala lu Nzambi yi lulendo na wuna kwiza mu matuti maa ku yulu.» <verse eid="MAT 26:64" /><verse number="65" style="v" sid="MAT 26:65" />Mboki mfumu yi zinganga-Nzambi wutumbu kakuna binkutu byandi na wuta ti: «Nzambi kasafudi! Tusidi dyaka na nsatu yi zimbangi ko! Yeto bende tuyudi bwedi kasafudidi Nzambi. <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Bwedi luna banzila e?» Bavutula ti: «Kufwa kafweti fwa.» <verse eid="MAT 26:66" /><verse number="67" style="v" sid="MAT 26:67" />Mboki bedi mulobodila mante ku luse na bedi muzuba bikoti, bahiika bedi mukaata zimbata <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />bedi muteela ti: «Klisto! Tubikudila, tuteela nani wukuzubidi!»<verse eid="MAT 26:68" /></para>
  <para style="s1">Petelo wubisa Yesu</para>
  <para style="r">(<ref loc="MRK 14:66-72">Mlk 14.66-72</ref>; <ref loc="LUK 22:56-62">Luk 22.56-62</ref>; <ref loc="JHN 18:15-18">Yoa 18.15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Petelo wuzakala ku kati di lupangu ha mbazi. Kisadi kimosi ki mukento kiyenda ha kabela na wumuteela ti: «Ngeye mpe, na Yesu, mwisi-Ngalili lubedi.» <verse eid="MAT 26:69" /><verse number="70" style="v" sid="MAT 26:70" />Kansi wubisa ha meso ma bantu bamvimba, na wuta ti: «Nazebi ko bwedi wuna saka ta.» <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />Mboki wuyenda ku ndambu yi mwelo wu lupangu. Kisadi kihiika ki mukento ki muyena na wuta ku yobobo baba hoho ti: «Muntu bewuwu na Yesu mwisi-Nazaleti babedi.» <verse eid="MAT 26:71" /><verse number="72" style="v" sid="MAT 26:72" />Na Petelo wubisa kwandi dyaka na wudya ndefi na wuta ti: «Bakala bedyodyo namuzebi ko!»<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Mwa ntangu fyoti kwa yihyoka, yobobo ba baba hoho bafinama ha kabela, na bateela Petelo ti: «Ngeye mpe, wumosi ha kati dyawu wudi: nzonzolo aku yina lonka kwedi fumini.» <verse eid="MAT 26:73" /><verse number="74" style="v" sid="MAT 26:74" />Buna Petelo wudya ndefi ti: «Bika Nzambi kansemba, tala ti kuhuna nina sa! Meno nzebi muntu bewowo ko!» Mu kilokola bekyokyo kwandi, nsusu yikuba, <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />na Petelo wubambuka moyo musamu wumuteela Yesu ti: «Teekila nsusu yikuba, ngeye waambisa nkumbu zitatu.» Wutotoka ku mbazi na wutoma dila mu kyadi kikingi.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s1">Banata Yesu ku Pilatu</para>
  <para style="r">(<ref loc="MRK 15:1">Mlk 15.1</ref>; <ref loc="LUK 23:1-2">Luk 23.1-2</ref>; <ref loc="JHN 18:28-32">Yoa 18.28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Bwisi bu bukya, zimfumu zinganga-Nzambi zimvimba na mbuta zi bantu zi Bayudayo, bakutakana mu bonga nzengolo ye hondisa Yesu. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Bu bamubindika misinga, bamunata mpe bamuyekola ku Pilatu, munyadi wu bisi-Loma.<verse eid="MAT 27:2" /></para>
  <para style="s1">Lufwa lu Yuda</para>
  <para style="r">(<ref loc="ACT 1:18-19">Mav 1.18-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Yuda yondowo wuyekola Yesu, bu kayena ti Yesu bamuzengila lufwa, wuyena mutima mpasi, na wuyenda vutula makumatatu ma mbongo zi bisengo ku zimfumu zinganga-Nzambi na mbuta zi bantu zi Bayudayo. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />Wubateela ti: «Masumu nasidi bu nayekodi ku lufwa muntu wulembolo hidika musamu!» Kansi bamuvutudila ti: «Mitutedi ko! Dyambu dyaku!» <verse eid="MAT 27:4" /><verse number="5" style="v" sid="MAT 27:5" />Yuda wulosa mbongo zi bisengo bezozo mu kati di nzo-Nzambi, mboki wuyenda kiledika. <verse eid="MAT 27:5" /><verse number="6" style="v" sid="MAT 27:6" />Zimfumu zinganga-Nzambi batota mbongo bezozo na bata ti: «Bu bumbote ko mu vutula zo mu kiswekolo ki mvwilu yi nzo-Nzambi, mu dyambu ti mufutu wu menga ma muntu.» <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Bu bamana yuwasana, basumba mu mbongo bezozo mfuba yi muntu wukwe hidikanga masanga mu zikanga banzenza. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Ni hahoho, natee mu kilumbu kibubedidi, mfuba beyoyo ya bakwe tumisinanga «mfuba yi menga.» <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Bwabobo misamu mi ta mumbikudi Yelemiya miyendila detila: «Babonga makumatatu ma mbongo zi bisengo, ntalu yi zenga bisi-Isaeli mu dyambu dyandi, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />na bahaana zo mu sumba mfuba yi muntu wukwe hidikanga masanga, bonso Mfumu bu kantumina wo.»<verse eid="MAT 27:10" /></para>
  <para style="s1">Pilatu wufundisa Yesu</para>
  <para style="r">(<ref loc="MRK 15:2-5">Mlk 15.2-5</ref>; <ref loc="LUK 23:3-5">Luk 23.3-5</ref>; <ref loc="JHN 18:33-38">Yoa 18.33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Bu banata Yesu ha ntadisi yi Pilatu munyadi, munyadi wufundisa Yesu. Wumufuula ti: «Ngeye ni ntinu yi Bayudayo e?» Yesu wumuvutudila ti: «Ngeye wuna ta wo.» <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />Kansi, mu ntangu zimfumu zinganga-Nzambi na mbuta zi bantu zi Bayudayo bu bedi mufunda, kavutula dyambu ko. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Buna Pilatu wumuteela ti: «Wuna yuwa misamu mimvimba mi bana kufundila ko e?» <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />Kansi Yesu kavutula dyambu ko, mpe munyadi wutoma yituku.<verse eid="MAT 27:14" /></para>
  <para style="s1">Bazengila Yesu lufwa</para>
  <para style="r">(<ref loc="MRK 15:6-15">Mlk 15.6-15</ref>; <ref loc="LUK 23:13-25">Luk 23.13-25</ref>; <ref loc="JHN 18:39-19:16">Yoa 18.39–19.16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Kadi mukembo wu Pake, munyadi wuba na kifu kye yambulanga nkole yimosi, yondowo waasoola mukangu. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Kuba mu ntangu beyoyo na nkole yimosi yi ba na nsangu, nkumbu andi [Yesu] Balabase. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Buna Pilatu wufuula kamba di bantu di ba dikutakana ti: «Nani lutidi na luyambudila, [Yesu] Balabase, hoti Yesu wu bakwe tumisinanga ti Klisto e?» <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Pilatu wuzaba ti mu dyambu di musoki bamuyekodila.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Pilatu bu kaba wuzakala ha kyandu ki bakwe fundisilanga, mukento andi wumutambikila ntumi eyi: «Kukotandi kwaku mu musamu wu muntu bewuwu wulembolo zaba dyambu, mu dyambu ti mpimpa beyiyi ntomini kwamusu mu ndozi mu dyambu dyandi.»<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Zimfumu zinganga-Nzambi na mbuta zi bantu zi Bayudayo bateela ku kamba di bantu mu lomba ba bayambudila Balabase, na bahonda Yesu. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />Munyadi wubafuula dyaka ti: «Nani mu ya babole lutidi na luyambudila e?» Bavutula ti: «Balabase!» <verse eid="MAT 27:21" /><verse number="22" style="v" sid="MAT 27:22" />Pilatu wubafuula ti: «Nki naasa ku Yesu wu bakwe tumisinanga ti Klisto e?» Bamvimba bavutula ti: «Bamukoma ha kulunsi!» <verse eid="MAT 27:22" /><verse number="23" style="v" sid="MAT 27:23" />Wubateela dyaka ti: «Nkye musamu wumbi kasiidi e?» Kansi batatamana mu lookana mu ngolo ti: «Bamukoma ha kulunsi!» <verse eid="MAT 27:23" /><verse number="24" style="v" sid="MAT 27:24" />Pilatu bu kayena ti kalendi hidika dyaka musamu ko, mpe bedi nangumuka bubwingi, wubonga mamba na wusukula moko ha ntadisi yi kamba di bantu, na wubateela ti: «Meno nazebi dyambu mu mfwilu yi muntu bewuwu ko! Wo mutete dyambu eno wudi!» <verse eid="MAT 27:24" /><verse number="25" style="v" sid="MAT 27:25" />Kamba dimvimba divutula ti: «Bika menga mandi mabwa ha yulu mutu eto na wu baala beto!» <verse eid="MAT 27:25" /><verse number="26" style="v" sid="MAT 27:26" />Buna Pilatu wubayambudila Balabase. Wuzubusu Yesu bikoti, mpe wumuyekola mwanki baamukoma ha kulunsi.<verse eid="MAT 27:26" /></para>
  <para style="s1">Mbulu-mbulu zi vweza Yesu</para>
  <para style="r">(<ref loc="MRK 15:16-20">Mlk 15.16-20</ref>; <ref loc="JHN 19:2-3">Yoa 19.2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Mbulu-mbulu zi Pilatu zinata Yesu mu kati di nzo yi kisalu yi munyadi, kabu dimvimba di zimbulu-mbulu dikutakana, mpe dimuzungidila. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Bamuvula binkutu byandi, na bamulwika kiyunga kimbwaki. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Bamusyetila mpu yi nsende yi kintinu, na bamutuula yo ha yulu mutu, mpe bamusimbisa dyadya ku kooko ku lubakala. Mboki bafukama ha ntadisi andi mu muvweza, na bata ti: «Mbote aku, ntinu yi Bayudayo!» <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Bedi mulobodila mante, na babonga dyadya ni bedi muzubanga dyo ku mutu. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Bu bamana muvweza, bamukatula kiyunga kimbwaki, na bamuvutudila binkutu byandi, mpe bamunata mu kwe mukoma ha kulunsi.<verse eid="MAT 27:31" /></para>
  <para style="s1">Bakoma Yesu ha kulunsi</para>
  <para style="r">(<ref loc="MRK 15:21-32">Mlk 15.21-32</ref>; <ref loc="LUK 23:26-43">Luk 23.26-43</ref>; <ref loc="JHN 19:17-27">Yoa 19.17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Bu bedi duuka mu mbanza, babwana Simoni, muntu wu mbanza yi Sileni, bamukwika mu nata kulunsi di Yesu. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Bu batula ha kifulu ki nkumbu Ngolongota, mbangudulu ti: «Kikonzongolo ki mutu.» <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Bamuhaana kanwa vinu di bavwatisa na bima bindudi, kansi bu kabimba dyo, katya dyaka munwa dyo ko.<verse eid="MAT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35" />Bu bamana mukoma ha kulunsi, bata hwadi mu kabana binkutu byandi. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Mboki bazakala mu mukenga. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Ha yulu kulunsi dyandi, basonika kibila ki bana mu komina: «Yundu bewuwu ni Yesu, ntinu yi Bayudayo.» <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Bimpumbulu byole bakoma nandi, wumosi ku lubakala na wuhiika ku lumoso.<verse eid="MAT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39" />Mimpyoka nzila myedi hyokilanga hoho myedi sa tukanga Yesu, na kuningisa mitu, <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />myedi tanga ti: «Ngeye wu keti bula nzo-Nzambi, na wu keti ye tunga mu bilumbu bitatu. Bwabu wukivuukisa ngebende! Tala ti ngeye Mwana Nzambi wudi, kulumuka ha kulunsi!» <verse eid="MAT 27:40" /><verse number="41" style="v" sid="MAT 27:41" />Zimfumu zinganga-Nzambi, milongisi mi Misiku, na zimbuta zi bantu zi Bayudayo, bamuvweza mpe bata ti: <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />«Wuvuukisa bahiika, kansi kalendi kivuukisa yandi bende ko! Yandi ni ntinu yi Isaeli, bika ka kulumuka bwabu ha kulunsi, na tuna mulekila kiminu. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Wutuula kivuvu kyandi mu Nzambi, na wuta ti: “Meno ni Mwana Nzambi.” Tala ti Nzambi wumutidi, bika kamukuula bwabu!» <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Bimpumbulu bi bakoma nandi ha kulunsi, byedi mutukanga mpe.<verse eid="MAT 27:44" /></para>
  <para style="s1">Lufwa lu Yesu</para>
  <para style="r">(<ref loc="MRK 15:33-41">Mlk 15.33-41</ref>; <ref loc="LUK 23:44-49">Luk 23.44-49</ref>; <ref loc="JHN 19:28-30">Yoa 19.28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Mu ntangu ambata, tombe kiyiza bwa mu nsi yimvimba natee mu kilokola kitatu. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Ngunga yi tatu yi nkokila bu yedi fwana, Yesu wulooka mu ngolo ti: «Eli, Eli, lema sabakatani e?» Mpila mosi ti: «Nzambi ani, Nzambi ani, bila nki wunsisidi e?»<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />Mwa ndambu yi bantu baba hoho bamuyuwa na bata ti: «Eliya kana tumisa!»<verse eid="MAT 27:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 27:48" />Buna wumosi ha kati dyawu, wunooka mu kwe bonga mwa musakasaka wu kavwanga mu vinu dinsa. Wusoka wo mu nsongi yi dyadya, mboki wuhaana kanwa dyo. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Kansi bahiika bata ti: «Kingileeno tutala, tala ti Eliya waakwiza muvuukisa!»<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />Yesu wulooka dyaka mu ngolo, na wufwa. <verse eid="MAT 27:50" /><verse number="51" style="v" sid="MAT 27:51" />Mu ntangu beyoyo kwandi, mulele wu bamanika ha nkotolo yi kihinga kilongo wukakuka ha kati-kati kutonina ku yulu natee ku banda. Butoto bunikuka, na matadi mabudika, <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Ndyamu zi zibuka na bantu balongo babingi bamana fwa bafuluka. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Batotoka mu zindyamu kumanima ma mfulukulu yi Yesu, bakota mu Yelusalemi, mbanza yilongo, na bayenika ku bantu babingi. <verse eid="MAT 27:53" /><verse number="54" style="v" sid="MAT 27:54" />Mfumu yi zimbulu-mbulu nkama, na zimbulu-mbulu ziba nandi mu kenga Yesu, bu bayena butoto bu bunikuka na misamu mimvimba mihyoka, bayena bunkuta bubwingi, na bata ti: «Kedika, muntu bewuwu Mwana Nzambi wubedi!» <verse eid="MAT 27:54" /><verse number="55" style="v" sid="MAT 27:55" />Bakento babingi baba koko, baba batelama kitatu mu talanga. Ni yobobo bedi kwe landingi Yesu kutonina ku mbanza yi Ngalili mu kwe musadisi. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Ha kati di bakento bebobo, ha ba na Maliya mwisi-Mangadala, Maliya ngudi yi Zaki na Yosefi, mpe na ngudi yi baala ba Zebedayi.<verse eid="MAT 27:56" /></para>
  <para style="s1">Batuula nitu yi Yesu mu ndyamu</para>
  <para style="r">(<ref loc="MRK 15:42-47">Mlk 15.42-47</ref>; <ref loc="LUK 23:50-56">Luk 23.50-56</ref>; <ref loc="JHN 19:38-42">Yoa 19.38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Mpimpa bu yitula, bakala dimosi dimvwama diyiza, wuba mwisi-Alimate, nkumbu andi Yosefi, yandi mpe wuba mulongoki wu Yesu. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Wuyenda yenikina Pilatu, na wumulomba nitu yi Yesu. Buna Pilatu wuhaana luve ba muhaana yo. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Yosefi wubonga nitu yi Yesu, wuzinga yo mulele wu lino wumoona <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />na wutuula yo mu kati di ndyamu andi yimoona yi katoboso mu ntadi. Mboki wunengomona tadi didinene ha nkotolo yi ndyamu, na wuyenda kwandi. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Maliya mwisi-Mangadala, na ndoyi andi Maliya baba koko. Baba bazakala ni bedi talanga ku ndyamu.<verse eid="MAT 27:61" /></para>
  <para style="s1">Mbulu-mbulu zikenga ndyamu yi Yesu</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Kilumbu kilanda, mpila mosi kitekila nkubukulu yi kilumbu ki saba, zimfumu zinganga-Nzambi, na Bafalisi bayenda ha kimosi ku Pilatu <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />na bata ti: «Mfumu, tubambukidi moyo ti kihuni bekyokyo, bu kaba wu moyo wuta ti: “Ku manima ma bilumbu bitatu, naafuluka mu bafwa.” <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Ni hahoho, haana luve mu kenga ndyamu beyoyo natee mu kilumbu ki bitatu. Mwanki milongoki myandi milembolo kwe yiba nitu, na mita ku mukangu ti: “Wufulukidi mu bafwa.” Buna luvunu belolo lwaavula kitezo na lo lu tekila.» <verse eid="MAT 27:64" /><verse number="65" style="v" sid="MAT 27:65" />Pilatu wubateela ti: «Mbulu-mbulu ezi! Yendeeno lu kenga ndyamu bonso bu lutiidi!» <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Buna bayenda, na bakubika bonso bufwanakani mu kenga ndyamu: batoma kanga tadi, na batuula mbulu-mbulu mu kenga.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s1">Mfulukulu yi Yesu</para>
  <para style="r">(<ref loc="MRK 16:1-10">Mlk 16.1-10</ref>; <ref loc="LUK 24:1-12">Luk 24.1-12</ref>; <ref loc="JHN 20:1-10">Yoa 20.1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Ku manima ma kilumbu ki saba, mu kilumbu ki lumingu mu minkyelo mi bwisi, Maliya mwisi-Mangadala, na Maliya mahiika, bayenda tala ndyamu. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />Bu bayutukulu kwawu, butoto buzakama mu nkatika ngolo, mu dyambu ti mbazi yi mfumu yifuma ku yulu, yi nengomona tadi, na yi zakala ha yulu. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Yedi lezima bonso mpedamu mpe binkutu byandi biba na vekoveko. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Minkengi myedi keba ndyamu miyena bunkuta bubwingi na myedi tekita, na miyiza kituka bonso bantu bafwidi. <verse eid="MAT 28:4" /><verse number="5" style="v" sid="MAT 28:5" />Kansi mbazi yiteela bakento ti: «Yeno luyenandi bunkuta ko. Nazebi ti Yesu luna sosa, yondowo wu bakomini ha kulunsi, <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />kasiidi ha ko, fulukidi mu bafwa bonso bu kaluteela wo. Yizeno, lutala huma ha bamutudidi. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Yendeeno mu muswalu luta ku milongoki myandi ti: “Fulukidi mu bafwa na wulutekididi ku mbanza Ngalili, kuna lwaamuyenina.” Misamu myamyomyo mi bedi nani mu luteela.» <verse eid="MAT 28:7" /><verse number="8" style="v" sid="MAT 28:8" />Basala sisa ndyamu mu muswalu, ku nsye bunkuta, na kyese kikingi, na bayenda mu ntiinu mu kwe yala mpolo ku milongoki. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Bayitukulu, ni Yesu wubabweni. Wubateela ti: «Mbote eno!» Yawu bafinama ha kaba, bafukama mpe basimba bitambi byandi. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Yesu wubateela ti: «Lubandi na bunkuta ko. Yendeeno luteela zimpangi zani benda ku Ngalili: kwakoko baanyenina.»<verse eid="MAT 28:10" /></para>
  <para style="s1">Kimbangi ki bambulumbulu</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Mu ntangu bakento yi baba mu nzila, mwa ndambu yi bambulumbulu yedi kenganga ndyamu yiyenda ku mbanza. Bayadila zimfumu zinganga-Nzambi mpolo zi misamu mimvimba mihyoka koko. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Zimfumu zinganga-Nzambi zikutakana na mbuta zi bantu zi Bayudayo. Bu bamana yuwasana, ni bahaana mbongo zizingi ku bambulumbulu, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />na babateela ti: «Yuweno misamu mi lwaata: “Milongoki myandi mizi yibanga nitu andi mu mpimpa, bu tubedingi balambalala.” <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Tala ti munyadi yudi wo, yeto mbo tuzaba bwedi twa mubwisila mutima, na mbo tusa ti nakani dyambu di mpasi dilutudilandi ko.» <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />Bambulumbulu babonga mbongo, na bahidika bonso ntumunu zi babahaana. Buna kikuumu kimwangana ku Bayudayo natee mu kilumbu ki bubedidi.<verse eid="MAT 28:15" /></para>
  <para style="s1">Yesu wuyenika ku milongoki myandi</para>
  <para style="r">(<ref loc="MRK 16:14-18">Mlk 16.14-18</ref>; <ref loc="LUK 24:36-49">Luk 24.36-49</ref>; <ref loc="JHN 20:19-23">Yoa 20.19-23</ref>; <ref loc="ACT 1:6-8">Mav 1.6-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Milongoki kumi na wumosi miyenda ku kizunga ki Ngalili, ha yulu mulandu wubalonka Yesu. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Bu bamuyena, bafukama, kansi bahiika ha kati dyawu baba na maketiketi. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Yesu wufinama ha baba na wubateela ti: «Bampeeni lulendo lumvimba lu ku yulu na lu ha butoto. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Yendeeno mu nsi zimvimba, lusa ti bantu bamvimba bakituka milongoki myani, lubabotika mu nkumbu yi Tata na yi Mwana na yi Mpeve Yilongo, <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />na lubalonga bakeba mimvimba mi nalusikidikisi. Mpe meno, ni neeno bilumbu bimvimba natee ku nsukunu yi nza.»<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>