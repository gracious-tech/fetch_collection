\id 2TH - Mam, Central NT (SIL: mvc; ISO: mam) -Guatemala 2009 (DBL -2013) 
\h 2 Aj Tesalónica 
\toc1 Tkab' Tu'j Pabl kye Nimil aj Tesalónica 
\toc2 2 Aj Tesalónica 
\toc3 2Tes. 
\mt1 Tkab' Tu'j Pabl kye Nimil aj Tesalónica 
\ip A tkab' u'j kye nimil toj tnam Tesalónica junx ta' tnab'ljo xnaq'tzb'il tuk'a tnejil tu'j Pabl kye nimil antza. Me tojjo tkab' u'j, nimx nyolin ti'jjo aj tul meltz'aj qAjaw. Tb'ajlinxi ttz'ib'in Pabljo tnejil u'j, b'e'x ul tqanil te, qa aye nimil antza nimx yajb'il otaq tzaj kyi'j, ex otaq chi b'isin, qu'n kub' kyximin qa a tkab' tulil qAjaw Jesucrist otaq b'aj toj kywutz. Tu'ntzi'n lu'n, xi ttz'ib'in Pabljo tkab' tu'j kye, tu'ntzin tqe kyk'u'j, ex tu'n tchewx kyanmin tojjo jni' yajb'il n-iky'xtaq kyu'n, ex tu'n tqe kyk'u'j qa na'mtaq tul Jesucrist tkab' majin. 
\ip Tu'n ttzyetjo u'j lo, xi tq'o'n Pabl chjonte te Dios, qu'n ajo kynimb'il ex kyk'u'jb'il nimil toj Tesalónica kyjataq tch'iy. Te tib'ajxi, xi tchiky'b'in kye qa ajo Tkawb'il Dios ilxixtaq ti'j tu'n tjapin, ex ajo tkab' tulil qAjaw, twutzxix, me na'mxtaq tkanin tq'ijil. Ex atzin il twutz tx'otx', a tze'nku n-iky'x kyu'n, ilxixtaq ti'j tu'n tjapin. Me okxixpe kxe'l tetz toj il, ajxix tjapin tq'ijiljo ichin, a ntq'ma Pabl, a aj ilxixch (2:3). 
\ip Kyxoljo yol te q'ol nab'l ti'j kychwinqil nimil, ajo ntzaj tq'o'n toj tb'ajsb'il tu'j, ntzaj tq'o'n juntl yol te nuk'b'il ti'jjo tu'n kyaq'nin tu'n kykanb'inte kywa' toj tumilxix, a tze'nkuxjo yek'b'il kyij tq'o'n Pabl kye, te' tten kyuk'a. 
\c 1  
\s1 Jun q'olb'il 
\p  
\v 1 Ayi'n Pabl nxi ntz'ib'inji'y u'j lu'n, junx tuk'a Silvano ex Timotey. Nxi ntz'ib'i'n kye'y, ayi'y Ttanim Dios toj tnam Tesalónica,\x * \xo 1:1 \xt Kyb'i. 17:1; 1Tes. 1:1\x* a ayi'y ma tz'ok kymujb'in kyib'a tuk'a qMan Dios ex tuk'a qAjaw Jesucrist.  
\v 2 Chjonte qMan Dios tu'n t-xtalb'il ex tnuk'b'il kyib'aja, a qTata ex qAjaw Jesucrist. 
\s1 A Dios kkawil kyib'aj aj il, aj tul qAjaw Jesús 
\p  
\v 3 Erman, kukx nxi qq'onji'y chjonte te qMan Dios kyi'ja. Ex il ti'jjo lo tu'n tkub' qb'inchi'n, qu'n a kynimb'ila nch'iyxix wen, junx tuk'a kyk'u'jb'ila teyile junjun.  
\v 4 Tu'npetzi'n, kukx nqo yoli'n kyi'ja kyxol kykyaqil Ttanim Dios, qu'n tu'n nimxix kynimb'ila ex tu'n wa'lqexixa toj tkyaqiljo nya b'a'n ntzaj kyu'nxjal, ex toj tkyaqiljo b'is n-iky'x kyu'n. 
\p  
\v 5 Ate lu'n nyek'inte qa tz'aqlexix Dios tuk'a tkawb'il, qu'n toj tkyaqiljo jni' n-iky'x kyu'n, ma tzaj tq'o'n Dios kyokixa toj kya'j.  
\v 6 Qu'n tz'aqlexix te Dios. Tu'npetzi'n, il ti'j tu'n ttzaj tq'oj Dios kyi'jjo aye' nchi yajin kyi'ja.  
\v 7 Ex ktzajil tq'o'n ajlab'l kye'y, ayi'y n-iky'x kyu'n; ikyxjo tze'nku qe' ktzajil tq'o'n ajlab'l qe'y, toj tq'ijil, aj tul qAjaw Jesús toj kya'j tuk'a q'aq' njulin wen, ex kyuk'a jni' t-angel.  
\v 8 Ex tzul q'olte tkawb'il kujxix kyib'aj kykyaqiljo, a mi ẍi nimin ti'j Dios, ex mi xkub' kynimin a Tb'anil Tqanil kolb'il te qAjaw Jesucrist.  
\v 9 Ex ktzajil q'o'n kawb'il kujxix te jun majx, ex kchi elix lajet najchaq tk'atz Dios toj kya'j, ja' nqoptz'aje qAjaw tuk'a tkyaqil tipin.  
\v 10 Tkyaqiljo lo kb'ajil, aj tul tq'ijil, tu'n tul qAjaw, tu'n tjaw nimsin tb'i, ex tu'n kyjaw ka'ylaj tkyaqil nimil, junx kyuk'iy, ayi'y ma txi kyniminji'y a yol xi qq'ma'n kye'y. 
\p  
\v 11 Tu'npetzi'n, kukx nqo na'nji'y Dios kyi'ja, tu'n kyb'eta toj tumilxix, a tze'nkuxjo kyokli'n, te' ẍi tzaj txko'n tu'n. Ex nqo kub'sin qwutza te Dios, tu'n kytzaj oni'n tu'n, tu'n tjapin b'ajjo jni' kyajb'ila b'a'n ex tkyaqil kyaq'i'n, a nkyb'inchi'n tu'n kynimb'ila, noq tuk'a tkyaqil tipin qMan.  
\v 12 Ikytzi'n, kjawil nimsit tb'i qAjaw Jesucrist toj kychwinqila, ex ikyxjo kye' ex kchi jawil nimsi'n kywutz tkyaqil xjal noq tu'n t-xtalb'il qMan Dios ex qAjaw Jesucrist. 
\c 2  
\s1 Aj tyek'in te tib'jo ichin b'inchil ilxix 
\p  
\v 1 Atzi'n ti'jjo tulil qAjaw Jesucrist, ex ti'jjo aj qchmet junx tuk'a,\x * \xo 2:1 \xt 1Tes. 4:15-17\x* qo kub'sil qwutza kye'y, erman,  
\v 2 tu'n mi jaw kytx'ixpinji'y kynab'la, ex mi chi jaw xob'a, qa at juntl xnaq'tzb'il, nyakutlaj tu'n Xewb'aj Xjan, mo tu'n jun yol, aj tok kyb'i'n, mo tu'n jun u'j, nyakutlaj awo'y xqox sma'nte, ex qa ntq'ma'n qa lu tq'ijil qAjaw ma tzul, qa chi'.  
\v 3 Mi txi kyq'o'n kyib'a tu'n kykub' sb'u'n kyu'nxjal, qu'n aj na'mxtaq tpon tq'ijil tu'n tul qAjaw, ok chi q'ojlilxjal ti'j qMan Dios nej, ex antza k'wele tyek'in ichin tib', a ajq'ojxix ti'j Dios, a o tz'el q'o'n te najin te jun majx.  
\v 4 Qu'n atzin ichin lo kjawil tnimsin tib' twutz Dios,\x * \xo 2:4 \xt Dan. 11:36; Ez. 28:2; Mt. 24:15; Mr. 13:14\x* ex kq'ojlil ti'j tkyaqil kydiosxjal ex ti'j tkyaqil k'ulb'il. Ex okpe k'wel qe toj tnejil ja te kynab'l nxjalila Dios, aye' aj Judiy. Ex k-okil tq'o'n tib' nyakuj Dios. Ex ok tq'ma'b'il: Ayi'n we' Dios, chila'. 
\p  
\v 5 ¿Mitzin na'n kyu'n, tej t-xi nq'ma'n kye'y ti'j tkyaqiljo lo, tej intinxtaqa kyuk'iy?  
\v 6 Ex atzin ja'lin, b'i'n kyu'n ti' ma tz'ok meqonte, tu'n mi tzule ichin lo. Na'mx tkanin tq'ijil.  
\v 7 Atzi'n tipin nya b'a'n, n-aq'nin ja'lin twutz tx'otx' toj ewajil, tzmaxi' aj teljo a meqolte.  
\v 8 B'e'xsin k'wel tyek'i'n ichin tib', a aj ilxix, me b'e'x k'wel b'yo'n tu'n qAjaw, noq tuk'a T-xew.\x * \xo 2:8 \xt Is. 11:4\x* Ex noq tu'n tqoptz'ajiyil tten, b'e'x k'wel yuch'j te jun majx.  
\v 9 Atzin ichin aj ilxix tzul noq tu'n tipin satanás, a tajaw il. Ex k'wel tb'inchin nim techil tipin, a noq tu'n kyjaw ka'ylajkuxjal ti'j, me noq te sb'u'b'l.\x * \xo 2:9 \xt Mt. 24:24\x* 
\v 10 Ex k'wel tb'inchin tkyaqil wiq il, noq tu'n kysb'etku xjal tu'n, aye kyja' kyxi' toj najin, qu'n kyky'e' tu'n kynimin ti'jjo Tb'anil Tqanil kolb'il, a twutzxix, tu'n kyklet.  
\v 11 Tu'npetzi'n, ax Dios kxel tzaqpinkye tu'n kykub' sb'u'n, ex tu'n t-xi kynimin a yol nya twutzx,  
\v 12 tu'ntzin kynaj te jun majx, qu'n kyky'e' tu'n t-xi kynimin Tb'anil Tqanil, qu'n noq o'kx nchi tzalaj tu'n kyb'inchin il. 
\s1 Ma qo jaw sk'o'n tu'n qMan Dios tu'n qklet 
\p  
\v 13 Me metzin kye', erman, ayi'y k'u'jlinqi'y tu'n qAjaw, o chi jaw sk'o'n atxix ojtxe tu'n qMan Dios, tu'n kykleta, noq tu'n o saqix kyanmi'n tu'n Xewb'aj Xjan, ex tu'n o chi nimi'n ti'j Tb'anil Tqanil kolb'il, a twutzxix. Tu'npetzi'n, kukx kxel qq'o'nji'y chjonte te Dios kyi'ja.  
\v 14 Ikytzi'n, ma chi txokli'y tu'n qMan Dios tu'n kykleta, noq tu'n Tb'anil Tqanil kolb'il, a xi qq'ma'n kye'y, tu'ntzi'n ja'lin at kyokli'n ti'jjo a at toj kya'j, ja' nqoptz'aje qAjaw Jesucrist. 
\p  
\v 15 Tu'npetzi'n, ayi'y erman, chi we'xixa jikyin wen toj kynimb'ila, ex mi tz'el naj toj kyk'u'ja a xnaq'tzb'il xi qq'o'n kye'y, tej oto'xtaqa kyuk'iy, ex tojjo u'j xi qsma'n kye'y.\x * \xo 2:15 \xt 1Co. 11:2\x* 
\v 16-17 Aku qAjaw Jesucrist ex qMan Dios o tz'ok k'u'jlinqe, ex o tzaj tq'o'n jun q'uqb'il qk'u'j te jun majx. Ex tu'n ikyjo, tzaj tq'o'n jun tb'anil tumil tu'n kyayo'n ti'jjo a at toj kya'j, noq tu'n t-xtalb'il. Axit qAjaw ex qMan Dios nimsin te kyanmi'n ex tu'n kywe'xixa kujxix, tu'ntzin kyyoli'n ex tu'n kyb'inchinteji'y wenxix toj tkyaqil. 
\c 3  
\s1 Qo na'n Dios, tu'n tkanin Tyol Dios toj tkyaqil twutz tx'otx' 
\p  
\v 1 Atzin ja'lin, erman, chi na'n Diosa qi'ja, tu'n tkanin Tb'anil Tqanil qAjaw liwey toj tkyaqil twutz tx'otx', ex tu'n tkub' nimin, tze'nkuxjo tej xpon kanin kyxola.  
\v 2 Ex chi na'n Diosa qi'ja tu'n qkleta toj kyq'ob'xjal pi'sqe ex aj ilqe, qu'n nya tkyaqilxjal nimilqe ti'j Tyol Dios.  
\v 3 Me me te Dios tz'aqlexix te', ex chi k'wel tzyu'n tu'n jikyinxix, ajxi tjapin b'aj tkyaqil; ex ok chi elil klo'n tu'n, toj tq'ob' tajaw il.  
\v 4 Ex q'uqle qe qk'u'j ti'j qAjaw, qu'n atzi'n xi qq'ma'n kye'y, ax nkub' kyb'inchinji'y, ex noqit kukx kub' kyb'inchinji'y.  
\v 5 Axit qAjaw tz'onin kye'y, tu'n tel kyniky'a te tq'aq'b'il tk'u'j qMan Dios kyuk'iy, ex tu'n kykujsin te kyib'a, tze'nku te Crist, toj tkyaqiljo a n-iky'x kyu'n. 
\s1 Il ti'j tu'n qaq'nin 
\p  
\v 6 Atzin ja'lin erman, kxel qq'ma'n kye'y toj tb'i qAjaw Jesucrist, tu'n tel kypa'n kyib'a ti'j tkyaqiljo erman, a tky'e' tu'n taq'nin, ex mi nb'et tze'nku tojjo xnaq'tzb'il, a xi qyek'i'n.  
\v 7 Qala' b'i'n kyu'n qa il ti'j tu'n kyok lipe'y ti'jjo yek'b'il xkub' qq'o'n kywutza, qu'n nyataq ky'ajqo'y kyxola,  
\v 8 ex mix ja' xqo ok wani'y kyi'ja. Qala' ma qo aq'ni'n q'ijl ex qniky'in, tu'ntzin mi tz'oke jun iqtz kyi'ja.\x * \xo 3:8 \xt Kyb'i. 18:3; 1Tes. 2:9\x* 
\v 9 ¿Qu'n noqittzin nti'taq qokli'n ti'j jun onb'il, tu'n t-xi qqani'n kye'y? Me mi xi qqani'n. Qala' ma qo aq'ni'n, tu'ntzintla tkyij qq'o'n jun yek'b'il kye'y, tu'n kyok lipe'y ti'j.  
\v 10 Qu'n tej qte'n kyuk'iy, xi qnik'u'n kye'y, qa at jun a'la tky'e' tz'aq'nin, ex nti' tu'n twa'n.  
\v 11 Nxi qna'nji'y lu'n kye'y, qu'n b'i'n qu'n qa at junjun kyxola, a kyky'e' chi aq'nin, ex noq n-ex kyq'ij kyb'etb'in kytziyile ja.  
\v 12 Me aye xjal lo kxel qq'ma'n kye toj tb'i qAjaw Jesucrist, tu'n kyaq'nin, tu'ntzintla tkanb'itjo telix kyq'ij kyu'n.  
\v 13 Ayi'y erman, mi chi sikyti'y tu'n kyb'inchinteji'y wen.\x * \xo 3:13 \xt Gal. 6:9\x* 
\p  
\v 14 Ex qa at jun kyxola mi nkub' tb'i'n a nxi qq'ma'n kye'y tojjo u'j lo, noq kyka'yinka, exsin kypamil kyib'a ti'j, tu'ntzin ttzaj tx'ixwe.  
\v 15 Me mi tz'el kyiky'i'n, qala' kyq'o'nxa jun tnab'l, qu'n erman. 
\s1 Jun tq'olb'il Pabl ex jun na'j Dios tu'n tjapin b'ajjo u'j lo 
\p  
\v 16 Noqit ax qAjaw, a Tajaw tkyaqil nuk'b'il, kukx tzaj q'onte tnuk'b'il toj tkyaqil. Ex axit qAjaw ten kyuk'iy toj tkyaqil.  
\v 17 Atzin q'olb'il lu'n ayinkuy Pabl nchin kub' tz'ib'i'nte tze'nkuxjo nkub' ntz'ib'inji'y tkyaqil wu'ja. Ex ikytzin k-elile kyniky'ji'y te, qa ayinkuy nchin kub' tz'ib'inte u'j lo. 
\p  
\v 18 Noqit a t-xtalb'il qAjaw Jesucrist kyib'aja kykyaqila. Ikyxitjo.