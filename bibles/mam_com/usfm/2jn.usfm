\id 2JN - Mam, Central NT (SIL: mvc; ISO: mam) -Guatemala 2009 (DBL -2013) 
\h 2 Juan 
\toc1 Tkab' Tu'j Juan 
\toc2 2 Juan 
\toc3 2Jn. 
\mt1 Tkab' Tu'j Juan 
\ip Ajo u'j lo tz'ib'in tu'n Juan, a tsanjil Jesús, a kub' tz'ib'in te' Tb'anil Tqanil, a Tu'j Juan. Atzin u'j lu'n xi ttz'ib'in kye nimil toj jun Ttanim Dios, a ojtzqi'n tu'n Juan. 
\ip Atzin t-xilin u'j lu'n, te q'ol nab'l tu'n qanq'in tz'aqlexix toj qnimb'il ti'j Jesucrist; exsin tq'o'n jun xnaq'tzb'il kujxix kyi'jjo xnaq'tzil nya b'a'n, ex ti'jjo kyxnaq'tzb'il, a nti' tumil. 
\c 1  
\s1 Jun q'olb'il te Ttanim Dios 
\p  
\v 1 Ayi'n at wokli'n te nejinel toj tkyaqil Ttanim Dios, ex nxi ntz'ib'i'n kye'y, ayi'y nimilqi'y, aye o chi sk'eta tu'n qMan Dios. Nimxix nk'u'ja kyi'ja, ex nya o'kqenxi, qala' tkyaqiljo nimil, aye o tz'el kyniky' ti'j Tyol Dios, a twutzxix.  
\v 2 Nchi ok nk'u'jli'n noq tu'n Tyol Dios, a twutzxix, a at toj qanmin, ex ktenb'il quk'a te jun majx.  
\v 3 Ax qMan Dios, junx tuk'a Tk'wal, a qAjaw Jesucrist, k'wel ky'iwlin kye'y tuk'a tkyaqil t-xtalb'il, ex tu'n ttzaj tq'on tq'aq'b'il kyk'u'ja kyxola, ex jun kymujb'il kyib'a, a tzajnin te Dios. 
\s1 Qo we'xix toj qnimb'il 
\p  
\v 4 Nimx jun tzaljb'il toj wanmi'n, qu'n at junjun kyxola, aye nchi b'et toj tumil,\x * \xo 1:4 \xt 3Jn. 3\x* a twutzxix toj kychwinqil, a ikyxjo tze'nku' xkyij tq'ma'n Dios.  
\v 5 Me atzin ja'lin werman, tu'n ikyjo, nchin kub'sin nwutza kye'y kykyaqila, tu'n tok qk'u'jlin qib' qxolilex. Atzi'n yol lo, nya jun nuk'b'il ma tzajxi, qu'n atxtaq ojtxe.\x * \xo 1:5 \xt Jn. 13:34; 15:12, 17\x* 
\v 6 Atzin qk'u'jb'il qib'jo, a tu'n qb'et toj qchwinqil tze'nkux tnuk'b'il Dios kyij ttz'ib'in toj Tyol. Ex atzin tnuk'b'il qMan Diosjo lo, a o tz'ok kyb'i'n atxix ojtxe: Tu'n qb'et tuk'a tq'aq'b'il qk'u'j qxolx.\x * \xo 1:6 \xt Jn. 14:15, 23-24; 1Jn. 5:3\x* 
\s1 Qka'yink qib' tu'n mi qo kub' sb'u'n kyu'nxjal 
\p  
\v 7 Ma kyij ntz'ib'inji'y lu'n, qu'n at nim sb'ul xjal tzalu'n, aye nxi kyq'ma'n qa mi s-ok Jesucrist te ichin, tej tul twutz tx'otx'. Ayetzin sb'ul xjaljo, aye ajq'ojqe ti'j Klolqe Jesús.\x * \xo 1:7 \xt Mt. 7:15; 1Jn. 2:18; 4:1-3\x* 
\v 8 Tu'npetzi'n, kyka'yinktzin kyib'a, tu'n mi kyij najjo a chojb'il kyaq'nb'i'n, a tze'nku taj qMan, qala' tu'ntzintla kykanb'inteji'y tkyaqiljo a at kyoklin ti'j.  
\v 9 Qa at jun xjaw tnimsin tib', ex qa ma ja ttx'ixpi'n xnaq'tzb'il lu'n, a xkyij tyek'in Crist, ex nti' te' qMan Dios tuk'a. Me atzin k-okil lipe ti'jjo a t-xnaq'tzb'il Jesús, at te' Dios tuk'a, junx tuk'a Jesús, a Tk'wal.\x * \xo 1:9 \xt 1Jn. 2:22-23; 4:15\x* 
\p  
\v 10 Qa at jun xjal xkanin xnaq'tzil kyuk'iy, qa nyatil t-xnaq'tzb'iljo tze'nku te Jesús, mi tz'okx kyk'le'n toj kyjay, ex mina kub' kytziyi'n.  
\v 11 Qu'n atzin a k'wel tziyinte, ajin ma tz'ok tq'o'n tib' tuk'a xjal, a nya wen tten. 
\s1 Jun yol tu'n tjapin b'ajjo u'j lo 
\p  
\v 12 Nimx we' tu'n t-xi nq'ma'n kye'y. Me nky'e'y tu'n t-xi ntz'ib'i'n toj u'j. Qu'n wajkuxixa tu'n nkani'n lol kye'y,\x * \xo 1:12 \xt 3Jn. 13-14\x* ex tu'n qyolin kyuk'iy tu'ntzintla nimxix tzaljb'il. 
\p  
\v 13 Aye jun ch'uq nimil tzalu'n, aye ma chi sk'et tu'n qMan Dios, ex nxi kyq'o'n jun q'olb'il kye'y.