\id JAS - Mam, Central NT (SIL: mvc; ISO: mam) -Guatemala 2009 (DBL -2013) 
\h Santyaw 
\toc1 Tu'j Santyaw 
\toc2 Santyaw 
\toc3 Stg. 
\mt1 Tu'j Santyaw 
\ip Atzi'n u'j lu'n tz'ib'in tu'n Santyaw, a titz'in qAjaw Jesucrist. Nyolin ti'jjo jun nab'l te Dios tze'nku junjun u'j toj Ojtxe Tu'jil tze'nku Proverbios ex Eclesiastés. Atzin nab'l lu'n, mi nyolin ti'jjo kynab'lxjal, a nchi ka'yin ti'jjo jni' at twutz tx'otx', mo ti'j kynab'lxjal ti'j Dios ex ti'j xjal, qala' tu'n t-xi nik'etjo chwinqil twutz tx'otx', tze'nkuxjo taj qMan Dios, ex tu'n qb'et toj qchwinqil jikyinxix wen. 
\ip Tojtzin u'j lu'n, at ila'ku xnaq'tzb'il ti'j, tze'n tu'n qb'ete toj tumilxix toj qnimb'il. Ntzaj xkye u'j lu'n tu'n Santyaw tuk'a jun yol te q'uqb'il qk'u'j, tu'n tjyetjo nab'l, a tzajnin tu'n Dios, a nimx n-ajb'in, aj tokjo qnimb'il toj joyb'il ti'j. Te tib'ajxi, nyolin kyi'jjo xjal yaj ex q'inin, ex qa tu'n mina tz'el qpa'n toklin jun xjal tuk'a toklin juntl. Ex ikyxjo, nyolin ti'j jni' niky'b'il ex yajb'il toj qchwinqil; ex ti'jjo nimb'il twutzxix, a nyek'in tu'njo qb'inchb'in tb'anilxix. Qatzin qa nti'jo b'inchb'in anetzi'n, atzin qnimb'iltz kyimnin ta'. Ntzaj tkujsin ti'jjo tumil, ex ntzaj t-xnaq'tzin, qa il ti'j tu'n qtzyu'nte qaq', ex tu'n mi qb'inchin mib'in tuk'a. 
\ip Tojtzin tkyaqil, ntzaj tkujsin Santyaw qa ilxix ti'j tu'n tkub' qb'inchin tze'nkuxjo ntzaj tyek'in qnimb'il. 
\c 1  
\s1 Jun q'olb'il 
\p  
\v 1 Ayi'n Santyaw,\x * \xo 1:1 \xt Mt. 13:55; Mr. 6:3; Kyb'i. 15:13; Gal. 1:19\x* jun taq'nil qMan Dios ex ikyx te Jesucrist, a tAjaw Tkyaqil; jun q'olb'il kye'y, ayi'y kab'lajaj ch'uq xjal tzajnin te Israel, a ojtxe qxe'chil, ex ja'lin kysipin kyib'a toj tkyaqil twutz tx'otx'.\x * \xo 1:1 \xt 1Pe. 1:1\x* 
\s1 Qqanix qnab'l te Dios, nya nka'min qk'u'j 
\p  
\v 2 Ayi'y werman, qa ma tzaj nya b'a'n kyi'ja, chi tzalajxa tu'n kky'elix kyi'ja,  
\v 3 qu'n tu'n b'i'n kyu'n, qa ma niky'b'ajtz kynimb'ila tu'n Dios. Ikytzin kchi b'antileji'y tu'n tten nim kyk'u'ja tu'n kyayo'n ti'j tkyaqil tajb'il qMan.  
\v 4 Me ikytzi'n, ilx ti'j tu'n ttenxix kyk'u'ja tu'n kyayo'n, tu'ntzin kytiji'n ex tz'aqle toj kynab'la, tu'ntzin nti'x juntl atx taj toj kynimb'ila. 
\p  
\v 5 Qa at jun kyxola atx taj tu'n tel tniky' tu'n tb'et toj tumil, b'a'n txi tqanin te qMan Dios,\x * \xo 1:5 \xt 1Re. 3:5-12\x* ex ok ktzajil tq'o'n, qu'n ntzaj tq'o'n te Dios te qkyaqilx a at tajb'in qe, ex mina nqo ok i'lin tu'n.  
\v 6 Me atzi'n, kxel tqanin tuk'a tnimb'il,\x * \xo 1:6 \xt Mt. 7:7-11; 21:21-22; Jn. 16:23-24\x* ex nya nka'min tk'u'j tze'nku a' te ttxuyil a', n-ul piq'j ex n-ajl ti'j tu'n kyq'iq'.  
\v 7 Qa at jun xjal iky t-ximjo, qa nlay tzaj q'o'n te tu'n qAjaw,  
\v 8 qu'n ja'lin ntb'isin jun ti', ex mikyxiljo nchi'j. Nya junxch'in tumil nxi ti'n. 
\s1 Jun q'inin ex jun yaj kchi kletil, qa ma chi nimin ti'j Klolqe Jesús 
\p  
\v 9 Aye yaj nimilqe tzalu'n twutz tx'otx', b'a'n tu'n kytzalaj, qu'n japin nim kyoklin tu'n qMan Dios.  
\v 10 Ex ikyx te q'inin twutz tx'otx' tzalu'n, b'a'n tu'n ttzalaj, tu'n ma kub' tmutxsin tib' twutz Dios; qu'n ikytzin te q'inin ok b'ajil tze'nku jun t-xmakil k'ul, ex nlay kub' ten te jun majx.  
\v 11 Ajtzin tjawil q'ij, k'wel tzqij tqan, ex k-elil tz'aq t-xmakil, ex b'e'x knajiljo tka'yb'il tb'anilxtaq. Ikytzi'n, atzin q'inin at nim tq'inimil; me ilxix ti'j kyjel, aj tkyim, ikyxjo tze'nku tal t-xmakil k'ul.\x * \xo 1:11 \xt Is. 40:6-7\x* 
\s1 Qo we'xix twutz jun nya wen, qa ma tzul kanin qi'j 
\p  
\v 12 At tky'iwb'il qMan tib'aj jun nimil qa ma we'xix wen, aj tul kanin nya b'a'n ti'j. Ajtzin tiky'xtz tu'n, ok ktzajil q'o'n jun oyaj te tb'anilx, a chwinqil te jun majx, a o tzaj ttziyin qMan Dios kye', a ok kchi okil k'u'jlinte. 
\p  
\v 13 Qa at jun nna'nte qa n-ok yekin tu'n tkub' tb'inchi'n nya b'a'n, mi kub' tb'isin qa tu'n qMan Diosjo lu'n; qu'n mina nkub' tb'isin te Dios tu'n tok tb'inchin nya b'a'n, ex nlay tz'ok tnikyb'in te Dios jun a'la.  
\v 14 Qala', qa at jun xtna' jun tb'is tu'n tkub' tb'inchin a nya b'a'n, ikyxjo tze'nku jun ti' tku'x toj jun tzuyb'il txuk; ax tb'is xkub' sb'unte. Ex ikytzi'n nkub'e tz'aqe toj il.  
\v 15 Kyu'ntzi'n tb'is nya b'a'n, nku'xa til; ex ajtzin tch'iyjo il wen, ikytzin ktzajile kyimi'n ti'j. 
\p  
\v 16 Werman, nimxix nk'u'ja kyi'ja, mi txi kyq'o'n kyib'a tu'n kykub' sb'u'n.  
\v 17 Qu'n tkyaqil oyaj b'a'n ex tkyaqiljo tb'anilxix, kyja ntzaje te' toj kya'j, a ntzaj tq'o'n qMan Dios, ajo B'inchil te' twutz kya'j jni'jo nb'aj qoptz'aje. A Dios nti' jun ti' nkub' ttx'ixpintl; nya ikyjo tze'nku jun t-xlekemil ti', a nxi yekj.\x * \xo 1:17 \xt Num. 23:19; Mal. 3:6\x* 
\p  
\v 18 An Diosjo, tu'n tajb'il, ma tzaj tq'o'njo saq chwinqil tu'njo Tb'anil Tqanil, a Tyol twutzxix.\x * \xo 1:18 \xt 1Pe. 1:23\x* Tu'ntzi'n, qokin awo tnejil nimil, jun tnejil oyaj te saq tch'iysb'in qMan Dios, tze'nku jun oyaj ti'j tnejil twutz awal. 
\s1 Qajsintz ti'j tyab' qwi' 
\p  
\v 19 Werman, nimxix nk'u'ja kyi'ja, kyna'ntzinji'y lu'n: Kykyaqilxa nya nej kchi jawil yolb'i'n tuk'a tyab' kywi'y; qala' nej k-okil kyb'i'n,  
\v 20 qu'n tu'n tyab' twi'xjal nlay b'antjo b'a'n twutz qMan Dios.  
\v 21 Tu'npetzi'n, kytzaqpinkji'y tkyaqiljo il exsin jni' nya b'a'n, qu'n o'kx te ma ch'iyxjo kyojjo q'ij lu'n, exsin kyniminkuji'y Tb'anil Tqanil, a o kyij awa'n toj kyanmi'n; me kyniminkuy tuk'a kymutxb'il kyib'a. Atzin Tqaniljo lo at tipin tu'n kykleta tu'n. 
\s1 Il ti'j tu'n tkub' qb'inchin a ntq'ma'n Tyol Dios, ex nya noq tu'n tok qb'i'n 
\p  
\v 22 Ex nya noq o'kx tu'n tok kyb'i'nji'y Tyol Dios; qala' il ti'j tu'n tkub' kyb'inchinji'y a ntzaj tq'ma'n. Qatzin qa mikyxi s-oke kyu'n, nkub' kysb'u'n kyib'a kyil kyib'xa.  
\v 23 Ankye te' noq o'kx nkyja'ye tu'n ma tz'ok tb'i'n, ex mina nkub' tb'inchin, ikytzin k-elile' tze'nku jun xjal nkux tka'yin twutz toj jun ka'yb'il wutzb'aj.  
\v 24 Ma ntlon tetz tze'n iky twutz, me ajtzin tel b'et, ma tz'el naj ka'yin twutz toj tk'u'j. Ikytzin Tyol Diosjo tze'nku ka'yb'il wutzb'aj.  
\v 25 An te' mina n-el naj toj tk'u'j, qala' kyja n-oke tnab'l wen ti'j Tyol Dios, ex tu'n tten jikyin toj tchwinqil, ex tu'n tb'antjo a ntq'ma'n Tyol Dios, oktzin ktzalajil tojjo tb'inchb'in. Atzin Tyol Diosjo tz'aqlexix wen, a xqo tzaqpet tu'n toj qil. 
\p  
\v 26 Qa at jun xjal nkub' tb'isin qa nimil, exsin qa nya jk'u'n ttzi, ax nkub' sb'unte tib' tu'njo tb'is, ex atzin tnimb'il nti' tajb'in.  
\v 27 Qalatzin te' nimb'iltz tb'anilx, ex nti' tky'i twutz qMan Dios, a nmojin kyi'j meb'e, exqetzi'n qya, a o chi kyim kychmil, ex aye toj jun kyixk'oj ite'ke; ex mi nxi' yajil tib' toj il tzalu'n twutz tx'otx'. 
\c 2  
\s1 Junx tz'ele kyoklin kykyaqilxjal qu'n 
\p  
\v 1 Ayi'y werman, a nimilqi'y ti'j qAjaw Jesucrist, a nimxix toklin, mi kub' kyb'inchi'n tu'n nya nim toklin jun xjal tze'nku juntl.  
\v 2-3 Ikyettzi'n tz'okpint jun xjal kyxola tok t-xmilq'ob' twi' wiyil ex tb'anilx toj t-xb'alin, ex ikyxjo tz'okxit jun tal yaj tuk'a t-xb'alin ttx'aqin; exsintla xi kyq'ma'ntza te te' tb'anilx toj t-xb'alin: ¡Qekuy! ¡Lu tq'uqb'ila lo tb'anilx wen! Exsintla xi kyq'ma'n te tal yaj: Axsa wekuy, mo qa qekuy i'chaqx twutz tx'otx'tz nej.  
\v 4 Qa ikyjo kyu'n, ayi'y ẍi q'mante s-el kypa'nji'y a nya nim toklin; nya wen kynab'la ikyjo. 
\p  
\v 5 Ayi'y werman, nimxix nk'u'ja kyi'ja, kyb'intzi'n: A te Dios xja sk'o'nkye yaj tzalu'n twutz tx'otx', tu'n kyok q'inin toj kynimb'il, ex tu'n ttzaj kyk'mo'n Tkawb'il Dios toj kyanmin te jun etzb'il, a o tzaj ttziyin kye', aye kchi okil k'u'jlinte.  
\v 6 Qalatzin kye', nchi el kyiky'inji'y yaj, ¿Ma nyaqepetzila q'inin nchi kub' b'inchinte nya b'a'n kyi'ja, ex nchex qton kye'y kywutz kawil?  
\v 7 ¿Ma nyatzin aye nchi xo'n yol ti'j tb'i qMan Dios, a o txi kynimi'n? 
\p  
\v 8 Qatzin tzunxix nkub' kyb'inchinji'y wen, a nuk'b'il nimx toklin, a ntq'ma'n toj Tu'jil Tyol Dios, tu'n tok tk'u'jlin t-xjalila tze'nku n-ok tk'u'jlin te tib' til tib'xa;\x * \xo 2:8 \xt Lv. 19:18\x* ex tb'anilx te' nb'ant ikyjo.  
\v 9 Me qa ma tz'el kypa'n toklin jun xjal tuk'a toklin juntl, mapen kux jun kyiltza ikyjo, ex ma chi oktza b'inchil mib'in twutz Tkawb'il qMan Dios.  
\v 10 Qu'n qatzin qa jun xjal nkub' tb'inchin tkyaqil kawb'il, exsin qa ma jaw txalpaj toj jun, tuk'axpe jun; ma tz'ok aj paj toj tkyaqil,  
\v 11 qu'n axsin Diosjo xq'mante tu'n mina ky'a'ji'n\x * \xo 2:11 \xt Ex. 20:14; Deu. 5:18\x* ex mi b'iyi'n.\x * \xo 2:11 \xt Ex. 20:13; Deu. 5:17\x* Atzin ja'lintz, qatzin mi nky'a'ji'n, exsin qa ma b'iyi'n, ma tz'el ti'jlintza tkawb'il Dios, ex mina nkub' tnimi'n. 
\s1 Qyek'inku qnimb'il tuk'a qb'inchb'in, ex nya noq tuk'a qtzi 
\p  
\v 12 Ayetzintza ja'lin, chi yolinxa toj ttxolil, ex chi b'et-xa toj tumil, noq te jun yek'b'il ti'j kynimb'ila; qu'n b'i'n kyu'n qa kchi okila toj pa'b'in twutz tkawb'il Dios, ex ax kawb'iljo ktzaqpil kye'y.  
\v 13 Qu'n ayetzin kye', a mi ntzaj q'aq'in kyk'u'j ti'j juntl, nlay tzaj q'aq'in tk'u'j Dios kyi'j, aj kyok toj pa'b'in. Me ayetzin kye', a ntzaj q'aq'in kyk'u'j ti'j juntl, ayetzin kye kchi kletiljo, aj kyok toj pa'b'in twutz Kawil. 
\p  
\v 14 Ayi'y werman, ¿Titzin k-ajb'ila qa at jun nq'ma'nte qa niminxix tu'n, exsin qa mi nkub' tyek'in tnimb'il? ¿Ma okpetzila kkletil tu'n jun tnimb'il ikyjo? ¡Nlay!  
\v 15 Ikyettzi'n atit jun nimil nti' t-xb'alin, ex nti' twa tu'n tok junjun q'ij,  
\v 16 ex qa at jun kye' xi q'ma'nte: K'a' tli tib'a. Q'onk t-xb'ali'n, ex k'a' wa'n wen, noq tze'n taja. Ex qa mina xi tq'o'n a tililx ti'j te t-xmilil, ¿Titzin k-ajb'ila ikyjo?  
\v 17 Ikytzin nb'ajjo toj qnimb'il; kyimnin ta'ye, ex nti' tajb'in, qa noq xkub' qyolin, ex qa mi xkub' qyek'in tuk'a qb'inchb'in. 
\p  
\v 18 B'alaqa at jun aku txi q'ma'nte: At te tnimb'il. Me ayintzin we', at we nb'inchb'in toj nnimb'ila. 
\p ¿Ma akupela b'ant tyek'it tnimb'ila, qa mi nkub' tb'inchi'n? ¡Nlay! Qalatzi'n, kxel nyek'in we' nnimb'il tu'n nb'inchb'i'n. 
\p  
\v 19 Nimin te tu'n, qa at junch'in Dios. Tb'anilx ikyjo, qu'n ikypen kye taq'nil tajaw iljo b'i'n kye kyu'n, expe nchi tzaj lu'lin tu'n kyxob'il te. 
\p  
\v 20 Ay, nti' tnab'la ikyjo. Qu'n qa noq o'kx tu'n b'i'n qu'n, ex qa nya il ti'j tu'n tyek'it tu'n qb'inchb'in, nti' te jun nimb'il tajb'in ikyjo. 
\s1 Kab'e yek'b'il te qe, tu'n Abraham ex Rahab 
\p  
\v 21 Qala' ka'ntzin te Abraham, a ojtxe qxe'chil, b'a'n ele twutz qMan Dios tu'n tb'inchb'in, tej tkub'taq tb'yo'n tk'wal, a Isaac, te chojb'il il.\x * \xo 2:21 \xt Gen. 22:1-14\x* 
\v 22 Ka'yinktzi'n ti'jjo o b'aj ti'j Abraham; o tyek'e tnimb'il tu'n tb'inchb'in. Ex atzin tnimb'il b'a'n xjapine twutz Dios noq tu'n tb'inchb'in.  
\v 23 Ikytzin xjapine' ntq'ma'n Tu'jil Tyol Dios. Chitzin kyjalu'n: 
\q1 Kub' tnimin Abraham Diosch. 
\q1 Tu'ntzin tnimb'iltz ikyjo, b'a'n ele twutz Dios.\x * \xo 2:23 \xt Gen. 15:6\x* 
\m Ex ok tq'o'n Dios te tuk'a.\x * \xo 2:23 \xt 2Cr. 20:7; Is. 41:8\x* 
\p  
\v 24 Man kylitza, qa ma tz'ok tq'o'n Dios xjal tz'aqle twutz, nya noq o'kx tu'n tnimb'il, qala' majx tuk'a tb'inchb'in, a tzajnin ti'j tnimb'il.  
\v 25 Ex ikyx b'ajjo ti'j aj ky'a'jiltaq Rahab toj Tu'jil Tyol Dios. B'a'n ele twutz Dios tu'n tb'inchb'in, tej i kub' tewin aye tsanjil Israel, ex i xi tmojin tu'n kyoq toj junxil b'e, tu'n kyklettaq toj tq'ob' nmaq kawil te Jericó.\x * \xo 2:25 \xt Jos. 2:1-21\x* 
\v 26 Ikytzin tetzjo lu'n; tze'nku nti' tajb'in jun xmilil qa nti' t-xew toj, qu'n kyimnin ta'ye; ikytzin jun nimb'iljo qa nti' tb'inchb'in tuk'a. 
\c 3  
\s1 Qo ximin ti'j qyol 
\p  
\v 1 Ayi'y werman, nya noq a'lchaqku kye, tu'n tok te jun xnaq'tzil Tyol Dios, qu'n b'i'n kye' kyu'n, awoxixpeqe a nqo xnaq'tzin ti'j Tyol, ok qo tzajil kawin kuj tu'n Dios, qa mina nqo b'et toj tumiljo qxnaq'tzb'il.  
\v 2 Ikytzi'n, qkyaqilx nimku ja' nqo b'inchine nya wen tuk'a qyol. Ikyettzi'n, atit jun nti'x ntxalpaje tuk'a tyol, atzin jun xjaljo nti'x tky'i toj tchwinqil, ex at tipin tu'n ttzyu'nte tib' twutz tkyaqil il.\x * \xo 3:2 \xt Pr. 18:21\x* 
\p  
\v 3 Ka'ntzin te chejila; tu'n tkub' nimin tu'n chej, k-okix tq'o'n kxb'il tal netz' toj ttzi, tu'n tq'o'nte tib', ex tu'n t-xi' ja' taje chejil.  
\v 4 Ex ka'nqetzin kye bark, exsin tu'nj ma tijqe, ex tzunx nju'minx kyq'iq' kyi'j, tze'n nchi rinin toj ttxuyil a', n-okin jun tal netz' xuyb'ilte kyu'nxjal, a q'ilte, ja' tumil kyaje tu'n kyxi'ye.  
\v 5 Ikytzin nb'ajjo tu'n qaq'; tal netz'petzin toj qxmilil, me at tipin tu'n tb'ant nimku ti' tu'n. Ikyjo tze'nku ch'in tal t-xk'itil q'aq' nkub' b'aj jun tij wutz tu'n.  
\v 6 Ex ikytzin qaq'jo tze'nku q'aq' anetzi'n;\x * \xo 3:6 \xt Pr. 16:27\x* tex jun joyb'il q'ojx toj qxmilil; ex nya wen nqo ele tu'n. Q'ontz tq'aq'il tu'n tq'aq'il tajaw il. Nim ntjyo'n tumil tu'n qb'inchin il. Tu'ntzintzjo, atkux ikyx kb'ajile qchwinqiljo tzalu'n twutz tx'otx' tuk'a q'oj. 
\p  
\v 7 O'kqex kye n-ajtz kyi'jjo tu'n xjal: A tze'nqeku toj k'ul txuk, jni'qe nchi lipin, jni' kan, exqetzi'n txuk toj ttxuyil a', kye b'ala tajtz kyi'j tu'n.  
\v 8 Me metzin te qaq' mix a'lx nxkye ti'j tu'n tajtz ti'j. O'kx jun jyol q'ojjo; mina ntq'o'n tib' tu'n tajtz ti'j; nyakuj nojnin tuk'a b'i'yb'il te jun majx.  
\v 9 Tu'n qaq', nqo nimsin tb'i qMan Dios; ex tu'n qaq', nqo yolb'in kyi'jxjal, aye b'inchin tu'n Dios tuk'a toklin toj tanmin,\x * \xo 3:9 \xt Gen. 1:26\x* tu'n t-ximin, ex tu'n t-xi ti'n toj tumilxix tze'nku Dios.  
\v 10 Toj qtzi, junx n-etze wen ex nya wen. Ayi'y werman, ku chichkuji'y, ¡Nya tumiljo ikyjo!  
\v 11 ¿Ma attzin jun xlok' a', a n-etz a' wen toj, ex axsa k-elitze a' k'a? ¡Mina!  
\v 12 Ex ikyxjo, ¿Ma attzin jun tqan iw aku tz'el twutz mikyxiljo; mo qa jun tqan uv aku tz'el twutz iw? ¡Mina! Tu'ntzintzjo, nya wen junx tu'n tetze' wen ex nya wen toj qtzi. 
\s1 Kab'e wiq ẍtijil: Jun te twutz tx'otx' ex juntl tu'n qMan Dios 
\p  
\v 13 Qa at jun kye ẍtij n-el tniky' te, in tyek'in tetz tuk'a tb'inchb'in, ex qa mutxin tu'njo n-el tniky' te.  
\v 14 Me qa tzunx nlo'chj kyanmi'n tuk'a iky'b'il, ex qa nkub' kyb'inchi'n tkyaqil tuk'a nimsb'il kyib'a; tu'ntzin ikyjo, mi tz'ok kyq'o'n kyib'tza te ẍtij, qala' ma chi txalpaja tojjo tumil, a twutzxix.  
\v 15 Qu'n nya te Dios te' ẍtijil ikyjo; ikytzin teku te xjaljo te twutz tx'otx' ex te tajaw il.  
\v 16 Qu'n ja'tzin ta'ye iky'b'il ex b'ujb'il; antza ta'ye tkyaqil wiq il, ja' nti'ye tumil. 
\p  
\v 17 Qalatzi'n kye', ma tzaj q'o'n kye kyẍtijil tu'n qMan Dios: Tnejil, saq kyanmin, ex nti' iky'b'il kyuk'iy; ex wen xjalqey; nti' nkyq'ma'n a nya wen, ex b'a'n tzaj q'aq'in kyk'u'ja; ex tuk'a tkyaqilx kywenila; ex at junch'in tumil kyu'n, ex nchi b'inchin wen.  
\v 18 Atzin ja'lintz, ayeqetzi'n kyaj tu'n tanq'in jun nuk'b'il kyxol, ilxix ti'j tu'n kyb'inchin wen, tu'ntzin kyk'monte a kyumil wen. 
\c 4  
\s1 Qmutxsinku qib' nej twutz qMan Dios, exsin qqanixjo a qaj 
\p  
\v 1 ¿Ja'tzin ntzaje jyoj q'oj ex yasb'il kyxola? Tu'ntzin kyajb'ila nya wen toj kyanmi'n.  
\v 2 Ayetzi'n, a kyaja jun ti', mi nknet kyu'n. Tu'npetzi'n, nchi b'iyini'y, exsin nlo'chj kyanmi'n ti'j jun ti', me nlayx jyet kyu'n. Tzunpen n-ok tilil kyu'n, ex nkub' kyb'inchi'n tu'n ttzaj q'oj, me nlayx jyet a kyaja. 
\p Kxel nq'ma'n kye'y: Nlay knet-xjo a kyaja, qu'n mina nxi kyqani'n te qMan Dios.  
\v 3 Ex qa ma txi kyqani'n, mina ntzaj tq'o'n Dios, qu'n ojtzqi'nqi'y noq tu'n tokin kyu'n te b'inchil il, a tze'nku kyaja.  
\v 4 Ayeqi'y werman, nyakuj nya nimilqi'y. ¿Ma nyatzin b'i'n kyu'n, a tu'n kyoka te tuk'a b'inchil il, a tze'nku nb'ant tu'n, tu'ntzin ikyjo, b'e'x kchi okila te tajq'oj qMan Dios?\x * \xo 4:4 \xt Is. 1:21; Jer. 3:6-10\x* Ikytzi'n a'lchaqx kye juntz, tu'n tok tuk'lin tib' tuk'a nya wen te twutz tx'otx', b'e'x n-ok te tajq'oj Dios.\x * \xo 4:4 \xt Mt. 6:24; Lc. 16:13\x* 
\v 5 Twutzxix te' Tu'jil Tyol Dios, qa n-ok tk'u'jlin Diosjo a qxew, a xkyij tq'o'n qojxi.\x * \xo 4:5 \xt Ex. 20:5; Deu. 4:24; Zac. 8:2\x* 
\v 6 Me lu' te Dios kmojil, te q'ol tumil, tze'nku ntq'ma'n Tyol. Chi' kyjalu'n: 
\q1 Njaw tiky'in te Dios kyuk'a a njaw kynimsin kyib', 
\q1 me metzin kyuk'a a mutxsin kyib', nchi tzaj tmojin.\x * \xo 4:6 \xt Pr. 3:34; 1Pe. 5:5\x* 
\s1 Qo laq'ex tk'atz qMan Dios; ikytzin k-elil oqe tajaw iljo qi'j 
\p  
\v 7 Tu'ntzi'n, kyq'onxsin kyib'tza toj tq'ob' qMan Dios, ex kyi'jlemila tajaw il. Ikytzi'n, k-elil oqjo kyi'ja.  
\v 8 Qalatzi'n, chi laq'exsin kye' tk'atz qMan Dios, ex ikytzin ktzajila laq'e Diosjo kyuk'iy. Ayi'y nche'xa b'inchil il, mina che'xa b'inchilte; ikytzin ktxjetila kyanminji'y; ex ayi'y, a kyaja tu'n tok kyk'u'jli'n qMan ex jni' at twutz tx'otx', kysaqsim kyib'a, tu'n tok kyanmi'n b'a'n twutz Dios.  
\v 9 I tjawje kyk'u'ja tu'n b'is. Chi oq'a. Kyna'nkuy tchib'l kyila o b'ant. Atzin kytzeb'la i tokin te ta'l kywutza, ex atzin kytzaljb'ila i tokin te b'isb'ajil.  
\v 10 Tunpetzi'n, kymutxinkutzin kyib'a twutz qAjaw. Ikytzin chi okileji'y te nim kyokli'n.\x * \xo 4:10 \xt Mt. 23:12; 1Pe. 5:6\x* 
\s1 A te qMan Dios kq'malte qa ma naj jun qerman ex nya awo 
\p  
\v 11 Ayi'y werman, mina chi yolb'i'n nya b'a'n ti'j junjun kye'. Atzin nyolb'in ikyjo, ikyx tze'nku nyolb'in ti'j kawb'il, noq tq'on tib' tze'nku jun kawil toj kawb'il, ex ma kyij ttzaqpi'n tkawb'il qMan Dios. Qatzin ma tz'ok tq'o'n tib'a ikyjo, a te ma tz'ok te kawil, qala' a te, tu'n tkub' niminte kawb'il.  
\v 12 Me qala', noq junch'in te s-aj q'onte kawb'il, o'kx Dios, ex ax Kawiljo. Tu'npetzi'n, at toklin Dios tu'n tkolin, ex a kq'malte qa ma naj erman, ex nya ay. 
\s1 Qa atx qchwinqil, ex qa tajb'il qMan Dios, okla kb'antiljo a qaj 
\p  
\v 13 Atzin ja'lin, kyb'intzinji'y lu'n te kye'y, ayi'y nchi q'mante kyjalu'n: Me me qe', qo ky'el qe' ja'lin mo nchi'j tu'n qxi'y toj jun tnam. Ex antza qo tenb'iliy jun ab'q'e tu'n qk'ayi'n, ex tu'n qkanb'i'n txqan qpwaqa, chi chiji'y. 
\p  
\v 14 ¿Ma b'i'ntzin kye kyu'n, ti' aku tzul toj kychwinqila nchi'j?\x * \xo 4:14 \xt Pr. 27:1\x* Ikytzin kye kychwinqil tze'nku muj te qlixje; at, aj t-xi qka'yin, me te jun paql, nti'l; otaq tz'el naj.  
\v 15 Qala', chi chi'tla kyeji'y kyjalu'n: Qa iky tajb'il qAjaw, ex qa atx toj qchwinqil, okla kb'antiljo a qaja. 
\p  
\v 16 Me metzin kye kyu'n, tzunxix nchi lab'te kye', tu'n kyyolb'i'n, ex tu'n tb'ant kyu'n kyjunala. Tkyaqilxjo lu'n, a nja kyi'n kyib'a, nya wen ikyjo.  
\v 17 Tu'npetzi'n, ankye te', a b'a'n b'inchin wen, ex qa mix kub' tb'inchin, ma kux te til ikyjo. 
\c 5  
\s1 Jun tqanil kye xjal q'inin 
\p  
\v 1 Kyb'i'ntzin ja'lin, ayeqi'y q'inin: Chi oq'a, ex chi ẍch'i'n, qu'n ktzajil jun kawb'il kujxix kyib'aja.  
\v 2 Ikytzi'n, ajo kyq'inimila ma q'ayj, ex ikyxjo, a kyxb'ali'n tb'anilx ma b'aj tu'n pok'.  
\v 3 Ajo q'anpwaq ex saqpwaq k'u'n kyu'n, ma ch'iy xul kyi'j, ex axsin q'olte kyqanilji'y te yuch'il kye'y, ex k-okil meltz'aj kyi'ja tze'nku jun q'aq' te kawb'il kujxix kyib'aja. Ikytzi'n, ma chi ok ten chmolte kyq'inimila; tzunx ok kyu'n tzma tzalu'n.\x * \xo 5:3 \xt Mt. 6:19\x* ¿Me mitzin b'i'n kyu'n, qa ch'ix tiky' twutz tx'otx'?  
\v 4 Nchi qanb'in kyaq'nila kyi'ja, tu'njo mi ẍi ex kychjo'n, tej tjaw kyawala.\x * \xo 5:4 \xt Deu. 24:14-15\x* Ex ma chi b'ijtey tu'n Dios, a tAjaw Tkyaqil.  
\v 5 Atzin kye' tzalu'n twutz tx'otx', ma kyli jun kye' kychwinqil toj tb'anilx, ex tze'nku kyaja, ikyqetzinji'y tze'nku jun ma nimxix wakx ma b'ant, tu'n tkub' b'yet.  
\v 6 Ex ikytzi'n kyu'n kyi'jqe nti' kypaj, nchi kux kyjpu'n toj tze, ex atku maj nchi kub' kyb'yo'n, me mi ẍi ok meltz'aj kyi'ja. Noqx kub' kyyo'nx kyib'. 
\s1 Tenxsin qk'u'j tu'n qayo'n tajb'il qAjaw, ajxi tul 
\p  
\v 7 Atzin kyetza, werman, qetzin kye' kyk'u'j tu'n kyayo'n tajb'il qMan Dios, tzmaxi aj tul qAjaw, ikytzi'n tze'nku jun aq'nil twutz tx'otx', il ti'j tu'n tayo'n ajxi tul jb'alil. Ajxi tak' ttx'otx' a'lexsin at tk'u'jjo tu'n tayo'n, tu'n tlonte tb'anil tawal.  
\v 8 Ikytzin kyeji'y tu'n tten kyk'u'ja tu'n kyayo'n, ex chi we'kuxixa toj kynimb'ila, qu'n ch'ix tul te qAjaw.  
\v 9 Ikytzin qu'n, werman, mina tz'ok kyq'ojlin kyib'a, tu'n mi chi okiy toj kawb'il. Ikytzi'n, ate Dios, a Kawil, nyakuj nq'olb'in toj tjpel ja, qu'n ch'ix tul twutz tx'otx'. 
\p  
\v 10 Ayi'y werman, kyna'nqetzinji'y aye yolil Tyol Dios ojtxe, tu'n kyok te jun yek'b'il qe ja'lin. Jni'xsin siky'x kyi'j, me ma ten kyk'u'j toj tkyaqil.  
\v 11 Ex ikyxjo qe ja'lin, ky'iwlinqoxixqe, qa ma qo we' twutz tkyaqiljo kky'elix qu'n. O tz'ok kyb'i'n ti'j tk'u'j Job, tu'n tayo'n tkyaqil tajb'il qMan,\x * \xo 5:11 \xt Job 1:21-22; 2:10\x* ex ma tz'ok kyb'i'n tze'nx tene tu'n tAjaw Tkyaqil tu'n tklet, tb'ajlinxitzi'n siky'x tu'n.\x * \xo 5:11 \xt Job 42:10-17\x* Ikytzi'n, tb'anilx te qAjaw, ex nimx tq'aq'b'il tk'u'j qi'j.\x * \xo 5:11 \xt Sal. 103:8\x* 
\s1 Qo yolin twutzxix, ex mi kub' qewin 
\p  
\v 12 Me atzin ja'lin, toj tkyaqil, ilxix ti'j tu'n qyolin toj ttxolil. Mi tzaj qq'olb'in tb'i kya'j, ex tb'i tx'otx', ex mix a'l tb'i juntl, tu'n qq'mante qa twutzx jun qyol. Qala', qa twutzxtaq jun ti', ex twutzx qyoltz; ex qa nya twutzx, exsinx minaxtz, tu'ntzin mi qo tzaj tkawin qMan Dios.\x * \xo 5:12 \xt Mt. 5:34-37\x* 
\s1 Qpa'nktz qil ex qo na'n Dios kyuk'a qerman 
\p  
\v 13 Qa at jun kyxola ma tzaj jun b'is ti'j, b'a'n tu'n tna'n Dios. Ex qa at jun at ttzaljb'il tuk'a, b'a'n tu'n tb'itzin b'itz te nimsb'il tb'i qMan Dios.  
\v 14 Ex qa at jun ma yab'te kyxola, b'a'n tu'n kytzaj ttxko'n nejinel kyxol Ttanim Dios, tu'n kyna'n Dios ti'j, ex tu'n tkyij kysu'n ch'in aseyt ti'j tplajjo yab' toj tb'i qAjaw.\x * \xo 5:14 \xt Mr. 6:13; Lc. 10:34\x* 
\v 15 Me ajtzin kyna'n Dios tuk'a kynimb'il, oktzin kwe'b'il yab', exsin a qAjaw k'wel q'aninte. Ex qa at til o tb'inche, ok k'wel najsin tu'n Dios.  
\v 16 Tu'npetzi'n, kypa'nktz kyila jun tuk'a juntl, ex chi na'n Diosa jun ti'j juntl, tu'ntzin tul Dios kye'y. Qu'n a tna'j Diosjo, a b'a'n nb'ete toj tumil, kb'antil nimku tu'n.  
\v 17 Ka'ntzin tejiy yolil Tyol Dios ojtxe, a Elías: Xjalx tze'nku qe xjalqo. Me atzi'n te' t-xi tqanin toj tna'j Dios, tu'n mi tz'etza jb'al tib'aj tx'otx', ex mix etze jb'al toj oxe ab'q'e tuk'a niky'jin.\x * \xo 5:17 \xt 1Re. 17:1; Lc. 4:25\x* 
\v 18 Tb'ajlinxitzi'n ikyjo, aq'e majl na'l Dios, tu'ntzin ttzaj jb'al; b'e'xsin tzaj q'o'n jb'altz tib'aj tx'otx', tu'n ttzaj tawal.\x * \xo 5:18 \xt 1Re. 18:1, 42-45\x* 
\s1 Qq'onx jun tumil te onb'il tu'n tja we'ks erman 
\p  
\v 19 Ayi'y werman, qa at jun o tz'el txalpaj ti'jjo tumil twutzxix, il ti'j tu'n ttzaj onit, tu'n tajtz meltz'aj.  
\v 20 B'i'nku kyu'n qa at jun kye' kxel onil ti'jjo ma txi' toj b'e nya wen, kkletil tanmin xjal tu'n, ex mi kyim tuk'a til. Atzin jni' til k'wel najsin ikyjo tu'n Dios.\x * \xo 5:20 \xt Pr. 10:12; 1Pe. 4:8\x*