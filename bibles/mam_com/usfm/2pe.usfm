\id 2PE - Mam, Central NT (SIL: mvc; ISO: mam) -Guatemala 2009 (DBL -2013) 
\h 2 Pegr 
\toc1 Tkab' Tu'j Pegr 
\toc2 2 Pegr 
\toc3 2Pe. 
\mt1 Tkab' Tu'j Pegr 
\ip A tkab' u'j lu'n tu'n Pegr noq o'kxtza nyoline te q'uqb'il kyk'u'j nimil tu'n tok kyka'yin kyib' ti'jjo tkyaqil xnaq'tzb'il, a nya b'a'n, ex ti'jjo b'inchj il, a otaq tz'oksin kyxol nimil ti'j qAjaw. N-ok tilil tu'n Pegr tu'n kywe'xix nimil toj kynimb'il ex toj xnaq'tzb'il, a ntzaj yek'in kyu'n a o kyli qAjaw tu'n kywutz. Qu'n at juntl xnaq'tzb'il nya wen, ex o b'ijte ntq'ma'n qa nya twutzx tu'n tul qAjaw juntl majl, qu'n atzin tq'ijil nb'ajik ex nb'ajik, ex nlay tzul juntl majl, chi chi'. 
\ip O tzaj xkye tu'j Pegr tuk'a jni' tb'anil tumil te kychwinqil nimil tze'nku nimb'il, tb'anil b'inchb'in, ex nab'l, ex tu'n kyjk'unte kyib', ex tu'n kyayon tuk'a q'uqb'il kyk'u'j tkyaqil tajb'il qMan, ex k'ulb'il twutz Dios, ex kyso'jil ex kyk'u'jb'il kyxolx (capítulo 1). Ex nchi el tiky'in a xnaq'tzil nya toj tumil (cap. 2), ex tu'n tb'aj ntzaj tna'n juntl majl ti'jjo twutzxix tulil qAjaw. Ntchiky'b'in ti'jjo tulil, a na'mx tb'aj, qu'n ate Dios taj tu'n ttzaj tq'o'n amb'il, tu'ntzintla kymeltz'aj tuk'a, ex tu'n tkyij kytzaqpi'n tu'n kyb'inchin il (cap. 3). 
\c 1  
\s1 Jun q'olb'il 
\p  
\v 1 Ayi'n Simun, a Pegr nb'i'y, jun taq'nil ex jun tsanjil Jesucristqi'n.\x * \xo 1:1 \xt Mt. 4:18; Mr. 1:16; Lc. 5:1-11\x* Kxel ntz'ib'inji'y u'j lu'n te kye'y, a ayi'y at jun kynimb'ila tb'anilx tze'nku qe', noq tu'n Dios, a qAjaw Jesucrist, a tz'aqlexix.  
\v 2 Noqit aku ch'iy t-xtalb'il Dios ex tnuk'b'il kyuk'iy, tu'njo ma tz'el kyniky'a ti'j Dios ex ti'j qAjaw Jesús. 
\s1 Qo b'et tojxix tumil twutz qMan Dios 
\p  
\v 3 Noq tu'n tipin Dios, ma tzaj tq'o'n tkyaqil, a at tajb'in qe, tu'n qb'et tojxix tumil tzalu'n twutz tx'otx' ex toj qanmin, noq tu'n ma tzaj tyek'in Dios tu'n tel qniky' ti'j Jesús, a tzaj txkonqe tu'n nimxix toklin ex tkyaqil twenil.  
\v 4 Ex noq tu'n tkyaqiljo lo, tzaj tq'o'n jun kujsb'il tyol, a nim t-xilin, ti'j tkyaqiljo wen, a taj tu'n tb'inchin qi'j, tu'ntzintla noq tu'njo yol lo, ma qo ok tz'aqle tze'nku te Dios, tu'ntzintla qel oq twutzjo tkyaqiljo nya wen, a tzajnin ti'jjo jni' achb'il te twutz tx'otx'. 
\p  
\v 5 Tu'npetzi'n, tz'okx tilil kyu'n, tu'n tok tz'aqsitjo kynimb'ila tu'njo kywenila, ex tu'n tok tz'aqsitjo kywenila tu'n kynab'la,  
\v 6 ex atzin kynab'la, tu'n kytzyu'nte kyib'a, ex atzi'n kytzuyb'il kyib'a, tu'n kukx tok tilil kyu'n toj kynimb'ila, ex atzin tu'n tok tilil kyu'n, tu'n kukx kyximi'n ti'j qMan Dios toj kychwinqila,  
\v 7 ex atzin kyximb'ila, tu'n kymujb'il kyib'a kyxolxa, ex atzin kymujb'il kyib'a, tu'n kyk'u'jlinti'y tkyaqil.  
\v 8 Qa ma ch'iy tkyaqiljo lo toj kychwinqila, nimxix kyajb'i'n te qMan Dios, ex nyaxla noq kukx s-el kyniky'a ti'j qAjaw Jesucrist.  
\v 9 Me ayetzin xjal, exla qa jun nimil, a nti'jo lo kyuk'a, noq o'kx n-el kyniky' ti'jjo te twutz tx'otx', ex ma tz'ok kyjpu'n kywutz ti'j Dios, ex ma tz'el naj toj kyk'u'j, qa o chi txjet tojjo kyil. 
\p  
\v 10 Tu'npetzi'n werman, qa ma chi txokli'y, ex qa ma chi jaw sk'o'n tu'n Dios, tz'okx tilil kyu'n, tu'n kykujixa tojjo lo, noq tu'n kyb'etin toj tumil. Qu'n qa ma b'ant kyu'n ikyjo, nlay chi kub' tz'aqa toj kynimb'ila tzalu'n twutz tx'otx'.  
\v 11 Ex nya noq o'kxjo, qala' ktzajil tq'o'n jun q'olb'il kye'y tu'n kyokxa toj kya'j te jun majx, ja' nkawin Jesucrist, a qAjaw ex Klolqe. 
\p  
\v 12 Tu'npetzi'n, kukx nxi nna'nji'y ti'j tkyaqiljo lo, tu'ntzintla kukx kyweji'y toj kynimb'ila, noq tu'njo yol twutzxix, a at kyuk'iy.  
\v 13 Qu'n at wokli'n tu'n kyxi nk'asi'n toj kynimb'ila kyu'njo tumil lo, a na'mxtaq nkyima,  
\v 14 qu'n a qAjaw Jesucrist o q'mante we'y qa ch'ix tpon q'ij tu'n nkyima.  
\v 15 Tu'npetzi'n, tok tilil wu'n, tu'n t-xi nq'ma'n kye'y tu'n mi tz'el nnaje tkyaqiljo lo toj kyk'u'ja, aj wiky'a tzalu'n twutz tx'otx'. 
\s1 Twutzxix te' Tyol Dios 
\p  
\v 16 Qu'n atzin xnaq'tzb'il xi qq'o'n kye'y ti'jjo tipin ex tulil qAjaw Jesucrist, nya noqx kyyolxjal te sb'u'b'l. Qala', ma tz'ok qka'yin qAjaw tuk'a tkyaqil tipin kyu'nkuxix qwutza.  
\v 17 Qu'n qli'y qa nimxix toklin Jesús, ex nimx tqoptz'ajiyil, te' t-xi tq'ma'n Dios, a wenxix ex nimxix tb'i: Apen weji'y nk'wal, k'u'jlin wu'n, a nchin tzalaja ti'jch.  
\v 18 Qu'n ajinqo'y o qo b'in te tyol, a tzaj toj kya'j, qu'n oto'taqa tuk'a tib'ajjo wutz xjanxix.\x * \xo 1:18 \xt Mt. 17:1-5; Mr. 9:2-7; Lc. 9:28-35\x* 
\p  
\v 19 Qu'n tu'n tkyaqiljo ma qli'y, atzin ma kujsin te' kyyol yolil Tyol Dios, aye i k'monte Tyol ojtxe. Tu'npetzi'n, b'a'n tu'n t-xi kyq'o'n amb'il ti'jjo yol lo tu'n kykleta, ikyx tze'nku nxi kyq'o'n amb'il ti'j jun tzaj nk'ant toj qxopin, tzmaxi aj tul Jesús juntl majl tze'nku jun ak'aj q'ij. Ex atzin ja'lin, antza ta' Jesús toj kyanmi'n nqoptz'aj tze'nku che'w ma tij, a nyek'in qa ch'ix tul tq'ijil.  
\v 20 Tu'npetzi'n, ilxix ti'j tu'n tel kyniky'a ti'jjo lo: Qu'n nti' junte yol tz'ib'in toj Tyol Dios, a aku pjet tu'n jun xjal noq tze'nku taj.  
\v 21 Qu'n ayetzin yolil Tyol Dios ojtxe, mi ẍi yolin a tze'nkuxtaqjo kyaj tzalu'n twutz tx'otx'. Qala' ayetzin ichin lu'n i yolin, ex kub' kytz'ib'in tze'nkuxtaqjo taj Dios, qu'n q'i'nqetaq tu'n Xewb'aj Xjan. 
\c 2  
\s1 Aye xnaq'tzil nya toj tumil 
\r (Jud. 4-13) 
\p  
\v 1 Qu'n ikytaqtzi'n ojtxe, attaqxjal nyakuj yolil Tyol Dios kyxol aj Judiy, a nya twutzx; exsin ikyxjo ja'lin kyxola. At xnaq'tzil, a nya twutzx kyyol. Ex cheb'e nchi xnaq'tzin noq kyximxjal, a aku qo naj tu'n. Ex n-el kyi'n toklin qAjaw, a xkotpinkye toj il. Noq tu'njo lo, liwey kchi najil te jun majx.  
\v 2 Nimxjal nxi lipe kyi'j, noq tu'n nxi kyq'o'n amb'il tejo kyachb'il. Ex noq tu'njo lo, nchi yolb'inxjal nya b'a'n ti'jjo qnimb'il, a aku Tb'anil Tqanil twutzxix.  
\v 3 Noq kyaj tu'n kykanb'in pwaq kyi'ja; kyaj tu'n kykub' sb'u'n kyu'n, tu'n jun xnaq'tzb'il kyeku. Me kchi najil te jun majx, qu'n atxix ojtxe b'antnin ti'j tu'n kynaj. 
\p  
\v 4 Qu'n mipe xkub' tnajsin Dios kyil angel xkub' kyb'inchin, aye o chex lipe ti'j tajaw il; qala' ma chex t-xo'n toj najin, ex ma chi kyij ttzaqpi'n toj qxopin, k'lonqe tu'n kxb'il, tzmaxi aj tpon tq'ijil pa'b'in.  
\v 5 Ex mixpe kub' tnajsin Dios kyilxjal ojtxe, a nya wenqe; qala' tzaj tsma'n nimku a' kyib'aj, tu'n kykyim. Me o'kx Noé klet kyuk'a wuq tuk'a, qu'n wen te Noé, ex nyolintaq ti'j jun chwinqil jikyin.\x * \xo 2:5 \xt Gen. 6:1–7:24\x* 
\v 6 Ex xi tq'o'n Dios qanb'il tib'aj xjal kyojjo tnam Sodoma ex Gomorra, noq tu'n ttz'e'y te jun majx,\x * \xo 2:6 \xt Gen. 19:24\x* tu'n kyok te jun yek'b'il ja'lin ti'j ti' kb'ajil kyi'jjo tkyaqil xjal, a nya wenqe.  
\v 7 Me o'kx Lot klet kyxol, a jun ichin wentaq, qu'n ma tzaj tb'is, te' tok tka'yin kychwinqiljo xjal aj ilqe.\x * \xo 2:7 \xt Gen. 19:1-16, 29\x* 
\v 8 Qu'n atzin ichin b'a'n, a najle kyxol, tzun nb'isintaq toj tanmin junjun q'ij ti'j tkyaqil il n-ok tka'yintaq, ex n-ok tb'i'ntaq kyu'nxjal, aye' a nya tzyu'n kyib'.  
\v 9 Ikytzi'n, b'i'n qu'n qa nchi kletjo xjal tu'n qAjaw, tojjo tkyaqil n-iky'x kyi'j, qu'n q'o'n kyib' te. Me meqetzin kye, a nchi b'inchin nya wen, ite'kx tjaq' tkawb'il Dios ja'lin, ex aj tul tq'ijil pa'b'in, kchi xe'l toj najin te jun majx.  
\v 10 Ex kkawil Dios kyib'ajjo a lipcheqex ti'jjo kyachb'il, a ojtxe kyten, ex n-el kyi'jlin alkyechaqku kyoklin kawil. Ma kuj kynab'l, ex njaw kynimsin kyib'. Nti' kyxob'il tu'n kyyasin kyi'j angel ex jni' taq'nil tajaw il.  
\v 11 Me meqetzin kye' t-angel Dios, exla qa nimxix kyoklin ex nimxix kyipin, nti' n-okx kyq'o'n kyib' tu'n kypatin, ex tu'n kyyasin kyi'jjo tajaw il ex jni' nmaq tkawb'il.  
\v 12 Me ayetzin xjal lo, nchi yasin kyi'jjo a mi n-el kyniky' te. Nti' kynab'l, qala' ikytzin kyte'n tze'nqeku txuk toj k'ul, a il ti'j tu'n kyok tzyet, ex tu'n kykub' yuch'it te jun majx.  
\v 13 Ok ktzajil nya wen kyib'aj tu'n Dios, tu'n kyb'inchb'in nya wen. Qu'n toj kywutz, jun tzaljb'il tu'n nxi kyq'o'n kyib' jun paqx tze'nku ntqanin tachb'il kyxmilil. Ayejo xjal lu'n, jun tx'ixwejil ex jun tz'il kyxola, qu'n exla qa nchi wa'n kyuk'iy kyxol Ttanim Dios, me nchi jyo'n tumil tu'n kyok lipe ti'j b'inchj il.  
\v 14 Qu'n tkyaqil qya, aj tok kyka'yin, n-el kyanmin kyi'j tu'n kyky'a'jin kyuk'a, ex mi nchi sikyte tu'n kyb'inchin aj pajil. Ex kukx nchi xmoxin kyi'jjo a nya kujqe toj kynimb'il. At-xix kynab'l tu'n tpon kyk'u'j ti'j ti'chaqku, me at tqanb'il Dios kyib'ajjo xjal lu'n.  
\v 15 Qu'n ma chi naj noq tu'n ma chi el txalpaj ti'jjo b'e jikyin. Ex ma chi ok lipe ti'jjo tumil tu'n Balaam ojtxe, a tk'wal Beor, a tajtaq tu'n tkanb'in pwaq noq tu'n jun tumil nyakuj tzajnin te Dios.  
\v 16 Me b'e'x ok miyo'n tu'n Dios ti'jjo til, noq tu'n tyoljo bur, a mib'in yolin. Me tu'n Dios, b'ant tyolin tze'nku jun xjal noq tu'n twe' a kab'e tk'u'j Balaam.\x * \xo 2:16 \xt Num. 22:4-35\x* 
\p  
\v 17 Me ayetzin xnaq'tzil nya wen lu'n ikyqetzi'n tze'nku jun xoch nti' a' toj, qu'n nti' Tyol qMan kyuk'a; ex tze'nku jun muj iqin tu'n kyq'iq', a jun paqx n-iky'. Me ma kub' tqanb'il Dios kyib'aj, a tu'n kyten toj manyor qxopinx te jun majx.  
\v 18 Qu'n nchi yolin tuk'a jun yol tb'anilx, noq tu'n kynimsin kyib', me nti' tajb'in kyxnaq'tzb'il. Qu'n noq kyu'n kytzeq ex jni' achb'il, a ntqanin kyxmilil, kyaj tu'n kyxmoxin kyi'jxjal, a nya kujqe toj kynimb'il, aye' tzmaqe n-el kypa'n kyib' kyi'jjo b'inchil il.  
\v 19 Aye xnaq'tzil lo nchi suqin jun chwinqil te tzaqpib'l nyakuj tb'anilx wen, a nya il ti'j tu'n tkub' kynimin alkye nuk'b'il. Me ayekupekye ma txi kyq'o'n kyib' toj tkyaqil kyachb'il, me nti' tumil tu'n kytzaqpaj. Qu'n tu'n nti' kytzaqpib'l, qa ma chi kub' tu'njo jun ti', ex ayetzin kye xnaq'tzil lo ma chi kub' tu'nxjo kyil.\x * \xo 2:19 \xt Jn. 8:34; Ro. 6:6, 16\x* 
\v 20 Me ayetzin kye', a o tz'el kyniky' te qAjaw ex Klolqe Jesucrist, ma chi tzaqpaj kye' te tkyaqiljo nya wen te twutz tx'otx'. Me qatzin qa ma txi kyq'o'n kyib' tu'n kymeltz'aj juntl majl toj il, ma chi kub' tu'n, ex nimxixla tqanb'il Dios kyib'aj, a tze'nku tej na'mtaq kynimin.\x * \xo 2:20 \xt Mt. 12:45\x* 
\v 21 Wenxitla kye xjal lu'n, noqit mi s-el kyniky' ti'jjo Tb'anil Tqanil, a twutzxix, tze'nku tu'n tel kyniky' tejo a xjan Tyol Dios, ex tu'n tel kypa'n kyib' ti'jjo a saj tq'ma'n kye.  
\v 22 Me noq tu'n kymeltz'aj juntl majl tojjo ojtxe kyten, ma japin te' kyyolxjal lu'n kyi'j: Ma meltz'aj tetx'yan juntl majl wa'l te' t-xab';\x * \xo 2:22 \xt Pr. 26:11\x* ex ikyxjo te kuch: Akxtaq tb'aj txjet ti'j, ma txi' juntl majl tolil tib' toj xoq'lch. 
\c 3  
\s1 A tulil qAjaw juntl majl 
\p  
\v 1 Ayi'y werman k'u'jlinqi'y wu'n, atzin lu'n tkab' wu'ja kxel ntz'ib'i'n kye'y. Kyojjo kab'e u'j wajtaqa tu'n kyxi' nk'asi'n toj kyanmi'n tu'n kyximi'n tuk'a tumil.  
\v 2 Ex kyna'ntzinji'y kyyoljo xjan yolil Tyol Dios, aye i k'monte Tyol ojtxe, kyi'jjo xnaq'tzil nya wen, ex ikyxjo atzin nuk'b'il kyij tq'o'n qAjaw ex Klolqe Jesús noq kyu'n tsanjil, a q'uqle kyk'u'ja kyi'j. 
\p  
\v 3 Ilxix ti'j tu'n tel kyniky'a te, qa aj ch'ixtaq tjapin b'aj tq'ijil tzalu'n twutz tx'otx', chi ul xmaẍ kyxola, a nchi b'et tze'nku ntqanin ojtxe kyten.\x * \xo 3:3 \xt 2Tim. 3:1-5; Jud. 18\x* 
\v 4 Ex okla kyq'ma': ¿Nta'tzintz qa tzul Crist juntl majl? Axla twutz mila tzulxte. Qu'n qa ma tzul Crist klol kye' toj Ttanim, ¿Tiqu'ntz nb'aj kyimik nejinel qxol? Qu'n kyka'yinktzin: Tkyaqilx te ikyx tten tze'nkuxjo tzaj xkye twutz tx'otx' te tnejil, chi chi'.\x * \xo 3:4 \xt Ez. 12:22\x* 
\p  
\v 5 Me noq tu'n kyky'e' tu'n tel kyniky' te, ex tu'n tzaj kyna'n, qa nya ikyx te tten tze'nkuxjo tzaj xkye ojtxe. Qu'n noq tu'n Tyol Dios, kub' tb'inchin kya'j, ex kub' tb'inchin tx'otx' toj tk'u'j a', ex tu'n a' tzaje tq'o'n Dios kychwinqil tkyaqil twutz tx'otx'.\x * \xo 3:5 \xt Gen. 1:6-9; Sal. 24:2\x* 
\v 6 Me tu'nxjo a', kub' tyuch'in Dios tkyaqil.\x * \xo 3:6 \xt Gen. 7:11-24\x* 
\v 7 Ex ikyxjo ja'lin, atzin kya'j exsin tx'otx' k'u'nqe tu'n tyuch'it tu'n q'aq' tu'nxjo Tyol Dios. Tojjo q'ij anetzi'n, ktzajil tkawb'il Dios kujxix wen kyib'aj tkyaqil aj il. Ok kchi najil te jun majx. 
\p  
\v 8 Ex ayi'y werman, mi tz'el naj toj kyk'u'ja, qu'n toj twutz qAjaw jun q'ij iky n-ele tze'nku mil ab'q'e, ex mil ab'q'e iky n-ele tze'nku jun q'ij.\x * \xo 3:8 \xt Sal. 90:4\x* 
\v 9 Nya noq tu'n ky'ajte Dios tu'n tjapin Tyol tu'n, tu'n tul Crist, tze'nku nkyq'ma'n junjun. Qala' n-ayon tu'n kyb'inchinxjal kyten, qu'n nya taj tu'n kynajxjal, qala' tkyaqilx tu'n kytx'ixpinte kychwinqil.\x * \xo 3:9 \xt Ez. 18:23\x* 
\p  
\v 10 Me metzin te' tq'ijil qAjaw, ilxix ti'j tu'n tul. Me nti' tqanil, tze'nku tulil jun ileq' toj qniky'in.\x * \xo 3:10 \xt Mt. 24:43; Lc. 12:39; 1Tes. 5:2; Tchi. 16:15\x* Antza kky'ele kya'j, njulin wen, ex tkyaqil ktz'e'yil tu'n q'aq'. Ex tkyaqil kyb'inchb'inxjal kyjel chiky'b'it twutz qMan Dios toj pa'b'in.  
\v 11 Axla twutz ok kb'ajil te' ikyjo. Tu'npetzi'n, il ti'j tu'n kyb'eta tuk'a jun kychwinqila xjanxix ex tz'aqle.  
\v 12 Ex kyyonkutzinji'y tq'ijil Dios tuk'a tzaljb'il, ex kyb'inchinkuy tajb'il, tu'ntzintla tzaj laq'e tq'ijil, ja' tu'n tb'aje kya'j tu'n q'aq', ex tkyaqiljo at, k-elil oq' toj taq' q'aq'.  
\v 13 Me metzin qe tzun nqo ayo'n ti'j jun ak'aj kya'j ex jun ak'aj tx'otx', a o tq'ma Dios,\x * \xo 3:13 \xt Is. 65:17; 66:22; Tchi. 21:1\x* a ja' ktenb'ile' tkyaqiljo wen te jun majx. 
\p  
\v 14 Tu'npetzi'n, ayi'y werman, k'u'jlinqi'y wu'n, a na'mxtaq tkanin tq'ijiljo lo, kyq'onka tilil tu'n kyb'eta tz'aqle ex tuk'a tumil, ex tuk'a tnuk'b'il Dios toj kychwinqila.  
\v 15 Tz'eltzin kyniky'a te, qa ajo oyb'il te Dios tu'n tul juntl majl, noq tu'n tzaj tq'o'n amb'il tu'n kyklet-xjal. Qu'n ikyxjo o kub' ttz'ib'in erman Pabl, a k'u'jlin qu'n, tuk'a tkyaqil tnab'l, a xi tq'o'n Dios te.  
\v 16 Qu'n toj tu'j, nim o yolin ti'jjo lo. Ex atku maj, kuj ch'in tu'n tel qniky' te, ex ayetzi'n nya kuj toj kynimb'il exqetzi'n nya jikyin kynab'l, nkytx'ixpin aye tu'j Pabl, ikyxjo tze'nku txqantl Tyol Dios, noq tu'n tok tze'nkuxjo kyaj. Me ok kchi najil tu'n ikyjo. 
\p  
\v 17 Ayi'y werman, k'u'jlinqi'y wu'n, ma kyb'i'y tkyaqiljo lo. Tu'npetzi'n, kyka'yinktzin kyib'a, tu'ntzintla mi chi oka lipe'y kyi'jjo xnaq'tzb'il, a sb'u'b'l ex kyi'j xjal, a mi kytzyu'n kyib', tu'n mi chi kub'e tz'aqi'y tojjo kyokli'n, a kynimb'ila jikyin wen.  
\v 18 Qala' chi ch'iyxa toj t-xtalb'il Dios ex toj kyojtzqib'la ti'jjo qAjaw ex Klolqe Jesucrist; nimxit tb'i ja'lin ex te jun majx. Ikyxitjo.