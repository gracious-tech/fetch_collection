<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="REV" style="id">- Gayil New Testament</book>
  <para style="h">ለምለም</para>
  <para style="toc1">ዮሀንሰታ ለምለም ጋይድንካ ሰድንና</para>
  <para style="toc2">ለምለም</para>
  <para style="toc3">ለም.</para>
  <para style="mt1">ዮሀንሰታ ለምለም ጋይድንካ ሰድንና</para>
  <para style="imt1">አርድንታ</para>
  <para style="ip">ዮሀንስ ለምለም ጋይድንካ ሰደሮ ክት ጻፍሳንዳ ክርስቶሳር ማችባብከስ የሱስ ክርስቶስ ኬታ ጮይስ ማትንተን ከት አሜንሳንጎካ ዳይርኬ ማጠካ ኬታዘን የልድ Ꮊቃንደትኬ። ኖ ጻፍና ኡርስት ክት ሰዳንዳ ናበብድባብከስም ኬታ Ꮊድን ጉርምና ቦድማ ማተርንግንዳ ዛብስካንተኬ ኬታዘን የልሳን ዳይርናርንኬ ማጠናር ከታ ይንታ አመንካ ከት ዳቅድንግንዳ ከትም ዛብስካንቴ።</para>
  <para style="ip">ማጻፍን ኮትኮታር ስግ ካርዘን በድካ ሰድምድንደትኬ ለምለም ጋይድንካ ክክ ካርካ የጃንደትም ሰድምድንዳ Ꮊቄ፥ ኬታኬና ለምለም ጋይድንካ ሰድምስባብከሰረ ኮትኮ ስለናር Ꮊቅባብ አሜንድባብከስ ከት ኤስካንታ ማድንዳ፥ አብንከስ ማቼ አቼካ ማትሶ ዶቅድንዳ ሪንከስታ ካምስካ ኬዝምሳንዴ። የችንታ ኤልስና ካርንካ ካርንካ ጋይምድንደትግንዳ ኮትኮ ማጻፍንታ የድንተንከስ Ꮊክ Ꮊክ ለምለም ጋይድንካ ሰድምሳን Ꮊክ Ꮊክ ካምስካ ማስት ማስት ሰጅዴ። ማጻፍንታ ቡልንጎከረ Ꮊክ Ꮊክ ገቀር ዶቅስንከረ አፍይ ማድን ኬዘና መዬ፥ ኮነረ ሳብ፥ ጮይስ ክርስቶስጎካ አናካርንካ ይይምዳክኖጎግካ ዋልቃዱትካንተኬ በእንታ ማድንግንዳ ሰጣንምኬ ይምኤንባብከስመረ ሙዳ ጉጅሶ ጋምዴ፥ ጋምንተነረ በእንተዘን የልሳንደትካ አሜንምስባብ ማችባብ ኮችንከስካንታ ክላ ጭለንተኬ ክላ ፍጨንታ አንጀንም ከት ተይድንግንዳ ይስዝዴ ጋይድንዴ።</para>
  <para style="iot">ማጻፍን ኮትኮታ ሙዳ የድንተና</para>
  <para style="io1">አርድንታ <char style="ior">(<ref loc="REV 1:1-8">1፡1-8</ref>) </char></para>
  <para style="io1">ለምለም ጋይድንደታ ፎችምንኬ ታብዛ Ꮊክ Ꮊክ ምክስ ኤሄንካንታ ኦይትምሳን ክቴና <char style="ior">(<ref loc="REV 1:9-20">1፡9-20</ref>) </char></para>
  <para style="io1">ማጻፍንኬ ታብዛ ማይተምንከስታ ፍርደና <char style="ior">(<ref loc="REV 4:1-8:1">4፡1—8፡1</ref>) </char></para>
  <para style="io1">ታብዛ ፍርደንከስታ ፍቼንከስ <char style="ior">(<ref loc="REV 8:2-11:9">8፡2—11፡9</ref>) </char></para>
  <para style="io1">ቃርንኬ ሰንፓ ዶቅድን ቃስቴን ፍዝርንከስ <char style="ior">(<ref loc="REV 12:1-13:18">12፡1—13፡18</ref>) </char></para>
  <para style="io1">Ꮊክ Ꮊክ ሰድምሳን ለምለምንከስ <char style="ior">(<ref loc="REV 14:1-15:8">14፡1—15፡8</ref>) </char></para>
  <para style="io1">ሳብታ ታብዛ ዋጭንታ ኡፍተንከስ <char style="ior">(<ref loc="REV 16:1-21">16፡1-21</ref>) </char></para>
  <para style="io1">ባብሎን ካተመንታ ካይንታ፥ ባችርንታ፥ ሳብዘንካ ኤሰራክዶቆ ኬዝድባብ ካርከንባብኬ ዳብሎሰታ ጋምርና <char style="ior">(<ref loc="REV 17:1-20:10">17፡1—20፡10</ref>) </char></para>
  <para style="io1">በእንታ ፍርደና <char style="ior">(<ref loc="REV 20:11-15">20፡11-15</ref>) </char></para>
  <para style="io1">ክላ ጭላ፥ ክላ ፍጨና፥ ክላ የሩሳሌም ካተመና <char style="ior">(<ref loc="REV 21:1-22:5">21፡1—22፡5</ref>) </char></para>
  <para style="io1">በእንታ <char style="ior">(<ref loc="REV 22:6-21">22፡6-21</ref>) </char></para>
  <chapter number="1" style="c" sid="REV 1"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1"/>ኮና ለምለም ጋይድንካ ሰድምድንዳ ቅንች ሰጫር ይይምድን ሪም ይንታ ፍክስንባብከስካንታ ሰጅድንግንዳ ሳብ የሱስ ክርስቶስካንታ እምሳንዴ። የሱስ ክርስቶሰረ ይንታ ክታይንችንም ኦይትሶ ይንታ ፍክስንንባብ ዮሀንስካንታ ኮትኮም ለምለም ጋይድንካ ሰድምድንደትም ክትካንታ መያ ማስሴ። <verse eid="REV 1:1"/><verse number="2" style="v" sid="REV 1:2"/>ዮሀንሰረ ሳብታ ቃለንጎኬ የሱስ ክርስቶስ ኤስሳን ዶፈንንጎካ ኮትኮግንደረ ይ ሰጃን ሪንጎካ ሙዳ ማርከርሴ። <verse eid="REV 1:2"/><verse number="3" style="v" sid="REV 1:3"/>ኮና ሙዳ ቦድምድንደታ ሰጨና ቅንች ማቻንካንታ ኮትኮም ቤር ቃለንም ናበብድባብ አንጅምስባቤ! ኮትኮግንደረ ቤር ቃለንም ኤሰርድባብኬ ኮታር ጻፍምሳንደትም ቦድባብከስ አንጅምስባብከሰኬ።<verse eid="REV 1:3"/></para>
  <para style="s1">ታብዛ ምክስ ኤሄንካንታ ኦይትምሳን ሳራትች</para>
  <para style="p">
    <verse number="4-5" style="v" sid="REV 1:4-5"/>ዮሀንስዘንካ ታብዛ እስያ ፍጨናር ዶቅድን Ꮊክ Ꮊክ ምክስ ኤሄናር ኤድንከስካንታ፥ ታ ዶቅድባብዘንኬ ኤንገርንካ Ꮊቅባብዘንካ፥ አና ክት Ꮊድባብ፥ ባንችምሶ ክት ዶቅሳን ጎንገንታ እሪ ዶቅድባብ ታብዛ አያንንከዘንካ፥ ኮትኮግንደረ ደእናርንካ አምንተካ ዳነዝ ማችባብ ፍጨዘን ባንችንከስም ቆልድባብ፥ አሜንምስባብ ማርካ ማችባብዘንካ፥ ዎም ሶልምድባብዘንኬ ይንታ ማቀስንካ ዎንታ ጎመናርንካ ባዛካይሳ ዎም ዉችስባብ የሱስ ክርስቶስዘንካ ዉች እምንተንኬ ሳራትቼና የካንታ ማታ።<note caller="-" style="x"><char style="xo" closed="false">1፡4-5 </char><char style="xt" closed="false"><ref loc="EXO 3:14">ዉት. 3፡14</ref>፤ <ref loc="REV 4:5">ለም. 4፡5</ref>፤ <ref loc="ISA 55:4">ኢሳ. 55፡4</ref>፤ <ref loc="PSA 89:27">የቺ 89፡27</ref>። </char></note> <verse eid="REV 1:4-5"/><verse number="6" style="v" sid="REV 1:6"/>የሱስ ክርስቶስታ ባቤን ሳብም ዎ ክትካንታ ፍግዝድንግንዳ ባንችንከስኬ ቄሰንከስ ዎም ማስስባብ፥ የሱስ ክርስቶስካንታ ስለንክንደትዘንካ ስለንክንደታ የለልታ ቦንቼኬ ዎልቀካ ክትካንታ ማታ! አምንኤ።<note caller="-" style="x"><char style="xo" closed="false">1፡6 </char><char style="xt" closed="false"><ref loc="EXO 19:6">ዉት. 19፡6</ref>፤ <ref loc="REV 5:10">ለም. 5፡10</ref>። </char></note><verse eid="REV 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 1:7"/>ኮሰቸቴ፥ ኡፔካ ኖ Ꮊተሬ፥ ክትም እክስባብ ኤድንከስ ዎራ ነጋከክዶቆ ኤድ ሙደናክትም ሰተረኬ፥ ፍጨዘነረ ዎርሰንከስ ሙደና ክትጎካ ኤፍተረኬ። ኮና ሪና ዶፈኔ። አምንኤ።<note caller="-" style="x"><char style="xo" closed="false">1፡7 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳን. 7፡13</ref>፤ <ref loc="MAT 24:3">ማቶ. 24፡3</ref>፤ <ref loc="MRK 13:26">ማር. 13፡26</ref>፤ <ref loc="LUK 21:27">ሉቃ. 21፡27</ref>፤ <ref loc="1TH 4:17">1 ተሰ. 4፡17</ref>፤ <ref loc="ZEC 12:10">ዘካ. 12፡10</ref>፤ <ref loc="JHN 19:34">ዮሀ. 19፡34</ref>፥<ref loc="JHN 19:37">37</ref>። </char></note><verse eid="REV 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 1:8"/>ታ ዶቅድባብ፥ ኤንገር Ꮊቅባብከ፥ Ꮊድባበረ ሙደንም ጋምድባብ ጮይስ ሳብና “እሪነረ ቡርነረ እትቴ!” ጋይዴ።<note caller="-" style="x"><char style="xo" closed="false">1፡8 </char><char style="xt" closed="false"><ref loc="REV 22:13">ለም. 22፡13</ref>፤ <ref loc="EXO 3:13">ዉት. 3፡13</ref>። </char></note><verse eid="REV 1:8"/></para>
  <para style="s1">ክርስቶስ ለምለም ጋይድንካ መያ ማትና</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 1:9"/>የሱስጎካ ማጠንምኬ ክታ ባንችምንታ ኮትኮግንደረ ዳንዳእንም የንካ ክክን ካስምድባብ እታ የንታ እስመን ዮሀንስ ሳብታ ቃለኬ የሱሰታ ማርካትቼንጎካ ፍጥሞ ጋይምድን ሎቀታ ዎክናር ዶቅድን ደንንዘን Ꮊቃቴ። <verse eid="REV 1:9"/><verse number="10" style="v" sid="REV 1:10"/>ጮይስታ ሰጨናይካ አያን ጭልንታ ገቅርናር ማትስቶ እ ዶቅድንካ ፍቻ ፉገርድንደትግንዳ ካምድንዳ አንድር ኡፍስ እስታ ቡርጎካ፥ <verse eid="REV 1:10"/><verse number="11" style="v" sid="REV 1:11"/>“የስካንታ ሰድምድንደትም ማጻፍናር ጻፍሰዮ ታብዛ Ꮊክ Ꮊክ ምክስ ኤሄንከሳር ኤድንከስካንታ ጋይንተነረ ኤፈሶን፥ ሰመነረሳር፥ ጰርጋሞናር፥ ትያጥሮናር፥ ሰርዴሳር፥ ፍላድልፍያርኬ ሎዶቃር ኦይትካ” ኩን ጋይድንካ ኤሰርሳቴ።<verse eid="REV 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 1:12"/>Ꮊይ እም ኬዛናንከረ ኤስካንታ ኦስ እስታ ቡር ዋልን ጋይስቴ፥ ዋልን እ ጋይሳንደትከረ ዎርቀካ ኡርሰርሳንዳ ታብዛ ዞጰንከስም ዎደርድንደትም ሰድቴ። <verse eid="REV 1:12"/><verse number="13" style="v" sid="REV 1:13"/>ዞጰንከስም ዎደርድንደታ ግድናር ኤድ ይንችም ካምድባብም ሰድቴ፥ ኖየረ ይንታ ዱትን የለልታ የልድን ቃልም አፍላ ቆበርስባብ፥ ይንታ ኦንገዝንም ዎርቀካ ኡርሰርሳንደትካ አሜችባብ Ꮊቄ።<note caller="-" style="x"><char style="xo" closed="false">1፡13 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳን. 7፡13</ref>፤ <ref loc="DAN 10:5">10፡5</ref>። </char></note> <verse eid="REV 1:13"/><verse number="14" style="v" sid="REV 1:14"/>ክታ ቃደንኬ ክታ ማተነረ አዝግንደኬ፥ ጫምሳ አፍለንግንዳ Ꮊቄ፥ ክታ አፍንከሰረ ኖሄታ ሎግንችግንዳ Ꮊቀኬ።<note caller="-" style="x"><char style="xo" closed="false">1፡14 </char><char style="xt" closed="false"><ref loc="REV 7:9">7፡9</ref>፤ <ref loc="REV 10:6">10፡6</ref>። </char></note> <verse eid="REV 1:14"/><verse number="15" style="v" sid="REV 1:15"/>ክታ ዱትንከሰረ ኖሄታ ዎልስማር ዘይሳን ጋይንም ካምደኬ፥ ክታ ኡፍስነረ አንድር ሎቃ ሶረንታ ኡፍስግንዳ Ꮊቄ፥<note caller="-" style="x"><char style="xo" closed="false">1፡15 </char><char style="xt" closed="false"><ref loc="EZK 1:24">ሕዝ. 1፡24</ref>፤ <ref loc="EZK 43:2">43፡2</ref>። </char></note> <verse eid="REV 1:15"/><verse number="16" style="v" sid="REV 1:16"/>ይንታ ምዝ አንንካ ታብዛ ቤዝንከስም የድሶ Ꮊቄ፥ ቃስተንንጎካ ቃርድንዳ ማሳ ክታ አፋርንካ ዉድ Ꮊቄ። ክታ ባለነረ ሙዳ ሳግድን Ꮊይግንዳ Ꮊቄ።<verse eid="REV 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 1:17"/>ክትም እ ሰጃንደትካ ደእስባብ ኤድግንዳ ማትስቶ ክታ ዱትንታ ጎያር ዋችቴ፥ ኖ ማቼ ይንታ ምዝ አንንም እዘን ዎድሶ፥ “Ꮊይጳሴ፥ እሪነረ ቡርነረ እትቴ፥ ኩን ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">1፡17 </char><char style="xt" closed="false"><ref loc="ISA 44:6">ኢሳ. 44፡6</ref>፤ <ref loc="ISA 48:12">48፡12</ref>፤ <ref loc="REV 2:8">ለም. 2፡8</ref>፤ <ref loc="REV 22:13">22፡13</ref>። </char></note> <verse eid="REV 1:17"/><verse number="18" style="v" sid="REV 1:18"/>እታ ሰንፔካ ዶቅድባብቴ፥ ደእትት ዶቆ፥ ኬዛር ማቼ ይና እታ ስለንካ ዶቅድባብቴ፥ ደእንዘንኬ ጩልጩል ጎርንዘን ገችታ ኤራ እስታ ዶቅዴ። <verse eid="REV 1:18"/><verse number="19" style="v" sid="REV 1:19"/>ይና የስ ሰዳንደትም፥ ታ ዶቅድንደትምኬ ኮታ ቡር ይይምድንደትም ጻፍካ። <verse eid="REV 1:19"/><verse number="20" style="v" sid="REV 1:20"/>እስታ ምዝ አንንዘን የስ ሰድባብከስ ታብዛ ቤዝንከስተኬ ዎርቀካ ኡርሰርሳን ታብዛ ዞጰን ዎደርድንደታ ቡልና ኮግንዴ። ታብዛ ቤዝንከስ ታብዛ Ꮊክ Ꮊክ ምክስ ኤሄንከስታ ክታይንችንከስኬ፥ ታብዛ ዞጰንከስም ዎደርድንደረ ታብዛ Ꮊክ Ꮊክ ምክስ ኤሄንከሰኬ”።<verse eid="REV 1:20"/></para>
  <chapter eid="REV 1"/>
  <chapter number="2" style="c" sid="REV 2"/>
  <para style="s1">(1) ኤፈሶን ምክስ ኤሄንካንታ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 2:1"/>ኤፈሶን ምክስ ኤሄናር ክታይንችንካንታ ኩን ጋይሰዮ ጻፍካ፥</para>
  <para style="p" vid="REV 2:1">“ኮና ታብዘን ቤዝንከስም ይንታ ምዝ አንካ የጅባብዘንኬ ዎርቀንካ ኡርሰርሳን ታብዛ ዞጰን ዎደርድንደትከስታ ዎክያር ኦንግድባብ ኩን ጋይዴ”። <verse eid="REV 2:1"/><verse number="2" style="v" sid="REV 2:2"/>የስታ ፍክስንም፥ የስታ ጉርንምኬ የስታ ዳንዳእንም እታ ኤዝድቴ፥ ዳቅልንከስም ማቼ የስ ዳንዳእተራክንግንዳ “ኦይትምስባብ ማታከክዶቆ ኦይትምስባቦቴ” ጋይድባብከስም ፋስት ኤስሰዮ ካርከንባብ ማስሰዮ ከትም የስ Ꮊፍሳን እታ ኤዝድቴ። <verse eid="REV 2:2"/><verse number="3" style="v" sid="REV 2:3"/>ዳንዳእካ የስታ ዳቅንምኬ እስታ ላምንጎካ ቦሳከይ ዶቆ ማጠንም የስ ተያንደትም እታ ኤዝድቴ። <verse eid="REV 2:3"/><verse number="4" style="v" sid="REV 2:4"/>ኬዛር ማቼ ዋልቃ የዘን እ ይንኤርድ ሪ ዶቅዴ፥ ና ኮነረ የስታ ኤና እሪንደትም ሶልመንም ዛቅተዬ፥ <verse eid="REV 2:4"/><verse number="5" style="v" sid="REV 2:5"/>ይና Ꮊስከካ ጬክን ጋይሳን ካርዘንካ የስ ዋቻናንኬረ ገቀርካ! ጎማ የስታ ፍክስንም ዎይስካ! ኤና እሪ የስ ይድᎺቃን የስታ ፍክስንም ፍክስካ፥ ኮም ሙዳ የስ ይዳክንዳ ማቼ የዝደር እታ Ꮊትቴ፥ የስታ ጎማፍክስን የስ ዎይሳክንዳ ማቼ የስታ ዞጰንም ዎደርድንደት ካርንዘንካ አምስትቴ። <verse eid="REV 2:5"/><verse number="6" style="v" sid="REV 2:6"/>ኬዛር ማቼ እ የስም ጎብዝድንዳ ዋልቃ ሪ ዶቅዴ፥ ኮነረ እ ግርድንደትም ኒቆላው ኤድንከስታ ፍክስንም ቦስተዬ።<verse eid="REV 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 2:7"/>አያንና Ꮊክ Ꮊክ ምክስ ኤሄንካንታ ጋይድንደትም ቃም ዶቅድባብ ኤሰራ! ሙደንም ጋምስባብ ሳብታ Ꮊዉስ ካርናር ዶቅድን ዶቅንት Ꮊቀንታ አፍን እጅድንግንዳ ክትም ይትቴ።<note caller="-" style="x"><char style="xo" closed="false">2፡7 </char><char style="xt" closed="false"><ref loc="GEN 2:7">ፍዝ. 2፡7</ref>፤ <ref loc="REV 22:2">ለም. 22፡2</ref>፤ <ref loc="EZK 28:13">ሕዝ. 28፡13</ref>፤ <ref loc="EZK 31:8">31፡8</ref>። </char></note><verse eid="REV 2:7"/></para>
  <para style="s1">(2) ሰምረነስ ምክስ ኤሄንካንታ</para>
  <para style="p">
    <verse number="8" style="v" sid="REV 2:8"/>ሰምርነስ ምክስ ኤሄናር ክታይንችንካንታ ኩንጋይሶ ጻፍካ፥<note caller="-" style="x"><char style="xo" closed="false">2፡8 </char><char style="xt" closed="false"><ref loc="ISA 44:6">ኢሳ. 44፡6</ref>፤ <ref loc="ISA 48:12">48፡12</ref>፤ <ref loc="REV 1:17">ለም. 1፡17</ref>፤ <ref loc="REV 22:13">22፡13</ref>። </char></note></para>
  <para style="p" vid="REV 2:8">“ኮና እርንባብኬ ቡርንባብ ማችባብዘንካ፥ ደእስባብኬ ደእናርንካ አምስባብ ኩን ጋይዴ”፥ <verse eid="REV 2:8"/><verse number="9" style="v" sid="REV 2:9"/>የስታ ማጠንምኬ ሪካይሳ የስታ ማትንተን እታ ኤዝድቴ፥ ማታጋካ ዳት የና ቆልመክንባበዬ፥ “አይሁድ ማታከክዶቆ አይሁዶቴ ጋይድባብከስ”፥ ሰጣንካ ዙገርድባብከስ፥ የስታ ላምንም የክስሳንደትም ኤዝድቴ፥ <verse eid="REV 2:9"/><verse number="10" style="v" sid="REV 2:10"/>የዘን የልድን ማጠንካንታ Ꮊይጳሴ፥ ይና የ ጰጭምድንግንዳ የንታ ዋርንካ ዋልቃ ዋልቀንከስም ዳብሎስ ዞክና ኤሀር የም አርችተረ፥ ታማ ሰጨረ ማጠንም ተይተረቴ፥ ደእ የለልተረ ኣመንምስባብ ማትካ፥ ዶቅንት ዛዉደንመረ የስካንታ እምትቴ።<verse eid="REV 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 2:11"/>“አያንና Ꮊክ Ꮊክ ምክስ ኤሄንካንታ ጋይድንደትም ቃም ዶቅድባብ ኤሰራ!</para>
  <para style="p" vid="REV 2:11">“ሙደንም ጋምስባብም ቃስትምስ ደእና ክትም ኡፈልዝዳክዬ”። <note caller="-" style="x"><char style="xo" closed="false">2፡11 </char><char style="xt" closed="false"><ref loc="REV 20:14">ለም. 20፡14</ref>፤ <ref loc="REV 21:8">21፡8</ref>። </char></note><verse eid="REV 2:11"/></para>
  <para style="s1">(3) ጰርጋሞን ምክስ ኤሄንካንታ</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 2:12"/>ጰርጋሞን ምክስ ኤሄንታ ክታይንችንካንታ ኩንጋይሶ ጻፍካ፥</para>
  <para style="p" vid="REV 2:12">ኮና፥ ቃስተንንጎካ ቃርሳን ማሰንም የጅባብ ኩን ጋይዴ፥ <verse eid="REV 2:12"/><verse number="13" style="v" sid="REV 2:13"/>የስ ሰጣንታ ባንችም ጎንገን ዶቅድን ካርዘን የስታ ዶቅንትን ኤዝድቴ፥ ማታጋካ ዳት እስታ ላምንም ኡርስት የተዬ፥ እስታዘን የስታ ዶቅድን ኣመንንም ካዳካዬ፥ ኣመንምስባብ እስታ ማርከን አንትጳስ ሰጣን ዶቅድን የንታ ካተመናር ክት ደይስምሳንደትካ ዎራ እንካ የስታ ኣመንምን ዛቃካዬ። <verse eid="REV 2:13"/><verse number="14" style="v" sid="REV 2:14"/>ኬዛር ማቼ እ የዘን ይንኤርድን ዋልቃ ዋልቃ ሪንከስ ዶቅዴ፥ ኮነረ ባለአምታ ኤስስን የጅባብ ዋልቃ ዋልቃ ኤድንከስ የንታ ዎክያር ዶቅደኬ፥ ኖኮና ባልአም እስራኤል ዎርሰንከስ ጮይስ ማታክን ሪንካንታ ካስምሳን እችምን እቼርንደትኬ ቤልምን ቤልመረኮ ከት ኮተርድንግንዳ ባላቅም ዞርስባቤ።<note caller="-" style="x"><char style="xo" closed="false">2፡14 </char><char style="xt" closed="false"><ref loc="NUM 22:5">ፋይ. 22፡5</ref>፥<ref loc="NUM 22:7">7</ref>፤ <ref loc="NUM 31:16">31፡16</ref>፤ <ref loc="NUM 25:1-3">25፡1-3</ref>፤ <ref loc="DEU 23:4">ካሪ. 23፡4</ref>። </char></note> <verse eid="REV 2:14"/><verse number="15" style="v" sid="REV 2:15"/>ኮትኮግንደረ ኒቆላውያን ኤድንከስታ ኤስስን የጅባብ ኤድንከሰረ የንታ ዎክናር ዶቅደኬ፥ <verse eid="REV 2:15"/><verse number="16" style="v" sid="REV 2:16"/>ኮካንታ ጎማ የስታ ፍክስንም ዎይስካ፥ ኩን የስ ይያክንዳ ማቼ ሳነካ የዝደር Ꮊድስቶ እስታ አፈናርንካ ዉድን ማሰንካ ከትም እክትቴ።<verse eid="REV 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 2:17"/>አያንና Ꮊክ Ꮊክ ምክስ ኤሄንካንታ ጋይድንደትም ቃም ዶቅድባብ ኤሰራ! ሙደንም ጋምስባብም አችምሳን ማነናርንካ ክትካንታ እምትቴ፥ ክላ ላም ጻፍምሳንደትም ጫምሳ ሰይንንመረ ክትካንታ እምትቴ፥ ክት ተይድባብዘንካ አብ ኮትኮም Ꮊየነረ ኤዝዳክዬ።<note caller="-" style="x"><char style="xo" closed="false">2፡17 </char><char style="xt" closed="false"><ref loc="EXO 16:14-15">ዉት. 16፡14-15</ref>፥<ref loc="EXO 16:33-35">33-35</ref>፤ <ref loc="JHN 6:48-50">ዮሀ. 6፡48-50</ref>፤ <ref loc="ISA 62:2">ኢሳ. 62፡2</ref>። </char></note><verse eid="REV 2:17"/></para>
  <para style="s1">(4) ትያጥሮን ምክስ ኤሄንካንታ</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 2:18"/>ትያጥሮን ምክስ ኤሄናር ክታይንችንካንታ ኩን ጋይሰዮ ጻፍካ፥</para>
  <para style="p" vid="REV 2:18">ኮና ኖሄንታ ሎግንችን ካምድን አፍንከስ ዶቅድባብኬ ኖሄታ ዎልስምካ ዘይሳን ጋይንም ካምድባብ ዱትንከስ ዶቅድባብ፥ ሳብ ይንችንዘንካ ኬዝምሳንዴ፥ <verse eid="REV 2:18"/><verse number="19" style="v" sid="REV 2:19"/>የስታ ፍክስንምኬ የስታ ሶልመን፥ የስታ ኣመንንኬ የስታ ፍክስንም፥ ዳንዳእንካ የስታ ዳቅንመረ ኤዝድቴ፥ ቡርንዳ የስታ ፍክስና እሪንደትዘንካ ስገድንደትመረ ኤዝድቴ። <verse eid="REV 2:19"/><verse number="20" style="v" sid="REV 2:20"/>ኬዛር ማቼ ዋልቃ የዘን እ ይንኤርድ ሪ ዶቅዴ፥ ኮነረ ሳብዘንካ ኤሰርስቶ ከዝድንድቴ ጋይድንደት ኮት ኤተን ኤልዛበለም በህን ጋይሰዮ ኮትም ዳንዳእሰዬ፥ ና እስታ ፍክስንባብከስ ቤልምድንግንደኬ ጮይስ ማታክን ሪንካንታ ካሰርሳን እችምን ከት እጅድንግንዳ ኤስስካ ና ከትም ኮተርስቴ።<note caller="-" style="x"><char style="xo" closed="false">2፡20 </char><char style="xt" closed="false"><ref loc="1KI 16:31">1 ባንቺ. 16፡31</ref>፤ <ref loc="2KI 9:22">2 ባንቺ. 9፡22</ref>፥<ref loc="2KI 9:30">30</ref>። </char></note> <verse eid="REV 2:20"/><verse number="21" style="v" sid="REV 2:21"/>ኮት ጎማፍክስን ይንታ ዎይዝድንግንዳ ሰጫ ኮትካንታ እምሳቴ፥ ናማቼ ይንታ ቤልምንታ ጎማ ፍክስ ዎይስን ዝጋክዬ። <verse eid="REV 2:21"/><verse number="22" style="v" sid="REV 2:22"/>ኮካንታ ሰቀርሶ ማጠታ ሰለንዘን ኮት ራድንግንዳ ይትቴ፥ ኮትከረ ክክን ከት ፍክሳᎺቃን ዳቅል ፍክስንታ ጎማ ፍክስን ይንታ ዎይስሰኮ ከት ማታክንዳ ማቼ ኮትከረ ክክን ቤልማ Ꮊቅባብከስመረ ሙዳ ዳቅሳን ማጠን ኬታዘን ተይᎺትቴ፥ <verse eid="REV 2:22"/><verse number="23" style="v" sid="REV 2:23"/>ኮትም ጎርስማᎺቅባብከስም ደእካ ከትም ሰርትቴ፥ Ꮊክ Ꮊክ ምክስ ኤሄንከሰረ ሙዳ ኤታ ገቅርምንኬ አንግርም ፋስት ኤዝድባብ እ ማቻንደትም ኤስተረኬ፥ የ ዋልቃ ዋልቀንካንተረ የንታ ፍክስንግንዳ እምትቴ።<verse eid="REV 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 2:24"/>ትያጥሮናር የ ዶቅድባብካንተኬ ኮትኮም ዳቅል ኤስስን የተያክባብ ሙደንካንታ፥ ኮትኮግንደረ ዋልቃ ዋልቀንከስ ሰጣንታ ኤስምዳክንዳ አችምሳንደ ጋይድባብከስም የ ጎርስማክባብዘን አብ ክቴንም የካንታ እምዳክቴ፥ <verse eid="REV 2:24"/><verse number="25" style="v" sid="REV 2:25"/>ኬዛርካ ማቼ እ Ꮊተርን የለልታ የንታ ዶቅድንደትም ዳቅስት የድከቴ። <verse eid="REV 2:25"/><verse number="26" style="v" sid="REV 2:26"/>ይንታ ኣመንካ ጋምስባብካንተኬ፥ እስታ ፍክስንዘነረ በእንታ የለልታ ዳቅድባብካንታ አይሁድ ማታክባብከስታዘን ገችታ ኤረንም ክትካንታ እምትቴ፥ <verse eid="REV 2:26"/><verse number="27" style="v" sid="REV 2:27"/>ስብል ጉፈንካ ከትም ቆልተረ፥ ፍጨዘንካ ኡርስምሳን ድግድን ሪንከስግንደረ ጎድሶ እላግንዳ ከትም ማስተሬ፥ ኮነረ ገችታ ኤራ እታ እስታ ባቤንዘንካ እ ተያንግንዴ። <verse eid="REV 2:27"/><verse number="28" style="v" sid="REV 2:28"/>ሰጭማ ማንካር ቤዝንመረ ጋምንተታ ቃዉታ ማድንግንዳ ክትካንታ እምትቴ። <verse eid="REV 2:28"/><verse number="29" style="v" sid="REV 2:29"/>አያንና Ꮊክ Ꮊክ ምክስ ኤሄንካንታ ኬዝድንደትም ቃም ዶቅድባብ ኤሰራ!<verse eid="REV 2:29"/></para>
  <chapter eid="REV 2"/>
  <chapter number="3" style="c" sid="REV 3"/>
  <para style="s1">(5) ሰርደስ ምክስ ኤሄንካንታ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1"/>ሰርደስ ምክስ ኤሄናር ዶቅድን ክታይንችንካንታ ኩንጋይሶ ጻፍካ፥</para>
  <para style="p" vid="REV 3:1">ኮና፥ ታብዛ ሳብታ አያንንከስምኬ ታብዛ ቤዝንከስም የጅባብ ኩን ጋይዴ። የስታ ፍክስንም ኤዝድቴ፥ ሰንፔካ ዶቅድም የስካምድንዳ ላምቴ፥ ኬዛር ማቼ ደእተዬ። <verse eid="REV 3:1"/><verse number="2" style="v" sid="REV 3:2"/>ንካ፥ ደእካንታ የልሳንደትምኬ የስታ ነገዳን መራ ሪንከስም ዳቅስካ፥ እስታ ጮይስንታ እሪ የስታ ፍክስን ቦድማ ማችንካ Ꮊፋክቴ። <verse eid="REV 3:2"/><verse number="3" style="v" sid="REV 3:3"/>ይና Ꮊራ ግንዳ ኤስስን የስ ተያናንከኬ የስ ኤሰርሳናንካ ገቀርካ፥ ኮትም ካርስካ፥ የስታ ጎማ ፍክስንመረ ዎይስካ፥ የስ ንጋክንዳ ማቼ ድብግንዳ የስ ገቀራክናና የዝደር Ꮊትቴ፥ Ꮊራ ሳዓትንዘን የዝደር እ Ꮊዳናነረ የና ኤሳዬ።<note caller="-" style="x"><char style="xo" closed="false">3፡3 </char><char style="xt" closed="false"><ref loc="MAT 24:43-44">ማቶ. 24፡43-44</ref>፤ <ref loc="LUK 12:39-40">ሉቃ. 12፡39-40</ref>፤ <ref loc="REV 16:15">ለም. 16፡15</ref>። </char></note> <verse eid="REV 3:3"/><verse number="4" style="v" sid="REV 3:4"/>ኬዛርንካ ማቼ ከታ ይንታ አፍለንም ጭመርሳክባብከስ ሳርደስ ምክስ ኤሄናር ቶክም ኤድንከስ የስካ ክክን ዶቅደኬ፥ ኬታ ጫምሳ አፍላ ቆብር ከትም ዝግዝድባብ ማቻንካንታ ጫምሳ አፍለን ቆብርሰኮ እንካ ክክን አይደኬ። <verse eid="REV 3:4"/><verse number="5" style="v" sid="REV 3:5"/>ሙደንም ጋምስባብ ኮትኮግንዳ ጫምሳ አፍለንም ቆበርተሬ፥ ክታ ላምንም እስታ ባቤንተኬ ክታይንችንከስታ እሪ ክትካንታ ኤስምስትቴ፥ ሰንፔካ ዶቅድባብከስታ ላምን ጻፈርድንደት ዶቅንት ማጻፍናርንካ ክታ ካይሳይቴ።<note caller="-" style="x"><char style="xo" closed="false">3፡5 </char><char style="xt" closed="false"><ref loc="EXO 32:32-33">ዉት. 32፡32-33</ref>፤ <ref loc="PSA 69:28">የቺ 69፡28</ref>፤ <ref loc="REV 20:12">ለም. 20፡12</ref>፤ <ref loc="MAT 10:32">ማቶ. 10፡32</ref>፤ <ref loc="LUK 12:8">ሉቃ. 12፡8</ref>። </char></note><verse eid="REV 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 3:6"/>አያንና Ꮊክ Ꮊክ ምክስ ኤሄንከስካንታ ጋይድንደትም ቃም ዶቅድባብ ኤሰራ!<verse eid="REV 3:6"/></para>
  <para style="s1">(6) ፍላደፍያ ምክስ ኤሄንካንታ</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7"/>ፍላደፍያ ምክስ ኤሄናር ዶቅድን ክታይንችንካንታ ኩን ጋይሶ ጻፍካ፥</para>
  <para style="p" vid="REV 3:7">“ኮና፥ ሳብካንታ ፋስምስባብኬ ዶፈን ማችባብ፥ ዳዊትታ ኤሄንታ ፍልተን ፎጅድንደትም የጅባብ ኩን ጋይዴ። ክት ፎጅድንደትም Ꮊየነረ ዝጫዬ፥ ክት ዝጭድንደትመረ Ꮊየነረ ፎቻዬ”።<note caller="-" style="x"><char style="xo" closed="false">3፡7 </char><char style="xt" closed="false"><ref loc="ISA 22:22">ኢሳ. 22፡22</ref>፤ <ref loc="JOB 12:14">ኢዮብ 12፡14</ref>። </char></note> <verse eid="REV 3:7"/><verse number="8" style="v" sid="REV 3:8"/>የስታ ፍክስንም ኤዝድቴ፥ ይና፥ Ꮊየነረ ዝጭካንታ ማዳክንደትም ፎችምሳን ፍልታ የስካንታ እምትቴ፥ ዎልቀና የስታ መራ ማትንተን ኤዝድቴ፥ ማታጋካ ዳት እስታ ቃለንም ካርስታዬ፥ እስታ ላምንመረ ካዳካዬ።<note caller="-" style="x"><char style="xo" closed="false">3፡8 </char><char style="xt" closed="false"><ref loc="ISA 49:23">ኢሳ. 49፡23</ref>፤ <ref loc="ISA 60:14">60፡14</ref>፤ <ref loc="ISA 43:4">43፡4</ref>። </char></note> <verse eid="REV 3:8"/><verse number="9" style="v" sid="REV 3:9"/>ይና፥ “አይሁድ ማታከክዶቆ አይሁዶቴ” ጋይድባብከስም ከትኬ ሰጣንታ ዋልቃትቼናር ማችባብ ካርከንባብከስ Ꮊድሰኮ የስታ ዱትንዘን ከት ዋጅድንግንዳ ከትም ይድቴ፥ እ የስም ሶልምሳንደትመረ ከት ኤዝድንግንዳ ከትም ይትቴ። <verse eid="REV 3:9"/><verse number="10" style="v" sid="REV 3:10"/>ዳንዳእድባብ ማትካ እ የስም ጋይሳን እስታ ቃለንም የስ ካርሳንካንታ እተረ ፍጨዘን ዶቅድባብከስም ጰጫካንታ ፍጫሙደንዘን Ꮊድን ማጣ ሰጨናይካ እታ የስም ካርዝድቴ። <verse eid="REV 3:10"/><verse number="11" style="v" sid="REV 3:11"/>ይና፥ ሳነካ Ꮊድቴ፥ የስታ ዛዉደንም Ꮊየነረ የዘንካ ተይዳክንግንዳ የስታ ዶቅድንደትም ዳቅስሶ የድካ። <verse eid="REV 3:11"/><verse number="12" style="v" sid="REV 3:12"/>ሙደንም ጋምስባብም እስታ ጮይስንታ ጭል ኤሄናር ቱስ ክትም ማስትቴ፥ ኮታርከረ ቦድሶ ዉታዬ፥ እስታ ጮይስንታ ላምንኬ እስታ ጮይስንታ ካተመንታ ላምን ክታዘን ጻፍትቴ፥ ና ኮነረ ካተመና ጭላር እስታ ጮይስንታ ላማርንካ Ꮊድንዳ ና ክላ የሩሳሌመ፥ እስተረ ክላ ላምን ክታዘን ጻፍድቴ።<note caller="-" style="x"><char style="xo" closed="false">3፡12 </char><char style="xt" closed="false"><ref loc="REV 21:2">ለም. 21፡2</ref>፤ <ref loc="ISA 62:2">ኢሳ. 62፡2</ref>፤ <ref loc="ISA 65:15">65፡15</ref>። </char></note><verse eid="REV 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 3:13"/>አያን Ꮊክ Ꮊክ ምክስ ኤሄንከስካንታ ጋይድንደትም ቃም ዶቅድባብ ኤሰራ!<verse eid="REV 3:13"/></para>
  <para style="s1">(7) ሎዶቅያ ምክስ ኤሄንካንታ</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 3:14"/>ሎዶቅያ ምክስ ኤሄናር ዶቅድን ክታይንችንካንታ ኩን ጋይሶ ጻፍካ፥</para>
  <para style="p" vid="REV 3:14">“ኮና፥ አምንኤ ማችባብ፥ ኣመንምስባብኬ ዶፈን ማርካ ማችባብ፥ ሳብታ ፍዝር ሙደና ክታዘንካ Ꮊፈርስባብ ኩን ጋይዴ”፥<note caller="+" style="f"><char style="fr" closed="false">3፡14 </char><char style="ft" closed="false">Ꮊክ Ꮊክ ፍርደን እማህእቅባብከስ 8፡22። </char></note> <verse eid="REV 3:14"/><verse number="15" style="v" sid="REV 3:15"/>የስታ ፍክስንም ኤዝድቴ፥ ጋንድ አነረ ሶል ካየዬ፥ ጋንድ አነረ ሶል የስ ማተስናና ኡርማ የስካንታ ማዳዶቆ! <verse eid="REV 3:15"/><verse number="16" style="v" sid="REV 3:16"/>ጋንድ አነረ ሶል ማታከይ ዶቆ ቦይቦይ የስ ማቻንካንታ እስታ አፈናርንካ ዉችትቶ የስም ፈጭምታ ይድቴ፥ <verse eid="REV 3:16"/><verse number="17" style="v" sid="REV 3:17"/>እታ ቆልማባብቴ፥ በድ እስታ ቆልማ ዶቅዴ፥ እም ዞገርድንዳ Ꮊረነረ ካዬ ጋይደዬ፥ ኬዛር ማቼ ላቅስባብ፥ ጉርት፥ ሪ ካየንባብ ዝልኬ ዘናጫለንክንባብ የስታ ማትንተን ኤሳከዬ፥ <verse eid="REV 3:17"/><verse number="18" style="v" sid="REV 3:18"/>ኮካንታ ቆልማባብ ማትካንታ ኖሄካ ጰጭምሳን ዎርቀን፥ ዘና ጫለንካ የስታ ማትንተን አቻካንታ ጫምሳ አፍለን የስ ቆበርተርንግንዳ፥ ሰድንካንተረ የስ ማተርንግንዳ አፍታ ኤልን እዘንካ ሰንሰዮ የስ ሳየርተርንግንዳ እታ የስም ዞርድቴ። <verse eid="REV 3:18"/><verse number="19" style="v" sid="REV 3:19"/>እታ እ ሶልምድባብከስም ሙዳ Ꮊግድቴ፥ ሰርድቴ፥ ኮካንታ ዳእካ፥ ጎማፍክስንመረ የስታ ዎይስካ፥<note caller="-" style="x"><char style="xo" closed="false">3፡19 </char><char style="xt" closed="false"><ref loc="PRO 3:12">ካም. 3፡12</ref>፤ <ref loc="HEB 12:6">ዕብ. 12፡6</ref>። </char></note> <verse eid="REV 3:19"/><verse number="20" style="v" sid="REV 3:20"/>ይና! እታ ፍልታር ዎእስቶ ኤልድቴ፥ Ꮊየነረ እስታ ኡፍስን ኤሰርሶ ይንታ ፍልተን እካንታ ፎቼ ክደር አርድስቶ ክትካ ክክን እጅድቴ፥ ኖየረ እንካ ክክን እጅዴ፥ <verse eid="REV 3:20"/><verse number="21" style="v" sid="REV 3:21"/>እታ ሙደንም ጋምስቶ እስታ ባቤንካ ክክን ክት ባንችምሶ ዶቅድን ጎንገንዘን ዶቅሳቴ፥ ኮትኮግንደረ ሙደንም ጋምስባብ እንካ ክክን ባንችምሶ እ ዶቅድን ጎንገንዘን ክት ዶቅተርንግንዳ ይትቴ።<verse eid="REV 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 3:22"/>“አያንና Ꮊክ Ꮊክ ምክስ ኤሄንከስካንታ ጋይድንደትም ቃም ዶቅድባብ ኤሰራ!”<verse eid="REV 3:22"/></para>
  <chapter eid="REV 3"/>
  <chapter number="4" style="c" sid="REV 4"/>
  <para style="s1">ጭላር ዶቅድን ባንችንታ ዶቅንት ጎንጋ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1"/>ኮታ ቡር ሰጅቴ፥ ይና ጭለዘን ፎችምሳን ፍልታ Ꮊቄ፥ እሪናና እ ኤሰርሳንዳ አንዳላ ግንደንታ ዶቅድን ኡፍስካ “ኮሬ ፈንክ ዉትካ፥ ኦስ እሪ ማት ዝግዝድን ሪንከስም የስም ሰችትቴ” ኩን ጋይሴ። <verse eid="REV 4:1"/><verse number="2" style="v" sid="REV 4:2"/>ሳነካ ቱምቱም ጋየርቶ አያናር፥ ይና ጭላር ባንችምንከስ ዶቅድን ጎንገን ሰዳቴ፥ ባንችንከስ ዶቅድን ጎንገንዘን ዋልቃባብ ዶቅስንካ ሰድቴ። <verse eid="REV 4:2"/><verse number="3" style="v" sid="REV 4:3"/>ባንችንከስ ዶቅድን ጎንገንዘን ዶቅሶ Ꮊቅባብ እያስጵድ ጋይምድንዳ አነረ ሰርዶን ጋይምድን ቦንችምሳን ሰይንን ካምድንዴ፥ ባንችንከስ ዶቅድን ጎንገንታ ካንተካ መርግድ ጋይምድንዳ ቦንችምሳን ሰይንና ዙለም ካምድንዳ Ꮊቄ፥<note caller="-" style="x"><char style="xo" closed="false">4፡3 </char><char style="xt" closed="false"><ref loc="EZK 1:26-28">ሕዝ. 1፡26-28</ref>፤ <ref loc="EZK 10:1">10፡1</ref>። </char></note> <verse eid="REV 4:3"/><verse number="4" style="v" sid="REV 4:4"/>ኮትኮግንደረ፥ ባንችምንከስ ዶቅድን ጎንገንታ ካንተካ ቦንደኬ ኦይድ ጎንጋ ባንችንከስ ዶቅድንዳ Ꮊቄ፥ ባንችንከስታ ዶቅንት ጎንገንዘነረ ጫምሳ አፍላ ቆበርስባብኬ ከታ ይንታ ማተንዘነረ ዎርቀታ ዛዉደን ዎጅባብ ቦንደኬ ኦይድ ጋልተንከስ ዶቅሶ Ꮊቀኬ። <verse eid="REV 4:4"/><verse number="5" style="v" sid="REV 4:5"/>ባንችምንከስታ ዶቅንት ጎንገንዘንከረ ዋልቅንት፥ ጉግንኬ ኡፍስካ ዉድዮ Ꮊቄ፥ ባንችምንከስታ ዶቅንት ጎንገንታ እሪ ሳግዝድንዳ ታብዛ ዞጰንከስ Ꮊቀኬ፥ ከታ ታብዘና ሳብታ አያንንከሰኬ።<note caller="-" style="x"><char style="xo" closed="false">4፡5 </char><char style="xt" closed="false"><ref loc="EXO 19:16">ዉት. 19፡16</ref>፤ <ref loc="REV 8:5">ለም. 8፡5</ref>፤ <ref loc="REV 11:19">11፡19</ref>፤ <ref loc="REV 16:18">16፡18</ref>፤ <ref loc="EZK 1:13">ሕዝ. 1፡13</ref>፤ <ref loc="REV 1:4">ለም. 1፡4</ref>፤ <ref loc="ZEC 4:2">ዘካ. 4፡2</ref>። </char></note> <verse eid="REV 4:5"/><verse number="6" style="v" sid="REV 4:6"/>ባንችምንከስ ዶቅድን ጎንገንታ እሪ ይልችን ጋይሶ ማስታትግንዳ ሮጵድንዳ ባሀር Ꮊቄ፥ ባንችምንከስ ዶቅድን ጎንገንታ ዎክያር፥ ባንችምንከስ ዶቅድን ጎንገንታ ካንተካ እሪጎኬ ቡርጎካ በድ አፍንከስ ዶቅድባብ ሰንፔካ ዶቅድባብ ኦይድ ፍዝርንከስ Ꮊቀኬ። <verse eid="REV 4:6"/><verse number="7" style="v" sid="REV 4:7"/>እርንባብ ፍዝርና ዞበም ካምዴ፥ ቃስትምስና ገዝምም ካምዴ፥ ማክምስና ኤታ ባለም ካምድንዳ Ꮊቄ፥ ኦይችምስና ፈድን Ꮊካርም ካምድንዳ Ꮊቄ።<note caller="-" style="x"><char style="xo" closed="false">4፡7 </char><char style="xt" closed="false"><ref loc="EZK 1:22">ሕዝ. 1፡22</ref>፤ <ref loc="EZK 10:14">10፡14</ref>። </char></note> <verse eid="REV 4:7"/><verse number="8" style="v" sid="REV 4:8"/>ኦይድ ፍዝርንከሳርንካ ከት ዋልቃ ዋልቀንከስታ ላ ከፍንከስ ኬታ Ꮊቄ፥ ኬታ ካንተኬ ኬታ ዋርጎካ በድ አፍንከስ Ꮊቄ፥ Ꮊየካ ሶይትካ</para>
  <para style="q1" vid="REV 4:8">“ጭልዮ፥ ጭልዮ፥ ጭልዮ</para>
  <para style="q2" vid="REV 4:8">ሙደንም ቆልድባብ ጮይስ ሳብዮ፥</para>
  <para style="q2" vid="REV 4:8">ኤንገር Ꮊቅባብ፥ ታ ዶቅድባብኬ Ꮊድባበረ”</para>
  <para style="m" vid="REV 4:8">ጋይድ Ꮊቀኬ።<note caller="-" style="x"><char style="xo" closed="false">4፡8 </char><char style="xt" closed="false"><ref loc="EZK 1:18">ሕዝ. 1፡18</ref>፤ <ref loc="EZK 10:12">10፡12</ref>፤ <ref loc="ISA 6:2-3">ኢሳ. 6፡2-3</ref>። </char></note> <verse eid="REV 4:8"/><verse number="9" style="v" sid="REV 4:9"/>መሄንከስ ባንችምንከስ ዶቅድን ጎንገንዘን ዶቅስባብካንተኬ ስለንካ ስለንካ ዶቅድባብካንታ ዴእስ፥ ቦንቼኬ ጋለትካ እምምድንደትᎺይካ ሙዳ፥ <verse eid="REV 4:9"/><verse number="10" style="v" sid="REV 4:10"/>ቦንደኬ ኦይድ ጋልተንከስ ስለንካ ስለንክንደታ ዶቅድባብታ፥ ባንችምንከስ ዶቅድን ጎንገንዘን ዶቅስባብታ እሪ ኬታ ይንታ ባለንካ ይርክን ጋይሶ ጎዝደኬ፥ ኬታ ይንታ ዛዉደንከስመረ ባንችምንከስ ዶቅድን ጎንገንታ እሪ ዎድሰኮ፥<verse eid="REV 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 4:11"/>“ዎንታ ጮይስንኬ ዎንታ ሳብ ማችባቦ፥</para>
  <para style="q1" vid="REV 4:11">ሙዳ ሪም የስ ፍዛንካንታ</para>
  <para style="q2" vid="REV 4:11">ሙዳ ሪና ፍዝምሳንደትኬ</para>
  <para style="q2" vid="REV 4:11">ሰንፔካ ዶቅድንደና የስታ ጋይተካ ማቻንካንታ</para>
  <para style="q2" vid="REV 4:11">ዴእስ፥ ቦንቼኬ ዎልቀረ የስካንታ ዝግዝዴ” ኩን ጋይድ Ꮊቀኬ።<verse eid="REV 4:11"/></para>
  <chapter eid="REV 4"/>
  <chapter number="5" style="c" sid="REV 5"/>
  <para style="s1">ማጻፍንኬ ቆለንካ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 5:1"/>ባንችምንከስ ዶቅድን ጎንገንዘን ዶቅስባብታ ምዝ አንንዘን፥ ዋርጎኬ ቡርጎካ ጻፍምሳንዳ ታብዛ ማህተምካ ዝጨርሳንዳ ቁረርሳን ማጻፍ ሰድቴ፥<note caller="-" style="x"><char style="xo" closed="false">5፡1 </char><char style="xt" closed="false"><ref loc="EZK 2:9-10">ሕዝ. 2፡9-10</ref>፤ <ref loc="ISA 29:11">ኢሳ. 29፡11</ref>። </char></note> <verse eid="REV 5:1"/><verse number="2" style="v" sid="REV 5:2"/>ዋልቃ ዳቅማ ክታይንች አንድር ኡፍስካ “ማህተምንከስም ቡልተርባብኬ ቁረርሳን ማጻፍን ፎችተርባብ Ꮊይራ?” ጋይሶ ኬዝድንካ ሰድቴ። <verse eid="REV 5:2"/><verse number="3" style="v" sid="REV 5:3"/>ኬዛር ማቼ ጭለዘነረ ማታ ፍጨዘን አነረ ፍጨታ ጎያር ቁረርሳን ማጻፍን ፎችኬ ዋርንደትም ሰድንካንታ ማችባብ Ꮊየነረ ካዬ። <verse eid="REV 5:3"/><verse number="4" style="v" sid="REV 5:4"/>ቁረርሳን ማጻፍን ፎችኬ ዋርጎክንደትም ሰድንካንታ ማችባብ Ꮊፈራክንካንታ አንድር ኤፍስቴ። <verse eid="REV 5:4"/><verse number="5" style="v" sid="REV 5:5"/>ኮታይካ ጋልተንከሳርንካ ዋልቀና “Ꮊይ ኤፌ፥ ይና ይሁደታ ኮችናርንካ ማችባብ ዳዊተታ አጥርያርንካ<note caller="+" style="f"><char style="fr" closed="false">5፡5 </char><char style="ft" closed="false">ግርክናር ጫጭ ጋይዴ </char></note> Ꮊድባብ ዞበና ሙደንም ጋምቴ፥ ኖ ቁረርሳን ማፅሀፍንኬ ታብዛ ማህተምንከስም ፎችካንታ ማዴ” እዝደር ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">5፡5 </char><char style="xt" closed="false"><ref loc="GEN 49:9">ፍዝ. 49፡9</ref>፤ <ref loc="ISA 11:1">ኢሳ. 11፡1</ref>፥<ref loc="ISA 11:10">10</ref>። </char></note><verse eid="REV 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 5:6"/>ኮታ ቡር ባንችምንከስ ዶቅድን ጎንገንዘንኬ ኦይድ ሰንፓ ዶቅድባብ ፍዝርንከስታ ዎክያር፥ ጋልተንከስተረ ዎክያር ባር ተቼርሳን ቆለንም ካምድባብ ዎእስንካ ሰድቴ፥ ክትኮ ቆለንንታ ታብዛ ባልንከስኬ ታብዛ አፍንከስ ክታ Ꮊቄ፥ ከተረ ኮ ፍጫሙደንዘን ኦይትምስባብ ታብዛ ሳብታ አያንንከሰኬ።<note caller="-" style="x"><char style="xo" closed="false">5፡6 </char><char style="xt" closed="false"><ref loc="ISA 53:7">ኢሳ. 53፡7</ref>፤ <ref loc="ZEC 4:10">ዘካ. 4፡10</ref>። </char></note> <verse eid="REV 5:6"/><verse number="7" style="v" sid="REV 5:7"/>ኖ ቆለና Ꮊድሶ ባንችምንከስ ዶቅድን ጎንገንዘን ዶቅስባብታ ምዝ አንንዘንካ ቁርምሳን ማጻፍን ተዬ። <verse eid="REV 5:7"/><verse number="8" style="v" sid="REV 5:8"/>ቁርምሳን ማጻፍን ይ ተያንደትካ ኦይድ ሰንፔካ ዶቅድን ፍዝርንከስኬ ቦንደኬ ኦይድ ጋልተንከስ ክት ቆለንንታ እሪ ኬታ ይንታ ባለንካ ጉፕን ጋይሰኬ፥ ዋልቃ ዋልቀንከስ ሶንግ የጀኬ፥ ኮትኮግንደረ ሳብካንታ ፋስምስባብከስታ ምክስ ማቻን እጣን ጮጫንዳ ዎርቀካ ኡርሰርሳን ሙዳይ ጋይድንደትም የድሶ Ꮊቄ።<note caller="-" style="x"><char style="xo" closed="false">5፡8 </char><char style="xt" closed="false"><ref loc="PSA 141:2">የቺ 141፡2</ref>። </char></note> <verse eid="REV 5:8"/><verse number="9" style="v" sid="REV 5:9"/>ክላ የቼረ ኩንጋየሮ የችሰኬ፥</para>
  <para style="q1" vid="REV 5:9">“የስታ ማቀስንካ አጥርንከሳርንካ፥ Ꮊክ Ꮊክ አፈንከሳርንካ፥</para>
  <para style="q2" vid="REV 5:9">ኮችንከሳርንካ፥ ዎርሰንከሳርንካ</para>
  <para style="q2" vid="REV 5:9">ኤድንከስም ሳብካንታ ቆቲ ተይካንታ፥</para>
  <para style="q2" vid="REV 5:9">የስታ ባርንም ተቼርሳንካንታ</para>
  <para style="q2" vid="REV 5:9">ኤና እሪ ቁርምሳን ማጻፍን ተይካንተኬ</para>
  <para style="q2" vid="REV 5:9">ማህተምንከስም ፎችካንታ ዝግዝድባብ ማቻዬ፥<note caller="-" style="x"><char style="xo" closed="false">5፡9 </char><char style="xt" closed="false"><ref loc="PSA 33:3">የቺ 33፡3</ref>፤ <ref loc="PSA 98:1">98፡1</ref>፤ <ref loc="ISA 42:10">ኢሳ. 42፡10</ref>። </char></note><verse eid="REV 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 5:10"/>ዎንታ ጮይስንተረ ባንችምኬ ቄሰንከስ</para>
  <para style="q2" vid="REV 5:10">ከት ማድንግንዳ ይተዬ፥</para>
  <para style="q2" vid="REV 5:10">ፍጨዘነረ ባንችምደኬ”።<note caller="-" style="x"><char style="xo" closed="false">5፡10 </char><char style="xt" closed="false"><ref loc="EXO 19:6">ዉት. 19፡6</ref>፤ <ref loc="REV 1:6">ለም. 1፡6</ref>። </char></note><verse eid="REV 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11"/>ኦሰረ እ ሰድንካ ባንችምንከስ ዶቅድን ጎንገንዘን፥ ሰንፔካ ዶቅድን ፍዝርንከስተኬ ጋልተንከስታ ካንተካ በድ ክታይንችንከስታ ኡፍስን ኤሰርሳቴ፥ ኬታ በድምነረ በድ ሳአኬ በድ ፋይድንካ በእዳክባብ Ꮊቀኬ፥<note caller="-" style="x"><char style="xo" closed="false">5፡11 </char><char style="xt" closed="false"><ref loc="DAN 7:10">ዳን. 7፡10</ref>። </char></note> <verse eid="REV 5:11"/><verse number="12" style="v" sid="REV 5:12"/>አንድር ኡፍስከረ፥</para>
  <para style="q1" vid="REV 5:12">“ባር ተችምሳን ቆለና ዎልቀን፥ ቆልመን፥</para>
  <para style="q1" vid="REV 5:12">ኤጨንም፥ ዛብንተን፥ ዴእስንም፥ ቦንቼንምኬ</para>
  <para style="q2" vid="REV 5:12">ጋለትንም ተይካንታ ዝግዝድባቤ” ጋይሰኬ።<verse eid="REV 5:12"/></para>
  <para style="m">
    <verse number="13" style="v" sid="REV 5:13"/>ጭለዘነረ ፍጨዘን፥ ፍጨታ ጎያርኬ ባሀርናር፥ ከታዋረረ ፍዝርንከስ ሙዳ</para>
  <para style="q1" vid="REV 5:13">“ባንችምንከስ ዶቅድን ጎንገንዘን ዶቅስባብካንተኬ ቆለንካንተረ</para>
  <para style="q2" vid="REV 5:13">ጋለትኬ፥ ዴእስካ፥ ቦንቼኬ ዎልቀካ</para>
  <para style="q2" vid="REV 5:13">ስለንክንደትዘንካ ስለንካ የለልታ ማታ!” ከት ጋይድንካ ኤሰርሳቴ።<verse eid="REV 5:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="REV 5:14"/>ኦይድ ሰንፔካ ዶቅድን ፍዝርንከሰረ “አምንኤ!” ጋይሰኬ፥ ቦንደኬ ኦይድ ጋልተንከሰረ ኬታ ይንታ ባለንካ ጉፕን ጋይሰኮ ጎስትሰኬ።<verse eid="REV 5:14"/></para>
  <chapter eid="REV 5"/>
  <chapter number="6" style="c" sid="REV 6"/>
  <para style="s1">ማህተምንከስታ ፎችምና</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 6:1"/>ኮተረ ቡር ቆለና ታብዛ ማይተምንከሳርንካ እሪንደትም ፎጅድንካ ሰድቴ። ኦይድ ሰንፔካ ዶቅድባብ ፍዝርንከሳርንካ ዋልቀና ጉግንግንዳ ኡፍስካ “የና Ꮊድካ!” ጋይድንካ ኤሰርስቴ። <verse eid="REV 6:1"/><verse number="2" style="v" sid="REV 6:2"/>ኮታዘንከረ ጫምሳ ፋረም ሰድቴ፥ ፋረንዘን ዶቅስባብ ዶንግም የቴ፥ ዛዉደረ ክትካንታ እምምሴ፥ ኖየረ ሙደን ጋምድባብ ማትሶ ሙደን ጋምካንታ ዉተዴ።<note caller="-" style="x"><char style="xo" closed="false">6፡2 </char><char style="xt" closed="false"><ref loc="ZEC 1:8">ዘካ. 1፡8</ref>፤ <ref loc="ZEC 6:3">6፡3</ref>፥<ref loc="ZEC 6:6">6</ref>። </char></note><verse eid="REV 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3"/>ቆለና ቃስትምስን ማይተምን ፎቻንደትካ፥ ቃስትምስ ሰንፔካ ዶቅድባብ ፍዝርና “የና Ꮊድካ!” ጋይድንካ ኤሰርስቴ። <verse eid="REV 6:3"/><verse number="4" style="v" sid="REV 6:4"/>አበረ ዘይም ፋራ ዉተዴ፥ ፋረንታዘን ዶቅስባብካንታ ሳራትቼን ፍጨዘንካ Ꮊልእዝድንግንደኬ ኤድንከስ ክክ ክክ ከት በእድንግንዳ ይያባብ ገችታ ኤረን ክትካንታ እምምሴ፥ አንድር ማሴረ ክትካንታ እምምሴ።<note caller="-" style="x"><char style="xo" closed="false">6፡4 </char><char style="xt" closed="false"><ref loc="ZEC 1:8">ዘካ. 1፡8</ref>፤ <ref loc="ZEC 6:2">6፡2</ref>። </char></note><verse eid="REV 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5"/>ቆለና ማክምስ ማይተምን ፎቻንደትካ ማክምስ ሰንፓ ዶቅድን ፍዝርና “የና Ꮊድካ!” ጋይድንካ ኤሰርሳቴ፥ ኮታዘንከረ ጫልም ፋራ ሰዳቴ፥ ፋረንዘን ዶቅስባብና የርገንደትም ይንታ አንዘን የታ Ꮊቄ፥<note caller="-" style="x"><char style="xo" closed="false">6፡5 </char><char style="xt" closed="false"><ref loc="ZEC 6:2">ዘካ. 6፡2</ref>፥<ref loc="ZEC 6:6">6</ref>። </char></note> <verse eid="REV 6:5"/><verse number="6" style="v" sid="REV 6:6"/>ኦይድ ሰንፓ ዶቅድባብ ፍዝርንከስታ ዎክያርንካ Ꮊዳን ካምድን ኡፍስም ኤሰርሳቴ፥ ናኮና ኡፍስና “ክሎ ዋልቀታ ፋስም ማታባብ ዘርግ ዋልቃ ሰጫ ፍክስታ ናከርድንዳ ክሎ ዋልቀኬ ፋስምካ ማታባብ ጎስ ዋልቃ ሰጫ ፍክስታ ናክ ማታ፥ ዛይትንኬ ጩጰርሳን ዎይንን ማቼ Ꮊይ ካይሴ!” ጋይድንካ ኤሰርሳቴ።<verse eid="REV 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7"/>ቆለና ኦይችምስ ማይተምን ፎቻንደትካ ኦይችምስ ሰንፔካ ዶቅድን ፍዝርንታ ኡፍስ “የና Ꮊድካ!” ጋይድንካ ኤሰርሳቴ፥ <verse eid="REV 6:7"/><verse number="8" style="v" sid="REV 6:8"/>ኮታዘንከረ ጮምፓ ፋራ ሰድቴ፥ ፋረንዘን ዶቅስባበረ ክታ ላምነረ ደእ ጋይምዴ፥ ደእስባብከስ ዶቅድን ካርናረረ ክትም ጎርስምድ Ꮊቄ፥ ደእኬ ደእስባብከስ ዶቅድን ካርነረ ፍጨንታ ኦይድ ፍነናርንካ ዋልቃ ፍነን ዳምካ፥ ዳቅካ፥ ዎቼኬ ፍጨዘን ባችርካ ከት ደይዝድንግንዳ ገችታ ኤራ ከትካንታ እምምሴ።<note caller="-" style="x"><char style="xo" closed="false">6፡8 </char><char style="xt" closed="false"><ref loc="EZK 14:21">ሕዝ. 14፡21</ref>። </char></note><verse eid="REV 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 6:9"/>ዶንቅስ ማይተምን ፎቻንደትካ ሳብታ ቃለንጎኬ ከት እምሳን ማርካትቼንጎካ ደእስባብ ኤድንከስታ ሰንፔንከስም ካሲን ካሰርድንደታ ጎያር ሰድቴ፥ <verse eid="REV 6:9"/><verse number="10" style="v" sid="REV 6:10"/>ኬታ አንድር ኡፍስካ “ጭልምስባብኬ ዶፈን፥ ሙደንዘንካ ስግ ሳብኖ፥ ፍጨዘን ዶቅድባብ ኤድንዘን የስ ፋረዳክንደትኬ ዎንታ ማቀስንጎከረ ይምኤንም የስ ቡልዳክንዳ Ꮊንታ የለልተረ!” ጋየረኮ ፍፍሰኬ። <verse eid="REV 6:10"/><verse number="11" style="v" sid="REV 6:11"/>ከት ዋልቃ ዋልቀንከስካንተረ ጫምሳ አፍላ እምምሴ፥ ከትግንዳ አክ ደይስምድባብከስ፥ ከትግንዳ ሳብታ ፍክስንባብከስ ኬታ ይንታ ላኮይትንከስተኬ ይንታ እስመንንከስታ ፋይደና ጮጭተርን የለልታ ቶክም ሰጫካንታ Ꮊዉስሶ ከትዶቅድንግንዳ ከትካንታ ኬዝምሴ።<verse eid="REV 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12"/>ኮታ ቡር ቆለና ላስ ማይተምን ፎቻንደትካ ክደር ሰዳቴ፥ ይና አንድር ፍጨንተረ ጭጭ ማቼ፥ Ꮊይነረ ሞርእታ አፍላ ጫልምንግንዳ ጫልሴ፥ አርፈነረ ሙዳ ማቀስግንዳ ዘይሴ።<note caller="-" style="x"><char style="xo" closed="false">6፡12 </char><char style="xt" closed="false"><ref loc="REV 11:13">ለም. 11፡13</ref>፤ <ref loc="REV 16:18">16፡18</ref>፤ <ref loc="ISA 13:10">ኢሳ. 13፡10</ref>፤ <ref loc="JOL 2:10">ኢዩ. 2፡10</ref>፥<ref loc="JOL 2:31">31</ref>፤ <ref loc="JOL 3:15">3፡15</ref>፤ <ref loc="MAT 24:29">ማቶ. 24፡29</ref>፤ <ref loc="MRK 13:24-25">ማር. 13፡24-25</ref>፤ <ref loc="LUK 21:25">ሉቃ. 21፡25</ref>። </char></note> <verse eid="REV 6:12"/><verse number="13" style="v" sid="REV 6:13"/>ዳቅማ ዞገና በለስ Ꮊቀን ሶግዝድንካ ኮታ አፍና ኮታዘንካ ዋጅድንደትግንዳ ጭለዘን ቤዝንከሰረ ዋቸኬ።<note caller="-" style="x"><char style="xo" closed="false">6፡13 </char><char style="xt" closed="false"><ref loc="ISA 34:4">ኢሳ. 34፡4</ref>። </char></note> <verse eid="REV 6:13"/><verse number="14" style="v" sid="REV 6:14"/>ጭለነረ ቁርምሳን ማጻፍንግንዳ ቁርምሶ Ꮊልእሴ፥ ገቼንከስኬ ባሀርንታ ዎክያር ዶቅድን ደንንከሰረ ሙዳ ኬታ ይንታ ካርንዘንካ ካይደኬ።<note caller="-" style="x"><char style="xo" closed="false">6፡14 </char><char style="xt" closed="false"><ref loc="REV 16:20">ለም. 16፡20</ref>። </char></note> <verse eid="REV 6:14"/><verse number="15" style="v" sid="REV 6:15"/>ፍጨዘን ባንችንከስ፥ ዎርሰን ቆልድባብከስ፥ ዳምንባብከስም ክድባብከስ፥ ቆልመንክንባብከስ፥ ዎልቀንክንባብከስ፥ አይለንከስከ አይላማታክባብከሰረ ሙዳ የርሰንከሳርኬ ገቼንከስታ ላዝንከሳር አጥምሰኬ፥<note caller="-" style="x"><char style="xo" closed="false">6፡15 </char><char style="xt" closed="false"><ref loc="ISA 2:19">ኢሳ. 2፡19</ref>፤ <ref loc="ISA 21">21</ref>። </char></note> <verse eid="REV 6:15"/><verse number="16" style="v" sid="REV 6:16"/>ገቼንከስምኬ ላዝንከስመረ “ዎንዘን ዋችከቴ! ባንችምንከስታ ዶቅንት ጎንገንዘን ዶቅስባብታ እሪ፥ ቆለንንተረ ዋጭንዘንካ ዎም አችከቴ!<note caller="-" style="x"><char style="xo" closed="false">6፡16 </char><char style="xt" closed="false"><ref loc="HOS 10:8">ሆሴ. 10፡8</ref>፤ <ref loc="LUK 23:30">ሉቃ. 23፡30</ref>። </char></note> <verse eid="REV 6:16"/><verse number="17" style="v" sid="REV 6:17"/>አንድር ዋጭንታ ሰጨና Ꮊቴ፥ Ꮊይ ዎእንትካንታ ማተራ?” ከትም ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">6፡17 </char><char style="xt" closed="false"><ref loc="JOL 2:11">ኢዩ. 2፡11</ref>፤ <ref loc="MAL 3:2">ሚል. 3፡2</ref>። </char></note><verse eid="REV 6:17"/></para>
  <chapter eid="REV 6"/>
  <chapter number="7" style="c" sid="REV 7"/>
  <para style="s1">144 ሳአ እስራኤልንከስ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1"/>ኮታ ቡር ኦይድ ክታይንችና ኦይድ ፍጨንታ ፍነንከዘን ዎእስንካ ሰዳቴ፥ ኬታ ፍጨዘነረ ማታ ባሀርናር አነረ Ꮊቀዘን Ꮊረነረ ዞጋ ዞግዳክንግንዳ ኦይድ ፍነንከዘንካ Ꮊድባብከስም ፍጨንታ ዞገንከስም ማርሰኬ።<note caller="-" style="x"><char style="xo" closed="false">7፡1 </char><char style="xt" closed="false"><ref loc="JER 49:36">ኤር. 49፡36</ref>፤ <ref loc="DAN 7:2">ዳን. 7፡2</ref>፤ <ref loc="ZEC 6:5">ዘካ. 6፡5</ref>። </char></note> <verse eid="REV 7:1"/><verse number="2" style="v" sid="REV 7:2"/>ዶቅንት ሳብንታ ማይተምን የጅባብ አብ ክታይንቸረ Ꮊይታ ዉትንታጎካ Ꮊድንካ ሰድቴ፥ ፍጨንምኬ ባሀርን ካይዝድንግንዳ ገችታ ኤራ እምምስባብ ኦይድ ክታይንችንከዝደር ይንታ ኡፍስን ጬክሳ ይይሶ፥ <verse eid="REV 7:2"/><verse number="3" style="v" sid="REV 7:3"/>“ዎንታ ሳብንታ ፍክስንባብከስታ ባለንዘን ማይተምን ዎ የችተርን የለልታ፥ ፍጨንመረ ማታ ባሀርን አነረ Ꮊቀንከስም Ꮊይካይሰቴ” ጋይሶ ፍፍሴ።<note caller="-" style="x"><char style="xo" closed="false">7፡3 </char><char style="xt" closed="false"><ref loc="EZK 9:4">ሕዝ. 9፡4</ref>፥<ref loc="EZK 9:6">6</ref>። </char></note> <verse eid="REV 7:3"/><verse number="4" style="v" sid="REV 7:4"/>ማይተምን የቸርስባብ ኤድንከስታ ፋይደን ኤሰርሳቴ፥ እስራኤል አጥርንከሳርንካ ሙዳ ማይተምን የቸርስባብ ኤድንከስታ ፋይደና 144 ሳአ Ꮊቀኬ። <verse eid="REV 7:4"/><verse number="5" style="v" sid="REV 7:5"/>ይሁደታ አጥርናርንካ ማይተምን የቸርስባብከስ 12 ሳአ፥ ሮበልታ አጥርናርንካ 12 ሳአ፥ ጋታ አጥርናርንካ 12 ሳአ፥ <verse eid="REV 7:5"/><verse number="6" style="v" sid="REV 7:6"/>አሰርታ አጥርናርንካ 12 ሳአ፥ ንፍታሌምታ አጥርናርንካ 12 ሳአ፥ ምናሰታ አጥርናርንካ 12 ሳአ፥ <verse eid="REV 7:6"/><verse number="7" style="v" sid="REV 7:7"/>ስምኦንታ አጥርናርንካ 12 ሳአ፥ ለዊ። አጥርናርንካ 12 ሳአ፥ ይሳኮረታ አጥርናርንካ 12 ሳአ፥ <verse eid="REV 7:7"/><verse number="8" style="v" sid="REV 7:8"/>ዛብሎንታ አጥርናርንካ 12 ሳአ፥ ዮሴፍታ አጥርናርንካ 12 ሳአ፥ ብንያመታ አጥርናርንካ 12 ሳአ።<verse eid="REV 7:8"/></para>
  <para style="s1">ጫምሳ አፍላ ቆበርስባብ በድ ዎርሰንከስ</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 7:9"/>ኮታ ቡር Ꮊየነረ ፋይዳካንታ ማዳክን ሰድቴ፥ ከተረ ዎርሰናርንኬ አጥርናርንካ ኮችናርንኬ Ꮊክ Ꮊክ አፈካ ኬዝድባብ ሙደናርንካ ዉተድባብከሰኬ፥ ኬታኬና ጫምሳ አፍላ ቆበርሶ፥ መጨም ይንታ አንዘን የድሰኮ ባንችምንከስ ዶቅድን ጎንገንተኬ ቆለንንታ እሪ ዎእሰኮ Ꮊቄ። <verse eid="REV 7:9"/><verse number="10" style="v" sid="REV 7:10"/>አንድር ኡፍስካ ፍፈረኮ፥</para>
  <para style="q1" vid="REV 7:10">“አቅስና Ꮊፈርድንዳ ባንችምንከስ ዶቅድን</para>
  <para style="q2" vid="REV 7:10">ጎንገንዘን ዶቅስባብ ዎንታ ጮይስንካንተኬ ቆለንንካንቴ!” ጋይድ Ꮊቄ።<verse eid="REV 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 7:11"/>ክታይንችንከስ ሙዳ ባንችምንከስ ዶቅድን ጎንገንተኬ ጋልተንከስታ፥ ኦይድ ሰንፔካ ዶቅድባብ ፍዝርንከስታ ካንተንካ ዎእሶ Ꮊቄ፥ ባንችምንከስታ ዶቅንት ጎንገንታ እሪ ኬታ ይንታ ባለንካ ጉፕን ጋይሰኮ ሳብካንታ ጎስትሰኬ። <verse eid="REV 7:11"/><verse number="12" style="v" sid="REV 7:12"/>ኩነረ ጋይሰኬ፥</para>
  <para style="q1" vid="REV 7:12">“አምንኤ! ጎፍስ፥ ዴእስ፥ ኤጫ፥</para>
  <para style="q1" vid="REV 7:12">ጋለት፥ ቦንቻ፥ ዎልቃ፥ ዛብንታ፥</para>
  <para style="q2" vid="REV 7:12">ዎንታ ጮይስንካንታ ስለንክንደትዘንካ ስለንካ የለልታ ማታ! አምንኤ”።<verse eid="REV 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13"/>ጋልተንከሳርንካ ዋልቀና ፈንክ እዝደር ዋልን ጋይሶ “ኬና ጫምሳ አፍለንም ቆበርስባብ Ꮊይከሰረ? Ꮊምንከክ Ꮊዳራ?” እዝደር ጋይሴ።<verse eid="REV 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 7:14"/>እተረ “ጮይስዮ፥ የና ኤዝደዬ” ክደር ጋይሳቴ። ኖየረ ኩን እዝደር ጋይሴ፥ “ከታኬና አንድር ማጠንም ስግሰኮ Ꮊድባብከሰኬ፥ ኬታ ይንታ አፍለንመረ ቆለንንታ ማቀስንካ ስእሰኮ ጫምሳ ማስተኬ፥<note caller="-" style="x"><char style="xo" closed="false">7፡14 </char><char style="xt" closed="false"><ref loc="DAN 12:1">ዳን. 12፡1</ref>፤ <ref loc="MAT 24:21">ማቶ. 24፡21</ref>፤ <ref loc="MRK 13:19">ማር. 13፡19</ref>። </char></note> <verse eid="REV 7:14"/><verse number="15" style="v" sid="REV 7:15"/>ኮካንታ ሳብታ ባንችም ጎንገንታ እሪ ማትሶ ሶይትኬ Ꮊየካ ሳብታ ጭል ኤሄናር ክትካንታ ፍግዝደኬ፥ ባንችምንከስ ዶቅድን ጎንገንዘን ዶቅስባበረ ኬታ ገችንቴታ ካሪ ማተሬ። <verse eid="REV 7:15"/><verse number="16" style="v" sid="REV 7:16"/>ይና ኮዘንካ ኦስ ከትም ዳቃዬ፥ ኬታ ቡዳ ዎቻዬ፥ Ꮊይነረ ከትም አታዬ፥ ኦይጥምነረ ከትም ማእስተራክዬ፥<note caller="-" style="x"><char style="xo" closed="false">7፡16 </char><char style="xt" closed="false"><ref loc="ISA 49:10">ኢሳ. 49፡10</ref>። </char></note> <verse eid="REV 7:16"/><verse number="17" style="v" sid="REV 7:17"/>ባንችምንከስታ ዶቅንት ጎንገንታ ዎክያር ዶቅድባብ ቆለና ኬታ ግስመንባብ ማተረ፥ ኦስ ዶቅንት ሎቀን ቱትንደረረ ከትም ጎርስተሬ፥ ሳብ ኤርመንም ሙዳ ኬታ አፍንዘንካ ሱተሬ”።<note caller="-" style="x"><char style="xo" closed="false">7፡17 </char><char style="xt" closed="false"><ref loc="PSA 23:1">የቺ 23፡1</ref>፤ <ref loc="EZK 34:23">ሕዝ. 34፡23</ref>፤ <ref loc="PSA 23:2">የቺ 23፡2</ref>፤ <ref loc="ISA 49:10">ኢሳ. 49፡10</ref>፤ <ref loc="ISA 25:8">25፡8</ref>። </char></note><verse eid="REV 7:17"/></para>
  <chapter eid="REV 7"/>
  <chapter number="8" style="c" sid="REV 8"/>
  <para style="s1">ታብስ ማይተምንታ ፎችምና</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1"/>ቆለና ታብስ ማይተምን ፎቻንደትካ ዋልቃ ሳዓት ባንግ ማታባብ ጫምንጋይንታ ጭለዘን ማቼ፥ <verse eid="REV 8:1"/><verse number="2" style="v" sid="REV 8:2"/>ሳብታ እሪ ዎእድባብከስመረ ታብዛ ክታይንችን ሰድቴ፥ ከትካንታ ታብዛ ፍቼንከስም እምምሴ።<verse eid="REV 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 8:3"/>ዎርቀካ ኡርስምሳን እጣን ጩፍሰርድንደትም የጅባብ አብ ክታይንች Ꮊድሶ ካሲን ካሰርድንደታ ላማር ዎእሴ፥ ባንችምንከስ ዶቅድን ጎንገንታ እሪ ዶቅድን ዎርቀካ ኡርሰርሳን ካሲ ካርንዘን ሳብካንታ ፋስምስባብከስታ ምክስንካ ክክን እምድንደትም በድ እጣን ክትካንታ እምምሴ።<note caller="-" style="x"><char style="xo" closed="false">8፡3 </char><char style="xt" closed="false"><ref loc="AMO 9:1">አሞ. 9፡1</ref>፤ <ref loc="EXO 30:1">ዉት. 30፡1</ref>፥<ref loc="EXO 30:3">3</ref>። </char></note> <verse eid="REV 8:3"/><verse number="4" style="v" sid="REV 8:4"/>እጣንንታ ጩበና ሳብካንታ ፋስምስባብከስታ ምክስንካ ክክን ክታይንችንታ አንናርንካ ሳብታ እሪ የልሴ። <verse eid="REV 8:4"/><verse number="5" style="v" sid="REV 8:5"/>ኮታ ቡር ክታይንችና እጣንን ጩፍሰርድንደትም የድሶ ካሲንታ ኖሄንም ጮችሶ ጩላ ፍጨዘን ኦይቼ፥ ጉግን፥ አንድር ኡፍስ፥ ዋልቅንትኬ ፍጨታ ሶየረ ማቼ።<note caller="-" style="x"><char style="xo" closed="false">8፡5 </char><char style="xt" closed="false"><ref loc="LEV 16:12">ሌዊ. 16፡12</ref>፤ <ref loc="EZK 10:2">ሕዝ. 10፡2</ref>፤ <ref loc="EXO 19:16">ዉት. 19፡16</ref>፤ <ref loc="REV 11:19">ለም. 11፡19</ref>፤ <ref loc="REV 16:18">16፡18</ref>። </char></note><verse eid="REV 8:5"/></para>
  <para style="s1">ፍቼንከስታ ፉግምና</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6"/>ታብዛ ፍቼንከስም የጅባብከስ ታብዛ ክታይንችና ኬታ ይንታ ፍቼንከስም ፉግካንታ ግግምሰኬ።<verse eid="REV 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 8:7"/>እርንባብ ክታይንችና ይንታ ፍቼንም ፉግዜ፥ ማቀስ ቡቅምሳንዳ አዝኬ ኖሄካ ማቼ፥ ፍጨዘነረ ኦይትምሴ፥ ፍጨንታ ቃይና ዋልቀና አቼ፥ Ꮊቀንከስተረ ቃይና ዋልቀና አቼ፥ ጮልሳን ድረነረ ሙዳ አቼ።<note caller="-" style="x"><char style="xo" closed="false">8፡7 </char><char style="xt" closed="false"><ref loc="EXO 9:23-25">ዉት. 9፡23-25</ref>፤ <ref loc="EZK 38:22">ሕዝ. 38፡22</ref>። </char></note><verse eid="REV 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8"/>ቃስትምስ ክታይንችነረ ይንታ ፍቼንም ፉግዜ፥ አንድር ገቼም ካምድንዳ ሪ ኖሀግንዳ የደሮ ባሀርናር ኦይትምሴ፥ ባሀርንታ ቃይና ዋልቀና ማቀስ ማቼ። <verse eid="REV 8:8"/><verse number="9" style="v" sid="REV 8:9"/>ባሀርንታ ዋር ዶቅድባብከሳርንካ ሰንፓ ዶቅድን ፍዝርንከሳርንካ ቃይና ዋልቀና ደእሴ፥ ሎቀንዘንካ ቃልዝድን ማርከብንከስታ ቃይና ዋልቀና ካይዴ።<verse eid="REV 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10"/>ማክምስ ክታይንችነረ ይንታ ፍቼን ፉግዜ፥ ዞጳግንዳ አድንዳ አንድር ቤዝ ጭላርንካ ዋቼ፥ ዋቻንደረ ጋብ ሎቀንከስተኬ ቱት ሎቀንከስታ ቃይነንዘኔ።<note caller="-" style="x"><char style="xo" closed="false">8፡10 </char><char style="xt" closed="false"><ref loc="ISA 14:12">ኢሳ. 14፡12</ref>። </char></note> <verse eid="REV 8:10"/><verse number="11" style="v" sid="REV 8:11"/>ቤዝንተረ ላምና ጋራ ጋይምዴ፥ ሎቀንተረ ቃይና ዋልቀና ጫቅምድንዳ ማቼ፥ ጫቅምድንዳ ማቻን ሎቀንዘንካ አምሳንዳ በድ ኤድንከስ ደእሰኬ።<note caller="-" style="x"><char style="xo" closed="false">8፡11 </char><char style="xt" closed="false"><ref loc="JER 9:15">ኤር. 9፡15</ref>። </char></note><verse eid="REV 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12"/>ኦይችምስ ክታይንችና ይንታ ፍቼን ፉግዜ፥ ጭለዘን Ꮊይንተረ ቃይና ዋልቀና፥ አርፈንተረ ቃይና ዋልቀና፥ ቤዝንከስታ ቃይና ዋልቀና ጉጵምሴ፥ ኮካንታ ኬታ ቃይና ዋልቀና ኡምሴ፥ ኮግንደካ ሰጨታ ቃይና ዋልቀንኬ ሶይትታ ቃይና ዋልቀና ሳክስክሳ ነገዴ።<note caller="-" style="x"><char style="xo" closed="false">8፡12 </char><char style="xt" closed="false"><ref loc="ISA 13:10">ኢሳ. 13፡10</ref>፤ <ref loc="EZK 37:7">ሕዝ. 37፡7</ref>፤ <ref loc="JOL 2:10">ኢዩ. 2፡10</ref>፤ <ref loc="JOL 3:15">3፡15</ref>። </char></note><verse eid="REV 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 8:13"/>ኮታ ቡር እ ሰድንካ ዋልቃ Ꮊካር ጭለዘን ፈተሮ አንድር ኡፍስካ “ነግድባብ ማኬን ክታይንችንከስ ኬታ ይንታ ፍቼንታ ኡፍስን ከት ኤስምዝድንደትካ ፍጨዘን ዶቅድባብ ኤድንከስካንታ የኤ! የኤ! የኤ!” ጋየሮ ፍብድንካ ኤሰርሳቴ።<verse eid="REV 8:13"/></para>
  <chapter eid="REV 8"/>
  <chapter number="9" style="c" sid="REV 9"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1"/>ዶንቅስ ክታይንችና ይንታ ፍቼን ፉግዜ፥ ጭላርንካ ፍጫር ዋቻን ዋልቃ ቤዝንም ሰድቴ፥ ጩልጩል ጎርንም ፎጅድንደትም ክትካንታ እምምሴ። <verse eid="REV 9:1"/><verse number="2" style="v" sid="REV 9:2"/>ኖየረ ጩልጩል ጎርንም ፎቼ፥ ባካርንካ አንድር ጩባ ዉድንግንዳ ማትሶ ጩባ ጩልጩል ጎርናርንካ ዉተዴ፥ ጎርናርንካ ዉተዳን ጩበንጎካ Ꮊይኬ ሳግዝድን ዞገንካ ኡምሰኬ፥<note caller="-" style="x"><char style="xo" closed="false">9፡2 </char><char style="xt" closed="false"><ref loc="GEN 19:28">ፍዝ. 19፡28</ref>። </char></note> <verse eid="REV 9:2"/><verse number="3" style="v" sid="REV 9:3"/>ጩበንታ ዋርንካ ኤይከንንከስ ፍጨዘን ዉተደኬ፥ ፍጨዘን Ꮊንገርጭንከስታ ዎልቀን ካምድንዳ ዎልቃ ከትካንታ እምምሴ፥<note caller="-" style="x"><char style="xo" closed="false">9፡3 </char><char style="xt" closed="false"><ref loc="EXO 10:12-15">ዉት. 10፡12-15</ref>። </char></note> <verse eid="REV 9:3"/><verse number="4" style="v" sid="REV 9:4"/>ፍጨንታ ድረነረ ማታ Ꮊምንመረ ጮልሳን ሪ አነረ Ꮊምንመረ Ꮊቀን ከት ካይዝዳክንግንዳ ከትካንታ ኬዝምሴ፥ ኡፈልስ ከትም ዝግዝድንዳ ማቼ ኬታ ባለንዘን ሳብታ ማይተምና ካየንባብ ኤድንከስም Ꮊክ Ꮊቄ።<note caller="-" style="x"><char style="xo" closed="false">9፡4 </char><char style="xt" closed="false"><ref loc="EZK 9:4">ሕዝ. 9፡4</ref>። </char></note> <verse eid="REV 9:4"/><verse number="5" style="v" sid="REV 9:5"/>ኬትመረ ማቼ ዶንቅ አርፍ ከትም ማእስካንታ ዳት ከት ደይዝድንግንዳ ጋይማክዬ፥ ኤይከንንከስ ከታዘን የልስሳን ማጠና Ꮊንገርጭ ኤድም ጋእድንካ ኤስምድንደትግንዴ። <verse eid="REV 9:5"/><verse number="6" style="v" sid="REV 9:6"/>ኬትኬና ሰጨናይካ ኤድንከስ ደእንም ዝግተረኬ፥ ኬዛርካ ማቼ Ꮊፋየኬ፥ ደእካንታ አንገርደኬ፥ ኬዛርካ ማቼ ደእና ከታዘንካ Ꮊዝተሬ።<note caller="-" style="x"><char style="xo" closed="false">9፡6 </char><char style="xt" closed="false"><ref loc="JOB 3:21">ኢዮብ 3፡21</ref>፤ <ref loc="JER 8:3">ኤር. 8፡3</ref>። </char></note><verse eid="REV 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7"/>ኤይከንንከስ ዳምንካንታ ግግምስባብ ፋረንከስም ካምደኬ፥ ኬታ ማተንዘን ዎርቀታ ዛዉደም ካምድን ሪ Ꮊቄ፥ ኬታ ባለነረ ኤታ ባለም ካምዴ፥<note caller="-" style="x"><char style="xo" closed="false">9፡7 </char><char style="xt" closed="false"><ref loc="JOL 2:4">ኢዩ. 2፡4</ref>። </char></note> <verse eid="REV 9:7"/><verse number="8" style="v" sid="REV 9:8"/>ማነታ ማተም ካምድን ማታ ኬታ Ꮊቄ፥ ኬታ አችነረ ዞበታ አችም ካምዴ፥<note caller="-" style="x"><char style="xo" closed="false">9፡8 </char><char style="xt" closed="false"><ref loc="JOL 1:16">ኢዩ. 1፡16</ref>። </char></note> <verse eid="REV 9:8"/><verse number="9" style="v" sid="REV 9:9"/>ስብልካ ኡርሰርሳንደትም ካምድንዳ ዳምንᎺይካ ኦንገዝን አመቸርድንዳ ኬታ Ꮊቄ፥ ኬታ ከፍንታ ኡፍስና ዳምደር ዞድን በድ ፋረስንከስኬ ፋረንከስ ጎጅድን ሳርገለንከስ ኤስምዝድን ኡፍስም ካምዴ።<note caller="-" style="x"><char style="xo" closed="false">9፡9 </char><char style="xt" closed="false"><ref loc="JOL 2:5">ኢዩ. 2፡5</ref>። </char></note> <verse eid="REV 9:9"/><verse number="10" style="v" sid="REV 9:10"/>Ꮊንገርጭታ ጎልግንደኬ ኦቅነንዳ ኬታ ዶቅዴ፥ ኬታ ጎልንታ ዋር ኤድንከስም ዶንቅ አርፍታ ከት ኡፈልዝድንደታ ዎልቃ ኬታ Ꮊቄ። <verse eid="REV 9:10"/><verse number="11" style="v" sid="REV 9:11"/>ባንቸረ ኬታ ዶቅዴ፥ ኖ ጩልጩል ጎርንታ ክታይንቼ፥ ክታ ላምነረ እብራይስጥ አፈካ አባዶን፥ ግርክ አፈካ አጶልዮን ጋይምዴ፥<note caller="+" style="f"><char style="fr" closed="false">9፡11 </char><char style="ft" closed="false">አባዶንይ ጋይንት ካይስባብ ጋይንትዬ </char></note><verse eid="REV 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12"/>እሪንደና የኤና ስገቴ፥ ይና ኮታ ቡር አብ ቃስቴን የኤና አክ Ꮊዴ።<verse eid="REV 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13"/>ላስ ክታይንችና ይንታ ፍቼን ፉግዜ፥ ይና ሳብታ እሪ ዶቅድን ዎርቅካ ኡርስምሳንደታርንካ ካሰርድንደት ባአልንከሳርንካ ኡፍስ ዉድንካ ኤሰርሳቴ።<note caller="-" style="x"><char style="xo" closed="false">9፡13 </char><char style="xt" closed="false"><ref loc="EXO 30:1-3">ዉት. 30፡1-3</ref>። </char></note> <verse eid="REV 9:13"/><verse number="14" style="v" sid="REV 9:14"/>ኡፍስነረ ፍቼን የጅባብ ላስን ክታይንችን፥ “ባካ ሎቀን ኤፍራጥሰታ ዋር ዞከርስባብከስም ኦይድ ክታይንችንከስም ቡልካ!” ክትም ጋይሴ። <verse eid="REV 9:14"/><verse number="15" style="v" sid="REV 9:15"/>ኮትኮ ሳዓትንኬ ኮትኮሰጨንካ፥ ኮትኮ አርፈንኬ ኮትኮ ስለንታ ግግምስባብ ኦይድ ክታይንች ኤታ ሱሳርንካ ቃይና ዋልቃ ከት ደይዝድንግንዳ ቡልምሰኬ። <verse eid="REV 9:15"/><verse number="16" style="v" sid="REV 9:16"/>ፋረንካ ዳምድባብከስታ በድምና ቃስቴን ጸታ ምሎን ማድንደትም ኤሰርስቴ። <verse eid="REV 9:16"/><verse number="17" style="v" sid="REV 9:17"/>ፋረንከስምኬ ፋረንከዘን ዶቅስባብ ኤድንከስም ለምለም ጋይድንካ እ ሰዳንዳ ኮግንዳ Ꮊቄ፥ ዳምንᎺይካ ኬታ ኦንገዝን አመቸርድንዳ ስብልካ ኡርሰርሳንዳ ኖሄታ ዎልስም ዘይም፥ ቦንችምሳን ሰይን ጫልምኬ ጫላጫል፥ ድግዳክን አድን ኖሀ ፋርጨም ካምድንዳ Ꮊቄ፥ ፋረንከስተረ ቃደና ዞበታ ቃደም ካምዴ። ኬታ አፈናርንካ ኖሄከ ጩበካ ድን ጋየርድንደረ ዉድ Ꮊቄ፥ <verse eid="REV 9:17"/><verse number="18" style="v" sid="REV 9:18"/>ከታ ይንታ አፈናርንካ ከት ዉችሳን ኖሄንኬ ጩበንካ ድግዳክን አድን ኖሀ ከትኬ ማከን ጋዳ ሰቅምንከስካ ኤታ ሱሳ ቃይና ዋልቀና ደይስምሴ። <verse eid="REV 9:18"/><verse number="19" style="v" sid="REV 9:19"/>ፋረንከስታ ዎልቀና ኬታ አፋርኬ ኬታ ጎልያርኬ። ኬታ ጎልና ጉንም ካምዴ፥ ጉንታ ቃደረ ዶቅዴ፥ ኤድመረ ከት ኡፈልዝድንዳ ኮትኬ።<verse eid="REV 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 9:20"/>ኬትኬ ጋዳ ሰቅምንከስካ ደእናርንካ አቅባብ ኤታ ሱሰንከስ ኬታ ይንታ አን ፍክስንዘንካ ማትሰኮ ጎማይንታፍክስን ዎይሳከኬ፥ ግምዘንከስምኬ ዎርቀዘንካ፥ ዱንድዘንካ፥ ጋይዘንካ፥ ሰይንዘንኬ Ꮊቀዘንካ ፍክስምስባብከስ ሰድን አነረ ኤሰር አነረ ሙክንትካንታ ማዳክባብ ጮይስ ማታክባብከስም ጎይንንም ዛቃከኬ።<note caller="-" style="x"><char style="xo" closed="false">9፡20 </char><char style="xt" closed="false"><ref loc="PSA 115:4-7">የቺ 115፡4-7</ref>፤ <ref loc="PSA 135:15-17">135፡15-17</ref>፤ <ref loc="DAN 5:23">ዳን. 5፡23</ref>። </char></note> <verse eid="REV 9:20"/><verse number="21" style="v" sid="REV 9:21"/>ኮትኮግንደረ ሰንፔም ኬታ ይ ደይዝድንደታርንካ፥ ኬታ ይንታ ብድንደታርንካ፥ ኬታ ይንታ ቤልምንዘንካ፥ ኬታ ይንታ ድብንመረ ድብደክ ዳት ጎማፍክስን ዎይሳየኬ።<verse eid="REV 9:21"/></para>
  <chapter eid="REV 9"/>
  <chapter number="10" style="c" sid="REV 10"/>
  <para style="s1">ክታይንችንኬ ቁርምድንዳ መራ ማጻፍና</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1"/>ኮታ ቡር ኡፔም ቆበርስባብ አብ ዳቅማ ክታይንች ጭለዘንካ Ꮊንቸርድንካ ሰድቴ፥ ክታ ማተንዘን ዙላ Ꮊቄ፥ ክታ ባለና ጭለዘን Ꮊይግንዳ፥ ክታ ዱትንከሰረ ኖሄታ ሎግንችንግንዳ ዎእሳንዳ Ꮊቄ፥ <verse eid="REV 10:1"/><verse number="2" style="v" sid="REV 10:2"/>ፎችምሳንዳ ቁርምድን መራ ማጻፍን ይንታ አንያር የድሶ Ꮊቄ፥ ምዝ ይንታ ዱትን ባሀርንዘን፥ ከች ይንታ ዱትንከረ ፍጨዘን ሙክሴ፥ <verse eid="REV 10:2"/><verse number="3" style="v" sid="REV 10:3"/>ክታ አንግልነረ ዞበንታ ኡፍስን ካምድን አንድር ኡፍስከረ ኦልሴ፥ ኦልሳንደትከረ ታብዛ ጉግንንከስ ኬታ ይንታ ኡፍስን ኤስምሰኬ። <verse eid="REV 10:3"/><verse number="4" style="v" sid="REV 10:4"/>ታብዛ ጉግንንከስ ኬታ ይንታ ኡፍስንም ኤስምሳንደትካ እታ ጻፍካንታ ገቀርስቴ፥ ኬዛርንካ ማቼ “ታብዛ ጉግንንከስ ከት ኬዛንደትም ቡዳር አቼካ የድካ ዳት Ꮊይ ጻፌ!” ጋይድን ኡፍስ ጭላርንካ ኤሰርሳቴ።<verse eid="REV 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5"/>ኮታ ቡር ባሀርንዘንኬ ፍጨዘን ዎእሶ ዶቅድንካ እ ሰድባብ ክታይንችና ይንታ ምዝ አንን ፈስ ጭላር አምስስንደትኬ፥ <verse eid="REV 10:5"/><verse number="6" style="v" sid="REV 10:6"/>ስለንክንደትዘንካ ስለንካ የለልታ ዶቅድባብካ፥ ጭለምንኬ ኮተረ ዋር ዶቅድባብከስም፥ ፍጨምንኬ ኮታር ዶቅድባብከስም፥ ባሀርንምኬ ኮታር ዶቅድባብከስም ፍዝባብታ ላምካ ጫቅሶ ኩን ጋይሴ፥ “ይና ኮዘንካ ኦስ ጋምአዬ! <verse eid="REV 10:6"/><verse number="7" style="v" sid="REV 10:7"/>ኬዛርንካ ማቼ ታብስ ክታይንችና ፍቼንም ክት ኤስምዝድን ሰጨንከስካ ሳብዘንካ ኤሰርሶ ኬዛቅባብ ሳብታ ፍክስንባብከስካንታ ኤስምሳንግንዳ ሳብታ አችምሳን ኬዘና ቦድምዴ”። <note caller="-" style="x"><char style="xo" closed="false">10፡7 </char><char style="xt" closed="false"><ref loc="EXO 20:11">ዉት. 20፡11</ref>፤ <ref loc="DEU 32:40">ካሪ. 32፡40</ref>፤ <ref loc="DAN 12:7">ዳን. 12፡7</ref>፤ <ref loc="AMO 3:7">አሞ. 3፡7</ref>። </char></note><verse eid="REV 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 10:8"/>ኮታ ቡር ጭላርንካ እ ኤሰርሳን ኡፍስና “ባሀርንዘንኬ ፍጨዘን ዎእስባብ ክታይንችንታ አንዘን ዶቅድንደትምኬ ቁረርሳን ማጻፍን ፎችምሳንደትም አይሳዮ ተይካ” ጋየሮ አናካርንካ እም ኬዜ።<verse eid="REV 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 10:9"/>ክታይንችንደረረ አይስቶ “መረን ቁርምድን ማጻፍን እካንታ እምካ” ክደር ጋይስቴ፥ ኖየረ “ተይሰዮ ኮትም እችካ፥ የስታ ልጴናረረ ጫቅምድንዳ ማተረ፥ የስታ አፋር ማቼ ኩርግንዳ ሎቅተረ” እም ጋይሴ።<verse eid="REV 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 10:10"/>እተረ መራ ቁርምድን ማጻፍን ክታይንችንታ አንናርንካ ተይስቶ ኮትም እቻቴ፥ እስታ አፈናረረ ኩርግንዳ ና ሎቅሴ፥ ኮትም እ እቻንደታ ቡር ማቼ እስታ ልጴናር ጫቅምድንዳ ማቼ።<note caller="-" style="x"><char style="xo" closed="false">10፡10 </char><char style="xt" closed="false"><ref loc="EZR 2:8-33">ዕዝ. 2፡8-33</ref>። </char></note> <verse eid="REV 10:10"/><verse number="11" style="v" sid="REV 10:11"/>ኮታ ቡር “በድ ኮችንከስጎካ፥ ዎርሰንከስ፥ Ꮊክ Ꮊክ አፈካ ኬዝድን ኤድንከስጎኬ ባንችንከስጎካ አናካርንካ ቤርንም ኬዛ የስም ዝግዝዴ” ጋይምሶ እካንታ ኬዝምሴ።<verse eid="REV 10:11"/></para>
  <chapter eid="REV 10"/>
  <chapter number="11" style="c" sid="REV 11"/>
  <para style="s1">ቃስቴን ማርከንከስ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1"/>ኮታ ቡር የርክስካንታ ዝግዝድን ጉፋግንደን ዋልቃ ሽምቦቆ እካንታ እምምሴ፥ ኩነረ እም ጋይሴ፥ “አምካ፥ ሳብታ ጭል ኤሄንምኬ ካሲ ካርን የርክስካ፥ ኮታር ጎይንድባብከስም ፋይድካ፥<note caller="-" style="x"><char style="xo" closed="false">11፡1 </char><char style="xt" closed="false"><ref loc="ZEC 2:1-2">ዘካ. 2፡1-2</ref>። </char></note> <verse eid="REV 11:1"/><verse number="2" style="v" sid="REV 11:2"/>ሳብታ ጭል ኤሄንታ ማልጎካ ዶቅድን ዉች ካርን ማቼ ዛእካ፥ ናኮና ካርና አይሁድ ማታክባብከስካንታ እምምሳንዳ ማቻንካንታ ኮትም Ꮊይ የርክሴ፥ አይሁድ ማታክባብከስ ሳብካንታ ፋስምሳን ካተመን ቃስቴን ቦንደኬ ቃስቴን አርፍ ኮትም ቆልተረኬ፥<note caller="-" style="x"><char style="xo" closed="false">11፡2 </char><char style="xt" closed="false"><ref loc="LUK 21:24">ሉቃ. 21፡24</ref>። </char></note> <verse eid="REV 11:2"/><verse number="3" style="v" sid="REV 11:3"/>ቃስቴን እስታ ማርከንከስ ሞርእታ አፍለን ቆብርሰኮ ዋልቃ ሳአኬ ቃስቴን ጸተኬ ማኬን ቦንዳ ሰጫ ቤርንም ኬዝድንግንዳ ዎልቃ ከትም እምትቴ”።<verse eid="REV 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 11:4"/>ኬታ ፍጨዘነረ ጮይስታ እሪ ዎእድባብ ቃስቴን ዎይራ Ꮊቀንከስኬ ቃስቴንና ኬታ ቃስቴን ዞጰን ዎደርድን ካርንከሰኬ፥<note caller="-" style="x"><char style="xo" closed="false">11፡4 </char><char style="xt" closed="false"><ref loc="ZEC 4:3">ዘካ. 4፡3</ref>፥<ref loc="ZEC 4:11-14">11-14</ref>። </char></note> <verse eid="REV 11:4"/><verse number="5" style="v" sid="REV 11:5"/>Ꮊየነረ ከትም ኡፈልስካንታ ዝግዴ ኖሀ ኬታ አፈናርንካ ዉትሶ ኬታ ይምኤንባብከስም አዴ፥ ከትም ኡፈልስካንታ ዝግድባብ ሙደና ደእድንዳ ኮግንደኬ። <verse eid="REV 11:5"/><verse number="6" style="v" sid="REV 11:6"/>ኬታ ቤርን ከትካንታ ኬዝድን ከትኬ ሰጨንከስካ ዶብ ቃንዳክንግንዳ ጭለንም ዝጭካንታ ገችታ ኤራ ኬታ ዶቅዴ፥ ኮትኮግንደረ ሎቀንከስም ማቀስ ማስካንተከ፥ ኬታ ይ ዝግዛንᎺይከረ ሙዳ Ꮊምን ጎግከረ ጋዳ ሰቅምንካ ፍጨንም ካይስካንታ ገችታ ኤራ ኬታ ዶቅዴ።<note caller="-" style="x"><char style="xo" closed="false">11፡6 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1 ባንቺ. 17፡1</ref>፤ <ref loc="EXO 7:17-19">ዉት. 7፡17-19</ref>፤ <ref loc="1SA 4:8">1 ሳሙ. 4፡8</ref>። </char></note><verse eid="REV 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7"/>ኬታ ይንታ ማርከርን ከት በይሳን ቡር ጩልጩል ጎርናርንካ ዉድን ባችርና ከትካ ክክን ዳምሶ ከትም ጋምዴ፥ ከትም ደይስተረኬ፥<note caller="-" style="x"><char style="xo" closed="false">11፡7 </char><char style="xt" closed="false"><ref loc="DAN 7:7">ዳን. 7፡7</ref>፥<ref loc="DAN 7:21">21</ref>፤ <ref loc="REV 13:5-7">ለም. 13፡5-7</ref>፤ <ref loc="REV 17:8">17፡8</ref>። </char></note> <verse eid="REV 11:7"/><verse number="8" style="v" sid="REV 11:8"/>ኬታ ለይስነረ ካምስካ ኤልምድዮ ሶዶም አነረ ግብጽ ጋይምድን አንድር ካተመንታ መለንዘን ዋችተረ፥ ናኮና ካተመነረ ኬታ ጮይስና ሮከርሳንዴ።<note caller="-" style="x"><char style="xo" closed="false">11፡8 </char><char style="xt" closed="false"><ref loc="ISA 1:9-10">ኢሳ. 1፡9-10</ref>። </char></note> <verse eid="REV 11:8"/><verse number="9" style="v" sid="REV 11:9"/>Ꮊክ Ꮊክ ኮችኬ፥ አጥር፥ Ꮊክ Ꮊክ አፋ ኬዝድባብከስኬ ዎርሰንከስካ ማኬን ሰጨኬ ባንግካ ኬታ ለይስንም ሰደኬ፥ ኬታ ለይስና ዱክምዳክንግንዳ ማርደኬ። <verse eid="REV 11:9"/><verse number="10" style="v" sid="REV 11:10"/>ኬታኬና ቃስቴን ሳብዘንካ ኤሰርሶ ኬዝድባብከስ ፍጨንዘን ኤድንከስም ማእዝድ ከትᎺቃንካንታ ፍጨዘን ዶቅድን ኤድንከስ ሳብዘንካ ኤሰርሶ ኬዝድባብከስታ ደእንካ ኬታ ጉርምሰኬ፥ ጉርምከረ ባአል ግግዝደኬ፥ ክክ ክክካንተረ እመንም እምደኬ። <verse eid="REV 11:10"/><verse number="11" style="v" sid="REV 11:11"/>ኬዛር ማቼ ማኬን ሰጨኬ ባንግካ ስገዳን ቡር ሰንፓ እምድንዳ ኡፍስ ሳብደርንካ Ꮊድሶ ለይስንከሳር አርደዴ፥ ኬታ ይንታ ዱትንከረ ዎእሰኬ፥ ከትም ሰጃን ኤድንከሰረ አንድር ጳሰኬ።<note caller="-" style="x"><char style="xo" closed="false">11፡11 </char><char style="xt" closed="false"><ref loc="EZK 37:10">ሕዝ. 37፡10</ref>። </char></note> <verse eid="REV 11:11"/><verse number="12" style="v" sid="REV 11:12"/>ኮታ ቡር ቃስቴን ሳብዘንካ ኤሰርሶ ኬዛቅባብከስ “ኮር ጨዳ ዉትከቴ!” ጋይድን አንድር ኡፍስ ጭላርንካ ኤሰርሰኬ፥ ኬታ ይምኤንባብከሰረ ከትም ሰድንካ ኡፔካ ፈስ ጭላር አይሰኬ።<note caller="-" style="x"><char style="xo" closed="false">11፡12 </char><char style="xt" closed="false"><ref loc="2KI 2:11">2 ባንቺ. 2፡11</ref>። </char></note> <verse eid="REV 11:12"/><verse number="13" style="v" sid="REV 11:13"/>ኮት ሳዓትንካ አንድር ፍጨታ ሶይ ማቼ፥ ካተመንተረ ቃይና ዋልቀና ዋቼ፥ ፍጨና ሶይሳንጎከረ ታብዛ ሳአ ኤድንከስ ደእሰኬ፥ ደእናርንካ አቅባብከስ አንድር ጳሰኬ፥ ጭላር ጮይስንመረ ቦንችሰኬ።<note caller="-" style="x"><char style="xo" closed="false">11፡13 </char><char style="xt" closed="false"><ref loc="REV 6:12">ለም. 6፡12</ref>፤ <ref loc="REV 16:18">16፡18</ref>። </char></note><verse eid="REV 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 11:14"/>ቃስትምስ ማጠንታ ሰጨና ስገዴ፥ ይና ማክምስ ማጠንታ ሰጨና ሳነካ Ꮊዴ።<verse eid="REV 11:14"/></para>
  <para style="s1">ታብስ ፍቼና</para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15"/>ታብስ ክታይንችነረ ፍቼንም ፉግዜ፥ ጭላረረ “ፍጫሙደንታ ባንችና ዎንታ ጮይስን ክት ክርስቶስካንታ ማቴ፥ ኖ ስለንክንደትዘንካ ስለንካ የለልታ ባንችምዴ”፥ ጋይድባብከስ አንድር ኡፍስንከስ ኤስምሰኬ።<note caller="-" style="x"><char style="xo" closed="false">11፡15 </char><char style="xt" closed="false"><ref loc="EXO 15:18">ዉት. 15፡18</ref>፤ <ref loc="DAN 2:44">ዳን. 2፡44</ref>፤ <ref loc="DAN 7:14">7፡14</ref>፥<ref loc="DAN 7:27">27</ref>። </char></note> <verse eid="REV 11:15"/><verse number="16" style="v" sid="REV 11:16"/>ሳብታ እሪ ባንችምንከስ ዶቅድን ጎንገንዘን ዶቅስባብከስ ቦንደኬ ኦይድ ጋልተንከሰረ ኬታ ይንታ ባለንካ ጉፕን ጋይሰኮ ሳብካንታ ጎስትሰኬ፥ <verse eid="REV 11:16"/><verse number="17" style="v" sid="REV 11:17"/>ኩነረ ጋይሰኬ፥</para>
  <para style="q1" vid="REV 11:17">ታ ዶቅድባብኬ ኤንገረረ Ꮊቅባብ፥</para>
  <para style="q1" vid="REV 11:17">ሙደና የዝደር ማድባብ ጮይስ ሳብኖ!</para>
  <para style="q2" vid="REV 11:17">አንድር የስታ ገችታ ኤረን የስታ አንያር ማስሳን ካንተኬ</para>
  <para style="q2" vid="REV 11:17">የስ ባንችምሳንካንታ የስም ጋለዶቴ።<verse eid="REV 11:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="REV 11:18"/>አይሁድ ማታክባብከሰረ ዋጨኬ፥</para>
  <para style="q1" vid="REV 11:18">የስተረ ዋጭና Ꮊዴ፥</para>
  <para style="q2" vid="REV 11:18">ደእስባብከሰረ ፋረድምድን ሰጨና የልሴ፥</para>
  <para style="q1" vid="REV 11:18">የስታ ፍክስንባብከስካንታ የዘንካ ኤሰርሶ ኬዛቅባብከስካንታ፥</para>
  <para style="q2" vid="REV 11:18">የስካንታ ፋስምስባብከስካንተኬ የስታ ላምንመረ ቦንጅድባብከስካንታ፥</para>
  <para style="q2" vid="REV 11:18">መረንከስካንተኬ ባከንከስካንታ፥</para>
  <para style="q1" vid="REV 11:18">ኬታ ናክንም የስ እምድንደታ ሰጨና የልሴ፥</para>
  <para style="q2" vid="REV 11:18">ፍጨንም ካይስባብከስም የስ ካይዝድንደታ ሰጨነረ የልሴ፥<note caller="-" style="x"><char style="xo" closed="false">11፡18 </char><char style="xt" closed="false"><ref loc="PSA 2:5">የቺ 2፡5</ref>፤ <ref loc="PSA 110:5">110፡5</ref>፤ <ref loc="PSA 115:13">115፡13</ref>። </char></note><verse eid="REV 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19"/>ጭላር ዶቅድንዳ ሳብታ ጭል ኤሄና ፎችምሴ፥ ክተረ ጫቀታ ታቦትና ሳብታ ጭል ኤሄናር Ꮊፈርሴ። ዋልቅንት፥ አንድር ኡፍስ፥ ጉግን፥ ፍጨታ ሶይኬ አንድር አዘረ ማቼ።<note caller="-" style="x"><char style="xo" closed="false">11፡19 </char><char style="xt" closed="false"><ref loc="REV 8:5">ለም. 8፡5</ref>፤ <ref loc="REV 16:18">16፡18</ref>፥<ref loc="REV 16:21">21</ref>። </char></note><verse eid="REV 11:19"/></para>
  <chapter eid="REV 11"/>
  <chapter number="12" style="c" sid="REV 12"/>
  <para style="s1">ኤተንንኬ ቃርንካ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1"/>ኮታ ቡር አንድርኬ በርእስዝድን ቃዉታ ጭለዘን ሰድምሴ፥ Ꮊይም ቆበርሳንዳ፥ አርፈንም ይንታ ዱትንታ ጎያር ማስሳንዳ፥ ታመኬ ቃስቴን ቤዝንከስም ዛዉዳግንዳ ይንታ ማተንዘን ዎጃንዳ፥ ዋልቃ ኤተን ሰድምሴ። <verse eid="REV 12:1"/><verse number="2" style="v" sid="REV 12:2"/>ናየረ ስርማ Ꮊቄ፥ አጥማካንተረ እችረት ኮትም የጅንካ ማጠርሶ ፍብድ Ꮊቄ፥<verse eid="REV 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 12:3"/>ኮትኮግንደረ አብ ቃዉታ ጭለዘን ሰድምሴ፥ ታብዛ ቃደንከስኬ ታማ ባልንከስ Ꮊቅባብ አንድር ዘይም ቃሪ ሰድምሴ፥ ይንታ ማተንከዘነረ ታብዛ ዛዉደንከስም ዎታ Ꮊቄ፥<note caller="-" style="x"><char style="xo" closed="false">12፡3 </char><char style="xt" closed="false"><ref loc="DAN 7:7">ዳን. 7፡7</ref>። </char></note> <verse eid="REV 12:3"/><verse number="4" style="v" sid="REV 12:4"/>ይንታ ጎልንካ ቤዝንከስታ ማክምስ ቃይነናርንካ ዋልቀን ጭለዘንካ ባስትዮ ፍጨዘን ከትም ኦይቼ፥ ኤተና አጥድንደትᎺይካ ኮታ ይንችንም ቃሪና ኤቅዝካንታ ገቀርሶ አጥማካንታ የልሳን ኤተንንታ እርጎካ ዎእሴ፥<note caller="-" style="x"><char style="xo" closed="false">12፡4 </char><char style="xt" closed="false"><ref loc="DAN 8:10">ዳን. 8፡10</ref>። </char></note> <verse eid="REV 12:4"/><verse number="5" style="v" sid="REV 12:5"/>ኤተነረ ዎርሰንከስም ሙዳ ይንታ ገችንታ ኤረካ ገችዝድባብ አⷝና ይንችም አጬ፥ ኮታ ይንችና ማቼ ሳብደርኬ ክታ ባንችምንታ ጎንገንደር ተይምሴ፥<note caller="-" style="x"><char style="xo" closed="false">12፡5 </char><char style="xt" closed="false"><ref loc="ISA 66:7">ኢሳ. 66፡7</ref>፤ <ref loc="PSA 2:9">የቺ 2፡9</ref>። </char></note> <verse eid="REV 12:5"/><verse number="6" style="v" sid="REV 12:6"/>ኤተነረ ዴል ቆቼናር Ꮊዝሶ አይሴ፥ ኮታር ዋልቃ ሳአኬ ቃስተን ጸተኬ ማኬን ቦንዳ ሰጫ ካጵስካ የድምሶ ኮት ካርስምድን ካርን ሳብ ኮትካንታ ግግስታ Ꮊቄ።<verse eid="REV 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 12:7"/>ጭላረረ ዳም አምሴ፥ ምካኤልኬ ክታ ክታይንችና ቃርንካ ክክን ዳምሰኬ፥ ቃርንኬ ክታይንችንከሰረ አናካርንካ ዳምሰኬ።<note caller="-" style="x"><char style="xo" closed="false">12፡7 </char><char style="xt" closed="false"><ref loc="DAN 10:13">ዳን. 10፡13</ref>፥<ref loc="DAN 10:21">21</ref>፤ <ref loc="DAN 12:1">12፡1</ref>፤ <ref loc="JUD 1:9">ይሁ. 9</ref>። </char></note> <verse eid="REV 12:7"/><verse number="8" style="v" sid="REV 12:8"/>ኬዛርንካ ማቼ ቃርንኬ ክታ ክታይንችና ጋመርሰኬ፥ ኮተረ ቡር ጭላር ካሪ ከትካንታ Ꮊፈራክዬ። <verse eid="REV 12:8"/><verse number="9" style="v" sid="REV 12:9"/>አንድር ቃርነረ ፈይንካ ጩላ ኦይትምሴ፥ ኖ ፍጫ ሙደን ኮተርዝድባብ ዳብሎስ አነረ ሰጣን ጋይምሶ ኤልምድባብ ኤና እሪ ጉንኔ። ኖ ፍጨዘን ኦይትምሴ፥ ክተረ ክታይንችንከስ ክትካ ክክን የካ ኦይትምሰኬ።<note caller="-" style="x"><char style="xo" closed="false">12፡9 </char><char style="xt" closed="false"><ref loc="GEN 3:1">ፍዝ. 3፡1</ref>፤ <ref loc="LUK 10:18">ሉቃ. 10፡18</ref>። </char></note><verse eid="REV 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 12:10"/>ኮታ ቡር ዋልቃ አንድር ኡፍስ ጭላርንካ ኩን ጋይድንካ ኤሰርሳቴ፥ “ይና አቅስና፥ ዎልቃ፥ ባንችምነረ ዎንታ ጮይስንታ ማቴ! ገችንታ ኤረነረ ክርስቶስካንታ ማቴ! Ꮊረታ ጋይሴ ዎንታ እስመንከስምኬ ምችነንከስም ዎንታ ጮይስንታ እሪ Ꮊየኬ ሶይትካ ካሰዝድᎺቅባብ ኖ ዋችቴ።<note caller="-" style="x"><char style="xo" closed="false">12፡10 </char><char style="xt" closed="false"><ref loc="JOB 1:9-11">ኢዮብ 1፡9-11</ref>፤ <ref loc="ZEC 3:1">ዘካ. 3፡1</ref>። </char></note> <verse eid="REV 12:10"/><verse number="11" style="v" sid="REV 12:11"/>ኬታ ቆለንንታ ማቀስንኬ ኬታ ይ ኬዛን ማርካትቼንታ ቃለንካ ክትም ጋምተኬ፥ ይንታ ሰንፔንካንታ አጨራከክዶቆ ኬታ ይንታ ማተን ደእካንታ ስክስት እምካንታ ግግምተኬ፥ <verse eid="REV 12:11"/><verse number="12" style="v" sid="REV 12:12"/>ኮካንታ ጭለንከስኬ ኬታ ዋረረ ዶቅድባብ የ ሙደን ጉርምሳ! ቶክም ሰጫ ነገዳንደትም የ ኤሳንጎካ ዳብሎስ አንድር ዋጭካ የንደር ኖ Ꮊንቼርቴ፥ ይና ፍጨኬ ባሀርንካ የም የኤ!”<verse eid="REV 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 12:13"/>ቃሪና ፍጨዘን ይ ኦይትምሳንደትም ይ ሰዳንደትካ አⷝና ይንች አጫን ኤተንን ኮትም ዛይክሴ፥ <verse eid="REV 12:13"/><verse number="14" style="v" sid="REV 12:14"/>ኤተና ዴል ቆቼናር ኮትካንታ ግግስምሳን ካርያር ኮት አይድንግንዳ አንድር Ꮊካርንታ ከፍንከስም ካምድን ቃስቴን ከፍንከስ ኮትካንታ እምምሴ፥ ኮታረረ ጉንንታ እሪንካ ጎተርሶ ማኬን ስለኬ ባንግካ ካጵስካ የድምሶ ኮት ካርስምድንግንዴ፥<note caller="-" style="x"><char style="xo" closed="false">12፡14 </char><char style="xt" closed="false"><ref loc="DAN 7:25">ዳን. 7፡25</ref>፤ <ref loc="DAN 12:7">12፡7</ref>። </char></note> <verse eid="REV 12:14"/><verse number="15" style="v" sid="REV 12:15"/>ኤተና ሳፍካ እችምድንግንዳ ጋይሶ ጉንና ጋብሎቃከኬን ሎቃ ይንታ አፋርንካ ዉችሶ ኮታ ቡርጎካ ዉልእሴ። <verse eid="REV 12:15"/><verse number="16" style="v" sid="REV 12:16"/>ኬዛር ማቼ ፍጨና ኤተንንም አላ አልሴ፥ ፍጨነረ ይንታ አፈን ፎችሶ ቃሪና ይንታ አፈናርንካ ዉችሶ ዉልእሳን ሎቀን ጩንጬ። <verse eid="REV 12:16"/><verse number="17" style="v" sid="REV 12:17"/>ቃሪና ኤተንንዘን ሰነርሶ ነግድባብ ኮታ ሱሰንከስካ ክክን ዳምካንታ አይሴ፥ ከተረ ሳብታ ክተንከስም ካርዝድባብከስኬ የሱስካንታ ኣመንምሶ ማርከርድባብከሰኬ። <verse eid="REV 12:17"/><verse number="18" style="v" sid="REV 12:18"/>ቃርነረ ባሀርንታ ካንተዘን ሻምንዘን ዎእሴ።<verse eid="REV 12:18"/></para>
  <chapter eid="REV 12"/>
  <chapter number="13" style="c" sid="REV 13"/>
  <para style="s1">ቃስተን ባችሪንከስ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1"/>ኮታ ቡር ዋልቃ ባችር ባሀርናርንካ ዉድንካ ሰድቴ፥ ታማ ባልንከስኬ ታብዛ ቃደንከስ ክታ ዶቅዴ፥ ባልንከስታ ዘነረ ታማ ዛዉደንከስ ዶቅደኬ፥ ክታ ቃደንከዘነረ ሳብም የግድንዳ ላምንከስ Ꮊቀኬ።<note caller="-" style="x"><char style="xo" closed="false">13፡1 </char><char style="xt" closed="false"><ref loc="DAN 7:3">ዳን. 7፡3</ref>። </char></note> <verse eid="REV 13:1"/><verse number="2" style="v" sid="REV 13:2"/>እ ሰድባብ ባችሪና ኖጠንም ካምድንዳ Ꮊቄ፥ ክታ ዱትነረ ድቢ ጋየርድን ባችሪንታ ዱትንግንዳ፥ ክታ አፈና ዞበታ አፍም ካምድንዴ። ቃሪና ይንታ ዎልቀንኬ ይንታ ባንችምንታ ጎንገን አንድር ገችታ ኤረንም ባችሪንካንታ እምሴ።<note caller="-" style="x"><char style="xo" closed="false">13፡2 </char><char style="xt" closed="false"><ref loc="DAN 7:4-6">ዳን. 7፡4-6</ref>። </char></note> <verse eid="REV 13:2"/><verse number="3" style="v" sid="REV 13:3"/>ባችሪንታ ቃደንከሳርንካ ዋልቀና ደእካንታ የልዝድንዳ ድድ ክታዘን ዶቅድንዳ ማችንካ ሰድቴ፥ ኬዛር ማቼ ደእካንታ ክትም የልዝድንዳ ድድና ኡሴ፥ ኮ ፍጫሙደንዘን ዶቅድን ኤድንከስ በርእካ ባችሪን ጎርስምሴ። <verse eid="REV 13:3"/><verse number="4" style="v" sid="REV 13:4"/>ባችሪንካንታ ገችታ ኤረን ክትካንታ እምምሳንካንታ ኤድንከስ ሙደና ቃሪንካንታ ጎስትሰኬ፥ “ባችሪን ካምድባብ Ꮊይራ? ክትካ ክክን Ꮊይ ዳምካንታ ማዳ?” ጋየረኮ ክት ባችርንካንታ ጎስትሰኬ።<verse eid="REV 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 13:5"/>ኦትረተኬ ሳብም ክት የግድን አፋ ባችሪንካንታ እምምሴ፥ ቃስቴን ቦንደኬ ቃስቴን አርፍ ይንታ ገችታ ኤረንከረ ፍግዝድንግንዳ ክትካንታ ጋይምሴ። <verse eid="REV 13:5"/><verse number="6" style="v" sid="REV 13:6"/>ሳብምኬ ሳብታ ላምን፥ ክታ ዶቅንት ካርንምኬ ጭላር ዶቅድባብከስም የክ የጄ።<note caller="-" style="x"><char style="xo" closed="false">13፡6 </char><char style="xt" closed="false"><ref loc="DAN 7:8">ዳን. 7፡8</ref>፥<ref loc="DAN 7:25">25</ref>፤ <ref loc="DAN 11:36">11፡36</ref>። </char></note> <verse eid="REV 13:6"/><verse number="7" style="v" sid="REV 13:7"/>ሳብካንታ ፋስምስባብከስም ዳምድንግንደኬ ከትም ጋምድንግንዳ ገችታ ኤራ ክትካንታ እምምሴ፥ አጥርያርኬ ኮችናርንካ፥ Ꮊክ Ꮊክ አፈንከስካ ኬዝድባብከስኬ ዎርሳ ሙደንዘን ገችታ ኤራ ክትካንታ እምምሴ።<note caller="-" style="x"><char style="xo" closed="false">13፡7 </char><char style="xt" closed="false"><ref loc="DAN 7:21">ዳን. 7፡21</ref>። </char></note> <verse eid="REV 13:7"/><verse number="8" style="v" sid="REV 13:8"/>ፍጫ ሙደና ፍዝምድንዘንካ የድሶ ኬታ ላምና ባርን ተቸርሳን ቆለንንታ ዶቅንት ማጻፍናር ጻፍማክባብ ኮ ፍጫሙደንዘን ዶቅድባብ ኤድንከስ ሙደና ባችሪንካንታ ጎስተረኬ።<note caller="-" style="x"><char style="xo" closed="false">13፡8 </char><char style="xt" closed="false"><ref loc="PSA 69:28">የቺ 69፡28</ref>። </char></note><verse eid="REV 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 13:9"/>ቃም ዶቅድባብ ሙደና ኤሰራ! <verse eid="REV 13:9"/><verse number="10" style="v" sid="REV 13:10"/>“ዎእስት ተይምካንታ ጋይምስባብ ዎእስት ተይማ፥ ማሴካ ደእድንግንዳ ጋይምስባብ ማሴካ ደእዴ” ይና ሳብካንታ ፋስምስባብከስታ ዳንዳእንኬ አመንካ ዝግዝድንዳ ይና ኮትኮᎺይኬ።<note caller="-" style="x"><char style="xo" closed="false">13፡10 </char><char style="xt" closed="false"><ref loc="JER 15:2">ኤር. 15፡2</ref>፤ <ref loc="JER 43:11">43፡11</ref>። </char></note><verse eid="REV 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11"/>አብ ባችሪየረ አናካርንካ ፍጫርንካ ዉድንካ ሰድቴ፥ ቆልትንግንዳ ቃስቴን ባልንከስ ክታ Ꮊቄ፥ ክታ ኬዘነረ ጉን ቃርንግንዳ Ꮊቄ። <verse eid="REV 13:11"/><verse number="12" style="v" sid="REV 13:12"/>እሪንባብ ባችርንታ እሪ ገችንታ ኤራ ሙደንካ ፍግዝድ Ꮊቄ፥ ፍጨኬ ኮታዘን ዶቅድባብ ሙደና እሪንባብ ባችሪንካንታ ከት ጎዝድንግንዳ ይይሴ፥ ኮነረ ባችሪና ደእካንታ የልዝድን ድድና ክታ ኡስባብ እሪንባብ ባችሪኔ። <verse eid="REV 13:12"/><verse number="13" style="v" sid="REV 13:13"/>ኮና ቃስትምስ ባችሪና ማቼ ኤድንከስታ እሪ ኖሄንም ጭላርንካ Ꮊንችተርን የለልታ አንድር አተንከስም ፍግዝድ Ꮊቄ። <verse eid="REV 13:13"/><verse number="14" style="v" sid="REV 13:14"/>እሪንባብ ባችሪንታ እሪ ክት ይድንግንዳ ክትካንታ ጋይምሳን አተንጎካ ፍጨዘን ዶቅድባብ ኤድንከስም ኮተርዝድ Ꮊቄ፥ ማሴካ ተቸርሶ ድድና ክታ ኡስባብ ባችሪንካንታ ቦንቼታ ምስል ከት ኡርዝድንግንዳ ፍጨዘን ዶቅድባብ ኤድንከስም ክዴ። <verse eid="REV 13:14"/><verse number="15" style="v" sid="REV 13:15"/>ቃስትምስ ባችሪና እሪንባብ ባችሪንታ ምስልን ሰንፓ እምድንግንዳ ገችታ ኤራ ክትካንታ እምሴ፥ ሰንፔንም እምድንግንዳ ገችታ ኤረና ክትካንታ እምምሳንደረ ምስልና ኬዛካንታ ማድንግንደኬ ክት እሪ ባችርንካንታ ጎዝዳክባብከስ ሙደና ከት ደይስምድንግንዳ ይያባብዬ። <verse eid="REV 13:15"/><verse number="16" style="v" sid="REV 13:16"/>ቃስትምስ ባችሪና መረንከስመረ ማታ ባከንከስም፥ ቆልመንባብከስመረ ማታ ሪካየንባብከስም፥ ማታቆልስባብከስመረ ማታ አይለንከስም፥ ሙደነረ ኬታ ይንታ ምዝ አንንዘን አነረ ኬታ ይንታ ባለንዘን Ꮊፈርድን አፊን ከት ይድንግንዳ ከትም ማእሴ። <verse eid="REV 13:16"/><verse number="17" style="v" sid="REV 13:17"/>ኮትኮግንደካ ባችርንታ ላምን ሰጅድንደትም አፊን አነረ ክታ ላምንጎካ ዉተዳን ፋይደንም የዳክባብ Ꮊየነረ ኤድ ሰንትይ ተየረ ማታ ኦስ ሰንማካንተረ ማታዬ።<verse eid="REV 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 13:18"/>ኤጫ ዝግዝድንዳ ይናኮዘኔ፥ ማክቻ ዶቅድባብ ባችሪንታ ፋይደን ፋይዳ፥ ፋይደነረ ሰችዝድንዳ ኤድሜ፥ ፋይደነረ ላ ጸተኬ ማኬን ቦንደኬ ላዬ።<verse eid="REV 13:18"/></para>
  <chapter eid="REV 13"/>
  <chapter number="14" style="c" sid="REV 14"/>
  <para style="s1">ቆለንኬ ዋልቃ ጸተኬ ቃስቴን ቦንደኬ ኦይድ ሳአ ኤድንከስ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1"/>ኮታ ቡር ይና ቆለንና ጽዮን ገቼንዘን ዎእስንካ ሰድቴ፥ ክትካ ክክን ክታ ላምንኬ ባቤንታ ላምንካ ኬታ ባለንዘን ጻፍምስባብከስ ዋልቃ ጸተኬ ቃስቴን ቦንደኬ ኦይድ ሳአ ኤድንከስ Ꮊቀኬ።<note caller="-" style="x"><char style="xo" closed="false">14፡1 </char><char style="xt" closed="false"><ref loc="EZK 9:4">ሕዝ. 9፡4</ref>፤ <ref loc="REV 7:3">ለም. 7፡3</ref>። </char></note> <verse eid="REV 14:1"/><verse number="2" style="v" sid="REV 14:2"/>ጭላርንከረ አንድር ሎቃ ሶረንታ ኡፍስግንደኬ አንድር ጉግንም ካምድን አንድር ኡፍስ ኤሰርስቴ፥ እ ኤሰርሳን ኡፍስነረ ሶንግንም ቃንድባብከስ ሶንግንም ቃነሮ ከት ኤሰርድን ኡፍስም ካምድንዳ Ꮊቄ። <verse eid="REV 14:2"/><verse number="3" style="v" sid="REV 14:3"/>ባንችምንከስታ ዶቅንት ጎንገንዘንኬ ኦይድ ሰንፔካ ዶቅድን ፍዝርንከስ፥ ጋልተንከስተረ እሪ ዋልቃ ጸተኬ ቃስቴን ቦንደኬ ኦይድ ሳአ ኤድንከስ ክላ የችንም የችሰኬ፥ ኮትኮም የችን ፍጨዘንካ ቆት ተይምስባብ ዋልቃ ጸተኬ ቃስቴን ቦንደኬ ኦይድ ሳአ ኤድንከዘንካ አብ Ꮊየነረ ኤስካንታ ማታክዬ። <verse eid="REV 14:3"/><verse number="4" style="v" sid="REV 14:4"/>Ꮊረታ ጋይሴ ከታ ሙነክንባብከስ ማቻንካንታ ማነንከስካ ቤልምሰኮ ቱና ማታከኬ፥ ቆለና አይድን ካሪ ሙደናር ክትም ጎርስምደኬ። ኬታኬና ሳብካንተኬ ቆለንንካንታ ኤድንከስታ ዎክያርንካ ዳነዝ ከት ማድንግንዳ ቆት ተይምስባብከሰኬ። <verse eid="REV 14:4"/><verse number="5" style="v" sid="REV 14:5"/>ኬታ ካርካ ኬዛየኬ፥ ይንኤርዝድ ሪ ኬታዘን ካየንባበኬ።<verse eid="REV 14:5"/></para>
  <para style="s1">ማኬን ክታይንችንከስታ ክቴና</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6"/>ኮታ ቡር ፍጨዘን ዶቅድን ዎርሰንካንታ፥ አጥርንከስካንታ፥ Ꮊክ Ꮊክ አፈካ ከዝድባብከስካንተኬ Ꮊክ Ꮊክ ኮችንከስ ሙደንካንታ ኤስምስካንታ ስለንክንደታ ክላ ኬዘን የጅባብ አብ ክታይንች ጭለዘን ፈድንካ ሰድቴ። <verse eid="REV 14:6"/><verse number="7" style="v" sid="REV 14:7"/>አንድር ኡፍስከረ “ሳብም ጳስከቴ! ክትም ቦንችከቴ! ክት ፋረድን ሳዓትና የልቴ፥ ጭለንምኬ ፍጨንም ባሀርንምኬ ሎቀታ ቱትንከስም ፍዝባብ ጮይስንካንታ ጎስትከቴ!” ጋይሴ።<verse eid="REV 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 14:8"/>አበረ ቃስትምስ ክታይንችና “ቤልምን ኮትም ቤልምዝድን ጎስዝድን ዎይን ዎጭምን ዎርሰንከስካንታ ሙዳ ዎእሳንዳ ና አንድር ባብሎን ካተመና ዋቼ! ዋቼ!” ጋየሮ እሪ ክታይንችንም ጎርስምሴ።<note caller="-" style="x"><char style="xo" closed="false">14፡8 </char><char style="xt" closed="false"><ref loc="ISA 21:9">ኢሳ. 21፡9</ref>፤ <ref loc="JER 51:8">ኤር. 51፡8</ref>፤ <ref loc="REV 18:2">ለም. 18፡2</ref>። </char></note><verse eid="REV 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9"/>አብ ማክምስ ክታይንችነረ አንድር ኡፍስካ ኩንጋየሮ ከትም ጎርስምሴ፥ “ባችርንካንተኬ ክትም ካምድን ምስልንካንታ ጎዝድባብከስ፥ ክታ ማቻን ሪንከስም ኬታ ይንታ ባለንዘን አነረ ኬታ ይንታ አንዘን ይድባብከስ ሙደና፥ <verse eid="REV 14:9"/><verse number="10" style="v" sid="REV 14:10"/>ሳብታ ዋጭንታ ዎይን ዎጭምን ዎጭደኬ፥ ኮነረ ዎይን ዎጭምና ቡቅማክዶቆ ክታ ዋጭንታ ኡፍተናር ጮችምሳንዴ፥ ኮትኮግንደረ ሳብካንታ ፋስምሳን ክታይንችንከስታ እሪኬ ቆለንንታ እሪ ኖሀርኬ የድን ኖሄንታ ሎግንችንካ ማጥምደኬ፥<note caller="-" style="x"><char style="xo" closed="false">14፡10 </char><char style="xt" closed="false"><ref loc="ISA 51:17">ኢሳ. 51፡17</ref>፤ <ref loc="GEN 19:24">ፍዝ. 19፡24</ref>፤ <ref loc="EZK 38:22">ሕዝ. 38፡22</ref>። </char></note> <verse eid="REV 14:10"/><verse number="11" style="v" sid="REV 14:11"/>ኬትም ስለንክንደትዘንካ ስለንካ የለልታ ኖሄናርንካ ዉድን ጩበና ማእዝዴ፥ ባችሪንካንተኬ ክታ ምስልንካንታ ጎዝድባብከስ ክታ ላምንተረ ካምስንከስም ይንዘን ይስስባብ ሙደና Ꮊየከኬ ሶይትካ Ꮊዉስ ኬታ ካዬ።” <note caller="-" style="x"><char style="xo" closed="false">14፡11 </char><char style="xt" closed="false"><ref loc="ISA 34:10">ኢሳ. 34፡10</ref>። </char></note><verse eid="REV 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 14:12"/>ሳብታ ክቴን ካርዝድባብከዘንኬ የሱሰመረ አሜንካ ዳቅድባብ ሳብካንታ ፋስምስባብከዘንካ ካርስምድን ዳንዳእና ኮዘኔ።<verse eid="REV 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 14:13"/>ጭላርንከረ፥ ኮም ጻፍካ፥ “ይና ኮዘንካ ኦስ ጮይስያር ማትሶ ደእድባብከስ አንጅምስባብከሰኬ!” ኩን ጋይድን ኡፍስ ኤሰርሳቴ፥ አያን ጭልነረ “ይዬ! ኬታ ይንታ ጋፍናርንካ ከት Ꮊዉዝድንግንዳ ኬታ ፍክስንከስ ከትም ጎርስምተሬ” ጋይዴ።<verse eid="REV 14:13"/></para>
  <para style="s1">ፍጨዘንደት ስክምድን ሰጫ</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14"/>ኮታ ቡር፥ ይና ጫምሳ ኡፓ ሰድቴ፥ ኡፔንዘን ኤድ ይንችም ካምድባብ ዶቅሶ ዶቅድንካ ሰድቴ፥ ይንታ ማተንዘነረ ዎርቀታ ዛዉደን ዎቴ፥ ይንታ አንናረረ ቃርድን ባጫ የቴ፥<note caller="-" style="x"><char style="xo" closed="false">14፡14 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳን. 7፡13</ref>። </char></note> <verse eid="REV 14:14"/><verse number="15" style="v" sid="REV 14:15"/>አብ ክታይንችና ሳብታ ጭል ኤሄናርንካ ዉትሶ ኡፔንዘን ዶቅስባብም አንድር ኡፍስካ “ፍጨዘንደት ስክምድን ሰጫ የልሳንካንታ የስታ ባጨንም ኦይትሰዮ ስካ! ስከርድንደረ ዎችቴ!” ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">14፡15 </char><char style="xt" closed="false"><ref loc="JOL 3:13">ኢዩ. 3፡13</ref>። </char></note> <verse eid="REV 14:15"/><verse number="16" style="v" sid="REV 14:16"/>ኡፔንዘን ዶቅስባበረ ባጨንም ፍጨዘን ኦይቼ፥ ፍጨነረ ስክምሴ።<verse eid="REV 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17"/>አብ ክታይንቸረ ጭለዘን ዶቅድን ሳብታ ጭል ኤሄናርንካ ዉተዴ፥ ኖየረ ቃርሳን ባጨን የታ Ꮊቄ።<verse eid="REV 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 14:18"/>ኖሄዘን ገችታ ኤራ ዶቅድባብ አብ ክታይንች ካሲን ካሰርድንደታ ላማርንካ ዉትሶ ቃርሳን ባጨን የጅባብ ክታይንችንካንታ “ፉጥመንከስታ አፍና ኡሳንካንታ ቃርማ የስታ ባጨን ኦይትካ! ዎይንንታ ፉጥመንከስ ኡሳንደትም ሙዳ ፍጫር ዎይንንዘንካ ተችሳዮ ሳንስካ!” ጋየሮ አንድር ኡፍስካ ፍፍሴ። <verse eid="REV 14:18"/><verse number="19" style="v" sid="REV 14:19"/>ክታይንችነረ ባጨንም ፍጨዘን ኦይቼ፥ ፍጨንተረ ዎይንንታ ፉጥመን ኡሳንደትም ተቼ፥ ሳብተረ አንድር ዋጭንካ ዎይንን ጩጰርድንደታር ኦይቼ። <verse eid="REV 14:19"/><verse number="20" style="v" sid="REV 14:20"/>ካተመንዘንካ ኦስ ዶቅድን ዎይንን ጩጰርድንደታር ጩጵምሴ፥ ጩጰርድንደታርንከረ ፋራ ዎእስንካ ፋረንታ አፋ የለልታ ጬክን ጋይሳንደትኬ ማኬን ጸታ ክሎ ሜትር ማድን ጎትካ ማቀስና ዉትሶ ዉልእምሴ።<note caller="-" style="x"><char style="xo" closed="false">14፡20 </char><char style="xt" closed="false"><ref loc="ISA 63:3">ኢሳ. 63፡3</ref>፤ <ref loc="JER 1:15">ኤር. 1፡15</ref>፤ <ref loc="REV 19:15">ለም. 19፡15</ref>። </char></note><verse eid="REV 14:20"/></para>
  <chapter eid="REV 14"/>
  <chapter number="15" style="c" sid="REV 15"/>
  <para style="s1">በእንታ ሳብታ ዋጭንከስም የጅባብ ክታይንችንከስ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1"/>አበረ አንድርኬ በርእዝድን ቃዉታ ጭለዘን ሰዳቴ፥ ሳብታ ዋጭና ከትካ ቦድምድባብከስ ዋጭንታ በእንታ ማችባብ ታብዛ ዋጭንም የጅባብከስ ታብዛ ክታይንችንከስም ሰድቴ።<verse eid="REV 15:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 15:2"/>ኮታ ቡር ኖሀ ቡቅምሳንዳ ባሀር ሎቀና ማስታትም ካምድን ሪም ሰድቴ፥ ኮትኮግንደረ ባችሪንምኬ ባችሪንታ ምስልን፥ ክታ ላምንተረ ፋይደንታ ቃዉተን ጋምስባብከስም ሰድቴ፥ ሳብ ከትካንታ እምሳን ሶንግንም የድሰኮ ማስታትም ካምድን ባሀር ሎቀንታ ባንግር ዎእሶ Ꮊቀኬ። <verse eid="REV 15:2"/><verse number="3" style="v" sid="REV 15:3"/>ሳብታ ፍክሳᎺቅባብ ሙሴታ የቺንምኬ ቆለንንታ የቺን ኩን ጋየረኮ የጅድ Ꮊቀኬ፥</para>
  <para style="q1" vid="REV 15:3">“ሙደንም ቆልድባብ ጮይስ ሳብኖ!</para>
  <para style="q2" vid="REV 15:3">የስታ ፍክስንከስ አንድርኬ በርእስዝድንዴ፥</para>
  <para style="q1" vid="REV 15:3">ዎርሰንከስታ ባንችኖ!</para>
  <para style="q2" vid="REV 15:3">የስታ ጎግንከስ ሉላ ማቻንዳ ዶፈነኬ።<note caller="-" style="x"><char style="xo" closed="false">15፡3 </char><char style="xt" closed="false"><ref loc="EXO 15:1">ዉት. 15፡1</ref>። </char></note><verse eid="REV 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="REV 15:4"/>ጮይስዮ! የስም ጳዝዳክባብኬ የስታ ላምንም ቦንጅዳክባብ Ꮊይራ?</para>
  <para style="q2" vid="REV 15:4">የና Ꮊክ ጭለዬ፥</para>
  <para style="q1" vid="REV 15:4">የስታ ዶፈን ፍርደና መያ ማቻንካንታ፥</para>
  <para style="q2" vid="REV 15:4">ዎርሰንከስ ሙደና የስታ እሪ Ꮊድሰኮ ጎዝደኬ”።<note caller="-" style="x"><char style="xo" closed="false">15፡4 </char><char style="xt" closed="false"><ref loc="JER 10:7">ኤር. 10፡7</ref>፤ <ref loc="PSA 86:9">የቺ 86፡9</ref>። </char></note><verse eid="REV 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 15:5"/>ኮተረ ቡር ይና፥ ማርካትች ዱንካንና ዶቅድንዳ ሳብታ ጭል ኤሄና ጭላር ፎችምድንካ ሰድቴ።<note caller="-" style="x"><char style="xo" closed="false">15፡5 </char><char style="xt" closed="false"><ref loc="EXO 38:21">ዉት. 38፡21</ref>። </char></note> <verse eid="REV 15:5"/><verse number="6" style="v" sid="REV 15:6"/>ታብዛ ሳብታ ዋጭንከስም የጅባብ ታብዛ ክታይንችንከስ ሳብታ ጭል ኤሄናርንካ ዉተደኬ፥ ኡርማ ሮጵድን ጫምሳ አፍላ ቆበርሶ Ꮊቄ፥ ከታ ይንታ ኦንገዝነረ ዎርቀካ አሜችሶ Ꮊቀኬ። <verse eid="REV 15:6"/><verse number="7" style="v" sid="REV 15:7"/>ኦይድ ሰንፔካ ዶቅድን ፍዝርንከሳርንካ ዋልቀና ታብዛ ክታይንችንከስካንታ ስለንክንደትዘንካ ስለንካ የለልታ ዶቅድባብ ሳብንታ ዋጭ ጮጭባብከስም ታብዛ ዎርቀታ ኡፍተንከስም ከትካንታ እምሴ። <verse eid="REV 15:7"/><verse number="8" style="v" sid="REV 15:8"/>ሳብታ ጭል ኤሄነረ ሳብታ ቦንቼንዘንኬ ዎልቀንዘንካ አምሳንዳ ጩበካ ጮጬ፥ ታብዛ ክታይንችንከስ የጃን ታብዛ ሳብታ ዋጭንከስ ቦድምተርን የለልታ Ꮊየነረ ሳብታ ጭል ኤሄናር አርድካንታ ማታክዬ።<note caller="-" style="x"><char style="xo" closed="false">15፡8 </char><char style="xt" closed="false"><ref loc="EXO 40:34">ዉት. 40፡34</ref>፤ <ref loc="1KI 8:10-11">1 ባንቺ. 8፡10-11</ref>፤ <ref loc="2SA 5:13-14">2 ሳሙ. 5፡13-14</ref>፤ <ref loc="ISA 6:4">ኢሳ. 6፡4</ref>። </char></note><verse eid="REV 15:8"/></para>
  <chapter eid="REV 15"/>
  <chapter number="16" style="c" sid="REV 16"/>
  <para style="s1">ታብዛ ሳብታ ዋጭንከስ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1"/>ኮታ ቡር ታብዛ ክታይንችንከስም “አይከቴ! ሳብታ ዋጭንም የጃን ታብዛ ኡፍተንከሳርንደትም ፍጨዘን ዉልእከቴ!” ጋይድን ሳብታ ጭል ኤሄናርንካ ጬክን ጋይሳን ኡፍስ ኤሰርስቴ።<verse eid="REV 16:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 16:2"/>እሪንባብ ክታይንችና አይስንደትኬ ኡፍተናርንደትም ፍጨዘን ዉልእሴ፥ ባችሪንታ ካምስና ኬታዘን ዶቅድባብዘንኬ ባችሪንታ ምስልን ጎዝድባብ ኤድንከዘን ዳቅልኬ ማእዝድንዳ ድድ ኬታዘን ዉተዴ።<note caller="-" style="x"><char style="xo" closed="false">16፡2 </char><char style="xt" closed="false"><ref loc="EXO 9:10">ዉት. 9፡10</ref>። </char></note><verse eid="REV 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3"/>ቃስትምስ ክታይንችና ኡፍተናርንደትም ባሀር ሎቀንዘን ዉልእሴ፥ ባሀር ሎቀነረ ደእሳን ኤታ ማቀስግንዳ ማቼ፥ ባሀር ሎቀናር ሰንፓ ዶቅድባብ ሙዳ ሪና ደእሰኬ።<verse eid="REV 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4"/>ማክምስ ክታይንችና ኡፍተናርንደትም ሙርግድን ሎቀንከዘንኬ ቱትንከዘን ዉልእሴ፥ ከተረ ማቀስ ማቼኬ፥ <verse eid="REV 16:4"/><verse number="5" style="v" sid="REV 16:5"/>ሎቀዘነረ ገችታ ኤራ ዶቅድባብ ክታይንችና ኩን ጋይድንካ ኤሰርስቴ፥ “ታየረ የና ዶቅድባብኬ ኤንገረ Ꮊቅባብ ጭል ጮይስኖ! ኮ ግንዳ የስታ ፍርድንካ የና ገታዬ። <verse eid="REV 16:5"/><verse number="6" style="v" sid="REV 16:6"/>ኤድንከስ ሳብካንታ ፋስምስባብከስተኬ ሳብዘንካ ኤሰርሶ ኬዝድባብከስታ ማቀስን ከት ዉልእሳንካንታ ከትም ማቀስን ዎእሳዬ፥ ና ኮነረ ከትም ዝግዝድንዴ” <verse eid="REV 16:6"/><verse number="7" style="v" sid="REV 16:7"/>ካሲን ካርዘነረ “ይዬ! ሙደንም ቆልድባብ ጮይስ ሳብኖ! የስታ ፍርደንከስ ዶፈንኬ ገቴ” ጋይድን ኡፍስ ኤሰርስቴ።<verse eid="REV 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8"/>ኦይችምስ ክታ ይንችና ኡፍተናርንደትም Ꮊይዘን ዉልእሴ፥ Ꮊየነረ ኤድንከስም ይንታ ሶልንካ አድንግንዳ ዎልቃ ኮትካንታ እምምሴ፥ <verse eid="REV 16:8"/><verse number="9" style="v" sid="REV 16:9"/>ኤድንከሰረ አንድር ሶልንካ አተርሰኬ፥ ከትኬና ዋጭንከዘን ገችታ ኤራ ዶቅድባብ ሳብታ ላምንም የክሰኬ፥ ጎማፍክስን ይንታ ዎይሳከኬ፥ ክትመረ ቦንቻከኬ።<verse eid="REV 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10"/>ዶንቅስ ክታይንችና ኡፍተናርንደትም ባችሪንታ ባንችም ጎንገንዘን ዉልእሴ፥ ባችሪንተረ ባንችምና ኡም ማቼ፥ ኤድንከስ ኬታ ይንታ ማጥርንዘንካ አምሳንዳ ኬታ ይንታ አድምን ጋእድ Ꮊቀኬ፥ <verse eid="REV 16:10"/><verse number="11" style="v" sid="REV 16:11"/>ኬታ ይንታ ሰቅርንዘንኬ ኬታ ይንታ ድድንዘንካ አምሳንዳ ጭለዘን ሳብን የክሰኬ፥ ኬታ ይንታ ዳቅል ጎማፍክስን ዎይሳከኬ።<verse eid="REV 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12"/>ላስ ክታይንችና ኡፍተናርንደትም አንድር ሙርግድን ሎቀን ኤፍራጥስታ ዘን ዉልእሴ፥ Ꮊይታ ዉትንታጎካ Ꮊድባብ ባንችምንከስታ ጎግና ግግምተርንግንዳ ሙርግድን ሎቀና ዎቼ። <verse eid="REV 16:12"/><verse number="13" style="v" sid="REV 16:13"/>ቃሪንታ አፈናርንኬ ባችሪንታ አፈናርንካ፥ ሳብዘንካ ኤሰራክዶቆ ካርከካ ኬዝድባብከስታ አፋርንካ ጎፍረንከስም ካምድባብ ማኬን ቱና አያንንከስ ዉድንካ ሰድቴ። <verse eid="REV 16:13"/><verse number="14" style="v" sid="REV 16:14"/>ከታ አተንም ፍግዝድባብ ግምዘንከስታ አያነኬ፥ ከታኬና ግምዘንከስታ አያንና ሙደንም ቆልድባብ ጮይስንታ አንድር ዳም ኤጨንካንታ ማድን ኤድንከስም ሳንስካንታ ፍጫሙደንታ ባንችንከዝደር ሙዳ አይደኬ።<verse eid="REV 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 16:15"/>“ይና! እታ ድብግንዳ የ ገቀራክናና Ꮊድቴ! ዘና ጫለንካ ክት ማዳክንግንደኬ ክታ ካለን ኤድንከስ ሰዳክንግንዳ ንግሶ ይንታ አፍለን ካርዝድባብ አንጅምስባቤ!” <note caller="-" style="x"><char style="xo" closed="false">16፡15 </char><char style="xt" closed="false"><ref loc="MAT 24:43-44">ማቶ. 24፡43-44</ref>፤ <ref loc="LUK 12:30-40">ሉቃ. 12፡30-40</ref>፤ <ref loc="REV 3:3">ለም. 3፡3</ref>። </char></note><verse eid="REV 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 16:16"/>ግምዘንታ አያንንከስ ባንችምንከስም ዕብራይስጥ አፈካ አርማገዶን ጋይምድን ካርዘን ከትም ሳንሴ።<note caller="-" style="x"><char style="xo" closed="false">16፡16 </char><char style="xt" closed="false"><ref loc="2KI 23:29">2 ባንቺ. 23፡29</ref>፤ <ref loc="ZEC 12:11">ዘካ. 12፡11</ref>። </char></note><verse eid="REV 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 16:17"/>ታብስ ክታይንችና ኡፍተናርንደትም ዞገዘን ዉልእሴ፥ ሳብታ ጭል ኤሄናር ዶቅድን ባንችም ጎንገንዘንካ “ቦድምሴ!” ጋይድን አንድር ኡፍስ ኤስምሴ። <verse eid="REV 16:17"/><verse number="18" style="v" sid="REV 16:18"/>ዋልቅንት፥ ኡፍስ፥ ጉግንኬ አንድር ፍጨታ ሶይ ማቼ፥ ኮም ካምድንዳ አንድር ፍጨታ ሶይና ኤድ ፍጨዘን ፍዝምሳንደትዘንካ የድሶ ይይምሰረ ኤሳዬ።<note caller="-" style="x"><char style="xo" closed="false">16፡18 </char><char style="xt" closed="false"><ref loc="REV 8:5">ለም. 8፡5</ref>፤ <ref loc="REV 11:13">11፡13</ref>፥<ref loc="REV 11:19">19</ref>። </char></note> <verse eid="REV 16:18"/><verse number="19" style="v" sid="REV 16:19"/>አንድር ካተማ ማቻንዳ ማኬን ካርዘን ፋስምሴ፥ አይሁድ ማታክባብከስታ ካተመንከሰረ ዋቸኬ፥ ሳበረ አንድር ማቻን ባብሎን ካተመን ገቀርሴ። ክታ ዳቅማ ዋጭንታ ዎይን ዎጭምን ጮጫንደትም ኡፍተናርንካ ኮት ዎጭድንግንደረ ይሴ።<note caller="-" style="x"><char style="xo" closed="false">16፡19 </char><char style="xt" closed="false"><ref loc="ISA 51:17">ኢሳ. 51፡17</ref>። </char></note> <verse eid="REV 16:19"/><verse number="20" style="v" sid="REV 16:20"/>ሎቀታ ዎክያር ዶቅድን ደንንከስ ሙደና ካይደኬ፥ ገቼንከሰረ Ꮊፈራከኬ፥<note caller="-" style="x"><char style="xo" closed="false">16፡20 </char><char style="xt" closed="false"><ref loc="REV 6:14">ለም. 6፡14</ref>። </char></note> <verse eid="REV 16:20"/><verse number="21" style="v" sid="REV 16:21"/>ዋልቃ ዋልቃ አዝና ቃስቴን ቦንደኬ ዶንቅ ክሎ ማዘንምድንዳ ጭላርንካ ኤድንከስታዘን Ꮊንቸርሴ። ሳብታ ዋጭነረ አንድር ማእዝድንዳ ማቻንካንታ ኤድንከስ ሳብ አዝካ ከትም ዋጫንካንታ ሳብም የክሰኬ።<note caller="-" style="x"><char style="xo" closed="false">16፡21 </char><char style="xt" closed="false"><ref loc="EXO 9:23">ዉት. 9፡23</ref>፤ <ref loc="REV 11:19">ለም. 11፡19</ref>። </char></note><verse eid="REV 16:21"/></para>
  <chapter eid="REV 16"/>
  <chapter number="17" style="c" sid="REV 17"/>
  <para style="s1">ኤተን ቤልምንእንደተኬ ባችርንካ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1"/>ታብዘን ኡፍተንከስም የድሶ Ꮊቅባብ ታብዛ ክታይንችንከሳርንካ ዋልቀና እዝደር Ꮊድሶ፥ “ኮሬ! በድ ሎቀንከዘን ዶቅሳን አንድር ቤልምንእንደት ኤተንንታዘን የልድን ፍርደንም የስካንታ ሰችትቴ ኩን እዝደር ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">17፡1 </char><char style="xt" closed="false"><ref loc="JER 51:13">ኤር. 51፡13</ref>። </char></note> <verse eid="REV 17:1"/><verse number="2" style="v" sid="REV 17:2"/>ፍጨዘን ባንችንከስ ኮትካ ክክን ቤልምተኬ፥ ፍጨዘን ኤድንከሰረ ኮታ ቤልምንታ ዎይን ዎጭምንካ ጎዝተኬ”። <note caller="-" style="x"><char style="xo" closed="false">17፡2 </char><char style="xt" closed="false"><ref loc="ISA 23:17">ኢሳ. 23፡17</ref>፤ <ref loc="JER 51:7">ኤር. 51፡7</ref>። </char></note><verse eid="REV 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3"/>ኮታ ቡር ክታይንችና አያንካ ዴል ቆቼናር እም ተይ አይሴ፥ ይንታዘን የክታ ላምንከስ ጻፍምሳንደትካ፥ ታብዛ ቃደንከስኬ ታማ ባልንከስ ዶቅድባብ ዘይም ባችርንዘን ዶቅሳን ዋልቃ ኤተንም ሰድቴ።<note caller="-" style="x"><char style="xo" closed="false">17፡3 </char><char style="xt" closed="false"><ref loc="REV 13:1">ለም. 13፡1</ref>። </char></note> <verse eid="REV 17:3"/><verse number="4" style="v" sid="REV 17:4"/>ኤተነረ ማቀስም ካምድን ዘይም አፍላ ቆበርሶ Ꮊቄ፥ ዎርቀኬ ቦንችምሳን ሰይን እንቁ ጋየርድንዳ ሮጵድን ሰይንከረ ይካችካ ሰክስታ Ꮊቄ፥ ና ይንታ አንናረረ ይንኤርዝድንሪምኬ ኮታ ቤልምንካ ቱና ጮጫንደትም ዎርቀካ ኡርሰርሳንደትም ኡፍተን የድሶ Ꮊቄ።<note caller="-" style="x"><char style="xo" closed="false">17፡4 </char><char style="xt" closed="false"><ref loc="JER 51:7">ኤር. 51፡7</ref>። </char></note> <verse eid="REV 17:4"/><verse number="5" style="v" sid="REV 17:5"/>ኮታ ባለንዘነረ “ቤልምንባብከስተኬ ፍጨዘን ቱነንከስታ እንደና፥ አንድር ማቻንዳ ባብሎን ካተመና” ጋይድን አችምሳን ላም ጻፍምሶ Ꮊቄ። <verse eid="REV 17:5"/><verse number="6" style="v" sid="REV 17:6"/>ናኮና ኤተና ሳብካንታ ፋስምሳን ኤድንከስታ ማቀስንኬ የሱስካንታ ማርከራᎺቅባብከስታ ማቀስንካ ጎዝሶ ኮትዶቅድንካ ሰድቴ፥ ኮትም እ ሰዳንደትከረ አንድር በርእስቴ። <verse eid="REV 17:6"/><verse number="7" style="v" sid="REV 17:7"/>ክታይንችና ማቼ “Ꮊራካንተስ በርእዳ? ኤተንንጎክንዳ አችምሳንደትኬ ኮት ዶቅሶ Ꮊቃን፥ ታብዛ ቃደንከስኬ ታማ ባል ዶቅድባብከስም፥ ባችሪንጎክንደትም የስካንታ መያ ማስትቴ፥ <verse eid="REV 17:7"/><verse number="8" style="v" sid="REV 17:8"/>የስ ሰጃን ባችሪና ኤና እረረ ዶቅዴ፥ ታ ማቼ ካዬ፥ ኮታ ቡር ጩልጩል ጎርናርንካ ዉዴ፥ ኦስ ይንታ ካይንተናረረ አይዴ፥ ፍጫ ሙደና ፍዝምድንደትዘንካ የድሶ ኬታ ላምና ዶቅንት ማጻፍናር ጻፍማክባብ ፍጨዘን ዶቅድባብ ባችሪንከስ ኤናእረረ ዶቅድባብ፥ ታ ማቼ ካየም ካምስባብ ኮታ ቡር Ꮊድባብ ማትንተን ሰደኮ በርእደኬ።<note caller="-" style="x"><char style="xo" closed="false">17፡8 </char><char style="xt" closed="false"><ref loc="DAN 7:7">ዳን. 7፡7</ref>፤ <ref loc="REV 11:7">ለም. 11፡7</ref>፤ <ref loc="PSA 69:28">የቺ 69፡28</ref>። </char></note><verse eid="REV 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 17:9"/>“ኤጫ ማቻን ማክቻ ዝግዝድንዳ ይና ኮዘኔ፥ ታብዛ ቃደንከስ፥ ኤተና ኬታዘን ዶቅሳንዳ ታብዛ ገቼንከሰኬ፥ <verse eid="REV 17:9"/><verse number="10" style="v" sid="REV 17:10"/>ኮትኮግንደረ ታብዛ ባንችንከሰኬ፥ ኬታ ዋርንካ ዶንቅና ዋችተኬ፥ ዋልቀና ማቼ ታ ዶቅዴ፥ ቃስትምስና ማቼ ታ አክ Ꮊዳክዬ፥ ኖ Ꮊድዮ ቶክም ሰጫ ዶቅ ክትም ዝግዝዴ። <verse eid="REV 17:10"/><verse number="11" style="v" sid="REV 17:11"/>ላማካይስ ባንችና ኤና እሪ ዶቅድባብኬ ታ ካየንባብ ባችሪኔ፥ ኖ ታብዘንከሳርንካ ዋልቀኔ፥ ኦስ ካይንተናረረ አይዴ።<verse eid="REV 17:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 17:12"/>“የስ ሰድባብ ታማ ባልንከስ አክ ባንችማክባብከስ ታማ ባንችንከሰኬ፥ ከዛርካማቼ ዋልቃ ሳዓትካንታ ባችሪንካ ክክን ከት ባንችምተርንግንዳ ገችታ ኤራ Ꮊብደኬ።<note caller="-" style="x"><char style="xo" closed="false">17፡12 </char><char style="xt" closed="false"><ref loc="DAN 7:24">ዳን. 7፡24</ref>። </char></note> <verse eid="REV 17:12"/><verse number="13" style="v" sid="REV 17:13"/>ከትኬና ታማ ባንችንከስታ ዋልቃ ገቅር ዶቅዴ፥ ኬታ ይንታ ዎልቀንምኬ ገችታ ኤረንም ባችሪንካንታ እምደኬ፥ <verse eid="REV 17:13"/><verse number="14" style="v" sid="REV 17:14"/>ከተረ ቆለንንዘን ዳምይ አምዝደኬ፥ ከዛርማቼ ኖኮና ቆለና ጮይስንከስታ ጮይስኬ ባንችንከስታ ባንች ይ ማቻንካንታ ኖ ከትም ጋምዴ፥ ክትካ ክክን ዶቅድባብከስ ኤልምስባብ እድምስባብኬ አመንምስባብከሰኬ” ኩን እዝደር ጋይሴ።<verse eid="REV 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 17:15"/>ክታይንችነረ፥ ኤተንን ቤልምንእንደረ ኬታዘን ኮትዶቅስንካ የስ ሰጅባብ ሎቀንከስ፥ ዎርሰንከስኬ፥ ኤድንከስ፥ ኮችንከስኬ Ꮊክ Ꮊክ አፈንከስም ኬዝድባብከሰኬ፥ <verse eid="REV 17:15"/><verse number="16" style="v" sid="REV 17:16"/>ባችሪንኬ የስ ሰድባብ ታማ ባልንከስ ኤተን በልምንእንደትም ቦዝደኬ፥ ኮትም ዘናጫለከረ ማዝደኬ፥ ኮታ ዋሄንመረ እጅደኬ፥ ኖሄከረ ኮትም አጅደኬ፥ <verse eid="REV 17:16"/><verse number="17" style="v" sid="REV 17:17"/>ክታ ገቅርንም ከት ቦድንግንዳ ኮም ገቅርን ኬታ ቡደናር ዎጅባብ ሳብዬ፥ ኮካንታ ሳብታ ቃለና ቦድምተርን የለልታ ከታ ዋልቃ ቡደካ ኤእደኬ፥ ከታ ይንታ ባንችምንታ ገችታ ኤረንም ባችሪንካንታ እምደኬ።<verse eid="REV 17:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 17:18"/>“የስ ሰጃን ኤተነረ ፍጫር ዶቅድን ባንችንከዘን ባንችምድንዳ ና አንድር ካተሜ” ኩን እዝደር ጋይሴ።<verse eid="REV 17:18"/></para>
  <chapter eid="REV 17"/>
  <chapter number="18" style="c" sid="REV 18"/>
  <para style="s1">ባብሎን ካተመንታ ዋችና</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1"/>ኮታ ቡር አንድር ገችታ ኤራ ዶቅድባብ አብ ክታይንችና ጭላርንካ Ꮊንቸርድንካ ሰድቴ፥ ክታ ቦንቼንታ ሮጵንዘንካ አምሳንዳ ፍጨና ሳክማ ማቼ። <verse eid="REV 18:1"/><verse number="2" style="v" sid="REV 18:2"/>አንድር ኡፍስከረ “አንድር ማቻን ባብሎን ካተመና ዋቼ! ዋቼ! ግምዘንከስታ ዶቅንትካር ማቼ! ቱና አያንንከስታ ገችንትካር ማቼ! ይንኤርዝድንደተኬ ቦስዝድን አፍትንከስታ ገችንት ካሪ ማቼ!<note caller="-" style="x"><char style="xo" closed="false">18፡2 </char><char style="xt" closed="false"><ref loc="ISA 13:21">ኢሳ. 13፡21</ref>፤ <ref loc="ISA 21:9">21፡9</ref>፤ <ref loc="JER 50:39">ኤር. 50፡39</ref>፤ <ref loc="JER 51:8">51፡8</ref>፤ <ref loc="REV 14:8">ለም. 14፡8</ref>። </char></note> <verse eid="REV 18:2"/><verse number="3" style="v" sid="REV 18:3"/>ቤልምንካንታ ጎስዝድን ዎይን ዎጭምን ዎርሳ ሙደና ዎጭተኬ፥ ፍጨዘን ባንችንከስ ኮትካ ክክን ቤልምተኬ፥ ፍጨዘን ዛለንባብከሰረ ኮታ በድ Ꮊላ ጋይንዘንካ አምሳንዳ ቆልመንባብከስ ማተኬ” ኩን ጋይሶ ፍፍሴ።<note caller="-" style="x"><char style="xo" closed="false">18፡3 </char><char style="xt" closed="false"><ref loc="ISA 23:17">ኢሳ. 23፡17</ref>፤ <ref loc="JER 51:7">ኤር. 51፡7</ref>። </char></note><verse eid="REV 18:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 18:4"/>አብ ኡፍሰረ ጭላርንካ፥</para>
  <para style="q1" vid="REV 18:4">“እስታ ዎርሰኖ! ኮታ ጎማ ፍክስንካ ዋልቃ የ ማዳክንግንዳ፥</para>
  <para style="q2" vid="REV 18:4">ሳብ ኮትም ዋጭድንᎺይካ ኮታ ዋጭን ተይድባብ የ ማተራክንግንዳ፥</para>
  <para style="q2" vid="REV 18:4">ኮታርንካ ዉትከቴ!<note caller="-" style="x"><char style="xo" closed="false">18፡4 </char><char style="xt" closed="false"><ref loc="ISA 48:20">ኢሳ. 48፡20</ref>፤ <ref loc="JER 50:8">ኤር. 50፡8</ref>፤ <ref loc="JER 51:6">51፡6</ref>። </char></note><verse eid="REV 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 18:5"/>ኮታ ጎመንታ በድምነረ ጭላር የለልታ የልቴ፥</para>
  <para style="q2" vid="REV 18:5">ሳብ ኮታ ዳቀልስንከስም ገቀርሴ፥<note caller="-" style="x"><char style="xo" closed="false">18፡5 </char><char style="xt" closed="false"><ref loc="NUM 18:20-21">ፋይ. 18፡20-21</ref>፤ <ref loc="JER 51:9">ኤር. 51፡9</ref>። </char></note><verse eid="REV 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 18:6"/>ኮታ ይተንከካ ኮትካንታ እምከቴ፥</para>
  <para style="q2" vid="REV 18:6">ኮት ፍክሳን ፍክስንዘንካ ጉጅሶ ኮትካንታ ናከቴ፥</para>
  <para style="q1" vid="REV 18:6">ናየረ Ꮊክ Ꮊክ ዎጭምንከስም ኮት ቡቅሳን ኡፍተናር፥</para>
  <para style="q2" vid="REV 18:6">ጉጅሶ አንድር ማስሰቶ ኮትካንታ ቡቅከቴ፥<note caller="-" style="x"><char style="xo" closed="false">18፡6 </char><char style="xt" closed="false"><ref loc="PSA 137:8">የቺ 137፡8</ref>፤ <ref loc="JER 50:29">ኤር. 50፡29</ref>። </char></note><verse eid="REV 18:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 18:7"/>ና ይንታ ማተንታ ቦንቼንምኬ Ꮊላ ጋይንተን እምሳንደትከካ</para>
  <para style="q2" vid="REV 18:7">ማጠንምኬ ሞርእን ኮትካንታ እምከቴ፥ Ꮊረታ ጋይሴ</para>
  <para style="q1" vid="REV 18:7">ና ይንታ ቡደናር ‘ባንች ማትስቶ ዶቅሳቴ፥</para>
  <para style="q2" vid="REV 18:7">ቡድነረ ካይቴ፥</para>
  <para style="q2" vid="REV 18:7">ሞርእነረ ቦድሶ እም የላዬ’ ጋየሮ ና ጬቅዴ።<verse eid="REV 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 18:8"/>ኮካንታ ኮትም የልድን ዋጭና ሙዳ ዋልቃሰጭ ኮታዘን የልዴ፥</para>
  <para style="q1" vid="REV 18:8">ደእኬ ሞርእ ዳቀረ ኮታዘን የልዴ፥</para>
  <para style="q2" vid="REV 18:8">ኖሄከረ ና አተርተረ፥</para>
  <para style="q1" vid="REV 18:8">ኮታዘነረ ፋረድባብ ጮይስ ሳብና ዳቅሜ” ኩን ጋይድንካ ኤሰርስቴ።<verse eid="REV 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9"/>ኮትካ ክክን ቤልምስባብከስኬ Ꮊላ ጋይሶ Ꮊቅባብ ፍጨዘን ባንችንከስ ኮት አተርድንካ ዉድን ጩበን ሰደረኮ ኮትካንታ ፍፈረኮ ኤብደኬ። <verse eid="REV 18:9"/><verse number="10" style="v" sid="REV 18:10"/>ኮታ ማጥርንመረ ጳስካ ጎትካ ዎእሰኮ “የና አንድር ካተመና፥ የና ዳቅማ ማቻን ባብሎን ካተመኖ! የስታዘን ፍርደና ዋልቃ ሳዓታር Ꮊዳንካንታ የስም የኤ! የስም የኤ!” ጋይደኬ።<note caller="-" style="x"><char style="xo" closed="false">18፡10 </char><char style="xt" closed="false"><ref loc="EZK 26:16-17">ሕዝ. 26፡16-17</ref>። </char></note><verse eid="REV 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 18:11"/>ባሃርንዘንካ ቃልዝድን ኬታ ማርከብናር ጫነርሳንደትም ይና ኮዘንካ ኦስ ሰንድባብ ካየንካንታ ፍጨንዘን ዛለንባብከሰረ ኮትካንታ ኤብደኬ፥ ኮትካንተረ ሞርእደኬ፥<note caller="-" style="x"><char style="xo" closed="false">18፡11 </char><char style="xt" closed="false"><ref loc="EZK 27:31-36">ሕዝ. 27፡31-36</ref>። </char></note> <verse eid="REV 18:11"/><verse number="12" style="v" sid="REV 18:12"/>ኬታ ማርከብናረረ ጫንምሳንዳ ዎርቃ፥ ዱንድ፥ ቦንችምሳን ሰይን፥ ሮጵድንዳ እንቁ ጋየርድን ሪ፥ ሳዝ አፍላ፥ ማቀስም ካምድን አፍላ፥ ድርካ ኡርሰርሳን አፍላ፥ ዘይም አፍለኬ ኡርማ ዎዝድን Ꮊቃ ሙደን፥ ዶንገርታ አችካ፥ ስንጋ ማቻን Ꮊቀካ፥ ጋይዘንካ፥ ስብልዘንኬ አዝም ካምድንደትካ ኤሀ ኡርዝድን እብነበረድ ጋየርድንደትካ ኡርሰርሳን ሪ ሙዳ፥ <verse eid="REV 18:12"/><verse number="13" style="v" sid="REV 18:13"/>ቀረፋ ጋየርድንዳ ሳዉሰታ ማድን Ꮊቀታ ኦፍር፥ Ꮊክ Ꮊክ ሳዉሳካንታ ማድንርንከስ፥ ዎዝድን Ꮊቃ፥ ከርቤ ጋየርድንዳ ዎዝድሪ፥ እጣን፥ ዎይን ዎጭምና፥ Ꮊቃ ዎይረዘንካ ጩጰርሳንዳ ዛይት፥ እላ፥ ዘርግ፥ መሄንከስ፥ ቆልንከስ፥ ፋረንከስ፥ ፋራ ጎጅድንዳ ጋር ግንደንዳ ሰረገለንከስ፥ አይለንከስኬ አብ ኤድንከሰረ ዋር Ꮊቀኬ።<note caller="-" style="x"><char style="xo" closed="false">18፡13 </char><char style="xt" closed="false"><ref loc="EZK 27:12">ሕዝ. 27፡12</ref>፤ <ref loc="EZK 13:22">13፡22</ref>። </char></note> <verse eid="REV 18:13"/><verse number="14" style="v" sid="REV 18:14"/>ዛለንባብከሰረ “የስ አንገርሳን ኡርማ ሪንከስ ሙዳ የዘንካ ጎተርሶ አይተኬ፥ የስታ ቆልመነረ የስ ሰግድን ሪንከሰረ ሙዳ ካይተኬ፥ ይና ኮዘንካ ኦስ ከትከነም ሙዳ ቦድሶ Ꮊብዳከዬ!” ኮትም ጋይደኬ። <verse eid="REV 18:14"/><verse number="15" style="v" sid="REV 18:15"/>ከትኬና ሪንከስም ሙዳ ሰነረኮ ቆልመካ ማችባብ ዛለንባብከስ ኮታ ማጥርንም ጳስካ ጎትካ ዎእደኬ፥ ኤፈረኮ ሞርኤረኮ፥<note caller="-" style="x"><char style="xo" closed="false">18፡15 </char><char style="xt" closed="false"><ref loc="EZK 27:31">ሕዝ. 27፡31</ref>፥<ref loc="EZK 27:36">36</ref>። </char></note> <verse eid="REV 18:15"/><verse number="16" style="v" sid="REV 18:16"/>“ሳዝ አፍለኬ ዘይም ማቀስም ካምድን አፍለረ ቆበርድ Ꮊቃንዳ ዎርቀኬ ቦንችምሳን ሰይን ፍግዝድባብከስ ሙዳ ባሀርንዘን ዛለን ዛልድባብከስ ሙደና ጎትካ ዎእደኬ።<note caller="-" style="x"><char style="xo" closed="false">18፡16 </char><char style="xt" closed="false"><ref loc="ISA 23:14">ኢሳ. 23፡14</ref>፤ <ref loc="EZK 27:26-30">ሕዝ. 27፡26-30</ref>። </char></note> <verse eid="REV 18:16"/><verse number="17" style="v" sid="REV 18:17"/>ኮከንዳ ቆልማ ዋልቃ ሳዓታር ካይዴ!” ጋይደኬ።</para>
  <para style="p" vid="REV 18:17">ሎቀንዘንካ ቃልዝድን መርከብን በይድባብከስ ሙደና መርከብንታ ዘን ፍግዝድባብከስ ሙደና፥ ባሀርንታዘን ዛልእድባብከስ ሙደና ጎትካ ዎእደኬ፥<note caller="-" style="x"><char style="xo" closed="false">18፡17 </char><char style="xt" closed="false"><ref loc="ISA 23:14">ኢሳ. 23፡14</ref>፤ <ref loc="EZK 27:26-30">ሕዝ. 27፡26-30</ref>። </char></note> <verse eid="REV 18:17"/><verse number="18" style="v" sid="REV 18:18"/>ኮት አተርድንካ ዉድን ጩበን ኬታ ይ ሰዳንደትካ “ኮትኮ አንድር ካተመን ካምድንዳ ቦድሶ አብ ካተማ ዶቅዶ?” ጋየረኮ ፍፍሰኬ።<note caller="-" style="x"><char style="xo" closed="false">18፡18 </char><char style="xt" closed="false"><ref loc="EZK 27:32">ሕዝ. 27፡32</ref>። </char></note> <verse eid="REV 18:18"/><verse number="19" style="v" sid="REV 18:19"/>ኬታ ይንታ ማተንዘነረ ቡል ይጭሰኬ፥ ኤፈረኮ ሞርኤረኮ ኩንጋየሮ ፍብደኬ፥ “ባሀርንዘን ዶቅድን ማርከብንባብከስ ሙደና ኮታ ቆልመንካ ቆልስባብከስ፥ ና አንድር ካተመና ዋልቃ ሳዓት ዋር ኮት ካይዳንካንታ ኮትም የኤ! ኮትም የኤ!” <note caller="-" style="x"><char style="xo" closed="false">18፡19 </char><char style="xt" closed="false"><ref loc="EZK 27:30-34">ሕዝ. 27፡30-34</ref>። </char></note><verse eid="REV 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 18:20"/>የና ጭለኖ! ኮትካ የስም ጉርምሳ! ሳብ የካንታ ኮታዘን ፋረጃንካንታ የታ ሳብካንታ ፋስምስባብከስ፥ ኦይትምስባብከስኬ ሳብዘንካ ኤሰርሶ ከዝድባብከስመረ የም ጉርምሳ!<note caller="-" style="x"><char style="xo" closed="false">18፡20 </char><char style="xt" closed="false"><ref loc="DEU 32:43">ካሪ. 32፡43</ref>፤ <ref loc="JER 51:48">ኤር. 51፡48</ref>። </char></note><verse eid="REV 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 18:21"/>ኮታ ቡር ዋልቃ ዳቅማ ክታይንችን አንድር ደይስን ሰይን ከከንደትም ዋልቃ ሰይን አምስሶ “አንድር ማቻን ካተመና ባብሎን ኮ ግንዳ አንድር ዎልቀካ Ꮊቅምሶ ና ዋችተሬ፥ ይና ኮዘንካ ኦስ ቦድሶ ና Ꮊፈርተራክዬ ኩንጋየሮ ባሀርናር ኦይቼ።<note caller="-" style="x"><char style="xo" closed="false">18፡21 </char><char style="xt" closed="false"><ref loc="JER 51:63-64">ኤር. 51፡63-64</ref>፤ <ref loc="EZK 26:21">ሕዝ. 26፡21</ref>። </char></note> <verse eid="REV 18:21"/><verse number="22" style="v" sid="REV 18:22"/>ሶንግንም ቃንድባብከስኬ የችንባብከስታ ኡፍስ፥ አንዳለን ፉግድባብከስተኬ ፍቼን ፉግድባብከስታ ኡፍስና አናካርንካ የሳር ኤስማዬ፥ Ꮊምንመረ ሪ አንታ ሩርምካ ፍግዝድባብ እብለንባብ ኤድ ይና ኮዘንካ ኦስ የሳር Ꮊፈራዬ፥ ደይስን ደይዝድንደታ ኡፍስና ይና ኮዘንካ ኦስ የሳር ኤስማዬ።<note caller="-" style="x"><char style="xo" closed="false">18፡22 </char><char style="xt" closed="false"><ref loc="EZK 26:13">ሕዝ. 26፡13</ref>፤ <ref loc="ISA 24:8">ኢሳ. 24፡8</ref>። </char></note> <verse eid="REV 18:22"/><verse number="23" style="v" sid="REV 18:23"/>ዞጰንታ ሳክመነረ ይና ኮዘንካ ኦስ የሳር ሳካዬ፥ እንጅድባብተኬ ይእድንደታ ኡፍስ ይና ኮዘንካ ኦስ የሳር ኤስማዬ፥ የስታ ዛለንባብከስ ፍጫሙደንዘን አንድር ኤድ Ꮊቀኬ፥ የስታ ሳገንካ ዎርሰንከስም ሙዳ ኮተርስተዬ።<note caller="-" style="x"><char style="xo" closed="false">18፡23 </char><char style="xt" closed="false"><ref loc="JER 7:34">ኤር. 7፡34</ref>፤ <ref loc="JER 25:10">25፡10</ref>። </char></note><verse eid="REV 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 18:24"/>“ኮታር ሳብዘንካ ኤሰርሶ ከዝድባብከስተኬ ሳብካንታ ፋስምስባብከስታ፥ ፍጨዘን ደይስምስባብ ኤድንከስታ ሙዳ ማቀስና Ꮊፈርቴ”። <note caller="-" style="x"><char style="xo" closed="false">18፡24 </char><char style="xt" closed="false"><ref loc="JER 51:49">ኤር. 51፡49</ref>። </char></note><verse eid="REV 18:24"/></para>
  <chapter eid="REV 18"/>
  <chapter number="19" style="c" sid="REV 19"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1"/>ኮታ ቡር “ሳብም ጋለትከቴ! አቅስኬ ቦንቼካ ዎልቀረ ዎንታ ጮይስንቴ! <verse eid="REV 19:1"/><verse number="2" style="v" sid="REV 19:2"/>ክታ ፍርደና ዶፈንኬ ገቴ፥ ፍጨንም ይንታ ቤልምንካ ቱና ማስሳን አንድር በልምእንደትም ሳብ ይንታ ፍርደካ ዋጭቴ፥ ኮትመረ ይንታ ዋጭንካ ይንታ ፍክስንባብከስታ ዉልእምሳን ማቀስንጎካ ይንታ ይምኤን ማስሴ”። <note caller="-" style="x"><char style="xo" closed="false">19፡2 </char><char style="xt" closed="false"><ref loc="DEU 32:43">ካሪ. 32፡43</ref>፤ <ref loc="2KI 9:7">2 ባንቺ. 9፡7</ref>። </char></note> ኩን ጋይድን በድ ኤታ ኡፍስም ካምድን አንድር ኡፍስ ጭለዘን ኤሰርስቴ። <verse eid="REV 19:2"/><verse number="3" style="v" sid="REV 19:3"/>አና ካርንከረ “ሳብም ጋለትከቴ! ኮታርንካ ዉድን ጩበና ስለንክንደትዘንካ ስለንካ የለልታ ጨዳ ዉዴ!” ጋየረኮ ፍፍሰኬ።<note caller="-" style="x"><char style="xo" closed="false">19፡3 </char><char style="xt" closed="false"><ref loc="ISA 34:10">ኢሳ. 34፡10</ref>። </char></note> <verse eid="REV 19:3"/><verse number="4" style="v" sid="REV 19:4"/>ቦንደኬ ኦይድ ጋልተንከስኬ ኦይድ ሰንፔካ ዶቅድን ፍዝርንከስ ይንታ ባንችምንታ ጎንገንዘን ዶቅስባብ ጮይስንካንታ ኬታ ይንታ ባለንካ ጉፕን ጋይሰኮ “አምንኤ፥ ሳብም ጋለትከቴ!” ጋየረኮ ጎስትሰኬ።<verse eid="REV 19:4"/></para>
  <para style="s1">ቆለንንታ እሰና</para>
  <para style="p">
    <verse number="5" style="v" sid="REV 19:5"/>ኮታ ቡር “ክትም ጳዝድባብ የታ ክታ ፍክስንባብከስ ሙደና፥ መረንከሰረ ባከንከሰረ ዎንታ ጮይስንም ጋለትከቴ!” ጋይድን ኡፍስ ክታ ባንችም ጎንገንዘንካ ዉተዴ።<note caller="-" style="x"><char style="xo" closed="false">19፡5 </char><char style="xt" closed="false"><ref loc="PSA 115:13">የቺ 115፡13</ref>። </char></note> <verse eid="REV 19:5"/><verse number="6" style="v" sid="REV 19:6"/>በድ ኤድንከስታ ኡፍስም፥ ሙርግድን ሎቀታ ኡፍስም፥ አንድር ጉግንታ ኡፍስም ካምድን ኡፍስ “ሳብም ጋለትከቴ! ሙደንም ቆልድባብ ጮይስ ሳብና ባንችምዴ!” ኩን ጋይድንካ ኤሰርስቴ።<note caller="-" style="x"><char style="xo" closed="false">19፡6 </char><char style="xt" closed="false"><ref loc="EZK 1:24">ሕዝ. 1፡24</ref>፤ <ref loc="PSA 93:1">የቺ 93፡1</ref>፤ <ref loc="PSA 97:1">97፡1</ref>፤ <ref loc="PSA 99:1">99፡1</ref>። </char></note> <verse eid="REV 19:6"/><verse number="7" style="v" sid="REV 19:7"/>ክት ቆለንንታ እሰና የልሳንካንተኬ ክት ኤር ይእድንደረ ኮት ግግምሳንካንታ ዎም ጉርምሳ! አንድረረ ዎ ጉርማ! ክትመረ ዎ ቦንቻ! <verse eid="REV 19:7"/><verse number="8" style="v" sid="REV 19:8"/>ሮጵድንደትኬ ጭምራክንደትም ላቅምድን አፍላ ኮት ቆበርድንግንዳ ኮትካንታ እምምሴ፥ ሳዝ አፍለና ሳብካንታ ፋስምስባብከስታ ጭለትች ፍክስዬ።<verse eid="REV 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9"/>ኮታ ቡር ክታይንችና “ ቆለንንታ እሰንታ እችምንደር ኤልምስባብ አንጅምስባብከሰኬ” ጋይሶ ጻፍካ እም ጋይሴ፥ ኮታዘንከረ “ኮና ሳብታ ዶፈን ቃሌ” ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">19፡9 </char><char style="xt" closed="false"><ref loc="MAT 22:2-3">ማቶ. 22፡2-3</ref>። </char></note><verse eid="REV 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 19:10"/>እተረ ክታይንችንም ጎስትካንታ ክታ ዱትንዘን እስታ ባለንካ ጉፕን ጋይስቴ፥ ኖ ማቼ “ዛእካ! ኮም Ꮊይ ይዬ! እተረ የስካ ክክን የሱሰታ ማርካትቼን የጅባብ የስታ እስመንከስከረ ክክን ሳብታ ፍክስንባብቴ፥ ኮካንታ የነረ ሳብካንታ ጎስትካ! የሱሰታ ማርካትቼና ቤር ኬዝድን አያንኔ” እዝደር ጋይሴ።<verse eid="REV 19:10"/></para>
  <para style="s1">ጫምሳ ፋረንዘን ዶቅሶ ዞድባብ</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11"/>ኮታ ቡር ጭለና ፎችምስንካ ሰድቴ፥ ኮታዘንከረ ጫምሳ ፋረመረ ሰድቴ፥ ፋረንዘነረ ዶቅስባብ አመንምስባብኬ ዶፈን ጋይምድባቤ፥ ኖ ጭላትቼንካ ፋረዴ፥ አነረ ዳምዴ፥<note caller="-" style="x"><char style="xo" closed="false">19፡11 </char><char style="xt" closed="false"><ref loc="EZK 1:1">ሕዝ. 1፡1</ref>፤ <ref loc="PSA 96:13">የቺ 96፡13</ref>፤ <ref loc="ISA 11:4">ኢሳ. 11፡4</ref>። </char></note> <verse eid="REV 19:11"/><verse number="12" style="v" sid="REV 19:12"/>ክታ አፍንከሰረ ኖሄታ ሎግንችም ካምደኬ፥ ክታ ማተንዘነረ በድ ዛዉደንከስ ዶቅደኬ፥ ክታዘንካ አብ Ꮊየነረ ኤዝዳክንዳ ክታዘን ጻፈርሳንዳ ላም Ꮊቄ፥<note caller="-" style="x"><char style="xo" closed="false">19፡12 </char><char style="xt" closed="false"><ref loc="DAN 10:6">ዳን. 10፡6</ref>። </char></note> <verse eid="REV 19:12"/><verse number="13" style="v" sid="REV 19:13"/>ኖ ማቀስካ ላይምሳን አፍላ ቆበርታ Ꮊቄ፥ ክታ ላምነረ “ሳብታ ቃላ” ጋይምድንዴ። <verse eid="REV 19:13"/><verse number="14" style="v" sid="REV 19:14"/>ጫምሳ ፋረንከዘን ዶቅስባብከስ ጫምሰኬ ጭመራክን ላቅምድን አፍላ ቆበርስባብከስ ጭላር ዳምንባብከስ ክትም ጎርስምተኬ። <verse eid="REV 19:14"/><verse number="15" style="v" sid="REV 19:15"/>ይንታ ማታክባብ ዎርሰንከስም ክት ጉጵድንዳ ቃርሰርሳን ማሳ ክታ አፈናርካ ዉዴ፥ ስብል ጉፈንከረ ከትም ገችስተሬ፥ ኖ ሙደን ቆልድባብ ሳብንታ ጳስዝድን ዋጭን መያ ማስዝድን ዎይን ዎጭምን ጩጰርድንደት ካርንም ሙክተሬ፥<note caller="-" style="x"><char style="xo" closed="false">19፡15 </char><char style="xt" closed="false"><ref loc="PSA 2:9">የቺ 2፡9</ref>፤ <ref loc="ISA 63:3">ኢሳ. 63፡3</ref>፤ <ref loc="JOB 3:13">ኢዮብ 3፡13</ref>፤ <ref loc="REV 14:20">ለም. 14፡20</ref>። </char></note> <verse eid="REV 19:15"/><verse number="16" style="v" sid="REV 19:16"/>ይንታ አፍለንዘንኬ ይንታ ገስንዘን “ባንችንከስታ ባንች ጮይስንከስተረ ጮይስ” ጋይድንዳ ላም ጻፍምቴ።<verse eid="REV 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17"/>ኮታ ቡር Ꮊይንታዘን ዎእስባብ ዋልቃ ክታይንችም ሰድቴ፥ ኖየረ ጭለዘን ፈድን አፍትንከስካንታ “አንድር ሳብታ ግክስምሳን እችምንደር ኮረቴ! ሳንምከቴ! <verse eid="REV 19:17"/><verse number="18" style="v" sid="REV 19:18"/>ባንችንከስታ ዋሄን፥ ዳምንባብከስም ክድባብከስታ ዋሄን፥ ዳቅማ ዳምድባብከስታ ዋሄን፥ ፋረንከስተኬ ፋረንከዘን ዶቅሶ ዳምድባብከስታ ዋሄን፥ ማተንቆልስባብከስተኬ ፍክስንባብከስታ ዋሄን፥ መረንከስተኬ ባከንከስታ ዋሄን፥ Ꮊምነረ ኤድ ሙደንታ ዋሄን Ꮊድሰቶ እችከቴ!” ኩንጋየሮ አንድር ኡፍስካ ፍፍሴ።<verse eid="REV 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19"/>ኮትኮግንደረ ባችሪንኬ ፍጨዘን ባንችንከስ፥ ኬታ ዳምንባብከሰረ ጫምሳ ፋረንዘን ዶቅስባብዘንኬ ክታ ዳምንባብከስካ ክክን ዳምካንታ ከት ሳንምስንካ ሰድቴ፥ <verse eid="REV 19:19"/><verse number="20" style="v" sid="REV 19:20"/>ኬዛርንካ ማቼ ባችሪና የድምሴ፥ ክትከረ ክክን ክታ እሪ በድ አተን ፍግዝድ Ꮊቅባብ ኖ ባችሪንታ ምስል ከታዘን ዶቅድባብከስምኬ ባችሪንታ ምስልንካንታ ጎዝድ Ꮊቅባብከስም አተንም ፍክሰሮ ኮተርዝድ Ꮊቅባብ ሳብዘንካ ኤሰራክዶቆ ካርከካ ከዛቅባብና የድምሴ፥ ኬታ ኬና ቃስቴንና ድግዳክን አድን ኖሀ ባሀርናር ሰንፔካ ዶቅደኮ ኦይትምሰኬ።<note caller="-" style="x"><char style="xo" closed="false">19፡20 </char><char style="xt" closed="false"><ref loc="REV 13:1-18">ለም. 13፡1-18</ref>። </char></note> <verse eid="REV 19:20"/><verse number="21" style="v" sid="REV 19:21"/>ነገድባብከሰረ ጫም ፋረንዘን ዶቅስባብታ አፈናርንካ ዉድን ማሴንካ ደይስምሰኬ፥ አፍትንከሰረ ሙዳ ኬታ ዋሄንም እችሶ ምሰኬ።<verse eid="REV 19:21"/></para>
  <chapter eid="REV 19"/>
  <chapter number="20" style="c" sid="REV 20"/>
  <para style="s1">ሳአ ስለንከስጎካ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1"/>ኮታ ቡር ጩልጩል ጎርንታ ፎቸርድንደትምኬ አንድር ሳንችለት ይንታ አንያር የጅባብ ክታይንች ጭላርንካ Ꮊንቸርድንካ ሰድቴ፥ <verse eid="REV 20:1"/><verse number="2" style="v" sid="REV 20:2"/>ቃሪንመረ የድሶ ሳአ ስላካንታ ክትም ዞክሴ፥ ኮነረ ቃሪና ዳብሎስ አነረ ሰጣን ጋይምድባብ ኤና እሪ ጉንኔ።<note caller="-" style="x"><char style="xo" closed="false">20፡2 </char><char style="xt" closed="false"><ref loc="NUM 3:1">ፋይ. 3፡1</ref>። </char></note> <verse eid="REV 20:2"/><verse number="3" style="v" sid="REV 20:3"/>ሳአ ስለና ቦድምተርን የለልታ ዎርሰንከስም ኮተርዝዳክንግንዳ ክታይንችና ቃሪንም ጩልጩል ጎርናር ኦይቼ፥ ጎርንታ አፈን ዝጭሰረ Ꮊየነረ ፎጅዳክንግንዳ ማህተም ዘን የችሰ፥ ኮታ ቡር ቶክም ሰጫካንታ ቡልም ክትም ዝግዝዴ።<verse eid="REV 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4"/>ኮታ ቡር ባንችምንታ ዶቅንት ጎንገንከስም ሰድቴ፥ ባንችምንታ ዶቅንት ጎንገንከዘነረ ፋረድንግንዳ ገችታ ኤራ ከትካንታ እምስባብከስ ከት ዶቅስንካ ሰድቴ፥ የሱስጎካ ከት ማርከርሳንካንተኬ ሳብ ቃለንጎካ ኬታ ቃደና ተችምስባብ ኤድንከስታ ሰንፔንከስም ሰድቴ፥ ከታ ባችርንካንተኬ ክታ ምስልንካንታ ጎስታክባብከስ፥ ክታ ምስልን ኬታ ይንታ ባለዘነረ ማታ ይንታ አንንዘነረ ይያክባብከሰኬ። ከተረ ደእያርንካ አምሰኮ ክርስቶሰካ ክክን ሳአ ስለን ባንችምሰኬ።<note caller="-" style="x"><char style="xo" closed="false">20፡4 </char><char style="xt" closed="false"><ref loc="DAN 7:22">ዳን. 7፡22</ref>። </char></note> <verse eid="REV 20:4"/><verse number="5" style="v" sid="REV 20:5"/>ነገድባብ ደእሶ ዶቅድባብከስ ማቼ ሳአ ስለና ቦድምተርን የለልታ ደእናርንካ አማከኬ፥ ኮነረ እሪንደና ደእናርንካ አምንተኔ። <verse eid="REV 20:5"/><verse number="6" style="v" sid="REV 20:6"/>እሪንደትም ደእናርንካ አምንተንካንታ ማድባብከስ አንጅምስባበኬ ሳብካንታ ፋስምስባብከሰኬ፥ ቃስትምስ ደእና ከታዘን ዎልቃ Ꮊፋዬ፥ ከታ ሳብተኬ ክርስቶስታ ቄሰንከስ ማደኬ፥ ክርስቶሰከረ ክክን ሳአ ስለንም ባንችምደኬ።<verse eid="REV 20:6"/></para>
  <para style="s1">ሰጣንታ ጋምርና</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7"/>ሳአ ስለንከስ ቦድምሳንደታ ቡር ሰጣን ይንታ ዞክነናርንካ ቡልምዴ፥ <verse eid="REV 20:7"/><verse number="8" style="v" sid="REV 20:8"/>ፍጫሙደንታ ዘን ዶቅድን ዎርሰንከስም ጋይንት ጎግምኬ ማጎግም ኮተርስካንተኬ ዳምናር አርችካንታ ዉዴ፥ ኬታ ፋይደነረ ባሃርንታ ካንተናር ዶቅድን ሻምንግንደ፥<note caller="-" style="x"><char style="xo" closed="false">20፡8 </char><char style="xt" closed="false"><ref loc="EZK 7:2">ሕዝ. 7፡2</ref>፤ <ref loc="EZK 38:2">38፡2</ref>። </char></note> <verse eid="REV 20:8"/><verse number="9" style="v" sid="REV 20:9"/>ከታ ፍጫ ሙደናር የልሰኮ ሳብካንታ ፋስምስባብከስታ ሞረንምኬ ሳብካ ሶልምምሳን ካተመን ቀንሰኬ፥ ኬዛር ማቼ ኖሀ ጭላርንካ Ꮊንቸርሶ አትሶ ከትም ካይሴ። <verse eid="REV 20:9"/><verse number="10" style="v" sid="REV 20:10"/>ከትም ኮተርስባብ ዳብሎስ ባችሪንኬ ሳብዘንካ ኤሰራክዶቆ ካርከካ ኬዝድባብ ከት ዶቅድንደታር ድግዳክን አድን ኖሀ ባሀርንታ ዋር ኦይትምሰኬ፥ ኮታረረ ሶይትኬ Ꮊየካ ስለንክንደትዘንካ ስለንካ የለልታ ማጠርደኬ።<verse eid="REV 20:10"/></para>
  <para style="s1">በእንታ ፍርዳ</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11"/>ኮታ ቡር አንድር ጫምሳ ባንችምንከስታ ዶቅንት ጎንገንምኬ ባንችምንታ ዶቅንት ጎንገንዘን ዶቅስባብም ሰድቴ፥ ፍጨኬ ጭለኬ ክታ እሪንካ ካይደኬ፥ ካረረ ከትካንታ Ꮊፈራክዬ። <verse eid="REV 20:11"/><verse number="12" style="v" sid="REV 20:12"/>ደእስባብ መረንከስምኬ ባከንከስም ባንችምንከስታ ዶቅንት ጎንገንታ እሪ ከት ዎእስንካ ሰድቴ፥ ማጻፍንከሰረ ፎችምሰኬ፥ ዶቅንት ማጻፍ ማቻንዳ አብ ማጻፈረ ፎችምሴ፥ ደእስባብከሰረ ማጻፍንከሳር ኬታ ፍክስና ጻፍምሶ Ꮊፈርሳንከካ ፍርደንም ተየኬ፥<note caller="-" style="x"><char style="xo" closed="false">20፡12 </char><char style="xt" closed="false"><ref loc="DAN 7:9-10">ዳን. 7፡9-10</ref>። </char></note> <verse eid="REV 20:12"/><verse number="13" style="v" sid="REV 20:13"/>ባሀርነረ ይንታ ዋር ደእሶ ዶቅድባብከስም ዉችሴ፥ ደእኬ ደእስባብከስ ዶቅድን ጎርነረ ከታር Ꮊቅባብ ደእስባብከስም እምሰኬ፥ ዋልቃ ዋልቃ ኤድንከሰረ ይንታ ፍክስንግንዳ ፍርደን ተዬ። <verse eid="REV 20:13"/><verse number="14" style="v" sid="REV 20:14"/>ደእኬ ደእስባብከስ ዶቅድን ጎርነረ ኖሀ ባሀርናር ኦይትምሰኬ፥ ኮነረ ኖሀ ባሃርና ቃስትምስ ደእኔ። <verse eid="REV 20:14"/><verse number="15" style="v" sid="REV 20:15"/>ላምና ክታ ዶቅንት ማጻፍናር ጻፍምሶ Ꮊፈራክባብ ሙደና ኖሀ ባሀርናር ኦይትምሴ።<verse eid="REV 20:15"/></para>
  <chapter eid="REV 20"/>
  <chapter number="21" style="c" sid="REV 21"/>
  <para style="s1">ክላ ጭለንኬ ክላ ፍጨካ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1"/>ኮታ ቡር ክላ ጭለኬ ክላ ፍጨካ ሰድቴ፥ ኤና እሪ ጭለንኬ ኤና እሪ ፍጨንካ ካይተኬ፥ ባሀርነረ ይና ኮዘንካ ኦስ ዶቃዬ።<note caller="-" style="x"><char style="xo" closed="false">21፡1 </char><char style="xt" closed="false"><ref loc="ISA 65:17">ኢሳ. 65፡17</ref>፤ <ref loc="ISA 66:22">66፡22</ref>፤ <ref loc="2PE 3:13">2 ጴጥ. 3፡13</ref>። </char></note> <verse eid="REV 21:1"/><verse number="2" style="v" sid="REV 21:2"/>ሳብካንታ ፋስምሳን ካተመና ክላ የሩሳሌም ይንታ ክእስንካንታ ሰክስምሳን እሰንደትግንዳ ግግምሶ ጭላር ሳብደርንካ ኮት Ꮊንቸርድንካ ሰድቴ፥<note caller="-" style="x"><char style="xo" closed="false">21፡2 </char><char style="xt" closed="false"><ref loc="ISA 52:1">ኢሳ. 52፡1</ref>፤ <ref loc="ISA 61:10">61፡10</ref>፤ <ref loc="REV 3:12">ለም. 3፡12</ref>። </char></note> <verse eid="REV 21:2"/><verse number="3" style="v" sid="REV 21:3"/>“ይና! ሳብታ ገችንተና ኤድንከስካ ክክኔ፥ ከትከረ ክክን ኖ ዶቅተሬ፥ ከተረ ክታ ዎርሳ ማተረኬ። ሳብ ይንታ ማታርንካ ከትካ ክክን ማተረ፥ ኬታ ጮይሰረ ኖ ማተረ፥<note caller="-" style="x"><char style="xo" closed="false">21፡3 </char><char style="xt" closed="false"><ref loc="EZK 37:27">ሕዝ. 37፡27</ref>፤ <ref loc="LEV 26:11-12">ሌዊ. 26፡11-12</ref>። </char></note> <verse eid="REV 21:3"/><verse number="4" style="v" sid="REV 21:4"/>ኬታ ኤርመንመረ ሙዳ ኬታ አፍንዘንካ Ꮊጭተረ፥ ኤና እሪ ሪንከስ ሙዳ ስገዳንካንታ ደእ አነረ ሞርእ አነረ ኤፍ አነረ ማጥር ይና ኮዘንካ ኦስ ዶቃዬ” ኩነረ ጋይድንዳ አንድር ኡፍስ ባንችንታ ዶቅንት ጎንገንዘንካ ዉድንካ ኤሰርስቴ።<verse eid="REV 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5"/>ባንችምንከስታ ጎንገንዘን ዶቅስባበረ “ይና! እታ ሙዳ ሪም ክላ ማስትቴ!” ጋይሴ። ኮታዘንከረ “ኬና ቃለንከስ አመንምሳንደትኬ ዶፈን ማቻንካንታ ጻፍካ” እም ጋይሴ። <verse eid="REV 21:5"/><verse number="6" style="v" sid="REV 21:6"/>ኮተረ ቡር “ቦድምሴ! እሪነረ ቡርነረ፥ የድንተነረ በእንተነረ እትቴ፥ ዎቸርስባብካንታ ዶቅንት ቱት ሎቀናርንካ Ꮊረሰነረ ናክካይሳ ዉችኩን እምትቴ፥<note caller="-" style="x"><char style="xo" closed="false">21፡6 </char><char style="xt" closed="false"><ref loc="ISA 55:1">ኢሳ. 55፡1</ref>። </char></note> <verse eid="REV 21:6"/><verse number="7" style="v" sid="REV 21:7"/>ሙደን ጋምስባብ ኮትኮም ተይተሬ፥ እታ ክታ ጮይስ ማትቴ፥ ኖየረ እስታ ይንች ማተረ፥<note caller="-" style="x"><char style="xo" closed="false">21፡7 </char><char style="xt" closed="false"><ref loc="2SA 7:14">2 ሳሙ. 7፡14</ref>፤ <ref loc="PSA 89:26-27">የቺ 89፡26-27</ref>። </char></note> <verse eid="REV 21:7"/><verse number="8" style="v" sid="REV 21:8"/>ኬዛር ማቼ ጳዝድባብከስ፥ አመንካየንባብከስ፥ ቱነንከስ፥ ሰንፓ ደይዝድባብከስ፥ ቤልምንባብከስ፥ ሳገንባብከስ፥ ጮይስ ማታክሪን ጎይንድባብከስ፥ ማልድባብከስ ሙደና ኬታ እጨና ድግዳክን አድን ኖሀ ባሀርናር ማተረ፥ ኮነረ ቃስትምስ ደእኔ” ኩን እዝደር ጋይሴ።<verse eid="REV 21:8"/></para>
  <para style="s1">ክላ የሩሳሌም</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9"/>በእንታ ማችባብከስ ታብዛ ሳብታ ዋጭን ጮጫን ታብዛ ኡፍተንከስም የጅባብ ታብዛ ክታይንችንከሳርንካ ዋልቀና Ꮊድሶ “ኮሬ! ቆለንንታ ኬነን ማቻን እሰንም የስም ሰችትቴ” እዝደር ጋይሴ። <verse eid="REV 21:9"/><verse number="10" style="v" sid="REV 21:10"/>አያንከረ ዋልቃ አንድርኬ ቃልም ገቼንዘን እም ተይ አይስንደትኬ ሳብካንታ ፋስምሳንዳ የሩሳሌም ካተመና ጭላር ሳብደርንካ ኮት Ꮊንቸርድንካ እም ሰችሴ፥<note caller="-" style="x"><char style="xo" closed="false">21፡10 </char><char style="xt" closed="false"><ref loc="EZK 40:2">ሕዝ. 40፡2</ref>። </char></note> <verse eid="REV 21:10"/><verse number="11" style="v" sid="REV 21:11"/>ሳብታ ቦንቼንካ ና ሳግዝድ Ꮊቄ፥ ኮታ ሳክስነረ አንድር ቦንችምሳን ሰይንግንዳ፥ ማስታትግንዳ ሳግዝድንዳ ቦንችምሳን እያስጵድ ጋይምሳን ሰይን Ꮊቄ፥ <verse eid="REV 21:11"/><verse number="12" style="v" sid="REV 21:12"/>ታመኬ ቃስቴን ፍልተንከስ ዶቅድንዳ አንድርኬ ሰይንካ ጋሰርሳንዳ ቃልማ ጋስ Ꮊቄ፥ ታመኬ ቃስቴን ፍልተንከዘነረ ታመኬ ቃስቴን ክታይንች ዎእሰኮ ካርዝድ Ꮊቀኬ፥ ፉልተንከዘነረ ታመኬ ቃስቴን እስራኤልንከስታ አጥርንታ ላምንከስ ጻፍምቴ። <verse eid="REV 21:12"/><verse number="13" style="v" sid="REV 21:13"/>Ꮊይንታ ዉትንተዘንጎካ ማኬን ፉልተንከስ፥ ዘርመርጎካ ማኬን ፉልተንከስ፥ ታመርጎካ ማኬን ፉልተንከስ፥ Ꮊይንታ አርድንታጎካ ማኬን ፉልተንከስ Ꮊቀኬ።<note caller="-" style="x"><char style="xo" closed="false">21፡13 </char><char style="xt" closed="false"><ref loc="EZK 48:30-35">ሕዝ. 48፡30-35</ref>። </char></note> <verse eid="REV 21:13"/><verse number="14" style="v" sid="REV 21:14"/>ካተመንኮታ ሰይን ጋስና ታመከ ቃስተን የድንከስ ዶቅደኬ፥ የድንከዘነረ ታመኬ ቃስቴን ቆለንንካንታ ኦይትምስባብከስታ ላምና ጻፍምሶ Ꮊቄ፥<verse eid="REV 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 21:15"/>እካንታ ኬዝባብ ክታይንችንተረ ካተመንምኬ ኮታ ፉልተንም፥ ሰይን ጋስንመረ የርክሰርድንደትም ዎርቀታ ስብል ጉፋ ክታ Ꮊቄ፥<note caller="-" style="x"><char style="xo" closed="false">21፡15 </char><char style="xt" closed="false"><ref loc="EZK 40:3">ሕዝ. 40፡3</ref>። </char></note> <verse eid="REV 21:15"/><verse number="16" style="v" sid="REV 21:16"/>ኮት ካተመንተረ ቃልምንኬ ኮታ ሳክምንካ የካ ማቻንዳ ኦይድ ጋርጭምስ ኮታ Ꮊቄ፥ ክታይንችና ካተመንም የርክሰርድን ስብል ጉፈንካ ክት የርግዝድንካ ኮታ ቃልምና ቃስቴን ሳኤከ ኦይድ ጸታ ክሎ መትር ማድንዳ ማቼ፥ ኮታ ሳክምንኬ ጨዳ ኮታ ቃልምነረ የርክሰርሳንከካ ማቼ። <verse eid="REV 21:16"/><verse number="17" style="v" sid="REV 21:17"/>ክታይንችና ሰይን ጋስንም የርክሴ፥ ክታይንችና ይ የርግዝድን ኤስምሳን የርክስንደትካ የርግዝድንካ ማከን ቦንደኬ ታመኬ ቃስቴን መትር ማታባብ ማቼ፥ <verse eid="REV 21:17"/><verse number="18" style="v" sid="REV 21:18"/>ሰይን ጋስነረ ጋስምሳንዳ እያስጵድ ጋይምድን ቦንችምሳን ሰይንካ Ꮊቄ፥ ካተመነረ ማስታትግንዳ ሰችዝድንዳ ጭለጭል ማቻን ዎርቀካ ኡርሰርሳንዳ Ꮊቄ፥<note caller="-" style="x"><char style="xo" closed="false">21፡18 </char><char style="xt" closed="false"><ref loc="ISA 54:11-12">ኢሳ. 54፡11-12</ref>። </char></note> <verse eid="REV 21:18"/><verse number="19" style="v" sid="REV 21:19"/>ካተመንታ ሰይን ጋስንታ የድንከስ Ꮊክ Ꮊክ ቦንችምሳን ሰይንካ ሰክሰርሳንዳ Ꮊቄ፥ እሪንደታ የድና እያስጵድ፥ ቃስትምስና ሰንፐረ፥ ማክምስና ከልቀዶን፥ ኦይችምስና መርግድ ጋይምድባብከስ ቦንችምሳን ሰይን Ꮊቀኬ፥ <verse eid="REV 21:19"/><verse number="20" style="v" sid="REV 21:20"/>ጉጅሰረ ዶንቅስና ሰርዶንክስ፥ ላስና ሰርድዮን፥ ታብስና ክርስቶሎበ፥ ላመካይስና ብርሌ፥ ሳከልስና ዎራዉረ፥ ታምስና ክርስጵራስስ፥ ታመኬ ዋልቅስና ያክንት፥ ታመኬ ቃስትምስና አመተስጥኖስ ጋይምድባብ ቦንችምሳን ሰይንንከስ Ꮊቀኬ። <verse eid="REV 21:20"/><verse number="21" style="v" sid="REV 21:21"/>ታመኬ ቃስቴን ፉልተንከሰረ ታሜከቃስተን ቦንችምሳን እንቁ ጋይምድንከስካ Ꮊቄ፥ ዋልቃ ዋልቃ ፉልተና ዋልቃ ቦንችምሳን እንቁ ጋይምድንዘንካ ፍክስምሳንዴ፥ ካተመንኮተረ ጎግን ባስና ማስታትግንዳ ሳግዝድንዳ ጭለጭል ዎርቀካ ፍክስምሳንዳ Ꮊቄ።<verse eid="REV 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 21:22"/>ሙደንም ቆልድን ጮይስ ሳብንኬ ቆለንን ኮትካንታ ሳብታ ጭል ኤሀ ከት ማቻንካንታ ካተመንታ ዋር አብ ሳብታ ጭል ኤሀ ሰዳክቴ። <verse eid="REV 21:22"/><verse number="23" style="v" sid="REV 21:23"/>ሳብታ ቦንቼና ኮትካንታ ሳግዝድንካንተኬ ቆለንና ኮትካንታ ሳግዝድንኦል ኮት ካተመንካንታ Ꮊይነረ ማታ አርፈን ኮትካንታ ከት ሳግዝድንግንዳ ዝግሳዬ።<note caller="-" style="x"><char style="xo" closed="false">21፡23 </char><char style="xt" closed="false"><ref loc="ISA 60:19-20">ኢሳ. 60፡19-20</ref>። </char></note> <verse eid="REV 21:23"/><verse number="24" style="v" sid="REV 21:24"/>ዎርሰንከስ ኮታ ሳክመናር ኦንግተረኬ፥ ፍጨንዘን ባንችምንከሰረ ኬታ ይንታ ዶቅድን ቆልመንም ኮደር ተይᎺተረኬ፥<note caller="-" style="x"><char style="xo" closed="false">21፡24 </char><char style="xt" closed="false"><ref loc="ISA 60:3">ኢሳ. 60፡3</ref>። </char></note> <verse eid="REV 21:24"/><verse number="25" style="v" sid="REV 21:25"/>ኮት ካተመናር ፍጨና ሶይታይንካንታ ኮታ ፉልተንከስ Ꮊምን ሰጨከረ ዝጭማየኬ። <verse eid="REV 21:25"/><verse number="26" style="v" sid="REV 21:26"/>ዎርሰንከስ ሙደና ከታ ይንታ ዶቅድን ቆልመን ኮደር ተይሶᎺደኬ፥<note caller="-" style="x"><char style="xo" closed="false">21፡26 </char><char style="xt" closed="false"><ref loc="ISA 60:11">ኢሳ. 60፡11</ref>። </char></note> <verse eid="REV 21:26"/><verse number="27" style="v" sid="REV 21:27"/>ይንኤርዝድን ሪ ማቻንዳ ቦድሶ ኮታር አርዳዬ፥ ቱና ማቻን ሪም ይድባብኬ ማልትንም ኬዝድባብ ቦድሶ ኮታር አርዳክዬ፥ ኮታር አርድባብከሰረ ኬታ ላምና ዶቅንት ማጻፍናር ጻፍምስባብከስ Ꮊክዬ።<note caller="-" style="x"><char style="xo" closed="false">21፡27 </char><char style="xt" closed="false"><ref loc="ISA 52:1">ኢሳ. 52፡1</ref>፤ <ref loc="EZK 44:9">ሕዝ. 44፡9</ref>። </char></note><verse eid="REV 21:27"/></para>
  <chapter eid="REV 21"/>
  <chapter number="22" style="c" sid="REV 22"/>
  <para style="s1">ዶቅንት ሎቀኬ ዶቅንት Ꮊቃ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 22:1"/>ኮታ ቡር ክታይንችና ሳብዘንኬ ቆለንንታ ባንችም ጎንገንዘንካ ዉድንደትም ማስታትግንዳ ሳግዝድንደትም ጭለጭል ጋይሳን ሙርግድንዳ ዶቅንት ሎቀን እም ሰችሴ፥<note caller="-" style="x"><char style="xo" closed="false">22፡1 </char><char style="xt" closed="false"><ref loc="EZK 47:1">ሕዝ. 47፡1</ref>፤ <ref loc="ZEC 14:8">ዘካ. 14፡8</ref>። </char></note> <verse eid="REV 22:1"/><verse number="2" style="v" sid="REV 22:2"/>ናኮና ሎቀና ካተመንታ ግድካ አይድን ጎግን ፋስሶ አይዴ፥ ሎቀንታ ከችዘንጎኬ ምዝዘንጎካ አርፍንካ አርፍንካ ኡሰሮ ስለታዋር ታመኬ ቃስቴን ዱት አፍ ኡዝድንዳ ዶቅንት Ꮊቃ Ꮊቄ፥ Ꮊቀንተረ ቃምንከስ ዎርሰንከስም ፋጅድᎺቀ።<note caller="-" style="x"><char style="xo" closed="false">22፡2 </char><char style="xt" closed="false"><ref loc="GEN 2:9">ፍዝ. 2፡9</ref>፤ <ref loc="EZK 47:12">ሕዝ. 47፡12</ref>። </char></note> <verse eid="REV 22:2"/><verse number="3" style="v" sid="REV 22:3"/>ይና ኮዘንካ ኦስ Ꮊረሰነረ ባድና ዶቅተራክዬ፥ ሳብተኬ ቆለንንታ ባንችም ጎንገና ካተመንኮታር ማተረ፥ ክታ ፍክስንባብከሰረ ክትም ጎይንደኬ።<note caller="-" style="x"><char style="xo" closed="false">22፡3 </char><char style="xt" closed="false"><ref loc="ZEC 14:11">ዘካ. 14፡11</ref>። </char></note> <verse eid="REV 22:3"/><verse number="4" style="v" sid="REV 22:4"/>ክታ ባለንመረ ሰደኬ፥ ክታ ላምነረ ኬታ ባለንዘን ጻፍምተረ። <verse eid="REV 22:4"/><verse number="5" style="v" sid="REV 22:5"/>ይና ኮዘንካ ኦስ ፍጨና ሶይተራክዬ፥ ጮይስ ሳብና ከትካንታ ሳግዝድንካንታ ዞጳ አነረ Ꮊይንታ ሳክመና ከትካንታ ዝግሳዬ፥ ስለንክንደትዘንካ ስለንካ የለልታ ባንችምደኬ።<note caller="-" style="x"><char style="xo" closed="false">22፡5 </char><char style="xt" closed="false"><ref loc="ISA 60:19">ኢሳ. 60፡19</ref>፤ <ref loc="DAN 7:18">ዳን. 7፡18</ref>። </char></note><verse eid="REV 22:5"/></para>
  <para style="s1">የሱሰታ ማት Ꮊድና</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6"/>ኮታ ቡር ክታይንችና “ኬና ኬዘና አመንምስባብኬ ዶፈንንከሰኬ፥ ሳብዘንካ ኤሰርሶ ከዝባብከስም ከስዝድባብ ጮይስና ቅንች ሰጫር ማድንደት ሪም ይንታ ፍክስንባብከስካንታ መያ ማስካንታ ይንታክታይንችንም ኦይቼ” ኩን እዝደር ጋይሴ።<verse eid="REV 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 22:7"/>የሱሰረ “ይና! እታ ሳነካ Ꮊድቴ! ኮትኮ ማጻፍንታ ቤርካ ከዝምሳንደትም ካርዝድባብ አንጅምስባቤ!” ጋይሴ።<verse eid="REV 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 22:8"/>ከትኬና ሪንከስም ኤሰርስባብኬ ሰድባብ እታ ዮሀንስቴ፥ ከትኬ ሪንከስም እ ኤሰርሳንደትኬ እ ሰዳንደትካ ከትከሪንከስም እካንታ ሰችስባብ ክታይንችንካንታ ጎስትካንታ ክታ ዱትንዘን ዋችቴ። <verse eid="REV 22:8"/><verse number="9" style="v" sid="REV 22:9"/>ክታይንችና ማቼ “ዛእካ ኮም Ꮊይ ይዬ! እታ የስኬ የስታ እስመንከስ ሳብዘንካ ኤሰርሶ ኬዛቅባብከስካ ክክን አነረ ኮማጻፍንታ ቃለን ቦድባብ ኤድንከስካ ክክን ሳብታ ፍግዝድድባብቴ፥ ክት ሳብንካንታ ጎስትካ!” እዝደር ጋይሴ። <verse eid="REV 22:9"/><verse number="10" style="v" sid="REV 22:10"/>ኮታዘንከረ “ሰጨና ቅንችሳንካንታ ኮትኮ ማጻፍንታ ቤርካ ኬዝምሳን ቃለን ማይተምካ Ꮊይዝጬ፥ <verse eid="REV 22:10"/><verse number="11" style="v" sid="REV 22:11"/>ይና ኮዘንካ ኦስ ባችንባብ ይንታ ባችንም ባቼሮ አያ፥ ቱና ማችባበረ ኦስ እሪ ክት ቱና ማታ፥ ጭል ማችባበረ ኦስ እሪ ክት ጭልማ፥ ሳብካንታ ፋስምስባበረ ኦስ እሪ ሳብካንታ ፋስምሶ ክት ዶቃ” ኩን እዝደር ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">22፡11 </char><char style="xt" closed="false"><ref loc="DAN 12:10">ዳን. 12፡10</ref>። </char></note><verse eid="REV 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 22:12"/>“ይና! እታ ሳነካ Ꮊድቴ! ዋልቃ ዋልቀንካንታ ክታ ፍክስንግንዳ እምምድን ናክንም የትቴ፥<note caller="-" style="x"><char style="xo" closed="false">22፡12 </char><char style="xt" closed="false"><ref loc="ISA 40:10">ኢሳ. 40፡10</ref>፤ <ref loc="ISA 62:11">62፡11</ref>፤ <ref loc="PSA 28:4">የቺ 28፡4</ref>፤ <ref loc="JER 17:10">ኤር. 17፡10</ref>። </char></note> <verse eid="REV 22:12"/><verse number="13" style="v" sid="REV 22:13"/>የድንተንኬ ቦድንተንካ፥ እሪነረ ቡርነረ እትቴ”። <note caller="-" style="x"><char style="xo" closed="false">22፡13 </char><char style="xt" closed="false"><ref loc="REV 1:8">ለም. 1፡8</ref>፥<ref loc="REV 1:17">17</ref>፤ <ref loc="REV 2:8">2፡8</ref>፤ <ref loc="ISA 44:6">ኢሳ. 44፡6</ref>፤ <ref loc="ISA 48:2">48፡2</ref>። </char></note><verse eid="REV 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 22:14"/>ዶቅንት Ꮊቀንታ አፍን እችካንተኬ ኮታ ፍልተንከስከረ ኦስ ካተመናር አርድካንታ ሸን ከትካንታ ዶቅተርንግንዳ ኬታ ይንታ አፍለንም ስእስባብከስ አንጅምስባበኬ።<note caller="-" style="x"><char style="xo" closed="false">22፡14 </char><char style="xt" closed="false"><ref loc="GEN 2:9">ፍዝ. 2፡9</ref>፤ <ref loc="GEN 3:22">3፡22</ref>። </char></note> <verse eid="REV 22:14"/><verse number="15" style="v" sid="REV 22:15"/>አክስንከስግንዳ ይንታ ማተን ቱና ማዝድባብከስ፥ ሳገንባብከስ፥ ቤልምንባብከስ፥ ኤታ ሰንፓ ደይዝድባብከስ፥ ጮይስ ማታክንርም ጎይንድባብከስ፥ ማልትንም ሶልምድባብከስኬ ካርካ ጎግንካ አይድባብከስ ሙደና ካተመንኮታ ማልጎካ ነገደኬ።<verse eid="REV 22:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 22:16"/>“እታ የሱስ ኮም ማርካትቼን የካንታ እምተርንግንዳ እስታ ክታይንችን ᎺክᎺክ ምክስ ኤሄንከስካንታ ኦይትቴ፥ እታ ዳዊተታ ጫጭኬ አጥርያርንክንባብቴ፥ ሳግዝድን ሰጭማ ማንካርቴ”። <note caller="-" style="x"><char style="xo" closed="false">22፡16 </char><char style="xt" closed="false"><ref loc="ISA 11:1">ኢሳ. 11፡1</ref>፥<ref loc="ISA 11:10">10</ref>። </char></note><verse eid="REV 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 22:17"/>ክታ አያንንኬ እሰነረ “ኮሬ!” ጋይደኬ፥ ኤሰርድባበረ “ኮሬ!” ክት ጋያ፥ ዎቼርስባበረ Ꮊዳ፥ ዝግዝባበረ ዶቅንት ሎቀን Ꮊረሰነረ ናክካይሳ ዉችኩን ክት ዎጫ።<note caller="-" style="x"><char style="xo" closed="false">22፡17 </char><char style="xt" closed="false"><ref loc="ISA 55:1">ኢሳ. 55፡1</ref>። </char></note><verse eid="REV 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18"/>ይና ኮ ማጻፍናር ጻፍምሳን ቤርካ ኬዝምሳን ቃለን ኤሰርድባብ ሙደንም ኤግዝምዝድቴ፥ Ꮊየሰነረ ኮ ቃለንዘን ዋልቃ ሪየረ ጉጅሴ፥ ኮ ማጻፍናር ጻፍምሳን ዋጭንከስም ሳብ ክታዘን ጉጅተሬ። <verse eid="REV 22:18"/><verse number="19" style="v" sid="REV 22:19"/>Ꮊየነረ ኮትኮ ቤርካ ኬዝምሳን ማጻፍናር ጻፍምሳን ቃለንከሳርንካ ዋልቃ ዎራ ክት ዞግሴ፥ ኮትኮ ማጻፍናር ኬዝምሳን ዶቅንት Ꮊቀንታ አፍንዘንኬ ሳብካንታ ፋስምሳን ካተመንዘንካ ሳብ ክትካንታ የልድንደትም ዞግስተረ።<note caller="-" style="x"><char style="xo" closed="false">22፡19 </char><char style="xt" closed="false"><ref loc="DEU 4:2">ካሪ. 4፡2</ref>፤ <ref loc="DEU 12:32">12፡32</ref>። </char></note><verse eid="REV 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 22:20"/>ከትኬና ሪንከስታ ማርካ ማችባብ “ይዬ ሳነካ Ꮊድቴ!” ጋይዴ።</para>
  <para style="p" vid="REV 22:20">አምንኤ፥ ጮይስ የሱሶ Ꮊድካ!<verse eid="REV 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 22:21"/>ጮይስ የሱሰታ ዉች እምንተና የ ሙደንካ ክክን ማታ።<verse eid="REV 22:21"/></para>
  <chapter eid="REV 22"/>
</usx>
