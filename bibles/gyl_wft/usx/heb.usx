<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- Gayil New Testament</book>
  <para style="h">ዕብራውያን</para>
  <para style="toc1">ዕብራውያን ኤድንከስካንታ ኦይትምሳን ክታ</para>
  <para style="toc2">ዕብራውያን</para>
  <para style="toc3">ዕብ.</para>
  <para style="mt1">ዕብራውያን ኤድንከስካንታ ኦይትምሳን ክታ</para>
  <para style="imt1">አርድንታ</para>
  <para style="ip">ኮና ክቴና ጻፍምሳንዳ አንድር ግርንታ ከታዘን የልሳንጎካ ኬታ ይንታ አሜንን ዛቅካንታ የልስባብ ክርስቶሳር ማችባብከስካንቴ፥ ጻፍስባቤረ ዕብራውያን ፍጨናር አመንድባብከስካንታ መያ ክት ማዝድንዳ የሱስ ክርስቶስ ዶፈንኬ ሳብታ መያ ማትንተንታ በእንተን ሰችኬ። ከታኬና ክርስቶሳር ማችባብከስ ከታ ይንታ አሜንካ ዳቅድንግንዳ ከትም ዛብዝዴ፥ ኮመረ ክት ይድንደትካ ማኬን ዶፈንንከስም መየካ ሰችዝዴ፥</para>
  <para style="ip">1. ይ ተያን ማጠንጎካ ይንታ ባቤንካንታ ዶፈን ክትምስባብ የሱስ ስለንክንደታ ኖ ሳብታ ይንቼ፥ ሳብታ ይንች ይንታ ማትንተንከረ ኤና እሪ ጫቀንታ ሳብዘንካ ኤሰርሶ ከዛቅባብከዘንካ፥ ሙሴዘንኬ ክታይንችንከዘንካ አንድር ስግድባቤ።</para>
  <para style="ip">2. ኤና እሪ ጫቀንካ ፍክሳᎺቅባብ ቄሰንከዘንካ የሱስይ አንድር ስግድባብ ስለንክንደታ ቄሳ ክታ ማትንተን ሳብ ይንታ ማታርንካ ኬዝቴ።</para>
  <para style="ip">3. የሱስጎካ አሜንድባብ ጎማርንካ፥ ጳስዘንኬ ደእዘንካ አቅዴ፥ የሱስይ ቄሰንከስም ገችዝድባብ ይ ማቻንግንዳ ዕብራውያን ኤድንከስታ አሜንንታ ዎገንከስኬ መሄንከስም ካሰርድንዳ ስፍግንዳ ሰድምድ Ꮊቃንዳ አቅንተና ዶፈን ማድንግንዳ ማስቴ።</para>
  <para style="ip">ጻፍስባብና እስራኤልንከስታ ፍክስምሶ ስገዳንደታር ኤስምስባብ ማቻን ኤድንከስታ አሜንን ካምስ ማስሶ (የድይ 11) ናበብድባብከስ ከታ ይንታ አሜንካ ዳቅተርንግንዳ ከትም ገቀርስዝዴ፥ ኮትኮግንደረ (የድይ 12) ናበብድባብከስ ከታ ይንታ አፍንከስም የሱሰታዘን ማስሰኮ ከታ ይንታ አሜንካ ዳቅተርንግንደኬ Ꮊምነረ ማጠከ ዘረካ ከታዘን የልሳን ማቼረ ከት ዳቅድንግንዳ ከትም ኖ ዞርዴ፥ ኬዘንም በይዝደረ ዞረተከ ኤግዝምስታ ኬዘንም ኬዝሶ በይዝዴ።</para>
  <para style="iot">ማጻፍን ኮትኮታ ሙዳ የድንተና</para>
  <para style="io1">አርድንታ፥ ሳብ ክርስቶስጎካ መያ ክታ ማትና <char style="ior">(<ref loc="HEB 1:1-3">1፡1-3</ref>) </char></para>
  <para style="io1">ክርስቶስ ክታይንችንከዘንካ ስግ ክታ ማትን <char style="ior">(<ref loc="HEB 1:4-2:18">1፡4—2፡18</ref>) </char></para>
  <para style="io1">ክርስቶስ ሙሴዘንኬ ኢያስዘንካ ስግ ክታ ማትን <char style="ior">(<ref loc="HEB 3:1-4:13">3፡1—4፡13</ref>) </char></para>
  <para style="io1">ቄሳ ማትንተና ክርስቶሰትንዳ ሙደንዘንካ ስግና <char style="ior">(<ref loc="HEB 4:14-7:28">4፡14—7፡28</ref>) </char></para>
  <para style="io1">ክርስቶሰታ ጫቃ ቃለንታ ስግ ማትንተና <char style="ior">(<ref loc="HEB 8:1-9:22">8፡1—9፡22</ref>) </char></para>
  <para style="io1">ክርስቶሰ ካሲ ማትንተካ ሙደንዘንካ ስግና <char style="ior">(<ref loc="HEB 9:23-10:39">9፡23—10፡39</ref>) </char></para>
  <para style="io1">አሜንንታ አንድርትቼና <char style="ior">(<ref loc="HEB 11:1-12:29">11፡1—12፡29</ref>) </char></para>
  <para style="io1">ሳብም ጉርምስ <char style="ior">(<ref loc="HEB 13:1-19">13፡1-19</ref>) </char></para>
  <para style="io1">ምክስካ ዝጭ <char style="ior">(<ref loc="HEB 13:20-21">13፡20-21</ref>) </char></para>
  <para style="io1">በእንታ <char style="ior">(<ref loc="HEB 13:22-25">13፡22-25</ref>) </char></para>
  <chapter number="1" style="c" sid="HEB 1"/>
  <para style="s1">ሳብ ይንታ ይንቺንጎካ ኬዜ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1"/>ሳብ ኤና እሪ ስለናር Ꮊክ Ꮊክ ጎግካ፥ ሳብዘንካ ኤሰርሶ ኬዝድባብከስጎካ ዎንታ ባቤንከስካንታ በድᎺይካ ኬዝድ Ꮊቄ፥ <verse eid="HEB 1:1"/><verse number="2" style="v" sid="HEB 1:2"/>ታ ማቼ ኮ በእንታ ስለናር ሙዳ ሪን ክታ ይንቺንጎካ ከኬን ተይድንግንዳ ይስስባብጎካ ዎካንታ ኬዜ፥ ፍጫ ሙደንመረ ክት ፍዛንዳ ክትኬ። <verse eid="HEB 1:2"/><verse number="3" style="v" sid="HEB 1:3"/>ኖ ሳብታ ቦንቼንም ሮጵስሶ ሰችዝድባቤ፥ ኖይንታ እዘንካ ሳብካ ክክን ኖ ገታ የኬ። ይንታ ዎልቃ ቃለንካ ፍጫ ሙደን ዳቅስሶ ኖ የቴ፥ ኤድንከስመረ ከታ ጎመናርንካ ይ ጭልሳንደታ ቡሪ ጭላር አንድር ሳብንታ ምዝዘን ዶቅቴ።<verse eid="HEB 1:3"/></para>
  <para style="s1">ሳብ ይንቺና ክታይንችንከዘንካ አንድር ስግና</para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4"/>ክትካንታ ዎድምሳንዳ ላምና ክታይንችንታ ላምንዘንካ ስግ ማቻንከካ ሳብታ ይንቺና ክታይንችንዘንካ አንድር ስግዬ።<note caller="-" style="x"><char style="xo" closed="false">1፡4 </char><char style="xt" closed="false"><ref loc="PSA 2:7">የቺ 2፡7</ref>። </char></note><verse eid="HEB 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HEB 1:5"/>ሳብ ቦድሶ ክታይንችንታ ዎክያርንካ፥</para>
  <para style="q1" vid="HEB 1:5">“የና እስታ ይንቼዬ፥ ታካ የስም አእትቴ”</para>
  <para style="q1" vid="HEB 1:5">አነረ</para>
  <para style="q1" vid="HEB 1:5">“እታ ክታ ባቤና ማድቴ፥ ኖየረ እስታ ይንቺ ማተረ”</para>
  <para style="q1" vid="HEB 1:5">ጋይሳንዳ Ꮊየንካንተረ ካዬ።<note caller="-" style="x"><char style="xo" closed="false">1፡5 </char><char style="xt" closed="false"><ref loc="2SA 7:14">2 ሳሙ. 7፡14</ref>፤ <ref loc="1SA 17:13">1 ሳሙ. 17፡13</ref>። </char></note><verse eid="HEB 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 1:6"/>ሳብ ይንታ ዳነዝ ይንቺንም ኮ ፍጫሙደንካንታ ኦይቻንደትካ</para>
  <para style="q1" vid="HEB 1:6">“ሳብታ ክታይንችንከስ ሙደና ክትካንታ ጎስታጋካ” ጋይቴ።<note caller="-" style="x"><char style="xo" closed="false">1፡6 </char><char style="xt" closed="false"><ref loc="DEU 32:43">ካሪ. 32፡43</ref>። </char></note><verse eid="HEB 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 1:7"/>ይንታ ክታይንችንጎካ</para>
  <para style="q1" vid="HEB 1:7">“ክታይንችንከስም አያን፥</para>
  <para style="q2" vid="HEB 1:7">ሳብታ ፍክስንባብከስመረ ኖሄታ ሎግንችንግንዳ ማዝድቴ” ጋይዴ<note caller="-" style="x"><char style="xo" closed="false">1፡7 </char><char style="xt" closed="false"><ref loc="PSA 104:4">የቺ 104፡4</ref>። </char></note><verse eid="HEB 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 1:8"/>ይንታ ይንቺንጎካ ማቼ፥</para>
  <para style="q1" vid="HEB 1:8">“ሳብዮ! የስታ ዶቅንት ጎንገና ስለንክንደታ ዶቅተሬ፥</para>
  <para style="q2" vid="HEB 1:8">የስታ ባንችምንመረ ዶፈንካ ገችዝዳዬ፥<verse eid="HEB 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9"/>ጭለትችንም ሶልምሳዬ፥ ዳቀልስን ቦሳዬ፥</para>
  <para style="q1" vid="HEB 1:9">ኮጎካ ሳብ የስታ ሳብና የስም እጄ፥</para>
  <para style="q2" vid="HEB 1:9">የስታ ላኮይትንከዘንከረ ስግስሶ ጉርም እምድን ሳየርድንደትካ የስም ሳይሴ” ጋይዴ።<note caller="-" style="x"><char style="xo" closed="false">1፡9 </char><char style="xt" closed="false"><ref loc="PSA 45:6-7">የቺ 45፡6-7</ref>። </char></note><verse eid="HEB 1:9"/></para>
  <para style="m">
    <verse number="10" style="v" sid="HEB 1:10"/>ኮትኮግንደረ</para>
  <para style="q1" vid="HEB 1:10">“ጮይስዮ! የና እሪምሳዮ ፍጨንም ፍዘዬ፥</para>
  <para style="q2" vid="HEB 1:10">ጭለንከሰረ የስታ አንንካ ፍዛዬ፥<verse eid="HEB 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11"/>ከታ ሙዳ ካይደኬ፥</para>
  <para style="q1" vid="HEB 1:11">የና ማቼ ዶቅተራዬ፥</para>
  <para style="q1" vid="HEB 1:11">ከታ ሙዳ አፍላ ግንዳ ገሰርደኬ።<verse eid="HEB 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12"/>ዳኬንግንዳ ቁርተራዬ፥</para>
  <para style="q1" vid="HEB 1:12">ከተረ ገሳ አፍለን ክለካ ኦከርድንግንዳ ኦክምደኬ።</para>
  <para style="q2" vid="HEB 1:12">የና ማቼ ሙዳᎺይካ የነተዬ፥</para>
  <para style="q2" vid="HEB 1:12">የስታ ስለንተረ በእንታ ካዬ” ጋይዴ።<note caller="-" style="x"><char style="xo" closed="false">1፡12 </char><char style="xt" closed="false"><ref loc="PSA 102:25-27">የቺ 102፡25-27</ref>። </char></note><verse eid="HEB 1:12"/></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13"/>ሳብ ይንታ ክታይንችንታ ዎክያርንካ፥</para>
  <para style="q1" vid="HEB 1:13">“የስታ ይምኤንባብከስም የስታ ገችንታ ኤረንታ ጎያር ማስተርን የለልታ</para>
  <para style="q2" vid="HEB 1:13">እስታ ምዝንዘን ዶእካ” ጋይሳንዳ Ꮊይካንተረ ካዬ።<note caller="-" style="x"><char style="xo" closed="false">1፡13 </char><char style="xt" closed="false"><ref loc="PSA 110:1">የቺ 110፡1</ref>። </char></note><verse eid="HEB 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 1:14"/>ይና፥ ክታይንችና ሙዳ አቅድባብ ኤድንከስካንታ ከት ፍክሳባብ ኦይትምድባብከስ ሳብታ ፍግዝድባብ አያንንከሰኬ።<verse eid="HEB 1:14"/></para>
  <chapter eid="HEB 1"/>
  <chapter number="2" style="c" sid="HEB 2"/>
  <para style="s1">አንድር አቅንተና</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1"/>ኮካንታ ዎ ኤሰርሳን ርይንዘንካ ዎ ዋችተራክንግዳ ዎ ኤሰርሳን ሪይንጎካ አንድር ዎ ካችካ ካርስም ዝግዝዴ። <verse eid="HEB 2:1"/><verse number="2" style="v" sid="HEB 2:2"/>ክታይንችንጎካ ኬዝምሳን ቃለና ዶፈን ማቴ፥ ኮትኮም ቃለንመረ ካርዝዳክባብኬ ኮትኮ ቃለንካንታ ክትምዳክባብ ዝግዝድን ዋጭን ተይቴ፥ <verse eid="HEB 2:2"/><verse number="3" style="v" sid="HEB 2:3"/>ይና፥ ዎታ ኮም አንድር አቅንተን በህ ዎ ጋይድንዳ ማቼ Ꮊስግንዶንት ሱርዳ? ኮም አቅንቴን እሪምሶ ኤስምስባብ ጮይስ ይንታ ማታርንኬ፥ ክታዘንካ ኤሰርሳን ኤድንከሰረ ኮትኮም መያ ዎካንታ ማስቴ። <verse eid="HEB 2:3"/><verse number="4" style="v" sid="HEB 2:4"/>ሳበረ ጉጅሶ ቃዉተንከስም፥ በርእዝድን ሪይንከስም፥ Ꮊክ Ꮊክ አተን ይይንተኬ ክታ ጋይተንግንዳ እምምሳን አያን ጭልንም ከትካንታ የልስንተካ ከታ ማርካትቼን ዳቅስቴ።<verse eid="HEB 2:4"/></para>
  <para style="s1">ኤድ ይንችታ አቅንተታ ጎርስንባብ የሱሰታ ማትና</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5"/>ሳብ ኦስ እሪ Ꮊድንደትም፥ ኮም ዎከዝምድን ኮፍጫ ሙደን ክታይንችንከስታ ጎያር ገችሳክዬ፥ <verse eid="HEB 2:5"/><verse number="6" style="v" sid="HEB 2:6"/>ኮትኮግንደረ ጭል ማጻፍንከሳር ዋልቃ ካርዘን ኩን ጋይምቴ፥</para>
  <para style="q1" vid="HEB 2:6">“የስ ክትም ገቀራባብ ኤድ Ꮊራ?</para>
  <para style="q2" vid="HEB 2:6">ክትካንታ የስ ካርስምተርንግንዳ ኤድ ይንች Ꮊራ?<verse eid="HEB 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7"/>ክታይንችንዘንካ ቶክም መርሳ ማስሳዬ፥</para>
  <para style="q2" vid="HEB 2:7">ቦንቼተኬ ጋለታ ዛዉደን ክታዘን ዎጀዬ፥</para>
  <para style="q2" vid="HEB 2:7">የስታ አን ፍክስንከዘን ክትም ዶርሰዬ”። <note caller="+" style="f"><char style="fr" closed="false">2፡7 </char><char style="ft" closed="false">የስታ አንይ ፍክስንዘን ክትም ዶሪሳየ ጋይድንዴትም አብ ማፅሀፍናር ጉጃዬ። </char></note><verse eid="HEB 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 2:8"/>“ሙዳ ሪን ክታ ገችንታ ኤረንታ ጎያር ክትካንታ ይስሳዬ”።<note caller="-" style="x"><char style="xo" closed="false">2፡8 </char><char style="xt" closed="false"><ref loc="PSA 8:4-6">የቺ 8፡4-6</ref>። </char></note></para>
  <para style="m" vid="HEB 2:8">ሙዳ ሪን ክታ ገችንታ ኤረንታ ጎያር ይድንካ፥ ክታ ገችንታ ኤረንታ ጎያር ይያክሳ ነክሳንዳ Ꮊራርየነረ ካዬ። ኬዛር ማቼ ታ ዶቅድንደትግንዳ ሙዳ ሪና ክታ ገችታ ኤረንታ ጎያር ማቻንደትም አክ ሰዳኮቴ። <verse eid="HEB 2:8"/><verse number="9" style="v" sid="HEB 2:9"/>ታ ማቼ ክታይንችንዘንካ ቶክም ይርክን ጋይሶ Ꮊቅባብም፥ ደእታ ማጠንም ክት ተያንጎካ ቦንቼተኬ ጋለታ ዛዉደን ባልስባብ የሱሰም ሰዶቴ፥ ኖ ሳብታ ዉች እምንተንካ ዎሙደንካንታ ደእቴ። <verse eid="HEB 2:9"/><verse number="10" style="v" sid="HEB 2:10"/>ሙዳ ሪና ክትኬ ክትካንታ ፍዝምሳንዳ ሳብ በድ ይንችንከስም ቦንቼዘን ተይᎺድካንታ ከታ አቅንተንታ ጎርስንባብ ማችባብ የሱሰም ማጠንም ስክስካ ቦድማ ማድንግንዳ ይያባብ ክትም ዝክሴ።<verse eid="HEB 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 2:11"/>ኤድንከስም ሳብካንታ ፋስምስባብ ማዝድባብ የሱሰኬ ክትካ ሳብካንታ ፋስምስባብ ማችባብ ኤድንከሰረ ዋልቃ ባቤንታ ይንችንከሰኬ፥ ኮጎካ ኖ ከትም “እስታ እስመንከሶ” ጋይሶ ኤልካንታ ኦስናዬ። <verse eid="HEB 2:11"/><verse number="12" style="v" sid="HEB 2:12"/>ኮካንተረ ጭል ማጻፍንከሳር</para>
  <para style="q1" vid="HEB 2:12">“የስታ ላምንም እስታ እስመንከስካንታ ኤስምዝድቴ፥</para>
  <para style="q2" vid="HEB 2:12">ጭልንከስ ሳንምሳንደታ ዎክያር የቺካ ጋለድቴ” ጋይዴ፥<note caller="-" style="x"><char style="xo" closed="false">2፡12 </char><char style="xt" closed="false"><ref loc="PSA 22:22">የቺ 22፡22</ref>። </char></note><verse eid="HEB 2:12"/></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13"/>ኮትኮግንደረ “እስታ አሜንን ክታዘን ማዝድቴ” ጋይዴ፥<note caller="-" style="x"><char style="xo" closed="false">2፡13 </char><char style="xt" closed="false"><ref loc="ISA 8:17-18">ኢሳ. 8፡17-18</ref>። </char></note></para>
  <para style="m" vid="HEB 2:13">ካርንከረ “ኮሰቼቴ እንከ ሳብ እካንታ እምሳን ይንችንከስ ካሮቴ” ጋይዴ።<verse eid="HEB 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14"/>ኮካንታ ክታ ይንችንከስ ዋሄኬ ማቀስካ ዶቅድባብ ኤድንከስ ከታ ማትንተንግንዳ የሱሰረ ከትግንዳ ኤድ ማቼ፥ ኮመረ ክት ይሳንዳ ይንታ ደእንጎካ ደእዘን ገችታ ኤራ ዶቅድባብ ዳብሎስም ካይስካንቴ። <verse eid="HEB 2:14"/><verse number="15" style="v" sid="HEB 2:15"/>ኮትኮግንደረ ደእንም ጳስጎካ ኬታ ይንታ ዶቅድን ስላ ሙደናር አይላትቻር ቆልምድ Ꮊቅባብም ቆት ተይካንቴ። <verse eid="HEB 2:15"/><verse number="16" style="v" sid="HEB 2:16"/>ገተረ የሱሰታ ዝግመትና ክታይንችን ማታክናና አብራሀመታ ሱሰንም አላካንቴ። <verse eid="HEB 2:16"/><verse number="17" style="v" sid="HEB 2:17"/>ኮካንታ ሙዳ ርይካ ይንታ እስመንከስግንዳ ማት ክትም ዝግዝድንካንታ ኖ ማቼ፥ ኮም ክት ይሳንዳ ኤድንከስታ ጎመንም ላላ ጋይስካንታ ጋይሶ ሳብታ ፍክስካንታ አሜንምስባብኬ አጨርድባብ ቀሰንከስታ ገችንባብ ማቼ። <verse eid="HEB 2:17"/><verse number="18" style="v" sid="HEB 2:18"/>ኖይንታ ማታርንካ ጰጭምሶ ማጠንም ክት ተያን ካንታ ጰጭምድባብከስም አሌንም አልዴ።<verse eid="HEB 2:18"/></para>
  <chapter eid="HEB 2"/>
  <chapter number="3" style="c" sid="HEB 3"/>
  <para style="s1">የሱስይ ሙሴዘንካ ስገድባብ ማትና</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1"/>ኮካንታ የተረ ጉጅሰረ ሳብካ ኤልምስባብከስ ሳብካንታ ፋስምስባብ አመንድባብከሶ! ዎንታ አሜንንጎካ ኦይትምስባብኬ ቄሰንከስታ ገችንባብ ማችባብ የሱሰም ገቀርከቴ። <verse eid="HEB 3:1"/><verse number="2" style="v" sid="HEB 3:2"/>ሙሴ ሳብታ ኤሄናር ሙዳ አሜንምስባብ ማትሶ Ꮊቃንግንዳ የሱሰረ ይም ዶርስባብ ሳብካንታ አሜንምስባብ Ꮊቄ። <verse eid="HEB 3:2"/><verse number="3" style="v" sid="HEB 3:3"/>ኤሄንም ዎድባብ ኤሄንዘንካ ስግስሶ አንድር ቦንቻ ክትካንታ ዶቅድንግንዳ ሙዳ የሱሰመረ ሙሴዘንካ ስግስሶ አንድር ቦንቻ ክትካንታ ዝግዝድንዳ ማቼ።<note caller="-" style="x"><char style="xo" closed="false">3፡3 </char><char style="xt" closed="false"><ref loc="NUM 12:7">ፋይ. 12፡7</ref>። </char></note> <verse eid="HEB 3:3"/><verse number="4" style="v" sid="HEB 3:4"/>ኬት ዋልቃ ዋልቃባብከስካንታ ኤሄን ዎድባብ ዶቅዴ፥ ሙዳ ሪን ፍክስባብ ማቼ ሳብዬ። <verse eid="HEB 3:4"/><verse number="5" style="v" sid="HEB 3:5"/>ኦስ እሪ ከዝም ዝግዝድን ሪንካንታ ማርካ ማተሮ በድ ሳብታ ኤሄናር ሙሳ አሜንምስባብ ፍክስንባብ ማትሶ Ꮊቄ። <verse eid="HEB 3:5"/><verse number="6" style="v" sid="HEB 3:6"/>ክርስቶስ ማቼ ሳብታ ኤሄናር አሜንምስባብ ክትማቻንዳ ይንችግንዳ ማትሴ፥ ኤሄነረ ዎቶቴ፥ ክታ ኤሀ ዎ ማድንደረ ዎ አሜንምድን ሪንኬ ዎ ጋይሪምድን ጉርምንም ዳቅስሶ ዎ የጃን ማቼ ማዴ።<verse eid="HEB 3:6"/></para>
  <para style="s1">አሜንምክሳ ነግዳን ዎርሰንካንታ እምምሳን ኤግዝምስ</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7"/>ኮካንታ አያን ጭልና ጋይድንግንዳ</para>
  <para style="q1" vid="HEB 3:7">“ታካ ሳብታ ኡፍስንም ኤሰርደቶ፥<verse eid="HEB 3:7"/></para>
  <para style="q2">
    <verse number="8-9" style="v" sid="HEB 3:8-9"/>ዴል ቆቼናር እም የንታ ባቤንከስ ጰጫንደትኬ ከት ግርዳንደትግንዳ</para>
  <para style="q2" vid="HEB 3:8-9">የንታ ቡደንም ኤእዳክንዳ Ꮊይማሰቴ፥ አነረ እንካ Ꮊይ ጋይችመቴ።</para>
  <para style="q2" vid="HEB 3:8-9">ቃስቴን ቦንዳ ስለናር እስታ ፍክስንም ሰደኬ” ጋይዴ ሳብ።<verse eid="HEB 3:8-9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10"/>“ኮካንታ ከትኬና አጥርንዘን ሰነርስቶ፥</para>
  <para style="q1" vid="HEB 3:10">‘ኬታ ቡደና ሙዳᎺይካ ኮተርዴ፥</para>
  <para style="q2" vid="HEB 3:10">እስታ ጎግንመረ ኤሳከኬ’ ጋይሳቴ”።<verse eid="HEB 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11"/>ጉጅሰረ፥</para>
  <para style="q1" vid="HEB 3:11">“ ‘እ ከትካንታ እምድን Ꮊዉስ ካርናር ቦድሶ አርዳየኬ!’ ጋይስቶ</para>
  <para style="q2" vid="HEB 3:11">እስታ ሰነርንካ ጫቅትቴ”።<note caller="-" style="x"><char style="xo" closed="false">3፡11 </char><char style="xt" closed="false"><ref loc="PSA 95:7-11">የቺ 95፡7-11</ref>። </char></note><verse eid="HEB 3:11"/></para>
  <para style="m">
    <verse number="12" style="v" sid="HEB 3:12"/>እስታ ገርነንከሶ፥ የንታ ዎክያርንካ Ꮊየነረ ዶቅንት ሳብንዘንካ ጎተርዝድን ዳቅልኬ አሜንዳክን ቡዳ ዶቅተራክንግንዳ ካርስምከቴ። <verse eid="HEB 3:12"/><verse number="13" style="v" sid="HEB 3:13"/>ስግስሶ የንታርንካ ጎመካ ገስምሶ ኤእዳክን ቡዳ ይንታ ማሳይንግንዳ “ታካ” ጋይምሶ ኤልምሳንዳ ሰጫ ዶቅድን የለልታ ሙዳᎺይካ ክክ ክክ ዛብስከቴ። <verse eid="HEB 3:13"/><verse number="14" style="v" sid="HEB 3:14"/>እሪምሶ ዎንታ ዶቅድን አሜንን በእንታ የለልታ ዛብስሶ ዎ የጄ ክርስቶስካ ክክን ባንችምን ተይዶቴ።<verse eid="HEB 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 3:15"/>ኮነረ “ታካ ክታ ኡፍስንም ኤሰርደቶ</para>
  <para style="q2" vid="HEB 3:15">ኮትኮ ግር ሰጨናይካ የንታ ባቤንንከስ ይሳንግንዳ የንታ ቡደን ኤእዳክንዳ Ꮊይ ማሰቴ”</para>
  <para style="m" vid="HEB 3:15">ጋይምሶ ኬዝምሳንግንዴ።<verse eid="HEB 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16"/>ማታጋካ ዳት ከታኬና ክታ ኡፍስንም ኤሰርሳንደታ ቡር ግርድባብ Ꮊይከሰረ? ከተረ ሙሴ ከትም ጎርዝድንካ ግብጻርንካ ዉተድባብከስ ሙደና ካየኮ? <verse eid="HEB 3:16"/><verse number="17" style="v" sid="HEB 3:17"/>ሳብም ቃስቴን ቦንዳ ስላ ሙዳ ሰነርሳᎺቅባብ ከታ Ꮊይከሰረ? ኬታ ኬነና ጎማ ፍክስባብከስኬ ከት ደእስንካ ኬታ ለይስና ዴል ቆቼናር ዋችሶ ነገድባብከስ ካየኮ? <verse eid="HEB 3:17"/><verse number="18" style="v" sid="HEB 3:18"/>ጉጅሰረ ከትከን ክትማክባብከስም ማታክንዳ ማቼ “እስታ Ꮊዉስ ካርናር አርዳከቴ” ጋይሶ ጫቅምሳንዳ አብ Ꮊይከስ ካንተረ? <verse eid="HEB 3:18"/><verse number="19" style="v" sid="HEB 3:19"/>ይና ከት አርድክሳ ነገዳንዳ አሜንክሳ ከታ ነግንጎካ ማትንተን ኤዝዶቴ።<verse eid="HEB 3:19"/></para>
  <chapter eid="HEB 3"/>
  <chapter number="4" style="c" sid="HEB 4"/>
  <para style="s1">ሳብታ ዎርሰንከስካንታ እምምድን Ꮊዉስ ሰጨንጎካ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1"/>ኮካንታ ሳብ ዎካንታ እምድን Ꮊዉስ ካርናር አርድካንታ አክ ዎ ተያን ጉርምና ዶቅድንኦል የንታርንካ Ꮊየነረ ኮትኮ Ꮊዉስ ካርናር አርድንተታ ማዳክባብ ማትሶ ነግዳክንግንዳ ዎታ ሙደና ዎ ካችካ ዎካርስማ። <verse eid="HEB 4:1"/><verse number="2" style="v" sid="HEB 4:2"/>ክላ ኬዘንም ከትካንታ ሳባክምሳንግንዳ ዎካንተረ ሳባክምቴ፥ ኬዛር ማቼ ከት ኤሰርሳን ቃለንም አሜንካ ከት ተያክንኦል ከትም መያክዬ። <verse eid="HEB 4:2"/><verse number="3" style="v" sid="HEB 4:3"/>ክታ ፍክስና ኮፍጫ ሙደና ፍዝምሳንደትዘንካ የድሶ ቦድምሳንዳ ማችንከረ ዎራ፥ “እ ከትካንታ እምድን Ꮊዉስ ካርናር ቦድሶ አርዳየኬ ጋይስቶ እስታ ዋጭንካ ጫቅትቴ” ጋይሳንግንዳ ታየረ ዎታ ዎ አመንድንዳ ሳብ ዎካንታ እምድን ኮት Ꮊዉስ ካርናር ዎታ አርዶቴ፥<note caller="-" style="x"><char style="xo" closed="false">4፡3 </char><char style="xt" closed="false"><ref loc="PSA 95:11">የቺ 95፡11</ref>። </char></note> <verse eid="HEB 4:3"/><verse number="4" style="v" sid="HEB 4:4"/>ይና ታብስ ሰጨንጎካ ጭል ማጻፍናር ዋልቃ ካርዘን “ሳብ ይንታ ፍክስ ሙደንዘንካ ታብስ ሰጨንካ Ꮊዉሴ” ጋይምሶ ጻፍምቴ።<note caller="-" style="x"><char style="xo" closed="false">4፡4 </char><char style="xt" closed="false"><ref loc="GEN 2:2">ፍዝ. 2፡2</ref>። </char></note> <verse eid="HEB 4:4"/><verse number="5" style="v" sid="HEB 4:5"/>ኮትኮግንደረ ኮትኮ ካርንዘን አናካርንካ</para>
  <para style="q1" vid="HEB 4:5">“እ ከትካንታ እምድን Ꮊዉስ ካርናር ቦድሶ አርዳከኬ” ጋይዴ።<note caller="-" style="x"><char style="xo" closed="false">4፡5 </char><char style="xt" closed="false"><ref loc="PSA 95:11">የቺ 95፡11</ref>። </char></note><verse eid="HEB 4:5"/></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 4:6"/>ከታኬና ክላ ኬዛን እሪምሶ ኤሰርስባብከስ ኬታ ክትምክሳ ነግንካ ሳብ ከትካንታ እምድን Ꮊዉስ ካርናር አርዳከኬ፥ ማችንከረ ኮታር ከት አርድንግንዳ ጋይምስባብ ዋልቃ ዋልቀንከስ ዶቅደኬ። <verse eid="HEB 4:6"/><verse number="7" style="v" sid="HEB 4:7"/>ኮነረ እርምሶ ጋይምሳንግንዳ</para>
  <para style="q1" vid="HEB 4:7">“ታካ ክታ ኡፍስን ኤሰርደቶ፥</para>
  <para style="q2" vid="HEB 4:7">የንታ ቡደን ኤእዳክንዳ Ꮊይማሰቴ”</para>
  <para style="m" vid="HEB 4:7">ጋየሮ ሳብ በድ ስለታ ቡሪ ዳዊትጎካ ክት ኬዛን ቃለንካ “ታካ” ጋይምሶ ኤልምሳን ሰጨና ማታ ጋይምሶ መያ ማቴ።<note caller="-" style="x"><char style="xo" closed="false">4፡7 </char><char style="xt" closed="false"><ref loc="PSA 95:7-8">የቺ 95፡7-8</ref>። </char></note><verse eid="HEB 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8"/>ኢያስ Ꮊዉስን ከትካንታ እምተስናና ሳብ አናካርንካ “ታካ” ጋይንተካ አብ ሰጨንጎካ ከዝስተራክዶቆ።<note caller="-" style="x"><char style="xo" closed="false">4፡8 </char><char style="xt" closed="false"><ref loc="DEU 31:7">ካሪ. 31፡7</ref>፤ <ref loc="JOS 22:4">ኢያ. 22፡4</ref>። </char></note> <verse eid="HEB 4:8"/><verse number="9" style="v" sid="HEB 4:9"/>ይና ሳብታ ዎርሰንከስካንታ አይሁድንታ Ꮊዉስ ሰጨንም ካምድንዳ Ꮊዉስና አክ ዶቅዴ፥ <verse eid="HEB 4:9"/><verse number="10" style="v" sid="HEB 4:10"/>ሳብ ይንታ ፍክስንዘንካ Ꮊዉሳንግንዳ ኮትኮግንደረ ሳብ እምድን Ꮊዉስ ካርናር አርድባብ ይንታ ፍክስንዘንካ Ꮊዉዝዴ።<note caller="-" style="x"><char style="xo" closed="false">4፡10 </char><char style="xt" closed="false"><ref loc="GEN 2:2">ፍዝ. 2፡2</ref>። </char></note> <verse eid="HEB 4:10"/><verse number="11" style="v" sid="HEB 4:11"/>ኮካንታ Ꮊየነረ ከትኬ ኤድንከስታ ኬታ ክትምክሳ ነግን ጎርስምሶ ዋጅዳክንግንዳ ሳብደር Ꮊዉስ ካርናር አርድካንታ ዎ ዛባ።<verse eid="HEB 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12"/>ሳብታ ቃለና ስለንካ ዶቅድንደትኬ ፍግዝድንዴ፥ ቃስተንንጎካ ግችምሳን ማሰንዘንካ ስግሶ ቃርድንዴ፥ ሰንፔንምኬ አያንን፥ ዝንንምኬ ለፍንም ፋስሶ ና ተጅድንዴ፥ ቡደታ ዋረረ ገቅርንምኬ አንግርንም ፋስሶ ፋረድንዴ። <verse eid="HEB 4:12"/><verse number="13" style="v" sid="HEB 4:13"/>ሳብታ እሪንካ አችምድንዳ Ꮊረነረ ፍዝር ካዬ፥ ክት ሳብታ አፍያር ሙዳሪይና መየኬ ዘናጫለንካ ማትሶ Ꮊፈርድንዴ፥ ዎተረ ኬዘታ ማስን እም ዎም ዝግዝድንዳ ክታ እሪዬ።<verse eid="HEB 4:13"/></para>
  <para style="s1">የሱስይ ቄሰንከስታ ገችንባብ ማትና</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14"/>ይና ኮዘንካ ጭለንከስም ስግሶ ፈስ ዉተድባብ አንድር ቀሰንከስታ ገችንባብ ዎንታ ዶቅድንካንታ ዎንታ አፈንካ ዎ ማርከርሳን አሜንን ዳቅስሶ ዎ የዳ፥ ቄሰንከስታ ገችንባበረ ሳብታ ይንች የሱስዬ። <verse eid="HEB 4:14"/><verse number="15" style="v" sid="HEB 4:15"/>ዎካንታ ዶቅድባብ ቄሰንከስታ ገችንባብ ዎንታ ጋፍንካንታ አጨርካንታ ማድባቤ፥ ኖ የሱስይ ጎማ ፍክሳክ ዳት አብ ሙዳ ሪንካ ዎግንዳ ጰጭምቴ። <verse eid="HEB 4:15"/><verse number="16" style="v" sid="HEB 4:16"/>ይና ሳብዘንካ አጭርንም ዎ Ꮊብድንግንደኬ አላ ዎም ዝግዝድንደትᎺይካ ሳብታ ዉች እምንተን ዎ Ꮊብድንግንዳ ሳብታ ዉች እምንተን ዎ Ꮊብድንደታር ሳብታ ዶቅንት ጎንገንደር ቦድማ አሜንምካ ዎ ቅንችማ።<verse eid="HEB 4:16"/></para>
  <chapter eid="HEB 4"/>
  <chapter number="5" style="c" sid="HEB 5"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1"/>ኬታ ዋልቃ ዋልቀና ቄሰንከስም ገችዝድባብ ኤድንከስታ ዎክያርንካ እድምሶ ሳብካ ክክን ከትም Ꮊብዝድን ሪንጎካ ኤድንከስታ ካርያር ማትሶ ሳብካንታ እምንተንምኬ ካሲንም ግግስካንታ ዶርምዴ። <verse eid="HEB 5:1"/><verse number="2" style="v" sid="HEB 5:2"/>ኖኮና ቄሰንከስም ገችዝድባብ ይንታ ማታርንካ ጋፍ ክታዘን ዶቅድባብ ማቻንካንታ ኤዝዳክባብከስምኬ ኮተርድባብከስም ቡዳርንካ አትርካ ከትም ሰዴ። <verse eid="HEB 5:2"/><verse number="3" style="v" sid="HEB 5:3"/>ኖይንታ ማታርንካ ይንታ ጋፍንጎካ ጎመታ ነገትቼን Ꮊፍስዝድን ካሲ እማ ዝግዝድንዳ ዎርሰንካንታ Ꮊክ ማታክናና ይንታ ማታካንተረ የኬ። <verse eid="HEB 5:3"/><verse number="4" style="v" sid="HEB 5:4"/>ኤና አሮንግንዳ ሳብካ ኤልምስባብ ማታክባብ ማቼ Ꮊየነረ ኮም ቦንቼን ይንቲ ይንታ ማታካንታ ኖ Ꮊፋዬ።<note caller="-" style="x"><char style="xo" closed="false">5፡4 </char><char style="xt" closed="false"><ref loc="EXO 28:1">ዉት. 28፡1</ref>። </char></note><verse eid="HEB 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 5:5"/>ኮትኮግንደረ ክርስቶስ ቄሰንከስታ ገችንባብ ማትንተታ ቦንቼን ገታ ይንታ ማታርንካ ተያክዬ፥ ኬዛርንካ ማቼ ኖ ቄሰንከስታ ገችንባብ ማትንተታ ቦንቼን ክት Ꮊፍሳንዳ፥</para>
  <para style="q1" vid="HEB 5:5">“የና እስታ ይንቼዬ፥</para>
  <para style="q2" vid="HEB 5:5">እታ ታካ የስም አእትቴ” ጋይስባብ ሳብዘንኬ።<note caller="-" style="x"><char style="xo" closed="false">5፡5 </char><char style="xt" closed="false"><ref loc="PSA 2:7">የቺ 2፡7</ref>። </char></note><verse eid="HEB 5:5"/></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 5:6"/>አብ ካርዘነረ ጭል ማጻፍናር ሳብ፥</para>
  <para style="q1" vid="HEB 5:6">“መልከጻድቅ ቄሳ ማትሶ ዶርምሳንግንዳ</para>
  <para style="q2" vid="HEB 5:6">የና ስለንክንደታ ቄሳዬ” ጋይዴ።<note caller="-" style="x"><char style="xo" closed="false">5፡6 </char><char style="xt" closed="false"><ref loc="PSA 110:4">የቺ 110፡4</ref>። </char></note><verse eid="HEB 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7"/>የሱስ ኤድ ማትሶ ኮ ፍጨዘን ክት Ꮊቃንደትካ ደእዘንካ አቅስካንታ ክትም ማድባብ ሳብደር አንድር ፍፍኬ በድ ኤርመካ ምክስንምኬ ጋልትምን ግግሴ፥ ይንታ ማተን ይርክሳ ይይንተካ ይንታ ማተንም ክትምድባብ ክታ ማስንካ ሳብ ምክስንም ኤሰርሴ።<note caller="-" style="x"><char style="xo" closed="false">5፡7 </char><char style="xt" closed="false"><ref loc="MAT 26:36-46">ማቶ. 26፡36-46</ref>፤ <ref loc="MRK 14:32-42">ማር. 14፡32-42</ref>፤ <ref loc="LUK 22:39-46">ሉቃ. 22፡39-46</ref>። </char></note> <verse eid="HEB 5:7"/><verse number="8" style="v" sid="HEB 5:8"/>Ꮊረነረ ሳብታ ይንች ይ ማችንከረ ዎራ ይ ተያን ማጠንካ ክትምንታ ኤስስን ኤሴ። <verse eid="HEB 5:8"/><verse number="9" style="v" sid="HEB 5:9"/>ቦድማ ማትሶ ይ Ꮊፈርሳንደታ ቡሪ ክትምድባብ ሙደንካንታ ስለንክንደታ አቅንተን Ꮊብድንግንዳ ይድባብ ከትካንታ ማቼ። <verse eid="HEB 5:9"/><verse number="10" style="v" sid="HEB 5:10"/>ክትመረ ሳብ መልከጻድቅ ቄሳ ማትካንታ ዶርምሳንግንዳ ቄሰንከስታ ገችንባብ ማስሶ የሱሰም ዶርሴ።<verse eid="HEB 5:10"/></para>
  <para style="s1">አሜንን ዛቅዳክንግንዳ እምምሳን ኤግዝምስ</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11"/>ኮትኮ ሪንታ ዎከዝድንዳ በድ ሪ ዶቅዴ፥ ኬዛርንካ ማቼ ኬዝድንደትም ኤሰርካንታ በህን የ ጋየጃንካንታ የም ኬዝት አርችና አንድርይ ማጠ። <verse eid="HEB 5:11"/><verse number="12" style="v" sid="HEB 5:12"/>ታ የለልታ ዶቅድንደታር የታ ኤስዝድባብከስ ማት የም ዝግዝዳዶቆ፥ ኬዛርንካ ማቼ ሳብታ ቃለን ኤና እሪ ኤስስን አብ ኤድ አናካርንካ ታ የም ኤስስ ዝግዝዴ፥ ኮትኮግንደካ የም ዝግዝድንዳ ራጭ ዳት ዳቅማ እችምን ካዬ። <verse eid="HEB 5:12"/><verse number="13" style="v" sid="HEB 5:13"/>ራጭም ማሲ ማሰርድባብ ሙደና አገል ማቻንካንታ ጭለትቼንጎካ ኤስስን አክ ኤሳክዬ።<note caller="-" style="x"><char style="xo" closed="false">5፡13 </char><char style="xt" closed="false"><ref loc="1CO 3:2">1 ቆሮ. 3፡2</ref>። </char></note> <verse eid="HEB 5:13"/><verse number="14" style="v" sid="HEB 5:14"/>ዳቅማ እችም ከትም ዝግዝድባብከስ ማቼ ኡርመንምኬ ዳቅልን ፋስት ኤስካንታ ይንታ ማተንም ግግስካንታ ጉርድባብ አንድር ኤድንከሰኬ።<verse eid="HEB 5:14"/></para>
  <chapter eid="HEB 5"/>
  <chapter number="6" style="c" sid="HEB 6"/>
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1"/>ይና ክርስቶስጎካ እምምሳን እሪንደት ኤስስንዘንካ አምሶቶ ቦድማ ማቻን ኤስስንደር አይተሮቴ፥ ደእዘን የልዝድን ፍክስ፥ ጎማ ፍክስን ዎይስንምኬ ሳብካ አመንምንታ የድን አናካርንካ ዎ የዳ፥ <verse eid="HEB 6:1"/><verse number="2" style="v" sid="HEB 6:2"/>ኮትኮግንደረ ስእርንትንደትም፥ አብንከዘን አንን ዎድንቴን፥ ደእያርንካ አምንቴን፥ ስለንክንደታ ፍርደንታ ኤስስን አናካርንካ የድንም ዎ Ꮊይ የዳ። <verse eid="HEB 6:2"/><verse number="3" style="v" sid="HEB 6:3"/>ሳብ ዎካንታ ጋይሴ ክርስቶሳር ጋጵዶቴ።<verse eid="HEB 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4"/>ኬታ ይንታ አሜንንም ካጃን ኤድንከስም ጎማ ይንታ ፍክስን ከት ዎይዝድንግንዳ Ꮊስግንዶክ ማዳ? ኬና ኤድንከስካንታ ኤና ኮታ እሪ ሳክመና ሳክታዶቆ፥ ጭላርንደትመረ እምንተን አፍስተክዶቆ፥ አያን ጭልንከረ ክክን የካ ማችባብከስም፥ <verse eid="HEB 6:4"/><verse number="5" style="v" sid="HEB 6:5"/>ሳብታ ኡርማ ቃለንምኬ ሳብታ ስለንክንደታ ገችታ ዎልቀን አፍስት ሰድባብከስም፥ <verse eid="HEB 6:5"/><verse number="6" style="v" sid="HEB 6:6"/>ኮ ሙደንታ ቡሪ ኬታ ይንታ አሜንን ካጄ፥ ኬታ ይንታ ማታርንካ ሳብታ ይንችን አናካርንካ ከት ሮግድንካንተኬ መየካ ከት ቶጅድንካንታ ከትም ጎማ ይንታ ፍክስንም ከት ዎይዝድንግንዳ ማስካንታ ማትማዬ።<verse eid="HEB 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7"/>በድᎺይካ ኮታዘን Ꮊንቼርድን ዶብን ዎጭድንዳ ኮርምሳን ኮርተና ኮርስባብ ኤድንካንታ መይድንደትም እምድን ፍጨና ሳብዘንካ አንጀንም Ꮊብዴ። <verse eid="HEB 6:7"/><verse number="8" style="v" sid="HEB 6:8"/>ጋልኬ ኡክምካ ኮት ባቀልሳን ማቼ መይዳክንዳ ና ማዴ፥ ቅንች ሰጫረረ ና ባድምዴ፥ ኮታ በእንተነረ ኖሄካ አትርዬ።<note caller="-" style="x"><char style="xo" closed="false">6፡8 </char><char style="xt" closed="false"><ref loc="GEN 3:17-18">ፍዝ. 3፡17-18</ref>። </char></note><verse eid="HEB 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9"/>የታ ገርነንከሶ! ኮም ዎከዘረ ዎራ የታ የንታ አቅንተንካንታ ማድንዳ ኡርማ ሪ የንታ ዶቅድንደትም ዎታ Ꮊኤርዳኮቴ። <verse eid="HEB 6:9"/><verse number="10" style="v" sid="HEB 6:10"/>ሳብ ሉላ ፍርድባቤ፥ ኮካንታ የንታ ፍክስንምኬ ኤና እረረ ማታ ታ ሳብካንታ ፋስምስባብከስም አሌንካ ክታ ላምንካንታ የ ሰችሳን ሶልመን ኖ ባቀራዬ። <verse eid="HEB 6:10"/><verse number="11" style="v" sid="HEB 6:11"/>የታ ሙደነረ ጉርምካ የካርዝድንደትም ሪን የ የተርን የለልታ የንታ ዛብንተን በእንታ የለልታ የ ሰችተርንግንዳ ዎታ አንገርዶቴ፥ <verse eid="HEB 6:11"/><verse number="12" style="v" sid="HEB 6:12"/>ዎ አንገርድንደነረ አሜንኬ ዳንዳእንካ ዳቅሶ ሳብ ጉርም ከትካንታ እምምሳን ሪን ተይድባብ ኤድንከስም የ ካምተርንግንዳ ዳት ቦዘንከስ የ ማተርንግንዳ ካዬ።<verse eid="HEB 6:12"/></para>
  <para style="s1">ሳብዘንካ ጉርምና አመንስዝድንዳ ማትና</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13"/>ሳብ አብራሀማካንታ ጉርም ክት እምሳንደት Ꮊይካ ክት ጫቅድንዳ ክታዘንካ ስገድባብ አብ Ꮊየነረ ካየንካንታ ኩንጋየሮ ይካችካ ጫቅሴ። <verse eid="HEB 6:13"/><verse number="14" style="v" sid="HEB 6:14"/>“ዶፈን የስም አንጅድቴ፥ የስታ ሱሰንመረ በችዝድቴ” ኩን ጋይሶ ሳብ ኬዜ።<note caller="-" style="x"><char style="xo" closed="false">6፡14 </char><char style="xt" closed="false"><ref loc="GEN 22:16-17">ፍዝ. 22፡16-17</ref>። </char></note> <verse eid="HEB 6:14"/><verse number="15" style="v" sid="HEB 6:15"/>አብራሀም ዳንዳእንካ ካርስሶ ጉርም ክትካንታ ከዝምሳን ሪን Ꮊፍሴ። <verse eid="HEB 6:15"/><verse number="16" style="v" sid="HEB 6:16"/>ኤድንከስ ጫቅደኮ ኬታ ይንታ ዘንካ ስገድን ላምካ ጫቅደኬ፥ ኬታ ይንታ ከዛንመረ ጫቀንካ ዳቅስሶ ኬታ ይንታ ዎክያር ዶቅድን በርምን ሙዳ ዎይዝደኬ። <verse eid="HEB 6:16"/><verse number="17" style="v" sid="HEB 6:17"/>ኮግንደካ ሳብ ማታ ጋይሳንዳ ኦክምዳክንዳ ማቻንደትም ስግስሶ መያማድንግንዳ ከትካንታ ሰችካንታ ዝግሶ ጉርም ተይድባብከስካንታ ጉርምንም ጫቀካ ከትካንታ ዳቅሴ። <verse eid="HEB 6:17"/><verse number="18" style="v" sid="HEB 6:18"/>ኮትኮግንደካ ሳብ ኦክምዳክንደትምኬ ከታዘን ማልዳክንደትም ቃስተን ሪይንከስም፥ ጋይንትነረ ጉርምንምኬ ጫቀንም ዎካንታ እምቴ፥ ከታከነረ ቃስተን ርይንከስጎካ ዎንታ እሪ ዶቅድን ጉርምን ዳቅስሶቶ ዎ የተርንግንዳ ገክንንደትም Ꮊፍካንታ ክደረ ዎታ ኣጥምስባብከስ አንድር ዳቅንተን Ꮊፍቶቴ። <verse eid="HEB 6:18"/><verse number="19" style="v" sid="HEB 6:19"/>ናኮና ጉርምና ዎንታ ሰንፔንካንታ ሶግዳክን ሪግንዳ አሜንዝድን ኤሄንታ ቱስንግንዴ። የሱሳር ዎንታ ዶቅድን ጉርምና ስፍሰርሳንደትም ስግሶ ጭልምሳንደታር አርዴ። <verse eid="HEB 6:19"/><verse number="20" style="v" sid="HEB 6:20"/>ኮትኮ ጭልምሳንደታር የሱስይ መልከጸደቅግንዳ ቄሳ ማስዝድን ዶርምን ስለንክንደታ ቄሰንከስታ ገችንባብ ማትሶ ዎካንታ እሪምሶ ኖ አርደዴ።<verse eid="HEB 6:20"/></para>
  <chapter eid="HEB 6"/>
  <chapter number="7" style="c" sid="HEB 7"/>
  <para style="s1">ቄሳ ማልከጻድቅ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1"/>መልከጸድቅ ሳሌም ካተመንታ ባንችኬ ሙደንዘንካ ስግ ሳብንታ ቄሳ Ꮊቄ፥ ኖኮና መልከጸድቅ አብራሀም ባንችምንከስም ጋምሶ ክት ማድንካ ጎግዘን ክትካ Ꮊፈርሶ ክትም አንጄ። <verse eid="HEB 7:1"/><verse number="2" style="v" sid="HEB 7:2"/>አብራሀመረ ይ የጃን ሪን ሙደናርንካ ታመናርንካ ዋልቀን ዉችሶ ክትካንታ እምሴ፥ መልከጸድቅታ ላምንታ ቡልና ዋልቀና “ጭለትቼታ ባንች” ቃስትምስና “ሳሌም ካተመንታ ባንች” ጋይንትና “ሳራትቼታ ባንች” ጋይንትዬ። <verse eid="HEB 7:2"/><verse number="3" style="v" sid="HEB 7:3"/>መልከጸድቅታ ባቤንኬ እንደንካ አነረ ክታ አጥርንታ ጻንታ ካዬ፥ ክታ ስለንታ የድንተኬ፥ ክታ ዶቅንተንታ በእንታ ካዬ፥ ኖኮና መልከጸድቅ ሳብታ ይንችንታ ካምስ ማትንተካ ስለንክንደታ ቄሳ ማትሶ ኖ ዶቅተሬ።<verse eid="HEB 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4"/>ኮና ኤችና Ꮊስግንዳ አንድር ክት ማቻናንከረ ሰድከቴ፥ እስራኤል አጥርንከስታ ባቤና ማችባብ አብራሀም ዎራ ዳምንም ዳምድዮ ይ ዎእስት ተያንደታርንካ ታመናርንካ ዋልቀን ዉችትዮ እምሴ። <verse eid="HEB 7:4"/><verse number="5" style="v" sid="HEB 7:5"/>ከታኬና ቄሰንታ ፍክስዘን ማድባብከስ ለዊታ ሱሰንከስ አብራሀመታ ሱሳ ማችባብ ዎርሰንዘንካ ጋይንትነረ እስመንከዘንካ ታመናርንካ ዋልቀን ከት ተይድንግንዳ ሙሴታ ህግና ከትም ክቴ፥<note caller="-" style="x"><char style="xo" closed="false">7፡5 </char><char style="xt" closed="false"><ref loc="DEU 18:21">ካሪ. 18፡21</ref>። </char></note> <verse eid="HEB 7:5"/><verse number="6" style="v" sid="HEB 7:6"/>ኖኮና መልከጸድቅ ለዊንከስታ ሱሳ ይ ማታክናነረ ዎራ አብራሀምዘንካ ታመናርንካ ዋልቀንም ኖ ተዬ፥ ጉርም ቃላ እምምስባብ አብራሀመመረ አንጄ። <verse eid="HEB 7:6"/><verse number="7" style="v" sid="HEB 7:7"/>ካንስና ይንታ ባይረንዘንካ አንጃን ተይድንደትም Ꮊእር ካዬ። <verse eid="HEB 7:7"/><verse number="8" style="v" sid="HEB 7:8"/>ዋልቃጎካ ታመናርንካ ዋልቀን ተይድባብከስ ሌዊና ደእካንታ ማድባብከሰኬ፥ አብጎካ ማቼ ታመናርንካ ዋልቀን ተይድባብ ስለንክንደታ ማትሶ ዶቅድንደትም ክትካንታ ማርከርምስባብ ኖ መልከጸድቅዬ። <verse eid="HEB 7:8"/><verse number="9-10" style="v" sid="HEB 7:9-10"/>ይና መልከጸድቅ አብራሀመም ጎግንዘን ይ Ꮊፈሳንደትካ ለዊ ይንታ ባቤን አብራሀመዘንካ አክ ክት አጥርማክንካንታ ታመናርንካ ዋልቀን ተይ ዝግዝድባብ ለዊ ይንታ ማታርንካ አብረሀምጎካ ታመናርንካ ዋልቀን ናከቴ ጋይንትዬ።<verse eid="HEB 7:9-10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11"/>ይና ዎርሰንካንታ ለውንከስ Ꮊስግንዳ ቄሳ ከት ማዳናንከረ እምምሳን ህግንግንዴ፥ ኮትኮ ለዊንከስታ ቄሳ ማትሶ ፍክስንካ ቦድማ ማትምደስናና አሮንታ ቄሳ ማትሶ ዶርም ማታክናና መልከጻድቅታ ቄሳ ማትንተታ ዶርምስባብ ዶቅድንካ አብ ቄሳ ዶርም ዝግዝዳክዶቆ፥ <verse eid="HEB 7:11"/><verse number="12" style="v" sid="HEB 7:12"/>ቄሳ ማትንተታ ጎግና ኦክምድንካ ሙሴታ ህግነረ የካ ኦክም ዝግዝዴ። <verse eid="HEB 7:12"/><verse number="13" style="v" sid="HEB 7:13"/>ኬና ሙዳ ክትካንታ ኬዝምሳንዳ ቄሰና አብ አጥርያርንኬ፥ ኮ አጥርናርንካ Ꮊየነረ ካሰርድንደደር የልሶ ፍክስባብ ካዬ። <verse eid="HEB 7:13"/><verse number="14" style="v" sid="HEB 7:14"/>ዎንታ ጮይስና ይሁደታ አጥርናርንካ ማትንትና ኤስምሳንዴ፥ ማችንከረ ሙሴ ቄሰንከስጎካ ኬዝድዮ ይሁደታ አጥርንጎካ ክት ኬዛንዳ Ꮊረነረ ካዬ።<verse eid="HEB 7:14"/></para>
  <para style="s1">ክርስቶስ መልከጻድቅግንዳ ቄሳ ማትና</para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15"/>ኮና ሪና አንድር መያማትሶ Ꮊፈርድንዳ መልከጻድቅግንደና አብ ቄሳ ዶርምድንᎺይኬ፥ <verse eid="HEB 7:15"/><verse number="16" style="v" sid="HEB 7:16"/>ክርስቶስ ቄሳ ማትንተካ ክት ዶርምሳንዳ ክታ ዶቅንትንታ በእንታ ካያ ማቻንካንታ ዳት ኤታ ሱሰዘንካ Ꮊዳን ዎገኬ ህግካ ካዬ። <verse eid="HEB 7:16"/><verse number="17" style="v" sid="HEB 7:17"/>“መልከጻድቅግንዳ ይንታ ቄሳ ማትንተታ ዶርምን የና ስለንክንደታ ቄሳዬ” ጋይምሶ ጭል ማጻፍናር ጻፍምሶ ክትካንታ ማርከርምቴ።<note caller="-" style="x"><char style="xo" closed="false">7፡17 </char><char style="xt" closed="false"><ref loc="PSA 110:4">የቺ 110፡4</ref>። </char></note> <verse eid="HEB 7:17"/><verse number="18" style="v" sid="HEB 7:18"/>ኮትኮግንደረ ኤና እሪንዳ ክቴና ጋፍምኬ መይዳክንዳ ማቻንካንታ ነግቴ። <verse eid="HEB 7:18"/><verse number="19" style="v" sid="HEB 7:19"/>ሙሴታ ህግንካ Ꮊራርየረ ቦድማ ማትካንታ ማታክዬ፥ ታ ማቼ ሳብደር ዎ የልድንደታ እንድንካ ኡርድንዳ ጉርም ዎካንታ እምምቴ።<verse eid="HEB 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20"/>ክርስቶስታ ቄሳ ማትና ሳብታ ጫቀንካይሳ ማታክዬ፥ ከታኬና ኤና እሪ ቄሳ ከት ማቻንዳ ጫቃ ካይሴ፥ <verse eid="HEB 7:20"/><verse number="21" style="v" sid="HEB 7:21"/>የሱስይ ማቼ ቄሳ ክት ማቻንዳ ሳብታ ጫቀኬ፥ ኮነረ፥</para>
  <para style="q1" vid="HEB 7:21">“ሳብ ‘የና ስለንክንደታ ቄሳዬ’ ጋይሶ ጫቅቴ፥</para>
  <para style="q2" vid="HEB 7:21">ክትካንታ ጋይምሳንደትም ኦካዬ” ጋይምሶ ጭል ማጻፍናር ጻፍምሶ ከዝምሳንግንዴ።<note caller="-" style="x"><char style="xo" closed="false">7፡21 </char><char style="xt" closed="false"><ref loc="PSA 110:4">የቺ 110፡4</ref>። </char></note><verse eid="HEB 7:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="HEB 7:22"/>ኮ ጫቀንጎካ የሱስይ አንድር ስግዳን ጫቃ ቃለንታ ካርያር አመንስዝድባብ ማቴ።<verse eid="HEB 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23"/>ቄሰንከስ ደእድንካንታ ዋልቃ ቄሳ ፍክስዘን ስለንካ ዶቅካንታ ማዳክንካንታ ኤና እሪ ቄሰንከስ በድካ ፋይድምድባብከስ Ꮊቀኬ፥ <verse eid="HEB 7:23"/><verse number="24" style="v" sid="HEB 7:24"/>የሱስይ ማቼ ስለንክንደታ ዶቅድባብ ክታ ማትንተንካ ቄሳ ማትና ኦክምዳክንዴ። <verse eid="HEB 7:24"/><verse number="25" style="v" sid="HEB 7:25"/>ኮካንታ ይንታ ጋይምስባብከስም ጋልትምካንታ ስለንክንደታ ዶቅድባብ ክት ማቻንካንታ ክትጎካ ፈንክ ሳብደር Ꮊድባብ ሙደን ቦድሶ ከትም አቅስካንታ ማዴ። <verse eid="HEB 7:25"/><verse number="26" style="v" sid="HEB 7:26"/>ኮግንዳ ሳብካንታ ፋስምሳንዳ፥ ይንኤርዝድ ሪ ካየንባብ፥ ጭል ይልቻይልቺ፥ ጎመንባብከዘንካ ፋስምስባብ፥ ጭለዘንካ ስግ ጬክን ጋይስባብ ቄሰንከስታ ገችንባብ ዎካንታ ዝግዝዴ። <verse eid="HEB 7:26"/><verse number="27" style="v" sid="HEB 7:27"/>ኖ የሱሰረ አብ ቄሰንከስም ገችዝድባብከስግንዳ እሪምሶ ይንታ ማታ ጎመንታ፥ ኮታ ቡረረ ዎርሰንታ ጎመንጎካ ሙዳ ሰጫᎺይካ ካሲ እም ዝግሳዬ፥ ይንታ ማተንም ካሲ ማስሶ ክት እምሳንደትᎺይካ ኮም ሪን አናካርንካ ይይምዳክንጎግካ ኖ ቦቴ።<note caller="-" style="x"><char style="xo" closed="false">7፡27 </char><char style="xt" closed="false"><ref loc="DEU 9:7">ካሪ. 9፡7</ref>። </char></note> <verse eid="HEB 7:27"/><verse number="28" style="v" sid="HEB 7:28"/>ሙሴታ ህግና ቄሰንከስታ ገችንባብ ማስሶ ከትም ዶርድንዳ ቦድማ ማትካንታ ማታክን ኤድንከስም፥ ሙሴታ ህግንታ ቡሪ Ꮊድባብ ጫቃ ቃለና ማቼ ስለንክንደታ ቦድማ ማችባብ ሳብታ ይንችን ዶርቴ።<verse eid="HEB 7:28"/></para>
  <chapter eid="HEB 7"/>
  <chapter number="8" style="c" sid="HEB 8"/>
  <para style="s1">የሱስይ ጫቃ ቃለንታ ቄሰንከስታ ገችንባብ ማትና</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1"/>ይና ኮዘንካ ዎ ኬዝምድን ርንከስታ አፍ ማድን ሪና ኮኔ፥ ጭላር ሙደንዘንካ ስግ ሳብንታ ዶቅንት ጎንገንታ ምዝዘን ዶቅስባብ ኮግንደና ቄሰንከስታ ገችንባብ ዎንታ ዶቅዴ፥ <verse eid="HEB 8:1"/><verse number="2" style="v" sid="HEB 8:2"/>ክት ፍግዝድንደና ዶፈን ማቻንዳ ዱንካንና ጭል ኤሄ፥ ኮና ዱንካንና ዎይስምሳንዳ ኤታ አንካ ማታክናና ጮይስኬ። <verse eid="HEB 8:2"/><verse number="3" style="v" sid="HEB 8:3"/>ዋልቃ ዋልቀና ቄሰንከስታ ገችንባብከስ ዶርምድንዳ እመንምኬ ካሲንም እምካንቴ፥ ኮካንታ ኮነረ ቄሰና እምድንዳ ዋልቃ ሪ ክትካንታ ዶቅ ዝግዝዴ። <verse eid="HEB 8:3"/><verse number="4" style="v" sid="HEB 8:4"/>ሙሴታ ህግንግንዳ እመንም ግግዝድባብ ቄሰንከስ ዶቅድንካንታ ክት ፍጨዘን ማደስናና ኖ ቄሳ ማዳክዶቆ፥ <verse eid="HEB 8:4"/><verse number="5" style="v" sid="HEB 8:5"/>ከታኬና ቄሰንከስ ፍግዝድን ዱንካንና ጭለዘን Ꮊፈርድንደታ ካምስኬ ሽፍግንዴ፥ ኮነረ ማቻንዳ ሙሳ ዱንካንን ኡርዝድንደትᎺይካ፥ ሳብ “ገቼንዘን የስካንታ መያ ማቻንግንዳ ሙዳ ሪን ካርስምሰዮ ቦድካ” ጋይሶ ክትም ክትሳንግንዴ።<note caller="-" style="x"><char style="xo" closed="false">8፡5 </char><char style="xt" closed="false"><ref loc="EXO 25:40">ዉት. 25፡40</ref>። </char></note> <verse eid="HEB 8:5"/><verse number="6" style="v" sid="HEB 8:6"/>ታ ማቼ የሱስይ ኤተከ ሳብተካ ግድያርንባብ፥ ኤእስካንታ ማድን ጫቃ፥ ኤና እሪ ጫቀንዘንካ ስገዳንደትኬ አንድር Ꮊድን ጉርም ማቻንደትግንዳ ክትካንታ እምምሳንዳ ፍክስና ስገዳንዴ።<verse eid="HEB 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7"/>ኤና እሪንዳ ጫቀና ይንኤርዝድ ርካየንዳ ማትሶ Ꮊፈርሰስናና ቃስትምስ ጫቀና ዝግዝዳክዶቆ። <verse eid="HEB 8:7"/><verse number="8" style="v" sid="HEB 8:8"/>ሳብ ይንታ ዎርሰንዘን ይንኤርዝድ ሪ ዶቅንተን ሰችካ ኩን ጋይዴ፥</para>
  <para style="q1" vid="HEB 8:8">“ኮሰቼቴ፥ እስራኤል ዎርሰንኬ ይሁዳ ዎርሰንካ ክክን</para>
  <para style="q2" vid="HEB 8:8">ክላ ጫቃ እ አርድንዳ ሰጫ Ꮊዴ” ጋይዴ ጮይስ።<verse eid="HEB 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 8:9"/>ኮነረ ጫቃ ቃለና ከታ አንንም የድስቶ ግብጽ ፍጨናርንካ ከትም እ ዉችሳንደትᎺይካ ከታ ባቤንከስካ ክክን እ አርደዳን ጫቀንግንዳ ካዬ፥ ከታ እስታ ጫቀንካ ዎአክንካንታ እተረ ከትም በህን ጋይሳቴ ጋይዴ ጮይስ።<verse eid="HEB 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10"/>“ኮሰቼቴ፥ ኮታ ቡሪ እስራኤል ዎርሰንከስካ ክክን</para>
  <para style="q2" vid="HEB 8:10">እ አርድን ጫቃ ቃለና ኮኔ ኩን ጋይዴ ጮይስ፥</para>
  <para style="q1" vid="HEB 8:10">እታ እስታ ህግንም ኬታ ማክቼናር ዎድቴ፥</para>
  <para style="q2" vid="HEB 8:10">ኬታ ቡደንዘነረ ጻብድቴ፥</para>
  <para style="q2" vid="HEB 8:10">እተረ ከታ ሳብ ማትቴ፥</para>
  <para style="q2" vid="HEB 8:10">ኬተረ እስታ ዎርሳ ማደኬ።<verse eid="HEB 8:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11"/>‘ጮይስም ኤስካ’ ጋይሶ ይንታ የለንመረ ማታ</para>
  <para style="q2" vid="HEB 8:11">ይንታ እስመንም ኤስዝድባብ Ꮊየነረ ዶቅተራክዬ፥</para>
  <para style="q1" vid="HEB 8:11">መረንዘንካ የድሶ ባካ ኤድ የለልታ ሙደና</para>
  <para style="q2" vid="HEB 8:11">እም ኤስተረኬ፥<verse eid="HEB 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12"/>ኬታ ባችንመረ ነጋ ጋይድቴ፥</para>
  <para style="q2" vid="HEB 8:12">ኬታ ጎመንመረ ይና ኮዘንካ ከታዘን ገቀርዳክቴ”። <note caller="-" style="x"><char style="xo" closed="false">8፡12 </char><char style="xt" closed="false"><ref loc="JER 31:31-34">ኤር. 31፡31-34</ref>። </char></note><verse eid="HEB 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13"/>ይና “ክላ ጫቃ ቃለና” ጋይድንካ ኤና እሪንዳ ጫቃ ቃለና ፍክስዘን Ꮊቃይ ጋይንትዬ፥ ኮካንታ ፍክስምሳንደትኬ ገሳ ሪና ሙዳ ካይድንደታ ሰጨና የልቴ።<verse eid="HEB 8:13"/></para>
  <chapter eid="HEB 8"/>
  <chapter number="9" style="c" sid="HEB 9"/>
  <para style="s1">ፍጨዘን ዱንካንናር ጎይንና</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1"/>እሪንዳ ጫቃ ቃለና ጎይነርድንደታ ዎገኬ ፍጨዘንዳ ሳብታ ጭል ኤሀ Ꮊቄ። <verse eid="HEB 9:1"/><verse number="2" style="v" sid="HEB 9:2"/>ኮታ ዋርንዳ ቃስቴን ካርዘን ፋስምሳንዳ ዱንካን ግግምሶ Ꮊቄ። እሪ ካርናር ዞጰን ዎደርድንደትኬ ጣርጰዘንካ፥ ሳብካንታ እመርድን ባይስና ዶቅድን ካርና “ሳብካንታ ፋስምሳንዴ” ጋይምድ Ꮊቄ።<note caller="-" style="x"><char style="xo" closed="false">9፡2 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">ዉት. 26፡31-33</ref>። </char></note> <verse eid="HEB 9:2"/><verse number="3" style="v" sid="HEB 9:3"/>ቃስትምስን ስፍሰርሳንደታ ቡርጎካ ዶቅድንዳ ዋርጎካ ካርና “ጭል ሳብካንታ ፋስምሳንዴ” ጋይምድ Ꮊቄ።<note caller="-" style="x"><char style="xo" closed="false">9፡3 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">ዉት. 26፡31-33</ref>። </char></note> <verse eid="HEB 9:3"/><verse number="4" style="v" sid="HEB 9:4"/>ኮትኮካርንታ ዋሪ ዎርቀካ ፍክሰርሳንዳ እጣን ጩፍሰርድንደትኬ ዎርቀካ የቼርሳንዳ ጫቃ ቃለንታ ሳጥንና ኮታር Ꮊቄ፥ ኮትኮ ጫቃ ቃለንታ ሳጥንንታ ዋረረ ማና እችምና ኮታር ዶቅድንዳ ዎርቀካ ፍክሰርሳንዳ ቡንዳይ፥ ጮልሶ Ꮊቃንዳ አሮንታ ጉፈና፥ ታማ ክቴንከስ ጻፍምሳንዳ ላጳላጳ ሰይንና Ꮊቀኬ።<note caller="-" style="x"><char style="xo" closed="false">9፡4 </char><char style="xt" closed="false"><ref loc="EXO 30:1-6">ዉት. 30፡1-6</ref>፤ <ref loc="EXO 25:10-16">25፡10-16</ref>፤ <ref loc="EXO 16:33">16፡33</ref>፤ <ref loc="NUM 17:8-10">ፋይ. 17፡8-10</ref>፤ <ref loc="DEU 10:5">ካሪ. 10፡5</ref>። </char></note> <verse eid="HEB 9:4"/><verse number="5" style="v" sid="HEB 9:5"/>ጫቃ ቃለንታ ሳጥንንዘነረ ዶቅድን ጎመንም ነግስዝድንደታ ጉፍነን ስፍስድባብከስ ቦንችምስባብ ኩርበል ጋይምድባብ ከፍ ዶቅድባብከስ ፍዝር Ꮊቀኬ፥ ኬዛር ማቼ ከታከና ሪንከስጎካ ሙዳ ታ ዋልቃ ዋልቀንም ኬዛካንታ ማታዮቴ።<note caller="-" style="x"><char style="xo" closed="false">9፡5 </char><char style="xt" closed="false"><ref loc="EXO 25:18-22">ዉት. 25፡18-22</ref>። </char></note><verse eid="HEB 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6"/>ሙዳ ርና ኮግንደካ ግግምሳን ቡር ቄሰንከስና ይንታ ፍክስንም ቦድካንታ ዱንካንንታ ዋር ዶቅድን እርጎካ ካርናር ሙዳᎺይካ አርደኬ።<note caller="-" style="x"><char style="xo" closed="false">9፡6 </char><char style="xt" closed="false"><ref loc="NUM 18:2-6">ፋይ. 18፡2-6</ref>። </char></note> <verse eid="HEB 9:6"/><verse number="7" style="v" sid="HEB 9:7"/>ቃስትምስ ካርንታ ዋር አርድባብ ማቼ ቄሰንከስም ገችዝድባብ Ꮊክዬ፥ ክት አርድንደረ ስለታዋር ዋልቃዱት Ꮊክዬ፥ ኖየረ ይንታ ማታ ጎመንተኬ ዎርሰና ኤሳከክዶቆ ፍክሳን ጎመንታ ይ ካዝድን ማቀስን የዳክዶቆ አርዳክዬ።<note caller="-" style="x"><char style="xo" closed="false">9፡7 </char><char style="xt" closed="false"><ref loc="LEV 16:2-34">ሌዊ. 16፡2-34</ref>። </char></note> <verse eid="HEB 9:7"/><verse number="8" style="v" sid="HEB 9:8"/>እርንደና ዱንካን ዶቅድን የለልታ ጭል ሳብካንታ ፋስምሳንደደር የልስዝድን ጎግና አክ መያ ማታክንዳ ማትንተን አያን ጭልና ኮግንደካ ሰጅዴ። <verse eid="HEB 9:8"/><verse number="9" style="v" sid="HEB 9:9"/>ኮነረ ታይንደታ ካምስዬ፥ ኮግንደካ እምምድን ሳብካንታ እመንኬ ካሲንካ እምድባብ ኤችና ባችንባብ ክታ ማትንተን ገቅርስዘንካ ቦድሶ ጭልስካንታ ማታዬ። <verse eid="HEB 9:9"/><verse number="10" style="v" sid="HEB 9:10"/>ኬና ርንከስ ኦክምታ ሰጨና Ꮊተርን የለልታ ዎገንካንታ ጋይምሶ ፍክስምድ Ꮊቄ፥ ከተረ እችምተኬ ዎጭምታ፥ Ꮊክ Ꮊክ አርንንታ ዎገንከሰረ Ꮊክ ፍክስምስባብከሰኬ።<verse eid="HEB 9:10"/></para>
  <para style="s1">ክርስቶሰታ ማቀስና</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11"/>ኬዛር ማቼ ክርስቶስ Ꮊድዘን ዶቅድን ኡርማ ርንከስታ ቄሰንከስም ገችንባብ ማትሶ መያ ማቴ፥ ክት አርደዳን ዱንካንና አንድርኬ ቦድሜ፥ ናኮና ዱንካንነረ ኤታ አንካ ዎድማክንደትኬ ኮ ፍጫሙደንታ ፍዝርንዘንካ ማታክንዴ። <verse eid="HEB 9:11"/><verse number="12" style="v" sid="HEB 9:12"/>ኖ ክርስቶሰረ ጭል ሳብካንታ ፋስምሳንደታር ዋልቃዱት Ꮊክ ይንታ ገታ ማቀስን የድሶ አርደዳ ዳት ደርትንከስተኬ ገዝምንከስታ ማቀስን የድሶ አርዳክዬ፥ ኮግንደከረ ስለንክንደታ ቆትመንም ዎካንታ Ꮊፍሴ። <verse eid="HEB 9:12"/><verse number="13" style="v" sid="HEB 9:13"/>ደርትንከስተኬ ገዝምንከስታ ማቀስንኬ ካሲንካንታ ኣችምሳን ዋከን ማደንታ ብንድን ቱና ማችን ኤድንከስታዘን ይጭድንካ ዋሄና ቱና ማቻንዘንካ አርንስሶ ሳብካንታ ፋዝድንዳ ማቼ፥<note caller="-" style="x"><char style="xo" closed="false">9፡13 </char><char style="xt" closed="false"><ref loc="DEU 16:15-16">ካሪ. 16፡15-16</ref>፤ <ref loc="NUM 19:9">ፋይ. 19፡9</ref>፥<ref loc="NUM 19:17-19">17-19</ref>። </char></note> <verse eid="HEB 9:13"/><verse number="14" style="v" sid="HEB 9:14"/>ስለንክንደታ አያንንጎካ ይንታ ማተን ኦስንዝድንዳ ካየንደት ካሲ ማስሶ ሳብካንታ ክት እምሳንዳ ክርስቶስታ ማቀስና ዶቅንት ሳብንካንታ ዎ ፍግዝድንግንዳ ባችንባብ ዎንታ ማትንታ ገቅርንካ ደእደር ዎም የልዝድን ፍክስናርንካ Ꮊስግንዳ ስግስሶ ጭልዝድንዳ ማተራዳቶ!<verse eid="HEB 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15"/>ኬታኬና ኤልምስባብከስ ሳብ ጉርምካ እምሳን ስለንክንደታ ባእንም ከት ተይድንግንዳ ክርስቶስ ክላ ጫቃ ሙደንካንታ ማትሶ ኤእዝድባብ ማቼ፥ ኮነረ ማቻንዳ ኤድንከስም እሪንደታ ጫቀንታ ጎያር ማትሰኮ ከት ፍክሳን ጎመንዘንካ አቅስካንታ ክት ደእሳንኦሌ።<verse eid="HEB 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16"/>ኬካ ዶቅሴ ኤችን ኬግድባብታ ደእና መያ ማት ዝግዝዴ፥ <verse eid="HEB 9:16"/><verse number="17" style="v" sid="HEB 9:17"/>ኬከና ኬካ ማድንዳ ኬክስባብ ደእሳንደታ ቡርዬ፥ ኬግድባብና ሰንፔካ ዶቅድንካ ማቼ ኬከና መያዬ። <verse eid="HEB 9:17"/><verse number="18" style="v" sid="HEB 9:18"/>ኮግንደካ እሪንዳ ጫቃ ቃለና ዎራ ማቀስ ካይሳ ዳቃክዬ። <verse eid="HEB 9:18"/><verse number="19" style="v" sid="HEB 9:19"/>እሪምሶ ሙሴ ህግንታ ክተንከስም ሙዳ ዎርሰንከስካንታ ኬዜ፥ ኮታ ቡሪ ገዝምንከስተኬ ደርትንከስታ ማቀስን ሎቀካ ክክን ቡቅሶ ህግንታ ማጻፍንኬ ዎርሰን ሙዳ ቡልከኬ ቆልታ ስጭካ ፍክስምሳን ዘይም ክርካ ይጭሴ። <verse eid="HEB 9:19"/><verse number="20" style="v" sid="HEB 9:20"/>ክት ይጭሳንደረ “ሳብ የም ክትሳንዳ ጫቃ ቃለንታ ማቀስና ኮኔ” ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">9፡20 </char><char style="xt" closed="false"><ref loc="EXO 24:6-8">ዉት. 24፡6-8</ref>። </char></note> <verse eid="HEB 9:20"/><verse number="21" style="v" sid="HEB 9:21"/>ኮትኮግንደረ ዱንካንንዘንኬ ፍክስታ ማድን ሪ ሙደንዘን ማቀስን ይጭሴ።<note caller="-" style="x"><char style="xo" closed="false">9፡21 </char><char style="xt" closed="false"><ref loc="LEV 8:15">ሌዊ. 8፡15</ref>። </char></note> <verse eid="HEB 9:21"/><verse number="22" style="v" sid="HEB 9:22"/>ገተረ ሙሴታ ህግንግንዳ ቶክም ሪዘንካ አብ ሙዳ ርና ማቀስካ ጭልምዴ፥ ማቀስ ዉልእማክናና ጎመንም ነግዝድ ሪ Ꮊፈራዬ።<note caller="-" style="x"><char style="xo" closed="false">9፡22 </char><char style="xt" closed="false"><ref loc="LEV 17:11">ሌዊ. 17፡11</ref>። </char></note><verse eid="HEB 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23"/>ይና ኬና ጭላር ርንከስታ ካምስ ማችባብከስ ሙደና ኮግንዳ ዎገንካ አርን ከትም ዝግዝዳዶቆ፥ ጭላርንካ ማችባብ ርንከስ ማቼ ኮዘንካ ስገድን ካሲንካ አርን ከትም ዝግዝዴ። <verse eid="HEB 9:23"/><verse number="24" style="v" sid="HEB 9:24"/>ክርስቶስ ኮት ዶፈን ሳብታ ጭል ኤሄንታ ካምስ ማቻንደደርኬ ኤታ አንካ ዎድምሳን ጭል ሳብካንታ ፋስምሳንደታር አርዳክዬ፥ ኖ ታ ዎካንታ ሳብታ እሪ Ꮊፍርካንታ ጭላር አርደዴ። <verse eid="HEB 9:24"/><verse number="25" style="v" sid="HEB 9:25"/>አይሁድንታ ቄሰንከስታ ገችንባብ ይንታ ማታክንደትም ማቀስ የድሶ ስለናር ስለናር ጭል ሳብካንታ ፋስምሳንደታር አርድ Ꮊቄ፥ ክርስቶስ ማቼ ይንታ ማተን በድᎺይካ ካሲ ማስሶ እምካንታ አርዳክዬ። <verse eid="HEB 9:25"/><verse number="26" style="v" sid="HEB 9:26"/>ኩን ማደስናና ፍጫ ሙደና ፍዝምሳንደትዘንካ የድሶ በድᎺይካ ማጣ ተይን ክትም ዝግዝዳዶቆ፥ ታ ማቼ ስለንከስታ በእንተዘን ጎመንም ዎይስካንታ ይንታ ማተንም ካሲ ማስካ ዋልቃዱት መያ ማቼ። <verse eid="HEB 9:26"/><verse number="27" style="v" sid="HEB 9:27"/>ኤድካንታ ዋልቃዱት ደእ ክትካንታ ጋይምቴ፥ ደእንታ ቡረረ ፍርዳ ክታዘን ዶቅዴ። <verse eid="HEB 9:27"/><verse number="28" style="v" sid="HEB 9:28"/>ኮትኮግንደረ ክርስቶስ በድንከስታ ጎመንም Ꮊልእስካንታ ዋልቃዱት ካሲ ማቴ፥ ጉጅሰረ ጎመንም ባላካንታ ማታክዶቆ ክትም ካርዝድባብከስም አቅስካንታ ቃስትምስ ዱት መያ ማዴ።<note caller="-" style="x"><char style="xo" closed="false">9፡28 </char><char style="xt" closed="false"><ref loc="ISA 53:12">ኢሳ. 53፡12</ref>። </char></note><verse eid="HEB 9:28"/></para>
  <chapter eid="HEB 9"/>
  <chapter number="10" style="c" sid="HEB 10"/>
  <para style="s1">ካርንካ ይይምዳክን ክርስቶስታ ካሲ ማትና</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1"/>ሙሴታ ህግና Ꮊድን ኡርማ ሪንታ ካምስ ማትሶ ስፍ ዳት ዶፈንና ካዬ፥ ኮካንታ ስለናር ስለናር ሙዳᎺይካ ከታ ይካዝድን ካሲንም የድሰኮ ሳብደር Ꮊድን ኤድንከስም ቦድማ ማስካንታ ማታዬ። <verse eid="HEB 10:1"/><verse number="2" style="v" sid="HEB 10:2"/>ሙሴታ ህግና ቦድማ ከትም ማስካንታ ማደስ ናና ጎይን ካንታ Ꮊድን ኤድንከስ አናካርንካ ይምዳክን ጎግካ ጎመናርንካ ከት ጭልምሳንካንተኬ ጎማ ከታዘን ካየንደትመረ ከታ ባችንባብ ማትንተንታ ገቅርና ከትካንታ ኤስምድንካንታ ካሲ እምንም ዛቅደክዶቆ። <verse eid="HEB 10:2"/><verse number="3" style="v" sid="HEB 10:3"/>ኬታኬና ካሲንከስ ማቼ ስለናር ስለናር ጎመንም ከትካንታ ገቀርስዝድንዴ። <verse eid="HEB 10:3"/><verse number="4" style="v" sid="HEB 10:4"/>Ꮊራካንታ ጋይሴ ገዝምንከስተኬ ደርትንከስታ ማቀስና ጎመንም Ꮊልእስካንታ ማታዬ።<verse eid="HEB 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HEB 10:5"/>ኮካንታ ክርስቶስ ፍጫሙደንዘን ይ Ꮊዳንደትካ ኩን ጋይሴ፥</para>
  <para style="q1" vid="HEB 10:5">“ካሲንምኬ እመንም ዝጋካዬ፥</para>
  <para style="q2" vid="HEB 10:5">ኤደትቼንም ማቼ እካንታ ግግሳዬ”፥<verse eid="HEB 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6"/>ኣችምድን ካሲንኬ</para>
  <para style="q1" vid="HEB 10:6">ጎመንም ነክስካንታ ካሲምድን ካሲንካ</para>
  <para style="q1" vid="HEB 10:6">ጉርማካዬ፥<verse eid="HEB 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7"/>ኮታይካ እታ፥</para>
  <para style="q1" vid="HEB 10:7">“እስታ ሳብኖ፥ ማጻፍናር እጎካ ጻፍምሳንግንዳ</para>
  <para style="q2" vid="HEB 10:7">የስታ ጋይተንም ቦድካንታ Ꮊትቴ” ጋይሳቴ።<note caller="-" style="x"><char style="xo" closed="false">10፡7 </char><char style="xt" closed="false"><ref loc="PSA 40:6-8">የቺ 40፡6-8</ref>። </char></note><verse eid="HEB 10:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 10:8"/>ና ኮነረ እሪምሶ ከታኬና ሙሴታ ህግንግንዳ ክተርሳንዳ ማችንከረ ዎራ “ካሲንምኬ ሳብካንታ እመንም፥ ኣችምድን ካሲንምኬ ጎመንም ነግስታ ካሰርድን ካሲንም ዝጋካዬ፥ ከትከረ ጉርማካዬ” ጋይሴ። <verse eid="HEB 10:8"/><verse number="9" style="v" sid="HEB 10:9"/>ኮታዘንከረ “ይና እታ የስታ ጋይተን ቦድካንታ Ꮊትቴ” ጋይሴ፥ ኮግንዳ ጎግካ ቃስትምስን ካምድን ካሲን ካርንዘን ዎድካንታ እሪንደት ካሲንም ነግክስቴ። <verse eid="HEB 10:9"/><verse number="10" style="v" sid="HEB 10:10"/>ኮትኮከረ “ጋይታ” ጋይድን ቃለን ግንዳ የሱስ ክርስቶስ ዋሄካ አናካርንካ ይምዳክንደትም ዋልቃዱት ካሲ ክታ ማትንተንጎካ ዎታ ሳብካንታ ፋስምቶቴ።<verse eid="HEB 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11"/>ዋልቃ ዋልቃ ቄሰና ጎመንም Ꮊልእስካንታ ማዳክን ከትኬና ካሲንከስም ሙዳᎺይካ ግግሰረኮ ሙዳ ሰጫᎺይካ ዎእሰኮ ፍግዝደኬ።<note caller="-" style="x"><char style="xo" closed="false">10፡11 </char><char style="xt" closed="false"><ref loc="EXO 29:38">ዉት. 29፡38</ref>። </char></note> <verse eid="HEB 10:11"/><verse number="12" style="v" sid="HEB 10:12"/>ክርስቶስ ማቼ ሙዳᎺይክንደታ ማድንደትም ዋልቃ ካሲንም ይ ግግሳንደታ ቡር ሳብ ባቤንታ ምዝዘን ዶቅቴ። <verse eid="HEB 10:12"/><verse number="13" style="v" sid="HEB 10:13"/>ይና ኮዘንካ ኦስ ክታ ይምኤንባብከስ ክታ ገችንታ ኤረንታ ጎያር ከት ማተርን የለልታ ኖ ካርዝዴ<note caller="-" style="x"><char style="xo" closed="false">10፡13 </char><char style="xt" closed="false"><ref loc="PSA 110:1">የቺ 110፡1</ref>። </char></note> <verse eid="HEB 10:13"/><verse number="14" style="v" sid="HEB 10:14"/>ኮነረ ማቻንዳ ከትከነም ሳብካንታ ፋስምስባብም ዋልቃዱት ካሲንጎካ ስለንክንደታ ቦድማ ከትም ማስሳንካንቴ።<verse eid="HEB 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15"/>አያን ጭልነረ ጉጅሶ ኮ ሪንጎካ ዎካንታ ማርከርዴ፥ እሪምሶ፥<verse eid="HEB 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16"/>“ከትኬና ሰጨንከስታ ቡር</para>
  <para style="q1" vid="HEB 10:16">ከትካ ክክን እ አርድን ጫቃ ቃለና ኮኔ ጋይዴ ጮይስ፥</para>
  <para style="q1" vid="HEB 10:16">እስታ ህግንመረ ኬታ ቡደናር ዎድቴ፥</para>
  <para style="q1" vid="HEB 10:16">ኬታ ማክቼናረረ ጻብድቴ”። <note caller="-" style="x"><char style="xo" closed="false">10፡16 </char><char style="xt" closed="false"><ref loc="JER 31:33">ኤር. 31፡33</ref>። </char></note><verse eid="HEB 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HEB 10:17"/>ኮታዘንከረ “ኬታ ጎመንምኬ ኬታ ዳቅል ፍክስን</para>
  <para style="q2" vid="HEB 10:17">ይና ኮዘንካ ኦስ ኬታዘን ገቀርዳክቴ” ጋይዴ።<note caller="-" style="x"><char style="xo" closed="false">10፡17 </char><char style="xt" closed="false"><ref loc="JER 31:34">ኤር. 31፡34</ref>። </char></note><verse eid="HEB 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 10:18"/>ኮካንታ ጎማ ሙደና ነጋ ጋይምሳንደታ ቡር ጎመንም ነግስካንታ እምምድንዳ ካሲ ይና ኮዘንካ ኦስ ዶቃዬ።<verse eid="HEB 10:18"/></para>
  <para style="s1">ሳብደር ቅንችም ዝግዝድንዳ ማትንተና</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19"/>ይና እስታ እስመንከስኬ ምችነንከሶ! የሱሰታ ማቀስንጎካ ጭል ሳብካንታ ፋስምሳንደታር አርድካንታ ዎም ማስዝድን አመንዝድንደትም Ꮊፍቶቴ። <verse eid="HEB 10:19"/><verse number="20" style="v" sid="HEB 10:20"/>ዎ አርድንደረ ስፍስንታ፥ ጋይንተነረ ክታ ዋሄንጎካ ዎካንታ ፎቻን ክለንኬ ስለንካ ዶቅድን ጎግንኬ። <verse eid="HEB 10:20"/><verse number="21" style="v" sid="HEB 10:21"/>ጭላር ሳብታ ኤሄንዘን ገችታ ኤራ ዶቅድባብ አንድር ቄሳ ዎካንታ ዶቅዴ። <verse eid="HEB 10:21"/><verse number="22" style="v" sid="HEB 10:22"/>ኮካንታ ዳቅል ባችንባብ ማትንታ ገቅርንዘንካ ዎ ጭልምድንግንዳ ዎንታ ቡደንም ስኤርሶቶ፥ ዎንታ ኤደትቸንመረ ጭል ሎቀንካ ስኤርሶቶ፥ ሉላ ቡደኬ ዶፈን አሜንን የድሶቶ ሳብደር ዎ ቅንችማ።<note caller="-" style="x"><char style="xo" closed="false">10፡22 </char><char style="xt" closed="false"><ref loc="LEV 8:30">ሌዊ. 8፡30</ref>፤ <ref loc="EZK 36:25">ሕዝ. 36፡25</ref>። </char></note> <verse eid="HEB 10:22"/><verse number="23" style="v" sid="HEB 10:23"/>ጉርም ቃለን ዎካንታ እምስባብ አሜንምስባብ ክት ማቻንካንታ ታ አሜንሶቶ ዎ ማርከርድን Ꮊድን ጉርምን ኦስ ፈንክ ጋያኮትዶቆ ዳቅስት ዎ የዳ። <verse eid="HEB 10:23"/><verse number="24" style="v" sid="HEB 10:24"/>ሶልመኬ ኡርማ ፍክስካ ንግሶቶ ዎ ዶቅተርንግንዳ ዋልቃባብ አብንም ዳቅሳ፥ <verse eid="HEB 10:24"/><verse number="25" style="v" sid="HEB 10:25"/>ሙዳᎺይካ ክክ Ꮊፈረሮቶ ክክ ክክ ዎ ዳቅሳ ዳት ዋልቃ ዋልቀንከስ ሳንምድንደትም ዛቅሳንግንዳ ዎተረ ዎንታ ሳንንተን ዎ Ꮊይዛቃ፥ ስግስሰረ ጮይስታ Ꮊድንታ ሰጨና ቅንችምሳን ገቅረረቶ ኮም ርን ስግስሶ ይከቴ።<verse eid="HEB 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26"/>ዶፈንን ዎ ኤሳን ቡሪ ሶልምሶቶ ጎማ ዎፍክሴ ይና ኮዘንካ ኦስ ጎመንጎካ ግግስምድንዳ Ꮊረነረ ካሲ ዶቃዬ። <verse eid="HEB 10:26"/><verse number="27" style="v" sid="HEB 10:27"/>ይና ታ ዎም ካርዝድንዳ ማቼ ኦስ እሪ ይይምድንዳ ጳስዝድን ፍርደኬ ሳብም ግርድባብከስም አድንዳ ጳስዝድን ኖሄ።<note caller="-" style="x"><char style="xo" closed="false">10፡27 </char><char style="xt" closed="false"><ref loc="ISA 26:11">ኢሳ. 26፡11</ref>። </char></note> <verse eid="HEB 10:27"/><verse number="28" style="v" sid="HEB 10:28"/>ሙሴታ ህግንም ቶችስባብ ቃስቴን አነረ ማኬን ኤድንከስ ክታዘን ማርከርሴ አጭር ካይሳ ክት ደእድንግንዳ ፋረድምዴ።<note caller="-" style="x"><char style="xo" closed="false">10፡28 </char><char style="xt" closed="false"><ref loc="DEU 17:6">ካሪ. 17፡6</ref>፤ <ref loc="DEU 19:15">19፡15</ref>። </char></note> <verse eid="HEB 10:28"/><verse number="29" style="v" sid="HEB 10:29"/>ይና፥ ሳብታ ይንችንም ቶችስባብ፥ ሳብካንታ ፋስምሳን ጫቃ ቃለንታ ማቀስን ቶክስባብ፥ ዉች እምንተንታ አያንን የክስባብ፥ Ꮊስግንዳ እንድንካ ስግዳን ዋጭ ክትም ዝግዝድንዶክ የንደር ካምዳ!<note caller="-" style="x"><char style="xo" closed="false">10፡29 </char><char style="xt" closed="false"><ref loc="EXO 24:8">ዉት. 24፡8</ref>። </char></note> <verse eid="HEB 10:29"/><verse number="30" style="v" sid="HEB 10:30"/>“ይምኤንም ማዝድባብ እትቴ፥ እታ ዝግዝድን ይምኤንታ ካርያር ማዝድቴ” ጋይስባብ Ꮊይማቸረ ኤዝዶቴ፥ ኮትኮግንደረ “ሳብ ዎርሰንዘን ፋረዴ” ጋይዴ ጮይስ።<note caller="-" style="x"><char style="xo" closed="false">10፡30 </char><char style="xt" closed="false"><ref loc="DEU 32:35-36">ካሪ. 32፡35-36</ref>። </char></note> <verse eid="HEB 10:30"/><verse number="31" style="v" sid="HEB 10:31"/>ኮካንታ ዶቅንት ሳብንታ ዋጭ አንንታ ጎይያር ዋችና አንድር ጳስዝድንዴ።<verse eid="HEB 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32"/>ሳክመና የካንታ ሳክሳንደታ ቡሪ በድ ማጠን ተይደቶ የ ዳንዳእሳንደትም ከትኬና ኤና እሪ ሰጨንከስም ገቀርከቴ። <verse eid="HEB 10:32"/><verse number="33" style="v" sid="HEB 10:33"/>ዋልቃ ዋልቃᎺይካ ኤታ እሪ የከርተቴ፥ ኦስኬ ፈንኬ ጋፍተቴ፥ ዋልቃ ዋልቃᎺይከረ ኮግንዳ ማጠና የልሳን ኤድንከስካ ክክን ላኮይት የንታ ማትንተንካ ማጠንም ተይተቴ። <verse eid="HEB 10:33"/><verse number="34" style="v" sid="HEB 10:34"/>የካንታ ታይንደትዘንካ ኡርድንደትኬ ሙዳᎺይካ ዶቅድን ቆልማ ጭላር የንታ ዶቅድንደትም ኤስሰቶ ዞከርስባብከስካንታ አጨርሰቶ አሌንም አልሰቴ፥ የንታ ብረንመረ የንዘንካ ቡርድንካ ዳንዳእሰቶ ይይምድንደትም ጉርምካ ተየቴ። <verse eid="HEB 10:34"/><verse number="35" style="v" sid="HEB 10:35"/>ይና፥ የካንታ እምምድን አንድር እመን Ꮊፍካንታ የንታ አሜንምን Ꮊይዛቀቴ። <verse eid="HEB 10:35"/><verse number="36" style="v" sid="HEB 10:36"/>ሳብታ ጋይተንም ቦድሰቶ ሳብ የካንታ እማካንታ ኬዛን Ꮊድን ጉርም ቃለን Ꮊፍካንታ ዳንዳእካ ካርስ የም ዝግዝዴ። <verse eid="HEB 10:36"/><verse number="37" style="v" sid="HEB 10:37"/>ኮካንተረ ኩን ጋይምሶ ጭል ማጻፍናር ጻፍምቴ፥</para>
  <para style="q1" vid="HEB 10:37">“ኖ Ꮊድባብና ቶክም ሰጨታ ቡር Ꮊዴ፥</para>
  <para style="q2" vid="HEB 10:37">ኖ ጋምአዬ፥<verse eid="HEB 10:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38"/>እስታ ማችባብ ጭል ኤድ አሜንካ ዶቅንተን Ꮊፍተሬ፥</para>
  <para style="q2" vid="HEB 10:38">ኦስ ቡደካ ክት ዶልእሳን ማቼ እታ ክትካ</para>
  <para style="q2" vid="HEB 10:38">ጉርማይቴ”። <note caller="-" style="x"><char style="xo" closed="false">10፡38 </char><char style="xt" closed="false"><ref loc="HAB 2:3-4">ዕንባ. 2፡3-4</ref>። </char></note><verse eid="HEB 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 10:39"/>ዎታ ማቼ አሜንሰኮ አቅድባብከስታ ኮቾት ዳት ኦስ ቡደካ ዶልእሶ ካይድባብ ኤድንከስታ ኮች ካዮቴ።<verse eid="HEB 10:39"/></para>
  <chapter eid="HEB 10"/>
  <chapter number="11" style="c" sid="HEB 11"/>
  <para style="s1">አመንጎካ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1"/>ኣመን ጋይንትና ጉርምካ ዎ ካርዝድን ርን “ዬ ዶፈንካ ማዴ” ጋይሶ ኣመንሜ፥ አፍካ ሰድምዳክን ሪመረ ሰድምድን ግንዳ ማስሶ ተዬ። <verse eid="HEB 11:1"/><verse number="2" style="v" sid="HEB 11:2"/>ኤና እሪ ኤድንከስካንታ ሳብ ማርከርሳንዳ ኮትኮ ኣሜንንጎኬ።<verse eid="HEB 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3"/>ፍጫ ሙደና ሳብታ ቃለንካ ፍዝምሳንደትም ዎ ኤዝድንዳ ኣሜንኬ። ኮካንታ ሰድምድን ሪሙደና ሰድምዳክንዘንካ ፍክስምሳን ዎታ ኤዝዶቴ።<note caller="-" style="x"><char style="xo" closed="false">11፡3 </char><char style="xt" closed="false"><ref loc="GEN 1:1">ፍዝ. 1፡1</ref>፤ <ref loc="PSA 33:6-9">የቺ 33፡6-9</ref>፤ <ref loc="JHN 1:3">ዮሀ. 1፡3</ref>። </char></note><verse eid="HEB 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4"/>አበል ቃኤልታ ካሲንዘንካ ስግዳን ካሲን ሳብካንታ ክት እምሳንዳ ኣመንኬ፥ ሳብ አበልታ እመንም ጉርምካ ተያንደትካ አበል ይንታ ኣመንካ ጭል ክታ ማትንተና ማርከርምሴ፥ አበል ደእስንከረ ዎራ ክታ ኣመንንጎካ ታየረ ኬዝመሮ ዶቅዴ።<note caller="-" style="x"><char style="xo" closed="false">11፡4 </char><char style="xt" closed="false"><ref loc="GEN 4:3-10">ፍዝ. 4፡3-10</ref>። </char></note><verse eid="HEB 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5"/>ሄኖክዘን ደእ የልዳክንግንዳ ጭላር ክት ተይምሳንዳ ይንታ ኣመንኬ፥ ሳብ ይንደር ክትም ተያንካንታ Ꮊፈራክዬ፥ ሄኖክ ይ ተይምተርንደታ እሪ ሳብም ክት ጉርምሳንዳ ክትካንታ ማርከርምቴ።<note caller="-" style="x"><char style="xo" closed="false">11፡5 </char><char style="xt" closed="false"><ref loc="GEN 5:21-24">ፍዝ. 5፡21-24</ref>። </char></note> <verse eid="HEB 11:5"/><verse number="6" style="v" sid="HEB 11:6"/>ኣመንካይሳ ሳብም ጉርምስካንታ ማታዬ፥ ሳብደር Ꮊድባብ ኤድ ሳብ ዶቅድንደትምኬ ክትም ዝግድን ኤድንከስካንተረ እመንም እምድባብ ክታ ማትንተን ኣመን ዝግዝዴ።<verse eid="HEB 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7"/>አክ አፍካ ሰድማክን ሪንከስካንታ ሳብ ኖህም ኤግዝምሳንᎺይካ ሳብም ጳስካ ይንታ ኤሀ ኤድን አቅስካንታ ማርከብን ክት ኡርሳንዳ ኣመንኬ፥ ኖህታ ኣመንካ ፍጫ ሙደና ባችሳንዳ መያ ማቼ፥ ኖሄረ ኣመንካ Ꮊፈርድን ጭለትቼን ተዬ።<note caller="-" style="x"><char style="xo" closed="false">11፡7 </char><char style="xt" closed="false"><ref loc="GEN 6:13-22">ፍዝ. 6፡13-22</ref>። </char></note><verse eid="HEB 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8"/>አብረሀም ባእ ማስሶ ይ ተይድን ካርዘን ክት አይድንግንዳ ይ ኤልምሳንደትካ Ꮊብር ይ አይዳናንከረ ኤሳክዶቆ አይካንታ ክት ክትምሳንዳ ኣመንኬ።<note caller="-" style="x"><char style="xo" closed="false">11፡8 </char><char style="xt" closed="false"><ref loc="GEN 12:5">ፍዝ. 12፡5</ref>። </char></note> <verse eid="HEB 11:8"/><verse number="9" style="v" sid="HEB 11:9"/>ክትካ ክክን ጉርም ቃለን ተይድባብከስ ይሳቀኬ ያይቆበካ ክክን ጉርም እምምሳን ፍጨናር ሶች ማትሶ ዱንካንናር ክት ዶቅሳንዳ ኣመንኬ። <verse eid="HEB 11:9"/><verse number="10" style="v" sid="HEB 11:10"/>ኮመረ ክት ይሳንዳ ዳቅማ የድይ ዶቅድንደትም፥ ሳብ ገቀርሳንደትምኬ ክት ፍክሳን ካተመን ክት ካርሰሮ Ꮊቃንጎኬ።<verse eid="HEB 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11"/>ሳረረ ጉርምን ኮትም እምስባብ ሳብ ኣመንምስባብ ማትንተን ና ይ ኤሳንካንታ ይንታ ጋልተርንዘንካ አምሳንዳ አጥማካንታ ማዳክንዳ ይማችንከረ ዎራ ስርማ ነግካንታ ዎልቃ ኮት Ꮊፍሳንዳ ኣመንኬ።<note caller="-" style="x"><char style="xo" closed="false">11፡11 </char><char style="xt" closed="false"><ref loc="GEN 18:14">ፍዝ. 18፡14</ref>፤ <ref loc="GEN 21:2">21፡2</ref>። </char></note> <verse eid="HEB 11:11"/><verse number="12" style="v" sid="HEB 11:12"/>ኮካንታ ደእስባብ ኤድግንዳ ፋይድምድባብ አብራሀም ዋልቀንዘንካ ጭለዘን ቤዝንከስግንዳ በጃንደትኬ ባሀርንታ ካንተዘን Ꮊፈርድን ሻምን ግንዳ ፋይድምዳክን ሱሳ Ꮊፈርሴ።<note caller="-" style="x"><char style="xo" closed="false">11፡12 </char><char style="xt" closed="false"><ref loc="GEN 15:5">ፍዝ. 15፡5</ref>፤ <ref loc="GEN 22:17">22፡17</ref>፤ <ref loc="GEN 32:12">32፡12</ref>። </char></note><verse eid="HEB 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13"/>ኬና ሙዳ ኣመንካ ዶቅደኮ ደእሰኬ፥ ሳብ ከትም እምካንታ ኬዛን ጉርም ቃለንም Ꮊፋከኬ፥ ኬዛር ማቼ ጎትካ ሰድሰኮ ገታ ከታ ይ Ꮊፍሳንግንዳ ማስሰኮ ጉርምካ ተየኬ። ፍጨዘን ሶችኬ ባርቅባብ ከታ ይንታማትንተን ገቀርሰኬ።<note caller="-" style="x"><char style="xo" closed="false">11፡13 </char><char style="xt" closed="false"><ref loc="GEN 23:4">ፍዝ. 23፡4</ref>፤ <ref loc="1CH 29:15">1 ኬዛ 29፡15</ref>፤ <ref loc="PSA 39:12">የቺ 39፡12</ref>። </char></note> <verse eid="HEB 11:13"/><verse number="14" style="v" sid="HEB 11:14"/>ኩን ኬዝድን ኤድንከስ ኬታ ይንታ ማድን ፍጨንም ከት ካርዝድንደትም መየካ ሰችዝደኬ። <verse eid="HEB 11:14"/><verse number="15" style="v" sid="HEB 11:15"/>እሪ ይ ዉተዳን ፍጨን ከታ ይ ገቀርተስናና ኦስ ኮታር ማትካንታ ማደክ ዶቆ። <verse eid="HEB 11:15"/><verse number="16" style="v" sid="HEB 11:16"/>ታ ማቼ ስገድንደትም ጭላር ዶቅድን ካርን ሱነርደኬ፥ ኮካንታ ሳብ ካተመንም ከትካንታ ግግሳን ኦል “ኬታ ጮይስና” ጋይምሶ ኤልምካንታ ኦስናዬ።<verse eid="HEB 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17"/>አብራሀም ይ ጰጭምሳንደትᎺይካ ይሳቀም ካሲ ማስሶ ክት ግግሳንዳ ኣመንኬ፥ ኮት ጉርም ቃለን ክት ተያንዳ አብራሀም ዋልቃ ይንታ ይንቺን ካሲካንቴ፥<note caller="-" style="x"><char style="xo" closed="false">11፡17 </char><char style="xt" closed="false"><ref loc="GEN 22:14">ፍዝ. 22፡14</ref>። </char></note> <verse eid="HEB 11:17"/><verse number="18" style="v" sid="HEB 11:18"/>ይና፥ ሳብ፥</para>
  <para style="p" vid="HEB 11:18">“ይሳቀታ ሱሰካ የስም ኤልተረ” ክትም ጋይቴ።<note caller="-" style="x"><char style="xo" closed="false">11፡18 </char><char style="xt" closed="false"><ref loc="GEN 21:12">ፍዝ. 21፡12</ref>። </char></note><verse eid="HEB 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 11:19"/>ሳብ ደእያርንካ አምስስታ ዎልቃ ክታ ዶቅድንደትም አብራሀም ኣመንሳንካንታ ገታ ደእያርንካ አምሳንደትግንዳ ይሳቀም አናካርንካ ክትም Ꮊፍሴ። <verse eid="HEB 11:19"/><verse number="20" style="v" sid="HEB 11:20"/>ይሳቅ ኦስ እሪ ማድን ሪይም ገቅርካ ያይቆብምኬ ኤሳውምንካ ክት አንጃንዳ ኣመንኬ።<note caller="-" style="x"><char style="xo" closed="false">11፡20 </char><char style="xt" closed="false"><ref loc="GEN 27:29">ፍዝ. 27፡29</ref>፥<ref loc="GEN 27:40">40</ref>። </char></note><verse eid="HEB 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21"/>ያይቆብ ደእድንደታ ሰጨና የልድንካ ዮሴፍታ ይንችን ዋልቃ ዋልቀንከስም አንጃንደትኬ ጉፈንዘን ገክንሶ ክት ጎስትሳንዳ ኣመንኬ።<note caller="-" style="x"><char style="xo" closed="false">11፡21 </char><char style="xt" closed="false"><ref loc="GEN 47:31-48:20">ፍዝ. 47፡31—48፡20</ref>። </char></note><verse eid="HEB 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22"/>ዮሴፈረ ክት ደእድንደታ ሰጨና የልድንካ እስራኤልንከስ ግብጽ ፍጨናርንካ ከት ዉድንደትም ክት ኬዛንዳ ክታ ለፍንመረ Ꮊስ ከትም ይይዝግዝዳናንከረ ክታ ክት እምሳንዳ ኣመንኬ።<note caller="-" style="x"><char style="xo" closed="false">11፡22 </char><char style="xt" closed="false"><ref loc="GEN 50:24-25">ፍዝ. 50፡24-25</ref>፤ <ref loc="EXO 13:19">ዉት. 13፡19</ref>። </char></note><verse eid="HEB 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23"/>ሙሴም አጭባብከስ ሙሳ አጥምሳንደትካ ኡርማ ላቅምድባብ ክታ ማትንተን ሰድሰኮ ባንችንታ ክቴን ጳሳከክዶቆ ማኬን አርፍ ከት ክትም አቻንዳ ኣመንኬ።<note caller="-" style="x"><char style="xo" closed="false">11፡23 </char><char style="xt" closed="false"><ref loc="EXO 1:22">ዉት. 1፡22</ref>፤ <ref loc="EXO 2:2">2፡2</ref>። </char></note><verse eid="HEB 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24"/>ሙሴረ ይ ጋጵሳንደታ ቡር “ፈርዖነታ ይንቼንንታ ይንች” ጋይምሶ ኤልምንም ክት ዝጋክንዳ ኣመንኬ።<note caller="-" style="x"><char style="xo" closed="false">11፡24 </char><char style="xt" closed="false"><ref loc="EXO 2:10-12">ዉት. 2፡10-12</ref>። </char></note> <verse eid="HEB 11:24"/><verse number="25" style="v" sid="HEB 11:25"/>ኮካንተረ ሙሴ ጎመዘንካ Ꮊፈርድን ቶክም ሰጨታ ጉርምንዘንካ ስግስሶ ሳብታ ዎርሰንካ ክክን ማጣ ተይንም ዝግዜ። <verse eid="HEB 11:25"/><verse number="26" style="v" sid="HEB 11:26"/>ኦስ እረረ ይ ተይድን ይንታ ፍክስንታ ናክን ይ ሰዳንካንታ ግብጽ ፍጨንታ ቆልመንዘንካ ስግስሶ ክርስቶስጎካ ቶችምና ሙደንዘንካ ስገድንዳ ማትንተን ኖ ገቀርሴ።<verse eid="HEB 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 11:27"/>ባንችንተረ ዋጭንም ጳሳክዶቆ ግብጽ ፍጨናርንካ ሙሳ ዉተዳንዳ ኣመንኬ፥ አፍካ ሰድምዳክን ጮይስንመረ ይ ሰዳንከካ ማስሶ ይንታ ገቅርንካ ዳቅሴ።<note caller="-" style="x"><char style="xo" closed="false">11፡27 </char><char style="xt" closed="false"><ref loc="EXO 2:15">ዉት. 2፡15</ref>። </char></note> <verse eid="HEB 11:27"/><verse number="28" style="v" sid="HEB 11:28"/>ዳነዝ ይንችንከስም ደይሳካንታ ክትምስባብ ክታይንችና እስራኤልንከስታ ዳነዝ ይንችን ደይዝዳክንግንዳ ጋይንተካ ሙሴ ፋስገንተኬ ማቀስን ይጨርድን ዎገን ክት ይሳንዳ ኣመንኬ።<note caller="-" style="x"><char style="xo" closed="false">11፡28 </char><char style="xt" closed="false"><ref loc="EXO 12:30">ዉት. 12፡30</ref>። </char></note><verse eid="HEB 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29"/>እስራኤልንከስ ዎቻ ፍጨንዘን ሙከርድንደትግንዳ ዘይም ባሀርንዘንካ ከት ቃልሳንዳ ኣመንኬ፥ ግብጽ ፍጫ ኤድንከስ ማቼ ኮትኮግንዳ ቃልካንታ ከት ይድንካ ሙደነረ ባሀርናር ኤቅዝምሰኬ።<note caller="-" style="x"><char style="xo" closed="false">11፡29 </char><char style="xt" closed="false"><ref loc="EXO 14:31">ዉት. 14፡31</ref>። </char></note><verse eid="HEB 11:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30"/>እስራኤልንከስ ኢያርኮ ካተማ ሰይን ጋስንታ ካንተካ ታብዛ ሰጫ ከት ስርሳንደታ ቡር ጋስንከስም ከት ዉልእሳንዳ ኣመንኬ።<note caller="-" style="x"><char style="xo" closed="false">11፡30 </char><char style="xt" closed="false"><ref loc="JOS 6:21">ኢያ. 6፡21</ref>። </char></note> <verse eid="HEB 11:30"/><verse number="31" style="v" sid="HEB 11:31"/>ቤልምን ቤልምድንዳ ረአብ ግረንባብከስም ኡርመካ ኮት ሞክሳንዳ ክትምዳክባብከስካ ክክን ደእዘንካ ኮት አቃንዳ ኣመንኬ።<note caller="-" style="x"><char style="xo" closed="false">11፡31 </char><char style="xt" closed="false"><ref loc="JOS 2:21">ኢያ. 2፡21</ref>፤ <ref loc="JOS 6:25">6፡25</ref>። </char></note><verse eid="HEB 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32"/>ይና አብ ኮዘንካ ስግ Ꮊርስ ጋይቴ? ገድኦንጎካ፥ ባራቅጎካ፥ ሶምሶምጎካ፥ ዮፍታሄጎካ፥ ዳዊትጎካ፥ ሳሙኤልጎካ፥ ሳብዘንካ ኤሰርሶ ከዛቅባብከስጎከረ ፍክስምሶ ስገዳን እ ኬዝዳክንግንዳ ሰጨና እካንታ ማታዬ፥<note caller="-" style="x"><char style="xo" closed="false">11፡32 </char><char style="xt" closed="false"><ref loc="JDG 6:11-8:32">ዳኝ. 6፡11—8፡32</ref>፤ <ref loc="JDG 4:6-5:31">4፡6—5፡31</ref>፤ <ref loc="JDG 13:2-16:31">13፡2—16፡31</ref>፤ <ref loc="JDG 11:1-12:7">11፡1—12፡7</ref>፤ <ref loc="1SA 1:1-2:11">1 ሳሙ. 1፡1—1 ባንቺ. 2፡11</ref>። </char></note> <verse eid="HEB 11:32"/><verse number="33" style="v" sid="HEB 11:33"/>ከታ ኣመንካ ባንችንከስም ዳምካ ጋምሰኬ፥ ዎርሰንም ዶፈን ፍርደካ ገችሰኬ፥ ከትካንታ እምምሳንደትመረ ጉርምንም Ꮊፍሰኬ፥ ዞበንከስተረ አፈን ዝጨኬ።<note caller="-" style="x"><char style="xo" closed="false">11፡33 </char><char style="xt" closed="false"><ref loc="DAN 6:27">ዳን. 6፡27</ref>። </char></note><verse eid="HEB 11:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="HEB 11:34"/>ኖሄታ ዎልቀንመረ ካይሰኬ፥ ግቼርሳን ማሰንዘንከረ ሱርቸኬ፥ ኬታ ጋፍና ዳቅንታር ኦክምሴ፥ ዳምካ ኤስምስባብከስ ማቼኬ፥ ይምኤንባብከስ ኦይቻን ዳምንባብከስም ዳይሰኬ፥<note caller="-" style="x"><char style="xo" closed="false">11፡34 </char><char style="xt" closed="false"><ref loc="DAN 3:30">ዳን. 3፡30</ref>። </char></note> <verse eid="HEB 11:34"/><verse number="35" style="v" sid="HEB 11:35"/>ማነንከስ፥ ደእስባብ ኬታ ሱሰንከስ ደእያርንካ አምስንካ ሰደኬ፥ አብንከሰረ ስገዳን ደእያርንካ አምንተን Ꮊፍካንታ ገቀርሰኮ Ꮊክ Ꮊክ ማጠንም ተየኬ፥ ከናከስግንዳ ዞክነናርንከረ ዉትካንታ ከታ ዝጋከኬ።<note caller="-" style="x"><char style="xo" closed="false">11፡35 </char><char style="xt" closed="false"><ref loc="1KI 17:24">1 ባንቺ. 17፡24</ref>፤ <ref loc="2KI 4:37">2 ባንቺ. 4፡37</ref>። </char></note> <verse eid="HEB 11:35"/><verse number="36" style="v" sid="HEB 11:36"/>አብንከስ ኤታ ለቃ ማትሰኮ Ꮊርደርሰኬ፥ አብንከስ ዱትን ዞከርድን ስብልንካ ዞከርሰኮ ዞክና ኤሄናር ኦይትምሰኬ፥<note caller="-" style="x"><char style="xo" closed="false">11፡36 </char><char style="xt" closed="false"><ref loc="1KI 22:26-27">1 ባንቺ. 22፡26-27</ref>፤ <ref loc="2SA 18:25-26">2 ሳሙ. 18፡25-26</ref>፤ <ref loc="JER 20:2">ኤር. 20፡2</ref>፤ <ref loc="JER 37:5">37፡5</ref>። </char></note> <verse eid="HEB 11:36"/><verse number="37" style="v" sid="HEB 11:37"/>ሰይንካ አቅምሰኬ፥ ማጋዝካ ተችምሰኬ፥ ማሰከረ እክት ከትም ደይሰኬ፥ ቆልተኬ ደርትታ ጉፍታ ቆበርሰኮ ኦስ ፈንክ ጋየረኮ ጋፍሰኬ፥ ሪካይሰንባብኬ ዳይርምስባብ ማትሰኮ ላንቅሰኬ፥<note caller="-" style="x"><char style="xo" closed="false">11፡37 </char><char style="xt" closed="false"><ref loc="2SA 24:21">2 ሳሙ. 24፡21</ref>። </char></note> <verse eid="HEB 11:37"/><verse number="38" style="v" sid="HEB 11:38"/>ዴል ቆቻር፥ ገቼዘን፥ የርሳርኬ ጎርያር ኦንግዘኬ። ኮግንደከረ ፍጫሙደንካንታ ዝግዝድባብ ማትሶ Ꮊፈራክዬ።<verse eid="HEB 11:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39"/>ከናከስ ሙዳ ኬታ አሜንንጎካ ሳብካ ማርከርምስባብ ማችንከረ ከትካንታ እምምሳን ጉርምን አክ Ꮊፋከኬ። <verse eid="HEB 11:39"/><verse number="40" style="v" sid="HEB 11:40"/>ሳብ ዎካንታ ስግ ኡርሳንደትም ገቀርቴ፥ ኮካንታ ኬታ ዎንካ ክክን ዳት ኬታ ይንት ቦድማ ማዳከኬ።<verse eid="HEB 11:40"/></para>
  <chapter eid="HEB 11"/>
  <chapter number="12" style="c" sid="HEB 12"/>
  <para style="s1">ሳብ ይንታ ይንችን Ꮊግዴ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1"/>ኡፓግንዳ ዎንታ ካንተንካ ቀይንስባብከስ ኬና ሙዳ ማርከንከስ ዎንታ ዶቅድንካንታ ዎታ ባላ ማድንደትመረ ሙዳ ዎንዘን የድምሳን ጎመን Ꮊልእስሶቶ ዎንታ እረረ ዶቅድን አብንም ጋምካንታ ዞደን ዳንዳእካ ዎ ዞዳ። <verse eid="HEB 12:1"/><verse number="2" style="v" sid="HEB 12:2"/>ዎ ዞድንደረ ዎንታ ኣመንንታ የድንም የችስባብኬ ቦድንታ ማችባብ የሱሰም ሰድንኬ፥ ኖይንታ እሪ ዶቅድን ጉርምንጎካ ማዝቀልንዘን ደእንካ ኦስነን Ꮊረነረ ፋይዳክዶቆ ማዝቀልንዘን ማጠንምኬ ደእንም ዳንዳእሴ፥ ሳብታ ዶቅንት ጎንገንታ ምዝዘነረ ዶቅሴ።<verse eid="HEB 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 12:3"/>ይና ቦሳከትዶቆ አነረ ጉርምን የንታ ተቻከትዶቆ ኮም ሙዳ ጎመንባብከስታ ግርን ዳንዳእስባብ የሱሰም ሰድከቴ። <verse eid="HEB 12:3"/><verse number="4" style="v" sid="HEB 12:4"/>የታ ጎመካ ክክን ጉርካ አክ የ ደይስምተርን የለልታ ጉራከቴ። <verse eid="HEB 12:4"/><verse number="5" style="v" sid="HEB 12:5"/>ሳብ ይንታ ይንችግንዳ ማስሶ ኩንጋየሮ የካንታ ዞርሳንደትም ባቀርተቴ፥</para>
  <para style="q1" vid="HEB 12:5">“እስታ ይንችኖ! ጮይስታ Ꮊገን Ꮊይቶክሴ፥</para>
  <para style="q2" vid="HEB 12:5">የስም ዋጫንᎺይከረ የስታ ጉርምን Ꮊይተቼ፥<verse eid="HEB 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6"/>ጮይስ ይሶልምድባብም ኖ Ꮊግዴ፥</para>
  <para style="q2" vid="HEB 12:6">ይንታ ይንችግንዳ ማስሶ ይ ሰድባብም ስርዴ”። <note caller="-" style="x"><char style="xo" closed="false">12፡6 </char><char style="xt" closed="false"><ref loc="PRO 3:11-12">ካም. 3፡11-12</ref>። </char></note><verse eid="HEB 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7"/>ሳብ ይንታ ይንችግንዳ የም ፋይድንካንታ ክታ ሰርንም ዳንዳእከቴ፥ ባቤና ሰርዳክባብ ይንች Ꮊይራ? <verse eid="HEB 12:7"/><verse number="8" style="v" sid="HEB 12:8"/>ይንች ማችባብ ሙደና ከት ተይድን ሰርንም የተረ የተያክንዳ ማቼ አጭባብ ኤስማይ ይንችግንደት ዳት ባብይ ዶቅድን ይንችግንዳ ካየቴ። <verse eid="HEB 12:8"/><verse number="9" style="v" sid="HEB 12:9"/>ኮዘንከረ አብ ዎ ሙደን ሰርድባብ ዎም አጭባብ ዎንታባቤንከስ ዶቅደኬ፥ ዎታ ከትም ቦንጅድᎺቆቴ፥ ኮናና፥ ሰንፔካ ዶቅካንታ አያንናር ዎንታ ባቤንንካንታ ስግስሶ ክትም Ꮊስግንዳ ዎም ዝግሳይንዳ! <verse eid="HEB 12:9"/><verse number="10" style="v" sid="HEB 12:10"/>ኬታ ኡርማ ካምሶ ከትካንታ Ꮊፈርሳንግንዳ ቶክም ሰጫካንታ ዎም ሰርተኬ፥ ሳብ ማቼ ሳብካንታ ፋስምን ካስምድባብ ዎማድንግንዳ ዎም መይድንግንዳ ሰርዴ። <verse eid="HEB 12:10"/><verse number="11" style="v" sid="HEB 12:11"/>ሰር ሙደና ይንታ ሰጨንካ ሞርእስዝድንዳ ዳት ጉርምዝድንዳ ካማዬ፥ ኬዛር ማቼ ሰርና ኤስሳን ኤድንከስካንታ ሳራትች በጃን ጭለትቼንታ አፍን ከትካንታ Ꮊፍስዝዴ።<verse eid="HEB 12:11"/></para>
  <para style="s1">ዞረኬ ኤግዝምስካ</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12"/>ኮካንታ የንታ አንቼርሳን አንንምኬ ጋፍሳን የንታ ቡቀንከስም ዛብስከቴ።<note caller="-" style="x"><char style="xo" closed="false">12፡12 </char><char style="xt" closed="false"><ref loc="ISA 35:3">ኢሳ. 35፡3</ref>። </char></note> <verse eid="HEB 12:12"/><verse number="13" style="v" sid="HEB 12:13"/>ዎከልዎከል ጋይድባበረ ፋጭድንግንዳ ዳት ካርንም ዛቅሶ ዎብዳክንግንዳ የንታ ዱትንካንታ ሉላ ጎግ ማስከቴ።<note caller="-" style="x"><char style="xo" closed="false">12፡13 </char><char style="xt" closed="false"><ref loc="PRO 4:26">ካም. 4፡26</ref>። </char></note><verse eid="HEB 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14"/>ሳብካንታ ፋስማክዶቆ Ꮊየነረ ጮይስም ሰድንካንታ ማታይንካንታ ኤድ ሙደንካ ክክን ኡርመካ ዶእከቴ፥ ሳብካንተረ ፋስምሶ ዶቅካንታ ጉርከቴ። <verse eid="HEB 12:14"/><verse number="15" style="v" sid="HEB 12:15"/>የንታርንካ Ꮊየነረ ሳብታ ዉች እምንተና ክታዘን ዞገርዳክንግንዳ ካርስምከቴ፥ ኮትኮግንደረ Ꮊረነረ ጫቅምድን አፍ ኡዝድን ኮራ የንታ ዎክያር ባቀልዳክንግንደኬ የም ማእዝዳክንግንዳ በድንከስመረ ቱና ማዝዳክንግንዳ ካርስምከቴ።<note caller="-" style="x"><char style="xo" closed="false">12፡15 </char><char style="xt" closed="false"><ref loc="DEU 29:18">ካሪ. 29፡18</ref>። </char></note> <verse eid="HEB 12:15"/><verse number="16" style="v" sid="HEB 12:16"/>ቤልምባብ ማችባብ አነረ ዋልቃዱት እችምካንታ ጋይሶ ይንታ ባይረንም ሰንስባብ ኤሳውግንዳ ሳብም ጳዝዳክባብ ኤድ Ꮊፈርዳክንግንዳ ካርስምከቴ።<note caller="-" style="x"><char style="xo" closed="false">12፡16 </char><char style="xt" closed="false"><ref loc="GEN 25:29-34">ፍዝ. 25፡29-34</ref>። </char></note> <verse eid="HEB 12:16"/><verse number="17" style="v" sid="HEB 12:17"/>ኮታ ቡረረ ኤሳው አንጀንም ካርንካ ተይካንታ ክት ዝግዛንᎺይካ ኮትኮ አንጀንም ክትካንታ ማርምሳንደትም የታ ኤዝደቴ፥ ኤፈሮ ዎራ ኮት አንጀንም በድካ ክት ዝግዝንከረ ኖ Ꮊፋክዬ። ጎማ ፍክስን ዎይስታ ካሪ Ꮊፋክዬ።<note caller="-" style="x"><char style="xo" closed="false">12፡17 </char><char style="xt" closed="false"><ref loc="GEN 27:30-40">ፍዝ. 27፡30-40</ref>። </char></note><verse eid="HEB 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18"/>የታ አንካ ዎልምድን አነረ አድን ሲና ገቼንዘን፥ ቃይቃየንደር፥ ኡምንደርኬ፥ ቡርበች ዞገንደረረ የላከቴ። <verse eid="HEB 12:18"/><verse number="19" style="v" sid="HEB 12:19"/>አንዳለታ ኡፍስኬ አነረ ኬዝምድን ኡፍስ ኤስምድንደታር የላከቴ፥ ኮትኮ ኡፍስን ኤሰርሳን ኤድንከስ “ይና ኮዘንካ ኦስ አብ ኬዛ ዎካንታ Ꮊይከዝማ” ጋይንተካ ምክስ ዎራ የጀኬ።<note caller="-" style="x"><char style="xo" closed="false">12፡19 </char><char style="xt" closed="false"><ref loc="EXO 19:16-22">ዉት. 19፡16-22</ref>፤ <ref loc="EXO 20:18-21">20፡18-21</ref>፤ <ref loc="DEU 4:11-12">ካሪ. 4፡11-12</ref>፤ <ref loc="DEU 5:22-27">5፡22-27</ref>። </char></note><verse eid="HEB 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="HEB 12:20"/>ኮካንታ “መሄንከስ ዎራ ገቼንም ዎልሴ</para>
  <para style="q2" vid="HEB 12:20">ሰይንካ አቀርሶ ከት ደአ”</para>
  <para style="m" vid="HEB 12:20">ጋይድን ክቴና ከትም ደጫንኦል ባላካንታ ማታከኬ።<note caller="-" style="x"><char style="xo" closed="false">12፡20 </char><char style="xt" closed="false"><ref loc="EXO 19:12-13">ዉት. 19፡12-13</ref>። </char></note> <verse eid="HEB 12:20"/><verse number="21" style="v" sid="HEB 12:21"/>ሰድምሳን ይተና አንድር ጳስዝድንዳ ማትንተንዘንካ አምሳንዳ ሙሴ ዎራ</para>
  <para style="q1" vid="HEB 12:21">“እታ ጳሳቴ፥ እታ ጭጫቴ” ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">12፡21 </char><char style="xt" closed="false"><ref loc="DEU 9:19">ካሪ. 9፡19</ref>። </char></note><verse eid="HEB 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22"/>የታ ማቼ ጽዮን ገቼንደር የልተቴ፥ ና ዶቅንት ሳብንታ ካተማ ማቻንዳ ጭላርንዳ የሩሳሌመ፥ ጉርምካ ሳንምስባብከዝደር፥ በድ ሳአካ ፋይድምድን ክታይንችንከዝደር የልተቴ። <verse eid="HEB 12:22"/><verse number="23" style="v" sid="HEB 12:23"/>ኬታ ላምና ጭላር ጻፍምሳንደታር፥ ኣመንድባብከሳርንካ ኤልምካ ዳነዝ ማችባብከስታ ሳንንተናር፥ ሙደንዘን ፍርዳካንታ ማድባብ ጮይስንደርኬ ቦድማ ማችባብ ጭልምስባብ ሰንፔንከዝደር የልተቴ። <verse eid="HEB 12:23"/><verse number="24" style="v" sid="HEB 12:24"/>ክላ ጫቃ ቃለንታ ግድያር ማትሶ ኤድምዝድባብ የሱሰደር፥ አበልታ ማቀስንዘንካ ስግ ኡርድንደትም ከዝድባብደርኬ ይጭምሳን ማቀስንደር የልተቴ።<note caller="-" style="x"><char style="xo" closed="false">12፡24 </char><char style="xt" closed="false"><ref loc="GEN 4:10">ፍዝ. 4፡10</ref>። </char></note><verse eid="HEB 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25"/>ኮትኮም ኬዝድባብደር ኤሰርዳኮተ የ ጋይተራክንግንዳ ካርስምከቴ፥ ከታኬና ሳብ፥ ኤድጎካ ፍጨዘን ከትካንታ ኬዝድንካ ኤሰርዳኮተ ጋይስባብከስ ከት ሱርታክንዳ ማቼ፥ ይና ዎታ ጭለዘንካ ዎካንታ ኬዝድባብም ዎ ኤሰራክንዳ ማቼ Ꮊስግንዶንት ሱርዳ!<note caller="-" style="x"><char style="xo" closed="false">12፡25 </char><char style="xt" closed="false"><ref loc="EXO 20:22">ዉት. 20፡22</ref>። </char></note> <verse eid="HEB 12:25"/><verse number="26" style="v" sid="HEB 12:26"/>ኮታይካ ክታ ኡፍስና ፍጨንም ሶክስቴ፥ ታ ማቼ “ፍጨንም Ꮊክ ማታክናና ዋልቃዱት አነታ ጭለንም ጉጅስቶ ሶግዝድቴ” ጋይንተካ ጉርምን ኬዝቴ።<note caller="-" style="x"><char style="xo" closed="false">12፡26 </char><char style="xt" closed="false"><ref loc="HAG 2:6">ሐጌ 2፡6</ref>። </char></note> <verse eid="HEB 12:26"/><verse number="27" style="v" sid="HEB 12:27"/>ኮና “ዋልቃዱት ጉጅስቶ” ጋይድን ኬዘና ሰጅድንዳ ሶግዳክን ሪንከስ ዳቅሶ ከት ዶቅድንግንዳ ሶግድን ሪንከስ አነረ ፍዝምሳን ሪንከስታ ካይንተን ሰጅዴ።<verse eid="HEB 12:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28"/>ይና ዎታ ሶግዳክን ባንችምን ዎ ተይድንካንታ ሳብም ዎ ጋለታ፥ ክት ጉርምድንጎግካ ቦንቼኬ ጳስካ ዎ ክትካንታ ፍክሳ። <verse eid="HEB 12:28"/><verse number="29" style="v" sid="HEB 12:29"/>Ꮊራካንታ ጋይሴ ዎንታ ጮይስና አድን ኖሀግንዴ።<note caller="-" style="x"><char style="xo" closed="false">12፡29 </char><char style="xt" closed="false"><ref loc="DEU 4:24">ካሪ. 4፡24</ref>። </char></note><verse eid="HEB 12:29"/></para>
  <chapter eid="HEB 12"/>
  <chapter number="13" style="c" sid="HEB 13"/>
  <para style="s1">ሳብም ጉርምዝድን ፍክስ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1"/>ሙዳᎺይካ ክክ ክክ እስመንተኬ ካንስተካ ሶልመንግንዳ ሶልማ የካንታ ዶቃ። <verse eid="HEB 13:1"/><verse number="2" style="v" sid="HEB 13:2"/>ሶችን ሞከንም Ꮊይባቀረቴ፥ ኮትኮግንዳ ሶችንከስም ሞከረኮ ዋልቃ ዋልቃ ኤድንከስ ኤሳከክዶቆ ክታይንችንከስም ሞክተኬ።<note caller="-" style="x"><char style="xo" closed="false">13፡2 </char><char style="xt" closed="false"><ref loc="GEN 18:1-8">ፍዝ. 18፡1-8</ref>፤ <ref loc="GEN 19:1-3">19፡1-3</ref>። </char></note> <verse eid="HEB 13:2"/><verse number="3" style="v" sid="HEB 13:3"/>ከትካ ክክን የካ የ ዞከርሳንከካ ማትሰቶ ዞከርስባብከስም ገቀርከቴ፥ የተረ ከትግንዳ ማጣ ተይድባብከስግንዳ ማትሰቶ ማጣ ተይድባብከስም ገቀርከቴ።<verse eid="HEB 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4"/>እንቼኬ ይእምካ ሙደንደር ቦንችምሳንዳ ማታ፥ ቤልምባብከስምኬ ቤልምንባብከስም ሳብ ኬታዘን ፋረድንካንታ ክእስኬ ኬነንካ ክክ አሜንምክሳ ነግንተካ ይንታ ዶቅንተን ቱና ከት Ꮊይማሳ።<verse eid="HEB 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 13:5"/>ብረም ሶልመዘንካ ጎተርከቴ፥ የንታ ዶቅድንዳ የካንታ ማተረ፥ ሳብ “ቦድሶ እታ የስም ዛቃይቴ፥ ባቀራይቴ” ኖ ጋይቴ።<note caller="-" style="x"><char style="xo" closed="false">13፡5 </char><char style="xt" closed="false"><ref loc="DEU 31:6">ካሪ. 31፡6</ref>፥<ref loc="DEU 31:8">8</ref>፤ <ref loc="JOS 1:5">ኢያ. 1፡5</ref>። </char></note> <verse eid="HEB 13:5"/><verse number="6" style="v" sid="HEB 13:6"/>ኮካንታ ኣመንምካ፥</para>
  <para style="q1" vid="HEB 13:6">“ጮይስ እስታ አሌንባቤ፥ ጳዝዳክቴ፥</para>
  <para style="q1" vid="HEB 13:6">ኤድ እም Ꮊርክ ይዳ?” ጋይዶቴ።<note caller="-" style="x"><char style="xo" closed="false">13፡6 </char><char style="xt" closed="false"><ref loc="PSA 118:6">የቺ 118፡6</ref>። </char></note><verse eid="HEB 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7"/>ሳብታ ቃለን እሪምሶ የካንታ ኬዝባብ የም ጎርዝድባብከስም Ꮊይባቀረቴ፥ ከታ ገች Ꮊቅንምኬ ኬታ ፍክስንታ አፍን ገቅርካ ኬታ ኣመንን ጎርስምከቴ። <verse eid="HEB 13:7"/><verse number="8" style="v" sid="HEB 13:8"/>የሱስ ክርስቶስ ናከረ ታከረ ስለንክንደተረ ኖተቴ፥ ኦክማዬ። <verse eid="HEB 13:8"/><verse number="9" style="v" sid="HEB 13:9"/>ኤስምዳክን Ꮊክ Ꮊክ ኤስስንከስ ተይ የም አይዳክንግንዳ፥ ዎንታ ቡደና እችምታ ዎገንም ካርሰካ ማታክናና ሳብታ ዉች እምንተንካ ዳቅሴ ኡርሜ፥ ኮም እችምንታ ዎገንም ጎርስምስባብ ኤድንከስ Ꮊረነረ ከትም መያክዬ።<verse eid="HEB 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 13:10"/>ዎንታ ካሰርድንዳ ዶቅዴ፥ ማችንከረ አይሁድንከስ ጎይንድን ዱንካንናር ፍግዝድባብ ቄሰንከስ ኮትኮ ካሰርድንደታዘን ዶቅድን እችምንዘንካ ተይ ከት እጅድንግንዳ ጋይማዬ። <verse eid="HEB 13:10"/><verse number="11" style="v" sid="HEB 13:11"/>አይሁድንታ ቄሰንከስታ ገችንባብ ጎመታ ነገትቼን Ꮊብዝድንደትም መሄንታ ማቀስ የድሶ ጭል ሳብካንታ ፋስምሳን ኤሄናር አርዴ፥ መሄንታ ዋሄንም ማቼ ኬታ ይንታ ዱንካንዘንካ ጎተርስሶ ካሪ አብንዘን አጅደኬ።<note caller="-" style="x"><char style="xo" closed="false">13፡11 </char><char style="xt" closed="false"><ref loc="LEV 16:27">ሌዊ. 16፡27</ref>። </char></note> <verse eid="HEB 13:11"/><verse number="12" style="v" sid="HEB 13:12"/>ኮትኮግንደረ የሱስይ ዎርሰን ይንታ ገታ ማቀስንካ ጭልስካንታ ካተመንታ ፍልተንዘንካ ማልጎካ ማጠንም ተይሶ ደእሴ። <verse eid="HEB 13:12"/><verse number="13" style="v" sid="HEB 13:13"/>ዎተረ ዎንታ ዱንካንናርንካ ዉትሶቶ ክደር ዎ አያ፥ ክታ ቶችምንመረ ካስምድባብ ዎ ማታ። <verse eid="HEB 13:13"/><verse number="14" style="v" sid="HEB 13:14"/>ዎታ አክ Ꮊድንደት ካተመን ካርዝዶት ዳት ዳቅሶ ዶቅድንዳ ካተማ ኮፍጨዘን ዎንታ ካዬ። <verse eid="HEB 13:14"/><verse number="15" style="v" sid="HEB 13:15"/>ይና የሱስ ክርስቶስጎካ ጋለታ ካሲን ሙዳᎺይካ ሳብካንታ ዎ እማ፥ ኮነረ ክታ ላምንጎካ ማርከርድን አፈንከስካ እምምድንዳ ጋለታ ካሲዬ። <verse eid="HEB 13:15"/><verse number="16" style="v" sid="HEB 13:16"/>ኡርማ ሪም ይተኬ የንታ ዶቅድንደት ሪም አብ ኤድንከስካንታ ካሲንም Ꮊይባቀረቴ፥ ሳብም ጉርምዝድንዳ ኮግንዳ ካሲኔ።<verse eid="HEB 13:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17"/>የም ጎርዝድባብከስካንተረ ክትምከቴ፥ ከታ ገችታ ኤረንታ ጎይያር ማትከቴ፥ ከትም ኦይስዝድንዳ ኬታዘን ዶቅድንካንታ የንታ ሰንፔንጎካ ጉርደኬ፥ የታ ከትካንታ የ ክትምሰ ኬታ ይንታ ፍክስን ጉርምካ ፍግዝደኬ፥ ኩን ማታክን ማቼ ኬታ ይንታ ፍክስንም ሞርእካ ፍግዝደኬ፥ ኮነረ የካንታ መይድንዳ ማታዬ።<verse eid="HEB 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18"/>ዎካንታ ምክስከቴ፥ ባችንባብ ዎም ማዝዳክን ኡርማ ገቅር ዎንታ ዶቅድንደትም ኤስቶቴ፥ ሙዳ ጎግከረ ኡርማ እዘካ ዶቅካንታ አንገርዶቴ፥ <verse eid="HEB 13:18"/><verse number="19" style="v" sid="HEB 13:19"/>ስግስሰረ እ የንደር ሳነካ ማድንግንዳ ዛብሰቶ የ ምክሳባብ ዳቅስስቶ የም ኬዝድቴ።<verse eid="HEB 13:19"/></para>
  <para style="s1">በእንታ ምክስ</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20"/>ቆልንከስታ ግስመንባብ አንድር ዎንታ ጮይስን የሱሰም ስለንክንደታ ጫቃ ቃለንታ ማቀስንካ ደእያርንካ አምስባብ ሳራትቼንታ ጮይስና፥ <verse eid="HEB 13:20"/><verse number="21" style="v" sid="HEB 13:21"/>ክታ ጋይተን ቦድባብ የ ማተርንግንዳ ኡርማ ሪካ ሙዳ የም ሶቅሳ፥ ክትም ጉርምዝድንደትመረ የሱስ ክርስቶስጎካ ዎንካ ክት ፍክሳ፥ የሱስ ክርስቶስካንተረ ስለንካ ስለንክንደታ ቦንቻ ማታ፥ አምንኤ።<verse eid="HEB 13:21"/></para>
  <para style="s1">በእንታ ዞራ</para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22"/>እስመንከስኬ ምችነንከሶ! ኮና የካንታ እ ጻፍሳንዳ ክቴና ቶክም ማቻንካንታ ኮትኮም እስታ ዞራ ኬዘን ዳንዳእካ የ ተይተርንግንዳ ዳቅስስቶ የም ዞርድቴ። <verse eid="HEB 13:22"/><verse number="23" style="v" sid="HEB 13:23"/>ዎንታ እስመን ጢማቶስ ዞክና ኤሄናርንካ ክት ዉተዳንደትም የ ኤስተርንግንዳ ሶልምድቴ፥ ሳነካ ክት ካሪ Ꮊዴ ክትካ ክክን የንደር Ꮊድስቶ የም ሰድቴ።<verse eid="HEB 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24"/>የም ጎርዝድባብከስካንተኬ ሳብካንታ ፋስምስባብከስም ሙዳ አቦ እጎካ ጋይከቴ፥ ኢጣልያ ፍጨናርንካ Ꮊድሶ ካሪ ዶቅድባብ ኣመንድባብከስ አቦ የም ጋይደኬ።<verse eid="HEB 13:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25"/>ሳብታ ዉች እምንተና የ ሙደንካ ክክን ማታ። አምንኤ።<verse eid="HEB 13:25"/></para>
  <chapter eid="HEB 13"/>
</usx>
