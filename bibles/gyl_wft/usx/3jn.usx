<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Gayil New Testament</book>
  <para style="h">3 ዮሀንስ</para>
  <para style="toc1">ኦይትምስባብ ዮሀንሰታ ማክምስ ክቴና</para>
  <para style="toc2">3 ዮሀንስ</para>
  <para style="toc3">3 ዮሀ.</para>
  <para style="mt1">ኦይትምስባብ ዮሀንሰታ ማክምስ ክቴና</para>
  <para style="imt1">አርድንታ</para>
  <para style="ip">ኦይትምስባብ ዮሀንሰታ ማክምስ ክቴና ጻፍምሳንዳ “ዶንጃ ማችባብ ኦይትምስባብ ዮሀንስጎካ” ማድንካ፥ ጻፍምሳንደረ ጋይዮስ ጋይምስባብ ምክስ ኤሄናር ኤድንከስም ጎርዝድባብካንቴ፥ ኖ ጻፍነረ ዋልቃጎካ ክርስቶሳር ማችባብ አብንከስም ክታ አሌንጎካ ጋይዮሰም አንጅዴ፥ አና አብ ጎግከረ ጩበንባብ ኤችን ድዮትሬፍስዘንካ ክት ካርስምድንግንዳ ክትም ገቀርስዝዴ።</para>
  <para style="iot">ማጻፍን ኮትኮታ ሙዳ የድንተና</para>
  <para style="io1">አርድንታ <char style="ior">(<ref loc="3JN 1:1-4">1-4</ref>) </char></para>
  <para style="io1">ጋይዮስታ አንጅምና <char style="ior">(<ref loc="3JN 1:5-8">5-8</ref>) </char></para>
  <para style="io1">ድያትሬፍስታ ዎቀስምና <char style="ior">(<ref loc="3JN 1:9-10">9-10</ref>) </char></para>
  <para style="io1">ድመጥሮስታ አንጅምና <char style="ior">(<ref loc="3JN 1:11-12">11-12</ref>) </char></para>
  <para style="io1">በእንታ <char style="ior">(<ref loc="3JN 1:13-15">13-15</ref>) </char></para>
  <chapter number="1" style="c" sid="3JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1"/>ዶፈንካ እ ሶልምድባብ ጋይዮስካንታ፥ እ ጋልተንዘንካ ኦይትምሳን ክታ<note caller="-" style="x"><char style="xo" closed="false">1፡1 </char><char style="xt" closed="false"><ref loc="ACT 19:29">ኦይት. ፍ. 19፡29</ref>፤ <ref loc="ROM 16:23">ሮማ 16፡23</ref>፤ <ref loc="1CO 1:14">1 ቆሮ. 1፡14</ref>። </char></note> <verse eid="3JN 1:1"/><verse number="2" style="v" sid="3JN 1:2"/>እስታ ገርነኖ! የስታ ዋርጎካ ኤደትቼና ኡርማ ማቻንደትከካ ኡርማ ዘና የስታ ዶቅተርንግንደኬ ሪሙደና የስካንታ ቦድምድንግንዳ ምግዝድቴ። <verse eid="3JN 1:2"/><verse number="3" style="v" sid="3JN 1:3"/>ዶፈንንካንታ የስታ ኣመንንምኬ ዶፈንከረ የስታ ዶቅንተን ዋልቃ ዋልቃ ኣመንድን እስመንንከስ Ꮊድሰኮ እካንታ ከት ኬዛንደትካ አንድር ጉርምሳቴ። <verse eid="3JN 1:3"/><verse number="4" style="v" sid="3JN 1:4"/>ይንችንከሶ ዶፈንካ አየረኮ ከት ዶቅድንደትም ኤስርንዘንካ ስገዳንዳ እም ጉርምዝድ ሪ ካዬ።<verse eid="3JN 1:4"/></para>
  <para style="s1">ጋይዮሰታ ጎፍስምና</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5"/>እስታ ገርነኖ! የስካንታ ሶችንከስ ማችንከረ ዎራ የስታ እስመንከስካንታ ኣመንምሳን ፍክስን ፍግዝደዬ። <verse eid="3JN 1:5"/><verse number="6" style="v" sid="3JN 1:6"/>ኬተረ ሶልማ ፍክስን ከትካንታ የስ ይሳንኦል ኣመንድባብከስታ እሪ ማርከርተኬ፥ ታየረ ሳብም ጉርምዝድንጎካ ከት ጎግን አይድንካ የስ አልሰረ ኡርሜ። <verse eid="3JN 1:6"/><verse number="7" style="v" sid="3JN 1:7"/>ኬታ ክርስቶስታ ፍክስንካንታ ዉደኮ አይሁድ ማታክባብከዘንካ Ꮊረነረ አላ ተያከኬ። <verse eid="3JN 1:7"/><verse number="8" style="v" sid="3JN 1:8"/>ዶፈን ፍክስንም ካስምድባብ ዎማድንግንዳ ከትኬና ዶቅድን ኤድንከስም አላ ዎም ዝግዝዴ።<verse eid="3JN 1:8"/></para>
  <para style="s1">ድዮትሬፍስኬ ድመጥሮስካ</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9"/>ኮታ ኤና እሪ ምክስ ኤሄንካንታ ጻፍትቴ፥ ኬዛርንካ ማቼ ምክስ ኤሄንታ ጎርስባብ ማት ዝግድባብ ድዮትሬፍስ እስታ ገቅርንም ተያክዬ። <verse eid="3JN 1:9"/><verse number="10" style="v" sid="3JN 1:10"/>ኮካንታ የንደር እ Ꮊድንካ ኖ ዎም የከርንደትኬ ዎም ቶቼሮ ክት ይሳን ዳቅል ፍክስን ሙዳ የ ሙደንካንተረ ኬዝድቴ፥ ኮነረ ክትካንታ ማትክሳ ነግድንካ፥ ኖይንታ ማታርንካ ይንታ እስመንከስም ሞግዳክዬ። አብንከሰረ ከትም ሞግዳክንግንዳ ማርዴ። ምክስ ኤሄናርንከረ ከትም ዉጅዴ።<verse eid="3JN 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11"/>እስታ ገርነኖ! ኡርመንም ካምካ ዳት ዳቅልን Ꮊይካሜ። ኡርማ ፍክስንም ፍግዝድባብ ሙደና ሳብዘንኬ። ዳቅል ፍክስንም ፍግዝድባብ ማቼ ሳብም ሰዳክዬ።<verse eid="3JN 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12"/>ድመጥሮስካንታ ኤድ ሙደና ኡርመካ ክትካንታ ማርከርደኬ። ዶፈነረ ይንታ ማታርንካ ክትካንታ ማርከርዴ። ዎተረ ክትካንታ ማርከርዶቴ፥ ዎንተረ ማርከርና ዶፈን ማትንተን የና ኤዝደዬ።<verse eid="3JN 1:12"/></para>
  <para style="s1">በእንታ ሳራትቼና</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13"/>እ የስካንታ ጻፍታ ዝግዛንዳ በድ ሪ ዶቅዳዶቆ፥ ኬዛርካ ማቼ ጻፍት እ ኦይድን ክቴን ኤስምስካንታ ዝጋይቴ። <verse eid="3JN 1:13"/><verse number="14" style="v" sid="3JN 1:14"/>ቅንች የስም ሰድካንታ ጉርም ይድቴ፥ ዎ Ꮊፈርሳን ኮትሰጨናይካ ክክን የካ ኬዝምተሮቴ።<verse eid="3JN 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15"/>ሳራትቼና የስካንታ ማታ።</para>
  <para style="p" vid="3JN 1:15">ገርነንከስ አቦ የስም ጋይደኬ። የነረ ዎንታ ገርነንከስ ዋልቃ ዋልቀንም አቦ አቦ ጋይካ።<verse eid="3JN 1:15"/></para>
  <chapter eid="3JN 1"/>
</usx>
