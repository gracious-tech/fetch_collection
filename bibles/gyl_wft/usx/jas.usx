<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- Gayil New Testament</book>
  <para style="h">ያይቆብ</para>
  <para style="toc1">ያይቆብታ ክታ</para>
  <para style="toc2">ያይቆብ</para>
  <para style="toc3">ያይ.</para>
  <para style="mt1">ያይቆብታ ክታ</para>
  <para style="imt1">አርድንታ</para>
  <para style="ip">ኮና ያይቆብታ ክቴና ሰጨናር ገች Ꮊቅንጎካ ኬዝድንደት ገቅርን የጃንዳ ማድንካ ጻፍምሳንደረ ፍጫሙደንዘን ይጭምስባብከስ ክርስቶሳር ኣመንድባብ ሙደንካንቴ፥ ኖ ጻፍስባብ ኤጨንም ፍክስዘን ዎ Ꮊቅዝድንደታጎግን፥ ኣመንድባብከስም ሞከንጎኬ ኬታ እዘንጎካ ከትም ጎርስንዳ ማድን ሪንከስም መያ ማቻን ካምስካ ኬዝዴ፥ ሪካይሳ ማትንታጎከ ቆልማጎካ፥ ጰጭምጎካ፥ ኡርማ እዘንጎካ፥ ቀምስጎካ፥ ኣመንንጎከኬ ኡርማ ፍክስ ጎካ፥ አድምንታ ኡርመንጎኬ ዳቅልንጎካ፥ ኤጨንጎካ፥ ክክ ክክ ዋጭማጎካ፥ ኦትራጎከ ይንታ ማተም ይርክሳ ይይንታጎካ፥ አብንከዘን ፋረድንጎካ፥ ይካችካ ጨቅንጎካ ዳንዳእንጎኬ ምክስንጎካ ክርስቶሳር ማችባብከስ ይ ከትም ዝግዝድንደትም ነግማይንደትም ሙዳ ጻፍቴ።</para>
  <para style="ip">ክታ ክቴና ክርስቶሳር ማትሶ ዶቅንተንታ አሜንና ፍክስካ ሰቸርድንደትም መያ ማዝዴ።</para>
  <para style="iot">ማጻፍን ኮትኮታ ሙዳ የድንተና</para>
  <para style="io1">አርድንታ <char style="ior">(<ref loc="JAS 1:1">1፡1</ref>) </char></para>
  <para style="io1">ኣመንኬ ኤጨንካ <char style="ior">(<ref loc="JAS 1:2-8">1፡2-8</ref>) </char></para>
  <para style="io1">ሪካይሳ ማትንተኬ ቆልመካ ማትንታ <char style="ior">(<ref loc="JAS 1:9-11">1፡9-11</ref>) </char></para>
  <para style="io1">ጰጫ <char style="ior">(<ref loc="JAS 1:12-18">1፡12-18</ref>) </char></para>
  <para style="io1">ሳብታ ቃለንም ኤስርኬ ፍክስዘን Ꮊቅስ <char style="ior">(<ref loc="JAS 1:19-27">1፡19-27</ref>) </char></para>
  <para style="io1">ኤታ ባላካንታ ኦስነካ ይይምዳክንግንዳ እምምሳን ኤግዝምስ <char style="ior">(<ref loc="JAS 2:1-13">2፡1-13</ref>) </char></para>
  <para style="io1">ኣመንኬ ፍክስንካ <char style="ior">(<ref loc="JAS 2:14-26">2፡14-26</ref>) </char></para>
  <para style="io1">ክርስቶሳር ማችባብከስጎኬ ኬታ አድምናርንካ ዉድን ኬዘንጎካ <char style="ior">(<ref loc="JAS 3:1-18">3፡1-18</ref>) </char></para>
  <para style="io1">ክርስቶሳር ማችባብከስኬ ኮፍጫ ሙደንጎካ <char style="ior">(<ref loc="JAS 4:1-5:6">4፡1—5፡6</ref>) </char></para>
  <para style="io1">Ꮊክ Ꮊክ ሪንከስጎካ እምምሳን ዞራ <char style="ior">(<ref loc="JAS 5:7-20">5፡7-20</ref>) </char></para>
  <chapter number="1" style="c" sid="JAS 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1"/>ፍጫ ሙደናር ይጭምስባብ ታመኬ ቃስቴን አጥርንከስካንታ፥ ሳብተኬ ጮይስ የሱስ ክርስቶስታ ፍክስንባብ ማችባብ ያይቆበዘንካ ኦይትምሳን ክታ፥ ሳራትቼነረ የካንታ ማታ።<verse eid="JAS 1:1"/></para>
  <para style="s1">ማጣ ሰጨካ ዝግዝድን ኣመንኬ ኤጨካ</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2"/>እስመንከስኬ ምችነንከሶ! Ꮊክ Ꮊክ ጰጨና የም የልድንካ የም አንድር ጉርምዝድን ሪንከስም የ Ꮊፍሳንግንዳ ማስሰቶ ፋይድከቴ። <verse eid="JAS 1:2"/><verse number="3" style="v" sid="JAS 1:3"/>የንታ ኣመንንታ ጰጭምና ዳንዳእን የካንታ Ꮊፍስዝድንዳ ማትንተን ኤዝደቴ። <verse eid="JAS 1:3"/><verse number="4" style="v" sid="JAS 1:4"/>ዳንዳእንካ የንታ ዳቅንተና Ꮊረነረ የንዘንካ ዞገራክዶቆ ቦድመኬ ጮጭ የ ማታባብ የም ማዝድንዳ ማታ። <verse eid="JAS 1:4"/><verse number="5" style="v" sid="JAS 1:5"/>የንታ ግድያርንካ ኤጫ ዞገርስባብ ኤድ ዶቅሴ ሳብም ክት ምክሳ፥ ሳበረ ክትካንታ እምተሬ፥ ኖ Ꮊረነረ ቦሳክዶቆ ሙደንካንታ እምንተንም እምድባብ Ꮊልስማ ጮይስዬ። <verse eid="JAS 1:5"/><verse number="6" style="v" sid="JAS 1:6"/>ኬዛር ማቼ ኤድ Ꮊረነረ Ꮊኤራክዶቆ ኣመንካ ክት ምክሳ፥ Ꮊኤርድን ኤድ ዞገካ Ꮊንቅምሳንደትኬ ሩብምድን ባሀርንዘን ዞገንም ካምዴ። <verse eid="JAS 1:6"/><verse number="7" style="v" sid="JAS 1:7"/>ኮግንዳ ኤድና ጮይስዘንካ Ꮊራ ሪየረ Ꮊብድን ክደር Ꮊይካማ። <verse eid="JAS 1:7"/><verse number="8" style="v" sid="JAS 1:8"/>ኮነረ ማድንዳ ቃስቴን ገቅር ክታ ዶቅድንካንተኬ ይንታ ጎግንከረ ኦስ ፈንክ ጋይድንኦሌ።<verse eid="JAS 1:8"/></para>
  <para style="s1">ሪካይሳ ኤችንተኬ ቆልመክንባብ ኤችንታ ጉርም</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9"/>ይንታ ዶቅንተካ ቶክማ ማችባብ እስመና ሳብ ክትም ጬክሳ ይድንኦል ክትም ጉርምሳ። <verse eid="JAS 1:9"/><verse number="10" style="v" sid="JAS 1:10"/>ኤታ ቆልማ ድረታ ቦናግንዳ ድግድንኦል ይንታ ዶቅንተካ ጬክን ጋይስባብ እስመና ሳብ ክታ ዶቅንተን ይርክሳ ይሳንማቼረ ክትም ጉርምሳ። <verse eid="JAS 1:10"/><verse number="11" style="v" sid="JAS 1:11"/>Ꮊይና ይንታ ኦይጥምንካ ክክን ዉድንካ ድረንም ዎችዝዴ ቦነነረ ድግዴ፥ ላቅምነረ ካይዴ፥ ኮትኮግንደረ ቆልመክንባብ ይንታ ፍክስንካ ጋፈሮ ካይዴ።<note caller="-" style="x"><char style="xo" closed="false">1፡11 </char><char style="xt" closed="false"><ref loc="ISA 40:6-7">ኢሳ. 40፡6-7</ref>። </char></note><verse eid="JAS 1:11"/></para>
  <para style="s1">ኤድዘን የልድን ጰጫ</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12"/>ጮይስና ይንታ ቃላ ጫቀንዘንካ አምሳንዳ ይንታ ገርነንከስ ካንታ ክት እምድንደትም ዶቅንት ዛዉደን ተይድንኦል ጰጨን ዳንዳእሶ ዳቅድባብ ኤድ አንጅምስባቤ። <verse eid="JAS 1:12"/><verse number="13" style="v" sid="JAS 1:13"/>ሳብ ዳቅል ሪካ ዎም ጰጭዳክን ኦልኬ ኮግንደረ ኖ Ꮊይመነረ ጰጭዳክንካንታ ኤድ ጰጭምድንᎺይካ “ሳብ እም ጰጬ” Ꮊይጋያ። <verse eid="JAS 1:13"/><verse number="14" style="v" sid="JAS 1:14"/>ኬዛር ማቼ ዋልቃ ዋልቃ ኤድና ጰጭምድንዳ ይንታ ማታርንካ አንግርካ ጎችመሮ ገስምድዬ። <verse eid="JAS 1:14"/><verse number="15" style="v" sid="JAS 1:15"/>ኮታ ቡሪ አንግርና ስርምሶ ጎመንም አጠ፥ ጎመነረ ጋጰሮ ደእንም አጤ።<verse eid="JAS 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16"/>ሶልምምስባብ እስመንከስኬ ምችነንከሶ! Ꮊይገስመቴ! <verse eid="JAS 1:16"/><verse number="17" style="v" sid="JAS 1:17"/>ኡርማ እምንተኬ ቦድማ አንጀና ሙዳ ሳብዘንኬ፥ ኮነረ Ꮊድንደና ስፍግንዳ ኦንጋ ናንከረ ኦክም ካያባብ ሳክመንታ ባቤን ሳብዘንኬ። <verse eid="JAS 1:17"/><verse number="18" style="v" sid="JAS 1:18"/>ሳብ ይንታ ፍዛ ሙደንታ እርንባብ ዎ ማድንግንዳ ይንታ ጋይተንካ ዶፈን ቃለንካ ዎም አጬ።<verse eid="JAS 1:18"/></para>
  <para style="s1">ኤሰርሳንደትም ፍክስዘን Ꮊቅስ</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19"/>ሶልምምስባብ እስመንከስኬ ምችነንከሶ! ኮም Ꮊይ ባቀረቴ፥ ኤድ ሙደና ኤስርካንታ ሳነርስባብ፥ ኬዛካንተኬ ዋጭካንተረ ጭጭዳክባብ ማታ። <verse eid="JAS 1:19"/><verse number="20" style="v" sid="JAS 1:20"/>ኤታ ዋጭ ሳብታ ጭለትቼን Ꮊፍሳዬ። <verse eid="JAS 1:20"/><verse number="21" style="v" sid="JAS 1:21"/>ኮካንታ ቱነምኬ ዳቅልንተረ በድምን ሙዳ Ꮊልእስሰቶ ሳብ የንታ ቡዳር ኮርሳንደትምኬ የንታ ሰንፔንም አቅስካንታ ማድን ቃለን የንታ ማተን ይርክሳ ይይንተካ ተይከቴ።<verse eid="JAS 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22"/>ክታ ቃለን ፍክስዘን Ꮊቅዝድባብ ማትከቴ ዳት የንታ ማተንም ገሰረቶ ኤሰርድባብ Ꮊክ Ꮊይማተቴ። <verse eid="JAS 1:22"/><verse number="23" style="v" sid="JAS 1:23"/>ክታ ቃለንም ኤስርሶ ፍክስዘን Ꮊቅሳይባብ ኤድ ይንታ ባለን ማስታታር ሰድንግንዴ። <verse eid="JAS 1:23"/><verse number="24" style="v" sid="JAS 1:24"/>ኮና ኤችና ይንታ ባለን ማስታታር ይ ሰጃንደታ ቡር አይዴ፥ Ꮊስግንዳ ይ ማቻናንከረ ሳነካ ባቀርዴ። <verse eid="JAS 1:24"/><verse number="25" style="v" sid="JAS 1:25"/>ኬዛር ማቼ ዉች ዉጅድንደትም ቦድማ ህግን ገቅርሶ ክታር ዳቅድባብ፥ ክትመረ ኤስርሶ ባቀርድባብ ማታክዶቆ፥ ፍክስዘን Ꮊቅዝድባብ ኤድ ይንታ ፍክስንካ አንጅምስባብ ማተሬ።<verse eid="JAS 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26"/>ይንታ አድምን ካርሳክዶቆ ሳብም ጎይንድቴ ጋይድን ኤድ ይንታ ማተን ገስዝዴ፥ ክተረ ጎይንና ዉችዬ። <verse eid="JAS 1:26"/><verse number="27" style="v" sid="JAS 1:27"/>ሳብ ባቤንታ እሪ ጭልንኬ ቱና ማታክን ኣመንና “ባቤንኬ እንደንካ ደእሳን ይንችንከስም፥ ኮትኮግንደረ ክእስና ኬታ ደእሳን ማነንከስም ኬታ ማጠናር አላ፥ ጉጅሰረ ይንታ ማተንም ፍጫሙደንታ ቱነንዘንከረ ካርሴ”።<verse eid="JAS 1:27"/></para>
  <chapter eid="JAS 1"/>
  <chapter number="2" style="c" sid="JAS 2"/>
  <para style="s1">ሪ ካየንባብም ቶቻ ዝግዝዳክንደትም</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1"/>እስመንከስኬ ምችነንከሶ! ቦንቻ ጮይስን የሱስ ክርስቶስካ ኣመንድባብ የ ማቼ ዋልቀና አብንከዘንካ ስገዴ ጋይንተካ ኤታ ዎክያር ባላካንታ ጋይሶ Ꮊይ ይየቴ። <verse eid="JAS 2:1"/><verse number="2" style="v" sid="JAS 2:2"/>ካምስካንታ፥ ቃስተን ኤድንከስ የ ሳንምድን ካርዘን Ꮊደኬ፥ ዋልቃባብና ይንታ ግልኤናር ዎርቃ አርችስባብኬ ላቅምድን ሰክም አፍላ ቆበርስባብ ቆልመክንባቤ፥ ቃስትምስነረ ጭመርሳን ገሳ አፍለም ቆበርስባብ ርካየንባቤ። <verse eid="JAS 2:2"/><verse number="3" style="v" sid="JAS 2:3"/>ላቅምድን ሰክም አፍለን ቆበርስባብ ኤችን ቦንቸካ “ኮኡርማ ካርዘን ዶእካ” ክትም ጋይደቴ። ሪ ካየንባብም ማቼ “የና ማቼ ኦኮታር ዎእካ፥ አነረ እስታ ዱትንታ ጎያር ዶእካ” ክትም ጋይደቴ። <verse eid="JAS 2:3"/><verse number="4" style="v" sid="JAS 2:4"/>ይና ኮግንደካ የንታ ዎክያር ፋስምም የ ይድንደትኬ ኤታ ባላካንታ ጋይሰቶ የ ፋረድንዳ የንደር Ꮊፈርዳክዮ?<verse eid="JAS 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5"/>ሶልምምስባብ እስታ እስመንከስኬ ምችነንከሶ! ኤሰርከቴ፥ ሳብ ኣመንካ ቆልመንባብከስ ከት ማድንግንደኬ ክትም ሶልምድባብከስም ጉርም ከትካንታ እምሳንደትም ባንችምን ከት ተይድንግንዳ ኮ ፍጫሙደንዘን ሪ ካየንባብከስም እዳክዮ? <verse eid="JAS 2:5"/><verse number="6" style="v" sid="JAS 2:6"/>የታ ማቼ ሪ ካየንባብከስም ቶጅደቴ፥ የም ማእሳኦንግድባብከስኬ ፍርዳ ኤሄናር የም ጎቻኦግድባብ ቆልመንክንባብከስ ካዮ? <verse eid="JAS 2:6"/><verse number="7" style="v" sid="JAS 2:7"/>የታ የ ኤልምድንደትም ኮትኮ ቦንቻ ላምን የግድባብከስ ኬታ ካዮ?<verse eid="JAS 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8"/>“ኤድም የስታ ማታግንዳ ማስሰዮ ሶልምካ” ጋይምሶ ጭል ማጻፍናር ጻፍምሳንደትም ሳብ ባንችምታ ህግንም የ ቦደ ኡርመን ይደቴ።<note caller="-" style="x"><char style="xo" closed="false">2፡8 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ሌዊ. 19፡18</ref>። </char></note> <verse eid="JAS 2:8"/><verse number="9" style="v" sid="JAS 2:9"/>ኤድንከስታ ዎክያር ፋስምም የ ይድንዳ ማቼ ጎማ ፍግዝደቴ፥ ህግንም ዛቅንተከረ ህግንካ ኦይስምደቴ። <verse eid="JAS 2:9"/><verse number="10" style="v" sid="JAS 2:10"/>ኤድ ክተንከሳርንካ ዋልቀን ዉልእሶ ነግድባብከስም ሙዳ ቦዴ ዎራ ሙደነረ ክት ዉልእሳንግንዳ ፋይድምዴ። <verse eid="JAS 2:10"/><verse number="11" style="v" sid="JAS 2:11"/>“Ꮊይቤልሜ” ጋይስባብ ጮይስና ኮትኮግንደረ “Ꮊይደይሴ” ጋይቴ፥ ኮካንታ የስ ቤልማክናንከረ ዎራ የስ ደይሴ ህግንም ዉልእተዬ።<note caller="-" style="x"><char style="xo" closed="false">2፡11 </char><char style="xt" closed="false"><ref loc="EXO 20:13-14">ዉት. 20፡13-14</ref>፤ <ref loc="EXO 5:17-18">ዉት. 5፡17-18</ref>። </char></note> <verse eid="JAS 2:11"/><verse number="12" style="v" sid="JAS 2:12"/>ባዛካይሳ ዶቅንተን Ꮊፍስዝድን ህግንታ እሪ ዎእሶ ዳይንምዝድን ኤድንከስግንዳ ከስከቴ፥ ኮግንደረ ፍክስከቴ። <verse eid="JAS 2:12"/><verse number="13" style="v" sid="JAS 2:13"/>ሳብታ ፍርደና አጭር ካየን ኤድንካንታ አጨርዳክዬ፥ ኮካንታ አጭርና ፍርደንም ጋምዴ።<verse eid="JAS 2:13"/></para>
  <para style="s1">ኣመንኬ ፍክስካ</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14"/>እስታ እስመንከስኬ ምችነንከሶ! ኤድ ኣመን እስታ ዶቅዴ ይ ጋይሴ፥ ይንታ ኣመንንም ኡርማ ፍክስካ መያ ክት ማሳክን ማቼ Ꮊሮክ ክትም መዬ? ኣመና ክታ ክትም አቅስካንታ ማዶ? <verse eid="JAS 2:14"/><verse number="15" style="v" sid="JAS 2:15"/>ካምስካንታ ከት ቆበርድንደትኬ ከት እጅድንደትካ ካየንባብ እስመንከስኬ ምችነንከስ ዶቅሴ፥ <verse eid="JAS 2:15"/><verse number="16" style="v" sid="JAS 2:16"/>የንታ ዋርንካ ዋልቃባብ ኬታ ዶቅንተንካንታ ከትም ዝግዝድን ሪ ከትም እማክዶቆ “ኡርማ አይከቴ! የም ኦይጣ! ምስከቴ!” ከትም ጋይዴ Ꮊሮክ ከትም መዬ? <verse eid="JAS 2:16"/><verse number="17" style="v" sid="JAS 2:17"/>ኡርማ ፍክስዘንካ ፋስምሳን ኣመንና ደእሳንዴ።<verse eid="JAS 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18"/>ኬዛርካ ማቼ “የስታ ኣመን ዶቅዴ፥ እስተረ ኡርማ ፍክስ ዶቅዴ” ጋይድባብ ዶቅሴ፥ “የስታ ኣመንን የስታ ፍክስንዘንካ ፋስሰዮ እም ሰችካ፥ እተረ እስታ ፍክስንካ እስታ ኣመንን የስም ሰችትቴ” ክደር ጋይድቴ። <verse eid="JAS 2:18"/><verse number="19" style="v" sid="JAS 2:19"/>“ዋልቃ ሳብ ዶቅዴ” የዝደር እ ጋይሴ የና ኣመንደዬ፥ ኮነረ ኡርሜ፥ ኣመንን ማቼ ግምዘንከሰረ ኣመንደኬ፥ ጳስከረ ጭጭደኬ። <verse eid="JAS 2:19"/><verse number="20" style="v" sid="JAS 2:20"/>የና ዳቼኖ! ኣመንና ፍክስካይሳ አፍ ካየንዳ ማትንተን የና ሰዳዶቅዳ?<note caller="+" style="f"><char style="fr" closed="false">2፡20 </char><char style="ft" closed="false">አፍካይሳ ጋይድንደትም፤ ዋልቃ ዋልቃ ኤና እር ጻፈርሳን እ ከስ “ደእሳንዴ” ጋይደኬ። </char></note> <verse eid="JAS 2:20"/><verse number="21" style="v" sid="JAS 2:21"/>ዎንታ ባቤን አብራሀም ይንታ ይንችን ይሳቀም ካሲ ካርንዘን ሳብካንታ ካሲ ማስሶ እምሳንደትካ ክት ጭልምሳንዳ ፍክስካ ካዮ?<note caller="-" style="x"><char style="xo" closed="false">2፡21 </char><char style="xt" closed="false"><ref loc="GEN 22:1-14">ፍዝ. 22፡1-14</ref>። </char></note> <verse eid="JAS 2:21"/><verse number="22" style="v" sid="JAS 2:22"/>ኮካንታ ኣመንና ክታ ፍክስንካ የካ Ꮊቃንግንደኬ ኣመንነረ ፍክስካ ቦድማ ማቻን የና ሰዳዶቅዳ? <verse eid="JAS 2:22"/><verse number="23" style="v" sid="JAS 2:23"/>ጭል ማጻፍናር “አብራሀም፥ ሳብንም ኣመንሴ፥ ክታ ኣመንነረ ጭል ማትሶ ክትካንታ ፋይድምሴ” ጋይምሳን ቃለና ቦድምሴ፥ ኮግንደካ አብራሀም ሳብታ ገርና ጋይምሴ።<note caller="-" style="x"><char style="xo" closed="false">2፡23 </char><char style="xt" closed="false"><ref loc="GEN 15:6">ፍዝ. 15፡6</ref>፤ <ref loc="2SA 20:7">2 ሳሙ. 20፡7</ref>፤ <ref loc="ISA 41:8">ኢሳ. 41፡8</ref>። </char></note> <verse eid="JAS 2:23"/><verse number="24" style="v" sid="JAS 2:24"/>ይና ኤድ ጭልምድንዳ ኣመንካ Ꮊክ ማታክናና ፍክስከረ የካ ማትንተን ሰደዬ።<verse eid="JAS 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25"/>ኤተን ቤልምን ቤልምድንዳ ረአብ እስራኤልንከስታ ክቴን ተይᎺድባብከስም ይንታ ኤሄናር ሞክሳንደትᎺይከኬ አብ ጎግከረ ከት አይድንግንዳ ኮት ይሳንካንታ ና ይንታ ፍክስንካ ጭልምታ ካዮ?<note caller="-" style="x"><char style="xo" closed="false">2፡25 </char><char style="xt" closed="false"><ref loc="JOS 2:1-21">ኢያ. 2፡1-21</ref>። </char></note><verse eid="JAS 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 2:26"/>ሰንፔዘንካ ፋስምሳንዳ ዋሄና ደእሳንዴ፥ ኮትኮግንደረ ፍክስዘንካ ፋስምሳን ኣመንና ደእሳንዴ።<verse eid="JAS 2:26"/></para>
  <chapter eid="JAS 2"/>
  <chapter number="3" style="c" sid="JAS 3"/>
  <para style="s1">አድማርንካ ዉድን ዳቅል ሪንጎካ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1"/>እስመንከስኬ ምችነንከሶ! ዎታ ኤስንባብከስ ማችባብ ስግዳን ፍርዳ ዎ ተይድንደትም የ ኤዝድንኦል የንታ ዋርንካ በድንከስ ኤስስንባብከስ Ꮊይማታ። <verse eid="JAS 3:1"/><verse number="2" style="v" sid="JAS 3:2"/>ዎታ ሙደና በድᎺይካ ኮተርዶቴ፥ ይንታ ኬዘንካ ኮተርዳክባብ ኖይንታ ዘነንም ካርዝድባብ ቦድማ ኤዴ። <verse eid="JAS 3:2"/><verse number="3" style="v" sid="JAS 3:3"/>ፋረንከስ ዎካንታ ክትምድንግንዳ ኬታ አፈናር ሉጋም አርጅዶቴ፥ ፋረንመረ ዎ ዝግድን ካርዘን ጎርዝዶቴ። <verse eid="JAS 3:3"/><verse number="4" style="v" sid="JAS 3:4"/>ባሀርንዘንካ ቃልዝድንዳ ማርከብ ጋየርድንዳ Ꮊረሰነረ ባከና ማትሰረ አንድር ዞገካ Ꮊንቅምድንዳ ኮት ማችንከረ፥ ማርከብን በይድባብ ቶክም ሪ ሎቀንም ዋለርድንደትካ ይ ዝግዛን ካርያር በይዴ። <verse eid="JAS 3:4"/><verse number="5" style="v" sid="JAS 3:5"/>ኮግንደረ አድም ዘናርንካ ቶክመንዳ ማድዮ አንድር ሪንከስካ ጬቅዴ፥ ባካ ቆቼና አድንዳ ቶክም ኖሄኬ። <verse eid="JAS 3:5"/><verse number="6" style="v" sid="JAS 3:6"/>አድምነረ ኖሀግንዴ፥ አድም ዎንታ ዘነንከስታ ዎክያርንካ ዳቅል ፍጫሙደንዘን ማትሶ Ꮊፈርድንዴ፥ ዎንታ ዘነንም ባችዝዴ፥ ስለንካ ድግዳክንደታርንካ ዉድን ኖሄንግንደረ ዎንታ ዶቅንትንም ሙዳ አዴ። <verse eid="JAS 3:6"/><verse number="7" style="v" sid="JAS 3:7"/>ፍጨዘን ባችርንከስኬ አፍትንከስ፥ ፍጨካ ጎችምድባብከስኬ ሎቃ ባሀርናር ኦንግድባብ ፍዝርንከስ ሙዳ ኤድካ ክትምካንታ ማዴ፥ ጉጅሰረ ክትምተኬ። <verse eid="JAS 3:7"/><verse number="8" style="v" sid="JAS 3:8"/>ኬዛርንካ ማቼ አድምም ክታካንታ ማድባብ Ꮊየነረ ካዬ፥ ደይዝድንደትኬ ገንመንዳ ኮታር ጮጫንዳ Ꮊዉስ ካየንዳ ዳቅል ሪዬ። <verse eid="JAS 3:8"/><verse number="9" style="v" sid="JAS 3:9"/>ኮትከረ ዎንታ ባቤን ሳብም ጋለዶቴ፥ ኮትኮግንደረ ኮትካ ሳብታ ካምስካ ፍዝምስባብ ኤድንከስም ባዶቴ።<note caller="-" style="x"><char style="xo" closed="false">3፡9 </char><char style="xt" closed="false"><ref loc="GEN 1">ፍዝ. 1</ref>፤ <ref loc="GEN 26">26</ref>። </char></note> <verse eid="JAS 3:9"/><verse number="10" style="v" sid="JAS 3:10"/>ዋልቃ አፋርንካ ጋለትኬ ባድካ ዉደኬ፥ እስመንከስኬ ምችነንከሶ! ኮና ማቲ ዝክሳዬ። <verse eid="JAS 3:10"/><verse number="11" style="v" sid="JAS 3:11"/>ዋልቃ ቱትያርንካ ዎጭካንታ ማድንዳ ሎቅድንደትኬ ጫቅምድንደትካ ሎቃ ዉተሮ? <verse eid="JAS 3:11"/><verse number="12" style="v" sid="JAS 3:12"/>እስታ እስመንከስኬ ምችነንከሶ Ꮊቃ በለስና ዎይራ Ꮊቀንታ አፍን ኡዝዶ? አነረ ዎይን Ꮊቀና በለስንታ አፍን ኡዝዶ? ኮትኮግንደረ ዳቅል ሎቃርንካ ጭል ሎቃ Ꮊፈርዶ?<verse eid="JAS 3:12"/></para>
  <para style="s1">ጭላዘንደተኬ ፍጨዘንደታ ኤጨንጎካ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13"/>የንታ ዎክያርንካ ኤጨኬ ገቀርት ተይድባብ ኤድ Ꮊይራ? ኤጨኬ ይንታ ማተን ይርክሳ ይይንተካ ይ ቦጃን ፍክስን ይንታ ኡርማ ዶቅንተንካ ክት ሴቻ። <verse eid="JAS 3:13"/><verse number="14" style="v" sid="JAS 3:14"/>ኬዛር ማቼ ጫቅም፥ ቀምስኬ ማታ ሶልመካ የንታ ቡዳር ዶቅሴ Ꮊይ ጬቀቴ። ዶፈንንታዘን Ꮊይማልተቴ። <verse eid="JAS 3:14"/><verse number="15" style="v" sid="JAS 3:15"/>ኮግንዳ ኤጨና Ꮊፈርድንዳ ፍጫሙደንዘንካ፥ ዋሄዘንካ፥ ግምዘንዘንካ ዳት ሳብዘንካ ካዬ። <verse eid="JAS 3:15"/><verse number="16" style="v" sid="JAS 3:16"/>ቀምስኬ ማተም ሶልማ ዶቅድንካርዘን አዉልኬ ዳቅል ፍክስና ሙዳ ዶቅደኬ። <verse eid="JAS 3:16"/><verse number="17" style="v" sid="JAS 3:17"/>ኬዛር ማቼ ሳብዘንካ Ꮊፈርድንዳ ኤጨና እሪምሰረ ጭልምሳንደ፥ ኮታዘንከረ ሳራትቼንም ሶልምድንዳ፥ ላቅም፥ ክትም፥ አጭር፥ ኡርማ አፍ ኡስ፥ ኤታ ባላካንታ ኦስነኬ ኦትራ ካየንዴ። <verse eid="JAS 3:17"/><verse number="18" style="v" sid="JAS 3:18"/>ሳራትቼን ሶልምድን ኤድንከስ ሳራትቼን ማስሰኮ ጭለትቼንታ አፍን ሳንዝደኬ።<verse eid="JAS 3:18"/></para>
  <chapter eid="JAS 3"/>
  <chapter number="4" style="c" sid="JAS 4"/>
  <para style="s1">ፍጫሙደንታ ዳቀልስን ግር</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1"/>የንታ ዎክያር ዶቅድንዳ ዳምንኬ ዋጭመካ Ꮊምንካ Ꮊዳንደረ? የንታ ዘነንታዋር ዳምድንደት የንታ ዋሄንታ አንግርዘንካ ካዮ? <verse eid="JAS 4:1"/><verse number="2" style="v" sid="JAS 4:2"/>ዋልቃ ርም Ꮊፍካንታ የታ አንገርደቴ፥ ማችንከረ የታ Ꮊብዳከቴ፥ ኮካንታ ኤድም የታ ደይዝደቴ። የ ምግዝዳክንኦል የ ዝግድንደት ርም Ꮊብዳከቴ። <verse eid="JAS 4:2"/><verse number="3" style="v" sid="JAS 4:3"/>የ ምክሰረ የንታ ምክስንታ ማስን የ Ꮊብዳክንዳ የ ምክሳን ርም ዋሄታ ጉርምዘን Ꮊቅስካንታ ዳቅል ገቅርካ የ ምግዝድንካንቴ። <verse eid="JAS 4:3"/><verse number="4" style="v" sid="JAS 4:4"/>የታ ቤልምንባብከሶ! ፍጫ ሙደን ሶልምድባብ ሳብካ ይምኤእርድባብ ክት ማድንደትም የታ ኤሳየቴ? ይና ፍጫ ሙደን ሶልምድባብ ሙደና ሳብካ ይምኤርስባብ ማቴ። <verse eid="JAS 4:4"/><verse number="5" style="v" sid="JAS 4:5"/>ጉጅሰረ ጭል ማጻፍና “ሳብ የንታዋር ገችሳን አያንና ክታር Ꮊክ ዎ ማድንግንዳ በድ አንገርዴ” ጋይሳንዳ ዉችዮ? <verse eid="JAS 4:5"/><verse number="6" style="v" sid="JAS 4:6"/>ጭል ማጻፍና “ሳብ ኦትረንባብከስም ግርዴ። ይንታ ማተን ይርክሳ ይድባብከስካንታ ማቼ ይንታ ዉች እምንተን እምዴ” ጋይድንኦል ሳብ እምድንዳ ዉች እምንተና ሙደንዘንከረ ስገዴ።<note caller="-" style="x"><char style="xo" closed="false">4፡6 </char><char style="xt" closed="false"><ref loc="PRO 3:34">ካም. 3፡34</ref>። </char></note> <verse eid="JAS 4:6"/><verse number="7" style="v" sid="JAS 4:7"/>ኮኦል ሳብካንታ ቆልምከቴ፥ ዳብሎሰም ማቼ ግርከቴ፥ ኖየረ የንዘንካ ጎተርዴ። <verse eid="JAS 4:7"/><verse number="8" style="v" sid="JAS 4:8"/>ሳብደር ቅንችምከቴ፥ ኖየረ የንደር ቅንችምዴ፥ የታ ጎመንባብከሶ! የንታ አንንከስም ስኤርከቴ፥ የታ ኦስ ፈንክ ጋያኦንግድባብከስ! የንታ ቡደን ኡርስከቴ። <verse eid="JAS 4:8"/><verse number="9" style="v" sid="JAS 4:9"/>ማጠርከቴ፥ ሞርእከቴ፥ ኤፍከቴ፥ የንታ ይንጭና ኤፍያር፥ የንታ ጉርምና ሞርአር ኦክማ። <verse eid="JAS 4:9"/><verse number="10" style="v" sid="JAS 4:10"/>ጮይስታ እሪ የንታ ማተን ይርክሳ ይከቴ፥ ኖየረ የም ጬክሳ ይተሬ።<verse eid="JAS 4:10"/></para>
  <para style="s1">ኤታዘን ፍርዳ ዝክሳይንደትም</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11"/>እስመንከስኬ ምችነንከሶ፥ ክክ ክክታ ካሪ Ꮊይ ኬዘቴ፥ ኤታ ካሪ ኬዝድባብ ናንከረ ኤታዘን ፋረድባብ፥ ህግንታ ካሪ ኬዝዴ። ህግንዘነረ ፋረዴ፥ ህግንዘን የስ ፋረዴ ጉጅሰረ ፋረድባብ ማትንታ የስታ ዳት ህግን ቦድባብ ካየዬ። <verse eid="JAS 4:11"/><verse number="12" style="v" sid="JAS 4:12"/>ህግን እምድባብኬ ፋረድባብ ዋልቃ ሳብ ይንትዬ። አቅስካንተረ ካይስካንተረ ማድባብ ኖ ይንትዬ። ይና፥ ኤድዘን ፋረድባብ የና Ꮊይራ?<verse eid="JAS 4:12"/></para>
  <para style="s1">ይንታ ማተም ጬቅጎካ እምምሳን ኤግዝምስ</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13"/>የታ “ታካ ናንከረ ሰናከረ ኦስ ዶቅድን ካተመናር አይሶቶ ዋሪ ዋልቃ ስላ ዶቅተሮቴ፥ ዛልአ ዛልኤሮቶ ብረን በችተሮቴ” የታ ጋይድባብከስ ካርስምከቴ። <verse eid="JAS 4:13"/><verse number="14" style="v" sid="JAS 4:14"/>ሰናካ ማድንደትም የታ ኤዝዳከቴ፥ የንታ ዶቅንተና Ꮊረርየረ? ዋልቃዱት Ꮊፈርሶ ኮታ ቡሪ ካይድን ኡፓግንደቴ።<note caller="-" style="x"><char style="xo" closed="false">4፡14 </char><char style="xt" closed="false"><ref loc="PRO 27:1">ካም. 27፡1</ref>። </char></note> <verse eid="JAS 4:14"/><verse number="15" style="v" sid="JAS 4:15"/>ስግስሶ ይና “ጮይስ ጋይሰኬ ዎ ዶቅሴ ኮም ናንከረ ኦኮም ይተሮቴ” የም ጋይ ዝግዝዴ። <verse eid="JAS 4:15"/><verse number="16" style="v" sid="JAS 4:16"/>የታ ማቼ ኮም ጋይዝግዝድንካ የንታ ኦትረንካ የካችካ ጋይርደቴ፥ ኮግንዳ ጬቅና ሙዳ ዳቅልዬ።<verse eid="JAS 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 4:17"/>ይና ኡርማ ሪም ይይንተንም ኤሰሮ ይዳክን ኤድ ክታ ይክሳ ነግና ጎማ ክታዘን ማዴ።<verse eid="JAS 4:17"/></para>
  <chapter eid="JAS 4"/>
  <chapter number="5" style="c" sid="JAS 5"/>
  <para style="s1">ቆልመንባብከስካንታ እምምሳን ኤግዝምስ</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1"/>ታ የታ ቆልመንባብከሶ! Ꮊድሰቶ ኤሰርከቴ፥ ዘርዚድን ማጣ የንዘን Ꮊድንኦል ፍፈረቶ ኤፍከቴ። <verse eid="JAS 5:1"/><verse number="2" style="v" sid="JAS 5:2"/>የንታ ቆልመና ሙዳ ጫፍቴ። የንታ አፍለንመረ ብልይ እችቴ። <verse eid="JAS 5:2"/><verse number="3" style="v" sid="JAS 5:3"/>የንታ ዎርቀንኬ ብረንካ ቡየርቴ፥ ቡይነረ ማርካ የንዘን ማተሬ፥ የንታ ዋሄንመረ ኖሀግንዳ አተሬ፥ ከትኬ በእንታ ሰጨንከሳር በድ ቆልማ ሳንስተቴ።<note caller="-" style="x"><char style="xo" closed="false">5፡3 </char><char style="xt" closed="false"><ref loc="MAT 6:19">ማቶ. 6፡19</ref>። </char></note> <verse eid="JAS 5:3"/><verse number="4" style="v" sid="JAS 5:4"/>ኤሰርከቴ! የንታ Ꮊምያር ስክድ Ꮊቅባብ ፍክስንባብከስካንታ ኬታ ናክን የ ናካክንኦል ይና ዎንታ ናካየቴ ጋይሰኮ ከት ፍብድንዳ ኤስምዴ፥ እስን ስክድባብከስታ ፍፍን ፍዛ ሙደንታ ጮይስና ኤሰርቴ።<note caller="-" style="x"><char style="xo" closed="false">5፡4 </char><char style="xt" closed="false"><ref loc="EXO 24:14-15">ዉት. 24፡14-15</ref>። </char></note> <verse eid="JAS 5:4"/><verse number="5" style="v" sid="JAS 5:5"/>Ꮊላ ጋይሳንደትኬ ጉርምካ ዶቀረቶ ማችካንታ ዱቼርሳን መሄንግንዳ የንታ ቡደን ደእስተቴ። <verse eid="JAS 5:5"/><verse number="6" style="v" sid="JAS 5:6"/>የም ግራክባብ ጭልንዘን ካርከካ ፋረጀቴ፥ ክትም ደይሰቴ።<verse eid="JAS 5:6"/></para>
  <para style="s1">ጮይስታ ቃስትምስ Ꮊድንቴን ዳንዳእካ ካርስ</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7"/>እስመንከስኬ ምችነንከሶ! ይና ጮይስ Ꮊተርን የለልታ ዳንዳእንካ ካርስከቴ፥ ዎንንባብ ፍጨና እርንደትምኬ ቡርንደት ዶብን Ꮊፍተርን የለልታ ዳንዳኤሮ ቦንችምሳን ፍጨንታ አፍን ካርዝዴ። <verse eid="JAS 5:7"/><verse number="8" style="v" sid="JAS 5:8"/>የቴረ ኮግንዳ ዳንዳእከቴ፥ ጮይስታ Ꮊድንታ ሰጨና የልሳንካንታ Ꮊድን ጉርምካ ዳእከቴ።<verse eid="JAS 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9"/>እስመንከስኬ ምችነንከሶ! የንተረዘን ፋረድምተራክንግንዳ ክክ ክክ Ꮊይአልቅመቴ፥ ይና ፋረድባብ Ꮊድን ሰጫ የልቴ። <verse eid="JAS 5:9"/><verse number="10" style="v" sid="JAS 5:10"/>እስመንከስኬ ምችነንከሶ፥ ጮይስታ ላምንካ ሳብዘንካ ኤሰርሶ ኬዛቅባብከስ ማጠንም ዳንዳእካ ተይንተካ ካምስ ከት ማቻን ኤስከቴ። <verse eid="JAS 5:10"/><verse number="11" style="v" sid="JAS 5:11"/>ጉጅሰረ ከትከነም ዳንዳእንካ ዳቅስባብከስም “አንጅምስባብከሰኬ” ከትም ጋይዶቴ፥ እዮብ፥ Ꮊስግንዳ ክት ዳንዳእሳናንከረ የታ ኤሰርተቴ። ጮይሰረ በእንተዘን ክትካንታ ይሳንደትም ኡርማ ሪ የታ ሰተቴ፥ ኮከረ ጮይስ ቡዳርካ አተርድባብኬ አጨርድባብ ማትንተንም የታ ሰተቴ።<note caller="-" style="x"><char style="xo" closed="false">5፡11 </char><char style="xt" closed="false"><ref loc="JOB 1:21-22">ኢዮብ 1፡21-22</ref>፤ <ref loc="JOB 2:10">2፡10</ref>፤ <ref loc="PSA 103:8">የቺ 103፡8</ref>። </char></note><verse eid="JAS 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12"/>እስመንከስኬ ምችነንከሶ! ሙደንዘንከረ ስግ ጭለከረ ፍጨካ አነረ አብ Ꮊራ ሪከረ Ꮊይ ጫቀቴ፥ የንታ ኬዘና ማዴ የ ጋይሰ ዶፈንካ ማዴ ጋይከቴ፥ ማታይንዳ ኮት ማቼረ ዶፈንካ ማታዬ ጋይከቴ፥ ኩን ማታክን ማቼ የንዘን ፋረድምዴ።<note caller="-" style="x"><char style="xo" closed="false">5፡12 </char><char style="xt" closed="false"><ref loc="MAT 5:34-37">ማቶ. 5፡34-37</ref>። </char></note><verse eid="JAS 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13"/>የንታ ዎክያር ማጣ የልስባብ ኤድ ዶቅሴ ክት ምክሳ፥ ጉርምስባብ ኤደረ ዶቅሴ ሳብም ጋለተሮ የቺን ክት የቻ። <verse eid="JAS 5:13"/><verse number="14" style="v" sid="JAS 5:14"/>የንታ ዎክያር ሰቀርስባብ ኤድ ዶቅሴ ምክስ ኤሄናር ጋልተንከስም ይንደር ክት ኤላ፥ ከቴረ Ꮊዘርስባብዘን ጮይስ ላምካ ዛይት ሳይሶ ክትካንታ ከት ምክሳ።<note caller="-" style="x"><char style="xo" closed="false">5፡14 </char><char style="xt" closed="false"><ref loc="MRK 6:13">ማር. 6፡13</ref>። </char></note> <verse eid="JAS 5:14"/><verse number="15" style="v" sid="JAS 5:15"/>ኮግንደና ኣመንዘን የድምሳንዳ ምክስና Ꮊዝምባብም ፋእዝዴ፥ ጮይሰረ Ꮊዝምንዘንካ ክትም ፋጅዴ፥ ክት ፍክሳን ጎማ ዶቅሰረ ነጋ ክትካንታ ጋይምተሬ። <verse eid="JAS 5:15"/><verse number="16" style="v" sid="JAS 5:16"/>ኮካንታ የ ፋጭተርንግንዳ የንታ ጎመን ክክ ክክ ፋጭከቴ፥ ዋልቃ ዋልቀነረ አብንካንታ ክት ምክሳ፥ ጭል ኤታ ምክስና በድ አፍ Ꮊፍስዝድንዳ አንድር ዎልቃ ዶቅዴ። <verse eid="JAS 5:16"/><verse number="17" style="v" sid="JAS 5:17"/>ኤልያስ ዎግንዳ ኤድ Ꮊቄ፥ ኬዛርንካ ማቼ ዶብ ቃንዳክንግንዳ ዳቅስሶ ክት ምክሳንደትካ ማኬን ስለኬ ባንግካ ፍጨዘን Ꮊረሰነረ ዶብ ቃናክዬ።<note caller="-" style="x"><char style="xo" closed="false">5፡17 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1 ባንቺ. 17፡1</ref>፤ <ref loc="1KI 18:1">18፡1</ref>። </char></note> <verse eid="JAS 5:17"/><verse number="18" style="v" sid="JAS 5:18"/>አነታ ክት ምክሳንደትካ ጭለና ዶብን እምሴ፥ ፍጨንዘነረ ባቅለና አፍን እምሴ።<note caller="-" style="x"><char style="xo" closed="false">5፡18 </char><char style="xt" closed="false"><ref loc="1KI 1:4-45">1 ባንቺ. 1፡4-45</ref>። </char></note><verse eid="JAS 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19"/>እስመንከስኬ ምችነንከሶ! የንታርንካ ዋልቀና ዶፈን ጎግንዘንካ ክት ዉተደኬ አብና ዶፈን ጎግንዘን ክትም ማዝደ፥ <verse eid="JAS 5:19"/><verse number="20" style="v" sid="JAS 5:20"/>ጎመንባብም ክት ኮተርሳን ጎግንዘንካ ይንታ ማስንካ፥ ጎመንባብታ ሰንፔን ደእያርንካ አቅዝድንደትግንደኬ ክታ በድ ጎመንተረ ነገትቼን ክትካንታ Ꮊፍስዝድንደትም ክት ኤሳ።<note caller="-" style="x"><char style="xo" closed="false">5፡20 </char><char style="xt" closed="false"><ref loc="PRO 10:12">ካም. 10፡12</ref>፤ <ref loc="1PE 4:8">1 ጴጥ. 4፡8</ref>። </char></note><verse eid="JAS 5:20"/></para>
  <chapter eid="JAS 5"/>
</usx>
