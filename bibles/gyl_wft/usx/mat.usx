<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Gayil New Testament</book>
  <para style="h">ማቶስ</para>
  <para style="toc1">ማቶስ ጻፍሳንዳ ዎንታ ጮይስን የሱስ ክርስቶስታ ክላ ኬዛ</para>
  <para style="toc2">ማቶስ</para>
  <para style="toc3">ማቶ.</para>
  <para style="mt1">ማቶስ ጻፍሳንዳ</para>
  <para style="mt2">ዎንታ ጮይስን የሱስ ክርስቶስታ ክላ ኬዛ</para>
  <para style="imt1">አርድንታ</para>
  <para style="ip">ማቶሰታ ክላ ኬዘና፥ የሱሰታ Ꮊድንተንታ ጉርምና እርምሶ ክትጎካ ኬዝምሳንዳ አቅስንባብ ክታ ማትንተንምከ ሳብ ኤና እሪ ጫቀናር ዎርሰንከስካንታ ይ እምሳን Ꮊድን ጉርምንታ ቃለን ክት ቦጃንደረ ክትጎካ ማትንተን ኬዝድንደትም ክላ ኬዘን የጃንዴ። ና ኮነረ ክላ ኬዘና የሱስ ከታ ዎክያር አጠርሶ ክት ጋጵሳንዳ አይሁድንከስካንታ Ꮊክ ማታክናና፥ ፍጫ ሙደንካንተረ ዎሬ።</para>
  <para style="ip">ማቶሰታ ክላ ኬዘና በድ ኤግዝምካ ግግስምሳን ማጻፈ፥ የሱሰታ አጥርንዘንካ የድስንደትከ ክታ ስእርንጎከ ክታ ጰጭምንጎካ ኬዛንደታ ቡር፥ ገሊላ ፍጨናር ክት ቦጃን ሳባክን፥ ኤስስንምከ ክታ ፋችስ ፍክስንም ኬዝዴ። ኮታዘንከረ ኦስ የሱስ ገሊላ ፍጨናርንካ የሩሳሌም ካተመናር ክታ አይንተንምከ ኮ ፍጫሙደንዘን ክት ዶቅሳን ስለንታ በእንታ ሳምንትን የለልታ ማቻን ሪንከስጎካ ኬዝዴ፥ ከታኬና ሪንከሰረ ክታ ሮከርንም፥ ክታ ደእንምከ ክታ ደእናርንካ አምንተንም የጃንዴ።</para>
  <para style="ip">ኮና ክላ ኬዘና የሱሰም፥ ሳብታ ህግን ቡልካንታ ገችታ ኤራ ዶቅድባብከ ሳብታ ባንችምንጎካ ኤስዝድባብ አንድር ኤስስንባብ ማስሶ ክትም ሰጅዴ። ክታ ኤስስናርንካ በድንከስና Ꮊክ Ꮊክ ጎግካ ግግስምሳንዳ ዶንቅ ካርዘን ካስምዴ፥</para>
  <para style="ip">1. ሳብ ባንችማር ኤድንከስታ እዛ፥ ፍክስ፥ ሸን፥ ነግምዳክንደትከ በእንታ ኡዋንን ኤዝድንግንዳ ይስዝድንዳ ገቸንዘን ሳባክና (የድይ 5-7)።</para>
  <para style="ip">2. ታመከ ቃስተን የሱሰታ ካርንካ ጎርስምድባብከስ ክላ ኬዘንም ሳባክካንታ ኦይትምድንᎺይካ ከትካንታ እምምሳን ክተንከስ (የድይ 10)።</para>
  <para style="ip">3. ሳብታ ባንችምንጎካ ኬዝምሳን Ꮊክ Ꮊክ ካምስንከስ (የድይ 13)።</para>
  <para style="ip">4. የሱሰታ ካርንካ ጎርስምንጎካ ኤስስን ኤስዝድን ኤስና (የድይ 18)።</para>
  <para style="ip">5. ታ ስለንታ በእንተንጎከ ሳብታ ባንችምንታ Ꮊድንተንጎካ እምምሳን ኤስስ (የድይ 24-25)።</para>
  <para style="iot">ማጻፍን ኮትኮታ ሙዳ የድንተና</para>
  <para style="io1">የሱስ ክርስቶስታ ሱሰንታ ጫንተከ ክታ አጥርና <char style="ior">(<ref loc="MAT 1:1-2:23">1፡1—2፡23</ref>) </char></para>
  <para style="io1">ስእስንባብ ዮሀንሰታ ፍክስና <char style="ior">(<ref loc="MAT 3:1-12">3፡1-12</ref>) </char></para>
  <para style="io1">የሱሰታ ስእርንከ ጰጭምንካ <char style="ior">(<ref loc="MAT 3:13-4:11">3፡13—4፡11</ref>) </char></para>
  <para style="io1">የሱሰታ ፍክስ ገሊላ ፍጨናር <char style="ior">(<ref loc="MAT 4:12-18:35">4፡12—18፡35</ref>)</char></para>
  <para style="io1">ገሊላ ፍጨናርንካ የሩሳሌም ካተመናር Ꮊድና <char style="ior">(<ref loc="MAT 19:1-20:34">19፡1—20፡34</ref>) </char></para>
  <para style="io1">በእንታ ሳምንትናር የሩሳሌም ካተመናርከ ኮታ ሞረናር <char style="ior">(<ref loc="MAT 21:1-27:66">21፡1—27፡66</ref>) </char></para>
  <para style="io1">ዎንታ ጮይስንታ ደእናርንካ አምንተንከከ ይንታ ካርንካ ጎርስምድባብከስካንታ መያ ክታ ማትና <char style="ior">(<ref loc="MAT 28:1-20">28፡1-20</ref>) </char></para>
  <chapter number="1" style="c" sid="MAT 1"/>
  <para style="s1">የሱስ ክርስቶስታ አጥርንታ Ꮊድንተና</para>
  <para style="r">(<ref loc="LUK 3:23-38">ሉቃ. 3፡23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1"/>ዳውትተከ አብራሀመታ ሱሳ ማችባብ የሱስ ክርስቶሰታ አጥርንታ ኮችንከስ ኬኔ።<verse eid="MAT 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2"/>አብራሀም ይሳቀም አጬ፥ ይሳቅ ያይቆበም አጬ፥ ያይቆብ ይሁደምከ እስመንንከስም አጬ፥ <verse eid="MAT 1:2"/><verse number="3" style="v" sid="MAT 1:3"/>ይሁዳ ፋረስምኬ ዛሬም ትእማር ጋይምድን ኤተንንዘንካ አጬ፥ ፋርስ ሀስሮንም አጬ፥ ሄስሮንመረ አራምንም አጬ፥ <verse eid="MAT 1:3"/><verse number="4" style="v" sid="MAT 1:4"/>አራም አምናዳብም አጬ፥ አምናዳብ ነአሶንም አጬ ነአሶነረ ሰልሞንም አጬ፥ <verse eid="MAT 1:4"/><verse number="5" style="v" sid="MAT 1:5"/>ሰልሞነረ ቦኤዝም ረአብ ጋይምድን ኤተንዘንካ አጬ፥ ቦኤዝ እዮበድም ሩት ጋይምድን ኤተንዘንካ አጬ፥ እዮበደረ እሰይም አጬ፥ <verse eid="MAT 1:5"/><verse number="6" style="v" sid="MAT 1:6"/>እሰየረ ባንችን ዳዊተም አጬ፥</para>
  <para style="p" vid="MAT 1:6">ባንችን ዳውተረ ኦርዮታ ኬነንዘንካ ሰሎሞንም አጬ፥ <verse eid="MAT 1:6"/><verse number="7" style="v" sid="MAT 1:7"/>ሰሎሞነረ ሮብአምም አጬ፥ ሮብአመረ አብያም አጬ፥ አብየረ አሳፍም አጬ፥ <verse eid="MAT 1:7"/><verse number="8" style="v" sid="MAT 1:8"/>አሳፈረ እዮሳፈጥም አጬ፥ እዮሳፈጠረ እዮራምም አጬ፥ እዮራመረ ኦዝያንም አጬ፥ <verse eid="MAT 1:8"/><verse number="9" style="v" sid="MAT 1:9"/>ኦዛነረ እዮአታምም አጬ፥ እዮአታመረ አካዝም አጬ፥ አካዘረ ህዝቅያሰም አጬ፥ <verse eid="MAT 1:9"/><verse number="10" style="v" sid="MAT 1:10"/>ህዝቅያሰረ ምናሰም አጬ፥ ምናሰረ አሞጽም አጬ፥ አሞጸረ እዮስያሰም አጬ፥<verse eid="MAT 1:10"/></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 1:11"/>እዮስያሰረ እስራኤል ዎርሰና ባብሎን ፍጨናሪ ዎእስት ከት ተይምሳን ስለናር እኮንያንምከ ክታ እስመንከስም አጬ፥<verse eid="MAT 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12"/>ባብሎን ፍጨናርንካ ከት ማቻን ቡር እኮንያን ሰላትያልም አጬ፥ ሰላትያለረ ዘሩባበልም አጬ፥ <verse eid="MAT 1:12"/><verse number="13" style="v" sid="MAT 1:13"/>ዘሩባበለረ አብድዩም አጬ፥ አብድዮረ ኤልያቀም አጬ፥ ኤልያቀረ አዞርም አጬ፥ <verse eid="MAT 1:13"/><verse number="14" style="v" sid="MAT 1:14"/>አዞረረ ሳዶቀም አጬ፥ ሶዶቀረ አክምም አጬ፥ አክመረ ኤልዮድም አጬ፥ <verse eid="MAT 1:14"/><verse number="15" style="v" sid="MAT 1:15"/>ኤልዮደረ አልዓዛርም አጬ፥ አልዓዛረረ ማታንም አጬ፥ ማታነረ ያይቆበም አጬ፥ <verse eid="MAT 1:15"/><verse number="16" style="v" sid="MAT 1:16"/>ያይቆበረ ክርስቶስ ጋይምስባብ የሱሰም አጫን ማራመም ሶርስባብ ዮሴፍም አጬ።<note caller="+" style="f"><char style="fr" closed="false">1፡16 </char><char style="ft" closed="false">መስይ ጋይንትና ሳይምስባብ ጋይንትዬ ናኮና ክርስቶስ ጋይንትዬ፥ </char></note><verse eid="MAT 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17"/>ይና አብራሀመዘንካ ዳዊት የለልታ ታሜከ ኦይድ አጥሪ፥ ዳውትዘንካ ባብሎን ፍጨናር ዎእስምት ተይምሳን የለልታ ታሜከ ኦይድ አጥሪ፥ ባብሎን ፍጨናር ዎእስምት ተይምሳንዘንካ ክርስቶስ አጥርምተርን የለልታ ታሜከ ኦይድ አጥርዬ።<verse eid="MAT 1:17"/></para>
  <para style="s1">የሱስ ክርስቶሰታ አጥርና</para>
  <para style="r">(<ref loc="LUK 2:1-7">ሉቃ. 2፡1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18"/>የሱስ ክርስቶሰታ አጥርና ኮግንዴ፥ እንደና ማራመረ ዮሴፍካንታ ሶርምሶ ኮት ዶቅድንካ፥ አⷝነካ የላክዶቆ አያን ጭልንካ ስርሶ Ꮊፈርሴ። <verse eid="MAT 1:18"/><verse number="19" style="v" sid="MAT 1:19"/>ሶርስባብ ዮሰፍ ላቅም ኤድ ይ ማቻንኦላር፥ ማራመም ኤታ እሪ ኦስንስካንታ ዝጋክዬ፥ ኮካንታ ኖ ኮትም ዛቅካንታ ገቀርሴ።<verse eid="MAT 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20"/>ኬዛር ማቼ ኮም ሪን ገቅርዘን ክት ዶቅድንካ፥ ጮይስታ ክታይንች Ꮊምስካ Ꮊፈርሶ ኩን ጋይሴ፥ “ዳውተታ ሱሰና ዮሰፎ! የስ ሶርሳን ማራመረ ኮት ስርሳንዳ አያን ጭልንካ ማቻንካንታ፥ ኮትም እንቻካንታ Ꮊይ ጳሴ። <verse eid="MAT 1:20"/><verse number="21" style="v" sid="MAT 1:21"/>ና አⷝና ይንች አእተረ፥ ኖየረ ይንታ ዎርሰንም ከታ ጎመናርንካ አቅዝድንካንታ ክታ ላምንመረ የሱስ ጋይተረዬ”። <note caller="-" style="x"><char style="xo" closed="false">1፡21 </char><char style="xt" closed="false"><ref loc="LUK 1:31">ሉቃ. 1፡31</ref>። </char></note><verse eid="MAT 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22"/>ኮነረ ሙዳ ማቻንዳ ጮይስ ኩን ጋይሶ ሳብዘንካ ኤሰርሶ ከዝባብጎካ ኬዝምሳንዳ ቦድምድንግንዴ፥ <verse eid="MAT 1:22"/><verse number="23" style="v" sid="MAT 1:23"/>“ኮሰቸቴ፥ አንጃ ሙነክንዳ ስርተረ፥ አⷝና ይንቸረ አእተረ፤ ክታ ላምነረ ‘አማኑኤል’ ጋይምሶ ኤልምተረ” አማኑኤል ጋይንትና “ሳብ ዎንካ ክክኔ” ጋይንትዬ።<note caller="-" style="x"><char style="xo" closed="false">1፡23 </char><char style="xt" closed="false"><ref loc="ISA 7:14">ኢሳ. 7፡14</ref>። </char></note><verse eid="MAT 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24"/>ዮሴፍ ግንእናርንካ ይ ንግዛንደትካ፥ ጮይስታ ክታይንችና ክትሳንግንዳ ማራመም ይንታ ማና ማስካንታ ይንታ ኤር ተይ Ꮊዴ።<verse eid="MAT 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 1:25"/>ማታጋካ ዳት፥ ና ይንታ ይንችንም ኮት አእተርን የለልታ ኮትም የላክዬ፥ ክታ ላምንመረ የሱስ ጋይሶ ኤልሴ።<note caller="+" style="f"><char style="fr" closed="false">1፡25 </char><char style="ft" closed="false">ሉቃ. 2፡21፤ ኮትም ኤሳክዬ ጋይንትና ከነንከ ክስካ ማታክዬ ጋይንትዬ </char></note><verse eid="MAT 1:25"/></para>
  <chapter eid="MAT 1"/>
  <chapter number="2" style="c" sid="MAT 2"/>
  <para style="s1">ቤዝንከስም ሰድሶ ጎርስምድባብከስ Ꮊይንታ ዉትንታጎካ Ꮊድንተና</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1"/>ባንችን ሄሮድሰታ ስለናር፥ ይሁዳ ፍጨናር Ꮊፈርድን ቤተልሄም ካተመናር የሱስ አጠርሳንᎺይካ፥ ቤዝም ሰድሰኮ ጎርስምድባብከስ Ꮊይታ ዉትንታጎካ የሩሳሌም ካተመናር Ꮊደኬ። <verse eid="MAT 2:1"/><verse number="2" style="v" sid="MAT 2:2"/>“ኩነረ ጋየረኮ ኦይሰኬ፥ አይሁድንታ ባንች ማትካንታ አጠርምስባብ ኡለና Ꮊብረረ? ቤዝንም Ꮊይንታ ዉትንታጎካ ሰድሶቶ ክትም ጎዝደር Ꮊቶቴ” ጋይሰኬ።<note caller="-" style="x"><char style="xo" closed="false">2፡2 </char><char style="xt" closed="false"><ref loc="JER 23:5">ኤር. 23፡5</ref>፤ <ref loc="ZEC 9:9">ዘካ. 9፡9</ref>፤ <ref loc="NUM 24:17">ፋይ. 24፡17</ref>። </char></note><verse eid="MAT 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3"/>ባንችን ሄሮድስ ኮሪን ይ ኤሰርሳንደትካ ገቅሴ። የሩሳሌም ካተማ ኤድንከሰረ ሙዳ ክትካ ክክን ገቅሰኬ። <verse eid="MAT 2:3"/><verse number="4" style="v" sid="MAT 2:4"/>ቀሰንከስም ገችዝድባብከስም ሙደንምከ ሙሴታ ህግንም ኤስዝድባብከስም ሳንስሶ ክርስቶስ Ꮊብር ክት አጠርሳናንከረ ከትም ኦይሰኬ።<verse eid="MAT 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5"/>ከተረ፥ “ሳብዘንካ ኤሰርሶ ከዛቅባብካ ኩን ጋይድንዳ ቤሪካ ጻፍምሳንካንታ፥ ክርስቶስ አጥርምድንዳ ይሁዳ ፍጫር፥ ቤተልሄም ካተመናሬ፥<verse eid="MAT 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6"/>“ ‘ይሁዳ ፍጨናር Ꮊፈርድንዳ በተልሄሞ!<note caller="-" style="x"><char style="xo" closed="false">2፡6 </char><char style="xt" closed="false"><ref loc="MIC 5:2">ሚክ. 5፡2</ref>። </char></note></para>
  <para style="q2" vid="MAT 2:6">እስታ ዎርሰን እስራኤልም ካርስተርባብከ ጎርስተርባብ የሳርንካ ዉድንካንታ፥</para>
  <para style="q2" vid="MAT 2:6">ይሁዳር ዶቅድን አንድር ካተመንከዘንካ Ꮊረከረ የና ቶግዳካዬ’ ” ኩንጋየሮ ከትካንታ ማስሴ።<note caller="-" style="x"><char style="xo" closed="false">2፡6 </char><char style="xt" closed="false"><ref loc="MIC 5:2">ሚክ. 5፡2</ref>። </char></note><verse eid="MAT 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7"/>ኮታ ቡሪ ሄሮድስ ቤዝንከስም ሰድሰኮ ጎርስምድባብከስምከ ኤድንከስም ካቼካ ኤልሶ፥ ቤዝና ሰድምሳን ገታ ሰጨን ኦይስሶ ኤሴ፥ <verse eid="MAT 2:7"/><verse number="8" style="v" sid="MAT 2:8"/>ኩን ጋይሰረ በተሌሄማር ከትም ኦይቼ፥ “አይሰቶ፥ ኡለንጎካ ኡርስት ኦይስከቴ፥ የᎺፍሳንደትከረ እተረ አይስቶ ክትካንታ እ ጎስተርንግንዳ Ꮊድሰቶ እካንታ ኬዝከቴ” ጋይሴ።<verse eid="MAT 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9"/>ከተረ ባንችንታ ኬዘንም ኤሰርሳንግንዳ ዉትሰኮ አይሰኬ፥ ይና! Ꮊይንታ ዉትንታጎካ ከት ሰዳን ቤዝና ኡለና ዶቅድን ካርዘን ዎእተርን የለልታ፥ ከታ እሪ አየሮ ከትም ጎርዝድ Ꮊቄ። <verse eid="MAT 2:9"/><verse number="10" style="v" sid="MAT 2:10"/>ቤዝና ዎእሳንደትም ከታ ይ ሰዳንደትካ አንድር ጉርምሰኬ፥ <verse eid="MAT 2:10"/><verse number="11" style="v" sid="MAT 2:11"/>ኤሄናረረ አርድሰኮ ኡለንም እንደን ማራመካ ክክን ሰደኬ፥ ጉፕን ጋይሰኮ ክትካንታ ጎስትሰኬ፥ ከታ ይንታ ሳጥንንከስም ፎችሰኮ ዎርቀን፥ እጣንንምከ ሳየርስንካ ኡርማ ዎዝድን እመንም እምሰኬ።<verse eid="MAT 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 2:12"/>ሄሮድሰደረረ ከት ማዳክንግንዳ ሳብ Ꮊምስካ ከትም ኤግዝምሳንካንታ፥ አብ ጎግካ ከታ ይንታ ፍጨናር ማትሰኮ አይሰኬ።<verse eid="MAT 2:12"/></para>
  <para style="s1">ኡለን የድሰኮ ግብጽ ፍጨናር ከታ አጥምና</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13"/>ቤዝንከስም ሰድሶ ጎርስምድባብከስ አይሳንደታ ቡር፥ ጮይስታ ክታይንችና ዮሰፍካንታ Ꮊምስካ መያ ማትሶ፥ “ሄሮድስ ኡለንም ደይሳካንታ ዝግድንኦል፥ አምሰዮ ኡለንም እንደንካ ክክን የድሰዮ ግብጽ ፍጨናር አይሳዮ አጥምካ፥ እ የስም ኬዝተርን የለልታ ኮታር ዶእካ” ክትም ጋይሴ። <verse eid="MAT 2:13"/><verse number="14" style="v" sid="MAT 2:14"/>ኮካንታ ዮሴፈረ ሶይትካ አምስንደትከ፥ ኡለንም እንደንካ ክክን የድሶ፥ ግብጽ ፍጨናር አይሴ። <verse eid="MAT 2:14"/><verse number="15" style="v" sid="MAT 2:15"/>ኮታረረ ሄሮድስ ደእተርን የለልታ ዶቅሴ፥ ኮነረ ማቻንዳ ሳብዘንካ ኤስርሶ ኬዛᎺቅባብካ “እስታ ይንችን ግብጽ ፍጨናርንካ ኤልሳቴ” ጋይሳን ጮይስታ ቃለና ቦድምድንግንዴ።<note caller="-" style="x"><char style="xo" closed="false">2፡15 </char><char style="xt" closed="false"><ref loc="HOS 11:1">ሆሴ. 11፡1</ref>። </char></note><verse eid="MAT 2:15"/></para>
  <para style="s1">ሄሮድስ ኡለንከስም ደይስስና</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16"/>ኮታ ቡሪ ሄሮድስ፥ ቤዝንከስም ሰድሶ ጎርስምድባብከስ ክትም ከት ገስሳንደትም ኖ ይ ኤሳንደትግንዳ፥ አንድር ኖ ዋጬ፥ ቤተሌሄም ካተመናርከ ኮታ ካንተንከረ ዶቅድን ሞረንከስ ሙደናር ይንታ ዳምንባብከስም ኦይትሶ፥ ቤዝንም ሰድሰኮ ጎርስምድባብከዘንካ ይ ኤሳንዴት ግንዳ፥ በተሌሄማርኬ ኮታ ካንተካ ዶቅድን ሞረንከሳር ከት አጠርስንካ ቃስተን ስላ ማችባብከስምኬ ኬታ ታመካ ዶቅድን አⷝና ይንች ሙደንም ኖ ደይስሴ። <verse eid="MAT 2:16"/><verse number="17" style="v" sid="MAT 2:17"/>ኮታይካ፥ ሳብዘንካ ኤሰርሶ ኬዝባብ ኤርማሰካ፥<verse eid="MAT 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18"/>“ራሄል ይንታ ይንችንከስካንታ ኤብድንካ፥</para>
  <para style="q2" vid="MAT 2:18">አንድር ሞርእኬ ኤፍካ ራማ ካተመናር ኤስምሴ፥</para>
  <para style="q1" vid="MAT 2:18">ኮታ ይንችንከሰረ ደእሳንኦል ዳንዳእካንታ ና ማታክዬ” ኩን ጋይምሶ ኬዝምሳንዳ ቤርና ቦድምሴ።<note caller="-" style="x"><char style="xo" closed="false">2፡18 </char><char style="xt" closed="false"><ref loc="JER 31:15">ኤር. 31፡15</ref>። </char></note><verse eid="MAT 2:18"/></para>
  <para style="s1">ግብጽ ፍጨናርንካ ፈንክ ናዝረት ካተመናር ማትና</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19"/>ሄሮድስ ደእሳን ቡር ጮይስታ ክታይንችና ግብጻር ዮሰፍካንታ Ꮊምስካ መያ ማትሶ፥ <verse eid="MAT 2:19"/><verse number="20" style="v" sid="MAT 2:20"/>“ኡለን ደይሳካንታ ዝግድን ኤድንከስ ደእሳንካንታ፥ አምሳዮ ኡለን እንደንካ ክክን የድሳዮ፥ እስራኤል ፍጨናር አይካ” ጋይሴ። <verse eid="MAT 2:20"/><verse number="21" style="v" sid="MAT 2:21"/>ዮሰፈረ አምሶ ኡለንም እንደንካ ክክን የድሶ፥ እስራኤል ፍጨናር ማት Ꮊዴ።<verse eid="MAT 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 2:22"/>ኬዛርካ ማቼ አርኬላዎስ ይንታ ባቤን ሄሮድሰታ ካርናር ይሁዳ ፍጨንዘን ክት ባንችምሳን ይ ኤሰርሳንደትካ፥ ዮሰፍ ኮታር አይካንታ ጳሴ። ማችንከረ Ꮊምስካ ክትካንታ ክታ እምምሳንጎካ፥ ገሊላ ፍጨናር አይሴ። <verse eid="MAT 2:22"/><verse number="23" style="v" sid="MAT 2:23"/>“ናዝረት ፍጨናርንክንባቤ ጋይምተሬ” ጋይምሶ ሳብዘንካ ኤስርሶ ኬዛቅባብከስካ ኬዝምሳንዳ ቦድምድንግንዳ ናዝረት ጋይምድን ካተመናር Ꮊድሶ ዶቅሴ።<note caller="-" style="x"><char style="xo" closed="false">2፡23 </char><char style="xt" closed="false"><ref loc="ISA 11:1">ኢሳ. 11፡1</ref>፤ <ref loc="MRK 1:24">ማር. 1፡24</ref>፤ <ref loc="LUK 2:39">ሉቃ. 2፡39</ref>፤ <ref loc="JHN 1:45">ዮሀ. 1፡45</ref>። </char></note><verse eid="MAT 2:23"/></para>
  <chapter eid="MAT 2"/>
  <chapter number="3" style="c" sid="MAT 3"/>
  <para style="s1">ስእስንባብ ዮሀንሰታ ሳባክና</para>
  <para style="r">(<ref loc="MRK 1:1-8">ማር. 1፡1-8</ref>፤ <ref loc="LUK 3:1-18">ሉቃ. 3፡1-18</ref>፤ <ref loc="JHN 1:19-28">ዮሀ. 1፡19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1"/>ኮትᎺይካ ስእስንባብ ዮሀንስ ይሁዳ ዶቅድን ዴል ቆቼናርጎካ ሳባከሮ Ꮊዴ። <verse eid="MAT 3:1"/><verse number="2" style="v" sid="MAT 3:2"/>ኖ ኤስዝደረ “ጭላ ባንችምና የልሳንካንታ የንታ ጎማ ፍክስን ዎይስከቴ” ጋይድ Ꮊቄ።<note caller="-" style="x"><char style="xo" closed="false">3፡2 </char><char style="xt" closed="false"><ref loc="MAT 4:17">ማቶ. 4፡17</ref>፤ <ref loc="MRK 1:15">ማር. 1፡15</ref>። </char></note><verse eid="MAT 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 3:3"/>“ ‘ጮይስንታ ጎግን ግግስከቴ፥</para>
  <para style="q2" vid="MAT 3:3">ሉላ ማስሶ ኡርስከቴ!’ ጋየሮ ዴል ቆቼናር ፍብድን ኤታ ኡፍስ” <note caller="-" style="x"><char style="xo" closed="false">3፡3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">ኢሳ. 40፡3</ref>። </char></note></para>
  <para style="m" vid="MAT 3:3">ጋይሶ ሳብዘንካ ኤስርሶ ኬዝባብ ኢስያስ ኬዛንዳ ክት ዮሀንስጎካ Ꮊቄ።<verse eid="MAT 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4"/>ዮሀንሰታ አፍለና ግመልታ ስጭዘንካ ፍክስምሳንዳ Ꮊቄ፥ ይንታ ዎክጫምናረረ ጋመዘንካ ኡርሰርሳን ሳቅ ሶቆርድ Ꮊቄ፥ ክታ እችምነረ ኤይከንከ ባእተታ ኩር Ꮊቄ፥<note caller="-" style="x"><char style="xo" closed="false">3፡4 </char><char style="xt" closed="false"><ref loc="2KI 1:8">2 ባንቺ. 1፡8</ref>፤ <ref loc="ZEC 13:4">ዘካ. 13፡4</ref>፤ <ref loc="LEV 11:22">ሌዊ. 11፡22</ref>። </char></note> <verse eid="MAT 3:4"/><verse number="5" style="v" sid="MAT 3:5"/>ኮታይካ የሩሳሌም ካተመናርኬ ይሁዳር ዶቅድን ፍጨናርንካ፥ ዮርዳኖስ ሎቀንታ ካንተካ ዶቅድን ፍጫ ሙደናርንካ ኤድንከስ ዮሀንሰደር Ꮊድ Ꮊቀኬ። <verse eid="MAT 3:5"/><verse number="6" style="v" sid="MAT 3:6"/>ኬታ ይንታ ጎመንመረ ቡጨረኮ፥ ዮርዳኖስ ሎቀናር ዮሀንሰታ አንካ ስኤርድ Ꮊቀኬ።<verse eid="MAT 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7"/>ኬዛርካ ማቼ፥ ዮሀንስ ፈረሳውያን ኤድንከሳርንከ ሰዶቃውያን ኤድንከሳርንካ በድንከስ ስእርካንታ ክደረ ኬት Ꮊድንካ ይ ሰዳንደትካ፥ “የታ ጉን ፉይንታ ይንችንከሶ! Ꮊድን ሳብታ ዋጭንዘንካ የ ሱርተርንግንዳ Ꮊይ የም ኤግዝምሳራ?<note caller="-" style="x"><char style="xo" closed="false">3፡7 </char><char style="xt" closed="false"><ref loc="MAT 12:34">ማቶ. 12፡34</ref>፤ <ref loc="MAT 23:33">23፡33</ref>። </char></note> <verse eid="MAT 3:7"/><verse number="8" style="v" sid="MAT 3:8"/>ይና የንታ ጎማፍክስን ዎይስን ሰችዝድን ፍክስን ፍክስከቴ። <verse eid="MAT 3:8"/><verse number="9" style="v" sid="MAT 3:9"/>‘ዎታ አብራሀመታ ይንቾቴ’ ጋይንተካ የ ሱርድን የንደር Ꮊይካማ፥ ሳብ ከትኬ ሰይንንከሳርንካ ክት አብራሀምካንታ ይንች አምስካንታ ማዴ እታ የም ጋይድቴ።<note caller="-" style="x"><char style="xo" closed="false">3፡9 </char><char style="xt" closed="false"><ref loc="JHN 8:33">ዮሀ. 8፡33</ref>። </char></note> <verse eid="MAT 3:9"/><verse number="10" style="v" sid="MAT 3:10"/>ይና ታ ማቼ ካልተና Ꮊቀንም ፋክካንታ ጎይናር ግግምቴ። ኮካንታ ኡርማ አፍ ኡዝዳክን Ꮊቃ ሙደና ፋክምሶ ኖሄናር ኦይትምዴ።<note caller="-" style="x"><char style="xo" closed="false">3፡10 </char><char style="xt" closed="false"><ref loc="MAT 7:19">ማቶ. 7፡19</ref>። </char></note> <verse eid="MAT 3:10"/><verse number="11" style="v" sid="MAT 3:11"/>ይና፥ እታ የ ጎማ ፍክስን ዎይስዝድንግንዳ ሎቀካ የም ስእድቴ፥ እስታ ቡርጎካ Ꮊድባብ ማቸ አያን ጭልንከ ኖሄካ የም ስእተረ፥ ኖ እዘንካ አንድር ስገዴ፥ እታ ክታ ዱትንታ ጫመን ዎራ ባላካንታ ዝግዝድባብ ካይቴ። <verse eid="MAT 3:11"/><verse number="12" style="v" sid="MAT 3:12"/>ጋልደጵነረ ክታ አንናሬ። ኖየረ ይንታ ቆይደንም ቦድሶ ኡርስተሬ። ይንታ ዘርግንመረ ቡለናር ኦይተሬ፥ ምሰንም ማቼ ካይዳክን ኖሄካ አችዝዴ” ከደር ጋይሴ።<verse eid="MAT 3:12"/></para>
  <para style="s1">የሱሰታ ስእርና</para>
  <para style="r">(<ref loc="MRK 1:9-11">ማር. 1፡9-11</ref>፤ <ref loc="LUK 3:21-22">ሉቃ. 3፡21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13"/>ኮታይካ የሱስ ዮሀንሰታ አንያር ስእርካንታ፥ ገሊላ ፍጨናርንካ ዮርዳኖስ ሎቀናር Ꮊዴ። <verse eid="MAT 3:13"/><verse number="14" style="v" sid="MAT 3:14"/>ዮሀንሰረ “ኮና ማታዬ፥ እታ የስታ አንያር ስእር እም ዝግዝድንካ፥ Ꮊስግንደስ የና እዝደር Ꮊዳ!” ጋየሮ ማር ክትም የጄ።<verse eid="MAT 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15"/>የሱስ ማቼ “ጭለትቼንታ ፍክስን ሙዳ ኮግንደካ ቦድ ዎም ዝግዝድንካንታ፥ ታ ዛእካ፥ ኮግንዳ ኩን ማታ” ጋይሶ ክትካንታ ማስሴ። ዮሀንሰረ ክታ ጋይተንካ ኤእሶ የሱሰም ስእሴ። <verse eid="MAT 3:15"/><verse number="16" style="v" sid="MAT 3:16"/>የሱሰረ ስኤርሶ ሳነካ ሎቀናርንካ ክት ዉተዳንግንዳ ጭላ ፎችምሴ፥ ሳብታ አያንነረ ዎሌታ ካምስካ Ꮊንቸርሶ የሱሰዘን ዶቅድንካ ሰዴ። <verse eid="MAT 3:16"/><verse number="17" style="v" sid="MAT 3:17"/>ኮታይካ “ይና፥ እታ ክትካ እ ጉርምድባብኬ እ ሶልምድባብ እስታ ይንችና ኖ ኮኔ” ጋይድን ኡፍስ ጭላርንካ ኤስምሴ።<note caller="-" style="x"><char style="xo" closed="false">3፡17 </char><char style="xt" closed="false"><ref loc="GEN 22:2">ፍዝ. 22፡2</ref>፤ <ref loc="PSA 2:7">የቺ 2፡7</ref>፤ <ref loc="ISA 42:1">ኢሳ. 42፡1</ref>፤ <ref loc="MAT 12:18">ማቶ. 12፡18</ref>፤ <ref loc="MAT 17:5">17፡5</ref>፤ <ref loc="MRK 1:11">ማር. 1፡11</ref>፤ <ref loc="LUK 9:35">ሉቃ. 9፡35</ref>። </char></note><verse eid="MAT 3:17"/></para>
  <chapter eid="MAT 3"/>
  <chapter number="4" style="c" sid="MAT 4"/>
  <para style="s1">የሱሴታ ጰጭምና</para>
  <para style="r">(<ref loc="MRK 1:12-13">ማር. 1፡12-13</ref>፤ <ref loc="LUK 4:1-13">ሉቃ. 4፡1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1"/>ኮታ ቡሪ፥ የሱስ ዳብሎሴካ ጰጭምካንታ ሳብታ አያንና ክትም ዴል ቆቼናር ተይ አይሴ።<note caller="-" style="x"><char style="xo" closed="false">4፡1 </char><char style="xt" closed="false"><ref loc="HEB 2:18">ዕብ. 2፡18</ref>፤ <ref loc="HEB 4:15">4፡15</ref>። </char></note> <verse eid="MAT 4:1"/><verse number="2" style="v" sid="MAT 4:2"/>ኮታረረ ቃስቴን ቦንዳ Ꮊየኬ፥ ቃስቴን ቦንዳ ሶይት፥ በቼካ ይ ምክሳንደታ ቡሪ ዳቀርሴ።<note caller="-" style="x"><char style="xo" closed="false">4፡2 </char><char style="xt" closed="false"><ref loc="EXO 34:28">ዉት. 34፡28</ref>፤ <ref loc="1KI 19:8">1 ባንቺ. 19፡8</ref>። </char></note> <verse eid="MAT 4:2"/><verse number="3" style="v" sid="MAT 4:3"/>ጰጨንባብ የሱሴደር Ꮊድሶ፥ “የና ሳብታ ይንች የስ ማቼ፥ ይና ኬና ሰይንንከስ እችም ማድንግንዳ ክትካ” ክትም ጋይሴ።<verse eid="MAT 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4"/>የሱስ ማቼ “ ‘ኤድ ሳብታ አፋርንካ ዉድን ቃላ ሙደንካ ዳት እችምካ Ꮊክ ዶቃዬ’ ጋይምሶ ጭል ማጻፍናር ጻፍምቴ” ኖ ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">4፡4 </char><char style="xt" closed="false"><ref loc="DEU 8:3">ካሪ. 8፡3</ref>። </char></note><verse eid="MAT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5"/>ኮታ ቡሪ፥ ዳብሎስ የሱሰም ሳብካንታ ፋስምሳን የሩሳሌም ካተመናር ተይ አይሶ ሳብታ ጭል ኤሄንታ ዱረዘን ዎይስሶ፥<note caller="-" style="x"><char style="xo" closed="false">4፡5 </char><char style="xt" closed="false"><ref loc="NEH 11:1">ነህ. 11፡1</ref>፤ <ref loc="DAN 9:24">ዳን. 9፡24</ref>። </char></note> <verse eid="MAT 4:5"/><verse number="6" style="v" sid="MAT 4:6"/>“ ‘የስታ ዱትንከስ ሰይንካ ጎሄርዳክንግንዳ፥</para>
  <para style="q1" vid="MAT 4:6">“ ‘ኬታ ይንታ አንካ የስም ዳቅስተርንግንዳ ኖይንታ ክታይንችን የስካንታ ክዴ’</para>
  <para style="q2" vid="MAT 4:6">ጋይምሶ ጭል ማጻፍናር ጻፍምሳንካንታ የና ሳብታ ይንች የስ ማቼ፥ ኮዘንካ የስታ ማተን ጩላ ማስሶ ቡከልካ” ክትም ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">4፡6 </char><char style="xt" closed="false"><ref loc="PSA 91:11-12">የቺ 91፡11-12</ref>። </char></note><verse eid="MAT 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7"/>የሱሰረ “ ‘የስታ ጮይስ ሳብንም Ꮊይ ጰጬ’ ኩን ጋይምሶ ጭል ማጻፍናር ጉጅሶ ጻፍምቴ” ክደር ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">4፡7 </char><char style="xt" closed="false"><ref loc="DEU 6:16">ካሪ. 6፡16</ref>። </char></note><verse eid="MAT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8"/>አናካርንከረ ዳብሎስ የሱሰም አንድር ጬክን ጋይሳን ገቼንዘን ዉችሶ፥ ኮ ፍጫሙደንታ ባንችንከስም ሙዳ ከታ ቦንቼንካ ክክን ክትም ሰችሶ፥ <verse eid="MAT 4:8"/><verse number="9" style="v" sid="MAT 4:9"/>“ይርክን ጋይሳዮ እካንታ የስ ጎስትሴ ኮም ሙዳ የስካንታ እምድቴ” ክደር ጋይሴ።<verse eid="MAT 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10"/>ኮትᎺይካ የሱስ “ ‘የስታ ጮይስ ሳብንካንታ ጎስትካ፥ ክትም Ꮊክ ጎይንካ!’ ጋይምሶ ጭል ማጻፍናር ጻፍምሳንካንታ የና ሰጣን ጎተርካ!” ክትም ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">4፡10 </char><char style="xt" closed="false"><ref loc="DEU 6:13">ካሪ. 6፡13</ref>። </char></note><verse eid="MAT 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11"/>ኮታቡር ዳብሎስ የሱሰም ዛቅሴ፥ ክታይንችንከሰረ Ꮊድሰኮ ክትም አሌን አልሰኬ።<verse eid="MAT 4:11"/></para>
  <para style="s1">የሱስ ይንታ ፍክስን ገሊላ ፍጨናር የድና</para>
  <para style="r">(<ref loc="MRK 1:14-15">ማር. 1፡14-15</ref>፤ <ref loc="LUK 4:14-15">ሉቃ. 4፡14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12"/>የሱስ ዮሀንሰታ ዞክርን ይ ኤሰርሳንደትካ ገሊላ ፍጨናር ማት አይሴ።<note caller="-" style="x"><char style="xo" closed="false">4፡12 </char><char style="xt" closed="false"><ref loc="MAT 14:3">ማቶ. 14፡3</ref>፤ <ref loc="MRK 6:17">ማር. 6፡17</ref>፤ <ref loc="LUK 3:19-20">ሉቃ. 3፡19-20</ref>። </char></note><verse eid="MAT 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 4:13"/>ናዝርት ካተመን ዛቅሶ፥ ዛብሎናርኬ ንፍታሌም ፍጨና ገሊላ ባሀርንታ ላማር ዶቅድን ቅፍርናሆም ካተመናር Ꮊድሶ ዶቅሴ።<note caller="-" style="x"><char style="xo" closed="false">4፡13 </char><char style="xt" closed="false"><ref loc="JHN 2:12">ዮሀ. 2፡12</ref>። </char></note><verse eid="MAT 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 4:14"/>ኮነረ ማቻንዳ፥ ሳብዘንካ ኤስርሶ ኬዛቅባብ ኢስያሰካ ኩን ጋይምሶ ቤሪካ ኬዝምሳንዳ ቦድምድንግንዴ፥<verse eid="MAT 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15"/>“ባሃርናር ተይ አይድን ጎግንከ ዮርዳኖስ ሎቀንታ ፋማ፥</para>
  <para style="q2" vid="MAT 4:15">Ꮊፈርድባብከስ ዛብሎን ፍጫ፥ ንፍታሌም ፍጫ፥</para>
  <para style="q1" vid="MAT 4:15">አይሁድ ማታክን ገሊላ ኤድንከሰኬ፥<verse eid="MAT 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16"/>ኡማር ዶቅድባብ ዎርሰና አንድር ሳክመን ሰጀኬ፥</para>
  <para style="q1" vid="MAT 4:16">ደእታ ስፍት ስፍሳን ፍጨናር ዶቅድባብከስካንተረ ሳክመና ከትካንታ ዉተዴ።” <note caller="-" style="x"><char style="xo" closed="false">4፡16 </char><char style="xt" closed="false"><ref loc="ISA 9:1-2">ኢሳ. 9፡1-2</ref>። </char></note><verse eid="MAT 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17"/>ኮታዘንከረ የድሶ የሱስ፥ “ጭላ ባንችምና ቅንችቴ ጎማ የንታ ፍክስን ዎይስከቴ!” ጋየሮ ሳባክ የጄ።<verse eid="MAT 4:17"/></para>
  <para style="s1">የሱስ ሞለን የድባብ ኦይድ ኤድንከስም ኤልና</para>
  <para style="r">(<ref loc="MRK 1:16-20">ማር. 1፡16-20</ref>፤ <ref loc="LUK 5:1-11">ሉቃ. 5፡1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18"/>የሱስ ገሊላ ባሀርንታ ላመካ ስገድንካ፥ ሞለን የድባብከስ ቃስተን እስመንኬ ካንስካ ከተረ ጴጥሮስ ጋይምስባብ ስምኦንኬ እስመን እንድራሰካ፥ ከታ ይንታ ሞለን የድን ሳከን ባሀርናር ከት ኦይድንካ ኖ ሰዴ። <verse eid="MAT 4:18"/><verse number="19" style="v" sid="MAT 4:19"/>የሱሰረ “ኮረቴ፥ እም ጎርስምከቴ፥ ሞለን የ የድንደትግንዳ ሙዳ ኤድንከስም ሳብታ ባንችምንካንታ የ ሳንስተርንግንዳ የም ይትቴ” ከትም ጋይሴ። <verse eid="MAT 4:19"/><verse number="20" style="v" sid="MAT 4:20"/>ከተረ ሳነካ ይንታ ሞለን የድን ሳከን ዛቅሰኮ ክትም ጎርስምሰኬ።<verse eid="MAT 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21"/>ኮታዘንከረ ኦሳ አይሶ፥ አብ ቃስተን እስመንኬ ካንስካ ዛብዶሰታ ይንችን ያይቆብምኬ ዮሀንስምካ ሰዴ። ከተረ ይንታ ባቤን ዛብዶሰከ ክክን ሎቀንዘንካ ቃልዝድን ጃልበንዘን ዶቅሰኮ ሞለን የድን ሳከን ከት ኡርዝድንካ ኤልሴ። <verse eid="MAT 4:21"/><verse number="22" style="v" sid="MAT 4:22"/>ከተረ ሳነካ ጃልበንምኬ ይንታ ባቤንም ዛቅሰኮ የሱሰም ጎርስምሰኬ።<verse eid="MAT 4:22"/></para>
  <para style="s1">የሱስ በድ ኤድንከስም ኤስሳንደትከ ፋችሳንዳ</para>
  <para style="r">(<ref loc="LUK 6:17-19">ሉቃ. 6፡17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23"/>የሱሰረ አይሁድንከስታ ምክስ ኤሄናር ኤስሰሮ ሳብታ ባንችምንታ ክላ ኬዛ ቃለን ሳባከሮ፥ Ꮊክ Ꮊክ ሰቅምከ Ꮊዝምካ የደርስባብ ኤድንከስም ፋቸሮ ገሊላ ፍጫ ሙደናር ኦንግድ Ꮊቄ።<note caller="-" style="x"><char style="xo" closed="false">4፡23 </char><char style="xt" closed="false"><ref loc="MAT 9:35">ማቶ. 9፡35</ref>። </char></note> <verse eid="MAT 4:23"/><verse number="24" style="v" sid="MAT 4:24"/>ክታ ይተና ሶርያ ፍጫ ሙደናር ኤስምሳንካንታ፥ ኤድንከስ Ꮊክ Ꮊክ ሰቅምከ Ꮊዝምካ ማጠርድባብከስም፥ ቱና አያንካ የደርስባብከስም፥ ባልት ዛቅድን ሰቅም ዶቅድባብከስምኬ ዎብንከስም ሙዳ ክደር ተይ Ꮊደኬ፥ ኖየረ ከትም ፋችሴ። <verse eid="MAT 4:24"/><verse number="25" style="v" sid="MAT 4:25"/>ገሊላ ፍጨናርንኬ ታማ ካተመናርንካ የሩሳሌማርንኬ፥ ይሁዳርንካ፥ ዮርዳኖስ ሎቀንታ ፋመንካ Ꮊድባብ በድ ኤድንከስ የሱሰም ጎርስምሰኬ።<verse eid="MAT 4:25"/></para>
  <chapter eid="MAT 4"/>
  <chapter number="5" style="c" sid="MAT 5"/>
  <para style="s1">የሱስ ገቸንዘን ዶቅሶ ኤስሳን ኤስና</para>
  <para style="r">(<ref loc="MAT 5:1-7:29">ማቶ. 5፡1—7፡29</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1"/>የሱስ ይም ጎርስምድባብ በድ ዎርሰንም ይ ሰዳንደትካ፥ ገቼንዘን ዉትሶ ዶቅሴ፥ ክታ ካርንካ ጎርስምድባብከሰረ ክደር Ꮊደኬ። <verse eid="MAT 5:1"/><verse number="2" style="v" sid="MAT 5:2"/>ኩን ጋየሮ ከትም ኤስስ የጄ፥<verse eid="MAT 5:2"/></para>
  <para style="s1">ዶፈን አንጀንም Ꮊብድን ኤድንከስ</para>
  <para style="r">(<ref loc="LUK 6:20-23">ሉቃ. 6፡20-23</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 5:3"/>“ጭላ ባንችምና ከታ ማቻንኦል አያናር ዶቅንተካ፥</para>
  <para style="q1" vid="MAT 5:3">“ሳብም ዝገሮ ዎቸርድባብከስ ኬታ አንጅምስባብከሰኬ”።<verse eid="MAT 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 5:4"/>ሳብ ከትካንታ ዳቅንተን እምድንካንታ ሞርእድባብከስ</para>
  <para style="q2" vid="MAT 5:4">አንጅምስባብከሰኬ።<note caller="-" style="x"><char style="xo" closed="false">5፡4 </char><char style="xt" closed="false"><ref loc="ISA 61:2">ኢሳ. 61፡2</ref>። </char></note><verse eid="MAT 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 5:5"/>ይንታ ማተን ይርክሳ ይድባብከስ ሳብ ከትካንታ ግግሳን ፍጨን ተይድባብ አንጅምስባብከሰኬ።<note caller="-" style="x"><char style="xo" closed="false">5፡5 </char><char style="xt" closed="false"><ref loc="PSA 37:11">የቺ 37፡11</ref>። </char></note><verse eid="MAT 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 5:6"/>ጭለትችን ዳቀርድባብከስኬ ዎቸርድባብከስ ከት ምዝድንካንታ፥</para>
  <para style="q1" vid="MAT 5:6">አንጅምስባብከሰኬ።<note caller="-" style="x"><char style="xo" closed="false">5፡6 </char><char style="xt" closed="false"><ref loc="ISA 55:1-2">ኢሳ. 55፡1-2</ref>። </char></note><verse eid="MAT 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 5:7"/>አብንከስካንታ አጨርድባብ አንጅምስባበኬ፥ Ꮊረታ ጋይሴ ሳብ ከትካንታ አጨርድንኦሌ።<verse eid="MAT 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 5:8"/>ቡዳ ጭለጭልንከስ አንጅምስባብኬ፥ ሳብም ሰተረኬ።<verse eid="MAT 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 5:9"/>ኤድምዝድባብከስ አንጅምስባብከሰኬ፥</para>
  <para style="q1" vid="MAT 5:9">ሳብታ ይንች ጋይምደኬ።<verse eid="MAT 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10"/>ጭለትቼንጎካ ዳየርምድባብከስ፥ ጭላ ባንችምና ከትካንታ ማቻንኦል፥</para>
  <para style="q1" vid="MAT 5:10">አንጅምስባብከሰኬ።<note caller="-" style="x"><char style="xo" closed="false">5፡10 </char><char style="xt" closed="false"><ref loc="1PE 3:14">1 ጴጥ. 3፡14</ref>። </char></note><verse eid="MAT 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11"/>“እጎካ ኤድንከስ የም የግድንከኬ የም ዳያ ኦንግድንካ፥ ዳቅልንም ማልትካ የንታዘን ኬዝድንካ አንጅምስባበቴ።<note caller="-" style="x"><char style="xo" closed="false">5፡11 </char><char style="xt" closed="false"><ref loc="1PE 3:14">1 ጴጥ. 3፡14</ref>። </char></note> <verse eid="MAT 5:11"/><verse number="12" style="v" sid="MAT 5:12"/>ጭላር የᎺብድን ናክና የካንታ አንድር ኮት ማቻን ኦል የም ጉርምሳ፥ አንድር ጉርመረ ይከቴ። ኤና የንታ እረረ Ꮊቅባብ ሳብዘንካ ኤሰርሶ ከዛቅባብከዘን ኮትኮግንዳ ዳይርምንከ ማጠንም የልስተኬ።” <note caller="-" style="x"><char style="xo" closed="false">5፡12 </char><char style="xt" closed="false"><ref loc="2CH 36:16">2 ኬዛ 36፡16</ref>፤ <ref loc="ACT 7:52">ኦይት. ፍ. 7፡52</ref>። </char></note><verse eid="MAT 5:12"/></para>
  <para style="s1">ሶቅተኬ ሳክመንታ ካምስ</para>
  <para style="r">(<ref loc="MRK 9:50">ማር. 9፡50</ref>፤ <ref loc="LUK 14:34-35">ሉቃ. 14፡34-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13"/>ኮታዘንከረ የሱስ፥ “የታ ፍጨዘን ሶቅንግንደቴ፥ ኬዛርንካ ማቼ ሶቅ ሎቅክሳ ነገዴ ና ካርንካ Ꮊስግንዶክ ሎቅካንታ ማዳ? ኦስ ማል ኦይትምሶ ኤታ ዱትያር ሙክምዘንካ አብ ኦስ እር Ꮊራርካንተረ መያዬ።<note caller="-" style="x"><char style="xo" closed="false">5፡13 </char><char style="xt" closed="false"><ref loc="LUK 14:34-35">ሉቃ. 14፡34-35</ref>። </char></note><verse eid="MAT 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14"/>“የታ ኮ ፍጫሙደንታ ሳክመቴ፥ ገቼዘን ዶቅድን ካተመና አችምካንታ ማዳክዬ።<note caller="-" style="x"><char style="xo" closed="false">5፡14 </char><char style="xt" closed="false"><ref loc="JHN 8:12">ዮሀ. 8፡12</ref>፤ <ref loc="JHN 9:5">9፡5</ref>። </char></note> <verse eid="MAT 5:14"/><verse number="15" style="v" sid="MAT 5:15"/>ኤድንከስ ዞጰን ዞጵስትዮ ኤሄናር ዶቅድባብ ሙደንካንታ ሳግድንግንዳ ጬክን ጋይሳን ካርዘን ዎደክ ዳት ዞጰን ዳሄታ ዋር ዎዳክዬ።<note caller="-" style="x"><char style="xo" closed="false">5፡15 </char><char style="xt" closed="false"><ref loc="MRK 4:21">ማር. 4፡21</ref>፤ <ref loc="LUK 8:16">ሉቃ. 8፡16</ref>፤ <ref loc="LUK 11:33">11፡33</ref>። </char></note> <verse eid="MAT 5:15"/><verse number="16" style="v" sid="MAT 5:16"/>ኮትኮግንደረ ኤድንከስ የንታ ኡርማ ፍክስን ሰድሰኮ ጭላር የንታ ባቤንም ከት ጋለድንግንዳ፥ የንታ ሳክመነረ ኤታ እሪ ሳካ” ኩን ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">5፡16 </char><char style="xt" closed="false"><ref loc="1PE 2:12">1 ጴጥ. 2፡12</ref>። </char></note><verse eid="MAT 5:16"/></para>
  <para style="s1">ሙሴካንታ እምምሳን ህግንጎካ</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17"/>ጉጅሰረ የሱስ “ሙሴታ ህግንምኬ ሳብዘንካ ኤሰርሶ ኬዛቅባብከስታ ኤስስን ነግስካንታ እ Ꮊዳንዳ የንደር Ꮊይካማ፥ ከት ቦድምድንግንዳ ይስካንታ እታ Ꮊዳት ዳት ነክስካንታ Ꮊዳክቴ”። <verse eid="MAT 5:17"/><verse number="18" style="v" sid="MAT 5:18"/>ዶፈን የም ጋይድቴ፥ ጭለኬ ፍጨካ ስገተርን የለልታ ሙሴታ ህግና ሙዳ ቦድምተር ዳት ህግናርንካ ዋልቃ ፍደል አነረ ዋልቃ ጩት ዎራ ነጋዬ።<note caller="-" style="x"><char style="xo" closed="false">5፡18 </char><char style="xt" closed="false"><ref loc="LUK 16:17">ሉቃ. 16፡17</ref>። </char></note> <verse eid="MAT 5:18"/><verse number="19" style="v" sid="MAT 5:19"/>ኮካንታ ከትከ ክተንከሳርንካ መራ ማቻን ዋልቀን ዎራ ዉልእድባብኬ አብ ኤድንከሰረ ኮትኮግንዳ ከት ይድንግንዳ ኤስዝድን ኤድ ጭላ ባንቺምናር መራ ጋይምተሬ። ኬዛርንካ ማቼ ክተነከስም ሙዳ ቦድባብኬ አብ ኤድንከሰረ ኮትኮግንዳ ከት ቦድንግንዳ ኤስዝድባብ ኤድ ጭላ ባንችማር አንድር ጋይምተሬ። <verse eid="MAT 5:19"/><verse number="20" style="v" sid="MAT 5:20"/>ኮካንታ የንታ ጭለትችና ሙሴታ ህግን ኤስዝድባብከዘንኬ ፈረሳውያን ኤድንከስታ ጭለትችንዘንካ ስጋክንዳ ማቼ ቦድሶ ጭላ ባንችማር የ አርዳክንደትም እታ የካንታ ኬዝድቴ።<verse eid="MAT 5:20"/></para>
  <para style="s1">ዋጭጎካ የሱሰዘንካ እምምሳን ኤስስ</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21"/>“ኤና እሪ Ꮊቃን ኤድንከስካንታ ጋየርሳንደትም የታ ኤሰርተቴ፥ ኮነረ፥ ‘ኤድም Ꮊይ ደይሴ፥ ኤድም ደይስባብ ፋረድምዴ’ ጋይድንዴ”።<note caller="-" style="x"><char style="xo" closed="false">5፡21 </char><char style="xt" closed="false"><ref loc="EXO 20:13">ዉት. 20፡13</ref>፤ <ref loc="DEU 5:17">ካሪ. 5፡17</ref>፤ <ref loc="DEU 16:18">16፡18</ref>። </char></note> <verse eid="MAT 5:21"/><verse number="22" style="v" sid="MAT 5:22"/>እታ ማቼ የም ጋይድቴ፥ ይንታ እስመንዘን ዋጭድባብ ሙደና ፋረድምዴ፥ አነረ ይንታ እስመንም የና መይዳክባብ! ጋይሶ የግድባብ ሙደንዘን አይሁድንታ ቡጫ ጋልተንከስ ክታዘን ፋረተረኬ፥ ቱንይ! ጋይሶ የግድባብ ሙደና ድግዳክን ኖሄካ ፋረድምዴ። <verse eid="MAT 5:22"/><verse number="23" style="v" sid="MAT 5:23"/>“ኮካንታ የና የስታ እመንም ሳብታ ኤሄናር ካሰርድን ካርዘን ሳብካንታ የስ እምድን Ꮊይካ፥ የዘን ይምኤርስባብ እስመና ዶቅድንደትም የስም ገቀርሴ፥ <verse eid="MAT 5:23"/><verse number="24" style="v" sid="MAT 5:24"/>የስታ እመንም ካስ ካርንታ እሪ ዎድሰዮ አይካ፥ እርምሳዮ ክትኮ የስታ እስመንካ ክክን ኤድምካ፥ ኮታ ቡር ማትሳዮ የስታ እመንም እምካ። <verse eid="MAT 5:24"/><verse number="25" style="v" sid="MAT 5:25"/>የስታ ይምኤንባብ የስም ካሰስንካ ክትካ ክክን ፍርድ ኤሀር አያዶቅዳዮ ጎግዘን ሳነካ የስታ ይምኤእንባብካ ክክን ኤእካ። ኩን ማታክንዳ ማቼ የስታ ይምኤንባብ ዳይነንካንታ፥ ዳይነነረ ዞግድባብካንታ ስክስት እምሳንደታ ቡር ዞክና ኤሀር ዞከርዳዬ። <verse eid="MAT 5:25"/><verse number="26" style="v" sid="MAT 5:26"/>ዶፈን የስም ጋይድቴ፥ የስታዘን ፋረጃን በእንታ ሳንትምን ናክት የስ በይስተርን የለልታ ቦድሰረ ኮታርንካ ዉዳካዬ” ኩን ጋይሴ።<verse eid="MAT 5:26"/></para>
  <para style="s1">ቤልምንጎካ እምምሳን ኤስስ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27"/>“ ‘Ꮊይበልመቴ!’ ጋይምሳንደትም የታ ኤሰርተቴ።<note caller="-" style="x"><char style="xo" closed="false">5፡27 </char><char style="xt" closed="false"><ref loc="EXO 20:14">ዉት. 20፡14</ref>፤ <ref loc="DEU 5:18">ካሪ. 5፡18</ref>። </char></note> <verse eid="MAT 5:27"/><verse number="28" style="v" sid="MAT 5:28"/>እታ ማቼ የም ጋይድቴ ‘ማነም ሰድሶ አንገርስባብ ሙደና፥ ኮትᎺይካ ይንታ ቡዳር ኮትካ ክክን ቤልምቴ’ ጋይድቴ። <verse eid="MAT 5:28"/><verse number="29" style="v" sid="MAT 5:29"/>የስታ ምዝ አፍና ጎመታ ጎግ ኮት ማዴ፥ ዉችተዮ ዛእካ! የስታ ኤደትቸና ሙደና ድግዳክን ኖሄናር ኦይትምተርንዘንካ የስታ ኤደትቸናርንካ ዋልቀና ካይደስናና የስካንታ ኡርሜ።<note caller="-" style="x"><char style="xo" closed="false">5፡29 </char><char style="xt" closed="false"><ref loc="MAT 18:9">ማቶ. 18፡9</ref>፤ <ref loc="MRK 9:47">ማር. 9፡47</ref>። </char></note> <verse eid="MAT 5:29"/><verse number="30" style="v" sid="MAT 5:30"/>የስታ ምዝ አንና ጎመታ ጎግ ኮት ማዴ፥ ተችት ዛእካ! የስታ ኤደትች ሙደና ድግዳክን ኖሄናር ኦይትምተርንዘንካ የስታ ኤደትቸናርንካ ዋልቀና ካይደስናና የስካንታ ኡርሜ”።<note caller="-" style="x"><char style="xo" closed="false">5፡30 </char><char style="xt" closed="false"><ref loc="MAT 18:8">ማቶ. 18፡8</ref>፤ <ref loc="MRK 9:43">ማር. 9፡43</ref>። </char></note><verse eid="MAT 5:30"/></para>
  <para style="s1">ማነም ቡልጎካ እምምሳን ኤስስ</para>
  <para style="r">(<ref loc="MAT 19:9">ማቶ. 19፡9</ref>፤ <ref loc="MRK 10:11-12">ማር. 10፡11-12</ref>፤ <ref loc="LUK 16:18">ሉቃ. 16፡18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31"/>“ይንታ ኬነንም ቡልድባብ ሙደና ኮት ቡልምሳንደታ ማርካትች ዋርቀትን ኮትካንታ እምማ” ጋይምቴ።<note caller="-" style="x"><char style="xo" closed="false">5፡31 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">ካሪ. 24፡1-4</ref>፤ <ref loc="MAT 19:7">ማቶ. 19፡7</ref>፤ <ref loc="MRK 10:4">ማር. 10፡4</ref>። </char></note> <verse eid="MAT 5:31"/><verse number="32" style="v" sid="MAT 5:32"/>እታ ማቼ የም ጋይድቴ፥ “ቤልምንጎካ ማታክንዳ ማቼ፥ ይንታ ኬነንም ቡልድባብ ሙደና ኮት ቤልምድንግንዳ ይዴ፥ ቡልምሳንደትመረ እንጅድባብ ሙደና ቤልምባብ ማዴ።” <note caller="-" style="x"><char style="xo" closed="false">5፡32 </char><char style="xt" closed="false"><ref loc="MAT 19:9">ማቶ. 19፡9</ref>፤ <ref loc="MRK 10:11-12">ማር. 10፡11-12</ref>፤ <ref loc="LUK 16:18">ሉቃ. 16፡18</ref>፤ <ref loc="1CO 7:10-11">1 ቆሮ. 7፡10-11</ref>። </char></note><verse eid="MAT 5:32"/></para>
  <para style="s1">ጫቃጎካ እምምሳን ኤስስ</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33"/>ጉጅሰረ ኤና እሪ ኤድንከስካንታ “ካርከካ Ꮊይ ጫቀቴ፥ ኬዛርንካ ማቼ የንታ ጫቀንም ጮይስካንታ ቦድከቴ” ጋይምሳንደትም ኤሰርተቴ።<note caller="-" style="x"><char style="xo" closed="false">5፡33 </char><char style="xt" closed="false"><ref loc="LEV 19:12">ሌዊ. 19፡12</ref>፤ <ref loc="NUM 30:2">ፋይ. 30፡2</ref>፤ <ref loc="DEU 23:21">ካሪ. 23፡21</ref>። </char></note> <verse eid="MAT 5:33"/><verse number="34" style="v" sid="MAT 5:34"/>እታ ማቼ “ቦድሰረ Ꮊይ ጫቀቴ” የም ጋይድቴ። ጭለና ሳብታ ዶቅንት ጎንጋ ኮት ማቻንካንታ፥ ጭለከረ Ꮊይ ጫቀተ፥<note caller="-" style="x"><char style="xo" closed="false">5፡34 </char><char style="xt" closed="false"><ref loc="JAS 5:12">ያይ. 5፡12</ref>፤ <ref loc="ISA 66:1">ኢሳ. 66፡1</ref>፤ <ref loc="MAT 23:22">ማቶ. 23፡22</ref>። </char></note> <verse eid="MAT 5:34"/><verse number="35" style="v" sid="MAT 5:35"/>ፍጨነረ ጮይስታ ዱትንታ ዎእንትንዳ ኮት ማቻንካንታ ፍጨከረ Ꮊይ ጫቀቴ፥ አንድር ባንችንታ ካተማ ኮት ማቻንኦል የሩሳሌም ካተመንከረ Ꮊይ ጫቀቴ፥<note caller="-" style="x"><char style="xo" closed="false">5፡35 </char><char style="xt" closed="false"><ref loc="ISA 66:1">ኢሳ. 66፡1</ref>፤ <ref loc="PSA 48:2">የቺ 48፡2</ref>። </char></note> <verse eid="MAT 5:35"/><verse number="36" style="v" sid="MAT 5:36"/>የስታ ማተናርንካ ዋልቀን ዎራ ጫምሳ አነረ ጫልም ማስካንታ የስ ማዳክንካንታ የስታ ማተንከረ Ꮊይ ጫቄ። <verse eid="MAT 5:36"/><verse number="37" style="v" sid="MAT 5:37"/>ኮካንታ የንታ ኬዘና “ይያ” ማቼ “ይያ” አነረ “ዋአ” ማቼ “ዋአ” ማታ። ኮዘንካ ስግዳንዳ ዳቅልንዘንኬ።<note caller="-" style="x"><char style="xo" closed="false">5፡37 </char><char style="xt" closed="false"><ref loc="LEV 19:12">ሌዊ. 19፡12</ref>፤ <ref loc="NUM 30:2">ፋይ. 30፡2</ref>፤ <ref loc="DEU 23:21">ካሪ. 23፡21</ref>። </char></note><verse eid="MAT 5:37"/></para>
  <para style="s1">ይምኤር ዝግዝዳክንደትም እምሳን ኤስስ</para>
  <para style="r">(<ref loc="LUK 6:29-30">ሉቃ. 6፡29-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38"/>“ ‘አፍታ ካርያር አፍ፥ አችታ ካርያር አች’ ጋይምሳንደትም ኤሰርተቴ።<note caller="-" style="x"><char style="xo" closed="false">5፡38 </char><char style="xt" closed="false"><ref loc="EXO 21:24">ዉት. 21፡24</ref>፤ <ref loc="LEV 24:20">ሌዊ. 24፡20</ref>፤ <ref loc="DEU 19:21">ካሪ. 19፡21</ref>። </char></note> <verse eid="MAT 5:38"/><verse number="39" style="v" sid="MAT 5:39"/>እታ ማቼ ዳቅልን የንዘን ይድባብ ኤድንዘን Ꮊይ ይምኤርቴ። ኬዛርንካ ማቼ ምዝ የስታ ከቼንም ጫቅድባብካንታ የስታ ከች ከቼንም ክትካንታ ስርስካ። <verse eid="MAT 5:39"/><verse number="40" style="v" sid="MAT 5:40"/>ዋልቃ ኤድ የስታ ሳምዝንም ተይካንታ ዝግሶ የስም ክት ካሰሴ፥ የስታ ኮትንም ክት ተይድንግንዳ ዛእካ። <verse eid="MAT 5:40"/><verse number="41" style="v" sid="MAT 5:41"/>ዋልቃ ኤድ ‘እንካ ክክን ቶክም ጎግ አይካ’ ጋይሶ የስም ማእሴ፥ የና ማቼ ኮታዘን ኮትከካ ጎግ ክትካ ክክን አይካ። <verse eid="MAT 5:41"/><verse number="42" style="v" sid="MAT 5:42"/>የዝደር ምግዝድባብካንታ እምካ፥ የዝደር ታልቃ ዝግድባብካንታ ዋይዬ Ꮊይ ጋዬ”። <note caller="-" style="x"><char style="xo" closed="false">5፡42 </char><char style="xt" closed="false"><ref loc="DEU 15:8">ካሪ. 15፡8</ref>፤ <ref loc="PRO 24:29">ካም. 24፡29</ref>። </char></note><verse eid="MAT 5:42"/></para>
  <para style="s1">ይምኤንባብም ሶልማጎካ እምሳን ኤስስ</para>
  <para style="r">(<ref loc="LUK 6:27-36">ሉቃ. 6፡27-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43"/>ኮታዘንከረ የሱስ፥ “ ‘የስታ ላኮይትን ሶልምካ፥ የስታ ይምኤንባብም ግርካ’ ጋይምሳንደትም ኤሰርተቴ።<note caller="-" style="x"><char style="xo" closed="false">5፡43 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ሌዊ. 19፡18</ref>። </char></note> <verse eid="MAT 5:43"/><verse number="44" style="v" sid="MAT 5:44"/>እታ ማቼ የንታ ይምኤንባብከስም ሶልምከቴ፥ የም ባድባብከስም አንጅከቴ፥ የም ግርድባብከስካንታ ኡርማ ይከቴ፥ ዳቅልን የንዘን ይድባብከስካንተከ የም ዳይድባብከስካንታ ምክስከቴ” እታ የም ጋይድቴ ኩን ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">5፡44 </char><char style="xt" closed="false"><ref loc="PRO 25:21-22">ካም. 25፡21-22</ref>። </char></note> <verse eid="MAT 5:44"/><verse number="45" style="v" sid="MAT 5:45"/>ኮም የ ይዴ፥ ጭለናር ዶቅድን የንታ ባቤንታ የታ ይንች ማተረቴ። ኖ ዳቅልንከስካንተኬ ኡርመንከስካንታ Ꮊይንም ዉችዝዴ፥ ኮትኮግንደረ ጭልንከስካንተኬ ጎመንባብከስካንታ ዶብንም ቃንዝዴ። <verse eid="MAT 5:45"/><verse number="46" style="v" sid="MAT 5:46"/>የም ሶልምድባብከስም Ꮊክ የ ሶልምደ Ꮊራ ናክ የንታ ዶቅዳ? ቃረጭን ተችዝድባብከስ ኮትኮም ይደክ ካዮ? <verse eid="MAT 5:46"/><verse number="47" style="v" sid="MAT 5:47"/>የንታ እስመንከስካንታ Ꮊክ አቦ የ ጋይድንዳ ማቼ Ꮊረንት ስገዳን ሪ ይዳ? አይሁድ ማታክባብከስ ኮትኮም ይደክካዮ? <verse eid="MAT 5:47"/><verse number="48" style="v" sid="MAT 5:48"/>ኮካንታ ጭለናር የንታ ባቤና ቦድማ ማቻንግንዳ የተረ ቦድማ ማትከቴ።<note caller="-" style="x"><char style="xo" closed="false">5፡48 </char><char style="xt" closed="false"><ref loc="LEV 19:2">ሌዊ. 19፡2</ref>፥<ref loc="LEV 19:18">18</ref>፤ <ref loc="DEU 18:13">ካሪ. 18፡13</ref>። </char></note><verse eid="MAT 5:48"/></para>
  <chapter eid="MAT 5"/>
  <chapter number="6" style="c" sid="MAT 6"/>
  <para style="s1">ሪካየንባብከስካንታ እመርድን እመንጎካ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1"/>ኮታዘንከረ የሱስ፥ ኤድ ዎም ሰዳ ጋይሶ የንታ ኡርማ ፍክስንም ኤታ እሪ ይይንተዘንካ ካርስምከቴ፥ ኩን የ ይያክንዳ ማቼ ጭለናር የንታ ባቤንደርንካ እምምድንደትም ናክን Ꮊብዳከቴ። <verse eid="MAT 6:1"/><verse number="2" style="v" sid="MAT 6:2"/>ኮካንታ ሪንካየንባብካንታ እመንም የ እምድንᎺይካ፥ ኦትረንባብከስ ምክስ ኤሄናርኬ ጎግካ ኤድ ከትም ቦንጅድንግንዳ ጋይሰኮ ከት ይድንግንዳ የተረ Ꮊይ ጬቀቴ፥ እታ የም ዶፈን ከዝድቴ፥ ከታ ይንታ ፍክስንታ ናክንም እርምሰኮ ተይተኬ። <verse eid="MAT 6:2"/><verse number="3" style="v" sid="MAT 6:3"/>የና ማቼ ሪካየንባብከስካንታ እምድ ዶቆ የስታ ምዝ አንና ይድንደትም ከች አንና የስታ Ꮊይ ኤሳ። <verse eid="MAT 6:3"/><verse number="4" style="v" sid="MAT 6:4"/>ይና የስታ እመና አቸካ ማታ፥ አቸካ የስ ፍግዝድንደትም ሰድባብ፥ የስታ ኡርማ ፍክስንታ ናክን ኖ ናግዴ።<verse eid="MAT 6:4"/></para>
  <para style="s1">ምክስጎካ</para>
  <para style="r">(<ref loc="LUK 11:2-4">ሉቃ. 11፡2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5"/>“የ ምግዝድንደትᎺይካ ኮ ኦትረንባብከስግንዳ Ꮊይማተቴ! ኬታ ኤድ ከትም ሰድንግንዳ ጋይሶ አይሁድንታ ምክስ ኤሄናርኬ ጎግንታ ካንታር ዎእሶ ኬታ ምክስካንታ ሶልምደኬ። ዶፈን የም፥ ጋይድቴ ኬታ ይንታ ናክንም ተይተኬ።<note caller="-" style="x"><char style="xo" closed="false">6፡5 </char><char style="xt" closed="false"><ref loc="LUK 18:10-14">ሉቃ. 18፡10-14</ref>። </char></note> <verse eid="MAT 6:5"/><verse number="6" style="v" sid="MAT 6:6"/>የና ማቼ ምግዝድዮ ኤሄንታ ዋር አርድካ፥ የስታ ፍልተንም ዝጭሳዮ፥ ግፋር ዶቅድን የስታ ባቤንደር ምክስካ አቼካ ፍክስምሳን ሰድባብ የስታ ባቤና የስታ ኡርማ ፍክስንታ ናክንም ናግዴ።<verse eid="MAT 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7"/>“የታ ምግዝደቶ አይሁድ ማታክባብከስግንዳ፥ ዉችኩን ማዳክንደትም ካርንካ ካርንካ Ꮊይ አፈረቴ፥ ከታ ካርንካ ካርንካ ጋይተታ በድምካ ሳብ ከታ ምክስን ኤሰርድን ካምዴ። <verse eid="MAT 6:7"/><verse number="8" style="v" sid="MAT 6:8"/>የታ ማቼ፥ የንታ ባቤና የካንታ ዝግዝድንደትም ሪን አክ ክትም የ ምክሳክናና እርምሶ ክት ኤዝድንካንታ ከትግንዳ Ꮊይማተቴ። <verse eid="MAT 6:8"/><verse number="9" style="v" sid="MAT 6:9"/>ኮካንታ የታ ኩን ጋይሶ ምክስከቴ፥</para>
  <para style="q1" vid="MAT 6:9">“ጭላር ዶቅድባብ ዎንታ ባቤኖ!</para>
  <para style="q2" vid="MAT 6:9">የስታ ጭል ላምና ቦንችማ፥<verse eid="MAT 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10"/>የስታ ባንችምና Ꮊዳ፥</para>
  <para style="q2" vid="MAT 6:10">የስታ ጋይተና ጭለናር ማቻንግንዳ፥</para>
  <para style="q2" vid="MAT 6:10">ኮትግንደረ ፍጨዘን ማታ፥<verse eid="MAT 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11"/>ሰጨንታ እችምን ታካ ዎካንታ እምካ።<verse eid="MAT 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12"/>ዎተረ ዎም ባችስባብም ነጋ ዎ ጋይድንግንዳ፥</para>
  <para style="q2" vid="MAT 6:12">ዎንታ ባችንም ነጋ ጋይካ፥<verse eid="MAT 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13"/>ዳቅልዘንካ አቅስካ ዳት፥</para>
  <para style="q2" vid="MAT 6:13">ኦስ ጰጭምናር ዎም Ꮊይ አርችሴ፥</para>
  <para style="q2" vid="MAT 6:13">ባንችምና፥ ዎልቀኬ ቦንቼካ<note caller="+" style="f"><char style="fr" closed="false">6፡13 </char><char style="ft" closed="false">ዋልቃ ዋልቃ ኤና እር ንከስ ኮም ጉጃዬ። </char></note></para>
  <para style="q2" vid="MAT 6:13">ስለንክንደታ የስቴ፥ አምንኤ”።<verse eid="MAT 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14"/>“ኤድንከስታ ጎመንም ነጋ የ ጋይዴ የመረ ጭላር የንታ ባቤና ነጋ ጋይተሬ።<note caller="-" style="x"><char style="xo" closed="false">6፡14 </char><char style="xt" closed="false"><ref loc="MAT 11:25-26">ማቶ. 11፡25-26</ref>። </char></note> <verse eid="MAT 6:14"/><verse number="15" style="v" sid="MAT 6:15"/>ኤድንከስታ ጎመንም ነጋ የ ገይዳክንዳ ማቼ፥ የንታ ባችንመረ ጭላር የንታ ባበና ነጋ ጋያዬ።”<verse eid="MAT 6:15"/></para>
  <para style="s1">በቼካ ምክስ</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16"/>የሱሰረ፥ “በቼካ የ ምግዝድንደት Ꮊይካ፥ ከታ በቼካ ምክስንም ኤድንከስ ኤዝድንግንዳ፥ ከታ ይንታ ባለንም ኦግድባብ ኦትረንባብከስግንዳ የንታ ባለንም Ꮊይሱልሰቴ፥ ዶፈን የም ጋይድቴ፥ ከታ ይንታ ናክንም ተይተኬ።<note caller="-" style="x"><char style="xo" closed="false">6፡16 </char><char style="xt" closed="false"><ref loc="ISA 58:5">ኢሳ. 58፡5</ref>። </char></note><verse eid="MAT 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 6:17"/>“የና ማቼ በቼካ የስ ምግዝድንደትᎺይካ የስታ ባለንም ስኤርካ የስታ ማተንመረ ሳየርካ። <verse eid="MAT 6:17"/><verse number="18" style="v" sid="MAT 6:18"/>ኮግንደካ የስታ በቼካ ምክስንም ግፋር ዶቅድባብ የስታ ባቤንዘንካ አብ Ꮊየነረ ኤዝዳክዬ፥ ግፋር ፍክስምሳንደትም ሰድባብ የስታ ባቤነረ መየካ የስካንታ ናክተሬ” ኩን ጋይሴ።<verse eid="MAT 6:18"/></para>
  <para style="s1">ጭላር ዶቅድን ቆልማ</para>
  <para style="r">(<ref loc="LUK 12:33-34">ሉቃ. 12፡33-34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19"/>ጉጅሰረ የሱስ፥ “ብልኬ ቡይካ ካይዝድን ካርዘን ድብንከሰረ ቁንጭሶ ድብድንደታር፥ ኮ ፍጨዘን የንታ ማታ ካንታ ቆልመን Ꮊይ ሳንሰቴ።<note caller="-" style="x"><char style="xo" closed="false">6፡19 </char><char style="xt" closed="false"><ref loc="JAS 5:2-3">ያይ. 5፡2-3</ref>። </char></note> <verse eid="MAT 6:19"/><verse number="20" style="v" sid="MAT 6:20"/>ስግስሰረ ብልኬ ቡይካ ካይስካንታ ማዳክን ካርዘን፥ ድብንከሰረ ቁንጭሶ ድብዳክን ካርዘን ጭላር የንታ ቆልመንም ሳንስከቴ። <verse eid="MAT 6:20"/><verse number="21" style="v" sid="MAT 6:21"/>ቆልመና የስታ ዶቅድን ካርዘን የስታ ቡደነረ ኮታር ማተሬ።<verse eid="MAT 6:21"/></para>
  <para style="s1">ኤደትቸንታ ሳክማ</para>
  <para style="r">(<ref loc="LUK 11:34-36">ሉቃ. 11፡34-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22"/>“ኤደትቸንታ ሳክመና አፍዬ፥ ኮካንታ የስታ አፍና ኡርማ ማቼ፥ የስታ ኤደትቸና ሙዳ ሳክማ ማተረ፥ <verse eid="MAT 6:22"/><verse number="23" style="v" sid="MAT 6:23"/>የስታ አፍና ሰቀርድንዳ ማቼ፥ የስታ ኤደትቸና ሙዳ ኡም ማዴ። ይና የሳር ዶቅድንዳ ሳክመና ኡም ኮት ማቼ ኡምና Ꮊስግንዶክ እንድንካ ኡምሳንዳ ማተራ!<verse eid="MAT 6:23"/></para>
  <para style="s1">ሳብካንተኬ ብራካንተካ</para>
  <para style="r">(<ref loc="LUK 16:13">ሉቃ. 16፡13</ref>፤ <ref loc="LUK 12:22-31">12፡22-31</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24"/>“ዋልቃ ኤች ቃስቴን ማታ ቆልስባብከስታ ፍክስንባብ ማትካንታ ማታዬ፥ አነረ ዋልቃባብም ግርዴ፥ ዋልቃባብንም ሶልምዴ፥ አነረ ዋልቃባብንም ቦንጅዴ፥ አብንመረ ቶጅዴ፥ ኮትኮግንደረ ዋልቃ ኤድ ዋልቃዱት ሳብካንተኬ ብራካንታ ፍክስንባብ ማትካንታ ማታዬ።<verse eid="MAT 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25"/>“ኮካንታ ኩን የም ጋይድቴ፥ ‘Ꮊሮንት እችቴ? Ꮊሮንት ዎጭቴ? Ꮊሮንት ቆበርቴ?’ ጋይሰቶ የንታ ገች Ꮊቅንጎካ Ꮊይ ማጠረቴ፥ እችምዘንካ ሰንፓ፥ አፍለዘንከረ የንታ ኤደትቸና ስጋዮ? <verse eid="MAT 6:25"/><verse number="26" style="v" sid="MAT 6:26"/>ይና ጭለዘን ፈድን አፍትንከስም ሰድከቴ፥ ከታ ማሳ ካዬ፥ ስካየኬ፥ ቡላር ኦይታየኬ፥ ኬዛርንካ ማቼ ጭላር የንታ ባቤና ከትም እችዝዴ። ይና የታ አፍትንከዘንካ አንድር ስግደት ካዮ? <verse eid="MAT 6:26"/><verse number="27" style="v" sid="MAT 6:27"/>ማችንከረ የንታ ዌክያርንካ ማጠርሶ፥ ይንታ ስለዘን ዋልቃ ሰጫ ዎራ ጉጅካንታ ማድባብ Ꮊይራ?<verse eid="MAT 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28"/>“ጉጅሰረ አፍላካንታ Ꮊረተንት ማጠርዳ? ይና ፍጨዘን ድረንከስታ ቦነነከስ Ꮊስግንዳ ጋጵዳናነረ ሰዳከቴ፥ ከታ ፍክስካ ጋፋየኬ፥ ፉታ ግእዳከኬ፥ <verse eid="MAT 6:28"/><verse number="29" style="v" sid="MAT 6:29"/>ኬዛርካ ማቼ፥ ሰሎሞን ዎራ ኮ ሙዳ ይንታ ቦንቼንካ፥ ከታርንካ ዋልቀንግንዳ ቆበራክየ ጋይድቴ። <verse eid="MAT 6:29"/><verse number="30" style="v" sid="MAT 6:30"/>ይና ታካ Ꮊፈርሶ ሰናካ ኖሀር ኦይትምድን ዛክንዘን ድረንም፥ ሳብ ኮግንዳ ቆብዝድንዳ ማቼ የታ አሜን ዞገርስባብከስ! የም ማቼ Ꮊስግንዳ ስግስሶ ቆፍሳይንዳ! <verse eid="MAT 6:30"/><verse number="31" style="v" sid="MAT 6:31"/>ኮካንታ ‘Ꮊሮንት እችቴ? Ꮊሮንት ዎጭቴ? Ꮊሮንት ቆበርቴ?’ ጋየረቶ ገቅርካ Ꮊይማጠረቴ። <verse eid="MAT 6:31"/><verse number="32" style="v" sid="MAT 6:32"/>ኮም Ꮊፍካንታ አይሁድ ማታክባብከሰረ ዝግደኬ፥ የካንታ ኮና ሙዳ የም ዝግዝድንደትም ጭላር የንታ ባቤና ኤዝዴ። <verse eid="MAT 6:32"/><verse number="33" style="v" sid="MAT 6:33"/>የታ ማቼ፥ እርምሰቶ ሳብታ ባንችምንምኬ ጭለትችንም ዝከቴ፥ ነገዳን ሪሙደና የካንታ ጉጅምተሬ፥ <verse eid="MAT 6:33"/><verse number="34" style="v" sid="MAT 6:34"/>ሰናክንዳ ሰጨና ይንታ ማታ ኮት ማጠራ፥ ሰናክንደትካንታ Ꮊይማጠረቴ፥ ሰጨንካንታ ጋይምሳን ቦርምና ኮትካንታ ማዴ።”<verse eid="MAT 6:34"/></para>
  <chapter eid="MAT 6"/>
  <chapter number="7" style="c" sid="MAT 7"/>
  <para style="s1">አብንከዘን ፋረድ ዝክሳይንዳ</para>
  <para style="r">(<ref loc="LUK 6:37-42">ሉቃ. 6፡37-42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1"/>ኮታዘከረ የሱስ፥ “የዘን ፋረድምተራክንግንዳ፥ Ꮊየንታ ዘነረ Ꮊይ ፋረደቴ። <verse eid="MAT 7:1"/><verse number="2" style="v" sid="MAT 7:2"/>አብንከዘን የ ፍርድን ፍርደና፥ የንታዘን ፋርድምዴ፥ ኮትኮግንደረ የ ማግድንደትካ ማስትዮ የካንታ ማክምዴ”።<note caller="-" style="x"><char style="xo" closed="false">7፡2 </char><char style="xt" closed="false"><ref loc="MRK 4:24">ማር. 4፡24</ref>። </char></note> <verse eid="MAT 7:2"/><verse number="3" style="v" sid="MAT 7:3"/>የስታ አፋር ዶቅድንደተም ቱስን ሰዳከይ ዶቆ Ꮊረተስ የስታ እስመንታ አፍናር ዶቅድን ዳቅልን ሰዳ? <verse eid="MAT 7:3"/><verse number="4" style="v" sid="MAT 7:4"/>ጉጅሶ የስታ አፍናር ቱስ ከከና ዶቅድንካ የስታ እስመንም “ይና ‘የስታ አፍናር ዶቅድን ዳቅልን ዉችትቴ’ Ꮊስግንደስ ጋይዳ? <verse eid="MAT 7:4"/><verse number="5" style="v" sid="MAT 7:5"/>የና ኦተረንባቦ! እርምሶ የስታ አፍናር ዶቅድን ቱስን ዉችካ፥ ኮታ ቡር፥ የስታ እስመንታ አፍናር ዶቅድን ዳቅልን ዉችካንታ ኡርስት ሰዳዬ”። <verse eid="MAT 7:5"/><verse number="6" style="v" sid="MAT 7:6"/>ሳብካንታ ፋስምሳን ርን ከታ ይንታ ዱትንከረ ሙግዳክንግንዳ ማተረ የም ከት ጋእዳክንግንዳ አክስንከስካንታ Ꮊይ እመቴ፥ የንታ ቦንችምሳን ርን ጉድምንከስታ እር Ꮊይ ኦይተቴ፥ ጉድምንከስ የንታ ቦንችምሳን ርን ከታ ይንታ ዱትንካ ሙግደኬ።<verse eid="MAT 7:6"/></para>
  <para style="s1">ኦይስከቴ፥ ዝከቴ፥ ኤልከቴ</para>
  <para style="r">(<ref loc="LUK 11:9-13">ሉቃ. 11፡9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7"/>“ምክስከቴ የካንታ እምምተሬ፥ ዝከቴ የታ Ꮊፍተረቴ፥ ፍልተን ቆንከቴ የካንታ ፎችምተሬ። <verse eid="MAT 7:7"/><verse number="8" style="v" sid="MAT 7:8"/>ምግዝድባብ ሙደና ተይተሬ፥ ዝግድባብ Ꮊፍተሬ፥ ፍልተንመረ ቆንግድባብካንታ ፎችምተሬ። <verse eid="MAT 7:8"/><verse number="9" style="v" sid="MAT 7:9"/>የንታ ዎክያርንካ ክታ ይንችና እችም ኦይሴ ሰይን እምድባብ Ꮊይራ? <verse eid="MAT 7:9"/><verse number="10" style="v" sid="MAT 7:10"/>ሞለንም ምክሳን ማቼ ጉንን እምዶ? <verse eid="MAT 7:10"/><verse number="11" style="v" sid="MAT 7:11"/>ይና የታ ዳቅል ማትሶ ዶቅድ፥ የንታ ይንችንካንታ ኡርማ ሪም እምንተን የ ኤሳንካ ይና፥ ጭላር ዶቅድባብ የንታ ባበና ምግዝድባብከስካንታ Ꮊስግንዳ ስክስሶ ኡርማ ርን እማይንዳ?” <verse eid="MAT 7:11"/><verse number="12" style="v" sid="MAT 7:12"/>ይና ኤድንከስ የካንታ ይድንግንዳ የ ዝግድንደትም ሙዳ፥ የተረ ከትካንታ ኮትግንዳ ይከቴ፥ ሙሴታ ህግኬ ሳብዘንካ ኤስርሶ ከዘቅባብከስታ ኤስስነረ ኮትኮመተ።<note caller="-" style="x"><char style="xo" closed="false">7፡12 </char><char style="xt" closed="false"><ref loc="LUK 6:31">ሉቃ. 6፡31</ref>። </char></note><verse eid="MAT 7:12"/></para>
  <para style="s1">ጩንጭማ ፍልተንጎካ</para>
  <para style="r">(<ref loc="LUK 13:24">ሉቃ. 13፡24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13"/>ጩንጭማ ፍልተንካ አርድከቴ፥ ካይንተናር አርጅድንዳ ፍልተና ዳልጌ፥ ጎግነረ ኮታ ሳክምዬ። ኮትካ አይድባብ ኤድና በድንከሰኬ። <verse eid="MAT 7:13"/><verse number="14" style="v" sid="MAT 7:14"/>ኦስ ዶቅንተናር አርጅድን ፍልተና ማቼ ጩንጭሜ፥ ጎግነረ ሉጋ ጎግንግንዴ፥ ኮትም Ꮊብድባብከሰረ ቶክም ኤድንከሰኬ።<verse eid="MAT 7:14"/></para>
  <para style="s1">ካርካ ኤስስንባብከስጎካ</para>
  <para style="r">(<ref loc="LUK 6:43-44">ሉቃ. 6፡43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15"/>“ቆልታ ጉፍተም ቆበርሶ የንደር Ꮊድባብከዘንካ፥ ኬታ ዋርጎክንዳ ማቼ ቆልንም የድን ጋርመንከስግንዳ ማችባብከስ ካርከካ ሳብዘንካ ኤሰራከክዶቆ ከዝድባብከዘንካ ካርስምከቴ።<note caller="-" style="x"><char style="xo" closed="false">7፡15 </char><char style="xt" closed="false"><ref loc="EZK 22:27">ሕዝ. 22፡27</ref>። </char></note> <verse eid="MAT 7:15"/><verse number="16" style="v" sid="MAT 7:16"/>ከትመረ የ ኤዝድንዳ ከታ ፍክስንታ አፍንኬ። ኡክምታ እክመዘንካ ዎይንታ አፍ፥ ኦንደዘንካ በለስታ አፍን ካምምዶ? <verse eid="MAT 7:16"/><verse number="17" style="v" sid="MAT 7:17"/>ኮግንደረ ኡርማ Ꮊቃ ሙደና ኡርማ አፍ ኡዝዴ፥ ዳቅል Ꮊቃ ማቼ ዳቅል አፍ ኡዝዴ። <verse eid="MAT 7:17"/><verse number="18" style="v" sid="MAT 7:18"/>ኡርማ Ꮊቀና ዳቅል አፍ ኡስካንታ ማታዬ ዳቅል Ꮊቀነረ ኡርማ አፍ ኡስካንታ ማታዬ። <verse eid="MAT 7:18"/><verse number="19" style="v" sid="MAT 7:19"/>ኡርማ አፍ ኡዝዳክን Ꮊቃ ሙደና፥ ፋክምሶ ኖሀር ኦይትምዴ። <verse eid="MAT 7:19"/><verse number="20" style="v" sid="MAT 7:20"/>ኮካንታ፥ ካርከካ ሳብዘንካ ኤሰራከክዶቆ ከዛዶቅድባብከስም ከታ ፍክስንካ ኤዝደቴ።<verse eid="MAT 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21"/>“ጭላር ዶቅድባብ እስታ ባበንታ ጋይተንም ቦድባብ ዳት ‘ጮይስዮ! ጮይስዮ!’ እም ጋይድባብ ሙደና ጭላ ባንችምናር አርድባብ ካዬ። <verse eid="MAT 7:21"/><verse number="22" style="v" sid="MAT 7:22"/>ፍርደን ሰጨንካ በድንከስ፥ ‘ጮይስዮ! ጮይስዮ! የስታ ላምንካ ቤርካ ኬዛክቶ? የስታ ላምንካ ግምዘንከስም ዉቻኮቶ? የስታ ላምንካ በድ አተንም ፍክሳኮቶ?’ እዝደር ጋይተረኬ። <verse eid="MAT 7:22"/><verse number="23" style="v" sid="MAT 7:23"/>እተረ ኮት ሰጨንᎺይካ፥ ‘ቦድሶ የም ኤዝዳክቴ! የታ ዳቅልንም ፍግዝድባብከስ እዘንካ ኦስ ጎተርከቴ!’ ከትም ጋይትቴ።<note caller="-" style="x"><char style="xo" closed="false">7፡23 </char><char style="xt" closed="false"><ref loc="PSA 6:8">የቺ 6፡8</ref>። </char></note><verse eid="MAT 7:23"/></para>
  <para style="s1">ላዝዘንኬ ሻምዘን ዎድምሳን ኤሄንታ ካምስ</para>
  <para style="r">(<ref loc="LUK 6:47-49">ሉቃ. 6፡47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24"/>“ኮም እስታ ቃለንም ኤሰርሶ ፍክስዘን Ꮊቅዝድባብ ሙደና፥ ይንታ ኤሄንም ሰይን ላዝንዘን ዎጅባብ ኤችንም ካምዴ። <verse eid="MAT 7:24"/><verse number="25" style="v" sid="MAT 7:25"/>ዶብነረ ቃንሴ፥ ሳፍነረ ሙርግዜ፥ ዞገነረ ዞግሶ፥ ኮትኮ ኤሄንም Ꮊቅሴ፥ ማታጋካ ዳት፥ ኤሄና ሰይን ላዝንዘን ዎድምሳንካንታ ዋቻክዬ። <verse eid="MAT 7:25"/><verse number="26" style="v" sid="MAT 7:26"/>ኮም እስታ ቃለንም ኤሰርሶ ፍክስዘን Ꮊቅዝዳክባብ ማቼ፥ ኤሄንም ሸምዘን ዎጅባብ ዳቻ ኤችንም ካምዴ። <verse eid="MAT 7:26"/><verse number="27" style="v" sid="MAT 7:27"/>ዶብነረ ቃንሶ ሳፍነረ ሙርግሶ ኮትኮ ኤሄንም Ꮊቅሴ ኤሄነረ ዋቼ፥ ዋችንተነረ ኮታ ገቅዝድንዳ ማቼ”።<verse eid="MAT 7:27"/></para>
  <para style="s1">የሱሰታ ገችስታ ኤራ</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28"/>የሱሰረ ከትኬና ሪንከስም ኬዝሶ ክት በይሳንደትካ ዎርሰና ክታ ኤስስንካ በርእሰኬ። <verse eid="MAT 7:28"/><verse number="29" style="v" sid="MAT 7:29"/>ከት በርእሳንደረ ኖ ሙሴታ ህግንም ኤስዝድባብከስግንዳ ማታክዶቆ፥ ገችታ ኤራ ዶቅድባብግንዳ ከትም ኤስዝድ Ꮊቃንጎኬ።<verse eid="MAT 7:29"/></para>
  <chapter eid="MAT 7"/>
  <chapter number="8" style="c" sid="MAT 8"/>
  <para style="s1">እጳ ሰቅምንክንባብታ ፋጭና</para>
  <para style="r">(<ref loc="MRK 1:40-44">ማር. 1፡40-44</ref>፤ <ref loc="LUK 5:12-14">ሉቃ. 5፡12-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1"/>የሱስ ገቸንዘንካ ክት Ꮊንቸርድንካ፥ አንድር በድ ኤድንከስ ክትም ጎርስምሴ። <verse eid="MAT 8:1"/><verse number="2" style="v" sid="MAT 8:2"/>ኮትᎺይካ ዋልቃ እጳ ሰቅምንክንባብ ኤች Ꮊድሶ ክትካንታ ጎስትሶ “ጮይስዮ! የስ ሶልምደ እም ፋችካንታ ማዳየ” ጋይሴ።<verse eid="MAT 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3"/>የሱሰረ ይንታ አንንም ኦይትሶ ክትም Ꮊጬ፥ “እታ ጋይድቴ፥ ፋጭካ!” ክትም ጋይሴ። እጳ ሰቅምንክንባበረ ሳነካ እጳ ሰቅምናርንካ ፋጬ። <verse eid="MAT 8:3"/><verse number="4" style="v" sid="MAT 8:4"/>ኮታ ቡር የሱስ፥ እጳ ሰቅምንክንባብ ኤችንም ኩን ጋይሴ፥ “ኮም ሪን Ꮊየንካንተረ Ꮊይከዜ፥ ኬዛርንካ ማቼ፥ አይሳዮ የስታ ማተንም ቀሰንካንታ ሰችካ፥ ማርካ ከታዘን ማተርንግንዳ፥ የስታ ፋጭንተንጎካ ሙሳ ክትሳን እመንም እምካ” ክትም ጋይሴ።<verse eid="MAT 8:4"/></para>
  <para style="s1">የሱስ ፖልስንከስም ገችዝድባብታ ፍክስንባብም ፋችና</para>
  <para style="r">(<ref loc="LUK 7:1-10">ሉቃ. 7፡1-10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5"/>የሱስ ቅፍራናሆም ካተመናር ክት አርደዳንደትካ፥ ዋልቃ ፖልስንከስም ገችዝድባብ ክደር Ꮊድሶ፥ ኩንጋየሮ ክትም ምክሴ፥ <verse eid="MAT 8:5"/><verse number="6" style="v" sid="MAT 8:6"/>“ጮይስዮ፥ እስታ ፍክስንባብና ዎብ ማትሶ፥ አንድር ማጥረሮ ኤሄናር ራትሶ ዶቅዴ” ጋይሴ። <verse eid="MAT 8:6"/><verse number="7" style="v" sid="MAT 8:7"/>የሱሰረ፥ “እታ Ꮊድስቶ ክትም ፋችትቴ” ጋይሴ። <verse eid="MAT 8:7"/><verse number="8" style="v" sid="MAT 8:8"/>ፖልስንከስም ገችዝድባብ ማቼ ጮይስዮ! የና እስታ ኤሄናር አርድካንታ ዝግዝድን ኤድ ካይቴ፥ ኬዛርንካ ማቼ ዋልቃ ቃላ Ꮊክ ኬዝካ፥ እስታ ፍክስንባበረ ፋጭተሬ፥ <verse eid="MAT 8:8"/><verse number="9" style="v" sid="MAT 8:9"/>“እታ እስታ ማታርንካ እዘን ገችታ ኤራ ዶቅድባብከስካንታ ክትምድባብቴ፥ እስታ ታመካ እከትም ክድባብ ዳምንባብከስ ዶቅደኬ፥ ከታርንካ ዋልቀንም ‘አይካ!’ እ ክትም ጋይሴ አይዴ፥ አብንመረ፥ ‘Ꮊድካ!’ እ ክትም ጋይሴ Ꮊዴ፥ እስታ ፍክስንባብመረ፥ ኮም ይካ እ ጋይሴ ይዴ” ኩንጋየሮ ማስሴ።<verse eid="MAT 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10"/>የሱሰረ ኮም ይ ኤሰርሳንደትካ በርእሴ፥ ክታ ካርንካ ጎርስምድ Ꮊቅባብ ኤድንከስም ኩን ጋይሴ፥ “ዶፈን የም ጋይድቴ ኮግንዳ አንድር አሜን ዶቅድባብ ዋልቃ ኤደረ እስራኤልንከሳርንካ Ꮊፋክቴ። <verse eid="MAT 8:10"/><verse number="11" style="v" sid="MAT 8:11"/>በድንከስ Ꮊይታ ዉትንታርንኬ Ꮊይታ አርድንታርንካ Ꮊደኬ፥ አብራሀመካ፥ ይሳቀካ፥ ያይቆበካ ክክን ጭላ ባንችማር እችምካንታ ዶቅተረኬ። <verse eid="MAT 8:11"/><verse number="12" style="v" sid="MAT 8:12"/>ኮ ባንችምን ተይ ዝግዝድባብከሰክ ዶቆ ማል ዶቅድን ግልድድ ኡምናር ኦይትምተረኬ። ኮታረረ ኤፍኬ አች ቅርጭካ ማተረ”።<verse eid="MAT 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13"/>ኮታ ቡር፥ የሱስ ፖልስንከስም ገችዝድባብም “አይካ፥ የስታ አሜንንግንዳ የስካንታ ማታ” ክትም ጋይሴ። ክታ ፍክስንባበረ ኮት ሳአትንዘነረ ፋጬ።<verse eid="MAT 8:13"/></para>
  <para style="s1">የሱስ በድ ሰቅምንክንባብከስም ፋችና</para>
  <para style="r">(<ref loc="MRK 1:29-34">ማር. 1፡29-34</ref>፤ <ref loc="LUK 4:38-41">ሉቃ. 4፡38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14"/>ኮታርንካ የሱስ ጴጥሮስታ ኤሀር አርደዳንᎺይካ ጴጥሮስታ በይስተና ዘና ሶልካ ሰቀርሶ ራችንካ ኮትም ሰጄ። <verse eid="MAT 8:14"/><verse number="15" style="v" sid="MAT 8:15"/>ኮታ አንንም ክት Ꮊጫንደትካ፥ ሳነካ ዘና ሶልነረ ኮትም ዛቅስንካ ና ፋጬ፥ አምትዮ የሱሰም ሞካ የጄ።<verse eid="MAT 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16"/>ፍጨና ሶይቻንደትካ ኤድንከስ ግምዘንካ የደርስባብ በድ ሰቀርስባብከስም የሱሰደር ተይ Ꮊደኬ፥ ኖየረ ይንታ ቃልንካ ቱና አያንንከስም ዉችሴ፥ ሰቀርስባብከስም ሙዳ ፋችሴ። <verse eid="MAT 8:16"/><verse number="17" style="v" sid="MAT 8:17"/>ኮም ክታ ይተንካ ሳብዘንካ ኤስርሶ ኬዛቅባብ ኢስያስካ፥ “ኖ ዎንታ Ꮊዝምንም ተዬ፥ ዎንታ ሰቅምንመረ ባልሴ” ጋይምሶ ኬዝምሳን ቤርና ቦድምሴ።<verse eid="MAT 8:17"/></para>
  <para style="s1">የሱሰታ ካርንካ ጎርስምድባብከስም የልድን ማጣ</para>
  <para style="r">(<ref loc="LUK 9:57-62">ሉቃ. 9፡57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18"/>የሱስ በድ ኤድንከስ ክታ ካንተንካ ሳንምሳን ይ ሰዳንደትካ ባሀርንታ ፋማ ከት ቃልድንግንዳ ይንታ ካርንካ ጎርስምድባብከስም ክትሴ። <verse eid="MAT 8:18"/><verse number="19" style="v" sid="MAT 8:19"/>ኮታ ቡር ዋልቃ ሙሴታ ህግንም ኤስዝድባብ፥ የሱሰደር Ꮊድሶ፥ “ኤስስንባቦ፥ የስ አይድን ካሪ ሙደናር እታ የስም ጎርስምድቴ” ጋይሴ።<verse eid="MAT 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20"/>የሱሰረ “ደበንንከስታ ጎር ዶቅዴ፥ ጭለዘን ፈድን አፍትንከስካንተረ ከት ሳንምድንደታ ኤሀ ዶቅዴ፥ ኤድ ይንችካንታ ማቸ ይንታ ማተንም ዎራ Ꮊዉስዝድንደታ ካሪ ካዬ” ጋይሶ ክትካንታ ማስሴ።<verse eid="MAT 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21"/>ከት ካርንካ ጎርስምድባብከሳርንካ ዋልቀና “የባቦ እርናና አይስቶ እባብም እ ዱግድንግንዳ ጋይካ” ጋይሴ።<note caller="+" style="f"><char style="fr" closed="false">8፡21 </char><char style="ft" closed="false">ዱግድንግንዳ ጋይንትና ባበንም ደእተርን ከካ አላካንታ ጋይሶ ማዴ ኩን ጋይድንዳ ካምዴ </char></note><verse eid="MAT 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22"/>የሱሰረ “የና እም ጎርስምካ፥ ደእስባብከስም ማቼ ደእስባብ ዱግድንግንዳ ከትም ዛእካ” ጋይሴ።<verse eid="MAT 8:22"/></para>
  <para style="s1">የሱስ ባሀርንታዘን ዞግንም ስምሳ ይሴ</para>
  <para style="r">(<ref loc="MRK 4:36-41">ማር. 4፡36-41</ref>፤ <ref loc="LUK 8:22-25">ሉቃ. 8፡22-25</ref>፤ <ref loc="MAT 14:22-23">ማቶ. 14፡22-23</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23"/>የሱሰረ ሎቀንዘንካ ቃልዝድን ጃልበናር አርድንካ፥ ክታ ካርንካ ጎርስምድባብከስ ክትም ጎርስምሰኬ።<verse eid="MAT 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 8:24"/>አንድር ቡርበች ዞገና ባሀርንዘን አምሳንካንታ ሎቀንዘን ዞገና ጃልበንም ሎቀናር ኤቅዝስካንታ የልሴ፥ የሱስ ማቼ ራትሶ Ꮊቄ። <verse eid="MAT 8:24"/><verse number="25" style="v" sid="MAT 8:25"/>ክታ ካርንካ ጎርስምድባብከሰረ የሱሰደር Ꮊድሰኮ፥ “ጮይስዮ! ዎታ ካይታ ይዶቴ ዎም አቅስካ!” ጋይሰኮ ክትም ንግሰኬ።<verse eid="MAT 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26"/>ኖየረ፥ “የንታ አሜን ዞገርስባብከስ! Ꮊረተንት ጳዝዳ?” ኬትም ጋይሴ። ኮታ ቡር የሱስ አምሶ ሎቀንዘን አምሳን ቡርበችንምኬ ባሀርንም ዋጬ፥ ኮታዘንከረ አንድር ስምን ጋይሴ።<verse eid="MAT 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27"/>ኤድንከሰረ በርእሰኮ፥ “ባሃርንምኬ ባሀርንዘን አምድን ዞገና ክትካንታ ክትምድባብ ኖኮና ኤችና Ꮊይራ?” ጋይሰኬ።<verse eid="MAT 8:27"/></para>
  <para style="s1">የሱስ ግምዘካ የድምስባብ ቃስተን ኤድን ፋችና</para>
  <para style="r">(<ref loc="MRK 5:1-20">ማር. 5፡1-20</ref>፤ <ref loc="LUK 8:26-29">ሉቃ. 8፡26-29</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28"/>የሱስ ገሊላ ባሀርንም ቃልሶ፥ ገርገሰኖን ፍጫር ክት Ꮊድንደትካ፥ ግምዘካ የደርስባብ ቃስተን ኤድንከስ ዱክ ዶቅድን ካርያርንካ ዉትሶ Ꮊፈርሰኬ፥ አንድር ማእዝድባብ ከት ማቻንካንታ Ꮊየነረ ኤድ ኮት ጎግንካ ስግዳክ Ꮊቄ። <verse eid="MAT 8:28"/><verse number="29" style="v" sid="MAT 8:29"/>ከተረ፥ “የና ሳብታ ይንችኖ፥ ዎንካክክን የስታ Ꮊራ ዶቅዳ? ሰጨና የላክናና ዎም ማእስካንተስ Ꮊዶ?” ጋየረኮ ፍፍሰኬ።<note caller="-" style="x"><char style="xo" closed="false">8፡29 </char><char style="xt" closed="false"><ref loc="JDG 11:12">ዳኝ. 11፡12</ref>፤ <ref loc="2SA 16:10">2 ሳሙ. 16፡10</ref>። </char></note><verse eid="MAT 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30"/>ከታዘንካ ቶክም ጎተርሳን ካርዘን በድ ጉድምንከስታ ዉዳ ግስምድ Ꮊቄ። <verse eid="MAT 8:30"/><verse number="31" style="v" sid="MAT 8:31"/>ግምዘንከሰረ “የስ ዎም ዉችዝድንዳ ማቼ፥ ዋደ ኦኮ ጉድምንከስታ ዉደናር ዎም ኦይትካ!” ጋየሮ ምክሰኬ። <verse eid="MAT 8:31"/><verse number="32" style="v" sid="MAT 8:32"/>የሱሰረ “አይከቴ!” ኬትም ጋይሴ። ኮካንተረ ኤድንከሳርንካ ዉትሶ ጉድምንከሳር አይሶ አርደደኬ። ጉድምንከሰረ ሙዳ ከታ ይ ዶቅድን ገችንታ ዱረንዘንካ ታድምሶ ባሀርንታ ዋር ኤቅዝምሰኮ ደእሰኬ። <verse eid="MAT 8:32"/><verse number="33" style="v" sid="MAT 8:33"/>ጉድምንከስም ግዝድባብከሰረ Ꮊዝሶ ኦስ ካተመናር አርድሰኮ ሙዳ ርን ኬዘኬ፥ ግምዘንካ የደርሳን ኤድንከዘን ይይምሳን ርን ኬዘኬ። <verse eid="MAT 8:33"/><verse number="34" style="v" sid="MAT 8:34"/>ኮታ ቡር ካተመናር ኤድንከስ ሙዳ የሱሰም ሰድንካንታ ዉተደኬ፥ ክትም ከታ ይ ሰዳንደትካ ከታ ፍጨናርንካ ዉትሶ ክት አይድንግንዳ ክትም ምክሰኬ።<verse eid="MAT 8:34"/></para>
  <chapter eid="MAT 8"/>
  <chapter number="9" style="c" sid="MAT 9"/>
  <para style="s1">የሱስ ዎብ ኤችንም ፋችና</para>
  <para style="r">(<ref loc="MRK 2:3-12">ማር. 2፡3-12</ref>፤ <ref loc="LUK 5:18-26">ሉቃ. 5፡18-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1"/>ኮታ ቡር የሱስ ባሃርንዘነካ ቃልዝድን ጃልበናር አርድሶ ባሀርን ቃልሶ ይንታ ገታ ካተመናር Ꮊዴ። <verse eid="MAT 9:1"/><verse number="2" style="v" sid="MAT 9:2"/>ኮታረረ ኤድንከስ ሰለዘን ራችባብ ዋልቃ ዎብ ኤችም ባልሰኮ ክደር ተይᎺደኬ። የሱሰረ ከታ አሜንንም ሰድሶ፥ ዎብ ኤችንም “እስታ ይንችኖ! ዳእካ፥ ጎመና የስታ ነገቴ” ክደር ጋይሴ። <verse eid="MAT 9:2"/><verse number="3" style="v" sid="MAT 9:3"/>ኮታይካ ዋልቃ ዋልቃ ሙሴታ ህግን ኤስዝድባብከስ፥ “ኮና ኤችና ሳብም የግዴ!” ጋየረኮ ይንታ ቡዳር ገቀርሰኬ። <verse eid="MAT 9:3"/><verse number="4" style="v" sid="MAT 9:4"/>የሱሰረ ከታ ገቅርንም ኤስሶ፥ ኩን ከደር ጋይሴ፥ Ꮊረካንተንት ኮም ዳቅል ሪን የንታ ቡዳር ገቀርዳ? <verse eid="MAT 9:4"/><verse number="5" style="v" sid="MAT 9:5"/>ይና ጎመና የስታ ነጋ ጋይምቴ ጋይንተዘንኬ አምሳዮ አይካ ጋይንተዘንካ Ꮊምና ኡርዳ? <verse eid="MAT 9:5"/><verse number="6" style="v" sid="MAT 9:6"/>ኬዛርንካ ማቼ “ኤድ ይንች ፍጨዘን ጎመንም ነክስካንታ ገችታ ኤራ ክታ ዶቅድንደትም የ ኤስተርንግንዳ” ዎብ ኤችን “አምሳዮ የስታ ሰለንም ባልሰዮ የስታ ኤር አይካ” ክትም ጋይሴ። <verse eid="MAT 9:6"/><verse number="7" style="v" sid="MAT 9:7"/>ኤችነረ አምሶ ይንታ ኤር አይሴ። <verse eid="MAT 9:7"/><verse number="8" style="v" sid="MAT 9:8"/>ዎርሰነረ ኮም ከታ ይ ሰዳንደትካ በርእሰኬ፥ ኮግንዳ ዶቅድን ገችታ ኤራ ኤድካንታ እምሳንኦል ሳብም ጋለቸኬ።<verse eid="MAT 9:8"/></para>
  <para style="s1">የሱስ ማትዮሰም ኤልና</para>
  <para style="r">(<ref loc="MRK 2:13-17">ማር. 2፡13-17</ref>፤ <ref loc="LUK 5:27-32">ሉቃ. 5፡27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9"/>የሱስ ኮት ካርናርንካ አምሶ ክት አይድንካ ማቶስ ጋይምስባብ ቃረጭ ተችዝድን ካርዘን ክት ዶቅድንካ ሰድሶ “እም ጎርስምካ” ክትም ጋይሴ ኖየረ አምሶ ክትም ጎርስምሴ። <verse eid="MAT 9:9"/><verse number="10" style="v" sid="MAT 9:10"/>ኮታ ቡር የሱስ ማቶሰታ ኤሪ እችምካንታ ዶቅሶ ዶቅድንካ ቃረጭን ተችዝድባብከስከ ጎመንባብከስ በድና ኮታር Ꮊድሰኮ የሱሰደርኬ ክታ ካርንካ ጎርስምድባብከስካ ክክን እችምካንታ ዶቅሰኬ። <verse eid="MAT 9:10"/><verse number="11" style="v" sid="MAT 9:11"/>ፈረሳዊያንንከሰረ ኮም ሰድሰኮ ክታ ካርንካ ጎርስምድባብከስም “የንታ ኤስስንባብ ቃረጭን ተችዝድባብከስኬ ጎመንባብከስካ ክክን Ꮊረትክ እጅዳ?” ከደር ጋይሰኬ።<note caller="-" style="x"><char style="xo" closed="false">9፡11 </char><char style="xt" closed="false"><ref loc="MAT 15:1-2">15፡1-2</ref>። </char></note> <verse eid="MAT 9:11"/><verse number="12" style="v" sid="MAT 9:12"/>የሱሰረ ኮም ኤሰርሶ፥ “አክም ዝግዝድንዳ ሰቀርስባብከስም ዳት ኡርመንከስካንታ ዝክሳዬ። <verse eid="MAT 9:12"/><verse number="13" style="v" sid="MAT 9:13"/>አይከቴ ‘እ ዝግድንዳ አብንካንታ አትርንም ዳት ካሲንም ካዬ’ ጋይምሶ ጻፍምሳንዳ Ꮊስጋይንት ማቸረ ማስት ሰድንተካ ገቀርት ተይከቴ። እ Ꮊዳንዳ ጭልንከስካንታ ማታክናና ጎመንባብከስም ኤልካንቴ” ኩን ከደር ጋይሴ።<verse eid="MAT 9:13"/></para>
  <para style="s1">በቼካ ምክስጎካ ኦይስምሳን ኦይስ</para>
  <para style="r">(<ref loc="MRK 2:18-22">ማር. 2፡18-22</ref>፤ <ref loc="LUK 5:33-39">ሉቃ. 5፡33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14"/>ኮታይካ፥ ዮሀንሴታ ካርንካ ጎርስምድባብከስ የሱሰደር፥ “ዎንኬ ፈረሳውያን ኤድንከስ ሙዳᎺይካ በቼካ ምግዝዶቴ፥ የስታ ካርንካ ጎርስምድባብከስ ማቼ ከት በቼካ ምግዝዳክንዳ Ꮊረተረ?” ጋይሰኮ ኦይሰኬ። <verse eid="MAT 9:14"/><verse number="15" style="v" sid="MAT 9:15"/>የሱሰረ “እንቸንባብ ከትካ ክክን ዶቅድንካ እሰናርንባብከስ ሞርእ ከትም ዝግዝዶ? ኬዛርካ ማቼ እንቸንባብ ከታዘንካ ተይምድን ሰጫ Ꮊዴ ኮትᎺይካ በቼካ ምግዝደኬ። <verse eid="MAT 9:15"/><verse number="16" style="v" sid="MAT 9:16"/>ገሰርሳን አፍለዘን ክለንታ ተችምን ዛግድባብ Ꮊየነረ ካዬ፥ ዘን ኮት ዛግድንዳ ማቼ ክለንታ ተችምና ገሳ አፍለንም ፎጭሶ Ꮊእምንም ስግስሶ ዳልግዝዴ። <verse eid="MAT 9:16"/><verse number="17" style="v" sid="MAT 9:17"/>ኮት ኮግንደረ ገሰርሳን ሎቀታ ሱልፈንካ ክላ ዎይን ጩጰርሳንደትም ዎድባብ Ꮊየነረ ካዬ ኮና ይይምሳን ማቼ ሱልፈና ፉእደ ዎይንነረ ጩጰርሳንደረ ዉልእምዴ፥ ሱልፈነረ ባድሶ መይዳክንዳ ማዴ። ኬዛርካ ማቼ ክላ ዎይን ጩጰረሳን ክላ ሱልፈናር ዎድ ዝግዝዴ፥ ኮግንደካ፥ ቃስተነረ ኡርመካ ካርስምሰኮ ዶቅተረኬ” ኩንጋየሮ ከትካንታ ማስሴ።<verse eid="MAT 9:17"/></para>
  <para style="s1">እያሮስታ ይንችንጎኬ የሱሰታ አፍለን ዎልሳን ኤተንንጎካ</para>
  <para style="r">(<ref loc="MRK 5:21-43">ማር. 5፡21-43</ref>፤ <ref loc="LUK 8:40-56">ሉቃ. 8፡40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18"/>የሱስ ኮም ከትካንታ ከዛዶቅድንካ፥ ዋልቃ አይሁድንከስም ገችዝድባብ ክደር Ꮊድሶ፥ የሱሰታ እሪ ጉምፈርሶ፥ “ይና፥ እስታ ይንቸና ታ ደእሴ፥ ኬዛርካ ማቼ የና Ꮊድሰዮ የስታ አንን ኮታዘን የስ ዎጄ ና ሰንፐካ ማተረ” ክደረ ጋይሴ። <verse eid="MAT 9:18"/><verse number="19" style="v" sid="MAT 9:19"/>የሱሰረ አምሶ ኤችንታ ካርካ አይሴ፥ ክታ ካርንካ ጎርስምድባብከሰረ ክትካ የካ አይሰኬ።<verse eid="MAT 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20"/>ይና፥ ታመከ ቃስተን ስላ ሙዳ ማቀስ ኮታ ዉልእምድንካ ማጠርድ Ꮊቃን ዋልቃ ኤተን፥ የሱሰታ ቡርጎካ Ꮊድሶ ክታ አፍለንታ ካንተንም ዎልሴ። <verse eid="MAT 9:20"/><verse number="21" style="v" sid="MAT 9:21"/>ኮመረ ኮት ይሳንዳ “ክታ አፍለንም Ꮊክ ዎራ እ ዎልሳናና እታ አቅድቴ” ጋይሶ ይንታ ቡዳር ኮት ገቀርሳንካንቴ። <verse eid="MAT 9:21"/><verse number="22" style="v" sid="MAT 9:22"/>የሱሰረ ዋልን ጋይሶ ኮትም ሰድሶ “ዳእካ እስታ ይንቸኖ! የስታ አሜንና የስም አቅስቴ” ኮደር ጋይሴ። ኤተነረ ሳነካ ፋጬ።<verse eid="MAT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23"/>ኮታ ቡር የሱስ አይሁድንከስም ገችዝድባብታ ኤሪ ክት የልድንካ ሞርእካ ፍቼን ፉገረኮ ኦስኬ ፈንካ ፍፈሮ ኤብድን ኤድንከስም ሰዴ። <verse eid="MAT 9:23"/><verse number="24" style="v" sid="MAT 9:24"/>ኖየረ “የታ ሙደና ካርንካ ዉትከቴ! ይንቸንና ግንእሳ ዳት ደአክዬ!” ከደር ጋይሴ። ኬታ ማቼ Ꮊልተርካ ክታዘን ይንጨኬ። <verse eid="MAT 9:24"/><verse number="25" style="v" sid="MAT 9:25"/>ኤድንከስ ኤሄናርንካ ዉተዳንደታ ቡሪ፥ የሱስ ይንቸንን ዶቅድን ካርናር አርድሶ ኮታ አንንም የጄ፥ ይንቸንነረ አምሴ። <verse eid="MAT 9:25"/><verse number="26" style="v" sid="MAT 9:26"/>ኮና ይይምሳንዳ ኮት ፍጨናር ሙዳ ኤስምሴ።<verse eid="MAT 9:26"/></para>
  <para style="s1">የሱስ ቃስተን አፍይ ዝልንከስም ፋችና</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27"/>የሱስ ካርንኮታርንካ አምሶ ክት አይድንካ አፍይ ዝልንከስ ቃስተንና ክትም ጎርስምሰኬ፥ ከተረ “ዳውተታ ይንችኖ! ዋደ ዎም አጨርካ!” ጋየረኮ ፍብድ Ꮊቀኬ።<verse eid="MAT 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28"/>የሱስ ኤሄናር ክት አርደዳንደትካ አፍይ ዝልንከስ ክደር Ꮊደኬ፥ ኖየረ “እታ ኮም እ ይድንደትም የታ አመንደቴ?” ከደር ጋይሴ። ከተረ “ይዬ፥ የ ጮይስዮ!” ጋየረኮ ክደር ማስሰኬ።<verse eid="MAT 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29"/>ኮታ ቡር የሱስ ከታ አፍንከስም Ꮊጭሶ “የንታ አሜንንግንዳ የካንታ ማታ!” ከትም ጋይሴ። <verse eid="MAT 9:29"/><verse number="30" style="v" sid="MAT 9:30"/>ከታ አፍንከሰረ ፎችምሰኬ፥ “የሱሰረ ኮም ሪን Ꮊየንካንተረ Ꮊይከዘቴ!” ጋይንተካ ዳቅስሶ ከትም ክትሴ። <verse eid="MAT 9:30"/><verse number="31" style="v" sid="MAT 9:31"/>ከታ ማቼ አይሰኮ ኮታር ዶቅድን ፍጫ ሙደናር የሱሰታ ፍክስንጎካ ኬዘኬ።<verse eid="MAT 9:31"/></para>
  <para style="s1">የሱስ ዋልቃ አፋ ኬዝዳክባብ ኤችን ፋችና</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32"/>አፍና ከታ ፎችምስባብ ኤድንከስ ዉትሰኮ ከት አይሳንደትካ አብ ኤድንከስ ግምዘካ የደርስባብ ዋልቃ አፋ ከዝዳክን ኤችም የሱሰደር ተይ Ꮊደኬ። <verse eid="MAT 9:32"/><verse number="33" style="v" sid="MAT 9:33"/>ግምዘና ክታዘንካ ዉተዳንደትካ አፋ ከዝዳክን ኤችና ኬዜ፥ ዎርሰነረ “ኮግንዳ ር እስራኤልንከሳር ቦድሶ ሰድምሶ ኤስማዬ!” ጋየረኮ በርእሰኬ።<verse eid="MAT 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34"/>ፈረሳውያንንከስ ማቼ፥ “ክት ግምዘን ዉችዝድንዳ ግምዘንከስም ገችዝድባብጎኬ” ጋይሰኬ።<note caller="-" style="x"><char style="xo" closed="false">9፡34 </char><char style="xt" closed="false"><ref loc="MAT 10:25">ማቶ. 10፡25</ref>፤ <ref loc="MAT 12:34">12፡34</ref>፤ <ref loc="MRK 3:22">ማር. 3፡22</ref>፤ <ref loc="LUK 11:15">ሉቃ. 11፡15</ref>። </char></note><verse eid="MAT 9:34"/></para>
  <para style="s1">የሱስ ዎርሰንካንታ ቡዳርንካ አትርና</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35"/>የሱሰረ አይሁድንታ ምክስ ኤሄናር ኤስሰሮ፥ ሳብ ባንችምታ ክላ ኬዘን ሳባከሮ፥ ዎርሰንም ሰቅምናርንኬ፥ Ꮊዝምናርንካ ሙዳ ፋችሰሮ፥ ካተመንከሳርኬ ሞረንከሳር ሙዳ ኦንገሮ Ꮊቄ።<note caller="-" style="x"><char style="xo" closed="false">9፡35 </char><char style="xt" closed="false"><ref loc="MAT 4:23">ማቶ. 4፡23</ref>፤ <ref loc="MRK 1:39">ማር. 1፡39</ref>፤ <ref loc="LUK 4:44">ሉቃ. 4፡44</ref>። </char></note> <verse eid="MAT 9:35"/><verse number="36" style="v" sid="MAT 9:36"/>ዎርሰና ማቼ ግስመንባብ ካየን ቆልንከስግንዳ ማጠርስንደትከ ዛቅምሶ ከት ዶቅድንደትም ሰድሶ ከትካንታ ሞርእሴ።<note caller="-" style="x"><char style="xo" closed="false">9፡36 </char><char style="xt" closed="false"><ref loc="NUM 27:17">ፋይ. 27፡17</ref>፤ <ref loc="1KI 22:17">1 ባንቺ. 22፡17</ref>፤ <ref loc="2SA 18:16">2 ሳሙ. 18፡16</ref>፤ <ref loc="EZK 34:5">ሕዝ. 34፡5</ref>፤ <ref loc="ZEC 10:2">ዘካ. 10፡2</ref>፤ <ref loc="MRK 6:34">ማር. 6፡34</ref>። </char></note><verse eid="MAT 9:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 9:37"/>ኮካንታ ይንታካርንካ ጎርስምድባብከስም፥ “ስከርድንዳ በድዬ፥ ስክድባብከስ ማቼ ቶክመኬ። <verse eid="MAT 9:37"/><verse number="38" style="v" sid="MAT 9:38"/>ይና ፍክስንባብከስም ስክንካንታ ኦይድንግንዳ ስከርድንደታ ጮይስንም ምክስከቴ” ኩን ከትካንታ ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">9፡38 </char><char style="xt" closed="false"><ref loc="LUK 10:2">ሉቃ. 10፡2</ref>። </char></note><verse eid="MAT 9:38"/></para>
  <chapter eid="MAT 9"/>
  <chapter number="10" style="c" sid="MAT 10"/>
  <para style="s1">ታመኬ ቃስተን ኦይትምስባብከስ</para>
  <para style="r">(<ref loc="MRK 13:16-19">ማር. 13፡16-19</ref>፤ <ref loc="LUK 6:12-16">ሉቃ. 6፡12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1"/>የሱስ ታመኬ ቃስተን ይንታ ካርንካ ጎርስምድባብከስም ይንደር ኤልሶ፥ ቱና አያንንከስም ከት ዉጅድንግንዳ፥ ሰቀርስባብከስምኬ Ꮊዝምክንባብም ሙዳ ከት ፋጅድንግንዳ ገችታ ኤራ ከትካንታ እምሴ።<verse eid="MAT 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 10:2"/>ታመኬ ቃስተን ኦይተርስባብከስተረ ላምና ኬኔ፥ እርምሶ ጴጥሮስ ጋይምስባብ ስምኦንኬ ክታ እስመን እንደራሰካ፥ ዛብዶሰታ ይንችንከስ ያይቆበኬ ዮሀንሰካ፥ <verse eid="MAT 10:2"/><verse number="3" style="v" sid="MAT 10:3"/>ፍልጶስ፥ በርቶሎመዎስ፥ ቶማስ፥ ቃረጭን ተችዝድባብ ማቶስ፥ እልፎሰታ ይንች ያይቆብ ታደዎስ፥ <verse eid="MAT 10:3"/><verse number="4" style="v" sid="MAT 10:4"/>ይንታ ፍጨንካንታ ገቀርድባብ ስምኦን፥ ስክስት እምስባብ አስቆሮንት ይሁዴ።<note caller="+" style="f"><char style="fr" closed="false">10፡4 </char><char style="ft" closed="false">አስቆሮንት ይሁዳ ኮ ቃለንዘን ቃስተን ገቅር ዶቅዴ። </char></note><verse eid="MAT 10:4"/></para>
  <para style="s1">ታምኬ ቃስተን ኦይትምስባብከስም ኤስስካንታ ኦይትምና</para>
  <para style="r">(<ref loc="MRK 6:7-13">ማር. 6፡7-13</ref>፤ <ref loc="LUK 9:1-6">ሉቃ. 9፡1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5"/>የሱስ ከትከም ታመኬ ቃስተን ኦይትምስባብከስም ኦይቼ፥ ኩነረ ጋይሶ ከትም ክትሴ፥ አይሁድ ማታክባብከዝደር Ꮊይ አየቴ፥ ሳማርያ ካተመንከሳር Ꮊይ አርደቴ፥ <verse eid="MAT 10:5"/><verse number="6" style="v" sid="MAT 10:6"/>ስግስሶ ቆልንከስግንዳ ካይድባብ እስራኤል ዎርሰንደር አይከቴ። <verse eid="MAT 10:6"/><verse number="7" style="v" sid="MAT 10:7"/>አይሰቶ ጭላ ባንችምና ቅንችቴ ጋየረቶ ሳባከቴ።<note caller="-" style="x"><char style="xo" closed="false">10፡7 </char><char style="xt" closed="false"><ref loc="LUK 10:4-12">ሉቃ. 10፡4-12</ref>። </char></note> <verse eid="MAT 10:7"/><verse number="8" style="v" sid="MAT 10:8"/>ሰቀርስባብከስም ፋችከቴ፥ ደእስባብከስም አምስከቴ፥ እጳ ሰቅምንክንባብከስመረ ፋችከቴ፥ ግምዘንከስመረ ዉችስከቴ፥ ዉች የ ተያንደትም ዉች እምከቴ። <verse eid="MAT 10:8"/><verse number="9" style="v" sid="MAT 10:9"/>ዎርቃ አነረ ዱንድ አነረ ጋይካ ኡርሰርሳን ብራ የንታ ክስያር Ꮊይ የደቴ። <verse eid="MAT 10:9"/><verse number="10" style="v" sid="MAT 10:10"/>ፍክስንባብከስካንታ እችም ዝግዝድንዳ ማቻንካንታ የንታ ጎግንካንታ ሱልፋ፥ ስጥመካ ሳምዝ፥ ጫማ ጉፈረ Ꮊይ የደቴ።<note caller="-" style="x"><char style="xo" closed="false">10፡10 </char><char style="xt" closed="false"><ref loc="1CO 9:14">1 ቆሮ. 9፡14</ref>፤ <ref loc="1TI 5:18">1 ጢማ. 5፡18</ref>። </char></note><verse eid="MAT 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11"/>የ አርድን ካተመናር አነረ ሞረናር፥ የም ሞግድባብ Ꮊይናነረ ኡርስት ኤስከቴ፥ ካርን ኮትመረ ዛቅሰቶ የ ዉተርን የለልታ ክትካ ክክን ዶእከቴ። <verse eid="MAT 10:11"/><verse number="12" style="v" sid="MAT 10:12"/>ኤታ ኤር አርደቶ አበቶ ጋይከቴ። <verse eid="MAT 10:12"/><verse number="13" style="v" sid="MAT 10:13"/>ኤሄና የ አበቶ ጋይድንካ ሞግድባብ ማቼ የንታ አቦና ክትም የላጋካ፥ ሞግዳክባብ ክት ማቼ የንታ አቦና የካንታ ማታ። <verse eid="MAT 10:13"/><verse number="14" style="v" sid="MAT 10:14"/>Ꮊየነረ ኤድ የም ሞግዳክባብ አነረ የንታ ቃለንም ኤሰርዳክባብ ማቼ ኮትኮ ኤሄን አነረ ካተመን ዛቅሶ ዉደቶ ከትካንታ ኤግዝምስ ማድንግንዳ የንታ ዱትታ ቡልንም ድንግስከቴ።<note caller="-" style="x"><char style="xo" closed="false">10፡14 </char><char style="xt" closed="false"><ref loc="ACT 13:51">ኦይት. ፍ. 13፡51</ref>። </char></note> <verse eid="MAT 10:14"/><verse number="15" style="v" sid="MAT 10:15"/>ዶፈን የም ጋይድቴ፥ ፍርዳ ሰጨንካ ኮትኮ ካተመንዘንካ ስግስሶ ሶዶም ካተመንካንተከ ገሞራ ኤድንከስካንታ ዋጭና ቶግዴ።<note caller="-" style="x"><char style="xo" closed="false">10፡15 </char><char style="xt" closed="false"><ref loc="MAT 11:24">ማቶ. 11፡24</ref>፤ <ref loc="GEN 19:24-29">ፍዝ. 19፡24-29</ref>። </char></note><verse eid="MAT 10:15"/></para>
  <para style="s1">Ꮊድን ማጠከ ዳይርካ</para>
  <para style="r">(<ref loc="MRK 13:3-13">ማር. 13፡3-13</ref>፤ <ref loc="LUK 21:12-17">ሉቃ. 21፡12-17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16"/>“ኮሰቸቴ! ቆልንከስግንዳ ጋርመንከስታ ዎክያር የም ኦይትቴ፥ ኮካንታ ጉንንግንዳ አጋ፥ ዎለንግንዳ ቡዳር ዳቅል ካየንባብ ማትከቴ”።<note caller="-" style="x"><char style="xo" closed="false">10፡16 </char><char style="xt" closed="false"><ref loc="LUK 10:3">ሉቃ. 10፡3</ref>። </char></note> <verse eid="MAT 10:16"/><verse number="17" style="v" sid="MAT 10:17"/>ኤድንከስ የም ፍርደን እምድባብከዝደር ስክስት እምተረኬ፥ አይሁድንከስ ይንታ ምክስ ኤሄንከሳር የም Ꮊርተረኬ፥ ኮካንታ ኤድንከዘንካ ካርስምከቴ።<note caller="-" style="x"><char style="xo" closed="false">10፡17 </char><char style="xt" closed="false"><ref loc="MRK 13:9-11">ማር. 13፡9-11</ref>፤ <ref loc="LUK 12:11-12">ሉቃ. 12፡11-12</ref>፤ <ref loc="LUK 21:12-15">21፡12-15</ref>። </char></note> <verse eid="MAT 10:17"/><verse number="18" style="v" sid="MAT 10:18"/>እጎካ፥ ፍጨን ቆልድባብከዝደርኬ ባንችምንከዝደር ፍርዳካንታ የ ተይ አይምድንካንታ ከትኬ አይሁድ ማታክባብከስታ እሪ እስታ ማርከንከስ ማተረቴ፥ <verse eid="MAT 10:18"/><verse number="19" style="v" sid="MAT 10:19"/>ኤድንከስ ፍርደን እምድባብከዝደር የም ተይᎺድንካ የ ኬዝድን ሪ ኮትኮ ሳዓትንዘን የካንታ እምድንካንታ Ꮊስግንዶንት አነረ Ꮊሮንት ኬዝቴ? ጋይሰቶ ገቅርካ Ꮊይማጠረቴ፥ <verse eid="MAT 10:19"/><verse number="20" style="v" sid="MAT 10:20"/>የንታዋር ዶቅሶ ኬዝድባብ ጭላር የንታ ባቤን ሳብንታ አያንና ዳት የታ ካየቴ።<note caller="-" style="x"><char style="xo" closed="false">10፡20 </char><char style="xt" closed="false"><ref loc="MRK 13:12">ማር. 13፡12</ref>፤ <ref loc="LUK 21:16">ሉቃ. 21፡16</ref>። </char></note><verse eid="MAT 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21"/>ኤድ ይንታ ገታ እስመንም ደእካንታ ስክስት እምተሬ፥ ኮትኮግንደረ ባቤና ይንታ ገታ ይንችንም ደእካንታ ስክስት እምተሬ፥ ይንችንከሰረ ይም አጭባብከዘን ይምኤንባብ ማትሰኮ አምተረኬ፥ ደእካንተረ ስክስት ከትም እምተረኬ። <verse eid="MAT 10:21"/><verse number="22" style="v" sid="MAT 10:22"/>እጎካ ኤድ ሙደንታ ላመር የታ ቦስምስባብ ማተረቴ፥ ኬዛርንካ ማቼ በእንታ የለልታ ዳቅሶ ዎእድባብ አቅተሬ።<note caller="-" style="x"><char style="xo" closed="false">10፡22 </char><char style="xt" closed="false"><ref loc="MAT 24:9">ማቶ. 24፡9</ref>፥<ref loc="MAT 24:13">13</ref>፤ <ref loc="MRK 13:13">ማር. 13፡13</ref>፤ <ref loc="LUK 21:17">ሉቃ. 21፡17</ref>። </char></note><verse eid="MAT 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 10:23"/>ዋልቃ ካተማር ማጣ የንዘን በጅድንካ፥ ኦስ አብናር አጥምከቴ፥ ዶፈን የም ጋይድቴ ኤድ ይንች ማት Ꮊተርን የለልታ እስራኤልንከስታ ካተመንከስም ሙዳ የንታ ፍክስንም የልሳየቴ።<verse eid="MAT 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24"/>ኤስካንታ ዝግድባብከስ ኤስዝድባብዘንካ ስጋየ፥ ፍክስንባብና ይንታ ማታ ቆልስባብዘንካ ስጋየ።<note caller="-" style="x"><char style="xo" closed="false">10፡24 </char><char style="xt" closed="false"><ref loc="LUK 6:40">ሉቃ. 6፡40</ref>፤ <ref loc="JHN 13:16">ዮሀ. 13፡16</ref>፤ <ref loc="JHN 15:20">15፡20</ref>። </char></note> <verse eid="MAT 10:24"/><verse number="25" style="v" sid="MAT 10:25"/>ኮካንታ ኤስካንታ ዝግድባብ ይንታ ኤስስንባብግንዳ፥ ፍክስንባበረ ይንታ ማተን ቆልስባብግንዳ ማቼ ክትም ማዴ። ኤሄንታ ባቤንም፥ ብኤልዘቡል ጋይሶ ክትም ከት ኤልሴ ክታ ኤሀ ኤድንከስም ኮዘንካ ቦርድን ላምካ Ꮊስግንዳ ኤላይንዳ!<note caller="-" style="x"><char style="xo" closed="false">10፡25 </char><char style="xt" closed="false"><ref loc="MAT 9:34">ማቶ. 9፡34</ref>፤ <ref loc="MAT 12:24">12፡24</ref>፤ <ref loc="MRK 3:2">ማር. 3፡2</ref>፤ <ref loc="LUK 11:15">ሉቃ. 11፡15</ref>። </char></note><verse eid="MAT 10:25"/></para>
  <para style="s1">Ꮊይም ጳስ ዝግዝዳናንከረ</para>
  <para style="r">(<ref loc="LUK 12:4-7">ሉቃ. 12፡4-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26"/>ይና ኤድንከስም Ꮊይ ጳሰቴ፥ ክጭምሳንዳ መያ ማት ነገዳክዬ፥ አችምሳንደረ ኤስማክዶቆ ነጋዬ።<note caller="-" style="x"><char style="xo" closed="false">10፡26 </char><char style="xt" closed="false"><ref loc="MRK 4:22">ማር. 4፡22</ref>፤ <ref loc="LUK 8:17">ሉቃ. 8፡17</ref>። </char></note> <verse eid="MAT 10:26"/><verse number="27" style="v" sid="MAT 10:27"/>ኮካንታ እ የም ኡማር ኬዝድንደትም፥ የታ ሳክማር ኬዝከቴ፥ ዎክስምካ የ ኤሰርሳንደትም ጬክን ጋይሳን ካርዘን ሳባከቴ። <verse eid="MAT 10:27"/><verse number="28" style="v" sid="MAT 10:28"/>ዋሄንም ደይሰዘንካ ስግሶ ሰንፔንም ደይሳካንታ ማዳክባብ ኤድንከስም Ꮊይጳሰቴ፥ ስክስሰረ ሰንፔንምኬ ዋሄንም ድግዳክን ኖሄናር ካይስካንታ ማድባብ ጮይስንካንታ ጳስከቴ። <verse eid="MAT 10:28"/><verse number="29" style="v" sid="MAT 10:29"/>ቃስተን አፍት ስልንከስ ዋልቃ ባከነካ ሰንምደክካዮ? ማታጋካ ዳት፥ ጭላር የንታ ባበና ጋያክናና ዋልቃ ስልና ዎራ ፍጨዘን ዋቻዬ። <verse eid="MAT 10:29"/><verse number="30" style="v" sid="MAT 10:30"/>የንታ ማቼ ማተታ ስጭና ዋልቃ ዋልቀና ዎራ ፋይድምሳንዴ። <verse eid="MAT 10:30"/><verse number="31" style="v" sid="MAT 10:31"/>ይና የታ ማቼ በድ ስልንከዘንካ አንድር የ ስገድንካንታ ቦድሶ Ꮊይ ጳሰቴ።<verse eid="MAT 10:31"/></para>
  <para style="s1">ክርስቶስጎካ ማርክር ዝግዝድንዳ ማትና</para>
  <para style="r">(<ref loc="LUK 12:8-9">ሉቃ. 12፡8-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32"/>“ኤታ እሪ እካንታ ይ ማቻንደትም ማርከርድባብ ሙደንካንታ፥ እተረ ጭላር ዶቅድባብ እስታ ባቤንታ እሪ ማርከርትቴ፥ <verse eid="MAT 10:32"/><verse number="33" style="v" sid="MAT 10:33"/>ኤታ እሪ እም ካድባብም፥ ሙዳ እተረ ጭላር ዶቅድን እስታ ባቤንታ እሪ ክትም ካድቴ”።<note caller="-" style="x"><char style="xo" closed="false">10፡33 </char><char style="xt" closed="false"><ref loc="2TI 2:12">2 ጢማ. 2፡12</ref>። </char></note><verse eid="MAT 10:33"/></para>
  <para style="s1">ሳራትች ማታክናና ፋስሜ</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34"/>እ Ꮊዳንዳ፥ ሳራትቼንም ፍጨዘን ተይᎺድካንታ Ꮊዳን የም Ꮊይካማ፥ እታ ፋስምን ዳት ሳራትቼን ተይᎺድካንታ Ꮊዳክቴ። <verse eid="MAT 10:34"/><verse number="35" style="v" sid="MAT 10:35"/>እ Ꮊዳንዳ፥ አⷝና ይንችና ባቤንታዘን፥ ማና ይንችና እንደንታዘን፥ ይንችንታ ኬነና ይንችንታ እንደንዘን ይምኤንባብ ማስሶ አምስስካንቴ። <verse eid="MAT 10:35"/><verse number="36" style="v" sid="MAT 10:36"/>ኮካንታ ኤታ ይምኤንባብከስ፥ ገታ ከታ ኤሀ ኤድንክስ ማደኬ።<note caller="-" style="x"><char style="xo" closed="false">10፡36 </char><char style="xt" closed="false"><ref loc="MIC 7:6">ሚክ. 7፡6</ref>። </char></note><verse eid="MAT 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37"/>እዘንካ ስክስሶ ይንታ ባቤንም አነረ ይንታ እንደንም ሶልምድባብ፥ እካንታ ማት ክትም ዝክሳዬ፥ እዘንካ ስክስሶ ይንታ አⷝና ይንችን አነረ ይንታ ማናይንችን ሶልምድባብ እካንታ ክትም ማት ዝክሳዬ። <verse eid="MAT 10:37"/><verse number="38" style="v" sid="MAT 10:38"/>ይንታ ገታ ማዝቀልን ባልሶ ደእ የለልታ እም ጎርስምዳክባብ እካንታ ማት ክትም ዝክሳዬ።<note caller="-" style="x"><char style="xo" closed="false">10፡38 </char><char style="xt" closed="false"><ref loc="MAT 16:24">ማቶ. 16፡24</ref>፤ <ref loc="MRK 8:34">ማር. 8፡34</ref>፤ <ref loc="LUK 9:23">ሉቃ. 9፡23</ref>። </char></note> <verse eid="MAT 10:38"/><verse number="39" style="v" sid="MAT 10:39"/>ይንታ ሰንፔንም አቅስካንታ ዝግድባብ ሙደና ኮትም ካይዝዴ፥ ይንታ ሰንፔንም እካንታ ካይዝድባብ ሙደና ማቼ ኮትም አቅዝዴ።<note caller="-" style="x"><char style="xo" closed="false">10፡39 </char><char style="xt" closed="false"><ref loc="MAT 16:25">ማቶ. 16፡25</ref>፤ <ref loc="MRK 8:35">ማር. 8፡35</ref>፤ <ref loc="LUK 9:24">ሉቃ. 9፡24</ref>፤ <ref loc="LUK 17:33">17፡33</ref>፤ <ref loc="JHN 12:25">ዮሀ. 12፡25</ref>። </char></note><verse eid="MAT 10:39"/></para>
  <para style="s1">ናክንም ተይጎካ ኤስስና</para>
  <para style="r">(<ref loc="MRK 9:41">ማር. 9፡41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40"/>“የም ሞግድባብ እም ሞግዴ፥ እም ሞግድባብ እም ኦይችባብ እስታ ባቤንም ሞግዴ።<note caller="-" style="x"><char style="xo" closed="false">10፡40 </char><char style="xt" closed="false"><ref loc="MRK 9:37">ማር. 9፡37</ref>፤ <ref loc="LUK 9:48">ሉቃ. 9፡48</ref>፤ <ref loc="LUK 10:16">10፡16</ref>፤ <ref loc="JHN 13:20">ዮሀ. 13፡20</ref>። </char></note> <verse eid="MAT 10:40"/><verse number="41" style="v" sid="MAT 10:41"/>ሳብዘንካ ኤሰርሶ ኬዝድባብም ሳብዘንካ ኤሰርሶ ኬዝድባብታ ላምንካ ሞግድባብ ከታ ናክንም Ꮊፍተሬ፥ ጭልንመረ ጭልንታ ላምካ ሞግድባብ ጭልንታ ናክንም Ꮊፍተሬ። <verse eid="MAT 10:41"/><verse number="42" style="v" sid="MAT 10:42"/>ዶፈን የም ጋይድቴ፥ እስታ ካርንካ ጎርስምድባብ ክት ማቻንካንታ፥ ከትኬና መረንከሳርንካ ዋልቃባብካንታ ዋልቃ ቡርጭቀካ ሎቃ እምድባብ ኤድ ይንታ ናክንም Ꮊፍክሳ ነጋዬ።”<verse eid="MAT 10:42"/></para>
  <chapter eid="MAT 10"/>
  <chapter number="11" style="c" sid="MAT 11"/>
  <para style="s1">ስእስንባብ ዮሀንሰደርንካ የሱሰደር ክተን ተይᎺድባብከስ</para>
  <para style="r">(<ref loc="LUK 7:18-35">ሉቃ. 7፡18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1"/>የሱስ ታመኬ ቃስተን ይንታካርንካ ጎርስምድባብከስካንታ ከትከ ክተንከስም ይ እምሳን ቡር ኮትኮ ካርንም ዛቅሶ ቅንች Ꮊፈርድን ካተመንከሳር ሳባክካንተኬ ኤስስካንታ አይሴ።<verse eid="MAT 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2"/>ስእስንባብ ዮሀንስ ዞክና ኤሄናር ዶቅድዮ ክርስቶሰታ ፍክስን ኤሰርሶ ይንታ ካርንካ ጎርስምድባብከሳርንካ ቃስተንን ኦይትሶ፥ <verse eid="MAT 11:2"/><verse number="3" style="v" sid="MAT 11:3"/>“ኖ Ꮊዴ ጋይምስባብ ክርስቶስ የኖ? አና አብኖንት ካርስተሮ?” ጋይሶ የሱሰም ኬት ኦይስተርንግንዳ ይሴ። <verse eid="MAT 11:3"/><verse number="4" style="v" sid="MAT 11:4"/>የሱሰረ፥ “አይሰቶ የ ሰዳንደትምከ የ ኤሰርሳንደትም ሙዳ ዮሀንስካንታ ኬዝከቴ። <verse eid="MAT 11:4"/><verse number="5" style="v" sid="MAT 11:5"/>ኮሰቸቴ፥ አፍ ዝልንከስ ሰተረኬ፥ ዎከልዎከል ጋይድባብከስ ኡርመካ ሙክተረኬ፥ እጳ ሰቅምንክንባብከሰረ ፋጭተረኬ ቃም ቱንንከሰረ ኤሰርተረኬ ደእስባብከሰረ አምደኬ ሪካየንባብከስካንተረ ክላ ኬዘና ሳባክምተረ፥<note caller="-" style="x"><char style="xo" closed="false">11፡5 </char><char style="xt" closed="false"><ref loc="ISA 35:5-6">ኢሳ. 35፡5-6</ref>፤ <ref loc="ISA 61:1">61፡1</ref>። </char></note> <verse eid="MAT 11:5"/><verse number="6" style="v" sid="MAT 11:6"/>እም Ꮊኤርዳክባብ ሙደና አንጅምስባበኬ” ኩንጋየሮ ከትካንታ ማስሴ።<verse eid="MAT 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7"/>ዮሀንሰታ ክተን ተይᎺድባብከስ አይሳንደታ ቡር፥ የሱስ ዮሀንስጎካ ኩን ጋይሶ ዎርሰንካንታ ኬዛ የጄ፥ “ይና Ꮊራ ሰድንካንተንት ኮ ዴል ቆቸናር ዉተዳራ? ዞገካ ሶግድን ሱንባቀን ሰድንካንቶ? <verse eid="MAT 11:7"/><verse number="8" style="v" sid="MAT 11:8"/>ጉጅሰረ አብ Ꮊራ ሰድንካንተንት ዉተዳሬ? ላቅምድን አፍለን ቆበርስባብ ኤድም ሰድንካንቶ? ላቅም አፍላ ቆበርድባብ ባንችምንከስታ ኤሄናር Ꮊፈርደኬ። <verse eid="MAT 11:8"/><verse number="9" style="v" sid="MAT 11:9"/>ይና፥ Ꮊራካንተንት ውተዳራ? ሳብዘንካ ኤሰርሶ ኬዝድባብም ሰድንካንቶ? ይዬ፥ ኮትኮግንደረ ሳብዘንካ ኤሰርሶ ከዝድባብዘንካ አንድር ስገድባብም ሰድንካንተ የም ጋይድቴ። <verse eid="MAT 11:9"/><verse number="10" style="v" sid="MAT 11:10"/>ኖ ‘ይና፥ የስታ እሪ እሪ አየሮ፥ የስታ ጎግንም ግግዝድባብ እስታ ክተንም ተይሶ አይድባብም የስታ እር ኦይትቴ’ ጋይምሶ ክትካንታ ጭል ማጻፍናር ጻፍምስባቤ።<note caller="-" style="x"><char style="xo" closed="false">11፡10 </char><char style="xt" closed="false"><ref loc="MAL 3:1">ሚል. 3፡1</ref>። </char></note> <verse eid="MAT 11:10"/><verse number="11" style="v" sid="MAT 11:11"/>ዶፈን የም ጋይድቴ ማነንከስ አጭባብ ኤድንከስታ ዎክያርንካ ስእስንባብ ዮሀንሰዘንካ ስግድባብ አማክዬ። ኬዛርንካ ማቼ ጭላ ባንችማር አንድር ስግድባብ ኖ ፍጨዘን ቶክማ ጋይምስባቤ። <verse eid="MAT 11:11"/><verse number="12" style="v" sid="MAT 11:12"/>ስእስንባብ ዮሀንሰታ ስለንዘንካ የድሶ ታካ የለልታ ጭላ ባንችምና ዝግምዶቃየ፥ ዳቅስሶ ዝግድባብከስ ማቼ ኮትም Ꮊብደኬ።<verse eid="MAT 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 11:13"/>“ሳብዘንካ ኤሰርሶ ኬዛቅባብ ሙደንታ ኤስስንኬ ሙሴካንታ እምምሳን ህግና ስእስንባብ ዮሀንስ የለልታ ቤርካ ከዝተኬ።<note caller="-" style="x"><char style="xo" closed="false">11፡13 </char><char style="xt" closed="false"><ref loc="LUK 16:16">ሉቃ. 16፡16</ref>። </char></note> <verse eid="MAT 11:13"/><verse number="14" style="v" sid="MAT 11:14"/>ይና ከት ኬዛንደትም ተይካንታ የዝግዘ፥ ኖኮና Ꮊዴ ጋይምስባብ ኤላስ ዮሀንሴ።<note caller="-" style="x"><char style="xo" closed="false">11፡14 </char><char style="xt" closed="false"><ref loc="MAL 4:5">ሚል. 4፡5</ref>፤ <ref loc="MAT 17:10-13">ማቶ. 17፡10-13</ref>፤ <ref loc="MRK 9:11-13">ማር. 9፡11-13</ref>። </char></note> <verse eid="MAT 11:14"/><verse number="15" style="v" sid="MAT 11:15"/>ቃም ዶቅድባብ ኤሰራ!<verse eid="MAT 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16"/>“ኬዛርካ ማቼ ኮ አጥርንከስም Ꮊረክስ ካምስቴ? ጋበታ መለንዘን ዶቅሰኮ ክክ ኤልድን ይንችንም ካምደኬ፥ <verse eid="MAT 11:16"/><verse number="17" style="v" sid="MAT 11:17"/>‘አንዳለንም የካንታ ፉግዞቴ የታ በይዳከቴ! ሳችሶቴ የታ ኤፋከቴ!’ ጋይድን ይንችንከስም ካምደኬ። <verse eid="MAT 11:17"/><verse number="18" style="v" sid="MAT 11:18"/>ኮትኮግንደረ ስእስንባብ ዮሀንስ ᎺዳንደትᎺይካ እችምን እችክሳ ዎይን ዎጭምን ዎጭክሳ Ꮊድንካ፥ ‘ኮና ክታዘን ግምዛ ዶቅዴ!’ ክትም ጋይሰኬ። <verse eid="MAT 11:18"/><verse number="19" style="v" sid="MAT 11:19"/>ኤድ ይንች እቸሮ ዎጨሮ Ꮊዴ ‘ይና! ኖኮና በድ እችምንኬ ዎጭምም ሶልምድባቤ! ቃረጭን ተችዝድባብከስተኬ ጎመንባብከስተረ ኮችዬ!’ ክትም ጋይሰኬ። ማችንከረ ኤጨታ ዶፈንና ማቼ ይንታ ፍክስንካ መያ ማዴ”።<verse eid="MAT 11:19"/></para>
  <para style="s1">ጎማ ይንታ ፍክስን ዎይሳክን ካተመንከስታ ዎቀስምና</para>
  <para style="r">(<ref loc="LUK 10:13-15">ሉቃ. 10፡13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20"/>ኮታዘንከረ የሱስ አብ ካተመንከዘንካ ስግ በድ አተንከስም ይ ፍክሳን ካተመንከስም፥ ጎማ ፍክስን ከታ ይንታ ዎይሳክንካንታ ኩንጋየሮ ከትም ዎቀስ የጄ፥ <verse eid="MAT 11:20"/><verse number="21" style="v" sid="MAT 11:21"/>“ኮራዝኖ የስም የኤ! በቴሳይዶ! የስም የኤ የንካ ይይምሳንዳ አተና ጥሮሳርኬ ሲዶና ካተመንከሳር ይይምተስናና ኮታር ዶቅድን ኤድንከስ ሞርእታ አፍላ ቆበርስንደትኬ ማል ሳየርሶ ኤና እርናና ከታ ይንታ ጎማ ፍክስን ዎይዝደክዶቆ።<note caller="-" style="x"><char style="xo" closed="false">11፡21 </char><char style="xt" closed="false"><ref loc="ISA 23:1-18">ኢሳ. 23፡1-18</ref>፤ <ref loc="EZK 26:1-28:26">ሕዝ. 26፡1—28፡26</ref>፤ <ref loc="JOL 3:4-8">ኢዩ. 3፡4-8</ref>፤ <ref loc="AMO 1:9-10">አሞ. 1፡9-10</ref>፤ <ref loc="ZEC 9:2-4">ዘካ. 9፡2-4</ref>። </char></note> <verse eid="MAT 11:21"/><verse number="22" style="v" sid="MAT 11:22"/>ኮካንታ እታ የም ጋይድቴ ሳብታ ፍርዳ ሰጨንካ፥ የንዘንካ ስግ ጢሮሳርኬ ሲዶና ካተመናር ዶቅድ Ꮊቅባብከስካንታ ዋጭና ከታዘን ቶግዴ። <verse eid="MAT 11:22"/><verse number="23" style="v" sid="MAT 11:23"/>የነረ ጭላር የለልታ ጬክን ጋይሳንዳ ቅፍራናሆም ካተመኖ! ጩልጩል ጎርናር Ꮊንቸርተረየ! የስካ ይይምሳን አተንከስ ሶዶም ካተመናር ይምተስናና ናኮና ካተመና ካያክዶቆ ታካ የለልታ ዶቅተርዶቆ!<note caller="-" style="x"><char style="xo" closed="false">11፡23 </char><char style="xt" closed="false"><ref loc="ISA 14:13-15">ኢሳ. 14፡13-15</ref>፤ <ref loc="GEN 19:24-28">ፍዝ. 19፡24-28</ref>። </char></note> <verse eid="MAT 11:23"/><verse number="24" style="v" sid="MAT 11:24"/>ኮካንታ ዶፈንካ የስም ጋይድቴ፥ ሳብታ ፍርዳ ሰጨንካ የዘንካ ስግ ሰዶም ካተምንካንታ ክታ ዋጭና ቶግዴ!” <note caller="-" style="x"><char style="xo" closed="false">11፡24 </char><char style="xt" closed="false"><ref loc="MAT 10:15">ማቶ. 10፡15</ref>፤ <ref loc="LUK 10:12">ሉቃ. 10፡12</ref>። </char></note><verse eid="MAT 11:24"/></para>
  <para style="s1">ክርስቶሳር Ꮊፈርድን Ꮊዉስ</para>
  <para style="r">(<ref loc="LUK 10:21-22">ሉቃ. 10፡21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25"/>ኮት ሰጨንካ የሱስ ጭለተኬ ፍጨተካ ጮይስ እስታ ባቤኖ! ኮም ሪን ኤጨንባብከዘንከ ኤዝዶቴ ጋይድባብከዘንካ አችሳዮ ይንችንከስካንታ መያ የስ ማስሳንካንታ የስም ጋለድቴ፥ <verse eid="MAT 11:25"/><verse number="26" style="v" sid="MAT 11:26"/>ይዬ! እስታ ባበኖ! ኮም ይካንታ የስታ ኡርማ ጋይታ ማቴ። <verse eid="MAT 11:26"/><verse number="27" style="v" sid="MAT 11:27"/>እስታ ባቤና ሙዳ ሪን እካንታ እምቴ፥ እባብዘንካ አብ እ ክታ ይንችንም ኤዝድባብ Ꮊየነረ ካዬ። ኮትኮግንደረ እ ክታ ይንችንዘንካ አብ እባብም ኤዝድባብ Ꮊየነረ ካዬ፥ Ꮊየነረ እ ክታ ይንችና ክትም መያ እ ማሳክንዳ ማቼ እባብም ኤስካንታ ማታዬ።<note caller="-" style="x"><char style="xo" closed="false">11፡27 </char><char style="xt" closed="false"><ref loc="JHN 3:35">ዮሀ. 3፡35</ref>፤ <ref loc="JHN 1:18">1፡18</ref>፤ <ref loc="JHN 10:5">10፡5</ref>። </char></note> ኩን ጋይሴ።<verse eid="MAT 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28"/>“የታ ጋፍስባብከስኬ ባላ ደጭባብከስ ሙደና ኮር እዝደር Ꮊድከቴ! እተረ የም Ꮊዉስ እምትቴ። <verse eid="MAT 11:28"/><verse number="29" style="v" sid="MAT 11:29"/>እስታ ቃንበርንም የንታዘን ባልከቴ፥ እዘንከረ ኤስከቴ፥ እታ ኡርመኬ የካንታ ቡዳርንካ አተርድባብቴ፥ የንታ ሰንፔንካንተረ Ꮊዉስ Ꮊፍተረቴ።<note caller="-" style="x"><char style="xo" closed="false">11፡29 </char><char style="xt" closed="false"><ref loc="JER 6:16">ኤር. 6፡16</ref>። </char></note> <verse eid="MAT 11:29"/><verse number="30" style="v" sid="MAT 11:30"/>እስታ ቃንበርና ሳዝ፥ እስታ ባለነረ ደጫይንዴ”።<verse eid="MAT 11:30"/></para>
  <chapter eid="MAT 11"/>
  <chapter number="12" style="c" sid="MAT 12"/>
  <para style="s1">አይሁድንታ Ꮊውስ ሰጨንጎካ Ꮊዳን ኦይስና</para>
  <para style="r">(<ref loc="MRK 2:23-28">ማር. 2፡23-28</ref>፤ <ref loc="LUK 6:1-5">ሉቃ. 6፡1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1"/>ኮትᎺይካ የሱስ አይሁድንታ Ꮊውስ ሰጨንካ ኡሳን ዘርግታ ዎክካ አይድንካ፥ ክታ ካርንካ ጎርስምድባብከስ ከትም ዳቅሳንካንታ ዘርግ ትሰን ታክስሶ ዎክስሶ እች የጀኬ።<note caller="-" style="x"><char style="xo" closed="false">12፡1 </char><char style="xt" closed="false"><ref loc="DEU 23:25">ካሪ. 23፡25</ref>። </char></note> <verse eid="MAT 12:1"/><verse number="2" style="v" sid="MAT 12:2"/>ፈረሳውያን ኤድንከስ ኮም ሰድሰኮ የሱሰም “ኮ ሰድካ! የስታ ካርንካ ጎርስምድባብከስ አይሁድንታ Ꮊዉስ ሰጨንካ ጋይማክንደትም ይደኬ!” ከታ ጋይሰኬ። <verse eid="MAT 12:2"/><verse number="3" style="v" sid="MAT 12:3"/>የሱሰረ፥ ዳውትከ ክትካ የካ Ꮊቅባብ ኤድንከስ ከት ዳቀርሳንደትካ ዳውት ይሳንደትም ቦድሶ ናበባከቴ?<note caller="-" style="x"><char style="xo" closed="false">12፡3 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1 ሳሙ. 21፡1-6</ref>። </char></note> <verse eid="MAT 12:3"/><verse number="4" style="v" sid="MAT 12:4"/>ኖየረ ሳብታ ኤሄናር አርድሶ ቄሰንከዘንካ አብ ኖየረ ማታ ክትካ የካ Ꮊቅባብ ኤድንከስ ከት እጅድንግንዳ ጋይማክንደትም፥ ካስካንታ ግግሰርሳን ባይስንም እቸኬ።<note caller="-" style="x"><char style="xo" closed="false">12፡4 </char><char style="xt" closed="false"><ref loc="LEV 24:9">ሌዊ. 24፡9</ref>። </char></note> <verse eid="MAT 12:4"/><verse number="5" style="v" sid="MAT 12:5"/>ጉጅሰረ ቄሰንከስ አይሁድንታ Ꮊዉስ ሰጨንካ ሳብታ ጭል ኤሄናር አይሁድንከስታ Ꮊዉስ ሰጨንም ቦንችክሳ ከት ነግድንካ ባች ማትሶ ከታዘን ፋይድምዳክንደትም ሙሴጎካ እምምሳን ህግናር ጻፍምሳንደትም የታ ናበባከቴ?<note caller="-" style="x"><char style="xo" closed="false">12፡5 </char><char style="xt" closed="false"><ref loc="NUM 28:9-10">ፋይ. 28፡9-10</ref>። </char></note> <verse eid="MAT 12:5"/><verse number="6" style="v" sid="MAT 12:6"/>ኬዛርንካ ማቼ ሳብታ ጭል ኤሄንዘንካ ስግድባብ ይና ካሪ ዶቅዴ የንደር ጋይድቴ። <verse eid="MAT 12:6"/><verse number="7" style="v" sid="MAT 12:7"/>ጉጅሰረ እ ዝግድንዳ ቡዳርንካ አትርንም ዳት ካሲንም ካዬ ጋይድንደትም ጭል ማጻፍንታ ቃለና Ꮊራ ጋይዳናከረ የ ገቀርደስናና ባች ከታዘን ካየንባብ ኤድንከዘን የታ ፋረተራከት ዶቆ።<note caller="-" style="x"><char style="xo" closed="false">12፡7 </char><char style="xt" closed="false"><ref loc="MAT 9:13">ማቶ. 9፡13</ref>፤ <ref loc="HOS 6:6">ሆሴ. 6፡6</ref>። </char></note> <verse eid="MAT 12:7"/><verse number="8" style="v" sid="MAT 12:8"/>ኮትኮግንደረ “ኤድ ይንች አይሁድንከስታ Ꮊዉስ ሰጨንተረ ጮይስዬ” ኩን ከደር ጋይሴ።<verse eid="MAT 12:8"/></para>
  <para style="s1">የሱስ አን ዎብ ኤችን ፋችና</para>
  <para style="r">(<ref loc="MRK 3:1-6">ማር. 3፡1-6</ref>፤ <ref loc="LUK 6:6-11">ሉቃ. 6፡6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9"/>የሱስ ካርንኮታርንካ አምሶ አይሁድንከስታ ምክስ ኤሄናር አርደዴ፥ <verse eid="MAT 12:9"/><verse number="10" style="v" sid="MAT 12:10"/>ኮታረረ ዋልቃ ኤች አን ዎብ Ꮊቄ፥ የሱሰም ካሰስካንታ ኬዛ ዝግድባብ ዋልቃ ዋልቃ ኤድንከስ “አይሁድንከስታ Ꮊዉስ ሰጨንካ ሰቀርስባብም ፋጅድንግንዳ ጋይምቶ?” ጋየሮ ክትም ኦይሰኬ። <verse eid="MAT 12:10"/><verse number="11" style="v" sid="MAT 12:11"/>የሱሰረ፥ “የንታ ዎክያርንካ ዋልቃ ቆለን ዶቅድባብ፥ ክታ ቆለና አይሁድንከስታ Ꮊዉስ ሰጨንካ ጎርያር ዋቼ ጎችትዮ ዉጅዳክባብ Ꮊይራ?<note caller="-" style="x"><char style="xo" closed="false">12፡11 </char><char style="xt" closed="false"><ref loc="LUK 1:45">ሉቃ. 1፡45</ref>። </char></note> <verse eid="MAT 12:11"/><verse number="12" style="v" sid="MAT 12:12"/>ይና ኩን ማቼ ኤድ ቆልዘንካ Ꮊስግንዳ እንድንካ ስጋዮ! ኮካንታ አይሁድንታ Ꮊዉስ ሰጨንካ ኡርማ ሪ ይታ ጋይምሳንዴ” ኩን ከትም ጋይሴ። <verse eid="MAT 12:12"/><verse number="13" style="v" sid="MAT 12:13"/>ኮታ ቡር የሱስ አን ዎብን “የስታ አንንም ፍእስካ” ክትም ጋይሴ። ኖየረ ይንታ አንንም ክት ፍእዝድንካ ክታ አንና ገታ ኡርሶ ዎባክን አንን ዋልቀንግንዳ ማቼ። <verse eid="MAT 12:13"/><verse number="14" style="v" sid="MAT 12:14"/>ፈረሳውያን ኤድንከስ ማቼ ኮታርንካ ዉትሰኮ የሱሰም Ꮊስ ይይሰኮ ክትም ከታ ይ ደይዝዳናንከረ ዞርምሰኬ።<verse eid="MAT 12:14"/></para>
  <para style="s1">ሳብታ እድምስባብ ፍክስንባብከስ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15"/>የሱስ ማቼ ከታ ዙዝምን ኤስሶ ኮት ካርናርንካ Ꮊርን ጋይሴ፥ በድ ኤድንከሰረ ክትም ጎርስምሶ አይሰኬ፥ ሰቀርስባብከስ ሙደንመረ ፋችሴ። <verse eid="MAT 12:15"/><verse number="16" style="v" sid="MAT 12:16"/>ኤድንከስም ማቼ ክትጎካ Ꮊየንካንተረ ከት ኬዝዳክንግንዳ ከትም ክትሴ። <verse eid="MAT 12:16"/><verse number="17" style="v" sid="MAT 12:17"/>ኮነረ ማቻንዳ ሳብዘንካ ኤሰርሶ ኬዛቅባብ ኢስያስ ኬዛን ቤር ኬዘና ቦድምድንግንዴ።<verse eid="MAT 12:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18"/>“ይና! እ እጅባብ እስታ ፍክስንባብና ኮኔ!</para>
  <para style="q2" vid="MAT 12:18">ኖ እ ሶልምድባብከ እ ክትካ ጉርምድባቤ፥</para>
  <para style="q2" vid="MAT 12:18">እስታ አያንን ክታዘን ማስትቴ፥</para>
  <para style="q2" vid="MAT 12:18">ኖየረ ሉላ ፍርደን ዎርሰንካንታ ኬዝተሬ።<verse eid="MAT 12:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19"/>ኖ በርምዳክየ አነረ ፍፋዬ፥</para>
  <para style="q2" vid="MAT 12:19">ጎግንከዘነረ ክታ ኡፍስን ኤሰርድባብ ካዬ፥<verse eid="MAT 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20"/>ጎድምሳን ሱምባቀን ዎራ ኖ ቁንጫየ፥</para>
  <para style="q2" vid="MAT 12:20">የድካንታ ጩብድን ክርንም ድክሳዬ፥</para>
  <para style="q2" vid="MAT 12:20">ኮመረ ክት ይድንዳ፥ ሉላ ፍርደና ጋምተርን የለልቴ።<verse eid="MAT 12:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21"/>አይሁድ ማታክባብከስ ክትካ ጉርምን ይደኬ”።<note caller="-" style="x"><char style="xo" closed="false">12፡21 </char><char style="xt" closed="false"><ref loc="ISA 42:1-4">ኢሳ. 42፡1-4</ref>። </char></note><verse eid="MAT 12:21"/></para>
  <para style="s1">የሱስኬ ብኤልዘቡልካ</para>
  <para style="r">(<ref loc="MRK 3:20-30">ማር. 3፡20-30</ref>፤ <ref loc="LUK 11:14-23">ሉቃ. 11፡14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22"/>ኮታ ቡር ኤድንከስ ዋልቃ ግምዘካ የደርስባብ ዓፊይ ዝል ማችባብኬ አፈረ ከዛይባብም የሱስደር ተይᎺደኬ፥ የሱሰረ ኤችንም ፋችሴ፥ ኤችነረ ኬዘኬ ሰድነረ የጄ። <verse eid="MAT 12:22"/><verse number="23" style="v" sid="MAT 12:23"/>ዎርሰነረ ሙዳ በርእሰኮ፥ “ኮና ዳውተታ ይንች ማተርዳቶ?” ጋይሰኬ።<verse eid="MAT 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24"/>ፈረሳውያንንከስ ማቼ ኮም ኤሰርሰኮ “ኖ ‘ብኤልዘቡል’ ጋይምስባብ ግምዘንከስም ገችዝድባብታ ዎልቀካ ማታክንዳ ማቼ ግምዘንም ዉቻዬ” ጋይሰኬ።<note caller="-" style="x"><char style="xo" closed="false">12፡24 </char><char style="xt" closed="false"><ref loc="MAT 9:34">ማቶ. 9፡34</ref>፤ <ref loc="MAT 10:25">10፡25</ref>። </char></note><verse eid="MAT 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25"/>የሱሰረ ከታ ገቅርንም ኤስሶ፥ “ክክ ክክ ፋስምድን ባንችምና ሙዳ ዋጅዴ። ኮትኮግንደረ ዋልቃ ካተመና አነረ ዋልቃ ኤሀኤድ ክክ ክክ ከት ፋስምሴ ዳቅሶ ዶቅካንታ ማታየኬ። <verse eid="MAT 12:25"/><verse number="26" style="v" sid="MAT 12:26"/>ሰጣነረ ሰጣንም ዉጅድንዳ ማቼ ክክ ክክ ፋስምተከ ጋይንትዬ፥ ይና፥ ኩን ማቼ ክታ ባንችምና Ꮊስግንዶክ ዳቅሶ ዎእዳ! <verse eid="MAT 12:26"/><verse number="27" style="v" sid="MAT 12:27"/>ጉጅሶ እታ ግምዘንከስም እ ዉችዝድንዳ ብኤልዘቡልካ ማቼ የም ጎርስምድባብከስ Ꮊረከክ ከትም ዉችስተራ? ኮካንታ የንታ ይንችንከስ የንታዘን ፋረደኬ። <verse eid="MAT 12:27"/><verse number="28" style="v" sid="MAT 12:28"/>እታ ግምዘንከስም እ ዉችዝድንዳ ሳብታ አያንካ ማቼ ይና ሳብታ ባንችምና የንደር Ꮊቴ፥ ኩን ከደር ጋይሴ።<verse eid="MAT 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29"/>“ጉጅሰረ ዋልቃ ኤድ እርናና ዎልቀንክንባብም ዞካክዶቆ ዎልቀንክንባብታ ኤሪ አርድሶ ክታ ሪይንም ቡራካንታ Ꮊስግንድክ ማዳ? ዎልቀንክንባብም ይ ዞክሳንደታ ቡር ገታ ክታ ሪይንም ቡራካንታ ማደ።<verse eid="MAT 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30"/>“እንካ ክክን ማታክባብ ሙደና እም ግርዴ፥ እንካ ክክን ሳንዝዳክባብ ኖ ይጭዴ።<note caller="-" style="x"><char style="xo" closed="false">12፡30 </char><char style="xt" closed="false"><ref loc="MRK 9:40">ማር. 9፡40</ref>። </char></note> <verse eid="MAT 12:30"/><verse number="31" style="v" sid="MAT 12:31"/>ኮካንታ ኤድ ይ ይድንደትም Ꮊምንመረ ጎመን አነረ አፋርንካ ዉድን የክንም ሙዳ ክትካንታ ነጋ ጋይምተሬ ጋይድቴ፥ አያን ጭልንዘን የግድባብ ዋልቃ ኤችታ ባችና ክትካንታ ነጋ ጋይምተራክዬ። <verse eid="MAT 12:31"/><verse number="32" style="v" sid="MAT 12:32"/>ኤድ ይንችታዘን ዳቅልንም ኬዝድባብ ሙደና ክታ ባችና ነጋ ጋይምተሬ። አያን ጭልንዘን የግድባብ ሙደና ማቼ ኮፍጫ ሙደንዘነረ ማታ Ꮊድን ፍጫሙደንዘን ክታ ባችና ነጋ ጋይምተራክዬ።<note caller="-" style="x"><char style="xo" closed="false">12፡32 </char><char style="xt" closed="false"><ref loc="LUK 12:10">ሉቃ. 12፡10</ref>። </char></note><verse eid="MAT 12:32"/></para>
  <para style="s1">ኡርማ Ꮊቀና ይንታ አፍንካ ኤስምዴ</para>
  <para style="r">(<ref loc="LUK 6:43-45">ሉቃ. 6፡43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33"/>“Ꮊቃ ሙደና ይንታ አፍንካ ኤስምድንካንታ ኡርማ Ꮊቃ የካንታ ዶቃ፥ ኮታ አፍነረ ኡርማ ማዴ፥ Ꮊቀና ዳቅል ኮት ማቼ አፍነረ ዳቅል ማደ።<note caller="-" style="x"><char style="xo" closed="false">12፡33 </char><char style="xt" closed="false"><ref loc="MAT 7:20">ማቶ. 7፡20</ref>፤ <ref loc="LUK 6:44">ሉቃ. 6፡44</ref>። </char></note> <verse eid="MAT 12:33"/><verse number="34" style="v" sid="MAT 12:34"/>የታ ጉንን ፉይንታ ይንችንከሶ! የታ ዳቅልንባብከስ ማደቶ ኡርማ ሪም ኬዛካንታ Ꮊስግንደንት ማዳ? ኤድ ይንታ አፈካ ኬዝድንዳ ይንታ ቡዳር ጮጭሶ ስጣንደትሜ።<note caller="-" style="x"><char style="xo" closed="false">12፡34 </char><char style="xt" closed="false"><ref loc="MAT 3:7">ማቶ. 3፡7</ref>፤ <ref loc="MAT 23:33">23፡33</ref>፤ <ref loc="MAT 15:18">15፡18</ref>፤ <ref loc="LUK 3:7">ሉቃ. 3፡7</ref>፤ <ref loc="LUK 6:45">6፡45</ref>።</char></note><verse eid="MAT 12:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 12:35"/>“ኡርማ ኤድ ይንታ ኡርማ ቡደናርንካ ኡርማ ሪን ዉጅዴ፥ ዳቅል ኤደረ ዳቅል ይንታ ቡደናርንካ ዳቅል ርም ዉጅዴ <verse eid="MAT 12:35"/><verse number="36" style="v" sid="MAT 12:36"/>ዶፈንካ የም ጋይድቴ፥ ኤድንከስ ዉችኩን ማዳክንደትም ከታ ይ ከዝድንደት ዋልቃ ዋልቃ ኬዘንታ ሳብታ ፍርዳ ሰጨንካ ኦይስምደኬ። <verse eid="MAT 12:36"/><verse number="37" style="v" sid="MAT 12:37"/>የስታ ኡርማ ኬዘንዘንካ አምሳንዳ ጭልምዳዬ፥ አነረ የስታ ዳቅል ኬዘንዘንካ አምሳንዳ ኡርክና የስታዘን ማተሬ”።<verse eid="MAT 12:37"/></para>
  <para style="s1">አተንም ሰድንካንታ ኦይስምሳን ኦይስና</para>
  <para style="r">(<ref loc="MRK 8:11-12">ማር. 8፡11-12</ref>፤ <ref loc="LUK 11:29-32">ሉቃ. 11፡29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38"/>ኮታይካ ዋልቃ ዋልቃ ሙሴታ ህግንም ኤስዝድባብከስከ ፈረሳውያንንከስ የሱሰም፥ “የ ኤስስንባቦ! የስ አተንም ይድንካ ሰድካንታ ዝግዶቴ!” ክደር ጋይሰኬ።<note caller="-" style="x"><char style="xo" closed="false">12፡38 </char><char style="xt" closed="false"><ref loc="MAT 16:1">ማቶ. 16፡1</ref>፤ <ref loc="MRK 8:11">ማር. 8፡11</ref>፤ <ref loc="LUK 11:16">ሉቃ. 11፡16</ref>። </char></note> <verse eid="MAT 12:38"/><verse number="39" style="v" sid="MAT 12:39"/>የሱስ ማቼ፥ “ዳቅልኬ አሜንዳክን አጥርንከስ አተንም ሰድንካንታ ዝግዴ፥ ኬዛርንካ ማቼ ሳብዘንካ ኤሰርሶ ኬዛቅባብ ዮናሰታ አተንዘንካ አብ አታ እምማዬ።<note caller="-" style="x"><char style="xo" closed="false">12፡39 </char><char style="xt" closed="false"><ref loc="MAT 1:4">ማቶ. 1፡4</ref>፤ <ref loc="MRK 8:12">ማር. 8፡12</ref>። </char></note> <verse eid="MAT 12:39"/><verse number="40" style="v" sid="MAT 12:40"/>ዮናስ ሞላ ባከንታ ኖርትያር ማከን ሰጫ Ꮊየኬ ሶይትካ ክት ስክሳንግንዳ፥ ኮትኮግንዳ ኤድ ይንች ዱክናር ማከን ሰጨከ ማከን ሶይት ስክስተረ።<note caller="-" style="x"><char style="xo" closed="false">12፡40 </char><char style="xt" closed="false"><ref loc="JON 1:17">ዮና. 1፡17</ref>። </char></note> <verse eid="MAT 12:40"/><verse number="41" style="v" sid="MAT 12:41"/>ነነዌ ካተመንታ ኤድንከስ ሳብታ ፍርዳ ሰጨንካ ኮ ስለንታ አጥርንከስካ ክክን አምሰኮ ክታዘን ፋረተረኬ፥ ነነዌ ካተማ ኤድንከስ ዮናሰታ ሳባክን ከታ ይ ኤሰርሳንደትካ ከታ ይንታ ጎማ ፍክስንጎካ ኡቅምሰኮ ይንታ ጎማ ፍክስን ዎይስተኬ። ታ ማቼ ዮናሳዘንካ ስግድባብ ካሪ ዶቅዴ።<note caller="-" style="x"><char style="xo" closed="false">12፡41 </char><char style="xt" closed="false"><ref loc="JON 3:5">ዮና. 3፡5</ref>። </char></note> <verse eid="MAT 12:41"/><verse number="42" style="v" sid="MAT 12:42"/>ኤተን ባንችን ሳባ ሰሎሞንታ ኤጨንም ኤስርካንታ ፍጨታ ካንታርንካ ኮት Ꮊዳንካንታ ሳብታ ፍርዳ ሰጨንካ ኮ ስለንታ አጥርንከስካ ክክን ና አምሶ ክታዘን ፋረተሬ፥ ታ ማቼ ሰሎሞንዘንካ ስገድባብ ካሪ ዶቅዴ ኩን ከትካንታ ጋይሴ”።<note caller="-" style="x"><char style="xo" closed="false">12፡42 </char><char style="xt" closed="false"><ref loc="1KI 10:1-10">1 ባንቺ. 10፡1-10</ref>፤ <ref loc="2SA 9:1-12">2 ሳሙ. 9፡1-12</ref>። </char></note><verse eid="MAT 12:42"/></para>
  <para style="s1">ቱና አያና ኤታ ዋር ማትዮ አርድና</para>
  <para style="r">(<ref loc="LUK 11:24-26">ሉቃ. 11፡24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43"/>ኮታዘንከረ የሱስ፥ “ቱና አያንና ኤታ ዋርንካ ዉተዳንደታ ቡር ይ Ꮊዉዝድን ካሪ ዝግመትካ ሎቃ ካየን ዎቻ ካርያር ኦንግዴ። ኬዛርካ ማቼ Ꮊፋዬ፥ <verse eid="MAT 12:43"/><verse number="44" style="v" sid="MAT 12:44"/>ኮካንታ ‘እ ዉተዳን ኤሄናር ማት እ አያ’ ጋይዴ። ማተረ ክት Ꮊድንካ፥ ኤሄና ዉችኩን ማትሶ Ꮊጭምሶ፥ ግግምስንካ Ꮊፍተሬ። <verse eid="MAT 12:44"/><verse number="45" style="v" sid="MAT 12:45"/>ኮታ ቡር፥ ቱና አያንና አይሶ ይንዘንካ እድንካ ስገድባብ አብ ታብዛ ዳቅል ግምዘንከስም ተይሶ Ꮊተሬ። ከተረ ኤና እር ግምዘታ ኤሀ Ꮊቃን ኤችንታ ቡደናር አርድሶ የካ ክታር ዶቅተረኬ። ኮካንታ ኤችን ክታ እርንደትዘንካ ስግሶ ቡርንዳ እንድንካ ቦርሳንዳ ማተሬ። ኮ ዳቅል አጥርንዘን ማድንዳ ኮትኮም ካምሳን ካምድን ርንከሰ ኩን ጋይሴ”።<verse eid="MAT 12:45"/></para>
  <para style="s1">የሱሰታ እንደንኬ እስመንከስ</para>
  <para style="r">(<ref loc="MRK 3:31-35">ማር. 3፡31-35</ref>፤ <ref loc="LUK 8:19-21">ሉቃ. 8፡19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46"/>የሱስ ዎርሰንካንታ አክ ኬዘዘን ዶቅድንካ፥ ክታ እንደንከ እስመንከስ ክትም ከስስካንታ ዝግሰኮ ማል ዎእሶ Ꮊቀኬ። <verse eid="MAT 12:46"/><verse number="47" style="v" sid="MAT 12:47"/>ኮታር Ꮊቅባብከሳርንካ ዋልቀና የሱሰም፥ “ኮሰቼ የስታ እንደንኬ የስታ እስመንከስ የስም ከስስካንታ ዝግሰኮ ማል ዎእተኬ” ክደር ጋይሰኬ።<note caller="+" style="f"><char style="fr" closed="false">12፡47 </char><char style="ft" closed="false">ዋልቃ ዋልቃ ኤና እርንከሳር ፋይ. 47ትና ካዬ። </char></note><verse eid="MAT 12:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48"/>የሱስ ማቼ፥ “እስታ እንደነና ና Ꮊይራ? እስታ እስመንንከሰረ ከታ Ꮊይራ?” ጋይሴ። <verse eid="MAT 12:48"/><verse number="49" style="v" sid="MAT 12:49"/>ኮታ ቡር ይንታ አንን ኦይትሶ ይንታ ካርንካ ጎርስምድባብከዝደር ሰቸሮ “እስታ እንደንኬ እስታ እስመንንከስ ኮሰቸቴ ኬናከሰኬ፥ <verse eid="MAT 12:49"/><verse number="50" style="v" sid="MAT 12:50"/>ጭላር ዶቅድባብ እባብታ ጋይተንም ቦድባብ ሙደና እስታ እስመነረ፥ እስታ ምችነነረ፥ እስታ እንደነረ ኖዬ” ኩንጋየሮ ማስሴ።<verse eid="MAT 12:50"/></para>
  <chapter eid="MAT 12"/>
  <chapter number="13" style="c" sid="MAT 13"/>
  <para style="s1">ማሰንባብታ ካምስ</para>
  <para style="r">(<ref loc="MRK 4:1-9">ማር. 4፡1-9</ref>፤ <ref loc="LUK 8:4-8">ሉቃ. 8፡4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1"/>ኮት ሰጨንካ የሱስ ኤሄናርንካ ዉትሶ ሎቃ ባሀርንታ ካንተዘን ዶቅሴ፥ <verse eid="MAT 13:1"/><verse number="2" style="v" sid="MAT 13:2"/>በድ ኤድንከሰረ ክደረ Ꮊድሰኮ ከት ሳንምሳንካንታ ሎቀንዘንካ ቃልዝድን ጃልበንዘን ዉትሶ ዶቅሴ፥ ዎርሰነረ ሙዳ ባሀርንታ ካንተንዘን ዎእሶ Ꮊቄ።<note caller="-" style="x"><char style="xo" closed="false">13፡2 </char><char style="xt" closed="false"><ref loc="LUK 5:1-3">ሉቃ. 5፡1-3</ref>። </char></note><verse eid="MAT 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 13:3"/>ኮተረ ቡር በድ ርንከስም ካምስካ ኩንጋየሮ ከትም ኬዛ የጄ፥ “ኮሰቼቴ! ዋልቃ ዎንንባብ ማሳካንታ ዉተዴ። <verse eid="MAT 13:3"/><verse number="4" style="v" sid="MAT 13:4"/>ክት ማዝድንከረ ዋልቃ ዋልቃ ማሰና ጎግታ ካንተዘን ዋችንካ አፍትንከስ Ꮊድሰኮ ካምት እቸኬ። <verse eid="MAT 13:4"/><verse number="5" style="v" sid="MAT 13:5"/>ዋልቃ ዋልቃ ማሰነረ ኡርማ ፍጫ ካየን Ꮊርቸንዘን ዋቼ፥ ፍጨነረ ኮታዘን በድ ካየንካንታ ጩላ ሶሰረ ፍጨና በዳዬ፥ ኮካንታ ማሰነረ ሳነካ ባቀልሴ። <verse eid="MAT 13:5"/><verse number="6" style="v" sid="MAT 13:6"/>ማታጋካ ዳት Ꮊይና ዉተዳንደትካ ሱልሴ፥ ጫጭ ካየንካንታ ዎቼ። <verse eid="MAT 13:6"/><verse number="7" style="v" sid="MAT 13:7"/>ዋልቃ ዋልቃ ማሰነረ ኡክም ዶቅድን ቆቸናር ዋቼ፥ ኡክምነረ ጋጵሶ ባቅለንም ጉርት የጄ። <verse eid="MAT 13:7"/><verse number="8" style="v" sid="MAT 13:8"/>ዋልቃ ዋልቃ ማሰነረ ኡርማ ፍጨዘን ዋችሶ ባቅልስንደትኬ በድ አፍ ኡሴ፥ ዋልቀና ጨታ፥ ዋልቀና ማከን ቦንዳ፥ ዋልቀነረ ቦንደኬ ታማ አፍ ኡሴ። <verse eid="MAT 13:8"/><verse number="9" style="v" sid="MAT 13:9"/>ቃም ዶቅድባብ ኤሰራ!”<verse eid="MAT 13:9"/></para>
  <para style="s1">የሱስ ኬዛን ካምስንታ ቡልና</para>
  <para style="r">(<ref loc="MRK 4:10-12">ማር. 4፡10-12</ref>፤ <ref loc="LUK 8:9-10">ሉቃ. 8፡9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10"/>ኮታ ቡር ክታ ካርንካ ጎርስምድባብከስ የሱሰደር Ꮊድሰኮ፥ “Ꮊራካንተስ ዎርሰንካንታ ካምስካ ከዝዳ?” ክደር ጋይሰኬ።<verse eid="MAT 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11"/>የሱሰረ፥ “የካንታ ጭላ ባንችምንታ አችምሳንደትም ኤስንተን የካንታ እምምቴ፥ ከትካንታ ማቼ እምማክዬ። <verse eid="MAT 13:11"/><verse number="12" style="v" sid="MAT 13:12"/>ዶቅድባብካንታ ጉጅምሶ እምምተሬ፥ ክትካንታ በተሬ፥ ካየንባብ ኤድንዘንካ ማቼ ና ዶቅድንዳ ዎራ ክታዘንካ ተይምተሬ።<note caller="-" style="x"><char style="xo" closed="false">13፡12 </char><char style="xt" closed="false"><ref loc="MAT 25:29">ማቶ. 25፡29</ref>፤ <ref loc="MRK 4:25">ማር. 4፡25</ref>፤ <ref loc="LUK 8:18">ሉቃ. 8፡18</ref>፤ <ref loc="LUK 19:26">19፡26</ref>። </char></note> <verse eid="MAT 13:12"/><verse number="13" style="v" sid="MAT 13:13"/>ኮካንታ ሰደኮ ሰዳክንባብከስግንዳ፥ ኤሰርደኮ ኤሰርዳክንባብከስግንዳ አነረ ገቀርት ተይዳክንባብ ከስግንዳ ከት ማቻንካንታ ይና፥ እታ ካምስካ ከትካንታ ኬዝድቴ”። <verse eid="MAT 13:13"/><verse number="14" style="v" sid="MAT 13:14"/>ኮካንታ ሳብዘንካ ኤሰርሶ ኬዛቅባብ እሳስካ፥</para>
  <para style="q1" vid="MAT 13:14">ኤስርንም ኤሰርደቴ፥ ኬዛርንካ ማቼ ገቀርት ተይዳከቴ፥</para>
  <para style="q2" vid="MAT 13:14">ሰድንመረ ሰደቴ፥ ኬዛርንካ ማቼ ቡዳ ይዳከቴ፥</para>
  <para style="m" vid="MAT 13:14">ኩን ጋይምሶ ጻፍምሳንዳ ከታዘን ቦድምድንግንዳ፥<verse eid="MAT 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15"/>ኮ ዎርሰንታ ቡደና ዳቅቴ፥</para>
  <para style="q2" vid="MAT 13:15">ቃምነረ ከታ ቱንቴ፥ ከታ አፍነረ ግንእቴ፥</para>
  <para style="q2" vid="MAT 13:15">ኩን ማታከስናና ከታ ይንታ አፍንከረ ሰድሰኮ፥</para>
  <para style="q2" vid="MAT 13:15">ከታ ይንታ ቃምንከረ ኤሰርሰኮ፥</para>
  <para style="q2" vid="MAT 13:15">ከታ ይንታ ቡደንከረ ገቀርት ተይሰኮ፥</para>
  <para style="q2" vid="MAT 13:15">እዝደር ከት ማቸስናና ከትም ፋችተርት ዶቆ፥</para>
  <para style="m" vid="MAT 13:15">ኩንጋይሶ ከትካንታ ማስሴ።<note caller="-" style="x"><char style="xo" closed="false">13፡15 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">ኢሳ. 6፡9-10</ref>። </char></note><verse eid="MAT 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16"/>የንታ ማቼ አፍንከስ ሰድንካንተኬ፥ ቃምንከሰረ ኤሰርድንካንታ አንጅምስባበቴ። <verse eid="MAT 13:16"/><verse number="17" style="v" sid="MAT 13:17"/>ዶፈን የም ጋይድቴ፥ በድ ሳብዘንካ ኤሰርሶ ኬዛቅባብከስከ ጭል ኤድንከስ የ ሰድንደትም ሰድንካንታ አንገርተክ ዶቆ፥ ኬዛርንካ ማቼ ሰዳከኬ፥ የ ኤሰርድንደትመረ ኤስርካንታ አንገርተክ ዶቆ፥ ኬዛርካ ማቸ ኤሰራከኬ።<note caller="-" style="x"><char style="xo" closed="false">13፡17 </char><char style="xt" closed="false"><ref loc="LUK 10:23-24">ሉቃ. 10፡23-24</ref>። </char></note><verse eid="MAT 13:17"/></para>
  <para style="s1">ማሰንባብታ ካምስንታ ቡልና</para>
  <para style="r">(<ref loc="MRK 4:13-20">ማር. 4፡13-20</ref>፤ <ref loc="LUK 18:11-15">ሉቃ. 18፡11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18"/>“ይና የታ ማሰንባብታ ካምስንከስታ ቡልና Ꮊራ ኮት ማቸረ ኤሰርከቴ፥ <verse eid="MAT 13:18"/><verse number="19" style="v" sid="MAT 13:19"/>ጎግታ ካንተናር ዋቻን ማሰና፥ ሳብታ ባንችምንታ ቃለንም ኤሰርሶ ገቀርት ተይዳክን ኤድንም ካምዴ፥ ሳናናና ዳቅልና Ꮊድሶ ክታ ቡደናር ማስምሳን ቃለንም ክታዘንካ ተይዴ፥ <verse eid="MAT 13:19"/><verse number="20" style="v" sid="MAT 13:20"/>Ꮊርቻ ፍጨንዘን ማስምሳንዳ፥ ቃለንም ኤሰርሶ ሳናናና ጉርምካ ተይድባብ ኤድንም ካምዴ።<verse eid="MAT 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 13:21"/>“ኬዛርንካ ማቼ ሰጫካንታ ዳት ክታ ቡደናር ጫጭ ኦይታክየ፥ ኮካንታ ቃለንጎካ ዋልቃ ማጣ አነረ ዳይር ክታዘን የልሳንደትካ ሳነካ ኮተርዴ። <verse eid="MAT 13:21"/><verse number="22" style="v" sid="MAT 13:22"/>ኡክም ዶቅድን ቆቸናር ማስምሳንዳ ቃለንም ሰጫካንታ ኤሰርድን ኤድንም ሰጅዴ፥ ማታጋካ ዳት ኮ ፍጫሙደንታ ገቅርንከ ቆልመታ ሶልመና ክታ ቡዳር አርድሶ ቃለንም ጉንእት የድንካንታ አፍ ኡስክሳ ነገዴ። <verse eid="MAT 13:22"/><verse number="23" style="v" sid="MAT 13:23"/>ኡርማ ፍጨንዘን ማሰርሳንዳ፥ ቃለንም ኤሰርሶ ገቀርት ተይድባብ ኤድንም ሰችዝደ፥ ኖ አፍ ኡዝዴ፥ ዋልቀና ጨታ፥ ዋልቀና ማከን ቦንዳ፥ ዋልቀና ቦንደከ ታማ አፍ ኡዝዴ”።<verse eid="MAT 13:23"/></para>
  <para style="s1">ለሰንታ ካምስ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24"/>ኮትኮግንደረ የሱስ አብ ካምስካ፥ “ጭላ ባንችምና ይንታ ዎን Ꮊምናር ኡርማ ማሰንም ማስባብ ኤችንም ና ካምዴ፥ <verse eid="MAT 13:24"/><verse number="25" style="v" sid="MAT 13:25"/>ኬዛርንካ ማቼ ኤድ ሙደና ራቻንደታ ቡሪ ክታ ይምኤንባብ Ꮊድሶ ዘርግንታዋር ለሰንም ማስሶ አይሴ። <verse eid="MAT 13:25"/><verse number="26" style="v" sid="MAT 13:26"/>ዘርግነረ ባቀልሶ ፉጥማ የድንካ ለሰነረ ኮታይካ Ꮊፈርሴ። <verse eid="MAT 13:26"/><verse number="27" style="v" sid="MAT 13:27"/>ኮካንታ Ꮊምንባብታ ፍክስንባብከስ ክደር Ꮊድሰኮ፥ ‘የ ዎባቦ፥ የስታ ዎን Ꮊምናር ኡርማ ማሰን የና ማሳካ? ይና ኮናና፥ ለሰና Ꮊምንኮክ Ꮊዳሬ?’ ጋይሰኬ። <verse eid="MAT 13:27"/><verse number="28" style="v" sid="MAT 13:28"/>ኖየረ፥ ‘ኮም ይስባብ ኖ ይምኤንባቤ’ ከደር ጋይሴ። ፍክስንባብብከሰረ ‘ይና ኮናና ለሰንም አይሶቶ ዎ ቡጭድንግንዳ ዝግዳ?’ ክደር ጋይሰኬ። <verse eid="MAT 13:28"/><verse number="29" style="v" sid="MAT 13:29"/>ኖ ማቼ ኩንጋየሮ ከትካንታ ማስሴ ‘ኩን ማታዬ ለሰንም የ ቡጭድንካ ዘርግንመረ ዋር ቡጭደቴ። <verse eid="MAT 13:29"/><verse number="30" style="v" sid="MAT 13:30"/>ኮካንታ ዛእከቴ፥ ስከርድን ሰጨና የልተርን የለልታ ዘርግነረ ለሰነረ የካ ከት ጋጳ፥ ስከርድን ሰጨን Ꮊይካ ስክንባብከስም ለሰንም እርናና ቡጭከቴ፥ ኖሄከረ አድንግንዳ ናርካ ዞከተ፥ ዘርግንም ማቼ ሳንስሰቶ እስታ ቡለናር አርችከቴ’ ከትም ጋይድቴ”፥ ኩንጋየሮ ከትካንታ ኬዜ።<verse eid="MAT 13:30"/></para>
  <para style="s1">ሰናፍጭ ጋየርድን አፍይ ማሰንታ ካምስ</para>
  <para style="r">(<ref loc="MRK 4:30-32">ማር. 4፡30-32</ref>፤ <ref loc="LUK 13:18-21">ሉቃ. 13፡18-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31"/>የሱስ አብ ካምስካ “ጭላ ባንችምና ዋልቃ ኤች ሰናፍጭ ጋየርድን ማሰን ተይሶ ዎን ካርናር ማሳን ማሰንም ካምዴ። <verse eid="MAT 13:31"/><verse number="32" style="v" sid="MAT 13:32"/>ናየረ ማሳ ሙደንዘንካ ቶክሳንዴ ይ ጋጵሳንደትከረ ኮርምሳን ሪ ሙደንዘንካ ና ስገዴ፥ Ꮊቃከከረ ና ማዴ፥ አፍትንከሰረ Ꮊድሰኮ ኮታ ሳቀንከዘን ኤሄን ይንታ ዎድሰኮ ዶቅደኬ” ኩንጋየሮ ከትካንታ ኬዜ።<verse eid="MAT 13:32"/></para>
  <para style="s1">ማጠን ኡስዝድን እርሰንታ ካምስ</para>
  <para style="r">(<ref loc="LUK 13:20-21">ሉቃ. 13፡20-21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33"/>ጉጅሰረ የሱስ፥ “ጭላ ባንችምና ዋልቃ ኤተን ማከን ጋበት እለንም ተይሶ ማጠን ኡስዝድን እርሰንካ ክክን ሪችሳን እርሰንም ካምዴ፥ እርሰነረ ማጠና ሙዳ ኡዝድንግንዳ ይሴ” ኮም ካምስንከስም ከትካንታ ኬዜ።<verse eid="MAT 13:33"/></para>
  <para style="s1">የሱስ Ꮊራካንታ ካምስንካ ክት ኬዘናንከረ</para>
  <para style="r">(<ref loc="MRK 4:33-34">ማር. 4፡33-34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34"/>የሱስ ኬና ሙዳ ርን ካምስካ ዎርሰንካንታ ኬዜ፥ ካምስካይሳ Ꮊረርየረ ከትካንታ ከዛክዬ። <verse eid="MAT 13:34"/><verse number="35" style="v" sid="MAT 13:35"/>ኮነረ ኮት ኩን ማቻንዳ ሳብዘንካ ኤሰርሶ ከዛቅባብካ፥</para>
  <para style="q1" vid="MAT 13:35">“እስታ ኬዘንም ካምስካ መያ ማዝድቴ፥</para>
  <para style="q2" vid="MAT 13:35">ኮፍጫ ሙደና ፍዝምሳንደትዘንካ የድሶ አችምሳንደትም ኬዝድቴ” ኩን ጋይምሶ ጻፍምሳንዳ ቦድምድንግንዴ።<note caller="-" style="x"><char style="xo" closed="false">13፡35 </char><char style="xt" closed="false"><ref loc="PSA 78:2">የቺ 78፡2</ref>። </char></note><verse eid="MAT 13:35"/></para>
  <para style="s1">የሱስ ለሰንታ ካምስንከስም መያማስና</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36"/>ኮታ ቡር የሱስ ዎርሰንም ዛቅሶ ኤሀር አርደዴ፥ ክታ ካርንካ ጎርስምድባብከሰረ ክደር Ꮊድሰኮ፥ “ዎን Ꮊምናር ዶቅድን ለስንታ ካምስንታ ቡልንም ዎም ኬዝካ” ጋይሰኬ።<verse eid="MAT 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37"/>የሱሰረ፥ “ኡርማ ማሰንም ማስባብ ኤድ ይንቼ፥ <verse eid="MAT 13:37"/><verse number="38" style="v" sid="MAT 13:38"/>ዎን Ꮊምነረ ኮፍጫ ሙደኔ፥ ኡርማ ማሰና ሳብታ ባንችምንታ ይንችንከሰከ፥ ለሰነረ ሰጣንታ ይንችንከስከ። <verse eid="MAT 13:38"/><verse number="39" style="v" sid="MAT 13:39"/>ለሰንም ማስባብ ይምኤንባብ ዳብሎሴ፥ ስከርድን ሰጨነረ ኮ ፍጫሙደንታ በእንተነ፥ ስክንባብከሰረ ክታይንችንከሰኬ። <verse eid="MAT 13:39"/><verse number="40" style="v" sid="MAT 13:40"/>ገታ ለሰና ቡጭምሶ ኖሄካ አተርድንደትግንዳ ኮ ፍጫሙደንታ በእንተነረ ኮትኮግንዳ ማደ። <verse eid="MAT 13:40"/><verse number="41" style="v" sid="MAT 13:41"/>ኮትኮᎺይካ ኤደት ይንች ይንታ ክታይንችን ኦይዴ፥ ከተረ ጎማ ፍክስታ ጎግ ማችባብከስምከ ዳቅል ፍግዝድባብከስም ሙዳ ክታ ባንችምናርንካ ሳንስሶ ከትም ዉችተረኬ፥ <verse eid="MAT 13:41"/><verse number="42" style="v" sid="MAT 13:42"/>ድግዳክን ኖሄናረረ ከትም ኦይተሬ፥ ኮታር ኤፍከ አች ቅርጭካ ማተረ። <verse eid="MAT 13:42"/><verse number="43" style="v" sid="MAT 13:43"/>ጭልንከስ ይንታ ባበንታ ባንችምናር Ꮊይግንዳ ሳክስተረከ፥ ቃም ዶቅድባብ ኤሰራ!” ኩንጋየሮ ከትካንታ ማስሴ።<verse eid="MAT 13:43"/></para>
  <para style="s1">አችምሳን ቆልመታ ካምስ</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44"/>ኮታዘንከረ የሱስ፥ “ጭላ ባንችምና ዎን Ꮊምናር አችምሳን ቆልመንም ና ካምዴ። ዋልቃ ኤች ኮትኮ ቆልመንም ይ Ꮊፍሳንደትካ ማስትዮ አቼ፥ ይንታ ጉርምንታ በድምዘንካ አምሳንዳ አይሶ ይንታ ዶቅድንደትም ሙዳ ሰንሶ ኮትኮ ዎን Ꮊምንም ሰንት ተዬ”። ኩን ጋይሴ።<verse eid="MAT 13:44"/></para>
  <para style="s1">እንቁ ጋየርድንደታ ካምስ</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45"/>አናካርንከረ የሱስ፥ “ጭላ ባንችምና ኡርማ እንቁ ጋየርድንደትም ሰንት ተይካንታ ዝግድባብ ዛለንባብም ና ካምዴ፥ <verse eid="MAT 13:45"/><verse number="46" style="v" sid="MAT 13:46"/>ዛለንባበረ ስንጋ ማቻን እንቁ ጋየርድንደትም ይ Ꮊፍሳንደትካ አይሶ ይንታ ዶቅድንደትም ሙዳ ኦስ ሰንሶ ኮትኮ እንቁ ጋየርድንደትም ሰንት ተዬ” ኩን ጋይሴ።<verse eid="MAT 13:46"/></para>
  <para style="s1">ሞለን የደርድን ሳከንታ ካምስ</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47"/>ኮታዘንከረ የሱስ፥ “ኮትኮግንደረ ጭላ ባንችምና ሎቀን ባሀርናር ኦይትምሶ ሞለን የድን ሳከንም ና ካምዴ፥ ናኮና ሳከነረ Ꮊክ Ꮊክ ሞለንከስም የድንዴ፥ <verse eid="MAT 13:47"/><verse number="48" style="v" sid="MAT 13:48"/>ኮታር ጮጫንደትካ ሞለን የድባብከስ ሎቀን ባሀርንታ ፋማ ጎችት ዉጅደኬ፥ ከታ ዶቅሰረ ኡርማ ኡርመን እድሰኮ ርያር ዎደከ፥ ዳቅል ዳቅልንም ማቼ ኦስ ዛቅደኬ። <verse eid="MAT 13:48"/><verse number="49" style="v" sid="MAT 13:49"/>በእንታ ስለናር ኮትኮግንዳ ማዴ፥ ክታይንችና Ꮊድሶ ጎመንባብከስም ጭልንከሳርንካ ከትም ፋስተረኬ። <verse eid="MAT 13:49"/><verse number="50" style="v" sid="MAT 13:50"/>ዳቅልንከስም ድግዳክን ኖሄናር ከትም ኦይተሬ፥ ኮታር ኤፍኬ አች ቅርጭካ ማተረ” ኩን ጋይሴ።<verse eid="MAT 13:50"/></para>
  <para style="s1">ክለተኬ ገሳ ማዝገብንጎካ</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51"/>ጉጅሰረ የሱስ፥ “ኮም ሙዳ ገቀርት ተየቴ?” ከደር ጋይሴ።</para>
  <para style="q1" vid="MAT 13:51">ከተረ፥ “ይዬ!” ጋይሰኬ።<verse eid="MAT 13:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52"/>የሱስ፥ ኮና ኩን ጋይንትና ዋልቃ ሙሴታ ህግንም ኤስዝድባብ “ጭላ ባንችምንትደትም ኤስሶ ይንታ ቡለናርንካ ክለንምኬ ገሳ ሪንከስም ዉጅድባብ ኤችንም ካምዴ” ኩንጋይሶ ከትካንታ ማስሴ።<verse eid="MAT 13:52"/></para>
  <para style="s1">የሱሰዘን ናዝረት ካተመናር የልሳን ግርና</para>
  <para style="r">(<ref loc="MRK 6:1-6">ማር. 6፡1-6</ref>፤ <ref loc="LUK 4:16-30">ሉቃ. 4፡16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53"/>የሱስ ከትኬና ካምስንከስም ኬዝሶ ይ በይሳንደታ ቡር ኮት ካርናርንካ አይሴ። <verse eid="MAT 13:53"/><verse number="54" style="v" sid="MAT 13:54"/>ይ አጠርሳን ናዝሬት ካተመናር Ꮊድሶ አይሁድንታ ምክስ ኤሄናር ዎርሰንከስም ኤስዝድ Ꮊቄ፥ ኤሰርስባብከሰረ ሙዳ በርእካ ኩን ጋይድ Ꮊቀኬ፥ “ኮና ኤችና ኮም ኤጨንምኬ ኮም በርእስዝድን ፍክስን Ꮊምንክክ ተይ Ꮊዳሬ። <verse eid="MAT 13:54"/><verse number="55" style="v" sid="MAT 13:55"/>ኖኮና ኤሄን ዎድባብ አናጭንታ ይንችና ካዮ? ክታ እንደንታ ላምና ማራማ ጋይምድንዳ ኮዮ? ክታ እስመንከሰረ ያይቆብ፥ ዮሴፍ፥ ስምኦንኬ ይሁደካ ካየኮ? <verse eid="MAT 13:55"/><verse number="56" style="v" sid="MAT 13:56"/>ክታ ምችነንከሰረ ሙዳ ዎንካ ክክን ካየኮ፥ ይና ኮናና ኮና ኤችና ኮም ሙዳ ኤጨንም Ꮊምንክክ Ꮊፍሳሬ?” <verse eid="MAT 13:56"/><verse number="57" style="v" sid="MAT 13:57"/>ኮትኮጎከረ ክትካ ጎሄርሰኮ ክታ ኬዘንም ተይክሳ ነገደኬ የሱስ ማቼ፥ “ሳብዘንካ ኤሰርሶ ኬዝድባብ ቦንችምዳክንዳ ይንታ አጠርሳን ፍጨዘንኬ ይንታ ገታ ኤሄናር Ꮊክዬ” ከደረ ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">13፡57 </char><char style="xt" closed="false"><ref loc="JHN 4:44">ዮሀ. 4፡44</ref>። </char></note><verse eid="MAT 13:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58"/>ከት አሜንክሳ ነገዳንጎካ የሱስ ኮታር በድ አተንም ፍክሳክዬ።<verse eid="MAT 13:58"/></para>
  <chapter eid="MAT 13"/>
  <chapter number="14" style="c" sid="MAT 14"/>
  <para style="s1">ስእስንባብ ዮሀንሰታ ደእና</para>
  <para style="r">(<ref loc="MRK 6:14-29">ማር. 6፡14-29</ref>፤ <ref loc="LUK 9:7-9">ሉቃ. 9፡7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1"/>ኮታይካ ገሊላ ፍጨን ቆልድ Ꮊቅባብ ሄሮድስ፥ የሱሰታ ፍክስንጎካ ኤሰርሴ። <verse eid="MAT 14:1"/><verse number="2" style="v" sid="MAT 14:2"/>ይንታ ፍክስንባብከስመረ፥ “ኮና ስእስንባብ ዮሀንሴ፥ ኖየረ ደእያርንካ አምቴ፥ ኬና በርእስዝድን ርንከስ ክትጎካ ይማዶቅድንዳ ኮካንተ” ከደር ጋይሴ።<verse eid="MAT 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3"/>ሄሮድስ ዮሀንሰም የችስሶ ዞክና ኤሀር ዞክስሶ Ꮊቄ፥ ኮመረ ክት ይሳንዳ ክታ እስመን ፍልጶሰታ ኬነን ሄሮድያዳጎከ።<note caller="-" style="x"><char style="xo" closed="false">14፡3 </char><char style="xt" closed="false"><ref loc="LUK 3:19-20">ሉቃ. 3፡19-20</ref>። </char></note> <verse eid="MAT 14:3"/><verse number="4" style="v" sid="MAT 14:4"/>Ꮊረታ ጋይሴ ዮሀንስ ሄሮድስካንታ “የስታ እስመንታ ኬነንም የስ እንጅድንግንዳ ህግና ጋያዬ!” ክትም ጋይድ Ꮊቄ።<note caller="-" style="x"><char style="xo" closed="false">14፡4 </char><char style="xt" closed="false"><ref loc="LEV 18:16">ሌዊ. 18፡16</ref>፤ <ref loc="LEV 20:21">20፡21</ref>። </char></note> <verse eid="MAT 14:4"/><verse number="5" style="v" sid="MAT 14:5"/>ኮካንታ ሄሮድስ ዮሀንሰም ደይሳካንታ ዝግድ Ꮊቄ፥ ኬዛርንካ ማቼ ዎርሰንከስ ሳብዘንካ ኤሰርሶ ኬዝድባብግንዳ ክትም ከት ሰድንካንታ ዎርሰንከስካንታ ኖ ጳሴ።<verse eid="MAT 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6"/>ሄሮድሰታ አጥር ሰጨንም ቦንጅድንደትካ ሄሮድያደታ ይንቸና Ꮊድሶ ሶችንከስታ እሪ ይግካ በይደሮ ሄሮድሰም ና ጉርምሴ። <verse eid="MAT 14:6"/><verse number="7" style="v" sid="MAT 14:7"/>ኮካንታ ሄሮድስ፥ “የስ ዝግድንደትም እም ኦይስካ! እተረ የስካንታ እምትቴ!” ኩንጋየሮ ጫቅሶ ኬዜ። <verse eid="MAT 14:7"/><verse number="8" style="v" sid="MAT 14:8"/>ና ይንቸነረ ይንታ እንደንታ ዞረንካ፥ “ስእስንባብ ዮሀንሰታ ቃደንም ጋበትያር ዎታዮ ሳነካ እካንታ እምካ!” ና ክደር ጋይሴ።<verse eid="MAT 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 14:9"/>ባንችና ኮ ኬዘንካ ሞርእሴ፥ ማታጋካ ዳት ይንታ ጫቀንጎከ ክትካ ክክን እችምካንታ ዶቅሶ Ꮊቃን ኤድንከስጎካ ኦስንሶ ዮሀንሰታ ቃደና እምምድንግንዳ ክትሴ። <verse eid="MAT 14:9"/><verse number="10" style="v" sid="MAT 14:10"/>ኮካንታ ዞክና ኤሀር ኤድም ኦይትሶ ዮሀንሰታ ቃደንም ተችሴ። <verse eid="MAT 14:10"/><verse number="11" style="v" sid="MAT 14:11"/>ተቻን ቃደንም ጋበትናር ዎትዮ ይንቸንንካንታ እምሴ፥ ና ይንቸነረ ይንታ እንደንካንታ እምሴ። <verse eid="MAT 14:11"/><verse number="12" style="v" sid="MAT 14:12"/>ዮሀንሰታ ካርንካ ጎርስምድባብከስረ Ꮊድሰኮ ክታ ለይስንም ተይ አይሰኮ ዱክሰኬ፥ ከተረ አይሰኮ ኮም ሪይንም የሱስካንታ ኬዘኬ።<verse eid="MAT 14:12"/></para>
  <para style="s1">የሱስ ዶንቅ ሳአ ኤድንከስም እችስና</para>
  <para style="r">(<ref loc="MRK 6:30-44">ማር. 6፡30-44</ref>፤ <ref loc="LUK 9:10-17">ሉቃ. 9፡10-17</ref>፤ <ref loc="JHN 6:1-14">ዮሀ. 6፡1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13"/>የሱስ ዮሀንሰታ ደእንም ይ ኤሰርሳንደትካ ሎቀንዘንካ ቃልዝድን ጃልበናር አርድሶ Ꮊርን ጋይሳን ካርዘን ይንት አይሴ። ዎርሰንከሰረ ኮም ሙዳ ይ ኤሰርሳንደትካ ካተመንከሳርንካ ዉትሰኮ ዱትካ ክትም ጎርስምሰኬ። <verse eid="MAT 14:13"/><verse number="14" style="v" sid="MAT 14:14"/>የሱስ ሎቀንዘንካ ቃልዝድን ጃልበናርንካ ይ Ꮊንቸርሳንደትካ በድ ዎርሰንከስም ሰድሶ ከትካንታ አተርሰ ከታርንካ ሰቀርስባብከስመረ ፋችሴ።<verse eid="MAT 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15"/>ፍጨና ሶይቻንደታ ቡር ክታ ካርንካ ጎርስምድባብከስ ክደር Ꮊድሰኮ “ኮና ካርና Ꮊረነረ Ꮊፈርዳክንዳ ኤድ ካየንካርዬ ፍጨነረ ሶይቴ፥ ኮካንታ ዎርሰና ቅንች ዶቅድን ሞረንከሳር አይሰኮ ከታ ይ እጅድንደትም ሰንት ተይᎺድንግንዳ ከትም ኦይትካ” ክትም ጋይሰኬ።<verse eid="MAT 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16"/>የሱስ ማቼ “የታ ከት እጅድንደትም እምከት ዳት ከትም አይ ዝክሳዬ!” ከደር ጋይሴ።<verse eid="MAT 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17"/>ክታ ካርንካ ጎርስምድባብከሰረ “ዎንታ ካሪ ዶቅድንዳ ዶንቅ ባይስኬ ቃስተን ሞለካ Ꮊክዬ” ክደር ጋይሰኬ።<verse eid="MAT 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18"/>የሱሰረ “የንደር ዶቅድን ከትም እዝደር ተይ Ꮊድከቴ!” ጋይሴ። <verse eid="MAT 14:18"/><verse number="19" style="v" sid="MAT 14:19"/>ኮታዘንከረ ዎርሰና ድረንዘን ዶቅድንግንዳ ክትሴ፥ ዶንቅ ባይስንምከ ቃስተን ሞለን ተይሶ አፍን ይንታ ጭላር ማስሶ ጋለቼ ባይስንመረ አስትዮ ይንታ ካርንካ ጎርስምድባብከስ ካንተረ እምሴ፥ ክታ ካርንካ ጎርስምድባብከሰረ ዎርሰንካንታ የልስሰኬ። <verse eid="MAT 14:19"/><verse number="20" style="v" sid="MAT 14:20"/>ሙደነረ እችሰኮ ምሰኬ፥ ስጣን ዶከንም ክታ ካርንካ ጎርስምድባብከስ ታመከ ቃስተን ጋባስርካ ጮጭ አምሰኬ። <verse eid="MAT 14:20"/><verse number="21" style="v" sid="MAT 14:21"/>እችባብ ኤድንከሰረ ማነንከስክኬ ይንችንከስ ፋይድማክናና ዶንቅ ሳአ ማድን አⷝኔንከስ Ꮊቀኬ።<verse eid="MAT 14:21"/></para>
  <para style="s1">የሱስ ባሀርንዘን ሙከሮ ክታ አይና</para>
  <para style="r">(<ref loc="MRK 6:45-51">ማር. 6፡45-51</ref>፤ <ref loc="JHN 6:15-21">ዮሀ. 6፡15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22"/>ኮታ ቡር የሱስ ይንታ ካርንካ ጎርስምድባብከስም፥ “እታ ዎርሰንከስም እ ኦይተርን የለልታ ሎቀንዘንካ ቃልዝድን ጃልበናር አርድሰቶ እርናና ባሃርንታ ፋማ ቃልከተ” ጋይሶ ከትም ክትሴ። <verse eid="MAT 14:22"/><verse number="23" style="v" sid="MAT 14:23"/>ዎርሰንም ይ ኦይቻንደታ ቡር ምክስካንታ ይንት ገቸንዘን ዉተዴ፥ ፍጨና ሶይቻንደትከረ የሱስ ኮታር ይንት Ꮊቄ፥ <verse eid="MAT 14:23"/><verse number="24" style="v" sid="MAT 14:24"/>ኮታይካ ሎቀንዘንካ ቃልዝድን ጃልበና ዎእድን ካርንዘንካ ኦስ ባሀርንታ ዎክያር አይድንካ ኮታ እርጎካ Ꮊድን ዞገንካ Ꮊቅመሮ ሎቀንዘን ዶቅድን ዞገንካ ኦስከ ፈንካ ዙብምድ Ꮊቄ።<verse eid="MAT 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25"/>ሶይት ሳክላ ሳዓታ ቡር የሱስ ባሀርንዘን ሙከሮ ይንት ይንታካርንካ ጎርስምድባብከዝደር Ꮊዴ። <verse eid="MAT 14:25"/><verse number="26" style="v" sid="MAT 14:26"/>ክታካርንካ ጎርስምድባብከሰረ ባሀርንታዘን ሙከሮ አይድንካ ሰድሰኮ አንድር ጳስካ ገቅሰኬ፥ “ኮነረ ቡንኬ!” ጋይሰኮ ፍፍሰኬ።<verse eid="MAT 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27"/>የሱሰረ ሳናናና፤ “ዳእከቴ! እትቴ Ꮊይጳሰቴ” ከትም ጋይሴ።<verse eid="MAT 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28"/>ጴጥሮሰረ፥ “የ ጮይስዮ! የስ ማቼ ባሀርንታዘን ሙከርቶ የዝደር እ Ꮊድንግንዳ እም ክትካ” ክደር ጋይሴ።<verse eid="MAT 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29"/>የሱሰረ “Ꮊድካ!” ክትም ጋይሴ። ኮካንታ ጴጥሮስ ጃልበናርንካ Ꮊንቸርሶ የሱሰደር አይካንታ ባሀርንታዘን ሙከሮ አይ የጄ። <verse eid="MAT 14:29"/><verse number="30" style="v" sid="MAT 14:30"/>ኬዛርንካ ማቼ ዞገንታ ዎልቀንም ሰድሶ ጳሴ፥ ባሀርንታ ዋር ኤቅዝም ይ የጃንደትካ “የ ጮይስዮ! እም አቅስካ!” ጋይሶ ፍፍሴ።<verse eid="MAT 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31"/>ሳነካ የሱስ ይንታ አንን ኦይትሶ የድስንደትኬ፥ “የና አሜን የስታ ዞገርስባብ! Ꮊረተስ Ꮊኤርሳራ?” ክትም ጋይሴ።<verse eid="MAT 14:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32"/>የሱሰኬ ጴጥሮስካ ጃልበናር ከት አርደዳንደትካ ዞገና ስምን ጋይሴ። <verse eid="MAT 14:32"/><verse number="33" style="v" sid="MAT 14:33"/>ኮታዘንከረ ጃልበናር Ꮊቅባብከስ፥ “ዶፈን የና ሳብታ ይንቸዬ!” ጋይሰኮ የሱሳካንታ ጎስትሰኬ።<verse eid="MAT 14:33"/></para>
  <para style="s1">የሱስ ገንሰረጥ ፍጨናር ሰቅምንክንባብከስም ፋችና</para>
  <para style="r">(<ref loc="MRK 6:53-56">ማር. 6፡53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34"/>የሱሰኬ ክታ ካርንካ ጎርስምድባብከስ ባሀርንም ቃልሰኮ ገንሰረጥ ፍጨናር የልሰኬ። <verse eid="MAT 14:34"/><verse number="35" style="v" sid="MAT 14:35"/>ኮት ፍጨናር Ꮊቃን ኤድንከስ ክት የሱስ ማትንተን ከታ ይ ኤሳንደትካ ላመካ ዶቅድን ፍጫ ሙደናርንካ አይሰኮ ሰቀርስባብከስ ሙደንም ክደር ተይᎺችሰኬ። <verse eid="MAT 14:35"/><verse number="36" style="v" sid="MAT 14:36"/>ሰቀርስባብከሰረ ክታ አፍለንታ ካንተን Ꮊክ ከት ዎልድንግንዳ ክትም ምክሰኬ። ክትም ዎልስባብከሰረ ሙደና ይንታ ሰቅምናርንካ ቦድሶ ፋጨኬ።<verse eid="MAT 14:36"/></para>
  <chapter eid="MAT 14"/>
  <chapter number="15" style="c" sid="MAT 15"/>
  <para style="s1">ኤና እሪ ባበንከስታ ዎጋ</para>
  <para style="r">(<ref loc="MRK 7:1-13">ማር. 7፡1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1"/>ኮታ ቡር የሩሳሌም ካተመናርንካ Ꮊድባብ ፈረሳውያንንኬ ሙሴታ ህግን ኤስዝድባብከስ የሱሰደር Ꮊድሰኮ፥ <verse eid="MAT 15:1"/><verse number="2" style="v" sid="MAT 15:2"/>“የስታ ካርንካ ጎርስምድባብከስ ጋልተንከስታ ዎገንም Ꮊራካንተረ ከት ክትምዳክንዳ? ይና ኮሰቸቴ! እችም ከት እጅድንዳ ከታ ይንታ አንከስም ስኤራክሴ!” ኩንጋይሶ ኦይሰኬ።<verse eid="MAT 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3"/>የሱሰረ፥ “የታ የንታ ዎገንም ካርስካንታ ጋይሰቶ ሳብታ ክተንም Ꮊራካንተንት ዉልእዳ? <verse eid="MAT 15:3"/><verse number="4" style="v" sid="MAT 15:4"/>ሳብ ‘የስታ ባበንምኬ እንደንም ቦንችካ፥ ይንታ ባበንም አነረ ይንታ እንደንም የግድባብዘን ደእታ ዋጭና ክታዘን የልተሬ’ ጋይሶ ክቴ።<note caller="-" style="x"><char style="xo" closed="false">15፡4 </char><char style="xt" closed="false"><ref loc="EXO 20:12">ዉት. 20፡12</ref>፤ <ref loc="EXO 21:17">21፡17</ref>፤ <ref loc="DEU 5:16">ካሪ. 5፡16</ref>፤ <ref loc="LEV 20:9">ሌዊ. 20፡9</ref>። </char></note> <verse eid="MAT 15:4"/><verse number="5" style="v" sid="MAT 15:5"/>የታ ማቼ ዋልቃ ኤድ ይንታ ባበንም አነረ ይንታ እንደንም ‘እዘንካ የᎺብድን አለንም ሳብካንታ እማ ማስስቶ እምትቴ’ ከደር ጋይዴ፥ <verse eid="MAT 15:5"/><verse number="6" style="v" sid="MAT 15:6"/>‘ኖኮና ኤችና ይንታ ባበንም [አና እንደንም] ቦንቻ ክትም ዝክሳዮ’ የታ ጋይደቴ፥ ኮካንታ የንታ ዎገንም ካርስካንታ ጋይሰቶ ሳብታ ህግንም ዉልእደቴ። <verse eid="MAT 15:6"/><verse number="7" style="v" sid="MAT 15:7"/>የታ ኦተረንባብከሶ! ኢስያስ የጎካ ኩንጋይሶ ቤርካ ክት ኬዛንዳ ገተቴ፥<verse eid="MAT 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8"/>“ ‘ኮና ዎርሰና ይንታ አፈንካ እም ቦንጅዴ፥</para>
  <para style="q2" vid="MAT 15:8">ኬታ ቡደና ማቼ እዘንካ ጎተርሳንዴ፥<verse eid="MAT 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9"/>ኤታ ዎገንምኬ ፍክስንም፥</para>
  <para style="q2" vid="MAT 15:9">ሳብታ ህግግንዳ ማስሶ ኤስሰሮ ዉችኩን እም ጎይንደኬ’ ” <note caller="-" style="x"><char style="xo" closed="false">15፡9 </char><char style="xt" closed="false"><ref loc="ISA 29:13">ኢሳ. 29፡13</ref>። </char></note></para>
  <para style="m" vid="MAT 15:9">ኩን ጋይሶ ከትካንታ ማስሴ።<verse eid="MAT 15:9"/></para>
  <para style="s1">ኤድም ቱና ማስዝድ ሪ</para>
  <para style="r">(<ref loc="MRK 7:14-23">ማር. 7፡14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10"/>ኮታዘንከረ የሱስ ኤድንከስም ይንደር ኤልሶ፥ “ኤሰርከቴ! ገቀርተረ ተይከቴ! <verse eid="MAT 15:10"/><verse number="11" style="v" sid="MAT 15:11"/>ኤድም ቱና ማስዝድንዳ ክታ አፈናርንካ ዉድንዳ ዳት ክታ አፋር አርድንዳ ካዬ!” ኩን ከትም ጋይሴ።<verse eid="MAT 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12"/>ኮታ ቡር ክታ ካርንካ ጎርስምድባብከስ ክደር Ꮊድሰኮ “ፈረሳውያንንከስ ኮም የስ ኬዛንደትም ኤሰርሰኮ ከት ኮተርሳንደትም የና ኤስታ? ኩን ጋየረኮ ክትም ኦይሰኬ። <verse eid="MAT 15:12"/><verse number="13" style="v" sid="MAT 15:13"/>ኖ ማቼ ጭላርንባብ እስታ ባቤና ኮራክን ኮረና ሙዳ ቡጭምዴ፥ <verse eid="MAT 15:13"/><verse number="14" style="v" sid="MAT 15:14"/>ኬታ ይንታ ማታ አፍይ ዝልኬ አፍይ ዝልንከስም ጎርዝድባብ ከት ማቻንካንታ ከትም ዛእከቴ፥ አፍይ ዝልና አፍይ ዝልንም ጎርዝዴ ኬታ ቃስተነረ ጎርናር ዋጅደኬ” ኩንጋየሮ ከትካንታ ማስሴ።<note caller="-" style="x"><char style="xo" closed="false">15፡14 </char><char style="xt" closed="false"><ref loc="LUK 6:39">ሉቃ. 6፡39</ref>። </char></note><verse eid="MAT 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15"/>ጴጥሮስ ማቼ የሱሰም “ካምስንታ ቡልን ዎካንታ ኤስምስካ” ጋይሴ። <verse eid="MAT 15:15"/><verse number="16" style="v" sid="MAT 15:16"/>የሱሰረ “የታ ታ የለልታ ገቀርት ተያከቴ? <verse eid="MAT 15:16"/><verse number="17" style="v" sid="MAT 15:17"/>አፋር አርድ ሪ ሙደና ልጳር የልሶ ኮታ ቡረረ ኦስ ድራሳን ማትሶ ዉድንደትም ገቀርት ተይዳከቴ? <verse eid="MAT 15:17"/><verse number="18" style="v" sid="MAT 15:18"/>አፋርንካ ዉድንዳ ማቼ ቡዳርንካ ዉዴ፥ ኤድም ቱንዝድንዳ ኮኔ።<note caller="-" style="x"><char style="xo" closed="false">15፡18 </char><char style="xt" closed="false"><ref loc="MAT 12:34">ማቶ. 12፡34</ref>። </char></note> <verse eid="MAT 15:18"/><verse number="19" style="v" sid="MAT 15:19"/>ኬተረ ዳቅል ገቅር፥ ኤድንም ደይሳ፥ ማነንም ኦካኦንግድባብ፥ ቤልምድባብ፥ ድቢይ፥ ካርከካ ማርክር ኤድም የክይ፥ ኬና ሙደና ኤታ ቡዳርንካ ዉዴ። <verse eid="MAT 15:19"/><verse number="20" style="v" sid="MAT 15:20"/>ኤድም ቱና ማስዝድንዳ ኬና ከስ ዳት አን ስኤራክሳ እችና ቱና ማስዝዳክዬ” ኩን ጋይሴ።<verse eid="MAT 15:20"/></para>
  <para style="s1">ከነአን ፍጨናር ኤተንንታ አሜንና</para>
  <para style="r">(<ref loc="MRK 7:24-30">ማር. 7፡24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21"/>የሱስ ኮታርንካ ዉትሶ ጢሮሳርኬ ስዶና ካተመንከስታ ሞረናር አይሴ። <verse eid="MAT 15:21"/><verse number="22" style="v" sid="MAT 15:22"/>ኮታዘንከረ ከነአን ፍጫ ኤተን የሱሰደር Ꮊድሶ፥ “ጮይስ ማችባብ ዳውትታ ይንችኖ! እስታ ይንቼና ቱና አያንካ የደርሶ አንድር ማጥራዶቅዴ ዋደ እካንታ አተርካ!” ኩንጋየሮ ና ፍፍሴ።<verse eid="MAT 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23"/>የሱስ ማቼ ዋልቀረ ኮትካንታ ከዛክ ዶቆ ጫምን ጋይሴ፥ ኮታይካ ክታ ካርንካ ጎርስምድባብከስ ክደር Ꮊድሰኮ፥ “ናኮና ኤተንና ዎም ጎርስመሮ ኮት ፍብድንካንታ ዋዴ ኮትም ኬዝሶ ማስካ!” ጋየረኮ ክትም ምክሰኬ። <verse eid="MAT 15:23"/><verse number="24" style="v" sid="MAT 15:24"/>ኖየረ “እ ኦይትምሳንዳ እስራኤል ኤድንከሳርንካ ቆልንከስግንዳ ካይድባብከስካንታ Ꮊክዬ” ጋየሮ ከትካንታ ማስሴ።<verse eid="MAT 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25"/>ኤተና ማቼ Ꮊድሶ ክታ ዱትንታዘን ዋችሶ፥ “የ ጮይስዮ! እም አሌንም አልካ!” ና ጋይሴ።<verse eid="MAT 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26"/>የሱሰረ፥ “ይንችንከስታ እችምን ተይሶ አክስንከስካንታ እማ ኡርማ ካዬ” ኮደር ጋይሴ።<verse eid="MAT 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27"/>ኤተነረ “የ ጮይስዮ! ኮና ገቴ ኬዛርንካ ማቼ አክስንከሰረ ከትም ቆልድባብከስታ እችምናርንካ ዋጅድንደትም ድንግመንም እጅደኬ” ና ጋይሴ።<verse eid="MAT 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28"/>ኮታይካ የሱስ “የና ኤተኖ የስታ አሜንና! አንድሬ፥ ኮካንታ የስታ ዝግመትንግንዳ የስካንታ ማታ!” ኮትም ጋይሴ። ኤተንንተረ ይንቸና ኮት ሳዓትንዘን ፋጬ።<verse eid="MAT 15:28"/></para>
  <para style="s1">የሱስ ሰቀርስባብ በድ ኤድንከስም ፋችና</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29"/>የሱስ ኮታርንካ አምሶ ገሊላ ባሃር ሎቀንታ ላማር Ꮊዴ፥ ገቸንዘን ዉትሶ ዶቅሴ። <verse eid="MAT 15:29"/><verse number="30" style="v" sid="MAT 15:30"/>በድ ኤድንከስ ዎከል ዎከልን ጋይድን ኤድንከስም አፍይ ዝልንከስም ዎብንከስም አፋ ከዝዳክባብከስም አብንከስምኬ ሰቅምንክንባብከስም የድሶ የሱሰደር ተይ Ꮊደኬ፥ ክታ ዱትንታ ላመር ዎጀኬ ኖየረ ከትም ፋችሴ። <verse eid="MAT 15:30"/><verse number="31" style="v" sid="MAT 15:31"/>ኮካንታ ዎርሰና አፋ ከዝዳክባብከስ ኬዝድንካ፥ ዎብንከስ ፋጭድንካ ዎከልዎከል ጋይድባብከስ ኡርመካ ከት ሙግድንካ፥ አፍ ዝልንከስ ሰድንካ ከታ ሰድሰኮ በርኤረኮ እስራኤልንከስታ ጮይስንም ጋለቸኬ።<verse eid="MAT 15:31"/></para>
  <para style="s1">የሱስ ኦይድ ሳአ ኤድንከስም እችና</para>
  <para style="r">(<ref loc="MRK 8:1-10">ማር. 8፡1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32"/>የሱስ ይንታካርንካ ጎርስምድባብከስም ኤልሶ፥ “ዎርሰንከስ እንካ ክክን ማከን ሰጫ ከት Ꮊቃንጎካ ከት እጅድን ሪ ካየንካንታ ከትጎካ አተርድቴ፥ አይደኮ ጎግዘን ከት ዋጅዳክንግንዳ ከት እቻክናና ኦይትካንታ ዝግዳክቴ” ኩን ከደር ጋይሴ።<verse eid="MAT 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33"/>ክታ ካርንካ ጎርስምድባብከሰረ “ይና ኮ ሙዳ ዎርሰንከስካንታ ማድን እችም ኮ ዴል ቆቼናር Ꮊምንኮንት Ꮊብዳ?” ክደር ጋይሰኬ። <verse eid="MAT 15:33"/><verse number="34" style="v" sid="MAT 15:34"/>የሱሰረ “የንደር መም ሶላ ዶቅዳ?” ጋይሶ ከትም ኦይሴ። ከተረ “ታብዛ ባይስኬ ቶክም መራ ሞለንከስ ዶቅዴ” ክደር ጋይሰኬ።<verse eid="MAT 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35"/>ኮታ ቡር የሱስ ዎርሰንከስም ፍጨዘን ዶቅድንግንዳ ክትሴ፥ <verse eid="MAT 15:35"/><verse number="36" style="v" sid="MAT 15:36"/>ታብዛ ባይስንምኬ ሞለንም የድሶ ይ ጋለቻንደታ ቡር፥ ባይስንም አስትዮ ይንታ ካርንካ ጎርስምድባብከስካንታ እምሴ። ከተረ ዎርሰንከስካንታ የልስሰኬ። <verse eid="MAT 15:36"/><verse number="37" style="v" sid="MAT 15:37"/>ሙደነረ እችሶ ምሰኬ፥ ስጣንደትመረ ክታ ካርንካ ጎርስምድባብከስ ሳንስሰኮ ታብዛ ጋባስርካ ጮጭ አምሰኬ። <verse eid="MAT 15:37"/><verse number="38" style="v" sid="MAT 15:38"/>እችባብ ኤድንከሰረ ማነንከስኬ ይንችንከስካ ፋይድማክናና ኦይድ ሳአ አⷝኔንከስ Ꮊቀኬ።<verse eid="MAT 15:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 15:39"/>ኮታ ቡር የሱስ ዎርሰንም ኦይቼ፥ ሎቀንዘንካ ቃልዝድን ጃልበናር አርድሶ መገዶን ፍጨናር አይሴ።<verse eid="MAT 15:39"/></para>
  <chapter eid="MAT 15"/>
  <chapter number="16" style="c" sid="MAT 16"/>
  <para style="s1">ሳብዘንካ አተንም ሰድንካንታ Ꮊዳን ኦይስና</para>
  <para style="r">(<ref loc="MRK 8:11-21">ማር. 8፡11-21</ref>፤ <ref loc="LUK 12:54-56">ሉቃ. 12፡54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1"/>ፈረሳውያንንከስኬ ሰዱቃዊያንንከስ የሱሰደር Ꮊድሰኮ ክትም ጰጫካንታ ዝግሰኮ “ጭላርንካ ቃዉተንም ዎካንታ ሰችስካ” ኩንጋየሮ ክትም ኦይሰኬ።<note caller="-" style="x"><char style="xo" closed="false">16፡1 </char><char style="xt" closed="false"><ref loc="MAT 12:38">ማቶ. 12፡38</ref>፤ <ref loc="LUK 11:16">ሉቃ. 11፡16</ref>። </char></note> <verse eid="MAT 16:1"/><verse number="2" style="v" sid="MAT 16:2"/>የሱስ ማቼ፥ “ሶይት ጭለና ዘይስንካ የ ሰዴ ‘ፍጨና ኦይጥማ ማዴ’ የታ ጋይደቴ፥ <verse eid="MAT 16:2"/><verse number="3" style="v" sid="MAT 16:3"/>ፍጨና ሰጭድንካ ‘ጭለና ኡፔካ ዘይሶ ጫልድንካ ታካ ዶብ ቃንዴ’ ጋይደቴ፥ ጭለንም ሰድሰቶ ፋስት ኤዝደቴ፥ ኬዛርንካ ማቼ ስለንታ ቃዉተንም ማቼ ፋስት ኤዝዳከቴ<note caller="+" style="f"><char style="fr" closed="false">16፡3 </char><char style="ft" closed="false">ኤና እርንከሳር ፋይ. 2 ከ 3 ዶቅድባብ ዋልቃ ዋልቃ ኤንከስ የሱሰታ ኬዘና ካዬ </char></note> <verse eid="MAT 16:3"/><verse number="4" style="v" sid="MAT 16:4"/>ዳቅልንከስኬ አሜንዳክን አጥርንከስ ቃዉተንም ሰድንካንታ ዝግዴ፥ ኬዛርንካ ማቼ ሳብዘንካ ኤሰርሶ ኬዛቅባብ ዮናሰታ ቃዉተንዘንካ አብ ቃዉታ እምምዳክዬ ጋየሮ ከትካንታ ማስሴ”። ኮታዘንከረ የሱስ ከትም ዛቅሶ አብ ካርዘን አይሴ።<note caller="-" style="x"><char style="xo" closed="false">16፡4 </char><char style="xt" closed="false"><ref loc="MAT 12:39">ማቶ. 12፡39</ref>፤ <ref loc="LUK 11:29">ሉቃ. 11፡29</ref>። </char></note><verse eid="MAT 16:4"/></para>
  <para style="s1">ፈረሳዊያንንከስተኬ ሰደቃዊያንንከስታ እርሸና</para>
  <para style="r">(<ref loc="MRK 8:14-21">ማር. 8፡14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5"/>ክታ ካርንካ ጎርስምድባብከስ ባሀርንታ ፋማ ከት ቃልሳንደትካ ባይስንም ባቀርሰኬ። <verse eid="MAT 16:5"/><verse number="6" style="v" sid="MAT 16:6"/>የሱስ ይንታካርንካ ጎርስምድባብከስም “ቡደርሶ ገቀርከቴ ፈረሳዊያንንከስተከ ሰዱቃንንከስታ እርሰንዘንካ ካርስምከቴ” ከትም ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">16፡6 </char><char style="xt" closed="false"><ref loc="LUK 12:1">ሉቃ. 12፡1</ref>። </char></note><verse eid="MAT 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7"/>ከተረ “ኮም ክታ ጋይና Ꮊረንግርካ ባይስንም ዎ የዳክንካንታ ማደ” ጋይንተካ ክክክ ከዝምሰኬ።<verse eid="MAT 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8"/>የሱስ ማቼ ከታ ገቅርን ኤስሶ “የታ አሜን ዞገርስባብከሶ! ‘ባይስን ዎ የዳክንካንቴ ጋይሰቶ Ꮊራካንተንት ክክ ክክ ከዝምዳ? <verse eid="MAT 16:8"/><verse number="9" style="v" sid="MAT 16:9"/>ታየረ የታ ገቀርት ተያየቴ? ዶንቅ ባይስንም ዶንቅ ሳአ ኤድንከስ እችንካ ስጣንደትም ዶከንም መም ጋባስርካ ጮጭ የ አምሳናንከረ የም ገቀርሳዮ?<note caller="-" style="x"><char style="xo" closed="false">16፡9 </char><char style="xt" closed="false"><ref loc="MAT 15:34-38">ማቶ. 15፡34-38</ref>። </char></note> <verse eid="MAT 16:9"/><verse number="10" style="v" sid="MAT 16:10"/>ኮትኮግንደረ ታብዛ ባይስን ኦይድ ሳአ ኤድንከስካንታ ማቻንደትምኬ ስጣን ዶከንም መም ጋባስርካ ጮጭ የ አምሳንደትም የታ ገቀርዳከቴ?<note caller="-" style="x"><char style="xo" closed="false">16፡10 </char><char style="xt" closed="false"><ref loc="MAT 15:34-38">ማቶ. 15፡34-38</ref>። </char></note> <verse eid="MAT 16:10"/><verse number="11" style="v" sid="MAT 16:11"/>ይና ፈረሳውያንንከዘንኬ ሰዱቃውያንንከስታ እርሰንዘንካ ካርስምከቴ!’ ጋይስቶ እ የም ኬዛንዳ ባይስንጎካ ማታክንደትም Ꮊስግንደረ የ ገቀርዳክንዳ?”<verse eid="MAT 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12"/>ክታካርንካ ጎርስምድባብከሰረ የሱስ ካርስምከቴ ከትም ክት ጋይሳንደረ ፈርሳውያንንከዘንኬ ሰዱቃውያንንከስታ ዳቅል ኤስስን ዳት ማጠንም ኡስዝድን እርሰንዘንካ ማታክንደትም ገቀርሰኬ።<verse eid="MAT 16:12"/></para>
  <para style="s1">የሱስ ክርስቶስ ማትንተን ጴጥሮስታ ኬዘና</para>
  <para style="r">(<ref loc="MRK 8:27-29">ማር. 8፡27-29</ref>፤ <ref loc="LUK 9:18-20">ሉቃ. 9፡18-20</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13"/>የሱስ ፍልጶስ ቀሳርያ ጋይምድን ፍጨናር ይ የልሳንደትካ ይንታካርንካ ጎርስምድባብከስም “ኤድንከስ ኤድ ይንችንም Ꮊየክ ጋይዳ?” ጋየሮ ከትም ኦይሴ።<verse eid="MAT 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14"/>ከተረ “ዋልቃ ዋልቀንከስ ኤና ስእስንባብ ዮሀንሴ፥ አብንከስ ኤላሴ፥ አብንከስ ኤርማሴ አነረ፥ ሳብዘንካ ኤሰርሶ ከዛቅባብከሳርንካ ዋልቀኔ ጋይደኬ” ክደር ጋይሰኬ።<note caller="-" style="x"><char style="xo" closed="false">16፡14 </char><char style="xt" closed="false"><ref loc="MAT 14:1-2">ማቶ. 14፡1-2</ref>፤ <ref loc="MRK 6:14-15">ማር. 6፡14-15</ref>፤ <ref loc="LUK 9:7-8">ሉቃ. 9፡7-8</ref>። </char></note><verse eid="MAT 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15"/>የሱሰረ “የታ ማቼ እም Ꮊየንት ጋይዳ?” ኬትም ጋይሴ።<verse eid="MAT 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16"/>ካርን ኮታዘን ስምኦን ጴጥሮስ፥ “የና ዶቅንት ሳብንታ ይንች ክርስቶሰየ” ጋይሶ ክትካንታ ማስሴ።<note caller="-" style="x"><char style="xo" closed="false">16፡16 </char><char style="xt" closed="false"><ref loc="JHN 6:66-69">ዮሀ. 6፡66-69</ref>። </char></note><verse eid="MAT 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17"/>የሱሰረ፥ “ዮነታ ይንችን ስምኦኖ! የና አንጅምስባበዬ ኮም የስካንታ መያ ማስስባብ ጭላር ዶቅድባብ እስታ ባቤና ዳት ኤድ ካዬ። <verse eid="MAT 16:17"/><verse number="18" style="v" sid="MAT 16:18"/>እተረ የስም ኩን ጋይድቴ፥ የና ጴጥሮሳየ፥ ኮትኮ ላዝንዘን እስታ ምክስ ኤሄንም ዎድቴ፥ ኮትኮ ምክስ ኤሄንም ደእታ ዎልቀና ዎራ ጋማዬ። <verse eid="MAT 16:18"/><verse number="19" style="v" sid="MAT 16:19"/>ጭላ ባንችምን ፎጅድንደትም የስካንታ እምትቴ፥ ፍጨዘን የስ ዞክስባብ ሙደና ጭላረረ ዞከርስባብ ማደ፥ ፍጨዘን የስ ቡልስባብ ሙደና ጭላር ቡልምስባብ ማተረ” ኩን ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">16፡19 </char><char style="xt" closed="false"><ref loc="MAT 18:18">ማቶ. 18፡18</ref>፤ <ref loc="JHN 20:23">ዮሀ. 20፡23</ref>። </char></note> <verse eid="MAT 16:19"/><verse number="20" style="v" sid="MAT 16:20"/>ኮታዘንከረ የሱስ ይንታ ካርንካ ጎርስምድባብከስም ክት ክርስቶስ ማትንተን Ꮊየሰንካንተረ ከት ኬዝዳክንግንዳ ክትሴ።<verse eid="MAT 16:20"/></para>
  <para style="s1">የሱስ ይንታ ደእንተኬ አምንተንጎካ ኬዛንዳ</para>
  <para style="r">(<ref loc="MRK 8:31-33">ማር. 8፡31-33</ref>፤ <ref loc="LUK 9:22-27">ሉቃ. 9፡22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21"/>ኮታዘንከረ የድሶ የሱስ ይንታ ካርንካ ጎርስምድባብከስም፥ “የሩሳሌም ካተመናር አይ ዎም ዝግዝዴ፥ ኮታረረ ጋልተንከዘንካ ቀሰንከስታ ገችንባብከዘንኬ ሙሴታ ህግንም ኤስዝድባብከዘንካ፥ ማጠና እዘን የልዴ፥ ከታ እም ደይስተረኬ፥ ማችንከረ ማክምስ ሰጨንካ አምድቴ” ኩን ጋይ ከደር የጄ።<verse eid="MAT 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22"/>ጴጥሮስ ማቼ የሱሰም አብንከዘንካ Ꮊርሳ ይይሶ፥ “የ ጮይስዮ! ቦድሶ የዘን Ꮊይማታ! ኮና ሪና ቦድሶ የዘን የላዬ!” ኩንጋየሮ Ꮊጋ ክትም የጄ።<verse eid="MAT 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23"/>የሱስ ማቼ ዋልንጋይሶ ጴጥሮሰም፥ “የና ሰጣንኖ! ኦስ እስታ ቡር አይካ! የና ኤተን ዳት ሳብትንደትም የስ ገቀርዳክንካንታ የና እካንታ ጎሄዬ” ክትም ጋይሴ።<verse eid="MAT 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24"/>ኮታ ቡር የሱስ ይንታ ካርንካ ጎርስምድባብከስም፥ “እስታ ካርንካ ጎርስምካንታ ዝግድባብ ይንታ ማተን ካዳ፥ ይንታ ማጠንመረ ደእ የለልታ ባልሶ እም ክት ጎርስማ።<note caller="-" style="x"><char style="xo" closed="false">16፡24 </char><char style="xt" closed="false"><ref loc="MAT 10:38">ማቶ. 10፡38</ref>፤ <ref loc="LUK 14:27">ሉቃ. 14፡27</ref>። </char></note><note caller="+" style="f"><char style="fr" closed="false">16፡24 </char><char style="ft" closed="false">ግርክ አፈካ ማዝቀልን ባልሶ ጋይዴ። </char></note> <verse eid="MAT 16:24"/><verse number="25" style="v" sid="MAT 16:25"/>ይንታ ሰንፔንም አቅስካንታ ዝግድባብ ሙደና ኮትም ካይዝዴ ኬዛርንካ ማቼ ይንታ ሰንፔንም እካንታ ኮትም ካይዝድባብ ማቼ ኮትም Ꮊብዴ።<note caller="-" style="x"><char style="xo" closed="false">16፡25 </char><char style="xt" closed="false"><ref loc="MAT 10:39">ማቶ. 10፡39</ref>፤ <ref loc="LUK 17:33">ሉቃ. 17፡33</ref>፤ <ref loc="JHN 12:25">ዮሀ. 12፡25</ref>። </char></note> <verse eid="MAT 16:25"/><verse number="26" style="v" sid="MAT 16:26"/>ኤድ ፍጫሙደንታ ቆልመን ክት Ꮊፍሴ፥ ይንታ ሰንፔንም ክት ካይሴ፥ Ꮊሮክ ክትም መይዳ? አነረ ኤድ ይንታ ሰንፔንካንታ ቆትመን Ꮊርክ ናግዳ? <verse eid="MAT 16:26"/><verse number="27" style="v" sid="MAT 16:27"/>ኤድ ይንች ይንታ ባቤንታ ቦንቸንካ ማትሶ ይንታ ክታይንችንካ ክክን Ꮊዴ፥ ኮታይከረ ዋልቃ ዋልቃባብከስካንታ ክታ ፍክስንከካ ክትካንታ እምምተሬ።<note caller="-" style="x"><char style="xo" closed="false">16፡27 </char><char style="xt" closed="false"><ref loc="MAT 25:31">ማቶ. 25፡31</ref>፤ <ref loc="PSA 62:12">የቺ 62፡12</ref>፤ <ref loc="ROM 2:6">ሮማ 2፡6</ref>። </char></note> <verse eid="MAT 16:27"/><verse number="28" style="v" sid="MAT 16:28"/>ዶፈንካ እታ የም ጋይድቴ፥ ኤድ ይንች ይንታ ባንችምንታ ቦንቼንካ ማትሶ ክት Ꮊድንካ ኬታ ይ ሰተርን የለልታ ኮታር ዎእስባብከስታ ዎክያርንካ ደእዳክባብ ኤድንከስ ዶቅደኬ” ኩን ከትካንታ ጋይሴ።<verse eid="MAT 16:28"/></para>
  <chapter eid="MAT 16"/>
  <chapter number="17" style="c" sid="MAT 17"/>
  <para style="s1">የሱሰታ ማልክንታ ኦክምና</para>
  <para style="r">(<ref loc="LUK 9:2-13">ሉቃ. 9፡2-13</ref>፤ <ref loc="MRK 9:28-36">ማር. 9፡28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1"/>ላ ሰጨታ ቡር የሱስ ጴጥሮስም፥ ያይቆበምኬ እስመን ዮሀንስምካ Ꮊክ ጎርስሶ ዋልቃ ጬክን ጋይሳን ገቼንዘን ዉተዴ።<note caller="-" style="x"><char style="xo" closed="false">17፡1 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2 ጴጥ. 1፡17-18</ref>። </char></note><verse eid="MAT 17:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 17:2"/>ኮታዘን ከትዶቅድንካ ኬታ እሪ ኦክምሴ፥ ክታ ባለነረ Ꮊይግንዳ ሳክሴ፥ ክታ አፍለነረ ጫምሳ ሳክመንግንዳ ማትሶ ሮጵሴ። <verse eid="MAT 17:2"/><verse number="3" style="v" sid="MAT 17:3"/>ኮታዘንከረ ሙሴከ ኤላሰካ የሱሰካ ክክን ከዝምድንካ ከትካንታ ሰድምሴ።<verse eid="MAT 17:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4"/>ኮታይካ ጴጥሮስ የሱሰም “የ ጮይስዮ! ካሪ ዎ ዶቅሳናና ዎካንታ ኡርሜ፥ ኮካንታ የስ ዝግዴ ዋልቀንም የስካንታ፥ ዋልቀንም ሙሴካንታ ዋልቀንም ኤላስካንታ ማድን ማከን ዳልቼንከስም ኡርስትቴ” ጋይሴ።<verse eid="MAT 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5"/>ጴጥሮስ አክ ኮም ኬዘዘን ክት ዶቅድንካ ሳግድን ኡፓ ከትም ስፍሰ፥ ኡፔታ ዋረረ “ክትካ እም ጉርምዝድባብ እ ሶልምድን እስታ ይንችና ኮኔ፥ ክትም ኤሰርከቴ!” ኩን ጋይድን ኡፍስ ኤስምሴ።<note caller="-" style="x"><char style="xo" closed="false">17፡5 </char><char style="xt" closed="false"><ref loc="NUM 22:2">ፋይ. 22፡2</ref>፤ <ref loc="DEU 18:15">ካሪ. 18፡15</ref>፤ <ref loc="PSA 2:7">የቺ 2፡7</ref>፤ <ref loc="ISA 42:1">ኢሳ. 42፡1</ref>፤ <ref loc="MAT 3:17">ማቶ. 3፡17</ref>፤ <ref loc="MAT 12:8">12፡8</ref>፤ <ref loc="MRK 1:11">ማር. 1፡11</ref>፤ <ref loc="LUK 3:22">ሉቃ. 3፡22</ref>። </char></note><verse eid="MAT 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6"/>ክታ ካርንካ ጎርስምድባብከሰረ ኮም ኡፍስን ከታ ይ ኤሰርስንደትኬ አንድር ገቅሰኮ ከታ ይንታ ባለንካ ፍጨዘን ጉፕን ጋይሰኬ።<verse eid="MAT 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 17:7"/>የሱስ ማቼ ከደር Ꮊድሶ ይንታ አንንካ ከትም Ꮊጭሶ “አምከቴ፥ Ꮊይጳሰቴ!” ከትም ጋይሴ። <verse eid="MAT 17:7"/><verse number="8" style="v" sid="MAT 17:8"/>ከተረ ጬክን ጋይሰኮ ከት ሰድንካ የሱሰዘንካ አብ Ꮊይመነረ ሰዳከኬ።<verse eid="MAT 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9"/>ገቼንዘንካ ከት Ꮊንቼርድንካ የሱስ “ኤደት ይንች ደእያርንካ አምተርን የለልታ ኮም የ ሰዳንደትም Ꮊየንካንተረ Ꮊይከዘቴ” ጋየሮ ይንታ ካርንካ ጎርስምድባብከስም ክትሴ።<verse eid="MAT 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10"/>ክታ ካርንካ ጎርስምድባብከሰረ፥ “ይና፥ ሙሴታ ህግንም ኤስዝድባብከስ እርምሶ Ꮊድ ዝግዝድባብ ኤላሴ Ꮊረተክ ጋይዳ?” ጋየረኮ የሱሰም ኦይሰኬ።<note caller="-" style="x"><char style="xo" closed="false">17፡10 </char><char style="xt" closed="false"><ref loc="MAL 4:5">ሚል. 4፡5</ref>። </char></note><verse eid="MAT 17:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11"/>የሱሰረ፥ “ኮና ገቴ ኤላሰረ እርምሶ Ꮊዴ፥ ኖ ሙደንም ኡርዝዴ። <verse eid="MAT 17:11"/><verse number="12" style="v" sid="MAT 17:12"/>ኬዛርንካ ማቼ ኤላስ ኤና እር Ꮊቴ እታ የም ጋይድቴ፥ ኤድንከስ ማቼ ክትም ኤሳከኬ፥ ኮካንታ ከታ ይ ዝግዛንደትም ሙዳ ክታዘን ይሰኬ። ኮትኮግንደረ ጉጅሶ ኤደት ይንች ከታ አንያር ማጠንም ተይክትም ዝግዝዴ”። ኩንጋየሮ ከትካንታ ማስሴ።<note caller="-" style="x"><char style="xo" closed="false">17፡12 </char><char style="xt" closed="false"><ref loc="MAT 11:14">ማቶ. 11፡14</ref>። </char></note> <verse eid="MAT 17:12"/><verse number="13" style="v" sid="MAT 17:13"/>ኮታይካ ክታ ካርንካ ጎርስምድባብከስ የሱስ ኬዛንዳ ስእስንባብ ዮሀንስጎካ ማትንተን ኤሰኬ።<verse eid="MAT 17:13"/></para>
  <para style="s1">የሱስ ግምዘካ የደርስባብ ይንችንም ፋችና</para>
  <para style="r">(<ref loc="MRK 9:14-29">ማር. 9፡14-29</ref>፤ <ref loc="LUK 9:37-43">ሉቃ. 9፡37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14"/>የሱሰከ ክታ ካርንካ ጎርስምድባብ ማከንንከስካ ክክን ዎርሰንደር ከት ማቻንደትካ፥ ዋልቃ ኤች የሱሰደር Ꮊድሶ ክታ እሪ ጉንፈርሶ፥ <verse eid="MAT 17:14"/><verse number="15" style="v" sid="MAT 17:15"/>“ጮይስዮ! ዋደ እስታ ይንችንካንታ አተርካ ባልት ክትም ኦይተሮ ግምዛ ሰቅምና አንድር ክትም ማእዝዴ፥ ኖሄታ ዋርከ ሎቀታ ዋረረ በድᎺይካ ዋጅዴ። <verse eid="MAT 17:15"/><verse number="16" style="v" sid="MAT 17:16"/>የስታ ካርንካ ጎርስምድባብከዝደረረ ክትም ተይᎺትት ዶቆ፥ ኬዛርንካ ማቼ ክትም ፋችካንታ ማታከኬ” ኩን ጋይሴ። <verse eid="MAT 17:16"/><verse number="17" style="v" sid="MAT 17:17"/>የሱሰረ፥ “የታ አመንምዳክን ዎብ አጥርና! Ꮊንታ የለልትስ የንካ ክክን እታ ዶቅዳ? Ꮊንታ የለልትስ የም እታ ዳንዳእዳ? ይና ይንችንም እዝደር ተይ Ꮊድከቴ!” ከትም ጋይሴ። <verse eid="MAT 17:17"/><verse number="18" style="v" sid="MAT 17:18"/>ኮታዘንከረ የሱስ ግምዘንም ዋጬ፥ ግምዘነረ ይንችንዘንካ ዉተዴ፥ ይንችነረ ሳዓትን ኮታዘነ ፋጬ።<verse eid="MAT 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19"/>ኮታ ቡር ክታ ካርንካ ጎርስምድባብከስ ከታ ይንት የሱሰደር Ꮊድሰኮ፥ “ዎታ ግምዘንም ዉችካንታ ዎ ማታክንዳ Ꮊረተረ?” ጋይሰኮ ክትም ኦይሰኬ።<verse eid="MAT 17:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20"/>የሱሰረ፥ “የንታ አሜንንታ ቶክንታጎኬ፥ ዶፈንካ የም ጋይድቴ፥ ሰናፍጭ ጋየርድንደታ አፍከከንዳ አሜን የንታ ዶቅሳን ማቼ ኮ ገቼንም፥ ‘ኮዘንካ አምሳዮ ኦስ አይካ!’ የ ጋይሴ አይዴ፥ የም ጋምድንዳ Ꮊረርየረ ዶቃዬ።<note caller="-" style="x"><char style="xo" closed="false">17፡20 </char><char style="xt" closed="false"><ref loc="MAT 21:21">ማቶ. 21፡21</ref>፤ <ref loc="MRK 11:13">ማር. 11፡13</ref>፤ <ref loc="1CO 13:2">1 ቆሮ. 13፡2</ref>። </char></note> <verse eid="MAT 17:20"/><verse number="21" style="v" sid="MAT 17:21"/>(ኮግንዳ ግምዘና ማቼ በቼካ Ꮊቅሶ ምክሳክንዳ ማቼ ቦድሶ ዉዳክዬ” ኩን ከደር ጋይሴ)።<note caller="+" style="f"><char style="fr" closed="false">17፡21 </char><char style="ft" closed="false">አብ ንከሳር ኮና ፋይደና ካዬ። </char></note><verse eid="MAT 17:21"/></para>
  <para style="s1">የሱስ ይንታ ደእንጎኬ ደእናርንካ አምንተንጎካ ቃስትምስ ኬዛንዳ</para>
  <para style="r">(<ref loc="MRK 9:30-32">ማር. 9፡30-32</ref>፤ <ref loc="LUK 9:43-45">ሉቃ. 9፡43-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22"/>ክታ ካርንካ ጎርስምድባብከስ ገሊላር ሳንምሰኮ ከትዶቅድንካ የሱስ ከትም ኩን ጋይሴ “ኤድ ይንችንም ስክስት ኤድንከስካንታ ክትም እምተረኬ፤ <verse eid="MAT 17:22"/><verse number="23" style="v" sid="MAT 17:23"/>ከተረ ክትም ደይስተረኬ፥ ኖየረ ማክምስ ሰጨንካ አምተሬ” ክታ ካርንካ ጎርስምድባብከሰረ አንድር ሞርእሰኬ።<verse eid="MAT 17:23"/></para>
  <para style="s1">ሳብታ ጭል ኤሄንጎካ ግራ ናክና</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24"/>የሱሰኬ ክታ ካርንካ ጎርስምድባብከስ ቅፍርናሆም ካተመናር ከት የልሳንደትካ ሳብታ ጭል ኤሄንታ ግረን ተይድባብከስ ጴጥሮሰደር Ꮊድሶ፥ “የንታ ኤስስንባብ ሳብታ ጭል ኤሄንታ ግረንም ናግዳክዮ?” ጋይሶ ክትም ኦይሰኬ።<note caller="-" style="x"><char style="xo" closed="false">17፡24 </char><char style="xt" closed="false"><ref loc="EXO 30:13">ዉት. 30፡13</ref>፤ <ref loc="EXO 38:26">38፡26</ref>። </char></note><verse eid="MAT 17:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25"/>ጴጥሮሰረ፥ “ይዬ ኖ ናግዴ” ከደር ጋይሴ። ጴጥሮስ ኤሄናር ክት አርደዳንደትካ የሱስ እርምሶ “ስምኦን ጴጥሮሶ! Ꮊሮክ የዝደር ካምዳ? ፍጨዘን ባንችንከስ ቃረጭንከ ግረን ከት ተይድንዳ Ꮊይዘንከረ? ከታ ፍጫ ኤድንከዘንኮ አነረ ፍጫ ኤድ ማታክባብከዘንኮ?” ኩንጋይሶ ክትም ኦይሴ።<verse eid="MAT 17:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26"/>ጴጥሮሰረ “ፍጫ ኤድ ማታክባብከዘንኬ” ጋይሳንደትካ የሱሰረ፥ “ኩን ማቼ ከታ ፍጫ ኤድንከስ ግረንም ናካየክ ጋይንትዬ። <verse eid="MAT 17:26"/><verse number="27" style="v" sid="MAT 17:27"/>ኬዛርንካ ማቼ ከትካንታ ጎሀ ማተራክንግንዳ ባሀርናር አይሳዮ ሞለን የድን ማንጠቆን ኦይትካ፥ እርናና ዉድንደት ሞለንታ፥ አፈናርንካ ብራ Ꮊፍተራዬ፥ ኮት ብረንም ተይሳዮ እስተንምኬ የስተንም ናካ” ኩን ጋይሴ።<verse eid="MAT 17:27"/></para>
  <chapter eid="MAT 17"/>
  <chapter number="18" style="c" sid="MAT 18"/>
  <para style="s1">ጭላ ባንችማር ሙደንዘንካ ስግና Ꮊይራ</para>
  <para style="r">(<ref loc="MRK 9:33-37">ማር. 9፡33-37</ref>፤ <ref loc="LUK 9:46-48">ሉቃ. 9፡46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1"/>ኮታይካ ክታ ካርንካ ጎርስምድባብከስ የሱሰደር Ꮊድሰኮ “ጭላ ባንቺማር ሙደንዘንካ ስገድባብ Ꮊይራ?” ጋይሰኮ ክትም ኦይሰኬ።<note caller="-" style="x"><char style="xo" closed="false">18፡1 </char><char style="xt" closed="false"><ref loc="LUK 22:24">ሉቃ. 22፡24</ref>። </char></note> <verse eid="MAT 18:1"/><verse number="2" style="v" sid="MAT 18:2"/>የሱሰረ ዋልቃ ይንች ኤልሶ ከታ ዎክያር ዎይስሶ፥ <verse eid="MAT 18:2"/><verse number="3" style="v" sid="MAT 18:3"/>ኩነረ ጋይሴ “ዶፈን የም ጋይድቴ የ ኦክማክንዳ ማቸኬ ይንችንከስግንዳ የ ማታክንዳ ማቼ ቦድሶ ጭላ ባንችምናር አርዳከቴ።<note caller="-" style="x"><char style="xo" closed="false">18፡3 </char><char style="xt" closed="false"><ref loc="MRK 10:15">ማር. 10፡15</ref>፤ <ref loc="LUK 18:17">ሉቃ. 18፡17</ref>። </char></note> <verse eid="MAT 18:3"/><verse number="4" style="v" sid="MAT 18:4"/>ይና ኮ ይንችንግንዳ ይንታ ማተንም ይርክሳ ይድባብ ጭላ ባንችምናር ሙደንዘንካ ስግ ማተረ።<verse eid="MAT 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 18:5"/>“ኮግንዳ ዋልቃ ይንች እስታ ላምንካ ሞግድባብ እም ሞግዴ።<verse eid="MAT 18:5"/></para>
  <para style="s1">ኤድም ኮተርስዘንካ ካርስም</para>
  <para style="r">(<ref loc="MRK 9:42-48">ማር. 9፡42-48</ref>፤ <ref loc="LUK 17:1-2">ሉቃ. 17፡1-2</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6"/>“Ꮊየነረ ኤድ እንካ አሜንድባብ ከትኬ መረንከሳርንካ ዋልቀንም ጎማር አርጅድንዘንካ ደጭማ ደይስን ሰይንንም ይንታ ባርናር ዞክሶ ባሀርንታ ጨርናር ኦይትምሶ ኤቅዝምሰስ ናና ክትካንታ ኡርዴ”. <verse eid="MAT 18:6"/><verse number="7" style="v" sid="MAT 18:7"/>ኮታዘነከረ የሱስ፥ “ኤድንከስ ጎማር አርድንግንዳ ከት ይድን ሪንከስጎካ ፍጫ ሙደን የኤ! Ꮊንተረ ማታ ኤድም ኮተርዝድን ርንከሰታ Ꮊድንተና ነጋዬ፥ ኬዛርንካ ማቼ ኮተርዝድንደትም ተይᎺድባብ ኤችን ክትካንታ የኤ! <verse eid="MAT 18:7"/><verse number="8" style="v" sid="MAT 18:8"/>የስታ አነረ ማታ የስታ ዱትነረ ጎማ የስ ፍግዝድንግንዳ የስም ኮተርዝደ ተችትዮ የዘንካ Ꮊልእስካ! ቃስቴን አን ናንከረ ቃስቴን ዱት የስታ ዶቅስንካ ስለንካ ድግዳክን ኖሄናር የስ ኦይትምተርንዘንካ፥ ዱንግላ አነረ ዎከል ዎከልን ጋይድባብ ማትሳዮ ስለንክንደታ ዶቅንተናር የስ አርደዳናና ኡርዴ።<note caller="-" style="x"><char style="xo" closed="false">18፡8 </char><char style="xt" closed="false"><ref loc="MAT 5:30">ማቶ. 5፡30</ref>። </char></note> <verse eid="MAT 18:8"/><verse number="9" style="v" sid="MAT 18:9"/>የስታ አፍነረ ጎማ የስ ፍግዝድንግንዳ የስም ጎማር አርጅደ ዉችተዮ ዛእካ! ቃስቴን አፍ የስታ ዶቅስንካ ድግዳክን ኖሄናር የስ ኦይትምተርንደትዘንካ ዋልቃ አፍ የስታ ዶቅስንካ ስለንክንደታ ዶቅንተናር የስ አርደዳናና ኡርዴ።<note caller="-" style="x"><char style="xo" closed="false">18፡9 </char><char style="xt" closed="false"><ref loc="MAT 5:29">ማቶ. 5፡29</ref>። </char></note> <verse eid="MAT 18:9"/><verse number="10" style="v" sid="MAT 18:10"/>ጭላር ዶቅድባብ ከታ ክታይንችንከስ ሙዳᎺይካ ጭላር ዶቅድባብ እስታ ባቤንታ ባለንም ከት ሰድንካንታ ከትከ መረንከሳርንካ ዋልቀንመረ ዎራ የ ቶጅዳክንግንዳ ካርስምከቴ። [ <verse eid="MAT 18:10"/><verse number="11" style="v" sid="MAT 18:11"/>ኤደት ይንቼረ Ꮊዳንዳ ካይድባብም አቅስካንቴ”። ኩን ጋይሴ።]<note caller="+" style="f"><char style="fr" closed="false">18፡11 </char><char style="ft" closed="false">ኤና እር በድ ንከሳር 11 ፋይደንም ጉጃዬ። </char></note><note caller="-" style="x"><char style="xo" closed="false">18፡11 </char><char style="xt" closed="false"><ref loc="LUK 19:10">ሉቃ. 19፡10</ref>። </char></note><verse eid="MAT 18:11"/></para>
  <para style="s1">ካይሶ Ꮊፈርሳን ቆለንንታ ካምስ</para>
  <para style="r">(<ref loc="LUK 15:3-7">ሉቃ. 15፡3-7</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12"/>ኮታዘንከረ የሱስ፥ “ይና የንደር Ꮊረሞክ ካምዳ? ዋልቃ ኤችንታ ጨታ ቆል ክታ ዶቅድንዳ ማቸኬ ከታርንካ ዋልቀና ክታዘንካ ካይዴ ኦይድ ቦንደከ ታመኬ ሳክለን ገቼዘን ዛቅሶ ካይዳንደትም ዋልቀን ዝግመትካንታ አይዳክዮ? <verse eid="MAT 18:12"/><verse number="13" style="v" sid="MAT 18:13"/>ዶፈን የም ጋይድቴ፥ ይ Ꮊፍሳንደትከረ ካያክን ኦይድ ቦንደኬ ታመኬ ሳክለንዘንካ ስግ ካይሶ Ꮊፈርሳን ቆለንንጎካ ጉርምዴ”። <verse eid="MAT 18:13"/><verse number="14" style="v" sid="MAT 18:14"/>ኮትኮግንደረ ጭላር ዶቅድባብ የንታ ባቤና ከትኬ መረንከሳርንካ ዋልቀነረ ካይድንግንዳ ዝጋዬ።<verse eid="MAT 18:14"/></para>
  <para style="s1">ይንታ እስመንም Ꮊጋጎካ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15"/>“የስታ እስመና የስም ባችሰ የስኬ ክትካ Ꮊክ ማትሰቶ ክታ ባችንም ክትካንታ ከዝካ፥ የስም ክት ኤሰርሴ የስታ እስመና ክትም ማስካ፥<note caller="-" style="x"><char style="xo" closed="false">18፡15 </char><char style="xt" closed="false"><ref loc="LUK 17:3">ሉቃ. 17፡3</ref>። </char></note> <verse eid="MAT 18:15"/><verse number="16" style="v" sid="MAT 18:16"/>የዝደር ክት ኤሰራክንዳ ማቼ ቃስተን አነረ ማከን ኤታ ማርከርና ዳቅድንካንታ ቃስተን አነረ ማከን ኤድም የድሶ ክደር አይካ።<note caller="-" style="x"><char style="xo" closed="false">18፡16 </char><char style="xt" closed="false"><ref loc="DEU 19:15">ካሪ. 19፡15</ref>። </char></note> <verse eid="MAT 18:16"/><verse number="17" style="v" sid="MAT 18:17"/>ከትመረ ክት ኤሰርዳክቴ ጋይሴ ምክስ ኤሄናር ኤድንከስካንታ ኬዝካ፥ ምክስ ኤሄናር ኤድንከስካንታ ክት ኤሰርዳክንዳ ማቼ ደራግንደኬ ቶችምሳን ኤድግንዳ ማስሶ ፋይድካ”።<verse eid="MAT 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18"/>“ዶፈንካ የም ጋይድቴ፥ ፍጨዘን የ ዞግድባብ ሙዳ ጭላር ዞከርስባብ ማቴረ፥ ፍጨዘን የ ማታ ጋይሳንዳ ሙዳ ጭለዘነረ ማተረ።<note caller="-" style="x"><char style="xo" closed="false">18፡18 </char><char style="xt" closed="false"><ref loc="MAT 16:19">ማቶ. 16፡19</ref>፤ <ref loc="JHN 20:23">ዮሀ. 20፡23</ref>። </char></note> <verse eid="MAT 18:18"/><verse number="19" style="v" sid="MAT 18:19"/>ጉጅሰረ የም ጋይድቴ፥ የንታርንካ ቃስተና ፍጨዘን Ꮊምን ሪመረ ምክስካንታ ኤእሰኮ ከት ኦይሰኬ ከት ምክሴ፥ ጭላር ዶቅድባብ እስታ ባበና ከትካንታ ቦተረ። <verse eid="MAT 18:19"/><verse number="20" style="v" sid="MAT 18:20"/>ቃስተን ናከረ አና ማከን ማትሶ እስታ ላምንካ ከት ሳንምድንደታር እታ ከታ ዎክያር Ꮊፈርትቴ”። ኩን ጋይሴ።<verse eid="MAT 18:20"/></para>
  <para style="s1">ነጋ ጋይንታጎካ</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21"/>ኮታይካ ጴጥሮስ የሱሰደር Ꮊድሶ፥ “የ ጮይስዮ! እስታ እስመና እም ክት ባችሰ መም ዱትስ ክትም ነጋ ጋይቴ? ታብዛ ዱቶ?” ጋየሮ ክትም ኦይሴ።<note caller="-" style="x"><char style="xo" closed="false">18፡21 </char><char style="xt" closed="false"><ref loc="LUK 17:3-4">ሉቃ. 17፡3-4</ref>። </char></note><verse eid="MAT 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22"/>የሱሰረ፥ “ማከን ቦንደኬ ታሜከ ታብዛ ዱት ዳት ታብዛ ዱት Ꮊክ የስም ጋያይቴ” ኩን ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">18፡22 </char><char style="xt" closed="false"><ref loc="NUM 4:24">ፋይ. 4፡24</ref>። </char></note><verse eid="MAT 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23"/>“ኮካንታ ጭላ ባንችምና ይንታ ፍክስንባብከስታ አንያር ዶቅድን ብረንም ሰድንካንታ ዝግድባብ ባንችንም ካምዴ፥ <verse eid="MAT 18:23"/><verse number="24" style="v" sid="MAT 18:24"/>ባንችና ከታ ፍክስንም ሰድን የጃንደትካ በድ ሳአ ብራ ፋይድምድን ባዛ ዶቅድባብ ዋልቃ ፍክስንባብ የድምሶ Ꮊዴ። <verse eid="MAT 18:24"/><verse number="25" style="v" sid="MAT 18:25"/>ኖኮና ፍክስንባብና ባዘን ናክካንታ ክት ማታክንኦል ኖየረ ክታ ኬነነረ፥ ክታ ይንችነረ፥ ክታ ዶቅድንደትም ሪንም ሙዳ ሰንሶ ባዘንም ናግድንግንዳ ክታ ማታቆልስባብ ክትሴ። <verse eid="MAT 18:25"/><verse number="26" style="v" sid="MAT 18:26"/>ኖኮና ፍክስንባብና ማቼ ይንታ ማተን ቆልስባብታ ዱትንዘን ጉንፈርሶ ‘የ ዎባቦ! ዋደ መራ ሰጫ እካንታ እምካ፥ ሙደንመረ የስካንታ ናክትቴ!’ ጋይሶ ክትም ምክሴ። <verse eid="MAT 18:26"/><verse number="27" style="v" sid="MAT 18:27"/>ክታ ማተን ቆልስባበረ ክትካንታ አተርስንደትኬ ክትም ኦይቼ፥ ባዘንመረ ክትካንታ ዛቅሴ።<verse eid="MAT 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28"/>“ኬዛርንካ ማቼ ኖኮና ፍክስንባብና ኮታርንካ ዉትሶ ክት አያዶቅድንካ ዋልቃ ጨታ ጣገራ ብራ ክታዘንካ ታልቅት ተይባብ ክትካ ክክን ፍግዝድባብ ላኮይትን Ꮊፍስንደትኬ ባርን ክታ ጉንእት የድሶ፥ ‘እየስካንታ ታልቅሳን ብረንም እስታ ናካ!’ ክትም ጋይሴ። <verse eid="MAT 18:28"/><verse number="29" style="v" sid="MAT 18:29"/>ኮታዘንከረ ክትካ ክክን ፍግዝድባብ ላኮይትነረ ክታ ዱትንዘን ዋችሶ፥ ‘መራ ሰጫ እካንታ እምካ፥ የስካንታ ናክትቴ!’ ጋይሶ ክትም ምክሴ። <verse eid="MAT 18:29"/><verse number="30" style="v" sid="MAT 18:30"/>ኖ ማቼ ዋይዬ ጋይሴ። ኮታዘንከረ ክትም የት አይሶ ባዘንም ናክተረን የለልታ ክትም ዞክሴ። <verse eid="MAT 18:30"/><verse number="31" style="v" sid="MAT 18:31"/>ክትካ ክክን ፍግዝድባብ አብ ላኮይትንከስ ኮት ኮም ከታ ይ ሰዳንደትካ አንድር ሞርእሰኮ፥ ማታቆልስባብደር Ꮊድሰኮ ይምሳንደትም ሙዳ ኬዘኬ። <verse eid="MAT 18:31"/><verse number="32" style="v" sid="MAT 18:32"/>ክታ ማተን ቆልስባበረ ክትኮ ፍክስንባብም ኤልስሶ፥ ‘የና ዳቅል ፍክስንባብ! የስ እም ምክሳንካንታ የዘን ዶቅድንደትም ባዘንም ሙዳ የስካንታ ዛቅስቴ፥ <verse eid="MAT 18:32"/><verse number="33" style="v" sid="MAT 18:33"/>ይና፥ እታ የዘን ባዘን እ ዛቅሳንግንዳ፥ የነረ የስታ ላኮይት ማችባብ ፍክስንባብዘን ባዘንም ክትካንታ ዛቅ የስም ዝክሳዮ?’ ኩን ጋይሴ። <verse eid="MAT 18:33"/><verse number="34" style="v" sid="MAT 18:34"/>ኮካንታ ክታ ማታቆልስባበረ ዋጭሶ ባዘንም ሙዳ ክት ናክተርን የለልታ ክትም ዞክና ኤሄንም ክድባብከስካንታ ስክስት እምሴ።<verse eid="MAT 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35"/>“ይና የተረ ዋልቃ ዋልቀንከስ የንታ እስመንም የንታ ቡዳርንካ ነጋ የ ጋይዳክንዳ ማቼ ጭላር ዶቅድባብ እስታ ባቤነረ ኮትኮግንዳ የንዘን ይተሬ።”<verse eid="MAT 18:35"/></para>
  <chapter eid="MAT 18"/>
  <chapter number="19" style="c" sid="MAT 19"/>
  <para style="s1">ቡልም ዝግዝዳክንደትም እምምሳን ኤስስና</para>
  <para style="r">(<ref loc="MRK 10:1-12">ማር. 10፡1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1"/>የሱስ ኮም ኬዝሶ ይ በይሳንደታ ቡር ገሊላ ፍጨናርንካ አምሶ፥ ዮርዳኖስ ሎቀንታ ፋማ ዶቅድን ይሁዳ ፍጨናር አይሴ። <verse eid="MAT 19:1"/><verse number="2" style="v" sid="MAT 19:2"/>በድ ዎርሰንከሰረ ክትም ጎርስምሴ ከታርንከረ ሰቀርስባብከስም ኮታር ፋችሴ።<verse eid="MAT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3"/>ኮታይካ ፈረሳውያንንከስ ክደር Ꮊድሰኮ ጰጫካንታ ክትም ዝግሶ፥ “ኤድ ይንታ ኬነንም Ꮊምንጎግከረ ቡልድንግንዳ ክትካንታ ጋይምቶ?” ጋየረኮ ክትም ኦይሰኬ።<verse eid="MAT 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4"/>የሱሰረ፥ “ሳብ እር አⷝነኬ ማነካ ማስሶ ከትም ፍዛንደትም ናበባከቴ?<note caller="-" style="x"><char style="xo" closed="false">19፡4 </char><char style="xt" closed="false"><ref loc="GEN 1:27">ፍዝ. 1፡27</ref>፤ <ref loc="GEN 5:2">5፡2</ref>። </char></note> <verse eid="MAT 19:4"/><verse number="5" style="v" sid="MAT 19:5"/>ጉጅሰረ ‘ኮጎካ ኤድ ይንታ ባበንምኬ እንደንም ዛቅሶ ይንታ ኬነንካ ክክን ማዴ፥ ከታ ቃስተነረ ዋልቃ ዋሀ ማደኬ’<note caller="-" style="x"><char style="xo" closed="false">19፡5 </char><char style="xt" closed="false"><ref loc="GEN 24">ፍዝ. 24</ref>። </char></note> <verse eid="MAT 19:5"/><verse number="6" style="v" sid="MAT 19:6"/>ኮካንታ ከታ ይና ኮዘንካ ኦስ ዋልቃ ዋሄክ ዳት ቃስተን ማታየኬ። ይና ሳብ ዋልቃ ከትም ማስሳን ኤድ Ꮊይ ፋሳ” ኩንጋየሮ ከትካንታ ማስሴ።<verse eid="MAT 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7"/>ፈረሳዊያንንከሰረ “ይና ሙሴ ‘ክእስና ይንታ ከነንካንታ ኮታ ቡልምንታ ማርካ ማድን ዋርቀት እምሶ ብልድንግንዳ’ Ꮊረትክ ክትሳሬ?” ክደር ጋይሰኬ።<note caller="-" style="x"><char style="xo" closed="false">19፡7 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">ካሪ. 24፡1-4</ref>፤ <ref loc="MAT 5:31">ማቶ. 5፡31</ref>። </char></note><verse eid="MAT 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8"/>የሱሰረ፥ “ሙሴ ማቼ የንታ ከንከስም የ ቡልድንግንዳ ክት የካንታ ጋይሳንዳ የንታ ቡደና ዳቅሶ ዘርዝድባብከስ የማቻንጎኬ” ኤና እሪ ማቼ ኩን ካዬ። <verse eid="MAT 19:8"/><verse number="9" style="v" sid="MAT 19:9"/>“እታ ማቼ፥ ‘ዋልቃ ኤድ ቤልምንጎካ ማታክንዳ ማቼ ይንታ ኬነንም ቡልሶ አብ ማነም ክት እንቼ ኖ ቤልምቴ’ እታ የም ጋይድቴ ኩን ከትም ጋይሴ”።<note caller="-" style="x"><char style="xo" closed="false">19፡9 </char><char style="xt" closed="false"><ref loc="MAT 5:32">ማቶ. 5፡32</ref>፤ <ref loc="1CO 7:10-11">1 ቆሮ. 7፡10-11</ref>። </char></note><verse eid="MAT 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10"/>ክታ ካርንካ ጎርስምድባብከሰረ፥ “ክእስተኬ ኬነንተካ ዎገና ኩን ኮት ማቼ እንችክሳ ነግና ኡርዴ” ክደር ጋይሰኬ።<verse eid="MAT 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11"/>የሱስ ማቼ፥ “ኮና ሪና ማድንዳ ሳብዘንካ እምምስባብከስካንታ ዳት ሙደንካንታ ማታዬ። <verse eid="MAT 19:11"/><verse number="12" style="v" sid="MAT 19:12"/>ይንታ እንደንታ ዋርንካ ስላ ማትሶ አጥምስባብከስ ዶቅደኬ፥ ኤድ ከታ ጉስባብከሰረ ዶቅደኬ፥ ጭላ ባንችምንካንታ ጋይሰኮ ከታ ይንታ ማታካንታ እንጅዳክባብከስኬ ይእዳክባብከሰረ ዶቅደኬ፥ ኮካንታ ኮም ማትካንታ ዝግድባብ ማታ” ኩን ከትም ጋይሴ።<verse eid="MAT 19:12"/></para>
  <para style="s1">የሱስ ይንችንከስም አንጅና</para>
  <para style="r">(<ref loc="MRK 10:13-16">ማር. 10፡13-16</ref>፤ <ref loc="LUK 18:15-17">ሉቃ. 18፡15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13"/>ኮታይካ ይንታ አንን ዎድሶ ከትካንታ ምግዝድንግንዳ ኤድንከስ ይንችንከስም የሱሰደር ተይ Ꮊደኬ፥ ክታ ካርንካ ጎርስምድባብከስ ማቼ ኤድንከስም ዋጨኬ። <verse eid="MAT 19:13"/><verse number="14" style="v" sid="MAT 19:14"/>የሱሰረ፥ “ጭላ ባንችምና ከትከናከስግንደንታ ማቻንካንታ ይንችንከስም ዛእከቴ፥ እዝደር ከት Ꮊዳ፥ Ꮊይ ከትም ማረቴ” ጋይሴ። <verse eid="MAT 19:14"/><verse number="15" style="v" sid="MAT 19:15"/>ይንታ አንንመረ ከታዘን ይ ዎጃንደታ ቡር ካርንኮታርንካ ዉትሶ አይሴ።<verse eid="MAT 19:15"/></para>
  <para style="s1">ቆልመንክንባብ ሰከንንታ ኦይስና</para>
  <para style="r">(<ref loc="MRK 10:17-31">ማር. 10፡17-31</ref>፤ <ref loc="LUK 18:18-30">ሉቃ. 18፡18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16"/>ዋልቃሰጭ ዋልቃ ኤች የሱሰደር Ꮊድሶ፥ “ኤስስንባቦ! ስለንክንደት ዶቅንትን Ꮊፍካንታ Ꮊራ ኡርማ ሪ ፍክስ እም ዝግዝዳ?” ጋይሶ ኦይሴ።<verse eid="MAT 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17"/>የሱሰረ፥ “ኡርማ ሪንጎካ Ꮊረተስ እም ኦይዝዳ? ኡርማ ማችባብ ኖ ዋልቄ፥ ስለንካ ዶቅንትናር አርድካንታ የስ ዝግድንዳ ማቼ ክታ ክተንከስም ቦድካ” ክትም ጋይሴ።<verse eid="MAT 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18"/>ኤችነረ “Ꮊምን ክተንከስም?” ክደር ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">19፡18 </char><char style="xt" closed="false"><ref loc="EXO 20:13-16">ዉት. 20፡13-16</ref>። </char></note></para>
  <para style="p" vid="MAT 19:18">የሱሰረ ኩንጋየሮ ማስሴ “Ꮊይ ደይሴ፥ Ꮊይ በልመ፥ Ꮊይ ድቤ፥ ካርከካ Ꮊይማርከሬ፥ <verse eid="MAT 19:18"/><verse number="19" style="v" sid="MAT 19:19"/>የስታ ባቤንምኬ የስታ እንደንም ቦንችካ፥ የስታ የለንም የስታ ማታግንዳ ማስሶ ሶልምካ፥ ጋይድን ክተንከሰኬ” ክደር ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">19፡19 </char><char style="xt" closed="false"><ref loc="EXO 20:12">ዉት. 20፡12</ref>፤ <ref loc="DEU 5:16">ካሪ. 5፡16</ref>፤ <ref loc="LEV 19">ሌዊ. 19</ref>፤ <ref loc="LEV 18">18</ref>። </char></note><verse eid="MAT 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20"/>ሰከን ኤችነረ “ከትኬና ክተንከስም ቦትቴ፥ አብ እዘንካ ዞገርድንዳ Ꮊረርየረ?” ጋይሴ።<verse eid="MAT 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21"/>የሱሰረ “ቦድማ ማትካንታ የስ ዝግዘ አይሳዮ የስታ ዶቅድን ሪም ሰንሰዮ ብረንም ሪካየንባብከስካንታ እምካ፥ ጭላረረ ቆልመን Ꮊፍተራዬ፥ ኮታዘንከረ Ꮊድሰዮ እም ጎርስምካ” ክትም ጋይሴ።<verse eid="MAT 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22"/>ኖኮና ሰከን ኤችና ማቼ በድ ቆልማ ክታ ዶቅድንካንታ ኮም ይ ኤሰርሳንደትካ ሞርኤሮ አይሴ።<verse eid="MAT 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23"/>ኮታ ቡር የሱስ ይንታካርንካ ጎርስምድባብከስካንታ፥ “ዶፈን የም ጋይድቴ፥ ቆልመክንባብ ኤድ ጭላ ባንችማር አርድና አንድር ማጠ። <verse eid="MAT 19:23"/><verse number="24" style="v" sid="MAT 19:24"/>ጉጅሰረ የም ጋይድቴ፥ ቆልመክንባብ ኤድ ሳብታ ባንችማር አርድንዘንካ ግመል ማርፈታ ጩቅካ አርደስናና ኡርዴ” ኩን ከደር ጋይሴ።<verse eid="MAT 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25"/>ክታ ካርንካ ጎርስምድባብከስረ ኮም ከታ ይ ኤሰርሳንደትካ አንድር በርእሰኮ “ይና Ꮊይ አቅካንታ ማዳ?” ጋይሰኬ።<verse eid="MAT 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26"/>የሱሰረ ከደር ሰድሶ “ኮና ርና ኤድካንታ ማዳክንዴ፥ ሳብካንታ ማቼ ሙደና ክደር ማዴ” ጋይሴ።<verse eid="MAT 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27"/>ኮታይካ ጴጥሮስ “ይና ዎታ ሙደንም ዛቅሶቶ የስም ጎርስምሶቴ፥ ኮናና፥ ዎ Ꮊብድንዳ Ꮊራርዳቶ?” ጋይሴ።<verse eid="MAT 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28"/>የሱሰረ፥ “ዶፈን የም ጋይድቴ፥ ኤደት ይንች ቦንችምሳን ዶቅንት ጎንገንዘን ዶቅድንደትᎺይካ Ꮊድን ክላ ፍጫሙደንዘን እም ጎርስምድባብከስ የታ፥ ታመኬ ቃስተን ባንችንከስ ዶቅድን ጎንገንዘን ዶቅተረቴ፥ ታመኬ ቃስተን እስራኤልንክስታ አጥርንከዘን ፋረተረቴ።<note caller="-" style="x"><char style="xo" closed="false">19፡28 </char><char style="xt" closed="false"><ref loc="MAT 25:31">ማቶ. 25፡31</ref>፤ <ref loc="LUK 22:30">ሉቃ. 22፡30</ref>። </char></note> <verse eid="MAT 19:28"/><verse number="29" style="v" sid="MAT 19:29"/>እካንታ ጋይሶ ይንታ ኤሄንም፥ አነረ ይንታ እስመንከስም፥ አነረ ይንታ ምችነንከስም፥ አነረ ይንታ ባበንም፥ አነረ ይንታ እንደንም አነረ ይንታ ይንችንከስም፥ ይንታ ዎንንም ዛቅስባብ ሙደና ጨተዘን ጨታ ጉጅምሳን ተይተሬ፥ ስለንክንደታ ዶቅንትንመረ Ꮊፍተሬ። <verse eid="MAT 19:29"/><verse number="30" style="v" sid="MAT 19:30"/>ኬዛርንካ ማቼ ታ እሪ ማችባብከስ በድንከስ ቡርንባብከስ ማተረኬ፥ ቡርንባብ ማችባብከሰረ እርንባብከስ ማተረኬ” ኩን ከደር ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">19፡30 </char><char style="xt" closed="false"><ref loc="MAT 20:16">ማቶ. 20፡16</ref>፤ <ref loc="LUK 13:30">ሉቃ. 13፡30</ref>። </char></note><verse eid="MAT 19:30"/></para>
  <chapter eid="MAT 19"/>
  <chapter number="20" style="c" sid="MAT 20"/>
  <para style="s1">ዎይን ኮረርሳን ካርናር ፍግዝድባብከስታ ካምስ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1"/>“ጭላ ባንችምና ዎይንን ኮረርሳን ካርናር ፍግዝድባብከስም Ꮊፍካንታ ዛማ ገልት ዉተድባብ Ꮊምንባብ ኤችንም ካምዴ። <verse eid="MAT 20:1"/><verse number="2" style="v" sid="MAT 20:2"/>ኖኮና ኤችና ዋልቃ ዋልቃባብከስካንታ ዋልቃ ሰጨታ ዋልቃ ጣገራ ብራ ናክካንታ ከትካ ኤእሶ፥ ፍክስንባብከስም ዎይን ኮረርሳን ካርናር ከትም ኦይቼ። <verse eid="MAT 20:2"/><verse number="3" style="v" sid="MAT 20:3"/>ዛማ ማኬን ሳዓታዘን ዉትሰኮ ፍክስ ከትም ካይድንካ መለንዘን ዎእስባብ አብ ኤድንከስም ሰዴ፥ <verse eid="MAT 20:3"/><verse number="4" style="v" sid="MAT 20:4"/>‘የተረ ዎይን ኮረርሳን ካርናር አይሰቶ ፍክስከቴ፥ የካንታ ዝግዝድንደትመረ ናክንም ናክትቴ’ ከደር ጋይሴ። <verse eid="MAT 20:4"/><verse number="5" style="v" sid="MAT 20:5"/>ከተረ ዎይንን ኮረርሳን ካርናር አይሰኬ ጉጅሰረ፥</para>
  <para style="q1" vid="MAT 20:5">“Ꮊየካ ላ ሳዓታዘንኬ ሳክላ ሳዓታዘን ዉትሶ ኮትኮግንዳ ኤድንከስም Ꮊፍሶ ኦይቼ።<verse eid="MAT 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 20:6"/>“Ꮊክስን ታሜከ ዋልቃ ሳዓትካ ዉትሶ አብ ኤድንከስ ዎእሶ ዶቅድንካ Ꮊፍስንደትኬ ‘የታ Ꮊቅንተንም ሙዳ ፍክስካይሳ ካሪ የ ዎእሳንዳ Ꮊረተረ?’ ጋይሶ ከትም ኦይሴ። <verse eid="MAT 20:6"/><verse number="7" style="v" sid="MAT 20:7"/>ከተረ ‘ዎም Ꮊፍሶ ፍክስዝድባብ ኤድ ካይድንኬ’ ክደር ጋይሰኬ፥ ኖየረ ‘ኮማቼ የተረ ዎይን ኮረርሳን ካርናር አይስንደትኬ ፍክስከቴ’ ከትም ጋይሴ።<verse eid="MAT 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8"/>“ፍጨና ሶይቻንደትካ ዎይን ኮረንታ ባበና ፍክስዝድባብም ‘ፍክስንባብከስም ኤልሰዮ ቡርንባብከዘንካ የድሳዮ እርንባብከስ የለልታ ከታ ፍክስንታ ናክንም ናካ’ ክትም ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">20፡8 </char><char style="xt" closed="false"><ref loc="LEV 19:13">ሌዊ. 19፡13</ref>፤ <ref loc="DEU 24:15">ካሪ. 24፡15</ref>። </char></note> <verse eid="MAT 20:8"/><verse number="9" style="v" sid="MAT 20:9"/>ኮካንታ Ꮊክስን ታመከ ዋልቃ ሳዓታዘን ፍክስን የጅባብከስ Ꮊድሰኮ ከታ ዋልቃ ዋልቀንከስ ዋልቃ ብራ ጣገረን ተየኬ። <verse eid="MAT 20:9"/><verse number="10" style="v" sid="MAT 20:10"/>እርናና ፍክስን የጅባብከስ Ꮊድሰኮ አብንከዘንካ ስግ ናክንም ከት ተይድን ከደር ካምሳዶቆ፥ ኬዛርንካ ማቼ ከተረ ዋልቃ ዋልቃባብከስ ዋልቃ ብራ ጣገራ ተየኬ። <verse eid="MAT 20:10"/><verse number="11" style="v" sid="MAT 20:11"/>ብረንም ተይሰኮ ዎይን ኮረንታ ባቤንዘን ኩን ጋየረኮ ጉንድምሰኬ፥ <verse eid="MAT 20:11"/><verse number="12" style="v" sid="MAT 20:12"/>‘ከታኬና በእንተንዘን Ꮊድሰኮ ከት ፍክሳንዳ ዋልቃ ሳዓት Ꮊክዬ፥ ኬዛርንካ ማቼ Ꮊቅንተንም ሙዳ Ꮊያር አትረሮቶ አንድር ፍክስካ ጋብድ ዎ Ꮊቅባብካ ክክን የካ ከትም ማስሳዬ’ ” ጋይሰኬ። <verse eid="MAT 20:12"/><verse number="13" style="v" sid="MAT 20:13"/>“ዎይን ኮረንታ ባቤነረ ይንታ ፍክስንባብከሳርንካ ዋልቀንካንታ፥ ‘እስታ ገርነኖ! Ꮊረነረ የስካንታ ዳቀልሳክቴ፥ ዎ ከዝምሳንደረ ሰጨካ ዋልቃ ጣገራ ብራ የስካንታ ናክካንታ ካዮ? <verse eid="MAT 20:13"/><verse number="14" style="v" sid="MAT 20:14"/>ኮካንታ የስካንታ የልድንደትም ተይሳዮ አይካ፥ የስካንታ እምምሳንከካ ክትኮ ቡርንባብካንተረ እምካንታ ጋይሳቴ። <verse eid="MAT 20:14"/><verse number="15" style="v" sid="MAT 20:15"/>እስታ ገታ ቤርንካ እ ዝግዛንደትም ይካንታ እስታ ሰና ካዮ? አነረ እታ እምድባብ እ ማቻንካንታ የስም ዳቅል ገቀርሶ?’ ” ኩንጋየሮ ክትካንታ ማስሴ።<verse eid="MAT 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16"/>ኮታ ቡር የሱስ “ኮት ኮግንደረ ቡር ማችባብከስ እርንባብ፥ እርማችባብከስ ቡርንባብከስ ማተረኬ” ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">20፡16 </char><char style="xt" closed="false"><ref loc="MAT 19:30">ማቶ. 19፡30</ref>፤ <ref loc="MRK 10:31">ማር. 10፡31</ref>፤ <ref loc="LUK 13:30">ሉቃ. 13፡30</ref>። </char></note><verse eid="MAT 20:16"/></para>
  <para style="s1">የሱስ ይንታ ደእንጎኬ አምንተንጎካ ማክምስ ዱት ኬዘና</para>
  <para style="r">(<ref loc="MRK 10:32-34">ማር. 10፡32-34</ref>፤ <ref loc="LUK 18:31-34">ሉቃ. 18፡31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17"/>ኮታ ቡር የሱስ የሩሳሌም ካተመናር አየረኮ ጎግዘን ታመከ ቃስተን ይንታ ካርንካ ጎርስምድባብከስም ከትም Ꮊክ ይንደር ኤልሶ፥ <verse eid="MAT 20:17"/><verse number="18" style="v" sid="MAT 20:18"/>“ይና ታ የሩሳሌም ካተመናር ዉታዶቅዶተ፥ ኮታረረ ኤድይንችም ቀሰንከስም ገችዝድባብከስተኬ ሙሴታ ህግንም ኤስዝድባብከስካንታ ስክስምት እምምዴ፥ ከተረ ደእታ ፍርደንም ከታዘን ፋረተረኬ። <verse eid="MAT 20:18"/><verse number="19" style="v" sid="MAT 20:19"/>አይሁድ ማታክባብከስካንተረ ስክስት ክትም እምተረኬ፥ ከተረ ክታዘን Ꮊልተርተረኬ፥ ክትም Ꮊርተረከ፥ ክትም ሮክተርከ፥ ኖ ማቼ ማክምስ ሰጨንካ ደእናርንካ አምተሬ” ኩን ከደር ጋይሴ።<verse eid="MAT 20:19"/></para>
  <para style="s1">ዛብዶሰታ ይንችንታ እንደንታ ምክስና</para>
  <para style="r">(<ref loc="MRK 10:35-45">ማር. 10፡35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20"/>ኮታዘንከረ ዛብዶሰታ ይንችንከስታ እንደና፥ ይንታ ይንችንከስካ ክክን የሱሰደር Ꮊድሶ ክታ እረረ ጉንፈርሶ ኮትካንታ ዋልቃ ሪ ይድንግንዳ ክትም ምክሴ።<verse eid="MAT 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21"/>የሱሰረ “Ꮊረስ ዝግዳ?” ኮትም ጋይሴ።</para>
  <para style="q1" vid="MAT 20:21">ናየረ “የስታ ባንችምናር ኬና ቃስተን እስታ ይንችና ዋልቃባብና የስታ ምዝዘን ዋልቀና የስታ ከችዘን ከት ዶቅድንግንዳ ጋይካ!” ና ጋይሴ።<verse eid="MAT 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22"/>የሱስ ማቼ “የታ የ ምግዝድንደትም ኤዝዳከቴ፥ እታ ቅንች ሰጫር እ ዎጭድንደትም ማጠንታ ኡፕተናር ዎጭምን ዎጭካንታ ማደቴ?” ከትም ጋይሴ። ከተረ፥ “ይዬ ዎጭካንታ ማዶቴ!” ክደር ጋይሰኬ።<verse eid="MAT 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23"/>የሱሰረ “ገታ እ ዎጭድንደትም እስታ ማጠንታ ኡፕተናር ዎጭምን ዎጭተረቴ፥ ኬዛርንካ ማቼ ኤድንከስም እስታ ምዝዘንኬ እስታ ከችንዘን ከት ዶቅድንግንዳ ይድባብ እታ ካይቴ፥ ኮና ካርና እምምድንዳ እባብ ግግሳን ኤድንከስካንቴ” ከደር ጋይሴ።<verse eid="MAT 20:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24"/>ነግድባብ ክታ ካርንካ ጎርስምድባብ ታሜንከስ ኮም ምክስን ከታ ይ ኤሰርሳንደትካ ከት ቃስተንንከዘን ዋጨኬ። <verse eid="MAT 20:24"/><verse number="25" style="v" sid="MAT 20:25"/>የሱስ ማቼ ሙደንም ኤልሶ፥ “አይሁድ ማታክባብከስም ገችዝድባብ ይንታ ዎርሰንከስም ቆልድባብከሰኬ፥ ከትም ጎርዝድባብከሰረ ከታዘን ገችታ ኤራ ዶቅድንደትም ኤዝደቴ። <verse eid="MAT 20:25"/><verse number="26" style="v" sid="MAT 20:26"/>የንታ ዎክያር ማቼ ኮግንዳ ማትዝክሳዬ። ኬዛርንካ ማቼ የንታ ዋርንካ አንድር ማትካንታ ዝግድባብ የንታ ፍክስንባብ ማታ።<note caller="-" style="x"><char style="xo" closed="false">20፡26 </char><char style="xt" closed="false"><ref loc="LUK 22:25-26">ሉቃ. 22፡25-26</ref>። </char></note> <verse eid="MAT 20:26"/><verse number="27" style="v" sid="MAT 20:27"/>ኮትኮግንደረ የንዘንካ ስግ ማትካንታ ዝግድባብ የ ሙደንታ ፍክስንባብ ማታ።<note caller="-" style="x"><char style="xo" closed="false">20፡27 </char><char style="xt" closed="false"><ref loc="MAT 23:11">ማቶ. 23፡11</ref>፤ <ref loc="MRK 9:35">ማር. 9፡35</ref>፤ <ref loc="LUK 22:26">ሉቃ. 22፡26</ref>። </char></note> <verse eid="MAT 20:27"/><verse number="28" style="v" sid="MAT 20:28"/>ኤድይንች ኤድካንታ ፍክስካንተኬ በድንከስም አቅስካንታ ይንታ ሰንፔንም ስክስት እምንተካ ቆት ተይካንታ Ꮊዳ ዳት አብንከስ ክትካንታ ፍግዝድንግንዳ Ꮊዳክዬ።”<verse eid="MAT 20:28"/></para>
  <para style="s1">የሱስ ዓፊይ ዝል ቃስተን ኤድንከስም ፋችና</para>
  <para style="r">(<ref loc="MRK 10:46-52">ማር. 10፡46-52</ref>፤ <ref loc="LUK 18:35-43">ሉቃ. 18፡35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29"/>ኮታ ቡር ኢያርኮ ካተመናርንካ ዉትሶ ከት አይድንካ በድ ዎርሳ የሱሰም ጎርስምሰኬ። <verse eid="MAT 20:29"/><verse number="30" style="v" sid="MAT 20:30"/>ይና፥ ጎግታ ካንታር ዶቅስባብ ቃስተን አፍይ ዝልንከስ ጎግንኮትካ ስጋዶቅድባብ የሱስ ማትንተን ከታ ይ ኤሰርሳንደትካ፥ “ጮይስ ዳውተታ ይንችኖ! ዋደ ዎካንታ አጨርካ!” ጋየረኮ ፍፍሰኬ።<verse eid="MAT 20:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31"/>ዎርሰነረ “ጫምንጋይከቴ!” ጋይሰኮ ከትም ዋጨኬ፥ ከታ ማቼ “ዳውተታ ይንች ጮይስኖ! ዋደ ዎም አጨርካ!” ጋየረኮ በችሶ ፍፍሰኬ።<verse eid="MAT 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32"/>የሱሰረ ዎእሶ ከትም ኤልስንደትኬ “Ꮊራ እ የካንታ ይድንግደንት ዝግዳ?” ከደር ጋይሴ።<verse eid="MAT 20:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33"/>ከተረ “የ ጮይስዮ! ዎንታ አፍንከስ ሰድንግንዳ ዝግዶቴ!” ጋይሰኬ።<verse eid="MAT 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34"/>የሱሰረ ከትካንታ አጨርስንደትኬ ከታ አፍንም Ꮊጬ፥ ሳነካ ከታ አፍንከስ ሰጀኬ፥ ከተረ የሱስም ጎርስምሰኬ።<verse eid="MAT 20:34"/></para>
  <chapter eid="MAT 20"/>
  <chapter number="21" style="c" sid="MAT 21"/>
  <para style="s1">የሱስ አንድር ቦንቸካ የሩሳሌማር አርድና</para>
  <para style="r">(<ref loc="MRK 11:1-10">ማር. 11፡1-10</ref>፤ <ref loc="LUK 19:29-40">ሉቃ. 19፡29-40</ref>፤ <ref loc="JHN 12:12-19">ዮሀ. 12፡12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1"/>የሱሰኬ ክታ ካርንካ ጎርስምድባብከስ የሩሳሌም ካተመናር ከት ቅንችምሳንደትካ ደብረ ዛይት ገቸንዘን Ꮊፈርድን በቴፋገ ጋይምሳን ሞረናር ከት የልድንካ የሱስ ይንታ ካርንካ ጎርስምድባብከሳርንካ ቃስተንን፥ <verse eid="MAT 21:1"/><verse number="2" style="v" sid="MAT 21:2"/>“የንታ ኦስ እሪ ዶቅድን ሞረናር አይከቴ፥ ኮታረረ ዋልቃ አከርሳን ኡክል ቅንጭንካ የካ Ꮊፍተረቴ፥ ቡልተረ እዝደር ተይ Ꮊድከቴ። <verse eid="MAT 21:2"/><verse number="3" style="v" sid="MAT 21:3"/>Ꮊየነረ ኤድ ዋልቃ ሪ የንደር ጋይሴ ‘ጮይስ ከትም ዝግድንካንተ’ ጋይከቴ። ኖየረ ኡክልከስም ሳነካ ኦይተሬ” ኩን ጋይሶ ከትም ኦይቼ። <verse eid="MAT 21:3"/><verse number="4" style="v" sid="MAT 21:4"/>ኮነረ ማቻንዳ ሳብዘንከ ኤሰርሶ ከዝድባብካ፥<verse eid="MAT 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5"/>“ጽዮን ካተማ ጋይምድን የሩሳሌምካንታ፥</para>
  <para style="q1" vid="MAT 21:5">‘ይና! የስታ ባንችና ይንታ ማተን ይርክሳ ይድይ ኤድንግንዳ ማትሶ ኡክልታዘንኬ</para>
  <para style="q1" vid="MAT 21:5">ኡክልታ ቅንጭንዘን ዶቅሶ የዝደር Ꮊተሬ!’ ጋይሰቶ ኮትካንታ ከሰከቴ” ኩን ጋይምሶ ኬዝምሳንዳ ቦድምድንግንዴ።<note caller="-" style="x"><char style="xo" closed="false">21፡5 </char><char style="xt" closed="false"><ref loc="ZEC 9:9">ዘካ. 9፡9</ref>። </char></note><verse eid="MAT 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6"/>ክታ ካርንካ ጎርስምድባብከሰረ አይሰኮ የሱስ ከትም ክትሳንግንዳ ይሰኬ። <verse eid="MAT 21:6"/><verse number="7" style="v" sid="MAT 21:7"/>ኡክልንም ቅንጭንካ የካ ክትካንታ ተይ Ꮊደኬ፥ ከታ ይንታ አፍለንከስመረ ኡክልንከስታ ባዝደንዘን ዎጀኬ፥ የሱሰረ ከታዘን ዶቅሴ። <verse eid="MAT 21:7"/><verse number="8" style="v" sid="MAT 21:8"/>ዎርሰናርንከረ በድንከስ ከታ ይንታ አፍለንከስም ጎግንዘን ታከረሰኬ፥ አብንከስ ጉጅሶ Ꮊቀንታ ሳቀንም ሳርስተኮ ጎግንዘን ይጭሰኬ። <verse eid="MAT 21:8"/><verse number="9" style="v" sid="MAT 21:9"/>እርምሶ ክታ እር አይድባብከስኬ ቡርጎካ ጎርስምድ Ꮊቅባብ ዎርሰነረ፥</para>
  <para style="q1" vid="MAT 21:9">“ቦንቼና ዳውተታ ይንችንካንታ!<note caller="+" style="f"><char style="fr" closed="false">21፡9 </char><char style="ft" closed="false">ሆሳና ጋይንትና እብራይስጥ አፈካ አቅስካ ጋይንትዬ። </char></note></para>
  <para style="q1" vid="MAT 21:9">ጮይስታ ላምንካ Ꮊድባብ አንጅምስባቤ!</para>
  <para style="q1" vid="MAT 21:9">ቦንቼና ጭለዘን ሳብካንታ ማታ!” ጋየረኮ ፍብድ Ꮊቀኬ።<note caller="-" style="x"><char style="xo" closed="false">21፡9 </char><char style="xt" closed="false"><ref loc="PSA 118:25-26">የቺ 118፡25-26</ref>። </char></note><verse eid="MAT 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10"/>የሱስ የሩሳሌም ካተመናር አርደዳንደትካ ካተመነረ ኤድንከስ ሙዳ “ኖኮና Ꮊይራ?” ጋይንተካ አዉልሰኬ።<verse eid="MAT 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11"/>ዎርሰነረ፥ “ኖኮና የሱስ ገሊላ ፍጨናር Ꮊፈርድን ናዝረት ካተመናርንካ Ꮊድባብ ሳብዘንካ ኤሰርሶ ኬዝድባቤ” ጋይሰኬ።<verse eid="MAT 21:11"/></para>
  <para style="s1">የሱስ ሳብታ ጭል ኤሄናር ጋበንባብከስም ዳይና</para>
  <para style="r">(<ref loc="MRK 11:15-19">ማር. 11፡15-19</ref>፤ <ref loc="LUK 19:45-48">ሉቃ. 19፡45-48</ref>፤ <ref loc="JHN 2:13-22">ዮሀ. 2፡13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12"/>ኮታዘንከረ የሱስ ሳብታ ጭል ኤሄናር አርደዴ፥ ኮታረረ ኦስ ሰንድባብከስምኬ ፈንክ ሰንት ተይድን ኤድንከስም ሙዳ ዉችሴ። ብረን ኦግድባብከስም ጣርጰዘንከስምኬ ዎለን ሰንድባብከስተረ ጎንገንከስም ቡከልሴ፥ <verse eid="MAT 21:12"/><verse number="13" style="v" sid="MAT 21:13"/>“ ‘እስታ ኤሄና ምክስ ኤሄ ጋይምዴ’ ጋይምሶ ጭል ማጻፍናር ጻፍምቴ፥ የታ ማቼ ቡረንባብከስታ የረሳ ማስሰቴ!” ከትም ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">21፡13 </char><char style="xt" closed="false"><ref loc="ISA 56:7">ኢሳ. 56፡7</ref>፤ <ref loc="JER 7:11">ኤር. 7፡11</ref>። </char></note><verse eid="MAT 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14"/>የሱስ ሳብታ ጭል ኤሄናር ዶቅድንካ አፍይ ዝልንከስኬ ዎከል ዎከልን ጋይድባብከስ ክደር ከት Ꮊድንካ ኖየረ ከትም ፋችሴ። <verse eid="MAT 21:14"/><verse number="15" style="v" sid="MAT 21:15"/>ኬዛርንካ ማቼ ቀሰንከስታ ገችንባብከስኬ ሙሴታ ህግን ኤስዝድባብከስ የሱስ ይሳን በርእስዝድን ርን ከታ ይ ሰጃንካንተከ ይንችንከሰረ ሳብታ ጭል ኤሄናር “ዳዊታ ይንችንካንታ ቦንቼና ማታ!” ጋየረኮ ከት ፍብድንካ ከታ ይንታ ኤስርንካ አንድር ሰነርሰኬ። <verse eid="MAT 21:15"/><verse number="16" style="v" sid="MAT 21:16"/>ኮካንታ የሱሰም “ኬና ይንችና ከት ጋይድንደትም የና ኤሰራዶቅዳ?” ጋይሰኬ፥ የሱሰረ “ይዬ፥ ኤሰራዶቅድቴ፥ ‘ይንችንከዘንኬ አምን ጋእድን ኡለንከስታ አፋርንካ ጋለትን ግግሳዬ’ ጋይድንደትም ቦድሶ ናበባከቴ?” ከደር ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">21፡16 </char><char style="xt" closed="false"><ref loc="PSA 8:2">የቺ 8፡2</ref>። </char></note> <verse eid="MAT 21:16"/><verse number="17" style="v" sid="MAT 21:17"/>ከትም ዛቅሶ ካተመናርንካ ዉትሶ፥ ብታንያ ጋይምድን ሞረናር አይሴ፥ ኮታረረ ኖ ገቼ።<verse eid="MAT 21:17"/></para>
  <para style="s1">የሱስ ባድሳን በለስ Ꮊቀና</para>
  <para style="r">(<ref loc="MRK 11:12-14">ማር. 11፡12-14</ref>፥<ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18"/>የሱስ ዛማ ሰጭመናር፥ ካተመን ኮታር ማት አይድዮ ኖ ዳቀርሴ፥ <verse eid="MAT 21:18"/><verse number="19" style="v" sid="MAT 21:19"/>ዋልቃ በለስ Ꮊቃ ጎግንታ ካንተዘን ሰድሶ Ꮊቀን ኮደር አይሴ፥ ኬዛርንካ ማቼ ቃምዘንካ አብ Ꮊረሰነረ ኮታዘንካ Ꮊፋክዬ። ኮካንታ “ይና ኮዘንካ ኦስ ቦድሶ አፍ የዘንካ ᎺይᎺፈራ!” ኮትም ጋይሴ። በለስ Ꮊቀነረ ሳነካ ዎቼ። <verse eid="MAT 21:19"/><verse number="20" style="v" sid="MAT 21:20"/>ክታ ካርንካ ጎርስምድባብከሰረ ኮም ከታ ይ ሰዳንደትካ፥ “ናኮና በለስ Ꮊቀና ሳነካ Ꮊስግንዶክ ዎቻረ!” ጋይንተካ በርእሰኬ።<verse eid="MAT 21:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21"/>የሱሰረ፥ “ዶፈን የም ጋይድቴ፥ አሜን የንታ ዶቅሰኬ የ Ꮊኤራክንዳ ማቼ በለስ Ꮊቀንዘን ማቻንደትግንዳ Ꮊክ ማታክናና፥ ኮም ገቸንም ዎራ ‘ኮዘንካ ቡጭምሳዮ ባሀርናር አይካ!’ የ ጋይዴ የካንታ ማደ።<note caller="-" style="x"><char style="xo" closed="false">21፡21 </char><char style="xt" closed="false"><ref loc="MAT 17:20">ማቶ. 17፡20</ref>፤ <ref loc="1CO 13:2">1 ቆሮ. 13፡2</ref>። </char></note> <verse eid="MAT 21:21"/><verse number="22" style="v" sid="MAT 21:22"/>አመንሰቶ ምክስካ የ ኦይዝድንደትም ሙዳ Ꮊፍተረቴ” ኩንጋየሮ ከትካንታ ማስሴ።<verse eid="MAT 21:22"/></para>
  <para style="s1">የሱሰታ ገችታ ኤረንጎካ ኦይስምሳን ኦይስና</para>
  <para style="r">(<ref loc="MRK 11:27-33">ማር. 11፡27-33</ref>፤ <ref loc="LUK 20:1-8">ሉቃ. 20፡1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23"/>የሱስ ሳብታ ጭል ኤሄናር አርድሶ ኤስዝድ Ꮊቄ። ኮታይካ ቀሰንከስታ ገችንባብከስኬ ዎርሰንታ ጋልተንከስ ክደረ Ꮊድሰኮ፥ “ኮ ሙዳ የስ ይድንዳ Ꮊራ ገችታ ኤረከረ? ኮም ገችታ ኤረን የስካንታ እምስባብ Ꮊይራ?” ጋይሰኮ ክትም ኦይሰኬ።<verse eid="MAT 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24"/>የሱሰረ፥ “እተረ ዋልቃ ኦይስ የም ኦይስትቴ፥ እስታ ኦይስንታ ማስንም የ ማስሴ እተረ ኮም ሙዳ Ꮊራ ገችታ ኤረካ እ ይዳ ማቼረ የካንታ ኬዝትቴ። <verse eid="MAT 21:24"/><verse number="25" style="v" sid="MAT 21:25"/>ይና ዮሀንሰታ ስእስና Ꮊምንኮክ Ꮊዳራ? ጭላርንኮ አና ኤድዘንኮ?” ጋይሰኮ ኦይሰኬ። ከተረ ክክ ክክ ኩን ጋየረኮ ዞርምሰኬ፥ “ ‘ጭላርንከ’ ዎ ጋይሴ ‘ኮናና Ꮊረተረ ክትም የ አሜናክንዳ’ ዎም ጋይዴ፥ <verse eid="MAT 21:25"/><verse number="26" style="v" sid="MAT 21:26"/>‘ኤታ ዘንከ’ ዎ ጋይሴ፥ ዮሀንሰም ሙደና ሳብዘንካ ኤሰርሶ ኬዝድባብግንዳ ከት ሰድንኦል ዎርሰንካንታ ጳዝዶቴ።” <verse eid="MAT 21:26"/><verse number="27" style="v" sid="MAT 21:27"/>ኮካንታ “ዎታ ኤዝዳኮቴ” ጋይሰኮ የሱሳካንታ ማስሰኬ። ኖየረ “ኮማቼ እተረ Ꮊራ ገችታ ኤረካ ኮም ሙዳ እ ይዳናከረ የካንታ ኬዛይቴ” ኩንጋየሮ ከደር ማስሴ።<verse eid="MAT 21:27"/></para>
  <para style="s1">ቃስተን ይንችንከስታ ካምስና</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28"/>ኮታዘንከረ የሱስ፥ ይና የንደር Ꮊሮክ ካምዳ? ዋልቃ ኤችታ ቃስተን ይንች ዶቅደኬ፥ ከታርንካ እስመንደር Ꮊድሶ፥ እስታ ይንችኖ፥ ታካ እስታ ዎይንን ኮረርሳን Ꮊምናር አይሳዮ የስ ዎንተርንግንዳ ክትም ጋይሴ።<verse eid="MAT 21:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29"/>ይንችነረ ዋይዬ አይዳክቴ ጋይሴ። ማታጋካ ዳት ቡር ማቼ ኡቅምሶ አይሴ። <verse eid="MAT 21:29"/><verse number="30" style="v" sid="MAT 21:30"/>ባበነረ ይንችን ካንስንደር አይሶ ክትመረ ኮትግንዳ ክት ዎንተርንግንዳ ክትሴ፥ ይንችነረ ኤኦ እባቦ አይትቴ ጋይሴ። ኬዛርንካ ማቸ ኖ አያክዬ።<verse eid="MAT 21:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31"/>“ይና ከትኬና ቃስተንናርንካ ይንታ ባቤንታ ጋይተንም ቦጅባብ Ꮊምነረ?” ኩን ከደር ጋይሴ።</para>
  <para style="p" vid="MAT 21:31">ከተረ “እስመኔ!” ጋይሰኬ። የሱሰረ፥ “ዶፈን የም ጋይድቴ፥ ቃረጭን ተችዝድባብከስኬ ቤልምድባብከስ ጭላ ባንችማር አርድንተካ የንታ እር ማደኬ። <verse eid="MAT 21:31"/><verse number="32" style="v" sid="MAT 21:32"/>ስእስንባብ ዮሀንስ ጭላትቸታ ጎግንም የም ሰችካንታ ክት Ꮊድንከሬ የታ አሜናከቴ፥ ቃረጭን ተጅድባብከስኬ ቤልምንባብከስ ማቼ ክትም አመንሰኬ፥ ኮት ኮመረ ሰድሰቶ ዎራ ጎማ ፍክስን ዎይስሰቶ ክትም አሜናከቴ”። ኩን ከትም ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">21፡32 </char><char style="xt" closed="false"><ref loc="LUK 3:12">ሉቃ. 3፡12</ref>፤ <ref loc="LUK 7:29-30">7፡29-30</ref>። </char></note><verse eid="MAT 21:32"/></para>
  <para style="s1">ዎይን ኮረናር ዎንድባብከስታ ካምስና</para>
  <para style="r">(<ref loc="MRK 12:1-12">ማር. 12፡1-12</ref>፤ <ref loc="LUK 10:9-19">ሉቃ. 10፡9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33"/>ጉጅሰረ የሱስ፥ “አብ ካምስነረ ኤሰርከቴ፥ ዎይንንም ኮርዝድባብ ዋልቃ ኤች Ꮊቄ፥ ኖ ዎይንን ይ ኮርሳንደታ ካንተካ ጋስንም ጋሴ፥ ዎይንም ጩጰርድን ጎር ኮይስሰ፥ ዎይንን ካርሰርድንደታ ሰይንካ ቃልም ካሪ ኡርሴ፥ ኮታዘንከረ ዎይን ኮረርሳንደትም ዎንንባብከስካንታ እምሶ አብ ፍጫር አይሴ<note caller="-" style="x"><char style="xo" closed="false">21፡33 </char><char style="xt" closed="false"><ref loc="ISA 5:1-2">ኢሳ. 5፡1-2</ref>። </char></note> <verse eid="MAT 21:33"/><verse number="34" style="v" sid="MAT 21:34"/>አፍን ካመርድን አርፈና የልሳንደትካ አፍን ይም የልድንደትም ተይካንታ ይንታ ፍክስንባብከስም ዎንንባብከዝደር ኦይቼ። <verse eid="MAT 21:34"/><verse number="35" style="v" sid="MAT 21:35"/>ዎንንባብከስ ማቼ ከት Ꮊድባብ ፍክስንባብከስም የድሰኮ ጉጵሰኬ፥ ዋልቀንም ደይሰኬ፥ አብንመረ ሰይንካ አቅሰኬ። <verse eid="MAT 21:35"/><verse number="36" style="v" sid="MAT 21:36"/>ዎይን ኮርተንታ ባበና አናካርንካ እርንባብከዘንካ ፋይደካ ስግድባብከስም አብ ይንታ ፍክስንባብከስም ጉጅሶ ኦይቼ። ዎንባብከስ ከታዘነረ እርንባብከዘን ይሳንግንዳ ይሰከ። <verse eid="MAT 21:36"/><verse number="37" style="v" sid="MAT 21:37"/>በእንተዘነረ ዎይን ኮርንባብ ‘እስታ ይንችንም ቦንችተረኬ!’ ጋይንተካ ይንታ ይንችንም ዎንባብከዝደር ኦይቼ።<verse eid="MAT 21:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38"/>“ዎንባብከስ ማቼ ክታ ይንችንም ከታ ይ ሰዳንደትካ ‘ኖኮና ክታ ባእንም ተይድባቤ፥ ኮረቴ ክትም ደይስሶቶ ባእንም ተይተሮቴ!’ ክክ ጋይሰኬ። <verse eid="MAT 21:38"/><verse number="39" style="v" sid="MAT 21:39"/>ይንችንም የድሰኮ ዎይን ኮረርሳንደታርንካ ኦስ ካንተዘን ዉችሶ ክትም ደይሰኬ።<verse eid="MAT 21:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40"/>“ይና፥ ዎይን ኮረንታ ባቤና ይ Ꮊዳንደትካ ከትኬና ዎንንባብከዘን Ꮊራ ክት ይድሞክ የም ካምዳ?” <verse eid="MAT 21:40"/><verse number="41" style="v" sid="MAT 21:41"/>ከተረ፥ “ከትኬና ዳቅል ኤድንከስታ ቦድንተና ቦርሳንዳ ከትካንታ ማስተሬ። ዎይን ኮረርሳንደትመረ ኡዝድን አፍን ክትካንታ የልድንደትም ሙዳᎺይካ እምድባብ አብ ዎንንባብከስካንታ እምተሬ” ከታ ጋይሰኬ።<verse eid="MAT 21:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42"/>ኮታዘንካ የሱስ፥</para>
  <para style="q1" vid="MAT 21:42">“ጭል ማጻፍንከሳር</para>
  <para style="q1" vid="MAT 21:42">‘ሰይን ኤሄንም ዎድባብከስ ቶችሳን ሰይንና</para>
  <para style="q1" vid="MAT 21:42">ኤሄንካንታ ዝግዝድንዳ ማቼ</para>
  <para style="q1" vid="MAT 21:42">ና ኮነረ ጮይስታ ፍክስዬ፥</para>
  <para style="q2" vid="MAT 21:42">ዎንታ አፍናረረ በርእዝድንዴ’</para>
  <para style="m" vid="MAT 21:42">ጋይምሶ ጭል ማጻፍናር ጻፍምሳን ቦድሶ ናበባከቴ? ኩን ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">21፡42 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">የቺ 118፡22-23</ref>፤ <ref loc="LUK 20:17">ሉቃ. 20፡17</ref>፤ <ref loc="ACT 4:11">ኦይት. ፍ. 4፡11</ref>። </char></note><verse eid="MAT 21:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43"/>“ኮካንታ፥ ሳብታ ባንችምና የንዘንካ ተይምሶ አፍይ ኡዝድን ዎርሰንካንታ እምምዴ። <verse eid="MAT 21:43"/><verse number="44" style="v" sid="MAT 21:44"/>ኮ ሰይንንዘን ዋጅድባብ ቁንጭምደ፥ ሰይንና ክታዘን ዋጅድባብ ኤችና ማቼ አርእስምዴ” ኩን የም ጋይድቴ ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">21፡44 </char><char style="xt" closed="false"><ref loc="LUK 20:18">ሉቃ. 20፡18</ref>። </char></note><verse eid="MAT 21:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45"/>ቀሰንከስታ ገችንባብከስኬ ፈረሳውያንንከስ ኬና ካምስንከስም ከታ ይ ኤሰርሳንደትካ የሱስ ኬዛንዳ ከትጎካ ማትንተን ኤሰኬ። <verse eid="MAT 21:45"/><verse number="46" style="v" sid="MAT 21:46"/>ኮካንታ የሱሰም የድካንታ ዝግዘኬ፥ ኬዛርካ ማቼ ዎርሰና ሳብዘንካ ኤሰርሶ ኬዝድባብግንዳ ክትም ከት ሰድንካንታ ጳሰኬ።<verse eid="MAT 21:46"/></para>
  <chapter eid="MAT 21"/>
  <chapter number="22" style="c" sid="MAT 22"/>
  <para style="s1">እሰናር እችምንታ ካምስ</para>
  <para style="r">(<ref loc="LUK 14:15-24">ሉቃ. 14፡15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1"/>አናካርንከረ የሱስ ካምስካ ኤድንከስካንታ ኩንጋየሮ ኬዛ የጄ፥ <verse eid="MAT 22:1"/><verse number="2" style="v" sid="MAT 22:2"/>“ጭላ ባንችምና ይንታ ይንችንካንታ እሰታ እችምን ግክስባብ ባንችንም ካምዴ። <verse eid="MAT 22:2"/><verse number="3" style="v" sid="MAT 22:3"/>ባንችነረ ኤልምሳን ኤድንከስም እሰናር ከት Ꮊድንግንዳ ገቀርስካንታ ይንታ ፍክስንባብከስም ከደር ኦይቼ”፥ ኤድንከስ ማቼ እሰናር Ꮊድካንታ ዝጋከኬ።<verse eid="MAT 22:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4"/>ባንችና አብ ይንታ ፍክስንባብከስም አናካርንካ ኩንጋየሮ ኦይቼ፥ ኤልምስባብ ኤድንከዝደር አይሰቶ፥ ይና እሰታ እችምን ግክስትቴ፥ ገዝምንከስምኬ ሞረርስባብ መሔንከስ ማችምተ ሙዳ ሪየረ ግግምቴ ኮካንታ እስታ እችምንደር Ꮊድከቴ! ጋይሰቶ ከትካንታ ኬዝከቴ ጋይሴ። <verse eid="MAT 22:4"/><verse number="5" style="v" sid="MAT 22:5"/>ከታ ኤልምስባብከስ ማቼ ኬዘንም በህ ጋይሶ ዋልቃባብና ይንታ ዎንደር፥ አብነረ ይንታ ዛለንደር አይሴ፥ <verse eid="MAT 22:5"/><verse number="6" style="v" sid="MAT 22:6"/>ነገድባብከሰረ ፍክስንባብከስም የድሰኮ ጉጵት ደይሰኬ። <verse eid="MAT 22:6"/><verse number="7" style="v" sid="MAT 22:7"/>ኮካንታ ባንችና ዋጭሶ ይንታ ዳምንባብከስም ኦይትሶ ከትከ ደይስባብከስም ደይስሴ፥ ከታ ካተመንመረ ኖሄካ አችዝድንግንዳ ይስሴ፥ <verse eid="MAT 22:7"/><verse number="8" style="v" sid="MAT 22:8"/>ኮታ ቡር ይንታ ፍክስንባብከስመረ፥ ይና እሰንታ እችምና ግግምቴ፥ ኬዛርካ ማቼ ኤልምስባብከስ እሳ እችምንካንታ ዝግዝድባብ ማትሶ Ꮊፈራከኬ። <verse eid="MAT 22:8"/><verse number="9" style="v" sid="MAT 22:9"/>ኮካንታ ጎግን ባስንዘን አይሰቶ የ Ꮊፍስባብ ኤድንከስም ሙዳ ፈንክ እሰንታ እችምናር ኤልከቴ። ኩን ከትም ጋይሴ። <verse eid="MAT 22:9"/><verse number="10" style="v" sid="MAT 22:10"/>ክታ ፍክስንባብከሰረ ጎግንዘን ዉትሰኮ፥ ከታ ይ Ꮊፍስባብ ኤድንከስም ሙዳ ዳቅልንከስመረ፥ ኡርመንከስመረ ሳንሰኬ፥ ኮካንታ እሰንታ ጋይምሳን ኤሄን ዳልግናር ኤልምሳን ኤድንክስ ጮጨኬ።<verse eid="MAT 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11"/>“ኬዛርንካ ማቼ ባንችና ኤልምስባብከስም ሰድንካንታ ኤሄን ዳልግናር ክት አርደዳንደትካ፥ እሰንታ አፍለንም ቆበራክባብ ዋልቃ ኤችም ዋር ሰዴ። <verse eid="MAT 22:11"/><verse number="12" style="v" sid="MAT 22:12"/>ኩነረ ክትም ጋይሴ፥ ‘እስታ ገርነኖ፥ እሰንታ አፍለንም ቆበርክሳ Ꮊስግንደስ አርድካንተስ ማቻረ?’ ኤችና ማቼ ጫምንጋይሴ። <verse eid="MAT 22:12"/><verse number="13" style="v" sid="MAT 22:13"/>ባንችነረ ይንታ ፍክስንባብከስም፥ ‘ክታ አንንምኬ ዱትንም ዞክሰቶ ማል ዶቅድን ግልድድ ኡምናር ክትም ዉችት ኦይትከቴ፥ ኮታረረ ኤፍኬ አች ቅርጭካ ክትካንታ ማተረ’ ኖ ጋይሴ”።<note caller="-" style="x"><char style="xo" closed="false">22፡13 </char><char style="xt" closed="false"><ref loc="MAT 8:12">ማቶ. 8፡12</ref>፤ <ref loc="MAT 25:30">25፡30</ref>፤ <ref loc="LUK 13:28">ሉቃ. 13፡28</ref>። </char></note> <verse eid="MAT 22:13"/><verse number="14" style="v" sid="MAT 22:14"/>ኮታዘንከረ የሱስ “ኮካንታ ኤልምስባብ በድንከሰኬ፥ እድምስባብከስ ማቼ ቶክመንከሰኬ” ጋይሴ።<verse eid="MAT 22:14"/></para>
  <para style="s1">ግራ ናክጎካ</para>
  <para style="r">(<ref loc="MRK 12:13-17">ማር. 12፡13-17</ref>፤ <ref loc="LUK 20:20-26">ሉቃ. 20፡20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15"/>ኮታ ቡር ፈረሳውያንንከስ አይሰኮ Ꮊስ ይይሶ የሱሰም ክት ኬዝድን ኬዘንካ ከታ ይ የዳናንከረ ዞርምሰኬ፥ <verse eid="MAT 22:15"/><verse number="16" style="v" sid="MAT 22:16"/>ከታ ይንታ ካርንካ ጎርስምድባብከስም ሄሮድሰታ ኤድንከስካ ክክን የሱሰደር ኦይትሰኮ፥ “የ ኤስስንባቦ! የስ ዶፈን ማቻንደትምከ ሳብታ ጎግንም ዶፈንካ የስ ኤስዝድንደትም ዎታ ኤዝዶቴ፥ ኤታ ባላካንታ ኦስንዳከየ” ከታ ይ ጋይሳንደታ ቡር፥ ኩን ጋይሶ ክትም ኦይሰኬ። <verse eid="MAT 22:16"/><verse number="17" style="v" sid="MAT 22:17"/>“ይና ዎም የስ ኬዝኔ Ꮊሮክ የስም ካምዳ? ሮማ ባንችንካንታ ግራ ናክ ዝግዝዶ ዝክሳዮ?” ጋይሰኬ። <verse eid="MAT 22:17"/><verse number="18" style="v" sid="MAT 22:18"/>የሱስ ማቼ ከታ ዳቅል ገቅርንም ኤስሶ፥ “የታ ኦትረንባብከሶ! Ꮊረተንት እም ጰጭዳ? <verse eid="MAT 22:18"/><verse number="19" style="v" sid="MAT 22:19"/>ግረንካንታ ናከርድን ብረንም እካንታ የ ሰችነ!” ከትም ጋይሴ። ኮካንታ ከተረ ዋልቃ ብራ ጣገራ ተይᎺድሰኮ ክትም ሰችሰኬ። <verse eid="MAT 22:19"/><verse number="20" style="v" sid="MAT 22:20"/>ኖየረ፥ “ኮ ብረንዘን Ꮊፈርድንዳ ምስልንከ ጻፈርሳን ላምና Ꮊይተረ?” ጋየሮ ከትም ኦይሴ።<verse eid="MAT 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21"/>ከተረ፥ “ሮማ ባንችንቴ!” ክደር ጋይሰኬ፥ ኖየረ፥ “ኮናና ባንችንተን ባንችንካንታ ሳብትን ሳብካንታ እምከቴ” ከትም ጋይሴ። <verse eid="MAT 22:21"/><verse number="22" style="v" sid="MAT 22:22"/>ከተረ ክትም ይ ኤሰርሳንደታ ቡር ክታ ኬዘንካ በርእሰኮ ክትም ዛቅሶ አይሰኬ።<verse eid="MAT 22:22"/></para>
  <para style="s1">ደእያርንካ አምንተንጎካ</para>
  <para style="r">(<ref loc="MRK 12:18-27">ማር. 12፡18-27</ref>፤ <ref loc="LUK 20:27-40">ሉቃ. 20፡27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23"/>ኮታይካ፥ “ደእስባብከስታ አምንታ ካዬ” ጋይድባብ ሰዶቃዊያንንከስ የሱሰደር Ꮊድሰኮ ኩንጋየሮ ክትም ኦይሰኬ፥<note caller="-" style="x"><char style="xo" closed="false">22፡23 </char><char style="xt" closed="false"><ref loc="ACT 23:8">ኦይት. ፍ. 23፡8</ref>። </char></note> <verse eid="MAT 22:23"/><verse number="24" style="v" sid="MAT 22:24"/>“የ ኤስስንባቦ! ሙሴ ‘ዋልቃ ኤድ ይንች አጣክዶቆ ይንታ ኬነንዘንካ ደእካ ክት ፋስምሴ ክታ እስመና ደእስባብታ ኬነንም ማስሶ ክትካንታ ይንች አጣ’ ጋይቴ።<note caller="-" style="x"><char style="xo" closed="false">22፡24 </char><char style="xt" closed="false"><ref loc="DEU 25:5">ካሪ. 25፡5</ref>። </char></note> <verse eid="MAT 22:24"/><verse number="25" style="v" sid="MAT 22:25"/>ኮትኮግንደረ ታብዛ እስመንከስ ዎንደር ዶቅደኬ፥ ከትሙደንተረ እስመነና ማና እንችሶ ይንች አጣክሳ ደእሴ፥ ኮካንታ ክታ ካንስና ደእስባብታ ኬነንም ማስሴ። <verse eid="MAT 22:25"/><verse number="26" style="v" sid="MAT 22:26"/>ኮትኮግንደረ፥ ቃስትምስነረ፥ ማክምስነረ ታብስን የለልታ ከታ ሙደነረ ኮትም እንችሰኮ ደእሰኬ። <verse eid="MAT 22:26"/><verse number="27" style="v" sid="MAT 22:27"/>ከትሙደንተረ በእንተዘን ኤተና ይንታ ማታ ደእሴ። <verse eid="MAT 22:27"/><verse number="28" style="v" sid="MAT 22:28"/>ይና፥ ከታ ታብዘነረ ኮትም እንቻንካንታ ደእናርንካ አምንተን ሰጨንካ Ꮊይቶክ ማና ማዳ?” ጋይሰኬ።<verse eid="MAT 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29"/>የሱስ ማቼ፥ “የታ ጭል ማጻፍንከስምኬ ሳብታ ዎልቀንም የንታ ኤስክሳ ነግንተንካ የታ ኮተርደቴ። <verse eid="MAT 22:29"/><verse number="30" style="v" sid="MAT 22:30"/>ደእስባብከስታ አምንተን Ꮊይካ ኤድንከስ ጭላር ዶቅድን ክታይንችንከስግንዳ ማደክ ዳት እንቻየኬ፥ ይአየኬ። <verse eid="MAT 22:30"/><verse number="31" style="v" sid="MAT 22:31"/>ጉጅሰረ ደእያርንካ አምንተንጎካ ሳብ የካንታ ኬዛንደትም ናበባከቴ? <verse eid="MAT 22:31"/><verse number="32" style="v" sid="MAT 22:32"/>ክተረ ጋይሳንዳ ኩኔ፥ ‘እታ አብራሀመታ ሳብ፥ ይሳቀታ ሳብ፥ ያይቆበታ ሳብቴ።’ ኮካንታ ሳብ ሰንፔንክንባብከስታ ሳብ ዳት ደእስባብከስታ ሳብ ካዬ” ኩን ጋይሶ ማስሴ።<note caller="-" style="x"><char style="xo" closed="false">22፡32 </char><char style="xt" closed="false"><ref loc="EXO 3:6">ዉት. 3፡6</ref>። </char></note><verse eid="MAT 22:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33"/>ዎርሰነረ ኮም ይ ኤሰርሳንደትካ ክታ ኤስስንካ በርእሰኬ።<verse eid="MAT 22:33"/></para>
  <para style="s1">ሙደንዘንካ ስገድንዳ ክታ</para>
  <para style="r">(<ref loc="MRK 12:28-34">ማር. 12፡28-34</ref>፤ <ref loc="LUK 10:25-28">ሉቃ. 10፡25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34"/>የሱስ ሰዶቃዊያንንከስም ጫምሳ ይስሳንደትም ከታ ይ ኤሰርሳንደትካ ፈረሰዊያንንከስ ዋልቃትቸካ ሳንምሰኬ። <verse eid="MAT 22:34"/><verse number="35" style="v" sid="MAT 22:35"/>ከታርንከረ ዋልቃ ሙሴታ ህግንም ኤስዝድባብ፥ የሱሰም ጰጫካንታ ዝግሶ ኩን ጋይሶ ኦይሴ፥<note caller="-" style="x"><char style="xo" closed="false">22፡35 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">ሉቃ. 10፡25-28</ref>። </char></note> <verse eid="MAT 22:35"/><verse number="36" style="v" sid="MAT 22:36"/>“ኤስስንባቦ! ሙሴታ ህግን ሙደናርንካ ስገድንዳ ክታ Ꮊምነረ?” ጋይሰኬ። <verse eid="MAT 22:36"/><verse number="37" style="v" sid="MAT 22:37"/>የሱሰረ፥ “የስታ ጮይስ ሳብን የስታ ቦድማ ቡዳርንካ፥ ቦድማ የስታ ሰንፔንካ፥ ቦድማ የስታ ገቅርንካ ሶልምካ፥<note caller="-" style="x"><char style="xo" closed="false">22፡37 </char><char style="xt" closed="false"><ref loc="DEU 6:5">ካሪ. 6፡5</ref>። </char></note> <verse eid="MAT 22:37"/><verse number="38" style="v" sid="MAT 22:38"/>ሙደንዘንካ ስገድንደትከ እርንደና ክተና ኮኔ። <verse eid="MAT 22:38"/><verse number="39" style="v" sid="MAT 22:39"/>ኮትኮመረ ካምድንዳ ቃስትምስ ክተና፥ ‘የስታ የለንም የስታ ማታግንዳ ማስሳዮ ሶልምካ’ ጋይድንደኔ።<note caller="-" style="x"><char style="xo" closed="false">22፡39 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ሌዊ. 19፡18</ref>። </char></note> <verse eid="MAT 22:39"/><verse number="40" style="v" sid="MAT 22:40"/>ሙሴታ ህግንከ ሳብዘንካ ኤሰርሶ ኬዛቅባብከስታ ኤስስን ሙደንታ የድና ከትኬ ቃስተን ክቴን ኬዘንኬ” ኩንጋየሮ ከትካንታ ማስሴ።<verse eid="MAT 22:40"/></para>
  <para style="s1">ክርስቶስጎካ Ꮊዳን ኦይስና</para>
  <para style="r">(<ref loc="MRK 12:35-37">ማር. 12፡35-37</ref>፤ <ref loc="LUK 20:41-44">ሉቃ. 20፡41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41"/>ፈረሳውያንንከስ ሳንምሰኮ ዶቅድንካ የሱስ ኩን ጋይሶ ከትም ኦይሴ፥ <verse eid="MAT 22:41"/><verse number="42" style="v" sid="MAT 22:42"/>“ክርስቶስጎካ Ꮊረንት ገቀርዳ? Ꮊይታ ይንችምክ የንደር ካምዳ?” ከተረ “ዳውተታ ይንቼ” ጋይሰኮ ክትካንታ ማስሰኬ።<verse eid="MAT 22:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43"/>የሱሰረ፥ “ኮናና፥ ዳውት ሳብታ አያንካ ጎርስምሶ ክት ኬዛንደትካ Ꮊስግንድክ ‘ጮይስዮ’ ጋይሶ ኤልሳረ?<verse eid="MAT 22:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44"/>“ጮይስ እስታ ጮይስንካንታ፥</para>
  <para style="q2" vid="MAT 22:44">የስታ ይምኤንባብከስም የስታ ዱትንታ ጎይናር እ ሙክስተርን የለልታ፥</para>
  <para style="q2" vid="MAT 22:44">እስታ ምዝንዘን ዶእካ! ክትም ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">22፡44 </char><char style="xt" closed="false"><ref loc="PSA 110:1">የቺ 110፡1</ref>። </char></note><verse eid="MAT 22:44"/></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45"/>ይና ዳውት ይንታ ማታርንካ ‘ጮይስ’ ጋይሶ ክትም ኤልሳንካ ይና ክርስቶስ Ꮊስግንድክ ክታ ይንች ማዳ?” ኩን ከትም ጋይሴ። <verse eid="MAT 22:45"/><verse number="46" style="v" sid="MAT 22:46"/>ኮትኮ ኬዘንታ ዋልቃ ዎራ ኬዝት ማስስባብ Ꮊየነረ ኤድ ካዬ፥ ኮትኮ ሰጨንዘንካ የድሶ ክትም ኦይስካንታ ማችባብ Ꮊየነረ ካዬ።<verse eid="MAT 22:46"/></para>
  <chapter eid="MAT 22"/>
  <chapter number="23" style="c" sid="MAT 23"/>
  <para style="s1">የሱስ ፈረሳዊያንንከስምኬ ሙሴታ ህግንም ኤስዝድባብከስም ይንኤርና</para>
  <para style="r">(<ref loc="MRK 12:38-39">ማር. 12፡38-39</ref>፤ <ref loc="LUK 11:43-46">ሉቃ. 11፡43-46</ref>፤ <ref loc="LUK 20:45-46">20፡45-46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1"/>ኮታ ቡር የሱስ ዎርሰንከስካንተኬ ይንታካርንካ ጎርስምድባብከስካንታ ኩንጋየሮ ኬዜ፥ <verse eid="MAT 23:1"/><verse number="2" style="v" sid="MAT 23:2"/>ሙሴታ ህግንም ኤስዝድባብከስኬ ፈረሳዊያንንከስ ሙሴታ ህግንም ከት ኤስዝድንግንዳ ገችታ ኤራ ከትካንታ እምምቴ። <verse eid="MAT 23:2"/><verse number="3" style="v" sid="MAT 23:3"/>ኮካንታ ከት የም ጋይድንደትም ሙዳ ይከቴ፥ ካርስከቴ፥ ከት ይድንደትም ማቼ Ꮊይ ይየቴ፥ ከታ ይ ኬዝድንደትም ፍክስዘን Ꮊቅሳየኬ፥ <verse eid="MAT 23:3"/><verse number="4" style="v" sid="MAT 23:4"/>ደጭድንደትምኬ ማእዝድን ባለን ኤታ ገትዘን ባልዝደኬ፥ ከታ ይንታ ማተንካንታ ማቼ ግልኤከረ ዎራ ዎልካንታ ዝጋየኬ። <verse eid="MAT 23:4"/><verse number="5" style="v" sid="MAT 23:5"/>ከታ ይንታ ፍክስንም ሙዳ ኤድ ሰዳባብ ጋይሶ ፍግዝደኬ፥ ሙሴታ ህግንም ጻፈርሳንደትመረ ይንታ ባለንዘን ዞግደኬ፥ አፍለነረ ይንታ ቃልዝደኬ።<note caller="-" style="x"><char style="xo" closed="false">23፡5 </char><char style="xt" closed="false"><ref loc="MAT 6:1">ማቶ. 6፡1</ref>፤ <ref loc="NUM 15:38">ፋይ. 15፡38</ref>፤ <ref loc="DEU 6:8">ካሪ. 6፡8</ref>። </char></note> <verse eid="MAT 23:5"/><verse number="6" style="v" sid="MAT 23:6"/>ዎጨርድን እቸርድን ካርዘነረ ቦንችምሳን ካሪ፥ አይሁድንከስታ ምክስ ኤሄናረረ እርጎካ ጎገንዘን ዶቅንካንታ ዝግደኬ። <verse eid="MAT 23:6"/><verse number="7" style="v" sid="MAT 23:7"/>መለን ኬዘነረ ኤድ ሙዳ ከትካንታ አን አምዝድንግንደኬ የ ኤስስንባብ! ጋይሶ ከትም ኤልድንግንዳ ዝግደኬ። <verse eid="MAT 23:7"/><verse number="8" style="v" sid="MAT 23:8"/>የታ ማቼ የንታ ኤስስንባብ ዋልቃ Ꮊክ ክት ማቻንካንተኬ የታ ሙደነረ እስመንኬ ካንስካ የ ማቻንካንታ ኤስስንባብ ጋይምሰቶ Ꮊይ ኤልመቴ። <verse eid="MAT 23:8"/><verse number="9" style="v" sid="MAT 23:9"/>ጉጅሰረ የንታ ዶቅድባብ ጭላር ዋልቃ ባበና Ꮊክ ክት ማቻንካንታ ፍጨዘን Ꮊይመረ ባቤና ጋይሰቶ Ꮊይ ኤለቴ። <verse eid="MAT 23:9"/><verse number="10" style="v" sid="MAT 23:10"/>የንታ ጎርስንባብ ክርስቶስ ማቻንካንታ ሙደንም ኤዝድባብከስ ጋይምሰቶ Ꮊይ ኤልመቴ። <verse eid="MAT 23:10"/><verse number="11" style="v" sid="MAT 23:11"/>የንታ ዎክያርንካ አንድር ማችባብ የንታ ፍክስንባብ ማታ።<note caller="-" style="x"><char style="xo" closed="false">23፡11 </char><char style="xt" closed="false"><ref loc="MAT 20:26-27">ማቶ. 20፡26-27</ref>፤ <ref loc="MRK 9:35">ማር. 9፡35</ref>፤ <ref loc="MRK 10:43-44">10፡43-44</ref>፤ <ref loc="LUK 22:26">ሉቃ. 22፡26</ref>። </char></note> <verse eid="MAT 23:11"/><verse number="12" style="v" sid="MAT 23:12"/>ይንታ ማተንም ጬክሳ ይድባብ ቶችምዴ፥ ይንታ ማተንም ቶጅድባብ ማቼ ቦንችምዴ።<note caller="-" style="x"><char style="xo" closed="false">23፡12 </char><char style="xt" closed="false"><ref loc="LUK 14:11">ሉቃ. 14፡11</ref>፤ <ref loc="LUK 18:14">18፡14</ref>። </char></note><verse eid="MAT 23:12"/></para>
  <para style="s1">ሙሴታ ህግንም ኤስዝድባብከስኬ ፈረሳዊያንንከስ ዳይምና</para>
  <para style="r">(<ref loc="MRK 12:40">ማር. 12፡40</ref>፤ <ref loc="LUK 11:39-42">ሉቃ. 11፡39-42</ref>፥<ref loc="LUK 11:44">44</ref>፥<ref loc="LUK 11:52">52</ref>፤ <ref loc="LUK 20:47">20፡47</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13"/>“ኤድ ጭላ ባንችማር አርዳይንግንዳ ፍልተንም ዝጭድባብ የታ ኦትረንባብከሶ፥ ሙሴታ ህግንም ኤዝድባብከስኬ ፈረሳውያንንከሶ! የም የኤ! የታ የንታ ማታርንካ ኮታር አርተራከቴ፥ አርድካንታ ዝግድባብከስም ከት አርዳክንግንዳ የታ ማርደቴ!”</para>
  <para style="p" vid="MAT 23:13">[ <verse eid="MAT 23:13"/><verse number="14" style="v" sid="MAT 23:14"/>ዎም ሰደራ ጋይሰቶ ምክስም ቃልሰረቶ ኮትካ ጋይረረቶ ከታ ክእስንከስ ደእስባብ ማነንከስም ከታ ገች Ꮊቅን በይዝድባብ የታ ኦትረንባብከሶ ሙሴታ ህግን ኤዝድባብከስኬ ፈረሳውያንንከሶ የም የኤ! ኮካንታ እንድንካ ስገዳን ፍርዳ የንዘን የልተሬ።]<note caller="+" style="f"><char style="fr" closed="false">23፡14 </char><char style="ft" closed="false">ዋልቃ ዋልቃ ኤና እር እንከስ ፋይዳ 14 ጉጃዬ። </char></note><note caller="-" style="x"><char style="xo" closed="false">23፡14 </char><char style="xt" closed="false"><ref loc="MAT 12:40">ማቶ. 12፡40</ref>። </char></note><verse eid="MAT 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15"/>የታ ኦትረንባብከሶ ሙሴታ ህግን ኤስዝድባብከስኬ ፈረሳውያንንከሶ! የም የኤ! ዋልቃ ኤድ የንታ ካርንካ ጎርስምድባብ የ ማስሳንደታ ቡር ባሀር ሎቀናርንከ ፍጨዘን ኦንግደቴ፥ የንደር የ ማስሳንᎺይከረ የንዘንካ ቃስተን አን ጉጅምሳን ስገዳን ድግዳክን ኖሀካንታ ግግምስባብ ከትም ማዝደቴ!<verse eid="MAT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16"/>የታ አፊይ ዝል ጎርስንባብከሶ! የም የኤ! ኤድ ሳብታ ጭል ኤሄካ ጫቅሴ፥ Ꮊረሰነረ ካዬ የታ ጋይደቴ፥ ሳብታ ጭል ኤሄንታ ዎርቀንካ ክት ጫቅሳን ማቼ ይንታ ጫቀንካ የደርደ የታ ጋይደቴ፥ <verse eid="MAT 23:16"/><verse number="17" style="v" sid="MAT 23:17"/>የታ ዳቸንከስከ አፍዝልንከሶ! ዎርቀዘንኬ ዎርቀንም ጭልዝድባብዘንካ Ꮊምና ስገዳ? <verse eid="MAT 23:17"/><verse number="18" style="v" sid="MAT 23:18"/>ኮትኮግንደረ ኤድ ካስካርዘን ጫቅሴ Ꮊረሰነረ ካዬ፥ ካስ ካርንዘን ዶቅድን ርንካ ክት ጫቅሴ ይንታ ጫቀንካ የደርዴ ጋይደቴ። <verse eid="MAT 23:18"/><verse number="19" style="v" sid="MAT 23:19"/>የታ አፍይ ዝልንከሶ! እመንዘንኬ እመንም ጭልዝድን ካሲንዘንካ Ꮊምና ስገዳ? <verse eid="MAT 23:19"/><verse number="20" style="v" sid="MAT 23:20"/>ኮካንታ ካስ ካርንካ ጫቅድባብ፥ ካስ ካርንዘንከ ካሰርድን ዶቅድን ርንካ ሙዳ ጫቅዴ።<note caller="+" style="f"><char style="fr" closed="false">23፡20 </char><char style="ft" closed="false">እማ ጋይንት ኤድ ይንታ ጮይስንካንታ ክት እምድን ፍክስና ሙዳ እማ ጋይምዴ። </char></note> <verse eid="MAT 23:20"/><verse number="21" style="v" sid="MAT 23:21"/>ሳብታ ጭል ኤሄንከረ ጫቅድባብ፥ ሳብታ ጭል ኤሄንኬ ጭል ኤሄናር ዶቅድን ርንካ ጫቅዴ። <verse eid="MAT 23:21"/><verse number="22" style="v" sid="MAT 23:22"/>ጭለካ ጫቅድባበረ ሳብታ ዶቅንት ጎንገንኬ ጎንገንታዘን ዶቅድባብካ ጫቅዴ።<note caller="-" style="x"><char style="xo" closed="false">23፡22 </char><char style="xt" closed="false"><ref loc="ISA 66:1">ኢሳ. 66፡1</ref>፤ <ref loc="MAT 5:34">ማቶ. 5፡34</ref>። </char></note><verse eid="MAT 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23"/>የታ ኦተርድባብከስ ሙሴታ ህግንም ኤስስንባብከስኬ ፈረሳውያንንከሶ! የም የኤ! ሳዉሰርድን ር አዝሙድ፥ እንስላል፥ ከሙን ጋይድንደታርንካ ታሜናርንካ ዋልቀንም እምደቴ፥ ኬዛርንካ ማቼ ህግናር ዶቅድን ዝግዝድን ሪንከስም የታ ዛቅደቴ፥ ከታ ከነረ ገታ ማቻን ፍርዳ፥ ቡዳርንካ አትርኬ አመንምኬ፥ ከትከም ዛቃከትዶቆ ይ የም ዝግዝድንዳ ዶቆ።<note caller="-" style="x"><char style="xo" closed="false">23፡23 </char><char style="xt" closed="false"><ref loc="LEV 27:30">ሌዊ. 27፡30</ref>። </char></note> <verse eid="MAT 23:23"/><verse number="24" style="v" sid="MAT 23:24"/>የታ አፊይ ዝል ጎርስንባብከሶ! የ ዎጭድንደታርንካ ሙዳ ትንጋግንዳ መራ ማቻን ሪን ጭልስሰቶ ዎጭደቴ ግመልግንድ ባካ ርም የንታዋር ኤቅዝደቴ!<verse eid="MAT 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25"/>የታ ኦትረንባብከስ ሙሴታ ህግንም ኤስዝድባብከስኬ ፈረሳውያንንከሶ! የም የኤ! ቡርጨቀንምከ ሳሀንንታ ዘንንደትም ስእደቴ፥ የንታ ዋርጎክንዳ ማቼ ቡረከ ድሰካ ጮጫንዴ፥ <verse eid="MAT 23:25"/><verse number="26" style="v" sid="MAT 23:26"/>የና አፊይ ዝል ፈረሳውያንኖ! እርምሰዮ ቡርጭቀንተከ ሳሀንንታ ዋርጎክንደትም ስእካ! ኮትᎺይካ ቡርጎክንደረ ኡርማ ማተረ።<verse eid="MAT 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27"/>የታ ኦተረንባብከስ ሙሴታ ህግንም ኤስዝድባብከሰኬ ፈረሳውያንንከሶ! የም የኤ! ከታ ዋር ደእስባብ ኤድንከስታ ለፍኬ ቱና ማቻን ር ሙደንካ ጮጭባብከስ፥ ቡርጎካ ቦቀካ ሳይሶ ላቅምድን ዱክንከስም ካምደቴ።<note caller="-" style="x"><char style="xo" closed="false">23፡27 </char><char style="xt" closed="false"><ref loc="ACT 23:3">ኦይት. ፍ. 23፡3</ref>። </char></note> <verse eid="MAT 23:27"/><verse number="28" style="v" sid="MAT 23:28"/>ኮትኮግንደረ የታ፥ ማልጎካ ኤድካንታ ጭልንባብከስም ካምሰቶ Ꮊፈረደቴ፥ የንታ ዋርጎካ ማቼ ኦትረኬ ዳቀልስካ ጮጭቴ።<verse eid="MAT 23:28"/></para>
  <para style="s1">ሙሴታ ህግንም ኤስዝድባብከስተኬ ፈረሳዊያንንከስታ ሰርምና</para>
  <para style="r">(<ref loc="LUK 11:47-51">ሉቃ. 11፡47-51</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29"/>የታ ኦትረንባብከስ፥ ሙሴታ ህግንም ኤስዝድባብከስኬ ፈረሳውያንንከሶ! የም የኤ! ሳብዘንከ ኤሰርሶ ኬዛቅባብከስታ ዱክንም ኡርዝደቴ፥ ጭልንከስታ ሰይንካ ኡርሰርሳን ዱክን ሰግዝደቴ።<verse eid="MAT 23:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 23:30"/>ኤና እሪ ዎንታ ባቤንከስታ ስለናር ዎ ዶቅሰስናና ሳብዘንካ ኤሰርሶ ኬዛቅባብከስታ ማቀስን ዉልእንካ ከትካ ክክን ዋልቃ ማተራኮት ዶቆ ጋይደቴ። <verse eid="MAT 23:30"/><verse number="31" style="v" sid="MAT 23:31"/>ይና፥ ሳብዘንካ ኤሰርሶ ኬዝድባብከስም ደይስባብ ኤድንከስታ ይንች የንታ ማትንተን ማርከርደቴ። <verse eid="MAT 23:31"/><verse number="32" style="v" sid="MAT 23:32"/>የተረ ጉጅሶ የንታ ባበንከስ ፍክስ የጃንደትም ቦድከቴ። <verse eid="MAT 23:32"/><verse number="33" style="v" sid="MAT 23:33"/>የታ ጉን ፉይንታ ይንችንከሶ፥ ስለንካ ድግዳክን ኖሄንታ ፍርደናርንካ Ꮊስግንደንት ሱርትካንታ ማዳ?<note caller="-" style="x"><char style="xo" closed="false">23፡33 </char><char style="xt" closed="false"><ref loc="MAT 3:7">ማቶ. 3፡7</ref>፤ <ref loc="MAT 12:34">12፡34</ref>፤ <ref loc="LUK 3:7">ሉቃ. 3፡7</ref>። </char></note> <verse eid="MAT 23:33"/><verse number="34" style="v" sid="MAT 23:34"/>ኮካንታ ይና፥ እታ ሳብዘንካ ኤሰርሶ ኬዝድባብከስም፥ ኤጨንባብከስም፥ ኤስስንባብከስም፥ የንደር ኦይድቴ፥ ከታርንካ ዋልቃ ዋልቃባብከስም የታ ደይዝደቴ፥ ዋልቃ ዋልቃባብከስም ሮግደቴ፥ ዋልቃ ዋልቀንከስመረ አይሁድንከስታ ምክስ ኤሄናር Ꮊርደቴ፥ ዋልቃ ካተመናርንካ አብ ካተመናር ከትም ዳይደቴ፥ <verse eid="MAT 23:34"/><verse number="35" style="v" sid="MAT 23:35"/>ኮትጎካ ክት ጭልን አበልታ ማቀስንዘንካ የድሶ ሳብታ ጭል ኤሄንተከ ካስ ካርንታ ዎክያር የ ደይሳንደዘንካ የድሶ ባራክታ ይንች ዛከራስታ ማቀስን የለልታ ፍጨዘን ዉልእምሳን ጭልንከስታ ማቀስንታ ዋጭና የንታዘን የልዴ፥<note caller="-" style="x"><char style="xo" closed="false">23፡35 </char><char style="xt" closed="false"><ref loc="NUM 4:8">ፋይ. 4፡8</ref>፤ <ref loc="2SA 24:20-21">2 ሳሙ. 24፡20-21</ref>። </char></note> <verse eid="MAT 23:35"/><verse number="36" style="v" sid="MAT 23:36"/>ዶፈን የም ጋይድቴ፥ ኮና ሙዳ ዋጭና ኮ አጥርንዘን የልዴ።<verse eid="MAT 23:36"/></para>
  <para style="s1">የሩሳሌም ካተመንካንታ የሱሰታ ኤፍና</para>
  <para style="r">(<ref loc="LUK 13:34-35">ሉቃ. 13፡34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37"/>ኮታዘንከረ የሱስ፥ “የሩሳለሞ፥ የሩሳሌሞ! የና ሳብዘንካ ኤሰርሶ ኬዝድባብከስም ደይዝድንዶ! የዝደር ኦይትምስባብከስመረ ሰይንካ አቅድንዶ! ባቸና ይንታ ይንችንከስም ይንታ ከፍንታ ጎይናር ኮት ሳንዝድንደትግንዳ፥ እተረ የስታ ይንችንከስም ዋልቃትችካ ሳንስካንታ በድ ሰጫᎺይካ ካርሳቴ፥ የታ ማቼ ዝጋከቴ። <verse eid="MAT 23:37"/><verse number="38" style="v" sid="MAT 23:38"/>ይና ኮዘንካ፥ ሳብታ ጭል ኤሄና ካይዝ ማትሶ ነገዴ።<note caller="-" style="x"><char style="xo" closed="false">23፡38 </char><char style="xt" closed="false"><ref loc="JER 22:5">ኤር. 22፡5</ref>። </char></note> <verse eid="MAT 23:38"/><verse number="39" style="v" sid="MAT 23:39"/>ኮካንታ ‘ጮይስታ ላምንካ Ꮊድባብ አንጅምስባቤ’ የ ጋይተርን የለልታ ይና ኮዘነካ ኦስ እም ሰዳከቴ የም ጋይድቴ” ኩን ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">23፡39 </char><char style="xt" closed="false"><ref loc="PSA 118:26">የቺ 118፡26</ref>። </char></note><verse eid="MAT 23:39"/></para>
  <chapter eid="MAT 23"/>
  <chapter number="24" style="c" sid="MAT 24"/>
  <para style="s1">ሳብታ ጭል ኤሄንታ ዉልእምንጎካ የሱስ ኬዛንዳ</para>
  <para style="r">(<ref loc="MRK 13:1-2">ማር. 13፡1-2</ref>፤ <ref loc="LUK 21:5-6">ሉቃ. 21፡5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1"/>የሱስ ሳብታ ጭል ኤሄናርንካ ዉትሶ ክት አይድንካ ክታ ካርንካ ጎርስምድባብከስ ሰይንካ ዎድምሳን ሳብታ ጭል ኤሄን ክትም ሰችካንታ ክደር Ꮊደኬ። <verse eid="MAT 24:1"/><verse number="2" style="v" sid="MAT 24:2"/>ኖ ማቼ “ኮም ሙደን ሰደቴ? ዶፈን የም ጋይድቴ፥ ሰይንና ሰይንንዘን ከልምሳንዳ ዉልእማክዶቆ ነጋዬ” ከትም ጋይሴ።<verse eid="MAT 24:2"/></para>
  <para style="s1">ጮይስ Ꮊተርንደታ እሪ የልድንዳ ዳይርኬ ማጠካ</para>
  <para style="r">(<ref loc="MRK 13:3-13">ማር. 13፡3-13</ref>፤ <ref loc="LUK 21:7-19">ሉቃ. 21፡7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3"/>የሱስ ደብረዘይት ጋይምድን ገቸንዘን ዶቅሶ ክት ዶቅድንካ ክታ ካርንካ ጎርስምድባብከስ ከታ ይንት ክደር Ꮊድሰኮ፥ “ኮና ሙዳ ሪና ማድንዳ Ꮊንተረ? የስታ Ꮊድንተንተኬ ፍጫሙደንታ በእንተታ ቃዉተና Ꮊራ?” ጋየረኮ ክትም ኦይሰኬ።<verse eid="MAT 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4"/>የሱሰረ፥ Ꮊየነረ ኤድ የም ኮተርዝዳክንግንዳ ካርስምከቴ! <verse eid="MAT 24:4"/><verse number="5" style="v" sid="MAT 24:5"/>በድንከስ እታ ክርስቶስቴ! ጋየረኮ እስታ ላምንካ Ꮊደኬ፥ በድ ኤድንከስመረ ኮተርስተረኬ። <verse eid="MAT 24:5"/><verse number="6" style="v" sid="MAT 24:6"/>ዳምንኬ ዳምታ ኬዘንም ኤሰርተረቴ፥ ኬና ሙዳ ቦድም ዝግዝድንካንታ Ꮊይገቀቴ፥ በእንተና ማቼ አክዬ። <verse eid="MAT 24:6"/><verse number="7" style="v" sid="MAT 24:7"/>ዎርሰና ዎርሰዘን፥ ባንችነረ ባንችንዘን አምተሬ፥ Ꮊክ Ꮊክ ካርዘን ዳቅከ ፍጨታ ጭጭ ማተረ። <verse eid="MAT 24:7"/><verse number="8" style="v" sid="MAT 24:8"/>ከነረ ሙዳ እችረት ማጠታ የድንታ ማተረ። <verse eid="MAT 24:8"/><verse number="9" style="v" sid="MAT 24:9"/>ኮታይካ ኤድንከስ ማጣካንታ ስክስት የም እምተረኬ፥ የም ደይስተረኬ፥ እስታ ላምንካንታ ጋይሶ ዎርሳ ሙደንታ ላመር ቦስምስባብከስ ማተረቴ።<note caller="-" style="x"><char style="xo" closed="false">24፡9 </char><char style="xt" closed="false"><ref loc="MAT 10:22">ማቶ. 10፡22</ref>። </char></note> <verse eid="MAT 24:9"/><verse number="10" style="v" sid="MAT 24:10"/>ኮታይካ በድንከስ ይንታ አሜንን ዛቅሰኮ ኮተርደኬ፥ ክክ ክክ ስክስት እምተረኬ፥ ኤድንከሰረ ክክ ክክ ግርተረኬ። <verse eid="MAT 24:10"/><verse number="11" style="v" sid="MAT 24:11"/>በድን ካርከካ ሳብዘንካ ኤሰራከክዶቆ ኬዝድባብከስ አምተረኬ፥ በድንከስመረ ኮተርስተረከ፥ <verse eid="MAT 24:11"/><verse number="12" style="v" sid="MAT 24:12"/>ዳቅልንከስታ በድምዘንካ አምሳንዳ በድ ኤድንከስታ ሶልመና ጋንተሬ። <verse eid="MAT 24:12"/><verse number="13" style="v" sid="MAT 24:13"/>በእንታ የለልታ ዳንዳእካ ዳቅድባብ ማቼ ኖ አቅተሬ።<note caller="-" style="x"><char style="xo" closed="false">24፡13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">ማቶ. 10፡22</ref>። </char></note> <verse eid="MAT 24:13"/><verse number="14" style="v" sid="MAT 24:14"/>ኤድ ሙደንካንታ ማርካ ማድንግንዳ፥ ኮና ሳብታ ባንችምታ ክላ ኬዘና ፍጫሙደንዘን ሳባክምዴ፥ ኮት Ꮊይካ በእንተና Ꮊዴ።<verse eid="MAT 24:14"/></para>
  <para style="s1">ቱና ማቻንዳ ዳቅል ሪም ተይᎺድንዳ</para>
  <para style="r">(<ref loc="MRK 13:14-23">ማር. 13፡14-23</ref>፤ <ref loc="LUK 21:20-24">ሉቃ. 21፡20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15"/>ሳብዘንካ ኤሰርሶ ኬዝባብ ዳንኤልታ ከዘንግንዳ ቱና ማቻንዳ ይንኤርዝድ ሪ ጭልምሳን ካርንዘን ዎእስንካ የ ሰጃንᎺይካ ናበብድባብ ክት ገቀራ!<note caller="-" style="x"><char style="xo" closed="false">24፡15 </char><char style="xt" closed="false"><ref loc="DAN 9:27">ዳን. 9፡27</ref>፤ <ref loc="DAN 11:31">11፡31</ref>፤ <ref loc="DAN 12:11">12፡11</ref>። </char></note> <verse eid="MAT 24:15"/><verse number="16" style="v" sid="MAT 24:16"/>ኮታይካ ይሁዳ ፍጨናር ዶቅድባብከስ ገቼንከዝደር Ꮊዛ። <verse eid="MAT 24:16"/><verse number="17" style="v" sid="MAT 24:17"/>ኤሄንታ የለንዘን ዶቅድባብ ይንታ ኤሄናርንካ ዋልቃ ሪ ተይካንታ Ꮊይ Ꮊንቼራ።<note caller="-" style="x"><char style="xo" closed="false">24፡17 </char><char style="xt" closed="false"><ref loc="LUK 17:31">ሉቃ. 17፡31</ref>። </char></note> <verse eid="MAT 24:17"/><verse number="18" style="v" sid="MAT 24:18"/>ዎን Ꮊማረረ ዶቆድባብ ይንታ አፍለንም ተይካንታ ይንታ ኤሪ Ꮊይማታ፥ <verse eid="MAT 24:18"/><verse number="19" style="v" sid="MAT 24:19"/>ኮታይካ ስርመንባብከስካንተኬ አም ጋእዝድባብከስም የኤ! <verse eid="MAT 24:19"/><verse number="20" style="v" sid="MAT 24:20"/>ኬዛርንካ ማቼ የንታ አጥምና በርግካ አነረ አይሁድንከስታ Ꮊዉስ ሰጨንካ ማተራክንግንዳ ምክስከቴ! <verse eid="MAT 24:20"/><verse number="21" style="v" sid="MAT 24:21"/>ኮታይካ ፍጫ ሙደና ፍዝምሳንደትዘንካ የድሶ ታካ የለልታ ይማክንዳ፥ ኦስ እረረ ኮትግንዳ ቦድሶ ይይምዳክንዳ፥ አንድር ማጣ ማተረ። <verse eid="MAT 24:21"/><verse number="22" style="v" sid="MAT 24:22"/>ከታኬና ሰጨንከስ ሳነካ በእዳከስናና ዋልቃ ኤድ ዎራ አቅተራክዶቆ፥ ኬዛርካ ማቼ እድምሳን ኤድንከስካንታ ጋይሶ ሳብ ከትኬና ሰጨንከስና ሳነካ በእድንግንዳ ይዴ። <verse eid="MAT 24:22"/><verse number="23" style="v" sid="MAT 24:23"/>ኮታይካ Ꮊየነረ ኤድ ይና፥ ክርስቶስ ካሪ ዶቅዴ! አነረ ኦኮታር ዶቅዴ! የንደር ጋይሴ Ꮊይ አሜነቴ። <verse eid="MAT 24:23"/><verse number="24" style="v" sid="MAT 24:24"/>ካርካ ክርስቶስንከሰኬ ሳብዘንካ ኤሰራከክዶቆ ካርከካ ኬዝድባብከስ አምደኬ፥ ከደር ማደስናና ሳብካንታ እድምስባብከስም ዎራ ኮተርስካንታ አንድር አተነከስምኬ በርእስዝድን ሪንከስም ሰችዝደኬ።<note caller="-" style="x"><char style="xo" closed="false">24፡24 </char><char style="xt" closed="false"><ref loc="DAN 12:1">ዳን. 12፡1</ref>፤ <ref loc="REV 7:14">ለም. 7፡14</ref>። </char></note> <verse eid="MAT 24:24"/><verse number="25" style="v" sid="MAT 24:25"/>“ይና ኬና ሪይንም ሙዳ እርናና የም ከዝትቴ፥<verse eid="MAT 24:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26"/>“ኮካንታ ‘ይና፥ ዴል ቆቸናር ዶቅዴ!’ የንደር ጋይዴ Ꮊይዉተቴ፥ ‘ይና አቻ ካርያር ዶቅዴ!’ የንደር ጋይዴ Ꮊይ አሜነቴ።<note caller="-" style="x"><char style="xo" closed="false">24፡26 </char><char style="xt" closed="false"><ref loc="LUK 17:23-24">ሉቃ. 17፡23-24</ref>። </char></note> <verse eid="MAT 24:26"/><verse number="27" style="v" sid="MAT 24:27"/>ዋልቅንት ጭለዘን ሮጵሶ Ꮊይታ ዉትንታርንካ Ꮊይታ አርድንታ የለልታ Ꮊፈርድንግንዳ፥ ኤድ ይንችንታ Ꮊድንተነረ ኮትኮግንዳ ማተረ። <verse eid="MAT 24:27"/><verse number="28" style="v" sid="MAT 24:28"/>ደእሳን ሪ ዶቅድን ካርዘን ድገንከስ ሳንምደኬ።<note caller="-" style="x"><char style="xo" closed="false">24፡28 </char><char style="xt" closed="false"><ref loc="LUK 17:37">ሉቃ. 17፡37</ref>። </char></note><verse eid="MAT 24:28"/></para>
  <para style="s1">ክርስቶሰታ ቃስትምስ Ꮊድንተና</para>
  <para style="r">(<ref loc="MRK 13:24-27">ማር. 13፡24-27</ref>፤ <ref loc="LUK 21:25-28">ሉቃ. 21፡25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29"/>“ከትኬና ማጣ ሰጨንከስታ ቡር ሳነካ Ꮊይና ኡምተረ፥ አርፈነረ ይንታ ሳክመንም ሳክሳየ፥ ቤዝንከሰረ ጭለዘንካ ዋችተረኬ፥ ጭለንከስተረ ዎልቀና ጭጭተሬ።<note caller="-" style="x"><char style="xo" closed="false">24፡29 </char><char style="xt" closed="false"><ref loc="ISA 13:10">ኢሳ. 13፡10</ref>፤ <ref loc="ISA 34:4">34፡4</ref>፤ <ref loc="EZK 32:7">ሕዝ. 32፡7</ref>፤ <ref loc="JOL 2:10">ኢዩ. 2፡10</ref>፥<ref loc="JOL 2:31">31</ref>፤ <ref loc="JOL 3:15">3፡15</ref>፤ <ref loc="REV 1:7">ለም. 1፡7</ref>፤ <ref loc="REV 6:12-13">6፡12-13</ref>፤ <ref loc="DAN 7:13">ዳን. 7፡13</ref>፤ <ref loc="ZEC 12:10-14">ዘካ. 12፡10-14</ref>። </char></note> <verse eid="MAT 24:29"/><verse number="30" style="v" sid="MAT 24:30"/>ኮተረ ቡር ኤድ ይንችታ ቃዉታ ጭለዘን ሰድምተረ፥ ኮታይካ ፍጫሙደንዘን ዶቅድን አጥርንከስ ኤፍተረኬ። አነረ ኤድ ይንች ዎልቀኬ አንድር ቦንቼካ ኡፔዘን ማትሶ Ꮊድንካ ክትም ሰተረኬ፥ <verse eid="MAT 24:30"/><verse number="31" style="v" sid="MAT 24:31"/>አንድር ፍቼታ ኡፍስ ኤስምዝድባብ ክታይንችንከስም ኖ ኦይተሬ፥ ከታ ኦይድ ፍጫሙደንታ ፍነንካ አይሰኮ ጭለታ ካንተዘንካ ካንታ የለልታ ዶቅድባብከስም ክትካንታ እድምስባብ ኤድንከስም ሳንዝደኬ” ኩንጋየሮ ከትካንታ ማስሴ።<verse eid="MAT 24:31"/></para>
  <para style="s1">በለስ Ꮊቀንታ ካምስ</para>
  <para style="r">(<ref loc="MRK 13:28-31">ማር. 13፡28-31</ref>፤ <ref loc="LUK 21:29-33">ሉቃ. 21፡29-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32"/>“ካምስንመረ በለስ Ꮊቀንዘንካ ኤስከቴ፥ ኮታ ግዝደና ፉርድንኬ ኮታ ቃምና ጮልድንካ፥ ኮታይካ Ꮊስን የልሳንደትም ኤዝደቴ። <verse eid="MAT 24:32"/><verse number="33" style="v" sid="MAT 24:33"/>ኮትኮግንደረ የታ ኮም ሙዳ ሰደቶ ኤድይንች Ꮊድንደታ ሰጨና የልሳንደትም ኤስከቴ። <verse eid="MAT 24:33"/><verse number="34" style="v" sid="MAT 24:34"/>ዶፈን የም ጋይድቴ፥ ኮና ሙዳ ቦድምተርን የለልታ ኮና አጥርና ስገዳክዬ። <verse eid="MAT 24:34"/><verse number="35" style="v" sid="MAT 24:35"/>ጭለኬ ፍጨካ ስገደኬ፥ እስታ ቃለና ማቼ ቦድሶ ስጋዬ”።<verse eid="MAT 24:35"/></para>
  <para style="s1">ጮይስ Ꮊድን ሰጨኬ ሳዓትንካ ኤስማዬ</para>
  <para style="r">(<ref loc="MRK 13:32-37">ማር. 13፡32-37</ref>፤ <ref loc="LUK 17:26-30">ሉቃ. 17፡26-30</ref>፥<ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36"/>“ኮትኮ ሰጨንተኬ ኮትኮ ሳዓትንታ ማቼ ሳብ ባቤንዘንካ አብ ጭላር ክታይንችንከስ ማቼረ፥ ይንችና ማቼረ Ꮊየሰነረ ኤሳዬ። <verse eid="MAT 24:36"/><verse number="37" style="v" sid="MAT 24:37"/>ኖህታ ስለናር ማቻንደትግንዳ ኤድ ይንች Ꮊድንደት Ꮊይከረ ኮትኮግንዳ ማተረ።<note caller="-" style="x"><char style="xo" closed="false">24፡37 </char><char style="xt" closed="false"><ref loc="GEN 6:5-8">ፍዝ. 6፡5-8</ref>። </char></note> <verse eid="MAT 24:37"/><verse number="38" style="v" sid="MAT 24:38"/>ኮት ስለናር፥ ካይዝድን ሎቀና Ꮊተርንደታ እር ኖሄረ ማርከብናር አርደዳን ሰጨን የለልታ ኤድንከስ እቸረኮ ዎጨረኮ፥ እንቸረኮ ይኤረኮ Ꮊቀኬ። <verse eid="MAT 24:38"/><verse number="39" style="v" sid="MAT 24:39"/>ካይዝድን ሎቀና Ꮊድሶ ሙደንመረ ካይስተርን የለልታ ኤሳከኬ፥ ኤድ ይንችታ Ꮊድንተና ኮትኮግንዳ ማተረ። <verse eid="MAT 24:39"/><verse number="40" style="v" sid="MAT 24:40"/>ኮታይካ ቃስተን ኤድንከስ ዎንዘን ማተረከ፥ ዋልቃባብ ተይምተሬ ቃስትምስና ነግተሬ። <verse eid="MAT 24:40"/><verse number="41" style="v" sid="MAT 24:41"/>ቃስተን ማነንከስ የካ ደይስን ደይስተረኬ፥ ዋልቀና ተይምተሬ፥ ቃስትምስና ነግተሬ።<verse eid="MAT 24:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42"/>“ይና የንታ ጮይስና Ꮊንታ ክት Ꮊዳናንከረ የ ኤዝዳክንካንታ ንግሶ ካርስከቴ። <verse eid="MAT 24:42"/><verse number="43" style="v" sid="MAT 24:43"/>ኬዛርንካ ማቼ ይና ኮም ኤስከቴ፥ ኤሄንባብ ሶይት Ꮊራ ሳዓትንዘን ድብና Ꮊድንደትም ይ ኤዝደስናና፥ ንግሶ ኖ ካርስተርዶቆ፥ ክታ ኤሄነረ ኮይምድንግንዳ ዛቅተራክዶቆ። <verse eid="MAT 24:43"/><verse number="44" style="v" sid="MAT 24:44"/>ኮትኮግንደረ ኤድይንች የ ገቀራክን ሳዓታር Ꮊድንካንታ ግግምሶ ዶእከቴ”።<note caller="-" style="x"><char style="xo" closed="false">24፡44 </char><char style="xt" closed="false"><ref loc="LUK 12:39-40">ሉቃ. 12፡39-40</ref>። </char></note><verse eid="MAT 24:44"/></para>
  <para style="s1">አመንምድባብተኬ አመንምዳክን ፍክስንባብታ ካምስ</para>
  <para style="r">(<ref loc="LUK 12:41-48">ሉቃ. 12፡41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45"/>“ይንታ ኤሀ ኤድንከስካንታ እችምን እምድንግንዳ፥ ክታ ማታ ቆልስባብ ይንታ ኤሀ ኤድንዘን ክት ዶርድባብ አሜንምስባብኬ ቡደካ ማችባብ ፍክስንባብ Ꮊይራ? <verse eid="MAT 24:45"/><verse number="46" style="v" sid="MAT 24:46"/>ክታ ማተን ቆልስባብ ᎺድንደትᎺይካ ኖኮና ፍክስንባብና ኩን ክት ይድንካ Ꮊፍሴ ኖ አንጅምስባቤ። <verse eid="MAT 24:46"/><verse number="47" style="v" sid="MAT 24:47"/>ዶፈን የም ጋይድቴ፥ ክትኮ ፍክስንባብም ክታ ማተንቆልስባብ ይንታ ርን ሙደንዘን ክትም ዶርዴ። <verse eid="MAT 24:47"/><verse number="48" style="v" sid="MAT 24:48"/>ኖኮና ዳቅል ፍክስንባብ ማቼ፥ ‘እስታ ማተን ቆልስባብ ታ ኖ Ꮊዳክዬ ጋምእዴ’ ጋይሶ ክት ገቀርሰኬ፥ <verse eid="MAT 24:48"/><verse number="49" style="v" sid="MAT 24:49"/>ይንታ ፍክስንታ ላኮይትንከስም ጉጵና ክት የጄ፥ ጎዝንባብከስካ ክክን ክት እቸኬ ክት ዎጬ፥ <verse eid="MAT 24:49"/><verse number="50" style="v" sid="MAT 24:50"/>ክትኮ ፍክስንባብታ ማታ ቆልስባብ ክት ካርሳክን ሰጨናርኬ ክት ኤሳክን ሳዓትንዘን ኖ Ꮊዴ፥ <verse eid="MAT 24:50"/><verse number="51" style="v" sid="MAT 24:51"/>ክትኮ ፍክስንባብም ክታ ማታ ቆልስባብና ክትም ዋጭዴ፥ ክታ እዋንነረ ኦትረንባብከስካ ክክን ማስተሬ፥ ኮታረረ ኤፍኬ አች ቅርጭካ ክትካንታ ማተሬ”።<verse eid="MAT 24:51"/></para>
  <chapter eid="MAT 24"/>
  <chapter number="25" style="c" sid="MAT 25"/>
  <para style="s1">ታማ ይንች አንጀንከስታ ካምስ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1"/>ኮታዘንከረ የሱስ፥ “ኮታይካ ጭላ ባንችምና ከታ ይንታ ዞጰን የድሰኮ፥ እንቸንባብም ሞካካንታ ዉተድባብ ታማ ይንች አንጀንከስም ካምዴ።<note caller="-" style="x"><char style="xo" closed="false">25፡1 </char><char style="xt" closed="false"><ref loc="LUK 12:35">ሉቃ. 12፡35</ref>። </char></note> <verse eid="MAT 25:1"/><verse number="2" style="v" sid="MAT 25:2"/>ከታርንከረ ዶንቅና ዳቸንከስ፥ ዶንቅና ኤጫ ማችባብከስ Ꮊቀኬ። <verse eid="MAT 25:2"/><verse number="3" style="v" sid="MAT 25:3"/>ዳቻ ማችባብ አንጀንከስ ከታ ይንታ ዞጰን የጅንከረ ዞጰንካንታ ማድን ስጥመካ ላምባ የዳከኬ። <verse eid="MAT 25:3"/><verse number="4" style="v" sid="MAT 25:4"/>ኤጫ ማችባብ ይንችን አንጀንከስ ማቼ ከታ ይንታ ዞጰንካ ክክን ስጥመካ ላምበንም ሪካ የታ Ꮊቀኬ፥ <verse eid="MAT 25:4"/><verse number="5" style="v" sid="MAT 25:5"/>እንቸንባበረ ጋምእሳንካንታ ከት ሙደንም ግንእስ የጅንካ ራቸኬ።<verse eid="MAT 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6"/>“ገልትገር ማድንካ ‘ይና እንቸንባብ Ꮊዴ! ዉትሰቶ ሞክት ክትም ተይከቴ!’ ጋይድን አዉል ኤስምሴ። <verse eid="MAT 25:6"/><verse number="7" style="v" sid="MAT 25:7"/>ኮታይካ ይንች አንጀንከስ ሙደና አምሰኮ ይንታ ዞጰን ግግሰኬ። <verse eid="MAT 25:7"/><verse number="8" style="v" sid="MAT 25:8"/>ዳቻ ይንች አንጀንከስ ማቼ ኤጨንባብከዝደር ዎንታ ዞጰና ድግካንታ ይድንኦል ‘ዋደቴ የንታ ላምበዘንካ ዎካንታ እምከቴ’ ከደር ጋይሰኬ።<verse eid="MAT 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9"/>“ኤጫ ይንች አንጀንከስ ማቼ ዎካንተከ የካንታ ማድን ላምባ ዎንደር ካዬ። ኮካንታ ሰንድን ካርያር አይሰቶ የንታ ማታ ካንታ ላምበን ሰንከቴ ጋየሮ ከትካንታ ማስሴ። <verse eid="MAT 25:9"/><verse number="10" style="v" sid="MAT 25:10"/>ዳቻ ማና ይንች አንጀንከስ፥ ላምበንም ሰንማካንታ ከት አይሳንደትካ እንቸንባብ Ꮊዴ። ግግምሶ Ꮊቅባብ ይንች አንጀንከሰረ እንቸንባብካ ክክን እሰንካንታ እችምን ግግስምሳን ኤሄናር አርደደኬ፥ ፍልተነረ ዝጭምሴ።<verse eid="MAT 25:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11"/>“ቡር ነግድባብ ይንች አንጀንከስ Ꮊድሰኮ፥ ‘የ ዎባቦ! የ ዎባቦ! ዋደ ፍልተንም ዎካንታ ፎችካ’ ጋይሰኬ። <verse eid="MAT 25:11"/><verse number="12" style="v" sid="MAT 25:12"/>ኖ ማቼ፥ ‘ዶፈን የም ጋይድቴ፥ እታ የም ኤዝዳክቴ!’ ጋየሮ ከትካንታ ማስሴ።<note caller="-" style="x"><char style="xo" closed="false">25፡12 </char><char style="xt" closed="false"><ref loc="LUK 13:25">ሉቃ. 13፡25</ref>። </char></note> <verse eid="MAT 25:12"/><verse number="13" style="v" sid="MAT 25:13"/>ኮካንታ ሰጨንምከ ሳዓትንም የ ኤዝዳክንኦል ንግሰቶ ካርስከቴ”። ኩን ከትም ጋይሴ።<verse eid="MAT 25:13"/></para>
  <para style="s1">ማኬን ፍክስንባብከስታ ካምስ</para>
  <para style="r">(<ref loc="LUK 19:11-27">ሉቃ. 19፡11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14"/>ኮታይካ ጭላ ባንችምናር አርድንተና ኮትኮግንዳ ማደ፥ ዋልቃ ኤች አብ ፍጫር አይድዮ ይንታ ፍክስንባብከስም ኤልሶ ይንታ ዶቅድን ሪን ከትካንታ እምስባብ ኤችንግንዴ።<note caller="-" style="x"><char style="xo" closed="false">25፡14 </char><char style="xt" closed="false"><ref loc="LUK 19:11-27">ሉቃ. 19፡11-27</ref>። </char></note> <verse eid="MAT 25:14"/><verse number="15" style="v" sid="MAT 25:15"/>ኖ ኤችነረ ዋልቃ ዋልቀንከስካንታ ከታ እምንተንግንዳ ካዝድዮ፥ ዋልቃባብካንታ ዶንቅ ጣገራ ብራ ዋልቀባብካንታ ቃስቴን ጣገራ ብራ፥ አና ዋልቃባብካንተረ ዋልቃ ጣገራ ብራ እምስንደተኬ ሳነካ አብ ፍጫር አይሴ። <verse eid="MAT 25:15"/><verse number="16" style="v" sid="MAT 25:16"/>ዶንቅ ጣገራ ብረንም ተይባብ ሳነካ አይሶ ብረንካ ዛልአ የድሶ ዶንቅንዘን ዶንቅ ጣገራ ብራ አእሴ። <verse eid="MAT 25:16"/><verse number="17" style="v" sid="MAT 25:17"/>ቃስቴን ጣገራ ብረንም ተይባበረ ኮትኮግንደረ አብ ቃስቴን ጣገራ ብራ አእሴ። <verse eid="MAT 25:17"/><verse number="18" style="v" sid="MAT 25:18"/>ዋልቃ ጣገራ ብረንም ተይባብ ማቼ አይስንደትኬ ፍጫ ኮይሶ ይንታ ማታ ቆልስባብታ ብረንም አቼ።<verse eid="MAT 25:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19"/>በድ ሰጨታ ቡር ከትኬ ፍክስንባብከስታ ማተን ቆልስባብ Ꮊድሶ ይንታ ፍክስንባብከስካ ክክን ብረካ Ꮊራ ፍክስምሳናንከረ ከዝም የጄ። <verse eid="MAT 25:19"/><verse number="20" style="v" sid="MAT 25:20"/>ዶንቅ ጣገራ ብረንም ተይባብ ፍክስንባበረ ይንታ ማተን ቆልስባብደር Ꮊድሶ ዶንቅ ጣገራ ብረን ክትካንታ እምሶ የባቦ! ዶንቅ ጣገራ ብራ እካንታ እምተይናና፥ ኮሰቼ! አብ ዶንቅ ጣገራ ብራ አእስትቴ! ጋይሴ። <verse eid="MAT 25:20"/><verse number="21" style="v" sid="MAT 25:21"/>ክታ ማተን ቆልስባበረ ኡርማ ይሳዬ፥ የና አመንምሳባብ ላቅም ፍክስንባብ! ቶክም ሪካ አሜንምስባብ ማትሰዮ የስ Ꮊፈርሳንካንታ በድ ሪንከዘን የስም ዶርድቴ፥ ኮሬ የስታ ማተን ቆልስባብታ ጉርምንካ ጉርምካንታ አርድካ! ክትም ጋይሴ። <verse eid="MAT 25:21"/><verse number="22" style="v" sid="MAT 25:22"/>ቃስተን ጣገራ ብረን ተይባብ Ꮊድሶ የ ዎባቦ! እካንታ ቃስተን ጣገራ ብራ እምታይናና፥ አብ ቃስተን ጣገራ ብራ አእስትቴ! ጋይሴ። <verse eid="MAT 25:22"/><verse number="23" style="v" sid="MAT 25:23"/>ክታ ማተን ቆልስባበረ ኡርመ! የና አሜንምስባብከ ኡርማ ፍክስንባብ ቶክም ርንካ አሜንምስባብ ማትሰዮ የስ Ꮊፈርሳንካንታ በድ ርንከስታዘን የስም ዶርድቴ፥ ኮሬ የስታ ማታ ቆልስባብታ ጉርምንካ ጉርምካንታ አርድካ! ክትም ጋይሴ። <verse eid="MAT 25:23"/><verse number="24" style="v" sid="MAT 25:24"/>ዋልቃ ጣገራ ብረን ተይባበረ Ꮊድሶ፥ የ ዎባቦ! የስ ማሳክንደታርንካ ስግድባብ፥ የስ ይጫክንደታርንካ ሳንዝድባብ፥ ጋርዛ ኤድ የስ ማቻንደትም ኤዝድቴ፥ <verse eid="MAT 25:24"/><verse number="25" style="v" sid="MAT 25:25"/>ኮካንታ ጳስስቶ አይስቶ የስታ ጣገራ ብረን ፍጨናር አቻቴ፥ ኮንሴ የስታ ጣገራ ብረና! ክደር ጋይሴ። <verse eid="MAT 25:25"/><verse number="26" style="v" sid="MAT 25:26"/>ክታ ማተን ቆልስባብ ማቼ፥ የና ዳቅልኬ ቦዛ ፍክስንባብ! እ ማሳክንደታርንካ እ ስክድንደትም እ ይጫክንደታርንካ እ ሳንዝድንደትም የስ ኤዝድንዳ ማቼ፥ <verse eid="MAT 25:26"/><verse number="27" style="v" sid="MAT 25:27"/>እስታ ብረንም ዛለን ዛልድባብከስካንታ እማ የስም ዝግዝዳዶቆ፥ እተረ እ Ꮊዳንደትካ እስታ ብረንም አጥመካ ክክን ተይድትዶቆ። <verse eid="MAT 25:27"/><verse number="28" style="v" sid="MAT 25:28"/>ኮካንታ ብረንም ክታዘንካ ተይሰቶ ታማ ጣገራ ብራ ዶቅድባብካንታ እምከቴ። <verse eid="MAT 25:28"/><verse number="29" style="v" sid="MAT 25:29"/>ዶቅድባብካንታ ሙደነረ ጉጅምዴ ክትካንተረ በተሬ፥ ካየንባብከዘንካ ማቼ ና ዶቅድናዳ ዎራ ክታዘንካ ተይምተሬ።<note caller="-" style="x"><char style="xo" closed="false">25፡29 </char><char style="xt" closed="false"><ref loc="MAT 12:12">ማቶ. 12፡12</ref>፤ <ref loc="MRK 4:25">ማር. 4፡25</ref>፤ <ref loc="LUK 8:18">ሉቃ. 8፡18</ref>። </char></note> <verse eid="MAT 25:29"/><verse number="30" style="v" sid="MAT 25:30"/>ክትኮ መይዳክባብ ፍክስንባብም ማቼ ማል ዶቅድን ግልድድ ኡምናር ክትም ዉችተቶ ኦይትከቴ፥ ኮታረረ ኤፍከ አች ቅርጭካ ክትካንታ ማተረ ኩን ክደር ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">25፡30 </char><char style="xt" closed="false"><ref loc="MAT 8:12">ማቶ. 8፡12</ref>፤ <ref loc="MAT 22:13">22፡13</ref>፤ <ref loc="LUK 13:28">ሉቃ. 13፡28</ref>። </char></note><verse eid="MAT 25:30"/></para>
  <para style="s1">ፍጫሙደንታ በእንታ ፍርደና</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31"/>ኤደት ይንች ይንታ ቦንቸካ ክት ᎺድንᎺይካ ክትካ ክክን ሳብካንታ ፋስምስባብ ክታይንችንከስ ሙዳ፥ ኮታይካ ይንታ ቦንችምሳን ባንችንከስታ ዶቅንት ጎንገንዘን ዶቅተሬ፥<note caller="-" style="x"><char style="xo" closed="false">25፡31 </char><char style="xt" closed="false"><ref loc="MAT 19:28">ማቶ. 19፡28</ref>። </char></note> <verse eid="MAT 25:31"/><verse number="32" style="v" sid="MAT 25:32"/>ዎርሰንከስ ሙዳ ክታ እር ሳንምደኬ፥ ግስመንባብ ቆልንከስም ደርትንከዘንካ ፋዝድንደትግንዳ ኖየረ ዎርሰንከስም ዋልቀን አብንከዘንካ ኖ ፋስተሬ። <verse eid="MAT 25:32"/><verse number="33" style="v" sid="MAT 25:33"/>ጭልንከስም ይንታ ምዝንዘን፥ ጎመንባብከስም ይንታ ከችንዘን ከትም ዎይስተረ። <verse eid="MAT 25:33"/><verse number="34" style="v" sid="MAT 25:34"/>ኮታይካ ባንችና ይንታ ምዝንዘን ጎካ ዶቅድባብከስም ኩን ከትም ጋይተሬ፥ የታ እስታ ባቤና የም አንጅባብከሶ! ኮረቴ! ፍጫ ሙደና ፍዝምሳንዘንካ የድሶ የካንታ ግክስምሳንደትም ባንችምን ተይከቴ! <verse eid="MAT 25:34"/><verse number="35" style="v" sid="MAT 25:35"/>እ ዳቀርስንካ እም እችስተቴ፥ እ ዎቸርስንካ እም ዎእስተቴ፥ ሶች ማትስቶ እ Ꮊድንካ እም ሞክተቴ <verse eid="MAT 25:35"/><verse number="36" style="v" sid="MAT 25:36"/>ዘነካ እ ማችንካ እም ቆፍስተቴ፥ እ ሰቀርስንካ እም ሰቅስተቴ፥ እ ዞከርስንካ እም ኦይስተቴ። <verse eid="MAT 25:36"/><verse number="37" style="v" sid="MAT 25:37"/>ጭልንከስ ኩን ጋይሰኮ ክትካንታ ማዝደከ፥ የ ዎባቦ፥ Ꮊንታ የስ ዳቀርስንካ ሰድሶንት የስም እችሳራ? Ꮊንታ የስ ዎቸርስንካ ሰድሶንት የስም ዎእሳራ? <verse eid="MAT 25:37"/><verse number="38" style="v" sid="MAT 25:38"/>Ꮊንቶንት የስ ሶች ማትሶ Ꮊድንካ የስም ሞክሳረ? Ꮊንቶንት ዘነካ የስ ማችንካ ሰድሶ የስም ቆፍሳራ? <verse eid="MAT 25:38"/><verse number="39" style="v" sid="MAT 25:39"/>Ꮊንቶንት የስ ሰቀርስንካ አነረ የስ ዞከርስንካ የስም ሰድሶ Ꮊድሶንት ኦይሳራ? ጋይተረክኬ። <verse eid="MAT 25:39"/><verse number="40" style="v" sid="MAT 25:40"/>ባንችነረ ዶፈን የም ጋይድቴ ከትኬና እስታ እስመንከሳርንካ መራ ማችባብ ዋልቃባብካንታ ዎራ የ ይሳንዳ ሙዳ እካንታ ይሰቴ! ጋየሮ ከትካንታ ማስተሬ።<verse eid="MAT 25:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41"/>ኮታ ቡር ክታ ከችንዘንጎካ ዶቅድባብከስመረ፥ የታ ባድምስባብከስ! እዘንካ ኦስ ጎተርከቴ! ዳብሎስካንተኬ ክታ ካርንካ ጎርስምድን ክታይንችንካንታ ግግስምሳን ስለንክንደታ ኖሄናር አይከቴ! <verse eid="MAT 25:41"/><verse number="42" style="v" sid="MAT 25:42"/>እ ዳቀርስንካ እም እቻከቴ፥ እ ዎቸርስንካ እም ዎእሳከቴ። <verse eid="MAT 25:42"/><verse number="43" style="v" sid="MAT 25:43"/>ሶች ማትስቶ እ Ꮊድንካ እም ሞካከቴ፥ ዘነካ እ ማችንካ ሰድሰቶ እም ቆፍሳከቴ፥ እ ሰቀርስንከኬ ዞከርስንካ እም ኦይሳከቴ፥ ኩን ከትም ጋይተሬ።<verse eid="MAT 25:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44"/>ከተረ የ ዎባቦ፥ የስ ዳቀርስንካ አነረ የስ ዎቸርስንካ፥ ሶች የስ ማችንካ አነረ ዘነካ የስ ማችንካ፥ የስ ሰቀርስንካ አነረ የስ ዞከርስንካ ሰድሶቶ Ꮊንቶንት አለንም የስም አልክሳ ነገዳራ? ኩን ጋየረኮ ክትካንታ ማስተረኬ። <verse eid="MAT 25:44"/><verse number="45" style="v" sid="MAT 25:45"/>ባንችነረ ዶፈን የም ጋይድቴ፥ ከትኬና መራ ማችባብ ዋልቃባብካንታ ዎራ የ ይያክንዳ ሙዳ እካንተረ የ ይያክንግንዴ ከትም ጋይተሬ።<verse eid="MAT 25:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46"/>“ኮካንታ ከታኬና ስለንክንደታ ዋጭናር ከት አይድንካ፥ ጭልንከስ ማቼ ስለንካ ዶቅንትናር አይተረኬ”።<note caller="-" style="x"><char style="xo" closed="false">25፡46 </char><char style="xt" closed="false"><ref loc="DAN 12:2">ዳን. 12፡2</ref>። </char></note><verse eid="MAT 25:46"/></para>
  <chapter eid="MAT 25"/>
  <chapter number="26" style="c" sid="MAT 26"/>
  <para style="s1">አይሁድንከስ የሱሰም ደይሳካንታ ከት ይሳን ዙዝም</para>
  <para style="r">(<ref loc="MRK 14:1-2">ማር. 14፡1-2</ref>፤ <ref loc="LUK 22:1-2">ሉቃ. 22፡1-2</ref>፤ <ref loc="JHN 11:45-53">ዮሀ. 11፡45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1"/>የሱስ ኬና ርንከስም ኬዝት ይ በይሳንደታ ቡር ይንታካርንካ ጎርስምድባብከስም፥ <verse eid="MAT 26:1"/><verse number="2" style="v" sid="MAT 26:2"/>“ቃስተን ሰጨታ ቡር ፋስጋ ማድንደትም የታ ኤዝደቴ፥ ኤድ ይንች ሮክርካንታ ስክስምት እምምተሬ” ኩን ከደር ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">26፡2 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">ዉት. 12፡1-27</ref>። </char></note><verse eid="MAT 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3"/>ኮትኮᎺይካ ቀሰንም ገችዝድባብከስኬ ዎርሰናርንካ ጋልተንከስ ቀሰንከስም ገችዝድባብታ ጋስናር ሳንምሰኬ። <verse eid="MAT 26:3"/><verse number="4" style="v" sid="MAT 26:4"/>ኮታረረ የሱሰም ጩበካ የድካንተኬ ደይሳካንታ ዞርምሰኬ። <verse eid="MAT 26:4"/><verse number="5" style="v" sid="MAT 26:5"/>ኬዛርንካ ማቼ “ዎርሰንከስታ ዎክያር አዉል አምዳክንግንዳ ባአል ሰጨንካ Ꮊይማታ” ጋይሰኬ።<verse eid="MAT 26:5"/></para>
  <para style="s1">የሱሰም ዎዝድንደትካ ሳይሳን ኤተንንጎካ</para>
  <para style="r">(<ref loc="MRK 14:3-9">ማር. 14፡3-9</ref>፤ <ref loc="JHN 12:1-8">ዮሀ. 12፡1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6"/>የሱሰረ ብታንያ ፍጨናር እጳ ሰቅምካ Ꮊቅባብ ስምኦነታ ኤር Ꮊቄ። <verse eid="MAT 26:6"/><verse number="7" style="v" sid="MAT 26:7"/>ኮታረረ የሱስ እችም ክት እቻዶቅድንካ ዋልቃ ኤተን አንድር ስንጋ ማቻን ዎዝድንደትም አልባስጥሮስ ብልቃትካ የድሶ ክደር Ꮊድስንደትኬ፥ ዎዝድንደትመረ ክታ ማተንዘን ዉልእሴ።<note caller="-" style="x"><char style="xo" closed="false">26፡7 </char><char style="xt" closed="false"><ref loc="LUK 7:37-38">ሉቃ. 7፡37-38</ref>። </char></note> <verse eid="MAT 26:7"/><verse number="8" style="v" sid="MAT 26:8"/>ክታ ካርንካ ጎርስምድባብከስ ኮም ሰድሰኮ ዋጨሮ፥ “ኮም ዎዝድንደትም Ꮊረተረ ዉች ባችና? <verse eid="MAT 26:8"/><verse number="9" style="v" sid="MAT 26:9"/>ኮና ዎዝድንደና በድ ብራ ሰንምሶ ሪ ካየንባብከስካንታ እምም ዝግዝዳዶቆ!” ኩን ጋይሰኬ። <verse eid="MAT 26:9"/><verse number="10" style="v" sid="MAT 26:10"/>የሱሰረ ኮም ከታ ጋይተንም ኤስሶ፥ “ኮትኮም ኤተንን Ꮊረተንት ማእዝዳ? ና እካንታ ኡርማ ር ይቴ፥ <verse eid="MAT 26:10"/><verse number="11" style="v" sid="MAT 26:11"/>ሪን ካየንባብከስ ሙዳᎺይካ የንካ ክክነከ እታ ማቼ ሙዳᎺይካ የንካ ክክን ካሪ ዶቃይቴ።<note caller="-" style="x"><char style="xo" closed="false">26፡11 </char><char style="xt" closed="false"><ref loc="DEU 15:11">ካሪ. 15፡11</ref>። </char></note> <verse eid="MAT 26:11"/><verse number="12" style="v" sid="MAT 26:12"/>ና ኮም ዎዝድንደትም እስታዘን ኮታ ዉልእና እም ዱክካንታ ኮት ግግሳንዴ። <verse eid="MAT 26:12"/><verse number="13" style="v" sid="MAT 26:13"/>ዶፈን የም ጋይድቴ ኮና ፍጫሙደንዘን ክላ ኬዘና ሳባክምድን Ꮊምን ካርዘነረ ኮና ኮት ይሳንዳ ኤድ ገቀርተርንግንዳ ኮትካንታ ከዝምተሬ” ኩን ከደር ጋይሴ።<verse eid="MAT 26:13"/></para>
  <para style="s1">ይሁዳ የሱሰም ስክስት እምካንታ ክታ ኤእና</para>
  <para style="r">(<ref loc="MRK 14:10-11">ማር. 14፡10-11</ref>፤ <ref loc="LUK 22:3-6">ሉቃ. 22፡3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14"/>ኮትኮᎺይካ ታሜከ ቃስተንናርንካ ዋልቀና አስቆሮንት ይሁዳ ቀሰንከስታ ገችንባብከዝደር አይሶ፥ <verse eid="MAT 26:14"/><verse number="15" style="v" sid="MAT 26:15"/>“የሱሰም ስክስት እ የካንታ እምሴ Ꮊረንት እምተራ?” ኖ ጋይሴ። ከተረ ቦንደከ ታማ ብራ ፋይት እምሰኬ።<note caller="-" style="x"><char style="xo" closed="false">26፡15 </char><char style="xt" closed="false"><ref loc="ZEC 11:12">ዘካ. 11፡12</ref>። </char></note> <verse eid="MAT 26:15"/><verse number="16" style="v" sid="MAT 26:16"/>ኖየረ ኮትኮ ሳዓተንዘንካ የድሶ የሱሰም ስክስት ይ እምድንደታ ሰጫ ዝግድ Ꮊቄ።<verse eid="MAT 26:16"/></para>
  <para style="s1">የሱስ ፋስገንታ ሶይት እችምን ክታ እችና</para>
  <para style="r">(<ref loc="MRK 14:12-21">ማር. 14፡12-21</ref>፤ <ref loc="LUK 22:7-14">ሉቃ. 22፡7-14</ref>፥<ref loc="LUK 22:21-23">21-23</ref>፤ <ref loc="JHN 13:21-30">ዮሀ. 13፡21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17"/>ባይስ ባአልንታ እሪ ሰጨንካ ክታ ካርንካ ጎርስምድባብከስ የሱሰደር Ꮊድሰኮ፥ “ፋስገንታ ሶይት እችምን Ꮊብር ዎ የስካንታ ግግዝድንግንደስ ዝግዳ?” ጋየረኮ ክትም ኦይሰኬ። <verse eid="MAT 26:17"/><verse number="18" style="v" sid="MAT 26:18"/>ኖየረ፥ “ኦስ ካተመናር የ አርድንካ የᎺብድን ኤችንታ ኤሪ አይሰቶ ‘ኤስስንባብ እስታ ሰጨና የልሳንካንታ እስታ ካርንካ ጎርስምድባብከስካ ክክን ፋስጋ ባአልንታ ሶይት እችምን እ እጅድንዳ የስታ ኤር ኖ ጋይዴ’ ክደረ ጋይከቴ” ኖ ጋይሴ። <verse eid="MAT 26:18"/><verse number="19" style="v" sid="MAT 26:19"/>ክታ ካርንካ ጎርስምድባብከሰረ የሱስ ከትም ክትሳንግንዳ ፋስገንተረ ሶይት እችምን ግክሰኬ።<verse eid="MAT 26:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20"/>ፍጨና ሶይቻንደትከረ የሱስ ታመከ ቃስተን ክታ ካርንካ ጎርስምድባብከስካ ክክን እችምካንታ ዶቅሰኬ። <verse eid="MAT 26:20"/><verse number="21" style="v" sid="MAT 26:21"/>ከት እጅድንከረ፥ የሱስ “ዶፈን የም ጋይድቴ፥ የንታ ዎክያርንካ ዋልቀና እም ስክስት እምተሬ” ኖ ጋይሴ።<verse eid="MAT 26:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22"/>ክታ ካርንካ ጎርስምድባብከሰረ ኮትኮ ከዘነካ አንድር ሞርእሰኮ፥ ዋልቃ ዋልቀንከስ የ ጮይስዮ፥ “እታ ማትትዳቶ?” ጋየረኮ ክትም ኦይስ የጀኬ። <verse eid="MAT 26:22"/><verse number="23" style="v" sid="MAT 26:23"/>የሱሰረ፥ “እም ስክስት እምድባብ እንካ ክክን ይንታ አንንም ጋበትናር ኦይችባቤ።<note caller="-" style="x"><char style="xo" closed="false">26፡23 </char><char style="xt" closed="false"><ref loc="PSA 41:9">የቺ 41፡9</ref>። </char></note> <verse eid="MAT 26:23"/><verse number="24" style="v" sid="MAT 26:24"/>ኤድ ይንች ክትጎካ ጭል ማጻፍናር ጻፍምሳንደትግንዳ ኖ ደእዴ፥ ኬዛርንካ ማቸ ኤድ ይንችንም ስክስት እምድባብ ኤችን ክትካንታ የኤ! ኖኮና ኤችና አጥምክሳ ክት ነገደስናና ኡርዳዶቆ።” <verse eid="MAT 26:24"/><verse number="25" style="v" sid="MAT 26:25"/>ስክስት እምድባብ ይሁደረ፥ “የ ኤስስንባቦ! እታ ማትትዳቶ?” ኖ ጋይሴ። የሱሰረ፥ “የስ ጋይሳንግንዴ” ክደር ጋይሴ።<verse eid="MAT 26:25"/></para>
  <para style="s1">የሱሰታ ደእንም ገቀርዝድን እችም</para>
  <para style="r">(<ref loc="MRK 14:22-26">ማር. 14፡22-26</ref>፤ <ref loc="LUK 22:15-23">ሉቃ. 22፡15-23</ref>፤ <ref loc="1CO 11:23-25">1 ቆሮ. 11፡23-25</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26"/>ከት እቻዶቅድንከረ የሱስ ባይስንም አምስሶ አንጄ፥ አስተረ ይንታ ካርንካ ጎርስምድባብከስካንታ “ይንከቴ እችከቴ ኮና እስታ ዋሄ” ጋይሶ ከትካንታ እምሴ።<verse eid="MAT 26:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27"/>ኮታዘንከረ ዎጭምን ኡፍተንካ አምስትዮ ሳብም ይ ጋለቻንደታ ቡር፥ “የታ ሙደነረ ኮትኮ ኡፍተናርንካ ዎጭከቴ፥ <verse eid="MAT 26:27"/><verse number="28" style="v" sid="MAT 26:28"/>ናኮና በድንከስካንታ ከታ ጎመን ነጋ ጋይካንታ ዉልእምድንዳ ክላ ጫቀን መያ ማዝድንዳ እስታ ማቀስኔ፥<note caller="-" style="x"><char style="xo" closed="false">26፡28 </char><char style="xt" closed="false"><ref loc="EXO 24:8">ዉት. 24፡8</ref>፤ <ref loc="JER 31:31-34">ኤር. 31፡31-34</ref>። </char></note> <verse eid="MAT 26:28"/><verse number="29" style="v" sid="MAT 26:29"/>እስታ ባቤንታ ባንችምናር ክላ ዎይን ዎጭምን የንካ ክክን እ ዎጭተርን ሰጨን የለልታ ይና ኮዘንካ ኦስ ዎይን ዎጭምን አናካርንካ ዎጭዳክቴ” ኩንጋየሮ ከትካንታ እምሴ። <verse eid="MAT 26:29"/><verse number="30" style="v" sid="MAT 26:30"/>ኮታዘንከረ የችንም የችሰኮ ደብረዛይት ገቼንዘን ዉተደኬ።<verse eid="MAT 26:30"/></para>
  <para style="s1">ጴጥሮስ ካድንደትም የሱስ እርምሶ ኬዛንዳ</para>
  <para style="r">(<ref loc="MRK 14:27-31">ማር. 14፡27-31</ref>፤ <ref loc="LUK 22:31-34">ሉቃ. 22፡31-34</ref>፤ <ref loc="JHN 13:36-38">ዮሀ. 13፡36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31"/>ኮትᎺይካ የሱስ፥ ይንታ ካርንካ ጎርስምድባብከስም፥ “ ‘ግስመንባብም ጉጵድቴ፥ ዉዳ ቆልንከሰረ ይጭምደኬ’ ጋይምሶ ጭል ማጻፍናር ጻፍምሳንካንታ ኮ ሶይትናር የታ ሙደና እም ካተረቴ።<note caller="-" style="x"><char style="xo" closed="false">26፡31 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">ዘካ. 13፡7</ref>። </char></note> <verse eid="MAT 26:31"/><verse number="32" style="v" sid="MAT 26:32"/>ኬዛርካ ማቸ ደእያርንካ እ አምሳንደታ ቡር ገሊላ ፍጨናር የንዘንካ እርምስቶ አይድቴ” ኩን ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">26፡32 </char><char style="xt" closed="false"><ref loc="MAT 28:16">ማቶ. 28፡16</ref>። </char></note><verse eid="MAT 26:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33"/>ኮትᎺይካ ጴጥሮስ፥ “አብንከስ ሙዳ የስም ካጀረ ዎራ እታ ቦድሶ የስም ካዳይቴ!” ጋይሶ ኬዜ። <verse eid="MAT 26:33"/><verse number="34" style="v" sid="MAT 26:34"/>የሱሰረ “ዶፈን የስም ጋይድቴ፥ ታካ ሶይትን ኮታር ባቻ ቅቅተርንደታ እር የና ማከን ዱት እም ካተራዬ” ክትም ጋይሴ። <verse eid="MAT 26:34"/><verse number="35" style="v" sid="MAT 26:35"/>ጴጥሮስ ማቼ “የስካ ክክን ደእ እም ዝክሰረ ዎራ ደእድት ዳት ቦድሶ የስም ካዳይቴ!” ክደር ጋይሴ። ነግድባብ ክታ ካርንካ ጎርስምድባብከሰረ ሙደና ኮትግንዳ ጋይድ Ꮊቀኬ።<verse eid="MAT 26:35"/></para>
  <para style="s1">ገተሰማን ጋይምድን ካርዘን የሱሰታ ምክስና</para>
  <para style="r">(<ref loc="MRK 14:32-42">ማር. 14፡32-42</ref>፤ <ref loc="LUK 22:39-46">ሉቃ. 22፡39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36"/>ኮታ ቡር የሱስ ይንታ ካርንካ ጎርስምድባብከስካ ክክን ገተሰማን ጋይምድን ካርናር አይሴ፥ ኮታረረ ከታ ይ የልሳንግንዳ የሱስ ይንታ ካርንካ ጎርስምድባብከስም፥ “እታ ኦኮታር እ ምግዝድንካ የታ ካሪ ዶእከቴ” ከትም ጋይሴ። <verse eid="MAT 26:36"/><verse number="37" style="v" sid="MAT 26:37"/>ይንካ ክክን ጴጥሮስምከ ዛብዶሰታ ይንች ቃስተንን ጎርስሶ አይሴ፥ ሞርእከ ማጥረረ የጄ። <verse eid="MAT 26:37"/><verse number="38" style="v" sid="MAT 26:38"/>ኩነረ ከትም ጋይሴ፥ “እስታ ሰንፔና ደእ የለልታ አንድር ሞርእሴ፥ የታ ካሪ ዶእከቴ፥ ንግዝባብ ማትከቴ።” <verse eid="MAT 26:38"/><verse number="39" style="v" sid="MAT 26:39"/>ከታዘንካ ቶክምካ ጎተርሶ፥ ፍጨዘን ይንታ ባለንካ ጉፕንጋይሶ፥ “እስታ ባቤኖ! የዝደር ማድንዳ ማቼ ኮና ማጠታ ኡፕተና እዘንካ ስጋ! ኬዛርካ ማቼ የስታ ጋይታ ማታጋካዳት እስታ ጋይታ Ꮊይማታ” ኩን ጋይሶ ምክሴ።<verse eid="MAT 26:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40"/>ኮታ ቡር ይንታ ካርንካ ጎርስት ይ አይስባብ ማከንንደር ማትዮ ክት Ꮊድንካ ራትሶ ከትዶቅድንካ ከትም Ꮊፍሴ፥ ኮካንታ፥ ጴጥሮስም፥ “እንካ ክክን ዋልቃ ሳዓትካንታ ዎራ ንግሶ ዳቅካንታ ማታከቴ? <verse eid="MAT 26:40"/><verse number="41" style="v" sid="MAT 26:41"/>ጰጨናር የ አርተራክንግንዳ ንግሶ ምክስከቴ፥ የንታ አያንና ግግምቴ፥ የንታ ዋሄና ማቼ ጋፍሳንዴ” ኩን ከትም ጋይሴ።<verse eid="MAT 26:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42"/>አናካርንከረ የሱስ ቃስትምስ ዱት ከታዘንካ ጎተርሶ አይስንደትከ “እስታ ባበኖ! ኮና ማጠንታ ኡፕተና እ ዎጫክናና ስገዳክንዳ ኮት ማቼ የስታ ጋይተና ማታ” ጋየሮ ምክሴ። <verse eid="MAT 26:42"/><verse number="43" style="v" sid="MAT 26:43"/>አነተረ ይንታ ካርንካ ጎርስምድባብከዝደር ማት ክት Ꮊድንካ ግንእስ ከትም የጅንካ ከት ራትሶ ዶቅድንካ ከትም Ꮊፈሴ።<verse eid="MAT 26:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 26:44"/>አናካርንካ ከትም ዛቅሶ አይስንደትከ እር ይ ምክሳን ምክስን ኮትም ማክምስ ዱት ምክሴ። <verse eid="MAT 26:44"/><verse number="45" style="v" sid="MAT 26:45"/>ኮታዘንከረ ይንታ ካርንካ ጎርስምድባብከዝደር ማትዮ Ꮊድስንደትኬ፥ “ታየረ አክ ራትዘንከ Ꮊዉስ ዘነንት ዶቅዶ? ይና ኤድ ይንች ጎመንባብከስታ አንያር ስክስምት እምምድንደታ ሳዓትና ቅንችቴ፥ <verse eid="MAT 26:45"/><verse number="46" style="v" sid="MAT 26:46"/>አምሶ ዎም ሙከቴ! ይና ስክስት እም እምድባብ Ꮊድሶ ቅንችቴ!” ኩን ከደር ጋይሴ።<verse eid="MAT 26:46"/></para>
  <para style="s1">የሱስ ስክስምት እምምንኬ ክታ የድምና</para>
  <para style="r">(<ref loc="MRK 14:43-50">ማር. 14፡43-50</ref>፤ <ref loc="LUK 22:47-53">ሉቃ. 22፡47-53</ref>፤ <ref loc="JHN 18:3-12">ዮሀ. 18፡3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47"/>የሱስ አክ ኬዘዜን ክት ዶቅድንካ ይና ታመከ ቃስተን ክታ ካርንካ ጎርስምድባብከሳርንካ ዋልቀና ኖ ይሁዳ Ꮊዴ፥ ከትከረ ክክን ማሰኬ ጉፈካ የጅባብ በድ ኤድንከስ Ꮊደኬ፥ ከተረ ቀሰንከስም ገችዝድባብከዘንኬ ዎርሰንከስታ ጋልተንከዘንካ Ꮊድባብከሰኬ። <verse eid="MAT 26:47"/><verse number="48" style="v" sid="MAT 26:48"/>የሱሰም ስክስት እምድባብ ይሁደረ ኤድንከስካንታ “የ ዝግድባብ እ ክትም ሶንቅድባብ ማቻንካንታ ክትም የድከቴ” ጋይሶ ከትካንታ ቃዉታ ከዝታ Ꮊቄ። <verse eid="MAT 26:48"/><verse number="49" style="v" sid="MAT 26:49"/>ይሁደረ ሳነካ Ꮊድሶ የሱሰደር የልሶ “ኤስስንባቦ! አቦ የና ኡርሞ!” ጋይሶ ክትም ሶንቅሴ።<verse eid="MAT 26:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50"/>የሱሰረ “እስታ ላኮይትኖ! ይና የስ Ꮊዳንደትም ቦድካ” ክትም ጋይሴ፥ ኮታዘንከረ ኤድንከስ የሱሰደር Ꮊድሶ ክትም የጀኬ። <verse eid="MAT 26:50"/><verse number="51" style="v" sid="MAT 26:51"/>ኮት ሳዓትንዘን የሱሰካ ክክን Ꮊቅባብከሳርንካ ዋልቀና አንን ይንታ አምስሶ ማሰን ጎችትዮ ቀሰንከስም ገችዝድባብታ ፍክስንባብታ ቃምን ተቼ። <verse eid="MAT 26:51"/><verse number="52" style="v" sid="MAT 26:52"/>የሱስ ማቼ፥ “ማሰንም ጎጅድባብ ሙደና ማሰካ ካይደኬ፥ ኮካንታ የስታ ማሰንም ማስሳዮ ሶግናር አርችካ፥ <verse eid="MAT 26:52"/><verse number="53" style="v" sid="MAT 26:53"/>ይና እታ እስታ ባበንም እ ምክሴ ኖ በድ ሳኤካ ፋይድምድን ዳምንባብከስ ክታይንችንከስም እካንታ ኦይዳክን የንደር ካምዶ? <verse eid="MAT 26:53"/><verse number="54" style="v" sid="MAT 26:54"/>ኩን ማደስናና ‘ኮግንዳ ማት ዝግዝዴ’ ጋይድን ጭል ማጻፍንከስታ ቃለና Ꮊስግንዶክ ቦድምዳ?”<verse eid="MAT 26:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55"/>ኮት ሳዓትንዘን ኮታር ሳንምሳን ዎርሰንከስካንታ ኩን ጋይሴ፥ “ፋንገንም የ የድንደትግንዳ እም የድካንታ ማሰንከስምኬ ጉፈንከስም የድሰንት Ꮊዶ? ሰጫ ሙደንካ ሳብታ ጭል ኤሄናር ኤስሰርቶ የንካ ክክን እ ዶቅድንካ እም የዳከትዶቆ፥<note caller="-" style="x"><char style="xo" closed="false">26፡55 </char><char style="xt" closed="false"><ref loc="LUK 19:47">ሉቃ. 19፡47</ref>፤ <ref loc="LUK 21:37">21፡37</ref>። </char></note> <verse eid="MAT 26:55"/><verse number="56" style="v" sid="MAT 26:56"/>ኬዛርካ ማቼ ኮና ሙዳ ማቻንዳ ሳብዘንካ ኤስርሶ ኬዛቅባብከስካ ጭል ማጻፍናር ጻፍምሳንዳ ቦድምድንግዴ” ኮትᎺይካ ክታ ካርንካ ጎርስምድባብከስ ሙደና ክትም ዛቅሶ አጥምሰኬ።<verse eid="MAT 26:56"/></para>
  <para style="s1">የሱስ ቡጫጋልተነከስታ እር ተይ አይምና</para>
  <para style="r">(<ref loc="MRK 14:53-65">ማር. 14፡53-65</ref>፤ <ref loc="LUK 22:54-55">ሉቃ. 22፡54-55</ref>፤ <ref loc="JHN 18:13-14">ዮሀ. 18፡13-14</ref>፥<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57"/>ኮታዘንከረ የሱሰም የጅባብ ኤድንከስ ቀሰንከስታ ገችንባብ ቀያፈደር ተይክትም አይሰኬ። <verse eid="MAT 26:57"/><verse number="58" style="v" sid="MAT 26:58"/>ጴጥሮስ ማቼ ቀሰንከስም ገችዝድባብታ ጋስናር የለልታ የሱሰም ጎትካ ጎርስምሴ፥ ጋስንታ ዋረረ አርድሶ ሪንታ ቦድንተንም ሰድንካንታ ካርሰንባብከስካ ክክን ኖ ዶቅሴ።<verse eid="MAT 26:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59"/>ቀሰንከስታ ገችንባብኬ አይሁድንከስታ ቡጫ ጋልተንከሰረ ሙዳ የሱሰም ደይሳካንታ ካርካ ማርከንከስም ዝግድዮ Ꮊቀኬ። <verse eid="MAT 26:59"/><verse number="60" style="v" sid="MAT 26:60"/>በድ ካርካ ማርከንከስ Ꮊድንከሬ፥ ደእካንታ ፋረችዝድን ማርካ Ꮊፋከኬ፥ በእንታዘነረ ቃስተን ማርከንከስ Ꮊድሰኮ፥ <verse eid="MAT 26:60"/><verse number="61" style="v" sid="MAT 26:61"/>“ኮና ኤችና ‘ሳብታ ጭል ኤሄን ዉልእስቶ ማከን ሰጫር ዎድቴ’ ኖ ጋይቴ” ጋይሶ ኬዘኬ።<note caller="-" style="x"><char style="xo" closed="false">26፡61 </char><char style="xt" closed="false"><ref loc="JHN 2:19">ዮሀ. 2፡19</ref>። </char></note><verse eid="MAT 26:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62"/>ቀሰንከስታ ገችንባብ አምስንደትከ የሱሰደር፥ “ኬና ኤድንከስ የዘን ከት ማርከርድንደታ ሙዳ Ꮊረነረ ማሳያ?” ጋየሮ ክትም ኦይሴ። <verse eid="MAT 26:62"/><verse number="63" style="v" sid="MAT 26:63"/>የሱስ ማቼ ጫምን ጋይሴ። ቀሰንከስታ ገችንባበረ አናካርንካ የሱሰም “ዶቅንት ሳብንታ ላምንካ የስም ጫቅዝድቴ! የና ሳብታ ይንች ክርስቶስ የስ ማቻንደትም ዎካንታ ኬዝካ!” ጋይሴ።<verse eid="MAT 26:63"/></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64"/>የሱሰረ፥ “የስ ጋይሳንደትግንዴ፥ ኬዛርንካ ማቼ የና ኮዘንካ ኦስ ኤድ ይንች ዎልቀንክንባብ ሳብንታ ምዝዘን ዶቅሶ ክት ዶቅድንካ ሰተረቴ፥ ኮትኮግንደረ ጭለዘን ኡፐካ ማትሶ ክት Ꮊድንካ ሰተረቴ እታ የም ጋይድቴ” ኩንጋየሮ ከትካንታ ማስሴ።<note caller="-" style="x"><char style="xo" closed="false">26፡64 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳን. 7፡13</ref>። </char></note><verse eid="MAT 26:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65"/>ኮትᎺይካ ቀሰንከስም ገችዝድባብ ይንታ አፍለንም Ꮊእስሶ ኩን ጋይሴ፥ “ይና ኖ የክንም የክቴ! የተረ ክታ የክንም ኤሰርተቴ! ኮዘንካ ስግ Ꮊራ ማርካ ዝግዝዳ! <verse eid="MAT 26:65"/><verse number="66" style="v" sid="MAT 26:66"/>ይና Ꮊሮክ የም ካምዳ?” ከተረ “ደእ ክትም ዝግዝዴ!” ጋየሮ ማስሰኬ።<note caller="-" style="x"><char style="xo" closed="false">26፡66 </char><char style="xt" closed="false"><ref loc="LEV 24:16">ሌዊ. 24፡16</ref>። </char></note><verse eid="MAT 26:66"/></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67"/>ኮት ሳዓትንዘን ከታ ይንታ ፈጭምን ክታዘን ፈጭምሰኬ፥ ክትም ቱንክሰኬ፥ ክትም ጫቀረኮ፥ <verse eid="MAT 26:67"/><verse number="68" style="v" sid="MAT 26:68"/>“ክርስቶስዮ! Ꮊይራ የስም ጉጵስባብ? ይና ቤርንም ዎካንታ ኬዝካ” ክትም ጋይሰኬ።<verse eid="MAT 26:68"/></para>
  <para style="s1">ጴጥሮሰታ የሱሰም ካድና</para>
  <para style="r">(<ref loc="MRK 14:66-72">ማር. 14፡66-72</ref>፤ <ref loc="LUK 22:55-62">ሉቃ. 22፡55-62</ref>፤ <ref loc="JHN 18:15-25">ዮሀ. 18፡15—18፡25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69"/>ጴጥሮስ ኤሄንታ ማል ቀሰንከስም ገችዝድባብታ ጋስናር ዶቅሶ Ꮊቄ፥ ኮትᎺይካ ዋልቃ ኤተን ፍክስንዳ ክደር Ꮊድሶ፥ “የነረ ገሊላ ፍጨናርንክንባብ የሱሰካ ክክን Ꮊቃዬ!” ክትም ና ጋይሴ። <verse eid="MAT 26:69"/><verse number="70" style="v" sid="MAT 26:70"/>ኖ ማቼ፥ “የስ ጋይድባብም ኤሳይቴ!” ጋይሶ ሙደንከስታ እሪ ካጄ።<verse eid="MAT 26:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71"/>ኖ ዉትካንታ ፍልተንደር ክት የልድንካ ዋልቃ አብ ኤተን ፍክስንዳ ክትም ሰድስንደትከ ዋር ዶቅድን ኤድንከስካንታ “ኮና ኤችና ናዝረት ፍጨናርንክንባብ የሱሰካ ክክን Ꮊቄ” ና ጋይሴ።<verse eid="MAT 26:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72"/>ጴጥሮሰረ፥ “ኮም የስ ጋይድን ኤችንም ኤሳይቴ!” ጋየሮ ጫቀካ አናካርንካ ካጄ። <verse eid="MAT 26:72"/><verse number="73" style="v" sid="MAT 26:73"/>ኮታዘንከረ ቶክም ዶቅሳን ቡር ኮታር ዎእሶ Ꮊቅባብ ኤድንከስ ጴጥሮሰደር እጵን ጋይሰኮ፥ “የስታ ኬዘና የስም መያ ማዝዴ ገታ የነረ ከታርንካ ዋልቃ ባበዬ!” ጋይሰኬ። <verse eid="MAT 26:73"/><verse number="74" style="v" sid="MAT 26:74"/>ኮት ሳዓትንካ ጴጥሮስ፥ “እታ ኤችን ክትም ኤሳይቴ!” ጋየሮ ባድከ ጫቀረ የጄ። ሳነከረ ባቻ ቅቅሴ። <verse eid="MAT 26:74"/><verse number="75" style="v" sid="MAT 26:75"/>ጴጥሮሰረ “ባቻ ቅቃክናና ማከን ዱት እም ካተራዬ” ጋይሶ የሱስ ኬዛን ቃለና ክትም ከልቅን ጋይሴ፥ ጴጥሮሰረ ኦስ ማል ዉትሶ ቡዳርንካ ኤፍሴ።<verse eid="MAT 26:75"/></para>
  <chapter eid="MAT 26"/>
  <chapter number="27" style="c" sid="MAT 27"/>
  <para style="s1">የሱስ ጵላጦሰደር ተይዮ አይምና</para>
  <para style="r">(<ref loc="MRK 15:1">ማር. 15፡1</ref>፤ <ref loc="LUK 23:1-2">ሉቃ. 23፡1-2</ref>፤ <ref loc="JHN 18:28-32">ዮሀ. 18፡28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1"/>ዛማ ገልትናር ቀሰንከስም ገችዝድባብከስከ ዎርሰናርንካ ጋልተንከስ ሙዳ የሱሰዘን ደእታ ፍርዳ ፋረችስካንታ ዞርምሰኬ፥ <verse eid="MAT 27:1"/><verse number="2" style="v" sid="MAT 27:2"/>ኮታ ቡር የሱሰም ዞክሰኮ ሮማ ፍጨንም ቆልድባብ ጵላጦስካንታ ተይ አይሰኮ ስክስት እምሰኬ።<verse eid="MAT 27:2"/></para>
  <para style="s1">አስቆሮንት ይሁደታ ድስርና</para>
  <para style="r">(<ref loc="ACT 1:18-19">ኦይት. ፍ. 1፡18-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3"/>የሱሰዘን ፋረጃንደትም ይ ሰዳንደትካ ስክስትን እምስባብ ይሁዳ ኡቅምሴ፥ ይ ተያን ቦንደከ ታማ ብረንም ቀሰንከስም ገችዝድባብከስካንተኬ ዎርሰናርንካ ጋልተንከስካንታ ኩንጋየሮ ማስት ከትካንታ እምሴ፥ <verse eid="MAT 27:3"/><verse number="4" style="v" sid="MAT 27:4"/>“ጭል ኤችንም ደእካንታ ስክስት እስታ እምንተንካ ባችስትቴ” ከታ ማቼ “ይና ዎም Ꮊራ ማጫራ! ኮና የስታ ማጤ!” ጋይሰኬ። <verse eid="MAT 27:4"/><verse number="5" style="v" sid="MAT 27:5"/>ኖየረ ብረንም ሳብታ ጭል ኤሄናር ዛቅሶ አይስንደትከ ድሰርት ደእሴ።<verse eid="MAT 27:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6"/>ቀሰንከስታ ገችንባብከስ ቦንደኬ ታማ ብረንም አምስሰኮ፥ “ኮና ብረና ማቀስታ ብራ ኮት ማቻንካንታ ሳብታ ጭል ኤሄናር እመርሳንደትካ ክክን ዎ ቡቅድንግንዳ ዎንታ ህግና ጋይዳክዬ” ጋይሰኬ። <verse eid="MAT 27:6"/><verse number="7" style="v" sid="MAT 27:7"/>ኮካንታ ከታ ይ ዞርምሳንደታ ቡር ሶችንከስታ ዱክ ካሪ ማድንግንዳ ዳሄን ኡርዝድባብታ ፍጨንም ሰንት ተየኬ። <verse eid="MAT 27:7"/><verse number="8" style="v" sid="MAT 27:8"/>ኮትኮጎካ ናኮና ፍጨና ታካ የለልታ፥ “ማቀስ ፍጫ” ጋይመሮ ኤልምዴ።<note caller="-" style="x"><char style="xo" closed="false">27፡8 </char><char style="xt" closed="false"><ref loc="ACT 1:18-19">ኦይት. ፍ. 1፡18-19</ref>። </char></note> <verse eid="MAT 27:8"/><verse number="9" style="v" sid="MAT 27:9"/>ኮግንደካ ሳብዘንካ ኤሰርሶ ኬዛቅባብ ኤርምያሰካ “እስራኤል ዎርሰንከስ ኮካ ማታ ከት ጋይሳን ክታ ናክ ማድንደትም ቦንደከ ታማ ብረንም ተየኬ። <verse eid="MAT 27:9"/><verse number="10" style="v" sid="MAT 27:10"/>ጮይሰረ እም ክትሳንግንዳ ዳሄን ኡርስዝድባብታ ፍጨንካንታ ናክሰኬ” ጋይምሶ ኬዝምሳን ቤርና ቦድምሴ።<note caller="-" style="x"><char style="xo" closed="false">27፡10 </char><char style="xt" closed="false"><ref loc="ZEC 11:12-13">ዘካ. 11፡12-13</ref>። </char></note><verse eid="MAT 27:10"/></para>
  <para style="s1">የሱስ ጵላጦሰታ እር ዎእና</para>
  <para style="r">(<ref loc="MRK 15:2-5">ማር. 15፡2-5</ref>፤ <ref loc="LUK 23:3-5">ሉቃ. 23፡3-5</ref>፤ <ref loc="JHN 18:33-39">ዮሀ. 18፡33-39</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11"/>ኮትᎺይካ የሱስ ሮማ ፍጨንም ቆልድባብ ጵላጦሰታ እር ዎእሴ፥ ፍጨንም ቆልድባበረ “የና አይሁድንከስታ ባንቻዮ?” ጋይሶ ክትም ኦይሴ፥ የሱሰረ “የስ ጋይሳንግንደ” ጋይሶ ማስሴ።<verse eid="MAT 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12"/>ኮታዘንከረ ቀሰንከስም ገችዝድባብከስኬ ጋልተንከስ ከት ካሰዝድንካ Ꮊረነረ ከትካንታ ማሳክዬ። <verse eid="MAT 27:12"/><verse number="13" style="v" sid="MAT 27:13"/>ኮታ ቡር ጵላጦስ፥ “መም ርይካ የስም ከት ካሰዝድንካ ኤሰራያ?” ክትም ጋይሴ። <verse eid="MAT 27:13"/><verse number="14" style="v" sid="MAT 27:14"/>የሱስ ማቼ ሮማ ፍጨንም ቆልድባብ አንድር በርእተርን የለልታ ዋልቃ ካሰስንታ ዎራ ማስንም ከዛክዬ።<verse eid="MAT 27:14"/></para>
  <para style="s1">የሱሰዘን ደእታ ፍርደን ፋረድምሳንዳ</para>
  <para style="r">(<ref loc="MRK 15:6-15">ማር. 15፡6-15</ref>፤ <ref loc="LUK 23:13-25">ሉቃ. 23፡13-25</ref>፤ <ref loc="JHN 18:39-40">ዮሀ. 18፡39-40</ref>፤ <ref loc="JHN 19:1-16">19፡1-16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15"/>ሮማ ፍጨንም ቆልድባብ ስለዘን ስለዘን አይሁድንታ ፋስጋ ባአልንᎺይካ ከትካንታ ቡልምድንግንዳ ዎርሰና ዝግዝባብም ዞከርስባብከሳርንካ ዋልቃባብም ክት ቡልድንደታ መጣ Ꮊቄ። <verse eid="MAT 27:15"/><verse number="16" style="v" sid="MAT 27:16"/>ኮትᎺይካ “ባርባን” ጋይምድባብ ይንታ ባችንካ ኤስምስባብ ዞከርሶ Ꮊቄ። <verse eid="MAT 27:16"/><verse number="17" style="v" sid="MAT 27:17"/>ኮካንታ ኤድንከስ ሳንምሳንደትካ ጵላጦስ፥ “Ꮊይም የካንታ እ ቡልድንግንደንት ዝግዳ? ባርባንሞ አና የሱስ ጋይምስባብ ክርስቶሰሞ?” ጋየሮ ከትም ኦይሴ። <verse eid="MAT 27:17"/><verse number="18" style="v" sid="MAT 27:18"/>ጵላጦስ ኮመረ ክት ጋይሳንዳ የሱሰም ቀምስካ ስክስት ከት እምሳንደትም ይ ኤዝድንደትካንቴ። <verse eid="MAT 27:18"/><verse number="19" style="v" sid="MAT 27:19"/>ኮትኮግንደረ ጵላጦስ ፍርዳ እምካንታ ዶቀርድን ጎገንዘን ዶቅሶ ክት ዶቅድንካ ክታ ኬነና፥ “ክትጎካ ናካ ሶይትን Ꮊምስካ በድ ማጠርሳቴ ክትኮ ጭል ኤችንዘን Ꮊራርየሰነረ የስ ይይዳክንግንዳ” ኩንጋይሶ ክታ ኦይቼ። <verse eid="MAT 27:19"/><verse number="20" style="v" sid="MAT 27:20"/>ኮትᎺይካ ቀሰንከስም ገችዝድባብከስኬ ጋልተንከስ ባርባን ቡልማ! የሱስ ማቼ ደአ! ጋይሰኮ ከት ጵላጦሰም ኦይዝድንግንዳ ዎርሰንም ኤእሰኬ። <verse eid="MAT 27:20"/><verse number="21" style="v" sid="MAT 27:21"/>ሮማ ፍጨንም ቆልድባበረ “ቃስተንናርንካ Ꮊምን እ የካንታ ቡልድንግንደንት ዝግዳ?” ጋየሮ ዎርሰንም አነታ ኦይሴ። ከተረ “ባርባንም ዎካንታ የስ ቡልድንግንዳ ዝግዶቴ” ጋየረኮ ማስሰኬ። <verse eid="MAT 27:21"/><verse number="22" style="v" sid="MAT 27:22"/>ጵላጦሰረ፥ “ይና፥ የሱስ ጋይምድባብ ክርስቶሰም Ꮊስስ ክትም ይቴ?” ከደር ጋይሴ። ሙደነረ “ክት ሮከራ!” ጋየሮ ማስሰኬ። <verse eid="MAT 27:22"/><verse number="23" style="v" sid="MAT 27:23"/>ሮማ ፍጨን ቆልድባበረ Ꮊረታ? “ክት ይሳንዳ ባችና Ꮊራ?” ከደር ጋይሴ። ከታ ማቼ “ክት ሮከራ!” ጋየረኮ በድ ፍፍሰኬ።<verse eid="MAT 27:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24"/>ኮካንታ ጵላጦስ ኮና ርና አዉልም አምስዝድንዳ ዳት አብ Ꮊረነረ መይዳክንደትም ይ ሰዳንደትካ ሎቃ ተይᎺችሶ “እታ ኮ ኤችንታ ደእንጎካ ኦይስምዳክቴ፥ ኦይስምድባብ የተቴ!” ጋይሶ ዎርሰንታ እር ይንታ አንንም ስኤርሴ።<note caller="-" style="x"><char style="xo" closed="false">27፡24 </char><char style="xt" closed="false"><ref loc="DEU 21:6-9">ካሪ. 21፡6-9</ref>። </char></note><verse eid="MAT 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25"/>ዎርሰነረ ሙዳ፥ “ክታ ደእንጎካ Ꮊድን ዋጭን ዎንዘንኬ ዎንታ ይንችንከዘን ማታ” ጋይሰኬ።<verse eid="MAT 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26"/>ኮትᎺይካ ጵላጦስ ባርባንም ቡልት ከትካንታ ኦይቼ፥ የሱሰም ማቼ ይ Ꮊርችሳንደታ ቡር ክት ሮከርድንግንዳ ስክስት ከትካንታ እምሴ።<verse eid="MAT 27:26"/></para>
  <para style="s1">ዳምንባብከስ የሱሰዘን Ꮊልተርና</para>
  <para style="r">(<ref loc="MRK 15:16-20">ማር. 15፡16-20</ref>፤ <ref loc="JHN 19:2-3">ዮሀ. 19፡2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27"/>ኮትᎺይካ ሮማ ፍጨንም ቆልድባብታ ዳምንባብከስ የሱሰም ፍጨንም ቆልድባብታ ጋስናር ተይ አይሰኬ፥ ዳምንባብከስመረ ሙዳ የሱሰታ ካንተንካ ሳንሰኬ። <verse eid="MAT 27:27"/><verse number="28" style="v" sid="MAT 27:28"/>ክታ አፍለንመረ ክታዘንካ ዉችሰኮ ዘይም አፍላ ቆፍሰኬ። <verse eid="MAT 27:28"/><verse number="29" style="v" sid="MAT 27:29"/>ጋልም ዛዉዳግንዳ ኡርስተኮ ክታ ማተዘን ጉፍሰኬ፥ ክታ ምዝ አንንዘነረ ጉፋ የችሰኬ፥ ክታ እረረ ጉፈረረኮ “አይሁድንታ ባንችኖ! አቦ የና Ꮊስሬ!” ጋየረኮ ክታዘን Ꮊልተርሰኬ፥ <verse eid="MAT 27:29"/><verse number="30" style="v" sid="MAT 27:30"/>ከታ ይንታ ፈጭምንመረ ክታዘን ፈጭምሰኬ፥ ጉፈንመረ ክታዘንካ ተይሰኮ ክታ ዱረንም ካርንካ ካርንካ ጉጵድ Ꮊቀኬ። <verse eid="MAT 27:30"/><verse number="31" style="v" sid="MAT 27:31"/>ክታዘነረ ከታ ይ Ꮊልተርሳን ቡር ዘይም አፍለንም ዉችሰኮ ክታ አፍለን ማስት ቆፍሰኬ፥ ክትም ሮክካንተረ የድሶ አይሰኬ።<verse eid="MAT 27:31"/></para>
  <para style="s1">የሱሰታ ሮክርና</para>
  <para style="r">(<ref loc="MRK 15:21-32">ማር. 15፡21-32</ref>፤ <ref loc="LUK 23:26-43">ሉቃ. 23፡26-43</ref>፤ <ref loc="JHN 19:17-27">ዮሀ. 19፡17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32"/>ሮማ ፍጨንም ቆልድባብታ ጋስናርንካ ከት ዉታዶቅድንካ ስምኦን ጋይምድባብ ቀረና ፍጫ ኤችንም Ꮊፍሰኮ የሱሰታ ማዝቀልን ክት ሶልማክናና ባልድንግንዳ ይሰኬ። <verse eid="MAT 27:32"/><verse number="33" style="v" sid="MAT 27:33"/>ኮታ ቡር ኮታ ቡልና፥ “ራስቅል” ማቻን ጎልጎታ ጋይምድን ካርዘን የልሰኬ። <verse eid="MAT 27:33"/><verse number="34" style="v" sid="MAT 27:34"/>ኮታረረ ጭስካ ክክን ቡቅምሳን ዎይን ዎጭምንም ክት ዎጭድንግንዳ የሱስካንታ እምሰኬ፥ ኖ ማቼ አፍስሶ ዎጭካንታ ዝጋክዬ።<note caller="-" style="x"><char style="xo" closed="false">27፡34 </char><char style="xt" closed="false"><ref loc="PSA 69:21">የቺ 69፡21</ref>። </char></note> <verse eid="MAT 27:34"/><verse number="35" style="v" sid="MAT 27:35"/>የሱሰም ከታ ይ ሮክሳንደታ ቡር ክታ አፍለን እጫ ዛቅሰኮ ካስምሰኬ።<note caller="-" style="x"><char style="xo" closed="false">27፡35 </char><char style="xt" closed="false"><ref loc="PSA 22:18">የቺ 22፡18</ref>። </char></note> <verse eid="MAT 27:35"/><verse number="36" style="v" sid="MAT 27:36"/>ኮታረረ ዶቅሰኮ ክትም ካርሰሮ Ꮊቀኬ። <verse eid="MAT 27:36"/><verse number="37" style="v" sid="MAT 27:37"/>“ኮና የሱስ አይሁድንከስታ ባንቼ” ጋይድን ክት ካሰስምሳንደታ ጻፍን ክታ ማተንዘንጎካ ማዝቀልንዘን ዎጀኬ። <verse eid="MAT 27:37"/><verse number="38" style="v" sid="MAT 27:38"/>ኮት Ꮊይካ የሱሰካ ክክን ቃስተን ፋንገንከስም ዋልቀን ክታ ምዝዘን ዋልቀን ክታ ከችዘን ሮክሰኬ። <verse eid="MAT 27:38"/><verse number="39" style="v" sid="MAT 27:39"/>ክታ ላመካ ስገድባብ ኤድንከስ ክትም የከረኮ Ꮊልተርድ Ꮊቀኬ፥<note caller="-" style="x"><char style="xo" closed="false">27፡39 </char><char style="xt" closed="false"><ref loc="PSA 22:7">የቺ 22፡7</ref>፤ <ref loc="PSA 109:25">109፡25</ref>። </char></note> <verse eid="MAT 27:39"/><verse number="40" style="v" sid="MAT 27:40"/>“የና ሳብታ ጭል ኤሄንም ዉልእሳዮ ማከን ሰጫር የና ዎድባብ! ይና የስታ ማተንም አቅስኔ! ሳብታ ይንች የስ ማቼ ይና ማዝቀልንዘንካ የስ Ꮊንቸርኔ!” ጋየረኮ ክታዘን ኦትረካ ኬዘኬ።<note caller="-" style="x"><char style="xo" closed="false">27፡40 </char><char style="xt" closed="false"><ref loc="MAT 26:61">ማቶ. 26፡61</ref>፤ <ref loc="JHN 2:19">ዮሀ. 2፡19</ref>። </char></note><verse eid="MAT 27:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41"/>ኮትኮግንደካ ቀሰንከስም ገችዝድባብከስ፥ ሙሴታ ህግንም ኤስዝድባብከስኬ ጋልተንከስካ ክክን ኩን ጋየረኮ Ꮊልተርድ Ꮊቀኬ፥ <verse eid="MAT 27:41"/><verse number="42" style="v" sid="MAT 27:42"/>“አብንከስም አቅሴ ይንታ ማተንም ማቼ አቅስካንታ ማታክዬ! ኖ እስራኤልንከስታ ባንች ይ ማቼ ይና ታ ማዝቀልንዘንካ ክት Ꮊንቸራ፥ ዎተረ ክትካ አመንተሮቴ! <verse eid="MAT 27:42"/><verse number="43" style="v" sid="MAT 27:43"/>ኖ ሳብካ አመንምቴ፥ ‘እታ ሳብታ ይንችቴ’ ኖ ጋይቴ፥ ኮካንታ ሳብ ክትም ሶልምድንዳ ማቼ ይና ታ ክትም አቅሳ!” <note caller="-" style="x"><char style="xo" closed="false">27፡43 </char><char style="xt" closed="false"><ref loc="PSA 22:8">የቺ 22፡8</ref>። </char></note> <verse eid="MAT 27:43"/><verse number="44" style="v" sid="MAT 27:44"/>ኮትኮግንደረ ክትካ ክክን ሮከርስባብ ፋንገንከስ ክትም የግድ Ꮊቀኬ።<verse eid="MAT 27:44"/></para>
  <para style="s1">የሱሰታ ደእና</para>
  <para style="r">(<ref loc="MRK 15:33-41">ማር. 15፡33-41</ref>፤ <ref loc="LUK 23:44-49">ሉቃ. 23፡44-49</ref>፤ <ref loc="JHN 19:28-30">ዮሀ. 19፡28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45"/>Ꮊየካ ላ ሳዓታዘንካ የድሶ ሳክላ ሳዓት የለልታ ፍጫሙደንዘን ኡም ማቼ። <verse eid="MAT 27:45"/><verse number="46" style="v" sid="MAT 27:46"/>ሳክላ ሳዓት ማድንካ የሱስ፥ “ኤሎሄ! ኤሎሄ!<note caller="+" style="f"><char style="fr" closed="false">27፡46 </char><char style="ft" closed="false">አብና ኤለሆ ጋይድንካ ማቶ። ማቸ ኤልይ ጋይዴ። </char></note> ላማ ሰበቅታን?” ጋየሮ አንድር ኡፍስካ ፍፍሴ፥ ኮታ ቡልነረ “እስታ ሳብኖ! እስታ ሳብኖ! Ꮊረተስ እም ዛቅሳሬ?” ጋይንትዬ።<note caller="-" style="x"><char style="xo" closed="false">27፡46 </char><char style="xt" closed="false"><ref loc="PSA 22:1">የቺ 22፡1</ref>። </char></note> <verse eid="MAT 27:46"/><verse number="47" style="v" sid="MAT 27:47"/>ኮታር ዎእሶ Ꮊቅባብ ኤድንከሳርንካ ዋልቃ ዋልቀንከስ ኮም ኤሰርሰኮ “ኮና ኤላሰም ኤላዶቅዴ!” ጋይሰኬ። <verse eid="MAT 27:47"/><verse number="48" style="v" sid="MAT 27:48"/>ሳነካ ከታርንካ ዋልቀና ፉታግንዳ ጩንጭት የድን ርን ጩምሳን ዎይን ዎጭምናር ዱክትዮ ጉፈታ ታጰዘን ዎድሶ ክት ዎጭድንግንዳ ይሰኬ።<note caller="-" style="x"><char style="xo" closed="false">27፡48 </char><char style="xt" closed="false"><ref loc="PSA 69:21">የቺ 69፡21</ref>። </char></note> <verse eid="MAT 27:48"/><verse number="49" style="v" sid="MAT 27:49"/>አብንከስ ማቼ “ዎእከቴ ይና ኤልያስ Ꮊድሶ ክትም አቅዝድንዳ ማቼ ዎ ሰዳ!” ጋይሰኬ። <verse eid="MAT 27:49"/><verse number="50" style="v" sid="MAT 27:50"/>የሱስ አናካርንካ አንድር ኡፍስካ ፍፍሶ ደእሴ።<verse eid="MAT 27:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51"/>ኮትᎺይካ ሳብታ ጭል ኤሄንታ ስፍስንደና ፈይንካ ሶ የለልታ Ꮊእሶ ቃስተን ማቼ። ፍጨነረ ጭጬ፥ ላዝንከሰረ Ꮊእሰኬ፥<note caller="-" style="x"><char style="xo" closed="false">27፡51 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">ዉት. 26፡31-33</ref>። </char></note> <verse eid="MAT 27:51"/><verse number="52" style="v" sid="MAT 27:52"/>ዱክንከሰረ ፎችምሰኮ ደእሶ Ꮊቅባብ ሳብካንታ ፋስምሳን ኤድንከሳርንካ በድንከስ አምሰኬ። <verse eid="MAT 27:52"/><verse number="53" style="v" sid="MAT 27:53"/>ዱክናርንከረ ዉትሰኮ የሱስ ደእናርንካ አምሳንደታ ቡር ሳብካንታ ፋስምሳን ካተመን የሩሳሌማር አርደደኬ፥ ኮታረረ በድ ኤድንከስካንታ Ꮊፈረሰኬ። <verse eid="MAT 27:53"/><verse number="54" style="v" sid="MAT 27:54"/>ፖልስንከስም ገችዝድባብኬ ክትከረ ክክን የሱሰም ካርሰሮ Ꮊቅባብከስ ፍጨንታ ጭጭንምከ ማቻን ርን ሙዳ ከታ ይ ሰዳንደትካ አንድር ጳስሰኮ፥ “ዶፈን ኮና ሳብታ ይንች Ꮊቄ!” ጋይሰኬ። <verse eid="MAT 27:54"/><verse number="55" style="v" sid="MAT 27:55"/>ጎትካ ዶቅሰኮ ሰዳዶቅድባብ በድ ማነንከስ ኮታር Ꮊቀኬ፥ ከታ ገሊላ ፍጨናርንካ የድሶ የሱስካንታ ፍክሰረኮ ክትም ጎርስመሮ Ꮊቅባብከሰኬ። <verse eid="MAT 27:55"/><verse number="56" style="v" sid="MAT 27:56"/>ከተረ ዎክያርንካ መግደላ ፍጨናርንዳ ማራማ፥ ያይቆበተኬ ዮሴፈታ እንደን ማራማ ኮትኮግንደረ ዛብዶሰታ ይንችንከስታ እንደነረ Ꮊቀኬ።<note caller="-" style="x"><char style="xo" closed="false">27፡56 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">ሉቃ. 8፡2-3</ref>። </char></note><verse eid="MAT 27:56"/></para>
  <para style="s1">የሱሰታ ዱክርና</para>
  <para style="r">(<ref loc="MRK 15:42-47">ማር. 15፡42-47</ref>፤ <ref loc="LUK 23:50-56">ሉቃ. 23፡50-56</ref>፤ <ref loc="JHN 19:38-42">ዮሀ. 19፡38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57"/>ፍጨነረ ሶይቻንደትካ የሶፍ ጋይምድባብ አርማትያስ ካተመናርንካ ዋልቃ ቆልመክንባብ ኤች ኮታር Ꮊዴ፥ ኖየረ የሱሰካ አመንድባብከሳርንካ ዋልቀነ፥ <verse eid="MAT 27:57"/><verse number="58" style="v" sid="MAT 27:58"/>ኖኮና ኤችና፥ ጵላጦስደር አይስንደትከ የሱሰታ ለይስንጎካ ክደር ምክሴ፥ ጵላጦሰረ ለይስንም እምድንግንዳ ክትሴ። <verse eid="MAT 27:58"/><verse number="59" style="v" sid="MAT 27:59"/>ኮካንታ ዮሶፈረ ክታ ለይስንም Ꮊንችሶ ክላ ዱክ አፍለንካ አክሴ። <verse eid="MAT 27:59"/><verse number="60" style="v" sid="MAT 27:60"/>ላዝም ቆቅሶ ግክስምሳን Ꮊየነረ ዱከራክን ክላ ጎርናር ዱክሴ፥ ኮታዘንከረ አንድር ሰይንም ቡከልስትዮ ዱክንታ ፍልተንም ዝጭሶ አይሴ። <verse eid="MAT 27:60"/><verse number="61" style="v" sid="MAT 27:61"/>መግደላ ፍጨናርንካ Ꮊዳንዳ ማራመኬ አብ ማራመረ፥ ኮት ዱክንታ የረየር ዶቅሶ Ꮊቀኬ።<verse eid="MAT 27:61"/></para>
  <para style="s1">ዱክንም ካርስና</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62"/>ዛማክን ሰጨና አይሁድንከስታ Ꮊዉስ ሰጫ ማቻንካንታ፥ ቀሰንከስም ገችዝድባብከስኬ ፈረሳውያንንከስ ዋልቃትችካ ጵላጦሰደር አይሰኮ ኩን ጋይሰኬ፥ <verse eid="MAT 27:62"/><verse number="63" style="v" sid="MAT 27:63"/>“የ ዎባቦ! ኖኮና ኮተርስንባብ ሰንፔካ ዶቅድዮ ‘ማከን ሰጨታ ቡር ደእናርንካ አምድቴ’ ክት ጋይሳንዳ ከልቅ ዎም ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">27፡63 </char><char style="xt" closed="false"><ref loc="MAT 16:21">ማቶ. 16፡21</ref>፤ <ref loc="MAT 17:23">17፡23</ref>፤ <ref loc="MAT 20:19">20፡19</ref>፤ <ref loc="MRK 8:31">ማር. 8፡31</ref>፤ <ref loc="MRK 9:31">9፡31</ref>፤ <ref loc="MRK 10:33-34">10፡33-34</ref>፤ <ref loc="LUK 9:22">ሉቃ. 9፡22</ref>፤ <ref loc="LUK 18:31-33">18፡31-33</ref>። </char></note> <verse eid="MAT 27:63"/><verse number="64" style="v" sid="MAT 27:64"/>ኮካንታ ክታ ካርንካ ጎርስምድባብከስ አይሰኮ ለይስንም ከት ድብዳክንግደከ ዎርሰንካንተረ ‘ይና ኖ ደእናርንካ አምቴ’ ከት ጋይዳክንግንዳ ዱክና ማከን ሰጫ የለልታ ካርስምድንግንዳ ክትካ፥ ኩን ይያክንዳ ማቼ ቡርጎካ ዶቅድን ኮትርና እርንደትዘንካ ስግዳንዳ ማተሬ!” <verse eid="MAT 27:64"/><verse number="65" style="v" sid="MAT 27:65"/>ጵላጦሰረ “ይና ካርዝድባብ ዳምንባብከስ ዶቅደኬ፥ አይሰቶ የ ኤዝድንጎግካ ካርስስከቴ” ከትም ጋይሴ። <verse eid="MAT 27:65"/><verse number="66" style="v" sid="MAT 27:66"/>ኮካንታ አይሰኮ ዱክንም ማይተምካ የችሰኮ ዱክንም ዳምንባብከስካ ካርስሰኬ።<verse eid="MAT 27:66"/></para>
  <chapter eid="MAT 27"/>
  <chapter number="28" style="c" sid="MAT 28"/>
  <para style="s1">የሱሰታ ደእናርንካ አምንተና</para>
  <para style="r">(<ref loc="MRK 16:1-10">ማር. 16፡1-10</ref>፤ <ref loc="LUK 20:1-10">ሉቃ. 20፡1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1"/>አይሁድንታ Ꮊዉስ ሰጨና ስገዳን ቡር ዎጋᎺይካ ዛማ ሰጭመናር መግደላ ፍጨናርንካ Ꮊዳን ማራመትኬ አብን ማራመካ ዱክንም ሰድንካንታ አይሰኬ። <verse eid="MAT 28:1"/><verse number="2" style="v" sid="MAT 28:2"/>ይና፥ ከት ገቅራክናና አንድር ፍጨታ ጭጭ ማቼ፥ ጮይስታ ክታይንች ጭላርንካ Ꮊንቸርሶ ዱክንዘን ዎደርሳን ሰይንንም ቡከልስሶ ዘን ዶቅሴ <verse eid="MAT 28:2"/><verse number="3" style="v" sid="MAT 28:3"/>ክታይንችንተረ ባለና ዋልቅንትንግንዳ ሳግዝድ Ꮊቄ፥ አፍለነረ ክታ አዝግንዳ ጫምሳ Ꮊቄ። <verse eid="MAT 28:3"/><verse number="4" style="v" sid="MAT 28:4"/>ካርስንባብከስ ክታይችን ጳስዘንካ አምሳንዳ ጭጭካ ደእስባብግንዳ ማቸከ። <verse eid="MAT 28:4"/><verse number="5" style="v" sid="MAT 28:5"/>ክታይንችና ማቼ ማነንከስም፥ “የታ ማቼ Ꮊይጳሰቴ፥ ሮከርስባብ የሱሰም የ ዝግድንደትም ኤዝድቴ፥ <verse eid="MAT 28:5"/><verse number="6" style="v" sid="MAT 28:6"/>ኖ ካሪ ካዬ ኤንገር ይ ኬዛንግንዳ አምቴ። ካሪ ካዬ፥ ክት Ꮊቃን ካርንም Ꮊድሶ ሰትከቴ። <verse eid="MAT 28:6"/><verse number="7" style="v" sid="MAT 28:7"/>ይና ሳነካ አይሰቶ ክታ ካርንካ ጎርስምድባብከስካንታ ‘ደእናርንካ ኖ አምቴ! ይና እርምሶ ገሊላ ፍጨናር አይዴ፥ ኮታረረ ክትም ሰተረቴ!’ ጋይሰቶ ከትካንታ ኬዝከቴ፥ ይና እታ የም ኬዝትቴ” ኩን ጋይሴ። <verse eid="MAT 28:7"/><verse number="8" style="v" sid="MAT 28:8"/>ኮታዘንከረ ማነንከስ ጳስረኮ አንድር ጉርምካ ዱክናርንካ ሳነካ አይሰኬ፥ ክታ ካርንካ ጎርስምድባብከስካንተረ ኬዛካንታ ዞደረኮ አይሰኬ። <verse eid="MAT 28:8"/><verse number="9" style="v" sid="MAT 28:9"/>የሱስ ከትም ጎግዘን Ꮊፍሶ “አቦ የታ ኡርመቶ!” ከትም ጋይሴ። ከተረ ክደር Ꮊድሰኮ ክታ ዱትን የድሰኮ ክትካንታ ጎስትሰኬ። <verse eid="MAT 28:9"/><verse number="10" style="v" sid="MAT 28:10"/>ኮትᎺይካ የሱስ፥ “Ꮊይ ጳሰቴ! አይሰቶ ገሊላ ፍጨናር ከት አይድንግንዳ እስታ እስመንንከስካንታ ኬዝከቴ፥ እም ኦ ኮታር ሰተረኬ” ከደር ጋይሴ።<verse eid="MAT 28:10"/></para>
  <para style="s1">ካርስንባብከስታ ማርከርና</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11"/>ማነንከሰረ አይድንካ ዳምንባብከሳርንካ ዋልቃ ዋልቀና ካተመናር አይሰኮ ማቻን ሪይንም ሙዳ ቀሰንከስም ገችዝድባብከስካንታ ኬዘኬ። <verse eid="MAT 28:11"/><verse number="12" style="v" sid="MAT 28:12"/>ቀሰንከስም ገችዝድባብከስ ጋልተንከስካ ክክን ሳንምሰኮ ከታ ይ ዞርምሳንደታ ቡር ዳምንባብከስካንታ በድ ብራ እምሰኮ ኩን ከትም ጋይሴ፥ <verse eid="MAT 28:12"/><verse number="13" style="v" sid="MAT 28:13"/>“ ‘ዎ ራትሶ ዶቅድንካ ክታ ካርንካ ጎርስምድባብከስ ሶይት Ꮊድሶ ክትም ድብት አይሰኬ’ ጋይሰቶ ዎርሰንካንታ ኬዝከቴ። <verse eid="MAT 28:13"/><verse number="14" style="v" sid="MAT 28:14"/>ኮም ሪን ሮማ ፍጨንም ቆልድባብ ኤሰርሳ ማቼ ዎታ ኮ ርይን ክትካንታ ኬዝት ቡዳክታር አርችሶቶ የንታዘን ማጣ የልዳክንግንዳ ይቶሮቴ።” <verse eid="MAT 28:14"/><verse number="15" style="v" sid="MAT 28:15"/>ኮካንታ ዳምንባብከስ ብረንም ተይሰኮ ገታ ከትካንታ ኬዛንግንዳ ይሰኬ፥ ኮነረ ሪይና ታካ የለልታ አይሁድንከዝደር ኬዝመሮ ዶቅዴ።<verse eid="MAT 28:15"/></para>
  <para style="s1">የሱስ ይንታካርንካ ጎርስምድባብከዝደር መያ ማትና</para>
  <para style="r">(<ref loc="MRK 16:1-18">ማር. 16፡1-18</ref>፤ <ref loc="LUK 24:36-49">ሉቃ. 24፡36-49</ref>፤ <ref loc="JHN 20:19-23">ዮሀ. 20፡19-23</ref>፤ <ref loc="ACT 1:6-8">ኦይት. ፍ. 1፡6-8</ref>፤ <ref loc="1CO 15:3-8">1 ቆሮ. 15፡3-8</ref>፤ <ref loc="MRK 14:28">ማር. 14፡28</ref>፤ <ref loc="MAT 26:32">ማቶ. 26፡32</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16"/>ክታ ካርንካ ጎርስምድባብ ታመከ ዋልቀንከስ የሱስ ከት አይድንግንዳ ክትሳን ካርን ገሊላ ፍጨናር Ꮊፈርድን ገቸንዘን አይሰኬ። <verse eid="MAT 28:16"/><verse number="17" style="v" sid="MAT 28:17"/>ክትም ሰድሰረ ክትካንታ ጎስትሰኬ፥ ዋልቃ ዋልቀንከስ ማቼ Ꮊኤርሰኬ።<verse eid="MAT 28:17"/></para>
  <para style="s1">ክላ ኬዘንታ አንድር ክተና</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 28:18"/>የሱስ ከደር Ꮊድሶ፥ “ገችታ ኤራ ሙዳ እካንታ ጭለዘነረ ፍጨዘነረ እምምቴ፥ <verse eid="MAT 28:18"/><verse number="19" style="v" sid="MAT 28:19"/>ይና ፍጫሙደንዘን ዶቅድን ዎርሳ ሙደንደር አይከቴ፥ ሳብ ባቤንታ፥ ሳብ ይንችንተኬ አያን ጭልንታ ላምካ ከትም ስእሰረቶ እስታ ካርንካ ጎርስምድባብ ማስስከቴ። <verse eid="MAT 28:19"/><verse number="20" style="v" sid="MAT 28:20"/>እ የካንታ ክትሳንደትመረ ሙዳ ከት ቦድንግንዳ ከትም ኤስስከቴ! ይና፥ እተረ ፍጫሙደንታ በእንታ የለልታ ሙዳᎺይካ የንካ ክክንቴ” ኩን ከትም ጋይሴ።<verse eid="MAT 28:20"/></para>
  <chapter eid="MAT 28"/>
</usx>
