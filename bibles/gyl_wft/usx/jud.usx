<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JUD" style="id">- Gayil New Testament</book>
  <para style="h">ይሁዳ</para>
  <para style="toc1">ይሁደታ ክቴና</para>
  <para style="toc2">ይሁዳ</para>
  <para style="toc3">ይሁ.</para>
  <para style="mt1">ይሁደታ ክቴና</para>
  <para style="imt1">አርድንታ</para>
  <para style="ip">ይሁደታ ክቴና ጻፍምሳንደረ ኣመን ማታከክዶቆ ኣመንድባብከስም ካምሶ ካርካ ኤስስንም ኤስሳኦንግድባብ ኤድንከዘንካ ክርስቶሳር ማችባብከስም ኤግዝምስካንቴ። ኮትኮ ኬዘንታ አምንተነረ ቃስትምስ ጴጥሮሰታ ክቴንም ካምድንደትካ ኮትኮ ጬድ ክቴናር ኖ ጻፍና “አናካርንካ ጉጅምዳክንጎግካ ሳብ ይንታ ዎርሰንካንታ ዋልቃዱት ክት እምሳን ኣመንን ዳቅሶ ኬት ካርዝድንግንዳ” ናበብድባብከስም ዳቅስሶ ገቀርስዝዴ።</para>
  <para style="iot">ማጻፍን ኮትኮታ ሙዳ የድንቴና</para>
  <para style="io1">አርድንታ <char style="ior">(<ref loc="JUD 1:1-2">1-2</ref>) </char></para>
  <para style="io1">ካርካ ኤስስንባብከስታ ኤስስና፥ ከታ እዘንኬ ኬታ ዋችንተንካ <char style="ior">(<ref loc="JUD 1:3-16">3-16</ref>) </char></para>
  <para style="io1">ኣመንንም ኬት ካርስተርንግንዳ እምምሳን ዞራ <char style="ior">(<ref loc="JUD 1:17-23">17-23</ref>) </char></para>
  <para style="io1">አንጃ <char style="ior">(<ref loc="JUD 1:24-25">24-25</ref>) </char></para>
  <chapter number="1" style="c" sid="JUD 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JUD 1:1"/>የሱስ ክርስቶስታ ፍክስንባብኬ ያይቆብታ እስመን ማችባብ ይሁደዘንካ፥</para>
  <para style="p" vid="JUD 1:1">ሳብ ባቤንካ የ ሶልምምስባብካንተኬ፥ የሱስ ክርስቶስካ ኤልምሶ የ ካርስምስባብ ሙደንካንታ፥<note caller="-" style="x"><char style="xo" closed="false">1፡1 </char><char style="xt" closed="false"><ref loc="MAT 13:55">ማቶ. 13፡55</ref>፤ <ref loc="MRK 6:3">ማር. 6፡3</ref>። </char></note><verse eid="JUD 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JUD 1:2"/>ሳብታ አጭርና፥ ሳራትቼንኬ ሶልመና የካንታ በዳ።<verse eid="JUD 1:2"/></para>
  <para style="s1">ካርካ ኤስስንባብከስታ ፍርደና</para>
  <para style="p">
    <verse number="3" style="v" sid="JUD 1:3"/>እስታ ገርነንከሶ! የካ ዎንታ ፋጭንተንጎካ የካንታ ጻፍካንታ በድ ዝግትትዶቆ፥ ታ ማቼ አናካርንካ ዝግዝዳክንጎግካ ሳብ ዎርሰንካንታ ዋልቃዱት እምሳን ኣመንንጎካ ዳቅሶ የ ጉርተርንግንዳ ዞራካንታ እ ጻብድንግንዳ የካንታ ነጋይንዳ ማቼ። <verse eid="JUD 1:3"/><verse number="4" style="v" sid="JUD 1:4"/>ፍርድምካንታ ማችባብከስ በድ ሰጨታ እሪ ከትጎካ ጻፍምስባብ ዋልቃ ዋልቃ ኤድንከስ የንደር ላጵሶ አርተኬ፥ ኬታ ዎንታ ጮይስንታ ዉች እምንተን ቱና ማስሶ ኦንግድባብከስ ሳብም ጎይንዳክባብከሰኬ፥ ኖ ይንት ዎም ቆልድባብከ ዎንታ ጮይስ ማችባብ የሱስ ክርስቶሰም ካደኬ።<verse eid="JUD 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JUD 1:5"/>ኮም ሙዳ እሪምሰቶ ዋልቃዱት የ ኤዝድንዳ ማችንከረ ዎራ ጮይስ ዎርሰንም ግብጽ ፍጨናርንካ ዉችሶ ክት አቅሳንግንደኬ ኮታ ቡረረ ኣመናክባብከስም ካይሳንደትም የም ገቀርስካንታ ሶልምድቴ።<note caller="-" style="x"><char style="xo" closed="false">1፡5 </char><char style="xt" closed="false"><ref loc="EXO 12:51">ዉት. 12፡51</ref>፤ <ref loc="NUM 14:29-30">ፋይ. 14፡29-30</ref>። </char></note> <verse eid="JUD 1:5"/><verse number="6" style="v" sid="JUD 1:6"/>ኮትኮግንደረ ኬታ ይንታ ገችታ ኤረን ካርስክሳ ካርን ይንታ ዛቅስባብ ክታይንችንከስም ገቀርከቴ፥ ከትም ሳብ በእንታ ፍርዳ ሰጨና የልተርን የለልታ ስለንክንደታ ዞክነናርኬ ኡም ግልድድናር ከትም ዎቴ። <verse eid="JUD 1:6"/><verse number="7" style="v" sid="JUD 1:7"/>ኮግንደካ ሰዶመኬ ገሞረካ ኬታ ካንተካ ዶቅድን ካተመንከሰረ ቤልምድባብከስ ማቸኬ፥ ሳብ ፍዛን መጠንዘንካ Ꮊክጎግካ ቤልምሰኬ። ኮካንታ ከታ ስለንክንደታ ኖሄናር አተርድባብከስታ ካምስ ማተኬ።<note caller="-" style="x"><char style="xo" closed="false">1፡7 </char><char style="xt" closed="false"><ref loc="GEN 19:1-24">ፍዝ. 19፡1-24</ref>። </char></note><verse eid="JUD 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JUD 1:8"/>ኮትኮግንደረ ኬና ኤድንከስ ይንታ Ꮊመርንካ ጎርስመረኮ ከታ ይንታ ዋሄንም ቱና ማዝደኬ፥ ገችታ ኤራ ዶቅድባብከስመረ ግርደኬ፥ ጭላር ቦንቻ ኬታ ዶቅድባብከስመረ የግደኬ። <verse eid="JUD 1:8"/><verse number="9" style="v" sid="JUD 1:9"/>ክታይንችን ክድባብ ምካኤል ዎራ ሙሴታ ለይስንጎካ ዳብሎሰካ ክክን ቤርምሳንደትᎺይካ “ጮይስ የስም ዋጫ” ክትም ጋይሳዳት የካክዬ።<note caller="-" style="x"><char style="xo" closed="false">1፡9 </char><char style="xt" closed="false"><ref loc="DAN 10:13">ዳን. 10፡13</ref>፥<ref loc="DAN 10:21">21</ref>፤ <ref loc="DAN 12:1">12፡1</ref>፤ <ref loc="REV 12:7">ለም. 12፡7</ref>፤ <ref loc="DEU 34:6">ካሪ. 34፡6</ref>፤ <ref loc="ZEC 3:2">ዘካ. 3፡2</ref>። </char></note> <verse eid="JUD 1:9"/><verse number="10" style="v" sid="JUD 1:10"/>ኬና ኤድንከስ ማቼ ገቀርት ተይ ከትም ጋምሳንደት ሪ ሙደን የግደኬ፥ ማክቻ ካየን መሄንከስግንዳ ፍዝርምሳን አንግርን ከት ኤዝድሪ ዶቅስንከረ ዎራ ኮትካ ካይደኬ። <verse eid="JUD 1:10"/><verse number="11" style="v" sid="JUD 1:11"/>ቃኤልታ ጎግካ ከት አይሳንካንታ፥ ብራካንታ ጋይሰኮ ባለአመታ ኮትርናር ከት ዋቻንካንታ፥ ቆረረ ግርዳንግንዳ ከተረ ኬታ ግርንተንካ ከት ካይዳንካንታ ከትም የኤ!<note caller="-" style="x"><char style="xo" closed="false">1፡11 </char><char style="xt" closed="false"><ref loc="GEN 4:3-8">ፍዝ. 4፡3-8</ref>፤ <ref loc="NUM 22:1-35">ፋይ. 22፡1-35</ref>፤ <ref loc="NUM 16:1-35">16፡1-35</ref>። </char></note> <verse eid="JUD 1:11"/><verse number="12" style="v" sid="JUD 1:12"/>ኬና ኤድንከስ ኦስናካይሳ ኦኬረኮ ዋልቃትቼካ ዎሰዘን Ꮊፈርደኮ ጎሀ የካንታ ማደኬ፥ ከት ገቀርድንዳ ይንታ ማታካንታ Ꮊክዬ፥ ዞገካ Ꮊንቅምድንግንዳ፥ ዶብ ካየን ኡፓግንደኬ። አፍ ኡዝድን አርፍካ ዎራ አፍ Ꮊፈርዳክንግንዳ፥ ጫጭናርንካ ቡጭምሳንግንደኬ ቃስቴን ዱት ደእሳን Ꮊቀንግንደኬ። <verse eid="JUD 1:12"/><verse number="13" style="v" sid="JUD 1:13"/>ኦስንዝድን ከታ ይንታ ፍክስንታ ዱብንም ጫይድባብከስ፥ ባሀርንታዘን አንድር ዞገንከስግንደኬ፥ ግልድድ ኡምና ስለንክንደታ ከትም ካርዝድንግንደኬ፥ ጋፋኦንግድን ቤዝንከስግንደኬ።<verse eid="JUD 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JUD 1:14"/>አዳምዘንካ የድሶ ታብስ አጥር ማችባብ ሄኖክ ኬዝድዮ “ይና ሳብ ፋይጅንካ በእዳክን ጭል ክታይንችንከስካ ክክን ማትሶ ሙደንታዘነረ ፋረድካንታ Ꮊዴ፥<note caller="-" style="x"><char style="xo" closed="false">1፡14 </char><char style="xt" closed="false"><ref loc="GEN 5:18">ፍዝ. 5፡18</ref>፥<ref loc="GEN 5:21-24">21-24</ref>። </char></note> <verse eid="JUD 1:14"/><verse number="15" style="v" sid="JUD 1:15"/>ኬትኬና ሳብም ጎይንዳክን ኤድንከስም ከት ይሳን ዳቅልሪንከስጎካ ከትም ሰርዴ፥ ሳበረ ይንታ ዶፈንካ ከትኬ ክትም ጎይንዳክባብ ጎመንባብከዘን ከት ኬዛን ዳቅል ሪንከስ ሙደንታ ኬታዘን ፋረተሬ” ኩን ጋይቴ።<verse eid="JUD 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JUD 1:16"/>ኬና ኤድንከስ ሙዳᎺይካ ጉንድምድባብኬ Ꮊራርከረ ጉርምዳክባብከሰኬ፥ ኬታ ይንታ ማታ ዳቅል አንግርንም ጎርስምድባብከሰኬ፥ አፈና ኬታ ኦትረካ ጮጫንዴ፥ ኬታ ይንታ ማታካንታ መይድንደትም ዝግመትካ ኤድም ገስዝደኬ።<verse eid="JUD 1:16"/></para>
  <para style="s1">ኤግዝምስኬ ዞረካ</para>
  <para style="p">
    <verse number="17" style="v" sid="JUD 1:17"/>የታ ማቼ እስታ ገርነንከሶ! ዎንታ ጮይስን የሱስ ክርስቶስታ ኦይትምስባብከስ ኮታ ኤና እሪ ከት ኬዛንደትም ገቀርከቴ። <verse eid="JUD 1:17"/><verse number="18" style="v" sid="JUD 1:18"/>ኬተረ “በእንታ ስለናር ሳብታ ጋይተንዘንካ ጎተርስባብከስ፥ ኬታ ይንታ ገታ ዳቅል አንግርንም ጎርስምድባብከስኬ ሳገችካ ኬዝድባብከስ Ꮊተረኬ” የንደር ጋይታዶቆ።<note caller="-" style="x"><char style="xo" closed="false">1፡18 </char><char style="xt" closed="false"><ref loc="2PE 3:3">2 ጴጥ. 3፡3</ref>። </char></note> <verse eid="JUD 1:18"/><verse number="19" style="v" sid="JUD 1:19"/>ኬታ ኤድም ፋዝድባብ፥ ይንታ ዋሄታ አንግርንም ጎርስምድባብከስኬ አያን ጭልና ኬታር ካየን ኤድንከሰኬ። <verse eid="JUD 1:19"/><verse number="20" style="v" sid="JUD 1:20"/>የታ እስታ ገርነንከሶ፥ ሙደንዘንካ ስግ ሳብካንታ ፋስምሳን የንታ ኣመንካ የንታ ማተንም ጭልስካንታ ጉርከቴ፥ አያን ጭልንተረ ዎልቀካ ምክስከቴ። <verse eid="JUD 1:20"/><verse number="21" style="v" sid="JUD 1:21"/>ዎንታ ጮይስና የሱስ ክርስቶሰረ ይንታ አጭርንካ ስለንክንደታ ዶቅንትናር የም የልዝድንግንዳ ካርስምካ የንታ ማተን ሳብታ ሶልመናር ካርስከቴ።<verse eid="JUD 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JUD 1:22"/>Ꮊኤርድን ኤድንከስካንታ አጨርድባብ ማትከቴ፥ <verse eid="JUD 1:22"/><verse number="23" style="v" sid="JUD 1:23"/>ዋልቃ ዋልቀንከስም ኖሀርንካ ዉችተቶ ከትም አቅስከቴ፥ አብንከስካንታ ጳስካ አጨርከቴ፥ ማችንከረ ጎመካ ቱና ማቻን ኬታ ዘነን ዎልሳን አፍላ ዎራ ነጋክናና ቦስከቴ።<verse eid="JUD 1:23"/></para>
  <para style="s1">ጋለት ምክስ</para>
  <para style="p">
    <verse number="24" style="v" sid="JUD 1:24"/>የ ዋጅዳክንግንዳ ማስካንተኬ ይንኤርዝድ ሪካየንባብከስ ማስሶ ጉርምካ ይንታ ቦንቼንታ እሪ የም ዎይስካንታ ማድባብካንታ፥ <verse eid="JUD 1:24"/><verse number="25" style="v" sid="JUD 1:25"/>ኖ ይንት ዎንታ ኤል ማችባብ ሳብን፥ ዎንታ ጮይስን የሱስ ክርስቶስጎካ ኤና እሪንደትዘንካ የድሶ፥ ታየረ፥ ስለንክንደተረ ቦንቼኬ መና፥ ዎልቀኬ ገችታ ኤረነረ ክትካንታ ማታ! አምንኤ።<verse eid="JUD 1:25"/></para>
  <chapter eid="JUD 1"/>
</usx>
