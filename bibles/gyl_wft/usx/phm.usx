<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Gayil New Testament</book>
  <para style="h">ፍልሞና</para>
  <para style="toc1">ኦይትምስባብ ጳውሎስታ ክታ ፍልሞናካንታ</para>
  <para style="toc2">ፍልሞና</para>
  <para style="toc3">ፍልሞ.</para>
  <para style="mt2">ኦይትምስባብ ጳውሎስታ ክታ</para>
  <para style="mt1">ፍልሞናካንታ</para>
  <para style="imt1">አርድንታ</para>
  <para style="ip">ፍልሞነረ ኤስምስባብ ክርስቶሳር ማችባብ Ꮊቄ፥ ቆለስያስ ምክስ ኤሄናር አሜንድባብከሳርንካ ዋልቃባብ ክት ማቻንደትም ኬዝምዴ። ፍልሞነታ አይላ ማችባብ ኦነስሞስ ጋይምድባብ Ꮊቄ፥ ኖ ኮነረ አይለና ይንታ ማተን ቆልስባብዘንካ Ꮊዝሶ ክት አይሳንደትካ ዞክና ኤሀር Ꮊቅባብ ጳውሎሰካ ክክን Ꮊፈርሴ፥ ጳውሎስጎከረ ኦነስሞስ ክርስቶሳር ማትንተካ አሜንሴ፥ ጳውሎስ ፍልሞናካንታ ክት ጻፍሳን ክቴና ፍልሞነረ ማቲ ክደር Ꮊዳዶቅድባብ ፍክስንባብካ ክክን ክት ኤድምድንግንዳ ክትም ገቀርስዝድንዴ። ጉጅሰረ ታ ኦነስሞስ ክርስቶሳር ማችባብ ክት ማቻንካንታ ይና ኮዘንካ ኦስ ክርስቶሳሪ ማችባብ እስመንግንዳ ማስሶ ፋይድንግንዳ ዳት አይላግንዳ ማስሶ ፋይዳክንግንዳ ክትካንታ ኬዝዴ።</para>
  <para style="iot">ማጻፍን ኮትኮታ ሙዳ የድንተና</para>
  <para style="io1">አርድንታ <char style="ior">(<ref loc="PHM 1:1-3">1-3</ref>) </char></para>
  <para style="io1">ጳውሎስ ፍልሞነም ጎፍሳንዳ <char style="ior">(<ref loc="PHM 1:4-7">4-7</ref>) </char></para>
  <para style="io1">ጳውሎስ ኦነስሞስካንታ ፍልሞነም ክታ ምክስና <char style="ior">(<ref loc="PHM 1:8-22">8-22</ref>) </char></para>
  <para style="io1">በእንታ <char style="ior">(<ref loc="PHM 1:23-25">23-25</ref>) </char></para>
  <chapter number="1" style="c" sid="PHM 1"/>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1"/>የሱስ ክርስቶስጎካ ዞከርስባብ ማችባብ እ ጳውሎስዘንኬ ዎንታ እስመን ጢማቶስዘንካ፥</para>
  <para style="p" vid="PHM 1:1">ሶልምምስባብ ዎንታ እስመንኬ ዎንታ ፍክስንታ ላኮይት ማችባብ ፍልሞናካንታ፥ <verse eid="PHM 1:1"/><verse number="2" style="v" sid="PHM 1:2"/>ዎንታ ምችነን አፍብያካንታ፥ ዎንካ ክክን ክርስቶሰታ ዳምንባብ ማችባብ አርክጳስካንታ፥ ኮትኮግንደረ የስታ ኤር ሳንምድን<note caller="+" style="f"><char style="fr" closed="false">1፡2 </char><char style="ft" closed="false">“የስታ ኤር ሳንምድን ጋይድንዳ” የስታ ኤሄናር Ꮊፈርድን ምክስ ኤሄንካንታ ጋይዴ </char></note><note caller="-" style="x"><char style="xo" closed="false">1፡2 </char><char style="xt" closed="false"><ref loc="COL 4:17">ቆለ. 4፡17</ref>። </char></note> አሜንድባብከስካንታ፥<verse eid="PHM 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3"/>ዎንታ ባቤን ሳብዘንካ፥ ዎንታ ጮይስን የሱስ ክርስቶስዘንከረ ዉች እምንተንኬ ሳራትችንካ የካንታ ማታ።<verse eid="PHM 1:3"/></para>
  <para style="s1">ፍልሞነታ ሶልመንኬ አሜንካ</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4"/>እስታ ምክስንካ የስም ገቀረረቶ ሙዳᎺይካ እስታ ጮይስን ጋለድቴ፥ <verse eid="PHM 1:4"/><verse number="5" style="v" sid="PHM 1:5"/>ጮይስ የሱሳር የስታ ዶቅድን አሜንኬ አሜንድባብከስካንተረ የስታ ዶቅድን ሶልመን ኤሰርትቴ፥ <verse eid="PHM 1:5"/><verse number="6" style="v" sid="PHM 1:6"/>ክርስቶሰታ ዎንታ ማትንተንካ ዎንታ ዶቅድን ኡርማ ሪ ሙዳ መየካ ኤስምድንግንዳ የስታ አሜንንታ አፍና አብንከስካንታ ማተርንግንዳ ሳብም ምግዝድቴ። <verse eid="PHM 1:6"/><verse number="7" style="v" sid="PHM 1:7"/>እስታ እስመኖ! የስጎካ አሜንድባብከስታ ቡደና ክልምሳንጎካ የስታ ሶልመና አንድር ጉርምኬ ዳቅንተን እካንታ እምቴ።<verse eid="PHM 1:7"/></para>
  <para style="s1">ጳውሎስ ኦነስሞስጎካ ጋልትምና</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8"/>ኮካንታ የስታ ፍክስን ቦድካ ጋይስቶ የስም ክታካንታ ክርስቶስካ ሙቅም እስታ ዶቅዳዶቆ፥ <verse eid="PHM 1:8"/><verse number="9" style="v" sid="PHM 1:9"/>ማችንከረ ኮትኮግንዳ ይይንዘንካ ስግሶ የሱስ ክርስቶስጎካ ዞከርስባብ ማትስቶ ዶቅድባብ እታ ዶንጀርስባብ ጳውሎስ ሶለመካ ምክስንም ዝግድቴ። <verse eid="PHM 1:9"/><verse number="10" style="v" sid="PHM 1:10"/>እታ ዞክና ኤሀር ዶቅድንካ እስታ ይንቺ ማችባብ ኦነስሞስጎካ የስም ምግዝድቴ።<note caller="-" style="x"><char style="xo" closed="false">1፡10 </char><char style="xt" closed="false"><ref loc="COL 4:9">ቆለ. 4፡9</ref>። </char></note> <verse eid="PHM 1:10"/><verse number="11" style="v" sid="PHM 1:11"/>ኦነስሞስ ኮታ ኤና እሪ የስካንታ መይዳክዶቆ፥ ታ ማቼ የስካንተረ ማታ እካንታ መይድባቤ።<verse eid="PHM 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12"/>ይና ክትም የዝደር ማስት ኦይድቴ፥ ክትም የዝደር ኦይድቶ እታ እስታ ማታርንካ Ꮊዳንግንዳ ማስስቶ ፋይድቴ። <verse eid="PHM 1:12"/><verse number="13" style="v" sid="PHM 1:13"/>ክላ ኬዘንጎካ ካሪ ዞከርሶ እ ዶቅድንካ የስታ ካርያር ማትሶ እካንታ ፍግዝድንግንዳ ክት እንካ ክክን ማቻናና እም ጉርምዝዳዶቆ፥ <verse eid="PHM 1:13"/><verse number="14" style="v" sid="PHM 1:14"/>ኬዛርካ ማቼ የስታ ኡርማ ፍክስና ማእስካ ማታክናና ሶልመካ ማድንግንዳ ጋይስቶ የስም ኦይሳክዶቅስቶ Ꮊረሰነረ ይይካንታ ዝጋክቴ።<verse eid="PHM 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15"/>ኦነስሞስ ታ የለልታ ቶክም ሰጫካንታ ፋስምሰረ Ꮊረንግርካ ይና ኮዘንካ ኦስ ሙዳᎺይክንደታ የስካ ክክን ዶቅድባብ ማተሬ። <verse eid="PHM 1:15"/><verse number="16" style="v" sid="PHM 1:16"/>ይና ኮዘንካ ኦስ የስካ ክክን ክት ዶቅድንደረ አይላግንዳ ማታክናና አይለዘንካ ስግ ማትሶ ሶልምምስባብ እስመንግንዴ፥ ኖ እካንታ ሶልምምስባብ እስመኔ፥ ማታጋካ ዳት ዋሄካ ኖይንታ ፍክስንካ የስም መይድንካንታ ይንታ አያንካ ጉጅሶ ክርስቶሰካ የስታ እስመን ክት ማቻንካንታ የስካንታ እንድንካ ሶልምምስባቤ።<verse eid="PHM 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17"/>ይና እም የስታ እስመንግንዳ ማስሳዮ የስ ፋይጀ ገታ እግንዳ ማስሳዮ ፋይድካ። <verse eid="PHM 1:17"/><verse number="18" style="v" sid="PHM 1:18"/>የዘን ክት የልሳን ባች ዶቅሴ አነረ ባዛ ክታዘን ዶቅሴ ባዘንም እዘን ማስካ። <verse eid="PHM 1:18"/><verse number="19" style="v" sid="PHM 1:19"/>ይና እታ ጳውሎስ “ባዘን እታ የስካንታ ናክትቴ” ጋይስቶ እስታ ገታ አንካ ጻፍስቶ የስካንታ መያ ማዝድቴ፥ ማችንከረ የስታ ሰንፔንካንታ የና የስታ ማታርንካ ዎራ እስታ ባዛባብ የስታ ማትንተን እም የስም ገቀርስ ዝክሳዬ። <verse eid="PHM 1:19"/><verse number="20" style="v" sid="PHM 1:20"/>ይና እስታ እስመኖ! ኮም ኡርማ ሪን የስ እካንታ ይድንግንዳ ጮይስካ የስም ምግዝድቴ፥ እስታ ቡደን ክርስቶስካ ኡክንስስካ።<verse eid="PHM 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21"/>ኮም የስካንታ እ ጻፍሳንዳ የስ እካንታ ክትምድንደትም አሜንምስቴ፥ ኮትኮግንደረ እ የስም ኦይዝድንደትዘንካ ስግ የስ ይድንደትም እታ ኤዝድቴ። <verse eid="PHM 1:21"/><verse number="22" style="v" sid="PHM 1:22"/>ኮትከረ ሳብ የንታ ምክስን ኤሰርሶ የንደር እ Ꮊድንግንዳ እም ይድንደትም እስታ Ꮊድን ጉርም ዶቅድንካንታ እ Ꮊዉዝድን ኤሀ ግክስካ።<verse eid="PHM 1:22"/></para>
  <para style="s1">በእንታ ሳራትች</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23"/>የሱስ ክርስቶስጎካ እንካ ክክን ዞከርስባብ ኤጳፍራ አቦ የስም ጋይዴ፥<note caller="-" style="x"><char style="xo" closed="false">1፡23 </char><char style="xt" closed="false"><ref loc="COL 1:7">ቆለ. 1፡7</ref>፤ <ref loc="COL 4:12">4፡12</ref>። </char></note> <verse eid="PHM 1:23"/><verse number="24" style="v" sid="PHM 1:24"/>ኮትኮግንደረ እስታ ፍክስንታ ላኮይት ማችባብከስ ማርቆስ፥ አርስጥሮኮስ፥ ደማስኬ ሉቃሰካ አቦ የስም ጋይደኬ።<note caller="-" style="x"><char style="xo" closed="false">1፡24 </char><char style="xt" closed="false"><ref loc="ACT 12:12-25">ኦይት. ፍ. 12፡12-25</ref>፤ <ref loc="ACT 13:13">13፡13</ref>፤ <ref loc="ACT 15:37-39">15፡37-39</ref>፤ <ref loc="ACT 19:29">19፡29</ref>፤ <ref loc="ACT 27:2">27፡2</ref>፤ <ref loc="COL 4:10">ቆለ. 4፡10</ref>፥<ref loc="COL 4:14">14</ref>፤ <ref loc="2TI 4:10">2 ጢማ. 4፡10</ref>፥<ref loc="2TI 4:11">11</ref>። </char></note><verse eid="PHM 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25"/>ጮይስ የሱስ ክርስቶሰታ ዉች እምንተና የንካ ክክን ማታ አምንኤ።<verse eid="PHM 1:25"/></para>
  <chapter eid="PHM 1"/>
</usx>
