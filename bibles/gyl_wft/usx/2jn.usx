<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Gayil New Testament</book>
  <para style="h">2 ዮሀንስ</para>
  <para style="toc1">ኦይትምስባብ ዮሀንሰታ ቃስትምስ ክቴና</para>
  <para style="toc2">2 ዮሀንስ</para>
  <para style="toc3">2 ዮሀ.</para>
  <para style="mt1">ኦይትምስባብ ዮሀንሰታ ቃስትምስ ክቴና</para>
  <para style="imt1">አርድንታ</para>
  <para style="ip">ዮሀንሰታ ቃስትምስ ክቴና ጻፍምሳንዳ ዶንጃ ማችባብ ኦይትምስባብ ዮሀንሰካ ማድንካ፥ ጻፍምሳንደረ እድምሳን ኤሄንእንደትካንተኬ ኮታ ይንችንከስካንቴ። Ꮊረንግርካ ዋልቃ ምክስ ኤሄንካንተኬ ኮታር ዶቅድባብ ኤድንከስካንታ ማትክሳ ነጋዬ፥ ኮና ጬድካ ጻፍምሳን ክቴና ክክ ክክ ከት ሶልምድንግንዳ ገቀርስካንተኬ ካርካ ኤስስንባብከዘንካ አነረ ኬታ ኤስስንዘንከረ ከትም ኤግዝምስካንቴ።</para>
  <para style="iot">ማጻፍን ኮትኮታ ሙዳ የድንተና</para>
  <para style="io1">አርድንታ <char style="ior">(<ref loc="2JN 1:1-3">1-3</ref>) </char></para>
  <para style="io1">ሶልማ ሙደንዘንካ ስግዬ <char style="ior">(<ref loc="2JN 1:4-6">4-6</ref>) </char></para>
  <para style="io1">ካርካ ኤስስንጎካ እምምሳን ኤግዝምስና <char style="ior">(<ref loc="2JN 1:7-11">7-11</ref>) </char></para>
  <para style="io1">በእንታ <char style="ior">(<ref loc="2JN 1:12-13">12-13</ref>) </char></para>
  <chapter number="1" style="c" sid="2JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1"/>እ ጋልተንዘንካ ኦይትምሳንዳ ኮና ክቴ፥ እታ ዶፈንካ የም ሶልምድቴ፥ እታ Ꮊክ ማታክትዶቆ ዶፈንን ኤዝድባብ ሙደና የም ሶልምድባብ እድምሳን እንደንካንተኬ ኮታ ይንችንከስካንታ፥<note caller="+" style="f"><char style="fr" closed="false">1፡1 </char><char style="ft" closed="false">እንደንከ ይንችንከስ ጋይድንዳ አሜንድባብከስም ሰጅዴ (ፋይዳ 4፥5 ዘን Ꮊፈርዴ።) </char></note> <verse eid="2JN 1:1"/><verse number="2" style="v" sid="2JN 1:2"/>ኮነረ ዶፈንና ዎንታ ዎክያር ዶቅድንደትኬ ኦስ እረረ ስለንክንደታ ዎንካ ክክን ዶቅድንዴ።<verse eid="2JN 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3"/>ሳብ ባቤንተኬ ክታ ይንቺን የሱስ ክርስቶስታ ዉች እምንተኬ አጭርንካ ሳራትቼነረ ዶፈንኬ ሶልመካ ዎንካ ክክን ማታ።<verse eid="2JN 1:3"/></para>
  <para style="s1">ዶፈንንተኬ ሶልመተካ</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4"/>የስታ ይንችንከሳርንካ ዋልቃ ዋልቀንከስ ሳብ ባቤና ዎም ክትሳንግንዳ ዶፈንካ ከት ዳቅሳንደትም እስታ Ꮊፍንተንካ አንድር እም ጉርምስቴ። <verse eid="2JN 1:4"/><verse number="5" style="v" sid="2JN 1:5"/>ኤሄንእንዶ፥ ታየረ ዋዴ፥ ኮና እ ጻብድንዳ ክላ ክቴም የዝደር Ꮊይካማ፥ ታ የስካንታ እ ጻብድንዳ “ክክ ክክ ዎ ሶልማ” ጋይድንደትም እሪንደትዘንካ የድሶ ዎንደር Ꮊቃን ክተኔ።<note caller="-" style="x"><char style="xo" closed="false">1፡5 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ዮሀ. 13፡34</ref>፤ <ref loc="JHN 15:12">15፡12</ref>፤ <ref loc="JHN 17">17</ref>። </char></note> <verse eid="2JN 1:5"/><verse number="6" style="v" sid="2JN 1:6"/>ዶፈን ሶልማ ጋይንት ሳብታ ክቴንም ቦዴ። ኮነረ ክቴና እርምሶ የ ኤሰርሳንግንዳ “ሶልመካ ዶእከቴ” ጋይድንዴ።<verse eid="2JN 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7"/>የሱስ ክርስቶስ ኤድ ማትሶ ዋሄካ ክታ መያ ማትን ኣመንዳክባብ በድ ኮተርዝድባብከስ ፍጫሙደንዘን አምተኬ። ኮግንዳ ኤድና ገስዝድባብኬ ክርስቶሰም ግርድባቤ። <verse eid="2JN 1:7"/><verse number="8" style="v" sid="2JN 1:8"/>የታ ማቼ የንታ ሙዳ ናክንም ተይካንታ ዳእከቴ፥ የ ፍክሳንደረ የንዘንካ ካይዳክንግንዳ ካርስምከቴ።<verse eid="2JN 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2JN 1:9"/>ክርስቶሰታ ኤስስንካ ዳቅሶ ዶቅዳክባብኬ ክታዘንከረ ጎተርሶ አይድባብ ሳብ ክትካ ክክን ካዬ፥ ክርስቶሰታ ኤስስናር ዳቅሶ ዶቅድባብካንታ ማቼ ሳብ ባቤንኬ ሳብ ይንችና ክትካ ክክኔ። <verse eid="2JN 1:9"/><verse number="10" style="v" sid="2JN 1:10"/>ኮም ኤስን የዳክሳ Ꮊየነረ የንደር Ꮊዴ የንታ ኤር Ꮊይሞከቴ፥ አቦ ዎራ Ꮊይጋየቴ። <verse eid="2JN 1:10"/><verse number="11" style="v" sid="2JN 1:11"/>አቦነረ ጋይድባብ ኤድ ክታ ዳቅል ፍክስንካ ኤእድባብ ማተሬ።<verse eid="2JN 1:11"/></para>
  <para style="s1">በእንታ ሳራትች</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12"/>ጻፍካንታ እ ዝግድንዳ በድ ሪ የካንታ ዶቅዳዶቆ፥ ኬዛርንካ ማቼ ሙደንም እ ጻብድን ክቴንካ መይምስካንታ ዝጋይቴ፥ ስግስሰረ ዎንታ ጉርምና ቦድማ ማድንግንዳ የንደር Ꮊድስቶ የንካ የካ ኬዝምካንታ Ꮊድን ጉርም ይድቴ።<verse eid="2JN 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13"/>እድምሳንዳ የስታ ምችነንታ ይንችንከስ አቦ የስም ጋይደኬ።<verse eid="2JN 1:13"/></para>
  <chapter eid="2JN 1"/>
</usx>
