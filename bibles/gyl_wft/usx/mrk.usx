<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Gayil New Testament</book>
  <para style="h">ማርቆስ</para>
  <para style="toc1">ማርቆስ ጻፍሳንዳ ዎንታ ጮይስን የሱስ ክርስቶሰታ ክላ ኬዛ</para>
  <para style="toc2">ማርቆስ</para>
  <para style="toc3">ማር.</para>
  <para style="mt1">ማርቆስ ጻፍሳንዳ</para>
  <para style="mt2">ዎንታ ጮይስን የሱስ ክርስቶሰታ ክላ ኬዛ</para>
  <para style="imt1">አርድንታ</para>
  <para style="ip">ማርቆሰታ ክላ ኬዘና “ኮና ሳብታ ይንችን የሱስ ክርስቶስታ ክላ ኬዘንታ እርንዴ” ጋይንተካ ዶምዴ፥ ኮ ክላ ኬዘናር የሱስ ፍክስባብኬ ገችታ ኤራ ዶቅድባብ ኤድ ክትም ማስሶ ኬዝዴ፥ ክታ ገችታ ኤረነረ ክታ ኤስስንካ፥ ግምዘንከዘን ክታ ዶቅድን ዎልቀንኬ ኤታ ጎመንም ነጋ ክታ ጋይንተንካ መያ ማቼ። የሱስ “ኤድንከስም ጎመታ አይላትቸናርንካ ዉችኩን ከትም ዉችንተካ እስታ ሰንፔንም ቆትማ ማስስቶ እምካንታ እታ Ꮊድባብ ኤድ ይንችቴ” ጋይንተካ ይንታ ማታርንካ ይንት ኬዝቴ።</para>
  <para style="ip">ማርቆሰታ ክላ ኬዛ የሱስ ፍክስሶ ስገዳን ክት ግግሳንዳ፥ የረየርከ ዎልቃ ጮጫን ጎግካ ማድንካ ክት ዳቅሳንደረ የሱሰታ ቃለንዘንከ ክታ ኤስስንዘን ማታክናና ክት ይያᎺቃን በርእስዝድን ፍክስንከዘን Ꮊቄ። ስእስንባብ ዮሀንስ ፍክሳᎺቃንደትም፥ የሱሰታ ስእርንጎከ ጰጭምንጎካ ጬድካ አርድንተንም ኬዛንደታ ቡር ኖ ጻፍስባብ ኤችና የሱሰታ ኤስስንጎከ ክታ ፋች ፍክስን ዳልግስሶ ኬዝዴ። በድ ሰጨታ ቡር የሱሰም ጎርስምድባብከስ እንድንካ ኤሰረኮ ከት አይሳንከካ የሱሰም ግርድባብከሰረ ስግስሶ ግር የጀኬ። በእንታ የድንከሰረ የሱሰዘን በእንታ ሳምንትናር ቦድምሳን ሪንከስጎካ፥ ስገረ ኬዝድንዳ ክታ ሮከርንጎከ ክታ ደእናርንካ አምንተንጎኬ።</para>
  <para style="ip">ክላ ኬዘንታ በእንተዘን ኮምበንታ ዋር ሰችምሳንዳ ቃስተንንከስ ዋልቃ ዋልቃ ማጻፍንከሳር Ꮊክ Ꮊፈርደኬ።</para>
  <para style="iot">ማጻፍን ኮትኮታ ሙዳ የድንተና</para>
  <para style="io1">ክላ ኬዘንታ እርንደና <char style="ior">(<ref loc="MRK 1:1-13">1፡1-13</ref>) </char></para>
  <para style="io1">የሱሰታ ገሊላ ፍጨናር ፍክስና <char style="ior">(<ref loc="MRK 1:14-9:50">1፡14—9፡50</ref>) </char></para>
  <para style="io1">የሩሳሌም ካተመናር ክታ ፍክስና <char style="ior">(<ref loc="MRK 10:1-52">10፡1-52</ref>) </char></para>
  <para style="io1">የሩሳሌም ካተመናርኬ ኮታ ሞረናር በእንታ ክታ ሳምንትና <char style="ior">(<ref loc="MRK 11:1-15:47">11፡1—15፡47</ref>)</char></para>
  <para style="io1">ጮይስታ ደእናርንካ አምና <char style="ior">(<ref loc="MRK 16:1-8">16፡1-8</ref>) </char></para>
  <para style="io1">ደእናርንካ አምስባብ ጮይስና ይንታካርንካ ጎርስምድባብከስካንታ መያ ማትንኬ ጭላር ክታ አይንተንካ <char style="ior">(<ref loc="MRK 16:9-20">16፡9-20</ref>) </char></para>
  <chapter number="1" style="c" sid="MRK 1"/>
  <para style="s1">ስእስንባብ ዮሀንሰታ ሳባክና</para>
  <para style="r">(<ref loc="MAT 3:1-12">ማቶ. 3፡1-12</ref>፤ <ref loc="LUK 3:1-9">ሉቃ. 3፡1-9</ref>፤ <ref loc="JHN 1:19-28">ዮሀ. 1፡19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1"/>ኮና ሳብታ ይንችን የሱስ ክርስቶስታ ክላ ኬዛ እርንዴ።<note caller="+" style="f"><char style="fr" closed="false">1፡1 </char><char style="ft" closed="false">ኤና እር ንከስ ሳብታ ይንች ጋይድን ቃለን ጉጃዬ። </char></note> <verse eid="MRK 1:1"/><verse number="2" style="v" sid="MRK 1:2"/>ሳብዘንካ ኤሰርሶ ኬዛቅባብ ኢስያሰካ፥</para>
  <para style="q1" vid="MRK 1:2">“ይና የስታ ጎግን ኡርዝድባብ</para>
  <para style="q1" vid="MRK 1:2">እካንታ ክትምስባብም የስታ እር ኦይድቴ፥<note caller="-" style="x"><char style="xo" closed="false">1፡2 </char><char style="xt" closed="false"><ref loc="MAL 3:1">ሚል. 3፡1</ref>። </char></note><verse eid="MRK 1:2"/></para>
  <para style="m">
    <verse number="3" style="v" sid="MRK 1:3"/>ኮነረ</para>
  <para style="q1" vid="MRK 1:3">‘ጮይስታ ጎግን ግግስከቴ፥</para>
  <para style="q2" vid="MRK 1:3">ማለካ Ꮊጭከቴ’ ጋየሮ፥</para>
  <para style="q1" vid="MRK 1:3">ዴል ቆቸናር ጬክሳ ይይሶ ፍብድን ኤታ ኡፍስ” <note caller="-" style="x"><char style="xo" closed="false">1፡3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">ኢሳ. 40፡3</ref>። </char></note></para>
  <para style="m" vid="MRK 1:3">ጋይምሶ ጻፍምሳንግንዴ።<verse eid="MRK 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4"/>ኮካንታ ስእስንባብ ዮሀንስ “የንታ ጎመንታ ነገትቸን የ Ꮊፍተርንግንዳ፥ ጎማ የንታ ፍክስን ዎይስሰቶ ስኤርከቴ” ጋይንተካ ዴል ቆቸናር ጬቀሮ Ꮊዴ። <verse eid="MRK 1:4"/><verse number="5" style="v" sid="MRK 1:5"/>ይሁዳ ሞረናርንኬ የሩሳሌም ካተመናርንካ በድ ኤድንከስ ክደር Ꮊድ Ꮊቀኬ፥ ከታ ይንታ ጎመንም ቡጨረኮ ዮርዳኖስ ሎቀናር ክታ አንያር ስኤርድ Ꮊቀኬ።<verse eid="MRK 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6"/>ዮሀንሰታ አፍለና ግመል ጋይምድንደታ ስጭካ ፍክስምሳንዳ Ꮊቄ፥ ይንታ ዎክጫምንመረ ሳቅካ ሶቀርድ Ꮊቄ፥ ክታ እችምነረ ኤይከንኬ ባእተታ ኩር Ꮊቄ።<note caller="-" style="x"><char style="xo" closed="false">1፡6 </char><char style="xt" closed="false"><ref loc="2KI 1:8">2 ባንቺ. 1፡8</ref>። </char></note> <verse eid="MRK 1:6"/><verse number="7" style="v" sid="MRK 1:7"/>ኩነረ ጋይድ Ꮊቄ፥ “ክታ ጫመንታ ዞክነንደትም ይርክን ጋይስቶ ቡልካንታ ዎራ እታ ማዳክባብ እዘንካ አንድርይ ስግድባብ እስታ ቡርጎካ Ꮊዴ፥ <verse eid="MRK 1:7"/><verse number="8" style="v" sid="MRK 1:8"/>እታ የም ሎቀካ ስእዝድቴ፥ ኖ ማቸ አያንይ ጭልንካ የም ስስተሬ።”<verse eid="MRK 1:8"/></para>
  <para style="s1">የሱሰታ ስእርንኬ ጰጭምንካ</para>
  <para style="r">(<ref loc="MAT 3:13-17">ማቶ. 3፡13-17</ref>፤ <ref loc="MAT 4:1-11">4፡1-11</ref>፤ <ref loc="LUK 3:21-22">ሉቃ. 3፡21-22</ref>፤ <ref loc="LUK 4:1-13">4፡1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9"/>ኮታይካ የሱስ ገሊላ ሞረናር Ꮊፈርድን ናዝረት ካተመናርንካ Ꮊድሶ ዮርዳኖስ ሎቀናር ዮሀንሰታ አንናር ስኤርሴ። <verse eid="MRK 1:9"/><verse number="10" style="v" sid="MRK 1:10"/>ዮሀንሰረ ሳነካ የሱስ ሎቀናርንካ ዉተዳንግንዳ ጭላ ፎችምድንኬ አያን ጭልነረ ዎለታ ካምስካ ማትሶ ክታዘን Ꮊንቸርድንካ ኖ ሰጄ። <verse eid="MRK 1:10"/><verse number="11" style="v" sid="MRK 1:11"/>ኮታይካ፥ “የስካ እም ጉርምዝድባብ፥ የስም እ ሶልምድባብ እስታ ይንቸዬ” ጋይድን ኡፍስ ጭላርንካ Ꮊዴ።<note caller="-" style="x"><char style="xo" closed="false">1፡11 </char><char style="xt" closed="false"><ref loc="GEN 22:2">ፍዝ. 22፡2</ref>፤ <ref loc="PSA 2:7">የቺ 2፡7</ref>፤ <ref loc="ISA 42:1">ኢሳ. 42፡1</ref>፤ <ref loc="MAT 3:17">ማቶ. 3፡17</ref>፤ <ref loc="MAT 12:8">12፡8</ref>፤ <ref loc="MRK 9:7">ማር. 9፡7</ref>፤ <ref loc="LUK 3:22">ሉቃ. 3፡22</ref>። </char></note> <verse eid="MRK 1:11"/><verse number="12" style="v" sid="MRK 1:12"/>ሳነካ ሳብታ አያንና የሱሰም ዴል ቆቸናር ተይ አይሴ። <verse eid="MRK 1:12"/><verse number="13" style="v" sid="MRK 1:13"/>ኮትኮ ዴል ቆቸናረረ ሰጣንካ ክክን ጰጭመሮ ቃስተን ቦንዳ ሰጫ ዶቅሴ፥ ባችርከረ ክክን Ꮊቄ፥ ክታይንችንከሰረ ክትም አሌሮ Ꮊቀኬ።<verse eid="MRK 1:13"/></para>
  <para style="s1">የሱስ ኤስስን ገሊላር ክታ የድና</para>
  <para style="r">(<ref loc="MAT 4:18-22">ማቶ. 4፡18-22</ref>፤ <ref loc="LUK 5:1-11">ሉቃ. 5፡1-11</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14"/>ዮሀንሰረ የደርሶ ዞክና ኤሄናር አርደዳንደታ ቡር የሱስ ሳብታ ክላ ኬዘንም ሳባከሮ ገሊላ ሞረናር Ꮊዴ። <verse eid="MRK 1:14"/><verse number="15" style="v" sid="MRK 1:15"/>ኤስዝደረ፥ “ዶፈን ሰጨና ታ Ꮊቴ፥ ሳብታ ባንችምና ና የልሳንካንታ ጎማ የንታ ፍክስን ዎይስከቴ! ክላ ከዘንከረ አመንከቴ!” ጋይድ Ꮊቄ።<note caller="-" style="x"><char style="xo" closed="false">1፡15 </char><char style="xt" closed="false"><ref loc="MAT 3:2">ማቶ. 3፡2</ref>። </char></note><verse eid="MRK 1:15"/></para>
  <para style="s1">የሱስ ሞላ የድባብከስ ኦይድ ኤድን ኤልና</para>
  <para style="r">(<ref loc="MAT 4:18-22">ማቶ. 4፡18-22</ref>፤ <ref loc="LUK 5:1-11">ሉቃ. 5፡1-11</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16"/>ኮታ ቡር የሱስ ገሊላ ባሀርንታ ላመካ ስገድንካ ስምኦንከ እስመን እንደራስካ ሞላ የድባብከስ ማቻን ኦል ከታ ይንታ ሞለን የድን ሳከን ባሀርናር ከት ኦይድንካ ከትም ሰዴ። <verse eid="MRK 1:16"/><verse number="17" style="v" sid="MRK 1:17"/>የሱሰረ፥ “ኮረቴ እም ጎርስምከቴ፥ ሞለን የ የድንደትግንዳ ሙዳ ኤድንከስመረ እካንታ የ ሳንስተርንግንዳ የም ይድቴ” ከትም ጋይሴ። <verse eid="MRK 1:17"/><verse number="18" style="v" sid="MRK 1:18"/>ከተረ ሳነካ ሞለን የደርድን ሳከንም ዛቅሰኮ ክትም ጎርስምሰኬ።<verse eid="MRK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19"/>ኮታዘንከረ ቶክም ኦስ ይ ስገዳንግንዳ፥ አብ ቃስተን እስመንምከ ካንስምከ ሰዴ፥ ከተረ ዛብዶስታ ይንች ያይቆብኬ ዮሀንሰካ Ꮊቀኬ፥ ከተረ ሎቀዘንካ ቃልዝድን ጃልበንዘን ማትሰኮ ሞለን የድን ሳከን ይንታ ኡርሰሮ Ꮊቀኬ፥ <verse eid="MRK 1:19"/><verse number="20" style="v" sid="MRK 1:20"/>የሱስ ሳነካ ከትም ኤልሴ፥ ከተረ ይንታ ባቤን ዛብዶሰምንከ ክታ ፍክስንባብከስካ ክክን ሎቀንዘንካ ቃልዝድን ጃልበንዘን ክትም ዛቅሰኮ የሱሰም ጎርስምሰኬ።<verse eid="MRK 1:20"/></para>
  <para style="s1">ዳቅል አያን ክታዘን ዶቅድባብ ኤችንታ አቅንተና</para>
  <para style="r">(<ref loc="LUK 4:31-37">ሉቃ. 4፡31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21"/>ኮታዘንከረ ስግሶ ቅፍራናሆም ካተመናር የልሰኬ፥ ሳነካ Ꮊድን አይሁድንከስታ Ꮊዉስ ሰጨንካ የሱስ አይሁድንከስታ ምክስ ኤሄናር አርድሶ ኤስስ የጄ።<note caller="+" style="f"><char style="fr" closed="false">1፡21 </char><char style="ft" closed="false">መኩራብ ጋይንትና አይሁድንከስታ ምክስ ኤሄ። </char></note> <verse eid="MRK 1:21"/><verse number="22" style="v" sid="MRK 1:22"/>የሱስ ሙሴታ ህግን ኤስዝድባብከስግንዳ ማታክዶቆ ገችንታ ኤረንባብከስግንዳ ኤስዝድዮ ክት Ꮊቃንጎካ ኤሰርስባብከስ ሙደና ክታ ኤስስንካ በርእሰኬ።<verse eid="MRK 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23"/>ዋልቃ ዳቅል አያን ክታዘን ዶቅድባብ ከታ ምክስ ኤሄናር ዋልቃ ኤች ኩንጋየሮ ፍፍሴ፥ <verse eid="MRK 1:23"/><verse number="24" style="v" sid="MRK 1:24"/>“ናዝረትንክባብ የሱስዮ፥ የስተኬ ዎንተካ ክክን Ꮊራ ዶቅዳ? ዎም ካይስካንተስ Ꮊዶ? የስ Ꮊይማቸረ እታ ኤዝድቴ፥ የና ሳብካንታ ፋስምስባበዬ።”<verse eid="MRK 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25"/>የሱሰረ ዳቅል አያንንም “ጫምን ጋይሰዮ ክታዘንካ ዉትካ!” ጋይሶ ዋጬ።<verse eid="MRK 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26"/>ዳቅል አያንነረ ኤችን ባልት ዛቅሶ ክትም ጭእሳንደታ ቡር አንድርይ ኡፍስካ ፍፈሮ ክታዘንካ ዉተዴ። <verse eid="MRK 1:26"/><verse number="27" style="v" sid="MRK 1:27"/>“ኮና Ꮊራ? Ꮊራግንዳ ክላ ኤስሰሬ? ዳቅል አያንንከስም ዎራ ይንታ ገችንታ ኤረንካ ክዴ፥ ከተረ ክትካንታ ክትምደኬ” ጋየረኮ ሙደና በርእካ ክክ ክክ ኦይስም የጀኬ።<verse eid="MRK 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28"/>ሳነካ፥ የሱሰታ ፍክስና ገሊላ ሞረናር ዶቅድን ፍጫ ሙደናር ኤስምሴ።<verse eid="MRK 1:28"/></para>
  <para style="s1">የሱስ በድ Ꮊዘርስባብከስም ፋችና</para>
  <para style="r">(<ref loc="MAT 8:14-17">ማቶ. 8፡14-17</ref>፤ <ref loc="LUK 4:38-44">ሉቃ. 4፡38-44</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29"/>ኮታይካ የሱስ አይሁድንከስታ ምክስ ኤሄናርንካ ዉትሶ ያይቆብኬ ዮሀንሰካ ክክን ስምኦንተኬ እንደርያሰታ ኤሪ አርደዴ። <verse eid="MRK 1:29"/><verse number="30" style="v" sid="MRK 1:30"/>ኤሄንታ ዋር፥ ስምኦንታ በይስተና ዘና ሶል Ꮊዝምካ ሰቀርሶ ራትሶᎺቄ፥ ኮታ Ꮊዝርንመረ ሳነካ የሱስካንታ ኬዘኬ። <verse eid="MRK 1:30"/><verse number="31" style="v" sid="MRK 1:31"/>የሱሰረ ኮደር Ꮊድሶ ኮታ አንንም የድሶ አምሴ፥ ዘና ሶልነረ ሳነካ ኮትም ዛቅሴ፥ ናየረ አምሶ ከትም ሞክሴ።<verse eid="MRK 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32"/>Ꮊይና አርድሶ ፍጨና ሶይድንካ ኤድንከስ ሰቀርስባብከስምከ ግምዘካ የደርስባብከስም ሙዳ የሱሰደር ተይ Ꮊደኬ። <verse eid="MRK 1:32"/><verse number="33" style="v" sid="MRK 1:33"/>ካተመናር ኤድንከስ ሙዳ ማልንዘን ሳንሶ Ꮊቀኬ። <verse eid="MRK 1:33"/><verse number="34" style="v" sid="MRK 1:34"/>የሱስ Ꮊክ Ꮊክ ሰቅምካ ማጠርድባብ በድ ኤድንከስም ፋችሴ፥ በድ ግምዘንከስመረ ዉችሴ፥ ግምዘንከሰረ የሱስ Ꮊይ ክት ማቸረ ኤዝድዮ ከትᎺቃንካንታ፥ የሱስ ከት ኬዝድንግንዳ ከትካንታ ጋያክዬ።<verse eid="MRK 1:34"/></para>
  <para style="s1">የሱስ ገሊላር ዶቅድን አብ ሞረንከሳር ክላ ኬዘንም ሳባክና</para>
  <para style="r">(<ref loc="LUK 4:42-43">ሉቃ. 4፡42-43</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35"/>ሰጭካንታ ይድንካ፥ የሱስ ሰጭመንታ ዋር አምሶ ምክስካንታ ዋልቃ Ꮊርን ጋይሳን ካርዘን አይሴ። <verse eid="MRK 1:35"/><verse number="36" style="v" sid="MRK 1:36"/>ስምኦንከ ክትካ ክክን Ꮊቅባብከስ ክትም ዝግመት ዉትሰኮ አይሰኬ። <verse eid="MRK 1:36"/><verse number="37" style="v" sid="MRK 1:37"/>ክትም ከታ ይ Ꮊፍሳንደትካ፥ “ኤድንከስ ሙዳ የስም ዝግደኬ” ክደር ጋይሰኬ።<verse eid="MRK 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38"/>የሱሰረ፥ “እ Ꮊዳንዳ ኤስስካንታ ማቻንኦል ክላ ኬዘንም እ ኤስዝድንግንዳ አብ ዶቅድን ሞረንከሳር ዎም ሙከቴ!” ከትም ጋይሴ።<verse eid="MRK 1:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 1:39"/>ኮካንታ አይሁድንከስታ ምክስ ኤሄናር ሳባከሮ ግምዘንም ዉቸሮ ገሊላ ሞረናር ሙዳ ኦንግድ Ꮊቄ።<note caller="-" style="x"><char style="xo" closed="false">1፡39 </char><char style="xt" closed="false"><ref loc="MAT 4:23">ማቶ. 4፡23</ref>፤ <ref loc="MAT 9:35">9፡35</ref>። </char></note><verse eid="MRK 1:39"/></para>
  <para style="s1">የሱስ እጳ ሰቅምንክባብ ኤችን ፋችና</para>
  <para style="r">(<ref loc="MAT 8:1-4">ማቶ. 8፡1-4</ref>፤ <ref loc="LUK 5:12-16">ሉቃ. 5፡12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40"/>ዋልቃ ጳስዝድን እጳ ሰቅምንክባብ የሱሰደር Ꮊድሶ ክታ ዱትያር ጉምፈርሶ፥ “የስ እም ሶልምዴ እም ፋችካንታ ማደዬ” ጋየሮ ምክሴ።<note caller="+" style="f"><char style="fr" closed="false">1፡40 </char><char style="ft" closed="false">እጳ ሰቅምና ጭል ማጻፍንታ ከዘንግንዳ ኤታ ዘነንዘን Ꮊፈርድንዳ Ꮊክ Ꮊክ ዋልቃባብዘንካ ዋልቃባብም የድንዳ እጰታ ሰቅምም ሙደን አነረ ጭልማይባብከ ኤድዘንከረ ጎተርዝድንደትም ሰጅዴ። </char></note><verse eid="MRK 1:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41"/>የሱሰረ ኤችንካንታ አጨርሶ ይንታ አንን ኦይትሶ ክትም Ꮊጨሮ፥ “ኡራባብ የስም ጋይትቴ፥ ኡርካ” ክትም ጋይሴ። <verse eid="MRK 1:41"/><verse number="42" style="v" sid="MRK 1:42"/>ኤችነረ ሳነካ እጳ ሰቅምናርንካ ኡርሴ። <verse eid="MRK 1:42"/><verse number="43" style="v" sid="MRK 1:43"/>የሱስ ኤችንም ኡርስት ካርስምካ ጋይሶ ክትም ኦይቼ፥ <verse eid="MRK 1:43"/><verse number="44" style="v" sid="MRK 1:44"/>“ኮም ርን Ꮊየሰንካንተረ የስ ኬዝዳክንግንዳ የስታ ማታ ካርስምካ፥ ኬዛር ማቼ አይሳዮ የስታ ማተንም ቀሰንከስም ገችዝድባብደር ሰችስካ፥ ዎርሰንካንተረ ማርካ ማድንግንዳ የስታ አቅንተንጎካ ሙሳ ክትሳንደትም ካስን እምካ” ጋይሶ ክትሴ።<note caller="-" style="x"><char style="xo" closed="false">1፡44 </char><char style="xt" closed="false"><ref loc="DEU 4:1-32">ካሪ. 4፡1-32</ref>። </char></note> <verse eid="MRK 1:44"/><verse number="45" style="v" sid="MRK 1:45"/>ማታጋካ ዳት ኤችና ኮታርንካ ዉትሶ ኮትኮርን ሙዳ ይምሳንደትም ኤድ ሙደንካንታ ኬዛ የጄ። ኮትኮጎከረ የሱስ Ꮊምን ካተመናረረ መየካ አርድካንታ ማታክዬ። ኬዛርንካ ማቼ ካተመናርንካ ኦስ ኤድ ካየን ካርናር ዶቅድ Ꮊቄ፥ ማችንከረ ኤድንከስ Ꮊክ Ꮊክ ካርናርንካ ክደር ᎺደሮᎺቀኬ።<verse eid="MRK 1:45"/></para>
  <chapter eid="MRK 1"/>
  <chapter number="2" style="c" sid="MRK 2"/>
  <para style="s1">የሱስ ዎብ ኤችንም ፋችና</para>
  <para style="r">(<ref loc="MAT 9:2-8">ማቶ. 9፡2-8</ref>፤ <ref loc="LUK 5:18-26">ሉቃ. 5፡18-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1"/>ቶክም ሰጨታ ቡር የሱስ ቅፍራናሆም ካተመናር ማትሶ Ꮊዴ፥ ኮታር ኤሄንታ ዋር ክታ ዶቅንተና ዎርሰንደር ኤስምሴ። <verse eid="MRK 2:1"/><verse number="2" style="v" sid="MRK 2:2"/>ኤሄና ማዳክንዳ ማችንካ ማልና ዎራ ኡንምተርን የለልታ በድ ኤድንከስ ሳንሰኬ፥ ሳብታ ቃለንመረ ከትካንታ ኤስዝድ Ꮊቀኬ። <verse eid="MRK 2:2"/><verse number="3" style="v" sid="MRK 2:3"/>ኮታይካ ኦይድ ኤድንከስ ዋልቃ ዎብ ኤችንም ባልሰኮ ክደር Ꮊደኬ። <verse eid="MRK 2:3"/><verse number="4" style="v" sid="MRK 2:4"/>ዎርሰንታ በድምንዘንካ አምሳንዳ ኤች ዎብንም የሱሰደር ተይ Ꮊድ ከትም ጋምስንካ ኤሄንታ የለንም የሱስ ዶቅድንጎካ አምስሶ ዎብንም ክታ Ꮊቸንካ ክክን Ꮊንችሰኬ። <verse eid="MRK 2:4"/><verse number="5" style="v" sid="MRK 2:5"/>የሱሰረ ከታ አሜንንም ሰድሶ ዎብንም “የና ይንችኖ የስታ ጎመና የስካንታ ነጋ ጋይምቴ” ክትም ጋይሴ።<verse eid="MRK 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6"/>ኮታር ዶቅሶ Ꮊቅባብ ዋልቃ ዋልቃ ሙሴታ ህግን ኤስዝድባብከስ ከታ ይንታ ቡዳር ኩን ጋይሰኬ፥ <verse eid="MRK 2:6"/><verse number="7" style="v" sid="MRK 2:7"/>“ኮና ኤችና ኮግንዳ የክን ሳብዘን Ꮊረተክ ከዝዳ? ዋልቃ ሳብ ክታዘንካ ጎመንም ነጋ ጋይካንታ ማድባብ Ꮊይራ?”<verse eid="MRK 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8"/>ሳነካ የሱስ ኮም ከታ ቡደንታ ገቅርን ይንታ አያንካ ኤስሶ ኩን ከትም ጋይሴ፥ “Ꮊረተንት የንታ ቡደናር ኮም ገቀርዳ? <verse eid="MRK 2:8"/><verse number="9" style="v" sid="MRK 2:9"/>ዎብንም፥ ‘የስታ ጎመና የስካንታ ነጋ ጋይምቴ’ ጋይንታዘንኬ፥ ‘አምሳዮ የስታ Ꮊቸንም ባልሳዮ አይካ!’ ጋይንታዘንካ Ꮊምና ኡርዳ? <verse eid="MRK 2:9"/><verse number="10" style="v" sid="MRK 2:10"/>ኬዛርንካ ማቸ ኤደት ይንች ፍጨዘን ጎመንም ነጋ ጋይካንታ ገችታ ኤራ ዶቅድባብ ማትንተን የ ኤስተርንግንዳ” ጋይሶ ዎብንም፥ <verse eid="MRK 2:10"/><verse number="11" style="v" sid="MRK 2:11"/>“አምካ፥ የስታ Ꮊቸን ባልስንደትከ የስታ ኤር አይካ የስም ጋይድቴ” ጋይሴ።<verse eid="MRK 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12"/>ዎብነረ ሳነካ አምስንደትከ ይንታ Ꮊቸንም ባልሶ ኤድንከስ ሙደና ሰድንካ ዉተዴ። ኮካንተረ ኤድንከሰረ ሙዳ በርእሰኮ ኮግንዳ ር ቦድሶ ሰት ኤዝዳኮቴ ጋየረኮ ሳብም ጋለቸኬ።<verse eid="MRK 2:12"/></para>
  <para style="s1">የሱስ ለዊም ኤልና</para>
  <para style="r">(<ref loc="MAT 9:9-13">ማቶ. 9፡9-13</ref>፤ <ref loc="LUK 5:27-32">ሉቃ. 5፡27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13"/>የሱሰረ አናካርንካ ኦስ ገሊላ ባሀርንታ ላማር አይሴ፥ ዎርሰነረ ሙዳ ሳንምሰኮ ክደር Ꮊድንካ ኖ ከትም ኤስሴ። <verse eid="MRK 2:13"/><verse number="14" style="v" sid="MRK 2:14"/>ኮትከረ ክት ስገድንካ ቃረጭን ተችዝድን ካርዘን ዶቅሶ Ꮊቅባብም እልፎሰታ ይንችን ለዊም ሰድሶ፥ “እም ጎርስምካ” ጋይሴ፥ ኖየረ አምሶ ክትም ጎርስምሴ።<verse eid="MRK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15"/>ኮታ ቡር የሱስ ለዊታ ኤሪ እችምካንታ ዶቅሴ፥ በድ ኤድንከሰረ ክትም ጎርስምሳንጎካ ከታርንከረ በድ ቃራጭን ተችዝድባብከስ፥ ጎመንባብከስ፥ የሱሰኬ ክታ ካርንካ ጎርስምድባብከስካ ክክን እችምንደር ዶቅተኬ። <verse eid="MRK 2:15"/><verse number="16" style="v" sid="MRK 2:16"/>ፈረሳዊያንንንከስታ ኮች ማችባብ ሙሴታ ህግን ኤስንባብከስ የሱስ ቃራጭን ተችዝድባብከስኬ ጎመንባብከስካ ክክን ክት እጅድንካ ሰድሰኮ “ቃረጭን ተችዝድባብከስኬ ጎመንባብከስካ ክክን ክት እጅድንደትኬ ዎጭድንዳ Ꮊረተረ?” ጋይንተካ ክታ ካርንካ ጎርስምድባብከስም ኦይሰኬ።<verse eid="MRK 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17"/>የሱሰረ ኮም ኤስርሶ፥ “ሰቀርስባብከስም ዳት ኡርመንከስም አክም ዝክሳዬ፥ እተረ እ Ꮊዳንደና ጭልንባብከስም ማታክናና ጎመንባብከስም ይንታ ጎመን ከት ዎይዝድንግንዳ ኤልካንቴ”፥ ከትም ጋይሴ።<verse eid="MRK 2:17"/></para>
  <para style="s1">በቼካ ምክስጎካ ኦይሰርሳንዳ ኦይስ</para>
  <para style="r">(<ref loc="MAT 9:14-17">ማቶ. 9፡14-17</ref>፤ <ref loc="LUK 5:33-38">ሉቃ. 5፡33-38</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18"/>ዮሀንሰታ ካርንካ ጎርስምድባብከስከ ፈረሳዊያንንከስ በቼካ ምግዝድዮ Ꮊቀኬ። ዋልቃ ዋልቃ ኤድንከስ የሱሰደር Ꮊድሰኮ፥ “ዮሀንሰተከ ፋርሳንከስታ ካርንካ ጎርስምድባብከስ በቼካ ምግዝደኬ፥ የስታ ካርንካ ጎርስምድባብከስ ማቼ በቼካ ምግዝዳክንዳ Ꮊረተሬ?” ጋይሰኬ።<verse eid="MRK 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19"/>የሱሰረ “እንቸንባብና ከትካ ክክን ዶቅድንካ ካርንካ Ꮊድባብከስ በቼካ ዶቅደኮ? ኩን ካዬ! እንቸንባብ ከትካ ክክን ዶቅድንካ በቼካ ዶቅ ከትም ዝክሳዬ። <verse eid="MRK 2:19"/><verse number="20" style="v" sid="MRK 2:20"/>ኬዛር ማቼ እንቸንባብ ከታዘንካ ፋስምድን ሰጫ Ꮊዴ፥ ኮትᎺይካ በቼካ ምክስተረኬ።<verse eid="MRK 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21"/>“ገሳ አፍለንታዘን ክላ አፍላ Ꮊእስትዮ ዛግድባብ Ꮊየረ ካዬ። ኮና ይይምሳን ማቼ፥ ክላ አፍለንታ Ꮊእስምና ገሳ አፍለን ፎእዴ፥ Ꮊእምነረ እርንደትዘንካ ስግዳንዳ ማዴ። <verse eid="MRK 2:21"/><verse number="22" style="v" sid="MRK 2:22"/>ኮትኮግንደረ ዎይን ዎጭምን የድን ገሰርሳን ሱልፈንታ ዋር ኡሳክን ዎይን ዎጭምን ዎድባብ ካዬ፥ ኮና ይይምሳን ማቼ ዎይን ዎጭምና ሱልፈንም ፉእዝዴ፥ ዎይን ዎጭምነረ ዉልእምዴ፥ ሱልፈነረ መይዳክንዳ ማዴ። ኮካንታ ኡሳክን ዎይን ዎጭምንካንታ ክላ ሱልፋ ዝግዝዴ”፥ ከትም ጋይሴ።<verse eid="MRK 2:22"/></para>
  <para style="s1">አይሁድንታ Ꮊዉስ ሰጨንታ ኦይስምሳን ኦይስ</para>
  <para style="r">(<ref loc="MAT 12:1-8">ማቶ. 12፡1-8</ref>፤ <ref loc="LUK 6:1-5">ሉቃ. 6፡1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23"/>አይሁድንታ Ꮊዉስ ሰጨንካ የሱስ ዘርግ ትሰንታ ዎክካ አይድንካ፥ ክታ ካርንካ ጎርስምድባብከስ አይደኮ ዘርግ ትሰንም ታክስ የጀኬ።<note caller="-" style="x"><char style="xo" closed="false">2፡23 </char><char style="xt" closed="false"><ref loc="DEU 23:25">ካሪ. 23፡25</ref>። </char></note> <verse eid="MRK 2:23"/><verse number="24" style="v" sid="MRK 2:24"/>ፈርሳዊያንንከሰረ “ይና፥ የስታ ካርንካ ጎርስምድባብከስ አይሁድንታ Ꮊዉስ ሰጨንካ ጋይማክንደትም Ꮊረተክ ይዳ?” ጋየረኮ ክትም ኦይሰኬ።<verse eid="MRK 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25"/>የሱሰረ፥ “ዳዊት ይንካ ክክን ዶቅድባብከስካ ዳቀርሳንደትᎺይኬ ማጠርሳንᎺይካ Ꮊራ ክት ይሳናነረ የታ ናበባከቴ? ኩን ከደር ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">2፡25 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1 ሳሙ. 21፡1-6</ref>። </char></note> <verse eid="MRK 2:25"/><verse number="26" style="v" sid="MRK 2:26"/>አብያታር ቀሰንከስም ገችዝድባብ ማትሶ ክት Ꮊቃን ስለናር ኖ ዳውት ሳብታ ኤሄናር አርድሶ፥ ቄሰንከዘንካ አብንከስካንታ እችማ ጋይማክንደትም፥ ሳብካንታ ጋይሶ ፋሰርሳን ካስ እችምን እቼ፥ ክትከረ ክክን ዶቅድን ኤድንከስካንተረ እምሴ”።<note caller="-" style="x"><char style="xo" closed="false">2፡26 </char><char style="xt" closed="false"><ref loc="LEV 24:9">ሌዊ. 24፡9</ref>። </char></note><verse eid="MRK 2:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27"/>ጉጅሰረ የሱስ “አይሁድንከስታ Ꮊዉስ ሰጨና ኤድ ካንታ ፍዝምሳዳት ኤድ Ꮊዉስ ሰጨንካንታ ፍዝማክዬ፥ <verse eid="MRK 2:27"/><verse number="28" style="v" sid="MRK 2:28"/>ኮትኮግንደረ ኤድ ይንች አይሁድንታ Ꮊዉስ ሰጨንዘን ጮይስዬ”። ኩንጋየሮ ከትካንታ ማስሴ።<verse eid="MRK 2:28"/></para>
  <chapter eid="MRK 2"/>
  <chapter number="3" style="c" sid="MRK 3"/>
  <para style="s1">የሱስ አን ዎብ ኤችን ፋችና</para>
  <para style="r">(<ref loc="MAT 12:9-14">ማቶ. 12፡9-14</ref>፤ <ref loc="LUK 6:6-11">ሉቃ. 6፡6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1"/>የሱስ ካርንካ አይሁድንከስታ ምክስ ኤሄናር አርደዴ፥ ኮታረረ ዋልቃ አን ዎብ ኤች Ꮊቄ። <verse eid="MRK 3:1"/><verse number="2" style="v" sid="MRK 3:2"/>የሱሰም ካሰስካንታ ዝግዝን ኤድንከስ፥ “ይና አይሁድንታ Ꮊዉስ ሰጨንካ ክትም ፋጅድንዳ ማቸ ዎሰዳ!” ጋይሰኮ ክትም ካርዝድ Ꮊቀኬ። <verse eid="MRK 3:2"/><verse number="3" style="v" sid="MRK 3:3"/>የሱሰረ አን ዎብ ኤችንም፥ “ኮሬ ከታ ዎክናር Ꮊድሶ ዎእካ” ክትም ጋይሴ። <verse eid="MRK 3:3"/><verse number="4" style="v" sid="MRK 3:4"/>ኮተረ ቡር “የለቴ Ꮊዉስ ሰጨንካ ይማባብ ጋይምሳንዳ ኡርማ ይይንቶ አና ዳቅል ይይንቶ? ሰንፔም አቅስዮ አና ካይስዮ?” ጋይሶ ከትም ኦይሴ። ከታ ማቼ ጫምን ጋይሰኬ። <verse eid="MRK 3:4"/><verse number="5" style="v" sid="MRK 3:5"/>የሱሰረ ከታ ቡደንታ ዳቅንተንጎካ ሞርእሶ ይንታ ካንተንካ ዶቅድባብከስም ዋጭ አፍካ ሰድሶ ኤችንም፥ “የስታ አንንም ፍእስካ” ክትም ጋይሴ። ኖየረ ይንታ አንንም ክት ፍእዝድንካ አንና ኡርሴ። <verse eid="MRK 3:5"/><verse number="6" style="v" sid="MRK 3:6"/>ሳነካ ፈረሳዊያንንከስ ዉትሰኮ Ꮊስግንዳ ይሰኮ የሱሰም ከታ ይ ካይስተርንደትም ሄረዶስታ ገቅርን ማታ ጋይድባብ ኤድንከስካ ክክን ዞርምሰኬ።<verse eid="MRK 3:6"/></para>
  <para style="s1">ዎርሰና ባሀርንታ ላማር የሱሰደር ከታ ሳንምና</para>
  <para style="r">(<ref loc="MAT 12:15-16">ማቶ. 12፡15-16</ref>፤ <ref loc="LUK 6:17-19">ሉቃ. 6፡17-19</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7"/>የሱስ ይንታካርንካ ጎርስምድባብከስካ ክክን ካርንኮትም ዛቅሶ ገሊላ ባሃርንደር አይሴ። ገሊላ ሞረናርንካ በድ ኤድንከስ ክትም ጎርስምሰኬ። <verse eid="MRK 3:7"/><verse number="8" style="v" sid="MRK 3:8"/>ክት ይድ Ꮊቃንደትመረ ርን ሙዳ ኤሰርሰኮ በድ ኤድንከስ ክደር ᎺድᎺቀኬ፥ ከተረ ገሊላርንካ ይሁዳርንካ፥ የሩሳሌማርንካ፥ ኤዶማርንካ፥ ዮርዳኖስ ሎቀንታ ፋማ ዶቅድን ሞረናርንካ፥ ኮትኮግንደረ ጢሮሳርንኬ ሲዶና ካተመንከሳርንካ Ꮊድባብከስ ዶቅደኬ። <verse eid="MRK 3:8"/><verse number="9" style="v" sid="MRK 3:9"/>ዎርሰንታ በድምንዘንካ አምሳንዳ ኤድንከስ ክትም ኡንኤርዝዳክንግንዳ ሎቀዘንካ ቃልዝድን ጃልባ ግክስሰኮ ክትካንታ ከት እምድንግንዳ ይንታ ካርንካ ጎርስምድባብከስም ክትሴ።<note caller="-" style="x"><char style="xo" closed="false">3፡9 </char><char style="xt" closed="false"><ref loc="MRK 4:1">ማር. 4፡1</ref>፤ <ref loc="LUK 5:13">ሉቃ. 5፡13</ref>። </char></note> <verse eid="MRK 3:9"/><verse number="10" style="v" sid="MRK 3:10"/>በድ ኤድንከስም ሰቅምናርንካ ፋችሳንካንታ Ꮊዝምካ ማጠርድባብ ሙደና ከታ ይንታ አንካ ክትም ዎልካንታ ዝግሰኮ፥ ክትም ማእዝድ Ꮊቀኬ። <verse eid="MRK 3:10"/><verse number="11" style="v" sid="MRK 3:11"/>ዳቅል አያንንከሰረ ክትም ሰድሰኮ ክታ እር ዋቸረኮ፥ “የና ሳብታ ይንቸዬ!” ጋየረኮ ፍብድ Ꮊቀኬ።<verse eid="MRK 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12"/>የሱስ ማቼ ይ Ꮊይናነረ ከት መያ ማሳይንግንዳ ዳቅስሶ ከትም ዋጬ።<verse eid="MRK 3:12"/></para>
  <para style="s1">የሱስ ታመኬ ቃስተን ኦይትምስባብከስም እድና</para>
  <para style="r">(<ref loc="MAT 10:1-4">ማቶ. 10፡1-4</ref>፤ <ref loc="LUK 6:12-16">ሉቃ. 6፡12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13"/>የሱስ ገቸንዘን ዉተዳንᎺይካ ከትከን ይዝግዝባብከስም ይንደር ኤልሴ፥ ከተረ ይንካ ዶቅድባብከስም ዛቅሰኮ ክደር Ꮊደኬ። <verse eid="MRK 3:13"/><verse number="14" style="v" sid="MRK 3:14"/>የሱሰካ ክክን ከት ማድንግንዳ፥ ኤስስካንተረ ከትም ኦይድንግንዳ ታሜከ ቃስተንን እድሶ “ኦይትምስባብከስ” ጋይሶ ከትም ኤልሴ። <verse eid="MRK 3:14"/><verse number="15" style="v" sid="MRK 3:15"/>ግምዘንም ከት ዉጅድንግንደረ ገችታ ኤራ ከትካንታ እምሴ።<verse eid="MRK 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16"/>እድምስባብከሰረ ታመከ ቃስተን ኦይትምስባብከስና ኬናከሰኬ፥ ጴጥሮስ ጋይሶ ክት ኤልስባብ ስምኦን፥ <verse eid="MRK 3:16"/><verse number="17" style="v" sid="MRK 3:17"/>ቦኤናርገስ አነረ ጉግንታ ይንችንከስ ጋይሶ ክት ኤልስባብከስ፥ ዛብዶሰታ ይንችንከስ ያይቆበኬ እስመን ዮሀንሰካ፥ <verse eid="MRK 3:17"/><verse number="18" style="v" sid="MRK 3:18"/>እንደርያስ፥ ፍልጶስ፥ በርተሎመዎስ፥ ማቶስ፥ ቶማስ፥ እልፎሰታ ይንች ያይቆብ፥ ታድዮስ ይንታ ፍጨንካንታ ገቀርድባብ ስምኦን፥<note caller="+" style="f"><char style="fr" closed="false">3፡18 </char><char style="ft" closed="false">ቀምስንባብ ጋይንት ዋልቃ ፎለትካ ፍክስንባብከሳርንካ ኖ ዋልቀነ ጋይድባብከስ ዶቅደኬ። </char></note> <verse eid="MRK 3:18"/><verse number="19" style="v" sid="MRK 3:19"/>የሱሰም ስክስት እምስባበረ አስቆሮንት ካተመናርንክንባብ ይሁዴ።<verse eid="MRK 3:19"/></para>
  <para style="s1">የሱሰኬ ብኤልዘቡልካ</para>
  <para style="r">(<ref loc="MAT 12:22-32">ማቶ. 12፡22-32</ref>፤ <ref loc="LUK 11:14-23">ሉቃ. 11፡14-23</ref>፤ <ref loc="LUK 12:10">12፡10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20"/>ኮታ ቡር የሱስ ማት ኤሄን ኮታር አርደዴ። የሱሰኬ ክታ ካርንካ ጎርስምድባብከስ እችም እችካንታ ዎራ ከትም ጋምተርን የለልታ አናካርንካ በድንከስ ሳንምሰኬ። <verse eid="MRK 3:20"/><verse number="21" style="v" sid="MRK 3:21"/>“የሱስ ኤይቴ” ጋይምድንካ ኤሰርሰኮ ክታ ሱሰንከስ ክትም የድካንታ ክደር Ꮊደኬ።<verse eid="MRK 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22"/>የሩሳለማርንካ Ꮊድባብከስ ሙሴታ ህግንም ኤስዝድባብከስ፥ “ክታዘን ብኤልዘቡል ዶቅዴ! ግምዘንመረ ክት ዉጅድንዳ ግምዘን ክድባብ ብኤልዘቡልጎኬ!” ጋየረኮ ኬዘኬ።<verse eid="MRK 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23"/>የሱሰረ ዎርሰንም ይንደር ኤልሶ ካምስካ ኩን ጋይሴ፥ “ሰጣን ሰጣንም Ꮊስግንድክ ዉችካንታ ማዳ።<note caller="-" style="x"><char style="xo" closed="false">3፡23 </char><char style="xt" closed="false"><ref loc="MAT 9:34">ማቶ. 9፡34</ref>፤ <ref loc="MAT 10:25">10፡25</ref>። </char></note> <verse eid="MRK 3:23"/><verse number="24" style="v" sid="MRK 3:24"/>ዋልቃ ባንችና ፋስምሰኮ ክክ ክክ ዋጭምድንዳ ማቼ ኮና ባንችና ዳቅሶ ዎእካንታ ማታዬ። <verse eid="MRK 3:24"/><verse number="25" style="v" sid="MRK 3:25"/>ኮትኮግንደረ ዋልቃ ኤሀኤድ ክክ ክክ ፋስምሴ ዳቅሶ ዎእካንታ ማታዬ፥ <verse eid="MRK 3:25"/><verse number="26" style="v" sid="MRK 3:26"/>ኮካንታ ሰጣን ይንታ ማተንም ይ ግርደኬ ክክ ክክን ከት ፋስምሴ ካይደክ ዳት ዶቅካንታ ማታዬ።<verse eid="MRK 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27"/>“ኮትኮግንደረ ዋልቃ ዎልቀክንባብ ኤችታ ኤር አርድሶ እርናና ዎልቀንክንባብ ኤችንም ዞካክዶቆ ክታ ርን ቡራካንታ ማድባብ ካዬ።<verse eid="MRK 3:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28"/>“ዶፈን የም ጋይድቴ፥ ኤድንከስ ከት ፍግዝድንዳ ጎመንኬ ከትየግድን የክና ሙዳ ከትካንታ ነጋ ጋይምተሬ። <verse eid="MRK 3:28"/><verse number="29" style="v" sid="MRK 3:29"/>ኬዛር ማቼ አያን ጭልንዘን የግድባብ ሙደንዘን ስለንክንደታ ባዛ ክታዘን ማተረ ዳት ቦድሶ ክታ ጎመና ነጋ ክትካንታ ጋይምዳክዬ።” <note caller="-" style="x"><char style="xo" closed="false">3፡29 </char><char style="xt" closed="false"><ref loc="LUK 12:10">ሉቃ. 12፡10</ref>። </char></note> <verse eid="MRK 3:29"/><verse number="30" style="v" sid="MRK 3:30"/>የሱስ ኮም ክት ከዛንዳ፥ “ቱና አያን ክታዘን ዶቅዴ” ከት ገይሳንካንቴ።<verse eid="MRK 3:30"/></para>
  <para style="s1">የሱሰታ እንደንኬ እስመንከስ</para>
  <para style="r">(<ref loc="MAT 12:46-50">ማቶ. 12፡46-50</ref>፤ <ref loc="LUK 8:19-21">ሉቃ. 8፡19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31"/>የሱሰታ እንደንኬ ክታ እስመንከስካ ክደር Ꮊደኬ፥ ማልጎካ ዎእሰኮ ክደር ኤድ ኦይትሰኮ ኤልስሰኬ። <verse eid="MRK 3:31"/><verse number="32" style="v" sid="MRK 3:32"/>ክታ ካንተካ ዶቅሶ Ꮊቅባብ ኤድንከስ፥ “ኮሰቼ! የስታ እንደንኬ የስታ እስመንከስ ማል ዎእሰኮ የስም ዝግደኬ” ገይሰኮ ክትም ኬዘኬ።<verse eid="MRK 3:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33"/>የሱሰረ “ና እስታ እንደና Ꮊይራ? እስታ እስመንከስና Ꮊይከሰረ?” ጋየሮ ማስሴ። <verse eid="MRK 3:33"/><verse number="34" style="v" sid="MRK 3:34"/>ይንታ ካንተንካ ዶቅሶ Ꮊቅባብከዝደር ሰደሮ “ኮሰቸቴ! እስታ እንደንኬ እስታ እስመንከስና ኬናከሰኬ! <verse eid="MRK 3:34"/><verse number="35" style="v" sid="MRK 3:35"/>ሳብታ ጋይተን ቦድባብ ሙደና፥ ኖ እስታ እስመነረ፥ እስታ ምችነነረ፥ እስታ እንደነረ ከቴ” ጋይሴ።<verse eid="MRK 3:35"/></para>
  <chapter eid="MRK 3"/>
  <chapter number="4" style="c" sid="MRK 4"/>
  <para style="s1">ማሰንታ ካምስንከስ</para>
  <para style="r">(<ref loc="MAT 13:10-17">ማቶ. 13፡10-17</ref>፤ <ref loc="LUK 8:4-8">ሉቃ. 8፡4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1"/>የሱስ አናካርንካ ባሀርንታ ላማር ኤስስን የጄ። አንድር በድ ኤድንከሰረ ክደር Ꮊድሰኮ ከታ ሳንንተንካ ኖ ባሀርንዘን ዶቅድን ጃልባ ገየርድንደታር አርድሶ ዶቅሴ፥ ዎርሰነረ ሙዳ ባሀርንታ ካንተዘን Ꮊቄ።<note caller="-" style="x"><char style="xo" closed="false">4፡1 </char><char style="xt" closed="false"><ref loc="LUK 5:1-3">ሉቃ. 5፡1-3</ref>። </char></note> <verse eid="MRK 4:1"/><verse number="2" style="v" sid="MRK 4:2"/>በድ ሪንከስመረ ካምስካ ከትም ኤስይሴ፥ ኤስዝደረ ኩን ከትም ገይሴ።<verse eid="MRK 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 4:3"/>“ኤሰርከቴ! ይና፥ ዎንንባብና ማሰንም ማስካንታ ዉተዴ፥ <verse eid="MRK 4:3"/><verse number="4" style="v" sid="MRK 4:4"/>ክት ማዝድንካ ዋልቃ ዋልቃ ማሰና ጎግንታ ካንተዘን ዋቼ፥ አፍትንከሰረ Ꮊድሶ እቸኬ። <verse eid="MRK 4:4"/><verse number="5" style="v" sid="MRK 4:5"/>አብ ማሰና በድ ፍጫ ካየን ቦምቸዘን ዋቼ፥ ፍጫ ኮታዘን ካየን ኦላር ሳነካ ባቀልሴ፥ <verse eid="MRK 4:5"/><verse number="6" style="v" sid="MRK 4:6"/>ማታጋካ ዳት Ꮊይና ዉተዳንደትካ ሱልሴ፥ በድ ጫጨረ ካየንካንታ ዎቼ። <verse eid="MRK 4:6"/><verse number="7" style="v" sid="MRK 4:7"/>አብ ማሰነረ ኡክምታ ግድያር ዋቼ፥ ኡክምነረ ጋጵሳንደትካ ጉንሳን ካንታ አፍ ኡስክሳ ነገዴ። <verse eid="MRK 4:7"/><verse number="8" style="v" sid="MRK 4:8"/>አብ ማሰና ኡርማ ፍጨዘን ዋችሶ ባቀልሴ፥ ባቅለነረ ጋጵሶ አፍ ኡሴ፥ ዋልቀና ቦንደከ ታማ፥ ዋልቀና ማከን ቦንዳ፥ አብነረ ዶንቅ ቦንዳ አፍ ኡሴ።”<verse eid="MRK 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9"/>ጉጅሰረ የሱስ፥ “ኤሰርድን ቃም ዶቅድባብ ኤሰራ!” ጋይሴ።<verse eid="MRK 4:9"/></para>
  <para style="s1">የሱስ Ꮊረታ ክት ካምስካ ኬዘሮ Ꮊቃናና</para>
  <para style="r">(<ref loc="MAT 13:10-17">ማቶ. 13፡10-17</ref>፤ <ref loc="LUK 8:9-10">ሉቃ. 8፡9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10"/>የሱስ ይንት ክት ማቻን Ꮊይካ ክትም ጎርስምድ Ꮊቃን ኤድንከስኬ ታመኬ ቃስተን ክታ ካርንካ ጎርስምድባብከስ ካምስንከስታ ቡልን ክትም ኦይሰኬ። <verse eid="MRK 4:10"/><verse number="11" style="v" sid="MRK 4:11"/>የሱሰረ፥ “የካንታ ሳብ ባንችምንታ አችምሳን ኤስና እምምቴ”፥ አብንከስካንታ ማቼ ሙዳ ሪን ካምስካ ከትካንታ ኬዝምዴ። <verse eid="MRK 4:11"/><verse number="12" style="v" sid="MRK 4:12"/>ኮነረ ማድንዳ፥</para>
  <para style="q1" vid="MRK 4:12">ከታ ሳብደር ማታይንካንታ</para>
  <para style="q1" vid="MRK 4:12">ከታ ጎመና ነጋ ጋይምዳክንግንዳ፥</para>
  <para style="q1" vid="MRK 4:12">ሰድን ሰደረኮ ቡዳር የዳከኬ፥</para>
  <para style="q1" vid="MRK 4:12">ኤስርንም ኤሰረረኮ ገቀራየኬ ጋይምሳንደት ግንዴ። ኩንጋየሮ ማስሴ።<note caller="-" style="x"><char style="xo" closed="false">4፡12 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">ኢሳ. 6፡9-10</ref>። </char></note><verse eid="MRK 4:12"/></para>
  <para style="s1">ማሰንታ ካምስንከስታ ቡልና</para>
  <para style="r">(<ref loc="MAT 13:18-23">ማቶ. 13፡18-23</ref>፤ <ref loc="LUK 8:11-15">ሉቃ. 8፡11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13"/>የሱስ፥ “የመረ ኮና ካምስና የም አርዳዮ? ኮናና፥ አብ ካምስንከስም ሙዳ Ꮊስግንደንት ኤስካንታ ማዳ? <verse eid="MRK 4:13"/><verse number="14" style="v" sid="MRK 4:14"/>ማሰንባብና ሳብታ ቃለንም ማዝዴ። <verse eid="MRK 4:14"/><verse number="15" style="v" sid="MRK 4:15"/>ቃለና ማስምሳንደትካ ጎግንታ ካንታር ዋቻን ማሰን ሰችዝድንዳ ቃለን ከት ኤሰርሳንᎺይካ ሳነካ ሰጣን Ꮊድሶ ከታ ቡደናር ማስምሳን ቃለን ከታዘንካ ተይምድባብ ኤድንከሴ።<verse eid="MRK 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 4:16"/>“ኮትኮግንደረ ቦምቻካርንዘን ማስምሳንዳ ኮት ሰችዝደንዳ ቃለንም ኤሰርደኮ ሳና ጉርምካ ተይድ ኤድንከስሜ፥ <verse eid="MRK 4:16"/><verse number="17" style="v" sid="MRK 4:17"/>ማችንከረ ከታ ሰጫካንታ ዳት ከታ ቡደናር ጫጭ ኦይታክየ፥ ቶክም ሰጨታ ቡር ቃለንጎካ ማጣ አነረ ዳይር ከታዘን የልድንካ ሳነካ ኮተርሰኮ ዋጅደኬ።<verse eid="MRK 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 4:18"/>“ኡክምንታ ዎክናር ማሰርሳንዳ ጉጅሶ ሰችዝድንዳ ቃለንም ኤሰርድባብ ኤድንከስሜ፥ <verse eid="MRK 4:18"/><verse number="19" style="v" sid="MRK 4:19"/>ማታጋካ ዳት ኮ ፍጫሙደንታ ገቅርና፥ ቆልመታ ሶልመከ አብነረ ዉችኩን አግርና ከታ ቡደናር አርድሶ ቃለንም ጉንእት የድንካንታ አፍ ኡሳዬ። <verse eid="MRK 4:19"/><verse number="20" style="v" sid="MRK 4:20"/>ኡርማ ፍጨንዘን ማሰርሳንዳ ማቼ ኮት ሰጅድንዳ ቃለንም ኤሰርሰኮ ገቀርት ተይድባብ ኤድንከስሜ። ኮግንደና ዋልቀና ቦንደከ ታማ፥ ዋልቀና ማከን ቦንዳ፥ ዋልቀነረ ዶንቅ ቦንዳ አፍ ኡዝዴ”።<verse eid="MRK 4:20"/></para>
  <para style="s1">ዞጰና ሳግድን ካርዘን ዎደርድንደታ ካምስ</para>
  <para style="r">(<ref loc="LUK 8:16-18">ሉቃ. 8፡16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21"/>የሱሰረ “ኤድ ዞጰን ዞጵስትዮ ዳሀ ባኬንታ ዋር ናንከረ አነረ ሰለንታ ጎያር ዎዶ? ከት ዎድንዳ፥ ሳክመና Ꮊፈርድንግንዳ ዞጰን ዎደርድንካርዘን ካዮ?<note caller="-" style="x"><char style="xo" closed="false">4፡21 </char><char style="xt" closed="false"><ref loc="MAT 5:15">ማቶ. 5፡15</ref>፤ <ref loc="LUK 11:33">ሉቃ. 11፡33</ref>። </char></note> <verse eid="MRK 4:21"/><verse number="22" style="v" sid="MRK 4:22"/>ኮትኮግንደረ አችምሳንዳ መያማትክሳ፥ አጥምሳንደረ ኤስማክዶቆ ነጋዬ።<note caller="-" style="x"><char style="xo" closed="false">4፡22 </char><char style="xt" closed="false"><ref loc="MAT 10:26">ማቶ. 10፡26</ref>፤ <ref loc="LUK 12:2">ሉቃ. 12፡2</ref>። </char></note> <verse eid="MRK 4:22"/><verse number="23" style="v" sid="MRK 4:23"/>ይና ኤሰርድን ቃም ዶቅድባብ ኤሰራ!” ኩንጋይሴ።<verse eid="MRK 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24"/>ኮታዘንከረ የሱስ “የ ኤሰርድን ሪይንካንታ ካርስምከቴ! የ ማግድን ርንካ የካንታ ማክምተሬ፥ ኮታዘንከረ ስግዳንዳ የካንታ ጉጅምተሬ።<note caller="-" style="x"><char style="xo" closed="false">4፡24 </char><char style="xt" closed="false"><ref loc="MAT 7:2">ማቶ. 7፡2</ref>፤ <ref loc="LUK 6:38">ሉቃ. 6፡38</ref>። </char></note> <verse eid="MRK 4:24"/><verse number="25" style="v" sid="MRK 4:25"/>ዶቅድባብካንታ እምምተሬ፥ ካየንባብዘንካ ማቼ ና ክታ ዶቅድንዳ ቶክምና ዎራ ክታዘንካ ተይምተሬ” ከትም ገይሴ።<note caller="-" style="x"><char style="xo" closed="false">4፡25 </char><char style="xt" closed="false"><ref loc="MAT 13:12">ማቶ. 13፡12</ref>፤ <ref loc="MAT 25:29">25፡29</ref>፤ <ref loc="LUK 19:26">ሉቃ. 19፡26</ref>። </char></note><verse eid="MRK 4:25"/></para>
  <para style="s1">ጋጵድን ማሰንታ ካምስ</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26"/>ኮታዘንከረ የሱስ፥ “ሳብታ ባንችምና ፍጨዘን ማሰን ማዝድባብ ኤድም ካምዴ። <verse eid="MRK 4:26"/><verse number="27" style="v" sid="MRK 4:27"/>ኤችና ሶይት ራዴ፥ ሰጬ ኖአምዴ፥ Ꮊስግንዳ ኮትናነረ ክት ኤሳክናና ባቀልዴ፥ ጋጵዴ። <verse eid="MRK 4:27"/><verse number="28" style="v" sid="MRK 4:28"/>ፍጨነረ ይንታ ማታ እርምሶ ባቅለንም፥ ኮታዘንከረ ፉጥመንም ና ሰችዝዴ፥ ኮታቡረረ ፉጥመንዘን ኡሳን አፍ Ꮊፈርዴ። <verse eid="MRK 4:28"/><verse number="29" style="v" sid="MRK 4:29"/>አፍ ኡሳንግንዳ ስከርድንዳ ማቻንካንታ ኤችና ሳነካ ባጨንም ግግዝዴ” ኩን ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">4፡29 </char><char style="xt" closed="false"><ref loc="JOL 3:13">ኢዩ. 3፡13</ref>። </char></note><verse eid="MRK 4:29"/></para>
  <para style="s1">ኤክና አፍታ ካምስ</para>
  <para style="r">(<ref loc="MAT 13:31-34">ማቶ. 13፡31-34</ref>፤ <ref loc="LUK 13:18-19">ሉቃ. 13፡18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30"/>የሱስ፥ “ሳብታ ባንችምን Ꮊረካ ክክኖንት የክስተራ? አና Ꮊራ ካምስንከስኮንት መያ ማስተራ? <verse eid="MRK 4:30"/><verse number="31" style="v" sid="MRK 4:31"/>ኤክነንታ አፍ ማሰንም ካምዴ፥ ና ማስምደረ ፍጫዘን ዶቅድን ማሳ ሙደንዘንካ ቶክሳንዴ። <verse eid="MRK 4:31"/><verse number="32" style="v" sid="MRK 4:32"/>ይ ማስምሳንደታ ቡር ጋጵሶ ኮራ ሙደንዘንካ ና ስገዴ፥ ጭለንታ አፍትንከሰረ ኮታ ጎይናር ኤሀ ዎድሰኮ ከታዶቅንት ካንታ ማተርን የለልታ አንድርይ እክመንከስም ዉጅዴ” ኩን ጋይሴ።<verse eid="MRK 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33"/>የሱሰረ ኤድንከስ ገቀርት ተይድንጎካ፥ ከናከስም ካምድን በድ ካምስንከስካ ይንታ ቃለንም ከትካንታ ኬዝድ Ꮊቄ። <verse eid="MRK 4:33"/><verse number="34" style="v" sid="MRK 4:34"/>ካምስካይሰረ ከትም ኤስሳይ Ꮊቄ፥ ከት ይንት ማድንካ ማቼ ሙዳ ሪም ይንታ ካርንካ ጎርስምድባብከስካንታ ከትም አርድንግንዳ ከዝድᎺቄ።<verse eid="MRK 4:34"/></para>
  <para style="s1">የሱስ ሎቀዘን ዞገንም ነክስና</para>
  <para style="r">(<ref loc="MAT 8:23-27">ማቶ. 8፡23-27</ref>፤ <ref loc="LUK 8:22-25">ሉቃ. 8፡22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35"/>ኮት ሰጨናይካ ሶይት የሱስ ይንታካርንካ ጎርስምድባብከስም “ኦስ ባሀርንታ ፋማ ዎ ቃላ” ከትም ጋይሴ። <verse eid="MRK 4:35"/><verse number="36" style="v" sid="MRK 4:36"/>ዎርሰናርንከረ ፋስምሶ ይ አርድሶ Ꮊቃን ሎቀንዘንካ ቃልዝድን ጃልበንካ የሱሰም ተይ አይሰኬ። አብ ጃልበንከሰረ የካ Ꮊቀኬ። <verse eid="MRK 4:36"/><verse number="37" style="v" sid="MRK 4:37"/>ዛብዛንዳ ቡርበች ዞገና አምሶ ሎቀና ጃልበንታ ዋር ጮጭተርን የለልታ ቡርበችና ጃልበንም ዙብድᎺቄ። <verse eid="MRK 4:37"/><verse number="38" style="v" sid="MRK 4:38"/>ኮትᎺይካ የሱስ፥ ጃልበንታ ዋር ቡርጎካ ቃዳ ኦልንደትም ዎድሶ ራትሶ Ꮊቄ፥ ክታ ካርንካ ጎርስምድባብከስ ክትም ንግስሰኮ “ኤስስንባቦ! ዎ ካይድንካ የስካንታ ኤስማዮ?” ክደር ጋይሰኬ።<verse eid="MRK 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39"/>የሱሰረ ንግሶ ዞገንም ዋጬ፥ ባሃርንመሬ “ጫምን ጋይካ!” ጋይሴ፥ ዞገነረ ዛቅሴ፥ አንድር ስምን ጋይንታ ማቼ። <verse eid="MRK 4:39"/><verse number="40" style="v" sid="MRK 4:40"/>የሱሰረ፥ “ኮግንዳ የ ጳዝድንዳ Ꮊራካንተረ? Ꮊስግንዶክ አሜን የንታ ካይዳራ?” ከትም ጋይሴ።<verse eid="MRK 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41"/>ከተረ አንድር ጳስሶ፥ ክክ ክክ “ይና ዞገንከ ባሀርንካ ዎራ ክትካንታ ክትምድባብ ኮና ኖ Ꮊይራ?” ክክ ጋይሰኬ።<verse eid="MRK 4:41"/></para>
  <chapter eid="MRK 4"/>
  <chapter number="5" style="c" sid="MRK 5"/>
  <para style="s1">የሱስ ዋልቃ ግምዘካ የደርስባብ ኤችን ፋችና</para>
  <para style="r">(<ref loc="MAT 8:28-34">ማቶ. 8፡28-34</ref>፤ <ref loc="LUK 8:26-39">ሉቃ. 8፡26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1"/>ገሊለታ ባሀርን ቃልሶ ገርገሰኖን ሞረናር የልሰኬ። <verse eid="MRK 5:1"/><verse number="2" style="v" sid="MRK 5:2"/>የሱስ ሎቀንዘንካ ቃልዝድን ጃልበናርንካ Ꮊንቸርሳንግንዳ ዋልቃ ቱና አያንካ የደርስባብ ኤች ሳነካ ዱክያርንካ ዉትሶ ክትካ Ꮊፈርሴ። <verse eid="MRK 5:2"/><verse number="3" style="v" sid="MRK 5:3"/>ኮና ኤችና ዱክያር ዶቅድ Ꮊቄ፥ Ꮊየሰነረ ሳንቸለትካ ዎራ ዞክሶ ዎድካንታ ማታከኬ። <verse eid="MRK 5:3"/><verse number="4" style="v" sid="MRK 5:4"/>በድᎺይካ ዱት ዞከርድን ስብልኬ አን ዞከርድን ሳንቸለትካ ኖ ዞከርምድ Ꮊቄ፥ ኬዛር ማቼ ሳንችለትን ታክሰርንደትኬ ዱትንታ ስብልነረ ቁንጨሮ ይንዘንካ Ꮊልእዝድ Ꮊቄ፥ ኮካንታ ክትም የድሶ ዎይስካንታ ማድባብ Ꮊየሰነረ ካያ Ꮊቄ። <verse eid="MRK 5:4"/><verse number="5" style="v" sid="MRK 5:5"/>ሙዳᎺይከረ ሶይትኬ Ꮊየካ ነጋክ ዶቆ ዱክ ካራርከ ገቸንከዘን ኦንገሮ ፍብድ Ꮊቄ፥ ይንታ ዘነንመረ ሰይንካ ተቸሮ ድደርዝድ Ꮊቄ።<verse eid="MRK 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6"/>ኖየረ የሱሰም ጎትካ ይ ሰጃን ግንዳ ክደር ዞደካ Ꮊድሶ ይንታ ቡቀንካ ጉምፈርሶ ጎስትሴ። <verse eid="MRK 5:6"/><verse number="7" style="v" sid="MRK 5:7"/>አንድር ኡፍስከረ ፍፈሮ፥ “የና ሙደንዘንካ ስግ ሳብንታ ይንች የሱስዮ! የስታ እንካ ክክን Ꮊራ ዶቅዳ? ሳብታ ላምካ የስም ምግዝድቴ፥ ዋደ እም Ꮊይማእሴ!” ክትም ጋይሴ። <verse eid="MRK 5:7"/><verse number="8" style="v" sid="MRK 5:8"/>ኮመረ ክት ጋይሳን ጎግና፥ “የና ቱና አያንና ኮ ኤችንዘንካ ዉትካ!” ጋይሶ ክትም ክትሳንጎኬ።<verse eid="MRK 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9"/>የሱሰረ “የስታ ላምና Ꮊይራ?” ጋይሶ ክትም ኦይሴ፥ ኖየረ “በድንከስ ዎማቻንካንታ እስታ ላምና ለጎኔ” ጋየሮ ክትካንታ ማስሴ።<note caller="+" style="f"><char style="fr" closed="false">5፡9 </char><char style="ft" closed="false">ለጎን ጋይንትና ዳምንባብከ አነረ ከታ በድምን ሰጅዴ </char></note> <verse eid="MRK 5:9"/><verse number="10" style="v" sid="MRK 5:10"/>ፍጨን ኮታርከረ ከትም ዳይዳክንግንዳ ዳቅስሶ ክትም ምክሴ።<verse eid="MRK 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11"/>ካርንኮታረረ ደንንከስታ ካንተካ በድ ጉድምንከስታ ዉዳ ግስምድ Ꮊቄ። <verse eid="MRK 5:11"/><verse number="12" style="v" sid="MRK 5:12"/>ኮካንታ “ዋደ አይሶቶ ጉድምንከሳር ዎ አርድንግንዳ ዎም ጋይካ” ጋይሰኮ ክትም ምክሰኬ፥ <verse eid="MRK 5:12"/><verse number="13" style="v" sid="MRK 5:13"/>የሱሰረ ከትም አይከቴ ጋይሴ፥ ቱና አያንንከሰረ ኤችን ክታዘንካ ዉትሰኮ ጉድምንከሳር አርደደኬ፥ ዉደናር Ꮊቅባብከስ ቃስተን ሳአ ማድባብ ጉድምንከስ ዎረንዘንካ ታድምካ Ꮊንቸርሰኮ ባሀርናር ኤቅዝምሰኬ።<verse eid="MRK 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14"/>ጉድምን ግዝድባብከስ አጥምሰኮ አይሰኬ፥ ካተመናርንኬ ካተማ ካየንካርያር ኬዘኬ፥ ኤድንከሰረ ማቻን ርን ሰድንካንታ ዋልቃ ዋልቀና ይንታ ኤርንካ ዉተደኬ፥ <verse eid="MRK 5:14"/><verse number="15" style="v" sid="MRK 5:15"/>የሱሰደር Ꮊድሰኮ ኖኮና ቱና አያንንካ የደርሶ Ꮊቅባብ ኤችንታ ቡዳ Ꮊድንካ፥ አፍላ ቆበርሶ፥ ዶቅሶ ክት ዶቅድንካ ከታ ሰድሰኮ ገቅሰኬ። <verse eid="MRK 5:15"/><verse number="16" style="v" sid="MRK 5:16"/>ኮመረ እርምሶ ሰድባብ ኤድንከስ ቱና አያንካ የደርስባብ ኤችንኬ ጉድምንከዘን ይይምሳንደትም ሙዳ ከትካንታ ኬዘኬ።<verse eid="MRK 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 5:17"/>ኮታይካ ፍጨን ኮታር ኤድንከስ የሱስ ከታ ፍጨናርንካ ዉትሶ ክት አይድንግንዳ ከታ ምክሰኬ።<verse eid="MRK 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18"/>የሱስ ሎቀንዘንካ ቃልዝድን ጃልበናር ክት አርዳዶቅድንካ ግምዘንካ የደርስባብ ኤችና “ዋደ እ የስታ ካርንካ ጎርስማ!” ጋይሶ ክትም ምክሴ።<verse eid="MRK 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 5:19"/>የሱስ ማቼ ይንታካርንካ ጎርስምድንግንዳ ክትም ጋያክዬ፥ ኬዛር ማቼ፥ “የስታ ኤሪ አይሳዮ ጮይስ Ꮊራከካ አንድር ሪ የስካንታ ይሳንደትምከ Ꮊስግንዳ የስም አጨርሳናንከረ የስታ ኤድንከስካንታ ኬዝካ” ክትም ጋይሴ።<verse eid="MRK 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 5:20"/>ኤችነረ የሱስ ክትካንታ ይሳን ሪን “ታማ ካተመንከስ” ገይምድን ሞረንከሳር ኬዛ የጄ፥ ኤሰርስባብከሰረ ሙደና በርእድዮᎺቀኬ።<verse eid="MRK 5:20"/></para>
  <para style="s1">እያኢሮሰታ ይንችንኬ የሱሰታ አፍለን ዎልሳን ኤተና</para>
  <para style="r">(<ref loc="MAT 9:18-26">ማቶ. 9፡18-26</ref>፤ <ref loc="LUK 8:40-56">ሉቃ. 8፡40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21"/>የሱስ ሎቀንዘንካ ቃልዝድን ጃልበንካ ባሀርንታ ፋማ አናካርንካ ክት ማቻንደትካ በድ ኤድንከስ ክደር ሳንምሰኬ፥ ኮታይካ ኖ ባሀርንታ ላማር Ꮊቄ። <verse eid="MRK 5:21"/><verse number="22" style="v" sid="MRK 5:22"/>ኮታረረ አይሁድንታ ምክስ ኤሄንታ ገችንባብከሳርንካ ዋልቃባብ Ꮊቄ፥ እያእሮስ ጋይምስባብ ኤች የሱሰም ይ ሰጃንደትካ ክታ ዱትንዘን ዋችሶ <verse eid="MRK 5:22"/><verse number="23" style="v" sid="MRK 5:23"/>“ይንቸን እስታ መረና ደእካንታ የልሶ ዶቅድንኦል፥ ኮት ፋጭተርንግንደከ ሰንፔካ ኮት ዶቅተርንግንዳ ዋደ Ꮊድሰዮ የስታ አንን ኮታዘን ዎድካ!” ጋየሮ ዳቅስሶ ክትም ምክሴ።<verse eid="MRK 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24"/>የሱሰረ ክትካ የካ አይሴ፥ በድ ኤድንከሰረ ክትም ጎርስምሰኮ ክታ ካንተንካ ኡንምሰሮ Ꮊቄ።<verse eid="MRK 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25"/>ታመከ ቃስተን ስላ ማቀስ ዉልእምድንካ ማጠርድንዳ ዋልቃ ኤተን ዋር Ꮊቄ፥ <verse eid="MRK 5:25"/><verse number="26" style="v" sid="MRK 5:26"/>ዋልቃ አክምደርንካ አብ አክምንደር ና አየሮ በድ ማጥርስንደትኬ ይንታ ብረንመረ ሙዳ በይስታ Ꮊቄ። ኬዛር ማቼ እንድንካ ኮታዘን ጉጅመሮ አይሳዳት Ꮊረነረ ኮትካንታ ኡራክዬ። <verse eid="MRK 5:26"/><verse number="27" style="v" sid="MRK 5:27"/>ናየረ የሱሰታ ይተንጎካ ኤሰርሳንካንታ ጉትምድን ዎርሰንታ ዎክናር ክታ ቡርጎካ ና Ꮊድሶ ክታ አፍለን ዎልሴ። <verse eid="MRK 5:27"/><verse number="28" style="v" sid="MRK 5:28"/>ኮመረ ኮት ይሳንዳ፥ “ክታ አፍለን ዎራ እ ዎልሳናና አቅድቴ” ጋይድን አሜንካ Ꮊቄ።<verse eid="MRK 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29"/>ዉልእምድንዳ ኮታ ማቀስነረ ሳነካ ዎእሴ፥ Ꮊዝምናርንከረ ኮታ አቅንተና ኮታ ዘነንዘን ኤስምሴ <verse eid="MRK 5:29"/><verse number="30" style="v" sid="MRK 5:30"/>የሱሰረ ሳነካ ይንዘንካ ዎልቃ ዉተዳንደትም ኤስሶ፥ ዎርሰንደር ዋልንጋይሶ “አፍለን እስታ ዎልስባብ Ꮊይራ?” ጋይሶ ኦይሴ።<verse eid="MRK 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31"/>ክታ ካርንካ ጎርስምድባብከሰረ፥ “ዎርሰና ጉትመረኮ የስም ከት ጎርስምድንካ ሰደረዮ፥ ‘Ꮊይራ እም ዎልስባብ?’ ጋይተራ?” ጋይሰኬ።<verse eid="MRK 5:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32"/>የሱሰረ ኮም ይስባብ Ꮊይናነረ ሰድንካንታ ዋልንጋይሶ ሰጄ። <verse eid="MRK 5:32"/><verse number="33" style="v" sid="MRK 5:33"/>ኤተና ማቼ ይንዘን ይይምሳን ኤስንተካ ጳስካ ጭጨሮ ክታ እሪ ና ዋችሶ ዶፈንን ሙዳ ክትካንታ ና ኬዜ። <verse eid="MRK 5:33"/><verse number="34" style="v" sid="MRK 5:34"/>የሱሰረ “እስታ ይንቸኖ፥ የስታ አሜንና የስም አቅስቴ፥ ኡርመካ አይካ፥ የስታ ማጥርናርንከረ ኡክንካ” ኮትም ጋይሴ።<verse eid="MRK 5:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35"/>የሱስ አክኮም ኬዘዘን ክት ዶቅድንካ፥ አይሁድንታ ምክስ ኤሄንም ገችዝድባብታ ኤርንካ Ꮊድባብ ኤድንከስ ምክስ ኤሄንም ገችዝድባብም፥ “የስታ ይንቸና ደእቴ፥ ይና Ꮊራካንተስ ኤስስንባብም ጋብዝዳ?” ክትም ጋይሰኬ።<verse eid="MRK 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36"/>የሱስ ማቼ ኮም ኤሰርሶ አይሁድንታ ምክስ ኤሄንታ ገችንባብም፥ “አሜንካ ዳት Ꮊይ ጳሴ!” ክትም ጋይሴ። <verse eid="MRK 5:36"/><verse number="37" style="v" sid="MRK 5:37"/>የሱስ ጴጥሮሰኬ ያይቆብካ፥ ያይቆብተረ እስመን ዮሀንሰዘንካ አብ፥ Ꮊየሰነረ ይም ጎርስምድንግንዳ ጋያክዬ። <verse eid="MRK 5:37"/><verse number="38" style="v" sid="MRK 5:38"/>አይሁድንታ ምክስ ኤሄንታ ገችንባብታ ኤር ከት የልሳንደትካ የሱስ ኤድንከስ ቃየረኮ ኤብድንካ፥ ከት ፍብድንከረ ሰጄ። <verse eid="MRK 5:38"/><verse number="39" style="v" sid="MRK 5:39"/>ኤሄናረረ አርድሶ፥ “ኮና ሙዳ አዉልንኬ ኤፍንካ Ꮊረተረ? ይንቸና ራታ ዳት ና ደአክዬ” ከትም ጋይሴ።<verse eid="MRK 5:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40"/>ኤድንከሰረ Ꮊልተርካ ክታዘን ይንጨኬ፥ የሱስ ማቼ ሙደንመረ ኤሄናርንካ ዉችሴ፥ ይንቸንንታ ባቤንም እንደንምኬ ክትከረ ክክን Ꮊቅባብከስም ጎርስሶ፥ ይንቸንና ዶቅድን ካርናር አርደዴ። <verse eid="MRK 5:40"/><verse number="41" style="v" sid="MRK 5:41"/>ኮታዘንከረ ይንቸንንታ አንን የድሶ፥ “ጣልቶ ዎእካ!” ኮትም ጋይሴ፥ ኮታ ቡልነረ “የና ይንቸኖ አምካ የስም ጋይድቴ” ጋይንትዬ።<verse eid="MRK 5:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42"/>ይንቼነረ ታመኬ ቃስቴን ስለታ ይንች ና Ꮊቄ፥ ሳነካ አምትዮ ኦስከ ፈንካ ኦንጋ የጄ፥ ኮነረ ማቻንደትካ ኤድንከስ አንድር በርእሰኬ። <verse eid="MRK 5:42"/><verse number="43" style="v" sid="MRK 5:43"/>የሱስ ማቼ ኮም ርን Ꮊየነረ ኤዝዳክንግንዳ ከትም ዳቅስሶ ክትስንደትከ “ኮት እጅድንደትም እምከቴ!” ከትም ጋይሴ።<verse eid="MRK 5:43"/></para>
  <chapter eid="MRK 5"/>
  <chapter number="6" style="c" sid="MRK 6"/>
  <para style="s1">የሱሰም ናዝረት ፍጨናር ክታዘን የልሳን ግርና</para>
  <para style="r">(<ref loc="MAT 13:53-58">ማቶ. 13፡53-58</ref>፤ <ref loc="LUK 4:16-30">ሉቃ. 4፡16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1"/>የሱስ ኮታርንካ ዉትሶ ይንታ ፍጨናር Ꮊዴ፥ ክታ ካርንካ ጎርስምድባብከሰረ ክትም ጎርስምሰኬ። <verse eid="MRK 6:1"/><verse number="2" style="v" sid="MRK 6:2"/>አይሁድንታ Ꮊዉስ ሰጨንካ ከታ ምክስ ኤሄናር ኤስስ የጄ፥ በድ ኤድንከስ ኮታር Ꮊፈርሰኮ ክደር ኤሰርድ Ꮊቀኬ፥ ከተረ “ኮና ኤችና ኮም ሙዳ ርን Ꮊምንክክ Ꮊፍሳሬ? Ꮊስግንዳ ኤጫ ክትካንታ እምምሳረ? ከትከነም አተን ክት ይድንዳ Ꮊስግንደረ?” ጋየረኮ በርእድ Ꮊቀኬ። <verse eid="MRK 6:2"/><verse number="3" style="v" sid="MRK 6:3"/>ኮታዘንከረ “የለተ ኖኮና Ꮊቀን Ꮊዝድባብ ማራመታ ይንች ካዮ? ያይቆበታ፥ ዮሰታ ይሁደተኬ ስምኦነታ እስመና ካዮ? ክታ ምችነንከሰረ ኬና ዎንካ ክክን ካየኮ?” ጋየረኮ ክትም ቶቸካ ኤሰርክሳ ነገደኬ።<verse eid="MRK 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4"/>የሱስ ማቼ፥ “ሳብዘንካ ኤስርሶ ኬዝድባብ አብንከዝደር ቦንችምዴ፥ ይንታ ገታ ፍጨንዘን፥ ይንታ ሱሰንከዝደርኬ ይንታ ኤሀ ኤድንከዝደር ማቼ ቶችምዴ” ጋየሮ ከትካንታ ማስሴ።<note caller="-" style="x"><char style="xo" closed="false">6፡4 </char><char style="xt" closed="false"><ref loc="JHN 4:44">ዮሀ. 4፡44</ref>። </char></note><verse eid="MRK 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 6:5"/>ኮታረረ ቶክም Ꮊዝምባብከዘን ይንታ አንን ዎድሶ ፋችዘንካ አብ አተን ፍክሳክዬ። <verse eid="MRK 6:5"/><verse number="6" style="v" sid="MRK 6:6"/>ዎርሰና አሜንክሳ ከታ ነግንካ አንድር በርእሴ፥ ኮተረ ቡር የሱስ ሞረንከሳር ኦንገሮ ኤስዝድ Ꮊቄ።<verse eid="MRK 6:6"/></para>
  <para style="s1">ታመከ ቃስተን ኦይትምስባብከስ ኤስስካንታ ኦይትምና</para>
  <para style="r">(<ref loc="MAT 10:5-15">ማቶ. 10፡5-15</ref>፤ <ref loc="LUK 9:1-6">ሉቃ. 9፡1-6</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7"/>ታሜከ ቃስተንከስም ይንደር ኤልሶ ቃስተን ቃስተን ማስሶ ከትም ኦይቼ፥ ዳቅል አያንንከዘነረ ዎልቃ ከትም እምሴ። <verse eid="MRK 6:7"/><verse number="8" style="v" sid="MRK 6:8"/>ኬታ ጎግታ ጉፈዘንካ አብ ሶለረ ማታ ቦርሳ፥ ብረረ ይንታ ክስናር ከት የዳክንግንዳ ክትሴ።<note caller="-" style="x"><char style="xo" closed="false">6፡8 </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">ሉቃ. 10፡4-11</ref>። </char></note> <verse eid="MRK 6:8"/><verse number="9" style="v" sid="MRK 6:9"/>“የንታ ዱትናር ጫማ አርችከቴ ዳት ቃስተን ሳምዝ Ꮊይ ቆበረተ ከትም ጋይሴ። <verse eid="MRK 6:9"/><verse number="10" style="v" sid="MRK 6:10"/>Ꮊምንካርዘነረ ዋልቃ ኤታ ኤሪ አርደቶ፥ ካርንኮትም የ ዛቅተርን የለልታ ኮታር ዶእከቴ። <verse eid="MRK 6:10"/><verse number="11" style="v" sid="MRK 6:11"/>ኤድንከስ የም ሞግዳክንካርያርከ የም ኤሰርዳክን ካርዘን ሙዳ የንታ ዱትንታ ቡልንም ድንግስሰቶ ኮታርንካ ዉትሰቶ አይከቴ፥ ኮነረ ከትካንታ ኤግዝምስታ ማርካ ከታዘን ማተረ” ከትም ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">6፡11 </char><char style="xt" closed="false"><ref loc="ACT 13:51">ኦይት. ፍ. 13፡51</ref>። </char></note><note caller="+" style="f"><char style="fr" closed="false">6፡11 </char><char style="ft" closed="false">ግዝንታ ክላ ጫቀንከ 1947 ስለናር ጻፍምሳንዳ ጋማ አፈንካ ጻፍምሳንዳ ጭልና ኮዘንካ ኦስንም ጉጅዴ፥ “ዶፈን የም ጋይድቴ፤ ኮት ካተመንዘንካ ስክስሶ ሰዶም ካንተከ ገሞራ ካንታ ሳብታ ፍርዳ ሰጨንካ ከትካንታ ቶግዴ” ኬና ኬዘና ማቸ Ꮊምን ግርክንታ ኤናር ካዬ። </char></note><verse eid="MRK 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12"/>ኦይትምስባብከሰረ ኮታርካ ዉትሰኮ፥ ኤድንከስ ሙዳ ጎማ ይንታ ፍክስን ከት ዎይዝድንግንዳ ኤስሰኬ። <verse eid="MRK 6:12"/><verse number="13" style="v" sid="MRK 6:13"/>በድ ግምዘንከስመረ ዉችሰኬ፥ በድ ኤድንከስመረ ዛይት ሳየረኮ ፋችሰኬ።<verse eid="MRK 6:13"/></para>
  <para style="s1">ስእስንባብ ዮሀንሰታ ደእና</para>
  <para style="r">(<ref loc="MAT 14:1-12">ማቶ. 14፡1-12</ref>፤ <ref loc="LUK 9:7-9">ሉቃ. 9፡7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14"/>የሱሰታ ላምና ሙደንደር ኤስምሳን ኦል፥ ባንችና ሄረዶስ ክትጎካ ኤሰርሴ። ዋልቃ ዋልቃ ኤድንከስ፥ “ስእስንባብ ዮሀንስ ደእያርንካ አምቴ፥ ኮካንታ ኮና ሙዳ አተና ክትካ ይይምዴ” ጋየሮ Ꮊቀኬ። <verse eid="MRK 6:14"/><verse number="15" style="v" sid="MRK 6:15"/>አብንከሰረ “ኤላሴ” ጋይሰኬ። ነገድባብከሰረ ጉጅሶ “ኤና እሪ ሳብዘንካ ኤሰርሶ ኬዛቅባብከሳርንካ ዋልቀንግንዴ” ጋይደኮ Ꮊቀኬ።<note caller="-" style="x"><char style="xo" closed="false">6፡15 </char><char style="xt" closed="false"><ref loc="MAT 16:11">ማቶ. 16፡11</ref>፤ <ref loc="MRK 8:28">ማር. 8፡28</ref>፤ <ref loc="LUK 9:19">ሉቃ. 9፡19</ref>። </char></note><verse eid="MRK 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16"/>ሄረዶስ ማቼ ኮም ሙዳ ኤሰርሶ፥ “ኮና እ ክታ ባርን ተችስባብ ዮሀንሴ፥ ኮናና! ኖ ደእያርንካ አምሴ”፥ ጋይሴ። <verse eid="MRK 6:16"/><verse number="17" style="v" sid="MRK 6:17"/>ኮነረ ሄረዶስ ይንታ እስመን ፍልጶሰታ ኬነን ሄሮድያደም እንቸንካ ዮሀንሰም ኮትጎካ የችሶ ዞክና ኤሀር ዞክስሶ Ꮊቄ። <verse eid="MRK 6:17"/><verse number="18" style="v" sid="MRK 6:18"/>ዮሀንሰረ ክት ዞከርሳንዳ፥ ሄረዶሰም “የስታ እስመንታ ኬነንም የስታ እንቸና ዝግዝድንዳ ካዬ!” ጋይድ Ꮊቃንኦሌ።<note caller="-" style="x"><char style="xo" closed="false">6፡18 </char><char style="xt" closed="false"><ref loc="LUK 3:9-20">ሉቃ. 3፡9-20</ref>። </char></note><verse eid="MRK 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19"/>ሄሮድያደረ ኮካ ይምኤርሶ ዮሀንሰም ደይስስካንታ ዝግድ Ꮊቄ፥ ኬዛር ማቼ ኮትካንታ ማታክዬ። <verse eid="MRK 6:19"/><verse number="20" style="v" sid="MRK 6:20"/>ሄረዶስ እርምሶ ዮሀንስ ጭልምስባብከ ሳብካንታ ፋስምስባብ ማትንተን ይ ኤዝድንኦል ክትም ጳሰሮ ካርዝድ Ꮊቄ። ሄረዶስ ዮሀንሰታ ኬዘንም ይ ኤሰርሳንᎺይካ ሙዳ ኦይምድ Ꮊቄ፥ ማታጋካ ዳት ጉርምካ ክትም ኤሰርድ Ꮊቄ።<verse eid="MRK 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21"/>ሄረዶስ ይ አጠርሳን ሰጨን ቦንቻካንታ ባንችንታ ገችታ ኤረንባብከስካንታ፥ ዳምንባብከስታዘን ዶርምስባብከስካንተኬ ዋልቃ ዋልቃ ኤስምስባብ ገሊላር ዶቅድን ኤድንከስም ሞካካንታ ግክሴ፥ ኮነረ ሄሮድያዳ ክትም Ꮊፍካንታ ኡርማ ሰጫ ኮትካንታ ማቼ። <verse eid="MRK 6:21"/><verse number="22" style="v" sid="MRK 6:22"/>ኮካንተረ ሄሮድያደታ ይንቸና ሞከርድን ኤሄናር አርድሶ ኮት ይግድንካ ሄረዶሰምንኬ ክትካ ክክን እችምንዘን ዶቅድባብከስም ና ጉርምሴ። ባንችነረ ይንቸን፥ “የስ ዝግድን Ꮊምንመረ ሙዳ እም ኦይስካ፥ እታ የስካንታ እምትቴ” ኮደር ጋይሴ። <verse eid="MRK 6:22"/><verse number="23" style="v" sid="MRK 6:23"/>“እስታ ባንችምንተረ የከንም ዎራ ማቼ፥ እም የስ ኦይዝድንደትም ሙዳ የስካንታ እምድቴ!” ጋየሮ ኮትካንታ ጫቅሴ።<verse eid="MRK 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24"/>ናየረ ይንታ እንደንደር አይሶ፥ “Ꮊርስ ክትም ኦይስቴ?” ኮደር ጋይሴ፥ እንደነረ “ስእስንባብ ዮሀንሰታ ቃደን እምካ፥ ጋይሰዮ ክትም ኦይስካ”፥ ኮትም ጋይሴ።<verse eid="MRK 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25"/>ይንቸነረ ሳና ጭጭመትካ ባንችንደር ማትሶ፥ “ስእስንባብ ዮሀንሰታ ቃደን ጋበትታ ዋር ታ እካንታ እምምድንግንዳ ዝግድቴ” ጋየሮ ና ኦይሴ።<verse eid="MRK 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26"/>ባንችና ኮ ጋይተንካ አንድር ሞርእሴ፥ ማታጋካ ዳት እችምዘን ዶቅስባብከስታ እር ይ አርደዳን ጫቀንታ ኮት ኦይሳንደትም ማርካንታ ዝጋክዬ። <verse eid="MRK 6:26"/><verse number="27" style="v" sid="MRK 6:27"/>ኮካንታ ባንችና ሳነካ ዋልቀን ካርስንባብ ፖልስን ዮሀንሰታ ቃደን ተችትዮ ተይ Ꮊድንግንዳ ኦይቼ፥ ፖልስነረ ዞክና ኤሄናር አይሶ ዮሀንሰታ ቃደን ተቼ፥ <verse eid="MRK 6:27"/><verse number="28" style="v" sid="MRK 6:28"/>ተችምሳን ቃደንመረ ጋበትታ ዋር ተይᎺድሶ ይንቸንንካንታ እምሴ፥ ይንቸነረ ይንታ እንደንካንታ እምሴ። <verse eid="MRK 6:28"/><verse number="29" style="v" sid="MRK 6:29"/>ዮሀንሰታ ካርንካ ጎርስምድባብከስ ኮም ከታ ኤሰርሳንᎺይካ Ꮊድሰኮ ለይስንም ተይ አይሰኮ ዱክሰኬ።<verse eid="MRK 6:29"/></para>
  <para style="s1">የሱስ በድ ኤድንከስም እችና</para>
  <para style="r">(<ref loc="MAT 14:13-21">ማቶ. 14፡13-21</ref>፤ <ref loc="LUK 9:10-17">ሉቃ. 9፡10-17</ref>፤ <ref loc="JHN 6:1-14">ዮሀ. 6፡1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30"/>ኦይትምስባብከስ ከታ ይ ክትምሳን ካርናርንካ ማት Ꮊድሰኮ የሱሰታ እር ሳንምሰኬ፥ ከታ ይ ይሳንደትምከ ኤስሳንደትም ሙዳ ክትካንታ ኬዘኬ። <verse eid="MRK 6:30"/><verse number="31" style="v" sid="MRK 6:31"/>የሱሰረ “የታ የንት ዋልቃ Ꮊርን ጋይሳን ካርዘን አይሰቶ ቶክም Ꮊዉስከቴ”፥ ከትም ጋይሴ፥ ኮመረ ክት ጋይሳንዳ Ꮊረታ ጋይሴ ከደር Ꮊድባብከስከ አይድባብ በድንከስ ማቻንካንታ እችምካንታ ዎራ ሳዓት ከትካንታ ካየንካንቴ። <verse eid="MRK 6:31"/><verse number="32" style="v" sid="MRK 6:32"/>ኮካንታ ይንት ከታ ዶቅካንታ ሎቀንዘንካ ቃለርድን ጃልበናር አርድሰኮ ዋልቃ Ꮊርን ጋይሳን ካርያር፥ አይሰኬ።<verse eid="MRK 6:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33"/>ማታጋካ ዳት ከት አይድንካ በድ ኤድንከስ ሰድሰኮ ከትም ኤሰኬ፥ Ꮊክ Ꮊክ ካተመንከሳርንከረ ዉትሰኮ ዱትካ ዞደረኮ ከትም እርምሰኮ ከደር ሳንምሰኬ። <verse eid="MRK 6:33"/><verse number="34" style="v" sid="MRK 6:34"/>የሱስ ሎቀንዘንካ ቃልዝድን ጃልበናርንካ Ꮊንቸርድዮ በድ ኤድንከስም ኖ ሰጄ፥ ግስመንባብ ከታ ካየን ቆልግንዳ ከታ ማትንተንከረ ከትካንታ ሞርእሴ፥ በድ ሪመረ ከትም ኤስስ የጄ።<note caller="-" style="x"><char style="xo" closed="false">6፡34 </char><char style="xt" closed="false"><ref loc="NUM 27:17">ፋይ. 27፡17</ref>፤ <ref loc="1KI 22:17">1 ባንቺ. 22፡17</ref>፤ <ref loc="2SA 18:16">2 ሳሙ. 18፡16</ref>፤ <ref loc="EZK 34:5">ሕዝ. 34፡5</ref>፤ <ref loc="MAT 9:36">ማቶ. 9፡36</ref>። </char></note> <verse eid="MRK 6:34"/><verse number="35" style="v" sid="MRK 6:35"/>ሰጨና ሶይተሮ አይድንካንታ ክታካርንካ ጎርስምድባብከስ ክደር Ꮊድሰኮ ኩን ጋይሰኬ፥ “ኮና ካርና ኤድ ካየንካርዬ፥ ሰጨነረ ሶይቴ፥ <verse eid="MRK 6:35"/><verse number="36" style="v" sid="MRK 6:36"/>ከት እጅድንዳ ካየንካንታ ሞረናር ዶቅድን ካተመን ካየንከሳርኬ የለንከሳር አይሰኮ እችም ከት ሰንድንግንዳ ኬና ኤድንከስም ኦይትካ” ክትም ጋይሰኬ።<verse eid="MRK 6:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37"/>የሱስ ማቼ፥ “ከት እጅድንደትም የታ እምከቴ” ጋየሮ ማስሴ። ከተረ “ይና፥ አይሶቶ ከት እጅድንደትም ቃስተን ጸታ ብራ ጣገረካ ሰንት እምተሮቶ?” ጋይሰኬ።<note caller="+" style="f"><char style="fr" closed="false">6፡37 </char><char style="ft" closed="false">ድናር ጋይንትና ዋልቃ ሰጨታ ፍክስባብካንታ ናከርድንዴ። </char></note><verse eid="MRK 6:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38"/>የሱሰረ “መም ሶላ የንደር ዶቅዳ? ይና አይሰቶ የ ሰድኔ”፥ ከትም ጋይሴ፥ ከተረ ሰድሰኮ “ዶንቅ ሶለኬ ቃስተን ሞለካ ዶቅዴ”፥ ክደር ጋይሰኬ።<verse eid="MRK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39"/>የሱሰረ ዎርሰንም Ꮊክ Ꮊክ ፋስሶ፥ ጮልሳን ድረዘን ከትም ዶቅዝድን ግንዳ ይንታ ካርንካ ጎርስምድባብከስም ክትሴ። <verse eid="MRK 6:39"/><verse number="40" style="v" sid="MRK 6:40"/>ኮካንታ ዎርሰና ባንግና ጸታ አና ባንግና ቃስተን ቦንደከ ታማ ማትሰኮ Ꮊክ Ꮊክ ፋስምሰኮ ዶቅሰኬ። <verse eid="MRK 6:40"/><verse number="41" style="v" sid="MRK 6:41"/>የሱሰረ ዶንቅ ሶለንምከ ቃስተን ሞለን የድሶ፥ ፈስ ጭላር ሰድሶ ጋለቼ፥ ሶለንም አስትዮ ኤድንከስካንታ ከት የልዝድንግንዳ ይንታ ካርንካ ጎርስምድባብከስካንታ እምሴ። ኮትኮግንደረ ቃስተን ሞለን ሙደንካንታ የልስሴ። <verse eid="MRK 6:41"/><verse number="42" style="v" sid="MRK 6:42"/>ሙደነረ እችሶ ምሰኬ። <verse eid="MRK 6:42"/><verse number="43" style="v" sid="MRK 6:43"/>ክታ ካርንካ ጎርስምድባብከሰረ ስጣንደትም ዶከን ታመከ ቃስተን ጋበትካ ጮጭ ሳንሰኬ። <verse eid="MRK 6:43"/><verse number="44" style="v" sid="MRK 6:44"/>ሶለንም እችባብ አⷝነንከስታ ፋይደና ዶንቅ ሳአ Ꮊቀኬ።<verse eid="MRK 6:44"/></para>
  <para style="s1">የሱስ ባሀርንዘን ሙከሮ ክታ አይና</para>
  <para style="r">(<ref loc="MAT 14:22-33">ማቶ. 14፡22-33</ref>፤ <ref loc="JHN 6:15-21">ዮሀ. 6፡15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45"/>የሱስ ሳነካ ዎርሰንም ኦይተሮ ክት ዶቅድንካ ክታ ካርንካ ጎርስምድባብከስ ሎቀንዘንካ ቃልዝድን ጃልበንካ ኦስ ፋማ በቴሳይዳ ካተመናር ቃልሰኮ ከት እር አይድንግንዳ ክትሴ። <verse eid="MRK 6:45"/><verse number="46" style="v" sid="MRK 6:46"/>ኮታ ቡር ከታዘንካ ፋስምሶ ምክስካንታ ገቸንዘን ዉተዴ። <verse eid="MRK 6:46"/><verse number="47" style="v" sid="MRK 6:47"/>ፍጨና ሶይድንካ ሎቀንዘንካ ቃልዝድን ጃልበና ባሀርንታ ግድያር ዶቅድንካ የሱስ ማቼ ይንት ፍጫዘን Ꮊቄ። <verse eid="MRK 6:47"/><verse number="48" style="v" sid="MRK 6:48"/>ክታ ካርንካ ጎርስምድባብከስ ከታዘን ዞግድን ዞገንጎካ በይካንታ ማጠርድንካ ከትም ሰጄ፥ ሶይትናርንከረ ሳክላ ሳኣትዘንካ የድሶ ታመከ ቃስቴን ሳዓት ዶቅድንደታር ባሀርንዘንካ ሙከሮ ከደር Ꮊዴ፥ ከትም ስግሰረ አይዳ ዶቆ። <verse eid="MRK 6:48"/><verse number="49" style="v" sid="MRK 6:49"/>ኬዛር ማቼ ከታ ባሀርንዘንካ ሙከሮ ክት አይድንካ ሰድሰኮ ቡንከም ካምስንካ ፍፍሰኬ። <verse eid="MRK 6:49"/><verse number="50" style="v" sid="MRK 6:50"/>ሙደነረ ክትም ሰዳንደትካ ገቅሰኬ።</para>
  <para style="p" vid="MRK 6:50">የሱስ ማቼ ሳነካ፥ “ዳእከቴ! እትቴ! Ꮊይጳሰቴ!” ከትም ጋይሴ። <verse eid="MRK 6:50"/><verse number="51" style="v" sid="MRK 6:51"/>ኮታዘንከረ ሎቀንዘንካ ቃልዝድን ጃልበናረረ አርድሶ፥ ከትካ ክክን ክት ማቻንደትካ ዞገና ዎእሴ፥ ክታ ካርንካ ጎርስምድባብከሰረ አንድር በርእሰኬ። <verse eid="MRK 6:51"/><verse number="52" style="v" sid="MRK 6:52"/>ይና፥ ከታ ቡደና ገቀርክሳ ነግድንካ ሶለንታ አተንም ገቀርት ተይክሳ ነግሰኮ ዳት ኮና ርና ከትም በርእስስተራክ ዶቆ።<verse eid="MRK 6:52"/></para>
  <para style="s1">የሱስ ገንሰረጥ ካተመናር ሰቅምንክንባብከስም አቅስና</para>
  <para style="r">(<ref loc="MAT 14:34-36">ማቶ. 14፡34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53"/>ባሀርን ቃልሰኮ፥ ገንሰረጥ ካተመናር የልሰኬ፥ ጃልበንም ባሀርንታ ካንተዘን ዉችሰኮ ዞክሰኬ፥ <verse eid="MRK 6:53"/><verse number="54" style="v" sid="MRK 6:54"/>ጃልበናርንካ ከታ ይ Ꮊንቸርሳንግንዳ ሳነካ ኤድንከስ የሱሰም ኤሰኬ። <verse eid="MRK 6:54"/><verse number="55" style="v" sid="MRK 6:55"/>ከተረ ፍጨንኮታር ዞደረኮ የሱስ ዶቅድን ካርናር ሙዳ ሰቅምንባብከስም Ꮊቸካ ባልትዮ ተይ Ꮊድ የጀኬ። <verse eid="MRK 6:55"/><verse number="56" style="v" sid="MRK 6:56"/>ክት አይሳን ካርሙደናር ሞረናርንካ፥ ካተመናርንካ፥ ካተማ ካየናርንከረ ሰቀርስባብከስም መለንዘን ተይ Ꮊደረኮ ክታ እሪ ዎድᎺቀኬ፥ ክታ አፍለንታ ካንተንም ዎራ ከት ዎልድንግንዳ ክትም ምግዝድ Ꮊቀኬ፥ ክትም ዎልስባበረ ሙደና ፋጭድ Ꮊቀኬ።<verse eid="MRK 6:56"/></para>
  <chapter eid="MRK 6"/>
  <chapter number="7" style="c" sid="MRK 7"/>
  <para style="s1">ባቤንከስታ ዎገንጎካ</para>
  <para style="r">(<ref loc="MAT 15:1-9">ማቶ. 15፡1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1"/>ፈረሳዊያንንከስ የሩሳሌማርንካ Ꮊድባብከስ ዋልቃ ዋልቃ ሙሴታ ህግንም ኤስዝድባብከስ የሱሰደር Ꮊድሰኮ ክታ ካንተንካ ሳንሰኬ። <verse eid="MRK 7:1"/><verse number="2" style="v" sid="MRK 7:2"/>የሱሰታ ካርንካ ጎርስምድባብከሳርንካ ዋልቃ ዋልቀንከስ አርናክን ገይንት ስኤራክን አንካ ሶላ ከት እጅድንካ ሰደኬ። <verse eid="MRK 7:2"/><verse number="3" style="v" sid="MRK 7:3"/>ፈረሳዊያንንከስከ ነግድን አይሁድንከስ ጋልተንከስታ ዎገንም ካርሰካ ከታ ይንታ አንንም ዎገንግንዳ ስኤራክንዳ ማቼ እቻየኬ። <verse eid="MRK 7:3"/><verse number="4" style="v" sid="MRK 7:4"/>ኮግንደረ ጋበንካ Ꮊድሰኮ ስኤራከክ ዶቆ እቻየኬ፥ ሶርቀን፥ ዳሄን፥ ጋይካ ኡርሰርሳንደትምኬ ሰለንም፥ ስኤርድንደትግንዳ፥ አበረ በድ ዎግን ካርዝደኬ።<verse eid="MRK 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5"/>ኮካንታ ፈረሳዊያንንከስ ሙሴታ ህግንም ኤስዝድባብከስኬ “የስታ ካርንካ ጎርስምድባብከስ ጋልተንከስታ ዎገንም ግርንተካ፥ Ꮊረተክ ከታ ይንታ አን ስኤራክዶቆ ሶለንም እጅዳ?” ጋየረኮ የሱሰም ኦይሰኬ።<verse eid="MRK 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6"/>የሱሰረ “የታ ኦትረንባብከሶ!” ኢስያስ ቤርድዮ የጎካ፥</para>
  <para style="q1" vid="MRK 7:6">ኮና ዎርሰና ይንታ አፈካ Ꮊክ እምቦንጅደክ ዳት</para>
  <para style="q1" vid="MRK 7:6">ቡደና እዘንካ ጎተርሳንዴ!<verse eid="MRK 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7"/>“ኤድ ፍክሳን ዎገን ሳብታ ዎገንግንዳ ማስሰኮ ኤሰረኮ ዉችኩን እም ጎይንደኬ! ጋይሶ ክት ኬዛን ቤርና ዶፈኔ፥ ኩንጋየሮ ከትካንታ ማስሴ።<note caller="-" style="x"><char style="xo" closed="false">7፡7 </char><char style="xt" closed="false"><ref loc="ISA 29:13">ኢሳ. 29፡13</ref>። </char></note><verse eid="MRK 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8"/>“ኮካንታ የታ ሳብታ ክተን ዛቅሰቶ ኤታ ዎገንም ካርዝደቴ”።<verse eid="MRK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9"/>ኮታዘንከረ የሱስ፥ “የንታ ዎገንም ካርስካንታ ገየረቶ ሳብታ ክተንም ዛቅደቴ፥ ኩን ከትም ጋይሴ። <verse eid="MRK 7:9"/><verse number="10" style="v" sid="MRK 7:10"/>ሙሳ፥ ‘የስታ ባበንምከ እንደንም ቦንችካ፥ ጉጅሰረ ይንታ ባበንዘን አነረ እንደንዘን ዳቅልን ኬዝድባብ Ꮊየነረ ደእ ክትም ዝግዝዴ’ ጋይዴ።<note caller="-" style="x"><char style="xo" closed="false">7፡10 </char><char style="xt" closed="false"><ref loc="EXO 20:12">ዉት. 20፡12</ref>፤ <ref loc="EXO 21:17">21፡17</ref>፤ <ref loc="DEU 20:9">ካሪ. 20፡9</ref>፤ <ref loc="DEU 5:16">ካሪ. 5፡16</ref>። </char></note> <verse eid="MRK 7:10"/><verse number="11" style="v" sid="MRK 7:11"/>የታ ማቼ ኩን ጋይደቴ፥ ‘ዋልቃ ኤድ ይንታ ባበንካንታ አነረ ይንታ እንደንካንታ አላ ዝግዝድንካ ይ ክትም ዝግዝድንደትም ሪን ሙዳ ሳብካንታ እ እምሳንዳ እሜ’ የንደር ጋይዴ፥ <verse eid="MRK 7:11"/><verse number="12" style="v" sid="MRK 7:12"/>ይንታ ባቤንምኬ ይንታ እንደንም አሌዘንካ ዉች ክትም ነግዝደቴ፥ <verse eid="MRK 7:12"/><verse number="13" style="v" sid="MRK 7:13"/>ኮግንዳ ይተንከረ የንታ ዎገን ካርስካንታ የ ጋይድንካ ሳብታ ቃለንም ነግዝደቴ፥ ኮትኮግንደረ ኮም ካምድንደትም በድ ሪ ይደቴ” ኩንጋየሮ ማስሴ።<verse eid="MRK 7:13"/></para>
  <para style="s1">ኤድም ቱና ማዝድር</para>
  <para style="r">(<ref loc="MAT 15:10-20">ማቶ. 15፡10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14"/>ካርንካ ዎርሰንመረ የሱስ ይንደር ኤልሶ፥ “የታ ሙደና እም ኤሰርከቴ፥ ገቀርከቴ፥ <verse eid="MRK 7:14"/><verse number="15" style="v" sid="MRK 7:15"/>ኤድም ቱናማዝድንዳ፥ ኤታ ዋርንካ ዉድንዳ ዳት ማልንካ ኤታ ዋር አርድንዳ ቱናማዝዳክዬ! <verse eid="MRK 7:15"/><verse number="16" style="v" sid="MRK 7:16"/>ይና ኤሰርድን ቃም ዶቅድባብ ኤሰራ!” ኩን ከትካንታ ጋይሴ።<note caller="+" style="f"><char style="fr" closed="false">7፡16 </char><char style="ft" closed="false">ዋልቃ ዋልቃ ኤና እር ንከስ ፋይ. 16 ጉጅደኬ፥ ቃለነረ 4፡23 ዶቅድንደትም ካምዴ። </char></note><verse eid="MRK 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17"/>የሱስ ዎርሰንም ዛቅሶ ኤሄናር ክት አርደዳንደታ ቡር ክታ ካርንካ ጎርስምድባብከስ ካምስንከስጎካ ኦይሰኬ። <verse eid="MRK 7:17"/><verse number="18" style="v" sid="MRK 7:18"/>የሱሰረ ከደር፥ “የተረ ጉጅሶ ኮም ገቀራየቴ? ኤድ እችሶ ይንታ ዋር ኤቅዝድንዳ Ꮊረሰነረ ኤድም ቱና ማዝዳክንደትም የም አርዳዮ? <verse eid="MRK 7:18"/><verse number="19" style="v" sid="MRK 7:19"/>ልጳርጎካ ስግሶ ማል ዉዳ ዳት ቡዳር ዶቃዬ” ኩንጋየሮ ማስሴ። ኮከረ የሱስ እችም ሙደና ኡርማ ማትንተን ኬዜ።<verse eid="MRK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20"/>ኮታዘንከረ፥ “ኤድም ቱና ማስዝድንዳ ኤታ ቡዳርንካ ዉድን ርንከሰኬ። <verse eid="MRK 7:20"/><verse number="21" style="v" sid="MRK 7:21"/>ከተረ፥ ዳቅል ገቅር፥ ዞምባ፥ ድቢይ፥ ኤድም ደይሳ፥ <verse eid="MRK 7:21"/><verse number="22" style="v" sid="MRK 7:22"/>ቤልም፥ ጭጭ፥ ዳቅል፥ ገስ፥ አይተር ማት፥ ጩባ፥ የክ፥ ኦትራ፥ ቦስ፥ ከናከሴ። <verse eid="MRK 7:22"/><verse number="23" style="v" sid="MRK 7:23"/>ኬና ሙደና ዳቅል ርና ኤታ ቡዳርንካ ዉደኬ፥ ኤድመረ ቱናማዝዴ” ኩን ጋይሴ።<verse eid="MRK 7:23"/></para>
  <para style="s1">ስሮፍንቃው ፍጨናር ኤተንንታ አሜንና</para>
  <para style="r">(<ref loc="MAT 15:21-28">ማቶ. 15፡21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24"/>የሱስ ኮታርንካ አምሶ ትያጥሮስ ካተመንታ ላማር ዶቅድን ሞረናር አይሴ፥ ዋልቃ ኤሀር አርድሶ ዋር ዶቅንትን Ꮊየስነረ ኤሳይንግንዳ ዝግዜ፥ ማታጋካ ዳት ዋር ክታ ዶቅንተና አችምካንታ ማታክዬ። <verse eid="MRK 7:24"/><verse number="25" style="v" sid="MRK 7:25"/>ኮታ ይንቸና ዳቅል አያንካ የደርምሳንዳ ዋልቃ ኤተን የሱስጎካ ኤሰርሶ ሳነካ Ꮊዳንግንዳ ክታ ዱትንዘን ና ዋቼ። <verse eid="MRK 7:25"/><verse number="26" style="v" sid="MRK 7:26"/>ኤተነረ ስሮፍንቃውያንንከስታ ኮች ማቻንዳ ግርክ ፍጫ ኤተን Ꮊቄ። ናየረ ኮታ ይንቸንንዘንካ ግምዘንም ውችዝድንግንዳ የሱሰም፥ ምክሴ። <verse eid="MRK 7:26"/><verse number="27" style="v" sid="MRK 7:27"/>የሱስ ማቼ፥ “ይንችንታ እችምን ተይዮ አክስንከስካንታ እም ዝክሳዬ፥ ይና እርምሶ ይንችንከስ ምሳጋካ” ኮትም ጋይሴ።<verse eid="MRK 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28"/>ናየረ ማስሶ፥ “ገቴ የ ጮይስዮ፥ ማችንከረ አክስንከሰረ ጋበትንታ ጎያር ማትሶ ይንችና እጅድንካ ዋጅድንደትም ድንግመንም እጅደኬ”፥ ጋየሮ ክትካንታ ና ማስሴ።<verse eid="MRK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29"/>ኮካንታ የሱስ፥ “ኮ የስታ ኬዘንካ ግምዘና ይንችንዘንካ ዉቴ፥ ይና ኮዘንካ የስታ ኤር አይካ!” ኮትም ጋይሴ።<verse eid="MRK 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30"/>ናየረ ይንታ ኤር ኮትማቻንደትካ ኮታ ይንቸንን ዳቅል አያንና ዛቅስንካ ሰለንዘን ኡርመካ ራትሶ ዶቅድንካ ና ሰጄ።<verse eid="MRK 7:30"/></para>
  <para style="s1">ቃም ኤሰራይባብተኬ አፋ ኬዛይባብታ ፋጭንታ</para>
  <para style="r">(<ref loc="MAT 15:29-31">ማቶ. 15፡29-31</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31"/>የሱስ ትያጥሮስ ካተመን ዛቅሶ ስዶና ካተመንጎካ ዶቆ ታማ ካተማ ገየርድንደትካ ስግሶ ገሊላ ባሃርንደር ኖᎺዴ <verse eid="MRK 7:31"/><verse number="32" style="v" sid="MRK 7:32"/>ኮታረረ ዋልቃ ቃም ቱንከከ አፋ አስ ኤችም ክደር ተይ Ꮊደኬ፥ ይንታ አንንመረ ክታዘን ዎድንግንዳ ክትም ምክሰኬ። <verse eid="MRK 7:32"/><verse number="33" style="v" sid="MRK 7:33"/>የሱሰረ ኤችንም ዎርሰናርንካ ዉችትዮ ክትም Ꮊክ ተይ አይስንደትከ ይንታ ግልኤንከስም ኤችንታ ቃምንከስታ ዋር አርችሴ፥ ኮታዘንከረ ይንታ ፈጭምነረ ፈጭምሶ ኤችንታ አድምን Ꮊጬ። <verse eid="MRK 7:33"/><verse number="34" style="v" sid="MRK 7:34"/>ፈስ ጭላር ሰድሶ ቡዳርንካ ኡክንሶ “ኤፍታ!” ገይሴ፥ ኮታ ቡልነረ “ፍኦችምካ!” ጋይንትዬ። <verse eid="MRK 7:34"/><verse number="35" style="v" sid="MRK 7:35"/>ሳነካ ክታ ቃምንከስ ፎችምሰኬ፥ አድምነረ ብልምሴ፥ ዋልቀረ ማጥርካይሳ ጭርርሳ ኬዛ የጄ። <verse eid="MRK 7:35"/><verse number="36" style="v" sid="MRK 7:36"/>የሱሰረ ኮም ርን Ꮊየሰንካንተረ ከት ኬዝዳክንግንዳ ኤድንከስም ክትሴ፥ ማታጋካ ዳት፥ ከት ኬዝዳክንግንዳ ክትሳንከካ በድካ ስክስሶ ኬዝድ Ꮊቀኬ። <verse eid="MRK 7:36"/><verse number="37" style="v" sid="MRK 7:37"/>ኤሰርስባብከሰረ ሙዳ አንድር በድ በርእካ፥ “ሙዳ ርን ኡርመካ ይሴ! ቃም ቱንንከስ ኤሰርድንግንዳ፥ አፋ አስንከስ ኬዝድንግንዳ ኖ ይዴ!” ጋይሰኬ።<verse eid="MRK 7:37"/></para>
  <chapter eid="MRK 7"/>
  <chapter number="8" style="c" sid="MRK 8"/>
  <para style="s1">የሱስ ኦይድ ሳአ ማድባብ ኤድንከስም እችስና</para>
  <para style="r">(<ref loc="MAT 15:32-39">ማቶ. 15፡32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1"/>ከትኬና ሰጨንከሳር አነታ በድ ኤድንከስ ሳንምሰኬ። ከት እጅድንደረ ካያ Ꮊቄ፥ ኮካንታ የሱስ ይንታ ካርንካ ጎርስምድባብከስም ኤልሶ ኩን ጋይሴ፥ <verse eid="MRK 8:1"/><verse number="2" style="v" sid="MRK 8:2"/>“ይና ኬና ኤድንከስ እንካ ክክን ማከን ሰጫ Ꮊቅተኬ፥ Ꮊረነረ ከት እጅድንዳ እችም ካየንካንታ ከትካንታ አጨርድቴ፥ <verse eid="MRK 8:2"/><verse number="3" style="v" sid="MRK 8:3"/>ኮከት ዳቀርሳንግንዳ ከትም ከታ ኤሪ እ ኦይዳ ማቼ ጎግያር ጋብደኬ፥ ኮትኮግንደረ ከታርንካ ዋልቃ ዋልቀንከስ ጎትንካ Ꮊድባብከሰኬ” ከትም ጋይሴ።<verse eid="MRK 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4"/>ክታ ካርንካ ጎርስምድባብከሰረ፥ “ይና፥ ኮ ዴል ቆቸናር ከትኬና ሙደንከስካንታ ማድን እችም Ꮊብድባብ Ꮊይራ?” ጋይሶ ክትካንታ ማስሴ፥ <verse eid="MRK 8:4"/><verse number="5" style="v" sid="MRK 8:5"/>የሱሰረ “መም ሶላ የንደር ዶቅዳ?” ጋይሶ ከትም ኦይሴ።</para>
  <para style="q1" vid="MRK 8:5">ከተረ “ታብዛ ሶላ ዎንደር ዶቅዴ” ጋይሰኬ።<verse eid="MRK 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6"/>የሱሰረ ፍጨዘን ከት ዶቅተርንግንዳ ዎርሰንም ክትሴ፥ ታብዛ ሶለንም የድሶ ሳብም ጋለቼ፥ Ꮊእስትዮ ዎርሰንካንታ ከት እምድንግንዳ ይንታ ካርንካ ጎርስምድባብከስካንታ እምሴ፥ ከተረ ዎርሰንካንታ የልስሴ። <verse eid="MRK 8:6"/><verse number="7" style="v" sid="MRK 8:7"/>ቶክም መራ ሞለንከሰረ ከደር ዶቅዴ፥ ሞለንከስጎከረ ሳብም ጋለቻንደታ ቡር ዎርሰንካንታ እምድንግንዳ ይንታ ካርንካ ጎርስምድባብከስም ክትሴ። <verse eid="MRK 8:7"/><verse number="8" style="v" sid="MRK 8:8"/>ኤድንከሰረ ሙዳ እችሰኮ ምሰኬ፥ ስጣንደትመረ ዶከንም ሳንስሶ ታብዛ ጋባስርካ ጮጭ አምሰኬ። <verse eid="MRK 8:8"/><verse number="9" style="v" sid="MRK 8:9"/>እችባብ ኤድንከስ ኦይድ ሳአ ማድባብ Ꮊቀኬ፥ የሱሰረ ከትም ኦይቼ። <verse eid="MRK 8:9"/><verse number="10" style="v" sid="MRK 8:10"/>ኮታ ቡር ይንታ ካርንካ ጎርስምድባብከስካ ክክን ሎቀንዘንካ ቃልዝድን ጃልበናር አርድሶ ዳልማኑታ ጋየርድን ፍጨናር አይሴ።<verse eid="MRK 8:10"/></para>
  <para style="s1">ቃዉተንም ሰድንካንታ ኦይሰርሳንዳ</para>
  <para style="r">(<ref loc="MAT 16:1-4">ማቶ. 16፡1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11"/>ፈረሳዊያንንከስ የሱሰደር Ꮊድሰኮ ክትካ ክክን በርም የጀኬ። ጰጫካንተረ ገቀርሰኮ ጭላርንካ ዋልቃ ቃዉተን ከትካንታ ሰችዝድንግንዳ ኦይሰኬ።<note caller="-" style="x"><char style="xo" closed="false">8፡11 </char><char style="xt" closed="false"><ref loc="MAT 12:38">ማቶ. 12፡38</ref>፤ <ref loc="LUK 11:16">ሉቃ. 11፡16</ref>። </char></note> <verse eid="MRK 8:11"/><verse number="12" style="v" sid="MRK 8:12"/>የሱስ ይንታ አያንካ አንድር ክትካንታ ኤስምስንካ፥ “ኮና አጥርና ቃዉተን ይድንግንዳ Ꮊራካንትክ ዝግዳ? ዶፈንካ የም ጋይድቴ፥ ኮ አጥርንካንታ Ꮊረሰነረ ቃዉተን እምምዳክዬ!” ከትም ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">8፡12 </char><char style="xt" closed="false"><ref loc="LUK 11:29">ሉቃ. 11፡29</ref>። </char></note> <verse eid="MRK 8:12"/><verse number="13" style="v" sid="MRK 8:13"/>ኮታርንከረ ከትም ዛቅሶ ካርንካ ሎቀንዘንካ ቃልዝድን ጃልበንካ ኦስ ፋማ ቃልሴ።<verse eid="MRK 8:13"/></para>
  <para style="s1">ፈረሳዊያንንከስተኬ ሄሮድሰታ እርሰና</para>
  <para style="r">(<ref loc="MAT 16:5-12">ማቶ. 16፡5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14"/>ክታ ካርንካ ጎርስምድባብከስ ሶላ የድን ከት ባቀርሳንጎካ ሎቀንዘንካ ቃልዝድን ጃልበናር ዋልቃ ሶለዘንካ አብ Ꮊረነረ ከደር ካዬ። <verse eid="MRK 8:14"/><verse number="15" style="v" sid="MRK 8:15"/>የሱሰረ “ፈረሳዊያንንከስተኬ ሄሮድሰታ እርሰንዘንካ ካርስምከቴ” ጋይሶ ከትም ክትሴ።<note caller="-" style="x"><char style="xo" closed="false">8፡15 </char><char style="xt" closed="false"><ref loc="LUK 12:1">ሉቃ. 12፡1</ref>። </char></note><verse eid="MRK 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16"/>ከተረ “ኮም ክታ ጋይንተና፥ Ꮊረንግርካ ሶላ ዎንደር ካየንካንታ ማዴ” ጋይሰኮ ክክ ክክ ከዝምሰኬ።<verse eid="MRK 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17"/>የሱሰረ ኮም ከታ ገቅርን ኤስሶ ኩን ጋይሴ፥ “ሶላ ዎንደር ካየንካንቴ ጋይሰቶ Ꮊረተንት ገቀርዳ? አክ Ꮊረነረ ገቀርት ተይዳክባብከ የም ዝግዝዳክባበቶ? የንታ ቡደነረ ገቀርዳክንዶ? <verse eid="MRK 8:17"/><verse number="18" style="v" sid="MRK 8:18"/>አፍይ የንታ ዶቅድንካ ሰዳከቴ? ቃም የንታ ዶቅድንካ ኤሰርዳከተ? Ꮊስግንዳ የም ኤልቅ ጋይዳክንዳ?<note caller="-" style="x"><char style="xo" closed="false">8፡18 </char><char style="xt" closed="false"><ref loc="JER 5:21">ኤር. 5፡21</ref>፤ <ref loc="EZK 12:2">ሕዝ. 12፡2</ref>፤ <ref loc="MRK 4:12">ማር. 4፡12</ref>። </char></note> <verse eid="MRK 8:18"/><verse number="19" style="v" sid="MRK 8:19"/>ይና ዶንቅ ሶለን ዶንቅ ሳአ ኤድንከስም Ꮊእስት እ እምሳን Ꮊይካ ስጫንደትም መም ጋባስርካ ጮጨንት አምሳሬ?”</para>
  <para style="q1" vid="MRK 8:19">ኬተረ “ታመከ ቃስተን ጋባስርካ ጮጭዬ” ክደር ጋይሰኬ።<verse eid="MRK 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20"/>“ኮትግንደረ ታብዛ ሶለንም ኦይድ ሳአ ኤድንከስካንታ እ Ꮊእስት እምሳንደት Ꮊይካ ስጥመንም መም ጋባስርካ ጮጨንት አምሳሬ?” ጋይሶ ከትም ጋይሴ።</para>
  <para style="q1" vid="MRK 8:20">ኬተረ “ታብዛ ጋባስርካ ጮጭዬ” ክደር ጋይሰኬ።<verse eid="MRK 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21"/>የሱሰረ “ይና፥ ታ የለልታ ገቀራከቴ?” ከደረ ጋይሴ።<verse eid="MRK 8:21"/></para>
  <para style="s1">በቴሳይዳ ካተመናር ዋልቃ አፍይ ዝልንታ ፋጭና</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22"/>ኮታርከረ በቴሳይዳር ከት የልሳንደትካ ኤድንከስ ዋልቃ አፍይ ዝልን የሱሰደር ተይᎺደኬ፥ ክትም Ꮊጭድንግንደረ የሱሰም ምክሰኬ። <verse eid="MRK 8:22"/><verse number="23" style="v" sid="MRK 8:23"/>የሱሰረ አፍይ ዝልን ኤችንታ አንን የድሶ ጎርሰሮ ሞረናርንካ ኦስ አብ ካርዘን ዉችሴ፥ ኤችንታ አፍንከዘነረ ይንታ ፈጭምን ፈጭምሶ ይንታ አንን ክታዘን ዎድሶ “ዋልቃ ር የዝደር Ꮊፈርዶ?” ጋየሮ ክትም ኦይሴ።<verse eid="MRK 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24"/>አፍይ ዝልነረ ጬክን ጋይሶ፥ “ይዬ ኤድንከስ እዝደር Ꮊፈርደኬ፥ ማችንከረ ኤድንከስና Ꮊቀም ካምሶ ኦንግድንካ ሰድቴ” ጋይሴ። <verse eid="MRK 8:24"/><verse number="25" style="v" sid="MRK 8:25"/>አናካርንከረ የሱስ ኤችንታ አፍንከዘን ይንታ አንንከስም ዎጄ፥ ኮታይካ ኤችና ፍስሳ ሰጄ፥ አፍና ክታ ፎችምስንካ ሙዳ ሪም ፋስት ሰድን የጄ። <verse eid="MRK 8:25"/><verse number="26" style="v" sid="MRK 8:26"/>ኮተረ ቡር የሱስ “ሞረናር Ꮊይአርዴ”፥ ጋይሶ ክት ይንታ ኤር አይድንግንዳ ኦይቼ።<note caller="+" style="f"><char style="fr" closed="false">8፡26 </char><char style="ft" closed="false">ዋልቃ ዋልቃ ኤና እር ግርክ አፈንካ ጻፈርሳን ጭል ኤናር ኮትኮም ጉጅዴ፥ (ኮም Ꮊየሰንካንተረ Ꮊይከዜ) </char></note><verse eid="MRK 8:26"/></para>
  <para style="s1">የሱስ ሳይምስባብ ማትንተን ጴጥሮስታ መያ ማስና</para>
  <para style="r">(<ref loc="MAT 16:13-20">ማቶ. 16፡13-20</ref>፤ <ref loc="LUK 9:18-21">ሉቃ. 9፡18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27"/>የሱሰከ ክታካርንካ ጎርስምድባብከስካ ፍልጶስ ቀሳርያ ጋየርድን ፍጨናር ዶቅድን ሞረንከሳርንካ ዉተደኬ፥ ጎግዘነረ ከትዶቅድንካ የሱስ፥ “ኤድንከስ እም Ꮊይክ ጋይዳ?” ጋየሮ ይንታ ካርንካ ጎርስምድባብከስም ኦይሴ።<verse eid="MRK 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28"/>ከተረ፥ “ዋልቃ ዋልቀንከስ ስእስንባብ ዮሀንሴ፥ አብንከሰረ ኤላሴ፥ አብንከሰረ ሳብዘንካ ኤሰርሶ ከዛቅባብከሳርንካ ዋልቀነ የስም ጋይደኬ” ጋየረኮ ክትካንታ ማስሰኬ።<note caller="-" style="x"><char style="xo" closed="false">8፡28 </char><char style="xt" closed="false"><ref loc="MRK 6:14-15">ማር. 6፡14-15</ref>፤ <ref loc="LUK 9:7-8">ሉቃ. 9፡7-8</ref>። </char></note><verse eid="MRK 8:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29"/>“የተስ እም Ꮊየንት ጋይዳ?” ጋይሶ ከትም ኦይሴ። ጴጥሮሰረ፥ “የና ሳይምስባበዬ” ጋየሮ ክትካንታ ማስሴ።<note caller="-" style="x"><char style="xo" closed="false">8፡29 </char><char style="xt" closed="false"><ref loc="JHN 6:68-69">ዮሀ. 6፡68-69</ref>። </char></note><verse eid="MRK 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30"/>የሱሰረ፥ “ክትጎካ Ꮊየሰንካንተረ ከት ኬዝዳክንግንዳ” ጋይሶ ከትም ኤግዝምሴ።<verse eid="MRK 8:30"/></para>
  <para style="s1">የሱስ ይንታ ደእንተኬ አምንተንታ እርምሶ ክታ ኬዘና</para>
  <para style="r">(<ref loc="MAT 16:21-28">ማቶ. 16፡21-28</ref>፤ <ref loc="LUK 9:22-27">ሉቃ. 9፡22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31"/>የሱስ ይንታካርንካ ጎርስምድባብከስም ኩንጋየሮ ኤስስ የጄ፥ “ኤደት ይንች በድ ማጣ ተይ ክትም ዝግዝዴ፥ ጋልተንከዚደር፥ ቀሰንከስታ ገችስንባብከዚደርኬ ሙሴታ ህግንም ኤስዝድባብከዝደር ቶችምዴ፥ ደይስምዴ፥ ማታጋካ ዳት ማከን ሰጨንታ ቡር አምዴ”። <verse eid="MRK 8:31"/><verse number="32" style="v" sid="MRK 8:32"/>ኮም ርን መየካ ከትም ኬዜ፥ ኮትኮᎺይካ ጴጥሮስ ክትም Ꮊክ Ꮊርሳ ተይአይሶ ዋጭ ክትም የጄ። <verse eid="MRK 8:32"/><verse number="33" style="v" sid="MRK 8:33"/>የሱስ ማቼ ዋልን ገይሶ ይንታካርንካ ጎርስምድባብከስም ሰደሮ ጴጥሮስም፥ “የና ሰጣን ኦስ እዘንካ ጎተርካ! የና ኤተን ዳት ሳብትንደትም ገቀርዳከዬ!” ጋየሮ ክትም ዋጬ።<verse eid="MRK 8:33"/></para>
  <para style="s1">ክርስቶሰም ጎርስምና ኦይስዝድን ካስ</para>
  <para style="r">(<ref loc="MAT 10:38-39">ማቶ. 10፡38-39</ref>፤ <ref loc="MAT 16:24-28">16፡24-28</ref>፤ <ref loc="LUK 9:23-27">ሉቃ. 9፡23-27</ref>፤ <ref loc="LUK 14:25-27">14፡25-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34"/>ኮታ ቡር የሱስ ዎርሰንም ይንታ ካርንካ ጎርስምድባብከስካ ክክን ኤልሶ ኩን ከትም ጋይሴ፥ “እም ጎርስምካንታ ሶልምድባብ ይ ዶቅሴ ይንታ ማተንም ዛቃ፥ ማዝቀልንመረ ባልሶ እስታ ካርንካ ጎርስማ፥<note caller="-" style="x"><char style="xo" closed="false">8፡34 </char><char style="xt" closed="false"><ref loc="MAT 10:38">ማቶ. 10፡38</ref>፤ <ref loc="LUK 14:27">ሉቃ. 14፡27</ref>። </char></note> <verse eid="MRK 8:34"/><verse number="35" style="v" sid="MRK 8:35"/>ይንታ ሰንፔንም አቅስካንታ ዝግድባብ ሙደና ኮትም ካይዝዴ፥ እ ካንተኬ ክላ ኬዘንጎካ ይንታ ሰንፔንም ስክስት እምድባብ ማቼ ኮትም አቅዝዴ።<note caller="-" style="x"><char style="xo" closed="false">8፡35 </char><char style="xt" closed="false"><ref loc="MAT 10:39">ማቶ. 10፡39</ref>፤ <ref loc="LUK 17:33">ሉቃ. 17፡33</ref>፤ <ref loc="JHN 12:25">ዮሀ. 12፡25</ref>። </char></note> <verse eid="MRK 8:35"/><verse number="36" style="v" sid="MRK 8:36"/>ኤድ ፍጫሙደንታ ቆልመንም ሙዳ Ꮊፍሴ፥ ይንታ ሰንፔንም ክት ካይሴ Ꮊሮክ ክትም መዬ? <verse eid="MRK 8:36"/><verse number="37" style="v" sid="MRK 8:37"/>አና ኤድ ይንታ ሰንፔንካንታ ቆትማ Ꮊርክ ናክ እምካንታ ማዳ? <verse eid="MRK 8:37"/><verse number="38" style="v" sid="MRK 8:38"/>ኮ ቤልምንባብኬ ጎመንባብከስታ አጥርንታ እሪ እንከ እስታ ቃለንካ ኦስንድባብ ሙደና እተረ ኤደት ይንች እስታ ባቤንታ ቦንቸካ ጭል ክታይንችንካ ክክን Ꮊድቶ ክትካ እታ ኦስንድቴ።”<verse eid="MRK 8:38"/></para>
  <chapter eid="MRK 8"/>
  <chapter number="9" style="c" sid="MRK 9"/>
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1"/>ኮታዝንከሬ የሱስ፥ “ዶፈን የም ጋይድቴ፥ ታ ኮታር ዶቅድባብከሳርንካ ዋልቃ ዋልቀንከስ ሳብታ ባንችምና አንድር ዎልቀካ Ꮊድንካ ከት ሰተርን የለልታ ደእዳክባብከስ ዶቅደኬ” ከትም ጋይሴ።<verse eid="MRK 9:1"/></para>
  <para style="s1">የሱሰታ ማልክንታ ኦክምና</para>
  <para style="r">(<ref loc="MAT 17:1-13">ማቶ. 17፡1-13</ref>፤ <ref loc="LUK 9:28-36">ሉቃ. 9፡28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2"/>ላ ሰጨንታ ቡር የሱስ ጴጥሮሰም፥ ያይቆበምከ ዮሀንሰምከ Ꮊክ ጎርስሶ ዋልቃ አንድር ገቸዘን ዉተዴ፥ ከታ እረረ የሱስታ ማልክና ኦክምሴ።<note caller="-" style="x"><char style="xo" closed="false">9፡2 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2 ጴጥ. 1፡17-18</ref>። </char></note> <verse eid="MRK 9:2"/><verse number="3" style="v" sid="MRK 9:3"/>ክታ አፍለና አንድር ሮጵሴ፥ ፍጨዘን Ꮊየረ ስእትዮ ጫምስካንታ ማዳክንደትከካ የለልታ አንድር ጫምሳ ማቼ። <verse eid="MRK 9:3"/><verse number="4" style="v" sid="MRK 9:4"/>ኮታይካ ኤላሰኬ ሙሴካ መያ ማትሰኮ የሱሰካ ክክን ከት ከዝምድንካ ከትካንታ Ꮊፈርሰኬ። <verse eid="MRK 9:4"/><verse number="5" style="v" sid="MRK 9:5"/>ጴጥሮሰረ የሱሰም፥ “ኤስስንባቦ! ካሪ ዎ ዶቅሰስናና ዎካንታ ኡርሜ፥ ኮካንታ ዋልቃ የስካንታ፥ ዋልቀን ሙሴካንታ፥ ዋልቀን ኤላስካንታ ማድን ማከን ዳልቸንከስም ዎፍክሳ” ጋይሰኬ። <verse eid="MRK 9:5"/><verse number="6" style="v" sid="MRK 9:6"/>ክታ ካርንካ ጎርስምድባብከስ ማከንና አንድር ከታ ገቅሰኮ Ꮊቃንጎካ ጴጥሮስ ይ ኬዝድንደትም ኤሳይᎺቄ።<verse eid="MRK 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7"/>ኮታዘንከረ ኡፓ Ꮊድሶ ከትም ስፍሴ፥ ኡፔንተረ ዋር “እ ሶልምድን እስታ ይንችና ኖ ኮኔ! ክትም ኤሰርከቴ!” ጋይድን ኡፍስ ኤስምሴ።<note caller="-" style="x"><char style="xo" closed="false">9፡7 </char><char style="xt" closed="false"><ref loc="MAT 3:17">ማቶ. 3፡17</ref>፤ <ref loc="MRK 1:11">ማር. 1፡11</ref>፤ <ref loc="LUK 3:22">ሉቃ. 3፡22</ref>። </char></note> <verse eid="MRK 9:7"/><verse number="8" style="v" sid="MRK 9:8"/>ሳነከረ ዋልንጋይሰኮ ከታ ይንታ ካንተንካ ከት ሰድንካ ከትካ ክክን የሱሰዘንካ አብ Ꮊይመነረ ሰዳከኬ።<verse eid="MRK 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9"/>ገቸንዘንከረ ከት Ꮊንችርድንካ የሱስ፥ “ኤደት ይንች ደእናርንካ አምትርን የለልታ ኮም የ ሰጃንደትም Ꮊየንካንተረ Ꮊይከዘቴ” ጋየሮ ከትም ክትሴ።<verse eid="MRK 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10"/>ከተረ ክታ ቃለንም ይንታ ቡዳር የጀኬ፥ ማታጋካ ዳት “ኮና ደእያርንካ አምንተና Ꮊራ ጋይንት ማተራ?” ጋየረኮ ክክ ክክ ከዝምሰኬ። <verse eid="MRK 9:10"/><verse number="11" style="v" sid="MRK 9:11"/>ከተረ “ሙሴታ ህግንም ኤስዝድባብከስ እርምሶ Ꮊድ ዝግዝድባብ ኤላሴ Ꮊረተክ ጋይዳ?” ጋየረኮ ክትም ኦይሰኬ።<note caller="-" style="x"><char style="xo" closed="false">9፡11 </char><char style="xt" closed="false"><ref loc="MAL 4:5">ሚል. 4፡5</ref>፤ <ref loc="MAT 11:14">ማቶ. 11፡14</ref>። </char></note><verse eid="MRK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12"/>የሱሰረ፥ “ኮና ገቴ፥ ኤላስ እርምሶ Ꮊዴ፥ ሙደንመረ ኡርዝዴ፥ ማታጋካ ዳት፥ ኤደት ይንች አንድር ማጣ ተይድንደትምከ ቶችምድንደትም ጻፍምሳንዳ Ꮊረተረ? <verse eid="MRK 9:12"/><verse number="13" style="v" sid="MRK 9:13"/>እታ ማቼ ኤላስ እርምሶ Ꮊቴ፥ ኤድንከሰረ ክትጎካ ጻፍሳንግንዳ ከታ ይ ዝግዛንደትም ሙዳ ክታዘን ይተኬ” የካንታ ጋይድቴ። ኩንጋየሮ ከትካንታ ማስሴ።<verse eid="MRK 9:13"/></para>
  <para style="s1">የሱስ ቱና አያን የጅባብ ይንችን ፋችና</para>
  <para style="r">(<ref loc="MAT 17:14-21">ማቶ. 17፡14-21</ref>፤ <ref loc="LUK 9:37-43">ሉቃ. 9፡37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14"/>የሱሰኬ ማከንና ክታ ካርንካ ጎርስምድባብከስ ነግድባብ ክታካርንካ ጎርስምድባብከዝደር ማተኮ ከት Ꮊዳንደትካ በድ ኤድንከስ ከታ ካንተካ ሳንምስንካ ሰደኬ፥ ሙሴታ ህግንም ኤስዝድባብከሰረ ክታ ካርንካ ጎርስምድባብከስካ ክክን ቤርምድ Ꮊቀኬ። <verse eid="MRK 9:14"/><verse number="15" style="v" sid="MRK 9:15"/>ዎርሰነረ ሙዳ የሱሰም ሰድሰኮ በርእካ ገቅሰኬ፥ ክደር ዞደካ Ꮊድሰኮ አን የድሰኮ አቦ ጋይሰኬ። <verse eid="MRK 9:15"/><verse number="16" style="v" sid="MRK 9:16"/>የሱሰረ “ከትካ ክክን የ በርምድንዳ Ꮊራካንተረ?” ጋየሮ ከትም ኦይሴ። <verse eid="MRK 9:16"/><verse number="17" style="v" sid="MRK 9:17"/>ዎርሰንታ ዎክያርንካ ዋልቀና፥ ኩንጋየሮ ማስሴ፥ “ኤስስንባቦ፥ አፋ ኬዝዳክንግንዳ ይስዝድን አያንካ የደርስባብ እስታ ይንችን የዝደረ ተይᎺትቴ፥ <verse eid="MRK 9:17"/><verse number="18" style="v" sid="MRK 9:18"/>ክታዘን አምሳንደትካ ክትም ባልት ኦይዴ፥ አፈካ ዱብ Ꮊደሮ አችነረ ቅርጭዴ፥ ዘነነረ ክታ ዎችሶ ለይስንግንዳ ማዴ፥ ቱና አያንነረ ክታዘንካ ዉችዝድንግንዳ የስታ ካርንካ ጎርስምድባብከስም ኦይስትት ዶቆ፥ ኬዛርንካ ማቼ ከታ ዉችካንታ ማታከኬ”።<verse eid="MRK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19"/>የሱሰረ፥ “የታ አሜንዳክን ኤድንከሶ! Ꮊንታ የለልትስ የንካ ክክን እታ ዶቅዳ? Ꮊንታ የለልትስ ዳንዳእዳ? ይንችንም ኮር እዝደር ተይ Ꮊድከቴ!” ኩን ከትም ጋይሴ። <verse eid="MRK 9:19"/><verse number="20" style="v" sid="MRK 9:20"/>ከተረ ይንችንም ክደር ተይ Ꮊደኬ፥ ቱና አያንነረ የሱሰም ሰጃንደትካ ሳነካ ይንችንም ባልት ዛቅሶ ጭእሴ፥ ይንችነረ ፍጨዘን ቡክለሮ አፈካ ዱብ Ꮊድ የጄ።<verse eid="MRK 9:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 9:21"/>የሱሰረ ይንችንታ ባበንም፥ “ኮና ሰቅምና ክትም የጅንካ በድ ዶቅቶ?” ጋየሮ ክትም ኦይሴ።</para>
  <para style="p" vid="MRK 9:21">ባቤነረ፥ “ኤና ክት ይንችናና የድሶ፥ <verse eid="MRK 9:21"/><verse number="22" style="v" sid="MRK 9:22"/>ክትም ደይሳካንተረ ዝገሮ በድᎺይካ ኖሔታ ዋርኬ ሎቀታ ዋር ባልት ክትም ኦይዴ፥ ዋዴ ዋልቃ ር ይይካንታ የዝደር ማድንካንታ ዋደ ዎካንታ አጨርካ! አሌን ዎም አልካ!” ኩን ጋይሴ።<verse eid="MRK 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23"/>የሱሰረ፥ “የዝደር ማደረ” የና ጋይተራ? “አሜንድን ኤድካንታ ሙዳ ሪና ማዴ!” ክትም ጋይሴ።<verse eid="MRK 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24"/>ሳነካ ይንችንታ ባበና፥ “አመንድቴ፥ እስታ አሜንንታ ቶክንተን አለን አልካ” ጋይሶ ፍፍሴ።<verse eid="MRK 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25"/>የሱሰረ ዎርሰና ጭጭመትካ ዞደሮ ከት Ꮊድንካ ሰዴ፥ ቱና አያንንመረ “የና አፋ ከስዝዳክባብከ ቃም ቱንዝድን አያንና ይንችንዘንካ የስ ዉድንግንዳ ክደረረ ማተዮ የስ አርዳክንግንዳ የስም ክድቴ!” ጋይሶ ክትም ዋጬ።<verse eid="MRK 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26"/>ቱና አያንና አንድር ኡፍስካ ፍፍሴ፥ ይንችንመረ አከካ ጭእሳንደታ ቡር ክታዘንካ ዉተዴ፥ ይንችነረ ደእሳን ለይስንግንዳ ክታ ማትንተንካ በድንከዝደር ደእሳን ከደር ካምሴ። <verse eid="MRK 9:26"/><verse number="27" style="v" sid="MRK 9:27"/>የሱስ ማቼ ይንችንታ አንንም የድሶ አምሴ፥ ይንችነረ አምትዮ ዎእሴ።<verse eid="MRK 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28"/>የሱሰረ ኤሄናር አርደዳንደትካ ክታ ካርንካ ጎርስምድባብከስ፥ “የለቴ ኮም ቱና አያንን ዎታ ዉችካንታ ዎማታክንደና Ꮊረተረ?” ጋይሰኮ ክትም Ꮊክ ኦይሰኬ። <verse eid="MRK 9:28"/><verse number="29" style="v" sid="MRK 9:29"/>የሱሰረ፥ “ኮግንደና ምክስኬ በቼካ ምክስንካ ማታክንዳ ማቼ አብ Ꮊራርከረ ዉታዬ” ጋየሮ ከትካንታ ማስሴ።<verse eid="MRK 9:29"/></para>
  <para style="s1">የሱስ ይንታ ደእንተኬ ይንታ አምንተንታ ቃስትምስ ዱት ክት ኬዛንዳ</para>
  <para style="r">(<ref loc="MAT 17:22-23">ማቶ. 17፡22-23</ref>፤ <ref loc="LUK 9:43-45">ሉቃ. 9፡43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30"/>የሱሰኬ ክታ ካርንካ ጎርስምድባብከስ ካርንኮትም ዛቅሰኮ ገሊላ ሞረናርጎካ አይሰኬ፥ ክት ዶቅድን ካርን Ꮊየነረ ኤድ ኤዝድንግንዳ የሱስ ዝጋክዬ፥ <verse eid="MRK 9:30"/><verse number="31" style="v" sid="MRK 9:31"/>ኮነረ ማቻንዳ የሱስ ይንታ ካርንካ ጎርስምድባብከስም፥ “ኤደት ይንች ኤድንከስታ አንያር ስክስምትቶ እምምዴ፥ ከተረ ክትም ደይዝደኬ፥ ይ ደይስምሳንደታ ቡር ማቼ ማክምስ ሰጨንካ አምዴ” ጋየሮ ከትም ኤስሰሮ Ꮊቃንካንቴ። <verse eid="MRK 9:31"/><verse number="32" style="v" sid="MRK 9:32"/>ክታካርንካ ጎርስምድባብ ማቼ ኮና ሪና ከትም አርዳክዬ፥ ክትም ከት ኦይዝዳክንግንደረ ጳሰኬ።<verse eid="MRK 9:32"/></para>
  <para style="s1">ሙደንዘንካ ስገድባብ Ꮊይራ</para>
  <para style="r">(<ref loc="MAT 18:1-5">ማቶ. 18፡1-5</ref>፤ <ref loc="LUK 9:46-48">ሉቃ. 9፡46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33"/>የሱሰኬ ክታ ካርንካ ጎርስምድባብከስ ቅፍራናሆም ካተመናር Ꮊደኬ፥ የሱስ ኤሄናር አርደዳንደታ ቡር ይንታካርንካ ጎርስምድባብከስም “ጎግዘን ዶቅደቶ የ በርምሳንዳ ሪና Ꮊራ?” ጋየሮ ከትም ኦይሴ።<verse eid="MRK 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34"/>ከታ ማቼ ጫምን ጋይሰኬ፥ ኮነረ ጎግዘን ዶቅደኮ፥ “ዎ ሙደንዘንካ ስገድባብ Ꮊይራ?” ጋየረኮ ቤርምድ ከት Ꮊቃንጎኬ።<note caller="-" style="x"><char style="xo" closed="false">9፡34 </char><char style="xt" closed="false"><ref loc="LUK 22:24">ሉቃ. 22፡24</ref>። </char></note> <verse eid="MRK 9:34"/><verse number="35" style="v" sid="MRK 9:35"/>የሱሰረ ዶቅሳንደታ ቡር ታሜከ ቃስተንን ኤልሶ፥ “እሪ ማትካንታ ዝግድባብ Ꮊየነረ ኤድ ሙደና ሙደንታ ቡር ማታ ጉጅሰረ ሙደንከስታ ፍክስባብ ክት ማታ” ከትም ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">9፡35 </char><char style="xt" closed="false"><ref loc="MAT 20:26-27">ማቶ. 20፡26-27</ref>፤ <ref loc="MAT 23:11">23፡11</ref>፤ <ref loc="MRK 10:43-44">ማር. 10፡43-44</ref>፤ <ref loc="LUK 22:26">ሉቃ. 22፡26</ref>። </char></note> <verse eid="MRK 9:35"/><verse number="36" style="v" sid="MRK 9:36"/>ዋልቃ መራ ይንች ተይᎺድሶ ከታ ዎክያር ዎይስሶ፥ እምጭሰረ ኩን ከትም ጋይሴ፥ <verse eid="MRK 9:36"/><verse number="37" style="v" sid="MRK 9:37"/>“ኮግንዳ ዶቅድን ይንችንከሳርንካ ዋልቀን እስታ ላምንካ ሞግድባብ ሙደና እም ሞግዴ፥ እመረ ሞግድባብ ሙደና እም ማታክናና፥ እም ኦይችባብም ሞግዴ”፥ ከትም ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">9፡37 </char><char style="xt" closed="false"><ref loc="MAT 10:40">ማቶ. 10፡40</ref>፤ <ref loc="LUK 10:16">ሉቃ. 10፡16</ref>፤ <ref loc="JHN 13:20">ዮሀ. 13፡20</ref>። </char></note><verse eid="MRK 9:37"/></para>
  <para style="s1">ዎም ግርዳክባብ ሙደና ዎንካ ክክኔ</para>
  <para style="r">(<ref loc="LUK 9:49-50">ሉቃ. 9፡49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38"/>ዮሀንሰረ የሱሰም “ኤስስንባቦ፥ ዋልቃ ኤች የስታ ላምንካ ግምዘን ዉጅድንካ ሰዶቴ፥ ማችንከረ ዎንከረ ክክን ክት ማታክንካንታ ማርሶቴ” ክደር ጋይሴ።<verse eid="MRK 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39"/>የሱስ ማቼ፥ “እስታ ላምንካ አታ ይየሮ ሳነካ እስታዘን ዳቅል ኬዝድባብ ካየንካንታ ክትም ዛእከቴ፥ Ꮊይማረቴ። <verse eid="MRK 9:39"/><verse number="40" style="v" sid="MRK 9:40"/>ዎም ግርዳክባብ ሙደና ዎንካ ክክኔ፥<note caller="-" style="x"><char style="xo" closed="false">9፡40 </char><char style="xt" closed="false"><ref loc="MAT 12:30">ማቶ. 12፡30</ref>፤ <ref loc="LUK 11:23">ሉቃ. 11፡23</ref>። </char></note> <verse eid="MRK 9:40"/><verse number="41" style="v" sid="MRK 9:41"/>ዶፈን የም ጋይድቴ፥ ክርስቶሰታ የ ማቻንካንታ እስታ ላምንካ ዋልቃ ቡርጭቀካ ሎቃ ዎራ የም እምድባብ ሙደንታ ናክ ካያዬ” ከትም ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">9፡41 </char><char style="xt" closed="false"><ref loc="MAT 10:42">ማቶ. 10፡42</ref>። </char></note><verse eid="MRK 9:41"/></para>
  <para style="s1">ኤድም ኮተርዝድባብ ማትንተዘንካ ካርስም</para>
  <para style="r">(<ref loc="MAT 18:6-9">ማቶ. 18፡6-9</ref>፤ <ref loc="LUK 17:1-2">ሉቃ. 17፡1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42"/>“Ꮊየነረ ኤድ እንካ አሜንድባብ ከትኬና መረንከሳርንካ ዋልቀን ኮተርዝድንዘንካ አንድር ደይስን ሰይንም ይንታ ባርያር ዞከርሶ ባሀርናር ክት ኦይትምሰስናና ኡርዴ። <verse eid="MRK 9:42"/><verse number="43" style="v" sid="MRK 9:43"/>ኮካንታ የስታ አንና ጎማ የስ ፍግዝድንግንዳ የስም ኮተርዝደ ኮትም ተችት ዛእካ! ቃስተን አን የስታ ዶቅድንካ ድግዳክን ኖሄናር የስ ኦይትምድንዘንካ ዱንግላ ማትሶ ስለንካ ዶቅንትያር አርድና የስካንታ ኡርዴ።<note caller="-" style="x"><char style="xo" closed="false">9፡43 </char><char style="xt" closed="false"><ref loc="MAT 5:30">ማቶ. 5፡30</ref>። </char></note> <verse eid="MRK 9:43"/><verse number="44" style="v" sid="MRK 9:44"/>ድግዳክን ኖሄናር ዱርእመና ደእዳክንዳ፥ ኖሄነረ ድግዳክን ካርዬ።<note caller="+" style="f"><char style="fr" closed="false">9፡44 </char><char style="ft" closed="false">ዋልቃ ዋልቃ ኤና እር ጻፈርሳንዳ ፋይ. 44 ጉጅደኬ፥ ቃለነረ ፋይ. 48 ዶቅድንደትም ካምዴ። </char></note> <verse eid="MRK 9:44"/><verse number="45" style="v" sid="MRK 9:45"/>የስታ ዱትነረ የስም ኮተርዝደ ተችት ዛእካ፥ ቃስተን ዱት የስታ ዶቅድንካ ድግዳክን ኖሀር የስ ኦይትምተርንዘንካ ዎብ ማትሰዮ፥ ሰንፔካ ዶቅንትያር አርድና የስም ኡርዴ። <verse eid="MRK 9:45"/><verse number="46" style="v" sid="MRK 9:46"/>[ድግዳክን ኖሄናረረ ዱርእመና ደእዳክንዳ ኖሄነረ ድግዳክንዴ።] <verse eid="MRK 9:46"/><verse number="47" style="v" sid="MRK 9:47"/>የስታ አፍነረ የስም ኮተርዝደ፥ ዎልክስት ዉችካ፥ ቃስተን አፍይ የስታ ዶቅድንካ ድግዳክን ኖሄናር ኦይትምዘንካ፥ ዋልቃ አፍይ የስታ ዶቅድንካ ሳብታ ባንችምናር አርድና የስም ኡርዴ።<note caller="-" style="x"><char style="xo" closed="false">9፡47 </char><char style="xt" closed="false"><ref loc="MAT 5:29">ማቶ. 5፡29</ref>። </char></note><verse eid="MRK 9:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="MRK 9:48"/>“ድግዳክን ኖሄናረረ ዱርእመና ደእዳክንዳ፥</para>
  <para style="q2" vid="MRK 9:48">ኖሄነረ ድግዳክንዴ።<note caller="-" style="x"><char style="xo" closed="false">9፡48 </char><char style="xt" closed="false"><ref loc="ISA 66:24">ኢሳ. 66፡24</ref>። </char></note><verse eid="MRK 9:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49"/>“ካሴርድንዳ ሶቅካ ሳዉስምድንግንዳ ዋልቃ ዋልቃ ኤድንከስ ኖሄካ ጰጭምም ዝግዝዴ።<note caller="-" style="x"><char style="xo" closed="false">9፡49 </char><char style="xt" closed="false"><ref loc="LEV 2:13">ሌዊ. 2፡13</ref>፤ <ref loc="MAL 3:2-3">ሚል. 3፡2-3</ref>፤ <ref loc="NUM 3:17">ፋይ. 3፡17</ref>። </char></note><verse eid="MRK 9:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50"/>“ሶቅ ኡርሜ፥ ማታጋካ ዳት፥ ሶቅታ ሎቅንም ኮት ይንታ ካይሰ Ꮊረከንት ሎቅስዝዳ?<note caller="-" style="x"><char style="xo" closed="false">9፡50 </char><char style="xt" closed="false"><ref loc="MAT 5:13">ማቶ. 5፡13</ref>፤ <ref loc="LUK 14:34-35">ሉቃ. 14፡34-35</ref>። </char></note></para>
  <para style="p" vid="MRK 9:50">“የንከረ ሶልማ ሶቅታ ሎቅንግንዳ ሶልማ የንታዋር ዶቃ፥ ክክ ክከረ ኤእሰቶ ሳራትቸካ ዶእከቴ” ጋይሴ።<verse eid="MRK 9:50"/></para>
  <chapter eid="MRK 9"/>
  <chapter number="10" style="c" sid="MRK 10"/>
  <para style="s1">ክእስተኬ ኬነንተካ ብልምጎካ</para>
  <para style="r">(<ref loc="MAT 19:1-12">ማቶ. 19፡1-12</ref>፤ <ref loc="LUK 16:18">ሉቃ. 16፡18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1"/>የሱስ ኮታርንካ አምሶ፥ ዮርዳኖስ ሎቀንታ ፋማ ዶቅድን ይሁዳ ሞረናር አይሴ። አንድር በድ ኤድንከሰረ አና ካርንካ ክደር ሳንምድ Ꮊቀኬ፥ የሱሰረ ይንታ መጠንግንዳ ከትም ኤስዝድᎺቄ።<verse eid="MRK 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2"/>ፈረሳዊያንንከሳርንካ ቶክምንከስ ክደር Ꮊደኬ፥ ክትም ጰጫካንተረ ዝግሰኮ፥ “ኤድ ይንታ ኬነንም ቡልድንግንዳ ህግንካ ክትካንታ ጋይምቶ?” ጋየረኮ ኦይሰኬ።<verse eid="MRK 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3"/>የሱሰረ “ሙሴ ኮርንካንታ Ꮊርክ የም ክትሳሬ?” ከትም ጋይሴ። <verse eid="MRK 10:3"/><verse number="4" style="v" sid="MRK 10:4"/>ከተረ “ሙሴ ማቼ ኮት ብልምሳንደታ ማርካትች ዋርቀትን እምሶ ኮትም ቡልድንግንዳ ጋይቴ” ክደር ጋይሰኬ።<note caller="-" style="x"><char style="xo" closed="false">10፡4 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">ካሪ. 24፡1-4</ref>፤ <ref loc="MAT 5:31">ማቶ. 5፡31</ref>። </char></note><verse eid="MRK 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5"/>የሱሰረ፥ “ሙሴ ማቼ ኮም ህግን የካንታ ጻፍሳንዳ የንታ ቡደና ዳቅስንካ የ ኤሰራይንጎኬ፥ <verse eid="MRK 10:5"/><verse number="6" style="v" sid="MRK 10:6"/>ኬዛር ማቼ ኤና እሪ ፍዝርንዘንካ የችሶ ‘ሳብ አⷝነኬ ማነካ ማስሶ ከትም ፍዜ።<note caller="-" style="x"><char style="xo" closed="false">10፡6 </char><char style="xt" closed="false"><ref loc="GEN 1:27">ፍዝ. 1፡27</ref>፤ <ref loc="GEN 5:2">5፡2</ref>። </char></note> <verse eid="MRK 10:6"/><verse number="7" style="v" sid="MRK 10:7"/>ኮካንታ ኤድ ይንታ ባቤንምኬ እንደንምካ ዛቅሶ ይንታ ኬነንካ ክክን ዋልቃ ማዴ። <verse eid="MRK 10:7"/><verse number="8" style="v" sid="MRK 10:8"/>ቃስተነረ ዋልቃ ዋሀ ማደኬ’ ኮዘንከረ ኦስ ቃስተን ከታ ማትንተና ነግሶ ዋልቃ ማደኬ።<note caller="-" style="x"><char style="xo" closed="false">10፡8 </char><char style="xt" closed="false"><ref loc="GEN 2:24">ፍዝ. 2፡24</ref>። </char></note> <verse eid="MRK 10:8"/><verse number="9" style="v" sid="MRK 10:9"/>ይና ሳብ ዋልቃ ማስሳንደትም ኤድ Ꮊይ ፋሳ” ኩንጋየሮ ከትካንታ ማስሴ።<verse eid="MRK 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10"/>ኤሪ ከታ ይ ማቻንደትካ ክታ ካርንካ ጎርስምድባብከስ ኮትኮ ኬዘንጎካ ካርንካ የሱሰም ኦይሰኬ። <verse eid="MRK 10:10"/><verse number="11" style="v" sid="MRK 10:11"/>የሱሰረ፥ “ይንታ ኬነንም ቡልሶ አብ ማና እንጅድባብ ኮትዶቅድንካንታ ኖ ቤልምቴ፥<note caller="-" style="x"><char style="xo" closed="false">10፡11 </char><char style="xt" closed="false"><ref loc="MAT 5:32">ማቶ. 5፡32</ref>፤ <ref loc="1CO 7:10-11">1 ቆሮ. 7፡10-11</ref>። </char></note> <verse eid="MRK 10:11"/><verse number="12" style="v" sid="MRK 10:12"/>ኮትኮግንደረ ይንታ ክእስን ብልሶ አብ አⷝና ኤሪ ይእድን ኤተና ቤልምታ ጋይንትዬ” ኩንጋየሮ ማስሴ።<verse eid="MRK 10:12"/></para>
  <para style="s1">የሱስ ይንችንከስም አንጅና</para>
  <para style="r">(<ref loc="MAT 19:13-15">ማቶ. 19፡13-15</ref>፤ <ref loc="LUK 18:15-17">ሉቃ. 18፡15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13"/>የሱስ ከትም Ꮊጭድንግንዳ ይንችንከስም ክደር ተይ Ꮊደኬ፥ ክታካርንካ ጎርስምድባብከስ ማቼ ይንችን ተይᎺድባብ ኤድንከስም ዋጨኬ። <verse eid="MRK 10:13"/><verse number="14" style="v" sid="MRK 10:14"/>የሱሰረ ኮም ሰድሶ ዋጬ፥ ይንታካርንካ ጎርስምድባብከስም፥ “ሳብታ ባንችምና ከትኬናከስግንዳ ይንችንታ ማቻንካንታ ይንችንከስ እዝደር ከት Ꮊዳ፥ ዛእከቴ፥ ከትም Ꮊይማረቴ፥ <verse eid="MRK 10:14"/><verse number="15" style="v" sid="MRK 10:15"/>ዶፈን የም ጋይድቴ፥ ሳብታ ባንችምን ይንችግንዳ ማትሶ ኮትም ተይዳክባብ ቦድሶ ኮታር አርዳክዬ” ኩን ከትም ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">10፡15 </char><char style="xt" closed="false"><ref loc="MAT 18:3">ማቶ. 18፡3</ref>። </char></note> <verse eid="MRK 10:15"/><verse number="16" style="v" sid="MRK 10:16"/>ኮታ ቡር ይንችንከስም እምጭስንደትከ ይንታ አንንም ከታዘን ዎድሶ ከትም አንጄ።<verse eid="MRK 10:16"/></para>
  <para style="s1">ቆልመንክንባብ ኤችንታ</para>
  <para style="r">(<ref loc="MAT 19:16-30">ማቶ. 19፡16-30</ref>፤ <ref loc="LUK 18:18-30">ሉቃ. 18፡18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17"/>የሱስ ኮታርንካ ዉትሶ አያዶቅድንካ ዋልቃ ኤች ክደር ዞደሮ Ꮊድሶ ክታ እር ጉምፈርሶ “Ꮊልስማ ኤስስንባቦ፥ ስለንካ ዶቅንትን ተይካንታ Ꮊራ እም ይ ዝግዝዳ?” ጋየሮ ክትም ኦይሴ። <verse eid="MRK 10:17"/><verse number="18" style="v" sid="MRK 10:18"/>የሱሰረ፥ “Ꮊራጎከስ Ꮊልስማ እም ጋይዳ? ዋልቃ ሳብንዘንካ አብ Ꮊየነረ Ꮊልስማ ካዬ፥ <verse eid="MRK 10:18"/><verse number="19" style="v" sid="MRK 10:19"/>ክተንከስም የና ኤዝደዬ፥ ከተረ ‘Ꮊይ ደይሴ፥ ማነን ኦከሮ Ꮊይ ቤልመ፥ Ꮊይ ድቤ፥ ካርከካ Ꮊይማርከሬ፥ Ꮊይ ገስሴ፥ የስታ ባበንምከ የስታ እንደንም ቦንችካ’ ጋይምስባብከሰኬ” ኩንጋየሮ ክትካንታ ማስሴ።<note caller="-" style="x"><char style="xo" closed="false">10፡19 </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">ዉት. 20፡12-16</ref>፤ <ref loc="DEU 5:16-20">ካሪ. 5፡16-20</ref>። </char></note><verse eid="MRK 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20"/>ኤችነረ “ኤስስንባቦ፥ ከትኬና ክተንከስም ማቼ ኤና ይንችዘንካ የችስቶ ካርስትቴ” ጋይሴ።<verse eid="MRK 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21"/>የሱሰረ ክትም ሰድሶ ሶልምሴ፥ ኩነረ ክትም ጋይሴ፥ “ዋልቃ ር Ꮊክ የዘንካ ነገቴ፥ አይካ፥ የስታ ዶቅድንደትም ሙዳ ሰንሰዮ የስታ ብረንም ርካየንባብከስካንታ እምካ፥ የስካንታ ሳንምሳን ቆልመንም ጭላር Ꮊፍተረዬ፥ ኮታ ቡር Ꮊድካ፥ እም ጎርስምካ” ክትም ጋይሴ። <verse eid="MRK 10:21"/><verse number="22" style="v" sid="MRK 10:22"/>ኤችነረ ኮም ይ ኤሰርሳንደትካ ባለና ክታ ሞርእካ ጫልሴ፥ በድ ቆልመረ ክታ ዶቅድንካንታ ሞርኤሮ አይሴ። <verse eid="MRK 10:22"/><verse number="23" style="v" sid="MRK 10:23"/>የሱስ ዋልን ጋይሶ ክትም ሰድስንደትከ ይንታ ካርንካ ጎርስምድባብከስም፥ “ቆልመክንባብከስ ሳብታ ባንችምናር አርድና Ꮊስግንዳ ደጭመሬ!” ከትም ጋይሴ።<verse eid="MRK 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24"/>ክታ ካርንካ ጎርስምድባብከሰረ ክታ ቃለንካ በርእሰኬ፥ የሱስ ማቼ ማስሶ፥ “እስታ ይንችንከሶ! ሳብታ ባንችምናር አርድና Ꮊስግንዳ ደጭመሬ! <verse eid="MRK 10:24"/><verse number="25" style="v" sid="MRK 10:25"/>ቆልማባብ ሳብታ ባንችምናር አርድንዘንካ ግመል ጋየርድንደና ማርፈታ ጩቅካ አርደስናና ኡርዴ” ኩን ከትም ጋይሴ።<verse eid="MRK 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26"/>ክታካርንካ ጎርስምድባብከስ አንድር በርእሰኮ፥ “ኮናና ኮግንደካ Ꮊይ አቅካንታ ማዳ?” ክክ ጋይሰኬ።<verse eid="MRK 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27"/>የሱሰረ ከደር ሰድሶ፥ “ገታ ኮና ርና ኤደር ማታዬ፥ ሳብደር ማቼ ማደ፥ ሳብካንታ ሙዳ ር ማዴ” ጋይሴ።<verse eid="MRK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28"/>ጴጥሮሰረ “ይና ዎታ ሙደን ዛቅሶቶ የስታ ካርንካ ጎርስምሶቴ” ክደር ጋይሰኬ።<verse eid="MRK 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29"/>የሱሰረ፥ “ዶፈን የም ጋይድቴ፥ እካንተከ ኮ ክላ ኬዘንካንታ ጋይሶ ይንታ ኤሄንም አነረ ይንታ እስመንከስም አነረ ይንታ ምችነንከስም አነረ፥ ይንታ እንደንም፥ አነረ ይንታ ባበንም፥ አነረ ይንታ ይንችንም፥ ናነረ ይንታ ዎንንም ዛቅስባብ ኤድ ሙደና ስክስሶ Ꮊብዴ፥ <verse eid="MRK 10:29"/><verse number="30" style="v" sid="MRK 10:30"/>ታ ኮ ፍጫሙደንዘን ዎራ ዳይርንካ ክክን ይንታ ኤሄንም፥ እስመንከስም፥ ምችነንከስም እንደንከስም ይንችንከስም ዎንንም ዶንቅ ቦንደዘን ዶንቅ ቦንዳ ጉጅምሳንደትም ተይዴ፥ Ꮊድን ፍጫሙደንዘን ስለንካ ዶቅንትንም Ꮊፍተሬ። <verse eid="MRK 10:30"/><verse number="31" style="v" sid="MRK 10:31"/>ማታጋካ ዳት እር ማትሶ Ꮊቅባብ በድንከስ ቡርንባብ ማተረከ፥ ቡርንባብ ማችባብከሰረ እርንባብ ማተረከ” ኩን ከትም ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">10፡31 </char><char style="xt" closed="false"><ref loc="MAT 20:16">ማቶ. 20፡16</ref>። </char></note><verse eid="MRK 10:31"/></para>
  <para style="s1">የሱስ ይንታ ደእንታ ማክምስ ዱት ኬዘና</para>
  <para style="r">(<ref loc="MAT 20:17-19">ማቶ. 20፡17-19</ref>፤ <ref loc="LUK 18:31-34">ሉቃ. 18፡31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32"/>የሩሳሌም አይድን ጎግዘን ከትዶቅድንካ፥ የሱስ ከታ እር አይድ Ꮊቄ፥ ክታካርንካ ጎርስምድባብከሰረ ኮርንካ በርእሰኬ፥ ክታ ካርንካ Ꮊድባብ አብንከስ ጳዝድ Ꮊቀኬ። ካርንከረ ታሜከ ቃስተንን ይንደር ተይᎺችሶ፥ ይንዘን የልድን ሪንጎካ ኩንጋየሮ ከትካንታ ኬዜ፥ <verse eid="MRK 10:32"/><verse number="33" style="v" sid="MRK 10:33"/>“ይና፥ የሩሳሌማር ዎንታ አይንቴ፥ ኤድ ይንች ቀሰንከስም ገችዝድባብከስካንተኬ ሙሴታ ህግን ኤስዝድባብከስካንታ ስክስምት እምምተሬ፥ ከተረ ደእታ ፍርደን ክታዘን ፋረተርኬ፥ አይሁድ ማታክባብከስካንታ ስክስት ክትም እምተረኬ፥ <verse eid="MRK 10:33"/><verse number="34" style="v" sid="MRK 10:34"/>አይሁድ ማታክባብከሰረ ክታዘን Ꮊልተርተረኬ፥ ክታዘን ፈጭምተረኬ፥ ክትም Ꮊርተረከ፥ ክትም ደይስተረኬ፥ ኬዛር ማቼ ማከን ሰጨታ ቡር ኖ አምተሬ”።<verse eid="MRK 10:34"/></para>
  <para style="s1">ያይቆበተኬ ዮሀንሰተካ ኦይስና</para>
  <para style="r">(<ref loc="MAT 20:20-28">ማቶ. 20፡20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35"/>ዛብዶሰታ ይንችንከስ ያይቆበኬ ዮሀንሰካ የሱሰደር Ꮊድሰኮ፥ “ኤስስንባቦ፥ የስም ዎ ምግዝድንደትም ሙዳ የስ ይድንግንዳ ዝግዶቴ” ክደር ጋይሰኬ።<verse eid="MRK 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36"/>የሱሰረ “Ꮊራ እ የካንታ ይድንግንደንት ዝግዳ?” ከደር ጋይሴ። <verse eid="MRK 10:36"/><verse number="37" style="v" sid="MRK 10:37"/>ከተረ “የስታ ቦንችምሳን ባንችምንᎺይካ ዎንታርንካ ዋልቀና የስታ ምዝዘን፥ ዋልቀና የስታ ብተንዘን ዎ ዶቅድንግንዳ ዎካንታ ጋይካ” ክደር ጋይሰኬ።<verse eid="MRK 10:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38"/>የሱስ ማቼ “የታ የ ምግዝድንደትም ኤዝዳከቴ፥ እ ዎጭድን ማጠንታ ዎጭምን ዎጭካንታ ማደቴ? እ ስኤርድንደት ስእርንም ስእርካንታ ማደቴ?” ከትም ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">10፡38 </char><char style="xt" closed="false"><ref loc="LUK 12:50">ሉቃ. 12፡50</ref>። </char></note><verse eid="MRK 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39"/>ከተረ “ይዬ ዎጭካንታ ማዶቴ” ከታ ጋይሰኬ። የሱሰረ፥ “ዶፈን እ ዎጭድንደትም ማጠንታ ዎጭምን ዎጭተረቴ፥ እ ስኤርድንደትም ስእርን ስኤርተረቴ። <verse eid="MRK 10:39"/><verse number="40" style="v" sid="MRK 10:40"/>ኬዛር ማቼ እስታ ምዝዘንኬ እስታ ብተዘን ዶቅንትን እምድባብ እታ ካይቴ፥ ኮና እምምድንዳ ሳብ ይ ግክስባብ ኤድንከስካንታ Ꮊክዬ”።<verse eid="MRK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41"/>ነገድባብከስ ታሜና ኮም ኤሰርሰኮ ያይቆብዘንከ ዮሀንሰዘን ዋጨኬ። <verse eid="MRK 10:41"/><verse number="42" style="v" sid="MRK 10:42"/>የሱስ ሙደንመረ ይንደር ኤልሶ ኩን ከትም ጋይሴ፥ “አይሁድ ማታክባብከስታ ገችንባብ ዎርሰንም ቆልድባብከስ ጋይምሰኮ ኤልምድንግንደከ ከትም ጎርዝድባብከሰረ ከታዘን ገችታ ኤራ ዶቅድንደትም የታ ኤዝደቴ፥<note caller="-" style="x"><char style="xo" closed="false">10፡42 </char><char style="xt" closed="false"><ref loc="LUK 22:25-26">ሉቃ. 22፡25-26</ref>። </char></note> <verse eid="MRK 10:42"/><verse number="43" style="v" sid="MRK 10:43"/>የንደር ማቼ ኮግንዳ ማት ዝግስሳዬ፥ የንታ ዎክያርንካ አንድር ማትካንታ ዝግድባብ፥ የንታ ፍክስባብ ማት ክትም ዝግዝዴ፥<note caller="-" style="x"><char style="xo" closed="false">10፡43 </char><char style="xt" closed="false"><ref loc="MAT 23:11">ማቶ. 23፡11</ref>፤ <ref loc="MRK 9:35">ማር. 9፡35</ref>፤ <ref loc="LUK 22:60">ሉቃ. 22፡60</ref>። </char></note> <verse eid="MRK 10:43"/><verse number="44" style="v" sid="MRK 10:44"/>ኮትኮግንደረ የንታ ዎክያርንካ ሙደንዘንካ ስግ ማትካንታ ዝግድባብ ሙደንታ አይላ ማታ። <verse eid="MRK 10:44"/><verse number="45" style="v" sid="MRK 10:45"/>ኤደት ይንች ዎራ ፍክስካንተኬ ይንታ ሰንፔንም በድንከስካንታ ቆትማ ማስሶ እማካንታ Ꮊዳ ዳት ክትካንታ ፍግዝድንግንዳ Ꮊዳክዬ።”<verse eid="MRK 10:45"/></para>
  <para style="s1">የሱስ አፍይ ዝልን በርጤመዎሰም ፋችና</para>
  <para style="r">(<ref loc="MAT 20:29-34">ማቶ. 20፡29-34</ref>፤ <ref loc="LUK 18:35-43">ሉቃ. 18፡35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46"/>ኮታ ቡር የሱስ ይንታ ካርንካ ጎርስምድባብከስካ ክክን ኢያርኮ ካተመናር Ꮊዴ። ስግሰረ ካተመናርንካ ዉትሶ ክት አይድንᎺይካ አንድር በድ ዎርሳ ክትም ጎርስምድ Ꮊቄ፥ ጉጅሰረ ጎግንታ ካንታር ጤሜዎሰታ ይንች ማችባብ በርጤመዎስ ጋይምድባብ ዋልቃ ኣፊይ ዝል ዶቅሶ ምግዝድ Ꮊቄ። <verse eid="MRK 10:46"/><verse number="47" style="v" sid="MRK 10:47"/>ኮትከረ ስግድባብ ናዝረት የሱስ ማትንተን ይ ኤሰርሳንደትካ “ዳውትታ ይንች የሱሶ፥ ዋደ እካንታ አጨርካ!” ጋየሮ ፍፍ የጄ። <verse eid="MRK 10:47"/><verse number="48" style="v" sid="MRK 10:48"/>በድንከስ ጫምን ጋይካ! ጋይሰኮ ክትም ዋጨኬ፥ ኖ ማቼ “ዳዊተታ ይንችኖ! ዋዴ እም ኣጬርካ” ጋየሮ ስግስሶ ፍፍሴ።<verse eid="MRK 10:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49"/>የሱሰረ ዎእሶ “ክትም ኤልከቴ!” ጋይሴ፥ ከተረ አፍይ ዝልንመረ “ታ ዛብካ! አምካ! የሱስ የስም ኤልዴ!” ክደር ጋይሰኬ።<verse eid="MRK 10:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 10:50"/>ኤችነረ አፍለን ይንታ ዛቅሶ ጎብሶ አምትዮ የሱሰደር አይሴ።<verse eid="MRK 10:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51"/>የሱሰረ ክትም “Ꮊራ እ የስካንታ ይድንግንደስ ዝግዳ?” ጋየሮ ክትም ኦይሴ።</para>
  <para style="q1" vid="MRK 10:51">ኣፊይ ዝል ኤችና “ኤስስንባቦ፥ ዋደ እስታ አፍና ሰድንግንዳ እካንታ ይካ” ክትም ጋይሴ።<verse eid="MRK 10:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52"/>የሱሰረ “ይና አይካ፥ የስታ አሜንና የስም አቅስቴ” ክትም ጋይሴ። ኤችነረ ሳነካ ሰድንካንታ ማቼ፥ ጎግንኮትከረ የሱሰም ጎርስምሶ አይሴ።<verse eid="MRK 10:52"/></para>
  <chapter eid="MRK 10"/>
  <chapter number="11" style="c" sid="MRK 11"/>
  <para style="s1">የሱስ አንድር ቦንቸካ የሩሳሌማር አርድና</para>
  <para style="r">(<ref loc="MAT 21:1-11">ማቶ. 21፡1-11</ref>፤ <ref loc="LUK 19:28-40">ሉቃ. 19፡28-40</ref>፤ <ref loc="JHN 12:12-19">ዮሀ. 12፡12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1"/>የሱሰኬ ክታ ካርንካ ጎርስምድባብከስከ የሩሳሌማር ከት የልሳንደትካ ደብረዛይት ገቼንታ ላማር በቴ ፋጋርኬ ብታንያ ሞረናር የልሰኬ፥ ኮታዘንከረ የሱስ ይንታካርንካ ጎርስምድባብከሳርንካ ቃስተንንም ኩንጋየሮ ከትም ኦይቼ፥ <verse eid="MRK 11:1"/><verse number="2" style="v" sid="MRK 11:2"/>“የንታ እሪ ዶቅድን ሞረናር አይከቴ፥ ኮታረረ የ የልሳንግንዳ ሳነካ Ꮊየነረ ኤድ አክ ዶቃክንዳ ኡክልታ ቅንጭ ዞክርሶ ዶቅድንደትም Ꮊፍተረቴ፥ ቡልተቶ እዝደር ተይ Ꮊድከቴ። <verse eid="MRK 11:2"/><verse number="3" style="v" sid="MRK 11:3"/>Ꮊየሰነረ ‘Ꮊረተንት ኮም ይዳ?’ የንደር ጋይሴ፥ ‘ጮይስካንታ ዝግዝዴ፥ ሳነካ ማስት ኖ ኦይተሬ’ ጋይሶ ከስከቴ”። <verse eid="MRK 11:3"/><verse number="4" style="v" sid="MRK 11:4"/>ከተረ አይሰኮ ኡክልታ ቅንጨን ጎግንታ ካንተዘን ኤሄንታ ዎፈዘን ዞከርስንካ Ꮊፍሰኮ ቡልሰኬ። <verse eid="MRK 11:4"/><verse number="5" style="v" sid="MRK 11:5"/>ኮታይከረ ዋር ዎእሶ ዶቅድባብ ኤድንከሳርንካ ዋልቃ ዋልቀንከስ። “ኡክልንታ ቅንጭንም የ ቡልድንዳ Ꮊረተረ?” ጋይሶ ከትም ኦይሴ። <verse eid="MRK 11:5"/><verse number="6" style="v" sid="MRK 11:6"/>ከተረ የሱስ ከደር ጋይሳንደትም ኤድንከስካንታ ኬዘኬ፥ ኤድንከሰረ ከትም ዛቅሴ። <verse eid="MRK 11:6"/><verse number="7" style="v" sid="MRK 11:7"/>ክታ ካርንካ ጎርስምድባብከሰረ ኡክልንታ ቅንጭንም የሱሰደር ተይ Ꮊደኬ፥ ከታ ይንታ አፍለንም ኡክልንታ ባዝደዘን ዎጅንካ የሱስ ኮታዘን ዶቅሴ። <verse eid="MRK 11:7"/><verse number="8" style="v" sid="MRK 11:8"/>በድ ኤድንከስ ይንታ አፍለንም ጎግንዘን ታከርሰኬ፥ አብንከሰረ ጮልም Ꮊቀንታ ትርሰንም ፋክተኮ ታከርድ Ꮊቀኬ። <verse eid="MRK 11:8"/><verse number="9" style="v" sid="MRK 11:9"/>እሪ ስግድባብከስከ ክታ ቡር ጎርስምድባብከስ ሙደና፥</para>
  <para style="q1" vid="MRK 11:9">“ሆሳእና!<note caller="+" style="f"><char style="fr" closed="false">11፡9 </char><char style="ft" closed="false">እብራይስጥ አፈካ “ታ ዎም አቅስካ” ጋይንትዬ። </char></note> ጮይስታ ላምካ Ꮊድባብ አንጅምስባቤ!<note caller="-" style="x"><char style="xo" closed="false">11፡9 </char><char style="xt" closed="false"><ref loc="PSA 118:25-26">የቺ 118፡25-26</ref>። </char></note><verse eid="MRK 11:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="MRK 11:10"/>Ꮊድንዳ ዎንታ ባበን ዳውትታ ባንችምና አንጅምሳንዴ፥ ጎፍስና ጬክን ጋይሳን ጭለዘን ሳብካንታ ማታ!” ጋየረኮ ፍብድ Ꮊቀኬ።<verse eid="MRK 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11"/>የሱሰረ የሩሳሌማር የልሳንደትካ ሳብታ ጭል ኤሄናር አርደዴ፥ ካንተካ ዶቅድንደትም ርን ሙዳ ሰጄ፥ ሰጨነረ ሶይቻንካንታ ታመከ ቃስተንንከስካ ክክን ብታንያ ሞረናር አይሴ።<verse eid="MRK 11:11"/></para>
  <para style="s1">የሱስ ባድሳን Ꮊቀን በለስና</para>
  <para style="r">(<ref loc="MAT 21:18-19">ማቶ. 21፡18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12"/>ዛማክንካ ብታንያርንካ ከት ማድንካ የሱስ ዳቀርሴ። <verse eid="MRK 11:12"/><verse number="13" style="v" sid="MRK 11:13"/>ቃምና ኮታ ጮልሳንዳ Ꮊቃ ባለስ ጋይምድንደትም ጎትካ ሰድሶ Ꮊረንግርካ አፍ Ꮊፈርዳናንከረ ጋይሶ ኮደር Ꮊዴ፥ ኬዛር ማቼ ኮደር Ꮊድንካ Ꮊቃ በለስና አፍ ኡዝድንደታ አርፍ ማታክንካንታ ቃምዘንካ አብ Ꮊረነረ ኮታዘንካ Ꮊፋክዬ። <verse eid="MRK 11:13"/><verse number="14" style="v" sid="MRK 11:14"/>ኮካንታ የሱስ በለስ Ꮊቀን፥ “ይና ኮዘንካ ኦስ ስለንክንደታ Ꮊየነረ የዘንካ አፍ Ꮊይ እቻ!” ኮትም ጋይሴ። ኮመረ ክት ኬዝድንካ ክታ ካርንካ ጎርስምድባብከስ ኤሰርሰኬ።<verse eid="MRK 11:14"/></para>
  <para style="s1">የሱስ ሳብታ ጭል ኤሄናር ጋበንባብከስም ዉችና</para>
  <para style="r">(<ref loc="MAT 21:12-17">ማቶ. 21፡12-17</ref>፤ <ref loc="LUK 19:45-48">ሉቃ. 19፡45-48</ref>፤ <ref loc="JHN 2:13-22">ዮሀ. 2፡13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15"/>የሩሳሌማር ከታ የልሳንደትካ የሱስ ሳብታ ጭል ኤሄናር አርድሶ ኮታር ሰንድባብምከ ጋብድባብ ኤድንከስም ዉች የጄ፥ ብረን ኦካኦግድባብከስታ ጣርጰዘንምኬ፥ ዎለንም ሰንድባብከስታ ዶቅንት ጎንገንከስም ባልትዮ ኦይቼ። <verse eid="MRK 11:15"/><verse number="16" style="v" sid="MRK 11:16"/>Ꮊየነረ ኤድ Ꮊረነረ ር ባልትዮ ሳብታ ጭል ኤሄንታ ጋስናር ስገድንግንዳ ጋያይቴ። <verse eid="MRK 11:16"/><verse number="17" style="v" sid="MRK 11:17"/>ኩነረ ጋየሮ ከትም ኤስሴ፥</para>
  <para style="q1" vid="MRK 11:17">“ ‘እስታ ኤሄና ዎርሳ ሙደንካንታ ምክስ ኤሀ ጋይምዴ!’ ጋይምሶ ጻፍማክዮ?</para>
  <para style="m" vid="MRK 11:17">የታ ማቼ ፋንገንከስ አጥምድንግንዳ የርሳ ማስሰቴ” ከትም ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">11፡17 </char><char style="xt" closed="false"><ref loc="ISA 56:7">ኢሳ. 56፡7</ref>፤ <ref loc="JER 7:11">ኤር. 7፡11</ref>። </char></note><verse eid="MRK 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18"/>ቄሰን ከስም ገችዝድባብከስኬ ሙሴታ ህግንም ኤስዝድባብከስ ኮም ክት ኬዝድንካ ኤሰርሰኬ፥ ዎርሰነረ ሙዳ ክታ ኤስስንካ ከት በርእሳንካንታ ክትም ጳሰኬ፥ ማታጋካ ዳት Ꮊስግንዳ ይይሶ ከታ ክትም ይ ደይዝደክ ናነረ ጎግ ዝግድ Ꮊቀኬ።<verse eid="MRK 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19"/>ፍጨና ሶይቻንደታ ቡር የሱሰኬ ይንታ ካርንካ ጎርስምድባብከስካ ካተመናርንካ ዉተደኬ።<verse eid="MRK 11:19"/></para>
  <para style="s1">ባለስ Ꮊቀንታ ዎችና</para>
  <para style="r">(<ref loc="MAT 21:20-22">ማቶ. 21፡20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20"/>ዛማክንᎺይካ ሰጭማ ጎግንካ ከት ስገድንካ ባለስ Ꮊቀና ይንታ ጫጭንካ ዎችንካ ሰደኬ። <verse eid="MRK 11:20"/><verse number="21" style="v" sid="MRK 11:21"/>ጴጥሮሰም ርና ከልቅን ጋይስንካ የሱሰም፥ “ኤስስንባቦ! ኮሰቼ፥ የስ ባድሳን ባለስ Ꮊቀና ዎችቴ” ጋይሴ። <verse eid="MRK 11:21"/><verse number="22" style="v" sid="MRK 11:22"/>የሱሰረ፥ “ሳብካ አመንከቴ፥ <verse eid="MRK 11:22"/><verse number="23" style="v" sid="MRK 11:23"/>ዶፈን የካንታ ጋይድቴ፥ Ꮊየነረ ኤድ ይንታ ቡዳር Ꮊኤራክዶቆ ክት ዝግድን ርና ክትካንታ ቦድምድንደትም አሜንሶ ኮም ገቸን ‘ኮዘንካ አምሰዮ ባሀርናር አይካ’፥ ክት ጋይሴ ክትካንታ ማዴ።<note caller="-" style="x"><char style="xo" closed="false">11፡23 </char><char style="xt" closed="false"><ref loc="MAT 17:20">ማቶ. 17፡20</ref>፤ <ref loc="1CO 13:2">1 ቆሮ. 13፡2</ref>። </char></note><verse eid="MRK 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 11:24"/>“ኮካንታ ምክስካ Ꮊምንመረ ር የ ምክሴ፥ የካንታ ቦድምሳን ማስሰቶ አመንከቴ፥ የ ምግዝድንደትም ሙዳ የካንታ እምምዴ። <verse eid="MRK 11:24"/><verse number="25" style="v" sid="MRK 11:25"/>ጭላር ዶቅድባብ የንታ ባቤና የንታ ጎመንም ነጋ ጋይተርንግንዳ የተረ ምክስካንታ የ ዎእድንᎺይካ Ꮊየነረ ዋልቃ ሪካ የም ይምኤርስታ ማቼ ክትካንታ ነጋ ጋይከቴ።<note caller="-" style="x"><char style="xo" closed="false">11፡25 </char><char style="xt" closed="false"><ref loc="MAT 6:14-15">ማቶ. 6፡14-15</ref>። </char></note> <verse eid="MRK 11:25"/><verse number="26" style="v" sid="MRK 11:26"/>የታ አብንከስታ ዳቀልስን ነጋ የ ጋያይንዳ ማቼ ጭላር ዶቅድባብ የንታ ባቤና የንተረ ጎመን ነጋ የካንታ ጋያዬ” ከትካንታ ኩን ጋይሴ።<note caller="+" style="f"><char style="fr" closed="false">11፡26 </char><char style="ft" closed="false">ዋልቃ ዋልቃ ኤና እር ጻፈርሳንደና ፋይ. 26 ጉጅደኬ፥ ቃለነረ ማቶ. 6፡15 ዶቅድንደትም ካምዴ። </char></note><verse eid="MRK 11:26"/></para>
  <para style="s1">የሱስ ገችታ ኤረንጎካ ክታ ኦይስምና</para>
  <para style="r">(<ref loc="MAT 21:23-27">ማቶ. 21፡23-27</ref>፤ <ref loc="LUK 20:1-8">ሉቃ. 20፡1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27"/>አናካርንካ የሩሳሌማር Ꮊደኬ፥ የሱሰረ ሳብታ ጭል ኤሄናር ክት ኦንግድንካ፥ ቀሰንከስታ ገችንባብከ፥ ሙሴታ ህግንም ኤስዝድባብከስከ ጋልተንከስካ ክደር Ꮊድሰኮ፥ <verse eid="MRK 11:27"/><verse number="28" style="v" sid="MRK 11:28"/>“ከትኬና ሪን የስ ይድንዳ Ꮊራ ገችስታ ዎልቀከረ? አና ከነም ርንከስም የስ ይድንግንዳ ገችስታ ኤረንም የስካንታ እምስባብ Ꮊይራ?” ጋየረኮ ክትም ኦይሰኬ።<verse eid="MRK 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29"/>የሱሰረ፥ “ይና እተረ የም ዋልቃ ኦይስ የም ኦይዝድቴ፥ የታ እካንታ የ ማስሴ፥ እተረ ኬና ርንከስም Ꮊራ ገችታ ኤረካ እ ይዳናከረ የካንታ ኬዝድቴ ኩን ከደር ጋይሴ። <verse eid="MRK 11:29"/><verse number="30" style="v" sid="MRK 11:30"/>ዮሀንሰታ ስእስና ሳብዘንኮ ኤድዘንኮ? እካንታ ማስከቴ” ከደር ጋይሴ።<verse eid="MRK 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31"/>ከተረ “ይና Ꮊሮንት ጋይቴ?” ጋይንተካ ክክ ክክ ዞርምሰኬ፥ “ ‘ሳብዘንኬ’፥ ዎ ጋይሴ፥ ‘ኮናና Ꮊረተረ ክትካ የ አሜናክንዳ?’ ዎም ኖ ጋይዴ፥ <verse eid="MRK 11:31"/><verse number="32" style="v" sid="MRK 11:32"/>‘ኤድዘንኬ’ ጋይተሮቶ?” ኮም ከት ጋይዳክንግንዳ ዎርሰና ሙዳ ዮሀንሰም ዶፈን ሳብዘንካ ኤሰርሶ ኬዝድባቤ ጋይድ ከትᎺቃንካንታ ጳሰኬ። <verse eid="MRK 11:32"/><verse number="33" style="v" sid="MRK 11:33"/>ኮካንታ “ዎታ ኤሳዮቴ” ጋየረኮ ክትካንታ ማስሰኬ። የሱሰረ “ይና ኮናና እተረ Ꮊራ ገችታ ኤረካ ኬና ርንከስም እ ይይዳናንከረ የም ኬዛይቴ” ከደር ጋይሴ።<verse eid="MRK 11:33"/></para>
  <chapter eid="MRK 11"/>
  <chapter number="12" style="c" sid="MRK 12"/>
  <para style="s1">ዎይን ኮረንታ ዎንንባብከስታ ካምስ</para>
  <para style="r">(<ref loc="MAT 21:33-46">ማቶ. 21፡33-46</ref>፤ <ref loc="LUK 20:9-19">ሉቃ. 20፡9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1"/>ኮታዘንከረ የሱስ ኮም ካምስካ ኩንጋየሮ ከትም ኬዛ የጄ፥ “ዋልቃ ኤች ኮረርድን ዎይንንም ኮርሴ፥ ካንተንመረ ጋሴ፥ ዎይንን ጩጴርድንደታ ጎር ኮይሶ ካርሰርድንደታ ላቼረ ኡርሴ። ኮታዘንከረ ዎንንባብከስካንታ እምሶ አብ ፍጫር አይሴ”። <verse eid="MRK 12:1"/><verse number="2" style="v" sid="MRK 12:2"/>አፍ ኡዝድን ለእንካ ዎይንታ አፍንም ካምት Ꮊትርንግንዳ ፍክስንባብከሳርንካ ዋልቀን ዎንንባብከዝደር ኦይቼ። <verse eid="MRK 12:2"/><verse number="3" style="v" sid="MRK 12:3"/>ከታ ማቼ የድሰኮ ጉጵሰኬ፥ አንይ ዉች ክትም ኦይቸኬ። <verse eid="MRK 12:3"/><verse number="4" style="v" sid="MRK 12:4"/>አናካርንከረ አብ ፍክስንባብም ኦይቼ፥ ከተረ ማተን ክታ ሰይንካ ዛልሰኮ ኦስንስሶ ኦይቸኬ። <verse eid="MRK 12:4"/><verse number="5" style="v" sid="MRK 12:5"/>ታየረ ካርንካ አብንም ኦይቼ፥ ክትመረ ደይሰኬ፥ ኮትኮግንደረ በድንከስም ኦይችንካ ዋልቃ ዋልቀንከስም ጉጵሰኬ፥ አብንከስመረ ደይሰኬ። <verse eid="MRK 12:5"/><verse number="6" style="v" sid="MRK 12:6"/>ታ ይይ ክታዘንካ ነገዳንዳ ይ ሶልምድን ይንታ ይንችንም ኦይት Ꮊክዬ፥ ኮካንታ እስታ ይንችንም ከታ ቦንችተረ ዳቶ ጋይሶ ገቅርካ በእንተዘን ዋልቃ ይንታ ይንችን ኦይቼ። <verse eid="MRK 12:6"/><verse number="7" style="v" sid="MRK 12:7"/>ኬዛር ማቼ ክታ ዎንንባብከስ ክክ ክክ ኖኮና ባእንም ተይድባብኔ! ኮረቴ ክትም ደይስተሮቴ! ባእነረ ዎካንታ ማዴ ክክ ጋይሰኬ። <verse eid="MRK 12:7"/><verse number="8" style="v" sid="MRK 12:8"/>ኮካንታ ይንችንም የድሰኮ ደይሰኬ፥ ዎይን ኮርምሳን ካርናርንከረ ጎችት ዉችሰኮ ዛቅሰኬ። <verse eid="MRK 12:8"/><verse number="9" style="v" sid="MRK 12:9"/>“ይና ኮዘንካ ዎይንን ኮርምሳን ባበና Ꮊርክ ይቴ? ዎይንንታ ባበና ይንታ ማታርንካ Ꮊዴ፥ ይንታ ዎንንባብከስመረ ደይዝዴ፥ ዎይን ኮረንመረ አብንከስካንታ እምዴ። <verse eid="MRK 12:9"/><verse number="10" style="v" sid="MRK 12:10"/>ይና፥</para>
  <para style="q1" vid="MRK 12:10">“ሰይን ኤሄንም ዎድባብከስ ቶችሳን ሰይንና</para>
  <para style="q2" vid="MRK 12:10">ዎደርድን ኤሄንታ እድምሳንዳ ማቼ፥<verse eid="MRK 12:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11"/>ኮነረ ጮይስዘንካ ይምሴ</para>
  <para style="q1" vid="MRK 12:11">ዎንታ አፍንካንታ በርእዝድንዴ”። ኩን ጋይድንደትም ጭል ማጻፍናርንካ ናበባከቴ?<verse eid="MRK 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12"/>አይሁድንከስም ገችዝድባብከስ የሱስ ኬዛንደትም ካምስንከስና ከትም ሰጅድንዳ ማትንተን ከታ ይ ገቀርሳንካንታ ክትም የድካንታ ዝግተክ ዶቆ፥ ኬዛር ማቼ ዎርሰንም ጳስሰኮ ክትም ዛቅሶ አይሰኬ።<verse eid="MRK 12:12"/></para>
  <para style="s1">ቀሳርካንታ ግራ ናክንጎካ</para>
  <para style="r">(<ref loc="MAT 22:15-22">ማቶ. 22፡15-22</ref>፤ <ref loc="LUK 20:20-26">ሉቃ. 20፡20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13"/>ፈረሳዊያንንከስ ሄሮድሰታ ኮች ማችባብ ዋልቃ ዋልቃ ኤድንከስ የሱሰም ክት ኬዝድንደትካ ክትም የድካንታ ክደር ኦይቸኬ። <verse eid="MRK 12:13"/><verse number="14" style="v" sid="MRK 12:14"/>ክደር Ꮊድሰኮ፥ “ኤስስንባቦ፥ የና ዶፈን የስ ማቻንደትም ዎታ ኤዝዶቴ፥ ኤድም ጳስከ ኦስነካ የስ ይድንዳ ር ካዬ፥ ሳብተረ ጎግንም ዶፈንካ ኤስዝደዬ፥ ይና፥ ሮማ ባንችንካንታ ግራ ናክና ዝግዝዶ አና ዝክሳዮ? ዎተረ ግርተሮቶ ግርተራኮቶ?” ኩን ክደር ጋይሰኬ። <verse eid="MRK 12:14"/><verse number="15" style="v" sid="MRK 12:15"/>የሱሰረ ከታ ኦትረንም ኤስሶ “Ꮊራካንተንት ጭካ እካንታ ዎዳ? ይና ብረን ተይᎺድሰቶ እም ሰችከቴ”፥ ከትም ጋይሴ። <verse eid="MRK 12:15"/><verse number="16" style="v" sid="MRK 12:16"/>ከተረ ብረንም ክትካንታ ተይ Ꮊደኬ፥ የሱሰረ “ኮ ብረንዘን ዶቅድንዳ ምስልንኬ ጻፈርሳንዳ ላምና Ꮊይተረ?” ጋይሶ ከትም ኦይሴ።</para>
  <para style="q1" vid="MRK 12:16">ከተረ “ሮመታ ባንችን ቀሳርቴ” ጋይሰኬ።<verse eid="MRK 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17"/>የሱሰረ “ኮናና ቀሳርትንደትም ቀሳርካንታ፥ ሳብትንደትም ሳብካንታ እምከቴ” ጋየሮ ከትካንታ ማስሴ። ከተረ ክታ ኬዘንታ ማስንካ በርእሰኬ።<verse eid="MRK 12:17"/></para>
  <para style="s1">ደእያርንካ አምንታ</para>
  <para style="r">(<ref loc="MAT 22:23-33">ማቶ. 22፡23-33</ref>፤ <ref loc="LUK 20:27-40">ሉቃ. 20፡27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18"/>“ደእስባብታ አምንታ ካዬ” ጋይድባብከስ ሰዱቃዊያን ኤድንከስ የሱሰደር Ꮊድሰኮ ኩንጋየሮ ክትም ኦይሰኬ።<note caller="-" style="x"><char style="xo" closed="false">12፡18 </char><char style="xt" closed="false"><ref loc="ACT 23:8">ኦይት. ፍ. 23፡8</ref>። </char></note> <verse eid="MRK 12:18"/><verse number="19" style="v" sid="MRK 12:19"/>“ኤስስንባቦ፥ ‘ዋልቃ ኤድ ይንች አጣክዶቆ ይንታ ኬነንዘንካ ደእካ ክት ፋስምሴ ክታ እስመና ኤተንን ማስሶ ደእስባብታ ካርያር ይንች አጣ’፥ ጋይሶ ሙሳ ዎካንታ ጻፍቴ።<note caller="-" style="x"><char style="xo" closed="false">12፡19 </char><char style="xt" closed="false"><ref loc="DEU 25:5">ካሪ. 25፡5</ref>። </char></note> <verse eid="MRK 12:19"/><verse number="20" style="v" sid="MRK 12:20"/>ይና፥ ታብዛ እስመንከስ Ꮊቀኬ፥ ከት ሙደንታ ባይረና ማና እንችሶ ይንች አጣክዶቆ ደእሴ። <verse eid="MRK 12:20"/><verse number="21" style="v" sid="MRK 12:21"/>ቃስትምስነረ ኤተንን ኮትም ማስሶ፥ ኖየረ ይንች አጣክዶቆ ደእሴ፥ ማክምስነረ ኮትኮግንዳ ደእሴ፥ <verse eid="MRK 12:21"/><verse number="22" style="v" sid="MRK 12:22"/>ኮግንደካ ታብዘና ኮትም እንችሰኮ ይንች አጣከክ ዶቆ ደእሰኬ፥ ከትሙደንተረ ቡር ኤተነረ ደእሴ። <verse eid="MRK 12:22"/><verse number="23" style="v" sid="MRK 12:23"/>ይና፥ ታብዛ እስመንከሰረ ኮትም እንችተኬ፥ ይና ደእስባብከስ አምድንደትᎺይካ Ꮊይቶክ ማና ና ማዳ?”<verse eid="MRK 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24"/>የሱሰረ፥ “የ ኮተርድንደና ጭል ማጻፍንከ ሳብታ ዎልቀን ኤስክሳ የንታ ነግንተንካ ካዮ? <verse eid="MRK 12:24"/><verse number="25" style="v" sid="MRK 12:25"/>ደእስባብከስ አምድንᎺይካ ጭላር ዶቅድባብ ክታይንችንከስግንዳ ማደክ ዳት እንቻየኬ ይአየኬ። <verse eid="MRK 12:25"/><verse number="26" style="v" sid="MRK 12:26"/>ደእስባብ ማቼ ከት አምድንግንዳ ሳብ፥</para>
  <para style="q1" vid="MRK 12:26">“ ‘እታ አብራሀመታ ጮይስ ይሳቀተረ ጮይስ</para>
  <para style="q2" vid="MRK 12:26">ያይቆበተረ ጮይስቴ’</para>
  <para style="m" vid="MRK 12:26">ክት ጋይሳንደትግንዳ ቆቸናር ኖሄና የድንካ ሙሴካንታ ሳብ Ꮊራክትም ከዛናንከረ ሙሴታ ማጻፍናር ናበባከቴ?<note caller="-" style="x"><char style="xo" closed="false">12፡26 </char><char style="xt" closed="false"><ref loc="EXO 3:6">ዉት. 3፡6</ref>። </char></note> <verse eid="MRK 12:26"/><verse number="27" style="v" sid="MRK 12:27"/>ኮካንታ ሳብ ስለንካ ዶቅድባብከስታ ጮይስ ዳት ደእስባብከስታ ጮይስ ካዬ፥ የታ ማቼ አንድር ኮተርደቴ” ኩንጋይሶ ማስሴ።<verse eid="MRK 12:27"/></para>
  <para style="s1">ሙደንዘንካ ስግድንዳ ክታ</para>
  <para style="r">(<ref loc="MAT 22:34-40">ማቶ. 22፡34-40</ref>፤ <ref loc="LUK 10:25-28">ሉቃ. 10፡25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28"/>ሙሴታ ህግንም ኤስዝድባብከሳርንካ ዋልቀና ከታ ቤርምን ኤሰርድ Ꮊቄ፥ የሱሰስ ኡርመካ ከትካንታ ኬዛንካንታ ሙሴታ ህግንም ኤስዝድባብ ኖ ገቀርሴ፥ የሱሰደር Ꮊድሶ “ሙደንዘንካ ስግድንዳ ክተና Ꮊምነረ?” ጋይሶ ክትም ኦይሴ።<note caller="-" style="x"><char style="xo" closed="false">12፡28 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">ሉቃ. 10፡25-28</ref>። </char></note><verse eid="MRK 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29"/>የሱሰረ፥ “ሙደንዘንካ ስግድንዳ ክተና፥ ‘እስራኤሎ! የና ኤሰርካ፥ ሳብ ዎንታ ጮይስና ዋልቃ ጮይስዬ፥ <verse eid="MRK 12:29"/><verse number="30" style="v" sid="MRK 12:30"/>የነረ የስታ ጮይስ ሳብንም የስታ ቦድማ ቡዳርንካ፥ ቦድማ ሰንፔካ፥ ቦድማ የስታ ገቅርንካ፥ ቦድማ የስታ ዎልቀንካ ሶልምካ’፥ ጋይድንዴ።<note caller="-" style="x"><char style="xo" closed="false">12፡30 </char><char style="xt" closed="false"><ref loc="DEU 6:4-5">ካሪ. 6፡4-5</ref>። </char></note> <verse eid="MRK 12:30"/><verse number="31" style="v" sid="MRK 12:31"/>ኮመረ ካምድንዳ ቃስትምስ ክተና፥ ‘የስታ የለንም የስታ ማታግንዳ ማስሶ ሶልምካ።’ ከትኬና ቃስተንናርንካ ስግድንዳ አብ ክታ ካዬ” ኩንጋየሮ ማስሴ።<note caller="-" style="x"><char style="xo" closed="false">12፡31 </char><char style="xt" closed="false"><ref loc="LEV 19:18">ሌዊ. 19፡18</ref>። </char></note><verse eid="MRK 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32"/>ሙሴታ ህግንም ኤስዝድባበረ የሱሰም፥ “ኤስስንባቦ! ‘ሳብ ዋልቄ፥ ክታዘንከረ አብ ጮይስ ካዬ’ ጋይሶ የስ ኬዛንዳ ገቴ፥<note caller="-" style="x"><char style="xo" closed="false">12፡32 </char><char style="xt" closed="false"><ref loc="DEU 4:35">ካሪ. 4፡35</ref>። </char></note> <verse eid="MRK 12:32"/><verse number="33" style="v" sid="MRK 12:33"/>ኮካንታ ኤድ ይንታ ቦድማ ቡደካ፥ ቦድማ ይንታ ሰንፔንካ ቦድማ ይንታ ገቅርንካ ቦድማ ይንታ ዎልቀንካ ሳብም ሶልማ ክትም ዝግዝዴ፥ ኮትኮግንደረ ይንታ የለንም ይንታ ማታግንዳ ሶልማ ክትም ዝግዝዴ፥ አችሶ ካሰርድንደትምከ አብ ካስነረ ሳብካንታ እምድንዘንካ ስክስሶ ከትኬና ቃስተን ክተንከስም ካርስና ስገዴ” ኩን ክደር ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">12፡33 </char><char style="xt" closed="false"><ref loc="HOS 6:6">ሆሴ. 6፡6</ref>። </char></note> <verse eid="MRK 12:33"/><verse number="34" style="v" sid="MRK 12:34"/>የሱሰረ ሙሴታ ህግን ኤስዝድባብ ኤጨከ በድ ገቅርካ ክት ማስሳንደትም ሰድሶ፥ “የና ሳብታ ባንችምናርንካ ጎተርስባብ ካየዬ” ክደር ጋይሴ። ኮታ ቡር የሱሰደር ኦይስካንታ ካርችስባብ Ꮊየነረ ካዬ።<verse eid="MRK 12:34"/></para>
  <para style="s1">ክርስቶስ Ꮊይታ ይንቸረ</para>
  <para style="r">(<ref loc="MAT 22:41-46">ማቶ. 22፡41-46</ref>፤ <ref loc="LUK 20:41-46">ሉቃ. 20፡41-46</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35"/>የሱስ ሳብታ ጭል ኤሄናር ኤስዝድዮ ኩን ጋይሶ ኦይሴ “ሙሴታ ህግንም ኤስዝድባብከስ ‘ክርስቶስ ዳዊትታ ይንችዬ’ Ꮊረተክ ጋይዳ? <verse eid="MRK 12:35"/><verse number="36" style="v" sid="MRK 12:36"/>ዳዊት ይንታ ማታርንካ አያንይ ጭልንካ ኬዝድዮ፥</para>
  <para style="q1" vid="MRK 12:36">“ ‘ሳብ እስታ ጮይስንካንታ (ሳይምስባብካንታ)፥</para>
  <para style="q2" vid="MRK 12:36">የስታ ይምኤንባብከስም የስታ ዱትንታ ጎያር እ ማስተርን የለልታ</para>
  <para style="q2" vid="MRK 12:36">እስታ ምዝንዘን ዶእካ’ ክትም ጋይቴ።<note caller="-" style="x"><char style="xo" closed="false">12፡36 </char><char style="xt" closed="false"><ref loc="PSA 110:1">የቺ 110፡1</ref>። </char></note><verse eid="MRK 12:36"/></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37"/>ዳዊት ይንታ ማታርንካ ‘ጮይስ’ ጋይሶ ክት ኤልሳንካ ይና፥ ሳይምስባብ ዳውተታ Ꮊስግንድክ ይንች ማዳ?” በድ ዎርሰነረ ጉርምካ ኤሰርድዮ Ꮊቀኬ።<verse eid="MRK 12:37"/></para>
  <para style="s1">ሙሴታ ህግን ኤስዝድባብከዘንካ ካርስም</para>
  <para style="r">(<ref loc="MAT 23:1-36">ማቶ. 23፡1-36</ref>፤ <ref loc="LUK 20:45-47">ሉቃ. 20፡45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38"/>የሱስ ኤስዝድዮ፥ “ቃልም አፍለንከስም ቆበርሰኮ ኦስከ ፈንካ ኦንገን፥ ጋባረረ ቦንችምሳን ሳራትቸን ተይካንታ ሶልምድባብ ሙሴታ ህግን ኤስዝድባብከዘንካ ካርስምከቴ፥ <verse eid="MRK 12:38"/><verse number="39" style="v" sid="MRK 12:39"/>ከታ አይሁድንከስታ ምክስ ኤሄናር ቦንችምሳን ጎንገንም፥ እቸርድን ካርዘነረ ቦንቺምሳን ካርም ዝግደኬ። <verse eid="MRK 12:39"/><verse number="40" style="v" sid="MRK 12:40"/>ኤድ ይምሰዳ ጋይሶ ከት ይድን ቃልማ ምክስንጎካ ገሰረኮ ከታ ክእስንከስ ደእስባብ ማነንከስታ ኤሄን ከታ ሪካይሳ ማዝደከ፥ ኮካንታ ከታዘን ስግዳን ፍርዳ የልተሬ” ኩን ጋይሴ።<verse eid="MRK 12:40"/></para>
  <para style="s1">ኤተን ቡድነንታ እመና</para>
  <para style="r">(<ref loc="LUK 21:1-4">ሉቃ. 21፡1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41"/>የሱስ እመን እመርድንደትጎካ ዶቅሶ ክት ዶቅድንካ ዎርሰና ኦይተርድንደታር ከት ብረን ኦይድንካ ሰድ Ꮊቄ፥ በድ ቆልመንክንባብከስ በድ ብራ ኦይድ Ꮊቀኬ፥ <verse eid="MRK 12:41"/><verse number="42" style="v" sid="MRK 12:42"/>ዋልቃ ኤተን ቡድና ርካየንዳ Ꮊድሶ ዋልቃ ሳንትም ማድን ቃስተን ባከና ኮታር ኦይቼ። <verse eid="MRK 12:42"/><verse number="43" style="v" sid="MRK 12:43"/>የሱሰረ ይንታ ካርንካ ጎርስምድባብከስም ኤልሶ፥ “ዶፈን የም ጋይድቴ፥ ብረን ሳንሰርድንደታር ኦይችባብ ኤድ ሙደንከሳርንካ ስክስሶ ኦይቻንዳ ናኮና ርካየንዳ ቡድነኔ። <verse eid="MRK 12:43"/><verse number="44" style="v" sid="MRK 12:44"/>አብንከስ ሙዳ ከት እምሳንዳ ከታ ዶቅድን ቆልመናርንካ ስጫንደትሜ፥ ናማቼ ሪካየንዳ ማትሶ ዶቅድዮ Ꮊረነረ ነክሳክዶቆ ይንታ ዶቅድንደትም ሙዳ እምሴ” ኩን ከትም ጋይሴ።<verse eid="MRK 12:44"/></para>
  <chapter eid="MRK 12"/>
  <chapter number="13" style="c" sid="MRK 13"/>
  <para style="s1">በእንታ ስለንታ ቃዉተንከስ</para>
  <para style="r">(<ref loc="MAT 24:1-2">ማቶ. 24፡1-2</ref>፤ <ref loc="LUK 21:5-6">ሉቃ. 21፡5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1"/>የሱስ ሳብታ ጭል ኤሄናርንካ ዉድንካ ክታ ካርንካ ጎርስምድባብከሳርንካ ዋልቀና፥ “ኤስስንባቦ! ከትከነም ሰይንንከስምከ ሰይን ኤሄንከስም ሰድካ፥ በርእስዝድባብከሰኬ!” ጋይሰኬ። <verse eid="MRK 13:1"/><verse number="2" style="v" sid="MRK 13:2"/>የሱሰረ ማስሶ “ከነም አንድር ሰይን ኤሄንከስም የና ሰዳዶቅዳ? ኬና ሰይንንከስ ሙዳ ዉልእምደኬ፥ ሰይን ሰይንዘን ከልምሶ ነገዳክዬ” ጋይሶ ክትካንታ ማስሴ። <verse eid="MRK 13:2"/><verse number="3" style="v" sid="MRK 13:3"/>የሱስ ሳብታ ጭል ኤሄንታ የረየር ደብረዘይት ገቼንዘን ዶቅሶ ክት ዶቅድንካ ጴጥሮስ፥ ያይቆብ፥ ዮሀንሰከ እንድራሰካ ከታ ይንት የሱሰደር Ꮊድሰኮ፥ <verse eid="MRK 13:3"/><verse number="4" style="v" sid="MRK 13:4"/>“ኮና ርና ማድንዳ Ꮊንተረረ? ኮነረ ሙዳ ቦድካንታ የልድንካ ቃዉተና Ꮊራ? ይና ዎም የና ኬዝካ” ጋየረኮ ክትም ኦይሰኬ።<verse eid="MRK 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5"/>የሱሰረ፥ “Ꮊየነረ የም ኮተርዝዳክንግንዳ ካርስምከቴ፥ <verse eid="MRK 13:5"/><verse number="6" style="v" sid="MRK 13:6"/>በድንከስ፥ ‘እታ ክርስቶስቴ!’ ጋየሮ እስታ ላምንካ Ꮊተረኬ፥ በድ ኤድንከስመረ ኮተርስተረከ። <verse eid="MRK 13:6"/><verse number="7" style="v" sid="MRK 13:7"/>የንታ ላማር ዳም ዳምምድንከ ጎትንከረ ዳምትንደትም ኤሰርደቶ Ꮊይገቀቴ፥ ኮና ሙዳ ማትካንታ ነጋይንዴ፥ ማታጋካ ዳት በእንተና አክዬ። ኩንጋየሮ ከትካንታ ማስሴ። <verse eid="MRK 13:7"/><verse number="8" style="v" sid="MRK 13:8"/>ዎርሰና ዎርሰንዘን፥ ባንችና ባንችንዘን አምተሬ፥ በድ ካርዘን ፍጨታ ጭጭከ ዳቅከ ማተሬ፥ ኬና ሙዳ እችር ማጠታ የድንታ ማተሬ”። <verse eid="MRK 13:8"/><verse number="9" style="v" sid="MRK 13:9"/>“የተረ የንታ ማታ ካንታ ካርስምከቴ፥ ኤድንከሰረ ፍርደን ፋረድባብከስካንታ ስክስት የም እምተረኬ፥ አይሁድንከስታ ምክስ ኤሄናር የም Ꮊርተረከ፥ ማርካ እካንታ የ ማድንግንዳ እጎካ ዎርሰን ገችዝድባብከዝደርከ ባንችንከስታ እር ፋረድምካንታ ዎእተረቴ።<note caller="-" style="x"><char style="xo" closed="false">13፡9 </char><char style="xt" closed="false"><ref loc="MAT 10:17-20">ማቶ. 10፡17-20</ref>። </char></note> <verse eid="MRK 13:9"/><verse number="10" style="v" sid="MRK 13:10"/>ኮና ሙዳ ማተርንደታ እሪ ማቼ ክላ ኬዘና ፍጫሙደንዘን ዎርሰንካንታ ሳባክም ዝግዝዴ። <verse eid="MRK 13:10"/><verse number="11" style="v" sid="MRK 13:11"/>ኤድንከስ የድሰኮ ፍርዳካንታ የም የልዝድንካ፥ ‘Ꮊሮንት ከስተራ?’ ጋይንትካ እርምሶ Ꮊይማጠረቴ፥ ኬዝድባብ አያንይ ጭልና ዳት የታ ካየቴ። ኮካንታ ኮት ሳዓትንካ የካንታ እምድንደትም Ꮊክ ኬዝከቴ <verse eid="MRK 13:11"/><verse number="12" style="v" sid="MRK 13:12"/>እስመና ይንታ እስመንም፥ ባበና ይንታ ይንችንም ደእ ካንታ ስክስት እምተሬ፥ ይንችንከሰረ አጥመንባብከዘን አምተረኬ፥ ከትም ደይስተረኬ። <verse eid="MRK 13:12"/><verse number="13" style="v" sid="MRK 13:13"/>እስታ ላምንካንታ ጋይሶ ኤድ ሙደንደር ቦስምስባብ ማተረቴ፥ በእንታ የለልታ ዳንዳእካ ዳቅድባብ ማቼ አቅተሬ”።<note caller="-" style="x"><char style="xo" closed="false">13፡13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">ማቶ. 10፡22</ref>። </char></note><verse eid="MRK 13:13"/></para>
  <para style="s1">ዘርዝድንዳ ማጣ</para>
  <para style="r">(<ref loc="MAT 24:15-28">ማቶ. 24፡15-28</ref>፤ <ref loc="LUK 21:20-24">ሉቃ. 21፡20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14"/>“ጉጅሰረ Ꮊፍር ዝግዝዳክን ካርዘን ካይስዝድን ቱና ር ሰተረቴ፥ ኮመረ ናበብድባብ ክት ገቅራ፥ ኮታይካ ይሁዳ ሞረናር ዶቅድባብከስ ገቼንከዝደር ከት Ꮊዛ።<note caller="-" style="x"><char style="xo" closed="false">13፡14 </char><char style="xt" closed="false"><ref loc="DAN 9:27">ዳን. 9፡27</ref>፤ <ref loc="DAN 11:31">11፡31</ref>፤ <ref loc="DAN 12:11">12፡11</ref>። </char></note> <verse eid="MRK 13:14"/><verse number="15" style="v" sid="MRK 13:15"/>ኤሄንታ የለንዘን ዶቅድባብ Ꮊንቼርሶ ይንታ ኤሄናርንካ ዋልቃ ሪየረ ተይካንታᎺይ አርዳ፥<note caller="-" style="x"><char style="xo" closed="false">13፡15 </char><char style="xt" closed="false"><ref loc="LUK 17:31">ሉቃ. 17፡31</ref>። </char></note> <verse eid="MRK 13:15"/><verse number="16" style="v" sid="MRK 13:16"/>ዎን Ꮊምናርንባበረ ይንታ አፍለን ተይካንታ ቡር Ꮊይማታ። <verse eid="MRK 13:16"/><verse number="17" style="v" sid="MRK 13:17"/>ኮትᎺይካ ማና ስርመንከስ ካንተከ አምን ጋእዝድባብከስካንታ አንድር ማጣ ማተረ! <verse eid="MRK 13:17"/><verse number="18" style="v" sid="MRK 13:18"/>ኮና ሙዳ በርግካ ማተራክንግንዳ ምክስከቴ። <verse eid="MRK 13:18"/><verse number="19" style="v" sid="MRK 13:19"/>ኮትኮ አርፈንካ ሳብ ፍጫ ሙደን ፍዛንደትዘንካ የችሶ ታ የለልታ ይምድንካ ሰድማክንዳ ማጣ ማተረ፥ ኦስ እረረ ኮትም ካምድንዳ ይምዳክንዳ ማጣ ኮታይካ ማተረ።<note caller="-" style="x"><char style="xo" closed="false">13፡19 </char><char style="xt" closed="false"><ref loc="DAN 12:1">ዳን. 12፡1</ref>፤ <ref loc="REV 7:14">ለም. 7፡14</ref>። </char></note> <verse eid="MRK 13:19"/><verse number="20" style="v" sid="MRK 13:20"/>ጮይስ ከትከ ሰጨንከስም ጨቻክናና Ꮊየነረ አቃይ ዶቆ፥ ኬዛር ማቸ እድምስባብ ኤድንከስካንታ ጋይድንካ ኬና ሰጨንከስ ጬደኬ”።<verse eid="MRK 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21"/>ኮታይካ Ꮊየነረ ማቸ ክርስቶስ ኮንሴ ኖ ካሬ! አነረ ኖ ኦኮታሬ! የም ጋይዴ Ꮊይ አሜነቴ። <verse eid="MRK 13:21"/><verse number="22" style="v" sid="MRK 13:22"/>ካርካ ክርስቶስንከሰከ ሳብዘንካ ኤሰራክዶቆ ኬዝድባብ ካርከንባብከስ Ꮊደኬ፥ ከታ ከትካንታ ማደስናና እድምስባብከስም ዎራ ኮተርስካንታ አተንምከ በርእስዝድን ርንከስም ይደኬ። <verse eid="MRK 13:22"/><verse number="23" style="v" sid="MRK 13:23"/>ኬዛር ማቼ ሙዳ ርን እርምስቶ የካንታ ከዝትቴ ይና ካርስምከቴ!<verse eid="MRK 13:23"/></para>
  <para style="s1">ኤድይንችታ Ꮊድንታ</para>
  <para style="r">(<ref loc="MAT 24:29-31">ማቶ. 24፡29-31</ref>፤ <ref loc="LUK 21:25-28">ሉቃ. 21፡25-28</ref>)<note caller="-" style="x"><char style="xo" closed="false">13፡23 </char><char style="xt" closed="false"><ref loc="ISA 13:10">ኢሳ. 13፡10</ref>፤ <ref loc="EZK 32:7">ሕዝ. 32፡7</ref>፤ <ref loc="JOL 2:10">ኢዩ. 2፡10</ref>፥<ref loc="JOL 2:31">31</ref>፤ <ref loc="JOL 3:15">3፡15</ref>፤ <ref loc="REV 6:12">ለም. 6፡12</ref>። </char></note></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24"/>“ኮታይካ፥ ኮት ሙዳ ማጠንታ ቡር፥ Ꮊይና ኡምተሬ፥ አርፈነረ ይንታ ሳክመንም ሳክስተራክዬ።<verse eid="MRK 13:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 13:25"/>“ቤዝንከሰረ ጭለዘንካ ዋችተረኬ፥ ጭላር ዶቅድን ዎልቀንከሰረ ጭጭተረኬ።<note caller="-" style="x"><char style="xo" closed="false">13፡25 </char><char style="xt" closed="false"><ref loc="ISA 34:4">ኢሳ. 34፡4</ref>፤ <ref loc="JOL 2:10">ኢዩ. 2፡10</ref>፤ <ref loc="REV 6:13">ለም. 6፡13</ref>። </char></note> <verse eid="MRK 13:25"/><verse number="26" style="v" sid="MRK 13:26"/>ኮተረ ቡር ኤድ ይንች አንድር ዎልቀከ ቦንቸካ ኡፔካ ክት Ꮊድንካ ሰተረኬ፥<note caller="-" style="x"><char style="xo" closed="false">13፡26 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳን. 7፡13</ref>፤ <ref loc="REV 1:7">ለም. 1፡7</ref>። </char></note> <verse eid="MRK 13:26"/><verse number="27" style="v" sid="MRK 13:27"/>ይንታ ክታይንችንመረ ኦይዴ፥ ከታ ኦይድ ፍነካ አይሰኮ ፍጨታ ካንተዘንካ ጭለታ ካንታ የለልታ Ꮊፈርድባብ ሳብካ እድምስባብ ኤድንከስም ሳንዝደኬ”።<verse eid="MRK 13:27"/></para>
  <para style="s1">Ꮊቃ በለስንታ ካምስ</para>
  <para style="r">(<ref loc="MAT 24:32-35">ማቶ. 24፡32-35</ref>፤ <ref loc="LUK 21:29-33">ሉቃ. 21፡29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28"/>“Ꮊቃ በለስንታ ካምስንከስታ ኤስስና የም አርዳ፥ እክመና ኮታ ፉርድንከ ቃምነረ ጮልድንካ ኮታይካ Ꮊስን የልሳንደትም ኤዝደቴ። <verse eid="MRK 13:28"/><verse number="29" style="v" sid="MRK 13:29"/>ኮግንደረ የታ ኬና ሙዳ ማድንካ ሰደቶ ኤድ ይንች Ꮊድን ሰጨና ፍልተዘን የልሳንደትም ኤስከቴ፥ <verse eid="MRK 13:29"/><verse number="30" style="v" sid="MRK 13:30"/>ዶፈን የም ጋይድቴ፥ ኮና አጥርና ስገተርንደታ እር ኮና ሙዳ ቦድምዴ። <verse eid="MRK 13:30"/><verse number="31" style="v" sid="MRK 13:31"/>ጭለኬ ፍጨካ ስገደኬ፥ እስታ ቃለና ማቼ ስጋዬ” ጋይሴ።<verse eid="MRK 13:31"/></para>
  <para style="s1">የሱስ Ꮊድን ሰጨን Ꮊየነረ ኤሳዬ</para>
  <para style="r">(<ref loc="MAT 24:36-44">ማቶ. 24፡36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32"/>“ኬዛር ማቼ ኮትኮ ሰጨንተኬ ኮትኮ ሳዓትንታ ሳብ ባቤንዘንካ አብ Ꮊሀየነረ ኤዝድባብ ካዬ፥ አብ ነግሶ ጭላር ክታይንችነረ ማታ፥ ይንችነረ ኤሳዬ።<note caller="-" style="x"><char style="xo" closed="false">13፡32 </char><char style="xt" closed="false"><ref loc="MAT 24:36">ማቶ. 24፡36</ref>። </char></note> <verse eid="MRK 13:32"/><verse number="33" style="v" sid="MRK 13:33"/>ሰጨና Ꮊንታ ማዳናንከረ የታ ኤሳይን ካንታ ካርስምክቴ፥ ዳእከቴ። <verse eid="MRK 13:33"/><verse number="34" style="v" sid="MRK 13:34"/>ኮነረ፥ ይንታ ኤሄንም ዛቅሶ ጎት ፍጫር አይስባብ ኤችንም ካምዴ፥ ኖየረ ዋልቃ ዋልቃ ፍክስንባብከስም Ꮊክ Ꮊክ ፍክስንዘን የችሴ፥ ካርሰንባበረ ዳቅሶ ክት ካርዝድንግንዳ ክትም ክትሴ።<note caller="-" style="x"><char style="xo" closed="false">13፡34 </char><char style="xt" closed="false"><ref loc="LUK 12:36-38">ሉቃ. 12፡36-38</ref>። </char></note><verse eid="MRK 13:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 13:35"/>“ኮካንታ ኤሄንባብ ክት Ꮊድንደት ሰጨን የ ኤዝዳክንካንታ ካርስምከቴ፥ Ꮊረንግርከረ ሶይት፥ አነረ ገልትገር፥ አነረ ባቻ ቅቅድንካ፥ አነረ ዛማ ገልትናር Ꮊዳ ዶቅተሬ፥ <verse eid="MRK 13:35"/><verse number="36" style="v" sid="MRK 13:36"/>ኤችና ፉትን ጋይሶ ክት Ꮊድንካ የ ራትሶ ዶቅድንካ Ꮊብዳክንግንዳ ዛብከቴ። <verse eid="MRK 13:36"/><verse number="37" style="v" sid="MRK 13:37"/>የካንታ እ ኬዛንደትግንዳ አብንከስካንተረ ሙዳ ኬዝድቴ፥ ዛብከቴ! ጋይድቴ” ጋይሴ።<verse eid="MRK 13:37"/></para>
  <chapter eid="MRK 13"/>
  <chapter number="14" style="c" sid="MRK 14"/>
  <para style="s1">የሱሰዘን ይይምሳንዳ ዙዝም</para>
  <para style="r">(<ref loc="MAT 26:1-5">ማቶ. 26፡1-5</ref>፤ <ref loc="LUK 22:1-2">ሉቃ. 22፡1-2</ref>፤ <ref loc="JHN 11:45-53">ዮሀ. 11፡45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1"/>ፋስገኬ ባይስ ባአልን ቦንችካንታ ቃስተን ሰጫ ነገድንካ ቄሰንከስታ ገችንባብከስኬ ሙሴታ ህግንም ኤስዝድባብከሰ የሱሰም ጩበካ ይ የድንደትምከ ይ ደይዝድንደትም ጎግ ዝግድ Ꮊቀኬ።<note caller="-" style="x"><char style="xo" closed="false">14፡1 </char><char style="xt" closed="false"><ref loc="EXO 12:1-7">ዉት. 12፡1-7</ref>። </char></note><verse eid="MRK 14:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 14:2"/>ኬዛር ማቼ ዎርሰና ዋጭማ አምሳይንግንዳ “ባአል ሰጨንታር ማት ዝክሳዬ” ጋየሮ Ꮊቀኬ።<verse eid="MRK 14:2"/></para>
  <para style="s1">የሱሰም ዎዝድንደትም ሳይሳን ኤተን</para>
  <para style="r">(<ref loc="MAT 26:6-13">ማቶ. 26፡6-13</ref>፤ <ref loc="JHN 12:1-8">ዮሀ. 12፡1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3"/>የሱስ ብታንያ ሞረናር እጳ ሰቅምንክንባብ ስምኦነታ ኤር Ꮊቄ። እችምዘን ክት ዶቅድንካ፥ ዋልቃ ኤተን አንድር ስንጋ ማቻንደትከ ጭልሰርሳን ናርዶስ ጋይምድን Ꮊቀንዘንካ ፍክስምሳንዳ ዎዝድንደትም አልባስጥሮስ ብልቃትንካ የት Ꮊዴ፥ ብልቃትንም ድክስሶ ዎዝድንደትም የሱሰታ ማተንዘን ና ዉልእሴ።<note caller="-" style="x"><char style="xo" closed="false">14፡3 </char><char style="xt" closed="false"><ref loc="LUK 7:37-38">ሉቃ. 7፡37-38</ref>። </char></note> <verse eid="MRK 14:3"/><verse number="4" style="v" sid="MRK 14:4"/>ኮታር Ꮊቅባብከሳርንካ ዋልቃ ዋልቀንከስ ኮታ ይተንካ ዋጭሰኮ፥ “ኮ ዎዝድንደትም ዉችኩን ባችና Ꮊረተረ? <verse eid="MRK 14:4"/><verse number="5" style="v" sid="MRK 14:5"/>ኮና ዎዝድንደና ማከን ጸታ ጣገራ ብርርዘንካ ስግ ሰንምሶ ብረና ሪካየንባብከስ ካንታ እምምሳ ናና ኡርማ ዶቆ!” ክክ ጋይሰኬ፥ ኤተንንመረ ቦሰኬ።<verse eid="MRK 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6"/>የሱስ ማቼ፥ “ኮትም ዛእከቴ! Ꮊረተንት ኮትም ዘርዝዳ? ና እካንታ ኡርማ ር ይቴ። <verse eid="MRK 14:6"/><verse number="7" style="v" sid="MRK 14:7"/>ሪካየንባብከስ ሙዳᎺይካ የንካ ክክን ከት ማቻንካንታ የ ዝግዛንᎺይካ ኡርመን ከትካንታ ይካንታ ማደቴ፥ እታ ማቼ ሙዳᎺይካ የንካ ክክን ዶቃይቴ፥<note caller="-" style="x"><char style="xo" closed="false">14፡7 </char><char style="xt" closed="false"><ref loc="DEU 15:11">ካሪ. 15፡11</ref>። </char></note> <verse eid="MRK 14:7"/><verse number="8" style="v" sid="MRK 14:8"/>ኮና ኤተና ይንደር ማድንደትም ና ይቴ፥ እስታ ዋሄና ዱክምተርንደታ እርምሶ ግክስካንታ ዎዝድንደትም ና ሳይሴ። <verse eid="MRK 14:8"/><verse number="9" style="v" sid="MRK 14:9"/>ዶፈን የም ጋይድቴ፥ ኮ ፍጫሙደንዘን ኮና ክላ ኬዘና ሳባክምድን Ꮊምንካርዘነረ፥ ኮና ኮት ይሳንደና ገቀርዝድንዳ ማተሮ ኮትጎካ ኬዝምዴ” ከደር ኩንጋይሴ።<verse eid="MRK 14:9"/></para>
  <para style="s1">ይሁዳ የሱሰም ስክስት እምካንታ ኤእና</para>
  <para style="r">(<ref loc="MAT 26:14-16">ማቶ. 26፡14-16</ref>፤ <ref loc="LUK 22:3-6">ሉቃ. 22፡3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10"/>ታመኬ ቃስተንናርንካ ዋልቀና አስቆሮንት ፍጨናርንክንባብ ይሁዳ የሱሰም ስክስት እምካንታ ቀሰንከስም ገችዝድባብከዝደር አይሴ። <verse eid="MRK 14:10"/><verse number="11" style="v" sid="MRK 14:11"/>ከተረ ኮም ኤሰርሳንደትካ ከትም ጉርምሴ፥ ብረረ ክትም እማካንታ ኤእሰኬ። ኖየረ የሱሰም ስክስት እማካንተረ ኡርድን ሰጨም ካርሰሮ Ꮊቄ።<verse eid="MRK 14:11"/></para>
  <para style="s1">ፋስገንታ ሶይት እችምና</para>
  <para style="r">(<ref loc="MAT 26:17-25">ማቶ. 26፡17-25</ref>፤ <ref loc="LUK 22:7-14">ሉቃ. 22፡7-14</ref>፥<ref loc="LUK 22:21-23">21-23</ref>፤ <ref loc="JHN 13:21-30">ዮሀ. 13፡21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12"/>ፋስገንታ ቆለን ከት ማጅድንዳ ባይስ ባልንታ እር ሰጨንካ፥ ክታካርንካ ጎርስምድባብከስ የሱሰደር Ꮊድሰኮ፥ “ፋስገንታ ሶይት እችምን እችካንታ Ꮊብር ዎ ግግዝድንግንደስ ዝግዳ?” ጋየረኮ ክትም ኦይሰኬ።<verse eid="MRK 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13"/>የሱሰረ ይንታ ካርንካ ጎርስምድባብከሳርንካ ቃስተንን ኩንጋይሶ ከትም ኦይቼ፥ “ካተመናር አይከቴ፥ ኮታረረ ዳሀካ ሎቃ ባልስባብ ኤችም Ꮊብደቴ፥ ክትም ጎርስምከቴ፥ <verse eid="MRK 14:13"/><verse number="14" style="v" sid="MRK 14:14"/>ክት አርድን ኤሄናረረ አይሰቶ ኤሄን ባብም፥ ‘ኤስስንባብ፥ እስታ ካርንካ ጎርስምድባብከስካ ክክን ፋስገንታ ሶይት እችምን እ እጅድንደታ እካንታ ማድንዳ ሶችታ Ꮊዉስንታ ኤሄና Ꮊምነረ?’ ጋይዴ ክደር ጋይከቴ። <verse eid="MRK 14:14"/><verse number="15" style="v" sid="MRK 14:15"/>ኖየረ ኤሄታዘን ዎደርሳን ኤሀ ዶቅድንደትም ግክሰርሳንደትኬ ታከረርሳንደትም ሳክማ ኤሀ የም ሰችተረ፥ ዋር ዎካንታ ግግስከቴ” ጋይሴ።<verse eid="MRK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16"/>ቃስተና ክታ ካርንካ ጎርስምድባብከስ ኮታርንካ ዉትሰኮ ካተማናር አይሰኬ፥ ገታ የሱስ ከትም ጋይሳንግንደረ Ꮊፍሰኬ፥ ፋስገንተረ ሶይት እችምን ኮታር ግክሰኬ።<verse eid="MRK 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17"/>ፍጨና ሶይችንካ የሱስ ታመኬ ቃስተንንከስካ ክክን Ꮊዴ። <verse eid="MRK 14:17"/><verse number="18" style="v" sid="MRK 14:18"/>እችምዘን ከትዶቅድንካ የሱስ፥ “ዶፈን የም ጋይድቴ፥ የንታ ዎክያርንካ ዋልቀና እም ስክስት እምተሬ፥ ኖየረ ታ እንካ ክክን ሶይት እችምንዘን ዶቅዴ” ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">14፡18 </char><char style="xt" closed="false"><ref loc="PSA 41:9">የቺ 41፡9</ref>። </char></note><verse eid="MRK 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19"/>ከተረ ኮ ኬዘንካ ሞርእሰኮ “እታ ማትትዳቶ?” ጋየረኮ ዋልቃ ዋልቃ ክትም ኦይሰኬ።<verse eid="MRK 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20"/>የሱሰረ፥ “ኖኮና ኤችና የ ታመከ ቃስተንናርንካ ዋልቀና እንካ የካ አንንም ጋበትናር ኦይድባቤ። <verse eid="MRK 14:20"/><verse number="21" style="v" sid="MRK 14:21"/>ኤድ ይንች እምሶ ክትጎካ ጻፈርሳንደት ደእና ክታ ነጋዬ፥ ኬዛር ማቼ ኤድ ይንችም ስክስት እምድባብ ክትኮ ኤችንካንታ የኤ! ኖኮና ኤችና አጠማከስ ናና ኡርማ ዶቆ!” ኩን ከትም ጋይሴ።<verse eid="MRK 14:21"/></para>
  <para style="s1">የሱሰታ ደእንም ገቀርዝድን እችም</para>
  <para style="r">(<ref loc="MAT 26:26-30">ማቶ. 26፡26-30</ref>፤ <ref loc="LUK 22:14-20">ሉቃ. 22፡14-20</ref>፤ <ref loc="1CO 11:23-25">1 ቆሮ. 11፡23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22"/>ከታ እችምዘን ዶቅድንካ ሶለንም አምስትዮ አንጄ፥ አስተረ ይንታ ካርንካ ጎርስምድባብከስካንታ እምድዮ “ይኤቴ፥ ኮና እስታ ዋሄኔ” ጋይሶ ከትካንታ እምሴ።<verse eid="MRK 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23"/>ኡፍተንም አምስሶ ጋለትሶ ከትካንታ እምሴ፥ ሙደነረ ኡፍተናርንካ ዎጨኬ። <verse eid="MRK 14:23"/><verse number="24" style="v" sid="MRK 14:24"/>የሱሰረ፥ “ኮና በድንከስካንታ ውልምድንዳ እስታ ጫቃ ማቀሴ፥<note caller="-" style="x"><char style="xo" closed="false">14፡24 </char><char style="xt" closed="false"><ref loc="EXO 24:8">ዉት. 24፡8</ref>፤ <ref loc="JER 31:31-34">ኤር. 31፡31-34</ref>። </char></note> <verse eid="MRK 14:24"/><verse number="25" style="v" sid="MRK 14:25"/>ዶፈን የም ጋይድቴ፥ ሳብ ባንችምናር ክላ ዎይን ዎጭምን እ ዎጭተርን የለልታ ኮ ዎይንንታ ዎጭምን ቦድሶ ዎጫይቴ” ኩን ከደር ጋይሴ።<verse eid="MRK 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26"/>ኮታዘንከረ የችንም የችሰኮ ደብረዘይት ገቸንዘን ዉተደኬ።<note caller="+" style="f"><char style="fr" closed="false">14፡26 </char><char style="ft" closed="false">ደብረዘይት ጋይንት ዛይታ Ꮊቃ ዎይራ ባቀልድን ገቸንታ ላምዬ። </char></note><verse eid="MRK 14:26"/></para>
  <para style="s1">ጴጥሮስ ካተርንደትም የሱስ እርምሶ ኬዘና</para>
  <para style="r">(<ref loc="MAT 26:31-35">ማቶ. 26፡31-35</ref>፤ <ref loc="LUK 22:31-34">ሉቃ. 22፡31-34</ref>፤ <ref loc="JHN 13:36-38">ዮሀ. 13፡36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27"/>የሱስ ይንታካርንካ ጎርስምድባብከስካንታ፥ “ ‘ግስመንባብም ጉጵድቴ፥ ቆልንከሰረ ይጭምደኬ’ ጋይምሶ ጻፍምሳንግንዳ የታ ሙደነረ፥ እንካ ኮተርተረቴ፥<note caller="-" style="x"><char style="xo" closed="false">14፡27 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">ዘካ. 13፡7</ref>። </char></note><verse eid="MRK 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 14:28"/>“ኬዛር ማቼ ደእያርንካ እ አምሳንደታ ቡር የም እርምስቶ ገሊላ ካተመናር አይድቴ” ኩን ከደር ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">14፡28 </char><char style="xt" closed="false"><ref loc="MAT 28:16">ማቶ. 28፡16</ref>። </char></note><verse eid="MRK 14:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="MRK 14:29"/>ኮታይካ ጴጥሮስ “አብንከስ ሙዳ ዎራ የስካ ከት ኮተርዴ፥ እታ ቦድሶ የስካ ኮትራይቴ!” ጋይሴ።<verse eid="MRK 14:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="MRK 14:30"/>የሱሰረ “ዶፈን የስም ጋይድቴ፥ ኮ ሶይትናር ባቻ ቃስተን ዱት ቅቅተርንደታ እር ማከን ዱት እም ካተራዬ” ክትም ጋይሴ።<verse eid="MRK 14:30"/></para>
  <para style="q2">
    <verse number="31" style="v" sid="MRK 14:31"/>ጴጥሮስ ማቼ “ደእ ዎራ ዝክሴ የስካ ክክን ደእድት ዳት ቦድሶ የስም ካዳይቴ!” ጋየሮ ዳቅስሶ ኬዜ። ነገድባብከሰረ የሱሰታ ካርንካ ጎርስምድባብከስ ኮትግንዳ ጋይድ Ꮊቀኬ።<verse eid="MRK 14:31"/></para>
  <para style="s1">የሱስ ገታ ሰማን ጋየርድን ካርዘን ምክስና</para>
  <para style="r">(<ref loc="MAT 26:36-46">ማቶ. 26፡36-46</ref>፤ <ref loc="LUK 22:39-46">ሉቃ. 22፡39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32"/>ኮተረ ቡር ገተሰማን ጋየርድን ካርንዘን አይሰኬ፥ የሱስ ይንታ ካርንካ ጎርስምድባብከስም፥ “እ ኦኮታር ምግዝድንካ የታ ኮዘን ዶእከቴ” ከትም ጋይሴ። <verse eid="MRK 14:32"/><verse number="33" style="v" sid="MRK 14:33"/>ጴጥሮስምከ ያይቆብም ዮሀንሰመረ ጎርስሶ አይሴ፥ ኮታረረ አንድር ሞርኤሮ ማጥር የጄ። <verse eid="MRK 14:33"/><verse number="34" style="v" sid="MRK 14:34"/>ኮታዘንከረ “እስታ ሰንፐና ደእ የለልታ አንድር ሞርእሴ፥ ኮዘን ዶእከቴ፥ ዳቅሶ ካርስከቴ” ከትም ጋይሴ።<verse eid="MRK 14:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35"/>ከታዘንካ መራ ጎተርሶ አይሴ፥ ፍጨዘነረ ይንታ ባለንካ ጉፕን ጋይሶ የዝደር ማድንዳ ማቼ ናኮና ሳዓትና ክታዘንካ ስገድንግንዳ ምክሴ። <verse eid="MRK 14:35"/><verse number="36" style="v" sid="MRK 14:36"/>“እስታ ባበኖ፥ ሙዳ ርና የስካንታ ማዴ፥ ኮም ማጠንታ ኡፍተን እዘንካ አምስካ፥ ኬዛር ማቸ የስታ ጋይተንግንዳዳት እስታ ጋይተንግንዳ Ꮊይማታ” ኩን ጋይሴ።<verse eid="MRK 14:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37"/>ይንታ ካርንካ ጎርስምድባብ ማከንንከዝደር ማትሶ ክት Ꮊዳንደትካ፥ ራትሶ ዶቅድንካ ከትም Ꮊፍሴ፥ ኮካንታ ጴጥሮስም፥ “ስምኦኖ፥ የና ራታ? ዋልቃ ሳዓት ዎራ ንግሶ ዶቅ የስም ጋምሶ?” ክትም ጋይሴ። <verse eid="MRK 14:37"/><verse number="38" style="v" sid="MRK 14:38"/>ይና የ “ጰጫር አርተራክንግንዳ ዳቅሶ ምክስከቴ፥ አያንና ግግምቴ፥<note caller="+" style="f"><char style="fr" closed="false">14፡38 </char><char style="ft" closed="false">ኮዘን አይን ጋይምሳንዳ ኤታ ዋር ዶቅድን አያን ዳት ጭል አያንይ ካዬ። </char></note> ዋሄና ማቸ ጋፍሳንዴ” ከትም ጋይሴ።<verse eid="MRK 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39"/>ካርንከረ አይሶ እር ይ ምክሳንደትም ካርንካ ምክሴ። <verse eid="MRK 14:39"/><verse number="40" style="v" sid="MRK 14:40"/>ጉጅሰረ ማት ክት Ꮊድንካ፥ አፍና ከታ ግንእካ ደጭንካ ራትሶ ከትዶቅድንካ Ꮊፍሴ፥ ክትካንታ ከታ ይ ማዝድንደትም ኤሳይ Ꮊቀኬ።<verse eid="MRK 14:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41"/>ማክምስ ዱት ከደር Ꮊድሶ፥ “ታየረ ራትሰንት ዶቅዶ? ታየረ ኡክንተረቴ? ይና ማተረ! ሳዓትና የልቴ! ኮሰቸቴ! ኤድ ይንች ጎመንባብከስታ አንያር ስክስምት እምምተሬ። <verse eid="MRK 14:41"/><verse number="42" style="v" sid="MRK 14:42"/>ይና አምከቴ! ሙከቴ! ስክስትን እም እምድባብ Ꮊቴ!” ኩን ከትም ጋይሴ።<verse eid="MRK 14:42"/></para>
  <para style="s1">የሱሰታ የድርና</para>
  <para style="r">(<ref loc="MAT 26:47-56">ማቶ. 26፡47-56</ref>፤ <ref loc="LUK 22:47-53">ሉቃ. 22፡47-53</ref>፤ <ref loc="JHN 18:3-12">ዮሀ. 18፡3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43"/>አክ የሱስ ኮም ክት ኬዘዘን ዶቅድንካ ታመከ ቃስተንከሳርንካ ዋልቀና ይሁዳ Ꮊዴ፥ ክትከረ ክክን ማሰከ ጉፈካ የጅባብ በድ ኤድንከስ Ꮊቀኬ፥ ከተረ ቀሰንከስም ገችዝድባብከሳርንካ፥ ሙሴታ ህግንም ኤስዝድባከስከ፥ ቡጫ ጋልተንከዝደርንካ ኦይትምስባበኬ። <verse eid="MRK 14:43"/><verse number="44" style="v" sid="MRK 14:44"/>ስክስት እምድባበረ ይሁዳ፥ “የታ የ የድባብ እታ አቦ ጋይስቶ እ ሶንቅድባብመ፥ ክትም ካርስምሰቶ የድሶ አይከቴ”፥ ጋይሶ ቃዉታ ከትካንታ ኖ ኬዝቴ። <verse eid="MRK 14:44"/><verse number="45" style="v" sid="MRK 14:45"/>ይሁዳ ሳነካ Ꮊድሶ የሱሰደር ቅንችሶ፥ “ኤስስንባቦ!” ጋይሶ ሶንቅሴ። <verse eid="MRK 14:45"/><verse number="46" style="v" sid="MRK 14:46"/>ኮታ ቡር ኤድንከስ የሱሰም የጀኬ። <verse eid="MRK 14:46"/><verse number="47" style="v" sid="MRK 14:47"/>ኮታር ዎእሶ Ꮊቅባብከሳርንካ ዋልቀና ማሰንም ጎችትዮ ቀሰንከስም ገችዝድባብታ ፍክስንባብታ ቃምንም ተቼ። <verse eid="MRK 14:47"/><verse number="48" style="v" sid="MRK 14:48"/>የሱሰረ፥ “ማሰከ ጉፈከ የድሰቶ የ Ꮊዳንዳ እም ፋንገንከስግንዳ የድካንቶ? <verse eid="MRK 14:48"/><verse number="49" style="v" sid="MRK 14:49"/>ሰጭንካ ሰጭንካ ሳብታ ጭል ኤሄናር እ ኤስሰርቶ የንካ ክክን እ ዶቅድንካ እም የዳከቴ፥ ኬዛር ማቼ ኮና ማቻንዳ ጭል ማጻፍንከስታ ቃለና ቦድምድንግንዴ” ኩን ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">14፡49 </char><char style="xt" closed="false"><ref loc="LUK 19:47">ሉቃ. 19፡47</ref>፤ <ref loc="LUK 21:37">21፡37</ref>። </char></note> <verse eid="MRK 14:49"/><verse number="50" style="v" sid="MRK 14:50"/>ኮታዘንከረ ክታካርንካ ጎርስምድባብከሰረ ሙደና ክትም ዛቅሰኮ አጥምሰኬ። <verse eid="MRK 14:50"/><verse number="51" style="v" sid="MRK 14:51"/>አፍላ ላጠና Ꮊክ ቆበርስባብ ዋልቃ ማርንድ የሱሰም ጎርስመሮ Ꮊቄ፥ ኤድንከሰረ ክትም የጃንደትካ <verse eid="MRK 14:51"/><verse number="52" style="v" sid="MRK 14:52"/>አፍለን ላጠነን ዛቅሶ ዘና ጫለንካ Ꮊዝሶ አጥምሴ።<verse eid="MRK 14:52"/></para>
  <para style="s1">የሱስ ቡጫጋልተንከስታ እር ተይ አይምና</para>
  <para style="r">(<ref loc="MAT 26:57-68">ማቶ. 26፡57-68</ref>፤ <ref loc="LUK 22:54-55">ሉቃ. 22፡54-55</ref>፥<ref loc="LUK 22:63-71">63-71</ref>፤ <ref loc="JHN 18:13-14">ዮሀ. 18፡13-14</ref>፥<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53"/>የሱሰም ማቼ ቀሰንከስም ገችዝድባብደር ተይ አይሰኬ፥ ኮታረረ ቀሰንከስም ገችዝድባብከስ፥ ጋልተንከስከ ሙሴታ ህግንም ኤስዝድባብ ከስ ሙደና ሳንምሰኬ። <verse eid="MRK 14:53"/><verse number="54" style="v" sid="MRK 14:54"/>ጴጥሮሰረ ቀሰንከስም ገችዝድባብታ ጋስናር የለልታ የሱሰም ጎትካ ጎርስምድ Ꮊቄ። ኮታረረ አብንከስካ ክክን ዶቅሶ ኖሀ ኦይጠርድ Ꮊቄ። <verse eid="MRK 14:54"/><verse number="55" style="v" sid="MRK 14:55"/>ቀሰንከስም ገችዝድባብከስኬ ቡጫ ጋልትንከስ ሙደና የሱሰም ደይስስካንታ ማርካ ዝግድ Ꮊቀኬ፥ ማችንከረ Ꮊፋከኬ። <verse eid="MRK 14:55"/><verse number="56" style="v" sid="MRK 14:56"/>በድንከሰረ ካርከካ ክታዘን ማርከርሰኬ፥ ማችንከረ ከታ ማርከርና ዋልቃ ማታክዬ።<verse eid="MRK 14:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57"/>ዋልቃ ዋልቀንከሰረ አምሰኮ ኩን ጋየረኮ ካርከካ ክታዘን ማርከርሰኬ፥ <verse eid="MRK 14:57"/><verse number="58" style="v" sid="MRK 14:58"/>“እታ ኮም ኤታ አንካ ዎድምሳንደትም ሳብታ ጭል ኤሄንም ዉልእስቶ ማከን ሰጫር አብ ኤታ አንካ ዎድማክንደትም ዎድቴ ጋይሶ ክት ኬዝድንካ ዎታ ኤሰርቶቴ።” <note caller="-" style="x"><char style="xo" closed="false">14፡58 </char><char style="xt" closed="false"><ref loc="JHN 2:19">ዮሀ. 2፡19</ref>። </char></note> <verse eid="MRK 14:58"/><verse number="59" style="v" sid="MRK 14:59"/>ኩን ከት ጋይስንከረ ከታ ማርክርና ዋልቃ ማታክዬ። <verse eid="MRK 14:59"/><verse number="60" style="v" sid="MRK 14:60"/>ቀሰንከስታ ገችንባበረ ከታ ዎክያር ዎእሶ፥ “ዋልቃ ሪየረ ማሳያ? ከናኤድንከስ የስታዘን ከት ማርከርድንዳ Ꮊራ?” ጋየሮ የሱሰም ኦይሴ።<verse eid="MRK 14:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="MRK 14:61"/>የሱስ ማቼ ጫምን ጋይሳ ዳት Ꮊረነረ ከደር ማሳክዬ። ቀሰንከስም ገችዝድባበረ “አንጅምስባብ ሳብታ ይንች ሳይምስባብና የኖ?” ጋየሮ አናካርንካ ኦይሴ።<verse eid="MRK 14:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62"/>የሱሰረ “ይዬ፥ እትቴ፥ ኤድ ይንች ሳብታ ምዝዘን ዶቅስንካ ሰተረቴ! ኮትኮግንደረ ጭለዘን ኡፔካ ማት Ꮊድንካ የታ ሰተረቴ” ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">14፡62 </char><char style="xt" closed="false"><ref loc="DAN 7:13">ዳን. 7፡13</ref>። </char></note> <verse eid="MRK 14:62"/><verse number="63" style="v" sid="MRK 14:63"/>ቀሰንከስታ ገችንባበረ ዋጭካ ይንታ አፍለን Ꮊእስሶ “አብ ማርካ Ꮊራ ዝግዝዳ? <verse eid="MRK 14:63"/><verse number="64" style="v" sid="MRK 14:64"/>ኮሰቸቴ! ኮም ሳብዘን ዎራ ክት የግድንካ ኤሰርተቴ፥ ይና የም Ꮊሮክ ካሜ?” ጋይሴ። ሙደነረ ዋልቃ ኡፍስካ፥ “ደእ ክትም ዝግዝዴ!” ጋይሰኮ ክታዘን ፋረጀኬ።<verse eid="MRK 14:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65"/>ዋልቃ ዋልቀንከሰረ ከታ ይንታ ፈጭምን ክታዘን ፈጭምተሮቴ ጋይ የጀኬ፥ ክታ አፍንመረ አፍለካ ዞክሰኮ “የና ሳብዘንካ ኤሰርሶ ኬዝድባብ የስ ማቼ ይና የስም Ꮊይ ጉጵሳናንከረ ኤስካ!” ጋየረኮ ክትም ቱንከሮ Ꮊቀኬ። አብንከሰረ ክትም ጫቀረኮ ተይ አይሰኬ።<verse eid="MRK 14:65"/></para>
  <para style="s1">ጴጥሮስ የሱሰም ካድና</para>
  <para style="r">(<ref loc="MAT 26:69-75">ማቶ. 26፡69-75</ref>፤ <ref loc="LUK 22:56-62">ሉቃ. 22፡56-62</ref>፤ <ref loc="JHN 18:15-25">ዮሀ. 18፡15—18፡25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66"/>ጴጥሮስ ቀሰንከስታ ገችንባብታ ኤሄንታ ታመርጎካ ጋስንታ ዋር ክት ዶቅድንካ ቀሰንከስታ ገችንባብታ ፍክስንባብከሳርንካ ዋልቀንዳ Ꮊዴ፥ <verse eid="MRK 14:66"/><verse number="67" style="v" sid="MRK 14:67"/>ናየረ ጴጥሮስ ኖሀ ኦይጠርድንካ ፍስሳ ክትም ሰድስንደትከ “የነረ ናዝረታርንባብ የሱሰካ ክክን Ꮊቀዬ”፥ ና ጋይሴ።<verse eid="MRK 14:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68"/>ጴጥሮስ ማቼ “እታ ኤሳይቴ፥ የስ ጋይድንዳ እም አርዳዬ”፥ ጋየሮ ካጄ። ኮመረ ጋይሶ ማል ክት ዉተዳንግንዳ ባቻ ቅቅሴ።<verse eid="MRK 14:68"/></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69"/>ና ፍክስንንደረ ጴጥሮስም ሰድሶ፥ ዋር ዎእስባብከስካንታ “ኖ ኮነረ ከታ ኮችናርንከ!” ጋየሮ አነታ ና ኬዛ የጄ፥ <verse eid="MRK 14:69"/><verse number="70" style="v" sid="MRK 14:70"/>ኖ ማቼ አናካርንካ ካጄ። Ꮊዉእሳ ክት ዶቅሳንደታ ቡር ኮታር ዎእስባብ ኤድንከስ ጴጥሮስም፥ “ገሊላ ኤድ የስታ ማትንተና ገታ የስታ ኬዘንካ ኤስምደዬ፥ ኮካንታ ዶፈን የነረ ከታ ኮችናርንከዬ” ጋይሰኬ።<verse eid="MRK 14:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71"/>ኖ ማቼ “ኮም የ ጋይድባብ ኤችንም ኤሳይቴ!” ጋየሮ ይንታ ማተን ባደሮ ጫቃ የጄ።<verse eid="MRK 14:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72"/>ሳነካ ባቸና ቃስትምስ ዱት ቅቅሴ፥ ጴጥሮሰረ “ባቻ ቃስተን ዱት ቅቃክናና ማከን ዱት እም ካተራዬ” ጋይሳንዳ የሱሰታ ቃለና ክትም ከልቅን ጋይሴ፥ ኮታዘንክሬ ቡዳርንካ ኤፍሴ።<verse eid="MRK 14:72"/></para>
  <chapter eid="MRK 14"/>
  <chapter number="15" style="c" sid="MRK 15"/>
  <para style="s1">የሱስ ጵላጦሰታ እሪ</para>
  <para style="r">(<ref loc="MAT 27:1-2">ማቶ. 27፡1-2</ref>፥<ref loc="MAT 27:11-14">11-14</ref>፤ <ref loc="LUK 23:1-5">ሉቃ. 23፡1-5</ref>፤ <ref loc="JHN 18:28-38">ዮሀ. 18፡28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1"/>ዛማ ሰጭማ ቀሰንከስታ ገችንባብከስ ጋልተንከሳርንካ፥ ሙሴታ ህግንም ኤስዝድባብከሳርንካ፥ ቡጫ ጋልተንከስካ ሙዳ ክክን ዙዝምሰኬ፥ ኮተረ ቡር የሱሰም የችስት ጵላጦስካንታ ስክስት እምሰኬ። <verse eid="MRK 15:1"/><verse number="2" style="v" sid="MRK 15:2"/>ጵላጦሰረ “አይሁድንታ ባንችና የኖ?” ጋይሶ ኦይሴ።</para>
  <para style="p" vid="MRK 15:2">የሱሰረ “የስ ጋይሳንግንዴ”፥ ጋይሴ።<verse eid="MRK 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3"/>ቀሰንከስታ ገችንባብከስ ማቼ የሱሰም በድካ ማእዝድ Ꮊቀኬ። <verse eid="MRK 15:3"/><verse number="4" style="v" sid="MRK 15:4"/>ኮካንታ ጵላጦሰረ “መም ሪካ የስም ካሰዝዳናንከረ ሰድካ! ቦድሶ ዋልቃ ሪየረ ማሳያ?” ጋየሮ አናካርንካ ክትም ኦይሴ።<verse eid="MRK 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5"/>ጵላጦስ በርእተርን የለልታ ታየረ የሱስ Ꮊረሰረ ማሳክዬ።<verse eid="MRK 15:5"/></para>
  <para style="s1">የሱሰዘን ደእታ ፍርደና</para>
  <para style="r">(<ref loc="MAT 27:15-26">ማቶ. 27፡15-26</ref>፤ <ref loc="LUK 23:13-25">ሉቃ. 23፡13-25</ref>፤ <ref loc="JHN 18:39-40">ዮሀ. 18፡39-40</ref>፤ <ref loc="JHN 19:1-16">19፡1-16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6"/>ጵላጦስ ስለዘን ስለዘን አይሁድንከስታ ፋስጋ ባአልንᎺይካ ቡልምድንግንዳ ኤድንከስ ኦይስባብም ዋልቃ ዞከርስባብም ብልድንደታ ዎጋ Ꮊቄ። <verse eid="MRK 15:6"/><verse number="7" style="v" sid="MRK 15:7"/>ኮታይካ ዳቀልስም አምስስሶ ሰንፓ ደይስሶ ዞከርስባብከሳርንካ ዋልቀና ባርባን ጋይምድባብ ኤች Ꮊቄ። <verse eid="MRK 15:7"/><verse number="8" style="v" sid="MRK 15:8"/>ዎርሰነረ ጵላጦሰደር Ꮊድሰኮ ከታ መጠንግንዳ ከትካንታ ይድንግንዳ ኦይሰኬ። <verse eid="MRK 15:8"/><verse number="9" style="v" sid="MRK 15:9"/>ጵላጦሰረ “አይሁድንታ ባንችንም ቡልት እ ኦይድንግንዳ ዝግደቴ?” ጋይሶ ከትም ኦይሴ። <verse eid="MRK 15:9"/><verse number="10" style="v" sid="MRK 15:10"/>ኮመረ ክት ጋይሳንዳ ቀሰንከስም ገችዝድባብከስ የሱሰም ስክስት ከት እምሳንዳ ቀምስካ አምሶ ማትንተን ይ ኤዝድንካንቴ።<verse eid="MRK 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11"/>ቀሰንከስም ገችዝድባብከስ ማቼ፥ “የሱስ ቡልምድንዘንካ ባርባን ዎካንታ ብልምድንግንዳ” ጋይሰኮ ጵላጦሰም ከት ኦይዝድንግንዳ ዎርሰንም አምስሰኬ። <verse eid="MRK 15:11"/><verse number="12" style="v" sid="MRK 15:12"/>ጵላጦሰረ፥ “ይና፥ ኮም አይሁድንታ ባንችን የ ጋይድባብም Ꮊስስ ይቴ?” ጋይሶ ኤድንከስም ካርንካ ኦይሴ።<verse eid="MRK 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13"/>ከተረ “ክትም ሮካ!” ጋየረኮ አነታ ፍፍሰኬ።<verse eid="MRK 15:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14"/>ጵላጦሰረ “Ꮊረታ? ክት ይሳንዳ ባችና Ꮊራ?” ከደር ጋይሴ።</para>
  <para style="q1" vid="MRK 15:14">ከታ ማቼ “ክትም ሮካ!” ጋይሰኮ እርንደትዘንካ ስክስሶ ፍፍሰኬ።<verse eid="MRK 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15"/>ጵላጦስ ዎርሰንም ጉርምስካንታ ጋይሶ ባርባንም ከትካንታ ቡልሴ፥ የሱሰም ማቼ Ꮊርችሶ ሮከርድንግንዳ ስክስት እምሴ።<verse eid="MRK 15:15"/></para>
  <para style="s1">ፖልስንከስታ የሱሰዘን Ꮊልተርና</para>
  <para style="r">(<ref loc="MAT 27:27-31">ማቶ. 27፡27-31</ref>፤ <ref loc="JHN 19:2-3">ዮሀ. 19፡2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16"/>ፖልስንከስ የሱሰም ፍጨን ገችዝድባብታ ፕራይቶርዮን ጋይምድባብ ባንችንታ ኤር ጋስናር ተይ አይሰኬ፥ ነግድባብ ፕሆልስንከስመረ ሙዳ ኤልሰኬ፥ <verse eid="MRK 15:16"/><verse number="17" style="v" sid="MRK 15:17"/>ዘይም አፍለረ ክትም ቆፍሰኬ፥ ጋልታ ዛዉዳ ላጭሶ ክታ ማተንዘን ጉፍሰኬ። <verse eid="MRK 15:17"/><verse number="18" style="v" sid="MRK 15:18"/>ኮታዘንከረ “አይሁድንታ ባንችኖ! ዎዜ ካዉታ ማታ!” ጋየረኮ Ꮊልተርካ ጎይንድ Ꮊቀኬ። <verse eid="MRK 15:18"/><verse number="19" style="v" sid="MRK 15:19"/>ጉፈካ ክታ ማተንም ጉጵሰኬ፥ ይንታ ፈጭምነረ ክታዘን ፈጭምሰኬ፥ ክታ እረረ Ꮊልተርካ ጉምፈረረኮ ክትካንታ ጎዝድ Ꮊቀኬ። <verse eid="MRK 15:19"/><verse number="20" style="v" sid="MRK 15:20"/>ከታ ይ Ꮊልተርሳንደታ ቡር ዘይም አፍለንም ክታዘንካ ዉችሰኮ፥ ክታ አፍለንም ቆፍሰኬ፥ ክትም ሮክካንታ ተይ አይሰኬ።<verse eid="MRK 15:20"/></para>
  <para style="s1">የሱሰታ ሮክርና</para>
  <para style="r">(<ref loc="MAT 27:32-44">ማቶ. 27፡32-44</ref>፤ <ref loc="LUK 23:26-43">ሉቃ. 23፡26-43</ref>፤ <ref loc="JHN 19:17-27">ዮሀ. 19፡17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21"/>ከት አያዶቅድንካ ቀረና ፍጫ ኤች ማችባብ አላክሳንደርተከ ሩፎስታ ባበና ስምኦን ካተማ ካየናርንካ ክት Ꮊድንካ Ꮊፍሰኬ፥ የሱሰታ ማዝቀልንም ክት ባልድንግንዳ ጋይሰኬ።<note caller="-" style="x"><char style="xo" closed="false">15፡21 </char><char style="xt" closed="false"><ref loc="ROM 16:13">ሮማ 16፡13</ref>። </char></note> <verse eid="MRK 15:21"/><verse number="22" style="v" sid="MRK 15:22"/>ኮተረ ቡር የሱሰም ኮታ ቡልና ራስቅል ጋይምሳን ጎልጎታ ካርያር ተይ አይሰኬ። <verse eid="MRK 15:22"/><verse number="23" style="v" sid="MRK 15:23"/>ኮታረረ ከርበ ጋይምድንደትካ ቡቅምሳንዳ ዎይንንታ ዎጭምንም እምሰኬ፥ የሱስ ማቼ ዋይት ጋይሴ። <verse eid="MRK 15:23"/><verse number="24" style="v" sid="MRK 15:24"/>ኮተረ ቡር ክትም ሮክሰኬ፥ የሱስታ አፍለንመረ Ꮊይ ተይተር ናንከረ እጫ ዛቅሰኮ አፍለንም ካስምሰኬ።<note caller="-" style="x"><char style="xo" closed="false">15፡24 </char><char style="xt" closed="false"><ref loc="PSA 22:18">የቺ 22፡18</ref>። </char></note> <verse eid="MRK 15:24"/><verse number="25" style="v" sid="MRK 15:25"/>የሱሰም ከት ሮግድንካ ሳዓትና ዛማ ማከን ሳዓት Ꮊቄ። <verse eid="MRK 15:25"/><verse number="26" style="v" sid="MRK 15:26"/>ካሰስንታ ጻፈርሳንደረ “አይሁድንታ ባንችን” ጋይድንዳ ጻፍምታ Ꮊቄ። <verse eid="MRK 15:26"/><verse number="27" style="v" sid="MRK 15:27"/>የሱሰካ ክክን ቃስተን ፋንገንከስም ተይᎺድሰኮ ዋልቀንም ክታ ምዝዘን ዋልቀንመረ ክታ ብተዘን ሮክሰኬ። <verse eid="MRK 15:27"/><verse number="28" style="v" sid="MRK 15:28"/>ኮግንደከረ “ባችንባብከስካ ክክን ፋይድምሴ” ጋይድንዳ ማጻፍናር ጻፍምሳንዳ ቃለና ቦድምሴ።<verse eid="MRK 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29"/>ኮት ጎግንካ ክታ ላመከረ ስገሮ Ꮊቃን ኤድንከሰረ ክትም ቶቸካ ከታ ይንታ ቃደንም ረክሰረኮ ኩን ጋየረኮ የግድ Ꮊቀኬ፥ “ኤቦ፥ የና ሳብታ ጭል ኤሄንም ዉልእሰዮ ማከን ሰጨካ ዎድቴ ጋይድባብና!<note caller="-" style="x"><char style="xo" closed="false">15፡29 </char><char style="xt" closed="false"><ref loc="PSA 22:7">የቺ 22፡7</ref>፤ <ref loc="PSA 109:25">109፡25</ref>፤ <ref loc="MRK 14:58">ማር. 14፡58</ref>፤ <ref loc="JHN 2:19">ዮሀ. 2፡19</ref>። </char></note> <verse eid="MRK 15:29"/><verse number="30" style="v" sid="MRK 15:30"/>ይና ታ ማዝቀልንዘንካ Ꮊንቸርሰዮ የስታ ማተንም የስ አቅስኔ!” ጋይሰኬ።<verse eid="MRK 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31"/>ኮግንደካ ቀሰንከስም ገችዝድባብከስኬ ሙሴታ ህግንም ኤስዝድባብከሰረ ክክ ክክ ኩን ጋየረኮ ክታዘን Ꮊልተርድ Ꮊቀኬ፥ “አብንከስም አቅስቴ፥ ይንታ ማተንም ማቸ አቅስካንታ ማታዬ! <verse eid="MRK 15:31"/><verse number="32" style="v" sid="MRK 15:32"/>ኖ ክርስቶስ እስራኤልንታ ባንችን ይ ማቼ ማዝቀልንዘንካ ክት Ꮊንቸራ፥ ዎተረ ሰድስንደትከ ዎ አሜና!” ኮትኮግንደረ ክትካ ክክን ሮከርስባብ ክትም የግድᎺቀኬ።<verse eid="MRK 15:32"/></para>
  <para style="s1">የሱስታ ደእና</para>
  <para style="r">(<ref loc="MAT 27:45-56">ማቶ. 27፡45-56</ref>፤ <ref loc="LUK 23:44-49">ሉቃ. 23፡44-49</ref>፤ <ref loc="JHN 19:28-30">ዮሀ. 19፡28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33"/>ሰጨና ላ ሳዓት ማቻንዘንካ የድሶ ሳክላ ሳዓት የለልታ ፍጫሙደንዘን ኡም ማቼ። <verse eid="MRK 15:33"/><verse number="34" style="v" sid="MRK 15:34"/>ሳክላ ሳዓትንዘን የሱስ “ኤሎሄ! ኤሎሄ! ላማ ሳበቅተን?” ጋይሶ ፍፍሴ። ኮታ ቡልነረ “ጮይስዮ፥ ጮይስዮ! Ꮊረተስ እም ዛቅሳራ?” ጋይንትዬ።<verse eid="MRK 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35"/>ኮታር ዎእሶ Ꮊቅባብከሳርንካ ዋልቃ ዋልቀንከስ ኮም ኤሰርድንካ፤ “ኤላሰም ኤልዳ ማደ” ከታ ጋይሰኬ።<verse eid="MRK 15:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 15:36"/>ከታርንከረ ዋልቀና ዞድሶ ጫቅምድንደትም ስፎንግ ጋይድንዳ ዳልች ሎቃ የድንግንዳ የጃንደትም ጉፈታ ታጰካ ክት ዎጭድንግንዳ የሱስካንታ እምሶ “ይና ገታ ኤላስ Ꮊድሶ ክትም Ꮊንጅድንዳ ማቸረ ዎሰዳ!” ጋይሴ። <verse eid="MRK 15:36"/><verse number="37" style="v" sid="MRK 15:37"/>ኮተረ ቡር የሱስ አንድር ኡፍስካ ፍፍሴ፥ ክታ ሰንፔነረ ዉተዴ።<verse eid="MRK 15:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38"/>ሳብታ ጭል ኤሄንታ ስፍስንደና ፈይንካ ሶ የለልታ Ꮊእሶ ቃስቴን ፋስምሴ።<note caller="-" style="x"><char style="xo" closed="false">15፡38 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">ዉት. 26፡31-33</ref>። </char></note> <verse eid="MRK 15:38"/><verse number="39" style="v" sid="MRK 15:39"/>የሱሰካ የረየር ዎእሶ Ꮊቅባብ ፖልስንከስታ ገችንባብ ኮግንዳ ፍብድንካ ሰንፔና ክታ Ꮊስግንዳ ዉተዳናንከረ ይ ሰዳንደትካ፥ “ኮና ኤችና ዶፈን ሳብታ ይንች Ꮊቄ” ጋይሴ። <verse eid="MRK 15:39"/><verse number="40" style="v" sid="MRK 15:40"/>ኮታይካ ጎትካ ማትሰኮ ሰድባብ፥ ዋልቃ ዋልቃ ማነንከሰረ ኮታር Ꮊቀኬ። ከተረ ዎክያርንካ መግደላ ፍጭንካ Ꮊዳንዳ ማራማ፥ ካንስ ያይቆበተኬ ዮሰታ እንደን ማራማ፥ ኮትግንደረ ኤተን ሰሎም ጋይድንዳ Ꮊቄ። <verse eid="MRK 15:40"/><verse number="41" style="v" sid="MRK 15:41"/>ኬታ የሱስ ገሊላር ክት Ꮊቃንደትካ ጎርስመረኮ ክትካንታ ፍክሰረኮ Ꮊቀኬ። ኮትኮግንደረ የሱሰካ ክክን የሩሳሌማር Ꮊድባብ በድ አብ ማነንከስ Ꮊቀኬ።<note caller="-" style="x"><char style="xo" closed="false">15፡41 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">ሉቃ. 8፡2-3</ref>። </char></note><verse eid="MRK 15:41"/></para>
  <para style="s1">የሱሰታ ዱክር</para>
  <para style="r">(<ref loc="MAT 27:57-61">ማቶ. 27፡57-61</ref>፤ <ref loc="LUK 23:50-56">ሉቃ. 23፡50-56</ref>፤ <ref loc="JHN 19:38-42">ዮሀ. 19፡38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42"/>ፍጨና ሶይቻንካንታ አይሁድንከስታ Ꮊዉስ ሰጨና Ꮊድሶ የልድንካ ግግምተረ ሰጫ ማቼ፥ <verse eid="MRK 15:42"/><verse number="43" style="v" sid="MRK 15:43"/>ኮታይካ አይሁድንከስታ ቡጫ ጋልተንከስታርንካ ዋልቀና ዮሴፍ ጋይምድባብና ቦንችምስባብ አርማትያስ ፍጨናርንክንባብ ኤች Ꮊዴ። ኖየረ ሳብታ ባንችምን ጉርምካ ካርዝድባብ Ꮊቄ። ሙቅምካ ጵላጦሰታ እር Ꮊድሶ የሱሰታ ለይስን እምድንግንዳ ምክሴ። <verse eid="MRK 15:43"/><verse number="44" style="v" sid="MRK 15:44"/>ጵላጦሰረ “Ꮊስግንድክ ኮግንዳ ሳነካ ደእሳሬ?” ጋይሶ በርእሴ። ፖልስንከስም ክድባብም ኤልስሶ “ገታ ደእስንካ ዶቅቶ?” ጋይሶ ኦይሴ። <verse eid="MRK 15:44"/><verse number="45" style="v" sid="MRK 15:45"/>የሱሰታ ደእንም ፖልስንከስም ክድባብዘንካ ይ ኤሰርሳንደታ ቡር የሱሰታ ለይስንም ዮሰፍካንታ እምሴ። <verse eid="MRK 15:45"/><verse number="46" style="v" sid="MRK 15:46"/>ዮሰፈረ ዱክታ አፍላ ሰንሴ ለይስንም Ꮊንችሶ አፍለንካ አክሳንደታ ቡር ላዝይ ሰይን ቆቀርሳንደታር ዱክሴ። አንድር ሰይንመረ ቡከልስት ዱክንታ ፍልተን ዝጬ። <verse eid="MRK 15:46"/><verse number="47" style="v" sid="MRK 15:47"/>መገደላ ፍጨናርንዳ ማራመትኬ ዮሰታ እንደን ማራመካ የሱሰም Ꮊብር ከት ዱክሳናንከረ ከታ ሰድዮ Ꮊቀኬ።<verse eid="MRK 15:47"/></para>
  <chapter eid="MRK 15"/>
  <chapter number="16" style="c" sid="MRK 16"/>
  <para style="s1">የሱሰታ ዱክናርንካ አምንተና</para>
  <para style="r">(<ref loc="MAT 28:1-8">ማቶ. 28፡1-8</ref>፤ <ref loc="LUK 24:1-12">ሉቃ. 24፡1-12</ref>፤ <ref loc="JHN 20:1-10">ዮሀ. 20፡1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1"/>አይሁድንታ Ꮊዉስ ሰጨና ስግዳን ቡር ማግዶላ ፍጨናርንካ Ꮊዳንዳ ማራማ፥ ያይቆበታ እንደን ማራመትኬ ሳሎመከረ ክክን Ꮊድሰኮ የሱሰታ ለይስንም ሳይካንታ ዎዝድንደትም ሰንሰኬ። <verse eid="MRK 16:1"/><verse number="2" style="v" sid="MRK 16:2"/>ሳምንትንታ እር ሰጨንታ ዛማ ሰጭመናር፥ አክ Ꮊይ ዉተዳንግንዳ ዱክናር አይሰኬ። <verse eid="MRK 16:2"/><verse number="3" style="v" sid="MRK 16:3"/>ከተረ “ሰይንንም ዱክንታ ፉልተንዘንካ Ꮊይ ዎካንታ ቡከልስተራ?” ጋይንተካ ክክ ከዝምድ Ꮊቀኬ። <verse eid="MRK 16:3"/><verse number="4" style="v" sid="MRK 16:4"/>ኮመረ ከት ጋይሳንዳ ዱክና ዝጭምሳን ሰይንና አንድር ባካ ማቻንካንቴ፥ ጬክን ጋይሶ ከት ሰድንካ ሰይንና ቡከልስንካ ሰደኬ። <verse eid="MRK 16:4"/><verse number="5" style="v" sid="MRK 16:5"/>ዱክናረረ ከት አርድንካ ሮጵድን አፍላ ቆበርስባብ ሰከን ምዝዘንጎካ ዶቅሶ ክት ዶቅድንካ ሰድሰኮ አንድር ጳሰኬ።<verse eid="MRK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6"/>ኖ ማቼ፥ “ዛብከቴ፥ Ꮊይ ጳሰቴ፥ የ ዝግድባብ ሮከርስባብ ናዝረት የሱሰም ማቻንደትም ኤዝድቴ፥ ኖ አምቴ፥ ካሪ ካዬ፥ ኮሰቸቴ ክት ዱከርሳን ካርነረ ኮንሴ። <verse eid="MRK 16:6"/><verse number="7" style="v" sid="MRK 16:7"/>ኬዛር ማቼ አይሰቶ ክታ ካርንካ ጎርስምድባብ ጴጥሮስካንታ ‘ገሊላር ኖ እርምሶ አይዴ፥ ኮታረረ ክትም ሰተረቴ’ ጋይሰቶ ከትካንታ ኬዝከቴ” ኩን ከትም ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">16፡7 </char><char style="xt" closed="false"><ref loc="MAT 26:32">ማቶ. 26፡32</ref>፤ <ref loc="MRK 14:28">ማር. 14፡28</ref>። </char></note><verse eid="MRK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8"/>ማነንከሰረ ጳስካ ጭጨረኮ ዱክናርንካ ዉትሰኮ Ꮊዘኬ፥ አንድር ከታ ይ ጳሳንካንታ Ꮊረሰነረ ር Ꮊየሰንካንታ ከዛከኬ።<verse eid="MRK 16:8"/></para>
  <para style="s1">የሱስ ማግደላ ፍጨናርንደት ማራማ ካንታ Ꮊፍርና</para>
  <para style="r">(<ref loc="MAT 28:9-10">ማቶ. 28፡9-10</ref>፤ <ref loc="JHN 20:11-18">ዮሀ. 20፡11-18</ref>)<note caller="+" style="f"><char style="fr" closed="false">16፡8 </char><char style="ft" closed="false">አብንዝንካ ተይምሶ ጻፍምሳን እከስከ ኤና እር ቡልንከስ ፋይ. 9-20 ዶቅድን ካርንም ጉጃዬ። </char></note></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9"/>የሱስ ሳምንትንታ እሪ ሰጨናይካ ሰጭማ ዱክናርንካ ይ አምሳን ቡር፥ እርምሶ ታብዛ ግምዘንም ይ ዉችሳን ኤተን ማግደላ ፍጫርንደት ማራማ ካንታ Ꮊፈርሴ። <verse eid="MRK 16:9"/><verse number="10" style="v" sid="MRK 16:10"/>ናየረ አይሶ፥ የሱሰካ ክክን Ꮊቅባብ ሞርእዘንኬ ኤፍዘን ዶቅድባብከስካንታ ና ኬዜ። <verse eid="MRK 16:10"/><verse number="11" style="v" sid="MRK 16:11"/>ከተረ ሰንፔካ ክት ማቻንደትምኬ ኮትካንተረ ክት Ꮊፈርሳንደትም ኮት ኬዝንከረ ኤሰርሰኮ አሜናከኬ።<verse eid="MRK 16:11"/></para>
  <para style="s1">የሱስ ቃስተን ክታ ካርንካ ጎርስምድባብከስካንታ Ꮊፍርና</para>
  <para style="r">(<ref loc="LUK 24:13-35">ሉቃ. 24፡13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12"/>ኮተረ ቡር ካተማ ካየንደታር አያዶቅድባብ ቃስተን ክታካርንካ ጎርስምድባብከስካንታ የሱስ አብ ኤድም ካምሶ Ꮊፈርሴ። <verse eid="MRK 16:12"/><verse number="13" style="v" sid="MRK 16:13"/>ከተረ ማትሰኮ ነግድባብ ክታ ካርንካ ጎርስምድባብከስካንታ ኬዘኬ፥ ክታ ካርንካ ጎርስምድባብከስ ከትመረ አሜናከኬ።<verse eid="MRK 16:13"/></para>
  <para style="s1">የሱስ ታመከ ዋልቃ ኦይትምስባብከስካንታ Ꮊፍርና</para>
  <para style="r">(<ref loc="MAT 28:16-20">ማቶ. 28፡16-20</ref>፤ <ref loc="LUK 24:36-49">ሉቃ. 24፡36-49</ref>፤ <ref loc="JHN 20:19-23">ዮሀ. 20፡19-23</ref>፤ <ref loc="ACT 1:6-8">ኦይት. ፍ. 1፡6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14"/>ኮተረ ቡር ታመከ ዋልቀንከስና እችምዘን ከትዶቅድንካ የሱስ ከትካንታ መያ ማቼ፥ ኬዛርካ ማቼ “የሱስ ደእናርንካ አምሶ ሰንፔካ ዶቅዴ ጋይሴ፥ ዎታ ዎንታ አፍከረ ክትም ሰቶቴ” ጋይሰኮ ከትካንታ ከዝባብከስም አሜናክንካንተኬ ከታ ጫልንጎካ Ꮊግዜ።<verse eid="MRK 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 16:15"/>ኮታዘንከረ፥ “ፍጫ ሙደናር አይከቴ፥ ፍዝር ሙደንካንታ ክላ ኬዘንም ሳባከቴ።<note caller="-" style="x"><char style="xo" closed="false">16፡15 </char><char style="xt" closed="false"><ref loc="ACT 1:8">ኦይት. ፍ. 1፡8</ref>። </char></note> <verse eid="MRK 16:15"/><verse number="16" style="v" sid="MRK 16:16"/>አመንስባብከኬ ስኤርስባብ አቅተሬ፥ አመናክባብ ማቼ ፋረድምተሬ። <verse eid="MRK 16:16"/><verse number="17" style="v" sid="MRK 16:17"/>እንካ አሜንድባብከስ ሙደና ኬና ቃዉተን ይተረኬ፥ እስታ ላምንካ ግምዘንከስም ዉችተረኬ፥ ክላ አፋ ከስተረኬ፥ <verse eid="MRK 16:17"/><verse number="18" style="v" sid="MRK 16:18"/>ጉንንከስም ይንታ አንካ የተረኬ፥ አነረ ደይዝድን ር ዎጨረ ከትም ቦድሶ ኡፈልስተራክዬ፥ ከታ ይንታ አንንመረ Ꮊዘርስባብታዘን ዎተረኬ ከተረ ፋጭተረኬ” ኩን ከትም ጋይሴ።<verse eid="MRK 16:18"/></para>
  <para style="s1">የሱሰታ ጭላር አይንተና</para>
  <para style="r">(<ref loc="LUK 24:50-53">ሉቃ. 24፡50-53</ref>፤ <ref loc="ACT 1:9-11">ኦይት. ፍ. 1፡9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19"/>ጮይስ የሱስ ኮም ሙዳ ከትም ይ ኬዛንደታ ቡር ፈስ ጭላር አይሴ። ሳብተረ ምዝንዘን ዶቅሴ።<note caller="-" style="x"><char style="xo" closed="false">16፡19 </char><char style="xt" closed="false"><ref loc="ACT 1:9-11">ኦይት. ፍ. 1፡9-11</ref>። </char></note> <verse eid="MRK 16:19"/><verse number="20" style="v" sid="MRK 16:20"/>ኮታዘንከረ የሱሰታ ካርንካ ጎርስምድባብከስ ዉትሰኮ ካሪ ሙደናር ሳባክሰኬ፥ ጮይሰረ ከትካ ክክን ፍግዝድ Ꮊቄ። ከት ኤስዝድንግንደረ ቦድምድን ቃዉተን ይንታ ቃለንካ ዳቅዝድ Ꮊቄ።<verse eid="MRK 16:20"/></para>
  <chapter eid="MRK 16"/>
</usx>
