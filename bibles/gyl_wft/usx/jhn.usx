<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- Gayil New Testament</book>
  <para style="h">ዮሀንስ</para>
  <para style="toc1">ዮሀንስ ጻፍሳንዳ ዎንታ ጮይስን የሱስ ክርስቶሰታ ክላ ኬዛ</para>
  <para style="toc2">ዮሀንስ</para>
  <para style="toc3">ዮሀ.</para>
  <para style="mt1">ዮሀንስ ጻፍሳንዳ</para>
  <para style="mt2">ዎንታ ጮይስን የሱስ ክርስቶሰታ ክላ ኬዛ</para>
  <para style="imt1">አርድንታ</para>
  <para style="ip">ዮሀንሰታ ክላ ኬዘና የሱሰቴን ኬዝድዮ ዋሀ ቆብርሶ ኤድንከስታ ዎክያር Ꮊፈርስባብ ስለንካ ዶቅድባብ ሳብታ ቃላ ማትንተንም መያ ማስካንቴ። ማጻፍና ይንታ ማታርንካ መያ ማዝድንደትግንዳ ኮና ክላ ኬዘና ጻፍምሳንዳ ናበብድባብከስ የሱስ አቅስንባብ ማትሶ Ꮊዴ ጋይምስባብ ሳብታ ይንች ክታ ማትንተን ኬት አመንድንግንደኬ ክትከረ ከታ አሜንምንጎካ ስለንካ ዶቅንት ከታ ዶቅድንደትም ኬት ኤዝድንግንዴ (20፡31)።</para>
  <para style="ip">ክላ ኬዘንታ እሪንደታር ስለንክንዳ ሳብታ ቃለንኬ የሱሰካ ዋልቃ ማትንተን አርድንታ ማስሶ ይ ኬዛንደታ ቡር የሱስ አቅስንባብ ማትሶ Ꮊዴ ጋይምስባብ ሳብታ ይንች ክታ ማትንተን ሰጅድን Ꮊክ Ꮊክ አተንታ ቃዉተንከስም ኬዝዴ፥ ኮታዘንከረ ከትኬና አታ ቃዉተንከዘንካ Ꮊራ አፍ Ꮊፈርሳ ናንከረ ኤስዝድንዳ ፍክስምሶ ስገድባብከስ ጎርስምደኬ፥ ኮና ካርነረ ኬዝድንዳ ዋልቃ ዋልቃ ኤድንከስ የሱሰካ አሜንሰኮ ክትም ጎርስምድባብከስ ከታ ማትንተን፥ አብንከሰረ ጉጅሶ Ꮊስግንዳ ክትም ኬት ግርዳናንከኬ ክትካ አመንዳኮቴ ኬት ጋይሳንግንዴ። የድይ 13-17 የለልታ የሱስ ይ የደርሳን ሶይት ይንታ ካርንካ ጎርስምድባብከስካ ክክን Ꮊራከካ ዛብዛን ዋልቃትች ክታ Ꮊቃናንከ ክታ ሮክርነረ የልድንካ ግግምንተኬ ዳቅንተታ ቃላ ከትም ኤስምሳንደትም ኬዝዴ። በእንታ የድንከሳር የሱሰታ የድርንጎከ ፋረድምንጎካ፥ ክታ ሮከርንጎኬ ክታ ደእናርንካ አምንተንጎካ፥ ኮትኮግንደረ ደእናርንካ አምንተንታ ቡር ይንታ ካርንካ ጎርስምድባብከስካንታ ክታ መያ ማትንተንጎካ ገቀርዝድባብከሰኬ።</para>
  <para style="ip">2 ዮሀንስ የሱስ ክርስቶስጎካ Ꮊፈርድንደትም ስለንክንደታ ዶቅንትን መያ ማስሶ ክት ሰጅድንዳ ኮና ዉች እምንተና ታይንዘንካ የችሶ የሱሰም ጎግ፥ ዶፈን፥ ዶቅንት ማስሶ ተይድባብከስካንቴ። ዮሀንሰታ ክላ ኬዘንም አብንከዘንካ Ꮊክ ማስዝድንዳ አያንናር ዶፈንንከስ ኤድም አርድንግንዳ መጣ ማቻንደትኬ ሰጨታ ዶቅንተናር ዎም መይድርንከስ፥ ጋይንትነረ ሎቃ፥ እችም፥ ሳክማ፥ ግስመንባብ፥ ክታ ቆልንከስ፥ ዎይንንታ ኮረንከስኬ ዎይንንታ አፍን ካምድን ሪንከስም ካምስካ ክት ከዛንዴ።</para>
  <para style="iot">ማጻፍን ኮትኮታ ሙዳ የድንተና</para>
  <para style="io1">እሪንደና አርድንታ <char style="ior">(<ref loc="JHN 1:1-18">1፡1-18</ref>) </char></para>
  <para style="io1">ስእስንባብ ዮሀንሰኬ የሱሰታ ካርንካ ጎርስምስባብ እርንባብከስ <char style="ior">(<ref loc="JHN 1:19-51">1፡19-51</ref>) </char></para>
  <para style="io1">የሱስ ፍክስን ይንታ የድና <char style="ior">(<ref loc="JHN 2:1-12:50">2፡1—12፡50</ref>) </char></para>
  <para style="io1">የሩሳሌም ካተመናርኬ ኮታ ሞረናር ክታ ፍክስንታ በእንታ ሰጨንከስ <char style="ior">(<ref loc="JHN 13:1-19:42">13፡1—19፡42</ref>) </char></para>
  <para style="io1">ጮይስታ ደእናርንካ አምንተንከኬ ይንታ ካርንካ ጎርስምድባብከስካንታ መያ ክታ ማትና <char style="ior">(<ref loc="JHN 20:1-31">20፡1-31</ref>) </char></para>
  <para style="io1">በእንታ፥ ገሊላ ፍጨናር አናካርንካ ይንታ ካርንካ ጎርስምድባብከስካንታ ክታ መያ ማትና <char style="ior">(<ref loc="JHN 21:1-25">21፡1-25</ref>) </char></para>
  <chapter number="1" style="c" sid="JHN 1"/>
  <para style="s1">ዶቅንት ቃላ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1"/>እርምሶ ቃለና Ꮊቄ፥ ቃለነረ ሳብካ ክክን Ꮊቄ፥ ኮነረ ቃለና ሳብ Ꮊቄ። <verse eid="JHN 1:1"/><verse number="2" style="v" sid="JHN 1:2"/>ኖየረ እርምሶ ሳብታ ላማር Ꮊቄ። <verse eid="JHN 1:2"/><verse number="3" style="v" sid="JHN 1:3"/>ሙዳ ርና ክትጎካ ፍዝምሴ፥ ፍዝምሳን ሙዳ ሪያርንካ፥ ዋልቃ ሪየረ ክት ካይሳ ፍዝምሳንዳ ካዬ። <verse eid="JHN 1:3"/><verse number="4" style="v" sid="JHN 1:4"/>ክትካ ሰንፓ Ꮊቄ፥ ኮነረ ሰንፔና ኤድንከስታ ሳክማ Ꮊቄ። <verse eid="JHN 1:4"/><verse number="5" style="v" sid="JHN 1:5"/>ሳክመና ኡምናር ሳግዝዴ ኡምነረ ሳክመንም ጋማክዬ።<verse eid="JHN 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6"/>ሳብዘንካ ክትምስባብ ዮሀንስ ጋይምድባብ ዋልቃ ኤች Ꮊቄ፥<note caller="-" style="x"><char style="xo" closed="false">1፡6 </char><char style="xt" closed="false"><ref loc="MAT 3:1">ማቶ. 3፡1</ref>፤ <ref loc="MRK 1:4">ማር. 1፡4</ref>፤ <ref loc="LUK 3:1-2">ሉቃ. 3፡1-2</ref>። </char></note> <verse eid="JHN 1:6"/><verse number="7" style="v" sid="JHN 1:7"/>ክታ ማርካትቸን ኤሰርሶ ኤድ ሙደና አሜንድንግንዳ ሳክመንጎካ ማርካ ማትሶ ኖ Ꮊዴ። <verse eid="JHN 1:7"/><verse number="8" style="v" sid="JHN 1:8"/>ኖ ሳክመንካንታ ማርክርደር Ꮊዳ ዳት ኖይንታ ማታ ሳክማ ካዬ። <verse eid="JHN 1:8"/><verse number="9" style="v" sid="JHN 1:9"/>ኤድ ሙደንካንታ ሳግዝድባብ ዶፈን ሳክመና ፍጫሙደንዘን Ꮊዳ ዶቅዴ።<verse eid="JHN 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 1:10"/>ኖየረ ፍጫሙደንዘን Ꮊቄ፥ ፍጫ ሙደና ፍዝምሳንዳ ክትኬ፥ ፍጫ ሙደና ማቼ ክትም ኤሳክዬ። <verse eid="JHN 1:10"/><verse number="11" style="v" sid="JHN 1:11"/>ይንታ ማችባብከዝደር ኖ Ꮊዴ ክታ ኮችንከስ ማቼ ክትም ግርደኬ። <verse eid="JHN 1:11"/><verse number="12" style="v" sid="JHN 1:12"/>ማታጋካ ዳት ክትም Ꮊፍስባብከስካንተኬ ክታ ላምካ አመንስባብከስካንታ ሙዳ ሳብታ ይንች ማትንተታ ሸን ከትካንታ እምሴ። <verse eid="JHN 1:12"/><verse number="13" style="v" sid="JHN 1:13"/>ከተረ ሳብዘንካ አጥምሰክ ዳት ኤታ ሱሳርንካ፥ ጋይንትነረ ዋሄታ ጋይተካ አነረ ኤታ ጋይተካ አጥማከኬ።<verse eid="JHN 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14"/>ቃለነረ ኤድ ማቼ፥ ዉች እምንተኬ ዶፈንነረ ጮጭሶ ዎንታ ዎክያር ዶቅሴ፥ ባቤንታ ዋልቃ ይንት ይንችና ይንታ ባቤንታ ላማር ዶቅድንደትግንዳ ክታ ቦንቼንም ሰቶቴ።<verse eid="JHN 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15"/>ዮሀንሰረ “ ‘ኖ እስታ ካርንካ Ꮊድባብ እስታ እሪ ክት Ꮊቃንኦል እዘንካ አንድርይ ስገዴ’ ጋይስቶ እ የካንታ ኬዛንዳ ይና ኮኔ” ጋየሮ ማርከርሴ።<verse eid="JHN 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16"/>ክታዘንካ ዉች እምንተንታ በድምናርንካ ዎታ ሙደና ዉች እምንተንዘን እምንተንም ተይቶቴ። <verse eid="JHN 1:16"/><verse number="17" style="v" sid="JHN 1:17"/>ሳብ ህግን ሙሴጎካ እምሴ፥ ዉች እምንተንኬ ዶፈና ማቼ የሱስ ክርስቶስጎካ Ꮊዴ። <verse eid="JHN 1:17"/><verse number="18" style="v" sid="JHN 1:18"/>ሳብም ሰጅባብ ቦድሶ Ꮊየነረ ካዬ፥ ማታጋካ ዳት ሳብ ባቤንካ ክክን ዶቅድባብ ጮይስ ማችባብ ዋልቃ ክታ ይንችና Ꮊክ ክትም መያ ማስሴ።<verse eid="JHN 1:18"/></para>
  <para style="s1">ስእስንባብ ዮሀንሰታ ማርከትቺ</para>
  <para style="r">(<ref loc="MAT 3:1-12">ማቶ. 3፡1-12</ref>፤ <ref loc="MRK 1:1-8">ማር. 1፡1-8</ref>፤ <ref loc="LUK 3:1-18">ሉቃ. 3፡1-18</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19"/>አይሁድንከስታ ገችንታ ኤረንባብከስ የሩሳለማርንካ ቄሰንከስምኬ ሌዊንከስም ዮሀንሰደር ኦይትሰኮ፥ “የና Ꮊይራ?” ጋይሶ ኬት ክትም ኦይስሳንᎺይካ ከትካንታ ክት እምሳንዳ ማርካትቸና ኮም ካምዴ፤<verse eid="JHN 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 1:20"/>ኖ “እታ ሳይምስባብ ካይቴ” ጋይሶ ማርከርሳ ዳት ካዳክዬ።<verse eid="JHN 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21"/>ከተረ “ይና የና Ꮊይራ? የና ኤላሶ?” ጋየረኮ ክትም ኦይሰኬ።<note caller="-" style="x"><char style="xo" closed="false">1፡21 </char><char style="xt" closed="false"><ref loc="DEU 18:15-18">ካሪ. 18፡15-18</ref>፤ <ref loc="MAL 4:5">ሚል. 4፡5</ref>። </char></note></para>
  <para style="p" vid="JHN 1:21">ኖየረ “እታ ካይቴ” ጋይሶ ከደረ ማስሴ።</para>
  <para style="p" vid="JHN 1:21">ከተረ “Ꮊዴ ጋይምስባብ ሳብዘንካ ኤሰርሶ ኬዝድባብ የኖ?” ክደረ ጋይሰኬ።</para>
  <para style="p" vid="JHN 1:21">ኖየረ “እታ ካይቴ” ጋይሴ።<verse eid="JHN 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22"/>ከተረ “ይና የና Ꮊይራ? ዎም ኦይችባብ ኤድንከዝደረ ማስንም ዎ ኬዝድንግንዳ የስጎካ Ꮊረስ ጋይዳ?” ክደረ ጋይሰኬ።<verse eid="JHN 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23"/>ኖየረ ሳብዘንካ ኤሰርሶ ኬዝባብ ኢስያስ ኬዛንደትግንዳ</para>
  <para style="q1" vid="JHN 1:23">“እታ ‘ጮይስንታ ጎግን ሉልስከቴ’ ጋየሮ</para>
  <para style="q2" vid="JHN 1:23">ዴል ቆቸናር ፍብድን ኤታ ኡፍስቴ” ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">1፡23 </char><char style="xt" closed="false"><ref loc="ISA 40:3">ኢሳ. 40፡3</ref>። </char></note><verse eid="JHN 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24"/>ኤድንከስ ኦይትምሳንደና ፈረሳዊያንንከሳርንኬ። <verse eid="JHN 1:24"/><verse number="25" style="v" sid="JHN 1:25"/>ኮካንታ “የና ሳይምስባብ አነረ ኤላስ አነረ Ꮊዴ ጋይምስባብ ሳብዘንካ ኤሰርሶ ኬዝድባብ የስ ማታክንዳ ማቼ ይና፥ Ꮊረተስ ስእዝዳ?” ጋይሶ ኦይሰኬ።<verse eid="JHN 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26"/>ዮሀንሰረ ኩንጋየሮ ከደረ ማስሴ፥ “እ ስዝድንዳ ሎቀኬ፥ ኬዛር ማቼ የታ የ ኤዝዳክባብ የንታ ዎክያር ዎእቴ። <verse eid="JHN 1:26"/><verse number="27" style="v" sid="JHN 1:27"/>ኖ እስታ ቡርጎካ Ꮊድባቤ፥ እታ ክታ ጫመንታ ዞክነንደትም ብልካንታ ዎራ ማድባብ ካይቴ።”<verse eid="JHN 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28"/>ኮና ማቻንዳ ዮሀንስ ስእዝድ Ꮊቃን ዮርዳኖስ ሎቀንታ ፋማ Ꮊፈርድን ብታንያ ካተመናሬ።<verse eid="JHN 1:28"/></para>
  <para style="s1">ሳብታ ቆለን ማችባብ የሱስ</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29"/>ዛማክንካ ዮሀንስ የሱስ ፈንካ ክደር Ꮊድንካ ሰድሶ፥ “ይና ፍጫሙደንታ ጎመንም Ꮊልእዝድባብ ሳብታ ቆለና ኮኔ! <verse eid="JHN 1:29"/><verse number="30" style="v" sid="JHN 1:30"/>‘ኖ ኦኮና እስታ ካርንካ Ꮊድባብ እስታ ኤና እሪ ክት Ꮊቃንካንታ እዘንካ አንድርይ ስገዴ’ እ የካንታ ጋይሳንዳ ኮኔ። <verse eid="JHN 1:30"/><verse number="31" style="v" sid="JHN 1:31"/>እተረ እስታ ማታርንካ ኤሳይቴ፥ ኬዛር ማቼ ኖ እስራኤል ዎርሰንካንታ መያ ማድንግንዳ እታ ሎቀካ ስእሰሮ Ꮊዳተ ጋይሴ።”<verse eid="JHN 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32"/>ኮታዘንከረ ዮሀንስ፥ “አያንይ ጭልና ዎላ ግንዳ ጭላርንካ Ꮊንችርድንከ ክታዘን ማድንካ ሰጅቴ፥ <verse eid="JHN 1:32"/><verse number="33" style="v" sid="JHN 1:33"/>እታ እስታ ማታርንካ ክትም ኤሳይቴ፥ ኬዛር ማቼ ሎቀካ እ ስእዝድንግንዳ እም ኦይችባብ፥ ‘አያን ጭልና Ꮊንቸርድንከኬ ክታዘን ዶቅድንካ ሰድምድባብ አያን ጭልንካ ስእዝድባብ ኖዬ’ ጋየሮ እም ኬዝቴ። <verse eid="JHN 1:33"/><verse number="34" style="v" sid="JHN 1:34"/>እተረ ኮም ሰትቴ፥ ኮካንታ ኖ ሳብታ ይንች ማትንተን እታ ማርከርድቴ ጋይሴ።”<verse eid="JHN 1:34"/></para>
  <para style="s1">የሱሰታ ካርንካ ጎርስምስባብ እርንባብከስ</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35"/>ዛማክንካ ዮሀንስ ቃስተን ይንታካርንካ ጎርስምድባብከስካ ክክን ካርንካ አነታ ኮታር ዎእሶ Ꮊቄ፥ <verse eid="JHN 1:35"/><verse number="36" style="v" sid="JHN 1:36"/>ዮሀንሰረ የሱስ ኮትካ ስገድንካ ሰድሶ፥ “ይና፥ ሳብታ ቆለን!” ጋይሴ።<verse eid="JHN 1:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37"/>ቃስተና ዮሀንሰታ ካርንካ ጎርስምድባብከስ ዮሀንስ ኮም ጋይድንካ ኤሰርሶ፥ የሱሰም ጎርስምሰኬ። <verse eid="JHN 1:37"/><verse number="38" style="v" sid="JHN 1:38"/>የሱስ ዋልን ጋይሶ ከት ክትም ጎርስምድንካ ሰድስንደትኬ “Ꮊረንት ዝግዳ?” ከደረ ጋይሴ።</para>
  <para style="p" vid="JHN 1:38">ከተረ “ረቢ! የስ ዶቅድንዳ Ꮊብረረ?” ክደር ጋይሰኬ። (ረቢ ጋይንትና ኤስስንባብ ጋይንትዬ)።<verse eid="JHN 1:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39"/>ኖየረ “Ꮊድሰቶ ሰድከቴ” ከደረ ጋይሴ። ኮካንታ አይሰኮ Ꮊብር ክት ዶቅዳናነረ ሰጀኬ። ኮት ሰጨንካ ክትካ ክክን የካ Ꮊቀኬ፥ ሳዓትና ታማ ማታባብ Ꮊቄ።<verse eid="JHN 1:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40"/>ዮሀንስ ኬዛንደትም ቃለንም ኤሰርሶ የሱሰታ ካርንካ ጎርስምስባብከሳርንካ ዋልቀና ስምኦን ጴጥሮስታ እስመን እንደርያስ Ꮊቄ። <verse eid="JHN 1:40"/><verse number="41" style="v" sid="JHN 1:41"/>እንደራስ እርምሶ ይንታ እስመን ስምኦነደር አይሶ “መስም Ꮊፍሶቴ!” ክደረ ጋይሴ። (መስይ ጋይንትና ክርስቶስ አነረ ሳይምስባብ ጋይንትዬ) <verse eid="JHN 1:41"/><verse number="42" style="v" sid="JHN 1:42"/>ኮታ ቡር እንደራስ ስምኦነም የሱሰደር ተይᎺዴ።</para>
  <para style="p" vid="JHN 1:42">የሱሰረ ፍስሳ ክትም ሰድሶ “የና ዮነታ ይንችና ስምኦነዬ፥ ይና ኮዘንካ ኦስ ማቼ ከፋ ጋይምደዬ” ክደረ ጋይሴ። (ከፋ ጋይንትና ጴጥሮስ ጋይንት ናንከረ አነረ ላዝይ ጋይንት ማዴ)።<verse eid="JHN 1:42"/></para>
  <para style="s1">የሱስ ፍልጶሰምኬ ናትናኤልም ኤልና</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43"/>ዛማክንካ የሱስ ገሊላ አይካንታ ዝግዜ፥ ፍልጶሰመረ Ꮊፍስንደትከ “እም ጎርስምካ!” ክትም ጋይሴ። <verse eid="JHN 1:43"/><verse number="44" style="v" sid="JHN 1:44"/>ፍልጶስ እንደርያስግንደኬ ጴጥሮስግንዳ በቴሳይዳ ካተማ ኤድ Ꮊቄ። <verse eid="JHN 1:44"/><verse number="45" style="v" sid="JHN 1:45"/>ፍልጶሰረ ናትናኤልም Ꮊፍሶ፥ “ሙሳ ህግ ማጻፍናር፥ ሳብዘንካ ኤሰርሶ ኬዝድባብከሰረ ቤር ማጻፍናር ክትጎካ ጻፍሳንደትም Ꮊፍሶቴ፥ ኖየረ የሶፍታ ይንች ናዝረት የሱስየ” ክደረ ጋይሴ። <verse eid="JHN 1:45"/><verse number="46" style="v" sid="JHN 1:46"/>ናትናኤል ማቼ፥ “ናዝረታርንካ ኡርማ ር ቦድሶ Ꮊፈርዶ?” ክደር ጋይሴ። ፍልጶሰረ “Ꮊድሶ ሰድካ!” ክትም ጋይሴ። <verse eid="JHN 1:46"/><verse number="47" style="v" sid="JHN 1:47"/>ናትናኤል ፈንካ ክደር Ꮊድንካ ሰድሶ የሱሰረ “ይና! ጩባ ካየንባብ ዶፈን እስራኤል ኤድ!” ጋየሮ ክትጎካ ኬዜ። <verse eid="JHN 1:47"/><verse number="48" style="v" sid="JHN 1:48"/>ናትናኤለረ “Ꮊብረስ እም ኤዝዳ?” ክደር ጋይሴ። የሱሰረ “ፍልጶስ የስም ኤልተርንደታ እር በለስ Ꮊቀንታ ጎያር የስ ዶቅድንካ ሰጅቴ” ጋየሮ ክደር ማስሴ። <verse eid="JHN 1:48"/><verse number="49" style="v" sid="JHN 1:49"/>ኮትᎺይካ፥ ናትናኤል፥ “ኤስስንባቦ! የና ሳብታ ይንቸዬ! የና እስራኤልታ ባንቻዬ!” ጋይሴ።<verse eid="JHN 1:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50"/>የሱሰረ፥ “የስ አሜንሳንዳ፥ ‘በለስ Ꮊቃንታ ጎያር ማትሶ የስ ዶቅድንካ ሰጅቴ’ እ ጋይሳን ኦሎ? ኮዘንካ ስግዳን ርንከስም አክ ሰተራዬ ጋይሴ። <verse eid="JHN 1:50"/><verse number="51" style="v" sid="JHN 1:51"/>ዶፈን፥ ዶፈን የም ጋይድቴ፥ ጭላ ፎችምድንካ ሳብታ ክታ ይንችነረ ኤድ ይንችንታ ዘን ዉድንኬ Ꮊንቸርድንካ ሰተረቴ ጋይሴ”።<note caller="-" style="x"><char style="xo" closed="false">1፡51 </char><char style="xt" closed="false"><ref loc="GEN 28:12">ፍዝ. 28፡12</ref>። </char></note><verse eid="JHN 1:51"/></para>
  <chapter eid="JHN 1"/>
  <chapter number="2" style="c" sid="JHN 2"/>
  <para style="s1">የሱስ ቃና ገሊላ እሰናር ክታ Ꮊፍርና</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1"/>ማክምስ ሰጨንካ፥ ገሊላ ፍጫር Ꮊፈርድን ቃና ጋይምድን ካተመናር እሳ ዶቅድንካ የሱሰታ እንደነረ ኮታር Ꮊቄ። <verse eid="JHN 2:1"/><verse number="2" style="v" sid="JHN 2:2"/>የሱሰኬ ክታ ካርንካ ጎርስምድባብከስካ እሴናር ኤልምታ Ꮊቀኬ። <verse eid="JHN 2:2"/><verse number="3" style="v" sid="JHN 2:3"/>እሳ እችምንዘን ዎጨርድንዳ ዎይንና በእሳንደትካ የሱሰታ እንደና የሱሰም፥ “ዎይን ዎጭምና ከደር በእቴ!” ና ጋይሴ። <verse eid="JHN 2:3"/><verse number="4" style="v" sid="JHN 2:4"/>የሱሰረ “እስታ እንደኖ! የስካ ክክን Ꮊራ ሪ እስታ ዶቅዳ? እስታ ሰጨና አክ የላክዬ” ኮደረ ጋይሴ።<verse eid="JHN 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5"/>ኮታይካ እንደና ዋር ዶቅድን ፍክስንባብከስም፥ “ክት የም ጋይድን ሙዳ ይከቴ” ከትም ና ጋይሴ።<verse eid="JHN 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6"/>አይሁድንከስታ አርንንታ ዎጋ ከታ Ꮊቃንጎካ ላ ጎላ ዳሀ ኮታር Ꮊቀኬ፥ ዋልቃ ዋልቃ ጎላ ዳሄንከስ ቃስተን አነረ ማከን ዳሀካ ሎቃ የድንዳ Ꮊቄ። <verse eid="JHN 2:6"/><verse number="7" style="v" sid="JHN 2:7"/>የሱስ ፍክስንባብከስም “ጎላ ዳሄንከስም ሎቃ ጮችከቴ” ከትም ጋይሴ፥ ከተረ ዳሄንከስካ ሙዳ ጮችሰኬ። <verse eid="JHN 2:7"/><verse number="8" style="v" sid="JHN 2:8"/>ኮታ ቡር የሱስ ፍክስንባብከስም፥ “አልቀንባብከስም ይና ታ ዱቅሰቶ ኤሄንባብካንታ እምከቴ” ከደር ጋይሴ፥ ከተረ ክትካንታ እምሰኬ። <verse eid="JHN 2:8"/><verse number="9" style="v" sid="JHN 2:9"/>አልቀንባብከስም ክድባብ ዎይን ዎጭምና ኦክምሳን ሎቀንም አፍሳንደትካ፥ Ꮊብርንካ Ꮊዳናንከረ ኤሳክዬ፥ ሎቀን ቆልእስባብ አልቀንባብከስ ማቼ ኤዝድ Ꮊቀኬ፥ ኮካንታ እችንባብከስታ ክተንባብ፥ እሰንባብም ኤልሶ፥ <verse eid="JHN 2:9"/><verse number="10" style="v" sid="JHN 2:10"/>“ኤድ ሙደና እርምሶ እምድንዳ ኡርማ ዎይን ዎጭምኔ፥ ኤልምስባብከስ ዎጫንደታ ቡር ሎቅዳክንደትም እምዴ፥ የና ማቼ ኡርማ ዎይን ዎጭምን ታ የለልታ ዶቅሰዬ ጋይሴ።”<verse eid="JHN 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11"/>የሱስ ኮም አታ ቃዉታ ሙደንታ እርንዳ ማቻን አታ ቃዉተን ገሊላ ፍጫ ቃና ካተመናር ይሴ፥ ኮግንደካ ይንታ ቦንቸንም መያ ማስሴ፥ ክታ ካርንካ ጎርስምድባብከሰረ ክትካ አመንሰኬ።<verse eid="JHN 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12"/>ኮታ ቡር የሱስ ይንታ እንደንኬ ይንታ እስመንከስካ፥ ክታ ካርንካ ጎርስምድባብከስከረ ክክን ቅፍረናሆም ካተመናር Ꮊንቸርሴ፥ ኮታረረ ቶክም ሰጫ ዶቅሰኬ።<note caller="-" style="x"><char style="xo" closed="false">2፡12 </char><char style="xt" closed="false"><ref loc="MAT 4:13">ማቶ. 4፡13</ref>። </char></note><verse eid="JHN 2:12"/></para>
  <para style="s1">የሱስ ሳብታ ጭል ኤሄናር ጋበን ጋብድባብከስም ዉችና</para>
  <para style="r">(<ref loc="MAT 21:12-13">ማቶ. 21፡12-13</ref>፤ <ref loc="MRK 11:15-17">ማር. 11፡15-17</ref>፤ <ref loc="LUK 19:45-46">ሉቃ. 19፡45-46</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13"/>አይሁድንከስታ ፋስጋ ባአል የልሳንኦል የሱስ የሩሳሌማር አይሴ፥<note caller="-" style="x"><char style="xo" closed="false">2፡13 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">ዉት. 12፡1-27</ref>። </char></note> <verse eid="JHN 2:13"/><verse number="14" style="v" sid="JHN 2:14"/>ሳብታ ጭል ኤሄናረረ ገዝምንከስም፥ ቆልንከስምኬ ዎለንከስም ሰንድባብከስምኬ ብረን ኦካኦንግድባብከስ ዶቅሶ ከት ጋበን ጋብድንካ Ꮊፍሴ። <verse eid="JHN 2:14"/><verse number="15" style="v" sid="JHN 2:15"/>ኮታይᎺካ ዝራፍ ምርስንደትከ ኤድንከስም ሙዳ፥ ቆልንከስምኬ ገዝምንከስምካ ክክን ሳብታ ጭል ኤሄናርንካ ከትም ዉችሴ፥ ብረን ኦግድባብከስመረ ብረን ከታ ይጭሴ፥ ከታ ገበትንከስመረ ባልት ኦይቼ። <verse eid="JHN 2:15"/><verse number="16" style="v" sid="JHN 2:16"/>ዎለን ሰንድን ኤድንከስመረ “ኮም ሙዳ ኦስ ተይከቴ! እስታ ባበንታ ኤሄን የንታ ዛለታ ኤሀ Ꮊይማሰቴ!” ከደር ጋይሴ። <verse eid="JHN 2:16"/><verse number="17" style="v" sid="JHN 2:17"/>ኮታይካ ክታ ካርንካ ጎርስምድባብከስ “የስታ ኤሄንጎካ እስታ ዶቅድን ቀምስና እም አተርዝዴ” ጋይምሶ ጻፍምሳን ገቀርሰኬ።<note caller="-" style="x"><char style="xo" closed="false">2፡17 </char><char style="xt" closed="false"><ref loc="PSA 69:9">የቺ 69፡9</ref>። </char></note><verse eid="JHN 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18"/>ኮታ ቡር አይሁድንታ ገችንታ ኤረንባብከስ የሱሰም፥ “የና ኮም ይካንታ ገችታ ኤራ የስታ ዶቅድንደትም Ꮊረስ ቃዉታ ማድን አተን ዎካንታ ሰጅዳ?” ክደረ ጋይሰኬ።<verse eid="JHN 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19"/>የሱሰረ “ኮም ሳብታ ጭል ኤሄንም የታ ዉልእከቴ፥ እታ ማከን ሰጨካ ማስት ዎድቴ” ኖ ከደር ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">2፡19 </char><char style="xt" closed="false"><ref loc="MAT 26:61">ማቶ. 26፡61</ref>፤ <ref loc="MAT 27:40">ማቶ. 27፡40</ref>፤ <ref loc="MRK 14:58">ማር. 14፡58</ref>፤ <ref loc="MRK 15:29">ማር. 15፡29</ref>። </char></note><verse eid="JHN 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20"/>ከተረ “ኮም ሳብታ ጭል ኤሄን ዎድካንታ ቃስተን ቦንደከ ላ ስላ በይስቴ፥ ይና የና ማከን ሰጨታ ዋር ዎትራ?” ክደረ ጋይሰኬ።<verse eid="JHN 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 2:21"/>የሱስ ማቼ “ሳብታ ጭል ኤሄን” ጋይሶ ክት ኬዛንዳ ይንታ ኤደትቸንጎኬ። <verse eid="JHN 2:21"/><verse number="22" style="v" sid="JHN 2:22"/>ኮካንታ የሱስ ደእናርንካ ክት አምሳንደትᎺይካ ክታ ካርንካ ጎርስምድባብከስ ኮም ከዝድ ክት Ꮊቃንደትም ገቀርሰኬ፥ ኮጎካ ጭል ማጻፍናር ጻፍምሳንደትምኬ የሱስ ኬዛን ቃለን አመንሰኬ።<verse eid="JHN 2:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23"/>የሱስ ፋስጋ ባአልንᎺይካ የሩሳሌማር ዶቅድዮ ክት ይያቃን ቃዉተንከስም ሰድንተንካ በድ ኤድንከስ ክትካ አመንሰኬ። <verse eid="JHN 2:23"/><verse number="24" style="v" sid="JHN 2:24"/>የሱስ ማቼ ኤድንከስም ሙዳ ኤዝድ ይ Ꮊቃንኦል ከትም አመናክዬ፥ <verse eid="JHN 2:24"/><verse number="25" style="v" sid="JHN 2:25"/>ኖ ኤታ ቡዳር ዶቅድንደትም ሙዳ ኤዝድ ይ Ꮊቃንኦል ኤድጎካ Ꮊየነረ ክትካንታ ኬዝድንግንዳ ዝክሳዬ።<verse eid="JHN 2:25"/></para>
  <chapter eid="JHN 2"/>
  <chapter number="3" style="c" sid="JHN 3"/>
  <para style="s1">የሱሰኬ ንቀድሞሰካ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1"/>ንቀድሞስ ጋይምድባብ ዋልቃ ኤች Ꮊቄ፥ ኖ ፈርሳዊያንንከስታ ኮች ማችባብ አይሁድንከስም ክድባብ Ꮊቄ። <verse eid="JHN 3:1"/><verse number="2" style="v" sid="JHN 3:2"/>ኮና ኤችና ገልትገር የሱሰደር Ꮊድሶ፥ “ኤስስንባቦ፥ ሳብ ክትካ ክክን ማታክን የለልታ ከናከስም የስ ይድንደትም ቃዉተንከስም ይይካንታ ማድባብ Ꮊየሰነረ ካዬ፥ ኮካንታ የና ሳብታ ላማርንካ Ꮊድባብ ኤስስንባብ የስ ማቻንደትም ዎታ ኤዝዶቴ” ክደረ ጋይሴ።<verse eid="JHN 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3"/>የሱሰረ “ዶፈን፥ ዶፈን እታ የስም ጋይድቴ፥ ኤድ አናካርንካ አጥማክንዳ ማቼ ሳብታ ባንችምን ሰድንካንታ ማታዬ” ክደረ ጋይሴ።<verse eid="JHN 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4"/>ንቀድሞሰረ “ይና፥ ኤድ ይ ዶንጀርሳንደታ ቡር Ꮊስግንዳ አጥርካንታ ማዳ? ቃስትምስ ይንታ እንደንታ ሳቅምናር አርድሶ አጥርካንታ ማዶ?” ጋይሶ ኦይሴ።<verse eid="JHN 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5"/>የሱሰረ፥ “ዶፈን፥ ዶፈን ጋይድቴ፥ ኤድ ሎቀዘንኬ አያን ጭልንካ አጠራክንዳ ማቼ ሳብታ ባንችምናር አርድካንታ ማታዬ። <verse eid="JHN 3:5"/><verse number="6" style="v" sid="JHN 3:6"/>ኤድዘንካ አጠርምስባብ ኖ ኤድ፥ አያንዘንካ አጠርምስባብ ኖ አያኔ። <verse eid="JHN 3:6"/><verse number="7" style="v" sid="JHN 3:7"/>ኮካንታ ‘ቃስትምስ አጥር የም ዝግዝዴ’ እ የስም ጋይሳንደትካንታ Ꮊይ በርኤ። <verse eid="JHN 3:7"/><verse number="8" style="v" sid="JHN 3:8"/>ዞጋ ይ ዝግዛንደትጎካ ዞግዴ፥ ኡፍስንም ኤሰርደዬ፥ ኬዛር ማቼ Ꮊብርንካ ኮት Ꮊዳናንከረ Ꮊብር ኮት አይዳናንከረ ኤዝዳከዬ፥ አያንዘንካ አጠርምስባብ ሙደና ኮግንዴ ጋይሶ ማስሴ።”<verse eid="JHN 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9"/>ንቀድሞሰረ “ኮና Ꮊስግንዶክ ማትካንታ ማዳ?” ጋይሶ ክደረ ኦይሴ።<verse eid="JHN 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10"/>የሱሰረ፥ “የና እስራኤልታ ኤስስንባብ ማትሰዮ ኮም ኤዝዳካ? <verse eid="JHN 3:10"/><verse number="11" style="v" sid="JHN 3:11"/>ዶፈን፥ ዶፈን እታ የስም ጋይድቴ፥ ዎ ኤዝድንደትም ኬዝዶቴ፥ ዎ ሰዳንደትመረ ማርከርዶቴ፥ የታ ማቼ ዎንታ ማርክርን ተይዳከቴ። <verse eid="JHN 3:11"/><verse number="12" style="v" sid="JHN 3:12"/>ፍጨዘንደት ርም የም ዎ ኬዝድንካ አሜንዳክባብ የ ማቼ ጭላር ሪንጎካ እ የም ኬዝድንካ Ꮊስግንደንት አመንዳ? <verse eid="JHN 3:12"/><verse number="13" style="v" sid="JHN 3:13"/>ጭላርንካ Ꮊንቼርስባብ ኤድ ይንችዘንካ አብ ጭላር አይስባብ Ꮊየነረ ካዬ ጋይሶ ክትካንታ ማስሴ።<note caller="+" style="f"><char style="fr" closed="false">3፡13 </char><char style="ft" closed="false">ጭላርንካ Ꮊንቸርስባብ ኤድ ይንችዘንካ ጭላር አይስባብ Ꮊየነረ ካዬ። ጭላር ዶቅድባብ ኤድ ይንችዘንካ አብ ኮም ጋይድባብከስ ዋልቃ ዋልቃ ኤና እር ጻፍምሳንዳ ንከሳር ዶቅዴ </char></note><verse eid="JHN 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 3:14"/>“ሙሳ ዴል ቆቸናር ጉንንም ጬክሳ ይይሶ ክት ሮክሳንደትግንዳ ኮትኮግንደረ ኤድ ይንች ጬክን ጋይሶ ሮክር ክትም ዝግዝዴ።<note caller="-" style="x"><char style="xo" closed="false">3፡14 </char><char style="xt" closed="false"><ref loc="NUM 21:9">ፋይ. 21፡9</ref>። </char></note> <verse eid="JHN 3:14"/><verse number="15" style="v" sid="JHN 3:15"/>ኮነረ ማድንዳ ክትካ አሜንድባብ ሙዳ ስለንክንደታ ዶቅንት Ꮊብድንግንዴ።<verse eid="JHN 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 3:16"/>“ክትካ አሜንድባብ ሙዳ ስለንካ ዶቅንት ዶቅድንግንዳ ዳት ከት ካይዳክንግንዳ ሳብ ፍጫ ሙደን አንድር ሶልምሳንካንታ ዋልቃ ይንታ ይንችንም እምሴ። <verse eid="JHN 3:16"/><verse number="17" style="v" sid="JHN 3:17"/>ሳብ ይንታ ይንችን ፍጫሙደንዘን ክት ኦይቻንዳ፥ ፍጫ ሙደና ክታ ይንችንካ አቅድንግንዳ ዳት ፍጫሙደንዘን ፋረድካንታ ካዬ።<verse eid="JHN 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 3:18"/>“ክትካ አመንድባብዘን ፋረድማዬ፥ ክትካ አሜንዳክባብ ማቼ ዋልቀን ሳብታ ይንችንካ አመናክንካንታ እርምሶ ክታዘን ፋረድምቴ።<verse eid="JHN 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 3:19"/>“ፊረድነረ ኮኔ፥ ሳክመና ፍጫሙደንዘን Ꮊዴ፥ ኤድንከስ ማቼ ከታ ፍክስና ዳቅል ማቻን ኦል ሳክመንዘንካ ስግስሶ ኡምንም ሶልምሰኬ። <verse eid="JHN 3:19"/><verse number="20" style="v" sid="JHN 3:20"/>ዳቅል ሪን ይድባብ ሙደና ሳክመንም ቦዝዴ፥ ዳቅል ክታ ፍክስነረ መያ ማዳክንግንዳ ፈንክ ሳክመንደር Ꮊዳየ። <verse eid="JHN 3:20"/><verse number="21" style="v" sid="JHN 3:21"/>ዶፈን ማቻን ርን ይድባብ ማቼ ፈንካ ሳክመንደር Ꮊዴ፥ ሳክመንደር Ꮊድባበረ ክት ይሳን ሪነረ ሳብታ ክተንግንዳ ማትና መየካ Ꮊፈርድንግንዴ።”<verse eid="JHN 3:21"/></para>
  <para style="s1">የሱሰኬ ዮሀንሰካ</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22"/>ኮታ ቡር የሱስ ይንታ ካርንካ ጎርስምድባብከስካ ክክን ይሁዳ ፍጫር አይሴ፥ ኮታረረ ስእሰሮ ከትካ ክክን ቶክም ሰጫካንታ ዶቅሴ። <verse eid="JHN 3:22"/><verse number="23" style="v" sid="JHN 3:23"/>ኮታይካ ዮሀንሰረ በድ ሎቃ ዶቅድንኦል ሳለምታ ባንግር ሄኖን ጋይምድን ካርያር ስእዝድ Ꮊቄ፥ ኤድንከሰረ Ꮊደረኮ ስእረሮ Ꮊቀኬ። <verse eid="JHN 3:23"/><verse number="24" style="v" sid="JHN 3:24"/>ኮታይካ ዮሀንስ አክ ዞከራክ Ꮊቄ።<note caller="-" style="x"><char style="xo" closed="false">3፡24 </char><char style="xt" closed="false"><ref loc="MAT 14:3">ማቶ. 14፡3</ref>፤ <ref loc="MRK 6:17">ማር. 6፡17</ref>፤ <ref loc="LUK 3:19-20">ሉቃ. 3፡19-20</ref>። </char></note><verse eid="JHN 3:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25"/>ኮታይካ ዮሀንሰታ ካርንካ ጎርስምድባብከሳርኬ አይሁድንታ ዎክያር አርንንታ ዎገንጎካ በርም አምሴ።<note caller="+" style="f"><char style="fr" closed="false">3፡25 </char><char style="ft" closed="false">አይሁድንከስካ ጋይድንደና ኤና እር ጻፍምሳናር መራ አይሁድንከስ ጋይደኬ። </char></note> <verse eid="JHN 3:25"/><verse number="26" style="v" sid="JHN 3:26"/>ዮሀንሰታ ካርንካ ጎርስምድባብከስ ዮሀንሰደር Ꮊድሶ “ኤስስንባቦ፥ ኖ ኦኮና ዮርዳኖስ ሎቀንታ ፋማ የስካ ክክን ኖ Ꮊቅባብ፥ የና ክትካንታ የስ ማርከርስባብ፥ ይና፥ ኖ ስእዝዴ፥ ኤድንከሰረ ሙዳ ክደር አይደኬ” ክደረ ጋይሰኬ።<verse eid="JHN 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27"/>ዮሀንሰረ፥ “Ꮊየነረ ኤድ ሳብ ከትካንታ እማክናና Ꮊራ ሪየረ ክታ ዶቃዬ፥ <verse eid="JHN 3:27"/><verse number="28" style="v" sid="JHN 3:28"/>‘ክታ ኤና እር ኦይትምትት ዳት እታ ሳይምስባብ ካይቴ’ ጋይስቶ እ ኬዛንግንዳ የታ የንታ ማታርንካ ማርከቴ።<note caller="-" style="x"><char style="xo" closed="false">3፡28 </char><char style="xt" closed="false"><ref loc="JHN 1:20">ዮሀ. 1፡20</ref>። </char></note> <verse eid="JHN 3:28"/><verse number="29" style="v" sid="JHN 3:29"/>ይእድን ይንቸንና ዶቅድባብ ኤችና ኖ እንቼንባቤ፥ እንቼንባብታ ላኮይትና ማቼ እንቼንባብታ ላማር ዎእሶ ኤሰረሮ ክትምዴ፥ ክተረ ኡፍስን ኤስርካ ኖ ጉርምዴ፥ ኮካንታ እስተረ ጉርምና ኮኔ፥ ኖየረ ታ ቦድማ ማቴ። <verse eid="JHN 3:29"/><verse number="30" style="v" sid="JHN 3:30"/>ኖ ጬክ ጬክ ጋይ ክትም ዝግዝዴ፥ እታ ማቼ ይርክ ይርክ ጋይ እም ዝግዝዴ ጋይሶ ማስሴ።”<verse eid="JHN 3:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31"/>ፈይንካ Ꮊድባብ ሙደንዘንካ ስግዬ፥ ፍጨዘንካ ማችባብ ፍጨቴ፥ ፍጨትንደት ሪመረ ኬዝዴ፥ ፈ ጭላርንካ Ꮊድባብ ሙደንዘንካ ስግዬ። <verse eid="JHN 3:31"/><verse number="32" style="v" sid="JHN 3:32"/>ኖ ይ ሰጃንደትምኬ ይ ኤሰርሳንደትም ማርከርዴ፥ ኬዛር ማቼ ክታ ማርከርንም ተይድባብ ካዬ። <verse eid="JHN 3:32"/><verse number="33" style="v" sid="JHN 3:33"/>ክታ ማርክርንም ተይድባብ ማቼ ሳብ ዶፈን ማትንተን ዳቅዝዴ። <verse eid="JHN 3:33"/><verse number="34" style="v" sid="JHN 3:34"/>ሳብ ይንታ አያንን ክት እምድንዳ የርክስት ማታክንካንታ ሳብ ኦይችባብ ሳብታ ቃለን ኬዝዴ።<verse eid="JHN 3:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 3:35"/>ሳብ ባበና ይንታ ይንችን ሶልምደ፥ ሙዳ ሪመረ ክታ አንያር እምቴ።<note caller="-" style="x"><char style="xo" closed="false">3፡35 </char><char style="xt" closed="false"><ref loc="MAT 11:27">ማቶ. 11፡27</ref>፤ <ref loc="LUK 10:22">ሉቃ. 10፡22</ref>። </char></note> <verse eid="JHN 3:35"/><verse number="36" style="v" sid="JHN 3:36"/>ሳብ ይንችንካ አሜንድባብ ስለንክንደታ ዶቅንት ዶቅዴ፥ ሳብ ይንችንካ አሜንዳክባብ ማቸ ሳብታ ዋጭና ክታዘን ዶቅተሬ ዳት ዶቅንትን Ꮊፋዬ።<verse eid="JHN 3:36"/></para>
  <chapter eid="JHN 3"/>
  <chapter number="4" style="c" sid="JHN 4"/>
  <para style="s1">የሱሰኬ ሳማራ ኤተንካ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1"/>ኮታይካ የሱስ ዮሀንሰዘንካ ስግ በድ ኤድንከስም ይንታካርንካ ጎርስምድባብከስ ማዝድንደትምኬ ክት ስእዝድንደትም ፈረሳዊያንንከስ ኤሰርሰኬ፥ <verse eid="JHN 4:1"/><verse number="2" style="v" sid="JHN 4:2"/>ማችንከረ ስእዝድ Ꮊቅባብከስ ክታ ካርንካ ጎርስምድባብከስ ዳት ኖ ይንታ ማታርካ ስእሳክዬ። <verse eid="JHN 4:2"/><verse number="3" style="v" sid="JHN 4:3"/>ክትጎካ ጋይምሳንደትም ፈረሳዊያንንከስ ኤሰርሳንደትም ይ ኤሳንደትካ የሱስ ይሁዳ ፍጨንም ዛቅሶ ኦስ ገሊላር ማት አይሴ። <verse eid="JHN 4:3"/><verse number="4" style="v" sid="JHN 4:4"/>ኮታር አይድዮ ሳማርያ ጎካ ስግና ክታ ነገዳክንዳ ማቼ።<verse eid="JHN 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 4:5"/>ኮካንታ ያይቆብ ይንታ ይንችን ዮሴፍ ካንታ እምሳን ካርንታ ላማር Ꮊፈርድን፥ ስካር ጋይምሶ ኤልምድን ሳማርያ ካተመናር Ꮊዴ።<note caller="-" style="x"><char style="xo" closed="false">4፡5 </char><char style="xt" closed="false"><ref loc="GEN 33:19">ፍዝ. 33፡19</ref>፤ <ref loc="JOS 24:32">ኢያ. 24፡32</ref>። </char></note> <verse eid="JHN 4:5"/><verse number="6" style="v" sid="JHN 4:6"/>ኮታረረ ያይቆብታ ጎር ሎቃ Ꮊቄ፥ የሱስ ጎግ ሙክንትዘንካ አምሳንዳ ጋፍሶ ጎር ሎቀንታ ባንግር ዶቅሴ፥ ሰጨነረ ቶምራ ላ ሳዓት ማታባብ Ꮊቄ።<verse eid="JHN 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7"/>ኮታይካ ዋልቀንዳ ሳማርያ ፍጫ ኤተን ሎቀን ቆልእካንታ ጎርንደር ና Ꮊዴ፥ የሱሰረ “ሎቃ እም ዎእስካ!” ኮደር ጋይሴ። <verse eid="JHN 4:7"/><verse number="8" style="v" sid="JHN 4:8"/>ኮታይካ ክታ ካርንካ ጎርስምድባብከስ እችም ሰንማካንታ ካተማ አይተክ ዶቆ። <verse eid="JHN 4:8"/><verse number="9" style="v" sid="JHN 4:9"/>ና ኮነረ ሳማራ ኤተና የሱሰም፥ “የና አይሁታ ኮች ማደዮ Ꮊስግንደስ እ ሳማረንደር ‘ሎቃ እም ዎእስካ!’ ጋይሰዮ እም ኦይዝዳ?” ና ጋይሴ፥ ኮም ኮታ ጋይና፥ አይሁድንከስ ሳማርያ ኤድንከስካ ክክን ከት ኡራይንካንቴ።<note caller="-" style="x"><char style="xo" closed="false">4፡9 </char><char style="xt" closed="false"><ref loc="EZR 4:1-5">ዕዝ. 4፡1-5</ref>፤ <ref loc="NEH 4:12">ነህ. 4፡12</ref>። </char></note><verse eid="JHN 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10"/>የሱሰረ “ሳብታ ዉች እምንተኬ ‘ሎቃ እም ዎእስካ!’ የስም ጋይድባብ Ꮊይ ክት ማቼረ የስ ኤስታ ናና፥ ክትም ምክስ ዝግዝድንዳ የስም ዶቆ፥ ኖየረ ዶቅንት ሎቀን የስም እምዳ ዶቆ” ኮደር ጋይሴ።<verse eid="JHN 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11"/>ናየረ፥ “ባቦ! የስታ ቆልእንዳ ካዬ፥ ጎርነረ ጩልጩልዬ፥ ይና፥ ዶቅንት ሎቀንም የና Ꮊብርንከስ Ꮊፍተራ? <verse eid="JHN 4:11"/><verse number="12" style="v" sid="JHN 4:12"/>የና ኮም ጎርን ዎም እምስባብ ዎንታ ባቤን ያይቆብዘንካ ስገዳ? ክትኬ ክታ ይንችንኬ፥ ክታ ቆልመንከሰረ ኮትኮ ጎር ሎቀናርንካ ዎጭተኬ ኩንጋየሮ ክደር ማስሴ።”<verse eid="JHN 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13"/>የሱሰረ፥ “ኮ ሎቀናርንካ ዎጭድባብ ሙደና አናካርንካ ዎቸርዴ፥ <verse eid="JHN 4:13"/><verse number="14" style="v" sid="JHN 4:14"/>እ እምድን ሎቀን ዎጭድባብ ስለንክንደታ ቦድሶ ዎቸራዬ፥ እ እምድን ሎቀን ዎጭድባብ ኤድ ስለንክንደት ዶቅንትታ ፉእድን ሎቀታ ቱት ማተረ ኩንጋየሮ ኮደር ማስሴ።”<verse eid="JHN 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15"/>ኤተነረ “ባቦ! ይና ኮዘንካ ኦስ ሎቃ እስታ ቡዳ ዎቻይንግንደኬ ካረረ ቆልእካንታ እ Ꮊዳክንግንዳ ዋደ ኮግንዳ ሎቀን እካንታ እምካ!” ና ጋይሴ።<verse eid="JHN 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16"/>የሱሰረ “አይሳዮ የስታ ክእስንም ኤልት Ꮊትካ” ኮትም ጋይሴ።<verse eid="JHN 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17"/>ኤተነረ “ክእስ እስታ ካዬ” ጋየሮ ና ማስሴ፥</para>
  <para style="p" vid="JHN 4:17">ኮታይካ የሱስ፥ “ክእስ እስታ ካዬ ጋይንተና ገቴ፥ <verse eid="JHN 4:17"/><verse number="18" style="v" sid="JHN 4:18"/>ዶንቅ የስታ ክእስንከስ ዶቅደኬ፥ ታየረ የስካ ክክን ዶቅድባብ ኤችና የስታ ክእስ ካዬ፥ ኮካንታ ዶፈንን የና ከዝተዬ” ኩን ኮትም ጋይሴ።<verse eid="JHN 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19"/>ኤተነረ፥ “የባቦ! የና ሳብዘንካ ኤሰርሶ ኬዝድባብ የስ ማቻን ታ እታ ኤሳቴ፥ <verse eid="JHN 4:19"/><verse number="20" style="v" sid="JHN 4:20"/>ዎንታ ባበንከስ ኮ ገቼንዘን ጎስትሰኬ፥ የታ ማቼ ‘ኤድንከስ ጎስት ከትም ዝግዝድንዳ የሩሳለማረ’ የታ ጋይደቴ” ኩን ና ጋይሴ።<verse eid="JHN 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21"/>የሱሰረ ኮትም፥ “የና ኤተኖ፥ ኮ ገቼንዘን አነረ የሩሳሌማር ሳብ ባበንካንታ የ ጎዝዳክንደታ ሰጫ Ꮊድንደትም የና እንካ አሜንካ፥ <verse eid="JHN 4:21"/><verse number="22" style="v" sid="JHN 4:22"/>የታ የ ኤዝዳክን ጮይስንካንታ ጎዝደቴ፥ ዎታ ማቼ አቅንታ Ꮊድንዳ አይሁድዘንካ ማቻንኦል ዎ ኤዝድን ጮይስንካንታ ጎዝዶቴ። <verse eid="JHN 4:22"/><verse number="23" style="v" sid="JHN 4:23"/>ኬዛር ማቼ ዶፈንካ ክትም ጎዝድባብከስ፥ ሳብ ባቤንካንታ አያንካ ማትስንደትኬ ዶፈንካ ከት ጎዝድን ሰጫ Ꮊዴ፥ ታየረ Ꮊቴ፥ ሳብ ባቤነረ ክት ዝግድንዳ ኮግንደካ ክትም ጎዝድባብሜ። <verse eid="JHN 4:23"/><verse number="24" style="v" sid="JHN 4:24"/>ሳብ አያነረ፥ ክትም ጎዝድባበረ አያንካ ማትስንደትኬ ዶፈንካ ክትካንታ ጎስት ከትም ዝግዝዴ ኮትም ኩን ጋይሴ።”<verse eid="JHN 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25"/>ኤተነረ “ክርስቶስ ጋይምድባብ ሳይምስባብ Ꮊድንደትም ኤዝድቴ፥ ኖ Ꮊድሶ ሙዳ ሪይንም ዎካንታ ኬዝዴ” ና ጋይሴ።<verse eid="JHN 4:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26"/>የሱሰረ “ኮሰዳ! ታ ኮ የስም ከስዝድባብ እትቴ” ኮደር ጋይሴ።<verse eid="JHN 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27"/>ኮታይካ ክታ ካርንካ ጎርስምድባብከስ ይ አይሳንደታርንካ ማት Ꮊደኬ፥ የሱስ ማነካ ክክን ክት ከዝምንካ ከታ በርእሰኬ፥ ማታጋካ ዳት “Ꮊረስ ዝግዳ? አነረ ኮትካ ክክን Ꮊረስ ከዝምዳ?” ጋይሶ ኦይስባብ Ꮊየነረ ካዬ።<verse eid="JHN 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28"/>ኮታ ቡር ኤተና ዳሄንም ዛቅሶ ኦስ ካተመናር አይስንደትኬ ኤድንከስካንታ፥ <verse eid="JHN 4:28"/><verse number="29" style="v" sid="JHN 4:29"/>“እ ፍክሳንደትም ሙዳ እካንታ ኬዝባብ ኤችን ኮሪ Ꮊድሰቶ ሰድከቴ! Ꮊረንግርካ ኖ ሳይምስባብ ማተርዳቶ?” ና ኩን ጋይሴ። <verse eid="JHN 4:29"/><verse number="30" style="v" sid="JHN 4:30"/>ኤድንከሰረ ካተመናርንካ ዉትሶ የሱሰደር አይሰኬ።<verse eid="JHN 4:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31"/>ኮታይካ ክታ ካርንካ ጎርስምድባብከስ የሱሰም፥ “ኤስንባቦ! ር እችካ” ጋየሮ ክትም ምክሰኬ።<verse eid="JHN 4:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32"/>ኖ ማቼ፥ “የ ኤዝዳክንዳ እ እጅድንዳ እችም እስታ ዶቅዴ” ከደር ጋይሴ።<verse eid="JHN 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33"/>ኮካንታ ክታ ካርንካ ጎርስምድባብከስ፥ “ዋልቃ ኤደረ እችም ክትካንታ ተይᎺታ ዳቶ?” ክክ ጋይሰኬ። <verse eid="JHN 4:33"/><verse number="34" style="v" sid="JHN 4:34"/>የሱሰረ፥ “እስታ እችምና እም ኦይችባብታ ጋይተን ይይንተኬ ክታ ፍክስንም ቦችዬ። <verse eid="JHN 4:34"/><verse number="35" style="v" sid="JHN 4:35"/>የታ ‘አክ ኦይድ አርፍ ነገዴ፥ ኮታ ቡረረ ስክም ለእ ማዴ’ ኩን ጋይደት ካዮ? እታ ማቼ ‘ጬክን ጋይከቴ እስንንከስ ስክም ካንታ የልሳንደትም ሰድከቴ’ እታ የም ጋይድቴ። <verse eid="JHN 4:35"/><verse number="36" style="v" sid="JHN 4:36"/>ስግድባብ ይንታ ናክን ተይዴ፥ ስለንክንደታ ዶቅንት ማድን አፍን ሳንዝዴ፥ ኮካንታ ማዝድባበረ፥ ስክድባብከረ የካ ጉርምደኬ። <verse eid="JHN 4:36"/><verse number="37" style="v" sid="JHN 4:37"/>ኮጎካ ‘ዋልቀና ማዝዴ፥ አብና ስግዴ’ ጋይምሳን ጋይተና ዶፈኔ። <verse eid="JHN 4:37"/><verse number="38" style="v" sid="JHN 4:38"/>እተረ የ ጋፋክንደትም የ ስክድንግንዳ የም ኦይቻቴ፥ አብንከስ ፍክስካ ጋፍሰኬ፥ የታ ማቼ ከታ ጋፍንታ አፍን የንታ ማስሰቴ ኩንጋየሮ ከትካንታ ማስሴ”።<verse eid="JHN 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39"/>ኤተነረ “እ ፍክሳንደትም ሪን ሙዳ እካንታ ኬዜ” ጋይሶ ኮት ማርከርሳንደት ግንዳ ኮትኮ ካተመናርንካ በድ ሳማርያ ኤድንከስ አመንሰኬ። <verse eid="JHN 4:39"/><verse number="40" style="v" sid="JHN 4:40"/>ኮካንታ ሳማርያ ፍጨናር ኤድንከስ የሱሰደር ከት ᎺዳንᎺይካ ከትካ ክክን ክት ዶቅድንግንዳ ክትም ምክሰኬ፥ ኖየረ ቃስተን ሰጫ ዋር ዶቅሴ።<verse eid="JHN 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 4:41"/>ክታ ቃለንጎከረ አብ በድ ኤድንከሰረ ክትካ አመንሰኬ። <verse eid="JHN 4:41"/><verse number="42" style="v" sid="JHN 4:42"/>ኤተንንመረ “ይና ኮዘንካ ክትም ዎ አሜንድንደና የስ ዎም ኬዛን ቃለንካ Ꮊክ ማታክናና ዎታ ዎንታ ማታርንካ ዎ ኤሰርሳንካንተኬ ገታ ኖ ፍጫሙደንታ አቅስባብ ማቻንደትም ዎ ኤሳንካንቴ” ኮደር ጋይሰኬ።<verse eid="JHN 4:42"/></para>
  <para style="s1">የሱስ ዶርምስባብታ ይንችን ፋችና</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43"/>የሱስ ሳማርያር ቃስተን ሰጫ ዶቅሳንደታ ቡር ገሊላር አይሴ። <verse eid="JHN 4:43"/><verse number="44" style="v" sid="JHN 4:44"/>ኖይንታ ማታርንካ “ሳብዘንካ ኤሰርሶ ኬዝድባብ ይንታ ገታ ፍጨንዘን ቦንችማዬ” ጋይሶ ከስታ Ꮊቄ።<note caller="-" style="x"><char style="xo" closed="false">4፡44 </char><char style="xt" closed="false"><ref loc="MAT 13:57">ማቶ. 13፡57</ref>፤ <ref loc="MRK 6:4">ማር. 6፡4</ref>፤ <ref loc="LUK 4:2">ሉቃ. 4፡2</ref>። </char></note> <verse eid="JHN 4:44"/><verse number="45" style="v" sid="JHN 4:45"/>ኬዛር ማቼ ገሊላር ክት የልሳንደትካ ገሊላ ኤድንከስ ኡርመካ ክትም ሞክሰኬ፥ ኮነረ ይይምሳንዳ ፋስጋ ባአልንካንታ የሩሳሌማር ክት አይሶ Ꮊቃንደትካ ክት ኮታር ይሳንደትም ሙዳ ከታ ይ ሰጃንካንቴ።<note caller="-" style="x"><char style="xo" closed="false">4፡45 </char><char style="xt" closed="false"><ref loc="JHN 2:23">ዮሀ. 2፡23</ref>። </char></note><verse eid="JHN 4:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46"/>ኮታ ቡር የሱስ ሎቀንም ዎይን ዎጭም ማስሶ ክት ኦክሳን ገሊላ ፍጫር Ꮊፈርድን ቃና ካተመናር አናካርንካ ማቼ፥ ኮትᎺይካ ቅፍራናሆማር ክታ ይንች ሰቀርስባብ ዋልቃ ባንችንታ ዶርምስባብ Ꮊቄ።<note caller="-" style="x"><char style="xo" closed="false">4፡46 </char><char style="xt" closed="false"><ref loc="JHN 2:1-11">ዮሀ. 2፡1-11</ref>። </char></note> <verse eid="JHN 4:46"/><verse number="47" style="v" sid="JHN 4:47"/>ኖየረ የሱስ ይሁዳ ፍጨናርንካ ገሊላር ክታ Ꮊድንም ኤሰርሶ ክደር አይሴ፥ ቅፍራናሆማር ክት Ꮊንቸርድንግንደኬ ዘና ሰቀርሶ ደእካንታ የልስባብ ይንችንም ክትካንታ ፋችዝድንግንዳ የሱሰም ምክሴ። <verse eid="JHN 4:47"/><verse number="48" style="v" sid="JHN 4:48"/>የሱሰረ “የታ አተንምኬ በርእዝድ ር የ ሰዳክንዳ ማቼ Ꮊረሰነረ የታ አመንዳከቴ!” ክትም ጋይሴ።<verse eid="JHN 4:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49"/>ኖ ዶርምስባብነረ “የባቦ! እስታ ይንችና ደእተርንደታ እር ዋደ ሳነካ Ꮊትካ” ጋይሴ።<verse eid="JHN 4:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50"/>የሱሰረ “የስታ ኤር አይካ! የስታ ይንችና ሰንፔካ ዶቅተሬ” ክደር ጋይሴ።</para>
  <para style="p" vid="JHN 4:50">ኤችነረ የሱስ ኬዛንደትም ቃለን አሜንሶ ይንታ ኤሪ አይሴ። <verse eid="JHN 4:50"/><verse number="51" style="v" sid="JHN 4:51"/>ክት አይድንከረ ፍክስንባብከስ ጎግያር ክትም Ꮊፍስንደትከ “የስታ ይንችና ፋጭቴ” ጋይሶ ክደር ኬዘኬ።<verse eid="JHN 4:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 4:52"/>ኖየረ ይንችና ኡርማ ክት ማቻን ሳዓትን ከትም ኦይሴ። ከተረ “ናካ ታብዛ ሳዓትንዘን ዘና ሶልና ክትም ዛቅሴ” ጋይሰኬ። <verse eid="JHN 4:52"/><verse number="53" style="v" sid="JHN 4:53"/>ባበነረ የሱስ “የስታ ይንችና ሰንፔካ ዶቅተሬ” ጋይሳንደረ ኮትኮ ሳዓትንዘን ማቻን ኖ ኤሴ፥ ኮካንታ ኮትኮ ሰጨንዘንካ የድሶ ክትኬ ኤር ኤድንካ ሙዳ የሱሰም አመንሰኬ።<verse eid="JHN 4:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54"/>ኮና አታ ቃዉተና የሱስ ይሁዳርንካ ገሊላር Ꮊድሶ ክት ይሳንዳ ቃስትምስ አታ ቃዉቴ።<verse eid="JHN 4:54"/></para>
  <chapter eid="JHN 4"/>
  <chapter number="5" style="c" sid="JHN 5"/>
  <para style="s1">የሱስ ዋልቃ ዎብ ኤችን ፋችና</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1"/>ኮታ ቡር አይሁድንከስታ ባአል ማቻንኦል የሱስ የሩሳሌማር አይሴ። <verse eid="JHN 5:1"/><verse number="2" style="v" sid="JHN 5:2"/>የሩሳሌማር ቆልንከስታ ፍልተንታ ባንግር፥ እብራይስጥ አፈካ በቴሳይዳ ጋየርድንዳ ዋልቃ ከርምሳን ቱት ሎቃ Ꮊቄ፥ ኮታ ካንተንከረ ዶንቅ ኮታዘን ጉፍና ዶቅድንዳ ስገርድንዳ Ꮊቀኬ።<note caller="+" style="f"><char style="fr" closed="false">5፡2 </char><char style="ft" closed="false">በቴሳይዳ ጋይድንደትም ዋልቃ ዋልቃ ኤና ጻፈርሳንዳ በቴ ዛታ፥ አብንከሰረ ጉጅሰረ በቴየ ሳይዳ ጋይደኬ ኮታ ቡልነረ ነጋትቸታ ኤሀ ጋይንትዬ። </char></note> <verse eid="JHN 5:2"/><verse number="3" style="v" sid="JHN 5:3"/>[አንድር በድ ሰቀርስባብከስ፥ አፍይ ዝልንከስ ዎከልዎከል ጋይድባብከስኬ ዎብንከስ አይምድን ጎግንዘን እችሶ Ꮊቀኬ። ከታ ከነረ ሎቀንታ ሶክን ካርሰረኮ Ꮊቀኬ፥ <verse eid="JHN 5:3"/><verse number="4" style="v" sid="JHN 5:4"/>ዋልቃ ዋልቃሰጭ ጮይስታ ክታይንችና ኬርምሳን ቱት ሎቀን Ꮊንቸርሶ ሶክሰሮ Ꮊቄ፥ ሎቀን ሶክሳንደታ ቡር እርምሶ ከርምሳን ሎቀናር አርድባብ ክታዘን ዶቅድን Ꮊምን ሰቅምንዘንካ ፋጨሮ Ꮊቄ።]<note caller="+" style="f"><char style="fr" closed="false">5፡4 </char><char style="ft" closed="false">ኤና እር ጻፈርሳንደታር ፋይዳ 3 በእንተንዘንካ አምስሶ ፋይዳ 4 በእንታ የለልታ ዶቅድንደትም ካርን ጉጃየኬ፥ </char></note> <verse eid="JHN 5:4"/><verse number="5" style="v" sid="JHN 5:5"/>ኮታረረ ቦንደኬ ታሜኬ ላማካይ ስላ ሙዳ ሰቀርስባብ ዋልቃ ኤች Ꮊቄ። <verse eid="JHN 5:5"/><verse number="6" style="v" sid="JHN 5:6"/>የሱስ ኮ ኤችን ኮታር ራችንካ ሰድስንደትከ በድ ሰጨዘንካ የድሶ ክታ ሰቅርንም ኤስሶ፥ “አቅካንታ ዝግዳ?” ክትም ጋይሴ።<verse eid="JHN 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7"/>ሰቅምንባበረ “የባቦ! ሎቀና ሶግድናይካ እም ተዮ ከርምሳን ሎቀናር አርጅድባብ ኤድ እስታ ካዬ፥ እ አይትቴ ጋይድንካ አብና እም እርምሶ አርደኬ” ኖ ጋይሴ።<verse eid="JHN 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8"/>የሱሰረ “አምካ! የስታ ሰለንም ባልሰዮ አይካ!” ክትም ጋይሴ። <verse eid="JHN 5:8"/><verse number="9" style="v" sid="JHN 5:9"/>ኤችነረ ሳነካ አቄ፥ ሰለንመረ ባልሶ አይሴ።</para>
  <para style="p" vid="JHN 5:9">ኮነረ ማቻንዳ አይሁድንከስታ Ꮊዉስ ሰጨንካ Ꮊቄ፥ <verse eid="JHN 5:9"/><verse number="10" style="v" sid="JHN 5:10"/>ኮካንታ አይሁድንታ ገችንባብከስ ክትኮ አቃን ኤችን “ታካ Ꮊዉስ ሰጫ ማቻን ኦል ሰለንም የስ ባልድንግንዳ ህግና ጋያዬ” ከታ ጋይሰኬ።<note caller="-" style="x"><char style="xo" closed="false">5፡10 </char><char style="xt" closed="false"><ref loc="NEH 13:19">ነህ. 13፡19</ref>፤ <ref loc="JER 17:21">ኤር. 17፡21</ref>። </char></note><verse eid="JHN 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11"/>ኖ ማቼ “እም አቅስባብ ኤችና የስታ ሰለንም ባልሶ አይካ” እም ጋይቴ ከደር ጋይሴ።<verse eid="JHN 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12"/>ከተረ “የስታ ሰለንም ባልሰዮ አይካ የስም ጋይስባብ Ꮊይራ?” ጋየረኮ ኦይሰኬ።<verse eid="JHN 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13"/>ኤችና ማቼ ዎርሰና በጃን ኦልከ የሱስ ኮታርካ Ꮊርን ጋይሶ አይሳን ኦል ክትም አቅስባብ Ꮊይ ማቼረ ኤሳክ Ꮊቄ።<verse eid="JHN 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14"/>ኮታ ቡር የሱስ ኤችንም ሳብታ ጭል ኤሄናር ክትም Ꮊፍሶ “ኮሰቼ ታ አቅተዬ፥ ኮዘንካ ቦርሳን ር የዘን የልዳክንግንዳ ኮዘንካ ኦስ ጎማ Ꮊይፍክሴ” ኖ ጋይሴ።<verse eid="JHN 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 5:15"/>ኤችነረ አይስንደትከ ክትም አቅስባብ የሱስ ማትንተን አይሁድንታ ገችንባብከስካንታ ኬዜ። <verse eid="JHN 5:15"/><verse number="16" style="v" sid="JHN 5:16"/>ኮም ሪንም አይሁድንከስታ Ꮊዉስ ሰጨንካ ክት ይሳንካንታ አይሁድንከስታ ገችንባብከስ የሱሰም ዳይ የጀኬ። <verse eid="JHN 5:16"/><verse number="17" style="v" sid="JHN 5:17"/>የሱስ ማቼ “እስታ ባቤና ሙዳᎺይካ ፍግዝዴ፥ እተረ ፍግዝድቴ” ጋይሶ ከትካንታ ማስሴ።<verse eid="JHN 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 5:18"/>ኮነረ ጋይንተና አይሁድንከስታ ገችንባብከስ የሱሰም ከት ደይዝድንግንዳ እንድንካ ከትም አምስሴ፥ ኮነረ ማቻንዳ ኖ አይሁድንከስታ Ꮊዉስ ሰጨንክታ ነክስንካ Ꮊክማታክ ናና “ሳብ እስታ ባበኔ” ጋይንተካ ይንታ ማተንም ሳብካ ክክን የክሳን ካንቴ።<verse eid="JHN 5:18"/></para>
  <para style="s1">ሳብ ይንችንታ ገችታ ኤራ</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19"/>የሱሰረ፥ “ዶፈን፥ ዶፈን የም ጋይድቴ፥ ሳብ ባበና ፍግዝድንካ ይ ሰዳንደትም ፍክስዘንካ አብ ሳብ ይንችና ይንታ ገችታ ኤረንካ Ꮊረነረ ፍክስካንታ ማታዬ። ሳብ ባበን ይድንደትም ሳብ ይንችነረ ኮትግንዳ ይዴ። <verse eid="JHN 5:19"/><verse number="20" style="v" sid="JHN 5:20"/>ሳብ ባበና ይንታ ይንችን ሶልምድን ኦል ይ ፍግዝድንደትም ሙዳ ክትካንታ ሰችዝዴ፥ የተረ የ በርእተርንግንዳ ኮዘንካ ስግዳንደትም ፍክስነረ ክትም ሰጅዴ። <verse eid="JHN 5:20"/><verse number="21" style="v" sid="JHN 5:21"/>ሳብ ባቤና ደእስባብከስም አምዝድንግንደኬ ሰምፔም ከትካንታ እምድንግንዳ፥ ሳብ ይንችነረ ኮትኮግንዳ ሰንፓ ዝግድን ኤድካንታ እምዴ። <verse eid="JHN 5:21"/><verse number="22" style="v" sid="JHN 5:22"/>ሳብ ባቤና Ꮊየንዘነረ ፋረዳዬ፥ ኬዛር ማቼ ፍርደንም ሙዳ ይንታ ይንችንካንታ እምቴ። <verse eid="JHN 5:22"/><verse number="23" style="v" sid="JHN 5:23"/>ኮመረ ክት ይሳንዳ ኤድንከስ ሙዳ ሳብ ባቤንም ቦንጅድንግንዳ፥ ኮትኮግንደረ ሳብ ይንችንመረ ቦንጅድንግንዴ፥ ሳብ ይንችንመረ ቦንጅዳክባብ፥ ሳብ ይንችንም ኦይችባብ ሳብ ባቤንም ቦንቻየኬ”።<verse eid="JHN 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24"/>“ዶፈን፥ ዶፈን የም እታ ጋይድቴ፥ እስታ ቃለንም ኤሰርድባብኬ እም ኦይችባብካ አሜንድባብ ስለንክንደታ ዶቅንት ክታ ዶቅዴ፥ ኖ ደእያርንካ ዶቅንትያር ቃልሳንኦል ፋረድምዳክዬ። <verse eid="JHN 5:24"/><verse number="25" style="v" sid="JHN 5:25"/>ዶፈን ዶፈን እታ የም ጋይድቴ፥ ደእስባብ ኤድንከስ ሳብ ይንችንታ ኡፍስንም ከት ኤሰርድንደታ ሰጫ Ꮊዴ፥ ሰጨነረ ታዬ፥ ኤሰርድባብከሰረ ሙደና ሰንፔካ ዶቅተረኬ። <verse eid="JHN 5:25"/><verse number="26" style="v" sid="JHN 5:26"/>ሳብ ባቤና ይንታ ማታ ሰንፔታ ቱት ይ ማቻንደትግንዳ ኮትኮግንደረ ይንችንመረ ሰንፔታ ቱት ክት ማድንግንዳ ይቴ”። <verse eid="JHN 5:26"/><verse number="27" style="v" sid="JHN 5:27"/>ኤደት ይንች ማትንተንከረ ፍርደን ፋረድንግንዳ ገችታ ኤረን ክትካንታ እምቴ። <verse eid="JHN 5:27"/><verse number="28" style="v" sid="JHN 5:28"/>ኮ ሪንከረ Ꮊይ በርእቴ፥ ዱክያር ዶቅድባብከስ ሙደና ክታ ኡፍስንም ከት ኤሰርድንደታ ሳዓት Ꮊዴ። <verse eid="JHN 5:28"/><verse number="29" style="v" sid="JHN 5:29"/>ኡርማ ፍክስባብከስ ደእያርንካ አምሶ ሰንፔካ ዶቅተረኬ፥ ዳቅልን ፍክስባብከስ ማቼ ደእያርንካ ከት አምሴ ከታዘን ፋረድምዴ።<note caller="-" style="x"><char style="xo" closed="false">5፡29 </char><char style="xt" closed="false"><ref loc="DAN 12:2">ዳን. 12፡2</ref>። </char></note><verse eid="JHN 5:29"/></para>
  <para style="s1">የሱስጎካ እምምሳንዳ ማርክር</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 5:30"/>“እታ እስታ ገችንታ ኤረንካ Ꮊረሰነረ ይካንታ ማታይተ፥ ኬዛር ማቼ ሳብ ባቤንዘንካ እ ኤሰርሳንደትም ፋረድቴ፥ እም ኦይችባብታ ጋይተንም ዳት እስታ ጋይተንም እ ይዳክንኦል እስታ ፍርደና ዶፈኔ። <verse eid="JHN 5:30"/><verse number="31" style="v" sid="JHN 5:31"/>እታ እጎካ እ ማርከርሴ እስታ ማርከርና ዶፈን ካዬ። <verse eid="JHN 5:31"/><verse number="32" style="v" sid="JHN 5:32"/>ኬዛር ማቼ እጎካ ማርከርድባብ አብ ዶቅዴ፥ ኖየረ እጎካ ክት ማርከርድንዳ ማርክርና ዶፈን ማትንተን ኤዝድቴ። <verse eid="JHN 5:32"/><verse number="33" style="v" sid="JHN 5:33"/>የተረ ዮሀንሰደር ክተንባብከስም ኦይተት ዶቆ፥ ኖየረ ዶፈንንጎካ ማርከርቴ።<note caller="-" style="x"><char style="xo" closed="false">5፡33 </char><char style="xt" closed="false"><ref loc="JHN 1:19-27">ዮሀ. 1፡19-27</ref>፤ <ref loc="JHN 3:27-30">3፡27-30</ref>። </char></note> <verse eid="JHN 5:33"/><verse number="34" style="v" sid="JHN 5:34"/>ኮመረ እስታ ጋይንተና የ አቅተርንግንዳ ዳት እታ ኤታ ማርክርና እካንታ ዝክሳንካንታ ካዬ። <verse eid="JHN 5:34"/><verse number="35" style="v" sid="JHN 5:35"/>ዮሀንስ የድንደትግንደኬ ሳግዝድንደት ሳክማግንዳ Ꮊቄ፥ የተረ መራ ሰጫካንታ ክታ ሳክመካ ጉርምካንታ ዝግዘቴ። <verse eid="JHN 5:35"/><verse number="36" style="v" sid="JHN 5:36"/>እታ ማቼ ዮሀንሰታ ማርክርዘንካ ስግዳንዳ ማርክር እስታ ዶቅዴ፥ እስታ ማርከነረ እስታ ባቤና እ ፍግዝድንግንዳ እካንታ እምሳንዳ ፍክስዬ፥ ኮነረ እ ፍግዝድንዳ ፍክስና፥ ሳብ ባቤና እም ኦይቻንግንዳ እጎካ ማርከርዴ። <verse eid="JHN 5:36"/><verse number="37" style="v" sid="JHN 5:37"/>እም ኦይችባበረ ሳብ ባቤና፥ ይንታ ማታ እጎካ ማርከርቴ፥ የታ ማቼ ክታ ኡፍስንም ቦድሶ ኤሰራከቴ፥ Ꮊይም ክት ካምዳናንከረ ቦድሰቶ ሰዳከቴ።<note caller="-" style="x"><char style="xo" closed="false">5፡37 </char><char style="xt" closed="false"><ref loc="MAT 3:17">ማቶ. 3፡17</ref>፤ <ref loc="MRK 1:11">ማር. 1፡11</ref>፤ <ref loc="LUK 3:22">ሉቃ. 3፡22</ref>። </char></note> <verse eid="JHN 5:37"/><verse number="38" style="v" sid="JHN 5:38"/>ክት ኦይችባብም የ አሜንዳክንኦል ክታ ቃለና የንደር ዶቅተራክዬ። <verse eid="JHN 5:38"/><verse number="39" style="v" sid="JHN 5:39"/>የታ ጭል ማጻፍንከሳር ስለንክንደታ ሰንፓ የᎺብድን የንደር ካምድንኦል ከትም ማስት ማስት ሰደቴ፥ ከተረ እጎካ ማርክርድባብከሰኬ። <verse eid="JHN 5:39"/><verse number="40" style="v" sid="JHN 5:40"/>ማታጋካ ዳት የታ ዶቅንትን Ꮊፍካንታ እዝደር Ꮊድ ዝጋየቴ”።<verse eid="JHN 5:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41"/>“እታ ቦንቼንም ኤድዘንካ ዝጋይቴ። <verse eid="JHN 5:41"/><verse number="42" style="v" sid="JHN 5:42"/>የታ የንታ ቡዳርንካ ሳብም ሶልምዳክባብከስ የንታ ማትንተን እታ ኤዝድቴ። <verse eid="JHN 5:42"/><verse number="43" style="v" sid="JHN 5:43"/>እታ እስታ ባቤንታ ላምካ Ꮊዳቴ፥ የታ ማቼ እም ሞካከቴ፥ አብና ይንታ ላምካ Ꮊዳን ማቼ የታ ክትም ሞግደቴ። <verse eid="JHN 5:43"/><verse number="44" style="v" sid="JHN 5:44"/>የታ ክክ ክክታ ቦንቸም ዝግድባብከስ ዋልቃ ሳብዘንካ Ꮊፈርድንደትም ቦንቸንም ማቼ ዝግዳክባብከስ፥ Ꮊስግንደንት አሜንካንታ ማዳ? <verse eid="JHN 5:44"/><verse number="45" style="v" sid="JHN 5:45"/>እታ እስታ ባቤንታ እሪ የም እ ካሰዝድን Ꮊይካማ፥ የም ካሰዝድባብ የ ጉርም ክታዘን ይድባብ ሙሴ። <verse eid="JHN 5:45"/><verse number="46" style="v" sid="JHN 5:46"/>ሙሴም የ አሜንተስናና ኖየረ እጎካ ጻፍሳንካንታ እመረ አሜንተረትዶቆ። <verse eid="JHN 5:46"/><verse number="47" style="v" sid="JHN 5:47"/>ክት ጻፍሳንደትም የ አሜናክንዳ ማቼ እስታ ቃለንም Ꮊስግንደንት አመንዳ?” ኩን ከትም ጋይሴ።<verse eid="JHN 5:47"/></para>
  <chapter eid="JHN 5"/>
  <chapter number="6" style="c" sid="JHN 6"/>
  <para style="s1">የሱስ ዶንቅ ሳአ ኤድንከስም ክታ እችስና</para>
  <para style="r">(<ref loc="MAT 14:13-21">ማቶ. 14፡13-21</ref>፤ <ref loc="MRK 6:30-44">ማር. 6፡30-44</ref>፤ <ref loc="LUK 9:10-17">ሉቃ. 9፡10-17</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1"/>ኮታ ቡር የሱስ ጢባሮስ ጋይምድን ገሊላ ባሀርንታ ፋማ ቃልሴ። <verse eid="JHN 6:1"/><verse number="2" style="v" sid="JHN 6:2"/>በድ ኤድንከስ የሱስ ሰቀርስባብከስም ፋችካ ክት ይሳንደት አተንም ሰጃንኦል ጎርስምሰኬ። <verse eid="JHN 6:2"/><verse number="3" style="v" sid="JHN 6:3"/>የሱስ ገቸንዘን ዉትሶ ኮታዘን ይንታ ካርንካ ጎርስምድባብከስካ ክክን ዶቅሴ። <verse eid="JHN 6:3"/><verse number="4" style="v" sid="JHN 6:4"/>አይሁድንከሰተረ ፋስጋ ባአልና የልታ Ꮊቄ። <verse eid="JHN 6:4"/><verse number="5" style="v" sid="JHN 6:5"/>ኮትᎺይካ የሱስ በድ ዎርሳ ክደር Ꮊድንካ ጬክን ጋይሶ ሰድስንደትኬ ፍልጶሰም፥ “ኮ ሙዳ ኤድን ማድን እችም Ꮊምንኮንት ሰንዳ?” ክደር ጋይሴ። <verse eid="JHN 6:5"/><verse number="6" style="v" sid="JHN 6:6"/>የሱስ ኮም ኬዛንዳ ፍልጶሰም ጰጫካንታ ዳት፥ ይ ይድንደትም ኖይንታ ማታ ኤዝድ Ꮊቄ።<verse eid="JHN 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7"/>ፍልጶሰረ “ዋልቃ ዋልቀን ካንታ መርሳ መርሳ አስም ዎራ ከትካንታ እምምድንግንዳ ቃስተን ጨታ ጣገራ ብረታ ሶለነረ ከትም ማታዬ” ጋይሶ ማስሴ።<note caller="+" style="f"><char style="fr" closed="false">6፡7 </char><char style="ft" closed="false">ፍልጶሰረ ድናር ጋይንትና ዋልቃሰጭ ፍክስታ ናከርድንዳ ብሬ </char></note><verse eid="JHN 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8"/>ክታ ካርንካ ጎርስምድባብከሳርንካ ዋልቀና ስምኦን ጴጥሮስታ እስመና እንደራሰረ ኩን ጋይሴ፥ <verse eid="JHN 6:8"/><verse number="9" style="v" sid="JHN 6:9"/>“ዶንቅ ጎስ ሶለኬ ቃስተን ሞላ የጅባብ ዋልቃ ይንች ኮታር ዶቅዴ፥ ኬዛር ማቼ ኮና ኮ ሙዳ ዎርሰንም Ꮊቦክ ማዳ?”<verse eid="JHN 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10"/>የሱሰረ “ኤድንከስ ከትዶቅድንግንዳ ይከቴ” ጋይሴ። ኮት ካርንዘነረ በድ ድራ Ꮊቄ፥ ኤድንከሰረ ዶቅሰኬ፥ ከታ ፋይደነረ ዶንቅ ሳአ ማድባብከስ Ꮊቀኬ። <verse eid="JHN 6:10"/><verse number="11" style="v" sid="JHN 6:11"/>ኮታ ቡር የሱስ ሶለንም አምስሶ ይንታ ባበንደር ጋለቻንደታ ቡር ዶቅስባብ ኤድንከስካንታ የልስሴ። ኮትግንደረ ሞለንከስመረ ከትካንታ ካሴ፥ ሙደነረ ይም ዝግዝድንከካ Ꮊፍሰኬ። <verse eid="JHN 6:11"/><verse number="12" style="v" sid="JHN 6:12"/>ሙደነረ እችሰኮ ምሳንደታ ቡር የሱስ ይንታካርንካ ጎርስምድባብከስም፥ “ዋልቃ ሪየረ ዉች ነግዳክንግንዳ ስጣንደት ዶከንም ሳንስከቴ” ከትም ጋይሴ። <verse eid="JHN 6:12"/><verse number="13" style="v" sid="JHN 6:13"/>ከተረ ኤድንከስ እችሶ ስጣን ዶከንም ዶንቅ ጎስ ሶለንታ ዶከንም ታመኬ ቃስተን ጋበትካ ጮችሰኬ።<verse eid="JHN 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14"/>ኤድንከሰረ የሱስ ይሳንደትም አተንም ከታ ሰጃንደትካ፥ “ገታ ኮና ኮ ፍጫሙደንዘን Ꮊድባብ ሳብዘንካ ኤሰርሶ ኬዝድባቤ!” ጋይሰኬ። <verse eid="JHN 6:14"/><verse number="15" style="v" sid="JHN 6:15"/>ኤድንከስ ማቼ ክት ዝጋክናና ተይ አይሶ ባንችምስካንታ ከት ገቀርሳንደትም ይ ኤሳንደትካ የሱስ ይንት አነታ ከታዘንካ ጎተርሶ ደንንዘን አይሴ።<verse eid="JHN 6:15"/></para>
  <para style="s1">የሱስ ባሀርንታዘን ሙከሮ ክታ አይና</para>
  <para style="r">(<ref loc="MAT 14:22-33">ማቶ. 14፡22-33</ref>፤ <ref loc="MRK 6:45-52">ማር. 6፡45-52</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16"/>ሶይቻንደት Ꮊይከረ ክታ ካርንካ ጎርስምድባብከስ ባሃርንደር Ꮊንቸርሰኬ። <verse eid="JHN 6:16"/><verse number="17" style="v" sid="JHN 6:17"/>ሎቀንዘንካ ቃልዝድን ጃልበንካ ኦስ ቅፍራናሆም ካተመናር ሙክሰኬ፥ ኮት ሳዓትንከረ ፍጨና ኡምታ Ꮊቄ፥ የሱሰረ አክ ከደር Ꮊዳክ Ꮊቄ። <verse eid="JHN 6:17"/><verse number="18" style="v" sid="JHN 6:18"/>አንድር ዞጋ ዞገሮ ዶቅድንኦል፥ ባሃርና ሶክሴ። <verse eid="JHN 6:18"/><verse number="19" style="v" sid="JHN 6:19"/>ክታ ካርንካ ጎርስምድባብከሰረ ዋልቃ ኡል ማድን ከት በየሮ አይሳንደታ ቡር የሱስ ባሀርንታዘን ሙከሮ ሎቀንዘን ቃለርድን ጃልበንደር ክት የልድንካ ሰድሰኮ ጳሰኬ።<verse eid="JHN 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 6:20"/>የሱስ ማቸ “እትቴ! Ꮊይጳሰቴ!” ጋይሴ። <verse eid="JHN 6:20"/><verse number="21" style="v" sid="JHN 6:21"/>ከተረ ጉርምካ ክትም ሞክት ሎቀንዘን ቃለርድን ጃልበናር ክትም አርችካንታ ዝግዘኬ፥ ሳነካ ጃልበና ከት አይድን ካርናር የልሴ።<verse eid="JHN 6:21"/></para>
  <para style="s1">የሱስ ዶቅንት ሶላ ማትንተና</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22"/>ዛማክንካ ባሀርንታ ፋማ ነገድባብ ኤድንከስ፥ ባሀርንታዘን ዋልቃ Ꮊክ ሎቀንዘንካ ቃለርድንዳ ጃልባ ዶቅድንኦል ኮትከረ ክታ ካርንካ ጎርስምድባብከስ ከታ ይንት አይሰኬ፥ የሱስ ማቸ ከትካ ክክን ጃልበናር አርዳክንደትም ሰተኬ። <verse eid="JHN 6:22"/><verse number="23" style="v" sid="JHN 6:23"/>ማችንከረ አብ ሎቀንዘንካ ቃልዝድን ጃልበንከስ ጢባርያዶሳርንካ አምሶ የሱስ ይንታ ባቤንም ይ ጋለቻን ካርናርከ ዎርሰና ሶለን ከት እቻን ካርንታ ባንግር Ꮊደኬ። <verse eid="JHN 6:23"/><verse number="24" style="v" sid="JHN 6:24"/>ኤድንከሰረ የሱስ ናነረ ክታ ካርንካ ጎርስምድባብከስ ኮታር ከት ካየንደትም ሰዳንደትካ ከትኮ ሎቀንዘንካ ቃልዝድን ጃልበንከስካ አርድሰኮ የሱሰም ዝግመት ቅፍራናሆማር አይሰኬ።<verse eid="JHN 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25"/>ባሀርንታ ፋማ ክትም ከታ Ꮊፍሳንግንደረ፥ “ኤስስንባቦ፥ ካሪ Ꮊንተስ Ꮊዳሬ?” ከታ ክደር ጋይሰኬ።<verse eid="JHN 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26"/>የሱሰረ፥ “ዶፈን፥ ዶፈን የም ጋይድቴ፥ የታ እም የ ዝግድንዳ ሶላ የ እቻንካንተኬ የ ምሳንኦል ዳት አታ ቃዉተንም የ ሰጃንኦል ካዬ። <verse eid="JHN 6:26"/><verse number="27" style="v" sid="JHN 6:27"/>ካይድን እችምካንታ Ꮊይ ፍክሰቴ፥ ስግስሰረ ሳብ ባቤና ክት ገታ ዶቅንት እችም ማትንተን መይምሳንኦል፥ ኤደት ይንች የካንታ እምድንደታ፥ ስለንክንደታ ዶቅንት ማድን እችምንካንታ ፍክስከቴ” ኩን ጋይሶ ከትካንታ ማስሴ።<verse eid="JHN 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28"/>ኤድንከሰረ “ይና፥ ሳብታ ፍክስንም ፍክስካንታ Ꮊራ ይ ዎም ዝግዝዳ?” ጋይሰኬ።<verse eid="JHN 6:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29"/>የሱሰረ “ሳብታ ፍክስና ማቼ ሳብ ኦይችባብካ አመንሜ” ጋይሶ ከትካንታ ማስሴ።<verse eid="JHN 6:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30"/>ከተረ፥ “ዎታ ሰድሶቶ የስካ ዎ አሜንድንግንዳ Ꮊረስ አታ ቃዉተንም ይተራ? Ꮊረስ ፍክስተራ? <verse eid="JHN 6:30"/><verse number="31" style="v" sid="JHN 6:31"/>‘ከት እጅድን ግንዳ ጭላርንካ ሶላ ከትካንታ እምሴ’ ጋይምሶ ጻፍምሳንግንዳ፥ ዎንታ ባቤንከስ ዴል ቆቸናር ማኔን እችተኬ” ኩን ጋይሰኬ።<note caller="-" style="x"><char style="xo" closed="false">6፡31 </char><char style="xt" closed="false"><ref loc="EXO 16:4">ዉት. 16፡4</ref>፥<ref loc="EXO 16:15">15</ref>፤ <ref loc="PSA 78:24">የቺ 78፡24</ref>። </char></note><verse eid="JHN 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32"/>ኮካንተረ የሱስ፥ ዶፈን፥ ዶፈን የካንታ ጋይድቴ፥ ጭላርንካ Ꮊንቸርሳን ሶለንም የካንታ እምስባብ ሙሴ ካዬ፥ ዶፈን ሶለንም ጭላርንካ የካንታ እምድባብ እስታ ባቤኔ፥<verse eid="JHN 6:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 6:33"/>“ሳብታ ሶለና ጭላርንካ Ꮊንቸርድንደትከ ፍጫ ሙደን ካንታ ሰንፐን እምድባቤ” ጋይሴ። <verse eid="JHN 6:33"/><verse number="34" style="v" sid="JHN 6:34"/>ኮካንታ ኤድንከስ “የባቦ! ኮ ግንደን ሶለንም ሙዳᎺይካ ዎካንታ እምካ” ጋይሰኬ።<verse eid="JHN 6:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35"/>የሱሰረ፥ “ዶቅንት ሶለና እትቴ፥ እዝደርᎺድባብ ቦድሶ ዳቀራዬ፥ እንካ አሜንድባብ ቦድሰረ ዎቸራዬ፥ <verse eid="JHN 6:35"/><verse number="36" style="v" sid="JHN 6:36"/>የታ ማቼ እም ሰተቴ፥ ማችንከረ እንካ የታ አሜናከቴ የም ጋይድቴ። <verse eid="JHN 6:36"/><verse number="37" style="v" sid="JHN 6:37"/>ሳብ ባበና እካንታ እምድን ሙደና እዝደር Ꮊዴ፥ እዝደር Ꮊድባብመረ ቦድሶ ኦስ ማል ዳያይቴ። <verse eid="JHN 6:37"/><verse number="38" style="v" sid="JHN 6:38"/>እታ ጭላርንካ እ Ꮊንቸርሳንዳ እም ኦይችባብታ ጋይተን ይታ ካንታ ዳት እስታ ጋይተንም ይካንታ ካዬ። <verse eid="JHN 6:38"/><verse number="39" style="v" sid="JHN 6:39"/>እም ኦይችባብታ ጋይተንም፥ እም ክት እምሳንደት ሙደናርንካ ዋልቀረ ዎራ ካይሳክትዶቆ በእንታ ሰጨንካ ደእያርንካ ከትም አምዝድንግንዴ። <verse eid="JHN 6:39"/><verse number="40" style="v" sid="JHN 6:40"/>ይዬ! እስታ ባቤንታ ጋይተና ሳብ ይንችንም ሰድባብኬ ክትካ አሜንድባብ ሙደና ስለንክንደታ ዶቅንትን Ꮊብድንግንዴ፥ እተረ በእንታ ሰጨንካ ደእያርንካ አምዝድቴ” ከትም ጋይሴ።<verse eid="JHN 6:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41"/>ኮካንታ የሱስ “ጭላርንካ Ꮊንቸርስባብ ሶለና እትቴ” ጋይንተካ አይሁድንከስ ክታዘን ጉንድምሰኬ፥<verse eid="JHN 6:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 6:42"/>ኩነረ ጋይሰኬ፥ “ኮና ዮሰፍታ ይንች የሱስ ካዮ? እንደንምከ ባቤንምኬ ኤዝዶት ካዮ? ይና፥ ታ ኖ Ꮊስግንድክ ‘ጭላርንካ Ꮊንቸርሳቴ’ ኖ ጋይዳ?” ጋይሰኬ።<verse eid="JHN 6:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43"/>የሱሰረ፥ ክክ ክክ Ꮊይ ጉንድመቴ፥ <verse eid="JHN 6:43"/><verse number="44" style="v" sid="JHN 6:44"/>እም ኦይችባብ ሳብ ባቤና ክትም ኤላክን የለልታ እዝደር Ꮊድካንታ ማድባብ Ꮊየሰነረ ካዬ፥ እዝደር Ꮊድባብም በእንታ ሰጨንካ ደእያርንካ አምዝድቴ። <verse eid="JHN 6:44"/><verse number="45" style="v" sid="JHN 6:45"/>ሳብዘንካ ኤሰርሶ ኬዝድባብከስታ ማጻፍንከስ ኤድንከስ ሙደና ሳብዘንካ ኤስባብ ማደኬ ጋይምሶ ጻፍምቴ፥ ኮካንታ ሳብ ባቤንዘንካ ኤሰርሶ ኤስባብ ሙደና እዝደር Ꮊደኬ።<note caller="-" style="x"><char style="xo" closed="false">6፡45 </char><char style="xt" closed="false"><ref loc="ISA 54:13">ኢሳ. 54፡13</ref>። </char></note> <verse eid="JHN 6:45"/><verse number="46" style="v" sid="JHN 6:46"/>ኮም ጋይንተነረ ሳብ ባቤንም ሰጅባብ ኤድ ዶቅዴ ጋይንት ካዬ፥ ሳብ ባቤንም ሰጅባብ ሳብደርንካ Ꮊድባብ ኖ Ꮊክዬ።<verse eid="JHN 6:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 6:47"/>ዶፈን፥ ዶፈን የም ጋይድቴ፥ (እንካ) አሜንድባብ ኤድ ስለንክንደታ ዶቅንት ዶቅዴ። <verse eid="JHN 6:47"/><verse number="48" style="v" sid="JHN 6:48"/>ዶቅንት ሶለነረ እትቴ፥ <verse eid="JHN 6:48"/><verse number="49" style="v" sid="JHN 6:49"/>የንታ ባቤንንከስ ዴል ቆቸናር ማኔን እቸኬ፥ ኬዛርካ ማቼ ደእሰኬ፥ <verse eid="JHN 6:49"/><verse number="50" style="v" sid="JHN 6:50"/>ጭላርንካ Ꮊንቸርሳንዳ ሶለና ኮኔ፥ ኮም ሶለንም እጅድባብ ቦድሰረ ደእዳከኬ። <verse eid="JHN 6:50"/><verse number="51" style="v" sid="JHN 6:51"/>ጭላርንካ Ꮊንቸርስባብ ዶቅንት ሶለንም እምድባብ እትቴ፥ ኮ ሶለንዘንካ እጅድባብ ሙደና ስለንካ ዶቅተሬ፥ ፍጫ ሙደን ካንታ ዶቅንት ማድንግንዳ እ እምድንዳ ሶለና እስታ ዋሄኔ ኩንጋይሶ ማስሴ።<verse eid="JHN 6:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52"/>ኮትኮ ሰጨንᎺይካ አይሁድንከስ “ኮና ኤችና ክታ ዋሄንም ዎ እጅድንግንዳ Ꮊስግንድክ እምካንታ ማዳ?” ጋይንተካ ክክ ክክ ከታ ቤርምሰኬ።<verse eid="JHN 6:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53"/>ኮካንታ የሱስ፥ “ዶፈን፥ ዶፈን የም ጋይድቴ ኤደት ይንችታ ዋሄን የ እቻክን ማቼ፥ ማቀስንመረ የ ዎጫክን ማቼ ዶቅንት የንታ ካዬ። <verse eid="JHN 6:53"/><verse number="54" style="v" sid="JHN 6:54"/>እስታ ዋሄንም እጅድባብኬ እስታ ማቀስንም ዎጭድባብ ሙደና ስለንካ ዶቅንት ዶቅዴ፥ እተረ በእንታ ሰጨንካ ደእያርንካ ክትም አምዝድቴ። <verse eid="JHN 6:54"/><verse number="55" style="v" sid="JHN 6:55"/>እስታ ዋሄነረ ዶፈን እችሜ፥ እስታ ማቀስነረ ዶፈን ዎጭሜ። <verse eid="JHN 6:55"/><verse number="56" style="v" sid="JHN 6:56"/>እስታ ዋሄንም እጅድባብኬ እስታ ማቀስንም ዎጭድባብ ሙደና እንካ ዶቅተሬ፥ እተረ ክትካ ዶቅድቴ። <verse eid="JHN 6:56"/><verse number="57" style="v" sid="JHN 6:57"/>ስለንካ ዶቅድባብ ሳብ ባቤና እም ኦይቻንግንደኬ እተረ ክትካ ስለንካ ዶቅድባብ እ ማቻንግንዳ ኮትኮግንደረ እስታ ዋሄንም እጅድባብ ሙደና እንካ ስለንካ ዶቅድባብ ማተረ። <verse eid="JHN 6:57"/><verse number="58" style="v" sid="JHN 6:58"/>ይና ጭላርንካ Ꮊንቸርስባብ ሶለና ኮኔ፥ ኖየረ የንታ ባቤንከስ እቻንግንዳ ካዬ፥ ኮትኮም ሶለንም እችባብከስ ደእተኬ፥ ኮም ሶለንም እጅድባብከስ ማቼ ስለንካ ዶቅተረኬ” ኩን ከትም ጋይሴ።<verse eid="JHN 6:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59"/>የሱስ ኮም ክት ኬዛንዳ ቅፍረናሆም ካተመናር አይሁድንከስታ ምክስ ኤሄናር ኤስዝድንᎺይኬ።<verse eid="JHN 6:59"/></para>
  <para style="s1">ስለንክንደታ ዶቅንት ቃላ</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60"/>ክታ ካርንካ ጎርስምድባብከሳርንካ በድንከስ ኮም ከታ ይ ኤሰርሳንደትካ፥ “ኮና ኬዘና አንድሬ፥ Ꮊይ ተይካንታ ኮም ማዳ?” ጋይሰኬ።<verse eid="JHN 6:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61"/>የሱሰረ ክታ ካርንካ ጎርስምድባብከስ ኮ ሪን ካንታ ከት ጉንድምዳክንግንዳ ይንታ አያንካ ኤስሶ፥ “ኮና ሪና የም ኮተርዝዶ? <verse eid="JHN 6:61"/><verse number="62" style="v" sid="JHN 6:62"/>ኤደት ይንች ይ Ꮊቃንደታር ማትዮ ክት አይድንካ የታ ሰደቶ Ꮊረን ጋይተራ? <verse eid="JHN 6:62"/><verse number="63" style="v" sid="JHN 6:63"/>ዶቅንትን እምድባብ ሳብታ አያነ፥ ኤታ ዎልቃ ማቼ Ꮊረነረ መያዬ፥ እታ የካንታ እ ኬዛንዳ ቃለና አያነ፥ አነረ ዶቅንትዬ፥ <verse eid="JHN 6:63"/><verse number="64" style="v" sid="JHN 6:64"/>ኬዛር ማቼ የንታ ዎክያርንካ ዋልቃ ዋልቀንከስ አመንዳክባብከስ ዶቅደኬ” ከትም ጋይሴ። የሱስ ኮም ከትካንታ ክት ኬዛንዳ እርንደትዘንካ የድሶ አመንዳክባብከስ Ꮊይከስ ዶቅዳናንከረ ስክስት እምድባበረ Ꮊይማቼረ ይ ኤዝድ Ꮊቃንኦሌ። <verse eid="JHN 6:64"/><verse number="65" style="v" sid="JHN 6:65"/>ኮታዘንከረ የሱስ “ሳብ ባቤንዘንካ ክትካንታ ጋይምሳንዳ ማታክንዳ ማቼ እዝደር Ꮊድካንታ ማድባብ ካዬ እ የንደር ጋይሳንደና ኮካንቴ” ጋይሴ።<verse eid="JHN 6:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66"/>ኮታ ጎግካ ክታ ካርንካ ጎርስምድባብከሳርንካ በድንከስ ኦስ ቡር ማቼኬ፥ ኮት ሰጨንዘንካ የችሶ የሱሰም ጎርስምን ዛቅሰኬ። <verse eid="JHN 6:66"/><verse number="67" style="v" sid="JHN 6:67"/>ኮካንታ የሱስ ታመከ ቃስተን ክታ ካርንካ ጎርስምድባብከስም፥ “የተረ ጉጅሶ አይካንታ ዝግደቴ?” ከትም ጋይሴ። <verse eid="JHN 6:67"/><verse number="68" style="v" sid="JHN 6:68"/>ኮት ሰጨንካ ስምኦን ጴጥሮስ፥ ኩንጋየሮ ማስሴ፥ “ጮይስዮ! Ꮊይደሮንት አይዳ? የዝደር ስለንካ ዶቅንትታ ቃላ ዶቅዴ። <verse eid="JHN 6:68"/><verse number="69" style="v" sid="JHN 6:69"/>ዎታ ማቼ አመንቶቴ፥ ጭል ሳብታ ይንች የስ ማቻንደትም ኤስቶቴ” ኩንጋየሮ ማስሴ።<note caller="-" style="x"><char style="xo" closed="false">6፡69 </char><char style="xt" closed="false"><ref loc="MAT 16:16">ማቶ. 16፡16</ref>፤ <ref loc="MRK 8:29">ማር. 8፡29</ref>፤ <ref loc="LUK 9:20">ሉቃ. 9፡20</ref>። </char></note> <verse eid="JHN 6:69"/><verse number="70" style="v" sid="JHN 6:70"/>የሱሰረ “የም የ ታሜከ ቃስተንከስም እዳክቶ? ኬዛር ማቼ የንታ ዎካርንካ ዋልቀና ዳብሎስዬ” ከትም ጋይሴ። <verse eid="JHN 6:70"/><verse number="71" style="v" sid="JHN 6:71"/>ኮመረ ክት ጋይሳንዳ ስምኦነታ ይንች አስቆሮንት ይሁዳጎካ Ꮊቄ፥ ይሁደረ Ꮊረሰነረ ዎራ ታሜከ ቃስተንናርንካ ዋልቀና ማችንከረ የሱሰም ስክስት እምድባብ ክት ማቻንጎኬ።<verse eid="JHN 6:71"/></para>
  <chapter eid="JHN 6"/>
  <chapter number="7" style="c" sid="JHN 7"/>
  <para style="s1">የሱሰኬ ክታ እስመንከስካ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1"/>ኮታ ቡር የሱስ ገሊላር ኦንገሮ Ꮊቄ፥ አይሁድንከስ ክትም ደይስካንታ ዝገሮ ከትᎺቃንካንታ ኖ ማቼ ይሁዳር ኦንጋካንታ ዝጋክዬ፥ <verse eid="JHN 7:1"/><verse number="2" style="v" sid="JHN 7:2"/>ኮታይካ አይሁድንከስታ ዳልቻ ባአልና ቅንችታ Ꮊቄ።<note caller="-" style="x"><char style="xo" closed="false">7፡2 </char><char style="xt" closed="false"><ref loc="LEV 23:34">ሌዊ. 23፡34</ref>፤ <ref loc="DEU 16:13">ካሪ. 16፡13</ref>። </char></note> <verse eid="JHN 7:2"/><verse number="3" style="v" sid="JHN 7:3"/>ኮካንታ ክታ እስመንከስ የሱሰደር ቅንችሶ፥ “የስታ ካርንካ ጎርስምድባብከስ የስ ይድንደትም ፍክስን ከት ሰድንግንዳ ኮታርንካ አምሳዮ ይሁዳ ፍጨናር አይካ፥ <verse eid="JHN 7:3"/><verse number="4" style="v" sid="JHN 7:4"/>መየካ ኤስምካንታ ዝግድባብ ኤድ ይንታ ፍክስንም አቸካ ይዳክዬ፥ የነረ ኬና ሪንከስም ሙዳ የስ ይድንካ የስታ ማተንም ፍጫሙደንካንታ መያ ማስ የስም ዝግዝዴ” ኩን ጋይሰኬ። <verse eid="JHN 7:4"/><verse number="5" style="v" sid="JHN 7:5"/>ኮመረ ከት ጋይሳንደና ክታ እስመንንከስ ዎራ ክትካ ከት አመናክን ኦሌ።<verse eid="JHN 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6"/>የሱሰረ፥ “እስታ ሰጨና አክ የላክዬ፥ የንታ ሰጨና ማቼ ሙዳᎺይካ ኡርሳንዴ።<verse eid="JHN 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 7:7"/>“ፍጫ ሙደነረ የም ግርካንታ ማታዬ፥ እታ ማቼ ፍክስና ዳቅል ማትንተን እ ማርከርድንኦል እም ግርዴ። <verse eid="JHN 7:7"/><verse number="8" style="v" sid="JHN 7:8"/>የታ ባአልናር አይከቴ፥ እታ ማቼ እስታ ሰጨና አክ የላክንኦል ኮትኮ ባአልናር አይዳክቴ” ከትካንታ ጋየሮ ማስሴ። <verse eid="JHN 7:8"/><verse number="9" style="v" sid="JHN 7:9"/>ኮመረ ጋይሶ ኖ ገሊላር ነገዴ።<verse eid="JHN 7:9"/></para>
  <para style="s1">የሱስ ዳልቻ ባአልንዘን Ꮊፈርሶ ክታ ኤስስና</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10"/>ኬዛር ማቼ ክታ እስመንንከስ ባአልናር አይሳንደታ ቡር ኖ መየካ ማታክናና አጥምካ ባአልናር አይሴ።<verse eid="JHN 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 7:11"/>ባአልንታዘን “ኖ Ꮊብሬ?” ጋየረኮ አይሁድንከስ ዝገረኮ Ꮊቀኬ። <verse eid="JHN 7:11"/><verse number="12" style="v" sid="JHN 7:12"/>ዎርሰነረ ክትጎካ ዎክስምካ ከዝምድ Ꮊቀኬ፥ ዋልቃ ዋልቀንከስ “ኖ ኡርማ ኤዴ” ጋይድንካ፥ አብንከስ ጉጅሶ “ኩን ካዬ ኖ ዎርሰንም ኮተርዝዴ” ጋየረኮ Ꮊቀኬ። <verse eid="JHN 7:12"/><verse number="13" style="v" sid="JHN 7:13"/>ማታጋካ ዳት አይሁድንከስታ ገችንታ ኤረንባብከስም ጳስካ Ꮊየሰነረ ክትጎካ መየካ ከዛክዬ።<verse eid="JHN 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14"/>ባአልንታ ዎክገርዘን የሱስ ሳብታ ጭል ኤሄናር አይሶ ኤስስ የጄ። <verse eid="JHN 7:14"/><verse number="15" style="v" sid="JHN 7:15"/>አይሁድንከሰረ፥ “ኮና ኤችና ኤሳክዶቆ ኮም ሙዳ Ꮊስግንድክ ኤስካንታ ማቻሬ?” ጋየረኮ በርኤሮ Ꮊቀኬ።<verse eid="JHN 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16"/>ኮካንታ የሱስ፥ “እስታ ኤስስና እም ኦይችባብ ሳብ ባቤንዘንካ Ꮊፈርድንዳ ዳት እዘንካ ካዬ። <verse eid="JHN 7:16"/><verse number="17" style="v" sid="JHN 7:17"/>እም ኦይችባብታ ጋይተንም ይካንታ ዝግድባብ ዶቅሴ ኮም ኤስስንም ሳብዘንካ Ꮊፈርሳንዳ አነረ እታ እስታ ማታርንካ እ ኬዛንደት ማትንተን ኤዝዴ። <verse eid="JHN 7:17"/><verse number="18" style="v" sid="JHN 7:18"/>ይንዘንካ ኬዝድባብ ይንታ ማታ ቦንቻ ዝግዴ፥ ኦይችባብታ ቦንቸንም ዝግድባብ ማቼ ዶፈኔ፥ ማልት ክታዘን ካዬ። <verse eid="JHN 7:18"/><verse number="19" style="v" sid="JHN 7:19"/>ሙሴ ህግን የካንታ እምታ ካዮ? ኬዛር ማቼ የንታ ዋርንካ ህግንም ቦድባብ Ꮊየነረ ካዬ። የታ Ꮊረተንት እም ደይስካንታ ዝግዳ?” ከትም ጋይሴ።<verse eid="JHN 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20"/>ዎርሰነረ “የዘን ግምዛ ዶቅዴ፥ Ꮊይ የስም ደይሳካንታ ዝግዳ?” ጋይሰኬ።<verse eid="JHN 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21"/>የሱሰረ፥ “እታ ዋልቃ ፍክስ እ ፍክሴ፥ የተረ ሙደና ኮ ፍክስንካ በርእደቴ። <verse eid="JHN 7:21"/><verse number="22" style="v" sid="JHN 7:22"/>ሙሳ ሶላ ተችርታ ዎገንም የካንታ እምሴ፥ ኮነረ ዎገና Ꮊፈርሳንዳ፥ ባቤንከዘንካ ዳት ሙሴዘንካ ካዬ፥ የተረ አይሁድንከስታ Ꮊዉስ ሰጨንካ ኤድንታ ሶለንም ተጅደቴ።<note caller="-" style="x"><char style="xo" closed="false">7፡22 </char><char style="xt" closed="false"><ref loc="GEN 17:10">ፍዝ. 17፡10</ref>፤ <ref loc="LEV 12:3">ሌዊ. 12፡3</ref>። </char></note> <verse eid="JHN 7:22"/><verse number="23" style="v" sid="JHN 7:23"/>ይና ሙሴታ ጎግካ እመርሳንዳ ህግና ነገዳክንግንዳ አይሁድንከስታ Ꮊዉስ ሰጨንካ ኤድንታ ሶለንም ተቸርድንዳ ማቼ ይና፥ እታ አይሁድንከስታ Ꮊዉስ ሰጨንካ ኤታ ኤደትቸንም እስታ ፋችንተንካ Ꮊረተንት ዋጭዳ?<note caller="-" style="x"><char style="xo" closed="false">7፡23 </char><char style="xt" closed="false"><ref loc="JHN 5:9">ዮሀ. 5፡9</ref>። </char></note> <verse eid="JHN 7:23"/><verse number="24" style="v" sid="JHN 7:24"/>ዶፈን ፍርደን ፋረድከቴ ዳት ኤታ ባለም ሰድሰቶ ኦስነካ Ꮊይ ፋረደቴ” ከትካንታ ጋይሴ።<verse eid="JHN 7:24"/></para>
  <para style="s1">ሳይምስባብጎካ አምሳንዳ በርም</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25"/>የሩሳሌም ኤድንከሳርንካ ዋልቃ ዋልቀንከስ ኩን ጋይሰኬ፥ “ክትም ደይሳካንታ ከት ዝግድባብ ኤችና ኮና ካዮ? <verse eid="JHN 7:25"/><verse number="26" style="v" sid="JHN 7:26"/>ይና፥ ኖ መየካ ኬዝዴ፥ ከተረ Ꮊረሰነረ ክትም ጋያከኬ፥ ኮና ኤችና ሳይምስባብ ማትንተንም ገችንታ ኤረንባብከስ ዶፈንካ ኤስተክ ዳቶ? <verse eid="JHN 7:26"/><verse number="27" style="v" sid="JHN 7:27"/>ማችንከረ ኮና ኤችና Ꮊምንካ ክት ናነረ ዎታ ኤዝዶቴ፥ ሳይምስባብ Ꮊድንካ Ꮊምንካ ክት ናነረ ኤዝድባብ Ꮊየሰነረ ካዬ” ኩን ጋይሴ።<verse eid="JHN 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28"/>ኮካንታ የሱስ ሳብታ ጭል ኤሄናር ኤስዝድዮ ይንታ ኡፍስንም ጬክሳ ይይሶ ኩን ጋይሴ፥ “እም የታ ኤዝደቴ፥ Ꮊምንካ እ Ꮊዳናንከረ የታ ኤዝደቴ፥ ኬዛርካ ማቼ እታ እስታ ገችታ ኤረካ Ꮊዳክቴ፥ እም ኦይችባብ ኖ ዶፈኔ፥ የታ ማቼ ክትም ኤዝዳከቴ። <verse eid="JHN 7:28"/><verse number="29" style="v" sid="JHN 7:29"/>እታ ማቼ ክደርንካ እ Ꮊዳንጎከ ክት እም ኦይቻንካንታ እታ ኤዝድቴ” ኩን ጋይሴ።<verse eid="JHN 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30"/>ኮት ሰጨንካ ክትም የድካንታ ዝግድ Ꮊቀኬ፥ ኬዛር ማቼ ሰጨና አክ የላክንኦል Ꮊየነረ ክትም የዳክዬ። <verse eid="JHN 7:30"/><verse number="31" style="v" sid="JHN 7:31"/>ማችንከረ ዎርሰናርንካ በድንከስ ክትካ አመንሰኬ፥ ኩነረ ጋይሰኬ፥ “ሳይምስባብ Ꮊድን ሰጨንካ ኮና ኤችና ክት ይሳን አታ ቃዉተንዘንካ ስግዳንደትም ይዶ?”<verse eid="JHN 7:31"/></para>
  <para style="s1">የሱሰም ኬት የድንግንዳ ዳምንባብከስታ ኦይትምና</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32"/>ኤድንከስ የሱስጎካ ዎክስምካ ከት ከዝምድንካ ፈርሳዊያንንከስ ኤሰርሰኬ፥ ኮካንታ ቄሰንከስም ገችዝድባብከስኬ ፈርሳዊያንንከስኬ የሱሰም የችስ ካንታ ሳብታ ጭል ኤሄንታ ካርሰንባብከስም ኦይቸኬ። <verse eid="JHN 7:32"/><verse number="33" style="v" sid="JHN 7:33"/>ኮት ሰጨንካ የሱስ “የንካ ክክን መራ ሰጫ ዶቅድቴ፥ ኮታ ቡር እም ኦይችባብደር አይድቴ፥ <verse eid="JHN 7:33"/><verse number="34" style="v" sid="JHN 7:34"/>የታ እም ዝግተረቴ፥ ማችንከረ እም Ꮊፍተራከቴ፥ እ ዶቅድንደታር፥ የታ Ꮊድካንታ ማታየቴ” ኩን ጋይሴ።<verse eid="JHN 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35"/>ኮካንታ አይሁድንታ ገችንታ ኤረንባብከስ፥ “ዎ ክትም Ꮊብዳክን ግንዳ ኮና ኤችና Ꮊብር አይካንተረ? Ꮊረንግርካ ግርክንከስታ ዎክያር ይጭምስባብ አይሁድንከዝደር አይሶ አይሁድ ማታክባብከስም ኤስስካንታ ዳቶ? <verse eid="JHN 7:35"/><verse number="36" style="v" sid="JHN 7:36"/>‘እም ዝግተረቴ፥ ኬዛር ማቼ Ꮊፍተራከቴ፥ እ ዶቅድንደታር የታ Ꮊድካንታ ማዳከቴ’ ጋይድንካ Ꮊራ ጋይንተሬ?” ክክን ኩን ጋይሰኬ።<verse eid="JHN 7:36"/></para>
  <para style="s1">ዶቅንት ሎቀንታ ቱት</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37"/>ባአልንታ በእንታ ማቻን ኤስምሳን ሰጨንካ የሱስ ዎእሶ ይንታ ኡፍስንም ጬክሳ ይይሶ፥ “ሎቃ ዎቸርስባብ ዶቅሴ እዝደር Ꮊድሶ ዎጫ፥ ጋይሶ ፍፍሴ።<note caller="-" style="x"><char style="xo" closed="false">7፡37 </char><char style="xt" closed="false"><ref loc="LEV 23:36">ሌዊ. 23፡36</ref>። </char></note> <verse eid="JHN 7:37"/><verse number="38" style="v" sid="JHN 7:38"/>እንካ አሜንድባብ ጭል ማጻፍና ጋይድንግንዳ፥ ዶቅንት ሎቀንታ ቱትና ክታ ዋርንካ ፉእዴ።” <note caller="-" style="x"><char style="xo" closed="false">7፡38 </char><char style="xt" closed="false"><ref loc="EZK 47:1">ሕዝ. 47፡1</ref>፤ <ref loc="ZEC 14:8">ዘካ. 14፡8</ref>። </char></note> <verse eid="JHN 7:38"/><verse number="39" style="v" sid="JHN 7:39"/>ኮመረ ክት ኬዛንዳ ክትካ አሜንድባብከስ ከት ተይድን አያን ጭልንጎካ Ꮊቄ፥ የሱስ አክ ቦንቸዘን ዉታክንኦል አያን ጭልና አክ እምማክ Ꮊቄ።<verse eid="JHN 7:39"/></para>
  <para style="s1">ዎርሰንታ ዎክያር ፋስም Ꮊፍርና</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40"/>ኮካንታ ዎርሰናርንካ ዋልቃ ዋልቀንከስ ኮም ቃለንም ኤሰርሳንደትካ፥ “Ꮊዴ ጋየርስባብ ሳብዘንካ ኤሰርሶ ኬዝድባብ ገታ ኮኖ” ጋይሰኬ። <verse eid="JHN 7:40"/><verse number="41" style="v" sid="JHN 7:41"/>አብንከሰረ “ኮና ሳይምስባቤ” ጋይሰኬ። አብንከስ ማቼ “ሳይምስባብ Ꮊድንደና ገሊለንኮ? <verse eid="JHN 7:41"/><verse number="42" style="v" sid="JHN 7:42"/>ሳይምስባብ ዳውተታ ሱሳርንካ አጥምድንግንደከ ዳውተታ ካተመን በተለሄማርንካ Ꮊድንደትም ጭል ማጻፍናር ጻፍምታ ካዮ?” ጋይሰኬ።<note caller="-" style="x"><char style="xo" closed="false">7፡42 </char><char style="xt" closed="false"><ref loc="2SA 7:12">2 ሳሙ. 7፡12</ref>፤ <ref loc="MIC 5:2">ሚክ. 5፡2</ref>። </char></note> <verse eid="JHN 7:42"/><verse number="43" style="v" sid="JHN 7:43"/>ኮካንታ ክትጎግካ ዎርሰንታ ዎክያር ፋስም ማቼ። <verse eid="JHN 7:43"/><verse number="44" style="v" sid="JHN 7:44"/>ዋልቃ ዋልቀንከስ ክትም የድካንታ ዝግታ Ꮊቀኬ፥ ኬዛር ማቼ Ꮊየሰነረ ክትም የዳክዬ።<verse eid="JHN 7:44"/></para>
  <para style="s1">አይሁድንታ ጎርስንባብከስ አሜንክሳ ከታ ነግና</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45"/>ኮታ ቡር ካርስንባብከስ ቀሰንታ ገችንባብከዝደርኬ ፈረሳዊያንን ከዝደር ማት አይሰኬ፥ ከተረ “Ꮊረታ ክትም የ ተይ Ꮊዳክንደና?” ከትም ጋይሴ።<verse eid="JHN 7:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46"/>ክትምስባብከሰረ “ኮና ኤችና ኬዝድንግንዳ Ꮊየሰነረ ኬዝሶ ኤሳዬ” ጋይሰኮ ማስሰኬ።<verse eid="JHN 7:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47"/>ፈረሳዊያንንከስ ማቼ፥ “የተረ ጉጅሶ ኮተርሰቴ? <verse eid="JHN 7:47"/><verse number="48" style="v" sid="JHN 7:48"/>Ꮊረንግርካ ገችንታ ኤረንባብከሳርንካ አነረ ፈረሳዊያንንከሳርንካ ክትካ አመንስባከስ ዶቅደኮ? <verse eid="JHN 7:48"/><verse number="49" style="v" sid="JHN 7:49"/>ኮነረ ሙሴታ ህግንም ኤዝዳክን ዎርሰና ገታ ባድምስባበኬ” ኩን ጋይሰኬ።<verse eid="JHN 7:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50"/>ኮታ እሪ የሱሰደር አይሶ Ꮊቅባብከ ፈረሳዊያንን ከሳርንካ ዋልቃባብ ንቀድሞስ፥<note caller="-" style="x"><char style="xo" closed="false">7፡50 </char><char style="xt" closed="false"><ref loc="JHN 3:1-2">ዮሀ. 3፡1-2</ref>። </char></note> <verse eid="JHN 7:50"/><verse number="51" style="v" sid="JHN 7:51"/>“ዎንታ ህግንግንዳ ዋልቃ ኤድ ካሰስንታ ማስን እርምሶ ክታዘንካ ኤሰራክዶቆ Ꮊራ ክት ይሳናንከረ ኤስማክናና ክታዘን ፋረድምዶ?” ከትም ጋይሴ።<verse eid="JHN 7:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52"/>ከተረ “የነረ ገልላርንኮ? ሳብዘንካ ኤሰርሶ ኬዝድባብ ገሊላርንካ አምዳክንደትም ፋስት ኤስካ” ክትም ጋይሴ። <verse eid="JHN 7:52"/><verse number="53" style="v" sid="JHN 7:53"/>ዋልቃ ዋልቀነረ ይንታ ኤር ማቼ።<verse eid="JHN 7:53"/></para>
  <chapter eid="JHN 7"/>
  <chapter number="8" style="c" sid="JHN 8"/>
  <para style="s1">ቤልምዘን የድምሳን ኤተን</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1"/>ኮታ ቡር የሱስ ደብረዛይት ገቼንዘን አይሴ። <verse eid="JHN 8:1"/><verse number="2" style="v" sid="JHN 8:2"/>ዛማክንከረ ዛማ ገልት ሳብታ ጭል ኤሄናር ማት Ꮊዴ፥ ዎርሰነረ ሙዳ ክደር Ꮊደኬ፥ ኖየረ ዶቅሶ ኤስዝድ Ꮊቄ። <verse eid="JHN 8:2"/><verse number="3" style="v" sid="JHN 8:3"/>ህግንታ ኤስንባብከስኬ ፈረሳዊያንንከስ ኤተንና ቤልምድንካ የድምሳንደትም ተይᎺድሰኮ ዎርሰንታ ዎክያር ኮትም ዎይስሰኬ። <verse eid="JHN 8:3"/><verse number="4" style="v" sid="JHN 8:4"/>የሱሰመረ፥ “ኤስስንባቦ፥ ኮሰቼ፥ ኮና ኤተና ኮት ቤልምድንካ ና የድምሴ፥ <verse eid="JHN 8:4"/><verse number="5" style="v" sid="JHN 8:5"/>ኮግንዳ ማነና ሰይንካ አቀርሶ ኮት ደእድንግንዳ ሙሳ ዎንታ ህግንካ ክቴ፥ የና ኮትጎካ Ꮊረስ ጋይዳ?” ኩን ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">8፡5 </char><char style="xt" closed="false"><ref loc="EXO 20:10">ዉት. 20፡10</ref>፤ <ref loc="DEU 22:22-24">ካሪ. 22፡22-24</ref>። </char></note> <verse eid="JHN 8:5"/><verse number="6" style="v" sid="JHN 8:6"/>ኮመረ ከት ጋይሳንዳ ክታዘን ክስታ ጎግ ከት Ꮊፍተርንግንዳ ክትም ጰጫካንታ ዝግሶ Ꮊቄ፥ የሱስ ማቼ ይርክን ጋይሶ ይንታ ግልኤካ ፍጨዘን ጻፍ የጄ።<verse eid="JHN 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 8:7"/>ካርንካ ካርንካ ኬት ክትም ኦይሳንደትካ ጬክን ጋይሶ፥ “የንታ ዎክያርንካ ጎማ ካየንባብ እርምሶ ሰይንካ ኮትም አቃ!” ከትም ጋይሴ። <verse eid="JHN 8:7"/><verse number="8" style="v" sid="JHN 8:8"/>ኮታ ቡረረ ካርንካ ይርክን ጋይሶ ፍጨዘን ጻፍሴ። <verse eid="JHN 8:8"/><verse number="9" style="v" sid="JHN 8:9"/>ከተረ ኮም ኤሰርሳንደትካ ጋልተን ኬዘንካ የድሶ ሙደና ዋልቃ ዋልቃ ጋየረኮ ኮታዘንካ አይትበእሰኬ፥ ኮካንታ የሱስ ከታ ዎክናር ዎእሶ Ꮊቃን ኤተንከ ክትከ Ꮊክ ነገዴ። <verse eid="JHN 8:9"/><verse number="10" style="v" sid="JHN 8:10"/>ኮታ ቡር የሱስ ጬክን ጋይሶ፥ “የና ኤተኖ የስም ካሰስንባብከስ Ꮊማ? የዘን ፋረጅባብከስ Ꮊየሰነረ ካዮ?” ኮደር ጋይሴ።<verse eid="JHN 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11"/>ናየረ “የባቦ! Ꮊየሰነረ ካዬ” ና ጋይሴ። የሱሰረ “እተረ የዘን ፋረዳክቴ፥ አይካ፥ ካርንካ ጎማ Ꮊይፍክሴ” ኮትም ጋይሴ።<note caller="+" style="f"><char style="fr" closed="false">8፡11 </char><char style="ft" closed="false">በድ ኤና እር ጻፈርሳንደትከ ኤና እር ቡልንከስ 7፡53—8፡11 ዶቅድባብከስም ጉጃየኬ፥ ዋልቃ ዋልቀንከስ፥ ዮሀ. 21፡24 ቡር አርጅደኬ፥ አብንከሰረ ጉጅሶ ሉቃ. 21፡38 ቡር አርጅደኬ፥ ዋልቃ ኤና እር ጻፈርሳንደረ ጉጅሶ ዮሀ. 7፡36 ቡር አርጅደኬ። </char></note><verse eid="JHN 8:11"/></para>
  <para style="s1">የሱስ ፍጫሙደንታ ሳክማ ማትንተና</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12"/>ካርንከረ የሱስ “እታ ፍጫሙደንታ ሳክምቴ፥ እም ጎርስምድባብ ሙደና ሰንፔታ ሳክመን Ꮊብዴ፥ ኡምናረረ ኖ ኦንጋዬ” ጋየሮ ከትካንታ ኬዜ።<note caller="-" style="x"><char style="xo" closed="false">8፡12 </char><char style="xt" closed="false"><ref loc="MAT 5:4">ማቶ. 5፡4</ref>፤ <ref loc="JHN 9:5">ዮሀ. 9፡5</ref>። </char></note><verse eid="JHN 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13"/>ፈረሳዊያንንከስ “የና የስታ ማታካንታ ማርከርደዬ፥ የስታ ማርከርና ዶፈን ካዬ” ከታ ጋይሰኬ።<note caller="-" style="x"><char style="xo" closed="false">8፡13 </char><char style="xt" closed="false"><ref loc="JHN 5:31">ዮሀ. 5፡31</ref>። </char></note><verse eid="JHN 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14"/>የሱሰረ፥ “Ꮊረሰነረ ዎራ እታ እስታ ማታ ካንታ እ ማርከርሰረ Ꮊብንካ እ Ꮊዳናንከረ፥ Ꮊብር እ አይዳናንከረ እ ኤዝድንካንታ እስታ ማርክርና ዶፈኔ፥ የታ ማቼ Ꮊብንካ እ Ꮊዳናንከ Ꮊብር እ አይዳናንከረ የታ ኤዝዳከቴ። <verse eid="JHN 8:14"/><verse number="15" style="v" sid="JHN 8:15"/>የታ ዋሄታ ገቅርካ ፋረደቴ፥ እታ Ꮊየንዘነረ ፋረዳይቴ። <verse eid="JHN 8:15"/><verse number="16" style="v" sid="JHN 8:16"/>እ ፋረጀረ ዎራ እም ኦይችባብ ሳብ ባቤና እንካ ክክን ማቻንጎከ እታ እስት እ ፋረዳይንካንታ እስታ ፍርደና ዶፈኔ። <verse eid="JHN 8:16"/><verse number="17" style="v" sid="JHN 8:17"/>ቃሰተን ኤድንከስታ ማርክርና ዶፈን ማቻንደትም የንታ ህግናር ጻፍምቴ። <verse eid="JHN 8:17"/><verse number="18" style="v" sid="JHN 8:18"/>ኮካንታ እታ እስታ ማታካንታ ማርከርድቴ፥ እም ኦይችባብ ሳብ ባቤና እጎካ ማርከርዴ።” <verse eid="JHN 8:18"/><verse number="19" style="v" sid="JHN 8:19"/>ኮታይካ ከታ “የስታ ባቤና Ꮊማ?” ጋይሰኮ ክትም ኦይሰኬ። የሱሰረ “እመረ ማታ እስታ ባቤንም የታ ኤሳየቴ፥ እም የ ኤዝደስ ናና እስታ ባቤንመረ ኤዝደት ዶቆ” ጋይሶ ከትካንታ ማስሴ።<verse eid="JHN 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20"/>የሱስ ኮም ቃለንም ክት ኬዛንደና ሳብታ ጭል ኤሄናር ብረንም ተየርድን ሳጥንታ ባንግር ዎእሶ ኤስዝድንኬ። ይና፥ ክታ ሰጨና አክ የላክንካንታ Ꮊየሰነረ ክትም የዳክዬ።<verse eid="JHN 8:20"/></para>
  <para style="s1">አሜንክሳ ነግንታጎካ እምምሳንዳ ኤግዝምስ</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21"/>ካርንከረ የሱስ፥ “እታ አይድቴ፥ የተረ እም ዝግደቴ፥ ኬዛርካ ማቸ የንታ ጎመንካ የካ ደእደት ዳት እ አይድንደታር የታ Ꮊድካንታ ማተየቴ ጋይሶ ማስሴ።”<verse eid="JHN 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22"/>አይሁድንታ ገችንባብከሰረ “ ‘እ አይድንደታር የታ Ꮊድካንታ ማታየቴ’ ክታ ጋይና ይንታ ማተንም ደይሳካንታ ማተርዳቶ?” ክክ ጋይሰኬ።<verse eid="JHN 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23"/>ኮታዘንከረ የሱስ፥ “የታ ታማርንከቴ፥ እታ ዘርማርንክቴ፥ የታ ኮ ፍጫሙደንዘንከቴ፥ እታ ኮ ፍጫሙደንዘንካ ካይቴ፥ <verse eid="JHN 8:23"/><verse number="24" style="v" sid="JHN 8:24"/>እስታ ኤደትቸንም ኤስሰቶ የ አሜናክንዳ ማቼ የታ የንታ ጎመንካ የ ደእድባብከስ ማቻንካንታ የታ ደእደቴ እ ጋይሳንደና ኮካንቴ ኩን ከትም ጋይሴ።”<verse eid="JHN 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25"/>ከተረ “የና Ꮊይራ?” ጋይሰኬ።</para>
  <para style="p" vid="JHN 8:25">የሱሰረ፥ “እርንደትዘንካ አምስስቶ የካንታ እ ከዛንግንድቴ፥ <verse eid="JHN 8:25"/><verse number="26" style="v" sid="JHN 8:26"/>የጎካ እ ከዝድንደትኬ እ ፋረድንደና በድ ሪ እዝደር ዶቅዴ፥ ማታጋካ ዳት እም ኦይችባብ ኖ ዶፈኔ፥ እተረ ኮ ፍጫሙደንካንታ እኬዝድንደና ክታዘንካ እ ኤሰርሳንደትሜ ኩን ከደር ጋይሴ።”<verse eid="JHN 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27"/>ከታ ማቼ ሳብ ባቤንጎካ ክት ኬዛንዳ ከትም አርዳክዬ። <verse eid="JHN 8:27"/><verse number="28" style="v" sid="JHN 8:28"/>ኮካንታ የሱስ፥ “ኤድ ይንችም ጬክሳ ይሴቶ የ ሮግድንᎺይካ እ ክት ማቻንደትም የታ ኤስተረቴ፥ ኮትኮግንደረ ሳብ ባቤና እም ኤስሳንደትም እ ኬዝድንግንዳ ዳት እስታ ገችታ ኤረንካ Ꮊክ Ꮊረሰነረ እ ይዳክንደትም ኮትᎺይካ የታ ገቀርተረቴ። <verse eid="JHN 8:28"/><verse number="29" style="v" sid="JHN 8:29"/>እም ኦይችባብ እንካ ክክኔ፥ ሙዳᎺይካ እ ይድንደና ክትም ጉርምዝድን ሪ ማቻንካንታ እም Ꮊክ ኖ ዛቃክዬ” ከትም ጋይሴ።<verse eid="JHN 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 8:30"/>የሱስ ኮም ከዛንደትᎺይካ በድ ኤድንከስ ክትካ አመንሰኬ።<verse eid="JHN 8:30"/></para>
  <para style="s1">ጎመታ አይላትቻርንካ ዉች ዉትንተታ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31"/>የሱስ ክትካ አሜንስባብ አይሁድን፥ “የታ እስታ ቃለናር የ ዶቅሴ ገታ እስታ ካርንካ ጎርስምድባብ ማተረቴ፥ <verse eid="JHN 8:31"/><verse number="32" style="v" sid="JHN 8:32"/>ዶፈንን የታ ኤዝደቴ፥ ዶፈነረ ዉች የም ዉችዝዴ” ከትም ጋይሴ።<verse eid="JHN 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33"/>ከታ ማቼ። “ዎታ አብራሀመታ ይንቾቴ፥ ቦድሶ Ꮊየንካንተረ አይላ ማትሶቶ ኤዝዳኮቴ፥ ይና፥ የና ‘ዉች ዉተረቴ’ የስ ዎም ጋይድንደና Ꮊስግንደረ?” ጋይሰኬ።<note caller="-" style="x"><char style="xo" closed="false">8፡33 </char><char style="xt" closed="false"><ref loc="MAT 3:9">ማቶ. 3፡9</ref>፤ <ref loc="LUK 3:8">ሉቃ. 3፡8</ref>። </char></note><verse eid="JHN 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34"/>የሱሰረ፥ “ዶፈን ዶፈን የም ጋይድቴ፥ ጎማ ፍግዝድባብ ሙደና ጎመታ አይሌ፥ <verse eid="JHN 8:34"/><verse number="35" style="v" sid="JHN 8:35"/>አይላ ሙዳᎺይካ ኤር ዶቃዬ፥ ይንች ማቼ ሙዳᎺይካ ኤር ዶቅዴ። <verse eid="JHN 8:35"/><verse number="36" style="v" sid="JHN 8:36"/>ኮካንታ ሳብ ይንችና ዉች የም ዉችሴ ገታ ዉች ማደቴ። <verse eid="JHN 8:36"/><verse number="37" style="v" sid="JHN 8:37"/>አብራሀመታ ይንች የንታ ማትንተንም እታ ኤዝድቴ፥ ኬዛር ማቼ እስታ ቃለንም የ ተይዳክንካንታ እም ደይሳካንታ ዝግደቴ። <verse eid="JHN 8:37"/><verse number="38" style="v" sid="JHN 8:38"/>እታ እስታ ባበንታ ባንግር እ ሰዳንደትም ኬዝድቴ፥ የታ ማቼ የንታ ባቤንዘንካ የ ኤሰርሳንደትም ይደቴ ኩንጋየሮ ከትካንታ ማስሴ።”<verse eid="JHN 8:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39"/>ከተረ “ዎንታ ባቤነና አብራሀሜ” ጋየረኮ ክትካንታ ማስሰኬ። የሱሰረ፥ “አብራሀመታ ይንች የ ማቸስ ናና አብራሀመታ ፍክስንም ፍግዝደትዶቆ፥ <verse eid="JHN 8:39"/><verse number="40" style="v" sid="JHN 8:40"/>እታ ሳብዘንካ እ ኤሰርሳንደትም ዶፈንን የካንታ ከዛቴ፥ የታ ማቼ ደይሳካንታ እም ዝግደቴ፥ አብራሀመረ ኩን ይያክዬ። <verse eid="JHN 8:40"/><verse number="41" style="v" sid="JHN 8:41"/>ይና የታ የ ፍግዝድንደና የንታ ባቤንታ ፍክስኔ” ኩን ከትም ጋይሴ። ከተረ “ዎታ ቤልምካ አጥምሶ ቡቅምስባብ ካዮቴ፥ ዋልቃ ዎንታ ባቤና ዶቅዴ፥ ኖየረ ሳብዬ” ጋይሰኬ።<verse eid="JHN 8:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42"/>የሱሰረ፥ “ሳብ የንታ ባቤና ማታናና እም ሶልምደት ዶቆ፥ እታ ኮር እ Ꮊዳንዳ ሳብደርንከ፥ እም ኦይችባብ ኖ ዳት እታ እስታ ገችንታ ኤረንካ Ꮊዳክቴ። <verse eid="JHN 8:42"/><verse number="43" style="v" sid="JHN 8:43"/>Ꮊረተረ እስታ ኬዘና የም አርዳይንደና? እስታ ኬዘንም ኤስርካንታ የ ዝጋይንካንቴ። <verse eid="JHN 8:43"/><verse number="44" style="v" sid="JHN 8:44"/>የታ የንታ ባቤን ዳብሎስታ ይንቸቴ፥ የንታ ዝግመትነረ የንታ ባቤንታ አግርንም ቦችዬ፥ ኖ እርንደትዘንካ የድሶ ሰንፓ ደይዝድባብ Ꮊቄ፥ ዶፈና ክትካ ካየንካንታ ዶፈንካ ክክን Ꮊረሰነረ ዋልቃትች ክታ ካዬ፥ ኖ ካርካባብኬ ካርካ ሙደንታ ባቤና ማቻንካንታ ካርከን ከዝድንደትᎺይካ ይንታ ማታርንካ ዉችሶ ኬዝዴ። <verse eid="JHN 8:44"/><verse number="45" style="v" sid="JHN 8:45"/>እታ ማቼ ዶፈንንም እ ከዝድንካንታ እም የታ አመንዳከቴ፥ <verse eid="JHN 8:45"/><verse number="46" style="v" sid="JHN 8:46"/>ማችንከረ የንታርንካ ‘የና ጎማ ባበዬ’ ጋይሶ እም ዳቅልካ ኬዝተርባብ Ꮊይራ? ዶፈንንም እ ኬዝድንዳ ማቼ ኮናና፥ Ꮊረተረ እም የ አመንዳከንዳ? <verse eid="JHN 8:46"/><verse number="47" style="v" sid="JHN 8:47"/>ሳብደርካ ማችባብ ሳብታ ቃለንም ኤሰርዴ፥ ይና የታ ሳብታ ቃለንም ኤሰርዳክባብከስ፥ ሳብደርንካ የ ማታክንካንቴ” ኩን ከትም ጋይሴ።<verse eid="JHN 8:47"/></para>
  <para style="s1">የሱሰኬ አብራሀመካ</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48"/>አይሁድና “የና ሳማራ ኤደዬ፥ ግምዘረ የዘን ዶቅዴ፥ ዎንታ ጋይንተና ገታ ካዮ?” ከታ ጋይሰኬ።<verse eid="JHN 8:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49"/>የሱሰረ፥ “እዘን ግምዛ ካዬ፥ ኬዛር ማቼ እስታ ባቤንም ቦንጅድቴ፥ የታ ማቼ እም ቶጅደቴ። <verse eid="JHN 8:49"/><verse number="50" style="v" sid="JHN 8:50"/>ማታጋካ ዳት እታ እስታ ማታ ቦንቸን ዝጋይቴ፥ እስታ ቦንችምን ዝግድባብከ ፋረድባብ አብ ዶቅዴ። <verse eid="JHN 8:50"/><verse number="51" style="v" sid="JHN 8:51"/>ዶፈን፥ ዶፈን የም ጋይድቴ፥ ቃለንም ካርዝድባብ ቦድሶ ደእዳክዬ” ኩንጋየሮ ከትካንታ ማስሴ።<verse eid="JHN 8:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52"/>አይሁድንከስ፥ “ግምዛ የዘን ዶቅድንደትም ታ ኤሶቴ፥ አብራሀም ዎራ ደእቴ፥ ሳብዘንካ ኤሰርሶ ኬዝድባብከሰረ ደእተኬ፥ የና ማቼ ‘እስታ ቃለንም ካርዝድባብ ደአዬ’ ጋይደዬ፥ <verse eid="JHN 8:52"/><verse number="53" style="v" sid="JHN 8:53"/>ማችንከረ የና ደእስባብ ዎንታ ባቤን አብራሀምዘንካ ስግዳ? ሳብዘንካ ኤሰርሶ ኬዝድባብከስ ደእተኬ፥ ኮናና የና የስታ ማተን Ꮊይመስ ማስዝዳ?” ኩን ጋይሰኬ።<verse eid="JHN 8:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54"/>የሱሰረ፥ “እታ እስታ ማተንም እ ቦንችሴ እስታ ቦንቸና መያዬ እም ቦንጅድባብ እስታ ባበኔ፥ ኖየረ ‘የታ ዎንታ ጮይስዬ’ የ ጋይድባቤ። <verse eid="JHN 8:54"/><verse number="55" style="v" sid="JHN 8:55"/>ማችንከረ የታ ክትም ኤሳከቴ፥ እታ ማቼ ኤዝድቴ፥ እታ ክትም ኤዝዳክቴ እ ጋይዴ የግንዳ ካርካባብ ማድት ዶቆ፥ እታ ማቼ ክትም ኤዝድቴ፥ ክታ ቃለንመረ ካርዝድቴ። <verse eid="JHN 8:55"/><verse number="56" style="v" sid="JHN 8:56"/>የንታ ባቤን አብራሀመታ አግርና እስታ ሰጨንም ሰድሶ ጉርምካንታ Ꮊቄ፥ ሰድሰረ ጉርምሴ” ኩን ጋይሶ ከትካንታ ማስሴ።<verse eid="JHN 8:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57"/>ኮታይካ አይሁድና፥ “የስታ አክ ቃስተን ቦንደከታማ ስላ ዎራ የስታ ማታክዬ፥ ኮናና Ꮊስግንደስ አብራሀመም ሰትቴ ጋይዳ?” ከታ ጋይሰኬ። <verse eid="JHN 8:57"/><verse number="58" style="v" sid="JHN 8:58"/>የሱሰረ “ዶፈን፥ ዶፈን የም ጋይድቴ፥ አብራሀም አጠርተርንርደታ እሪ እታ ዶቅድቴ፥ ታየረ ኦስ እረረ ዶቅድቴ” ከደር ጋይሴ።<verse eid="JHN 8:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 8:59"/>ኮካንታ አይሁድንከስ ክትም አቅና ካንታ ሰይን አምሰኬ፥ የሱስ ማቸ ከታዘንካ አጥምስንደትከ ሳብታ ጭል ኤሄናርንካ ዉትሶ አይሴ።<verse eid="JHN 8:59"/></para>
  <chapter eid="JHN 8"/>
  <chapter number="9" style="c" sid="JHN 9"/>
  <para style="s1">የሱስ አፍይ ዝልይ ማትሶ አጥምስባብ ኤችን ፋችና</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1"/>የሱሰረ ኮትኮ ጎግንካ ስገድንካ አፍይ ዝልይ ማትሶ አጥምስባብ ኤችም ሰጄ። <verse eid="JHN 9:1"/><verse number="2" style="v" sid="JHN 9:2"/>ክታ ካርንካ ጎርስምድባብከስ የሱሰም “ኤስስንባቦ፥ ኮና ኤችና ዝልይ ማትሶ ክት አጥምሳንዳ Ꮊይታ ጎመከረ? ይንታ ጎመኮ አና ክትም አጭባብከስጎኮ?” ጋየረኮ ኦይሰኬ።<verse eid="JHN 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3"/>የሱሰረ፥ “ኮና ኤችና ዝልይ ማትሶ ክት አጥምሳንዳ ክትጎካ አነረ አጥመንባብከስታ ጎመንጎካ ካዬ፥ ኬዛር ማቼ ሳብታ ፍክስና ክትካ መያ ማተርንግንዴ። <verse eid="JHN 9:3"/><verse number="4" style="v" sid="JHN 9:4"/>ሰጨና ዶቅድንካ እም ኦይችባብታ ፍክስንም ፍክስ እም ዝግዝዴ፥ Ꮊየነረ ኤድ ፍክስካንታ ማዳክንዳ ሶይትና Ꮊዴ። <verse eid="JHN 9:4"/><verse number="5" style="v" sid="JHN 9:5"/>ኮ ፍጫሙደንዘን ዶቅድቶ እታ ፍጫሙደንታ ዎርሰንካንታ ሳክምቴ” ኩን ጋይሶ ማስሴ።<note caller="-" style="x"><char style="xo" closed="false">9፡5 </char><char style="xt" closed="false"><ref loc="MAT 5:14">ማቶ. 5፡14</ref>፤ <ref loc="JHN 8:12">ዮሀ. 8፡12</ref>። </char></note><verse eid="JHN 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6"/>ኮም ይ ኬዛንደታ ቡር ፍጨዘን ፈጭምሶ ይንታ ፈጭምንካ ፍጨንም ቶቀልስሶ ቶቅለንከረ ዝልንታ አፍን ሳይስንደትኬ፥ <verse eid="JHN 9:6"/><verse number="7" style="v" sid="JHN 9:7"/>“አይሳዮ ሳሎም ከርምሳን ሎቀናር ስኤርካ” ክትም ጋይሴ። (ሳሎም ጋይንት “ኦይትምስባብ” ጋይንትዬ) ኮካንታ ኤችና አይሶ ስእርንደትኬ ሰደሮ ማቼ።<verse eid="JHN 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8"/>የለንከስኬ ኤና እሪ ክት ምግዝድንካ ሰድᎺቅባብከስ “ኮና ኤችና ዶቅሶ ምክሰሮ Ꮊቅባብ ኖ ካዮ?” ጋይሰኬ። <verse eid="JHN 9:8"/><verse number="9" style="v" sid="JHN 9:9"/>ዋልቃ ዋልቀንከስ “ይዬ፥ ኖዬ!” ጋይሰኬ፥ አብንከስ ጉጅሶ “ክትም ካምዳ ዳት ኖ ካዬ!” ጋይሰኬ። ኖ ማቼ “እትቴ!” ጋይሴ። <verse eid="JHN 9:9"/><verse number="10" style="v" sid="JHN 9:10"/>ኤድንከሰረ “ኮናና የስታ አፍንከስ Ꮊስግንዶክ ፎችምሳሬ?” ክትም ጋይሰኬ። <verse eid="JHN 9:10"/><verse number="11" style="v" sid="JHN 9:11"/>ኖየረ “የሱስ ጋይምስባብ ኤች ቶቅላ ቶቀልስሶ እስታ አፍንከስም ሳይሶ ‘ኦስ ሳሎማር አይሳዮ ስኤርካ’ እም ጋይሴ። እተረ አይስቶ ስኤርስቶ ሰድንካንታ ማቻቴ” ጋየሮ ማስሴ። <verse eid="JHN 9:11"/><verse number="12" style="v" sid="JHN 9:12"/>ከተረ “ኖ ኤችና ታ Ꮊብረረ?” ጋይሰኬ። ኖየረ “Ꮊብር ክት ዶቅዳናንከረ እታ ኤሳይቴ” ከደር ጋይሴ።<verse eid="JHN 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13"/>ኮታ ቡር ኤድንከስ አፍይ ዝልን ማትሶ Ꮊቅባብ ኤችን ኦስ ፈረሳያዊንንከዝደር ተይ አይሰኬ። <verse eid="JHN 9:13"/><verse number="14" style="v" sid="JHN 9:14"/>የሱስ ቶቅለንካ ኤችንታ አፍን ከስ ሰድንግንዳ ክት ይሳንዳ አይሁድንታ Ꮊዉስ ሰጨንካ Ꮊቄ። <verse eid="JHN 9:14"/><verse number="15" style="v" sid="JHN 9:15"/>ፈረሳዊያንንከስ “Ꮊስግንደስ ሰድካንታ ማቻሬ?” ጋይሰኮ ኤችንም አናካርንካ ኦይሰኬ። ኖየረ “እስታ አፍንከዘን ቶቅላ ሳይስንካ ስኤርስቴ፥ ኮታ ቡር ሰድንካንታ ማችቴ” ጋይሴ።<verse eid="JHN 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16"/>ኮትᎺይካ ፈርሳውያንከሳርንካ ዋልቃ ዋልቀንከስ፥ “ኮና ኤችና አይሁድንታ Ꮊዉስ ሰጨንም ክት ቦንጅዳክን ኦል ሳብዘንካ ካዬ” ጋይሰኬ። አብንከስ ማቼረ “ኮናና ጎመካ ማችባብ ኤድ ከነም አታ ቃዉተን Ꮊስግንድክ ፍክስካንታ ማዳ?” ጋይሰኬ። ኮጎካ ከታ ዎክያር ፋስም ማቼ።<verse eid="JHN 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17"/>ኮካንታ አፍይ ዝልይ Ꮊቅባብ ኤችና፥ “የና የስታ አፍንከስም ሰችሴ የስ ጋይድን ኤችንጎካ የና Ꮊረስ ጋይዳ?” ጋየረኮ ጉጅሶ ክትም ኦይሰኬ። ኖየረ “ሳብዘንካ ኤሰርሶ ኬዝድባቤ!” ጋይሴ። <verse eid="JHN 9:17"/><verse number="18" style="v" sid="JHN 9:18"/>ኮና ኤችና አፍይ ዝልይ ማትሶ ክት Ꮊቃንደትምኬ ክታ አፍንከሰረ ቡር Ꮊስግንዳ ፎችምሳናነረ ክትም አጭባብከስም ኤልሶ ከታ ይ ኦይስተርን የለልታ አይሁድንታ ገችንታ ኤረንባብከስ አሜናከኬ። <verse eid="JHN 9:18"/><verse number="19" style="v" sid="JHN 9:19"/>ኮካንታ ክትም አጭባብከስም፥ “ዝልይ ማትሶ አጥምሴ የ ጋይድባብ የንታ ይንችና ኮና ኖ? ታ Ꮊስግንድክ ሰድንካንታ ማቻራ?” ጋየረኮ ኦይሰኬ።<verse eid="JHN 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20"/>ክትም አጭባብከሰረ፥ “ኮና ዎንታ ይንች ክት ማቻንደትምከ ዝልይ ማትሶ ክታ አጥርን ኤዝዶቴ፥ <verse eid="JHN 9:20"/><verse number="21" style="v" sid="JHN 9:21"/>ኬዛር ማቼ ታ Ꮊስግንዳ ክት ሰዳናነረ አፍንከስመረ Ꮊይ ክትካንታ ሰችሳናነረ ዎታ ኤሳዮቴ፥ ክትም ኦይስከቴ፥ ኖይንታ ማተን ኤስባብ ክት ማቻንካንታ ኖ ይጎካ ኬዛካንታ ማዴ” ኩንጋየሮ ማስሰኬ። <verse eid="JHN 9:21"/><verse number="22" style="v" sid="JHN 9:22"/>ክትም አጭባብከስ ኮም ከት ጋይሳንዳ የሱሰም “ሳይምስባቤ” ጋይድባብ ኤድ ዶቅሴ አይሁድንከስታ ገችንታ ኤረንባብከስ አይሁድንታ ምክስ ኤሄናርንካ ክትም ዉችካንታ ክክን ከት ኤእሶ Ꮊቅንካንታ ከትም ጳስኬ። <verse eid="JHN 9:22"/><verse number="23" style="v" sid="JHN 9:23"/>ኮካንታ ክትምአጭባብከስ፥ “ኖይንታ ማተን ኤስባብ ኤዴ፥ ክትም ኦይስከቴ” ኩን ጋየረኮ ማስሰኬ።<verse eid="JHN 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24"/>ኮጎካ ዝልይ ማትሶ Ꮊቅባብ ኤችን አነታ ኤልትዮ “የና ዶፈንን ኬዝካ ሳብም ቦንችካ፥ ኮና ኤችና ጎማባብ ማትንተን ዎተረ ኤዝዶቴ” ጋይሰኬ።<verse eid="JHN 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25"/>ዝልይ ኤችነረ፥ “ኖ ጎማባብ ክታ ማትንተንም እታ ኤሳይቴ፥ ዋልቃ ሪ ኤዝድቴ፥ ኮነረ እታ ዝልይ ማትስቶ እ Ꮊቃንደትምኬ ታ ሰድንካንታ እ ማቻንደትም ኮም Ꮊክ ኤዝድቴ” ጋየሮ ማስሴ። <verse eid="JHN 9:25"/><verse number="26" style="v" sid="JHN 9:26"/>ከተረ “Ꮊርክ የስካንታ ይሳሬ? የስታ አፍንከስም ክት ሰድንግንዳ ይስሳንዳ Ꮊስግንደረ?” ጋይሰኬ። <verse eid="JHN 9:26"/><verse number="27" style="v" sid="JHN 9:27"/>ኖየረ “እርምስቶ የም ከዛቴ፥ የታ ማቼ ኤስርካንታ ዝጋከቴ፥ ይና፥ Ꮊራካንተንት አናካርንካ ኤስርካንተንት ዝግዳ? የተረ ክታ ካርንካ ጎርስምድባብ ማትካንታ ዝግደቴ?” ከትም ጋይሴ። <verse eid="JHN 9:27"/><verse number="28" style="v" sid="JHN 9:28"/>ከተረ፥ “ክታ ካርንካ ጎርስምድባብ የነዬ፥ ዎታ ማቼ ሙሴታ ካርንካ ጎርስምድባቦቴ፥ <verse eid="JHN 9:28"/><verse number="29" style="v" sid="JHN 9:29"/>ሳብ ሙሴም ከስሳንደትም ኤዝዶቴ፥ ኮና ኤችና ማቼ Ꮊብርንካ ክት ናነረ ዎታ ክትም ኤሳዮቴ” ኩን ጋየረኮ ክትም የክሰኬ።<verse eid="JHN 9:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30"/>ኤችነረ፥ “ኮና ኤችና Ꮊብርንካ ክት ናነረ የንታ ኤስክሳ ነግና በርእስዝዴ! ኬዛር ማቼ እስታ አፍንከስም ሰችስባብ ኖዬ። <verse eid="JHN 9:30"/><verse number="31" style="v" sid="JHN 9:31"/>ሳብ ጎመንባብከስም ኤሰርዳክንዳ ኤስምሳንዴ፥ ኬዛር ማቼ ሳብም ጎይንድባብከ ክታ ጋይተንም ቦድባብ ኤድ ዶቅሴ ክትም ሳብ ኤሰርዴ። <verse eid="JHN 9:31"/><verse number="32" style="v" sid="JHN 9:32"/>ዝልይ ማትሶ አጠርምስባብ ኤታ አፍንከስም ሰችስባብ ዶቅዴ ጋይምድንካ ፍጫ ሙደና ፍዝምሳንደትዘንካ የድሶ ኤስርምሶ ኤስማዬ። <verse eid="JHN 9:32"/><verse number="33" style="v" sid="JHN 9:33"/>ኮና ኤችና ሳብዘንካ ይ ማታክናና Ꮊረሰነረ ይካንታ ማታይ ዶቆ” ኩን ጋይሶ ማስሴ።<verse eid="JHN 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34"/>ከተረ “የስታ ኤደትቼና ጎመካ ጮጭንካ አጥምስባብ! የና ዎም ኤስስካንቶ?” ጋይሰኮ አይሁድንታ ምክስ ኤሄናርንካ ክትም ዉችሰኬ።<verse eid="JHN 9:34"/></para>
  <para style="s1">አያናር አፍይ ዝልይ ማትና</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35"/>ኤችንም አይሁድንታ ምክስ ኤሄናርንካ ዉችሳንደትም የሱስ ኤሰርሴ፥ ክትም Ꮊፍሳንደትከረ “ኤደት ይንችካ የና አመንዳ?” ክትም ጋይሴ። <verse eid="JHN 9:35"/><verse number="36" style="v" sid="JHN 9:36"/>ኖየረ “ጮይስዮ! ክትካ እ አሜንድንግንዳ ኖ Ꮊይራ?” ጋይሴ። <verse eid="JHN 9:36"/><verse number="37" style="v" sid="JHN 9:37"/>የሱስ “ኮታ እሪ የና ክትም ሰተዬ፥ ታየረ የስም ከስዝድባብ ኖዬ” ጋይሴ። <verse eid="JHN 9:37"/><verse number="38" style="v" sid="JHN 9:38"/>ኖየረ “ጮይስዮ! እታ አመንድቴ” ጋይሶ ክትካንታ ጎስትሴ። <verse eid="JHN 9:38"/><verse number="39" style="v" sid="JHN 9:39"/>የሱሰረ “ሰዳክባብ ሰድንግንዳ፥ ሰድባብከሰረ ከታ አፍና ዝልድንግንዳ እታ ኮ ፍጫሙደንዘን ፋረድካንታ Ꮊትቴ” ጋይሴ። <verse eid="JHN 9:39"/><verse number="40" style="v" sid="JHN 9:40"/>ኮታይካ የሱሰታ ላመር Ꮊቅባብከስ ፈረሳዊያንንከስ ኮም ኤሰርሰኮ “ኮናና ዎተረ ዓፊይ ዝል ማቾቶ?” ክደር ጋይሰኬ። <verse eid="JHN 9:40"/><verse number="41" style="v" sid="JHN 9:41"/>የሱሰረ “ዝልንከስ የ ማተስናና ጎማ የንታዘን ማዳክዶቆ፥ ታ ማቼ ሰዶቴ የ ጋይድንካንታ፥ ጎመንክንባብከስ ማትሰቶ ነገደቴ” ከደር ጋይሴ።<verse eid="JHN 9:41"/></para>
  <chapter eid="JHN 9"/>
  <chapter number="10" style="c" sid="JHN 10"/>
  <para style="s1">የሱሰታ ኡርማ ግስመና</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1"/>ኮታዘንከረ የሱስ፥ “ዶፈን፥ ዶፈን የም ጋይድቴ፥ ቆልንከስታ ካለንደር ፍልተካ ማታክናና አብጎካ አርድባብ ኤድ ድብኬ ፋንገኬ። <verse eid="JHN 10:1"/><verse number="2" style="v" sid="JHN 10:2"/>ፍልተንካ አርድባብ ማቸ ኖ ቆልንከስታግስመንባቤ። <verse eid="JHN 10:2"/><verse number="3" style="v" sid="JHN 10:3"/>ክትካንታ ፍልተንታ ካርስንባብ ፍልተን ክትካንታ ፎጅዴ፥ ክታ ቆልንከስ ክታ ኡፍስን ኤሰርደኬ፥ ኖየረ ይንታ ቆልንከስም ከታ ላምንካ ከትም ኤልዴ፥ ከትም ጎርሰሮ ማል ዉችዝዴ። <verse eid="JHN 10:3"/><verse number="4" style="v" sid="JHN 10:4"/>ይንታ ቆልንከስም ይ ዉችሳንደታ ቡረረ ከታ እሪ እሪ ኖ አይዴ፥ ክታ ቆልንከሰረ ክታ ኡፍስን ይ ኤዝድንካንታ ክትም ጎርስምደኬ። <verse eid="JHN 10:4"/><verse number="5" style="v" sid="JHN 10:5"/>አብንታ ኡፍስንም ማቼ ከታ ኤዝዳክንካንታ ክታዘንካ አጥምደክ ዳት ጎርስምዳከኬ” ጋይሴ።<verse eid="JHN 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 10:6"/>የሱስ ኮም ካምስንም ከትካንታ ኬዜ፥ ከታ ማቼ ኬዛንደትም ገቀርት ተያከኬ።<verse eid="JHN 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7"/>ኮካንታ የሱስ ካርንካ፥ ዶፈን፥ ዶፍን የም ጋይድቴ፥ እታ ቆልንከስታ ፍልትቴ፥ <verse eid="JHN 10:7"/><verse number="8" style="v" sid="JHN 10:8"/>እስታ እሪ Ꮊድባብከስ ሙደና ድብንከስኬ ፋንገንከሰኬ፥ ቆልንከስ ማቼ ክትም ኤሰራከኬ። <verse eid="JHN 10:8"/><verse number="9" style="v" sid="JHN 10:9"/>ፍልተና እትቴ፥ እዝደርጎካ አርድባብ አቅዴ፥ አርዴ፥ ዉዴ፥ ግስምድን ካረረ Ꮊብዴ። <verse eid="JHN 10:9"/><verse number="10" style="v" sid="JHN 10:10"/>ድብና Ꮊድንዳ ድብካንታ፥ ማችካንተኬ ካይስካንታ Ꮊክዬ፥ እታ ማቼ እ Ꮊድንዳ ሰንፓ ከት Ꮊብድንግንደኬ ጮጭ ማቻን ዶቅንትን ከት ዶቅተርንግንዳ ከትም ጋይሴ።<verse eid="JHN 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11"/>ኮትኮግንደረ “ኡርማ ግስመንባብ እትቴ፥ ኡርማ ግስመንባብ ይንታ ሰንፔንም ይንታ ቆልንከስካንታ ስክስት እምዴ። <verse eid="JHN 10:11"/><verse number="12" style="v" sid="JHN 10:12"/>ቆልንከስ ክታ ማታክባብ ሰጫካንታ ዳት ዶፈን ማታክን ግስመንባብና ማቼ ፉገና Ꮊድንካ ኖ ይ ሰዳንደትካ ቆልንከስም ዛቅሶ አጥምዴ፥ ፉገነረ ቆልንከስም ቡርሶ ከትም ይጭዴ። <verse eid="JHN 10:12"/><verse number="13" style="v" sid="JHN 10:13"/>ግስመንባብና ክት አጥምድንደረ ሰጫካንታ ግዝድባብ ማቻንካንተኬ ቆልንከስካንተረ ገቀርዳክንኦሌ። <verse eid="JHN 10:13"/><verse number="14" style="v" sid="JHN 10:14"/>ኡርማ ግስመንባብ እትቴ፥ እታ እስታ ቆልንከስም ኤዝድቴ፥ እስታ ቆልንከሰረ እም ኤዝደኬ።<note caller="-" style="x"><char style="xo" closed="false">10፡14 </char><char style="xt" closed="false"><ref loc="MAT 11:27">ማቶ. 11፡27</ref>፤ <ref loc="LUK 22:33">ሉቃ. 22፡33</ref>፤ <ref loc="DEU 24:16">ካሪ. 24፡16</ref>። </char></note> <verse eid="JHN 10:14"/><verse number="15" style="v" sid="JHN 10:15"/>እታ ከትም እ ኤዝድንዳ ሳብ ባቤና እም ኤዝድንደትግንደኬ እተረ ሳብ ባቤንም እ ኤዝድንደትግንዴ፥ እታ እስታ ቆልንከስካንታ እስታ ሰንፔንም ስክስት እምድቴ። <verse eid="JHN 10:15"/><verse number="16" style="v" sid="JHN 10:16"/>ኮ ዉደንከስታ ዋር ማታክባብከስ አብ ቆልንከስ እስታ ዶቅደኬ፥ ከትመረ ተይ Ꮊድንት እም ዝግዝዴ፥ ከታ እስታ ኡፍስን ኤሰርደኬ፥ ዋልቃ ዉዳ ማደኬ፥ ግስመንባበረ ዋልቃ ማዴ”።<verse eid="JHN 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 10:17"/>“አናካርንካ ማስት እ ኮትም ተይተርንግንዳ ሰንፔን እስታ እ እምድንካንታ ሳብ ባቤና እም ሶልምደ። <verse eid="JHN 10:17"/><verse number="18" style="v" sid="JHN 10:18"/>እስታ ሰንፔንም እስታ ጋይተካ እምድት ዳት እዘንካ ኮትም ተይድባብ Ꮊየነረ ካዬ፥ እስታ ሰንፔንም እምካንተኬ ማስት ተይካንታ ገችታ ኤራ እስታ ዶቅዴ፥ ኮም ክተንም እ ተያንዳ እስታ ባቤንዘንኬ” ጋይሴ።<verse eid="JHN 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19"/>ኮ ኬዘንዘንካ አምሳንዳ አይሁድንከስታ ዎክያር አናካርንካ ፋስም ማቼ። <verse eid="JHN 10:19"/><verse number="20" style="v" sid="JHN 10:20"/>ከታርንከረ በድንከስ፥ “ክታዘን ግምዛ ዶቅዴ፥ ኤይቴ፥ Ꮊረተንት ክትም ኤሰርዳ?” ጋይሰኬ።<verse eid="JHN 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21"/>አብንከስ “ኮና ኬዘና ግምዛ ዶቅድን ኤታ አድማርንካ ዉድንዳ ካዬ፥ ግምዘና ዝልንታ አፍን ሰችካንታ ማትሮ?” ጋይሰኬ።<verse eid="JHN 10:21"/></para>
  <para style="s1">አይሁድንከስታ አሜንክሳነግና</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22"/>የሩሳሌማር ሳብታ ጭል ኤሄን ኡርስታ ባአልን ቦንችምድን ሰጨና የልሴ፥ ለእነረ በርግ Ꮊቄ። <verse eid="JHN 10:22"/><verse number="23" style="v" sid="JHN 10:23"/>የሱስ ሳብታ ጭል ኤሄናር ሰለሞንታ ኤሄንታ ፍልተዘንጎካ ኦንገሮ Ꮊቄ። <verse eid="JHN 10:23"/><verse number="24" style="v" sid="JHN 10:24"/>ኮትᎺይካ አይሁድና ክታ ካንተንካ ሳንሰኮ፥ “Ꮊንታ የለልተስ Ꮊኤርካ ዎም ዶቅስተራ? የና ሳይምስባብ የስ ማቻን መያ ዎም ከስካ” ጋይሰኬ።<verse eid="JHN 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25"/>የሱሰረ፥ “እታ የም ከዝትቴ፥ የታ ማቼ አመንዳከቴ፥ እስታ ባቤንታ ላምካ እ ፍግዝድን ፍክስና እጎካ ማርከርዴ። <verse eid="JHN 10:25"/><verse number="26" style="v" sid="JHN 10:26"/>የታ ማቼ እስታ ቆልንከሳርንካ የማታክን ካንታ አመንዳከቴ። <verse eid="JHN 10:26"/><verse number="27" style="v" sid="JHN 10:27"/>እስታ ቆልንከስ እስታ ኡፍስን ኤሰርደኬ፥ እተረ ከትም ኤዝድቴ፥ ከተረ እም ጎርስምደኬ። <verse eid="JHN 10:27"/><verse number="28" style="v" sid="JHN 10:28"/>እታ ስለንክንደታ ዶቅንትን ከትካንታ እምድቴ፥ ኮካንታ ቦድሶ ካይዳከኬ፥ እስታ አንያርንካ Ꮊየነረ ዉስት ከትም ተያዬ። <verse eid="JHN 10:28"/><verse number="29" style="v" sid="JHN 10:29"/>ከትም እካንታ እምስባብ እስታ ባቤና ሙደንዘንካ ስገዴ። እስታ ባቤንታ አንናርንካ ከትም ዉስትዮ ተይካንታ ማድባብ Ꮊየነረ ካዬ። <verse eid="JHN 10:29"/><verse number="30" style="v" sid="JHN 10:30"/>እንከኬ ሳብ ባቤንካ ዋልቆቴ” ኩን ጋይሶ ማስሴ።<verse eid="JHN 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31"/>ኮትኮᎺይካ አይሁድና የሱሰም አቅና ካንታ አነታ ሰይን አምሰኬ። <verse eid="JHN 10:31"/><verse number="32" style="v" sid="JHN 10:32"/>የሱሰረ “ሳብ ባቤንደርንካ በድ ኡርማ ፍክስንከስም የም ሰችስቴ፥ ይና ኮናና፥ የ እም አቅድንዳ ከትከናከሳርንካ Ꮊምን ፍክስንጎከረ?” ከደር ጋይሴ።<verse eid="JHN 10:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33"/>አይሁድነረ “ዎ የስም አቅድንዳ ሳብዘን የክይ ኬዘን የስ ኬዛንካንታ ዳት የስታ ኡርማ ፍክስንካንታ ካዬ፥ ኮነረ የና ኤድ ማትሶ ዶቅደዮ፥ የስታ ማተንም ጮይስ የስ ማስሳን ካንቴ” ጋየሮ ክትካንታ ማስሰኬ።<verse eid="JHN 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34"/>የሱሰረ፥ “የንታ ህግናር ‘የታ ጮይስንከሰቴ እታ ጋይሳቴ’ ጋይድንዳ ጻፍምታ ካዮ?<note caller="-" style="x"><char style="xo" closed="false">10፡34 </char><char style="xt" closed="false"><ref loc="PSA 82:6">የቺ 82፡6</ref>። </char></note> <verse eid="JHN 10:34"/><verse number="35" style="v" sid="JHN 10:35"/>ይና ጭል ማጻፍንም ሳይማዬ፥ ሳብታ ቃላ ከትካንታ Ꮊዳንደትም ጭል ማጻፍን ጮይስንከሰኬ ጋይሶ ከት ኤልሴ <verse eid="JHN 10:35"/><verse number="36" style="v" sid="JHN 10:36"/>ኮናና፥ ሳብ ባቤና ይንታ ክትም ፋሳንደትምኬ ኮ ፍጫሙደንዘን ኦይችባብም ‘እታ ሳብታ ይንችቴ’ ክት ጋይሳንካንታ Ꮊረታ ‘ሳብዘን የክይ ኬዘን ከዝደዬ’ የታ ክትም ጋይደቴ? <verse eid="JHN 10:36"/><verse number="37" style="v" sid="JHN 10:37"/>እታ እስታ ባቤንታ ፍክስን እ ፍክሳይንዳ ማቼ እም Ꮊይ አሜነቴ። <verse eid="JHN 10:37"/><verse number="38" style="v" sid="JHN 10:38"/>እስታ ባቤንታ ፍክስን እ ፍግዝድባብ ማቼ እንካ ዎራ የ አሜናክንዳ ማቼ እስታ ፍክስንካ አመንከቴ፥ ኮግንደካ ሳብ ባቤና እንካ ማቻንግንደኬ እተረ ሳብ ባቤንካ እ ማቻንደትም ማለካ ኤዝደቴ” ኩን ከትም ጋይሴ።<verse eid="JHN 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39"/>ከተረ አናካርንካ ክትም የድካንታ ዝግዘኬ፥ ኖ ማቼ ከታ አንናርንካ ሱርትሶ አይሴ።<verse eid="JHN 10:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40"/>አናካርንከረ የሱስ ዮርዳኖስ ሎቀን ቃልሶ ዮሀንስ እሪ ስእዝድ Ꮊቃን ካርናር አይሴ፥ ኮታረረ ዶቅሴ።<note caller="-" style="x"><char style="xo" closed="false">10፡40 </char><char style="xt" closed="false"><ref loc="JHN 1:28">ዮሀ. 1፡28</ref>። </char></note> <verse eid="JHN 10:40"/><verse number="41" style="v" sid="JHN 10:41"/>በድ ኤድንከስ ክደር Ꮊድሰኮ “ዮሀንስ Ꮊረነረ አታ ቃዉተን ይያክዬ፥ ኬዛር ማቼ ዮሀንስ ኮ ኤችንጎካ ክት ኬዛንዳ ሙዳ ዶፈን Ꮊቄ” ጋይሰኬ። <verse eid="JHN 10:41"/><verse number="42" style="v" sid="JHN 10:42"/>ኮታረረ በድ ኤድንከስ የሱሰካ አመንሰኬ።<verse eid="JHN 10:42"/></para>
  <chapter eid="JHN 10"/>
  <chapter number="11" style="c" sid="JHN 11"/>
  <para style="s1">አልአዛርታ ደእና</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1"/>ብታንያ ሞረናር አልዓዛር ጋይምድባብ ዋልቃ ኤች ሰቀርሶ Ꮊቄ፥ ብታንያ ካተመና ማራመትኬ ምችነን ማርተትካ ከት ዶቅድን ሞራ Ꮊቄ። <verse eid="JHN 11:1"/><verse number="2" style="v" sid="JHN 11:2"/>ናኮና ማራማ ጮይስታ ዱትን ዎዝድንደትካ ሳይሳንደትኬ ይንታ ማተንካ ና ሱቻንዴ፥ ሰቀርስባበረ አልዓዛር ኮታ እስመና Ꮊቄ። <verse eid="JHN 11:2"/><verse number="3" style="v" sid="JHN 11:3"/>ምችነንኬ ካነንካ “ጮይስዮ፥ ኖ የስ ሶልምድባብ ሰቀርቴ” ጋይሶ የሱሰደር ክታ ኦይቸኬ።<verse eid="JHN 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4"/>የሱሰረ ኮም ይ ኤስርሳንደትካ፥ “ኮና ሰቅምና ደእካንታ የልዝድንዳ ካዬ፥ ኬዛር ማቼ ሳብካንታ ቦንቻ ማድንግንደከ ሳብታ ይንችነረ ኮትኮጎካ ቦንችምድንግንዴ” ጋይሴ።<verse eid="JHN 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5"/>የሱስ ማርተትምኬ ምችነን ማራመትም ከታ እስመን አልዓዛርመረ ሶልምድ Ꮊቄ። <verse eid="JHN 11:5"/><verse number="6" style="v" sid="JHN 11:6"/>ማችንከረ አልአዛርታ ሰቅርን ኤሰርሰረ ይ ዶቅድን ካርናር ሰጫ ቃስተን Ꮊቄ። <verse eid="JHN 11:6"/><verse number="7" style="v" sid="JHN 11:7"/>ኮታ ቡር ይንታ ካርንካ ጎርስምድባብከስም “ኦስ ይሁዳ ፍጫር አናካርንካ ዎም ሙከቴ” ከትም ጋይሴ።<verse eid="JHN 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8"/>ክታ ካርንካ ጎርስምድባብከሰረ “ኤስስንባቦ! አይሁድና መራ ሰጨታ እር የስም አቅናካንታ ከታ ዝግደኮ Ꮊቀኬ፥ ይና ካርንካ ኮታር ማተዮ አይተራ?” ክደር ጋይሰኬ።<verse eid="JHN 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9"/>የሱሰረ፥ “ሰጫር ዶቅድንዳ ታመከ ቃስተን ሳዓት ካዮ? Ꮊየካ ኦንግድባብ ኮ ፍጫሙደንታ ሳክመን ይ ሰድንካንታ ጎሄራዬ። <verse eid="JHN 11:9"/><verse number="10" style="v" sid="JHN 11:10"/>ኬዛር ማቼ ሶይትካ ኦንግድባብ ሳክመና ክትካንታ ካየንኦል ጎሄርዴ” ጋይሴ። <verse eid="JHN 11:10"/><verse number="11" style="v" sid="JHN 11:11"/>የሱስ ኮም ከትካንታ ጋይሳን ቡር፥ “ዎንታ ገርነና አልዓዛር ግንእቴ፥ እታ ማቼ ክታ ግንእናርንካ ክትም አምስካንታ አይድቴ” ጋይሴ። <verse eid="JHN 11:11"/><verse number="12" style="v" sid="JHN 11:12"/>ክታ ካርንካ ጎርስምድባብከሰረ “ጮይስዮ! ክት ግንእተንዳ ማቼ ኡርዴ ጋይንትዬ” ክደር ጋይሰኬ። <verse eid="JHN 11:12"/><verse number="13" style="v" sid="JHN 11:13"/>የሱስ ኮም ክት ኬዛንዳ አልአዛርታ ደእንጎካ Ꮊቄ፥ ከታ ማቼ ግንእ ጎካ ክት ኬዛን ከደር ካምሴ። <verse eid="JHN 11:13"/><verse number="14" style="v" sid="JHN 11:14"/>ኮካንታ የሱስ መየካ ከትም፥ “አልዓዛር ደእቴ፥ <verse eid="JHN 11:14"/><verse number="15" style="v" sid="JHN 11:15"/>የ አሜንድንግንዳ ኦኮታር እስታ ዶቃክሳ ነግንተንካ የጎካ እም ጉርምስቴ፥ ታ ማቼ ኦስ ክደር ዎም ሙከቴ” ከደር ጋይሴ።<verse eid="JHN 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16"/>ኮታይካ ድድሞስ ጋይምስባብ ቶማስ አብንከስ ክታ ካርንካ ጎርስምድባብከስም፥ “ክትካ ክክን ዎ ደእተርንግንዳ ዎመረ ሙከቴ” ከትም ጋይሰኬ።<note caller="+" style="f"><char style="fr" closed="false">11፡16 </char><char style="ft" closed="false">ድድሞስ ጋይንትና፤ መንት ጋይንትዬ። </char></note><verse eid="JHN 11:16"/></para>
  <para style="s1">የሱስ ደእያርንካ አምንተኬ ዶቅንተካ ማትንት</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17"/>የሱስ ኮታር ክት የልሳንደትካ አልዓዛር ዱከርስንካ ኦይድ ሰጫ ማታ Ꮊቄ። <verse eid="JHN 11:17"/><verse number="18" style="v" sid="JHN 11:18"/>ብታንያ ሞረና የሩሳለምዘንካ ጎተርድንዳ ኡል ማከን ጎግ ማድንዴ። <verse eid="JHN 11:18"/><verse number="19" style="v" sid="JHN 11:19"/>አይሁድንከሳርንከረ በድንከስ ማርተትምከ ማራመም ከታ እስመንታ ደእንጎካ ዳቅስካንታ ከደር Ꮊድሶ Ꮊቀኬ።<verse eid="JHN 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 11:20"/>ማርታ የሱሰታ Ꮊድንተንም ይ ኤሰርሳንደትካ ሞካካንታ ዉተዴ፥ ማራማ ማቼ ኤሄናር Ꮊቄ። <verse eid="JHN 11:20"/><verse number="21" style="v" sid="JHN 11:21"/>ማርታ የሱስም “ጮይስዮ! የስ ካሪ ዶቅደስናና እስታ እስመና ደአይ ዶቆ፥ <verse eid="JHN 11:21"/><verse number="22" style="v" sid="JHN 11:22"/>ኬዛር ማቼ ታየረ የስ ምግዝድንደትም ሙዳ ሳብ የስካንታ እምድንደትም ኤዝድቴ” ና ጋይሴ።<verse eid="JHN 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23"/>የሱሰረ “የስታ እስመና ደእናርንካ አምዴ” ኮደር ጋይሴ። <verse eid="JHN 11:23"/><verse number="24" style="v" sid="JHN 11:24"/>ማርተረ “በእንታ ሰጨንካ ደእናርንካ አምንተናይካ አምድንደትም ኤዝድቴ” ና ጋይሴ። <verse eid="JHN 11:24"/><verse number="25" style="v" sid="JHN 11:25"/>የሱሰረ “አምንተንከኬ ዶቅንተንካ እትቴ፥ እንካ አሜንድባብ ደእሰረ ዎራ ሰንፐካ ዶቅተሬ፥ <verse eid="JHN 11:25"/><verse number="26" style="v" sid="JHN 11:26"/>ሰንፔካ ዶቅድባብከ እንከረ አሜንድባብ ሙደና ቦድሶ ደአዬ፥ ኮም የና አመንዳ?” ኮትም ጋይሴ።<verse eid="JHN 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27"/>ናየረ “ይዬ ጮይስዮ! የና ፍጫሙደንዘን Ꮊድባብ ሳይምስባብ ሳብታ ይንች የስ ማትንተን አመንድቴ” ና ጋይሴ።<verse eid="JHN 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28"/>ማርታ ኮም ይ ኬዛንደታ ቡር አይስንደትኬ ይንታ ምችነን ማራመም “ኤስስንባብ Ꮊቴ፥ ኖ የስመረ ኤልዴ” ጋይሶ ካቸካ ኮትም ኤልሴ። <verse eid="JHN 11:28"/><verse number="29" style="v" sid="JHN 11:29"/>ማራማ ኮም ይ ኤሰርሳንደትካ ሳነካ አምሶ የሱሰደር አይሴ። <verse eid="JHN 11:29"/><verse number="30" style="v" sid="JHN 11:30"/>ኮትᎺይካ የሱስ ማርታ ክትም Ꮊፍሳን ካርናር Ꮊቄ ዳት ኦስ ሞረናር አክ አርዳክዬ። <verse eid="JHN 11:30"/><verse number="31" style="v" sid="JHN 11:31"/>ኮትመረ ዳቅስን ካንታ Ꮊድሶ ኤሄናር ኮትካ የካ Ꮊቅባብከስ አይሁድና ማራማ ጭጭመትካ አምትዮ ኮት ዉድንካ ሰድሰኮ አልአዛርታ ዱክንደር ና አይሶ ኮት ኤብድን ከደር ካምስንካ ከታ ኮትም ጎርስምሰኬ።<verse eid="JHN 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32"/>ማራመረ የሱስ ዶቅድ Ꮊቃን ካርያር Ꮊድሶ ክትም ይ ሰጃንደትካ ክታ ዱትንዘን ዋችሶ “ጮይስዮ፥ የስ ካሪ ዶቅደስናና እስታ እስመና ደአይ ዶቆ” ና ጋይሴ።<verse eid="JHN 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33"/>የሱስ ኮት ኤብድንከ ኮትካ የካ Ꮊድባብከሰረ አይሁድና ከት ኤብድንካ ሰድሶ ቡዳርንካ አተርሶ ሞርእካ፥ <verse eid="JHN 11:33"/><verse number="34" style="v" sid="JHN 11:34"/>“Ꮊብረንት ዱክሳሬ?” ጋይሴ። ከተረ “ጮይስዮ! ኮር Ꮊድሶ ሰትካ” ከታ ጋይሰኬ።<verse eid="JHN 11:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35"/>የሱሰረ ኤርመካ ኤፍሴ። <verse eid="JHN 11:35"/><verse number="36" style="v" sid="JHN 11:36"/>ኮካንታ አይሁድና “Ꮊስግንዳ ክት ሶልምዳ ናነረ ሰትከቴ” ጋይሴ።<verse eid="JHN 11:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37"/>ከታርንካ ዋልቃ ዋልቀንከስ ማቼ፥ “ዝልንታ አፍንከስም ሰችስባብ፥ ኮና ኤችና ደእዳክንግንዳ ይካንታ ማታዮ?” ጋይሰኬ።<verse eid="JHN 11:37"/></para>
  <para style="s1">የሱስ አልዓዛርም ደእናርንካ አምስና</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38"/>የሱስ አንድርይ ሞርኤሮ ዱክንደር አይሴ፥ ዱክነረ ሰይንካ ዝጭምሳንዳ የርሳ Ꮊቄ። <verse eid="JHN 11:38"/><verse number="39" style="v" sid="JHN 11:39"/>የሱስ “ሰይንንም አምስከቴ” ጋይሴ። ደእስባብታ ምችነና ማርታ፥ “ጮይስዮ፥ ክት ደእስንካ ኦይድ ሰጫ ማቴ፥ ታ ሶቅዴ” ና ጋይሴ። <verse eid="JHN 11:39"/><verse number="40" style="v" sid="JHN 11:40"/>የሱሰረ “የስ አሜንሴ ሳብታ ቦንቸን የና ሰተረዬ የስም ጋያክቶ?” ኮትም ጋይሴ። <verse eid="JHN 11:40"/><verse number="41" style="v" sid="JHN 11:41"/>ኤድንከሰረ ሰይንንም አምሰኬ፥ ኮታ ቡር የሱስ ፈስ ጭላር ሰድሶ፥ “እስታ ባበኖ! እም የስ ኤሰርሳንካንታ የስም ጋለድቴ፥ <verse eid="JHN 11:41"/><verse number="42" style="v" sid="JHN 11:42"/>ሙዳᎺይከረ እም የስ ኤሰርድንደትም ኤዝድቴ፥ ኬዛር ማቼ ኮም እ ጋይሳንዳ፥ ኮዘን ዎእስባብ ኤድንከስ የስ እም ኦይቻንደትም ከት አሜንድንግንዳ ጋይስቴ” ጋይሴ። <verse eid="JHN 11:42"/><verse number="43" style="v" sid="JHN 11:43"/>የሱስ ኮም ኬዛንደታ ቡር፥ “አልአዛሮ! ኮሬ ዉትካ!” ጋይሶ አንድርይ ኡፍስካ ኤልሴ። <verse eid="JHN 11:43"/><verse number="44" style="v" sid="JHN 11:44"/>ደእስባብ አልዓዛረረ አንንከስከ ዱትንከስ አክሰርድንደትካ አክስምሳንግንዳ ዱክናርንካ ዉተዴ፥ ክታ አፍንመረ አፍለካ ዞክረሳን ግንዳ Ꮊቄ፥ የሱሰረ “ብልሰቶ ክትም ዛእከቴ ክት አያ!” ከትም ጋይሴ።<verse eid="JHN 11:44"/></para>
  <para style="s1">የሱስዘን ይምሳንዳ ዙዝም</para>
  <para style="r">(<ref loc="MAT 26:1-5">ማቶ. 26፡1-5</ref>፤ <ref loc="MRK 14:1-2">ማር. 14፡1-2</ref>፤ <ref loc="LUK 22:1-2">ሉቃ. 22፡1-2</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45"/>ማራመም ዳቅስካንታ Ꮊድሶ Ꮊቅባብ አይሁድንከሳርንካ በድንከስ ይምሳንደትካ ሰድሰኮ የሱሰካ አመንሰኬ። <verse eid="JHN 11:45"/><verse number="46" style="v" sid="JHN 11:46"/>ዋልቃ ዋልቀንከስ ማቼ ኦስ ፈረሳያዊንንከዝደር አይሰኮ የሱስ ይሳንደትም ከትካንታ ኬዘኬ። <verse eid="JHN 11:46"/><verse number="47" style="v" sid="JHN 11:47"/>ኮካንታ ቄሰንከስታ ገችንባብከስኬ ፈረሳዊያንንከስ ቡጫ ጋልተንከስካ የካ Ꮊቅድባከስም ሳንስሶ ኩን ጋይሰኬ “ኮና ኤችና በድ አታ ቃዉታ ክት ይድንኦል Ꮊስ ዎ ይሶክ ኡርተራ? <verse eid="JHN 11:47"/><verse number="48" style="v" sid="JHN 11:48"/>ዉችኩን ክትም ዎ ዛቅሴ ኤድ ሙደና ክትካ አሜንደኬ፥ ሮማ ኤድንከሰረ Ꮊድሰኮ ዎንታ ሳብታ ጭል ኤሄንምከ ዎንታ ዎርሰንም ሙዳ ካይዝዴ።”<verse eid="JHN 11:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49"/>ኬዛር ማቼ ከታርንካ ዋልቀና ኮት ስለናር ቀሰንከስታ ገችንባብ Ꮊቅባብ ቀያፋ ኩን ጋይሴ፥ “የታ ማቼ Ꮊረነረ ኤሳየቴ፥ <verse eid="JHN 11:49"/><verse number="50" style="v" sid="JHN 11:50"/>ዎርሰና ሙዳ ካይድንጀንካ ዋልቃ ኤድ ዎርሰን ካንታ ደእሳን ማቼ የካንታ ኡርማ ማድንደትም ቦድሰቶ ገቀርት ተያከቴ?” <verse eid="JHN 11:50"/><verse number="51" style="v" sid="JHN 11:51"/>ኖየረ ኮም ክት ኬዛንዳ፥ ይንዘንካ ዉችሶ ካዬ፥ ኬዛር ማቼ ኮት ስለናር ኖ ቄሰንከስታ ገችንባብ ማትሶ ክት Ꮊቅንኦል፥ የሱስ ዎርሰን ካንታ ደእ ክትም ዝግዝድንደትም ሰችካንታ ኮም ቤርንም ኬዜ። <verse eid="JHN 11:51"/><verse number="52" style="v" sid="JHN 11:52"/>ክት ደእድንደረ ዎርሰንካንታ Ꮊክ ማታክናና፥ ይጭምስባብከስመረ ሳብታ ይንችን ከትም ዋልቃ ማስሶ ሳንስካንቴ።<verse eid="JHN 11:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53"/>ኮካንታ ኮት ሰጨንዘንካ የድሶ የሱሰም ደይሳካንታ ዞርምሰኬ። <verse eid="JHN 11:53"/><verse number="54" style="v" sid="JHN 11:54"/>ኮታዘንካ ኦስ የሱስ አይሁድንታ ዎክናር መየካ ኦንጋክዬ፥ ኬዛር ማቸ ኮታርንካ ዉትሶ ዴል ቆቸንታ ላማር ዶቅድን ኤፍረም ጋይምድን ካተመናር አይሴ፥ ኮታር ይንታ ካርንካ ጎርስምድባብከስካ ክክን ዶቅሴ።<verse eid="JHN 11:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55"/>አይሁድንታ ፋስጋ ባአልን ቅንችታ Ꮊቄ፥ በድንከሰረ ፋስጋ ባአልን የልተርንደታ እር፥ ይንታ ማተን አርንስካንታ Ꮊክ Ꮊክ ካርያርንካ ፈንክ የሩሳሌማር ዉተደኬ፥ <verse eid="JHN 11:55"/><verse number="56" style="v" sid="JHN 11:56"/>ከተረ ሳብታ ጭል ኤሄናር ዎእሰኮ የሱሰታ Ꮊድንተንም ካርሰሮ Ꮊቃንጎካ “የታ Ꮊረንት ገቀርዳ? ባአልናር ክት Ꮊድን የም ካማዮ?” ጋየረኮ ክክ ክክ ኦይስመሮ Ꮊቀኬ። <verse eid="JHN 11:56"/><verse number="57" style="v" sid="JHN 11:57"/>ጉጅሰረ ቀሰንከስታ ገችንባብኬ ፈረሳዊያንንከስ የሱሰም ከት የድንግንዳ ክት ዶቅድን ካርን ኤዝድባብ ኤድ ዶቅሴ ከትካንታ ኤስምዝድንግንዳ ኤድም ሙዳ ክትሰኬ።<verse eid="JHN 11:57"/></para>
  <chapter eid="JHN 11"/>
  <chapter number="12" style="c" sid="JHN 12"/>
  <para style="s1">የሱሰም ዎዝድንደትካ ሳይሳን ኤተን</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1"/>አይሁድንታ ፋስጋ ባአልና ቦንችምካንታ ላ ሰጫ ነገድንካ፥ የሱስ ብታንያር አይሴ፥ ብታንያ የሱስ ደእናርንካ አምስባብ አልዓዛር ዶቅድን ሞሬ። <verse eid="JHN 12:1"/><verse number="2" style="v" sid="JHN 12:2"/>ኮታር ሶይት እችም ክትካንታ ከታ ግክሰኬ፥ ማርተረ ፍክስዘን Ꮊቄ፥ አልዓዛረረ የሱሰካ ክክን እችምካንታ ዶቅስባብከሳርንካ ዋልቀና Ꮊቄ። <verse eid="JHN 12:2"/><verse number="3" style="v" sid="JHN 12:3"/>ኮታይካ ማራማ ሰንት ተየርድንደና አንድርይ ስንጋ ማቻንዳ ኡርማ ናርዶስ ጋየርድንደትዘንካ ፍክስምሳንዳ፥ ጣሳ ዋልቃ ማድንዳ ዋልቃ ብልቃትካ ዎዝድንደትም ና ተይሶ፥ የሱሰታ ዱትንዘን ዉልእሴ፥ ይንታ ማተንከረ ሱቼ፥ ኤሄነረ ዎዝድንደታ ዎስመንካ ጮጬ።<note caller="-" style="x"><char style="xo" closed="false">12፡3 </char><char style="xt" closed="false"><ref loc="LUK 7:37-38">ሉቃ. 7፡37-38</ref>። </char></note><verse eid="JHN 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 12:4"/>ክታ ካርንካ ጎርስምድባብከሳርንካ ዋልቀና የሱስም ስክስትዮ እምድባብ አስቆሮንት ይሁዳ የሱሰም ግርንተካ፥ <verse eid="JHN 12:4"/><verse number="5" style="v" sid="JHN 12:5"/>“ኮና ዎዝድንደና ማከን ጨታ ጣገራ ብራ ሰንምሶ ርካየንባብከስካንታ Ꮊረታ እምማይንዳ?” ጋይሴ።<note caller="+" style="f"><char style="fr" closed="false">12፡5 </char><char style="ft" closed="false">ድናር ጋይንት ፍክስባብካንታ ዋልቃ ሰጨታ ናክዬ። </char></note><verse eid="JHN 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 12:6"/>ኖ ኮም ክት ኬዛንዳ፥ ርካየንባብከስካንታ ሞርእሶ ማታክናና ድቢይ ክት ማቻን ኦሌ፥ ብረን የድንዳ ቦርሰን የድባብ ኖ ማትንተንካ ቦርሰናር ኦይትምድንደትም ብረን ተይድᎺቄ።<verse eid="JHN 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7"/>የሱሰረ፥ “ክት ዱከርድንደት ሰጨንታ ኮት ይሳንዳ ግክስ ማቻንካንታ ኮትም ዛእከቴ። <verse eid="JHN 12:7"/><verse number="8" style="v" sid="JHN 12:8"/>ሪካየንባብከስ ሙዳᎺይካ የንካ ክክነኬ፥ እታ ማቸ ሙዳᎺይካ የንካ ክክን ዶቃይቴ” ኩን ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">12፡8 </char><char style="xt" closed="false"><ref loc="DEU 15:11">ካሪ. 15፡11</ref>። </char></note><verse eid="JHN 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9"/>ኮታይካ አይሁድንከሳርንካ በድንከስ የሱስ ብታንያር ክታ ማትንተን ኤስሶ Ꮊደኬ፥ Ꮊድባብከሰረ የሱስጎካ Ꮊክ ማታክናና የሱስ ደእናርንካ አምስባብም አልዓዛርመረ ሰድንካንቴ። <verse eid="JHN 12:9"/><verse number="10" style="v" sid="JHN 12:10"/>ቄሰንከስታ ገችንባብከስ ማቼ አልዓዛርመረ ደይሳካንታ ዞርምሰኬ። <verse eid="JHN 12:10"/><verse number="11" style="v" sid="JHN 12:11"/>ክታዘንካ አምሳንዳ አይሁድናርንካ በድንከስና ይንታ አሜንን ዛቀረኮ የሱሰካ አመነረኮ ከት Ꮊቅንካንቴ።<verse eid="JHN 12:11"/></para>
  <para style="s1">የሱስ አንድር ቦንቸካ የሩሳሌማር ክታ አርድንተና</para>
  <para style="r">(<ref loc="MAT 21:1-11">ማቶ. 21፡1-11</ref>፤ <ref loc="MRK 11:1-11">ማር. 11፡1-11</ref>፤ <ref loc="LUK 19:28-40">ሉቃ. 19፡28-40</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12"/>ዛማክንካ ፋስጋ ባአልንካንታ Ꮊድባብ በድ ኤድንከስ የሱስ የሩሳሌማር ክት Ꮊድንደትም ኤሰርሰኬ። <verse eid="JHN 12:12"/><verse number="13" style="v" sid="JHN 12:13"/>ኮካንታ መጫ የድሰኮ ሞክት ተይካንታ ዉተደኬ፥ “ሆሳእና!<note caller="+" style="f"><char style="fr" closed="false">12፡13 </char><char style="fqa" closed="false">ሆሳእና፦ </char><char style="ft" closed="false">ጋይንትንታ ቡልና ታ ዎም አቅስካ ጋይንትዬ። </char></note> ጮይስታ ላምንካ Ꮊድባብ እስረልንታ ባንችና አንጅምስባቤ!” ጋየረኮ ከታ ፍብድ Ꮊቀኬ።<note caller="-" style="x"><char style="xo" closed="false">12፡13 </char><char style="xt" closed="false"><ref loc="PSA 118:25-26">የቺ 118፡25-26</ref>። </char></note><verse eid="JHN 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14"/>የሱስ ኡክልንታ ቅንጭ Ꮊፍስንደትከ ክታዘን ዶቅሶ፥ ኮነረ ማቻንዳ፥<verse eid="JHN 12:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15"/>“የና ጽዮንታ ካተማ፥ የሩሳሌሞ Ꮊይ ጳሴ!</para>
  <para style="q1" vid="JHN 12:15">ኮሰቸቴ! የስታ ባንችና ኡክል ቅንጭታ ዘን ዶቅሶ ኖ Ꮊዴ” <note caller="-" style="x"><char style="xo" closed="false">12፡15 </char><char style="xt" closed="false"><ref loc="ZEC 9:9">ዘካ. 9፡9</ref>። </char></note></para>
  <para style="m" vid="JHN 12:15">ጋይምሶ ጻፍምሳንዳ ቤርና ቦድምድንግንዴ።<verse eid="JHN 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16"/>ክታ ካርንካ ጎርስምድባብከስ ኮና ርና እሪ ከትም አርዳክ Ꮊቄ፥ ማቼረ የሱስ ቦንቼካ ፈስ ጭላር አይሳንደትካ ኮና ሪይና ክትጎካ ጻፍምሳንግንደኬ ክት ካንተረ ይምሳንደትም ከታ ገቀርሰኬ።<verse eid="JHN 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17"/>የሱስ አልዓዛርም ዱክናርንካ ኤልሳንደትከ ደእናርንካ ክትም አምሳንደታይካ ክትካ የካ Ꮊቅባብከስ ሙዳ የሱስጎካ ማርከረሮ Ꮊቀኬ። <verse eid="JHN 12:17"/><verse number="18" style="v" sid="JHN 12:18"/>በድ ኤድንከስና ክትካ Ꮊፍርካንታ ዉተድባብከሰረ ኮም አታ ቃዉተን ክት ይሳን ኤሰርሰኮ ከት Ꮊቅን ኦሌ። <verse eid="JHN 12:18"/><verse number="19" style="v" sid="JHN 12:19"/>ኮታይካ ፈረሳዊያንንከስ፥ “ይና ኮሰቸቴ፥ ፍጫሙደንታ ዎርሰና ሙደናክትም ጎርስምተኬ! ዎታ Ꮊረነረ ይካንታ ዎማዳክንደትም ሰደት ካዮ?” ክክ ጋይሰኬ።<verse eid="JHN 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20"/>ባአልንᎺይካ ጎስትካንታ የሩሳሌማር አይስባብ ኤድንከሳርንካ፥ ዋልቃ ዋልቃ ግርክ ኤድንከስ Ꮊፈርድ Ꮊቀኬ። <verse eid="JHN 12:20"/><verse number="21" style="v" sid="JHN 12:21"/>ከተረ ገሊላ ፍጫርንካ በቴሳይዳ ፍጫ ኤድ ማችባብ ፍልጶሰደር Ꮊድሶ፥ “የባቦ፥ የሱስም ሰድንካንታ ዎታ ዝግዶቴ” ጋይሰኬ።<verse eid="JHN 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 12:22"/>ፍልጶሰረ አይሶ እንደራስካንታ ኬዜ፥ እንደራሰከ ፍልጶስከ የካ አይሰኮ የሱስካንታ ኬዘኬ። <verse eid="JHN 12:22"/><verse number="23" style="v" sid="JHN 12:23"/>የሱሰረ፥ “ይና ኮሰቸቴ፥ ኤድ ይንች ክት ቦንችምድን ሳዓትና የልቴ፥ <verse eid="JHN 12:23"/><verse number="24" style="v" sid="JHN 12:24"/>ዶፈን፥ ዶፈን እታ የም ጋይድቴ፥ ዘርግታ ሶንተና ፍጨዘን ዋችሶ ጫፋክንዳ ማቼ፥ ና ይንት ነገዴ፥ ይጫፍሳንዳ ማቼ በድ አፍ ኡዝዴ።<note caller="-" style="x"><char style="xo" closed="false">12፡24 </char><char style="xt" closed="false"><ref loc="MAT 10:39">ማቶ. 10፡39</ref>፤ <ref loc="MAT 16:25">16፡25</ref>፤ <ref loc="MRK 8:35">ማር. 8፡35</ref>፤ <ref loc="LUK 9:24">ሉቃ. 9፡24</ref>፤ <ref loc="LUK 17:33">17፡33</ref>። </char></note> <verse eid="JHN 12:24"/><verse number="25" style="v" sid="JHN 12:25"/>ይንታ ሰንፔንም ሶልምድባብ ኮትም ካይስዝዴ፥ ኮ ፍጫሙደንዘን ሰንፔን ይንታ ቦዝድባብ ማቼ ስለንክንደትካንታ ኮትም ካርዝዴ። <verse eid="JHN 12:25"/><verse number="26" style="v" sid="JHN 12:26"/>እካንታ ፍክስ ዝግድባብ እም ጎርስማ፥ እ ዶቅድን ካርናር እስታ ፍክስንባብ ኮታር ማዴ፥ እካንታ ፍግዝድባብመረ ሳብ ባበና ክትም ቦንጅዴ” ኩን ከትም ጋይሴ።<verse eid="JHN 12:26"/></para>
  <para style="s1">የሱስ ይንዘን የልድን ማጠንጎኬ ደእንጎካ ክታ ኬዘና</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27"/>ኮታዘንከረ የሱስ፥ “ይና ኮሰቸቴ! እስታ ሰንፔና ማጠርቴ፥ Ꮊርስ ጋይቴ? ‘እስታ ባቤኖ! ኮ ሳዓትንዘንካ እም አቅስካ ጋይትቶ?’ ኮም እ ጋይተራክንግንዳ እ Ꮊዳንዳ ኮትኮ ማጣ ሳዓትን ካንቴ። <verse eid="JHN 12:27"/><verse number="28" style="v" sid="JHN 12:28"/>እስታ ባቤኖ! የስታ ላምን ቦንችስካ” ጋይሴ።</para>
  <para style="p" vid="JHN 12:28">ኮታ ቡር “እስታ ላምን ቦንችስትቴ፥ ጉጅሰረ ቦንጅድቴ!” ኩን ጋይድንዳ ኡፍስ ጭላርንካ Ꮊዴ።<verse eid="JHN 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 12:29"/>ኮታር ዎእስባብ ኤድንከስ ኮም ኤሰርሳንደትካ፥ “ጉግኔ!” ጋይሰኬ። አብንከስ ጉጅሶ “ክታይንቼ ኬዝባብ!” ጋይሰኬ።<verse eid="JHN 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30"/>የሱስ፥ “ኮና ኡፍስና Ꮊዳንዳ የካንታ ጋይሶ ዳት እካንታ ጋይሶ ካዬ፥ <verse eid="JHN 12:30"/><verse number="31" style="v" sid="JHN 12:31"/>ኮና ፍጫ ሙደና ኮት ፋረድምድንዳ ሰጨና ታዬ፥ ኮፍጫ ሙደን ቆልድባብ ሰጣን ኦስ ማል ክት ኦይትምድንዳ ታዬ፥ <verse eid="JHN 12:31"/><verse number="32" style="v" sid="JHN 12:32"/>እተረ ፍጨዘንካ ጨዳ ጬክን እ ጋይሳንደትካ ኤድ ሙደን እዝደር ተይᎺድቴ” ጋይሴ። <verse eid="JHN 12:32"/><verse number="33" style="v" sid="JHN 12:33"/>የሱስ ኮም ክት ኬዛንዳ Ꮊራ ግንዳ ደእ ይ ደእዳ ናነረ ሰችዝድንዴ።<verse eid="JHN 12:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34"/>ኤድንከሰረ “ህግንካ ጻፍምስንካ ዎ Ꮊብድንዳ ‘ሳይምስባብ ስለንክንደታ ዶቅተሬ’ ጋይድንዴ፥ ይና፥ የና፥ ‘ኤድ ይንች ጨዳ ጬክን ጋይ ክትም ዝግዝዴ’ Ꮊሰስ ጋይዳ? ኮና ኤድይንችና Ꮊይራ?” ጋይሰኬ።<note caller="-" style="x"><char style="xo" closed="false">12፡34 </char><char style="xt" closed="false"><ref loc="PSA 110:4">የቺ 110፡4</ref>፤ <ref loc="ISA 9:7">ኢሳ. 9፡7</ref>፤ <ref loc="EZK 37:25">ሕዝ. 37፡25</ref>፤ <ref loc="DAN 7:14">ዳን. 7፡14</ref>። </char></note><verse eid="JHN 12:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35"/>የሱስ፥ “ታ መራ ሰጫካንታ የንካ ክክን ሳክማ ዶቅዴ፥ ኡምና የንዘን የልዳክንግንዳ ሳክመና የንታ ዶቅድንደትካንታ ኦንግከቴ፥ ኡምናር ኦንግድባብ Ꮊብር ይ አይዳናንከረ ኤሳዬ። <verse eid="JHN 12:35"/><verse number="36" style="v" sid="JHN 12:36"/>ሳክመንታ ይንች የ ማድንግንዳ ሳክመና የንታ ዶቅድንካንታ ሳክመን ማችባብካ የታ አመንከቴ” ኩን ጋይሴ። ኮታዘንከረ የሱስ ኮም ይ ኬዛንደታ ቡር አይስንደትከ ከታዘንካ አጥምሴ።<verse eid="JHN 12:36"/></para>
  <para style="s1">አይሁድንታ አሜንክሳነግና</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37"/>የሱስ በድ አታ ቃዉተንከስም ከታ እር ይስንከረ ዎራ አይሁድና ክትካ አሜናከኬ። <verse eid="JHN 12:37"/><verse number="38" style="v" sid="JHN 12:38"/>ኮነረ ማቻንዳ ሳብዘንካ ኤሰርሶ ኬዝባብ ኢስያስ፥</para>
  <para style="q1" vid="JHN 12:38">“ጮይስዮ ዎንታ ማርከርን Ꮊይ አመንሳሬ?</para>
  <para style="q1" vid="JHN 12:38">ጮይስታ ዎልቀና Ꮊይካንቶክ መያ ማቻሬ?” <note caller="-" style="x"><char style="xo" closed="false">12፡38 </char><char style="xt" closed="false"><ref loc="ISA 53:1">ኢሳ. 53፡1</ref>። </char></note></para>
  <para style="m" vid="JHN 12:38">ጋየሮ ኬዝምሳን ቃለና ቦድምድንግንዴ። <verse eid="JHN 12:38"/><verse number="39" style="v" sid="JHN 12:39"/>ካርንከረ ኢስያስ፥<verse eid="JHN 12:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40"/>“ከታ ይንታ አፍንካ ሰድስንደትከ</para>
  <para style="q2" vid="JHN 12:40">ከታ ይንታ ቡደንካ ገቀርሰኮ</para>
  <para style="q2" vid="JHN 12:40">ከት ማዳክንግንደከ ከት ፋጭዳክንግንዳ</para>
  <para style="q1" vid="JHN 12:40">ሳብ ከታ አፍን ዝልስቴ፥</para>
  <para style="q2" vid="JHN 12:40">ከታ ቡደንመረ ገቀርዳክንግንዳ ይሴ” <note caller="-" style="x"><char style="xo" closed="false">12፡40 </char><char style="xt" closed="false"><ref loc="ISA 6:10">ኢሳ. 6፡10</ref>። </char></note> ኩንጋየሮ ከታ አሜንክሳ ነግን መያ ማስሴ።<verse eid="JHN 12:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 12:41"/>ኢስያስ ኮም ክት ጋይሳንደረ ሳይምስባብታ ቦንቸንም ይ ሰዳንካንቴ፥ ኮካንታ ኮም የሱስጎካ ኬዜ።<verse eid="JHN 12:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42"/>ማችንከረ አይሁድንታ ገችንባብከሳርንከረ ዎራ በድንከስ የሱሰካ አሜንተኬ፥ ኬዛር ማቼ ፈረሳዊያንንከስ አይሁድንታ ምክስ ኤሄናርንካ ከትም ዉጅዳክንግንዳ ጳስካ፥ መየካ ክትካንታ ማርከራከኬ። <verse eid="JHN 12:42"/><verse number="43" style="v" sid="JHN 12:43"/>ኮመረ ከት ይሳንዳ ሳብዘንካ Ꮊፈርድን ቦንቸዘንካ ስግ ኤድዘንካ Ꮊፈርድን ቦንቸን ከት ሶልምሳንካንቴ።<verse eid="JHN 12:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44"/>የሱሰረ ይንታ ኡፍስን ጬክሳ ይይሶ፥ “እንካ አሜንድባብ እንካ Ꮊክ ማታክናና፥ እም ኦይችባብከረ አሜንዴ፥ <verse eid="JHN 12:44"/><verse number="45" style="v" sid="JHN 12:45"/>እም ሰድባብ እም ኦይችባብም ሰዴ፥ <verse eid="JHN 12:45"/><verse number="46" style="v" sid="JHN 12:46"/>እንካ አሜንድባብ ሙደና ኡማር ዶቅዳክንግንዳ እታ ሳክማ ማትስቶ ፍጫሙደንዘን Ꮊትቴ። <verse eid="JHN 12:46"/><verse number="47" style="v" sid="JHN 12:47"/>እስታ ቃለን ኤሰርሶ ፍክስዘን Ꮊቅዝዳክባብ ክታዘን ፋረድባብ እታ ካይቴ፥ እ Ꮊዳንዳ ፍጫ ሙደን አቅስካንታ ዳት ፍጫሙደንዘን ፍርዳካንታ ካዬ። <verse eid="JHN 12:47"/><verse number="48" style="v" sid="JHN 12:48"/>እም ዝግዳክባብኬ እስታ ቃለንመረ ተይዳክባብ ኤድ ክታዘን ፋረድባብ ዶቅዴ፥ እ ኬዛንዳ ቃለና በእንታ ሰጨንካ ክታዘን ፋረዴ። <verse eid="JHN 12:48"/><verse number="49" style="v" sid="JHN 12:49"/>እታ እስታ ገችንታ ኤረንካ ኬዛክቴ፥ እ ጋይድንደትምኬ እ ኬዝድንደት ክተንም እካንታ እምስባብ እም ኦይችባብ ሳብባበኔ። <verse eid="JHN 12:49"/><verse number="50" style="v" sid="JHN 12:50"/>ክተረ ክተና ስለንክንደታ ዶቅንተንደር ጎርዝድንዳ ማቻንደትም ኤዝድቴ። ኮካንታ እ ኬዝድንዳ ሳብ ባቤና እካንታ ከዛንደትሜ” ኩን ጋይሴ።<verse eid="JHN 12:50"/></para>
  <chapter eid="JHN 12"/>
  <chapter number="13" style="c" sid="JHN 13"/>
  <para style="s1">የሱስ ይንታ ካርንካ ጎርስምድባብከስታ ዱትን ስእና</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1"/>ይና ሰጨና አይሁድንከስታ ፋስጋ ባአልን የልታ Ꮊቄ፥ የሱስ ኮፍጫ ሙደን ዛቅሶ ሳብ ባቤንደር ክት አይድንደታ ሳዓትና የልንተንም ኤሴ። ኮ ፍጫሙደንዘን ዶቅድባብከስ ይንታ ኮችንከስም ኖ ሶልምድ Ꮊቄ፥ በእንታ የለልተረ ከትም ሶልምሴ።<verse eid="JHN 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2"/>የሱሰከ ክታ ካርንካ ጎርስምድባብከስካ ሶይት እችምን እጅድ Ꮊቀኬ፥ ስምኦነታ ይንች አስቆሮንት ይሁዳ ማቼ የሱሰም ስክስት እምድንግንዳ ዳብሎስ ክታ ቡደናር ዳቅል ገቅር ገችስሴ። <verse eid="JHN 13:2"/><verse number="3" style="v" sid="JHN 13:3"/>ሳብ ባቤና ገችታ ኤረን ሙዳ እምሳንደትግንደከ ሳብዘንካ ዉትሶ Ꮊዳንደት ግንዳ፥ ሳብደረረ ይ አይድንደትም የሱስ ኤዝድ Ꮊቄ። <verse eid="JHN 13:3"/><verse number="4" style="v" sid="JHN 13:4"/>ኮካንታ እችምንዘንካ አምስንደትከ አፍለን ይንታ ዎጄ፥ ሱተርደን ዳንጭንመረ አምስትዮ ይንታ ዎክ ጫምናር ዞክሴ። <verse eid="JHN 13:4"/><verse number="5" style="v" sid="JHN 13:5"/>ኮታ ቡር ዱትን ስእርድን ጋበትናር ሎቃ ዎድሶ ይንታ ካርንካ ጎርስምድባብከስታ ዱትን ስእ የጄ፥ ይ ዞከርሳን ሱተርድን ዳንጭንከረ ከታ ዱትን ሱቼ። <verse eid="JHN 13:5"/><verse number="6" style="v" sid="JHN 13:6"/>የሱስ ስምኦን ጴጥሮሰደር Ꮊዳንደትካ ጴጥሮስ፥ “ጮይስዮ! የና እስታ ዱት ስእተራ?” ጋይሴ። <verse eid="JHN 13:6"/><verse number="7" style="v" sid="JHN 13:7"/>የሱሰረ “እ ይድንደትም የና ታ ኤዝዳከዬ፥ ኮታ ቡር ማቼ ገቀርዳዬ” ጋይሴ። <verse eid="JHN 13:7"/><verse number="8" style="v" sid="JHN 13:8"/>ጴጥሮሰረ “የና እስታ ዱትን ቦድስ ስእዳካዬ!” ጋይሴ። የሱሰረ “እታ የስታ ዱትን እ ስአክንዳ ማቼ እዝደር ካሪ የስታ ካዬ” ጋይሴ። <verse eid="JHN 13:8"/><verse number="9" style="v" sid="JHN 13:9"/>ስምኦን ጴጥሮሰረ “ጮይስዮ! ኩን ማቼ እስታ ዱትን Ꮊክ ማታክናና እስታ አንነረ፥ እስታ ማተንመረ ስእካ!” ጋይሴ። <verse eid="JHN 13:9"/><verse number="10" style="v" sid="JHN 13:10"/>የሱሰረ “ዘነንም ስኤርስባብ ዘነና ክታ ኡርማ ማትንተንካ ዱትንም ስርንዘንካ አብ ክትም ዝክስሳየ፥ የተረ ጭልን ከሰቴ፥ ኬዛርካ ማቼ የታ ሙደና ጭልንከስ ካየቴ” ጋይሴ። <verse eid="JHN 13:10"/><verse number="11" style="v" sid="JHN 13:11"/>የሱስ “የታ ሙደነረ ጭል ካየቴ” ክት ጋይሳንደረ ይም ስክስትን እምድባብ Ꮊይ ናነረ ይ ኤዝድን ኦሌ።<verse eid="JHN 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12"/>ከታ ዱትን ስእሳንደታ ቡር አፍለንም ቆበርሶ ይንታ ካርንዘን ማትሶ ዶቅሴ፥ ኩነረ ከትም ጋይሴ፥ “Ꮊራካንታ እ የካንታ ይሳናከረ ገቀርት ተይተቴ?<note caller="-" style="x"><char style="xo" closed="false">13፡12 </char><char style="xt" closed="false"><ref loc="LUK 22:27">ሉቃ. 22፡27</ref>። </char></note> <verse eid="JHN 13:12"/><verse number="13" style="v" sid="JHN 13:13"/>የታ ‘ኤስስንባብኬ ጮይስዬ’ እም ጋይደቴ፥ እታ ኤስስንባብኬ ጮይስ እማቻን ኦል የ ጋይስንዳ ገቴ። <verse eid="JHN 13:13"/><verse number="14" style="v" sid="JHN 13:14"/>ይና እታ የንታ ጮይስኬ ኤስስንባብካ እ ማድንካ የንታ ዱትን እ ስእሴ የተረ ክክ ክክ የንታ ዱትን ስኤር የም ዝግዝዴ። <verse eid="JHN 13:14"/><verse number="15" style="v" sid="JHN 13:15"/>እታ የካንታ ይሳንደትግንዳ የተረ የ ይድንደትግንዳ ካምስንም የም እምትቴ። <verse eid="JHN 13:15"/><verse number="16" style="v" sid="JHN 13:16"/>ዶፈን ዶፈን የም ጋይድቴ፥ ፍክስንባብ ማታ ቆልስባብዘንካ ስጋየ፥ ክትምስባበረ ኦይችባብዘንካ ስጋዬ።<note caller="-" style="x"><char style="xo" closed="false">13፡16 </char><char style="xt" closed="false"><ref loc="MAT 10:24">ማቶ. 10፡24</ref>፤ <ref loc="LUK 6:40">ሉቃ. 6፡40</ref>፤ <ref loc="JHN 15:20">ዮሀ. 15፡20</ref>። </char></note> <verse eid="JHN 13:16"/><verse number="17" style="v" sid="JHN 13:17"/>ኮትኮም ሪን የ ኤሰኬ ፍክስዘን የ Ꮊቅሴ አንጅምስባበቴ። <verse eid="JHN 13:17"/><verse number="18" style="v" sid="JHN 13:18"/>ኮም እ ኬዝድንዳ የ ሙደንጎካ ካዬ፥ እ የም እጅባብከስም ኤዝድቴ፥ ኬዛርካ ማቼ ‘እስታ ሶለንም እችባብ እዘን ይምኤርካ አምሴ’ ጋይድንደና ጭል ማጻፍንታ ቃለና ቦድ ኮትም ዝግዝዴ።<note caller="-" style="x"><char style="xo" closed="false">13፡18 </char><char style="xt" closed="false"><ref loc="PSA 41:9">የቺ 41፡9</ref>። </char></note> <verse eid="JHN 13:18"/><verse number="19" style="v" sid="JHN 13:19"/>ኮና ማተርንደታ እሪ ታ እሪናና የም እ ኬዝድንዳ፥ ቦጃንደታ ቡር፥ እንካ የ አመንድንግንዴ። <verse eid="JHN 13:19"/><verse number="20" style="v" sid="JHN 13:20"/>ዶፈን ዶፈን የም ጋይድቴ፥ እ ኦይድባብም ሞግድባብ እም ሞግዴ፥ እመረ ሞግድባብ እም ኦይችባብም ሞግዴ” ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">13፡20 </char><char style="xt" closed="false"><ref loc="MAT 10:40">ማቶ. 10፡40</ref>፤ <ref loc="MRK 9:37">ማር. 9፡37</ref>፤ <ref loc="LUK 9:48">ሉቃ. 9፡48</ref>፤ <ref loc="LUK 10:16">10፡16</ref>። </char></note><verse eid="JHN 13:20"/></para>
  <para style="s1">የሱስ ስክስት ክትም እምድባብም እርምሶ ኬዘና</para>
  <para style="r">(<ref loc="MAT 26:20-25">ማቶ. 26፡20-25</ref>፤ <ref loc="MRK 14:17-21">ማር. 14፡17-21</ref>፤ <ref loc="LUK 22:21-23">ሉቃ. 22፡21-23</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21"/>የሱስ ኮም ይ ጋይሳንደታ ቡር ይንታ አያንካ ማጥምሶ፥ “ዶፈን ዶፈን ጋይድቴ፥ የንታርንካ ዋልቀና ስክስት እም እምዴ” ጋየሮ መየካ ኬዜ።<verse eid="JHN 13:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22"/>የሱሰታ ካርንካ ጎርስምድባብከስ ኮም Ꮊይካንታ ኬዛ ናንከረ ከታ ይ ኤሳክን ኦል ክክ ክክ ዳንድምሰኬ። <verse eid="JHN 13:22"/><verse number="23" style="v" sid="JHN 13:23"/>የሱስ ይ ሶልምድ Ꮊቅባብ የሱሰታ ካርንካ ጎርስምድ ባብታርንካ ዋልቀባብ የሱሰታ ላመር ዶቅሶ Ꮊቄ። <verse eid="JHN 13:23"/><verse number="24" style="v" sid="JHN 13:24"/>ስምኦን ጴጥሮሰረ ክትም ቃዉተካ ሰችሶ “Ꮊይካንታ ክት ኬዛ ናንከረ የና ኦይስካ” ጋይሴ።<verse eid="JHN 13:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25"/>ኮካንታ ኖ የሱሰደር እጵን ጋይሶ “ጮይስዮ! ስክስት የስም እምድባብ Ꮊይራ?” ጋይሶ ኦይሴ።<verse eid="JHN 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26"/>የሱሰረ “ኖ ኮ ሶለን ማጭንካ ዱክትቶ እ ባርዝድ ባቤ” ጋይሴ። <verse eid="JHN 13:26"/><verse number="27" style="v" sid="JHN 13:27"/>ይሁዳ ባርስንም ይ ተያንደታ ቡር ሳና ሰጣን ክታር አርደዴ፥ የሱሰረ ይሁደም፥ “ይካንታ የስ ገቀርሳንደትም ሳነካ ይካ!” ጋይሴ። <verse eid="JHN 13:27"/><verse number="28" style="v" sid="JHN 13:28"/>የሱስ ኮም Ꮊረታ ክት ጋይሳናከረ እችምንደር ዶቅስባብ ከስካንታ አርዳክዬ። <verse eid="JHN 13:28"/><verse number="29" style="v" sid="JHN 13:29"/>ይሁዳ ብራ የድባብ ክት ማቻን ኦል ክታ ካርንካ ጎርስምድባብከሳርንካ የሱስ “ባአልንካንታ ዎም ዝግዝድንደትም ሰንካ አነረ ርካየንባብከስካንታ እምንተንም እምካ” ክት ጋይሳን ከትም ካምሴ።<verse eid="JHN 13:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 13:30"/>ይሁደረ ባርስንም ይ ተያንግንዳ ሳና ናና ዉትሶ አይሴ፥ ፍጨነረ ገልትገር ማዴ።<verse eid="JHN 13:30"/></para>
  <para style="s1">ክላ ክታ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31"/>ይሁዳ ዉትሶ አይሳንደታ ቡር የሱስ፥ “ታ ሳብ ይንች ቦንችምቴ፥ ክት ጎከረ ሳብ ቦንችምቴ፥ <verse eid="JHN 13:31"/><verse number="32" style="v" sid="JHN 13:32"/>ሳብ ክትጎካ ክት ቦንችምሰ ሳበረ ክትም ቦንችዝዴ ሳነከረ ቦንችዝዴ። <verse eid="JHN 13:32"/><verse number="33" style="v" sid="JHN 13:33"/>እስታ ይንችን ከሶ፥ የንካ ክክን በድ ሰጫ ዶቃይቴ፥ የተረ እም ዝግተረቴ፥ አይሁድንከስታ ገችንባብ ከዝደር ‘እ አይድንደታር የታ Ꮊድካንታ ማታየቴ’ እ ከትም ጋይሳንደት ግንዳ፥ ታየረ የካንታ ኩን ጋይድቴ።<note caller="-" style="x"><char style="xo" closed="false">13፡33 </char><char style="xt" closed="false"><ref loc="JHN 7:34">ዮሀ. 7፡34</ref>። </char></note> <verse eid="JHN 13:33"/><verse number="34" style="v" sid="JHN 13:34"/>ክክ ክክ የ ሶልምድን ግንዳ ክላ ክታ የም እምድቴ፥ እ የም ሶልምሳን ግንዳ የተረ ክክ ክክ ሶልምከቴ።<note caller="-" style="x"><char style="xo" closed="false">13፡34 </char><char style="xt" closed="false"><ref loc="JHN 15:12">ዮሀ. 15፡12</ref>፥<ref loc="JHN 15:17">17</ref>፤ <ref loc="1JN 3:23">1 ዮሀ. 3፡23</ref>፤ <ref loc="2JN 1:5">2 ዮሀ. 5</ref>። </char></note> <verse eid="JHN 13:34"/><verse number="35" style="v" sid="JHN 13:35"/>ክክ ክክ የ ሶልምሳ ማቸ እስታ ካርንካ ጎርስምድባብ የ ማቻንደትም ኤድ ሙደና ኮካ ኤዝደኬ” ኩን ጋይሴ።<verse eid="JHN 13:35"/></para>
  <para style="s1">ጴጥሮስ ካድንደትም የሱስ እርናና ኬዛንዳ</para>
  <para style="r">(<ref loc="MAT 26:31-35">ማቶ. 26፡31-35</ref>፤ <ref loc="MRK 14:27-31">ማር. 14፡27-31</ref>፤ <ref loc="LUK 22:31-34">ሉቃ. 22፡31-34</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36"/>ኮታ ቡር ስምኦን ጴጥሮስ የሱስም፥ “ጮይስዮ! Ꮊብረስ አይዳ?” ጋይሶ ኦይሴ።</para>
  <para style="p" vid="JHN 13:36">የሱሰረ “እ አይድንደታር ታ እም ጎርስምካንታ ማዳካዬ፥ ቡር ማቼ እም ጎርስምዳዬ” ጋይሶ ማስሴ።<verse eid="JHN 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37"/>ጴጥሮሰረ “ጮይስዮ! Ꮊረተረ ታ እ የስም ጎርስምካንታ ማታይንዳ? እታ እስታ ሰንፔን ዎራ የስጎካ ስክስት እምድቴ” ጋይሴ።<verse eid="JHN 13:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38"/>የሱሰረ “የና የስታ ሰንፔን እካንታ ስክስት እምዳ? ዶፈን ዶፈን የስም ጋይድቴ፥ ታካ ባቻ ቅቅተርንደታ እሪ ማክን ዱት እም ካተራዬ” ጋይሶ ማስሴ።<verse eid="JHN 13:38"/></para>
  <chapter eid="JHN 13"/>
  <chapter number="14" style="c" sid="JHN 14"/>
  <para style="s1">ጮይስ ባቤንደር ተይ አይድንጎግና የሱስ ማትንተና</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1"/>ካርንከረ የሱስ፥ “የንታ ቡደና Ꮊይማጠራ፥ ሳብካ አመንከቴ፥ እንከረ አመንከቴ፥ <verse eid="JHN 14:1"/><verse number="2" style="v" sid="JHN 14:2"/>እስታ ባቤንታ ኤሪ በድ ዶቅንትታ ካሪ ዶቅዴ፥ ኩን ማታከስናና እታ የካንታ ኬዝድትዶቆ የ ዶቅተርንደትም ካሪ ግግስካንታ አይድቴ። <verse eid="JHN 14:2"/><verse number="3" style="v" sid="JHN 14:3"/>አይስቶ ካሪ የካንታ እ ኡርሳንደታ ቡር እ ዶቅድንደታር የ ዶቅተርንግንዳ ካርንካ Ꮊድስቶ የም እዝደር ተይ አይድቴ። <verse eid="JHN 14:3"/><verse number="4" style="v" sid="JHN 14:4"/>እ አይድንደት ካርናር የልዝድን ጎግን የታ ኤዝደቴ” ኩን ጋይሴ።<verse eid="JHN 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5"/>ቶማስ “ጮይስዮ! Ꮊብር የስ አይዳ ናነረ ኤሳዮቴ፥ ይና፤ ጎግንም Ꮊስ ይሶንት ኤዝዳ?” ጋይሴ። <verse eid="JHN 14:5"/><verse number="6" style="v" sid="JHN 14:6"/>የሱሰረ ክትካንታ፥ “ጎግንከ ዶፈንና ሰንፔነረ እትቴ፥ እጎካ ማታክንዳ ማቼ Ꮊየሰነረ ሳብ ባቤንደር Ꮊድባብ ካዬ። <verse eid="JHN 14:6"/><verse number="7" style="v" sid="JHN 14:7"/>እመረ የ ኤስታ ናና እስታ ባቤንመረ ኤዝደት ዶቆ፥ ኮዘንካ ኦስ ማቼ የታ ኤስተረቴ፥ ክትም ሰተቴ” ኩንጋይሶ ማስሴ።<verse eid="JHN 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8"/>ፍልጶሰረ “ጮይስዮ! ሳብ ባቤንም ሰችስካ ዎም ማዴ” ጋይሴ። <verse eid="JHN 14:8"/><verse number="9" style="v" sid="JHN 14:9"/>የሱሰረ፥ “ፍልጶሶ! ኮካ ስላ የንካ ክክን እ ዶቅድንካ እም ኤዝዳካ? እም ሰጅባብ ሳብ ባቤንም ሰጄ፥ ይና የና ‘ሳብ ባበንም እም ሰችካ’ Ꮊሰስ ጋይዳ? <verse eid="JHN 14:9"/><verse number="10" style="v" sid="JHN 14:10"/>እታ ሳብ ባቤንካ እ ዶቅድንደትም፥ ሳብ ባቤነረ እንካ ዶቅድንደትም አመናያ? የካንታ እከዝድንዳ ቃለና እስታ ኤረካ ካዬ፥ ኬዛርካ ማቼ፥ ፍክስንም ሙዳ ፍግዝድባብ እንካ ዶቅድባብ ሳብ ባቤኔ። <verse eid="JHN 14:10"/><verse number="11" style="v" sid="JHN 14:11"/>እታ ሳብ ባቤንካ እ ዶቅድንደትግንዳ ሳብ ባቤነረ እንካ ዶቅድንደትም አመንከቴ፥ ኩን ካየንዳ ማቼ እስታ ፍክስን ከስ ጎካ እም አመንከቴ። <verse eid="JHN 14:11"/><verse number="12" style="v" sid="JHN 14:12"/>ዶፈን ዶፈን የም ጋይድቴ እንካ አመንድ ባብ እ ፍግዝድንደትም ፍክስን ፍግዝዴ፥ ኮት ኮግንደረ ኮታዘንካ ስገዳን ፍግዝዴ፥ እታ ሳብ ባበንደር እ አይድን ካንቴ። <verse eid="JHN 14:12"/><verse number="13" style="v" sid="JHN 14:13"/>ሳብ ባቤና ይንችን ጎካ ቦንችምድን ግንዳ እስታ ላምንካ የ ምግዝድንደትም ሙዳ የካንታ ይድቴ። <verse eid="JHN 14:13"/><verse number="14" style="v" sid="JHN 14:14"/>Ꮊረሰነረ ር እስታ ላምንካ የ ምክሴ እታ ይድቴ” ኩንጋየሮ ማስሴ።<verse eid="JHN 14:14"/></para>
  <para style="s1">የሱስ አያን ጭልንጎካ እምሳን Ꮊድን ጉርም</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15"/>“እም የ ሶልምዳ ማቼ እስታ ክተን ካርስከቴ፥ <verse eid="JHN 14:15"/><verse number="16" style="v" sid="JHN 14:16"/>እታ ሳብ ባቤንም ምክስትቴ፥ ኖየረ ስለንካ የንካ ክክን ዶቅድንደትም አብ ዳንዳእዝድንደትም የካንታ እምምዴ። <verse eid="JHN 14:16"/><verse number="17" style="v" sid="JHN 14:17"/>ና ኮነረ ዶፈንንታ አያነረ፥ ፍጫ ሙደና ክትም ሰዳይንካንተከ ኤሳይንካንታ ተይካንታ ማታዬ፥ የታ ማቼ፥ ኖ የንካ ክክን ማቻን ካንተከ የንታ ዋረረ ዶቅድንካንታ ክትም ኤስተረቴ።<verse eid="JHN 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 14:18"/>“እንደንከኬ ባቤንካ ካየን ይንችግንዳ የም Ꮊክ ዛቅዳክቴ፥ ማትቶ የንደር Ꮊድቴ። <verse eid="JHN 14:18"/><verse number="19" style="v" sid="JHN 14:19"/>ቶክማ ሰጨታ ቡር ፍጫ ሙደና እም ሰዳዬ፥ የታ ማቼ እም ሰደቴ እታ ሰንፔካ እ ማቻን ካንታ የተረ ሰንቴካ ዶቅተረቴ፥ <verse eid="JHN 14:19"/><verse number="20" style="v" sid="JHN 14:20"/>እታ ሳብ ባቤንካ ዶቅድንደትግንዳ የተረ እንካ የ ዶቅድንደትግንዳ እተረ የንካ እ ዶቅድንደትግንዳ ኮት ሰጨንካ ኤስተረቴ።<verse eid="JHN 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 14:21"/>“እም ሶልምድባብ እስታ ክተንም ተይድባብኬ ፍክስዘን Ꮊቅዝድባቤ፥ እመረ ሶልምድባብም እስታ ባቤና ሶልምዴ፥ እተረ ሶልምድቴ፥ እስታ ማተንመረ ክትካንታ Ꮊብዝድቴ” ጋይሴ።<verse eid="JHN 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22"/>አስቆሮንት ይሁዳ ማታክባብ አብ ይሁዳ፥ “ጮይስዮ! የስታ ማተንም ፍጫ ሙደን ካንታ ማታክናና ዎካንታ መያ የስ ማስዝድንዳ Ꮊስግንደረ?” ጋይሴ።<verse eid="JHN 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23"/>የሱሰረ፥ “እም ሶልምድባብ እስታ ቃለን ካርዝዴ፥ እስታ ባቤነረ ክትም ሶልምደ፥ ዎታ ክደር Ꮊድሶቶ ክትካ ክክን የካ ዶቅዶቴ። <verse eid="JHN 14:23"/><verse number="24" style="v" sid="JHN 14:24"/>እም ሶልምያይባብ እስታ ቃለን ካርሳዬ፥ ኮና የ ኤሰርድን ቃለና እም ኦይችባብ ሳብ ባቤንታ ዳት እስታ ካዬ። ኩንጋየሮ ከትካንታ ማስሴ።<verse eid="JHN 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25"/>“ታ የንከረ ክክን ዶቅድቶ ኮም ርይን የም ከዝትቴ፥ <verse eid="JHN 14:25"/><verse number="26" style="v" sid="JHN 14:26"/>ሳብ ባቤና እስታ ላምካ ኦይድንዳ ዳንዳእዝድንዳ አያንይ ጭልና ማቼ ሙዳ ርይን የም ኤስዝዴ፥ እ ኬዛንደትም ሙዳ የ ገቀርድንግንዳ ይዴ።”<verse eid="JHN 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27"/>“ሳራትችን የካንታ ዛቅድተ እስታ ሳራትችንመረ እምድቴ፥ እ የም እምድንዳ ሳራትችና ፍጫ ሙደና እምድንደት ግንዳ ካዬ፥ የንታ ቡደና Ꮊይ ማጥማ፥ ጉጅሰረ Ꮊይ ጳሳ። <verse eid="JHN 14:27"/><verse number="28" style="v" sid="JHN 14:28"/>‘እታ አይድቴ፥ ማተረ የንደር Ꮊድቴ’ እ ጋይሳን ግንዳ ኤሰርተቴ፥ እስታ ባቤና እዘንካ ስግድን ኦል እም የ ሶልምታ ናና ሳብ ባቤንደር እስታ አይንተንካ ጉርም የም ዝግዝዳዶቆ። <verse eid="JHN 14:28"/><verse number="29" style="v" sid="JHN 14:29"/>ኮና ማድንደትᎺይካ የ አመንድንደትግንዳ ማትንተንታ እር የም ከዝትቴ። <verse eid="JHN 14:29"/><verse number="30" style="v" sid="JHN 14:30"/>ኮ ፍጫሙደንታ ገችንባብ ማችባብ ሰጣን ክታ Ꮊድንታ ማቻን ካንታ ኮዘንካ ኦስ የንካ ክክን በድ ከዝማይቴ። ክታ ማቼ እዘን Ꮊረሰነረ ዎልቃ ካዬ፥ <verse eid="JHN 14:30"/><verse number="31" style="v" sid="JHN 14:31"/>ኬዛር ማቼ እታ ሳብ ባቤንም እ ሶልምድንደት ግንዳ ፍጫ ሙደና ኤስተርን ግንዳ ሳብ ባቤና እም ክትሳንደትም ሙዳ ታ ቦዳዶቅድቴ፥ አምከቴ ካርንካ ዎም ሙከቴ።<verse eid="JHN 14:31"/></para>
  <chapter eid="JHN 14"/>
  <chapter number="15" style="c" sid="JHN 15"/>
  <para style="s1">ዶፈን ዎይንና የሱስየ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1"/>“ዶፈን ዎይንንታ ዛንበና እትቴ፥ ኮረንባብ እስታ ባቤኔ፥ <verse eid="JHN 15:1"/><verse number="2" style="v" sid="JHN 15:2"/>እስታዘን ዶቅድን አፍን ኡዝዳክንደትም ሳቀንም ሙዳ እስታ ባቤና ቃርጭት ዛቅዴ፥ አፍ ኡዝድን ሳቀን ማቼ በድ ኡዝድን ግንዳ ሳቅት ኡርዝዴ። <verse eid="JHN 15:2"/><verse number="3" style="v" sid="JHN 15:3"/>የተረ እከዛን ቃለንጎካ ታ ጭልምስባበቴ። <verse eid="JHN 15:3"/><verse number="4" style="v" sid="JHN 15:4"/>እንካ ዶእከቴ፥ እተረ የንካ ዶቅትቴ ሳቀና ዛንበን ዘን ዳቅሶ ዶቃክ ማቼ ይንት አፍ ኡስካንታ ማዳክንደትግንዳ የተረ እንካ የ ዶቃክንዳ ማቼ አፍ ኡስካንታ ማታየቴ።<verse eid="JHN 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5"/>“እታ ዎይንንታ ዛንብቴ፥ የተረ ሳቀቴ፥ በድ አፍ ኡዝድባብ እንከረ ዶቅድባብከ እተረ ክትካ ዶቅድባቤ፥ ኬዛርካ ማቼ እ ካይሳ Ꮊረሰረ ይካንታ ማታየቴ። <verse eid="JHN 15:5"/><verse number="6" style="v" sid="JHN 15:6"/>እንካ ዶቃይባብ ሳቀንግንዳ ማል ዛቅምሶ ዎጅዴ፥ ኮግንዳ ማችባብ ሳቀንከስ ሳንስምት ኖሀር ኦይትምዳ አችምደኬ። <verse eid="JHN 15:6"/><verse number="7" style="v" sid="JHN 15:7"/>እንካ የ ዶቅሴ እስታ ቃለነረ የንካ ዶቅሴ የ ዝግዛንደትም የ ምክሰ Ꮊብደቴ። <verse eid="JHN 15:7"/><verse number="8" style="v" sid="JHN 15:8"/>በድ አፍ የ ኡዝደኬ እስታ ካርንካ ጎርስምድባብ የ ማዴ ኮትካ እስታ ባቤና ቦንችምዴ። <verse eid="JHN 15:8"/><verse number="9" style="v" sid="JHN 15:9"/>ሳብ ባቤና እም ሶልምሳንደት ግንዳ እተረ የም ሶልምሳቴ፥ ኮካንታ እስታ ሶልመንካ ዶእከቴ። <verse eid="JHN 15:9"/><verse number="10" style="v" sid="JHN 15:10"/>እታ እስታ ባቤንታ ክተንም እ ቦንችሳንደትግንደኬ ክታ ሶልመንካ እ ዶቅድንግንዳ የተረ እስታ ክተንም የ ቦችሰ እስታ ሶልመንካ ዶቅተረቴ። <verse eid="JHN 15:10"/><verse number="11" style="v" sid="JHN 15:11"/>ኮም እ የካንታ ኬዛንዳ እስታ ጉርምና የንካ ማድንደትግንደከ የንተረ ጉርምና ቦድማ ማድን ግንዴ። <verse eid="JHN 15:11"/><verse number="12" style="v" sid="JHN 15:12"/>እስታ ክተና እ የም ሶልምሳን ግንዳ የተረ ክክ ክክ የ ሶልምድን ግንዴ።<note caller="-" style="x"><char style="xo" closed="false">15፡12 </char><char style="xt" closed="false"><ref loc="JHN 13:34">ዮሀ. 13፡34</ref>፤ <ref loc="JHN 15:17">15፡17</ref>፤ <ref loc="1JN 3:23">1 ዮሀ. 3፡23</ref>፤ <ref loc="2JN 1:5">2 ዮሀ. 5</ref>። </char></note> <verse eid="JHN 15:12"/><verse number="13" style="v" sid="JHN 15:13"/>ኤድ ይንታ ገርነን ካንታ ሰንፔንም ስክስት እመዘንካ ስገዳንዳ ሶልማ ካዬ። <verse eid="JHN 15:13"/><verse number="14" style="v" sid="JHN 15:14"/>የተረ እ ክድንደትም የ ቦችሰ እስታ ገርነንከሰቴ። <verse eid="JHN 15:14"/><verse number="15" style="v" sid="JHN 15:15"/>አይለንከስ ማታ ቆልስባብ ይድንደትም ከት ኤሳይንደትካንታ ኮታዘንካ ኦስ አይለንከሰ የም ጋያይቴ፥ ኬዛር ማቼ እስታ ባቤንዘንካ እ ኤሰርሳንደትም ሙዳ የካንታ መያ እ ማስሳንደት ኦል እስታ ኮችንከሰ ጋይትቴ፥ <verse eid="JHN 15:15"/><verse number="16" style="v" sid="JHN 15:16"/>እታ የም እጃት ዳት የታ እም እዳከቴ አይሰቶ በድ አፍ የ ኡዝድን ግንዳ፥ የንታ አፍነረ ዶቅድንዳ ማድንግንዳ የም ዶርሳቴ። ኮካንታ እስታ ላምንካ የ ምግዝድንደትም ሙዳ ሳብ ባቤና የካንታ እምዴ። <verse eid="JHN 15:16"/><verse number="17" style="v" sid="JHN 15:17"/>ይና እታ የም ክድንዳ ክክ ክክ ሶልምተርንግንዴ።<verse eid="JHN 15:17"/></para>
  <para style="s1">የሱስ ኮ ፍጫሙደንታ ግርንጎካ ክታ ኬዘና</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18"/>“ኮፍጫ ሙደና የም ግርሰ ኤና እሪ እም ግርዳንደትም ኤስከቴ። <verse eid="JHN 15:18"/><verse number="19" style="v" sid="JHN 15:19"/>ኮፍጫ ሙደን ኮታ የ ናና የም ሶልምዳ Ꮊቄ፥ ኬዛርካ ማቼ ኮ ፍጫሙደንታ የ ማታክንደት ኦላርከ እታ ኮ ፍጫሙደንዘንካ ፋስስቶ እ የም እጃንደት ኦል፥ ኮፍጫ ሙደና የም ግርዴ። <verse eid="JHN 15:19"/><verse number="20" style="v" sid="JHN 15:20"/>አይለና ማታ ቆልስባብዘንካ ስጋየ እ ጋይሳንደትም ገቀርከቴ፥ እም ይ ዳይሳንካ የመረ ዳይደኬ፥ እስታ ቃለንም ከት ካርሰ የንተረ ቃለንም ካርዝደኬ።<note caller="-" style="x"><char style="xo" closed="false">15፡20 </char><char style="xt" closed="false"><ref loc="MAT 10:24">ማቶ. 10፡24</ref>፤ <ref loc="LUK 6:40">ሉቃ. 6፡40</ref>፤ <ref loc="JHN 13:16">ዮሀ. 13፡16</ref>። </char></note> <verse eid="JHN 15:20"/><verse number="21" style="v" sid="JHN 15:21"/>እም ኦይችባብም ከት ኤሳይንካንታ እጎካ ኮም ሙዳ የንዘን ይዴ። <verse eid="JHN 15:21"/><verse number="22" style="v" sid="JHN 15:22"/>እታ Ꮊድስቶ የካንታ ኬዛክናና ጎማ የንዘን ማዳክ ዶቆ ታ ማቼ ከታ ጎመንታ ስርስ ኬዛ ካዬ። <verse eid="JHN 15:22"/><verse number="23" style="v" sid="JHN 15:23"/>እም ቦዝድባብ እስታ ባቤንመረ ግርዴ። <verse eid="JHN 15:23"/><verse number="24" style="v" sid="JHN 15:24"/>አብ ኤድ ይያክንደትም ፍክስ ከታ ዎክያር ፍክስማከስናና ጎማ ከታዘን ማተራክዶቆ፥ ታ ማቼ ኮም ሙዳ ሰጃንደታ ቡር እመረ እስታ ባቤንመረ ግርተኬ። <verse eid="JHN 15:24"/><verse number="25" style="v" sid="JHN 15:25"/>ኮነረ ማቻንዳ፥ ‘ስርስ ኬዝካይሳ እም ግርተኬ’ ጋይምሶ ከታ ህግናር ጻፍምሳንዳ ቃለና ቦድንግንዴ።<verse eid="JHN 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26"/>“ኬዛር ማቼ ሳብ ባቤንዘንካ ዉድንደትኬ እተረ ሳብ ባቤንዘንካ የካንታ እ ኦይድንዳ ዳቅስንባብ ዶፈን አያንና Ꮊድሶ ኖ እጎካ ማርከርዴ። <verse eid="JHN 15:26"/><verse number="27" style="v" sid="JHN 15:27"/>የተረ እርንደትዘንካ አምስሶ እንካ ክክን የ Ꮊቃንኦል ማርከርደቴ።<verse eid="JHN 15:27"/></para>
  <chapter eid="JHN 15"/>
  <chapter number="16" style="c" sid="JHN 16"/>
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1"/>“ይና፥ ኮም ሙዳ እ የካንታ ኬዛንዳ የንታ አሜንና ዙብምተራክን ግንዳ ጋይስቴ። <verse eid="JHN 16:1"/><verse number="2" style="v" sid="JHN 16:2"/>አይሁድንከስታ ምክስ ኤሄናርንካ ዉችሰኮ የም ዳይደኬ፥ ኮግንደረ የም ደይዝድባብ ሙደና ሳብካንታ ከት ፍግዝድን ካምድን ሰጫ Ꮊዴ። <verse eid="JHN 16:2"/><verse number="3" style="v" sid="JHN 16:3"/>ኮመረ ከት ይድንዳ ሳብ ባቤንመረ ማታ እም ከታ ይ ኤሳክን ካንቴ። <verse eid="JHN 16:3"/><verse number="4" style="v" sid="JHN 16:4"/>ኮም የካንታ እስታ ኬዘና ማቼ ሰጨና የልድንካ Ꮊራ እ የም ጋይሳናከረ የ ገቀርድን ግንዴ” ኮም ሙዳ ኮታ እር እ የካንታ ከዛክንዳ የንካ ክክን Ꮊቃንካንቴ፥<verse eid="JHN 16:4"/></para>
  <para style="s1">አያን ጭልንታ ፍክስ</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5"/>ታ ማቼ እም ኦይችባብደር እታ አይድቴ፥ ማችንከረ የንታ ዋርንካ Ꮊበስ አይዳ? ጋይሶ እም ኦይዝድባብ ካዬ። <verse eid="JHN 16:5"/><verse number="6" style="v" sid="JHN 16:6"/>ማታጋካ ዳት ኮም ሙዳ እ የም ኬዛን ጎካ የንታ ቡደና ሞርእካ ጮጭቴ። <verse eid="JHN 16:6"/><verse number="7" style="v" sid="JHN 16:7"/>እታ ማቼ ዶፈን ዶፈን የም ጋይድቴ፥ እስታ አይንተና የካንታ መይዴ፥ እ አያክንዳ ማቼ ዳቅስንባብ የንደር Ꮊዳዬ፥ እ አይሳን ማቼ አያን ጭልን ክትም የካንታ ኦይድቴ። <verse eid="JHN 16:7"/><verse number="8" style="v" sid="JHN 16:8"/>አያን ጭልና ᎺዳንደትᎺይካ ጎማካንታ፥ ጭልምጎካ ሳብታ ፍርዳጎካ ኮ ፍጫሙደንታ ኤድንም መያ ማስሶ ሰጅዴ። <verse eid="JHN 16:8"/><verse number="9" style="v" sid="JHN 16:9"/>ጎመን ካንታ መያ ማዝድንዳ እንካ ከት አመንዳክንካንቴ፥ <verse eid="JHN 16:9"/><verse number="10" style="v" sid="JHN 16:10"/>ጭለትቺንካንታ መያ ማዝድንዳ ሳብ ባቤንደር አይድን ካንተከ ኮታዘንካ ኦስ እም የ ሰዳይንካንታ፥ <verse eid="JHN 16:10"/><verse number="11" style="v" sid="JHN 16:11"/>ፍርደንጎካ መያ ማዝድንዳ ኮ ፍጫሙደንታ ገችንባብ ሰጣን ፋረድምሳን ካንቴ።<verse eid="JHN 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12"/>አክ እ የም ኬዝድንዳ በድ ር ዶቅዴ፥ ኬዛርካ ማቼ ታ የም ደጭዴ፥ <verse eid="JHN 16:12"/><verse number="13" style="v" sid="JHN 16:13"/>ዶፈን አያንና ᎺዳንደትᎺይካ ዶፈንንደር ሙዳ የም ጎርዝዴ። አያን ጭልና ኬዝድንዳ ይ እዘንካ ኤሰርሳን ዳት ይንተን ማታክንካንታ ኖ ኦስ እሪ ማድንደትም ሪይንከስም የካንታ ኬዝዴ። <verse eid="JHN 16:13"/><verse number="14" style="v" sid="JHN 16:14"/>እስታ ማቻንደትዘንካ ተይዮ የካንታ ኬዝድን ካንታ እም ቦንጅዴ። <verse eid="JHN 16:14"/><verse number="15" style="v" sid="JHN 16:15"/>ሳብ ባቤንታ ማቻንዳ ሙዳ እስቴ እስታ ማቻንደትዘንካ ተይዮ የካንታ ኬዝዴ እ ጋይሳንዳ ኮካንቴ።<verse eid="JHN 16:15"/></para>
  <para style="s1">ሞርእና ጉርምያር ኦክምና</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16"/>“ቶክም ሰጨታ ቡር እም ሰዳየቴ፥ አና ቶክም ሰጨታ ቡር እም ሰደቴ”።<verse eid="JHN 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17"/>ክታ ካርንካ ጎርስምድባብከሳርንካ ዋልቃ ዋልቀንከስ “ኮና፥ ‘ቶክም ሰጨታ ቡር እም ሰዳከቴ፥ ጉጅሶ ቶክም ሰጨታ ቡር እም ሰደቴ፥ ጉጅሶ ሳብ ባቤንደር አይድቴ’ ዎንደር ክት ጋይድንዳ ሪና Ꮊራ?” ክክ ጋይሰኬ። <verse eid="JHN 16:17"/><verse number="18" style="v" sid="JHN 16:18"/>“ይና ኮና ‘ቶክም ሰጨታ ቡር’ ጋይድንዳ ሪና Ꮊራ? ክት ኬዝድንደትም ርን ኤሳዮቴ” ክክ ክክ ጋይንተካ ኦይስምሰኬ።<verse eid="JHN 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19"/>የሱሰረ ከት ኦይስካንታ ዝግዛንደትም ኤስሶ ኩን ከትም ጋይሴ፥ ክክ ክክ የ ኦይስምድንዳ፥ “ቶክም ሰጨታ ቡር እም ሰዳከቴ፥ አና ቶክም ሰጨታ ቡር እም ሰደቴ” እ የም ጋይሳን ካንቶ? <verse eid="JHN 16:19"/><verse number="20" style="v" sid="JHN 16:20"/>ዶፈን ዶፈን የም ጋይድቴ፥ የታ ኤብደቴ፥ ፍብደቴ፥ ኮፍጫ ሙደንም ማቼ ጉርምዝዴ፥ የታ ሞርእደቴ፥ ኬዛርካ ማቼ የንታ ሞርእና ጉርምያር ኦክምዴ። <verse eid="JHN 16:20"/><verse number="21" style="v" sid="JHN 16:21"/>ማና ይ አጥንደትᎺይካ ጋእርታ ሰጨና ኮታ የልሳን ካንታ ሞርእደ፥ ይ አጫንደታ ቡር ማቼ ኮ ፍጫሙደንዘን ኡላ አጥምሳን ካንታ ይንታ ጉርምንዘንካ አምሳንዳ ይንታ ማጠንም ገቀራዬ። <verse eid="JHN 16:21"/><verse number="22" style="v" sid="JHN 16:22"/>ኮትኮግንደረ የታ ታ ሞርእደተ ኬዛርካ ማቼ እታ ካርንካ የም ሰድቴ፥ የንታ ቡደነረ ጉርምዴ የንታ ጉርምንመረ የንዘንካ ተይድባብ ካዬ።<verse eid="JHN 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 16:23"/>ኮት ሰጨንካ እዘንካ Ꮊረሰን ር ምክሳየቴ፥ ዶፈን ዶፈን የም ጋይድቴ ሳብ ባቤንም እስታ ላምካ የ ምግዝድንደትም ሙዳ ሪን የም እምዴ። <verse eid="JHN 16:23"/><verse number="24" style="v" sid="JHN 16:24"/>ታካ የለልታ እስታ ላምንካ Ꮊራ ሪየረ ምክሳከቴ፥ ምክስከቴ የካንታ እምምዴ የንታ ጉርምነረ ቦድማ ማዴ።<verse eid="JHN 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25"/>“ታ የለልታ ካምስካ ከዛቴ፥ ኮታዘንካ ኦስ ካምስካ እከዝዳክንደታ ሰጫ Ꮊዴ፥ ኬዛርካ ማቼ ሳብ ባቤን ጎካ ሙዳ ሪይንም እታ መያ ማስስቶ የም ኬዝድቴ። <verse eid="JHN 16:25"/><verse number="26" style="v" sid="JHN 16:26"/>ኮት ሰጨንካ እስታ ላምንካ ምግዝደቴ፥ እተረ ሳብ ባቤንም የካንታ ምግዝድተ ጋያይቴ። <verse eid="JHN 16:26"/><verse number="27" style="v" sid="JHN 16:27"/>Ꮊረታ ጋይሴ ሳብ ባቤን ይንታ ማታርካ የም ሶልምድን ካንታ፥ ሳብ ባቤነረ የም ሶልምድንዳ እም የ ሶልምሳን ካንተከ ሳብታ ላማርንካ እ Ꮊዳን ግንዳ የ አሜንሳንካንቴ። <verse eid="JHN 16:27"/><verse number="28" style="v" sid="JHN 16:28"/>ሳብ ባቤንዘንካ ዉትስቶ፥ ኮ ፍጫሙደንዘን Ꮊትቴ፥ ካርንከረ ኮፍጫ ሙደን ዛቅስቶ፥ ሳብ ባቤንደር አይድቴ”።<verse eid="JHN 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29"/>ክታ ካርንካ ጎርስምድባብከስ ኩን ጋይሰኬ፥ “ይና! ታ ካምስካ ማታክናና መየካ ኬዛዬ፥ <verse eid="JHN 16:29"/><verse number="30" style="v" sid="JHN 16:30"/>የና ሙደን የስ ኤዝድንግንደከ Ꮊየነረ ኦይስ ግክስካንታ ዝግዝዳክንደትም ታ ኤሶቴ፥ ኮካንታ ሳብዘንካ የስ ዉተዳንደትም አሜንዶቴ” ኩን ጋይሰኬ።<verse eid="JHN 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31"/>የሱሰረ፥ “ታ የታ አሜንተቴ? <verse eid="JHN 16:31"/><verse number="32" style="v" sid="JHN 16:32"/>ማታጋካ ዳት የታ ዋልቃ ዋልቀና የም ዝክሳን ጎካ የ ይጭምድንደትኬ እም Ꮊክ የ ዛቅድንደታ ሳዓት Ꮊዴ፥ ሳዓትነረ ታ የልቴ ኬዛርካ ማቼ ሳብ ባቤና እንካ ክክን ማቻን ካንታ እስት ካይቴ። <verse eid="JHN 16:32"/><verse number="33" style="v" sid="JHN 16:33"/>ኮም የካንታ እስታ ኬዘና እንካ ማትሰቶ ሳራትችና የካንታ ዶቅድንግንዳ ጋይስቴ፥ ኮ ፍጫሙደንዘን የ ዶቅድንካ ማጣ የንዘን ዶቅዴ፥ ኬዛርካ ማቼ ዳእከቴ፥ እታ ኮፍጫ ሙደን ጋምትቴ” ኩን ከትካንታ ጋየሮ ማስሴ።<verse eid="JHN 16:33"/></para>
  <chapter eid="JHN 16"/>
  <chapter number="17" style="c" sid="JHN 17"/>
  <para style="s1">የሱሰታ ምክስ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1"/>የሱስ ኮም ይ ኬዛንደታ ቡር ጬክን ጋይሶ ፈስ ጭላር ሰደሮ ኩን ጋይሴ፥ “እባቦ! ይና፥ ሳዓትና የልቴ፥ የስታ ይንችና የስም ቦንጅድን ግንዳ የስታ ይንችንም ቦንችካ፥ <verse eid="JHN 17:1"/><verse number="2" style="v" sid="JHN 17:2"/>የስ ቦንጅድንደረ የስ እካንታ እምስባብ ሙደንካንታ ስለንካ ዶቅንትን እ እምድን ግንዳ ኤድንከስ ሙደንታዘን ገችታ ኤራ ክትካንታ የስ እምሳን ኦሌ። <verse eid="JHN 17:2"/><verse number="3" style="v" sid="JHN 17:3"/>ስለንካ ዶቅንትነረ፥ ጋይንት የና Ꮊክ ዶፈንን ጮይስንከ የስ ኦይችባብ የሱስ ክርስቶሰም ኤስንቴ። <verse eid="JHN 17:3"/><verse number="4" style="v" sid="JHN 17:4"/>እታ የስ እካንታ እምሳን ፍክስን ቦድስቶ ፍጨዘን የስም ቦንችስትቴ። <verse eid="JHN 17:4"/><verse number="5" style="v" sid="JHN 17:5"/>እባቦ! ፍጫ ሙደና ፍዝምተርንደታ እርምሶ የስካ ክክን እስታ ዶቅድንደት ቦንቸንካ ታየረ የስታ ባንግር እም ቦንችካ።<verse eid="JHN 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6"/>“ፍጫሙደንታ ዋርንካ እተዮ እካንታ የስ እምስባብ ኤድንከስካንታ የስታ ኤደትቼን መያ ማስሳቴ፥ ከታ የስታ Ꮊቀኬ፥ የና ከትም እካንታ እምሰዬ፥ ከተረ የስታ ቃለን ካርስተኬ፥ <verse eid="JHN 17:6"/><verse number="7" style="v" sid="JHN 17:7"/>የስ እካንታ እምሳንዳ ሙደና የዘንካ ማቻንግንዳ ከታ ታ ኤስተኬ። <verse eid="JHN 17:7"/><verse number="8" style="v" sid="JHN 17:8"/>የስ እካንታ እምሳን ቃለን ከትካንታ እምትቴ፥ ከተረ ኮትም ተይተኬ፥ የስታ ባንግርንካ እ Ꮊዳንደትም ዶፈንካ ኤስተኬ፥ የስ እም ኦይቻንደትመረ ከታ አሜንተኬ።<verse eid="JHN 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9"/>“እ ምግዝድንዳ ከትካንቴ፥ ከታኬና የስ እካንታ እምስባብ የስታ ከት ማቻንጎካ ከትካንታ ምግዝድቴ፥ ፍጫሙደንካንታ ምክሳይቴ። <verse eid="JHN 17:9"/><verse number="10" style="v" sid="JHN 17:10"/>እስታ ማቻን ሙደና የስቴ የስተረ ማችባብ እስቴ፥ እተረ ከትካ ቦንችምድቴ። <verse eid="JHN 17:10"/><verse number="11" style="v" sid="JHN 17:11"/>እታ ኮዘንካ ኦስ ፍጫሙደንዘን ዶቃይቴ፥ ከታ ማቼ ፍጫ ሙደንዘኔ። እታ የዝደር Ꮊድቴ፥ ጭል እስታ ባቤኖ፥ ኬና እካንታ የስ እምስባብ ዎግንዳ ዋልቃ ከት ማድንግንዳ እካንታ የስ እምሳን የስታ ላምንካ ከትም ካርስካ።<note caller="+" style="f"><char style="fr" closed="false">17፡11 </char><char style="ft" closed="false">እካንታ የስ እምሳን የስታ ላምንካ ከትም ካርስካ ጋይድንደትም፤ አብ ንከስ “እካንታ የስ እምስባብም ሙዳ የስታ ላምንካ ከትም ካርስካ። ጋይደኬ” </char></note> <verse eid="JHN 17:11"/><verse number="12" style="v" sid="JHN 17:12"/>እታ ከትካ የካ እ Ꮊቃንደትካ የስ እካንታ እምሳን የስታ ላምንካ ከትም ካርስትቴ፥ እተረ ከትም ካርሳቴ፥ ኮ ኦላር ጭል ማጻፍንታ ቃለና ቦድምድን ግንዳ ክትኮ ካይንታ ይንችንዘንካ አብ ከታርንካ ቦድሶ Ꮊየነረ ካያክዬ።<note caller="+" style="f"><char style="fr" closed="false">17፡12 </char><char style="ft" closed="false">የስ እካንታ እምሳን የስታ ላምንካ ከትም ካርስትቴ፤ አብ ንከስ “የስ እካንታ እምሳን ሙዳ የስታ ላምንካ ከትም ካርስትቴ” ጋይደኬ። </char></note><note caller="-" style="x"><char style="xo" closed="false">17፡12 </char><char style="xt" closed="false"><ref loc="PSA 41:9">የቺ 41፡9</ref>፤ <ref loc="JHN 13:18">ዮሀ. 13፡18</ref>። </char></note> <verse eid="JHN 17:12"/><verse number="13" style="v" sid="JHN 17:13"/>ታ እታ የዝደር Ꮊድቴ፥ ፍጫሙደንዘን ዶቅድቶ ኮም እ ኬዝድንዳ እስታ ጉርምና ከታዘን ቦድማ ማድንግንዴ። <verse eid="JHN 17:13"/><verse number="14" style="v" sid="JHN 17:14"/>እታ የስታ ቃለን ከትም እምትቴ፥ እታ ፍጫሙደንዘንካ እ ማታክንግንዳ ከተረ ፍጫሙደንዘንካ ካየኬ፥ ኮካንታ ፍጫ ሙደና ከትም ግርዴ። <verse eid="JHN 17:14"/><verse number="15" style="v" sid="JHN 17:15"/>ዳቅልንዘንካ ከትም የስካርዝድንግንዳ ዳት ፍጫሙደንዘንካ ኦስ አበር የስ ከትም ተይ አይድን ግንዳ ምክሳይቴ። <verse eid="JHN 17:15"/><verse number="16" style="v" sid="JHN 17:16"/>እታ ፍጫሙደንዘንካ እ ማታክንግንዳ ከተረ ኮ ፍጫሙደንዘንካ ካየኬ። <verse eid="JHN 17:16"/><verse number="17" style="v" sid="JHN 17:17"/>የስታ ዶፈንንካ የስካንታ ፋስምስባብ ከትም ማስካ፥ የስታ ቃለና ዶፈኔ። <verse eid="JHN 17:17"/><verse number="18" style="v" sid="JHN 17:18"/>የና እም ኮ ፍጫሙደንዘን የስ እም ኦይቻንግንዳ እተረ ከትም ኮ ፍጫሙደንዘን ከትም ኦይችቴ። <verse eid="JHN 17:18"/><verse number="19" style="v" sid="JHN 17:19"/>ከታ ዶፈንካ የስካንታ ፋስምስባብከስ ከት ማድንግንዳ እታ እስታ ማተንም ከትካንታ ጋይስቶ ፋስምስባብ ማዝድቴ።<verse eid="JHN 17:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20"/>“ከታ ቃለንጎካ እንከረ ከት አሜንምድን ኦል ምግዝድት ዳት ከትካንታ Ꮊክ ምክሳይቴ። <verse eid="JHN 17:20"/><verse number="21" style="v" sid="JHN 17:21"/>እተረ እ ምግዝድንዳ ሙደነረ ዋልቃ ከት ማድንግንዴ፥ ኮትኮግንደረ እባቦ! የና እንካ የስ ዶቅድንደትም፥ እተረ የስካ እ ዶቅድንደትም፥ ከተረ ዎንካ ከት ዶቅተርንግንዴ፥ የስ እም ኦይቻንግንደረ ፍጫ ሙደና አሜንድን ግንዴ። <verse eid="JHN 17:21"/><verse number="22" style="v" sid="JHN 17:22"/>ዎታ ዋልቃ ዎ ማቻንግንዳ ከተረ ዋልቃ ከት ማተርንግንዳ እካንታ የስ እምሳን ቦንቸን ከትካንታ እምትቴ። <verse eid="JHN 17:22"/><verse number="23" style="v" sid="JHN 17:23"/>እ ምግዝድንዳ እታ ከትካ የነረ እንካ የስ ማቻንግንዳ ከተረ ቦድመካ ዋልቃ ከት ማድንግንዴ፥ ኮትኮግንደረ እም የስ ኦይቻንግንደከ እም የስ ሶልምሳን ከካ ከትመረ የስ ሶልምሳንግንዳ ፍጫ ሙደና ኤዝድንግንዴ።<verse eid="JHN 17:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24"/>“እባቦ! ፍጫ ሙደና ፍዝማክናና የስ እም ሶልምሳንጎካ የስ እካንታ እምሳን እስታ ቦንቸን ከት ሰድንግንዳ ከታኬና የስ እካንታ እምስባከሰረ እ ዶቅድን ካርዘን እንካ ክክን ከትዶቅድንግንዳ እታ ሶልምድቴ። <verse eid="JHN 17:24"/><verse number="25" style="v" sid="JHN 17:25"/>ጭል እባቦ! ፍጫ ሙደና የስም ኤሳክዬ፥ እታ ማቸ የስም ኤዝድቴ፥ ከታከነረ የስ እም ኦይቻንደትም ኤስተኬ። <verse eid="JHN 17:25"/><verse number="26" style="v" sid="JHN 17:26"/>የና እም የስ ሶልምሳን ሶልመና ከታዘን ማድንግንደከ እተረ ከትካ እ ማተርንግንዳ ከተረ የስም ከት ኤስተርንግንዳ ይትቴ፥ ጉጅሰረ ከት ኤዝድንግንዳ ከትም ማስትቴ።”<verse eid="JHN 17:26"/></para>
  <chapter eid="JHN 17"/>
  <chapter number="18" style="c" sid="JHN 18"/>
  <para style="s1">የሱሰታ የድርና</para>
  <para style="r">(<ref loc="MAT 26:47-56">ማቶ. 26፡47-56</ref>፤ <ref loc="MRK 14:43-50">ማር. 14፡43-50</ref>፤ <ref loc="LUK 22:47-53">ሉቃ. 22፡47-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1"/>የሱስ ኮም ምክስን ይ በይሳንደታ ቡር ይንታ ካርንካ ጎርስምድባብከስካ ክክን ኦስ ቀድሮን ቦደንታ ፋማ አይሴ፥ ኦ ዋረረ ዶቅድንደት ኮረርሳን ኮረናር ይንታ ካርንካ ጎርስምድባብከስካ ክክን አርደዴ። <verse eid="JHN 18:1"/><verse number="2" style="v" sid="JHN 18:2"/>የሱሰኬ ክታ ካርንካ ጎርስምድባብከስ ካርንኮታር ሙዳᎺይካ ሳንምደኮ Ꮊቃንጎካ ስክስትዮ ክትም እምስባብ ይሁዳ ካርን ኮትም ኤዝዳ Ꮊቄ። <verse eid="JHN 18:2"/><verse number="3" style="v" sid="JHN 18:3"/>ኮካንታ ይሁዳ ዋልቃ ዙግር ዳምንባብከስም፥ ኮትኮግንደረ ቀሰንከስም ገችንባብከስኬ ፈረሳዊያንንከዘንካ ኦይትምስባብከስ ካርስንባብከስም ክድባብከስም ጎርስሶ ካርንኮታር Ꮊዴ፥ ከተረ ኩራዝካ ሳግዝድንደትምኬ ዞንበካ ኖሀ ዞጵስሶ፥ ዳምይ ካችመረ የተክ Ꮊቀኬ። <verse eid="JHN 18:3"/><verse number="4" style="v" sid="JHN 18:4"/>የሱሰረ ይም የልድንደትም ሙደንም ኤስሶ ኦስ ከደር ዉትሶ “የታ Ꮊይመንት ዝግዳ?” ከትም ጋይሴ። <verse eid="JHN 18:4"/><verse number="5" style="v" sid="JHN 18:5"/>ከተረ “ናዝረትንክንባብ የሱሰም ዝግዶቴ” ክደር ጋይሰኬ። ኖየረ “እትቴ!” ከደር ጋይሴ። ስክስት እምድባብ ይሁደረ ከትከረ ክክን ዎእሶ Ꮊቄ። <verse eid="JHN 18:5"/><verse number="6" style="v" sid="JHN 18:6"/>የሱሰረ “እትቴ” ከደር ጋይሳንደትካ ቡደካ አይሰኮ ፍጨዘን ዋቸኬ። <verse eid="JHN 18:6"/><verse number="7" style="v" sid="JHN 18:7"/>የሱሰረ “Ꮊይመንት ዝግዳ?” ጋየሮ አነታ ከትም ኦይሴ። ከተረ “ናዝረትንክንባብ የሱሰም ዝግዶቴ” ጋይሰኬ። <verse eid="JHN 18:7"/><verse number="8" style="v" sid="JHN 18:8"/>የሱሰረ “እትቴ የንደር ጋይትቴ፥ ይና የ ዝግድንዳ እም ማቼ ከትከነም ዛእከቴ፥ ከት አያ” ኖ ጋይሴ። <verse eid="JHN 18:8"/><verse number="9" style="v" sid="JHN 18:9"/>ኮነረ ማቻንዳ፥ (እባቦ፥ የስ እካንታ እምሳን ኤድንከሳርንካ ዋልቀንም ዎራ እታ ካይሳክቴ) ጋይሳን ቃለና ቦድምድን ግንዴ።<verse eid="JHN 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10"/>ስምኦን ጴጥሮስ ዳም ማሰን የድሶ Ꮊቃንጎካ ጎችትዮ ቀሰንከስም ገችዝድባብታ ፍክስንባብም ፋክሶ ክታ ምዝ ቃምን ተቼ፥ ክትኮ ፍክስንባብተረ ላምና “ማልኮስ” ጋይምዴ። <verse eid="JHN 18:10"/><verse number="11" style="v" sid="JHN 18:11"/>የሱስ ማቼ ጴጥሮስም፥ “የስታ ዳምይ ማሰንም ሶግናር አርችካ፥ እባብ እካንታ እምሳንደትም ማጠንታ ኡፍተናር ዎጭምን እ ዎጭዳክን የስም ካምዶ?” ክትም ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">18፡11 </char><char style="xt" closed="false"><ref loc="MAT 26:39">ማቶ. 26፡39</ref>፤ <ref loc="MRK 14:36">ማር. 14፡36</ref>፤ <ref loc="LUK 22:42">ሉቃ. 22፡42</ref>። </char></note><verse eid="JHN 18:11"/></para>
  <para style="s1">የሱስ ቀሰንከስም ገችዝድባብደር የድምሶ አይና</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12"/>ኮታ ቡር ዳምንባከስኬ ከትም ክድባብ፥ አይሁድንከስታ ካርስንባብከስም ክድባብከሰረ የሱሰም የድሰኮ ዞክሰኬ። <verse eid="JHN 18:12"/><verse number="13" style="v" sid="JHN 18:13"/>እርምሶ ኦስ ሀነደር ክትም ተይ አይሰኬ፥ ሀነረ ኮት ስለናር ቄሰንከስታ ገችንባብ ቀያፈታ በይስስ Ꮊቄ። <verse eid="JHN 18:13"/><verse number="14" style="v" sid="JHN 18:14"/>ቀያፋ “ዋልቃ ኤድ ዎርሰንካንታ ደእሰስናና ኡርዴ” ጋይንተካ አይሁድንታ ገችታ ኤረንባብከስም ዞርስባቤ።<note caller="-" style="x"><char style="xo" closed="false">18፡14 </char><char style="xt" closed="false"><ref loc="JHN 11:49-50">ዮሀ. 11፡49-50</ref>። </char></note><verse eid="JHN 18:14"/></para>
  <para style="s1">ጴጥሮስ የሱሰም ካድና</para>
  <para style="r">(<ref loc="MAT 26:69-70">ማቶ. 26፡69-70</ref>፤ <ref loc="MRK 14:66-68">ማር. 14፡66-68</ref>፤ <ref loc="LUK 22:55-57">ሉቃ. 22፡55-57</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15"/>ስምኦን ጴጥሮስከ አብ ክታ ካርንካ ጎርስምድባብ የሱሰም ጎርስምሰኬ፥ ኖኮና አብ ክታ ካርንካ ጎርስምድባብ ቀሰንከስም ገችዝድባብደር ኤስምስባቤ፥ ኮካንታ የሱሰካ ክክን ቄሰንከስም ገችዝድባብታ ጋስናር አርደዴ፥ <verse eid="JHN 18:15"/><verse number="16" style="v" sid="JHN 18:16"/>ጴጥሮስ ማቼ አርድን ፍልተንታ ማልጎካ ዎእሶ Ꮊቄ፥ ቄሰንከስታ ገችንባብደር ኤስምስባብ የሱሰታ ካርንካ ጎርስምድባብ Ꮊድሶ ፍልተንዘን ዶቅድን ማና ይንቸንካንታ ኬዝሶ ጴጥሮሰም ጋስናር አርችሴ፥ <verse eid="JHN 18:16"/><verse number="17" style="v" sid="JHN 18:17"/>ፍልተንዘንደረ ይንቸና ጴጥሮስም “የነረ ኮ ኤችንታ ካርንካ ጎርስምድባባርንካ ዋልቀና ካዮ?” ክትም ና ጋይሴ።</para>
  <para style="p" vid="JHN 18:17">ኖ ማቼ “እታ ካይቴ” ጋይሴ።<verse eid="JHN 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18"/>ሰጨና ቃዝ ቃዝድንኦል ፍክስንባብከስኬ ካርስንባብከስም ክድባብከስ ኖሀ የችሰኮ ኦይጥረሮ Ꮊቀኬ፥ ጴጥሮሰረ ከትካ ክክን ዎእሶ ኖሄን ኦይጠርድ Ꮊቄ።<verse eid="JHN 18:18"/></para>
  <para style="s1">ቄሰንከስም ገችስንባብደርካ የሱስካንታ Ꮊዳን ኦይስ</para>
  <para style="r">(<ref loc="MAT 26:59-66">ማቶ. 26፡59-66</ref>፤ <ref loc="MRK 14:55-64">ማር. 14፡55-64</ref>፤ <ref loc="LUK 22:66-71">ሉቃ. 22፡66-71</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19"/>ኮትᎺይካ ቄሰንከስም ገችዝድባብ የሱሰም ክታ ካርንካ ጎርስምድባብከስጎኬ ክታ ኤስስንታ ክትም ኦይሴ። <verse eid="JHN 18:19"/><verse number="20" style="v" sid="JHN 18:20"/>የሱሰረ፥ “እታ ኤድ ሙደንካንታ መየካ ከዛቴ፥ አይሁድንከስ ሙዳ ከት ሳንምድን ከታ ምክስ ኤሄናርንከ ሳብታ ጭል ኤሄናር፥ ሙዳᎺይካ ኤስስቴ፥ አቸካ እከዛንዳ Ꮊረርየረ ካዬ፥ <verse eid="JHN 18:20"/><verse number="21" style="v" sid="JHN 18:21"/>ይና፥ Ꮊረተስ እም የና ኦይዝዳ? እ ከትካንታ ኬዝድንካ እዝደር ኤሰርስባብከስም ኦይስካ፥ እ ኬዛንደትም ከታ ኤዝደኬ” ኩንጋየሮ ማስሴ።<verse eid="JHN 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22"/>የሱስ ኮም ክት ኬዛንደትካ ካርን ኮታር ዎእሶ Ꮊቅባከሳርንካ ካርስንባብከስም ክድባባርንካ ዋልቀና፥ “ቀሰንከስም ገችዝድባብደር የስ ክትም ማዝድንዳ ኮግንደኮ?” ጋይሶ የሱሰም ጫቅሴ።<verse eid="JHN 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23"/>የሱሰረ “ዳቅል ኬዘም እ ከስታ ማቼረ ዳቅል እስታ ኬዘንም ማርከርካ፥ እከዛንዳ ገታ ኮት ማቼ Ꮊረተስ እም ጉጵዳ?” ክትም ጋይሴ።<verse eid="JHN 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 18:24"/>ኮታ ቡር ሀና፥ የሱሰም ክት ዞከርሳን ግንዳ ቄሰንከስም ገችዝድባብ ቃያፈደር ማስትዮ ኦይቼ።<verse eid="JHN 18:24"/></para>
  <para style="s1">ጴጥሮስ አነታ የሱሰም ክታ ካድና</para>
  <para style="r">(<ref loc="MAT 26:71-75">ማቶ. 26፡71-75</ref>፤ <ref loc="MRK 14:69-72">ማር. 14፡69-72</ref>፤ <ref loc="LUK 22:58-62">ሉቃ. 22፡58-62</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25"/>ኮታይከረ ስምኦን ጴጥሮስ ዎእሶ ኖሀ ኦይጠርድ Ꮊቄ፥ አብ ኤድንከሰረ “የና የሱሰታ ካርንካ ጎርስምድባብከሳርንካ ዋልቀነይ ካዮ?” ክትም ጋይሰኬ። ኖየረ “እታ ካይቴ” ጋይሶ ካጄ።<verse eid="JHN 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26"/>ጴጥሮስ ቃምን ክታ ተችባብ ኤችንታ ሱሳ ማችባብ ቀሰንከስታ ገችንባብታ ፍክስንባባርንካ ዋልቀና ኮረንከስም ኮረርሳን ካርናር ክትካ ክክን የስም ሰዳክቶ? ክትም ጋይሴ።<verse eid="JHN 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 18:27"/>ጴጥሮሰረ አነታ ካጄ፥ ሳነካ ባቸና ቅቅሴ።<verse eid="JHN 18:27"/></para>
  <para style="s1">የሱሰታ ኦስ ጵላጦሰደር ተይ አይምና</para>
  <para style="r">(<ref loc="MAT 27:1-2">ማቶ. 27፡1-2</ref>፥<ref loc="MAT 27:11-14">11-14</ref>፤ <ref loc="MRK 15:1-5">ማር. 15፡1-5</ref>፤ <ref loc="LUK 23:1-5">ሉቃ. 23፡1-5</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28"/>ኮታ ቡር የሱሰም ቀያፈታ ኤር ፍጨንም ቆልስባብ ጵላጦሰታ ጋስናር ተይ አይሰኬ፥ ሰጨነረ ዛማ ሰጭማ Ꮊቄ፥ አይሁድና ፋስጋ ባአልንታ ማችምድን ቆለን እች ከትም ዝግዝድን ኦል ከት ቱና ማዳክንግንዳ ጋይንተካ ፍጨን ቆልድባብታ ጋስናር አርዳከኬ። <verse eid="JHN 18:28"/><verse number="29" style="v" sid="JHN 18:29"/>ኮካንታ ጵላጦስ ከደር ዉትሶ “ኮ ኤችንታ ዘን የንታ ክስና Ꮊራ?” ጋየሮ ከትም ኦይሴ።<verse eid="JHN 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30"/>ከተረ “ኮና ኤችና ዳቅል ፍግዝድባብ ማታከስ ናና የስካንታ ስክስት እምተራኮትዶቆ” ጋየረኮ ክትካንታ ማስሰኬ።<verse eid="JHN 18:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31"/>ጵላጦሰረ “የታ የንታ ማታርንካ ተይ አይሰቶ የንታ ህግንግንዳ ክታዘን ፋረድከቴ” ከትም ጋይሴ።</para>
  <para style="p" vid="JHN 18:31">አይሁድነረ “ዎ ኤድም ደይዝድንግንዳ ዎካንታ ጋይማክዬ” ጋይሰኬ። <verse eid="JHN 18:31"/><verse number="32" style="v" sid="JHN 18:32"/>ኮነረ ማቻንዳ የሱስ Ꮊስግንዳ ደእካ ደእዳ ናንከረ ክት ኬዛን ቃለና ቦድምድንግንዴ።<note caller="-" style="x"><char style="xo" closed="false">18፡32 </char><char style="xt" closed="false"><ref loc="JHN 3:14">ዮሀ. 3፡14</ref>፤ <ref loc="JHN 12:32">12፡32</ref>። </char></note><verse eid="JHN 18:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33"/>ጵላጦሰረ አነታ ይንታ ጋስናር ማትዮ አርደዴ፥ የሱሰመረ ኤልሶ “የና አይሁድንታ ባንቾ?” ጋየሮ ክትም ኦይሴ።<verse eid="JHN 18:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34"/>የሱሰረ “የስ ኮም ጋይድንዳ የዘንኮ? አነረ አብንከስ ኮም እጎካ የስም ከዘኮ?” ክትም ጋይሴ። <verse eid="JHN 18:34"/><verse number="35" style="v" sid="JHN 18:35"/>ጵላጦሰረ “እታ አይሁድቶ? የስም እካንታ ስክስት ከት እምሳንዳ የስታ ኮችንከስከ ቀሰንከስም ገችዘድባብከስኬ፥ Ꮊራ ሪየረ የስ ይሳንዳ?” ክትም ጋይሴ።<verse eid="JHN 18:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36"/>የሱስ “እስታ ባንችምና ኮ ፍጫሙደንዘንካ ካዬ፥ እስታ ባንችምና ኮ ፍጫሙደንዘንካ ማቸስናና አይሁድንታ ገችታ ኤረንባብከስታ አንናር እ ዋችተራክን ግንዳ እስታ ፍክስንባብከስ እካንታ ዳምተረክዶቆ፥ እስታ ባንችምና ኮ ፍጫሙደንዘንካ ካዬ” ጋየሮ ማስሴ። <verse eid="JHN 18:36"/><verse number="37" style="v" sid="JHN 18:37"/>ጵላጦሰረ ይና፥ የና ይንትም ባንቸዬ ክትም ጋይሴ። የሱሰረ “እ ባንችን ማቻንደትም የና ጋይሳዬ፥ እ አጥምሳንደትኬ ኮ ፍጫሙደንዘን እ Ꮊዳንዳ ዶፈንንጎካ ማርከርካንቴ፥ ዶፈንንዘንካ ማቻንዳ ሙደና እስታ ቃለንም ኤሰርደኬ” ጋየሮ ማስሴ።<verse eid="JHN 18:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38"/>ጵላጦሰረ “ዶፈንና Ꮊራ?” ጋይሶ ኦይሴ። ኮታ ቡር ጵላጦስ አነታ አይሁድንከዝደር ዉትሶ ኩን ከደር ጋይሴ፥ “እታ Ꮊረነረ ባች ክታዘንካ Ꮊፋክቴ፥ <verse eid="JHN 18:38"/><verse number="39" style="v" sid="JHN 18:39"/>ኬዛርካ ማቼ የንታ መጠንግንዳ ፋስጋ ባአልንካ ሙዳᎺይካ ዋልቃ ዞከርስባብም ብልድቴ፥ ኮካንታ አይሁድንታ ባንችንም የካንታ ብልድንግንዳ የታ ዝግደቴ?”<verse eid="JHN 18:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40"/>ከታ ማቼ “ባርባንም ዎካንታ ብልካ ዳት ክትኮም ካዬ!” ጋየረኮ ፍፍሰኬ። ባርባን ማቼ ፋንጋ Ꮊቄ።<verse eid="JHN 18:40"/></para>
  <chapter eid="JHN 18"/>
  <chapter number="19" style="c" sid="JHN 19"/>
  <para style="s1">ዳምንባብከስ የሱሰዘን Ꮊልተርና</para>
  <para style="r">(<ref loc="MAT 27:27-32">ማቶ. 27፡27-32</ref>፤ <ref loc="MRK 15:15-21">ማር. 15፡15-21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1"/>ኮታ ቡር ጵላጦስ የሱሰም ተይ አይሶ Ꮊርችሴ። <verse eid="JHN 19:1"/><verse number="2" style="v" sid="JHN 19:2"/>ዳምንባብከሰረ ጋልም ቆጵ ኡርስተኮ የሱሰታ ማተንዘን ዎጀኬ፥ ዘይም አፍለመረ ክትም ቆፍሰኬ። <verse eid="JHN 19:2"/><verse number="3" style="v" sid="JHN 19:3"/>ክደረረ Ꮊደረኮ Ꮊልተርካ “አይሁድንከስታ ባንችኖ! ሳራትቸና የስካንታ ማታ!” ክትም ጋየሮ አነረ፥ ክትም ጫቀረኮ Ꮊቀኬ።<verse eid="JHN 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4"/>ጵላጦሰረ አነታ ማል ዉትሶ “እታ ክታዘን Ꮊረነረ ዳቀልስ እ Ꮊፋክንደትም የ ኤስተርንግንዳ ክትም የካንታ ማል ዉጅድቴ” ከደር ጋይሴ፥ <verse eid="JHN 19:4"/><verse number="5" style="v" sid="JHN 19:5"/>ኮካንታ የሱስ ጋልንታ ቆጵን ዎድንደትከ ዘይም አፍለን ቆበርሶ ማል ዉተዴ፥ ጵላጦሰረ “ይና ኤችና የንታ ኮኔ!” ከደር ጋይሴ።<verse eid="JHN 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6"/>ቄሰንከስታ ገችንባብከስከ ካርስንባብከስም ክድባብከስካ የሱሰም ሰድሰኮ “ሮካ! ሮካ!” ጋየረኮ ፍፍሰኬ። ጵላጦስ ማቼ “እጎካ ማቸ Ꮊረነረ ዳቀልስ ክታዘን Ꮊፋክቴ፥ የ ክትም ዝግዜ የታ ተይ አይሰቶ ክትም ሮከቴ” ከትም ጋይሴ።<verse eid="JHN 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7"/>አይሁድንከሰረ “ዎንታ ህግ ዶቅዴ፥ ኮና ኤችና ይንታ ማቴን ሳብታ ይንች ክት ማስሳንጎካ ዎንታ ህግንግንዳ ክትም ደእ ዝግዝዴ” ጋይሰኬ። <verse eid="JHN 19:7"/><verse number="8" style="v" sid="JHN 19:8"/>ኮም ሙዳ ርም ይ ኤሰርሳንደትካ ጵላጦስ ስግ ጳሴ፥ <verse eid="JHN 19:8"/><verse number="9" style="v" sid="JHN 19:9"/>ይንታ ጋስናረረ አርድሶ የሱሰም “የና Ꮊምንከረ?” ጋይንተካ ኦይሴ። የሱስ ማቼ Ꮊረነረ ክትካንታ ማሳክዬ። <verse eid="JHN 19:9"/><verse number="10" style="v" sid="JHN 19:10"/>ኮካንታ ጵላጦስ “የና እካንታ ከዛያ? እታ የስም ቡልካንታ አነረ የስም ሮክካንታ ገችታ ኤራ እስታ ዶቅድንደትም የና ኤሳያ?” ክትም ጋይሴ፥<verse eid="JHN 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11"/>የሱሰረ “ሳብዘንካ ገችታ ኤራ የስካንታ እምማከስናና እዘን Ꮊረነረ ገችታ ኤራ የዘን ዶቅተራክ ዶቆ፥ ማችንከረ የስካንታ ስክስት እም እምስባብ ስግ ጎማ ክታዘን ዶቅዴ” ክደር ጋይሴ።<verse eid="JHN 19:11"/></para>
  <para style="s1">የሱሰዘን ደእታ ፍርደን ፋረድና</para>
  <para style="r">(<ref loc="MAT 27:15-31">ማቶ. 27፡15-31</ref>፤ <ref loc="MRK 15:6-20">ማር. 15፡6-20</ref>፤ <ref loc="LUK 23:13-25">ሉቃ. 23፡13-25</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12"/>ጵላጦስ ኮም የሱሰታ ኬዘን ኤሰርሳንደትካ ብልት ኦይትካንታ ዝግዜ፥ አይሁድንከስ ማቼ “ኮ ኤችንም የስ ብልሴ የና ሮማ ባንችንታ ገርና ካየዬ፥ ይንታ ማተን ባንችን ማዝድባብ ሙደና ባንችንታ ይምኤንባቤ!” ጋየረኮ ፍፍሰኬ።<verse eid="JHN 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13"/>ጵላጦስ ኮም ይ ኤሰርሳንደትካ የሱሰም ማል ዉችሶ “ላጳ ላጵይ ሰይን” ጋይምሳን ካርዘን ፍርደን እመርድን ጎንገንዘን ዶቅሴ፥ ኮና ካርና እብራይስጥ አፈካ “ገበታ” ጋይምዴ። <verse eid="JHN 19:13"/><verse number="14" style="v" sid="JHN 19:14"/>ሰጨነረ ፋስጋ ባአልንታ ግክስ ሰጭ Ꮊቄ፥ ኮትካ ላ ሳዓት ማታባብ Ꮊቄ፥ ኮትᎺይካ ጵላጦስ አይሁድንከስም “የንታ ባንችና!” ከደር ጋይሴ <verse eid="JHN 19:14"/><verse number="15" style="v" sid="JHN 19:15"/>ከታ ማቼ “ክትም Ꮊልእስካ! ክትም Ꮊልእስካ! ክትም ሮካ!” ጋየረኮ ፍፍሰኬ። ጵላጦሰረ “የንታ ባንችን ሮክትቶ?” ከደር ጋይሴ። ቀሰንከስም ገችዝድባብከሰሬ “ሮማ ባንችንዘንካ አብ ባንች ዎንታ ካዬ!” ጋየረኮ ክትካንታ ማስሰኬ።<verse eid="JHN 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16"/>ኮትᎺይካ የሱስ ሮከርድን ግንዳ ጵላጦስ ስክስትዮ ክትም ከትካንታ እምሴ፥ ከተረ የሱሰም የድሰኮ ተይ አይሰኬ።<verse eid="JHN 19:16"/></para>
  <para style="s1">የሱስታ ሮክርና</para>
  <para style="r">(<ref loc="MAT 27:32-44">ማቶ. 27፡32-44</ref>፤ <ref loc="MRK 15:21-32">ማር. 15፡21-32</ref>፤ <ref loc="LUK 23:26-43">ሉቃ. 23፡26-43</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17"/>ኮታ ቡር የሱስ ማዝቀልን ባልሶ “ራስቅል” ጋይምድን ካርዘን ዉተዴ፥ ኮና ካርና ዕብራይስጥ አፈካ “ጎልጎታ” ጋይምዴ፥ <verse eid="JHN 19:17"/><verse number="18" style="v" sid="JHN 19:18"/>ኮታረረ ክትም ሮክሰኬ፥ የሱሰም ዎክያር ማስሰኮ፥ ክትካ ክክን አብንከስመረ ቃስተን ኤድም ክታ ብተዘንጎኬ ምዝዘንጎካ ሮክሰኬ። <verse eid="JHN 19:18"/><verse number="19" style="v" sid="JHN 19:19"/>ጵላጦስ “ናዝረት የሱስ፥ አይሁድንከስታ ባንቼ” ጋይድንደትም ጻፍትዮ ማዝቀልንዘን የሱሰታ ቃደንታ ዘርመዘን ቶሴ። <verse eid="JHN 19:19"/><verse number="20" style="v" sid="JHN 19:20"/>የሱስ ሮከርሳን ካርና ካተመን ካንታ ቅንች Ꮊቃንጎካ፥ አይሁድናርንካ በድንከስ ጻፈርሳንደትም ናበብዘኬ፥ ጻፍምሳንደረ እብራይስጥካ፥ ላትንከ፥ ግርክ አፈካ Ꮊቄ። <verse eid="JHN 19:20"/><verse number="21" style="v" sid="JHN 19:21"/>አይሁድ ቀሰንከስታ ገችንባብከስ ጵላጦሰም፥ “የና ‘አይሁታ ባንችን’ ጋይሰዮ Ꮊይጻፌ፥ ኬዛር ማቸ ‘ኮና ኤችና እታ አይሁድንታ ባንችቴ’ ጋይቴ ጋይሶ ጻፍካ” ክትም ጋይሰኬ።<verse eid="JHN 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22"/>ጵላጦስ ማቼ “እ ጻፍሳንደትም ጻፍትቴ” ጋይሶ ማስሴ።<verse eid="JHN 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23"/>ዳምንባብከስ የሱሰም ከታ ይ ሮክሳን ቡር፥ ክታ አፍለንከስም ተየኮ ዋልቃ ዋልቃ ዳምንባብም ዋልቃ ካስ የልድን ግንዳ ኦይድ ካርዘን ካሰኬ፥ ሳምዝንመረ ኮትኮግንዳ ይሰኬ፥ ኬዛር ማቼ ሳምዝና ዛግማክዶቆ፥ ፈይንካ ሶ የለልታ ዉች ፍክስምሳንዴ፥ <verse eid="JHN 19:23"/><verse number="24" style="v" sid="JHN 19:24"/>ኮካንታ ዳምንባብከስ “Ꮊይካንታ የልዳ ናንከረ ኤስካንታ እጫ ዎታ ዛቅቶሮት ዳት፥ Ꮊእሰርዳክዬ” ጋይሰኬ። ኮነረ ማቻንዳ፥</para>
  <para style="q1" vid="JHN 19:24">“እስታ አፍለንም ካስምሰኬ፥</para>
  <para style="q1" vid="JHN 19:24">እስታ ሳምዝንተረ እጫ ዛቅሰኬ”</para>
  <para style="m" vid="JHN 19:24">ጋይድንዳ ጭል ማጻፍንታ ቃለና ቦድምድንግንዴ፥ ዳምንባብከሰረ ኮትኮግንዳ ይሰኬ።<note caller="-" style="x"><char style="xo" closed="false">19፡24 </char><char style="xt" closed="false"><ref loc="PSA 22:18">የቺ 22፡18</ref>። </char></note><verse eid="JHN 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25"/>የሱሰታ ማዝቀልንታ ላማር እንደንኬ እንደንታ ምችነንካ፥ ቃሎጴታ ኬነን ማራመትኬ ማግደላ ፍጨንካ Ꮊዳን ማራመትካ ዎእሶ Ꮊቀኬ፥ <verse eid="JHN 19:25"/><verse number="26" style="v" sid="JHN 19:26"/>የሱስ ይንታ እንደንምኬ ይ ሶልምድባብም ይንታ ካርንካ ጎርስምድባብ ክታ ላመር ዎእሳንደትም ሰዳንደትካ፥ ይንታ እንደንም “እስታ እንደኖ! ይና፥ የስታ ይንችና!” ኮትም ጋይሴ።<verse eid="JHN 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 19:27"/>ኮታ ቡር ይንታ ካርንካ ጎርስምድባብም “ይና ኮሰቼ የስታ እንደና!” ክትም ጋይሴ፥ ኮት ሳዓትንዘንካ የድሶ ክታ ካርንካ ጎርስምድባብ ይንታ ኤር ኮትም ተይ አይሴ።<verse eid="JHN 19:27"/></para>
  <para style="s1">የሱሰታ ደእና</para>
  <para style="r">(<ref loc="MAT 27:45-56">ማቶ. 27፡45-56</ref>፤ <ref loc="MRK 15:33-41">ማር. 15፡33-41</ref>፤ <ref loc="LUK 23:44-49">ሉቃ. 23፡44-49</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28"/>ኮታ ቡር የሱስ ታ ሙዳ ሪነረ ቦድምሳንደትም ኤስሶ ጭል ማጻፍናር ጻፍምሳንዳ ቃለና ቦድምድን ግንዳ “ቡዳ እስታ ዎቼ!” ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">19፡28 </char><char style="xt" closed="false"><ref loc="PSA 69:21">የቺ 69፡21</ref>፤ <ref loc="PSA 22:15">22፡15</ref>። </char></note><verse eid="JHN 19:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 19:29"/>ኮታር ጫቅምድንደትም ጮቸርሳንዳ ዋልቃ ርይካ ዎጅንካ Ꮊቄ፥ ኮካንታ ኮታር Ꮊቅባብ ኤድንከስ፥ ጫቅምድንደትም ስፎንግ ጋየርድንዳ ጩንጭት የድ ር ዳልች ግንደንካ ጮችሰኮ ህሶጵ Ꮊቀካ የተኮ ክታ አፈንዘን የልስሰኬ፥<note caller="+" style="f"><char style="fr" closed="false">19፡29 </char><char style="ft" closed="false">ስፎንግ ጋየርድንዳ ኮስ ግንዳ ር ሎቀታ ዋር ባቀልድር፥ ዘነና ኮታ አፍ ግንዳ፥ ሎቃ ጩንጭት የድንዳ ባሃራር ማአ፥ አፍካንታ ኡርድንዴ። ህሶጵ ጋይምድን ኮርተን ግንዴ </char></note> <verse eid="JHN 19:29"/><verse number="30" style="v" sid="JHN 19:30"/>የሱሰረ ጫቅምድንደትም ይ ዎጫንደታ ቡር “ቦድምሴ!” ጋይሴ።</para>
  <para style="p" vid="JHN 19:30">ይንታ ማተን ከለዘን ማስሶ ሰንፔን ይንታ ስክስት እምሴ።<verse eid="JHN 19:30"/></para>
  <para style="s1">የሱሰታ ከለን ካችምካ እክና</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31"/>ኮታ ቡር አይሁድንታ ገችታ ኤረንባብከስ፥ ሮከርስን ኤድንከስታ ገስን ቁንጭሰኮ፥ ከታ ለይስን ማዝቀልንዘንካ ከት Ꮊንችድን ግንዳ ጵላጦሰም ምክሰኬ፥ ኮመረ ከት ይሳንዳ አይሁድንታ Ꮊዉስ ሰጨንታ ግክሰርድን ሰጫ ማቻንካንተከ ናኮና አይሁድንታ Ꮊዉስ ሰጨነረ አንድር ባአል ማቻን ካንታ፥ ኮትኮ Ꮊዉስ ሰጨንካ ከታ ለይስና ማዝቀልዘን ማዳክንግንዴ። <verse eid="JHN 19:31"/><verse number="32" style="v" sid="JHN 19:32"/>ኮካንታ ዳምንባብከስ አይሰኮ፥ የሱሰካ ክክን ሮከርስባብ ኤድንከስታ ገስን ቁንጨኬ፥ <verse eid="JHN 19:32"/><verse number="33" style="v" sid="JHN 19:33"/>የሱሰደር ከት የልድንካ ማቼ፥ ኖ እርምሶ ክት ደእሳንደትም ሰድሰኮ፥ ክታ ገስን ቁንጫከኬ። <verse eid="JHN 19:33"/><verse number="34" style="v" sid="JHN 19:34"/>ኬዛር ማቼ ዳምንባከሳርንካ ዋልቀና፥ ከለን ክታ ካችምካ እክሴ፥ ሳነካ ክታ ከለናርንካ ማቀስከ ሎቀካ ዉልእምሴ። <verse eid="JHN 19:34"/><verse number="35" style="v" sid="JHN 19:35"/>ኮም ሰድባብከስ፥ የ አመንምተርን ግንዳ ማርከርሴ፥ ክታ ማርካትችነረ ዶፈኔ፥ ክት ኬዝድንደረ ዶፈን ማቻንደትም ኖ ኤዝዴ። <verse eid="JHN 19:35"/><verse number="36" style="v" sid="JHN 19:36"/>ኮነረ ማቻንዳ “ክታርንካ ዋልቃ ለፍ ዎራ ቁንጭምዳክዬ” ጋይድንዳ ጭል ማጻፍንታ ቃለና ቦድምድን ግንዴ።<note caller="-" style="x"><char style="xo" closed="false">19፡36 </char><char style="xt" closed="false"><ref loc="NUM 9:12">ፋይ. 9፡12</ref>፤ <ref loc="PSA 34:20">የቺ 34፡20</ref>። </char></note> <verse eid="JHN 19:36"/><verse number="37" style="v" sid="JHN 19:37"/>ጉጅሰረ አብ ጭል ማጻፍናር ከታ “ይ እክስባብም ሰተረኬ” ጋይዴ።<verse eid="JHN 19:37"/></para>
  <para style="s1">የሱሰታ ዱክርና</para>
  <para style="r">(<ref loc="MAT 27:57-61">ማቶ. 27፡57-61</ref>፤ <ref loc="MRK 15:42-47">ማር. 15፡42-47</ref>፤ <ref loc="LUK 23:50-56">ሉቃ. 23፡50-56</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38"/>አይሁድንታ ገችታ ኤረንባብከስም ጳስካ የሱሰታ ካርንካ ጎርስማᎺቅባብ አርማትያስ ዮሴፍ አቸካ የሱሰታ ለይስን ተይ አይካንታ ጵላጦሰም ምክሴ። ጵላጦሰረ ዱካ ክትም ጋይሴ። ኮካንታ ዮሴፍ አይሶ ለይስንም Ꮊንችሶ ተይ አይሴ። <verse eid="JHN 19:38"/><verse number="39" style="v" sid="JHN 19:39"/>ኮታ እሪ ገልትገር የሱሰደር አይስባብ ንቆድሞሰረ በድ ስንጋ ማቻንደትም ከርበኬ ጫቅምድንደትካ ኖሀ ኤልካ ቡቅምሳንደትም የድሶ Ꮊዴ።<note caller="+" style="f"><char style="fr" closed="false">19፡39 </char><char style="ft" closed="false">አክሰርድንደናማዘነርድንካ ኦይድ ጸተከ ቃስተን ቦንደከ ታማ ማድን ደጭምዬ። </char></note><note caller="-" style="x"><char style="xo" closed="false">19፡39 </char><char style="xt" closed="false"><ref loc="JHN 3:1-2">ዮሀ. 3፡1-2</ref>። </char></note> <verse eid="JHN 19:39"/><verse number="40" style="v" sid="JHN 19:40"/>ቃስተን ኤድንከስ የሱሰታ ለይስን ተይሰኮ አይሁድንከስታ አክስንግንዳ ዎዝድንደትካ ክክን ሳዝ አፍለካ አክሰኬ። <verse eid="JHN 19:40"/><verse number="41" style="v" sid="JHN 19:41"/>የሱስ ሮከርሶ Ꮊቃን ካርና ኮረንከስም ኮረርሳን ካሪ Ꮊቄ፥ ኮትኮ ኮረን ኮረርሳን ካርናር Ꮊየነረ ዱከራክንዳ ክላ ዱክ Ꮊቄ። <verse eid="JHN 19:41"/><verse number="42" style="v" sid="JHN 19:42"/>አይሁድንታ Ꮊዉስንታ ግክስ ሰጭ Ꮊቃንጎከ ዱክ ካርነረ ቅንች ማቻንጎካ የሱሰታ ለይስንም ኮታር ዱክሰኬ።<verse eid="JHN 19:42"/></para>
  <chapter eid="JHN 19"/>
  <chapter number="20" style="c" sid="JHN 20"/>
  <para style="s1">የሱሰታ ደእያርንካ አምንታ</para>
  <para style="r">(<ref loc="MAT 28:1-8">ማቶ. 28፡1-8</ref>፤ <ref loc="MRK 16:1-8">ማር. 16፡1-8</ref>፤ <ref loc="LUK 24:1-12">ሉቃ. 24፡1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1"/>ዎጋᎺይካ ዛማ ሰጭማ፥ አክ ማላ ዘያክናና፥ ማግደላ ፍጨናርንዳ ማራማ የሱሰታ ዱክንደር አይሴ፥ ኦኮታረረ ይ የልሳንግንዳ ዱክንም ዝጭሶ Ꮊቃን ሰይንና ዱክንታ ፍልተንዘንካ ቡከልስንካ ና ሰዴ። <verse eid="JHN 20:1"/><verse number="2" style="v" sid="JHN 20:2"/>ኮካንታ ና ስምኦን ጴጥሮስደርኬ የሱስ ሶልምድን አብ ክታ ካርንካ ጎርስምድባብከዝደረ ዞደሮ አይሶ “ጮይስም ዱክናርንካ ዉችትዮ ተይተኬ፥ Ꮊብር ከት ዎጅንዳ ማቸረ ዎታ ኤሳዮቴ” ና ከደር ጋይሴ።<verse eid="JHN 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3"/>ኮታይካ ጴጥሮስኬ አብ ክታ ካርንካ ጎርስምድባብካ ዉትሰኮ ዱክንደር አይሰኬ። <verse eid="JHN 20:3"/><verse number="4" style="v" sid="JHN 20:4"/>ቃስተንንከሰረ የካ ዞደሮ Ꮊቀኬ፥ ኬዛር ማቼ አብና የሱሰታ ካርንካ ጎርስምድባብ ጴጥሮስዘንካ ስግ ሳነካ ዞደሮ እርምሶ ዱክንደር የልሴ። <verse eid="JHN 20:4"/><verse number="5" style="v" sid="JHN 20:5"/>ይርክን ጋይሶ ዱክናር ክት ሰድንካ ክትም አክሰርሳን አፍለና ይንት ዶቅድንደትም ኖ ሰጄ፥ ኬዛር ማቼ ዱክንታ ዋር አርዳክዬ።<verse eid="JHN 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 20:6"/>ስምኦን ጴጥሮሰረ ክትም ጎርስምሶ ይ Ꮊዳንግንዳ ዱክንታ ዋር አርደዴ፥ ኖየረ አክሰርሳን አፍለና ዋር ዶቅድንካ ሰዴ፥ <verse eid="JHN 20:6"/><verse number="7" style="v" sid="JHN 20:7"/>የሱሰታ ማተን ከት ዞክስንካ Ꮊቃን አፍለና ክትም አክሰርሳን አፍለንካ ክክን ማታክዶቆ ይንት Ꮊክ አብ ካርዘን ቁርምሶ ዶቅድንካ ሰዴ።<verse eid="JHN 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 20:8"/>ኮታዘንከረ እርን Ꮊድባብ የሱሰታ ካርንካ ጎርስምድባብ ዱክናር አርድሶ ሰድሶ አሜንሴ። <verse eid="JHN 20:8"/><verse number="9" style="v" sid="JHN 20:9"/>ኮነረ “ደእያርንካ አም ክትም ዝግዝዴ” ጋይድንደትም ጭል ማጻፍንታ ቃለን አክ ገቀርት ተያከኬ። <verse eid="JHN 20:9"/><verse number="10" style="v" sid="JHN 20:10"/>ኮታ ቡር ቃስተነረ የሱሰታ ካርንካ ጎርስምድባብከስ ማተኮ ይንታ ኤሪ አይሰኬ።<verse eid="JHN 20:10"/></para>
  <para style="s1">የሱስ ማግደላ ፍጨናርንካ Ꮊዳን ማራመትካንታ Ꮊፍርና</para>
  <para style="r">(<ref loc="MAT 28:9-10">ማቶ. 28፡9-10</ref>፤ <ref loc="MRK 16:9-11">ማር. 16፡9-11</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11"/>ማግደላ ፍጨናርንዳ ማራማ ኤፈሮ፥ ዱክ ጎርንታ ማልጎካ ዎእሶ Ꮊቄ፥ ኤፈሮ ይርክን ጋይሶ ዱክንታ ዋር ና ሰጄ። <verse eid="JHN 20:11"/><verse number="12" style="v" sid="JHN 20:12"/>የሱሰታ ለይስን Ꮊቃን ካርንዘን ጫምሳ አፍላ ቆበርስባብከስ ቃስተን ክታይንችንከስ ዋልቃባብ ቃዳኦል ጎካ ዋልቃባብ ዱት ኦል ጎካ ዶቅሶ ዶቅድንካ ና ሰዴ። <verse eid="JHN 20:12"/><verse number="13" style="v" sid="JHN 20:13"/>ከተረ ማራመም፥ “የና ኤተኖ! Ꮊረተስ ኤብዳ?” ኮደር ጋይሰኬ።</para>
  <para style="q1" vid="JHN 20:13">ናየረ “እስታ ጮይስን ተይ አይሰኬ፥ Ꮊብር ከት ዎጃ ናነረ ኤሳይቴ” ና ጋይሴ።<verse eid="JHN 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 20:14"/>ኮመረ ና ጋይሶ ይንታ ቡር ዋልን ኮት ጋይድንካ የሱሰም ዎእሶ ክት ዶቅድንካ ክትም ሰዴ፥ የሱስ ክት ማቻንደትም ና ኤሳክዬ። <verse eid="JHN 20:14"/><verse number="15" style="v" sid="JHN 20:15"/>የሱስ፥ “የና ኤተኖ Ꮊረተስ ኤብዳ፥ Ꮊይመስ ዝግዳ?” ኮትም ጋይሴ።</para>
  <para style="q1" vid="JHN 20:15">ናየረ Ꮊምንባብ ካምስንካ፥ “እባቦ! የስ ተይንዳ ማቼ የስ Ꮊብር ዎጃናንከረ ዋደ እም ከስካ፥ እታ ተይ አይትቴ” ክደር ጋይሴ።<verse eid="JHN 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16"/>የሱሰረ “ማራሞ!” ኮትም ጋይሴ። ናየረ ክደር ዋልን ጋይሶ እብራይስጥ አፈካ “ረቡን!” ክትም ጋይሴ፥ ቡልነረ “የና ኤስስንባቦ!” ጋይንትዬ።<verse eid="JHN 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17"/>የሱሰረ “አክ እባብደር አያክቴ እም Ꮊይ ዎሌ ኬዛርንካ ማቼ እስታ እስመንከዘደር አይሳዮ ‘እታ እባብደርኬ የንታ ባቤንደር፥ እስታ ጮይስንደርኬ የንታ ጮይስንደር አይድቴ ኖ ጋይቴ’ ጋይሰዮ ከትም ኬዝካ” ኮትም ጋይሴ።<verse eid="JHN 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18"/>ኮካንታ ማግደላ ፍጨናርንዳ ማራማ የሱሰታ ካርንካ ጎርስምድባብከዝደር አይሶ ጮይስም ይ ሰዳንግንደኬ ኖየረ Ꮊስ ኮትካንታ ጋይሳናነረ ከትካንታ ና ኬዜ።<verse eid="JHN 20:18"/></para>
  <para style="s1">የሱስ ይንታካርንካ ጎርስምድባብከስካንታ መያ ማትንተና</para>
  <para style="r">(<ref loc="MAT 28:16-20">ማቶ. 28፡16-20</ref>፤ <ref loc="MRK 16:14-18">ማር. 16፡14-18</ref>፤ <ref loc="LUK 24:36-49">ሉቃ. 24፡36-49</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19"/>ኮትኮ ሳምንትንታ እር ሰጨን ዎጋᎺይካ ሶይት የሱሰታ ካርንካ ጎርስምድባብከስ አይሁድንከስታ ገችታ ኤረንባብከስም ጳስካ፥ ፍልተንም ዝጭሰኮ፥ ኤሄንታ ዋር ሳንሶ Ꮊቀኬ፥ ፍልተንከስ ዝጭምሶ ዶቅድንካ የሱስ ክታ ካርንካ ጎርስምድባብከስ ሳንምሳን ኤሄናር አርደዴ፥ ከታ ዎክናረረ ዎእሶ፥ “ሳራትቸና የካንታ ማታ!” ከትም ጋይሴ። <verse eid="JHN 20:19"/><verse number="20" style="v" sid="JHN 20:20"/>ኮመረ ጋይሶ ይንታ አንንከስምኬ ይንታ ከለን ከትም ሰችሴ፥ ክታ ካርንካ ጎርስምድባብከሰረ ጮይስም ከታ ይ ሰዳንደትካ ጉርምሰኬ። <verse eid="JHN 20:20"/><verse number="21" style="v" sid="JHN 20:21"/>ኮታ ቡር የሱስ አነታ “ሳራትቸና የካንታ ማታጋካ! ሳብ ባቤና እም ኦይቻንግንዳ እተረ የም ኦይድቴ” ከደር ጋይሴ። <verse eid="JHN 20:21"/><verse number="22" style="v" sid="JHN 20:22"/>ኮም ጋይሶ ኡፍ ከታዘን ጋይስንካ “አያን ጭልንም ተየኬ፥ <verse eid="JHN 20:22"/><verse number="23" style="v" sid="JHN 20:23"/>የታ ኤድንከስታ ጎመን ነጋ የ ጋይዴ ነጋ የካንታ ጋይምተሬ፥ የታ ኤድንከስታ ጎመን ነጋ ጋይዳክንዳ ማቼ፥ ነጋ የካንታ ጋይምተራክዬ” ከትም ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">20፡23 </char><char style="xt" closed="false"><ref loc="MAT 16:19">ማቶ. 16፡19</ref>፤ <ref loc="MAT 18:18">18፡18</ref>። </char></note><verse eid="JHN 20:23"/></para>
  <para style="s1">የሱሰኬ ቶማሰካ</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24"/>የሱስ ይንታ ካርንካ ጎርስምድባብከዝደር Ꮊዳንደትካ ታመከ ቃስተንንከሳርንካ ዋልቀና፥ ድድሞስ ጋይምስባብ ቶማስ ከትካ ክክን Ꮊቃክዬ። <verse eid="JHN 20:24"/><verse number="25" style="v" sid="JHN 20:25"/>ኮካንታ አብንከስ የሱሰታ ካርንካ ጎርስምድባብከስ ቶማዝደር “ጮይስም ሰዶቴ” ክደር ጋይሰኬ። ኖ ማቼ “ምስማርንካ እከርስባብ ክታ አንንከስም እ ሰዳክንዳ ማቸኬ እስታ ግልኤንም ምስማርንካ እከርሳንደታር እ አርቻክንዳ ማቼ፥ እስታ አንንታ ግልኤንም ክታ ከለን እከርሳንደት ካርናር እ አርቻክንዳ ማቼ አመናይቴ” ከደር ጋይሴ።<verse eid="JHN 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26"/>“ላመካይ ሰጨታ ቡርጎካ የሱሰታ ካርንካ ጎርስምድባብ አነታ ኤሄንታ ዋር Ꮊቀኬ፥ ቶማሰረ ከትካ የካ Ꮊቄ፥ ፍልተንከስ ዝጭምሶ ዶቅድንካ የሱስ Ꮊድሶ ከታ ዎክያር ዎእሶ እስታ ሳራትቸና የካንታ ማታ!” ከደር ጋይሴ። <verse eid="JHN 20:26"/><verse number="27" style="v" sid="JHN 20:27"/>ኮታ ቡር ቶማስም፥ “የስታ ግልኤን ኮር ተይ Ꮊድሶ እስታ አንንከስም ሰድካ፥ የስታ አንንመረ ተይᎺድሶ እስታ ከለንዘን አርችካ፥ አሜንካ ዳት Ꮊይ Ꮊኤእሬ” ክትም ጋይሴ።<verse eid="JHN 20:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28"/>ቶማሰረ “እስታ ጮይስኖ! እስታ ሳብኖ!” ጋየሮ ክትካንታ ማስሴ። <verse eid="JHN 20:28"/><verse number="29" style="v" sid="JHN 20:29"/>የሱሰረ ቶማሰም “የና ማቼ የስ እም ሰዳንኦል አሜንሳዬ፥ እም ሰዳከክ ዶቆ አሜንድባብከስ ማቼ ከታ አንጅምስባበኬ” ክደር ጋይሴ።<verse eid="JHN 20:29"/></para>
  <para style="s1">ኮማጻፍናር ዝግዝድን አፍ ኬዘና</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30"/>የሱስ ኮማጻፍናር ጻፍማክንደትም በድ አታ ክታ ካርንካ ጎርስምድባብከስታ እር ይቴ፥ <verse eid="JHN 20:30"/><verse number="31" style="v" sid="JHN 20:31"/>ኬዛር ማቼ የሱስ ሳይምስባብ ሳብታ ይንች ማትንተን የ አሜንተርንግንደኬ፥ የታ አሜንሰረ ክታ ላምንካ ስለንካ ዶቅድን ሰንፔንም የ Ꮊፍተርንግንዳ ኮና ጻፍምቴ።<verse eid="JHN 20:31"/></para>
  <chapter eid="JHN 20"/>
  <chapter number="21" style="c" sid="JHN 21"/>
  <para style="s1">የሱስ ታብዛ ክታካርንካ ጎርስምድባብከስካንታ መያ ማትንተና</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1"/>ኮታ ቡር የሱስ ጢብራዶስ ባሀርንታ ላማር፥ ይንታ ካርንካ ጎርስምድባብከስካንታ አነታ መያ ማቼ፥ ክታ መያ ማትነረ ኮግንዳኩኔ፥ <verse eid="JHN 21:1"/><verse number="2" style="v" sid="JHN 21:2"/>ስምኦን ጴጥሮስ፥ ድድሞስ ጋይምስባብ ቶማስ፥ ቃና ገልለንክንባብ ናትናኤል፥ ዛብዶሰታ ይንችንከስኬ አብንከስ ቃስተን ክታ ካርንካ ጎርስምድባብከስ የካ Ꮊቀኬ። <verse eid="JHN 21:2"/><verse number="3" style="v" sid="JHN 21:3"/>ስምኦን ጴጥሮስ “ሞላ የድካንታ እታ አይድቴ” ከደር ጋይሴ።<note caller="-" style="x"><char style="xo" closed="false">21፡3 </char><char style="xt" closed="false"><ref loc="LUK 5:5">ሉቃ. 5፡5</ref>። </char></note></para>
  <para style="p" vid="JHN 21:3">ከተረ “የስካ ክክን አይዶቴ” ክደር ጋይሰኬ፥ ዉትሰረ አይሰኮ ሎቀዘንካ ቃልዝድን ጃልበናር አርደደኬ፥ ኬዛር ማቼ ኮት ሶይትንካ ዋልቃ ሞላ ዎራ የዳከኬ። <verse eid="JHN 21:3"/><verse number="4" style="v" sid="JHN 21:4"/>ሰጭድንካ የሱስ ባሀርንታ ላማር ዎእሴ፥ የሱሰታ ካርንካ ጎርስምድባብከስ ማቼ የሱስ ክት ማትንተን ኤሳከኬ። <verse eid="JHN 21:4"/><verse number="5" style="v" sid="JHN 21:5"/>የሱሰረ “እስታ ይንችንከሶ! ዋልቃ ሞላ የንደር ዶቅዶ?” ከደር ጋይሴ።</para>
  <para style="p" vid="JHN 21:5">ከተረ “Ꮊረነረ ዎንደር ካዬ” ክደር ጋይሰኬ።<verse eid="JHN 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6"/>ኖየረ “የንታ ሞለን የድን ሳከን ሎቀንዘንካ ቃልዝድን ጃልበንታ ምዝዘን ጎካ ኦይትሰቶ Ꮊብደቴ” ከትም ጋይሴ።</para>
  <para style="p" vid="JHN 21:6">ኮካንታ ሞለን የድን ሳከን ባሀርንታ ዋር ኦይቸኬ፥ በድ ሞለረ ከታ የድንዘንካ አምሳንዳ ሳከን ጎችና ከትም ጋምሴ።<note caller="-" style="x"><char style="xo" closed="false">21፡6 </char><char style="xt" closed="false"><ref loc="LUK 5:6">ሉቃ. 5፡6</ref>። </char></note><verse eid="JHN 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7"/>ኮትᎺይካ የሱስ ሶልምድን ክታ ካርንካ ጎርስምድባብ ጴጥሮሰም “ጮይስ ዳት!” ክደር ጋይሴ። ስምኦን ጴጥሮስ “ጮይስዬ” ጋይንተንም ይ ኤሰርሳንደትካ ፍክስካንታ ጋይሶ ይንታ አፍለን ዉችሶ ይ Ꮊቃንኦል ሳነካ አፍለን ቆበርሶ ባሀርናር ጎብሶ አርደዴ። <verse eid="JHN 21:7"/><verse number="8" style="v" sid="JHN 21:8"/>አብንከስ የሱሰታ ካርንካ ጎርስምድባብከስ ማቼ ፍጨንዘንካ ከት ጎተርሳንዳ ጨታ ኡል ማታባብ Ꮊክ ማቻንጎካ ሞላ ጮጫንደትም ሳከንም ጎቸረኮ ሎቀንዘንካ ቃልዝድን ጃልበንካ Ꮊደኬ። <verse eid="JHN 21:8"/><verse number="9" style="v" sid="JHN 21:9"/>ሎቀንዘንካ ቃልዝድን ጃልበንዘንካ ከት ᎺንቸርሳንደትᎺይካ ሞላ ኮታዘን ዶቅድንዳ ጭልስታ ዎልስምኬ ሶለካ ሰደኬ። <verse eid="JHN 21:9"/><verse number="10" style="v" sid="JHN 21:10"/>የሱሰረ “ታ የ የጃንደታርንካ ሞለን ተይᎺድከቴ” ከትም ጋይሴ።<verse eid="JHN 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 21:11"/>ኮካንታ ስምኦን ጴጥሮስ ሎቀንዘንካ ቃልዝድን ጃልበናር አርድሶ ዋልቃ ጨተኬ ኦይድ ቦንደኬ ታሜኬ ማከን አንድር ሞለንከስ ጮጫን የድን ሳከን ፍጨዘን ጎቼ፥ ኮ ከከን በድ ሞለን የጅንከረ ሳክና Ꮊአክዬ። <verse eid="JHN 21:11"/><verse number="12" style="v" sid="JHN 21:12"/>ኮታ ቡር የሱስ “ኮረቴ ዳይጨን እችከቴ” ከትም ጋይሴ። ጮይስ የሱስ ማቻንደትም ሙደነረ ኤስሶ Ꮊቃንጎካ ክታ ካርንካ ጎርስምድባብከሳርንካ ዋልቃ ዎራ፥ “የና Ꮊይራ?” ጋይሶ ክትም ኦይስካንታ ካርችስባብ ካዬ። <verse eid="JHN 21:12"/><verse number="13" style="v" sid="JHN 21:13"/>ኮታዘንከረ የሱስ Ꮊድሶ፥ ሶለንምኬ ሞለንምካ አምስሶ ከትካንታ እምሴ።<verse eid="JHN 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 21:14"/>የሱስ ደእናርንካ አምሳንዘንካ ፈንክ ክታ ካርንካ ጎርስምድባብከስ ክትም ሰድንካ ኮና ማክምስ ዱቴ።<verse eid="JHN 21:14"/></para>
  <para style="s1">የሱስኬ ጴጥሮስካ</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15"/>ዳይጫ ከት እቻንደታ ቡር የሱስ ስምኦን ጴጥሮሰም፥ “ዮነታ ይንች ስምኦኖ! ከናከስ እም ሶልምድንዘንካ ስግ እም ሶልምዳ?” ክትም ጋይሴ። ኖየረ “ይዬ፥ እስታ ጮይስዮ! እ የስም ሶልምድንደትም የና ኤዝደዬ” ጋይንተካ ክትካንታ ማስሴ። የሱሰረ “እስታ ቅንጭንከስም እችስካ” ክትም ጋይሴ። <verse eid="JHN 21:15"/><verse number="16" style="v" sid="JHN 21:16"/>ቃስትምስ ዱተረ “ዮነታ ይንች ስምኦንዮ! የና እም ሶልምዳ?” ክደር ጋይሴ። ኖየረ “ይዬ፥ እስታ ጮይስኖ! እ የስም ሶልምድንደትም የና ኤዝደዬ” ክደር ጋይሴ። የሱሰረ “እስታ ቡትልንከስም ካርስካ” ክትም ጋይሴ። <verse eid="JHN 21:16"/><verse number="17" style="v" sid="JHN 21:17"/>ማክምስ ዱተረ “ዮነታ ይንች ስምኦንዮ! የና እም ሶልምዳ?” ክትም ጋይሴ። ማክምስ ዱት “የና እም ሶልምዳ?” ክትም ጋይሳንካንታ ጴጥሮስ ሞርእሶ “ጮይስዮ! የና ሙደንም ኤዝደዬ፥ እ የስም ሶልምድንግንደረ ኤዝደዬ” ክደር ጋይሴ። የሱሰረ ኩን ክትም ጋይሴ፥ “እስታ ቆልንከስም ግስካ”፥ <verse eid="JHN 21:17"/><verse number="18" style="v" sid="JHN 21:18"/>ዶፈን ዶፈን የስም ጋይድቴ፥ የና ማርምድ ዶቅደዮ የስታ ሳቅን የስታ አን ገተንካ ሶቀርሰዮ የስ ዝግዛንደር አይድ Ꮊቀዬ፥ የስ ጋልተርሳን Ꮊይካ ማቼ የና የስታ አንን አብደዬ አብ ኤድ የስም ቆፍስተረ፥ የስ ዝግዳክንደታር የስም ተይ አይደኬ። <verse eid="JHN 21:18"/><verse number="19" style="v" sid="JHN 21:19"/>ኮመረ የሱስ ጋይሳንዳ ጴጥሮስ Ꮊራግንዳ ደእካ ሳብም ቦንቻ ዝግዝድንደትም ሰችካንታ ጋይሴ፥ ኮታ ቡር ጴጥሮስም “እም ጎርስምካ!” ክትም ጋይሴ።<verse eid="JHN 21:19"/></para>
  <para style="s1">የሱሰኬ አብ ክታ ካርንካ ጎርስምድባብካ</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20"/>ጴጥሮስ ዋልን ጋይሶ የሱስ ክትም ሶልምድባብ ክታ ካርንካ ጎርስምድንካ ሰዴ፥ ኮና የሱሰታ ካርንካ ጎርስምድባብ ሶይት ጋለን ከት እጅድንካ የሱሰደር እጵን ጋይሶ፥ “ጮይስዮ፥ የስም ስክስት እምድባብና Ꮊይራ?” ጋይሶ ኦይስባብኔ። <verse eid="JHN 21:20"/><verse number="21" style="v" sid="JHN 21:21"/>ጴጥሮስ ክትም ሰድሶ፥ “ጮይስዮ! ኮና ኤችና Ꮊርክ ማተራ?” ጋየሮ የሱሰም ኦይሴ።<verse eid="JHN 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22"/>የሱሰረ “እታ Ꮊተርን የለልታ ዶቃባብ እ ጋይሴ የስም Ꮊራ አርችሳሬ? የና እም ጎርስምካ!” ክትም ጋይሴ።<verse eid="JHN 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 21:23"/>ኮጎካ የሱሰም ጎርስምድባብከስታ ዎክያር፥ “ኮና ክታ ካርንካ ጎርስምድባብ ደእዳክዬ” ጋይድንዳ ኬዛ ኤስምሴ፥ ኬዛር ማቼ የሱስ፥ “እ Ꮊተርን የለልታ ዶቃባብ እ ጋይሴ የስም Ꮊራ አርችሳሬ” ጋይሳ ዳት፥ “ደእዳክዬ” ጋያክዬ። <verse eid="JHN 21:23"/><verse number="24" style="v" sid="JHN 21:24"/>ከትኬና ርን ከስጎካ ሙዳ ማርከርስባብከ ከትከነመረ ርንከስም ጻፍስባብ ኮና ክታ ካርንካ ጎርስምድባቤ፥ ክተረ ማርካትቸና ዶፈን ማቻንደትም ኤዝዶቴ።<verse eid="JHN 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25"/>የሱስ ፍክሳንዳ አብ በድ ርንከስ ጉጅሶ ዶቅደኬ። እም ካምድን ግንዳ ማቼ ክት ፍክስባብ ሪንከስ ሙዳ ዋልቃ ዋልቀና ሙዳ ጻፍምሰስ ናና ጻፍምድን ማጻፍንከስም ፍጫ ሙደና ባላካንታ ማታይዶቆ።<verse eid="JHN 21:25"/></para>
  <chapter eid="JHN 21"/>
</usx>
