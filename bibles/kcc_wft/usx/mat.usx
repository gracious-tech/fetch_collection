<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Lubila</book>
  <para style="h">MATIO</para>
  <para style="toc1">Chem ubasɛ kɛ kusɛgɛ matio</para>
  <para style="toc2">Matio</para>
  <para style="toc3">Mt.</para>
  <para style="mt2">Chem ubasɛ da ire Kɛ</para>
  <para style="mt1">MATIO</para>
  <para style="imt">Kɔsani</para>
  <para style="ip">Chem ubasɛ kɛ kusɛgɛ matio, uheminɛ nfɔnɔ dɛkana iyɛ Jizɔz amɛ urenɛ one uwɛ irisegɛ, kamɛ ubasɛ usạd detemɛ yɛ iyaŋ uye bɔŋ bɛbɛ kɛ kusɛgɛ itạmi. Nfɔnɔ chiem ɛya bɛ ju bɛŋchen ure ikɔ ikạm Jizɔz imari, ɔkɔnɛ ŋun kpai.</para>
  <para style="ip">Matio ya ayaŋmạŋ unim, ire ɔsaninɛ nɛ dɔmad Jizɔz, uhemɛ da mạm kubegɛ Jizɔz ichɛŋ nɛ okpo bɛ useŋi mạŋ, ɛnɛ ɔsani dotomɔ chiem ubasɛ kuhemi, uchegi, ubogi ayuyumi kɛ Galili. Uwɛ ɔlaŋanɛ kusɛgɛ ubasɛ uhemɛ chiem kɔchɛŋ Jizɔz sani kɛ Galili utogɔ ɔramạŋ Jɛrusɛlɛm nɛ bobɛ Jizɔz isạdri krawe ndama, boba uheminɛ da uwɛ Jizɔz ɔcheɛŋ ube nɛ kɔkagi yɛyɛ.</para>
  <para style="ip">Chem ubasɛ ya ɔyaŋanɛ Jizɔz da onewɛ uchegi, uwɛ ɔkɔ ikɔm dɛman ubasɛ kuboŋɔ, nɛ onewɛ uchiemi da kɛbɔd ubasɛ ire. Kuchegi yɛyɛ dɛyama ɔnaninɛ kreto aten uwɛ ure (1) Chem yɛyɛ kikon irirenɛ dɛmara, okpobɛ asạri, ikɔm okpo kusạd, nɛ ɔfa dure uwɛ bɔŋɔ lonɔ kakpomɔ kɛbɔd ubasɛ (deto 5-7); (2) Da uwɛ bɔŋɛtɔ jio nawumɔ uwɛ asạd okpo krotomɔ bɛbɛ (deto 10); (3) kosei da kpomɔ kɛbɔd ubasɛ iyạŋ (deto 13); (4) Kuchegi uwɛ ɔramạŋ kɛkpa bɔŋɛtɔ(deto 18); nɛ (5) Kuchegi da ŋun ichiŋ ibuni ukpe nɛ kuwu ubasɛ (deto 24-25).</para>
  <para style="iot">Kuchega uwɛ uyạŋ kɛkɔn</para>
  <para style="io1">Kɔasani dɔmad Jizɔz (1. 1-2. 23)</para>
  <para style="io1">Dotomɔ Jɔn ubeŋi ane mạm (3. 1-12)</para>
  <para style="io1">Mạm kubegɛ nɛ okpo bɛ useya Jizɔz (3. 13-4. 11)</para>
  <para style="io1">Chem Jizɔz kɔnyɔm krukpad Galili (4. 12-18. 35)</para>
  <para style="io1">Sani Galili arawɛ Jɛrusɛlɛm (19. 1-20. 34)</para>
  <para style="io1">Ukpoŋi ndam ɛya ɔbaŋi mạŋ nɛ Jɛrusɛlɛm (21. 1-27. 66)</para>
  <para style="io1">Kɔkagi nɛ ɛkpa kuchegɛ Jizɔz (28. 1-20)</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">Bɛ ɔsɛ ɔsɛ Jizɔz krais</para>
  <para style="r">(<ref loc="LUK 3:23-38">Lk. 3.23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Kɔsani Jizɔz Wɔŋ ɔbɔd Devid uwɛ uwu kutu ɛbraham.<verse eid="MAT 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2" />Ɛbraham irihon Izik, Izik uhon Jekɔb, Jekɔb uhon Juda nɛ bɔŋ ɔka.<verse eid="MAT 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 1:3" />Juda uhon Pɛrɛz nɛ Zɛra, uwɛ ɔka ikoninɛ Tama, Pɛrɛz uhon Hɛzɛrɔn, Hɛzɛrɔn uhon Ram.<verse eid="MAT 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 1:4" />Ram uhon Aminadab. Aminadab uhon Nashɔn. Nashɔn uhon Salmɔn.<verse eid="MAT 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 1:5" />Salmɔn ɔsɛ Boas, uwɛ ɔka irire rehab. Boas uhon Obɛd. Obɛd uwɛ ɔka ikoninɛ nɛ Rud, ɔkanɛ Ju wani ure. Obɛd uhon Jɛsi.<verse eid="MAT 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 1:6" />Jɛsi uhon ɔbɔd Devid. ɔbɔd Devid uhon Sɔlɔmɔn. ɔka Sɔlɔmɔn iri baninɛ Uria<verse eid="MAT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 1:7" />Sɔlɔmɔn uhon Rehobuam. Rehobuam uhon Abija. Abija uhon Asaf.<verse eid="MAT 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 1:8" />Asaf uhon Jɛhosafat. Jɛhosafat uhon Jɛhoram. Jɛhoram ɔsɛ ɔsɛ Uzia.<verse eid="MAT 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 1:9" />Uzia uhon Jodam. Jodam uhon Ehaz. Ehaz uhon Hɛzɛkia.<verse eid="MAT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 1:10" />Hɛzɛkia uhon Manasɛ. Manasɛ uhon Amɔn. Amɔn uhon Jozia.<verse eid="MAT 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 1:11" />Jozia urenɛ ɔsɛ ɔsɛ Jɛkonia nɛ bɔŋ ɔka ari nuginɛ kubiɛsɛ ari yam bɔŋɔ Izrɛl kɛ dekpo atogɔ arabɛŋ Babilɔn<verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />Uru kɛ babilɔn amɛ Jɛkonia ihonɛ Shɛtiɛl. Shɛtiɛl amɛ urenɛ ɔsɛ ɔsɛ Zɛrubabɛl.<verse eid="MAT 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 1:13" />Zɛrubabɛl uhon Abiud. Abuid uhon Ԑliakim. Ɛliakim uhon Azɔ.<verse eid="MAT 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 1:14" />Azɔ uhon Zadɔk. Zadɔk uhon Akim.<verse eid="MAT 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 1:15" />Akim uhon Ɛliud uhon Ɛliaza, Ɛliaza uhon Matan. Matan uhon Jekɔb.<verse eid="MAT 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 1:16" />Jekɔb uhon Josɛf. Josɛf uwɛ urenɛ urum Mery ɔka Jizɔz onewɛ uchegɛ bara iyem dɔnaŋi bara.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Amamara kpai sani kɛ dohon ɛbraham utumi kɛ dohon ɔbɔd Devid urenɛ dohon jiou nanaŋ. Sani kɛ dohon ɔbɔd Devid utimi kubisɛ awạmɛnɛ bɔŋɔ Izrɛl alawɔ kɛdon ubɛbɛ akayaŋ bɛŋ kɛ babilɔn urekɛnɛ jiou nanaŋ. urekɛnɛ jiou nanaŋ isai amad Jizɔz.<verse eid="MAT 1:17" /></para>
  <para style="s">Dɔmad Jizɔz krais</para>
  <para style="r">(<ref loc="LUK 2:1-7">Lk. 2.1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Uwa urenɛ da dɔmad Jizɔz ichɛŋ ɔsani. ɔka iriyerɛ Josɛf kɔban. Asi iyɛ ukutumi kubisɛ uwɛ aban bem. Mery iritogɔ utu uwɛ uwu kɛ kɛwaŋ ubasɛ.<verse eid="MAT 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 1:19" />Josɛf urenɛ onewɛ ɔkɔ kɛwɔd ubasɛ usạdmạŋ ubunɔ ane ayenɛ iyɛ amɛ ikilawɔ Mery ɔban. ubuninɛ usạdmaŋ kimạm.<verse eid="MAT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20" />kubisɛ Josɛf iŋaninɛ ɛkɔn kɛ bobɛ useyɛmaŋ, ɛngɛl iri ichegɛmạŋ ɛkpa krɔrau uyedmạŋ, Josɛf wɔŋ ɔbɔd Devid, kɛwɔd kani, wani wowo kayim. Utu yɛ itumɔnɛ, kɛwaŋ ubasɛ ɔŋana mạŋanɛ.<verse eid="MAT 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 1:21" />Iki wanmạŋ woŋ onerum. Awɛ awu ebuni ayemạŋ dokom Jizɔz, uwuŋinɛ iri segɛ ane bɛbɛ kokpo ayinɛ<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />Uwa kpai uchegɛnɛ ɛkpayɛyɛ da ubase asama ɔyɔm kɛ ɛma anebɛ ahemi dɛman ubasɛ<verse eid="MAT 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 1:23" />&lt;&lt; Kɛkɛ woŋ one wani wɛ ɔka anerum uyed iki togɔ utu ɔmad wɔŋ onerum. Uwɛ awenimạŋ Imanuɛl &gt;&gt; Uwɛ ɔnani Ubasɛ uyiŋkɛ nabod.<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Josɛf ɔkpamanɛ ɔkaimạŋ krɔrau, usạd da ɛngɛl ɔsama uhemɛ mạŋ. ɔnɔŋkɛ Mary da waniwɛwɛ.<verse eid="MAT 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 1:25" />Asi namɛ une tata ɔwanmạŋ. Josɛf uyemạŋ dokom Jizɔz.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">Asinɛ bɛ awu kɛ kpabɔk</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Jizɔz ɔmari kɛ donɔyɛ ukoni Bɛtlɛhɛm kɛ Judia, kubisɛ Hɛrɔd irirenɛ ɔbɔd. uchira anebɛ akɔ dukpeŋɛ okonkoniɛ ariwu ndama kpabɔk Jɛrusalɛm.<verse eid="MAT 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 2:2" />Jizɔz abɔu &lt;&lt;ndɛ wɔŋɔwɛ ɔmarinɛ uwɛ ubuninɛ uremɛ ɔbɔd bɛ ju? dɛrɔn okonkoni yɛyɛ kɛ kpabɔk Jɛrusalɛm amɛ dewunɛ dewi jinɛ deto duyemạŋ. &gt;&gt;<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Kubisɛ ɔbɔd Hɛrɔd ikomɔnɛ iyɛ ɔbɔd urạgarạg imari kɛ Bɛtlɛhɛm kɛ Judia ɛkɔn iriyinɛmaŋ, Ԑkɔn uyinɛ ane kpai kɛ Jɛrusalɛm.<verse eid="MAT 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 2:4" />Ɔbɔd Hɛrɔd iriyeri abɔd ɛbara Ubasɛ nɛ anebɛ achiemi ntotobɔɔbɔubeŋ, ndɛ onewɛ uwungi irichegɛ iyem ibuni ɔmad?<verse eid="MAT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5" />&lt;&lt; Abɔnɔmạŋ iyɛ kɛ don ɛbara yɛ ukoninɛ Bɛtlɛhem kɛ Judia, &gt;&gt; Kɛkɛ bobɛ anebɛ ayemi dɛman Ubasɛ asɛgiː<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />Abon bɛ bɛtlɛhɛm Kɛ dɔchɛ Judia,</para>
  <para style="q2" vid="MAT 2:6">awu arɛgɛ atạm kɛ don bɛ anani dure kɛ judia;</para>
  <para style="q1" vid="MAT 2:6">ire kawu ɔbɔd ikiwukan uwɛ iritogɔ anebam izrɛl iyem. &gt;&gt;&gt;<verse eid="MAT 2:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="MAT 2:7" />ɛnɛ ɔbɔd Hɛrɔd iwiyed asinɛbɛ awunɛ kɛ kpabɔk kɛ Jɛrusalɛm ɔkɔmɔ kisumɔ kirạmi nɛ abɛ ɔbɔubɛŋ kubisɛ okonkoniyɛ uchegɛnɛ iyɛ ɔbɔd imari, ichegɛ ɛkpayɛyɛ krewe.<verse eid="MAT 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 2:8" />Ԑnɛ ɔbɔd Herɔd irisinɛbeŋ arabɛŋ kɛ Bɛtlɛhɛm nɛ dɛkanaː &lt;&lt;Dɔŋdun kabanarun ɛkpa bundun wɔŋɔwɛ; arɔnmạŋdun sạdnɛ nyenɛ, sạŋ am ndijinɛ deto nyemạŋ dirạg. &gt;&gt;<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />Arirạgabɛŋ, asi kiyem arikpekɛ arɔnkɛ okonkoniyɛ irisisinɛ uchegɛ ekpayɛyɛ uyebɛŋ, ɛkɔn irirɔmɔbɛŋ anaŋa tata, okonkoniyɛ utogɔbeŋ iyem ukutumi kisi Jizɔz iyạŋ.<verse eid="MAT 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 2:10" />Kubisɛ ane dukpeŋɛ arɔnɔnɛ okonkoniyɛ ɛkɔn irirɔmɔbɛŋ tata atedmạŋ ndam.<verse eid="MAT 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 2:11" />aririɛ kɛtɔ, akarɔn wɔŋ nɛ ɔkaa Mery, ari jinɛ deto ayemạŋ dɛbad. Ayemạŋ ekporɔ kɔtana inimɛ ukoni gold , kese ɛkpa yɛ ɔrɔmɔ kinyu ukoni frankincense nɛ ɛmia atogɔ akoŋi bom yɛ ukoni myrrh.<verse eid="MAT 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 2:12" />Arichɛŋ kiyem urạgarạg akpe kadon bɛbɛ ire ubasɛ iridugi bɛŋ kotoŋ krɔrau iyɛ one krekpe arabɛŋ uru hɛrɔd.<verse eid="MAT 2:12" /></para>
  <para style="s">Arirạma arabɛŋ ijip</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Kubisɛ abɛ ayaŋanɛ, ɛngɛl Ubasɛ irichegɛ Josef ɛkpayɛyɛ krɔrau utekmạŋ iyɛ &lt;&lt;Hɛrɔd ikibuni ɔŋan wɔŋɔwɛ. kaiwɛ baŋa wɔŋɔwɛ nɛ ɔkaa mɛdwɛ ŋad aragawɛ Ijip, yạŋa ɛɛ tata ntekwɛ aroŋɔ Ijip. &gt;&gt;<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />Josɛf ɔkaimạŋ, ɔbaŋa wɔŋ nɛ ɔkaa, utogɔ ɔramạŋ Ijip. &gt;&gt;<verse eid="MAT 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 2:15" />Josɛf yạŋanɛ tata Hɛrɔd ube. Urenɛ nyɔnɔ sạŋ bobɛ onewɛ Ubasɛ itok uhemi dɛman yɛyɛ ɔnani uchegɛ ɛkpa yɛyɛ, &lt;&lt;kɛ ijip nyed wɔŋwam nlawɔ<verse eid="MAT 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Kubisɛ Hɛrɔd iyedɛnɛ iyɛ asinɛbɛ itomɔnɛ dotomɔ atɔmạŋ mbɔk ɛkɔn iriyinɛmạŋ tata. iriyaŋ dɛman sạŋ aŋan bɔŋ anerum kɛ Bɛtlɛhɛm nɛ donɔyɛ uwogɔ Betlɛhɛm sani kɛ di awumɔ utogɔ tɔnɔ, dana asinɛbɛ awunɛ asama ayemamạŋ kubisɛ abɛ arɔnɔnɛ okonkoniyɛ uchegɛ bɛŋɛnɛ iyɛ ɔbɔd imari.<verse eid="MAT 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 2:17" />Da irenɛ iya bobɛ onewɛ Ubasɛ itogi ɔnyɔmi chiem uwure Jɛrimaia inani uchegɛ ɛkpa.<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />Arikomɔ dɛman kɛ Rama,</para>
  <para style="q2" vid="MAT 2:18">dɛman ibetoyɔ ɔyaŋawɛwɛ.</para>
  <para style="q1" vid="MAT 2:18">Rechɛl utokɛ uye bɔŋbɛbɛ;</para>
  <para style="q2" vid="MAT 2:18">kureni one nawunɔ ubunɔ kukomɔ,</para>
  <para style="q2" vid="MAT 2:18">ire bɔŋ abemạŋ.<verse eid="MAT 2:18" /></para>
  <para style="s">Kɛya Yɛyɛ Kɛ Ijip</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Kubisɛ ɔbɔd Hɛrɔd ibenɛ, ɛngɛl Ubasɛ iri chegɛ Josɛf ɛkpa yɛyɛ kɛ dɔrau kɛ Ijip.<verse eid="MAT 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 2:20" />Utekmạŋ, &lt;&lt;kaiwɛ baŋa wɔŋɔwɛ nɛ ɔkaa, akpekɛ ndam kɛ izrɛl, ire anebɛ abuni wɔŋɔwa kɔŋan abe. &gt;&gt;<verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />Isai Josɛf ɔkaimạŋ ɔbaŋa Jizɔz nɛ ɔkaa utogɔ ukpekɛ ndam kɛ Izrɛl.<verse eid="MAT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 2:22" />Kubisɛ Josɛf ikomɔnɛ iyɛ Akelaus inɔgɔ kɛ biaga ɔsɛ da ɔbɔd kɛ judia, Josɛf irikomɔ kɛwɔd amɛ ndam kukpe kɛ Izrɛl. one dotomɔ Ubasɛ irikpekɛ utekɛ Josɛf kɛ dɔrau sạŋmạŋ ɔyakɛ Izrɛl, Josɛf iriyaŋ ukunugi kɛ Galili.<verse eid="MAT 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 2:23" />Usạd kpomɔ kinạga yɛyɛ kɛ don wɔŋɔyɛ aweni Nazarɛd. Ԑnɛ iwiremɛ da onewɛ Ubasɛ itogɔ uhemi dɛman yɛyɛ asama uyema, Iyɛ &lt;&lt;wɔŋɔwɛ ukoninɛ Nazarɛn. &gt;&gt;<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">Chem ubasɛ uwɛ Jɔn ubeŋinɛ mạm</para>
  <para style="r">(<ref loc="MRK 1:1-8">Mk. 1.1-8</ref>; <ref loc="LUK 3:1-18">Lk. 3.1-18</ref>; <ref loc="JHN 1:19-28">Jn. 1.19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Kubisɛ uru Jɔn ubeŋinɛ ane mạm irita kɛ kpokpɛ dɔchɛ iyạŋ foi ose ikana ɔbaya, ԑnɛ ɔsani chiem Ubasɛ kuyemi.<verse eid="MAT 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 3:2" />waruŋ okpo ayina, &gt;&gt; kperun ndam aterɛrun Ubasɛ, kinạg yɛyɛ nɛ ane ikpɛrɛ&gt;&gt;<verse eid="MAT 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 3:3" />Jɔn amɛ urenɛ onewɛ Aizaya onewɛ ukomi dɛman Ubasɛ iriyɔminɛ iyɛ,</para>
  <para style="q1" vid="MAT 3:3">&lt;&lt;ikɔ one urori kɛ kpokpɛ dɔchɛ iyạŋ foi ose ikana ɔbaya,</para>
  <para style="q2" vid="MAT 3:3">&lt;noŋiruŋ iyem ayeruŋ Ɔbɔd;</para>
  <para style="q2" vid="MAT 3:3">tamaruŋ kpom uwɛ ɔcheŋ utạmǃ&gt;&gt;&gt;<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Dibara Jɔn atogɔnɛ esen ɛkpa yɛ ɔbaŋi ane atogɔ asạd, ɔŋani mạŋɛnɛ esen kpa kɔkpaga krɔlan , kokpoji yɛyɛ urenɛ taktak nɛ ɔkɔnkɔnɔ ɛmia.<verse eid="MAT 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 3:5" />Ane awuŋinɛ kɛ Jɛrusalɛm, nɛ Judia, nɛ kɛ don diduri ɛyɛ ɔbaŋi mạŋ nɛ ɔkpa Jodan.<verse eid="MAT 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 3:6" />Ari hema okpo ayinɛ abɛ asạri, Jɔn ubegɛbɛŋ mạm kɔkpa Jodan.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Kubisɛ Jɔn irɔnɔnɛ da bɛ Farasis nɛ bɛ sadusis awu awi begɛbɛŋ mạm, utibi &lt;&lt;abon bɛ yɔgɔba banɛ ayemɛ baruŋ iyɛ ɛkɛmɛ baruŋ kɔnaŋi kɛ dutugɔ Ubasɛ ibuni usinɛ uyebaruŋ<verse eid="MAT 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 3:8" />Sạduŋ okpo ba achegɛruŋ iyɛ abon ɛbạŋaruŋ ɛkɔn.<verse eid="MAT 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 3:9" />Sạŋ nyemɛbaruŋ kategɛ iyɛ abon ɛkɔruŋ Ԑbraham da asewoni. Sạŋ nyemɛ baruŋ Ubasɛ ikɛmɛ bɔŋ kuhon kɛ datan uye ɛbraham<verse eid="MAT 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 3:10" />Kɛkɛ ibạd une keseland ukomi, uwɛ usogɔ kese kusin yɛyɛ; kese nawunɔ ɔkanɛ dawama nfɔnɔ uwumi aki bemmạŋ ɔtɔ atogɔ abag ekon.<verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />Am beŋibarunɛ mạm uchegɛ iyɛ abon ɛbạŋarun ɛkɔn, asi one uwem uwɛ iri kobɔbarun nɛ kɛwaŋ Ubasɛ nɛ ekon. Amɛ ibara one tata urugɔnɛ; am nim mbegɛ esen nkpa nwunɔyɛyɛ kɔtami. &gt;&gt;<verse eid="MAT 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 3:12" />Ubasɛ utumkɛ kɛwagi kɛmbɔk; da onewɛ usạri kɛram iteginɛ eresi jɛn ulugi kɛ datagi yɛyɛ, nyɔi amɛ Ubasɛ uwɛ uteginɛ anebɛ ayedmạŋ anugi nfɔnɔ dɛmara ɔyaŋmaŋ kusigi. anebɛ asạri okpo ayinɛ amɛ iki kumibeŋ nɛ ekonɔyɛ ɔka kurạma ɔkɔ.<verse eid="MAT 3:12" /></para>
  <para style="s">Mạm kubegɛ Jizɔz</para>
  <para style="r">(<ref loc="MRK 1:9-11">Mk. 1.9-11</ref>; <ref loc="LUK 3:21-22">Lk. 3.21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Kubisɛ Jizɔz iriwu kɛ Galili iriterɛ Jɔn kɛ Jodan utek Jɔn ubegɛmạŋ mạm.<verse eid="MAT 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 3:14" />Jɔn uno kuyim iyɛ &lt;&lt;amɛ ɔbɔgi amɛ mạm kubegɛ&gt;&gt;, utekmạŋ nɛ &lt;&lt;awu abɔginɛnɛ mạm kubegɛ aam ure uwɛ begɛwɛ mạm&gt;&gt;.<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Jizɔz ɔbɔnɔmạŋ nɛ ɔkɔnɛ yɔi kurema isaiya. sạŋ am nɛ awu dusạd bobɛ Ubasɛ ibuni bara dusạd. &lt;&lt;Ԑnɛ Jɔn iriyerɛ mạŋ mạm kubegɛ&gt;&gt;.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Jɔn ubegɛkɛnɛ Jizɔz mạm, Jizɔz ɔnanikɛnɛ kamạm. Dewe ɔbanɛ umenɛ, Jizɔz ɔrɔn da kɛwaŋ Ubasɛ iyạŋ da abrukɔkɔgi ivurɔ ibạni iri bɛwɔmạŋ kɛ ɛkpa.<verse eid="MAT 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 3:17" />Dɛman iribạna krewe utek, kɛkɛ wɔŋɔ ɛkɔnɔ nyam uwɛ usạrinɛ nkomɔ ɔkɔndɔm.<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">Kɔhɛk Jizɔz</para>
  <para style="r">(<ref loc="MRK 1:12">Mk. 1.12</ref>,<ref loc="MRK 1:13">13</ref>; <ref loc="LUK 4:1-13">Lk. 4.1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Kuron Ubasɛ kɛ ɛkpa Jizɔz iri baŋamạŋ utogɔ ubra kɛ kpokpɛ uyạŋɛ foi mạm kure, sạŋ satan ɔŋɛgmạŋ. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Kubisɛ Jizɔz ibiaganɛ dɔwɔ kɛ dewe dɛnau awumɔ nɛ kirạni dɛnau awumɔ, dɔwɔ iri nomạŋ.<verse eid="MAT 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 4:3" />Setan iriwu uterɛ Jizɔz, utekmạŋ urebobɛ ere uchiemi wɔŋ Ubasɛ sạd kɔtanaya utạm kitawɔ ɔkara.<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Asi Jizɔz ɔbɔnɔmạŋ, &lt;&lt;kusɛgɛ Ubasɛ utekɛnɛ iyɛ, one sạŋ ukpen uwukan kɛ kitawɔ ɔkara mạŋchen, Nɛ asi ukpenɛnɛ uwukan kɛ chiem Ubasɛ. &gt;&gt;<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Ԑnɛ setan iritogɔ Jizɔz ɔramạŋ kɛ Jɛrusɛlɛm, donɔyɛ akana okpo ayinɛ one usạri, utogɔmạŋ ubạd dewe kɛkpomɔ dulimɛ ubasɛ,<verse eid="MAT 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 4:6" />Setan utekmạŋ, &lt;&lt;urebobɛ etegɛ iyɛ awu arenɛ wɔŋ Ubasɛ, naŋa abạna krɔchɛ, ire kusɛgɛ Ubasɛ inyɔmɔ iyɛ,</para>
  <para style="q1" vid="MAT 4:6">Ubasɛ ikiye ɛngel bɛbɛ ikɔm kreto yoyo;</para>
  <para style="q2" vid="MAT 4:6">aki yamawɛ nɛ mbɔk ubɛbɛ,</para>
  <para style="q2" vid="MAT 4:6">nạn akpira kratan. &gt;&gt;&gt;<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Jizɔz ɔbɔnɔ, &lt;&lt;kusɛgɛ Ubasɛ inyɔmɔ iyɛ kɛbɔd Ubasɛ yoyo kahɛk.<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Setan iritogɔ Jizɔz ubạd ikon ukuchegɛ mạŋ okpo ŋunɔ amɛ ikɔ kpai nɛ dɛbad okpobɛ ikɔ <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Setan utek, okpoba kpai, &lt;&lt;nkisɛŋ nyewɛ urebobɛ ɛkpạgi ndu ajinɛ deto ayenɛ. &gt;<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Jizɔz utekmạŋ kaiwɛ arogɔ kpokpa isaiya. Ire asisi asɛg iyɛː Akɔnɛ deto kujinɛ aye kɛbɔd Ubasɛ mạŋchen.<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Setan irirogɔmạŋ, ɛngɛls awukan arilawɔ mạŋ kafirɛ<verse eid="MAT 4:11" /></para>
  <para style="s">Jizɔz ɔsaninɛ dotomɔ yɛyɛ kɛ Galili</para>
  <para style="r">(<ref loc="MRK 1:14">Mk. 1.14</ref>,<ref loc="MRK 1:15">15</ref>; <ref loc="LUK 4:14">Lk. 4.14</ref>,<ref loc="LUK 4:15">15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Kubisɛ Jizɔz ikomɔnɛ iyɛ ayam Jɔn aŋana kɛtɔ dutạk uroŋɔ ɛ ɔramạŋ Galili.. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Urogɔnɛ Nazarɛt, aramạŋ kɛ Kapanum, ɔbaŋimạŋ nɛ kpokpɛ aweni Zɛbulɔn nɛ Naftali. <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />Sạŋ bobɛ onewɛ uyemi chiem Ubasɛ Aizaya isisi inyɔmɔ uchegɛ ɛkpa yɛyɛ.<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />Dɔchɛ Zɛbulɔn nɛ dɔchɛ Naftali,</para>
  <para style="q2" vid="MAT 4:15">iyemɛ ɔkpa ɛbara, utogɔ ɔragamạŋ Jodan,</para>
  <para style="q2" vid="MAT 4:15">nɛ Galili uwɛ akana Ubasɛ one uyed.<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />Anebɛ ari nugi kirạmi uwu awirɔn duyama dɛbad; ubɛ anugi kɛ kpomɔ dube anagibɛŋ. <verse eid="MAT 4:16" /><verse number="17" style="v" sid="MAT 4:17" />Sani ɛnɛ atogɔ arawɛ , Jizɔz irisani chiem Ubasɛ kuyemi, &lt;&lt;boŋɔruŋ ɛkɔn, kubi Ubasɛ uwɛ uremɛ ɔbɔd uye ane kpai ikitumiǃ&gt;&gt;<verse eid="MAT 4:17" /></para>
  <para style="s">Jizɔz Uyed Ane Anaŋ Ayami Kibri</para>
  <para style="r">(<ref loc="MRK 1:16-20">Mk. 1.16-20</ref>; <ref loc="LUK 5:1-11">Lk. 5.1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Da Jizɔz ichɛŋinɛ kɛ ɔkpa Galili kwaŋ irirɔn bɔŋ ɔka awumɔ ubɛ ayami kibri, uwunɔ ukoninɛ Pita uwunɔ ukoni Andru. dana akari iyạri kɛ ɔkpayɛ, da anebɛ asạri dotomɔ kibri kɔyama.<verse eid="MAT 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 4:19" />Jizɔz utekbɛŋ, &lt;&lt;Tednɛrun ndam, am nkisạd baruŋ aremɛrun anebɛ ayami ane. &gt;&gt;<verse eid="MAT 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 4:20" />Abanɛ ɛnɛ aroŋɔ iyạra bɛbɛ ated Jizɔz ndam.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Kɔchɛŋ uwunɔwɛ, Jizɔz ɔkɔrɔn kɛ bɔŋ ɔka aumɔ uwunɔ ukoninɛ Jems uwunɔ ukoni Jɔn. Ayạŋɛnɛ kokpok nɛ ɔsɛ ubɛbɛ ukoni Zɛbɛdi, anoŋi iyạra. Jizɔz uyedbeŋ. <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />Abanɛ aroŋɔ kokpok nɛ ɔsɛ ubɛbɛ ated Jizɔz ndam.<verse eid="MAT 4:22" /></para>
  <para style="s">Jizɔz Uchiemi, Uhemi, Ubogi</para>
  <para style="r">(<ref loc="LUK 6:17-19">Lk. 6.17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Jizɔz iriwaŋi Galili diduri, uchiemibeŋ bom kɛtɔ kisumɔ bɛ ju nawunɔ uyạŋ kɛ donɔyɛ, uyemibɛŋ chiem kuwenɛ ɛrɔmɔ nɛ kɛbɔd Ubasɛ, ukpekɛ ubogi kɛ ane uyum nawunɔyɛ atutum.<verse eid="MAT 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 4:24" />Kuwenɛ yɛyɛ irinyaŋa Siria diduri, ane atogi ayuyumi kutɔkutɔ nɛ anebɛ atum kɛwaŋ iyinɛ kɛ ɛkpa ariyeyɛmạŋ ubokbɛŋ, amɛ dirạg ubokbɛŋ.<verse eid="MAT 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 4:25" />Dɛyɔgɔbɛ aterimạŋ ndam kɛ Galili, nɛ dondɛbara jiou, ubɛ awu kɛ Jɛrusɛlɛm, Judia, atumi kɛ don kwan uran kɛ Jodan.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">Bom Kuchegi Jizɔz Kɛ Ikon</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Jizɔz ɔrɔnɔnɛ da ane awuŋi kɛ dɛyɔgɔ aterɛmạŋ, amɛ ubạd ikon dewe ɔkɔbiaga. Bɔŋɔ ɛtɔyɛyɛ awukan aterɛmạŋ.<verse eid="MAT 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 5:2" />ꓛsanibɛŋ bom kuchiemiː<verse eid="MAT 5:2" /></para>
  <para style="s">Nfɔnɔ Ɔkɔndɔm</para>
  <para style="r">(<ref loc="LUK 6:20-23">Lk. 6.20-23</ref>)</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />&lt;&lt; ꓛkɔndɔm uyạŋanɛ uyạŋ nɛ onewɛ uyed iyɛ amɛ ibunɔ bom uwɛ uwu kɛ Ubasɛ;</para>
  <para style="q2" vid="MAT 5:3">Ubasɛ ikisạdbɛŋ ayạŋa kɛbiaga kɛbɔdrɔ nɛ amɛǃ<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />ꓛkɔndɔm uyạŋanɛ uyạŋ nɛ anebɛ akomɔ ubian okpo ayinɛ abɛ asạri;</para>
  <para style="q2" vid="MAT 5:4">Ubasɛ iki ŋanibɛŋ ɛkɔnǃ<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />ꓛkɔndɔm uyạŋanɛ uyạŋ nɛ anebɛ atɔnɔ ɛkpa ubɛbɛ;</para>
  <para style="q2" vid="MAT 5:5">akinugi nɛ Ubasɛ kɛ dɔchɛ isin uwɛ Ubasɛ ubodkɛǃ<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />ꓛkɔndɔm uyạŋanɛ uyạŋ nɛ anebɛ akɔ dɛkɔnduri uwɛ asạd bobɛ Ubasɛ ibunibɛŋ asạd;</para>
  <para style="q2" vid="MAT 5:6">Ubasɛ ikiyebɛŋ bom nawunɔ abubunɔ kɛ ngunnɔyaǃ<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />&lt;&lt;ꓛkɔndɔm uyạŋanɛ uyạŋ anebɛ akɔ ubian aye bembɔŋ ubɛbɛ</para>
  <para style="q2" vid="MAT 5:7">; Ubasɛ ikitobɛŋ ubian dirạkǃ<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />ꓛkɔndɔm uyạŋanɛ uyạŋ nɛ anebɛ akɔ nfɔnɔ dirami kɛ dɛkɔnduri;</para>
  <para style="q2" vid="MAT 5:8">ane ubɛ akirɔn Ubasɛ jaiiǃ<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />ꓛkɔndɔm uyạŋanɛ uyạŋ uye anebɛ aŋani kɔkpama kakpom;</para>
  <para style="q2" vid="MAT 5:9">Ubasɛ iki yedbɛŋ bɔŋbɛbɛǃ<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />ꓛkɔndɔm uyạŋanɛ uyạŋ uye anebɛ ane asạri okpo ayinɛ uwukan kɛ nfɔnɔ dɛmara anuŋi aye Ubasɛ;</para>
  <para style="q2" vid="MAT 5:10">Abɛ akikɔmɔ kɛ biaga kɛbɔdrɔ nɛ Ubasɛ.<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />ꓛkɔndɔm uyạŋanɛ uyạŋ uye anebɛ ayạŋ datamajɛn, nɛ anebɛ asạri okpo ayinɛ, ayɔm chiem ayinɛ nɛ nfu anɛnɛmạŋ kɛ uwɛ arenɛ anebɛ ateri Ubasɛ ndam.<verse eid="MAT 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 5:12" />Dɔm ɛkɔn naŋa kiniminim, ire kɔlɛnɛ yoyo uyạŋkɛ kɛ dewe dɛbadrayi. Ire nyɔi amɛ asạri anebɛ Ubasɛ iritogɔ uyemi chiemyɛyɛ okpo ayinɛ dirạk.<verse eid="MAT 5:12" /></para>
  <para style="s">Inugɔ Nɛ Ekon</para>
  <para style="r">(<ref loc="MRK 9:50">Mk. 9.50</ref>; <ref loc="LUK 14:34">Lk. 14.34</ref>,<ref loc="LUK 14:35">35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />Abon ayạŋ dunɔnɔ da inugɔ aye ngun diduri. Asi inugɔ ɔkana urɔm irikɔ, ɔkɔ da uwɛ asạd ɔkɔmɔkɛ urɔmɔyɛ isisi ɔkɔmɔ. inugɔ uwɛ iyem irinani, akinɔŋmạŋ aroŋɔ kɛ rɛbɔm ane ajɔgimạŋ nɛ nwun.<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />Abon ayạŋ dunɔnɛ da duyama ayerun ngun diduri. Donɔyɛ abɔi kɛ ikon dewe mạŋ akɛmɛ kurạba.<verse eid="MAT 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 5:15" />Ane nawunɔ kure uwɛ uronɔ ekon kɛ ɛtɔ dirạk ɔbaŋa ɛkpaŋ ubemɛ ekonɔyɛ iyɛ amɛ ikirɔn iyem kɛ etɔ; Asi aronɔnɛ ekon ayạŋ ikisi uwɛ uye ɛtɔ diduri duyama. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />nyɔi amɛ ekon yoyo uwɛ ɔtanɛ dirạk kɛ dure ane, sạŋ abɛ arɔn nfɔnɔ dotomɔ yoyo, aye asewo krewe dɛbad.<verse eid="MAT 5:16" /></para>
  <para style="s">Dɛman Ayaŋ Kuchegi</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />&lt;&lt;Kakɛrɛrun iye am, iwunɛ ndirɔk dɛmanayɛ Mosɛs iyaŋ nɛ bobɛ anebɛ ayemi chiem yayɛ achegi barun. nwu ndirɔk, nwunɛ nwisạdmạŋ ure dana asisi ayemɛ barun.<verse eid="MAT 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 5:18" />Kayinɛrun iyɛ dana dewe nɛ ngun iraimạŋ krure, chiem yayɛ nawunɔ uyạŋanɛ kɛ dɛman ayɛ asisi ayaŋ sạŋ utạma, uremɛ ɔrɛgɛmạŋ, tata kpaikpai anani achegɛ ɛkpaabɛ dana asama ayɔm iyɛ ikiremɛ. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Urenɛ yɔnɔ, one nawunɔyɛ ugbiyenɛ ntotobɔuremɛ ɔrɛgɛ amaŋ, ukpekɛ usạd bembɔŋ abgiyɛ dirạk, one uwɛ uyạŋanɛ da wɔŋ etɔ kɛ kɛbiaga kɛbɔd Ubasɛ. Urenɛ yɔnɔ dirạk, one nawunɔyɛ ɔchɛgɛnɛ kɛ dɛman kɔyaŋ, ukpekɛ uchiemi bembɔŋ da uwɛ achɛŋ ated deman kɔyaŋ, utɔ one uwe, ikiremɛ ɔbɔd kɛ kɛbiaga kɛbɔd Ubasɛ. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />sạŋ ŋemɛwɛ anɛ awu ɛkɛmɛ uwunɔ kuremɛ kɛ dɛyɔgɔbɛ abunɔ ayạŋa kɛbiaga kɛbɔd nɛ ubasɛ, urebom awu ɛyaŋ ekpa yoyo asạd bobɛ Ubasɛ ibuniwɛ asạd, anugi nfɔnɔ dɛmara arugɔ anebɛ achieminɛ ntotobɔnɛ bɛ Farasi.<verse eid="MAT 5:20" /></para>
  <para style="s">Kuchegi Uwɛ Ɔkaŋkama</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />Erikomɔrun da ari yɔmi deweri, iyɛ weŋ one kaŋana; asi aŋana weŋ one akibiwɛ ibaŋa.<verse eid="MAT 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 5:22" />Isai nbun ŋemɛbarun, akama ɛkɔn nɛ wɔŋ akawo akibiwɛ ibaŋa, ategɛ wɔŋ akawo nɛ awu &lt;kabom nawunɔ anim&gt; ǃ akitogɔwɛ afro kɛ don, akataŋ ibaŋa ekpa yoyo; atek wɔŋ akawo iyɛ urenɛ uheri one bom uyed, ayạŋanɛ kɛ iyem ɛyaŋa uwɛ utogɔ ɔta kɛ ekonɔyɛ ayaŋ aye satan.<verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />Urebom ebuni anɔŋ bom nawunɔ akaye Ubasɛ kɛ kpokpɛ ajini deto ayeimạŋ, awi ramawɛ iyɛ ɛkɔ afirɛ nɛ wɔŋ akawo. <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />doŋɔ okpobɛ ɛnɛ akpe ndam awawai akaŋanarun ekpa boni kɔkpama, isai akpe ndam awiye Ubasɛ bobɛ ebunimạŋ kuye. <verse eid="MAT 5:24" /><verse number="25" style="v" sid="MAT 5:25" />Yerɛ kɔkpama nɛ one iyɛrɛ yoyo kiyem aa ɛkanɛ kɛ ɛtɔ ibaŋa aratumi. Asɛgɛmạŋ utogɔwɛ utumi kɛ ɛtɔ ibaŋa ikisɛŋwɛ uye onewɛ utigi ibaŋa, onewɛ utigi ibaŋa oseŋwɛ uye bɛ nkonɔ aka kɔbiwɛ.<verse eid="MAT 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 5:26" />kɛkɛ saŋ ŋemɛwɛ, awu saŋwɛ naŋi tata arɛnɛ kɛmayɛ etumạŋ kpai ɔra.<verse eid="MAT 5:26" /></para>
  <para style="s">Kuchegi Uwɛ Kunemɛ Nɛ Onewɛ Usạdri Ɔban</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />Ekomɔ da arisisi yɔmɔ iyɛ, nɛ wani one kanemɛ.<verse eid="MAT 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 5:28" />asi nbun sạd barun ayenɛrun iyɛ, one nawunɔyɛ ukoninɛ onewani nɛ dirami dana amɛ ibine nɛ amɛ, one uwɛ isisi ine nɛ onewaniwɛ kɛ dɛkɔnduri yɛyɛ.<verse eid="MAT 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 5:29" />ayed iyɛ okpo arạk arạk jɛn yoyo ika koni usạri wɛnɛ agbiɛ kubi kubi nɛ Ubasɛ. Bemɛmạŋ kubi nawunɔ ɛrɔn okpobɛ yɔi. Asi akana akɛme abemɛ jɛn yoyo kokpobɛ, iya aki raŋi jɛn soso uwunɔ alawɔ atumɔ jɛn uwunɔ, ire inim jɛn uwunɔ kutogɔ ariɛ kɛ don Ubasɛ urugɔ ɛkpa diduri kutogɔ aragawɛ kekon.<verse eid="MAT 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 5:30" />Urebom kurumbok yoyo isạdriwɛ agbiɛ Ubasɛ kubi kubi, soŋɔmạŋ alawɔ ire inim awu kɔnaŋiwɛ nɛ mbok kạm urugɔ awu kɛ ekon kuriɛ ɛkpa diduri.<verse eid="MAT 5:30" /></para>
  <para style="s">Kuchegi Uwɛ Ɔban Kɔla</para>
  <para style="r">(<ref loc="MAT 19:9">Mt. 19.9</ref>; <ref loc="MRK 10:11">Mk. 10.11</ref>,<ref loc="MRK 10:12">12</ref>; <ref loc="LUK 16:18">Lk. 16.18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />Arisisi ayɔm iyɛ, &lt;One nawunɔyɛ utegɛnɛ iyɛ amɛ waniyɛyɛ iriban, iyɛ ɔban iraŋ, ɔkɔnɛ one waniyɛ kusɛgɛ ɔbana kɔra kɔŋana kɛ mbɔk.<verse eid="MAT 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 5:32" />Isai nbun ŋemɛ barun iyɛː onerum nawunɔyɛ ɔlawɔnɛ waniyɛyɛ ɔban kɛ bom nawunɔ isạdri urugɔ amɛ kinemi nɛ anerum kɛ debɔm, Onerum uwɛ igbiɛ kugbiɛ uwɛ isạdri one waniyɛ ukusạd bom iyinɛ uwɛ ure amɛ kusạd ukunemi nɛ anerumɔbɛ aka urumwɛwɛ ure.<verse eid="MAT 5:32" /></para>
  <para style="s">Kuchegi Uwɛ Etegɛ Iye Awu Aki Sạd Bom</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />Awu ekomɔ da ariŋemɛ anebɛ ariyạŋ kɛ deweri iyɛ, &lt;Kagbiɛ kɛ dɛmanayɛ ɛyaŋ, sạd bom nawunɔyɛ awu etegɛ iyɛ akisạd aye Ubasɛ. &gt;<verse eid="MAT 5:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 5:34" />Asi isai nbun ŋemɛ barun anɛ, durim nawunɔ kaji uwɛ etegɛ iyɛ awu akisạd bom. dewe katogɔ ajiwɛ durim nawunɔ ire dewɛ urenɛ kpomɔ, kɛbɔd Ubasɛ.<verse eid="MAT 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 5:35" />Dɔchɛ dirạk katogɔ ajiwɛ durim, ire dɔchɛ urenɛ kɛbiaga nwunɔ Ubasɛ; Jɛrusɛlɛm dirạk katogɔ ajiwɛ durim, ire urenɛ don ɛbarayɛ ɔkɔ abɔd akporɔ nɛ abɔd abara. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />deto yoyo katogɔ agiwɛ durim, ire ayed da diŋ icheŋ umiri ubạnawɛ nɛ uvurɔwɛwɛ. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Yerɛ iyɛ urenɛ &lt;nyɔi&gt; urebom ire nyɔi tek iyɛ nyɔi &lt;ure&gt; urebom ikana nyɔi ure. Durim urạk urạk kuji uwunɛ kɛ One iyinɛ. <verse eid="MAT 5:37" /><verse number="38" style="v" sid="MAT 5:38" />Ekomɔ da ariyɔmɔ iyɛ, urenɛ &lt;jɛn nɛ jɛn, &gt; daraŋ nɛ daraŋ.<verse eid="MAT 5:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 5:39" />Isai ŋemi barunɔnɛ anɛ; One nawunɔyɛ usạriwɛ bom iyinɛ, awu bom iyinɛ katogɔ arɛnɛ ayemạŋ. One nawunɔ ɔyɛmɛwɛ kibai kɛ mbem uwunɔ woŋɔ mbem uwaran ayemạŋ ɔkpɔgɔ ɔyɛm dirạk.<verse eid="MAT 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 5:40" />One nawunɔ ububu utogɔwɛ ɔta ibaŋa iyɛ amɛ ibuninɛ ɔnawɛ dɔbara ɛkpa ɛkɔnɔ sɛŋ dɔbara uwɛ ubemanɛ uwɛ ɛkpa ɔkɔnɔ ayemạŋ dirạk<verse eid="MAT 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 5:41" />Urebom One rekpo iyamwɛ kikam ukpeiwɛ etogɔ, utekwɛ achɛŋ nɛ amɛ kinomɔ ɛsara uwunɔ, awu chɛŋ nɛ amɛ kinomɔ ɛsara awumɔ nɛ etogɔ yɛyɛ dirạk.<verse eid="MAT 5:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 5:42" />One usisiwɛ bom, yemạŋ bobɛ i; One utegɛwɛ abɔmạŋ bombobo bɔmạŋ. <verse eid="MAT 5:42" /><verse number="43" style="v" sid="MAT 5:43" />&lt;&lt;Ekomɔ da ariyɔmɔ iyɛ sạŋ awu&lt; abam onewɛ ɔbamwɛ, ayɛrɛ onewɛ ɔyɛrɛwɛ. &gt; <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Isai ntegɛwɛnɛ; sạŋ awu abam one iyɛrɛ yoyo, aŋanawɛ nfɔnɔ durim aye anebɛ asạriwɛ okpo ayinɛ.<verse eid="MAT 5:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 5:45" />Sạŋ aremɛrun bɔŋ ayerun asewoni kɛ rewe. ire amɛ usạrinɛ ewe uyei nfɔnɔ ane nɛ ane ayinɛ duyama , usạd itou utou uye nfɔnɔ ane nɛ ane ayinɛ dirạk<verse eid="MAT 5:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 5:46" />Obuwɛ usạd Ubasɛ uyewɛ dɛrɛna kɛ bobɛ awu esạri urebom awu ɛbam anebɛ abamwɛ mạŋchen? Ire anebɛ bɛkɛbɔdrɔ ayaŋ apkạni akpogɔ kɛbɔdrɔ asạrinɛ nyɔi dirạk. <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Urebom awu ɛyɔmi chiem nɛ ayibobo mạŋchen, arɛni bem bɔŋbobo mạŋchen, mạn nfɔnɔbom awu ɛsạrinɛ arugɔ bem ubaran? ire anebɛ akana Ubasɛ one uyed abam kɛ ayi ubɛbɛ nɛ bɛm bɔŋ ubɛbɛ dirạk.<verse eid="MAT 5:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 5:48" />Awu akɔnɛ anebɛ akanawɛ One ɔbam kɔbam, ɛnɛ amɛ awu uwɛ ayạŋanɛ ibeigi da asewo iyạŋ.<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">Kuchegi Da Asạdri Ekporɔ</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />yenɛ da esạdri nfɔnɔ dotomɔ yoyo kɛ dure ane, nạŋ uyạŋa da awu asạri okpobɛ sạŋ ane arɔn iyɛ awu asạrikɛ nfɔnɔbom ayei ane, uyạŋ nyɔi, awu sạŋ dɛrɛnɛ anɔŋɔ kɛ mbɔk Asewo uwɛ uyạŋanɛ krewe. <verse eid="MAT 6:1" /><verse number="2" style="v" sid="MAT 6:2" />&lt;&lt;Urebobɛ ɛyạŋ onewɛ ɔkabom ɔkɔ bomnawunɔ, eyi ka wunɔ, dana bɛ nkariaba ayạŋanɛ kɛ ɛtɔ ɛrɛri nɛ kɛ iyema don ntoba, sạŋ ane akarabɛŋ. Kreŋenɛ nbun nsạd barun ayenɛrun iyɛ ane ubɛ nyɔi asisi anɔŋ dɛrɛnɛ ubɛbɛ.<verse eid="MAT 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 6:3" />Asi ayạŋ Onewɛ ɔka bom ɔkɔ bom nawunɔ, kasạri kpabɔk yoyo uyenɛ bobɛ krumbɔk yoyo inoyɔ kusạd.<verse eid="MAT 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 6:4" />Sạŋ kuye nawunɔ ɛsạsạdri uyạŋa kɛ kirạmi. Ԑnɛ amɛ asewowɛ ukoninɛ bombɛ ɛsạri kɛ kirạmi ɔrɛnanɛ uyewɛ.<verse eid="MAT 6:4" /></para>
  <para style="s">Kuchegi Uwɛ Dulim Ɔkɔŋana</para>
  <para style="r">(<ref loc="LUK 11:2-4">Lk. 11.2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />Utumi kubisɛ uwɛ aŋanawɛ durim aye Ubasɛ, kasạri da bɛ nkaria. Ire abɛ abaminɛ kɔbai kɛ ɛtɔ ɛrɛri nɛ kɛ rɛbɔm ikisi ane uwɛ arɔnbɛŋ aŋanibɛŋ durim. kreŋenɛ sạŋ ŋemɛ barun ane ubɛ asisi anɔŋɔ dɛrɛnɛ ubɛbɛ. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Asi ategɛ aŋananɛ durim, diɛ kɛ ɛbɔd ɛkɔn yoyo, amerɛ ikpegi ɛtɔyo , aŋananɛ durim aye asewo, uwɛ One ikana ɔkɛmɛ kɔrɔn kajɛn. Ԑnɛ amɛ asewo, uwɛ ukoninɛ bobɛ awu ɛsạri kirạmi ɔrɛnanɛ uyewɛ.<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />Kɛkɛ ategɛ iyɛ aŋanawɛ durim, doŋɔ chiem dɛyama da anebɛ akana Ubasɛ one uyed, ire kɛ dirami ubɛbɛ urenɛ iyɛ uwunɛ kɛ ohem dayama isai Ubasɛ ukomɔmạŋ<verse eid="MAT 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 6:8" />Da abe kayạŋa, ire asewo isisi iyed bobɛ awu ebuni asimạŋ awu iyɛ akayạŋa aŋemɛmạŋ.<verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />Kɛkɛ da ebuni aŋana baruŋ durim aaː</para>
  <para style="q1" vid="MAT 6:9">Asewori kɛ rewe,</para>
  <para style="q2" vid="MAT 6:9">dɛbad ɔkɔmɔ dokom yoyo.<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />Sạŋ kɛbɔd yoyo uwukan,</para>
  <para style="q2" vid="MAT 6:10">sạŋ uremɛ da awu ebuni urema, aa kɛ rɔchɛ da ire kɛ rewe.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Ye bara kɛ rewe ya kokpoji uwɛ dujii dewe dewe.<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />kaiwɛ aye bara kugbiɛ yori,</para>
  <para style="q2" vid="MAT 6:12">da abod dɔsama dɔkaibara duye anebɛ agbiɛ bara.<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />Bara kasɛgɛ dugbiɛ urebom ahɛgi bara, asi dawɔ bara kɛ bom iyinɛ nawunɔ.<verse eid="MAT 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />Ire awu akaiwɛ aye ane kɛ kuugbiɛ bɛbɛ, asewo kɛ rewe iki kaimạŋ uyewɛ dirạk. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Asi ayim kɔkaiwɛ aye anebɛ agbiɛwɛ, asewo kɛ rewe sạŋmạŋ ɔkagi uyewɛ dirạk.<verse eid="MAT 6:15" /></para>
  <para style="s">Kuchegi Uwɛ Dɔwɔ Kɔbiaga</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />&lt;&lt; Urebom ɛyạŋ kɛ durim utu kɛkpai kɔŋani, dure kayạŋa ubian ubian da bɛ nkaria, ire bɛ nkaria awɔnɔnɛ dure ayạŋ sạŋ ane ayenɛ iyɛ abɛ ayạŋanɛ kɛ durim utu kɛkpai kɔŋana, urere nyɔi ɔnaninɛ iyɛ abɛ anɔŋɔ dɛrɛnɛ ubɛbɛ aa kɛ rɔchɛ.<verse eid="MAT 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 6:17" />Asi awu ayạŋ kɛ durim utu kɛkpai kɔŋana, sagiwɛ dure akɔkwɛ ɛmia,<verse eid="MAT 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 6:18" />Sạŋ ane awa kuyenɛ iyɛ awu aŋaniwɛ durim utu kɛkpai, asi asewo uwɛ uyạŋanɛ kɛ rewe mạŋchen, uwɛ ane aka one ɔrɔn. nɛ asewowɛ, ukoninɛ bom kirạmi, iki rɛnɛwɛ.<verse eid="MAT 6:18" /></para>
  <para style="s">Bom Kɔkɔmɔ Krewe</para>
  <para style="r">(<ref loc="LUK 12:33">Lk. 12.33</ref>,<ref loc="LUK 12:34">34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />Doŋɔ okpo dɔchɛ baa kɔkɔmɔ akuni dɛyama aa kɛ ngunaya, ikisi ɔrɔrɔgɔ nɛ kiheri irɔgi okpo, nɛ ikisi ayạune akpugi ɛtɔ ayugi okpo ane.<verse eid="MAT 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 6:20" />Asi kɔmɔ okpo akuni ayei ɛkpayo kɛ rewe, ikisi ɔrɔrɔgɔ nɛ kiheri ika ɔkɛmɛ ɔrɔkmạŋ, nɛ ikisi ayạune uwɛ akana one ɔkɛmɛ akpawɔ ayạubom.<verse eid="MAT 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 6:21" />Ire ɛkɔn yoyo kpai uyạŋanɛ ikisi okpobɛ ɛkɔ iyạŋ.<verse eid="MAT 6:21" /></para>
  <para style="s">Duyama Ɛkpa One</para>
  <para style="r">(<ref loc="LUK 11:34-36">Lk. 11.34-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />&lt;&lt;Jɛn uyạŋanɛ da duyama uye ɛkpa one. urebom jɛn yoyo inim anɛ, iya ɛkpayo kpai ɔtaianɛ da ekon.<verse eid="MAT 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 6:23" />Asi jɛn yoyo ɔkaka unim, ɛkpayo kpai uyugɔnɛ kɛ kirạmi. urebom ekonɔnɛ uyạŋ nawu ire kirạmi, nạn kirạmi uwɛ ɔyạŋi ukukpe.<verse eid="MAT 6:23" /></para>
  <para style="s">Ubasɛ Nɛ Okpo Kɔkɔmɔ</para>
  <para style="r">(<ref loc="LUK 16:13">Lk. 16.13</ref>; <ref loc="LUK 12:22-31">12.22-31</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />One kure uwɛ ɔkɛmɛ usạd dotomɔ uye ɔsɛ ɛtɔ aumɔ kubi uwunɔwɛː keheŋenɛ urenɛ iyɛ amɛ iki yɛrɛ uwunɔ ɔbam uwunɔ; aki jinɛ deto aye one uwunɔ akpori kotoŋ nɛ uwunɔ. Ubasɛ nɛ akpogɔ akɛmɛ deto kujinɛ aye kubi uwunɔwɛ.<verse eid="MAT 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />Amɛ usạrinɛ ntekɛnɛ anɛː ɛkpayo kajuŋɔ kɛ bobɛ awu uwɛ aji nɛ uwɛ awu awɔ atogɔ anugi ekpen, iyɛ aka yɔm bobɛ awu uwɛ aŋaniwɛ kɛ ɛkpa. ire ategɛ iyɛ ayɔm, ndɛ ekpen urugɔ kokpoji? Ԑkpa dirạk ndɛ urugɔ dɔbara?<verse eid="MAT 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 6:26" />Koni danɔn kɛ reweː one nsam jɛn ukonɔ, one okpo ɔtɔgɔ akuni kɛ dɔhan; asi asewoni kɛ rewe uyeibɛŋ kokpojiǃ Awu ndɛ ɛbara ɛya arugɔ kɔnɔn kɛ rewe? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Mạn one ɔkɛmɛ ekpen kuŋi ɔsara urebom amɛ juŋi dɛkɔnduri yɛyɛ?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />&lt;&lt;Obe ejuŋi ɛkpayo kɛ dɔbara uwɛ aŋaniwɛ? Koni da kɛwa animɛ amiri abariː one dotomɔ usạri, one dɔbara ujumi ayei ɛkpa ubɛbɛ.<verse eid="MAT 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 6:29" />Asi ntekɛnɛ barunɔnɛ anɛ ɔbɔdrɔ yɛ aweninɛ Solomon nɛ okpobɛ ikɔnɛ kpai dɔbara uwɛ unim da kɛwa bana.<verse eid="MAT 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 6:30" />Ubasɛ ɔŋaninɛ kɔnɔba kɛwa animaba---kɛwa uwɛ akirɔnmạŋ ichiŋ ika mạŋ arirɔn, akimimạŋ kɛ ekon. Awu akɔnɛ dirami iyɛ amɛ sạŋwɛ dɔbara ɔkɛmɛ kuye aŋaniwɛ? mạn kinegɛ ɛrɛgɛ iya awu ɛkɔ. <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />&lt;&lt;Kɛkɛ ɛkpayo kajuŋiː &lt;ndɛ kokpoji uwɛ nji uwukan? Nɛ itugɔ nɛ dɔbara uwɛ ŋaninɛ? <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />&lt;Okpoba amɛ anebɛ aka Ubasɛ one uyed abuninɛ ayogi ekon&gt; Asɛwoni kɛ rewe iyed iyɛ abon ebunɔrun okpoba kpai.<verse eid="MAT 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 6:33" />Sạŋ ŋemɛwɛ akɔnɛ ɛkɔn kɔŋani kɛ okpo kpai ɛyɛ ɔkɔ kusạd nɛ kpomɔ kɛbɔd Ubasɛ nɛ okpobɛ ibuniwɛ asạd, amɛ ikiyewɛ okpobɛ awu ebuni kpai kɛ ngun ɔya. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Awu ɛkpayo kajuŋɔ dana ika uwɛ uyạŋa; ikari ikikɔmɔ afirɛ ɛkpayɛ. kanɔgɔ afirɛ uwɛ ichiŋa akaŋana kɛ afirɛ uwɛ ika.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">Bem Ibaŋa Kubi</para>
  <para style="r">(<ref loc="LUK 6:37">Lk. 6.37</ref>,<ref loc="LUK 6:38">38</ref>,<ref loc="LUK 6:41">41</ref>,<ref loc="LUK 6:42">42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />&lt;&lt; Bem bɔŋ bobo ibaŋa kabi, sạŋ ubasɛ ɔwawɛ ibaŋa kubi dirạk.<verse eid="MAT 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 7:2" />Ire Ubasɛ ikibiwɛ ibaŋa da awu ebibem ibaŋa, akibiwɛ ibaŋa ibeŋi da awu abibem ibaŋa.<verse eid="MAT 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3" />Obusạri awu akoni ujiri wɔŋɔwɛ uyạŋ wɔŋ akawo&gt; kajɛn, awu ayina iyɛ kese kạm usegɛwɛkɛ kajɛn?<verse eid="MAT 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 7:4" />Obu usạri awu atek wɔŋ akawo, &lt;ɔrawɔmạŋ ujiri wɔŋɔwɛ uyạŋmạŋ kajɛn, &gt; uwɛ awu atumkɛ kese kạm kajɛn?<verse eid="MAT 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 7:5" />Abon bɛ nkariaǃ chiemi iyem alawɔnɛ kese kạm kajɛn uwowo, sạŋ arɔn iyem kinim inim alawɔ wɔŋ akawo ujiri uwɛ kajɛn <verse eid="MAT 7:5" /><verse number="6" style="v" sid="MAT 7:6" />&lt;&lt;Bobɛ asagi unim kanɔgɔ aye ɔbia nɛ akuk. One sạŋ ɔbaŋa iyɛ awu asạri bɛŋɛnɛ nfɔnɔbom, aki woŋɔbɛŋ ano mban nɛ awu arumiwɛ kinim inim.<verse eid="MAT 7:6" /></para>
  <para style="s">Bɔu, Bun, Mud</para>
  <para style="r">(<ref loc="LUK 11:9-13">Lk. 11.9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />&lt;&lt;Si, akiyewɛ; bun, akirɔnɔ; mud, akimenɛ ikpegi ɛtɔ ayewɛ;<verse eid="MAT 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 7:8" />Ire anebɛ asi kpai akiyebɛŋ, onewɛ ubunɔ dirạk ikirɔn, nɛ anebɛ amudri ikpegi akimenɛ ayebɛŋ.<verse eid="MAT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9" />Ikɔ one uyạŋ aa uwɛ ure ɔsɛ awɔŋ, uwɛ uye wɔŋwɛ kɔtan urebom isimạŋ okpo dakạkra uji?<verse eid="MAT 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 7:10" />kạn ikɔ one uwɛ wɔŋ wɛwɛ usimạŋ kibri amɛ uyemạŋ yɔk?<verse eid="MAT 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 7:11" />Urebom da eyinɛrunɔnɛ iya, ɔbaribarun bɔŋ boni nfɔnɔbom kusạd ayerun. de asewoni kerewe uwɛ ɔkana barun uyạŋ bom nawunɔ esisimạŋ dun.<verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />&lt;&lt;sạd aye ane da ebuni asạd ayewɛ; kɛ da ntotobɔMoziz inani ee, nɛ anebɛ ayemi chiem Ubasɛ ari chegi.<verse eid="MAT 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />&lt;&lt; Chɛŋdun kɛ iyem wɔŋ ɛsarayɛ utoginɛ one iyem ukutumi kɛ ikpegi don Ubasɛ, ire iyem uwakạn ɔbaranɛ utoginɛ ane ɔraimạŋ kɛ ekon, iyem uwɛ amɛ ane dɛyama abaminɛ kɔchɛŋ.<verse eid="MAT 7:13" /></para>
  <para style="s">Kese Nɛ Da Wama Yɛyɛ</para>
  <para style="r">(<ref loc="LUK 6:43">Lk. 6.43</ref>,<ref loc="LUK 6:44">44</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 7:14" />Asi ikpegi yɛ utogi one iyem ekpenɛ ɔmamanɛ ɔmama ukpekɛ ɔsarakɛ uyoŋɔkɛ kɔchɛŋ, usạd nyɔi anebɛ ayerɛ ɛɛ kɔchɛŋ one ɔyama.<verse eid="MAT 7:14" /></para>
  <para style="s">Kese Nɛ Dawama Yɛyɛ</para>
  <para style="r">(<ref loc="LUK 6:43">Lk. 6.43</ref>,<ref loc="LUK 6:44">44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />&lt;&lt;Koibarun nɛ anebɛ achiɛginɛ ayemi nfu, iyɛ abɛ are anebɛ Ubasɛ itogɔ ɔyɔmi chiem uyei ane; arɔn da achɛŋi, urema ajɔgɔ ɔnai ube, asi krɛkɔnduri ubɛbɛ, ayạŋanɛ da ɔbia anɔgɔ kulam mkpa akạmabɛŋ.<verse eid="MAT 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 7:16" />Aki yenɛbɛŋ uwukan da achɛŋ asạri okpo nɛ da achɛŋ anugi dɛmara ubɛbɛ. kạn are ose dawama nfɔnɔ kạn de dawama ayina.<verse eid="MAT 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 7:17" />Nfɔnɔ kese uwuminɛ nfɔnɔ dawama, kese iyinɛ uwumi dawama ayiaga. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Nfɔnɔ kese asạd amạŋ dawama ayinɛ ɔwam, kese ayiaga asạd amạŋ dawama nfɔnɔ ɔwam dirạk.<verse eid="MAT 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 7:19" />Kese nawunɔyɛ ɔkanɛ dawama nfɔnɔ ɔkɔ aki sogɔmạŋ akara kɛ ekon.<verse eid="MAT 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 7:20" />Kɛkɛ ɛnɛ amɛ uwɛ ayenạnɛ anɛbɛ ayemi chiem Ubasɛ kɛ nfu, uwukan kɛ okpobɛ asạri.<verse eid="MAT 7:20" /></para>
  <para style="s">Aam Wɛ Nyed</para>
  <para style="r">(<ref loc="LUK 13:25-27">Lk. 13.25-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />&lt;&lt;Ane kpai ure aweninɛ Ͻbɔd, Ͻbɔd uwɛ ariɛ kakpomɔ kɛbɔdrɔ yam kɛ rewe, urenɛ anebɛnɛ asạrinɛ bobɛ asɛm ibunibɛŋ asạd bɛŋchen.<verse eid="MAT 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 7:22" />Kubiyɛ dewe ibaŋa uwɛ utuminɛ, dɛyama aki teknɛ, &lt;Ͻbɔd, Ͻbɔdǃ kɛ dokom yoyo deriyemɛ chiem Ubasɛ, kɛ dokom yoyo deriwạm kɛwaŋ ayinɛ kɛ ekpa ane, dusạd okpo abaraǃ&gt;<verse eid="MAT 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 7:23" />Ԑnɛ amɛ uwɛ ntekbɛŋɛnɛ, &lt;anɛ am bɛŋ nyed. Dɔŋ arabarun abon ane ayinɛ bana. &gt;<verse eid="MAT 7:23" /></para>
  <para style="s">Ane Awumɔ Ari Bɔwi Ɛtɔ</para>
  <para style="r">(<ref loc="LUK 6:47-49">Lk. 6.47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />&lt;&lt;Sạŋ ŋemabarun, one nawunɔ okomɔnɛ chiem yam usạd bobɛ nyɔmɔ, uyạŋanɛ da onewɛ ɔkɔ dukpega ɔbɔu ɛtɔyɛyɛ kɔtan. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Itou uwunɛ, okpa uyugɔ ubema kpom kpai, kiwun uwega kɛwan ugbạni ɛtɔyɛ. Asi ɛtɔ ɔtɔ ire abɔi mạŋanɛ kɔtan.<verse eid="MAT 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 7:26" />&lt;&lt;Asi one nawunɔyɛ ukomɔnɔ chiem yam uyim kusạd, uyạŋanɛ da onewɛ ɔka bom uyed ɔkɔbɔu ɛtɔ kɛ amvun.<verse eid="MAT 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 7:27" />Itou uwunɛ okpa uyugɔ kpom kpai, kiwun uwega ugbạni kɛ etɔyɛ, ɛtɔyɛ ɔtɔ. Kɔtɔyɛyɛ ɔyaŋinɛ usạd kɛwɔd.<verse eid="MAT 7:27" /></para>
  <para style="s">Ikɔm Jizɔz</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Kubisɛ Jizɔz iyɔmɔnɛ chiemaba kpai ɔra, ɛkpa iribe anebɛ kpai da ichɛŋ uchiemi bom.<verse eid="MAT 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 7:29" />Da amɛ ichɛŋ uchiemi bom ikami mạŋ nɛ anebɛ achiemi ntotobɔmosis. Amɛ uchieminɛ bom da onewɛ ɔkɛmɛ bobɛ amɛ iyɔmi kusạd.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s" />
  <para style="s">Jizɔz ubɔk onerum ɔkɔ Kɛkpacherɛ</para>
  <para style="r">(<ref loc="MRK 1:40-45">Mk. 1.40-45</ref>; <ref loc="LUK 5:12-16">Lk. 5.12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Kubisɛ Jizɔz ibạnɛ kɛ ikon, dɛyɔgɔ ari terimạn ndam <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />One wɛ ɔmayamạn uyum kɛkpacherɛ iwu kame, ukpạk ndu kɛdure yɛyɛ, utek, &lt;&lt;ata abubunɔ abri sạdri nɛ ndɔrɔ&gt;&gt; <verse eid="MAT 8:2" /><verse number="3" style="v" sid="MAT 8:3" />Jizɔz ɔchɛŋ uku wạmemạŋ. Jizɔz utek dibunɔ&lt;&lt;dɔrɔ&gt;&gt;kubrukpun one wɛ ɛkpa ukporimạn.<verse eid="MAT 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 8:4" />Jizɔz utekmạn, &lt;&lt;komɔǃ one nawunɔ kayemɛ, dɔŋ kɛ one ubasɛ ɔkɔ ragi wɛ, sạŋ uchegɛ ane iyɛ ɛkpa ikpori wɛ, sạd efinɛ yɛ mozɛz iyạŋ dɛman&gt;&gt;<verse eid="MAT 8:4" /></para>
  <para style="s">Jizɔz Ubok Wɔŋɛtɔ One Nkonɔ Roman</para>
  <para style="r">(<ref loc="LUK 7:1-10">Lk. 7.1-10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Kubisɛ Jizɔz iriɛ nɛ capanum, one nkon roman utakmạn iri ŋana mbɔk uyemạm. <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />&lt;&lt;Ata, wɔŋɛtɔ nyam ɛkpa iyinɛmạn tata uyinkɛ kɛ ɛtɔ, ɔkɛme kɔchɛŋ dutugɔ iseyɛmạŋ tata, &gt;&gt;<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />Jizɔz utek&lt;&lt; iki ranɛ nka sạd ɛkpa ukporimạŋ&gt;&gt;<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />One nkon ɛyɛ ɔbɔnɔ&lt;&lt; nyɔi ure ata&gt;&gt;aam nbɔgi awukan kɛtɔ nyam, ye dɛman wɔŋ ɛtɔ nyam iki komɔ ɛkpa kporɔ. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Aam ndenɛ wɔŋɛtɔ one kakpom dotomɔ, dikɔ bɛ dekpo bɔŋ asạri dotomɔ nɛ aam, ntegɛnɛ one uwa, &lt;Dɔŋǃ &gt; ɔramạŋ, ntek&lt; Okeǃ &gt; uwukan, nye utạkyam dɛman, anɛ sạd i &lt;Iyaǃ&gt; amɛ usạd &gt;&gt; <verse eid="MAT 8:9" /><verse number="10" style="v" sid="MAT 8:10" />Jizɔz ukomonɛ chiem one nkon ɛkpa ubemạn utek ane bɛ atedrimạn adam, &lt;&lt; nbuninɛ nsạd wɛ ayenɛ, one ndarɔn kɛ izrɛl ɔkɔ kuneŋa iya <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Nbuninɛ ayenɛ iyɛ anɛ akiwukand kɛ kpabɔk nɛ kurubɔk ari biaga nɛ ɛbraham, aAizik nɛ Jɛkɔb agi okpogi kɛ kɛbɔd ubasɛ. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Ane bɛ abiyạŋ kɛ kɛbɔd ubasɛ aki kara bɛŋ kɛ kirạmi, uwɛ abuni ato ajibɛŋ daraŋ <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />Jizɔz utek one nkon &lt;&lt;dɔŋ aya kɛtɔ, iki remɛ da kuneŋɛ yoyo ire. &gt;&gt;wɔŋɛtɔ one nkon iri komɔ ɛkpa kporɔ kubrukpun.<verse eid="MAT 8:13" /></para>
  <para style="s">Jizɔz Ubok Ane Dɛyama</para>
  <para style="r">(<ref loc="MRK 1:29-34">Mk. 1.29-34</ref>; <ref loc="LUK 4:38-41">Lk. 4.38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Jizɔz ɔramạŋ kɛtɔ Pita, ɛnɛ ɔrɔn ɔkawani Pita da kɛkami isạdri mạŋ.<verse eid="MAT 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 8:15" />Jizɔz uwạmɛmạŋ kambɔk kɛkami urogɔmạŋ, ɔka wani pita okaimạŋ ɔba ɔba uyebɛŋ kokpoji. <verse eid="MAT 8:15" /><verse number="16" style="v" sid="MAT 8:16" />Kiriɛ utuminɛ ane abɛnɛ anebɛ akɔ kɛwaŋ iyinɛ iriyɛ Jizɔz. Jizɔz uwạm okpo ayinɛ bɛ kpai nɛ chiem usạd ane bɛ amayabɛng akomɔ ekpakporɔ <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Jizɔz usạri nɛ okpo ba sạŋ ane anɔng chiem one wɛ uhemi dɛman ubasɛ Aizaya kɛrehenhenɛ;&lt;&lt;Jizɔz inɔngɔ uyum yori utogɔ okpo ayinɛ yori ɔya&gt;&gt;<verse eid="MAT 8:17" /></para>
  <para style="s">Aki Yạŋɛ Ane Uwɛ Ated Jizɔz Ndam</para>
  <para style="r">(<ref loc="LUK 9:57-62">Lk. 9.57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Kubisɛ Jizɔz irɔn ɛnɛ dɛyɔgɔ bɛ awogɔ mạn, uye dɛman bɔŋɛtɔ yɛyɛ arabɛng kɔ ɔkpa kɛtama kwaŋ uran. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />One wɛ uchiemi dɛman uwukan utek Jizɔz. &lt;&lt;one wɛ uchiemi, &gt;&gt;&lt;&lt; aam diba kanwun awu ndam kuted dɔta ikạmisi ebuni kɔta. &gt;&gt; <verse eid="MAT 8:19" /><verse number="20" style="v" sid="MAT 8:20" />Jizɔz ɔbɔnɔmạŋ&lt;&lt; osen bɔŋ akɔ dama, danɔn akɔ dɛkakari. wɔŋ ubasɛ kpom kinemɛ ɔkɔ. &gt;&gt; <verse eid="MAT 8:20" /><verse number="21" style="v" sid="MAT 8:21" />Onerum urạgạrag, uwɛ ure wɔŋ ɛtɔ Jizɔz, utɛk, &lt;&lt;ata yenɛ ikɔm nka ni asɛm&gt;&gt; <verse eid="MAT 8:21" /><verse number="22" style="v" sid="MAT 8:22" />Jizɔz utekmạn &lt;&lt;ted nɛ ndam, &gt;&gt;sɛŋ aburi ani ɛkpa bɛbɛ.<verse eid="MAT 8:22" /></para>
  <para style="s">Jizɔz ɔhɔgɔ Kɛwan</para>
  <para style="r">(<ref loc="MRK 4:35-41">Mk. 4.35-41</ref>; <ref loc="LUK 8:22-25">Lk. 8.22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Jizɔz ɔriɛ kokpok nɛ bɔŋ ɛtɔ yɛyɛ <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Kubrukpun ɛyɛ kɛwan ɔyɛm okpa kɛtama yɛ kokpok uyạŋɛ kɛ afirɛ uwɛ lamamạŋ. Jizɔz ɔrau kɛ <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Bɔŋ ɛtɔ bɛbɛ aka yigɛmạŋ, atek chegɛ bara iyem ɔbɔd, deki bɛ<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />Jizɔz ɔbɔu bɛn obo udigɛ barun ɛkpen?, Abon bɛ kuneŋɛ bɔŋ ɔba, ɔkaimạŋ uye dɛman kɛwan nɛ kiwun ɔchɛbɛ, kpom kpai ɔhɔgɔ<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />Ane kpai ɛkpa ubebɛŋ, abɔu&lt;&lt; bare onewa?&gt;&gt;&lt;&lt; Uwɛ kiwun nɛ kiwegi akomimạŋǃ &gt;&gt;<verse eid="MAT 8:27" /></para>
  <para style="s">Jizɔz Ubok Anerum Awumɔ Akɔ Kuron Iyinɛ</para>
  <para style="r">(<ref loc="MRK 5:1-20">Mk. 5.1-20</ref>; <ref loc="LUK 8:26-39">Lk. 8.26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Jizɔz utuminɛ kɛ kpom Gadara kɔkpa kɛtama kwan uran, usei ane awumɔ anugi kɛbiaga aburi. ane awumɔ yɛ akɔ kɛwaŋ iyinɛ atɔŋi ɛkɔn ane animinɛ kiyem ɛyɛ kutạm <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Arɔn ɛnɛ Jizɔz arod, obo ɛbuni aa wɔŋ ubasɛ, ɛwu bara dutugɔ kuye isai kubi iwu tumi <verse eid="MAT 8:29" /><verse number="30" style="v" sid="MAT 8:30" />Kpokpɛ ibaŋimạŋ nɛ ikạm akuk ajiɛ <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Kuron ayinɛ bɛ aren Jizɔz, abubunɔ awạm bara wạm bara aŋana kɛ kpom akuk bakạn <verse eid="MAT 8:31" /><verse number="32" style="v" sid="MAT 8:32" />Jizɔz utek bɛŋ&lt;&lt; Dɔŋ&gt;&gt;, abɛ arabɛŋ aka riɛ kɛ akuk kɛkpa. akuk bɛ kpai amɛdbɛŋ aka ba ki kon ɔkpa katama atɔ ariɛ kɔkpa awɔ mạm. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />One wɛ ukoyɔ akuk ɔmạdmạŋ ɔramạŋ kɛ dondɛbara uku hema bobu useyɛ ane nɛ kɛwaŋ iyinɛ. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Ane dondɛbara awukan ari sei Jizɔz , aren mạŋ Jizɔz sạŋ uroŋɔ dɛraŋi bɛbɛ.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s" />
  <para style="s">Jizɔz ubok Onerum ɛyɛ ɔmiɛgi</para>
  <para style="r">(<ref loc="MRK 2:1-12">Mk. 2.1-12</ref>; <ref loc="LUK 5:17-26">Lk. 5.17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Jizɔz ɔriɛ kokpok ɔwari kɛ ɔkpakɛtama ɔya kɛ don yɛyɛ <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Ane atogɔ one wɛ amiɛgi ari yemạŋ, anegɛmạŋ kɛ nkpanta. kubisɛ Jizɔz irɔnɔnɛ da kuneŋɛ bɛbɛ ibara, Jizɔz utek one wɛ ɔmiɛginɛ &lt;&lt;Komɔ ɛkpakporɔ di kaginɛ nye okpo ayinɛ yoyo. &gt;&gt; <verse eid="MAT 9:2" /><verse number="3" style="v" sid="MAT 9:3" />Ane arạgarạg bɛ achiemi dɛman ayɔm nɛ bem, &lt;&lt;Ata wa ɔyɔminɛ chiemɛ datama jɛnɛǃ&gt;&gt; <verse eid="MAT 9:3" /><verse number="4" style="v" sid="MAT 9:4" />Jizɔz iyed dirami bɛbɛ, Jizɔz utek, &lt;&lt;obo ɛkɔduŋ dirami ayinɛ uba dɛkɔnduri? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Ikpama kutek, &lt;Di kaginɛ nye okpo ayinɛ bobo, &gt;&lt;ikpama uwu kutek one yɔ miɛgi kaiwɛ achɛŋ&gt;&gt;? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Nki chegɛ barun iyɛ wɔŋ one ikɔ ikɔm kɛ dɔchɛ one kɔkagi uye uwɛ isạdri okpo ayinɛ. &gt;&gt;Jizɔz utek one wɛ ɔmiɛgi kaiwɛ bɛnɛ nkpanta yoyo ba ɔba aya kɛtɔǃ &gt;&gt;<verse eid="MAT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7" />Atawɛ ɔkaimạŋ ɔba ɔchaŋ ɔya kɛtɔ. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />kubisɛ ane arɔn ɛnɛ bobɛ jizɔz isạdri kɛwɔd iyam bɛŋ, asama ubasɛ kuwɛ iyạŋ ɛnɛ one utɔ ikɔm uwɛ.<verse eid="MAT 9:8" /></para>
  <para style="s">Jizɔz Uyed Matiu</para>
  <para style="r">(<ref loc="MRK 2:13-17">Mk. 2.13-17</ref>; <ref loc="LUK 5:27-32">Lk. 5.27-32</ref>)</para>
  <para style="p" />
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Jizɔz uroŋɔ kpokpɛ, kubise ichɛŋinɛ mạŋchen, Jizɔz ɔrɔn Matiu one wɛ ɔnɔŋi akpogɔ keweyɛ ɔbiaikɛ kɛtɔ keweyɛ. Jizɔz utekmạŋ ted nɛ ndam. &gt;&gt;</para>
  <para style="p" vid="MAT 9:9">Matiu ɔkaimạŋ utedmạŋ ndam<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Kubisɛ Jizɔz ijiɛnɛ okpoji kɛtɔ Matiu, ane bɛ anɔŋi akpogɔ keweyɛ nɛ ane bɛ aka one ɔnɔŋ da bɔm ari wu ariji okpo kɛnɛnɛ nɛ Jizɔz. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Ane bɛ Farɛsis arɔnɔnɛ abɔu bɔŋɛtɔ bɛbɛ, &lt;&lt;obo usạri asewo ɛtɔ uji okpoji nɛ ane uba?&gt;&gt; <verse eid="MAT 9:11" /><verse number="12" style="v" sid="MAT 9:12" />Jizɔz ikomɔ bobɛ ayɔmi uted, &lt;&lt;Ane bɛ ɛkpa ika uyinɛ one dibogɔ one ubunɔ, ubɛ amayabɛŋ abɛ abuninɛ one dibogɔ. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Dɔŋ ka nyɔŋɔ dun kɛ kusɛgɛ ubasɛ bobɛ iba uyeː mbuninɛ dutugɔ , efin kusạd ure mbuni. nwu idiyed bɛ dɛbad, nwunɛ nye ubɛ aka one ɔnɔŋ kɛ bom. &gt;&gt;<verse eid="MAT 9:13" /></para>
  <para style="s">Dɛbɔwɔ Yɛ Uwu Kɛdɔwɔ Kɔbiaga</para>
  <para style="r">(<ref loc="MRK 2:18-22">Mk. 2.18-22</ref>; <ref loc="LUK 5:33-39">Lk. 5.33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Ane bɛ achɛŋi nɛ Jɔn ubeŋi nɛ ane mạm awukan aterɛ Jizɔz, abɔu Jizɔz, &lt;&lt;obo usạri abod nɛ bɛ Farasi dɛ kɛ ŋani bara nɛ dulim nɛ dɔwɔ kubikubi, bɔŋɛtɔ bobo one bɛŋ dulim ɔŋani nɛ dɔwɔ?&gt;&gt; <verse eid="MAT 9:14" /><verse number="15" style="v" sid="MAT 9:15" />Jizɔz ɔbɔnɔ, &lt;&lt;abuninɛ ane bɛ awu ɔban ari biaga ubian ubian? Uwɛ onerum uwɛ usạri ɔban uyiŋkɛ, nyɔi ɔkɛmɛ kuremɛǃ dɛwe ikiwukan uwɛ anabɛŋ onerum ɛyɛ, abɛ iki ŋana bɛŋ dulim nɛ dɔwɔ <verse eid="MAT 9:15" /><verse number="16" style="v" sid="MAT 9:16" />&lt;&lt;one kure utogɔ dɔbara isin bɔŋ ujạm dɔbara itạmi, iki sạd dama dɔbara yɛ ɔbad utạm. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Ikɔ da ane iŋana itugɔ kɛ itạdrɛ yɛ ɔka unim, ure itạdrɛ yɛ iki kpawɔ, itugɔ yɛ ibɛi, itạdrɛ yɛ iki rɔk. akoŋinɛ itugɔ kɛ itạdrɛ isin, sạŋ ɔwa kubei&gt;&gt;<verse eid="MAT 9:17" /></para>
  <para style="s">Wɔŋ Onewani Ane Abara Nɛ Onewani Wɛ Uwạmɛ Dɔbara Ditoŋ Jizɔz</para>
  <para style="r">(<ref loc="MRK 5:21-43">Mk. 5.21-43</ref>; <ref loc="LUK 8:40-56">Lk. 8.40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />kubisɛ Jizɔz iri nyɔminɛ, one ju uwukan uterɛmạŋ, ukpạk ndu uyemạŋ, utekmạŋ&lt;&lt; wɔŋ one wani nwam ibe; oke ari nɛnɛmạŋ mbɔk, iki kaimạŋ. &gt;&gt;<verse eid="MAT 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 9:19" />Jizɔz ɔkaimạŋ utedmạŋ ndam bɔŋɛtɔ jizɔz atedmạŋ ndam.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />one wani dayin inani kɛkpa kɛ di jiou nɛ awumɔ ɔcheŋ kandam uwạma Jizɔz kɛ dɔbara kwaŋ. <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />one wani yɛ ɔyɔm kɛ kɔn, urebobɛ nwạmɛ dɔbara yɛyɛ ɛkpa iki kpori nɛ<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />Jizɔz uboŋɔmạŋ ɔrɔnmạŋ, komo ɛkpakporɔ wɔŋwam kunɛgɛyoyo kɛam isạdri ɛkpa ukporiwɛ<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Jizɔz ɔriɛkɛtɔ ɛbara yɛ. kubisɛ irɔnɛnɛ one wɛ utoni okpo kɛ ibetɔ ane kpai kibetɔ aboŋɔ jɛn akonimạŋ, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />Jizɔz utek, &lt;&lt;Naniruŋ, abon kpai, wɔŋ onewani wɛ ube ɔrami nɛ ɔramiǃ&gt;&gt; asanimạŋ kɔmam. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Asi awạmɛnɛ anekpai, Jizɔz ɔriɛ kɛtɔ yɛ wɔŋɛwɛ iyiɛnɛ ɔyamamạŋ kambɔk, wɔŋɔwɛ okaimạŋ. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />anekpai kɛ dondɛbara akomɔ bobɛ Jizɔz isạdri<verse eid="MAT 9:26" /></para>
  <para style="s">Jizɔz Ubok Adạndạmi Awumɔ</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Jizɔz uroŋɔ kpokpɛ, ɔchɛŋkɛ mạŋchen, adạndạmi awumɔ atedmạŋndam. &lt;&lt;komɔ ubian ayebara, wɔŋ ɔbɔd Devidǃ arod. &gt;&gt;arod. <verse eid="MAT 9:27" /><verse number="28" style="v" sid="MAT 9:28" />kubisɛ Jizɔz iriɛnɛ kɛtɔkɔn, adạmdạmi awumɔ awukan aseimạŋ, Jizɔz ɔbɔubɛŋ, &lt;&lt;eneŋɛrun iyɛ nbribogi barun?&gt;&gt;&lt;&lt;Nyɔi ataǃ &gt;&gt;abɔnɔ. <verse eid="MAT 9:28" /><verse number="29" style="v" sid="MAT 9:29" />Jizɔz uwạma bɛŋkɛ jɛn utek, &lt;&lt;Sạŋ uremɛɳɔi, da eneŋɛruŋǃ&gt;&gt; <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Arɔn iyem. Jizɔz utekbɛŋ, &lt;&lt;One nawunɔ kahemɛǃ&gt;&gt;<verse eid="MAT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 9:31" />Akai bɛŋ ɛnɛ aka hema iye anekpai kɛdondɛbara.<verse eid="MAT 9:31" /></para>
  <para style="s">Jizɔz Ubok umạmạmi</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />kubisɛ anebɛ aroŋɔnɛ kpokpɛ ane arạgarạ abɛnɛ onewɛ ɔkachiem ɔkɛmɛ kɔyɔm ure ikɔ kɛwaŋ ɛyaŋa ariye Jizɔz <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />kubisɛ kɛwaŋ ɛyaŋa yɛ iroŋɔ nɛ atawɛ, ɔkai mạŋ ɔkɔ nyɔm chiem, ɛkpa ube anekpai. &lt;&lt; Bom uwa dɔrɔrɔn kɛ izrɛlǃ&gt;&gt;Ayɔmi. <verse eid="MAT 9:33" /><verse number="34" style="v" sid="MAT 9:34" />bɛ faresis atek, &lt;&lt;ɔbɔd kɛwaŋ ayinɛ abɛ ayiŋɛnɛ Jizɔz ikɔm uwạm kɛwaŋ ayinɛ ɔlawɔ. &gt;&gt;<verse eid="MAT 9:34" /></para>
  <para style="s">Ubian Ane Usạd Jizɔz</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Jizɔz ɔcheŋ ɔyɔŋi don abara nɛ don bɔŋ. Jizɔz uchiemi kɛ kpomɔ kisumɔ bɛ ju, hemaduŋ chiem animɛ ubasɛ, sạd ane akomɔ ɛkpa kporɔ abok duŋ uyum kpai. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Jizɔz ɔrɔn ɛnɛ dɛyɔgɔ ubian ɔyamạŋ uyebɛŋ, ure akɔnɛ afirɛ one kure uwɛ ɔŋana bɛŋ mbɔk, da kulam yɛ ɔka kikoi ɔkɔ. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Jizɔz uted bɔŋɛtɔ yɛyɛ, &lt;&lt;okpo iyama ane uwɛ atɔk one ɔyama <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />ŋana wɛ dulim aye one wɛ ɔkɔ okpo bɛ uye ane dotomɔ uwɛ ari tɔk okpo bɛ. &gt;&gt;<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">Bɔŋɛtɔ Jiou Nɛ Awumɔ</para>
  <para style="r">(<ref loc="MRK 3:13-19">Mk. 3.13-19</ref>; <ref loc="LUK 6:12-16">Lk. 6.12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Jizɔz uyed bɔŋetɔ yɛyɛ jiou nɛ awumɔ usumɔ uyebɛŋ ikɔm awạm kɛwaŋ iyinɛ alau ane okpo ayinɛ abok uyum kpai. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />Uba dokom uchiemi bɔɛtɔ Jizɔz jiou nɛ awumɔː Saimɔn (uwukoni pita)nɛ wɔŋɔka Andru; Jɛms nɛ wɔŋɔka Jɔn, bɔŋ zibɛdi <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Filip nɛ batlomi; Tɔmɔs nɛ Matio, one were ukpạni akpogɔ keweyɛ; Jɛms woŋ afɔnsus, nɛ Tadiɔs; <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Saimɔn bɛ Patiɔd, nɛ Judas iskariɔd uwɛ ɔtɔnɛ Jizɔz mbɔk.<verse eid="MAT 10:4" /></para>
  <para style="s">Dotomɔ Bɔŋɛtɔ Jiou Nɛ Awumɔ</para>
  <para style="r">(<ref loc="MRK 6:7-13">Mk. 6.7-13</ref>; <ref loc="LUK 9:1-6">Lk. 9.1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Jizɔz iritom ane jiuo nɛ uwunɔ utekbɛŋː &lt;&lt;kakpom nɛ dondɛbara bɛ, Jɛntal nɛ samaritan kataruŋ <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Dɔŋ aka bun kulam ane bɛ izrɛl <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Kayemɛ iyɛ &lt;kubi kɛbɔd ubasɛ ikitumiǃ&gt; <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Bok uyum, sạd ane bɛ abe akaibɛŋ, ubɛ amayabɛŋ uyum ɛkpa iyinɛ sạd bɛŋ akomɔ ɛkpaporɔ, wạm kɛwaŋ iyinɛ. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />kɔtan inimɛ, kɔtan miami, kɔtan ntạmi nɛ akpogɔ katumɔ kɛdɛkpa; <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />dɛkpa bomkusi kabɛnɛdun atarun kɔchɛŋ dɔbara dɛyama nɛ esenkpa nwunɔ nɛ kese kɔchɛŋɛ kanɔŋɔ. sạŋ aye bɛ dotomɔ bobɛ abuni.<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />&lt;&lt; Atutumi kɛ don dɛbara nɛ don wɔŋ, bun one wɛ uwuyerɛ wɛ, ayạŋɛ nɛ amɛ tata aroŋɔ kpokpɛ. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Atutumi kɛtɔyɛ, tek sạŋ kɔkpama uyạŋɛ nɛ awu. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />ure bobɛ ane kɛtɔyɛ ayerɛwɛ ayạŋɛ nɛ abɛ, sạŋ dɛrɛnɛ kɔkpama yoyo ukpoŋɔ nɛ abɛ; ure bobɛ aka one uyerɛ ayạŋɛ nɛ abɛ, bɛŋ karɛnɛ. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />ure bobɛ ɛtɔ nɛ don dɛbara arạgarạg akawɛ one uyerɛ akomɔ ayewɛ, doŋɔ kpokpɛ yik nwun esenkpa yoyo aroŋɔ ujiri nwunɔ yoyo ɛ <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />am nyemɛnɛ kubi ibaŋa Ubasɛ iki komɔ ubian uye ane bɛ sodom nɛ gomora urugɔ ane don dɛbara uwɛǃ<verse eid="MAT 10:15" /></para>
  <para style="s">Dutugɔ Uwuŋi</para>
  <para style="r">(<ref loc="MRK 13:9-13">Mk. 13.9-13</ref>; <ref loc="LUK 21:12-17">Lk. 21.12-17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />&lt;&lt; komɔǃ mbuninɛ ntom barun kạmisi uwɛ ayạŋɛ da kulam kɛ kạmisi ane bɛ ayaninekum da ɛkpɛ ayạŋ. akɔwɛnɛ kukoi kɛ dɛyɔgɔ ane ubɛ, da ebi kowɛ ni iyɔk ɛyaŋa. hɔgɔ da kulam. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />Koi wɛ ure ane aki kɔbi wɛ atogɔ wɛ ata ibaŋa, aki tam wɛ kɛ kpomɔ kisumɔ bɛ ju. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Kɛ detoyam aki togɔwɛ awukan kɛ dure ɔbɔd nɛ bɛ gɛntal, ari yemɛ bɛŋ nfɔnɔ chiem nyam <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Atotogɔ wɛ awukan kɛ dure abɔd, afirɛ kakɔmɔ kɛ bobɛ ebuni ayɔm; kubi utumi, aki yewɛ bobɛ uwayɔm. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Chem ɛyɛ uwɛ awu ayɔm uwowo ure; aki nyɔm chiem yɛ uwu kubasɛ.<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />&lt;&lt;Ane aki nɔŋ bɔŋ ɔka aye dubɛ, ɔsɛ iki sạd nyɔi dirạg nɛ bɔŋ; Bɔŋ akino dekpo nɛ bɔsɛ asinɛ bɛŋ aye dube. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Ane kpai aki yɛrɛ wɛ kɛ deto nyam. Urenɛ one nawunɔ uwɛ kɛ am tata kikpe iki naŋi mạŋ. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Ane asạdsạdri wɛ akomɔ dutugɔ kɛ don ɛyɛ ɛyạŋ, dạm arawɛ kɛ don urạgarạg. Mbuninɛ nsạd wɛ ayenɛ iyɛ dotomɔ yoyo sạŋ ɔlaŋ kɛ don debara izrɛl aam nki wukan.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />&lt;&lt; Wɔŋɔ kusɛgɛ ɔkɔ badri urugɔ uwu chiemi, ɔkɔ utạk ɛyɛ ɔbara urugɔ ɔsɛtɔ. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Sạŋ wɔŋɔ kusɛgɛ uno da uwɛ uyạŋɛ da one wɛ uchimi mạŋ, utạk da ɔsɛtɔ. Ure bobɛ ayeri ɔsɛ setan uwɛ ure Bɛlzibul, aki yed bɔŋ dokom uwɛ ɔnyaŋi urugɔǃ<verse eid="MAT 10:25" /></para>
  <para style="s">One ɛkɔ Kuni</para>
  <para style="r">(<ref loc="LUK 12:2-7">Lk. 12.2-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />&lt;&lt;Kɛwɔd kakomo aye ane. bobɛ abemɛ isai iki wiŋɛ, bomɔ ndama aki sạd ane ayenɛ. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Bobɛ nyemi wɛ nɛ kirạmi akɔnɛ kɔyɔm nɛ dewe, bobɛ ekomɔ kandam ana asạd ane kpai akomɔ. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Kɛwɔd kakɔmɔ aye ane wɛ ɔkɔ ikɔm ɛkpa kɔhand kɛwaŋ ɔkɛmɛ kɔhand; kɔmɔ kɛwɔd aye ubasɛ yɛ ɔkɔ ikɔm ɛkpa nɛ kɛwaŋ kɔhand ke kon <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Akpogɔ wɔŋ amɛ atoginɛ arɛmi iranran awumɔ, asi iranran uwunɔ ɔkɛmɛ kɔtɔ kɛ dɔchɛ uwɛ asewo ika uyed <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Asi abon, abaga diŋ ɛyɛ uyạŋ baruŋ kɛ leto kpai <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Awu kɛwɔd kani; Ubasɛ ikɔ dɛbad anɛ uyewɛ urugɔ da ikɔ uye iranran dɛyamaǃ<verse eid="MAT 10:31" /></para>
  <para style="s">Okpo Ayinɛ Kuhemɛ Ayim Krais</para>
  <para style="r">(<ref loc="LUK 12:8-9">Lk. 12.8-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />Ubɛ ayemɛ krukpad iyɛ abɛ ayạŋ nɛ am, am nkisạd ɳɔi kɛ dure asɛm kɛ donubasɛ. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Ubɛ akan bɛŋ am kɛ dukpad, am nki kanbɛŋ kɛdure asɛm kɛ donubasɛ.<verse eid="MAT 10:33" /></para>
  <para style="s">Kɔkpama Ure Urenɛ ɛrɔmɔ</para>
  <para style="r">(<ref loc="LUK 12:51-53">Lk. 12.51-53</ref>; <ref loc="LUK 14:26">14.26</ref>,<ref loc="LUK 14:27">27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />&lt;&lt; Dirami kakɔ iyɛ nwu ndiye ngun kɔkpama. kɔkpama ure nwu kuye, nwunɛ nɛ arɔmɔ <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Kuwuya ikisạd wɔŋ onerum nɛ ɔsɛ one uyerɛ ayebem, bɔŋ anebani one uyerɛ aye bɛ ɔka, wɔŋ onewani uyerɛ uye ɔkaurum; <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />One uwɛ ɔkɔmɔ afirɛ nɛ awu urugɔ urenɛ wɔŋ akawo kɛtɔ.<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />&lt;&lt; Ubɛ abam ɔka nɛ ɔsɛ bɛbɛ arugɔ nɛ one ɔbɔgi bɔŋɛtɔ ɳam kuremɛ; ubɛ abam bɔŋ anebani nɛ bɔŋ anerum bɛbɛ arugɔ nɛ one ɔbɔgi bɔŋɛtɔ ɳam kuremɛ. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Ubɛ aka krɔs one utogɔ ated nwuŋ kɔchɛŋɛ yam one ɔbɔgi aremɛ bɔŋɛtɔ nyam. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Ubɛ abuni ekpen bɛbɛ kukoi iki naŋibɛŋ; ubɛ roŋɔ ekpen bɛbɛ kɛ deto ɳam iki kɔmɔ ekpen.<verse eid="MAT 10:39" /></para>
  <para style="s">Ekporɔ Dotomɔ</para>
  <para style="r">(<ref loc="MRK 9:41">Mk. 9.41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />&lt;&lt;One nawunɔ uwe uyerɛ wɛ iyerɛ nɛ; Uwɛ uyerɛ nɛ iyerɛ one wɛ utom nɛ. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />One nawunɔ uyerɛ one rotomɔ Ubasɛ uwɛ irenɛ one wɛ Ubasɛ itom dotomɔ, iki kɔmɔ dɛbad kubasɛ. One nawunɔ uyerɛ nfɔnɔ one ure amɛ urenɛ nfɔnɔ one, iki nɔŋ dɛbad kubasɛ <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Nbuni wɛ nɛ ayenɛ iyɛ one nawunɔ uyạŋ one wuterinɛ ndam ɔrɛgɛ urugɔ mạm kɛ deto nyam, ikɔ ekporɔ dotomɔ. &gt;&gt;<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">Bɔŋɔ Dotomɔ Uwɛ Awu Kɛ Jɔn Ubeŋinɛ Ane Mạm</para>
  <para style="r">(<ref loc="LUK 7:18-35">Lk. 7.18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Kubisɛ Jizɔz ihemɛnɛ bɔŋɛtɔ jou nɛ awumɔ yaya okpo bakpai, Jizɔz uroŋɔ bɛŋ ɔramạŋ kɛ don dɛbara yɛ ɔmarabɛŋ uku chiemi uhemɛ chiem Ubasɛ.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Kubisɛ Jɔn ɔyɛ ubeŋi nɛ ane mạm iyạŋ ɛ nɛ kɛ nkpɔkɔbi ukomɔ bobɛ Jizɔz isạdri, utom wɔŋɛtɔ yɛyɛ uwunɔ uyemạŋ. <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />&lt;&lt;Yemɛ bara, &gt;&gt; abɔu Jizɔz, &lt;&lt;awu arenɛ one wɛ jɔn itegɛ nɛ iyɛ ikiwukan, dukom one urạgarạg?&gt;&gt;<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />Jizɔz utek, &lt;&lt;kpe ndam aka hemɛruŋ Jɔn bobɛ ekomɔ nɛ bobɛ ɛrɔnː <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />Da adạndạmi arɔn iyem, ɔtɛtɛgɛ ikaimạŋ ɔchɛŋ, ubɛ amaya kɛkpa cherɛ asagi bɛŋ arɔrɔ, atoŋtoŋi akomɔ iyem, uyigɛ anebɛ abe, ahemi kuwenɛ ɛrɔmɔ Ubasɛ aye ane bɛ aka bom one ɔkɔ. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Ɔkɔndɔm ikiyạŋa nɛ anebɛ aka kɛwɔd kɛ aam one ɔkɔǃ<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Kubisɛ bɔŋɛtɔ Jɔn aroŋɛnɛ kpokpɛ, Jizɔz ɔyɔm chiem yɛyɛ kɛ dɛyɔgɔː &lt;&lt;kubisɛ ɛtaya ruŋɛnɛ kɛkpokpɛ yạŋ foi kese ikana ɔbaya, aka seiruŋ Jɔn obo etumduŋ kɛ ɛkɔn kɔta akarɔn? De ɔwa deto ujinɛmạŋ uye kiwun? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Obo ɛnani akarɔn? onerum ɔyɛ ɔŋanimạŋ dɔbara kisaya? ane bɛ ahanibɛŋ dɔbara ubɛ asạrinɛ dotomɔ kɛtɔ ɔbɔdǃ <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Yemɛnɛ, bobɛ ɛta akarɔn? One wɛ uyemi dɛman Ubasɛ? Nyɔi amɛ, asi ɛrɔn bobɛ ɔbara urugɔ one wɛ uyemi dɛman Ubasɛ. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Jɔn urenɛ one uwunɔ kusɛgɛ Ubasɛ itegɛnɛ iyɛː Ubasɛ utegɛ, nki sinɛ one dotomɔ yam iwi menɛ iyem uyewɛ. <verse eid="MAT 11:10" /><verse number="11" style="v" sid="MAT 11:11" />Nbuninɛ nsạd wɛ ayenɛ iyɛ Jɔn yɛ ubeŋi nɛ ane mạm ibara urugɔ ane bɛ anugikpai. nbuninɛ ayenɛ iyɛ one wɛ ɔrɛgɛ urugɔ kɛ don ubasɛ ibara urugɔ Jɔn. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Sani kubi Jɔn iyeminɛ chiem ubasɛ tata isai kpomɔ kɛbɔd ubasɛ ukpori nɛ ukpori, ane akporo akɔminɛ don ubasɛ. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />tata kubi Jɔn ane bɛ iyemi dɛman ubasɛ nɛ dɛman mozis ari yemɛ chiem don ubasɛ. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />ure bobɛ awu aneŋɛ kɛ chiem nyam, Jɔn uyạŋɛnɛ da elaija, uwɛ ariyemɛ kuwu yɛyɛ. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />komɔ, isai, urebobɛ ekɔ ditoŋ.<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />&lt;&lt; isai obo uwɛ ntogɔ nnomɔ ane ubi ichiŋɛ? ayạŋɛnɛ da bɔbɔŋɔ bɛ abiagi kɛ kpom ɛya. Ane uba arod bɛm ubaran, <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />Dɔŋana koton ɔban duyewɛ, asi abuni kuyuǃ duton koton dube, abunɔ kutoǃ &gt; <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />kubisɛ Jɔn iwunɛ, ɔbiaga dɔwɔ ɔŋanimạŋ dulim, itugɔ ɔwɔ, anekpai atek iyɛ&lt; itum kɛwaŋ iyinɛ kɛkpaǃ &gt; <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />kubisɛ wɔŋ one iwunɛ, uji ɔwɔ ane kpai atek, &lt;koniwɛ atawaǃ iji okpo ɔrɔk ɔwɔyɔ itugɔ, ayi ane wɛ ukpạni akpogɔ keweyɛ nɛ ane bɛ aka iyem one ɔnani ǃdukpeŋɛ Ubasɛ, ichegɛ kɛ krehenhenɛ kokpo bɛ isạdri. &gt;&gt;<verse eid="MAT 11:19" /></para>
  <para style="s">Don Yɛ Aka Ubasɛ One uneŋɛ</para>
  <para style="r">(<ref loc="LUK 10:13-15">Lk. 10.13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />ane bɛ ayạŋ kɛ don yɛ Jizɔz isạdri nɛ kimạgɛ yɛyɛ dɛyama dɛyama one okpo ayinɛ one uroŋɔ, Jizɔz ɔrak don ɛbɛ. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />iki yaŋi nɛ abon bɛ chorazin nɛ bɛ bɛdsaidaǃ kimạŋɛ yɛ nsạdri kodon yoni nbi sạdri kɛ don bɛ Tairɛ nɛ sidɔn, ane ayinɛ kɛ don ɔbɛ bɛ aneŋɛ kɛ am, ahani bɛŋ dɔbara ubiana abiaga kɛ kutɔ, atogɔ achegɛ iyɛ abɛ aroŋɔ okpo ayinɛ <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Nbuninɛ ayenɛ iyɛ dewe ibaŋa Ubasɛ iki komɔ ubian nɛ bɛ Tairɛ nɛ sidɔn urugɔ barun. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Abon bɛ kapanumǃ abuni abirɛ ɛkpa yoni atumi kɛ don ubasɛ?aki kpaŋa wɛ akara kɛ ekonǃ kimạŋɛ yɛ asạri kɛ don boni abi sạdri kɛ don bɛ sodom, bɛ uyạŋɛ tata ichiŋǃ <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Nbuninɛ ayenɛ iyɛ dewe ibaŋa iki komɔ ubian nɛ bɛ sodom arugɔ barunǃ&gt;&gt;<verse eid="MAT 11:24" /></para>
  <para style="s">Oke Kɛ Aam Ari Hɔgɔ Kɛwaŋ</para>
  <para style="r">(<ref loc="LUK 10:21">Lk. 10.21</ref>,<ref loc="LUK 10:22">22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />kubisɛ Jizɔz utek, asɛm, Ubasɛ dewe nɛ dɔchɛǃ di sama wɛ ure echegɛ ubɛ aka bon one uyed bobɛ ɛrạbɛ ane bɛ akɔ dukpeŋɛ nɛ ubɛ ata kusɛgɛ. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />nyɔi asɛm, ɛsạri nyɔi ire awu ɛrɔn iyɛ ikinim urere nyɔi.<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />&lt;&lt; Jizɔz utek, asɛm iyạŋ nɛ okpo kpai, asɛm mạŋchen amɛ uyed nɛnɛ one nawunɔ nuyed, am nɛŋchen nyed ɛnɛ asɛm one nawunɔ mạŋ uyed, one uwɛ mbam amɛ nbuninɛ nyemɛ one wɛ ire nye.<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />&lt;&lt; Oke aterɛ nɛ abon ɛbɛ ikɔm iraŋ kɛ etogɔ abara kutumɔ, nki yebarun kɛwaŋ kɔhɔgɔ. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />nɔŋ ekɔn yam atumɔ, achiemi wɛ da am nyạŋ, ire am nde nɛ one wɛ ɔhɔgɔ kɛ kɛwaŋ; aki kɔmɔ kɔkpama. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />ɛkɔn nyam nbuninɛ nyewɛ ikpama, etogɔ yɛ uwɛ nyewɛ iki fugɔ &gt;&gt;<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">Dɛbɔwɔ Ereri</para>
  <para style="r">(<ref loc="MRK 2:23-28">Mk. 2.23-28</ref>; <ref loc="LUK 6:1-5">Lk. 6.1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />uchirɛ Jizɔz ɔchɛŋ kɛ kɔn dɛbɔm ekpom kutigakɛ dewe kɛwaŋkɔhɔ bɛ jius. bɔŋɛtɔ bɛbɛ ari komɔ dɔwɔ, ari pạni kɔn deto bɛ aji nɛ ɔwabɛ. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />bɛ Farasi arɔnɛnɛ, atek Jizɔz &lt;&lt;bobɛ bɔŋɛtɔ boba asạrinɛ urenɛ bom eyaŋa kɛ dewe ɛrɛri bɛ juǃ &gt;&gt;<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />Jizɔz ɔbɔnɔ beŋ, &lt;&lt;Ara yed dun bobɛ ɔbɔd Devid arisạdri kubisɛ ame nɛ bɔŋɛtɔ bɛbɛ ari komɔnɛ dɔwɔ? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Devid nɛ bɔŋɛtɔ bɛbɛ ariɛ nɛ kɛtɔ ubasɛ, abɛnɛ kitawɔ ɔkara ubasɛ aji, iremɛ uwɛ abɛ ayed iyɛ atobinɛ utobi-one wɛ uyemi chiem ubasɛ mạŋchen ame ɔkɔnɛ kitawɔ ɔkara ubasɛ kuji. <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Ayedri run kɛ kusɛgɛ ntotobɔmozɛz da ane bɛ ayemi chiem ubasɛ kakpom kisumɔ ubasɛ atɔŋi kɛ kɛ dɛman ayan kɛ dewe ɛrɛri bɛ ju, kotobɛ ona bɛŋ ɔyam? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Nbuninɛ nyemɛ barun iyɛ bom uyạŋka ɔbara urugɔ kpom kisumɔ ubasɛ. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />kusɛgɛ ubasɛ utegɛ nɛ iyɛ, &lt;nfɔnɔ dɛmara one kuchegɛ amɛ nbuninɛ, dayiŋ esen kutogɔ asạd efin ure, &gt; ure bobɛ eyed da bobɛ inani, sạŋ ane bɛ asạri okpo ayinɛ arɔgi; <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />wɔŋ one urenɛ ɔbɔd dewe kɛwan kɔhɔgɔ bɛ ju. &gt;&gt;<verse eid="MAT 12:8" /></para>
  <para style="s">Onerumɔ Wɛ Ube Mbɔk</para>
  <para style="r">(<ref loc="MRK 3:1-6">Mk. 3.1-6</ref>; <ref loc="LUK 6:6-11">Lk. 6.6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Jizɔz uroŋɔ kpokpɛ aramạŋ kɛ kpom isumɔ bɛ ju, <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />uwɛ wɔŋ onerum ɛyɛ mbɔk ibe iyạŋ. ane arạgarạg ayạŋkɛ uwɛ abuni anɛnɛ Jizɔz chiem iyɛ usạri okpo ayinɛ, abɔu Jizɔz, &lt;&lt;ure bom inima one uyum kubok kɛ dewe kɛwan kɔhɔgɔ bɛ ju?&gt;&gt;<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />Jizɔz ɔbɔnɔ, ure bobɛ ibun boni itɔ kɛ dɛma kɛ dewe ɛrɛri bɛ ju? sạŋ dun ibun yoni alawɔ dun kɛ dɛma? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />One ikɔ debad urugɔ ubunǃ Dɛman kɔyaŋ bara utobi one mbɔk kɔŋana aye kɛ dewe ɛrɛri bɛ ju, &gt;&gt; <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />Jizɔz utek onerum ɔwɛ mbɔk ibenɛ, tana mbɔk yoyo. &gt;&gt;one wɛ ɔtana mbɔk yɛyɛ, ukomɔ ɛkpa kporɔ, da iri naninɛ uye ubaran.<verse eid="MAT 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 12:14" />bɛ farɛsis ɛbɛ akaibɛŋ asani kisumɔ kɔkɔmɔ uwɛ ahan Jizɔz.<verse eid="MAT 12:14" /></para>
  <para style="s">Ane Bɛ Ubasɛ Itegi Da Bɔŋ ɛtɔ Bɛbɛ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />kubisɛ Jizɔz ikomɔnɛ isumɔ ayinɛ arimi kɛ deto yɛyɛ, uroŋɔ kpokpɛ; dɛyɔgo, atedmạŋ ndam. Ubok ayuyumi kpai. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />Utek bɛŋ one nawunɔ one kuhamɛ bobɛ amɛ ire. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Usạdri nɛ okpo ba sạŋ ane anɔŋ bobɛ one wɛ uyemi dɛman ubasɛ aizaya iri hemɛ uwɛ uwu kubasɛ ure krenhenhenɛ.<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />Uwa wɔŋ ɛtɔ anyam, uwɛ nyeri, uwɛ mbam,</para>
  <para style="q2" vid="MAT 12:18">Uwɛ mbam, uwɛ ɛkɔn yam ikomɔ ɔkɔn dɔm kamɛ.</para>
  <para style="q1" vid="MAT 12:18">Uki tom kɛwaŋ yam kamɛ,</para>
  <para style="q2" vid="MAT 12:18">Umɛ iki yemɛ dewe ibaŋa yam uye ngun.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Umɛ sạŋ ɔkaŋa sạŋ urori.</para>
  <para style="q2" vid="MAT 12:19">Sạŋ iyɔm dɛbad usạri kiyem.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Sạŋ ɔwa yɛ ujinɛ kɔmiɛgɛ,.</para>
  <para style="q2" vid="MAT 12:20">ekon yɛ ɔtaya kubikubi sạŋ urạma.</para>
  <para style="q1" vid="MAT 12:20">Iki sạd tata ɔrɔn kurugɔ.<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />kamɛ anekpai aki yaŋ ekɔn bɛbɛ.<verse eid="MAT 12:21" /></para>
  <para style="s">Jizɔz Nɛ Bɛ Bɛlzibul</para>
  <para style="r">(<ref loc="MRK 3:20-30">Mk. 3.20-30</ref>; <ref loc="LUK 11:14-23">Lk. 11.14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Abɛnɛ one wɛ ɔka iyem ɔrɔn chiem ɔkɛmɛ kɔyɔm ure ikɔ kɛwaŋ iyinɛ. Jizɔz ubokmạŋ, amɛ asani chiem kɔyɔm, ɔrɔn iyem. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />ɛkpa ube dɛyɔgɔ kɛ kimạga Jizɔz isạdri. &lt;&lt; Abɔu amɛ iyɛ wɔŋ ɔbɔd devid ure ire?&gt;&gt;<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />Bɛ Farasi akomɔ nɛ, abɔnɔ, &lt;&lt;Uwạmanɛ kɛwaŋ ayinɛ ure ɔbɔd bɛ bɛlzibul uyạŋ mạŋ ɛnɛ ikɔm usạd nyɔi. &gt;&gt;<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />Jizɔz iyed dirami bobɛ, utek bɛŋ, &lt;&lt;Don debara nawunɔ yɛ achiemɛ ɛkpa bɛbɛ, anoyɔ nɛ ɛkpa bɛbɛ ikirɔk don bɛbɛkpai. don dɛbara nɛ ɛtɔ nawunɔ yɛ achiemɛ ɛkpa bɛbɛ anoyɔ nɛ ɛkpa bɛbɛ iki chari. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />ure bobɛ ane iyinɛ anoyɔ dɛban nɛ ekpa bɛbɛ kɛ don one iyinɛ ɔnani nɛ iyɛ achiemɛ ɛkpa bɛbɛ aki wagi achariǃ <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Jizoɔz utek, ategɛrun nɛ iyɛ am nwạmanɛ kɛwaŋ ayinɛ ure beelzebul iyạŋ nɛ ikɔm , banɛ ayạŋ ane bɛ ateri barun ndam ikɔm awạm kɛwaŋ ayinɛ? bobɛ bɔŋ ɛtɔ boni asạri ichegɛ iyɛ egbiɛ runǃ <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Bɛlzibul ure uyạŋ nɛ ikɔm, kɛwaŋ Ubasɛ amɛ uyạŋ nɛnɛ ikɔm ntogɔ nwạm kɛwaŋ ayinɛ, uwɛ ɔnani iyɛ don ubasɛ iwu uterɛ wɛ.<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />&lt;&lt; ɔkɔ one wɛ ɔkɛmɛ ɛtɔ one ikporɔ kɔkpawɔ ɔrie uku yạu bom, amɛ ɔkɔnɛ one ikporɔ yɛ kuchimi ɔbɔu; iyai ɔriɛ kɛtɔ yɛ uwạu bom.<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />&lt;&lt; One nawunɔ ɔka nɛ am ɔban, urenɛ one iyɛrɛ nyam; uwɛ ɔkanɛ useyɛ usumɔ ubuninɛ ɔchari. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />kɛ deto ya nbuninɛ nyemɛwɛ; ibi kagibɛŋ aye okpo ayinɛ bɛ ane asạri nɛ ubɛ ayɔmi; one nawunɔ uhemɛ chiem iyinɛ ɔmara kɛwaŋ inimɛ ubasɛ sạŋmạŋ one ɔkagi uye. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />one nawunɔ ɔyɔmɔ chiem iyinɛ ɔmara wɔŋ one ibri kagibɛŋ ayemạŋ; uwɛ ɔyɔmɔ chiem iyinɛ ɔmara kɛwaŋ inimɛ ubasɛ one sạŋmạŋ o, kagi uye-iyai nɛ tata kikpe.<verse eid="MAT 12:32" /></para>
  <para style="s">Kese Nɛ Dawama Yɛyɛ</para>
  <para style="r">(<ref loc="LUK 6:43-45">Lk. 6.43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />Nfɔnɔ duwama kɔkɔmɔ ana kese bɛbɛ unim ɛkpa; kese yoyo ɔyaŋyaŋi ɛkpa, duwama bɛbɛ sạŋ unim, ayerɛ nɛ nfɔnɔ kese kɛ duwama yɛyɛ <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Awu iyɔk-asạdnạn ahemɛ nfɔnɔ chiem uwɛ awu arenɛ bom iyinɛ?ɛma ɔyɔminɛ bobɛ uwu kɛ dɛkɔnduri. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Nfɔnɔ one uruginɛ nfɔnɔ okpo kɛ dɛkpa nfɔnɔ okpo utogɔ uwui, one iyinɛ urugi okpo ayinɛ kɛ dɛkpa okpo ayinɛ utogɔ uwui.<verse eid="MAT 12:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 12:36" />Akɔ wɛnɛ kɔrama iyɛ dewe ibaŋa ubasɛ aki yɛ kɔbaga okpo ayinɛ bɛ ɔnani wɛ kɛma. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Iki togɔ chiem ɛma yoyo abierɛ ibaŋa ayewɛ-kan aki naŋiwɛ kan sạŋ wɛ anaŋi. &gt;&gt;<verse eid="MAT 12:37" /></para>
  <para style="s">kimạga Kubun</para>
  <para style="r">(<ref loc="MRK 8:11">Mk. 8.11</ref>,<ref loc="MRK 8:12">12</ref>; <ref loc="LUK 11:29-32">Lk. 11.29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />&lt;&lt; Bɛ ane bɛ achiemi mbɛd bɛ Farasi ayɔm &lt;&lt;one wɛ uchiemi, &gt;&gt;atek, &lt;&lt;dubininɛ dɔrɔn wɛ da ɛsạri kumạgɛ. &gt;&gt;<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />&lt;&lt; Ane bɛ ichin ayinɛ ɛkun one ubasɛ one uyedǃ &gt;&gt;Jizɔz ɔyɔm. &lt;&lt;Ategɛnɛ nsạd kimạgɛ? kimạgɛ yɛ abuni aye barun urenɛ kimạgɛ one wɛ iyemi dɛman ubasɛ Jona. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Da Jona iyạŋ kutu kibri ɛbara kɛ dewe asiri nɛ kirạni asiri, nyɔi amɛ wɔŋ one uwu yạŋɛnɛ kɛ dɔchɛ ɛkɔn kɛ dewe asiri nɛ kirạni asiri. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />kɛ dewe ibaŋa ubasɛ ane be, nɛnivɛ aki ba ayɔm chiem iyinɛ amara wɛ, ure aroŋɔ nɛ okpo ayinɛ kubisɛ Jona iyem bɛŋ ɛnɛ chiem ubasɛ; ubuninɛ nyemɛ wɛ iyɛ bom uyạŋka ɔbara urugɔ Jonaǃ <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />kɛ dewe ibaŋa ubasɛ ɔbɔd wani sheba iki ba ɔyɔm chiem iyinɛ ɔmara wɛ, ure ame, uroŋɔ nɛ don ɛbara yɛyɛ uterɛ ɔbɔd solomon yɛ uyed bom uku komɔ kuchiemi kamɛ; nbuninɛ ayenɛ iyɛ bom uyạŋka ɔbara urugɔ ɔbɔd solomonǃ<verse eid="MAT 12:42" /></para>
  <para style="s">kukpe Kuron ɛyaŋa</para>
  <para style="r">(<ref loc="LUK 11:24-26">Lk. 11.24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />&lt;&lt; Kubisɛ kɛwaŋ iyinɛ inani one kɛkpa, iki sạd kɔcheŋ ɔramạŋ kɛ don dɛbara yɛ uwunɔ, ukubun kpokpɛ uwɛ ɔbiaga. ɔkaka ɔkɛmɛ ɔrɔŋ kpom uwɛ ɔbiaga. <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />utek ɛkpa yɛyɛ, nki kpe ndam kɛtɔ nyam. ukpe kpe ndam ukusei ɛtɔ yɛyɛ foi, atai, ayaŋ okpo unim. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />iki ramạŋ ɔkɔnɔŋ kɛwaŋ iyinɛ ubɛ ayaŋi arugɔmạŋ atenan ɔmara nɛ ɛkpa yɛyɛ, awi nugi ɛ. kikpe ekpen one wɛ iki yinɛ urugɔ da irire. kɛ bobɛ uwusei ane ayinɛ bɛ ichin. &gt;&gt;<verse eid="MAT 12:45" /></para>
  <para style="s">ɔka Nɛ Bɔŋ ɔka Jizɔz</para>
  <para style="r">(<ref loc="MRK 3:31-35">Mk. 3.31-35</ref>; <ref loc="LUK 8:19-21">Lk. 8.19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Jizɔz iki nyɔmɔkɛ chiem nɛ ane ɔka nɛ bɔŋ ɔka awukaŋ. Aba kɛ dɛbɔm abuni anyɔm chiem nɛ amɛ. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />One uwunɔ ɛ utekmạŋ, koniwɛ akawo nɛ bɔŋ akawo abakɛ kɛ dɛbɔm, abuninɛ anyɔm chiem nɛ awu.<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />Jizɔz ɔbɔnɔ, &lt;&lt; Nɛ banɛ are akam?&gt;&gt;Banɛ are bɔŋ akam?&gt;&gt; <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />uwerɛ bɔŋɛtɔ bɛbɛ mbɔk, kɛ bɔŋ akam nɛ akam aǃ <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />one nawunɔ usạd sạdri bobɛ asɛm kɛ don dubasɛ ibuni urenɛ bɔŋ akam anerum, bɔŋ akam anebani nɛ akam. &gt;&gt;<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">Kosei Okpo Kukon</para>
  <para style="r">(<ref loc="MRK 4:1-9">Mk. 4.1-9</ref>; <ref loc="LUK 8:4-8">Lk. 8.4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Dewe uwunɔyɛ Jizɔz urogɔ ɛtɔ ɔramạŋ kɔkpa kɛtama kwan, ɔkɔ biaga uchiemi bom. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Dɛyɔgɔ yɛ ayạŋ nɛ amɛ ayama tata amɛ uroŋɔ bɛŋ ɔkɔ biaga kokpok, dɛyɔgɔ bɛ aba kɛ dɔnɛn. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />Utogɔ kosei uyemɛ bɛŋ okpo dɛyama. &lt;&lt;kubi unɔ one ita uku kon nsam.<verse eid="MAT 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 13:4" />Dana inyamana nsama bɛ arạgarạg atɔ kiyem, kɔnɔn iri sobi aji. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Arạgarạg ɔtɔ kɛ datan jaga, uwɛ dɔchɛ ika kure. ɔsani kumid, ure dɔchɛ urạma. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Kubisɛ ewe iwunɛ, ewe ɔtam okpo bɔŋ ɔbɛ umirinɛ; uwɛ akanɛ one ɔtɔgi urạma, okpo bɛ ubekpai. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Okpo jɛn ɛbɛ arạgarạ ɔtɔ kɛ kisạni ɛtɔ uwɛ ɔka umiri unim. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Jɛn ɛbɛ arạgarạg ɔtɔ kɛ dɔchɛ, umid ɔnani ɔwaː arạgarạg umid nkpaŋ dɛnau atɛn urugɔ da akonɔ, uwaran umid dɛnau asiri urugɔ da akonɔmạŋ, uwaran umid nkpaŋ dokoro awumɔ urugɔ da ire. &gt;&gt;<verse eid="MAT 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 13:9" />Jizɔz ɔyɔmɔ nɛ kpai utek yɔrɔ ditoŋ ure bobɛ ɛkɔ ditoŋ. &gt;&gt;<verse eid="MAT 13:9" /></para>
  <para style="s">Bobɛ Usạdri Atou Kosei</para>
  <para style="r">(<ref loc="MRK 4:10-12">Mk. 4.10-12</ref>; <ref loc="LUK 8:9-10">Lk. 8.9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Bɔŋ ɛtɔ Jizɔz awukan kamɛ ari bɔumạŋ, &lt;&lt;Obusạri atogi kosei ahemi ane chiem?&gt;&gt;<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />Jizɔz ɔbɔnɔ, dukpeŋɛ uwɛ bobɛ urạbɛ ane don ubasɛ asɛŋɛ aye barun, abɛ one uyạŋ. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />One wɛ ɔkɔ bom aki bɔmɔmạŋ, sạŋ ɔkɔmɔ ɔyam kaŋkaŋ; one wɛ ɔka bom ɔka iki namạŋ wɔwɔŋɔ yɛyɛ ikɔ. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Bobu usạd ntogi kosei nyemi bɛŋ chiem urenɛ aki koni one ɔrɔn, ayɔrɔ ritoŋ one ukomɔ bɛŋ ɔtama. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />Kuyemɛ ubasɛ uwɛ uwu kɛ aizaya utebɛŋ nɛ;</para>
  <para style="q1" vid="MAT 13:14">aki yɔrɔ ditoŋ ayɔrɔ ditoŋ ure nɛ one sạŋ bɛŋ ɔtama;</para>
  <para style="q2" vid="MAT 13:14">aki koni akoni one sạŋ ɔrɔn,<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />ure akɔnɛ dɛkɔnduri ɛkpama,</para>
  <para style="q2" vid="MAT 13:15">awa kri komɔ,</para>
  <para style="q2" vid="MAT 13:15">amerɛ ditoŋ bɛbɛ,</para>
  <para style="q2" vid="MAT 13:15">abemɛ jɛn bɛbɛ</para>
  <para style="q1" vid="MAT 13:15">ibika nyɔi ure jɛn bɛbɛ bɛ ɔrɔn iyem</para>
  <para style="q2" vid="MAT 13:15">ditoŋ bɛbɛ bɛ ukomɔ iyem</para>
  <para style="q2" vid="MAT 13:15">iki tama bɛŋ krɛkɔn duri</para>
  <para style="q1" vid="MAT 13:15">ubasɛ utek aki wukan aterɛ nɛ</para>
  <para style="q2" vid="MAT 13:15">aam iki bok bɛŋ kpai<verse eid="MAT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />&lt;&lt; Asi abon, ɔfa isei baruŋǃ Ire jɛn boni irɔn iyem ditoŋ yoni ukomɔ iyem. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Nbuninɛ nsạd barun ayenɛ iyɛ ane bɛ ayemi dɛman ubasɛ dɛyama dɛyama abunɛkɛ arɔn bobɛ arɔndun akomɔ bobɛ ekomɔdun urenɛ one kɛmɛ.<verse eid="MAT 13:17" /></para>
  <para style="s">Jizɔz ɔtamanɛ Kosei Okpo Kukon</para>
  <para style="r">(<ref loc="MRK 4:13-20">Mk. 4.13-20</ref>; <ref loc="LUK 8:11-15">Lk. 8.11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />yɔrɔ ditoŋ achiemi wɛ bobɛ kosei bom kukon inani. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Ane bɛ akomɔ chiem don ubasɛ bɛŋ ɔtama ayạŋ ɛnɛ da okpo jɛn ɛbɛɔtɔ kiyem. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Okpo jɛn ɛbɛ ɔtɔ kɛ datan ɔbanɛ uye ane bɛ akomɔ chiem nyem anɔŋ chiem nyam kɛ dɛbad. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />Urenɛ bɛŋ kɛ kɔn ubạnɛ, kuneŋɛ bɛbɛ uchirɛ. urebobɛ afirɛ nɛ dubɛ iwu kuwɛ ahemi chiem nyam, aki kan bɛŋ kubrukpun. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Okpo jɛn bɛ ɔtɔ kɛtama urạgrạgri ɔba nɛ uye ane bɛ akomɔ chiem ubasɛ; okpo ŋun nɛ da uwa chɛŋ akɔmɔ akpogɔ bɛŋ asɛŋɛ aneŋɛ kɛ chiem ubasɛ, asani okpo a kusạd uwɛ ɔka ubasɛ ɛkɔn ɔrɔmɔ. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Okpo jɛn yɛ akonɔ kɛ nfɔnɔ dɔchɛ ɔba nɛ uye ane bɛ akomɔ chiem ubasɛ ɔtamabɛŋ; asạd bobɛ ɔrɔmɔ ubasɛ ɛkɔn, asạd nkpaŋ dɛnau aten arạk arạk nkpaŋ dɛnau asiri ubaran nkpaŋ dokoro awumɔ. &gt;&gt;<verse eid="MAT 13:23" /></para>
  <para style="s">Kosei Kɔnɔ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Jizɔz uyemɛ bɛŋ kosei urạk arạk;&lt;&lt;Don ubasɛ uyạŋ ɛnɛ da. one ikonɔ nfɔnɔ okpo kɛram yɛyɛ. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />kirạni uwunɔ uwɛ anekpai arau, one iyinɛ ɔnɔŋ kɔn irikon kɛ ram ɛyɛ ɔya. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Kubisɛ okpo bɛ isaninɛ kumid, kon ɛbɛ umid dirạk. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />Bɔŋɛtɔ one wɛ ɔkɔ kɛram awukan ari bɔu ɔsɛ ɔtɔbɛbɛ, &lt;&lt;Ata dukonɔnɛ nfɔnɔ okpo kɛram, ndɛ okpo uba iwu?&gt; <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />ɔsɛ ɛtɔ ɔbɔnɔ ane ayinɛ asạrinɛ. bɔŋ ɛtɔ abɔumạŋ dɔkɔ nau kɔn ayinɛ bɛ dɔlawɔ. <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />Kanau duŋ ure ananawi duŋ ebri sumɔ kɔn nɛ nfɔnɔ okpo anau duŋ. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Sɛŋ dun kɔn ɛbɛ nɛ okpo bɛ amid ibeŋi kubisɛ uwɛ utumi kubi kɔtɔgɔ, ane bɛ uwɛ akatɔk aki nau kɔn ɛbɛ abɔu akumi bɛŋ, atɔk okpo bɛ abɔu kɛ dɔhan nyam. &gt;&gt;&gt;<verse eid="MAT 13:30" /></para>
  <para style="s">Kosei okpo Jɛn ɛrɛgɛ</para>
  <para style="r">(<ref loc="LUK 13:20">Lk. 13.20</ref>,<ref loc="LUK 13:21">21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Jizɔz uhemɛbɛŋ kosei urạgarạgː &lt;&lt;Don ubasɛ uyạŋ ɛnɛ iya. one ɔnɔŋɛnɛ okpo jɛn ɛyɛ ɔrɛgɛ urugɔ ukon kɛram yɛyɛ. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Amɛ ɔrɛgɛnɛ urugɔ kokpo jɛnkpai, umirinɛ, ɔbad urugɔ okpo ubaran. irirɛme kese ɛbara, kɔnɔn aribod dɛkakari kɛ ɔbɔbɔ yɛyɛ. &gt;&gt;<verse eid="MAT 13:32" /></para>
  <para style="s">Kosei Yɛ usạri bom ɔnani</para>
  <para style="r">(<ref loc="LUK 13:20">Lk. 13.20</ref>,<ref loc="LUK 13:21">21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Jizɔz uyemɛbɛŋ kosei urạgarạgː&lt;&lt;Don ubasɛ uyạŋɛnɛ iya. one wani uwunɔ ɔnɔŋɔ nɛ bɔm uwɛ usạd kitawɔ ɔkara ɔyam ɔyɔŋ nɛ bɔbɛ atogi asạri kitawɔ ɔkara dɛkpa uwunɔ tata ɔyam. &gt;&gt;<verse eid="MAT 13:33" /></para>
  <para style="s">Jizɔz Utogɔ Nɛ Kosei</para>
  <para style="r">(<ref loc="MRK 4:33">Mk. 4.33</ref>,<ref loc="MRK 4:34">34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Jizɔz utogɔ nɛ kosei ihemɛ dɛyɔgɔ chiem; ɔkaka kosei utok chiem ɔyɔmɔ. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Usạdri nɛ okpo ba sạŋ arɔn iyɛ bobɛ one wɛ uhemi dɛman ubasɛ ure krehenhenɛ,</para>
  <para style="q1" vid="MAT 13:35">&lt;&lt;iki togɔ kosei nhemibɛŋ chiem,</para>
  <para style="q2" vid="MAT 13:35">iki hemɛbɛŋ bobɛ aka one uyed sani kɔsani ngun. &gt;&gt;<verse eid="MAT 13:35" /></para>
  <para style="s">Jizɔz ɔtama Kosei Kɔnɔ</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Kubisɛ Jizɔz iroŋɔ dɛyɔgɔ ɔriɛ kɛtɔkɔn, bɔŋɛtɔ bɛbɛ uwukan iritekmạŋ iyɛ, &lt;&lt;yemɛ bara bobɛ kosei bom kukon kɛram da inani, &gt;&gt;<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />Jizɔz ɔbɔnɔ, &lt;&lt;One wɛ ukonɔnɛ nfɔnɔ okpo ure nɛ wɔŋ one; <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />Kɛram urenɛ ngun; nfɔnɔ okpo kɛram urenɛ ane bɛ uwɛ arabɛŋ don ubasɛ; kon ayinɛ ɔba nɛ uyɛ ane ayinɛ; <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />One wɛ ukonɔnɛ kon iyine urenɛ setan. kubi okpo kɔtɔk urenɛ kubi ubasɛ uwuɛ, ane bɛ atɔgi okpo bɛ arenɛ bɔŋɛtɔ ubasɛ. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />Da abɔi nɛ kon ayinɛ akumi kekon, nyɔi amɛ uwɛ akaranɛ ane ayinɛ kekon kubisɛ ubasɛ uwɛ uwukanː <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Wɔŋ one iki sinɛ bɔŋɛtɔ bɛbɛ iri bɔu ane bɛ asạri ane asạd okpo ayinɛ nɛ ubɛ asạri okpo ayinɛ, <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />aki kara bɛŋ kɛ ɛtɔ ekon, uwɛ ato ajibɛŋ daraŋ. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />bɔŋ ubasɛ aki ta da ewe kɛ don ɔsɛ bɛbɛ. komɔ urebobɛ ekɔ ditoŋǃ<verse eid="MAT 13:43" /></para>
  <para style="s">kosei Nfɔnɔ Bom Arạba</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />&lt;&lt;Don ubasɛ uyạŋɛnɛ iya. one ɔtanɛ ɔkɔ hɛŋɛmạŋ nfɔnɔ bom kɛram. ubemɛ mạŋ kɛ ɔyaŋ, ɛkɔn ɔrɔmạŋ ɔkɔ rɛwɔ okpobi kɔkpai kɛtɔ, ukpe ndam ɔkɔ rɛu kɛram ɛyɛ.<verse eid="MAT 13:44" /></para>
  <para style="s">Kosei Kɔtan Inimɛ</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />Don ubasɛ uyạŋɛnɛ iya. one ibibuni kɔtan inimɛ akpogɔ, <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />ɔrɔnɛnɛ uwunɔ yunim, ɔkɔ rɛwɔ okpo bɛbɛ kpai kɛtɔ, ɔkɔ rɛu kɔtanɛyɛ.<verse eid="MAT 13:46" /></para>
  <para style="s">Kosei</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />Don ubasɛ uyạŋɛnɛ iya. ane bɛ woyɔ kibri akaranɛ irik kibri bɛbɛ kɛɔkpa kɛtama ayama kibri dɛyama. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Ayamanɛ kibri ɛbɛkpai, aduk ariyaŋ kɛ chiok ategi kibri ɛbɛːubunim aŋana kɛ dɛkpa ubɛ ɔka unim aroŋɔ. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />uremɛ nyɔnɔ kubisɛ ubasɛ uwukanː <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />iki kara ane ayinɛ kɛ ɛtɔ ekon, uwɛ ato ajibɛŋ daraŋ.<verse eid="MAT 13:50" /></para>
  <para style="s" />
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />&lt;&lt; Boba itama barun?Jizɔz ɔbɔubɛŋ. &gt;&gt;</para>
  <para style="p" vid="MAT 13:51">&lt;&lt;itama bara&gt;&gt; abɔnɔ Jizɔz.<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Jizɔz ɔbɔnɔ, uwa ɔnaninɛ iyɛ one wɛ uchiemi dɛman donɔ uwure wɔŋɛtɔ kɛ kpomɔ kɛbɔd ubasɛ uyạŋɛnɛ da one wɛ ɔkɔ ɛtɔ ɔlau okpo isin nɛ okpo itạmi kpai kɛ mbɔd yɛyɛ.<verse eid="MAT 13:52" /></para>
  <para style="s">Ayim Jizɔz kɛ Nazarɛd</para>
  <para style="r">(<ref loc="MRK 6:1-6">Mk. 6.1-6</ref>; <ref loc="LUK 4:16-30">Lk. 4.16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Jizɔz uyemɛ nɛ kosei ebakpai, uroŋɔ kpo kpe <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />ɔramạŋ kɛ don yɛyɛ. Jizɔz uchiemi kɛ kpomɔ kisumɔ bɛ ju, ane bɛ akomɔmạŋ ɛkpa ubebɛŋ. &lt;&lt;Ndɛ inɔŋɔ dukpeŋɛ uwa?&lt;&lt;Abɔu. kimạga bi isạdri nɛ kpai ke? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />wɔŋ kapinta urenɛ?wɔŋ Meri urenɛ, Jɛms, Josɛf, saimɔn nɛ judas bɔŋ ɔka ure arenɛ. ? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />bɔŋ ɔka anebani aa ure anuginɛ?ndi nɔŋɔ ikɔm ɔba?&gt;&gt; <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />ari yimạŋ. Jizɔz utekbɛŋ, &lt;&lt;One wɛ uhemi dɛman ubasɛ ikɔ dɛbad kpom kpai ure nɛ dɛbad ɔkɔ kɛ don nɛ kɛ ɛtɔ yɛyɛ. &gt;&gt;<verse eid="MAT 13:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58" />Ure kunɛŋɛ one ɔkɔ, ire kimạgɛ usạri kɛ don yɛyɛ.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">Dube Jɔn ɛyɛ Ubeŋi Ane Mạm</para>
  <para style="r">(<ref loc="MRK 6:14-29">Mk. 6.14-29</ref>; <ref loc="LUK 9:7-9">Lk. 9.7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />kubi ɛyɛ uru Hɛrɔd, ɔbɔd Galili, ukomɔ nɛ okpo bɛ Jizɔz iki sạdri. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />&lt;&lt; Amɛ ure nɛ Jɔn ɛyɛ ubeni ane mạm, uwɛ uwu kɛ kekpen, &gt;&gt;uhemɛ ane bɛ ayạŋ kreto. Amɛ usạri nɛ ɔkɔmɔ ikɔm usạd kimạga bɛ.<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Hɛrɔd iri wagi utom akayama Jɔn, abɔumạŋ akɔbimạŋ. usạri nɛ okpo bakpai kɛntak Hɛrɔdias, wani filip wɔŋ ɔka. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />kubi yakạn Jɔn yɛ ubeni ane mạm iri tekgɛ Hɛrɔd, &lt;&lt;Iyɛ unim amɛ Hɛrɔdias kɔbanǃ &gt;&gt; <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Hɛrɔd ubuninɛ ɔhanmạŋ, uni ane bɛ Ju, ure anɔŋɛnɛ jɔn da one wɛ uyemi dɛman ubasɛ.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />Kɛ dewe di dɛmara Hɛrɔd wɔŋ ona wani Hɛrɔdias uyu kuyu kɛ dure asin ɛbɛ iriwu. ɛkɔn iri rɔmɔ Hɛrɔd tata. <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />Utekmạŋ iyɛ amɛ iki yemạŋ bom nawunɔ ibubunɔ, ɔŋana dulim uye ɛkpa yɛyɛ amɛ ɔkakamạŋ uyạŋ<verse eid="MAT 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 14:8" />ɔka utekmạŋ sạŋ ubun deto Jɔn ɛyɛ ubeŋi ane mạm, amɛ utek Hɛrɔd &lt;&lt;nbuninɛ deto jɔn ɛyɛ ubeŋi ane mạm kɛ ɛmgbanǃ &gt;&gt;<verse eid="MAT 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 14:9" />ubian iri sạdri ɔbɔd, urenɛ amɛ iri tegɛmạŋ iyɛ amɛ iki yemạŋ bobɛ ibubunɔ kɛ dure asin yɛyɛ, uye dɛman iyɛ asạd bobɛ wɔŋ ɛwɛ ibuninɛ. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />asoŋɔ Jɔn deto kɛ nkpokɔbi. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />aŋana kɛ ɛmgban iri ye wɔŋ one wani yɛ, ɔbɛnɛ deto Jɔn ukuye ɔka. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />bɔŋ ɛtɔ Jɔn ari bɛnɛ ɛkpa Jɔn akani; arabɛŋ aka yemɛ Jizɔz.<verse eid="MAT 14:12" /></para>
  <para style="s">Jizɔz Uye Ane Dɔgɔd Aten Okpoji</para>
  <para style="r">(<ref loc="MRK 6:30-44">Mk. 6.30-44</ref>; <ref loc="LUK 9:10-17">Lk. 9.10-17</ref>; <ref loc="JHN 6:1-14">Jn. 6.1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Jizɔz ukomɔ nɛ bobɛ uterɛ Jɔn, utoŋɔ kokpok ɔramạŋ ɔkɔ biaga mạŋchen kakpom iyɔm ikakure, ane akomɔ nɛ, acheŋ kiyem atedmạŋ ndam. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Jizɔz ubạnɛnɛ kɛkokpok ɔrɔn dɛyɔgɔ, ubian ɔyamamạŋ uyebɛŋ, ubok uyum bɛbɛ.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />nɛ kiriɛ bɔŋ ɛtɔ bɛbɛ awukan aritekmạŋ, kubi kure dewe ibạnɛ, kpokpa iyɔm ubunɔ. wạmbɛŋ arabɛŋ kadon aka rɛu okpoji aji. &gt;&gt;<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />&lt;&lt; One kpokpa one ɔkɔ kuroŋɔ, Jizɔz ɔbɔnɔ. abon yebɛŋ okpoji ajiǃ&gt;&gt;<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />&lt;&lt; Bobɛ dɛkɔ a urenɛ kitawɔ ɔkara aten nɛ kibri awumɔ abɔnɔ, &gt;&gt;<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />Jizɔz ɔbɔnɔ&lt;&lt; Nɔŋ ariyenɛrun, &gt;&gt; <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />uye dɛman anekpai abiaga kɛ dɔchɛ; ɔbɛnɛ dakon dɔkara aten nɛ kibri awumɔ yɛ, ukoni kɛdewe uye ubasɛ dɛbad. ɔmiɛgɛ dakon dɔkara bɛ uye bɔŋ ɛtɔ bɛbɛ, achiemɛ aye ane bɛkpai <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />anekpai aji arok. abɛnɛ uwumuŋɔ akpasa jiou nɛ awumɔ. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />anebɛ aji okpo bɛ arenɛ ane dɔgɔd aten, bɔbɔŋɔ nɛ anebani one ɔŋana.<verse eid="MAT 14:21" /></para>
  <para style="s">Jizɔz ɔchɛŋ kɛ Mạm Dewe</para>
  <para style="r">(<ref loc="MRK 6:45-52">Mk. 6.45-52</ref>; <ref loc="JHN 6:15-21">Jn. 6.15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Jizɔz usạd bɔŋ ɛtɔ bɛbɛ ariɛ kɛ kokpok awari arabɛŋ kɔkpa kɛdama uran, utek anebɛkpai aya. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />kubisɛ itekgɛnɛ anebɛ aya, ɔramạŋ kɛ ikon ɔkɔ hanimạŋ durim. Jizɔz uyạŋ ɛ mạŋchen tata nɛ kiriɛ; <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />kubi iya kokpok utạm iyem iwạdrɛ kɔkpa kɛtama yɛ, ure kiwegi umurikɛ kokpok, kiwegi usạd kokpok ɛyɛ ɔwagi.<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />Kɛ kubi atenɛwun uwɛ kichi Jizɔz uwukan uterɛ bɔŋɛtɔ bɛbɛ, Jizɔz ɔchɛŋkɛ kɛmạm dewe. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Bɔŋɛtɔ bɛbɛ arɔn mạŋɛnɛ da ichɛŋi kɛmạm, kɛwɔd ɔyamabɛŋ. &lt;&lt;Kɛkɛ uburiǃ&gt;&gt; Atek, atogɔ kɛwɔd arod.<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />Kuburukpun Jizɔz ɔyɔm chiem nɛ abɛ. &lt;&lt;kporidun ɛkɔnǃ&gt;&gt; Utekbɛŋ. &lt;&lt;Aam amɛ. Kɛwɔd kaniduŋǃ&gt;&gt;<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />Pita ɔbɔnɔ. &lt;&lt;ɔbɔd, ure bobɛ irewɛ, ye ikɔm sạd nchɛŋ kamạŋ ndi seiwɛ. &gt;&gt;<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />&lt;&lt; Okeǃ&gt;&gt;Jizɔz utekmạŋ. Pita ɔnani kɛkokpok ɔsani kɔcheŋ kamạm dewe ɔramạŋ uru Jizɔz. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Pita ɔrɔnɛnɛ da kiwun ɛbara isạdri kɛwɔd usạdmạŋ ɔsani kɔlama. &lt;&lt;ɔbɔd nyaŋɛnɛ ɔsani kuto. &gt;&gt;<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />kubrukpun Jizɔz ɔyamamạŋ udubɔ ɔrawɔ kamạm, utekmạn, &lt;&lt;kuneŋɛ yoyo kɛ ubasɛ irɛgɛ obo ɛkaŋi?&gt;&gt;<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />bɛŋtoŋ awumɔ ariɛ kɛkokpok, kiwun yɛ ɔwa. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />bɔŋɛtɔ bɛbɛ kɛkokpok aye Jizɔz dɛbad. krehenhenɛ arenɛ wɔŋ ubasɛ. arod.<verse eid="MAT 14:33" /></para>
  <para style="s">Jizɔz Ubɛ Amayabɛŋ Kɛ Gɛnɛzarɛd</para>
  <para style="r">(<ref loc="MRK 6:53-56">Mk. 6.53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />akạd ɔkpa kɛtama yɛ awukan kɛ dɔchɛ kɛ Gɛnɛsarɛd, <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />uwɛ ane asiŋɛ Jizɔz. akayed ayunyumi kɛ don dɛbara bɛkpai ari ye Jizɔz. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />arenmạŋ sạŋ ɔsɛŋ bɛŋ awạma kɔbaraditoŋ yɛyɛ; ane bɛ awạma dɔbara ditoŋ yɛyɛ ɛkpa ukporibɛŋ.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">Kuchiemi bɛ ɔsɛ ɔsɛ</para>
  <para style="r">(<ref loc="MRK 7:1-13">Mk. 7.1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Bɛ Farasi nɛ anebɛ achiemi dɛman ubɛ awu Jɛrusɛlɛm atanɛ uru Jizɔz, aka bɔu mạŋ dɛbɔwɔ <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />&lt;&lt;Obusạri bɔŋɛtɔ yoyo agbiɛ kɛ okpo bɛ ɔsɛ asebori achegi bara? uwɛ ure mbɔk kɔsagi unim isai aji bomǃ&gt;&gt; <verse eid="MAT 15:2" /><verse number="3" style="v" sid="MAT 15:3" />Jizɔz ɔbɔnɔ, obusạri abon akpori duŋ ditoŋ krɛman ubasɛ iyaŋ asạri ated duŋ uboni? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Ubasɛ utega nɛ iyɛ ye akawo nɛ asewo dɛbad, ure bobɛ ɛragi akawo kạn de asewo ɛbɔgi dube. <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Abon achegi duŋɔ nɛ iyɛ ure bobɛ ane akɔ bom uwɛ abi togɔ aŋana ɔsɛ nɛ ɔka bɛbɛ kɔbɔk, iyɛ ɔkɔnɛ ubasɛ, <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />kuwɛ irenɛ nyɔi iyɛ ɔbɔgi ɔsɛ bɛbɛ dɛbad kuye. kiyem uwa dɛman ubasɛ dɛbad ayạŋ duŋ, sạŋ ated duŋ kuchegi uboni. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Abon bɛ nchɛǃ nạn irinim kubi Aizaya iŋemɛ nɛ dɛman ubasɛ uye baruŋǃ<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />&lt;&lt;Ubasɛ utek abonɔ ba, ayei nɛ duŋɔnɛ dɛbad kɛ chiem ɛma,</para>
  <para style="q2" vid="MAT 15:8">asi dɛkɔn duri boni iwạra naam. <verse eid="MAT 15:8" /><verse number="9" style="v" sid="MAT 15:9" />kuwɛ irenɛ iya</para>
  <para style="q1" vid="MAT 15:9">ɔbɔgi ajini duŋ deto ayei nɛ duŋ,</para>
  <para style="q2" vid="MAT 15:9">ire achegi duŋɔnɛ dɛman ane iyɛ de ubasɛǃ &gt;&gt;<verse eid="MAT 15:9" /></para>
  <para style="s">Okpobɛ Usạri One Ika Ɔrɔrɔ</para>
  <para style="r">(<ref loc="MRK 7:14-23">Mk. 7.14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Isai Jizɔz uyed ane dɛyɔgɔ awukan kamɛ, utek bɛŋ&lt;&lt; yɔrɔ duŋ kotoŋ sạŋ ɔtama baruŋǃ <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Okpo bɛ ɔriɛ wɛ kɛma ure usạri wɛ ɛka arɔrɔ, urenɛ bobɛ ɔnani wɛ kɛma. &gt;&gt; <verse eid="MAT 15:11" /><verse number="12" style="v" sid="MAT 15:12" />Isai bɔŋɛtɔ yɛyɛ awukan ari hema mạŋ, &lt;&lt; eyed iyɛ chiem ɛyɛ ɛnyɔmɔ nɛ bɛ Farasi akama ɛkɔn?&gt;&gt; <verse eid="MAT 15:12" /><verse number="13" style="v" sid="MAT 15:13" />Jizɔz ɔbɔnɔ bɛŋ &lt;&lt;bom nawunɔ ɔkanɛ detema asɛm kɛ lon ubasɛ ure, ɔkɛmɛ kukpạba. &gt;&gt; <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />&lt;&lt;ɛkpa boni afirɛ kaye duŋǃ arenɛ adạndạmi atogi adạndạmi iyem; ure bobɛ udạndạmi itogi udạndạmi iyem bɛntoŋ awumɔ akitɔ krɛma. &gt;&gt; <verse eid="MAT 15:14" /><verse number="15" style="v" sid="MAT 15:15" />Pita utek &lt;&lt;sạd boba ɔtama bara. &gt;&gt; <verse eid="MAT 15:15" /><verse number="16" style="v" sid="MAT 15:16" />Jizɔz utekbɛŋ &lt;&lt;tanichiŋ bom ayed duŋ arugɔ duŋ ane ubaran. <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Baruŋ ɔtama? bom nawunɔ ɔriɛ wɛnɛ kɛma ɔrai mạŋɛnɛ kutu isai ɔnani wɛ kɛkpa. <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Okpo bɛ ɔnani wɛ kɛma uwunɛ krɛ kɔnduri, ubɛ amɛ usạri wɛnɛ ɛkanɛ arɔrɔ. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Detema ayina uwuŋi nɛ krɛ kɔnduri uwɛ utogi wɛ iyem kone kɔŋan, kinema nɛ wani one, nɛ okpo arạgarạg da kayạw, nfu nɛ chiemɛ ndama. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Dɛmara ba amɛ usạri wɛnɛ one uwɛ ɔka ɔrɔrɔ. Okpo kuji uwɛ ɛkawɛ kɔbɔk asagi da ahemi ure usạri wɛ onewɛ ɔka ɔrɔrɔ. &gt;&gt;<verse eid="MAT 15:20" /></para>
  <para style="s">Kuneŋa onewani</para>
  <para style="r">(<ref loc="MRK 7:24-30">Mk. 7.24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Jizɔz iriroŋɔ ɛ ɔramạŋ don dɛbara Tire nɛ sidon. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Onewani kenan unugi ɛ uwukan utera mạŋ. Uto uyemạŋ &lt;&lt;wɔŋ ɔbɔd Devid&gt;&gt; &lt;&lt;tonɛ ubian ataǃ kɛwaŋ iyina ɔriɛnɛ wɔŋ uminiko nwam kɛkpa. &gt;&gt; <verse eid="MAT 15:22" /><verse number="23" style="v" sid="MAT 15:23" />Jizɔz mạŋ dɛman irikɔ, bɔŋɛtɔ yɛyɛ awukan atera mạŋ aren mạŋ, sạŋ uwạm mạŋǃ iyɛ uteri bɛŋ ndam usạri inyɔmǃ <verse eid="MAT 15:23" /><verse number="24" style="v" sid="MAT 15:24" />Jizɔz ɔbɔnɔ bɛŋ, &lt;&lt;asina nɛnɛ aye bɔŋɔ bɛ aten iyem kɛ izrɛl. &gt;&gt; <verse eid="MAT 15:24" /><verse number="25" style="v" sid="MAT 15:25" />Onewani wɛ iritɔ Jizɔz kaŋwun. &lt;&lt; ata ŋana nɛ kɔbɔk. &gt;&gt; <verse eid="MAT 15:25" /><verse number="26" style="v" sid="MAT 15:26" />Jizɔz ɔbɔnɔ mạŋ. &lt;&lt;ɔbɔgi kokpoji abɔŋ kɔnɔŋ akaye ɔbia. &gt;&gt; <verse eid="MAT 15:26" /><verse number="27" style="v" sid="MAT 15:27" />Onewani wɛ ɔbɔnɔ ata&lt;&lt; urenɛ nyɔi, &gt;&gt;&lt;&lt; asi ɔbia ajinɛ okpo bɛ ɔtɔŋi krɔchɛ kɛnɛnɛ ɔsɛtɔ. &gt;&gt; <verse eid="MAT 15:27" /><verse number="28" style="v" sid="MAT 15:28" />Jizɔz ɔbɔnɔ mạŋ, &lt;&lt;arenɛ ɔwani uwɛ ɔkɔ kuneŋa ɛbaraǃ akisạd bobɛ ebuni ayewɛ. &gt;&gt; kubru kpun wɔŋ wɛwɛ ukomɔ ɛkpa kporɔ.<verse eid="MAT 15:28" /></para>
  <para style="s">Jizɔz ubok ane dɛyama</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Jizɔz uroŋɔ ɛ ɔramạŋ Galili. ukubạd ikon ɔbiaga. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Ane dɛyama awukan atera mạŋ, atogɔ adạndạmi, anebɛ amiɛgi, amạmạmi nɛ ane dɛyema bɛ amai bɛŋ ariyaŋ mạŋ kaŋwun amɛ ubok bɛŋ. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />ɛkpa ube anebɛ uwɛ arɔn da umạmạmi inyɔmi chiem, onewɛ ɔmiɛgi ɔchɛŋ, udạndạmi ɔrɔn iyem isai aye ubasɛ izrɛl dɛsama.<verse eid="MAT 15:31" /></para>
  <para style="s">Jizɔz Uye ane Dɔgɔd Anaŋ kokpoji</para>
  <para style="r">(<ref loc="MRK 8:1-10">Mk. 8.1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Jizɔz iriyed bɔŋɛtɔ yɛyɛ usumɔ utek bɛŋ, &lt;&lt;ubian aneba isạdri nɛ, ire kɛ dewe asiri ayạŋ naam okpo one uji. bɛŋ kɛya mbunɔ kusina uwɛ aka okpo one uji, abeŋ da aburɔ kiyem uwɛ ayayanɛ. &gt;&gt; <verse eid="MAT 15:32" /><verse number="33" style="v" sid="MAT 15:33" />Bɔŋɛtɔ yɛyɛ abɔu mạŋ, &lt;&lt;nda uwɛ dɔrɔn okpoji kɛ kpom iwunɔ ya uwɛ ubeŋa ane ayamaba?&gt;&gt; <verse eid="MAT 15:33" /><verse number="34" style="v" sid="MAT 15:34" />Jizɔz ɔbɔu bɛŋ &lt;&lt;kitawɔ ɔkara aa umuŋɔ?&gt;&gt; abɛ abɔnɔ iyɛ &lt;&lt;kitawɔ ɔkara atenan, &gt;&gt; &lt;&lt;nɛ kibri wɔŋ umuŋɔnɛ. &gt;&gt; <verse eid="MAT 15:34" /><verse number="35" style="v" sid="MAT 15:35" />Jizɔz utek anebɛ kpai abiaga krɔchɛ. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />ɔna bɔŋɛtɔ yɛyɛ kitawɔ ɔkara atenan nɛ kibri yɛ, uye ubasɛ dɛsama, ɔmiɛk bɛŋ, uye bɔŋɛtɔ yɛyɛ; bɔŋɛtɔ achiema aye anebɛ. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />Abɛ kpai aji ubeŋa bɛŋ. Isai bɔŋɛtɔ yɛyɛ abaŋa kɛ kimuŋɔ okpoji uyugɔ kɛ akpasa atenan. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Anerum ubɛ aji arenɛ dɔgɔd anaŋ, uwɛ anebani nɛ bɔbɔŋɔ one ɔbaga. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Isai Jizɔz usina bɛŋ kɛya, ɔriɛ kɔkpok ɔramạŋ magadan.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">Kimạga kubun</para>
  <para style="r">(<ref loc="MRK 8:11-13">Mk. 8.11-13</ref>; <ref loc="LUK 12:54-56">Lk. 12.54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Bɛ Farasi nɛ sadusi awunɛ ari hɛk jizɔz, aritekmạŋ usạd kimạga sạŋ abɛ aneŋa kạn uwu kubasɛ. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />Jizɔz ɔbɔnɔbɛŋ, &lt;&lt;kubi uwɛ ewe ɔya akitekduŋ iyɛ dewe inim. <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Iyɛ ɔkɔyan nɛkichi atekduŋ iyɛ iki tou, akɛmɛnɛ chiem kuhemɛ nɛ dewe uwɛ ebirɛ jɛn akonɔ dewe. <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Obusạri ane ngunɔ isai akɔmɔ dɛmara ya? iyɛ ŋsạd kimạga afira kure kimạga jona amɛ mbuninɛ nye baruŋ. &gt;&gt;<verse eid="MAT 16:4" /></para>
  <para style="s">Kuburɔ Bɛ Farasi Nɛ Bɛ Sadusi</para>
  <para style="r">(<ref loc="MRK 8:14-21">Mk. 8.14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />kubi yɛ bɔŋɛtɔ jizɔz akrinɛ ɔkpa kɛtama ari roŋɔ kokpoji bɛbɛ. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Jizɔz utek bɛŋ&lt;&lt; koibaruŋ; unim akomduŋ bobɛ farɛsis nɛ sadusi atok awuŋi. &gt;&gt; <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />Bɔŋɛtɔ asani chiem bɛŋ bɛŋ atek, &lt;&lt;ibitega nɛ kitawɔ ɔkara ye ɛkanɛ atok duŋ amɛ usạri baruŋɔ nɛ&gt;&gt;. <verse eid="MAT 16:7" /><verse number="8" style="v" sid="MAT 16:8" />Jizɔz ɔbɔu bɛŋ, &lt;&lt;obo eyibiduŋ ɛkpa boni nɛ kokpoji wɔŋ? obusạri kunɛa boni orɛgɛǃ <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />dukpeŋa akɔ duŋ? baruŋ arama da ndimiɛgi kitawɔ ɔkara dikạkạra aten nye ane dɔgɔt aten uwɛ ane aji umuŋɔ ikari atenan. <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Baruŋ arama da ane dɔgɔt anaŋ aji dikạkạra atenan? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Obusạri uremɛ iyɛ abon kɔtama akɔruŋ ayenɛruŋ iyɛ chiemɛ kitawɔ ɔkara ure aam nyɔmi nɛ abon? Koi baruŋ nɛ bobɛ usạri kitawɔ ɔkara uburɔ bɛ Farasi nɛ bɛ sadusiǃ &gt;&gt; <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />Kɛ ikạmasi bɔŋɛtɔ yɛyɛ awunɛ arikɔmɔ kɔtama iyɛ Jizɔz bɛŋ kotoŋ udugi akoibɛŋ nɛ bobɛ uyạŋi kɛ kitawɔ ɔkara ukusarimạŋ uburɔ asi akɔbɛŋɛnɛ kukoi nɛ bobɛ bɛ Farisi nɛ bɛ Sadusi achegi.<verse eid="MAT 16:12" /></para>
  <para style="s">Kuwena Pita Isạri Nɛ Dokom Jizɔz</para>
  <para style="r">(<ref loc="MRK 8:27-30">Mk. 8.27-30</ref>; <ref loc="LUK 9:18-21">Lk. 9.18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Jizɔz iriramạŋ kasaria Filipi ɛ amɛ iboinɛ bɔŋɛtɔ bɛbɛ kạn &lt;&lt;obo ane aboi bobɛ amɛ ire?&gt;&gt; <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" />&lt;&lt;Arạgarạg atek iyɛ urenɛ jɔn, &gt;&gt; &lt;&lt;arạgarạg atek iyɛ ure ɛlaija, arạgarạg atek iyɛ awu are nɛ jɛrimaya one wɛ uhemi dɛman ubasɛ. &gt;&gt; <verse eid="MAT 16:14" /><verse number="15" style="v" sid="MAT 16:15" />Jizɔz ɔbɔu bɛŋ &lt;&lt;abon obo etegadun iyɛ am nde?&gt;&gt; <verse eid="MAT 16:15" /><verse number="16" style="v" sid="MAT 16:16" />Saimon pita , ɔbɔnɔ &lt;&lt;awu arenɛ onewɛ uchegi nfɔnɔ iyem, wɔŋ ubasɛ. &gt;&gt; <verse eid="MAT 16:16" /><verse number="17" style="v" sid="MAT 16:17" />Jizɔz utek &lt;&lt;imim nawu, saimon wɔŋ jɔnǃ&gt;&gt;&lt;&lt;kɛ krehehena ya asɛm krewe iyiŋwɛnɛ. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Pita am disạdriwɛ kɔtan, kakpokpa nki bɔu ɛtɔ dulimɛ uwɛ ndemɛ dube sạŋ mạŋ ɔkɛmɛ kuburi. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Aam nki yewɛ igodo uwɛ deweɛ uwɛ ure, bobɛ eyeyerɛ urenɛ nyɔi. <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />ɛnɛ amɛ Jizɔz itegɛnɛ bɔŋɛtɔ yɛyɛ iyɛ ane onekuhema iyɛ demạŋ ure onewɛ uchegi iyem.<verse eid="MAT 16:20" /></para>
  <para style="s">Chem Jizɔz Krutugɔ Nɛ Dube yɛyɛ</para>
  <para style="r">(<ref loc="MRK 8:31-9:1">Mk. 8.31—9.1</ref>; <ref loc="LUK 9:22-27">Lk. 9.22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />kɛkpokpɛ amɛ Jizɔz, iŋemɛnɛ bɔŋɛtɔ yɛyɛ iyɛ amɛ ikiramạŋ jɛrusɛlɛm ɔkɔnɔŋ dutugɔ ka abɔd nɛ anebɛ ayaya dɛman. Iyɛ amɛ ikibe asi amɛ ikikaimạŋ kiri dewe asiri. <verse eid="MAT 16:21" /><verse number="22" style="v" sid="MAT 16:22" />Pita uyedmạŋ ɔkɔba kusigi utek ubasɛ sạŋ uyera, amɛ ɔbɔnɔ boba sạŋ wɛ ɔnani. <verse eid="MAT 16:22" /><verse number="23" style="v" sid="MAT 16:23" />Jizɔz utek pita doŋɔ kpokpa bobɛ ɛŋaninɛkɔn ɛ kubasɛ ure iwu, uwunɛ kone. <verse eid="MAT 16:23" /><verse number="24" style="v" sid="MAT 16:24" />Jizɔz uboŋɔmạŋ utek bɔŋɛtɔ yɛyɛ onenawunɔ ubunɔchɛŋ naam, ɔlawɔ ɛkɔn kɛkpa yɛyɛ ɔbaŋa bobɛ ɔkɔmạŋ utednɛdam. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Abubuni atunɔ ekpen aye ɛkpa yoyo ikinaŋiwɛ, asi atutunɔ ekpen ayenɛ akikɔmɔ ekpen. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Akibam okpo ŋunɔ kɔkɔmɔ aroŋɔ ekpen yoyo? bomnawunɔ kure ɛkɛmɛ kutogɔ akɔmɔ ekpen. <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Wɔŋ ubasɛ ikiwukan krɛbad ɔsɛ nɛ bɔŋɛtɔ yɛyɛ, ikinoŋi baruŋ kreto kreto krotomɔ boni. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Sạŋ ŋyema baruŋ arạgarạg ayiŋkɛ aa sạŋ one ube tata arɔn wɔŋ one kɛbiaga kɛbɔdɔ.<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">Okpo Kuboŋɔ</para>
  <para style="r">(<ref loc="MRK 9:2-13">Mk. 9.2-13</ref>; <ref loc="LUK 9:28-36">Lk. 9.28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Kiri dewe aten uwun Jizɔz utogɔ Pita nɛ bɔŋɔka Jems nɛ Jɔn ubạd ikon aka biaga bɛŋchen. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Iyɛ abira jɛn, dure Jizɔz ihena da ewe, dɔbara yɛyɛ uvuri. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Kɛkpokpɛ ame bɔŋɛtɔ Jizɔz asiri bɛ arɔnɔnɛ da Moziz nɛ ɛlaija anyɔmichiem nɛ Jizɔz. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />Pita ɔbɔu Jizɔz &lt;&lt;ata obure dotomɔ yori anaǃ ntemɛnɛ ŋbɔu ikurɔ asiri uwunɔ uwowo, uwunɔ uwɛ mosis, uwonɔ uwɛ ɛlaija. &gt;&gt; <verse eid="MAT 17:4" /><verse number="5" style="v" sid="MAT 17:5" />Uwɛ inyɔminɛ chiem nɛ Jizɔz uyam ubạna bɛŋ kɛkpa, dɛman ɔnani krewe utek beŋ &lt;&lt;uwa urenɛ wɔŋwam kamɛ dikɔmɔ ɔkɔndom, komɔ ayemạŋdunǃ &gt;&gt; <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />Bɔŋɛtɔ Jizɔz akɔmɔnɛ dɛman ɛyɛ kɛwɔd usạd bɛŋ, abɛ kpai ajina deto. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Jizɔz ɔchɛŋ useibɛŋ uwạmɔbɛŋ, utekbɛŋ &lt;&lt;ba duŋ ɔba&gt;&gt; &lt;&lt; kasɛŋɛ kɛwɔd usạd baruŋǃ &gt;&gt; <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Abɛ abira deto Jizɔz mạŋchen umuŋɔnɛ. <verse eid="MAT 17:8" /><verse number="9" style="v" sid="MAT 17:9" />Abạnanɛ kikon, Jizɔz utek bɛŋ, bobɛ ɛrɔnduŋɔnɛ aa, &lt;&lt;one nawunɔ kayema duŋ tata wɔŋ one ɔkagimạŋ krube. &gt;&gt; <verse eid="MAT 17:9" /><verse number="10" style="v" sid="MAT 17:10" />Bɔŋɛtɔ Jizɔz abɔu Jizɔz, &lt;&lt;obusạri anebɛ achegi demana lonɔ atek iyɛ ɛlaija ikichiemi uwukan?&gt;&gt; <verse eid="MAT 17:10" /><verse number="11" style="v" sid="MAT 17:11" />Jizɔz ɔbɔnɔ, &lt;&lt;ŋyɔi ɛlaija ikichiemi uwukan, &gt;&gt; &lt;&lt;irinoŋi kpom ɔyaŋ. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Sạŋ nyemɛ baruŋ ɛlaija isisi uwukan abon ariyeduŋ, atogɔmạŋ asạd da ɛbamduŋ urekɛnɛ nyɔi kubiuwɛ aam nwukan. &gt;&gt; <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />ɛ amɛ bɔŋɛtɔ yɛyɛ akɔnɛ dukpeŋa iyɛde Jɔn ubeŋinɛ ane mạm.<verse eid="MAT 17:13" /></para>
  <para style="s">Jizɔz Ubok Wɔŋ Oneruw Ɔkɔ Kuron Iyina</para>
  <para style="r">(<ref loc="MRK 9:14-29">Mk. 9.14-29</ref>; <ref loc="LUK 9:37-43">Lk. 9.37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Ayaŋanɛ awukan krɛyɔgɔ, onerum uwunɔ ukukpạk ndu uye Jizɔz. <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />Utek, ata kasi towɔŋwam ubian ɔmai mạŋɛnɛ kɛnad ɔtɔŋinɛ kekon nɛ kamạm. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Ditokmạŋ ndanɛ kɛ bɔŋɛtɔ yoyo onemạŋ ubogi. <verse eid="MAT 17:16" /><verse number="17" style="v" sid="MAT 17:17" />Jizɔz ɔbɔnɔ, &lt;&lt;obusạri ɛka kunenŋa akɔmiǃ &gt;&gt; nạn ebuni nchirɛ aa nabon? di aa mbuni ntogɔ nchegi baruŋ bom? togɔmạŋ awukanǃ &gt;&gt; <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />atok mạŋɛnɛ uwukan Jizɔz ɔnyɔm chiem, kɛwaŋ iyina ɔnani wɔŋɔwɛ kɛkpa, kubru kpun ukɔmɔ ekpakporɔ.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Bɔŋɛtɔ jizɔz aribɔu Jizɔz kɛtɔkɔn ata &lt;&lt;obusạri abod dɛka dɔkɛmɛ dubokmạŋ?&gt;&gt; <verse eid="MAT 17:19" /><verse number="20" style="v" sid="MAT 17:20" />Jizɔz ɔbɔnɔbɛŋ &lt;&lt;kuneŋa akɔduŋ ubeŋa &gt;&gt;, ire &lt;&lt;ebi kɔduŋ kuneŋa ndema ɔregɛ da nji jɛn, ɛkɛmɛ kutek ikonɛya doŋɔ ikạm ɛyạŋɛnɛ asinawɛ krure urema nyɔiǃ &gt;&gt;&gt;<verse eid="MAT 17:20" /></para>
  <para style="s">Jizɔz Ɔnyɔm Kɛ Chiemɛ Dube Yɛyɛ</para>
  <para style="r">(<ref loc="MRK 9:30-32">Mk. 9.30-32</ref>; <ref loc="LUK 9:43-45">Lk. 9.43-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Jizɔz nɛ bɔŋɛtɔyɛyɛ akpenɛ awukan Galili, Jizɔz utek bɛŋ &lt;&lt;akisɛŋ wɔŋone aye anenbɛ abuni atɔmạŋ mbɔk <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />Uwɛ aŋan mạŋ asi kiri dewe asiri iki kagimạŋ kɛ kekpeŋ. &gt;&gt; bɔŋɛtɔ yɛyɛ akomɔnɛ bobɛ Jizɔz inyɔmɔ abɛkpai asạma deto krɔchɛ.<verse eid="MAT 17:23" /></para>
  <para style="s">Akpogɔ Keweya Kɔkpɛŋi Kɛ Kpomɔ Dulimɛ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Jizɔz nɛ bɔŋɛtɔ yɛyɛ arirabɛŋ kapɛnum, ɛnɛ onewɛ ukpạni akpogɔ kpomɔ dulimɛ iribɔu pita &lt;&lt;asewo ɛtɔ ɔkpɛkɛ akpogɔ ya?&gt;&gt; <verse eid="MAT 17:24" /><verse number="25" style="v" sid="MAT 17:25" />Pita ɔbɔnɔ mạŋ &lt;&lt;ɔkpɛkɛ. &gt;&gt; Akpenɛ kɛtɔ, Jizɔz ɔbɔu &lt;&lt;saimɔn nạn ɛrɔn boba, mạn one ɔbɔgi akpogɔ ya kɔkpɛ aye ɔbɔdɔ ŋunɔ? de wɔŋɔ lonɔ kạn de usin?&gt;&gt; <verse eid="MAT 17:25" /><verse number="26" style="v" sid="MAT 17:26" />Pita iyɛ &lt;&lt;de usin, &gt;&gt; Jizɔz utekbɛŋ &lt;&lt;afira kure, &gt;&gt; uwɛ &lt;&lt;ɔnani iyɛ wɔŋɔlonɔ ɔbɔgi kɔkpɛ. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Jizɔz utekbɛŋ bom dukusạri aneba akam ɛkɔn. nɔŋ ɔhɔb arawɛ ke ɔkpa kɛtama kara. Uchiemi kibri uwɛ awai wiŋamạŋ, ɛma akirɔn akpogɔ lawɔ akayebɛŋ da akpogɔ keweya yori. &gt;&gt;<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">Banɛ Are Onewɛ Ɔbara Urugɔ</para>
  <para style="r">(<ref loc="MRK 9:33-37">Mk. 9.33-37</ref>; <ref loc="LUK 9:46-48">Lk. 9.46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Bɔŋɛtɔ Jizɔz ariwu aribɔu Jizɔz, &lt;&lt;banɛ are onewɛ ɔbara urugɔ kɛ don dɛbara ubasɛ?&gt;&gt; <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />Jizɔz uyed wɔwɔŋɔ iriba bɛŋ krure, <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />Jizɔz utek bɛŋ &lt;&lt;akɛmɛnɛ don dɛbara ubasɛ kɔta urebobɛ ɛkɛmɛ ayạŋɛ da wɔwɔŋɔ. &gt;&gt; <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Onewɛ ɔbara urugɔ kɛ don dɛbara ubasɛ urenɛ onewɛ ɔtɔnɔmạŋ uyạŋɛ da wɔwɔŋɔ. <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />One nawunɔ ubirɛ wɔwɔŋɔ kɛbiaga ubirɛ nɛnɛ kɛbiaga.<verse eid="MAT 18:5" /></para>
  <para style="s">Kɔŋɛk Kokpo Ayinɛ</para>
  <para style="r">(<ref loc="MRK 9:42-48">Mk. 9.42-48</ref>; <ref loc="LUK 17:1">Lk. 17.1</ref>,<ref loc="LUK 17:2">2</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />&lt;&lt;Onenawunɔ uwɛ usạd wɔwɔŋɔ ɔwanɛ kisạnɛ, ibɔgi akpạni datan abɔumạŋ krukud asina aŋana kɔkpa yɛ ulạma. <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />Urenɛ bom ɛnyaŋa kɛ ŋun kabom nawunɔ uwɛ usạd one ɔwa kisạnɛ kɔkɔmɔ, ire okpobɛ ɔnanikɛ ane asi sạŋ unim uye onewɛ usạri okpobɛǃ <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" />&lt;&lt;Ure bobɛ mbɔk nɛ nwun yoyo isạdriwɛ kisạnɛ akɔ, ibɔgi asoŋɔmạŋ alawɔǃ ire inim one kunugi mbɔk nɛ nwun ɔkɔ urugɔ one mbɔk nɛ nwun kɔkɔmɔ anɔŋmạŋ akara kekon. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Ure bobɛ jɛn yoyo isạdriwɛ kisạnɛ akɔ, laŋimạŋ aroŋɔǃ ire inim one kunugi nɛ jɛn uwunɔ urugɔ jɛn awumɔ kɔkɔmɔ anɔŋwɛ akara kekon.<verse eid="MAT 18:9" /></para>
  <para style="s">Kosei Awɔŋ Uwɛ Urạma</para>
  <para style="r">(<ref loc="LUK 15:3-7">Lk. 15.3-7</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />&lt;&lt;Okpo bɔŋɔba kanɔŋɔ da bom ɔnani. ire bɔŋɛtɔ ubasɛ kɛ lon ubasɛ, ayạŋɛnɛ nɛ okpobɛ ɛkanɛ kabom anɔŋɔ na asɛm kɛ lonɔ kɛbɔd ubasɛ. <verse eid="MAT 18:10" /><verse number="12" style="v" sid="MAT 18:12" />&lt;&lt;Obo awu ɛyaŋ ɛkɔn one ibisạdri onewɛ utogɔ ane dɛnau aten iyem uwunɔ ɔnaŋimạŋ urạm? iki roŋɔ ane dɛnau anaŋ nɛ dokoro nanaŋ ukubun uwunɔ wɛ urạmɛnɛ. <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Ure bobɛ irɔnmạŋ, ikikomɔ ɔkɔndɔm kuwunɔ wɛ urugɔ dɛnau anaŋ nɛ dokoro nanaŋ aba akạni. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Amɛ usạrinɛ asewori kɛ lon ubasɛ ikanɛ ubunɔ okpo bɔŋɔba ɔnaŋimạŋ.<verse eid="MAT 18:14" /></para>
  <para style="s">Urebobɛ One Isạri Bomiyinɛ</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />&lt;&lt;Ure bobɛ wɔŋakawo isạdriwɛ bomiyinɛ, kabiaga namɛ bantoŋ awumɔ ayema mạŋ. Ure bobɛ iyɔrɔ kotoŋ uyewɛ nɔŋmạŋ kɛ da wɔŋakawo. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Ure bobɛ ikawɛ kotoŋ ɔyɔrɔ uye, nɔŋ one uwunɔ kande awumɔ amara nɛ ɛkpa yoyo, &lt;sạŋ bom nawunɔ amɛ inyɔnyɔmɔ ɔnɛnɛ one anebɛ akiremɛ ane ubɛ ahemɛ bobɛ amɛ inyɔmɔ kɛ dure ane da anebɛ aba arɔn, da kusɛgɛ Ubasɛ itega dusạd. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Ure bobɛ ika ubunɔ kukomɔ, nɔŋ okpo kpai ɔnani baruŋ ahemɛ aye ɛtɔɛrɛri, ure bobɛ ika ukomɔ uye ɛtɔɛrɛri yạŋɛ namɛ ayena iyɛ uwɛ kbasɛ uneŋa.<verse eid="MAT 18:17" /></para>
  <para style="s">Uwɛ Dɛkadubunɔ Nɛ Uwɛ Debuni</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />Sạŋ nyema baruŋː bom nawunɔ ayera krɔchɛ nyɔi amɛ ayera nɛ kɛ lon ubasɛ, bom nawunɔ ayạŋ ikɔm krɔchɛ aki ye ikɔm kɛ don ubasɛ. <verse eid="MAT 18:18" /><verse number="19" style="v" sid="MAT 18:19" />&lt;&lt;Bom nawunɔ ɛbiaga duŋ anyɔm ayera duŋ aŋani baruŋ dulim, asɛm kɛ lon ubasɛ ikisạd uyebaruŋ <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Uwa usạrinɛ duyenɛ iyɛ kạmisi ane awumɔ kạn de asiri ayạŋ krokom nyam aam nyạŋɛnɛ. &gt;&gt;<verse eid="MAT 18:20" /></para>
  <para style="s">Kosei Wɔŋɛtɔ Aka One Ɔkagi Aye</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Pita iribɔu Jizɔz, &lt;&lt;Ata ure bobɛ wɔŋakam igbiɛ nɛ nkpaŋ aa uwɛ nkaginɛ nyemạŋ? de nkpaŋ atenan?&gt;&gt; <verse eid="MAT 18:21" /><verse number="22" style="v" sid="MAT 18:22" />Jizɔz obɔnɔmạŋ &lt;&lt;nyɔi ure nkpaŋ dɛnau asiri nɛ jio kakpom atenan. <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />Ire kinạk kɛ lon dɛbara ubasɛ urenɛ nyɔi. Iriyạŋ kubi ɔbɔd iri nyɔŋi bobɛ bɔŋɛtɔ yɛyɛ akasạri. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />ɔsani nɛ nyɔi kusạd kubiyɛ atok wɔŋɛtɔ yɛyɛ utumạŋ kɛma awukan. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />wɔŋɛtɔ wa akpogɔ ɔkɔ uwɛ utogɔ ɔrɛmɛ kema itum ɔsɛtɔ, ɔbɔdɔwɛ utek anɔŋ mạŋ nɛ wani nɛ bɔŋ akarɛwɔ sạŋ atogɔ akpogɔ yɛ arɛmɛ kɛma yɛyɛ. <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />Wɔŋɛtɔ wɛ ukpạk ndu uren ɔsɛtɔ &lt;kasi kom&gt; ata &lt;nki rɛnɛ nyemạŋ bobɛ ntum mạŋ. &gt; <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />ɔbɔdɔwɛ utomạŋ ubian utekmạŋ ɔramạŋ. <verse eid="MAT 18:27" /><verse number="28" style="v" sid="MAT 18:28" />Wɔŋɛtɔ wɛ ɔnani nɛ krɛbom ɔkɔrɔn onewɛ utummạŋ akpogɔ wɔŋ ɔyama mạŋ utek mạŋ &lt;yenɛ bobɛ etum nɛǃ &gt; <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />Onewɛ ɔtɔmạŋ kaŋwun, utekmạŋ &lt;kasi kom nɛ ikiyewɛ kɛma yoyoǃ &gt; <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />Amɛ uyim; iyɛ amɛ ikinɔmạŋ ɔkɔyaŋ kɛtɔ dutạk, kubi iyiyiŋmạŋ akpogɔ yɛyɛ alawɔmạŋ. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />bɔŋɛtɔ ubarani arɔnɔnɛ bobɛ wɔŋɛtɔ wɛ utumɔnɛ ɔbɔd kɛma isạdri nɛ onewɛ utumạŋ kɛma akam ɛkɔn akayema ɔbɔd bobɛ arɔn. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />ɔbɔd utom ayedmạŋ uwunɛ ɔbɔd utekmạŋ &lt;awu one tama&gt; akpogɔ etumnɛ ibara aam &lt;ditegawɛ siŋ atogɔ arawɛ. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Obusạri awu ɛka nyɔi asạri aye one urạgarạg da aam nsạdri nyewɛ. &gt; <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />ɔbod irikam ɛkɔn ɔnɔmạŋ ɔkɔŋana kɛtɔ dutạk utekmạŋ ayạŋana tata arɛmɛ kɛma nyam. &gt;&gt; <verse eid="MAT 18:34" /><verse number="35" style="v" sid="MAT 18:35" />Jizɔz utek, &lt;&lt;asɛm kɛ don ubasɛ ibuninɛ usạd nyɔi nɛ one nawunɔ uwɛ ɔkamạŋ ɔkagi uye wɔŋɔka kubi igbiɛ mạŋ. &gt;&gt;<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">Jizɔz Uchegi Ɔban Kɔla</para>
  <para style="r">(<ref loc="MRK 10:1-12">Mk. 10.1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Jizɔz uŋemɛ bɛŋɛnɛ kpai, uroŋɔ Galili ɔramạŋ Judin ndamayɛ ɔbaŋimạŋ nɛ ɔkpa jodan. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Jizɔz utuminɛ, ane dɛyama atedmạŋ ndam ame ubok bɛŋ. <verse eid="MAT 19:2" /><verse number="3" style="v" sid="MAT 19:3" />Jizɔz iyạŋɛnɛ bɛ Farisi awukan ɛ abuni dauwɛ aŋanimạŋ mbɔk kutu akomɔmạŋ chiem kɛma &lt;&lt;abɔumạŋ, ibɔgi onerum waniwɛwɛ kuroŋɔ ?&gt;&gt; <verse eid="MAT 19:3" /><verse number="4" style="v" sid="MAT 19:4" />Jizɔz ɔbɔubɛŋ, &lt;&lt;arayeduŋ kɛ kusɛgɛ ubasɛ da ŋun irisani iyɛ ariborinɛ anerum nɛ anebani? <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />Isai ubasɛ utek, kuwɛ irenɛ iya onerum iki roŋɔ ɔsɛ nɛ ɔka uku yạŋɛ nɛ onewani bɛŋtoŋ awumɔ arema uwunɔ. <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Awumɔ one irire kɛ kpokpɛ one nawunɔ kɔchari bobɛ ubasɛ inɔgɔ usumɔ. &gt;&gt; <verse eid="MAT 19:6" /><verse number="7" style="v" sid="MAT 19:7" />Bɛ Farisi abɔu Jizɔz, obusạri mosis ɔyaŋ dɛman iyɛ sạŋ ɔban kɔla iyạŋɛ? <verse eid="MAT 19:7" /><verse number="8" style="v" sid="MAT 19:8" />Jizɔz ɔbɔnɔ, &lt;&lt;Moziz ɔyaŋanɛ dɛman ɛyɛ uwukan da abon eyoŋɔ duŋ asi kɔsani nyɔi ure ire. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Jizɔz utek bɛŋ, one nawunɔ ɔlaŋanɛ ɔban nɛ waniwɛwɛ ɔkɔban onewani urạgarạg kuwɛ wani wɛwɛ ika afirɛ kutu dɔmad ɔkɔ isạdri bomiyinɛ. &gt;&gt; <verse eid="MAT 19:9" /><verse number="10" style="v" sid="MAT 19:10" />Bɔŋɛtɔ Jizɔz atekmạŋ, &lt;&lt;ure bobɛ ire nyɔi kɔban ikinim dɔwa ɔban. &gt;&gt; <verse eid="MAT 19:10" /><verse number="11" style="v" sid="MAT 19:11" />Jizɔz utek bɛŋ bobɛ nchegina ane kpai ure ikɔ, ɔkɔnɛ anebɛ ubasɛ iyạŋ bobɛ. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Okpo iyama uwɛ usạd ane dɛyama sạŋ ɔban one usạri, arạgarạg dɛmara bɛbɛ uyạŋɛnɛ nyɔi, arạg arạg ane asạri bɛŋɛnɛ, arạg arạg ɔban one ubunɔ sạŋ akɛmɛ arabɛŋ lon ubasɛ. Uwɛ ɔkɛmɛ usạd da chiem ubasɛ ichegi sạŋ mạŋ usạd.<verse eid="MAT 19:12" /></para>
  <para style="s">Jizɔz Unoŋi Boboŋɔ</para>
  <para style="r">(<ref loc="MRK 10:13-16">Mk. 10.13-16</ref>; <ref loc="LUK 18:15-17">Lk. 18.15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Ayạŋɛnɛ ane atogɔ bɔŋ bɛbɛ awukan iyɛ sạŋ Jizɔz ɔnɛnɛ bɛŋ kɔbɔk ɔŋana dulim uyebɛŋ, bɔŋɛtɔ yɛyɛ asega bɛŋ. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Jizɔz utek &lt;&lt;doŋɔbɛŋ awukan bɛŋ kasega, kpomo kɛbɔd kɛ lon ubasɛ ɔkɔbɛŋɛnɛ. &gt;&gt; <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Jizɔz ɔnɛnɛ bɛŋ kɔbɔk isai uroŋɔ bɛŋ.<verse eid="MAT 19:15" /></para>
  <para style="s">Urumko Uwɛ Ɔkɔ Akpogɔ</para>
  <para style="r">(<ref loc="MRK 10:17-31">Mk. 10.17-31</ref>; <ref loc="LUK 18:18-30">Lk. 18.18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Onerum iriwu utera Jizɔz. &lt;&lt;onewɛ uchegi, &gt;&gt; ɔbɔumạŋ &lt;&lt;obo uwɛ nsạd, sạŋ nkɔmɔ ekpen kotomotom?&gt;&gt; <verse eid="MAT 19:16" /><verse number="17" style="v" sid="MAT 19:17" />Jizɔz ɔbɔumạŋ. &lt;&lt;obusạri abɔunɛ dɛbɔwɔ uwɛ ɔragamạŋ kɛ nfɔnɔbom?&gt;&gt; &lt;&lt; iyem uwunɔ mạŋchen urenɛ nfɔnɔbom uwɛ ure dɛbɔ ubasɛ kuted. Ayaŋ dɛman ubasɛ ure bobɛ ebuni ekpen kotumotum. &gt;&gt; <verse eid="MAT 19:17" /><verse number="18" style="v" sid="MAT 19:18" />Amɛ ɔbɔu, &lt;&lt;mạn dɛman?&gt;&gt; Jizɔz ɔbɔnɔ, &lt;&lt;one kaŋana; nɛ onewani one kanema; bom ka yạwi kahema bobɛ ɛka arɔn. <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />Ye akawo nɛ asewo debad, bam anebɛ ayạŋ nawu da ɛban ekpayoyo. &gt;&gt; <verse eid="MAT 19:19" /><verse number="20" style="v" sid="MAT 19:20" />&lt;&lt;Onewɛ iye amɛ isạdri okpobɛ kpai, &gt;&gt; ɔbɔu Jizɔz &lt;&lt;mạn uwu umuŋɔ?&gt;&gt; <verse eid="MAT 19:20" /><verse number="21" style="v" sid="MAT 19:21" />Jizɔz utekmạŋ &lt;&lt;ure bobɛ ebuni arema nfɔnɔ one, duŋ ka rɛwɔ bobɛ ɛkɔ kpai anɔŋ akpogɔyɛ ɛrɛwɔ nɛ okpobɛ akaye anebɛ aka bom one ɔkɔ asạsạdri nyɔi akikɔmɔ okpo dɛyama kɛ lon ubasɛ; isai awukan arichɛŋi naam. &gt;&gt; <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" />Onewɛ ukomɔnɛ bobɛ Jizɔz inyɔmɔ, ɔkaimạŋ ɔya. <verse eid="MAT 19:22" /><verse number="23" style="v" sid="MAT 19:23" />Isai Jizɔz utek bɔŋɛtɔ yɛyɛ, &lt;&lt;sạŋ nyema baruŋː iki kpori uye anebɛ akɔ bom kɛtɔ kɛbɔd kɔriɛ kɛ lon ubasɛ. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Nyema baruŋ kɛ, iki kpori onewɛ ɔkɔ akpogɔ kaŋkaŋ kɛtɔ kɛbɔd ubasɛ kɔriɛ urugɔ ɛhɔm kɛ aga jɛn koriɛ. &gt;&gt; <verse eid="MAT 19:24" /><verse number="25" style="v" sid="MAT 19:25" />Bɔŋɛtɔ Jizɔz akomɔnɛ bobɛ ɔsɛtɔ bɛnɛ inyɔmɔ ɛkpa ubebɛŋ isai &lt;&lt;abɔu banɛ are one uwe ɔnaŋimạŋ?&gt;&gt; <verse eid="MAT 19:25" /><verse number="26" style="v" sid="MAT 19:26" />Jizɔz ukonɔ bɛŋ utek &lt;&lt;urere kɛ one sạŋ ɔbari, asi urere kubasɛ bobɛ uwɛ usega kure. &gt;&gt; <verse eid="MAT 19:26" /><verse number="27" style="v" sid="MAT 19:27" />Isai Pita ɔbɔu Jizɔz ata isai abod &lt;&lt;deroŋɔ okpo kpai dɛsạri dutedwɛ ndam mạn bom ure uwori?&gt;&gt; <verse eid="MAT 19:27" /><verse number="28" style="v" sid="MAT 19:28" />Jizɔz utek bɔŋɛtɔ yɛyɛ, afira kakɔmɔ duŋ &lt;&lt;kubi krure uwɛ wɔŋone ɔbiaga kɛbiaga kɔbɔd, bantoŋ jiou nawumɔ akibiaga duŋ ɛ namɛ da abɔd uwɛ atumɔ lonto jiou nawumɔ kɛ izrɛl. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />One nawunɔ uroŋɔnɛ ɛtɔ, wɔŋɔka, ɔsɛ, ɔka, bɔŋ nɛ okpo ubaran kpai utednɛ ndam, ikikɔmɔkɛ okpo bɛ kakpom dɛnau naten nɛ ekpen kotumotum. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Nsạd baruŋ ayena duŋ dɛyama ubɛ asani bɛŋ isai arɔŋi dure aki kpoŋi ndam, dirạk dɛyama ubɛ akpoŋi ndam aki rɔŋi dure.<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">Bɛ Dotomɔ kɛram</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />Kpomɔ kɛbɔd kɛ lon ubasɛ uyạŋɛnɛ iya. Iriyạŋ one ɔbɔm ɔnani uku bun ane ubɛ asạd dotomɔ ayemạŋ. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Uyera nɛ anebɛ abuni asạd dotomɔ ayemạŋ iyɛ ubuni ɔkpɛŋi bɛŋ da asạri krewe. <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />Iri nani kɛ ɔramạŋ kɛya ɔkɔ rɔn kɛ ane da abaya bom nawunɔ one usạri. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Ukutek bɛŋ &lt;arisạd dotomɔ ayemạŋ ikikpɛbɛŋ unim. &gt; <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Usạd kɛ kɛkubi jiou nawumɔ nɛ kubi asiri uwɛ ɛnɔwɔ. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Aa kɛ kubi aten uwɛ kiriɛ ɔramạŋ kɛ kɛya ɔkɔrɔnkɛ ane da abaya bom nawunɔ one usạri, &lt;ɔbɔubɛŋ obo ɛbaya duŋ aa arɔgi duŋ dewe bom nawunɔ asạri duŋ?&gt; <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />&lt;Abɛ abɔnɔmạŋ iyɛ one bɛŋ dotomɔ one uyeri, &gt; amɛ utekbɛŋ okeduŋ akasạd dotomɔ ayenɛ duŋ kɛram. <verse eid="MAT 20:7" /><verse number="8" style="v" sid="MAT 20:8" />&lt;Kiriɛ uwunɛ uyed bɛŋ kpai usumɔ uyebɛŋ akpogɔ dotomɔ bɛbɛ. &gt; <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />Ubɛ asani dotomɔ kukpoŋi kɛ kubi aten uwɛ kiriɛ anɔ ibeŋi nɛ ubɛ achiemi asani. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Ubɛ ari chiemi asani ayaya nɛ ɛkɔn iyɛ akpogɔ bɛbɛ ikiyam urugɔ uwɛ anebɛ awu kukpoŋi ndam, asi ɔkama urema ibeŋi. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Ubɛ ari chiemi asani akomɔ ɔkɔnkama asani kumạmi. <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />&lt;Ubɛ awunɛ dotomɔ kukpoŋi ndam abɔu kạn ubusạri ayebɛŋ akpogɔ ibeŋi nɛ anebɛ asani nɛkichi. &gt; <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />Onewɛ ɔnɔŋɔ bɛŋ kroromɔ utek&lt;yɔrɔduŋ kotoŋ, ayimbam, &gt; &lt;baruŋ bom iyina nsạdri nyạŋ baruŋɔnɛ akpogɔ dotomɔ deweɛ da deriyera. <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Nɔŋ duŋ akpogɔ boni aya duŋ aam nyei nɛ anebɛ awu kukpoŋi ndam ibeŋi nabon. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Abuninɛ ayemɛnɛ iyɛ ikɔm nkɔ kusạd nɛ akpogɔ nyam da mbam? kạn ɔriɛ baruŋ jɛn da nsạdri okpo?&gt;&gt;&gt; <verse eid="MAT 20:15" /><verse number="16" style="v" sid="MAT 20:16" />Kɛkpokpɛ amɛ Jizɔz itegɛnɛ iyɛ, &lt;&lt;ubɛ arichiemi asani ayạŋɛ krure akiyạŋɛ kandam, ubɛ ariyạŋ kandam akiyạŋɛ krure. &gt;&gt;<verse eid="MAT 20:16" /></para>
  <para style="s">Mkpaŋ asiri kɛ Jizɔz inyɔmɔ chiemɛ dube yɛyɛ</para>
  <para style="r">(<ref loc="MRK 10:32-34">Mk. 10.32-34</ref>; <ref loc="LUK 18:31-34">Lk. 18.31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Jizɔz iri ramạŋ jɛrusɛlɛm nɛ bɔŋɛtɔ yɛyɛ, uwɛ achɛŋinɛ aragi bɛŋ uhemɛbɛŋkɛ chiem. <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />&lt;&lt;yɔrɔduŋ kotoŋ, &gt;&gt;nyemɛ baruŋ &lt;&lt;uwɛ dɛraibara nɛ jɛrusɛlɛm aa akinɔŋ wɔŋ one aye anebɛ abuni anyɔm chiemɛ dube yɛyɛ. <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />Alalaŋ akisɛŋ mạŋ aye bɛ jɛntail ubɛ atogɔmạŋ asạdbɛŋ ekpom, atamạŋ, amudmạŋ kɛ kese ube, asi iki kaimạŋ kɛ kekpen kiri dewe asiri. &gt;&gt;<verse eid="MAT 20:19" /></para>
  <para style="s">Bobɛ Okaa Ibuni</para>
  <para style="r">(<ref loc="MRK 10:35-45">Mk. 10.35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Isai wani zɛbidi utogɔ bɔŋ anerum awumɔ, utera Jizɔz ujina deto uyemạŋ, utek konɔ bom ndam nyam. <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />&lt;&lt;Jizɔz ɔbɔumạŋ obo ebuni nsạd nyewɛ?&gt;&gt; onewani wɛ utek &lt;&lt;mbuninɛ ayenɛ ɔkɔnkporɔ iyɛ bɔŋbam awumɔ ba akibiagawɛ kɛ krumbɔk nɛ kpabɔk kubi uwɛ arema ɔbɔd. &gt;&gt; <verse eid="MAT 20:21" /><verse number="22" style="v" sid="MAT 20:22" />&lt;&lt;Jizɔz utekmạŋ bobɛ ebuni ayed, &gt;&gt;Jizɔz ɔbɔubɛŋ &lt;&lt;akikɛmɛ anɔŋ dutugɔ yɛ mbuni ŋɔŋ?&gt;&gt; iyɛ abɛ akikɛmɛ. <verse eid="MAT 20:22" /><verse number="23" style="v" sid="MAT 20:23" />&lt;&lt;Jizɔz utek bɛŋ ibeŋ da ɛkɛmɛ duŋ, &gt;&gt; &lt;&lt;asi aam ikɔm nkɔ uwɛ ntegi ane bɛ abuni abiaga nɛ kɛ krumbɔk nɛ kpabɔk. Kpokpɛ ɔkɔnɛ anebɛ asɛm iyaŋ ɛ. &gt;&gt; <verse eid="MAT 20:23" /><verse number="24" style="v" sid="MAT 20:24" />Asam bɔŋɛtɔ yɛyɛ bɛntoŋ jiou akomɔ chiemɛyɛ akam ɛkɔn nɛ bɔŋɔka awumɔbɛ. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Jizɔz iriyed bɛŋ kpai usumɔ utek bɛŋ &lt;&lt;eyed duŋ iyɛ onewɛ utum ikɔm kɛ lon ubasɛ amɛ utoginɛ ikɔm kpai iyem. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Iya ure ibire da abon etogduŋnɛ, ure bobɛ one uwunɔ boni ibuni ɔkɔmɔ dɛbad sạŋ uchiemi urema wɔŋɛtɔ uye ubarani. <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />Ure bobɛ one uwunɔ boni ɔrɔŋi dure, sạŋ uchiemi usạd dutạk uye ubarani. <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />Wɔŋ ubasɛ iriwu irirɔn ɛkpa yɛyɛ, iriwunɛ iribe dube deto ane kpai. &gt;&gt;<verse eid="MAT 20:28" /></para>
  <para style="s">Jizɔz Ubok Adạndạmi Awumɔ</para>
  <para style="r">(<ref loc="MRK 10:46-52">Mk. 10.46-52</ref>; <ref loc="LUK 18:35-43">Lk. 18.35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Kubi Jizɔz nɛ bɔŋɛtɔ yɛyɛ aroŋɔnɛ jɛriko ane dɛyama ari teribɛŋ ndam. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Adạndạmi awumɔ abiagi kiyem kwaŋ kubi Jizɔz iritumi atek kasi wɔŋ devid tobara ubian. <verse eid="MAT 20:30" /><verse number="31" style="v" sid="MAT 20:31" />Ane dɛyɔgɔbɛ asega bɛŋ atekbɛŋ abemɛma, abɛ arod kɛ akpori dɛman &lt;&lt;wɔŋ ɔbɔd Devid tobara ubian, ataǃ &gt;&gt; <verse eid="MAT 20:31" /><verse number="32" style="v" sid="MAT 20:32" />Jizɔz ɔba uyed bɛŋ ɔbɔu &lt;&lt;obo ebuni nsạd nye baruŋ?&gt;&gt; <verse eid="MAT 20:32" /><verse number="33" style="v" sid="MAT 20:33" />Abɛ atek &lt;&lt;ata&gt;&gt; dubuninɛ &lt;&lt;asạd bara dɔrɔn iyemǃ &gt;&gt; <verse eid="MAT 20:33" /><verse number="34" style="v" sid="MAT 20:34" />Jizɔz ukomɔ ubian bɛbɛ uwạmɔ bɛŋ kajɛn; abɛkpai arɔn iyem isai atedmạŋ ndam.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">Jɛrusɛlɛm Kɔriɛ kɛ ɔkɔdɔm</para>
  <para style="r">(<ref loc="MRK 11:1-11">Mk. 11.1-11</ref>; <ref loc="LUK 19:28-40">Lk. 19.28-40</ref>; <ref loc="JHN 12:12-19">Jn. 12.12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Jizɔz nɛ bɔŋɛtɔ yɛyɛ atuminɛ Jɛrusɛlɛm ari boŋɔ beŋ arabɛŋ bɛtsaida kikon ɔlif, ɛnɛ amɛ Jizɔz ilawɔnɛ bɔŋɛtɔ yɛyɛ awumɔ utom dotomɔ. <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />Utek bɛŋ &lt;&lt;dɔŋ duŋ kɛ lon ɛyakạni akirɔn duŋ ɛhɔm ɛyɛ akpo, tami mạŋ duŋ atogɔ awukan duŋ. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />One nawunɔ uwɛ ɔbɔi baruŋ yemamạŋ duŋ iyɛ de asewoni ɛtɔ utom baruŋ iki roŋɔ baruŋ&gt;&gt; <verse eid="MAT 21:3" /><verse number="4" style="v" sid="MAT 21:4" />Boba ɔnaninɛ iya sạŋ dɛman ubasɛ ɔba. <verse eid="MAT 21:4" /><verse number="5" style="v" sid="MAT 21:5" />&lt;&lt;Yema duŋ don ɛbara Zayɔn, iyɛ ɔbɔd bɛbɛ uwemǃ urenɛ ɔbɔd uwɛ ɔtɔnɔmạŋ dirạk ubra nɛ ɛhɔm utogimạŋ uwuŋi nɛ ɛhɔm wɔŋ. &gt;&gt; <verse eid="MAT 21:5" /><verse number="6" style="v" sid="MAT 21:6" />Bɔŋɛtɔ Jizɔz alaŋanɛ bobɛ ɔsɛtɔ bɛbɛ itom bɛŋ. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Atogɔ ɔhɔmɔ bɛ Jizɔz itombɛŋ awukan anoŋ mạŋ Jizɔz ubạra. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Ane dɛyama arisɛrinɛ dibara bɛbɛ arạgarạg asɛri uteri kiyem. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Krɛyɔgɔbɛ arạgarạg achɛŋinɛ krure, arạgarạg achɛŋi kadam arori &lt;&lt;dɛbad ɔkɔnɛ wɔŋ Devidǃ ubasɛ unoŋimạŋ kuwɛ iwunɛ krokom ɔbɔd, dɛbad ɔkɔmɔ ubasɛǃ &gt;&gt; <verse eid="MAT 21:9" /><verse number="10" style="v" sid="MAT 21:10" />Jizɔz uwunɛ iriramạŋ Jɛrusɛlɛm, utuminɛ asani kɔbɔu &lt;&lt;uwa banɛ?&gt;&gt; <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />Ane abɔnɔ &lt;&lt;urenɛ onewɛ ukuhemi dɛman ubasɛ ukoninɛ Jizɔz ukuheminɛ chiem ubasɛ, uwunɛ nazarɛd kɛ ndon Glili. &gt;&gt;<verse eid="MAT 21:11" /></para>
  <para style="s">Jizɔz ɔramạŋ kɛ kpomɔ dulimɛ</para>
  <para style="r">(<ref loc="MRK 11:15-19">Mk. 11.15-19</ref>; <ref loc="LUK 19:45-48">Lk. 19.45-48</ref>; <ref loc="JHN 2:13-22">Jn. 2.13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Jizɔz ɔramạŋ kɛtɔ dulimɛ ukuwạm ane bɛ anɔŋɔ kpomɔ dulimɛ atogɔ arɛbi ɛya, ukurɔ kɛnɛnɛ bɛbɛ, ɔchari okpo bɛbɛ kpai. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Utek bɛŋ &lt;&lt;ari sɛgi kɛ kusɛgɛ ubasɛ iyɛ &lt;kpomɔ dulimɛ urenɛ kpokpɛ aŋanibɛŋ dulim. &gt; isai abon anɔŋ ayaŋ duŋ da kpokpɛ ayạwne arạbibɛŋ. &gt;&gt; <verse eid="MAT 21:13" /><verse number="14" style="v" sid="MAT 21:14" />Ane bɛ amiɛgi nɛ adạndạmi awukan ɛ kɛtɔ dulimɛ Jizɔz ubok bɛŋ. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Bɛ nyɔmɔ nɛ anebɛ achegi dɛmana lonɔ akam ɛkɔn kabobɛ Jizɔz isạdrinɛ ɛ isai bɔbɔŋɔ bɛ ayạŋ ɛ asani kurod, dɛbad ɔkɔnɛ wɔŋ ɔbɔd Devid. <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />Anebɛ abɔu Jizɔz &lt;&lt;ekomɔ bobɛ bɔŋɔba anyɔmi?&gt;&gt; Jizɔz ɔbɔnɔ bɛŋ &lt;&lt;dikomɔ&gt;&gt; ɔbɔu &lt;&lt;abon kusɛgɛ ubasɛ aweniduŋ? ucheginɛ &lt;iyɛ anɛk bɔŋ kiyem uwɛ achega nfɔnɔ dɛmara. &gt;&gt;&gt; <verse eid="MAT 21:16" /><verse number="17" style="v" sid="MAT 21:17" />Jizɔz uroŋɔ bɛŋ ɔramạŋ Bɛtani uku nema.<verse eid="MAT 21:17" /></para>
  <para style="s">Jizɔz Ulim Kese fik</para>
  <para style="r">(<ref loc="MRK 11:12-14">Mk. 11.12-14</ref>,<ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Nɛkichi ikpeyɛnɛ uwuŋi kɛ don dɛbara Jizɔz ukomɔ dɔwɔ. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Ichɛŋinɛ uwuŋi ɔrɔn kese Fik kiyem kwaŋ ɔchɛŋ ɔramạŋ keselan dawama ɔrɔn ɔwa mạŋchen amɛ irɔnɔnɛ utek keseya &lt;&lt;sạŋ ariwam kubru kpun keseyɛ ubeǃ &gt;&gt; <verse eid="MAT 21:19" /><verse number="20" style="v" sid="MAT 21:20" />ɛkpa ube bɔŋɛtɔ yɛyɛ abɔu ata &lt;&lt;nạn kese Fik ichɛŋ ube waiwai iya?&gt;&gt; <verse eid="MAT 21:20" /><verse number="21" style="v" sid="MAT 21:21" />Jizɔz ɔbɔnɔbɛŋ &lt;&lt;ure bobɛ eneŋa krɛ kɔnduri yoyo akisạd bobɛ nsạrinɛ nɛ kese uwɛ mạŋchen ɛkɛmɛ ikon kutek kaiwɛ aa ariɛ kɔkpa urema nyɔi.<verse eid="MAT 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 21:22" />Ure bobɛ eneŋa akikɔmɔ bom nawunɔ ebuni uwɛ ɛŋanawɛ dulim.<verse eid="MAT 21:22" /></para>
  <para style="s">Dɛbɔwɔ kɛ Ikɔm Jzɔz</para>
  <para style="r">(<ref loc="MRK 11:27-33">Mk. 11.27-33</ref>; <ref loc="LUK 20:1-8">Lk. 20.1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Jizɔz ukpenɛ uwukan kɛ kpomɔ dulimɛ; abɔd abara ubasɛ nɛ abɔdɔbɛ ayạŋ ɛ aribɔu Jizɔz, &lt;&lt;mạn ikom awu ɛkɔ arisạd bobɛ ɛsạrinɛ, banɛ ayạŋwɛ ikomɔ yɛ? <verse eid="MAT 21:23" /><verse number="24" style="v" sid="MAT 21:24" />Jizɔz utekbɛŋ &lt;&lt;mbuninɛ mbɔu baruŋ dɛbɔwɔ ure bobɛ ɛbɔnɔ duŋ, nki yema baruŋ onewɛ uyạŋ nɛ ikom ntogɔ nsạdri okpobɛ nsạdrinɛ. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Nda jɔn iri nɔŋɔ ikom utogɔ ubega ane mạm iriwu kubasɛ kạn de kone?&gt;&gt; abɛ asani nkaŋ nɛ ɛkpa bɛbɛ, atek iyɛ ure bobɛ detega iyɛ &lt;uwu kubasɛ&gt; amɛ iki bɔu bara kạn obusạri dɛka jɔn derineŋa? <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Asi dutetega, iyɛ &lt;uwu kone, &gt; duyed bobɛ ane abuni asạd ire abɛ kpai ayed iyɛ Jɔn urenɛ onewɛ uhemi dɛman ubasɛ. <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />Abɔnɔ Jizɔz iyɛ &lt;&lt;abɛ one uyed&gt;&gt; Jizɔz utek bɛŋ uwɛ ɛkanɛ ayeduŋ, &lt;&lt;aam sạŋ baruŋ nyema ikạmsi ŋnɔŋɔ ikɔm nsạd bobɛ nsạdrinɛ.<verse eid="MAT 21:27" /></para>
  <para style="s">Kosei Abɔŋ Anerum Awumɔ</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />Jizɔz utek isai nda ɛŋani duŋ ɛkɔn? iriyạŋ one irikɔ bɔŋ anerum awumɔ ukutek uwɛ ure &lt;oretam sạŋ ɔramạŋ kɛram ukusạd dotomɔ. &gt; <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />&lt;Utek ɔsɛ iyɛ amɛ sạŋ ɔta, &gt; uyạŋɛ kubi ɛrɛrɛni iriramạŋ. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />Atawɛ ukutek wɔŋ wɛwɛ urenɛ wɔwɔŋɔ ɔramạŋ kɛram uwɛ &lt;uyera&gt; asi irita. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />Jizɔz ɔbɔu mạn wɔŋ usạri bobɛ osɛbɛbɛ itom bɛŋ?&gt;&gt; abɛ abɔnɔ iyɛ oretamawɛ. &gt;&gt; Jizɔz utek bɛŋ anebɛ akpạni akpogɔ keweya nɛ achɛn chɛŋi aki chiemi ariɛ kɛdon ubasɛ. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Jɔn iriwu irichegi baruŋ nfɔnɔ iyem uwɛ achɛŋ duŋ abon arineŋa duŋ, anebɛ akpạni akpogɔ keweya nɛ achɛn chɛŋi arineŋa mạŋ. Ndema uwɛ ɛrɔnduŋ okpoba kuneŋa baruŋ kɛkɔn kure.<verse eid="MAT 21:32" /></para>
  <para style="s">Kosei Onewɛ Ukoyɔ Kɛram</para>
  <para style="r">(<ref loc="MRK 12:1-12">Mk. 12.1-12</ref>; <ref loc="LUK 20:9-19">Lk. 20.9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />Jizɔz utekbɛŋ &lt;&lt;yɔrɔduŋ akomɔ duŋ kosei urạgarạg, &gt;&gt; &lt;&lt;one iriyạŋ ɔkɔ dɔchɛ utogɔ usạd kɛram, ɔŋana kukạra uwogɔ kɛram ɛyɛ, iritɔk dɛma ɛ isai iribɔu ikurɔ uwɛ abiagi akoi kɛram ɛyɛ, iri sɛŋ kɛram ɛyɛ uye ane atumɔ amɛ ɔya. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />kubi utuminɛ uwɛ iyed iyɛ okpo kɛram itama, utom bɔŋɛtɔ yɛyɛ kanebɛ ayạŋɛnɛ kɛram yɛyɛ sạŋ ayemạŋ ichiema yɛyɛ. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Anebɛ atum kɛram ɛyɛ ayama bɔŋɛtɔ bɛ uwunɔ atam, aŋan uwunɔ, amagi uwunɔ datan. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />ɔkɔ kɛram utom kɛ bɔŋɛtɔ yɛyɛ arạgarạg arabɛŋ kɛ anebɛ asạdkɛ bobɛ asạri nɛ ubɛ achiemi arabɛŋ. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />ɔkɔ kɛram nɛ sạŋ ntom wɔŋam &lt;abeŋda animạŋ. &gt; <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />Wɔŋ wɛwɛ ɔramạŋ asam arɔn mạŋ daiwuŋi, abɛ atek wɔŋ ɔkɔ kɛram uwem dɔŋan mạŋ, sạŋ dɔnɔŋ okpobaǃ <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Ayama mạŋ, adug alawɔ kɛram ɛyɛ aŋan mạŋ. <verse eid="MAT 21:39" /><verse number="40" style="v" sid="MAT 21:40" />Jizɔz ɔbɔu bɛŋ &lt;&lt;isai ɔkɔ kɛram uwuwu obo ibuni usạd?&gt;&gt; <verse eid="MAT 21:40" /><verse number="41" style="v" sid="MAT 21:41" />Anebɛ &lt;&lt;atek uwuwu iki ŋan anebɛ&gt;&gt; atumɔnɛ kɛram yɛyɛ &lt;&lt;ɔnɔŋ kɛram yɛyɛ uye ane arạgarạg ubɛ ayeimạŋ ichiema yɛyɛ kubi ubebeŋ. &gt;&gt; <verse eid="MAT 21:41" /><verse number="42" style="v" sid="MAT 21:42" />Jizɔz utek bɛŋ &lt;&lt;arayedun bobɛ kusɛgɛ ubasɛ isạdri? duyena da ariyim datan abitogɔ abɔu kpom iyɛ unim, asi kubi krure datan ɛbɛ ariyimɛnɛ ɔkama iriremɛ datan ɛyɛ uim urugɔ. Uwa ubasɛ amɛ usạrinɛ; ɛrɔn duŋ bobɛ ubasɛ ichegi <verse eid="MAT 21:42" /><verse number="43" style="v" sid="MAT 21:43" />Jizɔz utek bɛŋ &lt;&lt;sạŋ nyema baruŋ&gt;&gt; &lt;&lt;akina baruŋ kpomɔ kɛbɔd ubasɛ aye anebɛ uwɛ achɛŋ nɛ ubasɛ kɛ nfɔnɔ iyem. &gt;&gt; <verse eid="MAT 21:43" /><verse number="45" style="v" sid="MAT 21:45" />abod abara ubasɛ nɛ bɛ Farasi akomɔnɛ kosei Jizɔz itoyonɛ ayena iyɛ ɔnyɔminɛ nabɛ. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Anomạŋ kɔyama, akɔmɔ kɛwɔd aramabɛŋ iyɛ anebɛ aneŋa iyɛ Jizɔz urenɛ onewɛ uyemi dɛman ubasɛ.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">Kosei Efinɛ ɔbana</para>
  <para style="r">(<ref loc="LUK 14:15-24">Lk. 14.15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Jizɔz utogɔ kosei ɔyɔm chiem nɛ ane. <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />&lt;&lt; kpomɔ kɛbɔd ubasɛ uyạŋɛnɛ iya. ɔbɔd iriyạŋ iribuni usạd ɔban uye wɔŋ onerum yɛyɛ <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Utom wɔŋ ɛtɔ ukuyed ane bɛ awu ɔban awukan <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />Utom kɛ urạgarạg nɛ dɛkana iyɛ asinː &lt;efin nyam ibinɛ isai, <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />Asin ɛbɛ ayim kuwu arabeŋ dotomɔ bɛbɛ, uwunɔ iri kɛram, uwunɔ ɔramạŋ kakpomɔ ɛya yɛyɛ <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Ubɛ amuŋɔ atam bɔŋɛtɔ ɔbɔd aŋan beŋ kpai <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />ɔbɔd ɔkam ɛkɔn utom bɛ dekpo iyɛ aka aŋan akumi loon bɛbɛ. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Isai ɔbɔd uyed bɔŋɛtɔ yɛyɛ iyɛ kubi ɛfin ɔban itumi, asi ane bɛ nyeri one uwu. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Isai diɛ duŋ kɛ iyem ayed ane bɛ ɛrɔrɔn duŋ awukan. &gt; <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Isai bɔŋɛtɔ yɛyɛ ariɛ kiyem ayed ane mfɔnɔ bɛbɛ nɛ ayinɛ bɛbɛ awukan ɛtɔ ɔbana uyugɔ nɛ ane. <verse eid="MAT 22:10" /><verse number="11" style="v" sid="MAT 22:11" />&lt;&lt;ɔbɔd ɔriɛ kakpomɔ ɔbana ɔrɔn onerum uwunɔ ɔka dɔbara ɔban utum. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />ɔbɔumạŋ nạn ɛchɛŋ atumi aa ɛkawɛ dɔbara ɔban aŋani? <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />ɔbɔd utek wɔŋɛtɔ yɛyɛ, bɔumạŋ mbɔk nɛ nwun akayaŋ kɛ kirạmi. Uyạŋɛ ɛ ujimạŋ dalaŋ<verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />jizɔz utek &lt;&lt;ayeri nɛ dɛyama asi anɔŋ ɛrɛrɛni. &gt;&gt;<verse eid="MAT 22:14" /></para>
  <para style="s">Dɛbɔwɔ Da Uwɛ Acheŋ Ayei Akpogɔ Keweyɛ</para>
  <para style="r">(<ref loc="MRK 12:13-17">Mk. 12.13-17</ref>; <ref loc="LUK 20:20-26">Lk. 20.20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Isai bɛ Farasi abuni jizɔz kɔyama nɛ dɛbɔwɔ <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />atom bɔŋɛtɔ bɛbɛ nɛ bɛ Herɔd. &lt;&lt;onewɛ-uchiemi, &gt;&gt;dɛyed ayɛminɛ achiemi kreŋeŋɛnɛ ubasɛ aye ane. kotoŋ ayɔrɔ aye kusạd ane. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />yemɛ bara akpogɔ keweya kɔkpɛ aye ɔbɔt roman, kạn unim?&gt;&gt; <verse eid="MAT 22:17" /><verse number="18" style="v" sid="MAT 22:18" />jizɔz iyed detema iyinɛ, isai utek, &lt;&lt;abon bɛ eririɛ obo enowɔ nɛ duŋ kɔŋɛk? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />chege nɛ akpogɔ ebuni aye kɛweyɛ&gt;&gt; <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />ɔbɔu bɛŋ &lt;&lt;dure nɛ dokom abanɛ uyạŋ kɛ akpogɔ yɛ&gt;&gt; <verse eid="MAT 22:20" /><verse number="21" style="v" sid="MAT 22:21" />abɛ abɔnɔ&lt;&lt; ɔbɔd&gt;&gt;ye ɔbɔd uwɛ ɔkɔ mạŋ aye Ubasɛ uwɛ ɔkɔ Ubasɛ&gt;&gt; <verse eid="MAT 22:21" /><verse number="22" style="v" sid="MAT 22:22" />akomɔnɛ dɛbɔnɔ jizɔz ɛkpa ubɛbeŋ aroŋɔmaŋ.<verse eid="MAT 22:22" /></para>
  <para style="s">Dɛbɔwɔ Da Achɛŋ ɔkaimạŋ Krube</para>
  <para style="r">(<ref loc="MRK 12:18-27">Mk. 12.18-27</ref>; <ref loc="LUK 20:27-40">Lk. 20.27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />dewɛ uwɔnɔwɛ bɛ sadusi awutek jizɔz one ubebe kɔkakagi kure. <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />Atek &lt;&lt;onewuchiemi&gt;&gt;Moziz utek, onerum ubebe ɔka wɔŋ ɔkɔ wɔŋɔka ikiban wani wɛwɛ sạŋ ɔmad wɔŋ ɔŋana kɛ ɛtɔ yɛ. <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />bɔŋɔka atenan ariyiŋ oretam bɛbɛ oban wani ube wɔŋ ɔkɔ urogɔ wani uye wɔŋɔka. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />bobɛ usei usạri awumɔ, usei usadri asiri, kikpe usei usạri atenan. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />anebani abɛ kpai <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />isai, kɛ dewe anebɛ abe uwɛ akagibeŋ krube, wani abanɛ ibuni uremɛ uwɛ abɛkpai ari abanmạŋ. &gt;&gt; <verse eid="MAT 22:28" /><verse number="29" style="v" sid="MAT 22:29" />Jizɔz ɔbɔnɔ beŋ, &lt;&lt;Nạn kugbiɛ aka kpeǃ Ire ure kusɛgɛ Ubasɛ ayed duŋ kɛ ikɔm Ubasɛ aneŋɛ duŋ <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Ane bɛ akagibeŋ ayiŋɛ da ɛngel siŋ ɔban one usạri <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Ane be ayi kekpen kɔkagi awu ayeri bobe ubasɛ iyema wɛ? <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />'aam ndenɛ ubasɛ ɛbraham, ubasɛ AAizik, ubasɛ Jekɔb, urene ubasɛ bɛ ekpen uwe bɛ dube ure. &gt;&gt; <verse eid="MAT 22:32" /><verse number="33" style="v" sid="MAT 22:33" />dɛyɔgɔ akomɔnɛ ɛkpa ube beŋ kɛ kuchiemi yɛyɛ.<verse eid="MAT 22:33" /></para>
  <para style="s">Dɛman ɛbara Kuye</para>
  <para style="r">(<ref loc="MRK 12:28-34">Mk. 12.28-34</ref>; <ref loc="LUK 10:25-28">Lk. 10.25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Kubi ɛyɛ bɛ Farasis akomɔnɛ iyɛ Jizɔz isạdri bɛ saducis abemɛ ɛma, awukan abɛ kpai. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />one uwunɔ bɛbɛ uku chegi dɛman kɔyaŋ, uno Jizɔz kɔyama ɔyaŋ nɛdɛbɔwɔ. <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />utek onewuchiemi &gt;&gt; mạnuwu ure mfɔnɔ chiem kɛ dɛman kɔyaŋ?'' <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />Jizɔz ɔbɔnɔ &lt;&lt;&lt; bam Ubasɛ yoyo nɛ dɛkɔnduri, nɛ kɛwaŋ, nɛ ɛkɔn kpai. <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />uwa urenɛ uchiemi nɛ mfɔnɔ dɛman kɔyaŋ. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />usạri awumɔ mfɔnɔ ntotobɔuyiŋanɛ da uchiemiː &lt; bam ane da ɛbam ɛkpa yoyo. &gt; <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Dɛman kɔyaŋ moziz kpai nɛ anebɛ achegi bɛ dɛman kuhemɛ Ubasɛ ayaŋanɛ ɛkɔn kɛ ntotobɔawumɔya. &gt;&gt;<verse eid="MAT 22:40" /></para>
  <para style="s">Dɛbɔwɔ Uwɛ Ono Wɛ Uchegi Iyem</para>
  <para style="r">(<ref loc="MRK 12:35-37">Mk. 12.35-37</ref>; <ref loc="LUK 20:41-44">Lk. 20.41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Kubi ɛyɛ bɛ Farasis aregɛrạk asumɔnɛ, Jizɔz ɔbɔu bɛŋ, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />&lt;&lt; Nạn ɛhani ruŋ ɛkɔn kɛ one wɛ uchegi iyem? mạn dohon iwuŋib? Abɔnɔ, uwuŋinɛ kɛ dohon ɔbɔd Devid. &gt;&gt; <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />&lt;&lt;Jizɔz, utek bɛŋ &gt;&gt; dɛ kɛwaŋ usạri devid uyed onewɛ uchegi iyem ɔbɔd&gt;? devid utek, <verse eid="MAT 22:43" /><verse number="44" style="v" sid="MAT 22:44" />ɔbɔd utek ɔbɔd yamː biaga aa kɛ krum bɔkyam tata nŋana bɛ iyerɛ yoyo kanwunkon yoyo. &gt; <verse eid="MAT 22:44" /><verse number="45" style="v" sid="MAT 22:45" />Ure bobɛ, devid iyeri onewɛ uchegi iyem&lt; ɔbɔd, &gt;nạn onewɛ uchegi iyem ibunɔ ureme dohon ɔbɔd devid? &gt;&gt; <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />one nawunɔ ɔkɛmɛ ɔbɔnɔ Jizɔz kure, sani ɛ onemạŋ dɛbɔwɔ iribɔi.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">Jizɔz Uduk Ane Ditoŋ Kɛ kuchiemi Dɛman Nɛ Bɛ Farisis</para>
  <para style="r">(<ref loc="MRK 12:38">Mk. 12.38</ref>,<ref loc="MRK 12:39">39</ref>; <ref loc="LUK 11:43">Lk. 11.43</ref>,<ref loc="LUK 11:46">46</ref>; <ref loc="LUK 20:45">20.45</ref>,<ref loc="LUK 20:46">46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Jizɔz ɔyɔm uye dɛyɔgɔ nɛ bɔŋɛtɔ yɛyɛː<verse eid="MAT 23:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 23:2" />&lt;&lt; Anebɛ achegi ntotobɔnɛ bɛ Farasis abɛ arenɛ anebɛ akɔ ikɔm dɛman mɔziz kubạŋa<verse eid="MAT 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 23:3" />Akɔnɛ kukomɔ bobɛ abɛ achegiwɛ asạd, asi kasạri da abɛ asạri dɛmara, ire abɛ one usạri bobɛ abɛ achiemi.<verse eid="MAT 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 23:4" />Abɔwi ane etogɔ irogɔ kandam nɛ uwɛ uyogɔ kɔbaŋa, uwɛ abɛ kɛ ɛkpa ubɛbɛ aka one ubunɔ kubirɛ nɛ ɛnɔ ubɛbɛ uwɛ uasạd bɛŋ akɛmɛ abaŋa etogɔ yɛ abɛ ayạŋ bɛŋ.<verse eid="MAT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5" />Asạdri nɛ dotomɔ jen ane sạŋ ane arɔn bɛŋ. Akoni irạk atogi ayami bom uwɛ aseŋɛ bɛŋ krure uwɛ asɛgi kusɛgɛ chiem Ubasɛ ɛɛ nɛ uwɛ atum kambɔkǃ Akoni da irạkgɛ dɔbara bɛbɛ isara ukukpeǃ<verse eid="MAT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 23:6" />Abam nfɔnɔ kpom kɛ efin abami kɔbiagi kɛbiaga abara bɛ uyạŋi kɛ kpomɔ kisumɔ bɛ ju;<verse eid="MAT 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 23:7" />Abami ane arenɛ bɛŋ kɛ dɛbad kakpom ɛya abuni ane aweni bɛŋ anebɛ &lt;&lt;achegi. &gt;<verse eid="MAT 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8" />Sạŋ kikam ure iyɛ ayedwɛ one wɛ uchegi, ire abon kpai ayiŋ duŋgɔ nɛ ibeŋi akɔmɔrun oneuchegi uwunɔ.<verse eid="MAT 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 23:9" />One nawunɔ aa krɔchɛ akɔ kuyɛd &lt;Ɔsɛ, &gt; ire dɔkɔnɛ ɔsɛ uwunɔ kpɔd uwɛ uyạŋ krewɛ.<verse eid="MAT 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 23:10" />Uwɛ aka yedwɛ onewɛ &lt;utogi iyem, &gt; ire onewɛ utogi baruŋ iyem ure nɛ onewɛ uwu iri chegɛ baruŋ iyem uwɛ aweni messiah.<verse eid="MAT 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 23:11" />onewɛ ɔbara urugɔ barun sạŋ uremɛ wɔŋɛtɔ <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />One nawunɔ yɛ ubirɛ ɛkpayɛ aki tɔnɔmạŋ, one nawunɔ yɛ ɔtɔnɔmạŋ aki birɛmạŋ<verse eid="MAT 23:12" /></para>
  <para style="s">Jizɔz ɔrɔk Dotomɔ Jɛn One</para>
  <para style="r">(<ref loc="MRK 12:40">Mk. 12.40</ref>; <ref loc="LUK 11:39-42">Lk. 11.39-42</ref>,<ref loc="LUK 11:44">44</ref>,<ref loc="LUK 11:52">52</ref>; <ref loc="LUK 20:47">20.47</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />&lt;&lt; Nạn uwɛ uyinɛ uye baruŋ abonɔbɛ achegiruŋ dɛman kɔyạŋ nɛ bɛ Farisiǃ Abon bɛ nkari abaǃ Abon amerɛ ruŋɔnɛ ikpegi kpom kɛbɔd ubasɛ krure ane, abon kɛ ɛkpa boni ariɛruŋ, anebɛ abuni kɔriɛ bɛŋ asɛgɛ ariɛruŋǃ <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />Isai Jizɔz utek anebɛ atogi iyem, &lt;&lt;Abon anebɛ achegi dɛman bɛ ju nɛ Farasis areduŋɛnɛ bɛ eririɛ uyinɛ uyɛ baruŋ abonɔbɛ achegiruŋ nɛ bɛ Farisis, abon bɛ nkari abaǃ Ire abon ameniruŋ nɛ ane banibɛ arum abe arogɔ kɛ ɛtɔ' atogiruŋ eriri abemiruŋ <verse eid="MAT 23:14" /><verse number="15" style="v" sid="MAT 23:15" />uyinɛ uye barun Farasis bɛ nchiɛǃ atairuŋɔnɛ kɔcheŋ ka mạm nɛ ka ngun, abuni oneuwɛ aboŋɔ ɛkɔn aneŋɛ ka abon, arurugɔ asạd mạŋ uremɛ awumɔ ɔbɔgi kɛ kinạk ane ayinɛ. <verse eid="MAT 23:15" /><verse number="16" style="v" sid="MAT 23:16" />awunɛ nɛ ajoŋɔ uwɛ ebitok bem iyem asi arenɛ udạmdạmi. acheginɛ iyɛ afirɛ ure one kusibɛ ka kpom dilim. <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />awu arenɛ udạmdạmi iyeriɛǃ mạn uwu ɔbara urugɔ de mfɔnɔ bom kạn de kpom dulimɛ uwusạri mfɔnɔ bom ɔmau? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />awu achegi kɛ iyɛ ɔbɔgi one kusibɛ kɛ kpom efinɛ. asi awu atekɛ iyɛ ibɔgi one kusibɛ nɛ ekporɔ ka kpom efinɛ <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Are udạmdạmiǃ mạn uwunim urugɔ, ekporɔ kan de kpom efinɛ uwusạri ekporɔ ɔmau? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />onenawunɔ usibɛ mạŋ ka kpom efinɛ isibɛmạŋ okpo kpai uyiŋ kɛkɔn. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />onenawunɔ usibɛ mạŋ ka kpom dilimɛ isibɛmạŋ nɛ ubasɛ yɛ unugiɛ. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />kusibɛ nɛ don ubasɛ uyiŋɛ nɛ ibeŋi nɛ kusibɛ nɛ kɛbiaga kɛbɔd ubasɛ nɛ onewɛ ɔbiagi kɛ kɛbiaga yɛ. <verse eid="MAT 23:22" /><verse number="23" style="v" sid="MAT 23:23" />&lt;&lt; Abon bɛ Farasi ane bɛ achiemi achegirunɔnɛ ekpa ka afirɛ ayerun ubasɛ arɛgi uwugi kɛram boni, mfɔnɔ dɛman donɔ dɛbad ayiŋdun, ubɛ are, kɔtama, ubian, ekpa kɔyama. ubɛ arenɛ mfɔnɔbom ebisạdrirun, uwunɔ ka roŋɔ kusạd. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />abon adạmdạmi atogi ane iyemǃ arugirun ɔnɛ ɔnai kɛ itugɔ amendun ɛhɔm. <verse eid="MAT 23:24" /><verse number="25" style="v" sid="MAT 23:25" />&lt;&lt;Da uwɛ uyinɛ nɛ abon ane bɛ achegi ntotobɔnɛ bɛ Farasisǃ Abon bɛ eririɛǃ ayiŋarun ka afirɛ, asagirunonɛ mạk kwaŋ nɛ ɛgbaŋ, arogɔrun ɛkɔn uwɛ uyugɔ nɛ ajuŋɔ nɛ kɛyam. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Abon adạmdạmi Farasiǃ chiemi iyem asagi mạk ɛkɔn kwaŋ ikirɔrɔ. <verse eid="MAT 23:26" /><verse number="27" style="v" sid="MAT 23:27" />Da uwɛ uyinɛ nɛ abon ane bɛ achegi dɛman kɔyan nɛ bɛ Farasiǃ ayạŋduŋɛnɛ kɛ afirɛ bom nawunɔ arerun achegirun ɛkpa ayiŋarun da bom asagi uvud kɛ kwaŋ anim asi kɛ ɛkɔn ayugɔ nɛ ɔkakau nɛ ujiri. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Kɛ da eyạŋduŋ. ke dɛbɔm asạd da enim kɛ ɛkɔn eriri nɛ okpo ayinɛ.<verse eid="MAT 23:28" /></para>
  <para style="s">Jizɔz Unomɔ Dutugɔ Bɛbɛ</para>
  <para style="r">(<ref loc="LUK 11:47-51">Lk. 11.47-51</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />Iki yinɛ uye baruŋ, abonɔbɛ achegi duŋ dɛman kɔyan nɛ Farisiǃ Abon bɛ eririɛǃ ane bɛ achegi dɛman areruŋɔ nɛ bɛ nchiɛ asi anoŋi duŋɔ nɛ kpom ayei duŋ anebɛ ayemi dɛman ubasɛ, anoŋi duŋ kɛ kpom ayei duŋ anebɛ akɔ akpogɔ anugi nfɔnɔ ekpen; <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />ayemi iyɛ awu ɛbaŋa nɛ ɔsɛ-ɔsɛ boni akɔ awunirun anebɛ ayemi dɛman ubasɛ. <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />awu ayemi iyɛ awu bom asumɔ nɛ anebɛ awuninɛ anebɛ ayemi dɛman ubasɛ. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />dɔŋ kɛrurɛ asạd okpobɛ abɛ asạri. <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />bom are asi iyɔk nɛ bɔŋ iyɔkǃ nạn uwɛ asạd arạm kpomɛ kinạk ane ayinɛ? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Isai nhemi wɛnɛ anɛ nkisinɛ dɛman Ubasɛ nɛ anebɛ akɔdukpeŋɛ nɛ anebɛ achegi; akihan ane arɛgɛrạk, amud ubaran, akiyaŋ ubaran kɛ sinagɔz awạm bɛŋ don nɛ don. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Da irenɛ, dutugɔ kuwuni ane bɛ aka kugbiɛ one ɔkɔ iki tɔwɛ, uwukan kɔhan onewɛ ɔka kugbiɛ ɔkɔ ɛbɛl ɔramạŋ kɔhan uwɛ zɛcharia wɔŋ uwɛ Bɛrɛcha, uwɛ awu ɛŋana sani kɛ kpomɔ durimɛ nɛ kpomɔ efinɛ. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Nhemɛwɛ da ireː dutuhɔ uyɛ anebɛ awuni ikitɔ anebɛ ayạŋ ichiŋǃ<verse eid="MAT 23:36" /></para>
  <para style="s">Kubam Jizɔz Nɛ Jɛrusɛlɛm</para>
  <para style="r">(<ref loc="LUK 13:34">Lk. 13.34</ref>,<ref loc="LUK 13:35">35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />&lt;&lt;Jɛrusɛlɛm, Jɛrusɛlɛǃ abon aŋana duŋɔnɛ anebɛ ahemi dɛman ubasɛ, amagiduŋ bɔŋɔ dotomɔ yam datan Ubasɛ itom dotomɔ uye baruŋǃ kubi iyama ŋnoyɔ nkunɔ baruŋ da kɔnɔn ɔŋani bɔŋ bɛbɛ kubabi abon abunɔ duŋ. <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Isai kpomɔ dulimɛ boni iki chari uyạŋɛ foi <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />nbuninɛ nsạd baruŋ ayenɛ iyɛ sani kichin tata ɔramạŋ krure sạŋ nɛ arirɔnduŋ, tata atek duŋ &lt;Ubasɛ uye one wɛ uwu krokom ɔbɔd. &gt;&gt;&gt;<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">Jizɔz ɔnyɔm Chemɛ Kpomɔ Dulimɛ Kɔrɔk</para>
  <para style="r">(<ref loc="MRK 13:1">Mk. 13.1</ref>,<ref loc="MRK 13:2">2</ref>; <ref loc="LUK 21:5">Lk. 21.5</ref>,<ref loc="LUK 21:6">6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Jizɔz Uroŋɔ kpomɔ dulimɛ iragi mạŋɛnɛ bɔŋɛtɔ yɛyɛ ariyedmạŋ atogɔ arabɛŋ kɛtɔ. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />&lt;&lt; Jizɔz &gt;&gt; utek, &lt;&lt; koniruŋ okpo bakpai. Nhemɛ barun iyɛː kɔtan nawunɔ aa sạŋ one uroŋɔ kakpom yɛyɛ; aki karabɛŋ krɔchɛ. &gt;&gt;<verse eid="MAT 24:2" /></para>
  <para style="s">Afirɛ Nɛ Dutugɔ</para>
  <para style="r">(<ref loc="MRK 13:3-13">Mk. 13.3-13</ref>; <ref loc="LUK 21:7-19">Lk. 21.7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Kubi ɛyɛ Jizɔz ibiaginɛ kɛ ikon oliv, bɔŋɛtɔ yɛyɛ ari seimạŋ ikạm ane akakure. bɔŋɛtɔ yɛyɛ atek Jizɔz &lt;&lt; yemɛ bara kubisɛ okpo bakpai uwɛ uwukan, &gt;&gt; obuwɛ &lt;&lt; uchegɛ iyɛ kubisɛ ewuŋi ikitumi nɛ kubi ŋun kurạma itumi. &gt;&gt; <verse eid="MAT 24:3" /><verse number="4" style="v" sid="MAT 24:4" />Jizɔz utek, &lt;&lt; koi baruŋ, kasɛgɛ one nawunɔ uriri baruŋ. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Dɛyama, aki wukan ari hemɛ chiem kreto nyam, akitek &lt; ndenɛ mezayaǃ akiriri ane dɛyama. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Abon akikomɔduŋ iyɔm afirɛ ɔkpɛrɛ baduŋ iyɔm afirɛ isaŋ ikiwrɛ iyɛm; afirɛ kakɔmɔ. bomnyoi iki tebɛ asi nyɔi urɛ iyɛ didɛmara kuremɛ uwɛm. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Don abara akino nɛ ɛkpa bɛbɛ; kɛbɔd ikino nɛ kɛbɔd dɔwɔ nɛ dɔchɛ kuyik iki yạŋɛ kpom dɛyama. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Uba kpai iki yạŋɛ da umaŋa ɛmara. <verse eid="MAT 24:8" /><verse number="9" style="v" sid="MAT 24:9" />&lt;&lt; Akiyamawɛ aye ikɔm uwɛ ayewɛ dutuyɔ dube. Ane aki yɛrɛwɛ uwukan kɛ detoyam. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Ane dɛyama aki roŋɔ kunɛŋɛ kaam. aki rewɔ ɛkpa bɛbɛ ayɛrɛ ɛkpa bɛbɛ. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Dɛyama dɛmạn uyɛyɛmi Ubasɛ nfuɔ aki wukan abi riri dɛyama. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Nyɔi amɛ okpo ayinɛ uwɛ ɔyaŋanɛ usạd kubam ane dɛyama ɔwɔ mạm. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Asi ubɛ abanɛ ukpɔri anɛŋɛ uku tumi kɛ kikpɛ akiŋi bɛŋ. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Asi chɛm ikɔmɔ ɛrɔmɔya akiyɔmmaŋ kɛdon dɛbara kpai uwɛ ɔba anɛ kpai kandam tata kikpɛ uwukan.<verse eid="MAT 24:14" /></para>
  <para style="s">Okpo Kɛwɔdɔ ɔka Ane ɛkɔn ɔrɔmɔ</para>
  <para style="r">(<ref loc="MRK 13:14-23">Mk. 13.14-23</ref>; <ref loc="LUK 21:20-24">Lk. 21.20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />&lt;&lt;Aki rɔn &lt;umaŋa yɛ dɛmạn uyeyemɛ ubasɛ daniɛl inyɔmɔ ikiba kɛkpɔkpɛ unim unim. &gt;&gt;(kusɛgɛ ane bɛ aweniːkɔmɔ dukpeŋɛ boba iba uyeǃ) <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />&lt;&lt;Ane bɛ ariyạŋ kɛ Judi aki mɛdbɛŋ arabɛŋ kɛ ukon. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />One wɛ uyạŋ kɛtɔ dewe sạŋ kubi ɔrɔgi amɛ kubạna iwi nɔŋ bom kɛtɔ <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />one wɛ usạri dotomɔ sạŋ ndam ɔkɔ kukpe ɔkɔnɔŋ dɔbara utogɔ ɔmɛdmạŋ. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Da uwɛ ɔnyaŋi ukpa nɛ ane bani ubɛ ayạŋ nɛ utu nɛ ane bani bɛ atum bɔŋ kambɔkǃ <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Hani wɛ dulim iyɛ wɛ ngad kamɛd kɛ kubi itouwɔ nɛ kubi dewe kɛwaŋ kɔhɔgɔ bɛ Juǃ <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Afirɛ uwɛ dewe yɛ iki yaŋi urugɔ afirɛ bɛ usisi uyạŋɛ, kɛ kɔsani ndun tata ichiŋ. ɔkɔ bom nawunɔ uwɛ uyạŋɛ kɛ nyɔi. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Ubasɛ idisomɔ dɛwɛ dɛyama; nyɔi iri seri, one na wunɔ maŋ ɔnaŋi. uyɛ kɛ anɛ ubɛ amɛ inɔŋɛnɛ, danạ irɛrɛ ubasɛ iki sɔmɔ dɛwɛ. <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />&lt;&lt; Onɛ nawunɔ uwɛ utɛgɛwɛ, iyɛ &lt;kɔni, kɛ mɛzaya? &gt; ɔ &lt; kɛmạŋɛǃ - uyạŋɛnɛǃ &gt;--mạŋ kaneŋɛ. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Mɛzaya nfuɔ nɛ dɛmạn uyɛyɛmɛ nfuo aki wukan; aki sạd ikɔm nɛ ɔkpo kisɛ kisɛ sạn atohɔ ariri anɛ uwɛ Ubasɛ iyɛri, ɔkpa kpama. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Yɔrɔ kotoŋ ndiɳɛmɛwɛ kɛkui krurɛ. <verse eid="MAT 24:25" /><verse number="26" style="v" sid="MAT 24:26" />&lt;&lt;Urɛ, bobɛ anɛ abi hɛmɛwɛ iyɛ uyạŋkɛ kɛdɔchɛyɛ uyạŋ foi kesɛ ika kureǃ &gt;Ɛkata urɛmɛ atek urạbɛ mạŋkɛ anaǃ&gt; Mạŋ kaneŋɛ. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />wɔŋ ɔnɛrum iki wukan dana ekon nɛyɛ urɔnɔnɛ kɛdɛwɛ kpai sạni kɛrurɛ nɛ kandam. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Ikạmɛsi uburi bei bei iyạŋ utɛrɛ aki sumɔ.<verse eid="MAT 24:28" /></para>
  <para style="s">Kuwukan Awɔŋ One</para>
  <para style="r">(<ref loc="MRK 13:24-27">Mk. 13.24-27</ref>; <ref loc="LUK 21:25-28">Lk. 21.25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />Afirɛ dɛweri ɔlaŋkɛnɛ, uchirɛ ewe iki bạn kuɛk sạŋ iri ta, okonkoni iki toŋi krewɛ ikɔm iki yik okpo ikạm ayạŋ. <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />Isai Kuchɛyɛ awɔŋ onɛ rum ikiwuka; ane kpai kɛrɔchɛ aki lau dayinkem da arɔnɔnɛ wɔŋ onɛ rum da iwuŋi kɛdɛwɛ kɛbiaha yɛyɛ nɛ ikɔm nɛ dɛbad yɛyɛ. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Nfɔnɔ ɛnyi iki wunɔ, iki tom bɛ rotomɔ yɛyɛ kakpom kpai kɛrɔchɛ, aki sumɔ ubɛ amɛ inɔŋɔ sani kikpe dondɛbara tata uku tumi kikpe.<verse eid="MAT 24:31" /></para>
  <para style="s">Dukpeŋa Kese Fik</para>
  <para style="s">(Mk. 13. 24-27; Lk. 21. 25-28)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />&lt;&lt; Sạŋ nji gen usạdwɛ achiemi wɛ bom kubiyɛ ɔbɔbɔk ihenɛ kɛwa ibạna aki yenɛ iyɛ ɔkpam ikpɛrɛ. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Kubi ɛsɛ uwɛ awu arɔn okpoba kpai, aki yenɛ iyɛ kubi ikpɛrɛ, uwɛ nwu kan. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Damawɛ iyɛ okpo bakpai iki tebɛ isai ane bɛ anuginɛ kpai abe. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Dewe nɛ rɔchɛ iki tim, asi chɛmyam sạn utimɛ.<verse eid="MAT 24:35" /></para>
  <para style="s">Onewɛ Uyed Dewe Nɛ Kubi Kure</para>
  <para style="r">(<ref loc="MRK 13:32-37">Mk. 13.32-37</ref>; <ref loc="LUK 17:26-30">Lk. 17.26-30</ref>,<ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />Da ibirere &lt;&lt;onɛ kure uyed, dewe nɛ kubi yɛ ibuni uwukan, uwɛ atek ɛngɛl kạn de wɔŋ; ɔsɛ mạŋchen iyedɛnɛ. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />kuwu awɔŋ ubasɛ ubuninɛ uyạŋa da kubi nua. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Kɛ dewe mạm ibuninɛ ɔyạŋa kpom kpai ane aji awɔ, anerum nɛ anebani abani ɔban, tata utumi dewe nua iriɛ kokpok; <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />One dukpeŋɛ one idikɔ tata mạm uyugɔ ɔnyiaŋa uji bɛŋ kpai. iki remɛ nyɔi kubisɛ wɔŋ one uwɛ uwukan. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Kubi ɛsɛ anerum awumɔ aki sạd dotomɔ kɛramː aki bɛne uwunɔ aroŋɔ uwunɔ. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Ane bani awumɔ aki yạŋa asạdikɛ kokpɔgyː aki bɛne uwunɔ aroŋɔ uwunɔ. <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />Koiwɛ irɛ ayed dɛwɛ yɛ wɔŋ ubasɛ uwɛ uwukan. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Urɛ bobɛ ɔkɔɛtɔ iyɛd kubi ɛsɛ uyiune iwuŋi, aki koiwɛ sạn asɛŋɛ uyiunɛ iri kpawi ɛtɔ ɔriɛ. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Koiwɛ irɛ wɔŋ one iki wukan kɛkubi ɛsɛ ɛkana ɛkɔn ayạn kɛ amɛ.<verse eid="MAT 24:44" /></para>
  <para style="s">Nfɔnɔ Wɔŋɛtɔ Kạn De Wɔŋɛtɔ Iyina</para>
  <para style="r">(<ref loc="LUK 12:41-48">Lk. 12.41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />&lt;&lt; Wɔn ɛtɔwɛ uwɛ unɛŋene ɔkomɔ dukpɛŋɛ, uwɛ amɛ ɔsɛtɔ bɛbɛ ɔyaŋanɛ ukoi ubaran uyɛ bɛŋ kokpogy kubi ɛsɛ ututumi. <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Ekɔn dɔmɔ iki yạŋɛ uye wɔŋ ɛtɔ uwɛ ɔsɛ ɛtɔ uwuwu usai mạn usạrekɛ okpo bakpaiǃ <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Nhɛmɛ wɛne osɛ ɛtɔ uwɛ iki yaŋ wɔŋ ɛtɔ yɛyɛ ukoi okpo ɛtɔ yɛyɛ kpai. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Asi wɔŋ ɛtɔ iyine iki hɛmɛ ɛkpa yɛyɛ iyɛ ɔsɛ ɛtɔ sạn uwu kɛkubi ɛsara, <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />Iki sani bɛm bɔŋ, bɔŋ ɛtɔ yɛyɛ dɔtama ugyɛ owɔyɔ ne ane bɛ awɔyɔ okpo. <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />Osɛ ɛtɔ wɔŋ ɛtɔwɛ iki wukan dɛwɛyɛ wɔŋ ɛtɔwɛ ika ɛkɔn ɔyaŋ ne kubi ɛsɛ iki uyɛd. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Osɛ ɛtɔ wɔŋ ɛtɔwɛ iki soŋɔ mạŋ kikpegi usạd mạn uyiŋɛ ne ane bɛ asari da abɛ anim. ɛnɛ iki sani dibɛ toyɔ ɔnaya mạn dalaŋ.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">Kosei Aminiko Jiou</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />&lt;&lt; Kpomɔ kɛbɔd ubasɛ uyạŋɛ nɛ da anebani jiou abɛ ubɛ abɛnɛ ɛkonɔ kɛwaŋɔ bɛbɛ aka baŋa urum awukan ka kpomɔ ɔbana. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Atein aseri iheri , atein akɔ dukpɛŋe. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />ubɛ aserine iheri ari bene ɛkonɔ kɛwaŋɔ bɛbɛ asi ɛmia oneobene. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Asi anebanibɛ akanɛ onerum one uyed akɔne dukpɛŋe ari nɔŋɔkɛ ɛmia ɛkon kɛwaŋɔ aŋana kitrɛ atumɔkɛ nɛ ekonɔ mbɔgɔ ubɛbɛ. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Bɛ ɔban ari rɔgi kubi kuwu, ane asani kudeŋi arami. <verse eid="MAT 25:5" /><verse number="6" style="v" sid="MAT 25:6" />&lt;&lt;kiriɛ iritumi kubisɛ awenɛnɛ, kɛkɛ one wani uwɛ ubuni ɔban urum oke ari rɔn mạŋ. <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />ane bani jiou ɛbɛ akanɛ anerum one uyed akaibɛŋ aronɔ ekon ubɛbɛ abirɛmạŋ ɔta. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Akanɛ dukpeŋe one okɔ atek ubɛ akɔne dukpeŋɛ, iyɛ &lt; ye bara ɛmia ekon Olif boni ɛrɛrɛni, ire ekonɔ mbɔgɔ yori ikirạma. <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />&lt; Akɔnɛ dukpeŋe atek bɛŋ uwa sạn bara nɛ abon ubɛŋ dɔŋ duɳ ketɔ ɛya aka reou baruŋ. &gt; <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />Akanɛ dukpeŋɛ one okɔ atạm aka rɛubɛŋ ɛmia; kɛkɔ raga bɛbɛ onerum ɔbana uwukan. anebani atenɛbɛ ari kominɛ achɛŋ nɛ amɛ arabɛŋ kakpom obana, kikpegi umerɛ. <verse eid="MAT 25:10" /><verse number="11" style="v" sid="MAT 25:11" />&lt;&lt; Kubi uchirɛ ubaran awukan. &lt;ɔbɔd, ɔbɔdǃ sạŋ bara duriɛǃ &gt; arori. <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />&lt;Onerum ɔbana utɛk bɛŋ, &gt; baruŋ nyɛd. &gt;&gt; <verse eid="MAT 25:12" /><verse number="13" style="v" sid="MAT 25:13" />Jizɔz ɔkpɔŋo ɔwɔm, &lt;&lt;koi baruŋ, ire dɛwɛyɛ nɛ kubi yɛ ayɛd ruŋ.<verse eid="MAT 25:13" /></para>
  <para style="s">Kosei Bɔŋɛtɔ Asiri</para>
  <para style="r">(<ref loc="LUK 19:11-27">Lk. 19.11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />&lt;&lt; Kɛkubi ɛsɛ ikɔm ubasɛ iki wukan kɛrɛyɛ, da onewɛ ubuni ɛtɔ yɛyɛ kuroŋo aragamạn kɔcheŋ ɔsara wɛwɛ; uyɛd bɔŋ ɛtɔ yɛyɛ uyɛbɛŋ ikɔm kɛokpo ɛtɔ yɛyɛ. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Uyɛ onenɛ da ikɛmɛ kusạdː Uyɛ one uwunɔ dɔgɔd atạn, uyɛ one uwunɔ dɔgɔd awumɔ uyɛ one uwaran dɔgɔd uwunɔ. Isai ɔramạŋ kɔchɛŋ yɛyɛ. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Wɔŋ ɛtɔ uwɛ ɔnɔŋɛnɛ dɔgɔd atạn utogɔ akpogɔ yɛyɛ ukusạd bɔm, ɔkɔmɔkɛ dɔgɔd atạn. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Nyɔi dirik nɛ wɔŋ ɛtɔ uwɛ ɔnɔŋɛnɛ dɔgɔd awumɔ, ɔkɔmɔkɛ dɔgɔd awumɔ. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Wɔŋ ɛtɔ uwɛ ɔnɔŋɛnɛ dɔgɔd uwunɔ ɔkɔtɔk dɛma ɔnɔŋ akpowɔ ɔsɛ ɛtɔ uribe. <verse eid="MAT 25:18" /><verse number="19" style="v" sid="MAT 25:19" />Kɛkubi ɛsɛ ɔsɛ ɛtɔ bɔŋ ɛtɔbɛ iriwu irisạd kɔbaga nɛ abɛ. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Wɔŋ ɛtɔ uwɛ ɔnɔŋɔnɛ dɔgɔd atạn iriwu irisɛŋ dɔgɔd atạn. ayạŋ ɔnɛnɛ dɔgɔd atạn, utek ata, Kɛmạnkɛ dɔgɔd atạn uwɛ nkɔ. &gt; <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />Jizɔz utek esɛri inim, arɛnɛ wɔŋ ɛtɔwɛ unim akɔmɔ kunɛŋɛǃ ɔsɛ ɛtɔ utɛgɛnɛ. Ekɔkunɛŋɛ kɛ akpohɔ wɔŋ kutumɔ, nki ŋanawɛ kɛ ɔbara wɛwɛ. okɛ arichɛmɛ ɛkɔndɔmɔ nɛ ahamǃ <verse eid="MAT 25:21" /><verse number="22" style="v" sid="MAT 25:22" />Wɔŋ ɛtɔ uwɛ ariyạŋ dɔgɔd awumɔ uwukan iritɛk, ayạŋnɛnɛ dɔgɔd awumɔ ata. kɛmạŋka dɔgɔd awumɔ uwɛ nkɔ. <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />Jizɔz utek Esɛri inim, arɛnɛ wɔŋ ɛtɔ inimɛ akɔmɔ kunɛŋɛǃ &gt; ɔsɛ ɛtɔ utɛgɛnɛ. ekɔkunɛŋɛ akpɔhɔ wɔŋ kutumɔ nkiŋanawɛ kɛ ɔbarawɛwɛ. ɔkɛ arichɛmɛ ɛkɔdɔm nɛ ahamǃ <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />Wɔŋ ɛtɔ uwɛ ɔnɔŋɛnɛ dɔgɔd uwunɔ uwukan iritɛk, &lt;ata, diyɛd nnɛ awu arɛnɛ onɛ ikporɔ; awu atɔginɛ ikạm ɛka akɔnɔ, ayaŋ ɔkpɔbɛ ikạm ɛkabɛŋ achari. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Kɛwɔd iriserinɛ, nbɛnɛ akpohɔ yoyo nkaribɛ kɛrɔchɛ. Kɛbobɛ ɔkɔwɛ. &gt; <verse eid="MAT 25:25" /><verse number="26" style="v" sid="MAT 25:26" />Awu arenɛ wɔŋ ɛtɔwɛ iyinɛ akpamaǃ ɔsɛ ɛtɔ utɛgɛnɛ. awu ɛyɛd, iyɛ nkatɔginɛ kɛkpokpɛ nka nkonɔ, nbumɔ bɛŋ kɛkpokpɛ nka chari. <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Awu ba aŋana akpohɔ nyam kɛtɔ akpohɔ, bɛ nnɔŋ mạŋ kɛkpai nɛkɔnɛnɛ kɛkɔn. <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />Namạŋduŋ akpohɔyɛ ayɛruŋ onewɛ ɔkɔnɛ dɔgɔd jiou <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Kɛ anɛbɛ akɔnɛ bom, urɛmɛ dɛyama akiyɛbɛŋ, iki kɔmɔ dɛyama da ibikɔ; asi ɔnɛ uwɛ ɔkanɛ bom ɔkɔ urɛmɛ ɛrɛrɛni ikɔ akɔmạŋɛnɛ kɔna. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Kɛwɔŋ ɛtɔ ihɛriwa--karamạŋ kɛrɛbɔm kɛkirimi; ɛnɛ ikito ɔnamạŋ dalaŋ. <verse eid="MAT 25:30" /><verse number="31" style="v" sid="MAT 25:31" />Kubi ɛyɛ wɔŋ one uwɛ uwukan da ɔbɔd nɛbɛ dotomɔ yɛyɛ nɛ amɛ, iki kibiaha kɛkɛbiaha ikɔmɔ yɛyɛ, <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Anɛbɛkpai kɛdon dibara aki sumɔ nɛamɛ. Iki chɛmɛ bɛŋ kikpɛk awumɔ, da onewɛ ukɔyi, iki chɛmɛ ɛhɔm ɔlawɔ nɛ ibund. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Iki yaŋ anɛbɛ asɛri nfɔnɔbom kɛkurumbɔk ubaran kɛkpabɔk yɛyɛ. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />Obɔd ikitɛk anɛbɛ ayạŋɛnɛ kɛkurumbɔk yɛyɛ, okɛruŋ abonɛbɛ asɛm inoŋinɛǃ okɛ arinoŋduŋ donɛya uwɛ arinoŋinɛ ayaŋbarun sani kɔsani dondɛbarasa kpai kubod. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Dɔwɔ irinonɛ awu ayɛnɛ okpogy, mạm iri rɛginɛ awu ayɛnɛ mạm; ndirɛnɛ usin awu anɔŋnɛ aŋana kɛtɔ, <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Ndiyiŋɛnɛ kɛwɔn awu ahaninɛ nku. &gt; <verse eid="MAT 25:36" /><verse number="37" style="v" sid="MAT 25:37" />Anɛbɛ achɛŋi kiyɛm yɛyɛ atɛk mạn, mạn kubi ata uwɛ dɔrɔn wɛnɛ dɔwɔ unowɛ duyɛwɛ okpogy, nɛkubi ɛyɛ uwɛ dɔrɔn wɛnɛ duyɛwɛ mạm? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Mạn kubi uwɛ dɔrɔnwɛ da usin duyɛd dɔŋana ɛtɔ, nɛkuyɛ uwɛ ayạŋɛ kɛwɔn dɔŋani wɛ nku? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Mạn kubi uwɛ dɔrɔnwɛ amawɛ uwum nɛkubi ɛyɛ uwɛ ayạnɛ kɛtɔ kumerɛ duwukan? &gt; <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />Obɔd iki tɛk, &lt;dihɛmɛyɛ kubi ɛyɛ uwɛ awu asạdɛnɛ nfɔnɔ bom ayɛ onɛbɛ achɛŋinɛ aham, ɛsɛri ayɛnɛǃ &gt; <verse eid="MAT 25:40" /><verse number="41" style="v" sid="MAT 25:41" />&lt;&lt;Iki tɛk nɛ ubɛ ayạŋmạn kɛkpabɔk, dɔŋduŋ aroŋɔnɛruŋ, awuwɛ ayạŋɛnɛ kɛdulim iyinɛ ubasɛǃ dɔnduŋkɛ ɛkon ɛyɛ ɔka kikpɛ ɔkɔ uwɛ ubasɛ iborinɛ ɔyaŋ uyɛ okpo ayinɛ nɛbɛ dotomɔyɛyɛǃ <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Dɔwɔ irinonɛ asinɛ okpo ariyạŋ, mạm urɛknɛ nɛmạm ayaŋ nwɔr; <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Ndirɛnɛ usin nɛ ayɛri aŋana kɛtɔ, nyạŋɛ kɛwon nɛ nku aŋani; nmanɛ uwum nyạŋɛ kɛtɔ umɛmɛrɛ nɛ awu ariyɔŋɔ. &gt; <verse eid="MAT 25:43" /><verse number="44" style="v" sid="MAT 25:44" />Aki tek mạŋ, &lt;kubi, Obɔd, dɛrɔnwɛ dɔwɔ unowɛ nɛkubiyɛ mạm irɛgiwɛ nɛkubiyɛ ɛrɛ usin nɛkubiyɛ ɛyạŋ kɛwɔn nɛkubiyɛ ɛmawɛ uyum nɛkubiyɛ ɛyạŋ kɛtɔ umɛmɛrɛ dɛkaduwu dɛri yɔŋɔwɛ? &gt; <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />Obɔd utek, dihɛmɛwɛ, kubi ɛsɛ ɛyim onɛ nfɔnɔbom kuyɛ, ɛyimnɛbom kuyɛ. &gt; <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />Isaya, akisinɛwɛ aŋana kɛ ɛkon ɛyɛ ɔka kikpe ɔkɔ, asi ubɛ achɛŋɛnɛ kɛ nfɔnɔ iyɛm aki rabɛŋ kɛ ɛkpenɛyɛ ɔkakikpɛ ɔkɔ. &gt;&gt;<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">Detema Kirạmi Uwɛ asạd Jizɔz</para>
  <para style="r">(<ref loc="MRK 14:1">Mk. 14.1</ref>,<ref loc="MRK 14:2">2</ref>; <ref loc="LUK 22:1">Lk. 22.1</ref>,<ref loc="LUK 22:2">2</ref>; <ref loc="JHN 11:45-53">Jn. 11.45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Uwɛ Jizɔz ilaŋa nɛ kokpo kpai kuchegi, utɛk bɔŋɛtɔ yɛyɛ, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />&lt;&lt;Krewe awumɔ, da eyeduŋ, ikiremɛ efinɛ kujiɛ yori, nɛ wɔŋ one kɔsɛŋ aye uwe aka mud kɛ kese. &gt;&gt; <verse eid="MAT 26:2" /><verse number="3" style="v" sid="MAT 26:3" />Bɛ ikɔmɔ donɔ nɛ arɛtama donɔ akisumo kɛtɔ ɔbɔd kaiafas, orɛtam bɛ ikɔmɔ donɔ, <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />Ahema dauwɛ achɛŋ ayama Jizɔz kimạm aka ŋan. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Atek &lt;&lt;sạn boba dusạri kɛkubi efinɛ&gt;&gt;ɔka nyɔi &lt;&lt;ure ane aki sạd afirɛ. &gt;&gt;<verse eid="MAT 26:5" /></para>
  <para style="s">Abega Jizɔz ɛmia Kɛ Bɛtani</para>
  <para style="r">(<ref loc="MRK 14:3-9">Mk. 14.3-9</ref>; <ref loc="JHN 12:1-8">Jn. 12.1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Jizɔz iriyạŋɛnɛ kɛ betani kɛtɔ saimɔn, onɛrum ɔwɛ ɔmaya mạŋ uyum ɛkpa. <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />Uwɛ Jizɔz irigiɛnɛ okpo, onewani uwukan kamɛ nɛ dɔtana animɛ uwɛ ɔchɛŋi nɛ kinyu ɛrɔmɔ, uwɛ inyama Jizɔz kreto. <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />Bɔŋ ɛtɔ bɛ arɔnɔnɛ ɛkɔn uyinɛ bɛɳ. obo ubakpai ikpoŋɔ?&gt;&gt; abɔu. <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Emia kinyuo ɛyɛ ibɛŋda arɛwɔmạŋ kɛ akpɔhɔ ɛbara ayɛ ahanɛ akpohɔyɛǃ&gt;&gt; <verse eid="MAT 26:9" /><verse number="10" style="v" sid="MAT 26:10" />Jizɔz iyɛd bobɛ ayɔmi, utɛk bɛŋ , obo ɛyibiruŋ onɛwaniwa? urɛnɛ nfɔnɔbom nɛ bominimɛ uwɛ isɛri uyɛnɛ. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Akikɔmɔ ahanɛ nɛ awu, Asi sạnnɛ awahi akɔmɔ. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Bobɛ isɛri urɛnɛ aham ɛmia kinwuo kubeyɛ kɛkpa ntohɔ ndanɛ dubɛ. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Isai nki sạdwɛ ayɛnɛ iyɛ akihɛmɛ chɛmyamaya kɛdon dɛbarayakpai, bobɛ isɛri aki hɛmikpai kɛ diramiyɛyɛ. &gt;&gt;<verse eid="MAT 26:13" /></para>
  <para style="s">Jadas Iyera Jizɔz kɔrɛwɔ</para>
  <para style="r">(<ref loc="MRK 14:10">Mk. 14.10</ref>,<ref loc="MRK 14:11">11</ref>; <ref loc="LUK 22:3-6">Lk. 22.3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Onɛ bɛbɛ uwunɔ kɛbɔŋ ɛtɔ jiou nɛ awumɔ-onɛ uwunɔ ukoni judas iscariɔt--ɔramạŋ kɛ orɛtam ikpomɔ bɛbɛ. <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />ɔkɔbɔu, &lt;&lt;obo uwɛ ayɛnɛ nsɛsạŋɛ Jizɔz nŋana baruŋ kɔbɔk? &gt;&gt; <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Sani ɛnɛ judas iribuninɛ nfɔnɔ iyɛm uwɛ ɔsạŋ Jizɔz ɔŋana bɛŋ kɔbɔk.<verse eid="MAT 26:16" /></para>
  <para style="s">Jizɔz Uji Efinɛ kɔnaŋa Nɛ Bɔŋɛtɔ yɛyɛ</para>
  <para style="r">(<ref loc="MRK 14:12-21">Mk. 14.12-21</ref>; <ref loc="LUK 22:7-13">Lk. 22.7-13</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Jn. 13.21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Kɛ ɔlɔŋi dewe efinɛ uwɛ ayai kitawɔ ɔkara okpo ika utoŋɔ bɔŋɛtɔ jizɔz arabɛŋ uru Jizɔz abɔumạŋ, &lt;&lt;nda ebuni bara dɔnɔŋ okpojiɛ efinɛ yoyo?&gt;&gt;<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />Utek &lt;&lt;Dɔŋduŋ konewɛ kɛ don ɛbara, &gt;&gt; &lt;&lt;aka tekmạŋː Onewɛ uchegi iyɛ, kubi yɛyɛ iwu; ː aam nɛ bɔŋɛtɔ mbam dubuninɛ duji efinɛ kɔnaŋa kɛtɔ yoyo. &gt;&gt;&gt;<verse eid="MAT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 26:19" />Bɔŋ ɛtɔ yɛyɛ asạd da jizɔz itombɛŋ ayau okpogi efinɛ. <verse eid="MAT 26:19" /><verse number="20" style="v" sid="MAT 26:20" />kiriɛ iwunɛ, jizɔz nɛ bɔŋ ɛtɔ yɛyɛ jiou nɛ awumɔ abiaga uwɛ agi. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Kubi kokpogi ɛyɛ jizɔz utɛk, nhɛmiwɛnɛ, one boni uwunɔ ikitɔnɛ nbɔk. '' <verse eid="MAT 26:21" /><verse number="22" style="v" sid="MAT 26:22" />Bɔŋ ɛtɔ yɛyɛ ɛkpa iribe bɛŋ asani mạŋ kɔbou, kɛ one nɛ one, ata denɛ. <verse eid="MAT 26:22" /><verse number="23" style="v" sid="MAT 26:23" />Jizɔz utɛk bɛŋ , &lt;&lt;onewɛ usuminɛ mbɔk nɛ am ujiɛ okpo amɛ uwɛ ɔtɔnɛnɛ mbɔk. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Wɔŋ one ikibɛ da kusɛgɛ ubasɛ itegɛ iyɛ iki rɛmɛ, asi nạn uwɛ uyinnɛ uyɛ one rummɛwɛ uwɛ ɔtɔnɛ wɔŋ one nbɔkǃ bunim uyɛ onerummɛwɛ ibikana ɔrɔmadǃ'' <verse eid="MAT 26:24" /><verse number="25" style="v" sid="MAT 26:25" />Judaz, uwɛ ubuni mạŋɛnɛ nbɔk kɔtɔ, utek iyɛ, kuchɛgi awu iyɛ nurɛ ɛyɔmi. jizɔz utɛk mạŋ iyɛ kɛra ɛnyɔmɔɛ. &gt;&gt;<verse eid="MAT 26:25" /></para>
  <para style="s">Okpoji ɔbɔd</para>
  <para style="r">(<ref loc="MRK 14:22-26">Mk. 14.22-26</ref>; <ref loc="LUK 22:14-20">Lk. 22.14-20</ref>; 1 Kɔr. 11.23-25)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Kɛkubi ɛyɛ agiɛnɛ okpo, jizɔz ɔnɔŋ kitawɔ dɔkara ɔkpakpari uyɛ dilimɛ dɛsama, ɔmiɛk bɛŋ, uyɛ bɔŋ ɛtɔ yɛyɛ. &lt;&lt; utạk bɛŋ nɔŋ ajiruŋ, &gt;&gt; Jizɔz utɛk uwa urɛnɛ ɛkpa nyam. ''<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />Ɔbɛnɛ mạnk, uyɛ Ubasɛ dɛsama , ɔsɛŋ uyɛ bɛŋ. Wɔruŋ abonkpai, &gt;&gt; jizɔz utɛk;<verse eid="MAT 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 26:28" />Uwa urɛnɛ dayiŋ yam uwɛ ɔchɛŋ nɛ kuyerɛ Ubasɛ, dayiŋ yam ibegɛnɛ uyɛ dɛyama kɛkɔkagi uyɛ bɛŋ kɛ okpo ayinɛ.<verse eid="MAT 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 26:29" />Nhɛmiwɛnɛ, sạn ituwɔ ndi wɔkɛ tata dewɛyɛ uwɛ nwɔ ituwɔ isin nɛ awu kɛkɛbɔd asɛm. &gt;&gt;<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Isai atonkoton ara bɛŋ kɛ ikon oliv.<verse eid="MAT 26:30" /></para>
  <para style="s">Jizɔz uhemɛ Iyɛ Pita Iki Kanmạŋ</para>
  <para style="r">(<ref loc="MRK 14:27-31">Mk. 14.27-31</ref>; <ref loc="LUK 22:31-34">Lk. 22.31-34</ref>; <ref loc="JHN 13:36-38">Jn. 13.36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Isai jizɔz utɛk bɛŋ, &lt;&lt; nɛkiriniɛya abonkpai aki mɛd baruŋ kpai aroŋɔnɛruŋ, irɛ kusɛgɛ &lt;Ubasɛ itɛgɛ iyɛ, Ubasɛ iki han ukokoi ɛwɛ, bɔŋ bɛbɛ kpai akichari. &gt;<verse eid="MAT 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 26:32" />Kubi ɛyɛ uwɛ nkai nɛ kɛ kɛkpɛn, nki ranɛ kɛ Galilee kɛdurɛ yoyo. &gt;&gt; <verse eid="MAT 26:32" /><verse number="33" style="v" sid="MAT 26:33" />Pita utɛk jizɔz iyɛ, am sạŋ wɛ ndoŋɔ urɛmɛ bɛmkpai aroŋɔwɛǃ&gt;&gt;<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />Jizɔz utɛk pita, sạŋ ŋemɛwɛ kɔnɔn iyɛ ukuyạŋa ɔkɔkɔrɔ nɛkirạni, akikanwɛ nkpan asiri iyɛ nɛ ayɛd. &gt;&gt;<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Pita utɛk, sạŋ nyɔi ntɛgɛ, urɛmɛ nbuni kubɛ nɛ awuǃ &gt;&gt; bɔŋ ɛtɔ ubaran kpai atɛk nyɔi.<verse eid="MAT 26:35" /></para>
  <para style="s">Jizɔz ɔŋanamạŋ dulim Kɛ Gɛdsamani</para>
  <para style="s">(Mk. 14. 32-42; Lk. 22. 39-46)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Isai jizɔz nɛ bɔŋɔ ɛtɔ yɛyɛ aramạŋ kɛ kpokpɛ awɛninɛ Gɛdsamni, utɛk bɔŋɔ ɛtɔ yɛyɛ, &lt;&lt;biaharuŋ aa sạŋ ndanɛ krewe nka ŋananɛ dilim nye Ubasɛ. &gt;&gt; <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Utohɔ pita nɛ bɔŋ anerum zɛbɛdi awumɔ nɛ amɛ. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Jizɔz utɛk bɛŋ, ɛkɔn kpama nfɔnɔ wɛwɛ iyuhɔnɛ dɛkɔn duri. yạnɛruŋ akɔm nɛruŋ ar. &gt;&gt;<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />Usinɛ mạŋkɛ kɛrurɛ usɛmɛ durɛ kɛ rɔchɛ, ɔŋana mạŋ dilim, asɛhɛm, urɛ bobɛ ikpama, bɛnɛ mạk dutuhɔya alawɔ kɛ-amǃ da nbuni ure, asi da ɛbuni. &gt;&gt;<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Ukpe ndam uwu kan kɛ bɔŋ ɛtɔ asiri ɛyɛ iri sɛi bɛŋ da arami; utɛk pita, nạn irɛ uwɛ baruŋ toŋ asiri ɛka akɛmɛ kukomnɛ ruŋ kɛ kubi uwunɔ?<verse eid="MAT 26:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 26:41" />Yạŋɛ ruŋ ar ahaniruŋ dilim sạŋ awa ruŋ kɔtɔ kɛ okpo bɛ uwɛ iri hɛk baruŋ. Urɛgikɛ kɛwaŋ asi ɛkpa ɛka ikpama. &gt;&gt;<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Jizɔz ukpɛkɛ nkpaŋ awumɔ ɔkɔŋana mạŋ dilim, asɛm urɛ bobɛ akana mɛk dutuhɔ onɛ obɛnɛ alauwɔ tata nwɔmạn, sạŋ urɛmɛ da ɛbuni, &gt;&gt;<verse eid="MAT 26:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43" />Ukpe kɛ ndam ukusɛi bɔŋ ɛtɔ yɛyɛ kɛ dɔrau; onɛ jɛn ɔkɛmɛ kuwiŋɛ.<verse eid="MAT 26:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 26:44" />Jizɔz urɔŋɔ bɛŋ kɛ kubi nkpaŋ asiri, ɔramạŋ ɔkɔŋana mạŋ dilim utekɛ chɛm uwunɔwɛ.<verse eid="MAT 26:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45" />Ukpekɛ kɛ bɔŋ ɛtɔ yɛyɛ utek, aki rami ruŋɛnɛ ɔrami ahɔgiruŋ kɛwaŋ? koni ruŋǃ kubi itumi uwɛ asɛŋ wɔŋ onɛ aŋana bɛ ikɔm ayinɛ kɔbɔk.<verse eid="MAT 26:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 26:46" />Kai baruŋ, dɔrabara ruŋ. koni ruŋ kɛkɛ onɛ rumɛwɛ ubuninɛ ɔtɔnɛ nbɔkǃ&gt;&gt;<verse eid="MAT 26:46" /></para>
  <para style="s">Jizɔz Kɔyama</para>
  <para style="r">(<ref loc="MRK 14:43-50">Mk. 14.43-50</ref>; <ref loc="LUK 22:47-53">Lk. 22.47-53</ref>; <ref loc="JHN 18:3-12">Jn. 18.3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Jizɔz iki tumkɛ chɛm kɛ ɛma, judaz uwunɔ kɛwɔŋ ɛtɔ jiɔu nɛ awumɔ yɛyɛ uwukan, nɛ anɛ dɛyama nɛ okpo dɛbana nɛ ndɔmɔ uwɛ orɛtam bɛbɛ nɛ atamnɛ atom bɛŋ.<verse eid="MAT 26:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 26:48" />Judaz nɛ nbɔk, uchɛhɛ anɛ dɛyama bɛː onɛrumɛwɛ nbunɔ nyɛ ɛma amɛ ɛbuniruŋɛnɛ yama mạŋduŋǃ&gt;&gt;<verse eid="MAT 26:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49" />Judaz ɔraga mạŋ nnɛn nnɛn uru jizɔz ukutɛk, kɔkpama uyạŋɛnɛ awu, kuchɛgi, &gt;&gt; uyɛ mạŋ ɛma.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />jizɔz utɛk, wahi ɔwahi ayiǃ &gt;&gt; isai awukan ari yama jizɔz, ayamamạŋ ukpori.<verse eid="MAT 26:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 26:51" />Onɛ uwunɔ uwɛ uyạŋ nɛ jizɔz ɔlawɔmạŋ ɛrɔmɔ kibai usoŋɔ wɔŋ ɛtɔ ɔrɛtam bɛbɛ iritoŋ.<verse eid="MAT 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52" />Jizɔz utɛk mạŋ ŋana ɛrɔmɔ yoyo kibai. Anɛ bɛkpai abɛninɛ ɛrɔmɔ abɛnɛ kɛ ɛrɔmɔ.<verse eid="MAT 26:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 26:53" />Ayɛd iyɛ ibɛŋda nyɛri asɛm iri lawɔnɛ, ibɛŋda isinɛ bɛrɛkpo dotomɔ yam uwɛ uruhɔ jiɔu nɛ awumɔ?<verse eid="MAT 26:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 26:54" />Asi urɛ bobɛ irɛ nyɔi, nạn kusɛhɛ ubasɛ uwɛ uwukan kɛrihɛŋɛnɛ uwɛ utɛkhɛ iyɛ kɛra uwɛ urɛmɛ?&gt;&gt;<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Isai jizɔz ɔyɔm nɛ dɛyɔhɔyɛ, awuruŋɛnɛ nɛ ɛrɔmɔ ari yama nɛruŋ,<verse eid="MAT 26:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="MAT 26:56" />Asi uwakpai uwu nɛ iri rɛmɛ dana dɛman uhɛhɛmɛ ubasɛ isɛgi kɛ kusɛhɛ ubasɛ. &gt;&gt; bɔŋ ɛtɔ yɛyɛkpai aroŋɔ mạŋ amɛdbɛŋ.<verse eid="MAT 26:56" /></para>
  <para style="s">Kɛba Jizɔz Kɛ Kɛbiaga Abɔd</para>
  <para style="r">(<ref loc="MRK 14:53-65">Mk. 14.53-65</ref>; <ref loc="LUK 22:54">Lk. 22.54</ref>,<ref loc="LUK 22:55">55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13">Jn. 18.13</ref>,<ref loc="JHN 18:14">14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Ubɛ ari yamanɛ jizɔz abɛnɛ mạŋ atohɔ arabɛŋ kɛtɔ caiafas, orɛtam bɛbɛ, ikạm bɛ anɛ bɛ achɛgi ntotobɔnɛ atamnɛ asumɔ.<verse eid="MAT 26:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 26:58" />Pita ichɛŋ nɛ jizɔz uyạŋɛ iyɛm iwerɛ kɛ ɛtɔ ibaŋa orɛtam bɛbɛ. ita kɛtɔ ibaŋa ɔbiaha nɛ anɛ bɛ akɔi kpom ɔrɔnd da uwɛ urɛmɛ.<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />Orɛtam bɛbɛ nɛ abɔd ibaŋa ano uwɛ arɔn kugbiɛ kɛ jizɔz sạŋ asinɛ mạŋ dubɛ; <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Asi nawunɔ onɛ ɔron, dɛyama ari chɛŋ awukan kɛ rurɛ ari hɛmɛ nfu. kikpɛ, anɛ awumɔ ajɔwɔ awukan.<verse eid="MAT 26:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="MAT 26:61" />aritɛk, ataya utɛhɛnɛ, am di kɛmɛ kpom ubasɛ kɔchari nkpekɛ nbɔu mạŋ kɛ kɛdɛwɛ asiri. &gt;&gt;&gt;<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Orɛtambɛbɛ ɔkaimạŋ ɔba utɛk jizɔz, chɛm akɔ uwɛ ahɛmɛ kɛ chɛmɛba anɛni wɛnɛ ar?''<verse eid="MAT 26:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MAT 26:63" />Asi jizɔz dɛman ɔkɔ. orɛtam bɛbɛ utɛk mạŋ kɛ, kɛrokom ubasɛyɛ uyạŋ kɛ ɛkpɛn di ŋana wɛ kɛ dɛman kɔyaŋː hɛmɛ bara kạŋ awu arɛ wɔŋ mɛzzaiya, wɔŋ ubasɛ. ''<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />Jizɔz utɛk mạŋ, kɛra ɛyɔmɔɛ. asi nhɛmi baruŋɛnɛ kpaiː sani kɛ kubi ɛya ɔraha mạŋ aki rɔnduŋ wɔŋ onɛ da ibiahi kɛ kurumbok ubasɛ ɛbara uwuŋhi kɛ kibɛmɛ dɛweɛǃ&gt;&gt;<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Kɛ ɛ, orɛtam bɛbɛ ɔyari jizɔz dɔbara utɛk, ɔyɔminɛ iheriǃ dɛri bunɔ onɛna wunɔ ɔyɔm chɛm ɔba mạŋ kandamǃ ekomɔ ihɛri ɛyɛ iyɔmɔǃ<verse eid="MAT 26:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 26:66" />Obu urɛ ɛkɔn boni?&gt;&gt; atɛk, igbiɛ ine uwɛ ubɛ. &gt;&gt; <verse eid="MAT 26:66" /><verse number="67" style="v" sid="MAT 26:67" />Isai atubɔ mạŋ ditaŋ kɛ durɛ atam mạŋ nɛ ubɛ amɛni mạŋ kibai<verse eid="MAT 26:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MAT 26:68" />atɛk hɛmɛ bara dɛman ubasɛ, one wɛ uchegi iyemǃ siŋɛ onewɛ ɔyɛmɛwɛǃ&gt;&gt;<verse eid="MAT 26:68" /></para>
  <para style="s">Pita ɔkan Mạŋ Jizɔz</para>
  <para style="r">(<ref loc="MRK 14:66-72">Mk. 14.66-72</ref>; <ref loc="LUK 22:56-62">Lk. 22.56-62</ref>; <ref loc="JHN 18:15-18">Jn. 18.15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Pita iri biahinɛ kɛ rɛbɔm ɛtɔ ibaŋha isai onewani wɔŋ ɛtɔ orɛtam bɛbɛ abuninɛ ahan ubasɛ uwukan, utek pita awu dirik achɛŋɛnɛ nɛ jizɔz uwɛ galili. ''<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />Asi ɔkan mạŋ kɛdure bɛbɛ kpai. pita utek bɛŋ nyɛ bobɛ ɛyɔmiruŋ<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />Oraha mạŋ ɔkɔ ba kɛ itạm dɛma ɛtɔ ibaŋa ɔkɔba. onewani wɔŋ ɛtɔ urɛhɛrik ɔrɔn mạŋ utek anerumɛbɛ , iri yạŋɛnɛ jizɔz uwɛ nazarɛt. &gt;&gt;<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Isai pita ɔkaan mạŋ kɛ utek kɛ dihɛnhɛnɛ onerumɔwa nyɛdǃ&gt;&gt;<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Kɛ kubi ane bɛ aribayanɛ atek Pita. &lt;&lt; deyed awu ayạŋɛnɛ nɛ abɛ, &gt;&gt;atek. &lt;&lt;da esạdri deyed ane awu ayạŋɛnɛ nɛ abɛǃ&gt;&gt;<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Isai pita utɛk, &lt;&lt; kɛ dihɛnhɛnɛ nhɛmi baruŋɛnɛǃ sạn ubasɛ utuhɔnɛ am onerumɛwa nyɛdǃ &gt;&gt; isa sai kɔnɔn uyɛ dɛman,<verse eid="MAT 26:74" /></para>
  <para style="p">
    <verse number="75" style="v" sid="MAT 26:75" />Pita ɔrama mạŋ bobɛ jizɔz iritekhɛ mạŋ isai kɔnɔn uyɛ dɛman, akitek nkpaŋ asiri iyɛ nɛ ayɛd. &gt;&gt; ɔnani ɔsani dayạŋkạm.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">Atogɔ Jizɔz Aranbɛŋ Uru Pailɛd</para>
  <para style="r">(<ref loc="MRK 15:1">Mk. 15.1</ref>; <ref loc="LUK 23:1">Lk. 23.1</ref>,<ref loc="LUK 23:2">2</ref>; <ref loc="JHN 18:28-32">Jn. 18.28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Nɛkichi arɛtạm abara nɛ aretạm ubaran arikɔ ditema aye Jizɔz da uwɛ achɛŋ aŋan Jizɔz.<verse eid="MAT 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 27:2" />Abɔu mạŋ mbɔk atogɔ mạŋ arabɛŋ akaye pailɛd, ikɔmɔ kɛbiaha Ruman.<verse eid="MAT 27:2" /></para>
  <para style="s">Dube Judas</para>
  <para style="r">(<ref loc="ACT 1:18">Ak. 1.18</ref>,<ref loc="ACT 1:19">19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Kubi ɛyɛ judaz ɔtɔnɛ jizɔz nbok, irɔnɔnɛ iyɛ anɔŋɔ ibanha anɛnɛ jizɔz kɛrɛto, uhɛnɛ ɛkɔn ɔbɛnɛ kɛ akpuhɔ dɛnaunɛ nɛjiɔu ɔkɔ yankɛ uyɛ ɔrɛtam bɛbɛ nɛ atamnɛ bɛ.<verse eid="MAT 27:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 27:4" />Judaz utek disɛri bɔm iyinɛ nnɔŋɛnɛ wɔŋ ɔnerumɛya ɔkanɛ kugbiɛ ɔkɔ nyɛ dubɛ. Atek mạŋ obo dɛkɔ kusạd nɛ uhɛm yoyoǃ uwɛ urɛnɛ afirɛ yoyoǃ&gt;&gt;<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />Judaz ɔkara akpuhɔyɛ kakpomɔ dilimɛ bɛbɛ uroŋɔ ɛ ɔkɔ yɔrɔ ɛkpa yɛyɛ.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />Orɛtam bɛbɛ ɔbɛnɛ akpuhɔyɛ utek , uwa urɛnɛ akpuhɔ dayạŋɛ, urɛnɛ uwɛ ɔkana unim kɛ dɛman yori uwɛ dɛyaŋ iyɛ unim ayaŋ mạŋ kakpomɔ dilimɛ. &gt;&gt;<verse eid="MAT 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 27:7" />Kɛ kubi ɛyɛ ituminɛ kɛ dɛman nɛyɛ ayaŋ, anɔŋ akpuhɔyɛ atohɔ arɛɔu kpomɔ dɔchɛ uwɛ uyạŋ da kpokpɛ aniyɛ asin.<verse eid="MAT 27:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 27:8" />Amɛ usɛrinɛ awɛni kpokpɛ, kpomɔ dayạŋɛ tata itumi dɛwɛ uwɛ ichiŋ.<verse eid="MAT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9" />Bobɛ jɛrimaya dɛman uhɛhɛmɛ ubasɛ itekhɛnɛ irɛ kɛrihɛnhɛnɛː &lt;&lt;Anɔŋ akpohɔ dɛnaɔu nɛ jiɔu, kɛ kɔbaha yɛ bɔŋɔ izuɛl ari yerɛ mạŋɛnɛ kuyɛ<verse eid="MAT 27:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 27:10" />atohɔ akpohɔ yɛ arɛu dɔchɛ anɛ kuni da ubasɛ itɛhɛnɛ. &gt;&gt;<verse eid="MAT 27:10" /></para>
  <para style="s">pailɛd ɔbɔu Jizɔz Dɛbɔwɔ</para>
  <para style="r">(<ref loc="MRK 15:2-5">Mk. 15.2-5</ref>; <ref loc="LUK 23:3-5">Lk. 23.3-5</ref>; <ref loc="JHN 18:33-38">Jn. 18.33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Jizɔz ɔba krurɛ ikɔmɔ kɛbiaga Ruman, abɔumạŋ &lt;&lt;Awu arenɛ ɔbɔd bɛ ju?&gt;&gt;. Jizɔz ɔbɔnɔ mạŋ kɛ da awu ɛyɔmɔ ɛɛ. &gt;&gt;<verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />Bom nawunɔ ɔyɔmɔ kɛ chɛm ɛbɛ arɛtam nɛ atamnɛ bɛ ju anɛnɛ mạŋɛnɛ. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Pailet utek mạŋ, ɛkɔmɔ okpo bɛ kpai anɛnɛwɛ?''<verse eid="MAT 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14" />Jizɔz urɛmɛ chɛm uwunɔ ɔyɔmɔ, kɛ bobɛ onewɛ uyạŋ kɛ ikɔmɔ kɛbiaha irɔnɔnɛ, ɛkpa ubɛ mạŋ.<verse eid="MAT 27:14" /></para>
  <para style="s">Abi Jizɔz Ibaŋa Dube</para>
  <para style="r">(<ref loc="MRK 15:6-15">Mk. 15.6-15</ref>; <ref loc="LUK 23:13-25">Lk. 23.13-25</ref>; <ref loc="JHN 18:39">Jn. 18.39</ref>; <ref loc="JHN 19:16">19.16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Krawe efinɛ nawunɔ, ikomɔ kɛbiaha Ruman ika kɔmi kɛkɔn one dutạk uwunɔ kɔsɛŋ uwɛ dɛyɔgɔ abuni.<verse eid="MAT 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 27:16" />Krawe yɛ iriyạŋ one dutạk ane ariyed ɔyam ukoni Jizɔz Barabaz.<verse eid="MAT 27:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 27:17" />Kubisɛ dɛyɔgɔ asumɔ nɛ, pailɛd ɔbou bɛŋ , &lt;&lt;mạn utạk ebuni nɛ ruŋ nsɛŋ ɔya nye baruŋ? anebɛ abɔnɔ, Jizɔz Barabaz ɔka uwɛ ure ayebara Jizɔz uchegi iyem. &gt;&gt;<verse eid="MAT 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 27:18" />Iyɛd iyɛ ikɔm juish amɛ atohɔnɛ asɛŋ Jizɔz ayɛ mạŋ kɛ jɛneyɛ akɔ.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Pailɛt ɔbiakɛ kɛ ɛtɔ ibanha, wani wɛwɛ utom dɛkana uyɛ mạŋː &lt;&lt; Bom nawunɔ kasɛri nɛ onerum ɛwɛ ɔka nɛ bom iyinɛ usɛri, irɛ ndɔnɔnɛ dɔrau kɛ kiriniyɛ utạmɛnɛ nɛ amɛ. &gt;&gt;<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Arɛtama jiu nɛ atamnɛ da ateŋi dɛyɔhɔyɛ sạŋ atɛk pailɛt ɔsɛŋ Barabaz, usinɛ Jizoz uyɛ rubɛ. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />Pailɛt ɔbɔu dɛyɔhɔyɛ, bạnɛwu kɛ anɛ awumɔ ya ɛbuni ruŋ nsɛŋ ɔramạŋ? &gt;&gt;Barabazǃ&gt;&gt; ayerɛ.<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />&lt;&lt; Pailɛt ɔbɔu bɛŋ obo ɛbuni ruŋ nsaid nɛ Jizɔz uwɛ awɛninɛ mɛzaya? &gt;&gt; abɛ kpai atek sạŋ &lt;&lt;amud mạŋ &gt;&gt; abɛ kpai ayere.<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />Pailɛt ɔbɔu &lt;&lt; mạn bom iyinɛ amɛ isɛri? &lt;&lt;isai abɛ asani kurod kɛ dɛman ikporɔː sạŋ amud mạŋǃ&gt;&gt;<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Kubi ɛyɛ pailɛt irɔnɔnɛ iyɛ iri bari kɔrɛ, nɛ afirɛ uwukan, ɔnɔŋ mạm ɔsahi mạŋ nbɔk kɛrurɛ dɛyɔhɔyɛ, utɛk am kandɛ kɛ dubɛ onɛrumɛyaǃ abon asɛri ruŋɛnɛ<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />Anɛ dɛ yamabɛ atek, sạŋ &lt;&lt; dubɛ yɛyɛ ukpei bara kɛrɛto nɛ bɔŋ boriǃ&gt;&gt;<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Isai pailɛt ɔsɛŋ Barabaz kɛ ɛkpɛn uyɛ bɛŋ; ɔrɔn Jizɔz dayạŋkɛm ɔnani mạŋkɛ, ɔsɛŋ mạŋ uyɛ aka mud mạŋ.<verse eid="MAT 27:26" /></para>
  <para style="s">Bɛ Dekpo Atogɔ Jizɔz Asạdbɛŋ Ekpom</para>
  <para style="r">(<ref loc="MRK 15:16-20">Mk. 15.16-20</ref>; <ref loc="JHN 19:2">Jn. 19.2</ref>,<ref loc="JHN 19:3">3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Isai bɛ dɛkpo pailɛd abɛnɛ jizɔz atogɔ arabɛŋ kɛtɔ ɔbɔd, ane kpai arikunɔ awogɔ mạŋ. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Ayari mạŋ dɔbara yɛyɛ abɔu mạŋ eboŋɔ. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Isai abod dikạnto uyeɛ akạma mạŋ, aŋana mạŋ kese kɛ krumbɔk, akpạk ndu krure yɛyɛ atogi mạŋ asạddri bɛŋ ekpom. ategi &lt;&lt;akinugi uchira uchira ɔbɔd bɛ juǃ &gt;&gt; <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Atubi mạŋ ditaŋ, ana mạŋ kese yɛ ayɛmi mạŋ kreto. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Alaŋanɛ ɛkpomɔ yɛ namɛ kusạd alawɔ mạŋ irạk ɛyɛ aŋani mạŋ kɛ dɔbara yɛyɛ. Isai atohɔ mạŋ ara bɛŋ aka mud mạŋ.<verse eid="MAT 27:31" /></para>
  <para style="s">Amud Jizɔz Kɛ Kese</para>
  <para style="r">(<ref loc="MRK 15:21-32">Mk. 15.21-32</ref>; <ref loc="LUK 23:26-43">Lk. 23.26-43</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Da aragi bɛŋɛnɛ, aka kama one rumɛwɛ ukoni saimɔn, uwɛ uwuŋi kɛ sirin, bɛ rɛkpo ayama mạŋ kikam ɔbɛnɛ kɛsɛ rubɛ jizɔz. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Awukan kɛ kpokpɛ ukoni Golgota, uwɛ urɛ kpomɔ rɛto kpɛn kpɛni. &gt;&gt; <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Ka kpokpɛ ayɛ jizɔz ituwɔ uwɛ aŋana bɔm icheri kɛ kɔn; asi ukomɔ nɛ kɛ ɛma, ɔwɔ. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />Amud mạŋ, achiemɛ nku yɛyɛ ayɛ ɛkpa bɛbɛ acari kɔbaha da uwɛ one nɛ one uwɛ ɔnɔŋ. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Isai abiaha ɛ akoi mạŋ. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Asɛk ku sɛyɛ alenɛ ɔkpɛrɛ rɛto yɛyɛ uwɛ anɛnɛ mạŋ chɛmː Uwa urɛnɛ Jizɔz, ɔbɔrɔ jiu. &gt;&gt; <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Amud ayiunɛ awumɔ nɛ Jizɔz, uwunɔ kɛ kurum bɔk yɛyɛ uwunɔ kɛ kpabɔk yɛyɛ. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />Ubɛ ari tumi ɛ ayohɔ rɛtɔ ayɛ Jizɔz datama gɛnː <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />Atɛk iyɛ , awu aki chari kpomɔ dilimɛ akpekɛ abɔu mạŋ kɛ kɛdɛwɛ asiriǃ lawɔ ɛkpa yɔyɔ kambɔk yɔri kạn arɛ wɔŋ ubasɛǃ bạnɛ kɛsɛ rubɛ yɛ awu kanǃ &gt;&gt; <verse eid="MAT 27:40" /><verse number="41" style="v" sid="MAT 27:41" />Nyoi dirik arɛtam bɛbɛ nɛ anɛ bɛ achɛhi ntotobɔnɛ atam nɛ bɛbɛ ayạŋɛ atohi jizɔz asɛri bɛŋ ɛkpomː <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />Esɛhɛ anɛ alawɔ kɛ nbɔk ayinɛ, asi ɛkpa yɛyɛ ɔkɛmɛ ku sɛhɛ ɔlawɔǃ mạŋ urɛ utɛhɛ iyɛ amɛ urɛ ɔbɔd bɛ izuel? urɛ bobɛ uwɛ ɔkɛmɛ ubạnɛ kɛ kɛsɛ rubɛ yɛ isai dɛki nɛŋɛ kamɛǃ <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Unɛŋɛ nɛ kɛ ubasɛ iyɛ amɛ urɛ wɔŋ ubasɛ. nyɔi, isai sạŋ dɔrɔn kạn ubasɛ iki sɛhɛ mạŋ ɔlawɔǃ&gt;&gt; <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />urɛmɛ uyiunɛ wɛ amurinɛ nɛ amɛ uyɛ mạŋ datama gɛn dirik.<verse eid="MAT 27:44" /></para>
  <para style="s">Dube Jizɔz</para>
  <para style="r">(<ref loc="MRK 15:33-41">Mk. 15.33-41</ref>; <ref loc="LUK 23:44-49">Lk. 23.44-49</ref>; <ref loc="JHN 19:28-30">Jn. 19.28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Nɛnɔu kirimi iririɛ kɛ don dɛbara kpai uwɛ iri chirɛ utumi kubi asiri. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Kɛbi asiri Jizɔz uto kɛ dɛman oro rorɔ, ɛlai, ɛlai, lɛma sabachtani?&gt;&gt; uwɛ ɔnani, ubasɛ yam, ubasɛ yam, obo awu ɛrɔŋɔ nɛ? &gt;&gt; <verse eid="MAT 27:46" /><verse number="47" style="v" sid="MAT 27:47" />Anɛ bɛ ari baya ɛnɛ akomɔ mạŋ, atɛk uwɛninɛ ɛlaijaǃ&gt;&gt; <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Onɛ uwunɔ bɛbɛ umɛd mạŋ ɔkɔ bɛnɛ ɛkusa, ɔnɔwɔ kɛ ituwɔ, ukpo mạŋ kɛ kɛsɛ rɛto, uno uwɛ usạd mạŋ ɔwɔ. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Bɛm atɛk, kom, sạŋ dɔrɔn kạn ɛlaija iki wukan iri sɛhɛ mạŋ ɔlawɔǃ&gt;&gt; <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />Jizɔz ukpe kɛ utokɛ kɛrɛman ikporɔ ɔsɛŋ kikpɛ kɛwaŋa. <verse eid="MAT 27:50" /><verse number="51" style="v" sid="MAT 27:51" />Kikpegi yɛ ɔkpaha nɛ kpomɔ dilimɛ ɔkpawɔ awumɔ sani kerɔchɛ utumi kɛrɛwɛ. Dɔchɛ uyik, kɔtan ɔkpawɔ awumɔ, <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Kibɛri ɔkpawɔ uwiŋɛ, bɔŋ ubasɛ dɛyama ubɛ aribɛ akahi bɛŋ kpai awukan kɛ ɛkpɛn. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Aroŋɔ kibɛri ɛyɛ, Jizɔz ɔkahi mạŋ ɛnɛ kɛ rubɛ, ara bɛŋ kɛ kpom inimɛ, uwɛ ane dɛyama arɔn bɛŋ. <verse eid="MAT 27:53" /><verse number="54" style="v" sid="MAT 27:54" />Kubi ɛyɛ arɛtama bɛ rɛkpo, nɛ bɛ rɛkpo bɛ akoi nɛ Jizɔz arɔnɔnɛ dɔchɛ kuyik nɛ okpo bɛ utạbi, ɛkpa ubɛ bɛŋ atɛk kɛ dihɛnhɛnɛ iri rɛnɛ wɔŋ Ubasɛǃ &gt;&gt; <verse eid="MAT 27:54" /><verse number="55" style="v" sid="MAT 27:55" />Anɛ bani dɛyama ari yạŋ iyɛm iwerɛ ubɛ achɛŋ nɛ Jizɔz kɛ Galili asɛi mạŋ. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Arɛnɛ mɛri Magdalin, Mɛri ɔka jɛms nɛ Josɛf, nɛ wani zɛbɛdi.<verse eid="MAT 27:56" /></para>
  <para style="s">Dube Jizɔz</para>
  <para style="r">(<ref loc="MRK 15:42-47">Mk. 15.42-47</ref>; <ref loc="LUK 23:50-56">Lk. 23.50-56</ref>; <ref loc="JHN 19:38-42">Jn. 19.38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Ukạmɛ kiriɛ, one rum ɛbara uwɛ uwu kɛ Arimatia ukoni Jɔsɛf uwukan, amɛ iri rɛnɛ wɔŋ ɛtɔ Jizɔz dirạk. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Ora mạŋ uru pailɛt ɔkɔ bɔu ɛkpa Jizɔz. Pailɛt uyɛ ikɔm iyɛ ayɛ Jɔsɛf ɛkpa Jizɔz. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Isai Jɔsɛf ɔnɔŋ ɔbɔŋɔ kɛ dɔbara ivurɔ, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />Onenɛ kɛ kpom kibɛri uwɛ amɛ itɔhi uchirɛ kɛ kɔtan ikporɔ. Isai usinɛ kɔtan ɛbara usɛhɛ kpokpɛ nɛ ikạm achɛŋi arimi ɔkai mạŋ ɔya. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Mery Magdalin nɛ Mery uwaran ari biainɛ ɛ akoni kpomɔ kibɛri ɛyɛ.<verse eid="MAT 27:61" /></para>
  <para style="s">Bɛ Dekpo Bɛ Akoyɔ Kiberi</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Krewe yana, uwɛ urɛ dewe kɛ waŋ kɔhɔgɔ bɛ ju, abɔd abara Ubasɛ nɛ bɛ Farasi ara bɛŋ uru pailɛd <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />Atɛk, ata, dɛrama bara kɛ ɛyɛ onɛ nfuɔwɛ iyạŋɛnɛ kɛ ɛkpɛn utɛk nki kahinɛkɛ nwukan kɛ ɛkpɛn kɛ dɛwɛ asiri. <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Yɛ ikɔm kɛ kpomɔ kiberi yɛyɛ kukoi unim tata kɛ dɛwɛ asiri ɛyɛ, hɛmɛ anɛ iyɛ iri kai mạŋ kɛ rubɛ. nfuɔya iki nyaŋi uruhɔ kɔsani yɛyɛ. &gt;&gt; <verse eid="MAT 27:64" /><verse number="65" style="v" sid="MAT 27:65" />&lt;&lt;Pailɛt utɛk bɛŋ yạŋɛ ruŋ kɛku koi; dɔŋ aka sạd duŋ kibɛri ɛyɛ uyạŋɛ kɛ kukoi da ɛkɛmɛ ruŋ. &gt;&gt; <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Akai bɛŋ ara bɛŋ aka kpạni datan ayiɛmɛ awohɔ kpomɔ kibɛri ɛyɛ sạŋ uyạŋɛ kɛ kukoi, ayaŋ bɛ rɛkpo akoi.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">Kɔkagi Krube Jizɔz</para>
  <para style="r">(<ref loc="MRK 16:1-10">Mk. 16.1-10</ref>; <ref loc="LUK 24:1-12">Lk. 24.1-12</ref>; <ref loc="JHN 20:1-10">Jn. 20.1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Dewe kɛwaŋ kɔhɔgɔ bɛ ju utạma nɛ, kichi dewe ɛrɛriɛ uwɛ kichi ɔla, Meri Madalin nɛ meri uwaran ara bɛŋ uwɛ aka run kpomɔ kibɛri ɛyɛ.<verse eid="MAT 28:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2" />ikɔmɔ dɔchɛ kiyik; bɛ rotomɔ ubasɛ abạnɛ awukan kɛ rɛwɛ, akpari kɔtanɛyɛ alawɔ, abiaha kamɛ.<verse eid="MAT 28:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 28:3" />Kɔnani yɛyɛ uyạŋɛnɛ dakuyama, nku yɛyɛ uvud da kichek. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Kɛwɔd ɔyama bɛ kpom uko koi ɛbɛ abạŋɛ bɛŋ ayạŋɛ da anerumɔ bɛ abɛ ubɛ.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />Bɛ rotomɔ ubɛsɛ ɔyɔm nɛ anɛ bani ɛbɛ. kɛwɔd kani ruŋ, &gt;&gt; utɛk. Diyɛd nnɛ abuni ruŋɛnɛ Jizɔz, uwɛ ari mud rinɛ ɛ.<verse eid="MAT 28:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 28:6" />Akurɛ; iri kahi mạŋ kɛ rubɛ , da iri tehɛ. Oke ari rɔn duŋ kpokpe iri nɛ. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Dɔŋ duŋ ɔwai isai, aka hɛmɛ ruŋ bɔŋ ɛtɔ yɛyɛ, &lt; iri kahi mạŋ kɛ rubɛ, isai ɔrahi mạŋɛnɛ kɛ Galili kɛdurɛ yoyo. &gt;&gt; <verse eid="MAT 28:7" /><verse number="8" style="v" sid="MAT 28:8" />Aweni bɛŋ aroŋɔ kpokpɛ nɛ kɛ wɔd, asi nɛ ɛkɔn dɔmɔ, amɛd bɛŋ uwɛ aka hɛmɛ bɔŋ ɛtɔ yɛyɛ. <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />Jizɔz usɛi bɛŋ utɛk, &lt;&lt; kɔkpama uyạŋɛ nɛ abon. Awukan kɛ amɛ, ayama mạŋ ka nwun, ajinɛ rɛto ayɛ mạŋ. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />&lt;&lt; Jizɔz utek bɛŋ kɛwɔd kani ruŋ, &gt;&gt;&lt;&lt;Dɔŋ aka hɛmɛ ruŋ bɔŋ akam ara bɛŋ kɛ Galili, aki rɔn nɛ. &gt;&gt;<verse eid="MAT 28:10" /></para>
  <para style="s">Bobɛ Anebɛ Akoyɔ kpom Ahema</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Uwɛ ane bani bɛ aragi bɛŋɛnɛ, bɛ dekpo bɛ arạgarạg ubɛ akoyɔ nɛ kpomɔ ki bɛri ɛyɛ akpɛ ndam kɛ dɔndɛbara aka hɛmɛ orɛtama kpomɔ dilimɛ okpo bɛ utạbɛ kpai.<verse eid="MAT 28:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 28:12" />Orɛtama kpomɔ dilimɛ nɛ atamnɛ juish asumɔ akɔmɔ dirami bɛbɛ; ayɛ bɛ rɛkpo bɛ akpuhɔ dɛbad<verse eid="MAT 28:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 28:13" />Atɛk, aki tɛk duŋ iyɛ bɔŋ ɛtɔ yɛyɛ awunɛ nkirini uwɛ abod dɛ rami ari yiu ɛkpa yɛyɛ.<verse eid="MAT 28:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 28:14" />Urɛ bobɛ orɛtama kɛbiaha ikomɔ deki hɛmɛ mạŋ iyɛ kɔbɔk yoyo inim, bom na wunɔ kasɛŋɛ uyɛwɛ afirɛ. &gt;&gt;<verse eid="MAT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15" />Bɛ kpom ukokoi ɛbɛ anɔŋ akpohɔ ɛyɛ asạd da atehɛ bɛŋ. Kɛ da uhɛmɛyɛ iyaŋa kpai nɛ bɛ jiu utumi kɛ dɛwɛya.<verse eid="MAT 28:15" /></para>
  <para style="s">Jizɔz Ukrɛ Bɔŋɛtɔ Yɛyɛ Krure</para>
  <para style="r">(<ref loc="MRK 16:14-18">Mk. 16.14-18</ref>; <ref loc="LUK 24:36-49">Lk. 24.36-49</ref>; <ref loc="JHN 20:19-23">Jn. 20.19-23</ref>; <ref loc="ACT 1:6-8">Ak. 1.6-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Bɔŋ ɛtɔ atenan ara bɛŋ kɛ ikonɔ Galili ikạmɛsi Jizɔz itegɛ bɛŋ ara bɛŋ.<verse eid="MAT 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 28:17" />Arɔn mạŋɛnɛ ajinɛ rɛto ayɛ mạŋ, nɛ ubɛ ari kanɛ one unɛŋɛ.<verse eid="MAT 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 28:18" />Jizɔz uwukan ɔkperɛ bɛŋ, utɛk ayạŋ nɛ ikɔm kpai kɛrɛwɛ nɛ kɔrɔchɛ.<verse eid="MAT 28:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 28:19" />Dɔŋ duŋ, kɛ ane kpai nɛ kpom kpai sạd bɛŋ arɛmɛ bɔŋ ɛtɔ nbamː bɛhɛ bɛŋ duŋ mạm kɛ dokom ɔsɛ, nɛ wɔŋ, nɛ kɛwaŋ inimɛ,<verse eid="MAT 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 28:20" />Chegi bɛŋ da uwɛ akomɔ okpo bɛ kpai nhemi baruŋ. Am nki yạŋɛ nɛ abon kɛ kubi kpai, tata utumi kɛ kikpe. &gt;&gt;<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>