<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PSA" style="id">- Sa</book>
  <para style="h">Bô Êr</para>
  <para style="toc1">Bô Êr</para>
  <para style="toc2">Bô Êr</para>
  <para style="toc3">BÔ</para>
  <para style="mt1">Bô Êr</para>
  <chapter number="1" style="c" sid="PSA 1" />
  <para style="s">Bô 1</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 1:1" />Tôôan aê i m'banê antôn an taasala dutôn dal na êr ane nar sekan taaknoknon.</para>
  <para style="q2" vid="PSA 1:1">Aê i taaknon re sal na antôn êr na ôr.</para>
  <para style="q3" vid="PSA 1:1">Aê i taahlôô ran adodo na antôn êr an manman giigirnê <char style="nd">Warsangul</char>.<verse eid="PSA 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2" />Ape re ane i m'po sek bonê usuran na <char style="nd">Warsangul</char>,</para>
  <para style="q2" vid="PSA 1:2">lolon mwakool re nan usuran</para>
  <para style="q3" vid="PSA 1:2">aê i m'dodot dutôn ngaran nga aê lopwas.<verse eid="PSA 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3" />Aê i m'papanê bôtôa su an mwarui bonê sê wa,</para>
  <para style="q2" vid="PSA 1:3">an bwa re wamran natê aê ratê taamsas,</para>
  <para style="q3" vid="PSA 1:3">aê soksok êr ngadkes ane i m'seknê aê i m'po betôô ngatê.<verse eid="PSA 1:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4" />Ape i taet'papanê êr ane nar sekan taaknoknon.</para>
  <para style="q2" vid="PSA 1:4">Êr an papanê raa êr an mwagrô ne lang mwawi sêktênê êr.<verse eid="PSA 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5" />Papanre aê êr ane nar sekan taaknoknon aê êr taangrê ngan teba knon bênê pepean an metamanê êr,</para>
  <para style="q2" vid="PSA 1:5">aê antôn êr ane nar ôr du aê êr taangrê ne billon kuukuran na êr ane nar sekan mwaknoknon.<verse eid="PSA 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6" />Olin ane <char style="nd">Warsangul</char> lepon sal na êr ane nar sekan mwaknoknon,</para>
  <para style="q2" vid="PSA 1:6">ape êr ane nar sekan taaknoknon aê nar sal metahlal.<verse eid="PSA 1:6" /></para>
  <chapter eid="PSA 1" />
  <chapter number="2" style="c" sid="PSA 2" />
  <para style="s">Bô 2</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 2:1" />Dodotan an sanga na or na antôn êr</para>
  <para style="q2" vid="PSA 2:1">ane êr katnê ne ling sênê aê i m'ba mlemlenga.<verse eid="PSA 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2" />Warsangul lêp êr aê dumôan êr na ratan mwaknon bil</para>
  <para style="q2" vid="PSA 2:2">aê eju bôtôr bênê <char style="nd">Warsangul</char> aê bênê nan antôn ane i mwalngi nan konan.<verse eid="PSA 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3" />Aê epea, “Kêt temra gmogmo nar aôlê at êr</para>
  <para style="q2" vid="PSA 2:3">aê esabrênê nar aôlê êr jingi kêt.”<verse eid="PSA 2:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4" />Warsangul mwahlôô lon tôngtông</para>
  <para style="q2" vid="PSA 2:4">aê emanmansi êr.<verse eid="PSA 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5" />Pon anre aê i m'war pwiris lon lolpirian banê êr</para>
  <para style="q2" vid="PSA 2:5">aê emwê ne êr mwamtaglatnê i,</para>
  <para style="q3" vid="PSA 2:5">olin nan nêmaan an sanga ere aê epea,<verse eid="PSA 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 2:6" />“Aê nê m'patkui nak warsangul lêp ran wau an Saeon,</para>
  <para style="q2" vid="PSA 2:6">nak wau kon.”<verse eid="PSA 2:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 2:7" />Warsangul lêp pea, “Nê met'paetnê dal na <char style="nd">Warsangul</char> an sonê duan.</para>
  <para style="q2" vid="PSA 2:7">I m'pe banê nê epea, ‘Êk aê o m'be wanjuk admwan</para>
  <para style="q3" vid="PSA 2:7">aê nagmware anlo aê nê mamabe temam.<verse eid="PSA 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8" />O t'us jingi nê aê nê met'sunê or na antôn êr an gatgat,</para>
  <para style="q2" vid="PSA 2:8">aê o metelê êr ne êr metebe nam</para>
  <para style="q3" vid="PSA 2:8">aê ratan m'ba ne ba nok bê aê i met'be nam.<verse eid="PSA 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9" />O metepnis gômôgmô êr men lia an môômnê re têêsal.<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">Têêsal aê i m'be aean.</char></note></para>
  <para style="q2" vid="PSA 2:9">O metepnis googosê êr aê êr metemteetee papanê nakur.’”<verse eid="PSA 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10" />Rundelo, warsangul lêp êr, aê gimi dodbwêrêbwrê!</para>
  <para style="q2" vid="PSA 2:10">Gimi telê dodotan re dumôan êr na ratan!<verse eid="PSA 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11" />O t'ôm na <char style="nd">Warsangul</char> lon metaan</para>
  <para style="q2" vid="PSA 2:11">aê emêmênê i men rongo mbetôôan.<verse eid="PSA 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12" />O telngi êk ba pa wanjun,</para>
  <para style="q2" vid="PSA 2:12">tanre tê aê nên met'maa aê o met'mat.</para>
  <para style="q1" vid="PSA 2:12">Olin ngane nan lolpirian en sanga aê kuukus nga</para>
  <para style="q2" vid="PSA 2:12">aê i mwangrê ane i met'longlongmê êk aê o met'mat.</para>
  <para style="b" vid="PSA 2:12" />
  <para style="q1" vid="PSA 2:12">Tôôan aê i meteanê êr bonga an mwapulu pan.<verse eid="PSA 2:12" /></para>
  <chapter eid="PSA 2" />
  <chapter number="6" style="c" sid="PSA 6" />
  <para style="s">Bô 6</para>
  <para style="d">Banê dumôan na sasaan</para>
  <para style="d">Met'sasa men langlang na ta êr an mwagrogro papanê kiitar, bonê sal na googoran su ane m'kanê epe Seminit.<note caller="+" style="f"><char style="fr" closed="false">6:0 </char><char style="ft" closed="false">Tagasê i m'be langlang na kiitar su ane aôlê natê m'belêêtêl. </char></note></para>
  <para style="d">Bô na Deebêt</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 6:1" />
    <char style="nd">Warsangul</char>, o ngalowar pwiris manê nê lon nam lolpirian</para>
  <para style="q2" vid="PSA 6:1">aê o ngalosunê lumluman banê nê lon nam lolpirian an mwapwiris.<verse eid="PSA 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2" />O tebsênê nam lolbeeberan manê nê <char style="nd">Warsangul</char>, olin ngane nê m'pwakon.</para>
  <para style="q2" vid="PSA 6:2">O temwê ne nê temir, olin ngane lon bwarsuk mwahlee.<verse eid="PSA 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3" />Nê mwagna liap sênê metaan.</para>
  <para style="q2" vid="PSA 6:3">?Aê i metasotê wamran sa, <char style="nd">Warsangul</char>?<verse eid="PSA 6:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4" />O tamôl ma <char style="nd">Warsangul</char> aê edbo nê,</para>
  <para style="q2" vid="PSA 6:4">o tedbo nê olin ngane nam lol an mwagmwi antôn aê i taanoknok môn.<verse eid="PSA 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5" />Olin ngane tesu taangrê ne i tedmê êk re wamran ane i mat.</para>
  <para style="q2" vid="PSA 6:5">Tesu taangrê ane i teba tangtang pan sêm lonliwe.<verse eid="PSA 6:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6" />Lopwas bonga aê nê m'not pan nak keratan</para>
  <para style="q2" vid="PSA 6:6">aê epwakon balêp nga sênê,</para>
  <para style="q3" vid="PSA 6:6">aê i mwamwê ne gesek aê nak aôlêlêêl mes nê suntak.<verse eid="PSA 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7" />Mtak mamlêk sênê ngaran.</para>
  <para style="q2" vid="PSA 6:7">Nak wêlêr êr mwamwê ne nê m'ngar ba aê nê taangrê ne nê t'le sênê.<verse eid="PSA 6:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8" />Gimi bonga ane nagmi sekan taaknoknon aê gimi t'pii jingi nê,</para>
  <para style="q2" vid="PSA 6:8">olin ngane <char style="nd">Warsangul</char> mwarngo nak ngaran.<verse eid="PSA 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9" />
    <char style="nd">Warsangul</char> mwarngo nak ngaran,</para>
  <para style="q2" vid="PSA 6:9">aê elê nak tangroan.<verse eid="PSA 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10" />Bêr me'tkan aê êr metemta balêp, aê nga re wamran anre</para>
  <para style="q2" vid="PSA 6:10">aê nak wêlêr êr bonga ne bêr me'tkan aê êr met'pii.<verse eid="PSA 6:10" /></para>
  <chapter eid="PSA 6" />
  <chapter number="23" style="c" sid="PSA 23" />
  <para style="s">Bô 23</para>
  <para style="d">Bô su na Deebêt</para>
  <para style="b" />
  <para style="q1">
    <verse number="1" style="v" sid="PSA 23:1" />
    <char style="nd">Warsangul</char> be nak antôn en lelepok papanê sipsip</para>
  <para style="q2" vid="PSA 23:1">aê nê taangrê ne nê t'mo bwis laklak olin tatesu.<verse eid="PSA 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 23:2" />I mwamwê ne nê m'pwat lon raajulus an mwagsan</para>
  <para style="q2" vid="PSA 23:2">aê i m'dumônê nê banê wa an taasal roro.<verse eid="PSA 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 23:3" />I m'sunê miran teêê ma lon lolok,</para>
  <para style="q2" vid="PSA 23:3">aê elepok bonê mta sal êr na sekan an mwaknoknon, olin sên antôô.<verse eid="PSA 23:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4" />Taabe tatesu ne nê met'sala lon ôhrôbul na manua na matan</para>
  <para style="q2" vid="PSA 23:4">ape nê taetemtatnê tatesu an sanga.</para>
  <para style="q1" vid="PSA 23:4">Olin ngane o m'sek mek</para>
  <para style="q2" vid="PSA 23:4">aê ekamnomno nê, nê nam lia aê adngêl.<verse eid="PSA 23:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5" />O m'sek gogonê bweladbê bwêlêk, nga goro mta nak wêlêr êr</para>
  <para style="q2" vid="PSA 23:5">aê ekadbodbo nê ma lon nam bangbangan na ganan,</para>
  <para style="q3" vid="PSA 23:5">aê nak minmin pwer aê elulu.<verse eid="PSA 23:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6" />Koknga! Nam tôôan aê lolom an mwagmwi antôn ne i taanoknok môn,</para>
  <para style="q2" vid="PSA 23:6">aê êr met'pwat mek lon bông êr bonga lon nak miran</para>
  <para style="q3" vid="PSA 23:6">aê nê met'sek basô lon im na <char style="nd">Warsangul</char>.<verse eid="PSA 23:6" /></para>
  <chapter eid="PSA 23" />
  <chapter number="30" style="c" sid="PSA 30" />
  <para style="s">Bô 30</para>
  <para style="d">Bô su na Deebêt</para>
  <para style="d">Bô na konan na Im na Bwatkôlkôl</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 30:1" />Nê me'tangtang pan sêm ba ngamre <char style="nd">Warsangul</char>,</para>
  <para style="q2" vid="PSA 30:1">olin ngane o m'gel kui nê jingin bul,</para>
  <para style="q3" vid="PSA 30:1">aê o taamwê ne nak wêlêr êr terngo m'betôô olik.<verse eid="PSA 30:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2" />Nê m'ka olin tobodboan banê êk <char style="nd">Warsangul</char> anbe nak Bwatkôlkôl</para>
  <para style="q2" vid="PSA 30:2">aê o mwamwê ne nê mamir.<verse eid="PSA 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3" />
    <char style="nd">Warsangul,</char> o m'pilkui nê jingin ôt lonliwe.</para>
  <para style="q2" vid="PSA 30:3">O m'lepon nak miran aê emwê ne nê taamôt balon bul.<verse eid="PSA 30:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4" />Tetangtang pa <char style="nd">Warsangul</char> lon sasaan, gimi anbe nan antôn êr an dodpwiris ran,</para>
  <para style="q2" vid="PSA 30:4">aê ekakasoonê i olin ngane sên aê i m'kon.<verse eid="PSA 30:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5" />Nan nêmaan aê i m'po pwat nê wamran su t'kakan nga</para>
  <para style="q2" vid="PSA 30:5">ape lolon antôô an pwat me gimi aê i m'pwat basô.</para>
  <para style="q1" vid="PSA 30:5">Ngaran met'po pwat nê ran lopwas bonga</para>
  <para style="q2" vid="PSA 30:5">ape pangrankonkon aê gimi meterngo m'betôô.<verse eid="PSA 30:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6" />Lon wamran antôô aê nê m'pea,</para>
  <para style="q2" vid="PSA 30:6">“Nê taangrê ane nê t'mo gna ronga.”<verse eid="PSA 30:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7" />
    <char style="nd">Warsangul</char>! Wamran ane lolom pwat mek,</para>
  <para style="q2" vid="PSA 30:7">aê o mwamwê ne nak wau mwapwiris.</para>
  <para style="q1" vid="PSA 30:7">Ape wamran ane o m'ling sênê lontam jingi nê</para>
  <para style="q2" vid="PSA 30:7">aê nê mwarngo m'sanga.<verse eid="PSA 30:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8" />Nê m'ka banêk <char style="nd">Warsangul</char>,</para>
  <para style="q2" vid="PSA 30:8">aê nê mwausiusi êk olin nam lolbeeberan.<verse eid="PSA 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9" />?O metelê sa re nak matan?</para>
  <para style="q2" vid="PSA 30:9">I taangrê!</para>
  <para style="q1" vid="PSA 30:9">?Aê i mwangrê ane lo bêng met'kakasoonê êk bwa ê?</para>
  <para style="q2" vid="PSA 30:9">I taangrê!</para>
  <para style="q1" vid="PSA 30:9">?Aê i mwangrê ane i met'paetnê nam dodpwirisan baôt bwa ê?</para>
  <para style="q2" vid="PSA 30:9">I taangrê nga pôntê!<verse eid="PSA 30:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10" />
    <char style="nd">Warsangul</char> o tong banê nê aê lom tebeeber pok.</para>
  <para style="q2" vid="PSA 30:10">
    <char style="nd">Warsangul</char> o tebe tobodboan banê nê.<verse eid="PSA 30:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11" />O mwatleenê nak ngaran aê i mamabe wêlan,</para>
  <para style="q2" vid="PSA 30:11">o m'korkui nak mju bwelaul na rongo sangaan aê ekor lasi, nê lol an mwakool.<verse eid="PSA 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12" />Papanre aê nê met'sa aê etangtang pan sêm aê nê taet'sek bôôbôr.</para>
  <para style="q2" vid="PSA 30:12">
    <char style="nd">Warsangul</char> anbe nak Bwatkôlkôl, nê met'kakasoonê êk basô.<verse eid="PSA 30:12" /></para>
  <chapter eid="PSA 30" />
  <chapter number="36" style="c" sid="PSA 36" />
  <para style="s">Bô su Na Deebêt, Antôn na ômwan na God. I m'juusi olin Dumôan na Sasaan</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 36:1" />Dal olin ôr êr na antôn êr ane nar sekan taaknoknon aê êr (du/pwat) lon lolok.</para>
  <para style="q2" vid="PSA 36:1">Lon nar lelean aê êr taamtatnê God (nga pôntê).<verse eid="PSA 36:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 36:2" />Êr mwalngilngi êr keket balêp nga.</para>
  <para style="q2" vid="PSA 36:2">Ngatê aê lon nar dodotan aê êr taadodbwêrê nar ôr êr, aê ebwal bênê.<verse eid="PSA 36:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3" />Dal êr an soosoôô re bongor aê êr taaknoknon nga pôntê, aê êr mwasaasarsusu (antôn nga).</para>
  <para style="q2" vid="PSA 36:3">Êr taangrêngrê ane êr te dunê sekan êr an mwaknoknon aê eômnê ta êr antôôtôô.<verse eid="PSA 36:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4" />Aê re wamran ane êr pwat ran geser nga ronga, ape êr po dotkurukru sekan êr an sangsanga ane êr met'po ômnê têêre.</para>
  <para style="q2" vid="PSA 36:4">Êr mwa ngli êr balon sal êr an sangsanga,</para>
  <para style="q2" vid="PSA 36:4">aê êr taa tleetôsênê sekan êr an taaknoknon.<verse eid="PSA 36:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5" />WARSANGUL, nam lolantôô an mwagmwi antôn aê i (mwabra) aê eba sotê lo tôngtông,</para>
  <para style="q2" vid="PSA 36:5">aê nam dodpwirisan aê i m'ba sotê lo mtaran. <verse eid="PSA 36:5" /><verse number="6" style="v" sid="PSA 36:6" />Nam sêkan êr an mwaknoknon aê i m'papanê wau an mwabra sai wau êr bonga, aê nam duan an mwaknoknon aê i m'papanê lo tas an mwablô balêp<verse eid="PSA 36:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 36:7" />O God, nam lolantôô an mwagmwi antôn aê i (m'betlap/mwapwiris) balêp.</para>
  <para style="q2" vid="PSA 36:7">Antôn êr ba plu pam papanê wanju tomu êr an ba plu pa albê dasêr.<verse eid="PSA 36:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8" />Êr gan re anin êr antôôtôô an pwer lon nam im,</para>
  <para style="q2" vid="PSA 36:8">aê o m'sunê wa ane êr minê re nam wa na rongo mbetôôan.<verse eid="PSA 36:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9" />Olin ane miran bonga aê i mamra (nga) re êk,</para>
  <para style="q2" vid="PSA 36:9">aê re marem an pang ne gema mwalsê mareran.<verse eid="PSA 36:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10" />Nam lolantôô banê êr an mwaklê êk aê i ngalo nok re wamran tesu.</para>
  <para style="q2" vid="PSA 36:10">Aê nam ôt an mwaknoknon aê i teanê êr ane lolor pwat konon.<verse eid="PSA 36:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11" />O ngalomwê ne antôn an sêêsêrnê i ta manê ane i t'mi ôsê nê,</para>
  <para style="q2" vid="PSA 36:11">aê êr ane nar sekan taaknoknon temi korbênê nê jingi êk.<verse eid="PSA 36:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12" />Gimi telsê! Êr an sekseknê sekan êr an taaknoknon ne êr tên môt ne ba pwat.</para>
  <para style="q2" vid="PSA 36:12">M'pasnê êr baran tan aê i taangrê ne êr temo mra.<verse eid="PSA 36:12" /></para>
  <chapter eid="PSA 36" />
  <chapter number="37" style="c" sid="PSA 37" />
  <para style="d">Bô (Na Deebêt/ane Deebêt mwa Hru.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 37:1" />Êr ane nar sekan taaknoknon ngalomwê ne o terngo m'sanga,</para>
  <para style="q2" vid="PSA 37:1">aê o ngalo lekor olin soksok êr na êr ane nar sekan taaknoknon,<verse eid="PSA 37:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2" />olin ane êr papanê raajulus ane taete wabumran aê êr metegrô.</para>
  <para style="q2" vid="PSA 37:2">Aê epapanê têê btôa êr an mwagsan ne taete wabumran aê êr met'mat.<verse eid="PSA 37:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3" />O met'kakoknga ra <char style="nd">WARSANGUL</char> aê esekanê duan antôô,</para>
  <para style="q2" vid="PSA 37:3">aê papanre aê o mwangrê ne sek ran tan aê erngo m'betôô ran aê (esek lon temwat/o taangrê ne mtatnê tatesu).<verse eid="PSA 37:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4" />O t'le banê <char style="nd">WARSANGUL</char> aê ejikrênê rongo m'betôô re i,</para>
  <para style="q2" vid="PSA 37:4">aê papanre aê i met'sunê tane o m'dorngi.<verse eid="PSA 37:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5" />O (t'sunê/telngi) nam sal bonga banê <char style="nd">warsangul,</char></para>
  <para style="q2" vid="PSA 37:5">aê edorsê nga re i,</para>
  <para style="q3" vid="PSA 37:5">aê papanre aê i met'ômnê ta êr anlo banê êk.<verse eid="PSA 37:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6" />I metemwê ne nam sekan an mwaknoknon aê i metedrê papanê ran pangrankon,</para>
  <para style="q2" vid="PSA 37:6">aê emwê ne nam sal ane o metalelenê soksok bonê aê i metedrê papanê iêl na ran rudbwêl.<verse eid="PSA 37:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7" />O t'sek milumlum goro mta <char style="nd">warsangul</char></para>
  <para style="q2" vid="PSA 37:7">aê etang gêtê nam dodotan aê esek bagra i.</para>
  <para style="q1" vid="PSA 37:7">O ngalorngo m'sanga re wamran ane antôn êr mwa pngipngi lon nar sal êr,</para>
  <para style="q2" vid="PSA 37:7">aê re wamran êr ane êr môômnê soksok êr an taaknoknon ane êr katkatnê.<verse eid="PSA 37:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8" />(O ngaloba hdor/Nam dodotan ngalo môt) sênê nam lolpirian aê o telngi lolpirian natê.</para>
  <para style="q2" vid="PSA 37:8">Lom ngalo pripri, olin ane i metelê êk nga bare ôt angan sanga.<verse eid="PSA 37:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9" />Olin ane êr ane nar sekan taaknoknon aê me'tang binibni êr nga,</para>
  <para style="q2" vid="PSA 37:9">ape êr ane nar dorngian ane êr seksek bagra ne êr mwalngi ra <char style="nd">warsangul</char> aê êr metelê tan aê i metebe nar.<verse eid="PSA 37:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10" />Taete wabumran aê êr ane nar sekan taaknoknon metehlal.</para>
  <para style="q2" vid="PSA 37:10">Met'lelenê êr kêlê, ape taet'jikrênê êr re buôt tesu.<verse eid="PSA 37:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11" />Ape êr ane lolor mamlumlum aê êr metelê tan ne i metebe nar,</para>
  <para style="q2" vid="PSA 37:11">aê erngo m'betôônê temwat ane êr sek lon (men nar soksok an du).<verse eid="PSA 37:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12" />Antôn êr ane nar sekan taaknoknon katnê êr ane nar sekan mwaknoknon,</para>
  <para style="q2" vid="PSA 37:12">aê egtêgtê lior banê êr, <verse eid="PSA 37:12" /><verse number="13" style="v" sid="PSA 37:13" />ape Warsangul mansi êr olin ane i mwalsê nar bông aê i m'ba mama.<verse eid="PSA 37:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14" />Êr ane nar sekan taaknoknon raasu nar ai na bwalan baôt</para>
  <para style="q2" vid="PSA 37:14">aê elanglê nar isu mêlêsia</para>
  <para style="q1" vid="PSA 37:14">olin ane êr metelê êr ane nar soksok mwahlal nga me êr anbe beeberan nga baran tan,</para>
  <para style="q2" vid="PSA 37:14">aê epnisbinibni êr an sek ditôn sal an mwaknoknon.<verse eid="PSA 37:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15" />Ape nar ai na bwalan met'mo kan dêrê waesnar nga môn,</para>
  <para style="q2" vid="PSA 37:15">aê nar bôtôô metemtomtop.<verse eid="PSA 37:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16" />Waa watiti soksok nga na antôn ane nan sekan mwaknoknon, aê i m'betôô balêp,</para>
  <para style="q2" vid="PSA 37:16">sai bai soksok atlap na antôn êr ane nar sekan taaknoknon.<verse eid="PSA 37:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 37:17" />Olin ane pwirisan na êr ane nar sekan taaknoknon aê êr metemtomtop,</para>
  <para style="q2" vid="PSA 37:17">ape <char style="nd">warsangul</char> tangpo êr ane nar sekan mwaknoknon.<verse eid="PSA 37:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18" />Antôn êr ane (dal/telel) mwahlal nga bare êr aê <char style="nd">warsangul</char> lepor pan bông êr,</para>
  <para style="q2" vid="PSA 37:18">aê soksok êr ane êr mwalê aê i met'du basô.<verse eid="PSA 37:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19" />Lon wamran êr an sanga aê bêr tae'tkan,</para>
  <para style="q2" vid="PSA 37:19">aê lon bông êr ane mar met'kat aê êr metelsê mas.<verse eid="PSA 37:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20" />Ape antôn êr ane nar sekan taaknoknon aê êr met'matmat.</para>
  <para style="q2" vid="PSA 37:20">Wêlêr êr na <char style="nd">warsangul</char> aê êr papanê soksok êr antôôtôô na lo bubuôt, ane êr me (t'pang) aê eba (nok/hlahlal) lon suap.<verse eid="PSA 37:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21" />Êr ane nar sekan taaknoknon aê êr mwahgo soksok aê êr taasusugle,</para>
  <para style="q2" vid="PSA 37:21">ape êr ane nar sekan mwaknoknon aê lor beeber po antôn aê êr sa banê antôn nê lolantôô.<verse eid="PSA 37:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22" />Êr ane <char style="nd">warsangul</char> konnê êr aê êr metelê tan aê i metebe nar,</para>
  <para style="q2" vid="PSA 37:22">ape êr ane i m'kakanê êr aê êr met'matmat.<verse eid="PSA 37:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23" />
    <char style="nd">Warsangul</char> mwa tlê sal</para>
  <para style="q2" vid="PSA 37:23">na antôn an mwarngo m'betôô re i</para>
  <para style="q1" vid="PSA 37:23">aê i mwapwiris.<verse eid="PSA 37:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 37:24" />Aê taabe tatesu ne i t'nga salsibit, ape i taa ngrên temôt,</para>
  <para style="q2" vid="PSA 37:24">olin ane warsangul tang gêtê i nê eran rakô aê i mwaknon jijinga<verse eid="PSA 37:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 37:25" />Nê m'be mwalgel ma ne mibe tabwas rundelo,</para>
  <para style="q2" vid="PSA 37:25">i nga re aê nê taalsê re wamran tesu bwa ne <char style="nd">warsangul</char> tetlee tôsênê i ane nan sekan mwaknoknon,</para>
  <para style="q2" vid="PSA 37:25">iaa elsê ne wanjun êr te tam anin.<verse eid="PSA 37:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 37:26" />Tamat nga aê lolor (mwa gwmi/betôô banê) antôn aê êr sa banê antôn êr, aê i mi papanê tobodboan, taa gelgel olin.</para>
  <para style="q2" vid="PSA 37:26">Aê wanjur êr aê êr mibe toboboan na <char style="nd">warsangul</char> banê êr.<verse eid="PSA 37:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 37:27" />O tetlee jingin sekan an sanga aê edunê sekan antôô,</para>
  <para style="q2" vid="PSA 37:27">aê papanre aê êk aê wanjum êr aê mabim êr an metadodo ma pom ronga met'sek ran tan basô.<verse eid="PSA 37:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 37:28" />Olin ane <char style="nd">warsangul</char> aê lon be sekan an mwaknoknon,</para>
  <para style="q2" vid="PSA 37:28">aê i taangrê ne i tetlee tôsênê nan antôn êr an dodpwiris ran.</para>
  <para style="q1" vid="PSA 37:28">Êr ane nar sekan taaknoknon aê me'tang binibni êr,</para>
  <para style="q2" vid="PSA 37:28">aê wanjur êr me mabir êr aê êr met'nok tehree.<verse eid="PSA 37:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 37:29" />Êr ane nar sekan mwaknoknon aê êr metelê tan</para>
  <para style="q2" vid="PSA 37:29">aê esek ran basô.<verse eid="PSA 37:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 37:30" />Bongo antôn êr ane nar sekan mwaknoknon aê i m'sahrônê dal na lolraranan,</para>
  <para style="q2" vid="PSA 37:30">aê mêr sahra ta êr an mwaknoknon.<verse eid="PSA 37:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 37:31" />Duan na nar God aê i m'pwat lon lolor,</para>
  <para style="q2" vid="PSA 37:31">aê êr sala aê êr taa sôl re wamran tesu.<verse eid="PSA 37:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 37:32" />Êr ane nar sekan (sanga/taaknoknon aê êr kap aê ele bagra êr ane nar sekan mwaknoknon.</para>
  <para style="q2" vid="PSA 37:32">Êr tang kêlê ane êr metetang bini êr nga,<verse eid="PSA 37:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 37:33" />ape warsangul taetelngi êr balon kêlênra êr ane nar sekan taaknoknon,</para>
  <para style="q2" vid="PSA 37:33">iaa re wamran ane êr metea lon waawaran aê i taangrê ane i telngi êr ne tepepe êr.<verse eid="PSA 37:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 37:34" />O t'seksek bagra <char style="nd">warsangul</char></para>
  <para style="q2" vid="PSA 37:34">aê esodutôn nan sal,</para>
  <para style="q1" vid="PSA 37:34">Aê papanre aê i met'dodmaanê êk re sal ane i metemwê ne o metelê tan aê i metebe nam.</para>
  <para style="q2" vid="PSA 37:34">Aê o metelsê re wamran ane i met'korbênê êr ane nar sekan taaknoknon baôt.<verse eid="PSA 37:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 37:35" />Nê mwalsê nasu ane nan sekan sanga balêp aê i m'tangtang bêrê antôn êr nga,</para>
  <para style="q2" vid="PSA 37:35">ne i m'betlap papanê libak aê esaasai bôtôa êr na lo bubuôt bonga,<verse eid="PSA 37:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 37:36" />ape taabe wabumran aê i mwahlal, taalsê i ronga.</para>
  <para style="q2" vid="PSA 37:36">Nê m'lelenê i pon anre kêlê, aê nê taalsê i re buôt tesu.<verse eid="PSA 37:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 37:37" />Gimi t'le banê êr ane dal mwahlal nga re êr, aê elsê sekan an mwaknoknon.</para>
  <para style="q2" vid="PSA 37:37">Wamran an metama ronga aê i m'be na antôn êr na temwat.<verse eid="PSA 37:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 37:38" />Ape antôn êr an môômnê ôr aê me'tang binibni êr,</para>
  <para style="q2" vid="PSA 37:38">aê mabir êr an metadodo ma por ronga aê êr meta nok.<verse eid="PSA 37:38" /></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 37:39" />Tobodboan na êr ane nar sekan mwaknoknon aê i mamra jingi <char style="nd">warsangul</char>.</para>
  <para style="q2" vid="PSA 37:39">I m'be nar ôt na pluan lon wamran an sanga.<verse eid="PSA 37:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 37:40" />Warsangul mwadbo êr aê epilkui êr (jingin soksok êr an sangsanga).</para>
  <para style="q2" vid="PSA 37:40">I m'pilkui êr jingi lo kêlênra antôn êr an sanga aê emwê ne êr taa matat.</para>
  <para style="q2" vid="PSA 37:40">Olin ane êr ba plu pa i.<verse eid="PSA 37:40" /></para>
  <chapter eid="PSA 37" />
  <chapter number="38" style="c" sid="PSA 38" />
  <para style="d">Bô su na Deebêt. Ane i mwausiusi epe metedmê</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 38:1" />Warsangul, o ngalo ngrôtnê nê aê epepe nê re wamran ane lom mwapri,</para>
  <para style="q1" vid="PSA 38:1">ee esunê lumluman banê nê re wamran ane lom mwapri balêp nga.<verse eid="PSA 38:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2" />Nam bôtôô (m'kan/mwa plal) re nê,</para>
  <para style="q2" vid="PSA 38:2">aê o m'sunê lumluman aê i môt barak.<verse eid="PSA 38:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3" />Olin ane lom mwaprinê nê ngatê aê lon tôrbek mwa krakrat sênê,</para>
  <para style="q2" vid="PSA 38:3">aê lon bwarsuk mwahlee sênê ôrêk.<verse eid="PSA 38:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4" />Nak baselan aê i mwahgahgaa rak</para>
  <para style="q2" vid="PSA 38:4">papanê solan an maa balêp nga aê nê taangrê solan natê.<verse eid="PSA 38:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5" />Nak meno mbo aê bon pin,</para>
  <para style="q2" vid="PSA 38:5">olin ane lon bôtôk (be butnêtnê/mwaônôn) sênê nak sekan êr an sanga ane nê môômnê.<verse eid="PSA 38:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6" />Aê nê m'ba ran tan aê enga mibe antôn melemlenga ngatê,</para>
  <para style="q2" vid="PSA 38:6">aê bông êr bonga aê nê m'sala laklak aê edangdang.<verse eid="PSA 38:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7" />Maset mwalê nê aê lon tarbek pangpang sênê keratan,</para>
  <para style="q2" vid="PSA 38:7">aê nê m'tabwê balêp.<verse eid="PSA 38:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8" />Lon tarbek mwahlee aê nê taatong balon tarbek ronga,</para>
  <para style="q2" vid="PSA 38:8">aê nê mwarngo m'sanga balêp lon lolok, aê enot pan keratan.<verse eid="PSA 38:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9" />Warsangul, o mwaklê epe lok be ane nê metemir,</para>
  <para style="q2" vid="PSA 38:9">aê o mwarngo nê nga re wamran ane nê m'roo notnot.<verse eid="PSA 38:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10" />Waes nak bitbit kuukus, aê nak (pwirisan/bwarii) bonga aê i mwahlal.</para>
  <para style="q2" vid="PSA 38:10">Aê kêlêntak nga ronga, aê nê taangrê ne nê t'le tehree ran.<verse eid="PSA 38:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11" />Nak bwangbwangan êr me êr ane gema m'seksek bil aê êr taangrê ne êr tema bwêlêk, olin nak meno êr,</para>
  <para style="q2" vid="PSA 38:11">aê berek êr nga ronga aê êr taama bwêlêk nga pôntê.<verse eid="PSA 38:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12" />Êr anpe êr metepnis bini nê nga aê êr langlê nar asasa olik,</para>
  <para style="q2" vid="PSA 38:12">aê êr anpe êr meteôsê nê aê êr sahra sal (na ngan pe/olin anpe) êr meteesar susu nê aê elonglongmê nê nga.</para>
  <para style="q2" vid="PSA 38:12">Êr katnê nê lon bêng êr bonga.<verse eid="PSA 38:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13" />Nê m'papanê boror, an taangrê ne rngo tolo sahrôan,</para>
  <para style="q2" vid="PSA 38:13">aê epapanê bôs, an taangrê ne sahrô.<verse eid="PSA 38:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14" />Nê mi papanê antôn an taangrê ne tong,</para>
  <para style="q2" vid="PSA 38:14">aê ewar bwiji dal.<verse eid="PSA 38:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 38:15" />
    <char style="nd">warsangul</char>, nê m'seksek bagra êk.</para>
  <para style="q2" vid="PSA 38:15">Nê mwaklê epe o meterngo nê, Warsangul nak God.<verse eid="PSA 38:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 38:16" />Nê (m'pe /m'wariinê banê êk) epe, “O ngalomwê ne êr tekool</para>
  <para style="q2" vid="PSA 38:16">aê esêêsêrnê êr re wamran ane nê mwadrôs.”<verse eid="PSA 38:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 38:17" />Olin ane toore ngatê aê nê met'môt/mat,</para>
  <para style="q2" vid="PSA 38:17">aê keratan an du re nê aê i mwamwê nê tamat.<verse eid="PSA 38:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 38:18" />Nê m'paetnê sekan êr an sangsanga ane nê môômnê, aê edot totonê nê sênê (ôrêk/nak ôr).<verse eid="PSA 38:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 38:19" />Nak wêlêr êr aê êr mi gatgat, aê êr taatabwê.</para>
  <para style="q2" vid="PSA 38:19">Aê êr gatgat ane lor taabe nê, ape lor taabe nê melenga, nê taaômnê tatesu an sanga. <verse eid="PSA 38:19" /><verse number="20" style="v" sid="PSA 38:20" />Aê êr orsu an môlnê nak (sekan/ôt) antôô nê sêkan an sanga aê êr sahra nê olin ane nê m'tang kêlê ne seknê sekan an mwaknoknon.<verse eid="PSA 38:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 38:21" />O ngalo (tlee tôsênê nê/dot barak/lngi nê) nak <char style="nd">warsangul</char>!</para>
  <para style="q2" vid="PSA 38:21">Aê o ngalo du na ôt nga jingi nê, nak God.<verse eid="PSA 38:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 38:22" />O t'ma kuukus aê emi dbo nê,</para>
  <para style="q2" vid="PSA 38:22">Warsangul, o m'be nak tobodboan.<verse eid="PSA 38:22" /></para>
  <chapter eid="PSA 38" />
  <chapter number="39" style="c" sid="PSA 39" />
  <para style="d">Bô Su ane Deebêt Juusi, Oli Jedutun, an (be Absêbsê Na/I an Mwa Ususurnê/Dumôan Na) Êr na Sasaan</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 39:1" />Nê m'pe epe, “Nê met'le pangpang po nak sal,</para>
  <para style="q2" vid="PSA 39:1">aê papanre aê nê taet'pe dal tesu ne i tebe ôr,</para>
  <para style="q1" vid="PSA 39:1">aê ekookornê bongok re wamran ane nê met'sek me êr ane nar sekan taaknoknon.<verse eid="PSA 39:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 39:2" />Nê m'sek milumlum tehree nga.</para>
  <para style="q2" vid="PSA 39:2">Taabe tatesu ne dal antôô nga, ape nê taape nga pôntê.</para>
  <para style="q1" vid="PSA 39:2">Ngatê aê nê ngamo rgno m'sanga balêp sênê,<verse eid="PSA 39:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 39:3" />aê lol natê m'pwat rak aê epwiris tehree nga.</para>
  <para style="q1" vid="PSA 39:3">Aê wamran ane nê m'dodot ditôn, aê nê mwarngo m'sanga balêp nga nê.</para>
  <para style="q2" vid="PSA 39:3">Têêretê aê nê m'war, aê epea,<verse eid="PSA 39:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 39:4" />“O tebsênê nak miran manê nê, epe ?nê met'seknê wabumran an papanbe <char style="nd">warsangul</char>?</para>
  <para style="q2" vid="PSA 39:4">Aê ebsênê bông êr ane nê met'seknê.</para>
  <para style="q2" vid="PSA 39:4">O temwê ne nê teklê nak miran epe ?i m'kor kuukus aê pwepwe papanbê?<verse eid="PSA 39:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 39:5" />O mwamwê ne nak bông na miran aê i mi papanê waa (bisiar/bwakoar/kêlêar) nga.</para>
  <para style="q2" vid="PSA 39:5">(Beraan/Betlapan) na ak wasê aê goro mtam aê i taaroo re tatesu nga pôntê.</para>
  <para style="q1" vid="PSA 39:5">Wamran ane nê m'seknê bonga, aê i papanê ane m'po nggos basu nga.</para>
  <para style="q2" vid="PSA 39:5">Êr ane m'le pangpang pon nar miran nga ronga, ape êr mo papanre nga.<verse eid="PSA 39:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 39:6" />Antôn aê i m'papanê manua angan mwatlee bwelak aê eba hlal.</para>
  <para style="q2" vid="PSA 39:6">Êr roo sotê ôt bwelak olin ane êr met'sakguju nar soksok êr,</para>
  <para style="q2" vid="PSA 39:6">ape êr taaklê epe sê en teba lê ne i tabe nan.<verse eid="PSA 39:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7" />“?Ape rundelo, aê Warsangul aê, nê bwis belangtê sa ronga?</para>
  <para style="q2" vid="PSA 39:7">Nê nga dorsê nga re êk tê.<verse eid="PSA 39:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8" />O t'pilkui nê jingin nak sekan êr ane nê m'basel re,</para>
  <para style="q2" vid="PSA 39:8">mwa o ngalomwê ne (butnêtnê êr/êr ane bôtôr mwaônôn) te masi nê.<verse eid="PSA 39:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9" />Nê m'sek minimnin gna, aê nê taawar,</para>
  <para style="q2" vid="PSA 39:9">Olin ane êk ngan mwamwê ne i m'papanla.<verse eid="PSA 39:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10" />Ape o t'pilkui nam apis jingi nê!</para>
  <para style="q2" vid="PSA 39:10">Nê m'pwakonnê rapan na eram.<verse eid="PSA 39:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11" />Wamran ane o mwangrôt nasu ne ktêknonnê i olin nan ôr,</para>
  <para style="q2" vid="PSA 39:11">aê o m'longlongmê na soksok êr papanê ane kakrus mwa ktêktê bwelaul êr.</para>
  <para style="q2" vid="PSA 39:11">Aê koknga ne antôn ngadkes aê nar miran m'papanê wa mai lang ane o m'po bngosnê basu nga.<verse eid="PSA 39:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12" />O terngo nak tangroan <char style="nd">warsangul</char>, aê etong banê nak ngaran olin tobodboan,</para>
  <para style="q2" vid="PSA 39:12">aê edranê dalngim manê nak dangdangan.</para>
  <para style="q1" vid="PSA 39:12">Nê m'sek mem papanê antôn na ere kadkes,</para>
  <para style="q2" vid="PSA 39:12">aê ebe walô papanê nak temtô êr bonga.<verse eid="PSA 39:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13" />O telngi nê, aê nê met'mo ngrê ne rngo m'betôô,</para>
  <para style="q2" vid="PSA 39:13">bwa aê nê t'nga mat.”<verse eid="PSA 39:13" /></para>
  <chapter eid="PSA 39" />
  <chapter number="40" style="c" sid="PSA 40" />
  <para style="d">Bô su na Deebêt. I m'banê i an mwa usuusurnê googoran.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 40:1" />Nê m'tang gêtê nak dodotan aê eseksek bagra <char style="nd">warsangul</char>,</para>
  <para style="q2" vid="PSA 40:1">aê i mwa tnur ma bwêlêk aê erngo nak ngaran olin tobodboan.<verse eid="PSA 40:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2" />I m'tang re nê baôt jingin lobul an sanga balêp;</para>
  <para style="q2" vid="PSA 40:2">baôt jingin leplep an mes aê eleelee ne mamdomdor lon.</para>
  <para style="q1" vid="PSA 40:2">I mwalngi nê baran (eat su atlap/bôtôlul) su</para>
  <para style="q2" vid="PSA 40:2">aê emwê ne nê mwaknon pwiris tehree (nga).<verse eid="PSA 40:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3" />I mwalngi bô teêê balon pwak.</para>
  <para style="q2" vid="PSA 40:3">Bô an me'tangtang pa nakêt God nê.</para>
  <para style="q1" vid="PSA 40:3">Aê antôn êr gatgat metelsê aê emêmê <char style="nd">warsangul</char></para>
  <para style="q2" vid="PSA 40:3">aê edorsê re i.<verse eid="PSA 40:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4" />Tôôan aê i m'banê antôn</para>
  <para style="q2" vid="PSA 40:4">an doodorsê nga ra <char style="nd">warsangul</char>,</para>
  <para style="q1" vid="PSA 40:4">i taale banê êr an sêêsêrnê êr,</para>
  <para style="q2" vid="PSA 40:4">aê banê êr an mwatlee banê manu god êr.<verse eid="PSA 40:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5" />Warsangul nak God,</para>
  <para style="q2" vid="PSA 40:5">ta êr ane o môômnê ne m'kaka re aê i m'gatgat balêp,</para>
  <para style="q2" vid="PSA 40:5">aê soksok êr ane o m'dotkurukru oligma aê i m'gatgat balêp.</para>
  <para style="q1" vid="PSA 40:5">Taalsê tesu an tepapanê êk.</para>
  <para style="q2" vid="PSA 40:5">Tepe nê t'sahrô ne paetnê ta êr ane o môômnê bwa,</para>
  <para style="q2" vid="PSA 40:5">ape êr gatgat balêp nga olin ane tesahra.<verse eid="PSA 40:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6" />Pilan na tangroan aê pilan aê (lom taabe/lol natê mwahlal nga re êk).</para>
  <para style="q2" vid="PSA 40:6">Ape dalngik aê o mwasêanê.</para>
  <para style="q2" vid="PSA 40:6">Pilan an pangsê aê pilan na ôr aê o taa usiusi.<verse eid="PSA 40:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 40:7" />Ngatê aê nê m'pea, “Nê ela! Nê m'bama tê la.</para>
  <para style="q2" vid="PSA 40:7">M'juujusi Matlangkon olik.<verse eid="PSA 40:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 40:8" />Lok be ne ômnê nam dorngian, nak God.</para>
  <para style="q2" vid="PSA 40:8">Nam duan aê i m'pwat lon lolok.”<verse eid="PSA 40:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9" />Nê m'paetnê nam sekan an mwaknoknon lon kuukuran an jiljilêp.</para>
  <para style="q2" vid="PSA 40:9">Êk aê o mwaklê nga, <char style="nd">warsangul</char>, epe nê taa kookor goro bwelan bongok.<verse eid="PSA 40:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10" />Nê taa ling sênê nam ôt an mwaknoknon nga lon lolok,</para>
  <para style="q2" vid="PSA 40:10">mwa nê m'sahra lolom an mwagmwi antôn aê nam sal na miran baôt.<verse eid="PSA 40:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11" />O ngalobwitnê nam lolbeeberan nga jingi nê, <char style="nd">warsangul</char>.</para>
  <para style="q2" vid="PSA 40:11">Aê nam lolantôô men lolom an mwagmwi antôn aê i t'du kookor goro nê tamat.<verse eid="PSA 40:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12" />Olin ane ôt êr an sangsanga ne ba mamanê nê, aê êr gatgat balêp ngane tlêng tliiji nê, i taa ngrên tebwili nga pôntê.</para>
  <para style="q2" vid="PSA 40:12">Ôrek aê i m'sakaaji nê, aê nê taangrê ne nê t'le nga pôntê.</para>
  <para style="q1" vid="PSA 40:12">Êr gatgat aê esai waaluk an ran bôtôk,</para>
  <para style="q2" vid="PSA 40:12">aê nak dodotan môt sênê<verse eid="PSA 40:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 40:13" />Nê m'wariinê banê êk, <char style="nd">warsangul</char>, o t'pilmôlnê nê (jingin nak ôr).</para>
  <para style="q2" vid="PSA 40:13">O t'ma kuukus aê emi dbo nê, <char style="nd">warsangul</char>.<verse eid="PSA 40:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14" />Êr ane lor be ne tang bini nê nga,</para>
  <para style="q2" vid="PSA 40:14">aê bêr tekan aê lon bôtôr tehlal sênê.</para>
  <para style="q1" vid="PSA 40:14">Aê êr ane lor be ne sunê ôt êr an sangsanga manê nê,</para>
  <para style="q2" vid="PSA 40:14">aê êr ta hdor sênê bêbkanan natê.<verse eid="PSA 40:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 40:15" />Êr an manmansi nê</para>
  <para style="q2" vid="PSA 40:15">aê (êr te mta/nar dodotan temôt) sênê nar bêbkanan.<verse eid="PSA 40:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 40:16" />Ape êr an bwis pelangtê êk aê êr te kool aê erngo m'betôô re êk.</para>
  <para style="q2" vid="PSA 40:16">Êr ane lor bebe nam tobodboan aê êr tepe tamat epea,</para>
  <para style="q2" vid="PSA 40:16">“<char style="nd">warsangul</char> aê i m'betlap aê epwiris!”<verse eid="PSA 40:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 40:17" />Ape nê, aê nê m'be sêngêt aê lok be tobodboan.</para>
  <para style="q2" vid="PSA 40:17">Warsangul (o) tedmê nê.</para>
  <para style="q1" vid="PSA 40:17">Warsangul, êk aê o mwadbodbo nê aê epilpilkui nê jingin ôt êr an sangsanga.</para>
  <para style="q2" vid="PSA 40:17">O m'be nak God, aê o ngalo (tnan/raa branê) nga.<verse eid="PSA 40:17" /></para>
  <chapter eid="PSA 40" />
  <chapter number="41" style="c" sid="PSA 41" />
  <para style="d">Na Dumôan na Sasaan. Bô na Deebêt su.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 41:1" />(Warsangul aê i m'betôô/Tôôan aê i m') banê êr an le banê antôn êr anbe (sêngêt/beeberan).</para>
  <para style="q2" vid="PSA 41:1">
    <char style="nd">Warsangul</char> met'le banê êr lon wamran êr an sanga.<verse eid="PSA 41:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2" />
    <char style="nd">Warsangul</char> du kookor goro êr aê tang gêtê êr ne êr sek ran tan.</para>
  <para style="q2" vid="PSA 41:2">Aê m'bwili êr ba me êr an mwarngorngo m'betôô ran tan.</para>
  <para style="q2" vid="PSA 41:2">I taalngi êr balon kêlênra nar wêlêr êr.<verse eid="PSA 41:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3" />Wamran ane êr tabwê ne pwat ran geser, aê <char style="nd">warsangul</char>, o mwadbo êr</para>
  <para style="q2" vid="PSA 41:3">aê emwê ne nar tabwêan monok.<verse eid="PSA 41:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4" />Aê nê m'pe epe, “Lom tebeeber pok, <char style="nd">warsangul</char>,</para>
  <para style="q2" vid="PSA 41:4">aê emwê ne nak tabwêan tenok, olin ane nê môômnê ôr bênê êk.”<verse eid="PSA 41:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5" />Nak wêlêr êr sahra soksok êr an sanga ane êr met'longlongmê nê nê epea,</para>
  <para style="q2" vid="PSA 41:5">?Nangês pôn ene i met'po mat, aê sên metahlal?”<verse eid="PSA 41:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6" />Re wamran ane gasu re êr mi lsê nê papanre, ape i m'po mi saasarnê nga.</para>
  <para style="q2" vid="PSA 41:6">Olin ane i mwalê dal êr an sangsanga ane êr mwasaasarnê bare nê, aê i m'pwat lon lolon,</para>
  <para style="q2" vid="PSA 41:6">monok aê epii aê enga ba latnê bwelak.<verse eid="PSA 41:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7" />Êr bonga ane lor taabe nê m'katlalanê dal re êr bonê nê.</para>
  <para style="q2" vid="PSA 41:7">Êr mwadmêdmê dodotan êr an sangsanga ma bênê nê, aê epea,<verse eid="PSA 41:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8" />“Tegar su an sanga mwalê i,</para>
  <para style="q2" vid="PSA 41:8">aê i taangrê ne i t'mo mra ronga jingin gesen.”<verse eid="PSA 41:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9" />Nak bwangbwangan antôô nga ronga,</para>
  <para style="q2" vid="PSA 41:9">ane nê m'kakoknga ran,</para>
  <para style="q1" vid="PSA 41:9">ne gnagan mek,</para>
  <para style="q2" vid="PSA 41:9">aê i mwatlee aê ebwal bênê nê.<verse eid="PSA 41:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10" />Ape lom tebeeber pok, <char style="nd">warsangul</char>.</para>
  <para style="q2" vid="PSA 41:10">Aê emwê ne nak tabwêan tenok aê nê met'mo mra, aê esumôlnê tane êr môômnê re nê.<verse eid="PSA 41:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11" />Nê mwaklê epe o mwarngo m'betôô re nê olin tanlo.</para>
  <para style="q2" vid="PSA 41:11">Olin ane nak wêlêr êr aê êr taakool, sênê ane êr taasai nê.<verse eid="PSA 41:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12" />Aê môn, aê nê taaômnê tatesu an sanga, ngatê aê o m'du mek.</para>
  <para style="q2" vid="PSA 41:12">Aê emwê ne nê m'sek bwêlêm basô.<verse eid="PSA 41:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 41:13" />Nê m'sêêsêrnê warsangul, anbe God na ôt Israel.</para>
  <para style="q2" vid="PSA 41:13">Te sêêsêrnê i basô!</para>
  <para style="qc" vid="PSA 41:13">(Amen ane Amen/Koknga ane koknga.)<verse eid="PSA 41:13" /></para>
  <chapter eid="PSA 41" />
  <chapter number="42" style="c" sid="PSA 42" />
  <para style="d">Bô su ane mabi Kora mwahrô. Banê dumôan na googoran.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 42:1" />Nê mamdê olim,</para>
  <para style="q2" vid="PSA 42:1">papanê ane bwê mamdê olin wa.<verse eid="PSA 42:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2" />Nak miran aê i mamdê oli God, God an mamir aê i taangrê ne mat.</para>
  <para style="q2" vid="PSA 42:2">?Wamran sa ne nê mwangrê ne ba lsê God?<verse eid="PSA 42:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3" />Suntak aê i nga be ak anin ngatê.</para>
  <para style="q2" vid="PSA 42:3">Lopwas aê ngaran nga.</para>
  <para style="q1" vid="PSA 42:3">Tamat nga, re wamran ane antôn êr pe banê nê epea,</para>
  <para style="q2" vid="PSA 42:3">“?Nam God pôn ebê?”<verse eid="PSA 42:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4" />Aê lon wamran êr anre aê nê mwadmêdmê ta êr anlo,</para>
  <para style="q2" vid="PSA 42:4">aê êr longlongmê lolok tehree nga.</para>
  <para style="q1" vid="PSA 42:4">Nê mwadmêdmê ane nê salsala me tunup êr an babanê (tangroan) lon Im na God, Jerusalem.</para>
  <para style="q1" vid="PSA 42:4">Ne nê m'dumdumônê or na tunup sure atlap balep,</para>
  <para style="q2" vid="PSA 42:4">men (tlo) sasaan na lol an mwakool ne sunê kakasooan banê God, lon (kuukuran/bwangbwangan) anre.<verse eid="PSA 42:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5" />?Olin sa, ne nê mwarngo m'sanga?</para>
  <para style="q2" vid="PSA 42:5">Aê olin sa ne nak dodotan môt papanlo?</para>
  <para style="q1" vid="PSA 42:5">Nê met'dorsê nga ra God,</para>
  <para style="q2" vid="PSA 42:5">olin ane nê met'mo (sêêsêrnê i/tangtang pan sên).</para>
  <para style="q2" vid="PSA 42:5">Nak sal na miran aê nak God.<verse eid="PSA 42:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 42:6" />Nak God! Nak dodotan môt,</para>
  <para style="q2" vid="PSA 42:6">ngatê aê nê mwadmê êk.</para>
  <para style="q1" vid="PSA 42:6">Tê ran wau an Misar, an ran dade ôt Heemon,</para>
  <para style="q2" vid="PSA 42:6">ran tan na ôt Joodan.<verse eid="PSA 42:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 42:7" />Nê mwarngo uran êr aê lok bong re nê nga.</para>
  <para style="q2" vid="PSA 42:7">I m'papanê ane tolo nam wa êr atlatlap, ne êr môtmôt bamre re bilil ma lon bwatnêp,</para>
  <para style="q1" vid="PSA 42:7">aê tear êr natê bonga mamtomtop</para>
  <para style="q2" vid="PSA 42:7">aê esal rak.<verse eid="PSA 42:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 42:8" />Ngaran nga aê i m'sunê nan lolantôô an po dudu ngatê manê nê,</para>
  <para style="q2" vid="PSA 42:8">aê lopwas aê nê mwalê nan bô</para>
  <para style="q2" vid="PSA 42:8">ne i m'be tangroan banê God an mwamwê ne nê mamir.<verse eid="PSA 42:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 42:9" />Nê m'pe banê God an dudu kookor goro nê tamat ne nak wêlêr êr taami ôsê nê epea,</para>
  <para style="q2" vid="PSA 42:9">“?Olin sa ne o m'dot barak?</para>
  <para style="q1" vid="PSA 42:9">?Olin sa ne nê m'sala laklak aê egnaangar</para>
  <para style="q2" vid="PSA 42:9">sênê ane nak wêlêr êr bwal bênê nê?”<verse eid="PSA 42:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 42:10" />Nak wêlêr êr pepe dal êr an kankantê nê,</para>
  <para style="q2" vid="PSA 42:10">aê nê mwarngo keratan natê re nê aê i m'papanê ane lon bwarsuk po mtomtop.</para>
  <para style="q1" vid="PSA 42:10">Êr pepe banê nê lon bông êr bonga epea,</para>
  <para style="q2" vid="PSA 42:10">“?Nam God pôn ebê?” <verse eid="PSA 42:10" /><verse number="11" style="v" sid="PSA 42:11" />?Olin sa, ne nê mwarngo m'sanga?</para>
  <para style="q2" vid="PSA 42:11">?Aê olin sa ne nak dodotan môt papanlo?</para>
  <para style="q1" vid="PSA 42:11">Nê met'dorsê nga ra God,</para>
  <para style="q2" vid="PSA 42:11">olin ane papanre aê nê met'mo (sêêsêrnê i/tangtang pan sên).</para>
  <para style="q2" vid="PSA 42:11">Nak sal na miran aê nak God.<verse eid="PSA 42:11" /></para>
  <chapter eid="PSA 42" />
  <chapter number="43" style="c" sid="PSA 43" />
  <para style="s">U Bô na 42 Ronga ela.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 43:1" />Bwatkôlkôl, o telê nam dodotan aê epe, epe nê, aê nê mwadmedmel nga,</para>
  <para style="q2" vid="PSA 43:1">aê esahrô aê ebwal goro nê banê êr an taaklê êk.</para>
  <para style="q1" vid="PSA 43:1">O t'pilkui nê jingi êr an</para>
  <para style="q2" vid="PSA 43:1">mwasaasarsusu nê aê êr an pepe dal reesaran bare nê.<verse eid="PSA 43:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 43:2" />Êk aê o m'be Bwatkôlkôl an (lepok aê edu kookor goro nê/be nak ôt na pluan).</para>
  <para style="q2" vid="PSA 43:2">?Olin sa ne o (mwaôlêôlê/tlee tôsênê) nê?</para>
  <para style="q1" vid="PSA 43:2">?Olin sa ne nê m'sala laklak aê engaangar papanlo</para>
  <para style="q2" vid="PSA 43:2">sênê ane nak wêlêr êr tang bêrê nê nga?<verse eid="PSA 43:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3" />O t'jung bêsênê nak sal aê esahra nam dal koknga êr, banê nê,</para>
  <para style="q2" vid="PSA 43:3">aê êr te dumônê nê.</para>
  <para style="q1" vid="PSA 43:3">Êr te pil môlnê nê banê nam wau kon,</para>
  <para style="q2" vid="PSA 43:3">banê ôt ane o m'seksek re.<verse eid="PSA 43:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4" />Aê nê meteanê ot na Bwatkôlkôl.</para>
  <para style="q2" vid="PSA 43:4">Banê Bwatkôlkôl, anbe gelte lolok an mwakool aê emwêmwê ne nê mwa kookool.</para>
  <para style="q1" vid="PSA 43:4">aê nê me'tangtang pan sêm nê googoran na kiitar,</para>
  <para style="q2" vid="PSA 43:4">Êdêê Bwatkôlkôl, nak Bwatkôlkôl.<verse eid="PSA 43:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5" />?Olin sa, ne nê mwarngo m'sanga?</para>
  <para style="q2" vid="PSA 43:5">?Aê olin sa ne nak dodotan môt papanlo?</para>
  <para style="q1" vid="PSA 43:5">Nê met'dorsê nga ra God,</para>
  <para style="q2" vid="PSA 43:5">olin ane papanre aê nê met'mo (sêêsêrnê i/tangtang pan sên).</para>
  <para style="q2" vid="PSA 43:5">Nak sal na miran aê nak God.<verse eid="PSA 43:5" /></para>
  <chapter eid="PSA 43" />
  <chapter number="44" style="c" sid="PSA 44" />
  <para style="d">Bô Su ane Sure Wanju Kora êr anbe Admwan mwahru. Na Dumôan na sasaan.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 44:1" />Warsangul, gema mwarngo nê dalngigma nga jijinga,</para>
  <para style="q2" vid="PSA 44:1">ne jibigma êr sahrônê soksok êr an jiljillêp</para>
  <para style="q1" vid="PSA 44:1">ane o môômnê jimarin,</para>
  <para style="q2" vid="PSA 44:1">lon nar wamran, banê gema.<verse eid="PSA 44:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2" />Ane nê nam pwirisan ngahpom aê o m'korbênê or na antôn êr (kadkes) jingin tan,</para>
  <para style="q2" vid="PSA 44:2">aê elngi jibigma êr baran.</para>
  <para style="q1" vid="PSA 44:2">O m'tang (longlongmê/binibni) antôn êr [kadkes/bwelak]</para>
  <para style="q2" vid="PSA 44:2">aê emwê ne jibigma êr ne nar soksok (mi) du.<verse eid="PSA 44:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3" />Taabe nê nar ai na bwalan,</para>
  <para style="q2" vid="PSA 44:3">aê taabe nê (erar/nar pwirisan) ene êr mwalê tan nê.</para>
  <para style="q1" vid="PSA 44:3">Ape nê eram antôô, aê nam pwirisan pôn,</para>
  <para style="q2" vid="PSA 44:3">aê olin ane êr mwaklê epe o m'sek bilji êr,</para>
  <para style="q2" vid="PSA 44:3">olin ane o m'dorngi êr.<verse eid="PSA 44:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4" />O m'be nak Warsangul lêp aê ebe nak God,</para>
  <para style="q2" vid="PSA 44:4">an mwamwê ne (Jekôp/nam antôn êr) mi saasai antôn êr {kadkes/bwelak}.<verse eid="PSA 44:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5" />Nga ram aê gema m'so môlnê nagma wêlêr êr,</para>
  <para style="q2" vid="PSA 44:5">aê ngaran sêm aê gema m'laa rar.(T4T)<verse eid="PSA 44:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6" />Nê taadorsê re nak isu mêlêsia,</para>
  <para style="q2" vid="PSA 44:6">aê nak ai na bwalan taadbo nê.<verse eid="PSA 44:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7" />Ape êk nga aê o mwamwê ne gema m'sai nagma wêlêr êr,</para>
  <para style="q2" vid="PSA 44:7">aê emwê ne êr an mwaju bôtôr bênê gema aê bêr kan.<verse eid="PSA 44:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8" />Gema m'sêêsênê êk God lon bông êr bonga olin soksok êr ane o môômnê bonê gema,</para>
  <para style="q2" vid="PSA 44:8">aê gema me me'tangtang pan sêm basô.<verse eid="PSA 44:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9" />Ape rundelo aê o mwatlee tôsênê gema aê emwê ne bêgma m'kan.</para>
  <para style="q2" vid="PSA 44:9">O taa ba balon jingin me nagma antôn êr na bwalan ronga.<verse eid="PSA 44:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10" />O mwamwê ne gema m'kor mtatnê nagma wêlêr,</para>
  <para style="q2" vid="PSA 44:10">aê emwê ne êr an mwaju bôtôr bênê gema m'ba lê nagma soksok aê elonglongmê nga.<verse eid="PSA 44:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11" />O mwalngi gema epe metegne gema papanê sipsip</para>
  <para style="q2" vid="PSA 44:11">aê esêknê gema bwelak ba wele or antôn êr kadkes.<verse eid="PSA 44:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12" />O m'posnê gema nam antôn êr aê waa gelegma m'betkan nga.</para>
  <para style="q2" vid="PSA 44:12">O taalê agelgel tesu antôô re.<verse eid="PSA 44:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13" />O mwamwê ne or na antôn êr an sek liiji gema (m'sahra/m'bunê) gema,</para>
  <para style="q2" vid="PSA 44:13">aê emansi gema aê esêr bingsê gema nga.<verse eid="PSA 44:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14" />O mwamwê ne êr mwalê sê nakgma ere ne i mibe bwatlê na manan,</para>
  <para style="q2" vid="PSA 44:14">aê emwê ne antôn êr bulbulnê bôtôr regma olin (tan dêng re gema/ane êr lehbêhbê gema nga).<verse eid="PSA 44:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15" />Lon bông êr bonga aê nê m'sek nga lon bebkanan.</para>
  <para style="q2" vid="PSA 44:15">Aê bêbkanan natê m'daôt re lonmtak,<verse eid="PSA 44:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 44:16" />sênê dal na nak wêlêr êr, ane êr pe ne nê mwarngo, aê i m'kantê nê.</para>
  <para style="q2" vid="PSA 44:16">Olin ane lor be ne tang bini nê nga.<verse eid="PSA 44:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17" />Gema taadot baram,</para>
  <para style="q1" vid="PSA 44:17">aê taabe gema ene gema taatong banê nam dal na kambôôan,</para>
  <para style="q2" vid="PSA 44:17">aê i nga re aê ta êr anlo m'bama ragma.<verse eid="PSA 44:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18" />Taabe tatesu ne lologma m'pwat gna mem,</para>
  <para style="q2" vid="PSA 44:18">aê gema taalngi ane esodutôn ta êr ane lom be,<verse eid="PSA 44:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 44:19" />ape i nga re aê o mwalngi gema aê gema m'be beeberan nga wele bwê dibôr êr aê o taadbo gema,</para>
  <para style="q2" vid="PSA 44:19">aê epii jingi gema aê emwê ne gema m'sek lon mêlêk an tah ran tan.<verse eid="PSA 44:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 44:20" />Tebe gema telngi ane etangtangro banê êk, nagma God,</para>
  <para style="q2" vid="PSA 44:20">aê edrar lon tangroan banê god kadkes,<verse eid="PSA 44:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 44:21" />ape o mwangrê ne jikrênê nga.</para>
  <para style="q2" vid="PSA 44:21">Olin ane êk aê o mwaklê ta êr an pwat pulu lon lolo antôn.<verse eid="PSA 44:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 44:22" />Ape i nga re aê gema mat lon bông êr bonga [nga] olim.</para>
  <para style="q2" vid="PSA 44:22">Mwapnis binibni gema papanê sipsip êr an du olin ane me'tang bini êr nga.<verse eid="PSA 44:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 44:23" />O tekrê, Warsangul! Olin sa ne o mamjur?</para>
  <para style="q2" vid="PSA 44:23">O temra klakla êk! O ngalolngi gema basô.<verse eid="PSA 44:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 44:24" />Olin sa ne o [m'ling sênê/mwatleenê] lontam jingi gema</para>
  <para style="q2" vid="PSA 44:24">aê edot baran nagma rongo sangaan aê edot baran ane m'tang bêrêbrê gema nga?<verse eid="PSA 44:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 44:25" />Gema mwa hdor tehree nga balon tan,</para>
  <para style="q2" vid="PSA 44:25">aê tarbegma m'ba pwat basu lon tan.<verse eid="PSA 44:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 44:26" />O temra aê emi dbo gema. O t'pilkui gema jingi rongo sangaan anla,</para>
  <para style="q2" vid="PSA 44:26">olin ane nam lolantôô aê i m'po dudu bare.<verse eid="PSA 44:26" /></para>
  <chapter eid="PSA 44" />
  <chapter number="45" style="c" sid="PSA 45" />
  <para style="d">Bô na laan su ane wanju Kora êr mwa hru. Aê tlotê m'papanê tlo bô ane m'kanê epe “Sosanim” ane dodotan natê epe ‘Wangia’. Banê i an dumônê sasaan.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 45:1" />Lolok bit sênê dal êr antôôtôô na bô anlo,</para>
  <para style="q2" vid="PSA 45:1">re wamran ane nê m'sasahrônê orean natê [oli/bonê] warsangul lêp.</para>
  <para style="q2" vid="PSA 45:1">Mêk aê i m'be [waana/pen] na antôn an kon lon sal na juujusan.<verse eid="PSA 45:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2" />Êk aê o m'betôô balêp sai admwan êr bonga.</para>
  <para style="q2" vid="PSA 45:2">Aê o mwaklê sal na sahrôan an [sobrê/bitnê] lolo antôn,</para>
  <para style="q2" vid="PSA 45:2">olin ane God konnê êk [basô/tamat].<verse eid="PSA 45:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3" />Bwarii na bwalan! O t'langlê nam isu mêlêsia, aê ehgo nam bôtôô êr,</para>
  <para style="q2" vid="PSA 45:3">Aê rômtas nam aê nam maaan aê i te nam [kookorulan/bwelaul].<verse eid="PSA 45:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 45:4" />O t'kor papanê warsangul lêp an bwal lon jingig aê epen binibni nan wêlêr êr bonga.</para>
  <para style="q2" vid="PSA 45:4">Olin ane o m'bwal [goro/olin] dal koknga ane o m'sahra aê dodotan êr ane o mwalê ne êr mamlumlum aê eknoknon.</para>
  <para style="q2" vid="PSA 45:4">Aê ne nam pwirisan aê o tebsênê ôt êr an jiljilêp ane o m'seknê/ômnê.<verse eid="PSA 45:4" /></para>
  <chapter eid="PSA 45" />
  <chapter number="51" style="c" sid="PSA 51" />
  <para style="s">Bô 51</para>
  <para style="d">Banê dumôan na sasaan</para>
  <para style="d">Bô su na Deebêt</para>
  <para style="d">Pon ane Deebêt môômnê dal me Betseba aê Neetan anbe antôn na patlelean bama bwilan</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 51:1" />O tebsênê lolom antôô manê nê, Bwatkôlkôl,</para>
  <para style="q2" vid="PSA 51:1">re nam lol an mwagmwi antôn,</para>
  <para style="q1" vid="PSA 51:1">aê re nam lolbeeberan an betlap balêp</para>
  <para style="q2" vid="PSA 51:1">aê epilkui nak sekan êr an sanga.<verse eid="PSA 51:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2" />O tegsê nak baselan baôt</para>
  <para style="q2" vid="PSA 51:2">aê elamsi nak ôr jingi nê.<verse eid="PSA 51:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3" />Olin ane nê mwakêlê epe nak sekan an sanga</para>
  <para style="q2" vid="PSA 51:3">aê nak ôr, m'pwat nga goro mtak tamat.<verse eid="PSA 51:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4" />Banê êk, aê êk su ngahpom ne nê môômnê ôr</para>
  <para style="q2" vid="PSA 51:4">aê sekan an taaknoknon goro mtam,</para>
  <para style="q1" vid="PSA 51:4">olin ngane o m'pe koknga lon nam sahrôan</para>
  <para style="q2" vid="PSA 51:4">aê nam sekan mwaknoknon re wamran ane o m'pepe antôn.<verse eid="PSA 51:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5" />O telsê! Nê m'do ma men telel,</para>
  <para style="q2" vid="PSA 51:5">wamran ane dasêk sekpak aê ôr po du tê re.<verse eid="PSA 51:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6" />O telsê! Lom m'be nak dodpwirisan lon lolok,</para>
  <para style="q2" vid="PSA 51:6">o mwamwê ne nak lolraranan du re ôt an pwat pulu.<verse eid="PSA 51:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7" />O t'sek mwatnê nê aê nê metenggal nê erse bôtôa anbe hiisop,<note caller="+" style="f"><char style="fr" closed="false">51:7 </char><char style="ft" closed="false">Hiisop aê i m'be ra bôtôa su ne mwagseê aê epatnô lon da aê edringnê bare tasu an met'konnê. </char></note></para>
  <para style="q2" vid="PSA 51:7">aê taetelsê tatesu re nê. O tegsê nê aê nê met'ma pwal sai kêlê ôl tôbôs.<verse eid="PSA 51:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8" />O temwê ne nê terngo uran na lol an mwakool</para>
  <para style="q2" vid="PSA 51:8">aê emwê ne bwarsu êr ene o mwamra bwijibji êr aê êr tetangtang pan sêm.<verse eid="PSA 51:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9" />O t'ling sênê lon mtam jingi nak ôr</para>
  <para style="q2" vid="PSA 51:9">aê epilkui nak baselan êr bonga.<verse eid="PSA 51:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10" />O tekoe lolok aê i tedrê, nak Bwatkôlkôl,</para>
  <para style="q2" vid="PSA 51:10">aê emwê ne nunua an pwat pwiris lon lolok me'teêê.<verse eid="PSA 51:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11" />O ngalopwasnê nê baôt jingin ôt ane o m'sek re</para>
  <para style="q2" vid="PSA 51:11">aê o ngalopilkui nam Nunukon jingi nê.<verse eid="PSA 51:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12" />O t'su môlnê lolkoolan na nam tobodboan manê nê,</para>
  <para style="q2" vid="PSA 51:12">aê esunê lol na tongan aê i met'pwat lok.<verse eid="PSA 51:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13" />Aê papanre, aê nê meteusurnê nam sal êr banê êr en bwal bênê êk</para>
  <para style="q2" vid="PSA 51:13">aê êr ane nar ôr êr du met'mo môl banê êk.<verse eid="PSA 51:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14" />O t'pilkui nê aê nê temra jingin da êr ane nê mwamwê ne êr sal, Bwatkôlkôl,</para>
  <para style="q2" vid="PSA 51:14">Bwatkôlkôl anbe nak tobodboan.</para>
  <para style="q3" vid="PSA 51:14">Bongok met'sasa olin lolok an mwakool aê olin nam sekan an mwaknoknon.<verse eid="PSA 51:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15" />
    <char style="nd">Warsangul</char> o tesêanê bwelan bongok</para>
  <para style="q2" vid="PSA 51:15">aê bongok me'tangtang pan sêm.<verse eid="PSA 51:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16" />Olin ane losal êr taamwê ne o terngo m'betôô.</para>
  <para style="q2" vid="PSA 51:16">Aê o taarngo betôô re pilan an pangsê, tenga bwa aê nê met'sunê.<verse eid="PSA 51:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17" />Pilan êr an pangsê banê Bwatkôlkôl aê êr be nunua an mamlumlum,</para>
  <para style="q2" vid="PSA 51:17">aê lol an mwarngo m'sanga, Bwatkôlkôl, aê lom be.<verse eid="PSA 51:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18" />Me lolom antôô aê o t'sek tehreenê ôt Saeon.</para>
  <para style="q2" vid="PSA 51:18">O tebsa ee anbe ee at na ôt Jerusalem.<verse eid="PSA 51:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19" />Aê papanre aê o meterngo m'betôô re losal êr en mwaknoknon;</para>
  <para style="q2" vid="PSA 51:19">papanê pilan êr an met'pangsê kesnga.</para>
  <para style="q3" vid="PSA 51:19">Papanre, aê antôn êr met'pangsê bôtôlso êr ran nam ot.<verse eid="PSA 51:19" /></para>
  <chapter eid="PSA 51" />
  <chapter number="100" style="c" sid="PSA 100" />
  <para style="s">Bô 100</para>
  <para style="d">Bô su na ngan met'sunê kakasooan</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 100:1" />Ratan bonga, teka men lolkoolan banê <char style="nd">Warsangul</char>.<verse eid="PSA 100:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 100:2" />Teôm na <char style="nd">Warsangul</char> men lol an mwakool.</para>
  <para style="q2" vid="PSA 100:2">Tema goro mtan men sasaan na lol an mwakool.<verse eid="PSA 100:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3" />Kêt teklê epe <char style="nd">Warsangul</char> aê i m'be Bwatkôlkôl.</para>
  <para style="q2" vid="PSA 100:3">I en môômnê kêt,</para>
  <para style="q3" vid="PSA 100:3">aê kêt m'be nan antôn êr, papanê sipsip na nan lo ee.<verse eid="PSA 100:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4" />Kêt teroo lon nan matla ee men kakasooan</para>
  <para style="q2" vid="PSA 100:4">aê eba ran nan sar</para>
  <para style="q3" vid="PSA 100:4">aê etangtang pan sên aê esêêsêrnê i aê esunê kakasooan banê i.<verse eid="PSA 100:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5" />Olin ane <char style="nd">Warsangul</char> aê i m'betôô.</para>
  <para style="q2" vid="PSA 100:5">Nan dodpwirisan aê nan lol an mwagmwi antôn me ormelang na antôn êr bonga an metadodo ma ronga.<verse eid="PSA 100:5" /></para>
  <chapter eid="PSA 100" />
  <chapter number="117" style="c" sid="PSA 117" />
  <para style="rem">begin</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 117:1" />
    <verse eid="PSA 117:1" />
    <verse number="2" style="v" sid="PSA 117:2" />
    <verse eid="PSA 117:2" />
  </para>
  <para style="rem">end ignore</para>
  <chapter eid="PSA 117" />
</usx>