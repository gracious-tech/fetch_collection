<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PRO" style="id">- Sa</book>
  <para style="h">Lolraranan</para>
  <para style="toc1">Dal na Lolraranan na Solomon</para>
  <para style="toc2">Lolraranan</para>
  <para style="toc3">LOL</para>
  <para style="mt1">Dal na Lolraranan na Solomon</para>
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s">O ngalogtaa re êsên kadkes</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1" />Wanjuk admwan, o tong banê nak dal na lolraranan<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="ft" closed="false">Lolraranan aê dodotan natê aê i m'be wisdom.</char></note></para>
  <para style="q2" vid="PRO 5:1">aê edranê dalngim aê etong tehree banê nak kêlêôtan.<verse eid="PRO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2" />Papanre aê o meteklê sekan êr an mwaknoknon ene o met'ômnê</para>
  <para style="q2" vid="PRO 5:2">aê nam sahrôan metebsênê epe nam kêlêôtan du.<verse eid="PRO 5:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3" />Olin ngane bwelan bongo êsên an mwablablak aê i m'deldel papanê su têê an deldel aê ejuujur re bongon,</para>
  <para style="q2" vid="PRO 5:3">aê nan sahrôan aê i mamlas sai ôlpas.<verse eid="PRO 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4" />Ape nokan natê, aê i met'konkon papanê wanokon</para>
  <para style="q2" vid="PRO 5:4">aê engkan papanê ai na bwalan an mwangkan re sêtê rakô bonga.<verse eid="PRO 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5" />Lên rakô m'sala aê emlel banê matan,</para>
  <para style="q2" vid="PRO 5:5">aê nan kuulaan mwaknon banê ôt Lonliwe.<verse eid="PRO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6" />Tane i taet'sodutôn sal na miran,</para>
  <para style="q2" vid="PRO 5:6">aê i met'nga sala nêtnêng nga, ape i taeteklê epe i mwahlal.<verse eid="PRO 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7" />Aê runlo wanjuk admwan, aê o tong banê nê,</para>
  <para style="q2" vid="PRO 5:7">aê o ngalotlee jingin dal êr ane nê m'sahra.<verse eid="PRO 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8" />O t'ômnê nam sal aê i t'du na ôt, na ôt jingi i.</para>
  <para style="q2" vid="PRO 5:8">O ngaloba bwilan bulpatêê na nan im.<verse eid="PRO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9" />Tanre tê, aê o t'nga sunê nam pwirisan bonga banê êr kadkes,</para>
  <para style="q2" vid="PRO 5:9">ee nam miran banê êr an tangtang bêrê antôn nga.<verse eid="PRO 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10" />Iaa tanre tê aê antôn êr kadkes met'ngamo gan re nam soksok, nam pwirisan me nam pwakonan</para>
  <para style="q2" vid="PRO 5:10">aê i metea mlemlenga, olin ngane nam soksok met'ngamo ba pwer lon im na antôn kadkes.<verse eid="PRO 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11" />Aê banê nokan na nam miran aê lon tarbem metehlee sênê,</para>
  <para style="q2" vid="PRO 5:11">aê o met'not pan keratan natê.<verse eid="PRO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12" />Aê o met'pea, “I pwê! Nê m'papanbê lo ê, nê taatootoo re lumluman êr ane nê mwalê,</para>
  <para style="q2" vid="PRO 5:12">aê lolok taapwat re dal êr an mwablo nê.<verse eid="PRO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13" />Aê nê taatong banê tlo antôn êr an mwabloblo nê,</para>
  <para style="q2" vid="PRO 5:13">aê nê taadranê dalngik banê nak absêbsê êr.<verse eid="PRO 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14" />Nê m'sanga tehree nga olin nak duan êr an sangsanga,</para>
  <para style="q2" vid="PRO 5:14">lon tobol na tunup êr an mama kuukurbil.”<verse eid="PRO 5:14" /></para>
  <para style="b" />
  <para style="s1">Lolom tegmwi nam êsên nga</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15" />O t'min nga re wa an pwer lon nam jungu tan,</para>
  <para style="q2" vid="PRO 5:15">aê nga re wa an sal re nam mta wa an gêpgêp maôt.<verse eid="PRO 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16" />Iaa nam wa an gêpgêp maôt</para>
  <para style="q2" vid="PRO 5:16">ere tenga sal bwelak ba pan bongo im êr kadkes.<verse eid="PRO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17" />I tebe nam aê nam ngahpom</para>
  <para style="q2" vid="PRO 5:17">ape i ngalobe nam me antôn êr kadkes.<verse eid="PRO 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18" />Nam êsên ngahpom tepapanê wa an konnê,</para>
  <para style="q2" vid="PRO 5:18">aê o terngo m'betôô me nam êsên ane o m'kanê i lon nam mwalgel.<verse eid="PRO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19" />I t'papanê wangia ene bon kookor</para>
  <para style="q2" vid="PRO 5:19">aê nan bitan temlas tehree papanê bwêsêl an sal re mtaran,</para>
  <para style="q2" vid="PRO 5:19">sôn rakô temwê ne o terngo m'betôô re wamran bonga</para>
  <para style="q1" vid="PRO 5:19">aê lolon ane i m'sunê banê êk aê i temwê ne nam dodotan tehlal oli i.<verse eid="PRO 5:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20" />?Aê olin sa ne nam dodotan metehlal bare êsên kadkes, wanjuk admwan?</para>
  <para style="q2" vid="PRO 5:20">?Aê olin sa ne o met'pwat balon bê êsên na admwan kadkes?<verse eid="PRO 5:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21" />Olin ngane goro mta <char style="nd">Warsangul</char></para>
  <para style="q2" vid="PRO 5:21">aê sal na antôn me nan salaan êr bonga aê i m'lebwrê, tatesu taaplu jingi i.<verse eid="PRO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22" />Sek baselan êr na antôn ane nan sekan taaknoknon</para>
  <para style="q2" vid="PRO 5:22">aê êr met'môlnê i aê i met'sa lon asasa na ôrên.<verse eid="PRO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23" />I met'mat olin ngane i taatong,</para>
  <para style="q2" vid="PRO 5:23">aê ehlal pan nan butnêtnê.<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="s">Lolraranan</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 16:1" />Antôn met'po ômnê nan dodotan êr,</para>
  <para style="q2" vid="PRO 16:1">ape <char style="nd">Warsangul</char> nga met'nga pe nokan na dal.<verse eid="PRO 16:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2" />Antôn metedmê epe sekan êr ane i m'sekseknê aê i m'po betôô nga,</para>
  <para style="q2" vid="PRO 16:2">ape <char style="nd">Warsangul</char> ngan met'nga talelenê dodotan êr na antôn anre epe i mwaknon ee i taaknon.<verse eid="PRO 16:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3" />O t'sunê nam ômwan êr bonga balon kêlênra <char style="nd">Warsangul</char></para>
  <para style="q2" vid="PRO 16:3">aê nam dodotan êr met'dêng.<verse eid="PRO 16:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4" />Soksok êr ngadkes aê <char style="nd">Warsangul</char> môômnê aê i m'roo re sal natê,</para>
  <para style="q2" vid="PRO 16:4">aê antôn êr ane nar sekan taaknoknon môn aê nar bông su na rongo sangaan aê i m'du.<verse eid="PRO 16:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5" />Sêran bonga na lolo antôn aê i m'be tadwen banê <char style="nd">Warsangul</char>.</para>
  <para style="q2" vid="PRO 16:5">Aê o meteklê tehree nga epe i taetelngi êr nga papanre, ape <char style="nd">Warsangul</char> met'po sunê lumluman banê êr tê.<verse eid="PRO 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6" />Me lol an mwagmwi antôn, aê dodpwirisan, aê i metehgahgaa ran sek baselan.</para>
  <para style="q2" vid="PRO 16:6">Aê me memean an lon metaan banê <char style="nd">Warsangul</char> aê antôn mwangrê ane i metetlee jingin sekan êr an taaknoknon.<verse eid="PRO 16:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7" />Wamran ane <char style="nd">Warsangul</char> mwarngo m'betôô re sekan êr na nasu,</para>
  <para style="q2" vid="PRO 16:7">aê nan wêlêr êr nga ronga aê i mwangrê ngane i met'sek lon temwat mer.<verse eid="PRO 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8" />Mô tan tekan ane o mwalê re sal an mwaknoknon</para>
  <para style="q2" vid="PRO 16:8">aê i m'betôô ronga ran ngane o metelê soksok êr an met'gatgat re sal an taaknoknon.<verse eid="PRO 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9" />Antôn met'po dmêdmê nan sal êr,</para>
  <para style="q2" vid="PRO 16:9">ape <char style="nd">Warsangul</char> ngan met'nga le pangpang pon nan kuulaan.<verse eid="PRO 16:9" /></para>
  <chapter eid="PRO 16" />
</usx>