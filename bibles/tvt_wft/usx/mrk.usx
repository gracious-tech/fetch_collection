<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="MRK" style="id">Tutsa: Bible Translation 1st Edition</book>
  <para style="ide">Unicode (UTF8)</para>
  <para style="h">Maak</para>
  <para style="toc1">MAAK ih raang arah Ruurangese</para>
  <para style="toc2">Maak</para>
  <para style="toc3">Mk</para>
  <para style="mt1">MAAK</para>
  <para style="mt2">Ih Raang Arah Ruurangese</para>
  <para style="imt">Ephangjatjih</para>
  <para style="ip">
    <char style="bk">Rangte jengkhaap Maak ih raangta jun ih</char> Ruurang Ese Rangte Sah, Jisu Kristo tiit dowa ih phang toon raangha. Jisu Kristo ih heh reeraang ah chaan aphaan pan ih mina loong suh jatthukta. Heh chaan ah heh reeraang ni noisokta, chiithih laakhah loong anep dokphanta, mina rangdah loong ah biin anaan etta. Jisu ih heteewah suh ngah Mina Sah et baatta. Mih suh roidong kotte nyia rangdah mina loong jen puipang suh ra tahang eah. Maak ih uh heh tiitwaan lah angthang ih, Jisu Kristo khiikkhi nyia heh reeraang loong ah we toombaat hali. Juungtemte Joon ih Jisu juungtem, nyia heh phate joonnaam, tiitwaan loong raangta, erah lilih arah le raangte warah ih Jisu ih mina loong deesiitta loong ah nyia heh ih nyootsootta loong anep raangthiinta. Saapoot rookliiwang damdam heliphante loong ih choocho ih thoijat rumta eno heh miksukte loong ah ih ehan han ih boot miksuk rumta. Hethoon adi Jisu arah hadaang adi tek haatta nyia tek nawa we ngaaksaatta tiit loong ah jatthuk hali.</para>
  <para style="ip">Maak leedap ethoon ni kook hoom ano 16:9-20 raangha rah Maak ih raang arah tah angka, wahoh ih raang arah wakdak raangha.</para>
  <para style="iot">Hemong Dowa Jatjih</para>
  <para style="io1">Rangte tiit phang baat<char style="ior">(<ref loc="MRK 1:1-13">1:1-13</ref>)</char></para>
  <para style="io1">Jisu mootkaat noksong dung ni<char style="ior">(<ref loc="MRK 1:14-9:50">1:14—9:50</ref>)</char></para>
  <para style="io1">Galili nawa ih Jerusalem ni<char style="ior">(<ref loc="MRK 10:1-52">10:1-52</ref>)</char></para>
  <para style="io1">Hethoon sa saasinet nyia Jerusalem reeni<char style="ior">(<ref loc="MRK 11:1-15:47">11:1—15:47</ref>)</char></para>
  <para style="io1">Jisu tek nawa ngaakthing <char style="ior">(<ref loc="MRK 16:1-8">16:1-8</ref>)</char></para>
  <para style="io1">Ngaakthing cho Teesu dong nyia etikmat<char style="ior">(<ref loc="MRK 16:9-20">16:9-20</ref>)</char></para>
  <chapter number="1" style="c"/>
  <para style="s">Juungtemte Joon ih Rangte tiitkhaap baatta</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mat 3:1-12</ref>; <ref loc="LUK 3:1-18">Luk 3:1-18</ref>; <ref loc="JHN 1:19-28">Jn 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>Arah Rangte sah,<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">mararah le adi Rangte Sah ih ta taraangka</char></note> Jisu Kristo Ruurang Ese tiit. <verse number="2" style="v"/><note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="MAL 3:1">Mal 3:1</ref></char></note>Erah jengkhaap ah khowah Isaia ih mamet baatta erah jun ih phang langta:</para>
  <para style="q1">“Rangte ih liita, ‘Ngah ih an ngah nah kaamwah an lam</para>
  <para style="q2">ban tan suh daapkaat hang.’</para>
  <para style="q1">
    <verse number="3" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">1:3 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 40:3">Isa 40:3</ref>
      </char>
    </note> Mih esiit phisaang hamong ni riingla,</para>
  <para style="q2">‘Teesu raangtaan ih lam ban hoon thiin an;</para>
  <para style="q2">heh khoom raangtaan ih lamjun et hoon an!’”</para>
  <para style="p">
    <verse number="4" style="v"/>Eno Joon ah phisaang hah ni juungtem nyia Rangte tiit tumbaat lam ih dong taha.<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="fq" closed="false">Eno Joon ah phisaang hah ni juungtem nyia Rangte tiit tumbaat lam ih dong taha</char><char style="ft" closed="false">mararah leedap adi </char><char style="fq" closed="false">Juungtemte Joon ah phisaang ko nawa Rangte tiit tumbaat lam ih dong taha .</char></note> Heh ih mina loong suh baatta, “Sen rangdah loong nawa ngaaklek ano juungtem an, eno ba Rangte ih sen rangdah ah biin anaan han.” <verse number="5" style="v"/>Judia juungkhuung nyia Jerusalem samnuthung nawa mina loong ah Joon jengkhaap chaat karumta. Neng ih neng rangdah loong ah dokbaat rum ano Jordan Juung adi juung ah tem ih rumta.</para>
  <para style="p">
    <verse number="6" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">1:6 </char>
      <char style="xt" closed="false">
        <ref loc="2KI 1:8">2Lu 1:8</ref>
      </char>
    </note>Joon ih mokchongdoot roon nawa ih hoon arah nyuh akhat kapta, heh room adi siikhoop roomkhe ah khe etta, eno heh phaksat ah wotuute nyi najui angta. <verse number="7" style="v"/>Heh ih mina loong suh thaaraam lam ih baat rumta, “Mina wasiit nga lih nah raakte ang hala erah wah ah nga nang ih elongthoon ang ah. <verse number="8" style="v"/>Ngah bah heh lakhoop pak taajoh tha uh taliikang. Ngah ih juung nawa ih tem rumhala, heh ih bah Esa Chiiala nawa ih tem raahan.”</para>
  <para style="s">Jisu juungtem nyia phate joonnaam</para>
  <para style="r">(<ref loc="MAT 3:13-4:11">Mat 3:13—4:11</ref>; <ref loc="LUK 3:21-22">Luk 3:21-22</ref>; <ref loc="LUK 4:1-13">4:1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v"/>Rekamdi Jisu ah Najaret hadaang Galili juungkhuung dowa thok taha, eno Joon ih Jordan juung ni Jisu juungtemta. <verse number="10" style="v"/>Juung nawa Jisu dokkhoom damdam, rang ah laangdat ano Esa Chiiala ah wotuupi woh likhiik ih datpuh raaha rah tupta. <verse number="11" style="v"/><note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="GEN 22:2">Rangph 22:2</ref>; <ref loc="PSA 2:7">Rsb 2:7</ref>; <ref loc="ISA 42:1">Isa 42:1</ref>; <ref loc="MAT 3:17">Mat 3:17</ref>; <ref loc="MAT 12:18">12:18</ref>; <ref loc="MRK 9:7">Mk 9:7</ref>; <ref loc="LUK 3:22">Luk 3:22</ref></char></note> Eno rang ni dongjengta, “An ah nga mongnook Sah. Ngah an suh eroon elang.”</para>
  <para style="p">
    <verse number="12" style="v"/>Erah damdam Esa Chiiala ih phisaang hah ko ni kaat thukta, <verse number="13" style="v"/>erah di heh saarookbaji tongta, eno Soitaan ih phateeta. Erah damdi woma siiawi nep angta, enoothong rangsah loong ra haano chosokboi rumta.</para>
  <para style="s">Jisu ih chaak haate wabaji poonta</para>
  <para style="r">(<ref loc="MAT 4:12-22">Mat 4:12-22</ref>; <ref loc="LUK 4:14-15">Luk 4:14-15</ref>; <ref loc="LUK 5:1-11">5:1-11</ref>)</para>
  <para style="p">
    <verse number="14" style="v"/>Joon phaatak ni sakta lini, Galili ni Jisu ah kah ano Rangte re nawa Ruurang Ese loong ah tumbaat kaatta. <verse number="15" style="v"/><note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="MAT 3:2">Mat 3:2</ref></char></note> “Saapoot ese thok ah chang ela,” Jisu ih liita, Rangte Hasong ah thok ih hala! Sen rangdah loong nawa elek ean, eno Ruurang Ese ah hanpi an!”</para>
  <para style="p">
    <verse number="16" style="v"/>Jisu Kristo Galili juungsitum kaang ni khoom kah adi, heh ih nyah haate soophoh wanyi Simoon nyia heno Endriu chaak ha tokdi japtupta. <verse number="17" style="v"/>Jisu ih nyi suh baatta, “Nga damdoh wang hansih ngah ih mih mamet joh ah erah nyoot nyuuha.” Jisu ih Pitar nyia Endriu khoonkhuung nawa poonta. <verse number="18" style="v"/>Erah damdam chaak ah thiinhaat nyu ano heh damdi roongwang nyuuta.</para>
  <para style="p">
    <verse number="19" style="v"/>Amasah haloot ni wang adi, Jebidi sah soophonyi Jeems nyia Joon we japtupta. Nengnyi ih khoonkhuung ni chaak khookham tok ang nyuuta. <verse number="20" style="v"/>Jisu ih tupnyu ano erah damdam laan poon ruh et nyuuta; eno nyi wah Jebidi ah neng ih lakbiitte ih siitkaat rumta ah damdi khoonkhuung ni thiinhaat nyu ano Jisu damdi roongwang nyuuta.</para>
  <para style="s">Chiithih laakhah pan wasiit</para>
  <para style="r">(<ref loc="LUK 4:31-37">Luk 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v"/>Jisu nyi heliphante loong ah Keparnam hadaang adi thok rumta, Jehudi naangtongsa saalih adi, Jisu ah Jehudi rangsoomnok ni kah ano phang nyootsoot kata. <verse number="22" style="v"/><note caller="-" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="MAT 7:28">Mat 7:28</ref>,<ref loc="MAT 7:29">29</ref> </char></note>Heh ih nyootsoot rumta ah chaat rum ano mina loong ah rapne ih paatja rumta, heh Hootthe nyootte loong ah ih nyootta ah likhiik lah angthang ih, chaan aphaan pan et nyootta.</para>
  <para style="p">
    <verse number="23" style="v"/>Erah damdam chiithih laakhah pan mih wasiit, Jehudi rangsoomnok ni thok haano riingta. <verse number="24" style="v"/>“Najaret nawa Jisu, an ih seng tumjih et he? Aani seng thet haat suh tam wang halu? Ngah ih jat et hala an o ah—an ah Rangte Esa kaamwah!”</para>
  <para style="p">
    <verse number="25" style="v"/>Jisu ih laathih asuh baatta, “Nak hoopti uh, arah mih sak dowa doksoon eh uh!”</para>
  <para style="p">
    <verse number="26" style="v"/>Chiithih laakhah rah ih mih ah mootnyoong thiin ano, riinghuung lam ih doksoonta. <verse number="27" style="v"/>Miloong ah rapne ih paatja rumta, eno neng chamchi ni wasiit wasiit suh phang chengmui rumta, “Arah tumjih ah? Arah tiit ah jaat hoh tiit na tam nyoot ha? Arah mih adi chiithih laakhah dok phanjih chaan nep bojeela! Heh jeng ah chiithih laakhah ih nep chaat ha ah!”</para>
  <para style="p">
    <verse number="28" style="v"/>Eno Jisu ruurang ah erah dowa ih Galili hakong noongrep ni ruurang kata.</para>
  <para style="s">Mina Jisu ih hantek deesiitta</para>
  <para style="r">(<ref loc="MAT 8:14-17">Mat 8:14-17</ref>; <ref loc="LUK 5:12-16">Luk 5:12-16</ref>)</para>
  <para style="p">
    <verse number="29" style="v"/>Jisu nyi heliphante, erah damdi Jeems nyia Joon, Jehudi rangsoomnok nawa dokkhoom rum ano phangla Simoon nyi Endriu nok ni karumta. <verse number="30" style="v"/>Simoon hopnuh ah sokwi ih sat ano jup eta, Jisu thok damdam, heh maasaat tiit ah laan banbaat ruh ih rumta. <verse number="31" style="v"/>Jisu ah wang ano, heh lak adi joh ano deesiitta. Heh sokwi khoisat ah laan de ruh eta, eno neng suh phaksat ah jam koh ih rumta.</para>
  <para style="p">
    <verse number="32" style="v"/>Rangsa lup damdam rangjaako di miloong ih Jisu jiinni khoisatte nyi echeek ebaang loong thutsiit jarum taha. <verse number="33" style="v"/>Erah hah dowa mina loongtang erah nokka adi thutkhoom rumta. <verse number="34" style="v"/>Jisu ih hephan dowa khoisat maasaat ah deesiit ano mikmuh juungbaan loong ah phanhaatta. Jisu ih mikmuh juungbaan loong suh tumjih uh tami jeng thukta, tumeah Jisu ah o angla neng ih jat eta.</para>
  <para style="s">Jisu ih Galili ni nyootsoot rumta</para>
  <para style="r">(<ref loc="LUK 4:42-44">Luk 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v"/>Erah saalih rangkhano chichuruh di, Jisu ah saat ano, erah nok dowa dokkhoom kata. Erah hadaang dowa tikpakpak hani Rangsoom suh dokkhoom kata. <verse number="36" style="v"/>Enoothong Simoon nyi heh joonte loong ah heh jam sok dokkhoom karumta, <verse number="37" style="v"/>eno japtup rum ano Jisu suh baat rumta, “Warep ih an ban sok halu.”</para>
  <para style="p">
    <verse number="38" style="v"/>Enoothong Jisu ih ngaakbaat rumta, “Seng arah rum dowa hahoh loong adoh ekaatjih jaatjaat ang ah. Ngah ih erah hah loong adoh uh nyootsoot jaatjaat etjih tumeah, ngah erah raangtaan ih ra tahang.”</para>
  <para style="p">
    <verse number="39" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">1:39 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:23">Mat 4:23</ref>; <ref loc="MAT 9:35">9:35</ref></char>
    </note> Eno Jisu ah Galili hakong noongrep ni tumkhoom ano Jehudi rangsoomnok loong adi tum nyootsootta, juungbaan ah riim dokphan etta.</para>
  <para style="s">Jisu ih engam wasiit deesiitta</para>
  <para style="r">(<ref loc="MAT 8:1-4">Mat 8:1-4</ref>; <ref loc="LUK 5:12-16">Luk 5:12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v"/>Engam ang arah wasiit, Jisu ngathong ni heh lakuh di tongwang taha, eno chosok ih weehang ih baatta. “An ih thun ubah, ngah ejen saasiit<note caller="+" style="f"><char style="fr" closed="false">1:40 </char><char style="ft" closed="false">Saasiit ih hang: Neng banlam di engam ah lasaasiitka bah tumjih doh uh mihoh damdi tajen roong re thukta </char></note> ehang.” heh ih liita.</para>
  <para style="p">
    <verse number="41" style="v"/>Jisu heh minchan ah dong ano, heh lak ah janghaat ano taajota. Eno liita, “Esaasiit et ha,” ‘Sa uh!” <verse number="42" style="v"/>Lakdamdam di erah mih ah laan saade ruh eta. <verse number="43" style="v"/>Eno Jisu ih erah wah asuh dangdang ih baat ano, echaan ih kaat thukta, <verse number="44" style="v"/><note caller="-" style="x"><char style="xo" closed="false">1:44 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">Lew 14:1-32</ref> </char></note> jen baat ano liita, “boichaat uh, an ih o suh uh arah tiit ah nak baat uh. Enoothong phangla romwah jiinnah wang uno heh ih toomhuk sokboiho an khoisat deetu rah ah, mirep ih de eta ih toomjat rumho, Moses ih baatta jun ih an khosa ah kowan et uh.”</para>
  <para style="p">
    <verse number="45" style="v"/>Enoothong erah warah ih noongrep ni heh khoisat deeta tiit ah phang tiibaat kaatta. Erathan ih tiibaatta, Jisu ah erah hadaang adi saasa tanaan wangta. Erah nang ih, heh hatik ni tong katta, ang abah uh miloong ah heh jiinni noongrep nawa thokruh ih rumta.</para>
  <chapter number="2" style="c"/>
  <para style="s">Jisu ih hiimuung wasiit deesiitta</para>
  <para style="r">(<ref loc="MAT 9:1-8">Mat 9:1-8</ref>; <ref loc="LUK 5:17-26">Luk 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>Rekam ritdi Jisu Keparnam ni, ngaakwangta, eno heh nok ni eje ih tiibaat mui rumta. <verse number="2" style="v"/>Erah thoidi miloong ah nokmong ni lathoh lathang ih lomkhoom rumta, kaasakthong ni nep hantek ang rumta. Jisu ih neng suh ruurang ese tiit nyootsoot rum adi <verse number="3" style="v"/>wabaji ih hiimuung wasiit Jisu reeni thokpi wanrumta. <verse number="4" style="v"/>Enoothong mih hantek ang thoidi, Jisu jiinni erah mih ah tajen noppi rumta. Erah thoidi Jisu khothung pun nokkhoh<note caller="+" style="f"><char style="fr" closed="false">2:4</char><char style="fq" closed="false">nokkhoh</char><char style="ft" closed="false">Jehudi loong nok sep ah mih nep mi tongtheng hoongthung hane ih hoon arah angta.</char></note> adi loohoom rum ano dam khoh adi hiimuung ah jupthiin rum ano datthiin rumta. <verse number="5" style="v"/>Jisu ih neng tuungmaang ah tup ano hiimuung ah suh baatta, “Nga sah, an rangdah loong ah biin anaan et halu.”</para>
  <para style="p">
    <verse number="6" style="v"/>Heh reeni tongta Hootthe nyootte loong ah ih erah chaat rum ano neng thungthung ni thun rumta, <verse number="7" style="v"/>“Heh emah mamah ih naan jengla? Arah ba Rangte kaanju tiit! Rangte heh luulu ih ba rangdah loong ah biin anaan jen hoon ah!”</para>
  <para style="p">
    <verse number="8" style="v"/>Erah damdam Jisu ih neng tenthun ah jat rum ano li rumta, “Emah sen ih mamet thunhan? <verse number="9" style="v"/>Hiimuung asuh, ‘an rangdah loong ah biin anaan et taho ih baat ah laangpopoh nih ang ah,’ adoleh, ‘an dam ah toonpi uno wang uh ih baat ah elaang nih ang ah?’ <verse number="10" style="v"/>Erah ang abah, ngah ih jatthuk rumha Mina Sah jiinni arah hatoh adi rangdah loong jen biin anaanjih chaan jeela eah.” Eno Jisu ih hiimuung asuh baatta, <verse number="11" style="v"/>“Ngah ih baat hala, toonchap uh, dam ah toonpi uno nok nah wang uh!”</para>
  <para style="p">
    <verse number="12" style="v"/>Neng loongtang miksok di, erah wah ah toonchapta, eno heh dam ah toonpi ano seek ih toonsoonta. Neng loong ah rapne ih paatja rum ano Rangte rang ah phoong rum ano jeng rumta, “Arah likhiik babah uh tathaak tupke!”</para>
  <para style="s">Jisu ih Leewi poonta</para>
  <para style="r">(<ref loc="MAT 9:9-13">Mat 9:9-13</ref>; <ref loc="LUK 5:27-32">Luk 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v"/>Jisu Galili juungsitum<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="fq" closed="false">Juungsitum</char><char style="ft" closed="false">juung tum maako uh lalaang janka ah (lake)</char></note> kaangko adi we ngaak kata. Miloong ah heh jiinni lomkhoon rumta, eno Jisu ih erah loong asuh phang nyootsoot rumta. <verse number="14" style="v"/>Erah di lengkhoom adi, sokse seete Leewi Alphias sah, apit<note caller="+" style="f"><char style="fr" closed="false">2:14</char><char style="fq" closed="false">Apit</char><char style="ft" closed="false">mootkaat pakna nok(office)</char></note> ni tong arah japtupta. Eno Jisu ih heh suh baatta, “Nga lilih eho.” Eno Leewi ah toonchap ano heh lilih eta.</para>
  <para style="p">
    <verse number="15" style="v"/>Rekamdi Jisu ih Leewi nok<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="fq" closed="false">Leewi nok ni; </char><char style="ft" closed="false">adoleh </char><char style="fq" closed="false">heh nok ni </char><char style="ft" closed="false">(erah langla Jisu) nok ni </char></note> ni phaksat sata. Sokse seete loong nyia rangdah mina hantek Jisu lilih ih rumta, eno neng dung dowa rukho loong ah ih heliphante loong damdi teebun ni cham roong sah rumta. <verse number="16" style="v"/>Pharisi dung dowa mararah Hootthe nyootte loong ah ih Jisu ah sokse seete nyia rangdah mina loong damdi phaksah arah japtup rum ano, neng ih heliphante loong asuh cheng rumta, “Erah likhiik mina loong damdi mamet phaksah ha?”</para>
  <para style="p">
    <verse number="17" style="v"/>Jisu ih japchaat ano ngaak liirumta, “Mina sak eseete ih phonwah<note caller="+" style="f"><char style="fr" closed="false">2:17 </char><char style="fq" closed="false">Phonwah</char><char style="ft" closed="false">khoisat maasat sokte; phonkotte (doctor)</char></note> tajamka, khoisatte ih ba jamha. Ngah kateng mina poon tara tahang, rangdah mina loong raang ih ra tahang.”</para>
  <para style="s">Samurangsoom tiit chengmui rumta</para>
  <para style="r">(<ref loc="MAT 9:14-17">Mat 9:14-17</ref>; <ref loc="LUK 5:33-39">Luk 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v"/>Saasiit Juungtemte Joon liphante loong nyia Pharisi loong ah samurangsoom tong rumta. Mararah mina Jisu jiinni wang rumha no chengrumta, “Juungtemte Joon liphante loong nyia Pharisi loong ah samurangsoom<note caller="+" style="f"><char style="fr" closed="false">2:18</char><char style="fq" closed="false">Samurangsoom</char><char style="ft" closed="false">phaksat muh ih rangsoom ha ah suh liiha</char></note> tong ela, enoothong an liphante loong ah tatong rumka nih?”</para>
  <para style="p">
    <verse number="19" style="v"/>Jisu ih ngaakbaat rumta, “Kuhoon sa doh wen loong ah samuh toom ngaakwang rum ah nih thunhan? Emah tah angka! Jaalakapte ah neng damdoh ang adoh, neng babah uh emah tareeka. <verse number="20" style="v"/>Enoothong neng re nawa jaalah kapte ah toonsiit rangwuung ah thok eha, eno ba neng samurangsoom tong rum ah.</para>
  <para style="p">
    <verse number="21" style="v"/>“O eh uh samsong ehak ah nyulep ena ih talep phingka, emah mok et phing abah nyuna chep rah ih nyuh hak ah boot raap hoom ano poolong ih thoon boot hoon ah. <verse number="22" style="v"/>Adoleh kham na ah siikhoop tiikook ehak adoh tasakka, emah mok ang abah tiikook<note caller="+" style="f"><char style="fr" closed="false">2:22</char><char style="fq" closed="false">Tiikook</char><char style="ft" closed="false">Jehudi tiikook ah siikhoop nawa ih hoon arah angta, Kham thiintheng ah</char></note> ah ephok eah, eno kham nyia tiikook enyi nyi thih ah.</para>
  <para style="p">Erah nang ih kham na ah tiikook ena nah sak theng.”</para>
  <para style="s">Jehudi naangtongsa thoidi chengmui rumta</para>
  <para style="r">(<ref loc="MAT 12:1-8">Mat 12:1-8</ref>; <ref loc="LUK 6:1-5">Luk 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">2:23 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 23:25">Hodb 23:25</ref> </char>
    </note> Jehudi naangtongsa di Jisu nyia heliphante loong ah chamtong ni daankhoom rum adi, heliphante loong ih raanteh ah phang thi phak rumta. <verse number="24" style="v"/>Erah thoidi Pharisi loong ah ih Jisu suh liita, “Sok uh, an liphante loong ah ih naangtongsa di erah re rumla rah seng Hootthe di tapunka!”</para>
  <para style="p">
    <verse number="25" style="v"/>Jisu ih ngaakbaatta, “Dewid ah ram ih ti ano phaksat suh ramta tok adi tumjih etta? Heh nyia heh joonte loong neng ram ih ti rumta, <verse number="26" style="v"/><note caller="-" style="x"><char style="xo" closed="false">2:26 </char><char style="xt" closed="false"><ref loc="LEV 24:9">Lew 24:9</ref> </char></note> <note caller="-" style="x"><char style="xo" closed="false">2:26 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1Sam 21:1-6</ref> </char></note>eno heh Rangte nok ni wang ano Rangte suh kota baanlo ah phaksah wangta. Erah di Abiathar ah romwah phokhoh angta. Seng Hootthe jun ih bah baanlo ah romwah loong ih ba jen phaksah ah—enoothong Dewid ih phaksah ano heh mina loong suh nep kota.”</para>
  <para style="p">
    <verse number="27" style="v"/>Jisu ih thoonbaat rumta, “Jehudi naangtongsa ah mina ese raangtaan dongsiitta; mina ah Jehudi naangtongsa raangtaan ih tah angka. <verse number="28" style="v"/>Erah thoidi Mina Sah ah naangtongsa asuh Teesu angla.”</para>
  <chapter number="3" style="c"/>
  <para style="s">Lakkoong mih wasiit</para>
  <para style="r">(<ref loc="MAT 12:9-14">Mat 12:9-14</ref>; <ref loc="LUK 6:6-11">Luk 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>Eno Jehudi rangsoomnok ni Jisu ngaakwangta adi, erah ni lakkoong wasiit angta. <verse number="2" style="v"/>Erah di mararah mina ih Jisu tumjih lasah thetreela ih bansokte eje angta, erah thoidi naangtongsa adoh mina maamok deesiit jaaoh ih ban sok rumta. <verse number="3" style="v"/>Jisu ih erah mih asuh baatta, “Nga ngah ko ih chap raaho.” <verse number="4" style="v"/>Erah lilih Jisu ih miloong asuh chengta, “Seng Hootthe ih naangtongsa doh tumjih ettheng ih baat hali? Ese re theng tam ethih re theng ah? Mih roidong ah pang tam etheng ah tam ah tek haat etheng ah?”</para>
  <para style="p">Miloong ah tumjih uh tajengta. <verse number="5" style="v"/>Miloong ah sok ano Jisu ah ekhat eta, thako adi neng thung ah jong ajaan likhiik ih thih rum kano heh tenthet dongta. Eno lakkoong wah asuh liita, “An lak ah janghaat uh.” Heh lak ah janghaat kah no ese we ih ngaak hoonta. <verse number="6" style="v"/>Erah thoidi Pharisi loong ah Jehudi rangsomnok nawa dokkhoom rum ano Hirod mina loong damdi, neng ih Jisu tek haat suh kaankoong karumta.</para>
  <para style="s">Juungsitum kaang ni mina loong</para>
  <para style="p">
    <verse number="7" style="v"/>Jisu nyia heliphante loong ah Galili juungsitum ko ih dokkhoom karumta, eno Galili nawa miloong ah hantek neng lilih ih roong karumta. Miloong ah Judia nawa, <verse number="8" style="v"/>Jerusalem nawa, Idumia hadaang nawa, Jordan juung saadongko hah nawa, erah damdi Tairi nyia Sidoon hah noongrep nawa lomkhoomta. Erah mina loongtang Jisu jiinni thokrum taha tumeah neng ih Jisu reeta ruurang ah japchaat et rumta. <verse number="9" style="v"/><note caller="-" style="x"><char style="xo" closed="false">3:9,10</char><char style="xt" closed="false"><ref loc="MRK 4:1">Mk 4:1</ref>; <ref loc="LUK 5:1-3">Luk 5:1-3</ref> </char></note> Miloong ah hantek ang thoidi Jisu ih heliphante loong asuh khoonkhuung heh duungchap suh jamthiin thuk rumta, miloong rah ih phojap nak rumhang eah. <verse number="10" style="v"/>Heh ih mih hantek deesiitta, erah damdi uh khoisatte ephoop ih Jisu jap taajoh suh rapne ih tuutmui rumta. <verse number="11" style="v"/>Chiithih laakhah pan miloong ah Jisu ah japtup rum leh loongdat emeleh riinghuung ih rumta, “An juuba Rangte sah ah!”</para>
  <para style="p">
    <verse number="12" style="v"/>Jisu ih chiithih laakhah loong asuh heh tiit ah o suh uh latumbaat theng ih dangdang et baat rumta.</para>
  <para style="s">Jisu ih asih wanyi heh kaamwah danjeeta</para>
  <para style="r">(<ref loc="MAT 10:1-4">Mat 10:1-4</ref>; <ref loc="LUK 6:12-16">Luk 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v"/>Eno Jisu kong ni duung wang ano heh ih jamta mina loong heh damdoh wak wangsuh poon rumta eno neng loong ah heh reeni ra rum taha, erah lih adi <verse number="14" style="v"/>asih wanyi ah danje ano Kaamwah<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="fq" closed="false">Kaamwah</char><char style="ft" closed="false">Heliphante asih wanyi danjeeta loong asuh liiha</char></note> et men rumta. “Ngah ih sen loong ah nga damdoh ang raang ih danje rumhala,” neng suh baat rumta. “Ngah ih sen loong ah Rangte tiitkhaap tumbaat raangtaan ih nep kaatthuk rumha, <verse number="15" style="v"/>eno sen suh chiithih laakhah loong dok phanjih chaan uh eje ang ah.”</para>
  <para style="p">
    <verse number="16" style="v"/>Jisu ih danjeeta asih wanyi loong ah arah: Simoon (Jisu ih Pitar et menta), <verse number="17" style="v"/>Jebedi sah soophoh nyi, Jeems nyia Joon, (Jisu ih Boonergis et menta, erah langla “Rangphah mih”); <verse number="18" style="v"/>Endriu, Philip, Batholomi, Mathiu, Thomas, Alphias sah Jeems, Thadias, Simoon deek akaan raangtaan ih laatte wah <verse number="19" style="v"/>nyia Judas Iskerot, Jisu khumtante wah ah.</para>
  <para style="s">Jisu nyia Benjibul</para>
  <para style="r">(<ref loc="MAT 12:22-32">Mat 12:22-32</ref>; <ref loc="LUK 11:14-23">Luk 11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v"/>Eno Jisu ah nok ni wangta. Erah di uh mina loong hantek ih lom thutthi rumta, Jisu nyia heliphante loong chamsat saapoot uh lachoh thang ah. <verse number="21" style="v"/>Jisu suh, “Emok ih hoonla” ih li rum kano, heh jaatang ah heh toonsiit ra rum taha.</para>
  <para style="p">
    <verse number="22" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">3:22 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 9:34">Mat 9:34</ref>; <ref loc="MAT 10:25">10:25</ref></char>
    </note>Mararah Jerusalem nawa Hootthe nyootte loong ra taha loong ah ih li rumta, “Arah mih abah Benjibul pan boh ah! Chiithih laakhah loong jen dokphan theng chaan kotte luungwang ah boh ah.”</para>
  <para style="p">
    <verse number="23" style="v"/>Erah thoidi Jisu ih heh reeni poon rum ano tiitthaak di toobaat rumta. “Soitaan ih Soitaan ah mamah mi et phanhaat ah?” <verse number="24" style="v"/>Deek esiit ah neng laktung nah phe ano rookmui abah, erah deek ah phaangjaang eah. <verse number="25" style="v"/>Changka siit laktung nah rookmui jengmui abah, erah changka ah phaangjaang eah. <verse number="26" style="v"/>Erah thoidoh Soitaan hasong adoh neng laktung nah pheehoom mui abah, erah roitang tatongka, erah nang ih bah phaangjaang rum ano ethoon ba eah.</para>
  <para style="p">
    <verse number="27" style="v"/>“Tathat mina nok ah long suh heh teewah ah lachaak tangkhakka bah heh hukkhaak ah tajen longka.</para>
  <para style="p">
    <verse number="28" style="v"/>“Ngah ih ami tiit baat rumhala, mina rangdah loong nyia neng ethih jengkhaap jengla loong ah biin anaan jenhoon mok et ah. <verse number="29" style="v"/><note caller="-" style="x"><char style="xo" closed="false">3:29 </char><char style="xt" closed="false"><ref loc="LUK 12:10">Luk 12:10</ref></char></note>Enoothong o ih Esa Chiiala asuh ethih jengkhaap jeng abah, babah uh biin anaan tachoka, tumeah heh ih mabah uh lathoonjih rangdah ah mola.” (<verse number="30" style="v"/>Jisu ih arah baatta ah langla, mararah mih ih amet li rumta, “Heh sak ni chiithih laakhah pan eah.”)</para>
  <para style="s">Jisu nuh nyia heh no loong</para>
  <para style="r">(<ref loc="MAT 12:46-50">Mat 12:46-50</ref>; <ref loc="LUK 8:19-21">Luk 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v"/>Eno Jisu nuh nyia heh no loong ah thok rumta. Nokka ni chap rum ano, Jisu ah poonwang thuk rumta <verse number="32" style="v"/>Jisu ah miloong hantek ih kooktong rum adi baat rumta, “Sok uh, an nuh nyi an no loong ih nokka ni chap rum ano, an jam rum halu.”</para>
  <para style="p">
    <verse number="33" style="v"/>Jisu ih ngaakbaatta, “Seng nuh o ah? Nga no loong o ah?” <verse number="34" style="v"/>Heh reeni kooktongta miloong ah sok ano liita, “Sok an! Ngah di bah arah loong ah seng nuh nyia ngaaphoh ngaano loong ah! <verse number="35" style="v"/>O ih Rangte jeng chaat ha erah loong abah seng nuh, seng nah nyia ngaapho ngaano ang ah.”</para>
  <chapter number="4" style="c"/>
  <para style="s">Chamwente tiitthaak</para>
  <para style="r">(<ref loc="MAT 13:1-9">Mat 13:1-9</ref>; <ref loc="LUK 8:4-8">Luk 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">4:1 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 5:1-3">Luk 5:1-3</ref>
      </char>
    </note>Jisu ih Galili juungsitum kaangkook ni we phang nyootsoot rumta. Miloong hantek ang thoidi Jisu ah khoonkhuung ni duungtong kata. Eno miloong ah juungsih kaang adi chap rumta. <verse number="2" style="v"/>Heh ih tiitthaak toobaat lam ih jaatrep tiit loong ah nyootsoot rumta, ame jeng ano ah:</para>
  <para style="p">
    <verse number="3" style="v"/>“Chaat an! Jaasiit mih esiit ih chamwen kaatta. <verse number="4" style="v"/>Phek ni chamwen adi, raanteh loong mararah ah lam ni datta, eno woh loong ih toontop wangtaha. <verse number="5" style="v"/>Mararah ah jong hah ni paak amasah ang arah di datta. Eno raanjih ah seek ih haapphookta, tumeah paak amasah ang thoidi ah. <verse number="6" style="v"/>Eno rang ah mi kano champhooksah loong ah laan tek raat ruh eta, tumeah hehing ah hanteng ni lamiisot thoidi hephook ah seek ih hookdatta. <verse number="7" style="v"/>Mararah raanteh ah suh buk ni datta, eno suphook ah hak ano, champhook ah hetiik uh ladong tiik thuk thang ih tekbukta. <verse number="8" style="v"/>Enoothong mararah raanteh ah hase ni datta loong abah, phook ano hak, eno hetiik ah dong tiikta: mararah ah tiik ah rookjom, rukho ah rook arok, rukho ah chaasiit ih dong tiikta.”</para>
  <para style="p">
    <verse number="9" style="v"/>Eno Jisu ih thoonbaat rumta, “Chaat an, sen na je abah ah!”</para>
  <para style="s">Tiitthaak baatta ah langla</para>
  <para style="r">(<ref loc="MAT 13:10-17">Mat 13:10-17</ref>; <ref loc="LUK 8:9-10">Luk 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v"/>Jisu heh laklak ang adi, ethok ih taha ih japchaatte miloong nyia heliphante Asih wanyi rah ih, tiitthaak loong ah huk jangbaat kohe ih baat rumta. <verse number="11" style="v"/>“Sen suh Rangte Hasong ni huthiinha mongtham ah jatthuk rumhala.” Jisu ih ngaakbaat rumta. “Erah tiitthaak loong abah wahoh loong ih toomchaat ah ih nyootbaat hang, <verse number="12" style="v"/><note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ISA 6:9">Isa 6:9</ref>,<ref loc="ISA 6:10">10</ref> (LXX)</char></note>mamah liidi,</para>
  <para style="q1">“Neng ih sok bah sok et ah,</para>
  <para style="q2">ang abah uh tatup rumka;</para>
  <para style="q1">neng ih chaat bah chaat et rum ah,</para>
  <para style="q2">ang abah uh tasamjat rumka.</para>
  <para style="q1">Tumeah neng ih erah jat rumta bah Rangte ko ngaak ih rumtheng taha,</para>
  <para style="q2">eno neng rangdah loong ah biin anaan et thengta.”</para>
  <para style="s">Jisu ih chamwen tiitthaak hukjangbaat kota</para>
  <para style="r">(<ref loc="MAT 13:18-23">Mat 13:18-23</ref>; <ref loc="LUK 8:11-13">Luk 8:11-13</ref>)</para>
  <para style="p">
    <verse number="13" style="v"/>Eno Jisu ih cheng rumta, “Sen ih arah tiitthaak ah tanih jatkan? Erah bah, jihoh tiitthaak tang nih ma jat an? <verse number="14" style="v"/>Chamwente rah ih Rangte tiit wenha. <verse number="15" style="v"/>Mararah mih ah raanjih lam ni datta rah likhiik, neng ih Rangte tiit ah chaat damdam soitaan ah wangha no nge kaatla. <verse number="16" style="v"/>Rukho mih ah raanjih jong khoni dat ah likhiik. Rangte tiit ah japchaat rum ano, tenroon lam ih kap rumha. <verse number="17" style="v"/>Enoothong neng ten ni lathiin thoih saatang tatongka. Rangte tiit thoidoh phate joonnaam sa doh neng ih laan thiinhaat ruh et ah. <verse number="18" style="v"/>Rukho mina ah langla raanjih suphook khoni datla likhiik. Rangte tiit abah chaat eha, <verse number="19" style="v"/>enoothong arah roidong suh sootsaam nyia changteng ehoon tenthun ih, nyia jaatrep jaatraang tenthun loong ih Rangte tiitkhaap ah matsiit ha, eno hetiik ah tadong tiik thukka. <verse number="20" style="v"/>Rukho mina rah raanjih hase ni wen arah likhiik. Rangte tiit ah chaat ano, naririh et kap ha, eno hetiik ah dong tiik: rukho ah rookjom, rukho ah rook arok, rukho ah chaasiit.”</para>
  <para style="s">Khoowaan mong ni weetook</para>
  <para style="r">(<ref loc="LUK 8:16-18">Luk 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">4:21 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:15">Mat 5:15</ref>; <ref loc="LUK 11:33">Luk 11:33</ref></char>
    </note>Jisu ih toombaat ruh ih rumta, “O ih bah uh weetook<note caller="+" style="f"><char style="fr" closed="false">4:21 </char><char style="fq" closed="false">ah: </char><char style="ft" closed="false">Weetook: Saaki</char></note> ah khoowaan mong ni adoleh juptheng khu nah nikah took ah? Weetook ah hethiin theng ni tanih katookka? <verse number="22" style="v"/><note caller="-" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="MAT 10:26">Mat 10:26</ref>; <ref loc="LUK 12:2">Luk 12:2</ref></char></note>Tumjaat hotthiin abah uh wuungsa nah dongjat ah, nyia ebokloop etta loong ah edaap et ah. <verse number="23" style="v"/>Boichaat an, sen na je abah ah!”</para>
  <para style="p">
    <verse number="24" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">4:24 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:2">Mat 7:2</ref>; <ref loc="LUK 6:38">Luk 6:38</ref></char>
    </note>Jisu ih amah nep ih baat rumta, “Marah chaat han sen ih naririh et samthun an! An ih mih mamet dande hu erah likhiik Rangte eh uh an emamah et dande ho—erah tokkhoh doh uh ehan thong et dande ho. <verse number="25" style="v"/><note caller="-" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="MAT 13:12">Mat 13:12</ref>; <ref loc="MAT 25:29">25:29</ref>; <ref loc="LUK 19:26">Luk 19:26</ref></char></note>Marah mih asuh amasah jeela erah suh ehan ih bootkoh ah, marah mih asuh tumjih uh tajeeka, erah mih dowa amasah jeela rah uh ethoon nge et ah.”</para>
  <para style="s">Raanjih wen tiitthaak</para>
  <para style="p">
    <verse number="26" style="v"/>Jisu ih jangbaat kaatta, “Rangte Hasong ah arah likhiik. Mih wasiit ih phek ni chamwen kaatla. <verse number="27" style="v"/>Rangwuung rangnak, heh jup ih koja oh saat ih koja oh, erah pootdi heh champhook ah haapphok ano toon hak ruh ela. Erah bah uh mamangla heh ih tajatka. <verse number="28" style="v"/>Hah heh heh ih hak thuk ano tiik thukla; jaakhothoon wotsuh phang edongla, eno kookchok ehoonla, erah lilih helak ah pa ano dongtiikla. <verse number="29" style="v"/>Eno cham ah men kano cham khante ah ih khothep ah pi ano cham ah khan kala, tumeah chamkhan tok ah chang kano ah.”</para>
  <para style="s">Miinjaangjih tiitthaak</para>
  <para style="r">(<ref loc="MAT 13:31-32">Mat 13:31-32</ref>; <ref loc="LUK 13:18-19">Luk 13:18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v"/>Jisu ih chengta, “Rangte Hasong asuh seng ih tumjih likhiik ih li ih?” “Tumjih tiitthaak nawa ih seng ih jangbaat theng ah? <verse number="31" style="v"/>Erah langla arah likhiik. Mih wasiit ih arah mongrep dowa loongtang nang ih ehinjih thoon miinjaangjih ah toon ano, hah ni wenkaatla. <verse number="32" style="v"/>Rekam lidi phook ano thoontang nang ih ehanthoon ih dong hakla. Eno hephook loong ah hak ano hephaak loong adi woh loong nep jen tepwang ah.”</para>
  <para style="p">
    <verse number="33" style="v"/>Jisu ih miloong asuh heh tiitkhaap ah jihoh tiitthaak loong nawa ih emamah ih toobaat rumta; neng ih mathan jen ih samjat rumta erah thanthan ih baattaan rumta <verse number="34" style="v"/>Heh ih tiitthaak toobaat muh ih tumjih uh tabaat rumta, Enoothong heliphante loong damdi heh luulu ang adi, tumjih suh liita erah hukbaat korumta.</para>
  <para style="s">Jisu ih pong aphaat semthukta</para>
  <para style="r">(<ref loc="MAT 8:23-27">Mat 8:23-27</ref>; <ref loc="LUK 8:22-25">Luk 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v"/>Erah saasa rangjaako di Jisu ih heliphante loong suh baat rumta, “Seng loong ah juungsitum saangko adoh daan kah ih.” <verse number="36" style="v"/>Erah thoidi neng ah miloong jiin nawa dokkhoom karumta; eno heliphante loong khoonkhuung ni Jisu bantong kata adi roong duungtong karumta, eno Jisu ah neng damdi waksiit kaat rumta. Khoonkhuung loong ehoh uh erah di eje angta. <verse number="37" style="v"/>Baphuk ih pong ah pongta, eno khoonkhuung mong adi juung ah waak wang eta, eno khoonkhuung ah juung ih eme nanah eta. <verse number="38" style="v"/>Jisu ah khoonkhuung liko adi khodang ah dang ano mokjupta. Heliphante loong ah ih saatsiit rum ano baat rumta, “Nyootte,<note caller="+" style="f"><char style="fr" closed="false">4:38 </char><char style="fq" closed="false">Nyootte</char><char style="ft" closed="false">mih suh hukbaatte, nyootsootte, nyia le nyootte </char></note> seng etek taat kah eli ah an ih tanih thun ri?”</para>
  <para style="p">
    <verse number="39" style="v"/>Jisu ah toonchap ano pong asuh baatta, “Sem uh!” eno juungtak asuh we baatta, “Sem uh!” Erah damdam pong ah laan semruh eta, Pong ah toopong ano, tikpakpak ehoonta. <verse number="40" style="v"/>Eno Jisu ih heliphante loong asuh liita, “Tume choolan? Amadi sen tuungmaang uh laje ah?”</para>
  <para style="p">
    <verse number="41" style="v"/>Eno neng loong ah rapne ih cho damdi neng chamchi ni roongwaan rumta, “Arah mih ah o angla? Pong nyia juungtak ih nep heh jeng chaatchaat ela ah!”</para>
  <chapter number="5" style="c"/>
  <para style="s">Jisu ih chiithih laakhah pan mih wasiit deesiitta</para>
  <para style="r">(<ref loc="MAT 8:28-34">Mat 8:28-34</ref>; <ref loc="LUK 8:26-39">Luk 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>Jisu nyia heliphante loong ah Galili juungsitum saangko Gerasa hadaang ni thok rumta. <verse number="2" style="v"/>Jisu khoonkhuung nawa dat khoom damdam mangbeng luung nawa wangha rah erah di mih wasiit chomuita. Erah mih sak adi chiithih laakhah pan <verse number="3" style="v"/>mangbeng ni tongte angta. O eh uh heh ah jaanruh ih takah jen tangkitta; <verse number="4" style="v"/>helak helah ah jaanruh ih taat kit rum abah uh helek helek jaanruh ah thahoom leh thaphui, emeleh heh lah ih soopnak kah eta. Heh rapne tathat ang thoidi mih ih tajen tangjota. <verse number="5" style="v"/>Heh rangwuung rangphe mangbeng theng ni nyia kaanjang ni katum khoomta eno leh tum riinghuung, heh teeteewah jong ih jopkhan.</para>
  <para style="p">
    <verse number="6" style="v"/>Jisu japtupta adi heh rekam loot ni angta; eno heh reeni soonkata, heh lakuh di Jisu ngathong adi chooktong kah ano, <verse number="7" style="v"/>erongwah ih riinghuungta, “Jisu, Echoong thoon ni tongte Rangte Sah! An ih tumjih ette ang halang? “Rangte mendoh, ngah nak thet haat weehang, ngah ih an lasih johala!” (<verse number="8" style="v"/>Heh ih arah jengkhaap ah Jisu ih “Chiithih laakhah dokkhoom ho ih li kano jengta!”)</para>
  <para style="p">
    <verse number="9" style="v"/>Eno Jisu ih chengta, “An men o ah?”</para>
  <para style="p">Erah mih rah ih ngaakbaatta, “Nga men ah ‘Ephoop’ —seng ah hantek!” <verse number="10" style="v"/>Chiithih laakhah loong ah arah juungkhuung dowa nak dokphan weeuh ih heh ih Jisu lasih ah laat joh ruh eta.</para>
  <para style="p">
    <verse number="11" style="v"/>Neng reeni kaanjang adi wak loong jook arah angta. <verse number="12" style="v"/>Erah thoidi chiithih laakhah loong ah ih Jisu lasih joh rumta, “Wak loong sak adoh kaat thuk weehe.” <verse number="13" style="v"/>Jisu ih kaat thuk rum kano, chiithih laakhah loong ah mina sak dowa doksoon ano wak loong sak adi nop karumta. Wak loong ah rooproop ih haajaat nyi taan angta, Erah loong ah thoontang doruk rum ano kaangkom dowa juungsitum adi lupdat karumta.</para>
  <para style="p">
    <verse number="14" style="v"/>Wak riimte loong ah erah dowa tiisoon rum ano erah ruurang ah hadaang rookwih nyia phek aphaang rookwih ni tumbaat wanrumta. Mina loong ah ih tumjih ang kola ih sokkah rumta, <verse number="15" style="v"/>eno neng Jisu jiinni ra rumha di, chiithih laakhah ephoop pan angta mih ah japtup rumta. Erah mih ah nyuh akhat rapne ne ih kap ano seklilih ih tong arah japtup karumta; eno neng ah echo ih rumta. <verse number="16" style="v"/>Chiithih laakhah pan mih nyia wak loong tupte loong ah ih, mamah angta erah loong tiit ah mih suh tumbaat rumta.</para>
  <para style="p">
    <verse number="17" style="v"/>Erah thoidi neng ih Jisu suh neng juungkhuung dowa soon uh ih baat rumta.</para>
  <para style="p">
    <verse number="18" style="v"/>Jisu khoonkhuung ni duungtong kata adi maangdi chiithih laakhah pan angta warah ih liita, “An damdoh ngah nep roong ra weehang!”</para>
  <para style="p">
    <verse number="19" style="v"/>Enoothong Jisu ih tawak siitkaatta. Erah nang ih bah, Jisu ih amet baatta, “An nok nah ngaakwang uno an jaatang suh thongbaat wan uh, Teesu ih an raang ih tumjih reeta nyia mathan minchan halu loong rah ah.”</para>
  <para style="p">
    <verse number="20" style="v"/>Erah thoidi erah wah ah Hah Asih<note caller="+" style="f"><char style="fr" closed="false">5:20 </char><char style="fq" closed="false">Hah Asih</char><char style="ft" closed="false">Hah asih ah Dekapolis asuh liita </char></note> adi kah ano Jisu tumjaat reeta loong ah tumbaat kaatta. Erah japchaatte loong ah rapne ih paatja rumta.</para>
  <para style="s">Jairas sah nyia Jisu nyuh taajote nuh</para>
  <para style="r">(<ref loc="MAT 9:18-26">Mat 9:18-26</ref>; <ref loc="LUK 8:40-56">Luk 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v"/>Jisu ah juungsitum saangko ni we ngaak daan kata. Erah juungsitum kaang adi miloong ah Jisu reeni thutthi rumta. <verse number="22" style="v"/>Jehudi rangsoomnok ni mootkaatte Jairas thok haano Jisu ah japtupta, eno Jisu ngathong ni kotbon kah ano <verse number="23" style="v"/>heh lasih ah jota, “Nga sah minusah rah rapne ih satla. An lak ih taajoh ra weeho, de ano ething toom tong we ah!”</para>
  <para style="p">
    <verse number="24" style="v"/>Eno Jisu ah heh damdi roong dokchap kata. Eno miloong ah uh Jisu damdi kookrak ih roong khoom karumta.</para>
  <para style="p">
    <verse number="25" style="v"/>Erah di minuh esiit asih paang nyi heh sih sik ih cham arah angta, <verse number="26" style="v"/>heh khoisat ah phonte loong suh noongrep ni taatsok thukta. Heh ngunteh loong ah thoon thaaja, erah bah uh ede lalek ih thang ih saarookwih ehan han ih boot satta. <verse number="27" style="v"/>Heh ih Jisu raak ah japchaat ano, miloong dung ni heh lilih ih roong kata, <verse number="28" style="v"/>heh teeteenuh ih thunta, “Ngah ih Jisu nyuh ah taajoh ang bah, ede eang.”</para>
  <para style="p">
    <verse number="29" style="v"/>Heh ih Jisu nyusah ah taajoh ano, heh sih sik ah laan mah ruh eta; eno heh teenuh ih uh ede elang ih laanjat ruh eta. <verse number="30" style="v"/>Jisu sak nawa khoisat de theng chaan kaat ah laanjat ruh eta, erah thoidi miloong ko ih lengsok ano cheng rumta, “Nga nyuh ah o ih taajoh tahang?”</para>
  <para style="p">
    <verse number="31" style="v"/>Heliphante loong ah ih ngaakbaat rumta, “An ih tup ih hu an reeni mina ephoop tuutmuula eah; mamet cheng hu o ih taajoh halang eah?”</para>
  <para style="p">
    <verse number="32" style="v"/>Enoothong Jisu ih heh taajote ah lengsok ruh eta. <verse number="33" style="v"/>Eno minuh rah ih heh khoisat deeta rah samthun ano echo damdi wangha no, heh lakuh di tong ano amiisak tiit loong ah dok baatta. <verse number="34" style="v"/>Jisu ih erah nuh asuh liita, “Nga sah, an tuungmaang ih deesiit taho. Khooteng ih tongwang uh, an chamnaang nawa ede etu.”</para>
  <para style="p">
    <verse number="35" style="v"/>Jisu ih erah baat tokdi, Jairas nok nawa ruurang baatte loong wang rum taha eno Jairas suh baat rumta, “An sah bah etek ela. Nyootte ah nak thaam hoom kuh?”</para>
  <para style="p">
    <verse number="36" style="v"/>Jisu ih neng tiitwaan ah laboichaat thang ih,<note caller="+" style="f"><char style="fr" closed="false">5:36 </char><char style="fq" closed="false">laboichaat thang </char><char style="ft" closed="false">eleek chaat asuh liita</char></note> Jairas suh baatta, “Nakcho uh, tuungmaang ba et uh.” <verse number="37" style="v"/>Eno Jisu ih ehanko miloong ah tang ano heh damdi Pitar, Jeems nyia heh no Joon ah ba siit kaatta. <verse number="38" style="v"/>Jairas nok ni thokrum adi miloong huung ariing nyia neng paattek ah japchaat karumta. <verse number="39" style="v"/>Jisu ah nopwang ano baat rumta, “Tume paatja lan?” “Tume huung lan? Noodek ah etek tah eka—emokjup boh ela!”</para>
  <para style="p">
    <verse number="40" style="v"/>Miloong ah ih Jisu ah ngit et rumta, eno Jisu ih neng loong ah dokphan rum ano, heh nuh nyia heh wah nyia heliphante wajom, noodek jupthiinta nokmong adi nopwang rumta. <verse number="41" style="v"/>Jisu ih noodek lak adi joh ano liita, <char style="it">“Talitha, Koum,” </char> erah langla, “Minusah, saat uh Ngah ih baat hala!”</para>
  <para style="p">
    <verse number="42" style="v"/>Erah damdam minusah ah toonchap ano laan khoom ruh eta. (Noodek ah asih paang nyi angta). Erah angta ah sok rum ano miloong ah rapne ih paatja rumta. <verse number="43" style="v"/>Enoothong Jisu ih arah tiit ah o suh uh labaat theng ih baat rumta, “Heh suh phaksat thong jam koh an.’</para>
  <chapter number="6" style="c"/>
  <para style="s">Najaret ni Jisu thaangjuuta</para>
  <para style="r">(<ref loc="MAT 13:53-58">Mat 13:53-58</ref>; <ref loc="LUK 4:16-30">Luk 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>Erah hadaang dowa Jisu ah dokkhoom kah ano, heliphante loong heh lilih ih heh hadaang ni roongwang rumta. <verse number="2" style="v"/>Jehudi naangtongsa rangwuung adi Jisu ih Jehudi rangsoomnok ni miloong asuh phang nyootsoot rumta, eno miloong ah ih erah chaat rum ano rapne ih paatja rumta; “Heh ih arah likhiik jeng ah ma nawa jen jat ha?” neng ih chengta. “Tumjih mongtham ih jen jatthuk ha? Erah than epaatjaajih mame jen reela? <verse number="3" style="v"/>Arah bangmaakwah<note caller="+" style="f"><char style="fr" closed="false">6:3</char><char style="fk" closed="false">Bangmaakwah</char><char style="ft" closed="false">Nok apung nyia juptheng tongtheng bang nawa ih hoonte asuh liiha</char></note> Meeri sah, Jeems, Josep, Judas nyia Simoon loong phoh ah tanih angka? Heh no minusah loong ani tongla ah tanih angka?” Eno neng ih Jisu ah thaangju ih rumta.</para>
  <para style="p">
    <verse number="4" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">6:4 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 4:44">Jn 4:44</ref>
      </char>
    </note>Jisu ih baat rumta, “Khowah ah langla noongrep nah soomtu ah, enoothong heh hadaang nah heh sano joonte nyia heh jaatang ih ba thaangju ah.”</para>
  <para style="p">
    <verse number="5" style="v"/>Erah di Jisu ih epaatjaatheng tumjih uh tami reeta, khoisatte heh lak ih taajota mararah loong ah ba deeta. <verse number="6" style="v"/>Miloong jiinni tuungmaang laje thoidi Jisu ah epaatja eta.</para>
  <para style="s">Jisu ih heliphante asih wanyi daapkaatta</para>
  <para style="r">(<ref loc="MAT 10:5-15">Mat 10:5-15</ref>; <ref loc="LUK 9:1-6">Luk 9:1-6</ref>)</para>
  <para style="p">Eno Jisu ah mih nok hah loong adi lengkhoom kah ano, nyootsoot karumta. <verse number="7" style="v"/>Heliphante asih wanyi ah lompoon ano wanyi wanyi et daapkaatta. Neng suh chiithih laakhah loong dokphan suh chaan ah korum <verse number="8" style="v"/>ano baat rumta, “Erah kah andoh sen sak nah tumjih uh nak hui an, kiingthom luulu ba pi an phaksat uh lahuitheng, kunma khaak uh lahuitheng, sen khaakdaap nah ngun uh lauitheng. <verse number="9" style="v"/>Sen lakhoop ba khoop an enoothong samsong hedak lahuitheng.” <verse number="10" style="v"/>Jisu ih wakbaat rumta, “Marah nok adoh noppoon han, erah nok adoh erah dowa maang dokkhoom khoom ih tong an. <verse number="11" style="v"/><note caller="-" style="x"><char style="xo" closed="false">6:11 </char><char style="xt" closed="false"><ref loc="ACT 13:51">Esm 13:51</ref></char></note> <note caller="-" style="x"><char style="xo" closed="false">6:11 </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">Luk 10:4-11</ref></char></note>Sen samnuh nah raahan doh marah doh sen tanoppoon ran nyia sen jeng laboichaat ranbah, sen lah dowa bungwiik ah jaanak anno dokkhoom an. Erah neng raangtaan ih ethih ang ah!”</para>
  <para style="p">
    <verse number="12" style="v"/>“Erah dowa neng ah dokkhoom karum ano mina ah rangdah nawa lek etheng ih tumbaat kaat rumta. <verse number="13" style="v"/><note caller="-" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JAS 5:14">Jms 5:14</ref></char></note>Neng ih chiithih laakhah hantek dokphan karumta, eno Olib bangthiing ih hut leh khoisatte hantek deesiit rumta.</para>
  <para style="s">Juungtemte Joon tiita</para>
  <para style="r">(<ref loc="MAT 14:1-12">Mat 14:1-12</ref>; <ref loc="LUK 9:7-9">Luk 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">6:14,15 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:14">Mat 16:14</ref>; <ref loc="MRK 8:28">Mk 8:28</ref>; <ref loc="LUK 9:19">Luk 9:19</ref></char>
    </note>Eno Hirod<note caller="+" style="f"><char style="fr" closed="false">6:14 </char><char style="fk" closed="false">Hirod luungwang</char><char style="ft" closed="false">Entipas Hirod Galili pante</char></note> luungwang ih erah ruurang loong ah japchaatta, tumeah Jisu men ah noongrep ni phoongpha rumta. Mararah ih liita, “Juungtemte Joon ah ngaakthingla! Erah thoidi epaatjaajih loong jen re theng chaan ah jeela.”</para>
  <para style="p">
    <verse number="15" style="v"/>Rukho eh liirumta, “Heh Elija.”</para>
  <para style="p">Rukho eh li rumta, “Heh ah Khowah, teewah dowa khowah loong ah likhiik heh uh esiit.”</para>
  <para style="p">
    <verse number="16" style="v"/>Eno Hirod ih erah japchaat ano liita, “Heh ah Juungtemte Joon ah, ngah ih heh khoh ah thah thuktang ah, heh ah we ngaakthingla!” <verse number="17" style="v"/><note caller="-" style="x"><char style="xo" closed="false">6:17,18 </char><char style="xt" closed="false"><ref loc="LUK 3:19">Luk 3:19</ref>,<ref loc="LUK 3:20">20</ref></char></note> Hirod heh teeteewah ih Juungtemte Joon ah jokhak thukta, eno kit ano phaatak ni sak thukta. Hirod ih heh ih kapta Hirodias tungthoidi khak thukta, heh minuh ah langla heh no Philip minuh ang dowa. <verse number="18" style="v"/>Juungtemte Joon ih Hirod suh banbaat ruh taat kah eta, “An no minuh abah tami kapko eah!”</para>
  <para style="p">
    <verse number="19" style="v"/>Erah thoidi Hirodias ih Joon ah tek haat et suh rapne ih khah ano dongthunta, erah bah uh Hirod tungthoidi tami tek haatta. <verse number="20" style="v"/>Hirod ah Joon ra echo eta tumeah heh ih jat etta Joon ah mih sek nyia esa moong achaangte angta, rah thoidi Joon ah piita. Hirod ih heh tiitwaan ah chaat rookwih heh thung ah phaangdat eta, ang abah uh heh jeng ah nook boichaat ruh eta.</para>
  <para style="p">
    <verse number="21" style="v"/>Lini Joon tek haat suh Hirodias raangtaan saapoot ese thok taha. Hirod tup rangwuung sa di mathan apit nawa saahaap loong ah, Sipaahi saahaap, nyia Galili dowa elong elang loong ah heh tup rangwuung sadung ni poon rumta. <verse number="22" style="v"/>Erah sa adi Hirodias<note caller="+" style="f"><char style="fr" closed="false">6:22</char><char style="fq" closed="false">Hirodias sah </char><char style="ft" closed="false">mararah le adi heh sah minuh sah Hirodias ih raangha</char></note> sah minusah ah boongwangta, eno erah sok rum ano Hirod nyia heh wenwah loong ah neng ten rapne ih roon rumta. Erah thoidi luungwang ih erah sah asuh chengta, ‘An tumjih suh nooklu? Ngah dowa tumjaat suh hang erah koha.” <verse number="23" style="v"/>Hirod luungwang ih minusah asuh kakhamta, “Ngah ih kakham hala an ih tumjih jam uh erah koha, ngah ih panhang hadaang thotliiko anep jen koha!”</para>
  <para style="p">
    <verse number="24" style="v"/>Eno minusah ah doksoon kah ano heh nuh suh cheng kaatta, “Ngah ih tumjih suh ang?”</para>
  <para style="p">“Juungtemte Joon khoh ah suh uh, ih heh nuh ih baatta.”</para>
  <para style="p">
    <verse number="25" style="v"/>Minusah ah echaan ih we ngaak wang ano luungwang dowa suta, amamah ih khuung nah Juungtemte Joon khoh ah kohang!”</para>
  <para style="p">
    <verse number="26" style="v"/>Erah jengkhaap ah chaat ano luungwang ah rapne ih thungthita, ang abah uh heh wenwah loong ngathong ni kakham choi ang thoidi tajen daanta. <verse number="27" style="v"/>Erah thoidi ra bante loong asuh Joon khoh ah laan thah kah ruh ih thukta. Raabante ah phaatak ni kah ano Joon khoh ah thadook kata; <verse number="28" style="v"/>eno minusah asuh khuung ni pi kowanta eno heh nuh asuh toom kota. <verse number="29" style="v"/>Joon liphante loong ah ih erah chaat rum ano, heh mang ah toonpi wang rum ano beng kaat rumta.</para>
  <para style="s">Jisu ih haajaat banga mih suh phaksat kota</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mat 14:13-21</ref>; <ref loc="LUK 9:10-17">Luk 9:10-17</ref>; <ref loc="JHN 6:1-14">Jn 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v"/>Heh Kaamwah loong ah Jisu jiinni ngaak chomui wang rum ano, neng ih nyootsootta nyia reeraang karumta loong ah heh suh baatwan rumta. <verse number="31" style="v"/>Erah di miloong ewang ekaatte ephoop ang thoidi Jisu nyia heliphante loong ah neng phaksat saapoot taan uh tachoh rumta. Erah thoidi Jisu ih baat rumta, “Seng hatik nah chomre naangtong kah ih.” <verse number="32" style="v"/>Eno neng ah khoonkhuung adi duungtong rum ano hatik adi neng kaatkaat ih rumta.</para>
  <para style="p">
    <verse number="33" style="v"/>Erabah uh miloong ah ih neng doksoon ela ih laanjat ruh ih rumta; erah thoidi harep nawa soonkah rum ano Jisu nyia heliphante loong maang thokdi neng lah ih neng ngah ni erah hah di jen banthok ih karumta. <verse number="34" style="v"/><note caller="-" style="x"><char style="xo" closed="false">6:34 </char><char style="xt" closed="false"><ref loc="NUM 27:17">Erok 27:17</ref>; <ref loc="1KI 22:17">1Lu 22:17</ref>; <ref loc="2CH 18:16">2Tet 18:16</ref>; <ref loc="EZK 34:5">Ijk 34:5</ref>; <ref loc="MAT 9:36">Mat 9:36</ref></char></note> Khoonkhuung nawa Jisu datchap adi miloong hantek, saapriimte muh saapsah likhiik et sok rum ano heh minchan dongta. Eno heh ih erah miloong asuh jirep tiit loong ah phang nyootsoot rumta. <verse number="35" style="v"/>Rangsa ah tham kano, heliphante loong ah heh reeni wang rum haano baat rumta, “Seng jen tham eli eno arah hah ah hatik ni. <verse number="36" style="v"/>Miloong ah kaat etthuk uh, neng phaksat ah nokphoh nokno nawa nyia phek aphaang nawa nengneng ih toom jam reh phaksah karum ah.”</para>
  <para style="p">
    <verse number="37" style="v"/>Jisu ih ngaakbaat rumta, “Sensen ih neng suh phaksat ah jam koh an.”</para>
  <para style="p">Neng ih Jisu suh chengta, “Seng ih ngunkholok chaanyi taan ih baanlo ah reh ih no miloong asuh kottheng tam et liihu?”</para>
  <para style="p">
    <verse number="38" style="v"/>Eno Jisu ih cheng rumta, “Sen jiinni baanlo mathan ah? Sokkah an.”</para>
  <para style="p">Neng ih sokkah rum ano baat rumta, “Baanlo banga nyasi enyi.”</para>
  <para style="p">
    <verse number="39" style="v"/>Jisu ih heliphante loong suh baatta, miloong ah naam khoh adoh hedung hedung et tongthuk an. <verse number="40" style="v"/>Eno miloong ah dungsiit ni chaasiit, dungsiit ni rook banga, ih pheetong thuk rumta. <verse number="41" style="v"/>Eno Jisu ih baanlo banga nyia nyasi enyi ah toonpi ano rangko ih toonsok ano, Rangte suh lakookmi liita. Heh ih baanlo ah chepphiit ano heliphante loong suh koh ano, miloong asuh pheekokaat thuk rumta. Nyasi enyi ah uh emamah loongtang suh pheekoh thuk rumta. <verse number="42" style="v"/>Loongtang ih neng wok laanphoot ruh et phaksah rumta. <verse number="43" style="v"/>Heliphante loong ih asih hongnyi baanlo nyi nyasi dak phaksata rah toon rumta. <verse number="44" style="v"/>Phaksatte miwah loong ah erah di haajaat banga mina angta.</para>
  <para style="s">Jisu juung khoni khoomta</para>
  <para style="r">(<ref loc="MAT 14:22-33">Mat 14:22-33</ref>; <ref loc="JHN 6:15-21">Jn 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v"/>Erah damdam ih heliphante loong ah khoonkhuung ni duungtong thuk ano juungsitum saangko Betsaida hadaang ko ni, heh ngani ban kaatthuk rumta. Erah pootdi heh ih miloong ah pheekhoom thuk rumta. <verse number="46" style="v"/>Miloong damdi raajeng lidi heteewah ah kongchoong ni rangsoom wangta. <verse number="47" style="v"/>Rangja ang damdam khoonkhuung ah juungsitum laktung ni angta, Jisu ah heh laklak saang ni angta. <verse number="48" style="v"/>Jisu ih heliphante loong ah pong pong damdi chamthih naangkhah ih khoonkhuung daanjop arah japtup rumta. Rangkhano chichuruh saapoot ejom nyia arok chamchi ni Jisu ah neng jiinko juung khoni khoom kata. Eno neng re ni thokkhoom nanah di, <verse number="49" style="v"/>Jisu juung khoni khoom arah sok rumta. “Erah jook!” Neng ih mokthun rumta, eno toonriing rumta. <verse number="50" style="v"/>Heh ah sok rum ano thoontang cho rumta.</para>
  <para style="p">Erah damdam Jisu neng damdi waanta, “Sen tenchaan an!” Heh ih baatta “Ngah hanih. Nakcho an!” <verse number="51" style="v"/>Erah dowa ih neng damdi khoonkhuung ni roong duungtong wangta, eno lakdamdam di pong ah laan semdat ruh eta. Heliphante loong ah rapne ih paatja rumta, <verse number="52" style="v"/>tumeah neng ih haajaat banga mina suh phaksat jen kota tiit ah tajen samjat rumta; nengthung nengtak ni tali thun rumta.</para>
  <para style="s">Genisaret ni Jisu ih khoisatte loong deesiitta</para>
  <para style="r">(<ref loc="MAT 14:34-36">Mat 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v"/>Neng ih juungsitum ah daan rum ano Genisaret hah adi thok rumta, eno erah di neng khoonkhuung ah tangtuk rumta. <verse number="54" style="v"/>Khoonkhuung nawa dat khoom rum adi, miloong ah ih Jisu ah laanjat ruh ih rumta. <verse number="55" style="v"/>Erah thoidi miloong ah erah juungkhuung rep ni tumsoon rumta; marah di Jisu eje ih japchaat rumta erah di khoisatte loong ah dam khoni thokpi rumta. <verse number="56" style="v"/>Eno Jisu ah noongrep ni kata, hadaang ni, samthung ni, adoleh phek aphaang ni, eno miloong ah ih khoisatte loong ah thaangtaam theng ni thokpi rumta, eno khoisatte loong ah heh nyuh kaangba adoh taan jap taajoh suh heh lasih joh rumta. Eno mathan ih taajoh rumta loong ah thoontang de ih rumta.</para>
  <chapter number="7" style="c"/>
  <para style="s">Te awah banlam</para>
  <para style="r">(<ref loc="MAT 15:1-9">Mat 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>Pharisi nyia Hootthe nyootte loong Jerusalem nawa ra rum taha loong ah Jisu jiinni thok kookchap rum taha. <verse number="2" style="v"/>Pharisi loong ih Jisu liphante loong mararah ih neng lak enyaan ih phaksah arah jatjoh rumta erah langla neng laktiimuh ih phaksah rumta eno erah ah Pharisi loong ih kah nyoot rumta jun ih tah angta.</para>
  <para style="p">(<verse number="3" style="v"/>Pharisi, nyia Jehudi, nok hah ih nengte nengwah ih nyootta banlam ah phan rumta: neng ih laktiimuh ih laphaksat jih, <verse number="4" style="v"/>adoleh thaangsang theng nawa tumjaat thok huiha bah uh jaakhoh saachot muh doh tajen phaksata.<note caller="+" style="f"><char style="fr" closed="false">7:4 </char><char style="fq" closed="false">thaangsang theng nawa tumjaat thok huiha bah uh jaakhoh saachot muh doh tajen phaksata</char><char style="ft" closed="false">adoleh</char><char style="fq" closed="false">thaangsang theng nawa wang rumha no neng sakchaak sachot rumta </char></note> Erah damdi uh neng ih ephoop teewah banlam loong ah phan rumta, Jengthaak ih lookkep khaplang, khuung akhaak nyia juptheng<note caller="+" style="f"><char style="fr" closed="false">7:4 </char><char style="fq" closed="false">juptheng </char><char style="ft" closed="false">mararah le adi taraangka</char></note> loong ah uh saachot muh ih tamaak rumta.)</para>
  <para style="p">
    <verse number="5" style="v"/>Erah raangtaan ih Pharisi nyia Hootthe nyootte loong eh Jisu suh cheng rumta, “An liphante loong ih sengte sengwah ih kota banlam ah laphan mamet rumha, neng laktiimuh ih mamet phaksah rumha?”</para>
  <para style="p">
    <verse number="6" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">7:6,7 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 29:13">Isa 29:13</ref> (LXX)</char>
    </note>Jisu ih ngaakbaat rumta, “Isaia ih sen loong tiit ah mamet punbaat kota! Heh ih raangthiinta likhiik sen loong ah lonoite:</para>
  <para style="q1">‘Rangte ih liita, arah miloong eh bah, neng tuikhoop nawa ih soomtu rumhang,</para>
  <para style="q2">amiimi doh bah neng tenthun ah nga jiin nawa haloh dook ang ah.</para>
  <para style="q1">
    <verse number="7" style="v"/>Nga rangsoom rumha ah thaangmuh ang ah,</para>
  <para style="q2">tumeah neng eh mina ih hoon arah Hootthe ah nyoot rumha.</para>
  <para style="q2">Nga Hootthe ang arah likhiik ah!’</para>
  <para style="p">
    <verse number="8" style="v"/>“Sen ih Rangte jengdang ah thiinhaat anno mina ih nyootsoot ha ah kap han.”</para>
  <para style="p">
    <verse number="9" style="v"/>Jisu ih toombaat ruh etta, “Sen ih Rangte hootthe ah mongwah maakwah tenthun lam ih dut haat han eno sen ih nyootsoot han banlam ah toonjoh han. <verse number="10" style="v"/><note caller="-" style="x"><char style="xo" closed="false">7:10</char><char style="xt" closed="false"><ref loc="EXO 20:12">Hpkt 20:12</ref>; <ref loc="DEU 5:16">Hodb 5:16</ref>; <ref loc="EXO 21:17">Hpkt 21:17</ref>; <ref loc="LEV 20:9">Lew 20:9</ref></char></note>Moses jengdang ni raangta, ‘Annuh anwah jengkhaap ah echaat etheng,’ erah damdi, ‘O ih heh nuh heh wah suh jengthih jengla erah etek haat etheng.’ <verse number="11" style="v"/>Enoothong sen ih amet nyoot han, heh nuh heh wah chosok suh tumjih tumjih je abah, heh ih liita ‘Arah Korban’ (erah langla Rangte lakbi), <verse number="12" style="v"/>Erah likhiik sen Pharisi loong ah ih sennuh senwah lajap sokboi suh liitan. <verse number="13" style="v"/>Emamah sen ih wahoh loong asuh ki nyootsoot anno Rangte jengkhaap ah takap thuk kan. Erah damdi uh jaatrep sen ih emamah moong reeraang kah anrah ephoop je ah.”</para>
  <para style="s">Mina esot ih hoon thukte</para>
  <para style="r">(<ref loc="MAT 15:10-20">Mat 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v"/>Eno Jisu ih miloong ah we lompoon rum ano baatta, “Loongtang ih, nga jeng ah boichaat anno, samjat et an. <verse number="15" style="v"/>Tumjih bah uh sen sak ni rangkhoh nawa wangla rah ih sen ah tanyaan siit ran. Erah nang ih senten senmong nawa ra hala rah ih thong nyaansiit halan.”<note caller="+" style="f"><char style="fr" closed="false">7:15 </char><char style="ft" closed="false">Mararah le adi wet hin 16 ah tawak raangka</char><char style="fq" closed="false">Sen na je abah, chaat et an</char></note> <verse number="16" style="v"/>Sen na je anbah, chaat et an!</para>
  <para style="p">
    <verse number="17" style="v"/>Midung nawa heh nok ni wangta adi, heliphante loong ah ih tiitthaak ah tumjih suh liita rah hukbaat suh cheng rumta. <verse number="18" style="v"/>“Sen ah mihoh loong nang ih jatwah maakwah taboh angkan,” Jisu ih liirumta. “Sen ih tanih samjat kan? Sen sak ni rangkhoh nawa wangla rah ih bah amiimi di tanyaan siit ran, <verse number="19" style="v"/>tumeah erah sen ten ni tawangka wok ni ba wangla eno ewe ngaakkaat ela.” (Erah jen baat ano Jisu ih jaatrep phaksat ejen phaksah et ah ih dokbaat korumta.)</para>
  <para style="p">
    <verse number="20" style="v"/>Eno Jisu ih boot baat rumta, “Sen ten nawa tumjaat dong ra hala rah ih ba thetsiit halan. <verse number="21" style="v"/>Tumeah sen mong nawa ethih mongtham dong hala rah ih, sen ah jootthih mootkaat ni siit halan, mih put tenthun, etek haat tenthun, <verse number="22" style="v"/>mih minuh miwah damdoh roomjup tenthun, nyamnyook tenthun, nyia jaatrep ethih loong tenthun; mookwaan mui tenthun, lapun lalam tenthun, miksuk mui tenthun, mih thetbaat tenthun, engaampo tenthun, nyia elang lalang ih reeraang tenthun loong adi siit halan— <verse number="23" style="v"/>erah ethih tenthun loong ah sen ten seng mong nawa dong hala eno sen ah enyaan ih hoon thuk halan.”</para>
  <para style="s">Minuh tuungmaang</para>
  <para style="r">(<ref loc="MAT 15:21-28">Mat 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v"/>Eno Jisu erah dowa dokkhoom ano Tairi samnuthung re ko ih kata. Nok esiit ni heh ah nop wangta eno heh erah di oih uh naktoom jat ah ih thunta, ang abah uh heh tajen hottongta. <verse number="25" style="v"/>Minuh esiit, heh sah minusah sak ni chiithih laakhah pan ang arah, ih Jisu raak ah chaat ano echaan ih heh lathong ni kotbon kata. <verse number="26" style="v"/>Erah nuh rah hahote angta Phonisia deek Siria hadaang ni tup arah ah. Minuh rah ih heh sah sak nawa chiithih laakhah rah dokphan raangtaan ih Jisu lasih ah jota. <verse number="27" style="v"/>Eno Jisu ih ngaakbaatta, “Jaakhoh noodek asuh phaksat raang kottheng. Noodek phaksat ah nge ano hui suh haatkoh ah tapunka.</para>
  <para style="p">
    <verse number="28" style="v"/>“Minuh ah ih ngaak liita, “Chuupha,” “Teebun nawa phaksat thaaja arah botseh hui ih katoon sah ah!”</para>
  <para style="p">
    <verse number="29" style="v"/>Eno Jisu ih minuh asuh liita, “Epun baat et hu, an nok nah ngaak wang uh, an sah sak nawa chiithih laakhah rah doksoon cho tupwang uh!”</para>
  <para style="p">
    <verse number="30" style="v"/>Eno erah nuh ah nok ni wang ano heh sah ah juptheng ni jup arah japtup wangta; chiithih laakhah rah heh sak nawa doksoon cho angta.</para>
  <para style="s">Jisu ih engong ebaang deesiitta</para>
  <para style="p">
    <verse number="31" style="v"/>Eno Jisu Tairi hadaang re ko nawa dokkhoom ano Sidoon lam ih Galili juungsitum ko ni nyia Samthung Hah Asih<note caller="+" style="f"><char style="fr" closed="false">7:31</char><char style="fq" closed="false">Hah Asih</char><char style="ft" closed="false">Hah asih ah Dekapolis asuh liita</char></note> ko ih kata. <verse number="32" style="v"/>Erah di mararah ih Jisu reeni naabaang nyia jengtah ang arah siitjah rum taha, eno Jisu suh an lak ih taajoh weeuh ih heh lasih joh rumta. <verse number="33" style="v"/>Erah thoidi Jisu ih midung nawa heh laklak ih doksiit kaatta, eno heh laktiik ih heh na adi kepta, heh took ah phoh ano heh tuihih adi taajota. <verse number="34" style="v"/>Eno Jisu ah rangko ih toonsok ano, thungthet lam ih erah mih asuh liita, <char style="it">“Ephphatha,”</char> erah langla “Laang uh!” ih liita.</para>
  <para style="p">
    <verse number="35" style="v"/>Erah damdam heh na ah laangta, heh jeng uh laangloolo ih miijengta, eno latanyah thang ih waantiitta. <verse number="36" style="v"/>Jisu ih erah tiitwaan ah o suh uh nak baat an ih miloong asuh baat rumta; erah bah uh mathan taat haam ah, erah thanthan ih jaawaan karumta. <verse number="37" style="v"/>O mina ih japchaatta loong ah rapne ih paatja rumta. “Erathan mame jen re la!” neng ih liita. “Engong nyia naabaang anep jen jeng thuk ha nyia jen chaat thuk ha!”</para>
  <chapter number="8" style="c"/>
  <para style="s">Jisu ih haajaat baji mina suh kota</para>
  <para style="r">(<ref loc="MAT 15:32-39">Mat 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>Rekam ritdi erah di miloong dunghoh we thok khoon rumta. Nengdi phaksat theng laje thoidi, Jisu ih heliphante loong ah we khoonpoon ano baat rumta, <verse number="2" style="v"/>“Ngah arah mina loong asuh rapne ih thungthih lang, neng nga damdi sa jom roongtong rumhala, erah mong adi neng phaksat ah thoon ela. <verse number="3" style="v"/>Miloong ah neng nok nah phaksat muh mok ngaakdaap ang bah, lam nah neng lethaap wang rum ah, tumeah rukho ah haloot nawa thok ra rum taha.”</para>
  <para style="p">
    <verse number="4" style="v"/>Heliphante loong ih chengta, seng ih arah than mina asuh arah likhiik woma mong nah ma nawa phaksat ma jen jam koh ih?</para>
  <para style="p">
    <verse number="5" style="v"/>Jisu ih cheng rumta, “Sen jiinni baanlo mathan ah?”</para>
  <para style="p">“Lo sinet,” neng ih ngaakbaat rumta.</para>
  <para style="p">
    <verse number="6" style="v"/>Eno heh ih miloong asuh hah nah pheengtong an ih baat rumta. Heh ih lo sinet baanlo ah toon ano, Rangte suh lakookmi li ano, chepphiitta. Eno heliphante loong asuh pheekokaat thukta. <verse number="7" style="v"/>Erah damdi nyasi amasah angta nep, Jisu ih lakookmi li ano we pheekoh kaat thukta. <verse number="8-9" style="v"/>Warep ih neng wok laanphoot ruh ih phaksah rumta erah di mih ah haajaat baji taan ang rumta. Eno heliphante loong ah ih hong sinet dakta rah lomtoon rumta. Jisu ih miloong ah ngaakkaat thuk rum ano <verse number="10" style="v"/>heh uh erah damdam heliphante loong damdi khoonkhuung ni roong dungtong wangta eno Dalmanutha hadaang ko ih karumta.</para>
  <para style="s">Pharisi loong ih epaatjaajih jam rumta</para>
  <para style="r">(<ref loc="MAT 16:1-4">Mat 16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">8:11 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:38">Mat 12:38</ref>; <ref loc="LUK 11:16">Luk 11:16</ref></char>
    </note> Mararah Pharisi loong ah Jisu jiinni thokrum ano heh damdi daanmui karumta. Neng ih heh jeng ah mat ih joot suh ih thun rum ano, baat rumta, Rangte ah elang ekah ih jat suh seng suh epaatjaajih ah noisok he. <verse number="12" style="v"/><note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 12:39">Mat 12:39</ref>; <ref loc="LUK 11:29">Luk 11:29</ref></char></note> Eno Jisu ah ekhat damdi thungthih ano liita, “Ahaangwa mina loong ah ih epaatjaajih ah mamet jam rumha?” Ngah ih baat rumhala! A likhiik mina loong asuh epaatjaajih tanoisok kang!”</para>
  <para style="p">
    <verse number="13" style="v"/>Eno heh neng re nawa dokkhoom ano, khoonkhuung ni ngaak tong wangta eno juung saangko ih daan karumta.</para>
  <para style="s">Pharisi loong to nyia Hirod</para>
  <para style="r">(<ref loc="MAT 16:5-12">Mat 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v"/>Heliphante loong ih phaksat ehan et hui ah beehaat et rumta, khoonkhuung ni ang rum adi baanlo lo siit laklak ba dakta. <verse number="15" style="v"/><note caller="-" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="LUK 12:1">Luk 12:1</ref></char></note>“Naririh ih ban tong an,” Jisu ih dangdang ih baat rumta, “Maama teewah naririh ih ban sok an Pharisi to nyi Hirod dowa pui suh ah.”</para>
  <para style="p">
    <verse number="16" style="v"/>Heliphante loong ah neng jaachi ni phang tuwaan rumta: “Heh ih baanlo lahu koke no baat hali arah ah.”</para>
  <para style="p">
    <verse number="17" style="v"/>Jisu ih jat etta neng waantiit rumta rah ah, eno heh ih cheng rumta, “Phaksat laje thoih tumte nang waantiit lan? Amadi uh sen ih maang nih jatkan? Sen thungko tam ang lan? <verse number="18" style="v"/><note caller="-" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="JER 5:21">Jer 5:21</ref>; <ref loc="EZK 12:2">Ijk 12:2</ref>; <ref loc="MRK 4:12">Mk 4:12</ref></char></note>Sen mik je choidi tatam tupkan? Sen na je choidi uh tatam chaat kan? Tanih jen samthun kan <verse number="19" style="v"/>ngah ih baanlo banga dowa ih haajaat banga mina suh jen khom kotang rah ah? Sen ih hedak ah hongboot mathan toon tan?”</para>
  <para style="p">“Asih hongboot nyi,” neng ih ngaakbaatta.</para>
  <para style="p">
    <verse number="20" style="v"/>“Erah damdi baanlo sinet dowa reh haajaat baji mina suh kotang adi mathan dakta?” Jisu ih cheng rumta.</para>
  <para style="p">“Hong sinet” neng ih ngaakbaatta.</para>
  <para style="p">
    <verse number="21" style="v"/>“Eno sen ih amadi uh erah maang nih jatkan?” Heh ih cheng rumta.</para>
  <para style="s">Betsaida ni edook wasiit deesiitta</para>
  <para style="p">
    <verse number="22" style="v"/>Neng Betsaida hadaang ni thokrum adi mararah ih mikdook wasiit thoksiit rum taha, eno edook ah taajoh weeuh ih Jisu lasih joh rumta. <verse number="23" style="v"/>Jisu ih heh lak ni toonhoom ano erah hadaang dowa doksiit kaatta. Heh mik adi Jisu ih heh took ih phoh ano, heh lak ih taajoh eno chengta, “Amadi japtup tam et hu?”</para>
  <para style="p">
    <verse number="24" style="v"/>Eno edook warah ih toonsok ano baatta, “Tup ehang, ngah ih miloong anep tup hang, enoothong samsek latup thang ih bang loong khoomla likhiik et sok hang.”</para>
  <para style="p">
    <verse number="25" style="v"/>Eno Jisu ih heh mik adi we taajota. Erah dowa reh heh mik ah naririh ih ngaak singta, jaatrep wuungsing wuungla et tupta. <verse number="26" style="v"/>Jisu ih heh nok ni amet baat ano wang thukta, “Hadaang adoh nak ngaak wang uh joh.”</para>
  <para style="s">Jisu tiit Pitar ih dokbaatta</para>
  <para style="r">(<ref loc="MAT 16:13-20">Mat 16:13-20</ref>; <ref loc="LUK 9:18-21">Luk 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v"/>Erah lidi Jisu nyia heliphante loong Kaisaria Philipi hadaang ko loong reeni wang rumta adi lam ni chengwan rumta. “Baat he mih ih Ngah suh o kah ih li rumhang?”</para>
  <para style="p">
    <verse number="28" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">8:28 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 6:14">Mk 6:14</ref>,<ref loc="MRK 6:15">15</ref>; <ref loc="LUK 9:7">Luk 9:7</ref>,<ref loc="LUK 9:8">8</ref></char>
    </note>Neng ih ngaakbaatta, “Rukho ih li halu Juungtemte Joon,” “Rukho ih li halu Elija, rukho ih khowah dung dowa esiit et li halu.”</para>
  <para style="p">
    <verse number="29" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">8:29 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 6:68">Jn 6:68</ref>,<ref loc="JHN 6:69">69</ref></char>
    </note>“Sen ih tumjih li hali?” Jisu ih cheng rumta. “O et liihe ngah suh ah?”</para>
  <para style="p">Pitar ih ngaakbaatta, “An ah Kristo.”</para>
  <para style="p">
    <verse number="30" style="v"/>Eno Jisu ih baat rumta, “Ngah tiit ah o suh uh nak baat an.”</para>
  <para style="s">Jisu ih heh chamnaang nyia heh tektiit baatta</para>
  <para style="r">(<ref loc="MAT 16:21-28">Mat 16:21-28</ref>; <ref loc="LUK 9:22-27">Luk 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v"/>Eno Jisu ih heliphante loong asuh phang nyootsoot rumta: “Mina Sah abah rapne ih chamte angla eno mihak phokhoh loong, romwah phokhoh loong nyia Hootthe nyootte loong rah ih thaangju rumte. Heh ah tek haat et rum ah, enoothong sa jom lidoh we ngaakthing eah.” <verse number="32" style="v"/>Heh ih neng suh samsek et baat korumta. Eno Pitar ih hiiksiit kaat ano Jisu ah kanjaata. <verse number="33" style="v"/>Enoothong heliphante ko ih leksok ano, Jisu ih Pitar ah we kanjaata, “Soon uh Soitaan,” Heh ih liita. “An tenthun Rangte jiin nawa tah angka mina jiinko nawa!”</para>
  <para style="p">
    <verse number="34" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">8:34 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:38">Mat 10:38</ref>; <ref loc="LUK 14:27">Luk 14:27</ref></char>
    </note>Eno Jisu ih heliphante nyia miloong ah heh jiinni poon rum ano baatta, “Marah mina nga damdoh wangsuh nok lan,” “Erah mina rah ih heteewah ah beehaat etheng, heh tek ra lacho thang ih nga lih phan theng. <verse number="35" style="v"/><note caller="-" style="x"><char style="xo" closed="false">8:35 </char><char style="xt" closed="false"><ref loc="MAT 10:39">Mat 10:39</ref>; <ref loc="LUK 17:33">Luk 17:33</ref>; <ref loc="JHN 12:25">Jn 12:25</ref></char></note>Tumeah senteewah roidong piipang suh thun anbah, sen emat haat et an; enoothong sen roidong ah nga raangtaan nyia ruurang ese raang ih mat haat anbah epui ean. <verse number="36" style="v"/>Mina ih mongrep hadaang adoh jaatrep ah kapjap ano, heh roidong ah maat haat abah tumjih choh ah? Tumjih uh tachoka! <verse number="37" style="v"/>Heh roidong ngaakchosuh heh ih kottheng tumjih uh tajeeka. <verse number="38" style="v"/>O mina ngah suh nyia ngah ih nyootsoot hang asuh erakri ela arah rangkuh thih nyia Rangte lajat hadaang adi ah, erah ang abah Mina Sah rah uh Heh wah chaan aphaan nyia toongtang rangsah loong damdoh raaha doh erah mih ah raangtaan ih rakri eah.”</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>Eno we boot baat rumta, “Ngah ih baat rumhala, Rangte Hasong chaan aphaan lam ih raaha ah maang japtup ngah khoh nah arah dowa rukho ah maang tekte eje ang an.”</para>
  <para style="s">Phaakjaaja elekta</para>
  <para style="r">(<ref loc="MAT 17:1-13">Mat 17:1-13</ref>; <ref loc="LUK 9:28-36">Luk 9:28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">9:2-7 </char>
      <char style="xt" closed="false">
        <ref loc="2PE 1:17">2Ptr 1:17</ref>,<ref loc="2PE 1:18">18</ref> </char>
    </note>Sa arok lini Jisu ih Pitar, Jeems nyia Joon ah siit ano, kongchoong ni neng luulu wang rumta. Neng miksok di Jisu, ah choocho ih lek arah sok rumta, <verse number="3" style="v"/>henyuh hekhat ah pungkoopkoop ih dong phaakta erah than ih puungta o eh uh arah hatoh adoh erathan tajen puung chotka. <verse number="4" style="v"/>Erah lilih heliphante wajom ih Elija nyi Moses Jisu damdi waan arah japtup rumta. <verse number="5" style="v"/>Pitar ih Jisu suh baatta, “Nyootte, tumthan ese ah seng aani ang ih no ah! Seng ih nyutaap ejom than buk ih, esiit ah an raangtaan, esiit ah Elija raangtaan, esiit Moses raangtaan.” <verse number="6" style="v"/>Pitar nyia wahoh loong ah rapne ih cho rum ano Pitar ah mame jeng suh uh taseeta.</para>
  <para style="p">
    <verse number="7" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">9:7 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 3:17">Mat 3:17</ref>; <ref loc="MRK 1:11">Mk 1:11</ref>; <ref loc="LUK 3:22">Luk 3:22</ref></char>
    </note> Erah lilih jiingmuung ih neng loong ah loopjota, eno jiingmuung mong ni dongjeng ra taha, “Arah ngah di nga mongnook Sah miimi—heh jengkhaap chaat an!” <verse number="8" style="v"/>Neng ih seek taat lengsok rum adi, o uh tajeeta; Neng damdi Jisu chap arah laklak tup rumta.</para>
  <para style="p">
    <verse number="9" style="v"/>Neng kong ni dat ra rumha di Jisu ih baat rumta, “O suh uh nak baat an sen ih tumjaat tuptan rah ah, mina sah tek nawa maang ngaaksaatka ngakhoh nah ah.”</para>
  <para style="p">
    <verse number="10" style="v"/>Neng ih heh jeng ah thang et rumta, ang abah uh neng chamchi ni bah erah tiit ah waan ruh ih rumta, “‘Tek nawa ngaaksaat’ ah tumjih suh liita?” <verse number="11" style="v"/><note caller="-" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="MAL 4:5">Mal 4:5</ref>; <ref loc="MAT 11:14">Mat 11:14</ref></char></note> Eno neng ih Jisu suh chengta, “Hootthe nyootte loong ih Elija jaakhoh raaha ih tumet suh liita?”</para>
  <para style="p">
    <verse number="12" style="v"/>Jisu ih ngaak baatta, “Elang eah jaakhoh Elija aju raaha, jaatrep ban khookham raang ih ah. Enoothong Rangteele ni tumet suh liita Mina Sah ah rapne ih cham ah thaangju nep et rum ah eah? <verse number="13" style="v"/>Nga ih baat rumhala, Elija ah jen ra ih taha eno mina loong ah ih neng ih mamet thunta erah jun ju re rumta, heh tiit ah Rangteele ni raangha likhiik ah.”</para>
  <para style="s">Jisu ih chiithih laakhah pan mih wasiit deesiitta</para>
  <para style="r">(<ref loc="MAT 17:14-21">Mat 17:14-21</ref>; <ref loc="LUK 9:37-43">Luk 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v"/>Neng heliphante rukho loong ah damdi chokhoom wang rum adi, miloong hantek ih kookchap rum ano Hootthe nyootte loong damdi daanmu rum arah japtup rumta. <verse number="15" style="v"/>Miloong ah ih Jisu ah tup rum ano paatja rumta, eno heh reeni soonkah rum ano jengseera rumta. <verse number="16" style="v"/>Jisu ih heliphante loong suh cheng rumta, “Tumjih tungdi neng damdi daanmui lan?”</para>
  <para style="p">
    <verse number="17" style="v"/>Mih dung ni wasiit ngaakjengta, “Nyootte, ngah ih an jiinni nga sah chiithih laakhah pan, heh jeng nep mah arah siitkaat halang. <verse number="18" style="v"/>Chiithih laakhah pat adi heh teewah ah hah ni loongdat ano heh tui nawa tookwu ah dong, heh pha ah chektat ano kah laatdat ah, erah raang ih an liphante loong suh chiithih laakhah taat dokphan thuktang, eno tajen dok phan rumta.”</para>
  <para style="p">
    <verse number="19" style="v"/>Jisu ih liirumta, “Mamah lajen hanpi ehan mina sen loong ih ah! Ngah sen damdoh jaatjaat mathan ma jen roong tonghang? Ngah sen damdam mathan ma jen reehang? Noodek ah nga jiinnah siitwan han!” <verse number="20" style="v"/>Eno Jisu jiinni siitwan rumta.</para>
  <para style="p">Erah damdam laathih rah ih Jisu ah tup ano, noodek ah hah ni loonghaat ano laatdat thukta, eno lengkoong ano heh tui ni tookwu loong ah dong eta. <verse number="21" style="v"/>Jisu ih heh wah asuh chengta, “Arah likhiik ih sa mathan dowa ih angla?”</para>
  <para style="p">“Noodek dowa ih dook,” heh warah ih ngaak baatta. <verse number="22" style="v"/>“Chiithih laakhah rah ih helek helek we nyia juung ni tek haat suh taatwoot chung ha. Minchan ih weehe, an tenthet nawa ih jen lang abah ah!”</para>
  <para style="p">
    <verse number="23" style="v"/>Jisu ih heh wah suh liita, “An teeteewah ih jen lang eah ih liihu bah ah! Tuungmaang ete raang ih bah jaatrep ejen lang eah.”</para>
  <para style="p">
    <verse number="24" style="v"/>Erah damdam heh wah ah huung ano jengta, “Ngah etuungmaang elang, enoothong ehan tajen tuungmaang kang. Ehan ih tuungmaang suh chosok weehang!”</para>
  <para style="p">
    <verse number="25" style="v"/>Jisu ih miloong tukhoom ah sok ano, chiithih laakhah asuh baatta. “Engong nyia ebaang chiiala” “Nga ih an suh baat hala arah noodek sak dowa dokkhoom hoono babah uh nak kah ngaak wang uh!”</para>
  <para style="p">
    <verse number="26" style="v"/>Chiithih laakhah ah riinghuung ano noodek ah loonghaat thiinta, eno that that ih moh tekthuk ano heh ah doksoon kata. Noodek ah tekmang likhiik ih hoonta, eno warep ih liita, “Etek ela abah ah!” <verse number="27" style="v"/>Eno Jisu ih noodek ah heh lak ih toonhoom ano chap thukta.</para>
  <para style="p">
    <verse number="28" style="v"/>Jisu nokmong ni nopkhoom adi heliphante loong ih hucheng rumta, “Seng ih laathih ah mamah lajen dokphan eti?”</para>
  <para style="p">
    <verse number="29" style="v"/>Jisu ih baat rumta; “Aa likhiik chiithih laakhah ah rangsoom nawa luulu ih ba jen dokphan ah,” “Jaat hoh tumjih nawa reh uh tajenka.”</para>
  <para style="s">Jisu ih heh tektiit we baatta</para>
  <para style="r">(<ref loc="MAT 17:22-23">Mat 17:22-23</ref>; <ref loc="LUK 9:43-45">Luk 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v"/>Jisu nyia heliphante loong erah dowa Galili hadaang lam ih wang rumta. Jisu ih heteewah maani ah ih wahoh suh tajat thukta, <verse number="31" style="v"/>tumeah heliphante loong suh tiitwaan nyootsoot rumta;</para>
  <para style="p">“Mina Sah rah mih lak nah tek haat et suh jokoh rum ah. Enoothong sa jom lih nah, we ngaakthing eah.”</para>
  <para style="p">
    <verse number="32" style="v"/>Erah jengkhaap nyootta rah heliphante loong ih tumjih suh liita ih tasamjat rumta, heh suh huk cheng ra uh echo ih rumta.</para>
  <para style="s">Elongthoon o ah ?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Mat 18:1-5</ref>; <ref loc="LUK 9:46-48">Luk 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v"/>Neng Keparnam hadaang ni thokrum taha, eno nokmong ni nop rumta lidi Jisu ih heliphante loong suh chengta, “Sen loong lam ni tumjih tungdi daanmui tan?”</para>
  <para style="p">
    <verse number="34" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">9:34 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:24">Luk 22:24</ref>
      </char>
    </note> Neng ih tangaak baat rumta, tumeah neng chamchiini lam ni elongthoon ah o ah erah tiit tungdi daanmui rumta. <verse number="35" style="v"/><note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 20:26">Mat 20:26</ref>,<ref loc="MAT 20:27">27</ref>; <ref loc="MAT 23:11">23:11</ref>; <ref loc="MRK 10:43">Mk 10:43</ref>,<ref loc="MRK 10:44">44</ref>; <ref loc="LUK 22:26">Luk 22:26</ref></char></note>Jisu ah tong ano asih wanyi heliphante loong ah poon rum ano baat rumta, “O ih phangkhothoon angsuh nook an erah lithoon nah angtheng eno heh ah loongtang laksuh angjih.” <verse number="36" style="v"/>Eno heh ih noodek wasiit neng loong ngathong ni chap thukta. Heh lak ih khonjoh ano baat rumta, <verse number="37" style="v"/><note caller="-" style="x"><char style="xo" closed="false">9:37 </char><char style="xt" closed="false"><ref loc="MAT 10:40">Mat 10:40</ref>; <ref loc="LUK 10:16">Luk 10:16</ref>; <ref loc="JHN 13:20">Jn 13:20</ref></char></note>“Oih arah noodek loong ah nga mendoh noppoon an, erah ih ngah poon halang; eno oih ngah noppoon halang, erah ih nga laklak tanoppoon rang, nga daapjatte ah anep wak noppoonha.”</para>
  <para style="s">O mina sengdi junhala erah seng mina</para>
  <para style="r">(<ref loc="LUK 9:49-50">Luk 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v"/>Joon ih heh suh baatta, “Nyootte, seng ih an mendi mih wasiit ih chiithih laakhah loong ah dokphan arah japtupti eno tanghaamti, tumeah heh sengjoon tah angta.”</para>
  <para style="p">
    <verse number="39" style="v"/>“Nakmok tanghaam an,” Jisu ih baat rumta, tumeah o mina ih nga mendoh epaatjaajih loong ah jen re abah, liwang nah erah mina rah nga miksukte tah angka ang ah. <verse number="40" style="v"/><note caller="-" style="x"><char style="xo" closed="false">9:40 </char><char style="xt" closed="false"><ref loc="MAT 12:30">Mat 12:30</ref>; <ref loc="LUK 11:23">Luk 11:23</ref></char></note>O mina seng miksukte tah angka loong ah seng raangtaan ih ang ah. <verse number="41" style="v"/><note caller="-" style="x"><char style="xo" closed="false">9:41 </char><char style="xt" closed="false"><ref loc="MAT 10:42">Mat 10:42</ref> </char></note>Ngah ih ami tiit baat rumhala, nga mina angkan no o ih sen suh juung jok thuk han erah mih ah amiisak heh thaang ah choh ah.</para>
  <para style="s">Rangdah nah lungwaang thuk</para>
  <para style="r">(<ref loc="MAT 18:6-9">Mat 18:6-9</ref>; <ref loc="LUK 17:1-2">Luk 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v"/>Arah noodek loong ah ih ngah suh hanpi rum halang ah oih bah uh mok thetsiit rum ah, erah mina rah heh boh adoh jong ah bonchi ano juungsih nah mah abah ese ang ah. <verse number="43" style="v"/><note caller="-" style="x"><char style="xo" closed="false">9:43 </char><char style="xt" closed="false"><ref loc="MAT 5:30">Mat 5:30</ref></char></note> Erah raang ih sen lak ih sen tuungmaang ah matsiit abah, thadook haat et an! Lak hop mabah uh lametka we adoh roitang ih khaamwang nang ih bah lakko ih mabah uh lathoon roidong adoh chowang ah ese ang ah. <verse number="44" style="v"/>Erah nah ‘neng phakte soot ah babah uh tatiika, nyia neng khaam theng we ah babah uh tametka ang ah.’<note caller="+" style="f"><char style="fr" closed="false">9:44 </char><char style="ft" closed="false">Mararah leedap adi wet hin 44 ah tawak raangka: </char><char style="fq" closed="false">Erah nah ‘neng phakte soot ah babah uh tatiika, nyia neng khaam theng we ah babah uh tametka ang ah.</char></note> <verse number="45" style="v"/>Sen lah ih sen tuungmaang ah mok matsiit abah, thadook haat et an! Lah hop roitang we nah khaamwang nang ih bah lah ko lathoonka roidong adoh chowang ah ese ang ah. <verse number="46" style="v"/>Erah nah ‘neng phakte soot ah babah uh tatiika, nyia neng khaam theng we ah babah uh tametka ang ah.<note caller="+" style="f"><char style="fr" closed="false">9:46 </char><char style="ft" closed="false">Mararah leedap adi wet hin 46 ah tawak raangka: </char><char style="fq" closed="false">Erah nah ‘neng phakte soot ah babah uh tatiika, nyia neng khaam theng we ah babah uh tametka ang ah. </char></note> <verse number="47" style="v"/><note caller="-" style="x"><char style="xo" closed="false">9:47 </char><char style="xt" closed="false"><ref loc="MAT 5:29">Mat 5:29</ref></char></note>Erah damdi sen mik ih dah thuk halan bah, doklot haat et an! Rangmong Hasong nah mikko ih wang ah ese ang ah mik hop ih roitang we nah khaamwang nang ih bah ah. <verse number="48" style="v"/><note caller="-" style="x"><char style="xo" closed="false">9:48 </char><char style="xt" closed="false"><ref loc="ISA 66:24">Isa 66:24</ref> </char></note>Erah ni, ‘Neng phakte soot ah babah uh tatiika nyia neng khaam theng we ah babah uh tametka ang ah.’</para>
  <para style="p">
    <verse number="49" style="v"/>“Mireprep ah we nawa ih saasook ah sum ih siik hoon theng saasiit arah likhiik ah.</para>
  <para style="p">
    <verse number="50" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">9:50 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:13">Mat 5:13</ref>; <ref loc="LUK 14:34">Luk 14:34</ref>,<ref loc="LUK 14:35">35</ref></char>
    </note>“Sum ah ese; enoothong sumwaan ah sa abah, sen ih mamah we ih miingaak sumthuk an?</para>
  <para style="p">“Joonte damdoh sum likhiik angtheng, eno warep damdoh semroongroong in songtong theng.”</para>
  <chapter number="10" style="c"/>
  <para style="s">Jisu ih minuh haat tiit baatta</para>
  <para style="r">(<ref loc="MAT 19:1-12">Mat 19:1-12</ref>; <ref loc="LUK 16:18">Luk 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>“Eno Jisu erah hah dowa dokkhoom ano, Judia hah ko ni Jordan Juung ah daan wanta. Erah di miloong ephoop thok taha, eno heh ih saahoh di kanyoot arah likhiik ih we nyootsoot rumta.</para>
  <para style="p">
    <verse number="2" style="v"/>Mararah Pharisi loong heh jiinni thokrum haano heh jeng matjoot suh chung rumta. “Seng suh baat he,” “Seng hootthe jun ih miwah ih heh minuh jen haat nih et ah?”</para>
  <para style="p">
    <verse number="3" style="v"/>Jisu ih cheng damdi ngaakbaatta, “Moses ih tumjaat Hootthe baat tahan?”</para>
  <para style="p">
    <verse number="4" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">10:4 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 24:1-4">Hodb 24:1-4</ref>; <ref loc="MAT 5:31">Mat 5:31</ref> </char>
    </note> Neng ih ngaakbaat rumta, “Moses ih bah miwah suh epaak leeraang ah raangkoh ano sen sanuh ah ejen haat et an ih baatta.”</para>
  <para style="p">
    <verse number="5" style="v"/>Jisu ih neng suh baatta, “Sen suh nyootsoot ah jong ajaan likhiik angkan no Moses ih erah Hootthe ah raangkoh tahan.” <verse number="6" style="v"/><note caller="-" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="GEN 1:27">Rangph 1:27</ref>; <ref loc="GEN 5:2">5:2</ref></char></note>Enoothong haphangsong di, edongsiit saapoot di, ‘Rangte ih minuh miwah dong hoonta, ‘Rangteele ni liiha likhiik ah. <verse number="7" style="v"/><note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="GEN 2:24">Rangph 2:24</ref></char></note> ‘Erah thoidi miwah rah ih heh nuh heh wah ah thiinhaat ano heh sanuh damdoh roomsong ah,<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false">Mararah le adi arah tawak raangka </char><char style="fq" closed="false">heh sanuh damdoh roomsong ah </char></note> <verse number="8" style="v"/>eno enyi ah esiit ih hoon ah.’ Erah thoidi nengnyi ah wanyi takah angka, esiit ang ah. <verse number="9" style="v"/>Erah raangtaan ih Rangte ih chosit ha ah, mina lajaatjaat paak haat theng.”</para>
  <para style="p">
    <verse number="10" style="v"/>Neng loong ah nok ni ngaak wang rum adi, heliphante loong ih erah tiit ah huk cheng rumta. <verse number="11" style="v"/><note caller="-" style="x"><char style="xo" closed="false">10:11,12 </char><char style="xt" closed="false"><ref loc="MAT 5:32">Mat 5:32</ref>; <ref loc="1CO 7:10">1Kr 7:10</ref>,<ref loc="1CO 7:11">11</ref></char></note> Jisu ih ngaakbaat rumta, “O ih bah uh heh minuh ah haat ano nuhoh we kap abah, heh ah roomjup rangdah ah dah ah.” <verse number="12" style="v"/>Erah likhiik, minuh ih miwah ah haat ano wahoh damdoh we nook abah eroomjup rangdah ah dah ah.”</para>
  <para style="s">Jisu ih noodek loong suh romseetam kota</para>
  <para style="r">(<ref loc="MAT 19:13-15">Mat 19:13-15</ref>; <ref loc="LUK 18:15-17">Luk 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v"/>Mararah miloong ah ih Jisu reeni noodek loong ah heh lak ih taajoh ano romseetam kot suh thoksiit rumta, eno heliphante loong ih kanja et rumta. <verse number="14" style="v"/>Jisu ih erah kanja rumta ah jat ano, heliphante loong asuh ekhat eta eno baat rumta, “Noodek loong ah nga re nah toom wang rumha, sen ih nak tanghaam an, tumeah Rangte Hasong ah arah noodek loong likhiik raangtaan ih. <verse number="15" style="v"/>Ngah ih ami tiit baat rumhala, o mina arah noodek loong likhiik lah angko bah Rangte Hasong nah tachoh wang ko.” <verse number="16" style="v"/>Eno noodek loong ah heh lak ni toonpi rum ano romseetam korumta.</para>
  <para style="s">Changteng wasiit</para>
  <para style="r">(<ref loc="MAT 19:16-30">Mat 19:16-30</ref>; <ref loc="LUK 18:18-30">Luk 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v"/>Jisu hahoh ni kaat suh we dokchap adi, mih wasiit soon ra haano heh lakuh di tong ano chengta, “Ese et Nyootte, mabah uh lathoonka roidong ah chosuh ngah ih tumjih et ang?”</para>
  <para style="p">
    <verse number="18" style="v"/>“Ngah suh ese ih tumjih suh li halang?” Jisu ih chengta. “O uh ese tajeeka Rangte luulu ba ese ah. <verse number="19" style="v"/>An ih Rangte jengdang ah jat ehu: ‘mih latek haat theng; an minuh nyia an miwah lah angka bah mih damdoh nak roomjup theng; mih hot lahuh theng; mih lathika doh lanan theng; mih lamokwaan theng; nuh awah jeng chaat etheng.’”</para>
  <para style="p">
    <verse number="20" style="v"/>Erah wah rah ih liita “Nyootte,” “Erah loong jengdang abah ngah ih noodek dowa ih dook chaat jah halang.”</para>
  <para style="p">
    <verse number="21" style="v"/>Eno Jisu ih hetaangko ramram ih sok ano minchan lam ih baatta, “Andi jaatsiit boot reejih jeela. An nyamka loong ah sangkaat uno ngun ah changthih loong asuh pheekoh uh, eno an ah rangmong nah changteng ang uh, erah lidoh ba nga lih phanhang.” <verse number="22" style="v"/>Jisu jeng ah chaat ano, erah wah rah heh thungjoong ih heh the ah saanghaat ano dokkhoom kata, tumeah heh changteng angta.</para>
  <para style="p">
    <verse number="23" style="v"/>Jisu ih heliphante loong kooni lengsok ano baatta, “tumthan echaan ah changteng loong ah Rangte Hasong nah jen wangsuh ah!”</para>
  <para style="p">
    <verse number="24" style="v"/>Heliphante loong ah Jisu jengkhaap suh rapne ih paatja rumta, eno Jisu ih we baat rumta, “Ngaasuh ngaasah loong, Rangte Hasong nah chowang tumthan echaan ang ah! <verse number="25" style="v"/>Changteng mina Rangte Hasong nah jen wang nang ih bah mikkaan po na mokchongdoot ba laan jen nopwang ah.”</para>
  <para style="p">
    <verse number="26" style="v"/>Erah tiit ah chaat rum ano heliphante loong ah rapne ih paatja rumta eno neng cheng chengmui ih rumta, “erah ang abah, o ah jen pui ah?”</para>
  <para style="p">
    <verse number="27" style="v"/>Heliphante loong taangko ih sok ano Jisu ih baatta, “Mina raangtaan ih bah erah echaan, enoothong Rangte di bah tachaanka; jaatrep ah Rangte raangtaan ebah elaang.”</para>
  <para style="p">
    <verse number="28" style="v"/>Eno Pitar dongjengta, “Sok uh, seng ih jaatrep thiinhaat eno an lih phanhi.”</para>
  <para style="p">
    <verse number="29" style="v"/>“Um,” Jisu ih liita, “Ngah ih baat rumhala, o mina ih amadoh henok hetap, henuh hewah, hephoh, henah, hesuh, hesah nyi hephek hephaang ah nga raang ih nyia Ruurang Ese raang ih ahaangwa rangkuh adoh thiinhaat abah, <verse number="30" style="v"/>heh suh romseetam ah amah dowa nang ih uh ehan ih choh ah. Henok hetap, hephoh, henah, henuh, heh sah, nyia hephek hephaang ah chaasiit nang ih ehan choh ah—nga raangtaan ih siiwi chamnaang et ah; erah damdoh heh lakngah nah babah uh lathoonka roidong ah choh ah. <verse number="31" style="v"/>Enoothong mina loong amadi elong elang angla loong ah liwang nah ehin ih hoon ah, eno amadi ehin angla loong ah elong ih hoon ah.”</para>
  <para style="s">Jisu ih heh tektiit takjom baatta</para>
  <para style="r">(<ref loc="MAT 20:17-19">Mat 20:17-19</ref>; <ref loc="LUK 18:31-34">Luk 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v"/>Jisu nyi heliphante loong lam ni Jirusalem ni chookwang rum adi, Jisu ah neng ngah ni bankhoom wang ano, heliphante loong ah paatja ih rumta; heh lini phan khoomte miloong ah echo erumta. Eno Jisu ih heliphante loong ah hiiksiit ano heh tumjih angte angla erah tiit we baat rumta. <verse number="33" style="v"/>“Boichaat an,” Heh ih baat rumta, “Seng Jerusalem ni wangli adoh Mina Sah rah romwah phokhoh nyi Hootthe nyootte loong suh baat korum ah. Neng ih heh ah tek ejih et kaanju dut haat rum ah eno Ranglajatte loong suh baat korum ah, <verse number="34" style="v"/>neng ih chikram ngitkhuung et rum ah, ebot ih rum ah, neng took ah ih took rum ah, ruh ih buh rum ano tek haat rum ah; enoothong sa jom lidoh heh ah ewe ngaakthing eah.”</para>
  <para style="s">Joon nyia Jeems ih Jisu suh baatta</para>
  <para style="r">(<ref loc="MAT 20:20-28">Mat 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v"/>Eno Jebedi sah Jeems nyia Joon, Jisu reeni ra taha. “Nyootte,” nyi ih liita, “Sek ih an suh tiit esiit sek suh reekotjih cheng suh liihiitih.”</para>
  <para style="p">
    <verse number="36" style="v"/>“Tumjih ah?” Jisu ih chengta.</para>
  <para style="p">
    <verse number="37" style="v"/>Nyi ih baatta, “Phaakjaaja Hasong adoh luungwang tongtheng nah tongwang uh doh, sek uh an damdoh waktong thuk we heetih, wasiit ah an dak hekko wasiit ah an jaawah ko ah.”</para>
  <para style="p">
    <verse number="38" style="v"/>Jisu ih we baat nyuuta, “Set ih tajat kansih tumjih suh hansih rah ah. Set ih ngah ih jok theng chamnaang lookkep dowa ejen jok nih et ansih? Nga juungtem ang rah likhiik ejen tem nih eh ansih?”</para>
  <para style="p">
    <verse number="39" style="v"/>“Jen tem ettih,” nyi ih ngaakbaatta.</para>
  <para style="p">Eno Jisu ih baat nyuuta, “Elang eah set ih nga chamnaang lookkep adoh ejen jok mok ih ansih nyia nga juungtem theng adoh ejen tem mok eh ansih. <verse number="40" style="v"/>Enoothong nga ih set dak hek jaawah ko adoh o tong ah erah tajen dan baat nyuura. Erah Rangte ih jat ah, o mina raang ih ban hoonta nyia o suh kottheng rah ah.”</para>
  <para style="p">
    <verse number="41" style="v"/>Heliphante wah asih loong ah ih erah chaat rum ano Jeems nyi Joon suh ekhat erumta. <verse number="42" style="v"/>Eno Jisu ih heliphante loongtang lompoon rum ano baat rumta, “Jehudi lah angka loong adi neng phansiite loong ah eje. Sen ih jat ehan erah phansiite loong ah ih nengchaan nengphaan ah mina loong asuh noisok suh nook rumla, nyia neng phansiite loong ah ih nengchaan nengphaan ah maak suh nook rumla. <verse number="43" style="v"/>Enoothong erah likhiik bah sen loong chamchi nah nak angtheng. Sengdung dowa o ih bah uh elong angsuh nook anbah, sen wahoh loong laksuh jaatjaat chaak angjih; <verse number="44" style="v"/>nyia o bah uh ngakhoh angsuh nook anbah, sen ah loongtang dah jaatjaat chaak ang jih. <verse number="45" style="v"/>Mina Sah ah botseh mih suh mootthuk suh tara taha; erah nang ih mih raangtaan ih moh suh ra taha nyia mina loong ah puipang suh heh roidong ah kota.”</para>
  <para style="s">Bartimaas mikdook ang arah deesiitta</para>
  <para style="r">(<ref loc="MAT 20:29-34">Mat 20:29-34</ref>; <ref loc="LUK 18:35-43">Luk 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v"/>Neng Jeriko hadaang ni thok rumta, eno Jisu nyia heliphante erah dam ih miloong ah dokkhoom rum adi, edook kunma heh men ah Bartimas Timas sah lamkaang ni tong ano ban thaang phaksata. <verse number="47" style="v"/>Najaret nawa Jisu ra hala ih chaat ano, riing poonta, “Jisu! Dewid sah, ngah minchan ih weehang!”</para>
  <para style="p">
    <verse number="48" style="v"/>Miloong ih edook ah kanja rum ano nak hoopti uh ih baat rumta. Eno heh ah erong ih we huk riingta, “Dewid sah, ngah minchan weehang!”</para>
  <para style="p">
    <verse number="49" style="v"/>Jisu tangchap ano baat rumta, “Poon wanhan.” Eno neng ih mikdook warah poon rumta, “Eroon eh uba, an poon halu.”</para>
  <para style="p">
    <verse number="50" style="v"/>Heh nyusah ah khook buhaat ano Jisu jiinni toonpit wang taha.</para>
  <para style="p">
    <verse number="51" style="v"/>Jisu ih chengta, “Nga ih an suh tumjih jen re koha ih liihu?” Mikdook warah ih liita, “Nyootte,” “Nga mik ah we ngaaksing thuk weehang.”</para>
  <para style="p">
    <verse number="52" style="v"/>Jisu ih baatta, “Kah uh,” “An tuungmaang jun ih deelu.”</para>
  <para style="p">Lakdamdam ih heh ih laantup ruh eta eno lam ni Jisu lilih ih roongphan khoomta.</para>
  <chapter number="11" style="c"/>
  <para style="s">Ruurangrang Jerusalem ni wang rumta</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mat 21:1-11</ref>; <ref loc="LUK 19:28-40">Luk 19:28-40</ref>; <ref loc="JHN 12:12-19">Jn 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>Betpheej nyia Bithani hadaang reeni Jerusalem thok nanah ih rum adi, neng loong ah Olip Kong adi wang rumta. Eno Jisu ih heliphante dowa wanyi ah jaakhoh ih ban kaat thukta <verse number="2" style="v"/>amet baat nyu ano ah, “Set ngah ni hadaang esiit je ah erah doh kah ansih, erah di moktoh<note caller="+" style="f"><char style="fr" closed="false">11:2 </char><char style="ft" closed="false">Moktoh ah English di dongkey et liiha asuh men hi. </char></note> sah bonthiin arah japtup kah ansih babah uh o ih lathaak siitka rah ah. Ja ansih no nga re nah siitwan hansih. <verse number="3" style="v"/>Mih ih tumet suh ja hansih ih cheng hansih bah, Changte wah ih liita belam seek we ih ngaak siitwan he ih baat ansih.”</para>
  <para style="p">
    <verse number="4" style="v"/>Eno kah nyu ano moktoh sah ah lam ni nok esiit ni kaawan thong ni bonthiin arah japtup kah nyuuta. Erah ja nyu adi, <verse number="5" style="v"/>nyi reeni chapta miloong dowa mararah ih cheng rumta, “Moktoh sah ah tumet suh ja hansih?”</para>
  <para style="p">
    <verse number="6" style="v"/>Eno nyi ih Jisu ih mamet baatta erah jun ih ngaakbaat nyu kano miloong ah ih moktoh sah ah hoom wanthuk nyuuta. <verse number="7" style="v"/>Eno Jisu reeni thok hoom wannyu ano, moktoh sah sakkhoh adi neng nyusah loong ah dekoh rum ano, Jisu ah duungtongta. <verse number="8" style="v"/>Miloong ah ih neng nyusah loong ah lam adi ban dam wanrumta, rukho rah ih bangphaak ah phek dowa dook rum leh lam ni dam et rumta. <verse number="9" style="v"/><note caller="-" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="PSA 118:25">Rsb 118:25</ref>,<ref loc="PSA 118:26">26</ref> </char></note>Heh lih heh ngah ni khoomte miloong ah riing rumta, “Rangte rangphoong ih! Teesu mendi raakte loong asuh Rangte ih romseetam koh ah. <verse number="10" style="v"/>Seng loong wah Dewid luungwang hasong thok hala asuh Rangte romseetam ah je ah! Rangte rangphoong ih!”</para>
  <para style="p">
    <verse number="11" style="v"/>Jisu Jerusalem ni thok ano Rangteenok ni wangta, erah di heh ih jaatrep ah sok wangta. Enoothong rangsa jen tham ih kaat kano, heliphante asih wanyi damdi Bithani ni kata.</para>
  <para style="s">Jisu ih puksak bang hoktamta</para>
  <para style="r">(<ref loc="MAT 21:18-19">Mat 21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v"/>Erah saalih adi, Bithani nawa ngaak wang rum adi, Jisu heh ram ih tiita. <verse number="13" style="v"/>Heh ih rekam loot nawa ih puksak lak loong ah japtup ano, hetiik ah taatsok kata. Eno sokkah ano, hetiik tiiktok lah ang thoidi heh lak luulu japtup kata. <verse number="14" style="v"/>Eno Jisu ih puksak bang asuh liita, “O ih uh an tiik ah mabah uh naktoom kah we choh sah ho!”</para>
  <para style="q1">Erah jengta ah heliphante ih nep japchaatta.</para>
  <para style="s">Jisu Rangteenok ni wangta</para>
  <para style="r">(<ref loc="MAT 21:12-17">Mat 21:12-17</ref>; <ref loc="LUK 19:45-48">Luk 19:45-48</ref>; <ref loc="JHN 2:13-22">Jn 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v"/>Neng Jerusalem ni thokrum ano, Jisu ah Rangteenok ni wangta, erah di thaangsangte nyi thaang riikte loong ah phang dokphan wang rumta. Neng ngun lek theng teebun<note caller="+" style="f"><char style="fr" closed="false">11:15 </char><char style="ft" closed="false">Teebun: Hukkhaak thiintheng nyia le dang raangtheng (Table) </char></note> nyia tokparu sangte tongtheng loong ah daanghaat et wangta. <verse number="16" style="v"/>Eno heh ih O suh uh Rangteenok taakkhuung lam ih tumjih uh taleng hu thukta. <verse number="17" style="v"/><note caller="-" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="ISA 56:7">Isa 56:7</ref>; <ref loc="JER 7:11">Jer 7:11</ref></char></note>Erah lih adi heh ih miloong asuh nyoot rumta, “Rangteele ni raangha, ‘Nga Rangteenok ah deek akaan rep raangtaan ih rangsoomnok et men ah.’ Enoothong sen ih ehuh loong hottong theng ih hoon han!”<note caller="+" style="f"><char style="fr" closed="false">11:17 </char><char style="ft" closed="false">Isaia 56:7, Jeremiah 7:11</char></note></para>
  <para style="p">
    <verse number="18" style="v"/>Romwah phokhoh nyi Hootthe nyootte loong ah ih erah tiit ah japchaat rum ano Jisu tek haat suh lampo phang jam rumta. Neng ah heh ra echo ih rumta tumeah mina loong suh epaatjaajih ih nyootsoot rum kano ah.</para>
  <para style="p">
    <verse number="19" style="v"/>Rangjaako ih Jisu nyia heliphante loong ah erah samnuthung dowa dokkhoom ih rumta.</para>
  <para style="s">Puksak bang nawa nyootsok theng</para>
  <para style="r">(<ref loc="MAT 11:20-22">Mat 11:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v"/>Erah saalih rangkhah di neng lam ni khoom rum adi, satkom bang ah heh hingtuk ih hook arah japtup rumta. <verse number="21" style="v"/>Pitar ih tumjih angta rah dokthun ano Jisu suh baatta, “Nyootte, sok uh, an ih tamtu satkom bang ah ehook ela!”</para>
  <para style="p">
    <verse number="22" style="v"/>Jisu ih ngaakbaatta, “Rangte suh tuungmaang an.” <verse number="23" style="v"/><note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="MAT 17:20">Mat 17:20</ref>; <ref loc="1CO 1:2">1Kr 1:2</ref> </char></note> Ngah ih amiisak tiit baat rumhala o mina heh ten nah mongchi lah angthang ih hanpi ano arah kong akaan asuh toonchap uno juungsih adoh rukdat kah uh ih baat abah uh amiisak elang eah, enoothong tumjih suh an erah suh hanpi et ano ba jen lang ah. <verse number="24" style="v"/>Erah raangtaan ih ngah ih sen suh baat rumhala: sen ih rangsoom lam ih tumjaat suh an, erah echoh etang ih hanpi an, eno ba sen ih tumjih suh an erah kohan. <verse number="25" style="v"/><note caller="-" style="x"><char style="xo" closed="false">11:25 </char><char style="xt" closed="false"><ref loc="MAT 6:14">Mat 6:14</ref>,<ref loc="MAT 6:15">15</ref> </char></note>“Erah dam ih maatok doh sen ih rangsoom suh toonchap an, sen miksukte o ang abah uh erah loong ah biin anaan chaak hoon an, erah doh ba rangmong nawa sen Wah ih sen thetre loong ah biin anaan han.” <verse number="26" style="v"/>[Sen ih mihoh ah lajen biin anaan kanbah, Rangmong nawa sen Wah eh uh sen ah tajen biin anaan ran.]<note caller="+" style="f"><char style="fr" closed="false">11:26 </char><char style="ft" closed="false">Mararah leedap adi wet hin 26 ah tawak raangka: </char><char style="fq" closed="false">Sen ih mihoh ah lajen biin anaan kanbah, Rangmong nawa sen Wah eh uh sen ah tajen biin anaan ran. </char><char style="ft" closed="false">( Mat 6:15 adoh soktheng) </char></note></para>
  <para style="s">Jisu chaan aphaan tiit chengphi</para>
  <para style="r">(<ref loc="MAT 21:23-27">Mat 21:23-27</ref>; <ref loc="LUK 20:1-8">Luk 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v"/>Neng Jerusalem ni we thok rumta. Jisu Rangteenok ni lengkhoom adi, erah nawa romwah phokhoh loong, Hootthe nyootte nyia mihak phokhoh loong ah heh jiinni ra rumha no, <verse number="28" style="v"/>cheng rumta, “Arah mamah jen reelu? An jen reejih o ih koh taho?”</para>
  <para style="p">
    <verse number="29" style="v"/>Jisu ih ngaakbaat rumta, “Ngah ih sen suh esiit than jengkhaap cheng rumha, erah ngaakbaat kohe no ba, ngah ih tumjih chaan nawa ih jen reelang loong ah baat korumha. <verse number="30" style="v"/>Jisu ih liita, baat an, Joon ih juungtem theng chaan ah ma nawa chota: Rangte jiin nawa tama mina jiin nawa chota?”</para>
  <para style="p">
    <verse number="31" style="v"/>Eno neng jaachi ni phang daanmui rumta, “Tumjih baat ih? ‘Rangte jiin nawa,’ mok et baat ih bah, heh ih liihe, erah ang abah ‘Joon ah tanih hanpi kan’ <verse number="32" style="v"/>Eno, ‘Mina jiin nawa mok baat ih bah...’” (Neng ah miloong ra cho rumta tumeah Joon ah khowah ih loongtang ih jatcho angta.) <verse number="33" style="v"/>Erah raangtaan ih Jisu suh, “Seng ih tajatke,” ih ngaakbaat rumta.</para>
  <para style="p">Eno Jisu ih baat rumta, erah ang abah, “Ngah ih uh arah loong ah mame jen reelang erah tabaat rumra.”</para>
  <chapter number="12" style="c"/>
  <para style="s">Phekphoop phekte di nyoot baatta</para>
  <para style="r">(<ref loc="MAT 21:33-46">Mat 21:33-46</ref>; <ref loc="LUK 20:9-19">Luk 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">12:1 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 5:1">Isa 5:1</ref>,<ref loc="ISA 5:2">2</ref> </char>
    </note> Eno Jisu ih tiitthaak loong ah baat lam ih li rumta: “Teewah di wasiit phek changte wah reh heh phek ni potiik phook loong ah ki ano, pa ih kookpaata, potiik jittheng haluung ah thoh ano bante tongtheng nok echoongwah ih hoon thiinta. Eno erah phek ah phekphoop phekte suh kothiin ano heh hahoh ni kata. <verse number="2" style="v"/>Potiik hu tok ah thok kohaano phekphoopte jiinni heh dah wasiit daap wanta, heh chotheng thaang ah suk suh ah. <verse number="3" style="v"/>Phekphoop phekte loong rah ih dah ah joh buh rum ano hahuung ngaak daapta. <verse number="4" style="v"/>Erah lih adi changte wah ih dah wahoh we wang thukta; eno phekphoop phekte loong ih hekhoh adi buh rum ano heh rakri laandong ruh ih li wanrumta. <verse number="5" style="v"/>Erah lidi changte wah ah ih dah wahoh daap wanta, eno erah ah tek haat ih rumta, emamah ih wahoh uh ephoop tek haat rumta rukho ah bot et rumta rukho ah tek haat et rumta. <verse number="6" style="v"/>Phek changte wah adi ewangthuk etheng ah heh mongnook sah ah luulu ba dak tongta. Hethoondi heh sah ah phekphoop phekte loong jiinni daap wanta. ‘Ngah ih jat et hang nga sah abah soongraang et rum ah,’ changte wah ih thunta. <verse number="7" style="v"/>Enoothong phekphoopte<note caller="+" style="f"><char style="fr" closed="false">12:7</char><char style="fq" closed="false">Phekphoopte</char><char style="ft" closed="false">Mih phek banpheekte mih asuh liita </char></note> loong ah neng chamchi ni waan rumta, ‘Arah tang ah changte sah. Raahan tekbuh ih no heh nyamka ah seng doh toom ih hoon ah!’ <verse number="8" style="v"/>Eno heh sah ah joh rum ano tekbuh rum ano heh mang ah phaakkhuh ni haat rumta.</para>
  <para style="p">
    <verse number="9" style="v"/>“Erah ang abah phekphoopte loong ah changte wah ih tumjih et ah?” Jisu ih chengta. “Heh ah wangha no phekphoop phekte loong ah tekbuh ano wahoh suh lawe phek thuk ja. <verse number="10" style="v"/><note caller="-" style="x"><char style="xo" closed="false">12:10,11: </char><char style="xt" closed="false"><ref loc="PSA 118:22">Rsb 118:22</ref>,<ref loc="PSA 118:23">23</ref></char></note>Sen ih Rangteele ni raangha amiimi ewet tam etan?</para>
  <para style="q1">‘Nok hoonte ih jaakhoni jong taseeka ih chiik haatta</para>
  <para style="q2">jong ah loongtang nang ih ekapjih ese thoon jong ih hoonla.</para>
  <para style="q1">
    <verse number="11" style="v"/>Erah Teesu ih hoonta;</para>
  <para style="q2">Tumthan epaatja theng sokjih ah!’”</para>
  <para style="p">
    <verse number="12" style="v"/>Eno Jehudi mihak phokhoh loong ih heh jootkhak suh chung rumta, tumeah neng ih jat et rumta erah tiitthaak ah neng teewah di nyoot baatta. Enoothong mih luulu ang kano neng ah echo ih rum ano matsoon rumta.</para>
  <para style="s">Sokse ngun kot thoidi chengmui rumta</para>
  <para style="r">(<ref loc="MAT 22:15-22">Mat 22:15-22</ref>; <ref loc="LUK 20:20-26">Luk 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v"/>Mararah Pharisi nok hah nyia Hirod mina loong Jisu reeni heh jengthet matjoot suh daapkaat rumta. <verse number="14" style="v"/>Jisu reeni thokrum ano cheng rumta, “Nyootte, seng ih jat et hi an ih ami tiit ju baat hu, mina ih thunha asuh lasootsaam thang ah. An ih mina ehin elong lathaam sok thang ih, Rangte ih ami tiit nyoot ha erah jun ju baat hu. Erah raang ih seng suh baat he, Roman luungwanglong asuh sokse kohi rah seng Hootthe ni eje tam tajeeka? Seng ih ekot tam takoke?”</para>
  <para style="p">
    <verse number="15" style="v"/>Enoothong Jisu ih, nga matjoot suh cheng rum halang ih jat ano, ngaakbaat rumta, “Sen ih nga matjoot tumet suh thunhan? Ngunkholok ah piijah han, ngah ih sokthaak ang.”</para>
  <para style="p">
    <verse number="16" style="v"/>Neng ih ngunkholok esiit piikaat rumta, eno heh ih cheng rumta, “Arah othe okhoh ah nyia omen ah?”</para>
  <para style="q1">“Luungwanglong the akhoh,” et baat rumta.</para>
  <para style="p">
    <verse number="17" style="v"/>Eno Jisu ih baat rumta, “Ese eno bah Luungwanglong chojih ah Luungwanglong suh koh an, Rangte chojih ah Rangte suh koh an.”</para>
  <para style="p">Eno Jisu suh rapne ih paatja rumta.</para>
  <para style="s">Tek nawa ngaaksaat tiitwaan</para>
  <para style="r">(<ref loc="MAT 22:23-33">Mat 22:23-33</ref>; <ref loc="LUK 20:27-40">Luk 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">12:18 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 23:8">Esm 23:8</ref>
      </char>
    </note> Eno mararah Sadusi mina tek nawa tangaaksaatka liite loong ah ih, Jisu suh cheng karumta. <verse number="19" style="v"/><note caller="-" style="x"><char style="xo" closed="false">12:19 </char><char style="xt" closed="false"><ref loc="DEU 25:5">Hodb 25:5</ref></char></note>Neng ih liita, “Nyootte, Moses ih seng suh Hootthe amet raangthiinta: ‘Jengthaak ih mih wasiit heh sah maangje di tek ano heh minuh ah thiinhaat abah, heh no damdoh we jen chosong eah, eno heh sah ah heh phoh etekte wah mikkhang ang ah.’ <verse number="20" style="v"/>Teewadi soophoh wasinet angta; phokhoh rah ih heh minuh ah kap ano, heh sah maangje di mattiita. <verse number="21" style="v"/>Eno miidamwah damdi we chosong ano, heh uh emamah ih heh sah maangje di we mattiita. Erah lilih wasiit taat we chosong, erah uh emamah heh sah maangje di we matti, <verse number="22" style="v"/>eno soophoh wasinet net: loongtang erah nuh ah damdi taat chosong leh neng sah laje thang ih matti rumta. Hethoon adi minuh ah thoon tiita. <verse number="23" style="v"/>Erah ang abah, tek nawa we ngaaksaat rum adoh, heh ah o minuh ang ah? Soophoh wasinet net ih kap thoidi ah.”</para>
  <para style="p">
    <verse number="24" style="v"/>Jisu ih ngaakbaat rumta, “Mame mokbaang lan! Sen loong ih Rangteele nyia Rangte chaan aphaan lajat thoidi mokjeng lan! <verse number="25" style="v"/>Maatok doh tek nawa ngaaksaat ah, erah tokdoh rangmong nawa Rangsah loong likhiik ih hoon ah, erah nah mina takah nookmuika.” <verse number="26" style="v"/><note caller="-" style="x"><char style="xo" closed="false">12:26 </char><char style="xt" closed="false"><ref loc="EXO 3:6">Hpkt 3:6</ref></char></note> Tek nawa ngaaksaat tiit ah: Moses ih raangthiinta leedap adi woma ni we luung damdi Rangte jengta ah taba japweh tan? Erah di Rangte ih Moses suh amet baatta. ‘Ngah Abraham Rangte, Esak Rangte nyi Jaakob Rangte.’ <verse number="27" style="v"/>Heh ah ethingte loong Rangte, tekchoote Rangte tah angka. Sen loong ah rapne ih moong jenglan!”</para>
  <para style="s">Elongthoon jengdang</para>
  <para style="r">(<ref loc="MAT 22:34-40">Mat 22:34-40</ref>; <ref loc="LUK 10:25-28">Luk 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v"/>Hootthe nyootte wasiit ih neng daanmui rumta ah japchaatta. Jisu ih Sadusi loong suh ese lam ih ngaakbaat rum arah japchaat ano, cheng kata: “Marah jengdang ah loongtang nang ih elongthoon ih kapjih ah?”</para>
  <para style="p">
    <verse number="29" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">12:29 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 6:4">Hodb 6:4</ref>,<ref loc="DEU 6:5">5</ref></char>
    </note>Jisu ih baatta ehanthoon ih kapjih ah arah, Ijirel mina loong chaat an! Teesu seng Rangte luulu ah juuba Teesu wah. <verse number="30" style="v"/>Erah raang ih, senthung sentak, senchi senla, sen tah nawa ih Rangte ah nook an. <verse number="31" style="v"/><note caller="-" style="x"><char style="xo" closed="false">12:31 </char><char style="xt" closed="false"><ref loc="LEV 19:18">Lew 19:18</ref></char></note> Erah lilih jengdang ehan kapjih ah arah: “Senkhuung sentok ah senteewah thanthan et minchan an. Erah nyi tokkhodi ehoh elong jengdang tajeeka.”</para>
  <para style="p">
    <verse number="32" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">12:32 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 4:35">Hodb 4:35</ref>
      </char>
    </note>Eno Hootthe nyootte rah ih Jisu ah guuta, “Elang eh uh, Nyootte! Epun baat et hu Teesu heh luulu abah Rangte, heh tokkhodi ranghoh tajeeka eah. <verse number="33" style="v"/><note caller="-" style="x"><char style="xo" closed="false">12:33 </char><char style="xt" closed="false"><ref loc="HOS 6:6">Hos 6:6</ref></char></note> Erah raangtaan ih seng ih Rangte ah seng tenthun mongtham nawa nyia sengthung sengtak adoleh seng tah nawa ih seechoh theng; eno sengkhuung sengtok ah seng teewah thanthan ih seechoh theng. Jaat hoh liiamaan nyi ngunteh seng khosa suh Rangte suh kohi ah nang ih uh arah jengdang enyi ah kapjih.”</para>
  <para style="p">
    <verse number="34" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">12:34 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:25-28">Luk 10:25-28</ref>
      </char>
    </note> Erah wah rah ih mongwah maakwah lam ih ngaakbaatta ah jat ano, Jisu ih heh suh baatta,</para>
  <para style="q1">“An bah Rangte Hasong nawa haloot tah angko.”</para>
  <para style="p">Erah lidi o ih uh Jisu suh tumjih uh tanaan boot cheng rumta.</para>
  <para style="s">Kristo o sah ah?</para>
  <para style="r">(<ref loc="MAT 22:41-46">Mat 22:41-46</ref>; <ref loc="LUK 20:41-44">Luk 20:41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v"/>Jisu ih Rangteenok ni nyootsoot rum adi, heh ih cheng rumta, “Hootthe nyootte loong ih Kristo ah Dewid sutoom ih mamet miibaat rum ah? <verse number="36" style="v"/><note caller="-" style="x"><char style="xo" closed="false">12:36 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Rsb 110:1</ref></char></note>Esa Chiiala ih Dewid suh jeng thukta:</para>
  <para style="q1">‘Rangte ih nga Teesu suh baatta:</para>
  <para style="q2">Nga jaawah ko adoh tong uh</para>
  <para style="q2">an piiara loong ah ngah ih an lakhu nah maang thiinthiin ah.’</para>
  <para style="p">
    <verse number="37" style="v"/>Dewid ih heh teeteewah ih, ‘Teesu’ et liita; eno bah Kristo ah Dewid sutoom mamah mi ang ah?”</para>
  <para style="s">Jisu ih Hootthe nyootte loong kanjaata</para>
  <para style="r">(<ref loc="MAT 23:1-36">Mat 23:1-36</ref>; <ref loc="LUK 20:45-47">Luk 20:45-47</ref>)</para>
  <para style="p">Miloong ah ih Jisu tiit ah tenroon roon et banchaat rumta. <verse number="38" style="v"/>Heh ih nyootsoot rumta adi baat rumta, “Hootthe nyootte loong dowa banban ih tong an, neng loong ah nyuh akhat eloot lootwah ih kap rum ano mih ih toom soomtu he ih pheehoon theng ni lengkhoom suh nook rumla, <verse number="39" style="v"/>Jehudi rangsoomnok ni tongtheng ese ban thiincho adoh tong suh nyia sadung theng ni tongtheng eseethoon adoh tong suh nook rumla. <verse number="40" style="v"/>Neng ih thaknuh loong ah nep mokwaan rum leh neng nok nawa looso et rumha, mih miksok di rang eloot lootwah ih soom rum ano rangsoomte likhiik et noisok rumha. Neng chamnaang theng rapne ethih thoon ang ah!”</para>
  <para style="s">Thaknuh lakkot</para>
  <para style="r">(<ref loc="LUK 21:1-4">Luk 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v"/>Jisu Rangsoomnok ni ngun lomthiin theng re adi tong ano miloong ih neng ngun sak rum arah ban sokta. Nyamte loong ah ih hantek hantek ih sak rumta; <verse number="42" style="v"/>eno changthih thaknuh nusiit ah thok haano jaan ngun loonyi phaasiit nyi di to arah koh wan taha. <verse number="43" style="v"/>Eno Jisu ih heliphante loong ah lompoon ano baat rumta, “Ngah ih baat rumhala, arah changthih thaknuh ih ngun bangkhok adi sak ha rah wahoh ih sak ha nang ih ehan thoon ang ah. <verse number="44" style="v"/>Wahoh loong ih bah neng nyamka dowa hedak aba koha; eno arah changthih nuh rah ih bah heh laanyaang theng angta rah thoon koha.”</para>
  <chapter number="13" style="c"/>
  <para style="s">Jisu ih Rangteenok thet tiit baatta</para>
  <para style="r">(<ref loc="MAT 24:1-2">Mat 24:1-2</ref>; <ref loc="LUK 21:5-6">Luk 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>Jisu Rangteenok nawa dokkhoom adi heliphante wasiit ih liita, “Nyootte, Sok uh! Arah nok loong nyia jong ah, tumthan milung miwaang ah!”</para>
  <para style="p">
    <verse number="2" style="v"/>Jisu ih ngaakbaatta, “An ih arah nok loong ah elong longwah tam et tup hu?” Arah nok abah saasiit erukdat eah, arah nok adoh jongteh tesiit taan uh tah dak tongka ang ah; loongtang rukdat ih ah.”</para>
  <para style="s">Siiwi chamnaang</para>
  <para style="r">(<ref loc="MAT 24:3-14">Mat 24:3-14</ref>; <ref loc="LUK 21:7-19">Luk 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v"/>Rangteenok ka ni Jisu Olib kong ni tong adi, Pitar, Jeems, Joon nyia Endriu loong ah huchomui wang rumtaha. <verse number="4" style="v"/>“Erah loong ah maatok doh angte angla, seng suh baat kohe,” neng ih cheng rumta, “Erah loong ah saapoot ah echang ela ih jat suh tumjih ih jatthuk he, erah nep baat kohe.”</para>
  <para style="p">
    <verse number="5" style="v"/>Jisu ih baat rumta, “Naririh ih ban tong an, mih ih naktoom mokwaan han. <verse number="6" style="v"/>Nga tiitbaatte mih hantek ih dong ah, ‘Jisu ah ngah’ ih chaangte nep dong ha! Eno neng ih hantek moong mokwaan ah. <verse number="7" style="v"/>Sen ih haniik haloot nawa raamui tiit ephoop chochaat an, ang abah uh sen lasootsaam theng. Erah loong ah elang jaatjaat eah, enoothong erah suh rangkuh thoonla ih liijih tah angka. <verse number="8" style="v"/>Hasong rookwih nah neng neng rookmui arah je ah, deek akaan ah deek akaan loong damdoh rookmui ah. Rongrep nah hasatek nyi ramtek khamle totoh ang ah. Erah loong ah, noonuh nootup suh kaphang sat arah likhiik ih ang ah.</para>
  <para style="p">
    <verse number="9" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">13:9 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:17-20">Mat 10:17-20</ref>; <ref loc="LUK 12:11">Luk 12:11</ref>,<ref loc="LUK 12:12">12</ref></char>
    </note>“Sen teeteewah sensen ih naririh ih ban sok an. Sen loong ah khak hanno mat hoon nok nah siitwan han. Sen loong ah Jehudi rangsoomnok loong nah buh kaat han; nga thoidoh sen loong ah mih luungwang loong ngathong nah chap anno ruurang ese tiit ah baat an. <verse number="10" style="v"/>Enoothong rangkuh thoon jaakhoh nah mongrep dowa mirep miraang suh Rangte tiitkhaap ah baat jaatjaat etheng. <verse number="11" style="v"/>Eno sen loong ah, maatok doh khak hanno mat hoon nok nah siitwan han doh tumjih jeng ang ih lasootsaam theng; saapoot thok ha doh an tumjih jeng thuk ho, erah jeng uh. Jengkhaap marah jeng uh erah an jeng tah angka ang ah; erah Esa Chiiala nawa jeng raaha. <verse number="12" style="v"/>Mina loong ah soophoh ah soophoh ih jootkot mui rum ano tek haatmui ah eno hewah loong ah ih emamah heh sah loong tek haat ah. Heh sah loong ah ih henuh hewah damdoh miksuk mui rum ano tek haatmui rum ah. <verse number="13" style="v"/><note caller="-" style="x"><char style="xo" closed="false">13:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">Mat 10:22</ref></char></note>Nga tungthoidoh warep ih miksuk han. Enoothong o hethoon tuk ih ramram ih joh ah erah ba pui ah.</para>
  <para style="s">Echoojih tiit</para>
  <para style="r">(<ref loc="MAT 24:15-28">Mat 24:15-28</ref>; <ref loc="LUK 21:20-24">Luk 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">13:14 </char>
      <char style="xt" closed="false">
        <ref loc="DAN 9:27">Dan 9:27</ref>; <ref loc="DAN 11:31">11:31</ref>; <ref loc="DAN 12:11">12:11</ref> </char>
    </note> “Sen ih ‘Rapne Echoojih’ jaatrep jen thet haatte ah japtup et an, marah doh lah angtheng angta erah doh ang ah.” (Arah wette suh: esamjat etheng tumjih men et ha rah ah!) “Eno Judia nawa miloong ah kong akaan ko ih toonsoonjih jaatjaat ang ah. <verse number="15" style="v"/><note caller="-" style="x"><char style="xo" closed="false">13:15 </char><char style="xt" closed="false"><ref loc="DAN 9:27">Dan 9:27</ref>; <ref loc="DAN 11:31">11:31</ref>; <ref loc="DAN 12:11">12:11</ref></char></note> O bah uh nok<note caller="+" style="f"><char style="fr" closed="false">13:15 </char><char style="ft" closed="false">Nok khoni: Nok khoh ah sep asuh liiha, erah tok di neng nok khoh hoonthung hane angta </char></note> khoni angte rah ih nokmong nawa hukkhaak toon suh lajaatjaat saathaam kaat jih ang ah. <verse number="16" style="v"/>O mina phek nah ang ah, heh nok nawa nyuh akhat toon suh lajaatjaat ngaak wangjih. <verse number="17" style="v"/>Erah tokdoh tumthan ethih ang ah sah wokte nyi khobaang nuh loong ah raang ih ah! <verse number="18" style="v"/>Rangte rangsoom an erah rangwuung ah hahook doh nak toom ang ah! <verse number="19" style="v"/><note caller="-" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="DAN 12:1">Dan 12:1</ref>; <ref loc="REV 7:14">Mot 7:14</ref></char></note>Tumeah erah tokdoh chamchojih rah, Rangte ih hasong phangdong siitta dowa ih amatuk ih o uh lathaak chamka rah cham ah. Adoleh erah likhiikkhiik tumsa doh uh takah we angka. <verse number="20" style="v"/>Enoothong Teesu ih erah saakaan rookweh ah ethoosiit thong et koha, lah angta bah, o uh ething tatong thengta. Heh ih danjeeta mina loong suh raamwe ih erah saakaan ah thoosiitta.</para>
  <para style="p">
    <verse number="21" style="v"/>“Eno, o ih bah uh amah mok ih baat han, ‘Sok an, Kristo aani,’ adoleh mararah ih baat han ‘Kristo bah therah ni thong!—erah sen ih lahanpi theng. <verse number="22" style="v"/>Tumeah emoong Kristo nyia emoong khowah loong ephoop dong ha. Neng ih epaatjaajih nyia mih lungwaang theng ephoop noisok rum ah, jen lang abah Rangte ih danjeeta mina loong ah nep mokwaan suh ah. <verse number="23" style="v"/>Sen teeteewah naririh ih ban sok an! Ngah ih jaatrep tiit ah rangwuung saakaan maang thok ra ngakhoni banbaat rumhala!</para>
  <para style="s">Mina sah raaha</para>
  <para style="r">(<ref loc="MAT 24:29-31">Mat 24:29-31</ref>; <ref loc="LUK 21:25-28">Luk 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">13:24 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 13:10">Isa 13:10</ref>; <ref loc="JOL 2:10">Jol 2:10</ref>,<ref loc="JOL 2:31">31</ref>; <ref loc="JOL 3:15">3:15</ref>; <ref loc="REV 6:12">Mot 6:12</ref>; <ref loc="ISA 13:10">Isa 13:10</ref>; <ref loc="EZK 32:7">Ijk 32:7</ref> </char>
    </note> “Erah chamnaang loong saakaan lidoh rangsa ah emoon eah, laaphiing ah takah kaang phaakka ang ah, <verse number="25" style="v"/><note caller="-" style="x"><char style="xo" closed="false">13:25 </char><char style="xt" closed="false"><ref loc="ISA 34:4">Isa 34:4</ref>; <ref loc="REV 6:13">Mot 6:13</ref></char></note> rang nawa riksih loong ah datti ih raaha, rangkho nawa rangsa laaphiing loong ah dumdan eah. <verse number="26" style="v"/><note caller="-" style="x"><char style="xo" closed="false">13:26 </char><char style="xt" closed="false"><ref loc="DAN 7:13">Dan 7:13</ref>; <ref loc="REV 1:7">Mot 1:7</ref></char></note> Erah lidoh, Mina Sah ah jiingmuung khuinah, chaan aphaan pan ih phaakjaaja ih dong raaha. <verse number="27" style="v"/>Eno rangsah loong ah hatoh rongbaji adoh daapkaat ah, heh ih danjeeta mina loong ah mongrep noongrepwih dowa lom khoonsiit rum ah.</para>
  <para style="s">Puksak bang nawa nyootjih</para>
  <para style="r">(<ref loc="MAT 24:32-35">Mat 24:32-35</ref>; <ref loc="LUK 21:29-33">Luk 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v"/>“Puksak bang ih sen suh toom nyoot han. Heh demdem suh hephaak ah jang ano dongkom raaha eno helak ah pa, erah di sen ih jat han rangsoh thok hala eah. <verse number="29" style="v"/>Erah likhiik ih, sen ih sen mik ih erah loong chikrok ah tup anno ba, hethoon saapoot ah haniik ih thok hala ih samthun an. <verse number="30" style="v"/>Banthun et an erah loong ah amah dowa mina thoontang maang matti rumka ngakhoh nah ang raaha. <verse number="31" style="v"/>Rang nyia hah bah ethoon eah, nga jengkhaap loong abah babah uh tathoonka.</para>
  <para style="s">O ih uh rangwuung saakaan tajatka</para>
  <para style="r">(<ref loc="MAT 24:36-44">Mat 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">13:32 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:36">Mat 24:36</ref>
      </char>
    </note>“O mina reh uh rangwuung saakaan ah tajatka, tum sa doh, maatok doh raaha eah—rangmong nawa Rangsah reh uh tajatka; heh Sah reh uh tajatka, heh Wah luulu ih ba jat ah. <verse number="33" style="v"/>Erah raang ih ban sok et an, nyia banban ih tong an, tumeah sen ih rangwuung saakaan ah tajatkan. <verse number="34" style="v"/><note caller="-" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="LUK 12:36-38">Luk 12:36-38</ref></char></note> Erah langla changte wah ih heh laksuh loong wasiit wasiit suh heh nok nawa reeraang loong ah baat koh thiin rum ano heh ah haloot nah moongkhoom kah arah likhiik ang ah. Eno heh maang ngaakwang wang et ban sok thuk arah likhiik. <verse number="35" style="v"/>Erah raang ih naririh ih ban sok an! Tumeah sen ih tajatkan nok changte wah ah maatok doh ngaakwang koja, rangja ko doh tam pheethungkham doh, tama rangkhano doh, adoleh rangsa dong doh wang koja. <verse number="36" style="v"/>Heh baphuk ih raaha doh, sen emokjup ean rah nak toom kapjoh raahan. <verse number="37" style="v"/>Ngah ih sen loong suh baat rumhala rah, mirep suh baat hang: Banban ih tong an!”</para>
  <chapter number="14" style="c"/>
  <para style="s">Jisu tekhaat kaankoong</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mat 26:1-5</ref>; <ref loc="LUK 22:1-2">Luk 22:1-2</ref>; <ref loc="JHN 11:45-53">Jn 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">14:1 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:1-27">Hpkt 12:1-27</ref>
      </char>
    </note> Khopui Kuwaang nyia Toomuh Baanlo Kuwaang phaksat thok suh saanyi tongta. Romwah phokhoh nyia Hootthe nyootte loong ih, Jisu ah husah lam ih khak ano tek haat suh lampo jam rumta. <verse number="2" style="v"/>“Kuwaang mong dobah seng lajaatjaat reejih, miloong ah phophaang jaang rum ah, neng liita.”</para>
  <para style="s">Bethani ni Jisu phontum ih lokta</para>
  <para style="r">(<ref loc="MAT 26:6-13">Mat 26:6-13</ref>; <ref loc="JHN 12:1-8">Jn 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">14:3 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 7:37">Luk 7:37</ref>,<ref loc="LUK 7:38">38</ref></char>
    </note> Bithani hadaang ni Jisu ah Simoon maangdi engam angta wah nok adi roong tongta. Jisu phaksat tokdi minuh nusiit ih heh lak ni mojaang thuungsiit thaangchaan thaang phontum<note caller="+" style="f"><char style="fr" closed="false">14:3</char><char style="fq" closed="false">Phontum</char><char style="ft" closed="false">sak ni tingmokjih tummangmang (perfume)</char></note> ah pi ano wangta. Eno moojaang<note caller="+" style="f"><char style="fr" closed="false">14:3 </char><char style="fq" closed="false">Moojaang</char><char style="ft" closed="false">juung thiintheng (bottle)</char></note> kep ah thajop ano Jisu khoni keelokta. <verse number="4" style="v"/>Erah dowa mararah miloong ah khah rum ano neng chamchi ni roongwaan rumta, “Erathan thaangchaan thaang phontum ah tumjih suh thaaja ha?” <verse number="5" style="v"/>Erah bah chaajom<note caller="+" style="f"><char style="fr" closed="false">14:5</char><char style="fq" closed="false">chaajom</char><char style="ft" closed="false">Teewadi chaajom jaan ngun ah paang siit lakbi thaang di toota.</char></note> nang ih ehan ngunkholok doh sang ano ngun ah changthih loong suh minchan kotjih boh angta!” Eno neng ih minuh ah rapne ih chikram li rumta.</para>
  <para style="p">
    <verse number="6" style="v"/>Enoothong Jisu ih li rumta, “Heh nak thaam paklak an! Heh suh sen tume sootsaam lan? Heh nga raangtaan ih eseejih reeraangla. <verse number="7" style="v"/><note caller="-" style="x"><char style="xo" closed="false">14:7 </char><char style="xt" closed="false"><ref loc="DEU 15:11">Hodb 15:11</ref></char></note>Changthih loong abah saarookwih noongrep nah sen damdam ang ha, chosok ih suh li anbah tiimtok doh uh ejen chosok et an. Ngah ah sen damdoh saatangtang lakah roong tongte. <verse number="8" style="v"/>Heh tumjih reejih angta erah reela; heh ih nga sak ni phontum ih lok halang ah langla saapoot maang angka ngakhoh nah nga mangbeng suh ban khookhamha. <verse number="9" style="v"/>Ngah ih ami tiit baat rumhala, mongrep thoontang nah ruurangese marah doh thok ah erah doh arah nuh reela tiit ah, ban samthun ruh ejih ang ah.”</para>
  <para style="s">Judas ih Jisu tek haat suh ngun thaangta</para>
  <para style="r">(<ref loc="MAT 26:14-26">Mat 26:14-26</ref>; <ref loc="LUK 22:3-6">Luk 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v"/>Eno asih wanyi heliphante dowa Judas Iskerot ih Romwah Phokhoh loong suh Jisu khumtan kaatta. <verse number="11" style="v"/>Eno neng ah erah tiit ah chaat rum ano roon ih rumta, eno heh suh ngun kottheng ih kakham rumta. Erah dowa ih Judas ih Jisu ah ma doh jap jokoh rum ang ih saapoot bantho thakta.</para>
  <para style="s">Heliphante damdi Jisu ih kuwaang phaksat phaksata</para>
  <para style="r">(<ref loc="MAT 26:17-25">Mat 26:17-25</ref>; <ref loc="LUK 22:7-14">Luk 22:7-14</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Jn 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v"/>Toomuh Baanlo<note caller="+" style="f"><char style="fr" closed="false">14:12 </char><char style="ft" closed="false">Toomuh Baanlo kuh: To lari thang ih baanlo phak kuwaang (Unleaven Bread) </char></note> Kuwaang sa sakhothoon adi, neng banlam di Khopui Kuwaang doh phaksat suh saapsah loong kadook rumta, Jisu suh heliphante loong ih cheng rumta, “An ih seng maanah kaat thuk he, an raangtaan ih Khopui Kuwaang phaksat khookham raangtaan ih ah?”</para>
  <para style="p">
    <verse number="13" style="v"/>Eno heliphante dowa wanyi asuh amet baat ano kaat thukta: “Samnuthung adoh kah ansih, erah doh mih wasiit khamteng tek ah pi ano wangha rah chomui ansih, eno erah wah lilih ih roongwang ansih. <verse number="14" style="v"/>Heh marah doh nop ah erah nok changte asuh cheng ansih: ‘Seng suh Nyootte wah ih liita, Nga liphante nyia ngah ih kuwaang phaksat sat theng nokkhok maani ah?’ <verse number="15" style="v"/>Eno heh ih rangkhoh thoon nokkhok elongwah esiit baat koh hansih, erah doh seng raang ih tongtheng thaatheng nyia jaatrep ban khookham cho japtup kah ansih. Eno set ih phaksat ah erah doh ban songwaang theng.”</para>
  <para style="p">
    <verse number="16" style="v"/>Eno wanyi ah samnuthung adi kah nyu ano Jisu ih mamet baatta erah jun ih jaatrep echoi et tup kah nyuuta. Eno nyi ih Khopui Kuwaang phaksat ah ban khookham kah nyuuta.</para>
  <para style="p">
    <verse number="17" style="v"/>Rangjaako ih hoon damdam Jisu nyia heliphante asih wanyi ah ra rum taha. <verse number="18" style="v"/><note caller="-" style="x"><char style="xo" closed="false">14:18 </char><char style="xt" closed="false"><ref loc="PSA 41:9">Rsb 41:9</ref></char></note> Neng erah di teebun ni room phaksat tokdi Jisu ih liita, “Sengdung ni wasiit nga khumtante eje erah mih ah nga damdi room phaksah ih hala.”</para>
  <para style="p">
    <verse number="19" style="v"/>Heliphante loong ah rapne ih thungthih rum ano wasiit wasiit ih cheng rumta, “Ngah suh nih li halang?”</para>
  <para style="p">
    <verse number="20" style="v"/>Jisu ih liita, “Erah sen asih wanyi dung dowa, nga damdi khuung esiit ni baanlo roongtem phakte mina ang ah. <verse number="21" style="v"/>Mina Sah baleh etek haat jaatjaat ih rum ah, Rangteele ni mamet raangha jun ih ah. “Enoothong tumthan ethih angbaat ah Mina Sah khumtante raang ih ah. Erah mih abah lalaan tupta bah ese ang thengta!”</para>
  <para style="s">Teesu phaksat</para>
  <para style="r">(<ref loc="MAT 26:26-30">Mat 26:26-30</ref>; <ref loc="LUK 22:14-20">Luk 22:14-20</ref>; <ref loc="1CO 11:23-25">1Kr 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v"/>Neng phaksat phaksah rum adi, Jisu ih baanlo ah toonpi ano Rangte suh lakookmi li ano chepphiitta, eno heliphante loong asuh pheekoh rumta, “Thaang an, arah nga sak,” Jisu ih liita.</para>
  <para style="p">
    <verse number="23" style="v"/>Erah lilih lokkep ah toon ano Rangte suh jengseeraata, eno erah lokkep dowa loongtang ih jok rumta. <verse number="24" style="v"/><note caller="-" style="x"><char style="xo" closed="false">14:24 </char><char style="xt" closed="false"><ref loc="EXO 24:8">Hpkt 24:8</ref>; <ref loc="JER 31:31-34">Jer 31:31-34</ref></char></note> Heh ih liita, “Arah nga sih mina loong raang ih jan ra hala. Arah sih rah ih Rangte nyia heh mina loong chamchi ni jengdang kakhat <note caller="+" style="f"><char style="fr" closed="false">14:24 </char><char style="ft" closed="false">Heh sih: Heh sih rah ih Rangte jengdang ah heh mina loong suh neng ten ni thiin thuk ah</char></note> ena ah Rangte ih hoonha. <verse number="25" style="v"/>Ngah ih baat rumhala, aadowa ih ngah ih arah kham ah babah uh takah we jokkang. Heh rangwuung rookli ano kham na ah Rangte Hasong nah ba we jok ang.”</para>
  <para style="p">
    <verse number="26" style="v"/>Eno neng rangsoom boong ah boong rum ano Olib Kong ni wang rumta.</para>
  <para style="s">Jisu ih Pitar leek tiit banbaatta</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mat 26:31-35</ref>; <ref loc="LUK 22:31-34">Luk 22:31-34</ref>; <ref loc="JHN 13:36-38">Jn 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">14:27 </char>
      <char style="xt" closed="false">
        <ref loc="ZEC 13:7">Jek 13:7</ref>
      </char>
    </note> Jisu ih baat rumta, “Sen loong nga re nawa loongtang saapsoonte ang lan, Rangteele ni liiha,</para>
  <para style="p">‘Rangte ih saapriimte warah tek haat ano saapsah loong ah thaapnya khoom rum ah.’ <verse number="28" style="v"/><note caller="-" style="x"><char style="xo" closed="false">14:28 </char><char style="xt" closed="false"><ref loc="MAT 28:16">Mat 28:16</ref></char></note>Enoothong ngah etek nawa we ngaaksaat angno, Galili hah nah sen ngah nah ban kah ang.”</para>
  <para style="p">
    <verse number="29" style="v"/>Pitar ih ngaakbaatta, “Ngah ih bah an babah uh tajen thiinhaat ra, wahoh loong ih thiinhaat ho bah uh ah!”</para>
  <para style="p">
    <verse number="30" style="v"/>Jisu ih Pitar suh liita, “Ngah ih baat hala niikja woh leknyi maang weeka nganah, an ih tajatkang ih lekjom jeng uh.”</para>
  <para style="p">
    <verse number="31" style="v"/>Eno Pitar ih ehan han ih we ngaakbaatta, “Ngah an damdoh waktek haat hang doh botseh, emah tajeng kang!”</para>
  <para style="p">Heliphante wahoh loong ah uh emamah ih roongjeng rumta.</para>
  <para style="s">Getsemani ni Jisu ih rangsoomta</para>
  <para style="r">(<ref loc="MAT 26:36-46">Mat 26:36-46</ref>; <ref loc="LUK 22:39-46">Luk 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v"/>Neng Getsimani hah adi thokrum ano, Jisu ih heliphante loong asuh baatta, “Ngah ih rangsoom ang pootdoh adoh tong an.” <verse number="33" style="v"/>Heh damdi Pitar, Jeems nyia ah Joon ah waksiit wanta. Heh phang sootsaam nyia heh mong chikrok ano, <verse number="34" style="v"/>Jisu ih baat rumta, “Nga ten ehan thoon ih paattiila, ngah bah tek thanthan ih hoon lang.” “Adoh tong anno bantho he.”</para>
  <para style="p">
    <verse number="35" style="v"/>Amasah hiikkhoom ano, Jisu hani kotbon ano rangsoomta, jen lang eabah erah chamchoh saapoot ah nak chothuk weeuh, <verse number="36" style="v"/>“Ewah Jisu ih rangsoomta, “Seng Wah!” Andi bah jaatrep tachaanka, arah chamnaang lookkep ah nga re nawa toonhaat et weeuh. Enoothong nga thung jun lah angthang an thung jun ju toom ang ah.”</para>
  <para style="p">
    <verse number="37" style="v"/>Eno heliphante wajom jiinni ngaak adi neng ah emokjup ih rum arah japtup kata. Jisu ih Pitar suh liita, “Simoon mokjup nih elu? Sen saapootsiit taan uh motseng tanih jen tong kan?” <verse number="38" style="v"/>Motseng ih tong an no chaan aphaan raangtaan ih rangsoom an phate joonnaam ih nak toom jen han. Chiiala ah enook ela, enoothong hansi ah naangla.”</para>
  <para style="p">
    <verse number="39" style="v"/>Jisu we ngaak wang ano phosiitsiit ih we soomwangta. <verse number="40" style="v"/>Eno we ngaak raaha di uh heliphante wajom ah thok mokjup ruh ih rumta; Neng mik uh lajen daapsok rum thang ah. Eno Jisu suh tumjih uh tami baat rumta.</para>
  <para style="p">
    <verse number="41" style="v"/>Heh rangsoom theng nawa takjom ngaak ha di uh neng ah hephoopho ih mokjup rumta, eno we li rumta, “Amadi uh thok naangjup ruh nih elan?” Erah than jup an chang ih ah! Saapoot chang ela! Sokthaak an, “Mina Sah ah amadoh rangdah mina loong lak nah koh ah. <verse number="42" style="v"/>Saat an kah ih, erah sok an, “Nga khumtante wah rah ah!”</para>
  <para style="s">Jisu khakwanta</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mat 26:47-56</ref>; <ref loc="LUK 22:47-53">Luk 22:47-53</ref>; <ref loc="JHN 18:3-12">Jn 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v"/>Jisu ih baat tokdi heliphante asih wanyi dung nawa, Judas dong khoom taha. Heh damdi miloong langnuh pawah nyia kiingthom waangrak ih roong dong khoom rum taha, Romwah phokhoh loong, Hootthe nyootte loong nyia mihak phokhoh loong ih daapkaat rum taha. <verse number="44" style="v"/>Heh khumtante wah rah ih miloong asuh hubaat rumta: “Ngah ih marah wah ah chupphak ang erah wah ah ang ah, sen ih jam han warah ah. Eno khak anno bante loong suh siitwan thuk an.”</para>
  <para style="p">
    <verse number="45" style="v"/>Judas heh laanthok khoom, Jisu reeni kah ano liita, “Nyootte!” Eno chupphakta. <verse number="46" style="v"/>Eno neng ih Jisu ah joh rum ano khak rumta. <verse number="47" style="v"/>Eno erah chap rumta dung dowa wasiit ih heh lang ah dok hoom ano Romwah phokhothoon dah na ah chepdookta. <verse number="48" style="v"/>Eno Jisu ah toon jeng ano li rumta, “Hootthe thet haatte jokah ah likhiik langpi papi nyia kiingthom waangrak nga joot tam ra tahan?” <verse number="49" style="v"/><note caller="-" style="x"><char style="xo" closed="false">14:49 </char><char style="xt" closed="false"><ref loc="LUK 19:47">Luk 19:47</ref>; <ref loc="LUK 21:37">21:37</ref></char></note>“Saarookwih ngah sen damdi Rangteenok ni tonghang no kanyootsoot tang adi mamah lajoh khak ih tahe? Enoothong, Rangteele ni liiha amiisak jaatjaat ang raaha.”</para>
  <para style="p">
    <verse number="50" style="v"/>Eno heliphante loongtang heh ah thiinhaat rum ano saapsoon rumta.</para>
  <para style="p">
    <verse number="51" style="v"/>Jaaro wasiit nyuleep di choom arah ih Jisu lini roongphan khoomta. Eno neng ih heh khak taat thot rumta, <verse number="52" style="v"/>enoothong heh ah boongloong henyuh hekhat ah khook haat thiin ano moong soonta.</para>
  <para style="s">Jisu ngoongthum nok ni siitwanta</para>
  <para style="r">(<ref loc="MAT 26:57-68">Mat 26:57-68</ref>; <ref loc="LUK 22:54-55">Luk 22:54-55</ref>,<ref loc="LUK 22:63-67">63-67</ref>; <ref loc="JHN 18:13-14">Jn 18:13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v"/>Eno Jisu ah Romwah Phokhothoon<note caller="+" style="f"><char style="fr" closed="false">14:53 </char><char style="ft" closed="false">Romwah Phokhothoon: Romwah loongdung dowa elongthoon ah (High Priest) </char></note> nok ni siitwan rumta, erah di Romwah Phokhoh loong, mihak phokhoh loong, nyia Hootthe Nyootte loong thoontang thutthi rumta. <verse number="54" style="v"/>Pitar ih haloot nawa ih rikwan ano Romwah Phokhothoon nok taakkhuung adi wangta. Erah di bante damdi weekaang ni roong hangtong wangta. <verse number="55" style="v"/>Romwah Phokhoh loong nyi hadaang Ngoong awang loong ah ih Jisu kap tek haat suh heh thet tiitbaatte taat jam rumta, eno o uh tachojam rumta. <verse number="56" style="v"/>Jisu thetre tiit baat hantek ih taat leekbaat rumta, ang abah uh erah jeng loong adi tajun rumta.</para>
  <para style="p">
    <verse number="57" style="v"/>Eno mararah Jisu miksukte ih toonchap leh hahuung tiit ah leekbaat et rumta: <verse number="58" style="v"/><note caller="-" style="x"><char style="xo" closed="false">14:58 </char><char style="xt" closed="false"><ref loc="JHN 2:19">Jn 2:19</ref></char></note>“Seng ih ame jeng arah chaatti, ‘Ngah ih arah mina ih hoonta Rangteenok ah thaak haat angno, sa jom lidoh mina ih lahoonka rah hoon ang.’” <verse number="59" style="v"/>Neng thung nawa ih dong hoon arah tiit taatbaat rum abah uh tajunwaan rumta.</para>
  <para style="p">
    <verse number="60" style="v"/>Loongtang ngah ni Romwah Phokhothoon ah toonchap ano Jisu suh chengta, “An tiit erathan et thetbaat rum halu adi, an ih ngaakbaat jih tanih jeeka?”</para>
  <para style="p">
    <verse number="61" style="v"/>Enoothong Jisu ah khaapsiit uh tatoon jengta. Eno Romwah Phokhothoon rah ih we cheng, “An ah Kristo tama, marah seng ih soomtu hi Rangte sah rah ah?”</para>
  <para style="p">
    <verse number="62" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">14:62 </char>
      <char style="xt" closed="false">
        <ref loc="DAN 7:13">Dan 7:13</ref>
      </char>
    </note>Jisu ih liita, “Elang eah ngah, sen ih mina Sah ah Elongthoon Rangte heh jawah koh tongtheng adoh roongtong arah nep japtup an, erah damdoh rang nawa jiingmuung damdoh raaha arah nep kaptup an!” <verse number="63" style="v"/>Eno Romwah Phokhothoon rah ih heh nyuh ah ranhoom<note caller="+" style="f"><char style="fr" closed="false">14:63</char><char style="fq" closed="false">Nyuh ranhoom</char><char style="ft" closed="false">Nyuh ranhoom ah neng banlam di echoojih tenkhat noisokta</char></note> ano liita, “Seng ih erah tokkhodoh an thet tiit baat suh haaki takah boot jamke! <verse number="64" style="v"/><note caller="-" style="x"><char style="xo" closed="false">14:64 </char><char style="xt" closed="false"><ref loc="LEV 24:16">Lew 24:16</ref></char></note>“Rangte kaanju tiit loongtang ih ejap chaat et han. Eno bah sen ih mamet thunhan?”</para>
  <para style="p">Eno loongtang roongjeng rumta: elang eah ethih ela etek haat ju etjih.</para>
  <para style="p">
    <verse number="65" style="v"/>Mararah ih Jisu ah neng took ih nep phang betook rumta, eno heh mik ah loop rum ano buh leh cheng et rumta. “Jat thaak he o ih buh halu!” Eno bante loong ah ih joh rum ano heh the adi baangbuh rumta.”</para>
  <para style="s">Pitar ih Jisu tiit leekbaat</para>
  <para style="r">(<ref loc="MAT 26:69-75">Mat 26:69-75</ref>; <ref loc="LUK 22:56-62">Luk 22:56-62</ref>; <ref loc="JHN 18:15-18">Jn 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v"/>Pitar uh Romwah phokhoh danuh raak tokdi, nok taakkhuung ni thok tongruh eta. <verse number="67" style="v"/>Erah nuh rah ih Pitar ah we ni hangtong arah japtup ano heh ah chiichi et sok ano liita, “An uh Nazareth nawa Jisu damdi roong angtu.”</para>
  <para style="p">
    <verse number="68" style="v"/>Eno Pitar ah leek eta. “Ngah ih tajatkang... Tumjih tiit baat hu erah ah, ngah ih tasamjat kang,” eno heh ah pa kaawan ko ih dokkhoom kata. Erah damdam woh ah weeta.<note caller="+" style="f"><char style="fr" closed="false">14:68 </char><char style="ft" closed="false">Mararah leedap adi arah tajeeka</char><char style="fq" closed="false">woh ah weeta</char></note></para>
  <para style="p">
    <verse number="69" style="v"/>Danuh rah ih Pitar we japtup ano, heh reeni chapta miloong asuh we baatta, “Arah uh Jisu damdi khoomte loongdung dowa wasiit!” <verse number="70" style="v"/>Eno Pitar ah we leekta.</para>
  <para style="p">Chomre lidi mih heh reeni chapta loong ih we li rumta, “An bah neng dung dowa ju angkoko nak leek kuh, tumeah an uh Galili nok hah nawa.”</para>
  <para style="p">
    <verse number="71" style="v"/>Pitar ih liita, “Ngah ih ami tiit baat rumhala! Tiit huung baatkang bah Rang ih toom cham thuk kohang, ngah ih tajaatjaat jatkang sen ih o suh li han rah ah!”</para>
  <para style="p">
    <verse number="72" style="v"/>Erah damdam woh ah we weeta, eno Pitar ih Jisu ih mamet baatta rah dokthunta, “Woh jaanyi maang weeka doh an lekjom leek uh ngah ih tajatkang eah.” Eno Pitar ah thungthih ano huungta.</para>
  <chapter number="15" style="c"/>
  <para style="s">Jisu ah Pilat reeni siitwanta</para>
  <para style="r">(<ref loc="MAT 27:1">Mat 27:1</ref>,<ref loc="MAT 27:2">2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="LUK 23:1-5">Luk 23:1-5</ref>; <ref loc="JHN 18:28-38">Jn 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>Rangkhano di Romwah phokhoh ah mihak phokhoh, Hootthe Nyootte nyia Ngoong awang loong damdi kaankoong suh echaan ih chomui rumta. Neng ih Jisu ah jaanruh ih khak rum ano Pilat suh kowan rumta. <verse number="2" style="v"/>Pilat ih chengta, “Jehudi luungwang ah an tam angkoko?” Jisu ih ngaakbaatta, “Elang eah an ih liihu rah ah.”</para>
  <para style="p">
    <verse number="3" style="v"/>Romwah Phokhoh loong ah ih jirep di Jisu ah mat ih deejoh rumta, <verse number="4" style="v"/>eno Pilat ih we chengta, “An ih tanih ngaakbaat rumko? Boichaat thaak uh neng ih liilaang rum halu rah ah!”</para>
  <para style="p">
    <verse number="5" style="v"/>Erah di uh Jisu ah khaapsiit taan toon jeng suh tanookta, eno Pilat ah paatjaata.</para>
  <para style="s">Jisu tek haat baat rumta</para>
  <para style="r">(<ref loc="MAT 27:15-26">Mat 27:15-26</ref>; <ref loc="LUK 23:13-25">Luk 23:13-25</ref>; <ref loc="JHN 18:28-38">Jn 18:28-38</ref>)</para>
  <para style="p">
    <verse number="6" style="v"/>Khopui kuwaang<note caller="+" style="f"><char style="fr" closed="false">15:6 </char><char style="fq" closed="false">Khopui kuwaang</char><char style="ft" closed="false">English di ‘Passover’ kuwaang et liiha</char></note> rookwih Pilat ih phaatak ni tongte mina, marah noksong ih danje ah erah daap haat ah neng banlam angta. <verse number="7" style="v"/>Erah tokdi mih wasiit heh men ah Barabas changrook di mih tek haat arah phaatak ni sakta. <verse number="8" style="v"/>Paang hoh di mamah kah ih daap haat ah erah likhiik phaatak ni tongte daap haat suh miloong ah Pilat reeni wang rumha no cheng wang rum taha. <verse number="9" style="v"/>Pilat ih cheng rumta, “Ngah ih seng suh Jehudi luungwang ah toomdaap kohe ih tam li han?” <verse number="10" style="v"/>Heh ih jatcho angta, Romwah phokhoh loong ih Jisu ah rapne ih miksuh rum ano jokoh wan rum tahang eah.</para>
  <para style="p">
    <verse number="11" style="v"/>Eno Romwah Phokhoh loong ih miloong asuh Jisu lah angthang ih Barabas ah daap haat theng ih Pilat reeni rojeng thuk rumta. <verse number="12" style="v"/>Pilat ih miloong asuh we cheng rumta, “Erah ang abah, sen ih Jehudi luungwang et liihan asuh ngah ih tumjih et ang?”</para>
  <para style="p">
    <verse number="13" style="v"/>Neng ah ngaak riing rumta, “Bangphak nah tek rabbot theng!”</para>
  <para style="p">
    <verse number="14" style="v"/>Pilat ih we chengta, “Heh tumjih thetre kota?”</para>
  <para style="p">Miloong ah ih erong ih huk riing rumta, “Banphak nah tek rabbot theng!”</para>
  <para style="p">
    <verse number="15" style="v"/>Noksong ah roonthuk suh li ano, Pilat ih Barabas ah daapta. Eno Jisu ah ruh ih buh thuk ano bangphak nah rabbot suh korumta.</para>
  <para style="s">Raabante loong ih Jisu ah thaangju rumta</para>
  <para style="r">(<ref loc="MAT 27:27-31">Mat 27:27-31</ref>; <ref loc="JHN 19:2">Jn 19:2</ref>,<ref loc="JHN 19:3">3</ref>)</para>
  <para style="p">
    <verse number="16" style="v"/>Raabante<note caller="+" style="f"><char style="fr" closed="false">15:16</char><char style="fq" closed="false">Raabante</char><char style="ft" closed="false">English di ‘soldier’ et liiha.</char></note> loong ih Jisu ah Kobono<note caller="+" style="f"><char style="fr" closed="false">15:16</char><char style="fq" closed="false">Kobono</char><char style="ft" closed="false">English di ‘Governor’ et liiha.</char></note> nokmong ni neng joonte ah lompoon rum ano siitwan rumta. <verse number="17" style="v"/>Neng ih Jisu ah elootwah saangjang songloh<note caller="+" style="f"><char style="fr" closed="false">15:17</char><char style="fq" closed="false">Saangjang songloh</char><char style="ft" closed="false">Roman nok hah samsong elootwah ang arah rom arang hoon di kapjih. </char></note> ih choom rum ano nyia suk khopok ah hoon rum ano, heh khoni pokkoh rumta. <verse number="18" style="v"/>Eno neng ih lakkong ih soom rumta: “Jehudi loong luungwang ah Roitang toomtong kah!” <verse number="19" style="v"/>Jisu khoh adi chaanthah ih buh rum leh neng took rah ih took et rum, eno neng lakuh adi tong rum leh paanglaang soom et rumta. <verse number="20" style="v"/>Eno neng ih jen thaangju joonnaam rum ano heh sak nawa saangjang samsong ah we ngaakkhook rumta, eno heh nyuh akhat ah we kap thuk rumta. Eno bangphak na tek haat wan suh siitwan rumta.</para>
  <para style="s">Jisu bangphak ni tek rabbot wanta</para>
  <para style="r">(<ref loc="MAT 27:32-44">Mat 27:32-44</ref>; <ref loc="LUK 23:26-43">Luk 23:26-43</ref>; <ref loc="JHN 19:17-27">Jn 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v"/>Lam ni mih wasiit heh men ah Simoon erah samnuthung adi heh deek nawa wangha rah chomui rumta, no heh suh raabante loong ih Jisu bangphak ah roong huiwanho ih laatbaat rumta. (Simoon langla Sirini nok hah angta, heh sah rah Alekjender nyia Rupus angta.) <verse number="22" style="v"/>Neng ih Jisu ah Golgotha adi siitwan rumta. Golgotha rah, “Mih khoraang hah suh liita.” <verse number="23" style="v"/>Erah di heh suh kham damdi phon ah woorum ano taat korumta, ang abah uh Jisu ih tajokta. <verse number="24" style="v"/><note caller="-" style="x"><char style="xo" closed="false">15:24 </char><char style="xt" closed="false"><ref loc="PSA 22:18">Rsb 22:18</ref></char></note>Eno neng ih bangphak adi tek rabbot rumta, henyuh hekhat ah jopche rum ano, o ih marah chep ah choh ah ih wenhaat rumta. <verse number="25" style="v"/>Heh ah rangkhah phek kaat tok saapoot akhuh di tek rapbotta. <verse number="26" style="v"/>Heh kaanju jengkhaap amet raangta, “Jehudi luungwang.” <verse number="27" style="v"/>Jisu damdi ehuh wanyi, esiit ah dak hekko esiit ah jaawako ih wak rabbot rumta. <verse number="28" style="v"/><note caller="-" style="x"><char style="xo" closed="false">15:28 </char><char style="xt" closed="false"><ref loc="ISA 53:12">Isa 53:12</ref></char></note> [Emamah Rangteele ni liiha amiisak angta. Heh ah mih putte likhiik ih roong hoonta.]<note caller="+" style="f"><char style="fr" closed="false">15:28 </char><char style="ft" closed="false">Mararah leedap adi wet hin 28 tawak raangka</char><char style="fq" closed="false">Emamah Rangteele ni liiha amiisak angta. “Heh ah mih putte likhiik ih roong hoonta.” </char></note></para>
  <para style="p">
    <verse number="29" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">15:29 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:7">Rsb 22:7</ref>; <ref loc="PSA 109:25">109:25</ref>; <ref loc="MRK 14:58">Mk 14:58</ref>; <ref loc="JHN 2:19">Jn 2:19</ref> </char>
    </note>Erah di daankhoomte miloong ih Jisu ah neng tok ah nyoongleh chikram kaanju et rumta: “Aleh! An ih bah Rangteenok<note caller="+" style="f"><char style="fr" closed="false">15:29 </char><char style="ft" closed="false">Rangteenok: Ehak banlam di esiit luulu angta Rangte nok ah, eno erah di Romwah phokhothoon bah jen nopta. </char></note> ah thaak hoom angno sa jom mongdoh we hoon ang ih laangma liitu! <verse number="30" style="v"/>Amadoh an teewah ah jen pang ubah, bangphak dowa edat khoom ih ho ba!”</para>
  <para style="p">
    <verse number="31" style="v"/>Erah likhiikkhiik romwah phokhoh loong nyia Hootthe Nyootte loong ah ih we kaanju liilaang rumta, “Heh ih mih abah pang kah eta, heteewah ah tajen pangka! <verse number="32" style="v"/>Taat sokthaak ih arah Kristo ah, Ijirel luungwang ah, amadoh bangphak dowa jen dat khoom koha bah seng ih uh heh suh hanpi et ih!”</para>
  <para style="p">Jisu reeni rabbotta wanyi rah ih uh emamah ih roong kaanju nyuuta.</para>
  <para style="s">Jisu tekta</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mat 27:45-56</ref>; <ref loc="LUK 23:44-49">Luk 23:44-49</ref>; <ref loc="JHN 19:28-30">Jn 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v"/>Rangnithung di deek rep ni rang ah nakdatta, eno erah koonta jom raang ih nakdatta. <verse number="34" style="v"/><note caller="-" style="x"><char style="xo" closed="false">15:34 </char><char style="xt" closed="false"><ref loc="PSA 22:1">Rsb 22:1</ref></char></note>Saasong saapoot jom di Jisu ah erongwah ih riinghuungta, <char style="tl">“Eloi, Eloi, Lema Sabachthani?”</char> erah langla, “Nga Rangte, Nga Rangte,” an ih ngah mamet thiinhaat halang?”</para>
  <para style="p">
    <verse number="35" style="v"/>Erah dowa mararah miloong ih japchaat rum ano jeng rumta, “Boichaat thaak an heh ih Elija poonha!” <verse number="36" style="v"/><note caller="-" style="x"><char style="xo" closed="false">15:36 </char><char style="xt" closed="false"><ref loc="PSA 69:21">Rsb 69:21</ref></char></note> Mih wasiit ih nyulep ah pi ano soon ra taha, eno nyulep ah thaangneejih kham adi tem ano, chaanthah tuuba adi rapkhakta. Eno chaanthah ah toonpi ano Jisu tui adi mook suta, eno liita, “Ma! Ban sok ih Elija ra haano bangphak dowa tam datthiin ra thaak ha!”</para>
  <para style="p">
    <verse number="37" style="v"/>Jisu ah erongwah ih riinghuung ano tiita.</para>
  <para style="p">
    <verse number="38" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">15:38 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 26:31-33">Hpkt 26:31-33</ref>
      </char>
    </note> Rangteenok ni nyuh tinta rah hekhoh nawa ih helah tuk ih kho nyi ih khoodatta. <verse number="39" style="v"/>Arami saahaap ah bangphak ngathong ni chap adi Jisu mame tiita<note caller="+" style="f"><char style="fr" closed="false">15:39 </char><char style="fq" closed="false">tiita;</char><char style="ft" closed="false">Mararah leedap adi</char><char style="fq" closed="false">riinghuung ano tiita.</char></note> erah sok ano jengta, “Arah mih abah amiimi Rangte sah ju angta!”</para>
  <para style="p">
    <verse number="40" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">15:40 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 8:2">Luk 8:2</ref>,<ref loc="LUK 8:3">3</ref></char>
    </note>Erah di mararah minuh loong ih, haloot nawa ih ban sok rumta. Erah dung adi Meeri Megdalen, Jeems no nooliwah ah nyia Josep nuh Meeri erah damdi Salomi loong ah angta. <verse number="41" style="v"/>Heh Galili ni ang tokdi neng loong ah Jisu lilih ih rum ano naririh kah ih sokboi rumta. Nuhoh loong uh hantek heh damdi Jerusalem ni roong raakte loong uh erah di eje roong ang rumta.</para>
  <para style="s">Jisu mangbengta</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mat 27:57-61</ref>; <ref loc="LUK 23:50-56">Luk 23:50-56</ref>; <ref loc="JHN 19:38-42">Jn 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42-43" style="v"/>Rangja ko ang damdam Arimathia nawa Josep thok taha. Heh uh Jehudi loong Ngoong awang dung ni esiit esoongraang mina angta, eno heh ih Rangte Hasong raak ah bansokte angta. Erah sa ah Ban khookham sa angta (erah langla Jehudi loong naangtongsa saakhoh rah angta), eno Josep ah lacho laphaan ih wang ano Pilat dowa Jisu mang ah cheng wangta. <verse number="44" style="v"/>Pilat ah Jisu jen tek etta ih chaat ano paatjaata. Arami saahaap ah poon ano Jisu abi dook nih tiita ih chengta. <verse number="45" style="v"/>Saahaap ih baatta rah chaat ano, Pilat ih Josep suh heh mang ah jen toon et uh ih baatta. <verse number="46" style="v"/>Josep ih heh mang loop nyuleep ah reh ano Jisu mang ah datthiin wangta, eno erah nyuh rah ih mang ah dek ano mangbeng theng, jong hah ni thoh aradi thiin kaatta. Eno mangbeng luung adi, jonglo elong tangkoong thiinta. <verse number="47" style="v"/>Meeri Megdalen nyia Josep nuh Meeri rah ih Jisu mang marah di beng ha ih sokkah nyuuta.</para>
  <chapter number="16" style="c"/>
  <para style="s">Tek nawa ngaaksaat</para>
  <para style="r">(<ref loc="MAT 28:1-8">Mat 28:1-8</ref>; <ref loc="LUK 24:1-12">Luk 24:1-12</ref>; <ref loc="JHN 20:1-10">Jn 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v"/>Jehudi naangtongsa rangja ko di, Meeri Megdalen, Jeems nuh Meeri nyia Salomi ih Jisu mang sak adoh hut suh phontum ah reh kah nyuuta. <verse number="2" style="v"/>Naangtongsa rangkhah di, rangsa dong damdam, nengjom mangbeng theng ni karumta. <verse number="3-4" style="v"/>Lam ni karum adi waan rumta, “O ih lekloong kobaat he jonglo heh mangbeng tangkepta rah ah?” (Jonglo ah elong angta.) Eno neng erah di thok ano sok rum adi jonglo ah dokkoong cho angta. <verse number="5" style="v"/>Eno mangbeng luung adi nopkhoom wang rum adi jaaro wasiit jaawako adi songloot epuung ah song ano ban tongta—eno neng ah echo ih rumta.</para>
  <para style="p">
    <verse number="6" style="v"/>“Nakcho an,” heh ih liita. “Ngah ih jat ehang, sen ih Najaret nawa Jisu bangphak ni rapbotta ah jam sok han. Heh adi takah jeeka—heh ejen ngaaksaat eta! Sokthaak an ba heh adi thiin rumta rah ah. <verse number="7" style="v"/><note caller="-" style="x"><char style="xo" closed="false">16:7 </char><char style="xt" closed="false"><ref loc="MAT 26:32">Mat 26:32</ref>; <ref loc="MRK 14:28">Mk 14:28</ref></char></note>Amadoh wang an no heliphante loong asuh arah tiit ah baatwan an, Pitar asuh wakbaat et an: ‘Heh sen ngah ni Galili hah adi wangla; erah nah japtup an, Heh ih baat tahan rah jun ih ah.’”</para>
  <para style="p">
    <verse number="8" style="v"/>Eno neng ah rapne ih mocho rum ano mangbeng dowa doksoon rumta. Eno erah tiit ah nengjom ih echo ih rum ano o suh uh tanaan baat rumta.</para>
  <para style="s">[RUURANG ESE EHAK AH AADI THOONTA] <note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="ft" closed="false">Mararah Grik leedap adi wethiin 9-20 ah tawak raangka</char></note></para>
  <para style="s">Jisu Meeri Megdalen reeni dongta</para>
  <para style="r">(<ref loc="MAT 28:9">Mat 28:9</ref>,<ref loc="MAT 28:10">10</ref>; <ref loc="JHN 20:11-18">Jn 20:11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v"/>[Naangtongsa rangkhano di Jisu ngaaksaat lini, jaakhothoon ah Meeri Megdalen jiinni dongta, erah nuh sak dowa jaakhoni Jisu ih laathih sinet dokphanta. <verse number="10" style="v"/>Heh ah kah ano heh joonte loong suh baat kaatta. Neng ah mongjoong ih ehuung tok ang rumta, <verse number="11" style="v"/>eno heh ih Jisu ah ething, ngah ih nep tuptang ih baat rum adi uh, neng ih tahanpi rumta.</para>
  <para style="s">Jisu heliphante wanyi jiinni dongta</para>
  <para style="r">(<ref loc="LUK 24:13-35">Luk 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v"/>Erah lilih, heliphante wanyi jiinni Jisu ah jaat hoh phan hoh lam ih dongta, deek akaan lamko ni kah nyu adi ah. <verse number="13" style="v"/>Eno nengnyi ah ngaakwang nyu ano heliphante wahoh loong asuh baatwan nyuuta, ang abah uh o reh uh nyi jeng ah tahanpi rumta.</para>
  <para style="s">Asih wasiit loong jiinni Jisu dongta</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mat 28:16-20</ref>; <ref loc="LUK 24:3-49">Luk 24:3-49</ref>; <ref loc="JHN 20:19-23">Jn 20:19-23</ref>; <ref loc="ACT 1:6-8">Esm 1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v"/>Lithoon adi, Jisu asih wasiit heliphante loong reeni, neng chamsat tokdi dongta. Jisu ih kanja et rumta tumeah, neng tuungmaang laje koka no nyia neng ten ah jong ajaan likhiik ang kano ah, erah dam ih mih etupte loong ih ething ih baat rum adi uh lahanpi thang ih tong rumta. <verse number="15" style="v"/><note caller="-" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="ACT 1:8">Esm 1:8</ref></char></note> Jisu ih neng suh baat rumta, “Kah an mongrep thoontang nah Ruurang Ese tiit ah mirep miraang suh tumbaat kaat an. <verse number="16" style="v"/>O ih hanpi ano juungtem ah erah mih ah epui eah; lahanpiite loong ah edut haat et ah. <verse number="17" style="v"/>Hanpiite loong asuh epaatjaatheng jen reejih chaan koh ah: neng ih nga mendoh chiithih laakhah jen dokphan ah; neng jeng ena dongjeng ah; <verse number="18" style="v"/>neng ih puuthih jukkhah ah toonpi ah adoleh me asu mok jok abah neng tathet haatka; khoisatte ah neng lak ih taajoh abah ede eah.”</para>
  <para style="s">Jisu rang ni toonsiit wanta</para>
  <para style="r">(<ref loc="LUK 24:50-53">Luk 24:50-53</ref>; <ref loc="ACT 1:9-11">Esm 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">16:19 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 1:9-11">Esm 1:9-11</ref>
      </char>
    </note>Teesu Jisu ah neng damdi jen roongwaan ano, rang ni toonsiit wanta eno Rangte damdi jaawako tongtheng adi roongtong wangta. <verse number="20" style="v"/>Heliphante loong ah noongrep ni karum ano Ruurang Ese ah tumbaat kaat rumta, eno Teesu ah neng damdi roong mokah no Rangte tiit baat rumta, neng ih epaatjaajih loong re rumta jun ih amiisak ah dongjat thuk rumta.]</para>
</usx>
