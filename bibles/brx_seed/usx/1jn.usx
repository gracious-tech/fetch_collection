<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- Mech</book>
  <para style="h">1 যোহন</para>
  <para style="toc3">1 যোহ</para>
  <para style="toc1">যোহননি প্রথম লাইজাম</para>
  <para style="toc2">1 যোহন</para>
  <para style="mt">যোহননি প্রথম লাইজাম</para>
  <para style="is">রাইফৗথনায়</para>
  <para style="ip">যোহননি প্রথম লাইজামাও বে মৗননৈ খবরফৗর দং (1) ঈশ্বৗরজৗং আরৗ বিনি বিসা হৌয়া যীশু খ্রীষ্টজৗং খৌছেয়াও থানৗ, বেখৌ ফরাইগ্রাফৗরনৗ গৗহৗ হৗনৗ, (2) আরৗ জাইফৗরনি ফৗরৗংনায়ফ্রা খ্রীষ্টজৗং খৌছে জানায়খৌ আদ্রি খৗলামৗ, বে নংখাই ফৗরৗংনায়নিফ্রায় সাবধান জানৗ। বিছৗরনি ফৗরৗংনায়া বেবাদিনৗ মৗন, যীশুআ ঈশ্বৗরনি বিসা হৌয়াব্লা নংথারগৌয়ৈ বিয়ৗ মানসি জানৗ হাথারা। বে ফৗরৗংগ্রাফ্রা গৗরায়ৈ হৗন্দৗং, বাছাইজানৗ হাস্থাইব্লা বে সংসারনি গাছেনখৌবৗ নাগারনৗ নাংগৌ। আরৗ বিছৗরৗ বেখৌবৗ ফৗরৗঙৗ, বাছাইজানায়া মৗজাং মাওনায় কিন্বা ফারা-ফরুসিখৌ অন্নায়জৗং মৗংবৗ সৗমৗন্দৗ গৈয়া। বে ফৗরৗংনায়ফৗরনি লিৎগিরিআ বেখৌনৗ রৗখায়ৈ বুঙৗ, যীশু খ্রীষ্টআ নংথারগৌয়ৈ মানসি মৗন, আরৗ বিয়ৗ গৗরায়ৈ মিথিহৗয়ৗ, জাইফ্রা যীশুখৌ ফৗথায়ৗ, আরৗ ঈশ্বৗরখৌ অন্নৗ, বিছৗরৗ গাওজৗং গাও অনজ্লাইথার নাংনায়।</para>
  <para style="iot">বিষয়ফৗর</para>
  <para style="io1">রাইফৗথনায় <char style="ior">(<ref loc="1JN 1:1-4">1:1–4</ref>)</char></para>
  <para style="io1">স্রাং আরৗ খৗমসি <char style="ior">(<ref loc="1JN 1:5-2:29">1:5—2:29</ref>)</char></para>
  <para style="io1">ঈশ্বৗরনি আরৗ শয়তাননি বিসাফৗর <char style="ior">(<ref loc="1JN 3:1-24">3:1–24</ref>)</char></para>
  <para style="io1">নংগৌ আরৗ গৗরৗন্ঠি <char style="ior">(<ref loc="1JN 4:1-6">4:1–6</ref>)</char></para>
  <para style="io1">অনজ্লাইনৗ নাংগৌ <char style="ior">(<ref loc="1JN 4:7-21">4:7–21</ref>)</char></para>
  <para style="io1">ফৗথাইনায়জৗং ডেহানায় <char style="ior">(<ref loc="1JN 5:1-21">5:1–21</ref>)</char></para>
  <chapter number="1" style="c" sid="1JN 1" />
  <para style="s">গৗঠাংনি খৗথা</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1" />জেয়া জাজেন্নায়নিফ্রায় দংখায়ৗ, জেখৌ জৗঙৗ খৗনাবায়, জেখৌ জৗঙৗ জৗংনি মগনজৗং নুবায়, জেখৌ জৗঙৗ নৗজৗর হৗবায় আরৗ আখাইজৗং দাংবায়-বিখৌ জৗঙৗ গৗঠাং সৗদৗবনি বিষয়ৈ প্রচার খৗলামৗ<note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="JHN 1:1">যোহন 1:1</ref> </char></note>। <verse eid="1JN 1:1" /><verse number="2" style="v" sid="1JN 1:2" />বে গৗঠাংনি বাক্য জেয়া নুজাবায়, জৗঙৗ বিখৌ নুবায় আরৗ বেনি সাক্ষী হৗয়ৗ, আরৗ জৗঙৗ জৗবনৗ গৈয়ি গৗঠাংনি প্রচারখৌ নৗংছৗরনৗ প্রচার <note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="JHN 1:14">যোহন 1:14</ref></char></note>খৗলামৗ, জাইয়া বিফাজৗং লৗগৗছে দংমৗন, আরৗ জৗংজৗং নুজাবায়। <verse eid="1JN 1:2" /><verse number="3" style="v" sid="1JN 1:3" />জৗঙৗ জাইখৌ নুবায় আরৗ খৗনাবায়, বেখৌনৗ নৗংছৗরনৗ প্রাচার খৗলামৗ, জাহাথে নৗংছৗরবৗ জৗংজৗং সহভাগিতা লাজ্লাইনৗ হায়ৗ আরৗ জৗংনি সহভাগিতা লাজ্লাইনাইয়া বিফাজৗং আরৗ বিনি বিসাহৌয়া যীশু খ্রীষ্টজৗং। <verse eid="1JN 1:3" /><verse number="4" style="v" sid="1JN 1:4" />বেফৗর গাছেনখৌবৗ লিৎদৗং জাহাথে জৗংনি রংজানায়া ফুরা জানায় বাদি।<verse eid="1JN 1:4" /></para>
  <para style="s">স্রাং আরৗ খৗমসি</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5" />জৗং বিনিফ্রায় খৗনানায় বে বাথ্রাখৌনৗ নৗংছৗরনৗ মিথিসাৎহৗয়ৗ; ঈশ্বৗরা স্রাং, বিনিয়াও খৗমসিয়া গৈথারা। <verse eid="1JN 1:5" /><verse number="6" style="v" sid="1JN 1:6" />যদি জৗঙৗ ঈশ্বৗরজৗং সহভাগিতাও দং হৗন্নানৈ দাবি খৗলামনানৈবৗ খৗমসিয়াও থাবায়ৗব্লা, জৗঙৗ ছৗলৈয়ৗ, আরৗ নংগৌখৌ মাওয়া। <verse eid="1JN 1:6" /><verse number="7" style="v" sid="1JN 1:7" />নাথায় জেরৈ বিয়ৗ স্রাঙাও দং, বেবাদিনৗ জৗংবৗ স্রাঙাও থাবায়ৗ, জৗংহা গাওজৗং গাও সহভাগিতা লাজ্লাইনাইয়া দং, আরৗ যীশুনি থৈ, বিনি বিসাহৌয়া, জৗংখৌ গাছেন পাপনিফ্রায় গৗগৗ খৗলামৗ। <verse eid="1JN 1:7" /><verse number="8" style="v" sid="1JN 1:8" />জৗঙৗ যদি পাপ গৈয়া হৗন্নানৈ দাবি খৗলামৗব্লা, জৗং গাওখৌনৗ গাও ঠগাইয়ৗ আরৗ সত্যয়া জৗংনি গেজেরাও গৈয়া। <verse eid="1JN 1:8" /><verse number="9" style="v" sid="1JN 1:9" />নাথায় জৗঙৗ জৗংনি পাপফৗরখৌ ঈশ্বৗরনিয়াও সিমান লাব্লা, ঠিক আরৗ বিয়ৗ বিশ্বস্ত, আরৗ বিয়ৗ জৗংনি পাপফৗরখৌ ক্ষমা হৗনায় আরৗ জৗংখৌ গাছেন অন্যায় খামানিফৗরনিফ্রায় ফৗথারনায়। <verse eid="1JN 1:9" /><verse number="10" style="v" sid="1JN 1:10" />যদি জৗঙৗ পাপ মাওয়াখৈ হৗন্নানৈ দাবি খৗলামৗব্লা, জৗঙৗ ঈশ্বৗরখৌ ঠগায়সুলা খৗলামৗ আরৗ বিনি বাক্যয়া জৗংনিয়াও গৈয়া।<verse eid="1JN 1:10" /></para>
  <chapter eid="1JN 1" />
  <chapter number="2" style="c" sid="1JN 2" />
  <para style="s">খ্রীষ্টআ জৗংনি হেফাজাব হৗগ্রা</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1" />আংনি আংগৗ বিসাফৗর, আঙৗ বেখৌ নৗংছৗরনৗ লিৎহৎদৗং জাহাথে নৗংছৗরৗ পাপ মাওয়া। নাথায় যদি ছৗরবা পাপ মাওয়ৗ, জৗংনি জানানৈ বিফানিয়াও-খাওলায়নৗ সাছে উখিল দংখায়ৗ, বিয়ৗ বে ধৗরৗমিয়া যীশু খ্রীষ্টআনৗ। <verse eid="1JN 2:1" /><verse number="2" style="v" sid="1JN 2:2" />বিয়ৗ জৗংনি পাপফৗরখৌ প্রায়শ্চিত্তনি থাখৈ বুলি হৗবায়, আরৗ জৗংনি থাখৈ বান অৗঙা নাথায় সংসারনি বয়নিবৗ পাপফৗরনি থাখৈ। <verse eid="1JN 2:2" /><verse number="3" style="v" sid="1JN 2:3" />জৗঙৗ মিথিগৌ যে জৗঙৗ যদি বিনি আদেশফৗরখৌ মানিয়ৗ অব্লা জৗঙৗ বিখৌ মিথিগৌ। <verse eid="1JN 2:3" /><verse number="4" style="v" sid="1JN 2:4" />ছৗরবা বুঙৗব্লা, “আং বিখৌ মিথিগৌ,” নাথায় বিনি আদেশফৗরখৌ মানিয়াব্লা, বিয়ৗ ছৗলৈগ্রা আরৗ বিনিয়াও নংথারগৌ গৈয়া। <verse eid="1JN 2:4" /><verse number="5" style="v" sid="1JN 2:5" />নাথায় যদি ছৗরবা বিনি খৗথাফৗরখৌ মানিয়ৗব্লা, ঈশ্বৗরনি অন্নায়া নংথারগৌ বিছৗরনি গেজেরাও ফুরা জায়ৗ। বেখৌ হায় জৗঙৗ মাব্রৈ মিথিগৌ যে জৗঙৗ বিনিয়াও ঠাংনানৈ দং। <verse eid="1JN 2:5" /><verse number="6" style="v" sid="1JN 2:6" />ছৗরবা বিনিয়াও থানায়নি দাবি খৗলামব্লা, জেরৈ যীশুআ খৗলামা মৗন বিবাদি জীবন যাপন খৗলামথারনাংনায়।<verse eid="1JN 2:6" /></para>
  <para style="s">গৗদান আদেশ</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7" />আংগৗ লৗগৗফৗর, আং নৗংছৗরনৗ গৗদান আদেশ লিৎনাখৗছৈ, নাথায় জাজেন্নায়নিফ্রায় নৗংছৗর খৗনাবৗনায় বে গৗজাম আদেশখৌনৗ। বে গৗজাম আদেশনি বাথ্রাখৌনৗ নৗংছৗরৗ খৗনাদৗং। <verse eid="1JN 2:7" /><verse number="8" style="v" sid="1JN 2:8" />অব্লাবৗ আং দা নৗংছৗরনৗ গৗদান আদেশ লিৎনাইয়া, খ্রীষ্টনি জীবন আরৗ নৗংছৗরনি জীবনা বে নংগৌখৌ দিন্ঠিয়ৗ, মানৗনা খৗমসিয়া জৗবলাংদৗং আরৗ নংথারগৌয়ৈ স্রাঙা সিগাঙাওনৗ জৗংসাৎবায়। <verse eid="1JN 2:8" /><verse number="9" style="v" sid="1JN 2:9" />ছৗরবা দাবি খৗলামৗব্লা আঙৗ স্রাঙাও দং নাথায় গাওনি ফংবায় কিন্বা বিনানাওখৌ মুগৈয়ৗব্লা, বিয়ৗ দাবৗ খৗমসিয়াওনৗ দং। <verse eid="1JN 2:9" /><verse number="10" style="v" sid="1JN 2:10" />ছৗরবা গাওনি ফংবায় আরৗ বিনানাওখৌ অন্নৗব্লা, বিয়ৗ স্রাঙাও থায়ৗ, আরৗ বিনিয়াও বিখৌ ছৌখুঠুনায় খৗলামনায় অৗঙা। <verse eid="1JN 2:10" /><verse number="11" style="v" sid="1JN 2:11" />নাথায় ছৗরবা গাওনি ফংবায়ফৗর কিন্বা বিনানাওফৗরখৌ মুগৈয়ৗ, বিয়ৗ খৗমসিয়াওনৗ থায়ৗ আরৗ খৗমসিয়াও থাবায়ৗ আরৗ বিয়ৗ গাও ববেহা থাঙৗ, বেখৌনৗ মিথিয়া; মানৗনা খৗমসিয়া বিখৌ খানা খৗলামবায়। <verse eid="1JN 2:11" /><verse number="12" style="v" sid="1JN 2:12" />আংনি আংগৗ বিসাফৗর, আং নৗংছৗরনৗ লিৎদৗং, মানৗনা বিনি মুঙৈ নৗংছৗরনি পাপফৗরনি হিসাবমা ক্ষমা হৗজাবায়। <verse eid="1JN 2:12" /><verse number="13" style="v" sid="1JN 2:13" />বিফাফৗর, আঙৗ নৗংছৗরনৗ লিৎহৎদৗং, মানৗনা জাইয়া জাজেন্নায়নিফ্রায় দং, বিখৌ নৗংছৗর মিথিনায়খায়, আঙৗ নৗংছৗরনৗ লিৎহৎদৗং। জৗহৗলাওফৗর, নৗংছৗরৗ গাজ্রি সাছেখৌ ফেজেনবায়খায়, আঙৗ বেখৌ নৗংছৗরনৗ লিৎহৎদৗং। <verse eid="1JN 2:13" /><verse number="14" style="v" sid="1JN 2:14" />আংনি বিসাফৗর, আঙৗ নৗংছৗরনৗ লিৎহৎদৗং, মানৗনা নৗংছৗরৗ বিফাখৌ মিথিগৌ, বিফাফৗর, আঙৗ নৗংছৗরনৗ লিৎহৎদৗং, মানৗনা জাইয়া জাজেন্নায়নিফ্রায় দং, বেখৌ নৗংছৗরৗ মিথিগৌ। জৗহৗলাওফৗর, আঙৗ নৗংছৗরনৗ লিৎদৗং, মানৗনা নৗংছৗরৗ বৗলৗগ্রা, ঈশ্বৗরনি খৗথায়া নৗংছৗরনিয়াও থায়ৗ, আরৗ নৗংছৗরৗ গাজ্রি সাছেখৌ ফেজেনবায়।<verse eid="1JN 2:14" /></para>
  <para style="s">সংসারখৌ অন্নৗ নাঙা</para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15" />নৗংছৗরৗ সংসারখৌ কিন্বা সংসারাও জায়খিয়া জিনিসফৗরখৌ অন্নৗ নাঙা। ছৗরবায়া সংসারখৌ অন্নৗব্লা, বিছৗরনিয়াও বিফানি সত্যয়া গৈয়া। <verse eid="1JN 2:15" /><verse number="16" style="v" sid="1JN 2:16" />সংসারাও গাছেনখৌবৗ এরৈবাদি মৗদৗমনি লুবৈনায়, মগননি লুবৈনায় আরৗ জৗংনে যে বিষয় দং বিখৌনৗ ডুগা খৗলামনায়, বে গাছেনবৗ বিফানিফ্রায় অৗঙা, নাথায় সংসারনিফ্রায়সৗ ফৈয়ৗ। <verse eid="1JN 2:16" /><verse number="17" style="v" sid="1JN 2:17" />বে সংসার আরৗ বে লুবৈনাইয়া থৈলাংবায়, নাথায় জাইয়া ঈশ্বৗরনি গৗসৗ বাদি মাওয়ৗ, বিয়ৗ জেব্লাইবৗ থায়ৗ।<verse eid="1JN 2:17" /></para>
  <para style="s">খ্রীষ্টনি বিসারু</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18" />বিসাফৗর, জৗবনায় সময়া খাঠৈ জাবায়, আরৗ জৗরৈ নৗংছৗরৗ খৗনাখাবায় যে খ্রীষ্টশত্রুআ ফৈদৗংছৈ আরৗ দানৗ খ্রীষ্টশত্রুআ গৗবাং নুজাফৈখাবায়, বেজৗংনৗ জৗবনায়নি সময়া খাঠৈছৈ হৗন্নানৈ জৗঙৗ মিথিয়ৗ। <verse eid="1JN 2:18" /><verse number="19" style="v" sid="1JN 2:19" />নংথারগৌয়ৈ বিছৗরৗ জৗংনি দলনি অৗঙা মৗন, বিনিখাইনৗ বিছৗরৗ জৗংনিফ্রায় অৗংখাৎলাংবায়, মানৗনা বিছৗরৗ জৗংনি দল মৗনব্লা, বিছৗরৗ জৗংজৗং থানায়মৗন। নাথায় বিছৗর জৗংনিফ্রায় অৗংখাৎলাংনায়জৗং বিছৗর রাওবৗ জৗংনি দলনি অৗঙা মৗন হৗন্নানৈ, বেখৌ রৗখায়ৈ দিন্ঠিয়ৗ। <verse eid="1JN 2:19" /><verse number="20" style="v" sid="1JN 2:20" />নাথায় নৗংছৗরৗ গৗথার মৗনছেনিফ্রায় অভিষেক মৗন্দৗং, আরৗ নৗংছৗরৗ গাছেনবৗ নংগৌখৌ মিথিগৌ। <verse eid="1JN 2:20" /><verse number="21" style="v" sid="1JN 2:21" />নৗংছৗরৗ নংগৌখৌ মিথিয়া হৗন্নানৈ আঙৗ লিৎবায়, বে অৗঙা, নাথায় নৗংছৗর মিথিখাগৌখায়সৗ আঙৗ লিৎদৗং, আরৗ মানৗনা নংথারগৌনিফ্রায় ছৗলৈনায়া ফৈয়া। <verse eid="1JN 2:21" /><verse number="22" style="v" sid="1JN 2:22" />ছৗলৈগ্রায়া ছৗর? বিয়ৗ জাইয়া অস্বীকার খৗলামৗ যে যীশুয়ানৗ মসিহ, বেবাদি মানসিয়ানৗ খ্রীষ্টশত্রুআ বিয়ৗ বিফা আরৗ বিসা সানৈখৌবৗ অস্বীকার খৗলামৗ। <verse eid="1JN 2:22" /><verse number="23" style="v" sid="1JN 2:23" />মানৗনা ছৗরবায়া জাইয়া বিসাজ্লাখৌ অস্বীকার খৗলামৗ বিয়ৗ বিফাজৗং গৈয়া, জাইয়া বিসাজ্লাখৌ সিমান লায়ৗ বিয়ৗ বিফাজৗং দং। <verse eid="1JN 2:23" /><verse number="24" style="v" sid="1JN 2:24" />জাজেন্নায়নিফ্রায় নৗংছৗরৗ জেখৌ খৗনাবায় বেফৗরখৌ গৗসৗয়াও লা। নৗংছৗরৗ বেফৗরখৌ গৗসৗয়াও লাখিয়ৗব্লা, নৗংছৗরৗ জেব্লাইবৗ বিসাজ্লা আরৗ বিফানিয়াও থানায়। <verse eid="1JN 2:24" /><verse number="25" style="v" sid="1JN 2:25" />আরৗ বেনৗ জৗবনৗ গৈয়ি গৗঠাঙা, বেখৌনৗ জৗংনৗ বিয়ৗ জবান হৗখাদৗং। <verse eid="1JN 2:25" /><verse number="26" style="v" sid="1JN 2:26" />জাইফ্রা নৗংছৗরখৌ গুবুন লামাজৗং লাংনৗ হাস্থায়দৗং, বিছৗরনি বিষয়ৈ খৗথা বুংনৗ আঙৗ বেখৌ নৗংছৗরনৗ লিৎদৗং। <verse eid="1JN 2:26" /><verse number="27" style="v" sid="1JN 2:27" />নাথায় নৗংছৗরৗ খ্রীষ্টনিফ্রায় অভিষেকখৌ মৗনবায়, বিয়ৗ নৗংছৗরনিয়াও থানায়, নৗংছৗরৗ রাওজৗংবৗ ফৗরৗংজানৗ নাংনায় অৗঙা। মানৗনা বিনি জিউয়ানৗ নৗংছৗরনৗ মৗনফ্রৗমখৌবৗ ফৗরৗঙৗ, আরৗ বিনি ফৗরৗংনায়া নংথারগৌ, নংখাই অৗঙা। বিনিখাইনৗ জিউনি ফৗরৗংনায় বাদি খ্রীষ্টনিয়াও থা। <verse eid="1JN 2:27" /><verse number="28" style="v" sid="1JN 2:28" />আরৗ দা, আংনি আংগৗ বিসাফৗর, জেব্লাইবৗ নৗংছৗরৗ খ্রীষ্টনিয়াও থা, বিয়ৗ জেব্লা নুজাফৈনায়, অব্লা জৗংনি ফুরা ফৗথাইনায়া আরৗ বিনি ফৈনায়াও লাজিনাঙা বাদি। <verse eid="1JN 2:28" /><verse number="29" style="v" sid="1JN 2:29" />যদি নৗংছৗরৗ মিথিগৌ যে বিয়ৗ ধৗরৗমিয়া, অব্লা নৗংছৗরৗ বেখৌবৗ মিথি, সঠিক মাওগ্রায়াসৗ ঈশ্বৗরনি বিসা।<verse eid="1JN 2:29" /></para>
  <chapter eid="1JN 2" />
  <chapter number="3" style="c" sid="1JN 3" />
  <para style="s">ঈশ্বৗরনি বিসাফৗর</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1" />ঈশ্বৗরা জৗংনৗ যে অন্নায়খৌ হৗবায় বেয়ৗ বেছেবাং গেদেৎ যে জৗংখৌ ঈশ্বৗরনি বিসাফৗর বুংখজাথার নাংনায়, আরৗ থারৈনৗ জৗঙৗ বেনৗ। সংসারা জৗংখৌ চিনাইয়া, বেনি কারননা জাবায় সংসারা বিখৌ ছিনাইয়াখৈ মৗন<note caller="+" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="JHN 1:12">যোহন 1:12</ref> </char></note>। <verse eid="1JN 3:1" /><verse number="2" style="v" sid="1JN 3:2" />আংগৗ লৗগৗফৗর, দা জৗঙৗ ঈশ্বৗরনি বিসাফৗর আরৗ জৗঙৗ যে মা জানায় দাবৗ মিথিহৗয়া জাখৈ। নাথায় জৗঙৗ মিথিগৌ জেব্লা খ্রীষ্টআ নুজানায়, জৗঙৗ বিবাদি জানায়, মানৗনা জৗঙৗ বিখৌ জেরৈ বাদি নুনৗ মৗন্নায়। <verse eid="1JN 3:2" /><verse number="3" style="v" sid="1JN 3:3" />বয়বৗ জাইফৗরহা বে আশা দং বিছৗরৗ গাওখৌ গৗথার খৗলামৗ, ঠিক জেরৈ বিয়ৗ গৗথার। <verse eid="1JN 3:3" /><verse number="4" style="v" sid="1JN 3:4" />জাইফ্রা পাপ মাওয়ৗ বিছৗরৗ আইনখৌ ছিফাইয়ৗ, নংগৌ ঈশ্বৗরখৌ এৎগারনায়ানৗ পাপ। <verse eid="1JN 3:4" /><verse number="5" style="v" sid="1JN 3:5" />নাথায় নৗংছৗরৗ মিথিগৌ, জৗংনি পাপখৌ লাংনৗ খ্রীষ্টআ নুজাফৈদৗং। আরৗ বিনিয়াও মৗংবৗ পাপ গৈয়া<note caller="+" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="JHN 1:29">যোহন 1:29</ref> </char></note>। <verse eid="1JN 3:5" /><verse number="6" style="v" sid="1JN 3:6" />জাইফ্রা বিনিয়াও থায়ৗ বিছৗরৗ পাপ খৗলামবায় থায়া, জাইফ্রা পাপ খৗলামবায় থায়ৗ বিয়ৗ খ্রীষ্টখৌ নুয়াখৈ কিন্বা মিথিয়া। <verse eid="1JN 3:6" /><verse number="7" style="v" sid="1JN 3:7" />বিসাফৗর, নৗংছৗরৗ রাওজৗংবৗ গুবুন লামা থাংনায়াও দাদৈদেনজা। ছৗরবা সাছে ধৗরৗমখৌ ঠিক মাওয়ৗ, জেরৈবাদি বিয়ৗ ধৗরৗমিয়া। <verse eid="1JN 3:7" /><verse number="8" style="v" sid="1JN 3:8" />জাই সাছেয়া পাপ খৗলামবায় থায়ৗ বিয়ৗ শয়তানিফ্রায়, মানৗনা শয়তানা সিগাংনিফ্রায়নৗ পাপ খৗলামবায় থায়ৗ। মানৗনা ঈশ্বৗরনি বিসা হৌয়াআ নুজাফৈদৗং। শয়তাননি হাবাফৗরখৌ সংহার খৗলামনৗ <verse eid="1JN 3:8" /><verse number="9" style="v" sid="1JN 3:9" />ছৗরবা সাছে বিনিয়াও গৗঠাংনি থাখৈ দাবি খৗলামব্লা ঈশ্বৗরনি ফ্রায় সারিজানায়ফ্রা, রাওবৗ পাপ খৗলামবায় থায়া, মানৗনা বিছৗরনিয়াও ঈশ্বারনি বিগৎনা থালাংবায়; বিছৗরৗ পাপ খৗলামবায় থানৗহায়া, মানৗনা বিছৗরৗ ঈশ্বৗরনি ফ্রায় জৗনৗম জাদৗং। <verse eid="1JN 3:9" /><verse number="10" style="v" sid="1JN 3:10" />বেবাদি জৗঙৗ মিথিগৌ যে ছৗর শয়তাননি বিসা, যে জাইয়া সঠিক খামানিখৌ মাওয়াখৈ বিয়ৗ ঈশ্বৗরনি বিসা অৗঙা, কিন্বা ছৗরবা সাছে বিছৗরনি ফংবায় আরৗ বিনানাওফৗরখৌ অননা।<verse eid="1JN 3:10" /></para>
  <para style="s">অনজ্লাইনায় আরৗ মুগৈজ্লাইনায়নি বিষয়</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11" />মানৗনা বে বাথ্রাখৌ নৗংছৗরৗ জাজেন্নায়নিফ্রায় খৗনাবৗদৗং, জৗঙৗ গাওজৗং গাও অনজ্লাইথার নাংগৌ<note caller="+" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="JHN 13:34">যোহন 13:34</ref></char></note>। <verse eid="1JN 3:11" /><verse number="12" style="v" sid="1JN 3:12" />জৗঙৗ কয়িন বাদি জানৗ নাংথারা, বিয়ৗ শয়তাননি মানসি মৗন, আরৗ বিয়ৗ গাওনি ফংবায়খৌ সিথাৎদৗং। কয়িনআ বিখৌ মানৗ সিথাৎখৌ? মানৗনা কয়িনআ গাওনৗ গাজ্রি হাবাফৗর মাওদৗং মৗন, আরৗ বিনি ফংবায়া ধৗরৗমিয়ানি হাবাসৗ<note caller="+" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="GEN 4:8">জাগাইজেন্নায় 4:8</ref> </char></note> মাওদৗং মৗন। <verse eid="1JN 3:12" /><verse number="13" style="v" sid="1JN 3:13" />বিনিখাইনৗ আংনি ফংবায়ফৗর আরৗ বিনানাওফৗর, সংসারনি মানসিফ্রা নৗংছৗরখৌ মুগৈয়ৗব্লা নৗংছৗরৗ বৗথিয়া দানাং। <verse eid="1JN 3:13" /><verse number="14" style="v" sid="1JN 3:14" />জৗঙৗ মিথিগৌ যে জৗঙৗ থৈনায়নিফ্রায় গৗঠাঙাও বাৎস্লাইবায়, মানৗনা জৗঙৗ জৗংনি ফংবায়ফৗরখৌ অন্নৗ। ছৗরবায়া অন্নাব্লা, বিয়ৗ<note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="JHN 5:24">যোহন 5:24</ref> </char></note> থৈনায়াও থায়ৗ। <verse eid="1JN 3:14" /><verse number="15" style="v" sid="1JN 3:15" />ছৗরবায়া গাওনি ফংবায় কিন্বা বিনানাওখৌ মুগৈয়ৗব্লা, বিয়ৗ মানসি সিথাৎগ্রা, আরৗ নৗংছৗরৗ মিথিগৌ যে মানসি সিথাৎগ্রানিয়াও জৗবনৗ গৗয়ি গৗঠাঙাও থায়া। <verse eid="1JN 3:15" /><verse number="16" style="v" sid="1JN 3:16" />অন্নায়া মা জৗঙৗ বেখৌ মিথিখাগৌ মানৗনা খ্রীষ্টআ জৗংনি থাখৈ গাওনি জিউখৌ হৗবায়, বেবাদিনৗ জৗংবৗ ফংবায়ফৗর আরৗ বিনানাওফৗরনি থাখৈ জৗংনি জিউখৌ হৗনাংনায়। <verse eid="1JN 3:16" /><verse number="17" style="v" sid="1JN 3:17" />সাছে সংসারনি ধৗনি মানসিয়া গাওনি ফংবায় কিন্বা বিনানাওনি নাংগৌখৌ নুনানৈবৗ অন্নায় গৈয়াব্লা, ঈশ্বৗরনি অন্নায়য়া মাব্রৈ বিনিয়াও থানৗ হাগৌ? <verse eid="1JN 3:17" /><verse number="18" style="v" sid="1JN 3:18" />আংনি আংগৗ বিসাফৗর, জৗংনি অন্নায়া সৗদৗবজৗং বান কিন্বা খৗথা বুংনায়জৗংবান জানৗ নাঙা, নাথায় নৗংছৗরৗ নংথারগৌ হাবা মাওনায়জৗং অনজ্লাই।<verse eid="1JN 3:18" /></para>
  <para style="s">ঈশ্বৗরনি সিগাঙাও গৗহৗজৗং গছংনায়</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19" />বেজৗংনৗ জৗং গাও গাওনি নংথারগৌয়াও দং হৗন্নানৈ মিথিনাংনায়, আরৗ বিনি সিগাঙাও জৗঙৗ মাব্রৈ গৗসৗয়াও শান্তিয়ৈ বিনি উপস্হিতিয়াও গছংনায়। <verse eid="1JN 3:19" /><verse number="20" style="v" sid="1JN 3:20" />যদি জৗংনি গৗসৗয়া জৗংখৌ দোষী খৗলামৗ, জৗঙৗ মিথিগৌ যে ঈশ্বৗরা জৗংনি গৗসৗনি মহানসিন আরৗ বিয়ৗ গাছেনখৌবৗ মিথিগৌ। <verse eid="1JN 3:20" /><verse number="21" style="v" sid="1JN 3:21" />আংগৗ লৗগৗফৗর, জৗংনি গৗসৗয়া যদি জৗংখৌ দোষী খৗলামাব্লা অব্লা ঈশ্বৗরনি সিগাঙাও জৗংহা ভরসা দং। <verse eid="1JN 3:21" /><verse number="22" style="v" sid="1JN 3:22" />আরৗ জেখৌ জৗঙৗ বিয়ৗ বেখৌ মৗন্নৗ, মানৗনা জৗঙৗ বিনি আদেশফৗরখৌ মানিয়ৗ আরৗ বিখৌ খুশি খৗলামৗ। <verse eid="1JN 3:22" /><verse number="23" style="v" sid="1JN 3:23" />আরৗ বেয়ৗ বিনি আদেশ, বিনি বিসাজ্লা যীশু খ্রীষ্টনি মুঙৈ ফৗথাই, আরৗ খ্রীষ্টআ জৗংখৌ থৗন্নায় বাদি গাওজৗং গাও অনজ্লাই<note caller="+" style="x"><char style="xo" closed="false">3:23 </char><char style="xt" closed="false"><ref loc="JHN 5:24">যোহন 5:24</ref> </char></note>। <verse eid="1JN 3:23" /><verse number="24" style="v" sid="1JN 3:24" />জাইফ্রা ঈশ্বৗরনি আদেশফৗরখৌ মানিয়ৗ বিছৗরৗ বিনিয়াও থায়ৗ, আরৗ বিয়ৗ বিছৗরনিয়াও থায়ৗ। আরৗ যে জিউখৌ জৗংনৗ হৗবায় বেয়ৗ দিন্ঠিয়ৗ বিয়ৗ জৗংনিয়াও থায়ৗ।<verse eid="1JN 3:24" /></para>
  <chapter eid="1JN 3" />
  <chapter number="4" style="c" sid="1JN 4" />
  <para style="s">নংথারগৌ জিউ আরৗ নংখাই জিউ</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1" />আংগৗ লৗগৗফৗর, ঈশ্বৗরনি জিউ বিছৗরহা দং না গৈয়া বিখৌ নাগিৎনান নাহাননৗ থাখৈ বিছৗরখৌ পরিক্ষা খৗলাম, বিছৗরনি জিউফ্রা ঈশ্বৗরনিফ্রায় নংগৌ না নৗঙা, বেখৌ আনজাদ লা। মানৗনা সংসারাও গৗবাং নংখাই নবিফৗর অৗংখাৎবায়। <verse eid="1JN 4:1" /><verse number="2" style="v" sid="1JN 4:2" />ঈশ্বৗরনি জিউ নংগৌ না নৗঙা, নৗংছৗরৗ বেজৗংনৗ মিথিনৗ হানায়, জাইয়া যীশু খ্রীষ্টখৌ বেবাদি নৗঙৗ মিথিনৗ হায়ৗ মানসি মহরৈ ফৈদৗং হৗন্নানৈ সিমান লায়ৗ, বেনৗ ঈশ্বৗরনিফ্রায় ফৈনায় জিউয়া। <verse eid="1JN 4:2" /><verse number="3" style="v" sid="1JN 4:3" />নাথায় সাফ্রৗমবৗ জিউয়া যে যীশুখৌ স্বীকার লায়া বিয়ৗ ঈশ্বৗরনিফ্রায় অৗঙা। বে জিউয়া খ্রীষ্টনি বিসারুনিফ্রায়সৗ, বে বিসারু জিউয়া ফৈনায় হৗন্নানৈ নৗংছৗরৗ খৗনাদৗং, আরৗ বে জিউয়া সংসারাও দংখায়ৗ। <verse eid="1JN 4:3" /><verse number="4" style="v" sid="1JN 4:4" />আংনি আংগৗ বিসাফৗর, নৗংছৗরৗ ঈশ্বৗরনি আরৗ বিছৗরখৌ জয় খৗলামবায়, মানৗনা নৗংছৗরনিয়াও জাইয়া দং বিয়ৗ সংসারাও থানায় জিউনিখুরৈবৗ মহানসিন। <verse eid="1JN 4:4" /><verse number="5" style="v" sid="1JN 4:5" />বে নংখাই নবিফ্রা সংসারনি আরৗ সংসারনি খৗথাফৗরখৌ বুঙৗ, আরৗ সংসারা বিছৗরখৌ খৗনাছঙৗ। <verse eid="1JN 4:5" /><verse number="6" style="v" sid="1JN 4:6" />জৗঙৗ ঈশ্বৗরনিফ্রায়, আরৗ জাইফ্রা ঈশ্বৗরখৌ মিথিগৌ, বিছৗর জৗংনিখৌ খৗনাছঙৗ, জাইফ্রা ঈশ্বৗরনি অৗঙা, বিছৗরৗ জৗংনিখৌ খৗনাছংঙা। বেজৗংনৗ জৗঙৗ নংগৌ আরৗ নংখাই জিউখৌ মিথিনৗ হায়ৗ।<verse eid="1JN 4:6" /></para>
  <para style="s">ঈশ্বৗরা অন্নায়</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7" />আংগৗ লৗগৗফৗর, থু জৗঙৗ গাওজৗং গাও অনজ্লাইনি, মানৗনা অন্নায়া ঈশ্বৗরনিফ্রায় ফৈয়ৗ। জাইফ্রা অন্নৗ বিছৗরৗ ঈশ্বৗরনি বিসাফৗর, আরৗ বিছৗরৗ ঈশ্বৗরখৌ মিথিগৌ। <verse eid="1JN 4:7" /><verse number="8" style="v" sid="1JN 4:8" />জাইফ্রা অননা বিছৗরৗ ঈশ্বৗরখৌ মিথিয়া, মানৗনা ঈশ্বৗরা অন্নায়। <verse eid="1JN 4:8" /><verse number="9" style="v" sid="1JN 4:9" />ঈশ্বৗরা গাওনি সাছে বান, বিসাজ্লাখৌ সংসারাও থৗনহৎনানৈ গাওনি অন্নায়খৌ জৗংনি থাখৈ দিন্ঠিবায়, বিজৗংনৗ জৗঙৗ ঠাংনানৈ থায়ৗ। <verse eid="1JN 4:9" /><verse number="10" style="v" sid="1JN 4:10" />অন্নায়া বেনৗ, জৗংনি ঈশ্বৗরখৌ অন্নায়া, বে অৗঙা, নাথায় বিয়ৗ জৗংখৌ অনদৗং আরৗ গাওনি বিসাজ্লাখৌ মৗনছে বুলি হিসাবমৈ জৗংনি পাপফৗরখৌ নিমাহা হৗনৗ থৗনহৎবায়। <verse eid="1JN 4:10" /><verse number="11" style="v" sid="1JN 4:11" />আংগৗ লৗগৗফৗর, বেবাদিনৗ ঈশ্বৗরা জৗংখৌ এছেগ্রাব অনবায়, বিনিখাইনৗ জৗংবৗ গাওজৗং গাও অনজ্লায় নাংগৌ। <verse eid="1JN 4:11" /><verse number="12" style="v" sid="1JN 4:12" />রাওবৗ ঈশ্বৗরখৌ নুয়াখৈ, নাথায় যদি জৗঙৗ গাওজৗং গাও অনজ্লাইব্লা, ঈশ্বৗরা জৗংনিয়াও থায়ৗ, আরৗ বিনি অন্নায়া জৗংনিয়াও ফুরা খৗলামবায়। <verse eid="1JN 4:12" /><verse number="13" style="v" sid="1JN 4:13" />বেখৌ হায় জৗঙৗ মাব্রৈ মিথিগৌ যে জৗঙৗ বিনিয়াও ঠাংনানৈ দং আরৗ বিয়ৗ জৗংনিয়াও থায়ৗ, বিয়ৗ জৗংনৗ গাওনি গৗথার জিউখৌ হৎবায়। <verse eid="1JN 4:13" /><verse number="14" style="v" sid="1JN 4:14" />আরৗ জৗঙৗ নুখাবায় আরৗ সাক্ষ্য হৗয়ৗ, বিফায়া বিসাজ্লাখৌ সংসারনি বাছাইগিরি খৗলামনানৈ থৗনহৎবায়। <verse eid="1JN 4:14" /><verse number="15" style="v" sid="1JN 4:15" />ছৗরবায়া সিমান লায়ৗব্লা, যে যীশুআ ঈশ্বৗরনি বিসাজ্লা হৗন্নানৈ বিয়ৗ ঈশ্বৗরনিয়াও থায়ৗ আরৗ ঈশ্বৗরাবৗ বিছৗরনিয়াও থায়ৗ। <verse eid="1JN 4:15" /><verse number="16" style="v" sid="1JN 4:16" />আরৗ জৗঙৗ নংথারগৌয়ৈ মিথিগৌ আরৗ ফৗথাইয়ৗ, যে ঈশ্বৗরা জৗংখৌ অন্নৗ। ঈশ্বৗরা অন্নৗ, জাইয়া অন্নায়াও থায়ৗ, বিয়ৗ ঈশ্বৗরনিয়াও থায়ৗ আরৗ ঈশ্বৗরা বিনিয়াও থায়ৗ। <verse eid="1JN 4:16" /><verse number="17" style="v" sid="1JN 4:17" />জৗঙৗ যদি বেবাদি অন্নৗব্লা অব্লা জৗংনি গেজেরাও অন্নায়া ফুরা জানায় আরৗ মানৗনা জৗঙৗ সংসারাও খ্রীষ্ট বাদি, বিচারনি দিনাও জৗংনিয়াও ফুরা ফৗথায়নায় থানায়। <verse eid="1JN 4:17" /><verse number="18" style="v" sid="1JN 4:18" />অন্নায়াও গিনায় গৈয়া, নিখুঁত অন্নায়া গাছেন গিনায়খৌ হৗয়ননৗ, মানৗনা গিনাইয়াও সাজা দংফায়ৗ। বিনিখাইনৗ জাই সাছেআ গিয়ৗ বিয়ৗ অন্নায়াও নিখুঁত জায়াখৈ। <verse eid="1JN 4:18" /><verse number="19" style="v" sid="1JN 4:19" />জৗঙৗ অন্নৗ, মানৗনা ঈশ্বৗরা জৗংখৌ অনগ্রৗবায়। <verse eid="1JN 4:19" /><verse number="20" style="v" sid="1JN 4:20" />ছৗরবা হৗনৗব্লা, “আঙৗ ঈশ্বৗরখৌ অন্নৗ,” নাথায় বিয়ৗ ফংবায়খৌ আরৗ বিনানাওখৌ মুগৈয়ৗব্লা, বিয়ৗ ছৗলৈগ্রা। যদি ছৗরবায়া গাওনি ফংবায়খৌ অননা জাইখৌ বিয়ৗ নুবায়, বিয়ৗ ঈশ্বৗরখৌ অন্নৗ হায়া জায়খৌ বিয়ৗ নুয়াখৈ। <verse eid="1JN 4:20" /><verse number="21" style="v" sid="1JN 4:21" />আরৗ বিয়ৗ বে আদেশখৌ হৗবায়, জাইয়া ঈশ্বৗরখৌ অন্নৗ, বিয়ৗ গাওনি ফংবায় আরৗ বিনানাওখৌ অনথারথৗং।<verse eid="1JN 4:21" /></para>
  <chapter eid="1JN 4" />
  <chapter number="5" style="c" sid="1JN 5" />
  <para style="s">সংসারখৌ ফেজেন্নায়</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1" />সাফ্রৗমবৗ জাইয়া ফৗথায়ৗ যে যীশুআনৗ মসিহ হৗন্নানৈ ঈশ্বৗরনি বিসা, আরৗ সাফ্রৗমবৗ জাইয়া বিফাখৌ অন্নৗ, বিয়ৗ বিনি বিসাখৌবৗ অন্নৗ। <verse eid="1JN 5:1" /><verse number="2" style="v" sid="1JN 5:2" />বেবাদিনৗ জৗঙৗ মাব্রৈ মিথিগৌ যে জৗঙৗ ঈশ্বৗরনি বিসাফৗরখৌ অন্নৗ, ঈশ্বৗরখৌ অন্নৗ আরৗ বিনি আদেশফৗরখৌ ফালিয়ৗ। <verse eid="1JN 5:2" /><verse number="3" style="v" sid="1JN 5:3" />মানৗনা ঈশ্বৗরনি আদেশখৌ ফালিনায়ানৗ ঈশ্বৗরখৌ অন্নৗ থাখৈ। আরৗ বিনি আদেশফ্রা জৗংনি থাখৈ গৗব্রাব অৗঙা, <verse eid="1JN 5:3" /><verse number="4" style="v" sid="1JN 5:4" />সাফ্রৗমবৗ জাইয়া ঈশ্বৗরনি বিসা বিয়ৗ সংসারখৌ জয় খৗলামৗ। জৗংনি ফৗথাইনায়া বে জয়খৌ হৗয়ৗ। <verse eid="1JN 5:4" /><verse number="5" style="v" sid="1JN 5:5" />জাইয়া সংসারখৌ জয় খৗলামৗ? বিবান ফৗথাইয়ৗ যে যীশুআ ঈশ্বৗরনি বিসা হৌয়া।<verse eid="1JN 5:5" /></para>
  <para style="s">যীশু খ্রীষ্টখৌ সাক্ষী হৗনায়</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6" />যীশু খ্রীষ্টআ বিনৗ, জাইয়া দৈ আরৗ থৈজৗং ফৈদৗংমৗন। বিয়ৗ দৈজৗং বান অৗঙা, নাথায় দৈ আরৗ থৈনি মাধ্যমজৗং ফৈদৗংমৗন। আরৗ বে নংথারগৌ হৗন্নানৈ জিউয়া গাওনৗ সাক্ষী হৗদৗং, মানৗনা জিউয়ানৗ বে নৗংগৌয়া। <verse eid="1JN 5:6" /><verse number="7" style="v" sid="1JN 5:7" />মানৗনা বিহা সাথামা সাক্ষ্য হৗয়ৗ, <verse eid="1JN 5:7" /><verse number="8" style="v" sid="1JN 5:8" />জিউ, দৈ আরৗ থৈ, বে সাথামনি সাক্ষ্যয়া মৗনছেয়ানৗ। <verse eid="1JN 5:8" /><verse number="9" style="v" sid="1JN 5:9" />জৗঙৗ মানসিনি সাক্ষ্য হৗনায়খৌ ফৗথায়ৗ, নাথায় ঈশ্বৗরনি সাক্ষ্যয়া গেদেৎসিন মানৗনা ঈশ্বৗরা গাওনৗ গাওনি বিসাহৌয়ানি সমন্দৈ সাক্ষ্য হৗদৗং। <verse eid="1JN 5:9" /><verse number="10" style="v" sid="1JN 5:10" />ঈশ্বৗরনি বিসাজ্লাখৌ জাইয়ানৗ ফৗথায়ৗ, বিছৗরৗ বে সাক্ষ্যনি নংগৌয়াও থায়ৗ। নাথায় জাইয়া ঈশ্বৗরখৌ ফৗথাইয়া, বিয়ৗ ঈশ্বৗরখৌ ঠগায়সুলা খৗলামৗ, মানৗনা ঈশ্বৗরা গাওনি বিসাজ্লানি খৗথা বুংনায়খৌ বিয়ৗ ফৗথাইয়াখৗছৈ। <verse eid="1JN 5:10" /><verse number="11" style="v" sid="1JN 5:11" />আরৗ সাক্ষ্যয়া বেনৗ, ঈশ্বৗরা জৗংনৗ জৗবনৗ গৈয়ি গৗঠাংখৌ হৗবায়, বে জীবনখৌ বিয়ৗ গাওনি বিসাজ্লানি গেজেরজৗং জৗংনৗ হৗদৗং। <verse eid="1JN 5:11" /><verse number="12" style="v" sid="1JN 5:12" />ঈশ্বৗরনি বিসা হৌয়াখৌ জাইয়া মৗনবায়, বিয়ৗ গৗঠাংখৌবৗ মৗনবায়, নাথায় ঈশ্বৗরনি বিসা হৌয়াখৌ জাইয়া মৗনাখৈ, বিয়ৗ গৗঠাংখৌবৗ মৗনাখৈ।<verse eid="1JN 5:12" /></para>
  <para style="s">জৗবনৗ গৈয়ি গৗঠাং</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13" />আঙৗ নৗংছৗরনৗ বেফৗরখৌ লিৎছৈ জাইফ্রা ঈশ্বৗরনি বিসাজ্লানি মুংখৌ ফৗথায়ৗ, জাহাথে নৗংছৗরৗ মিথিনৗ হায়ৗ যে নৗংছৗরৗ জৗবনৗ গৈয়ি গৗঠাংখৌ মৗনবায়। <verse eid="1JN 5:13" /><verse number="14" style="v" sid="1JN 5:14" />আরৗ ঈশ্বৗরনিয়াও জৗংনি ফুরা ফৗথাইনায়া বেনৗ, জৗঙৗ যদি গৗসৗ বাদি নাগিৎনৗ, বিয়ৗ জৗংখৌ খৗনাছঙৗ। <verse eid="1JN 5:14" /><verse number="15" style="v" sid="1JN 5:15" />আরৗ যদি জৗঙৗ মিথিগৌ যে বিয়ৗ জৗংনি বিনায়খৌ খৗনাছঙৗ-জৗঙৗ জায়খিয়া বি জৗঙৗ মিথিগৌ যে জৗঙৗ জেখৌ বিনিয়াও বিবায় বেখৌ মৗনবায়। <verse eid="1JN 5:15" /><verse number="16" style="v" sid="1JN 5:16" />যদি নৗঙৗ ছৗরবা ফংবায় কিন্বা বিনানাওখৌ পাপ মাওনায় নুয়ৗ যে থৈনায়াও দৈদেনলাঙা, অব্লা নৗঙৗ বিনি থাখৈ প্রার্থনা খৗলাম নাংগৌ আরৗ ঈশ্বৗরা বিছৗরনৗ গৗঠাংখৌ হৗনায়। আঙৗ বিছৗরনি খৗথা বুঙৗ জাইফ্রা পাপনি থাখৈ থৈয়া। বিহা মৗনছে পাপ দং জেয়া থৈনায়াজৗং লাঙৗ। আঙৗ বুঙা যে নৗংনে বে বিষয়ৈ প্রার্থনা খৗলামথারনাংগৌ। <verse eid="1JN 5:16" /><verse number="17" style="v" sid="1JN 5:17" />গৗরৗন্থি মাওনায় মানিয়ানৗ পাপ, নাথায় পাপ মৗনফ্রৗমবৗ থৈনায়াও দৈদেনলাঙৗ, বে অৗঙা। <verse eid="1JN 5:17" /><verse number="18" style="v" sid="1JN 5:18" />জৗঙৗ মিথিগৌ, ঈশ্বৗরনি বিসাফ্রা পাপখৌ মাওবায় থায়া, মানৗনা ঈশ্বৗরনি বিসাজ্লায়া বিখৌ বাছাইনানৈ লাখিয়ৗ, আরৗ শয়তানা বিখৌ দাংনৗ হায়া। <verse eid="1JN 5:18" /><verse number="19" style="v" sid="1JN 5:19" />জৗঙৗ মিথিগৌ যে, জৗঙৗ ঈশ্বৗরনি বিসাফৗর, আরৗ গাছেনবৗ সংসারনি শয়তানা হমথাদৗংব্লাবৗ। <verse eid="1JN 5:19" /><verse number="20" style="v" sid="1JN 5:20" />জৗঙৗ মিথিগৌ, ঈশ্বৗরনি বিসাজ্লায়া ফৈনানৈ জৗংনৗ মিথিনৗ হানায় হৗবায়, জেন জৗঙৗ নংগৌ ঈশ্বৗরনিয়াও মিথিয়ৗ আরৗ জৗঙৗ বিনিয়াও জাইয়া নংগৌ। জৗং বিনিয়াও জাইয়া বিনি বিসাজ্লা যীশু খ্রীষ্টনিফ্রায় নংগৌয়া, বিনৗ নংগৌ ঈশ্বৗরা আরৗ জৗবনৗ গৈয়ি গৗঠাঙা। <verse eid="1JN 5:20" /><verse number="21" style="v" sid="1JN 5:21" />আংনি আংগৗ বিসাফৗর, নৗংছৗরৗ গাও গাওখৌ মূর্তিফৗরনিফ্রায় গৗজানাও দৗন।<verse eid="1JN 5:21" /></para>
  <chapter eid="1JN 5" />
</usx>