<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Mech id Philemon - Mech Bangla</book>
  <para style="h">ফিলীমন</para>
  <para style="toc3">ফিলীমন</para>
  <para style="toc2">ফিলীমন</para>
  <para style="toc1">ফিলীমননৗ লিৎনায় পৌলনি লাইজাম</para>
  <para style="mt">ফিলীমননৗ লিৎনায় পৌলনি লাইজাম</para>
  <para style="is">বিজাবনি রাইফৗথনায়</para>
  <para style="ip">ফিলীমনআ সাছে মুং দাংখা খ্রীষ্টিয়ান মৗন আরৗ কলসীয় মণ্ডলীনি সাছে সৗদ্রৗমা মৗন। অনিসিমাস মুংনি বিনে সাছে গলাম (বানদা) দংমৗন। বে গলামমা গাওনি গিরিনিফ্রায় খাৎলাংনানৈ বৗরৈবা পৌলজৗং জৗবথেসালিয়াও লৗগৗ মৗনজ্লায়দৗং। বিহা বিয়ৗ পৌলনি ফৗরৗংনায়জৗং খ্রীষ্টিয়ান জাদৗং।</para>
  <para style="ip">ফিলীমননৗ পৌলনি লিৎনায় লাইজামা ফিলীমননিফ্রায় খাৎনায় দাস অনিসিমাসনি থাখৈ গাংছে খাওলায়নায় লাইজাম, পৌলআ বিখৌ ফিলীমননিয়াও থৗনহৎফিনদৗং। আরৗ সাছে নিমাহা হৗজানায় দাস বাদি বান অৗঙা, নাথায় সাছে খ্রীষ্টিয়ান ফংবায় বাদি নাজাওফিননৗ থাখৈ বিয়ৗ খাওলায়হৎদৗং।</para>
  <para style="iot">বিষয়ফৗর</para>
  <para style="io1">রাইফৗথনায় <char style="ior">(<ref loc="PHM 1:1-3">1–3</ref>)</char></para>
  <para style="io1">ফিলীমনখৌ বাখ্নাইহৎনায় <char style="ior">(<ref loc="PHM 1:4-7">4–7</ref>)</char></para>
  <para style="io1">অনিসিমাসনি থাখৈ খাওলায়নায় <char style="ior">(<ref loc="PHM 1:8-22">8–22</ref>)</char></para>
  <para style="io1">লাইজামনি জৗবনায় খৗথা <char style="ior">(<ref loc="PHM 1:23-25">23–25</ref>)</char></para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="s">ফিলীমননৗ পৌলনি লাইজাম</para>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />পৌল, যীশু খ্রীষ্টনি থাখৈ জৗবথেসালিয়াও জৗবজানায় আরৗ তীমথিয় জৗংনি ফংবায়,</para>
  <para style="p" vid="PHM 1:1">বে লাইজামখৌ জৗংনি লৗগৗ আরৗ জৗংনি মাওফাগ্রা আংগৗ লৗগৗ ফিলীমননৗ, <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" />আরৗ জৗংনি বিনানাও আপ্পিয়া আরৗ জৗংনি সান্ত্রি আর্খিপাস, আরৗ নৗংছৗরনি ন্ব'নি মন্ডলীনি থাখৈ লিৎহথদৗং<note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="COL 4:17">কলসীয় 4:17</ref></char></note>।<verse eid="PHM 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3" />জৗংনি বিফা ঈশ্বৗর আরৗ ফৗরবু যীশু খ্রীষ্টআ নৗংছৗরনৗ অনুগ্রহ আরৗ শান্তি হৗথৗং।<verse eid="PHM 1:3" /></para>
  <para style="s">ফিলীমননি অন্নায় আরৗ ফৗথাইনায়</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />জেব্লাইবৗ আঙৗ আংনি ঈশ্বৗরনিয়াও প্রার্থনা খৗলামফ্রৗবৗ নৗংখৌ গৗসৗ খাংফায়ৗ, আরৗ নৗংনি থাখৈ ঈশ্বৗরখৌ হামবায় হৗন্নৗ। <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />মানৗনা ফৗরবু যীশুনিয়াও নৗংনি ফৗথাইনায় আরৗ বিনি গৗথার মানসিফৗরনি ছায়াও নৗংনি অন্নায়খৌ আঙৗ খৗনাবায়। <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />আঙৗ প্রার্থনা খৗলামৗ, জৗংনি ফৗথাইনাইয়াও নৗংনি সহভাগিতাও ভাগৗ লানাইয়া খ্রীষ্টজৗং খৌছে জানাইয়াও জৗংনিয়াও মৗনফ্রৗমবৗ যে মৗজাং জিনিস দং বেখৌ নৗংনৗ ফুরা মিথিহৗথৗং। <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />অনজাগ্রা ফংবায় নৗংনি অন্নায়খৌ খৗনানানৈ আং বিরাঠ রংজাবায়, আরৗ সাহস মৗনবায়, মানৗনা নৗংজৗং গাছেন ঈশ্বৗরনি মানসিফ্রা গৗদান বৗলৗ মৗনবায়।<verse eid="PHM 1:7" /></para>
  <para style="s">অনিসিমাসনি থাখৈ খাওলাইহৎনায়</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />বিনিখাইনৗ, নৗঙৗ মা মাওনাংগৌ, বেখৌ খ্রীষ্টনি মুঙৈ সাহসজৗং আঙৗ নৗংখৌ আদেশ হৗন্নৗ হাগৌব্লাবৗ, <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />আঙৗ নৗংখৌ অন্নায়খায়, থৗনামাৎনিনৗ খাওলায়ৗ, আং যীশু খ্রীষ্টনি সাছে দাস আরৗ যীশু খ্রীষ্টনি থাখৈ জৗবথেসালিয়াও জৗবজানায় সাছে বৗরাই পৌল। <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" />খ্রীষ্টনিয়াও আংনি বিসা, অনিসিমাসনি থাখৈ নৗংখৌ খাওলাইহৎনৗ, আং জৗবথেসালিয়াও থানায়াও বিয়ৗ খ্রীষ্টখৌ ফৗথাইনায়জৗং আংনি বিসা জাবায়<note caller="+" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="COL 4:9">কলসীয় 4:9</ref></char></note>। <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />সিগাঙাও বিয়ৗ নৗংনৗ ইছেবৗ অনদায়ি মৗন, নাথায় দা বিয়ৗ নৗংনৗ আরৗ আংনৗ, জৗং সানৈনিবৗ হেফাজাব হৗগ্রা জাবায়।<verse eid="PHM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12" />জাইখৌ আং গৗসৗজৗং অন্নৗ, আঙৗ বিখৌ নৗংনিয়াও থৗনহৎফিনবায়। <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />মৗজাং খবর খৗথাবাইনায়নি থাখৈ আঙৗ জৗবথেসালিয়াও দৗনজানায়াও নৗংনি বদল আংখৌ হেফাজাব হৗনৗ থাখৈ বিখৌ আংজৗংনৗ দৗন্নৗ লুবৈদৗংমৗন। <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />নাথায় নৗংনিফ্রায় খৗথা মৗননামাৎনিন আঙৗ মৗংবৗ মাওনৗ লুবৈয়াখৈমৗন, নৗঙৗ গাওনি গৗসৗ বাদি হেফাজাব হৗনায়খৌছৗ আঙৗ লুবৈয়াখৈমৗন; নৗংখৌ আঙৗ ব্রা ব্রা থৗন্না।<verse eid="PHM 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15" />নৗং যেন বিখৌ অরাইবৗনি থাখৈ মৗনফিনৗ হানায় বাদি, জানৗ হাগৌ দান্দৈছেনি থাখৈ বিয়ৗ নৗংনিফ্রায় গৗজান জাথৗদৗং মৗন, <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />গলাম বাদি অৗঙা, গলামনিফ্রায় রাসিন, বে জাবায়, খ্রীষ্টনিয়াও গাওনি অনজাগ্রা ফংবায় বাদি জেব্লাইবৗনি থাখৈ মৗনফিননায়। বিয়ৗ আংনি অনজাগ্রাথার, নাথায় নৗংনিয়াও এমন কি রাসিন মানৗনা দা বিয়ৗ নৗংনি দাস বান অৗংলে, বিয়ৗ ফৗরবুখৌ ফৗথাইগ্রা নৗংনি সাছে ফংবায়বৗ জাবায়।<verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />বিনিখাইনৗ নৗঙৗ আংখৌ গাওজৗং ফৗরবুনি খামানি মাওফাগ্রা লৗগৗ হৗন্নানৈ সানব্লা আংখৌ জেরৈ নাজাওয়ৗ, বেবাদিনৗ বিখৌবৗ নাজাওদৗ। <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />বিয়ৗ নৗংনি সিগাঙাও গৗরৗন্ঠি মাওবায়ব্লা, এবা নৗংনৗ মাবাফৗর হৗনাংগৌ দংব্লা, আংনিয়াও বেখৌ বিবানখৌ হৗ। <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />আং, পৌল, বেখৌ গাওনি আখাইজৗং লিৎদৗং, নৗংনৗ দাহারখৌ আং গাওনৗ হৗনায়ছৈ। (নাথায় খৗথা ফংছেয়া বেনৗ, নৗং গাওনি জীবননি থাখৈনৗ আংনেও দাহার।) <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />আঙৗ ইচ্ছা জায়ৗ, ফংবায়, জৗং খ্রীষ্টনিয়াও ফংবায় জানায়খায়, ফৗরবুনি বিশ্বাসি বিসিগি বাদি আংনি হাস্থাইনায়খৌ লাখিনানৈ আংখৌ রংজাহৗ।<verse eid="PHM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21" />আং ফৗথায়ৗ, নৗঙৗ আংনি বুংনায়খৌ মানিনায় হৗন্নানৈছৗ আং বেখৌ নৗংনৗ লিৎহদদৗং। আং মিথিগৌ যে নৗং আং বুংনায়নি খুরৈবৗ বাংসিনছৗ মাওনায়।<verse eid="PHM 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PHM 1:22" />আরৗ মৗনছে জিনিস বাংসিন, আংনি থাখৈ মৗনছে আলাসি খঠ্রা ঠাম ঠিম দৗনখা, মানৗনা আঙৗ আশা খৗলামৗ যে নৗংছৗরনি প্রার্থনানি গেজেরজৗং আঙৗ গৗখ্রৈনৗ নৗংছৗরখৌ নাইনৗ হানায়।<verse eid="PHM 1:22" /></para>
  <para style="s">জৗবনাইনি খুলুমহৎনায়</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />যীশু খ্রীষ্টনি মৗজাং খবরখৌ খৗথাবাইনায়নি থাখৈ আংজৗং জৗবথেসালিয়াও জৗবফাজানায় <note caller="+" style="x"><char style="xo" closed="false">1:23 </char><char style="xt" closed="false"><ref loc="COL 4:12">কলসীয় 4:12</ref></char></note>ইপাফ্রাস, <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" />আরৗ লৗগৗছে আংনি মাওফাগ্রা মার্ক, আরিষ্টার্খস, দীমাস আরৗ লূক, বিছৗর বয়বৗ নৗংছৗরনৗ গৗজৗন্নায় হৎদৗং।<verse eid="PHM 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25" />ফৗরবু যীশু খ্রীষ্টনি অনুগ্রহয়া নৗংছৗরনি জিউয়াও লৗগৗছে থাথৗং।<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>