<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Mech</book>
  <para style="h">2 যোহন</para>
  <para style="toc3">2 যোহ</para>
  <para style="toc1">যোহননি দ্বিতীয় লাইজাম</para>
  <para style="toc2">2 যোহন</para>
  <para style="mt">যোহননি দ্বিতীয় লাইজাম</para>
  <para style="is">রাইফৗথনায়</para>
  <para style="ip">যোহননি দ্বিতীয় লাইজামা সাইখ'জানায় গৗজৌ থাখৗনি হিন্জাও আরৗ বিসাফৗরনৗ প্রাচীননি গেজেরজৗং লিথহৎজানায় লাইজাম। জৗঙৗ বুজিয়ৗ, বিয়ৗ মৗনছে জায়গানি গংছে মন্ডলী আরৗ বিয়াওনি মানসিফৗরনৗ বে লাইজামখৌ লিৎবায়। বে লাইজামনি ইছে খবরা জাবায়, গাওজৗং গাও অনজ্লাইনায় আরৗ নংখাই ফৗরৗংগ্রাফৗর আরৗ বিছৗরনি ফৗরৗংনায়ফৗরনিফ্রায় সাবৗদান জানায়।</para>
  <para style="iot">বিষয়ফৗর</para>
  <para style="io1">রাইফৗথনায় <char style="ior">(<ref loc="2JN 1:1-3">1–3</ref>)</char></para>
  <para style="io1">অন্নায়ানৗ দেৎসিন <char style="ior">(<ref loc="2JN 1:4-6">4–6</ref>)</char></para>
  <para style="io1">নংখাই ফৗরৗংনায়ফৗরনিফ্রায় সাবৗদান জানায় <char style="ior">(<ref loc="2JN 1:7-11">7–11</ref>)</char></para>
  <para style="io1">লাইজামনি জৗবনায় খৗথা <char style="ior">(<ref loc="2JN 1:12-13">12–13</ref>)</char></para>
  <chapter number="1" style="c" sid="2JN 1" />
  <para style="s">গৗজৗন্নায় লানায়</para>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1" />প্রাচীন-ঈশ্বৗরজৗং সাইখ'জানায় হিন্জাও আরৗ বিনি বিসাফৗরনৗ আঙৗ, জাইখৌ আঙৗ নংথারগৌ অন্নৗ-আরৗ আং বান অৗঙা, নাথায় জাইফ্রা নংগৌখৌ মিথিয়ৗ<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">বে জানৗ হাগৌ বিশ্বাসীফৗরনি মৗনছে হান্জাখৌ বুংখয়ৗ জাইফ্রা গাওছৗরনি গাছেন সদস্যফৗরজৗং লৗগৗছে লৗগৗলাজ্লাইয়ামৗন। </char></note>। <verse eid="2JN 1:1" /><verse number="2" style="v" sid="2JN 1:2" />মানৗনা নংথারগৌয়া জৗংনিয়াও থায়ৗ, আরৗ বে জৗংজৗং জেব্লাইবৗ থানায়। <verse eid="2JN 1:2" /><verse number="3" style="v" sid="2JN 1:3" />বিফা ঈশ্বৗর আরৗ বিফানি বিসা হৌয়া যীশু খ্রীষ্টআ জৗংনৗ অনুগ্রহ, দয়া আরৗ শান্তিয়া গৗজৗন্নায়খৌ হৗথৗং, বেফৗরৗ নংগৌয়াও আরৗ অন্নায়াও জৗংজৗং লৗগৗয়াও থাথৗং।<verse eid="2JN 1:3" /></para>
  <para style="s">নংগৌ আরৗ অন্নায়</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4" />বিফায়া জেরৈ জৗংখৌ আদেশ হৗদৗং, বেবাদিনৗ নাগিৎনান মৗন্নৗ খাইছে বিসাফৗরখৌ নংগৌ লামায়াও থাবায়নায় নুনানৈ আংখৌ গেদেৎ রংজাহৗবায়। <verse eid="2JN 1:4" /><verse number="5" style="v" sid="2JN 1:5" />আরৗ দা, অনজালী হিন্জাও, আঙৗ নৗংখৌ মৗনছে গৗদান আদেশ লিৎনাখৈ, নাথায় বেয়ৗ জাজেন্নায়নিফ্রায়নৗ দং। আঙৗ সৗঙৗ যে জৗঙৗ গাওজৗং গাও অনজ্লাইনাংগৌ। <verse eid="2JN 1:5" /><verse number="6" style="v" sid="2JN 1:6" />আরৗ অন্নায়া বেনৗ, যে জৗঙৗ ঈশ্বৗরনি আদেশফৗরখৌ মানিনাংনায়। বে আদেশখৌ নৗংছৗরৗ জাজেন্নায়নিফ্রায় খৗনাবৗবায়, আরৗ বিনি আদেশয়া বেনৗ যে নৗংছৗরৗ বয়বৗ অনজ্লাইনানৈ থাথার নাংনায়। <verse eid="2JN 1:6" /><verse number="7" style="v" sid="2JN 1:7" />আং বে আদেশখৌ হৗদৗং, মানৗনা সংসারাও গৗবাং ঠগায়গ্রাফৗর অৗংখাৎবায়। যীশু খ্রীষ্টআ মানসিনি মৗদৗমনি মহরৈ ফৈদৗংমৗন, বেখৌ বিছৗরৗ সিমান লায়া। বিছৗরৗ ঠগায়গ্রা আরৗ যীশু খ্রীষ্টনি বিসারু। <verse eid="2JN 1:7" /><verse number="8" style="v" sid="2JN 1:8" />নৗংছৗরৗ সাবৗদান জা, যে জৗঙৗ জেনি থাখৈ মাওবায় যেন গৗমায়িবাদি, নাথায় নৗংছৗরৗ ফুরা বান্থাখৌ মৗননায় বাদি। <verse eid="2JN 1:8" /><verse number="9" style="v" sid="2JN 1:9" />ছৗরবায়া সিগাং থাঙৗ আরৗ খ্রীষ্টনি ফৗরৗংনায়াও গৗগৗমৈ থানায় অৗঙা, বিনিয়াও ঈশ্বৗরা গৈয়া, বিনি ফৗরৗংনায়াও জাইয়া থায়ৗ বিনিয়াও বিফা আরৗ বিসা সানৈবৗ থায়ৗ। <verse eid="2JN 1:9" /><verse number="10" style="v" sid="2JN 1:10" />যদি ছৗরবায়া নৗংনিয়াও ফৈয়ৗ আরৗ খ্রীষ্টনি ফৗরৗলাংনায়খৌ ফৗরৗঙাব্লা, বিখৌ নৗংনি ন্ব'খরাও দানাজাও, আরৗ বিজৗং গৗজৗন্নায়বৗ দালা। <verse eid="2JN 1:10" /><verse number="11" style="v" sid="2JN 1:11" />মানৗনা জাইয়া বিজৗং গৗজৗন্নায় লানায়, বিয়ৗ বিনি দুষ্টু খামানি মাওনায়াওবৗ ভাগৗ লায়ৗ।<verse eid="2JN 1:11" /></para>
  <para style="s">জৗবনায়নি খৗথা</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12" />আঙৗ নৗংছৗরনৗ গৗবাং খৗথাফৗর বুংনৗ গৗনাং দংমৗনব্লাবৗ, নাথায় আঙৗ কলম আরৗ কালিজৗং লিৎনৗ লুবৈয়া, জৗংনি রংজানায় জাফুংনায় বাদি আং আশা খৗলামৗ নৗংছৗরখৌ নাইনৗ থাংনানৈ আরৗ নৗংছৗরজৗং মৗখাংজৗং মৗখাং রায়জ্লাইনৗ। <verse eid="2JN 1:12" /><verse number="13" style="v" sid="2JN 1:13" />ঈশ্বৗরজৗং সাইখ'জানায় নৗংনি বিবোনি বিসাফৗর নৗংখৌ গৗজৗন্নায় লাহৎদৗং।<verse eid="2JN 1:13" /></para>
  <chapter eid="2JN 1" />
</usx>