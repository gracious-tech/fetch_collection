<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Mech Bangla</book>
  <para style="h">মথি</para>
  <para style="toc3">মথি</para>
  <para style="toc2">মথি</para>
  <para style="toc1">মথিনি লিৎনায় ফৗরবুনি মৗজাং খবর</para>
  <para style="mt">মথিনি লিৎনায় ফৗরবুনি মৗজাং খবর</para>
  <para style="is">বিজাবনি রাইফৗথনায়</para>
  <para style="ip">গৗজাম নিয়মমাও গাওনি মানসিফৗরনি থাখৈ সাছে বাছাইগিরি হৗৎনৗ সমায় লানাইখৌ ঈশ্বৗরা জাফুংহৗবায়, আরৗ যীশুআনৗ বি বাছাইগিরিআ, বি মৗজাং খবরখৌ মথিআ বে বিজাবমাও মিথিহৗয়ৗ। আরৗ যীশুআ যিহূদীয়াফৗরনি গেজেরাও সারিজাদৗংব্লাবৗ, বি মৗজাং খবরা বি জাতিনি থাখৈ বান অৗঙা, নাথায় গাছেন সংসারনি থাখৈছৗ।</para>
  <para style="ip">মথিআ বে বিজাবখৌ ফারি ফারি সাজাইদৗং। বিয়ৗ যীশুনি সারিজানাইনিফ্রায় হমজেনানৈ বিনি বাপ্তিষ্মা হৗজানায়, আনজাৎ লাজানায়, বিনি খৗথাবায়নায়, ফৗরৗংনায় আরৗ গালীলয়াও জব্রাফৗর ছৗখানায়, খৗথাফৗরখৌ ফারি ফারি লিৎদৗং। বিনি উনাও বি বিজাবমাও যীশুনি গালীলনিফ্রায় যিরূশালেমাও থাংনায়, যীশুনি গৗঠাঙৈ থানায়নি জৗবনায় সপ্তানি জাথাইফৗর, ক্রুশয়াও ডৗখঠাবজানায়নি আরৗ জিখাংফিনাইনি খৗথাফৗর দং।</para>
  <para style="ip">বে মৗজাং খবরা যীশুখৌ গেদেৎ ফৗরৗংগ্রা হৗনানৈ দিন্ঠিদৗং, জাইহা ঈশ্বৗরনি আইনখৌ বিজিৎনানৈ হৗনৗ একথিয়ার দং, আরৗ জাইয়া ঈশ্বৗরনি রাইজৗনি খৗথা ফৗরৗংদৗং, বিনি ফৗরৗংনায়ফৗরখৌ বুথুমনানৈ মৗনবা খন্ডয়াও রান্দৗং।</para>
  <para style="ip">(1) অধ্যায় 5–7; আখল গিয়ানফৗরনি বিষয়ৈ হাজৗয়াও ফৗরৗংনায়, র্স্বৗগৗরাইজৗনি মাওনাংগৌ বিবান, রাহাফৗর আরৗ ঠাংখিনায়, (2) অধ্যায় 10; বারোজন ছেলাফৗরখৌ ফৗরৗংনায়, (3) অধ্যায় 13; বিগৎ ফৗনায়নি দৃষ্টান্ত, (4) অধ্যায় 18; ছেলা জানায়নি অৗংথিখৌ ফৗরৗংনায়, আরৗ (5) অধ্যায় 24–25; সংসারনি জৗবনায় আরৗ র্স্বৗগৗরাইজৗ ফৈনায়নি খৗথা ফৗরৗংনায়।</para>
  <para style="iot">বিষয়ফৗর</para>
  <para style="io1">ছেলাফৗরনি আরৗ যীশু খ্রীষ্টনি সারিজানায় <char style="ior">(<ref loc="MAT 1:1-2:23">1:1—2:23</ref>)</char></para>
  <para style="io1">যোহন বাপ্তিস্টনি মাওনায় <char style="ior">(<ref loc="MAT 3:1-12">3:1–12</ref>)</char></para>
  <para style="io1">যীশুনি বাপ্তিষ্মা হৗজানায় আরৗ আনজাৎ লাজানায় <char style="ior">(<ref loc="MAT 4:12-18:25">4:12—18:25</ref>)</char></para>
  <para style="io1">গালীল হাদৎনিফ্রায় যিরূশালেমসিম থাবায়লাংনায় ফৗরৗংনায় <char style="ior">(<ref loc="MAT 19:1-20:34">19:1—20:34</ref>)</char></para>
  <para style="io1">যীশুনি যিরূশালেমাও হাবনায় আরৗ বিনি জৗবনায় সপ্তা <char style="ior">(<ref loc="MAT 21:1-27:66">21:1—27:66</ref>)</char></para>
  <para style="io1">যীশুনি ঠাংখাংফিনায় আরৗ নুজানায় <char style="ior">(<ref loc="MAT 28:1-20">28:1–20</ref>)</char></para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">যীশু খ্রীষ্টনি বংশতালিকা</para>
  <para style="r">(<ref loc="LUK 3:23-38">লূক 3:23–38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />যীশু খ্রীষ্টআ দায়ূদ বংশনি বিসা আরৗ অব্রাহামনি বিসা।<verse eid="MAT 1:1" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="2" style="v" sid="MAT 1:2" />অব্রাহামআ ইসাহাকনি বিফা মৗন,</para>
  <para style="li2" vid="MAT 1:2">ইসাহাকআ যাকোবনি বিফা মৗন,</para>
  <para style="li2" vid="MAT 1:2">যাকোবআ যিহূদানি বিফা মৗন, আরৗ বিনি ফংবায়ফৗরা,<verse eid="MAT 1:2" /></para>
  <para style="li2">
    <verse number="3" style="v" sid="MAT 1:3" />যিহুদা পেরেস আরৗ সেরহনি বিফা মৗন, জাইনি বিমাআ আং তামারমৗন,</para>
  <para style="li2" vid="MAT 1:3">পেরসআ হিসরণনি বিফা মৗন, হিসরণনা রামনি বিফা মৗন।<verse eid="MAT 1:3" /></para>
  <para style="li2">
    <verse number="4" style="v" sid="MAT 1:4" />রামআ অন্মীনাদবনি বিফা মৗন,</para>
  <para style="li2" vid="MAT 1:4">অন্মীনাদবআ নহশোনি বিফা, নহোশনা সলমোননি বিফা মৗন,<verse eid="MAT 1:4" /></para>
  <para style="li2">
    <verse number="5" style="v" sid="MAT 1:5" />সলমোনআ বোয়সনি বিফা মৗন, জাইনি বিমাআ রহাবমৗন,</para>
  <para style="li2" vid="MAT 1:5">বোয়সআ ওবেদনি বিফা মৗন, জাইনি বিমাআ রূতমৗন,</para>
  <para style="li2" vid="MAT 1:5">ওবেদনা যিশয়নি বিফা মৗন,<verse eid="MAT 1:5" /></para>
  <para style="li2">
    <verse number="6" style="v" sid="MAT 1:6" />আরৗ যিশয়আ দায়ুদ রাজানি বিফা মৗন।</para>
  <para style="b" vid="MAT 1:6" />
  <para style="li1" vid="MAT 1:6">দায়ূদনা শলোমননি বিফা মৗন, জাইনি বিমাআ উষিয়নি হিন্জাওমৗন,<verse eid="MAT 1:6" /></para>
  <para style="li2">
    <verse number="7" style="v" sid="MAT 1:7" />শলোমননা রেহবিয়াবামনি বিফা মৗন,</para>
  <para style="li2" vid="MAT 1:7">রেহবিয়ামআ অবিয়নি বিফা মৗন,</para>
  <para style="li2" vid="MAT 1:7">অবিয়আ আসানি বিফা মৗন,<verse eid="MAT 1:7" /></para>
  <para style="li2">
    <verse number="8" style="v" sid="MAT 1:8" />আসাআ যিহোশাফেটনি বিফা মৗন,</para>
  <para style="li2" vid="MAT 1:8">যিহোশাফেটনা যোরামনি বিফা মৗন,</para>
  <para style="li2" vid="MAT 1:8">যোরামআ উষিয়নি বিফা মৗন,<verse eid="MAT 1:8" /></para>
  <para style="li2">
    <verse number="9" style="v" sid="MAT 1:9" />উষিয়আ যোথামনি বিফা মৗন,</para>
  <para style="li2" vid="MAT 1:9">যোথামআ আহসনি বিফা মৗন,</para>
  <para style="li2" vid="MAT 1:9">আহসআ হিষ্কিয়নি বিফা মৗন,<verse eid="MAT 1:9" /></para>
  <para style="li2">
    <verse number="10" style="v" sid="MAT 1:10" />হিষ্কিয়আ মনঃশিনি বিফা মৗন,</para>
  <para style="li2" vid="MAT 1:10">মনঃশিআ আমোননি বিফা মৗন,</para>
  <para style="li2" vid="MAT 1:10">আমোননা যোশিয়নি বিফা মৗন,<verse eid="MAT 1:10" /></para>
  <para style="li2">
    <verse number="11" style="v" sid="MAT 1:11" />আরৗ যোশিয়আ যিকনিয়ানি বিফা মৗন, আরৗ বিনি ফংবায়ফৗরা বাবিলয়াও জৗবজানায় সমাও জৗনৗম জাদৗং।<verse eid="MAT 1:11" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="12" style="v" sid="MAT 1:12" />বাবিলয়াও জৗবজানায়নি উনাও;</para>
  <para style="li2" vid="MAT 1:12">যিকনিয়াআ শলটীয়েলনি বিফা মৗন,</para>
  <para style="li2" vid="MAT 1:12">শলটীয়েলা সরুব্বাবেলনি বিফা মৗন।<verse eid="MAT 1:12" /></para>
  <para style="li2">
    <verse number="13" style="v" sid="MAT 1:13" />সরুব্বাবেলআ অবীহুদনি বিফা মৗন,</para>
  <para style="li2" vid="MAT 1:13">অবীহুদনা ইলীয়াকিমনি বিফা মৗন,</para>
  <para style="li2" vid="MAT 1:13">ইলীয়াকিময়া আসোরনি বিফা মৗন,<verse eid="MAT 1:13" /></para>
  <para style="li2">
    <verse number="14" style="v" sid="MAT 1:14" />আসোরআ সাদোকনি বিফা মৗন,</para>
  <para style="li2" vid="MAT 1:14">সাদোকআ আখীমনি বিফা মৗন,</para>
  <para style="li2" vid="MAT 1:14">আখীমআ ইলীহুদনি বিফা মৗন,<verse eid="MAT 1:14" /></para>
  <para style="li2">
    <verse number="15" style="v" sid="MAT 1:15" />ইলীহুদনা ইলিয়াসরনি বিফা মৗন,</para>
  <para style="li2" vid="MAT 1:15">ইলিয়াসররা মত্তননি বিফা মৗন,</para>
  <para style="li2" vid="MAT 1:15">মত্তননা যাকোবনি বিফা মৗন,<verse eid="MAT 1:15" /></para>
  <para style="li2">
    <verse number="16" style="v" sid="MAT 1:16" />আরৗ যাকোবআ যোষেফনি বিফা মৗন, বিয়ৗ মরিয়মনি হৌয়া মৗন, আরৗ মরিয়মআ যীশুনি বিমা মৗন, যাইখৌ মসিহ<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">খ্রীষ্ট অর্থাৎ অভিষিক্ত; যিহূদীফৗরনি রাওয়াও মসিহ বুঙৗ।</char></note> হৗন্নৗ।<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />বেবাদিনৗ অব্রাহামনিফ্রায় লানানৈ দায়ূদনিসিম চৌদ্দ ফিরি, আরৗ দায়ূদনিফ্রায় লানানৈ বাবিলয়াও জৗবজানায় সমসিম চৌদ্দ ফিরি, আরৗ জৗবজানাইনিফ্রায় মসিহনি জৗনৗম সিমাও চৌদ্দ ফিরি।<verse eid="MAT 1:17" /></para>
  <para style="s">ফৗরবু যীশুনি জৗনৗম</para>
  <para style="r">(<ref loc="LUK 2:1-7">লূক 2:1–7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />এরেই বাদি যীশু খ্রীষ্টনি জৗনৗমআ জাদৗংমৗন; যীশুনি বিমা মরিয়মআ যোষেফজৗং বাগদানজানায়নি উনাও, হাবা জায়িনি সিগাংয়াওনৗ গৗথার জিউনি বৗলৗজৗং মৗদৗমাও থাদৗং। <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />যোষেফমা ধার্মিক জানায়খায় বিয়ৗ মরিয়মখৌ বয়নিবৗ সিগাঙাও মুগৈজানৗ গৗসৗ গৗয়িখায় মরিয়মখৌ নাগারনৗ সিরি সিরি সানখৗমাদৗংমৗন। <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />বিয়ৗ বেবাদি সানবায়থানায় সমাও ফৗরবুনি সাছে আরফ'আ সিমাঙাও বেবাদি বুংদৗং, “ও যোষেফ, দায়ূদনি বিসা, নৗঙৗ মরিয়মখৌ গাওনি হিন্জাও হৗন্নানৈ নাজাওনান লানৗ দাগি, মানৗনা বিয়ৗ গৗথার জিউজৗংছৗ মৗদৗময়াও থাদৗং। <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />বিয়ৗ সাছে হৌয়াসা গথ' জৗনৗম হৗনায়, আরৗ নৗঙৗ বিনি নামখৌ যীশু<note caller="+" style="f"><char style="fr" closed="false">1:21</char><char style="ft" closed="false">যীশুআ জাবায় গ্রীকয়াও যোসুয়ানি মহর আরৗ বেনি অৗংথিয়া, “ফৗরবুআ বাছাইয়ৗ।” </char></note> দৗননাংনায়, মানৗনা বিয়ৗ গাওনি মানসিফৗরখৌ বিছৗরনি পাপনিফ্রায় বাছায়নায়।” <verse eid="MAT 1:21" /><verse number="22" style="v" sid="MAT 1:22" />ফৗরবুআ নবিনি গেজেরজৗং বুংনায় খৗথাখৌ জাফুংহৗনৗ থাখৈ বে গাছেনখৌবৗ জাফুংহৗদৗং।<verse eid="MAT 1:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="MAT 1:23" />“বি সিখ্লা আইঠা মৗদৗমাও থানায়</para>
  <para style="q2" vid="MAT 1:23">আরৗ সাছে হৌয়াসা গথ' জৗনৗম হৗনায়</para>
  <para style="q1" vid="MAT 1:23">আরৗ বিছৗরৗ বিখৌ ইম্মানুয়েল মুংখনায়”</para>
  <para style="m" vid="MAT 1:23">বেনি অৗংথিয়া জাবায়, “জৗংজৗং লৗগৗছে ঈশ্বৗর।”<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />যোষেফমা উন্ডুলাংনাইনিফ্রায় সিরি মৗন্নানৈ, ফৗরবুনি আরফ'আ থৗন্নায় বাদি মরিয়মখৌ গাওনি হিন্জাও হৗন্নানৈ নাজাওবায়। <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />নাথায় বিয়ৗ গথ'খৌ জৗনৗমজায়াগৌমানি যোষেফমা মরিয়মজৗং লৗগৗয়াও থাফায়াখৈ, আরৗ বিয়ৗ গথ'নি নামখৌ যীশু দৗন্নাছৈ।<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">সানজানি গৗনৗখৗফৗর</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />হেরোদ রাজানি আমৗলাও যিহূদিয়ানি বৈৎলেহেমাও যীশু জৗনৗমজানায়নি উনাও, যিহূদীয়ানিফ্রায় গৗনৗখৗফ্রা যিরূশালেমাও ফৈনানৈ, <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />সৗংহৈদৗং, “যিহূদিয়ারিফৗরনি রাজা জৗনৗম জানাইয়া মহায়? জৗঙৗ বিনি হাথৎখিখৌ নুদৗং, আরৗ বিখৌ খুলুমনৗ ফৈদৗং।” <verse eid="MAT 2:2" /><verse number="3" style="v" sid="MAT 2:3" />জেব্লা বে খৗথাখৌ হেরোদ রাজাআ খৗনাদৗং, বিয়ৗ উসাও বাদাও জাদৗং আরৗ বিজৗং যিরূশালেমনি গাছেনবৗ। <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />আরৗ হেরোদনা গাছেন মানসিফৗরনি গাহায় যাজকফৗরখৌ আরৗ আইন গুরুফৗরখৌ জ' লিংহৎনানৈ বিছৗরখৌ সৗংদৗং, মসিহআ ববেয়াও জৗনৗম জানায়?<verse eid="MAT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5" />“বিছৗরৗ বুংফিনবায়, যিহূদিয়ানি বৈৎলেহেম নৗগৗরাও,” মানৗনা নবিয়া বেবাদিনৗ লিৎনানৈ গালাংখাদৗং,<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />“‘আরৗ নৗং, ও যিহূদা হাদৎনি বৈৎলেহেম,</para>
  <para style="q2" vid="MAT 2:6">নৗঙৗ যিহূদা শাসনগিরিফৗরনি গেজেরাও ইছেবৗ লৈসিন অৗঙা,</para>
  <para style="q1" vid="MAT 2:6">মানৗনা নৗংনিফ্রায় সাছে দৈদেনগিরি উজিখাংনায়,</para>
  <para style="q2" vid="MAT 2:6">জাইয়া আংনি মানসি, ইস্রায়েলখৌ গুমনায়।’<note caller="+" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="MIC 5:2">মীখা 5:2</ref> </char></note>”<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />হেরোদ রাজাআ গৗনৗখৗফৗরখৌ লিংখৗমানানৈ বিছৗরনিফ্রায়, মা সমাও হাথৎখিয়া নুজায়া বেখৌ সৗংনান লাদৗং। <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />উনাও হেরোদনা বিছৗরখৌ বৈৎলেহেমাও থৗনহৎদৗং, আরৗ বিছৗরখৌ বুংদৗং, “থাংদৗ আরৗ গথ'নি খৗথা মৗজাঙৈ উদিস লাহৈদৗ, আরৗ বি গথ'খৌ মৗনহৈগ্রৗমৗনা আংনৗবৗ ফৈনানৈ খৗথাফৈ জাহাথে আংবৗ থাংনানৈ বিখৌ খুলুমহৈনৗ হানায় বাদি।”<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />রাজানি খৗথা খৗনানানৈ, বিছৗরৗ গাওছৗরনি লামাও থাঙাছৈ, আরৗ সানজা ঠিঙৈ নুজানায় হাথৎখিয়া বিছৗরনি সিগাং সিগাং থাংয়াছৈ আরৗ বি হাথৎখিয়া জেরৌ যীশু গথ' দংমৗন, বি জায়গানি ছায়াও থাবথাহৈয়াছৈ। <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />জেব্লা বিছৗরৗ হাথৎখিখৌ নুদৗং অব্লা বিছৗরৗ খুশি জানানৈ বিরাট রংজাদৗং। <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />ন্ব'সিঙাও হাবহৈনানৈ বিছৗরৗ গথ'খৌ বিমা মরিয়মজৗং নুহৈদৗং আরৗ বিছৗরৗ গথ'খৌ খুলুমদৗং। বিনি উনাও বিছৗরৗ গাওছৗরনি দাননি বাক্সখৌ খেওনানৈ গাওছৗরনি দান হৗনৗ লাবৗনায় সোনা, কুন্দুরু আরৗ গন্ধরসখৌ গথ'নৗ দান হৗদৗং।<verse eid="MAT 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 2:12" />আরৗ ঈশ্বৗরা বিছৗরখৌ সিমাঙাও রাইফৗথানায়খায় বিছৗরৗ হেরোদ রাজানিয়াও থাংফিননামাৎনিন গুবুন লামাজৗং গাওছৗরনি হাদৎনাও থাংফিনবায়।<verse eid="MAT 2:12" /></para>
  <para style="s">যীশুখৌ মিশরাও লাংনায়</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />গৗনৗখৗফৗর থাংনায়নি উনাও ফৗরবুনি সাছে আরফ'আ সিমাঙাও যোষেফজৗং নুজানানৈ হৗনবায়, “যোষেফ জিখাং,” “হেরোদনা গথ'খৌ সিথাৎনৗ নাগিৎদৗং, বিনিখায় নৗঙৗ গথ' আরৗ বিনি বিমাখৌ লানানৈ মিশরাও খাৎলাংদৗ, আরৗ আং নৗংখৌ বিনিফ্রায় ফৈফিননৗ থৗনাগৌমানি নৗঙৗ বিহানৗ থা।”<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />অব্লা যোষেফআ, জিখাংনানৈ গথ' আরৗ বিনি বিমাখৌ লানানৈ বি হরাওনৗ মিশরাও থাংনৗ অৗংখাৎদৗং, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />আরৗ বিছৗরৗ হেরোদ থৈনায়সিম বিহানৗ থাদৗং। নবিনি গেজেরজৗং বে ফৗরবুনি বুংনায় খৗথায়া জাফুংবায়: “মিশরনিফ্রায় আঙৗ আংনি বিসা হৌয়াখৌ<note caller="+" style="x"><char style="xo" closed="false">2:15</char><char style="xt" closed="false"><ref loc="HOS 11:1">হোশেয়া 11:1</ref></char></note> লিংবৗবায়।”<verse eid="MAT 2:15" /></para>
  <para style="s">গথ'ফৗরখৌ সিথাৎহৗনায়</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />জেব্লা হেরোদনা মিথিদৗং, গৗনৗখৗফ্রা বিখৌ ছৗলৈবায় হৗন্নানৈ, অব্লা বিয়ৗ বিরাট রাগ জৗংদৗং আরৗ হাথৎখি নুজানায় সমখৌ গৗনৗখৗফৗরনিফ্রায় মিথিনায় বাদিনৗ বিয়ৗ সান্ত্রিফৗরখৌ থৗনহৎনানৈ বৈৎলেহেম আরৗ বিনি খাঠি-খালানি বৗছৗরনৈ আরৗ বিনি দুইসিন বয়সনি গাছেন হৌয়াসা গথ'ফৗরখৌ সিথাৎহৗজৗবদৗং।<verse eid="MAT 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 2:17" />বেবাদিনৗ যিরমিয় নবিজৗং বুংনায় বে খৗথায়া জাফুংবায়:<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:18 </char>
      <char style="xt" closed="false">
        <ref loc="JER 31:15">যেরিমিয়া 31:15</ref>
      </char>
    </note> “গাবগ্লুংনায় আরৗ গেদেৎ দাহা জানায়নি রাও</para>
  <para style="q2" vid="MAT 2:18">রামাহ নৗগৗরাও খৗনাদৗং।</para>
  <para style="q1" vid="MAT 2:18">রাহেলাআ<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="ft" closed="false">রাহেলআ জাবায় যাকোবনি হিন্জাও। যাকোবমা ইস্রায়েলফৗরনি বিফা হৗন্নানৈ মিথিজায়ৗ। রামাহ, যিরূশালেমনি ছাহা থানায় মৗনছে নৗগৗর।</char></note> গাওনি বিসাফৗরনি থাখৈ গাবদৗং,</para>
  <para style="q2" vid="MAT 2:18">আরৗ বিয়ৗ বান্জাইজায়াখৈ মানৗনা বিছৗরৗ থৈজৗববায়।”<verse eid="MAT 2:18" /></para>
  <para style="s">মিশরনিফ্রায় ফৈফিননায়</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />হেরোদ থৈনায়নি উনাও ফৗরবুনি সাছে আরফ'আ মিশরাও যোষেফজৗং সিমাঙাও নুজাফৈনানৈ, <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />হৗনদৗং, “জিখাং, গথ'খৌ আরৗ বিনি বিমাখৌ লানানৈ ইস্রায়েল হাদৎনাও থাংফিনদৗ, মানৗনা, জাইফ্রা গথ'নি জিউখৌ লানৗ হাস্থায়দৗংমৗন, বিছৗরৗ থৈজৗববায়।”<verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />থৗনজানায় বাদি যোষেফমা জিখাংনানৈ গথ' আরৗ বিনি বিমাখৌ লানানৈ ইস্রায়েল হাদৎনাও থাংফিনবায়। <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />নাথায় জেব্লা বিয়ৗ খৗনায়াছৈ, যে আর্খিলায়আ গাওনি বিফা হেরোদনি জায়গাও যিহূদিয়াও রাজত্ব খৗলামদৗং, অব্লাহায় যোষেফমা বিহা থাংনৗ গিয়াছৈ, বিনি উনাও সিমাঙাও সাবধান খৗলামজানানৈ, বিয়ৗ গালীল হাদৎনাও থাংয়াছৈ, <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />আরৗ বিয়ৗ নাসরৎ নামনি মৗনছে নৗগৗরাও থাহৈদৗং। বেবাদিনৗ নবিনি বুংনায় বে খৗথায়া জাফুংদৗং, বিয়ৗ নাসরতীয় মুংখজানায়।<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">যোহন বাপ্তিস্টনি খৗথা</para>
  <para style="r">(<ref loc="MRK 1:1-8">মার্ক 1:1–8</ref>; <ref loc="LUK 3:18">লূক 3:18</ref>; <ref loc="JHN 1:19-28">যোহন 1:19–28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />বি দিনফৗরাও যোহন বাপ্তিস্টয়া ফৈনানৈ যিহূদিয়া হাদৎনি মারু গৗরান ফৗথারবারিয়াও প্রচার খৗলামবায়দৗং, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />আরৗ বুংদৗং, “নৗংছৗরৗ গৗসৗ ফিনফিনদৗ, মানৗনা স্বৗর্গৗ রাইজৗয়া<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">“ঈশ্বৗরনি রাইজৗ” বে সৗদৗবখৌ মার্কআ গাও লিৎনায় বিজাবমাও বাহায়দৗং (</char><char style="xt"><ref loc="MRK 1:15">মার্ক 1:15</ref></char>) আরৗ বেখৌনৗ মথিআ গাওনি বিজাবমাও “স্বৗর্গৗ রাইজৗ” সৗদৗবখৌ লিৎদৗং (<char style="xt"><ref loc="MAT 4:17">মথি 4:17</ref>; <ref loc="MAT 5:3">5:3</ref>; <ref loc="MAT 10:7">10:7</ref>; <ref loc="MAT 11:11">11:11</ref></char>)</note> খাঠিয়াও ছফৈবায়।” <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />বেনৗ বি মানসিয়া, জাইনি বিষয়ৈ যিশাইয় নবিনি গেজেরজৗং বে খৗথাখৌ বুংজাখাদৗংমৗন।</para>
  <para style="q1" vid="MAT 3:3">“সাছে মানসিয়া মারু গৗরান ফৗথারবারিয়াও বেবাদি গাবজ্রিবায়দৗং,</para>
  <para style="q1" vid="MAT 3:3">‘ফৗরবুনি ফৈনায়নি থাখৈ লামাখৌ ঠাম ঠিম খৗলামদৗ,</para>
  <para style="q2" vid="MAT 3:3">বিনি থাখৈ লামাফৗরখৌ গেবেং খৗলামদৗ।’”<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />যোহননা উট খৗমৗননি সি' গান্নৗমৗন, আরৗ বিয়ৗ জান্জিয়াও বিগুরনি গুনসা<note caller="+" style="f"><char style="fr" closed="false">3:4 </char><char style="ft" closed="false">গুনসানি অৗংথিয়া জাবায় জান্জিনি ফেঠ্ঠি এবা জান্জি ডুডুং, জেখৌ জৗঙৗ জান্জিয়াও গান্নৗ।</char></note> গান্নৗমৗন। বিয়ৗ গুমা গুয়ং আরৗ হাগ্রানি বেরে মৗদৈ জায়ৗমৗন। <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />যিরূশালেম নৗগৗরনিফ্রায় আরৗ গাছেন যিহূদিয়া আরৗ যর্দ্দন দৈমানি খাঠি খালানি গাছেন হাদৎনি মানসিফ্রা বিনিয়াও থাঙাছৈ। <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />আরৗ জাইফ্রা গাও গাওনি পাপফৗরখৌ সিমান লাবায়, বিছৗরখৌ যোহননা যর্দ্দন দৈমায়াও বাপ্তিস্মা হৗবায়।<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />নাথায় গৗবাংথার ফরীশী<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="ft" closed="false">যীশু খ্রীষ্টনি আমৗলাও জুদাইয়ারি ধৗরৗমিয়া গুরুফৗরনি গেজেরাও, ফরীশী মুংনি মৗনছে দাফা দংমৗন। বিছৗর মোশিনি গাছৈবৗ আইনফৗরখৌ আরৗ গুবুন গাছৈবৗ হুদাফৗরখৌ মিথিয়ৗমৗন আরৗ মানিয়ৗমৗন, বিনিখাইনৗ বিছৗরৗ গাওছৗরখৌ সাধু সান্নানৈ ডুগা জায়ৗমৗন। গৗবাংথার ফরীশীফৗরনি গৗসৗনি সান্নায়ফ্রা গাজ্রিমৗন, বিনিখাইনৗ যীশুআ বিছৗরখৌ দসি খৗলামদৗং। (</char><char style="xt"><ref loc="MAT 5:20">মথি 5:20</ref></char>)</note> আরৗ সদ্দূকীফ্রা<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="ft" closed="false">সদ্দূকীফ্রা জুদাইয়ারিফৗরনি মৗনছে দৈদেনগিরি দাফা এবা হান্জা আরৗ বিছৗরনি গেজেরাও গৗবাংয়ানৗ যাজকফৗরমৗন, জাইফ্রা ঈশ্বৗরনি লিৎনায় আইনফৗরখৌবান মানিয়ৗমৗন। সদ্দুকীফ্রা থৈনায়নিফ্রায় ঠাংখাংফিন্নায়খৌ ফৗথাইয়ামৗন আরৗ বেনৗমৗন বিছৗরনি গেদেৎ গৗরৗন্ঠিয়া। বিছৗরবৗ যীশুনি বিরুদ্ধনাও ফরীশীফৗরজৗং লৗগৗলাফাদৗংমৗন। (</char><char style="xt"><ref loc="MRK 12:18-27">মার্ক 12:18–27</ref>; <ref loc="LUK 20:27-40">লূক 20:27–40</ref></char>)</note> বাপ্তিস্মা লানৗ থাখৈ গাওনিয়াও ফৈনায় নুনানৈ বিয়ৗ বিছৗরখৌ হৗনদৗং, “নৗংছৗরৗ ও জিবৌ গাংছৗমনি বিসাফৗর! ঈশ্বৗরনিফ্রায় ফৈনায় রাগনিফ্রায় খাৎগোনৗ নৗংছৗরখৌ ছৗর সাংগ্রাং খৗলামখৗ। <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />নৗংছৗরৗ পাপফৗরনিফ্রায় গৗসৗ সৗলাইনায়খৌ, গাও গাওনি ছাল ছৗলৗনজৗং বিথাইফৗরখৌ থাইহৗনান দিন্ঠি। <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />আরৗ নৗংছৗরৗ দাসান, ‘জৗংনে বিফা অব্রাহামা দংখায়ৗ হৗন্নানৈ।’ আঙৗ নৗংছৗরখৌ বুঙৗ, ঈশ্বৗরা বে অন্ঠাইফৗরনিফ্রায়নৗ অব্রাহামনি থাখৈ বিসাফৗরখৌ উজিহৗনৗ হাগৌ। <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />আরৗ দানৗ বিংফাংফৗরনি গুডিয়াও রুয়া দৗনখানায় দংখায়ৗ আরৗ বিনিখাইনৗ ফাংফ্রৗমবৗ মৗজাং বিথাই থাইরৗঙি বিংফাংয়া দানফাইজানায় আরৗ অৎনাও গারসনজানায়।<verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />আঙৗ নৗংছৗরখৌ গৗসৗ ফিনফিননায়নি থাখৈ দৈজৗং বাপ্তিস্মা হৗয়ৗ, নাথায় আংনি উনাও জাইয়া ফৈগৌ বিয়ৗ আংনিফ্রায় বৗলৗগ্রাসিন, আঙৗ বিনি আঠেংনি সেনডেলখৌবৗ দাংনৗ সমায়া। বিয়ৗ নৗংছৗরখৌ গৗথার জিউ আরৗ অয়ৎজৗং বাপ্তিস্মা হৗনায়। <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />বিনি মাই সিবগ্রা ছোংগ্রাইয়া বিনি আখায়াও দং, বিয়ৗ মারা হৗনায় মাইখৌ সিবনানৈ আরৗ মাই বিগৎ গৗগৗখৌ বুথুমনানৈ বিনি বাখ্রিয়াও দৗন্নায়, নাথায় গুবুখৌ মাব্লাবাবৗ গৗমৗৎরৗঙি অয়ৎজৗং সাওনায়।”<verse eid="MAT 3:12" /></para>
  <para style="s">ফৗরবু যীশুনি বাপ্তিস্মা</para>
  <para style="r">(<ref loc="MRK 1:9-11">মার্ক 1:9–11</ref>; <ref loc="LUK 3:21-22">লূক 3:21–22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />বি সমাও যীশুআ যোহনজৗং বাপ্তিস্মা লানৗ থাখৈ গালীলনিফ্রায় যর্দ্দন দৈমায়াও ফৈদৗং। <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />নাথায় যোহননা যীশুখৌ বাদাহৗনৗ হাস্থায়নানৈ হৗনদৗং, “নৗংজৗং আংছৗ বাপ্তিস্মা হৗজানৗ নাংগৌ আরৗ নৗংছৗ আংনিয়াও ফৈবায়?”<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />নাথায় যীশুআ বুংফিনবায়, “দানৗ রাজি জাদৗ, মানৗনা জৗঙৗ বেবাদিনৗ গাছেন ধার্মিকতাখৌ জাফুংহৗনৗ নাংগৌ।” অব্লা যোহননা বিনি খৗথাখৌ মানিয়াছৈ। <verse eid="MAT 3:15" /><verse number="16" style="v" sid="MAT 3:16" />যীশুআ বাপ্তিস্মা হৗজাগ্রৗমৗন্না, দৈমানিফ্রায় গাখাংফিনদৗং। বি সমাওনৗ বিয়ৗ স্বৗর্গৗখৌ গেওনানৈ ঈশ্বৗরনি গৗথার জিউখৌ ফারৌ বাদি জানানৈ গাওনি ছায়াও ফৈনায় নুদৗং। <figure style="fig" alt="Jesus took baptism and the spirit of God decended on him like a dove" file="cn01656.jpg" size="col" loc="paw" copy="© DCC" ref="3:16">যীশুআ বাপ্তিস্মা লাজাদৗং আরৗ ঈশ্বৗরনি গৗথার জিউয়া বিনি ছায়াও ফারৌ বাদি জানানৈ ফৈদৗং</figure><verse eid="MAT 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 3:17" />আরৗ স্বৗর্গৗনিফ্রায় বেবাদি বুংনায় রাও খৗনাদৗং, “বেয়ৗ আংনি বিসা হৌয়া, জাইখৌ আং অন্নৗ, বিজৗংনৗ আঙৗ বিরাট খুশি জায়ৗ।”<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">যীশুনি আনজাৎ লাজানায়</para>
  <para style="r">(<ref loc="MRK 1:12-13">মার্ক 1:12–13</ref>; <ref loc="LUK 4:1-13">লূক 4:1–13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />বিনি উনাও যীশুআ জিউজৗং মারু গৗরান ফৗথার বারিয়াও দৈদেনলাংজানানৈ শয়তানজৗং আনজাৎ লাজাদৗং। <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />আরৗ চল্লিশ দিন চল্লিশ হর বিয়ৗ উপবাস থানায়নি উনাও উখৈদৗং মৗন। <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />বি সমাও আনজাৎলাগ্রায়া বিনিয়াও ফৈনানৈ বিখৌ হৗনদৗং, “নৗং ঈশ্বৗরনি বিসাহৌয়াব্লা, দে বে অন্ঠাইখৌ সিঠাও জানৗ থৗন।” <verse eid="MAT 4:3" /><verse number="4" style="v" sid="MAT 4:4" />নাথায় যীশুআ বুংফিন্দৗং, “শাস্ত্রয়াও বেবাদি লিৎনায় দং, ‘মানসিয়া সিঠাওজৗংবান ঠাংনানৈ থায়া, নাথায় ঈশ্বৗরনি খৗগানিফ্রায় অৗংখাৎনায় ফংফ্রৗমবৗ বাক্যজৗংছৗ ঠাংনানৈ থায়ৗ।’”<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">মানসিআ মৗদৗমনি জানায়ফৗরজৗং বান ঠাংনানৈ থায়া, নাথায় আত্মিক জানায়ফৗরজৗং বান ঠাংনানৈ থায়ৗ, ঈশ্বৗরনি খাদ্যয়া জাবায়, বিনি বৗচৗন। (</char><char style="xt"><ref loc="DEU 8:3">হূদা বিজাব 8:3</ref></char>)</note><verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />বিনি উনাও শয়তানা যীশুখৌ গৗথার নৗগৗরাও লাংনানৈ মন্দিরনি ঠিখিনিয়াও ফছংদৗং। <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />আরৗ বিখৌ হৗনদৗং, “নৗং ঈশ্বৗরনি বিসাহৌয়াব্লা বেনিফ্রায় বাজ্রুুমদৗ। মানৗনা শাস্ত্রয়াও লিৎনায় দং, ‘ঈশ্বৗরা নৗংখৌ রক্ষাখৗলামনৗ থাখৈ গাওনি আরফ'ফৗরখৌ আদেশ খৗলামনায়, আরৗ নৗংনি আঠেংফ্রা অন্ঠাইফৗরাও ছৗখ্ঠুয়াবাদি বিছৗরৗ নৗংখৗ গাওনি আখাইফৗরজৗং দিখাংনানৈ লানায়।’”<note caller="+" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PSA 91:11-12">গীতফৗর 91:11–12</ref> </char></note><verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />যীশুআ বিখৌ উত্তর হৗফিনবায়, “বেবাদি লিৎনায় দং, নৗঙৗ গাওনি ফৗরবু ঈশ্বৗরখৌ আনজাৎ দালা”<note caller="+" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="DEU 6:16">হূদা বিজাব 6:16</ref></char></note> <verse eid="MAT 4:7" /><verse number="8" style="v" sid="MAT 4:8" />আরবাও, শয়তানা বিখৌ বিরাঠ গৗজৌ হাজৗ ঠিখিনিয়াও লাংনান থাংদৗং আরৗ সংসারনি গাছেন রাইজৗফৗরখৌ আরৗ বেফৗরনি সমায়নাইখৌ দিন্ঠিনানৈ <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />“বিখৌ হৗনবায়, নৗঙৗ আংখৌ গংনানৈ খুলুমৗব্লা আঙৗ বেফৗর গাছেনখৌবৗ নৗংনৗ হৗনায়।” <verse eid="MAT 4:9" /><verse number="10" style="v" sid="MAT 4:10" />অব্লা যীশুআ বিখৌ হৗনবায়, “শয়তান, নৗং আংনিফ্রায় গৗজান জা মানৗনা বেবাদি লিৎনায় দং, নৗঙৗ গাওনি ফৗরবু ঈশ্বৗরখৌ খুলুম আরৗ বিখৌ বান সিবি!”<note caller="+" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="DEU 6:13">হূদা বিজাব 6:13</ref></char></note> <verse eid="MAT 4:10" /><verse number="11" style="v" sid="MAT 4:11" />অব্লা শয়তানা যীশুখৌ নাগারনান থাঙাছৈ আরৗ আরফ'ফ্রা ফৈনানৈ বিখৌ জৗথৗন লাখিদৗং।<verse eid="MAT 4:11" /></para>
  <para style="s">গালীলয়াও যীশুনি মাওজেননায়</para>
  <para style="r">(<ref loc="MRK 1:14-15">মার্ক 1:14–15</ref>; <ref loc="LUK 4:14-15">লূক 4:14–15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />উনাও যোহন বাপ্তিস্টখৌ জৗবথেসালিয়াও জৗবজানায় খৗনানানৈ যীশুআ গালীলয়াও থাংফিনদৗং। <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />আরৗ বিয়ৗ নাসরৎখৌ নাগারনানৈ সবূলূন<note caller="+" style="f"><char style="fr" closed="false">4:13 </char><char style="ft" closed="false">সবূলূন আরৗ নপ্তালিয়া জাবায় জায়গানি নাম, বে মৗননৈ নামবৗ যাকোবনি বিসাজ্লানি নাম, বে সানৈ বিসাজ্লানি নামনিফ্রায়নৗ বি জায়গানি নামমা জাদৗং সবূলূন আরৗ নপ্তালি। গৗবাংথার মানসি জাইফ্রা জুদাইয়ারি অৗঙা মৗন বিছৗরবৗ বিহা থায়ৗমৗন (</char><char style="xt"><ref loc="GEN 30:7-8">জাগাইজেন্নায় 30:7–8</ref>,<ref loc="GEN 30:19-20">19–20</ref></char>)।</note> আরৗ নপ্তালি ফৗলেরনি হাদৎ গালীল লৈথৗ সেরনি কফরনাহুমাও থাংনানৈ থাহৈদৗং, <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />জাহাথে যিশাইয় নবিনি গেজেরজৗং বুংনায় খৗথায়া জাফুংঙৗ।<verse eid="MAT 4:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="MAT 4:15" />“সবূলূন হাদৎ আরৗ নপ্তালি হাদৎ,</para>
  <para style="li2" vid="MAT 4:15">লৈথৗ ঠিঙৈ থাংনায় লামা, যর্দ্দন বাদনৈ গুবুনহারিফৗরনি হাদৎ গালীল,<verse eid="MAT 4:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="MAT 4:16" />খৗমসিয়াও থানায় মানসিফ্রা গেদেৎ স্রাংখৌ নুনৗ মৗনবায়।</para>
  <para style="li2" vid="MAT 4:16">আরৗ থৈনায়নি সাইখ্লৗম হাদৎনাও থানায়ফৗরনি ছায়াও স্রাংয়া<note caller="+" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="ISA 9:1">যিশাইয় 9:1</ref>,<ref loc="ISA 9:2">2</ref> </char></note> নুজাফৈবায়।”<verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />বি সমনিফ্রায়নৗ যীশুআ প্রচার খৗছামজেনদৗং, “নৗংছৗরৗ গৗসৗ ফিনফিনদৗ, মানৗনা স্বৗর্গৗ রাইজৗয়া খাঠিয়াও ছফৈবায়।”<verse eid="MAT 4:17" /></para>
  <para style="s">সাব্রৈ ছেলাফৗরখৌ লিংজেননায়</para>
  <para style="r">(<ref loc="MRK 1:16-20">মার্ক 1:16–20</ref>; <ref loc="LUK 5:1-11">লূক 5:1–11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />সানছেখালি যীশুআ গালীল লৈথৗ জিং জিং থাবায়লাংনায় সমাও, সানৈ ফংবায়ফৗরখৌ নুদৗং, শিমোন জাইখৌ পিতর মুংখয়ৗমৗন, আরৗ বিনি ফংবায় আন্দ্রিয়খৌ। বিছৗরৗ লৈথৗয়াও জে'সাৎদৗং মৗন। মানৗনা বিছৗরৗ না' হমগ্রাফৗর মৗন। <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />আরৗ যীশুআ বিছৗরখৌ হৗনবায়, “নৗংছৗরৗ আংজৗং ফৈ, আং নৗংছৗরখৌ মানসি হমগ্রা মাছুয়া খৗলামনায়।” <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />বি সমাওনৗ বিছৗরৗ গাও গাওনি জে'ফৗরখৌ নাগারনানৈ যীশুজৗং লৗগৗছে থাংফাদৗং। <verse eid="MAT 4:20" /><verse number="21" style="v" sid="MAT 4:21" />বি জায়গানিফ্রায় গুবুন জায়গাসিম ছ'ছে দাওগালাংনাইয়াও, যীশুআ গুবুন সানৈ ফংবায়ফৗরখৌ, সিবদিয়নি বিসাজ্লা যাকোব আরৗ বিনি ফংবায় যোহনখৌ নুবায়, বিছৗরৗ গাওছৗরনি নাওয়াও বিফাজৗং জে'ফৗরখৌ রুথিবায় থাদৗংমৗন। আরৗ যীশুআ বিছৗরখৌ লিংহৎবায়, <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />আরৗ ঠাবনৗ বিছৗর নাওখৌ আরৗ বিফাখৌ গালাংনানৈ যীশুজৗং থাংফাবায়। <figure style="fig" alt="Simon, Andrew, James and john folowed Jesus" file="wa03820.jpg" size="col" loc="p" ref="4:22">শিমোন, আন্দ্রিয়, যাকোব আরৗ যোহন যীশুজৗং উন উন থাংফাদৗং</figure><verse eid="MAT 4:22" /></para>
  <para style="s">যীশুনি ফৗরৗংনায় আরৗ জব্রাফৗরখৌ ছৗখানায়</para>
  <para style="r">(<ref loc="LUK 6:17-19">লূক 6:17–19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />যীশুআ গালীল হাদৎনি গাছেন জায়গানি সিবিগ্রা ন্ব'ফৗরাও, থাংনানৈ স্বৗর্গৗ রাইজৗনি মৗজাং খবরখৌ খৗথাবাইনানৈ ফৗরৗংদৗং আরৗ মানসিফৗরনি গেজেরাও বাইদিসিনা রগ'বিয়াৎ আরৗ জব্রাফৗরখৌ ছৗখাদৗং। <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />যীশুনি বেফৗরবাদি মাওনায় খবররা সিরিয়া হাদৎয়াও মিথিসাৎজাবায়, আরৗ বাইদিসিনা রগ'বিয়াৎ ফৗরজৗং জব্রাজানায়, ছানাইজৗং কষ্ট মৗনছৗনায়, ভুত হমজানায়, মৃগী রগ'গৗনাং আরৗ ঘৈলি জাজানায় মানসিফৗরখৌ বিনিয়াও লাবৗদৗং, আরৗ যীশুআ বিছৗরখৌ ছৗখাদৗং। <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />বেবাদিনৗ গালীল, দিকাপলি, <note caller="+" style="f"><char style="fr" closed="false">4:25 </char><char style="ft" closed="false">দিকাপলি, জেখৌ দশটা নৗগৗর বুঙৗ, </char></note> যিরূশালেম, যিহূদিয়া, আরৗ যর্দ্দন বাৎনৈনিফ্রায় ভিড়য়া বিজৗং লৗগৗছে থাংফাদৗং।<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">হাজৗ ছায়াও ফৗরৗংনায়</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />সানছেখালি মানসিনি হান্জাখৌ নুনানৈ যীশুআ হাজৗয়াও গাখৗলাংনান জিরাইহৈদৗং আরৗ বিনি ছেলাফ্রা বিনিয়াও ফৈদৗং। <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />অব্লা যীশুআ বিছৗরখৌ বেবাদি ফৗরৗংনৗ হমদৗং।<verse eid="MAT 5:2" /></para>
  <para style="s">স্বৗর্গৗনি সুখ</para>
  <para style="r">(<ref loc="LUK 6:20-23">লূক 6:20–23</ref>)</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />ধন্য জাইফ্রা জিউয়াও হাওরিয়া,</para>
  <para style="q2" vid="MAT 5:3">মানৗনা স্বৗর্গৗ রাইজৗয়া বিছৗরনিনৗ।<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />ধন্য বিছৗরৗ জাইফ্রা দুঃখ খৗলামৗ,</para>
  <para style="q2" vid="MAT 5:4">মানৗনা বিছৗরৗ গৗজৗননায় মৗন্নায়।<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />ধন্য জাইফ্রা গুরৈ জায়ৗ,</para>
  <para style="q2" vid="MAT 5:5">মানৗনা বিছৗরৗ বুহুমনি অধিকারী জানায়।<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />ধন্য জাইফ্রা ধার্ম্মিকতানি থাখৈ উখৈদৗং, আরৗ গাংদৗং,</para>
  <para style="q2" vid="MAT 5:6">ঈশ্বৗরা বিছৗরখৌ গৗজৗননায় হৗনায়।<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />ধন্য জাইফ্রা অনগ্রা,</para>
  <para style="q2" vid="MAT 5:7">মানৗনা বিছৗরৗ অনখাংজানায়।<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />ধন্য জাইফৗরনি গৗসৗয়া গৗথার,</para>
  <para style="q2" vid="MAT 5:8">বিছৗরৗ ঈশ্বৗরখৌ নুনৗ মৗননায়।<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />ধন্য জাইফ্রা গৗরৗবজ্লাইহৗয়ৗ,</para>
  <para style="q2" vid="MAT 5:9">মানৗনা বিছৗরৗ ঈশ্বৗরনি বিসাজ্লা হৗন্নানৈ মুংখজানায়!<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />ধন্য জাইফ্রা ধৗরৗমনি থাখৈ নাছয়জাদৗং,<note caller="+" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="1PE 4:14">1 পিতর 4:14</ref> </char></note></para>
  <para style="q2" vid="MAT 5:10">মানৗনা স্বৗর্গৗ রাইজৗয়া বিছৗরনিনৗ।<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />“ধন্য নৗংছৗরৗ, জেব্লা আংনি থাখৈ নিন্দিজায়ৗ, নাছয়জায়ৗ আরৗ নৗংছৗরৗ উঙি খৗথাফৗরখৌ বুংজায়ৗ। <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />নৗংছৗরৗ রংজা আরৗ খুশি জা, মানৗনা নৗংছৗরনি থাখৈ স্বৗর্গৗয়াও গেদেৎ বানথা দং, বেবাদিনৗ নৗংছৗরনি সিগাং ফৈনায় নবিফ্রাবৗ নাছয়জাদৗংমৗন।”<verse eid="MAT 5:12" /></para>
  <para style="s">সৗংখ্রৈ আরৗ স্রাং</para>
  <para style="r">(<ref loc="MRK 9:50">মার্ক 9:50</ref>; <ref loc="LUK 14:34-35">লূক 14:34–35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />নৗংছৗরৗ সংসারনি সৗংখ্রৈ, নাথায় সৗংখ্রৈনি গৗবাবমা জৗবমৗব্লা, বিখৌ নৗংছৗরৗ মাব্রৈ গৗবাব খৗলামফিনৗ? বিয়ৗ মৗঙা মৗনছেনিবৗ খামানিয়াও নাঙা। অনগায়ৈ বিখৌ বাইরায়াও গারহৎনায় জায়ৗ আরৗ মানসিফৗরনি আঠেংফৗরজৗং গাফ্লেজায়ৗ।<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />“নৗংছৗরৗ সংসারনি স্রাং, জেরৈ হাজৗ ছায়াও লুজানায় নৗগৗরা থাখমানৗ হায়া। <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />আরৗ রাওবৗ মানসিয়া বাতিখৌ সাওনানৈ খাদা সিঙাও দৗন্না। নাথায় বাতি দৗনগ্রা ছায়াওছৗ দৗন্নৗ জাহাথে ন্ব'সিঙাও থানায় সাফ্রৗমনৗবৗ স্রাং হৗয়ৗ। <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />বিবাদিনৗ নৗংছৗরনি বাতিয়া মানসিফৗরনি সিগাঙাও স্রাং জাথৗং, জাহাথে মানসিফ্রা নৗংছৗরনি মৗজাং মাওনায়ফৗরখৌ নুনানৈ স্বৗর্গৗনি বিফাখৌ বাখ্নাইনায়।<verse eid="MAT 5:16" /></para>
  <para style="s">আইননি ফৗরৗংনায়</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />“দাসান যে, আঙৗ আইন আরৗ নবিফৗরখৌ সংহার খৗলামনৗ ফৈদৗং হৗন্নানৈ। আঙৗ বিছৗরখৌ সংহার খৗলামনৗ ফৈয়াখৈ, নাথায় বেফৗরখৌ জাফুংহৗনৗছৗ ফৈদৗং। <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />নংথারগৌয়ৈ আঙৗ নৗংছৗরখৌ বুঙৗ, জেব্লাসিম নখ্রাং আরৗ বুহুমমা গৗমানায় অৗঙা, অব্লাসিম আইননি গাছেনবৗ জাফুংজৗবমাগৌমানি বিনি বিন্দু মৗনছে এবা বিনি দুইসিন মৗনছে চিহ্নয়াবৗ গৗমৗৎনায় অৗঙা। <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />বিনিখাইনৗ ছৗরবায়া বে আদেশফৗরনি ববেবা মৗনছে দুইসিন আদেশখৌ ছিফায়ৗ আরৗ গুবুনফৗরখৌবৗ বিরুদ্ধ মাওনৗ ফৗরৗংঙৗ অব্লা বিয়ৗ স্বৗর্গৗ রাইজৗয়াও বয়নিখুরৈ দুইসিন জানায়। আরৗ ছৗরবায়া বে আদেশখৌ মানিয়ৗব্লা আরৗ গুবুনফৗরখৌবৗ মানিনৗ ফৗরৗংঙৗ অব্লা স্বৗর্গৗ রাইজৗয়াও বিয়ৗ গেদেৎ জানায়। <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />মানৗনা আং নৗংছৗরখৌ হৗন্নৗ, আইন গুরু আরৗ ফরীশীফৗরনি ফ্রায় নৗংছৗরৗ রাসিন ধার্মিক জায়াব্লা স্বৗর্গৗ রাইজৗয়াও হাবনৗ মৗনথারনায় অৗঙা।<verse eid="MAT 5:20" /></para>
  <para style="s">মানসি সিথাৎনায় খৗথা</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />“নৗংছৗরৗ খৗনাখাবায় যে বেখৌ গৗডৗনিফ্রায়নৗ মানসিফৗরখৌ বুংখাদৗংমৗন, ‘নৗংছৗরৗ মানসি দাসিথাৎ আরৗ জাইয়া মানসি সিথাৎনায়, বিয়ৗ বিচারাও দায় গৗনাং জানায়।’ <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />নাথায় আং নৗংছৗরখৌ হৗন্নৗ, জাইয়া ফংবায় এবা বিনানাওনি ছায়াও রাগ জায়ৗব্লা, বিয়ৗ বিচারাও দায় গৗনাং জানায়। আরবাও, জাইয়া ‘নৗংখৌ জাম্বা হৗন্নৗব্লা, বিয়ৗ সানসুমৈ গিরিফৗরনিয়াও লাবৗনানৈ বিচার খৗলামজানায়!’ আরৗ জাইয়া ছৗরখৌবা জ্ঞান গৈয়ি হৗন্নানৈ বুঙৗব্লা, বিয়ৗ অয়াৎজৗংব্লাওনায় নরকয়াও গারসনজানায়নি গিনাংগৌয়াও থানায়।<verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />বিনিখাইনৗ নৗঙৗ জেব্লা বিন্দৗয়াও গাওনি দানখৌ গথাইনায়, বি সমাও বিহানৗ নৗংনি বিরুদ্ধনাও ফংবায় এবা বিনানাওনি মাবা খৗথা দং হৗন্নানৈ নৗঙৗ গৗসৗখাংব্লা, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />নৗংনি দানখৌ বিন্দৗনি মৗখাংয়াও দৗন্থনানৈ, থাং আরৗ গিবিয়াও গাওনি ফংবায়ফৗরজৗং মিলাইজ্লায়গ্রৗদৗ, আরৗ বিনি উনাও ফৈনানৈ নৗংনি দানখৌ বিন্দৗয়াও গথায়দৗ।<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />নৗংনি বিরুদ্ধনাও ছৗরবায়া বিচারসালিয়াও এৎদেৎনানৈ হৈব্লা নৗঙৗ বিচারসালিয়াও নুজাহৈনায়নি সিগাংনৗ বিজৗং মিলাইজ্লায়গ্রৗ। অৗঙাব্লা নৗঙৗ এৎদেৎনানৈ হৗগ্রাজৗং বিচার খৗলামগ্রানি সিগাঙাও ফছংহৈজানায়, আরৗ বিচারগিরিয়া নৗংখৌ জৗবথেসালিনি গিরিনৗ গথায়নায়, আরৗ নৗঙৗ জৗবথেসালিয়াও জৗবহৈজানায়। <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />নংথারগৌয়ৈ আঙৗ নৗংছৗরখৌ বুঙৗ, নৗং হৗনাংগৌনি গৎছে পায়সাখৌবৗ হৗজৗবমাগৌমানি নৗঙৗ জৗবথেসালিনিফ্রায় গথারনায় অৗঙা।<verse eid="MAT 5:26" /></para>
  <para style="s">জিনাহারিনি বিষয়</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />“নৗংছৗরৗ খৗনাখাবায়, বে বুংখানায় খৗথাখৌ, ‘নৗংছৗরৗ জিনাহারি দাখৗলাম।’ <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />নাথায় আং নৗংছৗরখৌ হৗন্নৗ ছৗরবায়া সাছে হিন্জাওখৌ লুবৈনানৈ নাইহৎনৗব্লা, বিয়ৗ বি সমাওনৗ বিজৗং গৗসৗয়াও জিনাহারি খৗলামবায়। <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />বিনিখাইনৗ নৗংনি আগ্ডা মগননা নৗংখৌ পাপমাও খৗখ্লৈব্লা বেখৌ নৗঙৗ এখ্লনানৈ গাহৎ। মানৗনা নৗংনি গাছেন দেহায়া নরকয়াও গারসনজানায়নিখুরৈ থাইছে মগন গৗয়িয়া নৗংনি থাখৈ মৗজাংসিন। <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />আরৗ নৗংনি আগ্ডা আখাইয়া নৗংখৌ পাপমাও খৗখ্লৈব্লা, বেখৌ নৗঙৗ দানছনানৈ গারহৎ। নৗংনি গাছেন দেহায়া নরকয়াও গারসনজানায়নিখুরৈ ফাৎছে আখাই গৗয়িয়া নৗংনি থাখৈ মৗজাংসিন।<verse eid="MAT 5:30" /></para>
  <para style="s">হিন্জাও নাগারনায়নি বিষয়</para>
  <para style="r">(<ref loc="MAT 19:9">মথি 19:9</ref>; <ref loc="MRK 10:11-12">মার্ক 10:11–12</ref>; <ref loc="LUK 16:18">লূক 16:18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />“বে আইনাও দং, ‘ছৗরবায়া গাওনি হিন্জাওখৌ নাগারব্লা বিয়ৗ নাগারনায়নি প্রমাণ বিলাই লিৎনানৈ হৗথৗং।’ <note caller="+" style="x"><char style="xo" closed="false">5:31 </char><char style="xt" closed="false"><ref loc="DEU 24:1">হূদা বিজাব 24:1</ref></char></note> <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />নাথায় আঙৗ নৗংছৗরখৌ হৗন্নৗ, ছৗরবায়া গাওনি হিন্জাওখৌ জিনাহারি ছাড়া গুবুন কারননৈ নাগারৗ, অব্লা বি হিন্জাওখৌ জিনাহারিনি লামাও লাংনায় জায়ৗ, আরৗ জাইয়া বি নাগারজানায় হিনজাওখৌ হাবা খৗলামৗ বিবৗ জিনাহারি খৗলামৗ।<verse eid="MAT 5:32" /></para>
  <para style="s">সমায় লানায়নি বিষয়</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />“নৗংছৗরৗ খৗনাবায়, গৗডৗনি মানসিফৗরনৗ বুংখানায়দংমৗন, ‘গাওনি সমায় লানায়খৌ দাছিফায়, নাথায় ফৗরবুনি থাখৈ জেখৌ সমায় লাবায় বেখৌ জাফুংহৗদৗ।’ <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />নাথায় আং দা নৗংছৗরখৌ হৗন্নৗ, নৗংছৗরৗ জেবৗ সমায় দালা, স্বৗর্গৗনিবৗ সমায় লানৗ নাঙা, মানৗনা বিয়ৗ ঈশ্বৗরনি সিংহাসন; <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />এবা বুহুমনিবৗ সমায় লানৗ নাঙা, মানৗনা বুহুমমা ঈশ্বৗরনি আঠেংদৗনগ্রা, যিরূশালেমনিবৗ সমায় লানৗ নাঙা, মানৗনা বিয়ৗ গেদেৎ রাজানিছৗ নৗগৗর। <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />নৗঙৗ গাওনি খর'নি মুঙৈবৗ সমায় লানৗ নাঙা মানৗনা নৗঙৗ গাওনি খর'নি খানায় ডৗংছেখৌবৗ গুফুৎ এবা গৗছৗমবৗ খৗলামনৗ হায়া। <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />নৗংছৗরনি বুংনাইয়া অৗংগৌলা অৗংগৌ অৗঙালা অৗঙা, বেনৗ জাথৗং, বেনি বাংসিননা গাজ্রিনিফ্রায় ফৈয়ৗ।<verse eid="MAT 5:37" /></para>
  <para style="s">ফালঠা লানানইনি খৗথা</para>
  <para style="r">(<ref loc="LUK 6:29-30">লূক 6:29–30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />“নৗংছৗরৗ বে খৗথাখৌ খৗনাবায়, ‘মগননি বদল মগন, আরৗ<note caller="+" style="x"><char style="xo" closed="false">5:38 </char><char style="xt" closed="false"><ref loc="EXO 21:24">অৗংখাৎলাংনায় 21:24</ref>; <ref loc="LEV 24:20">লেবীয় বিজাব 24:20</ref> </char></note>হাথাইনি বদল হাথাই।’ <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />নাথায় আং নৗংছৗরখৌ হৗন্নৗ, গাজ্রি মানসিখৌ বাধা দাহৗ। ছৗরবায়া নৗংছৗরখৌ আগ্ডা খাওলায়াও সোবাব্লা, বিছৗরনৗ গুবুন ফাৎছে খাওলায়খৌবৗ গথায়নানৈ হৗ। <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />ছৗরবায়া বিচারসালিয়াও বিচার খৗলাম হৗনানৈ নৗংনি গুছ্লাখৌ মৗননৗ লুবৈয়ৗব্লা, বিনৗ নৗংনি জুমগ্রা সি'খৌবৗ হৗ। <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />আরৗ ছৗরবায়া নৗংখৌ এক মাইল বিবান বানলাংহৗব্লা, বিছৗরজৗং নৗঙৗ দুই মাইল বান্নানৈ হৈ। <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />ছৗরবায়া নৗংনিয়াও মাবা মুঙাফৗর বিদৗংব্লা, বিনৗ হৗ আরৗ ছৗরবায়া নৗংনিফ্রায় ছৗলাও বিব্লা, বিখৌ নৗঙৗ আখাইগৗজা দাহগারহৎ।<verse eid="MAT 5:42" /></para>
  <para style="s">বিসারুফৗরখৌ অন্নায়নি বিষয়</para>
  <para style="r">(<ref loc="LUK 6:27-28">লূক 6:27–28</ref>,<ref loc="LUK 6:32-36">32–36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />“নৗংছৗরৗ বে খৗথাখৌ খৗনাবায়, গাওনি উছুংছেনি পাড়াপুরুশিফৗরখৌ অন, আরৗ বিসারুফৗরখৌ মুগৈ। <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />নাথায় আঙৗ নৗংছৗরখৌ হৗন্নৗ, নৗংছৗরৗ গাওনি বিসারুফৗরখৌ অন, আরৗ জাইফ্রা নৗংছৗরখৌ নাছয়ৗ বিছৗরনি থাখৈ প্রার্থনা খৗলাম, <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />জাহাথে নৗংছৗরৗ স্বৗর্গৗয়াও থানায় নৗংছৗরনি বিফানি বিসাফৗর জানৗ হায়ৗ। মানৗনা বিয়ৗ মৗজাং গাজ্রি বয়নিবৗ ছায়াও গাওনি সানখৌ স্রাং হৗয়ৗ, আরৗ ধার্মিকফৗরনি ছায়াও জেরৈ, বেবাদিনৗ অধার্মিকফৗরনি ছায়াওবৗ নখা হাহৗয়ৗ, <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />আরৗ নৗংছৗরখৌ জাইফ্রা অন্নৗ, বিছৗরখৌ বান নৗংছৗরৗ অনফিননৗব্লা, ঈশ্বৗরনিফ্রায় নৗংছৗরৗ মা পুরস্কার মৗনৗ হাগৌ? মা কি খাজনা খাংগ্রাফ্রাবৗ বেখৌনৗ খৗলামা? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />আরৗ নৗংছৗরৗ গাও গাওনি মানসিফৗরখৌ বান অনব্লা, গুবুনফৗরনিখুরৈ নৗংছৗরৗ মা বাংসিন মাওখৗ? বেবাদিখৌ সংসারিফ্রাবৗ বেখৌনৗ খৗলামৗ? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />নৗংছৗরনি স্বৗর্গৗনি বিফাআ জেরৈ খাঁটি, বেবাদিনৗ নৗংছৗরবৗ খাঁটি জা।”<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">দান হৗনায়নি বিষয়</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />“সাবধান জা মানসিফৗরনৗ দিন্ঠিনৗ থাখৈ বান নৗংছৗরৗ ধৗরৗমনি খামানিফৗরখৌ মাওনৗ নাঙা, নৗং মাওব্লা নৗংছৗরনি স্বৗর্গৗয়াও থানায় বিফানিফ্রায় নৗং মৗনবৗ পুরস্কার মৗননায় অৗঙা।<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />বিনিখাইনৗ নৗংছৗরৗ জেব্লা হাওরিয়াফৗরনৗ দান হৗয়ৗ, দিন্ঠিফ্লাগ্রাফ্রা জেরৈ সিবিগ্রা ন্ব'য়াও আরৗ লামাফৗরাও বয়নৗবৗ দিন্ঠিনানৈ বাখ্নাইজানৗ থাখৈ দান হৗয়ৗ, বেবাদি নৗংছৗরৗ দাহৗ। নংথারগৌয়ৈ আঙৗ নৗংছৗরখৌ বুঙৗ, বিছৗরৗ গাও গাওনি পুরস্কারখৌ ঠৗজাছে মৗনখাবায়। <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />নাথায় জেব্লা নৗংছৗরৗ হাওরিয়াফৗরনৗ দান হৗয়ৗ, অব্লা নৗংছৗরনি আগ্ডা আখাইয়া মা মাওদৗং বিখৌ নৗংছৗরনি আখছি আখাইখৌ দামিথিহৗ। <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />নৗংনি দান হৗনাইয়া জাহাথে গোপন থায়ৗ। অব্লা নৗংনি বিফায়া, জাইয়া নৗংনি মাওনায়খৌ গোপননৈ নুয়ৗ, আরৗ বিয়ৗ নৗংনৗ পুরস্কার হৗনায়।<verse eid="MAT 6:4" /></para>
  <para style="s">প্রার্থনা আরৗ উপবাসনি ফৗরৗংনায়</para>
  <para style="r">(<ref loc="LUK 11:2-4">লূক 11:2–4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />“নৗংছৗরৗ প্রার্থনা খৗলামৗব্লা, দিন্ঠিফ্লাগ্রাফৗর বাদি প্রার্থনা দাখৗলাম। মানৗনা বিছৗরৗ বয়বৗ নুনায় বাদি সিবিগ্রা ন্ব'ফৗরাও আরৗ লামানি খনাফৗরাও গছংনানৈ প্রার্থনা খৗলামনৗ মৗজাংমৗনৗ। নংথারগৌয়ৈ আঙৗ নৗংছৗরখৌ বুঙৗ, বিছৗরৗ গাও গাওনি মৗননাংগৌ পুরস্কারখৌ ঠৗজাছে মৗনখাবায়। <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />নাথায় জেব্লা নৗং প্রার্থনা খৗলামৗ, অব্লা নৗংনি খঠ্রা সিঙাও হাব, দুয়ার ফাংথেনানৈ নৗঙৗ বিফানিয়াও প্রার্থনা খৗলাম, জাইয়াখৌ নুয়া, জাইয়া নৗংনি মাওনায়খৌ গোপননৈ নুয়ৗ আরৗ বিয়ৗ নৗংনৗ পুরস্কার হৗনায়।<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />জেব্লা নৗংছৗরৗ প্রার্থনা খৗলামৗ, অব্লা গুবুন ধৗরৗমমিয়াফৗর বাদি নংবাং জাবাং খৗথাফৗরজৗং বিখৗন বিখৗন প্রার্থনা খৗলামনৗ নাঙা। মানৗনা গলে গলে প্রার্থনা খৗলামনাইয়াও ঈশ্বৗরা বিছৗরনি প্রার্থনাফৗরখৌ খৗনাছংজানায় হৗন্নানৈ সান্নৗ। <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />বিছৗরবাদি নৗংছৗরৗ দাজা, নৗংছৗরনৗ মা নাংগৌ, বেখৌ নৗংছৗরনি বিফায়া নৗংছৗর বিয়া সায়াওনৗ মিথিখাগৌ। <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />নৗংছৗরৗ বেবাদিনৗ প্রার্থনা খৗলামনৗ নাংগৌ:</para>
  <para style="q1" vid="MAT 6:9">জৗংনি স্বৗর্গৗয়াও থানায় আফা</para>
  <para style="q1" vid="MAT 6:9">নৗংনি মুঙা গৗথার জাথৗং,<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />নৗংনি রাইজৗয়া ফৈথৗং,</para>
  <para style="q1" vid="MAT 6:10">নৗংনি গৗসৗয়া জেরৈ স্বৗর্গৗয়াও</para>
  <para style="q1" vid="MAT 6:10">বেবাদিনৗ বুহুম ছায়াওবৗ জাথৗংহৗনা<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />জৗংনি সানফ্রৗমবৗনি জানৗ দিনৈনি নাংগৌখৌ জৗংনৗ হৗ।<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />আরৗ জৗংনি গাছেন দায়ফৗরখৌ ক্ষমা হৗ</para>
  <para style="q2" vid="MAT 6:12">জেরৈ জৗংবৗ গুবুনফৗরনি ছায়াও দায় মাওনায়ফৗরখৌ ক্ষমা হৗয়ৗ।<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />আরৗ জৗংখৌ আনজাৎনাও দাখৗখ্লায় নাথায় গাজ্রিনিফ্রায় জৗংখৌ বাছায়।<verse eid="MAT 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />নৗংছৗরনি বিরুদ্ধনাও গুবুনফৗর দায় মাওনায়খৌ নৗংছৗর ক্ষমা হৗব্লা, স্বৗর্গৗনি বিফায়াবৗ নৗংছৗরনি দায় মাওনায়খৌ নিমাহা হৗনায়। <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />নাথায় নৗংছৗরনি বিরুদ্ধ গুবুনফৗর দায় মাওনায়খৌ নৗংছৗরৗ ক্ষমা হৗয়াব্লা নৗংছৗরনি বিফায়াবৗ নৗংছৗরনি দায়খৌ ক্ষমা হৗনায় অৗঙা।<verse eid="MAT 6:15" /></para>
  <para style="s">উপবাসনি খৗথা</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />“জেব্লা নৗংছৗরৗ উপবাস থায়ৗ, অব্লা দিন্ঠিফ্লাগ্রাফৗর বাদি মৗখাং ছৗম দিন্ঠিনৗ নাঙা। উপবাস থাদৗং হৗন্নানৈ গুবুনফৗরনৗ দিন্ঠিনৗ বিছৗরৗ গাওছৗরনি মৗখাংফৗরখৌ মৈলা দৗন্নৗ। নংথারগৌয়ৈ আঙৗ নৗংছৗরখৌ বুঙৗ, বিছৗরৗ গাও গাওনি মৗননাংগৌ পুরস্কারখৌ ঠৗজাছে মৗনখাবায়। <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />নাথায় জেব্লা নৗংছৗরৗ উপবাস থায়ৗ, অব্লা খর'য়াও থাও ফুন আরৗ নৗংছৗরৗ গাও গাওনি মৗখাংখৌ চু, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />অব্লানৗ রাওবৗ নৗংছৗরখৌ উপবাস থাদৗং হৗন্নানৈ মিথিনায় অৗঙা, নাথায় নৗংছৗরনি বিফা বান, জাইয়া নুজায়া; আরৗ নৗংছৗরনি বিফা, জাইয়া গোপনাও মা মাওদৗং বিখৌ নুয়ৗ, আরৗ বিনৗ নৗংছৗরনৗ পুরস্কার হৗনায়।<verse eid="MAT 6:18" /></para>
  <para style="s">স্বৗর্গৗনি ধৗন</para>
  <para style="r">(<ref loc="LUK 12:33-34">লূক 12:33–34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />“গাও গাওনি থাখৈ বে বুহুমাও ধৗনখৌ দাফুথুম বেয়াও গুন অৎনৗ, মারাম জায়ৗ, আরৗ সিখাওফ্রাবৗ খাওয়ৗ। <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />নাথায় গাও গাওনি থাখৈ স্বৗর্গৗনি ধৗনখৌ বুথুম, জেরেও এমফৌবৗ আরৗ মামৗর খানাইয়াবৗ আদ্রিখৗলামা, আরৗ সিখাওফ্রাবৗ ইনজুর হানান খাওনৗ হায়া। <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />মানৗনা নৗংছৗরনি ধৗন সম্পত্তিয়া জেরও থায়ৗ, বিহানৗ নৗংছৗরনি গৗসৗয়াবৗ থায়ৗ।<verse eid="MAT 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />মগননা মৗদৗমনি বাতি। নৗংনি মগননা মৗজাংব্লা, নৗংনি গাছেন মৗদৗমমানৗ স্রাং জাজৗবনায়। <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />নাথায় নৗংনি মগননা গাজ্রিব্লা নৗংনি গাছেন মৗদৗমমানৗ বেছে খৗমসি জানায়! বেনিখাইনৗ নৗংনিয়াও থানায় স্রাংয়া, খৗমসি জাব্লা, বি খৗমসি বেছেগ্রাব গেদেৎ!<verse eid="MAT 6:23" /></para>
  <para style="s">সানৈ বৈগৗমানি দাস</para>
  <para style="r">(<ref loc="LUK 16:13">লূক 16:13</ref>; <ref loc="LUK 12:22-31">12:22–31</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />“রাওবৗ সানৈ বৈগৗমাখৌ সেবা খৗলামনৗ হায়া মানৗনা বিয়ৗ সাছেখৌ মুগৈনায় আরৗ গুবুন সাছেখৌ অন্নায়, এবা বিয়ৗ সাছেজৗং নাংঠাবনায় আরৗ গুবুন সাছেনিফ্রায় গৗজান জানায়। নৗংছৗরৗ ঈশ্বৗর আরৗ টাকা পায়সা, বে মৗন্নৈখৌ লৗগৗছে সেবা খৗলামনৗ হায়া।<verse eid="MAT 6:24" /></para>
  <para style="s">চিন্তা দাখৗলাম</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />“বেনিখাইনৗ আঙৗ নৗংছৗরখৌ হৗন্নৗ, জিউনি থাখৈ, মা জানায় আরৗ মা লৗংনায়, আরৗ মৗদৗমনি থাখৈ নৗংছৗরৗ মা গান্নায় আরৗ জুমনায়, নৗংছৗরৗ জেবৗ চিন্তা দাখৗলাম। মা কি জিউয়া জানায় লৗংনায় এবা মৗদৗমনি গান্নায় জুমনায়নিফ্রায়, গৗনাংসিন বিষয় অৗঙা না? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />নাইদৗ নখ্রাংনি দাওছেনফৗরখৌ; বিছৗরৗ বিগৎবৗ ফৗয়া এবা হায়া, আবাদবৗ বাখ্রিয়াও বুথুমা, অব্লাবৗ নৗংছৗরনি স্বৗর্গৗনি বিফাআ বিছৗরখৌ জাহৗগাছৈনৗ দং। মা কি নৗংছৗরৗ দাওছেনফৗরনি খুরৈ দাম গৗছাসিন অৗঙা না? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />আরৗ বেফৗরনি থাখৈ সানহাবনানৈ ছৗরবায়া গাওনি আয়ুখৌ ঘন্টা মৗনছে ফৗলাওদেৎনৗ হানায় খৗমা?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />আরৗ মানৗ নৗংছৗরৗ গাননায় জৗমনায়নি থাখৈ জিংগা সিয়ৗ? সাননানৈ নায়, হুয়াওনি লিলি বিবারফ্রা মাব্রৈ দেৎনৗ। বেফৗরৗ খামানিফৗরবৗ মাওয়া, এবা সি'ফৗরবৗ দায়া, <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />অব্লাবৗ আঙৗ নৗংছৗরখৌ বুঙৗ, যে শলোমন রাজায়া এছেবাং জৗংব্লাও মাব্লাও সাজাইনানৈ থানায়াওবৗ বে বারছে বিবার বাদিবৗ গাওখৌ সমায়হৗনৗ হায়াখৈছৈ। <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />ফৗথারাও রজনায় গাংসৗয়া দিনৈ দং, নাথায় গাবৗননৗ অয়াৎনাও গারসৗন্নান সাওজানায়, অব্লাবৗনৗ ঈশ্বৗরা বেফৗরখৌনৗ এছেবাং সাজাইয়ৗব্লা, ও ইছে ফৗথায়নাইফৗর, মা কি বিয়ৗ নৗংছৗরখৌ বাংসিন সাজাইসিননায় অৗঙা?<verse eid="MAT 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 6:31" />বিনিখাইনৗ বেবাদি বুংনানৈ চিন্তা দাখৗলাম, জৗঙৗ মা জানায়? এবা জৗঙৗ মা লৗংনায়? এবা জৗঙৗ মা গাননায় হৗন্নানৈ। <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />মানৗনা গুবুনহারিফ্রা বেফৗরনি উনাও খাৎনৗ, বেফৗর গাছেনখৌবৗ নৗংছৗরনৗ নাংগৌ হৗন্নানৈ নৗংছৗরনি স্বৗর্গৗনি বিফায়া মিথিখাগৌ। <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />নাথায় সিগাংয়াও ঈশ্বৗরনি রাইজৗখৌ আরৗ বিনি ধৗরৗমসুলাখৌ নাগিৎ, অব্লানৗ বিয়ৗ বেফৗর গাছেনখৌবৗ নৗংছৗরনৗ হৗয়া জানায়। <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />বেনিখাইনৗ নৗংছৗরৗ গাবৗননি থাখৈ জিংগাসিনৗ নাঙা, মানৗনা গাবৗনা গাওনি থাখৈ গাওনৗ জিংগাসিনায়। দিনৈনি থাখৈ দিনৈনৗ সৈনাইয়ানৗ ঠৗয়ৗ।”<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">গুবুনখৌ বিচার খৗলামনায়নি খৗথা</para>
  <para style="r">(<ref loc="LUK 6:37-38">লূক 6:37–38</ref>,<ref loc="LUK 6:41-42">41–42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />“নৗংছৗরৗ গুবুনখৌ বিচার দাখৗলাম, জাহাথে নৗংছৗরবৗ বিচার খৗলামজায়িবাদি। <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />মানৗনা নৗংছৗরৗ গুবুনখৌ জেরৈ বিচার খৗলামনায়, বেবাদিনৗ নৗংছৗরবৗ বিচার খৗলামফিনজানায়, আরৗ নৗংছৗরৗ গুবুনফৗরনৗ জেরৈ বাদি ছুনানৈ হৗয়ৗ, বেবাদিনৗ নৗংছৗরনৗবৗ ছুনানৈ হৗফিননায় জানায়। <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />নৗঙৗ নৗংনি ফংবায়নি মগননাও থানায় ডংফাংনি গৗল্লৈ গুন্দ্রিখৌ নুয়ৗব্লা, নৗঙৗ গাওনি মগননাও থানায় ডংফাংনি গেদেৎ টুকরাখৌ মানৗ নুয়া? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />মাব্রৈ নৗঙৗ গাওনি ফংবায়খৌ বুংনৗ হায়ৗ, নৗংনি মগননি ডংফাংনি গৗল্লৈ গুন্দ্রিখৌ আঙৗ এখোনানৈ হৗনি হৗন্নানৈ, জেব্লা নৗঙৗ গাওনি মগননাও থানায় গেদেৎ ডংফাং টুমাখৌ নুয়া? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />ও দিন্ঠিফ্লাগ্রা, সিগাং নৗঙৗ গাওনি মগননাও দংনায় ডংফাং টুমাখৌ এখোনানৈ লাগ্রৗ, অব্লাছৗ নৗঙৗ ফংবায়নি মগননি ডংফাং গৗল্লৈ গুন্দ্রিখৌ এখোনানৈ হৗনৗ থাখৈ মৗজাংয়ৈ নুনৗ হানায়।<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />গৗথার মৗঙাখৌ ছৈমাফৗরনৗ দাহৗ, আরৗ নৗংছৗরনি মুক্তাফৗরখৌ অমাফৗরনি সিগাঙাও দাগার, নৗং খৗলামৗব্লা অমাফ্রা বেফৗরখৌ বিছৗরনি আঠেংজৗংছৗ গাফ্লেনায় আরৗ গিদিংনানৈ নৗংখৌ টুকরা টুকরা খৗলামনৗ হাগৌ।<verse eid="MAT 7:6" /></para>
  <para style="s">বি, নাইগিৎ আরৗ দুয়ারাও ছৌ</para>
  <para style="r">(<ref loc="LUK 13:25-27">লূক 13:25–27</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />“বি অব্লা নৗংছৗরনৗ হৗনায় জানায়, নাইগিৎ অব্লা নৗংছৗরৗ মৗননায়। দুয়ারাও ছৌ অব্লা নৗংছৗরনৗ খেওনানৈ হৗনায় জানায়। <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />মানৗনা বিগ্রা সাফ্রৗমবৗ মৗন্নৗ আরৗ জাইয়া নাগিৎনৗ বিয়ৗ মৗন্নৗ, আরৗ জাইয়া দুয়ার ছৌয়ৗ বিনৗ খেওনানৈ হৗনায় জানায়। <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />নৗংছৗরনি গেজেরাও, ছৗর বেবাদি বিফা দং, বিসাজ্লায়া সিঠাও বিব্লা, বিনৗ অন্ঠাইখৌ হৗনায়? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />আরৗ নাঃ বিব্লা, বিনৗ জিবৌ হৗনায়? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />অব্লা নৗংছৗরৗ গাজ্রি জানানৈবৗ গাওনি বিসাফৗরনৗ মৗজাং মৗঙাফৗরখৌ হৗনৗ রৗংগৌব্লা, নৗংছৗরনি স্বৗর্গৗনি বিফায়া গাওনিয়াও বিগ্রাফৗরনৗ মৗজাং মৗঙাফৗরখৌ বেছেবাং বাংসিন হৗসিননায়! <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" />বিনিখাইনৗ গাছেন বিষয়াও মানসিফৗরনিফ্রায় নৗংছৗরৗ জেরৈ ব্যবহার মৗন্নৗ লুবৈয়ৗ, বিবাদিনৗ নৗংছৗরবৗ বিছৗরজৗং ব্যবহার খৗলাম, মানৗনা বেনৗ আইননি থৗননাইয়া আরৗ নবিফৗরনি ফৗরৗংনায়নি গুছুং বাহাগৗয়া।<verse eid="MAT 7:12" /></para>
  <para style="s">গেছেব আরৗ গুয়ার গেট</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />“গেছেব দুয়ারজৗং হাব। মানৗনা জৗবস্রাংনাইয়াও দৈদেনলাংগ্রা দুয়ারয়া গুয়ার আরৗ লামায়া গিদিৎ, আরৗ গৗবাংয়ানৗ বিজৗং হাবলাঙৗ। <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />নাথায় গৗঠাংনি দুয়ারয়া গৗলৈ আরৗ লামায়া গেছেব, জেয়া গৗঠাঙাও দৈদেনলাঙৗ আরৗ বেখৌ ইছে বান মানসিফ্রা মৗন্নৗ।<verse eid="MAT 7:14" /></para>
  <para style="s">বিংফাং আরৗ বিনি বিথাই</para>
  <para style="r">(<ref loc="LUK 6:43-44">লূক 6:43–44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />“নংখায় নবিফৗরনিফ্রায় সাবধান জা। মানৗনা বিছৗরৗ মেন্ডাফৗরনি বিগুর গাননানৈ নৗংছৗরনিয়াও ফৈয়ৗ, নাথায় গৗসৗ সিঙাও বিছৗরৗ হিংস্র লখ্রাফৗর বাদিছৗ। <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />নৗংছৗরৗ বিছৗরনি বিথাইফৗরজৗং বিছৗরখৌ চিনাইনায়। মানসিয়া মা কি সু-বিন্ডৗংনিফ্রায় দ্রাক্ষা বিথাই এবা সুগৗনাং বিলাইনিফ্রায় দুমব্রু বিথাইখৌ বুথুমৗ? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />বেবাদিনৗ, মৗজাং বিংফাংয়াও মৗজাং বিথাই থাইয়ৗ, গাজ্রি বিংফাংয়াও গাজ্রি বিথাই থাইয়ৗ। <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />মৗনছে মৗজাং বিংফাংয়া গাজ্রি বিথাই থায়নৗ হায়া, আরৗ মৗনছে গাজ্রি বিংফাংয়া মৗজাং বিথাই থায়নৗ হায়া। <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />মৗনফ্রৗমবৗ মৗজাং বিথাই থাইয়ি বিংফাংয়া দানফাইজানানৈ অৎনাও গারসনজায়ৗ। <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />বিনিখাইনৗ নৗংছৗরৗ বিছৗরনি বিথাইফৗরজৗংনৗ বিছৗরখৌ চিনাইনায়।<verse eid="MAT 7:20" /></para>
  <para style="s">সত্য আরৗ নংখায় ছেলাফৗর</para>
  <para style="r">(<ref loc="LUK 13:25-27">লূক 13:25–27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />“জাইফ্রা আংখৌ, ‘ও ফৗরবু, ও ফৗরবু,’ হৗন্নানৈ গাবজ্রিয়ৗ, বিছৗরৗ সাফ্রৗমবৗ যে স্বৗর্গৗ রাইজৗয়াও হাবনৗ হানায়, বেবাদি অৗঙা, নাথায় জাইয়া আংনি আফানি গৗসৗ বাদি মাওনায়, বিছৗর বান হাবনৗ মৗননায়। <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />বি দিননাও গৗবাঙানৗ আংখৌ বুংনায়, ও ফৗরবু, ও ফৗরবু নৗংনি মুঙৈ জৗঙৗ মা কি ভাববাণী বুঙাখৈমৗন আরৗ নৗংনি মুঙৈ মা কি জৗঙৗ ভূতফৗরখৌ হৗয়ননাখৈমৗন? নৗংনি মুঙৈ মা কি জৗঙৗ গৗবাং সৗমৗ গৗনাং খামানিফৗরখৌ মাওয়াখৈমৗন? <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />অব্লা আং গৗরায়ৈ বিছৗরখৌ বুংনায়, আং মাব্লাবাবৗ নৗংছৗরখৌ মিথিয়ামৗন, ও গাজ্রি খামানি মাওগ্রাফৗর নৗংছৗরৗ আংনিফ্রায় গৗজান জা!<verse eid="MAT 7:23" /></para>
  <para style="s">সানৈ ন্ব'লুগ্রাফৗর</para>
  <para style="r">(<ref loc="LUK 6:47-49">লূক 6:47–49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />“বেনিখাইনৗ সাফ্রৗমবৗ জাইয়া আংনি খৗথাফৗরখৌ খৗনাছংনানৈ বেফৗরখৌ মাওয়ৗ, বিয়ৗ জাবায় এরেই বাদি সাছে বুদ্ধিমান মানসি, জাইয়া অন্ঠাইনি ছায়াও গাওনি ন্ব'খৌ লুয়ৗ। <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />অখা ফৈবায়, দৈয়া জৗওখৗবায়, আরৗ বার বারবায় আরৗ বি ন্ব'খৌ বুবায়, নাথায় ন্ব'য়া গৗগ্লৈয়াখৈ, মানৗনা বিয়ৗ ন্ব'খৌ অন্ঠাইনি ছায়াও লুখাদৗং।<verse eid="MAT 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 7:26" />নাথায় সাফ্রৗমবৗ জাইয়া আংনি খৗথাফৗরখৌ খৗনাছংনানৈ ফালিয়া, বিয়ৗ এরেই বাদি সাছে সান্নৗ রৗঙৈ মানসি বাদি, জাইয়া বালাবারিয়াও গাওনি নখৌ লুয়ৗ। <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />উনাও অখা ফৈবায়, দৈ বানা লৗমবায়, আরৗ বাররা গৗব্রাবমৈনৗ বারবায় আরৗ ন্ব'খৌ বুবায়, আরৗ বি ন্ব'য়া গৗগ্লৈবায় আরৗ বে ন্ব' গৗগ্লৈনাইয়া বেছে গিথাওথাও গুরুববায়।”<verse eid="MAT 7:27" /></para>
  <para style="s">একথিয়ারজৗং যীশুনি ফৗরৗংনায়</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />যীশুআ বেফৗর গাছেনখৌ বুংখাংনাইনি উনাও, মানসিনি হান্জায়া বিনি ফৗরৗংনাইয়াও সৗমৗ নাংদৗং, <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />মানৗনা বিয়ৗ আইন গুরুফৗর বাদি ফৗরৗংয়ামাৎনিন সাছে একথিয়ার গৗনাং মানসি বাদিছৗ ফৗরৗংদৗং।<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">সাছে খুরিয়া গৗনাং মানসিখৌ ছৗখানায়</para>
  <para style="r">(<ref loc="MRK 1:40-45">মার্ক 1:40–45</ref>; <ref loc="LUK 5:12-16">লূক 5:12–16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />জেব্লা যীশুআ হাজৗনিফ্রায় অৗংখাৎবৗদৗং, অব্লা গেদেৎ হান্জায়া বিনি উন উন ফৈদৗং। <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />আরৗ বে সমাও সাছে খুরিয়া রগ গৗনাং মানসিয়া বিনিয়াও ফৈনানৈ বিখৌ খুলুমনানৈ হৗনদৗং। “ফৗরবু, নৗঙৗ গৗসৗ জায়ৗব্লা আংখৌ ছৗখানৗ হাগৌ।”<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />আরৗ যীশুআ গাওনি আখাইখৌ ফৗলাওনানৈ আরৗ বিখৌ দাংনানৈ হৗনবায়। “আঙৗ গৗসৗ জায়ৗ, নৗঙৗ মৗজাং জা!” আরৗ ঠাবমৈনৗ বিনি খুরিয়া রগ'য়া গাদৗং। <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />আরৗ যীশুআ বিখৌ হৗনদৗং, “নৗঙৗ বে খৗথাখৌ রাওনৗবৗ দাখৗথা, নৗঙৗ ঠৗংজৗং যাজকনেও থাংনানৈ গাওখৌ দিন্ঠিহৈদৗ, আরৗ নৗংনি রগ'য়া ঠাল্লায়ৈ গাথারবায় হৗন্নানৈ সাফ্রৗমনিবৗ সিগাঙাও সাক্ষ্য হৗনৗ থাখৈ মোশিনি আইন বাদি বলি বাওহৈদৗ<note caller="+" style="x"><char style="xo" closed="false">8:4 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">লেবীয় বিজাব 14:1–32</ref> </char></note>।”<verse eid="MAT 8:4" /></para>
  <para style="s">শতপতিনি লেংখৌ ছৗখানায়</para>
  <para style="r">(<ref loc="LUK 7:1-10">লূক 7:1–10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />জেব্লা যীশুআ কফরনাহুমাও হাবহৈয়ৗ, অব্লা দাওহা নাংগ্রাফৗরনি সাছে শতপতিয়া বিনেও ফৈনানৈ হেফাজাব হৗনৗ থাখৈ খাওলায়নানৈ হৗনদৗং। <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />“ও ফৗরবু, বিয়ৗ হৗনবায়, আংনি দাসআ ঘৈলি জাজানানৈ ন্ব'য়াও গৗগ্লৈছৗনান, গৗবাং সৈছৗনানৈ দং।”<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />যীশুআ বিখৌ হৗনবায়, “আঙৗ ফৈনায় আরৗ বিখৌ ছৗখানায়।”<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />শতপতিয়া বুংফিনবায়, “ও ফৗরবু, নৗংখৌ আংনি ন্ব'য়াও নাজাওনৗ থাখৈ আং সমায়া। নৗঙৗ খৗথাজৗং বান বুংহৎদৗ অব্লানৗ আংনি দাসআ হামথারনায়। <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />মানৗনা আংবৗ সাছে একথিয়ারনি সিঙাও দৗনজানায় মানসি, দেৎসিননি হুকুম বাদি আংবৗ মাওনাংগৌ, আংনি সিঙাওবৗ দাওহা নাংগ্রাফৗর দং, আং বিছৗরনি সাছেখৌ, ‘থাং,’ হৗনব্লা, বিয়ৗ থাঙৗ, আরৗ, ‘ফৈ,’ হৗনব্লা, বিয়ৗ ফৈয়ৗ, আরৗ আংনি দাসখৌ বেখৌ ‘মাও,’ হৗনব্লা বিয়ৗ মাওয়ৗ।”<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />জেব্লা যীশুআ বে বুংনায়খৌ খৗনায়ৗ অব্লা বিয়ৗ সৗমৗ নাংদৗং আরৗ গাওনি উন উন থাংনায় মানসিফৗরখৌ হৗনদৗং, “নংথারগৌয়ৈ আঙৗ নৗংছৗরখৌ বুঙৗ, ইস্রায়েলফৗরনি গেজেরাওবৗ এছেগ্রাব গেদেৎ ফৗথায়নাইখৌ আঙৗ নুনৗ মৗনাখৗছৈ। <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />আং নৗংছৗরখৌ বুঙৗ যে গৗবাং মানসিফ্রা সানজা আরৗ সিনাবনিফ্রায় ফৈনানৈ অব্রাহাম, ইসাহাক আরৗ যাকোবজৗং লৗগৗছে স্বৗর্গৗ রাইজৗনি ভজয়াও জানৗ জিরাইফানায়। <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />নাথায় স্বৗর্গৗ রাইজৗয়া জায়ফৗরনি<note caller="+" style="f"><char style="fr" closed="false">8:12 </char><char style="ft" closed="false">স্বৗর্গৗ রাইজৗনি ভাগিদারফ্রা জুদাইয়ারিফ্রানৗ, নাথায় জাইফ্রা যীশুখৌ নাজাওয়া বিছৗরৗ বাইরাও খৗমসিয়াও গাহৎজানায়। </char></note> জানাংগৌমৗন, বিছৗরৗ বাইরাও, খৗমসিয়াও গাহৎজানায়, জেরও গাবনায় আরৗ হাথাই অফ্রেনায়।” <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />অব্লা যীশুআ শতপতিখৌ হৗনদৗং, “থাংদৗ! নৗং ফৗথায়নায় বাদিনৗ জাথৗংছৈ।” আরৗ বে সমাওনৗ বিনি দাসআ গৗখ্রৗং জাদৗং।<verse eid="MAT 8:13" /></para>
  <para style="s">যীশুনি গৗবাংখৌ ছৗখানায়</para>
  <para style="r">(<ref loc="MRK 1:29-34">মার্ক 1:29–34</ref>; <ref loc="LUK 4:38-41">লূক 4:38–41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />জেব্লা যীশুআ পিতরনি ন্ব'য়াও থাংনানৈ নুবায় পিতরনি বিখুনজৗয়া লৗমজানায়জৗং বিছানায়াও উন্ডুছৗনানৈ দং। <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />আরৗ যীশুআ বিনি আখাইয়াও জেব্লা দাংয়াছৈ, আরৗ লৗমজানাইয়া বিখৌ নাগারদৗং আরৗ বিয়ৗ জিখাংনানৈ যীশুখৌ সেবা খৗলামদৗং।<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />জেব্লা মৗনাবিলি ছফৈয়ৗ, ভূত হমজানায় গৗবাংথার মানসিফৗরখৌ বিনিয়াও লাবৗদৗং আরৗ বিয়ৗ ভুত হমজানায় জিউফৗরখৌ খৗথাজৗংনৗ হুয়নদৗং আরৗ গাছেন জব্রাফৗরখৌ ছৗখাদৗং। <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />যিশাইয় নবিনি বুংনায় বে খৗথায়া জাফুংবায়,</para>
  <para style="q1" vid="MAT 8:17">“বিয়ৗ জৗংনি ছানায়-সুনায়ফৗরখৌ</para>
  <para style="q2" vid="MAT 8:17">লাবায় আরৗ রগ'ফৗরখৌ বানবায়।”<verse eid="MAT 8:17" /></para>
  <para style="s">যীশুজৗং উন উন থাংফানায়</para>
  <para style="r">(<ref loc="LUK 9:57-62">লূক 9:57–62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />যীশুআ গাওনি সৗরগিদিং ভিরখৌ নুনানৈ, বিয়ৗ গাওনি ছেলাফৗরখৌ লৈথৗ বাৎনানৈ থাংনৗ থৗনবায় <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />বে সমাও সাছে আইন গুরুআ বিনিয়াও ফৈনানৈ হৗনবায়, “ও গুরু নৗং জেরও থাঙৗ, আংবৗ বিহানৗ থাংনায়।”<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />যীশুআ বুংফিনবায়, “সিয়ালফৗরহা থানৗ গুডুং দং, নখ্রাংনি দাওছেনফৗরহা বাসা দং, নাথায় মানসিনি বিসাহৌয়ানে<note caller="+" style="f"><char style="fr" closed="false">8:20 </char><char style="ft" closed="false">যীশুআ গাওনৗ গাওনি নামখৌ “মানসিনি বিসাহৌয়া” দৗনদৗং, মানৗনা যিহূদীফ্রা সাছে বিসেষ মানসিনি থাখৈ নেনান দংমৗন। দানিয়েল নবিআ বে বিশেষ মানসিনি বারৈ বুংদৗং। (নাইদৗ </char><char style="xt"><ref loc="DAN 7:13-14">দানিয়েল 7:13–14</ref></char>) বে মানসিয়ানৗ জাবায় ঈশ্বৗরজৗং “সাইখজানায়” বেনৗ যীশু (<char style="xt"><ref loc="JHN 5:27">যোহন 5:27</ref>; <ref loc="JHN 6:27">6:27</ref></char>)</note> খরঃ দৗননৗ জায়গা গৈয়া।”<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />ছেলাফৗরনি গেজেরনিফ্রায় সাছেয়া হৗনবায় “ফৗরবু, আংনি আফাখৌ ফবহৈনৗ আংখৌ থাংনৗ হৗগ্রৗদৗ।”<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />নাথায় যীশুআ বিখৌ বুংবায়, “নৗং আংজৗং ফৈ, গৗথৈফ্রানৗ<note caller="+" style="f"><char style="fr" closed="false">8:22 </char><char style="ft" closed="false">জাইফ্রা জিউয়াও গৗথৈ অর্থাৎ জাইফৗরহা জৗবনৗ গৈয়ি গৗঠাং জিউ গৈয়া। </char></note> গাওছৗরনি গৗথৈফৗরখৌ ফবথৗং।”<verse eid="MAT 8:22" /></para>
  <para style="s">বার হুংখাখৌ থামিহৗনায়</para>
  <para style="r">(<ref loc="MRK 1:29-34">মার্ক 1:29–34</ref>; <ref loc="LUK 4:38-41">লূক 4:38–41</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />উনাও বিয়ৗ নাওয়াও গাখৗবায় আরৗ বিনি ছেলাফ্রাবৗ উন উন থাংফাবায়। <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />ঠাবনৗ লৈথৗআও গিলু বালু বারহুখা বারদৗং, আরৗ নাওআ দৈনি ঢেউজৗং গৗডৗহাং গৗডৗহাং জাদৗং নাথায় যীশুআ উন্ডুলাংদৗংমৗন। <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />ছেলাফ্রা থাংবায় আরৗ বিখৌ ফৗজাহৈনানৈ হৗনবায়, “ও ফৗরবু জৗঙৗ গৗডৗলাংনৗছৈ, জৗংখৌ বাছায়দৗ!” <verse eid="MAT 8:25" /><verse number="26" style="v" sid="MAT 8:26" />যীশুআ বুংফিনবায়, “ও ইছে ফৗথায়গ্রাফৗর মানৗ এছেগ্রাব গিদৗং?” অব্লা যীশুআ জিখাংনানৈ বার আরৗ দৈ ঢেউফৗরখৌ ধমক হৗবায় আরৗ বিয়াও গেদেৎ নিজৗম জাবায়।<figure style="fig" alt="Rebuked the winds and the waves, and it was completely calm" file="cn01708.jpg" size="col" loc="paw" copy="© DCC" ref="8:26">বার হুংখাখৌ আরৗ দৈ ঢেউফৗরখৌ ধমক হৗনায় আরৗ নিজৗম জানায়</figure><verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />অব্লা ছেলাফ্রা সাফ্রৗমবৗ সৗমৗ নাংনানৈ সৗংজ্লাইবায়, “বিয়ৗ মা বাদি মানসি? বারহুখা আরৗ দৈ ঢেউফ্রাবৗ বিনি হুখুমখৌ মানিয়ৗ!”<verse eid="MAT 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />জেব্লা যীশুআ লৈথৗ বাদনানৈ গাদারিয়া হাদৎনাও ছহৈয়ৗ, অব্লা ভুত হমজানায় সানৈ মানসিফ্রা গৗথৈ সালিনিফ্রায় অৗংখাৎবৗনানৈ বিখৌ লৗগৗ হমফৈদৗং। বিছৗরৗ এছেগ্রাব বৗলৗগ্রামৗন যে, বি লামাজৗং রাওবৗ থাংনৗহায়ামৗন। <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />“বি সমাও বিছৗরৗ হজ্রিনানৈ হৗনদৗং ও ঈশ্বৗরনি বিসা হৌয়া, নৗংনে জৗংজৗং মা খামানি দং?” “সম ছফৈয়াসাওনৗ নৗঙৗ জৗংখৌ সৈহৗনৗ বেহা ফৈবায় না?”<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />বিছৗরনিফ্রায় ইছে গৗজানাও গেদেৎ ফালৗছে অমা উৎজাদৗংমৗন। <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />অব্লা ভুতফ্রা যীশুনিয়াও খাওলাইদৗং, “নৗঙৗ জৗংখৌ হৗয়নহৎব্লা বৈ গেদেৎ ফালৗছে অমাফৗরনিয়াও হাবহৈনৗ থৗনহৎদৗ।”<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />যীশুআ বিছৗরখৌ হৗনবায়, “থাং!” অব্লা বিছৗরৗ অৗংখাৎনানৈ অমাফৗরনিয়াও হাবহৈবায়, আরৗ ফালৗনি গাছেন অমাফ্রা খাৎলাংনানৈ হাব্রাংনিফ্রায় গাহায়ঠিঙৈ লৈথৗয়াও বাছৗমহৈনানৈ দৈয়াও গব্রনানৈ থৈবায়। <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />অমা গুমগ্রাফ্রা খাৎলাংনানৈ বি হাদৎনি নৗগৗর আরৗ গামিফৗরাও, ভুত হমজানায়ফৗরনিয়াও মা জায়ামৗন বে গাছেনখৌ খৗথাহৈদৗং। <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />বে খৗথাখৌ খৗনানানৈ গাছেন নৗগৗরনি মানসিফ্রা যীশুখৌ লৗগৗ লানৗ অৗংখাৎবৗদৗং, আরৗ বিছৗরৗ যীশুখৌ নুনানৈ গাওছৗরনি জায়গানিফ্রায় গুবুন জায়গায়াও থাংনৗ খাওলাইদৗং।<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">ছ'ছে গৗথৈ মানসিখৌ ছৗখানায়</para>
  <para style="r">(<ref loc="MRK 2:1-12">মার্ক 2:1–12</ref>; <ref loc="LUK 5:17-26">লূক 5:17–26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />বিনি উনাও যীশুআ নাওয়াও গাখৗনানৈ গাওনি নৗগৗরাও ফৈদৗং। <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />খাইছে মানসিফ্রা সাছে ছ'ছে গৗথৈ মানসিখৌ বিছানায়াও ফুঠুনান যীশুনিয়াও লাবৗদৗং। আরৗ যীশুআ বিছৗরনি ফৗথায়নায়খৌ নুনানৈ বে ছ'ছে গৗথৈ মানসিখৌ হৗনবায়, “ও বিসা নৗঙৗ সাহস খৗলাম, নৗংনি পাপফ্রা ক্ষমা হৗজাবায়।”<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />যীশুনি মাওনায়খৌ নুনানৈ খাইছে আইন গুরুফ্রা গৗসৗজৗং গৗসৗ সানবায়, “বে মানসিয়া ঈশ্বৗরখৌ নিন্দিদৗং!”<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />বিছৗরনি সাননায়খৌ মিথিনানৈ যীশুআ হৗনবায়, “নৗংছৗরৗ মানৗ বেবাদি গৗসৗয়াও গাজ্রি সানদৗং? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />ব'বেথৗ বুংনৗ আলঠুয়াসিন, ‘নৗংনি পাপফ্রা ক্ষমা হৗজাবায়,’ এবা বুংনৗ, ‘জিখাং আরৗ থাবায়’? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />নাথায় আং লুবৈয়ৗ জাহাথে নৗংছৗরৗ মিথিনৗ হায়ৗ, বুহুমাও মানসিনি বিসাহৌয়াহা পাপখৌ ক্ষমা হৗনৗ একথিয়ার দং।” বিনিখাইনৗ বিয়ৗ ছ'ছে গৗথৈ মানসিখৌ বুংবায়, “জিখাং, আরৗ নৗঙৗ গাওনি বিছানাখৌ লানানৈ ন্ব'য়াও থাং।”<verse eid="MAT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7" />অব্লা মানসিয়া জিখাংবায় আরৗ ন্ব'য়াও থাংবায়। <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />জেব্লা ভিড়য়া বেখৌ নুদৗং, অব্লা বিছৗরৗ গিবায়, আরৗ মানসিনৗ বেবাদি একথিয়ার হৗবায় হৗন্নানৈ বিছৗরৗ ঈশ্বৗরখৌ বাখ্নাইবায়।<verse eid="MAT 9:8" /></para>
  <para style="s">মথিনি লিংজানায়</para>
  <para style="r">(<ref loc="MRK 2:13-17">মার্ক 2:13–17</ref>; <ref loc="LUK 5:27-32">লূক 5:27–32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />জেব্লা যীশুআ বে জায়গানিফ্রায় থাংদৗং অব্লা মথি নামনি সাছে মানসিখৌ খাজনা নাজাওগ্রানি ন্ব'য়াও জিরাইবায় থানায় নুহৈদৗং। আরৗ যীশুআ বিখৌ হৗনবায়, “নৗং আংনি উন উন ফৈদৗ!” আরৗ মথিয়া জিখাংনানৈ যীশুজৗং থাংফাদৗং। <verse eid="MAT 9:9" /><verse number="10" style="v" sid="MAT 9:10" />আরৗ জেব্লা যীশুআ মৗনাবিলিয়াও মথিনি ন্ব'য়াও জানৗ জিরায়ৗ, অব্লা গৗবাং খাজনা খাংগ্রাফৗর আরৗ পাপীফৗর ফৈনান বিজৗং আরৗ বিনি ছেলাফৗরজৗং লৗগৗছে জানৗ জিরাইফাদৗং। <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />জেব্লা ফরীশীফ্রা বেখৌ নুদৗং, অব্লা বিছৗরৗ ছেলাফৗরনিয়াও সৗংদৗং, “নৗংছৗরনি গুরুয়া মানৗ খাজনা খাংগ্রা আরৗ পাপীফৗরজৗং লৗগৗছে জাফাদেৎনৗ?” <verse eid="MAT 9:11" /><verse number="12" style="v" sid="MAT 9:12" />ফরীশীফৗরনি বে বুংনায়খৌ খৗনানানৈ যীশুআ হৗনবায়, “গৗখ্রৗং মানসিফৗরনৗ ডাক্তারখৌ নাঙা, নাথায় জব্রাফৗরনৗছৗ নাংগৌ। <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />নাথায় নৗংছৗরৗ থাং, আরৗ বেনি অৗংথিয়া মা বেখৌ ছৗলৗংহৈদৗ, আঙৗ দয়াখৌছৗ গৗসৗ জায়ৗ, বলি হৗনায়খৌ অৗঙা, মানৗনা আঙৗ ধার্মিকফৗরখৌ লিংনৗ ফৈয়াখৈ নাথায় পাপীফৗরখৌছৗ।”<verse eid="MAT 9:13" /></para>
  <para style="s">উপবাসনি বিষয়</para>
  <para style="r">(<ref loc="MRK 2:18-22">মার্ক 2:18–22</ref>; <ref loc="LUK 5:33-39">লূক 5:33–39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />বে সমাও যোহননি ছেলাফ্রা যীশুনিয়াও ফৈনানৈ সৗংবায়, “জৗং আরৗ ফরীশীফ্রা গলে গলে উপবাস থায়ৗ, নাথায় নৗংনি ছেলাফ্রা মানৗ উপবাস থায়া, বে মাব্রৈ জাখৗ?” <verse eid="MAT 9:14" /><verse number="15" style="v" sid="MAT 9:15" />যীশুআ বুংফিনবায়, “হৌয়া গৗদানা বিছৗরজৗং লৗগৗয়াও থাছিয়াও বিজৗং থাফানায় লৗগৗফ্রা মানৗ দাহা খৗলামনৗ নাংগৌ?” নাথায় বে সময়া ছফৈনায়, জেব্লা হৌয়া গৗদানা বিছৗরনিফ্রায় লাংজানায়, অব্লা বিছৗরৗ উপবাস খৗলামনায়।<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />“রাওবৗ গৗদান সি'খৌ হাছিনানৈ গৗজাম সি'নি গব্লঙাও থাবনানৈ সুদেৎনা, মানৗনা গৗদান সি'য়া থরমনায় আরৗ গৗজাম সি'য়া বৗখঠৗংজানানৈ জিসিননায়। <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />আরৗ গৗদান দ্রাক্ষা বিদৈখৌ রাওবৗ গৗজাম বিগুরনি জলংগায়াও ছৗয়া, মানৗনা গৗদান দ্রাক্ষা বিদৈখৌ ছৗব্লা গৗজাম বিগুরনি জলংগায়া বেফ্রুনানৈ দ্রাক্ষা বিদৈয়া গলাংনায় আরৗ গৗজাম বিগুরনি জলংগায়াবৗ নষ্ট জানায়। বিনিখাইনৗ গৗদান দ্রাক্ষা বিদৈখৌ গৗদান বিগুরনি জলংগায়াওনৗ ছৗথারনাংনায় আরৗ বেবাদিয়ৈ মৗন্নৈবৗ রক্ষা জায়ৗ।”<verse eid="MAT 9:17" /></para>
  <para style="s">সাছে গৗথৈ আরৗ সাছে জব্রা হিন্জাওসা</para>
  <para style="r">(<ref loc="MRK 5:21-43">মার্ক 5:21–43</ref>; <ref loc="LUK 8:40-56">লূক 8:40–56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />জেব্লা যীশুআ বিছৗরখৌ বেবাদি বুংবাইথাদৗংমৗন, অব্লা সাছে সিবিগ্রা ন্ব'নি দৈদেনগ্রায়া ফৈদৗং আরৗ বিনি সিগাঙাও হান্ঠুখরাইনানৈ বিখৌ বুংদৗং, “আংনি বিসাজৗয়া দাছৗ থৈদৗং, অন্নানৈ নৗঙৗ ফৈদৗ আরৗ বিনি ছায়াও আখাই দৗনদৗ, অব্লানৗ বিয়ৗ ঠাংখাংফিননায়।” <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />যীশুআ জিখাংবায় আরৗ বিজৗং থাংফাবায়, আরৗ বিনি ছেলাফ্রাবৗ লৗগৗছে থাংফাবায়।<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />আরৗ বারো বৗছৗর থৈ গ'গ্রা বেরাম জাজানানৈ সৈনাংনায় সাছে হিন্জাওসায়াবৗ দংমৗন। আরৗ উন ঠিঙৈ ফৈনানৈ বিনি গাননায় সি' রুবৈয়াও দাংফৈদৗং। <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />মানৗনা বিয়ৗ গাওনি গৗসৗয়াও বুংদৗংমৗন, “আঙৗ বিনি সি'খৌবান দৈনৗ মৗনব্লানৗ আংনি বেরামা ছৗখাজানায়।”<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />যীশুআ গিদিংনানৈ বি হিন্জাওখৌ নুনানৈ হৗনবায়, “ও, বিসা হিন্জাও নৗঙৗ দাগি, নৗংনি ফৗথায়নায়ানৗ নৗংখৌ ছৗখাবায়।” আরৗ বি সমাওনৗ হিন্জাওয়া ছৗখাজাদৗং।<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />জেব্লা যীশুআ সিবিগ্রা ন্ব'নি দৈদেনগ্রানি ন্ব'য়াও হাবহৈদৗং অব্লা বিয়ৗ ভিড়নি দাওরাও আরৗ মানসিফৗর সিফুং দামনায় খৌ নুদৗং। <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />বিয়ৗ বুংবায়, “নৗছৗরৗ বাইরাও থাংদৗ, বে হিনজাওসায়া থৈয়াখৈ নাথায় উন্ডুদৗংছৗ।” নাথায় যীশুনি বে বুংনাইয়াও বিছৗরৗ মিনিদৗং। <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />ভিড়খৌ বাইরাও থৗনহৎখাংনান, বিয়ৗ সিঙাও হাবনানৈ বি হিন্জাওসাখৌ আখাইয়াও হমনানৈ বৗখাংদৗং, আরৗ হিন্জাওসায়া জিখাঙাছৈ। <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />যীশুনি বে মাওনায়নি খবরা হাদৎমানিয়াও মুং দাংখা জাবায়।<verse eid="MAT 9:26" /></para>
  <para style="s">সানৈ খানাখৌ গুনু খৗলামনায়</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />যীশুআ বে জায়গানিফ্রায় থাংনায় সমাও সানৈ খানা মানসিয়া বিনি উন উন থাংনানৈ গাবজ্রিনানৈ বেবাদি হৗনদৗং, “ও দায়ূদনি বিসাজ্লা, জৗংনি ছায়াও অনখাংদৗ!” <verse eid="MAT 9:27" /><verse number="28" style="v" sid="MAT 9:28" />জেব্লা যীশুআ ন্ব'সিঙাও হাবহৈয়ৗ, অব্লা খানাফ্রা বিনিয়াও ফৈদৗং, আরৗ যীশুআ বিছৗরখৌ সৗংদৗং, “আঙৗ বে খামানিখৌ খৗলামনৗ হানায় হৗন্নানৈ নৗংছৗরৗ ফৗথায়ৗ নামা?”</para>
  <para style="p" vid="MAT 9:28">খানাফ্রা বুংফিনবায়, “ও ফৗরবু জৗঙৗ ফৗথায়ৗ!”<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />অব্লা যীশুআ বিছৗরনি মগনফৗরাও দাংনানৈ হৗনদৗং, “নৗংছৗর ফৗথায়নায় বাদিনৗ জাথৗং।” <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />আরৗ বিছৗরনি মগনফ্রা গেওদৗং, নাথায় যীশুআ বিছৗরখৌ গৗরায়ৈ হৗনবায় সাবধান, “জেন নৗংছৗরৗ বে জানায়খৌ রাওনৗবৗ দাখৗথা।”<verse eid="MAT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 9:31" />নাথায় মানসিফ্রা বাইরাও থাংনানৈ বিনি বিষয়ৈ বি হাদৎনি গাছেননাওবৗ খবরখৌ খৗথাবাইবায়।<verse eid="MAT 9:31" /></para>
  <para style="s">বোবা'খৌ রাইহৗনায়</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />জেব্লা বিছৗরৗ অৗংখাৎলাঙৗ, অব্লা সাছে ভুত হমজানায় খৗথা রাইজ্লাইনৗ হায়িখৌ যীশুনিয়াও লাবৗদৗং। <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />আরৗ যীশুআ জেব্লা বে মানসিনিফ্রায় ভুতখৌ হৗয়নদৗং অব্লানৗ বিয়ৗ খৗথা রাইনৗ হাদৗং। বেখৌ নুনানৈ মানসিফ্রা সৗমৗ নাংনানৈ হৗনদৗং, “ইস্রায়েলফৗরনি গেজেরাও বেবাদি মাওনায়খৌ জৗঙৗ নুফেৎথারাখৈমৗন।”<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />নাথায় ফরীশীফ্রা হৗনদৗং, “ভুতফৗরনি রাজকুমারনি বৗলৗজৗং বিয়ৗ ভুতফৗরখৌ হৗয়ননৗ।”<verse eid="MAT 9:34" /></para>
  <para style="s">যীশুনি মানসিফৗরখৌ অনখাংনায়</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />যীশুআ গাছেন নৗগৗরফৗর আরৗ গামিফৗরাও গিদিংবায়ৈ গিদিংবায়ৈ সিবিগ্রা ন্ব'ফৗরাও ফৗরৗংদৗং ঈশ্বৗরনি রাইজৗনি থাখৈ মৗজাং খবরখৌ খৗথাবায়দৗং আরৗ বাইদিসিনা রগ'বিয়াৎ আরৗ জব্রাফৗরখৌ ছৗখাদৗং। <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />জেব্লা ভিরখৌ নুয়ৗ অব্লা যীশুআ বিছৌরখৌ অনখাংবায়, মানৗনা বিছৗর লাওখার গৈজায়ি মেন্ডাফৗর বাদি আলায়ছিলায় জাদৗং আরৗ নাছয় জাদৗংমৗন। <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />অব্লা যীশুআ গাওনি ছেলাফৗরখৌ হৗনদৗং, “আবাদনা গৗবাংথার, নাথায় মাওগ্রাফ্রা ইছে বান। <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />বিনিখাইনৗ আবাদনি বৈগৗমানিয়াও খাওলাইদৗ, জাহাথে বিয়ৗ গাওনি আবাদখৌ বুথুমনৗ মাওগ্রাফৗরখৌ থৗনহৎনৗ।”<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">বারোজন ছেলাফৗর</para>
  <para style="r">(<ref loc="MRK 3:13-19">মার্ক 3:13–19</ref>; <ref loc="LUK 6:12-16">লূক 6:12–16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />যীশুআ গাওনি বারোজন ছেলাফৗরখৌ লিংহৎনানৈ বিছৗরনৗ বাদুয়া জিউফৗরখৌ হৗয়ননৗ আরৗ বাইদিসনা রগ'বিয়াৎ আরৗ জব্রাফৗরখৌ ছৗখানৗ একথিয়ার হৗবায়। <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />বি বারোজন প্রেরিতফৗরনি নামফ্রা জাবায়: সিগাঙাও, শিমোন (পিতরবৗ মুংখজায়ৗ), আরৗ বিনি ফংবায় আন্দ্রিয়, সিবদিয়নি বিসাজ্লা যাকোব আরৗ বিনি ফংবায় যোহন; <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />ফিলিপ আরৗ বারথলময়; থোমা আরৗ খাজনা খাংগ্রা মথি, আলফাইনি বিসাজ্লা যাকোব আরৗ থদ্দেয়; <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />কানানী শিমোন, আরৗ যীশুখৌ হমনানৈ হৗনায় যিহুদা ঈষ্করিয়োতীয়।<verse eid="MAT 10:4" /></para>
  <para style="s2">বারোজন ছেলাফৗরনি ঠাংখি</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />বে বারোজন ছেলাফৗরখৌ যীশুআ বেবাদি বুংনানৈ থৗনহৎবায়: “নৗংছৗরৗ গুবুনহারিফৗরনি গেজেরাও দাথাং, এবা শমরীয়ফৗরনি ববেবা নৗগৗরাও দাহাবহৈ। <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />বিছৗরনিয়াও থাঙামাৎনিন নৗংছৗরৗ ইস্রায়েল বংশনি গৗমানায় মেন্ডাফৗরনিয়াও থাংদৗ। <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />থাঙৈ থাঙৈ নৗংছৗরৗ বে খৗথাখৌ খৗথাবায়হৈদৗ; ‘স্বৗর্গৗ রাইজৗয়া খাঠিয়াও ছফৈবায়।’ <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />জব্রাফৗরখৌ ছৗখাদৗ, গৗথৈফৗরখৌ ফৗঠাংদৗ, খুরিয়া রগ জানাইফৗরখৌ ছৗখাদৗ, আরৗ ভূতফৗরখৌ হৗখাৎদৗ। জেরৈ নৗংছৗরৗ অরৈনৗ মৗনবায়, বেবাদিনৗ নৗংছৗরৗ অরৈনৗ হৗফিনদৗ।<verse eid="MAT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 10:9" />নৗংছৗরৗ জান্জিনি সিয়াও সোনা, রুপা এবা তামানি টাকা পায়সা দালাংফা, <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />থাংনায় সমাও জলংগা, এবা গানখানায় গুছ্লাখৌ নাগারনানৈ গুবুন গুস্লা এবা সেনডেলফৗর এবা লাওঠিবৗ লৗগৗয়াও দালা। মানৗনা মাওগ্রায়া গাওনি মাওনাইনি থাখৈ জানায় লৗংনাইখৌ মৗনখানাংগৌ।<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />নৗংছৗরৗ ববেবা নৗগৗরাও এবা গামিয়াও হাবহৈব্লা, সাছে উপযুক্ত মানসিখৌ নাগিৎগ্রৗ আরৗ জেব্লাসিম নৗংছৗর বি নৗগৗরখৌ নাগারনায় অৗঙা অব্লাসিম বিনি ন্ব'য়াওনৗ থা। <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />ছৗরনিবা ন্ব'য়াও হাবহৈব্লা নৗংছৗরৗ বিজৗং গৗজৗননায় লাগ্রৗ <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />আরৗ বি ন্ব'খরা উপযুক্ত ব্লা, নৗংছৗরনি শান্তিয়া বিছৗরনিয়াও থাথৗং, নাথায় উপযুক্ত অৗঙাব্লা নৗংছৗরনি শান্তিয়া নৗংছৗরনিয়াওনৗ ফৈফিনথৗং। <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />আরৗ ছৗরবায়া নৗংছৗরখৌ নাজাওয়াব্লা এবা নৗংছৗরনি খৗথাফৗরখৌ খৗনাছঙাব্লা, বি ন্ব' এবা নৗগৗরনিফ্রায় অৗংখাৎলাংনায় সমাও নৗংছৗরনি গাও গাওনি আঠেংনি আফাখি হাদুরৈখৌ ফিস্রিলাং।<note caller="+" style="f"><char style="fr" closed="false">10:14 </char><char style="ft" closed="false">আঠেংনি আফাখি হাদুরৈখৌ ফিস্রিনাইয়া জাবায় মৗনছে চিহ্ন, বিছৗরৗ ঈশ্বৗরনি বাথ্রাখৌ এৎগাররৗ, দা, বে আঠেংনি আফাখি হাদুরৈখৌ ফিস্রিলাংগ্রাফৗরনে বিছৗরনি থাখৈ আরবাও জেবৗ দায় গৈলিয়া</char></note> <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />নংথারগৌয়ৈ আঙৗ নৗংছৗরখৌ বুঙৗ, বিচারনি দিনাও বে নৗগৗরনি অবস্থানিফ্রায় সদোম আরৗ ঘমোরা <note caller="+" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="GEN 19:1-27">জাগাইজেন্নায় 19:1–27</ref></char></note>হাদৎনি অবস্থা রাসিন সহায় জাথাওথাও জানায়।”<verse eid="MAT 10:15" /></para>
  <para style="s2">নিদানফৗর ছফৈনায়</para>
  <para style="r">(<ref loc="MRK 13:9-13">মার্ক 13:9–13</ref>; <ref loc="LUK 21:12-17">লূক 21:12–17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />“খৗনাছং, লখ্রাফৗরনি গেজেরাও মেন্ডাফৗর বাদি আঙৗ নৗংছৗরখৌ থৗনহৎছৈ। বিনিখাইনৗ, নৗংছৗরৗ জিবৌফৗর বাদি চালাক আরৗ ফারৗও বাদি নম্র জা। <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" />নাথায় মানসিফৗরনিফ্রায় সাবধান জা, মানৗনা বিছৗরৗ নৗংছৗরখৌ হমনানৈ বিজিৎসালিয়াও গথাইনায়, আরৗ গাওছৗরনি সিবিগ্রা ন্ব'ফৗরাও নৗংছৗরখৌ চাবুকজৗং বুনায়। <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />আংনি থাখৈ নৗংছৗরৗ হমজানানৈ শাসনগিরি আরৗ রাজাফৗরনি সিগাঙাও বিচার খৗলামনৗ লাংজানায়, বিছৗরনৗ আরৗ গুবুনহারিফৗরনৗ নৗংছৗরৗ আংনি মৗজাং সাক্ষ্যখৌ খৗথানৗ হানায়। <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />জেব্লা বিছৗরৗ নৗংছৗরখৌ হমনানৈ বিচার খৗলামনৗ লাংনায়, অব্লা নৗংছৗরৗ বিচাররাও মা বুংনায় এবা মাব্রৈ বুংনায় হৗন্নানৈ চিন্তা দাখৗলাম, মানৗনা নৗংছৗরনে মা বুংনাগৌ বিখৌ বি সমাওনৗ নৗংছৗরনৗ হৗয়া জানায়। <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />মানৗনা বুংনাইয়া নৗংছৗর অৗঙা, নাথায় নৗংছৗরনি বিফানি গৗথার জিউয়াছৗ নৗংছৗরনিয়াও থানানৈ বুংনায়।<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />বি সমাও মানসিফ্রা গাওছৗরনি ফংবায়া ফংবায়খৌ গথায়নান হৗনায় আরৗ বিফাফ্রা গাওছৗরনি বিসাফৗরখৌ গথায়নান হৗনানৈ সিথাৎ হৗনায়। বেবাদিনৗ বিসাফ্রা বিমা-বিফানি বিরুদ্ধ জিখাংনানৈ বিছৗরখৌ সিথাৎনায়। <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />আংনি মুংনি জুনৈ নৗংছৗরৗ বয়জৗংবৗ মুগৈজানায়। নাথায় জাইফ্রা জৗবনায়সিম গৗম গৗময়ৈ থানায়, বিছৗরৗ বাছাইজানায়। <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />জেব্লা নৗংছৗরৗ ডাবছে জায়গাও নাছয়জায়ৗ, অব্লা গুবুন নৗগৗরাও খাৎলাং, নংথারগৌয়ৈ আঙৗ নৗংছৗরখৌ বুঙৗ, ইস্রায়েলনি গাছেন নৗগৗরফৗরাও মাওখাংজৗবমা সায়াওনৗ মানসিনি বিসাহৌয়া ফৈনায়।<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />গুরুনিখুরৈ ছৗলৗংগ্রায়া দেৎসিন অৗঙা, আরৗ গিরিনিখুরৈ দাসয়া দেৎসিন অৗঙা। <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />বিনিখাইনৗ ছৗলৗংগ্রায়া গাওছৗরনি গুরুফৗর বাদি আরৗ দাসফ্রা গাওছৗরনি গিরিফৗর বাদি জাব্লাবৗ বিনি থাখৈ বিনৗ ঠৗবায়। ন্ব'নি গাহায়ানৗ বেলসিবুল<note caller="+" style="f"><char style="fr" closed="false">10:25 </char><char style="ft" closed="false">বেলসিবুলআ জাবায় শয়তাননি মৗনছে মুং।</char></note> হৗন্নানৈ বুংজায়ৗব্লা, বিনি ন্ব'খরনি মানসিফ্রা বেছে গাজ্রিসিন বুংজানায়।”<verse eid="MAT 10:25" /></para>
  <para style="s2">ছৗরখৌ গিনাংগৌ</para>
  <para style="r">(<ref loc="LUK 12:2-7">লূক 12:2–7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />“নৗংছৗরৗ মানসিফৗরখৌ গিনৗ নাঙা, মানৗনা নুজাহৗজায়া জেবৗ দৗনখৗমাজানায় অৗঙা, আরৗ মানসিফৗরনৗ মিথিহৗজায়ি মৗংবৗ থাখমানায় অৗঙা। <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />আং জেখৌ নৗংছৗরনৗ খৗমসিয়াও রাইঠিয়ৗ, বেখৌ নৗংছৗরৗ স্রাংয়াও বুং, আরৗ জেখৌ আঙৗ নৗংছৗরনৗ খৗথাখৗমাদৗং, বেখৌ নৗংছৗরৗ ন্ব'মুদাফৗরনি ছায়াওনিফ্রায় ফৗস্রাওদৗ। <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />জাইয়া মৗদৗমখৌবান' সংহার খৗলামনৗ হায়ৗ, নাথায় জিউখৌ হায়া, বেখৌ নৗংছৗরৗ গিনৗ নাঙা, নাথায় জাইয়া মৗদৗম আরৗ জিউ। বে মৗন্নৈখৌবৗ নরকয়াও সংহার খৗলামনৗ হায়ৗ বিখৌনৗ নৗংছৗরৗ গি। <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />মা কি মানৈ গরছখাখৌ নৗংছৗরৗ ইছে বান দামাও ফানজায়া খৗমা? অব্লাবৗ বিছৗরনি মাছেয়াবৗ বিফানি গৗসৗ ছাড়া হ্বায়াও গৗগ্লৈয়া। <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />আরৗ এমন কি নৗংছৗরনি খর'নি খানায় দৗংফ্রমবৗ সানখাজানায় দং। <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />বিনিখাইনৗ নৗংছৗরৗ দাগি; নৗংছৗরৗ গৗবাং গরছৗখাফৗরনিফ্রায়বৗ দাম গৗছাসিন।”<verse eid="MAT 10:31" /></para>
  <para style="s">খ্রীষ্টখৌ স্বীকার আরৗ অস্বীকার খৗলামনায়</para>
  <para style="r">(<ref loc="LUK 12:8-9">লূক 12:8–9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />“জাইয়া আংখৌ গুবুনফৗরনি সিগাঙাও মানিনান লায়ৗ, আংবৗ বিখৌ স্বৗর্গৗয়াও থানায় আংনি আফানি সিগাঙাও মানিনান লানায়। <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />নাথায় জাইয়া আংখৌ মানসিফৗরনি সিগাঙাও অস্বীকার খৗলামৗ, বিখৌ আংবৗ আংনি স্বৗর্গৗনি আফানি সিগাঙাও বিখৌ অস্বীকার খৗলামনায়।”<verse eid="MAT 10:33" /></para>
  <para style="s2">গৗজৗননায় হৗনৗ অৗঙা নাথায় গাওস্রাহৗজ্লাইনৗছৗ</para>
  <para style="r">(<ref loc="LUK 12:51-53">লূক 12:51–53</ref>; <ref loc="LUK 14:26-27">14:26–27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />“আঙৗ বুহুমাও শান্তি হৗনৗ ফৈদৗং হৗন্নানৈ নৗংছৗরৗ দাসান, আঙৗ শান্তি হৗনৗ ফৈয়াখৈ, নাথায় থুংগ্রী হৗনৗছৗ ফৈদৗং। <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />মানৗনা আঙৗ ফৈবায় বিসাজ্লাখৌ বিফাফৗরনি বিরুদ্ধনাও, আরৗ বিসাজৗফ্রা বিমাফৗরনি বিরুদ্ধনাও, আরৗ বিহামজৗফ্রা বিখুনজৗফৗরনি বিরুদ্ধনাও জিখাংনায়। <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />সাছে মানসিনি বিসারুফ্রা গাওনি ন্ব'খরনিফ্রায়নৗ জিখাংনায়।<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />জাইয়া গাওনি বিমাখৌ এবা বিফাখৌ আংনি খুরৈ বাংসিন অন্নৗ বিয়ৗ আংনি ছেলা জানৗ যোগ্য অৗঙা। আরৗ জাইয়া গাওনি বিসাজ্লাখৌ এবা বিসাজৗখৌ আংনি খুরৈ বাংসিন অন্নৗ, বিয়ৗ আংনি ছেলা জানৗ যোগ্য অৗঙা। <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />নাথায় জাইয়া গাওনি ক্রুশখৌ বান্নানৈ আংনি উন উন ফৈয়া বিয়ৗ আংনি ছেলা জানৗ যোগ্য অৗঙা। <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />জাইয়া গাওনি জিউখৌ বাছায়নৗ হাস্থায়ৗ বিয়ৗ বিখৌ খৗমানায়, নাথায় জাইয়া আংনি থাখৈ গাওনি জিউখৌ খৗমানায়, বিয়ৗ বিখৌ মৗননায়।<verse eid="MAT 10:39" /></para>
  <para style="s">বানথাখৌ মৗননায়</para>
  <para style="r">(<ref loc="MRK 9:41">মার্ক 9:41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />“জাইয়া নৗংছৗরখৌ নাজাওয়ৗ, বিয়ৗ আংখৌনৗ নাজাওয়ৗ, আরৗ জাইয়া আংখৌ নাজাওয়ৗ, বিয়ৗ আংখৌ থৗনহৎগ্রাখৌনৗ নাজাওয়ৗ। <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />জাইয়া নবি হৗন্নানৈ নবিখৌ নাজাওয়ৗ বিয়ৗ বি নবিনি বানথাখৌ মৗনৗ আরৗ জাইয়া ধার্মিকনি নামখৌ ধার্মিক হৗন্নানৈ নাজাওয়ৗ, বিয়ৗ বি ধার্মিক মানসিনি বানথাখৌ মৗনৗ। <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />আরৗ ছৗরবায়া বে ইংকিবাকি ফৗরনিফ্রায় ছৗরখৌবা আংনি ছেলা হৗন্নানৈ, খুরৈছে গুসু দৈ হৗয়ৗ, নংথারগৌয়ৈ আঙৗ নৗংছৗরখৌ বুঙৗ, বিয়ৗ মৗননাংগৌ বানথাখৌ মাব্লাবাবৗ খৗমানায় অৗঙা।”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">যীশু আরৗ যোহন বাপ্তিস্ট</para>
  <para style="r">(<ref loc="LUK 7:18-35">লূক 7:18–35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />যীশুআ গাওনি বারোজন ছেলাফৗরখৌ ফৗরৗংখাংনায়নি উনাও বিয়ৗ খাঠি খালা নৗগৗরফৗরনি মানসিফৗরখৌ ফৗরৗংনৗ আরৗ বিছৗরনিয়াও খৗথাবায়নৗ বে জায়গানিফ্রায় অৗংখাৎলাংদৗং। <verse eid="MAT 11:1" /><verse number="2-3" style="v" sid="MAT 11:2-3" />যোহননা জৗবথেসালিয়াও মসিহনি মাওনায়ফৗরখৌ খৗনানানৈ গাওনি ছেলাফৗরখৌ থৗনহৎনানৈ বিখৌ বুংহৎদৗং। “জাইয়া ফৈনাংগৌ বিয়ৗ নৗংনৗ নামা? না, জৗং ছৗরখৌবা লামা নাইবাওনৗ?” <verse eid="MAT 11:2-3" /><verse number="4" style="v" sid="MAT 11:4" />যীশুআ বুংফিনবায়, “থাংফিনদৗ আরৗ নৗংছৗর জেখৌ নুবায় আরৗ খৗনাবায়, বেখৌনৗ যোহননৗ খৗথাহৈদৗ; <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />খানাফ্রা গুনু জাদৗং, লেংগ্রাফ্রা থাবাইফিনদৗং, খুরিয়া রগ জাজানায়ফ্রা গাদৗং, বেংগাফ্রা খৗনাফিনদৗং, গৗথৈফ্রা ফৗঠাংফিনজাদৗং, আরৗ হাওরিয়াফৗরনৗ মৗজাং খবরখৌ খৗথানায় জাদৗং। <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />ধন্য বি মানসিয়া, আংনি সম্বন্ধৈ জাইনি গৗসৗয়াও জেবৗ গৗনৗ গৗথৗ গৈয়া।”<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />জেরৈ বাদি যোহননি ছেলাফ্রা নাগারনান থাংদৗংছৈমৗন, যীশুআ ভিড়ফৗরনৗ যোহননি খৗথা বুংনৗ হমদৗং: “নৗংছৗরৗ মারু গৗরান ফৗথারবারিয়াও যোহনেও মাখৌ নাইনৗ থাদৗংমৗন? বারজৗং ছৗমাওজানায় নৗলৗখৌ? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />বেফৗরখৌ অৗঙাব্লা, নৗংছৗরৗ মাখৌথৗ নাইনৗ অৗংখাৎলাঙা মৗন? না, সাছে জৗংব্লাও মাব্লাও মিস মিস সি' গান্নায় মানসিখৌ? নাই, জাইফ্রা বেবাদি দাম গৗছা সি' গান্নৗ, বিছৗরৗ রাজমহলফৗরাওছৗ থায়ৗ। <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />অব্লা নৗংছৗরৗ মাখৌ নাইনৗ থাঙামৗন? সাছে নবিখৌ নাইনৗ থাখৈ? আং নৗংছৗরৗখৌ রাইঠিয়ৗ, বিয়ৗ নবিনিফ্রায়বৗ দেৎসিন। <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />মানৗনা বি মানসিয়া যোহননানৗ, জায়নি খৗথা শাস্ত্রআও বেবাদি লিৎনায় দং:</para>
  <para style="q1" vid="MAT 11:10">‘আঙৗ নৗংনি সিগাং আংনি খবরিয়াখৌ থৗনহৎনায়,</para>
  <para style="q2" vid="MAT 11:10">জাইয়া নৗংনি সিগাংনৗ লামাখৌ ঠাম ঠিম<note caller="+" style="x"><char style="xo" closed="false">11:10 </char><char style="xt" closed="false"><ref loc="MAL 3:1">মালাখি 3:1</ref></char></note> খৗলামনায়।’<verse eid="MAT 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11" />নংথারগৌয়ৈ আঙৗ নৗংছৗরখৌ বুঙৗ, হিন্জাওসাফৗরনি গৗর্বৗনিফ্রায় সারিজানায় মানসিমানিনি গেজেরাও যোহন বাপ্তিস্টনি খুরৈ রাওবৗ দেৎসিন জিখাংয়াখৈ। নাথায় স্বৗর্গৗ রাইজৗয়াও জাইয়া লৈসিন, বিয়ৗ বিনিফ্রায়বৗ দেৎসিন। <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />যোহন বাপ্তিস্টনি সমনিফ্রায় দাসিম, স্বৗর্গৗনি রাইজৗয়া ব্রা ব্রায়ৈ নাছয়জানানৈ দং, আরৗ নাছয়গ্রাফ্রা বেখৌ বৗলৗজৗং সেনৗ হাস্থায়দৗং। <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />মানৗনা যোহননি আমৗলসিম গাছেন নবিফৗর আরৗ মোশিনি আইননা বে রাইজৗনি খৗথাখৌ ভাববাণী বুংবৗদৗং। <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />আরৗ নৗংছৗরৗ নাজাওনৗ গৗসৗ জায়ৗব্লা, অব্লা মিথিনায়, যে এলিয়নেনৗ ফৈনাংগৌ দংমৗন, বিয়ৗ বে মানসিয়ানৗ। <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />খৗনাছংনৗ জাইফৗরহা খৗমা দং, বিছৗরৗ খৗনাছংথৗং।<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />অব্লা, আং বে ফিরিনি মানসিফৗরখৌ ছৗরজৗং তুলনা খৗলামবাওনৗ? বিছৗরৗ গথ'ফৗর বাদি জাইফ্রা হাঠাইসালিয়াও জিরাইনানৈ গাওজৗং গাও লিংহৎজৗলায়নানৈ বুঙৗ:<verse eid="MAT 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />‘জৗঙৗ নৗংছৗরনি থাখৈ সিফুং দামবায়,</para>
  <para style="q2" vid="MAT 11:17">নাথায় নৗংছৗরৗ মৗসায়াখৗছৈ,</para>
  <para style="q1" vid="MAT 11:17">জৗঙৗ দুঃখনি মেথায় খৗনবায়,</para>
  <para style="q2" vid="MAT 11:17">নাথায় নৗংছৗরৗ গাবমাখৗছৈ।’<verse eid="MAT 11:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18" />যোহন বাপ্তিস্টআ ফৈনানৈ জায়াখৈ আরৗ লৗঙাখৈ, আরৗ বিছৗরৗ হৗন্দৗং, ‘বিনেও ভুত দং।’ <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />মানসিনি বিসাহৌয়াআ ফৈনানৈ জাদৗং আরৗ লৗংদৗং, আরৗ নৗংছৗরৗ হৗন্নৗ, বে মানসিখৌ নায়, ‘বিয়ৗ জাসুলা আরৗ লৗংসুলা, বিয়ৗ খাজনা খাংগ্রা আরৗ পাপীফৗরনি লৗগৗ।’ নাথায় গিয়ান্না যে ঠিক বিখৌ বিনি মাওনাইয়ানৗ ফৗরমান হৗয়ৗ।”<verse eid="MAT 11:19" /></para>
  <para style="s">ধীকার গৗসৗ সৗলাইয়ি নৗগৗরফৗর</para>
  <para style="r">(<ref loc="LUK 10:13-15">লূক 10:13–15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />অব্লাহায় যীশুআ যে যে নৗগৗরফৗরাও বাংসিন সৗমৗ গৗনাং খামানিফৗর মাওয়ামৗন, বিয়ৗ বি গাছেন নৗগৗরখৌ নাগারনৗ হমবায়, মানৗনা বি নৗগৗরনি মানসিফ্রা গৗসৗ সৗলাইয়াখৈমৗন। <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />“ও কোরাসীন নৗগৗর, ধিক্কার নৗংখৌহায়! ও বৈৎসৈদা, ধিক্কার নৗংনেবৗ! নৗংছৗরনি গেজেরাও মাওনায় সৗমৗ গৗনাং খামানিফৗরখৌ সোর আরৗ সীদোনাও<note caller="+" style="f"><char style="fr" closed="false">11:21 </char><char style="ft" closed="false">কো'রাসীন আরৗ বৈৎসৈদা নৗগৗরফৗরাও যীশুআ গৗবাংথার সৗমৗ গৗনাং খামানিফৗরখৌ মাওদৗং মৗন। সোর আরৗ সীদোনা গুবুনহারিফৗরনি নৗগৗর মৗন জেরৗও যীশুআ বাডা গৗবাং সৗমৗ গৗনাং খামানিফৗরখৌ মাওয়াখৈমৗন।</char></note> মাওয়ৗমৗনব্লা, বি নৗগৗরফৗরনি মানসিফ্রা গৗবাও দিননি সিগাংনৗ বস্তা গান্নানৈ আরৗ হাথৎফ্লায়াও জিরাইনানৈ গৗসৗ ফিনফিনগৌমৗন। <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />নাথায় বিচারনি দিননাও নৗংছৗরনি অবস্থানিফ্রায় বরং সোর আরৗ সীদোননি<note caller="+" style="f"><char style="fr" closed="false">11:22 </char><char style="ft" closed="false">সোর আরৗ সীদোন বে জায়গাফৗরাও অজুদাইয়ারিফৗর থায়ৗমৗন। </char></note> অবস্থায়া রাসিন সহায় জাথাওথাও জানায়। <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />আরৗ ও কফরনাহুম, মা কি নৗঙৗ স্বৗর্গৗসিম ফৗজৌ জানায়? নৗঙৗ গাহাইজৗং গৗথৈ থাগ্রা জায়গায়াওছৗ থাংনায়! মানৗনা নৗংছৗরনি নৗগৗরাও মাওনায় সৗমৗ গৗনাং হাবাফৗরখৌ সদোমাও মাওনায়মৗনব্লা, বি নৗগৗরা দিনৈসিমবৗ থাগৌমৗন। <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />নাথায় বিচারনি দিননাও নৗংছৗরনি অবস্থানিফ্রায় বরং সোর আরৗ সদোমনি হাদৎনি অবস্থায়া রাসিন সহায় জাথাওথাও জানায়।”<verse eid="MAT 11:24" /></para>
  <para style="s">বিফাআ বিসা হৌয়া নৗ মিথিহৗনায়</para>
  <para style="r">(<ref loc="LUK 10:21-22">লূক 10:21–22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />বি সমাও যীশুআ বাখ্নাইনানৈ হৗন্দৗং, “ও আফা, স্বৗর্গৗ আরৗ বুহুমনি ফৗরবু! আং নৗংখৌ বাখ্নায়ৗ, মানৗনা নৗং জেখৌ জ্ঞানী আরৗ বুদ্দিমান ফৗরনিফ্রায় দৗনখৗমাদৗং, বেখৌনৗ গথ'ফৗর বাদি ফৗথায়গ্রাফৗরনৗ নুজাহৗবায়। <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />নৗংগৌ আফা, বেখৌ বেবাদিয়ৈ মাওনাইয়া নৗংনি নৗজৗররাও মৗজাং জাবায়।<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />গাছৈখৌবৗ আংনি আফায়া আংনৗ গথাইবায়। বিসাজ্লায়া ছৗর বেখৌ বিফাখৌ নাগারনান রাওবৗ মিথিয়া, আরৗ বিফায়া ছৗর বেখৌবৗ বিসাজ্লাখৌ নাগারনান রাওবৗ মিথিয়া, আরৗ জাই মানসিফৗরখৌ বিসাজ্লায়া সাইখয়ৗ বিছৗরনৗ বিফাখৌ নুজাহৗয়ৗ।<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />আংনিয়াও ফৈ, নৗংছৗর গাছেন মাবখ্রুবগ্রাফৗর আরৗ বিবান গিলিৎ বাননাংনানৈ মেংগ্লিনায়ফৗর, আরৗ নৗংছৗরখৌ আং জিরাই হৗনায়। <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />আংনি জুয়াখৌ গাওছৗরনি ছায়াও বান্নানৈ লাদৗ, আরৗ আংনিফ্রায় ছৗলৗংদৗ। মানৗনা আঙৗ গুরৈ আরৗ গৗসৗয়াওবৗ নম্র; আরৗ নৗংছৗরৗ নৗংছৗরনি জিউয়াও জিরাইনায় মৗননায়। <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />মানৗনা আংনি জুয়া বান্নৗ আল্টুয়া, আরৗ আংনি বিবানা রেজেং।”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">সাব্বাথনি বিষয় সৗংনায়</para>
  <para style="r">(<ref loc="MRK 2:23-28">মার্ক 2:23–28</ref>; <ref loc="LUK 6:1-5">লূক 6:1–5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />সানছেখালি সাব্বাথনি দিননাও যীশুআ আবাদবারি গেজেরজৗং থাবায়লাংদৗংমৗন। বি সমাও বিনি ছেলাফ্রা উখৈদৗং মৗন আরৗ আবাদনি বিডাংখৌ খেবছনানৈ বিডাংখৌ জানৗ হমদৗং। <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />জেব্লা ফরীশীফ্রা বেখৌ নুদৗং, অব্লা বিছৗরৗ যীশুখৌ হৗন্দৗং, “নাইদৗ, নৗংনি ছেলাফ্রা সাব্বাথনি দিননাও মা মাওদৗং, সাব্বাথনি দিননাও বিছৗরনি বে মাওনাইয়া আইনি বিরুদ্ধ জাবায়।”<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />যীশুআ বুংফিনবায়, “নৗংছৗরৗ সাস্ত্রখৌ মাব্লাবাবৗ ফৗরাইয়াখৈ নামা? জেব্লা দায়ূদ আরৗ বিজৗং লৗগৗয়াও থাফানায়ফ্রা উখৈনানৈ জানৗ গৗনাংথারাও গৗগ্লাইদৗং মৗন, বি সমাও দায়ূদআ মা মাওয়া? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />দায়ুদনা ঈশ্বৗরনি ন্ব'য়াও হাবদৗং, আরৗ বিয়ৗ বিনি থানায়ফৗরনৗবৗ ঈশ্বৗরনৗ বাওনায় সিঠাওখৌ বিছৗরনি থাখৈ আইননাও মৗনজায়িখৌ জাদৗং, নাথায় যাজকফৗর বান বেখৌ মৗনজায়ৗমৗন। <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />এবা নৗংছৗরৗ মোশিনি আইনাও লিৎনায়খৌ ফরায়াখৈনা? সাব্বাথনি দিনাও মন্দিরাও গাও গাওনি বিবানখৌ মাওগ্রা যাজকফ্রা সাব্বাথনি আইনখৌ বাদনানৈবৗ বিছৗরৗ নির্দোষ। <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />আঙৗ নৗংছৗরখৌ যে বেহা মন্দিরনিখুরৈবৗ দেৎসিন মাবাফৗর দং। <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />‘আঙৗ দয়াখৌছৗ গৗসৗ জায়ৗ, নাথায় বলিখৌ অৗঙা,’<note caller="+" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="HOS 6:6">হোশেয়া 6:6</ref> </char></note> নৗংছৗরৗ বে খৗথানি মানেখৌ মিথিয়ৗমৗনব্লা, নৗংছৗরৗ নির্দোষ মানসিখৌ দোষি খৗলামনায় অৗঙা মৗন। <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />মানৗনা মানসিনি বিসাহৌয়াআ সাব্বাথনিবৗ বৈগৗমা।”<verse eid="MAT 12:8" /></para>
  <para style="s">আখাই রানলাংনায় মানসিনি বাথ্রা</para>
  <para style="r">(<ref loc="MRK 3:1-6">মার্ক 3:1–6</ref>; <ref loc="LUK 6:6-11">লূক 6:6–11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />যীশুআ বি জায়গানিফ্রায় থাংনানৈ বিছৗরনি সিবিগ্রা ন্ব'য়াও হাবদৗং, <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />আরৗ আখাই রানজানায় সাছে মানসি বিহা দংমৗন। বিছৗরৗ যীশুখৌ সৗংবায়, “মা কি সাব্বাথনি দিননাও জব্রাফৗরখৌ ছৗখানাইয়া আইন বাদি?” বিছৗরৗ যীশুখৌ দোষি খৗলামনৗ বেবাদি সৗংবায়।<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />বিয়ৗ বিছৗরখৌ বুংবায়, “নৗংছৗরনি ছৗরনিবা মেন্ডা মাছে দংব্লা আরৗ সাব্বাথনি দিননাও বি মেন্ডায়া হাখরাও গৗগ্লাইব্লা, বিখৌ বৗখাঙা জাছে নৗংছৗরৗ থানায় নামা? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />সাননানৈ নায়, মেন্ডানি খুরৈ সাছে মানসিয়া বেছে দাম গৗছাসিন! বিনিখাইনৗ সাব্বাথনি দিননাও মৗজাং মাওনাইয়া আইন বাদি উচিৎ।” <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />অব্লা যীশুআ বি মানসিখৌ হৗনবায়, “নৗংনি আখাইখৌ ফৗলাওহৎ।” আরৗ বিয়ৗ আখাইখৌ ফৗলাওহৎবায়, আরৗ বিনি আখাইয়া ঠাল্লায়ৈ খৗরৗংফিনবায় গুবুন মৗজাং আখাই বাদি। <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />নাথায় ফরীশীফ্রা সিবিগ্রা ন্ব'নিফ্রায় অৗংখাৎলাংনানৈ আরৗ যীশুখৌ মাব্রৈ বিছৗরৗ সিথাৎনৗ হানায় বেনি খাইদা খৗলামবায়।<verse eid="MAT 12:14" /></para>
  <para style="s">ঈশ্বৗরনি সাইখনায় মৗজাং দাস</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />ফরীশীফৗর মাওনৗ সানজ্লায়নায়খৌ মিথিনানৈ যীশুআ বে জায়গানিফ্রায় গুবুনাও থাঙাছৈ। আরৗ গেদেৎ হান্জায়া বিনি উন উন থাংফাদৗংমৗন আরৗ যীশুআ গাছেন জব্রাজানান থানায় মানসিফৗরখৌ ছৗখাদৗং। <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />আরৗ বিয়ৗ গাওনি বিষয়ৈ গুবুনফৗরখৌ খৗথায়ি বাদি বিছৗরখৌ সাবধান খৗলামদৗং।<verse eid="MAT 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 12:17" />যিশাইয়া নবিজৗং ভবিষৎবানি বুংনাইয়া জাফুংনাংগৌ দংমৗন:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />“নাইদৗ, বেহা আংনি দাসআ জাইখৌ আং সাইখবায়,</para>
  <para style="q2" vid="MAT 12:18">জাই সাছেখৌ আং অন্নৗ,</para>
  <para style="q1" vid="MAT 12:18">জাইজৗং গৗসৗয়াও আং গৗজৗননৗ,</para>
  <para style="q2" vid="MAT 12:18">আং আংনি গৗথার জিউখৌ বিনি ছায়াও দৗন্নায়,</para>
  <para style="q1" vid="MAT 12:18">আরৗ বিয়ৗ গুবুনহারিফৗরনৗ নিয়াই ফৗস্রাওনায়।<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />বিয়ৗ নাংজ্লাইনায় অৗঙা এবা গৗরায়ৈ খৗথা বুংনায় অৗঙা,</para>
  <para style="q2" vid="MAT 12:19">লামায়াও রাওবৗ বিনি রাওখৌ খৗনানায় অৗঙা।<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />বিয়ৗ নৗলৗ গেগ্রেবখৌ ছিফাইনায় অৗঙা,</para>
  <para style="q2" vid="MAT 12:20">আরৗ আখুন্দৈ খুনায় সৌলথাখৌবৗ খৗমৗৎনায় অৗঙা,</para>
  <para style="q1" vid="MAT 12:20">বিয়ৗ নিয়াইখৌ ডেহানায় সিম লাবৗনায়।<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />বিনি নামাওনৗ গুবুনহারিফ্রা আশা খৗলামনায়।”<verse eid="MAT 12:21" /></para>
  <para style="s">যীশু আরৗ বেলসেবুল</para>
  <para style="r">(<ref loc="MRK 3:20-30">মার্ক 3:20–30</ref>; <ref loc="LUK 11:14-23">লূক 11:14–23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />অব্লা বিছৗরৗ বিনিয়াও সাছে ভুত হমজানানৈ ববা জানায় আরৗ খানা জানায় মানসিখৌ যীশুনিয়াও লাবৗদৗং আরৗ যীশুআ বিখৌ ছৗখাদৗং, বিয়ৗ নুদৗং আরৗ রাইনৗ হাদৗং। <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />বি মাওনায়খৌ নুনানৈ বয়বৗ সৗমৗ নাংদৗং আরৗ বুংদৗং, “বিয়ৗ দায়ূদনি বিসাজ্লা না?”<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />নাথায় জেব্লা ফরীশীফ্রা বে বুংনায়খৌ খৗনায়ৗ, বিছৗরৗ বুংদৗং, “যীশুআ বি ভুতফৗরনি রাজকুমার বেলসিবুলজৗংনৗ<note caller="+" style="f"><char style="fr" closed="false">12:24 </char><char style="ft" closed="false">বেলসিবুলআ শয়তাননি গুবুন মৗনছে মুং। যীশুআ বে বেলসিবুলনি বৗলৗজৗংছৗ ভুতফৗরখৌ হৗয়নদৗং হৗন্নানৈ, খাইছে মানসিফ্রা গাওজৗং গাও হৗনজৗলায়দৗংমৗন </char></note> ভুতফৗরখৌ হোয়ন্নৗ।”<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />নাথায় যীশুআ বিছৗরনি সান্নায়ফৗরখৌ মিথিনানৈ বিছৗরখৌ হৗন্দৗং, “গাওজৗং গাও বিরুদ্ধনাও রানখাওনায় গংফ্রৗমবৗ রাইজৗয়া ধংস জানায়; আরৗ গাওজৗং গাও বিরুদ্ধনাও রানখাওনায় নৗগৗর এবা নখ'রা গছংফৗথানায় অৗঙা। <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />আরৗ শয়তানা গুবুন সাছে শয়তানখৌ হৗখাৎনৗব্লা, বিয়ৗ গাওনি বিরুদ্ধনাও গাও গাওফ্রুহৗনায়। অব্লা মাব্রৈ বিনি রাইজৗয়া গছংফৗথানায়? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />আরৗ আং বেলসিবুলনি হেফাজাবজৗং ভুতফৗরখৌ হৗখাৎনৗব্লা, নৗংছৗরনি ছেলাফ্রা ছৗরনি হেফাজাবজৗং ভুতফৗরখৌ হৗখাৎনৗ? বিনিখাইনৗ বিছৗরনি নৗংছৗরনি বিচার খৗলামগ্রা জানায়। <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />নাথায় আঙৗ যে ঈশ্বৗরনি গৗথার জিউজৗং ভুতফৗরখৌ হৗখাৎনৗব্লা, অব্লা ঈশ্বৗরনি রাইজৗয়া নৗংছৗরনিয়াও ফৈখাবায়।<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />এবা, মাব্রৈহায় ছৗরবা সাছেয়া বৗলৗগ্রা মানসিনি ন্ব'য়াও হাবনানৈ বিনি দংনায়মানিখৌ সেনৗ হানায় জেব্লাসিম বিয়ৗ সিগাঙাও বৗলৗগ্রা মানসিখৌ খাখ্রবগ্রৗনান দৗন্না? অব্লাছৗ বিনি ন্ব'য়াও দংনায়মানিখৌ লুঠিনৗ হানায়।<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />জাইয়া আংজৗং গৈয়া, বিছৗরৗ আংনি বিরুদ্ধনাও; আরৗ জাইয়া আংজৗং বুথুমফায়া, বিয়ৗ গারস্রাওগ্রা। <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />বিনিখাইনৗ আং নৗংছৗরখৌ রাইঠিয়ৗ, মৗনফ্রৗমবৗ গাছেন পাপ আরৗ নিন্দিনায়খৌ ক্ষমা হৗনায়, নাথায় জাইয়া গৗথার জিউখৌ নিন্দিয়ৗ, বিয়ৗ মাব্লাবাবৗ ক্ষমা মৗন্নায় অৗঙা। <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />আরৗ ছৗরবায়া মানসিনি বিসাজ্লানি বিরুদ্ধনাও মাবাফৗর বুংব্লা, বিয়ৗ ক্ষমা হৗজানায়, নাথায় জাইয়া গৗথার জিউখৌ নিন্দিয়ৗ, বিয়ৗ ক্ষমা মৗন্নায় অৗঙা, না বে যুগয়াও না ফৈগৌ যুগয়াও।<verse eid="MAT 12:32" /></para>
  <para style="s">বিংফাং আরৗ বিনি বিথাই</para>
  <para style="r">(<ref loc="LUK 6:43-45">লূক 6:43–45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />“বিংফাংখৌ মৗজাং খৗলাম আরৗ বেনি বিথাইয়াবৗ মৗজাং জানায়, এবা বিংফাংখৌ গাজ্রি খৗলাম আরৗ বেনি বিথাইয়াবৗ গাজ্রি জানায়, মানৗনা বিংফাংখৌ বেনি বিথাইজৗঙৗ ছিনাইজায়ৗ। <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />ও জিবৌ গাংছৗমনি বিসাফৗর, নৗংছৗরৗ গাওছৗরনৗ গাজ্রি জানানৈ মাব্রৈ মৗজাং খৗথায়া নৗংছৗরনিফ্রায় অৗংখাৎনৗ হাগৌ? মানৗনা গৗসৗ সিঙাও থানায়ছৗ খৗথাজৗং অৗংখাৎনৗ। <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />জাইনি গৗসৗয়া মৗজাং, বিনিফ্রায় মৗজাং খৗথা অৗংখাৎনৗ, আরৗ জাইনি গৗসৗয়া গাজ্রি সান্নান দং, বিনিফ্রায় গাজ্রি খৗথা অৗংখাৎনৗ। <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />নাথায় আঙৗ নৗংছৗরনৗ রাইঠিয়ৗ, সাফ্রৗমবৗ মানসিআ বিচারনি দিননাও গাওনি ফংফ্রৗমবৗ নংখাই-বাখাই খৗথানি থাখৈ হিসাব হৗনাংনায়। <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />মানৗনা নৗংনি খৗথাফৗরজৗংনৗ নৗঙৗ দায় গৈয়ি খৗলামজানায়, আরৗ নৗংনি খৗথাফৗরজৗংনৗ নৗঙৗ দোষী খৗলামজানায়।”<verse eid="MAT 12:37" /></para>
  <para style="s">যোনানি চিহ্ন</para>
  <para style="r">(<ref loc="MRK 8:11-12">মার্ক 8:11–12</ref>; <ref loc="LUK 11:29-32">লূক 11:29–32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />বি সমাও খাইছে আইন গুরুফৗর আরৗ ফরীশীফ্রা বিখৌ হৗনবায়, “গুরু, জৗং নৗংনিফ্রায় মৗনছে সৗমৗ গৗনাং চিহ্ন নুনৗ গৗসৗ জায়ৗ।” <verse eid="MAT 12:38" /><verse number="39" style="v" sid="MAT 12:39" />যীশুআ বুংফিনবায়, “ও দুষ্টু আরৗ জিনাহারি খৗলামগ্রা ফিরিনি মানসিফৗর, নৗংছৗরৗ মা চিহ্ন নাগিৎনৗ! নাথায় যোনা নবিনি চিহ্নখৌ নাগারনান জেবৗ চিহ্ন হৗনায় জানায় অৗঙা। <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />মানৗনা যোনা নবিআ জেরৈ গেদেৎ না'নি উদৈ সিঙাও সানথাম আরৗ হরথাম দংমৗন, বেবাদিনৗ মানসিনি বিসাহৌয়াবৗ বুহুমনি বিখায়াও সানথাম আরৗ হরথাম দৗনজানায়। <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />বিচারনি দিননাও নীনবীয় নৗগৗরনি মানসিফ্রা জিখাংনানৈ বে ফিরিখৌ দোষি খৗলামনায়, মানৗনা বিছৗরৗ যোনা নবিনি খৗথাবাইনায়খৌ খৗনানানৈ গৗসৗ ফিনদৗং আরৗ দা জাইয়া যোনানিখুরৈ দেৎসিন, বিয়ৗ বেয়াওনৗ দং। <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />বিচারনি দিননাও খৗলানি সেবানি রানীআ<note caller="+" style="x"><char style="xo" closed="false">12:42 </char><char style="xt" closed="false"><ref loc="1KI 10:1-13">1 রাজাফৗরনি বিজাব 10:1–13</ref></char></note> ছিখাংনানৈ বে ফিরিখৌ দোষী খৗলামনায়, মানৗনা বিয়ৗ গাওনি বুহুমনি জৗবথানায় সিমনানিফ্রায়, শলোমননি জ্ঞাননি খৗথাখৌ খৗনাছংনৗ ফৈদৗংমৗন। আরৗ দা বেয়াও জাইয়া দং, বিয়ৗ শলোমনিফ্রায় দেৎসিন।<verse eid="MAT 12:42" /></para>
  <para style="s">বাদুয়া জিউ হাবফৈফিন্নায়</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />“জেব্লা মৗনছে বাদুয়া জিউয়া সাছে মানসিনিফ্রায় অৗংখাৎলাঙৗ, অব্লা বিয়ৗ আরাম খৗলামনৗ থাখৈ গৗরান হাদৎ গেজের গেজের জায়গা নাইগিৎবায়ৗ আরৗ জায়গা মৗন্না। <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />অব্লা বিয়ৗ বুঙৗ; ‘আং অৗংখাৎবৗনায় ন্ব'য়াওনৗ আঙৗ থাংফিনাইছৈ,’ জেব্লা বিয়ৗ থাংফিন্নৗ, অব্লা ন্ব'খৌ রাওবৗ থায়ি, সিবস্রাংনায় আরৗ সমাইনা সাজাইনানৈ দৗন্নায় মৗনহৈয়ৗ, <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />বিনিফ্রান বিয়ৗ অৗংখাৎলাংনানৈ লৗগৗয়াও গাওনিখুরৈ গাজ্রিসিন সাতটা গুবুন বাদুয়া জিউফৗরখৌ লৗগৗআও লানান হাবফৈনানৈ থাফৈয়ৗ। আরৗ বিনি থাখৈনৗ বে মানসিআ সিগাংনিখুরৈ গাজ্রিসিন জায়ৗ। অব্লা বে গাজ্রি ফিরিনি মানসিফৗরনিয়াওবৗ বেবাদিনৗ জানায়।”<verse eid="MAT 12:45" /></para>
  <para style="s">যীশুনি বিমা আরৗ ফংবায়ফৗর</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />জেব্লা যীশুআ ভিড়জৗং রাইজ্লাইয়িন দংমৗন, বিনি বিমা আরৗ ফংবায়ফ্রা বিজৗং রাইজ্লায়নৗ লুবৈনানৈ বাইরাও গছংনানৈ দংমৗন। <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />ভিড়ফৗরনি সাছেআ যীশুখৌ হৗন্দৗং, “নৗংজৗং রাইজ্লায়নৗ লুবৈনানৈ, নৗংনি নৗম্মা আরৗ ফংবায়ফৗরা বাইরায়াও গছংনানৈ দং।” <verse eid="MAT 12:47" /><verse number="48" style="v" sid="MAT 12:48" />যীশুআ বিখৌ বুংফিনদৗং, “আংনি বিমায়া ছৗর? আরৗ আংনি ফংবায়ফৗরা ছৗর?” <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />ছেলাফৗরনি ঠিঙৈ দিন্ঠিনানৈ বিয়ৗ হৗনদৗং, “নায় বিছৗরৗ আংনি বিমা আরৗ ফংবায়ফৗর। <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />মানৗনা জাইফ্রা স্বৗর্গৗয়াও থানায় আংনি আফানি গৗসৗ বাদি মাওয়ৗ বিনৗ আংনি ফংবায়, বিনানাও আরৗ বিমা।”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">বিগৎ ফৗনায়নি দৃষ্টান্ত</para>
  <para style="r">(<ref loc="MRK 4:1-9">মার্ক 4:1–9</ref>; <ref loc="LUK 8:4-8">লূক 8:4–8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />বি দিননাওনৗ যীশুআ ন্ব'নিফ্রায় অৗংখাৎনানৈ লৈথৗ জিঙাও জিরাইহৈদৗং। <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />গেদেৎ হান্জায়া বিনি সৗরগিদিং জ'জানাইখায় বিয়ৗ গংছে নাওয়াও গাখৗনানৈ জিরাইহৈদৗং, আরৗ গাছেন মানসিফ্রা লৈথৗ জিঙাও গছংদৗং। <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />বি সমাও যীশুআ বিছৗরখৌ গৗবাং খৗথা দৃষ্টান্তজৗং বুংদৗং: “সাছে আবাদ মাওগ্রায়া হুয়াও বিগৎ ফৗনৗ থাংদৗং। <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />বিনি বিগৎ ফৗনায়াও খাইছে বিগৎফ্রা লামায়াও গৗগ্লাইদৗং, আরৗ দাওছেনফ্রা ফৈনানৈ বেখৌ খনজাগারদৗং। <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />খাইছেয়া হ্বা গৗবানি সিঙাও গেদেৎ অন্ঠাই থানায় জাইগায়াও গৗগ্লাইদৗং। আরৗ বেফৗরৗ হ্বা গৗবাখাই ঠাবনৗ বেৎখাংদৗং। <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />নাথায় সাননা জেব্লা অৗংখাৎবৗয়ৗ, অব্লা বিংফাংফ্রা সানদুংজৗং দুংগ্লাবনান গৗথৌয়ৈ রৗদা সুনৗ হায়িয়াও গৗখ্রৈনৗ রানলাংদৗং। <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />খাইছে বিগৎফ্রা সু-বারি গেজেরাও গৗগ্লাইদৗং, আরৗ সু বিংফাঙা দেৎনানৈ বিফাংফৗরখৌ ছেখঠাবনাইখায় বেফৗরৗ বিথাইফৗর থাইনৗ হায়াখৗছৈ। <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />খাইছে বিগৎফ্রা হ্বা মৗজাঙাও গৗগ্লাইদৗং, আরৗ ফৗহৈনায় বিগৎফৗরনিফ্রায় একশ গুন, ষাট গুন এবা ত্রিশ গুন বিথাইফৗর থাইবায়।<verse eid="MAT 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 13:9" />জাইফৗরনে খৗনাছংনৗ খৗমা দং বিছৗরৗ খৗনাছংথৗং।”<verse eid="MAT 13:9" /></para>
  <para style="s">দৃষ্টান্ত বুংনায়নি কারণ</para>
  <para style="r">(<ref loc="MRK 4:10-12">মার্ক 4:10–12</ref>; <ref loc="LUK 8:9-10">লূক 8:9–10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />ছেলাফ্রা বিনিয়াও ফৈনানৈ সৗংদৗং, “মানৗ নৗঙৗ মানসিফৗরজৗং দৃষ্টান্তফৗরখৌ বাহাইনানৈ রাইজ্লাইয়ৗ বুঙৗ?” <verse eid="MAT 13:10" /><verse number="11" style="v" sid="MAT 13:11" />যীশুআ বুংফিনবায়, “স্বৗর্গৗ রাইজৗনি থাখমানায় বিষয়খৌ মিথিনৗ থাখৈ নৗংছৗরনৗ জ্ঞানখৌ হৗনায় জাবায়, নাথায় বিছৗরনৗ অৗঙা। <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />জাইহা ইছে দং, বিনৗ বাংসিন হৗনায় জানায়, আরৗ বিছৗরনে আগ্লায় বিগ্লায় জানায়। আরৗ জাইহা গৈয়া, বিনিফ্রায় বিনিয়াও ইছে দংনায়খৌবৗ লাফিন্জানায়। <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />বিনিখাইনৗ আঙৗ নৗংছৗরখৌ দৃষ্টান্তজৗং বুঙৗ, জাহাথে, বিছৗরৗ নুব্লাবৗ নুয়ি বাদি। আরৗ খৗনাব্লাবৗ খৗনায়ি বাদি এবা বুজিয়ি বাদি। <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />বিছৗরনি থাখৈ যিশাইয়া নবিনি ভাববাণী বুংনাইয়া জাফুংবায়:</para>
  <para style="q1" vid="MAT 13:14">‘নৗংছৗরৗ খৗনাবায় থানায়,</para>
  <para style="q2" vid="MAT 13:14">নাথায় মালাবাবৗ বুজিনায় অৗঙা,</para>
  <para style="q1" vid="MAT 13:14">নৗংছৗরৗ নুবায় থানায়, নাথায় মালাবাবৗ নুনায় অৗঙা,<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />মানৗনা বে মানসিফৗরনি গৗসৗয়া বত্রা জাবায়,</para>
  <para style="q1" vid="MAT 13:15">বিছৗরনি খৗমাফ্রা ঠসা জাবায়,</para>
  <para style="q2" vid="MAT 13:15">আরৗ বিছৗরৗ গাওছৗরনি মগনফ্রাখৌ মৗখ্ছেবায়,</para>
  <para style="q1" vid="MAT 13:15">অৗঙাব্লা বিছৗরৗনি মগনফৗরজৗং নুগৌমৗন,</para>
  <para style="q2" vid="MAT 13:15">খৗমাজৗং খৗনাগৌমৗন,</para>
  <para style="q1" vid="MAT 13:15">বিছৗরনি গৗসৗয়াও বুজিনৗ হাগৌমৗন,</para>
  <para style="q2" vid="MAT 13:15">আরৗ বিছৗরৗ আংনি ঠিঙৈ গিদিংগৌমৗন</para>
  <para style="q1" vid="MAT 13:15">আরৗ আঙৗ বিছৗরখৌ<note caller="+" style="x"><char style="xo" closed="false">13:15 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">যিশাইয় 6:9–10</ref> </char></note> ছৗখানায়মৗন।’<verse eid="MAT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />নাথায় নৗংছৗরনি মগনফ্রা ধন্য মানৗনা বিছৗরৗ নুয়ৗ, আরৗ নৗংছৗরনি খৗমাফ্রা ধন্য মানৗনা বিছৗরৗ খৗনায়ৗ। <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />মানৗনা নংথারগৌয়ৈ আঙৗ নৗংছৗরনৗ বুঙৗ, গৗবাং নবিফ্রা আরৗ ধৗরৗমিয়া মানসিফ্রা নৗংছৗরৗ জেখৌ নুবায় বেখৌ নাইনৗ লুবৈব্লাবৗনৗ, বিছৗরৗ নুনৗ মৗনাখৈ আরৗ নৗংছৗর জেখৌ খৗনাবায়, বেখৌ খৗনানৗ লুবৈব্লাবৗনৗ বিছৗরৗ খৗনানৗ মৗনাখৈ।<verse eid="MAT 13:17" /></para>
  <para style="s">বিগৎ ফৗনায়নি ফিদিংনায় (উপমা) খৗথাখৌ যীশুআ বিজিৎনানৈ হৗনায়</para>
  <para style="r">(<ref loc="MRK 4:13-20">মার্ক 4:13–20</ref>; <ref loc="LUK 13:18-19">লূক 13:18–19</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />“বিনিখাইনৗ নৗংছৗরৗ বিগৎ ফৗনায়নি দৃষ্টান্তনি মানেখৌ খৗনাছংদৗ। <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />জেব্লা ছৗরবা স্বৗর্গৗ রাইজৗনি খৗথাখৌ খৗনায়ৗ নাথায় বিখৌ বুজিনৗ হায়া, বিয়ৗ ফৗনায়াও লামা সেরাও গৗগ্লৈনায় বিগৎ বাদি। শয়তানা বে ফৗনায় বিগৎখৌ বিছৗরনি গৗসৗনিফ্রায় সেনানৈ লাঙৗ। <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />অন্ঠাইবারিয়াও গৗগ্লৈনায় বিগৎনা বেবাদি, বিছৗরৗ মৗজাং খৗথাখৌ খৗনাছঙৗ আরৗ রংজা বাজা ঠাবনৗ নাজাওয়ৗ; বিয়ৗ খৗথাখৌ খৗনানানৈ রংজানায়জৗং নাজাওয়ৗ। <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />নাথায় বিছৗরনে রৗদা গৗয়িখায়, বিছৗরনি গৗসৗয়াও দান্দিছে সমায়নি থাখৈ বান থায়ৗ। জেব্লানৗ মৗজাং খবরনি থাখৈ বিছৗরনি দুঃখ আরৗ নাছয়জানায় ছৗফৈয়ৗ, অব্লানৗ বিছৗরৗ গৗখ্রৈনৗ উনফিনৗ। <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />সু-বারি গেজেরাও গৗগ্লৈনায় বিগৎনা বেবাদি জাইফ্রা খৗথাখৌ খৗনাছঙৗ, নাথায় বুহুমনি জিংগাসিনায়, ধৗনি জানৗ হাস্থাইনায় আরৗ বাইদিসিনা লুবৈনাইয়া বিছৗরনিয়াও ছফৈব্লা বিছৗরৗ ছেখঠাবনাইখায় বিছৗরৗ বিথাই থাইনৗ হায়ি জায়ৗ। <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />নাথায় মৗজাং হ্বায়াও বিগৎ গৗগ্লৈনায়া বেবাদি জাইফ্রা খৗথাখৌ খৗনাছংনানৈ বুজিনানৈ নাজাওয়ৗ। বিছৗরৗ বিথাইফৗর থাইয়ৗ, বেফৗরনি খাইছেয়া একশ গুণ, খাইছেয়া ষাট গুণ আরৗ খাইছেয়া ত্রিশ গুণ বিথাইফৗর থাইয়ৗ।”<verse eid="MAT 13:23" /></para>
  <para style="s">গারুয়া হাগ্রানি দৃষ্টান্ত</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />যীশুআ বিছৗরনৗ গুবুন দৃষ্টান্ত বুংবাওবায়, “স্বৗর্গৗ রাইজৗয়া সাছে মানসি গাওনি হুয়াও মৗজাং বিগৎ ফৗনায় বাদি। <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />নাথায় বয়বৗ উন্ডুলাংনায় সমাও বিসারুয়া গমবারিয়াও ফৈনানৈ গারুয়া হাগ্রানি বিগৎখৌ ফৗদেৎনানৈ গালাংবায়। <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />জেব্লা গময়া বেদনানৈ বিডাং খায়ৗ অব্লা গারুয়া হাগ্রাফ্রাবৗ লৗগৗছে নুজাফায়ৗ। <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />আরৗ দাসফ্রা বৈগৗমানিয়াও ফৈনানৈ বুংবায়, ‘ও মালিক নৗঙৗ নৗংনি হ্বায়াও মৗজাং বিগৎ ফৗয়াখৈমৗন খৗমা? অব্লা ববেনিফ্রায় গারুয়া হাগ্রাফ্রা ফৈখৗ?’ <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />বিয়ৗ বুংবায়, ‘বেখৌ বিসারুয়ানৗ মাওদৗং।’ অব্লা দাসয়া বিখৌ সৗংদৗং, ‘নৗঙৗ গৗসৗ জায়ৗ নামা জৗঙৗ থাংনানৈ বেফৗরখৌ ফুহৈনৗ?’ <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />বিয়ৗ বুংফিনবায়, ‘অৗঙা, মানৗনা জেব্লা নৗংছৗরৗ গারুয়া হাগ্রাখৌ ফুনায় অব্লা নৗংছৗরৗ গমখৌবৗ ফুফ্নাংনৗ হাগৌ। <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />হানায়নি সম ছৗফৈয়াগৌসিম মৗননৈখৌবৗ দেৎনৗ হৗদৗ। আরৗ হানায় বৗথৗরাও আং বুথুমগ্রা মানসিফৗরখৌ বুংনায়, সিগাঙাও গারুয়া হাগ্রাখৌ আটি সৎদৗ বেফৗরখৌ বুথুমনানৈ সাওদৗ আরৗ গম মায়খৌ বুথুমনানৈ আংনি বাখ্রিয়াও দৗনহৈনায়।’”<verse eid="MAT 13:30" /></para>
  <para style="s">বিসর বিগৎনি দৃষ্টান্ত</para>
  <para style="r">(<ref loc="MRK 4:30-32">মার্ক 4:30–32</ref>; <ref loc="LUK 13:18-19">লূক 13:18–19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />যীশুআ গুবুন মৗনছে দৃষ্টান্ত বিছৗরনৗ বুংবাওবায়, “স্বৗর্গৗ রাইজৗয়া বিসর বিগৎ বাদি যে মানসিয়া বিগৎখৌ লানানৈ গাওনি হুয়াও ফৗহৈদৗং। <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />বিসর বিগৎনা বুহুমনি গাছেন বিগৎফৗরনি খুরৈ দুইসিন, নাথায় জেব্লা দেৎনৗ, অব্লা বিয়ৗ বাগাননি গুবুন মৈগং বিংফাংফৗরনিখুরৈ দেৎসিন জায়ৗ, আরৗ বিয়ৗ গেদেৎ বিংফাং জায়ৗ, আরৗ নখ্রাংনি দাওছেনফ্রা ফৈনানৈ ডালাইফৗরাও বাসা বৗনায়নানৈ থায়ৗ।”<verse eid="MAT 13:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />যীশুআ বিছৗরনৗ আরবাও গুবুন মৗনছে দৃষ্টান্ত বুংবাওবায়, “স্বৗর্গৗ রাইজৗয়া বেবাদি, সাছে হিন্জাওয়া ইছে সোডা <note caller="+" style="f"><char style="fr" closed="false">13:33 </char><char style="ft" closed="false">গ্রীক বিজাবমাও মৗনছে সৗদৗব লিৎনায় দং, জাইনি অৗংথিয়া জাবায় খামির এবা ঈষ্ট। বেফৗরৗ জাবায় সোডা বাদি, মাবা মৗংয়াফৗরাও হৗদেৎনৗব্লা বিয়ৗ গৗখ্রৈনৗ মৗংয়াফৗরনি মহরখৌ সিলাইয়ৗ। জাজেননায়াও ঈশ্বৗরনি রাইজৗ রুজুনায়খৌ গৗলৈ নুয়ৗ, বিসর বিগৎ বাদি এবা ইছে সোডা বাদি নাথায় উনাও দেৎলাঙৗ।</char></note> লানানৈ মহনছে ময়দাও হৗনানৈ নাদৗং আরৗ গাছৈনবৗ বুগাজৗবদৗং।”<verse eid="MAT 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />যীশুআ বেফৗর গাছেনখৌ দৃষ্টান্তনি গেজেরজৗং হান্জানৗ খৗথাদৗং। দৃষ্টান্ত বাহাইয়ামানৎনিন বিয়ৗ বিছৗরনৗ জেবৗ বুঙামৗন। <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />বেবাদিনৗ নবিজৗং বুংজাখানায় খৗথায়া জাফুংবায়, “আঙৗ দৃষ্টান্তনি গেজেরজৗং আংনি খগাখৌ খুলিনায়, সংসারখৌ সৗরজিনায়নিফ্রায় থাখৗমানান থানায় জিনিসখৌ আঙৗ বিজিৎনানহনায়।”<note caller="+" style="x"><char style="xo" closed="false">13:35 </char><char style="xt" closed="false"><ref loc="PSA 78:2">গীতফৗর 78:2</ref></char></note><verse eid="MAT 13:35" /></para>
  <para style="s">গারুয়া হাগ্রানি দৃষ্টান্তখৌ বিজিৎনায়</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />অব্লা যীশুআ ভিড়খৌ নাগারনানৈ ন্ব'সিঙাও হাবহৈবায়। বিনি ছেলাফ্রা বিনিয়াও ফৈনানৈ হৗনবায়, “হুয়াও থানায় গারুয়া হাগ্রানি দৃষ্টান্তখৌ জৗংনৗ বিজিৎনান খৗথাদৗ।”<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />যীশুআ বুংফিনবায়, “জাইয়া মৗজাং বিগৎ ফৗবায় বি জাবায়, মানসিনি বিসাহৌয়া। <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />হুয়া জাবায় সংসার, আরৗ মৗজাং বিগৎনা জাবায় রাইজৗনি বিসাফৗর, গারুয়া হাগ্রায়া জাবায় শয়তাননি বিসাফৗর, <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />আরৗ জাই বিসারুয়া গারুয়া হাগ্রাখৌ ফৗদৗং, বিয়ৗ জাবায় শয়তান। আবাদ হানাইয়া জাবায় জৗবনাইনি বৗথৗর, আরৗ আবাদ হাগ্রাফৗরা জাবায় আরফ'ফৗর। <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />জেরেই গারুয়া হাগ্রাফৗরখৌ বুখুনানৈ অয়াৎনাও সাওদৗং, বেবাদিনৗ জৗবনাইনি বৗথৗরা জানায়। <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />মানসিনি বিসাহৌয়াআ গাওনি আরফ'ফৗরখৌ থৗনহৎনায় আরৗ বিছৗরৗ বিনি রাইজৗনিফ্রায় গাছেন পাপ মাওহৗগ্রা সাফ্রৗমবৗ আরৗ গাছেন গাজ্রি মাওগ্রাফৗর। <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />বিছৗর বিছৗরখৌ বুখুনানৈ জৗংবায় থানায় অয়াৎনাও গারসননায় আরৗ বিহা গাবখ্রাওনায়জৗং হাথায় অফ্রেনায় জানায়। <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />আরৗ ধার্মিকফ্রা গাওনি বিফানি রাইজৗয়াও সান বাদি মৗদাননায়। জাইফৗরহা খৗমা দং বিছৗরৗ খৗনাছংথৗং।<verse eid="MAT 13:43" /></para>
  <para style="s">থাখৗমানান থানায় ধৗন আরৗ মুক্তানি দৃষ্টান্ত</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />“স্বৗর্গৗ রাইজৗয়া হুয়াও দৗনখৗমানান মৗনছে ধৗন বাদি, জেব্লা সাছে মানসিয়া বিখৌ মৗনদৗং, আরবাও বিয়ৗ দৗনখৗমাবাওবায়, উনাও বিয়ৗ রংজা বাজা থাংনানৈ গাওনি দংনায়মানিখৌ ফাননানৈ আরৗ বি হুয়াখৌ বায়দৗং।<verse eid="MAT 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />আরবাও, স্বৗর্গৗ রাইজৗয়া এরইবাদি মৗজাং মুক্তা নাগিৎবাইনায় সাছে ফাইখারি। <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />আরৗ বিয়ৗ জেব্লা দাম গৗছা মুক্তাখৌ মৗনদৗং, অব্লা বিয়ৗ থাংনানৈ গাওনি দংনায়মানিখৌ ফানদৗং আরৗ বিখৌ বায়দৗং।<verse eid="MAT 13:46" /></para>
  <para style="s">জে'নি দৃষ্টান্ত</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />“আরবাও, স্বৗর্গৗ রাইজৗয়া মৗনছে জে'বাদি যে লৈথৗয়াও জে'খৌ সাৎনাইয়াও বাইদিসিনা জাতনি না' নাংদৗং। <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />জেব্লা জে'য়া নাঃজৗং বুংফাওদৗং জে' সাৎগ্রা মানসিফ্রা সাগৗর হাগুংয়াও বিখৌ বৗখাংদৗং। বিছৗরৗ জিরাইনানৈ আরৗ মৗজাং নাঃফৗরখৌ সাইখনান খবায়াও লায়ৗ, নাথায় গাজ্রি না' ফৗরখৌ গাহৎনৗ। <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />বেবাদিনৗ জৗবনাইনি বৗথৗরা জানায়। আরৗ আরফ'ফ্রা ফৈনানৈ ধার্মিকফৗরনি গেজেরনিফ্রায় গাজ্রিফৗরখৌ আলাদা খৗলামনায়, <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />আরৗ জৗংব্লৗওনায় অৎনাও গারসননাই আরৗ বিয়াও গাবনায় আরৗ হাথায় অফ্রেনায়।”<verse eid="MAT 13:50" /></para>
  <para style="s">গৗদান আরৗ গৗজাম ফৗরৗংনাইনি খৗথা।</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />যীশুআ বিছৗরখৌ সৗংবায়, “নৗংছৗরৗ বেফৗর গাছেনখৌবৗ বুজিজৗবায়দা?” বিছৗরৗ বুংফিনবায়, “অৗ।” <verse eid="MAT 13:51" /><verse number="52" style="v" sid="MAT 13:52" />যীশুআ বিছৗরখৌ হৗনবায়, “বিনিখাইনৗ আইন গুরু আরৗ স্বৗর্গৗ রাইজৗনি থাখৈ ছেলা জানায় সাফ্রৗমবৗ, বিয়ৗ সাছে ন্ব'নি বৈগৗমা বাদি জাইয়া গাওনি বাখ্রিনি গৗদান আরৗ গৗজাম ধৗনফৗরখৌ বয়ৗননৗ।”<verse eid="MAT 13:52" /></para>
  <para style="s">নবিনি মান গৈজায়ৈ</para>
  <para style="r">(<ref loc="MRK 6:1-6">মার্ক 6:1–6</ref>; <ref loc="LUK 4:16-30">লূক 4:16–30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />জেব্লা যীশুআ বেফৗর দৃষ্টান্তফৗরখৌ ফৗজৗবদৗং, বিয়ৗ বি জায়গানিফ্রায় গাওনি নৗগৗরাও থাংবায়। <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />আরৗ বিয়ৗ মানসিফৗরখৌ সিবিগ্রা ন্ব'য়াও ফৗরৗংদৗং আরৗ বিনি ফৗরৗংনাইয়াও বিছৗরৗ সৗমৗ নাংদৗং, “বিয়ৗ বে জ্ঞানখৌ ববেনিফ্রায় মৗনখৗ আরৗ ববেনিফ্রায় বেবাদি সৗমৗ গৗনাং খামানি মাওনৗ বৗলৗ মৗনখৗ? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />বিয়ৗ কি মা মিস্ত্রিনি বিসাহৌয়া অৗঙা? বিনে কি বিমাআ মরিয়ম অৗঙা, আরৗ যাকোব, যোষেফ, শিমোন, আরৗ যিহূদা বিনি ফংবায়ফৗর অৗঙা? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />বিনি গাছেন বিনানাওফ্রা কি মা জৗংজৗং লৗগৗছে অৗঙা? অব্লা বি মানসিয়া বেফৗর গাছেনখৌবৗ মহাইনিফ্রায় মৗনখৗ?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />আরৗ বিছৗরৗ যীশুখৌ অপমান খৗছাইয়াছৈ। নাথায় যীশুআ বিছৗরখৌ বুংবায়, “গাওনি নৗগৗরাও, আরৗ গাওনি ন্ব'খরখৌ নাগারনান, নবিআ জেরেওবৗ মান মৗন্নৗ,” <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />আরৗ বিয়ৗ জেবৗ সৗমৗ গৗনাং খামানিফৗর বিছৗরনিয়াও মাওয়াখৗছৈ, মানৗনা বিছৗরনি ফৗথায়নায় গৗয়িখায়।<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">যোহন বাপ্তিস্টনি সিথাৎ জানায়</para>
  <para style="r">(<ref loc="MRK 6:14-29">মার্ক 6:14–29</ref>; <ref loc="LUK 9:7-9">লূক 9:7–9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />বে সমাও গালীল হাদৎনি শাসনগিরি হেরোদ রাজায়া যীশুনি খৗথা খৗনাদৗং। <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />আরৗ বিয়ৗ গাওনি হাদাংগৗরাফৗরখৌ বুংবায়, “বেনৗ জাবায়, যোহন বাপ্তিস্ট, জাইয়া থৈনায়নিফ্রায় ঠাংখাং ফিনবায়! বিনিখাইনৗ বিনিয়াও সৗমৗ গৗনাং হাবাফৗর মাওনৗ হানায়নি বৗলৗ দং।” <verse eid="MAT 14:2" /><verse number="3" style="v" sid="MAT 14:3" />হেরোদ রাজায়া গাওনি ফংবায় ফিলিপনি হিন্জাও হেরোদিয়াসনি থাখৈ, আরৗ বিখৌ খুশি খৗলামনৗ থাখৈনৗ হেরোদনা যোহনখৌ হমনানৈ জৗবথে সালিয়াও দৗনদৗং; <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />মানৗনা যোহননা গলে গলে হেরোদখৌ বুংদৗংমৗন, “নৗঙৗ গাওনি ফংবায়নি হিনজাওখৌ দৗনাইআ আইননি বিরুদ্ধ।” <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />হেরোদনা যোহনখৌ সিথাৎনৗ হাস্থায়দৗংমৗন, নাথায় মানসিফৗরখৌ গিদৗংমৗন, মানৗনা মানসিফ্রা যোহনখৌ নবি হৗন্নানৈ মানিয়ৗমৗন। <verse eid="MAT 14:5" /><verse number="6" style="v" sid="MAT 14:6" />হেরোদনি জৗনৗম জানায় দিননাও হেরোদিয়াসনি বিসাজৗয়া বিয়াও আলাসিফৗরনি সিগাঙাও মৗসাবায় আরৗ বিনি মৗসানাইয়াও হেরোদনা এছেগ্রাব গৗজৗনবায়। <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />বিয়ৗ বেবাদি জবান লাদৗং, বিয়ৗ মা বিনায় বিনি বিখৌনৗ হৗনায়। <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />বিমানি ফৗরৗংনায় বাদি বিসাজৗয়া হৗনবায়, “যোহন বাপ্তিস্টনি খর'খৌ থুরসিয়াও লানানৈ আংনৗ হৎদৗ।” <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />বে খৗথায়াও রাজায়া দুঃখু জাদৗং; অব্লাবৗ হাংখ্রায় জানায় আলাসিফৗরনি সিগাঙাও সমায় লানায়খায়, বিয়ৗ হিন্জাও গথ'নৗ বিনায় বাদি হুখুম হৗবায়। <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />আরৗ জৗবথেসালিয়াও মানসি থৗনহৎনানৈ যোহননি খর'খৌ দানছহৗবায়। <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />যোহননি খর'খৌ গংছে থুরসিয়াও লানানৈ হিন্জাওসানৗ হৗফৈদৗং, হিন্জাও গথ'আ খর'খৌ গাওনি বিমানৗ হৈবায়। <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />যোহননি ছেলাফ্রা বেখৌ খৗনানানৈ ফৈবায়, আরৗ গৗথৈখৌ লাংনানৈ ফবহৈয়াছৈ। অব্লা বিছৗরৗ থাংনানৈ যীশুনৗ খৗথাদৗং।<verse eid="MAT 14:12" /></para>
  <para style="s">যীশুনি হাজারবা মানসিখৌ জাহৗনায়</para>
  <para style="r">(<ref loc="MRK 6:30-44">মার্ক 6:30–44</ref>; <ref loc="LUK 9:10-17">লূক 9:10–17</ref>; <ref loc="JHN 6:1-14">যোহন 6:1–14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />জেব্লা যীশুআ মা জাখৗ বেখৌ খৗনায়ৗ, অব্লা বিয়ৗ বি জায়গানিফ্রায় নাওজৗং ডাবছে নিজুম জায়গায়াও থাংদৗং। নাথায় বেখৌ খৗনানানৈ, নৗগৗরনিফ্রায় হান্জায়া যীশুখৌ লৗগৗ লানৗ থাখৈ উন উন থাংফাদৗং। <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />যীশুআ জেব্লা নাওনিফ্রায় হাগুঙাও অৗংখাৎদৗং, অব্লা গেদেৎ হান্জাখৌ নুনৗ মৗনদৗং, আরৗ বিছৗরখৌ নুনানৈ বিয়ৗ অনখাংবায় আরৗ বিছৗরনি বেরামফৗরখৌ ছৗখাবায়।<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />জেব্লা মৗনাবিলি জাবৗনৗ হমদৗংছৈ ছেলাফ্রা বিনিয়াও ফৈনানৈ হৗনবায়, “বেয়ৗ মৗনছে সুনসান জায়গা আরৗ সানাবৗ হাবদৗংছৈ। হান্জাখৌ থৗনহৎদৗ বিছৗরৗ খাঠি খালানি গামিফৗরাও থাংনানৈ গাওছৗরনি থাখৈ ইছে জাগ্রা মৗঙাফৗর বায়নানৈ জাহৈথৗংছৈ।”<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />যীশুআ বুংফিনবায়, “বিছৗর গৗজাননাও থাংজ্লায়নৗ নাঙা নৗংছৗরৗ গাওছৗরনৗ বিছৗরনৗ মাবাফৗর মৗঙা জানৗ হৗদৗ।”<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />বিছৗরৗ বুংফিনবায়, “জৗংজৗং সিঠাও গুরবা আরৗ না' মানৈ বান দং।”<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />যীশুআ বুংবায়, “বেফৗরখৌ আংনিয়াও লাবৗদৗ।” <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />আরৗ বিয়ৗ মানসিফৗরখৌ গাংসৗনি ছায়াও জিরায়নৗ থৗনবায়, উনাও যীশুআ সিঠাও গুরবা আরৗ না' মানৈখৌ লানানৈ স্বৗর্গৗ ঠিঙৈ নাইগৗদাওনানৈ বিয়ৗ ঈশ্বৗরখৌ ধন্যবাদ হৗবায় আরৗ সিঠাওফৗরখৌ ছিফাইনানৈ, বিয়ৗ ছেলাফৗরনৗ হৗবায় আরৗ ছেলাফ্রা বেফৗরখৌ মানসিফৗরনৗ রান্নানৈ হৗবায়।<verse eid="MAT 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 14:20" />বিছৗর বয়বৗ উদৈ বুংজাছৈ জানানৈ গৗজৗনবায়, আরৗ ছেলাফ্রা বাইগ্লিনায় বুংজাফা বুংজাফা বারো খাদা আগ্লাইনায়খৌ খৗনথুমবায়। <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />জানায় মানসিফৗরনি হিন্জাওফৗর আরৗ গথ'ফৗরখৌ নাগারনানৈ গাছেন হৌয়াসাফ্রা হাজারবাছৗ দংমৗন।<figure style="fig" alt="Feeding five thousand" file="wa03856.jpg" size="col" loc="p" ref="14:21">হাজারবা মানসিফৗরখৌ জাহৗনায়</figure><verse eid="MAT 14:21" /></para>
  <para style="s">যীশুনি দৈ ছা ছা থাবায়নায়</para>
  <para style="r">(<ref loc="MRK 6:45-52">মার্ক 6:45–52</ref>; <ref loc="JHN 6:15-21">যোহন 6:15–21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />বি সমাও যীশুআ গাওনি ছেলাফৗরখৌ গৗখ্রৈনৗ নাওয়াও গাখৗহৗনানৈ লৈথৗ বাদনৈ গুবুন ফাৎছে গাওনি সিগাং থাংগ্রৗবায়, আরৗ গাও উন জানানৈ হান্জাখৌ থৗনহৎস্রাংবায়। <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />বিছৗরখৌ থৗনহৎস্রাংনায়নি উনাও, প্রার্থনা খৗলামনৗ থাখৈ গাও হাজৗ ছায়াও গাখৗলাংবায়, বি মৗনাবিলিয়াও বিয়ৗ বিয়াও হাসিঙৈ দংমৗন। <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />আরৗ জেব্লা নাওয়া হাগুংনিফ্রায় গৗজাননাও ছহৈবায়মৗন, অব্লা ঢেউজৗং আরৗ বার উল্ঠা বারনায়জৗং নাওয়া বুবথিংজাদৗং।<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />আরৗ ফুংনি তিনটা সমাও যীশুআ দৈ ছা ছা থাবায়নানৈ ছেলাফৗরনিয়াও থাংদৗং। <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />জেব্লা ছেলাফ্রা বিখৌ সাগৗর ছা ছা থাবায়লাংনায়খৌ নুদৗং, অব্লা বিছৗরৗ গিখ্রংনানৈ বি সমাও বুংদৗং, “নৈ ভুতনা,” আরৗ গিনায়জৗং গাবখ্রাওদৗং।<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />নাথায় যীশুআ ঠাবনৗ রাও হৎনানৈ হৗন্দৗং, “সাহস খৗলাম! আংছৗ, নৗংছৗরৗ দাগি!”<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />পিতরআ বুংফিনবায়, “ফৗরবু নৗঙৗনব্লা, আংখৌ দৈ ছা ছা থাবায়নানৈ নৗংনিসিম ফৈনৗ বুংদৗ” <verse eid="MAT 14:28" /><verse number="29" style="v" sid="MAT 14:29" />যীশুআ বুংবায়, “ফৈ!” অব্লা পিতরআ নাওনিফ্রায় দৈয়াও অৗংখাৎনানৈ দৈ ছা ছা থাবায়নানৈ যীশুনি ঠিঙৈ ফৈদৗং। <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />নাথায় বিয়ৗ জেব্লা বারখৌ গৗব্রাবথার বারনায় নুদৗং, বিয়ৗ গিদৗং আরৗ দৈয়াও গৗডৗলাংহাংহাং জাদৗংমৗন, বে সমাও পিতরা যীশুখৌ গাবজ্রিনানৈ হৗনদৗং, “ও ফৗরবু, আংখৌ বাছায়দৗ!” <verse eid="MAT 14:30" /><verse number="31" style="v" sid="MAT 14:31" />গৗখ্রৈনৗ, যীশুআ গাওনি আখাইখৌ ফৗলাওনানৈ বিনি আখাইয়াও হমহৌৎবায়, বিয়ৗ হৗনবায়, “ও ইছে বান ফৗথায়গ্রা, নৗঙৗ মানৗ গৗনৗ গৗথৗ খৗলামৗ?” <verse eid="MAT 14:31" /><verse number="32" style="v" sid="MAT 14:32" />আরৗ জেব্লা বিছৗর নাওয়াও গাখৗদৗং, আরৗ বার্রাবৗ থামিবায়। <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />অব্লা জাইফ্রা নাওয়াও দংমৗন বিছৗরৗ যীশুখৌ খুলুমবায়, “নংথারগৌয়ৈ নৗঙৗ ঈশ্বৗরনি বিসা হৌয়া।”<verse eid="MAT 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />জেব্লা বিছৗরৗ লৈথৗ বাদনানৈ গিনেষরৎয়াও ছহৈনানৈ নাওখৌ হাগুংয়াও দৗনবায়। <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />জেব্লা বে জায়গানি মানসিফ্রা যীশুখৌ ছিনায়দৗং অব্লা বিছৗরৗ খাঠি খালা থানায় গাছেন জায়গাও খবরখৌ পাঠাইদৗং। মানসিফ্রা গাওছৗরনি জব্রা মানসিফৗরখৌ যীশুনিয়াও লাবৗদৗং। <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />আরৗ বিছৗরৗ বিনি গান্নায় সি'রৗবৈখৌ বান দাংহৗথৗং হৗন্নানৈ বিনিয়াও খাওলাইদৗং আরৗ জেছেবাং মানসিফ্রা বিখৌ দাংদৗং, বিছৗর বয়নিবৗ র'গফ্রা গাদৗং।<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">আজৌ আজৈফৗরনি আইননি বাথ্রা ফৗরৗংনায়</para>
  <para style="r">(<ref loc="MRK 7:1-13">মার্ক 7:1–13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />অব্লা যিরূশালেমনিফ্রায় ফৈনায় খাইছে ফরীশীফৗর আরৗ আইন গুরুফ্রা যীশুনিয়াও ফৈনানৈ সৗংবায়, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“নৗংনি ছেলাফ্রা মানৗ গৗডৗ গৗডানি প্রাচীনফৗরনি বিধিবাদি ফালিয়া, বিছৗরৗ মানৗ জানায়নি সিগাং বিধিবাদি আখাইফৗর ছুয়ালাবানৗ জায়ৗ?”<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />যীশুআ বুংফিনবায়, “নৗংছৗরৗ মানৗ গাওছৗরনি বিধিনি থাখৈ ঈশ্বৗরনি আদেশখৌ ছিফায়ৗ? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />মানৗনা ঈশ্বৗরা হৗন্দৗং, ‘নৗংছৗরৗ গাওছৗরনি বিমা আরৗ বিফাখৌ মান হৗ,’<note caller="+" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="EXO 20:12">অৗংখাৎলাংনায় 20:12</ref></char></note> আরৗ, ‘জাইয়া গাওনি বিমা বিফাখৌ সাও হৗয়ৗ, বিয়ৗ সিথাৎজানাংনায়<note caller="+" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="EXO 21:17">অৗংখাৎলাংনায় 21:17</ref> </char></note>।’ <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />নাথায় নৗংছৗরৗ বুঙৗ, ‘যে ছৗরবাআ গাওনি বিমা এবা বিফাখৌ বুঙৗব্লা, “আং জেজৗং নৗংছৗরখৌ দান হৗনৗ হাগৌমৗন, বেখৌ ঈশ্বৗরনৗ হৗনায় জাবায়।”’ <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />বেবাদিনৗ নৗংছৗরৗ বুঙৗ গাওছৗরনি বিমা বিফাখৌ মান হৗনৗ নাংলে হৗন্নৗ। গাওছৗরনি বিধিনি থাখৈ ঈশ্বৗরনি খৗথাখৌ দানগারৗ। <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />নৗংছৗর দিন্ঠিফ্লাগ্রাফৗর, যিশাইয় নবিআ নৗংছৗরনি নৗংগৌখৌনৗ ভাববাণী বুংদৗং,<verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />বে মানসিফ্রা আংখৌ গুশুঠি বিজৌজৗং বান মান হৗয়ৗ,</para>
  <para style="q2" vid="MAT 15:8">নাথায় বিছৗরনি গৗসৗয়া আংনিফ্রায় গৗজানাও থায়ৗ।<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />বিছৗরনি আংখৌ সিবিনাইয়া নংখাই বাখাইছৗ,</para>
  <para style="q2" vid="MAT 15:9">মানৗনা বিছৗরৗ মানসিফৗরনি দানায় আইনফৗরখৌছৗ ঈশ্বৗরনি আইনফৗর হৗন্নানৈ<note caller="+" style="x"><char style="xo" closed="false">15:9 </char><char style="xt" closed="false"><ref loc="ISA 29:13">যিশাইয় 29:13</ref> </char></note> ফৗরৗঙৗ।”<verse eid="MAT 15:9" /></para>
  <para style="s">মানসিয়া মাজৗং গাজ্রি জায়ৗ</para>
  <para style="r">(<ref loc="MRK 7:14-23">মার্ক 7:14–23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />যীশুআ গাওনিয়াও ভিড়ফৗরখৌ লিংহৎনানৈ হৗনবায়, “আংনি বুংনায়খৌ খৗনাছংনানৈ বুজিনানৈ লাদৗ। <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />বাইরানিফ্রায় মানসিনি খৌগাজৗং হাবলাংনায়া বিছৗরখৌ গাজ্রি খৗলামা, নাথায় মানসিনি সিঙাওনিফ্রায় অৗংখাৎনাইয়াছৗ বিছৗরখৌ গাজ্রি খৗলামৗ।”<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />অব্লা ছেলাফ্রা বিনিয়াও ফৈনানৈ সৗংদৗং, “নৗঙৗ মিথিগৌনা? যে ফরীশীফ্রা গৗসৗয়াও নাংবায় জেব্লা বিছৗরৗ বে খৗথাখৌ খৗনাদৗং।”<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />বিয়ৗ বুংফিনবায়, “স্বৗর্গৗয়াও থানায় আংনি আফাজৗং গায়জায়ি ফাংফ্রৗমবৗ বিফাঙা ফুনানৈ গারজানায়। <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />বিছৗরনি থাখৈ জেবৗ দাসান, বিছৗরৗ খানাফৗরনি লামা দিন্ঠিগ্রা খানাফৗর। যদি সাছে খানা মানসিখৌ গুবুন সাছে খানা মানসিয়া দৈদেনলাংব্লা সানৈবৗ হাখরাও গৗগ্লৈনায়।”<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />পিতরা হৗনবায়, “দৃষ্টান্তখৌ জৗংনৗ বেখেওনানৈ হৗদৗ।”<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />যীশুআ বিছৗরখৌ সৗংবায়, “নৗংছৗরৗ দাসিমবৗ বুজিনৗ হায়াখৈছৈ? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />নৗংছৗরৗ নুয়াখৈ নামা যে জেবৗ জিনিসয়া খৌগাজৗং হাবনানৈ উদৈ সিঙাও থাংনানৈ উনাও মৗদৗমনিফ্রায় অৗংখাৎনৗ? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />নাথায় মানসিনি খৌগাজৗং যে খৗথায়া অৗংখাৎবৗয়ৗ বিয়ৗ গৗসৗনিফ্রায়, আরৗ বেফৗরৗ বিছৗরখৌ গাজ্রি খৗলামৗ। <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />মানৗনা গাজ্রি সান্নায়ফ্রা গৗসৗনিফ্রায় ফৈয়ৗ, মানসি সিথাৎনৗ, গুবুন হিন্জাওখৌ জিনাহারি খৗলামনৗ, বেশ্যা খৗলামনৗ, সিখাও খাওনৗ, নংখায় সাক্ষী হৗনৗ আরৗ নিন্দিনায়। <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />বেফৗরছৗ মানসিখৌ গাজ্রি খৗলামৗ নাথায় আখাই ছুয়ামাৎনিন জানাইয়া মানসিখৌ গাজ্রি খৗলামা।”<verse eid="MAT 15:20" /></para>
  <para style="s">সাছে হিন্জাওনি ফৗথায়নায়</para>
  <para style="r">(<ref loc="MRK 7:24-30">মার্ক 7:24–30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />যীশুআ বি জায়গাখৌ নাগারনানৈ সোর আরৗ সীদোন নৗগৗরনি খাঠি খালা জায়গাফৗরাও থাংদৗং। <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />বি জায়গানি সাছে কানানীয় হিন্জাওয়া যীশুখৌ গাবনানৈ হৗনদৗং, “ও ফৗরবু, দায়ূদনি বিসা হৌয়া, আংনি ছায়াও অনখাংদৗ। আংনি বিসাজৗয়া ভুত হমজানানৈ গৗব্রাবথার সৈছৗদৗং।”<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />যীশুআ জেবৗ উত্তর হৗয়াখৗছৈ। বিনিখাইনৗ বিনি ছেলাফ্রা ফৈনানৈ বিখৌ খাওলাইদৗং, “বিখৌ থৗনহৎদৗ মানৗনা বিয়ৗ জৗংনি উন উন গাববায় থাদৗং।”<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />যীশুআ উত্তর হৗবায়, “আংখৌ ইস্রায়েলনি গৗমানায় মেন্ডাফৗরনি গেজেরাও বান থৗনহৎদৗং।”<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />বি হিন্জাওয়া ফৈনানৈ বিনি সিগাং হান্ঠুখরাইনানৈ বুংদৗং, “ও ফৗরবু, আংখৌ হেফাজাব হৗদৗ।” <verse eid="MAT 15:25" /><verse number="26" style="v" sid="MAT 15:26" />বিয়ৗ বুংফিনদৗং, “গথ'ফৗরনি জাগ্রা মৗঙাখৌ লানানৈ ছৈমাফৗরনৗ হৗনাইয়া মৗজাং অৗঙা।”<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />হিন্জাওয়া হৗনবায়, “নৗংগৌ, ফৗরবু, ছৈমাফ্রাবৗ অৗংখাম জানায় টেবিলনি সিঙাও থানানৈ মালিকনি জানায় গুন্দ্রা গুন্দ্রি গৗগ্লৈনায়খৌ মৗনজায়ৗ!” <verse eid="MAT 15:27" /><verse number="28" style="v" sid="MAT 15:28" />অব্লা যীশুআ বিখৌ বুংবায়, “ও হিন্জাও বিসা নৗংনি ফৗথাইনায়া বেছে গেদেৎ, নৗংনি খাওলাইনাইয়া নাজাওজাবায়।” আরৗ বি সমাওনৗ বিনি বিসাজৗয়া ছৗখাজাদৗং।<verse eid="MAT 15:28" /></para>
  <para style="s">হাজারবা মানসিফৗরখৌ জাহৗনায়</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />যীশুআ বে জায়গাখৌ নাগারনানৈ গালীল লৈথৗ জিংয়াও থাংদৗং, আরৗ বিয়ৗ হাজৗয়াও থাংনানৈ জিরাইহৈদৗং। <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />গেদেৎ হান্জায়া বিনিয়াও ফৈনানৈ, লেংগ্রা, খানা, নুলা, ববা আরৗ গৗবাং গুবুনফৗরখৌবৗ লানানৈ যীশুনি আঠেং সেরাও বিছৗরখৌ দৗনফৈবায় আরৗ যীশুআ বিছৗরখৌ ছৗখাবায়। <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />মানসিফ্রা সৗমৗ নাংদৗং, জেব্লা বিছৗরৗ ববাখৌ খৗথা রাইনায় নুয়ৗ, নুলা মৗজাং জানায়, লেংগ্রাফ্রা থাবায়নায় আরৗ খানা নুনায় আরৗ বিছৗরৗ ইস্রায়েলনি ঈশ্বৗরখৌ বাখ্নাইদৗং।<verse eid="MAT 15:31" /></para>
  <para style="s">যীশুআ হাজারব্রৈ মানসিফৗরখৌ জাহৗনায়</para>
  <para style="r">(<ref loc="MRK 8:1-10">মার্ক 8:1–10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />যীশুআ গাওনি ছেলাফৗরখৌ লিংহৎনানৈ হৗনদৗং, “আঙৗ বে মানসিফৗরখৌ অনখাংবায়, মানৗনা বিছৗরৗ আংজৗং থাফানাইয়া সানথামছৈ, দা বিছৗরনিয়াও জানৗ মৗংবৗ গৈলে। আঙৗ, উখৈজায়িন্নৗ বিছৗরখৌ ন্ব'য়াও থৗনহৎনৗ লুবৈয়া, এবা বিছৗরৗ উখৈনানৈ লামায়াও গৗগ্লৈছৗবায়নৗ হাগৌ।” <verse eid="MAT 15:32" /><verse number="33" style="v" sid="MAT 15:33" />বিনি ছেলাফ্রা বুংবায়, “জৗং বে সুনসান জায়গায়াও ববেনিফ্রায় ঠৗজাছে জাগ্রা মৗঙাফৗরখৌ মৗন্নৗ এছেগ্রাব ভিড়খৌ জাহৗনৗ?” <verse eid="MAT 15:33" /><verse number="34" style="v" sid="MAT 15:34" />যীশুআ সৗংবায়, “নৗংছৗরনিয়াও গুরফছে সিঠাও দং?” বিছৗরৗ বুংফিনবায়, “সাতটা দং, আরৗ ফিসা ফিসা নাঃফৗর ইছে দং।”<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />অব্লা যীশুআ বিছৗরখৌ হ্বায়াও জিরায়হৗদৗং। <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />আরৗ বিয়ৗ সাতটা সিঠাও আরৗ নাঃখৌ লানানৈ ঈশ্বৗরখৌ ধন্যবাদ হৗন্দৗং, আরৗ ছিফায়নানৈ মানসিফৗরনৗ রান্নানৈ হৗনৗ ছেলাফৗরনৗ গথাইদৗং, আরৗ ছেলাফ্রা রান্নানৈ হৗদৗং। <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />বিছৗর গাছেন ঠৗজাছে জাখাংনায়নি উনাও গুন্দ্রি গুন্দ্রা আগ্লাইনায়খৌ হুখাংনানৈ বুংজাফা বুংজাফা সাত খাদা মৗনবায়। <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />জাইফ্রা জাদৗংমৗন বিছৗররৗ হিন্জাওফৗর আরৗ গথ'ফৗরখৌ নাগারনানৈ হাজারব্রৈছৗ দংমৗন।<verse eid="MAT 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 15:39" />বিনি উনাও যীশুআ মানসিফৗরখৌ থৗনহৎনানৈ যীশুআ নাওয়াও গাখৗনানৈ মাগাদানাও থাংবায়।<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">হাংখৗ নাগিৎনায়</para>
  <para style="r">(<ref loc="MRK 8:11-13">মার্ক 8:11–13</ref>; <ref loc="LUK 12:54-56">লূক 12:54–56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />ফরীশীফ্রা আরৗ সদ্দূকীফ্রা যীশুনিয়াও ফৈনানৈ আরৗ যীশুখৌ ফানদৗয়াও খৗখ্লৈনৗ হাস্থাইনানৈ স্বৗর্গৗনিফ্রায় মৗনছে চিহ্ন দিন্ঠিনানৈ বিনি একথিয়ারখৌ প্রমাণ খৗলামনৗ থৗনবায়। <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />বিয়ৗ বুংফিনবায়, “জেব্লা বেলাছি জায়ৗ অব্লা নৗংছৗরৗ হৗন্নৗ, ‘বৗথৗরা মৗজাং জানাই মানৗনা নখ্রাঙা গৗজা।’ <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />আরৗ ফুং জাব্লা নৗংছৗরৗ হৗন্নৗ দিনৈ বারহুংখা বারনায় মানৗনা নখ্রাঙা গৗজা আরৗ খৗমসি। নৗংছৗরৗ বুহুম আরৗ নখ্রাংখৌ নাইনানৈ অবস্থাখৌ বুজিনৗ রৗংগৌ, নাথায় নৗংছৗরৗ বে সমফৗরনি চিহ্নফৗরখৌ বিজিৎনৗ হায়া। <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />ও দুষ্টু আরৗ জিনাহারি খৗলামগ্রা জৗলৈনি মানসিফৗর, নৗংছৗরৗ মা চিহ্নখৌ নাগিৎনৗ! নাথায় যোনা নবিনি চিহ্নখৌ ছাড়া জেবৗ চিহ্নখৌ হৗয়া জনাই অৗঙা। অব্লা যীশুআ বিছৗরখৌ নাগারনানৈ থাংবায়।”<verse eid="MAT 16:4" /></para>
  <para style="s">ফরীশী আরৗ সাদ্দুকীফৗরনি সোডা</para>
  <para style="r">(<ref loc="MRK 8:14-21">মার্ক 8:14–21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />জেব্লা লৈথৗ বাদলাংনায়নি উনাও ছেলাফ্রা মিথিনৗ মৗনবায়, ছেলাফ্রা লৗগৗছে সিঠাও লাফানৗ বাওদৗং। <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />যীশুআ বিছৗরখৌ বুংবায়, “সাবধান জাদৗ, নৗংছৗরৗ ফরীশী আরৗ সদ্দূকীফৗরনি খামিরনিফ্রায় সাবধান জা।”<verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />বিছৗরৗ গাওজৗং গাও বেবাদি রাইজ্লাইদৗং আরৗ বুংবায়, “জৗঙৗ লৗগৗয়াও সিঠাও লাফায়িখায় বেবাদি বুংদৗং।” <verse eid="MAT 16:7" /><verse number="8" style="v" sid="MAT 16:8" />যীশুআ ছেলাফৗরনি রাইজ্লাইনায়খৌ মিথিনানৈ হৗন্দৗং, “ও নৗংছৗর ইছে বান ফৗথায়গ্রাফৗর, নৗংছৗরনিয়াও লৗগৗয়াও সিঠাও গৈয়িখৌ মানৗ রাইজ্লাইদৗং? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />দাসিমবৗ নৗংছৗরৗ বুজিয়া নামা? মাকি নৗংছৗরনিয়াও এছেবৗ গৗসৗয়াও গৈয়া সিঠাও গুরবাজৗং হাজারবা মানসিখৌ জাহৗনায় আরৗ বিছৗরৗ জাখাংনায়নি উনাও নৗংছৗরৗ গুন্দ্রা গুন্দ্রি খাদাফৗছে বুথুমনানৈ মৗনফিনামৗন? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />কিন্বা হাজারব্রৈ মানসিফৗরনি থাখৈ সাতটা সিঠাও, অব্লা বুংজাফা খাদা আগ্লাইনায় বেছেবাং বুথুমামৗন। <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />বে মাব্রৈ জাখৗ নৗংছৗরৗ বুজিলে যে আং নৗংছৗরখৌ সিঠাওনি বিষয়ৈ বুংবায়থায়াখৈ মৗন? নাথায় নৗংছৗরৗ ফরীশী আরৗ সদ্দূকীফৗরনি খামিরনিফ্রায় গাওখৌ সাবধান জাদৗ।” <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />উনাও বিছৗরৗ বুজিনৗ হাদৗং যে বিয়ৗ খামির বাহাইনায়নি বিরুদ্ধনাও বিছৗরখৌ বুঙাখৈমৗন, নাথায় ফরীশীফৗরনি আরৗ সদ্দূকীফৗরনি ফৗরৗংনায়নি বিরুদ্ধনাওছৗ সাবধান জানৗ থৗনদৗং।<verse eid="MAT 16:12" /></para>
  <para style="s">ফৗরবু যীশুআনৗ মসিহ</para>
  <para style="r">(<ref loc="MRK 8:27-30">মার্ক 8:27–30</ref>; <ref loc="LUK 9:18-21">লূক 9:18–21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />জেব্লা যীশুআ কৈসরিয়া ফিলিপীনি খাঠি খালানি হাদৎনাও ফৈনানৈ, বিয়ৗ গাওনি ছেলাফৗরনিয়াও সৗংদৗং, “মানসিফ্রা মানসিনি বিসাহৌয়াখৌ ছৗরখৌ হৗন্নৗ?” <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" />ছেলাফ্রা বুংফিন্দৗং, “খাইছেয়া হৗন্নৗ, যোহন বাপ্তিস্টআ নৗংনৗ, নাথায় খাইছেয়া বুঙৗ, এলিয় আরৗ গুবুনফ্রা বুঙৗ, যিরমিয় কিন্বা নবিফৗরনি গুবুন নবিফৗরনি সাছে।” <verse eid="MAT 16:14" /><verse number="15" style="v" sid="MAT 16:15" />অব্লা যীশুআ সৗংদৗং, “নাথায় নৗংছৗরলায়? নৗংছৗরৗ আংখৌ ছৗরখৌ হৗন্নানৈ হৗন্নৗ?”<verse eid="MAT 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16" />শিমন পিতরা উত্তর হৗবায়, “নৗঙৗ বি মসিহয়ানৗ গৗঠাং ঈশ্বৗরনি বিসা হৌয়া।” <verse eid="MAT 16:16" /><verse number="17" style="v" sid="MAT 16:17" />যীশুআ বুংফিনবায়, “ও যোনানি বিসাজ্লা শিমোন ধন্য নৗঙৗ, মানৗনা বেখৌ রাওবৗ থৈ আরৗ মৗদৗমজৗং নুজাহৗয়াখৈ, নাথায় স্বৗর্গৗয়াও থানায় আংনি আফাছৗ নুজাহৗদৗং। <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />আরৗ আং নৗংখৌ হৗন্নৗ, নৗঙৗ পিতর, বিনি মানেয়া জাবায় অন্ঠাই, বে অন্ঠাইনি ছায়াও আঙৗ আংনি মন্ডলীখৌ লুনায় আরৗ গৗথৈনি বৗলৗয়া বেখৌ ফেজেননৗ হানায় অৗঙা। <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />স্বৗর্গৗ রাইজৗনি চাবিখৌ আঙৗ নৗংনৗ হৗনায় আরৗ নৗঙৗ বুহুমাও জায়খৌ খায়ৗ, বিখৌ স্বৗর্গৗয়াওবৗ খায়ৗ, আরৗ নৗং বুহুমাও জায়নৗ খেওনায় বিনৗনৗ স্বৗর্গৗয়াওবৗ খেওনানৈ হৗনায়।”<verse eid="MAT 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20" />অব্লা যীশুআ গাওনি ছেলাফৗরখৌ গৗরায়ৈ বাধাহৗদৗং যে বিয়ৗ গাওনৗ মসিহ, বেখৌ রাওনৗবৗ দাখৗথা হৗন্নানৈ।<verse eid="MAT 16:20" /></para>
  <para style="s">যীশুনি গাওনি থৈনায়নি বিষয়ৈ ভবিষৎবানি খৗলামনায়</para>
  <para style="r">(<ref loc="MRK 8:31">মার্ক 8:31</ref>; <ref loc="MRK 9:1">9:1</ref>; <ref loc="LUK 9:22-27">লূক 9:22–27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />বি সমনিফ্রায়নৗ যীশুআ গাওনি ছেলাফৗরনৗ রাইঠিনৗ হমবায়, “আঙৗ যিরূশালেমাও থাংনৗ নাংনায়, আরৗ ইনাইনৗ, যিহূদী প্রাচীনফৗরনি, গাহায় যাজকফৗরনি আরৗ আইন গুরুফৗরনি আখাইয়াও সৈনাংনায়, আরৗ সিথাৎজানায়, নাথায় থৈনায়নি সানথামাও ঠাংখাংফিননায়।” <verse eid="MAT 16:21" /><verse number="22" style="v" sid="MAT 16:22" />অব্লা পিতরা বিখৌ ফাৎছেজৗং লাংনানৈ রাইনৗ হমদৗং। বিয়ৗ বুংবায়, “মাব্লাবাবৗ, ফৗরবু! বেফৗর বাদিয়া নৗংনিয়াও দাজাথৗং।”<verse eid="MAT 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23" />যীশুআ গিদিংনানৈ পিতরখৌ হৗনবায়, “নৗঙৗ শয়তান, আংনিফ্রায় গৗজান জা! নৗঙৗ আংনি ছৌখ্ঠুহৗগ্রা, নৗংনি সান্নায়ফ্রা ঈশ্বৗরনিফ্রায় অৗঙা, নাথায় মানসিনিফ্রায়ছৗ।”<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />অব্লা যীশুআ গাওনি ছেলাফৗরখৌ হৗনদৗং, “ছৗরবায়া আংনি ছেলা জানৗ লুবৈয়ৗব্লা গাওছৗরনি গৗসৗ বাদি দাথাবায়থৗং, আরৗ সানফ্রৗমবৗ বিছৗরৗ গাওছৗরনি ক্রুশখৌ বান্নানৈ আংনি উন উন ফৈথৗং। <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />মানৗনা জাইয়া গাওনি জিউখৌ বাছায়নৗ হাস্থায়ৗ, বিয়ৗ বিখৌ খৗমানায়, নাথায় জাইয়া আংনি থাখৈ গাওনি জিউখৌ খৗমায়ৗ, বিয়ৗ বাছাই জানায়। <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />ছৗরবায়া সংসারনি গাছেনখৌবৗ মৗন্নানৈ গাওনি জিউখৌ খৗমায়ৗব্লা, বিহা মা লাভ দং? কিন্বা মানসিয়া গাওনি জিউনি পরিবর্তে মা হৗফিন্নৗ হানায়? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />মানৗনা মানসিনি বিসাহৌয়াআ গাওনি বিফানি মহিমাজৗং গাওনি আরফ'ফৗরখৌ লৗগৗয়াও লানানৈ ফৈনায়, আরৗ সাফ্রৗমনৗবৗ গাওছৗরনি মাওনায় বাদি মৗননাংগৌ বানথাখৌ হৗনায়। <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />নংথারগৌয়ৈ আঙৗ নৗংছৗরখৌ বুঙৗ, বেয়াও গছংনান দংনায়ফৗরনি গেজেরাও ছৗরবা ছৗরবায়া মানসিনি বিসাহৌয়াখৌ বিনি রাইজৗয়াও ফৈনায়খৌ নুয়াগৌ মানি থৈনায় অৗঙা।”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">যীশুনি মুস্রি সৗলাইনায়</para>
  <para style="r">(<ref loc="MRK 9:2-13">মার্ক 9:2–13</ref>; <ref loc="LUK 9:28-36">লূক 9:28–36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />ছয় দিননি উনাও যীশুআ পিতর, যাকোব আরৗ যাকোবনি ফংবায় যোহনখৌ লৗগৗয়াও লানানৈ ঠৗঙৈ মৗনছে গৗজৌ হ্বাজৗয়াও গাওছৗরজৗং গাওছৗর গাখৗলাংবায়। <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />জেরও বিছৗর বান দৗংমৗন, আরৗ বি জায়গাওনৗ বিছৗরনি সিগাঙাওনৗ বিনি মুস্রিয়া সৗলাইদৗং, যীশুনি মৗখাংআ সান বাদি জৗংব্লাওদৗং, আরৗ গাননায় সি'ফ্রা বাতিনি সমান গুফুৎ জাদৗং। <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />আরৗ বে সমাও বিছৗরনি সিগাঙাও মোশি আরৗ এলিয়খৌ যীশুজৗং রাইজ্লাইনায় নুবায়। <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />অব্লা পিতরা যীশুখৌ হৗনবায়, “ও ফৗরবু, জৗংনি থাখৈ বেহা থানাগৌয়া মৗজাং জানায়! থৗ জৗঙৗ গংথাম ডেরা লুনি, নৗংনৗ গংছে, মোশিনৗ গংছে আরৗ এলিয়নৗ গংছে।”<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />জেব্লা বিয়ৗ খৗথা বুংগাছেন দংমৗন, বে সমাও স্রাং জৗমৈ দাখাছে নুজাফৈনানৈ বিছৗরখৌ খৗবফৈদৗং, আরৗ জৗমৈনিফ্রায় বেবাদি রাও অৗংখাৎদৗং, <note caller="+" style="x"><char style="xo" closed="false">17:5 </char><char style="xt" closed="false"><ref loc="EXO 13:21">অৗংখাৎলাংনায় 13:21</ref>; <ref loc="2PE 1:16-18">2 পিতর 1:16–18</ref></char></note>“বিনৗ আংনি অনজাগ্রা বিসা হৌয়া বিজৗংনৗ আঙৗ খুশি জায়ৗ। বিনি খৗথাখৌ খৗনাছং।”<verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />জেব্লা ছেলাফ্রা বে রাওখৌ খৗনায়ৗ, অব্লা বিছৗরৗ গিখ্রংদৗং আরৗ হায়াও খগ্লুবনানৈ থাদৗং।<verse eid="MAT 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 17:7" />অব্লা যীশুআ ফৈনানৈ বিছৗরখৌ দাংনানৈ হৗনদৗং, “ছিখাং।” বিয়ৗ বুংবায়, “গিনৗ নাঙা।” <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />জেব্লা বিছৗরৗ নাইগদাওয়ৗ, অব্লা বিছৗরৗ যীশুখৌ ছাড়া রাওখৌবৗ নুয়াখৈছৈ।<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />বিছৗর হাজৗনিফ্রায় অৗংখাৎবৗনায় সমাও যীশুআ বিছৗরখৌ আদেশ হৗদৗং, “মানসিনি বিসাহৌয়াআ থৈনায়নিফ্রায় ঠাংখাংফিনগৌমানি নৗংছৗর জেখৌ নুবায়, বেখৌ রাওনৗবৗ দাখৗথা।” <verse eid="MAT 17:9" /><verse number="10" style="v" sid="MAT 17:10" />আরৗ ছেলাফ্রা যীশুনিয়াও সৗংবায়, “এলিয়আ ফৈগ্রৗথারনাংনায় হৗন্নানৈ আইন গুরুফ্রা অব্লা মানৗ হৗন্নৗ?” <verse eid="MAT 17:10" /><verse number="11" style="v" sid="MAT 17:11" />যীশুআ বুংফিনবায়, “নৗংছৗরনি বুংনাইয়া নৗংগৌ, এলিয়আ ফৈনায় আরৗ গাছেনখৌবৗ ফৗসাবফিননায়। <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />আঙৗ নৗংছৗরনৗ রাইঠিয়ৗ, এলিয়আ ফৈখাবায় আরৗ বিছৗরৗ বিখৌ ছিনাইয়াখৗছৈ, নাথায় বিছৗরৗ গাওছৗরনি গৗসৗ বাদি বিনি ছায়াও গাছেনখৌ খৗলামবায়। বিবাদিনৗ মানসিনি বিসাহৌয়াবৗ বিছৗরনি আখাইয়াও সৈনাংনায়ছৈ।”<verse eid="MAT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13" />অব্লা ছেলাফ্রা বুজিবায় যে বিয়ৗ যোহন বাপ্তিস্টনি বিষয়ৈ বিছৗরখৌ বুংবায় থাদৗংমৗন।<verse eid="MAT 17:13" /></para>
  <para style="s">ভূত হমজানায় গথ'খৌ ছৗখানায়</para>
  <para style="r">(<ref loc="MRK 9:14-29">মার্ক 9:14–29</ref>; <ref loc="LUK 9:37-43">লূক 9:37–43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />জেব্লা বিছৗরৗ ভিড়নিয়াও ছফৈয়ৗ, অব্লা সাছে মানসিয়া যীশুনি খাঠিয়াও ফৈনানৈ বিনি মৗখাঙাও হান্ঠু খরায়ফৈয়ৗ। <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />আরৗ বিয়ৗ বুংবায়, “ফৗরবু, আংনি বিসাজ্লানি ছায়াও অনখাংদৗ, বিনে মৃগী রগ দং আরৗ বিয়ৗ বিরাঠ সৈছৗনাংদৗং, আরৗ বিয়ৗ গলে গলে অয়াৎ আরৗ দৈয়াও গৗগ্লৈয়ৗ। <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />আং বিখৌ নৗংনি ছেলাফৗরনিয়াও লাবৗদৗংমৗন, নাথায় বিছৗরৗ বিখৌ ছৗখানৗ হায়াখৈছৈ।”<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />যীশুআ বুংফিনবায়, “ও ফৗথায়নাইগৈয়ি আরৗ গাজ্রিমাওগ্রা ফিরিনি মানসিফৗর, বেছে গৗবাও আং নৗংছৗরজৗং লৗগৗআও থাবাওনৗ আরৗ নৗংছৗরখৌ সহায়বাওনৗ? নৗংনি বিসাজ্লাখৌ বেহা আংনিয়াও লাবৗ।” <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />যীশুআ বি ভূতখৌ হৗদাওনানৈ হৗয়নদৗং, আরৗ ভূতনা হৌয়াসা গথ'নিফ্রায় অৗংখাৎলাংদৗং, আরৗ বি সমাওনৗ গথ'আ ছৗখাজাদৗং।<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />উনাও ছেলাফ্রা যীশুনিয়াও ফৈনানৈ সৗংখৗমাদৗং, “জৗঙৗ বিখৌ মানৗ হৗখাৎনৗ হায়াখৈছৈ?” <verse eid="MAT 17:19" /><verse number="20" style="v" sid="MAT 17:20" />ফৗরবুআ বুংফিনবায়, “মানৗনা নৗংছৗরহা গৗলৈ বান ফৗথানায় দং। নংথারগৌয়ৈ আঙৗ নৗংছৗরখৌ বুঙৗ, নৗংছৗরহা গৗলৈ বিসর বিগৎ গৎছেনি সমান ফৗথাইনায় থায়ৗব্লা নৗংছৗরৗ বে হাজৗখৌবৗ বেবাদি হৗন্নৗ হানায়, ‘বেনিফ্রায় বিহা দৗরৗদলাং,’ আরৗ হাজৗআ দৗরৗদলাংনায়। আরৗ নৗংছৗরৗ জেবৗ খৗলামনৗ হায়ি জানায় অৗঙা। <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />নাথায় প্রার্থনা আরৗ উপবাস ছাড়া বেফৗরবাদি ভূতফৗরখৌ হৗখাৎনৗ হায়া<note caller="+" style="f"><char style="fr" closed="false">17:21 </char><char style="ft" closed="false">খাইছে মেনাস্ক্রিপ্ঠাও বে পদনা লাফাদেৎজাখৈ'</char></note>।”<verse eid="MAT 17:21" /></para>
  <para style="s">যীশুআ থৈনায়খৌ খেবনৈ মিথিহৗবাওবায়</para>
  <para style="r">(<ref loc="MRK 9:30-32">মার্ক 9:30–32</ref>; <ref loc="LUK 9:43-45">লূক 9:43–45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />জেব্লা বিছৗরৗ লৗগৗছেয়ৈ গালীলয়াও জ'ফৈয়ৗ অব্লা যীশুআ বিছৗরখৌ হৗন্দৗং, “মানসিনি বিসাহৌয়াআ মানসিফৗরনি আখাইয়াও হমনানৈ হৗনায়। <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />বিছৗরৗ বিখৌ সিথাৎনায়, আরৗ সানথামনি দিনাও জিউয়াও ঠাংখাংফিন্নায়।” আরৗ ছেলাফ্রা দাহা নাংদৗং।<verse eid="MAT 17:23" /></para>
  <para style="s">মন্দিরনি খাজনানি বাথ্রা</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />যীশু আরৗ বিনি ছেলাফ্রা জেব্লা কফরনাহুমাও ছফৈয়ৗ, অব্লা মন্দিরনি খাজনা খাংগ্রায়া পিতরনিয়াও ফৈনানৈ সৗংদৗং, “মা নৗংছৗরনি গুরুআ মন্দিরনি খাজনা হৗয়া নামা?” <verse eid="MAT 17:24" /><verse number="25" style="v" sid="MAT 17:25" />বিয়ৗ বুংফিনবায়, “অৗ, হৗয়ৗ।”</para>
  <para style="p" vid="MAT 17:25">জেব্লা পিতরা ন্ব'য়াও ছফৈয়ৗ, অব্লা যীশুআনৗ সিগাং বুংনাইয়া, “শিমোন, নৗং মা সান্নৗ?” বিয়ৗ সৗংবায়, “সংসারনি রাজাফ্রা ছৗরনিফ্রায় খাজনা খাঙৗ? গাওছৗরনি হাদৎনি মানসিফৗরনিফ্রায় কিন্বা গুবুনহারিফৗরনিফ্রায়?”<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />পিতরা উত্তর হৗবায়, “গুবুনহারিফৗরনিফ্রায়।” যীশুআ বিখৌ বুংফিনবায়, “অব্লাহায় বিনি মানসিফ্রা হৗনাঙা। <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />নাথায় জৗঙৗ অপরাদনি কারণ জায়িবাদি, থাং, লৈথৗয়াও বৗরসি বৗনহৈ, আরৗ সিগাং না' হমনায় না'নি খগাখৌ খেও, আরৗ বিয়াও নৗংছৗরৗ থাইছে টাকা মৗননায়, বে টাকাখৌ লানানৈ আংনি আরৗ নৗংনি থাখৈ খাজনাখৌ বিছৗরনৗ হৈ।”<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">স্বৗর্গৗ রাইজৗয়াও ছৗর দেৎসিন</para>
  <para style="r">(<ref loc="MRK 9:33-37">মার্ক 9:33–37</ref>; <ref loc="LUK 9:46-48">লূক 9:46–48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />বে সমাও ছেলাফ্রা যীশুনিয়াও ফৈনানৈ সৗংদৗং, “অব্লা স্বৗর্গৗ রাইজৗয়াও ছৗর দেৎসিন?” <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />যীশুআ সাছে উন্দৈ গথ'খৌ গাওনিয়াও লিংহৎবায়, আরৗ বিছৗরনি গেজেরাও দৗনদৗং। <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />আরৗ বিয়ৗ বুংবায়, নংথারগৌয়ৈ আঙৗ নৗংছৗরখৌ বুঙৗ, জেব্লাগৌমানি নৗংছৗরৗ গৗসৗ সৗলাইনানৈ উন্দৈ গথ'ফৗর বাদি জায়া, মাব্লাবাবৗ নৗংছৗরৗ স্বৗর্গৗ রাইজৗয়াও হাবনৗ হানায় অৗঙা। <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />বিনিখাইনৗ বে উন্দৈ গথ' বাদি গাওখৌ বয়নিখুরৈ দুইসিন খৗলামনানৈ লানায়, বিয়ৗ স্বৗর্গৗ রাইজৗয়াও দেৎসিন। <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />আরৗ জাইয়া আংনি নামমৈ সাছে উন্দৈ গথ'খৌ নাজাওয়ৗ বিয়ৗ আংখৌনৗ নাজাওয়ৗ।<verse eid="MAT 18:5" /></para>
  <para style="s">গুবুনখৌ পাপমাও খৗখ্লৈনায়</para>
  <para style="r">(<ref loc="MRK 9:42-48">মার্ক 9:42–48</ref>; <ref loc="LUK 17:1-2">লূক 17:1–2</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />আংখৌ ফৗথাইগ্রা উন্দৈফৗরনি ছৗরবা সাছেখৌ জাইয়া পাপমাও খৗখ্লৈয়ৗ, বিছৗরনৗ গৗদৗনায়াও মৗনছে গেদেৎ অন্ঠাই খাদেৎজানানৈ লৈথৗয়াও ডুবৗয়নানৈ থৈনাইয়া বিনি থাখৈ মৗজাংসিন। <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />ধিক্কার সংসার নৗংহা মানৗনা যে জিনিসফ্রা মানসিফৗরখৌ পাপমাও খৗখ্লৈয়ৗ! বেফৗর ফৈথারনাংনায়, নাথায় ধিক্কার বি মানসিফৗরহা জাইফৗরনি গেজেরজৗং বেফৗর ফৈয়ৗ।<verse eid="MAT 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8" />নৗংনি আখাই আরৗ আঠেঙা নৗংখৌ পাপমাও খৗখ্লৈব্লা, বেখৌ দানছনানৈ গাহৎগার! মানৗনা আখাই ফাৎনৈয়ৈ জেব্লাইবৗ গৗমৗৎরৗঙি অয়াৎনাও গারসনজানায়নিখুরৈ আখাই ফাৎছে গৈয়ি জানানৈ জৗবনৗ গৈয়ি গৗঠাঙাও হাবনাইয়া নৗংনি থাখৈ মৗজাংসিন। <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />নৗংনি মগননা নৗংখৌ পাপমাও খৗখ্লৈব্লা আরৗ বেখৌ এখ্লনান গাহৎগার! মগন থাইনৈয়ৈ অয়াৎনি নরকআও গারসনজানায়নিখুরৈ মগন থাইছেজৗং জৗবনৗ গৈয়ি গৗঠাঙাও হাবনাইয়া নৗংনি থাখৈ মৗজাংসিন।<verse eid="MAT 18:9" /></para>
  <para style="s">গৗমানায় মেন্ডানি দৃষ্টান্ত</para>
  <para style="r">(<ref loc="LUK 15:3-7">লূক 15:3–7</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />নাই যে, উন্দৈ গথ'ফৗরনি সাছেখৌবৗ নৗংছৗরৗ উনদায়ি দাসান, আঙৗ নংথারগৌখৌ হৗন্নৗ, স্বৗর্গৗয়াও থানায় বিছৗরনি আরফ'ফ্রা জেব্লাইবৗ স্বৗর্গৗনি আফানি মৗখাংখৌ নুয়ৗ। <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />মানৗনা মানসিনি বিসা হৌয়াআ গৗমানায় সাফ্রৗমখৌবৗ বাছায়নৗ ফৈবায়<note caller="+" style="f"><char style="fr" closed="false">18:11 </char><char style="ft" closed="false">খাইছে মেনাস্ক্রিপ্ঠাও বে পদনা লাফাদেৎজাখৈ</char></note>। <verse eid="MAT 18:11" /><verse number="12" style="v" sid="MAT 18:12" />নৗংছৗরৗ মা বাদি সান্নৗ? ছৗরবা মানসিয়া একশটা মেন্ডা দংব্লা আরৗ বেফৗরনিফ্রায় মাছেআ গৗমায়ৗব্লা মা কি বিয়ৗ নিরানব্বইটা মেন্ডাফৗরখৌ হাজৗফৗরাও গালাংনানৈ গৗমানায় মাছেখৌ নাগিৎনৗ থাংনায় অৗঙা খৗমা? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />আরৗ বিয়ৗ মৗনফিনব্লা, নংথারগৌয়ৈ আঙৗ নৗংছৗরখৌ বুঙৗ, অব্লা গৗমায়ি নিরানব্বইনিখুরৈ বিয়ৗ বে মাছেনি থাখৈ বাংসিন রংজায়ৗ। <figure style="fig" alt="Found back the lost sheep and rejoicing" file="wa03831.jpg" size="col" loc="p" ref="18:13">গৗমানায় মেন্ডাখৌ মৗনফিননায় আরৗ রংজানায়</figure> <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />বেবাদিনৗ উন্দৈ গথ'ফৗরনি ছৗরবা সাছেয়া আদ্রি জাথৗং হৗন্নানৈ নৗংছৗরনি স্বৗর্গৗয়াও থানায় বিফায়া গৗসৗ জায়া।<verse eid="MAT 18:14" /></para>
  <para style="s">পাপ খৗলামনায় বিদা ফংবায়নি থাখৈ মাওনৗ গৗনাং</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />নৗংনি ফংবায় আরৗ নৗংনি বিনানাওয়া পাপফৗর মাওব্লা, নৗংছৗর সানৈনি গেজেরাও বিনেও থাংনানৈ বি ভুলখৌ দিন্ঠিনানৈ হৗদৗ, বিছৗরৗ খৗনাছংব্লা, নৗঙৗ বিছৗরখৌ মৗনফিনবায়। <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />নাথায় নৗংনি খৗথাখৌ খৗনাছঙাব্লা, সাছে কিন্বা গুবুন সানৈছৗ লাফা, জেন গাছেন বিষয়াও সাক্ষী দাইয়া প্রমাণনা সানৈ সাথামনি জানায় বায়দি। <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />নাথায় বিছৗরনি বুংনায়খৌবৗ খৗনাছঙাব্লা, গাছেন খৗথাখৌ মন্ডলীনৗ বুংদৗ আরৗ মন্ডলীনি মানসিফৗরনি বুংনায়খৌবৗ লায়াব্লা, নৗংছৗরৗ বিখৌ সাছে মূর্তি পুজিগ্রা কিন্বা সাছে খাজনা খাংগ্রাফৗরখৌ বাদি বিছৗরখৌ সাননানৈ লাদৗ।<verse eid="MAT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />“নংথারগৌয়ৈ আঙৗ নৗংছৗরখৌ বুঙৗ, নৗংছৗরৗ বুহুমাও জেখৌ খায়ৗ, বিখৌ স্বৗর্গৗয়াওবৗ খায়ৗ, আরৗ নৗংছৗরৗ বুহুমাও জেখৌ খেওনায় বিখৌ স্বৗর্গৗয়াওবৗ খেওনায়। <verse eid="MAT 18:18" /><verse number="19" style="v" sid="MAT 18:19" />আরবাও, নংথারগৌয়ৈ আঙৗ নৗংছৗরখৌ বুঙৗ, যে বুহুমাও নৗংছৗরৗ সানৈজৗং মৗনছে গৗসৗ জানানৈ জেখৌ বিনায়, স্বৗর্গৗয়াও থানায় আংনি আফায়াবৗ বেখৌ বিছৗরনি থাখৈ মাওয়া জানায়। <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />মানৗনা জেরেও সানৈ সাথাম আংনি নামমৈ জ'জায়ৗ বিহা আং বিছৗরজৗং থায়ৗ।”<verse eid="MAT 18:20" /></para>
  <para style="s">অনজায়ি দাসনি দৃষ্টান্ত</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />পিতরা যীশুনিয়াও ফৈনানৈ সৗংবায়, “ও ফৗরবু, আংনি ফংবায় কিন্বা বিনানাওয়া আংনি বিরুদ্ধ পাপফৗর মাওব্লা খেবছে ক্ষমা হৗনায়? সাতবার মা কি?” <verse eid="MAT 18:21" /><verse number="22" style="v" sid="MAT 18:22" />যীশুআ বুংফিনদৗং, আং নৗংখৌ হৗন্নৗ, সাতবার অৗঙা, নাথায় সত্তর বার ক্ষমা হৗনাংগৌ। <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />বিনিখাইনৗ, স্বৗর্গৗনি রাইজৗয়া বেবাদি সাছে রাজায়া গাওনি দাসফৗরনিফ্রায় হিসাবফৗরখৌ নায়নৗ হাস্থাইবায়। <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />জৈরৈবাদি বিয়ৗ হিসাবখৌ দৗন্নৗ হমজেনদৗং, অব্লা বিনিয়াও সাছে মানসিখৌ লাবৗদৗং, জাইনে দশ হাজার সোনানি জাওলা দৗংমৗন। <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />বি দাহারখৌ হৗনৗ বিনে মৗংবৗ রাহা গৈয়িখায় মালিকয়া বিখৌ, বিনি হিন্জাওখৌ, বিসাফৗরখৌ আরৗ বিনি দংনায়মানিখৌ ফাননানৈ দাহারখৌ ছুখনৗ হুখুম হৗবায়। <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />নাথায় বি দাসয়া হান্ঠুখরাইনান খুলুমনানৈ বেবাদি খাওলাইদৗং, আংনৗ সম হৗদৗ, আং নৗংনি দাহার গাছেনখৌবৗ হৗফিননায়। <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />বি দাসনি সমাও মালিকয়া বিখৌ অনখাংদৗং, আরৗ বিনি গাছেন দাহারখৌ নাগারনানৈ বিখৌ ক্ষমা হৗদৗ।<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />নাথায় জেব্লা বি দাসয়া অৗংখাৎলাঙৗ, অব্লা গাওনি লৗগৗ দাসফৗরনি সাছে দাসখৌ লৗগৗ মৗনহৈদৗং জাইয়া বিনিফ্রায় একশ টাকা দাহার লাদৗংমৗন। অব্লা বিয়ৗ বিখৌ গৗদৗনাও হৗমনান ছৈদখ্ঠাবনানৈ দাবি খৗলামদৗং, আংনৗ হৗনৗ গৗনাং দাহারখৌ আংনৗ হৗফিনদৗ। <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />অব্লা বিনি লৗগৗ দাসয়া বিনি হান্ঠুয়াও গৗগ্লৈনানৈ খাওলাইদৗং, অন্নানৈ আংনৗ সম হৗদৗ, আঙৗ নৗংনি গাছেনখৌবৗ হৗফিননায়। <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />নাথায় বিয়ৗ মানিয়াখৈছৈ, বরংছৗ, হমনানৈ হৗনৗ গৗনাংখৌ ছুখয়াগৌমানি জৗবথেসালিয়াও দৗনহৈদৗং। <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />জেব্লা গুবুন দাসফ্রা বে ঘটনা জানায়ফৗরখৌ নুদৗং, অব্লা বিছৗরৗ বিরাঠ গৗসৗয়াও দুঃখু মৗনদৗং আরৗ থাংনানৈ গাওছৗরনি মালিকনৗ গাছেন ঘটনা জানায়ফৗরখৌ খৗথাহৈদৗং। <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />অব্লা মালিকয়া বি দাসখৌ সিঙাও লিংহৎনানৈ হৗনদৗং, নৗং গাজ্রি দাস, মানৗনা নৗং খাওলাইনায়খায় আং নৗংনি গাছেন দাহারখৌ ক্ষমা হৗবায়। <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />আং জেরৈ নৗংখৌ অনখাংদৗংমৗন, বিবাদিনৗ নৗংবৗ গাওনি লৗগৗ দাসখৌ অনখাংনৗ নাংগৌ মৗন না? <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />আরৗ মালিকয়া রাগ জৗংনানৈ বি দাসখৌ গাছেন হৗনাংগৌ দাহারখৌ হৗফিনজৗবমাগৌমানি বিখৌ দুঃখু মৗনহৗনৗ জৗবথেসালিখৌ নেগ্রাফৗরনি আখাইয়াও গথাইনান হৗবায়।<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />“নৗংছৗরৗ গাও গাওনি ফংবায়খৌ এবা বিনানাওখৌ গৗসৗনিফ্রায় ক্ষমা হৗয়াগৌমানি, আংনি স্বৗর্গৗয়াও থানায় আফায়াবৗ নৗংছৗরৗ জেরৈ খৗলামদৗং বেবাদিনৗ নৗংছৗর সাফ্রৗমখৌবৗ খৗলামফিননায়।”<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">হিন্জাও গারনায়নি বাথ্রা</para>
  <para style="r">(<ref loc="MRK 10:1-12">মার্ক 10:1–12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />বেফৗর গাছেন বুখাংনায়নি উনাও যীশুআ গালীলনিফ্রায় যর্দ্দন বাদনানৈ যিহূদিয়া হাদৎনাও থাংবায়। <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />আরৗ হান্জাফ্রাবৗ বি জায়গাও জ'জাহৈবায়। আরৗ বিয়াও বিয়ৗ বিছৗরনি বেরামফৗরখৌ ছৗখাদৗং।<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />খাইছে ফরীশীফ্রা বিখৌ আনজাৎ লানৗ বিনিয়াও ফৈনানৈ বিছৗরৗ সৗংদৗং, “জৗংনৗ খৗথাছায়, মাবাফৗর কারণ লানানৈ আইন বাদি হৌয়াআ গাওনি হিন্জাওখৌ গারনৗ হায়ৗ নামা?”<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />যীশুআ বুংফিনবায়, “নৗংছৗরৗ শাস্ত্রখৌ পড়ায়াখৈ নামা, ‘নাথায় সৗরজিজেন্নায়াও সৗরজিগিরি ঈশ্বৗররা হৌয়া আরৗ হিন্জাওখৌ দাদৗং,’”<note caller="+" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="GEN 1:27">জাগাইজেন্নায় 1:27</ref> </char></note> <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />আরৗ বিয়ৗ হৗনদৗং, “‘বিনিখাইনৗ মানসিআ গাওনি বিমা বিফাখৌ নাগারনানৈ গাওনি হিন্জাওজৗং নাংঠাবনানৈ থায়ৗ, আরৗ সানৈজৗং মৗদৗময়াও মৗনছে জানায়।’<note caller="+" style="x"><char style="xo" closed="false">19:5 </char><char style="xt" closed="false"><ref loc="GEN 2:24">জাগাইজেন্নায় 2:24</ref></char></note> <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />আরৗ বিছৗর সানৈজৗং মৗদৗময়াও সাছে জানায়। বিছৗরৗ সানৈ অৗংলে, সাছে জাবায়। বিনিখাইনৗ জেখৌ ঈশ্বৗরা জাইজৗং জুলি খৗলামবায়, বিখৌ মানসিআ দাবৗখাথৗং।”<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />বিছৗরৗ সৗংবায়, “অব্লাহায় মানৗ, মোশিআ হুখুম হৗখৗ যে ছৗরবা সাছে হৌয়াআ গাওনি হিন্জাওখৌ গারনৗ হানায় হৗন্নানৈ, বিয়ৗ গারনায়নি প্রমাণ বিলাই লিৎনানৈ হৗথৗং, আরৗ গাওনিফ্রায় হগারহৎথৗং।”<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />নাথায় যীশুআ বিছৗরখৌ বুংফিনবায়, “নৗংছৗরনি গৗসৗয়া গৗরাখায় মোশিআ বে হুখুমখৌ নৗংছৗরনৗ লিৎনানৈ হৗদৗং। নাথায় সৗরজিজেননায়নিফ্রায় বেবাদি হুদায়া গৈয়ামৗন। <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />আঙৗ নৗংছৗরখৌ হৗন্নৗ যে ছৗরবায়া গাওনি হিন্জাওখৌ জিনাহারি ছাড়া গুবুন কারননৈ গাওনি হিন্জাওখৌ নাগারৗ, আরৗ গুবুন হিন্জাওখৌ হাবা খৗলামৗব্লা বিয়ৗ বি হিন্জাওজৗং জিনাহারিয়াও থাঙৗ।” <verse eid="MAT 19:9" /><verse number="10" style="v" sid="MAT 19:10" />ছেলাফ্রা বিখৌ বুংবায়, “হৌয়া আরৗ হিন্জাওনি গেজেরাও বেবাদিব্লা, হাবা জায়ামাৎনিনৗ থানাইআ মৗজাংসিন।” <verse eid="MAT 19:10" /><verse number="11" style="v" sid="MAT 19:11" />যীশুআ বুংফিনবায়, “সাফ্রৗমবৗ বে খৗথাখৌ মানিনান লানৗ হায়া, নাথায় ঈশ্বৗরা জায়নৗ সামর্থ্য হৗনায় বি বান হানায়। <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />আরৗ বিহা বেবাদি নপুংসক<note caller="+" style="f"><char style="fr" closed="false">19:12 </char><char style="ft" closed="false">নুপুংসকনি অৗংথিয়া জাবায় সাছে হৗয়া মানসি খাসি খৗলামজানায়। </char></note> দং, জাইয়া সারিজানাইনিফ্রায়নৗ নপুংসক, আরৗ খাইছে নপুংসকফ্রা গুবুনফৗরজৗং নপুংসক খৗলামজায়ৗ আরৗ খাইছে জাইফ্রা স্বৗর্গৗ রাইজৗনি থাখৈ নপুংসক জানানৈ থানৗ সাইখয়ৗ। জাইয়া বেখৌ নাজাওনৗ হায়ৗ বিয়ৗ নাজাওথৗং।”<verse eid="MAT 19:12" /></para>
  <para style="s">উন্দৈ গথ'ফৗর আরৗ যীশু</para>
  <para style="r">(<ref loc="MRK 10:13-16">মার্ক 10:13–16</ref>; <ref loc="LUK 18:15-17">লূক 18:15–17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />অব্লা মানসিফ্রা উন্দৈ গথ'ফৗরখৌ বিনিয়াও লাবৗদৗংমৗন জাহাথে যীশুআ বিছৗরনি খরফৗরাও আখাই দৗননৗ আরৗ প্রার্থনা খৗলামৗ, নাথায় ছেলাফ্রা বিছৗরখৌ সৗংখারিদৗং। <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />নাথায় যীশুআ বুংবায়, “উন্দৈ গথ'ফৗরখৌ আংনিয়াও ফৈনৗ হৗ, বিছৗরখৌ দারাইফৗথা, মানৗনা ঈশ্বৗরনি স্বৗর্গৗ রাইজৗয়া বিছৗর বাদিনিছৗ।” <figure style="fig" alt="Little children with Jesus" file="cn01772.jpg" size="col" loc="paw" copy="© DCC" ref="19:14">যীশুজৗং উন্দৈ গথ'ফৗর</figure><verse eid="MAT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 19:15" />আরৗ জেব্লা যীশুআ গথ'ফৗরনি খর' ছায়াও আখাই দৗন্নানৈ বৗর হৗবায়, বিনি উনাও বিহানিফ্রায় থাংবায়।<verse eid="MAT 19:15" /></para>
  <para style="s">সাছে ধৗনি জৗহৗলাও মানসি</para>
  <para style="r">(<ref loc="MRK 10:17-31">মার্ক 10:17–31</ref>; <ref loc="LUK 18:18-30">লূক 18:18–30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />বি সমাওনৗ সাছে মানসিয়া যীশুনিয়াও ফৈনানৈ সৗংফৈবায়, “ও গুরু, জৗবনৗগৗয়ি গৗঠাংখৌ মৗন্নৗ থাখৈ আংহা মা মৗজাং খামানি মাওনাংগৌ?”<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />যীশুআ বুংফিনবায়, “নৗঙৗ ববেয়া মৗজাং বে বিষয়ৈ মানৗ আংখৌ সৗঙৗ? বিহা মৗজাং সাছে বান। নৗঙৗ জৗবনৗ গৈয়ি গৗঠাঙাও হাবনৗ গৗসৗ জায়ৗব্লা আদেশফৗরখৌ মানিদৗ।” <verse eid="MAT 19:17" /><verse number="18" style="v" sid="MAT 19:18" />বি মানসিআ সৗংবাওবায়, “ববে মৗনছে আদেশফৗরখৌ?” যীশুআ বুংফিনবায়, “নৗঙৗ জিনাহারি দাখৗলাম, মানসি দাসিথাৎ; সিখাও দাখাও; নংখাই সাক্ষী দাহৗ, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />গাওনি বিমা বিফানৗ মান হৗ<note caller="+" style="x"><char style="xo" closed="false">19:19 </char><char style="xt" closed="false"><ref loc="EXO 20:12">অৗংখাৎলাংনায় 20:12</ref> </char></note>, আরৗ নৗঙৗ গাওখৌ বাদি গাওনি ফারা ফরুসিখৌ অন।”<verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />বি জৗহৗলাও মানসিয়া বুংবায়, “বেফৗর গাছেন আদেশফৗরখৌ আং মানিবৗবায়, দা আংহা মা মানিনৗ গৗনাং দংবাও?”<note caller="+" style="x"><char style="xo" closed="false">19:20 </char><char style="xt" closed="false"><ref loc="LEV 19:18">লেবীয় বিজাব 19:18</ref></char></note><verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />যীশুআ হৗনবায়, “নৗঙৗ গৗগৗ জানৗ লুবৈদৗংব্লা, থাং, নৗঙৗ নৗংনি দংনায় মানিখৌ ফান আরৗ হাওরিয়াফৗরনৗ রান্নানৈ হৈ, অব্লা নৗঙৗ স্বৗর্গৗনি ধৗনখৌ মৗননায়, অব্লা আংনি উন উন ফৈ।”<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />জেব্লা জৗহৗলাওআ বে খৗথাখৌ খৗনায়ৗ অব্লা বিয়ৗ দুঃখু মৗন্নানৈ থাংদৗং, মানৗনা বিনিয়াও গৗবাং ধন-সম্পত্তি দংমৗন।<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />অব্লা যীশুআ গাওনি ছেলাফৗরখৌ বুংবায়, “নংথারগৌয়ৈ আঙৗ নৗংছৗরখৌ বুঙৗ, ধৗনিফৗরনি থাখৈ স্বৗর্গৗ রাইজৗয়াও হাবনাইয়া বেছে গৗব্রাব! <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />আরবাও আং নৗংছৗরখৌ হৗন্নৗ, সাছে ধৗনি মানসি ঈশ্বৗরনি রাইজৗয়াও হাবনায়নিখুরৈ উঠনি বিজি খৗমাজৗং সিরিখিনাইয়া আলঠুয়াসিন।”<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />জেব্লা ছেলাফ্রা বে খৗথাখৌ খৗনাদৗং, অব্লা বিছৗরৗ এছেগ্রাব সৗমৗ নাংদৗং, আরৗ সৗংদৗং, “অব্লা ছৗরবাদিয়াথৗ বাছায়জানায়?”<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />যীশুআ বিছৗরনি ঠিঙৈ নায়নানৈ হৗনবায়, “মানসিনি নুনাইয়াও জানৗ হাথারাব্লাবৗ, নাথায় ঈশ্বৗরজৗং গাছেনবৗ জানৗ হাগৌ।”<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />পিতরা যীশুখৌ হৗনবায়, “জৗঙৗ জৗংনি দংনায়মানিখৌ নাগারনানৈ নৗংনি উন উন ফৈবায়, অব্লা জৗঙৗ মা মৗননায়?”<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />যীশুআ বিছৗরখৌ হৗনবায়, “নংথারগৌয়ৈ আঙৗ নৗংছৗরখৌ বুঙৗ, গৗদান মুগায়াও জেব্লা মানসিনি বিসাহৌয়াআ গাওনি মহিমা গৗনাং সিংহাসনাও জিরায়নায়, অব্লা নৗংছৗর জাইফ্রা আংনি উন উন ফৈদৗং, বারোটা সিংহাসনাও জিরাইনানৈ ইস্রায়েলনি বারো ফৗলেরখৌ বিচার খৗলামনায়। <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />আরৗ সাফ্রৗমবৗ, জাইয়া আংনি নামনি থাখৈ গাওনি ন্ব'বাং, বিদা ফংবায়, বিবো বিনানাও, বিমা, বিফা, বিসা, আরৗ হ্বাহু নাগারনাংবায়, বিছৗর সাফ্রৗমবৗ একশ গুন বাংসিন মৗননায় আরৗ জৗবনৗগৗয়ি গৗঠাংখৌ মৗননায়। <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />নাথায় গৗবাং জাইফ্রা সিগাঙাও, বিছৗরৗ উননাও জানায়, আরৗ গৗবাং জাইফ্রা উনাও, বিছৗরৗ সিগাঙাও জানায়।”<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">আংগুর বাগাননাও মাওগ্রাফৗরনি খৗথা</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />“স্বৗর্গৗ রাইজৗয়া সাছে হুনি মালিক বাদি জাইয়া গাওনি আংগুর বাগানাও খামলা মাওগ্রাফৗরখৌ মাওহৗনৗ ফুংজানি বাইরাও থাংদৗং। <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />বিয়ৗ বিছৗরনৗ সানছেনি দিনারী<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">গ্রীক ভাষাও: “মৗনছে দীনাররা”, জাবায় সাছে খামলা মাওগ্রানি সানছেনি হাজিরানি টাকা।</char></note> সমান হৗনৗ রাজি জানানৈ গাওনি আংগুর বাগানাও থৗনহৎবায়। <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />আরৗ বিয়ৗ ফুংনি নয় বাজিয়াও বাইরাও থাংনানৈ মানসিখৌ মাওয়া দাঙা হাঠাইসালিয়াও গছংদলাবায় থানায় নুদৗং। <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />বিয়ৗ বিছৗরখৌ রাইঠিবায়, ‘নৗংছৗরবৗ আংনি আংগুর বাগানাও থাংনানৈ মাওহৈদৗ, নৗংছৗরৗ মৗননাংগৌ বাদি মাওনায়নি নংথারগৌখৌ মুজুরি আং নৗংছৗরনৗ হৗনায়।’ <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />বিছৗরৗ থাংনানৈ, বিয়ৗ সানজুফু সমাও আরৗ বেলাছেনি তিনটা সমাও আরবাও অৗংখাৎলাংনানৈ বেবাদিনৗ খৗলামবাওবায়। <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />আরৗ বেলাছেনি পাঁচটা সমাওবৗ বিয়ৗ বাইরাও থাংনানৈ খাইছে মানসিফৗরখৌ গছংলাবাইনায় থানায় মৗনহৈদৗং, সৗংবায়, ‘নৗংছৗরৗ মানৗ মুংবৗ মাওয়া দাঙা বিয়াও সানছেমানি গছংদলাবায় থাদৗং?’<verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />বিছৗরৗ বুংফিনদৗং, ‘মানৗনা জৗংনৗ রাওবৗ খামানিখৌনৗ হৗয়া।’ বিয়ৗ বিছৗরখৌ হৗনবায়, ‘নৗংছৗরবৗ আংনি আংগুর বাগানাও থাংনানৈ মাওহৈদৗ।’ <verse eid="MAT 20:7" /><verse number="8" style="v" sid="MAT 20:8" />জেব্লা বেলাছি ছফৈয়ৗ, অব্লা আংগুর বাগাননি গিরিআ গাওনি খামানি নায়গ্রাখৌ লিংহৎনানৈ হৗনবায়, ‘থাংনানৈ মুজুরি মাওগ্রাফৗরখৌ লিংহৎনানৈ উনাও মাওফৈনায়নিফ্রায় লাগাছেন সিগাং মাওফৈজেননায়সিম বিছৗরনৗ হৗনাংগৌ মজুরিখৌ হৗদৗ।’ <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />জাইফ্রা বেলাছি পাঁচটা সমাও ফৈনান মাওফৈনায়ফ্রা, বিছৗর সাফ্রৗমবৗ এক দিনারী মৗনবায়। <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />জাইফ্রা সিগাং মাওফৈদৗং বিছৗরৗ ফৈনানৈ বাংসিন মৗননায় হৗনানৈ সানদৗং মৗন, নাথায় বিছৗর সাফ্রৗমবৗ মৗনছে দিনারী মৗনবায়। <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />জেব্লা বিছৗরৗ মজুরিখৌ মৗনদৗং, অব্লা বিছৗরৗ হু মালিকনি বিরুদ্ধনাও খুদ্রিনানৈ হৗনবায়। <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />জৗবথারনাইয়াও জাইফৗরখৌ মাওহৗদৗং বিছৗরৗ ঘন্টা মৗনছে বান মাওদৗং মৗন, বিছৗরৗ বুংবায়, ‘জৗঙৗ সানছেমানি সান্দুং দুংস্রেমজানানৈ মাওদৗং আরৗ নৗঙৗ বিছৗরখৌ জৗংজৗং সমান খৗলামবায়।’ <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />নাথায় বিয়ৗ বিছৗরনি সাছেখৌ বুংফিনদৗং, ‘লৗগৗ আং নৗংছৗরনি অন্যায় খৗছাইয়াখৈ, মা কি নৗঙৗ মৗনছে দিনারীয়াওনৗ মাওনৗ মানিয়াখৈমৗন? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />নৗংছৗরৗ মৗন্নাংগৌখৌ লানানৈ থাংদৗ। বে আংনি গৗসৗ, নৗংছৗরনৗ জেছে হৗদৗং বে উনাও জাইয়া মাওফৈদৗং বিনৗবৗ এছেবাং আং হৗনায়। <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />গাওনি টাকা পায়সাখৌ গাওনি গৗসৗ বাদি বাহায়নৗ আংহা একথিয়ার গৈয়া নামা? এবা আংনি গৗসৗ বাদি হৗনায়খৌ নৗংছৗর মগন ছাবায় নামা?’ <verse eid="MAT 20:15" /><verse number="16" style="v" sid="MAT 20:16" />জাইফ্রা উন বিছৗরৗ সিগাং জানায়, আরৗ জাইফ্রা সিগাং বিছৗরৗ উন জানায়।”<verse eid="MAT 20:16" /></para>
  <para style="s">যীশুআ গাওনি থৈনায়খৌ খনথামনি রাইঠিনায়</para>
  <para style="r">(<ref loc="MRK 10:32-34">মার্ক 10:32–34</ref>; <ref loc="LUK 18:31-34">লূক 18:31–34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />যিরূশালেমাও থাংনায় সমাও লামায়াও যীশুআ গাওনি বারোজন ছেলাফৗরখৌ ফাৎছেজৗং লাংনানৈ আরৗ বিছৗরখৌ হৗন্দৗং। <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“খৗনাছং, জৗঙৗ যিরূশালেমাও থাংনৗছৈ, বি জায়গাও মানসিনি বিসাহৌয়াআ গাহায় যাজকফৗর আরৗ আইন গুরুফৗরনি আখাইয়াও গথাইজানায়। বিছৗরৗ বিখৌ সিথাৎজানৗ গৗনাং দাইয়াও খৗখ্লৈনায়। <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />আরৗ গুবুনহারিফৗরনি আখাইয়াও যীশুআ গথাইজানায়, বিছৗরৗ বিখৌ ঠাট্টা খৗলামনায়, ছাবুকজৗং বুনায় আরৗ ক্রুশাও দৗখঠাবনায়; নাথায় বিয়ৗ সানথামাও জিউয়াও ঠাংখাংফিননায়।”<verse eid="MAT 20:19" /></para>
  <para style="s">সিবদিয়নি হিন্জাও খাওলাইনায়</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />বে সমাও সিবদিয়নি হিন্জাওয়া গাওনি বিসাজ্লাফৗরখৌ লৗগৗআও লানানৈ যীশুনিয়াও ফৈদৗং আরৗ হান্ঠুখরাইনানৈ খাওলাইবায় আংখৌ অনদৗ। <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />বিয়ৗ সৗংবায়, “নৗং মা বেখৌ লুবৈদৗং?” বিয়ৗ বুংবায়, “হুখুম হৗদৗ জেন আংনি বিসাজ্লা সানৈখৌ নৗংনি রাইজৗয়াও আগ্ডাজৗং সাছে আরৗ আখছিজৗং সাছে জিরাইনৗ হৗদৗ।” <verse eid="MAT 20:21" /><verse number="22" style="v" sid="MAT 20:22" />“নৗংছৗরৗ মিথিয়া, নৗংছৗরৗ মা বিদৗং,” যীশুআ বিছৗরখৌ হৗনবায়, “মা, আং যে খুরৈনিফ্রায় লৗংনৗছৈ, নৗংছৗরৗ বে সৈনাংনায়নি খুরৈখৌ লৗংনৗ হানায় নামা?” বিছৗরৗ বুংফিনবায়, “ও, জৗঙৗ হানায়।” <verse eid="MAT 20:22" /><verse number="23" style="v" sid="MAT 20:23" />যীশু বিছৗরখৌ হৗনবায়, “নৗংগৌ, নৗংছৗরৗ আংনি খুরৈনিফ্রায় লৗংনায়, নাথায় ছৗর আগডা আরৗ আখছিঠিঙে জিরাইনায়, বেখৌ সাইখনৗ আংনে একথিয়ার গৈয়া। বে জায়গাফ্রা বিছৗরনি জাইনি থাখৈ আংনি আফায়া বি জায়গাফৗর ঠাম ঠিম খৗলামদৗং।” <verse eid="MAT 20:23" /><verse number="24" style="v" sid="MAT 20:24" />বে বুংনায়খৌ খৗনানানৈ, বি সানৈ বিদা-ফংবায়খৌ গুবুন দশজন ছেলাফ্রা বৗরাবদৗং। <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />যীশুআ বিছৗর গাছেনখৌবৗ জ' লিংহৎনানৈ হৗন্দৗং, “নৗংছৗরৗ মিথিগৌ, গুবুনহারিফৗরনি রাজাআ গাওনি অধিননাও থানায়ফৗরনি ছায়াও শাসন খৗলামৗ আরৗ বিছৗরনি গেজেরাও জাইয়া গাহায় বিছৗরৗ একথিয়ারখৌ বিছৗরনি ছায়াও বাহায়ৗ <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />নাথায় নৗংছৗরনিয়াও বেবাদি জানায় অৗঙা। নৗংছৗরনি গেজেরাও ছৗরবায়া গেদেৎ জানৗ লুবৈয়ৗব্লা, বিয়ৗ গুবুননি দাস জানাংথারনাংনায় <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />আরৗ জাইয়া সিগাং জানৗ হাস্থায়ৗ বিয়ৗ নৗংছৗরনি দাস জাথারনাংনায়। <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />মানৗনা মানসিনি বিসাহৌয়াআ সেবা খৗলামজানৗ ফৈয়াখৈ, নাথায় গুবুনখৌ সেবা খৗলামনৗ আরৗ গাওনি জিউখৌ হৗনানৈ গৗবাং মানসিফৗরখৌছৗ বাছাইনৗ ফৈদৗং।”<verse eid="MAT 20:28" /></para>
  <para style="s">সানৈ খানাখৌ গুনু খৗলামনায়</para>
  <para style="r">(<ref loc="MRK 10:46-52">মার্ক 10:46–52</ref>; <ref loc="LUK 18:35-43">লূক 18:35–43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />গাওনি ছেলাফৗরখৌ লানানৈ যীশুআ জেব্লা যিরীহোনিফ্রায় অৗংখাৎলাঙৗ, অব্লা গেদেৎ ভিড়য়া বিছৗরজৗং থাংফাদৗং। <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />বি সমাও লামা সেরাও জিরাইনান থানায় সানৈ খানায়া যীশুখৌ ফৈদৗং হৗনানৈ খৗনাগ্রৗমৗনা গাবজ্রিনানৈ বুংদৗং, “ফৗরবু, দায়ুদনি বিসাজ্লা জৗংখৌ অনখাংদৗ!” <verse eid="MAT 20:30" /><verse number="31" style="v" sid="MAT 20:31" />হান্জাআ বিছৗরখৌ রাইনানৈ সিরি থাহৗনৗ হাস্থায়দৗংমৗন, নাথায় বিছৗরৗ গৗব্রাবমৈ বেবাদি গাবজ্রিদৗং, “ও ফৗরবু, দায়ূদনি বিসাজ্লা, জৗংখৌ অনখাংদৗ!” <verse eid="MAT 20:31" /><verse number="32" style="v" sid="MAT 20:32" />যীশুআ গছংফৗথানানৈ বিছৗরখৌ লিংহৎদৗং, আরৗ সৗংবায়, “নৗংছৗরনি থাখৈ আংখৌ মা মাওজানৗ গৗসৗ জায়ৗ?” <verse eid="MAT 20:32" /><verse number="33" style="v" sid="MAT 20:33" />বিছৗরৗ বুংফিনদৗং, “ফৗরবু, জৗঙৗ মগন নুনৗ লুবৈয়ৗ।” <verse eid="MAT 20:33" /><verse number="34" style="v" sid="MAT 20:34" />যীশুআ বিছৗরখৌ অন্নানৈ বিছৗরনি মগনফৗরাও দাংদৗং, আরৗ বে সমাওনৗ বিছৗরৗ মগন নুনানৈ যীশুজৗং থাংফাদৗং।<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">জৈ হৗনানৈ যিরূশালেমাও হাবনায়</para>
  <para style="r">(<ref loc="MRK 11:1-11">মার্ক 11:1–11</ref>; <ref loc="LUK 19:28-40">লূক 19:28–40</ref>; <ref loc="JHN 12:12-19">যোহন 12:12–19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />জেব্লা বিছৗরৗ যিরূশালেম খাঠিয়াও ছফৈয়ৗ আরৗ অলিব হাজৗয়াও বৈৎফগী গামিয়াও ফৈয়ৗ অব্লা যীশুআ ছেলাফৗরনি গেজেরনিফ্রায় সানৈখৌ থৗনহৎবায়, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />বিছৗরখৌ বেবাদি বুংনানৈ, “নৗংছৗরৗ হোবে মৗখাংনি নুহৗৎনায় গামিয়াও থাং, বেয়াও হাবহৈমাৎনৗ মাছে গাদা খানানৈ দৗন্নায় মৗনহৈনায়, বেজৗং লৗগৗয়াও মাছে গাধা বিসা দং। বেফৗরখৌ খেওনানৈ আংনিয়াও লাবৗ। <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />ছৗরবাফৗর নৗংখৌ সৗঙৗব্লা, মা খৗলামনৗ হৗন্নানৈ, নৗংছৗরৗ বুংফিন যে, ফৗরবুনৗ বেখৌ নাংগৌ, অব্লানৗ বিয়ৗ বেফৗরখৌ নৗংছৗরনৗ হৎনায়।” <verse eid="MAT 21:3" /><verse number="4" style="v" sid="MAT 21:4" />নবিজৗং বুংখাজানায় বে খৗথাফ্রা জাফুংনাংগৌখায় বেফৗরৗ জাবায়। <verse eid="MAT 21:4" /><verse number="5" style="v" sid="MAT 21:5" />“নৗছৗরৗ সিয়োননি বিসাজৗখৌ বুং, হনৈ নাইহৎ, নৗংছৗরনি রাজায়া নৗংছৗরনিয়াও গাদাও ফৈগৌ, বিয়ৗ গুরৈ আরৗ গাধা বিসানি ছায়াও গাখৗনানৈ<note caller="+" style="x"><char style="xo" closed="false">21:5 </char><char style="xt" closed="false"><ref loc="ZEC 9:9">সখরিয়া 9:9</ref> </char></note> ফৈগৌ।” <verse eid="MAT 21:5" /><verse number="6" style="v" sid="MAT 21:6" />আরৗ ছেলাফ্রা থাংনানৈ যীশুআ জেরৈ থৗনদৗংমৗন, বিছৗরৗ বেবাদিনৗ মাওহৈবায়। <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />আরৗ বিছৗরৗ গাধা আরৗ গাধা বিসাখৌ যীশুনিয়াও লাবৗবায় আরৗ গাওছৗরনি সি'ফৗরখৌ বিখুং ছায়াও বনানৈ যীশুখৌ জিরাইহৗবায়। <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />গেদেৎ ভিড়নি খাইছে গাওছৗরনি সি'ফৗরখৌ আরৗ খাইছে বিংফাং ডালাইফৗরখৌ দাননান লাবৗনানৈ লামায়াও ব-নানৈ হৗবায়। <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />যে ভিড়ফ্রা বিনি সিগাং আরৗ উন উন থাবায়লাংফাদৗং, বিছৗরৗ বেবাদি গাবজ্রি গাবজ্রি বুংদৗং, “হোশান্না দায়ুদনি বিসাজ্লাখৌ! <note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="ft" closed="false">হোশান্না জাবায় মৗনছে ইব্রায়ি সৗদৗব বেনি অৗংথিয়া জাবায় “ঈশ্বৗরখৌ বাখৗনাইনায়”</char></note> ধন্য বিয়ৗ জাইয়া ফৗরবুনি নামমৈ ফৈগৌ। হোশান্না স্বৗর্গৗনি গৗজৌসিনথারাও!” <verse eid="MAT 21:9" /><verse number="10" style="v" sid="MAT 21:10" />জেব্লা যীশুআ যিরূশালেমাও হাবহৈদৗং, অব্লা নৗগৗরনি মানসিফ্রা হুলুস থুলুস জালাইদৗং আরৗ সৗংদৗং, “বে ছৗর জাখৗ?” <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />ভিড়য়া বুংফিনদৗং, “বে যীশু, গালীলনি নাসরৎনিফ্রায় ফৈনায় নবি।”<verse eid="MAT 21:11" /></para>
  <para style="s">যীশুআ মন্দিরাও</para>
  <para style="r">(<ref loc="MRK 11:1-11">মার্ক 11:1–11</ref>; <ref loc="LUK 19:28-40">লূক 19:28–40</ref>; <ref loc="JHN 12:12-19">যোহন 12:12–19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />যীশুআ মন্দিরাও হাবনানৈ গাছেন বায়গ্রা-ফানগ্রাফৗরখৌ বাইরাও হোয়নদৗং, আরৗ বিয়ৗ টাকা সৗলাইগ্রাফৗরনি টেবিল আরৗ ফারৗও ফানগ্রাফৗরনি জিরাইগ্রাফৗরখৌ নাৎখ্লাই-নাৎছি খৗছামদৗং। <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />আরৗ বিছৗরখৌ বিয়ৗ বুংয়াছৈ, “শাস্ত্রয়াও বেবাদি লিৎনায় দং, ‘আংনি মন্দিরা প্রার্থনা খৗলামগ্রা ন্ব'জানায়,’<note caller="+" style="x"><char style="xo" closed="false">21:13 </char><char style="xt" closed="false"><ref loc="ISA 56:7">যিশাইয় 56:7</ref> </char></note> নাথায় নৗংছৗরৗ বে ন্ব'খৌ ‘সিখাও-ডাখুফৗরনি গুফাছৗ খৗলামবায়।’” <verse eid="MAT 21:13" /><verse number="14" style="v" sid="MAT 21:14" />খানা আরৗ লেংগ্রাফ্রা মন্দিরাও বিনিয়াও ফৈদৗং, আরৗ বিয়ৗ বিছৗরখৌ ছৗখাদৗং। <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />বিনি সৗমৗ গৗনাং খামানিফৗরখৌ নুনানৈ আরৗ মন্দির সিঙাও, “হোশান্না দায়ুদনি বিসাজ্লা,” হৗন্নানৈ গথ'ফৗরনি গাবজ্রিনায়খৌ খৗনানানৈ গাহায় যাজকফৗর আরৗ আইন গুরুফ্রা ইনায়নৗ রাগ জৗংদৗং। <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />বিছৗরৗ বিখৌ সৗংদৗং, “বে গথ'ফ্রা মা হৗনদৗং নৗং খৗনাবায় না?” যীশুআ বুংফিনদৗং, “ও, নৗংছৗরৗ শাস্ত্রখৌ মাব্লাবাবৗ পড়ায়াখৈ না, ‘উন্দৈ গথ'ফৗর আরৗ গৗল্লৈ গথ'ফৗরনি খুগানিফ্রায় বাখনাইনায়খৌ <note caller="+" style="x"><char style="xo" closed="false">21:16 </char><char style="xt" closed="false"><ref loc="PSA 8:2">গীতফৗর 8:2</ref> </char></note>জাখাংহৗবায়।’” <verse eid="MAT 21:16" /><verse number="17" style="v" sid="MAT 21:17" />আরৗ বিছৗরখৌ নাগারনানৈ যীশুআ নৗগৗরনিফ্রায় বৈথনিয়াও থাংনানৈ হর থাহৈদৗং।<verse eid="MAT 21:17" /></para>
  <para style="s">ফাংছে ডুমরি বিংফাংখৌ সাও হৗনায়</para>
  <para style="r">(<ref loc="MRK 11:12-14">মার্ক 11:12–14</ref>,<ref loc="MRK 11:20-24">20–24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />ফুংজামাৎনিন যীশুআ নৗগৗরাও ফৈফিননাইয়াও উখৈদৗং মৗন। <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />আরৗ ডুমরি বিংফাং ফাংছে লামা সেরাও নুনানৈ বিনি খাঠিয়াও থাংনানৈ নাইদৗং মৗন নাথায় বিলাই ছাড়া জেবৗ মৗনাখৗছৈ, যীশুআ বিংফাংখৌ হৗনবায়, “দানিফ্রায় মাব্লাবাবৗ বিথাই দাথাইথৗংছৈ।” ঠাবনৗ ডুমরি বিফাঙা রাননাছৈ। <verse eid="MAT 21:19" /><verse number="20" style="v" sid="MAT 21:20" />বেখৌ নুনানৈ ছেলাফ্রা সৗমৗ নাংদৗং, আরৗ বিছৗরৗ সৗংবায়, “মাব্রৈ ডুমরি বিংফাংয়া গৗখ্রৈ রানখৗ?” <verse eid="MAT 21:20" /><verse number="21" style="v" sid="MAT 21:21" />যীশুআ বিছৗরখৌ বুংফিনবায়, নংথারগৌয়ৈ আঙৗ নৗংছৗরখৌ বুঙৗ, “গৗনৗ গৗথৗ জায়াজাছে নৗংছৗরৗ ফৗথাইয়ৗব্লা, আং জেরেই ডুমরি বিংফাংনি ছায়াও মাওদৗং বেবাদি বান হানায়, বে অৗঙা, নাথায় বে হাজৗখৌ বেবাদি বুঙৗব্লা, গুবুনানৈ লৈথৗয়াও গৗগ্লৈহৈ, অব্লা জেরৈ থৗন্দৗং, অৗরৈনৗ জাথারনাংনায়। <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />নৗংছৗরৗ ফৗথাইয়ৗব্লা, নৗংছৗরৗ জেখৌ প্রার্থনাজৗং বিনায় বেখৌনৗ মৗননায়।”<verse eid="MAT 21:22" /></para>
  <para style="s">যীশুনি একথিয়ারখৌ সৗংনায়</para>
  <para style="r">(<ref loc="MRK 11:27-33">মার্ক 11:27–33</ref>; <ref loc="LUK 20:1-8">লূক 20:1–8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />যীশুআ মন্দিরয়াও হাবনানৈ আরৗ জেব্লা ফৗরৗংদৗংমৗন, বি সমাও গাহায় যাজকফ্রা, আরৗ প্রাচীনফৗরা বিনিয়াও ফৈদৗং। আরৗ বিছৗরৗ বেবাদি সৗংদৗং, “বেফৗর খামানিফৗরখৌ নৗঙৗ ছৗরনি একথিয়ারজৗং মাওদৗং? বে একথিয়ারখৌ ছৗর নৗংনৗ হৗখৗ?” <verse eid="MAT 21:23" /><verse number="24" style="v" sid="MAT 21:24" />যীশুআ বুংফিনবায়, “আঙৗ নৗংছৗরখৌ মৗনছে প্রশ্ন সৗংনায়ছৈ, আংনৗ উওর হৗছায়, অব্লাছৗ আংবৗ নৗংছৗরনৗ খৗথানায়, ববে একথিয়ারজৗং আঙৗ বেফৗরখৌ মাওদৗং। <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />যোহননি বাপ্তিস্মা হৗনায়নি একথিয়ারখৌ বিয়ৗ ঈশ্বৗরনিফ্রায় না, মানসিনিফ্রায় মৗননায়নিমৗন?” বিছৗরৗ গাওজৗং গাও রাইজ্লাইনৗ হমদৗং, আরৗ বুংদৗং, “জৗঙৗ বুংফিনৗব্লা, ‘স্বৗর্গৗনিফ্রায়,’ বিয়ৗ হৗন্নায়, ‘অব্লা নৗংছৗরৗ মানৗ বিখৌ ফৗথাইয়াখৈ?’ <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />নাথায় জৗঙৗ হৗনৗব্লা, ‘মানসিনিফ্রায়,’ অব্লা জৗংনে মানসিফৗরখৌ গিদৗং, মানৗনা যোহনখৌ বয়বৗ নৗংগৌ সাছে নবি হৗন্নানৈ মানিবৗদৗংমৗন।” <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />বিনিখাইনৗ বিছৗরৗ যীশুখৌ বুংফিনবায়, “জৗঙৗ মিথিয়া।” অব্লা বিয়ৗ হৗনবায়, “আংবৗ নৗংছৗরনৗ খৗথায়া ববে একথিয়ারজৗং আঙৗ বেফৗরখৌ মাওদৗং।<verse eid="MAT 21:27" /></para>
  <para style="s">সানৈ বিসাজ্লানি দৃষ্টান্ত</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />“নৗংছৗরৗ মা সান্নৗ? দাবছে জায়গায়াও সাছে মানসিনে সানৈ বিসাজ্লা দংমৗন। বিয়ৗ বিসাজ্লা গিবিনিয়াও থাংনানৈ বুংবায়, ‘বিসা, থাং, দিনৈ আংগুর বাগাননাও মাওহৈদৗ।’ <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />বিয়ৗ বুংফিনদৗং, ‘আং মাওহৈয়া,’ নাথায় বিয়ৗ উনাও সানফিন্নানৈ থাংদৗং। <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />বিনি উনাও বে মানসিয়া বিসাজ্লা গদাইনিয়াও থাংনানৈ গিবিখৌ জেরৈ থৗনদৗংমৗন, বিখৌবৗ বেবাদিনৗ বুংবায়। বিয়ৗ উত্তর হৗবায়, ‘দে মানিনাং নৗংথাং আং মাওহৈনায়,’ নাথায় বিয়ৗ থাংয়াখৗছৈ। <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />অব্লা বে মানসিনি বিসাজ্লা সানৈনি গেজেরাও বিফানি লুবৈনাইখৌ ছৗর মাওখৗ?” বিছৗরৗ বুংফিনবায়, “গিবিয়া।” যীশুআ বিছৗরখৌ বুংবায়, “নংথারগৌয়ৈ আঙৗ নৗংছৗরখৌ বুঙৗ, খাজনা খাংগ্রাফৗর আরৗ নৗঠি হিন্জাওফ্রা নৗংছৗরনি সিগাং ঈশ্বৗরনি রাইজৗয়াও হাবহৈগ্রৗনায়। <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />মানৗনা যোহননা নৗংছৗরনৗ ধৗরৗমনি লামাখৌ দিন্ঠিনৗ ফৈদৗংমৗন, আরৗ নৗংছৗরৗ বিখৌ ফৗথায়াখৈ; নাথায় খাজনা খাংগ্রাফৗর আরৗ নৗথি হিন্জাওফ্রা ফৗথাইদৗং। বেখৌ নুনানৈবৗ নৗংছৗরৗ গৗসৗ সৗলায়াখৈ আরৗ ফৗথায়াখৈ।<verse eid="MAT 21:32" /></para>
  <para style="s">আংগুর বাগানাও আদিয়ারিফৗরনি দৃষ্টান্ত</para>
  <para style="r">(<ref loc="MRK 12:1-12">মার্ক 12:1–12</ref>; <ref loc="LUK 20:9-19">লূক 20:9–19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />“গুবুন মৗনছে দৃষ্টান্তখৌ খৗনাছং;<note caller="+" style="f"><char style="fr" closed="false">21:33 </char><char style="ft" closed="false">বে দৃষ্টান্ত খৗথাজৗং যিহূদীয়ারিফৗরনি গরন্থিখৌ দিন্ঠিনায় জাদৗং। বেয়াও আংগুর বাগাননি বৈগৗমায়া জাবায় ঈশ্বৗর, আংগুর বাগাননা জাবায় ইস্রায়েল হাদৎ আরৗ বিয়াওনি মানসিফৗর। আবাদ মাওগ্রাফ্রা জাবায় ধৗরৗমগুরুফৗর, দৈদেনগিরিফৗর আরৗ যিহূদীয়ারিনি দৈদেনগিরিফৗর। দাসফ্রা জাবায় নবিফৗর, জাইফৗরখৌ ঈশ্বৗরা থৗনহৎদৗংমৗন। বৈগৗমানি বিসাজ্লাআ জাবায় যীশু। </char></note> সাছে মানসিয়া মৗনছে আংগুর বাগান খৗলামনানৈ সৗরগিদিং বারি দুমনানৈ আংগুর বিথাই ফেরেথনৗ মৗনছে হাখোর জাওবায় আরৗ গংছে গৗজৗও নেগ্রা টং লুবায়। বিনি উনাও আবাদ মাওগ্রাফৗরনৗ বিয়ৗ আদি হৗনানৈ গাও গুবুন হাদৎনাও থাংবায়। <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />জেব্লা বিথাই বুথুমনায় বৗথৗরা ছফৈয়ৗ, অব্লা বিয়ৗ গাওনি মৗননাংগৌ বিথাইখৌ আদিয়ারিফৗরনিফ্রায় লায়নৗ দাসফৗরখৌ থৗনহৎবায়। <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />নাথায় আদিয়ারিফ্রা বিনি দাসফৗরনি সাছেখৌ বুদৗং, সাছেখৌ সিথাৎদৗং, আরৗ গুবুন সাছেখৌ অন্ঠাইজৗং খুবৈথাৎদৗং। <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />অব্লা বৈগৗমায়া আরবাও, সিগাংনিখুরৈ বাংসিন দাসফৗরখৌ থৗনহৎবাওবায়; নাথায় আদিয়ারিফ্রা বিছৗরনি ছায়াওবৗ সিগাংনি বাদিনৗ ব্যাবহার খৗলামদৗং। <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />জৗবথারনাইয়াও বিয়ৗ গাওনি বিসাজ্লাখৌ বিছৗরনিয়াও থৗনহৎদৗং, মানৗনা বিয়ৗ সানদৗং মৗন, ‘নংথারগৌয়ৈ আংনি বিসাজ্লাখৌ বিছৗরৗ মানহৗনায়।’ <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />নাথায় আদিয়ারিফ্রা জেব্লা বৈগৗমানি বিসাজ্লাখৌ নুয়ৗ অব্লা বিছৗরৗ গাওজৗং গাও বেবাদি হৗনজ্লাইদৗং, ‘বৈগৗমানি ওয়ারিশা বেনৗ, দে জৗং বিখৌ সিথাৎদৗনি, অব্লা বিনি সম্পত্তিনি মালিকআ জৗংনৗ জানায়।’ <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />বিনিখাইনৗ বিছৗরৗ বিখৌ লাংনানৈ আংগুর বাগাননি বাইরায়াও গারহৗৎনাছৈ আরৗ বিখৌ সিথাৎনাছৈ।” <verse eid="MAT 21:39" /><verse number="40" style="v" sid="MAT 21:40" />যীশুআ বিছৗরখৌ সৗংবায়, “বিনিখাইনৗ, জেব্লা আংগুর বাগাননি বৈগৗমায়া ফৈয়ৗ, অব্লা বিয়ৗ আদিয়ারিফ্রাখৌ মা খৗলামনায়?” <verse eid="MAT 21:40" /><verse number="41" style="v" sid="MAT 21:41" />বিছৗরৗ বুংফিনবায়, “বে অন্যায় মাওনায় মানসিফৗরখৌ ফৗজৗবনায়, আরৗ জাইফ্রা আবাদ মৗননাংগৌ বৗথৗরাও বিনৗ ভাগা হৗনায়, আরৗ বিয়ৗ বে আংগুর বাগানখৌ গুবুন আদিয়ারিফৗরনৗ আদিহৗনায়।”<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />যীশুআ বিছৗরখৌ হৗনবায়, “মা কি নৗংছৗরৗ গৗথার শাস্ত্রয়াও লিৎনায় বে খৗথাখৌ ফরাইয়াখৈ! ‘ন্ব' লুগ্রা রাজমিস্ত্রিফৗরজৗং গারজানায় অন্ঠাইয়ানৗ বৈনিখুরৈ নাংথারগৌ গাইজেন্নায় খণানি গাহায় অন্ঠাই জাবায়। বেখৌ ফৗরবুআনৗ মাওবায়; আরৗ জৗংনি নুনাইয়াও বে, বেছেগ্রাব সৗমৗ গৗনাং।’<note caller="+" style="x"><char style="xo" closed="false">21:42 </char><char style="xt" closed="false"><ref loc="PSA 118:22">গীতফৗর 118:22</ref>,<ref loc="PSA 118:23">23</ref> </char></note> <verse eid="MAT 21:42" /><verse number="43" style="v" sid="MAT 21:43" />বিনিখাইনৗ আং নৗছৗরখৌ হৗন্নৗ যে ঈশ্বৗরনি রাইজৗয়া নৗংছৗরনিফ্রায় বৗখাৎনানৈ মৗজাং বিথাই থাইহৗনৗ হানায় মানসিনৗ হৗয়া জানায়। <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />বি অন্ঠাইনি ছায়াও জাইয়ানৗ গৗগ্লৈনায়, বিনৗ বাইগ্লিনায়; আরৗ জাইনি ছায়াও বে অন্ঠাইয়া গৗগ্লৈনায়, বিয়ৗ গেব্লেনায়।”<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />জেব্লা গাহায় যাজকফ্রা আরৗ ফরীশীফ্রা যীশুনি বুংনায় বে দৃষ্টান্তখৌ খৗনায়ৗ অব্লা বিছৗরৗ মিথিবায় বিয়ৗ বিছৗরনি বিষয়ৈ বুংদৗং। <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />বিছৗরৗ যীশুখৌ হমনৗ থাখৈ খাইদা নাগিৎদৗংমৗন, নাথায় বিছৗরৗ ভিড়খৌ গিদৗংমৗন মানৗনা মানসিফ্রা যীশুখৌ নবি হৗনানৈ মানিয়ৗমৗন।<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">হাবানি ভজনি দূষ্টান্ত</para>
  <para style="r">(<ref loc="LUK 14:15-24">লূক 14:15–24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />যীশুআ আরবাও দৃষ্টান্তনি গেজেরজৗং বিছৗরখৌ বুংবাওবায়, <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />“স্বৗর্গৗরাইজৗয়া বেবাদিনৗ সাছে রাজানি বাদি, জাইয়া গাওনি বিসাজ্লানি হাবানি ভজ ঠাম ঠিম খৗলামদৗং। <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />বিয়ৗ গাওনি হাংখ্রাইজানায় আলাসিফৗরখৌ লিংনানৈ লাইনৗ থাখৈ গাওনি দাসফৗরখৌ থৗনহৗৎদৗং আরৗ বিয়ৗ বেবাদি হৗনহৈদৗং, ‘দানৗ ফৈদৗ, গাছৈবৗ ঠাম ঠিম জাবায়।’ নাথায় বিছৗরৗ ফৈনৗ নাগিৎনাখৗছৈ। <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />বিনিখাইনৗ গাওনি গুবুন দাসফৗরখৌ হাংখ্রাইজানায় আলাসিফৗরনিয়াও থৗনহৎবাওনানৈ আরৗ বুংবায়, ‘যে ভোজয়া ঠাম ঠিম জাবায়, আংনি মৗসৌ বলদফৗর আরৗ গুফুং গুফুং জুনারফৗরখৌ সিথাৎবায়, আরৗ গাছেনবৗ ঠাম ঠিম জাখাবায়, হাবানি ভজয়াও ফৈদৗ।’ <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />নাথায় হাংখ্রাইজানায় আলাসিফ্রা খৗনাছংয়ামাৎনিন গাওবা গাও খামানিয়াও থাংবায় গাওনি হুয়াও, সাছেয়া গাওনি বায়নায় ফান্নায় হাবায়াও, <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />আরৗ গুবুনফ্রা বিনি দাসফৗরখৌ অপমান খৗছামবায় আরৗ সিথাৎবায়। <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />রাজায়া বেখৌ খৗনানানৈ বিরাঠ রাগ জৗংদৗং, আরৗ দাওহা নাংগ্রাফৗরখৌ থৗনহৎনানৈ সিথাৎগ্রাফৗরখৌ সংহার খৗলামদৗং, আরৗ বিছৗরনি নৗগৗরখৌ সাওদৗং। <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />আরৗ বিয়ৗ গাওনি দাসফৗরখৌ লিংহৎনানৈ হৗনবায়, ‘হাবানি ভোজয়া ঠাম ঠিম জাখাবায়, নাথায় আংজৗং হাংখ্রাইজানায় আলাসিফ্রা ভোজয়াও নাজাও জাথাওথাও অৗঙা। <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />বিনিখাইনৗ লামা খনাফৗরাও থাংনানৈ নৗংছৗর মৗন্নায় মানসিফৗরখৌনৗ হাবানি ভোজয়াও লিংনানৈ লাবৗদৗ।’ <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />বিনিখাইনৗ থৗনজানায় বাদি দাসফ্রা লামাফৗরাও থাংনানৈ মৗজাং গাজ্রি গাছেন মানসিফৗরখৌ জ'খৗলামবায় আরৗ হাবানি ন্ব'য়া আলাসিফৗরজৗং বুংফববায়। <verse eid="MAT 22:10" /><verse number="11" style="v" sid="MAT 22:11" />নাথায় জেব্লা রাজায়া হাবাসালি সিঙাও হাবনানৈ আলাসিফৗরখৌ নাইয়ৗ, অব্লা বিয়ৗ হাবানি সি'ফৗর গাননি সাছে মানসিখৌ নুদৗং। <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />আরৗ রাজায়া বিনিয়াও সৗংবায়, ‘ও লৗগৗ, হাবানি সি'ফৗর গান্নামাৎনিন নৗঙৗ বেহা মাব্রৈ হাবফৈনৗ মৗনখৗ?’ নাথায় মানসিয়া জেবৗ বুংফিনাখৗছৈ। <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />অব্লা রাজায়া গাওনি দাসফৗরখৌ বেবাদি হুখুম হৗদৗং, ‘বে মানসিখৌ আঠেং আখাই খাখ্রবনানৈ বাইরানি খৗমসিয়াও গারহৈদৗ। জেরৗও বিহা গাবনায় আরৗ হাথাই অফ্রেনায় জানায়।’ <verse eid="MAT 22:13" /><verse number="14" style="v" sid="MAT 22:14" />মানৗনা গৗবাং মানসিফ্রা হাংখ্রাইজাদৗংমৗন, নাথায় ইছে বান মানসিফৗর সাইখজাবায়।”<verse eid="MAT 22:14" /></para>
  <para style="s">খাজনা হৗনায়নি খৗথা সৗংনায়</para>
  <para style="r">(<ref loc="MRK 12:18-27">মার্ক 12:18–27</ref>; <ref loc="LUK 20:27-40">লূক 20:27–40</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />অব্লা ফরীশীফ্রা বিনিফ্রায় থাংনানৈ যীশুখৌ মাব্রৈ খৗথাজৗং ফান্দাইনৗ হানায় বিনি খাইদা খৗলামদৗং। <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />বিছৗরৗ গাওনি ছেলাফৗরখৌ হেরোদীয়নি দলনি খাইছে মানসিফৗরজৗং বিনিয়াও থৗনহৎবায়। আরৗ বিছৗরৗ হৗনবায়, “ও ফৗরৗংগুরু, জৗঙৗ মিথিগৌ, নৗঙৗ সাছে সৈথৗ মানসি আরৗ গুবুনফৗরনি বুংনায়খৌ জেবৗ সান্নাজাছে নৗঙৗ নৗংথারগৌখৌ রাইঠিয়ৗ। নৗং গেদেৎ উন্দৈ মৗখাং নায়াজাছে ঈশ্বৗরনি নৗংগৌখৌ ফৗরৗঙৗ। <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />অব্লা জৗংনৗ খৗথাছায়, নৗংনি সান্নাইয়া মা? র'মারিনি গেদেৎ রাজা কৈসরনৗ খাজনা হৗনাইয়া আইন বাদি হামগৌ না হামা? জৗং হৗনাগৌ না হৗনাঙা?” <verse eid="MAT 22:17" /><verse number="18" style="v" sid="MAT 22:18" />নাথায় যীশুআ বিছৗরনি গাজ্রি ফান্দাইনৗ সাননায়খৌ মিথিনানৈ হৗনবায়, “ও দিন্ঠিফ্লাগ্রাফৗর নৗংছৗর, মানৗ আংখৌ খৗথাজৗং ফান্দাইনৗ হাস্থাইদৗং? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />বি খাজনানি পায়সাখৌ আংনৗ দিন্ঠিছায়,” থৗনজানায় বাদি বিছৗরৗ থাইছে রুপানি পায়সাখৌ লাবৗনানৈ হৗফৈবায়। <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />আরৗ বিয়ৗ বিছৗরখৌ সৗংবায়, “বে ছৗরনি মহর জাখৗ? আরৗ ছৗরনি নামমাও?” <verse eid="MAT 22:20" /><verse number="21" style="v" sid="MAT 22:21" />বিছৗরৗ বুংফিনবায়, “কৈসরনি।” অব্লা যীশুআ বিছৗরখৌ হৗনবায়, “দে, কৈসরনিখৌ কৈসরনৗ আরৗ ঈশ্বৗরনিখৌ ঈশ্বৗরনৗ হৗ।” <verse eid="MAT 22:21" /><verse number="22" style="v" sid="MAT 22:22" />জেব্লা বেখৌ বিছৗরৗ খৗনায়ৗ, অব্লা বিছৗরৗ সৗমৗ নাংদৗং আরৗ বিখৌ নাগারনানৈ থাংদৗং।<verse eid="MAT 22:22" /></para>
  <para style="s">ঠাংখাংফিন্নায়নি খৗথা</para>
  <para style="r">(<ref loc="MRK 12:18-27">মার্ক 12:18–27</ref>; <ref loc="LUK 20:27-40">লূক 20:27–40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />বি দিননাওনৗ থৈনায়নিফ্রায় ঠাংখাংফিন্নায় গৈয়া হৗনগ্রা সদ্দূকীফ্রাবৗ যীশুনিয়াও থাংনানৈ প্রশ্ন সৗংবায়। <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />বিছৗর বুংবায়, “ও ফৗরৗংগুরু, মোশিয়া জৗংখৌ বুংদৗং, ‘ছৗরবায়া হিন্জাও হাবা খৗলামনানৈ বিসা মৗনালাবা থৈব্লা, বিনি থালাংনায় হিন্জাওখৌ বে থৈনায় মানসিনি ফংবাইয়া হাবা খৗলামনানৈ গাওনি বিদানি জৗলৈ লাখিনৗ নাংগৌ।’ <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />হমনানৈ লা, মৗনছে জাইগায়াও সাত জন বিদা-ফংবায়ফৗর দৗংমৗন; গিবিয়া হাবা খৗলামনানৈ বিসা মৗনামাৎনিন থৈদৗং। অব্লা বিনি আন্জাইয়া বিদানি থালাংনায় রান্ডি হিন্জাওখৌ হাবা খৗলামনানৈ লাদৗং, <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />বিবৗ বিসা মৗনামাৎনিন থৈদৗং, আরৗ বিনি আন্জাইনেবৗ বেবাদিনৗ জায়াছৈ, আরৗ আন্জাই সাতজননাবৗ বিখৌ হাবা খৗলামাছৈ। <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />জৗবনাইয়াও হিন্জাওআবৗ থৈদৗং। <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />অব্লা দা, থৈনানৈ ঠাংখাংফিন্নায় সমাও বি হিন্জাওআ ছৗরনি জানায়? মানৗনা সাত জন বিদা ফংবায়ফ্রা বি হিন্জাওখৌনৗ হাবা খৗলামদৗং মৗন।” <verse eid="MAT 22:28" /><verse number="29" style="v" sid="MAT 22:29" />যীশুআ বিছৗরখৌ বুংফিনদৗং, “নৗংছৗরৗ গৗরৗন্ঠিয়াও দং! মানৗনা, নৗংছৗর শাস্ত্রখৌবৗ আরৗ ঈশ্বৗরনি বৗলৗখৌবৗ মিথিয়া। <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />জেব্লা মানসিফ্রা ঠাংখাংফিননায়, অব্লা বিছৗরৗ হাবা খৗলামনায় অৗঙা আরৗ হাবাবৗ হৗজানায় অৗঙা, বি সমাও বিছৗরৗ স্বৗর্গৗনি আরফ'ফৗর বাদি জানায়। <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />নাথায় থৈনাইনিফ্রায় ঠাংখাংফিন্নায়নি বিষয়ৈ ঈশ্বৗররা মা হৗন্দৗং নৗংছৗরৗ ফরাইফেৎনাখৈ নামা? <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />বিয়ৗ বুংদৗং ‘আঙৗ অব্রাহামনি ঈশ্বৗর, ইসাহাকনি ঈশ্বৗর, আরৗ যাকোবনি ঈশ্বৗর’? বিয়ৗ গৗথৈফৗরনি ঈশ্বৗর অৗঙা, নাথায় গৗঠাংফৗরনি।” <verse eid="MAT 22:32" /><verse number="33" style="v" sid="MAT 22:33" />জেব্লা ভিড়রা বে খৗথাখৌ খৗনায়ৗ, আরৗ বিনি ফারৗংনাইফৗরাও সৗমৗ নাংদৗং।<verse eid="MAT 22:33" /></para>
  <para style="s">দেৎসিন আদেশ</para>
  <para style="r">(<ref loc="MRK 12:35-37">মার্ক 12:35–37</ref>; <ref loc="LUK 20:41-44">লূক 20:41–44</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />যীশুজৗং সদ্দূকীফৗরখৌ খৗথায়াও ফেজেনজানায় খৗনানানৈ ফরীশীফ্রা জ'জাবায়। <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />বিছৗরনি গেজেরাও সাছে আইননাও গৗরৗং গৗরা গুরু দংমৗন, বিয়ৗ বে প্রশ্নজৗং বিখৌ আনজাৎ লাদৗং, <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“ও গুরু, আইননাও ববে আদেশয়া দেৎসিন?” <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />যীশুআ বুংফিনবায়, “‘নৗঙৗ বে ফৗরবুখৌ, গাওনি ঈশ্বৗরখৌ নৗংনি গাছেন গৗর্বৗজৗং, গাছেন জিউজৗং, গাছেন গৗসৗজৗং অন।’<note caller="+" style="x"><char style="xo" closed="false">22:37 </char><char style="xt" closed="false"><ref loc="DEU 6:5">হূদা বিজাব 6:5</ref> </char></note> <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />বে আদেশয়া সিগাং আরৗ বয়নিখুরৈ দেৎসিন। <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />আরৗ দ্বিতীয়আ বেবাদিনৗ, ‘নৗঙৗ গাওখৌ বাদি গাওনি ফারা ফরুসিখৌ অন।’ <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />গাছেন আইন আরৗ নবিফৗরনি ফৗরৗংনায় মানিয়ানৗ বে মৗন্নৈ আদেশয়াওনৗ দং।”<verse eid="MAT 22:40" /></para>
  <para style="s">মসিহআ ছৗর</para>
  <para style="r">(<ref loc="MRK 12:35-37">মার্ক 12:35–37</ref>; <ref loc="LUK 20:41-44">লূক 20:41–44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />জেব্লা ফরীশীফ্রা জ'জাদৗং, অব্লা যীশুআ বিছৗরনিয়াও সৗংদৗং, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />“মসিহখৌ নৗংছৗর ছৗরখৌ হৗন্নানৈ সান্নৗ? বিয়ৗ ছৗরনি বিসাজ্লা?” বিছৗরৗ বুংফিনদৗং, “বিয়ৗ দায়ূদনি বিসা হৌয়া।” <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />বিয়ৗ বিছৗরখৌ বুংবায়, “অব্লা মাব্রৈ জিউনি দৈদেন্নায়াও বিখৌ দায়ূদনা ‘ফৗরবু’ হৗন্নানৈ বুংখৗ? মানৗ বিয়ৗ হৗনদৗং, <verse eid="MAT 22:43" /><verse number="44" style="v" sid="MAT 22:44" />‘বি ফৗরবু ঈশ্বৗরা আংনি ফৗরবুখৌ হৗনবায়, নৗংনি বিসারুফৗরখৌ আঙৗ নৗংনি আঠেং সিঙাও দৗনজৗবমাগৌমানি নৗঙৗ আংনি আগ্ডাজৗং জিরাইবায় থাদৗ’? <verse eid="MAT 22:44" /><verse number="45" style="v" sid="MAT 22:45" />যদি দায়ুদআ বিখৌ ফৗরবু হৗন্নৗ, অব্লা মসিহআ মাব্রৈ দায়ূদনি বিসা হৌয়া জানৗ হাগৌ?” <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />যীশুনি সৗংনাইখৌ রাওবৗ বুংফিননৗ হায়াখৗছৈ, আরৗ বি দিননিফ্রায়নৗ যীশুনিয়াও সৗংবাওনৗ রাওবৗ গৗহৗ জায়াখৗছৈ।<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">আইন গুরু আরৗ ফরীশাইফৗরখৌ সাবধান হৗনায়।</para>
  <para style="r">(<ref loc="MRK 12:38-39">মার্ক 12:38–39</ref>; <ref loc="LUK 11:43-46">লূক 11:43–46</ref>; <ref loc="LUK 20:45-46">20:45–46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />যীশুআ হান্জাখৌ আরৗ গাওনি ছেলাফৗরখৌ হৗনবায়, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />“আইন গুরু আরৗ ফরীশীফ্রা মোশিনি আসননাও জিরাইবায়। <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />বিনিখাইনৗ নৗংছৗরৗ, বিছৗরনৗ রাইঠিনায় গাছেনখৌবৗ মাওথার নাংনায়, নাথায় বিছৗরনি মাওনাইফৗরখৌ দাছৗলৗং, মানৗনা বিছৗরৗ জেরেই ফৗরৗঙৗ, বেবাদি গাওছৗরনৗ মাওয়া। <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />বিছৗরৗ দিখাংনৗ হায়ি গিলিৎ বিবানখৌ গুবুননৗ বানহৗয়ৗ, নাথায় বিছৗরৗ গাওছৗরনি আসি থাইছেবৗ ছৗমাওনৗ গৗসৗ জায়া। <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />বিছৗর গাছেন মাওনাইমানিয়ানৗ মানসিফৗরনৗ দিন্ঠিনৗ থাখৈ বান। গাওছৗরখৌ ধার্মিক দিন্ঠিনৗ শাস্ত্রনি খৗথাফৗরখৌ লিৎখাংনানৈ খাফালাও আরৗ আখান্থিআও গান্নৗ আরৗ দিন্ঠিনৗ গৗলাও গৗলাও খুন্ডুংনি ফিতা খাদেৎনান লায়ৗমৗন। <note caller="+" style="f"><char style="fr" closed="false">23:5 </char><char style="ft" closed="false">ইহুদি হৌয়াসাফ্রা বিগুরনি বাক্সফ্রায়াও সি'নি তাবিজ বানাইনানৈ গৗলৈ টুকরা খাদেৎনান গান্নৗমৗন। জেখৌ জৗং </char><char style="xt"><ref loc="EXO 13:1-6">অৗংখাৎলাংনায় 13:1–6</ref></char> <char style="xt"><ref loc="DEU 6:4-9">হূদা বিজাব 6:4–9</ref>; <ref loc="DEU 11:13-21">11:13–21</ref> </char> নুনৗ মৗনৗ। ফৗরবুনি আদেশ মানিনাইয়াও বেফৗরবাদি গৗলৈ বাক্সখৌ বিছৗরৗ কাপালাও আরৗ আখছি আখাইনি আখান্ঠি গৗজৌয়াও জেয়া গৗর্বৗ খাঠিয়াও (<char style="xt"><ref loc="EXO 13:9">অৗংখাৎলাংনায় 13:9</ref>,<ref loc="EXO 13:16">16</ref></char>; <char style="xt"><ref loc="DEU 6:8">হূদা বিজাব 6:8</ref>; <ref loc="DEU 1:18">1:18</ref>)</char>। নাথায় ফরীশীফ্রা মানসিফৗরখৌ দিন্ঠিনৗ গুবুন মানসিফৗরনিফ্রায়বৗ দেৎসিন বাক্স বানাইয়ৗমৗন। ইহুদি হৌয়াসাফ্রা গাওছৗরখৌ ঈশ্বৗরনি ফৗথায়গ্রা দিন্ঠিনৗ গাওছৗরনি খসাবফৗরাও খুন্ডুংনি ফিতা খাদেৎনান লায়ৗমৗন, জেরৈ বাদি লিৎনায় দং। নাথায় ফরীশীফ্রা দিন্ঠিনৗ গৗলাও গৗলাও খুন্ডুংনি ফিতা খাদেৎনান লায়ৗমৗন।</note> <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />বিছৗরৗ ভোজফৗরাও মান গৗনাং জায়গাফৗরখৌ সাইখয়ৗ; আরৗ সিবিগ্রা ন্ব'ফৗরাও আসনফৗরখৌ মৗজাংমৗনৗ। <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />বিছৗরৗ হাঠায়সালিফৗরাও গৗজৗন্নায় লাজানৗ মৗজাংমৗনৗ; আরৗ মানসিফৗরজৗং ‘গুরু’ হৗন্নানৈ লিংজানায়খৌ মৗজাংমৗনৗ। <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />নৗংছৗরৗ ‘গুরু’ হৗনজানৗনাংলে, মানৗনা নৗংছৗরহা সাছে বান ফৗরৗংগ্রা দং, নৗংছৗর গাছেনবৗ বিদা ফংবায়ফৗর। <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />আরৗ নৗংছৗরৗ সংসারাও রাওখৌবৗ ধৗরৗম বিফা হৗন্নানৈ লিংনৗ নাংলে, মানৗনা স্বৗর্গৗয়াও জাইয়া দং, বিবান নৗংছৗরনি ধৗরৗম বিফা। <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />এবা নৗংছৗরৗ ফৗরৗংগ্রা বুংখৌজানৗ নাংলে, মানৗনা নৗংছৗরহা সাছে বান ফৗরৗংগ্রা দং, বিয়ৗ মসিহ। <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />নৗংছৗরনি গেজেরাও জাইয়া দেৎসিনথার, বিয়ৗ নৗংছৗরনি দাস জাথারনাংনায়। <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />মানৗনা জাইফ্রা গাওছৗরখৌ বাখ্নাইনানৈ লায়ৗ, বিছৗরৗ ফাহায়জানায়, আরৗ জাইফ্রা গাওছৗরখৌ ফাহায়নানৈ লায়ৗ বিছৗরৗ বাখানাইজানায়।<verse eid="MAT 23:12" /></para>
  <para style="s">আইন গুরু আরৗ ফরীশীফৗরনি ধিক্কার</para>
  <para style="r">(<ref loc="MRK 12:40">মার্ক 12:40</ref>; <ref loc="LUK 11:39-42">লূক 11:39–42</ref>,<ref loc="LUK 11:44">44</ref>,<ref loc="LUK 11:52">52</ref>; <ref loc="LUK 20:47">20:47</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />“দিন্ঠিফ্লাগ্রা আইন গুরুফৗর আরৗ ফরীশীফৗর, নৗংছৗরহা বেছে ধিক্কার! মানসিফৗরনি থাখৈ নৗছৗরহা স্বৗর্গৗ রাইজৗনি দুয়ারখৌ ফাংথেয়ৗ, আরৗ নৗংছৗর গাওছৗরবৗ হাবমা, আরৗ গুবুনফৗর হাবনৗ হাস্থাইনায় ফৗরখৌবৗ হাবহৗয়া, <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />আইগুরুফৗর আরৗ ফরীশীফৗর, ধিক্কার নৗংছৗরহা, নৗংছৗরৗ দিন্ঠিফ্লাগ্রাফৗর, নৗংছৗরৗ রান্ডি হিন্জাওফৗরনি ধৗন সম্পত্তিখৌ বৗখ্রেবনানৈ জায়ৗ আরৗ দিন্ঠিফ্লানৗ থাখৈ গৗলাও গৗলাও প্রার্থনা খৗলামৗ। বিনিখাইনৗ নৗংছৗরনি ছায়াও গৗব্রাবসিনথার বিচার জানায়।<note caller="+" style="f"><char style="fr" closed="false">23:14 </char><char style="ft" closed="false">খাইছে মেনাস্ক্রিপ্ঠাও বে পদনা লাফাদেৎজাখৈ </char></note> <verse eid="MAT 23:14" /><verse number="15" style="v" sid="MAT 23:15" />দিন্ঠিফ্লাগ্রা আইন গুরুফৗর আরৗ ফরীশীফৗর, নৗছৗরহা ধিক্কার, নৗছৗরৗ সাছে মানসিখৌ গৗসৗ সৗলাইহৗনৗ থাখৈনৗ লৈথৗআও আরৗ হাদৎমানিফৗরাও গিদিংবাইয়ৗ, নাথায় জেব্লা মৗনৗ, অব্লা নৗংছৗরৗ বিছৗরখৌ নৗংছৗরনি খুরৈ দুই গুণা বাংসিন নরকনি বিসা খৗলামৗ। <verse eid="MAT 23:15" /><verse number="16" style="v" sid="MAT 23:16" />ধিক্কার নৗংছৗরহা, খানা দৈদেনগিরিফৗর! নৗংছৗরৗ বেবাদি ফৗরৗঙৗ, ‘ছৗরবায়া মন্দিরনি সমায় লাব্লা, বিহা জেবৗ অৗঙা, নাথায় ছৗরবায়া মন্দিরনি সনানি নামমৈ সময় লাব্লা, বিয়ৗ গাওনি সময়লানাইখৌ লাখিথারনাংনায়।’ <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />ও মূর্খ আরৗ খানাফৗর, ববেয়া দেৎসিন, সনায়া না, সোনাখৌ ফৗথারগ্রা মন্দিরা? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />নৗংছৗরবৗ বুঙৗ, ‘ছৗরবায়া বিন্দৗনি নামমৈ সময় লাব্লা, বেহা জেবৗ অৗঙা, নাথায় ছৗরবায়া বিন্দৗয়াও বাওনায় মৗঙাফৗরনি নামমৈ সমায় লাব্লা বিয়ৗ বেখৌ হৗথারনাংনায়।’ <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />খানাফৗর! ববেয়া গৗনাংসিনথার, বাওনায় মৗঙায়া না বাওনায় মৗঙাখৌ গৗথার খৗলামগ্রা বিন্দৗয়া। <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />বিনিখাইনৗ, জাইয়া বিন্দৗনি নামমৈ সমায় লায়ৗ, বিয়ৗ বিন্দৗনি আরৗ বিনি ছায়াও নাজাওনায় গাছেন মৗঙাফৗরনি নামমৈ সমায় লায়ৗ। <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />আরৗ জাইয়া মন্দিরনি নামমৈ সমায় লায়ৗ, বিয়ৗ মন্দিরনি আরৗ বিয়াও থাগ্রা ঈশ্বৗরনি নামমৈ সমায় লায়ৗ। <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />আরৗ ছৗরবায়া স্বৗর্গৗনি নামমৈ সময় লাব্লা, বিয়ৗ ঈশ্বৗরনি সিংহাসন আরৗ বে সিংহাসনাও জাইয়া জিরাইয়ৗ, বিনি নামমৈ সমায় লায়ৗ। <verse eid="MAT 23:22" /><verse number="23" style="v" sid="MAT 23:23" />নৗংছৗর দিন্ঠিফ্লাগ্রা, আইন গুরুফৗর আরৗ ফরীশীফৗর, ধিক্কার নৗংছৗরহা! নৗংছৗরৗ ফদিনা, মৌরি আরৗ জিরা বে মসলানিফ্রায় দশভাগনি এক ভাগ দান হৗয়ৗ, নাথায় নৗংছৗরৗ গৗনাংথার আইনি ফৗরৗংনাইফৗরখৌ বাংসিন বাদহৗদৗং, বে জাবায়, নিয়াই, দয়া আরৗ ফৗথাইজাথাওথাও। নৗংছৗরৗ সিগাংনিখৌ জেরৈ ফালিদৗং, বেবাদিনৗ উননিখৌবৗ ফালিনাংথারগৌমৗন। <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />দৈদেনগিরি খানাফৗর! নৗংছৗরৗ থামফৈখৌ সগরনানৈ গারৗ নাথায় উঠখৌ মলঙৗ!। <verse eid="MAT 23:24" /><verse number="25" style="v" sid="MAT 23:25" />ধিক্কার দিন্ঠিফ্লাগ্রা আইন গুরুফৗর আরৗ ফরীশীফৗর, নৗছৗরৗ গাওছৗরনি খুরৈ আরৗ থুরসিফৗরখৌ ছায়াও মানজিয়ৗ, নাথায় সিঙাও বিছৗরৗ লোভজৗং আরৗ সেনৗ হাস্থাইনায়জৗং বুংফৗবনানৈ থায়ৗ। <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />ও খানা ফরীশী, খুরৈনি সিঙাওনি খুরৈ থুরসিখৌ ছুস্রাংগ্রৗ, অব্লা ছায়াওনিবৗ ফুসোব জানায়। <verse eid="MAT 23:26" /><verse number="27" style="v" sid="MAT 23:27" />ধিক্কার নৗংছৗরহা, আইন গুরুফৗর আরৗ ফরীশীফৗর, দিন্ঠিফ্লাগ্রাফৗর, নৗংছৗরৗ ছুনৈ ফুন্নায় গৗথৈ হাখর বাদি, ছায়াও সমাইনা, নাথায় সিঙাও গৗথৈনি বেগেংফৗর আরৗ মৗংফ্রৗমবৗ মৈলা। <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />বেবাদিনৗ নৗংছৗরৗ বাইরাও মানসিফৗরনি সিগাঙাও ধৗরৗমিয়া নুজায়ৗ নাথায় সিঙাও দিন্ঠিফ্লাগ্রা আরৗ পাপফৗরজৗং বুংফাওনায়।<verse eid="MAT 23:28" /></para>
  <para style="s">সাজা হৗনাগৌখৌ রাইঠিনায়</para>
  <para style="r">(<ref loc="LUK 11:47-51">লূক 11:47–51</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />“আইন গুরুফৗর, আরৗ ফরীশীফৗর, নৗংছৗরৗ দিন্ঠিফ্লাগ্রা, ধিক্কার নৗংছৗরহা, নৗংছৗরৗ নবিফৗরনি থাখৈ গৗথৈ দন্দরফৗরখৌ বৗনাইয়ৗ আরৗ ধার্মিকফৗরনি থাখৈ গৗসৗখাংজানৗ খবরস্থানখৌ সমাইনা সাজাইয়ৗ নাথায় বে নবিফৗরখৌ নৗংছৗরনি আজৌ আজৈফ্রানৗ সিথাৎনামৗন। <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />আরৗ নৗংছৗরৗ বুঙৗ, ‘জৗংনি আজৌ আজৈনি আমৗলাও জৗঙৗ দৗঙৗমৗনব্লা বিছৗর জেরৈ মাওদৗং মৗন, আরৗ নবিফৗরখৌ থৈ ফসরনান সিথাৎদৗংমৗন, বেবাদিনৗ জৗঙৗ মাওনায় আরৗ সিথাৎনায় অৗঙা মৗন।’ <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />বিনিখাইনৗ নৗংছৗরৗ গাওছৗরনি বিরুদ্ধনাও সাক্ষ্য হৗয়ৗ যে বি সমাও নবিফৗরখৌ সিথাৎগ্রাফৗরনি জৗলৈ হৗন্নানৈ। <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />দে, অব্লা নৗংছৗরনি আজৈ আজৌফৗর মাওজেন্নায়খৌ নৗংছৗরৗ মাওফুংজৗবদৗ। <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />ও জিবৌফৗর, জিবৌ গাংছৗমনি বিসাফৗর, নৗংছৗরৗ নরকনি বিচার সাজানিফ্রায় মাব্রৈ খাৎগনায়? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />বিনিখাইনৗ আঙৗ নৗংছৗরনিয়াও নবিফৗর, গিয়ানি মানসিফৗর আরৗ আইন গুরুফৗর থৗনহৎদৗংছৈ। বিছৗরনি খাইছেখৌ নৗংছৗরৗ সিথাৎনায় আরৗ খাইছেখৌ ক্রুশয়াও দৗখৗঠাবনায়, আরৗ খাইছেখৌ গাওছৗরনি সিবিগ্রা ন্ব'য়াও ছাবুকজৗং বুনায়, আরৗ নৗগৗর নৗগৗর হৗছৗফিথিংবাইনায়। <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />বিনিখাইনৗ বুহুমাও সৗরজিনাইনিফ্রায় জেছেবাং ধার্মিকফৗরখৌ সিথাৎবৗবায়, হেবলনিফ্রায় বরখিয়েনি বিসাজ্লা, সখরিয় জাইখৌ মন্দির আরৗ বিন্দৗনি গেজেরাও সিথাৎদৗংমৗন, বে সমসিম গাছেন দায় গৈয়ি মানসিফৗরখৌ সিথাৎনায়নি থৈনি সাজায়া নৗংছৗরনি ছায়াও <note caller="+" style="f"><char style="fr" closed="false">23:35 </char><char style="ft" closed="false">হেবলআ জাবায় আদম আরৗ হবানি বিসাজ্লা আরৗ বিয়ৗ বাইবেলাও বৈনিখুরৈ সিগাং সিথাৎজানায় মানসি, </char><char style="xt"><ref loc="GEN 4:8">জাগাইজেন্নায় 4:8</ref></char>। সখরিয়আ বাইবেলনি বুংনায়বাদি ইব্রীয় বিজাবনি বুংনায়বাদি সখরিয়আ জাবায় মানসি সিথাৎজানায়ফৗরনি জৗবথানায় সাছে মানসি। <char style="xt"><ref loc="2CH 24:20-22">2 ইতিহাস 24:20–22</ref></char> (2 ইতিহাস বিজাবমা জাবায় ইব্রীয় বিজাবনি জৗবথানায় বিজাব)</note>গৗগ্লৈনায়। <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />নংথারগৌয়ৈ আঙৗ নৗংছৗরখৌ বুঙৗ, বে সিথাৎনায়নি গাছেন সাজায়া বে ফিরিনি মানসিফৗরনি ছায়াও গৗগ্লৈনায়।<verse eid="MAT 23:36" /></para>
  <para style="s">যিরূশালেমনি থাখৈ দাহা</para>
  <para style="r">(<ref loc="LUK 13:34-35">লূক 13:34–35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />“ও যিরূশালেম, যিরূশালেম নৗঙৗ নবিফৗরখৌ সিথাৎনৗ আরৗ জাইফৗরখৌ নৗংছৗরনিয়াও থৗনহৎনৗ বিছৗরখৌ অন্ঠাই খুবৈয়ৗ, দাওফ্রা জেরই দাওবিসাফৗরখৌ গাংখং সিঙাও জ' গজবনানৈ লায়ৗ, আংবৗ বিবাদিনৗ নৗংছৗরখৌ গজবনানৈ লানৗ জেব্লাইবৗ লুবৈদৗংমৗন, নাথায় নৗংছৗরৗ গজবজানৗ গৗসৗ জায়াখৈ। <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />নাই, নৗংছৗরনি ন্ব'য়া নৗংছৗরনি খাঠিয়াও সুনসান জানানৈ গৗগ্লায়নান থানায়। <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />আং নৗছৗরখৌ বুঙৗ, জেব্লাসিম নৗংছৗরৗ বুংনায় অৗঙা, অব্লাসিম নৗংছৗরৗ আংখৌ নুনায় অৗঙা। ‘ধন্য বিয়ৗ জাইয়া ফৗরবুনি নামমৈ ফৈগৌ।’”<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">মন্দির সংহার জানাংগৌখৌ যীশুনি রাইঠিনায়।</para>
  <para style="r">(<ref loc="MRK 13:1-2">মার্ক 13:1–2</ref>; <ref loc="LUK 21:5-6">লূক 21:5–6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />জেব্লা যীশুআ মন্দিরনিফ্রায় অৗংখাৎলাংনান থাবাইলাঙৗ অব্লা বিনি ছেলাফ্রা বিনিয়াও ফৈনানৈ বিখৌ হৗনবায়, “নাই বে ন্ব'ফৗরখৌ!” <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />বিয়ৗ সৗংবায়, “মা কি নৗঙৗ বে গেদেৎ মৗজাং ন্ব'ফৗরখৌ নুদৗং, নংথারগৌয়ৈ আঙৗ নৗংছৗরখৌ বুঙৗ, বে ন্ব'ফৗরনি অন্ঠাইফ্রা থাইছেবৗ থাইছেনি ছায়াও থাবাওনায় অৗঙা, থৎফ্রৗমবৗ নাৎখ্লাইজানায়।”<verse eid="MAT 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />জেব্লা যীশুআ অলিব হাজৗনি ছায়াও জিরাইনান দৗংমৗন, অব্লা ছেলাফ্রা ঠৗংয়ৈ বিনিয়াও ফৈদৗং। বিছৗর বুংবায়, “জৗংনৗ খৗথাদৗ, জেব্লা বেফৗর জানায়, আরৗ নৗংনি ফৈনায়নি চিহ্ন মা জানায় আরৗ জৗবনাইনি মুগাও মা চিহ্ন নুজানায়?” <verse eid="MAT 24:3" /><verse number="4" style="v" sid="MAT 24:4" />যীশুআ উত্তর হৗবায়, “রাওবৗ নৗংছৗরখৌ ছৗলৈনৗ হায়ি বাদি সাবধান জা! <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />গৗবাং মানসিফ্রা আংনি নামখৌ লানানৈ হৗনফৈনায়, ‘মসিহআ আংনৗ!’ আরৗ বিছৗরৗ গৗবাং মানসিফৗরখৌ ছৗলৈনায়। <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />জেব্লা নৗংছৗরৗ যুদ্ধনি খৗথা আরৗ যুদ্ধনি খবরাখবরিখৌ খৗনানায় অব্লা উসাও বাদাও দাজা; মানৗনা বেফৗরৗ গাছেন জানৗ নাংথারগৌ, নাথায় জৗবনাইনি সমা অব্লাবৗ ছফৈথৗয়াখৈ। <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />মৗনছে জাতিয়া গুবুন মৗনছে জাতিনি বিরুদ্ধনাও জিখাংনায় আরৗ মৗনছে রাইজৗয়া গুবুন মৗনছে রাইজৗনি বিরুদ্ধ জিখাংনায়। আংখালফৗর জানায় আরৗ জায়গা জায়গা গাংগ্রিম মাওনায়। <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />নাথায় বেফৗর গাছেন গথ' সারিনাইয়াও আইখাং বাইখাং জাজেন্নায় বাদি বান। <verse eid="MAT 24:8" /><verse number="9" style="v" sid="MAT 24:9" />নৗংছৗরৗ হমনানৈ গথাইজানায়, সাজা হৗজানায় আরৗ সিথাৎজানায়। আংনি নামনি থাখৈ নৗংছৗরৗ গাছেন জাতিফৗরজৗং মুগৈজানায়। <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />বে সমাও গৗবাঙানৗ ফৗথাইনায়নিফ্রায় গিদিংফিননায়; বিছৗরৗ গাওজৗং গাওনৗ বিসারুফৗরনৗ ধক্কাহৗজ্লাইনায় আরৗ মুগৈজ্লায়নায়। <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />গৗবাং নংখায় নবিফৗর নুজাফৈনানৈ মানসিফৗরখৌ ভমব্রাইনায়। <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />মানৗনা অন্যায়া বাংনাইখায় গৗবাং মানসিনি গৗসৗয়াও অন্নায়া গুসু জালাংনায়। <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />নাথায় জাইফ্রা জৗবনায়সিম গৗম গৗময়ৈ থানায় বিছৗরৗ বাছাইজানায়। <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />আরৗ সাক্ষীনি থাখৈ বে স্বৗর্গৗ রাইজৗনি মৗজাং খবরা সারা সংসারাও গাছেন গুবুন জাতিফৗরনিয়াও ফৗস্রাওজানায়, অব্লা জৗবনাইয়া ফৈনায়।<verse eid="MAT 24:14" /></para>
  <para style="s">গিথাওথাও নিদান</para>
  <para style="r">(<ref loc="MRK 13:14-23">মার্ক 13:14–23</ref>; <ref loc="LUK 21:20-24">লূক 21:20–24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />“জেব্লা নৗংছৗরৗ ফছংজায়ি মুগৈজানায়<note caller="+" style="x"><char style="xo" closed="false">24:15 </char><char style="xt" closed="false"><ref loc="DAN 9:27">দানিয়েল 9:27</ref></char></note> গুবুন-হারিনি মূর্তিখৌ মন্দিরাও ফছংনায় নুনায় দানিয়েল নবি বুংনাইবাদি গৗথার জায়গা, জাইয়া বেখৌ ফৗরাইনায় বিয়ৗ বেখৌ বুজিথৗং। <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />অব্লা বি সমাও জাইফ্রা যিহূদিয়া হাদৎনাও দং, বিছৗরৗ হাজৗফৗরাও খাৎখৗলাংথৗং। <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />জাইফ্রা ন্ব'নি উখুমছাও থানায়, বিছৗরৗ রাওবৗ গাহায়াও দাঅৗংখাৎথৗং এবা মাবা মৗঙাফৗরখৌ লাইনৗ ন্ব'য়াও দাহাবথৗং। <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />জাইফ্রা হুবারিয়াও থানায়, বিছৗরৗ রাওবৗ গাওছৗরনি জুমগ্রা সি'ফৗরখৌ লাইনৗ ন্ব'য়াও দাথাংফিনথৗং। <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />হাবাব বি দিনফ্রাও মৗদৗমাও থানায় হিন্জাওফৗরনে আরৗ বিসাফৗরনৗ আহার দৌওগ্রা বিমাফৗরনি অবস্থায়া মা জানায়! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />আরৗ ঈশ্বৗরনিয়াও প্রার্থনা গাবদৗ, বেফৗর গৗজাং বৗথৗরাও এবা সাব্বাথনি দিননাও জায়ি বাদি। <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />মানৗনা বি দিনফ্রাও এছেগ্রাব গিথাওথাও নিদানফৗর জানায়, সংসারখৌ ঈশ্বৗরা সৗরজি জেন্নায়নিফ্রায় দিনৈসিম বেবাদিয়া জাফেৎনাখৈ, এবা মাব্লাবাবৗ জাফিন্নায়বৗ অৗঙা। <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />ফৗরবুআ বি দিনফৗরখৌ ফুছুঙামৗনব্লা, মানসিফ্রা রাওবৗ বাছায় জানায় অৗঙা মৗন, নাথায় গাওনি সাইখজানায়ফৗরনি থাখৈ বি সমখৌ বিয়ৗ ফুছুংনায়। <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />বি বৗথৗরাও ছৗরবায়া হৗনব্লা, ‘নায়, <note caller="+" style="f"><char style="fr" closed="false">24:23 </char><char style="ft" closed="false">মসিহ সৗদৗব বেখৌনৗ গ্রীকয়াও খ্রীষ্ট বুঙৗ, বেনি অৗংথিয়া জাবায়, ঈশ্বৗরজৗং সাইখজানায় বাছাইগিরি রাজা। </char></note>মসিহআ বেয়াওনৗ দং!’ এবা, ‘নায়, বিয়ৗ বিয়াওনৗ!’ নৗংছৗরৗ দাফৗথায়। <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />মানৗনা নংখায় মসিহফৗর আরৗ নংখায় নবিফৗর অৗংখাৎনায়। হায়ৗব্লা ঈশ্বৗরজৗং সাইখজানায় মানসিফৗরখৌবৗ ছৗলৈনানৈ বিছৗরৗ গেদেৎ চিহ্নফৗর আরৗ সৗমৗ গৗনাং মাওনানৈ দিন্ঠিনায়। <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />নায়! বেফৗর জানায় বৗথৗরা ছফৈয়ি ছায়াওনৗ আঙৗ নৗংছৗরনৗ খৗথাখাবায়। <verse eid="MAT 24:25" /><verse number="26" style="v" sid="MAT 24:26" />এবা ছৗরবায়া নৗংনৗ বুঙৗব্লা, ‘ও, বিয়ৗ বিহা দং, মারু গৗরান ফৗথারবারিয়াও দং,’ বেহা দাথাং, এবা বিছৗরৗ হৗনব্লা, ‘অৗ বিয়ৗ বেয়াও থাখমাদৗং,’ বিখৌ দাফৗথায়। <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />জেরেই নখ্রাঙাও সানজানিফ্রায় মৗফলামনায়খৌ সৗনাবসিম নুয়ৗ, বেবাদিনৗ মানসিনি বিসাহৌয়াআ ফৈনায়। <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />জেরেও সিগুনফ্রা জ'জায়ৗ বিহা মিথিনৗ মৗনৗ যে গৗথৈ মৗদৗমা সাখাঠিয়াও দং হৗন্নানৈ, মানৗনা বে চিহ্নফ্রা জৗবনাইনি বৗথৗরা খাঠিয়াও হৗনানৈ দিন্ঠিয়ৗ।<verse eid="MAT 24:28" /></para>
  <para style="s">মানসিনি বিসাহৌয়া ফৈফিন্নায়নি খবর</para>
  <para style="r">(<ref loc="MRK 13:24-27">মার্ক 13:24–27</ref>; <ref loc="LUK 21:25-28">লূক 21:25–28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />“বি নিদাননি দিনফ্রা জৗবগ্রৗমৗনা সাননা খৗমশি জানায়, আরৗ নখাফৗরা স্রাং হৗনায় অৗঙা হাথৎখিফ্রা নখ্রাংনিফ্রায় গৗগ্লৈনায়, <note caller="+" style="x"><char style="xo" closed="false">24:29 </char><char style="xt" closed="false"><ref loc="ISA 13:10">যিশাইয় 13:10</ref>; <ref loc="ISA 34:4">34:4</ref></char></note>আরৗ ঈশ্বৗরা স্বৗর্গৗনি বৗলৗফ্রাখৌ ছৗমাওগ্লুবজানায়। <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" />অব্লা বে সমাও মানসিনি বিসাহৌয়াআ স্বৗর্গৗয়াও চিহ্ন নুজাফৈনায় আরৗ নৗংছৗরৗ মানসিনি বিসাহৌয়াখৌ বৗলৗ আরৗ মহিমাজৗং জৗমৈয়াও ফৈনায় নুনানৈ সংসারনি মানসিফ্রা গাবনায়। <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />গৗব্রাবমৈ তূরী ছুনায়, বুহুমনি খণা ফাৎব্রৈনিফ্রায় স্বৗর্গৗনি আরফ'ফৗরখৌ থৗনহৎনায় আরৗ সংসারনি ফাৎছে সিমানিফ্রায় গুবুন ফাৎছে সিমাসিম সৗরগিদিংনিফ্রায় ঈশ্বৗরজৗং সাইখজানায়ফৗরখৌ জ'খৗলামনায়। <verse eid="MAT 24:31" /><verse number="32" style="v" sid="MAT 24:32" />ডুমরি বিংফাংনিফ্রায় ছৗলৗং, জেব্লা বিনি ডালাইফ্রা গৗঠাং জানানৈ বিলাই গৗদান রৗদৗমখাঙৗ, অব্লা নৗংছৗরৗ মিথিয়ৗ, গৗলৗমনায় বৗথৗরা ছফৈবায় হৗন্নানৈ। <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />বেবাদিনৗ জেব্লা, নৗংছৗরৗ বেফৗর গাছেনখৌ জাফুংনায় নুয়ৗ, অব্লা নৗংছৗরৗ মিথিদৗ, যে সমা খাঠিছৈ, আরৗ দৗরখৗংয়াওখাছৈ। <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />নংথারগৌয়ৈ আঙৗ নৗংছৗরখৌ বুঙৗ, জেব্লাসিম বেফৗরৗ জানায় অৗঙা, অব্লাসিম বে ফিরিনি মানসিফ্রা জৗবনায় অৗঙা। <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />নখ্রাং আরৗ বুহুমমা জৗবনায়, নাথায় আংনি খৗথাফ্রা মাব্লাবাবৗ জৗবথারনায় অৗঙা।<verse eid="MAT 24:35" /></para>
  <para style="s">সিরি মৗন্নানৈ থানায়নি খৗথা</para>
  <para style="r">(<ref loc="MRK 13:24-27">মার্ক 13:24–27</ref>; <ref loc="LUK 17:26-30">লূক 17:26–30</ref>,<ref loc="LUK 17:34-36">34–36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />“বি সম এবা যুগয়া মাব্লা ছফৈনায়, বেখৌ রাওবৗ মিথিয়া, স্বৗর্গৗনি আরফ'ফৗর, এবা বিসা হৌয়াআবৗ মিথিয়া; বিফায়া বান মিথিগৌ। <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />নুহুনি আমৗলাও জেরৈ জাদৗংমৗন, বেবাদিনৗ মানসিনি বিসাহৌয়া ফৈনায়নি সমাওবৗ জানায়। <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />নুহুআ নাওয়াও গাখৗনায় দিনসিম, বানা জানায় দিনফৗরনি সিগাং মানসিফ্রা জাদৗং, লৗংদৗং, হাবা খৗলামজ্লাইদৗং আরৗ হাবা হৗজৗলাইদৗং। <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />আরৗ দৈ বানা লৗমনায় সমসিম বিছৗরৗ মৗংবৗ মিথিয়াখৈমৗন, আরৗ দৈ বানায়া ফৈনানৈ বিছৗর গাছেনখৌবৗ ফৗজালাংজৗবায়, বেবাদিনৗ মানসিনি বিসাহৌয়া ফৈনায়নি সমাওবৗ জানায়। <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />বে সমাও সানৈ মানসিয়া হুয়াও খামানি মাওনায়, নাথায় সাছেআ লাংজানায়, আরৗ গুবুন সাছেআ গালাংজানায়। <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />সানৈ হিন্জাওফ্রা লৗগৗছে আখাইজৗং জাথা ফিদিংবায় থানায়; বিছৗরনি সাছেআ লাংজানায় আরৗ গুবুন সাছেআ গালাংজানায়। <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />বিনিখাইনৗ সিরি মৗন্নানৈ থা, মানৗনা নৗংছৗরনি ফৗরবুআ মা দিননাও ফৈনায় বেখৌ নৗংছৗরৗ মিথিয়া। <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />নাথায় নৗংছৗরৗ বেখৌ মিথিখা, সিখাওয়া হরনি ববে মুগায়াও ফৈনায়, বিখৌ ন্ব'নি বৈগৗমায়া মিথিখায়ৗ মৗনব্লা, বিয়ৗ সিরিমৗনানৈ থানায়মৗন আরৗ গাওনি ন্ব'খৌ ছিফাইনৗ হৗনায় অৗঙা মৗন। <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />বিনিখাইনৗ ঠাম ঠিম জানানৈ থাফ্লায়, মানৗনা নৗংছৗর মিথিয়ৈ মুগায়াও মানসিনি বিসাহৌয়াআ ফৈনায়।” <verse eid="MAT 24:44" /><verse number="45" style="v" sid="MAT 24:45" />ফৗরবুআ সৗংদৗং, “অব্লা ফৗথাইজাগ্রা আরৗ জ্ঞানী দাসয়া ছৗর? জাইখৌ ন্ব'নি বৈগৗমায়া গুবুন দাসফৗরনি ছায়াও গাহায় ফছংয়ৗ, জাহাথে বিয়ৗ দাসফৗরনৗ বিছৗরনি জানায় মৗঙাফৗরনি ভাগৗখৌ ঠিক সমাও হৗয়ৗ? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />বৈগৗমায়া ফৈফিননানৈ যে দাসখৌ বেবাদি মাওনায় মৗনফৈনায়, বি দাসয়া বেছে ধন্য। <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />নংথারগৌয়ৈ আঙৗ নৗংছৗরখৌ বুঙৗ, বৈগৗমায়া বে দাসখৌ গাওনি গাছৈ সম্পত্তিনি ছায়াও নাইগ্রা ফছংনায়। <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />নাথায় বি দাসয়া গাজ্রিব্লা আরৗ গাও গৗসৗয়াও সানৗব্লা, ‘আংনি বৈগৗমায়া দা ফৈথনায় অৗঙা,’ <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />বেবাদি সান্নানৈ বিয়ৗ গাওনি দাসফৗরখৌ আরৗ দাসিফৗরখৌ বুদলা বুদলি খৗলামনৗ, আরৗ ফেদুয়াফৗরজৗং জানৗ আরৗ লৗংনৗ শুরু খৗলামনায়। <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />বি ফৈনায় হৗন্নানৈ সাননি দিননাও আরৗ সাবধান থায়ি সমাও বি দাসনি বৈগৗমায়া ছফৈনায়, <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />আরৗ বৈগৗমায়া বি দাসখৌ টুকরা টুকরা দানছনানৈ দিন্ঠিফ্লাগ্রাফৗরজৗং লৗগৗছে দৗনফানায়, জেরও গাবনায় আরৗ হাথায় অফ্রেনায় জানায়।<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">দশজন আইঠা সিখ্লাফৗরনি দৃষ্টান্ত</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />“স্বৗর্গৗ রাইজৗয়া বে দৃষ্টান্তজৗং সুজুনায়জায়ৗ। সানছে সমাও দাবছে জায়গায়াও দশজন সিখ্লা আইঠাফৗরা গাও গাওনি বাতিখৌ লানানৈ হৌয়া গৗদানখৌ লৗগৗ লানৗ থাংদৗংমৗন। <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />বিছৗরনি গেজেরাও সাবায়া জামবি আরৗ সাবায়া সিয়ানমৗন। <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />জামবি সাবায়া বাতিখৌ লাদৗংব্লাবৗ লৗগৗআও থাও লাঙাখৈমৗন। <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />নাথায় সিয়ান সাবায়া বাতিজৗং লৗগৗছে ডিগ্রিফৗরাও থাওবৗ লাংফাদৗংমৗন। <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />হৌয়া গৗদান ছফৈনাইয়া গৗবাও জানায়খায় বিছৗরৗ থিন্ঠনানৈ উন্ডুলাংদৗং। <verse eid="MAT 25:5" /><verse number="6" style="v" sid="MAT 25:6" />হৌয়া গৗদাননা ছফৈগৌ, বিজৗং লৗগৗ লাহৈনৗ অৗংখাৎবৗদৗ জেব্লা বেবাদি গাবজ্রিয়ৗ, অব্লা হরগেজের জাবায়মৗন। <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />দশজন সিখ্লা আইঠাফৗরা জিখাংনানৈ গাও গাওনি বাতিখৌ ঠাম ঠিম খৗলামনৗ হমবায়। <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />বে সমাও জামবি সাবায়া সিয়ানফৗরখৌ হৗন্দৗং, ‘দে, নৗংছৗরনি থাওখৌ জৗংনৗবৗ ইছে হৎদৗ, মানৗনা জৗংনি বাতিফ্রা গৗমৗৎদৗংছৈ।’ <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />বিছৗরৗ উত্তর হৗবায়, ‘জৗংনৗবৗ আরৗ নৗংছৗরনৗবৗ ঠৗনায় অৗঙা। বিনিখায় নৗংছৗর গাওছৗরনি থাখৈ দোকাননাও বায়হৈদৗ।’ <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />নাথায় বে জামবি সিখ্লাফ্রা জেব্লা থাও বায়নৗ থাঙৗ, অব্লা হৌয়া গৗদানা ছফৈবায়, আরৗ ঠাম ঠিম জাখানায় সাবা সিয়ান সিখ্লাফ্রা হৌয়া গৗদানজৗং লৗগৗছে হাবানি ভজয়াও হাববায়, আরৗ দুয়ারখৌ ফাংথেবায়। <verse eid="MAT 25:10" /><verse number="11" style="v" sid="MAT 25:11" />উনাও গুবুন সাবা সিখ্লা আইঠাফৗরাবৗ ফৈয়াছৈ। বিছৗরৗ বুংবায়, ‘ফৗরবু, ও ফৗরবু, জৗংনৗবৗ দুয়ার খেওনানৈ হৗদৗ।’ <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />নাথায় বিয়ৗ বুংফিনবায়, ‘নংথারগৌয়ৈ আঙৗ নৗংছৗরখৌ বুঙৗ, আং নৗংছৗরখৌ ছিনাইয়া।’ <verse eid="MAT 25:12" /><verse number="13" style="v" sid="MAT 25:13" />বিনিখাইনৗ সিরি মৗন্নানৈ থা, মানৗনা দিন এবা মুগায়া মাব্লা ছফৈনায়, বেখৌ নৗংছৗরৗ মিথিয়া।<verse eid="MAT 25:13" /></para>
  <para style="s">সাথাম মাওগ্রাফৗরনি দৃষ্টান্ত</para>
  <para style="r">(<ref loc="LUK 19:1-27">লূক 19:1–27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />“স্বৗর্গৗরাইজৗয়া, এরেই বাদি সাছে মানসি বাদি জাইয়া গুবুন হাদৎনাও থাংনায়নি সিগাং গাওনি দাসফৗরখৌ লিংহৎনানৈ গাওনি গাছেন সম্পত্তিনি একথিয়ারখৌ বিছৗরনৗ হৗলাংদৗংমৗন। <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />বে দাসফৗরনি হানায় বাদি বিছৗরনি বৗলৗখৌ নাইনানৈ বিয়ৗ সাছেনৗ হাজারবা সোনানি পায়সা, সাছেনৗ হাজারনৈ আরৗ গুবুন সাছেনৗ হাজারছে সোনানি পায়সা হৗনানৈ গুবুন হাদৎনাও থাংদৗং। <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />জাইয়া হাজারবা মৗনদৗং মৗন, বিয়ৗ ঠাবনৗ থাংনানৈ বেফৗরজৗং বাইলায় ফানলায় খৗলামনানৈ গুবুন হাজারবাখৌ খামায়দেৎদৗং। <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />বেবাদিনৗ হাজারনৈ মৗন্নায়য়াবৗ ফানলায় বাইলায় খৗলামনানৈ গুবুন হাজারনৈ খামায়দেৎদৗং। <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />নাথায় জাইয়া হাজারছে মৗনদৗং মৗন, বিয়ৗ মৗনছে হাখোর জাওনানৈ গাওনি বৈগৗমানি টাকাখৌ হ্বাসিঙাওছৗ দৗনখৗমাদৗংমৗন। <verse eid="MAT 25:18" /><verse number="19" style="v" sid="MAT 25:19" />বে দাসফৗরনি বৈগৗমাআ গৗবাও দিননি উনাও ফৈফিনদৗং আরৗ বিছৗরনিয়াও হিসাব লাদৗং। <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />অব্লা জাই মানসিআ হাজারবা সোনানি পায়সা মৗনদৗং মৗন, বিয়ৗ হাজারবা গুবুন সোনানি পায়সা লাবৗদেৎনানৈ, বিয়ৗ হৗনবায়, ও ফৗরবু, নৗঙৗ আংনৗ হাজারবা পায়সা হৗলাংদৗংমৗন, নৈ, আঙৗ গুবুন হাজারবা খামাইদেৎবায়। <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />বিনি ফৗরবুআ উত্তর হৗবায়, ‘সাবাস, মৗজাং আরৗ ফৗথাইজাগ্রা দাস! নৗঙৗ ইছেজৗংনৗ ফৗথাইজানায়নি খামানি মাওবায়, বিনিখাইনৗ আঙৗ নৗংখৌ গৗবাংনি ছায়াও একথিয়ার গৗনাং খৗলামনায়। ফৈ আরৗ নৗঙৗ নৗংনি বৈগৗমানি রংজানাইয়াও ভাগৗ লাফাদৗ।’ <verse eid="MAT 25:21" /><verse number="22" style="v" sid="MAT 25:22" />বিনি উনাও জাইয়া হাজারনৈ মৗনদৗং মৗন, বিয়ৗ ফৈনাই হৗনবায়, ‘ও ফৗরবু, নৗঙৗ আংনৗ হাজারনৈ সোনানি পায়সা হৗলাংদৗংমৗন। নৈ, আঙৗ গুবুন হাজারনৈ খামাইদেৎবায়।’ <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />বিনি ফৗরবুআ বিখৌ বুংফিনবায়, ‘সাবাস, মৗজাং আরৗ ফৗথাইজাগ্রা দাস! নৗঙৗ ইছেজৗংনৗ ফৗথাইজানায়নি খামানি মাওবায়, বিনিখাইনৗ আঙৗ নৗংখৌ গৗবাংনি ছায়াও একথিয়ার গৗনাং খৗলামনায়। ফৈ আরৗ নৗঙৗ নৗংনি বৈগৗমানি রংজানাইয়াও ভাগৗ লাফাদৗ!’ <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />নাথায় যে মানসিয়া হাজারছে মৗননামৗন বিবৗ ফৈনানৈ হৗনবায়, ‘ও ফৗরবু, আঙৗ মিথিগৌ নৗঙৗ সাছে গৗরা গৗসৗনি মানসি; নৗঙৗ জেরও ফৗয়াখৈ, বিয়াও হায়ৗ, আরৗ নৗঙৗ জেরও বিগৎ সাৎনাখৈ, বিয়াও আবাদ বুথুমমৗ। <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />বিনিখাইনৗ আঙৗ নৗংখৌ গিনানৈ নৗংনি হৗলাংনায় সোনানি পায়সাখৌ হ্বায়াও দৗনখৗমাদৗংমৗন। নৈ! আঙৗ নৗংনি পায়সাখৌ নৗংনৗ গথায়ফিনবায়।’ <verse eid="MAT 25:25" /><verse number="26" style="v" sid="MAT 25:26" />বিনি ফৗরবুআ বুংফিনবায়, ‘ও দুষ্টু আরৗ আলসিয়া দাস! নৗঙৗ মিথিখাদৗংমৗনব্লা, আং জেরও বিগৎ ফৗয়াখৈ, বেয়াওবৗ হায়ৗ আরৗ জেরও বিগৎ সাৎনাখৈ বেয়াওনৗ আবাদ বুথুমমৗ। <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />অব্লা নৗঙৗ আংনি টাকাখৌ আওথাইগ্রানিয়াও দৗনহৈ নাংগৌ মৗন। নৗঙৗ বেখৌ মাওয়ৗমৗনব্লা, আং বিনিফ্রায় আংনি পায়সাখৌ সুদজৗং লৗগৗছে মৗনফিনগৌমৗন। <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />বিনিখাইনৗ নৗঙৗ দা বিনিফ্রায় সোনানি পায়সা লানানৈ জাইনে হাজারবা সোনানি পায়সা দং বিনৗ হৈদৗ। <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />বিনিখাইনৗ জাইহা দং বিনি বাংসিন হৗদেৎনায় জানায়, আরৗ বিছৗরনে আগ্লায় বিগ্লায় জানায়। আরৗ জাইহা গৈয়া, বিনিফ্রায় বিনিয়াও ইছে দংনায়খৌবৗ লাফিন্জানায়। <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />আরৗ বে উনদায়ি দাসখৌ নৗংছৗরৗ লাংনানৈ বাইরানি খৗমসিয়াও গারহৗৎ; বিয়াও বিহা গাবনায় আরৗ হাথায় অফ্রেৎনায় জানায়।’<verse eid="MAT 25:30" /></para>
  <para style="s">জৗবনাইনি বিচার</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />“জেব্লা মানসিনি বিসাহৌয়া গাছেন আরফ'ফৗরখৌ গাওজৗং লৗগৗয়াও লানানৈ গাওনি মহিমায়াও ফৈনায় আরৗ গাওনি সিংহাসনাও জিরায়নায়। <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />অব্লা গাছেন জাতিফ্রা বিনি সিগাঙাও জ' জাফৈনায়। আরৗ মেন্ডা লাওখারা জেরৈ মেন্ডাফৗরখৌ বৗরমাফৗরনিফ্রায় আলাদা খৗলামৗ বেবাদিনৗ মানসিনি বিসা হৌয়াআবৗ গাছেন মানসিফৗরখৌ খাওনৈ ভাগ খৗলামনায়। <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />বিয়ৗ মেন্ডাখৌ গাওনি আগডাঠিং আরৗ বৗরমাফৗরখৌ গাওনি আখছিঠিঙৈ দৗনায়। <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />অব্লা রাজায়া গাওনি আগডা ঠিঙৈনিখৌ হৗন্নায়, ‘ফৈ, নৗংছৗর আংনি আফাজৗং বৗরহৗজানায়ফৗর! আরৗ সংসারখৌ সৗরজিনায়নিফ্রায় নৗংছৗরনৗ থাখৈ ঠাম ঠিম খৗলামখানায় রাইজৗখৌ আওগ্রিফৈ। <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />আং উখৈদৗং মৗন আরৗ নৗংছৗরৗ আংনৗ ইছে জানৗ হৗদৗংমৗন, আং গাংদৗংমৗন আরৗ নৗংছৗরৗ আংনৗ ইছে লৗংহৗদৗংমৗন; আং গুবুন হাদৎনিমৗন, নাথায় নৗংছৗরৗ আংখৌ হাংখ্রায়দৗংমৗন, <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />আংনে সি'ফৗর নাংগৌ মৗন আরৗ নৗংছৗরৗ আংখৌ গানহৗদৗং; আং জব্রা মৗন আরৗ নৗংছৗরৗ আংখৌ দাও দাও খৗলামদৗং মৗন, আং জৗবথেসালিয়াও দংমৗন আরৗ নৗংছৗরৗ আংখৌ নাইনৗ ফৈদৗংমৗন।’ <verse eid="MAT 25:36" /><verse number="37" style="v" sid="MAT 25:37" />বে সমাও ধার্মিকফ্রা বুংফিননায়, ‘ও ফৗরবু নৗংনি উখৈনায় সমাও মাব্লা জৗঙৗ নৗংখৌ ইছে জাহৗদৗংমৗন, এবা গাংনায় সমাও লৗংহৗদৗংমৗন? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />নৗংখৌ গুবুন হাদৎনি নুনানৈ মাব্লা জৗঙৗ নৗংখৌ হাংখ্রায়হৎনামৗন এবা নৗংখৌ সি' গৈয়িয়াও গানহৗদৗংমৗন? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />মাব্লা জৗঙৗ নৗংখৌ জব্রা নুয়ামৗন, এবা জৗবথেসালিয়াও নাইদৗং মৗন?’ <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />রাজায়া বুংফিনায়, ‘নংথারগৌয়ৈ আঙৗ নৗংছৗরখৌ বুঙৗ, নৗঙৗ জেখিয়া মাওয়ামানৗ আংনি বিদা-ফংবায়ফৗরনি ছৗরবা লৈইসিনথারনি থাখৈ মাওনাইয়া আংনি লাগৈ মাওনাইয়া জাদৗংমৗন।’ <verse eid="MAT 25:40" /><verse number="41" style="v" sid="MAT 25:41" />আরৗ বিয়ৗ গাওনি আখছিঠিঙৈ থানায়ফৗরখৌ হৗন্নায়, ‘নৗংছৗরৗ, সাও হৗজানায়ফৗর, আংনিফ্রায় গৗজান জা! শয়তান আরৗ বিনি আরফ'ফৗরনি থাখৈ ঠাম ঠিম খৗলামখানায় জৗবনৗগৈয়ি অৎনাও থাং। <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />মানৗনা আং উখৈদৗং মৗন, নাথায় নৗংছৗরৗ আংনৗ জানৗ ইছেবৗ হৗয়াখৈমৗন, আং গাংদৗংমৗন, নাথায় নৗংছৗরৗ আংনৗ ইছেবৗ লৗংনৗ হৗয়াখৈ, <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />আঙৗ গুবুন হাদৎনিমৗন, নাথায় নৗংছৗরৗ আংখৌ হাংখ্রাইয়াখৈমৗন, আংনৗ সি'ফৗর নাংগৌ মৗন আরৗ নৗছৗরৗ আংনৗ সি' গানহৗয়াখৈ। জেব্লা আং জব্রা মৗন, আরৗ জৗবথেসালিয়াও জৗবজাদৗংমৗন, বে সমাও নৗছৗরৗ আংখৌ নাইহৈয়াখৈ।’ <verse eid="MAT 25:43" /><verse number="44" style="v" sid="MAT 25:44" />বিছৗরৗ বে সমাও উত্তর হৗনায় ‘ফৗরবু, মাব্লা জৗঙৗ নৗংখৌ উখৈনায় এবা গাংনায় এবা অছেনা এবা সি' নাংগৌ এবা জব্রা এবা জৗবথেসালিয়াও জৗবজানায় নুনানৈবৗ হেফাজাব হৗয়াখৈমৗন?’ <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />বিয়ৗ বুংফিনবায়, ‘নংথারগৌয়ৈ আঙৗ নৗংছৗরখৌ বুঙৗ, জেখৌ নৗংছৗরৗ উন্দৈথার মানসিফৗরনি ছৗরবা সাছেখৌ হেফাজাব হৗয়িয়ানৗ আংখৌ হেফাজাব হৗয়ি জাবায়।’ <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />অব্লা বিছৗরখৌ জৗবনৗ গৈয়ি সৈনাংনায়নি জায়গায়াও থৗনহৎনায়, নাথায় ধার্মিকফ্রা জৗবনৗ গৈয়ি গৗঠাঙাও থাংনায়।”<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">যীশুখৌ সিথাৎনৗ খাইদা খৗলামনায়</para>
  <para style="r">(<ref loc="MRK 14:1-2">মার্ক 14:1–2</ref>; <ref loc="LUK 22:1-2">লূক 22:1–2</ref>; <ref loc="JHN 11:45-53">যোহন 11:45–53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />যীশুআ বে গাছেন খৗথাফৗরখৌ ফৗজৗবনায়নি উনাও গাওনি ছেলাফৗরখৌ হৗনবায়, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />“নৗংছৗরৗ মিথিখাগৌ সাননৈ উনাও ফাসকা<note caller="+" style="f"><char style="fr" closed="false">26:2 </char><char style="ft" closed="false">বি সমাও মৗনছে গৗনাংথার যিহূদীয়াফৗরনি ফরব মানিয়ৗ মৗন, যে সমাও ইস্রায়েলফৗরনি গেজেরজৗং থৈনায়নি আরফ'আ বাৎলাংদৗং জেব্লা বিছৗরৗ মৗনছে বৗরমা মেন্ডা বিসাখৌ বলিহৗদৗং, বিছৗর মিশর নাগারনান থাংনায়নি ঠিক সিগাং নাইদৗ বে ফুরা ফৗরমাইনায়খৌ অৗংখাৎলাংনায় 12:1–4''</char></note> ফরবমা জানায়, আরৗ মিথিদৗ, বে সমাওনৗ মানসিনি বিসাহৌয়াখৌ ক্রুশাও দৗখঠাবনৗ থাখৈ গথায়নায়।” <verse eid="MAT 26:2" /><verse number="3" style="v" sid="MAT 26:3" />বে সমাও গাহায় যাজকফ্রা আরৗ প্রাচীনফৗরা দেৎসিন যাজকনি মহললাও জ'জাদৗং, জাইনি নামমা কায়াফাস, <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />আরৗ বিছৗরৗ যীশুখৌ সিরি সিরিয়ৈ হৗমনৗ আরৗ সিথাৎনৗ সানজ্লাইদৗং। <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />নাথায় বিছৗরৗ বুংবায়, “বে খামানিখৌ ফরবনি সমাও মাওনৗ হায়া, অৗঙাব্লা মানসিফ্রা দাওরাও খৗলামনায়।”<verse eid="MAT 26:5" /></para>
  <para style="s">যীশুনি খর'আও থাও লুনায়</para>
  <para style="r">(<ref loc="MRK 14:3-9">মার্ক 14:3–9</ref>; <ref loc="JHN 12:1-8">যোহন 12:1–8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />জেব্লা যীশুআ বৈথনিয়াও খুরিয়া রগ জাজানায় শিমোননি ন্ব'আও দংমৗন। <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />বি সমাও সাছে হিন্জাওয়া আলাবাস্তার<note caller="+" style="f"><char style="fr" closed="false">26:7 </char><char style="ft" closed="false">আলাবাস্তারা এক ধরননি অন্ঠাই। </char></note> অন্ঠাইনি থিংখ্লিয়াও দাম গৗছা মৗদৗমনায় থাওখৌ লানানৈ বিনি খাঠিয়াও ফৈবায়। আরৗ বিয়ৗ জানৗ জিরাইনায় সমাও, হিন্জাওয়া মৗদৗমনায় থাওখৌ বিনি খর'য়াও লুনানৈ হৗবায়। <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />জেব্লা ছেলাফ্রা বে মাওনায়খৌ নুদৗং, অব্লা বিছৗরৗ বৗরাবনানৈ সৗংবায়, “বে মৗদৗমনায় থাওখৌ মানৗ আদ্রি খৗলামখৗ? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />বেখৌ গৗবাং দামাও ফান্নানৈ, বি টাকাখৌ হাওরিয়াফৗরনৗ রান্নানৈ হৗনৗ হাগৌমৗন!” <verse eid="MAT 26:9" /><verse number="10" style="v" sid="MAT 26:10" />যীশুআ বে বুংনায়খৌ মিথিনান বিছৗরখৌ হৗনবায়, “নৗংছৗরৗ বে হিন্জাওখৌ মানৗ দুঃখু হৗদৗং? মানৗনা আংনি থাখৈ বিয়ৗ মৗজাং খামানিখৌনৗ মাওদৗং। <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />হাওরিয়াফ্রা জেব্লাইবৗ নৗংছৗরজৗং থানায়, নাথায় আংখৌ নৗংছৗরৗ জেব্লাইবৗ মনফ্লাইনায় অৗঙা। <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />জেব্লা বিয়ৗ আংনি মৗদৗম ছায়াও মৗদৗমনায় থাওখৌ লুয়ৗ অব্লা আংখৌ ফবনায়নি থাখৈ বিয়ৗ ঠাম ঠিম খৗলামৗ। <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />নংথারগৌয়ৈ আঙৗ নৗংছৗরখৌ বুঙৗ, সংসারাও জেরাওনৗ বে মৗজাং খবরখৌ ফৗস্রাওনায় জানায়, বিয়াওনৗ বিয়ৗ জেখৌ মাওবায় গৗসৗখাংজানান খৗথাজানায়।”<verse eid="MAT 26:13" /></para>
  <para style="s">ত্রিশটা রুপানি পায়সানি লোভমাও যীশুখৌ গথাইনৗ হাস্থাইনায়</para>
  <para style="r">(<ref loc="MRK 14:10-11">মার্ক 14:10–11</ref>; <ref loc="LUK 22:3-6">লূক 22:3–6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />আরৗ বেনি উনাও বারোজন ছেলাফৗরনি গেজেরাও জাই সাছেখৌ ঈষ্করিয়োতীয় যিহূদা মুংখজায়ৗ, বিয়ৗ গাহায় যাজকফৗরনিয়াও থাংনানৈ <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />সৗংবায়, “যীশুখৌ নৗংছৗরনি আখাইয়াও গথাইব্লা নৗংছৗরৗ আংনৗ মা হৗনায়?” আরৗ বিনৗ যাজকফ্রা ত্রিশটা রুপানি পায়সা সানখনানৈ হৗদৗং। <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />বে সমনিফ্রায়নৗ ঈষ্করিয়োতীয় যিহূদাআ যীশুখৌ হমনানৈ বিছৗরনি আখাইয়াও গথায়নান হৗনৗ থাখৈ মৌখা নাগিৎবাইদৗংমৗন।<verse eid="MAT 26:16" /></para>
  <para style="s">জৗবনায় ফাসকা ফরবনি ভোজ</para>
  <para style="r">(<ref loc="MRK 14:12-21">মার্ক 14:12–21</ref>; <ref loc="LUK 22:7-14">লূক 22:7–14</ref>; <ref loc="JHN 13:21-30">যোহন 13:21–30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />সোডা হৗয়ি সিঠাওনি ফরবনি প্রথম দিননাও ছেলাফ্রা যীশুনিয়াও ফৈনানৈ সৗংবায়, “নৗংনি থাখৈ ফাসকা ফরবনি ভোজখৌ জৗঙৗ ববেয়াও থাংনানৈ ঠাম ঠিম খৗলামহৈনৗ?” <verse eid="MAT 26:17" /><verse number="18" style="v" sid="MAT 26:18" />বিয়ৗ বুংবায়, “নৗংছৗরৗ নৗগৗরাও অমুকনেও থাং আরৗ বিখৌ বেবাদি বুং, ‘গুরুআ হৗন্দৗং আংনি সমা খাঠিছৈ, আংঙৗ নৗংনি ন্ব'আও ছেলাফৗরজৗং লৗগৗছে ফাসকানি ফরবখৌ ফালিনৗ লুবৈয়ৗ।’” <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />ছেলাফ্রা যীশু থৗন্নায় বাদি ফাসকা ফরবনি ভোজখৌ ঠাম ঠিম খৗলামবায়। <verse eid="MAT 26:19" /><verse number="20" style="v" sid="MAT 26:20" />মৗনাবিলি জাব্লা যীশুআ বারোজন ছেলাফৗরখৌ লৗগৗয়াও লানানৈ জানৗ জিরাইদৗং। <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />আরৗ বিছৗর জাফুনায় সমাও বিয়ৗ হৗনবায়, “নংথারগৌয়ৈ আঙৗ নৗংছৗরখৌ বুঙৗ, নৗংছৗরনি গেজেরাও আংজৗং জাফানায়নি সাছেআ আংখৌ হমহৗনায়।” <verse eid="MAT 26:21" /><verse number="22" style="v" sid="MAT 26:22" />বিছৗরৗ বিরাঠ দুঃখু নাংনানৈ সাফ্রৗমবৗ বার বার বিখৌ বুংনৗ হমদৗং, “ও ফৗরবু জাইয়া নৗংখৌ হমহৗনায়, বিয়ৗ আংনৗ নামা?” <verse eid="MAT 26:22" /><verse number="23" style="v" sid="MAT 26:23" />যীশুআ বুংফিনবায়, “জাইয়া আংজৗং খুরৈ গংছেয়াওনৗ আখাই ছৗমব্রফাদৗং বিনৗ আংখৌ হমহৗনায়। <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />মানৗনা মানসিনি বিসাহৌয়ানি খৗথা শাস্ত্রয়াও জৗরৈ লিৎদৗং, বেবাদিনৗ থৈনায়; নাথায় মানসিনি বিসাহৌয়াখৌ জাইয়া হমহৗনায়, বে মানসিয়া হাব্বাব! বিয়ৗ সংসারাও সারিজায়ামৗনব্লানৗ হামগৌমৗন।” <verse eid="MAT 26:24" /><verse number="25" style="v" sid="MAT 26:25" />জাইয়া যীশুখৌ হমহৗনানৈ হৗনায়, বে ঈষ্করিয়োতীয় যিহূদাআ হৗনবায়, “ও গুরু, নংগৌয়ৈ বিয়ৗ আংনৗ নামা?” যীশুআ বুংফিনবায়, “নংগৌ নৗং গাওনৗ হৗংখাবায়।”<verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />জেব্লা বিছৗর জাদৗংছৈয়মৗন, বি সমাও যীশুআ সিঠাওখৌ লানানৈ ঈশ্বৗর ধন্যবাদ হৗবায় আরৗ টুকরা টুকরা খৗলামনানৈ গাওনি ছেলাফৗরনৗ হৗনানৈ হৗনবায়, “বেখৌ নাজাওদৗ আরৗ বেখৌ জাদৗ, বেনৗ আংনি মৗদৗম!” <verse eid="MAT 26:26" /><verse number="27" style="v" sid="MAT 26:27" />বিয়ৗ খুরৈখৌবৗ লানানৈ ঈশ্বৗরখৌ হামবায় হৗন্নানৈ বিছৗরনৗ গথাইনান হৗনবায়, “নৗংছৗর বয়বৗ বে খুরৈনিফ্রায় লৗংদৗ। <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />মানৗনা বেনৗ আংনি থৈ, গৗদান চুক্তিনি থৈ, জেয়া গৗবাংনি থাখৈ, পাপনিফ্রায় গহৗনৗ থাখৈ, ফসরজাবায়। <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />নংথারগৌয়ৈ আঙৗ নৗংছৗরনৗ রাইঠিয়ৗ, আংনি আফানি রাইজৗয়াও নৗংছৗরজৗং লৗগৗছে গৗদান আংগুর বিথাইনি বিদৈখৌ লৗংনায় দিনসিম আঙৗ বে আংগুর বিথাইনি বিদৈখৌ লৗংলে।” <verse eid="MAT 26:29" /><verse number="30" style="v" sid="MAT 26:30" />বেনি উনাও বিছৗরৗ মৗনছে মৗথাই রৗজাবনানৈ অলিব হাজৗয়াও অৗংখাৎলাংবায়।<verse eid="MAT 26:30" /></para>
  <para style="s">পিতরনি অস্বীকার খৗলামনায়</para>
  <para style="r">(<ref loc="MRK 14:27-31">মার্ক 14:27–31</ref>; <ref loc="LUK 22:31-34">লূক 22:31–34</ref>; <ref loc="JHN 13:36-38">যোহন 13:36–38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />যীশুআ বিছৗরখৌ হৗনবায়, “বে হরাও নৗংছৗরৗ বয়বৗ আংখৌ নাগারনানৈ খাৎগৗনায়, মানৗনা শাস্ত্রয়াও লিৎনায় দং, ‘ঈশ্বৗরা মেন্ডা লাওখারখৌ সিথাৎনায় আরৗ মেন্ডাফ্রা ছেৎখাই ফেৎখায় জানায়<note caller="+" style="x"><char style="xo" closed="false">26:31 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">সখরিয়া 13:7</ref></char></note>।’ <verse eid="MAT 26:31" /><verse number="32" style="v" sid="MAT 26:32" />নাথায় আঙৗ ঠাংখাংনায়নি উনাও নৗংছৗরনি সিগাং গালীলয়াও থাংনায়।” <verse eid="MAT 26:32" /><verse number="33" style="v" sid="MAT 26:33" />পিতরা বুংফিনবায়, “বয়বৗ নাগারব্লাবৗ আঙৗ নৗংখৌ মাব্লাবাবৗ নাগারথারনায় অৗঙা!” <verse eid="MAT 26:33" /><verse number="34" style="v" sid="MAT 26:34" />যীশুআ উত্তর হৗবায়, “নংথারগৌয়ৈ আঙৗ নৗংখৌ বুঙৗ, বে হরাও দাওজ্লায়া গিসিৎনা সায়াওনৗ, নৗঙৗ আংখৌ খনথাম ছিনাইয়া হৗন্নায়।” <verse eid="MAT 26:34" /><verse number="35" style="v" sid="MAT 26:35" />নাথায় পিতরা রাইঠিদৗং, “নৗংজৗং লৗগৗছে সিথাৎজানাংগৌব্লাবৗ আঙৗ মাব্লাবাবৗ বুংথারা নৗংখৌ আং ছিনাইয়া হৗন্নান!” আরৗ গুবুন গাছেন ছেলাফ্রাবৗ বিদিনৗ হৗনবায়।<verse eid="MAT 26:35" /></para>
  <para style="s">গেৎসিমানিয়াও যীশুনি প্রার্থনা</para>
  <para style="r">(<ref loc="MRK 14:22-26">মার্ক 14:22–26</ref>; <ref loc="LUK 22:14-20">লূক 22:14–20</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />গেৎসিমানী হৗন্নায় জাইগায়াও যীশুআ গাওনি ছেলাফৗরজৗং থাংদৗংমৗন, আরৗ বিয়ৗ ছেলাফৗরখৌ হৗনবায়, “আঙৗ বৈয়াও প্রার্থনা খৗলামহৈসান্দি নৗংছৗর বেয়াওনৗ জিরাইদৗ।” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />বিয়ৗ পিতরখৌ আরৗ সিবদিয়নি সানৈ বিসাজ্লা, যাকোব আরৗ যোহনখৌ গাওজৗং লৗগৗয়াও লাংফাদৗং, আরৗ বিয়ৗ বিরাঠ দুঃখু আরৗ আইখাং বাইখাং জাবায়। <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />আরৗ বিয়ৗ বিছৗরখৌ হৗনবায়, “আংনি জিউয়া দাহাজৗং থৈনায় বাদি আইখাং বাইখাং জাবায়। নৗংছৗরৗ বেয়াওনৗ নেথদৗ, আরৗ আংজৗং সিরি মৗন্নানৈ নেবায় থা।” <verse eid="MAT 26:38" /><verse number="39" style="v" sid="MAT 26:39" />বিয়ৗ ছ'ছে থাংনানৈ গাওনি মৗখাং গংগ্লানানৈ হায়াও হান্ঠুখরাইনানৈ বেবাদি প্রার্থনা খৗলামবায়, “ও, আফা, নৗংজৗং বে জানৗ হাগৌব্লা, বে সৈনাংনায়নি খুরইখৌ আংনিফ্রায় লাংদৗ; অব্লাবৗ আংনি গৗসৗ বাদি অৗঙা, নাথায় নৗংনি গৗসৗ বাদিছৗ জাথৗং।” <verse eid="MAT 26:39" /><verse number="40" style="v" sid="MAT 26:40" />উনাও বিয়ৗ ফৈফিন্নানৈ জেব্লা ছেলাফৗরখৌ উন্ডুলাংনায় নুফৈয়ৗ, অব্লা বিয়ৗ পিতরখৌ সৗংদৗং, “নৗংছৗরৗ মা, ঘণ্টাছেবৗ আংজৗং সিরি মৗন্নানৈ থানৗ হায়া না? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />সিরি মৗন্নানৈ থা, আরৗ প্রার্থনা খৗলাম; অব্লানৗ নৗংছৗরৗ আনজাৎনাও গৗগ্লৈনায় অৗঙা। জিউয়া গৗসৗ জায়ৗ, নাথায় মৗদৗময়াও বৗলৗ গৈয়া।” <verse eid="MAT 26:41" /><verse number="42" style="v" sid="MAT 26:42" />খনছেবাও বিয়ৗ থাংফিন্নানৈ বেবাদি প্রার্থনা খৗলামহৈবায়, “ও আংনি আফা, বে সৈনাংনায়নি খুরইখৌ আঙৗ লৗঙামাৎনিনৗ বৗখাৎজায়াব্লা নৗংনি গৗসৗ বাদি জাথৗং।” <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />বিয়ৗ জেব্লা আরবাওনৗ ফৈফিননৗ অব্লা বিছৗরখৌ উন্ডুলাংনায় মৗনফৈবাওবায়, মানৗনা বিছৗরনে মগননা উন্ডুনৗ অৗংখাৎবায়মৗন। <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />যীশুআ বিছৗরখৌ গালাংবাওনানৈ সিগাংনি বাদি আরবাও খনথামনি প্রার্থনা খৗলামহৈবায়। <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />বিনিফ্রায় গাওনি ছেলাফৗরনিয়াও ফৈফিনবাওনানৈ বিছৗরখৌ হৗনবায়, “মা দাবৗ উন্ডুগাছেনৗ আরৗ আরাম লাগাছিনৗ দং? নৈ, মুগায়া ছফৈখাবায়! মানসিনি বিসাহৌয়াআ পাপীফৗরনি আখাইয়াও গথাইজানায়ছৈ। <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />ছিখাংদৗ, থু, জৗঙৗ থাংদৗনি। আংখৌ গথাইনৗ নাগিৎনায় মানসিয়া বেয়াওনৗ ছফৈখাবায়!”<verse eid="MAT 26:46" /></para>
  <para style="s">যীশুখৌ হমনায়</para>
  <para style="r">(<ref loc="MRK 14:43-50">মার্ক 14:43–50</ref>; <ref loc="LUK 22:47-53">লূক 22:47–53</ref>; <ref loc="JHN 18:3-12">যোহন 18:3–12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />যীশুআ বেবাদি বুংফুনাইয়াওনৗ, বিনি বারোজন ছেলাফৗরনি গেজেরনি যিহূদা মুংনি সাছেয়া ছফৈবায়। বিজৗং লৗগৗছে থুংগ্রী আরৗ লাউঠি লানায় মৗনছে গেদেৎ হান্জা দংফায়ৗমৗন। বিছৗরখৌ গাহায় যাজকফৗর, আরৗ প্রাচীনফৗরনৗ থৗনহৎদৗংমৗন। <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />আরৗ জাইয়া গথায়নায়, বিয়ৗ বিছৗরনৗ বেবাদি মৗনছে চিহ্ন হৗখাদৗংমৗন, “জাইখৌ আঙৗ খুদুমনায়, বেনৗ বি মানসিয়া। বিখৌনৗ হমনানৈ আরৗ বেংনানৈ লাংদৗ।” <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />যিহূদাআ ছহৈগ্রৗমৗনা যীশুনি খাঠিয়াও থাংনানৈ হৗন্দৗং, “গৗজৗনথৗং গুরু!” আরৗ বিখৌ খুদুমদৗং। <verse eid="MAT 26:49" /><verse number="50" style="v" sid="MAT 26:50" />যীশুআ বুংফিনবায়, “ও লৗগৗ, নৗঙৗ জেখৌ মাওনৗ ফৈদৗং, বেখৌ গৗখ্রৈ মাওদৗ।” অব্লা বিছৗরৗ যীশুখৌ হমনানৈ খাদৗং। <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />বে সমাও যীশুজৗং দংফানায়ফৗরনি সাছেয়া গাওনি থুংগ্রীখৌ বয়ন্নানৈ গাহায় যাজকনি দাসনি ফাৎছে খৗমাখৌ দানছোবায়। <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />অব্লা যীশুআ বিখৌ হৗন্দৗং, “নৗঙৗ গাওনি থুংগ্রীখৌ জেরৌমৗন বিহানৗ দৗনফিন। মানৗনা জাইয়া থুংগ্রী দৈয়ৗ, বিয়ৗ থুংগ্রীজৗংনৗ থৈনায়। <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />নৗংছৗর মা কি সান্নৗ আং আফানি ছায়াও খাওলাইনৗ হায়া, দানৗ আঙৗ খাওলাইব্লা, বারোটা দাওহা নাংগ্রা ফৗরনিফ্রায়বৗ বাংসিন আরফ'ফৗরখৌ বিয়ৗ থৗনহৎনায় অৗঙা না? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />নাথায় বেবাদি জায়াব্লা শাস্ত্রয়াও লিৎনাইয়া মাব্রৈ জাফুংনায় যে বে বেবাদিয়ৈ জাথারনাংগৌ।” <verse eid="MAT 26:54" /><verse number="55" style="v" sid="MAT 26:55" />বি সমাওনৗ যীশুআ হান্জাখৌ হৗনবায়, “ডাখুফৗরখৌ হমনৗ ফৈনায় বাদি নৗংছৗরৗ থুংগ্রী আরৗ লাউঠি লানানৈ আংখৌ হমনৗ ফৈবায়? সানফ্রৗমবৗ মন্দিরাও জিরাইনানৈ ফৗরৗংবৗবায়, নৗংছৗরৗ আংখৌ হমাখৈ। <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />নাথায় নবিফৗর শাস্ত্রয়াও লিৎনাইয়া জাফুং নাংগৌখায়, বেফৗর গাছৈবৗ জাবায়।” বে সমাও গাছেন ছেলাফ্রা বিখৌ নাগারনানৈ খাৎদৗং।<verse eid="MAT 26:56" /></para>
  <para style="s">আফাদগিরনি সিগাংয়াও যীশু</para>
  <para style="r">(<ref loc="MRK 14:53-65">মার্ক 14:53–65</ref>; <ref loc="LUK 22:54-55">লূক 22:54–55</ref>,<ref loc="LUK 22:63-71">63–71</ref>; <ref loc="JHN 18:13-14">যোহন 18:13–14</ref>,<ref loc="JHN 18:19-24">19–24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />আরৗ জাইফ্রা যীশুখৌ হমদৗংমৗন বিছৗরৗ বিখৌ দেৎসিন গাহায় যাজক কায়াফাসনিয়াও লাংবায়, বিয়াও আইন গুরুফ্রা আরৗ প্রাচীনফৗরা জ'জাদৗং মৗন। <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />নাথায় পিতরা গৗজানৈ যীশুনি উন উন থাংনানৈ গাহায় যাজকনি সিথ্লায়াও হাবহৈদৗং। আরৗ মা জানায় বেখৌ নাইনৗ বিয়ৗ নেগ্রাফৗরজৗং লৗগৗছে জিরাইহৈদৗং। <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />গাহায় যাজকফৗর আরৗ গাছেন আফাৎগিরিফ্রা<note caller="+" style="f"><char style="fr" closed="false">26:59 </char><char style="ft" closed="false">আফাৎগিরি এবা সানসুমৈ এবা সেনহেড্রিন </char></note> যীশুখৌ দায় গৗনাং দিন্ঠিনানৈ বিখৌ সিথাৎহৗনৗ থাখৈ বিনি বিরুদ্ধনাও প্রমাণ নাইগিৎদৗং। <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />নাথায় বিছৗরৗ মৗংবৗ দায় মৗন্নৗ হায়াখৗছৈ। গৗবাঙানৗ বিনি বিরুদ্ধনাও নংখাই সাক্ষীফৗর হৗদৗংমৗন। জৗবনাইয়াও সানৈ মানসিয়া সিগাঙাও ফৈনানৈ <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />রাইঠিদৗং, “বে মানসিয়া বুংদৗংমৗন, ‘আঙৗ ঈশ্বৗরনি মন্দিরখৌ ছিফাইনানৈ সানথামাওনৗ লুফিনায়।’” <verse eid="MAT 26:61" /><verse number="62" style="v" sid="MAT 26:62" />গাহায় যাজকয়া বিছৗরনি সিগাঙাও গছংনানৈ যীশুখৌ হৗনবায়, “মা কি নৗং জেবৗ উত্তর হৗলে? নৗংখৌ দসি খৗলামনৗ মানসিফ্রা নৗংনি বিরুদ্ধনাও গছংনায় সাক্ষীফৗরনি নঙৈ নৗংনিয়াও মৗংবৗ বুংফিন্নৗ গৗনাং গৈয়া না?” <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />নাথায় যীশুআ সিরি থাদৗং। গাহায় যাজকআ বিখৌ বুংবায়, “দা আঙৗ গৗঠাং ঈশ্বৗরনি মুঙৈ হৗনানৈ নৗংখৌ সৗঙৗ, নৗঙৗ জৗংনৗ খৗথাছায় ঈশ্বৗরনি বিসা হৌয়া মসিহআ নৗঙৗব্লা?” <verse eid="MAT 26:63" /><verse number="64" style="v" sid="MAT 26:64" />যীশুআ উত্তর হৗবায়, “ও নৗঙৗ বুংখাবায়, আঙৗ নৗংছৗর বয়নৗবৗ খৗথায়ৗ, দানিফ্রায় নৗংছৗরৗ মানসিনি বিসাহৌয়াখৌ বৗলৗগ্রা ঈশ্বৗরনি আগডা ফারসি জিরায়নান থানায় নুনায় আরৗ নখ্রাংনি জৗমৈয়াও ফৈনায় নুনায়।” <verse eid="MAT 26:64" /><verse number="65" style="v" sid="MAT 26:65" />গাহায় যাজকয়া গাওনি গাননায় সি'খৌ বিছিনানৈ<note caller="+" style="f"><char style="fr" closed="false">26:65 </char><char style="ft" closed="false">যাজকয়া দুঃখু আরৗ সৈনাংনায়জৗং গাওনি গাননায় সি'খৌ বিছিবায় মানৗনা বিয়ৗ সানদৗং মৗন ঈশ্বৗরখৌ নিন্দিনায় জাবায়।</char></note> হৗনবায়, “বিয়ৗ ঈশ্বৗরখৌ নিন্দিবায়! জৗংনৗ মানৗ সাক্ষীফৗর নাংবাওগৌ? নাই, নৗংছৗরৗ নিন্দিনায়খৌ দানৗ খৗনাবায়। <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />নৗংছৗরৗ মা সান্নৗ?” অব্লা বিছৗরৗ উত্তর হৗদৗং, “বিয়ৗ দায় গৗনাং, বিয়ৗ থৈনাংথারগৌ!” <verse eid="MAT 26:66" /><verse number="67" style="v" sid="MAT 26:67" />আরৗ বিছৗরৗ যীশুনি মৗখাংয়াও মুজুদেৎবায় আরৗ বিখৌ বুবায় আরৗ খাইছেয়া বিখৌ সবানান, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />হৗনবায়, “ও মসিহ বুংছায় ছৗর নৗংখৌ বুদৗং!”<verse eid="MAT 26:68" /></para>
  <para style="s">পিতরনি অস্বীকার</para>
  <para style="r">(<ref loc="MRK 14:66-72">মার্ক 14:66–72</ref>; <ref loc="LUK 22:56-62">লূক 22:56–62</ref>; <ref loc="JHN 18:15-18">যোহন 18:15–18</ref>,<ref loc="JHN 18:25-27">25–27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />পিতরা বাইরানি সিথ্লায়াও জিরাইনানৈ থানায় সমাও, সাছে দাসিয়া বিনিয়াও থাংনানৈ হৗন্দৗং, “নৗংবৗ বৈ গালীলনি যীশুজৗং দংফায়ৗমৗন।” <verse eid="MAT 26:69" /><verse number="70" style="v" sid="MAT 26:70" />নাথায় বিয়ৗ বিছৗর গাছেনি সিগাঙাও অস্বীকার খৗলামনানৈ হৗন্দৗং, “আঙৗ মিথিয়া, নৗং মা বিষয়ৈ বুংখৗ।” <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />উনাও পিতরা জেব্লা বাইরানি গেটনাজৗং অৗংখাৎলাংদৗং, অব্লা গুবুন সাছে দাসিআ বিখৌ নুনানৈ বিয়াও থানায় মানসিফৗরখৌ হৗন্দৗং, “বে মানসিয়াবৗ নাসরৎনি যীশুজৗং দংফায়ৗমৗন।” <verse eid="MAT 26:71" /><verse number="72" style="v" sid="MAT 26:72" />বিয়ৗ আরবাও অস্বীকার খৗলামবাওবায়, আরৗ সমায় লানানৈ বুংবায়, “আঙৗ বি মানসিখৌ ছিনাইথারা।” <verse eid="MAT 26:72" /><verse number="73" style="v" sid="MAT 26:73" />দান্দিছেনি উনাও, বিয়াও গছংনায় মানসিফ্রা থাংনানৈ পিতরখৌ হৗনবায়, “বে নংথারগৌ, নৗঙৗ বিছৗরনিনৗ সাছে, মানৗনা নৗংনি রাওজৗংনৗ জৗঙৗ বেখৌ মিথিয়ৗ।” <verse eid="MAT 26:73" /><verse number="74" style="v" sid="MAT 26:74" />অব্লা বিয়ৗ অভিশাপজৗং পিতরা সমায় লানানৈ বিছৗরখৌ হৗন্দৗং, “আং বে মানসিখৌ মিথিয়া।” ঠাবনৗ দাওজ্লায়া গিসিৎদৗং। <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />অব্লা পিতরা যীশু বুংনায় খৗথাখৌ গৗসৗখাংদৗং, “দাওজ্লায়া গিসিৎনাসাওনৗ নৗঙৗ আংখৌ খনথাম অস্বীকার খৗলামনায়।” অব্লা পিতরা বাইরাও অৗংখাৎলাংনানৈ গৗগৗম গাবহৈবায়।<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">যীশুখৌ পীলাতনিয়াও লাংনায়</para>
  <para style="r">(<ref loc="MRK 15:1">মার্ক 15:1</ref>; <ref loc="LUK 23:1-2">লূক 23:1–2</ref>; <ref loc="JHN 18:28-29">যোহন 18:28–29</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />নখা নাইগ্রৗমৗনা ফুংজানি গাহায় যাজকফৗর আরৗ মানসিফৗরনি প্রাচীনফৗরা গাছেন যীশুখৌ সিথাৎনৗ জ'জানানৈ সানজ্লাইবায়। <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />আরৗ বিছৗরৗ যীশুখৌ খানানৈ রোমনি শাসনগিরি পীলাতনিয়াও গথাইহৈবায়।<verse eid="MAT 27:2" /></para>
  <para style="s">যিহূদানি থৈনায়</para>
  <para style="r">(<ref loc="ACT 1:18-19">প্রেরিত 1:18–19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />জেব্লা যিহুদা, জাইয়া যীশুখৌ বিসারুফৗরনৗ গথাইদৗং, নুবায় যে যীশুখৌ দাইয়াও খৗখ্লৈনায় জাবায়, অব্লা বিহা বিখা খামদৗং আরৗ গাও লানায় ত্রিশটা রুপানি পায়সাখৌ গাহায় যাজকফৗর আরৗ প্রাচীনফৗরনৗ হৗফিনদৗং। <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />আরৗ বিয়ৗ হৗন্দৗং, “আঙৗ দায় গৗয়ি থৈখৌ সিথাৎনৗ হমনানৈ হৗনানৈ পাপ মাওবায়।” বিছৗরৗ বিখৌ উত্তর হৗবায়, “জৗং মা মিথিগৌ, বি নৗংছৗরনি খামানি।” <verse eid="MAT 27:4" /><verse number="5" style="v" sid="MAT 27:5" />বিনিখাইনৗ যিহুদাআ টাকাখৌ মন্দির সিঙাও গাহৎনানৈ থাংবায়, আরৗ বিয়ৗ থাংনানৈ গাওনৗ ফারসি নাংহৈবায়। <verse eid="MAT 27:5" /><verse number="6" style="v" sid="MAT 27:6" />গাহায় যাজকফ্রা বি পায়সাখৌ খংখাংনানৈ হৗনবায়, “বে টাকাখৌ মন্দিরনি ভান্ডারাও দৗনব্লা আইনি বিরুদ্ধ জানায়, মানৗনা বে থৈনি দাম।” <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />আরৗ বিছৗরৗ সানজ্লাইনানৈ বে টাকাখৌ গুবুনহারিফৗরনৗ গৗথৈ সালিনি থাখৈ দৈহু দাগ্রানি হুখৌ বাইবায়। <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />বিনিখাইনৗ বে ফাথারখৌ দিনৈসিমবৗ, “থৈনি ফৗথার মুংখয়ৗ।” <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />বেবাদিনৗ যিরমিয় নবিনি ভাববাণীজৗং বুংজানায় বে খৗথায়া জাফুংবায়, “বিছৗরৗ ত্রিশটা রূপানি টাকা লাবায়। বে টাকা বি মানসিনি দাম, ইস্রায়েলনি মানসিফ্রা বিনি থাখৈ বি দামখৌ ঠিক খৗলামখাদৗংমৗন। <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />আরৗ বিছৗরৗ ফৗরবু থৗন্নায় বাদি বে টাকাখৌ দৈহু দাগ্রানি হুখৌ বায়নাইয়াও বাহায়বায়।”<note caller="+" style="x"><char style="xo" closed="false">27:10 </char><char style="xt" closed="false"><ref loc="ZEC 11:12-13">সখরিয়া 11:12–13</ref> </char></note><verse eid="MAT 27:10" /></para>
  <para style="s">যীশুনাও পীলাতনি সৗংনায়</para>
  <para style="r">(<ref loc="MRK 15:2-5">মার্ক 15:2–5</ref>; <ref loc="LUK 23:3-5">লূক 23:3–5</ref>; <ref loc="JHN 18:33-38">যোহন 18:33–38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />বেনিগেজরাওনৗ যীশুখৌ শাসনগিরিনি সিগাঙাও গছংহৗবায়, আরৗ শাসনগিরিয়া যীশুনিয়াও সৗংবায়, “মা কি নৗঙৗ যিহূদিয়ারিফৗরনি রাজা?” যীশুআ বুংফিনবায়, “বেখৌ নৗংনৗ বুংবায়।” <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />জেব্লা গাহায় যাজকফ্রা আরৗ প্রাচীনফৗরা বিখৌ দোষী খৗলামদৗং, অব্লা বিয়ৗ জেবৗ উত্তর হৗয়াখৗছৈ। <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />বিনিখাইনৗ পীলাতনা বিনিয়াও সৗংবাওদৗং, “নৗঙৗ খৗনায়াখৈ না, নৗংনি বিরুদ্ধনাও বিছৗরৗ সাক্ষী হৗফৈদৗং।” <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />নাথায় যীশুআ খৗথা ফংছেবৗ বুংফিনাখৗছৈ; বেখৌ নুনানৈ শাসনগিরিয়া মৗজেন সৗমৗ নাংদৗং। <verse eid="MAT 27:14" /><verse number="15" style="v" sid="MAT 27:15" />বেবাদি নিয়ম দং, বৗছৗরফ্রৗমবৗ ফাসকা ফরবনি সমাও পীলাতনা জৗবথেসালিয়াও দৗনজানায়ফৗরনিফ্রায় সাছেখৌ, মানসিফ্রা জাইখৌ হগারজানৗ সাইখয়ৗমৗন, বিখৌনৗ হগারৗমৗন। <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />বি সমাও যীশু বারাব্বা নামনি মুং দাংখা সাছে মানসি জৗবথেসালিয়াও জৗবজাদৗংমৗন। <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />মানসিফ্রা জেব্লা জ'জায়ৗ, অব্লা পীলাতনা বিছৗরনিয়াও সৗংদৗং, “নৗছৗরৗ ছৗরখৌ আংজৗং হগারজানৗ লুবৈয়ৗ? বারাব্বাখৌ না যীশু হৗন্নায় মসিহখৌ?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />মানৗনা পীলাতনা মিথিখাদৗং, বিছৗরৗ যীশুখৌ মগন ছানানৈছৗ বিনৗ গথাইদৗং। <verse eid="MAT 27:18" /><verse number="19" style="v" sid="MAT 27:19" />জেব্লা পীলাতনা বিচারনি আসননাও জিরাইনান দংমৗন, অব্লা বিনি হিন্জাওয়া মানসি থৗনহৎনানৈ বেবাদি বুংহৗৎদৗং, “বে দায় গৈয়ি ধার্মিক মানসিনি ছায়াও নৗং মৗংবৗ অন্যায় দামাও, মানৗনা থাংনায় হরাও বিনি থাখৈ সিমাঙাও আং মৗজেন সৈনাংদৗং।” <verse eid="MAT 27:19" /><verse number="20" style="v" sid="MAT 27:20" />নাথায় গাহায় যাজকফ্রা আরৗ প্রাচীনফৗরা ভিরখৌ তুলুংগাহৗনানৈ বেবাদি বুংনৗ থৗনবায়, “যে যীশুখৌ হগারালাবানৗ বারাব্বাখৌনৗ হগারদৗ।” <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />বিনিখাইনৗ শাসনগিরিয়া সৗংবায়, “বে সানৈনি গেজেরাও নৗংছৗরৗ ছৗরখৌ আংজৗং হগারজানৗ লুবৈয়ৗ?” ভিড়রা উত্তর হৗবায় “বারাব্বাখৌ!” <verse eid="MAT 27:21" /><verse number="22" style="v" sid="MAT 27:22" />পীলাতনা বিছৗরনিয়াও সৗংবাওবায়, “অব্লা, আঙৗ মা খৗলামনৗ যীশু জাইখৌ মসিহ হৗন্নৗ?” বিছৗরৗ গাছেন উত্তর হৗবায়, “বিখৌ ক্রুশয়াও হৗ!” <verse eid="MAT 27:22" /><verse number="23" style="v" sid="MAT 27:23" />পীলাতনা বিছৗরনিয়াও সৗংবায়, “মানৗ, বিখৌ ক্রুশয়াও হৗনৗ, বিয়ৗ মা দায় মাওদৗং?” নাথায় বিছৗরৗ বয়বৗ গৗব্রাবমৈ হজ্রিখাওনানৈ হৗনবায় “বিখৌ ক্রুশয়াও হৗ!” <verse eid="MAT 27:23" /><verse number="24" style="v" sid="MAT 27:24" />পীলাতনা নুবায় যে বিয়ৗ জেবৗ খৗলামনৗ হানায় অৗংলে আরৗ দাওরাওয়া রাসিনছৗ জালাংদৗং, বিনিখাইনৗ বিয়ৗ দৈ লানানৈ ভিড়নি সিগাঙাও গাওনি আখাইখৌ ছুনানৈ হৗন্দৗং, “বে মানসিনি থৈনি দাইয়া আংনি অৗঙা, বিনি দাইয়া নৗংছৗরনি জানায়।”<note caller="+" style="x"><char style="xo" closed="false">27:24 </char><char style="xt" closed="false"><ref loc="DEU 21:7-9">হূদা বিজাব 21:7–9</ref></char></note> <verse eid="MAT 27:24" /><verse number="25" style="v" sid="MAT 27:25" />গাছেন মানসিফ্রা উত্তর হৗবায়, “বিনি থৈনি দাইয়া জৗংনি আরৗ জৗংনি বিসাফৗরনি ছায়াও জাথৗং।” <verse eid="MAT 27:25" /><verse number="26" style="v" sid="MAT 27:26" />অব্লা পীলাতনা বিছৗরনি খৗথা বাদি বারাব্বাখৌ হগারবায়। নাথায় যীশুখৌ ছাবুকজৗং বুহৗনানৈ ক্রুশয়াও হৗনৗ গথাইবায়।<verse eid="MAT 27:26" /></para>
  <para style="s">যীশুখৌ হাজিগদাওনায়</para>
  <para style="r">(<ref loc="MRK 15:16-20">মার্ক 15:16–20</ref>; <ref loc="JHN 19:2-3">যোহন 19:2–3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />পীলাতনি দাওহা নাংগ্রাফ্রা যীশুখৌ রাজমহল সিঙাও লাংদৗং, আরৗ গাছেন দাওহা নাংগ্রাফ্রা বিনি সৗরগিদিং জ'জাদৗং। <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />বিছৗরৗ যীশুনি সি'খৌ খুনানৈ বিনৗ গৗজা রংনি খসাব গানহৗদৗং। <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />আরৗ সুজাইনি বিন্ডৗংখৌ মুকুট বাদি হেবনানৈ খর'য়াও হমহৗদৗং, আরৗ আগ্ডা আখাইয়াও গংছে লাওঠি লাহৗদৗং, বিনিফ্রায় বিনি সিগাঙাও হান্ঠুখরাইনানৈ বিখৌ হাজিগদাওনানৈ বেবাদি হৗন্দৗং, “গৗজৗনথৗং, যিহূদিয়ারিনি রাজা!” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />বিছৗরৗ বিনিয়াও মুজুদেৎদৗং, আরৗ লাওঠি লানানৈ বিখৌ খর'য়াও গলে গলে বুদৗং। <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />আরৗ বিছৗরৗ হাজিগদাওনায়নি উনাও, গানহৗনায় খসাবখৌ খুফিন্নানৈ বিনৗ গাওনি সিখৌখৌ গানহৗফিনদৗং, আরৗ ক্রুশয়াও দৗখঠাবনৗ বিখৌ লানানৈ থাংদৗং।<verse eid="MAT 27:31" /></para>
  <para style="s">যীশুখৌ ক্রুশয়াও দৗখঠাবনায়</para>
  <para style="r">(<ref loc="MRK 15:21-32">মার্ক 15:21–32</ref>; <ref loc="LUK 23:26-43">লূক 23:26–43</ref>; <ref loc="JHN 19:17-27">যোহন 19:17–27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />আরৗ জেব্লা বিছৗরৗ বাইরাও থাংদৗংছৈমৗন, বিছৗরৗ কুরীণীয়নি শিমোন নামনি সাছে মানসিখৌ লামায়াও লৗগৗ মৗন্নানৈ যীশুনি ক্রুশখৌ বিনৗ ব্রা ব্রা বানহৗবায়। <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />আরৗ বিছৗরৗ গলগাথা নামনি মৗনছে জায়গায়াও লাংদৗং, বে জাবায়, “খরঃ বেগেংনি জায়গা” <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />বিয়াও বিছৗরৗ যীশুনৗ গৗখা রস গলাইনায় দ্রাক্ষা বিদৈখৌ লৗংনৗ হৎদৗং, নাথায় যীশুআ বিখৌ ছাখিনানৈ লৗঙাখৈছৈ। <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />জেব্লা বিছৗরৗ বিখৌ ক্রুশাও ডৗখ্ঠাবনায়, <figure style="fig" alt="Jesus was crucified" file="cn01840.jpg" size="col" loc="paw" copy="© DCC" ref="27:35">যীশুখৌ ক্রুশয়াও দৗখঠাবনায়</figure>বিছৗর সিঠিক গেলেনানৈ যীশুনি সি'খৌ রান্জলায়বায়। <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />আরৗ জিরাইনানৈ বিছৗরৗ বিহা বিখৌ নেবায় থাদৗং। <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />আরৗ বিখৌ দসি খৗলামনায়নি নামৈ বেবাদি লিৎনানৈ বিনি খর'নি গৗজৌয়াও ছৈনানৈ হৗবায়: “বে যীশু, যিহূদিয়ারিনি রাজা” <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />বিছৗরৗ যীশুজৗং লৗগৗছে সানৈ ডাখুফৗরখৌবৗ ক্রুশয়াও ডৗখ্ঠাবনায় সাছেখৌ বিনি আগ্ডাঠিং আরৗ গুবুন সাছেখৌ আখছিঠিং। <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />বে সমাও জাইফ্রা বে লামাজৗং থাংয়াছৈ, বিছৗরৗ গাওছৗরনি খর'খৌ ঠিখং ঠিখং খৗলামনানৈ বিখৌ নিন্দিনান <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />হৗনবায়, “নৗংনৗ অৗঙা মৗন খৗমাছৗ, মন্দিরখৌ ছিফাইনানৈ সানথামজৗং লুখাংফিনগ্রায়া! নৗং ঈশ্বৗরনি বিসা হৌয়ালা, দানৗ নৗং ক্রুশনিফ্রায় অৗংখাৎবৗ আরৗ গাওখৌ বাছায়দৗ!” <verse eid="MAT 27:40" /><verse number="41" style="v" sid="MAT 27:41" />বেবাদিনৗ গাহায় যাজকফ্রা আরৗ আইন গুরুফ্রা আরৗ প্রাচীনফৗরা যীশুখৌ হাজিগদাওদৗং। <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“বিয়ৗ গুবুনফৗরখৌ বাছাইগ্রা, নাথায় গাওখৌ বিয়ৗ মানৗ বাছাইনৗ হায়া! বিনৗ ইস্রায়েলনি রাজা, বিয়ৗ দানৗ ক্রুশনিফ্রায় অৗংখাৎবৗথৗং অব্লা জৗঙৗ বিখৌ ফৗথায়নায়! <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />বিয়ৗ ঈশ্বৗরনিয়াও ভরসা খৗলামৗ, দা ঈশ্বৗরা বিখৌ বাছাইথৗং, বাছাইনৗ লুবৈয়ৗব্লা মানৗনা বিয়ৗ বুংনানৈ লাদৗংমৗন, ‘আং ঈশ্বৗরনি বিসাজ্লা।’” <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />বিবাদিনৗ জাইফ্রা বিজৗং ক্রুশয়াও দৗখঠাবজানায় ডাখুফ্রাবৗ যীশুখৌ দিন্ঠিদৗং।<verse eid="MAT 27:44" /></para>
  <para style="s">যীশুনি থৈনায়</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />সানজুফু বারোটানিফ্রায় বেলাছিনি তিনটাসিম গাছেন হাদৎনাও খৗমশি ফৈদৗংমৗন। <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />তিনটাও যীশুআ গৗব্রাবমৈ গাবজ্রিনানৈ হৗন্দৗং, “এলী, এলী, লামা শবক্তানি,” বেনি অৗংথিয়া জাবায়, “আংনি ঈশ্বৗর, আংনি ঈশ্বৗর, নৗঙৗ আংখৌ মানৗ নাগারখৗ?”<note caller="+" style="x"><char style="xo" closed="false">27:46 </char><char style="xt" closed="false"><ref loc="DEU 1">হূদা বিজাব</ref></char></note> <verse eid="MAT 27:46" /><verse number="47" style="v" sid="MAT 27:47" />আরৗ জাইফ্রা খাঠিয়াও গছংনানৈ দৗংমৗন, বিছৗরনি খাইছেয়া বে গাবজ্রিনাইখৌ খৗনানানৈ হৗন্দৗং, “বিয়ৗ এলিয়খৌ গাবজ্রিদৗং!” <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />বে সমাও বিছৗরনি গেজেরাও সাছেয়া খাৎলাংনানৈ ছৗবখাংগ্রা মৗঙাজৗং গৗখৈ আংগুর বিদৈখৌ ছৗবখাংহৗদৗং, আরৗ বিখৌ নৗলৗ গন বিজৌয়াও ঠুনানৈ যীশুনৗ লৗংনৗ জাছিদৗং। <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />নাথায় গুবুনফ্রা হৗনদৗং, “দে, নায়নি! এলিয়আ বিখৌ বাছাইনৗ ফৈয়ৗ নামা!” <verse eid="MAT 27:49" /><verse number="50" style="v" sid="MAT 27:50" />আরৗ জেব্লা যীশুআ গৗব্রাবমৈ গাবজ্রিনানৈ গাওনি জিউখৌ হগারদৗং। <verse eid="MAT 27:50" /><verse number="51" style="v" sid="MAT 27:51" />বে সমাও মন্দিরনি সি' খৗংনাইয়া গৗজৌনিফ্রায় গাহায়সিম খাওনৈ স্রা জিখাওদৗং। আরৗ হ্বায়াও গাংগ্রিম মাওদৗং, আরৗ অন্ঠাইফ্রা গাওফ্রুদৗং। <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />আরৗ গৗথৈ হাখরফ্রা গেওদৗং, আরৗ মৗদৗমাও থৈনানৈ থাংনায় গৗবাং ঈশ্বৗরনি মানসিফ্রা জিউয়াও ঠাংখাংফিনদৗং। <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />আরৗ যীশু ঠাখাংফিননাইনি উনাও বিছৗরৗ গৗথৈ দন্দরনিফ্রায় অৗংখাৎনানৈ গৗথার নৗগৗরাও থাংনানৈ গৗবাং মানসিফৗরজৗং নুজাহৈদৗং। <verse eid="MAT 27:53" /><verse number="54" style="v" sid="MAT 27:54" />জেব্লা শতপতি আরৗ জাইফ্রা লৗগৗছে যীশুখৌ নেয়িন দৗংমৗন বি সমাও গাংগ্রিম মাওনায় আরৗ গাছেন জানায়ফৗরখৌ নুনানৈ বিছৗরৗ গিখ্রংনানৈ হৗন্দৗং, “নংথারগৌয়ৈ বে মানসিয়া ঈশ্বৗরনি বিসাহৌয়ামৗন!” <verse eid="MAT 27:54" /><verse number="55" style="v" sid="MAT 27:55" />আরৗ বিহা গৗবাংথার হিন্জাওফৗর দৗংমৗন, গৗজানাও থানানৈ নাইহৎদৗংমৗন। বিছৗরৗ যীশুনি দাও দাও খৗছায়ৈ খৗছায়ৈ গালীলনিফ্রায় বিহা ফৈবায়। <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />বিছৗরনি গেজেরাও মগ্দলীনী মরিয়ম, যাকোব আরৗ যোষেফনি বিমা সিবদিয়নি হিন্জাও মরিয়মাবৗ দৗংমৗন।<verse eid="MAT 27:56" /></para>
  <para style="s">যীশুখৌ ফবনায়</para>
  <para style="r">(<ref loc="MRK 15:42-47">মার্ক 15:42–47</ref>; <ref loc="LUK 23:50-56">লূক 23:50–56</ref>; <ref loc="JHN 19:38-42">যোহন 19:38–42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />মৗনাবিলি সমাও অরিমথিয়ানিফ্রায় সাছে ধনি মানসি বিয়াও ছফৈদৗং, বিনি নামমা যোষেফ, বিয়ৗ গাওবৗনৗ সাছে যীশুনি ছেলামৗন। <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />বিয়ৗ পীলাতনিয়াও থাংনানৈ যীশুনি মৗদৗমখৌ বিহৈদৗং, আরৗ পীলাতনা বিনৗ হৗৎনৗ হুখুম হৗদৗং। <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />যোষেফমা যীশুনি মৗদৗমখৌ লাংনানৈ পরিষ্কার মিস মিস গাংছে সি'জৗং ফানফবদৗং, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />আরৗ গেদেৎ অন্ঠাইখৌ দানখানানৈ বানাইগৗদান গাওনি খুর নায় গৗথৈ দন্দরাও দৗনহৈদৗং। বিয়ৗ গেদেৎ থাইছে অন্ঠাইখৌ গৗথৈ দন্দর মৗখাংয়াও নাৎথ্রৗনানৈ দৗনথেনান থাংবায়। <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />মগ্দলীনী মরিয়ম আরৗ গুবুন সাছে মরিয়মাবৗ বিয়াও গৗথৈ দন্দরনি ঠিঙৈ মৗখাং জানানৈ জিরাইবায় থাদৗংমৗন।<verse eid="MAT 27:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />নখানায়, গাহায় যাজকফৗর আরৗ ফরীশীফ্রা পীলাতনিয়াও থাংদৗং। <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />বিছৗরৗ বুংবায় “মানিনাং নৗংথাং, জৗং গৗসৗখাংদৗং বি ধোকাহৗগ্রায়া, গৗঠাঙৈ থানায় সমাও বুংদৗংমৗন ‘আঙৗ সানথামাও ঠাংখাংফিনায়।’ <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />বিনিখায় নৗং বিনি গৗথৈ দন্দরাও সানথামসিম গৗরায়ৈ নেহৈনৗ হুখুম হৗদৗ। নাথেব্লা ছেলাফ্রা বিনি মৗদৗমখৌ খাওনানৈ লাংনায় আরৗ মানসিফৗরখৌ বুংনায় ‘বিয়ৗ থৈনানৈ ঠাংখাংফিনবায়।’ বেবাদি জাব্লা সিগাংনিখুরৈ জৗবথানায়নি ছৗলৈজানাইয়া গাজ্রিসিন্থার জানায়।” <verse eid="MAT 27:64" /><verse number="65" style="v" sid="MAT 27:65" />পীলাতনা উত্তর হৗবায়, “নেগ্রাফৗরখৌ লাংদৗ আরৗ থাং, নৗংছৗরৗ থাংনানৈ গৗথৈ দন্দরখৌ হাগৌমানি মৗজাংয়ৈ নেহৈদৗ আরৗ নৗংছৗরৗ মিথিখাগৌ বেখৌ মাব্রৈহায় খৗলাম নাংগৌ।” <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />আরৗ বিছৗরৗ থাংনানৈ গৗথৈ দন্দরখৌ ফাংথেনায় অন্ঠাইয়াও সীলমহর বুথেবায়, আরৗ পাহাড়া হৗগ্রাফৗরখৌ পাহাড়া হৗহৗবায়।<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">যীশুনি ঠাংখাংফিননায়</para>
  <para style="r">(<ref loc="MRK 16:1-10">মার্ক 16:1–10</ref>; <ref loc="LUK 24:1-12">লূক 24:1–12</ref>; <ref loc="JHN 20:1-10">যোহন 20:1–10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />নখা নায়ৈ সাব্বাথনি উনাও সপ্তানি প্রথমদিননি ফুংজানি মগ্দলীনী মরিয়ম, আরৗ গুবুন সাছে মরিয়মা গৗথৈ দন্দরাও নায়নৗ থাংদৗংমৗন। <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />ঠাবনৗ গেদেৎ গাংগ্রিম মাওদৗং, আরৗ সাছে ফৗরবুনি আরফ'আ স্বৗর্গৗনিফ্রায় অৗংখাৎবৗনানৈ গৗথৈ দন্দরাও ফাংথেনায় অন্ঠাইখৌ নাৎথ্রৗথনানৈ বিনি ছায়াও জিরাইদৗং। <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />বিনি মৗখাঙা অখা মৗফ্লামনায় বাদি, আরৗ গান্নায় সি'য়া বরফ বাদি গুফুৎ মৗন। <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />বিখৌ নুনানৈ নেগ্রাফ্রা গিনায়জৗং থৗর থৗর মাওদৗং, আরৗ থৈনায় বাদি জাদৗং। <verse eid="MAT 28:4" /><verse number="5" style="v" sid="MAT 28:5" />আরফ'আ হিন্জাওফৗরখৌ হৗন্দৗং, “দাগি, আঙৗ মিথিগৌ নৗছৗরৗ ক্রুশয়াও দৗখঠাব জানায় নাসরৎনি যীশুখৌ নায়গিৎদৗং। <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />বিয়ৗ বেহা গৈলে, বিয়ৗ গাও জেরৈ বুংদৗংমৗন, বেবাদিনৗ বিয়ৗ ঠাংখাংফিনবায়! ফৈ বিখৌ দৗন্নায় জায়গাখৌ নাইফৈ। <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />আরৗ বিছৗরৗ গৗখ্রৈ থাংনানৈ বে খৗথাখৌ বিনি ছেলাফৗরনৗ খৗথাহৈদৗ, ‘বিয়ৗ থৈনায়নিফ্রায় ঠাংখাংফিনবায়, আরৗ বিয়ৗ নৗংছৗরনি সিগাং গালীলয়াও থাংনায়, দা, আং নৗংছৗরনৗ রাইঠিখানায় বাদি নৗংছৗরৗ বিহা বিখৌ নুনৗ মৗনহৈনায়।’”<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />বিনিখাইনৗ হিন্জাওফ্রা গৗথৈ দন্দরনিফ্রায় হাখু দাখু থাংবায়। আরৗ বিছৗরৗ গিদৗংমৗনব্লাবৗ গেদেৎ রংজানায়জৗং আরফ'নি রাইঠিনায় খৗথাখৌ ছেলাফৗরনৗ খৗথানৗ থাখৈ খাৎলাংবায়। <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />ঠাবনৗ যীশুআ বিছৗরখৌ লৗগৗ লাবায় আরৗ বিয়ৗ বুংবায়, “গৗজৗনথৗং।” আরৗ বিছৗরৗ যীশুনি খাঠিয়াও থাংনানৈ বিনি আঠেংখৌ হমনানৈ খুলুমবায়। <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />অব্লা যীশুআ বিছৗরখৌ হৗনবায়, “দাগি, থাং, নৗংছৗরৗ আংনি ফংবায়ফৗরখৌ গৗখ্রৈনৗ গালীলয়াও থাংনৗ থৗনদৗ, বিছৗরৗ বেয়াও আংখৌ নুনায়।”<verse eid="MAT 28:10" /></para>
  <para style="s">নেগ্রাফৗর খৗথাহৈনায়</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />জেব্লা হিন্জাওফ্রা গাওছৗরনি লামাও দংমৗন, অব্লা নেগ্রাফৗরনি খাইছেয়া নৗগৗরাও থাংনানৈ জানায় গাছেনখৌবৗ গাহায় যাজকফৗরনৗ খৗথাহৈদৗং। <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />জেব্লা গাহায় যাজকফ্রা, প্রাচীনফৗরা জ'জানানৈ সানজ্লাইনানৈ নেগ্রাফৗরনৗ গৗবাং টাকা হৗবায়, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />বিছৗরখৌ বুংবায়, “নৗছৗরৗ বুং যে, ‘জৗং হরাও উন্ডুলাংনাইয়াওনৗ বিনি ছেলাফ্রা ফৈনানৈ বিনি মৗদৗমখৌ খাওনানৈ লাংবায়।’ <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />আরৗ বে খৗথায়া শাসনগিরিনি খৗমাও ছৗইয়ৗব্লা, জৗঙৗ বিখৌ সৗমজাইনায় জাহাথে নৗংছৗরৗ খৈফৗদনাও গৗগ্লৈয়িবাদি।” <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />নেগ্রাফ্রা টাকাখৌ লানানৈ বিছৗর থৗননায় বাদিনৗ বুংবায়, আরৗ বি খৗথায়াওনৗ দৗনৈসিমবৗ যিহূদীফৗরনি গেজেরাও ফৗস্রাওজানানৈ দং।<verse eid="MAT 28:15" /></para>
  <para style="s">ছেলাফৗরজৗং যীশুনি নুজানায়</para>
  <para style="r">(<ref loc="MRK 16:14-18">মার্ক 16:14–18</ref>; <ref loc="LUK 24:36-49">লূক 24:36–49</ref>; <ref loc="JHN 20:19-23">যোহন 20:19–23</ref>; <ref loc="ACT 1:6-8">প্রেরিত 1:6–8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />এগারোজন ছেলাফৗরখৌ গালীলনি হাজৗয়াও যীশুনি থৗন্নায় বাদি থাংবায়। <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />জেব্লা ছেলাফ্রা যীশুখৌ নুনানৈ খুলুমদৗং, অব্লাবৗ বিছৗরনি খাইছে খাইছেয়া গৗনৗ গৗথৗ জাদৗং। <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />নাথায় যীশুআ বিছৗরনি খাঠিয়াও ফৈনানৈ বিছৗরখৌ হৗন্দৗং, “স্বৗর্গৗ আরৗ বুহুমাও গাছেন একথিয়ারখৌ আংনৗ হৗনায় জাবায়। <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />বিনিখাইনৗ নৗছৗরৗ জেরৗওবৗ থাং, আরৗ গাছেন জাতিমানিখৌ ছেলা খৗলাম, বিফা বিসা আরৗ গৗথার জিউনি নামমৈ বাপ্তিস্মা হৗ। <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />আং নৗংছৗরনৗ যে আদেশফৗরখৌ হৗবায় বেফৗরখৌ ফালিনৗ বিছৗরখৌ ফৗরৗং। আরৗ নাই, আঙৗ জৗবনায়সিম জেব্লায়বৗ নৗংছৗরজৗং লৗগৗয়াও দং।”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>