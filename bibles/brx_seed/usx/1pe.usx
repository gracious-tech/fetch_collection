<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1PE" style="id">1PE–MECH</book>
  <para style="h">1 পিতর</para>
  <para style="toc3">1 পিত</para>
  <para style="toc1">পিতরনি প্রথম লাইজাম</para>
  <para style="toc2">1 পিতর</para>
  <para style="mt">পিতরনি প্রথম লাইজাম</para>
  <para style="is">বিজাবনি রাইফৗথনায়</para>
  <para style="ip">পিতরনি প্রথম লাইজামাও এশিয়া মাইনরনি গাছেনবৗ ছা-হাদৎনি ছেৎখাই ফেৎখাই খাৎলাংনানৈ থাহৈনায় খ্রীষ্টিয়ানফৗর, বে জাবায় ঈশ্বৗরনি সাইখ'জানায় মানসিফৗরনি থাখৈ বুংদৗং। লাইজামনি নংগৌথার খবরা জাবায়, ফৗরাইগ্রাফৗরনৗ গৗহৗ হৗনৗ, জাইফ্রা খ্রীষ্টখৌ ফৗথাইনায়খায় হৗছৗদৗং, যীশু খ্রীষ্টনি থৈনায়, জিখাংফিন্নায় আরৗ ফৈফিন্নায়নি জবান হৗনায়খৌ গৗসৗখাংহৗনানৈ লিৎগিরিয়া ফৗরাইগিরিফৗরনৗ ভরসা হৗদৗং, বিছৗরৗ বেখৌ লানানৈ গাওছৗরনি নাছয়জানায়ফৗরাও সৈনৗ আরৗ বে বিচারনি ফৗথাইনায়নি আনজাদছৗ হৗন্নানৈ ফৗথাইনৗ আরৗ, “যীশু খ্রীষ্টনি নুজাফৈনায় দিনাও” মৗননাংগৌ ফিথাইখৌ মৗননায় হৗন্নানৈ ফৗথাইনৗ হানায় বাদিসৗ। সৈনাংনায়নি সমাও গৗহৗ হৗনায়জৗং লৗগৗছে, খ্রীষ্টনি মানসিফৗর হৗন্নানৈ গাওছৗরখৌ দিন্ঠিনৗ লিৎগিরিআ ফৗরাইগ্রাফৗরখৌ গৗরায়ৈ থৗন্দৗং।</para>
  <para style="iot">বিষয়ফৗর</para>
  <para style="io1">রাইফৗথনায় <char style="ior">(<ref loc="1PE 1:1-2">1:1–2</ref>)</char></para>
  <para style="io1">ঈশ্বৗরা বৗখাংগ্রা হৗন্নানৈ গৗসৗখাংহৗনায় <char style="ior">(<ref loc="1PE 1:3-12">1:3–12</ref>)</char></para>
  <para style="io1">গৗথার খামানি ফৗরৗংনায় <char style="ior">(<ref loc="1PE 1:13-2:10">1:13—2:10</ref>)</char></para>
  <para style="io1">সৈনাংনায় সমাও খ্রীষ্টিয়ানফৗরনি মাওনাংগৌ <char style="ior">(<ref loc="1PE 2:11-4:19">2:11—4:19</ref>)</char></para>
  <para style="io1">খ্রীষ্টিয়ানফৗরনি সাবধানৈ থাবায়নায় <char style="ior">(<ref loc="1PE 5:1-11">5:1–11</ref>)</char></para>
  <para style="io1">লাইজামনি জৗবনায় খৗথা <char style="ior">(<ref loc="1PE 5:12-14">5:12–14</ref>)</char></para>
  <chapter number="1" style="c" sid="1PE 1" />
  <para style="s">মৗনছে গৗঠাং আশানি থাখৈ ঈশ্বৗরখৌ বাখ্নাইনায়</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1" />আং পিতর, যীশু খ্রীষ্টনি সাছে প্রেরিত, ঈশ্বৗরনি সাইখজানাইফৗরনি থাখৈ, জাইফ্রা পন্ত, গালাতীয়া, কাপ্পাদকিয়া, এশিয়া আরৗ বিথুনিয়া হাদৎনাও ছৈৎখাই-ফৈৎখায় জানানৈ দং, বিছৗরনি থাখৈ, <verse eid="1PE 1:1" /><verse number="2" style="v" sid="1PE 1:2" />আরৗ জাইফ্রা বিফা ঈশ্বৗরনি সিগাংনৗ মিথিনায় জ্ঞাননি দারৈ, জিউনি গৗথার খামানিনি গেজেরজৗং যীশু খ্রীষ্টনি আজ্ঞা মানিনায়নি থাখৈ আরৗ বিনি থৈয় সারস্রিনায়নি গেজেরজৗং নিসথার খৗলামদৗং। অনুগ্রহ আরৗ শান্তিয়া নৗংছৗরনিয়াও গৗবাং গৗবাং থাথৗং। <verse eid="1PE 1:2" /><verse number="3" style="v" sid="1PE 1:3" />জৗংনি ফৗরবু যীশু খ্রীষ্টনি বিফা ঈশ্বৗরা বাখ্নাইজাথৗং! বিনি গেদেৎ দয়াজৗং বিয়ৗ জৗংনৗ যীশু খ্রীষ্টনি থৈনায়নিফ্রায় ঠাংখাংফিননায়নি গেজেরজৗং গৗঠাং আশানি গৗদান জৗনৗম হৗবায়। <verse eid="1PE 1:3" /><verse number="4" style="v" sid="1PE 1:4" />আরৗ উত্তরাধিকারয়াও জেয়া মাব্লাবৗ ধ্বংস জায়া, গাজ্রি জায়া কিন্বা রহায়লাঙা আরৗ বে উত্তরাধিকারিয়া নৗংছৗরনি থাখৈ স্বৗর্গৗয়াও দৗন্নায় জাবায়। <verse eid="1PE 1:4" /><verse number="5" style="v" sid="1PE 1:5" />আরৗ ঈশ্বৗরনি বৗলৗজৗং নৗংছৗরবৗ ফৗথাইনায়নি দ্বারৈ রক্ষা মৗন্নৗ, যে উদ্ধাররা জৗবনায় সমাও নুজানায়নি থাখৈ ঠাম ঠিম দং। <verse eid="1PE 1:5" /><verse number="6" style="v" sid="1PE 1:6" />বেনিখাইনৗ বে গাছেনাওবৗ নৗংছৗরৗ গেদেৎনৈ রংজাদৗং, যদিও বে গাছেন রৗখৗমনি আনজাৎফৗর ছফৈনায়জৗং নৗংছৗরৗ দা দান্দৈছেনি থাখৈ সৈনাংদৗং। <verse eid="1PE 1:6" /><verse number="7" style="v" sid="1PE 1:7" />বে আনজাৎফ্রা নৗংছৗরনিয়াও ফৈবায় জাহাথে নৗংছৗরনি ফৗথাইনায়া পরিক্ষা লাজানায় আরৗ নংগৌ প্রমাণ হৗজানায়। নৗংছৗরনি ফৗথাইনায়া সোনা বাদি আনজাৎ লাজানায় জেয়া অয়ৎজৗং সাফা আরৗ আদ্রি খৗলামজানায় আরৗ বেনি মূল্যয়া বাংসিন জানায় আরৗ বেবাদিব্লাছৗ যীশু খ্রীষ্টনি নুজানায় সমাও নৗংছৗরৗ বাখ্নায়জানায়, মহিমা গৗনাং জানায়, আরৗ মান মৗননায়। <verse eid="1PE 1:7" /><verse number="8" style="v" sid="1PE 1:8" />নৗংছৗরৗ বিখৌ নুয়াখৈব্লাবৗ অন্নৗ, আরৗ নৗংছৗরৗ দা বিখৌ নুয়াখৈব্লাবৗ ফৗথায়ৗ আরৗ খৗথাজৗং বুংছনৗ হায়িজাছে আরৗ বুংছনৗ হায়িজাছে বাখ্নাইয়ৗ, <verse eid="1PE 1:8" /><verse number="9" style="v" sid="1PE 1:9" />মানৗনা খ্রীষ্টখৌ ফৗথাইনায়জৗং জৗবনায়াও নৗংছৗরৗ জিউমানি উদ্ধারখৌ নাজাওয়ৗ। <verse eid="1PE 1:9" /><verse number="10" style="v" sid="1PE 1:10" />নবিফ্রা বৈ অনুগ্রহনি খৗথা বুংদৗংমৗন জেয়া নৗংছৗরনিয়াও ফৈনায় আরৗ বিছৗরৗ বে উদ্ধারনি বিষয়ৈ আরবাও বাংসিন মিথিনৗ থাখৈ গেদেৎ জৗথৗনজৗং আরৗ গৗসৗমানিজৗং ফিৎ ফিৎ নাগিৎদৗংমৗন। <verse eid="1PE 1:10" /><verse number="11" style="v" sid="1PE 1:11" />মসিহনি সৈনাংনায় আরৗ বিনি উনাও মহিমা গৗনাং জানায়, বেখৌ বিছৗরনিয়াও দংনায় খ্রীষ্টনি জিউয়া জেব্লা নবিফৗরনৗ সিগাংনৗ বুঙৗ, অব্লা বে সমা মাব্লা আরৗ মাবাদিয়ৈ ছফৈনায়, বেখৌ নবিফ্রা মিথিনৗ বিরাঠনৗ হাস্থাইদৗংমৗন। <verse eid="1PE 1:11" /><verse number="12" style="v" sid="1PE 1:12" />ঈশ্বৗরনি সেবাখৌ বিছৗরনৗ মিথিহৗনৗ, যে বিছৗরনি মাওনায়া গাওছৗরনি জুনৈ অৗঙা, নাথায় নৗংছৗরনি থাখৈছৗ। স্বৗর্গৗনিফ্রায় থৗনহৎজানায় গৗথার জিউনি দৈদেন্নায়জৗং জাইফ্রা খ্রীষ্টনি মৗজাং খবরখৌ খৗথাদৗং, বেবাদিনৗ নৗংছৗরনৗ নবিফ্রাবৗ মিথিহৗবায়। বেখৌ মিথিনৗ এমন কি আরফ'ফ্রা বিরাঠনৗ হাস্থাইয়ৗ।<verse eid="1PE 1:12" /></para>
  <para style="s">গৗথার খামানি গৗনাং</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13" />বিনিখাইনৗ, নৗংছৗরৗ খামানি মাওনৗ থাখৈ গাওনি গৗসৗফৗরখৌ থিয়ারি খৗলাম আরৗ গাওখৌ হমথানানৈ যীশু খ্রীষ্টনি নুজাহৗজানায় সমাও, যে অনুগ্রহয়া নৗংছৗরনিয়াও ফৈনায়, বেখৌ নৗংছৗরৗ আশা লাখিনানৈ থা। <verse eid="1PE 1:13" /><verse number="14" style="v" sid="1PE 1:14" />ঈশ্বৗরখৌ মানিগ্রা বিসাফৗরবাদি, আরৗ নৗংছৗর ঈশ্বৗরখৌ মিথিয়ি সমাও, জেরৈ গাজ্রি লুবৈনায়ফৗরজৗং দৈদেনজাদৗংমৗন, বেবাদি দাদৈদেনজা। <verse eid="1PE 1:14" /><verse number="15" style="v" sid="1PE 1:15" />নাথায় জাই ঈশ্বৗরা নৗংছৗরখৌ লিংহৎদৗং বিয়ৗ জেরৈ গৗথার, বেবাদিনৗ নৗংছৗরৗ গাছেন মাওনায়ফৗরাও গৗথার জা, <verse eid="1PE 1:15" /><verse number="16" style="v" sid="1PE 1:16" />মানৗনা লিৎনায় দং: “নৗংছৗরৗ গৗথার জা, মানৗনা আঙৗ গৗথার<note caller="+" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="LEV 11:44-45">লেবীয় বিজাব 11:44–45</ref>; <ref loc="LEV 19:2">19:2</ref></char></note>।” <verse eid="1PE 1:16" /><verse number="17" style="v" sid="1PE 1:17" />আরৗ জাইয়া জেরৈ মাওদৗং, বিখৌ বিয়ৗ বেবাদিনৗ বিচার খৗলামৗ, বিয়ৗ রাওখৌবৗ মৗখাং নাইয়া, নৗংছৗরৗ জৗরৈ বিখৌ বিফা হৗন্নান লিঙৗ, বিবাদিয়ৈ নৗংছৗরৗ গুবুন হাদৗৎনি মানিসিফৗর বাদি বেহা ঠাংনানৈ থানায় সমসিম, বিখৌ মান হৗদৗ আরৗ গিদৗ। <verse eid="1PE 1:17" /><verse number="18" style="v" sid="1PE 1:18" />মানৗনা নৗংছৗরৗ মিথিগৌ, নৗংছৗরনি আজৌ আজৈফৗর নৗংছৗরনৗ গথাইলাংনায় খালি জীবন লামানিফ্রায় নৗংছৗরখৌ রুপা কিন্বা সোনাজৗং বায়ফিনাখৈ, <verse eid="1PE 1:18" /><verse number="19" style="v" sid="1PE 1:19" />নাথায় খ্রীষ্টনি দাম গৗছা থৈজৗংসৗ, দায় গৈয়ি কিন্বা দাগ গৈয়ি মেন্ডা বিসানি গেজেরজৗং নৗংছৗরখৌ বায়খৗদৗং। <verse eid="1PE 1:19" /><verse number="20" style="v" sid="1PE 1:20" />সংসারখৌ সৗরজিনায়নি সিগাংনৗ বিয়ৗ ঈশ্বৗরজৗং সাইখজাখাদৗং মৗন, নাথায় জৗবনায়াও নৗংছৗরনি থাখৈ বিয়ৗ নুজাফৈবায়। <verse eid="1PE 1:20" /><verse number="21" style="v" sid="1PE 1:21" />বিনি গেজেরজৗং নৗছৗরৗ ঈশ্বৗরখৌ ফৗথাইয়ৗ, জাইয়া বিখৌ থৈনায়নিফ্রায় ঠাংখাংফিনহৗনানৈ মহিমা গৗনাং খৗলামবায়, আরৗ বিজৗংনৗ নৗংছৗরনি ফৗথাইনায় আরৗ আশায়া ঈশ্বৗরনিয়াও। <verse eid="1PE 1:21" /><verse number="22" style="v" sid="1PE 1:22" />দা নৗংছৗর নংগৌখৌ মানিনায়জৗং গাওখৌ গৗথার খৗলামজাবায়, বিনিখাইনৗ নৗংছৗরনে বিদা-ফংবায় আরৗ বিবৗ-বিনানাওফৗরজৗং অনজ্লায়নায় দং, নৗংছৗরৗ গৗসৗমানিজৗং গাওজৗং গাও গৗথৌয়ৈ অনজ্লাইদৗ। <verse eid="1PE 1:22" /><verse number="23" style="v" sid="1PE 1:23" />মানৗনা আদ্রিজালাংনায় ফিথাইজৗং অৗঙা, নাথায় থৈনৗ রৗঙৈ, ঈশ্বৗরনি গৗঠাং আরৗ ঈশ্বৗরনি সহায়নৗ হাথাও বৗচৗন জৗং নৗংছৗরৗ গৗদান জৗনৗম জাফিনহৗজাবায়। <verse eid="1PE 1:23" /><verse number="24" style="v" sid="1PE 1:24" />শাস্ত্রয়া বুঙৗ, “গাছেন মানসি মানিয়ানৗ গাংসৗ বাদি, আরৗ বিছৗরনি মহিমা সমাইনায়ফ্রাবৗ ফৗথারনি বিবারফৗর বাদি<note caller="+" style="x"><char style="xo" closed="false">1:24 </char><char style="xt" closed="false"><ref loc="ISA 40:6-8">যিশাইয় 40:6–8</ref> </char></note> গাংসৗয়া রানলাঙৗ, বিবারফ্রা সিরিয়ৗ, <verse eid="1PE 1:24" /><verse number="25" style="v" sid="1PE 1:25" />নাথায় ফৗরবুনি বৗচৗননা জেব্লাইবৗ থায়ৗ।” আরৗ বেনৗ বৗচৗন মৗজাং খবর বুংনায়া, জেখৌ নৗংছৗরনিয়াও ফৗস্রাওনায় জৗদৗং।<verse eid="1PE 1:25" /></para>
  <chapter eid="1PE 1" />
  <chapter number="2" style="c" sid="1PE 2" />
  <para style="s">গৗথার অন্ঠাই আরৗ গৗথার জৗলৈ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1" />বিনিখাইনৗ, গাছেন রৗখৗমনি গাজ্রি খৗলামনায়, ঠগাইনায়, দিন্ঠিফ্লানায়, মগন ছানায়, আরৗ মৗনফ্রৗম রৗখৗমনি নিন্দিজ্লাইনায় খৗথাফৗরখৌ নাগারদৗ। <verse eid="1PE 2:1" /><verse number="2" style="v" sid="1PE 2:2" />সারিজাগদান গথ'ফৗর বাদি খাট্টি আত্মিক গাইখেরখৌ ছৗবনৗ জেব্লাইবৗ লুবৈ, বেবাদিয়ৈ জাহাথে নৗংছৗরবৗ উদ্ধারনি থাখৈ দেৎলাংনৗ হায়ৗ। <verse eid="1PE 2:2" /><verse number="3" style="v" sid="1PE 2:3" />দা নৗংছৗরৗ পরীক্ষা খৗলামনান মৗনখাবায় যে ফৗরবুআ মৗজাং<note caller="+" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="PSA 34:8">গীতফৗর 34:8</ref></char></note>। <verse eid="1PE 2:3" /><verse number="4" style="v" sid="1PE 2:4" />জৗরৈ নৗছৗরৗ বিনিয়াও ফৈয়ৗ, গৗঠাং অন্ঠাইয়া মানসিজৗং এৎগারজাদৗং, নাথায় ঈশ্বৗরজৗং সাইখজায়ৗ আরৗ বিনিয়াও দাম গৗছা। <verse eid="1PE 2:4" /><verse number="5" style="v" sid="1PE 2:5" />নৗংছৗরবৗ, গৗঠাং অন্ঠাইফৗর বাদি, আরৗ গৗঠাং অন্ঠাই জানানৈ আত্মিক ন্ব' লুজা, বিয়াও নৗঙৗ গৗথার যাজক জানানৈ ঈশ্বৗরনিয়াও, যীশু খ্রীষ্টনি গেজেরজৗং নাজাও জাথাওথাও আত্মিক বুলি হৗনৗ হানায়। <verse eid="1PE 2:5" /><verse number="6" style="v" sid="1PE 2:6" />মানৗনা শাস্ত্রয়াও বুঙৗ, “নাই, আঙৗ সিয়োননাও থাইছে অন্ঠাই দৗনবায়, সাইখবায় আরৗ কোণানি দাম গৗছা অন্ঠাই খৗলামবায়, আরৗ জাইয়া বিখৌ ফৗথায়ৗ,<note caller="+" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="ISA 28:16">যিশাইয় 28:16</ref> </char></note> বিয়ৗ মাব্লাবাবৗ লাজিনায় অৗঙা।” <verse eid="1PE 2:6" /><verse number="7" style="v" sid="1PE 2:7" />বিনিখাইনৗ নৗংছৗর ফৗথাইগ্রাফৗরনি থাখৈ বে অন্ঠাইয়া গেদেৎ দাম গৗছা। নাথায় জাইফ্রা ফৗথাইয়া বিছৗরনি থাখৈ, “ন্ব' লুগ্রাফৗরজৗং এৎগারজানায় অন্ঠাইয়া<note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="PSA 118:22">গীতফৗর 118:22</ref></char></note> বয়নিখুরৈ কোণানি অন্ঠাই জাবায়।” <verse eid="1PE 2:7" /><verse number="8" style="v" sid="1PE 2:8" />আরৗ, “অৗরৈ বাদি অন্ঠাই জাবায়, মানসিফ্রা বিয়াও ছৌখুঠুনায়, আরৗ বে অন্ঠাইয়া বিছৗরখৌ খৗখ্লৈনায়।” মানসিফ্রা ঈশ্বৗরনি খৗথাখৌ ফৗথায়িখায় ছৌখুঠুনায়; আরৗ বে বিছৗরনি থাখৈ ঈশ্বৗরনিনৗ<note caller="+" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="ISA 8:14-15">যিশাইয় 8:14–15</ref></char></note> ফছংখানায়। <verse eid="1PE 2:8" /><verse number="9" style="v" sid="1PE 2:9" />নাথায় নৗংছৗরৗ সাইখজানায় মানসিফৗর, রাজানি যাজকফৗর, গৗথার জাতি, আরৗ মানসিফৗর জাইফ্রা ঈশ্বৗরনি, খৗমসিনিফ্রায় জাইয়া নৗংছৗরখৌ গাওনি বৗথিয়া গৗনাং স্রাংয়াও লিংনানৈ লাবৗবায়, যেন নৗংছৗরৗ বিনি বৗথিয়া গৗনাং হাবাফৗরখৌ খৗথাবাইয়ৗ আরৗ বাখ্নাইয়ৗ।<note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="EXO 19:5-6">অৗংখাৎলাংনায় 19:5–6</ref>; <ref loc="ISA 43:20">যিশাইয় 43:20</ref></char></note>। <verse eid="1PE 2:9" /><verse number="10" style="v" sid="1PE 2:10" />সিগাঙাও নৗংছৗরৗ ঈশ্বৗরনি মানসিফৗর অৗঙা মৗন, নাথায় দা বিনি মানসিফৗর জাবায়, সিগাঙাও নৗংছৗরৗ ঈশ্বৗরনি দয়াখৌ খনছেবৗ মৗন্নাখৈ মৗন, নাথায় দা নৗংছৗরৗ বিনি দয়াখৌ মৗনবায়<note caller="+" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="HOS 2:23">হোশেয়া 2:23</ref>; <ref loc="ISA 53:9">যিশাইয় 53:9</ref></char></note>।<verse eid="1PE 2:10" /></para>
  <para style="s">ঈশ্বৗরনি গলামফৗর</para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11" />আংগৗ লৗগৗফৗর, আঙৗ নৗংছৗরখৌ খাওলায়ৗ, বে সংসারাও নৗংছৗরৗ গুবুন হাদৎনি মানসি আরৗ হাদৎনিফ্রায় হৗখাৎ হৎজানায়ফৗরখৌ বাদি, নৗংছৗরৗ মৗদৗমনি লুবৈনায়ফৗরাও গৗজানাও থা, মানৗনা বেফৗরৗ জেব্লাইবৗ নৗংছৗরনি জিউমানি বিরুদ্ধ জায়ৗ। <verse eid="1PE 2:11" /><verse number="12" style="v" sid="1PE 2:12" />ঈশ্বৗরখৌ মিথিয়ি গুবুনহারিফৗরনি গেজেরাও নৗংছৗরনি আখল আখুয়া অৗরৈ বাদি মৗজাং জানাংনায়, থেওবৗ বিছৗরৗ নৗংছৗরখৌ অন্যায় মাওগ্রাফৗর হৗন্নানৈ নিন্দিব্লাবৗ নৗংছৗরনি মৗজাং মাওনায়ফৗরখৌ নুনানৈ ঈশ্বৗরনি ফৈনায় দিনাও বিছৗরৗ ঈশ্বৗরখৌ বাখ্নাইনায়। <verse eid="1PE 2:12" /><verse number="13" style="v" sid="1PE 2:13" />নৗংছৗরৗ ফৗরবুনি থাখৈ একথিয়ার গৗনাং সাফ্রৗমবৗ সুবুংনি সিঙাও থা, দেৎসিন একথিয়ার গৗনাং রাজানি সিঙাও থা, <verse eid="1PE 2:13" /><verse number="14" style="v" sid="1PE 2:14" />কিন্বা অন্যায় মাওগ্রাফৗরখৌ শাস্তি হৗনৗ আরৗ ঠিক মাওগ্রাফৗরখৌ বাখ্নাইনৗ থাখৈ ফছংজানায় শাসনগিরিফৗরনি সিগাঙাওবৗ থা। <verse eid="1PE 2:14" /><verse number="15" style="v" sid="1PE 2:15" />মানৗনা ঈশ্বৗরনি ইচ্ছায়া বেনৗ, নৗংছৗরনি মৗজাং মাওনায়জৗং জামবাফৗরনি গিয়ান গৈয়ি রাইজ্লায়নায়খৌ সিরি থাহৗনৗ। <verse eid="1PE 2:15" /><verse number="16" style="v" sid="1PE 2:16" />স্বাধীন মানসিফৗর বাদি ঠাংনান থা, নাথায় নৗংছৗরনি অন্যায় মাওনায়ফৗরখৌ খৗবনৗ থাখৈ নৗংছৗরৗ গাওনি স্বাধীন জানায়খৌ দাবাহায়, ঈশ্বৗরনি গলামফৗর বাদি ঠাংনান থা। <verse eid="1PE 2:16" /><verse number="17" style="v" sid="1PE 2:17" />বয়খৌবৗ মান হৗ, ন্ব'খরনি বিশ্বাসিফৗরখৌ অন, ঈশ্বৗরখৌ গি, আরৗ রাজাখৌ মান হৗ।<verse eid="1PE 2:17" /></para>
  <para style="s">সৈনায়নি বিষয়</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18" />দাসফৗর, নৗংছৗরৗ ঈশ্বৗরখৌ সিবিনায় গিনায়জৗং লৗগৗছে গাও গাওনি বৈগৗমাখৌ জেব্লাইবৗ মান হৗ আরৗ গাওছৗরখৌ গথায়, মৗজাং আরৗ অনগ্রা বৈগৗমানি সিঙাও বান অৗঙা, নাথায় অন্নায় গৈয়ি বৈগৗমাফৗরনি সিগাঙাওবৗ থা। <verse eid="1PE 2:18" /><verse number="19" style="v" sid="1PE 2:19" />মানৗনা বেয়ৗ বাখ্নায়জাথাও যদি ছৗরবা অন্যায়য়ৈ কষ্টহৗজাব্লা সৈছৗয়ৗ, মানৗনা বিছৗরৗ ঈশ্বৗরজৗং অনজায়ৗ। <verse eid="1PE 2:19" /><verse number="20" style="v" sid="1PE 2:20" />নাথায় অন্যায় মাওনানৈ নৗংছৗরৗ বুজাব্লা, বিয়াও নৗংছৗরহা মা বাখ্নাইনায় দং? নাথায় নৗংছৗরৗ মৗজাং মাওনানৈবৗ কষ্টমৗনদৗংব্লা আরৗ সৈনাংদৗংব্লা, বিহা ঈশ্বৗরা নৗংছৗরজৗং গৗজৗননায়। <verse eid="1PE 2:20" /><verse number="21" style="v" sid="1PE 2:21" />বিনি জুনৈনৗ ঈশ্বৗরা নৗংছৗরখৌ লিংহৎদৗং, মানৗনা খ্রীষ্টআ নৗংছৗরনি থাখৈ সৈনাংদৗং, নৗংছৗরনি থাখৈ উদাহরণ গালাংবায়, যেন নৗছৗরৗ বিনি আগান উন উন থাবায় নাংথারনায়। <verse eid="1PE 2:21" /><verse number="22" style="v" sid="1PE 2:22" />“বিয়ৗ পাপ মাওয়াখৈ, বিনি খৌগানিফ্রায় ছৗলৈনায় মৗন্নাখৈ।” <verse eid="1PE 2:22" /><verse number="23" style="v" sid="1PE 2:23" />বিয়ৗ মানসিফৗরজৗং অপমান খৗলামজাদৗং মৗনব্লাবৗ, রাওখৌবৗ অপমান খৗলামফিনাখৈ, জেব্লা সৈনাংদৗং, রাওনিবৗ ছায়াও ফাল্টা লায়াখৈ; নাথায় বিনি বিবানখৌ ন্যায় বিচার খৗলামগ্রা ঈশ্বৗরনিয়াওছৗ<note caller="+" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="ISA 53:7">যিশাইয় 53:7</ref></char></note> গথায়নান হৗদৗংমৗন। <verse eid="1PE 2:23" /><verse number="24" style="v" sid="1PE 2:24" />“বিয়ৗ জৗংনি পাপনি” বিবানখৌ গাওনি মৗদৗমাও লানানৈ ক্রুশনি ছায়াও বানগারবায়, বিনিখাইনৗ জৗঙৗ পাপনি থাখৈ থৈয়ৗ আরৗ ধৗরৗমিয়ানি থাখৈ জৗংখৌ গৗঠাং খৗলামৗ; “বিনি গারাইজৗংনৗ জৗঙৗ ছৗখাজাবায়<note caller="+" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="ISA 53:5">যিশাইয় 53:5</ref></char></note>।” <verse eid="1PE 2:24" /><verse number="25" style="v" sid="1PE 2:25" />মানৗনা “নৗংছৗরৗ মেন্ডা বাদি গুবুন লামাজৗং থাদৗংমৗন,” নাথায় নৗংছৗরৗ নেগ্রা জিউমাফৗরনি লাওখারনিয়াও নৗংছৗরৗ <note caller="+" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="ISA 53:6">যিশাইয় 53:6</ref> </char></note>গিদিংফিনবায়।<verse eid="1PE 2:25" /></para>
  <chapter eid="1PE 2" />
  <chapter number="3" style="c" sid="1PE 3" />
  <para style="s">হৌয়া আরৗ হিন্জাও</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1" />বেবাদিনৗ হিন্জাওসাফৗর, নৗংছৗরৗ গাও গাওনি হৌয়াফৗরনি সিঙাও থা, বিছৗরনি গেজেরাও ঈশ্বৗরনি বৗচৗনখৌ জাইফ্রা ছৗরবা ফৗথাইয়াব্লা, বৗচৗন গৈয়াব্লাবৗ বিছৗরবৗ নৗংছৗরনি আখল আখুখৌ নুনানৈ ফৗথাইগ্রা<note caller="+" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="EPH 5:22">ইফিষীয় 5:22</ref>; <ref loc="COL 3:18">কলসীয় 3:18</ref></char></note> জানায়, <verse eid="1PE 3:1" /><verse number="2" style="v" sid="1PE 3:2" />জেব্লা বিছৗরৗ গাওছৗরনৗ নৗংছৗরনি খাট্টি আরৗ মান গৗনাং আখল আখুখৌ নুনায়। <verse eid="1PE 3:2" /><verse number="3" style="v" sid="1PE 3:3" />নৗংনি সমায়নাইয়া বাইরানি সমায়হৗনায় নিফ্রায় ছৗফৈনাঙা, জেরৈ বাদি নৗংনি সমাইনা খানায় হেবনায়, সোনা-রুপা কিন্বা দাম গৗছা সি' গানফবনায়,<note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="2TI 2:9">2 তীমথিয় 2:9</ref></char></note> <verse eid="1PE 3:3" /><verse number="4" style="v" sid="1PE 3:4" />ববেখানি নৗংনি সিঙাওনি গুরৈ আরৗ সিরি জিউয়াও গাও গাওখৌ সমাইহৗদৗ। ঈশ্বৗরনি সিগাঙাও বেনৗ দাম গৗছাসিন। <verse eid="1PE 3:4" /><verse number="5" style="v" sid="1PE 3:5" />মানৗনা গৗডৗ গৗডানি গৗথার হিন্জাওসাফ্রা, জাইফ্রা ঈশ্বৗরনিয়াও আশা লাখিদৗংমৗন, বিছৗরবৗ বেবাদিয়ৈ গাও গাওনি হৌয়ানি সিঙাও দৗন্নানৈ গাওছৗরখৌ সমায়হৗদৗং মৗন। <verse eid="1PE 3:5" /><verse number="6" style="v" sid="1PE 3:6" />জেরৈবাদি হিন্জাওসাফৗরনি গেজেরাও সারাআবৗ সাছে মৗন, বিয়ৗ অব্রাহামনি সিঙাও থানানৈ, বিখৌ গাওনি বৈগৗমা মুংখদৗং মৗন। মৗজাংখৌ মাওব্লা, নৗংছৗরৗ সারানিনৗ বিসাজৗফৗর জাবায় আরৗ গিনাংগৌ জেবৗ গৈয়া। <verse eid="1PE 3:6" /><verse number="7" style="v" sid="1PE 3:7" />বেবাদিনৗ হৌয়াফ্রা, নৗংছৗরনি হিন্জাওফ্রা বৗলৗ গৈয়িসিন, বেখৌ মিথিনানৈ নৗংছৗরৗ বিছৗরখৌ অন্নায়জৗং মৗজাঙৈ বাহায়। আরৗ হিন্জাওফৗরনৗ মান হৗ, মানৗনা বিছৗরৗ নৗংছৗরজৗং লৗগৗছে ঈশ্বৗরনি অৗরৈনৗ দান হৗনায় গৗঠাং জীবনখৌ মৗনফানায়। নৗংছৗরৗ মান হৗয়াব্লা নৗংছৗরনি প্রার্থনা খৗলামনায়া<note caller="+" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="EPH 5:25">ইফিষীয় 5:25</ref>; <ref loc="COL 3:19">কলসীয় 3:19</ref> </char></note> খৗনাছংজানায় অৗঙা।<verse eid="1PE 3:7" /></para>
  <para style="s">সত্যখৌ মাওনায়াও সৈনাংনায়</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8" />জৗবনায়াও বেখৌ বুঙৗ, নৗংছৗর বয়বৗ মৗনছে গৗসৗ গৗনাং আরৗ অনসুলা জানানৈ গাওজৗং গাও অনজ্লাই, অনখ আরৗ গুরৈ জা। <verse eid="1PE 3:8" /><verse number="9" style="v" sid="1PE 3:9" />গাজ্রিনি বিরুদ্ধনাও গাজ্রি, অপমাননি বিরুদ্ধনাও অপমান হৗফিন্নামাৎনিন, বরং উল্ঠা বিছৗরখৌ বৗর হৗ মানৗনা বৗর মৗন্নৗ নৗংছৗরৗ লিংহৎজাদৗং। <verse eid="1PE 3:9" /><verse number="10" style="v" sid="1PE 3:10" />মানৗনা, “জাইফ্রা গৗঠাঙৈ রংজা বাজা থানৗ হাস্থাইয়ৗ, আরৗ মৗজাং দিনফৗরখৌ নায়নৗ<note caller="+" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="PSA 34:12">গীতফৗর 34:12</ref> </char></note> লুবৈয়ৗ, বিছৗরৗ অন্যায় রাইনায় আরৗ ছৗলৈনাইফৗরনিফ্রায় গাও গাওখৌ হমথাথৗং। <verse eid="1PE 3:10" /><verse number="11" style="v" sid="1PE 3:11" />গাজ্রিনিফ্রায় গিদিংফিন্নানৈ মৗজাংখৌ মাওথারনাংনায়; বিছৗরৗ গৗজৗন্নায়খৌ নাগিৎ থারনাংনায় আরৗ বেখৌ মাওহৗনৗ হাথারনাংনায়। <verse eid="1PE 3:11" /><verse number="12" style="v" sid="1PE 3:12" />মানৗনা ধৗরৗমিয়াফৗরখৌ ফৗরবুআ দিঠা হৗয়ৗ, আরৗ বিছৗরনি প্রার্থনা খৗলামনায়খৌ খৗনাছঙৗ; নাথায় জাইফ্রা গাজ্রি মাওয়ৗ বিছৗরনি বিরুদ্ধনাও ফৗরবুনি মৗখাঙা।” <verse eid="1PE 3:12" /><verse number="13" style="v" sid="1PE 3:13" />আরৗ নৗংছৗরনি বিরুদ্ধ রাওবৗ হানি খৗলামনায় অৗঙা, যদি নৗংছৗরৗ মৗজাংখৌ মাওনৗ গৗসৗজাদৗংব্লা। <verse eid="1PE 3:13" /><verse number="14" style="v" sid="1PE 3:14" />নাথায় যদিও ঠিকখৌ মাওনাইয়াও নৗংছৗরৗ সৈনাংদৗংব্লাবৗ, নৗংছৗরৗ ধন্য। নৗংছৗরৗ সিগিনাইয়াও দাগি আরৗ দাজিংগাসি। <verse eid="1PE 3:14" /><verse number="15" style="v" sid="1PE 3:15" />নাথায় নৗংছৗরনি গৗসৗয়াও খ্রীষ্টখৌ, ফৗরবু হৗন্নানৈ মান হৗ। নৗংছৗরনে যে আশা দং বেনি কারনখৌ মিথিনৗ জাইফ্রা নৗংছৗরনিয়াও সৗঙৗ অব্লা বিছৗরখৌ উত্তর হৗনৗ জেব্লাইবৗ ঠাম ঠিম থা। নাথায় বেখৌ নম্রয়ৈ আরৗ মানজৗং লৗগৗছে খৗলাম। <verse eid="1PE 3:15" /><verse number="16" style="v" sid="1PE 3:16" />নাথায় মৗজাং বিবেকখৌ রৗখা রৗখা দৗননানৈ নৗংছৗরৗ খ্রীষ্টখৌ ফৗথাইগ্রা জানানৈ মৗজাং মাওনায়াও নিন্দিগ্রাফ্রা গাওছৗরনি বুংনায়নি থাখৈ গাওছৗরনৗ লাজিফিনাংফিন্নায়। <verse eid="1PE 3:16" /><verse number="17" style="v" sid="1PE 3:17" />মানৗনা গাজ্রি মাওনানৈ সৈনাংনায়নিখুরৈ ঈশ্বৗরনি গৗসৗব্লা গাহামখৌ মাওনানৈ সৈনাংনাইয়া সাবসিন। <verse eid="1PE 3:17" /><verse number="18" style="v" sid="1PE 3:18" />মানৗনা খ্রীষ্টআবৗ পাপফৗরনি থাখৈ খেবছে সৈনাংদৗং। বি ধৗরৗমিয়া মানসিয়া অধৗরৗমিয়াফৗরনি থাখৈ, জাহাথে নৗংছৗরখৌ ঈশ্বৗরনিয়াও লাবৗনৗ। বিয়ৗ মৗদৗমাও সিথাৎ জাবায় নাথায় জিউয়াও ফৗঠাংজাবায়। <verse eid="1PE 3:18" /><verse number="19" style="v" sid="1PE 3:19" />আরৗ বিয়ৗ জিউয়াও জৗবথেসালিয়াও জৗবজানায় জিউফৗরনি খাঠিয়াও থাংনানৈ ঈশ্বৗরনি মৗজাং খবরখৌ প্রচার খৗলামদৗং। <verse eid="1PE 3:19" /><verse number="20" style="v" sid="1PE 3:20" />জাইফ্রা গৗবাং দিন সিগাঙাও ঈশ্বৗরনি খৗথা মানিয়াখৈমৗন জেব্লা নুহুনি নাও বৗনায়নায় সমাও ঈশ্বৗরা সৈছৗনায়জৗং লামানায়নানৈ দংমৗন। বি নাওয়াও ইছে বান মানসিফৗর, বে জাবায় আট জন মানসিফৗর, দৈ বানানিফ্রায় বাছায়জাদৗংমৗন<note caller="+" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="GEN 6:1-7">জাগাইজেন্নায় 6:1–7</ref></char></note>। <verse eid="1PE 3:20" /><verse number="21" style="v" sid="1PE 3:21" />আরৗ বে দৈয়া নৗংছৗর বাছায়জানায় বাপ্তিস্মানিনৗ মৗনছে মৗজাং চিহ্ন। মৗদৗমনি জিনিফৗরখৌ ছুস্রাংনায়নি অৗঙা, নাথায় মৗজাং বিবেকজৗং ঈশ্বৗরনিয়াও জৗংনি মৗনছে সমাই লানায়ছৗ। বেজৗংনৗ যীশু খ্রীষ্টনি ঠাংখাংফিন্নায়জৗং নৗংছৗরৗ বাছায়জায়ৗ। <verse eid="1PE 3:21" /><verse number="22" style="v" sid="1PE 3:22" />খ্রীষ্টআ স্বৗর্গৗয়াও থাংনানৈ ঈশ্বৗরনি আগ্ডা ঠিঙৈ থাহৈদৗং; বিয়ৗ গাছৈ আরফ'ফৗর, একথিয়ার গৗনাংফৗর আরৗ বৗলৗ গৗনাংফৗরনি ছায়াও শাসন খৗলামদৗং।<verse eid="1PE 3:22" /></para>
  <chapter eid="1PE 3" />
  <chapter number="4" style="c" sid="1PE 4" />
  <para style="s">ফৗথাইগ্রাফ্রা মা বাদি জানাংগৌ</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1" />বেবাদিনৗ খ্রীষ্টআ জেরৈ মৗদৗমাও সৈদৗং, নৗংছৗরবৗ সৈনৗ ঠাম ঠিম জা, মানৗনা মৗদামাও সৈছৗগ্রায়া পাপখৌ ফৗজৗবমৗ। <verse eid="1PE 4:1" /><verse number="2" style="v" sid="1PE 4:2" />যেন সংসারনি গাজ্রি মানসিফৗর লুবৈনায় বাদি অৗঙা, নাথায় বরংছৗ ঈশ্বৗরনি গৗসৗ বাদি জীবন যাপন খৗলাম। <verse eid="1PE 4:2" /><verse number="3" style="v" sid="1PE 4:3" />ঈশ্বৗরখৌ মিথিয়ৈ গুবুনহারিফ্রা জেরৈ মাওদৗং, বেবাদিনৗ নৗংছৗরৗ সিগাঙাও লাজিথাও খামানিফৗরখৌ মাওনৗসাইখদৗংমৗন। বি সমাও নৗংছৗরৗ অধৗরৗম, গাজ্রি লুবৈনায়, ফেগ্লুংনায়, রঙ্গরস, লৗংগ্লুংনায় আরৗ মুগৈজাথাওথাও মূর্তিফৗরখৌ খুলুমনানৈ গাওছৗরনি সমফৗরখৌ ফৗজৗববায়। <verse eid="1PE 4:3" /><verse number="4" style="v" sid="1PE 4:4" />নৗংছৗরৗ দা বিছৗরবাদি জেরৈ গাজ্রি আখল আখু গৈয়ি লামাও বৗহৈলাঙাখৗছৈখায়, বিছৗরৗ বৗথিয়া নাঙৗ, আরৗ বিনি থাখৈনৗ নৗংছৗরখৌ নিন্দিয়ৗ। <verse eid="1PE 4:4" /><verse number="5" style="v" sid="1PE 4:5" />নাথায় জাইয়া গৗঠাং আরৗ গৗথৈফৗরখৌ বিচার খৗলামনৗ ঠাম ঠিম, বে ঈশ্বৗরনি সিগাঙাও বিছৗরৗ গাওছৗরনি মাওনায়ফৗরখৌ হিসাব হৗনাংনায়। <verse eid="1PE 4:5" /><verse number="6" style="v" sid="1PE 4:6" />বেনি থাখৈনৗ থৈলাংনায়ফৗরনৗবৗ মৗজাং খবরখৌ খৗথানায় জাদৗংমৗন জাহাথে বিছৗরৗ মানসিফৗর বাদি মৗদৗমাও বিচার খৗলামজানায়, নাথায় ঈশ্বৗর বাদি জিউয়াও গৗঠাঙৈ থানৗ হানায় বাদি।<verse eid="1PE 4:6" /></para>
  <para style="s">ঈশ্বৗরনি বৗরখৌ বাহায়নায়</para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7" />গাছেন জিনিসনি জৗবনায়া খাঠৈছৈ। বিনিখাইনৗ সাবধান জা আরৗ দদ্র গৗসৗয়াও নৗংছৗরৗ প্রার্থনা খৗলামনৗ হানায় বাদি থা। <verse eid="1PE 4:7" /><verse number="8" style="v" sid="1PE 4:8" />বয়নিখুরৈ গৗনাংসিন, নৗংছৗরৗ সাছৈয়া সাছেজৗং গৗসৗ সিংনিফ্রায় অনজ্লাই, মানৗনা অন্নায়া গৗবাং পাপফৗরখৌ খৗবমৗ হিতোপদেশ 10:12<note caller="+" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="PRO 10:12">বৗচৗন বিজাব 10:12</ref></char></note>। <verse eid="1PE 4:8" /><verse number="9" style="v" sid="1PE 4:9" />নাংজ্লাইয়া মাৎনিন সাছৈয়া সাছেখৌ আলাসি সেবা খৗলাম। <verse eid="1PE 4:9" /><verse number="10" style="v" sid="1PE 4:10" />জাইয়া জেরৈ দান মৗন্দৗং, বেবাদিনৗ বিছৗরৗ ঈশ্বৗরনি বে গুবুন গুবুন দানফৗরখৌ ফৗথায়সুলা নায়ফিথিংগ্রা মানসিফৗর বাদি ঈশ্বৗরনি অনুগ্রহয়াও গুবুনফৗরনি থাখৈ সেবা খৗলামনাংনায়। <verse eid="1PE 4:10" /><verse number="11" style="v" sid="1PE 4:11" />ছৗরবায়া খৗথাবুংব্লা, বিয়ৗ ঈশ্বৗরনি খবরখৌ খৗথাবাইথৗং; ছৗরবায়া গুবুনফৗরখৌ হেফাজাব হৗয়ৗব্লা, ঈশ্বৗরা বিনৗ বে খামানিনি থাখৈ হৗনায় বৗলৗজৗং হেফাজাব হৗথারথৗং; বেবাদি মাওব্লা গাছৈয়াওবৗ যীশু খ্রীষ্টজৗং ঈশ্বৗরনি মহিমা জায়ৗ। গাছেন মহিমা আরৗ বৗলৗয়া জেব্লাইবৗ ঈশ্বৗরনি জাথৗং। আমেন।<verse eid="1PE 4:11" /></para>
  <para style="s">খ্রীষ্ট বাদি সৈনায়</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12" />আংগৗ লৗগৗফৗর, নৗংছৗরখৌ আনজাদ লানৗ থাখৈ নৗংছৗরনি ছায়াও যে অৎখিবায়দি আনজাদছফৈবায়, বেফৗরখৌ জাফেৎনি খৗনাফেৎনি হৗন্নানৈ বৗথিয়া দানাং। <verse eid="1PE 4:12" /><verse number="13" style="v" sid="1PE 4:13" />নাথায় খ্রীষ্টনি মহিমায়া নুজাহৗজানায় সমাও নৗংছৗরবৗ রংজানায়জৗং সুফুংজানায় বাদি, খ্রীষ্টনি সৈনাংনায়খৌ নৗংছৗরবৗ ভাগৗ লাফাদৗং হৗন্নানৈছৗ রংজা। <verse eid="1PE 4:13" /><verse number="14" style="v" sid="1PE 4:14" />যদি নৗংছৗরৗ খ্রীষ্টনি মুংনি থাখৈ লাজি ফৗনাংজায়ৗ, অব্লা নৗংছৗরৗ ধন্য, মানৗনা ঈশ্বৗরনি মহিমা গৗনাং জিউয়া নৗংছৗরনি ছায়াও দং। <verse eid="1PE 4:14" /><verse number="15" style="v" sid="1PE 4:15" />যদি নৗংছৗরৗ সৈনাংদৗংব্লা, অব্লা বিয়ৗ সাছে খুনি, অৗঙাব্লা সিখাও, অৗঙাব্লা গুবুন জেবৗ রৗখৗমনি অপরাধি, অৗঙাব্লা এমন কি সাছে নাঙা ফাঙা মালায়নি খামানিয়াও আখাইহৗগ্রা বাদিবৗ জানৗ উচিৎ অৗঙা। <verse eid="1PE 4:15" /><verse number="16" style="v" sid="1PE 4:16" />জাইয়ানৗ জায়ামানৗ, খ্রীষ্টিয়ান জানায়খায় সৈনাংদৗংব্লা নৗংছৗরৗ দালাজি, নাথায় নৗংছৗরৗ ঈশ্বৗরখৌ বাখ্নাইদৗ মানৗনা নৗংছৗরৗ ঈশ্বৗরনি মুঙখৌ লাগ্রাফৗর। <verse eid="1PE 4:16" /><verse number="17" style="v" sid="1PE 4:17" />মানৗনা ঈশ্বৗরনি ন্ব'খরাও বিচার জাজেননায়নি সম ছফৈবায়, আরৗ ঈশ্বৗরা গাওনি মানসিফৗরখৌ সিগাং বিচার খৗলামনায়। জৗংখৌনৗ বিচার খৗলামগ্রৗয়ৗব্লা, জাইয়া ঈশ্বৗরনি মৗজাং খবরখৌ ফৗথায়াখৈ, বিছৗরনি ছায়াও বিচারা বেছে গৗব্রাব জানায়। <verse eid="1PE 4:17" /><verse number="18" style="v" sid="1PE 4:18" />আরৗ, “ধৗরৗমিয়াফ্রা বাছাইজানৗ গৗব্রাবব্লা, ঈশ্বৗরখৌ ফৗথাইয়ি আরৗ পাপীফ্রা মাব্রৈ<note caller="+" style="x"><char style="xo" closed="false">4:18 </char><char style="xt" closed="false"><ref loc="PRO 11:31">বৗচৗন বিজাব 11:31</ref> </char></note> বাছাইজানৗ?” <verse eid="1PE 4:18" /><verse number="19" style="v" sid="1PE 4:19" />বিনিখাইনৗ, জাইফ্রা ঈশ্বৗরনি গৗসৗ বাদি দুঃখভোগ খৗলামৗ বিছৗরৗ মৗজাংখৌ খৗলাময়িন থা বিছৗরৗ গাওছৗরনৗ গাওছৗরখৌ ফৗথায়সুলা সৃষ্টিকর্ত্তানি আখাইয়াও গথাইথৗং।<verse eid="1PE 4:19" /></para>
  <chapter eid="1PE 4" />
  <chapter number="5" style="c" sid="1PE 5" />
  <para style="s">মণ্ডলীয়ারিফৗরখৌ ফৗরৗংনায়</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1" />নৗংছৗরনি গেজেরাও জাইফ্রা মণ্ডলীনি প্রাচীনফৗর দং, বিছৗরখৌ আঙৗ একই মাওফাজাবগ্রা প্রাচীন, খ্রীষ্টনি সৈনাংনায়নি সাক্ষী, আরৗ বিনি মহিমা নুজাহৗজানায়মানিখৌ নাইনৗ ভাগীদার, বি হিসাবৈ আঙৗ নৗংছৗরখৌ খাওলায়ৗ, <verse eid="1PE 5:1" /><verse number="2" style="v" sid="1PE 5:2" />নৗংছৗরৗ ঈশ্বৗরনি লাওখার জানানৈ নৗংছৗরনি জৗথৗন সিঙাও থানায় মেন্ডাখৌ মৗজাঙৈ দৈদেনদৗ, বাধ্য জানানৈ অৗঙা, নাথায় গৗসৗ ইচ্ছাজৗং, ঈশ্বৗরা জেরৈ লুবৈয়ৗ বিবাদিনৗ, গাজ্রিয়ৈ খামায়নৗ অৗঙা, নাথায় আগ্রহজৗং সেবাখৌ মাওদৗ। <verse eid="1PE 5:2" /><verse number="3" style="v" sid="1PE 5:3" />যে দায়িত্বখৌ নৗংনৗ হৗবায় বিনিছায়াও অধিকার খৗলামনৗ অৗঙা, নাথায় মেন্ডানি উদাহরণ জা। <verse eid="1PE 5:3" /><verse number="4" style="v" sid="1PE 5:4" />আরৗ জেব্লা গাহায় লাওখারা নুজাফৈনায়, অব্লা নৗংছৗরৗ মহিমানি মুকুটখৌ মৗননায়, জেয়া মাব্লাবাবৗ গৗমৗৎলাংনায় অৗঙা। <verse eid="1PE 5:4" /><verse number="5" style="v" sid="1PE 5:5" />জৗহৗলাওফৗর, নৗংছৗরৗ প্রাচীনফৗরনি সিঙাও থা আরৗ গাওজৗং গাও নৗংছৗরৗ বয়বৗ নম্র জাজ্লাই; মানৗনা “ঈশ্বৗরা ডুগাফৗরনি বিরুদ্ধ গছংঙৗ, নাথায় নম্রফৗরখৌ অন্নায় দিন্ঠিয়ৗ।” <verse eid="1PE 5:5" /><verse number="6" style="v" sid="1PE 5:6" />বিনিখাইনৗ নৗংছৗরৗ ঈশ্বৗরনি বৗলৗগ্রা আখাইনি সিঙাও থা, নাংগৌ সমাও বিয়ৗ নৗংছৗরখৌ ফৗজৌনায়। <verse eid="1PE 5:6" /><verse number="7" style="v" sid="1PE 5:7" />নৗংছৗরনি গাছেন ভাবনাচিন্তানি বিবানখৌ বিনি ছায়াও হৗ, মানৗনা বিয়ৗ নৗংছৗরনি থাখৈ চিন্তা খৗলামৗ। <verse eid="1PE 5:7" /><verse number="8" style="v" sid="1PE 5:8" />সাবধান জা সিরি মৗন্নানৈ থা মানৗনা নৗংছৗরনি বিসারু শয়তানা মাছে হুদুমনায় সিংহ বাদি, সৗরগিদিং গিদিংবায়নানৈ ছৗরখৌ গ্লবনৗ মলৗংনৗ হানায় বিখৌ নাগিৎনৗ। <verse eid="1PE 5:8" /><verse number="9" style="v" sid="1PE 5:9" />ফৗথাইনায়াও বৗলৗগ্রা জা, আরৗ শয়তাননি বিরুদ্ধ গছং, মানৗনা নৗংছৗরৗ মিথিগৌ, বে সংসারাও জেরাওবৗ বিশ্বাসী ন্ব'খরফ্রা নৗংছৗর বাদিনৗ সৈনাংদৗং। <verse eid="1PE 5:9" /><verse number="10" style="v" sid="1PE 5:10" />আরৗ গাছৈ অনুগ্রহনি ঈশ্বৗরা, নৗংছৗর দান্দৈছে সৈনাংনায়নি উনাও বিনি জৗবনৗ গৈয়ি মহিমায়াও যীশু খ্রীষ্টনিয়াও নৗংছৗরখৌ লিংহৎদৗং। ঈশ্বৗরা গাওনৗ নৗংছৗরখৌ বৗখাংফিননায়, আরৗ বৗলৗগ্রা খৗলামনায়, আরৗ বিনৗ নৗংছৗরখৌ গৗরা খৗলামনায় আরৗ গায়সননায়। <verse eid="1PE 5:10" /><verse number="11" style="v" sid="1PE 5:11" />জেব্লাইবৗ বিনি বৗলৗয়া যুগ যুগ থাথৗং। আমেন।<verse eid="1PE 5:11" /></para>
  <para style="s">জৗবনায়াও খুলুমহৎনায়</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12" />জাইখৌ আঙৗ সাছে ফৗথাই জাথাও ফংবায় হৗন্নানৈ সাননৗ, বে সীলাসনি হেফাজাবজৗং আঙৗ বে গুছুং লাইজামখৌ নৗংছৗরনৗ লিৎহৎবায়। আঙৗ নৗংছৗরনি গৗসৗয়াও উৎসাহ হৗনৗ আরৗ বে ঈশ্বৗরনি নংথারগৌ অনুগ্রহ হৗন্নানৈ আঙৗ সাক্ষী হৗয়ৗ। নৗংছৗর বেয়াওনৗ স্থির থাদৗ। <verse eid="1PE 5:12" /><verse number="13" style="v" sid="1PE 5:13" />নৗংছৗরজৗং লৗগৗছে সাইখজানায় ব্যাবিল মণ্ডলীনি সাফ্রৗমবৗ আরৗ আংনি বিসাজ্লা মার্কআ নৗংছৗরনৗ গৗজৗন্নায় হৎদৗং। <verse eid="1PE 5:13" /><verse number="14" style="v" sid="1PE 5:14" />অনজ্লাইনায়জৗং গাওজৗং গাও গৗজৗন্নায় লাজ্লাইদৗ খ্রীষ্টনিয়াও থানায় বয়নিবৗ ছায়াও শান্তি থাথৗং।<verse eid="1PE 5:14" /></para>
  <chapter eid="1PE 5" />
</usx>