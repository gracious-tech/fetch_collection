<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Mech</book>
  <para style="h">3 যোহন</para>
  <para style="toc3">3 যোহ</para>
  <para style="toc1">যোহননি তৃতীয় লাইজাম</para>
  <para style="toc2">3 যোহন</para>
  <para style="mt">যোহননি তৃতীয় লাইজাম</para>
  <para style="is">রাইফৗথনায়</para>
  <para style="ip">যোহননি তৃতীয় লাইজামা মণ্ডলীনি দৈদেনগ্রা গায়াসনৗ লিথহৎনায় লাইজাম। গায়াসয়া গুবুন খ্রীষ্টিয়ানফৗরনি হেফাজাব হৗনায়খায় লিৎগিরিআ বিখৌ বাখ্নাইদৗং, আরৗ দীয়ত্রিফি মুংনি সাছে মানসিনিফ্রায় সাবৗদান থানৗ থৗন্দৗং।</para>
  <para style="iot">বিষয়ফৗর</para>
  <para style="io1">রাইফৗথনায় <char style="ior">(<ref loc="3JN 1:1-4">1–4</ref>)</char></para>
  <para style="io1">গায়েরখৌ বাখ্নাইনায় <char style="ior">(<ref loc="3JN 1:5-8">5–8</ref>)</char></para>
  <para style="io1">দীয়ত্রিফিখৌ দোষী খৗলামনায় <char style="ior">(<ref loc="3JN 1:9-10">9–10</ref>)</char></para>
  <para style="io1">দীমীত্রিয়াসনি থাখৈ মৗজাং সাক্ষী হৗনায় <char style="ior">(<ref loc="3JN 1:11-12">11–12</ref>)</char></para>
  <para style="io1">লাইজামনি জৗবনায় খৗথা <char style="ior">(<ref loc="3JN 1:13-15">13–15</ref>)</char></para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="s">গৗজৗন্নায় লানায়</para>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />বে প্রাচীন, জাইখৌ আং মৗজেন অন্নৗ, বিয়ৗ নংথারগৌ আংনি লৗগৗ গায়াস। <verse eid="3JN 1:1" /><verse number="2" style="v" sid="3JN 1:2" />আংনি আংগৗ লৗগৗ, আঙৗ প্রার্থনা খৗলামৗ নৗংহা গাছৈয়াওবৗ মৗজাং জাথৗং, আরৗ আং মিথিনায় বাদি নৗঙৗ জেরৈ জিউয়াও মৗজাঙৈ দং বেবাদিনৗ মৗজাং দেহা থাথৗং। <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />বে আংখৌ গেদেৎ রংজাহৗবায় যে, খাইছে ফৗথায়গ্রা ফংবায়ফ্রা ফৈনানৈ নৗংনি সত্যনি বিষয়ৈ সাক্ষ্য হৗদৗং, মাব্রৈ নৗঙৗ নংথারগৌয়াও থাবায়দৗং। <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />আংনি বিসাফ্রা ঈশ্বৗরনি নংগৌয়াও থাবায়নায়খৌ মিথিনানৈ রংজানায়নিখুরৈ আংহা আরবাও গুবুন দেৎসিন রংজানায় গৈবাওয়া।<verse eid="3JN 1:4" /></para>
  <para style="s">গায়সখৌ বাখ্নাইনায়</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />আংগৗ লৗগৗ, ফংবায় আরৗ বিনানাওফৗরনি থাখৈ নৗঙৗ যে মাওদৗং বিহা নৗঙৗ ফৗথায়সুলা, যদিও বিছৗরৗ নৗংনি থাখৈ গুবুনারি মানসি মৗন। <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />বিছৗরৗ নৗংনি অন্নায়নি সাক্ষী মন্ডলীয়ারিফৗরনৗ খৗথাদৗং, বেয়ৗ মৗজাং জানায় যদি নৗঙৗ বিছৗরখৌ বেবাদি থৗনহৎনৗ জেন ঈশ্বৗরা সন্তুষ্ট জায়ৗ। <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />মানৗনা বি মুংনি থাখৈ বিছৗরৗ অৗংখাৎলাংবায়, গুবুন হারিফৗরনিফ্রায় মৗংবৗ হেফাজাব লায়া। <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />বিনিখাইনৗ জৗং বে মানসিফৗরনি হেফাজাব হৗথারনাংগৌ, বিনিখাইনৗ জৗঙৗ নংথারগৌনি থাখৈ লৗগৗছে খামানি মাওনৗ হায়ৗ।<verse eid="3JN 1:8" /></para>
  <para style="s">দিয়ত্রিফি আরৗ দীমীত্রিয়াস</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />আঙৗ মন্ডলীয়ারিফৗরনৗ বে লাইজামখৌ লিৎহৎদৗংমৗন, নাথায় দিয়ত্রিফিআ মন্ডলীয়াও দৈদেনগ্রা জানৗ হাস্থাইয়ৗখায় আংনি বুংনায়খৌ খৗনাছঙা। <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />বিনিখাইনৗ আং জেব্লা ফৈনায়, বিনি মাওনায়ফৗরখৌ গৗসৗখাং হৗনায়, বিয়ৗ জৗংনি বিরুদ্ধ দুষ্টু গৗবাংথার নংখাই খৗথাফৗর বুংদৗং, আরৗ বেফৗরখৌ বুংনানৈ গৗসৗয়াও ঠৗনায় গৈয়া মৗন, আরৗ ফংবায়ফ্রা নাজাওয়া আরৗ গুবুনফৗর নাজাওনৗ হাস্থাইনায়খৌবৗ রাইফৗথায়ৗ আরৗ বিছৗরখৌ মন্ডলীনিফ্রায় হৌয়নহৎনৗ। <verse eid="3JN 1:10" /><verse number="11" style="v" sid="3JN 1:11" />আংগৗ লৗগৗ, জাই মানসিফ্রা গাজ্রি মাওয়ৗ বিছৗরনি দাছৗলৗং নাথায় জাইফ্রা মৗজাং মাওয়ৗ বিছৗরনি ছৗলৗং। জাইয়া মৗজাংখৌ মাওয়ৗ, বিয়ৗ ঈশ্বৗরনি মানসি আরৗ জাইয়া গাজ্রিখৌ মাওয়ৗ, বিয়ৗ ঈশ্বৗরখৌ নুয়াখৈ। <verse eid="3JN 1:11" /><verse number="12" style="v" sid="3JN 1:12" />সাফ্রৗমবৗ দীমীত্রিয়াসখৌ বাখ্নায়ৗ, ঈশ্বৗরনি নংথারগৌয়াও বিখৌ মৗজাং হৗন্নানৈ সাক্ষ্য হৗয়ৗ। জৗংবৗ সাক্ষ্য হৗয়ৗ, আরৗ জৗংনি মৗজাং সাক্ষ্য হৗনায়াবৗ নংথারগৌ হৗন্নানৈ নৗংছৗরৗ মিথিগৌ।<verse eid="3JN 1:12" /></para>
  <para style="s">জৗবনায়নি গৗজৗন্নায় লাহৎনায়</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />আংহা নৗংছৗরনৗ গৗবাংথার বুংনাংগৌ দংমৗন, নাথায় আঙৗ কলম আরৗ কালিজৗং লিৎনৗ লুবৈয়া। <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />আঙৗ নৗংছৗরখৌ গৗখ্রৈনৗ নাইহৈনৗ আশা দং, আরৗ বে সমাও জৗঙৗ গাছৈখৌবৗ মৗখাংজৗং মৗখাং রাইজ্লাইনায়। <verse eid="3JN 1:14" /><verse number="15" style="v" sid="3JN 1:15" />নৗংছৗরনাও শান্তি জাথৗং। নৗংছৗরনি গাছেন লৗগৗফ্রা নৗংছৗরখৌ গৗজৗন্নায় লাহৎদৗং। নৗংছৗরনিয়াও থানায় জৗংনি লৗগৗফৗর সাফ্রৗমনৗবৗ জৗংনি মুঙৈ গৗজৗন্নায়খৌ হৗদৗ।<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>