<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ROM" style="id">– Mech</book>
  <para style="h">রোমীয়</para>
  <para style="toc3">রোমী</para>
  <para style="toc2">রোমীয়</para>
  <para style="toc1">রোমীয়য়ারিফৗরনৗ পৌলনি লিৎনায় লাইজাম</para>
  <para style="mt">রোমীয়য়ারিফৗরনৗ পৌলনি লিৎনায় লাইজাম</para>
  <para style="is">রাইফৗথনায়</para>
  <para style="ip">পৌলআ রোমনি মন্ডলীনিয়াও গাও হাবহৈনাইনি সিগাং বিয়ৗ গাওনি থাখৈ লামা ঠাম ঠিম খৗলামনৗ রোমীয়য়ারিফৗরনৗ লাইজাম লিৎহৎদৗং। বিনি সাননাইয়া বেনৗ মৗন, সাননৈছৗ বিহানি খ্রীষ্টিয়ানফৗরনি গেজেরাও খামানি মাওনানৈ, বিছৗরনি হেফাজাবজৗং স্পেনাও থাংনৗ। গাও মিথিনায় খ্রীষ্টখৌ ফৗথাইনায়নি বাথ্রা, খ্রীষ্টিয়ান মন্ডলীখৌ গৗঠাঙৈ লাখিনায়নি থাখৈ, আরৗ বেফৗরখৌ বিজিৎনানৈ হৗনৗ থাখৈ পৌলআ বে লাইজামখৌ লিৎদৗং। বে বিজাবমাও জৗঙৗ পৌলনি খৗথাবাওনায়খৌ রৗখায়ৈ মৗন্নৗ। রোমমাও থানায় খ্রীষ্টিয়ান বিদা-ফংবায়ফৗরখৌ গৗজৗন্নায় লাহৎনায় আরৗ বিছৗরনি থাখৈ গাওনি খাওলায়নায়খৌ মিথিহৗনায়নি উনাও, পৌলআ গাওনি লাইজামনি নংগৌ বাথ্রাখৌ নুজাহৗদৗং; ঈশ্বৗরনি সিগাঙাও মানসিফ্রা মাব্রৈহায় ধৗরৗমিয়া জায়ৗ, বেখৌ মৗজাং খবরাও নুজাহৗয়ৗ, বে জাবায় যীশুখৌ ফৗথাইনায়জৗং বান। 1:17 পৌলআ বে বাথ্রাখৌ বেখেওসাৎনানৈ দিন্ঠিদৗং। যিহূদীয়ারিফৗর আরৗ গুবুনহারিফৗর, গাছেন মানসি মানিয়ানৗ ঈশ্বৗরনি সিগাঙাও ধৗরৗমিয়া জানাংনায়, মানৗনা মানসি মানিয়ানৗ পাপনি দাস। যীশু খ্রীষ্টখৌ ফৗথাইনায়জৗং বান, মানসিয়া ঈশ্বৗরনি সিগাঙাও ধারৗমিয়া জানৗ হায়ৗ। আরৗ ঈশ্বৗরজৗং গৗদান সৗমৗন্দৗ জানায়নিফ্রায় খ্রীষ্টজৗং খৌছে জানায়াও গৗদান জিউখৌ মাব্রৈ মৗন্নায়, বিখৌ নাইনাংনায়। ফৗথাইগ্রাফৗরহা ঈশ্বৗরনি শান্তি দং, পাপ আরৗ থৈনায়নিফ্রায় ঈশ্বৗরনি জিউজৗং গহৗজাবায়। অধ্যায় 5–8 পৌলআ ঈশ্বৗরনি আইননি ঠাংখি আরৗ ফৗথাইগ্রাফৗরনিয়াও ঈশ্বৗরনি জিউনি বৗলৗনি খৗথাখৌবৗ লিৎদৗং। মানসিহারিনি থাখৈ ঈশ্বৗরনি ঠাংখি লানায়াও যিহূদীয়ারিফ্রা আরৗ গুবুনহারিফ্রা মাব্রৈহায় মিলাইজ্লায়ৗ, পৌলআ বেখৌ মিথিহৗনৗ হাজাছে হাস্থায়দৗং। জৗবনাইয়াও পৌলআ গাওনি গৗসৗয়াও বে বুংফিনায়খৌনৗ মৗন্দৗং। যিহূদীয়ারিফৗরনি যীশুখৌ নাগারনায়াবৗ ঈশ্বৗরনি মৗনছে ঠাংখি। যীশু খ্রীষ্টনিয়াও অনগ্রা ঈশ্বৗরনি অন্নায়খৌ গাছেন মানসিমানিয়ানৗ মৗন্নৗ হানায় বাদি বেখৌ মাওবায়। আরৗ বিনি সান্নায়া বেনৗ, যিহূদীয়ারিফ্রা যীশুনিফ্রায় গৗজানাও থাংনায় অৗঙা। খ্রীষ্টিয়ানফ্রা মাব্রৈ থানাংগৌ, জৗবনায়াও পৌলআ বেখৌনৗ লিৎদৗং। ঈশ্বৗরখৌ মাব্রৈ সিবিনৗ, গাওনি জায়গায়াও গাওজৗং গাও মাব্রৈ মাওজ্লাইনৗ, আরৗ মালায়খৌ ছৗখ্ঠুহৗয়াজাছে মাব্রৈ থানৗ হাগৌ, বে খৗথাফৗরখৌনৗ বিয়ৗ লিৎদৗং। বয়জৗংবৗ অনজ্লাইনাইয়া নাংগৌসিনথার হৗন্নানৈ জৗবনায়াও বিয়ৗ নুজাহৗদৗং। আরৗ গাওনি খবরখৌ খৗথানানৈ ঈশ্বৗরখৌ সাবাইখর হৗন্নানৈ পৌলআ গাওনি লিৎনায়খৌ ফৗজৗবদৗং।</para>
  <para style="iot">বিষয়ফৗর</para>
  <para style="io1">রাইফৗথনায়জৗং লৗগৗছে গুবুন বাথ্রা <char style="ior">(<ref loc="ROM 1:1-17">1:1–17</ref>)</char></para>
  <para style="io1">মানসিয়া বাছাইজানাংগৌ <char style="ior">(<ref loc="ROM 1:18-3:20">1:18—3:20</ref>)</char></para>
  <para style="io1">বাছাইজানৗ থাখৈ ঈশ্বৗরনি দিন্ঠিনায় লামা <char style="ior">(<ref loc="ROM 3:21-4:25">3:21—4:25</ref>)</char></para>
  <para style="io1">খ্রীষ্টনিয়াও গৗদান জিউ মৗন্নায় <char style="ior">(<ref loc="ROM 5:1-8:39">5:1—8:39</ref>)</char></para>
  <para style="io1">ইস্রায়েলফৗরনি থাখৈ ঈশ্বৗরনি ঠাংখি <char style="ior">(<ref loc="ROM 9:1-11:36">9:1—11:36</ref>)</char></para>
  <para style="io1">খ্রীষ্টিয়ানফৗরনি আখল আখু <char style="ior">(<ref loc="ROM 12:1-15:13">12:1—15:13</ref>)</char></para>
  <para style="io1">জৗবনায় খৗথা আরৗ খুলুমহৎনায় <char style="ior">(<ref loc="ROM 15:14-16:27">15:14—16:27</ref>)</char></para>
  <chapter number="1" style="c" sid="ROM 1" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1" />আং পৌল, যীশু খ্রীষ্টনি সাছে দাস, প্রেরিত জানৗ থাখৈ লিংহৎজানায় আরৗ ঈশ্বৗরনি মৗজাং খবরখৌ খৗথাবাইনৗ থাখৈ আলাদায়ৈ দৗনখাজানায়, <verse eid="ROM 1:1" /><verse number="2" style="v" sid="ROM 1:2" />বে মৗজাং খবরখৌ ঈশ্বৗরা গাওনি নবিফৗরনি গেজেরজৗং সিগাংয়াওনৗ গৗথার শাস্ত্রয়াও সিমান লাখাদৗংমৗন। <verse eid="ROM 1:2" /><verse number="3" style="v" sid="ROM 1:3" />বে মৗজাং খবররা বিনি বিসাজ্লানি বিয়ষয়ানৗ, জাইয়া মানসিনি মহরৈ দায়ূদনি জৗলৈয়াও সারিজাদৗং, <verse eid="ROM 1:3" /><verse number="4" style="v" sid="ROM 1:4" />আরৗ জাইয়া গৗথার জিউনি বৗলৗজৗং থৈনায়নিফ্রায় ঠাংখাংফিননানৈ গাওখৌ নংগৌ ঈশ্বৗরনি বিসাজ্লা হৗন্নানৈ নুজাহৗবায়; বিয়ৗ জৗংনি ফৗরবু যীশু খ্রীষ্টআনৗ। <verse eid="ROM 1:4" /><verse number="5" style="v" sid="ROM 1:5" />বিনি গেজেরজৗং জৗঙৗ অনুগ্রহ মৗনবায়, আরৗ প্রেরিত মুংখজানৗ মৗনবায়, জাহাথে গাছেন গুবুনহারিফৗরখৌ ফৗথাইনায়াও বিনি নামনি থাখৈ আজ্ঞাকারি জানৗ হানায় বাদি। <verse eid="ROM 1:5" /><verse number="6" style="v" sid="ROM 1:6" />আরৗ বে গুবুনহারিফৗরনি গেজেরাও নৗংছৗরবৗ দংফায়ৗ, জাইফৗরখৌ যীশু খ্রীষ্টনি মানসিফৗর জানৗ থাখৈ লিংহৎদৗং।<verse eid="ROM 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 1:7" />রোমাও থানায় সাফ্রৗমখৌবৗ, জাইফৗরখৌ ঈশ্বৗরা অন্নৗ আরৗ গাওনি গৗথার মানসিফৗর জানৗ থাখৈ লিংহৎবায়, বিছৗর গাছেননি থাখৈ আঙৗ লিৎদৗং।</para>
  <para style="p" vid="ROM 1:7">জৗংনি বিফা ঈশ্বৗর আরৗ ফৗরবু যীশু খ্রীষ্টনি অনুগ্রহ আরৗ শান্তিয়া নৗংছৗরনি ছায়াও থাথৗং।<verse eid="ROM 1:7" /></para>
  <para style="s">ঈশ্বৗরনি মৗজাং খবর</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8" />সিগাংয়াও আঙৗ যীশু খ্রীষ্টনি গেজেরজৗং নৗংছৗর গাছেননি থাখৈ আংনি ঈশ্বৗরখৌ হামবায় হৗনৗ, মানৗনা নৗংছৗরনি ফৗথায়নাইনি খৗথানি বিষয়া সারা সংসারাও মিথিসাৎ জাবায়। <verse eid="ROM 1:8" /><verse number="9" style="v" sid="ROM 1:9" />ঈশ্বৗর, জাইখৌ আঙৗ গাওনি জিউয়াও বিনি বিসাজ্লানি মৗজাং খবরখৌ প্রাচার খৗলামনৗ থাখৈ আংনি গাছেন গৗসৗজৗং সেবা খৗলামৗ, বিনৗ আংনি সাক্ষী যে, আঙৗ নৗংছৗরখৌ জেব্লাইবৗ প্রার্থনায়াও গৗসৗখাংফ্লাইয়ৗ। <verse eid="ROM 1:9" /><verse number="10" style="v" sid="ROM 1:10" />আরৗ আঙৗ প্রার্থনা খৗলামৗ, জাহাথে ঈশ্বৗরা গৗসৗ জাব্লা নৗংছৗরনিয়াও থাংনৗ থাখৈ লামাখৌ খেওনান হৗনায়।<verse eid="ROM 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 1:11" />মানৗনা আঙৗ নৗংছৗরখৌ নাইনৗ জৗবৗদ গৗসৗ জাদৗং, জাহাথে আং নৗংছৗরনৗ খাইছে আত্মিক দানখৌ হৗনৗ হানায় বাদি, জেয়া নৗংছৗরখৌ বৗলৗগ্রা খৗলামৗ। <verse eid="ROM 1:11" /><verse number="12" style="v" sid="ROM 1:12" />নৗংছৗর আরৗ আং জাহাথে গাওজৗং গাও ফৗথাইনায়জৗং থুলুংগা হৗজ্লাইনৗ হানায়। <verse eid="ROM 1:12" /><verse number="13" style="v" sid="ROM 1:13" />ও আংনি বিদা ফংবায়ফৗর আরৗ বিবো বিনানাওফৗর, আঙৗ নৗংছৗরখৌ মিথিহৗনৗ লুবৈয়ৗ যে আঙৗ গলে গলে নৗংছৗরনিয়াও ফৈনৗ গৗসৗয়াও সানদৗং, নাথায় দাসিমবৗ আঙৗ থাংনৗ হায়াখৈ। মানৗনা গুবুনহারিফৗরনি গেজেরাও আঙৗ জেরৈ গৗদান ফৗথাইগ্রাফৗরখৌ মৗন্দৗং, বেবাদিনৗ নৗংছৗরনি গেজেরাওবৗ মৗন্নৗ হানায়।<note caller="+" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="ACT 19:21">প্রেরিত 19:21</ref></char></note><verse eid="ROM 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 1:14" />আংহা, গ্রীকফৗরনৗবৗ আরৗ জাইফ্রা গ্রীক অৗঙা বিছৗরনৗবৗ, জ্ঞানী আরৗ জামবা জাইখিয়াজায়া আংহা বিবান হৗজাদৗং। <verse eid="ROM 1:14" /><verse number="15" style="v" sid="ROM 1:15" />বিনিখাইনৗ রোম নৗগৗরাও থানায়ফৗরনি গেজেরাওবৗ মৗজাং খবরখৌ প্রচার খৗলামনৗ আংহা গৗবাং গৗসৗ দং।<verse eid="ROM 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16" />মৗজাং খবরনি থাখৈ আঙৗ লাজিয়া, মানৗনা বেয়ৗ ঈশ্বৗরনি বৗলৗ, জেয়া ফৗথাইগ্রা সাফ্রৗমনিবৗ থাখৈ উদ্ধার লাবৗয়ৗ, সিগাং যিহূদীফৗরনৗ, বিনি উনাও গুবুনহারিফৗরনৗ<note caller="+" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="MRK 8:38">মার্ক 8:38</ref></char></note>। <verse eid="ROM 1:16" /><verse number="17" style="v" sid="ROM 1:17" />মানৗনা মৗজাং খবরনি গেজেরজৗং ঈশ্বৗরনি ধৗরৗমিয়ায়া নুসাৎ জাবায়, সাছে ধৗরৗমিয়ায়া, জাইয়া সিগাংনিফ্রায় জৗবনায়সিম ফৗথায়নায়নি গেজেরজৗং, জেরৈবাদি লিৎনায় দং, “ধৗরৗমিয়ায়া ফৗথাইনায়জৗং ঠাংনানৈ<note caller="+" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="HEB 10:38">ইব্রীয় 10:38</ref>; <ref loc="GAL 3:11">গালাতীয় 3:11</ref>; <ref loc="HAB 2:4">হাবাকুক 2:4</ref></char></note> থায়ৗ।”<verse eid="ROM 1:17" /></para>
  <para style="s">পাপী মানসিফৗরনি বিরুদ্ধ ঈশ্বৗরনি রাগ</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18" />ঈশ্বৗরনি রাগয়া স্বৗর্গৗনিফ্রায় মানসিনি গাছেন দুষ্টু খামানিফৗরনি আরৗ মানহারাফৗরনি বিরুদ্ধ নুসাৎ জাবায়, জাইফ্রা বিছৗরনি দুষ্টু খামানিফৗরনি গেজেরজৗং সৈথৗখৌ দমন খৗলামৗ। <verse eid="ROM 1:18" /><verse number="19" style="v" sid="ROM 1:19" />বি সমনিফ্রায়নৗ ঈশ্বৗরনি বিষয়ৈ জেখৌ মিথিনাগৌ দংমৗন বিয়ৗ রৗখা রৗখা, মানৗনা ঈশ্বৗরা গাওনৗ বিছৗরনৗ মিথিহৗখাবায়। <verse eid="ROM 1:19" /><verse number="20" style="v" sid="ROM 1:20" />বিনিখাইনৗ বিনি নুনৗ মৗননি গুনফ্রা, ঈশ্বৗরিক আখল আখু, বিনি জৗবনৗ গৗয়ি বৗলৗ আরৗ বিয়ৗ নংথারগৌ ঈশ্বৗর, সংসারখৌ সৗরজিনায়নিফ্রায় মানসিফ্রা বিনি দানায় মৗঙাফৗরজৗং রৗখা রৗখা মিথিনৗ মৗন্নৗ। বিনিখাইনৗ বিছৗরহা খাৎগৌনায়নি লামা গৈয়া।<verse eid="ROM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 1:21" />বিছৗরৗ ঈশ্বৗরখৌ মিথিগৌ, নাথায় বিছৗরৗ বিখৌ ঈশ্বৗর হৗন্নানৈ মহিমাবৗ খৗলামাখৈ আরৗ বাখনাইয়াখৈ, নাথায় বিছৗরনি সান্নায়ফ্রা খামানিয়াও ফৈয়ৈ জাবায় আরৗ জামবা গৗসৗয়া খৗমসি জাবায়<note caller="+" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="EPH 4:17-18">ইফিষীয় 4:17–18</ref> </char></note>। <verse eid="ROM 1:21" /><verse number="22" style="v" sid="ROM 1:22" />বিছৗরৗ গাওছৗরখৌ জ্ঞানী দাবি খৗলামব্লাবৗ, বিছৗরৗ জামবাফৗর জাবায়। <verse eid="ROM 1:22" /><verse number="23" style="v" sid="ROM 1:23" />আরৗ সৗলাইস্লোয়ৈ মহিমা গৗনাং থৈরৗঙি ঈশ্বৗরখৌ সিবিয়ামাৎনিনৗ থৈগ্রা মানসি বাদি, আরৗ দাওছেন, আরৗ জুনার আরৗ মানবায়গ্রা জুনারফৗরনি মহরৈ দানায় মূর্তিফৗরখৌছৗ খুলুমবায়<note caller="+" style="x"><char style="xo" closed="false">1:23 </char><char style="xt" closed="false"><ref loc="DEU 4:16-17">হূদা বিজাব 4:16–17</ref> </char></note>।<verse eid="ROM 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24" />বিনিখাইনৗ ঈশ্বৗরা বিছৗরনি গৗসৗনি পাপজৗং বুংফবনায় লুবৈনাইফৗরাও, বিছৗরখৌ সাছেয়া সাছেজৗং বিছৗরনি মৗদৗময়াও গৗগ্লাইখ্লাইনৗ থাখৈ, জিনাহারি খালায়ফ্রাও হগারনান হৗবায়। <verse eid="ROM 1:24" /><verse number="25" style="v" sid="ROM 1:25" />বিছৗরৗ নংখাইজৗং ঈশ্বৗরনি নংথারগৌখৌ সৗলাইস্লো খৗলামবায়, আরৗ সৗর্জিনায় মৗঙাফৗরখৌছৗ খুলুমবায় আরৗ সিবিদৗং, বি সৗর্জিগিরিখৌ অৗঙা, জাইয়া জেব্লাইবৗনি থাখৈ বাখ্নাইজায়ৗ। আমেন।<verse eid="ROM 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26" />বেনি থাখৈনৗ ঈশ্বৗরা বিছৗরনি লাজিথাওথাও মাওনৗ লুবৈখাংনায়, এমন কি, বিছৗরনি হৌয়া হিন্জাওসাফৗরনি সৗমৗন্দৗয়া সৗলাইস্লোয়ৈ গাওজৗং গাও অস্বাভাবিক খামানি মাওজ্লায়নাইয়াও হগারনান হৗবায়। <verse eid="ROM 1:26" /><verse number="27" style="v" sid="ROM 1:27" />বিবাদিনৗ হৌয়াসাফ্রাবৗ হিন্জাওসাফৗরজৗং স্বাভাবিক সৗমৗন্দৗখৌ নাগারবায় আরৗ গাওজৗং গাও লুবৈজ্লায়ৗ মৗন। হৌয়াসাফ্রা গুবুন হৌয়াসাফৗরজৗং লাজিথাও থাও খামানি মাওদৗং, আরৗ বিছৗরনি গৗরৗন্ঠিনি থাখৈ গাও গাওনি গেজেরাও সাজাখৌ মৗন্নাগৌখৌ মৗনবায়।<verse eid="ROM 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28" />জেরৈবাদি, বিছৗরৗ ঈশ্বৗরনি জ্ঞানখৌ নেওছিদৗংমৗন, ঈশ্বৗরা বিছৗরনৗ গাজ্রি সান্নায় খৗলামনায়খৌ হগারনান হৗবায়, বিছৗরৗ বেখৌনৗ খৗলামৗ জেখৌ খৗলামনৗ নাংথারা। <verse eid="ROM 1:28" /><verse number="29" style="v" sid="ROM 1:29" />বিছৗরৗ গৗসৗয়াও গাজ্রি সান্নায়, গাজ্রি, লুবৈনায় আরৗ গাওজৗং গাও গাজ্রি মাওজ্লাইনায়, মগন ছাজ্লাইনায়, সিথাৎজ্লাইনায়, বুজ্লাইনায়, ছৗলৈজ্লাইনায় আরৗ হিংসা খৗলামজ্লাইনায়। নাঙা ফাঙা রাইজ্লাইনায়, <verse eid="ROM 1:29" /><verse number="30" style="v" sid="ROM 1:30" />নংবাং জাবাং রাইজ্লাইগ্রা, ঈশ্বৗরখৌ মুগৈগ্রা, নিন্দিগ্রা, ডুগামারা, গাজ্রি সানখাংগ্রা, বিমা-বিফানি খৗথা লায়ি; <verse eid="ROM 1:30" /><verse number="31" style="v" sid="ROM 1:31" />বিছৗরৗ বুজিনৗরৗঙি, ফৗথায়থি গৈয়ি, অন্নায় গৈয়ি দয়া গৈয়ি। <verse eid="ROM 1:31" /><verse number="32" style="v" sid="ROM 1:32" />যদিও বিছৗরৗ ঈশ্বৗরনি ধৗরৗমিয়ানি হুখুমখৌ মিথিয়ৗ, যে জাইফ্রা বে রৗখৗমনি খামানি মাওয়ৗ বিছৗরৗ গৗথৈনি যোগ্য, অব্লাবৗ বিছৗরৗ বেবাদি রৗখৗমনি খামানিফৗরখৌ মাওবায় থায়ৗ আরৗ জাইফ্রা বেফৗরখৌ সর খৗলামৗ বিছৗরখৌ গনায়ৗ।<verse eid="ROM 1:32" /></para>
  <chapter eid="ROM 1" />
  <chapter number="2" style="c" sid="ROM 2" />
  <para style="s">ঈশ্বৗরনি গৗথারথি বিচার</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1" />বিনিখাইনৗ, নৗংছৗরহা জেবৗ নিমাহা গৈয়া, নৗংছৗর জাইফ্রা গুবুননি বিরুদ্ধনাও রায় হৗয়ৗ, মানৗনা নৗংছৗরৗ জেবৗ বিষয়ৈ গুবুননি বিচার খৗলামা মানৗ, নৗংছৗরৗ গাওছৗরখৗনৗ দায় খৗলামনান লায়ৗ, মানৗনা নৗংছৗরৗ জাইফ্রা বিচার খৗলামৗ একই খামানিফৗরখৗনৗ মাওয়ৗ<note caller="+" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="MAT 7:1">মথি 7:1</ref>; <ref loc="LUK 6:37">লূক 6:37</ref></char></note>। <verse eid="ROM 2:1" /><verse number="2" style="v" sid="ROM 2:2" />দা, জৗঙৗ মিথিগৌ যে জাইফ্রা বেবাদি খামানি মাওয়ৗ বিছৗরনি বিরুদ্ধনাও ঈশ্বৗরনি বিচাররা নংগৌনি গেজেরজৗং খৗলামৗ। <verse eid="ROM 2:2" /><verse number="3" style="v" sid="ROM 2:3" />নৗং সাছে মানসি বান, জাইফ্রা বিবাদি মাওয়ৗ বিছৗরখৌ বিচার খৗলামৗ অব্লাবৗ একই জিনিসফৗরখৌ মাওয়ৗ, নৗং কি সান্নৗ ঈশ্বৗরনি বিচারনিফ্রায় এরাইনৗ হানায়? <verse eid="ROM 2:3" /><verse number="4" style="v" sid="ROM 2:4" />কিন্বা নৗং বিনি অন্নায়, আরৗ সহায়নায় আরৗ সৈছৗনায় ধৗনখৌ মুগৈনায় দিন্ঠিয়ৗ? নৗঙৗ মা কি মিথিয়া ঈশ্বৗরনি অন্নায়া যে নৗংখৌ গৗসৗ ফিনফিনহৗনায়াও লাঙৗ?<verse eid="ROM 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 2:5" />নাথায় নৗংনি অখ্রা গৗসৗনি কারননৈ আরৗ সৗলাইয়ি গৗসৗ, নৗঙৗ ঈশ্বৗরনি রাগনি দিননি জুনৈ গাওনি বিরুদ্ধনাও রাগখৌ জমা খৗলামদৗং, জেব্লা বিনে নিয়াই বিচাররা নুজানায়। <verse eid="ROM 2:5" /><verse number="6" style="v" sid="ROM 2:6" />মানৗনা সাফ্রৗমখৌবৗ গাও গাওনি মাওনায় বাদি ঈশ্বৗরা বিথাই হৗনায়<note caller="+" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="PSA 62:12">গীতফৗর 62:12</ref>; <ref loc="PRO 24:12">বৗচৗন বিজাব 24:12</ref></char></note>। <verse eid="ROM 2:6" /><verse number="7" style="v" sid="ROM 2:7" />জাইফ্রা নাংঠাবনান মৗজাং হাবা মাওবায় থায়ৗ, বিনি মহিমা আরৗ মানখৌ নাগিৎনৗ আরৗ জৗবনৗ গৈয়ি গৗঠাংখৌ মৗন্নৗ হাস্থাইয়ৗ, ঈশ্বৗরা জৗবনৗ গৈয়ি গৗঠাংখৌ হৗনায়। <verse eid="ROM 2:7" /><verse number="8" style="v" sid="ROM 2:8" />নাথায় জাইফ্রা গাওনিখৌ বান নাগিৎনৗ, আরৗ জাইয়া নংগৌখৌ গারৗ আরৗ গাজ্রিনি উন উন থাঙৗ, ঈশ্বৗরা বিছৗরনি ছায়াও রাগখৌ আরৗ বৗরাবনায়খৌ লুফাওহৎনায়। <verse eid="ROM 2:8" /><verse number="9" style="v" sid="ROM 2:9" />বে গাজ্রি মাওনায় মানসিফৗরহা কষ্ট আরৗ জৗবৗদ দুঃখু জানায়, সিগাং যিহূদীনি জুনৈ, বিনি উনাও গুবুনহারিনি থাখৈ। <verse eid="ROM 2:9" /><verse number="10" style="v" sid="ROM 2:10" />নাথায় সাফ্রৗমবৗ মৗজাং হাবা মাওগ্রাফৗরনৗ ঈশ্বৗরা মহিমা, মান আরৗ শান্তি হৗনায়, সিগাঙাও যিহূদীফৗরনি জুনৈ, বিনি উনাও গুবুনহারিনি থাখৈ। <verse eid="ROM 2:10" /><verse number="11" style="v" sid="ROM 2:11" />মানৗনা ঈশ্বৗরা মৗখাং নাইয়া<note caller="+" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="DEU 10:17">হূদা বিজাব 10:17</ref></char></note>।<verse eid="ROM 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 2:12" />গুবুনহারিফৗরা আইন গৈয়িয়াও পাপ মাওয়ৗ, বিছৗরৗ আইন গৈয়িয়াওনৗ সংহার জানায়, আরৗ যিহূদীফ্রা আইননি সিঙাও থানান পাপ মাওয়ৗ, বিছৗরৗ আইনজৗংনৗ বিচার খৗলামজানায়। <verse eid="ROM 2:12" /><verse number="13" style="v" sid="ROM 2:13" />মানৗনা জাইফ্রা আইনখৌ খৗনাছঙৗ বিছৗরৗ ঈশ্বৗরনি সিগাঙাও ধৗরৗমিয়া জায়া, নাথায় জাইফ্রা আইনখৌ মানিয়ৗ বিছৗরখৌ ধৗরৗমিয়া হৗন্নানৈ মিথিসাৎহৗজায়ৗ। <verse eid="ROM 2:13" /><verse number="14" style="v" sid="ROM 2:14" />সৈথৗয়ৈ, জেব্লা গুবুনহারিফৗরহা লিৎনায় আইন গৈয়া, স্বভাবনি গেজেরজৗং আইননি নাংগৌ জিনিসফৗরখৌ মাওয়ৗ, বিছৗরৗ দিন্ঠিয়ৗ যে আইনখৌ মিথিয়ৗ। <verse eid="ROM 2:14" /><verse number="15" style="v" sid="ROM 2:15" />বিছৗরৗ দিন্ঠিয়ৗ যে আইনি নাংগৌফ্রা বিছৗরনি গৗসৗয়াও লিৎনায় দং, বিছৗরনি বিবেকয়াওবৗ সাক্ষ্য হৗয়ৗ, বিছৗরনি মৗজাং গাজ্রি সাননৗ হানায় গৗহৗয়া মাব্লাবা মাব্লাবা বিছৗরখৌ দোষি খৗলামৗ আরৗ মাব্লাবা মাব্লাবা রক্ষা খৗলামৗ। <verse eid="ROM 2:15" /><verse number="16" style="v" sid="ROM 2:16" />বেয়ৗ বি দিন জানায় জেব্লা ঈশ্বৗরা খ্রীষ্ট যীশুনি গেজেরজৗং মানসিফৗরনি সিংনি থানায়ফৗরখৌ বিচার খৗলামনায়, জেরৈ বাদি আংনি মৗজাং খবরখৌ মিথিসাৎ হৗয়ৗ।<verse eid="ROM 2:16" /></para>
  <para style="s">যিহূদীফৗর আরৗ আইন</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17" />দা নৗঙৗ, যদি গাওখৌ সাছে যিহূদী হৗনৗব্লা, নৗঙৗ আইননি ছায়াও সৗনাৎনৗব্লা আরৗ ঈশ্বৗরনিয়াও বিশেষ সৗমৗন্দৈ গৗগা খৗলাম। <verse eid="ROM 2:17" /><verse number="18" style="v" sid="ROM 2:18" />নৗঙৗ বিনি ইচ্ছাখৌ মিথিয়ৗ আরৗ জেয়া সাবসিন বেখৌ গনায়থি হৗ মানৗনা নৗঙৗ আইননি গেজেরজৗং ফৗরৗংজানায়। <verse eid="ROM 2:18" /><verse number="19" style="v" sid="ROM 2:19" />নৗঙৗ ফৗথায়ৗব্লা যে নৗঙৗ খানাফৗরখৌ লামা দিন্ঠিগ্রা, জাইফ্রা খৗমসিয়াও দং বিছৗরনি জুনৈ স্রাং। <verse eid="ROM 2:19" /><verse number="20" style="v" sid="ROM 2:20" />নৗঙৗ ফৗথায়ৗব্লা জাম্বাফৗরনি ফৗরৗংগিরি, গৗলৈফৗরনি সাছে ফৗরৗংগিরি, মানৗনা নৗংজৗং লৗগৗছে আইননি জ্ঞান আরৗ নংগৌয়া ফুরা দং। <verse eid="ROM 2:20" /><verse number="21" style="v" sid="ROM 2:21" />অব্লা, নৗঙৗ, জাইয়া গুবুনফৗরখৌ ফৗরৗঙৗ, মা কি নৗং গাওখৌ ফৗরৗঙা? নৗঙৗ জাইয়া খাওনায়নি বিরুদ্ধনাও প্রচার খৗলামৗ, নৗঙৗ মা কি খাওয়ৗ? <verse eid="ROM 2:21" /><verse number="22" style="v" sid="ROM 2:22" />নৗঙৗ জাইয়া মানসিফৗরখৌ বুঙৗ যে জিনাহারি খৗলামনৗ নাঙা, নৗঙৗ মা কি জিনাহারি খৗলামৗ? নৗঙৗ জাইয়া মূর্তিফৗরখৌ মুগৈয়ৗ, নৗঙৗ মা কি মৗদায় দাওদায় পুজিগ্রা মন্দিরনিফ্রায় লুঠিয়ৗ? <verse eid="ROM 2:22" /><verse number="23" style="v" sid="ROM 2:23" />নৗঙৗ যে আইনখৌ মিথিনানৈ ডুগা খৗলামৗ, নৗং মা কি ঈশ্বৗরনি আইনখৌ ছিফাইনানৈ বিখৌ লাজি ফৗনাংঙৗ? <verse eid="ROM 2:23" /><verse number="24" style="v" sid="ROM 2:24" />শাস্ত্রয়াও লিৎনায় দং, “নৗংছৗরনিফ্রায় গুবুনহারিফৗরনি গেজেরাও ঈশ্বৗরনি মুঙা নিন্দিজায়ৗ<note caller="+" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="ISA 52:5">যিশাইয় 52:5</ref>; <ref loc="EZK 36:22">যিহিষ্কেল 36:22</ref> </char></note>।”<verse eid="ROM 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25" />নৗঙৗ আইনখৌ মানিব্লা, নৗংনি ত্বকচ্ছেদ খৗলামজানায়া লাভ দং; নাথায় নৗঙৗ আইনখৌ মানিয়াব্লা, নৗঙৗ ত্বকচ্ছেদ খৗলামজায়িফৗর বাদিছৗ? <verse eid="ROM 2:25" /><verse number="26" style="v" sid="ROM 2:26" />বিনিখাইনৗ জাইফ্রা ত্বকচ্ছেদ খৗলামজায়ি গুবুনহারিফ্রা আইনখৌ ফালিয়ৗব্লা, ত্বকচ্ছেদ খৗলামজায়াখৈব্লাবৗ ঈশ্বৗরা বিছৗরখৌ ত্বকচ্ছেদ খৗলামজানায়ফৗরখৌ বাদি সান্নায় অৗঙা না? <verse eid="ROM 2:26" /><verse number="27" style="v" sid="ROM 2:27" />জাইয়া ত্বকচ্ছেদ খৗলামজায়াখৈ আরৗ দাবৗনৗ আইনখৌ মানিনানৈ চলিয়ৗ বিয়ৗ নৗংখৌ দায়হমনায়, যদিও নৗংছৗরনিয়াও লিৎনায় আইন দং আরৗ ত্বকচ্ছেদ জাবায়, অব্লাবৗ বিয়ৗ সাছে আইন ছিফাইগ্রা।<verse eid="ROM 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 2:28" />মানৗনা বাইরায়াও জাইয়া যিহূদি বিয়ৗ যিহূদি অৗঙা যে বিয়ৗ বাইরানি সাছে, আরৗ ত্বকচ্ছেদ বাননা বাইরানি আরৗ মৗদৗমনি অৗঙা। <verse eid="ROM 2:28" /><verse number="29" style="v" sid="ROM 2:29" />অৗঙা, নাথায় জাইয়া সাছে গৗসৗ সিঙাও যিহূদী, বিয়ৗ নংথারগৌ যিহূদী, লিৎনায় আইনজৗং অৗঙা, নাথায় জাইনি গৗসৗয়া ঈশ্বৗরনি জিউজৗং ত্বকচ্ছেদ খৗলামজানায়। বেবাদি মানসিয়া ঈশ্বৗরজৗং বাখ্নায়জায়ৗ, মানসিজৗং অৗঙা<note caller="+" style="x"><char style="xo" closed="false">2:29 </char><char style="xt" closed="false"><ref loc="DEU 30:6">হূদা বিজাব 30:6</ref></char></note>।<verse eid="ROM 2:29" /></para>
  <chapter eid="ROM 2" />
  <chapter number="3" style="c" sid="ROM 3" />
  <para style="s">ঈশ্বৗরনি ফৗথাইনায়</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1" />অব্লা যিহূদি জানানৈ মা সুবিদা দং? কিন্বা ত্বকছেদ খৗলামজানায়া মা দাম দং? <verse eid="ROM 3:1" /><verse number="2" style="v" sid="ROM 3:2" />জেরৈনিফ্রায়বৗ গৗবাং, সিগাঙাও যিহূদীফৗরনি ছায়াও, ঈশ্বৗরনি রাওয়া ভরসা হৗজাদৗং।<verse eid="ROM 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 3:3" />যদি বিছৗরনি খাইছে খাইছেয়া ফৗথাইয়াব্লা, বিছৗরনি ফৗথাইয়িয়া মা কি ঈশ্বৗরনি ফৗথাইনায়াও ফেলেং জানায় নামা? <verse eid="ROM 3:3" /><verse number="4" style="v" sid="ROM 3:4" />অৗংমাৎথারা, ঈশ্বৗরা নংথারগৌ আরৗ সাফ্রৗমবৗ মানসিয়া নংখাই। জৗরৈ বাদি লিৎনায় দং,</para>
  <para style="p" vid="ROM 3:4">“জাহাথে নৗঙৗ খৗথা বুংনাইয়াও ঠিক প্রমাণ হৗনৗ হায়ৗ আরৗ নৗঙৗ বিচারনি সমাও বিজয় জানৗ হায়ৗ<note caller="+" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="PSA 51:4">গীতফৗর 51:4</ref> </char></note>।”<verse eid="ROM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 3:5" />নাথায় জৗংনি অধৗরৗমিয়া মাওনায়জৗং ঈশ্বৗরনি ধৗরৗমিয়া মাওনাইয়া রৗখা রৗখাসিন দিন্ঠিজায়ৗব্লা, জৗঙৗ মা বুংনায়? ঈশ্বৗরা অধৗরৗমিয়া অৗঙা, জাইয়া অন্যায়নি থাখৈ জৗংনি ছায়াও রাগ দিন্ঠিয়ৗ? আঙৗ মানসিফৗর বাদি তর্ক হৗদৗং। <verse eid="ROM 3:5" /><verse number="6" style="v" sid="ROM 3:6" />নংথারগৌয়ৈ নৗঙা! যদি বিবাদি জায়ৗ, অব্লা মাব্রৈ ঈশ্বৗরা বে সংসারখৌ বিচার খৗলামনায়? <verse eid="ROM 3:6" /><verse number="7" style="v" sid="ROM 3:7" />খাইছেফ্রা হয়তো তর্ক খৗলামনৗ হাগৌ, “আংনি নংখাইয়া যদি ঈশ্বৗরনি নংথারগৌ বাংহৗয়ৗ আরৗ বিনি মহিমাখৌ বাংহৗয়ৗ, অব্লা মানৗ দাবৗনৗ আঙৗ পাপী হৗন্নানৈ দোষি খৗলামজায়ৗ?” <verse eid="ROM 3:7" /><verse number="8" style="v" sid="ROM 3:8" />মানৗ বুঙাখৈ-জেরৈ ছৗরবা ছৗরবায়া খৈফৗৎনাওবৗ দাবি খৗলামৗ যে জৗঙৗ বুঙৗ, “ফৈ জৗং গাজ্রি মাওনি জাহাথে মৗজাং বিথাই মৗন্নৗ হায়ৗ?” বিছৗরনি দোষ খৗলামনাইয়া ঠিক বিচার জানায়!<verse eid="ROM 3:8" /></para>
  <para style="s">রাওবৗ ধৗরৗমিয়া অৗঙা</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9" />অব্লা জৗং মা বাদিয়ৈ ফৗজৗবনায়? জৗং যিহূদিয়ারিফ্রা মা কি গুবুনফৗরনিফ্রায় সাবসিন? মঠৈ অৗঙা! মানৗনা জৗঙৗ সিগাঙাওনৗ দায়ি খৗলামদৗং যে, যিহূদি আরৗ গুবুনহারি গাছেনবৗ পাপনি বৗলৗনি সিঙাও। <verse eid="ROM 3:9" /><verse number="10" style="v" sid="ROM 3:10" />জেরৈবাদি লিৎনায় দং,</para>
  <para style="p" vid="ROM 3:10">“ধৗরৗমিয়া রাওবৗ গৈয়া, সাছেবৗ <note caller="+" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="PSA 14:1-3">গীতফৗর 14:1–3</ref> </char></note>গৈয়া। <verse eid="ROM 3:10" /><verse number="11" style="v" sid="ROM 3:11" />বিহা বুজিগ্রা এমন কি সাছেবৗ গৈয়া, ঈশ্বৗরখৌ নাগিৎগ্রা এমন কি সাছেবৗ গৈয়া।<verse eid="ROM 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 3:12" />বয়বৗ ঈশ্বৗরনিফ্রায় গৗজানাও থাংবায়, বিছৗরৗ গাছেনবৗ অযোগ্য জাবায়, বিহা মৗজাং খামানি মাওগ্রা সাছেবৗ গৈয়া, দাবৗনৗ সাছেবৗ গৈয়া।”<verse eid="ROM 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 3:13" />“বিছৗরনি গারাংবায়া গেওনায় গৗথৈ হাখর বাদিছৗ, বিছৗরনি ছালাইয়া ছৗলৈগ্রা আদথ জাবায়;” “বিছৗরনি গুসুষ্টিয়াও জিবৌনি বিষ দং<note caller="+" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="PSA 5:9">গীতফৗর 5:9</ref>; <ref loc="PSA 104:3">104:3</ref></char></note>।”<verse eid="ROM 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 3:14" />“বিছৗরনি খগাফ্রা সাও আরৗ গৗখা রাওজৗং বুংফবনায়।”<verse eid="ROM 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 3:15" />“বিছৗরনি আঠেংফ্রা থৈ বৗহৈহৗনায়াও গৗখ্রৈ থাঙৗ।<verse eid="ROM 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 3:16" />বিছৗরৗ জেরৌ জেরৗও থাঙৗ, বিয়াওনৗ জৗবস্রাংনায় আরৗ দুঃখু কষ্টয়া থাংফায়ৗ,<verse eid="ROM 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 3:17" />আরৗ শান্তিনি লামাখৌ বিছৗরৗ মিথিয়া।”<verse eid="ROM 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 3:18" />“বিছৗরনি মগননাও ঈশ্বৗরখৌ গিনায়া গৈয়া<note caller="+" style="x"><char style="xo" closed="false">3:18 </char><char style="xt" closed="false"><ref loc="PSA 36:1">গীতফৗর 36:1</ref></char></note>।”<verse eid="ROM 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19" />দা জৗঙৗ মিথিগৌ যে আইননা জেখিয়া বুঙৗ, আইনি সিঙাও থাগ্রাফৗরখৌ আইননা হৗন্নৗ; বিনিখাইনৗ সাফ্রৗমনিবৗ খৌগায়া স্রিয়ৈ থায়ৗ আরৗ সংসারনি গাছেনখৌবৗ ঈশ্বৗরনি সিগাঙাও হিসাব হৗনাংনায়। <verse eid="ROM 3:19" /><verse number="20" style="v" sid="ROM 3:20" />বিনিখাইনৗ আইনখৌ ফালিনানৈ ঈশ্বৗরনি নৗজৗরাও রাওবৗ ধৗরৗমিয়া সানজায়া; মানৗনা আইননা জৗংখৌ পাপী হৗন্নানৈ দিন্ঠিয়ৗ<note caller="+" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="PSA 143:2">গীতফৗর 143:2</ref>; <ref loc="GAL 2:16">গালাতীয় 2:16</ref> </char></note>।<verse eid="ROM 3:20" /></para>
  <para style="s">ফৗথাইনায়নি গেজেরজৗং ধৗরৗমিয়া</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21" />নাথায় দা আইনখৌ নাগারনান ঈশ্বৗরা ধৗরৗমিয়া মিথিসাৎ হৗজাবায়, মোশিনি আইন আরৗ নবিফৗরনি গেজেরজৗং বেখৌ সাক্ষী হৗদৗং। <verse eid="ROM 3:21" /><verse number="22" style="v" sid="ROM 3:22" />জাইফ্রা যীশু খ্রীষ্টখৌ ফৗথায়ৗ, বিছৗরৗ বে ফৗথাইনায়নি গেজেরজৗংনৗ ঈশ্বৗরনি ধৗরৗমিয়া বিছৗরনি গেজেরাও যিহূদী আরৗ গুবুনহারি বিহা আলাদা গৈয়া। <verse eid="ROM 3:22" /><verse number="23" style="v" sid="ROM 3:23" />মানৗনা সাফ্রৗমবৗ পাপ মাওবায় আরৗ ঈশ্বৗরনি মহিমানিফ্রায় গৗজান জাবায় <verse eid="ROM 3:23" /><verse number="24" style="v" sid="ROM 3:24" />আরৗ সাফ্রৗমনৗবৗ বিনি অনুগ্রহজৗং অরৈনৗ হৗন্নানৈ যীশু খ্রীষ্টআ পাপনিফ্রায় বাইখনানৈ ঈশ্বৗরা জৗংখৌ ধৗরৗমিয়া সাননানৈ লাবায়। <verse eid="ROM 3:24" /><verse number="25" style="v" sid="ROM 3:25" />ঈশ্বৗরা খ্রীষ্টখৌ সুদ্রায়নায়নি ফাসকা বুলি হিসাবমৈ গথাইদৗং, বিনি থৈ ফসরহৗনায়নি গেজেরজৗং নাজাওজায়ৗ। বিয়ৗ বিনি ধৗরৗমিয়াখৌ দিন্ঠিনৗ থাখৈ বেখৌ খৗলামবায়, মানৗনা বিনি সহায়নৗহানায়া সিগাংনিফ্রায় পাপফৗরখৌ শাস্তিহিন খৗলামদৗং, <verse eid="ROM 3:25" /><verse number="26" style="v" sid="ROM 3:26" />বিয়ৗ বেখৌ মাওদৗং বর্তমান সমমা বিনি ধৗরৗমিয়া, জাহাথে বিয়ৗ গাওখৌনৗ ধৗরৗম গৗনাং দিন্ঠিয়ৗ, আরৗ জাইফৗরনে যীশুনিয়াও ফৗথাইনায় দং বিছৗরখৌবৗ ধৗরৗমিয়া সাননানৈ লায়ৗ।<verse eid="ROM 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27" />অব্লা জৗংনি ডুগায়া ববেহা থাংখৗ? বেয়ৗ গৗজান জাবায়। নাথায় মা বাদি আইনজৗং? বে আইননা মা কি খামানিফৗরনি গেজেরজৗং? অৗঙা, নাথায় আইননি ফৗথাইনায়জৗং। <verse eid="ROM 3:27" /><verse number="28" style="v" sid="ROM 3:28" />মানৗনা আইননি খামানিখৌ নাগারনান জৗংনি ফৗথাইনায়জৗং ঈশ্বৗরা জৗংখৌ ধৗরৗমিয়া সাননানৈ লাবায়। <verse eid="ROM 3:28" /><verse number="29" style="v" sid="ROM 3:29" />মা কি, ঈশ্বৗরা যিহূদীফৗরনি বান ঈশ্বৗর নামা? গুবুনহারিফৗরনিবৗ ঈশ্বৗর অৗঙা নামা? নংগৌ, বিয়ৗ গুবুন জাতিফৗরনিবৗ ঈশ্বৗর, <verse eid="ROM 3:29" /><verse number="30" style="v" sid="ROM 3:30" />বিহা সাছে বান ঈশ্বৗর, জাইয়া ফৗথাইনায়জৗং ত্বকছেদ আরৗ অত্বকছেদ মানসিফৗরখৌ একই ফৗথাইনায়নি গেজেরজৗং ধৗরৗমিয়া খৗলামৗ<note caller="+" style="x"><char style="xo" closed="false">3:30 </char><char style="xt" closed="false"><ref loc="DEU 6:4">হূদা বিজাব 6:4</ref>; <ref loc="GAL 3:20">গালাতীয় 3:20</ref> </char></note>। <verse eid="ROM 3:30" /><verse number="31" style="v" sid="ROM 3:31" />অব্লা জৗঙৗ বে ফৗথাইনায়নি গেজেরজৗং আইনখৌ ফেলেং খৗলামদৗং নামা? গাছেনবৗ অৗঙা! বরং জৗঙৗ আইনখৌ দিখাঙৗ।<verse eid="ROM 3:31" /></para>
  <chapter eid="ROM 3" />
  <chapter number="4" style="c" sid="ROM 4" />
  <para style="s">অব্রাহামনি ফৗথাইনায়</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1" />অব্লা জৗংনি গৗডৗনি বিফা অব্রাহামনি বিষয়ৈ জৗং মা বুঙৗ? মৗদৗমনি অনুজায়ৈ বে বিষয়ৈ বিয়ৗ মা দিহুননামৗন? <verse eid="ROM 4:1" /><verse number="2" style="v" sid="ROM 4:2" />যদি অব্রাহামা খামানি মাওনায়জৗং ধৗরৗমিয়া সানজাদৗংব্লা, বিহা ডুগা খৗলামনৗ বিষয় দং; নাথায় ঈশ্বৗরনি সিগাঙাও অৗঙা। <verse eid="ROM 4:2" /><verse number="3" style="v" sid="ROM 4:3" />শাস্ত্রয়া মা বুঙৗ? “অব্রাহামা ঈশ্বৗরখৌ ফৗথায়দৗং, আরৗ বেনি জুনৈ বিয়ৗ ধৗরৗমিয়া হিসাবমৈ সানজাদৗং<note caller="+" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="GEN 15:6">জাগাইজেন্নায় 15:6</ref>; <ref loc="GAL 3:6">গালাতীয় 3:6</ref> </char></note>।”<verse eid="ROM 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 4:4" />জাইয়া খামানি মাওয়ৗ, বিয়ৗ হাজিরাখৌ মৗন্নৗ, আরৗ বিখৌ অন্নায়নি দান হৗয়া, নাথায় মৗন্নায়নি বাধ্য। <verse eid="ROM 4:4" /><verse number="5" style="v" sid="ROM 4:5" />জায়কিয়া জায়ামানৗ, ঈশ্বৗরা বি মানসিখৌ ধৗরৗমিয়া সান্নৗ, জাইয়া বিনি ছাও ভরসা খৗলামৗ, জাইয়া বিজৗং পাপফৗরখৌ সঠিক খৗলামৗ, আরৗ জাইয়া গাওনি খামানি ছায়াও ভরসা খৗলামা। <verse eid="ROM 4:5" /><verse number="6" style="v" sid="ROM 4:6" />দায়ূদনা একই জিনিসখৌ বুঙৗ জেব্লা বিয়ৗ বি মানসিনি আর্শীবাদনি খৗথা বুঙৗ জাইখৌ ঈশ্বৗররা ধৗরৗমিয়া সান্নৗ, যদিও বিয়ৗ ঈশ্বৗরনি অন্নায়খৌ মৗন্নৗ জেবৗ মাওয়াখৈমৗন।<verse eid="ROM 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 4:7" />“ধন্য বিছৗরৗ<note caller="+" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="PSA 32:1-2">গীতফৗর 32:1–2</ref></char></note>, জাইফৗরনি পাপফ্রা ক্ষমা হৗজাবায় আরৗ বিছৗরনি পাপফ্রা খৗবনানৈ দৗনজাদৗং।<verse eid="ROM 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 4:8" />ধন্য বি সাছেয়া, জাইনি পাপফৗরনি বিরুদ্ধনাও ফৗরবুআ মাব্লাবাবৗ সানবাওলে।”<verse eid="ROM 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9" />বে আশীর্বাদনা মাকি ত্বকচ্ছেদ খৗলাম জানায় যিহূদীফৗরনি বান? না অত্বকচ্ছেদ গুবুনহারিফৗরনি থাখৈবৗ? মানৗনা জৗঙৗ বুঙৗ যে অব্রাহামা বিনি ফৗথাইনায়াও ধৗরৗমিয়া সানজাদৗং মৗন। <verse eid="ROM 4:9" /><verse number="10" style="v" sid="ROM 4:10" />মা বে অবস্থানিফ্রায় সানজাখৗ? মা ত্বকচ্ছেদ খৗলামনায়নি উনাও না সিগাংয়াও? বিয়ৗ উনাও অৗঙা, নাথায় সিগাং! <verse eid="ROM 4:10" /><verse number="11" style="v" sid="ROM 4:11" />আরৗ বিয়ৗ ত্বকচ্ছেদনি চিহ্ন মৗনদৗংমৗন জেন দিন্ঠিয়া জায়ৗ যে ঈশ্বৗরা বিখৌ ধার্মিক হৗন্নানৈ নাজাওবায় মানৗনা বিয়ৗ ফৗথাইয়া মৗন। বে জায়ামৗন জেব্লা বিয়ৗ অত্বকচ্ছেদ অবস্থাওনৗ দংমৗন<note caller="+" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="GEN 17:10">জাগাইজেন্নায় 17:10</ref> </char></note>। <verse eid="ROM 4:11" /><verse number="12" style="v" sid="ROM 4:12" />আরৗ বিয়ৗ ত্বকচ্ছেদ খৗলাম জানায় মানসিফৗরনিবৗ বিফা; জাইফ্রা ত্বকচ্ছেদ জাবায় বিছৗরনি বান অৗঙা, নাথায় অত্বকচ্ছেদ অবস্থাও জৗংনি বিফা অব্রাহামনে যে ফৗথাইনায় দংমৗন, জাইফ্রা বিনি আঠেংনি চিহ্নয়াও থাবাইয়ৗ, বিয়ৗ বিছৗরনিবৗ বিফা।<verse eid="ROM 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13" />মানৗনা সংসারনি উত্তরাধিকারি জাহৗনৗ অব্রাহাম আরৗ বিনি জৗলৈফৗরনৗ জবান হৗনায় মোশিনি আইনখৌ মানিনানৈ জায়াখৈ, নাথায় বিনি ফৗথাইনায়নি থাখৈ ঈশ্বৗরা বিখৌ ধৗরৗমিয়া খৗলামবায়<note caller="+" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="GAL 3:29">গালাতীয় 3:29</ref> </char></note>। <verse eid="ROM 4:13" /><verse number="14" style="v" sid="ROM 4:14" />বিনিখাইনৗ জাইফ্রা গাওছৗরনি আইননি বাথ্রা মানিনায়নি ছায়াও বান ভরসা খৗলামৗ, বিছৗরৗ যদি উত্তরাধিকারি জায়ৗ, অব্লা বে ফৗথাইনায়া নংখায় বাখায়, আরৗ বি জবাননা অযোগ্য<note caller="+" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="GAL 3:18">গালাতীয় 3:18</ref> </char></note>, <verse eid="ROM 4:14" /><verse number="15" style="v" sid="ROM 4:15" />মানৗনা আইনা রাগখৌ লাবৗয়ৗ। নাথায় জেরেও আইন গৈয়া, বিহা আইন ছিফায়গ্রা গৈয়া।<verse eid="ROM 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 4:16" />বিনিখাইনৗ বে জবাননা ফৗথাইনায়নি গেজেরজৗং ফৈয়ৗ, জাহাথে অনুগ্রহনি গেজেরজৗং আরৗ অব্রাহামনি গাছেন জৗলৈফৗরনি থাখৈ জামিন জায়ৗ, জাইফ্রা মোশিনি আইনখৌ মানিয়ৗ বিছৗরনি থাখৈ বান অৗঙা, নাথায় বে উত্তরাধিকারিয়া বিছৗরনি থাখৈবৗ জাইফ্রা ঈশ্বৗরনি ছায়াও ভরসা খৗলামৗ জেরৈ বাদি অব্রাহামা খৗলামা মৗন। মানৗনা বিয়ৗ জৗং বয়নিবৗ বিফা<note caller="+" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="GAL 3:7">গালাতীয় 3:7</ref></char></note>। <verse eid="ROM 4:16" /><verse number="17" style="v" sid="ROM 4:17" />জেরৈ লিৎনায় দং: “আঙৗ নৗংখৌ গৗবাং জাতিফৗরনি বিফা খৗলামবায়।” বিয়ৗ ঈশ্বৗরনি নৗজৗরাও জৗংনি বিফা, জাইখৌ বিয়ৗ ফৗথাইবায়, জাইয়া গৗথৈফৗরখৌ জীবন হৗয়ৗ, আরৗ জেয়া গৈয়া বিখৌ খৗলামৗ। <verse eid="ROM 4:17" /><verse number="18" style="v" sid="ROM 4:18" />বিফা জানায়নি আশা গৈয়াব্লাবৗ, অব্রাহামা ঈশ্বৗরনি বুংনায়খৌ ফৗথাইদৗং আরৗ আশা খৗলামদৗং, গৗবাং জাতিফৗরনি বিফা জানৗ, ঈশ্বৗর বুংনায় বাদি “নৗংহা গৗবাং বংশফৗর জানায়<note caller="+" style="x"><char style="xo" closed="false">4:18 </char><char style="xt" closed="false"><ref loc="GEN 15:5">জাগাইজেন্নায় 15:5</ref> </char></note>।” <verse eid="ROM 4:18" /><verse number="19" style="v" sid="ROM 4:19" />ফৗথাইনায়াও লৗরবাং জায়া মাদনিন, বিনি বয়সা প্রায় একশ বৗছৗর জাবায়মৗন। বিয়ৗ গাওনি থৈয়হাং হাং মৗদৗমখৌ, আরৗ সারানি গৗর্বৗয়া থৈবায়মৗন বিখৌ <note caller="+" style="x"><char style="xo" closed="false">4:19 </char><char style="xt" closed="false"><ref loc="GEN 17:17">জাগাইজেন্নায় 17:17</ref></char></note>মিথিবায়মৗন, <verse eid="ROM 4:19" /><verse number="20" style="v" sid="ROM 4:20" />দাসিমবৗ ঈশ্বৗরনি সিমান লানায়খৌ মাব্লাবাবৗ গৗনৗ গৗথৗ খৗলামাখৈ, নাথায় ফৗথাইনায়াও বৗলৗগ্রা জাবায়, আরৗ ঈশ্বৗরনি মহিমা খৗলামবায়, <verse eid="ROM 4:20" /><verse number="21" style="v" sid="ROM 4:21" />জেখৌ জবান হৗয়ামৗন, বেখৌ মাওনৗ ঈশ্বৗরহা বৗলৗ দং হৗন্নানৈ অব্রাহামা ফুরা ফৗথায়দৗং। <verse eid="ROM 4:21" /><verse number="22" style="v" sid="ROM 4:22" />বিনিখাইনৗ, বেনি জুনৈ বিয়ৗ ধৗরৗমিয়া সানজাদৗং<note caller="+" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="GEN 15:6">জাগাইজেন্নায় 15:6</ref>; <ref loc="GAL 3:6">গালাতীয় 3:6</ref> </char></note>। <verse eid="ROM 4:22" /><verse number="23" style="v" sid="ROM 4:23" />বিয়ৗ ঈশ্বৗরজৗং “ধৗরৗমিয়া সানজাদৗং” বি লিৎনায়ফ্রা বিনৗ বান লিৎনাখৈ, <verse eid="ROM 4:23" /><verse number="24" style="v" sid="ROM 4:24" />নাথায় জৗংনি থাখৈবৗ, যদি জৗং ঈশ্বৗরখৌ ফৗথাইয়ৗব্লা, জাইয়া জৗংনি ফৗরবু যীশুখৌ থৈনায়নিফ্রায় ফৗঠাংফিনদৗং, জৗংবৗ ধৗরৗমিয়া হৗন্নানৈ ঈশ্বৗরজৗং নাজাওজানায়। <verse eid="ROM 4:24" /><verse number="25" style="v" sid="ROM 4:25" />জৗংনি পাপনি থাখৈ বিখৌ থৈনৗ গথাইবায়, আরৗ জৗংখৌ ধৗরৗমিয়া খৗলামনৗ ঠাংখাংফিনহৗবায়।<verse eid="ROM 4:25" /></para>
  <chapter eid="ROM 4" />
  <chapter number="5" style="c" sid="ROM 5" />
  <para style="s">শান্তি আরৗ আশা</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1" />বিনিখাইনৗ, ফৗথাইনায়জৗং জৗঙৗ ধৗরৗমিয়া সানজাখাবায়, ফৗরবু যীশু খ্রীষ্টজৗং আরৗ জৗংনি ঈশ্বৗরনিয়াও শান্তি দং। <verse eid="ROM 5:1" /><verse number="2" style="v" sid="ROM 5:2" />জৗঙৗ খ্রীষ্টখৌ ফৗথাইনায়াও ঈশ্বৗরনি বে অনুগ্রহয়াও জৗং দা গছংনানৈ দং। আরৗ ঈশ্বৗরনি মহিমায়াও ভাগৗ জাফানৗ জৗংহা আশা দং। <verse eid="ROM 5:2" /><verse number="3" style="v" sid="ROM 5:3" />বিবান অৗঙা, নাথায় জৗংঙৗ জৗংনি দুঃখু কষ্টয়াওবৗ রংজায়ৗ, মানৗনা জৗঙৗ মিথিগৌ দুঃখু কষ্টয়া সৈছৗনায়খৌ সৗম্জিহৗয়ৗ। <verse eid="ROM 5:3" /><verse number="4" style="v" sid="ROM 5:4" />সৈছৗনায়া আখল আখুখৌ লুখাংঙৗ জেয়া জৗংনৗ আশা হৗয়ৗ। <verse eid="ROM 5:4" /><verse number="5" style="v" sid="ROM 5:5" />আরৗ আশায়া জৗংখৌ লজিহৗয়া, মানৗনা ঈশ্বৗরা জৗংনি থাখৈ গৗথার জিউখৌ হৗবায়, জেয়া জৗংনি গৗসৗয়াও গাওনি অন্নায়খৌ লুনানৈ হৗবায়।<verse eid="ROM 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6" />বে এরেই বাদি, জেরৈ ঠিক সমাও, জেব্লা জৗঙৗ বৗলৗ গৈয়ামৗন, খ্রীষ্টআ ঈশ্বৗরহারাফৗরনি থাখৈ থৈবায়। <verse eid="ROM 5:6" /><verse number="7" style="v" sid="ROM 5:7" />বাংসিন মানসিয়া সাছে ধৗরৗমিয়া মানসিনি থাখৈ থৈনৗ রাজি জানায় অৗঙা, যদিও ছৗরবা সাছে মৗজাং মানসিনি থাখৈ থৈনৗ রাজি জানৗ হাগৌ জাইয়া বিরাঠ মৗজাং। <verse eid="ROM 5:7" /><verse number="8" style="v" sid="ROM 5:8" />নাথায় ঈশ্বৗরা জৗংনি থাখৈ বিয়ৗ গাওনি অন্নায়খৌ নুজাসাৎহৗবায়: জেব্লা জৗঙৗ পাপী মৗন, অব্লা খ্রীষ্টআ জৗংনি থাখৈ থৈবায়।<verse eid="ROM 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 5:9" />বে সত্য যে জৗঙৗ দা বিনি থৈজৗং ধৗরৗমিয়া সানজাবায়, বিনি গেজেরজৗং জৗঙৗ বেছেগ্রাব ঈশ্বৗরনি রাগনিফ্রায় বাছাইজানায়। <verse eid="ROM 5:9" /><verse number="10" style="v" sid="ROM 5:10" />জেব্লা জৗঙৗ ঈশ্বৗরনি বিসারু মৗন, অব্লা বিনি বিসাজ্লানি থৈনায়নি গেজেরজৗং জৗংখৌ বেংজ্লাইহৗবায়। আরৗ নংথারগৌয়ৈ বিনি জিউনি গেজেরজৗং জৗঙৗ বাছাইজানায়। <verse eid="ROM 5:10" /><verse number="11" style="v" sid="ROM 5:11" />বেজৗং বান অৗঙা, নাথায় জৗঙৗ ঈশ্বৗরনিয়াও ফৗরবু যীশু খ্রীষ্টনি গেজেরজৗং ডুগা খৗলামৗ, জাইনি গেজেরজৗং জৗঙৗ দা মিলায়জ্লাইনায়খৌ নাজাওনৗ মৗনবায়।<verse eid="ROM 5:11" /></para>
  <para style="s">আদমনি গেজেরজৗং থৈনায় আরৗ খ্রীষ্টনি গেজেরজৗং গৗঠাং</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12" />বিনিখাইনৗ, জেরৈ বাদি সাছে মানসিনি গেজেরজৗং সংসারাও পাপমা হাবদৗং, আরৗ পাপনি গেজেরজৗং থৈনায়া, আরৗ বেবাদিয়ৈ থৈনায়া গাছেন মানসিফৗরনেও ফৈদৗং, মানৗনা গাছেনবৗ পাপ মাওদৗং।<note caller="+" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="GEN 3:16">জাগাইজেন্নায় 3:16</ref></char></note><verse eid="ROM 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 5:13" />আইনখৌ হৗনায়নি সিগাঙনৗ সংসারাও পাপমা দংখায়ৗ মৗন, নাথায় জেরৌ আইন গৈয়া বিহা রাওবৗ পাপী গণায় জায়া। <verse eid="ROM 5:13" /><verse number="14" style="v" sid="ROM 5:14" />অব্লাবৗ আদমনি সমনিফ্রায় লানানৈ মোশিনি সমসিম থৈনায়া শাসন খৗলামদৗং, এমন কি বিছৗরনি ছায়াও জাইফ্রা আদেশখৌ ছিফাইনানৈ পাপ মাওয়াখৈ, জৗরৈ আদমমা মাওয়ামৗন, জাইয়া ফৈগৌনি মৗনছে মহর।<verse eid="ROM 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 5:15" />নাথায় বে দাননা অন্যায় বাদি অৗঙা। বে সাছে মানসিনি পাপনি জুনৈ, আদমমা, গৗবাংনি জুনৈ থৈনায়খৌ লাবৗদৗংমৗন। নাথায় বেনিফ্রায় দেৎসিননা জাবায় ঈশ্বৗরনি সৗমৗ নাংথাও অনুগ্রহ আরৗ বে গুবুন মানসি, যীশু খ্রীষ্টনি গেজেরজৗং গৗবাংনি জুনৈ নিমাহানি দান। <verse eid="ROM 5:15" /><verse number="16" style="v" sid="ROM 5:16" />সাছে মানসিনি পাপ মাওনায় আরৗ ঈশ্বৗরনি দান হৗনায় বিথাইজৗং রুজুজায়া। জেব্লা আদমআ পাপ মাওবায়, ঈশ্বৗরা মৗনছে বিচার হৗবায় আরৗ বে বিথাইয়া দায়গৗনাং মৗন। নাথায় গৗবাং মানসি পাপ মাওনায়নি উনাও, ঈশ্বৗরা মৗনছে দান হৗবায়, আরৗ বে বিথাইয়া ধৗরৗমিয়া মৗন। <verse eid="ROM 5:16" /><verse number="17" style="v" sid="ROM 5:17" />মানৗনা, যদি সাছে মানসনি পাপ মাওনায়নি দারৈ, বি সাছে মানসিনি গেজেরজৗং থৈনায়া শাসন খৗলামৗ, অব্লা জাইফৗরনি অনুগ্রহয়া গৗবাং আরৗ ধৗরৗমিয়ানি দান মৗন্দৗং বিছৗরৗ সাছে মানসি, যীশু খ্রীষ্টনি গেজেরজৗং জিউয়াও রাজ খৗলামনায়।<verse eid="ROM 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 5:18" />জেরৈ বাদি সাছে মানসিনি পাপ মাওনায়নি গেজেরজৗং গাছেন মানসিনিয়াও নিন্দিজানায় বিথাই ফৈদৗং, বিবাদিনৗ সাছে ধৗরৗমিয়ানি খামানিনি গেজেরজৗং মানসিফৗরনি জিউয়াও ধৗরৗমিয়া সানজাদৗং। <verse eid="ROM 5:18" /><verse number="19" style="v" sid="ROM 5:19" />মানৗনা জেরৈ বাদি সাছে মানসিনি আজ্ঞা লায়িয়াও জেরৈ গৗবাং মানসিফ্রা পাপী খৗলামজাদৗং, নাথায় বিবাদিনৗ সাছে মানসিনি ধৗরৗমিয়া খামানি মাওনায়জৗং গৗবাং গৗদান জীবন লাবৗয়ৗ।<verse eid="ROM 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 5:20" />ঈশ্বৗরনি আইনখৌ হৗয়া মৗন, জেন গাছেন মানসিফ্রা গাওছৗর মাব্রৈ পাপমাওমৗন বিখৌ মিথিনৗ, নাথায় জেব্লা পাপমা বাংদৗং, অনুগ্রহয়া বয়নিবৗ ছায়াও বাংসিনবাওদৗং। <verse eid="ROM 5:20" /><verse number="21" style="v" sid="ROM 5:21" />জেরৈ বাদি পাপমা থৈনায়খৌ শাসন খৗলামদৗং, বিবাদিনৗ অনুগ্রহয়া ধৗরৗমিয়ানি গেজেরজৗং জৗবনৗ গৈয়ি গৗঠাঙা জৗংনি ফৗরবু যীশু খ্রীষ্টনি গেজেরজৗং শাসন খৗলামদৗং।<verse eid="ROM 5:21" /></para>
  <chapter eid="ROM 5" />
  <chapter number="6" style="c" sid="ROM 6" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1" />অব্লা, জৗঙৗ মা বুংনৗ? জৗঙৗ মা কি পাপ মাওগাছেন থানায় জেন অনুগ্রহয়া বারাইয়ৗ? <verse eid="ROM 6:1" /><verse number="2" style="v" sid="ROM 6:2" />জানৗ হাথারা! জৗঙৗ জাইফ্রা পাপনি থাখৈনৗ থৈবায়; মাব্রৈ জৗঙৗ বিহা ঠাংবাওনৗ? <verse eid="ROM 6:2" /><verse number="3" style="v" sid="ROM 6:3" />নংথারগৌয়ৈ নৗংছৗরৗ মিথিগৌ, জেব্লা জৗঙৗ বয়বৗ বাপ্তিস্মা লাদৗং আরৗ খ্রীষ্ট যীশুজৗং সাছে জাফাবায়, জৗঙৗ বিজৗং লৗগৗছে থৈফাবায়। <verse eid="ROM 6:3" /><verse number="4" style="v" sid="ROM 6:4" />জৗঙৗ বিহা বিনি বাপ্তিস্মানি গেজেরজৗং থৈনায়াও ফবজাখাবায়, বিফানি মহিমানি বৗলৗনি গেজেরজৗং খ্রীষ্টয়া ঠাংখাংফিনবায়, বেবাদিনৗ জৗঙৗ গৗদান জীবননাও থায়ৗ<note caller="+" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="COL 2:12">কলসীয় 2:12</ref> </char></note>।<verse eid="ROM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5" />মানৗনা যদি জৗঙৗ বিনি থৈনায়জৗং খৌছে জাবায়, বিনি ঠাংখাংফিননায়াও, থারৈনৗ জৗংবৗ খৌছে জাফাবায়। <verse eid="ROM 6:5" /><verse number="6" style="v" sid="ROM 6:6" />মানৗনা জৗঙৗ বিখৌ মিথিগৌ যে জৗংনি ফুরানা আত্মাখৌ বিজৗং লৗগৗছে ক্রুশাও ডৗখ্ঠাবজাবায় জাহাথে মৗদৗমনি লুবৈনায়ফ্রা সংহার জায়ৗ, জাহাথে জৗঙৗ পাপনি দাস জানানৈ মাব্লাবাবৗ থালে। <verse eid="ROM 6:6" /><verse number="7" style="v" sid="ROM 6:7" />মানৗনা জাইয়া থৈবায়, বিয়ৗ পাপনিফ্রায় মুক্তি জাবায়।<verse eid="ROM 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 6:8" />দা যদি জৗঙৗ খ্রীষ্টজৗং থৈবায়, জৗঙৗ ফৗথায়ৗ জৗঙৗ বিজৗংনৗ ঠাংবায়বৗ। <verse eid="ROM 6:8" /><verse number="9" style="v" sid="ROM 6:9" />মানৗনা জৗঙৗ মিথিগৌ, খ্রীষ্টআ থৈনায়ফৗরনিফ্রায় ঠাংখাংফিনবায়, বিয়ৗ মাব্লাবাবৗ থৈনায় নংলে, থৈনায়া মাব্লাবাবৗ বিখৌ রাজ খৗলামনৗ হানায় নংলে। <verse eid="ROM 6:9" /><verse number="10" style="v" sid="ROM 6:10" />বিয়ৗ খেবছেয়াওনৗ থৈবায় আরৗ বিনি বিরুদ্ধনাও পাপনি মৗংবৗ বৗলৗ গৈলেমৗন; নাথায় বিনিয়াও জীবন দং, বিয়ৗ ঈশ্বৗরনি থাখৈ ঠাংনানৈ দং।<verse eid="ROM 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 6:11" />জেরৈবাদি, গাওছৗরনি পাপনি থাখৈ গৗথৈ নাথায় যীশু খ্রীষ্টনিয়াও খৌছে ঈশ্বৗরনি প্রতি গৗঠাং সানজাদৗং। <verse eid="ROM 6:11" /><verse number="12" style="v" sid="ROM 6:12" />বিনিখাইনৗ নৗংছৗরনি থৈসুলা মৗদৗমখৌ পাপনি রাজ খৗলামনৗ দাহৗ, খৗলামৗব্লা নৗংছৗরৗ গাওছৗরনি গাজ্রি লুবৈনায়ফৗরখৌনৗ মানিয়ৗ। <verse eid="ROM 6:12" /><verse number="13" style="v" sid="ROM 6:13" />নৗংনি দেহানি অঙ্গখৌ পাপনি জন্থ্র আরৗ গাজ্রি বাহায়নৗ নাংলে। নাথায় বেবাদিফৗরখৌ জাইফৗরখৌ থৈনায়নিফ্রায় গৗঠাঙাও লাবৗবায় আরৗ মৗনফ্রৗমবৗ অঙ্গখৌ ঈশ্বৗরনিয়াও গথাইনানৈ ধৗরৗমিয়ানি জন্থ্র বাদি বিনিয়াও গথাই, <verse eid="ROM 6:13" /><verse number="14" style="v" sid="ROM 6:14" />মানৗনা পাপমা নৗংছৗরনি ছায়াও আরৗ মাব্লাবাবৗ অধিকার থানায় অৗঙা, মানৗনা নৗংছৗরৗ আইননি সিংয়াও অৗঙা, নাথায় অনুগ্রহনি সিংয়াও।<verse eid="ROM 6:14" /></para>
  <para style="s">ধৗরৗমিয়ানি দাস</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15" />অব্লা মা? জৗঙৗ মা কি পাপ খৗলাম নাংগৌ, মানৗনা জৗঙৗ আইননি সিঙাও অৗঙা, নাথায় অনুগ্রহনি সিঙাও? মাব্লাবাবৗ জানৗ হায়া! <verse eid="ROM 6:15" /><verse number="16" style="v" sid="ROM 6:16" />নৗংছৗরৗ নংথারগৌয়ৈ মিথিয়ৗ যে, নৗংছৗরৗ ছৗরনিবা গলাম জানৗ গাওখৌ গথাইবায়ব্লা, জানৗ হাগৌ পাপনি গলাম জেয়া থৈনায়াও দৈদেনৗ এবা ঈশ্বৗরখৌ মানিগ্রা গলাম জেয়া ধৗরৗমিয়াও দৈদেননৗ। <verse eid="ROM 6:16" /><verse number="17" style="v" sid="ROM 6:17" />নাথায় ঈশ্বৗরনি ধন্যবাদ জাথৗং যে, যদিও নৗংছৗরৗ পাপনি গলাম মৗন, নৗংছৗরৗ গাছেন গৗসৗফৗরজৗং বি নংগৌফৗরখৌ মানিবায় জেয়াখৌ নৗংছৗরনৗ ফৗরৗংয়া মৗন। <verse eid="ROM 6:17" /><verse number="18" style="v" sid="ROM 6:18" />আরৗ নৗংছৗরৗ পাপনিফ্রায় স্বাধীন জানানৈ নৗংছৗরৗ ধৗরৗমিয়ানি দাস জাবায়।<verse eid="ROM 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 6:19" />নৗংছৗর বুজিনৗ গৗব্রাবখায় আঙৗ সানফ্রৗমবৗ জীবননিফ্রায় মৗনছে উদাহারনখৌ বাহায়ৗ। জেরৈবাদি নৗংছৗরৗ গাওছৗরনি দেহানি অঙ্গফৗরখৌ পাপজৗং বুংফবনায় লুবৈনাইফৗরাও আরৗ গাজ্রিনি দাস হিসাবমৈ গথায়ৗমৗন, বিবাদিনৗ মৗদৗমনি অঙ্গফৗরখৌ গৗথারৈ দৈদেনলাংনৗ ধৗরৗমিয়ানি দাস হিসাবমৈ গাওখৌ গথাইনৗ। <verse eid="ROM 6:19" /><verse number="20" style="v" sid="ROM 6:20" />জেব্লা নৗংছৗরৗ পাপনি গলাম মৗন, অব্লা নৗংছৗরৗ ধৗরৗমিয়ানি স্বাধীন মৗন। <verse eid="ROM 6:20" /><verse number="21" style="v" sid="ROM 6:21" />যে জিনিসফৗরখৌ লানানৈ দা নৗংছৗরৗ লাজ্জিনাংবায়, বেফৗরনিফ্রায় দা নৗছৗরৗ মা লাভ মৗনখৗ? বিফৗর জিনিসফৗরনি মাওনায় বিথাইয়া গৗথৈ। <verse eid="ROM 6:21" /><verse number="22" style="v" sid="ROM 6:22" />নাথায় দা নৗংছৗরৗ পাপনিফ্রায় ছুখজানানৈ ঈশ্বৗরনি দাসফৗর জানানৈ নৗংছৗরৗ গৗথার আরৗ বিনি মাওনায় বিথাইয়াও জৗবনৗ গৗয়ি গৗঠাং। <verse eid="ROM 6:22" /><verse number="23" style="v" sid="ROM 6:23" />মানৗনা পাপনি বেথননা গৗথৈ; নাথায় ঈশ্বৗরনি দাননা জৗংনি ফৗরবু যীশু খ্রীষ্টনিয়াও জৗবনৗ গৗয়ি গৗঠাঙা।<verse eid="ROM 6:23" /></para>
  <chapter eid="ROM 6" />
  <chapter number="7" style="c" sid="ROM 7" />
  <para style="s">যীশুআ বাছায়গ্রা</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1" />নৗংছৗরৗ মিথিয়া নামা, বিদা ফংবায়ফৗর আরৗ বিবো বিনানাওফৗর মানৗনা আঙৗ বুংদৗং জাইফ্রা আইনখৌ মিথিগৌ, মানসিয়া জেছেবাও ঠাংনানৈ দং অছেবাওসিম আইননা বিনি ছায়াও একথিয়ার জায়ৗ? <verse eid="ROM 7:1" /><verse number="2" style="v" sid="ROM 7:2" />উদাহরণনি থাখৈ, আইন বাদি সাছে হাবা জানায় হিন্জাওয়া বিনি হৌয়া গৗঠাঙৈ থাসান্দি বিয়ৗ বিজৗং খাজানান থায়ৗ, নাথায় বিনি হৌয়াআ থৈব্লা বি খাজানায় আইননিফ্রায় মুক্তি জায়ৗ। <verse eid="ROM 7:2" /><verse number="3" style="v" sid="ROM 7:3" />অব্লা যদি বিনি হৌয়াআ গৗঠাঙৈ থানায়াও গুবুন হৌয়াজৗং থাবায়ৗব্লা বিয়ৗ জিনাহারিয়াও থাংবায়। নাথায় হৌয়াআ থৈব্লা বিয়ৗ বি হিন্জাওয়া আইননি ফ্রায় গহৗজায়ৗ, আরৗ গুবুন হাবা খৗলামব্লা জিনাহারি জানায় অৗঙা।<verse eid="ROM 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 7:4" />বেনিখাইনৗ, আংনি ফংবায়ফৗর আরৗ বিনানাওফৗর নৗংছৗরৗ আইন বাদি খ্রীষ্টনি মৗদৗমনি থৈনায়নি গেজেরজৗং, জাহাথে নৗংছৗরৗ গুবুননি জায়ৗ, জাইয়া থৈনায়নিফ্রায় ঠাংখাংফিনবায়, বিনিনৗ জাদৗ; জাহাথে জৗঙৗ ঈশ্বৗরনি থাখৈ বিথাই থাইনৗ হায়ৗ। <verse eid="ROM 7:4" /><verse number="5" style="v" sid="ROM 7:5" />মানৗনা জেব্লা জৗঙৗ মৗদৗমনি লুবৈনায় অনুুুুজায়ৈ দংমৗন, অব্লা আইননা জৗংনি পাপ লুবৈনায়খৌ থৈহৗনৗ থাখৈ জৗংনি মৗদৗমাও খামানি মাওদৗং মৗন। <verse eid="ROM 7:5" /><verse number="6" style="v" sid="ROM 7:6" />নাথায় দা, জেয়া জৗংখৌ বন্দী খৗলামনান দৗন্দৗংমৗন বিনি জুনৈ থৈবায়, জৗঙৗ আইননিফ্রায় স্বাধীন জাবায়, মানৗনা জৗঙৗ সেবা খৗলামনাগৌ গৗথার জিউনি গৗদান উপায়াও, আরৗ লিৎনায় আইননি গৗজাম উপায়াও অৗঙা।<verse eid="ROM 7:6" /></para>
  <para style="s">আইন আরৗ পাপ</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7" />অব্লা, জৗঙৗ মা বুংনৗ? আইননা মা কি পাপ? বে অৗঙা! আইন গৈয়া মৗনব্লা পাপমা মা বেখৌ আং মিথিনায় অৗঙা মৗন। আং মিথিনায় অৗঙা মৗন লোভমা মা, আইননা বুঙা মৗনব্লা, “লোভ দাখৗলাম।”<note caller="+" style="x"><char style="xo" closed="false">7:7 </char><char style="xt" closed="false"><ref loc="EXO 20:17">অৗংখাৎলাংনায় 20:17</ref>; <ref loc="DEU 5:21">হূদা বিজাব 5:21</ref> </char></note> <verse eid="ROM 7:7" /><verse number="8" style="v" sid="ROM 7:8" />নাথায় পাপমা সুযোগ মৗন্নানৈ বি আদেশজৗং আংনি গৗসৗয়াও গাছেন রৗখৗমনি লুবৈয়ৗ; মানৗনা আইনখৌ গৗজানাও দৗননানৈ পাপমা গৗথৈ। <verse eid="ROM 7:8" /><verse number="9" style="v" sid="ROM 7:9" />আইনখৌ গৗজানাও দৗননানৈ আং ঠাংদৗংমৗন, নাথায় জেব্লা আদেশফ্রা ফৈদৗং পাপমা জিউয়াও ঠাংখাংবায়, আরৗ আঙৗ থৈবায়। <verse eid="ROM 7:9" /><verse number="10" style="v" sid="ROM 7:10" />আঙৗ মৗনবায় যে বে গাছেন আদেশফৗরজৗং গৗঠাংখৌ লাবৗনান মাওনৗ সানদৗং মৗন, বদলৈ থৈনায়খৌছৗ লাবৗবায়। <verse eid="ROM 7:10" /><verse number="11" style="v" sid="ROM 7:11" />মানৗনা পাপমা সুযোগ মৗন্নানৈ আদেশজৗং আংখৌ ছৗলৈবায়, আরৗ আদেশনি গেজেরজৗং আংখৌ থৈনায়াও দৗনবায়<note caller="+" style="x"><char style="xo" closed="false">7:11 </char><char style="xt" closed="false"><ref loc="GEN 3:13">জাগাইজেন্নায় 3:13</ref> </char></note>। <verse eid="ROM 7:11" /><verse number="12" style="v" sid="ROM 7:12" />অব্লাহায়, বে আইননা গৗথার আরৗ আদেশা গৗথার, ধৗরৗমিয়া আরৗ মৗজাং। <verse eid="ROM 7:12" /><verse number="13" style="v" sid="ROM 7:13" />অব্লা মাখৌ মৗজাং মাওখৌ, আঙৗ থৈনায় বাদি জাবায়? মাব্লাবাবৗ অৗঙা। জেহেথু পাপমাসৗ বেখৌ মাওদৗং, মৗজাংখৌ বাহায়নানৈ পাপমা আংখৌ থৈনায়াও লাবৗদৗং, বিনিখাইনৗ আদেশনি গেজেরজৗং নংথারগৌয়ৈ বেছেগ্রাফ গাজ্রি পাপখৌ নুজাহৗদৗং।<verse eid="ROM 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14" />জৗঙৗ মিথিগৌ যে বে আইননা জাবায় আত্মিক; নাথায় আঙৗ মানসিলো, পাপনি দাস বাদি ফানজাদৗং। <verse eid="ROM 7:14" /><verse number="15" style="v" sid="ROM 7:15" />আঙৗ বুজিয়াখৈ মাখৌ আং মাওনৗ। মৗনৗনা মাখৌ আং মাওনৗ লুবৈয়ৗ বিখৌ মাওয়া, নাথায় মাখৌ আং মুগৈয়ৗ বিখৌনৗ মাওয়ৗ। <verse eid="ROM 7:15" /><verse number="16" style="v" sid="ROM 7:16" />আরৗ জেখৌ আঙৗ লুবৈয়া, বিখৌনৗ মাওয়ৗ, আঙৗ রাজি জায়ৗ যে বে আইননানৗ মৗজাং। <verse eid="ROM 7:16" /><verse number="17" style="v" sid="ROM 7:17" />জেরৈবাদি খামানিখৌ জাইয়া মাওদৗং বিয়ৗ আং অৗঙা, নাথায় বে পাপমা আংনিয়াও গৗঠাঙৈ থানানৈ। <verse eid="ROM 7:17" /><verse number="18" style="v" sid="ROM 7:18" />মানৗনা আং মিথিগৌ যে আংনিয়াও জেবৗ মৗজাং থায়া, বি জাবায় আংনি পাপনি স্বভাব। মানৗনা আংহা মাওনৗ ইচ্ছা জায়ৗ জেয়া মৗজাং, নাথায় আং বেখৌ মাওনৗ হায়া। <verse eid="ROM 7:18" /><verse number="19" style="v" sid="ROM 7:19" />মানৗনা আং যে মৗজাং মাওনৗ লুবৈয়ৗ আঙৗ বিখৌ মাওয়া, নাথায় গাজ্রি জেখৌ মাওনৗ লুবৈয়া, বিখৌনৗ আঙৗ মাওবায়থায়ৗ। <verse eid="ROM 7:19" /><verse number="20" style="v" sid="ROM 7:20" />দা আঙৗ জেখৌ মাওনৗ লুবৈয়া যদি বিখৌ মাওয়ৗ, অব্লা আঙৗ বিখৌ মাওয়া, নাথায় আংনিয়াও গৗঠাঙৈ থানায়ফ্রা বি পাপমাখৌনৗ মাওয়ৗ।<verse eid="ROM 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 7:21" />বেনিখাইনৗ আঙৗ বুজিমৗনবায় বে আইনজৗং খামানিয়াও, আঙৗ মৗজাং খামানি মাওনৗ সানব্লাবৗ, গাজ্রিয়া দা বিহা আংজৗং দং। <verse eid="ROM 7:21" /><verse number="22" style="v" sid="ROM 7:22" />বিনিখাইনৗ আংনি সিংনি সান্নায় মানসি বাদি আং ঈশ্বৗরনি আইননাও রংজায়ৗ। <verse eid="ROM 7:22" /><verse number="23" style="v" sid="ROM 7:23" />নাথায় আং নুয়ৗ গুবুন আইননা আংনি মৗদৗময়াও; বিয়ৗ আংনি গৗসৗয়াও আইননি বিরুদ্ধ দাওহা নাঙৗ আরৗ আংনি মৗদৗময়াও জেয়া খামানি মাওয়ৗ বি গুবুন আইননা পাপনি আইন, আরৗ বেয়ৗ আংখৌ জৗবথেসালিয়াও জৗববায়। <verse eid="ROM 7:23" /><verse number="24" style="v" sid="ROM 7:24" />আঙৗ সাছে অভাগি মানসি! ছৗর আংখৌ বি থৈনায় মৗদৗমনিফ্রায় উদ্ধার খৗলামনায়। <verse eid="ROM 7:24" /><verse number="25" style="v" sid="ROM 7:25" />ঈশ্বৗরখৌ ধন্যবাদ হৗয়ৗ, জাইয়া যীশু খ্রীষ্ট জৗংনি ফৗরবুনি গেজেরজৗং উদ্ধার খৗলামবায়,</para>
  <para style="p" vid="ROM 7:25">অব্লা, আঙৗ আংনি গৗসৗয়াও থারৈনৗ ঈশ্বৗরনি আইনখৌ মানিনৗ লুবৈয়ৗ, নাথায় আংনি পাপনি আখলনি থাখৈ আঙৗ পাপনি দাস।<verse eid="ROM 7:25" /></para>
  <chapter eid="ROM 7" />
  <chapter number="8" style="c" sid="ROM 8" />
  <para style="s">গৗথার জিউজৗং দৈদেনজানায়</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1" />বিনিখাইনৗ, জাইফ্রা যীশু খ্রীষ্টনিয়াও দং, বিছৗরনি থাখৈ দা জেবৗ নিন্দিনায় গৈয়া। <verse eid="ROM 8:1" /><verse number="2" style="v" sid="ROM 8:2" />যীশু খ্রীষ্টনি গেজেরজৗং গৗঠাং জিউনি আইননা আংখৌ পাপ আরৗ থৈনায়নি আইননিফ্রায় মুক্তি হৗবায়। <verse eid="ROM 8:2" /><verse number="3" style="v" sid="ROM 8:3" />যে আইননা মাওনৗ হায়াখৈ মৗন মানৗনা মৗদৗমনি লুবৈনায়নি থাখৈ বৗলৗ গৗয়ি খৗলামামৗন, ঈশ্বৗরা গাওনি বিসাজ্লাখৌ জৗং পাপী মানসিফৗর বাদি মৗনছে মৗদৗম হৗনানৈ থৗনহৎবায়, আরৗ বিয়ৗ খ্রীষ্টনি মৗদৗমখৌ বলি হৗনায়নি গেজেরজৗং পাপখৌ দায় খৗলামবায়। <verse eid="ROM 8:3" /><verse number="4" style="v" sid="ROM 8:4" />বেবাদি যে ধৗরৗমিয়া নংগৌখৌ মাওনায়খায় আইননি নিয়মফ্রা জৗংনিয়াও জাফুংথারনায়, জৗঙৗ জাইফ্রা মৗদৗমনি আখল আখুয়া থায়া, নাথায় গৗথার জিউয়াও থায়ৗ,<verse eid="ROM 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 8:5" />জাইফ্রা পাপনি স্বভাবজৗং মৗদৗমনি লুবৈনায় বাদি থাবায়ৗ, বিছৗরৗ মৗদৗমনি লুবৈনায় সান্নৗ; নাথায় জাইফ্রা জিউনি থৗন্নায় বাদি থাবায়ৗ, বিছৗরৗ গৗথার জিউনি লুবৈনায় সান্নৗ। <verse eid="ROM 8:5" /><verse number="6" style="v" sid="ROM 8:6" />মৗদৗমনি লুবৈনায় বিথাইয়া গৗথৈ, জিউনি লুবৈনায় বিথাইয়া গৗঠাং আরৗ শান্তি। <verse eid="ROM 8:6" /><verse number="7" style="v" sid="ROM 8:7" />যে মানসিয়া পাপী স্বভাব লুবৈয়ৗ বিনি লুবৈনাইয়া ঈশ্বৗরনি থাখৈ বিসারু, বিহা ঈশ্বৗরনি আইননি সিঙাং জায়া, মাব্লাবাবৗ জানৗ হায়া। <verse eid="ROM 8:7" /><verse number="8" style="v" sid="ROM 8:8" />জাইফ্রা মৗদৗমনি লুবৈনায়াও থায়ৗ, জাইফ্রা পাপী স্বভাবজৗংনৗ হমথাজায়ৗ, বিছৗরৗ ঈশ্বৗরখৌ খুশি খৗলামনৗ হায়া।<verse eid="ROM 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 8:9" />নৗংছৗরৗ, জাইফ্রা মৗদৗমনি স্বভাব সিঙাও অৗঙা, জিউনি সিঙাও দং, যদি নংথারগৌয়ৈ ঈশ্বৗরনি জিউয়া নৗংছৗরনিয়াও গৗঠাং। আরৗ জাইফৗরহা খ্রীষ্টনি জিউয়া গৈয়া, বিছৗরৗ খ্রীষ্টনি অৗঙা। <verse eid="ROM 8:9" /><verse number="10" style="v" sid="ROM 8:10" />নাথায় যদি খ্রীষ্টআ নৗংছৗরনিয়াও গৗঠাং, অব্লা পাপনি থাখৈ মৗদৗমা গৗথৈ, নাথায় জিউয়া গৗঠাং ধৗরৗমিয়াফৗরনি থাখৈ। <verse eid="ROM 8:10" /><verse number="11" style="v" sid="ROM 8:11" />আরৗ জাইয়া থৈনায়নিফ্রায় যীশুখৌ বৗখাংবায়, বিনি জিউয়া যদি নৗংছৗরনিয়াও গৗঠাং, অব্লা জাইয়া থৈনায়নিফ্রায় খ্রীষ্ট যীশুখৌ বৗখাংবায়, বিয়ৗ নৗংছৗরনি গৗসৗয়াও থাগ্রা গাওনি জিউনি গেজেরজৗং নৗংছৗরখৌ গৗথৈ মৗদৗমখৌবৗ গৗঠাং খৗলামনায়<note caller="+" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="1CO 3:16">1 করিন্থীয় 3:16</ref></char></note>।<verse eid="ROM 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12" />বিনিখাইনৗ, বিদা-ফংবায়ফৗর আরৗ বিবো-বিনানাওফৗর, জৗংহা মৗনছে বিবান দং, নাথায় মৗদৗমনিয়াও অৗঙা যে মৗদৗমনি লুবৈনায় অনুজায়ৈ জীবন যাপন খৗলামনায়। <verse eid="ROM 8:12" /><verse number="13" style="v" sid="ROM 8:13" />মানৗনা নৗংছৗরৗ যদি পাপী স্বভাব অনুজায়ৈ জীবনযাপন খৗলামব্লা, অব্লা নৗংছৗরৗ থৈনায়, জিউনি দৈদেনজানায়াও মৗদৗমনি লুবৈনায়াও পাপী অভ্যাস বন্ধ খৗলামব্লা, নৗংছৗরৗ গৗঠাঙৈ থানায়।<verse eid="ROM 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 8:14" />মানৗনা জাইফ্রা ঈশ্বৗরনি গৗথার জিউয়াও দৈদেনজায়ৗ, বিছৗরৗ ঈশ্বৗরনি বিসা। <verse eid="ROM 8:14" /><verse number="15" style="v" sid="ROM 8:15" />নৗংছৗরৗ যে জিউখৌ মৗনবায় বিয়ৗ নৗংছৗরখৌ গলাম খৗলামা, জাহাথে নৗংছৗরৗ গিনায়াও আরবাও থায়ৗ, বরং নৗংছৗরৗ যে জিউখৌ মৗনবায় বিয়ৗ নৗংছৗরখৌ খাংনায় বিসায়াও লাবৗবায়। বে জিউনি গেজেরজৗং জৗং ঈশ্বৗরখৌ “আব্বা, আফা” হৗন্নানৈ লিংহৎনৗ<note caller="+" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="MRK 14:36">মার্ক 14:36</ref>; <ref loc="GAL 4:6">গালাতীয় 4:6</ref></char></note>। <verse eid="ROM 8:15" /><verse number="16" style="v" sid="ROM 8:16" />জিউয়া গাওনৗ জৗংনি জিউজৗং লৗগৗছে জৗংখৌ ঈশ্বৗরনি বিসাফৗর হৗন্নানৈ সাক্ষী হৗয়ৗ। <verse eid="ROM 8:16" /><verse number="17" style="v" sid="ROM 8:17" />দা যদি জৗঙৗ বিসাফৗর, অব্লা উত্তরাধিকার, ঈশ্বৗরনি উত্তরাধিকারজৗং খ্রীষ্টনি সহউত্তরাধিকার, যদি নংথারগৌয়ৈ জৗঙৗ বিজৗং দুঃখু খৗলামৗ, জেন বিজৗং মহিমা ভাগৗ জায়ৗ।<verse eid="ROM 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18" />আঙৗ সান্নান নায়ৗ, জৗংনি থাখৈ যে মহিমায়া নুজানায়, বিজৗং লৗগৗছে জৗংনি বর্তমান সমনি দুঃখুখৌ রুজুনাইনি যোগ্য অৗঙা। <verse eid="ROM 8:18" /><verse number="19" style="v" sid="ROM 8:19" />মানৗনা সৃষ্টিখৌ নেনানৈ ঈশ্বৗরা বিসাফৗরখৌ দিন্ঠিনৗ থাখৈ আগ্রহজৗং দং। <verse eid="ROM 8:19" /><verse number="20" style="v" sid="ROM 8:20" />মানৗনা সৗরজিজানায় মানিয়ানৗ অনদায়থারা, গাওনি হামজানায়জৗং জায়াখৈ, নাথায় ঈশ্বৗরনি ইচ্ছা বাদিসৗ জাদৗং জাইয়া বেবাদিয়ৈ খৗলামা মৗন, আশায়াও দং। <verse eid="ROM 8:20" /><verse number="21" style="v" sid="ROM 8:21" />যে সৗরজিজানায়া<note caller="+" style="x"><char style="xo" closed="false">8:21 </char><char style="xt" closed="false"><ref loc="GEN 3:17-19">জাগাইজেন্নায় 3:17–19</ref> </char></note> গাওনৗ গাওনি জামলাংনায় গলামনিফ্রায় গহৗজানায়, আরৗ সৗরজিজানায় ঈশ্বৗরনি বিসাফ্রা স্বাধীনতা আরৗ মহিমানি ভাগী জানায়।<verse eid="ROM 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 8:22" />জৗঙৗ মিথিগৌ যে গাছেন সৗরজিনায় সমসিম গৗল্লৈ জৗনৗম জানায় ছানায় বাদি গাবখ্রাওগাছেন। <verse eid="ROM 8:22" /><verse number="23" style="v" sid="ROM 8:23" />বিবান অৗঙা, জৗঙৗ জৗংনি, জাইফৗরনি জিউনি প্রথম বিথাই দং, জৗঙৗ জৗংনি মৗদৗমনি বাইখজানায়, খাংনায় বিসা হৌয়ানি অধিকারখৌ জৗরৈ গেদেৎ গৗসৗ আশাজৗং নেনানৈ নাজাওনৗ থাখৈ <note caller="+" style="x"><char style="xo" closed="false">8:23 </char><char style="xt" closed="false"><ref loc="2CO 5:2-4">2 করিন্থীয় 5:2–4</ref></char></note>হাংমা ছুয়ৗ। <verse eid="ROM 8:23" /><verse number="24" style="v" sid="ROM 8:24" />মানৗনা বে আশায়াওনৗ জৗঙৗ বাছাইজাবায়। নাথায় জৗং জেখৌ আশা খৗলামৗ বেখৌ যদি নুয়ৗ, অব্লা বেয়ৗ নংথারগৌয়ৈ আশা অৗঙা। জাইফ্রা আশা খৗলামদৗং বেয়ৗ দংখায়ৗ? <verse eid="ROM 8:24" /><verse number="25" style="v" sid="ROM 8:25" />জেখৌ জৗঙৗ নুয়া, যদি আশা খৗলামৗ, অব্লা সহায়নায়জৗং লৗগৗছে জৗঙৗ নেবায় থায়ৗ।<verse eid="ROM 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26" />আরৗ জৗংনি বৗলৗ গৈয়িয়াও জিউয়া জৗংখৌ হেফাজাব হৗয়ৗ। মানৗনা প্রার্থনা খৗলাম নাংগৌ বেখৌ জৗং মিথিয়া, বেখৌ গৗথার জিউয়া গেজেরনি জানানৈ জৗংনি লাগৈ হাংমা ছুনায়জৗং যে বে সৗদৗবফৗরখৌ ফৗরমায় জায়া। <verse eid="ROM 8:26" /><verse number="27" style="v" sid="ROM 8:27" />আরৗ জাইয়া জৗংনি গৗসৗখৌ নাগিৎনৗ, বিয়ৗ মিথিগৌ গৗথার জিউনি সাননায়খৌ, মানৗনা গৗথার জিউয়া ঈশ্বৗরনি ইচ্ছা বাদি ঈশ্বৗরনি মানসিফৗরনি গেজেরনি জানানৈ খৗলামৗ।<verse eid="ROM 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 8:28" />আরৗ জৗঙৗ মিথিগৌ যে গাছেন জিনিসখৌ ঈশ্বৗরা বিছৗরনি মৗজাং খামানি মাওয়ৗ জাইফ্রা বিখৌ অন্নৗ, জাইফ্রা বে উদ্দেশ্য অনুসারে লিংহৎজাদৗং। <verse eid="ROM 8:28" /><verse number="29" style="v" sid="ROM 8:29" />মানৗনা ঈশ্বৗরা জাইফৗরখৌ সিগাংয়াওনৗ মিথিগৌ, বিবৗনৗ বিনি বিসাজ্লানি প্রতিমূর্তি জানাইনি থাখৈ সিগাংনৗ সাইখোদৗং মৗন; জেন বিয়ৗ গৗবাংয়িন বিদাফংবায় আরৗ বিনানাওফৗরনি গেজেরাও প্রথম জৗনৗম জায়ৗ। <verse eid="ROM 8:29" /><verse number="30" style="v" sid="ROM 8:30" />জাইফৗরখৌ ঈশ্বৗরা সিগাংয়াওনৗ সাইখদৗং মৗন, বিখৌবৗ লিংহৎবায়, জাইফৗরখৌ লিংহৎবায়, বিয়ৗ ধৗরৗমিয়া সাননানৈ লাবায়, জাইফৗরখৌ ধৗরৗমিয়া সাননানৈ লাবায়, বিবৗনৗ মহিমানি ভাগৗ জাফাবায়।<verse eid="ROM 8:30" /></para>
  <para style="s">ডেহাগ্রাফৗরনি ফ্রায়বৗ বাংসিন</para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31" />অব্লা বেফৗরনি উত্তরাও জৗঙৗ মা বুংনৗ? ঈশ্বৗরা যদি জৗংনি জানানৈ থায়ৗব্লা, অব্লা ছৗর জৗংনি বিরুদ্ধনাও গছংনৗ হাগৌ? <verse eid="ROM 8:31" /><verse number="32" style="v" sid="ROM 8:32" />জাইয়া গাওনি বিসাজ্লাখৌবৗ নাগারাখৈ মৗন, নাথায় জৗংনি গাছেননি থাখৈ বিখৌ নাগারজৗববায়, বিয়ৗ মা কি বিজৗং গাছেনখৌবৗ জৗংনি থাখৈ গৗসৗ বায়দিয়ৈ দান হৗনায় অৗঙা? <verse eid="ROM 8:32" /><verse number="33" style="v" sid="ROM 8:33" />ঈশ্বৗরজৗং সাইখজানায় মানসিফৗরখৌ ছৗর দায় হৗনৗ হাগৌ? বেয়ৗ ঈশ্বৗরানৗ জাইয়া ধৗরৗমিয়া সাননানৈ লাবায়। <verse eid="ROM 8:33" /><verse number="34" style="v" sid="ROM 8:34" />অব্লা ছৗর জৗংখৌ দায় গৗনাং খৗলামনৗ হাগৌ? রাওবৗ অৗঙা। যীশু খ্রীষ্ট জাইয়া থৈবায় আরৗ ঠাংখাংফিনবায় আরৗ বিয়ৗ ঈশ্বৗরনি আগ্ডা ঠিঙৈ আরৗ জৗংনি গেজেরনি জানানৈ। <verse eid="ROM 8:34" /><verse number="35" style="v" sid="ROM 8:35" />ছৗর জৗংখৌ খ্রীষ্টনি অন্নায়নিফ্রায় আলাদা খৗলামনায়? জৗবৗদ দুঃখু কিন্বা হৗছৗজানায় কিন্বা আংখাল কিন্বা লাংঠিয়া কিন্বা গিথাওথাও কিন্বা থুংগ্রী? <verse eid="ROM 8:35" /><verse number="36" style="v" sid="ROM 8:36" />জেরৈবাদি লিৎনায় দং,</para>
  <para style="p" vid="ROM 8:36">“নৗংছৗরনি থাখৈ জৗঙৗ সারা দিন থৈনায়ছৈয়াও থায়ৗ; জৗঙৗ দানথাৎজানৗ লাংনায় মেন্ডাবিসা বাদি সাননানৈ লাবায়<note caller="+" style="x"><char style="xo" closed="false">8:36 </char><char style="xt" closed="false"><ref loc="PSA 44:22">গীতফৗর 44:22</ref></char></note>।” <verse eid="ROM 8:36" /><verse number="37" style="v" sid="ROM 8:37" />অৗঙা, বেফৗর গাছেনবৗ জাইয়া জৗংখৌ অন্নৗ বিজৗংনৗ জৗঙৗ আরবাও বাংসিন ডেহায়ৗ। <verse eid="ROM 8:37" /><verse number="38" style="v" sid="ROM 8:38" />মানৗনা আঙৗ নংথারগৌয়ৈ মিথিগৌ, না থৈনায়, না গৗঠাঙৈ, না আরফ'ফৗর, না স্বৗর্গৗয়ারি শাসনগিরিফৗর না বে সমনি, না ভবিষ্যৎনি, না স্বৗর্গৗয়ারি বৗলৗফৗর, <verse eid="ROM 8:38" /><verse number="39" style="v" sid="ROM 8:39" />না গৗজৌ, না গৗথৌ, না গাছেন মৗঙাফৗরা দাজাদৗং, ঈশ্বৗরনিফ্রায় জৗংনি যীশু খ্রীষ্ট ফৗরবুনি অন্নায়নিফ্রায় জৗংখৌ জেবৗ আলাদা খৗলামনৗ হানায় অৗঙা।<verse eid="ROM 8:39" /></para>
  <chapter eid="ROM 8" />
  <chapter number="9" style="c" sid="ROM 9" />
  <para style="s">ইস্রায়েলনি মানসিফৗরনি ছায়াও পৌলনি দুঃখু।</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1" />আঙৗ খ্রীষ্টখৌ নংথারগৌ বুঙৗ, আঙৗ নংখাই বুঙা, আংনি বিবেগয়া বুঙৗ গৗথার জিউয়া সাক্ষ্য হৗয়ৗ, <verse eid="ROM 9:1" /><verse number="2" style="v" sid="ROM 9:2" />আংনি গৗসৗয়াও গেদেৎ দুঃখু আরৗ জৗবনায় গৈয়া সহায়নৗ হায়ি জাদৗং। <verse eid="ROM 9:2" /><verse number="3" style="v" sid="ROM 9:3" />মানৗনা আং ইচ্ছা খৗলামনৗ হাগৌমৗন যদি সম্ভব জায়ৗ যে আঙৗ গাওনৗ আংনি মানসিফৗরখৌ হেফাজাব হৗনৗ থাখৈ খ্রীষ্টনিফ্রায় অভিশাব জাদৗং, আংনি জাতিয়া খ্রীষ্টখৌ মিথিগৌ। <verse eid="ROM 9:3" /><verse number="4" style="v" sid="ROM 9:4" />বে ইস্রায়েলনি মানসিফৗর। বিছৗরনি বিসাফৗরবাদি খাংনানৈ লানায় বিসা হৌয়া বাদি, বিছৗরনি স্বৗর্গৗয়ারি মহিমা, বে চুক্তিফৗর, আইনখৌ নাজাওনায়, মন্দিরাও খুলুমনায় আরৗ সিমান লানায়। <verse eid="ROM 9:4" /><verse number="5" style="v" sid="ROM 9:5" />বিছৗরনি ফোলেরনি গুদি মানসিফৗরনি আরৗ বিছৗরনিফ্রায় মসিহানি গৗডৗনি মানসি, জাই ঈশ্বৗররা গাছেনখৌবৗ শাসন খৗলামৗ, জেব্লাইবৗ বাখ্নাইজাবায়, আমেন।<verse eid="ROM 9:5" /></para>
  <para style="s">ঈশ্বৗরনি মহারাজা সাইখনায়</para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6" />ঈশ্বৗরনি রাওয়া বৃথা জাবায় বে অৗঙা, মানৗনা ইস্রায়েলনি গাছেনবৗ জৗলৈনিফ্রাইনৗ নংথারগৌয়ৈ ইস্রায়েল অৗঙা। <verse eid="ROM 9:6" /><verse number="7" style="v" sid="ROM 9:7" />বে অৗঙা মানৗনা বিছৗরৗ অব্রাহামনি বংশ হৗন্নানৈ বিছৗরৗ যে সাফ্রৗম বিসাজ্লা, বিবৗ অৗঙা, নাথায় “ইসাহাকনি গেজেরজৗং নৗংনি বংশ হৗন্নানৈ ছিনায়ঠিদৗং<note caller="+" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="GEN 21:12">জাগাইজেন্নায় 21:12</ref> </char></note>।” <verse eid="ROM 9:7" /><verse number="8" style="v" sid="ROM 9:8" />গুবুন শব্দয়াও, জাইফ্রা মৗদৗমনি বিসাজ্লা, বিছৗরৗ যে ঈশ্বৗরনি বিসাজ্লা, বেবাদি অৗঙা, নাথায় সিমাননি বিসাফ্রা অব্রাহামনি বংশ সানজাদৗং। <verse eid="ROM 9:8" /><verse number="9" style="v" sid="ROM 9:9" />মানৗনা সিমান লানায়াও বেবাদিনৗ বুঙামৗন, “সম ঠিক খৗলামনাইয়াও আঙৗ ফিনফিন্নায় আরৗ সারানি সাছে বিসাজ্লা জানায়<note caller="+" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="GEN 18:10">জাগাইজেন্নায় 18:10</ref></char></note>”।<verse eid="ROM 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 9:10" />বিবান অৗঙা, জৗংনি বিফা ইসাহাক একই সমাও রিবিকানি বিসাফৗরখৌ গৗর্বৗয়াও থাহৗদৗং। <verse eid="ROM 9:10" /><verse number="11" style="v" sid="ROM 9:11" />দাসিমবৗ, বিসাফ্রা জৗনৗম জাফৈয়াখৌ আরৗ মৗজাং গাজ্রি মৗংবৗ খৗলামাখৈ, অব্লা ঈশ্বৗরনি সাইখনায় বাদি জেন স্থিরৈ থায়ৗ, খামানিজৗং অৗঙা নাথায় লিংহৎজানায়জৗংসৗ, <verse eid="ROM 9:11" /><verse number="12" style="v" sid="ROM 9:12" />খামানিনি গেজেরজৗং অৗঙা নাথায় জাইয়া লিংহৎদৗং বিনি গেজেরজৗং, রিবিকাখৌ বুঙা জাদৗংমৗন, “গেদেৎনা গৗল্লৈসিনখৌ সেবা খৗলামনায়<note caller="+" style="x"><char style="xo" closed="false">9:12 </char><char style="xt" closed="false"><ref loc="GEN 25:23">জাগাইজেন্নায় 25:23</ref></char></note>।” <verse eid="ROM 9:12" /><verse number="13" style="v" sid="ROM 9:13" />জেরৈবাদি লিৎনায় দং, “আঙৗ যাকোবখৌ অনদৗং, নাথায় এষৌখৌ আঙৗ মুগৈদৗং।”<verse eid="ROM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14" />অব্লা জৗঙৗ মা বুংনৗ? ঈশ্বৗরা কি অধৗরৗমিয়া মাওয়ৗ না? বে নংথারা। <verse eid="ROM 9:14" /><verse number="15" style="v" sid="ROM 9:15" />মানৗনা বিয়ৗ মোশিখৌ বুংবায়, “আঙৗ জাইখৌ দয়া খৗলামৗ, বিখৌ দয়া খৗলামৗ; জাইনি প্রতি অন্নায়<note caller="+" style="x"><char style="xo" closed="false">9:15 </char><char style="xt" closed="false"><ref loc="EXO 33:19">অৗংখাৎলাংনায় 33:19</ref> </char></note> খৗলামৗ, বিখৌ অন্নায়।”<verse eid="ROM 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 9:16" />বিখাইনৗ, বে মানসিনি ইচ্ছা বা চেষ্টা খৗলামনায়নি ছায়াও ভরসা খৗলামা, বরংছৗ ঈশ্বৗরনি দয়ানি ছায়াওছৗ ভরসা খৗলামৗ। <verse eid="ROM 9:16" /><verse number="17" style="v" sid="ROM 9:17" />মানৗনা শাস্ত্রয়াও ঈশ্বৗররা ফরৌণখৌ বুঙৗ, “আঙৗ বেনি থাখৈ নৗংখৌ বৗখাংদৗং, জেন নৗংজৗং আংনি বৗলৗখৌ দিন্ঠিনৗ, আরৗ জেন সারা সংসারাও আংনি মুঙা প্রচার<note caller="+" style="x"><char style="xo" closed="false">9:17</char><char style="xt" closed="false"><ref loc="EXO 9:16">অৗংখাৎলাংনায় 9:16</ref> </char></note> জায়ৗ।” <verse eid="ROM 9:17" /><verse number="18" style="v" sid="ROM 9:18" />বিখাইনৗ ঈশ্বৗরা জাইখৌ দয়া খৗলামনৗ লুবৈয়ৗ বিখৌ দয়া খৗলামৗ; আরৗ জাইখৌ গৗরা খৗলামনৗ লুবৈয়ৗ বিখৌ গৗসৗয়াও গৗরাথার খৗলামৗ।<verse eid="ROM 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19" />নৗংছৗরনি গেজেরাও ছৗরবা সাছেয়া আংখৌ বুংনায়, “অব্লা মানৗ ঈশ্বৗরা জৗংখৌ দোষ হমমৗ? মানৗনা বিনি ইচ্ছাখৌ ছৗর বাধা হৗনায়?” <verse eid="ROM 9:19" /><verse number="20" style="v" sid="ROM 9:20" />নাথায় নৗংছৗর, সাছে মানসি, ঈশ্বৗরজৗং খৗথা বুংনৗ? “সিগাঙাওনৗ বৗনায়ামৗন বিখৌ মা বুংনৗ যে বেয়ৗ সিগাংনৗ খৗলামখাবায় মানৗ নৗঙৗ আংখৌ বেবাদি খৗলামখৗ?<note caller="+" style="x"><char style="xo" closed="false">9:20 </char><char style="xt" closed="false"><ref loc="ISA 29:16">যিশাইয় 29:16</ref> </char></note>” <verse eid="ROM 9:20" /><verse number="21" style="v" sid="ROM 9:21" />দৈহু দাগ্রায়া গাও দানায় মৗঙাখৌ গাওনি গৗসৗ বাদি বাহায়নৗ মা কি হায়া? মৗনছে একেই হ্বানিফ্রায় দানায়াখৌনৗ, গংছেখৌ মৗজাং খামানিফৗরাও আরৗ গংছেখৌ সাধারন বাহায়নৗ।<verse eid="ROM 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 9:22" />ঈশ্বৗরনি মাওনায়া বেবাদিনৗ, বিয়ৗ গাওনি রাগ আরৗ গাওনি বৗলৗখৌ দিন্ঠিনৗ সাইখবায়, নাথায় জাইফ্রা বিজৗং রাগ জৗংজাথাও থাও আরৗ জাইখৌ সংহার খৗলামনৗ ঠাম ঠিম জাখাবায়, বিছৗরনি থাখৈ বিয়ৗ গৗবাং সৈছৗনানৈ থাদৗং। <verse eid="ROM 9:22" /><verse number="23" style="v" sid="ROM 9:23" />মা জানায় যদি বিয়ৗ বিনি মহিমানি ধৗন সম্পত্তিখৌ বিনি দয়াখৌ মিথিনৗ বেখৌ খৗলামদৗং, জাইখৌ বিয়ৗ মহিমানি থাখৈ সিগাংনিফ্রায়নৗ ঠাম ঠিম খৗলামদৗং মৗন, <verse eid="ROM 9:23" /><verse number="24" style="v" sid="ROM 9:24" />জৗঙৗ বিজৗং লিংহৎজানায়, যিহূদীফৗরনি ফ্রায় বান অৗঙা মৗন, গুবুন জাতিফৗরনিফ্রায়বৗ লিংদৎজাদৗং? <verse eid="ROM 9:24" /><verse number="25" style="v" sid="ROM 9:25" />জেরেইবাদি বিয়ৗ হোশেয় বিজাবমাও বুংদৗং,</para>
  <para style="p" vid="ROM 9:25">“জাইফ্রা আংনি মানসিফৗর অৗঙা, বিছৗরখৌ আঙৗ গাওনি মানসিফৗর বুঙৗ, আরৗ জাইয়া আংনি অনজালু অৗঙা আং বিখৌ আংনি অনজালু লিংনায়<note caller="+" style="x"><char style="xo" closed="false">9:25 </char><char style="xt" closed="false"><ref loc="HOS 2:23">হোশেয়া 2:23</ref></char></note>।” <verse eid="ROM 9:25" /><verse number="26" style="v" sid="ROM 9:26" />আরৗ,</para>
  <para style="p" vid="ROM 9:26">“যে জায়গায়াও বিছৗরখৌ বুঙৗ, ‘নৗংছৗরৗ আংনি মানসিফৗর অৗঙা,’ বি জায়গায়াও বিছৗরখৌ লিংহৎনা জানায় ‘গৗঠাং ঈশ্বৗরনি বিসাফৗর’<note caller="+" style="x"><char style="xo" closed="false">9:26 </char><char style="xt" closed="false"><ref loc="HOS 1:10">হোশেয়া 1:10</ref> </char></note>।” <verse eid="ROM 9:26" /><verse number="27" style="v" sid="ROM 9:27" />যিশাইয়া ইস্রায়েলফৗরনি বিষয়ৈ খৗথা ফৗসাওদৗং,</para>
  <para style="p" vid="ROM 9:27">“এমন কি ইস্রায়েলনি মানসিফ্রা সাগৗর জিংনি বালাফৗর বাদি জায়ৗব্লা, থালাংনায়ফৗর বান বাছায় জানায়। <verse eid="ROM 9:27" /><verse number="28" style="v" sid="ROM 9:28" />মানৗনা ফৗরবুআ বে সংসারনি ছায়াও গাওনি বাক্যজৗং গৗখ্রৈনৗ ফুরায়ৈ বিচার খৗলামনায়।” <verse eid="ROM 9:28" /><verse number="29" style="v" sid="ROM 9:29" />জেরৈবাদি যিশাইয়া সিগাঙাও বুংদৗং,</para>
  <para style="p" vid="ROM 9:29">“বৗলৗগৗরাসিনথার ফৗরবুআ জৗংনি জৗলৈফৗরনিফ্রায় বাছাইনানৈ লাখিয়া মৗনব্লা জৗঙৗ সদোম আরৗ ঘমোরা বাদি জানায় মৗন।”<verse eid="ROM 9:29" /></para>
  <para style="s">ইস্রায়েলফৗরনি ফৗথাইয়ি</para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30" />অব্লা জৗঙৗ মা বুংনৗ? গুবুন জাতিফ্রা, জাইফ্রা ধৗরৗমিয়ানি থাখৈ নাগিৎনাখৈ মৗন, বিছৗরখৌ ধৗরৗমিয়া খৗলামবায় বি ফৗথাইনায়জৗং। <verse eid="ROM 9:30" /><verse number="31" style="v" sid="ROM 9:31" />নাথায় ইস্রায়েলনি মানসিফ্রা আইনখৌ নাগিৎদৗং ধৗরৗমিয়াবাদিয়ৈ, বিছৗরৗ লক্ষ্যসিম ছহৈয়াখৈ। <verse eid="ROM 9:31" /><verse number="32" style="v" sid="ROM 9:32" />মানৗ অৗঙা? মানৗনা ফৗথাইনায়জৗং অৗঙা, নাথায় খামানিনি গেজেরজৗং নাগিৎদৗং। বিছৗরৗ অন্ঠাই ছৌখ্ঠুনায়নি ছায়াওনৗ ছৌখ্ঠুয়ামৗন। <verse eid="ROM 9:32" /><verse number="33" style="v" sid="ROM 9:33" />জেরৈবাদি লিৎনায় দং,</para>
  <para style="p" vid="ROM 9:33">“নায় আঙৗ জাইনিয়াও অন্ঠাই থাইছে দৗনদৗং, বি অন্ঠাইয়া মানসিফৗরখৌ ছৌখ্ঠুহৗনায়নি কারণ, আরৗ বি অন্ঠাইয়া<note caller="+" style="f"><char style="fr" closed="false">9:33 </char><char style="ft" closed="false">ঈশ্বৗরা বি অন্ঠাই থাইছেখৌ দৗনদৗং। বে অন্ঠাইয়া জাবায় যীশু অারৗ যিহূদীফ্রা বিখৌ নাজাওয়িখায় বিয়ৗ বি অন্ঠাই যে ছৌখ্ঠুদৗংমৗন আরৗ বিছৗরৗ গৗগ্লাইদৗং মৗন। নাথায় জাইফ্রা বিখৌ ফৗথাইদৗং বিছৗরৗ লাজি নাংনায় অৗঙা। </char></note> বিছৗরখৌ খৗখ্লৈনায়নি কারণ; নাথায় জাইফ্রা বিখৌ ফৗথাইনায় বিছৗরৗ লাজি নাংনায় অৗঙা।”<verse eid="ROM 9:33" /></para>
  <chapter eid="ROM 9" />
  <chapter number="10" style="c" sid="ROM 10" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1" />বিদা-ফংবায়ফৗর আরৗ বিবো-বিনানাওফৗর, আংনি গৗসৗয়াও লুবৈনায় আরৗ বিছৗরনি থাখৈ ঈশ্বৗরনিয়াও প্রার্থনায়া বেনৗ, জাহাথে বিছৗরৗ বাছাইজায়ৗ। <verse eid="ROM 10:1" /><verse number="2" style="v" sid="ROM 10:2" />মানৗনা আং বিছৗরনি বিষয়ৈ সাক্ষ্য হৗয়ৗ যে, ঈশ্বৗরনি বিষয়ৈ বিছৗরনি গৗসৗ গুদুং, নাথায় জগা জগ খৗলামনায়া বিছারনি জ্ঞান অৗঙা। <verse eid="ROM 10:2" /><verse number="3" style="v" sid="ROM 10:3" />মানৗনা বিছৗরৗ ঈশ্বৗরনি ধৗরৗমিয়ায়া মা বিখৌ বুজিয়া আরৗ বিছৗরৗ গাওছৗরখৌ লুখাংনৗ নাগিৎনৗ বিছৗরৗ গাওনি ধৗরৗমিয়াখৌ, বিছৗরৗ ঈশ্বৗরনি ধৗরৗমিয়ানি থাখৈ গথাইয়াখৈ। <verse eid="ROM 10:3" /><verse number="4" style="v" sid="ROM 10:4" />খ্রীষ্টআ জাবায় আইননি জৗবথানায়, বিনিখাইনৗ সাফ্রৗমবৗ জাইয়া ফৗথাইনায়জৗং ধৗরৗমিয়া জায়ৗ।<verse eid="ROM 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5" />মোশিনি লিৎনায় বে আইননা বিনি গেজেরজৗং ধৗরৗমিয়া জায়ৗ, “জাই মানসিফ্রা বে জিনিসফৗরখৌ মাওবায় বিছৗরৗ ঠাংনায়<note caller="+" style="x"><char style="xo" closed="false">10:5 </char><char style="xt" closed="false"><ref loc="LEV 18:5">লেবীয় বিজাব 18:5</ref></char></note>।” <verse eid="ROM 10:5" /><verse number="6" style="v" sid="ROM 10:6" />নাথায় ধৗরৗমিয়ায়া অর্থাৎ ফৗথায়নায়জৗংসৗ বুঙৗ, “নৗংনি গৗসৗয়াও দাবুং, ‘ছৗর স্বৗর্গৗয়াও থাংনায়?’ বি খ্রীষ্টখৌ গাহায়াও লাবৗনৗ, <verse eid="ROM 10:6" /><verse number="7" style="v" sid="ROM 10:7" />এবা ‘ছৗর গৗথৌসিনাও অৗংখাৎলাংনায়?’ অর্থাৎ গৗথৈফৗরনিফ্রায় খ্রীষ্টখৌ গৗজৌয়াও লাবৗনৗ।” <verse eid="ROM 10:7" /><verse number="8" style="v" sid="ROM 10:8" />নাথায় বে মা বুঙৗ? “বে রাওয়া নৗংনি খাঠিয়াও, নৗংনি খৌগায়াও আরৗ নৗংনি গৗসৗয়াও,” অর্থাৎ ফৗথাইনায়নি বি বাথ্রায়া, জেখৌ জৗঙৗ প্রচার খৗলামৗ। <verse eid="ROM 10:8" /><verse number="9" style="v" sid="ROM 10:9" />যদি নৗঙৗ নৗংনি খৌগাজৗং সিমান লায়ৗ, “যীশুখৌ ফৗরবু,” হৗন্নানৈ মিথিসাৎ হৗয়ৗ আরৗ গৗসৗয়াও ফৗথাইয়ৗ যে, ঈশ্বৗরা বিখৌ থৈনায়ফৗরনি গেজেরাও বৗখাংফিনবায়, অব্লা নৗঙৗ বাছায়জানায়। <verse eid="ROM 10:9" /><verse number="10" style="v" sid="ROM 10:10" />মানৗনা মানসিফ্রা গৗসৗজৗং ফৗথাইয়ৗ ধৗরৗমিয়ানি থাখৈ আরৗ বিছৗরৗ খৌগাজৗং স্বীকার খৗলামনায়া বাছাইজানায়নি থাখৈ। <verse eid="ROM 10:10" /><verse number="11" style="v" sid="ROM 10:11" />জেরৈবাদি শাস্ত্রয়া বুঙৗ, “ছৗরবা সাছে বিনি ছায়াও ফৗথায়ৗ, বিয়ৗ লাজি নাংনায় অৗঙা।” <verse eid="ROM 10:11" /><verse number="12" style="v" sid="ROM 10:12" />মানৗনা যিহূদি আরৗ গ্রীক ফারাগ গৈয়া; মানৗনা সাফ্রৗমনিবৗ একেই ফৗরবু; জাইফ্রা বিখৌ লিংহৎনৗ,<note caller="+" style="x"><char style="xo" closed="false">10:12 </char><char style="xt" closed="false"><ref loc="ISA 28:16">যিশাইয় 28:16</ref></char></note> বিছৗর সাফ্রৗমনৗবৗ ফৗরবুআ গৗসৗ গুয়ারজৗং হৗয়ৗ। <verse eid="ROM 10:12" /><verse number="13" style="v" sid="ROM 10:13" />মানৗনা, “সাফ্রৗমবৗ জাইফ্রা ফৗরবুনি নামখৌ লিংহৎনৗ, বিছৗরৗ বাছাইজানায়।<note caller="+" style="x"><char style="xo" closed="false">10:13 </char><char style="xt" closed="false"><ref loc="JOL 2:23">যোয়েল 2:23</ref></char></note>”<verse eid="ROM 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 10:14" />অব্লা, বিনি ছায়াও জাইফ্রা ফৗথাইয়াখৈ মাব্রৈ বিখৌ বিছৗরৗ গাবজ্রিনায়? আরৗ মাব্রৈ বিছৗরৗ বিখৌ ফৗথাইনায় যদি বিছৗরৗ বিনি বিষয়ৈ মাব্লাবাবৗ খৗনাখৈ? আরৗ ছৗরবা বিছৗরনিয়াও প্রচার খৗলামালা বিছৗরৗ মাব্রৈ বিনি বিষয়ৈ খৗনাছংনৗ হায়ৗ? <verse eid="ROM 10:14" /><verse number="15" style="v" sid="ROM 10:15" />আরৗ দা ছৗরবা থৗনহৎনাব্লা মাব্রৈ প্রচার খৗলামনৗ হাগৌ? আরৗ মাব্রৈ ছৗরবা সাছে বিছৗরনিয়াও প্রচার খৗলামনায়, “জাইফ্রা মৗজাং খবরখৌ লাবৗয়ৗ বিছৗরনি আঠেঙা <note caller="+" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="ISA 52:7">যিশাইয় 52:7</ref> </char></note>বেছে সমাইনা।”<verse eid="ROM 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 10:16" />নাথায় গাছেন ইস্রায়েলয়ারিফ্রা মৗজাং খবরখৌ নাজাওয়াখৈ মৗন। মানৗনা যিশাইয়া বুংদৗং, “ফৗরবু, জৗংনি বাথ্রাখৌ ছৗর ফৗথাইদৗং?” <verse eid="ROM 10:16" /><verse number="17" style="v" sid="ROM 10:17" />বিনিখাইনৗ ফৗথাইনায়া বাথ্রা খৗনাছংনায়জৗংসৗ ফৈয়ৗ আরৗ খৗনাছংনায়া খ্রীষ্টনি বাথ্রানি গেজেরজৗং জায়ৗ। <verse eid="ROM 10:17" /><verse number="18" style="v" sid="ROM 10:18" />নাথায় আং বুঙৗ, বিছৗরৗ খৗনানৗ মৗন্নাখৈ নামা? নংথারগৌ বিছৗরৗ খৗনাবায়।</para>
  <para style="p" vid="ROM 10:18">“বিছৗরনি গারাংঙা গাছেন সংসারাও থাংবায়, আরৗ বিছৗরনি খৗথাফ্রা সংসারনি জৗবনায় সিম ছহৈবায়<note caller="+" style="x"><char style="xo" closed="false">10:18 </char><char style="xt" closed="false"><ref loc="PSA 19:4">গীতফৗর 19:4</ref> </char></note>।” <verse eid="ROM 10:18" /><verse number="19" style="v" sid="ROM 10:19" />আরবাও আং সৗঙৗ, ইস্রায়েলয়া মা কি বুজিনৗ হায়াখৈ? সিগাং, মোশিআ বুঙৗ,</para>
  <para style="p" vid="ROM 10:19">“জাইফ্রা হাদৎ মৗনছেনি অৗঙা বিনি গেজেরজৗং নৗংছৗরখৌ হিংসা খুরিয়া খৗলামনায়; বুজিনৗরৗঙি জাতিনি গেজেরজৗং নৗংখৌ রাগ খৗলামনায়।”<verse eid="ROM 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 10:20" />আরৗ যিশাইয়া সাহসজৗং বুংদৗং, “জাইফ্রা আংখৌ নাগিদনাখৈ, বিছৗরৗ আংখৌ মৗনবায়, জাইফ্রা আংনিফ্রায় সৗঙাখৈ, বিছৗরখৌ নুজাহৗদৗং<note caller="+" style="x"><char style="xo" closed="false">10:20 </char><char style="xt" closed="false"><ref loc="PSA 19:4">গীতফৗর 19:4</ref></char></note>।”<verse eid="ROM 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 10:21" />নাথায় ইস্রায়েলনি বিষয়ৈ বিয়ৗ মা বুঙৗ, “সারা দিন আঙৗ অবাধ্য আরৗ অখ্রা মানসিফৗরনি থাখৈ আঙৗ আখাই ফৗলাওদৗংমৗন।”<verse eid="ROM 10:21" /></para>
  <chapter eid="ROM 10" />
  <chapter number="11" style="c" sid="ROM 11" />
  <para style="s">ইস্রায়েলনি থালাংনায়</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1" />অব্লা আঙৗ সৗঙৗ, ঈশ্বৗরা মা গাওনি মানসিফৗরখৌ এৎগারবায় নামা? মৗংবৗ অৗংথি গৈয়া, আং গাওনৗ সাছে ইস্রায়েলী, অব্রাহামনি জৗলৈ, বিন্যামিননি বংশনি ফ্রায়<note caller="+" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="PHP 3:5">ফিলিপীয় 3:5</ref> </char></note>। <verse eid="ROM 11:1" /><verse number="2" style="v" sid="ROM 11:2" />ঈশ্বৗরা গাওনি মানসিফরখৌ এৎগারাখৈ, জাইখৌ বিয়ৗ সিগাং মিথিগৌ মৗন। নৗঙৗ মাকি মিথিয়া শাস্ত্রয়া এলিয়নি বিষয়ৈ মা বুঙৗ? মাব্রৈ বিয়ৗ ইস্রায়েলনি বিরুদ্ধ ঈশ্বৗরনিয়াও গুরৈয়ৈ খাওলায়খৗ, <verse eid="ROM 11:2" /><verse number="3" style="v" sid="ROM 11:3" />“ফৗরবু, বিছৗরৗ নৗংনি নবিফৗরখৌ সিথাৎবায় আরৗ নৗংনি বেদীফৗরখৌ ছিফাইবায়, আং হাসিং থাবায়, আরৗ বিছৗরৗ আংনি জিউখৌ সিথাৎনৗ হাস্থাইদৗং।”<note caller="+" style="x"><char style="xo" closed="false">11:3 </char><char style="xt" closed="false"><ref loc="1KI 19:10">1 রাজাফৗরনি বিজাব 19:10</ref>,<ref loc="1KI 19:14">14</ref></char></note> <verse eid="ROM 11:3" /><verse number="4" style="v" sid="ROM 11:4" />আরৗ ঈশ্বৗরা বিখৌ মা উত্তর হৗবায়? “আং গাওনি থাখৈ সাত হাজার মানসি দৗনদৗং, জাইফ্রা বাল মদাইনি সিগাঙাও হান্ঠু খরাইয়াখৈ<note caller="+" style="x"><char style="xo" closed="false">11:4 </char><char style="xt" closed="false"><ref loc="1KI 19:18">1 রাজাফৗরনি বিজাব 19:18</ref></char></note>।” <verse eid="ROM 11:4" /><verse number="5" style="v" sid="ROM 11:5" />বিনিখাইনৗ বর্তমান সমাও বিহা অনুগ্রহজৗং সাইখজানায় আদ্রা বাহাগৗ মৗনছে। <verse eid="ROM 11:5" /><verse number="6" style="v" sid="ROM 11:6" />আরৗ যদি অনুগ্রহজৗং, অব্লা বে মৗজাং খামানিজৗং জানৗ হায়া; অৗঙাব্লা অনুগ্রহয়া অনুগ্রহ জানায় অৗঙা।<verse eid="ROM 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 11:7" />অব্লা মা? ইস্রায়েলনি মানসিফ্রা জাইখৌ মৗন্নৗ হাস্থায়দৗং মৗন বিখৌ বিছৗরৗ মৗন্নাখৈ, বিছৗরনি গেজেরাও সাইখনায়ফৗর, নাথায় বিহা গুবুনফ্রা গৗসৗ গৗরা, <verse eid="ROM 11:7" /><verse number="8" style="v" sid="ROM 11:8" />জেরৈ বাদি লিৎনায় দং, “ঈশ্বৗরা বিছৗরখৌ বুজিনৗ গৗহৗ গৗয়ি জিউখৌ হৗবায়, যে মগনজৗং নুয়া, আরৗ খৗমাজৗং বিছৗর খৗনায়া, জেব্লাসিম বে দিননা<note caller="+" style="x"><char style="xo" closed="false">11:8 </char><char style="xt" closed="false"><ref loc="ISA 29:10">যিশাইয় 29:10</ref></char></note>।” <verse eid="ROM 11:8" /><verse number="9" style="v" sid="ROM 11:9" />আরৗ দায়ূদনা হৗন্দৗং: “বিছৗরনি জানায় লৗংনায়া মৗনছে ফানদৗ আরৗ মৗনছে ফান বাদি, বিহা ছৗখ্ঠুথৗং আরৗ বিছৗরৗ সাজা মৗনথৗং।<verse eid="ROM 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 11:10" />বিছৗরনি মগনফ্রা খানা জাথৗং, জেন বিছৗরৗ নায়নৗ হায়া; আরৗ বিছৗরনি বিখুংফ্রা জেব্লাইবৗনি থাখৈ খেংখ্রা খৗলামজাথৗং<note caller="+" style="x"><char style="xo" closed="false">11:10 </char><char style="xt" closed="false"><ref loc="PSA 69:22">গীতফৗর 69:22</ref>,<ref loc="PSA 69:23">23</ref></char></note>।”<verse eid="ROM 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11" />আরবাও আঙৗ সৗঙৗ, বিছৗরৗ মা কি মৗনফিননায়নি বাইরাও ছৗখ্ঠুনানৈ গৗগ্লাইবায়? অৗংথারা, বরং বিছৗরনি আইন ছিফাইগ্রা গুবুনহারিফৗরনিয়াও উদ্ধার ফৈদৗং, জাহাথে ইস্রায়েলফ্রাবৗ মগন ছায়ৗ। <verse eid="ROM 11:11" /><verse number="12" style="v" sid="ROM 11:12" />নাথায় বিছৗরনি আইন ছিফাইনায়াও যদি সংসারনি ধৗনি জায়ৗ, আরৗ বিছৗরনি খুহায়াও গুবুনহারিফ্রা ধনবান জাবায়, বেছেগৗবাং গেদেৎ জানায় বিছৗরনি বানায়ফিননায়াও!<verse eid="ROM 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13" />গুবুনহারিফৗর, আঙৗ নৗংছৗরখৌ বুঙৗ বৈ সমনিফ্রায়নৗ আঙৗ গুবুনহারিফৗরনি প্রেরিত, আঙৗ আংনি সেবায়াও ডুগা খৗলামৗ, <verse eid="ROM 11:13" /><verse number="14" style="v" sid="ROM 11:14" />বে আশাও যে আঙৗ জায়খি জায়া আংনি মানসিফৗরখৌ মগন ছানায়াও ফৗজানায় আরৗ বিছৗরনি খাইছেখৌ বাছাইনায়। <verse eid="ROM 11:14" /><verse number="15" style="v" sid="ROM 11:15" />মানৗনা বিছৗরনি এৎগারনায়া সংসারাও মিলায়ফিননায়খৌ লাবৗবায়ব্লা, অব্লা বিছৗরনি নাজাওজানায়া, জাইয়ানৗ জায়ামানৗ থৈনায়নিফ্রায় গৗঠাং ছাড়া মা জানায়? <verse eid="ROM 11:15" /><verse number="16" style="v" sid="ROM 11:16" />যদি সিগাংনি বিথাই হৗন্নানৈ হৗনায় ময়দানি অংশয়া গৗথারব্লা, অব্লা গাছেনবৗ ময়দায়া গৗথার জায়ৗ, যদি রৗদায়া গৗথার জায়ৗ অব্লা ডালাইফ্রাবৗ গৗথার জায়ৗ।<note caller="+" style="f"><char style="fr" closed="false">11:16 </char><char style="ft" closed="false">পৌলআ গুবুনহারিফৗরখৌ গৗসৗখাং হৗদৗং যে বিছৗরৗ যিহুদীফৗরনেও উদ্ধারনি রিনি। যিহূদীফৗরখৌ মন্দিরাও হৗজানায় ময়দা আরৗ ডংফাংনি রৗদাজৗং রুজুদৗং।</char></note><verse eid="ROM 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 11:17" />খাইছে ডালাইফ্রা ছিফাইজাবায়ব্লা আরৗ ঈশ্বৗরজৗং গারজাবাইব্লা, আরৗ নৗংছৗরৗ গুবুনহারিফৗর, হাগ্রানি অলিব বিংফাংনি ডালাইফৗর বাদি গুবুন ডালাইফৗরনি গেজেরাও খাজোবজায়ৗ আরৗ দা যিহূদীফৗরনি ফ্রায় মুলাম্ফা খৗলামৗ, জেরৈ বাদি হাগ্রানি অলিব ডালাইয়া আবাদ মাওনায় বিংফাংনি রসনি ফ্রায়। <verse eid="ROM 11:17" /><verse number="18" style="v" sid="ROM 11:18" />বিফৗর গুবুন ডালাইফৗরনি ছায়াও নৗং গাওখৌ জৌগা মাননি দাখৗলাম, যদি নৗঙৗ ডুগা খৗলামৗ অব্লা গৗসৗখাং নৗঙৗ রৗদাখৌ হেফাজাব হৗয়া, নাথায় রৗদায়াসৗ নৗংখৌ হেফাজাব হৗয়ৗ। <verse eid="ROM 11:18" /><verse number="19" style="v" sid="ROM 11:19" />অব্লা নৗঙৗ বুংনায়, “ডালাইফ্রা ছিফাইজাবায় বিনিখাইনৗ যে আঙৗ খাজোবজাফানায়।” <verse eid="ROM 11:19" /><verse number="20" style="v" sid="ROM 11:20" />নংগৌ, নাথায় ফৗথাইয়িনি থাখৈ বিছৗরৗ ছিফাইজাবায়, আরৗ নৗঙৗ ফৗথাইনায়াও গছংফাথায়ৗ, ডুগা দাখৗলাম বরংছৗ মানজৗং গি। <verse eid="ROM 11:20" /><verse number="21" style="v" sid="ROM 11:21" />মানৗনা ঈশ্বৗরা যদি প্রকৃত ডালাইফৗরখৌ রেহায় হৗয়াখৈমৗনব্লা অব্লা বিয়ৗ নৗংখৌবৗ রেহায় হৗনায় অৗঙা।<verse eid="ROM 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 11:22" />বিনিখাইনৗ, ঈশ্বৗরনি অন্নায় আরৗ গৗব্রাবখৌ সান্নানৈ নায়। জাইফ্রা গৗগ্লাইবায় বিছৗরজৗং বিয়ৗ গৗব্রাব, নাথায় নৗংনি ছায়াও বিয়ৗ অনসুলা-যদি নৗঙৗ বিনি অননায়াও থাফ্লায়ৗব্লা। অৗঙালা নৗংবৗ দানফাইনান আলাদা খৗলামজানায়। <verse eid="ROM 11:22" /><verse number="23" style="v" sid="ROM 11:23" />আরৗ যদি বিছৗরৗ ফৗথায়িয়াও হমঠাবনান থায়াব্লা, বিছৗরখৌ খাজৗবজানায়, মানৗনা বিছৗরখৌ ঈশ্বৗরা আরবাও খাজৗবনৗ হানায়। <verse eid="ROM 11:23" /><verse number="24" style="v" sid="ROM 11:24" />গাছেননি উনাও, যদি নৗংখৌ মৗনছে অলিব বিংফাংনিফ্রায় দানছোনানৈ গারৗ, জেয়া প্রাকৃতিকনি দারৈ হাগ্রানি, আরৗ প্রাকৃতিকনি উল্ঠায়ৈ মৗনছে আবাদ মাওনায় অলিব বিংফাঙাও খৗলৗম খৗলামৗ, অব্লা প্রাকৃতিক ডালাইফ্রা বেছে আলঠুয়ায়ৈনৗ বিছৗরনি গাওনি অলিব বিংফাঙাও খৗলৗম খৗলামজানায়<note caller="+" style="f"><char style="fr" closed="false">11:24 </char><char style="ft" closed="false">বে পদনাও হাগ্রানি ডালাইফ্রা জাবায় গুবুনহারিফৗর আরৗ প্রাকৃতিকনি ডালাইফ্রা জাবায় যিহূদীফৗর। যদি গুবুনহারিফ্রা ফৗথাইনানৈ আবাদ মাওনায় অলিব বিংফাঙাও খৗলৗম খৗলাম জায়ৗ, অব্লাহায় যিহূদীফৗরনি থাখৈ, জাইফ্রা আবাদ মাওনায় অলিব বিংফাংফৗরনি সিঙাও, বিছৗরনে ফৗথাইনায়নি উনাও আরবাও খৗলৗম খৗলামনায়া আলঠুয়াসিন জানায়। </char></note>।<verse eid="ROM 11:24" /></para>
  <para style="s">গাছেন ইস্রায়েলফ্রা বাছায় জানায়</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25" />বিদা-ফংবায়ফৗর আরৗ বিবো-বিনানাওফৗর, আঙৗ লুবৈয়া নৗংছৗরৗ বে রহস্যনি বিষয়ৈ অজ্ঞাননি থা, জাহাথে নৗংছৗরৗ ডুগা দাজা: গুবুনহারিফ্রা ফুরা সংখ্যায়াও ফৈজৗবমাসিম ইস্রায়েলফৗরনি গেজেরাও খাইছেফ্রা গৗসৗ গৗরা জানানৈ থাবায়, <verse eid="ROM 11:25" /><verse number="26" style="v" sid="ROM 11:26" />আরৗ বেবাদিনৗ গাছেন ইস্রায়েলফ্রা বাছাইজানায়; জেরৈ বাদি লিৎনায় দং, “বাছাইগ্রায়া সিয়োননিফ্রায় ফৈনায়; বিয়ৗ বাখ্নায়রৗঙিফৗরখৌ যাকোবনি বংশনিফ্রায় <note caller="+" style="x"><char style="xo" closed="false">11:26 </char><char style="xt" closed="false"><ref loc="ISA 59:20">যিশাইয় 59:20</ref> </char></note>বৗখাৎনায়;<verse eid="ROM 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 11:27" />আরৗ বেনৗ আংনি চুক্তি বিছৗরজৗং, জেব্লা আঙৗ বিছৗরনি পাপফৗরখৌ বৗখাৎনায়।” <verse eid="ROM 11:27" /><verse number="28" style="v" sid="ROM 11:28" />জেছেসিম মৗজাং খবরা সানজায়ৗ, বিছৗরৗ নৗংছৗরনি থাখৈ বিসারু; নাথায় জেছেসিম সাইখজানায়া সানজায়ৗ, বিছৗরৗ ফৗলেরনি গুডি মানসিফৗরনি থাখৈছৗ অনজাদৗং। <verse eid="ROM 11:28" /><verse number="29" style="v" sid="ROM 11:29" />মানৗনা ঈশ্বৗরনি দান আরৗ বিনি লিংহৎনায়া সৗলাইজায়া। <verse eid="ROM 11:29" /><verse number="30" style="v" sid="ROM 11:30" />ঠিক জেরৈ নৗংছৗর জাইফ্রা সিগাঙাও ঈশ্বৗরনি অবাধ্যমৗন, দা বিছৗরৗ অবাধ্য দয়ানি বিথাইখৌ মৗনবায়। <verse eid="ROM 11:30" /><verse number="31" style="v" sid="ROM 11:31" />বেনিখাইনৗ বিছৗরৗ দা অবাধ্য জাবায়, জেন বিছৗরনি বি দয়াখৌ নৗংনৗ দিন্ঠিনানৈ বিথাইখৌ ঈশ্বৗরনিয়াও মৗননৗ। <verse eid="ROM 11:31" /><verse number="32" style="v" sid="ROM 11:32" />মানৗনা ঈশ্বৗরা সাফ্রৗমখৌবৗ অবাধ্য নিফ্রায় সিমান খৗলামবায়, জাহাথে বিয়ৗ গাছেননি ছায়াও দয়া খৗলামনৗ হায়ৗ।<verse eid="ROM 11:32" /></para>
  <para style="s">বাখ্নাইনায়নি মেথায়</para>
  <para style="p">
    <verse number="33" style="v" sid="ROM 11:33" />অৗ, ঈশ্বৗরনি বুদ্ধি আরৗ জ্ঞাননি ধৗনয়া বেছেবা গৗথৌ, বিনি বিচারয়া বেছেবাং নাগিৎজায়ি, আরৗ বিনি লামাফৗরখৌ নাগিৎনানৈ নাহানছনৗ হায়া!<verse eid="ROM 11:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ROM 11:34" />“ফৗরবুনি গৗসৗখৌ ছৗর মিথিখৗ? কিন্বা বিনি মন্ত্রীআ বা ছৗর <note caller="+" style="x"><char style="xo" closed="false">11:34 </char><char style="xt" closed="false"><ref loc="ISA 40:13">যিশাইয় 40:13</ref> </char></note>জাখৗ?”<verse eid="ROM 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ROM 11:35" />“ছৗর ঈশ্বৗরনৗ হৗখৗ, জেখৌ ঈশ্বৗরা বিছৗরনৗ হৗফিননাংনায়?”<verse eid="ROM 11:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ROM 11:36" />মানৗনা বিনি ফ্রায় আরৗ বিনি গেজেরজৗং আরৗ বিনি জুনৈনৗ গাছেনবৗ।</para>
  <para style="p" vid="ROM 11:36">জেব্লাইবৗ বিনি মহিমা জাথৗং! আমেন।<verse eid="ROM 11:36" /></para>
  <chapter eid="ROM 11" />
  <chapter number="12" style="c" sid="ROM 12" />
  <para style="s">ঈশ্বৗরখৌ দাও দাও খৗলামনায়</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1" />বিনিখাইনৗ, বিদা-ফংবায়ফৗর আরৗ বিবো-বিনানাওফৗর আং খাওলাইয়ৗ, মানৗনা গৗবাং সমাও ঈশ্বৗরা জৗংনি প্রতি দয়া দিন্ঠিবায়, নৗংছৗরনি দেহাফৗরখৌ গৗঠাং হিসাবমৈ বাওনৗ, গৗথার আরৗ ঈশ্বৗরখৌ খুশি খৗলামনৗ, নৗংছৗরনি নংথারগৌ সিবিনাংগৌয়া বেনৗ। <verse eid="ROM 12:1" /><verse number="2" style="v" sid="ROM 12:2" />বে সংসারনি মহরাও দাগৗরৗবফা, নাথায় গৗসৗখৌ গৗদান খৗলামনৗনৈ আখল সৗলাইদৗ। অব্লা নৗংছৗরৗ পরীক্ষা খৗলাম আরৗ নৗংছৗরনি জুনৈ ঈশ্বৗরনি ইচ্ছা মা গনায়থি খৗলাম, জেয়া মৗজাং, গৗজৗননায় আরৗ গৗরৗন্ঠিগৈয়ি।<verse eid="ROM 12:2" /></para>
  <para style="s">খ্রীষ্টনি দেহাও গুরৈ সেবা।</para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3" />মানৗনা আংনৗ যে অনুগ্রহখৌ হৗবায় বেজৗং আং নৗংছৗর সাফ্রৗমখৌবৗ বুঙৗ, নৗংছৗর গাওখৌ জেরৈ সাননাগৌ বিনিখ্রুই বাংসিন জৌসিন সান্নানৈ দালা, নাথায় গাওখৌ দদ্র খৗলাম বিছৗরজৗং, ফৗথাইজানায় বাদি ঈশ্বৗরা নৗংছৗর সাফ্রৗমনৗ রানানৈ হৗবায়। <verse eid="ROM 12:3" /><verse number="4" style="v" sid="ROM 12:4" />মানৗনা জেরৈ জৗংনি দেহাও গৗবাং অজ্ঞফৗর দং, আরৗ বে অজ্ঞফ্রা গাছেনবৗ মৗনছে জৗং নাংস্টাফনায়। <verse eid="ROM 12:4" /><verse number="5" style="v" sid="ROM 12:5" />বিখাইনৗ, খ্রীষ্টনিয়াও জৗঙৗ গৗবাংব্লাবৗ দেহায়াও মৗনছে আরৗ মৗনফ্রৗমবৗ অঙ্গফ্রা মৗনছে মৗনছেনি সমন্ধ। <verse eid="ROM 12:5" /><verse number="6" style="v" sid="ROM 12:6" />জৗংনৗ হৗনায় অনুগ্রহ অনুজায়ৈ জৗংহা আলাদা আলাদা দান হৗবায়। যদি নৗংনি দাননা ভাববাণী জায়ৗ, অব্লা নৗংনি ফৗথাইনায় অনুজায়ৈ ভাববাণী বুঙৗ, <verse eid="ROM 12:6" /><verse number="7" style="v" sid="ROM 12:7" />যদি সেবানি দান মৗনদৗং, অব্লা বি সেবা খৗলামথৗং, যদি ছৗরবা ফৗরৗংগ্রাব্লা, অব্লা বিয়ৗ ফৗরৗংথৗং, <verse eid="ROM 12:7" /><verse number="8" style="v" sid="ROM 12:8" />যদি উৎসাহ হৗয়ৗ, অব্লা উৎসাহ হৗথৗং; জাইয়া দান হৗয়ৗ বিয়ৗ উদার গৗসৗজৗং হৗথৗং, জাইয়া শাসন খৗলামৗ, বিয়ৗ জৗথৗনজৗং লৗগৗছে, জেয়া দয়া খৗলামৗ, বিয়ৗ রংজানায়জৗং খৗলামথৗং।<verse eid="ROM 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9" />অন্নায়া গৗসৗ সিংনিফ্রায় জাথৗং। গাজ্রিখৌ মুগৈ; জেয়া মৗজাং বিহা গৗরায়ৈ হমঠাবনান থা। <verse eid="ROM 12:9" /><verse number="10" style="v" sid="ROM 12:10" />বিদা বিনানাওফৗর গাওজৗং গাও অনজ্লাইদৗ, গাওছৗরনি জৌসিননাও গাওজৗং গাও মান হৗজ্লায়দৗ। <verse eid="ROM 12:10" /><verse number="11" style="v" sid="ROM 12:11" />মাব্লাবাবৗ গৗসৗজানায়খৌ অভাব দাখৗলাম, নাথায় নৗংনি জিউয়াও তুলুংগানায়খৌ দৗন, ফৗরবুখৌ সেবা খৗলাম। <verse eid="ROM 12:11" /><verse number="12" style="v" sid="ROM 12:12" />আশায়াও রংজা, কষ্টয়াও সহায়নৗ হাগ্রা জা, প্রার্থনাও ফৗথাইসুলা জা। <verse eid="ROM 12:12" /><verse number="13" style="v" sid="ROM 12:13" />ফৗরবুনি মানসিফৗর জাইনে নাংগৌ বিছৗরজৗং ভাগৗ জা। আলাসি সিবিগ্রা জা।<verse eid="ROM 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 12:14" />জাইফ্রা নাছয়গ্রা বিছৗরখৌ আশীর্ব্বাদ খৗলাম, আরৗ সাও দাহৗ<note caller="+" style="x"><char style="xo" closed="false">12:14 </char><char style="xt" closed="false"><ref loc="MAT 5:44">মথি 5:44</ref>; <ref loc="LUK 6:28">লূক 6:28</ref></char></note>। <verse eid="ROM 12:14" /><verse number="15" style="v" sid="ROM 12:15" />জাইফ্রা রংজায়ৗ বিছৗরজৗং রংজাফা, জাইফ্রা দুঃখু খৗলামৗ বিছৗরজৗং দুঃখু খৗলামফা। <verse eid="ROM 12:15" /><verse number="16" style="v" sid="ROM 12:16" />গাওজৗং গাও গৗরৗবজ্লায়নানৈ থা, ডুগা দাজা, নাথায় গাহাই থাখৗনি মানসিফৗরজৗংবৗ লৗগৗ জানৗ ইছ্ছা জা। গাওনি জ্ঞানাও বুদ্ধিমান দাজা<note caller="+" style="x"><char style="xo" closed="false">12:16 </char><char style="xt" closed="false"><ref loc="PRO 3:7">বৗচৗন বিজাব 3:7</ref></char></note>। <verse eid="ROM 12:16" /><verse number="17" style="v" sid="ROM 12:17" />রাওখৌবৗ গাজ্রিনি থাখৈ গাজ্রি পালটা দালা, সাফ্রৗমবৗনি নৗজৗররাও জেয়া সাবসিন বিখৌনৗ সানথ্র হুথ্রৌ খৗলাম। <verse eid="ROM 12:17" /><verse number="18" style="v" sid="ROM 12:18" />হাগৌমানি সাফ্রৗমজৗংবৗ শান্তিয়াও থা। <verse eid="ROM 12:18" /><verse number="19" style="v" sid="ROM 12:19" />পালটা দালা, আংনি আংগৗ লৗগৗফৗর, নাথায় ঈশ্বৗরনি রাগনি থাখৈ খঠ্রা নাগারনানৈ হৗ, মানৗনা লিৎনায় দং, “পালটা লানায়া আংনি খামানি, আংনৗ পালটা হৗফিননায়<note caller="+" style="x"><char style="xo" closed="false">12:19 </char><char style="xt" closed="false"><ref loc="DEU 32:35">হূদা বিজাব 32:35</ref></char></note>” ফৗরবুআ বুংদৗং। <verse eid="ROM 12:19" /><verse number="20" style="v" sid="ROM 12:20" />বরং, “নৗংনি বিসারুয়া উখৈয়ৗব্লা, বিখৌ আহার জাহৗ, যদি বিয়ৗ গাংঙৗ, বিখৌ লৗংহৗ, বেখৌ খৗলামৗব্লা নৗঙৗ বিনি খরনি ছায়াও জৗংব্লাওনায় অৎখিখৌ দৗন্নায়।”<verse eid="ROM 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 12:21" />নৗঙৗ গাজ্রিজৗং দাফেজেনজা, নাথায় গাজ্রিখৌ মৗজাংজৗং<note caller="+" style="x"><char style="xo" closed="false">12:21 </char><char style="xt" closed="false"><ref loc="PRO 25:21-22">বৗচৗন বিজাব 25:21–22</ref></char></note> ফেজেন।<verse eid="ROM 12:21" /></para>
  <chapter eid="ROM 12" />
  <chapter number="13" style="c" sid="ROM 13" />
  <para style="s">হাদৎ বেংগ্রাফৗরখৌ মানিনায়</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1" />শাসন খৗলামগ্রাফৗরনৗ সাফ্রৗমবৗ গথাইনাংগৌ, মানৗনা ঈশ্বৗরনি একথিয়ারখৌ নাগারনানৈ জেবৗ লুখাংজায়া। আরৗ একথিয়ারফ্রা জেয়া ঠাংনান দং ঈশ্বৗরজৗং লুখাংজানায়। <verse eid="ROM 13:1" /><verse number="2" style="v" sid="ROM 13:2" />বিনিখাইনৗ, জাইফ্রা একথিয়ারনি বিরুদ্ধ খৗলামৗ, বিয়ৗ ঈশ্বৗরনি আদেশ হৗনায়নি বিরুদ্ধ খৗলামৗ, আরৗ বিছৗরৗ গাওছৗরনি ছায়াও বিচারখৌ লাবৗয়ৗ। <verse eid="ROM 13:2" /><verse number="3" style="v" sid="ROM 13:3" />মানৗনা জাইফ্রা মৗজাংখৌ মাওয়ৗ বিয়ৗ শাসনগিরিফৗরখৌ দাগি, নাথায় জাইফ্রা গৗরৗন্ঠি মাওয়ৗ। নৗঙৗ মা কি লুবৈয়ৗ একথিয়ারখৌ গিনায়নিফ্রায় গহৗজানৗ? অব্লা জেয়া ঠিক বিখৌনৗ খৗলাম আরৗ নৗঙৗ সাবাইস হৗজানায়। <verse eid="ROM 13:3" /><verse number="4" style="v" sid="ROM 13:4" />মানৗনা নৗংনি থাখৈনৗ বিয়ৗ ঈশ্বৗরনি দাস নৗংনি মৗজাংখৌনৗ মাওয়ৗ। যদি নৗঙৗ গাজ্রিখৌ মাওয়ৗ, গিদৗ, মানৗনা বিছৗরৗ সাজা হৗনৗ হাগ্রা আরৗ বিছৗরৗ খৗলামৗ। বিছৗরৗ ঈশ্বৗরনি দাস, গাজ্রি মাওগ্রানি ছায়াও সাজা লাবৗনৗ রাগনি থানদৈফৗর। <verse eid="ROM 13:4" /><verse number="5" style="v" sid="ROM 13:5" />বিনিখাইনৗ, একথিয়ারখৌ গথায় নাংগৌ ঈশ্বৗরনি সাজাখৌ গিনানৈ বান অৗঙা নাথায় বিবেকনি বিষয়ৈ।<verse eid="ROM 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 13:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">13:6 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 22:2">মথি 22:2</ref>; <ref loc="MRK 12:17">মার্ক 12:17</ref>; <ref loc="LUK 20:25">লূক 20:25</ref></char>
    </note>বিনি থাখৈনৗ নৗংছৗরৗ খাজনাফৗরখৌ হৗয়ৗ, মানৗনা বিছৗরৗ ঈশ্বৗরনি সেবাকারি, বিছৗরনৗ ফুরা সমখৌ শাসন খৗলামনৗ হৗয়ৗ। <verse eid="ROM 13:6" /><verse number="7" style="v" sid="ROM 13:7" />নৗংছৗরৗ সাফ্রৗমনৗ বি হৗনাংগৌফৗরখৌ হৗ, নৗং খাজনাফৗর হৗনাংগৌব্লা, খাজনাফৗর হৗ, মাসুল হৗনাংগৌব্লা, মাসুল হৗ, সনমান হৗনাংগৌব্লা, সনমান হৗ, মান হৗনাংগৌব্লা, মান হৗ।<verse eid="ROM 13:7" /></para>
  <para style="s">বে আইননাও ফুরায়ৈ অন্নায় দং</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8" />নৗংছৗরৗ রাওনিবৗ দাহারাও দাথাথৗং, জেব্লাইবৗ গাওজৗং গাও অনজ্লাইনায়নি দাহার জা, মানৗনা জাইফ্রা গুবুনফৗরখৌ অন্নৗ, আইনখৌ ফুরা খৗলামৗ। <verse eid="ROM 13:8" /><verse number="9" style="v" sid="ROM 13:9" />আদেশফ্রা বেনৗ, “নৗঙৗ জিনাহারি দাখৗলাম,” “নৗঙৗ মানসি দাসিথাৎ,” “নৗঙৗ সিখাও দাখাও,” “নৗঙৗ গুবুনফৗরনি মৗঙাখৌ দালুবৈ,” বেফৗর গাছেন আদেশফৗর আরৗ গাছেন গুবুন আদেশফৗরখৌ, বে মৗনছে আদেশাও জ' খৗলাম: “নৗঙৗ গাওনি পারাফুরুসিখৌ গাওখৌ বাদি অন<note caller="+" style="x"><char style="xo" closed="false">13:9 </char><char style="xt" closed="false"><ref loc="EXO 20:13-15">অৗংখাৎলাংনায় 20:13–15</ref>,<ref loc="EXO 20:17">17</ref></char></note>।” <verse eid="ROM 13:9" /><verse number="10" style="v" sid="ROM 13:10" />অন্নায়া পারাফুরুসিখৌ হানি খৗলামা, বিনিখাইনৗ অন্নায়া আইনখৌ ফুরা খৗলামৗ।<verse eid="ROM 13:10" /></para>
  <para style="s">বে দিননা খাঠৈছৈ</para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11" />আরৗ বেবাদি খৗলাম, বে বর্তমান সমখৌ বুজিয়ৗ, বে সমমা নৗংছৗরনি উন্ডুলাংনায় সমখৌ সিরিমৗনহৗনায়নি জাবায়, মানৗনা জৗংনি উদ্ধারনি সমমা দা খাঠৈসিন, জেব্লা জৗঙৗ সিগাঙাও ফৗথাইদৗং। <verse eid="ROM 13:11" /><verse number="12" style="v" sid="ROM 13:12" />বে হররা জৗবথারনায়ছৈ, সানা নখানায়থারনাইছৈ। বিনিখাইনৗ ফৈ জৗঙৗ খৗমসিনি খামানিখৌ দৗনদৗনি, আরৗ স্রাংনি অস্ত্র গানদৗনি। <verse eid="ROM 13:12" /><verse number="13" style="v" sid="ROM 13:13" />দে জৗংবৗ স্রাংয়াও থাবায়নায় বাদি মৗজাং আখললৈ থাবায়নি, দাওরাওফৗর অৗঙা, ফেগ্লুংনায় আরৗ লৗংগ্লুংনায় অৗঙা, জিনাহারি অৗঙা, লাজিথাও খামানিফৗরনিফ্রায়, খৗথাও নাংজ্লাইগ্রা অৗঙা আরৗ হিংসা খৗলামগ্রা অৗঙা। <verse eid="ROM 13:13" /><verse number="14" style="v" sid="ROM 13:14" />বরং, নৗংছৗরৗ ফৗরবু যীশু খ্রীষ্টখৌ সি' বাদি গানদৗ, আরৗ বে মৗদৗমনি লুবৈনায়খৌ খুশি খৗলামনৗ দাসান।<verse eid="ROM 13:14" /></para>
  <chapter eid="ROM 13" />
  <chapter number="14" style="c" sid="ROM 14" />
  <para style="s">বিদা-ফংবায়ফৗরখৌ বিচার দাখৗলাম</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1" />ফৗথাইনায়াও জাইয়া গৗহৗ গৈয়া বিখৌ নাজাও, তর্কবির্তক বিষয়ৈ নাংজ্লাইয়ামাৎনিন<note caller="+" style="x"><char style="xo" closed="false">14:1 </char><char style="xt" closed="false"><ref loc="COL 2:16">কলসীয় 2:16</ref></char></note>। <verse eid="ROM 14:1" /><verse number="2" style="v" sid="ROM 14:2" />সাছে মানসিনে ফৗথাইনায় দং, বিয়ৗ জেবৗ জানৗ হায়ৗ, নাথায় গুবুননি, জাইনে ফৗথাইনায়াও দুর্ব্বল, বিয়ৗ মৈগং থাইগংফৗর বান জা। <verse eid="ROM 14:2" /><verse number="3" style="v" sid="ROM 14:3" />জাইয়া গাছেনখৌবৗ জায়ৗ, বিয়ৗ জায়িখৌ দামুগৈথৗং; আরৗ গাছেনখৌ জায়িয়া গাছেন জাগ্রাখৌ বিচার দাখৗলামথারথৗং, মানৗনা ঈশ্বৗরা জাগ্রাখৌবৗ আরৗ জায়িখৌবৗ নাজাওবায়। <verse eid="ROM 14:3" /><verse number="4" style="v" sid="ROM 14:4" />নৗঙৗ ছৗর, গুবুননি দাসখৌ বিচার খৗলামৗ? বিছৗরৗ গছংনায় কিন্বা বিছৗরৗ বৈগৗমানি সিগাঙাও গৗগ্লাইনায়। আরৗ বিছৗরৗ গছংনান থানায়, মানৗনা ফৗরবুআ বিছৗরখৌ গছংহৗনৗ হায়ৗ।<verse eid="ROM 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 14:5" />সাছে মানসিয়া মৗনছে দিনখৌ গুবুন মৗনছে দিননিফ্রায় বাংসিন গৗথার সান্নৗ; আরৗ গুবুন সাছে মানসিয়া মৗনফ্রৗমবৗ দিনখৌ একই সান্নৗ। বিছৗরৗ গাও গাওনি গৗসৗয়াও ফুরায়ৈ ফৗথায়থারনাংগৌ। <verse eid="ROM 14:5" /><verse number="6" style="v" sid="ROM 14:6" />জাইফ্রা মৗনছে দিন বিশেষ হিসাবমৈ বিবেচনা খৗলামৗ, ফৗরবুখৌ মান খৗলামনৗ থাখৈ বেখৌ খৗলামৗ। জাইফ্রা বিদৎ জায়ৗ বিয়ৗ ফৗরবুখৌ মান খৗলামনৗ থাখৈ বিখৌ খৗলামৗ মানৗনা বিছৗরৗ ঈশ্বৗরখৌ ধন্যবাদ হৗয়ৗ আরৗ জাইফ্রা বিদৎ জায়া বিয়ৗ ফৗরবুখৌ মান খৗলামনৗ থাখৈ আরৗ ঈশ্বৗরখৌ ধন্যবাদ হৗয়ৗ। <verse eid="ROM 14:6" /><verse number="7" style="v" sid="ROM 14:7" />মানৗনা জৗংনি গেজেরাও রাওবৗ গাওনি থাখৈ ঠাংনান থায়া, আরৗ রাওবৗ গাওনি থাখৈ থৈয়া। <verse eid="ROM 14:7" /><verse number="8" style="v" sid="ROM 14:8" />যদি জৗঙৗ ঠাঙৗ, অব্লা ফৗরবুনি থাখৈ ঠাঙৗ; আরৗ যদি থৈয়ৗ, অব্লা ফৗরবুনি থাখৈ থৈয়ৗ। বিনিখাইনৗ, জৗংনি ঠাংনায় কিন্বা থৈনায়া, জৗঙৗ ফৗরবুনি। <verse eid="ROM 14:8" /><verse number="9" style="v" sid="ROM 14:9" />মানৗনা বে কারননৈ খ্রীষ্টয়া থৈবায় আরৗ ঠাংখাংফিনবায়, বিনিখাইনৗ বিয়ৗ গৗথৈ আরৗ গৗঠাংনি ফৗরবু জানৗ হায়ৗ।<verse eid="ROM 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 14:10" />নৗঙৗ মানৗ নৗংনি বিদাফংবায়ফৗর আরৗ বিবো-বিনানাওফৗরখৌ বিচার খৗলামৗ? কিন্বা মানৗ নৗঙৗ মুগৈয়ৗ? মানৗনা গাছেনবৗ ঈশ্বৗরনি বিচারনি সিগাং গছংনায়<note caller="+" style="x"><char style="xo" closed="false">14:10 </char><char style="xt" closed="false"><ref loc="2CO 5:10">2 করিন্থীয় 5:10</ref> </char></note>। <verse eid="ROM 14:10" /><verse number="11" style="v" sid="ROM 14:11" />জেরৈ বাদি লিৎনায় দং, যে ফৗরবুআ বুঙৗ, “নংথারগৌয়ৈ জেরৈ আং গৗঠাঙৈ দং, মৗনফ্রৗমবৗ হান্ঠুয়া আংনি সিগাঙাও খরাইনায়, মৗনফ্রৗমবৗ ছালাইয়া ঈশ্বৗরখৌ সিমান লানায়।”<note caller="+" style="x"><char style="xo" closed="false">14:11 </char><char style="xt" closed="false"><ref loc="ISA 45:23">যিশাইয় 45:23</ref></char></note> <verse eid="ROM 14:11" /><verse number="12" style="v" sid="ROM 14:12" />বিনিখাইনৗ জৗং সাফ্রৗমবৗ ঈশ্বৗরনিয়াও গাওখৌ হিসাব হৗনাংনায়।<verse eid="ROM 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13" />বিনিখাইনৗ, জৗঙৗ গাওজৗং গাও রাওখৌবৗ বিচার খৗলামামাৎনিন, বরং নৗংছৗরৗ বেবাদি গৗসৗয়াও সান যে, বিদা-ফংবায়ফৗর আরৗ বিবো-বিনানাওফৗরখৌ ছৗখ্ঠুহৗলে কিন্বা বাধা হৗলে। <verse eid="ROM 14:13" /><verse number="14" style="v" sid="ROM 14:14" />আং মিথি থারবায়। আরৗ আঙৗ ফৗরবু যীশুনেও ফুরায়ৈ ফৗথায়ৗ, জেবৗ গাওনি গাও অশুচি অৗঙা। নাথায় ছৗরবায়া যদি ববেবা জিনিসখৌ অশুচি সান্নৗ অব্লাহায় বি মানসিনি থাখৈ বেয়ৗ অশুচি। <verse eid="ROM 14:14" /><verse number="15" style="v" sid="ROM 14:15" />নৗঙৗ মা জাদৗং বিনি থাখৈ নৗংনি ফংবায় কিন্বা বিনানাওয়া যদি কষ্ট মৗননৗ, অব্লা নৗঙৗ অননায়াও অভিনয় খৗলামাখৈ। নৗংনি জানায়নি গেজেরজৗং জায়খি জায়া, ছৗরবা সাছেখৌ হানি দাখৗলামথৗং জাইনি থাখৈ খ্রীষ্টআ থৈবায়। <verse eid="ROM 14:15" /><verse number="16" style="v" sid="ROM 14:16" />বিনিখাইনৗ জেখৌ নৗঙৗ মিথিগৌ মৗজাং বেয়ৗ গাজ্রি দাবুংজাথৗং। <verse eid="ROM 14:16" /><verse number="17" style="v" sid="ROM 14:17" />ঈশ্বৗরনি রাইজৗয়া জানায় লৗংনায়া গৗনাংথার নঙা, নাথায় ধৗরৗমিয়া, গৗজৗননায় আরৗ গৗথার জিউয়াও রংজানায়। <verse eid="ROM 14:17" /><verse number="18" style="v" sid="ROM 14:18" />মানৗনা ছৗরবা সাছেয়া খ্রীষ্টখৌ বেবাদি দাস হিসাবমৈ মাওনানৈ ঈশ্বৗরখৌ খুশি খৗলামৗ, আরৗ মানসিজৗং নাজাওজায়ৗ।<verse eid="ROM 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 14:19" />বিনিখাইনৗ ফৈ জৗং মৗনফ্রৗমখৌবৗ মাওনি জেয়া গৗজৗননাইয়াও দৈদেনৗ, আরৗ গাওজৗং গাও দৈখাংজ্লায়নি। <verse eid="ROM 14:19" /><verse number="20" style="v" sid="ROM 14:20" />জানাইনি থাখৈ ঈশ্বৗরনি খামানিখৌ সংহার দাখৗলাম। গাছেন খাজায়া গৗথার, নাথায় ছৗরবায়া মাবা জায়ৗ আরৗ সাছে মানসিনি থাখৈ মাবা মৗঙাখৌ জানাইনি কারণৈ ছৗখ্ঠুহৗয়ৗব্লা বেয়ৗ গৗরৗন্থি। <verse eid="ROM 14:20" /><verse number="21" style="v" sid="ROM 14:21" />বিদৎ জায়িয়ানৗ মৗজাং, দ্রাক্ষা বিদৈ লৗঙিয়ানৗ মৗজাং, কিন্বা মাবা মৗঙাফৗর মাওয়িআনৗ মৗজাং, জেয়া নৗংছৗরনি ফংবায় কিন্বা বিনানাওখৌ গৗগ্লৈনায়নি কারণ খৗলামৗ।<verse eid="ROM 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 14:22" />বিনিখাইনৗ নৗঙৗ জেখৌ ফৗথাইয়ৗ ঈশ্বৗরনি সিগাঙাও বিখৌ নৗংনিয়াও দৗন্দৗ। ধন্য বি মানসিয়া, বিয়ৗ জেখৌ গনায়বায় বিনি গেজেরজৗং বিয়ৗ গাওখৌ বিচার খৗলামমা। <verse eid="ROM 14:22" /><verse number="23" style="v" sid="ROM 14:23" />নাথায় জাইনে গৗনৗ গৗথৗ দং, যদি বিয়ৗ জায়ৗ অব্লা নিন্দিয়া জানায়, মানৗনা বে জানাইয়া ফৗথাইনায়জৗং অৗঙা; আরৗ যে মৗঙাফ্রা ফৗথাইনায়জৗং ফৈয়া বেয়ৗ পাপ।<verse eid="ROM 14:23" /></para>
  <chapter eid="ROM 14" />
  <chapter number="15" style="c" sid="ROM 15" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1" />জৗঙৗ জাইয়া বৗলৗগ্রা, গৗহৗ গৈয়িফৗরনি দায়খৌ সহায় হৗনাগৌ আরৗ জৗঙৗ গাওছৗরখৌ খুশি খৗলামনৗ অৗঙা। <verse eid="ROM 15:1" /><verse number="2" style="v" sid="ROM 15:2" />জৗং সাফ্রৗমনিবৗ উচিৎ জৗংনি পাড়াফুরসিখৌ মৗজাংনি থাখৈ খুশি খৗলামনৗ আরৗ বিছৗরখৌ লুখাংনৗ। <verse eid="ROM 15:2" /><verse number="3" style="v" sid="ROM 15:3" />মানৗনা খ্রীষ্টআবৗ গাওখৌ খুশি খৗলামাখৈ, নাথায় জেরৈহায় লিৎনায় দং, “জাইফ্রা নৗংখৌ অপমান খৗলামৗ বিছৗরনি অপমাননা আংনি ছায়াও গৗগ্লাইবায়<note caller="+" style="x"><char style="xo" closed="false">15:3 </char><char style="xt" closed="false"><ref loc="PSA 69:9">গীতফৗর 69:9</ref></char></note>।” <verse eid="ROM 15:3" /><verse number="4" style="v" sid="ROM 15:4" />মানৗনা মৗনফ্রৗমবৗ জেয়া সিগাঙাও লিৎনায় জাদৗংমৗন, শাস্ত্রয়া জৗংখৌ সহায়নৗ ফৗরৗঙৗ আরৗ বেফৗরৗ জৗংখৌ উৎসাহ হৗয়ৗ, বেনি গেজেরজৗং আশা খৗলামনৗ হায়ৗ।<verse eid="ROM 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 15:5" />ঈশ্বৗরা, জাইয়া সহায়নায় আরৗ উৎসাহ হৗয়ৗ, নৗংছৗরনি গেজেরাও একই সান্নৗ গৗহৗ হৗথৗং জেয়া যীশু খ্রীষ্টনিয়াও দংমৗন। <verse eid="ROM 15:5" /><verse number="6" style="v" sid="ROM 15:6" />জাহাথে নৗংছৗরৗ মৗনছে গৗসৗ আরৗ মৗনছে গারাংজৗং জৗংনি ফৗরবু যীশু খ্রীষ্টনি ঈশ্বৗর আরৗ বিফাখৌ মহিমাম্বিত খৗলামনৗ হায়ৗ।<verse eid="ROM 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7" />ঈশ্বৗরখৌ বাখ্নাইনৗ থাখৈ খ্রীষ্টআ জেরৈ নৗংছৗরখৌ নাজাওবায়, বেবাদিনৗ সাছেয়া সাছেজৗং নাজাওজ্লায়। <verse eid="ROM 15:7" /><verse number="8" style="v" sid="ROM 15:8" />মানৗনা আঙৗ নৗংছৗরখৌ বুঙৗ যে, খ্রীষ্টআ ঈশ্বৗরনি নংথারগৌ জানানৈ যিহূদীফৗরনি দাস জাদৗং আরৗ দিন্ঠিনায়নি জুনৈ যে ফোলেরনি গুদি মানসিফৗরনিয়াও সিমান লানায়ফ্রা নংথারগৌ। <verse eid="ROM 15:8" /><verse number="9" style="v" sid="ROM 15:9" />আরৗ বেনি অনগায়ৈবৗ যে গুবুনহারিফ্রা বিনি দয়ানি থাখৈ ঈশ্বৗরখৌ মহিমান্বিত খৗলামনৗ হায়ৗ। জেরৈবাদি লিৎনায় দং:</para>
  <para style="p" vid="ROM 15:9">“বিনিখাইনৗ আঙৗ, গুবুনহারিফৗরনি গেজেরাও নৗংখৌ বাখ্নাইনায়। আঙৗ নৗংনি নামৈ বাখ্নাইনায়নি মেথায় খননায়<note caller="+" style="x"><char style="xo" closed="false">15:9 </char><char style="xt" closed="false"><ref loc="2SA 22:50">2 সামুয়েল 22:50</ref>; <ref loc="PSA 18:49">গীতফৗর 18:49</ref> </char></note>”। <verse eid="ROM 15:9" /><verse number="10" style="v" sid="ROM 15:10" />আরবাও বেয়ৗ বুঙৗ, “এই গুবুনহারিফৗর, রংজা, বিনি মানসিফৗরজৗং রংজাফা<note caller="+" style="x"><char style="xo" closed="false">15:10 </char><char style="xt" closed="false"><ref loc="DEU 32:43">হূদা বিজাব 32:43</ref> </char></note>।” <verse eid="ROM 15:10" /><verse number="11" style="v" sid="ROM 15:11" />আরৗ আরবাও, “গাছেন গুবুনহারিফৗর, ফৗরবুখৌ বাখ্নায়, আরৗ গাছেন মানসিফৗর বিখৌ <note caller="+" style="x"><char style="xo" closed="false">15:11 </char><char style="xt" closed="false"><ref loc="PSA 117:1">গীতফৗর 117:1</ref></char></note>বাখ্নায়।” <verse eid="ROM 15:11" /><verse number="12" style="v" sid="ROM 15:12" />আরৗ আরবাও, যিশাইয় নবিআ বুংবায়, “যিশয়েনি বংশয়া জিখাংনায়, জাইয়া জাতিফৗরনি ছায়াও শাসন খৗলামনৗ থাখৈ জিখাংনায়; গুবুনহারিফ্রা বিনি ছায়াও আশা খৗলামনায়<note caller="+" style="x"><char style="xo" closed="false">15:12 </char><char style="xt" closed="false"><ref loc="ISA 11:10">যিশাইয় 11:10</ref></char></note>।” <verse eid="ROM 15:12" /><verse number="13" style="v" sid="ROM 15:13" />আশানি ঈশ্বৗররা নৗংছৗরনি ফৗথাইনায়জৗং গাছেনবৗ রংজানায় আরৗ শান্তিয়াও ফুরা খৗলামথৗং, জাহাথে নৗংছৗরনৗ গৗথার জিউনি বৗলৗজৗং আশায়াও লৗমসাওনানৈ বৗহৈলাংথৗং।<verse eid="ROM 15:13" /></para>
  <para style="s">পৌলআ গুবুনহারিফৗরনি মন্ত্রি</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14" />আংনি ফংবায় আরৗ বিনানাওফৗর, আঙৗ গাওনৗ ফৗথায়নানৈ, যে নৗংছৗরৗ গাওছৗরনৗ ফুরায়ৈ মৗজাং, জ্ঞানাও পরিপূর্ণ আরৗ গাওজৗং গাও ফৗরৗংনৗ উপযুক্ত জা। <verse eid="ROM 15:14" /><verse number="15" style="v" sid="ROM 15:15" />অব্লাবৗ আঙৗ নৗংখৌ ইছে বিষয়ৈ সাহসজৗং লৗগৗছে লিৎবায়, জাহাথে বেফৗরৗ নৗংখৌ আরবাওনৗ গৗসৗখাংহৗনৗ হায়ৗ, মানৗনা ঈশ্বৗরা আংনৗ অনুগ্রহখৌ হৗবায়, <verse eid="ROM 15:15" /><verse number="16" style="v" sid="ROM 15:16" />গুবুনহারিফৗরনি থাখৈ যীশু খ্রীষ্টনি সাছে সেবাকারি জানৗ। বিয়ৗ আংখৌ ঈশ্বৗরনি মৗজাং খবরখৌ প্রচার খৗলামনৗ যাজকনি বিবানখৌ হৗবায়, জাহাথে গুবুনহারিফ্রা গৗথার জিউনি গেজেরজৗং গৗথার জানানৈ ঈশ্বৗরনি গেজেরজৗং নাজাওথাও থাও জানৗ হায়ৗ। <verse eid="ROM 15:16" /><verse number="17" style="v" sid="ROM 15:17" />বিনিখাইনৗ আঙৗ ঈশ্বৗরনি সেবায়াও যীশু খ্রীষ্টখৌ মহিমা খৗলামৗ। <verse eid="ROM 15:17" /><verse number="18" style="v" sid="ROM 15:18" />খ্রীষ্টআ গুবুনহারিফৗরখৌ ঈশ্বৗর মানিগ্রা খৗলামনৗ আংনি গেজেরজৗং যে ফুরা খৗলামবায় বেখৌ নাগারনান আঙৗ জেবৗ বুংনৗ সাহস খৗলামনায় অৗঙা, জাইনি গেজেরজৗং আং বুংবায় আরৗ মাওবায়। <verse eid="ROM 15:18" /><verse number="19" style="v" sid="ROM 15:19" />চিহ্ন আরৗ বৗথিয়াগৗনাং বৗলৗনি গেজেরজৗং, ঈশ্বৗরনি গৗথার জিউনি বৗলৗনি গেজেরজৗং। বিনিখাইনৗ যিরূশালেমনি ফ্রায় ইল্লুরিকা সিম আঙৗ ফুরায়ৈ খ্রীষ্টনি মৗজাং খবর প্রচার খৗলামবায়। <verse eid="ROM 15:19" /><verse number="20" style="v" sid="ROM 15:20" />আংনি জেব্লাইবৗনি ইচ্ছায়া বেনৗ, যে জায়গাও খ্রীষ্টখৌ মিথিজায়াখৈ বেহা মৗজাং খবরখৌ প্রচার খৗলামনৗ, জাহাথে আঙৗ গুবুন ছৗরনিবা ভিঠানি ছায়াও লুখাংজায়া বাদি। <verse eid="ROM 15:20" /><verse number="21" style="v" sid="ROM 15:21" />বরং, জেরৈ লিৎনায় দং, “জাইফৗরখৌ বিনি বিষয়ৈ বুঙা জায়াখৈমৗন বিছৗরৗ নুনৗ মৗননায় আরৗ জাইফ্রা খৗনায়াখৈমৗন বিছৗরৗ বুজিনায়<note caller="+" style="x"><char style="xo" closed="false">15:21 </char><char style="xt" closed="false"><ref loc="ISA 52:15">যিশাইয় 52:15</ref></char></note>।” <verse eid="ROM 15:21" /><verse number="22" style="v" sid="ROM 15:22" />বিনিখাইনৗ নৗংছৗরনিয়াও ফৈনৗ আংখৌ হেংঠা হৗনায় জাদৗং<note caller="+" style="x"><char style="xo" closed="false">15:22 </char><char style="xt" closed="false"><ref loc="ROM 1:13">রোমীয় 1:13</ref></char></note>।<verse eid="ROM 15:22" /></para>
  <para style="s">পৌলনি রোময়াও থাংনায়নি পরিকল্পনা</para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 15:23" />নাথায় দা বে হাদৎনাও আংহা খামানি মাওনৗ যেহেতু মৗংবৗ জায়গা গৈলে, বিনিখাইনৗ আঙৗ গৗবাং বৗছৗরনিফ্রায় নৗংছৗরখৌ নায়নৗ বিরাঠ গৗসৗ জাদৗং। <verse eid="ROM 15:23" /><verse number="24" style="v" sid="ROM 15:24" />আং স্পেনাও থাংনায় সমাও বেখৌ মাওনৗ সানদৗং। আঙৗ ইছে সমনি থাখৈ নৗংনি লৗগৗফৗরজৗং রংজাফানায়নি উনাও, বিজৗং থাংনায় সমাও নৗংজৗং নায়নৗ আরৗ বিহা আংনি যাত্রাও নৗঙৗ আংখৌ হেফাজাব হৗনৗ আশা খৗলামৗ। <verse eid="ROM 15:24" /><verse number="25" style="v" sid="ROM 15:25" />দা, জেখিয়া জায়ামানৗ, আঙৗ যিরূশালেমাও থাংদৗংছৈ বিহানি ফৗরবুনি মানসিফৗরনি সেবাও। <verse eid="ROM 15:25" /><verse number="26" style="v" sid="ROM 15:26" />মানৗনা যিরূশালেমনি গৈজায়ি ফৗরবুনি মানসিফৗরনৗ থাখৈ ম্যাসিডোনিয়া আরৗ আখায়ানি বিশ্বাসিফ্রা দান খাংনৗ খুশি জাদৗং। <verse eid="ROM 15:26" /><verse number="27" style="v" sid="ROM 15:27" />বিছৗরৗ বিহা বেখৌ মাওনৗ খুশি মৗন, আরৗ থারৈনৗ বিছৗরৗ বিছৗরনিয়াও ঋণী। মানৗনা ঈশ্বৗরা যে আত্মিক মৗজাং জিনিসফৗরখৌ যিহূদীফৗরনৗ হৗয়ামৗন বেফৗরজৗং গুবুনহারিফ্রা ভাগিদার জাফাদৗং, অব্লা বিছৗরৗ যিহূদীফৗরনিয়াও ঋণী, যে ঈশ্বৗরা বিছৗরনৗ হৗনায় মৗদৗমনি মৗজাং জিনিসফৗরখৌ ভাগা রান্নানৈ লানৗ<note caller="+" style="x"><char style="xo" closed="false">15:27 </char><char style="xt" closed="false"><ref loc="2CO 9:1-13">2 করিন্থীয় 9:1–13</ref></char></note>। <verse eid="ROM 15:27" /><verse number="28" style="v" sid="ROM 15:28" />বেনিখাইনৗ আঙৗ বে খামানিখৌ ফুরা খৗলামনায়নি উনাও আরৗ নংথারগৌ যে বিছৗরৗ বে দান খাংনায়ফৗরখৌ নাজাওদৗং, আঙৗ স্পেনাও থাংনায় আরৗ লামায়াও নৗংজৗং লৗগৗ লানায়। <verse eid="ROM 15:28" /><verse number="29" style="v" sid="ROM 15:29" />আঙৗ মিথিগৌ যে আঙৗ জেব্লা নৗংনিয়াও ফৈনায়, অব্লা আঙৗ খ্রীষ্টনি আশীর্বাদনি ফুরা হিসাবমৈ ফৈনায়।<verse eid="ROM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30" />ফংবায় আরৗ বিনানাওফৗর, জৗংনি ফৗরবু যীশু খ্রীষ্টনি গেজেরজৗং আরৗ জিউনি অননায়নি গেজেরজৗং আঙৗ নৗংছৗরখৌ খাওলাইয়ৗ, আংনি থাখৈ ঈশ্বৗরনিয়াও প্রার্থনা খৗলামনানৈ আংনি সংগ্রামাও আংজৗং যোগ জাফাদৗ। <verse eid="ROM 15:30" /><verse number="31" style="v" sid="ROM 15:31" />প্রার্থনা খৗলাম জেন আঙৗ যিহূদিয়াও অবিশ্বাসীফৗরনিফ্রায় বাছাইনান থায়ৗ আরৗ বি দান খাংনায়ফৗরখৌ মৗননৗ আরৗ যিরূশালেমাও ফৗরবুনি মানসিফৗরা নাজাওজায়ৗ, <verse eid="ROM 15:31" /><verse number="32" style="v" sid="ROM 15:32" />জাহাথে ঈশ্বৗরনি ইচ্ছায়াও আঙৗ রংজানায়জৗং নৗংছৗরনিয়াও ফৈনৗ হানায় আরৗ নৗংছৗরজৗং লৗগৗয়াও টাটকা জানৗ হায়ৗ। <verse eid="ROM 15:32" /><verse number="33" style="v" sid="ROM 15:33" />শান্তিনি ঈশ্বৗরা নৗংছৗর বয়জৗংবৗ লৗগৗছে থাথৗং। আমেন।<verse eid="ROM 15:33" /></para>
  <chapter eid="ROM 15" />
  <chapter number="16" style="c" sid="ROM 16" />
  <para style="s">গাওনি গৗজৗন্নায় লাহৎনায়</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1" />জৗংনি বিনানাও ফৈবীখৌ কংক্রিয়াও দং মন্ডলীনি দৈদিনগিরিখৌ ছিনাইটি হৎছৈ। <verse eid="ROM 16:1" /><verse number="2" style="v" sid="ROM 16:2" />আঙৗ নৗংছৗরখৌ বুঙৗ যে ফৗরবুনিয়াও বিখৌ ঈশ্বৗরনি মানসিফৗরনি যোগ্য হিসাবমৈ নাজাওনৗ আরৗ নৗংছৗরনিফ্রায় জেবৗ হেফাজাব নাংগৌয়াও বিখৌ হেফাজাব হৗনৗ থাখৈ খাওলায়ৗ, মানৗনা বিয়ৗ গৗবাং মানসিফৗরনি থাখৈবৗ আরৗ আংনি থাখৈবৗ খামানিয়াও ফৈদৗং।<verse eid="ROM 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 16:3" />যীশু খ্রীষ্টনিয়াও আংজৗং মাওফাগ্রা প্রিষ্কিল্লা আরৗ আক্কিলাখৌ গৗজৗন্নায় হৗদৗ<note caller="+" style="x"><char style="xo" closed="false">16:3 </char><char style="xt" closed="false"><ref loc="ACT 18:2">প্রেরিত 18:2</ref></char></note>। <verse eid="ROM 16:3" /><verse number="4" style="v" sid="ROM 16:4" />বিছৗরৗ আংনি থাখৈ গাওছৗরনি জিউখৌ খৈফৗদনাও খৗখ্লাইদৗং। আং বান অৗঙা নাথায় গুবুনহারিফৗরনি গাছেন মন্ডলীফ্রাবৗ বিছৗরখৌ সাবাইখর হৗয়ৗ। <verse eid="ROM 16:4" /><verse number="5" style="v" sid="ROM 16:5" />বিছৗরনি ন্ব'য়াওনি মন্ডলীখৌবৗ গৗজৗন্নায় হৗ। আংনি আংগৗ লৗগৗ ইপেনিতখৌ গৗজৗন্নায় লা, জাইয়া এশিয়া হাদৎনাও গিবিয়াও খ্রীষ্টনিয়াও সৗলাইদৗং। <verse eid="ROM 16:5" /><verse number="6" style="v" sid="ROM 16:6" />মরিয়মখৌ গৗজৗন্নায় লা, জাইয়া নৗংছৗরনি থাখৈ গৗব্রাব খামানিখৌ মাওদৗং। <verse eid="ROM 16:6" /><verse number="7" style="v" sid="ROM 16:7" />আন্দ্রোনিকাস আরৗ জুনিয়াসখৌ গৗজৗন্নায় লা, জাইফ্রা আং বাদি যিহূদী আরৗ জাইফ্রা আংজৗং জৗবথেসালিয়াও দংমৗন। বিছৗরৗ প্রেরিতফৗরনি গেজেরাও মান গৗনাং, আরৗ বিছৗরৗ আংনি সিগাং খ্রীষ্টনিয়াও ফৈগ্রৗদৗং। <verse eid="ROM 16:7" /><verse number="8" style="v" sid="ROM 16:8" />ফৗরবুনিয়াও আংনি লৗগৗ আমপ্লিয়াতখৌবৗ গৗজৗন্নায় হৗ। <verse eid="ROM 16:8" /><verse number="9" style="v" sid="ROM 16:9" />খ্রীষ্টনিয়াও জৗংনি সহকর্মী ঊর্ব্বণখৌ, আরৗ আংনি আংগৗ লৗগৗ স্তাখুকখৌ গৗজৗন্নায় লা। <verse eid="ROM 16:9" /><verse number="10" style="v" sid="ROM 16:10" />খ্রীষ্টনিয়াও ফৗথাইনান আনজাৎনাও গছংনান থানায় আপিল্লিকখৌ গৗজৗন্নায় হৗ, আরৗ জাইফ্রা আরিষ্টবুলনি ন্ব'খরনি মানসিফৗরখৌ গৗজৗন্নায় লা। <verse eid="ROM 16:10" /><verse number="11" style="v" sid="ROM 16:11" />যিহূদীফ্রা আং বাদি হেরোদিয়োনখৌ গৗজৗন্নায় লা। নার্কিসুসনি ন্বখরনি জাইফ্রা ফৗরবুনিয়াও দং বিছৗরখৌ গৗজৗন্নায় হৗ। <verse eid="ROM 16:11" /><verse number="12" style="v" sid="ROM 16:12" />ত্রুিফেনা আরৗ ত্রুুফোষা, জাইফ্রা ফৗরবুনিয়াও মাওখ্রুবমৗ বে হিন্জাওসাফৗরখৌ গৗজৗন্নায় হৗ। আংনি আংগৗ লৗগৗ পারর্সিসখৌ গৗজৗন্নায় হৗ, গুবুন সাছে হিন্জাওসা জাইয়া ফৗরবুনিয়াও গৗব্রাব মাওখ্রুববায়। <verse eid="ROM 16:12" /><verse number="13" style="v" sid="ROM 16:13" />ফৗরবুজৗং সাইখজানায় ফংবায় রুফাসখৌ আরৗ জাইয়া আংনি অছে বিমা বাদি বিখৌবৗ গৗজৗন্নায় হৗ, জাইয়া আংনিবৗ বিমা<note caller="+" style="x"><char style="xo" closed="false">16:13 </char><char style="xt" closed="false"><ref loc="MRK 15:21">মার্ক 15:21</ref> </char></note>। <verse eid="ROM 16:13" /><verse number="14" style="v" sid="ROM 16:14" />অ্যাসিনক্রিটাস, ফ্লেগন, হার্মিস, প্যাট্রোবাস, হারমাস আরৗ বিছৗরনি গেজেরজৗং গুবুন ফংবায় আরৗ বিনানাওফৗরখৌবৗ গৗজৗন্নায় লা। <verse eid="ROM 16:14" /><verse number="15" style="v" sid="ROM 16:15" />ফিলোগাস, জুলিয়া, নেরিয়াস আরৗ বিনি বিনানাও আরৗ অলিম্পাস আরৗ বিছৗরজৗং গাছেন ফৗরবুনি মানসিফৗরখৌ গৗজৗন্নায় লা। <verse eid="ROM 16:15" /><verse number="16" style="v" sid="ROM 16:16" />গৗথারৈ গাওজৗং গাও গৗজৗন্নায় লাজ্লাইদৗ। খ্রীষ্টনি গাছেন মন্ডলীফ্রা নৗংছৗরখৌ গৗজৗন্নায় লাহৎদৗং।<verse eid="ROM 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17" />বিদা-ফংবায়ফৗর আরৗ বিবো-বিনানাওফৗর, আঙৗ নৗংছৗরখৌ খাওলায়ৗ, জাইফ্রা গাওজ্লাইহৗয়ৗ, আরৗ নৗংছৗরনি লামাও হেংঠা লাবৗয়ৗ বিছৗরনিফ্রায় সাবৗদান থা, মানৗনা যে শিক্ষাখৌ নৗংছৗরৗ মৗনবায়, বিনি উল্ঠা বেফৗরৗ। আরৗ বিছৗরনিফ্রায় গৗজানাও থা। <verse eid="ROM 16:17" /><verse number="18" style="v" sid="ROM 16:18" />মানৗনা বেবাদি মানসিফ্রা জৗংনি ফৗরবু খ্রীষ্টনি সেবা খৗলামাখৈ, নাথায় বিছৗরৗ গাওছৗরনি উখৈনায়খৌসৗ সেবা খৗলামদৗং গৗদৈ খৗথাফৗর আরৗ চালাকিজৗং বিছৗরৗ গৗসৗ গুরৈ দায় গৈয়ি মানসিফৗরখৌ ছৗলৈয়ৗ। <verse eid="ROM 16:18" /><verse number="19" style="v" sid="ROM 16:19" />নৗংছৗরনি খৗথা মানিনায়খৌ সাফ্রৗমবৗ খৗনাবায়, বিনিখাইনৗ নৗংছৗরনি থাখৈ আঙৗ রংজায়ৗ। নাথায় আঙৗ নৗংছৗরখৌ লুবৈয়ৗ জেয়া মৗজাং বিহা জ্ঞানী জা আরৗ গাজ্রিনি বিষয়ৈ দায় গৈয়ি জা।<verse eid="ROM 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 16:20" />শান্তিনি ঈশ্বৗরা গৗখ্রৈ শয়তানখৌ নৗংছৗরনি আঠেং গাহায়াও গাগ্লিনায়। জৗংনি ফৗরবু যীশু খ্রীষ্টনি অনুগ্রহয়া নৗংছৗরজৗং লৗগৗছে থাথৗং।<verse eid="ROM 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21" />আংজৗং মাওফাগ্রা তীমথিয়, আরৗ আংনি লৗগৗ যিহূদীফৗর লুসিয়াস, যসোন আরৗ সোষিপাত্রআ নৗংছৗরখৌ গৗজৗন্নায় হৎদৗং।<verse eid="ROM 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 16:22" />আং তর্ত্তিয়, জাইয়া বে লাইজামখৌ লিৎদৗংমৗন, ফৗরবুনিয়াও নৗংছৗরখৌ গৗজৗন্নায় হৎদৗং।<verse eid="ROM 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 16:23" />গায়াসনি আলাসি সৗংনায়াও আং আরৗ বেহানি গাছেন মন্ডলীয়া রংজায়ৗ, আরৗ বিয়ৗ নৗংছৗরখৌ গৗজৗন্নায় লাহৎদৗং। নৗগৗরনি টাকা পয়সা আওথায়গিরি ইরাস্টাসআবৗ আরৗ আংনি ফংবায় কোয়ার্টাসআ নৗংছৗরখৌ গৗজৗন্নায় লাহৎদৗং। <verse eid="ROM 16:23" /><verse number="24" style="v" sid="ROM 16:24" /><note caller="+" style="f"><char style="fr" closed="false">16:24 </char><char style="ft" closed="false">খাইছে মেনাস্ক্রিপ্ঠ লিৎনায় দং-জৗংনি ফৗরবু যীশু খ্রীষ্টনি অনুগ্রহয়া নৗংছৗর সাফ্রৗমজৗংবৗ থাথৗং।</char></note><verse eid="ROM 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25" />আংনি মৗজাং খবর অনুজায়ৈ ঈশ্বৗরা নৗংছৗরখৌ বৗলৗগ্রা খৗলামনৗ হায়ৗ, বে বাথ্রায়া যীশু খ্রীষ্টনি বিষয়ৈ আরৗ বি রহস্য অনুজায়ৈ জেয়া গৗবাও সমনিফ্রায় থাখমাদৗং মৗন, <verse eid="ROM 16:25" /><verse number="26" style="v" sid="ROM 16:26" />নাথায় দা নুজাসাৎনায়া ঈশ্বৗরনি আদেশাও ভবিষ্যৎবানি শাস্ত্রয়াও অরাইবৗনি থাখৈ লিৎনায়নি গেজেরজৗং নুজাসাৎদৗং আরৗ মিথিবায়, জাহাথে গাছেন গুবুনহারিফ্রা আজ্ঞাকারি জায়ৗ বিয়ৗ ফৗথাইনায়জৗং ফৈয়ৗ। <verse eid="ROM 16:26" /><verse number="27" style="v" sid="ROM 16:27" />যীশু খ্রীষ্টনি গেজেরজৗং বি সাছে বান জ্ঞানী ঈশ্বৗরনি মহিমা জেব্লাইবৗ জাথৗং! আমেন।<verse eid="ROM 16:27" /></para>
  <chapter eid="ROM 16" />
</usx>