<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- Nuevo Testamento Kakataibo</book>
  <para style="h">2 Timoteo</para>
  <para style="toc1">Pablonëa Timoteo ubamitëkëan kirika</para>
  <para style="toc2">2 Timoteo</para>
  <para style="toc3">2 Tim</para>
  <para style="mt">PABLONËA TIMOTEO UBAMITËKËAN KIRIKA</para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="s">Pablonën Timoteo asabi ka</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />Pablo apóstol Jesucristonan ꞌikëa Diosan an kuë́ënkësabi okin xua ꞌixun kana anun tsóti Cristo Jesús kiasabiokin ꞌain.<verse eid="2TI 1:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="2TI 1:2" />ꞌËn nuibakë bëchikë Timoteo ꞌikë kana mi kain. Nukën Papa Dios ꞌimainun nukën ꞌIbu Jesucristo, an ka nuibakin kuë́ëni asabitanu mi ꞌimiti ꞌikën.<verse eid="2TI 1:2" /></para>
  <para style="s">Asabi ka kixun kati</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />Mi sinánkin kana Dios asabi ka kakin ënkima nëtë ꞌimainun ñantan ñukatin, ëx upiokin sinanki abi ñumëxunkë ixun kana, ën rarakama ꞌasokin aín.<verse eid="2TI 1:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="2TI 1:4" />Mi bëunan mëskukë a sinánkin kana ꞌitsaíira kuë́ënuxun mi istisa tani.<verse eid="2TI 1:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="2TI 1:5" />Kana sinani minmi upiokin sinánkë a, an ka min chichi Loida anpáin sinánkë ꞌiakëxa ꞌimainun kamina min tita Eunice, ꞌiasaribioki mixribi ꞌai kixun kana sinani.<verse eid="2TI 1:5" /></para>
  <para style="s">Jesusan banami upimi kana katëtima.</para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 1:6" />Usa ꞌain kana mi kain, aín kushi minu ꞌikë tsi rëkirukësa, an ka bënabutima ꞌikë, ꞌën mëkën minu nankëbëtan Diosan mi ꞌinan.<verse eid="2TI 1:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="2TI 1:7" />Diosan ka bëru ñushin rakuë nu ꞌinama ꞌikën, ꞌinankima ka bëru ñushin kushi anun nuibanani upiokin ñu ꞌai tsonun nu ꞌinankëxa.<verse eid="2TI 1:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="2TI 1:8" />Usa ꞌain kamina katëkima nukën ꞌIbu Jesucristo ñuianan ꞌën sipunu ꞌikënribi katëkima ñuiti ꞌain, ꞌimainun kamina upí bana Diosan ꞌinankë aín kushi ënë ñui tëmërakibi tënëti ꞌain.<verse eid="2TI 1:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="2TI 1:9" />Diosan ka nu iëmianan kuëanan uni aín ꞌuchañuma ꞌinun ꞌimiakëxa, ax ka nun ꞌakëma ꞌiakëxa, ax ka nu nuibakë ꞌimainun bëramabi nëtëtimoi tsóti ꞌiakëxa Cristo Jesús kupí.<verse eid="2TI 1:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="2TI 1:10" />An ka nu nuibakin pënëíira nukën ꞌIbu Jesucristo an nu ië́mikin ismiaxa, usa ꞌixun ka bamati kanankin xabanu upí bana, anun bamatimoi tsóti ꞌimiakëxa.<verse eid="2TI 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 1:11" />Diosan ka ꞌë ꞌinankëxa ënë bana ñuinu usa ꞌixun ka ꞌë xuaxa apóstol ꞌianan ñu ꞌunamikë ꞌinun.<verse eid="2TI 1:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="2TI 1:12" />A kupin kana ënë ñu inuti tëmërai katëtima. ꞌËn kana asérabi uimi karana katamëti kixun ꞌunani; ꞌimainun kana unanin an ka ꞌëx ami katamëtia ꞌunania ax utëkënti nëtë ꞌitamainun.<verse eid="2TI 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TI 1:13" />Kamina nuiti ꞌain upí bana ënuami bikë a, ꞌimainun kamina upioki sinani nuibanani tsóti ꞌain Jesucristomi katamëti ꞌiti ꞌain.<verse eid="2TI 1:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="2TI 1:14" />Bëru Ñunshin Upí nunu ꞌikë an mi ꞌakinkëxun kamina, upiokin ꞌain bana Diosan mi ꞌinan a upiokin bëruanti ꞌain.<verse eid="2TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15" />Min kaina ꞌuna, kamabi Asia nu ꞌikëkama ka ꞌë ëanxa, Figelo ꞌimainun Hermógenes.<verse eid="2TI 1:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="2TI 1:16" />Nukë́n ꞌIbu ka nuibati ꞌikën Onesíforo ꞌimainun aín aintsikama, an ka ꞌitsokin sipuokë ꞌikë uisaibi ꞌëmi katëkima ꞌë ꞌakianxa.<verse eid="2TI 1:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="2TI 1:17" />Usa ꞌain ka Roma ëmanu, nukukinshi tantikima barikin ꞌë mëraxa.<verse eid="2TI 1:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="2TI 1:18" />Nukën ꞌIbu ka mi mëramiti ꞌikën anunmi nuibananti, min kaina ꞌunan uitiokin kara ꞌë akianxa Éfesonuxun.<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="s">Jesucristona ꞌai suntaru upí ꞌiti</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />ꞌËn bëchikë, kamina ami kushiti ꞌain Diosan nuibakin mi Jesucristo kupí ꞌiëmikë ꞌai.<verse eid="2TI 2:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="2TI 2:2" />ꞌËn kiami ꞌitsaíira unin kuamainun kuakë a kamina, abë́mi nuibanankë uni an bëtsi ꞌunamisabi, okia aribi bëtsi uniribi ꞌunaminun unamiti ꞌain.<verse eid="2TI 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 2:3" />Miribi kamina akupi të́ëmërati ꞌain usai ꞌi kamina Jesucristonën suntaru upí ꞌiti ꞌain.<verse eid="2TI 2:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="2TI 2:4" />Uinu ꞌikë suntarunëbi ka unikaman ꞌakë ñu ꞌati sinanima, usa ꞌixun ka aín ꞌapu kuë́ëntanu ñu ꞌaia.<verse eid="2TI 2:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="2TI 2:5" />Usaribikin ka axa kuaikëkama, an usaia kuaiti nankë usai kushi kuaixuma aín ñu kananki bitima ꞌikën.<verse eid="2TI 2:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="2TI 2:6" />An naënu të́ëkin ñu ꞌapakë uni, an ka apain ꞌapakë ñu bimi tuaia bitsia.<verse eid="2TI 2:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="2TI 2:7" />Min kakë ënë kamina upiokin sinanti ꞌain, nukën ꞌIbun ka mikamabi ꞌunamiti ꞌikën.<verse eid="2TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8" />Kamina sinanti ꞌain Jesucristo, bamatankë baiskia ax ka David, ꞌapu ꞌia, aín rëbunki ꞌiakëxa, a upí bana kana ꞌën ñui.<verse eid="2TI 2:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="2TI 2:9" />Upí bana kupí kana tëmërai usa ꞌain ka manë risin ꞌakanankë uni ꞌakësa okin ꞌë tëkërëkaxa, ꞌaibi ka Diosan upí bana manë risin tëkërëkakëma ꞌikën.<verse eid="2TI 2:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="2TI 2:10" />A kupí kana kamabi ñu tënëin, a Diosan kaiskë unikamaribia ami katamëti ië́ti pënëíira nëtëtima Jesucristobë ꞌinun.<verse eid="2TI 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 2:11" />Ënën ka asérabi ꞌikën: abë bamai kananuna abë ribi tsóti ꞌain.<verse eid="2TI 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="2TI 2:12" />Tëmëraibi abë ꞌi kushi kananuna ꞌain nëtënu abë ꞌiti ꞌain, ꞌimainun ka uin kara ꞌën kana ainama ꞌai kia, anribi ka nu ꞌënama ka kixun kati ꞌikën;<verse eid="2TI 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="2TI 2:13" />Nux upí ꞌaimabi ka, a nubë upí ia ax ka kana unanima kima.<verse eid="2TI 2:13" /></para>
  <para style="s">Achúshi uni upiokin ñu më́ëkë</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14" />Ënë sinánkin kamina bëtsi unikama ësëkin Diosan ismainun kati ꞌain, ñúkanankë bana an ka uibi ꞌakinima kixun kati ꞌain. An ka kuakëxun unikama ꞌaisama oia.<verse eid="2TI 2:14" /></para>
  <para style="m">
    <verse number="15" style="v" sid="2TI 2:15" />Kamabi kamina an ñu më́ëkë achúshi unisa ꞌixun min ꞌakë ñukama Diosan upí isnun ꞌati ꞌain, achúshi uni të́ëkënëa akupi katëmisama ꞌitanun aín ñu më́ëti upiokin ꞌakësa ꞌitanun aín bana asérabi ꞌunamiki ñuiti ꞌain.<verse eid="2TI 2:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="2TI 2:16" />Ë nuxun ñuikë bana ꞌatima ꞌimainun upima bana kamina kuatima ꞌain, uix kara usai banaia, ax ka kamabi nëtën ñu ꞌatimanu pakëti nanëtia.<verse eid="2TI 2:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="2TI 2:17" />An ꞌatima okin bana ꞌunamikë ax ka an nami chëkimikë ꞌinsinsa ꞌikë. Usaribi okin ka Himeneo ꞌimainun Filetonën ꞌaxa,<verse eid="2TI 2:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="2TI 2:18" />an ka anun baiskiti ka asérabi ꞌinuakëxa kixun ꞌunamia usakin kakin ka ami katamëama ꞌinun rairi sinakasmamikin manumiaxa.<verse eid="2TI 2:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="2TI 2:19" />Aibi ka Diosan achúshi ñu shaikitanuma nankëxa, anu ka aín bana kuënëokëxa: «Nukën ꞌIbun ka uikama kara ainan ꞌikë kixun ꞌunania.» ꞌImainun ka «Kamabi an ꞌain anë rabikë a nukën ꞌIbu ꞌunania akaman ka ñu ꞌaisama ꞌati ënti ꞌikën.»<verse eid="2TI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20" />Achúshi xubu cha anu ka itsaíira ñukama kuri ꞌimainun kuríki ꞌakë ashima bëtsi i ꞌanan mapú ꞌakë ꞌikë; bëtsikama ka anu ñu upí ꞌakë ꞌikë, bëtsiribi ka anun kamabi ñu më́ëkë ꞌikën.<verse eid="2TI 2:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="2TI 2:21" />Ñu upí ꞌakë ꞌianan, añu ñubi akëma ꞌimainun nukën ꞌIbu kuë́ënkësabi oi ꞌikë, upiti ñu ꞌaisama ꞌaima ꞌianan ka añu ñubi ꞌakima ñu upí ꞌati ꞌikën.<verse eid="2TI 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22" />Ñu ꞌatima bënákama ꞌakë a kamina ëbianti ꞌain, a ꞌakima kamina ñu upí ꞌati bariti ꞌain, ami sinánti, nuibananti, upiti tsóti nuitu upí ꞌixun nukën ꞌIbu rabikë kamabë ꞌiti ꞌain.<verse eid="2TI 2:22" /></para>
  <para style="m">
    <verse number="23" style="v" sid="2TI 2:23" />Ñúkanankë a kamina kuatima ꞌain, kuatima ñushinki akë anua ka mëananti aia.<verse eid="2TI 2:23" /></para>
  <para style="m">
    <verse number="24" style="v" sid="2TI 2:24" />Nukën ꞌIbun uni ka mëanani nitima ꞌikën, usai ꞌima kamina kamabi unibë upí ꞌiti ꞌain. Ka ꞌiti ꞌikë bëtsi ꞌunamisabi ꞌimainun bënë́kima upiokin sinánkë,<verse eid="2TI 2:24" /></para>
  <para style="m">
    <verse number="25" style="v" sid="2TI 2:25" />min nuitu upí ꞌixun kaina bëtsi ꞌunamiki ësëkin kati ꞌain, usakin ꞌaia ka Diosan sinanakin këmëkima asérabi ñu upí ꞌanun ꞌamiti ꞌikën,<verse eid="2TI 2:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="2TI 2:26" />usai ꞌi ka akama ñunshin ꞌatimanën ñu ꞌaisama ꞌamikë a sinanati, a ëni uisokin kara akasia usakin akaskë anua chikíti ꞌikën.<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="s">Anun nëtë këñuti ñuikë</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />Ënëribi kamina ꞌunanti ꞌain, anun tëmërati nëtë ukëbë ka tëíira ñu ꞌiti ꞌikën.<verse eid="2TI 3:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="2TI 3:2" />Unikama ka ñu inanankëma, kurikishi kuë́ënkë, bëtsi samaíira ꞌimainun rabiakati, Dios ñui ꞌaisamai bananan, aín papa bana kuaisama tankë iti ꞌikën, bana sinankëma ꞌianan a rabikë ñumi kuaiti ꞌikën.<verse eid="2TI 3:2" /></para>
  <para style="m">
    <verse number="3" style="v" sid="2TI 3:3" />Ka bëtsi kuë́ënki kai nuibananima, këmëkin bana ñuikë ꞌiti ꞌikën, an akë ñu ka tënëtima ꞌikën, ka bana kuatima, ñu upí akë ami nishti ꞌikën.<verse eid="2TI 3:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="2TI 3:4" />Abë nikë an ka bëtsi ꞌatima oti ꞌikën, ka nuituñuma ixun ñu ꞌatima ꞌatishi kuë́ënti ꞌikën, an kuë́ënkë ñuishi ꞌakin ka Dios baritima ꞌikën.<verse eid="2TI 3:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="2TI 3:5" />Usa ꞌain ka atukamax kiti ꞌikën, kana Diosnan ai kibi ꞌatimati nikë kupí, unin upí istima ikën, usa unibë kamina nitima ꞌain.<verse eid="2TI 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 3:6" />A kaman ka usa ñu akë ixun xubunu atsinkin xanu kushimakama a parankin ꞌuchañu ikëbi, ꞌaisama ñu ꞌakin bëtsi bëtsi ñu amia.<verse eid="2TI 3:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="2TI 3:7" />Ka ꞌunantisa tania ꞌaibi ka uisaxubi asérabi a ꞌunanima.<verse eid="2TI 3:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="2TI 3:8" />Ënë Janes ꞌimainun Jambres nëan Moisés, usokin ꞌatima ka kakëxa usaribi okin ka uni ñu upí ꞌaisamatania. ꞌAkin ka uni ꞌain sinan ꞌaisama ixun ñu upí ꞌati sinanimá.<verse eid="2TI 3:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="2TI 3:9" />ꞌAibi ka aín ñu mëti ꞌakamati ꞌikën, usai ꞌia ka kamabi menuxu unin ꞌaisama ꞌunanti ꞌikën, usaribiti ka Moisés bana kuatima rabë́ uni a ribi ꞌiakëxa.<verse eid="2TI 3:9" /></para>
  <para style="s">Pablonëan Timoteo ashikin ësëa.</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />ꞌAibi kamina min ꞌën ꞌunamikë banakama upiokin ꞌunan, ꞌën usai tsóti kuë́ënkë, ꞌën ꞌati ñu, ꞌën sinan, ꞌën kuë́ënkë ꞌimainun ꞌën kushi anun tënëti.<verse eid="2TI 3:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="2TI 3:11" />Kamina unan uitiu okinshi kara ꞌë ñuianan tëmëramikin Antioquía ëma, Iconia, ꞌimainun Listra ëmanuxun ꞌaxa; ꞌaibi ka tëmëraiabi ꞌën ꞌIbun ënë ñu kamanua ꞌë iëmiaxa.<verse eid="2TI 3:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="2TI 3:12" />Nun kananuna asérabi ꞌunan, kamabi uni an upiti tsotisatankë an ka Cristo Jesús kupí tëmëramikë ianan ꞌatima okë ꞌiti ꞌikën.<verse eid="2TI 3:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="2TI 3:13" />ꞌAibi ka ꞌatima unikama ꞌimainun këmë unikama, parankin ꞌatima ñuira ꞌamikin parankë ꞌiti ꞌikën.<verse eid="2TI 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 3:14" />Min, kamina ënkima kamabi ñu ꞌunánkë ꞌa nuiti ꞌain, min kamina anumi sinanakë ꞌa ꞌunan. Uin kara mi ꞌunamiaxa kixun.<verse eid="2TI 3:14" /></para>
  <para style="m">
    <verse number="15" style="v" sid="2TI 3:15" />Ka sinan xura ꞌixubi kaina kirika upíira kuënëo ꞌunánkë, an ka mi ꞌunamikin iëmiti ꞌikë Cristo Jesusmi sinania.<verse eid="2TI 3:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="2TI 3:16" />Kamabi kuenëo bana ka Diosabia sinamikëxu kuënëo ꞌikën, ax ka upiokin ꞌunamianan anun sinanamiti ꞌikën, ꞌimainun ka anun ësëkin Diosan kuë́enkësoi upiti tsóti ꞌikën.<verse eid="2TI 3:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="2TI 3:17" />Kamabi Diosan unix ka ñu unan ianan upiti mënio kakë ixun ñu upí ati ꞌikën.<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />Dios ꞌimainun Cristo Jesús a pënëíira ꞌApuíira ai utëkënkin, bamakëma ꞌimainun bamakë, uisa kara oti ꞌikë, an ismainu kana mi kakin inani.<verse eid="2TI 4:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="2TI 4:2" />Kamina upí bana ñuiti ai, abi kamabi nëtën ꞌanun ꞌati nëtë ꞌanan anun ꞌatima nëtëribi ꞌati ꞌain, sinamikin kakin ësë́anan unamikin nuibati aín.<verse eid="2TI 4:2" /></para>
  <para style="m">
    <verse number="3" style="v" sid="2TI 4:3" />Anun unin bana upí kuaisama tanti nëtë ka uti ꞌikën, usa ꞌain ka an kuë́ëkënsa okinshi kuanun bana an unamiti ꞌitsaíira uni bariti ꞌikën.<verse eid="2TI 4:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="2TI 4:4" />Upí banami kasuanan ka bana ꞌaisama okin ñuia unin kuati ꞌikën.<verse eid="2TI 4:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="2TI 4:5" />ꞌAibi kamina min akë ñu bëruankakin ati ꞌain, tëmërakibi tënëkin kamina upí bana ñuikin min ñumëti upiokin ꞌati ꞌain.<verse eid="2TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6" />ꞌËn anun ñu xaroti ꞌakësoi ꞌinamëti ka ꞌuramatia; anun ꞌën bamati ka ꞌurama ꞌikën.<verse eid="2TI 4:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="2TI 4:7" />Kana upiti mëanani ꞌakanan, kana abati anu nukuti anu sënëa, usai ꞌikin kana ami sinanki a ënkëma ꞌain.<verse eid="2TI 4:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="2TI 4:8" />Bërí ka ꞌë kainia mañuti nukën ꞌibu, ax upí ꞌai ꞌuchañuma ꞌixun a nëtë ꞌinanti, ꞌëshi ꞌinankima uikaman kara ax utëkënti pënëíira a kainia aribi ꞌinanti ꞌikën.<verse eid="2TI 4:8" /></para>
  <para style="s">Ësai ësëakati</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />Bënëtishi kamina ꞌë isi uti ꞌai;<verse eid="2TI 4:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="2TI 4:10" />Demasnën ka ënë menu ꞌikë ñushi kuë́ënkin ꞌë rakabiani Tesalónica ëmanu kuanxa. Crescente, Galacia menu kuantamainu ka Tito Dalmacia menu kuankëxa.<verse eid="2TI 4:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="2TI 4:11" />Lucasnëshi ka ꞌëbë ꞌikë, usa ꞌain kamina Marcos an ꞌë ñumëti ꞌakinu bari bëtsinki ukin bëti ꞌain.<verse eid="2TI 4:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="2TI 4:12" />Tíquico kana Éfeso ëmanu xua.<verse eid="2TI 4:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="2TI 4:13" />Ukin kamina, anun mápukë ëbëtsinkë Tróade ëmanu ikë Carpo ꞌain xubu ëbëtsinkë a ꞌë bëxunti ꞌain, kirika kuënëokë, a ꞌimainun pergaminokama<note caller="+" style="f"><char style="fr" closed="false">4.13 </char><char style="ft" closed="false">Pergamino ka ñuina xaka anu kuënëokë iakëxa</char></note> ꞌë bëxunti ꞌain.<verse eid="2TI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14" />Alejandro an manë tëkë ami kamina bëruonkati ꞌain, an ka ꞌë aisama oxa; nukën ꞌIbun ka uisakin kara ꞌati usakibi a ꞌatima oti ꞌikën.<verse eid="2TI 4:14" /></para>
  <para style="m">
    <verse number="15" style="v" sid="2TI 4:15" />Mi ribi kamina ami bëruokati ꞌai, an ka nun ñuikë upí bana masoi atimati banaxa.<verse eid="2TI 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16" />Ëx ꞌitabati ꞌapukamanu nukutia ka uinbi ꞌë akiama ꞌikë; kamaxubi ka ꞌë ënkankëxa. Kana kaini Diosan ka uisabi atu otima ꞌikë.<verse eid="2TI 4:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="2TI 4:17" />ꞌAibi ka nukën ꞌIbu ꞌë ꞌakianxa, usakin aín kushi ꞌë inankëxun kana kamabi judioma uni ai bana kuakëma a ñuixua. Usa ꞌain ka nukën ꞌIbun paru ꞌinuan kuëbinua ꞌë chikianxa.<verse eid="2TI 4:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="2TI 4:18" />ꞌË ka chikinti ꞌikën, ñu ꞌatimanua ië́mikin, ka ꞌain nëtë naíkamëo upíira anu ka ꞌë banti ꞌikën, ¡Pënëíira ꞌai nëtëtimaoi ꞌikë! Ashi.<verse eid="2TI 4:18" /></para>
  <para style="s">Ashikin kati</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />Asabi kana kai Prisca, Aquila ꞌimainun Onesíforo aín aintsi kamari kain.<verse eid="2TI 4:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="2TI 4:20" />Erasto ka Corinto ëmanu tikiaxa, Trófimo kana ꞌinsinkë Mileto ëmanu ëbëtsia.<verse eid="2TI 4:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="2TI 4:21" />Bënëtishi kamina mitakëma ꞌainshi uti ꞌai, asabi ka kixun Eubulo, Pudente, Lino, Claudia ꞌimainun nukën xukëantukama kain.<verse eid="2TI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22" />Nukën ꞌIbu Jesucristo ka mibë ꞌiti ꞌikën. Diosan ka mikama ꞌitsaíira ꞌakinti ꞌikën.<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>