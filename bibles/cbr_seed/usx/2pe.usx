<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2PE" style="id">- Nuevo Testamento Kakataibo</book>
  <para style="h">2 Pedro</para>
  <para style="toc1">Pedronëan anribi ubuamitëkëan kirica</para>
  <para style="toc2">2 Pedro</para>
  <para style="toc3">2 Ped</para>
  <para style="mt1">Pedronëa anribi ubamitëkëan kirika</para>
  <chapter number="1" style="c" sid="2PE 1" />
  <para style="s">Pedro asabi ka kia</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 1:1" />ꞌËx Simón Pedro, Jesucristonën apostol ꞌianan, aín bana upioki ñuikë ꞌixun kana mi kain, Dios ꞌimainun an nu ië́mikë Jesucristo, an ka upí ꞌixun nux ami katamënu ꞌimiaxa.<verse eid="2PE 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2PE 1:2" />Kamina biti ꞌain kamabi nëtën ꞌitsaíira upí tankin Diosan ꞌakinkëxun asabi kakin, nun ꞌIbu Jesucristo aribi ꞌunánti ꞌain.<verse eid="2PE 1:2" /></para>
  <para style="s">Dios kuë́ënkësabi oi tsóti</para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 1:3" />Diosan ka aín kushi, anun tsónu nu ꞌinankëxa, ꞌimainun ka kamabi nëtën rabi tsóti nu ꞌimiaxa, usa ꞌain ka an nu kuënkin an ñu mëa chaíira a nu ꞌunamiana. Aín nëtë pënë́iira upíira anu ꞌinun nu ꞌimiti ꞌikën.<verse eid="2PE 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2PE 1:4" />Ënë ñukama kupin ka ax kiasabi okin nu ꞌinanxa, kupíira ꞌimainun chaíira a kupin mitsux Dios saribi ꞌi ñu ꞌatimanuax chikikin ënë menu ꞌikë ñu ꞌatimakama ënun.<verse eid="2PE 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2PE 1:5" />Usa ꞌain ka ami kushikin sinankë an upí ꞌixun; upiokin kuakë an nu unamikëx, upiti tsóti ꞌikë;<verse eid="2PE 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2PE 1:6" />upiokin kuakin unanki aisa tankinbi tënëkë; an ka abi tënëti ꞌikë, tënëkë an ka upiokin ꞌakë a bënëkima munu ꞌati unamia;<verse eid="2PE 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2PE 1:7" />munu akë an ka nu bëtsi nuibati unamia; kuë́ëni kamabi nuibananu Cristona ꞌai.<verse eid="2PE 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 1:8" />Mitsun nun ꞌIbu Cristo ꞌunánkë ꞌixun kamina ënë ñu kama ꞌati ꞌain. ꞌakin kamabi nëtën upiokin ꞌunani kamina, upiti tsóti ꞌain.<verse eid="2PE 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2PE 1:9" />ꞌAibi ka uin cara usokin ꞌaima ax ka bëxuñu ꞌiana uria ꞌiskëmasa ꞌixun; manukin ꞌën ꞌuchakëkama bërama a ka tërë́nkë ꞌikë kixun sinanima.<verse eid="2PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 1:10" />Usa ꞌain kamina ꞌën xukëantu Diosan ka mi kuëanan kaisaxa, kixun sinani mitsux ami kushi nipakëtima ꞌain.<verse eid="2PE 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2PE 1:11" />Usa ꞌain ka rabë́ rabë́ xëokakë xëkuë anun naíkamëonu kuanti an nu ꞌiëmikë nukën Ibu Jesucristo.<verse eid="2PE 1:11" /></para>
  <para style="s">Asérabi ꞌunanti bana</para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 1:12" />Mi kana ënkima ꞌunánkë ꞌikëbi sinami, ënë ñukama ꞌunánkë ꞌai asérabi anubi ꞌiti ꞌain.<verse eid="2PE 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2PE 1:13" />ꞌËn tsokëpan ꞌixun kana ënë ñukama sinamiki ësëti ꞌain.<verse eid="2PE 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2PE 1:14" />Nukën ꞌIbu Jesucristonën ka ꞌë ꞌunamiaxa bënëkinshi kana anun tsóti ënti ꞌain;<verse eid="2PE 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2PE 1:15" />ꞌaibi kana ënkima ënë ñukama ꞌain ꞌëx bamakëbëtan sinanun.<verse eid="2PE 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 1:16" />Usa ꞌain kana aín kushi ꞌimainun nukën ꞌIbu Jesucristo utëkënti mi ꞌunamia, këmëkin sinanki ñuikima asérabi, nukën bërunbi iskë a ñuian.<verse eid="2PE 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 1:17" />Nunbi kananuna ꞌisanan kuakën aín papa Diosan ꞌain kushi pënëíira ꞌinani kía bana kuakën, —Ënëx ka ꞌën bëchikë ꞌikë ꞌitsaíira kuë́ënkin nuibakë a ꞌikën.<verse eid="2PE 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2PE 1:18" />Nu kamabi kananuna naínua banaia kuakën, nukën ꞌIbubë kananuna aín bashi matá upíira anu ꞌiakën.<verse eid="2PE 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2PE 1:19" />Ënën ka asérabira profeta kía bana a ꞌikën, a banax ka achúshi tirí bëankibukënua pë́ëkia, ax ka pëkarakëbë ꞌispa<note caller="+" style="f"><char style="fr" closed="false">1.19 </char><char style="ft" closed="false">Ispa ka kia Jesucristo ñui.</char></note> min nuituax pë́ëkikësa ꞌikën.<verse eid="2PE 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2PE 1:20" />Aibi kamina ënë ñukama sinanti ꞌain: uinu ꞌikë banabi ka abi sinankin kuënëoma ꞌikën. <verse eid="2PE 1:20" /><verse number="21" style="v" sid="2PE 1:21" />Uinu ꞌikë profetanëxi ka abi sinani banama ꞌikën. Usai ꞌima ka, atux Diosan imikësa oishi banakëxa, atux ka Bëru Ñunshin Upitan imikë ꞌiakëxa.<verse eid="2PE 1:21" /></para>
  <chapter eid="2PE 1" />
  <chapter number="2" style="c" sid="2PE 2" />
  <para style="s">Këmëki an ꞌunamikë unikama</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 2:1" />Anu ka këmëkin an bana ñuikë profetakamaribi Israel unikamanu ꞌiakëxa, usa ꞌain ka an këmëkin bana ñuikin ꞌunamikë mitsunu ꞌiti ꞌikën. Atun ka min ꞌunanumaishi bana ñuikin bëtsi bana anumi tëmërati anu ꞌimiti ꞌikën, usakin ꞌakin ka an nu ië́mia nukën ꞌIbu ax ꞌisa këmë ꞌikë kixun kati ꞌikën, usai kikë anunbi ka atux tëmërati ꞌikën.<verse eid="2PE 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2PE 2:2" />ꞌItsaíira unin ka an akë ꞌatima ñu abi nuikin ꞌati ꞌikën, atu kupin ka ꞌatimati upí bai a ñui, ax ka asérabima ꞌikë kia banati ꞌikën.<verse eid="2PE 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 2:3" />An kurikishi kuëënkë, an ka mitsu ꞌunamiki paranti ꞌikën; ꞌainbi ka a unikama uisai kara tëmërati ikë an atu kainia, usa ꞌain ka anun tëmërati an bëramabi nan ꞌixun kainia.<verse eid="2PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2PE 2:4" />Diosan ka ángelkama ꞌuchakë a aín ꞌucha tërëama ꞌikë, ꞌakima ka manë tsi bëankibukë anu niakëxa, manë risi tëkërëkaxu ëankëxa anubi ꞌinun.<verse eid="2PE 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2PE 2:5" />Usaribikin ka Diosan nëtë xëni aín ꞌucha kupí ꞌakëxa, usaki ꞌakima ka baka chaíira uni ꞌaisama kama këñunu ꞌëmiakëxa, ꞌimainun ka Noé, an upiti tsóti ñuixunkë a, ꞌimainun mëkën achúshi këñu rabë́ unishi ië́miakëxa.<verse eid="2PE 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2PE 2:6" />Diosan ka Sodoma ꞌimainun Gomorra ëma, aín chimapushi ꞌitanu nëankëxa, ax ka usaribi okin ka uni ꞌatimakama ꞌati ꞌikën.<verse eid="2PE 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2PE 2:7" />ꞌAinbi ka Diosan Lot axa achúshi uni upí ꞌikë ië́miakëxa, ax ka anu ꞌikë unikama ñu ꞌatima ꞌaia isi masá sinani itsaíira tëmërakëxa.<verse eid="2PE 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 2:8" />Lot ax ka upí uni ꞌaish atubë tsóakëxa, ax ka aín nuitu mëu ñu ꞌatima unin ꞌaia isanan kuati tëmërai tsoakëxa.<verse eid="2PE 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2PE 2:9" />Nukën ꞌIbun ka ami katamëkë unikama uisa ñu kara ꞌikëbëtanbi akinti ꞌikë kixun ꞌunania, ꞌainbi ka an ñu ꞌatima ꞌakëkama anun tëmërati nëtë utamainun ënti ꞌikën.<verse eid="2PE 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 2:10" />Nukën ꞌIbun ka tëmëramiti ꞌikë, kamabi an kuë́ënkë ñu atima akëkama. ꞌImainun an bana kuakima ꞌain kushi timakin ñu ꞌati kuë́ënkë ianan iskëma bëruñunshi kushi kamami rakuëtima kuaikë a tëmëramiti ꞌikën.<verse eid="2PE 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2PE 2:11" />Usa ꞌain ka ángelkaman atux kushíira ꞌaibi, nukën ꞌIbun ismainun kushikama a ñui atimati banaima.<verse eid="2PE 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 2:12" />Ënë unikama ka ñuinasa ixun kuatima, usa ꞌaish ka ñuina sinanimaishi bakënía unin bixun akësa inun; aibi ka kuatimabi banai ñu atima akë anubi bamai këñutia.<verse eid="2PE 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2PE 2:13" />Min bëtsi tëmëramikë usaribiti kamina tëmërakani. ¡Usai ibi kaina ñu upí akësa inun xabanua kamabi netën kuë́ënin. Usa aish ka katë́ ꞌimainun chaniokë ꞌikën, atubëmi timë́kë ax ka këmë ꞌikën!<verse eid="2PE 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2PE 2:14" />Usa ꞌixun ka xanu kuë́ëntisa tanki isia; a kupin ka tantima ꞌuchaia, usa ꞌixun ka këmëti ꞌunaira ꞌixun uni kushimakama parania, an ka ñu ñuira ꞌixubi ñu kuë́ënkë, ꞌatimakama a ꞌikën.<verse eid="2PE 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2PE 2:15" />Ka bai puntë ëni amami chikia nitsia, usa ꞌaish ka an bana ñuikë Balaam Beornën bëchikënën, kuríki kuë́ënkin ása usokin ꞌatima ñu ꞌaia.<verse eid="2PE 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 2:16" />Usa ꞌain ka ꞌain ꞌucha kupín ñukakësa okin kakëxa: achúshi ñuina chaa ax uni banakësari kushin banakin kakëxa, usa ꞌaibi ka upioki sinabiani kuama ꞌikë.<verse eid="2PE 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 2:17" />An këmëkin ñu ꞌunamikë atux ka kini aín ꞌumpax ëskikë usa ꞌikën: ꞌImainun ka suñu kushin, nëtë kuin ubankësa ꞌikën. Diosan ka anuaxa tëmërati bëankibukëira anu niti ꞌikën.<verse eid="2PE 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2PE 2:18" />Usa ꞌain ka axa uni parani ñankashi banakë ax këmë ꞌikën. Usai ꞌikin ka an kuëënkë ñu ꞌanun kixun ꞌësëkin, ꞌatima ñu ꞌanun kixun bëtsi parankin, ñu ꞌatima ꞌaia tëmërakë aín, ꞌuchakë ëinsa tankë a parania.<verse eid="2PE 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2PE 2:19" />Mi kana asérabi kain añu ꞌuchabi kamina inutima ꞌai, atunbi ka ñu ꞌaisama ꞌakibi aibika ënima. ꞌAinbi ka aín ñu ꞌatima ꞌakë anunbi këñuti ꞌikën, usa ꞌain ka kamabi uni, ax an ñu mëmikësa ꞌikën, usa aín ꞌuchakë ënima abi ꞌuchaia.<verse eid="2PE 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2PE 2:20" />Atux ka ñu ꞌatima ëni nukën ꞌIbu Jesucristomi sinani ië́axa, ꞌaibi ka ënë menu ꞌikë ñukama sinani bërama iasamaira ꞌinuxun ꞌatima ñu aia.<verse eid="2PE 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2PE 2:21" />Usa ꞌain ka atun, usai ꞌinuxun bai upí a ꞌunantima ꞌiaxa, a ꞌunantankëx ꞌatimati nitsi ami manútëkëntima kupin bana upíira a ꞌunantima ꞌiaxa.<verse eid="2PE 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2PE 2:22" />Këmëkima kana kai unikama ax ka asérabi kuënëo bana kikësai ꞌia: —ꞌUchitinën ka kinantankëxun aín kinan pitëkënia. Usaribiti ka kuchi ꞌianën chuatankëx amiribishi men ꞌitë́këni chubaia.<verse eid="2PE 2:22" /></para>
  <chapter eid="2PE 2" />
  <chapter number="3" style="c" sid="2PE 3" />
  <para style="s">Jesús anun utëkënti nëtë.</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 3:1" />ꞌËn nuibakë xukëantu, ënëx ka bëtsi pain inshaxun amiribishi inshatëkënkë kirika ꞌikën, a bana rabënubi kana mi ꞌësëkin upiokin sinamisatan, min mi upiokin sinanti kupí.<verse eid="2PE 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2PE 3:2" />Kamina unanti ꞌain Diosan kaiskë profetakama bëtsi nëtë bërama kia bana, kamina sinanti ꞌain; nukën ꞌIbu Jesucristo an nukë ꞌiëmikë ꞌain apostolkama ka bana a kamina sinanti ꞌain.<verse eid="2PE 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 3:3" />Ësoi ikin kamina ꞌunanti ꞌain: Ënë nëtëkama anun këñuti ꞌitamainun ka bëtsi unikaman ꞌaisama ñu ꞌatishi kuë́ënti ꞌikën, usakin ꞌai ka mitsumi kuaiti ꞌikën.<verse eid="2PE 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2PE 3:4" />Atux ka kananti ꞌikën: —¿Uisa kara Cristo ka utëkënti ꞌikë kia bana ax ꞌik? Nun papakama ka bamakëxa, ꞌaibi ka kamabi me unio ax ꞌiasabi ꞌikën.<verse eid="2PE 3:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="2PE 3:5" />A unikaman ka sinantisama tania bërama ka nëtë naí ꞌimainun me ꞌiakëxa, Diosan aín banainshi menua chikiña aish ka baka anu bëribi ꞌikën.<verse eid="2PE 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2PE 3:6" />Usa ꞌain ka a bakabi chaíira ë́kin kamabi me këñuakëxa;<verse eid="2PE 3:6" /></para>
  <para style="pi">
    <verse number="7" style="v" sid="2PE 3:7" />ꞌaibi ka naí ꞌimainun me barí anu bëribi ꞌikën, usa ꞌain ka Diosan banabi nan ai manë tsin këñuti ꞌikën, tsínbi ka në́nuxun ꞌaia, aín nëtë ꞌikëbëtan an ñu ꞌaisama ꞌakë kamakëñubi.<verse eid="2PE 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 3:8" />Usa ꞌain ën nuibakë xukëantu kamina manutima ꞌain, nukën ꞌIbun ka achúshi nëtë a mil barisa isia ꞌimainun ka mil baritia ax achúshi nëtësa ꞌikën.<verse eid="2PE 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2PE 3:9" />Nukën ꞌIbu anka ax kiasabi oí unuxun ꞌaia, ꞌaibi ka rairinën ka panatia kixun sinania, an ka bënë́kima kamabi unixa bamaima ꞌië́ti ka Diosnan kuëënia.<verse eid="2PE 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 3:10" />Anuan nukën ꞌIbu uti nëtë ka an ñu mëkamakë uni banaima ukësa kuatsini uti ꞌikën. A nëtën ka naí nëtëti ꞌikë achúshiti kushíira banakëbë ka anu ꞌikë kamabi ñu a tsin në́ënkë ꞌiti ꞌikën. Me ꞌimainun anu ꞌikë kamabi ñu ka Diosan nëtënki këñukë ꞌiti ꞌikën.<verse eid="2PE 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2PE 3:11" />Usa ꞌain ka kamabi ñu kë́ñuti ꞌikën, mitsux kamina ꞌuchañuma Dios rabi upí tsóti ꞌain.<verse eid="2PE 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 3:12" />Dios uti nëtë kananuna kainti ꞌai, usa ꞌain kamina mitsun bënëkin ñu upí ꞌakin kushiki kainti ꞌain, a nëtën ka kamabi naínu ꞌikë ñu këñubi tsi rëkirukë aín xananbi këñuti ꞌikën.<verse eid="2PE 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2PE 3:13" />Nukaman kananuna kainin naí ió ꞌimainun me ió ñuiki Diosan nukë ka a kaini, anu ka ñu ꞌaisama ꞌaima ꞌiti ꞌikën.<verse eid="2PE 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2PE 3:14" />Usa ꞌain ën nuibakë xukëantu, ënë ñu kainki kamina kamabi ñu Diosan iskëx upí isanan ꞌuchañuma nuibanani bukuti ꞌain.<verse eid="2PE 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2PE 3:15" />Kamina ꞌunanti ꞌain bënëkima, nukën ꞌIbu kainti an nu ië́miti, ënë bana ñuikinribi ka nukën xukën Pablonën Diosan sinamikëxun kirika kuënëoxunkin nu kaxa,<verse eid="2PE 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 3:16" />Pablonën ka ënë banakama ñuikin an kuënëo kirika kamanu nu kaxa, ꞌaibi ka rairi kirikanu nun kuaisama tëëira ꞌikën, usa kupin ka unin kuatima an ñu unama kupí bëtsiokin ñuixunia, ꞌimainun ka bëtsi kuënëo banaribi ꞌatimaki ñuixunia a kupin ka Diosan tëmëramiti ꞌikën.<verse eid="2PE 3:16" /></para>
  <para style="s">Pedronën këñua bana</para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 3:17" />Usa ꞌain, ꞌën nuibakë xukëantu mitsun kamina ënë ñukama ꞌunan, usa ꞌain kamina bëruankati ꞌain, paranki mitsu ñu atima amikëx min akë ñu a ëni min sinan kushima iti ꞌikën.<verse eid="2PE 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2PE 3:18" />Usa ꞌainbi kamina nun ꞌIbu Jesucristo an nu ië́mikë a unanti ꞌain, nuibanani cha inun kanikin. ¡Aín nëtë pënë́iira anu xënibua ꞌaibi abë ꞌiti ꞌain! Ashi.<verse eid="2PE 3:18" /></para>
  <chapter eid="2PE 3" />
</usx>