<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">22 - Nuevo Testamento Kakataibo</book>
  <para style="h">Mateo</para>
  <para style="toc3">Mt</para>
  <para style="toc2">Mateo</para>
  <para style="toc1">Mateonëan ꞌa upí bana</para>
  <para style="toc1">Mateonëan ꞌa upí bana</para>
  <para style="toc2">Mateo</para>
  <para style="toc3">Mt</para>
  <para style="mt">MATEONËAN ꞌA UPÍ BANA</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">Jesusan rarakama ꞌia</para>
  <para style="r">(<ref loc="LUK 3:23-38">Lc 3.23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />ꞌËnë kirikanëx ka Jesusan rarakama ꞌia ꞌikën, David ꞌimainun Abrahamnën rëbunki ka Jesucristo ꞌiakëxa. Jesucristonën rarakama ka ënë unikama ꞌiakëxa:<verse eid="MAT 1:1" /></para>
  <para style="li">
    <verse number="2" style="v" sid="MAT 1:2" />Abraham an ka Isaacnën papa ꞌiakëxa. Isaac ax ka Jacobnën papa ꞌiakëxa. Jacob an ka Judá ꞌimainun aín xukëantun papa ꞌiakëxa.<verse eid="MAT 1:2" /></para>
  <para style="li">
    <verse number="3" style="v" sid="MAT 1:3" />Judá an ka Fares ꞌimainun Zérah aín papa ꞌiakëxa, Tamar aín tita ꞌiakëxa. Fares an ka Esromnën papa ꞌiakëxa. Esrom an ka Aramnën papa ꞌiakëxa.<verse eid="MAT 1:3" /></para>
  <para style="li">
    <verse number="4" style="v" sid="MAT 1:4" />Aram an ka Aminadabnën papa ꞌiakëxa. Aminadab ax ka Naasonën papa ꞌiakëxa. Naasón ax ka Salmonën papa ꞌiakëxa.<verse eid="MAT 1:4" /></para>
  <para style="li">
    <verse number="5" style="v" sid="MAT 1:5" />Salmón an ka Booznën papa ꞌiakëxa, Rahab aín tita. Booz an ka Obednën papa ꞌiakëxa, Rut aín tita. Obed ax ka Isainën papa ꞌiakëxa.<verse eid="MAT 1:5" /></para>
  <para style="li">
    <verse number="6" style="v" sid="MAT 1:6" />Isaí an ka David, áxa ꞌapu ꞌi ë, aín papa ꞌiakëxa. David ax ka Salomonën papa ꞌiakëxa, aín titan ka Uriasnëan kasunan xanu ꞌiakëxa.<verse eid="MAT 1:6" /></para>
  <para style="li">
    <verse number="7" style="v" sid="MAT 1:7" />Salomón an ka Roboamnën papa ꞌiakëxa. Roboam ax ka Abíasnën papa ꞌiakëxa. Abías ax ka Asanën papa ꞌiakëxa.<verse eid="MAT 1:7" /></para>
  <para style="li">
    <verse number="8" style="v" sid="MAT 1:8" />Asa an ka Josafatnën papa ꞌiakëxa. Josafat ax ka Joramnën papa ꞌiakëxa. Joram an ka Uzíasnën papa ꞌiakëxa.<verse eid="MAT 1:8" /></para>
  <para style="li">
    <verse number="9" style="v" sid="MAT 1:9" />Uzías ax ka Jotamnën papa ꞌiakëxa. Jotam an ka Acaznën papa ꞌiakëxa. Acaz ax ka Ezequiasnën papa ꞌiakëxa.<verse eid="MAT 1:9" /></para>
  <para style="li">
    <verse number="10" style="v" sid="MAT 1:10" />Ezequías an ka Manasésnën papa ꞌiakëxa. Manasés ax ka Amónën papa ꞌiakëxa. Amón an ka Josiasnën papa ꞌiakëxa.<verse eid="MAT 1:10" /></para>
  <para style="li">
    <verse number="11" style="v" sid="MAT 1:11" />Anuan Israel unikama Babilonia nëtënu buanti ꞌurama ꞌain ka Josiasnën Jeconías ꞌimainun aín xukënkama bëchiakëxa.<verse eid="MAT 1:11" /></para>
  <para style="li">
    <verse number="12" style="v" sid="MAT 1:12" />Babilonianu unikama buankë ꞌixun ka Jeconíasnën Salatiel bëchiakëxa. Salatiel ax ka Zorobabelnën papa ꞌiakëxa.<verse eid="MAT 1:12" /></para>
  <para style="li">
    <verse number="13" style="v" sid="MAT 1:13" />Zorobabel an ka Abihudnën papa ꞌiakëxa. Abihud ax ka Eliaquimnën papa ꞌiakëxa. Eliaquim an ka Azornën papa ꞌiakëxa.<verse eid="MAT 1:13" /></para>
  <para style="li">
    <verse number="14" style="v" sid="MAT 1:14" />Azor ax ka Sadocnën papa ꞌiakëxa. Sadoc an ka Aquimnën papa ꞌiakëxa. Aquim ax ka Eliudnën papa ꞌiakëxa.<verse eid="MAT 1:14" /></para>
  <para style="li">
    <verse number="15" style="v" sid="MAT 1:15" />Eliud an ka Eleazarnën papa ꞌiakëxa. Eleazar ax ka Matanën papa ꞌiakëxa. Matán ax ka Jacobnën papa ꞌiakëxa.<verse eid="MAT 1:15" /></para>
  <para style="li">
    <verse number="16" style="v" sid="MAT 1:16" />Jacob an ka Josenën papa ꞌiakëxa. Josenën ka Maríanën bënë ꞌiakëxa, an ka Jesusan tita ꞌiakëxa. Jesucristo Mesías kakë a.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Abrahamnua kuanx ka David sënën aín rëbunki catorce ꞌiakëxa, Davidnua ka bëtsi non Babilonia nëtënu israelita unikama ubankë ka catorce ꞌain rëbunki ꞌiakëxa, anuax ka bëtsi catorce ꞌain rëbunki Cristo bakënti ꞌiakëxa.<verse eid="MAT 1:17" /></para>
  <para style="s">Jesucristo bakë́an</para>
  <para style="r">(<ref loc="LUK 2:1-7">Lc 2.1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Aín tita Jesucristo bakënti ka ësa ꞌiakëxa: María aín tita ax ka Josenën binuxun ꞌunanti okë ꞌiakëxa, abë́ ꞌisama pain ꞌaish nukën Papa Diosan Bëru Ñunshin Upitan ꞌimikëx túñu ꞌiakëxa.<verse eid="MAT 1:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="MAT 1:19" />José ax ka upí uni ꞌiakëxa, usa ꞌixun ka unë́xun María uibi kakima katëtima kupin ënti sinankëxa.<verse eid="MAT 1:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="MAT 1:20" />Usakin sinaniabi ka nukën ꞌIbu Diosan ángel achushinën namamikin José kakëxa: —José Davitan rëbunki rakuëkima kamina María min xanu ꞌinun biti ꞌain, aín tuá ax ka nukën Papa Diosan Bëru Ñunshin Upitan ꞌimikë túkë ꞌikën.<verse eid="MAT 1:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="MAT 1:21" />María bakënia, kamina aín tuá Jesús kakin anëti ꞌain. An ka kamabi uni aín ꞌuchanua iëmiti ꞌikën.<verse eid="MAT 1:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="MAT 1:22" />Diosan aín Profeta kasabi oi ka ꞌiakëxa:<verse eid="MAT 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="MAT 1:23" />—Xanu achúishi unibë ꞌikëma pain ꞌaish ka túñu ꞌitankëx bakë́nti ꞌikën. Aín tuá ax ka Emanuel kakin anëkë ꞌiti ꞌikën.</para>
  <para style="m" vid="MAT 1:23">Emanuel kikë ax ka Dios ka nubë ꞌikë kikë ꞌikën.<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />Namati bësukin ka nukën ꞌIbu Diosan ángelnën kakësabi oki Josenën María aín xanu ꞌinun biakëxa.<verse eid="MAT 1:24" /></para>
  <para style="m">
    <verse number="25" style="v" sid="MAT 1:25" />Unibë ꞌikëma pain ꞌaish, aín tita bakënkë ꞌikë ka, Josënën a tuá Jesús kakin anëakëxa.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">Bëtsi menuax ñu ꞌunánkë unikama Jesús isi kuan</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Herodes axa Judea kakë menu ꞌapu ꞌain ka Belén kakë ëma anuax Jesús bakë́ankëxa, Belenuaxa Jesús bakë́an ka amiaxa bari urukë anuax an ñu ꞌunánkë unikama, Belén ꞌurama ꞌikë Jerusalén ëmanu kuankëxa.<verse eid="MAT 2:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="MAT 2:2" />Kuani bëbakin ka ñukakëxa: —¿Uinu kara axa judíos unibunën ꞌapu ꞌinux bërí bakë́nkë a ꞌik? Amiaxa bari urukë anuxun kananuna anun a ꞌunánti ꞌispón isbëtsian. A isbëtsini kananuna rantin purinkin a rabi aín.<verse eid="MAT 2:2" /></para>
  <para style="m">
    <verse number="3" style="v" sid="MAT 2:3" />Usai kia a bana kuati ka Herodes ꞌimainun Jerusalénu ꞌikë unikama masá nuituti, uisa kara ënë ñu ꞌiti ꞌikë kia sinankasmakëxa.<verse eid="MAT 2:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MAT 2:4" />Usa ꞌain ka Herodesnën kamabi sacerdonën ꞌapu ꞌimainun an kuënëo bana ꞌunanmikë unikamaribi kamikë rikuatsianxa timëtia ñukakëxa: —¿Uinuax karaisa Mesías<note caller="+" style="f"><char style="fr" closed="false">2.4 </char><char style="ft" closed="false">Cristo ꞌimainun Mesías axka Diosan kaiskë kikë ꞌikën.</char></note> axa utia judíos unibunën kaínkë, a bakë́nti ꞌikë kixun?<verse eid="MAT 2:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="MAT 2:5" />Ñukakëxun ka kakëxa: —Belén kakë ëma Judea anuax ka bakënti ꞌikë ka profeta kiakëxa:<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />Belén Judá menu ꞌikë ëma, min kamina bëtsi ëma kamasama ꞌain, minua ka ꞌapu achúishi an Israel uni ꞌakinti chikiti ꞌikën.<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Kia kuatankëxun ka Herodesnën unëxun, amiaxa bari urukë anua ukë an ñu ꞌunánkë unikama añu nëtën kara ꞌispón isaxa kixun ñukati kuëankëxa.<verse eid="MAT 2:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MAT 2:8" />Usakin ñukatankëxun ka Herodesnën an ñu ꞌunánkë unikama Belenu xuakëxa. Xukin ka ësakin kakëxa: Anu kuanxun uinu kara a tuá ꞌikë kixun istankëxun kamina ꞌënribi rantinpurunki a rabi kuanun ꞌë kai uti ꞌain.<verse eid="MAT 2:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="MAT 2:9" />Usa kian Herodesnën kakëx; kuankëbë ka ꞌispón anua a unikama kuanti anubi kuankëxa. Kuanx ka anua a tuá ꞌikë a manámibi a ꞌispón nirakëakëxa.<verse eid="MAT 2:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="MAT 2:10" />A isi kuë́ënkiani ka anuan bari urukë amia ꞌispón isbiani an ñu ꞌunánkë unikama kuankëxa.<verse eid="MAT 2:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 2:11" />Kuanx a manámia ꞌispón nirakëkë xubu anu atsínxun ka anua a tuá Jesús aín tita Mariabë ꞌikë mërakëxa. Mërai rantinpuruni tsóbukin ka Jesús rabiakëxa. Rabikin ka atun bunánti bakáxun anua buánkë kuri ꞌimainun tsëpasa ñu ꞌaibi nëënkë sanuíira a ꞌimainun i baka sanuíira akama ꞌinánkëxa.<verse eid="MAT 2:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="MAT 2:12" />Usokian ꞌinánkë ka namámikin nukën Papa Diosan anua Herodes ꞌikë anun kuama ꞌinun kakëx bai itsin kuantankëx aín nëtënu bëbakëxa.<verse eid="MAT 2:12" /></para>
  <para style="s">Herodesnën tuakama këñu mia</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />An ñu ꞌunánkë unikamaxa aín menu kuantëkëan ka nukën ꞌIbu Diosan angelnën José namámikin kakëxa: —Herodesnën ka a tuá ꞌamiti bariminuxun ꞌaia. Usa ꞌain kamina aín titakëñun a tuá bibiani Egipto menu kuanti ꞌain. Kuantankëx kamina ꞌën mi kakë́ utëkënun anubi ꞌiti ꞌain.<verse eid="MAT 2:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 2:14" />Usokian nukën Papa Diosan kakëx nirukin aín titakëñun a tuá bibiani ka José imë́ Egipto menu kuankëxa.<verse eid="MAT 2:14" /></para>
  <para style="m">
    <verse number="15" style="v" sid="MAT 2:15" />Anu ka Herodes bamatamainun ꞌiakëxa. Nukën ꞌIbu Diosan ꞌamikëxuan profetanën kuënëosabi oi ka ꞌiakëxa, a bana ka ësai kia: “Egiptonua kana ꞌën Bëchikë bëan”.<verse eid="MAT 2:15" /></para>
  <para style="s">Herodesnën tuakama rëtënu ꞌamia</para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 2:16" />Usa ꞌain ka an ñu ꞌunánkë unikaman ka ꞌë paranxa, kia Herodes ꞌaisamairai niñakëxa. A kupin ka Herodesnën rabë́ baritiañu tuakama rëtënu ꞌamiakëxa.<verse eid="MAT 2:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="MAT 2:17" />Usakin ꞌakëbë ka profeta Jeremiasnën kuënëo bana kiásabi oi ꞌiakëxa. A bana ka ësai kia:<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />Ramá kakë ëmanuxun ka rarumati ꞌitsaíira inia kuakanxa. An ka Jacob ꞌimainun aín xanu Raquelnën rëbunki a xanukamaxa aín tuakën rabanan inkë ꞌiaxa. Aín tuá ꞌaíma kupí a sinani upí ꞌiisama tani ka uínbi nëtë́misamai ianxa.<verse eid="MAT 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Usa ꞌain ka Herodes bamá ꞌain Egiptonuxun namámikin José nukën ꞌIbu Diosan ángel achushinën kakëxa:<verse eid="MAT 2:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="MAT 2:20" />—Nirukianki aín tuakëñu aín tita bibiani kamina Israel menu kuantëkënti ꞌain. An a tuá ꞌaisa tankë unikama ka bamaxa. Usa ꞌain kamina kuantëkënti ꞌain.<verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />Usa ꞌain ka José aín titakëñun a tuá bibiani Israel nëtënu kuantëkëankëxa.<verse eid="MAT 2:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="MAT 2:22" />ꞌAibi ka Arquelao aín papa Herodes ꞌiasa Judea menu ꞌapu ꞌikë kixun kuati ka anu kuantimi rakuëakëxa, usai ꞌia Diosan namamikin kakëx ka Galilea menu kuantëkëankëxa.<verse eid="MAT 2:22" /></para>
  <para style="m">
    <verse number="23" style="v" sid="MAT 2:23" />Anu bëbatankëx ka Nazaret ëmanu tsóti bëruakëxa, ësai ka nukën Papa Diosan bana ñuikë profetakaman Jesús ka Nazarenu kakë ꞌiti ꞌikë kixun kuënëosabi oi ꞌiakëxa.<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">Juanën anu uni ꞌikëma Judea menuxun unikama bana ñuixuan</para>
  <para style="r">(<ref loc="MRK 1:1-8">Mr 1.1-8</ref>; <ref loc="LUK 3:1-9">Lc 3.1-9</ref>,<ref loc="LUK 3:15-17">15-17</ref>; <ref loc="JHN 1:19-28">Jn 1.19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />ꞌItsa baritia ꞌinukëbëtan ka anu uni ꞌikëma me Judea me anuxun Juanën unikama bana ñuixuankëxa.<verse eid="MAT 3:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="MAT 3:2" />Bana ñuixunkin ka Juanën ësakin kakëxa: —Anun sinanati nukën ꞌIbu Dios, naíkamëonu ꞌikë ami katamëti ka uaxa.<verse eid="MAT 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 3:3" />Juan an ka nukën ꞌIbu Diosan sinamikëxun añuikin profeta Isaiasnën kuënëo bana ax ka ësai kia: —Anu uni ꞌikëma menuax ka achushi bana munuma kuënkëkini kiakëxa. Nukën ꞌIbu ka aia, usa ꞌain kamina ax anun uti bai rakanakin mënioti ꞌain.<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Juanën chupa an ka camello xaká ꞌakë ꞌiakëxa, anuan ax tsitëkërëkikë an ka ñuina xaká ꞌa ꞌiakëxa, aín piti ka ꞌiakëxa kuruchinti ꞌimainun ninu ꞌikë buna rëpa ꞌiakëxa.<verse eid="MAT 3:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="MAT 3:5" />Jerusalénu ꞌikë unikama ꞌimainun Judea mekamanu ꞌikë unikamarabi ꞌimainun Jordán kakë baka ꞌurama ꞌikë unikamaribi ka rikiankëxa bana ñuia kuati.<verse eid="MAT 3:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="MAT 3:6" />Usai kia kuatia atun ꞌuchakama chikinatia ka Juanën Jordán kakë bakanuxun nashimiakëxa.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />ꞌAibi ka Juanën ꞌaisamaíira fariseo unikama ꞌimainun saduceo unikama, an nashiminu kuania isakëxa iskin ka kakëxa: —¡Runun rëbunki! ¿Uin kara mitsu anun nukën Papa Diosan mitsu tëmëramiti nëtë ka aia kixun mitsu kax?<verse eid="MAT 3:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MAT 3:8" />Mix upiti tsókë ax ka asérabi nukën ꞌIbumi katamëkë ꞌiti ꞌikën,<verse eid="MAT 3:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="MAT 3:9" />Mikaman kamina bëtsi katima ꞌain: “¡Nukamax kananuna Abrahamnën rëbunki ꞌain!”. Asérabi kana mi kain, ꞌaisatankin ka Diosan ënë maxakama Abrahamnën bëchikë ꞌimiti ꞌikën.<verse eid="MAT 3:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="MAT 3:10" />ꞌImainun ka ñamiribi anun ꞌi aín tapun këñubi tëati uramashi ꞌikën. Kamabi ꞌi an upiokin tuakëma kamaribi ka tëatankëxun tsinu puti ꞌikën.<verse eid="MAT 3:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 3:11" />ꞌËn kana asérabi ꞌumpaxan mitsu nashimi sinánatimi nukën Papa Diosnan ꞌiti kupí; ꞌainbi ka ꞌësamaira ꞌë kaxu ukin aín Bëru Ñunshin Upí ꞌimainun tsi rëkirukë anun mi nashimiti ꞌikën. An ka ꞌësamaira ꞌaish kushíira ꞌikën, usa ꞌain kana aín taxakabi uanxuntima ꞌain.<verse eid="MAT 3:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="MAT 3:12" />An ka a ñu ꞌapakë unisa ꞌai aia anun trigo takakin aín ënxë upibu biti tuibëtsini aia, usa ꞌixun ka takakin aín ënxë upibu bitankëxun bukunia. An ka usa okin ꞌakin aín xaká bukunatankëxun manëtsi uinsarabi bënatima oi rëkirukë anu putia.<verse eid="MAT 3:12" /></para>
  <para style="s">Jesús nashimi ꞌia</para>
  <para style="r">(<ref loc="MRK 1:9-11">Mr 1.9-11</ref>; <ref loc="LUK 3:21-22">Lc 3.21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Usa ꞌain ka Galilea me anuax kuanx Jesús Jordan, kakë baka anu Juanën nashiminu kuankëxa.<verse eid="MAT 3:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 3:14" />Kuanxa bëbaiabi ka Juanën nashimisama tankin Jesús kakëxa: —¿Miinra ꞌë nashimisa ꞌaishbi kaina ꞌën mi nashiminun kiax aín?<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Kakëxunbi ka Jesusan kakëxa: —ꞌËmi nashimiti ka asabi ꞌikë. Uisai kara nukën Papa Dios kia usai kanuna ꞌiti ꞌain. Kakëxun ka Juanën kana mi ꞌati ꞌain kixun Jesús nashimiakëxa.<verse eid="MAT 3:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 3:16" />Usakin Juanën nashimikë kuankin ka Jesusan naikamëo panarabëtia isakëxa. Iskibi ka Diosan Bëru Ñunshin Upí ñumakurutina aía isakëxa.<verse eid="MAT 3:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="MAT 3:17" />Usai ikëbëtan ka naínuaxa ësai ki banaia kuakëxa: —ꞌËnëx ka ꞌën amiira sinánkë bakë Bëchikë ꞌikën, ami sinani kana upíiratani kuë́ënin.<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">Ñunshin ꞌatimanën Jesús ꞌatima ñu ꞌamiti sinan</para>
  <para style="r">(<ref loc="MRK 1:12-13">Mr 1.12-13</ref>; <ref loc="LUK 4:1-13">Lc 4.1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Usa ꞌain ka nashimikë ꞌikë, aín Bëru Ñunshin Upí an Jesús anu uni ꞌikëma menu ubankëxa, anuxun ka ñunshin ꞌatimanën ꞌapun ñu ꞌatima ꞌamiti sinankëxa.<verse eid="MAT 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 4:2" />Anu ꞌixun ka Jesusan añu ñubi cuarenta ꞌimë́ ꞌimainun cuarenta nëtën. Ñu píima panankëxa.<verse eid="MAT 4:2" /></para>
  <para style="m">
    <verse number="3" style="v" sid="MAT 4:3" />Anu ukin ka ñunshin ꞌatimanën ꞌapun ñu ꞌatima ꞌamikatsi kixun ësakin kakëxa: —Asérabi Diosan Bëchikë ꞌixun kamina ënë maxákama piti ꞌimiti aín.<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Kakëxunbi ka Jesusan kakëxa: —Ësai ka kuënëo bana kia: “Piti píishi ka uni tsótima ꞌikën. Uisai kara Dios kia a bana ꞌairibi ka uni tsóti ꞌikën”.<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Usa ꞌain ka ñunshin ꞌatimanën Jesús Jerusalén ëma, anuxun ka xubu aín maskua sënënkënu ubaruakëxa.<verse eid="MAT 4:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="MAT 4:6" />ꞌImainun ka kakëxa: —Asérabi Diosan Bëchikë ꞌai kamina ënua shimú pakëti aín. Kuënëo bana ka ësai kia: “Diosan ka aín angelkama mi bëruamiti ꞌikën, maxánu tachakama inun ka aín mëkënan mi binun xuti ꞌikën”.<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Jesusan ka kakëxa: —Ësai ka kuënëo bana kia: “Nukën ꞌIbu Dios kamina tantima ꞌain”.<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Usotankëxun ka ñunshin ꞌatimanën amiribishi aín bashi chaírukë manan Jesús buánkëxa, En kana kamabi kushi ꞌimainun kamabi ënë nëtë nu ꞌikë chá ñukama inanti ai<verse eid="MAT 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="MAT 4:9" />Ka kakëxa: —Ën kana mi ꞌinanti aín kamabi ënë, min rantinpurunki ꞌë rabia.<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Jesusan ka kakëxa: —Ñunshin ꞌatima, ënuax ka kuantan. Kuënëo bana ka ësai kia: “Min ꞌIbu Dios kamina rabiti ꞌain. Rabikin kamina ax kuëënkësabi okin ñu ꞌaxunti ꞌain”.<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Usokian kakëx ka ñunshin ꞌatimanën ꞌapu Jesús ëbiani kuankëxa. Kuankëbëtan ka nukën Papa Diosan ángelkaman ukin Jesús ꞌakiankëxa.<verse eid="MAT 4:11" /></para>
  <para style="s">Jesusan atabakin Galileanuxun aín ñu mëti ꞌa</para>
  <para style="r">(<ref loc="MRK 1:14-20">Mr 1.14-20</ref>; <ref loc="LUK 4:14-15">Lc 4.14-15</ref>, <ref loc="LUK 5:1-11">5.1-11</ref>, <ref loc="LUK 6:17-19">6.17-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Usa ꞌain ka Juan, an uni nashimikë, a sipuokë kuabiani Jesús Galilea nëtënu kuantëkëankëxa.<verse eid="MAT 4:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="MAT 4:13" />Anua kuanx Nazaret ëmanu bëbatankëx ka parúmpapa rapasu ꞌikë ëma, Cafarnaúm<note caller="+" style="f"><char style="fr" closed="false">4.13 </char><char style="ft" closed="false">Capernaúm an ka Cafarnaún abi ikë.</char></note> anu tsóti kuankëxa. A me an ka Zabulón ꞌimainun Neftalí kakë uni aín rara anu tsoa me ꞌiakëxa.<verse eid="MAT 4:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 4:14" />Ësai ka ꞌiti ꞌikë kixuan profeta Isaiasnën kuënëosabioi ka iakexa:<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />—Zabulón ꞌimainun Neftalí menu ꞌikë Jordán baka ꞌukëmanan anun parunpapanu kuanti bai Galilea menu bukukë Judioma unikama anu ꞌikë.<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />A unikama ka bëankibukënu ꞌixubi achúshi xaba chaíira a, bamakësa ꞌixunbi pë́kaia ꞌisakëxa.<verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Bana ñuixunkin ka Jesusan ësakin kakëxa: —Sinanati nukën ꞌIbu Dios naíkamëonu ꞌikë ami katamëti ka ubaxa.<verse eid="MAT 4:17" /></para>
  <para style="s">Jesusan an tsatsa bikë uni rabë́ ꞌimainun rabë́ abë kuanun ka</para>
  <para style="r">(<ref loc="MRK 1:16-20">Mr 1.16-20</ref>; <ref loc="LUK 5:1-11">Lc 5.1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Parumpapa Galilea kuëtani kuankinbi ka Jesusan rabë́ uni mërakëxa. A uni rabëta ka achúshi Simón ꞌikëbi Pedroribi kakë, a ꞌimainun aín xukë́n Andrés kakë ꞌiakëxa. A rabë́ta an tsatsa bikë uni ꞌixuan tsatsa rikania ka Jesusan mërakëxa.<verse eid="MAT 4:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="MAT 4:19" />Mërakin ka Jesusan kakëxa: Tsatsa bikësaribi okin mi, uni binu mi ꞌunaminun ka ꞌëbë kuani ut.<verse eid="MAT 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 4:20" />Usakian Jesusan kakëxuinshi aín rika ëbiani ka abë́ kuankëxa.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />A uni rabë́ bibiani kuankinbi ka Jesusan bëtsi uni rabë́ribi, Zebedeonën bëchikë, Santiago ꞌimainun aín xukën Juan, an aín papa Zebedeobëtan nuntinuxun rika mëníoia mërakëxa mërakin ka.<verse eid="MAT 4:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="MAT 4:22" />Abë́ kuanun kakëxëshi ka nuntinu aín papa ëbiani Jesusbë kuankëxa.<verse eid="MAT 4:22" /></para>
  <para style="s">Jesusan ꞌitsa uni ꞌunamia</para>
  <para style="r">(<ref loc="LUK 6:17-19">Lc 6.17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Jesusan ka Galileanu ꞌikë ëma chukuma kamanu kuankin. Anua judiokama timëkë xubukamanu kuani, atsinxun unikama Diosan nëtënu ꞌiti upí bana ñuixuana bëtsi bëtsi ꞌinsinñu unikama pëxkuakëxa.<verse eid="MAT 4:23" /></para>
  <para style="m">
    <verse number="24" style="v" sid="MAT 4:24" />Usokian Jesusan aia iskin chanioia kuakin ka Siria nëtënu ꞌikë unikaman axa ñukëkama Jesusan pëxkunun kixun anu buánkankëxa. Bëtsi bëtsi ñukëkama ꞌimainun ñunshin ꞌatimanën ꞌibuakë unikama ꞌimainun uni ñukë nirukuainkinbi tankëma, ꞌimainun aín nami nimëti sakikikë akama anu uania ka Jesusan pëxkuakëxa.<verse eid="MAT 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 4:25" />Usokin bana ñuixuanan unikama pëxkubiania kuania ka ꞌaisamaira unin Jesús nuibiankëxa. Galilea menu ꞌikë unikama ꞌimainun Decapolis kakë menu ꞌikë unikama ꞌimainun Jerusalénu ꞌikë unikama ꞌimainun Judea mekamanu ꞌikë unikama ꞌimainun Jordán baka ꞌukëmanánuaribi ukë unikaman ka abë́ kuankin Jesús nuibiankëxa.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">Jesusan matanuxu ꞌunamia</para>
  <para style="r">(<ref loc="LUK 6:20-23">Lc 6.20-23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />ꞌItsaíira uni isi ka Jesús matánu kuanx tsobuakëxa. Tsobukëbë ka aín unikama a ꞌurama uakëxa.<verse eid="MAT 5:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="MAT 5:2" />Ukë ka ꞌësokin kakin ꞌunamiakëxa:<verse eid="MAT 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 5:3" />—Chuamarua tani kuë́ëni ka aín bëru ñunshin nuibakati Dios mi katamëkë an ꞌiti ꞌikën, atunan ka naíkamëonu ꞌiti ꞌikën.<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Chuamarua tani kuëënun ꞌimikë ka axa tëmërakë unikama an ꞌiti ꞌikën.<verse eid="MAT 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 5:5" />Chuamarua tani kuë́ëni ka mënisinan ñu unikama upí ꞌimikë ꞌiti ꞌikën, atun ka naínu ꞌikë me upíira ꞌa biti ꞌikën.<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Chuamarua tani kuë́ëni ka bana kuaisa tania ꞌakëñuma ꞌianan shimakësa ax puchati kuëënun ꞌimikë ꞌiti ꞌikën.<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Chuamarua tani kuë́ëni ka nuibanankë uni an ꞌiti ꞌikën, a unikama ka Diosan nuibairakë ꞌiti ꞌikën.<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Chuamarua tani kuë́ëni ka aín nuítu upí uni an ꞌiti ꞌikën, an ka Dios ꞌisti ꞌikën.<verse eid="MAT 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 5:9" />Chuamarua tani kuë́ëni ka upí ꞌinun an ënë menuxun ñu mëkë unikama ꞌiti ꞌikën, a unikama ka Diosan aín bëchikë kati ꞌikën.<verse eid="MAT 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 5:10" />Chuamarua tani kuë́ëni ka ñu upí ꞌaia unin ꞌatima okin ñuikë an, Diosan nëtë naíkamëonu ꞌiti ꞌikën.<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />Chuamarua tani kuë́ëni kamina mikama unian ꞌë kupin, ꞌaisama onan këmëi banakin bëtsi bëtsi okë an ꞌiti ꞌikën.<verse eid="MAT 5:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="MAT 5:12" />Kamina kuë́ëni asabi tani ꞌiti ꞌain, achúshi ñu chaíira kamina naínua biti ꞌain, usaribi okin ka an bana ñuikë profetakama ꞌatima okankëxa, mi ꞌisama pain ꞌain.<verse eid="MAT 5:12" /></para>
  <para style="s">Ënë menu ꞌikë tashi ꞌiti</para>
  <para style="r">(<ref loc="MRK 9:50">Mr 9.50</ref>; <ref loc="LUK 14:34-35">Lc 14.34-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />Mitsúx kamina ënë menu ꞌikë tashi ꞌiti ꞌain. ꞌAibi ka tashi aín muka ꞌunchati nëtëtia. ¿Uisarax kara amiribi mukatëkënti ꞌik? Usa ꞌain ka ꞌaisama ꞌia, unin ëman putia bëtsi unikaman amatia.<verse eid="MAT 5:13" /></para>
  <para style="s">Ënë menu ꞌikë tirí ꞌiti</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />Mitsux kamina ënë menu ꞌikë tirí ꞌain, achúshi ëma matánu ꞌikë an ka unë́tisama ꞌikën.<verse eid="MAT 5:14" /></para>
  <para style="m">
    <verse number="15" style="v" sid="MAT 5:15" />Uinbi ka tirí bimixun bunanti mëu nantima ꞌikën, nankinma ka kamabi pëkatanu manami nanti ꞌikën, kamabi xubunu ꞌikëa pëkatanu.<verse eid="MAT 5:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 5:16" />Usaribi ꞌixun kamina mitsun tirí ꞌixun kamabi unian isnun ñu upí ꞌati ꞌain, usakin upí ñu mitsun ꞌaia iskin ka kamabi unin min papa Dios naínu ꞌikë a rabiti ꞌikën.<verse eid="MAT 5:16" /></para>
  <para style="s">Jesusan Moisésnën kuënëo bana ꞌunamia</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />Kamina sinántima ꞌain, ꞌën kana Moisésnën bana ꞌimainun profetakama kuënëo bana këñui ubama ꞌain, usakin ꞌakinma ax kikësabi okin ꞌai kana ubakën.<verse eid="MAT 5:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 5:18" />Asérabi kana mi kain me ꞌimainun naí këñutisama ꞌain ka a bana achushirabi tërëkakëma ꞌiti ꞌikë, ꞌianan ka aín tsaka okë axí tërëkakëma ꞌiti ꞌikën, ax kiásabi oi ꞌitamainun.<verse eid="MAT 5:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="MAT 5:19" />Uin kara aín bana kuaisamatankin bëtsi uni ꞌunámima a ka chamara Diosan aín nëtë naíkamëonu ꞌimiti ꞌikën. ꞌAibi ka uin kara a bana kuakin usaribitia ꞌinun bëtsi uni ꞌunamia a Diosan aín nëtënu cha ꞌimiti ꞌikën.<verse eid="MAT 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 5:20" />ꞌËn kana mitsu kain, min fariseokama ꞌimainun an bana ꞌunánkë unikamasa ꞌikima, ñu upí ꞌakë ꞌaish kamina Diosan nëtë naíkamëonu ꞌiti ꞌain.<verse eid="MAT 5:20" /></para>
  <para style="s">Unimi nishtima Jesús kia</para>
  <para style="r">(<ref loc="LUK 12:57-59">Lc 12.57-59</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />Mitsun rara ñuixuan bana kamina ësai kikë kuakën: “Uni kamina ꞌatima ꞌain, uin kara bëtsi uni ꞌaia an ka tëmëramikë ꞌiti ꞌikën”.<verse eid="MAT 5:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="MAT 5:22" />ꞌAibi kana ꞌën mi kain, uix kara aín xukënmi nishia an ka tëmëramikë ꞌiti ꞌikën; uin kara bëtsi uni chichaia axribi ka ꞌapu kamanu bankë ꞌiti ꞌikën; ꞌimainun ka uin kara aín xukën ꞌatimaira okin ñuiña axribi manë tsinu nikë ꞌiti ꞌikën.<verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />Usa ꞌain kamina nukën Papa Dios ꞌinánti ñu ubanxun ꞌën xukën ka ꞌëmi nishaxa kixun sinánkin,<verse eid="MAT 5:23" /></para>
  <para style="m">
    <verse number="24" style="v" sid="MAT 5:24" />Nanti ꞌain, anu ñu nankë a ꞌurama nábiani kuantankëx min xukënbë mëniónakuatsini utankëxun kamina min uankë ñu a Dios ꞌinánti ꞌain.<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />Bëtsi unian mimi manankëma ꞌainshi kamina abë́ mëniónanti ꞌain, mia ꞌain kushinu ubankëma aínshi ꞌain kushi an ka mia sipuanun suntarukama inánti ꞌikën.<verse eid="MAT 5:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="MAT 5:26" />Asérabi kana mi kain anuax kamina min kuríki këñukin kupioibi chikitima ꞌain.<verse eid="MAT 5:26" /></para>
  <para style="ms">Xanu ꞌitsibë ꞌitima Jesús kia</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />—Mitsún rara ësai kia bana kamina kuakën: “Bëtsi unin xanubë kamina ꞌitima ꞌain”.<verse eid="MAT 5:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="MAT 5:28" />Usa ꞌainbi kana ꞌën mitsu kain, uin kara ꞌaisatankin xanu ꞌitsi isia ax ka aín nuitunën ami ꞌuchai abë́ ꞌikësa ꞌia.<verse eid="MAT 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 5:29" />Usa ꞌain kamina, min bëru mëkeu ꞌikë an mi ꞌuchamikëxun ëchixun ꞌura nanti ꞌain; ax ka min nami achúshi tëakësa ꞌiti ꞌikën, nami kamabi ñu ꞌaishmi manëtsinu tëmërai kuantima kupí.<verse eid="MAT 5:29" /></para>
  <para style="m">
    <verse number="30" style="v" sid="MAT 5:30" />Min mëkën mëkeu an mi ꞌuchamikëxun kamina tëaxun ꞌura nanti ꞌain, ax ka min mëkën achúshi tëakësa ꞌiti ꞌikën, min nami achúshi nëtëti ka asabi ꞌikën, kamabiñu ꞌaishmi manë tsinu tëmërai kuantima kupí.<verse eid="MAT 5:30" /></para>
  <para style="s">Jesús xanubë ënanantima kia</para>
  <para style="r">(<ref loc="MAT 19:9">Mt 19.9</ref>; <ref loc="MRK 10:11-12">Mr 10.11-12</ref>; <ref loc="LUK 16:18">Lc 16.18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />Ësairibi ka kia: Uix kara aín xanubë ënanania, an ka achúshi kiríka ꞌatankëxun ꞌinankin ënti ꞌikën, bërí ka ꞌën xanuma ꞌikë kixun kakin.<verse eid="MAT 5:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 5:32" />Usa ꞌaibi kana ꞌën mi kain, uni an aín xanu unibë ꞌikëmabi ënkë an ka aín xanu ꞌuchamia. Uni an bëtsin ën kë xanu bikë axribi ka ami ꞌuchaia.<verse eid="MAT 5:32" /></para>
  <para style="s">Asérabi banati Jesusan ꞌunamia</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />ꞌImainunribi kamina min rarakama ësai kia bana kuakën: A ꞌinanti ñu ubanxu kamina asérabi Dios ꞌinanti ꞌain.<verse eid="MAT 5:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="MAT 5:34" />ꞌAibi kana mi kain, asérabi kana banai kia kamina banatima ꞌain. Naítan kuamainun kana mi asérabi kain kia kamina banatima ꞌain. Naínu ka nukën Papa Dios ꞌikë a kupin.<verse eid="MAT 5:34" /></para>
  <para style="m">
    <verse number="35" style="v" sid="MAT 5:35" />Men kuamainun kana mi asérabi mi kain kia kamina banatima ꞌain, nukën Papa Diosan ka kamabi menu ꞌikë a kupin, Jerusalén ñuibi kamina kitima ꞌain. Ax ka ꞌapu chaíira aín nëtë ꞌikën.<verse eid="MAT 5:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="MAT 5:36" />Mitsun maxkaribi ñui kamina asérabi banatima ꞌain, uinbi ka aín bu tunan ꞌimianan uxua ꞌimitima ꞌikën.<verse eid="MAT 5:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MAT 5:37" />Mixmi asérabi kikë ax ka asérabi ꞌiti ꞌikën, mix asérabima kikë ax ka asérabima ꞌiti ꞌikën. Kamabi ëóra banakë ax ka ñunshin ꞌatimanuax aia.<verse eid="MAT 5:37" /></para>
  <para style="s">Uni bëtsibë kupianantima bana</para>
  <para style="r">(<ref loc="LUK 6:29-30">Lc 6.29-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />Mitsún rarakama ësai kikë bana kamina kuakën: bëtsi unin min bëru ꞌatima okëxun kamina aín bëruribi ꞌatima oti ꞌain. Bëtsin min xëta ꞌatimokëxun kamina aín xëtaribi ꞌatima oti ꞌain.<verse eid="MAT 5:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="MAT 5:39" />Usai kia ꞌainbi kana ꞌën mitsu kain: Mitsua unin ꞌatimokëxun kamina tanshiti ꞌain; min mëkënu bëtashkakëxun kamina amoribia mi bëtashkanun ꞌamiti ꞌain.<verse eid="MAT 5:39" /></para>
  <para style="m">
    <verse number="40" style="v" sid="MAT 5:40" />Uin kara mibë nishanankin min kutun bisa tania a kamina anunmi mapukë chupa aribi ꞌinanti ꞌain.<verse eid="MAT 5:40" /></para>
  <para style="m">
    <verse number="41" style="v" sid="MAT 5:41" />Bëtsi unian mi achúshi ꞌura ñu ubanun kakëxun kamina rabë́ ꞌura ubanti ꞌain.<verse eid="MAT 5:41" /></para>
  <para style="m">
    <verse number="42" style="v" sid="MAT 5:42" />Uin kara mi ñu ñukatia, a kamina ꞌinánti ꞌain, uin kara min ñu ꞌinan ishiti kuëënía a kamina ꞌinanti ꞌain.<verse eid="MAT 5:42" /></para>
  <para style="s">Axa mimi nishkë uni kamina nuibati ꞌain</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />Ësai kikë banaribi kamina kuakën: Axa mimi nishkë uni nuibakima kamina, axa mimi nishkëma unishi nuibati ꞌain.<verse eid="MAT 5:43" /></para>
  <para style="m">
    <verse number="44" style="v" sid="MAT 5:44" />Usai kia ꞌaibi kana ꞌën mi kain: Mimi nishkë uni nuibakin kamina an mi ꞌatima okë uni a nukën Papa Dios ñukaxunti ꞌain.<verse eid="MAT 5:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 5:45" />Usakin ꞌai kamina Dios naínu ꞌikë aín bëchikë ꞌiti ꞌain, an ka ꞌatima unikama ꞌimainun upí unikama pëkanun bari urumia; ꞌimainun ka uíribi uni ꞌatima ꞌimainun uni upikama ainaribi ꞌinun ꞌibumia.<verse eid="MAT 5:45" /></para>
  <para style="m">
    <verse number="46" style="v" sid="MAT 5:46" />An mitsu nuibakë unishi nuibakë ꞌixun karamina, ¿Añu ñu upí biti ꞌain? ¿An Romanu ꞌikë ꞌapu ubamiti kuríki bikë ax ribi ka usai ꞌia?<verse eid="MAT 5:46" /></para>
  <para style="m">
    <verse number="47" style="v" sid="MAT 5:47" />An mitsu nuibakë unibëshi kamina mitsux nuibanantima ꞌain, ¿Usa ꞌixun kaina añu biti ꞌai kixun kaina sinanin? ¿Usaribiti ka an Diosan bana kuakëma unikama ꞌia?<verse eid="MAT 5:47" /></para>
  <para style="m">
    <verse number="48" style="v" sid="MAT 5:48" />Mitsuxribi kamina upí ꞌiti ꞌain, nukën Papa Dios naínu ꞌikë axribi ka upíira ꞌikën.<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">Ñuñuma uni ꞌakinti Jesús kia bana</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />Min bëtsi uni ñu ꞌinánkin kamina ax ka upí uni ꞌikë kixuan bëtsi unin isnun ꞌatima ꞌain, usakin ꞌaiabi ka nukën Papa Dios naínu ꞌikë, an upí ñu nu ꞌinántima ꞌikën.<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />Usa ꞌain kamina uni ñuñuma ꞌakinkin uni itsi ñuixuntima ꞌain, uinbi isnuma kamina bëtsi uni an istisa kixun uni upisa ꞌaibi ꞌatimankaman ꞌakësokin ꞌatima ꞌain. Anu timëti xubunuxun ꞌanan ëman kuankin unin rabinu kixun ꞌatima ꞌain. Usakin ꞌakin kana ñu upí bitsi kixun ka sinánkania.<verse eid="MAT 6:2" /></para>
  <para style="m">
    <verse number="3" style="v" sid="MAT 6:3" />Mitsun min bëtsi uni ñuñuma ꞌakinkin kamina mix abë́ nuibanairakë unibi ñuixuntima ꞌain.<verse eid="MAT 6:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MAT 6:4" />Uinbi ꞌunánuma ꞌaia iskin ka min Papa Dios an ñu upí mi ꞌinánti ꞌikën.<verse eid="MAT 6:4" /></para>
  <para style="s">Usakin Dios ñukati Jesús kia bana</para>
  <para style="r">(<ref loc="LUK 11:2-4">Lc 11.2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />Mitsux ꞌën Papabë banai, kamina uni upisa ꞌaibi ꞌatimakama ꞌikësoi ꞌitima ꞌain. Atux ka anua Judío timëkë xubukama anuax banati kuënia ꞌimainun ka anu uni timë́kë anuax nitsax banati kuënia usai ꞌikin ka ñu upí kana ꞌai kixun sinánia, ꞌën kana mi kain usai ꞌikin. Ka ñu upí kana bitsi kixun sinánin.<verse eid="MAT 6:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="MAT 6:6" />ꞌAibi kamina mitsux nukën Papa Diosbë banai mix anu ꞌuxtinu atsini xëpukuti, nukën Papa Diosbë uinbi isnuma banati ꞌain, usakin uinbi kuanuma ꞌaia ka min Papa Diosan isia iskin ka min biti ñu chaíira mi ꞌinánti ꞌikën.<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />Dios ñukati kamina ꞌitsaíira bana banatima ꞌain, bëtsi unikama ꞌikësoi usai ꞌiasa Diosan a kuatia kiax ka usai ꞌia.<verse eid="MAT 6:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MAT 6:8" />Atux ꞌikësoi kamina ꞌitima ꞌain, min Papa Diosan ka mitsun ñukakëma ꞌainshi añu ñu karamina kuë́ëni kixun ꞌunania.<verse eid="MAT 6:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="MAT 6:9" />Mitsun kamina ësokin ñukati ꞌain: Nukën Papa Dios naínu ꞌikë, min anë ka ꞌuchañumaíra ꞌikën.<verse eid="MAT 6:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />Min nëtë ka uti ꞌikë, naíkamëonu ꞌikë usaribiokin kamina ënë menuribi ꞌati ꞌain.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Nun pitiribi kamina kamabi nëtën nu ꞌinánti ꞌain.<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />Nun ꞌakë ꞌatima ñukamaribi kamina nu mënioxunti ꞌain, usaribi okin nunribi bëtsi uniribi mënionun.<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />Ñu ꞌatima ꞌanun kamina nu ꞌimitima ꞌain, ñunshin ꞌatimanëan ñu ꞌatima nu ꞌamixuma ꞌanun kamina nu bëruanti ꞌain.<verse eid="MAT 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />Usaimi an mi ꞌatima okë unibë mënionania ka nukën Papa Dios naínu ꞌikë an upí isia.<verse eid="MAT 6:14" /></para>
  <para style="m">
    <verse number="15" style="v" sid="MAT 6:15" />Usa ꞌaibi ka bëtsibë mënionaniama nukën Papa Diosan mitsun ꞌakë ñuribi mëniotima ꞌikën.<verse eid="MAT 6:15" /></para>
  <para style="s">Usai píima samáti Jesús kia bana</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />Mitsux píima samáti kamina, min bëmana mërami masa nuituti, uni upisa ꞌaibi ꞌatimakama ꞌikësoi ꞌitima ꞌain, atux ka unin isti kuë́ënia, usai ꞌikin ka an biti ñu ka bitsia kixun sinánia.<verse eid="MAT 6:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="MAT 6:17" />Mitsux ñu píima samáti kamina min bu mënionan bëchukati ꞌain.<verse eid="MAT 6:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 6:18" />Ka ñu píima samátia kixun unin ꞌunanuma kamina usai ꞌiti ꞌain, Dios an kamabi ñu ꞌunanuma ꞌaia ꞌunánkë ꞌainshi ka ñu píima ka samátia kixun ꞌunankin min bitiñu mi ꞌinánti ꞌikën.<verse eid="MAT 6:18" /></para>
  <para style="s">Naínu ñuñu ꞌiti Jesús kia bana</para>
  <para style="r">(<ref loc="LUK 12:33-34">Lc 12.33-34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />Ënë menu ꞌitsaíira ñuñu ꞌiti kamina kuëëntima ꞌain, ꞌënë menuxun ꞌitsaíira ñu bitsiabi ka bëtsi bëtsi nakuaxan këñumainun bëtsi bëtsi puibuax chëkimainun bisan këñuti ꞌikën, usakin ꞌamainun ka an mëkamakë unin mëkamati ꞌikën.<verse eid="MAT 6:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="MAT 6:20" />Usa ꞌain kamina naínu ira ñu nánti ꞌain, anuax ka uisa ñubi nëtëmainun bisan pitima ꞌikën, ꞌimainun ka anu mëkamakë uni atsintima ꞌikën.<verse eid="MAT 6:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="MAT 6:21" />Uisa ñuñu ꞌiti kara kuëënía anuishi ka unin sinánia, usa ꞌain ka aín nuitunën amishi sinánia.<verse eid="MAT 6:21" /></para>
  <para style="s">Nun naminu ꞌikë tirí ñui Jesús kia</para>
  <para style="r">(<ref loc="LUK 11:34-36">Lc 11.34-36</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />Aín bëru tirí ꞌain ka kamabi ñu unin xabá isia, usa ꞌain kamina min bëru upí ꞌain, min nami xabánu ꞌiti ꞌikën.<verse eid="MAT 6:22" /></para>
  <para style="m">
    <verse number="23" style="v" sid="MAT 6:23" />ꞌAibi ka min bëru ꞌaisama ñu iskë ꞌain min nami bëánkibukënu ꞌikësa ꞌikën, usa ꞌain kara uitiu unishi bëankibukënu ꞌikësa ꞌiti ꞌik.<verse eid="MAT 6:23" /></para>
  <para style="s">Uinbi ka rabë́ ꞌapu ñu mëxuntima ꞌikën</para>
  <para style="r">(<ref loc="LUK 16:13">Lc 16.13</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />Uinbi ka rabë́ uni ñumëxuntima ꞌikën, rabë́ uni ñumëxunkë ꞌixun ka bëtsin kakëxun kuakin, bëtsi unin kakëxun kuaisama tankin kuatima ꞌikën, usaribiti kamina mitsux Dios mi sinanibi kurikiñu ꞌisatani ꞌiti ꞌain.<verse eid="MAT 6:24" /></para>
  <para style="s">ꞌItsaíira ñu sinánima tsóti Jesús kia</para>
  <para style="r">(<ref loc="LUK 12:22-31">Lc 12.22-31</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />Usa ꞌaín kamina masá nuituti tsótima ꞌain. Añu karana píti ꞌaín, añu karana xëati ꞌain añu chupa karana pañuti ꞌai kiax kitima ꞌain. Nun tsóti ax ka pitishi pi tsótima ꞌikën, usai inun ka Diosan nu unioma ꞌikë, chupa pañuishi tsónun ka nu unioma ꞌikën.<verse eid="MAT 6:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="MAT 6:26" />Ka is axa suñunu nubánkë ꞌisákama atun ka ñu ꞌapaxun bimia bixun bukunima. Usa ꞌikëbi ka min Papa, naínu ꞌikë an kamabi ñu kuëënía ꞌinania. Usa ꞌain kamina ꞌisákama samaira mitsux ꞌain.<verse eid="MAT 6:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="MAT 6:27" />Uinu ꞌikë mitsun karamina kana ëora kaniti ꞌai kixun, ¿Achúshi nëtënbi ꞌitsaíira sinánti ꞌain?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />Ro uakama kamina isti ꞌain, akamax ka aín chupa ꞌati risi xëoimabi upíira upí ꞌia.<verse eid="MAT 6:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="MAT 6:29" />Usa ꞌaibi kana ësokin mi kain, ꞌapu Salomón ꞌitsaíira ñuñu ꞌaibi ka usakinra aín chupa upíira a pañuama ꞌikën.<verse eid="MAT 6:29" /></para>
  <para style="m">
    <verse number="30" style="v" sid="MAT 6:30" />Diosan ka ro uakama upíira ꞌimia ꞌaibi ka bënëtishi chëkiti ꞌikën. Usakin ꞌakë ꞌixun kara akama ꞌakësamaira okin mitsu ꞌaxuntima ꞌik. ꞌAibi kamina ꞌën iskëx Dios mi, katamëti ꞌunankëma pain ꞌain.<verse eid="MAT 6:30" /></para>
  <para style="m">
    <verse number="31" style="v" sid="MAT 6:31" />Kamina masá nuitutima ꞌain: —¿Añu karana piti ꞌain? —¿Añu karana xëati ꞌain? —¿Añu chupa karana pañuti ꞌai kixun sinantima ꞌain?<verse eid="MAT 6:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 6:32" />An Diosan bana kuakëma unikamax ka usai masá nuitutia. Mitsun Papa Dios naínu ꞌikë an ka ꞌunania mitsun bisatankë ñu.<verse eid="MAT 6:32" /></para>
  <para style="m">
    <verse number="33" style="v" sid="MAT 6:33" />An kuëënkësabi okin kamina Dios naíkamëonu ikë aín ñu mëëti pain upiokin ꞌati ꞌain. ꞌAkëbëtan ka min kuëënkë ñu mi ꞌinánti ꞌikë upitax tsónun.<verse eid="MAT 6:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="MAT 6:34" />Usa aín kamina imë́ishi kara uisai nëtë ꞌiti ꞌikë kiax, masá nuitutima ꞌain, imë́ishi nëtë ꞌiti ñu ꞌa kamina ꞌunanima usa ꞌain ka kamabi nëtën ꞌatima ñu inutia.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">Uni itsi ꞌuchotima</para>
  <para style="r">(<ref loc="LUK 6:37-38">Lc 6.37-38</ref>,<ref loc="LUK 6:41-42">41-42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />Bëtsi unimi kamina manantima ꞌain, Diosanribi mi mitsu ꞌuchotima kupí.<verse eid="MAT 7:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="MAT 7:2" />Uisakin kaina uni ꞌuchoi usaribikin ka Diosan mikamaribi ꞌuchoti ꞌikën, bëtsi uni mi a kësaribi okin ka mi ꞌati ꞌikën.<verse eid="MAT 7:2" /></para>
  <para style="m">
    <verse number="3" style="v" sid="MAT 7:3" />¿Uisa kupí kaina min xukënan bëru xamënu ꞌikë i sani a isin, min bërunu ꞌikë imo a kaina isiman?<verse eid="MAT 7:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MAT 7:4" />¿Uisa ꞌixun kaina min bërunu ꞌikë i mo chaíira a bikëma ꞌixun, min xukënan bërunua; i sani chamará a bixun katsi kixun kati ꞌain? Min bëru xamënu ꞌikë i mo a bixunmabi.<verse eid="MAT 7:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="MAT 7:5" />¡Upisa ꞌaibi ꞌatimakama! Ñu ꞌakë unikama, min bëru xamënu ꞌikë i mo chaíira apain kamina biti ꞌain, apain bixun iskin kamina bëtsin bëru xamë́nu ꞌikë i sani aribi biti ꞌain.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />Dios ꞌinanti ñu kamina ꞌuchiti ꞌinantima ꞌai, mia ꞌuchitinan nëëki pitima kupí, ꞌimainun kamina kupíira ñu aribi anua kuchi ꞌikë anu nitima ꞌain, anu niabi ka chuorukin amakin ꞌatima oti ꞌikën.<verse eid="MAT 7:6" /></para>
  <para style="s">Dios usakin ñukáti Jesús kia</para>
  <para style="r">(<ref loc="LUK 11:9-13">Lc 11.9-13</ref>, <ref loc="LUK 6:31">6.31</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />Ñukakëxun ka Diosan ñu ꞌinania; uin kara baria an ka ñu mëraia; uin kara xëkuë taxkaia a ka xëokaxunkë ꞌiti ꞌikën.<verse eid="MAT 7:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MAT 7:8" />Uin kara ñukátia an ka ñu bitsia, uin kara baria an ka mëraia, uin kara kuënia a ka xëokaxunkë ꞌiti ꞌikën.<verse eid="MAT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9" />¿Uinu ꞌikë mitsun kaina min bëchikë pan ñukakëxun achúshi maxá ꞌinanti ꞌain?<verse eid="MAT 7:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="MAT 7:10" />¿Uinu ꞌikë mitsun kaina achúshi tsatsa ñukakëxun runu ꞌinánti ꞌain?<verse eid="MAT 7:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 7:11" />Mitsux ꞌatima uni ꞌixunbi kamina mitsun bëchikë upí ñu ꞌinanin, mitsun mi ꞌakësamaira okin ka nukën Papa Dios naínu ꞌikë an ñukakë uni a upí ñu ꞌinánti ꞌikën.<verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />Usa ꞌain kamina bëtsi unikama upiokin ꞌakinti ꞌain, usakin akinkëxun ka mikamaribi min, kuëënkësa okin akinti ꞌikën, usai ka profetakama ꞌimainun Moisésnën kuëënëo bana kia.<verse eid="MAT 7:12" /></para>
  <para style="s">Xëputi chukumaraira</para>
  <para style="r">(<ref loc="LUK 13:24">Lc 13.24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />Xëkuë chukumará anun kuainsama anun kamina atsinti ꞌain, xëkuë cha ꞌimainun bai chaíira ꞌai pampa anun ka ꞌaisámaira uni atsinia, ax ka bai anun tëmërai kuanti a ꞌikën.<verse eid="MAT 7:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 7:14" />Xëkuë chukumará ax ka anun kuainsama ꞌikën, anun ka ꞌitsamaishi uni kuania ax ka bai chukumará anun kuantankëx nëtëtima oi ꞌiti ꞌa ꞌikën, anun ka ꞌitsamaishi uni kuania.<verse eid="MAT 7:14" /></para>
  <para style="s">Aín bimi iski i ꞌunanti Jesús kia</para>
  <para style="r">(<ref loc="LUK 6:43-44">Lc 6.43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />An këmëkin bana ñuikë unikama ami kamina bëruankati ꞌain, an Dios ñuikëbë, atux ka oveja ꞌunamaratsusa ꞌikën, ꞌaibi aín nuitu mëu pianankë ñuinasa ꞌaish aia.<verse eid="MAT 7:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 7:16" />Aín bimi kupí kamina i ꞌunánti ꞌain, ¿Muxanua karamina a kuti bimi biti ꞌain, muxan kara a kuti bimi tuati ꞌik?<verse eid="MAT 7:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="MAT 7:17" />Usa kupin ka i upitan upiokin tuaia, i ꞌatima an ka upiokin aín bimi tuaima.<verse eid="MAT 7:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 7:18" />I upitan ka aín bimi ꞌaisama ꞌinun tuaima, usa ꞌain ka i ꞌatimanënribi upiokin tuaima.<verse eid="MAT 7:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="MAT 7:19" />Kamabi i ax upiti bimikëmakama ax ka tëatankëxun tsin nënkë ꞌiti ꞌikën.<verse eid="MAT 7:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="MAT 7:20" />Usa ꞌai ka ai bimi iskin unin uisa i kara kixun ꞌunánti ꞌikën.<verse eid="MAT 7:20" /></para>
  <para style="s">Uinsaranbi kana ꞌën mi ꞌunánkëma ꞌain</para>
  <para style="r">(<ref loc="LUK 13:25-27">Lc 13.25-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />Kamabi an ꞌën ꞌIbu, ꞌën ꞌIbu, an ꞌë kakë ax ka nukën Papa Diosan nëtë naíkamëonu ꞌitima ꞌikën, an ꞌën Papa bana kikësa okin ꞌakë ax ka anu ꞌiti ꞌikën.<verse eid="MAT 7:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="MAT 7:22" />A nëtën ka ꞌaisamaira unin ꞌën ꞌIbu, ꞌën ꞌIbu, nun kananuna min anën bana ñuixuanan, ñunshin ꞌatimañu unikama ꞌimainun ꞌaisamaira unin ꞌakëma ñu ꞌakën kixun ꞌë kati ꞌikën.<verse eid="MAT 7:22" /></para>
  <para style="m">
    <verse number="23" style="v" sid="MAT 7:23" />ꞌAibi kana ꞌën uinsaran nëtënbi kana mitsu ꞌunama ꞌain, ñu ꞌatima ꞌakë unibu ënuax ka kuantan kixun atu kati ꞌain.<verse eid="MAT 7:23" /></para>
  <para style="s">Maparanu ꞌakë xubu ꞌimainun masinu ꞌakë xubu</para>
  <para style="r">(<ref loc="MRK 1:22">Mr 1.22</ref>; <ref loc="LUK 6:47-49">Lc 6.47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />Uin kara ꞌën bana kuakin ꞌëx kikësabi okin ꞌaia, a unix ka ñu ꞌunánkë ꞌixun xubu maparanu ꞌakësaribi ꞌikën.<verse eid="MAT 7:24" /></para>
  <para style="m">
    <verse number="25" style="v" sid="MAT 7:25" />ꞌAibi ka baka uí suñuan ukin bë́kakin xubu shaikakin bë́kakë nipakëtima ꞌikën, maparanu ꞌakë kupin.<verse eid="MAT 7:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="MAT 7:26" />Usa ꞌaibi ka uin kara ꞌën bana kuakin ꞌëx kikësa okin ꞌaima ꞌax achúshi uni an sinañumasa ꞌixun ꞌashikin masinu xubu ꞌakë unisa ꞌikën.<verse eid="MAT 7:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="MAT 7:27" />Usa ꞌikë ka baka ꞌuí suñuan ꞌaisamaira bëkíkin xubu ꞌatimakin masinu ꞌakë a nipaxa ¡Nipakin ka kamabi ꞌain itákama masoxa!<verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />ꞌËnë banakama ñuixuntankëx Jesús sënënkëbë ka an bana kuakë unikamax ratuti kanankëxa.<verse eid="MAT 7:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="MAT 7:29" />An ka asérabi kushi ꞌixun bana ñuixuankëxa, an kirika kuëënëokë ꞌunánkë unikama ꞌunamikësamaira okin ka a bana ñuixuankëxa.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">Jesusan an nami chëkimikë chankuñu uni pëxkua</para>
  <para style="r">(<ref loc="MRK 1:40-45">Mr 1.40-45</ref>; <ref loc="LUK 5:12-16">Lc 5.12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Matánuaxa aia, ka ꞌitsaíira unikaman Jesús nuibiankëxa.<verse eid="MAT 8:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="MAT 8:2" />Usaia ꞌikëbë ka uni achúshi aín nami chankui ꞌinsinkë an a bëtanain aín rabuxutan tsobukin ësakin kakëxa: —ꞌËn ꞌIbu ꞌaisa tankin kamina ꞌë pëxkuti ꞌain.<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />Kakëxun ka Jesusan aín mëkënan ramëkin kakëxa: —Ka pëxkut kakëxëshi ka ¡Aín nami pëxkuti mëniokakëxa!<verse eid="MAT 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 8:4" />Usai ꞌia ka Jesusan ësakin kakëxa: —Ka is uibi kamina ñuixuntima ꞌain; sacerdotenu kamina kuanti ꞌain, kuakin kamina a Dios ꞌinantia Moisés kiasabi okin sacerdotekaman isnun ꞌinanti ꞌain.<verse eid="MAT 8:4" /></para>
  <para style="s">Jesusan Capitanën ñumëmikë uni pëxkua</para>
  <para style="r">(<ref loc="LUK 7:1-10">Lc 7.1-10</ref>; <ref loc="JHN 4:43-54">Jn 4.43-54</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Jesús Cafarnaúmnu atsinkëbë ka capitan achúshi romanu ꞌikë an ꞌakinun kixun kai kuankëxa.<verse eid="MAT 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 8:6" />Kuanxun ka kakëxa: —ꞌËn ꞌIbu, ꞌën ñu më́mikë uni ka ꞌisinkë xubunu ꞌikën, ka ꞌitsaíira tëmërakin paë tania.<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />Kakëxun ka Jesusan kakëxa: —ꞌËn kana pëxkui kuanti ꞌain.<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />Kia ka capitannën kakexa: —ꞌËn ꞌIbu, mix xubunu atsinti kana kuëënima; atsinkima kamina pëxkunun kati ꞌain, usokin mi kakë ka ꞌën ñu më́mikë uni pëxkuti ꞌikën.<verse eid="MAT 8:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="MAT 8:9" />ꞌËnribi kana ꞌën ꞌapu kikësabi okin ꞌain, ꞌën suntárukamanribi ka ꞌën kikësabi okin ñu ꞌaia, ꞌën kuantanun kakëx ka kuania; ꞌën kakëx ka bëtsix aia, ꞌën ñumëmikë uni ñu ka ꞌat kakëxun ka ꞌaia.<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />Usakian kakëx ratukin ka Jesusan abëa kuankë unikama kakëxa: —Kana mi kain Israelnua kana ë́sa uni iskëma ꞌain.<verse eid="MAT 8:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 8:11" />Usa ꞌain kana mitsu kain ꞌitsaíira uni ka amiax bari urukë anuax umainun, aín tsipumiax uti ꞌikën, utankëx ka Abraham, Isaac, Jacob, abëtan pi naíkamëonu timë́ti ꞌikën.<verse eid="MAT 8:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="MAT 8:12" />ꞌAibi ka axa naíkamëonu ꞌisatankë unikama ax bëánkibukënu nikë ꞌiti ꞌikën. Anuax ka tëmëranan bënëti inkin aín xëta ñërëxkati ꞌikën.<verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />Usakin katankëxun ka Jesusan capitan kakëxa: —Min xubunu kuantankëxun kamina min sinankësabi oi ka pëxkuaxa isi kuanti ꞌain.</para>
  <para style="p" vid="MAT 8:13">Ësai kikëbëishi ka capitanën ñumëmikë uni pëxkuakëxa.<verse eid="MAT 8:13" /></para>
  <para style="s">Pedronën nachi Jesusan pëxkua</para>
  <para style="r">(<ref loc="MRK 1:29-31">Mr 1.29-31</ref>; <ref loc="LUK 4:38-39">Lc 4.38-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Jesús ka Pedronën xubunu kuankinbi, aín nachi ꞌitsisan ꞌiax aín uxtinu rakakë mërakëxa.<verse eid="MAT 8:14" /></para>
  <para style="m">
    <verse number="15" style="v" sid="MAT 8:15" />Jesusan aín mëkënan mëkëishi ka aín ꞌitsis nëtëakëxa, a nëtëti nirukin ka pimiakëxa.<verse eid="MAT 8:15" /></para>
  <para style="s">ꞌItsa uni ꞌinsinkë Jesusan pëxkua</para>
  <para style="r">(<ref loc="MRK 1:32-34">Mr 1.32-34</ref>; <ref loc="LUK 4:40-41">Lc 4.40-41</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Usakin ꞌan ka bëbákishbukëbëtan ka ꞌitsaíira uninua aín banainshi ñunshin ꞌatima chikianan, uni ꞌinsikë a kamaribi pëxkuakëxa.<verse eid="MAT 8:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="MAT 8:17" />Ësakin profeta Isaíasnën kuënëosabi oi ka ꞌiakëxa, an ka nu mënionan nun ꞌinsinkë kamararibi pëxkuaxa.<verse eid="MAT 8:17" /></para>
  <para style="s">Jesús nuiti kupí</para>
  <para style="r">(<ref loc="LUK 9:57-62">Lc 9.57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />ꞌAisamaira unian bëararakëxun iskin ka Jesusan aín ꞌunámikë unikama ꞌukëmanan sikati ka kuan kixun kakëxa.<verse eid="MAT 8:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="MAT 8:19" />Kakëbë ukin ka an Moisésnën kuënëo bana ꞌunánkë uni achushinën kakëxa, ꞌën ꞌIbu ꞌën kana uinu kaina kuani anubi mibë kuainsa tani.<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />Jesusan ka kakëxa, kapa ꞌinuxbi ka anu ꞌuxti kiniñu ꞌikën, ꞌimainun ka pëchiñu ñuinakamaribi aín nañu ꞌikën, ꞌaibi kana ꞌëx Unin Bëchikë ꞌaish ꞌën anu ꞌiti xubuñumabi ꞌain.<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Kakëbë ukin ka aín ꞌunámikë bëtsinribi kakëxa, ꞌën ꞌIbu ꞌën Papanu pan kuantanu kamina ꞌë xuti ꞌain, a bamaia maintankëx kana mibë kuanti ꞌain.<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Kakëxun ka Jesusan kakëxa: An uni bamaia mainkë unian mainu kamina ëbianti ꞌain, ëbiani kamina ꞌëbë kuani uti ꞌain.<verse eid="MAT 8:22" /></para>
  <para style="s">Jesusan suñuón bukubumia</para>
  <para style="r">(<ref loc="MRK 4:35-41">Mr 4.35-41</ref>; <ref loc="LUK 8:22-25">Lc 8.22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Ësakin katankëxa ꞌukëmanan kuanux manë nuntinu ꞌirukëbë ka aín ꞌunámikë unikamaribi këñuruakëxa.<verse eid="MAT 8:23" /></para>
  <para style="m">
    <verse number="24" style="v" sid="MAT 8:24" />Usai suñuan ꞌikuasinkëbë parumpapa bëchunki manënuntinu ꞌunpax ꞌirui uchuakëxa. ꞌAibi ka Jesús ꞌuxakëxa.<verse eid="MAT 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 8:25" />Usai ꞌikëbëtan ka aín unikaman Jesús bësunkin kakëxa. —¡Nukën ꞌIbu, nu ka ꞌiëmit! Kananuna nanëtin.<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />Kia ka Jesusan bësukin kakëxa: ¿Uisa katsi karamina ꞌitsaíira rakuëtin? ¿Mitsun kaina Diosan ka nu bëruankin ꞌakinia kixun ꞌunániman? Ësakin kai nirukin ka suñuan ka nëtët kanan parúmpapa bëchunkë aribi bukubut kakëxa, kakëx ka aín bëchunkë nëtëishiakëxa.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />Usai ꞌikëbëi ka aín unikama ratuti kanankëxa: —¿Uisa uni kara ënëx ꞌik suñuan ꞌimainun parunpapabi ka aín bana kuatia?<verse eid="MAT 8:27" /></para>
  <para style="s">Ñunshin ꞌatimañu uni Gadara ꞌia</para>
  <para style="r">(<ref loc="MRK 5:1-20">Mr 5.1-20</ref>; <ref loc="LUK 8:26-39">Lc 8.26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Kuanx Gadara menu bëbakëbë ka rabë́ uni ñunshin ꞌatimañu anu uni mainkënua piku kuasini uakëxa, Jesusbë mëranani. An ka bai kushíira ꞌixun uibi anu inutanuma bëarakëxa.<verse eid="MAT 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 8:29" />Usa ꞌai ka a isi munúma kuënkënkin Jesús kakëxa: ¿Uisoti karamina Jesús Diosan bëchikë min nu ubion? ¿Anun mi nu tëmëramiti nëtë ka ꞌisama pain ꞌikën, ꞌaibi karamina uban?<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />A ꞌuri pachu ka ꞌitsaíira kuchin piabakëxa.<verse eid="MAT 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 8:31" />Usa ꞌain ka ñunshin ꞌatima uninu ꞌikë an Jesús kakëxa: —Nu ëman chikinkin kamina nukama kuchikamanu xuti ꞌain.<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />Jesusan ka kakëxa: —Ka kuantan.</para>
  <para style="p" vid="MAT 8:32">Kakëx ka ñunshin ꞌatimakama a uninuax chikikianx kuchikamanu atsiankëxa, atsinkëbë ka kamabi kuchikama abakiani kuanx kuëëtunua parunpapanu rëukuti bakami kiakëxa.<verse eid="MAT 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33" />Usai ꞌikëbë ka an kuchi bëruankë unikama abakiani kuanx, bëbakin a ꞌurama ꞌikë ëma anu ꞌikë unikama, ñuixunkin ka usaia ñunshin ꞌatimañu uni rabë́ ꞌikë a kamabi ñuixuankëxa.<verse eid="MAT 8:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="MAT 8:34" />Usokin chanioia kuabiani ka a ëmanu ꞌikë unikama abakiani anua Jesús ꞌikë nu kuankëxa, anu rikianxun iskin ka kamaxubi atun nëtënuax chikinun kixun kakëxa.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">Jesusan ꞌain ucha tërëanan nikëma uni pëxküa</para>
  <para style="r">(<ref loc="MRK 2:1-12">Mr 2.1-12</ref>; <ref loc="LUK 5:17-26">Lc 5.17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Anuax nuntinu ꞌirukiani kuantankëx ka baka ukëmanan sika tankëx Jesús aín ëmanubi bëbakëxa.<verse eid="MAT 9:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="MAT 9:2" />Usai ꞌikëbëtan ka uni ꞌinsinkë nikinbi tankëma achúshi bakëtinu ꞌaruxun ubankëxa: An uni ubankë an ka Jesusan ka ënë uni pëxkuti ꞌikë kixun sinankëxa, sinánia ꞌunankin ka Jesusan ꞌinsinkë uni a kakëxa: —Chuamarua ka ꞌit min ꞌuchakama ka tërë́nkë ꞌikën.<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />Kia kuakin ka an kuënëo bana ꞌunánkë uni rairinën sinankëxa: —Ënë unix ka ꞌatimati Diosmi banaia ax ka ꞌaisama ꞌikën.<verse eid="MAT 9:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MAT 9:4" />Kia atun, sinán ꞌunankin ka Jesusan kakëxa: —¿Uisa kupin kaina mitsun ꞌatimakin sinanin?<verse eid="MAT 9:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="MAT 9:5" />¿Uisa kara “Min ꞌucha ka tëmashi tërë́nkë ꞌikë”, mi kanabi “Nirukiani ka kuantan kixun mi kati ꞌik”.<verse eid="MAT 9:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="MAT 9:6" />Kana mi ismiti ꞌain, ꞌën Unin Bëchikë ꞌixun kana ꞌënribi ënë menu kushi ꞌixun, uni aín ꞌuchakama tërëana. Uni ꞌinsinkë nirukibi tankëma: —Nirukiani ka min bakëti bibiani min xubunu kuantan kati ꞌain.<verse eid="MAT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7" />Usakin kakëshi ka nirukiani aín xubunu kuankëxa.<verse eid="MAT 9:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MAT 9:8" />Ënë isi rakuëkin ka unikama kuë́ënkin nukën Papa Dios rabiakëxa, ꞌain cushia uni pëxkuia ëskin.<verse eid="MAT 9:8" /></para>
  <para style="s">Jesusan Mateo abë́ kuanun ka</para>
  <para style="r">(<ref loc="MRK 2:13-17">Mr 2.13-17</ref>; <ref loc="LUK 5:27-32">Lc 5.27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Anuax kuankibi ka Jesusan Mateo tsókë mërakëxa, ꞌapu ubamiti kuríki bitsi tsókë mërakin ka kakëxa, ꞌë ka nuibëtsin kakëxëshi ka nirukiani abë́ kuankëxa.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Kuankin ka Mateonën Jesús këñun aín unikama aín xubunuxua pinun ubankëxa, ubanx ka an Romanu ꞌikë ꞌapu ubamiti kuríki bikë unikama ꞌimainun ꞌuchañu unikamabëtan pi anuxun piti anu Jesús tsobuakëxa.<verse eid="MAT 9:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 9:11" />Usakin ꞌaia iskin ka fariseo unikama Jesusan unikama kakëxa: —¿Uisa kupin kara an kuríki bikë uni ꞌimainun ꞌuchañu unikamabëtan an mitsu ꞌunamikë unin pín?.<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />Kakëxun ka Jesusan kakëxa: —Uni ꞌinsinkëma kaman ka rukuturu kuëënima, paëtankë uni ꞌimainun ꞌinsinkë uni an kuni ka rukuturun ronti kuëënía.<verse eid="MAT 9:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="MAT 9:13" />Usa ꞌain kamina ënë bana kuënëo uisai kara kia kixun ꞌunanti ꞌain: “ꞌËn kana min nuibananti kuë́ënin, ñuina xaroima”. ꞌËn kana uni upí kupin uama ꞌain, sinánati ꞌëmi katamënun ꞌuchañu unikama a kai kana ubakën.<verse eid="MAT 9:13" /></para>
  <para style="s">Jesús píima samáti ñuká</para>
  <para style="r">(<ref loc="MRK 2:18-22">Mr 2.18-22</ref>; <ref loc="LUK 5:33-39">Lc 5.33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Juan an uni nashimikë, aín unikaman ka Jesús kuanxun ñukakëxa: —Nukama ꞌimainun fariseonëx ka ꞌitsaíira ñu píima samátia, ¿Añu ꞌai kara min unikama samatima ꞌin?<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />Kakëxun ka Jesusan kakëxa: —¿Kamikë unikama kara masá sinanti ꞌikë anua aín mëratibë birakakë anua abë́ ꞌain? ꞌAibi ka aín nëtë nukukëbë aín mërati uankëbë ñu píima samáti ꞌikën.<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />“Uinbi ka chupa xëni, chupa sani iotan aín tukikë a ꞌunuima; usa okëxubi ka chupa sani iotan tsënkikin chupa xëni tukaia, tukakëx ka chaia.<verse eid="MAT 9:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="MAT 9:17" />Uinbi ka ñuina xáka chumu okë xëninu uva bërií chëkakë a ꞌaruima ꞌarukëxubi ka tukaia, uva chëkakën ka urukin chumu tukai ampënkiti ꞌikën.<note caller="+" style="f"><char style="fr" closed="false">9.17 </char><char style="ft" closed="false">Judiokama kaman ka chumu anu uvas ꞌaruti ꞌakëxa ꞌimainunka bëtsi ñu baka anu ꞌaruti cabra xaká. Uvas baka paëtamainu ka ñu xaká ninitia. ꞌAibika uvas baka ñu xaká xëninu niakë, ëora ninitima ꞌikën. Tukikëbëka anpëkiti ꞌikën, ꞌaika ñu xaká masati ꞌikën.</char></note> Usa ꞌain ka uva chëkakë bëná ax ñu xaká bënanu ꞌarukë ꞌiti ꞌikën, usa ꞌain ka a rabëtabi upí ꞌiti ꞌikën.”<note caller="+" style="f"><char style="fr" closed="false">9.17 </char><char style="ft" closed="false">Jesusan ka chupa ꞌimainun vinu ñuikin ꞌunamiakëxa aín bëna ꞌimainun aín xëni ka upí tiki birananima. Bëna bana Diosan nëtë ñui kikë axa bëna ꞌain ka, an asabi kixun sinánkin an kuakë, a unikaman aín sinanën bënookin ñu ꞌati ꞌikën.</char></note><verse eid="MAT 9:17" /></para>
  <para style="s">Xanu ꞌinsinkë ꞌimainun Jaironën bëchikë xanu ia</para>
  <para style="r">(<ref loc="MRK 5:21-43">Mr 5.21-43</ref>; <ref loc="LUK 8:40-56">Lc 8.40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Jesusan bana ñuikëbë ka judiosnën ꞌapu aín kushi achúshi ukin kakëxa: —Aín rabuxutan tsobukin, ꞌën bëchikë ka bamatisa ꞌikë, usa ꞌaibi ukimin min mëkën anu nankëx ka iëti baiskiti ꞌikën.<verse eid="MAT 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 9:19" />Jesús nirukiani kuankëbëa, aín unikama abë́ nirukiani kuania ka nuibiankëxa.<verse eid="MAT 9:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="MAT 9:20" />Usai ꞌikëbë ka xanu akumakë mëkën rabë́ ꞌimainun rabë́ baritia, imi putakë an Jesús kaxu kuankin aín chupa kuëbi tikakëxa.<verse eid="MAT 9:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="MAT 9:21" />Ka sinánkëxa: ꞌAin chupa tikaishi, kana pëxkuti ꞌain.<verse eid="MAT 9:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="MAT 9:22" />Kuainakëkin ka Jesusan isakëxa, iskin ka xanu kakëxa: —Chuamarua kamina ꞌiti ꞌain, xu xanu. ꞌËmi sinani kamina pëxkua, anuax ka xanu pëxkukë ꞌiakëxa.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Jesusan ka judiokama ꞌapun xubunu nukukin isakëxa, an ñu më́ëkë unikama bukukë isanan uni sharati inia isakëxa.<verse eid="MAT 9:23" /></para>
  <para style="m">
    <verse number="24" style="v" sid="MAT 9:24" />Ka kakëxa: —Ka pikú ënuax, xu xanu ka bamakëma ꞌikën, ka ꞌuxaxa kia ka. Unikaman Jesús usankankëxa.<verse eid="MAT 9:24" /></para>
  <para style="m">
    <verse number="25" style="v" sid="MAT 9:25" />ꞌAibi ka anu ꞌikë unikama a chikini atsinki ka, xu xanu aín mëkënan bikin biruakëxa.<verse eid="MAT 9:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="MAT 9:26" />A me kamanuxun ka usaia ꞌikë kuakankëxa.<verse eid="MAT 9:26" /></para>
  <para style="s">Jesusan bënxuñu rabë́ pëxküa</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Anuax kuania ka Jesús bëxuñu uni rabëtan nuibiankin, kuënkënkin kakëxa: ¡Davitan rëbunki nu kamina nuibakin ꞌakinti ꞌain!<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />A xubunu Jesús atsinkëbë ka bënxuñukama a ꞌurama kuania, ñukakëxa: —¿Mitsun kaina ꞌën karana uisakin mi ꞌati ꞌai kixun sinánin?</para>
  <para style="p" vid="MAT 9:28">—Usa ka ꞌën ꞌIbu, ka kakëxa.<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />Usa ꞌain ka Jesusan aín bëru tikakin kakëxa: —Min sinankësa oi ka ꞌiti ꞌikën.<verse eid="MAT 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 9:30" />Usa ꞌaín ka bëpëxkukin Jesusan kakëxa: —Uibi kamina ñuixuntima ꞌain.<verse eid="MAT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 9:31" />ꞌAibi ka pikukin kamabi menuxun ꞌunantanun Jesusan ka ꞌë pëxkuaxa kixun ñuiakëxa.<verse eid="MAT 9:31" /></para>
  <para style="s">Jesusan banañuma uni banamia</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Bënxuñu unikama chikitamainun ka uni banañuma Jesusnu bëakëxa, anu ñunshin ꞌatsian ꞌikë.<verse eid="MAT 9:32" /></para>
  <para style="m">
    <verse number="33" style="v" sid="MAT 9:33" />Anua Jesusan ñunshin chikinkëbë ka uni banakëxa, usaia ꞌikëbë ka uni ratuti sinankasmai kiakëxa: —¡Uinsarabi ka Israelnu ësa ñu ꞌiama ꞌikën!<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />ꞌAibi ka fariseokama kiakëxa: —Ñunshin ꞌatimanën ꞌapubi ka ënë aín kushi ꞌinanxa anua ñunshin pikunun.<verse eid="MAT 9:34" /></para>
  <para style="s">Jesús ñu bimi ka ꞌitsaíira ꞌikë kia</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Jesús ka ëma chukumakama ꞌimainun ëma chanuribi kuankëxa, kuankin ka anua judíos timëkë xubu kamanuxun ꞌunamiakëxa. Upí bana ñuixuankëxa, Diosan nëtë naíkamëonu ꞌiti ñuixunkin ka ꞌinsinkë uni pëxkukin aín paë nëtëmiakëxa.<verse eid="MAT 9:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="MAT 9:36" />ꞌAisamaira uni iskin ka nuibakëxa ꞌibuñuma oveja ꞌikësai nuibakati sinankasmai ka tantima niakëxa.<verse eid="MAT 9:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MAT 9:37" />Aín unikama ka kakëxa: —ꞌItsaíira ka ñu bimi a biti ꞌikën, ꞌaibi ka an biti uniñuma ꞌikën.<verse eid="MAT 9:37" /></para>
  <para style="m">
    <verse number="38" style="v" sid="MAT 9:38" />Usa ꞌain kamina bimi ꞌibu ñukáti ꞌain, an bimi biti unikama xunun.<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">Jesusan mëkën rabë́ ꞌimainun rabë́ uni kuëan</para>
  <para style="r">(<ref loc="MRK 3:13-19">Mr 3.13-19</ref>; <ref loc="LUK 6:12-16">Lc 6.12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />Jesusan ka aín unikama mëkën rabë́ ꞌimainun rabë́ a kuënxun kakëxa. ꞌËn kushi kana mi ꞌinan, anumi ñunshin ꞌatima chikianan uni ꞌinsinkë pëxkuanan ꞌain paëkama nëtëminun.<verse eid="MAT 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 10:2" />Ënëx ka Jesusan Apostol mëkën rabë́ ꞌimainun rabë́ ꞌia aín anëkama ꞌikën: Simón ꞌikëbia Pedro kakë aín xukën Andrés; ꞌimainun Santiagonën xukën Juan ax ka Zebedeonën bëchikë ꞌikën.<verse eid="MAT 10:2" /></para>
  <para style="m">
    <verse number="3" style="v" sid="MAT 10:3" />Felipe, Bartolomé, Tomás, Mateo an Romanu xuti kuríki bikë, Santiago Alfeonën bëchikë, ꞌimainun Tadeo,<verse eid="MAT 10:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MAT 10:4" />Simón Canánu ꞌikë, ꞌimainun Judas Iscariote an Jesús uni bimia a ꞌiakëxa.<verse eid="MAT 10:4" /></para>
  <para style="s">Jesusan aín apóstol kama ꞌësëtankëxun xua</para>
  <para style="r">(<ref loc="MRK 6:7-13">Mr 6.7-13</ref>; <ref loc="LUK 9:1-6">Lc 9.1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Jesusan ka aín unikama mëkën rabë́ ꞌimainun rabë́ uni a ꞌësëtankëxun xuakëxa: —Xukin ka kakëxa, anua judioma uni ꞌikë ëma ꞌimainun Samarianu kamina kuantima ꞌain.<verse eid="MAT 10:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="MAT 10:6" />Anua ñuina ꞌibuñuma ꞌikësai Israel unibu ukukë a ëmanu kamina kuanti ꞌain.<verse eid="MAT 10:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 10:7" />Kuanxun kamina ñuixunti ꞌain, anun Diosan nëtë naíkamëonu uni ꞌiti ka ꞌurama ꞌikën.<verse eid="MAT 10:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MAT 10:8" />ꞌInsinkë uni pëxkuanan kamina, bamakë uniribi baiskimiti ꞌain, ꞌanan kamina an nami chëkimikë ꞌinsiñu uni pëxkuanan ñunshin ꞌatimañu uni pëxkuti ꞌain. Mitsun kamina kupiomitima ꞌain, kupímashi kamina ënë kushi bian a kupí.<verse eid="MAT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 10:9" />Kuríki, kuri, manë panshian a ꞌimainun anun tsitëkërëkiti kamina ubantima ꞌain.<verse eid="MAT 10:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="MAT 10:10" />Bain kuankin kamina pisha anu piti ꞌarukë, chupa, taxaka, anun kërëxti tsatibi ubantima ꞌain. Ax të́kë kamax ka pimikë ꞌiti ꞌikën.<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />Achúshi ñakanu ꞌikë ëmanu nukuti kamina uin kara mi bisa tankin nuibatia baritakëx anu ꞌiti ꞌain. Anun mix kuanti nëtëa ꞌitamainun.<verse eid="MAT 10:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="MAT 10:12" />Xubunu atsinkin kamina anu ꞌikë unikama a chúamashi ka ꞌikan kixun kati ꞌain.<verse eid="MAT 10:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="MAT 10:13" />Aín xubunu ꞌikë unian mi upiokin bikë kamina asabi ꞌiti ꞌain, mia bisamatankëbë ka an biti ñu ax minabi ꞌiti ꞌikën.<verse eid="MAT 10:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 10:14" />A ëmanuxuan mi bisama tanan min bana kuaisama tankëx kamina anuax chikiti ꞌain, chikikin kamina min taxakanu ꞌikë me kupúkë a takáti ꞌain.<verse eid="MAT 10:14" /></para>
  <para style="m">
    <verse number="15" style="v" sid="MAT 10:15" />ꞌËn kana asérabi mi kain anun tëmërai këñuti nëtë anun ka a ëmanu ꞌikë unikamax Sodoma ꞌimainun Gomorra ꞌikë unikama aín ꞌucha kupí ꞌasámaira okin, tëmëramikë ꞌiti ꞌikën.<verse eid="MAT 10:15" /></para>
  <para style="s">Jesusan unikamax tëmërati</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />Asérabi kana ꞌën mitsu ꞌarakakë ovejakamasa ꞌikë, pianankë ñuina nëbëtsínu xutin. Usa ꞌain kamina sinañuira ꞌaish runusa ꞌianan ñumakurusaribi ꞌaish ꞌunámara ꞌiti ꞌain.<verse eid="MAT 10:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="MAT 10:17" />Kamina bëruankati ꞌain, unikaman ka anua, judiokama timë́kë xubunuxun tëmëraminun mitsu ꞌapukama ꞌinanti ꞌikën.<verse eid="MAT 10:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 10:18" />Kamina bëruankati ꞌain, unin ka aín kushikama ꞌimainun ꞌapun kushikamanu, ꞌë kupin mitsu buanti ꞌikën, buankëxun kamina ꞌë ñuikin ꞌapukama kanan judioma unikama kati ꞌain.<verse eid="MAT 10:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="MAT 10:19" />Mitsua ꞌinankëxi kamina uisakin karana kati ꞌain kia bënë́tima ꞌain. Mixmi banakëma ꞌainshi ka Diosan Bëru Ñunshin upitan anu mi banati mi sinamiti ꞌikën.<verse eid="MAT 10:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="MAT 10:20" />Mitsux mi banakë ax ka mitsuxmi banakëma ꞌikën. Min Papa Bëru Ñunshin upí an ka mi usaimi banati sinámiti ꞌikën.<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />Aín xukënan ka bëtsi uni aín xukën ꞌamiti ꞌikën, aín papax ka aín bëchikëmi nishti ꞌikën, aín bëchikënëx ka aín papami nishti ꞌikën, nishkin ka ꞌamiti ꞌikën.<verse eid="MAT 10:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="MAT 10:22" />Kamabi menuax ka ꞌën uni kupí mitsumi nishti ꞌikën, usa ꞌaibi ka uix kara asérabi ꞌëmi katamëtia ax ka iëmikë ꞌiti ꞌikën.<verse eid="MAT 10:22" /></para>
  <para style="m">
    <verse number="23" style="v" sid="MAT 10:23" />Mitsua unin achúshi ëmanuxun ꞌatimokëx kamina bëtsi ëmanu kuanti ꞌain, usa ꞌain kana ꞌën mi asérabi kain, mitsux Israel ëmakamanu kuankëmapan ꞌainshi kana ꞌën Unin Bëchikë aish uti ꞌain.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />An ꞌunánkë uni ax ka a unankë uni usa ꞌima, an ñu më́ëkë uni ax ka an tëëmikë uni asa ꞌima.<verse eid="MAT 10:24" /></para>
  <para style="m">
    <verse number="25" style="v" sid="MAT 10:25" />An ꞌunánkë uni ax ka an ꞌunámikë usaribi ꞌiti ꞌikën, an ñu më́ëkë ax ka an tëëmikë asaribi ꞌiti ꞌikën. Unin ka mix kamina ñunshin ꞌatimanën ꞌapu ꞌai kixun ꞌë kaia, usa ꞌain kara, ¿Mix ꞌën uni ꞌikë kara unin uisakin mitsu kati ꞌik?<verse eid="MAT 10:25" /></para>
  <para style="s">Rakuëëtima bana</para>
  <para style="r">(<ref loc="LUK 12:2-7">Lc 12.2-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />Uimibi kamina rakuëëtima ꞌain, kamabi ñu umpúkë ka mërakë ꞌiti ꞌikën, unë́xun ꞌakë ñuribi ka ꞌunánkë ꞌiti ꞌikën.<verse eid="MAT 10:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="MAT 10:27" />Bakishnuxun kakë a kamina nëtë xabánuxun kati ꞌain; mia unë́xun ñuixunkëxun kamina kamabi unin kuanun ñuixunti ꞌain.<verse eid="MAT 10:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="MAT 10:28" />An uni ꞌakë unimi kamina rakuëtima ꞌaín, an ka aín namishi rëtëia, ꞌaibi ka aín bëru ñunshin rëtëima; ꞌaibi kamina anba nami ꞌimainun aín Bëru Nunshin a manë tsinu tëmëramiti ami kuni rakuë́ti ꞌain.<verse eid="MAT 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 10:29" />¿ꞌIsá rabë́ kananuna kuríki achushiratsunën marutima ꞌain? Usa ꞌaibi ka uinu ꞌikë ꞌisákaxi nukën Papa Dios kuëënkëbëma bamatima ꞌikën.<verse eid="MAT 10:29" /></para>
  <para style="m">
    <verse number="30" style="v" sid="MAT 10:30" />Diosan ka uiti bu kara nun maxkanu ꞌikë a kamabi ꞌunanxa.<verse eid="MAT 10:30" /></para>
  <para style="m">
    <verse number="31" style="v" sid="MAT 10:31" />Usa ꞌain kamina rakuëtima ꞌain, mitsux kamina ꞌitsaíira ꞌisá kupí kësamaira ꞌain.<verse eid="MAT 10:31" /></para>
  <para style="s">Jesús ñui banatima</para>
  <para style="r">(<ref loc="LUK 12:8-9">Lc 12.8-9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />Uin kara ꞌë ñuikin uni kaia, a ñuikin kana ꞌënribi ꞌën Papa Dios naínu ꞌikë a kati ꞌain;<verse eid="MAT 10:32" /></para>
  <para style="m">
    <verse number="33" style="v" sid="MAT 10:33" />Usa ꞌaibi kana uin kara ꞌë ñuiki uni kaima a ñuikiribi ꞌën papa nainu ꞌikë a katima ꞌain.<verse eid="MAT 10:33" /></para>
  <para style="s">Jesusnan ꞌaish tëmërati</para>
  <para style="r">(<ref loc="LUK 12:51-53">Lc 12.51-53</ref>, <ref loc="LUK 14:26-27">14.26-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />Mikama kamina sinantima ꞌain, ꞌën kana ënë menu mi upiti tsonun uakë kixun sinantima ꞌain; usama ka mitsux mi ꞌakanani bukunun kana uakën.<verse eid="MAT 10:34" /></para>
  <para style="m">
    <verse number="35" style="v" sid="MAT 10:35" />Kana ua unia aín papami níshnun, aín bëchikë xanu aín titami nishti ꞌikën aín ñëxuta ka aín ñëmi nishti ꞌikën.<verse eid="MAT 10:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="MAT 10:36" />Usa ꞌain ka min aintsi kamabi mimi nishti ꞌikën.<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />Uin kara aín papa ꞌimainun aín tita, ꞌë kuënkësamaira okin ꞌaía an ka ënama ꞌikë, ꞌuin kara ꞌain bëchikë xanu tuá kuë́ëana nukë bënë kuëënía ax ka ꞌënama ꞌiti ꞌikën.<verse eid="MAT 10:37" /></para>
  <para style="m">
    <verse number="38" style="v" sid="MAT 10:38" />Uin kara curuz papixun ꞌë nuima ax ribi ka ꞌënama ꞌiti ꞌikën.<note caller="+" style="f"><char style="fr" closed="false">10.38 </char><char style="ft" closed="false">Romanos unikaman ka Judiokama menu isa baritia ꞌapu ꞌiakëxa. Akaman ka an bana kuënëo kikësabio ikëma, akama in Curuz mëtas akëxa. Bikë unikaman ka cruz anuxua mëtasti anubi nukuki papiankëxa. Anu ka bamakëma ikëbi cruznu mëtas akëxa abia munu bamatanu. Ënën ka paëira ꞌikën ësai bamati. Jesusan ka nukë kuëanxa mëniokakë bamatix inu abë́ ënë menu soti, nukën ucha ëni ami katamëti a unamikësabioi ꞌiti.</char></note><verse eid="MAT 10:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="MAT 10:39" />Uix kara ꞌëxi kana ꞌië́ti ꞌai kixun sinánia ax ka ië́tima ꞌikën. ꞌImainun uix kara ꞌëmi sinani tëmërai ax ka ꞌiëmikë ꞌiti ꞌikën.<verse eid="MAT 10:39" /></para>
  <para style="s">Diosan ñu upí ꞌinanti</para>
  <para style="r">(<ref loc="MRK 9:41">Mr 9.41</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />Uin kara mitsu bitsia an ka ꞌëribi biti ꞌikën, usa ꞌain ka uin kara ꞌë bitsia anribi ka nukën Papa Dios an ꞌë xua aribi bitsia.<verse eid="MAT 10:40" /></para>
  <para style="m">
    <verse number="41" style="v" sid="MAT 10:41" />Uin kara profeta aín xubunu bitsia an ka, profetanën bikësaribi okin ñu upí biti ꞌikën. Usaribi okin ka uin kara uni upí bitsia aribi ñu upí ꞌinanti ꞌikën.<verse eid="MAT 10:41" /></para>
  <para style="m">
    <verse number="42" style="v" sid="MAT 10:42" />Uin kara ꞌën uni ꞌumpax xanpami ñumarasu ꞌikëbi ꞌinania aribi ka Diosan upí ñu ꞌinanti ꞌikën.<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">Juanën unikama Jesús isi kuan</para>
  <para style="r">(<ref loc="LUK 7:18-35">Lc 7.18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Aín unikama mëkën rabë́ ꞌimainun rabë́ akama, bana ñuixunkin sënëontankëx ka Jesús, bëtsi ëma kamanuxun bana unamiana ñuixuni kuankëxa.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Usa ꞌain ka Juanën sipuokë ꞌixun Jesucristonën ꞌakë ñukama kuakëxa, kuakin ka aín ꞌunamikë uni rairi xuakëxa.<verse eid="MAT 11:2" /></para>
  <para style="m">
    <verse number="3" style="v" sid="MAT 11:3" />Xukëx kuanxun ka ñukakëxa: —¿Asérabi karamina ax utinu kainkë a ꞌain, bëtsi karanuna kainti ꞌain?<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />Kakëxun ka Jesusan kakëxa: —Kuantankëxun kamina ꞌën ꞌaia kuanan iskë ñukama, Juan ñuixuni kuanti ꞌain.<verse eid="MAT 11:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="MAT 11:5" />Ñuixunkin kamina bëxuñu unin ka isia, nikëma unikama ka nitsia, ꞌain nami chëkikë unikama ka aín nami upí inun pëxkutia, pabë unikaman ka kuatia, bamakë unikamaribi ka baiskia, ꞌimainun ka ñuñuma unikamanribi anun ië́ti bana kuatia.<verse eid="MAT 11:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="MAT 11:6" />Chuama tani kuë́ëni ka ax tëmëraibi ꞌëmi katamëkin ënkëma ax ꞌiti ꞌikë.<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Juanën unikama kuantamainu ka Jesúsan uni Juan ñuikin kakëxa: —¿Añu ñuira kaina anu uni ꞌikëma menu chikixun isan? ¿Suñun xai shaikaia isi kaina chiakën?<verse eid="MAT 11:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MAT 11:8" />¿Añu kaina chikikin isan? ¿Achúshi uni upíira okin chupa pañukë kaina isan? Mitsun kamina ꞌunanin an chupa upíira okin pañukë unikama ax ka ꞌapun xubunu ꞌia.<verse eid="MAT 11:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="MAT 11:9" />¿Usa ꞌain kaina añu isi chikian? ¿Profeta isi? Uisakin, añuira isi kaina chikiakën profetasamaira a isi.<verse eid="MAT 11:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="MAT 11:10" />Juan ñuikin kuënëo bana ka ësai kia: “ꞌËn kana ꞌën uni xutin ax rëkuëxun bana ñuixuana, anumi kuanti bai mënionun”.<verse eid="MAT 11:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11" />Ën kana asérabi mi kain, uinbi ka Juan an uni nashimikë, asamaira chaa ꞌiama ꞌikën, ꞌaibi ka uix kara chukumara ꞌikë, ax ka Diosan nëtë naíkamëonu chaa ꞌiti ꞌikën.<verse eid="MAT 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 11:12" />An uni nashimikë Juan uá ꞌain ka bëribi, naíkamëonu ꞌiti ax ami uni nishkë ꞌaibi bëríbi kushi ꞌikën. Uni an amibi kushikin ꞌain bana ꞌakë axëshi ka anu ꞌiti ꞌikën.<verse eid="MAT 11:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="MAT 11:13" />Kamabi profeta kia ꞌimainun bana a ñuikë an ka usai naíkamëonu ꞌiti Juan utamainu ñuikë ꞌiakëxa.<verse eid="MAT 11:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 11:14" />Mitsun kaina ꞌënë bana kuatin, Juan ënëx ka profeta Elías ax uti ñuikë abi ꞌiakëxa.<note caller="+" style="f"><char style="fr" closed="false">11.14 </char><char style="ft" closed="false">An bana ñuikë profeta Malaquías antiguo testamentonu ꞌikë, ax ka kiakëxa Elias ka utëkënti ꞌikën judiokama unikama Mesías nukutamainun ꞌakini. Jesús ka kiakëxa: Juanëx ka Eliasa ꞌiakëxa, an ka Diosan nëtë ñuikin Jesús uisama pain ꞌain bana ñuixuankëxa.</char></note><verse eid="MAT 11:14" /></para>
  <para style="m">
    <verse number="15" style="v" sid="MAT 11:15" />Uix kara pabiu ikë, an ka kuati ꞌikën.<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />—¿Uisa kara kixun karanuna ënë unikama rëbunki kati ꞌain? Ka tuá xukama anu uni bukukënu tsótax kuai sharati kuënkënkin rairi ësakin ꞌakësa ꞌikën.<verse eid="MAT 11:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="MAT 11:17" />“Nun paka banokë ꞌaibi kamina mitsux kuë́ëni chirinkëma ꞌain; nukama anun masá sinanti kantakëbëbi kamina mikama masá sinani inkëma ꞌain”.<verse eid="MAT 11:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18" />Usa ꞌain ka Juan an pikëma, xëakëma a ubaxa a kupin kamina ki an ka ñunshin ꞌatimañu ꞌikën.<verse eid="MAT 11:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="MAT 11:19" />Unin Bëchikë ka ubakëxa an ka piana xëaia, unikaman ka kia: ꞌIkëbi ka unikama pikëntapu ꞌimainun xëairakë ꞌimainun bëtsi uni ꞌuchañu an kuríki Romanu buanti bikë abë ka nitsia kixun kaia. ꞌAibi ka Diosan kushi ꞌakë ñukama iskë ꞌia.<verse eid="MAT 11:19" /></para>
  <para style="s">An Diosan bana kuakëma unikama Jesusan ka</para>
  <para style="r">(<ref loc="LUK 10:13-15">Lc 10.13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Usakin katankëxun ka, Jesusan anuxua unin ꞌakëma bëtsi ñu ꞌakë a ëmakamanu ꞌikë unikama kakëxa, uisa kupin kaina Diosmi sinánakëma ꞌain Jesusan kakëxa:<verse eid="MAT 11:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="MAT 11:21" />—¡Anu ka Corazín ëmanu ꞌikë unikama! ¡Anu ka Betsaidanu ꞌikë unikama! Tiro, Sidón anuxun ꞌën kushin unin ꞌakëma ñu ꞌakë ꞌain ka anu ꞌikë unikama Diosmi sinánati, aín ꞌuchakama kupí masá nuituti chupa ninxa pañuanan chimaputan matakakikë ꞌitsianxa.<note caller="+" style="f"><char style="fr" closed="false">11.21 </char><char style="ft" closed="false">Nux kakataibo aish kananuna nun aintsi bamakëbë rarumati iní chupan maputin, usaribiti ka judiokama unikama nitëxëti masa sinánkin chupa ꞌatima pañubanan chimaputan mataka kiakëxa usai ꞌika ꞌain nitëxëkë ëni sinanakëxa.</char></note><verse eid="MAT 11:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="MAT 11:22" />ꞌAibi kana mitsu kain, anunmi tëmërati nëtë ꞌikëbë ka Tiro, Sidónu ꞌikë unikama ꞌikësamaira mitsun tëmërati ꞌiti ꞌikën.<verse eid="MAT 11:22" /></para>
  <para style="m">
    <verse number="23" style="v" sid="MAT 11:23" />Mi Capernaúm, ¿Min karamina naí manamira ꞌisa tanin? ¡ꞌImainun me kini ꞌukëmëuira nukúti ꞌain! ꞌAibi ka Sodomanuxun unin ꞌakëma bëtsi ñu ꞌaia ꞌiskë ꞌaish a ëmanu ꞌikë unikama bëribi anu ꞌitsianxa.<verse eid="MAT 11:23" /></para>
  <para style="m">
    <verse number="24" style="v" sid="MAT 11:24" />ꞌAibi kana mi kain anun mi tëmërati nëtë ka chaíira Sodoma ëmanu ꞌiasamaira ꞌiti ꞌikën.<verse eid="MAT 11:24" /></para>
  <para style="s">Jesusan ka aín Papa ꞌunania</para>
  <para style="r">(<ref loc="LUK 10:21-22">Lc 10.21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />A nëtën, ka Jesús ësai kiakëxa: —ꞌËn Papa Dios, mix naí ꞌimainun men ꞌIbu kupin kana mi rabin, min kamina an ñu ꞌunama unikama ꞌunamiana, an ñu ꞌunánkë unikamami umpukë a bana ꞌunamia.<verse eid="MAT 11:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="MAT 11:26" />ꞌËn Papa min kamina usai ꞌiti kuë́ënin.<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />ꞌËn Papa min kamina kamabi ñu ꞌë ꞌinan, uinbi ka aín Bëchikë ꞌunanima, aín Papan ishi ka ꞌunania, ꞌimainun ka aín Bëchikë naribi ꞌunania, ꞌimainun uikama kara aín Bëchikëna ꞌinantisa tania aín ꞌunamia.<verse eid="MAT 11:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="MAT 11:28" />Uikamax kara ñu mëi atsanxa ax ka ꞌënu uti ꞌikën, a kana ꞌën tantimiti ꞌain.<verse eid="MAT 11:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="MAT 11:29" />ꞌËn ꞌunamikë ñu kamina ꞌunanti ꞌain,<note caller="+" style="f"><char style="fr" closed="false">11.29 </char><char style="ft" closed="false">Bëtsi Biblianua ka ënë bana ësoki inshakëxa: kaina ꞌi tëakë minu nanti kuë́ëni. Achúshi ꞌi tëakë an ka ꞌi ꞌakë ꞌikë a ka nania ñuina rabë́ ꞌain tëxanu, sënëbi tëti kupí bueyes akëxa. Jesusan ka nukë kama abë́ timëti kuënia an nukë ꞌunamikë ñukama unin an kuëëkësari iana Diosan ñu mëti ꞌain.</char></note> ꞌimainun kamina ꞌënua ꞌunanti ꞌain, ꞌën kana upí sináñu ꞌianan ꞌën nuitu upí ꞌain, usaribi kamina mitsux ꞌiti ꞌain, usai ꞌi kamina tantiti ꞌain.<verse eid="MAT 11:29" /></para>
  <para style="m">
    <verse number="30" style="v" sid="MAT 11:30" />ꞌËn ꞌunamikë ñu ꞌimainun ꞌën papikë ñu ka tëmashi ubanti ꞌikën.<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">Anun ñu mëtima nëtën Jesusan unikaman trigo bëru bia</para>
  <para style="r">(<ref loc="MRK 2:23-28">Mr 2.23-28</ref>; <ref loc="LUK 6:1-5">Lc 6.1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Anun ñu mëtima nëtë ka, Jesus anu trigo ꞌapákë naën kuankin ka ꞌain unikaman ꞌakëñuma ꞌixun. Trigo siríkakin bixun piakëxa.<verse eid="MAT 12:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="MAT 12:2" />Usoia iskin ka fariseo unikama Jesús kakëxa: —Ka ís, anun ñu mëëtima nëtën usokin ñu ꞌati ꞌaimabi ka min unikama usa ñu ꞌaia.<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />Kakëxun ka Jesusan kakëxa: —¿Mitsun karamina kuënëo bana unaniman Davinën ka ꞌakëñuma ꞌixun abëa kuankë unikamabëtan ësokin ñu ꞌakëxa?<verse eid="MAT 12:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MAT 12:4" />David nën ka ꞌakëñuma ꞌixun, Diosan xubunu atsinxun anu ꞌikë pan, a bixun piakëxa. A panëxa ánpitima ꞌimainun axá abë kuankë an pitima ꞌikëbi, axá sacerdotenënshi piti ꞌikëbi.<verse eid="MAT 12:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="MAT 12:5" />¿Mitsun karamina Moisésnëan kuënëo bana a iskëma ꞌain? Sacerdote kamanka anun ñu mëëtima nëtën Dios rabiti xubunuxun anun ñumëtima nëtënbi tantikima ñu mëibi uchama ꞌikën.<verse eid="MAT 12:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="MAT 12:6" />ꞌËn kana mitsu kain, anuxun nukën Papa Dios rabiti xubu samasaiira ka ënu ꞌikën.<verse eid="MAT 12:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 12:7" />Mitsun karamina ënë bana uisai kara kia kixun kuakëma ꞌain: “ꞌËn kana mitsuxmi nuibanankë ꞌiti kuë́ënin ñuina ꞌarakakë xaroima”. Ënë bana kuakë ꞌixun kamina uin kara uisa ñubi ꞌakëma ꞌikë a ꞌucha okëma ꞌitsian.<verse eid="MAT 12:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MAT 12:8" />Unin Bëchikë ꞌaish kana anun ñu mëëtima nëtësama kushíira ꞌain.<verse eid="MAT 12:8" /></para>
  <para style="s">Jesusan achúshi uni ꞌinsinkë anun ñumëtima nëtën pëxkua</para>
  <para style="r">(<ref loc="MRK 3:1-6">Mr 3.1-6</ref>; <ref loc="LUK 6:6-11">Lc 6.6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Jesús ka anua Judiokama timë́kë xubunu kuankëxa.<verse eid="MAT 12:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="MAT 12:10" />Anu ka uni achúshi aín mëkën bamakë ꞌiakëxa. Usa ꞌain ka Ami manankatsi kixun Jesús ñukakëxa, —¿Anun ñu mëtima nëtën uni pëxkuti kara asabi ꞌik?<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />Kakëxun ka Jesusan kakëxa: ¿Uinu ꞌikë mitsu uni achushitan kara, achúshi ñuina ꞌarakakë ꞌixun anun ñumëtima nëtën kininu pakëtia baritima ꞌik?<verse eid="MAT 12:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="MAT 12:12" />¡Achúshi unix ka ñuina ꞌarakakësamaira ꞌikën! Usa ꞌain ka anun ñumëtima nëtën ñu upíira ꞌati asabi ꞌikën.<verse eid="MAT 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13" />Usa ꞌain ka Jesusan aín mëkën ꞌinsinkë uni ka mëishpak kakëx, mëishpatishi aín mëkën pëxkuakëxa.<verse eid="MAT 12:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 12:14" />Usa ꞌain ka fariseokama chikiti uisakin kara Jesús rëtëti kia ësënankëxa.<verse eid="MAT 12:14" /></para>
  <para style="s">Cristo ꞌiti ñuikin kuënëo bana</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Fariseo unikama ꞌësënania ꞌunani ka anuax Jesús kuankëxa. Kuankëbë ka ꞌaisamaira uni abë́ kuankëxa. Kuania ka Jesusan atun ꞌinsin pëxkuakëxa.<verse eid="MAT 12:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 12:16" />ꞌËn ñu ꞌakëbëta kamina uinu ꞌikë unibi katima ꞌaín —Kixun ka kakëxa.<verse eid="MAT 12:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="MAT 12:17" />Ënën ka usaia ꞌiti ñuia profeta Isaías kiásabi oi ꞌiakëxa:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />“Ënëx ka ꞌën uni ꞌikën, ꞌën kaiskë a ꞌianan. ꞌËn kuëënkë a ꞌimainun ꞌën ami sinairakë a ꞌikën. ꞌËn Bëru Ñunshin Upí kana a ꞌinanin, an ka kamabi menu ꞌikë uni upiti tsonun bana ñuixunti ꞌikën.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />An ka sharati kuëbikanantima ꞌikën. Uinbi ka ëmanxun aín bana kuatima ꞌikën.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Xai tëntunkë ax ka tëkë́tima ꞌikën, ꞌianan ka tirí axa bënámëisa tani kuinkë axi bënátima ꞌikën. Anuan ënë nëtënu ꞌikë unikama ꞌiëñëti ꞌitamainun ka usabi ꞌiti ꞌikën.<verse eid="MAT 12:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21" />Kamabi menu ꞌikë unix ka ami katamëti ꞌikën”.<verse eid="MAT 12:21" /></para>
  <para style="s">Jesús mi atimati bana</para>
  <para style="r">(<ref loc="MRK 3:20-30">Mr 3.20-30</ref>; <ref loc="LUK 11:14-23">Lc 11.14-23</ref>, <ref loc="LUK 12:10">12.10</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Usai ꞌikëbëtan ka uni achúshi ñunshin ꞌatimanën ꞌimikëa bëxuñu ꞌianan banañuma Jesusnu ubankëxa, ubania pëxkukëx ka uni banakëxa.<verse eid="MAT 12:22" /></para>
  <para style="m">
    <verse number="23" style="v" sid="MAT 12:23" />Jesusan usoia isi ka anu ꞌikë unikama ratuti sinánkasmai kanankëxa:</para>
  <para style="p" vid="MAT 12:23">—¿Ënë uni kara asérabi Davinën rëbunki, axa uti nun kaínkë, a ꞌik?<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />Jesusan usokin ñu ꞌaia ñuikania kuati ka fariseo unibu kiakëxa:</para>
  <para style="p" vid="MAT 12:24">—Ñunshin ꞌatimanën ꞌapu Beelzebú<note caller="+" style="f"><char style="fr" closed="false">12.24 </char><char style="ft" closed="false">Ñunshin ꞌatimanën ꞌapu satanás ax ka Beelzebú kakë ꞌikë.</char></note> aín kushin ꞌamikëxuinshi ka ënë unin ñunshin ꞌatima chikinia.<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />Usai kia atun sinan ꞌunánkin ka Jesusan kakëxa:</para>
  <para style="p" vid="MAT 12:25">“Ka ësa ꞌikën, bëtsi bëtsi ëmanu bukukë unikama nuibananima nishanani ka ꞌakanani këñutia. Usaribiti ka aín aintsibë buküabia nishanankë unikama amanu amanu kuani tsuáki nëtëtia.<verse eid="MAT 12:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="MAT 12:26" />Usa ꞌain kara ñunshin ꞌatimanën ꞌapu satanás axi mëanankin, ¿Uisakin aín kushi bëruanti ꞌik?<verse eid="MAT 12:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="MAT 12:27" />Kamina kikanin ꞌën isana ñunshin ꞌatimanën ꞌapu Satanasan<note caller="+" style="f"><char style="fr" closed="false">12.27 </char><char style="ft" closed="false">Belcebú </char></note> ꞌamikëxun uninua ñunshin chikíni, usa ꞌain kara, ¿Uin ira kara min unikama kushi anun ñunshin chikinti ꞌinanin? Usa ꞌain ka min unikama min kaina këmëi kixun ꞌunania.<verse eid="MAT 12:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="MAT 12:28" />ꞌAibi kana ꞌën Diosan Bëru Ñunshin Upitan kushin ꞌamikëxun, ñunshin ꞌatima chikínkë a kamina ꞌunánti ꞌain, usa ꞌain kamina anun Diosan nëtë naíkamëonu ꞌiti nëtë ka ubaxa kixun ꞌunanti ꞌain.<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />Ësa ka. Uinbi ka kushi uni aín xubunu atsínxun aín ñu bikuanima. Aín ꞌibu pain nëaxun kuni ka aín ñu bikuánti ꞌikën.<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />Uix kara ꞌëbëma ꞌikë ax ka ꞌëmi nishia; uin kara biti ꞌë ꞌakinima an ka ꞌaisama okin masá oia.<verse eid="MAT 12:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 12:31" />Usa ꞌaín kana ꞌëx kin, nukën Papa Diosan ka unin ꞌatima ñu ꞌakë kamabi tërë́nti ꞌikën, amia ꞌatimati banakë aribi. Usa ꞌaibi ka axa aín Bëru Ñunshin Upí ñui ꞌatimati banakë uni, a Diosan aín ꞌucha ënë nëtëkama ꞌimainun uinsarabi tërënuxuma aia.<verse eid="MAT 12:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 12:32" />Uix kara Unin Bëchikë ñui ꞌatimati banaia a uni ka nukën Papa Diosan aín ꞌucha tërë́nti ꞌikën. Usa ꞌaibi ka axa aín Bëru Ñunshin upí ñui ꞌatimati banakë uni aín ꞌucha nukën Papa Diosan ënë menuxun ꞌanan uinsaranbi tërëntima ꞌikën.<verse eid="MAT 12:32" /></para>
  <para style="s">Aín bimi iskin kananuna i ꞌunanti ꞌain</para>
  <para style="r">(<ref loc="LUK 6:43-45">Lc 6.43-45</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />I upí ꞌixun ka aín bimi upí ꞌinania, i ꞌatima ꞌixun ka ꞌatimakin tuaia. I kananuna ꞌain bimi iskin ꞌunanin.<verse eid="MAT 12:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="MAT 12:34" />¡Runun rëbunki! ¿Uisa ꞌaish kaina mitsux ñu upí banati ꞌain? Mitsuxi kamina ꞌaisama ꞌain. Min nuitunuaxa chikikë a kamina min kuëbitan banain.<verse eid="MAT 12:34" /></para>
  <para style="m">
    <verse number="35" style="v" sid="MAT 12:35" />Uni upí ax ka upiti kánania ax upí ꞌaish, uni ꞌatima ax ka ꞌatimati banaia ax ꞌatima ꞌaish.<verse eid="MAT 12:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="MAT 12:36" />ꞌËn kana mitsu kain, anuan ënë nëtë tëmërai këñuti nëtë anun ka uix kara ꞌatimati banaia ax ꞌucha okë ꞌiti ꞌikën.<verse eid="MAT 12:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MAT 12:37" />Min bananbi kamina ꞌatima okë ꞌiti ꞌain, ꞌianan kamina min kuëbitan banakë anunbi ꞌuchokë ꞌiti ꞌain”.<verse eid="MAT 12:37" /></para>
  <para style="s">Bëtsi unikaman uni itsian ꞌakëma ñu ꞌanun Jesús ka</para>
  <para style="r">(<ref loc="MRK 8:12">Mr 8.12</ref>; <ref loc="LUK 11:29-32">Lc 11.29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Fariseokama ꞌimainun an kuënëo bana ꞌunánkë unikaman ka Jesús kakëxa: —Nun kananuna bëtsi unian ꞌakëma ñu min ꞌaia istisa tanin.<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />Kakëxun ka Jesusan kakëxa: —ꞌAtima uni ꞌimainun ꞌaisama unikaman ka unin ꞌakëma ñu ꞌanun kixun ꞌë ñukatia, ꞌaibi kana profeta Jonás kiasabiokin ꞌaxuntima ꞌain.<verse eid="MAT 12:39" /></para>
  <para style="m">
    <verse number="40" style="v" sid="MAT 12:40" />Jonás ax ka rabë́ ꞌimainun achúshi nëtë ꞌianan rabë́ ꞌimainun achúshi ñantanribi tsatsa chaíira pukumëu ꞌiakëxa. Usaribiti kana ꞌën Unin Bëchikë ꞌinux ua ꞌaish rabë́ ꞌimainun achúshi nëtë ꞌimainun achúshi ñantanribi me mëu ꞌiti ꞌain.<verse eid="MAT 12:40" /></para>
  <para style="m">
    <verse number="41" style="v" sid="MAT 12:41" />Ninivenu ꞌikë unikama ka anun këñuti nëtë ꞌikëbë niruti ꞌikë, usai ꞌikin ka ënë menu ꞌikë unikama ꞌatima oti ꞌikën, Jonasnën nukën Papa Diosan bana ñuixunkëxun kuati sinanati ka ami sinánkëxa. Jonás ꞌiásamaira kana ënu ꞌëx ꞌain.<verse eid="MAT 12:41" /></para>
  <para style="m">
    <verse number="42" style="v" sid="MAT 12:42" />Amiaxa bari urukë pasukuaxa ukë xanu ꞌapu aribi ka anun tëmërai këñuti nëtë ꞌikëbë nirui mitsu ñui ꞌatimati banati ꞌikën, anribi ka ꞌura menua uxún Salomón ñu ꞌunaira ꞌixun bana ñuia kuati uakëxa, Salomón ꞌiásamaira kana ënu ꞌëx ꞌain.<verse eid="MAT 12:42" /></para>
  <para style="s">Anuax chikíkë anubi ñunshin ꞌatima kuantëkënti bana</para>
  <para style="r">(<ref loc="LUK 11:24-26">Lc 11.24-26</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />Ñunshin ꞌatima uninuax chikiti ka anu uni ꞌikëma panákë me anu kuankin anu tantiti bari nikibi mërakima ka sinania:<verse eid="MAT 12:43" /></para>
  <para style="m">
    <verse number="44" style="v" sid="MAT 12:44" />“ꞌËn anua chikia anubi kana kuantëkënti ꞌai kia”. Anuax kuanki bëbakin ka xubu maë́nkin mëniokë upí ꞌaish ꞌibuñuma usaribi ꞌikë anuaxa chikia uni a mëraia.<verse eid="MAT 12:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 12:45" />Usa ai ka kuanxun mëkën achúshi ꞌimainun rabë́ bibiani abë́ kuanx anuaxa chikia uni anubi atsíntëkënia. Usa ꞌain ka anua ñunshin ꞌatimakama atsinkë uni ax bëráma ꞌiasamaira ꞌia. Usaribiti ka ënë uni ꞌatimakama ꞌinuxun ꞌaia.<verse eid="MAT 12:45" /></para>
  <para style="s">Aín tita ꞌimainun aín xukëantu Jesús baria</para>
  <para style="r">(<ref loc="MRK 3:31-35">Mr 3.31-35</ref>; <ref loc="LUK 8:19-21">Lc 8.19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Jesusan anu ꞌikë unikama bana ñuixunkëbë uxún ka ëmanxun aín titan, aín xukë́antubëtan abë́ kananuna banakatsi kixun anu ꞌikë uni kakëxa.<verse eid="MAT 12:46" /></para>
  <para style="m">
    <verse number="47" style="v" sid="MAT 12:47" />Anuax kuakin ka achúshi unin Jesús kakëxa: —Min titabë ka min xukë́antu ëman ꞌikën. Ka mibë banatisa tania.<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />Kakëxun ka uni kakëxa: —¿Uix kara ꞌën tita ꞌik? ¿ꞌImainun kara uikamax ꞌën xukëantu ꞌik?<verse eid="MAT 12:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 12:49" />Usai kikin ka aín unikama aín mëkënan sanankin kakëxa: —Ënë unikamax ka ꞌën tita ꞌimainun ꞌën xukë́antu ꞌikën.<verse eid="MAT 12:49" /></para>
  <para style="m">
    <verse number="50" style="v" sid="MAT 12:50" />Uin kara ꞌën Papa naínu ꞌikë ax kuëënkësabi okin ꞌaia, akamax ka ꞌën xukën ꞌimainun ꞌën chirabakë ꞌimainun ꞌën tita ꞌikën.<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">Bëtsi bana ñuikësa okin ñu ꞌapakë ñuia</para>
  <para style="r">(<ref loc="MRK 4:1-9">Mr 4.1-9</ref>; <ref loc="LUK 8:4-8">Lc 8.4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />A nëtënbi xubunuax chikikiani kuanx ka Jesús parúmpapa kuëbi tsóbuakëxa.<verse eid="MAT 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 13:2" />Itsaira uni timëkëbë ka, Jesús manë nuntinu ꞌirui tsóbua këxa, usaia ꞌitamainun ka unikama masinu tikia këxa.<verse eid="MAT 13:2" /></para>
  <para style="m">
    <verse number="3" style="v" sid="MAT 13:3" />Usa ꞌai ka ꞌitsaira ñu bëtsi bana ñuikësa oki ꞌunamiakëxa.</para>
  <para style="p" vid="MAT 13:3">—Ka kakëxa: achushi an ñu bëru ꞌapákë ka chikiaxa aín ñu bëru sakai.<verse eid="MAT 13:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MAT 13:4" />Sakakëx ka raíri ñu bëru bainu nipakëaxa. Nipakëkëbë uxún ka ñuina pëchiunën eaxa.<verse eid="MAT 13:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="MAT 13:5" />Raírinë ka maxanu nipakëaxa, me chukumara ꞌikënu; a ñu bëru ka bënëtishi koaxa me këxtuma ꞌain.<verse eid="MAT 13:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="MAT 13:6" />ꞌAibi ka barin urukin xarokë aín tapun ꞌaíma ꞌain chushiaxa.<verse eid="MAT 13:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 13:7" />Rairi ñu bëru ka muxanu nipakëaxa, nipakëkë ꞌikë ka muxan abë kokin mapukin bamamiaxa.<verse eid="MAT 13:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MAT 13:8" />Usa ꞌaibi ka rairi ñu bëru an me upinu nipakëkë, an upiokin tuaxa; tuakë ꞌain bimi ka cien ꞌiaxa, rairinex sesenta, ꞌimainun ka rarinëxribi aín bimi treintaishi ꞌiaxa.<verse eid="MAT 13:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="MAT 13:9" />¡Uin kara aín pabita kuatia an ka kuati ꞌikën!<verse eid="MAT 13:9" /></para>
  <para style="s">Uisa kupí kara Jesusan bana itsi ñuikësokin bana ñuiakëxa kikë</para>
  <para style="r">(<ref loc="MRK 4:10-12">Mr 4.10-12</ref>; <ref loc="LUK 8:9-10">Lc 8.9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Aín unikaman ka Jesús a ꞌurama uxún ñukákëxa:</para>
  <para style="p" vid="MAT 13:10">Uisakaskin karamina bana itsi ñuikësokin ënë unikama bana ñuixunin.<verse eid="MAT 13:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 13:11" />Jesusan ka kakëxa:</para>
  <para style="p" vid="MAT 13:11">—Mikama ka Diosan ñu unpukë uisai karanuna naíkamëonu ꞌiti ai kixun unamia, ꞌaibi ka bëtsi unikama unamima.<verse eid="MAT 13:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="MAT 13:12" />Uix kara ñuñu ꞌikë ax ka ëora ꞌinankë ꞌiti ꞌikën, usa ꞌaish ka chaíirañu ꞌiti ꞌikën; ꞌaibi ka an añuma a chukumaratsuñu ꞌikëbi ankëkin bikuankë ꞌiti ꞌikën.<verse eid="MAT 13:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="MAT 13:13" />A kupin kana bana itsi ñuikësa okin ñuin; akaman ka isia, ꞌainbi ka isima; ka kuatia ꞌixunbi ka uisai kara kia kixun unanima.<verse eid="MAT 13:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 13:14" />A kamanu ka profeta Isaíasnëan kuënëo bana kikësabi oi ꞌia:</para>
  <para style="q" vid="MAT 13:14">“Kuakinbi kamina uisai kara kia kixun ꞌunántima ꞌain.</para>
  <para style="q" vid="MAT 13:14">Upiokin min bërun iskibi kamina istima ꞌain.<verse eid="MAT 13:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MAT 13:15" />Aín nuitu mëu ꞌunántisama tanan ka unikaman atun pabitan kuakinbi uisai kikë kara kixun ꞌunántisama tania.</para>
  <para style="q" vid="MAT 13:15">Atun bërunbi ꞌën ꞌaia iskinbi ka ꞌën kushiira ꞌaibi ꞌëmi sinántisama tania.</para>
  <para style="q" vid="MAT 13:15">ꞌËmi sinanatia kana atu ꞌën uni ꞌinun ië́mitsian. Usa ꞌaibi ka ꞌisama tanxa. Kiax ka Isaías kiakëxa”.<verse eid="MAT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />Chuamarua tani kamina mikama bëruñu ꞌixun isanan anun kuatiñu ꞌixun kuati ꞌiti ꞌain.<verse eid="MAT 13:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="MAT 13:17" />ꞌËn kana mikama kain ꞌitsaíira profetakama ꞌimainun an ñu upí ꞌakë unikaman ka ënë istisa tankibi isama ꞌikën, ꞌimainun ka mími kuakë ënë kuaisa tankibi kuama ꞌikën.<verse eid="MAT 13:17" /></para>
  <para style="s">Jesusan ñu bëru ꞌapákë uni ñui kikë ꞌunamia</para>
  <para style="r">(<ref loc="MRK 4:13-20">Mr 4.13-20</ref>; <ref loc="LUK 8:11-15">Lc 8.11-15</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />—Ka, kua, uisai kikë kara bëtsioki ñuikë bana ënë ꞌikën an ñu ꞌapakë ñui ka ënë bana kia:<verse eid="MAT 13:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="MAT 13:19" />Uin kara anun naíkamëonu ꞌiti a kuakinbi kuatima ax ka ñu bëru bainu nipakëkësa ꞌikën, usa ꞌikë ka upiokin ꞌunaniama ñunshin ꞌatimanën ꞌain nuitunu ikë bana manumianan bikuania.<verse eid="MAT 13:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="MAT 13:20" />Bëtsi unikamaxribi ka ñu bëru maxanu nipakëkësa ꞌikën, usa ꞌixun ka Diosan bana kuë́ënkin bitsia.<verse eid="MAT 13:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="MAT 13:21" />Usa ꞌain ka upiti tupunkëma ꞌixun bëtsi bëtsi ñu inúkin bënëkinshi a kuakë bana manuia.<verse eid="MAT 13:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="MAT 13:22" />Ñu bëru muxañu menu pakëkë ax ka ësa ꞌikën, uin kara a bana kuatibi, ñuñuira tsóti kamabi nëtën sinania, ax ka manuti tuañumasa ꞌia.<verse eid="MAT 13:22" /></para>
  <para style="m">
    <verse number="23" style="v" sid="MAT 13:23" />Rairi unix ka me upínu ñu bëru pakëkësa ꞌikën, a unikamax ka nukën Papa Diosan bana asérabi kuakin a bana kikësabi okin ꞌakë ꞌaish me upinu ꞌapákë ñu bëru, ax koi kanitankëxun upí okin tuakë, asaribi ꞌia. Rairinëx ka ꞌitsaíira, cien, bimiñusa ꞌimainun ka rarinëxribi ꞌitsa, sesenta, bimiñusa ꞌianan, rairinëxribishi ꞌitsamashi, treinta, bimiñusa ꞌia.<verse eid="MAT 13:23" /></para>
  <para style="s">Trigo bëru ꞌapákë këñun chuku ꞌatima ꞌirukë ñuikë bana</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Jesusan ka bana itsi ñuikësokin bana ñuixunkin ka ësakinribi kakëxa:</para>
  <para style="p" vid="MAT 13:24">—Naíkamëonu ꞌiti ax ka ësaribi ꞌikën. Achúshi unin ka ñu bëru upí aín naënu ꞌapáxa.<verse eid="MAT 13:24" /></para>
  <para style="m">
    <verse number="25" style="v" sid="MAT 13:25" />ꞌAibi ka kamabi uni ꞌuxan, anu kuanxun axa ami nishkë achúshi unin a naënu ñu bëru ꞌaisama ꞌapaxa, ꞌapabiani ka kuanxa.<verse eid="MAT 13:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="MAT 13:26" />Usa ꞌain ka ñu bëru ꞌapákë ax upí ꞌaish koi kanitankëx bimiaxa. Bimiñu ꞌaibi ka ñu bëru ꞌaisama axribi koi kaniaxa.<verse eid="MAT 13:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="MAT 13:27" />Usa isbiani kuanxun ka an ñu më́mikë unikaman aín ꞌibu ësakin kaxa: “Min kamina min naënu ñu bëru upí ꞌapan. ¿Usa kat? ¿Usa ꞌaibi kara chuku ꞌaisama uisax koax?”.<verse eid="MAT 13:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="MAT 13:28" />Kakëxun ka aín ꞌibun kaxa: “ꞌAtima unikaman ka usakin ꞌaxa”. Kakëxun ka an ñu mëëxunkë unikaman kaxa: “¿Nun a chuku ꞌaisamakama ëchiti kuanti kaina kuë́ënin?”.<verse eid="MAT 13:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="MAT 13:29" />Kakëxun ka aín ꞌibun kaxa: “A ëchikimina ñu ꞌapakë aribi ëchiti, usa ꞌain kamina chuku ëchítima ꞌain.<verse eid="MAT 13:29" /></para>
  <para style="m">
    <verse number="30" style="v" sid="MAT 13:30" />Abë́bia kanitanun kamina ënti ꞌain, anun aín bimi biti nëtë ꞌitámainun, usa ꞌain kana an bimi biti xuti ꞌain, an chuku ꞌaisama pain bitankëxun nëënun kana xuti ꞌain, usa ꞌain ka bixun trigo anu ñu bimi nankë anu bukunti ꞌikën”.<verse eid="MAT 13:30" /></para>
  <para style="s">Mostaza bëru ñui kikë bana</para>
  <para style="r">(<ref loc="MRK 4:30-32">Mr 4.30-32</ref>; <ref loc="LUK 13:18-19">Lc 13.18-19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Bana itsi ñuikësokin ka Jesusan anu ꞌikë unikama kakëxa: —Naíkamëonu ꞌiti ax ka mostaza bëru unin aín naënu ubanxun ꞌapakë usa ꞌikën.<verse eid="MAT 13:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 13:32" />Usa ꞌain ka bëtsi ñu bërusama chamaraíira ꞌikën, usa ꞌaibi ka kani bëtsi ñu ꞌapakë ikësamairai pëñanakëtia usai ikëbëtan ka ꞌisákan anu noia.<verse eid="MAT 13:32" /></para>
  <para style="s">Anun pan chamiti ñu ñui kikë bana</para>
  <para style="r">(<ref loc="LUK 13:20-21">Lc 13.20-21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Jesusan ka bana itsi ñuikësa okin kakëxa: —Naíkamëonu ꞌiti ax ka anun pan chamiti ñu rabë́ ꞌimainun achui okin tupunkin bixun xanun mëskuxun nankëx ka kamaxbi ꞌubatia.<verse eid="MAT 13:33" /></para>
  <para style="s">Profeta kiásabi oi Jesús kia</para>
  <para style="r">(<ref loc="MRK 4:33-34">Mr 4.33-34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Jesusan ka bana itsi ñuikësokin bëtsi bëtsi ñu ñuikin anu ꞌikë unikama bana ñuixuankëxa. Bëtsi bana ñuikësa okinshi ka kakëxa:<verse eid="MAT 13:34" /></para>
  <para style="m">
    <verse number="35" style="v" sid="MAT 13:35" />Ësai ka an bana ñuikë profeta kiásabi oi ꞌiakëxa, kana bana itsi ñuikësari banati ꞌain, Diosan me uniotabakin umpua ñu kana mi ñuixuni.<verse eid="MAT 13:35" /></para>
  <para style="s">Jesús chuku ꞌaisama ñui kia bana</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Bana itsi ñuíkësokin bana ñuixuntankëxun anu ꞌikë unikama ëbiani kuanx ka Jesús xubunu atsíankëxa. Atsinia ka aín unikaman nëbë́tsiorakin Jesús ñukakëxa:</para>
  <para style="p" vid="MAT 13:36">—Uisai kikë kara naënu ꞌikë chuku ñui kikë bana ax ꞌikë kixun kamina nu ñuixunti ꞌain.<verse eid="MAT 13:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MAT 13:37" />Kakëxun ka Jesusan kakëxa:</para>
  <para style="p" vid="MAT 13:37">—An ñu bëru upí ꞌapákë uni asaribi kana Unin Bëchikë ꞌinux uá ꞌën ꞌain.<verse eid="MAT 13:37" /></para>
  <para style="m">
    <verse number="38" style="v" sid="MAT 13:38" />Anu ñu bëru ꞌapákë ax ka ënë me ꞌikën, ñu bëru upí usaribiti ka axa naíkamëonu ꞌiti aín bëchikëkama ꞌia, chukusaribi ka ñunshin ꞌatimanën ꞌapun sinánmikë unikama ꞌikën.<verse eid="MAT 13:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="MAT 13:39" />An chuku ꞌatima ꞌapákë uni asaribi ka ñunshin ꞌatima ꞌikën. Anun bimi biti nëtë usaribi ka ënë nëtë këñuti ꞌikën. An bimi bikë uni asaribi ka ángelkama ꞌikën.<verse eid="MAT 13:39" /></para>
  <para style="m">
    <verse number="40" style="v" sid="MAT 13:40" />Anun unin chuku pain ëchítankëxun tsin nëënkë usaribi ka anun ꞌënë nëtë këñuti ꞌiti ꞌikën.<verse eid="MAT 13:40" /></para>
  <para style="m">
    <verse number="41" style="v" sid="MAT 13:41" />ꞌËn Unin Bëchikë ꞌinux uá ꞌixun kana ꞌën ángelkama xuti ꞌaín, ꞌën nëtënua an ñu ꞌaisama ꞌakë ꞌimainun an bëtsi uchamikë a unikamaribi bitankëxun chikinun,<verse eid="MAT 13:41" /></para>
  <para style="m">
    <verse number="42" style="v" sid="MAT 13:42" />Manë tsi rëkirukë anu ka puti ꞌikën, anuax ka tëmërai bënëti aín xëta ñërëxkai paëtani ꞌinti ꞌikën.<verse eid="MAT 13:42" /></para>
  <para style="m">
    <verse number="43" style="v" sid="MAT 13:43" />Usa ꞌain ka upí unikama barin urukin pë́kakëxa chaba chaba kikë usa aín Papa nëtënu ꞌiti ꞌikën. An aín pabitan ënë bana kuakë uni an ka kuati ꞌikën.<verse eid="MAT 13:43" /></para>
  <para style="s">Unëkë kupíirakë ñu ñui kikë bana</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />Naíkamëonu ꞌiti ax ka achúshi ñu menu umpukë usaribi ꞌikën. Uni achushinën ka ñu upíira umpukë a mëraia, mëraxun ka anubi umputëkënia, anu ka kuënkiani kuania, kuanxun ka aín ñu kamabi maruia marubëtsini uxún ka a kurikinën a me kamabi maruia.<verse eid="MAT 13:44" /></para>
  <para style="s">Perla kakë ñu kupíira kupí ñui kikë bana</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />Naíkamëonu ꞌiti ax ka achúshi uni an ñu marukë an upíira ñu perla kakë a bari nikësa ꞌikën.<verse eid="MAT 13:45" /></para>
  <para style="m">
    <verse number="46" style="v" sid="MAT 13:46" />Usa ꞌain ka perla kupíira achúshi mërabiani kuanxun unin kamabi aín ñu maruxun a kurikinan perla kakë ñu kupíira a maruaxa.<verse eid="MAT 13:46" /></para>
  <para style="s">Anun tsatsa biti rika ñui kikë bana</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />Ësaribi ka naíkamëonu ꞌiti a ꞌikë, rika anun bëtsi bëtsi tsatsa biti parunpapanu sarakakë usaribi ꞌikën.<verse eid="MAT 13:47" /></para>
  <para style="m">
    <verse number="48" style="v" sid="MAT 13:48" />Usa ꞌain rikan tsatsa ꞌitsa bitsia ka unin masinu ubania, tsoxun anuxun tsatsa kaiskin bitsia, bixun ꞌain upibu tasánu puruanan ka ꞌain ꞌaisama a bakanu putia.<verse eid="MAT 13:48" /></para>
  <para style="m">
    <verse number="49" style="v" sid="MAT 13:49" />Usaribi ka anun me këñuti nëtë ꞌinuxun ꞌaia. ꞌËn utëkënkëbë ukin ka angelkaman unikama Nukën Papa Diosan ꞌiskëx upí ꞌikë akama abë́ ꞌinun bianan an iskëxa upíma a ënuxun ꞌaia.<verse eid="MAT 13:49" /></para>
  <para style="m">
    <verse number="50" style="v" sid="MAT 13:50" />Manë tsi rëkirukë anu puti ꞌikën, anuax ka tëmërai bënë́ti aín xëta ñërëxkai paë tani inti ꞌikën.<verse eid="MAT 13:50" /></para>
  <para style="s">Ñu bëná ꞌimainun ñu xëni</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />Jesusan ka ñukakëxa: —¿Ënë kama kaina kuatin? Kakëxun ka atun kakëxa: —Kananuna kuati.<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Usa ꞌain ka Jesusan kakëxa: —A kupin ka kamabi an ñu ꞌunánkë unin ñuixunkë kuënëo bana Naíkamëonu ꞌiti ka achúshi xubuñu unían. Aín ñu nanxun aín ió këñu aín xëni pikukësa ꞌikën.<verse eid="MAT 13:52" /></para>
  <para style="s">Jesús Nazaretnu ꞌia</para>
  <para style="r">(<ref loc="MRK 6:1-6">Mr 6.1-6</ref>; <ref loc="LUK 4:16-30">Lc 4.16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Bana itsi ñuikësokin unikama bana ñuixunkin sënëobiani ka anua Jesús kuankëxa.<verse eid="MAT 13:53" /></para>
  <para style="m">
    <verse number="54" style="v" sid="MAT 13:54" />Kuanx aín menu bëbatankëxun ka anua judíos unikama timë́ti xubunu atsínxun bana ñuixunkin ꞌunánmiakëxa. Usokian bana ñuia kuati ka anu ꞌikë unikamax ratuti kanankëxa:</para>
  <para style="p" vid="MAT 13:54">—¿Uin kara ënë uni usakian bana ñuiti ꞌunánmiax? ¿Uin kushin kara ënë menuxun unin ꞌakëma ñu ꞌain?<verse eid="MAT 13:54" /></para>
  <para style="m">
    <verse number="55" style="v" sid="MAT 13:55" />Ënëx ka carpinteronën bëchikë ꞌikën, ꞌimainun ka aín titax María ꞌikën. Santiago,<note caller="+" style="f"><char style="fr" closed="false">13.55 </char><char style="ft" closed="false">Algunas versiones usan el nombre Jacobo.</char></note> José, Simón, Judas akamax ka aín xukën ꞌikën.<verse eid="MAT 13:55" /></para>
  <para style="m">
    <verse number="56" style="v" sid="MAT 13:56" />¿Aín chirabakë kamaribi ka nubë ënu ꞌikën?. ¿Uinua kara ësakin bana ñuianan ësakinribi ñu ꞌati ꞌunanx?<verse eid="MAT 13:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 13:57" />Usai kanani ami nishkëxun iskin ka atu Jesusan kakëxa:</para>
  <para style="p" vid="MAT 13:57">—Achúshi profeta ka unin aín menuxun kuëënima. ꞌImainun aín aintsi ꞌibukamanribi kuaisama tania.<verse eid="MAT 13:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58" />Usa ꞌain ka Jesusan ꞌitsa ñu ꞌakinma uni itsían ꞌakëma ñu ꞌitsamashi ꞌakëxa. Anu ꞌikë unikama aín bana kuaisama tankë kupin.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">Juan bama ñuikë bana</para>
  <para style="r">(<ref loc="MRK 6:14-29">Mr 6.14-29</ref>; <ref loc="LUK 9:7-9">Lc 9.7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Herodes, Galileanu a nëtën ꞌapu ꞌixun ka Jesús ñuikania kuakëxa.<verse eid="MAT 14:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="MAT 14:2" />Kuaxun an ñu më́mikë unikama ësokin kakëxa: An ka Juan Bautista axa baiskikë a ꞌikën, usa ꞌixun ka aín kushin iskëma ñu ꞌaia.<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Herodesnën ka Juan sipuomiakëxa, Herodias, ax ka aín xukën Filipo aín xanu ꞌiakëxa.<verse eid="MAT 14:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MAT 14:4" />Usa ꞌain ka Juanën Herodes kakëxa: —A xanu min xanu ꞌinun biti ka ꞌaisama ꞌikën.<verse eid="MAT 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 14:5" />Herodesnën ka Juan rëtëti sinánkëxa, ꞌaibi ka unikamami rakuëkin ꞌamiama ꞌikën, Juan ax isa profeta ꞌikë kixun sinánkë kupí.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />ꞌAibi ka anuan Herodes bakëan nëtë ꞌain, Herodiasnën tuá xanu xuntaku ax ꞌitsaíira unia timëan upiti ransakëxa, usaia ꞌia isi ka Herodes ꞌitsaíira kuë́ëankëxa.<verse eid="MAT 14:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 14:7" />Kuë́ënkin ka añu ñu karamina kuë́ëni a kamina ꞌë ñukati ꞌai kixun kakëxa.<verse eid="MAT 14:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MAT 14:8" />Aín tita Herodíasnën kakë kupí ka aín tuá xuntaku, an Juanën maxka kamina achúshi manë xampami ꞌë bëxunti ꞌai kixun Herodes kakëxa.<verse eid="MAT 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 14:9" />Kakëx ka Herodes ꞌitsaíira masá nuituakëxa, ꞌaibi ka unian kuamainun ꞌën kakësabi okin kana ꞌinanti ꞌai kixun sinánkin ꞌinankëxa.<verse eid="MAT 14:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="MAT 14:10" />Anuxun ka Juanën mapuxo sipunuxun tëbiskanun ꞌamiakëxa.<verse eid="MAT 14:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 14:11" />Anuxun ka achúshi manë xampami ubanxun xanu tuá ꞌinankëxa, ínankëxun ka aín tita ꞌinankëxa.<verse eid="MAT 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 14:12" />Usa ꞌain ka Juanën nami aín unikaman bibianxun maiánkëxa maibiani kuanxun ka Jesús ñuixuankëxa.<verse eid="MAT 14:12" /></para>
  <para style="s">Jesusan ꞌitsaíira uni pimia</para>
  <para style="r">(<ref loc="MRK 6:30-44">Mr 6.30-44</ref>; <ref loc="LUK 9:10-17">Lc 9.10-17</ref>; <ref loc="JHN 6:1-14">Jn 6.1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Bana ñuiña kuabiani ka Jesús manë nuntinu ꞌirukiani aín unikamabë anu uni ꞌikëma menu kuankëxa, ꞌaibi ka a ëmakamanu ꞌikë unikama ꞌunankin kuankin nuibiankëxa.<verse eid="MAT 14:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 14:14" />Manë nuntinua ꞌibukin ka Jesusan ꞌitsaíira uni isakëxa, isi ami sinánkin ka an nuibiankë uni ꞌimainun ꞌinsikëkama pëxkuakëxa.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />Anuxun ka bëbakishbukëbë a ꞌuruma kuankin aín unikama kakëxa: —Ka xupibutia ënëx ka anu uni ꞌikëma ꞌikë kamina unikama kuantanun kati ꞌain, kamina aín piti ñu marui ëmakamanu kuantanu xuti ꞌain.<verse eid="MAT 14:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 14:16" />Kakëxun ka Jesusan kakëxa: —Ënë kama kuanimabi ka asabi ꞌikën, míkaman kamina piti ꞌinanti ꞌain.<verse eid="MAT 14:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="MAT 14:17" />Atun ka kakëxa: —Ënu ka mëkën achúshi pan ꞌimainun rabë́ tsatsa ꞌikën.<verse eid="MAT 14:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 14:18" />Kakëxun ka Jesusan ësokin kakëxa: —Ënu ka ꞌë bëxun.<verse eid="MAT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 14:19" />Anuxun ka ꞌitsaíira uni basinu tsobumiakëxa, usokin ꞌatankëxun mëkën achúshi pan ꞌimainun rabë́ tsatsa aín mëkënan bitankëxun, manámi bësunkin asabi ka kixun katankëxun aín unikama ꞌinankëxa, anuxun ka kamabi uni atun mëtikakëxa.<verse eid="MAT 14:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="MAT 14:20" />Kamaxubi ka puchakin piakëxa, usotankënxun ka axa tëxëkë mëkën rabë́ ꞌimainun rabë́ kaki buakakin biakëxa.<verse eid="MAT 14:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="MAT 14:21" />ꞌAn pikë unikamax ka cinco mil uni ꞌiakëxa, ꞌai ka xanu ꞌimainun tuakama tupun këma ꞌiakëxa.<verse eid="MAT 14:21" /></para>
  <para style="s">Jesús parúmpapa kamánanën nikia</para>
  <para style="r">(<ref loc="MRK 6:45-52">Mr 6.45-52</ref>; <ref loc="JHN 6:16-21">Jn 6.16-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Ësakin ꞌatankëxun ka Jesusan aín unikama rëkuënkiani kuanun manë nuntinu këñurumiakëxa, usakin ꞌatankëx ka unikama kana kuani kixun kai bëruakëxa.<verse eid="MAT 14:22" /></para>
  <para style="m">
    <verse number="23" style="v" sid="MAT 14:23" />Unikama kana kuani kixun katankëx ka ax matánu Diosbë banai kuankëxa, usai ꞌikëbëa bëánkikëbë ka anu abi ꞌiakëxa.<verse eid="MAT 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 14:24" />Manë nunti parúmpapa nëbë́tsi ꞌain ka amokuax suñu bë́kikëbë baka chaíira ꞌinun bëchuankëxa.<verse eid="MAT 14:24" /></para>
  <para style="m">
    <verse number="25" style="v" sid="MAT 14:25" />Pë́karakuatsinia nëtë xabakëbë ka, Jesús parúmpapa kamananën atumi kikuatsini uakëxa.<verse eid="MAT 14:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="MAT 14:26" />Aí parúmpapa kamanan nikuatsinia isi ka aín ꞌunamikë unikama rakuëti kuënkëni: —¡Achúshi ñunshin ka aía kiakëxa!<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />ꞌAibi ka Jesusan ka nëtëk atu kakëxa, ¡ꞌË kana ꞌain!, ¡Rakuëama ka ꞌikan!.<verse eid="MAT 14:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="MAT 14:28" />Kia ka Pedronën kakëxa: —ꞌËn ꞌIbu mi ꞌixun kamina ꞌumpax kamananën minu kuanun ꞌë ꞌimiti ꞌain.<verse eid="MAT 14:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="MAT 14:29" />—Kakëxun ka Jesusan kakëxa, ka ut kakëx manë nuntinuax ꞌibukiani Pedro ꞌumpaxan nikiani Jesusnu kuankëxa.<verse eid="MAT 14:29" /></para>
  <para style="m">
    <verse number="30" style="v" sid="MAT 14:30" />ꞌAibi ka Pedro suñu kushi bë́kia isi rakuëti nanë́buti kuënkëni ¡ꞌËn ꞌIbu, ꞌë ka bit, kiakëxa!.<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />Kia ka Jesusan mëishpakin aín mëkënan bikin kakëxa, Pedro mix kamina chukumashi ꞌëmi sinánin. ¿Uisa kupin kaina ꞌëmi sinánkëma ꞌain?<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />Usai ꞌiax manë nuntinu ꞌirukëbë ka suñu bukubuakëxa.<verse eid="MAT 14:32" /></para>
  <para style="m">
    <verse number="33" style="v" sid="MAT 14:33" />Ësai ꞌikëbëtan ka manë nuntinu ꞌikëkama anu ukin aín rabuxutan rantipuruni tsobukin rabiakëxa: —¡Mix kamina asérabi Diosan bëchikë ꞌai kixun kakëxa!<verse eid="MAT 14:33" /></para>
  <para style="s">Jesusan Genesaretnu ꞌikë ꞌinsinkë unikama pëxkua</para>
  <para style="r">(<ref loc="MRK 6:53-56">Mr 6.53-56</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Usakin ꞌatankëx ka parúmpapa ꞌukëmanan Jesús ꞌimainun aín unikama Genesaret menu bëbakëxa.<verse eid="MAT 14:34" /></para>
  <para style="m">
    <verse number="35" style="v" sid="MAT 14:35" />Anuxun ka anu ꞌikë unikaman Jesús ka uaxa kixun ꞌunánkakëxa, usa ꞌain ka a menu ꞌikë unikaman an chanioti xuakëxa, anuxun ka an pëxkunu uni ꞌinsikëkama bëakëxa.<verse eid="MAT 14:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="MAT 14:36" />Anuxun ka anuan mapúkë aín chupa kuëbibisa mëminu kixun kakëxa, usa ꞌaín ka uin kara aín chupa kuëbi tikaia a uni ꞌinsinkëkama ax pëxkuakëxa.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">An uni ꞌatima ꞌimikë</para>
  <para style="r">(<ref loc="MRK 7:1-23">Mr 7.1-23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Anu rikianxun ka fariseokama ꞌimainun an bana ꞌunankëkaman Jerusalenuax uxún Jesús ñukakëxa:<verse eid="MAT 15:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="MAT 15:2" />—¿Uisakaskin kara min unikaman nun rarakama kiásabi oi ꞌimín? ¿Uisa kupin kara nun rarakama kiásabi oi ꞌikima mëchu kaxuma pin?<note caller="+" style="f"><char style="fr" closed="false">15.2 </char><char style="ft" closed="false">Judiokama kaman ka aín chaitiokë kiasabi oi, pinuxpain mëchukati kiakëxa, usai ꞌisa upí ꞌiti ꞌikë kixun sinankëxa.</char></note><verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />Kakëxun ka Jesusan ësakin kakëxa: —¿Uisa kaskin karamina mitsunribi nukën Papa Dios kikësaribiokin ꞌaima, mitsun sinankësaoishi ꞌin?<verse eid="MAT 15:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MAT 15:4" />Ësai ka Dios kiakëxa: “Min papa ꞌimainun min titan kakëxun kamina kuati ꞌain”, ꞌaibi “Kuakima aín papa aín tita ꞌatimokin ñuikë ax ka bamakë ꞌiti ꞌikën”.<verse eid="MAT 15:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="MAT 15:5" />Usa ꞌaibi kamina mitsux ësai kin: Achúshi unin ka aín papa ꞌimainun aín tita kati ꞌikë mi kana ꞌakinima, kamabi ꞌën ñukama kana Dios ꞌinan.<verse eid="MAT 15:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="MAT 15:6" />Uix kara ësai kia an ka aín papa ꞌimainun aín tita ꞌakintima ꞌikë kiax kin, ësokin ꞌai kamina Diosan bana kikësabioi ꞌima mitsun sinankësa oishi ꞌi bukuin.<verse eid="MAT 15:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 15:7" />¡Upisa ꞌaibi ꞌatimakama!, Ësakin ka profeta Isaiasnën mitsu ñuikin kuënëokëxa:<verse eid="MAT 15:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MAT 15:8" />“Ënë unikaman ka aín kuëbitanshi ꞌë rabia ꞌixubi ka aín nuitu mëu ꞌë sinanima ꞌë ꞌura ꞌikën.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />Ñankabi ꞌë rabianan ka, unibia sinanki nankë bana a ꞌunamia”.<verse eid="MAT 15:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />Usakin katankëxun ka Jesusan unikama kuëntankëxun kakëxa: —Kuakin ka upiokin bëmët.<verse eid="MAT 15:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 15:11" />Axa aín kuëbitan atsinkë ñu an ka uni ꞌaisama ꞌimima, axa aín kuëbinuax chikikë an kuni ka uni ꞌaisama ꞌimia.<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Usai kikëbë a rapasu rikuasinki ka aín unikaman Jesús ñukakëxa: —¿Usakinmi ꞌunanmikëbëa a kuati fariseokama a ismina kuami kiax nishkë a karamina ꞌunan?<verse eid="MAT 15:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="MAT 15:13" />Kakëxun ka Jesusan kakëxa: —Bëtsi i ꞌën papan ꞌapakëma ax ka aín tapun këñunbi ëchikë ꞌiti ꞌikën.<verse eid="MAT 15:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 15:14" />Kamina ꞌënti ꞌain, akama ka bëxuñu ꞌikën. Bënxuñu ꞌaish ka bëtsi bëxuñubë kuani a rabëtaxbi kininu pakëtia.<verse eid="MAT 15:14" /></para>
  <para style="m">
    <verse number="15" style="v" sid="MAT 15:15" />Pedronën ka Jesús kakëxa: —Nukamina mix kikë a ñuixunti ꞌain.<verse eid="MAT 15:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 15:16" />Kia ka Jesusan kakëxa: —¿Mitsunbi karamina ꞌën kia kuatiman?<verse eid="MAT 15:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="MAT 15:17" />Kamabi kuëbitan atsinkë an ka pukunu kuania, anuax ka chikitia.<verse eid="MAT 15:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 15:18" />ꞌAibi ka axa nun kuëbinuax chikikë ax nun sinánuax chikitia, usa ꞌixun ka an uni ꞌaisama ꞌimia.<verse eid="MAT 15:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="MAT 15:19" />Usa ꞌain ka uninuax sinán ꞌaisama chikitia, rëananti, xanubë ꞌikin aín nami ꞌati, mëkamati, këmëti, chichananti.<verse eid="MAT 15:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="MAT 15:20" />Ënë ñukaman ka uni ꞌaisama ꞌimia; ꞌaibi ka mëchukaxuma pikë an uni ꞌaisama ꞌimima.<verse eid="MAT 15:20" /></para>
  <para style="s">Judioma xanu sinan kushi ꞌia</para>
  <para style="r">(<ref loc="MRK 7:24-30">Mr 7.24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Jesús ka anuax Tiro ꞌimainun Sidón menu kuankëxa.<verse eid="MAT 15:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="MAT 15:22" />Achúshi xanu Canaan menu ꞌikë ax ka kuënkënkiani a ꞌurama obiani ësai kiakëxa: —¡ꞌËn ꞌIbu Davitan Bëchikë ꞌë ka nuibakin ꞌakin, ꞌën xanu tuá ka ñunshin ꞌatimañu ꞌaish ꞌitsaíira tëmëraia!<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />Kia ka Jesusan uisakibi kama ꞌikën. Kaiama ka aín unikaman kakëxa: —Ënë xanu kamina kuantanun kati ꞌain, ka kuënkën kuatsini nunu uaxa.<verse eid="MAT 15:23" /></para>
  <para style="m">
    <verse number="24" style="v" sid="MAT 15:24" />Jesús ka kiakëxa: —Diosan ka ꞌë Israel ëmanuishi, ꞌikë ovejakama ꞌibuñumasa ꞌikë anu ꞌë xuaxa.<verse eid="MAT 15:24" /></para>
  <para style="m">
    <verse number="25" style="v" sid="MAT 15:25" />Usai kikëbë ka xanu ax rantin puruni a bëmanon tsobuti kiakëxa: —¡Ën ꞌIbu ꞌë ka ꞌakin kiakëxa!<verse eid="MAT 15:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="MAT 15:26" />Jesusan kakëxa: —Nun bëchikë bikuantankëxun pan ꞌuchiti ꞌinanti ka ꞌaisama ꞌikën.<note caller="+" style="f"><char style="fr" closed="false">15.26 </char><char style="ft" closed="false">Judiokaman ka ꞌuchiti isa kixun judioma unikama kakëxa.</char></note><verse eid="MAT 15:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="MAT 15:27" />Kia ka xanuxunribi kakëxa: —Usa ka ꞌën ꞌIbu, ꞌuchitinënbi ka aín ꞌibuan kuëënan chanuxun pikëbëtan a tëmuxun aín sanibi pakëtia pia.<verse eid="MAT 15:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="MAT 15:28" />Kia ka Jesusan kakëxa: —Xanu min sinán ka kushíira ꞌikën, usa ꞌain ka min kuëënkësa oi ꞌiti ꞌikën. Kikëbëishi ka aín tuá xanu ax pëxkuakëxa.<verse eid="MAT 15:28" /></para>
  <para style="s">Jesusan ꞌitsaíira uni ꞌinsinkë pëxkua</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Anuax chikikiani kuanx ka parúmpapa Galilea kuëbi anu Jesús bëbakëxa. Anuax ka matanu kuanx tsobuakëxa.<verse eid="MAT 15:29" /></para>
  <para style="m">
    <verse number="30" style="v" sid="MAT 15:30" />ꞌIstaíira unin ka anu timërakëti kuankin ꞌatimati nikë, ꞌimainun pëñañuma, bëxuñu, banañuma ꞌimainun bëtsi ꞌinsinkë unikamaribi anuxuan Jesusan pëxkunun a tanain nankëxa.<verse eid="MAT 15:30" /></para>
  <para style="m">
    <verse number="31" style="v" sid="MAT 15:31" />Usakian ꞌaia isi ka uni ratuakëxa, banañuma unixa banaia isanan pëñañuma unixa pëxkutia isanan, ꞌatimati nikë unixa nitsia isanan, bëxuñu uniribia bëpëxkutia ꞌisakëxa, usai ꞌikin ka Israel nuxun Dios rabiakëxa.<verse eid="MAT 15:31" /></para>
  <para style="s">Jesusan ꞌitsaíira uni pimia</para>
  <para style="r">(<ref loc="MRK 8:1-10">Mr 8.1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />Usakin ꞌatankëxun ka Jesusan aín unikama kuëntankëxun kakëxa: —Ënë unikama kana nuibatin ka rabë́ ꞌimainun achúshi nëtën ꞌëbë́ ꞌikën, aín piti ka ꞌaima ꞌikën; pimixuma kana aín xubunu xuisamatanin bain kuani ka bëënanti ꞌikën.<verse eid="MAT 15:32" /></para>
  <para style="m">
    <verse number="33" style="v" sid="MAT 15:33" />Aín unikaman ka kakëxa: ¿Uinua karana ꞌitsaíira uni pimiti piti biti ꞌain? Ënëx ka anu uni ꞌikëma me ꞌikën.<verse eid="MAT 15:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="MAT 15:34" />Jesusan ka ñukakëxa: —¿Uitiu panñu karamina mitsux ꞌain? Mëkën achúshi ꞌimainun rabë́ panbë ka tsatsa ꞌitsamashi anu ꞌikën, kixun ka atun kakëxa.<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />Usa ꞌain ka kamabi uni tsobunun kixun kakëxa.<verse eid="MAT 15:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="MAT 15:36" />Mëkën achúshi ꞌimainun rabë́ pan këñun tsatsa bikin ka nukën Papa Dios asabi ka kixun kakin aín unikaman, tukapakin atu mëti kakëxa.<verse eid="MAT 15:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MAT 15:37" />Kamaxunbi ka puchakin piakëxa, aín tëxëkë ka mëkën achúshi ꞌimainun rabë́ kakí uakakin biakëxa.<verse eid="MAT 15:37" /></para>
  <para style="m">
    <verse number="38" style="v" sid="MAT 15:38" />An pikë ax ka cuatro mil uni bëbu xanu ꞌimainun tuakamaribi, tupunkëma ꞌaish ꞌitsaíira ꞌiakëxa.<verse eid="MAT 15:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="MAT 15:39" />Usakin ꞌatankëxun unikama xubiani ka Jesús manë nuntinu ꞌirukiani Magadán menu kuankëxa.<note caller="+" style="f"><char style="fr" closed="false">15.39 </char><char style="ft" closed="false">Magadán ënën ka kia aín pasa Biblinua Magdala.</char></note><verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">Ñu ꞌunankama an iskëma ñu ꞌanun ka</para>
  <para style="r">(<ref loc="MRK 8:11-13">Mr 8.11-13</ref>; <ref loc="LUK 12:54-56">Lc 12.54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Fariseokama ꞌimainun Saduceokama ka anu kuaxun Jesús ami manánuxun, tankatsi kixun asérabi kara Diosnua ukë ꞌikë kixun isa unin ꞌakëma bëtsi ñu ꞌanun kixun kakëxa.<verse eid="MAT 16:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="MAT 16:2" />ꞌAibi ka Jesusan kakëxa: —Mikama kaina bari kuabukëbëtan naí isi kikanin: “Nëtë ka xonsakë ꞌikën, imëishi ka nëtë upí pë́karati ꞌikën”.<verse eid="MAT 16:2" /></para>
  <para style="m">
    <verse number="3" style="v" sid="MAT 16:3" />Pë́karakë ꞌain kamina: “Kikani bërí ka nëtë ꞌaisama ꞌiti ꞌikën”. Naí ka xonsa ꞌimainun kurunëtëaxa kikanin. Uisa ꞌixun kaina usa ñu ka naínua ꞌiti ꞌikë, kixun upiokin ꞌunankibi míkaman. ¿Uisa kupí kaina bëtsi unin ꞌakëma ñu ꞌanun ꞌë kain, ënë nëtënuxun ꞌën ꞌakë ñukama a kaina sinanima?<verse eid="MAT 16:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MAT 16:4" />Ënë uni ꞌaisamakama, ka a iskëma bëtsi ñukama ꞌanun ꞌë kaia, ꞌaibi kana Jonás iasai ꞌitima aín,<note caller="+" style="f"><char style="fr" closed="false">16.4 </char><char style="ft" closed="false">Rabë́ ꞌimainun achui nëtëa Jonás tsatsa ꞌani pukunu ꞌia an ka, usaia Jesús rabë́ ꞌimainun achui nëtën mainkë ꞌiti ꞌiakëxa.</char></note> usaira kana ꞌitima ꞌai, kikiani ka Jesús kuankëxa.<verse eid="MAT 16:4" /></para>
  <para style="s">Anun pan chamiti ñusa ka fariseokama ꞌikën</para>
  <para style="r">(<ref loc="MRK 8:14-21">Mr 8.14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Baka ꞌukëmanan kuankin ka Jesús ꞌimainun aín unikaman a piti pan manubiankëxa.<verse eid="MAT 16:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="MAT 16:6" />Usa ꞌain ka Jesusan kakëxa: Fariseo ꞌimainun Saduceo, unikaman ka anun pan chamiti ñusa aín bana ꞌikën, usaribi ꞌitima kupin kamina bëruankati ꞌain.<verse eid="MAT 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 16:7" />Kikëbë ka aín unikama kánani kiakëxa: —Nun pan bëkëma kupin ka kia: kiax kanankëxa.<verse eid="MAT 16:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MAT 16:8" />Jesusan ka usai kanania ꞌunankin kakëxa: —¿Uisa kupin kaina pan ñuma kana ꞌai kikanin? ¡ꞌËmi kamina chukumashi mikama sinani!.<verse eid="MAT 16:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="MAT 16:9" />¿Mëkën achúshi pan ꞌën pimikëxuan cinco mil unikama pikin tëxëokë ami kakimi bikë a kaina, uiti kaki buchuakin kaina bia kixun sinániman?<verse eid="MAT 16:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="MAT 16:10" />¿Mëkën achúshi ꞌimainun rabë́ pan ꞌën cuatro mil unikama pimikëxa tëxëkë ꞌikëmi. Bikë abi kaina, uiti kaki kaina bia kixun sinániman?<verse eid="MAT 16:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 16:11" />¿Uisa kupí kaina mikama pan ira ñui kana kikëma ꞌai kixun ꞌunanima? Kamina bëruankati ꞌain fariseo ꞌimanun saduceokama banax ka anun pan chamiti ñusa ꞌikën.<verse eid="MAT 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 16:12" />Ësakin Jesusan kakëxun ka aín unikaman anun pan, chamiti ñu ñuikësa okin kakinbi ka fariseo unikamabëtan saduceo unikaman ñuixunkë a banax ka këmë ꞌikë kixun, sinánkin a bana kuaxuma ꞌanun ka nukama kaxa kixun ꞌunankëxa.<verse eid="MAT 16:12" /></para>
  <para style="s">Pedronën ka Jesús Mesías kaina ꞌai kakëxa</para>
  <para style="r">(<ref loc="MRK 8:27-30">Mr 8.27-30</ref>; <ref loc="LUK 9:18-21">Lc 9.18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Usakin katankëx Cesárea Filipo menu bëbaxun ka, Jesusan aín unikama ñukakëxa: ¿Uisai kara unikama Unin Bëchikë ñui kin?<verse eid="MAT 16:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 16:14" />Ñukákëxun ka atun kakëxa: Bëtsin ka kia min ismina Juan an uni nashimikë ꞌain; rairinëx ka min ismina Elías ꞌain, ꞌimainun patsanën ribi ka kia Jeremías ꞌima isamina bëtsi profeta ꞌai kia.<verse eid="MAT 16:14" /></para>
  <para style="m">
    <verse number="15" style="v" sid="MAT 16:15" />¿Mitsux karamina ui karana ꞌëx ꞌai kin? Kixun ñukakëxa.<verse eid="MAT 16:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 16:16" />Simón Pedronën ka kakëxa: Mix kaina Mesías a ꞌain, Diosan bëchikë bamatima oi tsókë a ꞌain.<verse eid="MAT 16:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="MAT 16:17" />Usa ꞌain ka Jesusan kakëxa: Chuámarua ka, Simón Jonasnën bëchikë min kaina unin kakëxun ënë ꞌunankëma ꞌain, ꞌën Papa naínu ꞌikë an ka mi ꞌunamiaxa uinu ꞌikë uninbi ka mi unámikëma ꞌikën.<verse eid="MAT 16:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 16:18" />ꞌËn kana mi kain, min kaina Pedro ꞌain, usa ꞌai kana ënë maxá kamana kamina Iglesia ꞌati ꞌain; bamati anbia ꞌaisama otima ꞌinun.<verse eid="MAT 16:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="MAT 16:19" />Mi kana anunmi naíkamëonu xëokati ꞌinanti ꞌain; min ënë menu tëkërëkakë ñu an ka naíkamëonu tëkërëkakë ꞌiti ꞌikën, min ënë menu tubukë ñu ka naikamëonuribi tubukë ꞌiti ꞌikën.<verse eid="MAT 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20" />Anu ka Jesusan aín unikama kakëxa, uibi kamina ꞌëx kana Mesías ꞌai kixun katima ꞌain.<verse eid="MAT 16:20" /></para>
  <para style="s">Jesús aín bamati ñui kia</para>
  <para style="r">(<ref loc="MRK 8:31-9:1">Mr 8.31—9.1</ref>; <ref loc="LUK 9:22-27">Lc 9.22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Ësakin katankëxun ka Jesusan aín unikama Jerusalénu kuanti ka kixun kakëxa: —Anuxun ka uni apan Sacerdote ꞌimainun an ñu ꞌunánkë unikamanribi ꞌaisamaiira okin tëmëramitankëxun, ꞌë rëtëti ꞌikën, ꞌaibi kana rabë́ ꞌimainun achui nëtë ꞌikëbë baiskiti ꞌain.<verse eid="MAT 16:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="MAT 16:22" />Usai kia ka Pedronën ꞌuri ubaxun Jesús kakëxa: —¡Diosan ka mix usai ꞌiti kuëënima usai kaina ꞌitima ꞌain.<verse eid="MAT 16:22" /></para>
  <para style="m">
    <verse number="23" style="v" sid="MAT 16:23" />Usakin kakë kuainakëki ka Jesusan Pedro kakëxa: —¡ꞌË ꞌuramanua ka kuantan ñunshin atima! Min kaina ꞌë ñu ꞌaisama ꞌamitisa tani, min kaina Diosan iskësoki isima, unin iskësokin kaina isin.<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Katankëxun ka Jesusan aín unikama kakëxa: —Uix kara ꞌën uni ꞌisatania an ka kamabi manukin curuz papixun ꞌë nuiti ꞌikën.<verse eid="MAT 16:24" /></para>
  <para style="m">
    <verse number="25" style="v" sid="MAT 16:25" />Uix kara ꞌën kana ꞌëxi iëti ꞌai kixun sinania an ka iëtima ꞌikën; ꞌaibi ka uix kara ꞌë kupí bamaia ax ka iëti ꞌikën.<verse eid="MAT 16:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="MAT 16:26" />¿Añu ñubi ka unin ënë nëtënua kanan kibi ubantima ꞌikë, ꞌaibi ka uni aín rara itsi nëtëtimabi upí ꞌitima ꞌikën? ¿Uiti kara unin aín tsóti kupioti ꞌik?.<verse eid="MAT 16:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="MAT 16:27" />ꞌËx Unin Bëchikë ꞌaish kana pënëíira kuatsini ën papan kushin ángelkamabë, utankëxun uisokin kara ñu ꞌakëxa, a istankëxun ꞌinanti aín.<verse eid="MAT 16:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="MAT 16:28" />Kana mi asérabi kain, ënu bërí ꞌikëkama aín patsankama bamakëma pain ꞌixun ka isti ꞌikën, Unin Bëchikë ꞌaish naíkamëonua kushíira ꞌai aia ꞌë isti ꞌikën.<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">Jesús bëtsia</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Mëkën achúshi ꞌimainun achúshi nëtë ꞌinukëbëtan ka Jesusan Pedro, Santiago ꞌimainun Juan Santiagonën xukën, akamaishi ubani ꞌain bashi matá achúshi manámi uniñuma anu kuankëxa.<verse eid="MAT 17:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="MAT 17:2" />Anuax ka atun ismainubi bëtsiakëxa, bëtsi ka aín bëmanan barin pëkakësa inun ichuakëxa, usai ꞌianan ka aín chuparibi uxuira ꞌinun pëkikë ꞌiakëxa.<verse eid="MAT 17:2" /></para>
  <para style="m">
    <verse number="3" style="v" sid="MAT 17:3" />Usai ꞌikëbëtan ka Moisés ꞌimainun Elías chikirakëti, Jesusbë banaia isakëxa.<verse eid="MAT 17:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MAT 17:4" />Usai ꞌia iskin ka Pedronën Jesús kakëxa: —Nukën ꞌIbu nuxnu ënu ꞌiti ka asabi bëri ꞌikën, mixmi kuënkëbëtan kana rabë́ ꞌimainun achúshi xuburatsu ꞌati ꞌain, minan achúshi ꞌimainun Moisesnan, Eliasnan ribi bëtsi ꞌati ꞌain.<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />Usakin Pedronën kakëbëtan ka kuin ꞌachúshitan anu ꞌibukin pëkakin atu mapuakëxa, usokëbëtan ka kuin mëukuax ësai kia banaia kuakëxa, ënëx ka ꞌën amiira sinánkë ꞌën bakë Bëchikë ꞌikën, usa ꞌain kamina aín bana kuati ꞌain.<verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />Ësai kia kuati ka aín unikama ꞌaisamaira tani rakuëti memi bëumpukuti tsobuakëxa.<verse eid="MAT 17:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 17:7" />Usai itsaíira rakuëtia ka anu kuankin Jesusan aín uni ramëkin ka niruk kakëxa. Rakuëaxma ka ꞌikan.<verse eid="MAT 17:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MAT 17:8" />Kakëx nirukin atun chairukin manamiokin iskëxbi ka uibi ꞌaima. ꞌImainun Jesús ishi anu ꞌiakëxa.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Usai ꞌikiani bashinuax ꞌibukiani kuankin ka Jesusan atu kakëxa: —Ënë kamina uibi ñuixuntima ꞌain. ꞌËn Unin Bëchikë ꞌaish bamatankëx baiskitamainun.<verse eid="MAT 17:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="MAT 17:10" />Kakëxun ka aín unikaman Jesús ñukakëxa: —¿Uisa kupí kara an kirika kuënëo ꞌunánkë unikaman Elías ax pain ka uti ꞌikë kin?<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />Kia ka Jesusan kakëxa: —Asérabi ka ax ꞌikën, Elías pain ka uti ꞌikën, an ka kamabi ñu uxún upiokin mënioti ꞌikën.<verse eid="MAT 17:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="MAT 17:12" />ꞌAibi kana ꞌën mitsu kain Elías ka ukëbi unin ꞌunantisama tankin atun kuëënkësa okin, uisakin kara ꞌakatsia usokin ꞌakëxa, usaribi okin ka Unin Bëchikë aish ubá ꞌikë ꞌatima okin ꞌë tëmëramiti ꞌikën.<verse eid="MAT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13" />Ësokin kakëxun ka aín unikaman ax ka Juan an uni nashimikë a ñui kia kixun ꞌunánkëxa.<verse eid="MAT 17:13" /></para>
  <para style="s">Jesusan ñunshin ꞌatimañu tuá pëxkua</para>
  <para style="r">(<ref loc="MRK 9:14-29">Mr 9.14-29</ref>; <ref loc="LUK 9:37-43">Lc 9.37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Usai ꞌikiani kuanx ka anua ꞌaisamira uni timëkë anu Jesús bëbakëxa, bëbakëbë aín bëmanon rantinpuruni tsobukin achúshi unin kakëxa:<verse eid="MAT 17:14" /></para>
  <para style="m">
    <verse number="15" style="v" sid="MAT 17:15" />—ꞌËn ꞌIbu, ꞌën bëchikë karamina nuibakin ꞌakintima ꞌain, ka ꞌaisamaira tëmërai pakëti aín nami bërëi sakiki, tsinu ꞌiruanabi bakanuribi pakëtia.<verse eid="MAT 17:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 17:16" />Usai ꞌia kana min ꞌunamikë unikamanu an ꞌë pëxkuxunun kixun bëa, ꞌaibi ka atun pëxkukëma ꞌikën.<verse eid="MAT 17:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="MAT 17:17" />Jesusan ka kakëxa: —¡Uni sinañuma aish upíma kama ñu ꞌatima atishi sinankë! ¿Uiti oishi karana mitsubë ꞌiti ꞌain? ¿Uiti okinshi karana mitsun ñu ꞌatima aia tënëti ꞌain? Ënu ka a tuá ꞌë bëxun.<verse eid="MAT 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 17:18" />Kakëxun bëia ka Jesusan a tuanu ꞌikë ñunshin ꞌatima chikinun kushin kakëxa, chikikëbë ka a tuá asabi tikiakëxa.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Usakin ꞌaia ka aín unikaman, timë́xun Jesús ñukakëxa: —¿Uisa kupin karanuna a tuanu ꞌikë ñunshin ꞌatima nukaman chikinkëma ꞌain?<verse eid="MAT 17:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="MAT 17:20" />Kakëxun ka Jesusan kakëxa: mitsun kaina upiokin sinánima, mostaza bëru<note caller="+" style="f"><char style="fr" closed="false">17.20 </char><char style="ft" closed="false">Mostaza ënxë ax ka xunu ënxësaribi aish chamara ꞌikën ꞌaibi ka apakëx chaíira inun kania.</char></note> ax ka chamaratsu ꞌikën, usaribi ꞌinun chamaratsubi upiokin sinánkë ꞌixun kaina ënë bashi ënuax ka ꞌuri takút kakëx ka amo takúti ꞌikën, usa ꞌain ka mitsun aisatankë ñux tëma ꞌitsianxa.<verse eid="MAT 17:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="MAT 17:21" />Ësa ñunshin ꞌatima chikinti kaina píima samakin, Dios ñukati ꞌain.<verse eid="MAT 17:21" /></para>
  <para style="s">Jesusan amiribi aín bamati ñuia</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Abë Galilea menu nikin ka aín unikama Jesusan kakëxa: —Unin Bëchikë ꞌikë ka, ꞌë ꞌanun unikama ꞌinanti ꞌikën.<verse eid="MAT 17:22" /></para>
  <para style="m">
    <verse number="23" style="v" sid="MAT 17:23" />ꞌAibi kana ꞌakëx bamatankëx rabë́ nëtë ꞌimainun achúshi nëtë pëkarakëbë baiskiti ꞌain, kakëxun kuati ka aín unikama ꞌitsaíira masá nuituti nitëxëakëxa.<verse eid="MAT 17:23" /></para>
  <para style="s">Anuxun Dios rabiti xubunu kuríki ꞌinanti bana</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Jesús ꞌimainun aín unikama Cafarnaúmnu bëbakëbë ka anuxun rabiti xubunu inanti kuríki bikë unikama Pedro isi kuankëxa, kuanxun ka ñukakëxa: —¿An mi ꞌunamikë unin kara xubunu inanti kuríki ꞌinanin?<verse eid="MAT 17:24" /></para>
  <para style="m">
    <verse number="25" style="v" sid="MAT 17:25" />Ñukakëxun ka Pedronën kakëxa: —Ka ꞌinania, usakin kakë basikëma ꞌainshi xubunu atsinia ka Jesusan ësakin, Pedro ñukakëxa. ¿Simón min kaina uisakin sinani?. Ui unikama kara kupionun kixun ënë menu ꞌikë ꞌapukama kain, kara ꞌain ꞌaintsikama kain, ianan kara bëtsi menu ikë unikama kain?<verse eid="MAT 17:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="MAT 17:26" />Pedronën ka kakëxa: —Bëtsi menu ꞌikë unikaman ka ꞌinania, kakëxun ka Jesusan usa ka kixun kakëxa. Aín aintsikaman ka kupioima bëtsi unikaman ka kupioia kixun kakëxa.<verse eid="MAT 17:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="MAT 17:27" />ꞌAibi kamina nun kananuna kuríki ꞌinanima uni kitima kupí parunpapanu kuaxun mishkikin apain bikë tsatsa ꞌain ananua mërakin kuríki biti ꞌain, a kuríki kamina minan ꞌimainun ënaribi ꞌinanti ꞌain.<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">Uix kara bëtsi sënëmaira ꞌiti ꞌik</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Usai ꞌikëbëtan ka aín unikaman a urama ukin Jesús ñukákin kakëxa: —¿Uix kara bëtsibëtan sënëmaira naíkamëonu ꞌiti ꞌik?<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />Jesusan ka achúshi tuá kuënxun atu nëbëtsi nitsiankëxa.<verse eid="MAT 18:2" /></para>
  <para style="m">
    <verse number="3" style="v" sid="MAT 18:3" />—Asérabi kana mitsu kain, uix kara mëniorakati sinanati ënë tuakamasa ꞌima ax uinsarabi naíkamëonu ꞌitima ꞌikën.<verse eid="MAT 18:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MAT 18:4" />Usa ꞌain ka uix kara ënë tuasaribi ꞌi chukumara ꞌia ax ka naíkamëonu chaíira ꞌiti ꞌikën.<verse eid="MAT 18:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="MAT 18:5" />Uin kara ꞌën anën achúshi tuá ësokin, bitsia an ka ꞌëmi sinánkin ꞌëribi bitsia.<verse eid="MAT 18:5" /></para>
  <para style="s">ꞌUchati rabanan bëruankati</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />Uin kara ënë tuakama ꞌëmi sinaniabi ꞌuchamia, a uni ka anun ñu rënti maxá chaíira<note caller="+" style="f"><char style="fr" closed="false">18.6 </char><char style="ft" closed="false">Piedra de molino.</char></note> aín tëxanu tëkërë katankëxun parúmpapa nëbëtsi nanëtanun nikë ꞌiti ꞌikën.<verse eid="MAT 18:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 18:7" />¡Usaribiokin ka, ꞌënë nëtënuxun unin bëtsi bëtsi ñu ꞌakin bëtsi ꞌuchamia, usai ka ꞌënë nëtënuax ꞌiti ꞌikën, ꞌaibi ka an bëtsi ꞌuchamikë unikama ax ꞌaisamaira okin, aín ucha kupin tëmëramikë ꞌiti ꞌikën!<verse eid="MAT 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8" />Usa ꞌain kamina min mëkën min taë an mi ꞌuchamikëxun tëaxun ꞌura niti ꞌain, usokin ꞌakëma ꞌaishmi min taë rabë́ min mëkën rabë́ kupin manë tsinu tëmërati ka ꞌaisama ꞌikën, usa ꞌain ka min taë, min mëkën tëaxun niti ka asabi ꞌikën.<verse eid="MAT 18:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="MAT 18:9" />Min bërun isi ꞌuchakin kamina ëchixun ꞌura niti ꞌain, min bëru achushiñu ꞌai bamatima oi tsóti ka asabi ꞌikën, min bëru rabëñu ꞌaishmi manë tsinu tëmërati ka ꞌaisama ꞌikën.<verse eid="MAT 18:9" /></para>
  <para style="s">Jesusan bëtsi bana ñuikësa okin Oveja nëtëkë ñuia</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />Ënë chamarakama achúshi kamina ñumara ka kixun ꞌaisama otima ꞌain, ꞌën kana mitsu kain, aín angelkaman ka naíkamëonuxun ꞌën Papa bëmana isia.<verse eid="MAT 18:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 18:11" />ꞌËx unin bëchikë ꞌaish kana uakën, unikama nëtëkësa ꞌaishbi ꞌëmi sinánia ꞌiëminux.<verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />¿Uisakin kaina min sinanin? Achúshi unin ka 100 ovejañu ꞌiti ꞌikën, ¿Usa ꞌain kara achúshi amanu kuani nëtëkëbëtan rairi 99 ninu ëbianxun axa nëtëkë oveja a baritima ꞌik?<verse eid="MAT 18:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="MAT 18:13" />ꞌËn kana mitsu kain axa nëtëkë a barikin mërax ka, 99 anu ꞌaia ꞌikësamairai kuëënti ꞌikën.<verse eid="MAT 18:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 18:14" />Usaribiti ka mitsun Papa naínu ꞌikë ax aín bëchikë achushirabi ꞌa ëni nëtëti kuë́ënima.<verse eid="MAT 18:14" /></para>
  <para style="s">Usai ꞌuchama inun nukën xukën kati</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />Min xukënan ñu ꞌaisama ꞌakëbë kamina abë́ banati ꞌain, ꞌañu ai kara mimi ꞌuchaxa a ꞌunamiti kupin, min kakëxun kuakin uisai karana ucha kixun ꞌunani ka asabi mibë ꞌiti ꞌikën.<verse eid="MAT 18:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 18:16" />Min xukënan kuaisama tankëbëtan kamina rabëkëñun achúshi uni bariti ꞌain, ꞌan ka añu ai kara ꞌuchaxa kixun mi kati ꞌikën.<verse eid="MAT 18:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="MAT 18:17" />Kakëxunbia ꞌatun bana kuaisama tankëbëtan kamina, Dios mi katamëkë unikama ñuixunun anu ꞌubanti ꞌain, usokin ꞌatun kakëxuribi kuaisama tania kamina ax Dios mi sinankëma unisa ianan, an kuríki Roma ꞌinanti bikë unisa ꞌitanu ënti ꞌain.<verse eid="MAT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />Asérabi kana mi kain, ënë me nuxun tëkërëkakë aribi ka nainu tëkërëkakë ꞌiti ꞌikën, ꞌimainun mitsumi ënë me nuxun tubukë aribi ka nainu tubukë ꞌiti ꞌikën.<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />ꞌËsakin kana mitsu kain min rabëxun uisa ñu karamina kuë́ëni kixun, ënë menuxun, sinantankëxun ñukátia, ka nukën Papa Dios naínu ꞌikë an mitsu inanti ꞌikën.<verse eid="MAT 18:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="MAT 18:20" />Uinu kara ꞌën unikama rabë́ ꞌimainun achúshi ꞌën anë sinani timë́tia ꞌa nëbëtsi kana ꞌëx ꞌiti ꞌain.<verse eid="MAT 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Usa ꞌain ka Pedronën anu kuanxun Jesús ñukakëxa: —Ën ꞌIbu, ¿Uiti okin karana ꞌëmi ꞌuchaia ën xukën mëniokin manumiti aín?, ¿Karana mëkën achúshi ꞌimainun rabë́ oi abë́ mënionanti ꞌain?.<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />Jesusan ka kakëxa: —Mëkën achúshi ꞌimainun rabë́ okimi manuminun kana mi kaima, uiti oishi<note caller="+" style="f"><char style="fr" closed="false">18.22 </char><char style="ft" closed="false">Setenta veces siete.</char></note> kara mimi ꞌuchati ꞌikë a kamabi kamina manumiti ꞌain.<verse eid="MAT 18:22" /></para>
  <para style="s">Unian bëtsi uni nuibaisama tan</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23" />Nukën Papa Diosan nëtë naíkamëonu ꞌiti ka ësa ꞌikën, achúshi ꞌapun ka an ñu mëëxunkë uni rabëtan kara uiti kuríki ribinia kixun istisa tanxa.<verse eid="MAT 18:23" /></para>
  <para style="m">
    <verse number="24" style="v" sid="MAT 18:24" />Istisa tankëbëtan ka an chaíira millones kuríki ribinkë uni achúshi apain bëaxa.<verse eid="MAT 18:24" /></para>
  <para style="m">
    <verse number="25" style="v" sid="MAT 18:25" />Bëkëx uxunbi ka chaíira ribinkë ꞌaish kurikiñuma ꞌixun, kupiokëma ꞌikën, kupiokëxuma ka ꞌapun aín uni kaxa, akëñun kamina an ñu mëxunkë, ꞌain xanu aín ñukama ꞌimainun ꞌain bëchikë kamabi maruxun kuríki bixun ꞌë ꞌinanti ꞌikën.<verse eid="MAT 18:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="MAT 18:26" />Usakian kakëx a tanain rantin puruni tsobukin an ribinkë uni an abi an ñu mëmikë uni kakëxa: “ꞌËn mi munu kamabi kupionun kainti ꞌain”.<verse eid="MAT 18:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="MAT 18:27" />Ësakin kakëxun nuibakin ka ꞌapun asabi ka ꞌëmi kupiokëxmabi ka asabi ꞌiti ꞌikën; usa ꞌain kamina kuanti ai kixun kakëxa.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />Kakëx kuankibi ka abëtan an ꞌapu ñumëxunkë uni aia mërakëxa, mërakin ka ënën ka ꞌë kuríki manë akë ribinia kixun ꞌain tëxatan bikin tëtsëkakin minmi ꞌë ribinkë kamina ꞌë kupioti ai kixun kakëxa.<verse eid="MAT 18:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="MAT 18:29" />Kakëxun ka abëtan ñumëkë uni an a bëtanai ranti puruni tsobukin kakëxa: —ꞌËn mi munu kupionun kamina kainti ꞌain.<verse eid="MAT 18:29" /></para>
  <para style="m">
    <verse number="30" style="v" sid="MAT 18:30" />Kakëxubi ka kuaisama tankin ꞌëmi kupionun kana mi kaima, kixun a kurikikama kupioia sipunu inun sipuakëxa.<verse eid="MAT 18:30" /></para>
  <para style="m">
    <verse number="31" style="v" sid="MAT 18:31" />Usokia ꞌaia isi ka ꞌitsaíira masá nuitukiani abëtan ñumëke rairikamax a ñumëxunkë ꞌapu ñuixuni kuanxa.<verse eid="MAT 18:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 18:32" />Kuanxun ñuixunkëxun ka an ñu më́mikë uni ꞌapun kamiakëxa, kamikëx ukë ka mix kamina ꞌaisama uni ꞌai kixun kaxa, ꞌënribi kana ꞌëmi ribinkë ꞌë kupioxuma anun mi kan.<verse eid="MAT 18:32" /></para>
  <para style="m">
    <verse number="33" style="v" sid="MAT 18:33" />Minribi karamina abëtan mi ñumëkë uni nuibatima ꞌian, ꞌën mi akësaribiokin nuibati ka iaxa.<verse eid="MAT 18:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="MAT 18:34" />Ësakin kai ꞌitsaíira aminishkin ka ꞌapun an sipu bëruankë uni kaxa, ꞌënë uni kamina më́ëkin an ꞌë ribinkë kupioia anuax tëmëranun sipuati ꞌain.<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />Usaribiokin ka ꞌën Papa Dios naínu ꞌikë an achúshi uni mitsumi ꞌuchakë kamabë upiti mënio naniama ati ꞌikën.<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">Jesús unin aín xanu ëntima kia</para>
  <para style="r">(<ref loc="MRK 10:1-12">Mr 10.1-12</ref>; <ref loc="LUK 16:18">Lc 16.18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Usa okin kakin sënëobiani ka Jesús. Galileanuax kuanx Judea me. Amiaxa bari urukë Jordán baka ukëmanan kuankëxa.<verse eid="MAT 19:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="MAT 19:2" />Kuanx bëbaia ka ꞌitsaíira unin nuibiankëxa, nuikëxun ka uni ꞌinsinkëkama pëxküakëxa.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Usakin aia ka fariseo unibunën anu timëxun uisai kara isa kia ami mananuxun kuakatsi kixun ñukakëxa: —¿Unin aín xanu ënti kara asabi ꞌik?<verse eid="MAT 19:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MAT 19:4" />Kixun ñukakëxun ka Jesusan kakëxa: —¿Mitsun kaina iskëma ꞌain nukën Papa Diosan bana kuënëo usai kikë a uniotabakin ka uni ꞌimainun xanu uniokëxa.<verse eid="MAT 19:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="MAT 19:5" />Usa ꞌain ka unin aín xanu bikin aín papakëñun aín tita ëni, ka aín xanubë biranani uni rabë́ aishbi achúshi ꞌia?<verse eid="MAT 19:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="MAT 19:6" />Unix ka aín xanubë aishbi achúshi ꞌiti ꞌikën, usa ꞌikë ka nukën Papa Diosan unio ꞌikë uni itsinribi bëtsi aín xanubë ënananu ꞌimitima ꞌikën.<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />Kakëxun ka fariseo unikaman Jesús kakëxa: Moisesnën kuëënëo bana ka ësai kia unin ka aín xanu ënkin achúshi kirika bëri kamina ꞌën xanuma ꞌai kixun atankëxun ꞌinankin ënti ꞌikën.<verse eid="MAT 19:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MAT 19:8" />Kakëxun ka Jesusan kakëxa: —Mitsun masankin sinánkë kupí ka a bana Moisesnën kuënëomiakëxa, uni unio tabati ka nukën Papa Dios unin ka aín xanu ënti ꞌikë kiama ꞌikën.<verse eid="MAT 19:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="MAT 19:9" />ꞌËn kana ësokin mitsu kain, uin kara aín xanu uni ꞌitsibë ꞌikëmabi ënia ax ka aín xanu mi ꞌuchaia, aín xanuma ꞌaibi xanu ꞌitsibë ꞌikësaribiti.<verse eid="MAT 19:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="MAT 19:10" />Usa okin kakëxun ka aín unikama kakëxa: —Usa aín ka unin xanu biti ꞌaisama ꞌiti ꞌikën.<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />Kakëxun ka Jesusan aín unikama kakëxa: —Kamabi unira ka ënë bana kuatima ꞌikën, usa ꞌain ka uin kara nukën Papa Dios sinania a uninshi kuati ꞌikën.<verse eid="MAT 19:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="MAT 19:12" />Anu ka ꞌitsaíira ñu an uni xanu bisama okë ꞌikën: bëtsi ka xanu bitimaoi nachikitia, bëtsi ka unin xanu bitima okin bëtsioia, anu ka an xanu bisama tankin Diosan bana ꞌati kuë́ëni usabi nitsia. Uin kara ënë kuatia an ka kuati ꞌikën.<verse eid="MAT 19:12" /></para>
  <para style="s">Jesusan tuakama upiokin sinanxuan</para>
  <para style="r">(<ref loc="MRK 10:13-16">Mr 10.13-16</ref>; <ref loc="LUK 18:15-17">Lc 18.15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Rairi tuakama ka Jesusnu ubankëxa aín mëkënan ramëkian ñukaxunu, aín unikaman ka ënu bëxuma ka ubantan kixun kakëxa.<verse eid="MAT 19:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 19:14" />Kaiabi ka Jesusan kakëxa: —Kuantanu kaxuma ka tuakama ꞌënua unun ka ën, nukën Papa Diosan nëtë naíkamëonu ꞌiti ax ka ënë tuakamasaribi ꞌiti ꞌikën.<verse eid="MAT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 19:15" />Ësakin katankëxun a tuakama ramëkin upiokin sinanxuntankëx anuax Jesús kuankëxa.<verse eid="MAT 19:15" /></para>
  <para style="s">Kurikiñu bëná uni Jesusbë bana</para>
  <para style="r">(<ref loc="MRK 10:17-31">Mr 10.17-31</ref>; <ref loc="LUK 18:18-30">Lc 18.18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Usa ꞌain ka bëna uni achúshi an Jesús isi kuanxun kakëxa. An ñu ꞌunamikë upí uni: —¿An ñu ꞌunánkë nuibanankë, ¿Añu ñu karana nëtëtima oi tsonuxun ati ꞌain?<verse eid="MAT 19:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="MAT 19:17" />Jesusan ka kakëxa: —¿Uisa kupí kaina ꞌën ꞌisana upí ꞌai kixun ꞌë kain? Uixbi ka upíma ꞌikën, ꞌaibi ka achúshi upí anu ꞌikën, ax ka nukën Papa Dios ꞌikën, mix aín nëtënu abë́ ꞌisatankin kamina aín banakama kikësabi okin ꞌati ꞌain.<verse eid="MAT 19:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 19:18" />Kakëxun ka bëná uni an Jesús kakëxa: Uisa banakama karana ꞌati ꞌain, kakëxun ka Jesusan kakëxa: —Uni kamina ꞌatima ꞌain, uni itsin xanubë kamina ꞌitima ꞌain, ñu kamina mëkamatima ꞌain, bëtsi uni mi kamina ꞌatimati banatima ꞌain.<verse eid="MAT 19:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="MAT 19:19" />Min papa, min tita kakëxun kamina upiokin kuakin tanti ꞌain, mix bëruonkakë usaribi okin kamina bësti uniribi nuibakin bëruanti ꞌain.<verse eid="MAT 19:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="MAT 19:20" />—Kamabi ënë ñu kana bëná ixunbi akën —¿Añuribi karana akëmapan ꞌain?<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />Jesusan kakëxa: —Mix Dios kuënkësabioi ꞌisa tankin kamina kuanxun min ñukama maruxun kuríki bixun ñuñuma unikama ꞌakinti ꞌain, usakin ꞌai kamina nukën ꞌIbu Diosan nëtë naínu ñuñuira ꞌiti ꞌain, usa ꞌain kamina ꞌëbë kuani uti ꞌain.<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />Kakëxun kuati ka bëná uni aín ñu ꞌitsaíira ꞌain masá sinábiani kuankëxa.<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />Jesúsan aín unikama kakëxa: —ꞌËn kana asérabi mikama kain, tëiira ka ñuñu unix naíkamëonu ꞌiti ꞌikë.<verse eid="MAT 19:23" /></para>
  <para style="m">
    <verse number="24" style="v" sid="MAT 19:24" />Amiribishi kana mitsu kain, camellonëa<note caller="+" style="f"><char style="fr" closed="false">19.24 </char><char style="ft" closed="false">Ñuina chaíira ax xumuxan kinin atsinti ka tëmashi ꞌikën.</char></note> xumuxan kini atsinti ka tëmashi ꞌikën, usa ꞌaibi kara ñuñuira uni Diosan nëtë naíkamëonu ꞌitima ꞌik.<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />Ënë kuati ratuti sinankasmai ka: —kanankëxa. ¿Uix kara ꞌiëmikë ꞌiti ꞌik?<verse eid="MAT 19:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="MAT 19:26" />Jesusan ka iskin kakëxa: —Uninan ka të́iira ꞌikën, ꞌaibi ka Diosan ꞌati ñu të́ëma ꞌikën.<verse eid="MAT 19:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="MAT 19:27" />Ësa okin kakëxun ka Pedronën kakëxa: —Nun kananuna mibë ninuxun nun ñukama ëan, ¿Usa ꞌain karanuna añuñu nun biti ꞌain?<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />Jesusan ka kakëxa: —Kana asérabi mitsu kain nëtë ió ꞌitëkënkëbë ꞌën Unin Bëchikë ꞌaish ñu pënëirakë anu tsobukëbë kamina mikamaribi anu tsóti ꞌain, tsóbukin kamina mitsun mëkën rabë́ ꞌimainun rabë́ Israelnën bëchikënën rëbunki uisa karana oti ꞌai kixun ꞌisti ꞌain.<verse eid="MAT 19:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="MAT 19:29" />Ësakiribi kana mitsu kain, uinu ꞌikë unin kara ꞌën kuënkësabi okin ꞌanuxun aín xubu, aín xukën, aín chirabakë, aín papa, aín tita, aín xanu, aín bëchikë, aín naëkama; ëanxa a unix ka ënë nëtënu ꞌikë ñu ënkësamaíira oi ñuñuira ꞌiti ꞌikën, ꞌianan nukën ꞌIbu nëtënu bamatima oi abë́ tsóti ꞌikën.<verse eid="MAT 19:29" /></para>
  <para style="m">
    <verse number="30" style="v" sid="MAT 19:30" />ꞌAibi ka uikamax kara bërí cha ꞌaish kana upí sináñu ꞌai kixun sinani rabitia, ax cha ꞌitima ꞌikën, ꞌimainun ka uikama kara ꞌën kana ñumara ꞌai kixun sinánkë ꞌax naínu cha ꞌiti ꞌikën.<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">An naënu të́kë unikama ñui kikë bana</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />Anun Diosan nëtë naíkamëonu ꞌiti ax ka ësa ꞌikë, achúshi uni ka aín naënu uva ꞌapakëñu ꞌixun. Pëkarakëma ꞌainshi an naë mënioti uni bari kuanxa.<verse eid="MAT 20:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="MAT 20:2" />Uitiu kuríki<note caller="+" style="f"><char style="fr" closed="false">20.2 </char><char style="ft" closed="false">Achúshi kuríki ka nëtë achúshi kupioti ꞌikën. Denario.</char></note> kara achúshi nëtë kupioti ꞌikë, kixun mënioxun ka uva ꞌapakënu xuakëxa.<verse eid="MAT 20:2" /></para>
  <para style="m">
    <verse number="3" style="v" sid="MAT 20:3" />Kuantëkëxun ka bari xanarukëbëtan rairi uni ñumëima anu uni bukukë anu tsókë mërakëxa.<verse eid="MAT 20:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MAT 20:4" />Mërakin ka kakëxa: —Mikamaribi kamina ꞌën uva ꞌapakënu tëti kuanti ꞌain, uitiu karamina tëa atiu kana mi kupioti ꞌain kakëx ka kuankëxa.<verse eid="MAT 20:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="MAT 20:5" />Amiribishi ka aín ꞌibu bari manitankëx kuainakëkëbë kuantankëx, usai ꞌitankë ka bari xupibukëbë kuantëkëankëxa usai ka ꞌiakëxa.<verse eid="MAT 20:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="MAT 20:6" />Bari xupibuti bakishi kuankëbëtan ka rairi anu uni tsóti anu bukukë mërakëxa mërakin ka kakëxa: —¿Uisa kupí karamina kamabi nëtën ñumëima bukuin?<verse eid="MAT 20:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 20:7" />Kia ka kakëxa: —Uinbi ka nu barikëma ꞌikën. Kakëxun ka katëkëankëxa: —Míkamaribi kaina ꞌën naë uvas ꞌapakënu ñu mëi kuanti ꞌain.<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />Usa ꞌain ka bakishkëbëtan kuënxun naë ꞌibu uva ꞌapakë an ñumëxunkë uni kakëxa: —Axá tëkë unikama kamina kuëntankënxun kupioti ꞌain, bërí bikë amixun kamina a pain bipunkë abëtan sënënbi kupioti ꞌain.<verse eid="MAT 20:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="MAT 20:9" />Nukutia ka axa bari xupiukëbë tëi ukë aribi achúshi nëtën kupiokin kuríki kamabi sënën ꞌinanxa.<verse eid="MAT 20:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="MAT 20:10" />Nukukin ka a pain bikë unikama an sinankëxa, chaíira kuríki kana biti ꞌai kixun sinánkë ꞌaibi ka sënëbi biakëxa.<verse eid="MAT 20:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 20:11" />Usakin bitsi ka an uvas ꞌapakë aín ꞌibumi ꞌatimati banakëxa,<verse eid="MAT 20:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="MAT 20:12" />Bitsi ka kiakëxa: —Axa bëri ukë an ka bënëkishin achúshi okin ñu mëaxa ꞌaibi, kamina nukë kupiokësabi okin atu kupión nun kananuna barin xaromainun chaíira të́a.<verse eid="MAT 20:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="MAT 20:13" />ꞌAibi ka aín ꞌibun a unikama achúshi kakëxa: —ꞌunánkë uni: kais ꞌën kana mi ꞌatima okëma ꞌaín. ¿Mibë kananuna banakëma ꞌain, achúshi nëtën tëkë mi kupíoti?<verse eid="MAT 20:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 20:14" />Min kuríki bibiani kamina kuanti ꞌain. Tsiankin bikë aribi kana mi ꞌinankë, usaribi ꞌinanti ꞌain.<verse eid="MAT 20:14" /></para>
  <para style="m">
    <verse number="15" style="v" sid="MAT 20:15" />¿ꞌËn kana ꞌën kuë́ënkësa okin ꞌën kurikinën ꞌati ꞌain? ¿Ëx akianankë kupin kaina ꞌëmi ꞌatimakin sinánin?<verse eid="MAT 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16" />Usa ꞌain ka an tsiankë, ax rëkuënkë ꞌiti ꞌikën, a bëri rëkuënkë aribi ka tsiankë ꞌiti ꞌikë.<verse eid="MAT 20:16" /></para>
  <para style="s">Jesusan aín bamati ñuitëkëan</para>
  <para style="r">(<ref loc="MRK 10:32-34">Mr 10.32-34</ref>; <ref loc="LUK 18:31-34">Lc 18.31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Jesusan ka bain Jerusalénu kuankin mëkën rabë́ ꞌimainun rabë́ aín unikama amo kuënxun kakëxa.<verse eid="MAT 20:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 20:18" />Mikama iskësabi kana bëri Jerusalénu, kuani anuxun ka Unin Bëchikë ꞌikë ꞌë Sacerdote ꞌapukama, ꞌimainun ñu ꞌunan unikama ꞌinankëxun ꞌë rëtëti ꞌikën;<verse eid="MAT 20:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="MAT 20:19" />Ka ꞌinanti ꞌikë bëtsi menu ꞌikë unikamaribi, ami kuaianan usanki tushukati ꞌikën; mëki rëtëti ꞌkën, aibika rabë ꞌimainun achúshi tënën baiskiti ꞌikën.<verse eid="MAT 20:19" /></para>
  <para style="s">Santiago ꞌimainun Juanën titan Jesús ñuká</para>
  <para style="r">(<ref loc="MRK 10:35-45">Mr 10.35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Usa ꞌain Zebedeonën bëchikëkaman tita aín tuakama Jesús ꞌurama kuax rantin puruni aín bëmanon tsobukin ñu ꞌaxunun ñukakëxa.<verse eid="MAT 20:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="MAT 20:21" />Jesusan ka ñukakëxa: —¿Añu karamina kuë́ënin? A xanun ka kakëxa: —ꞌËn tuá rabë́ ënëx min nëtë naíkamëonu mibë ꞌapu ꞌinun kamina kati ꞌain, bëtsi mi mëkeu ꞌianan bëtsi mëmiu ꞌinun.<verse eid="MAT 20:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="MAT 20:22" />Jesusan ka kakëxa: —Míkaman kamina ꞌunanima añu karamina ñukati kixun. ¿ꞌËx ꞌikësaribiti karamina tëmërati ꞌaín?<verse eid="MAT 20:22" /></para>
  <para style="m">
    <verse number="23" style="v" sid="MAT 20:23" />Jesusan ka kakëxa: —Asérabi kana mi kain kamina ënë paë ꞌumpax xëati ꞌain, ꞌaibi kana uix kara ꞌën mëkeu ꞌianan ꞌën mëmiu ꞌiti ꞌikë kixun mi kaima, ꞌën Papa naínu ꞌikë ainshi ka ui kara ꞌinanti ꞌikë kixun ꞌunania.<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />Ësai kia kuati ka mëkën rabë́ aín unikama, aín xukën rabë́ ami nishakëxa.<verse eid="MAT 20:24" /></para>
  <para style="m">
    <verse number="25" style="v" sid="MAT 20:25" />ꞌAibi ka Jesusan kuënxun kakëxa: —Míkaman kamina ꞌunanin judioma ꞌapun ka aín unikama an kuënkësa okin uni ꞌanun kixun ꞌamia.<verse eid="MAT 20:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="MAT 20:26" />Usa ꞌain kamina mikama usai ꞌitima ꞌain, ꞌaibi mikama chá ꞌisa tankin bëtsi unikamaribi ꞌakinti ꞌain;<verse eid="MAT 20:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="MAT 20:27" />Mix pain cha ꞌisa tankin kamina bëtsi min nuitunënbi kuë́ënkin ꞌakinti ꞌain.<verse eid="MAT 20:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="MAT 20:28" />Usa ꞌain kana Unin Bëchikë ꞌikëa ꞌë ñu mëxunu ubama ꞌain, usai ꞌikima bëtsi ꞌakini kana uakën, ꞌimainun aisamaira uni ꞌië́minux kana ubakën.<verse eid="MAT 20:28" /></para>
  <para style="s">Jesusan rabë́ uni bëxuñu bëpëxküa</para>
  <para style="r">(<ref loc="MRK 10:46-52">Mr 10.46-52</ref>; <ref loc="LUK 18:35-43">Lc 18.35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Jericó nuax chikikiani kuania ka ꞌaisamaira unin Jesús nuibiankëxa.<verse eid="MAT 20:29" /></para>
  <para style="m">
    <verse number="30" style="v" sid="MAT 20:30" />Rabë́ uni bënxuñu ka bai ꞌurama tsoakëxa, Jesús kuainia kuakin ka munuma kuë́ënkënkin kakëxa: —ꞌËn ꞌIbu, Davitan rëbunki, nuibakin ka nu ꞌakin.<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />Unin ka kakëxa banama ka nëtët, kakëxi ka akamax nëtë́tima kushíira kuënkëni kiakëxa: —¡ꞌËn ꞌIbu, Davitan Bëchikë nuibakin ka nu ꞌakin!<verse eid="MAT 20:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 20:32" />Usa ꞌain ka Jesusan nirakëkin bëxuñukama kuënxun ñukakëxa: —¿Añu mikama kupin ꞌati kaina kuë́ënin?<verse eid="MAT 20:32" /></para>
  <para style="m">
    <verse number="33" style="v" sid="MAT 20:33" />Atun ka ësakin kakëxa: —ꞌËn ꞌIbu nukama ka bëpëxkut.<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />Jesusan ka nuibakin akama, ramëkin aín bëru mëakëxa. Usakin ꞌakëxëshi ka bëpëxkuakëxa, usai ꞌikin ka Jesús nuibiankëxa.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">Jesús Jerusalénu atsían</para>
  <para style="r">(<ref loc="MRK 11:1-11">Mr 11.1-11</ref>; <ref loc="LUK 19:28-40">Lc 19.28-40</ref>; <ref loc="JHN 12:12-19">Jn 12.12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Jerusalén ꞌurama Betfagenu nukuxun ka matá Olivos kakë anuxun ka Jesusan aín uni rabë́ ësakin kakin xuakëxa,<verse eid="MAT 21:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="MAT 21:2" />Ësakin kakin: —A ëma chumanu bëmano anua kamina ñuina cha an ñu papikë a aín tuá këñun mërati ꞌain, mërakin tubukin ë bëxunti ꞌain.<verse eid="MAT 21:2" /></para>
  <para style="m">
    <verse number="3" style="v" sid="MAT 21:3" />Uin kara mi ñukatia a kamina kati ꞌain nun ꞌIbun ka kuë́nia kixun kati ꞌain, bënënkishi ka mi ꞌinantëkënti ꞌikën.<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />Ësai ka profetakama kiasabioi ꞌianan kuënëosai ꞌiakëxa:<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />Ësakin kamina Sionu<note caller="+" style="f"><char style="fr" closed="false">21.5 </char><char style="ft" closed="false">Sión Jerusualén anë.</char></note> ꞌikë uni kati ꞌain: —Ka ís min ꞌApu ka aia, ax ka ñumara ꞌikën ñuina cha ꞌimainun ꞌain tuá bënanu tsotax ka aia.<verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />Aín unikama rabëtan ka Jesusan kakë sabiokin ꞌakëxa.<verse eid="MAT 21:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 21:7" />Bëxun ñuina cha aín tuakëñun chupa këxtu aín kaxunu nankëxa, nankëbë ka Jesús anu tsótax Jerusalénu kuankëxa.<verse eid="MAT 21:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MAT 21:8" />ꞌItsa unin ka anuan Jesús kuanti bainu chupa këxtu ꞌapakëxa, apamainun ka rainënribi ñu pëchi bixun bainu ꞌapakëxa.<verse eid="MAT 21:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="MAT 21:9" />Axa rëkuën kiankë uni ꞌimainun ax tsiankiankë kamaxribi ka sharati kiakëxa:</para>
  <para style="b" vid="MAT 21:9" />
  <para style="q1" vid="MAT 21:9">—¡Davitan Bëchikë axa nun ꞌIbu anën ukë ënë kananuna rabiti ꞌain!</para>
  <para style="q1" vid="MAT 21:9">¡Dios axa naínu ꞌikë a kamina rabiti ꞌain!<verse eid="MAT 21:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />Jesús Jerusalénu atsinkëbë ka anu ꞌikë unikama sharati kiakëxa: —¿Uikara ënëx ꞌik?<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />Kia ka unin kakëxa: —Ënëx ka profeta Jesús, Nazaret Galileanu ꞌikë a ꞌikën.<verse eid="MAT 21:11" /></para>
  <para style="s">Jesusan anuxun Dios rabiti xubu mënio</para>
  <para style="r">(<ref loc="MRK 11:15-19">Mr 11.15-19</ref>; <ref loc="LUK 19:45-48">Lc 19.45-48</ref>; <ref loc="JHN 2:13-22">Jn 2.13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Usa ꞌain ka Jesús anuxun nukën Papa Dios rabiti xubunu atsiankëxa. Atsinxun ka an ñu marukë unikama aín kuënan chá a chashkanan an uni kuríki campiokë ꞌimainun an ñumakuru marukë a ribi chikiankëxa.<verse eid="MAT 21:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="MAT 21:13" />Jesusan kakëxa: —Kuënëo bana ka ësai kia: “ꞌËn xubux ka anuxun Dios ñukati xubu ꞌikën”, ꞌaibi kamina mitsún anuxun ñumëkamati xubu ꞌimian.<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />Anuxun ka Dios rabiti xubunu kuania bëxuñu uni ꞌimainun tsásiu unikama Jesusan pëxkuakëxa.<verse eid="MAT 21:14" /></para>
  <para style="m">
    <verse number="15" style="v" sid="MAT 21:15" />ꞌAibi ka Sacerdote ꞌapukama ꞌimainun an ñu ꞌunánkë unikama uni itsin ꞌakëma ñu ꞌaia isana tuakama ribi anuxun Dios rabiti xubunua sharatia kuakëxa: —¡Davitan Bëchikë ꞌapu ꞌikë kananuna rabiti ꞌain, kia kuati nishakëxa!<verse eid="MAT 21:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 21:16" />Usa ꞌain ka atun kakëxa: —¿Ënë tuakamaxa kikë karamina kuatin? Jesusan ka kakëxa: —Usai kara ¿Kuënëo bana kikë karamina uinsarabi iskëma ꞌain? “Tuaxu ꞌimainun an xuma ꞌakë tuakëribi ka rabiti ꞌikën”.<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />Anuax ka Jerusalén ëbiani kuanx Jesús Betania menu kuankëxa, anu ka ñantabuakëxa.<verse eid="MAT 21:17" /></para>
  <para style="s">Jesusan higuera ꞌatimo</para>
  <para style="r">(<ref loc="MRK 11:12-14">Mr 11.12-14</ref>,<ref loc="MRK 11:20-26">20-26</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Ñantamashi ka Jesús Jerusalén ëmanu kuantëkëankëxa, bain kuani ka panankëxa.<verse eid="MAT 21:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="MAT 21:19" />Anuxun ka higuera achúshi isakëxa. A ꞌurama kuankin ka bai rapasu nikë bimiñuma aín pëchishi isakëxa ískin ka kakëxa: —¡Uinsarabi kamina bimiñu ꞌitima ꞌain! Kakëx ka higuera bënëtishi xanankëxa.<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />Usaia ꞌikëbë ratuti sinankasmakin ka aín unikaman Jesús ñukakëxa. ¿Uisati kara higuera bënëtishi xananx?<verse eid="MAT 21:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="MAT 21:21" />Jesusan ka kakëxa: —Kana asérabi mi kain, mitsunmi ꞌëmi sinankin këmëkima ka ꞌiti ꞌikë kixun kakëx ka ꞌën higuera ꞌakësa oiribi ꞌiti ꞌikën, ënë matá kamaribi ka parunpapanu ka kuantan kakëx ka kuanti ꞌikën.<verse eid="MAT 21:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="MAT 21:22" />Kamabi ñu mitsun abë́ banakin ami sinánkin ñukakë a kamina biti ꞌain.<verse eid="MAT 21:22" /></para>
  <para style="s">Aín kushin ka ñu ꞌati ꞌikë Jesús kia</para>
  <para style="r">(<ref loc="MRK 11:27-33">Mr 11.27-33</ref>; <ref loc="LUK 20:1-8">Lc 20.1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Usakin katankë ka Jesús anuxun nukën Papa Dios rabiti xubunu atsiankëxa: Anuxun uni ꞌunamiakëxa ꞌunamikëbë ukin anu rikiaxun sacerdote ꞌimainun judíos kaniakëkëkaman ñukakëxa: —¿Uin kara ësakin ñu ꞌanun mi kax? ¿Uin kushin karamina ënë ñu ꞌain?<verse eid="MAT 21:23" /></para>
  <para style="m">
    <verse number="24" style="v" sid="MAT 21:24" />Kakëxun ka Jesusan kakëxa: —ꞌËnribi kana mitsu ñukatin, min ꞌë kakëxun kana uin kushin karana ñu ꞌai kixun mi kati ꞌain.<verse eid="MAT 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 21:25" />¿Uin kara Juan an uni nashimikë a xuakë Diosan kara xuakëx? Mitsumi ꞌë kakëxun kana ꞌënribi ui kupin karana ënë ꞌai kixun mitsu kati ꞌain, kakëx ka bëtsibë ñukakanani kiakëxa. Diosan ka xuaxa kakëxun ka nukë kati ꞌikën, uisa kupin kaina ami sinanma ꞌain.<verse eid="MAT 21:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="MAT 21:26" />Usa ꞌain kananuna uninuax ka uakëxa kixun katima ꞌain, kananuna rakuëtin, kamaxubi ka sinania Juan ax ka profeta ꞌikë kixun.<verse eid="MAT 21:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="MAT 21:27" />Atun ka Jesús kakëxa: —Kananuna unanima kakëxa: —ꞌËnribi kana mitsu kaima uin kushin karana ꞌën ñu ꞌai kixun.<verse eid="MAT 21:27" /></para>
  <para style="s">Tuá rabë́ ñui kikë bana</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />Jesusanribi ka kakëxa: —¿Uisakin kaina ënë min sinanin? Achúshi uni ka rabë́ bëchikëñu ꞌiakëxa, a achushinën ka kakëxa: —ꞌËn bëchikë kamina naënu tëi kuanti ꞌain.<verse eid="MAT 21:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="MAT 21:29" />An ka kakëxa: “Kana kuainsamatanin”. Usa ꞌaibi ka sinanantakë kuankëxa.<verse eid="MAT 21:29" /></para>
  <para style="m">
    <verse number="30" style="v" sid="MAT 21:30" />Usakin katankëxun ka aín papan aín xukën ꞌanakaribi kakëxa, kakëx ka ësai kiakëxa, kana kuanti ꞌai kiaxbi ka kuama ꞌikën.<verse eid="MAT 21:30" /></para>
  <para style="m">
    <verse number="31" style="v" sid="MAT 21:31" />¿Uinu ꞌikë aín bëchikë rabëtan kara aín papa kikësa oi ꞌiakëx? —Kia ka atu kakëxa: —Aín bëchikë apanëx. Kia ka Jesusan kakëxa: —Asérabi kana mitsu kain an ꞌapu Romanu kupiokë ꞌimainun xanu bëkai bëtsi bëtsi nikë kara, nux ꞌisama pain ꞌain naíkamëonu ꞌiti ꞌik.<verse eid="MAT 21:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 21:32" />Juan an uni nashimikë ꞌax ka nu bai Dios kikësabioi upiti tsóti a nu unami ubaxa. ꞌAibi kamina mitsun kuaisama tan, ꞌaibi ka ꞌapu buamiti kuríki bikë ꞌimainun xanu bëkakë ꞌëmi sinamaínun mitsux ꞌëmi sinani mëniokaisama tan.<verse eid="MAT 21:32" /></para>
  <para style="s">An naë bëruankë ꞌatima unikama</para>
  <para style="r">(<ref loc="MRK 12:1-12">Mr 12.1-12</ref>; <ref loc="LUK 20:9-19">Lc 20.9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />Bëtsi bana ñuikësokin ñuikë bana ënë kamina kuakanti ꞌain: —Aín ꞌibun ka aín naënu uvas ꞌapaxun achúshi kënë ꞌaxa, ꞌaxun ka anuxun uva baka biti ꞌatankëxun ka manami chaiorukin kamabi anuxun bëruanti ꞌaxa. ꞌAtankëxun ka an me bëruankin kupioti bëtsi unimi ëbiani kuanxa.<verse eid="MAT 21:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="MAT 21:34" />Usa ꞌain ka anun ñu ꞌapakë bimia biti nëtë ꞌikëbëtan, aín ꞌibun an ñu më́mikë unikama aina ꞌinun nanxunkë a binun xuakëxa.<verse eid="MAT 21:34" /></para>
  <para style="m">
    <verse number="35" style="v" sid="MAT 21:35" />Xukëbi ka an naë bëruankë unikaman bitankëxun më́anan, bëtsi rëtëana, bëtsi kamaribi maxaxan ꞌanan ꞌaisama oxa.<verse eid="MAT 21:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="MAT 21:36" />ꞌAin ka aín ꞌibun amiribishi aín unikama bërama ꞌakësamaira okin xutëkëanxa: —ꞌAibi ka an naë bëruankë unikaman akama usaribikin ꞌaxa.<verse eid="MAT 21:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 21:37" />Usakin ꞌakë ꞌain ka, ꞌën bëchikë ënë ka uisabi otima ꞌikë kixun sinánkin xuakëxa.<verse eid="MAT 21:37" /></para>
  <para style="m">
    <verse number="38" style="v" sid="MAT 21:38" />ꞌAibi ka aín bëchkë, isi kanani an naë bëruankë unikama kiakëxa: “Ënëx ka an kamabi aín ñu biti a ꞌikën, usa ꞌain kananuna nun kamaxubi aín ñu biti rëtëti ꞌain”.<verse eid="MAT 21:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="MAT 21:39" />Usai ꞌain ka kamaxubi ñatanxun, naë ꞌuri ubanxun rëakëxa.<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />—Usa ꞌain kara naë ꞌibun bëri ukin, ¿An naë bëruankë unikama uisa okin ꞌati ꞌik?<verse eid="MAT 21:40" /></para>
  <para style="m">
    <verse number="41" style="v" sid="MAT 21:41" />A ñukakëxun ka atun kakëxa: —Ami sinankimaishi akama rëtëtankëxun, ka aín ꞌibun bëtsi uni aín naë bëruankin a kupionan, anun ꞌinanti nëtë ꞌikëbëtan, a bimi tuaia bitankëxun ꞌinanti ꞌikën.<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />Jesusan ka kakëxa:</para>
  <para style="p" vid="MAT 21:42">—¿Uinsarabi karamina mitsun kuënëo bana kara uisai kia kixun a iskëma ꞌaín?</para>
  <para style="b" vid="MAT 21:42" />
  <para style="q1" vid="MAT 21:42">“An xubu ꞌakë unikaman ꞌaisama ka kixun púa maxakama ax ka bërí maxá upí iruira ꞌikën.</para>
  <para style="q1" vid="MAT 21:42">Nukën ꞌIbun ka usaia ꞌinun ꞌimiaxa, usa ꞌain kananuna asabi ꞌain”.<verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />Usa ꞌain ka mitsu naíkamëonu tsóti ꞌimitima ꞌikën, ꞌianan ka achúshi ëma, an tuamiti a ꞌinanti ꞌikën.<verse eid="MAT 21:43" /></para>
  <para style="m">
    <verse number="44" style="v" sid="MAT 21:44" />Uix kara a maxanu nipakëtia ax ka ami të́abukë ꞌiti ꞌikën; ꞌimainun ka anua maxá nipakëkë, ax chakakin putuakë ꞌiti ꞌikën.<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />Bana itsi ñuikësa okin Jesusan bana ñuia ka sacerdotekama ꞌimainun fariseo, unikaman ami banai isa kia kixun kuakëxa.<verse eid="MAT 21:45" /></para>
  <para style="m">
    <verse number="46" style="v" sid="MAT 21:46" />Usa ꞌain ka bisatanibi unimi rakuëakëxa, Jesús ka profeta ꞌikë kixun ꞌunani.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">Bana itsi ñuikësa oi xanu biti ñui kia</para>
  <para style="r">(<ref loc="LUK 14:15-24">Lc 14.15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Amiribishi ka bana itsi ñuikësa okin Jesusan ësakin kakëxa:<verse eid="MAT 22:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="MAT 22:2" />—Naíkamëonu ꞌiti ax ka ësa ꞌikën, achúshi ꞌapun ka aín bëchikë xanu biti ësokivn ꞌamiakëxa.<note caller="+" style="f"><char style="fr" closed="false">22.2 </char><char style="ft" closed="false">Judio unikama ka anun xanu biti nëtë ꞌitsa uni timëxun ꞌakëxa.</char></note><verse eid="MAT 22:2" /></para>
  <para style="m">
    <verse number="3" style="v" sid="MAT 22:3" />ꞌAmixun ka an ñu më́mikë unikama piunun katanu kixun xuakëxa, ꞌaibi ka a kamikë unikama uisama tankëxa.<verse eid="MAT 22:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MAT 22:4" />Usa ꞌain ka amiribishi an ñu më́mikë unikama, ësakin kaxun xuakëxa: “Piti ka ꞌiaxa ꞌën ñuina xuakë këñun kana ꞌën vaca rëtëmia; usa ꞌain ka pii ríkuatsinti ꞌikën”.<verse eid="MAT 22:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="MAT 22:5" />ꞌAibi ka a kamikë kamax kuainsama tankëxa. Akama achúshi ka aín mekama isi kuanxa, bëtsix aín ñu maruti isi kuanxa,<verse eid="MAT 22:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="MAT 22:6" />ꞌImainun ka bëtsikamaribi ꞌapun ñu më́mikë unikama ꞌatimokin mëëxun rëtëaxa.<verse eid="MAT 22:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 22:7" />Usa ꞌain ka ꞌapun ꞌitsaíira nishkin, aín suntarukama ax ꞌakanankë akama ꞌanan aín ëma nëntanun xuakëxa.<verse eid="MAT 22:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MAT 22:8" />Anuxun ka aín unikama kaxa: “Piti ka ꞌiaxa ꞌaibi ka, a kamikë unikama uisama tanxa.<verse eid="MAT 22:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="MAT 22:9" />Mitsux ka kuantan bai chaa anua mërakin kamina unikama pia unun kati ꞌain”.<verse eid="MAT 22:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="MAT 22:10" />Kakëx ka an ñu më́mikë unikaman bai chanu kuankin mërakin kaiskima aín ꞌatima aín upí akamabi timëakëxa; ꞌain ka anu timëkë ax uni buchuakëxa.<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />Usa ꞌain kamikë unikama isi atsinkibi ka ꞌapun achúshi unin xanu bikënuxun pañuti chupa pañukëma mërakëxa.<verse eid="MAT 22:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="MAT 22:12" />Mërakin ka kakëxa: —¿ꞌunánkë uni, uisa ꞌai kaina xanu bikin ꞌati chupa pañuamabi atsian? Kakëbi ka uisaibi kiama ꞌikën.<verse eid="MAT 22:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="MAT 22:13" />Usa ꞌain ꞌka apun an ñu mëxunkë unikama kakëxa: —Tatanianan mëtanitankëxun kamina bëankibukënu niti ꞌain. Anuax ka ꞌain xëta ñërëxkai bënë́ti inti ꞌikën.<verse eid="MAT 22:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 22:14" />ꞌItsaíira ka kuë́nkë ꞌiti ꞌikë, ꞌaibi ka ꞌitsamashi kaiskë ꞌiti ꞌikën.<verse eid="MAT 22:14" /></para>
  <para style="s">Anun ꞌapu kupioti kuríki</para>
  <para style="r">(<ref loc="MRK 12:13-17">Mr 12.13-17</ref>; <ref loc="LUK 20:20-26">Lc 20.20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Usai ꞌitankëx ka fariseo unikama kuanx timëax uisai kara isa Jesús kia kuatsi kiax ꞌësënani kanankëxa.<verse eid="MAT 22:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 22:16" />Usakin sinanxun ka abëa nikë uni rairi këñun Herodesnën bëtsi unikamaribi katanun xuakëxa: —An ꞌUnamikë nun kananuna min kamina këmëima banakin anun Diosnu kuanti bai a ꞌunami, unixa kikë usakin ꞌakima ꞌunami, min kamina unin kuëënkësa oki ꞌaima.<verse eid="MAT 22:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="MAT 22:17" />Nu kamina kati ꞌain: ¿Nun Romanu ꞌikë ꞌapu kupioti kara asabi ꞌik? ¿Kara asabima ꞌik?<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />Jesusan ka atun ꞌatimakin sinánia iskin kakëxa: —Upisa ꞌaibi ꞌatima uni ñu ꞌaisama ꞌakë, ¿Uisa kupin karamina ë́sakin ꞌë ñukatin?<verse eid="MAT 22:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="MAT 22:19" />ꞌËka kuríki anumi ꞌapu kupiokë ꞌa ismik, kia ka kuríki achúshi bëxuankëxa,<verse eid="MAT 22:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="MAT 22:20" />Jesusan ñukakëxa: —¿Uinan kara bëmana kurikinu ꞌikë ënë ꞌimainun aín anë ënëx ꞌik?<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />Kia ka kakëxa: ax ka ꞌapunan ꞌikë kia ka Jesusan kakëxa: —Romanu ꞌikë ꞌapu kamina ainan ꞌinanti ꞌain, ꞌinanan kamina Diosribi ainan ꞌinanti ꞌain.<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />Ësakin kakëxun kuati sinankasmai itankëx ka ëbiani rikiankëxa.<verse eid="MAT 22:22" /></para>
  <para style="s">Bamatankë baiskitëkënti ñuka bana</para>
  <para style="r">(<ref loc="MRK 12:18-27">Mr 12.18-27</ref>; <ref loc="LUK 20:27-40">Lc 20.27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />A nëtënbi ka, saduceo unikama Jesús isi kuankëxa. Atun ka uni ka bamatankëx baiskitima ꞌikë kixun sinánkin ësokin Jesús ñukakëxa:<verse eid="MAT 22:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 22:24" />—An nukë ꞌunamikë Moisésnën ka ësakin kuënëokëxa, achúshi uni bëchikëñuma ꞌaish bamakëbëtan, ka aín xukënan kasunankë xanu a bixun ami bëchiti ꞌikën, ax ka aín xukën bamakë aín bëchikësa ꞌiti ꞌikën.<note caller="-" style="x"><char style="xo" closed="false">22.24 </char><char style="xt" closed="false"><ref loc="DEU 25:5-10">Dt 25.5-10</ref>.</char></note><verse eid="MAT 22:24" /></para>
  <para style="m">
    <verse number="25" style="v" sid="MAT 22:25" />Anu ka nubë mëkën achúshi ꞌimainun rabë́ xukënñu uni ꞌiakëxa. Ain apan an pain xanu biaxi bamakëxa. Ami bëchiamaxi bamakëxa, bamakëbëtan ka aín xukën bëtsi anribi kasunamëkë xanu a biakëxa.<verse eid="MAT 22:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="MAT 22:26" />Usaribiti rabë́ ian ka, rabë́ ꞌimainun achúshi ax ꞌiakëxa, usai ka mëkën achúshi ꞌimainun rabë́, a xukën kamabi këñuakëxa.<verse eid="MAT 22:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="MAT 22:27" />Usai ia kamabi bamakë ꞌain ka xanuxribi bamakëxa.<verse eid="MAT 22:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="MAT 22:28" />Asabi ka usa ꞌain kara baiskiti ꞌain, ¿Mëkën achúshi ꞌimainun rabë́ unikama aín xanu, uinu ꞌikë aín xanu kara kamaxubia a bia ꞌain ꞌiti it?<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />Jesusan ñukákëxun kakëxa: —¡Mitsun kamina kuënëo bana ꞌunankëma ꞌimainun Diosan kushi ꞌunanima!<verse eid="MAT 22:29" /></para>
  <para style="m">
    <verse number="30" style="v" sid="MAT 22:30" />Bama ꞌaish baiskitankëx ka uni ꞌimainun xanu birakatëntima ꞌikën, kamabi ka naínu ꞌikë ángel kamasaribi ꞌiti ꞌikën.<verse eid="MAT 22:30" /></para>
  <para style="m">
    <verse number="31" style="v" sid="MAT 22:31" />Bamakë kamaxa baiskiti a karamina ꞌunanima. ¿Mitsun karamina Dios kia a ꞌunaniman?<verse eid="MAT 22:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 22:32" />“ꞌËn kana Abraham, Isaac ꞌimainun Jacob<note caller="-" style="x"><char style="xo" closed="false">22.32 </char><char style="xt" closed="false"><ref loc="DEU 6:3">Dt 6.3</ref>.</char></note>aín Dios ꞌain”<note caller="+" style="f"><char style="fr" closed="false">22.32 </char><char style="ft" closed="false">ꞌËnëx ka usaia Judiokama Dios ñui kia ꞌikë.</char></note>. ¡Ax ka Dios axa bamakë ainama ꞌikë, axa tsókë ainan ꞌikën!<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />Ësai Jesús kia kuati ka unikama sinan kasmakëxa, an ꞌunamikë bana a kuati.<verse eid="MAT 22:33" /></para>
  <para style="s">Ax kikësabi oi ꞌiti bana</para>
  <para style="r">(<ref loc="MRK 12:28-34">Mr 12.28-34</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Saduceo unikama Jesusan banatanuma kakë kupí ka fariseokama timëakëxa,<verse eid="MAT 22:34" /></para>
  <para style="m">
    <verse number="35" style="v" sid="MAT 22:35" />Anuxun ka an bana ꞌunairakë achushitan tankatsi kixun Jesús ësakin kakëxa:<verse eid="MAT 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 22:36" />Ñu ꞌunánkë uni, ¿Uinu ꞌikë bana ax ira kara ax kikësabi oi ꞌiti ꞌik?<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />Jesusan ka kakëxa: —Min ꞌIbu Dios kamina nuibakin min nuitu ꞌimainun min rara itsibëtabi anan min sinanbëtabi nuibati ꞌain.<note caller="+" style="f"><char style="fr" closed="false">22.37 </char><char style="ft" closed="false">Dt. 6.5</char></note><verse eid="MAT 22:37" /></para>
  <para style="m">
    <verse number="38" style="v" sid="MAT 22:38" />Ënëx ka ax kikësabi oira ꞌiti ꞌikë, a irapain kuati bana ꞌikën.<verse eid="MAT 22:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="MAT 22:39" />ꞌAibi ka bëtsiribi anu ikë, a kuakësaribi ax ësai kia: Bëtsi uni kamina mimi bë́ruankakësa usokin nuibati ꞌain.<note caller="-" style="x"><char style="xo" closed="false">22.39 </char><char style="xt" closed="false"><ref loc="LEV 19:18">Lv 19.18</ref>.</char></note><verse eid="MAT 22:39" /></para>
  <para style="m">
    <verse number="40" style="v" sid="MAT 22:40" />Kamabi ënë bana rabë́tax ka kuënëo bana kikësabi oi ꞌianan profetakama kiásabi oi ꞌiti ꞌikën.<note caller="-" style="x"><char style="xo" closed="false">22.40 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">Lc 10.25-28</ref>; <ref loc="ROM 13:9-10">Ro 13.9-10</ref>.</char></note><verse eid="MAT 22:40" /></para>
  <para style="s">¿Uin Bëchikë kara Mesías ꞌik?</para>
  <para style="r">(<ref loc="MRK 12:35-37">Mr 12.35-37</ref>; <ref loc="LUK 20:41-44">Lc 20.41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Anu pain ꞌikë ka fariseokama,<verse eid="MAT 22:41" /></para>
  <para style="m">
    <verse number="42" style="v" sid="MAT 22:42" />Jesús ñukakëxa: —¿Ui kara Mesías ꞌikë kixun karamina mitsun sinánin? ¿Uin bëchikë ka?</para>
  <para style="p" vid="MAT 22:42">Kakëxun atun kakëxa: —Ax ka Davidtan rëbunki ꞌikën.<verse eid="MAT 22:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43" />Jesusan ka ñukakëxa: —¿Uisa kupí kara Davidtan, aín Bëru Ñunshinan, ꞌunamikëxun ꞌën ꞌIbu Mesías kakëx? Uisa kupí kara David usai kiakëx:<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />—Nukën ꞌIbun ka ꞌën ꞌIbu kaxa: “ꞌË mëkeu kamina tsóti ꞌain, ax mimi nishkë unikama ꞌën min kushi shimú ꞌimimainun<note caller="-" style="x"><char style="xo" closed="false">22.44 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Sal 110.1</ref>.</char></note>”.<verse eid="MAT 22:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45" />¿Uisa ꞌaish kara Mesías Davidnuax uti ꞌik? Davidtabi ka ꞌën ꞌIbu kamina kixun kakëxa.<verse eid="MAT 22:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46" />ꞌAibi ka a nëtën uinu ꞌikë uni achushinëbi a bana ñukakëxunkama ꞌikën, anuxun ka uinbi ñukatëkëama ꞌikën.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">Jesús fariseo ꞌimainun an ñu ꞌunánkë uni ñui kia</para>
  <para style="r">(<ref loc="MRK 12:38-40">Mr 12.38-40</ref>; <ref loc="LUK 11:37-54">Lc 11.37-54</ref>, <ref loc="LUK 20:45-47">20.45-47</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Usaiꞌ ꞌitankëxun ka uni ꞌimainun aín unikama Jesusan ësokin kakëxa:<verse eid="MAT 23:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="MAT 23:2" />—An ñu ꞌunánkë ꞌimainun fariseo unikaman ka Moisés kia sabiokin ꞌunamia.<verse eid="MAT 23:2" /></para>
  <para style="m">
    <verse number="3" style="v" sid="MAT 23:3" />Usa ꞌain kamina, mitsun an ꞌunamikësoi ꞌiti ꞌain; ꞌAibi kamina akama ꞌikësa oi ꞌitima ꞌain, atun ka ax kikësabi oi ꞌikima bëtsi ñu ꞌaia.<verse eid="MAT 23:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MAT 23:4" />Atux ka usai ꞌitima bana kia, ꞌaibi ka a bana kikësoi ꞌima, usa ꞌixun ka atun bëtsi ñu ëñëiira amixubi aín mëkën rëbubi tikaisama tania.<verse eid="MAT 23:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="MAT 23:5" />Kamabi ñu ka unin isti kupinshi ꞌaia. Atun bëmananu anan pëñanu kuënëo bana nanti kuë́ënia, ꞌanan ka chupa chaxkë anu ñu bënta bëntabu a pañuti kuë́ënia.<verse eid="MAT 23:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="MAT 23:6" />ꞌAnan ka anuxun piti upíira anu tsóti kuë́ënia, ꞌianan ka anu timë́ti xubunu rëkuëni tsóti kuë́ënia,<verse eid="MAT 23:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 23:7" />Usai ꞌikin ka unian kamaxubi upiokin kati kuë́ëanan ëmanxuribi an ñu ꞌunánkë uni kati kuë́ënia.<verse eid="MAT 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8" />ꞌAibi kamina mistux unian ꞌën ꞌibu kati kuëntima ꞌain, mitsux kamina kamaxbi xukën kamashi ꞌaín, usa ꞌaish kamina achúshi ꞌibuñuishi ꞌain.<verse eid="MAT 23:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="MAT 23:9" />Mitsun kamina ënë menuxun uibi ꞌën papa katima ꞌain, usa ꞌain ka min papa achúshi naínu ꞌikën.<verse eid="MAT 23:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="MAT 23:10" />Mitsux kamina ꞌën kana an ubankë kanun kitima ꞌain, Cristo axëshi ka an ubankë ꞌikën.<verse eid="MAT 23:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 23:11" />Uix kara bëtsi samaira ꞌisatania an ka rairi ꞌakinti ꞌikën.<verse eid="MAT 23:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="MAT 23:12" />Ax bëtsisamaira ꞌisatankë ax ka, ñumara ꞌiti ꞌikë, uix kara ñumarása ꞌikë, ax ka chamikë ꞌiti ꞌikën.<verse eid="MAT 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />—¡Anu ka mikama an kuënëo bana ꞌunánkë ꞌimainun fariseokama, upisa ꞌaibi ꞌatimakama! Min kamina anun naíkamëonu kuanti xëkuë a xëpuin, anun rairi kuainsama okin. Mitsuxribi kamina anun atsintima ꞌain, an anun kuainsa tankë akama anun atsinun ënima.<verse eid="MAT 23:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 23:14" />—¡Anu ka mikama an kuënëo bana ꞌunánkë ꞌimainun fariseo, upisa ꞌaibi ꞌatimakama! An xanu kasunamëkë kaman xubu ꞌaisama oi, ami këmëi banakin basipain ñukaxunkë; min kamina chaíira tëmëranuxun ꞌain.<verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />—¡Anu ka mikama an kuënëo bana ꞌunánkë ꞌimainun fariseo, upisa ꞌaibi ꞌatimakama! An ka me ꞌimainun parunpapanu kuankin, bana usaia ꞌiti ñuixunkin an nuiti bitsia, ax ka uni achúshi ꞌaibi rabë́ ꞌaish manëtsinu kuanun ꞌimia mitsux ꞌikësaribiti ꞌinun.<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />—¡Anu ka mikama an bëxuñukama nikinkë ꞌikën mitsux, kamina kikanin: Uin kara këmëkima anu timëti xubu rabia, an ka añu ñubi ꞌaima; ꞌaibi ka an kuri xubunu nankë rabikë, an usakinbi ꞌati ꞌikën.<verse eid="MAT 23:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="MAT 23:17" />¡Bënxuñu ꞌai sinankamakë! ¿Añu ñux ira kara ñu itsi samaira ꞌiti ꞌik: kara kuri ꞌianan, anuxun rabiti xubu chaíira, an ka kuri upíira ꞌinun ꞌimia?<verse eid="MAT 23:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 23:18" />Ësairibi kamina mitsux kikanin: “Uin kara anuxun ñuina xaroti ami asérabi sinánia, an ka ñankaishi ꞌiti ꞌikën; ꞌaibi ka anunxun ñuina xaroti anu nanti a ꞌinankatsi kixun ꞌinanti ꞌikën”.<verse eid="MAT 23:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="MAT 23:19" />¡Bëxuñukama! ¿Añu ñux kara chaa ꞌik: a ꞌinanti ꞌimainun anuxun xaroti ax kara upí ꞌiti ꞌik?<verse eid="MAT 23:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="MAT 23:20" />Uin kara anuxun ñuina xaroti ami asérabi sinánia, ax ka amishi sinánima anu ꞌikë, ñukama amiribi sinánia;<verse eid="MAT 23:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="MAT 23:21" />ꞌImainun ka uin kara anuxun rabiti xubumi sinánia ax ka ami asérabi sinánia, ꞌimainun ka Dios anu ꞌikë amiribi sinánia.<note caller="+" style="f"><char style="fr" closed="false">23.21 </char><char style="xt"><ref loc="LEV 19:12">Lv 19.12</ref></char> Anu ka kuënëo bana ësai kikë ꞌiakëxa, Dios ñui këmëi banatima, usa ꞌaika Judiokama kama anuxun Dios rabiti xubu ñui kiakëxa.</note><verse eid="MAT 23:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="MAT 23:22" />Uin kara naími okin sinánia, an ka Dios tsókë ami sinánia, usa ꞌai ka Dios anu tsókë amiribi sinánia.<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />—¡Anu ka mikama an kuënëo bana ꞌunánkë ꞌimainun fariseo, upisa ꞌaibi ꞌatima kama! Min kaina mitsun ñu ꞌapakë chamara ꞌimainun sanuira ro ꞌinanin, ꞌainbi kamina aira tanti bana ami manutin: Ax ka ñu upí ꞌati, nuibananti ꞌimainun upí sinánñu ꞌiti, a kaina bëtsi ñu ꞌakima ꞌati ꞌain.<verse eid="MAT 23:23" /></para>
  <para style="m">
    <verse number="24" style="v" sid="MAT 23:24" />¡Mikama an bëxuñukama an bëtsi nikinkë, min kamina xëatinua samun bitsin, ꞌaibi kamina camello achúshi e kësa ꞌain!<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />—¡Anu ka mikama an kuënëo bana ꞌunánkë ꞌimainun fariseo, upisa ꞌaibi ꞌatima kama! Mix kamina anun xëati ꞌimainun ami piti ratukëñu xampa kaxuishi chukakësa ꞌain, ꞌaibi kamina ꞌukëmëu mëkamati sinani, nishanankë ꞌaish upíma ꞌain.<verse eid="MAT 23:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="MAT 23:26" />¡Fariseo bënxuñukama! Aín më́u pain kamina ami xëati xampa ꞌimainun ratu chukati ꞌain, usakimi ꞌakëx ka më́u ꞌimainun ëman upí ꞌiti ꞌikën.<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />—¡Anu ka mikama an kuënëo bana ꞌunánkë ꞌimainun fariseo, upisa ꞌaibi ꞌatimakama! Míkamax kamina anu uni mainkë ꞌaish uxuanën pukukësa aín, usa ꞌaishi kamina ëman upisa ꞌain, ꞌaibi kamina mëú uni bamakë xo bukukësa ꞌianan bëtsi bëtsi chubañusa ꞌain.<verse eid="MAT 23:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="MAT 23:28" />¡Usaribi kamina mikama unin iskëx upisa ꞌaibi mëú këmëi bëtsimi nishkë ꞌain.<verse eid="MAT 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />—¡Anu ka mikama an kuënëo bana ꞌunánkë ꞌimainun fariseo, upisa ꞌaibi ꞌatimakama!, Uisa kupin kaina an bana ñuikëkama anu mainti anan, ꞌuchañumakama tankin ꞌakë a mënion!<verse eid="MAT 23:29" /></para>
  <para style="m">
    <verse number="30" style="v" sid="MAT 23:30" />Kamina kin: “Nukaman chaitiokë ꞌia a nëtën tsóba ꞌaish kananuna an profetakama rëtëa usama ꞌitsia”.<verse eid="MAT 23:30" /></para>
  <para style="m">
    <verse number="31" style="v" sid="MAT 23:31" />Mitsunbi kamina ꞌunani nukamax kananuna an profetakama rëtëa aín rëbunki ꞌai kixun.<verse eid="MAT 23:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 23:32" />Usa ꞌain kamina mitsun chaitiokë kaman pë́ua ꞌa ñukama këñuti ꞌain.<verse eid="MAT 23:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33" />—¡Runun rëbunki! ¿Uisax karamina manë tsi rëkirukë anuax mitsux abati ꞌain?<verse eid="MAT 23:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="MAT 23:34" />Usa ꞌain kana ꞌën xutin profetakama ꞌimainun uni sinañuira këñun an bana kuënëokë uni xutin. Usa ꞌaibi kamina bëtsi rëtëtankëxun i curusokënu bëntanti aín. Rairi ribi kamina ꞌanuxun bana ñui timëti xubu nuxun, më́anan bëtsi bëtsi ëma kamanuaribi bariti aín.<verse eid="MAT 23:34" /></para>
  <para style="m">
    <verse number="35" style="v" sid="MAT 23:35" />Míkaman kamina uni ꞌuchañuma kama menu ꞌain imi ꞌapakë a kupiokin, Abel ꞌuchañuma ꞌikëbi á ixun, Zacarías Berequíasnën bëchikë ribi anuxun ñuina xaroti anuxun rëtëakën.<verse eid="MAT 23:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="MAT 23:36" />Kana asérabi mitsu kain: Ënën rëbunki kamax ka tëmëramikë ꞌiti ꞌikën.<verse eid="MAT 23:36" /></para>
  <para style="s">Jesús Jerusalén kupí iñan</para>
  <para style="r">(<ref loc="LUK 13:34-35">Lc 13.34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />¡Jerusalén, Jerusalén uisa kupin kaina profetakama maxatan rëtëin, Diosan xukë ikëbi! ¡Uiti okinshi karana min bëchikë timëtisatan, atapanëan ꞌain tuá ꞌain pëchi ukë́mëu timëkësa okin, bëruan kaskëbëtabi kamina kuënkëma ꞌain!<verse eid="MAT 23:37" /></para>
  <para style="m">
    <verse number="38" style="v" sid="MAT 23:38" />Mikama xubu ka anu uni ꞌikëma rakankë ꞌiti ꞌikën.<verse eid="MAT 23:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="MAT 23:39" />Kana mi kain: —Bërí kamina ënë nëtënbi ꞌë istëkënima anun ëx uti nëtë ꞌitamianun. ¡Upíira okin rabikë ka an nukën ꞌIbu anën ukë ax ꞌiti ꞌikën!<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">Jesús anuxun rabiti xubu ka chankapakë ꞌiti ꞌikë kia</para>
  <para style="r">(<ref loc="MRK 13:1-2">Mr 13.1-2</ref>; <ref loc="LUK 21:5-6">Lc 21.5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Jesús ka anuxun Dios rabiti xubunua chikitia, aín unikaman a ꞌurama ukin Dios rabiti xubu ꞌain kata chaíira ꞌa ismiakëxa.<verse eid="MAT 24:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 24:2" />Jesusan ka kakëxa: —¿Míkaman kaina kamabi ënë isin? ꞌËn kana mi asérabi kain. Ënuax ka maxá bëtsi kamana achushirabi tikitima ꞌikën, kamabi ka masokin ruëpakë ꞌiti ꞌikën.<verse eid="MAT 24:2" /></para>
  <para style="s">Bëtsi bëtsi ñu ꞌiti ñui kia</para>
  <para style="r">(<ref loc="MRK 13:3-23">Mr 13.3-23</ref>; <ref loc="LUK 21:7-24">Lc 21.7-24</ref>, <ref loc="LUK 17:22-24">17.22-24</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Anuax ka matá Olivos kakë anu kuanx Jesús tsobuakëxa, anuxun ka aín unikama a rapasu ukin ñukakëxa: —Kamina nu kati ꞌain, uisañu kara ënë ñu kama ꞌiti ꞌikë. ¿Uinsaran kara mix uti nëtë ꞌianan, anun ënë nëtë këñuti ꞌiti ꞌik?<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />Jesusan ka kakëxa: —¡Kamina bëruankati ꞌain! Uibi ka mi parantima ꞌikën.<verse eid="MAT 24:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="MAT 24:5" />ꞌItsaíira unix ka ꞌë ñui: —ꞌËx kana Mesías ꞌai kianan, ꞌitsaíira uni paranuxun aia.<verse eid="MAT 24:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="MAT 24:6" />Míkaman kaina ka akanania kixun ñuiña kuati ꞌain, ënuax ianan amanuaxribi ꞌia kuati ꞌain, ꞌaibi kamina rakuëtima ꞌain, kamabi ënë ñu ka inuti ꞌikën, ꞌaibi ka nëtë këñutisamapain ꞌiti ꞌikën.<verse eid="MAT 24:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 24:7" />Achúshi ëma ka bëtsi ëmabë mëananti ꞌikën; achúshi ꞌëmax ka bëtsi ꞌëmabë ꞌakanani pitiuma numi ꞌianan, bëtsi mekamanu niún ꞌikëbë me shaikinuxun aia.<verse eid="MAT 24:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MAT 24:8" />Usai ꞌikëbë ka anun tëmërakin paëtanti ax taëokë ꞌiti ꞌikën.<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />—Usa ꞌaika mikama ꞌatimotankëxun rëtënun ꞌinanti ꞌikën, ꞌë kupí ka kamabi me nuax mimi nishti ꞌikën.<verse eid="MAT 24:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="MAT 24:10" />A nëtën ka ꞌitsaíira unin ꞌëmi sinanti ënti ꞌikën; ka bëtsimi nishti ꞌikën, bëtsimi nishkin ka ꞌaisama onun inanti ꞌikën.<verse eid="MAT 24:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 24:11" />ꞌItsaíira ka këmëi profetasa ꞌai mërakin uni paranti ꞌikën.<verse eid="MAT 24:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="MAT 24:12" />A nëtë ka ꞌatima ñuira ꞌiti ꞌikën, usa ꞌain ka ꞌitsaíira unin bëtsibë nuibananti ënti ꞌikën.<verse eid="MAT 24:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="MAT 24:13" />ꞌAibi ka uisa ñuira ꞌikëbëtabi ꞌëmi manutima sinánkë ax ië́kë ꞌiti ꞌikën.<verse eid="MAT 24:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 24:14" />Ënë upí bana ka kamabi menu ñuikë ꞌiti ꞌikën, kamabi menuxuan ꞌunánun, usai ꞌikëbë ka ënë nëtëkama këñuti ꞌikën.<verse eid="MAT 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />An bana ñuikë profeta Danielnën ka kuëënëokëxa, anuxun ñu upíira akë anuxun ka ñu ꞌatima xaronuxun ꞌaia, a kamina isti ꞌain. (An ënë bana iskë an ka uisai kikë kara kixun ꞌunanti ꞌikën.)<verse eid="MAT 24:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 24:16" />Usa ꞌain ka Judeanu tsokë a kamax, matanu abati ꞌikën;<verse eid="MAT 24:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="MAT 24:17" />An aín ꞌiti manan ꞌikë ax ka aín ñu bitsima ꞌabati ꞌikën;<verse eid="MAT 24:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 24:18" />Uix kara aín naënu ꞌikë ax ka aín chupa bitsi utima ꞌikën.<verse eid="MAT 24:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="MAT 24:19" />¡Të́ëmërai ka a nëtëa túkë xanukama, ꞌimainun aín tuá ꞌikukë akama ꞌiti ꞌikën!<verse eid="MAT 24:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="MAT 24:20" />Míkaman kamina Dios ñukati ꞌain, anumi abakë nëtë anun ka mita ꞌimainun anun ñu mëtima nëtë ꞌitima ꞌikën;<verse eid="MAT 24:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="MAT 24:21" />A nëtën ka uinsarabia nëtë ió ꞌain ꞌiasamaira ꞌinun tëmërati ꞌikën, ꞌimainun ka amiribishi ꞌitsaíira tëmëratima ꞌikën.<verse eid="MAT 24:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="MAT 24:22" />Diosan ka an nuibakë unikama kuë́ënia, usa ꞌain ka anun tëmërati nëtë ꞌuraira ꞌitima ꞌikën, usa ꞌaika kamabi bamasiaxa.<verse eid="MAT 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />Usa ꞌain ka bëtsi uni mikama kati ꞌikën: “Ka is ënu ka Cristo ꞌikën, kanan ꞌuri ka Cristo ꞌikë, kixun kakëxun kamina usa ka kixun sinantima ꞌain”.<verse eid="MAT 24:23" /></para>
  <para style="m">
    <verse number="24" style="v" sid="MAT 24:24" />Ka uti ꞌikë këmë Mesías ꞌimainun këmë profetakama; an ka chaíira ñu ꞌakin Diosan kaiskë unikama parankatsi kixun ꞌati ꞌikën.<verse eid="MAT 24:24" /></para>
  <para style="m">
    <verse number="25" style="v" sid="MAT 24:25" />ꞌËnë ñukama ꞌisamapain ꞌain kana mikama kain.<verse eid="MAT 24:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="MAT 24:26" />Usa ꞌain, ka mi kati ꞌikë ka is, Mesías ka ꞌanu uni ꞌikëma menu ꞌikën, kakëxbi kamina ꞌanu kuantima ꞌain. Ka is ka ënu umpukë ꞌikën kakëxbi kamina kuantima ꞌain.<verse eid="MAT 24:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="MAT 24:27" />Amiaxa bari urukëmia mëritia kanaka ami bari kuabukë amia ichukin pëkakësa, usaribi ka Unin Bëchikë ꞌaish ꞌën anun utëkënti nëtë ꞌikën.<verse eid="MAT 24:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="MAT 24:28" />Uinu kara uni achúshi bamakë ꞌikë anu ka xëtë timëa bukunuxun aia.<verse eid="MAT 24:28" /></para>
  <para style="s">Anua Unin Bëchikë utëkënti nëtë</para>
  <para style="r">(<ref loc="MRK 13:24-37">Mr 13.24-37</ref>; <ref loc="LUK 17:26-30">Lc 17.26-30</ref>,<ref loc="LUK 17:34-35">34-35</ref>, <ref loc="LUK 21:25-33">21.25-33</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />Bënëtishi ka anun tëmërakë nëtëkama inukëma ꞌainshi ka bari bëankimainu, ꞌuxë bakish mainun ꞌisparibi nainuax rëukunuxun ꞌaia, ꞌimainun ka naínu ꞌikë ñukamaribi shaikinuxun ꞌaia.<verse eid="MAT 24:29" /></para>
  <para style="m">
    <verse number="30" style="v" sid="MAT 24:30" />Usai ꞌikëbëtan ka naínua bëtsi ñu ꞌia Unin Bëchikë isti ꞌikën, kamabi menu ikë unikama ka tëmërai inti ꞌikën, usa ꞌain ka ëx Unin Bëchikë aish nëtë kuin mëu kushíira ianan pënëíira kuatsinia isnuxun ꞌaia.<verse eid="MAT 24:30" /></para>
  <para style="m">
    <verse number="31" style="v" sid="MAT 24:31" />An ka aín ángelkama aín manë banañu këñu xuti ꞌikën, anka aín unikamabi me rabë́ ꞌimainun rabë́ sënënkënua timëanan, uinu kara nai sënëankëxa anua timënu xuti ꞌikën.<verse eid="MAT 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />Bëri kamina higueranua ꞌunanti ꞌain: xamatankëxa ꞌain, pëchi koruia iskin kamina ꞌunanti ꞌain, anun bari kuatsinti ka ꞌuramatia kixun.<verse eid="MAT 24:32" /></para>
  <para style="m">
    <verse number="33" style="v" sid="MAT 24:33" />Usaribiokin kamina ënë ñukama iskin ꞌunanti ꞌain, anun ꞌën uni bëchikë ꞌai uti nëtë ka ꞌurama ꞌikën.<verse eid="MAT 24:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="MAT 24:34" />Asérabi kana mi kain ënë ñukama ka uni ënë nëtënu ꞌikë këñutisama pan ꞌain ꞌiti ꞌikë.<verse eid="MAT 24:34" /></para>
  <para style="m">
    <verse number="35" style="v" sid="MAT 24:35" />Naí ꞌimainun me inúkëbëbi ka, ën bana inútima usabi ꞌiti ꞌikën.<verse eid="MAT 24:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />Uibi ka ꞌën anu uti nëtë ꞌunanima, nainu ꞌikë ꞌën ángelkama ꞌimainun, aín Bëchikënabi ka ꞌunanima aín Papa ainshi ka ꞌunania.<verse eid="MAT 24:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 24:37" />Noé ꞌia nëtë usaribi ka ꞌën Unin Bëchikë ꞌai utëkënti nëtë ꞌinuxun ꞌaia.<verse eid="MAT 24:37" /></para>
  <para style="m">
    <verse number="38" style="v" sid="MAT 24:38" />A nëtën ka unin baka ꞌikuatsinsamapain, Noé aín nunti chaíira anu atsintamainun pianan xëanan xanu biakëxa.<verse eid="MAT 24:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="MAT 24:39" />Atun ꞌunankëma ꞌaibi ka ꞌikuatsinkin kamabi bakán buankëxa, usaribi ka Unin Bëchikë ꞌaish ꞌën utëkënti nëtë ꞌinuxun ꞌaia.<verse eid="MAT 24:39" /></para>
  <para style="m">
    <verse number="40" style="v" sid="MAT 24:40" />Usa ꞌain ka a nëtën rabë́ uni naënu të́ëti ꞌikë, achúshi buantamainun ka bëtsi tikiti ꞌikën.<verse eid="MAT 24:40" /></para>
  <para style="m">
    <verse number="41" style="v" sid="MAT 24:41" />Xanu rabëtan ka ñu bëru rënti ꞌikë, achúshi buantamainu ka bëtsi tikiti ꞌikën.<verse eid="MAT 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42" />Usa ꞌai kamina mitsun kainti ꞌain, uisaran kara ꞌën ꞌIbu aia kixun ꞌunankimabi.<verse eid="MAT 24:42" /></para>
  <para style="m">
    <verse number="43" style="v" sid="MAT 24:43" />ꞌAibi kaina ënë ꞌunanti ꞌain, xubu ꞌibua uisaran kara ñantan mëkamakë uni aia unaxun ꞌain xubu bëruankëbë ka mëkamakë uni atsintima ꞌikën.<verse eid="MAT 24:43" /></para>
  <para style="m">
    <verse number="44" style="v" sid="MAT 24:44" />Usa ꞌain kamina míkamaribi mëniorakakë ꞌiti ꞌain; uinsaran kara Unin Bëchikë uti ꞌikë kixun ꞌunankëma ꞌaibi ka ꞌuti ꞌikën.<verse eid="MAT 24:44" /></para>
  <para style="s">A ñu më́mikë uni upí ꞌimainun ꞌatima uni</para>
  <para style="r">(<ref loc="LUK 12:41-48">Lc 12.41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />¿Uix kara an ñumëkë uni upí ꞌikë, ami ka aín ꞌibun xubunu ꞌikëkama bëruanki upioki piminu ëbiania?<verse eid="MAT 24:45" /></para>
  <para style="m">
    <verse number="46" style="v" sid="MAT 24:46" />Chuamarua ka an upiokin ñu mëia aín ꞌibun ukin mërakë an ꞌiti ꞌikën.<verse eid="MAT 24:46" /></para>
  <para style="m">
    <verse number="47" style="v" sid="MAT 24:47" />Ën kana asérabi mi kain ꞌan ñu më́ëmikë unin ka ꞌain unikamabi ñu bëruanu ënti ꞌikën.<verse eid="MAT 24:47" /></para>
  <para style="m">
    <verse number="48" style="v" sid="MAT 24:48" />ꞌAibi ka aín uni ꞌatima an ñu mëxunkë ꞌë ꞌibu ka panatia kixun sinanki,<verse eid="MAT 24:48" /></para>
  <para style="m">
    <verse number="49" style="v" sid="MAT 24:49" />An ñu më́ëkë rairikama ꞌatimonan, paënkë unikamabë biranankin abëtan piana xëai paënti ꞌikën.<verse eid="MAT 24:49" /></para>
  <para style="m">
    <verse number="50" style="v" sid="MAT 24:50" />An ñu më́ëmikë uni ka ꞌaia kixun ꞌunánkë ꞌai mabi ka uti ꞌikën,<verse eid="MAT 24:50" /></para>
  <para style="m">
    <verse number="51" style="v" sid="MAT 24:51" />Ukin ka upisa ꞌaibi ꞌatimakama këñubi tëmëramiti ꞌikë, anuax ka aín xëta ñërëxkai bënëti inti ꞌikën.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">Mëkën rabë́ xanu xuntaku</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />Ësaribi ka naíkamëonu ꞌiti ax ꞌikën mëkën rabë́ xanu xuntaku ka aín tirí tuia chikikin, aín mërati aia bikësa ꞌikën.<verse eid="MAT 25:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="MAT 25:2" />Mëkën achúshi manúkë, ꞌimainun ka mëkën achushiribi manúkëma ꞌiakëxa.<verse eid="MAT 25:2" /></para>
  <para style="m">
    <verse number="3" style="v" sid="MAT 25:3" />Mëkën achúshi ax manúkë akaman ka aín tiríkëñun xëni a ꞌaruti ubama ꞌikën.<verse eid="MAT 25:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MAT 25:4" />Usa ꞌainbi ka ax manukëma kama an ꞌain tiríkëñun xëni a këñutia ꞌaruti a këñubi ubankëxa.<verse eid="MAT 25:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="MAT 25:5" />Aín mëráti ꞌitsaíira panakëbë ka ꞌatsani ꞌuxkënan tënankëx ꞌuxakëxa.<verse eid="MAT 25:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="MAT 25:6" />Imë́naëx ꞌuxunbi ka kuënkëni sharatia kuakëxa: “¡An xanu biti uni ka aia bitsi ka chikit!”.<verse eid="MAT 25:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 25:7" />Xanu xuntakukaman ka bësui nirukin aín tirí mëniokëxa.<verse eid="MAT 25:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MAT 25:8" />Usa ꞌain ka mëkën achúshi xanu xuntaku manukëkama an manukëmakama a kakëxa: “Nukama kamina min xëni chukumashi ꞌinanti ꞌain, nun tirí ka bënamëtia”.<verse eid="MAT 25:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="MAT 25:9" />Manukëmakama an ka kakëxa: —Nun xëni ka mitsu ꞌinanti sënëma ꞌikën. Minabi kamina marui kuanti ꞌain, anuxua marukë anua, ankëtima kupí.<verse eid="MAT 25:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="MAT 25:10" />Akamaxa xëni marui kuankëbë ka ꞌain mërati ubaxa, ukëbë ka axa mëniókakë akama anuxun xanu biti anu atsinkin xëpuaxa.<verse eid="MAT 25:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 25:11" />Usai ꞌikëbë ka mëkën achúshi xanu xuntakukama an nukuti sharakin “¡ꞌËn ꞌIbu, ꞌën ꞌIbu, nu ka xëokaxun kixun kaxa!”.<verse eid="MAT 25:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="MAT 25:12" />ꞌAibi ka kakëxa: “Asérabi kana uinsarabi mikama ꞌunama ꞌain”.<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />Usa ꞌain kamina mëniokakë ꞌiti ꞌain, uinbi ka anun ëx unin bëchikë ꞌaish uti nëtë ꞌunanima.<verse eid="MAT 25:13" /></para>
  <para style="s">Rabë́ ꞌimainun achúshi uni kuríki ꞌinan</para>
  <para style="r">(<ref loc="LUK 19:11-27">Lc 19.11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />Ësaribi ka naíkamëonu Diosan nëtënu ꞌiti ax ka achúshi unia ꞌura kuankin ꞌain ñu mëëmikë kuënxun aín kurikikama ꞌinankësa ꞌikën.<verse eid="MAT 25:14" /></para>
  <para style="m">
    <verse number="15" style="v" sid="MAT 25:15" />Achúshi pain ka cinco mil ꞌinankëxa, bëtsi ka dos mil ꞌinankëxa, anuxun ka bëtsiribi mil ꞌinankëxa; Achúshi achúshi anun tëtisabi okin ꞌinabiani ka ꞌura kuankëxa.<verse eid="MAT 25:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 25:16" />An cinco mil bikë an ka anun tëkin bëtsi cinco milribi biakëxa.<verse eid="MAT 25:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="MAT 25:17" />Usaribikin ka an dos mil bikë anribi tëkin bëtsi dos milribi biakëxa.<verse eid="MAT 25:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 25:18" />ꞌAibi ka an mil bikë an kuanxun aín ꞌibun kuríki me naëxun anu umpukin maiankëxa.<verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />Usakian an ka ꞌitsa baritia, ꞌikëbë ka aín ꞌibu nukukin aín ñu mëmike unikamabëtan mënioxa.<verse eid="MAT 25:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="MAT 25:20" />An kuríki cinco mil bikë ax pain nukukin ka bëtsi cinco milribi bëaxa, bëxun ka aín ꞌapu ꞌinanxa. ꞌInakin ka ësakin kaxa: —ꞌËn ꞌibu min kaina ꞌë cinco mil ꞌinabia ꞌaibi kana cinco milribi kanán, a kënë ꞌikën.<verse eid="MAT 25:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="MAT 25:21" />Aín ꞌapun ka kaxa: —Asabi ka, mix kamina upiti të́kë uni ꞌain, chukumara mi ꞌinankë anun kamina upiti tëa, usa kupin kamina mi cha ꞌinamainun ꞌëbë kuë́ëni uti ꞌain.<verse eid="MAT 25:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="MAT 25:22" />Anua ka an dos mil bikë anribi ukin kaxa: —ꞌËn ꞌibu min kamina dos mil kuríki ꞌë ꞌinan, ꞌaibi kana dos milribi kanan, a kënë ꞌikë.<verse eid="MAT 25:22" /></para>
  <para style="m">
    <verse number="23" style="v" sid="MAT 25:23" />Aín ꞌapun ka kaxa: —Asabi ka, mix kamina upiti tëkë uni ꞌain, chukumara mi ꞌinankë anun kamina upiti të́a, usa kupin kamina mi cha ꞌinamainun ꞌëbë kuë́ëni uti ꞌain.<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />ꞌAibi ka an mil kuríki bikë an aín ꞌibu kaxa: —ꞌËn ꞌibu ꞌën kana ꞌunánkë ꞌia mix kamina achúshi uni ñunuanankë ira ꞌain, usa ꞌain kamina anu min ꞌapakëma anuabi bitsin.<verse eid="MAT 25:24" /></para>
  <para style="m">
    <verse number="25" style="v" sid="MAT 25:25" />A kupin kana rakuëkin min kuríki menu umpukin maiian, akënë ꞌikë kamina biti ꞌain.<verse eid="MAT 25:25" /></para>
  <para style="m">
    <verse number="26" style="v" sid="MAT 25:26" />Aín ꞌapun ka kaxa: —Mix kamina uni ꞌaisama chikish ꞌain min kamina ꞌunánkë ꞌian, ꞌën kana uinu karana ꞌapakëma ꞌai anuabi bianan anu sakakëma anua bitsin.<verse eid="MAT 25:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="MAT 25:27" />Ën kuríki banconu nantibi kaina ꞌia, ꞌën utëkënki an kanankë kuríki a ëora cha biti kupiꞌ.<verse eid="MAT 25:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28" />Usa ꞌain ka ꞌapun kakëxa: —Mil kuríki a kamina bikuantankëxun, an diez mil bikë a ꞌinanti ꞌain.<verse eid="MAT 25:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="MAT 25:29" />An ñu ëora ꞌakë ka cha ꞌinanti ꞌikën, ꞌinankëx ka chaíira ñuñu ꞌiti ꞌikën; ꞌaibi ka ax ñuñuma, a chamarasuñu ꞌikëbi bikuanti ꞌikën.<verse eid="MAT 25:29" /></para>
  <para style="m">
    <verse number="30" style="v" sid="MAT 25:30" />An ñu mëti ꞌunama uni, ëman ka pikú, bakish anua mi, inkin nuibakakin xëta ñërëxkai bënëtinu.<verse eid="MAT 25:30" /></para>
  <para style="s">Usai ñu ꞌikuanti bana</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />Unin Bëchikë ꞌai, ukin ꞌën pëkabësini ꞌën ángelkamabë ukëbëka, ax anu ꞌikë pënëpënëkikë anu tsonuxun ꞌain.<verse eid="MAT 25:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 25:32" />Usai ꞌikëbë ka kamabi menu ꞌikë uni a ꞌurama timënuxun ꞌaia, an ka aín timëkënua rairi amo bukunati ꞌikën, an ꞌarakakë unian oveja amo nanán cabra amo nankësaribi okin ka ꞌati ꞌikën.<verse eid="MAT 25:32" /></para>
  <para style="m">
    <verse number="33" style="v" sid="MAT 25:33" />Nankin ka ovejakama aín mëkëu nanán cabrakama aín mëmiu nanuxun ꞌaia.<verse eid="MAT 25:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="MAT 25:34" />Usa ꞌain ka ꞌapun aín mëkëu ꞌikë akama kanuxun ꞌaia: “Ënu kamina ꞌën papa upioki sinaxunkë a kamax uti ꞌain; kamina biti ꞌain, aín ꞌikënu ka minan ꞌitiokin unio me ax ꞌikën.<verse eid="MAT 25:34" /></para>
  <para style="m">
    <verse number="35" style="v" sid="MAT 25:35" />Mikama kamina pananx pisatania ꞌë pimiakë; shimakë ꞌikë kamina ꞌë xëamiakë; bëtsi me nuax ukësa ikë kamina ꞌë anu uxti ꞌinankë,<verse eid="MAT 25:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="MAT 25:36" />Chupañuma ꞌikë kamina ꞌë chupa ꞌinankë; akumakë ꞌikë kamina ꞌë ꞌakiankë; sipu mëu ꞌikë kamina ꞌë isi kuankë”.<verse eid="MAT 25:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MAT 25:37" />Usa ꞌainka an ñu upí ꞌakëma akama kanuxun ꞌaia: “Ën ꞌIbu; ¿Uinsaran karana mi panankë ꞌikë iskin mi pimiakën? ¿Uisa ñu karana mi shimakë isana mi xëamiakë?<verse eid="MAT 25:37" /></para>
  <para style="m">
    <verse number="38" style="v" sid="MAT 25:38" />¿Uisaran karana bëtsi me nuax ukësa ꞌikë anu ꞌuxti mi ꞌinanan chupa ñuma ikë mi chupa ꞌinankë?<verse eid="MAT 25:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="MAT 25:39" />¿Uinsara karana akumakë mi isanan sipu mëukua mi isi kuankën?”.<verse eid="MAT 25:39" /></para>
  <para style="m">
    <verse number="40" style="v" sid="MAT 25:40" />Kia ka ꞌapun kanuxun ꞌaia: “Kana asérabi mi kain kamabi an ꞌën xukën kupí ꞌanan chamarasubi ꞌaxunkë an ka ꞌë ꞌaxuankëxa”.<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />—Usa ꞌain ka ꞌapun aín mëmiu ꞌikë akama kati ꞌikën: “Ënuax ka kuantan ꞌaisama kama, anua këñutimaoi manëtsí rëkirukë ñunshin ꞌatima ꞌimainun aín ángelkama ꞌiti ꞌaxunkë anu.<verse eid="MAT 25:41" /></para>
  <para style="m">
    <verse number="42" style="v" sid="MAT 25:42" />Panankë ꞌikëbi kamina, ꞌë añu pitibi míkaman ꞌinama ꞌain; shimakë ꞌikëbi kaina añuñubi ꞌë xëanu ꞌinama ꞌain;<verse eid="MAT 25:42" /></para>
  <para style="m">
    <verse number="43" style="v" sid="MAT 25:43" />Anu uxtiñuma ꞌikëbi kamina ꞌë anu ꞌuxti ꞌinama ꞌain; chupa kuëniabi kamina ꞌë pañunu ꞌinama ꞌain; sipunua akumakë ikëbi kamina ꞌë ꞌakiama ꞌain”.<verse eid="MAT 25:43" /></para>
  <para style="m">
    <verse number="44" style="v" sid="MAT 25:44" />Atunribi ka kia kakëxa: “Ën ꞌIbu, uinsaran karana panankë isanan shimakë ꞌianan, ñuñumasa ꞌixun chupa kuënia sipunua akumakë mi ꞌakiama ꞌain?”.<verse eid="MAT 25:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 25:45" />An ka kanuxun ꞌaia: “Asérabi kana kin anba chamarasubi uni ñuñuma ꞌakiamakama an ka ꞌë kupibi ꞌama ꞌikën”.<verse eid="MAT 25:45" /></para>
  <para style="m">
    <verse number="46" style="v" sid="MAT 25:46" />Akamax ka anuax tëmërati anu kuanti ꞌikën ꞌimainun ka an ñu upí akë kama këñutimoi tsóti ꞌikën.<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">Jesús rëtëti ꞌësë́nan</para>
  <para style="r">(<ref loc="MRK 14:1-2">Mr 14.1-2</ref>; <ref loc="LUK 22:1-2">Lc 22.1-2</ref>; <ref loc="JHN 11:45-53">Jn 11.45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Kakin sënëonki ka Jesusan aín unikama ëtsoki kakëxa:<verse eid="MAT 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 26:2" />—Míkaman kaina ꞌunanin, rabë́ nëtë ka pishiaxa anun Pascua nëtë ꞌiti, anun ka Unin Bëchikë ꞌikë cruznu bëntanun ꞌë ꞌinanti ꞌikën.<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />A nëtën ka sacerdote ꞌapukama ꞌimainun kaniakëkë judiokama a ëmanu ꞌikë timëakëxa, sumo sacerdote Caifás ꞌain xubunu.<verse eid="MAT 26:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MAT 26:4" />Anuxun ka bixun Jesús paranxun rëtëti sinankëxa.<verse eid="MAT 26:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 26:5" />ꞌAibi ka kiakëxa: —Anun timëti nëtë kananuna ꞌatima ꞌain, ëmanu ꞌikë unikama numi nishi tsuakirutima kupí.<verse eid="MAT 26:5" /></para>
  <para style="s">Achúshi xanua ro sanuiran Jesús ꞌa</para>
  <para style="r">(<ref loc="MRK 14:3-9">Mr 14.3-9</ref>; <ref loc="JHN 12:1-8">Jn 12.1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Jesús ka Betanianu ꞌikë, Simón aín nami chankui chëkikë aín xubunu ꞌiakëxa;<verse eid="MAT 26:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 26:7" />Usai ikëbë a ꞌurama ukin ka achúishi xanun, chumu chukumara okin akë anu ro sanuíira ꞌai kupíirakë. Bëxun ka anuxun piti chanu pi tsokë ꞌain, Jesusan maxka chabokëxa.<verse eid="MAT 26:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MAT 26:8" />Usakin ꞌaia isi ka Jesusan unikama ꞌitsaíira nishakëxa: —¿Uisa kupí kaina ro kupikë ënë ampënkan<note caller="+" style="f"><char style="fr" closed="false">26.8 </char><char style="ft" closed="false">Tutukan.</char></note>?<verse eid="MAT 26:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="MAT 26:9" />Usa ꞌain ꞌitsaíira kuríki kupí marutisa ka ꞌiaxa, ñuñuma unikama anun ꞌakinti.<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Jesusan ka kia kuakin kakëxa: —¿Uisa kupin kaina ënë xanumi nishin? An ka ñu upíira ꞌë kupí ꞌaxa.<verse eid="MAT 26:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 26:11" />Kamabi nëtën kamina uni ñuñumabë ꞌinuxun ꞌain, ꞌaibi kaina kamabi nëtën ꞌëbë́ ꞌinuxuma ꞌain.<verse eid="MAT 26:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="MAT 26:12" />Usakia a xanun sanu ro, ꞌën naminu chabokë an ka ꞌë bamaia unin mainti kupí ꞌaxa.<verse eid="MAT 26:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="MAT 26:13" />Asérabi kana mi kain: Uinu ꞌikë menuxubi kara ënë bana upí ñuia, kamina ësakian xanuxun ꞌë ꞌakë aribi sinanti ꞌain.<verse eid="MAT 26:13" /></para>
  <para style="s">Judasnën Jesús uni ꞌinan</para>
  <para style="r">(<ref loc="MRK 14:10-11">Mr 14.10-11</ref>; <ref loc="LUK 22:3-6">Lc 22.3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Usa ꞌain ka mëkën rabë́ ꞌimainun rabë́ aín unikama, achúshi Judas Iscariote kakë ax sacerdote ꞌapukama isi kuanxun,<verse eid="MAT 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 26:15" />Kakëxa: —¿Añu kaina ꞌë Jesús ꞌinankëxun ꞌinanti ꞌain?.</para>
  <para style="p" vid="MAT 26:15">Usakin kakëxun ka akaman mi kana treinta kuríki ꞌinanti ꞌai kixun kakëxa.<note caller="+" style="f"><char style="fr" closed="false">26.15 </char><char style="ft" closed="false">Ënëtiu kuríki ka anu ñu mëmiti uni marutia ꞌiakëxa. (<char style="xt"><ref loc="EXO 21:32">Ex 21.32</ref>; <ref loc="ZEC 11:12">Zac 11.12</ref></char>).</char></note><verse eid="MAT 26:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 26:16" />Usakin kakëxun ka, Judasnën uisokin kara uni Jesús ꞌinanti ꞌikë kixun bariakëxa.<verse eid="MAT 26:16" /></para>
  <para style="s">Ashikin nukën ꞌIbun pía</para>
  <para style="r">(<ref loc="MRK 14:12-25">Mr 14.12-25</ref>; <ref loc="LUK 22:7-23">Lc 22.7-23</ref>; <ref loc="JHN 13:21-30">Jn 13.21-30</ref>; <ref loc="1CO 11:23-26">1 Co 11.23-26</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Anun chamiti këñuma ꞌakë pan piti nëtë taëokëbëtan, ka Jesús aín unikama a ꞌurama ukin kakëxa: —¿Uinuxun karanuna anun chamitikëñuma ꞌakë pan piti mi mënioxunti ꞌain?<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />Kia ka Jesusan kakëxa: —Ka kuantan a ëma anu ka ꞌën ꞌunánkë uni ꞌikë, a kaina kati ꞌain: “Nukën ꞌIbu ka kiaxa: ꞌËn nëtë ka ꞌurama ꞌikë, min xubunuxun kana Pascua ꞌinukin ꞌën unikamabëtan piti ꞌain”.<verse eid="MAT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 26:19" />Aín unikaman ka Jesusan kakësabiokin ꞌakëxa, kakëxun ka anuxun pascua nëtë ꞌinúkin piti mëniokëxa<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />A ñantabukëbë ka Jesús aín unikama mëkën rabë́ ꞌimainun rabë́ akamabë́ anuxun piti chanu tsóbuakëxa; <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />anuxun ka pikin kakëxa:</para>
  <para style="p" vid="MAT 26:21">—Asérabi kana mi kain achúshi min kamina ꞌë uni ꞌinanuxun ꞌain.<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />A kaman ka ꞌitsaíira masá nuituti achúshi achushitax anu kuankin ñukakëxa ¿ꞌËn ꞌIbu ꞌën karana a ꞌain?<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />Jesusan ka kakëxa: —Axa aín pan, xampanu ëbëta chabokë an ka ꞌë uni ꞌinanuxun ꞌaia.<verse eid="MAT 26:23" /></para>
  <para style="m">
    <verse number="24" style="v" sid="MAT 26:24" />Unin Bëchikë ka nikiani kuanti ꞌikë kuënëo bana kikësabi oi, ꞌaibi ka ¡Uin kara ꞌë ꞌuchoia ax ꞌë tëmëraminux! Bakëntima ꞌiakëxa.<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Usa ꞌain ka Judas an uni ꞌinanti an Jesús ñukakëxa: —ꞌËn ꞌIbu ¿ꞌËn karana a ꞌain?</para>
  <para style="p" vid="MAT 26:25">—Kia ka mix kamina a ꞌai kixun —Jesusan kakëxa.<verse eid="MAT 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Anuxun pikin ka Jesusan pan aín mëkënan bikin asabi ka kixun aín Papa Dios, kakin tukaxun, aín unikama ꞌinánkin kakëxa: —ꞌËnë ka bit, ka pit ënëx ka ꞌën nami ꞌikë.<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />Anuxun ka uvas baka xampami aín mëkëna bikin, aín Papa Dios, asabi ka kixun kakin aín unikama: —ꞌInankin kamaxunbi ka xëa kakëxa,<verse eid="MAT 26:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="MAT 26:28" />Ënëx ka ꞌën imi ꞌikë, a ꞌapati ꞌën bamakëbë a kupí ꞌitsaíira uni ꞌië́ti mitsubëtan ꞌakë ꞌikën, imi ꞌapakë ënën ka kamabi unin ꞌucha tërë́nkë ꞌiti ꞌikën.<verse eid="MAT 26:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="MAT 26:29" />ꞌAibi kana mikama kai ënuxun kana uva baka ꞌatëkënima, ꞌën Papa nëtë naíkamëonuxun mitsubëtan anun uva baka ꞌatëkënti nëtë ꞌitamainun.<verse eid="MAT 26:29" /></para>
  <para style="s">Jesús Pedro ka këmëti ꞌkë kia</para>
  <para style="r">(<ref loc="MRK 14:26-31">Mr 14.26-31</ref>; <ref loc="LUK 22:31-34">Lc 22.31-34</ref>; <ref loc="JHN 13:36-38">Jn 13.36-38</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Anuax Dios rabi salmos kantatankëx ka Jesús Olivos matánu kuankëxa<verse eid="MAT 26:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Usa ꞌain ka Jesusan aín unikama kakëxa: —Kamabi mitsun kamina ënë ñantan ꞌëmi sinánti ënti ꞌain, kuënëo bana kikësabioi:</para>
  <para style="q1" vid="MAT 26:31">“An bëruonkë rëtëkëbë ka anu ꞌikënua ovejakama aman aman kuani abisti ꞌikën”.<verse eid="MAT 26:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32" />ꞌAibi kana ꞌëa rëtëkëx baiskitankëx, mitsu rëkuën obiani Galileanu kuanti ꞌain.<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Pedronën ka kakëxa: —Aín patsanëxa mimi sinánima manúkëbëbi kana ꞌën uinsarabi manutima ꞌain.<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />Jesusan ka kakëxa: —Asérabi kana mi kai: ꞌËnë imë́bi, kamina ꞌatapa banatisamapan ꞌain, rabë́ ꞌimainun achúshi oí ꞌë isamina ꞌunanima kinuxun ꞌain.<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Pedronën ka kakëxa: Mibë bamanuxubi kana, mi kana ꞌunanima kitima ꞌain.</para>
  <para style="p" vid="MAT 26:35">Kikëbë ka kamabi ꞌain unikamaribi usaibi kikankëxa.<verse eid="MAT 26:35" /></para>
  <para style="s">Jesús Getsemaninuax banai kuan</para>
  <para style="r">(<ref loc="MRK 14:32-42">Mr 14.32-42</ref>; <ref loc="LUK 22:39-46">Lc 22.39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Usa ꞌain ka Jesús aín unikamabë Getsemaní kakë anu kuanxun kakëxa: —Ënu ka tsobukan, ꞌëx ꞌuri kuantankëx banatamainun.<verse eid="MAT 26:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 26:37" />Anuxun ka Pedro ꞌimainun Zebedeonën bëchikë rabë́ ubankëxa, anuax ꞌaisamatani masasinani nitëxëakëxa.<verse eid="MAT 26:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 26:38" />Ka kakëxa: —¡ꞌËn raraitsibi kana bamasisa tani! Ënu ka mikamax tikí, ꞌaibi kamina ꞌën ꞌikësaribiti ꞌuxtima ꞌain.<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />Katankëx rëkuënkiani ꞌurira kuantankë ka Jesús, tëtubukin aín bëmananë me tikai, abë́ banakin aín Papa kakëxa: “ꞌËn Papa min ꞌati kuë́ënki kamina tëmërati ënënua ꞌë iëmiti ꞌain; ꞌaibi ka ꞌën kuë́ënkësa oi ꞌitima ꞌikë, min kuë́ënkësabi oi ka ꞌiti ꞌikën”.<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Anu aín unikama ꞌikë anu utëkënkibi, ka ꞌuxkë mërakëxa.</para>
  <para style="p" vid="MAT 26:40">Mërakin ka Pedro kakëxa: —¿Achuira oibia bari kuaintamainun kaina ꞌëbëtabi ꞌuxkën tënëima?<verse eid="MAT 26:40" /></para>
  <para style="m">
    <verse number="41" style="v" sid="MAT 26:41" />ꞌUxkën tënëi kamina abë́ banakanti ꞌain, tankibia mikama nipatima kupí. Míkaman kamina upiokin ñu ꞌaisa tani, ꞌaibi ka min nami kushima ꞌikën.<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Amiribishi rabë́ oi kuantankëx ka ësakin kai banakëxa: “Papa, tëmërai kana ënë ꞌinúti ꞌain, min kuëënkësabi oi ka ꞌiti ꞌikën”.<verse eid="MAT 26:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43" />Ëbianx amiribishi utëkënkibi ka aín unikama ꞌuxkë mërakëxa, aín bërua ꞌuxkënan tënankëx ꞌuxakëxa.<verse eid="MAT 26:43" /></para>
  <para style="m">
    <verse number="44" style="v" sid="MAT 26:44" />Anu ëbiani, rabë́ ꞌimainun achúshi oi kuanx abë́ banakin ka anun kakë a banabi kakëxa.<verse eid="MAT 26:44" /></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 26:45" />Usa ꞌain ka anua ꞌikë anubi kuantëkënkin, aín unikama kakëxa: —¿Abi kaina mikama ꞌuxanan tantikanin? Anuan Unin Bëchikë, uni ꞌuchañukama aín mëkënu ꞌinanti bari ka sënëanxa.<verse eid="MAT 26:45" /></para>
  <para style="m">
    <verse number="46" style="v" sid="MAT 26:46" />¡Ka nirukan, kananuna kuanti ꞌain: an ꞌë ꞌaisama onun ꞌinanti ka ꞌurama ꞌikën!.<verse eid="MAT 26:46" /></para>
  <para style="s">Jesús ñatan kan</para>
  <para style="r">(<ref loc="MRK 14:43-50">Mr 14.43-50</ref>; <ref loc="LUK 22:47-53">Lc 22.47-53</ref>; <ref loc="JHN 18:2-11">Jn 18.2-11</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Jesús bana këbëbi ka, mëkën rabë́ ꞌimainun rabë́ anu ꞌikë achúshi Judas ax ubakëxa. Abë ka ꞌitsaíira uni anun ꞌakananti manë xëtokë ꞌiminun ikama bëi nukuakëxa. Usai kuani ka sacerdote, ꞌapu ꞌimainun kaniakëkë unikamaribi kuankëxa.<verse eid="MAT 26:47" /></para>
  <para style="m">
    <verse number="48" style="v" sid="MAT 26:48" />Judas an ꞌinanti an ka ësëkin kakëxa: “ꞌËn bëtsukukakë a kamina ꞌunakin biti ꞌai”.<verse eid="MAT 26:48" /></para>
  <para style="m">
    <verse number="49" style="v" sid="MAT 26:49" />Ësakin kai, a ꞌurama ukin ka Jesús kakëxa:</para>
  <para style="p" vid="MAT 26:49">—¡Kaina ñantabua kakin ka bëtsuku kakëxa!<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />Usakin ꞌakëxun ka Jesusan kakëxa: —ꞌËn ꞌunánkë, a ꞌaimi ukë a kamina ꞌati ꞌain.</para>
  <para style="p" vid="MAT 26:50">Ësakin kakëbë anu ukin ꞌurama okin ka rairinën Jesús mëkënan më́ëkin ñatankankëxa.<verse eid="MAT 26:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 26:51" />Usakin ꞌakëbëtan ka axa Jesusbë ꞌikë unikama achushinën ꞌain manë xëtokë bikin an ꞌapu sumo sacerdote ñu mëxunkë achúshi aín pabi tëakëxa.<verse eid="MAT 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52" />ꞌAia ka Jesusan kakëxa: —Min manëxëtokë kamina anumi nankënu nanti ꞌain. Kamabi axa manë xëtokë mëanankë a ka manë xëtokë ꞌakëx bamati ꞌikën.<verse eid="MAT 26:52" /></para>
  <para style="m">
    <verse number="53" style="v" sid="MAT 26:53" />¿Kaina ꞌunanima ꞌën karana katima ꞌain ꞌën Papa, aín ángelkama suntaru mëkën rabë́ ꞌimainun rabë́ bëríbi xunun kati ꞌain?<verse eid="MAT 26:53" /></para>
  <para style="m">
    <verse number="54" style="v" sid="MAT 26:54" />Ësai ikë́bëma kara, ¿Uisax Kuënëo bana kikësoibi ꞌiti ꞌik?<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Usakin ꞌakëxun ka Jesusan unikama ñukakëxa: —¿Añu kupí kaina míkaman anun ꞌakananti manë xëtokë bëanan ikama bëi ꞌë ñatani uan, uni ꞌakanankë ꞌakësa okin ꞌai uan? Kamabi nëtën nuxun Dios rabiti xubunuxun bana ꞌunamiabi kamina uinsaranbi ꞌë bikankëma ꞌain.<verse eid="MAT 26:55" /></para>
  <para style="m">
    <verse number="56" style="v" sid="MAT 26:56" />Ësaia ënë ñukama ꞌikë ënëx ka usaia ꞌiti ñuikin an bana ñuikë profetakaman kuënëosabi oí ꞌiakëxa. Usai ꞌikëbë ka aín unikama Jesús ashi ëbiani abakëxa.<verse eid="MAT 26:56" /></para>
  <para style="s">Jesús ꞌain kushikamanu uan</para>
  <para style="r">(<ref loc="MRK 14:53-65">Mr 14.53-65</ref>; <ref loc="LUK 22:54-55">Lc 22.54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:12-14">Jn 18.12-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Bitankëxun ka Jesús sumo sacerdote Caifás ꞌain xubunu ꞌuankëxa, anu ka an bana ꞌunánkë unikama ꞌimainun kaniakëkë akama timë́kë ꞌiakëxa.<verse eid="MAT 26:57" /></para>
  <para style="m">
    <verse number="58" style="v" sid="MAT 26:58" />Pedronën ka a ꞌuri kuankin Jesús nuibiankëxa sumo sacerdote xubu ëman anu nuiakëxa. Anu atsini ka Pedro an bëruankë kamabë tsóakëxa, anuxun uisakin kara ꞌaia iskatsikiax.<verse eid="MAT 26:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59" />Sacerdonën ꞌapu kushikama ꞌimainun kaniakëkë unikaman ka ami këmëxun Jesús rëtëti bariakëxa.<verse eid="MAT 26:59" /></para>
  <para style="m">
    <verse number="60" style="v" sid="MAT 26:60" />ꞌAinbi ka ami ꞌitsa uni manankëxi ka këmëi kikë ꞌiakëxa. Anuax ka rabë́ uniribi uax këmëi kiakëxa.<verse eid="MAT 26:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="MAT 26:61" />Ësai kiakëxa: —Ënë unix ka ësai kiaxa: “ꞌËn kana anuxun Dios rabiti xubu rurupatankëxun rabë́ ꞌimainun achúshi nëtëinshi birutëkënti ꞌain”.<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Usaia kikëbë nirukin ka sumo sacerdotënën Jesús ñukakëxa: —¿Uisa ꞌaísh kaina kiman? ¿Uisai ki kara mi ñui ësai kikanin?<verse eid="MAT 26:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MAT 26:63" />Kakëxi ka Jesús kiáma ꞌikën. Sumo sacerdotënën ka kakëxa: —Nukën Papa Dios ax bamatimaoi tsokë aín anën kamina min nu asérabi mix kamina Mesías Diosan Bëchikë ꞌai kixun nu kati ꞌain.<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />Jesusan ka kakëxa: —Mix kamina kian. ꞌËnribi kana mitsu kain, Unin Bëchikë ꞌaish Dios kushíira aín mëkeu tsóta naí kuin mëu aia kamina ꞌë isnuxun ꞌain.<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Usai kikëbë nishí ka sumo sacerdote aín chupa tukai nishi kiakëxa: —¡Ënë unix ka ꞌatimati Dios ñui banaxa! ¿Uisa kupin karanuna bëtsi uni baritëkënti ꞌain? Mitsunbi kamina Dios ñui ꞌatimati banaia kuan.<verse eid="MAT 26:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 26:66" />¿Uisakin kaina sinánin? Kia ka atun kakëxa:</para>
  <para style="p" vid="MAT 26:66">—Ax ka ꞌuchaxa ka bamati ꞌikën.<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Anuxun ka bëtushu kanan mëana, timanan rarinën bëtash kakëxa,<verse eid="MAT 26:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MAT 26:68" />Ësakin kakin.</para>
  <para style="p" vid="MAT 26:68">Mix Mesías ꞌixun kamina ¡uin kara mi mëaxa nu kati ꞌain!<verse eid="MAT 26:68" /></para>
  <para style="s">ꞌËn kana Jesús ꞌunanima Pedro kia</para>
  <para style="r">(<ref loc="MRK 14:66-72">Mr 14.66-72</ref>; <ref loc="LUK 22:56-62">Lc 22.56-62</ref>; <ref loc="JHN 18:15-18">Jn 18.15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Pedro ëman tsotan ukin ka, achúshi xanu sumo sacerdonën ñu më́mikë an ukin ësakin kakëxa: —Mixribi kamina Jesús Galileanu ꞌikë abë́ nikë ꞌain.<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />ꞌAibi ka Pedro uni ꞌitsa bërunuax, ꞌën kana a uni ꞌunanima kiakëxa.<verse eid="MAT 26:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71" />Anuax xëputinu kuankë ka bëtsi xanunribi ꞌiskin rairi kakëxa: —Ënë uniribi ka Jesús Nazaretnu abë́ niaxa.<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Amiribishi ka Pedronën këmëkin kakëxa: —¡Asérabi kana a uni ꞌunaniman!<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Usakin kakë panákëma ꞌainshi ka anu ꞌikëkama an Pedro ꞌurama okin kakëxa: —Mixribi sapi kamina abë́ nikë uni a ꞌain, min bana ka atun banasaribi ꞌikën.<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Anuax ka kia këxa kana mi kai: —¡ꞌËn kana a uni ꞌunanima! Usai kikëbëishi ka ꞌatapa banakëxa.<verse eid="MAT 26:74" /></para>
  <para style="m">
    <verse number="75" style="v" sid="MAT 26:75" />Anuxun ka Pedronën usakian Jesusan kakë a sinankëxa: “ꞌAtapa aín bënë banakëma pain ꞌain kamina rabë́ ꞌimainun achúshi oi këmënuxun ꞌain”. Anuax ka Pedro masá sinani nishí chikinti ꞌiñankëxa.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">Jesús Pilato ꞌinan</para>
  <para style="r">(<ref loc="MRK 15:1">Mr 15.1</ref>; <ref loc="LUK 23:1-2">Lc 23.1-2</ref>; <ref loc="JHN 18:28-32">Jn 18.28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Pëkarakë ꞌain ka, kamabi sacerdote kushikamaꞌimainun kaniakëkë judio unikama Jesús rëtëti ꞌësënankëxa.<verse eid="MAT 27:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="MAT 27:2" />Usa ꞌixun nëabiankin ubaxun ka Pilato, romanu ꞌikë ꞌain kushi a ꞌinankëxa.<verse eid="MAT 27:2" /></para>
  <para style="s">Judas bama</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Usa ꞌain ka Judas an Jesús ꞌatima onun an uni ꞌinankë ka rëtëia kixun ꞌunanbiani kuanxun, treinta kuríki sacerdote kushikamaꞌimainun ampan kaniakëkë unikama mañakëxa,<verse eid="MAT 27:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 27:4" />Ësakin kakin: —Kana ꞌuchan añu ñubi ꞌakëma uni achúshi mikama ꞌinan. ꞌAibi ka akaman kakëxa: —¿Nun kananuna ꞌa unaniman? ¡Ax ka mina ꞌikën!<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />Usa ꞌain ka Judas kuríki anuxun Dios rabiti xubunu pubiani, kuanx tëtsëkiakëxa.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />Sacerdote kushikama ka a kuríki bitsi kiakëxa: —Ënë kurikinëx ka; imín masá okë ꞌikën. Usa ꞌain anuxun Dios rabiti xubunu nanti ka ënë kuríki ꞌaisama ꞌikën.<verse eid="MAT 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 27:7" />Usa ꞌain ka kánani a kurikinën kananuna achúshi me anuxun unin ñutë ꞌakë, kakin anëkë a maruti ꞌain, ax ka anu ꞌurakëox ꞌukë unikama mainti ꞌiti ꞌikë.<verse eid="MAT 27:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="MAT 27:8" />Usa ꞌain ka, a me bërí nëtënbi imi kakin anëkë ꞌikën.<verse eid="MAT 27:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="MAT 27:9" />Usai ka an bana ñuikë Jeremías kiásabi oi ꞌiakëxa: “A treinta kuríki ka biakëxa, ax ka ꞌain tsóti kupin israelitakaman nankë ꞌiakëxa,<verse eid="MAT 27:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="MAT 27:10" />Anun ka maruakëxa ñutë kakin anëkë me a, nun ꞌIbu, kiásabi okin”.<verse eid="MAT 27:10" /></para>
  <para style="s">Jesús Pilatonu uban</para>
  <para style="r">(<ref loc="MRK 15:2-5">Mr 15.2-5</ref>; <ref loc="LUK 23:3-5">Lc 23.3-5</ref>; <ref loc="JHN 18:33-38">Jn 18.33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Anu ubania ka ꞌapun Jesús ñukakëxa: —¿Mix karamina judiokama unikaman ꞌapu a ꞌain? —Mix kikë usa ka —Jesusan kakëxa.<verse eid="MAT 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12" />Usai ka sacerdote kushikama ꞌimainun ampan kaniakëkë unikama ami manankëxa, ꞌaibi ka Jesusan uisakibi kama ꞌikën.<verse eid="MAT 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13" />Usai ꞌia ka Pilatonën ñukakëxa: —¿Mi ñuia ꞌatimati banaia karamina kuatima?<verse eid="MAT 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14" />ꞌAibi ka Jesusan achúshi banabi kama ꞌikën, usai ꞌikëbë ka Pilato, uisa uni kara ënëx ꞌikë ki ratuakëxa.<verse eid="MAT 27:14" /></para>
  <para style="s">Jesús ka bamati ꞌikë kia</para>
  <para style="r">(<ref loc="MRK 15:6-20">Mr 15.6-20</ref>; <ref loc="LUK 23:13-25">Lc 23.13-25</ref>; <ref loc="JHN 18:38-19:16">Jn 18.38—19.16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Pascua nëtën usabi okin uni sipuakë chikinkë ꞌixun ka aín kushin ui chikinti kara uni kibëtan a chikiankëxa.<verse eid="MAT 27:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 27:16" />Anu ka achúshi uni sipuakë Barrabás kakë unin ꞌunairakë ꞌiakëxa;<verse eid="MAT 27:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 27:17" />Anu timë́kë ka unikama Pilatonën ñukakëxa: —¿Uira chikinti karamina míkaman kuë́ënin: Barrabás kakë a karana chikinti aín, a ꞌakima Jesús Mesías kakë a chikinti karamina kuë́ënin?<verse eid="MAT 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 27:18" />Pilatonën ka ami nishkin ka ꞌë ꞌinanxa kixun ꞌunankëxa.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Aín tsótinu tsókë ka Pilato aín xanun kamiakëxa: “A uni upí a kamina uisabi otima ꞌain, imë́ kana a kupin ꞌaisamokin namánëti”.<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Usa ꞌaibi ka sacerdote ꞌimainun ampan kaniakëkënën ꞌitsaíira uni kakëxa, Barrabás chikianan Jesús rëtënun kixun kakëxa.<verse eid="MAT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21" />Usa ꞌain ka aín kushin amiribishi ñukatëankëxa: —¿Rabënua karanuna uinu ꞌikë aira chikinti ꞌain kixun ñúkakëxa? Ñúkakëxun ka sharákin kakëxa: —¡Barrabás ka chikin!<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />Pilatonën ka ñúkakëxa: —¡Uisaki karana Jesús Mesías kakë ënë ꞌati ꞌain? Kamaxubi ka kakëxa: —¡Kamina i curuz bëntanki matasti ꞌain!<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />Pilatonën amiribishi ñúkakëxa: —¿Uisa ñu ꞌatima kara ak?</para>
  <para style="p" vid="MAT 27:23">ꞌAibi ka kushin sharati amiribishi kitëkëankëxa: —¡Kamina i curusokënu mataskin bëntanti ꞌain!<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Pilatonën ka unin kuatiama ꞌisakëxa, ꞌaibi ka uni ꞌitsaíira sharati kuë́ënkëni kiakëxa, kikëbë ka ꞌumpax bëmitankëx atun ismainunbi mëchukati kiakëxa: —ꞌËn kana ënë uni bamakëbë ꞌuchaima mitsun kamina a isti ꞌain.<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />Kia ka kamabi unin kakëxa: —¡Nukama ꞌimainun nukën bëchikëkama ka aín bamakë ꞌunanti ꞌikën!<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Usa ꞌain ka Pilatonën Barrabás; pikuana rishkimitankëxun Jesús i curuznu bëntanki mëtasnu ꞌinankëxa.<verse eid="MAT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Pilato suntarukaman ka anu atux timëkë xubu mëu Jesús ubankëxa, anuax ka suntarukama a nëbëtsiorati a ꞌurama timëakëxa.<verse eid="MAT 27:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="MAT 27:28" />Aín chupa chaxkë bikuantankëxun ka, chupa xonsa chaxkë tëñumiakëxa.<verse eid="MAT 27:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="MAT 27:29" />ꞌImainun ka achúshi mañuti muxa ꞌakë aín maxkanu ꞌamiana achúshi i maxu tëakë aín mëkëñu tuimiakëxa. Usakin ꞌatankëx, a bëmano rantipuruni tsóbuki ka ami kuaikin kakankëxa: —¡Min judiokama ꞌapu ꞌaix kamina nëtëtimoi tsóti ꞌain!<verse eid="MAT 27:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 27:30" />ꞌImainun ka tushukanan, i maxu bikuankin anunbi mataxkakëxa.<verse eid="MAT 27:30" /></para>
  <para style="m">
    <verse number="31" style="v" sid="MAT 27:31" />Ami pain kuaitankëxu ka, aín chupa xonsa chaxkë pëmiakëxa, pëmitankëxun ka aín chupabi pañumixun anua bëntakin i curuznu mëtastinu ubankëxa.<verse eid="MAT 27:31" /></para>
  <para style="s">Jesús ka i curuznu mataskë ꞌikën</para>
  <para style="r">(<ref loc="MRK 15:21-32">Mr 15.21-32</ref>; <ref loc="LUK 23:26-43">Lc 23.26-43</ref>; <ref loc="JHN 19:17-27">Jn 19.17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Anua chikikin ka, mërakin achúshi uni Simón kakin anëkë Cirenenu, ꞌikë a Jesusan i curusokë buanun kixun bë́nëkin kakëxa.<verse eid="MAT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 27:33" />Kuanx ka Gólgota kakë me anu bëbakëxa. (Usai kikë, “Ax ka mapuxo kikë ꞌikën”),<verse eid="MAT 27:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="MAT 27:34" />Anuxun ka vinu baka muka këñun mëskukë a xëanun ꞌamiakëxa, ꞌaibi ka Jesusan, tanxun xëatisama tankëxa.<verse eid="MAT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35" />Mataskin ka i curusokënu aín taënu ꞌanan aín mëkënu ꞌakin bëntankëxa, suntarukaman ka Jesusan chupa uin karaisa biti ꞌikë kixun tantankëx mëtikiakëxa.<verse eid="MAT 27:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="MAT 27:36" />Usakin ꞌatankëx ka anuxun bëruantinu tsobukankëxa.<verse eid="MAT 27:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MAT 27:37" />Aín maxka manami ka ësakin kuënëoxun nankë ꞌiakëxa, a bana ka ësai kikë ꞌiakëxa: “ËNËX KA JESÚS, JUDIOKAMA ꞌAPU ꞌIKËN”.<verse eid="MAT 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 27:38" />A nëtënbi rabë́ uni ñu ꞌaisama ꞌakë, bëtsi aín mëkeu ꞌanan ꞌain mëmiu mataskë ꞌiakëxa.<verse eid="MAT 27:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="MAT 27:39" />Axa ꞌinukë unikaman ka, a chichai tënkëkin aín maxka shaikakin,<verse eid="MAT 27:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 27:40" />Kakëxa: —¡Mix kamina anuxun Dios rabiti xubu rëupatankëxun rabë́ ꞌimainun achúshi nëtë birutëkën katsi kia! ¡Mix Diosan Bëchikë ꞌaish kamina anua mi bëntankin mëtaskë anua ꞌibuti ië́ti ꞌain!<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />Usairibi ka sacerdote kushikama ꞌimainun ñu ꞌunan unikama ꞌianan ampan kaniakëkë akamaribi ami kuai kiakëxa:<verse eid="MAT 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 27:42" />Bëtsi ka iëmiaxa, usa ꞌaibi ka axbi iëtima. An ka Israelnën ꞌapu ꞌikën: ¡Usa ꞌaish ka i curusokënua ꞌibuti ꞌikën, usai ꞌibukëbë kananuna ami katamëti ꞌain!<verse eid="MAT 27:42" /></para>
  <para style="m">
    <verse number="43" style="v" sid="MAT 27:43" />Ax ka Diosmi katamëaxa Diosan ka a ꞌiëmiti ꞌikë, ax asérabi kuë́ënkin. ¿Ax ka kiaxa ꞌën kana Diosan Bëchikë ꞌain?<verse eid="MAT 27:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 27:44" />A këñubia i curuz mataskë uni ꞌatimanëribi ka, ꞌatimokin chichakëxa.<verse eid="MAT 27:44" /></para>
  <para style="s">Jesús bama</para>
  <para style="r">(<ref loc="MRK 15:33-41">Mr 15.33-41</ref>; <ref loc="LUK 23:44-49">Lc 23.44-49</ref>; <ref loc="JHN 19:28-30">Jn 19.28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Bari xamarukë ꞌain, rabë́ ꞌimainun achúshi oi bari kuainakëkëbë ka kamabi me bëankiakëxa.<verse eid="MAT 27:45" /></para>
  <para style="m">
    <verse number="46" style="v" sid="MAT 27:46" />Usai bari ꞌikëbë ka, Jesús munuma kuë́ënkëni kiakëxa: “Elí, Elí, ¿Lemá sabactani?” (Ësai ki: “ꞌËn ꞌibu, ꞌËn ꞌIbu, ¿Uisa kupin kaina ꞌë ëan?”)<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />Anua ꞌikë rairi akaman ka a kuati kanankëxa: —Ënën ka an bana ñuikë Elías kuënia.<verse eid="MAT 27:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 27:48" />Usai ꞌikëbë ka anu ꞌikë achúshi, abakianxun ñu bachu barikin bixun, vinu baka mukakëñun mëskukë chaboxun, ñumi nëaxun a ꞌurama ubanxun ꞌamiakëxa.<verse eid="MAT 27:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 27:49" />Anu ꞌikë rairinëx ka kiakëxa: —Ka ën, Elías kara a ië́mi aia kananuna isti ꞌain.<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />Jesús ka amibirishi kushin kuë́ënkëni, bamakëxa.<verse eid="MAT 27:50" /></para>
  <para style="m">
    <verse number="51" style="v" sid="MAT 27:51" />Usai ꞌikëbë ka anuxun Dios rabiti xubunu bëpankë chupa manamiax shimuki panarabëti tukiakëxa; ꞌimainun ka meribi shaikimainun maparakama tukibuakëxa.<verse eid="MAT 27:51" /></para>
  <para style="m">
    <verse number="52" style="v" sid="MAT 27:52" />Anu uni mainkë kini tukikëbë; ka Diosan uni bama a kamax baiskiakëxa.<verse eid="MAT 27:52" /></para>
  <para style="m">
    <verse number="53" style="v" sid="MAT 27:53" />Jesús baiskian ka a unikamaxribi Jerusalén ëma upí anu ꞌitsa unin isnun kuankëxa.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />Anuxun ka Capitan Romanu ꞌikë ꞌimainun suntarukama an Jesús bëruankëkama an niún kuainkëbëta kamabi ñu ꞌia isakëxa, isi ka ꞌitsaíira rakuëti kanankëxa: —¡Asérabi ka ënë uni Diosan Bëchikë ꞌiaxa kanankëxa!<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />ꞌItsaíira xanu an ꞌuraxun Jesús iskë, atux ka Galileanuxun nuibiankin ꞌakinkë ꞌiakëxa.<verse eid="MAT 27:55" /></para>
  <para style="m">
    <verse number="56" style="v" sid="MAT 27:56" />Atubë ka María Magdalena, María, Santiago, José aín tita ꞌimainun Zebedeonën bëchikë kaman tita ꞌiakëxa.<verse eid="MAT 27:56" /></para>
  <para style="s">Jesús ka mainkë ꞌikën</para>
  <para style="r">(<ref loc="MRK 15:42-47">Mr 15.42-47</ref>; <ref loc="LUK 23:50-56">Lc 23.50-56</ref>; <ref loc="JHN 19:38-42">Jn 19.38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Bakishkëbë ka, achúshi uni ñuñuira José Arimatea kakë, aribia Jesusan ꞌunamikë ax uakëxa.<verse eid="MAT 27:57" /></para>
  <para style="m">
    <verse number="58" style="v" sid="MAT 27:58" />Josenën ka isi kuaxun Pilato Jesusan nami ñúkakëxa, Pilatonën ka ꞌinanun kixun kakëxa.<verse eid="MAT 27:58" /></para>
  <para style="m">
    <verse number="59" style="v" sid="MAT 27:59" />Anuxu ka Josenën ꞌain nami, bikin achúshi sábana upí lino chuañuma anun rabuankëxa.<verse eid="MAT 27:59" /></para>
  <para style="m">
    <verse number="60" style="v" sid="MAT 27:60" />Usotankëxun ka kini ꞌio achúshi, mapara ꞌamikë anu nankëxa. Usokin nantankëxun ka achúshi maxá chaíira anun kini xëpubiani kuankëxa.<verse eid="MAT 27:60" /></para>
  <para style="m">
    <verse number="61" style="v" sid="MAT 27:61" />ꞌAibi ka María Magdalena ꞌimainun bëtsi María anu mainkë kini a bëtanai tsóti tikiakëxa.<verse eid="MAT 27:61" /></para>
  <para style="s">Suntaru anu Jesús mainkë kininu ꞌia</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Anun ñu mëtima nëtë ꞌionx pëkarakëbë ka sacerdote kushikama ꞌimainun fariseokama timëkiani Pilato isi kuanxun,<verse eid="MAT 27:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MAT 27:63" />Kakëxa: —ꞌËn ꞌIbu, kananuna mi sinámi bamakëmapain ꞌaish ka këmëntapun ax kiaxa, bamatankëx kana, rabë́ ꞌimainun achúshi nëtë ꞌikëbë baiskiti ꞌain.<verse eid="MAT 27:63" /></para>
  <para style="m">
    <verse number="64" style="v" sid="MAT 27:64" />A kupí kamina anua mainkë a rabë́ nëtë ꞌimainun achúshi nëtë ꞌinutamainun upioki bëruamiti ꞌain, aín unikaman ka uxún mëkama biankin ubanti ꞌikën, usakin ꞌatankëxun ka baiskiaxa uni katima kupí. Usa ꞌain ka, axa këmëkë ax bërama ꞌikësamairai këmëkë ꞌiti ꞌikën.<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />Pilatonën ka kakëxa: —Anu ka min suntarukama ꞌikë. An ka kuantakëxun kini a upiokin mëniotankëxun bëruanti ꞌikën.<verse eid="MAT 27:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66" />Kuaxun ka anu mainkë kini a maxaxan ꞌunantiokin xëpuakëxa; usakin ꞌaxun ka anu suntarukama an bëruanti ëankëxa.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">Jesús baiskia</para>
  <para style="r">(<ref loc="MRK 16:1-8">Mr 16.1-8</ref>; <ref loc="LUK 24:1-12">Lc 24.1-12</ref>; <ref loc="JHN 20:1-10">Jn 20.1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Anun ñu mëtima nëtë ñantauonx pëkarakëbë ka, a nëtë María Magdalena ꞌimainun María itsi ax Jesús anu main ënxankë isi kuankëxa.<verse eid="MAT 28:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="MAT 28:2" />Kuankëbëshi ka me kushíira shaikiakëxa. Usai ꞌikëbëtan ka Diosan ángel achúshi naínua, ubukin ꞌurama okin anun xëpukë maxá rakanabiax a kamana tsobakëxa.<verse eid="MAT 28:2" /></para>
  <para style="m">
    <verse number="3" style="v" sid="MAT 28:3" />A ángel ka kaná mëritia iskësa ꞌianan aín chupa uxuira ꞌai chaba chaba kikë ꞌiakëxa.<verse eid="MAT 28:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="MAT 28:4" />Usai ꞌikëbë ka an bëruankë suntarukama ꞌitsaíira ratuti bërëi bamakësa ꞌiakëxa.<verse eid="MAT 28:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="MAT 28:5" />Angelnën ka xanukama kakëxa: —Kamina rakuëtima ꞌaín. ꞌËn kana ꞌunan, mikaman kamina Jesús, i curusokënu matas ëxankë a barin.<verse eid="MAT 28:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="MAT 28:6" />Ënuma ka, ka baiskiaxa, ax kikësabi oi. Uxún kamina anua nankë isiuti ꞌain.<verse eid="MAT 28:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="MAT 28:7" />Usa ꞌain kamina bënë́kiani kuantankëxun aín unikama ka bamaxi baiskiaxa kai kuanti ꞌain. Bërí ka ax Galileanu anpan rëkuënkiani anu timë́kënu kuania, anua ka isti ꞌikën. ꞌËn mi kakë ënë kamina sinánti ꞌaín.<verse eid="MAT 28:7" /></para>
  <para style="s">Jesús xanukamami mërá</para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />Usa ꞌain ka xanukama bënë́ kiani anu mainkë, anuax kuani rakuëtibi ꞌitsaíira kuëënkiani abakianxun aín unikama kai kuankëxa.<verse eid="MAT 28:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="MAT 28:9" />Kuankëbëbi ami mërakin ka Jesusan xanukama kakëxa. Kakëxun ka Jesús a ꞌurama okin rantipuruni tsóbukin aín taë mëkin rabiakëxa.<verse eid="MAT 28:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="MAT 28:10" />Jesusan ka kakëxa: Kamina rakuëtima ꞌain, kuanxun kamina ꞌën xukëantu Galileanua ꞌë mërai kuanun kati ꞌain.<verse eid="MAT 28:10" /></para>
  <para style="s">Suntarukaman kuríki bia</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Xanukama kuankëbë ka an bëruakë suntarukama ëmanu kuanx bëbakin sacerdote ꞌapukama usaia ꞌikëkama ñuixuankëxa.<verse eid="MAT 28:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="MAT 28:12" />Ñuixunkëx ka a ꞌapukama kaniakëkë unikamabë ësënani kuankëxa, anuxun ka suntarukama kuríki chaíira ꞌinankëxa.<verse eid="MAT 28:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 28:13" />Kuantankëxun kamina: —Mikaman kai kuanti ꞌai, nukama ꞌuxan ka ꞌimë́naëx, uxún aín unikama Jesusan nami mëkamaxa kixun kati aín.<verse eid="MAT 28:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 28:14" />Ënë chanioia ꞌapun kuakëbë kananuna nukamax abë banati ꞌain. Usa ꞌain kamina mikama añuñubi ꞌinútima ꞌaín.<verse eid="MAT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15" />Suntarukaman ka kuríki bitankëxun atux kikësabi okin ꞌakëxa. Ënëx ka usokin ꞌakë kupiá bërí nëtënbi judiokama usai banai kikë ꞌikën.<verse eid="MAT 28:15" /></para>
  <para style="s">Jesús aín unikamami mërá</para>
  <para style="r">(<ref loc="MRK 16:14-18">Mr 16.14-18</ref>; <ref loc="LUK 24:36-49">Lc 24.36-49</ref>; <ref loc="JHN 20:19-23">Jn 20.19-23</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Usa aín ka mëkën rabë́ ꞌimainun achúshi aín unikama ax Galilea, menu ꞌikë matá anua kuanun Jesusan kakë anu kuankëxa.<verse eid="MAT 28:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="MAT 28:17" />Anuxun ꞌiskin ka rabiakëxa, ꞌaibi ka rairitan ama ka kixun sinánkëxa.<verse eid="MAT 28:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 28:18" />Jesusan ka a ꞌurama kuankin akama kakëxa: —Diosan ka kamabi kushi naí ꞌimainun menu ꞌikë a ꞌë ꞌinanxa.<verse eid="MAT 28:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="MAT 28:19" />Usa ꞌain kamina kuankin kamabi menu ꞌikë unikama, ꞌën uni ꞌinun nashimikin ꞌën Papa anën ꞌanan aín Bëchikë ꞌimainun aín Bëru Ñunshin Upí anun nashimiti ꞌain,<verse eid="MAT 28:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="MAT 28:20" />Kamina ꞌunamikin kamabi ꞌën kikësabi okin, mi kakëkama anun kati ꞌain. ꞌËx kana kamabi nëtën míkamabë ꞌiti ꞌain, ënë nëtëkama këñutamainun.<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>