<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1PE" style="id">- Nuevo Testamento Kakataibo</book>
  <para style="h">1 Pedro</para>
  <para style="toc3">1 Ped</para>
  <para style="toc1">Pedronëan a pain buánmia kirica</para>
  <para style="toc2">1 Pedro</para>
  <para style="mt1">Pedronëan a pain ubamia kirika</para>
  <chapter number="1" style="c" sid="1PE 1" />
  <para style="s">Pedron asabi ka.</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1" />Pedro, Jesucristonën kaiskë, ꞌixun kana asabi ka kixun mi kain, bëtsi menu kuani tsuákia ꞌaish anu tsókë kana a ëmanu ꞌikë mi kain, Ponto, Galacia, Capadocia, Asia ꞌimainun Bitinianu ꞌikë.<verse eid="1PE 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1PE 1:2" />Nukën Papa Diosan, an kuë́ënkësabi okin mitsu kaisa ꞌikë. Ka aín Bëru Ñunshin Upitan mikama mëniokin upí ꞌimiaxa, ami katamëkin an kuë́ënkësabi okin ꞌanun, Jesucristonën imin ka mi mënioxa. Usa ꞌain kamina chúama tani upiti kuë́ëni bukukanti ꞌain.<verse eid="1PE 1:2" /></para>
  <para style="s">Dios kananuna rabiti ꞌain.</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3" />Dios nukën ꞌIbu Jesucristonën Papa a kananuna rabiti ꞌain. An nu chaíira nuibakin amiribishi bakëntëkënkësa ꞌimianan Jesucristo baiskikë kupin, kananuna nun kainti ꞌain.<verse eid="1PE 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 1:4" />ꞌImainun kamina mitsun biti Diosan mi naínu, naxunkë ñu chëëki nëtëtima, chuatima, nukatima a biti ꞌain.<verse eid="1PE 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 1:5" />Mix Diosmi sinánkë ꞌikë ka mitsu, aín kushin mi bërúankin ië́mikë, a ka nëtë këñuti ꞌurama mi ꞌunamiti ꞌikën.<verse eid="1PE 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 1:6" />Usa ꞌain kamina mikama ꞌitsaíira kuë́ënti ꞌain, usai tëmëranumabi kamina ashiti nëtëti ꞌitsama nëtë ꞌitsaíira ñu inuti, tëmërati ꞌain.<verse eid="1PE 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 1:7" />Mikama ami sinankë ax ka kurisa ꞌikën: Ax ka tsi ërë́kë anun xarokin tankë ꞌiti ꞌikën. Mix ami sinani tëmërakibi tënëkë ax kurisamaira ꞌikën, ꞌaibi ka kuri ax charokë ꞌiti ꞌikën. Usa ꞌain ka mikama, ami sinankë ax asabi ꞌiti ꞌikën, a ka utëkënki aín nëtë pënëira anu mi Jesucristonën utëkënki anu mi ꞌimiti ꞌikën.<verse eid="1PE 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 1:8" />Mikaman kamina Jesucristo isikëma ꞌixunbi ami sinanin; usa ꞌain kamina bëri isimabi ami sinani, chaíira kuë́ëira kuë́ëni upíira a sinani banañuma ꞌiti aín.<verse eid="1PE 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 1:9" />Usaimi ami sinani katamëkë anun kamina uinu kaina nukutisa tani, anu nukuti ië́kë ꞌiti ꞌain.<verse eid="1PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 1:10" />Profetakaman ka ënë ñu upiokin ꞌunankëxa, anun nu ië́ti kupí, ꞌunanan ka Diosan nuibakin mitsu ꞌinanti aribi ñuiakëxa.<verse eid="1PE 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 1:11" />Cristonën Bëru Ñunshin Upitan ka bëramabi profetakama ꞌunamiakëxa, Cristoa tëmërati aribi ꞌunamiakëxa, ꞌimainun ka aín nëtë pënëira uti ꞌikë kixun; atun ka unantisa tankëxa, anua tëmërati nankë Bëru ñunshin ax anu ꞌiakëxa.<verse eid="1PE 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 1:12" />Diosan ꞌunamikëxun atun ñuikë ax ka ainama ꞌiakëxa, ax ka mitsua ñuixunkë ꞌiakëxa. A ñuia bana ax ka bërí nëtëbi ñuikë ꞌikën, a banabi ka aín Bëru Ñunshin Upitan ꞌunamikëxun ñuiakëxa. A upí banabi ka nainuxun xukë ꞌiakëxa. ¡Ënë ñuribi ka ángel kamaribi istisa tankëxa!<verse eid="1PE 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13" />Usa ꞌai kamina upiti mëniokakë ꞌixun añu karamina ꞌati ꞌai kainti ꞌain. Diosan Jesucristo utëkënkëbëtan mi nuibakin ꞌinanti ñu a.<verse eid="1PE 1:13" /></para>
  <para style="s">Diosan ka ꞌuchaima tsóti kuë́ënia</para>
  <para style="p">
    <verse number="14" style="v" sid="1PE 1:14" />Aín bëchikë ꞌaish kamina ax kuë́ënkësa oishi ꞌi, bëramami Dios ꞌunankëma ꞌai ꞌiasoi kamina ꞌitima ꞌain<verse eid="1PE 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1PE 1:15" />Usa ꞌain kamina ñu upishi ꞌai ꞌuchaima tsóti ꞌain, Dios an mi kuëan ax ka upíira ꞌai ꞌuchañuma ꞌikën;<verse eid="1PE 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1PE 1:16" />kuënëo bana ka kia: —Mitsux kamina ñu ꞌaisama ꞌakëma upíira ꞌuchañuma ꞌiti ꞌain, ꞌën ribi kana ñu ꞌaisama ꞌakëma upíira ꞌuchañuma ꞌain.<verse eid="1PE 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 1:17" />Mitsun kamina «Dios Papa» Kain, an ka kamabi mitsun ꞌakë ñu sënënbi isti ꞌikën, usa ꞌain kamina kamaxi nuibakin upiokin ñu ꞌati ꞌain, ënë menuxun.<verse eid="1PE 1:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="1PE 1:18" />Mitsun kamina ꞌunanin Diosan ka nu biaxa min rarakama ꞌiasai ꞌaisamai tsokë; a ëmikin mitsu ꞌië́miaxa, mitsun kamina upiokin ꞌunan, ax ka kuri ꞌimainun kuríki ax kupikë usanën kupioma ꞌikën,<verse eid="1PE 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1PE 1:19" />usa ꞌain ka Jesucristo, imi upíira ax <note caller="+" style="f"><char style="fr" closed="false">1.19 </char><char style="ft" closed="false">ñuina unamara ax ka cordero ñui kikë ꞌikë</char></note>ñuina unamara, uisaibi ꞌikëma xarokë anun akësaribi okin akë ꞌiakëxa.<verse eid="1PE 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1PE 1:20" />Me unioisama pain ꞌain ka Cristo pain kaisakëxa, usa ꞌai ka bëri añukama nëtë ankëtamainun mitsuna ꞌinu mërákë ꞌikën.<verse eid="1PE 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1PE 1:21" />Jesucristo kupin kamina mitsux Dios ënkima sinani, an ka baiskimiana upí ꞌimiaxa; usa ꞌain kamina mitsun upiokin Dios sinani kuë́ënki a kainti ꞌain.<verse eid="1PE 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 1:22" />Bërí kamina mikama an kikësabi oi ꞌiti bana asérabi ñuia a kuati, mëniokati kamina sinánati min xukën kamabë nuibananti ꞌain. Usa ꞌain kamina bëtsibë bëtsibë nuibanani min nuitu upíira ꞌixun min kushibëtabi ꞌati ꞌain.<verse eid="1PE 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1PE 1:23" />Usa ꞌain kamina mitsux amiribishi bërí bakëntëkënkë ꞌain, bërí kamina min papa axa uni ꞌaish bamati aín bëchikëma ꞌain, Dios axa bamatima oi xënibua ꞌainbi tsókë aín bana ꞌai.<verse eid="1PE 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1PE 1:24" />Kuënëokë bana kia:</para>
  <para style="q" vid="1PE 1:24">—Kamabi uni ka chukusa ꞌikë, ꞌain ñu ka chaíira ai ñu ubasa ꞌikë, chuku ëskikëbë ka aín uba pakëtia,<verse eid="1PE 1:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="1PE 1:25" />ꞌAibi ka Nukën ꞌIbu bana ax uinsarabi këñutima ꞌikën.</para>
  <para style="m" vid="1PE 1:25">Ënë bana ka upí bana ꞌën mitsu ñuixunkë a ꞌikën.<verse eid="1PE 1:25" /></para>
  <chapter eid="1PE 1" />
  <chapter number="2" style="c" sid="1PE 2" />
  <para style="s">Ëma ió Diosnan ꞌiti.</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1" />Usa ꞌain kamina kamabi ñu ꞌaisamakama ënti ꞌain, parananti, ꞌaisamoki sinankë, ꞌimainu bëtsimi banakë, kamabi këmëki bana ñuikëkama ënti ꞌain.<verse eid="1PE 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1PE 2:2" />Uniakëxu bërí bakënkëna, xuma ꞌaisaira tanki barikë usaribi okin kamina bëru ñushin a, anun chaii ië́kë ꞌinuxun ꞌati ꞌain,<verse eid="1PE 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 2:3" />kamina uisaira okin kara nukën ꞌIbun nu nuibatia kixun ꞌunan.<verse eid="1PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 2:4" />Nukën ꞌIbu ꞌurama kamina uti ꞌain, maxá upí ꞌikëbi unin timakë a ka, Diosanbi kaiskin achúshi maxá kupíirakë ꞌimikë a ꞌikën.<verse eid="1PE 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 2:5" />Usaribi okin ka mikama Diosan maxá upíira ꞌimiaxa, anuxun Dios rabiti xubu bëru ñushi achúshi ꞌati, usaribi sacerdocio ꞌuchañuma, Jesucristo kupín bëru ñushin xarokësa Diosan iskë ꞌiti ꞌikën.<verse eid="1PE 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 2:6" />Ësai ka kuënëo banaribi kia: —ꞌËn kana Siónu achúshi maxá nanin a maxá ka bëtsi maxasamaira, kaiskë upíira ꞌai kupíira ꞌikë; ami katamëti kananuna rabintima ꞌain.<verse eid="1PE 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 2:7" />Mikama ami sinánkë, a maxá ax ka kupíira ꞌikën; ꞌaibi ka axa ami katamëkëma kama an ka maxá kuë́ëama ꞌikë, kuënëo bana kikësabi oi ꞌiti ꞌikë: —An xubu ꞌakë unian aisama ꞌikë rakan maxá ax ka bërí maxá kupíira ꞌikën.<verse eid="1PE 2:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="1PE 2:8" />Ënë bëtsi: —Maxámi tuaxki pakëti ka xaxumi ꞌiti ꞌikë. Atux ka a bana kuakëma kupí ami tuaxkia usai ꞌitioki nankë kupí.<verse eid="1PE 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 2:9" />Mikamax kamina achúshi aíntsi Diosan kaiskë ꞌai, achúshi sacerdocio an ꞌapu ñu mëxunkë ꞌianan, ëma ꞌuchañuma Diosan kaiskë. An ka aín bana ñuinun nukë kuëankëxa, bakishnua chikinki xaba upíira anu nu ꞌimiakëxa.<verse eid="1PE 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 2:10" />Bërama kamina Diosan unima ꞌiakën, ꞌaibi kamina bërí achúshi ëma ꞌain; ꞌaibi ka bërama nuiba ꞌixumabi Diosan mi nuibatia kixun ꞌunan.<verse eid="1PE 2:10" /></para>
  <para style="s">Dios kuë́ënkësaoi ꞌiti.</para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11" />ꞌËn nuibakë xukëantu kana mi abi kain, bëtsi unisa ꞌaín kamina ënë menu tsóta, usa ꞌain kamina unian ꞌakë ñu ꞌatima ꞌai tsotima ꞌai.<verse eid="1PE 2:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="1PE 2:12" />Mitsux kamina judioma uni ꞌatima kamanua upiti bukuti ꞌaín, usaimi ꞌia ka bërí ꞌatimakin mitsu ñuikë ꞌixunbi ka upiñu ꞌakëbëtan Dios rabiti ꞌikën, anúa an ꞌakë ñukama ñukáti nëtë ꞌitamainun.<verse eid="1PE 2:12" /></para>
  <para style="s">ꞌApukaman bana kamina kuati ꞌaín</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13" />Nukën ꞌIbu kupin kamina mitsun ꞌapukama bana tanti ꞌain, amia kushikë ꞌapuíira aín banaribi kamina kuati ꞌain,<verse eid="1PE 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1PE 2:14" />ꞌaibi ka aín kushikama an ñu ꞌatima ꞌakë unikama tëmëramiana upí ñu akë unikama nuibanu xutia.<verse eid="1PE 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1PE 2:15" />Diosan ka mitsun upí ñu ꞌati kuëënia, uni ñu ꞌunamakama ꞌimainun ñusmakama, mitsu ꞌatimaki ñuitima kupin.<verse eid="1PE 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1PE 2:16" />Uni upí ꞌai kamina upiti bukuti ꞌain, ꞌaibi kamina ñu ꞌatima ꞌakë ꞌaishi ñu upí ꞌakësa ꞌitima ꞌain. Usai ꞌima kamina Dios ñu mëxunkë ꞌíkësa oishi bukuti ꞌain.<verse eid="1PE 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 2:17" />Kamabi kamina upiokin kati ꞌain. Kamabi xukëantu kamina nuibati ꞌain Dios, ribi kamina upiokin kati ꞌain ꞌapuíira kamina nuibati ꞌain.<verse eid="1PE 2:17" /></para>
  <para style="s">Cristo të́ëmëra</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18" />Mix unin ñu më́mikë ꞌixun kamina, kuë́ënkin ax kikësabi okin ꞌati ꞌain, nuibanankë upí uni ashima, ꞌatima uni aribi kamina nuibati ꞌaín.<verse eid="1PE 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1PE 2:19" />An ka Diosan kuë́ënkë ñu ꞌikë, nuxnu ñu upí ꞌaibi tëmëraki tënëkë ax ka aina ꞌikën.<verse eid="1PE 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1PE 2:20" />Mitsu ka ñu ꞌaisama ꞌaia tëmëramiaxa. ¿Usa ꞌikë kara uisokin asabi ka kixun paë tënëiabi kati ꞌik? Usa ꞌaibi ka ñu upí ꞌakin paë tënëia Diosan iskëx asabi ꞌikën.<verse eid="1PE 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1PE 2:21" />Diosan ka tëmërakibi tënënu nu kuëanxa. Usai ribi ka Cristo nu kupin tëmërakëxa, nuxnu usaribiti ꞌiti kupin.<verse eid="1PE 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 2:22" />Cristo ax ka ꞌuchama ꞌikë, ꞌianan ka uibi paráma ꞌikën.<verse eid="1PE 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1PE 2:23" />A chicha këxubi ka uisokibi chichama ꞌikën; të́mëramikëxubi ka kupiama ꞌikën, an ka kamabi Diosan mëkënuishi ë́ankëxa, an ka mënioti ꞌikë kixun.<verse eid="1PE 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1PE 2:24" />Cristonënbi ka aín naminu nun ꞌuchakama curuznu ubankëxa, nuxribinu nun ꞌucha kupí bamakësa ꞌai ië́tankëx upiti tsonun, ka Cristo ꞌatima okankëxa, mitsuxmi ainan ꞌaish pëxkúkë ꞌinun.<verse eid="1PE 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1PE 2:25" />Mitsux kamina bërama oveja nëtëkësa ꞌaish niakën, ꞌaibi kamina bëri Cristonëa aín ñuina bëruankë unisa ꞌixun bëruankë ꞌain.<verse eid="1PE 2:25" /></para>
  <chapter eid="1PE 2" />
  <chapter number="3" style="c" sid="1PE 3" />
  <para style="s">Xanuñu uni usai ꞌiti kia</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1" />Usa ꞌain kana mi kai xanukama min bënë kikësabi oi kamina ꞌiti ꞌain, mi usai ꞌikëbëtan ka an upí bana ñuia kuakëma ax ribi usai ꞌiti ꞌikën, mitsux upiti nikë ꞌixun ñu upí ꞌaia isi sinana ti ꞌikën.<verse eid="1PE 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1PE 3:2" />An mi iskëkaman ka mitsuxmi upiti tsóti nuibanani Dios mi katamëtia isti ꞌikën.<verse eid="1PE 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 3:3" />Mix mëniokakë an ka ëman ishi ꞌiti ꞌikën, mix masirikikë, min mëñuti kuri ꞌakë, ꞌimainun mín chúpa upíira pañukë,<verse eid="1PE 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 3:4" />áma min nuitu mëu upíira ꞌiana, nami upíira ꞌaish min sinan bachu ax ka nëtëtima ꞌikë upíira ꞌai Diosan iskëx asábira ꞌiti ꞌikën.<verse eid="1PE 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 3:5" />Usaribiti ka bërama an ñu ꞌatima ꞌakëma xanukamaribi mëniokakëxa, an ka aín bënëan kakëxun kuanan Diosmiribi katamëakëxa.<verse eid="1PE 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 3:6" />Usaribikin ka Saran, Abrahamnën bana tankin, «ꞌËn ꞌibu kakëxa.» Mikama kamina aín tuá ꞌai, a kupin kamina ñu upí ꞌai rakuëtima ꞌain.<verse eid="1PE 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 3:7" />Xanuñu unikama mitsun kamina min xanubë upiti ꞌiti ꞌunanti ꞌain, usa ꞌain kamina min xanu nuibati ꞌain. Kamina atux kuëënkësa okin nuibati ꞌain, atux ka kushima ꞌianan anuan mitsubë tsóti a Diosan ꞌinankë ꞌikën, usai ꞌikëbëtan ka Diosan min ñukakëxun kuati ꞌikën.<verse eid="1PE 3:7" /></para>
  <para style="s">Ñu upí ꞌai tëmërati</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8" />A kupí, kamina mitsux timëax nuibanani, min xukëbë bëtsin sinankësari okin sinani bukuti ꞌain.<verse eid="1PE 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 3:9" />Bëtsian mi ꞌatima okëxun kamina minribi ꞌatima otima ꞌain, bëtsin kara mi ꞌichatia a kamina usakiribi ꞌichátima ꞌaín, ꞌakima kamina atuxribia upí ꞌinun Dios ñukaxunti ꞌain.<verse eid="1PE 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 3:10" />A kupin ka: Uix kara upiti tsótisa tania an aín kuëëbikëñun aín ana bëruankë ꞌaish këmëima banati ꞌikën.<verse eid="1PE 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="1PE 3:11" />Ñu ꞌaisama ꞌakë a ënkin kamina upí ñuishi ꞌati ꞌain, upiti tsóti kamina usai ꞌiti ꞌain.<verse eid="1PE 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 3:12" />Nukën ꞌIbun ka an ñu upí ꞌakë a isanan ñukakëxun kuatia. ꞌAibi ka an ñu ꞌatima ꞌakëkama a kuë́ënima.<verse eid="1PE 3:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="1PE 3:13" />¿Uin kara mi ꞌatima oti ꞌik, mitsun ñu upí aia?<verse eid="1PE 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1PE 3:14" />ꞌAibi kamina ñu upí ꞌai tëmërati ꞌain, ¡chúamarua tani kamina mitsux ꞌiti ꞌain! Uimibi rakuëti kamina ratutima ꞌain.<verse eid="1PE 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1PE 3:15" />Usai ꞌikima kamina Cristo a nukën ꞌibu ꞌikë min nuituna rabiti ꞌain. Kamina mëniokakë ꞌixun uin kara mi kaia a kati ꞌixun kainti ꞌain, mia ñu kakëxun min kainkë a ñuiki kati ꞌain,<verse eid="1PE 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1PE 3:16" />ꞌAibi kamina kakin upiokin nuibakin kati ꞌain. Mix Cristonan ꞌixun kamina upiokin kati ꞌain, uix kara mix upí uni ꞌain mi ñui ꞌatimati banaia axá aín banabi katëtanun.<verse eid="1PE 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 3:17" />Asabi ka nux ñu upí ꞌai të́ëmërakë a ꞌikën, usai kananuna Dios kuë́ënkëbë ñu ꞌatima ꞌaimabi tëmërati ꞌain.<verse eid="1PE 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 3:18" />Cristonëxribi ka nun ꞌucha kupí tëmërai bamakëxa, achúshi oishi ꞌitëkëntima oi. Ax ka ñu ꞌaisama ꞌakëma ꞌiakëxa, ꞌaibi ka uni ꞌatima kupí nukama Diosnu ubanti kupí, aín nami ꞌaisama oxun ka bamamiakëxa, ꞌaibi ka baiskitankëx aín Bëru Ñunshinsa ꞌiakëxa.<verse eid="1PE 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1PE 3:19" />Usa ꞌain ka bëru ñushinkama sipunu ꞌikë a bana ñuixuni kuankëxa.<verse eid="1PE 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1PE 3:20" />Usa ꞌain ka bërama nëtë ió ꞌain bëru ñunshin an Dios kainti nëtë a Noénën, kakëxubi kuaisama tankëxa. Noénën nunti ꞌatamainun usa ꞌain ka ꞌitsama unishi, mëkën achúshi ꞌimainun rabë́ ꞌimainun achúshi unishi ꞌumpaxnua ië́akëxa.<verse eid="1PE 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1PE 3:21" />ꞌUmpax ax ka anun bërí nashimikë a ꞌiakëxa, a kupí kananuna bëri ië́kë ꞌain. Nashimikë ꞌaish kananuna nun nami upiokin chukakë ꞌima, Diosan ka ami sinankëxun nun sinan upí ꞌimia, usa ꞌaibi ka Jesucristo bama kupinshi nu ꞌië́mia.<verse eid="1PE 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 3:22" />An ka naínu kuan ꞌaish Diosan mëkeu tsótaxa usa ꞌikë ka, ángelkama ꞌimainun a iskëma kushikama ax kushíira ꞌaín an kikë sabio ꞌia.<verse eid="1PE 3:22" /></para>
  <chapter eid="1PE 3" />
  <chapter number="4" style="c" sid="1PE 4" />
  <para style="s">Cristo kuë́ënkësa oí tsóti</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1" />Mitsux kamina Cristo ꞌiasai tëmëratishi ꞌiti ꞌain, Cristo ënë menua aín naminu tëmëra, usaribiti min naminu ꞌuchatëkënuma ꞌiti ꞌain.<verse eid="1PE 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1PE 4:2" />Ax kamabi nëtën Dios kuë́ënsa oí tsóti kuë́ënkë an ka unin sinankësa oi tsotima ꞌikën.<verse eid="1PE 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 4:3" />ꞌItsa baritia kamina mitsux uni an Diosan bana unankëma an akësaribi okin ñu ꞌatima akën, usa ꞌain kamina, mitsuxribi ꞌatima ñu ꞌai bukuakën, pianan, chaíira, xëanan, paëanan bëtsi ñu rabi bukuakën.<verse eid="1PE 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 4:4" />Bërí kamina mitsun atubëtan a ñukama ꞌaima, usa ꞌain ka atux mitsu sinani ꞌatimati banaia.<verse eid="1PE 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 4:5" />ꞌAibi ka atun uisai kara ꞌiaxa kixun an ënë kati ukëma ꞌainshi ꞌiti ꞌikën, an ka uni bamakëma ꞌimainun bamakë uni ñukákin uisai kara ꞌiaxa kixun kati ꞌikën.<verse eid="1PE 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 4:6" />ꞌAn ka kamabi uni bamakëkama upí bana ñuixuankëxa, atuxribia bëru ñunshin Upiñu ꞌai tsónun, Dios kuënsabi oi ënë nëtënu aín nami kupí ꞌaisama okë unin isti kupí.<verse eid="1PE 4:6" /></para>
  <para style="s">Unikama ꞌakinti</para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7" />Anuan kamabi ñu këñuti ka ꞌuramatia. Usa ꞌain kamina mitsux upí sinanñu ꞌixun, asérabi ënkima ñukati ꞌain.<verse eid="1PE 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 4:8" />Usa ꞌain kamina kamaxi nuibanani kuë́ënti ꞌain, mitsux nuibanankë ꞌain ka min ꞌuchakama tërë́nkë ꞌiti ꞌikën.<verse eid="1PE 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 4:9" />Kamabi kamina min xubunu ami, banakima biti ꞌain.<verse eid="1PE 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 4:10" />Mikama kamina achúshi achushinën, Diosan Bëru Ñunshin upí bia. A upiokin bëruanki kamina bëtsi kamaribi upiokin ꞌakinti ꞌain.<verse eid="1PE 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 4:11" />Uix kara banaia, ax ka Diosan banasaribi ꞌinun banati ꞌikën. Uin kara bëtsi ñu ꞌinania an ka Diosan ꞌakinkëxun bëtsi ꞌakinti ꞌikën. Kamabi ñu ꞌakin kamina Dios Jesucristo kupí rabikë ꞌitanu ꞌati ꞌain, aín kushi pënëkikë an ka nëtë xënibua ꞌaibi ꞌiti ꞌikën. Ashi.<verse eid="1PE 4:11" /></para>
  <para style="s">Tëmërai kuë́ënti.</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12" />ꞌËn nuibakë xukëantu, kamina tëmërai sinankasmakësa ꞌitima ꞌain, bëtsi bëtsi ñu ꞌikëbëbi ka ax bëtsi ñu inukësa ꞌikën.<verse eid="1PE 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 4:13" />ꞌAibi kamina kuë́ënti ꞌain, Cristo ꞌiasaribiti tëmërai ax ukëbë aín nëtë pënëíira anu ꞌinux kuë́ëira kuë́ënti ꞌain.<verse eid="1PE 4:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="1PE 4:14" />Chúamarua tani kamina bëtsian Cristo kupí ñuikë kuë́ënti ꞌain, usa ꞌain ka Diosan Bëru Ñunshin Upíira kamabi nëtën mitsubë ꞌiti ꞌikën.<verse eid="1PE 4:14" /></para>
  <para style="m">
    <verse number="15" style="v" sid="1PE 4:15" />Mikama achushinëx tëmërakë, ax ka uni rëtëkë, mëkamakë, ꞌakanankë, ꞌimainu unin ꞌakë ñunu atsinkë kupí ꞌikëma ꞌikën.<verse eid="1PE 4:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="1PE 4:16" />Uix kara Cristonan ꞌaish tëmëraia ax ka ami rabintima ꞌikën, usai ꞌikima ka aín anë ubankë kupí Dios rabiti ꞌikën.<verse eid="1PE 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 4:17" />Anun Diosan kaiskë unikama aín aintsibi tëmëramiti nëtë ka nukuaxa. ¿Usa ꞌain kara an aín bana kuaisamatankë a unikama Diosan uisa oti ꞌik?<verse eid="1PE 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 4:18" />—Nuibakatibi ka upí ñu ꞌakë an ꞌiëtia, ¿Uisai kara uni ꞌatima ꞌimainun uni ꞌuchañukama ꞌiti ꞌik?<verse eid="1PE 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1PE 4:19" />Axa Dios kuë́ënkësabi oí tëmërakë an ka ax kuë́ënkësabi oki upioki ꞌakin, Diosan aín rara itsi bëruanu ꞌinanti ꞌikën an ka ënkima bëruaia.<verse eid="1PE 4:19" /></para>
  <chapter eid="1PE 4" />
  <chapter number="5" style="c" sid="1PE 5" />
  <para style="s">Uni apankama iglesianu ꞌikë ꞌësëti</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1" />Mitsubë timëkë uni apankama kana ësëin, ꞌëxribi atusaribi apan ꞌixun kana kain, uisai kara Jesucristo tëmërakëxa kixun ꞌunan, ꞌimainun kana aín nëtë pënëíira anu ꞌën ribi ꞌiti ꞌain a ukëbë.<verse eid="1PE 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1PE 5:2" />Diosan mimi ënkë unikama kamina upiokin bëruanti ꞌain, bënë́kin kuríki ñukakima kamina Dios kuënkësabi okin, upioki ꞌati ꞌain.<verse eid="1PE 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 5:3" />Mix aín ꞌibusa ꞌixun ꞌakima kamina upiokin bëruanti ꞌain, minua ka atun unanti ꞌikën.<verse eid="1PE 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 5:4" />Usa ꞌain, ka an bëruankë aín ꞌibuíira ax ukëbëtan, achúshi mañuti pënëíira, ax këñuti nëtëtima a mitsun binuxun ꞌain.<verse eid="1PE 5:4" /></para>
  <para style="s">Kamabi a unikama</para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 5:5" />Usaribikin ka bëná unikama uni apanën kakëxun kuati ꞌikë. Kamabi ka bëtsibë bëtsibë ñumara ꞌiti ꞌikën. Diosan ka bëtsi samaíira a kuëënima ꞌaibi ka axa bëtsibë nuibanankë a ꞌakinia.<verse eid="1PE 5:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="1PE 5:6" />Ñumara Kamina Diosan mëkënua ꞌiti ꞌain, usai ꞌia ka aín nëtën ꞌikëbëtan mi biruti ꞌikën.<verse eid="1PE 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 5:7" />Min ꞌaisama okin sinánkë a kamina Diosnu ënti ꞌain an ka mi bëruanti ꞌikën.<verse eid="1PE 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 5:8" />Kamina sinañu ꞌianan kushi bëruankati ꞌain, ax mimi nishkë ñunshin ꞌatima ka paru ꞌinuanë kuë́ërukin, aín piti barikësa ꞌixun binuxun mi baria.<verse eid="1PE 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 5:9" />Tënëi shaikikima kamina sinanti ꞌain, bëtsi me kamanuaxribi ka min xukëantu mix ꞌikësaribiti tëmëraia kixun.<verse eid="1PE 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 5:10" />ꞌAibi ka mitsux ꞌitsama nëtën tëmërakë ꞌikëbi, Diosan ñu ꞌatima ꞌakëma, kupí kushi, ꞌimianan asérabi ꞌinun ꞌimiti ꞌikën. Abi ka Dios an nuibaki nukë kuënkë a ꞌikën, ꞌimainun ka aín nëtë pënëkikë upíira anu Jesucristobë ꞌinun ꞌimiti ꞌikën.<verse eid="1PE 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 5:11" />Aín kushi ka uinsarabi nëtëtima usabi ꞌikën. Ashi.<verse eid="1PE 5:11" /></para>
  <para style="s">Ashiti kia</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12" />Nun xukën Silvano, an ꞌakinkëxu kana ënë kirika chukumashi insha, anun mi ꞌësëanan mënioki a kama ꞌakinkë a kamina bia, ax ka Diosan ꞌakinkëx. ¡Ënima kaina asérabi abëbi ꞌiti ꞌain!<verse eid="1PE 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 5:13" />Babilonianu ꞌikë mi asaribi okin Diosan kaiskë an ka mi kamia Marcos ꞌën bëchikësa an Cristo rabikë anribi ka mi kamia.<verse eid="1PE 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1PE 5:14" />Kamina bëtsi upiokin ramëkin mëkën ꞌinankin Cristo kupí ꞌati ꞌain.<verse eid="1PE 5:14" /></para>
  <chapter eid="1PE 5" />
</usx>