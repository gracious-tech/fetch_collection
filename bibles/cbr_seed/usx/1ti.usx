<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TI" style="id">- Nuevo Testamento Kakataibo</book>
  <para style="h">1 Timoteo</para>
  <para style="toc1">Pablonëan Timoteo a pain buánmia kirika</para>
  <para style="toc2">1 Timoteo</para>
  <para style="toc3">1 Tim</para>
  <para style="mt">A pain PABLONËN TIMOTEO ubamia KIRIKA</para>
  <chapter number="1" style="c" sid="1TI 1" />
  <para style="s">Pablonën Timoteo asabi ka</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1" />Pablo, Cristo Jesús aín apóstol ꞌikë Diosan xukëxun an nukë iëmikë Jesucristo a nu kainkë a,<verse eid="1TI 1:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="1TI 1:2" />Timoteo, asérabi ꞌën bëchikësa amíira sinánkë. Nuibakin biti ꞌixumabi bikë anun tsóti nukën Papa Dios ꞌimainun Cristo Jesús nun ꞌIbu an mi ꞌinanti ꞌikën.<verse eid="1TI 1:2" /></para>
  <para style="s">Këmëkin an bana ñuikë kamami bëruankati</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3" />ꞌË Macedonia menu kuankin kana mixmi Éfeso ëmanu tikinun mi ka, anuxua bëtsi unikama këmëi banakë an ꞌakësokin axuma anun kamina kati ꞌain,<verse eid="1TI 1:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="1TI 1:4" />kamina kuatima ai nun rarakama ꞌía ënkima abi ñuikë bana a kamina kuatima ꞌain. Ënë ñukaman ka ñúkanankë, kuëbikanankë, ënë kaman ka bëtsi ꞌakinima, Diosan ñu më́ëti ꞌai ami katamëti sinanun.<verse eid="1TI 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1TI 1:5" />Ënë bana kikë ꞌati kuë́ëni kana bëtsibë bëtsibë nuibanani nun nuitu mëu mëniokakë ꞌaish upí sinañu ꞌiti ꞌikën, ax ka achúshi upí sinañu ꞌimainun amíira sinanti a ꞌikën.<verse eid="1TI 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 1:6" />Rairi kaman ka ënë bana ëni amo kiaxa, ꞌimainun ka bëtsi ñu ꞌaki nishananti ꞌaia.<verse eid="1TI 1:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="1TI 1:7" />A kaman ka Diosa bana ꞌunánkë uni ꞌiti kuë́ënia, ꞌaibi ka atunbi ꞌunanima, ka kia ꞌixubi ka uisai kikë kara ꞌunanima.<verse eid="1TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8" />Kananuna unan a tanti kuënëo bana ka upí ꞌikën, anua ꞌikë a kananuna an kikësabiokin ꞌati ꞌain.<verse eid="1TI 1:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="1TI 1:9" />Kananuna sinanti ꞌain kuënëo bana a tanti ax ka, uin kara ñu upí ꞌaia ainama ꞌikën. A tanti bana ax ka aisama uninan ꞌianan bana kuakëma, unina ꞌikë, ꞌimainun ka ꞌatima, ꞌuchañukama, ꞌimainun ax Diosmi kuaianan, an bëtsi ñu rabikë ꞌimainun ax rëtëanana, aín papa, aín tita rëtëkë akamax ka akanankë,<verse eid="1TI 1:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="1TI 1:10" />aín xanuma xanubë ꞌiana aín bënëma unibë ꞌikë, xanuxmabi uni itsibë ꞌikë, an bëtsi uni marukë, këmëntapun ꞌaish këmëi banakin asérabi ꞌakëma, upí bana a asérabima ka kixun ꞌatimakin ñuia.<verse eid="1TI 1:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="1TI 1:11" />Ënë bana upí pënëíira ꞌunamikë ñuiti ka, nukën Papa Diosan ꞌë xuakëxa.<verse eid="1TI 1:11" /></para>
  <para style="s">Pablonën aín ñu më́ëti a</para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12" />Kana asabi ka nukën ꞌIbu Cristo Jesús kain, an ka ꞌë kushionan, ënkima ami upiti sinania ꞌë aín ñumëti ꞌinanxa.<verse eid="1TI 1:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="1TI 1:13" />Bërama kana ꞌën ꞌatimati Jesucristoñui, banakën a ichakin ꞌaisama okën. Usa ꞌaibi ka Diosan ꞌë nuibakin ꞌën ꞌuchakama tërëanxa, ꞌaibi kana ꞌën ami sinama ꞌain, usa ꞌixun kana añu karana ꞌai kixun ꞌunama ꞌain<verse eid="1TI 1:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="1TI 1:14" />Nukën ꞌIbun ka ꞌitsaíira ami sinania nuibakin ꞌë ꞌinanxa, a kupin kananuna Cristo Jesusnan ꞌiti ꞌain, an nu ꞌinankë kupin.<verse eid="1TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 1:15" />Ënëx ka asérabi ꞌikën, kamaxubi ka ꞌunanti ꞌikë: Cristo Jesús ka ënë menu ubakëxa, uni ꞌuchañukama tëmërama ꞌinun iëmi, a kupin kana ꞌëx ira pain a ꞌain.<verse eid="1TI 1:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="1TI 1:16" />ꞌAibi ka Diosan ꞌë nuibatia, Jesucristonën ka bënëkima ñu ꞌanun ꞌë ismiti ꞌikën. Usa ꞌain kana ꞌësaribi ꞌia ami katamëti bamatima oi tsonun ꞌunami.<verse eid="1TI 1:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="1TI 1:17" />¡Aira rabiti ꞌianan pënëiira ꞌaish ꞌApu nëtëtima bamatima oi tsókë, istima achúshi Dios tsokë! Ashi.<verse eid="1TI 1:17" /></para>
  <para style="p">
    <verse number="18-19" style="v" sid="1TI 1:18-19" />Timoteo, ꞌën bëchikësa ꞌikë kana, ënë mi ꞌinanin upioki sinani ax kikësabi oi ꞌinun, ënë ñukama ꞌai kamina upiti mëananu mëniokakë ꞌiti ꞌain, mia kasabi oi ꞌiti ꞌain. Rairinëx ka usai ꞌima an kuë́ënkësa oi ꞌi, a bana timai ami sinanima.<verse eid="1TI 1:18-19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="1TI 1:20" />Ësai ka Himeneo ꞌimainun Alejandro inuaxa, a kana ñunshin ꞌatimanën ꞌapu ꞌinan, an ka ꞌunanti ꞌikën, ꞌaisamai Dios ñui banatima kupí.<verse eid="1TI 1:20" /></para>
  <chapter eid="1TI 1" />
  <chapter number="2" style="c" sid="1TI 2" />
  <para style="s">Kamabi uni Dios ñukaxunti</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1" />Ësokin ꞌanun kana mi kain, kamina ñukati ꞌain, bënëkin abi ñukaxunti ꞌain, asabi ka kakin kamabi uni Dios ñukaxunti ꞌain.<verse eid="1TI 2:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="1TI 2:2" />Kamina kamabi ꞌapu ꞌimainun uni anëkë kamaribi ñukaxunti ꞌain, nuxribinu kuë́ëni upí tani tsonun, anuxun rabikin Diosan bana tanti ꞌain.<verse eid="1TI 2:2" /></para>
  <para style="m">
    <verse number="3" style="v" sid="1TI 2:3" />Ënëx ka upí ꞌai asabi ꞌikë, ësakin ꞌakëbë ka Dios an nu ië́mikë ax kuë́ënia,<verse eid="1TI 2:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="1TI 2:4" />ax ka kuë́ënia kamabi unin ië́kin asérabi anu ukin ꞌunanti.<verse eid="1TI 2:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="1TI 2:5" />Anu ka achúshi Dios ꞌikën, ꞌimainun ka anu uni achúshi a kupinu Diosnan ꞌiti anu ꞌikë, ax ka: uni ꞌaish Jesucristo ꞌikën.<verse eid="1TI 2:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="1TI 2:6" />Ax ka bamati ꞌinamëakëxa kamabi uni ië́miti kupí. Ënë ka ñuiakëxa anun ꞌiti nëtë ꞌitamainun.<verse eid="1TI 2:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="1TI 2:7" />Ënë ñuiti ꞌimainun upí bana ñuiti ka apóstol ꞌë anëaxa ꞌimainun ka, ꞌë xuaxa upíoki sinamianan asérabi ꞌunaminu Judioma unikama ënëx ka, asérabi ꞌikën.<verse eid="1TI 2:7" /></para>
  <para style="s">Uisai kara bëbu ꞌimainun xanu niti ꞌikë</para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8" />Usa ꞌain kana kuë́ënin kamabi unixa me kamanuax mëkën chaiorui Diosbë banati ka asabi ꞌikën, ax ka ꞌain nuitu upí ꞌaish nuibani nishananima ꞌiti ꞌikën.<verse eid="1TI 2:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="1TI 2:9" />Usa ꞌain ka xanu mëniokati ꞌikën, mëniokati ka upitani ꞌiti ꞌikën, masirikikin ka ꞌain bu mënio iratima ꞌikën, kuri mëñuanan ka ñu chabakikë ꞌimainun chupa kupíirakë aribi pañutima ꞌikën.<verse eid="1TI 2:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="1TI 2:10" />Ax mëniorakakë an ka upí ñu ꞌati ꞌikë, usa ꞌain ka xanuxun ꞌën kana Diosnan ꞌai kixun sinánti ꞌikën.<verse eid="1TI 2:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="1TI 2:11" />Xanuxun ka ꞌunamikëxun banakima Diosan bana kuati ꞌikën, ꞌimainun ka nuibanankë ꞌiti ꞌikën.<verse eid="1TI 2:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="1TI 2:12" />ꞌImainun kana timë́kë ꞌanuxun xanuxun ꞌunamiti a kuë́ënima, uni ka kuëbitima ꞌikën, usa ꞌaika banakima isti ꞌikën.<verse eid="1TI 2:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="1TI 2:13" />Adán pain ka Diosan uniokëxa, ꞌatankëxun ka Evaribi ꞌakëxa.<verse eid="1TI 2:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="1TI 2:14" />ꞌImainun ka Adán parankëma ꞌiakëxa, Eva an ka parankë ꞌaish ꞌuchakëxa.<verse eid="1TI 2:14" /></para>
  <para style="m">
    <verse number="15" style="v" sid="1TI 2:15" />Usa ꞌain ka xanu ië́kë ꞌiti ꞌikën, kikësabioki tita ixun upioki sinani nuibanani upíira ꞌiti ꞌikën.<verse eid="1TI 2:15" /></para>
  <chapter eid="1TI 2" />
  <chapter number="3" style="c" sid="1TI 3" />
  <para style="s">Uisai kara iglesianu ñu më́ëkë unikama ꞌiti ꞌikë</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1" />Ënëx ka asérabi ꞌikën: Uin kara ënë ñumëti ꞌaisatania an ka ñu upí ꞌati sinanti ꞌikën.<verse eid="1TI 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1TI 3:2" />An ënë ñumëti bikë a ka ꞌatima okin ñuikëma ꞌitima ꞌikën, ꞌianan ka achúshi xanu ñuishi ꞌianan, ñu ꞌaisama ꞌaisa tankibi tënëkë ꞌiti ꞌikën, ꞌianan ka nuibanankë, ꞌakianankë, uni aín xubunu nukumianan, bëtsi ñu ꞌunamisabi ꞌiti ꞌikën.<verse eid="1TI 3:2" /></para>
  <para style="m">
    <verse number="3" style="v" sid="1TI 3:3" />Ka ꞌiti ꞌikë paënkëma ꞌianan, mëanankë unima, nuibanankë, ꞌimainun kuríki kuë́ëirakëma ꞌiti ꞌikën.<verse eid="1TI 3:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="1TI 3:4" />Usa ꞌikë ka aín xubunu ꞌikë aín bëchikëkaman aín bana tani upiti abë inun ꞌimikë ꞌiti ꞌikën.<verse eid="1TI 3:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="1TI 3:5" />Uinu ꞌikë unin kara aín xubunuabi upiti ꞌima, ¿An kara uisaxun iglesianua Diosan ñumëti ꞌakin upiokin bëruanti ꞌik?<verse eid="1TI 3:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="1TI 3:6" />Usa ꞌain ka an ñumëti ꞌakë ax bërí ië́kë ax ꞌitima ꞌikë, ꞌën kana bëtsisamaira ꞌai ki nipakëti anua ñunshin ꞌatima nia anuribi xutima kupí.<verse eid="1TI 3:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="1TI 3:7" />ꞌImainun ka uni ꞌuchañu kamaribia ñuikima nuibakë ꞌiti ꞌikë, ꞌatimati ami banakëbëa, ñunshin ꞌatimanën ꞌakë ñunu nipakëtima kupin.<verse eid="1TI 3:7" /></para>
  <para style="s">An iglesia bëruankë unikama</para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8" />Usaribiti ka an iglesianu ꞌakinkëkama ax nuibanankë ꞌianan këmëi banakëma, paënkëma ꞌimainun kuríki ꞌaisamokin bikë ꞌitima ꞌikën.<verse eid="1TI 3:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="1TI 3:9" />Ñu unpukëkama kamina asérabi ꞌë ismia, upí sinanñu ꞌai ꞌiti kupí.<verse eid="1TI 3:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="1TI 3:10" />Uisai kara ꞌia kixun pain iskëxubia uisa ñu ꞌaisamabi ꞌaima nitsia iskin ka aín ñu më́ëti ꞌati ꞌinanti ꞌikën.<verse eid="1TI 3:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="1TI 3:11" />Usaribi ka xanukama ꞌiti ꞌikën, këmëkin bana ñuikëma, bëtsibë nuibanankë, upiti kanankë, ꞌimainun upiokin ñu ꞌakë ka ꞌiti ꞌikën.<verse eid="1TI 3:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="1TI 3:12" />An iglesianu ñu mëëti ꞌakinkë ax ka achúshi xanun bënë ꞌiti ꞌikën, ꞌianan ka aín bëchikë aín xubunu ꞌikë kamaribi upiokin bëruankë ꞌiti ꞌikën.<verse eid="1TI 3:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="1TI 3:13" />An iglesianu ñu mëëti akinkë ax ka upiokin ꞌiskë ꞌiti ꞌikën, usa ai ka kamabi unia aín ñu më́ëti ꞌaia kuë́ënkin iskë Cristo Jesusan ꞌië́mikëx ami sinani chaa ꞌiti ꞌikën.<verse eid="1TI 3:13" /></para>
  <para style="s">Asérabia nukë Diosan ismikë</para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14" />Mi bënë́kin isikuanti kana kaini; ꞌixunbi kana ënë mi inshaxunin,<verse eid="1TI 3:14" /></para>
  <para style="m">
    <verse number="15" style="v" sid="1TI 3:15" />ꞌëx nukukëbëtamabi kamina ꞌunanti aín Diosan aintsikama ꞌax ka iglesia ꞌikën, an ka an ira asérabi kushiokin nu bëruaiña.<verse eid="1TI 3:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="1TI 3:16" />Ax ka bëtsiokin sinantisama ꞌikë asérabi nukama ami sinankë ax ka chaíira ꞌikën:</para>
  <para style="q" vid="1TI 3:16">Cristo ka unisa ꞌai mërakëxa, an nukë ꞌunamikë a ka aín Bëru Ñunshin Upitan ꞌunamiakëxa, usa ꞌikë ka angelkaman isakëxa. Kamabi ëmanuxun ka ñuiakëxa, usa ꞌain ka me kamanuaribi ami katamëaxa, ax ka aín nëtë pënëíira anu bikë ꞌiakëxa.<verse eid="1TI 3:16" /></para>
  <chapter eid="1TI 3" />
  <chapter number="4" style="c" sid="1TI 4" />
  <para style="s">Këmëkin ꞌunamikë banakama</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1" />ꞌAibi ka Bëru Ñunshin Upí asérabi kia, anun nëtë këñuti ꞌurama ꞌain ka aín patsanën ami sinanti ënti ꞌikën, bëru ñunshin ꞌatimakaman parankëxun ka ami katamëti ënti ꞌikën.<verse eid="1TI 4:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="1TI 4:2" />Usa ꞌixun ka ñu upí ꞌakatsi kikin uni parankibi ñu ꞌaisama ꞌaia, aín sinan manë xarokë ꞌunanti okësa ꞌixun ka ñu ꞌatimashi ꞌati sinania.<verse eid="1TI 4:2" /></para>
  <para style="m">
    <verse number="3" style="v" sid="1TI 4:3" />Usa unikaman ka xanu bitima kianan a pitima, ñu isa pitima ꞌikë kia, ꞌaibi ka Diosan, kamabi ñu piti uniokëxa. Usa ꞌain ka nux ami katamëkin asabi ka katankëxun piti asabi ꞌikën, ꞌimainun kananuna asérabi ka ax ꞌikë kixun ꞌunanti ꞌain.<verse eid="1TI 4:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="1TI 4:4" />Kamabi Diosan unio ñu ax ka upí ꞌikë, usa ꞌikë kananuna timakima Dios asabi ka kakin piti ꞌain.<verse eid="1TI 4:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="1TI 4:5" />Usa ꞌain ka aín bana ꞌimainun Dios ñukakë an upí ꞌimia.<verse eid="1TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6" />Ënë ñukama nun xukëantu ꞌunami kamina asérabi Jesucristo ñu mëxunkë ꞌiti ꞌain, usakin ai kamina upiokin pikësa ꞌimainun aín bana ꞌupiokin ꞌunamiana ami sinanti ꞌain.<verse eid="1TI 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1TI 4:7" />ꞌAibi kamina ënë nëtënuxun ñuikë bana kuatima ꞌain, ax ka ꞌaísama ꞌikën, a kuakima kamina ami kushikin abi ñu upí ꞌati ꞌain,<verse eid="1TI 4:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="1TI 4:8" />nun abati shaikikë an ka upí ꞌikën, usamaíira ka anun nëtëtima oi tsóti ax ꞌikën, a nu ꞌinankë bërí nux tsóti ꞌimainun usai ꞌikuanti a ꞌikën.<verse eid="1TI 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="1TI 4:9" />Ënëx ka asérabi ꞌikën ꞌimainun ka kamaxunbi aribi ꞌati ꞌikën.<verse eid="1TI 4:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="1TI 4:10" />A kupin kananuna ꞌitsaíira ñu më́ëkin tëanan, ami kushikin kainti ꞌain, Dios bamatimoi tsókë ax ka an kamabi uni ië́mikë a ꞌikën, uix kara ami katamëtia an ka aina ꞌiti ꞌikën.<verse eid="1TI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11" />Ënë ñukama kamina xukin ꞌunamiti ꞌain.<verse eid="1TI 4:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="1TI 4:12" />Uibi ka mi bëná uni ꞌikë mi usantima ꞌikën. Usai ꞌima kamina mix upí ꞌiti ꞌain, an rabikë kamanribia mi upí isnun. Mix banai nuibanankë a kuanan, mix ꞌikësaribikin ꞌiti ꞌunanti ꞌikën, axribi ka Diosmi katamëti nuibanani misaribi ꞌiti ꞌikën.<verse eid="1TI 4:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="1TI 4:13" />ꞌË nukutamainun kamina, kamabi uni a kuati sinananun kuënëokë bana kushin ñuñu ꞌakin nun xukënkama a kuati ami sinanun ꞌunamiti ꞌain.<verse eid="1TI 4:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="1TI 4:14" />Kamina ëntima ꞌain mia Diosan aín ñu mëti ꞌanun ꞌinan a, mia kasabi okin ka apankama iglesianu ꞌikë an min maxkanu aín mëkën nanti ꞌikë.<verse eid="1TI 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 4:15" />Kamina bëruankati ꞌai ënë ñukama kuakin upioki ꞌaimi, mix upiti nikë a ka isti ꞌikën.<verse eid="1TI 4:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="1TI 4:16" />Kamina bëruankati ꞌain mix tsókë ꞌimainun min bëtsi ꞌunamikë a, usakin ꞌai kamina mix upí ꞌiti ꞌain. Usakin ꞌai ꞌië́kin kamina an mi kuakë aribi ꞌië́miti ꞌain.<verse eid="1TI 4:16" /></para>
  <chapter eid="1TI 4" />
  <chapter number="5" style="c" sid="1TI 5" />
  <para style="s">Usakin bëtsi akinti</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1" />ꞌUnamikin kamina uni apan ñukakima; upiokin min papa ꞌakësokin kati ꞌain, uni bëná kamaribi kamina min xukën akësaribiokin kati ꞌain.<verse eid="1TI 5:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="1TI 5:2" />Xanu apan kamina min tita akësabi okin nuibati ꞌain, bëná kamaribi kamina min xukën akësa oti ai, xanu chipaish kamina ami ꞌatimokin sinankima kuë́ëmikin kati ꞌain.<verse eid="1TI 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3" />Xanu kasunamëkë kamina an ꞌakinti ꞌaima aín akinti ꞌain.<verse eid="1TI 5:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="1TI 5:4" />ꞌAibi xanu kasunamëkë tuañu ianan babañu ixun ka xanu a akinti ꞌikën, an paian ka bërama bëruonan ꞌakinia. Usakin ꞌati ka Dios kuë́ënia.<verse eid="1TI 5:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="1TI 5:5" />Asérabi xanu kasunamëkë abi ꞌixun ka, an ka ami sinánkin Dios nëtën ꞌimainun ñantan ñukatia.<verse eid="1TI 5:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="1TI 5:6" />ꞌAibi kasunamëkë xanu an ñu ꞌatima ꞌatinu ꞌinamëkë ax ka bamakësa ꞌikë.<verse eid="1TI 5:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="1TI 5:7" />Usa ꞌain kamina ën akësa okin ati ꞌain, uinbi uisakibi ñuikëma ꞌitanun.<verse eid="1TI 5:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="1TI 5:8" />Uin kara aín aintsi akinima, an ka aín aintsi ꞌibukama ami manúkin akinima ax ka ami sinankëma ꞌaish ꞌuchañu uni kamasamaíira ꞌikën.<verse eid="1TI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9" />Xanu kasunamëkë aín anë kirikanu ꞌakë, ax ka sesenta baritia inúkë ꞌiti ꞌikë, usa ꞌaish ka achuishitishi bënua ꞌiakëxa.<verse eid="1TI 5:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="1TI 5:10" />ꞌImainun ka upiokin aín ñu më́ëti unankë ꞌiti ꞌikë. Aín tuakama upiokin kaniokë ꞌimainun ka ꞌain xubunu uni nukutia bikë ꞌiti ꞌikën ianan ka upí unikama ꞌain taë chukakë ianan; tëmërakë unikama ꞌakinkë ꞌimainun bëtsi ñukamaribi.<verse eid="1TI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11" />ꞌAibi ka kasunamëkë xanukama aín bari chukuma ꞌain anë kirikanu nantima ꞌikën, usa ꞌain ka Jesucristomi manuti amiribishi bënutisa tanti ꞌikën.<verse eid="1TI 5:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="1TI 5:12" />ꞌImainun ka abi kikësabi okin ñu akëma kupí anunbi ꞌuchokë ꞌiti ꞌikën.<verse eid="1TI 5:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="1TI 5:13" />ꞌIanan ka xubunu atsinbëkini nikin ka chikishkin, këmëkin bana ñuibëkini nikin a ñuitima bana abi ñuia.<verse eid="1TI 5:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="1TI 5:14" />Usa ꞌain kana kuë́ëni xanu kasunamëkë ꞌain bari chukuma an bënutankëxun, tuaxun upiokin, kaniokin aín xubu bëruonan, ami banakin ñuikëma ꞌiti ꞌikën, añu kupibi ñuikëma.<verse eid="1TI 5:14" /></para>
  <para style="m">
    <verse number="15" style="v" sid="1TI 5:15" />Rairi xanu kasunamëkënën ka Diosmi manukin ñunshin ꞌatima nuia.<verse eid="1TI 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TI 5:16" />Uinu ꞌikë xanux kara Cristonan<note caller="+" style="f"><char style="fr" closed="false">5.16 </char><char style="ft" closed="false">insha kirika rairinu ka kia, bëbu ꞌimainun xanu.</char></note> ꞌikë an ka aín aintsi kasunamëkë ꞌakinti ꞌikë, iglesianë a ꞌakintima kupí. Usa ꞌain ka iglesianë xanu kasunamëkë an ꞌakinti ꞌaima a ꞌakinti ꞌikën.<verse eid="1TI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17" />An iglesianu upiti tëanan ꞌakinkë a ka ꞌain bana tankin nuibakin upiokin ꞌakinti ꞌikën, an upiokin ñuixuana ꞌunamikë a.<verse eid="1TI 5:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="1TI 5:18" />Kuënëokë bana ka kia: —Vaca bënë an ñu bëru takáki chakakin amakë a kamina kuëtanitima ꞌain. ꞌImainun ka: —An ñu më́ëkë uni ax kupiokë ꞌiti ꞌikën.<verse eid="1TI 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1TI 5:19" />Uni apan kaniakëkëmi, manankë a kamina kuatima ꞌain. Rabë́ ꞌimainun achushinëx kikëbëtan kamina asérabi ka kati ꞌain.<verse eid="1TI 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 5:20" />An ënkima ꞌatima ñu ꞌai ꞌuchakë a kamina, kamaxubia kuatanun ësë́ti ꞌain, usakin ꞌakëbë ka rairi kamaribi rakuë́ti ꞌikën.<verse eid="1TI 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1TI 5:21" />Mi kana ënë ꞌinanin, Dios, Jesucristo ꞌimainun angelkama an kaiskë an ꞌismainun, mi ꞌinankë bana ënë kamina bëtsi ꞌaisama okima sënëbi ꞌimiti ꞌain.<verse eid="1TI 5:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="1TI 5:22" />Upiokin isumashi kamina bënëkinshi bëtsinu min mëkën nantima ꞌain, mixribi ax ꞌikësai ꞌuchatima kupí. Usai ꞌima kamina kamabi ñu ꞌaisamami bëruankati ꞌain.<verse eid="1TI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23" />Min puku ꞌaisama ꞌixun kamina unpax, ꞌanan uvas baka chukumashi xëati ka asabi ꞌikë, min puku ꞌaisama ꞌitima kupí.<verse eid="1TI 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24" />Rairinën ꞌuchakama ka ꞌunánkë ꞌikë anuan tëmërati nëtë ꞌukëma ꞌaibi, bëtsi unikamanan ax ꞌinúkë ꞌain ꞌunánkë ꞌiti ꞌikën.<verse eid="1TI 5:24" /></para>
  <para style="m">
    <verse number="25" style="v" sid="1TI 5:25" />Usaribiti ka uin kara ñu upí ꞌaia ax ꞌunánkë ꞌikë, ꞌimainun ka ñu ꞌatima ax unë́kë ꞌima.<verse eid="1TI 5:25" /></para>
  <chapter eid="1TI 5" />
  <chapter number="6" style="c" sid="1TI 6" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1" />Kamabi an ñu më́ëkë uni an ka, an ñu më́mikë uni ami sinakima upiokin kamabi nuibati ꞌikën, Diosan anë ꞌatimakin ñuiana nun ꞌunamikë a ñuiribi ꞌatimati batima kupí.<verse eid="1TI 6:1" /></para>
  <para style="m">
    <verse number="2" style="v" sid="1TI 6:2" />ꞌImainun ka uix kara axa Jesucristomi katamëkë an ñu mëmikëñu ꞌikë anribi, ka an ñu mëxunkë nuibati ꞌikën, ax ribi Jesucristomi katamëkë ꞌixun ka. Anribi upiokin ñu axunti aín, usakian an ꞌakë ax ka nun xukën ꞌixun kuë́ëkin ñu bitsi upí ꞌiti ꞌikën.<verse eid="1TI 6:2" /></para>
  <para style="s">Këmëkin ñuikë ꞌimainun asérabi ñuñuira ꞌiti</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 6:3" />Uin kara abi sinankë ñu ꞌunamia ax ka nukën ꞌIbu Jesucristo, ñuia nun ꞌunamikë usama ꞌikën.<verse eid="1TI 6:3" /></para>
  <para style="m">
    <verse number="4" style="v" sid="1TI 6:4" />An ka rabiakakin añu ñubi ꞌunanima, ꞌimanun ka ꞌatima sinañu ꞌaish kuëbikanani bëtsi ñui banaia ax ka achúshi insinsa ꞌikën. Anun ka pishuti, nishti, chichananti, mëananti usama kiti akama ꞌaia,<verse eid="1TI 6:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="1TI 6:5" />ꞌimainun ka nëtëtima mëanankin bëtsi ꞌatimakin sinamia, usai ꞌikëkama an ka ñu atima ꞌakin sinanima, ka asérabi ka kixun ꞌunanima Diosmi katamëkinsa ꞌitsaíira kuríki biti ꞌikë kixun sinania.<verse eid="1TI 6:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="1TI 6:6" />Ka asérabi ꞌikën Diosmi katamëti ax ka itsaíira ñuñu ꞌiti ꞌikë, aibi ka usama ꞌikë uin kara bitsia an ka ashi biti ꞌiti ꞌikën.<verse eid="1TI 6:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="1TI 6:7" />Añu ñubi kananuna ënë nëtënu bëkëma ꞌain, ꞌimainun ka ꞌañu ñubi kananuna ubantima ꞌain.<verse eid="1TI 6:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="1TI 6:8" />Usa ꞌaish kananuna pitiu ꞌianan chupa pañu ꞌaish kuë́nti ꞌain.<verse eid="1TI 6:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="1TI 6:9" />Usa ꞌain ka axa ꞌitsaíira ñuñu ꞌisatankë ax ñu ꞌatima ꞌai ñunshinan tankë ꞌiti ꞌikën. Atux ka ñu ꞌakë kupin kurikiñu ꞌiti sinankë kupí ꞌaisama okin këñukë ꞌiti ꞌikën.<verse eid="1TI 6:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="1TI 6:10" />Nux kurikiñu ꞌitishi sinánkë ꞌixun kananuna ꞌatima ñu ꞌati sinani; usa ꞌain ka bëtsikama an bëtsi ñu kuë́ënkë, ax ñu upí ꞌakë a ëni tëmëraia.<verse eid="1TI 6:10" /></para>
  <para style="s">Ñu inukin upiokin sinanti</para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11" />Aibi mix Diosan uni ꞌaish kamina, ëne ñukamanua chikíti ꞌain, upiokin sinani tsóti, ami katamëti, nuibani, ami kushi tëmërakibi ñu biti ꞌimainun mi nuitunën sinani ñumara ꞌiti ꞌain.<verse eid="1TI 6:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="1TI 6:12" />Upiti mëanani kamina upiokin min sinanbëtabi ami katamëti ꞌain, anumi nëtë́timoi tsóti a kamina ꞌëntima ꞌain, akupia mi Diosan kaisá a kamina, ami katamëkin ꞌitsaíira unia mi isnun ñuiñakën.<verse eid="1TI 6:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="1TI 6:13" />Bëri kana Dios an kamabi ñu unio ꞌimainun Jesucristo an ribia Poncio Pilato ꞌupiokin unamikin ñuixua an kuaiminun kana, ësakin mi kain,<verse eid="1TI 6:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="1TI 6:14" />usa ꞌain kamina ꞌën kakëxun kuati ꞌain, unin ka uisakinbi mi katima ꞌikë, Jesucristo pënëíira kuatsini utëkënti ꞌitamainun.<verse eid="1TI 6:14" /></para>
  <para style="m">
    <verse number="15" style="v" sid="1TI 6:15" />Anun ax uti nëtë ꞌikëbëtan ka, Diosan Jesucristo xutëkënti ꞌikën axa,</para>
  <para style="p" vid="1TI 6:15">ꞌApuíira ꞌianan kushíira ꞌai ꞌapukaman ꞌApu ꞌimainun ꞌibukama ꞌIbu ꞌikë ꞌiminuxun ꞌaia.<verse eid="1TI 6:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="1TI 6:16" />Axëshi ka bamatimaoi tsókë a ꞌikë, ax ka tirí xabaira uinbi ꞌurama oisama anu sotia. Uinu ꞌikë uninbi ka ꞌiskëma ꞌikë, ꞌimainun ka uinu ꞌikë uninbi isima ꞌikë uinbi ka istima ꞌikën. ¡Kushíira ꞌikë ami sinankin xënibua aibi a rabiti ꞌikën!<verse eid="1TI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17" />Ënë nëtënu ꞌitsaíira ñuñukama mitsun kamina, min ñun rabiakatima ai, min kuríki ami katamëtima ꞌain. Usai ikima kamina upiokin Dios ax uti a kainti ꞌain, an ka chaíira ñu abitsinu asabi ꞌinun nu inania.<verse eid="1TI 6:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="1TI 6:18" />Kamina upiokin ñu ꞌaia, anubi ñuñuiara ꞌinun kati ꞌain, ꞌimainun ka aín ñuñu ꞌixun bësi kuënki ꞌinanti ꞌikë, ianan ka ñu inantishi ikë.<verse eid="1TI 6:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="1TI 6:19" />Usokin ai kamina ꞌitsaíira ñuñu ꞌinuxun ami katamëkin asérabi këmëma bana a anun tsóti a biti ꞌain.<verse eid="1TI 6:19" /></para>
  <para style="s">Anu sënënkin Pablonën Timoteo ka</para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20" />Timoteo, kamina upiokin bëruanti ꞌain Diosan mi ꞌinankë a, ñankabia ënë mënuxun këmëki ñuikë ꞌaisama banakama a kamina kuatima ꞌain.<verse eid="1TI 6:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="1TI 6:21" />Bëtsi kaman ka an unairakë unamikima ëanxa, ëni ka ami sinanti manuaxa.</para>
  <para style="m" vid="1TI 6:21">Nukën ꞌIbu ka mikama nuibatia, ꞌAshi.<verse eid="1TI 6:21" /></para>
  <chapter eid="1TI 6" />
</usx>