<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HAB" style="id">- Biblica® Open Telugu Contemporary Version</book>
  <para style="h">హబక్కూకు</para>
  <para style="toc1">హబక్కూకు ప్రవచనం</para>
  <para style="toc2">హబక్కూకు</para>
  <para style="toc3">హబ</para>
  <para style="mt1">హబక్కూకు</para>
  <para style="mt2">ప్రవచనం</para>
  <chapter number="1" style="c" sid="HAB 1"/>
  <para style="p">
    <verse number="1" style="v" sid="HAB 1:1"/>ఇది ప్రవక్తయైన హబక్కూకు ఒక దర్శనంలో పొందుకున్న ప్రవచనము.<verse eid="HAB 1:1"/></para>
  <para style="b"/>
  <para style="s1">హబక్కూకు ఫిర్యాదు</para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 1:2"/>యెహోవా, సహాయం కోసం నేను మొరపెట్టినా,</para>
  <para style="q2" vid="HAB 1:2">ఎంతకాలం వినకుండా ఉంటావు?</para>
  <para style="q1" vid="HAB 1:2">“హింస!” జరుగుతుందని నీకు మొరపెట్టినా</para>
  <para style="q2" vid="HAB 1:2">ఎంతకాలం రక్షించకుండ ఉంటావు?<verse eid="HAB 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 1:3"/>నన్నెందుకు దుష్టత్వాన్ని చూసేలా చేస్తున్నావు?</para>
  <para style="q2" vid="HAB 1:3">తప్పు చేయడాన్ని నీవెందుకు సహిస్తున్నావు?</para>
  <para style="q1" vid="HAB 1:3">నాశనం హింస నా ముందే ఉన్నాయి;</para>
  <para style="q2" vid="HAB 1:3">కలహాలు ఘర్షణలు చెలరేగుతున్నాయి.<verse eid="HAB 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 1:4"/>అందుకే ధర్మశాస్త్రం కుంటుపడింది,</para>
  <para style="q2" vid="HAB 1:4">ఎప్పుడూ న్యాయం జరగడం లేదు.</para>
  <para style="q1" vid="HAB 1:4">దుర్మార్గులు నీతిమంతులను చుట్టుముడుతున్నారు,</para>
  <para style="q2" vid="HAB 1:4">న్యాయం చెడిపోతుంది.<verse eid="HAB 1:4"/></para>
  <para style="s1">యెహోవా జవాబు</para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 1:5"/>“దేశాల వైపు గమనించి చూసి,</para>
  <para style="q2" vid="HAB 1:5">నిర్ఘాంతపోయి ఆశ్చర్యపడండి:</para>
  <para style="q1" vid="HAB 1:5">ఎందుకంటే మీ కాలంలో నేనొక కార్యాన్ని చేయబోతున్నాను,</para>
  <para style="q2" vid="HAB 1:5">దాని గురించి ఎవరైనా మీకు చెప్పినా</para>
  <para style="q2" vid="HAB 1:5">మీరు దాన్ని నమ్మరు.<verse eid="HAB 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 1:6"/>తమవి కాని నివాస స్థలాలను ఆక్రమించుకోడానికి,</para>
  <para style="q2" vid="HAB 1:6">భూమి అంచుల వరకు తిరిగే</para>
  <para style="q1" vid="HAB 1:6">క్రూరులును, ఆవేశపరులునైన</para>
  <para style="q2" vid="HAB 1:6">బబులోను ప్రజలను<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">కల్దీయులను</char></note> నేను రేపుతున్నాను.<verse eid="HAB 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 1:7"/>వారు అత్యంత భయంకరమైన ప్రజలు;</para>
  <para style="q2" vid="HAB 1:7">వారు తమకు ఇష్టం వచ్చినట్లు చట్టాలు చేసుకుని</para>
  <para style="q2" vid="HAB 1:7">అధికారం చెలాయిస్తారు.<verse eid="HAB 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 1:8"/>వారి గుర్రాలు చిరుతపులి కంటే వేగవంతమైనవి,</para>
  <para style="q2" vid="HAB 1:8">చీకట్లలో తిరిగే తోడేళ్ళ కంటే భయంకరమైనవి.</para>
  <para style="q1" vid="HAB 1:8">వారి గుర్రాల దండు దూకుడుగా చొరబడతాయి;</para>
  <para style="q2" vid="HAB 1:8">వారి రౌతులు దూరం నుండి వస్తారు.</para>
  <para style="q1" vid="HAB 1:8">ఎరను పట్టుకోవడానికి గ్రద్ద వచ్చినట్లుగా వారు వేగంగా వస్తారు;<verse eid="HAB 1:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="HAB 1:9"/>వారంతా దౌర్జన్యం చేయడానికి వస్తారు.</para>
  <para style="q1" vid="HAB 1:9">ఎడారి గాలిలా వారి ముఖాలను పైకెత్తి</para>
  <para style="q2" vid="HAB 1:9">ఇసుకరేణువులంత విస్తారంగా ప్రజలను బందీలుగా పట్టుకుంటారు.<verse eid="HAB 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 1:10"/>వారు రాజులను వెక్కిరిస్తారు</para>
  <para style="q2" vid="HAB 1:10">పాలకులను ఎగతాళి చేస్తారు.</para>
  <para style="q1" vid="HAB 1:10">కోటలున్న పట్టణాలను చూసి నవ్వుతారు;</para>
  <para style="q2" vid="HAB 1:10">మట్టి దిబ్బలు వేసి వాటిని స్వాధీనపరచుకుంటారు.<verse eid="HAB 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 1:11"/>గాలికి కొట్టుకుపోయినట్లుగా కొట్టుకుపోతూ అపరాధులవుతారు,</para>
  <para style="q2" vid="HAB 1:11">తమ బలాన్నే తమ దేవునిగా భావిస్తారు.”<verse eid="HAB 1:11"/></para>
  <para style="s1">హబక్కూకు రెండవ ఫిర్యాదు</para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 1:12"/>యెహోవా, నీవు ఆరంభం నుండి ఉన్నవాడవు కావా?</para>
  <para style="q2" vid="HAB 1:12">నా దేవా, నా పరిశుద్ధుడా, నీవు ఎన్నడు చనిపోవు.</para>
  <para style="q1" vid="HAB 1:12">యెహోవా, నీవు వారిని తీర్పు తీర్చడానికి నియమించావు;</para>
  <para style="q2" vid="HAB 1:12">నా రక్షకా, మమ్మల్ని దండించడానికి నీవు వారిని నియమించావు.<verse eid="HAB 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 1:13"/>నీ కళ్లు చెడును చూడలేనంత స్వచ్ఛమైనవి;</para>
  <para style="q2" vid="HAB 1:13">నీవు తప్పును సహించలేవు.</para>
  <para style="q1" vid="HAB 1:13">మరి ద్రోహులను ఎందుకు సహిస్తున్నావు?</para>
  <para style="q2" vid="HAB 1:13">దుర్మార్గులు తమకంటే నీతిమంతులైన వారిని నాశనం చేస్తుంటే</para>
  <para style="q2" vid="HAB 1:13">నీవెందుకు మౌనంగా ఉన్నావు?<verse eid="HAB 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 1:14"/>పాలకుడు లేని సముద్ర జీవులతో,</para>
  <para style="q2" vid="HAB 1:14">సముద్ర చేపలతో నీవు నరులను సమానులుగా చేశావు.<verse eid="HAB 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 1:15"/>చెడ్డ శత్రువు వారందరిని గాలంతో పైకి లాగి,</para>
  <para style="q2" vid="HAB 1:15">తన వలలో వారిని పట్టుకుంటాడు,</para>
  <para style="q1" vid="HAB 1:15">తన ఉచ్చులో వారిని పోగుచేసుకుని</para>
  <para style="q2" vid="HAB 1:15">సంతోషంతో గంతులు వేస్తాడు.<verse eid="HAB 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 1:16"/>తన వల వలన విలాసవంతమైన జీవితం</para>
  <para style="q2" vid="HAB 1:16">మంచి ఆహారం దొరుకుతుందని</para>
  <para style="q1" vid="HAB 1:16">తన వలకు బలులు అర్పించి</para>
  <para style="q2" vid="HAB 1:16">తన ఉచ్చుకు ధూపం వేస్తాడు.<verse eid="HAB 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 1:17"/>అతడు కనికరం లేకుండా దేశాలను నాశనం చేస్తూ,</para>
  <para style="q2" vid="HAB 1:17">నిత్యం తన వలను ఖాళీ చేస్తూనే ఉంటాడా?<verse eid="HAB 1:17"/></para>
  <para style="b"/>
  <chapter eid="HAB 1"/>
  <chapter number="2" style="c" sid="HAB 2"/>
  <para style="q1">
    <verse number="1" style="v" sid="HAB 2:1"/>నేను నా కావలి స్థలం దగ్గర కనిపెట్టుకుని</para>
  <para style="q2" vid="HAB 2:1">నగర గోడపై నిలబడి ఉంటాను;</para>
  <para style="q1" vid="HAB 2:1">ఆయన నాతో ఏమి చెప్తాడో,</para>
  <para style="q2" vid="HAB 2:1">ఈ ఫిర్యాదుకు<note caller="+" style="f"><char style="fr" closed="false">2:1 </char><char style="fq" closed="false">ఈ ఫిర్యాదుకు </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">ఈ గద్దింపుకు</char></note> నేను ఏమి జవాబు చెప్పాలో చూస్తాను.<verse eid="HAB 2:1"/></para>
  <para style="s1">యెహోవా జవాబు</para>
  <para style="p">
    <verse number="2" style="v" sid="HAB 2:2"/>యెహోవా నాకిలా జవాబిచ్చారు:</para>
  <para style="q1" vid="HAB 2:2">“ప్రకటించేవాడు పరుగెడుతూ సులభంగా చదవడానికి వీలుగా</para>
  <para style="q2" vid="HAB 2:2">దర్శన సందేశాన్ని</para>
  <para style="q2" vid="HAB 2:2">పలక మీద స్పష్టంగా వ్రాయి.<verse eid="HAB 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 2:3"/>దర్శన సందేశం ఒక నియమిత సమయంలో జరుగుతుంది;</para>
  <para style="q2" vid="HAB 2:3">అది అంతం గురించి మాట్లాడుతుంది</para>
  <para style="q2" vid="HAB 2:3">అది తప్పక నెరవేరుతుంది.</para>
  <para style="q1" vid="HAB 2:3">అది ఆలస్యమైనా, దాని కోసం వేచి ఉండండి;</para>
  <para style="q2" vid="HAB 2:3">ఇది ఖచ్చితంగా జరుగుతుంది</para>
  <para style="q2" vid="HAB 2:3">ఆలస్యం కాదు.<verse eid="HAB 2:3"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 2:4"/>“చూడండి, శత్రువు కోరికలు న్యాయమైనవి కాకపోయినా</para>
  <para style="q2" vid="HAB 2:4">అతడు అతిశయపడుతున్నాడు;</para>
  <para style="q2" vid="HAB 2:4">కాని నీతిమంతుడు తన నమ్మకత్వాన్ని బట్టి జీవిస్తాడు.<verse eid="HAB 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 2:5"/>ద్రాక్షరసం అతన్ని మోసం చేస్తుంది;</para>
  <para style="q2" vid="HAB 2:5">గర్విష్ఠియైన అతడు ఎప్పుడూ విశ్రమించడు.</para>
  <para style="q1" vid="HAB 2:5">అతనికి పాతాళమంత దురాశ ఉన్నందున</para>
  <para style="q2" vid="HAB 2:5">మరణంలా అది ఎన్నడూ తృప్తిపడదు,</para>
  <para style="q1" vid="HAB 2:5">అతడు సమస్త జనాలను వశపరచుకుంటాడు</para>
  <para style="q2" vid="HAB 2:5">ప్రజలందరిని బందీలుగా తీసుకెళ్తాడు.<verse eid="HAB 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HAB 2:6"/>“అయితే వారందరూ అతన్ని ఎగతాళి చేస్తూ ఈ సామెత చెబుతారు,</para>
  <para style="q1" vid="HAB 2:6">“ ‘దొంగిలించిన వస్తువులను పోగుచేసి</para>
  <para style="q2" vid="HAB 2:6">బలత్కారంతో ధనవంతునిగా మారిన వారికి శ్రమ!</para>
  <para style="q2" vid="HAB 2:6">ఇలా ఎంతకాలం కొనసాగుతుంది?’<verse eid="HAB 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 2:7"/>అప్పు ఇచ్చినవారు నీ మీద అకస్మాత్తుగా పడరా?</para>
  <para style="q2" vid="HAB 2:7">వారు లేచి నీకు వణుకు పుట్టించరా?</para>
  <para style="q2" vid="HAB 2:7">అప్పుడు వారు నిన్ను దోచుకుంటారు.<verse eid="HAB 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 2:8"/>నీవు అనేక దేశాలను దోచుకున్నావు కాబట్టి,</para>
  <para style="q2" vid="HAB 2:8">మిగిలి ఉన్న ప్రజలంతా నిన్ను దోచుకుంటారు.</para>
  <para style="q1" vid="HAB 2:8">నీవు నరహత్యలు చేసినందుకు, భూములను పట్టణాలను</para>
  <para style="q2" vid="HAB 2:8">వాటిలోని వారందరినీ నాశనం చేసినందుకు ప్రజలు నిన్ను దోచుకుంటారు.<verse eid="HAB 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 2:9"/>“తనకు నాశనం కలుగకుండా తన నివాసాన్ని ఎత్తు చేసుకుని</para>
  <para style="q2" vid="HAB 2:9">అన్యాయమైన సంపాదనతో</para>
  <para style="q2" vid="HAB 2:9">తన ఇంటిని నిర్మించుకునే వారికి శ్రమ!<verse eid="HAB 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 2:10"/>అనేక ప్రజలను నాశనం చేయడానికి కుట్రచేసి</para>
  <para style="q2" vid="HAB 2:10">నీ ఇంటివారి మీదికి అవమానం తెచ్చుకుని నీ ప్రాణాన్ని కోల్పోతున్నావు.<verse eid="HAB 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 2:11"/>గోడ రాళ్లు మొరపెడతాయి,</para>
  <para style="q2" vid="HAB 2:11">చెక్క దూలాలు వాటిని ప్రతిధ్వనింపచేస్తాయి.<verse eid="HAB 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 2:12"/>“రక్తం చిందించి పట్టణాన్ని నిర్మించేవారికి</para>
  <para style="q2" vid="HAB 2:12">అన్యాయంతో ఊరిని స్థాపించేవారికి శ్రమ!<verse eid="HAB 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 2:13"/>ప్రజలు కష్టపడతారు కాని అగ్ని పాలవుతారని,</para>
  <para style="q2" vid="HAB 2:13">వ్యర్థమైన దాని కోసం కష్టపడి జనులు అలసిపోతారని</para>
  <para style="q2" vid="HAB 2:13">సైన్యాల యెహోవా నిర్ణయించలేదా?<verse eid="HAB 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 2:14"/>నీళ్లు సముద్రాన్ని కప్పినట్లు</para>
  <para style="q2" vid="HAB 2:14">యెహోవా మహిమాన్విత జ్ఞానంతో భూమి నిండి ఉంటుంది.<verse eid="HAB 2:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 2:15"/>“తన పొరుగువారి నగ్న శరీరాలను చూడాలని,</para>
  <para style="q2" vid="HAB 2:15">వారు మత్తులో మునిగిపోయేలా</para>
  <para style="q2" vid="HAB 2:15">కోపంతో వారికి ద్రాక్షరసం పోసేవారికి శ్రమ!<verse eid="HAB 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 2:16"/>కీర్తికి బదులుగా నీకు అవమానం కలుగుతుంది</para>
  <para style="q2" vid="HAB 2:16">కాబట్టి ఇప్పుడు నీ వంతు! నీవు కూడా త్రాగి నీ నగ్నత్వాన్ని చూపించుకుంటావు.</para>
  <para style="q1" vid="HAB 2:16">యెహోవా కుడిచేతిలోని పాత్ర నీ దగ్గరకు వస్తోంది,</para>
  <para style="q2" vid="HAB 2:16">అవమానం నీ కీర్తిని కప్పివేస్తుంది.<verse eid="HAB 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 2:17"/>లెబానోనుపై నీవు చేసిన హింస నీ మీదికే వస్తుంది,</para>
  <para style="q2" vid="HAB 2:17">పశువులను నాశనం చేసినందుకు నీ మీదికి భయంకరమైన తీర్పు వస్తుంది.</para>
  <para style="q1" vid="HAB 2:17">నీవు మనుష్యులను హత్య చేసినందుకు,</para>
  <para style="q2" vid="HAB 2:17">దేశాలను పట్టణాలను వాటి నివాసులను నాశనం చేసినందుకు ఇలా జరుగుతుంది.<verse eid="HAB 2:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 2:18"/>“శిల్పి చెక్కిన ఒక విగ్రహం వలన ప్రయోజనమేంటి?</para>
  <para style="q2" vid="HAB 2:18">అబద్ధాలు బోధించే ప్రతిమ వలన ప్రయోజనమేంటి?</para>
  <para style="q1" vid="HAB 2:18">ఒకడు మాట్లాడలేని విగ్రహాలను చేసిన</para>
  <para style="q2" vid="HAB 2:18">తాను రూపం ఇచ్చిన వాటిపైనే నమ్మకం ఉంచడం వలన ప్రయోజనమేంటి?<verse eid="HAB 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 2:19"/>చెక్కను చూసి, ‘ప్రాణం తెచ్చుకో’ అని</para>
  <para style="q2" vid="HAB 2:19">నిర్జీవమైన రాయితో, ‘మేలుకో’ అని చెప్పేవానికి శ్రమ!</para>
  <para style="q1" vid="HAB 2:19">అది దారి చూపించగలదా?</para>
  <para style="q2" vid="HAB 2:19">అది బంగారం వెండితో పూత వేయబడింది;</para>
  <para style="q2" vid="HAB 2:19">దానిలో శ్వాస లేదు.”<verse eid="HAB 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="HAB 2:20"/>కాని, యెహోవా తన పరిశుద్ధాలయంలో ఉన్నారు;</para>
  <para style="q2" vid="HAB 2:20">ఆయన ఎదుట లోకమంతా మౌనం వహించాలి.<verse eid="HAB 2:20"/></para>
  <chapter eid="HAB 2"/>
  <chapter number="3" style="c" sid="HAB 3"/>
  <para style="s1">హబక్కూకు ప్రార్థన</para>
  <para style="d">
    <verse number="1" style="v" sid="HAB 3:1"/>ప్రవక్తయైన హబక్కూకు చేసిన ప్రార్థన. షిగియోనోతు.<verse eid="HAB 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 3:2"/>యెహోవా, నీ కీర్తి గురించి విన్నాను;</para>
  <para style="q2" vid="HAB 3:2">యెహోవా, నీ క్రియలకు నేను భయపడుతున్నాను.</para>
  <para style="q1" vid="HAB 3:2">మా దినాల్లో వాటిని మళ్ళీ చేయండి,</para>
  <para style="q2" vid="HAB 3:2">మా కాలంలో వాటిని తెలియజేయండి;</para>
  <para style="q2" vid="HAB 3:2">ఉగ్రతలో కరుణించడం జ్ఞాపకముంచుకోండి.<verse eid="HAB 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 3:3"/>దేవుడు తేమాను నుండి వచ్చాడు,</para>
  <para style="q2" vid="HAB 3:3">పరిశుద్ధుడు పారాను పర్వతం నుండి వచ్చాడు. <char style="qs">సెలా</char></para>
  <para style="q1" vid="HAB 3:3">ఆయన మహా వైభవం ఆకాశాలను కప్పివేసింది</para>
  <para style="q2" vid="HAB 3:3">భూమి ఆయన స్తుతితో నిండింది.<verse eid="HAB 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 3:4"/>ఆయన తేజస్సు సూర్యకాంతిలా ఉంది;</para>
  <para style="q2" vid="HAB 3:4">ఆయన చేతిలో నుండి కిరణాలు బయలువెళ్తున్నాయి,</para>
  <para style="q2" vid="HAB 3:4">అక్కడ ఆయన శక్తి దాగి ఉంది.<verse eid="HAB 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 3:5"/>ఆయనకు ముందుగా తెగులు వెళ్లింది;</para>
  <para style="q2" vid="HAB 3:5">అంటువ్యాధి ఆయన పాదాలను అనుసరించింది.<verse eid="HAB 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 3:6"/>ఆయన నిలబడగా భూమి కంపించింది;</para>
  <para style="q2" vid="HAB 3:6">ఆయన చూడగా దేశాలు వణికాయి.</para>
  <para style="q1" vid="HAB 3:6">పురాతన పర్వతాలు కూలిపోయాయి</para>
  <para style="q2" vid="HAB 3:6">పురాతన కొండలు అణగిపోయాయి</para>
  <para style="q2" vid="HAB 3:6">కానీ ఆయన మార్గాలు శాశ్వతమైనవి.<verse eid="HAB 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 3:7"/>భయంలో ఉన్న కూషీయుల గుడారాలను,</para>
  <para style="q2" vid="HAB 3:7">వేదనలో ఉన్న మిద్యానువాసుల నివాసాలను నేను చూశాను.<verse eid="HAB 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 3:8"/>యెహోవా, నీవు నదులపై కోపంగా ఉన్నావా?</para>
  <para style="q2" vid="HAB 3:8">ప్రవాహాల మీద నీ ఉగ్రత ఉందా?</para>
  <para style="q1" vid="HAB 3:8">సముద్రంపై కోపం వచ్చిందా?</para>
  <para style="q2" vid="HAB 3:8">అందుకే నీవు నీ గుర్రాల మీద స్వారీ చేస్తూ</para>
  <para style="q2" vid="HAB 3:8">నీ విజయ రథాలను ఎక్కి వస్తున్నావా?<verse eid="HAB 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 3:9"/>వరలో నుండి నీ విల్లు తీసావు,</para>
  <para style="q2" vid="HAB 3:9">నీ వాక్కుతోడని ప్రమాణం చేసి నీ బాణాలను సిద్ధం చేశావు. <char style="qs">సెలా</char></para>
  <para style="q1" vid="HAB 3:9">నీవు భూమిని చీల్చి నదులను ప్రవహింపజేశావు;<verse eid="HAB 3:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="HAB 3:10"/>పర్వతాలు నిన్ను చూసి వణికాయి.</para>
  <para style="q1" vid="HAB 3:10">నీళ్లు ప్రవాహాలుగా ప్రవహిస్తాయి;</para>
  <para style="q2" vid="HAB 3:10">అగాధం ఘోషిస్తూ</para>
  <para style="q2" vid="HAB 3:10">తన అలలను పైకి లేపుతుంది.<verse eid="HAB 3:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 3:11"/>ఎగిరే నీ బాణాల కాంతికి</para>
  <para style="q2" vid="HAB 3:11">నీ ఈటె తళతళ మెరుపుకు</para>
  <para style="q2" vid="HAB 3:11">సూర్యచంద్రులు తమ ఆకాశంలో స్థానాల్లో నిలిచిపోతాయి.<verse eid="HAB 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 3:12"/>ఉగ్రతతో నీవు భూమిమీద తిరుగుతున్నావు</para>
  <para style="q2" vid="HAB 3:12">ఆగ్రహంతో దేశాలను అణగద్రొక్కుతున్నావు.<verse eid="HAB 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 3:13"/>నీ ప్రజలను విడిపించడానికి,</para>
  <para style="q2" vid="HAB 3:13">నీ అభిషిక్తుని రక్షించడానికి నీవు బయలుదేరుతున్నావు.</para>
  <para style="q1" vid="HAB 3:13">దుర్మార్గపు దేశపు నాయకుడిని నీవు కూలద్రోసి,</para>
  <para style="q2" vid="HAB 3:13">తల నుండి పాదం ఖండించి నిర్మూలం చేస్తున్నావు. <char style="qs">సెలా</char><verse eid="HAB 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 3:14"/>దాక్కున్న దౌర్భాగ్యులను మ్రింగివేసేందుకు</para>
  <para style="q2" vid="HAB 3:14">ఉవ్విళ్లూరుతూ, మనల్ని చెదరగొట్టడానికి</para>
  <para style="q1" vid="HAB 3:14">అతని యోధులు దూసుకుని వచ్చినప్పుడు,</para>
  <para style="q2" vid="HAB 3:14">అతని తలలో మీరు అతని ఈటెనే గుచ్చారు.<verse eid="HAB 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 3:15"/>నీవు నీ గుర్రాలతో సముద్రాన్ని త్రొక్కించావు,</para>
  <para style="q2" vid="HAB 3:15">గొప్ప జలాలను చిలుకుతున్నావు.<verse eid="HAB 3:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 3:16"/>నేను వినగా నా గుండె కొట్టుకుంది,</para>
  <para style="q2" vid="HAB 3:16">ఆ శబ్దానికి నా పెదవులు వణుకుతున్నాయి;</para>
  <para style="q1" vid="HAB 3:16">నా ఎముకలు కుళ్లిపోతున్నాయి,</para>
  <para style="q2" vid="HAB 3:16">నా కాళ్లు వణికాయి.</para>
  <para style="q1" vid="HAB 3:16">అయినా మనపై దాడి చేస్తున్న దేశం మీదికి</para>
  <para style="q2" vid="HAB 3:16">విపత్తు సంభవించే దినం వచ్చేవరకు నేను ఎదురుచూస్తూ ఉంటాను.<verse eid="HAB 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 3:17"/>అంజూరపు చెట్టు పూత పూయకపోయినా</para>
  <para style="q2" vid="HAB 3:17">ద్రాక్షచెట్టుకు పండ్లు లేకపోయినా,</para>
  <para style="q1" vid="HAB 3:17">ఒలీవచెట్లు కాపు కాయకపోయినా</para>
  <para style="q2" vid="HAB 3:17">పొలాలు పంట ఇవ్వకపోయినా,</para>
  <para style="q1" vid="HAB 3:17">దొడ్డిలో గొర్రెలు లేకపోయినా</para>
  <para style="q2" vid="HAB 3:17">శాలలో పశువులు లేకపోయినా,<verse eid="HAB 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 3:18"/>నేను యెహోవాయందు ఆనందిస్తాను,</para>
  <para style="q2" vid="HAB 3:18">నా రక్షకుడైన దేవునియందు నేను సంతోషిస్తాను.<verse eid="HAB 3:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 3:19"/>ప్రభువైన యెహోవాయే నా బలం;</para>
  <para style="q2" vid="HAB 3:19">ఆయన నా కాళ్లను లేడికాళ్లలా చేస్తాడు,</para>
  <para style="q2" vid="HAB 3:19">ఎత్తైన స్థలాల మీద ఆయన నన్ను నడిపిస్తారు.</para>
  <para style="d" vid="HAB 3:19">సంగీత దర్శకుని కోసము. తంతి వాయిద్యాలపై పాడదగినది.<verse eid="HAB 3:19"/></para>
  <chapter eid="HAB 3"/>
</usx>
