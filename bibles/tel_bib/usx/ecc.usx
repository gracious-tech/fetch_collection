<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ECC" style="id">- Biblica® Open Telugu Contemporary Version</book>
  
  <para style="h">ప్రసంగి</para>
  <para style="toc1">ప్రసంగి గ్రంథం</para>
  <para style="toc2">ప్రసంగి</para>
  <para style="toc3">ప్రసంగి</para>
  <para style="mt1">ప్రసంగి</para>
  <para style="mt2">గ్రంథం</para>
  <chapter number="1" style="c" sid="ECC 1" />
  <para style="s1">ప్రతిదీ అర్థరహితమే</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 1:1" />దావీదు కుమారుడును యెరూషలేము రాజును అయిన ప్రసంగి మాటలు:<verse eid="ECC 1:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 1:2" />ఈ ప్రసంగి ఇలా అంటున్నాడు,</para>
  <para style="q2" vid="ECC 1:2">“అర్థరహితం! అర్థరహితం!</para>
  <para style="q2" vid="ECC 1:2">అంతా అర్థరహితమే.”<verse eid="ECC 1:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ECC 1:3" />సూర్యుని క్రింద మనుష్యులు కష్టించి పని చేయడం వలన</para>
  <para style="q2" vid="ECC 1:3">వారికి కలిగే లాభం ఏమిటి?<verse eid="ECC 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 1:4" />తరాలు వస్తాయి తరాలు పోతాయి,</para>
  <para style="q2" vid="ECC 1:4">కాని ఈ భూమి ఎప్పటికీ ఉంటుంది.<verse eid="ECC 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 1:5" />సూర్యుడు ఉదయిస్తున్నాడు, అస్తమిస్తున్నాడు,</para>
  <para style="q2" vid="ECC 1:5">తాను ఉదయించే చోటుకు మరలా చేరాలని త్వరపడుతున్నాడు.<verse eid="ECC 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 1:6" />గాలి దక్షిణం వైపు వీస్తూ</para>
  <para style="q2" vid="ECC 1:6">అంతలోనే ఉత్తరానికి తిరుగుతుంది;</para>
  <para style="q1" vid="ECC 1:6">అది సుడులు సుడులుగా తిరుగుతూ,</para>
  <para style="q2" vid="ECC 1:6">తన దారిలోనే తిరిగి వస్తుంది.<verse eid="ECC 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 1:7" />నదులన్నీ సముద్రంలోనికే చేరుతాయి,</para>
  <para style="q2" vid="ECC 1:7">అయినా సముద్రం ఎప్పటికీ నిండదు.</para>
  <para style="q1" vid="ECC 1:7">నదులు ఎక్కడి నుండి ప్రవహిస్తున్నాయో</para>
  <para style="q2" vid="ECC 1:7">అక్కడికే తిరిగి వెళ్తాయి.<verse eid="ECC 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 1:8" />అన్నీ శ్రమపడి అలసిపోతున్నాయి,</para>
  <para style="q2" vid="ECC 1:8">మనుష్యులు దానిని వివరించలేరు.</para>
  <para style="q1" vid="ECC 1:8">ఎంత చూసినా కంటికి తృప్తి కలుగదు.</para>
  <para style="q2" vid="ECC 1:8">ఎంత విన్నా చెవికి సంతృప్తి కలుగదు.<verse eid="ECC 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 1:9" />ఇంతవరకు ఉన్నదే ఇకముందు కూడా ఉంటుంది,</para>
  <para style="q2" vid="ECC 1:9">ఇంతవరకు జరిగిందే ఇకముందు జరుగబోతుంది;</para>
  <para style="q2" vid="ECC 1:9">సూర్యుని క్రింద క్రొత్తది అంటూ ఏదీ లేదు.<verse eid="ECC 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 1:10" />“చూడండి! ఇది క్రొత్తది”</para>
  <para style="q2" vid="ECC 1:10">అని ఎవరైనా ఒకదాని గురించి చెప్పడానికి ఏదైనా ఉందా?</para>
  <para style="q1" vid="ECC 1:10">చాలా కాలం క్రితమే, అది ఉంది;</para>
  <para style="q2" vid="ECC 1:10">మన కాలానికి ముందే అది ఉంది.<verse eid="ECC 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 1:11" />పూర్వతరాలు ఎవరికి జ్ఞాపకముండవు,</para>
  <para style="q2" vid="ECC 1:11">రాబోయే తరాలు కూడా</para>
  <para style="q1" vid="ECC 1:11">వాళ్ళ తర్వాతి తరం వాళ్ళకు</para>
  <para style="q2" vid="ECC 1:11">అసలే జ్ఞాపకముండవు.<verse eid="ECC 1:11" /></para>
  <para style="s1">జ్ఞానం అర్థరహితం</para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 1:12" />ప్రసంగినైన నేను, యెరూషలేములో ఇశ్రాయేలుకు రాజుగా ఉన్నాను. <verse eid="ECC 1:12" /><verse number="13" style="v" sid="ECC 1:13" />ఆకాశం క్రింద జరుగుతున్నదంతా అధ్యయనం చేయడానికి జ్ఞానంతో పరిశోధించడానికి దానిపై మనస్సు పెట్టాను. దేవుడు మనుష్యులపై ఎంతో అధికమైన భారం పెట్టారు! <verse eid="ECC 1:13" /><verse number="14" style="v" sid="ECC 1:14" />సూర్యుని క్రింద జరిగే వాటన్నిటిని నేను చూశాను; అవన్నీ అర్థరహితమే, అది గాలి కోసం ప్రయాసపడడమే.<verse eid="ECC 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 1:15" />వంకరగా ఉన్నవాటిని సరి చేయలేము;</para>
  <para style="q2" vid="ECC 1:15">లేనివాటిని లెక్కపెట్టలేము.<verse eid="ECC 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 1:16" />“చూడు, యెరూషలేములో నాకన్నా ముందు పాలించిన రాజులందరికంటే నేను గొప్పజ్ఞానిని; ఎంతో జ్ఞానాన్ని తెలివిని సంపాదించాను” అని నాలో నేను అనుకున్నాను. <verse eid="ECC 1:16" /><verse number="17" style="v" sid="ECC 1:17" />ఏది జ్ఞానమో, ఏది వెర్రితనమో ఏది అవివేకమో గ్రహించాలని ప్రయత్నించాను. కాని అది కూడా, గాలి కోసం ప్రయాసపడడమే అని తెలుసుకున్నాను.<verse eid="ECC 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 1:18" />జ్ఞానం ఎక్కువవుతూ ఉంటే విచారం కూడా ఎక్కువవుతుంది;</para>
  <para style="q2" vid="ECC 1:18">ఎంత ఎక్కువ తెలివి ఉంటే అంత ఎక్కువ దుఃఖం కలుగుతుంది.<verse eid="ECC 1:18" /></para>
  <chapter eid="ECC 1" />
  <chapter number="2" style="c" sid="ECC 2" />
  <para style="s1">సంతోషాలు అర్థరహితం</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 2:1" />“ఇప్పుడు, మంచి ఏమిటో తెలుసుకోవడానికి సంతోషం చేత నిన్ను పరీక్షిస్తాను” అని నాలో నేను అనుకున్నాను. కాని ఇది కూడా అర్థరహితమేనని తెలిసింది. <verse eid="ECC 2:1" /><verse number="2" style="v" sid="ECC 2:2" />నవ్వుతో, “నీది వెర్రితనమని”, ఆనందంతో, “నీవు ఏమి సాధిస్తావు?” అని నేను అన్నాను. <verse eid="ECC 2:2" /><verse number="3" style="v" sid="ECC 2:3" />నా మనస్సు ఇంకా నన్ను జ్ఞానంతో నడిపిస్తూ ఉండగానే, ద్రాక్షరసంతో నన్ను నేను తృప్తిపరుచుకోవాలని, బుద్ధిహీనత వలన ఉపయోగం తెలుసుకోవాలని అనుకున్నాను. ఆకాశం క్రింద తాము జీవించే కొన్ని రోజుల్లో మనుష్యులు ఏమి చేస్తే మంచిదో చూడాలనుకున్నాను.<verse eid="ECC 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 2:4" />నేను గొప్ప పనులు మొదలుపెట్టాను: నా కోసం భవనాలు కట్టించుకున్నాను ద్రాక్షతోటలు నాటించాను. <verse eid="ECC 2:4" /><verse number="5" style="v" sid="ECC 2:5" />తోటలు, ఉద్యానవనాలు వేయించి వాటిలో అన్ని రకాల పండ్లచెట్లు నాటించాను. <verse eid="ECC 2:5" /><verse number="6" style="v" sid="ECC 2:6" />పెరుగుతున్న చెట్లకు నీరు అందించడానికి నేను చెరువులను త్రవ్వించాను. <verse eid="ECC 2:6" /><verse number="7" style="v" sid="ECC 2:7" />దాసదాసీలను నేను వెల చెల్లించి కొన్నాను, నా ఇంట్లోనే పుట్టిపెరిగిన దాసులు కూడా నాకున్నారు. యెరూషలేములో నాకన్నా ముందు నుండి ఉన్న వారందరికంటే ఎక్కువ పశుసంపద గొర్రెల మందలు నాకున్నాయి. <verse eid="ECC 2:7" /><verse number="8" style="v" sid="ECC 2:8" />నా కోసం వెండి బంగారం సమకూర్చుకున్నాను. విదేశాల నుండి రాజ సంపదను సేకరించాను. గాయనీ గాయకులను, మనుష్యుల హృదయాన్ని సంతోషపరిచే వాటిని సంపాదించాను; స్త్రీలు కూడా నా దగ్గర ఉన్నారు. <verse eid="ECC 2:8" /><verse number="9" style="v" sid="ECC 2:9" />నాకన్నా ముందు యెరూషలేములోని వారందరికంటే నేనెంతో గొప్పవాడినై ఎంతో వృద్ధి చెందాను. వీటన్నిటిలో నా జ్ఞానం నాతోనే ఉంది.<verse eid="ECC 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 2:10" />నా కళ్లు కోరినవాటిలో దేన్ని చూడకుండ నేను నిరాకరించలేదు;</para>
  <para style="q2" vid="ECC 2:10">సంతోషాలను అనుభవించకుండా నా హృదయాన్ని ఆటంకపరచలేదు.</para>
  <para style="q1" vid="ECC 2:10">నా పనులన్నిటిని బట్టి నా హృదయం సంతోషించింది.</para>
  <para style="q2" vid="ECC 2:10">నా శ్రమంతటికి కలిగిన ఫలితం ఇదే.<verse eid="ECC 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 2:11" />అయితే, నా చేతులు చేసిన పనులన్నిటిని</para>
  <para style="q2" vid="ECC 2:11">వాటికోసం నేను పడిన శ్రమనంతటి పరిశీలిస్తే,</para>
  <para style="q1" vid="ECC 2:11">అవన్నీ అర్థరహితమే అని, గాలికి ప్రయాసపడినట్లే అని తెలుసుకున్నాను.</para>
  <para style="q2" vid="ECC 2:11">సూర్యుని క్రింద లాభకరమైనదేదీ లేదని నేను గ్రహించాను.<verse eid="ECC 2:11" /></para>
  <para style="s1">జ్ఞానం బుద్ధిహీనత రెండూ అర్థరహితమే</para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 2:12" />నేను జ్ఞానం, పిచ్చితనం, బుద్ధిహీనతల గురించి</para>
  <para style="q2" vid="ECC 2:12">ఆలోచించాలని నిర్ణయించుకున్నాను.</para>
  <para style="q1" vid="ECC 2:12">రాజు ఇంతకుముందే చేసిన దానికంటే,</para>
  <para style="q2" vid="ECC 2:12">రాజు తర్వాత వచ్చేవాడు అధికంగా ఇంకేమి చేయగలడు? అనుకున్నాను.<verse eid="ECC 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 2:13" />చీకటి కంటే వెలుగు మేలు అని,</para>
  <para style="q2" vid="ECC 2:13">బుద్ధిహీనత కంటే జ్ఞానం మేలు అని నేను చూశాను.<verse eid="ECC 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 2:14" />జ్ఞానికి తలలో కళ్లు ఉంటాయి.</para>
  <para style="q2" vid="ECC 2:14">మూర్ఖుడు చీకటిలో నడుస్తాడు.</para>
  <para style="q1" vid="ECC 2:14">అయినా అందరి విధి ఒకటే</para>
  <para style="q2" vid="ECC 2:14">అని నేను గ్రహించాను.<verse eid="ECC 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 2:15" />నాలో నేను అనుకున్నాను</para>
  <para style="q1" vid="ECC 2:15">మూర్ఖుడికి సంభవించేదే నాకూ సంభవిస్తుంది.</para>
  <para style="q2" vid="ECC 2:15">నేను ఇంత జ్ఞానం సంపాదించి నాకేం లాభం?</para>
  <para style="q1" vid="ECC 2:15">“ఇది కూడా అర్థరహితం” అని</para>
  <para style="q2" vid="ECC 2:15">నాలో నేననుకున్నాను.<verse eid="ECC 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 2:16" />ఎందుకంటే మూర్ఖుల్లాగే జ్ఞానులు కూడా ఎక్కువకాలం జ్ఞాపకం ఉండరు;</para>
  <para style="q2" vid="ECC 2:16">ఇరువురిని మరచిపోయే రోజులు ఇప్పటికే వచ్చాయి.</para>
  <para style="q1" vid="ECC 2:16">మూర్ఖుల్లాగే జ్ఞానులు కూడ చస్తారు.<verse eid="ECC 2:16" /></para>
  <para style="s1">శ్రమ అర్థరహితం</para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 2:17" />ఇదంతా చూస్తూ ఉంటే సూర్యుని క్రింద జరుగుతున్న దాన్ని బట్టి నాకెంతో విచారం కలిగింది, కాబట్టి నేను నా జీవితాన్ని అసహ్యించుకున్నాను. అంతా అర్థరహితమే గాలికి ప్రయాసపడడమే. <verse eid="ECC 2:17" /><verse number="18" style="v" sid="ECC 2:18" />సూర్యుని క్రింద నేను కష్టపడి సాధించినవన్నీ నా తర్వాత వచ్చే వారికి చెందుతాయని తెలుసుకొని నేను వాటన్నిటిని అసహ్యించుకున్నాను. <verse eid="ECC 2:18" /><verse number="19" style="v" sid="ECC 2:19" />నా తర్వాత వచ్చేవాడు ఎలాంటివాడో ఎవరికి తెలుసు? అతడు జ్ఞాని కావచ్చు, మూర్ఖుడు కావచ్చు. ఎలాంటి వాడైనా సూర్యుని క్రింద నా శ్రమతో నైపుణ్యతతో సంపాదించినదంతా అతని స్వాధీనమౌతుంది. ఇది కూడా అర్థరహితమే. <verse eid="ECC 2:19" /><verse number="20" style="v" sid="ECC 2:20" />కాబట్టి సూర్యుని క్రింద నేను పడిన కష్టమంతటి గురించి నేను నిరాశ చెందాను. <verse eid="ECC 2:20" /><verse number="21" style="v" sid="ECC 2:21" />ఒకరు జ్ఞానంతో తెలివితో నైపుణ్యంతో శ్రమించి పని చేస్తారు, కాని తర్వాత వారు దానిని శ్రమించని మరొకరికి వదిలేయాల్సి వస్తుంది. ఇది కూడా అర్థరహితమే, గొప్ప దురదృష్టకరమే. <verse eid="ECC 2:21" /><verse number="22" style="v" sid="ECC 2:22" />సూర్యుని క్రింద మనుష్యులు కష్టపడి చేస్తున్న పనులకు వారి శ్రమకు పొందుతున్నది ఏంటి? <verse eid="ECC 2:22" /><verse number="23" style="v" sid="ECC 2:23" />వారి రోజులన్నిటిలో వారు చేసే పనులన్నీ దుఃఖంతో బాధతో నిండి ఉన్నాయి; రాత్రి కూడా వారి మనస్సులు విశ్రాంతి తీసుకోవు. ఇది కూడా అర్థరహితమే.<verse eid="ECC 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ECC 2:24" />మనుష్యులు అన్నపానాలు పుచ్చుకుని తమ కష్టార్జితంతో మేలుపొందడం కంటే క్షేమం ఇంకేముంది? అయినా ఇది కూడా దేవుని వలనే కలుగుతుందని నేను తెలుసుకున్నాను. <verse eid="ECC 2:24" /><verse number="25" style="v" sid="ECC 2:25" />ఆయన అనుమతి లేకుండా, ఎవరు తినగలరు ఆనందాన్ని పొందగలరు? <verse eid="ECC 2:25" /><verse number="26" style="v" sid="ECC 2:26" />తనను సంతోషపెట్టే వారికి దేవుడు జ్ఞానం, తెలివి, సంతోషాన్ని ఇస్తారు, కాని దేవున్ని సంతోషపెట్టే వారికి కోసం సంపదను పోగుచేసే పని ఆయన పాపికి ఇస్తారు. ఇది కూడా అర్థరహితమే, గాలికి ప్రయాసపడడమే.<verse eid="ECC 2:26" /></para>
  <chapter eid="ECC 2" />
  <chapter number="3" style="c" sid="ECC 3" />
  <para style="s1">ప్రతి దానికి సమయముంది</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 3:1" />ప్రతిదానికీ ఒక సమయం ఉంది,</para>
  <para style="q2" vid="ECC 3:1">ఆకాశాల క్రింద ప్రతీ కార్యకలాపానికి ఒక కాలం ఉంది:<verse eid="ECC 3:1" /></para>
  <para style="b" />
  <para style="q2">
    <verse number="2" style="v" sid="ECC 3:2" />పుట్టడానికి సమయం చావడానికి సమయం,</para>
  <para style="q2" vid="ECC 3:2">నాటడానికి సమయం, పెరికివేయడానికి సమయం,<verse eid="ECC 3:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="ECC 3:3" />చంపడానికి సమయం, స్వస్థపరచడానికి సమయం,</para>
  <para style="q2" vid="ECC 3:3">పడగొట్టడానికి, కట్టడానికి.<verse eid="ECC 3:3" /></para>
  <para style="q2">
    <verse number="4" style="v" sid="ECC 3:4" />ఏడ్వడానికి, నవ్వడానికి</para>
  <para style="q2" vid="ECC 3:4">దుఃఖపడడానికి, నాట్యమాడడానికి,<verse eid="ECC 3:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="ECC 3:5" />రాళ్లు పారవేయడానికి, కుప్పవేయడానికి,</para>
  <para style="q2" vid="ECC 3:5">కౌగిలించుకోడానికి, కౌగిలించడం మానడానికి.<verse eid="ECC 3:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="ECC 3:6" />వెదకడానికి సమయం, పోగొట్టుకోడానికి సమయం,</para>
  <para style="q2" vid="ECC 3:6">దాచిపెట్టడానికి, పారవేయడానికి,<verse eid="ECC 3:6" /></para>
  <para style="q2">
    <verse number="7" style="v" sid="ECC 3:7" />చింపివేయడానికి, కుట్టడానికి,</para>
  <para style="q2" vid="ECC 3:7">మౌనంగా ఉండడానికి, మాట్లాడడానికి,<verse eid="ECC 3:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="ECC 3:8" />ప్రేమించడానికి, ద్వేషించడానికి,</para>
  <para style="q2" vid="ECC 3:8">యుద్ధం చేయడానికి, సమాధానపడడానికి సమయం ఉంటుంది.<verse eid="ECC 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 3:9" />కష్టపడేవారికి తమ కష్టానికి పొందే లాభమేంటి? <verse eid="ECC 3:9" /><verse number="10" style="v" sid="ECC 3:10" />మనుష్యజాతి మీద దేవుడు మోపిన భారం నేను చూశాను. <verse eid="ECC 3:10" /><verse number="11" style="v" sid="ECC 3:11" />ఆయన ప్రతిదాన్ని దాని సమయానికి తగినట్లుగా ఉండేలా చేశారు. ఆయన మానవ హృదయంలో నిత్యమైన జ్ఞానాన్ని ఉంచారు; దేవుడు చేసిన వాటిని మొదటి నుండి చివరి వరకు పూర్తిగా ఎవరూ గ్రహించలేరు. <verse eid="ECC 3:11" /><verse number="12" style="v" sid="ECC 3:12" />మనుష్యులు జీవించినంత కాలం సంతోషంగా ఉంటూ, మంచి చేయడం కంటే ఉత్తమమైనది ఏదీ లేదని నేను తెలుసుకున్నాను. <verse eid="ECC 3:12" /><verse number="13" style="v" sid="ECC 3:13" />ప్రతి ఒక్కరు తిని త్రాగుతూ తన కష్టార్జితాన్ని ఆస్వాదించడమే దేవుని వరమని నేను తెలుసుకున్నాను. <verse eid="ECC 3:13" /><verse number="14" style="v" sid="ECC 3:14" />దేవుడు చేసే ప్రతిదీ శాశ్వతంగా ఉంటుందని నాకు తెలుసు; దానికి ఏమీ జోడించలేము దాని నుండి ఏమీ తీసివేయలేము. ప్రజలు ఆయనకు భయపడేలా దేవుడు అలా నియమించారు.<verse eid="ECC 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 3:15" />ఇప్పుడు జరుగుతున్నది ఇంతకుముందు జరిగిందే.</para>
  <para style="q2" vid="ECC 3:15">ఇకముందు జరగబోయేది, పూర్వం జరిగి ఉన్నదే.</para>
  <para style="q2" vid="ECC 3:15">మునుపున్నదాన్నే మళ్ళీ దేవుడు రప్పిస్తారు, జరిగిస్తారు.<verse eid="ECC 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 3:16" />సూర్యుని క్రింద ఈ భూమి మీద మరో విషయం నేను చూశాను.</para>
  <para style="q1" vid="ECC 3:16">న్యాయస్థానంలో దుర్మార్గం జరుగుతూ ఉంది.</para>
  <para style="q2" vid="ECC 3:16">న్యాయానికి బదులు దుర్మార్గమే ప్రబలుతోంది.<verse eid="ECC 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 3:17" />నేనిలా అనుకున్నాను,</para>
  <para style="q1" vid="ECC 3:17">“నీతిమంతులకు దుర్మార్గులకు</para>
  <para style="q2" vid="ECC 3:17">దేవుడు తీర్పు తీరుస్తారు,</para>
  <para style="q1" vid="ECC 3:17">ఎందుకంటే ప్రతి ప్రయత్నానికి సమయం ఉంది</para>
  <para style="q2" vid="ECC 3:17">ప్రతి పనికి తీర్పు తీర్చడానికి సమయం ఉంది.”<verse eid="ECC 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 3:18" />నేను ఇంకా ఇలా అనుకున్నాను, “మనుష్యుల తాము జంతువుల్లాంటివారని గ్రహించేలా దేవుడు వారిని పరీక్షిస్తారు. <verse eid="ECC 3:18" /><verse number="19" style="v" sid="ECC 3:19" />ఖచ్చితంగా జంతువులకు జరిగినట్లే మనుష్యులకు జరుగుతుంది. వారిద్దరి విధి ఒక్కటే; జంతువులు చనిపోతాయి మనుష్యులు చనిపోతారు. అంతా అర్థరహితమే. <verse eid="ECC 3:19" /><verse number="20" style="v" sid="ECC 3:20" />అంతా వెళ్లేది ఒక చోటికే; సమస్తం మట్టిలో నుండి వచ్చింది, తిరిగి మట్టిలోనే కలిసిపోతుంది. <verse eid="ECC 3:20" /><verse number="21" style="v" sid="ECC 3:21" />ఒకవేళ మానవ ఆత్మ పైకి లేస్తుందో లేదో, జంతువుల ప్రాణం భూమిలోకి దిగిపోతుందో లేదో ఎవరికి తెలుసు?”<verse eid="ECC 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ECC 3:22" />కాబట్టి మనుష్యులు తమ పనిని ఆస్వాదించడం కంటే మెరుగైనది ఏదీ లేదని నేను గ్రహించాను, ఎందుకంటే అదే వారు చేయవలసింది. వారి తర్వాత ఏమి జరుగుతుందో చూడటానికి వారిని ఎవరు వెనక్కి తీసుకురాగలరు?<verse eid="ECC 3:22" /></para>
  <chapter eid="ECC 3" />
  <chapter number="4" style="c" sid="ECC 4" />
  <para style="s1">అణచివేత, శ్రమ, స్నేహరాహిత్యం</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 4:1" />సూర్యుని క్రింద జరుగుతున్న అణచివేతనంతటిని నేను చూశాను:</para>
  <para style="q1" vid="ECC 4:1">సూర్యుని క్రింద అణగారిన వారి కన్నీటిని నేను చూశాను,</para>
  <para style="q2" vid="ECC 4:1">కాబట్టి వారిని ఆదరించేవారెవరూ లేరు;</para>
  <para style="q1" vid="ECC 4:1">బాధపెట్టేవారు బలవంతులు,</para>
  <para style="q2" vid="ECC 4:1">వారిని ఆదరించేవారెవరూ లేరు.<verse eid="ECC 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 4:2" />ఇంకా జీవించి ఉన్నవారి కంటే</para>
  <para style="q2" vid="ECC 4:2">మునుపే చనిపోయినవారు,</para>
  <para style="q1" vid="ECC 4:2">సంతోషంగా ఉన్నారని</para>
  <para style="q2" vid="ECC 4:2">నేను అనుకున్నాను.<verse eid="ECC 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 4:3" />ఇంకా పుట్టనివారు,</para>
  <para style="q2" vid="ECC 4:3">సూర్యుని క్రింద జరిగే</para>
  <para style="q1" vid="ECC 4:3">చెడును చూడనివారు,</para>
  <para style="q2" vid="ECC 4:3">ఈ ఇరువురి కన్నా ధన్యులు.<verse eid="ECC 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 4:4" />కష్టమంతటితో సాధించినవన్నీ ఒకరిపట్ల ఒకరికి అసూయ కలిగిస్తున్నాయని నేను చూశాను. ఇది కూడా అర్థరహితమే, గాలికి శ్రమ పడినట్లే.<verse eid="ECC 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 4:5" />మూర్ఖులు చేతులు ముడుచుకుని</para>
  <para style="q2" vid="ECC 4:5">తమను తాము పతనం చేసుకుంటారు.<note caller="+" style="f"><char style="fr" closed="false">4:5 </char><char style="ft" closed="false">హెబ్రీలో </char><char style="fqa" closed="false">తమ మాంసాన్నే తింటారు</char></note><verse eid="ECC 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 4:6" />రెండు చేతులతో గాలి కోసం శ్రమించడం కంటే</para>
  <para style="q2" vid="ECC 4:6">ఒక చేతినిండ నెమ్మది ఉంటే</para>
  <para style="q2" vid="ECC 4:6">అది ఎంతో మేలు.<verse eid="ECC 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 4:7" />నేను సూర్యుని క్రింద మళ్ళీ అర్థరహితమైన దానిని చూశాను:<verse eid="ECC 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 4:8" />ఒక ఒంటరివాడు ఉండేవాడు;</para>
  <para style="q2" vid="ECC 4:8">అతనికి కుమారుడు కాని సోదరుడు కాని లేరు.</para>
  <para style="q1" vid="ECC 4:8">కాని అతడు నిత్యం కష్టపడుతూనే ఉన్నాడు,</para>
  <para style="q2" vid="ECC 4:8">అయినప్పటికీ అతని సంపద అతని కళ్లను తృప్తిపరచలేకపోయింది.</para>
  <para style="q1" vid="ECC 4:8">“నేను ఎవరి కోసం కష్టపడుతున్నాను?</para>
  <para style="q2" vid="ECC 4:8">నేను ఎందుకు ఆనందంగా లేను?” అని ప్రశ్నించుకున్నాడు,</para>
  <para style="q1" vid="ECC 4:8">ఇది కూడా అర్థరహితమే</para>
  <para style="q2" vid="ECC 4:8">విచారకరమైన క్రియ!<verse eid="ECC 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ECC 4:9" />ఒకరికంటే ఇద్దరు మేలు,</para>
  <para style="q2" vid="ECC 4:9">ఎందుకంటే ఇద్దరూ కష్టపడితే మంచి రాబడి ఉంటుంది:<verse eid="ECC 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 4:10" />ఒకవేళ ఇద్దరిలో ఒకరు పడితే</para>
  <para style="q2" vid="ECC 4:10">రెండవవాడు ఇతడిని లేవనెత్తగలడు.</para>
  <para style="q1" vid="ECC 4:10">ఒంటరివాడు పడితే</para>
  <para style="q2" vid="ECC 4:10">లేవనెత్తేవాడెవడూ ఉండడు.<verse eid="ECC 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 4:11" />అలాగే, ఇద్దరు కలిసి పడుకుంటే, వారు వెచ్చగా ఉంటారు.</para>
  <para style="q2" vid="ECC 4:11">అయితే ఒంటరివారు ఎలా వెచ్చగా ఉండగలరు?<verse eid="ECC 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 4:12" />ఒంటరి వారిని పడద్రోయడం తేలిక,</para>
  <para style="q2" vid="ECC 4:12">ఇద్దరు కలిసి తమను తాము రక్షించుకోగలరు.</para>
  <para style="q1" vid="ECC 4:12">మూడు పేటల త్రాడు త్వరగా తెగిపోదు.<verse eid="ECC 4:12" /></para>
  <para style="s1">అభివృద్ధి అర్థరహితమే</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 4:13" />మూర్ఖుడై హెచ్చరికలు వినడానికి ఇష్టపడని ముసలి రాజుకంటే బీదవాడైన జ్ఞానంగల యువకుడే నయము. <verse eid="ECC 4:13" /><verse number="14" style="v" sid="ECC 4:14" />అలాంటి యువకుడు చెరసాలలో నుండి బయటపడి పట్టాభిషేకం పొందవచ్చు. తన దేశంలో దరిద్రుడిగా పుట్టినా రాజు కాగలడు. <verse eid="ECC 4:14" /><verse number="15" style="v" sid="ECC 4:15" />సూర్యుని క్రింద జీవిస్తూ తిరిగే వారందరూ రాజు బదులు రాజైన ఆ యువకుని అనుసరిస్తారని నేను తెలుసుకున్నాను. <verse eid="ECC 4:15" /><verse number="16" style="v" sid="ECC 4:16" />అతని అధికారం క్రింద ఉన్న ప్రజలు అసంఖ్యాకులు. కానీ తర్వాత వచ్చినవారు అతని పట్ల సంతోషించరు. ఇది కూడా అర్థరహితమే, గాలికి ప్రయాసపడడమే.<verse eid="ECC 4:16" /></para>
  <chapter eid="ECC 4" />
  <chapter number="5" style="c" sid="ECC 5" />
  <para style="s1">దేవునికి నీ మ్రొక్కుబడిని చెల్లించు</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 5:1" />నీవు దేవుని ఆలయానికి వెళ్లినప్పుడు నీ ప్రవర్తన జాగ్రత్తగా చూసుకో. తాము దుర్మార్గపు పనులు చేస్తున్నామని తెలుసుకోకుండా మూర్ఖుల్లా బలి అర్పించడం కన్నా దగ్గరకు వెళ్లి వినడం మంచిది.<verse eid="ECC 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 5:2" />దేవుని ముందు అనాలోచితంగా మాట్లాడటానికి,</para>
  <para style="q2" vid="ECC 5:2">నీ హృదయం తొందరపడకుండ</para>
  <para style="q2" vid="ECC 5:2">నీ నోటిని కాచుకో.</para>
  <para style="q1" vid="ECC 5:2">దేవుడు ఆకాశంలో ఉన్నారు</para>
  <para style="q2" vid="ECC 5:2">నీవు భూమిపై ఉన్నావు,</para>
  <para style="q2" vid="ECC 5:2">కాబట్టి నీ మాటలు తక్కువగా ఉండాలి.<verse eid="ECC 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 5:3" />విస్తారమైన పనుల వల్ల కలలు వస్తాయి.</para>
  <para style="q2" vid="ECC 5:3">ఎక్కువ మాటలు మాట్లాడేవారు మూర్ఖునిలా మాట్లాడతారు.<verse eid="ECC 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 5:4" />నీ దేవునికి చేసుకున్న మ్రొక్కుబడిని చెల్లించడంలో ఆలస్యం చేయవద్దు. మూర్ఖుల గురించి దేవుడు సంతోషించరు, నీ మ్రొక్కుబడిని చెల్లించు. <verse eid="ECC 5:4" /><verse number="5" style="v" sid="ECC 5:5" />మ్రొక్కుబడి చేసి చెల్లించక పోవడం కంటే మ్రొక్కుబడి చేయకపోవడమే మంచిది. <verse eid="ECC 5:5" /><verse number="6" style="v" sid="ECC 5:6" />నీ మాటలు నిన్ను పాపంలోకి పడవేయకుండా చూసుకో. ఆలయ దూతకు, “పొరపాటున మొక్కుబడి చేశాను” అని చెప్పవద్దు. నీ మాటలకు దేవుడు కోప్పడి నీ చేతిపనిని నాశనం చేయడం అవసరమా? <verse eid="ECC 5:6" /><verse number="7" style="v" sid="ECC 5:7" />ఎక్కువ కలలు ఎక్కువ మాటలు అర్థరహితమే. కాబట్టి దేవునికి భయపడు.<verse eid="ECC 5:7" /></para>
  <para style="s1">ధనం అర్థరహితం</para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 5:8" />ఒక ప్రాంతంలో పేదలను అణచివేయడం, న్యాయాన్ని హక్కులను పాటించకపోవడం లాంటివి నీవు చూస్తే ఆశ్చర్యపడవద్దు; ఎందుకంటే ఒక అధికారి మీద పైఅధికారులు ఉంటారు, వారందరిపైన ఉన్నతాధికారులు ఉంటారు. <verse eid="ECC 5:8" /><verse number="9" style="v" sid="ECC 5:9" />దేశం అభివృద్ధి చెందినప్పుడు అందరు పంచుకుంటారు; స్వయాన రాజు పొలాల నుండి లబ్ది పొందుతారు.<verse eid="ECC 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 5:10" />డబ్బును ప్రేమించేవారు ఆ డబ్బుతో తృప్తి పడరు;</para>
  <para style="q2" vid="ECC 5:10">సంపదను ప్రేమించేవారు తమ ఆదాయంతో ఎప్పుడూ సంతృప్తి చెందరు.</para>
  <para style="q2" vid="ECC 5:10">ఇది కూడా అర్థరహితము.<verse eid="ECC 5:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ECC 5:11" />ఆస్తి ఎక్కువవుతూ ఉంటే,</para>
  <para style="q2" vid="ECC 5:11">దాన్ని దోచుకునేవారు కూడా ఎక్కువవుతారు.</para>
  <para style="q1" vid="ECC 5:11">యజమానులకు తమ ఆస్తిని కళ్లతో చూడడం తప్ప,</para>
  <para style="q2" vid="ECC 5:11">దానివల్ల వారికేమి ప్రయోజనం?<verse eid="ECC 5:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ECC 5:12" />శ్రమజీవులు కొంచెం తిన్నా ఎక్కువ తిన్నా,</para>
  <para style="q2" vid="ECC 5:12">సుఖంగా నిద్రపోతారు,</para>
  <para style="q1" vid="ECC 5:12">కానీ ధనికులకున్న సమృద్ధి</para>
  <para style="q2" vid="ECC 5:12">వారికి నిద్రపట్ట నివ్వదు.<verse eid="ECC 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 5:13" />సూర్యుని క్రింద బాధాకరమైన ఒక చెడ్డ విషయాన్ని నేను చూశాను:</para>
  <para style="q1" vid="ECC 5:13">దాచి ఉంచిన సంపద యజమానునికి హాని తెస్తుంది,<verse eid="ECC 5:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="ECC 5:14" />లేదా దురదృష్టవశాత్తూ వారి సంపద పోతుంది,</para>
  <para style="q1" vid="ECC 5:14">వారికి పిల్లలు కలిగినప్పుడు</para>
  <para style="q2" vid="ECC 5:14">వారికి వారసత్వంగా ఏమీ మిగలదు.<verse eid="ECC 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 5:15" />ప్రతి ఒక్కరు తల్లి గర్భం నుండి దిగంబరిగా వచ్చినట్లే</para>
  <para style="q2" vid="ECC 5:15">దిగంబరిగానే వెళ్లిపోతారు.</para>
  <para style="q1" vid="ECC 5:15">తాము కష్టపడిన దానిలో నుండి వారు</para>
  <para style="q2" vid="ECC 5:15">తమ చేతుల్లో ఏమి మోసుకు వెళ్లరు.<verse eid="ECC 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 5:16" />మరొక చెడ్డ విషయం:</para>
  <para style="q1" vid="ECC 5:16">ప్రతి ఒక్కరూ ఎలా వస్తారో, వారు అలాగే వెళ్లిపోతారు,</para>
  <para style="q2" vid="ECC 5:16">వారు గాలికి ప్రయాసపడుతున్నారు</para>
  <para style="q2" vid="ECC 5:16">కాబట్టి వారు ఏమి పొందుతారు?<verse eid="ECC 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 5:17" />వారు చాలా నిరాశతో, బాధలతో, కోపంతో,</para>
  <para style="q2" vid="ECC 5:17">తమ దినాలన్ని చీకటిలో భోజనం చేస్తారు.<verse eid="ECC 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 5:18" />నేను గమనించిన వాటిలో మంచిది ఏదనగా: దేవుడు తనకిచ్చిన రోజులన్నిటిలో ఒక వ్యక్తి తిని, త్రాగుతూ సూర్యుని క్రింద తాను చేసిన శ్రమతో సంతృప్తి చెందాలి. ఎందుకంటే ఇదే వారు చేయవలసింది. <verse eid="ECC 5:18" /><verse number="19" style="v" sid="ECC 5:19" />అంతేకాక, దేవుడు ఒక వ్యక్తికి సంపదను ఆస్తులను వాటిని అనుభవించగల సామర్థ్యాన్ని ఇచ్చినప్పుడు, వారు తమ భాగాన్ని తీసుకుని వారి కష్టార్జితంలో వారు ఆనందంగా ఉండాలి; ఇది దేవుని వరము. <verse eid="ECC 5:19" /><verse number="20" style="v" sid="ECC 5:20" />దేవుడతనికి హృదయంలో ఆనందం కలిగిస్తారు కాబట్టి అతడు తన గతాన్ని సులభంగా మరిచిపోగలుగుతాడు. వారు వారి జీవితపు రోజులను చాలా అరుదుగా ప్రతిబింబిస్తారు.<verse eid="ECC 5:20" /></para>
  <chapter eid="ECC 5" />
  <chapter number="6" style="c" sid="ECC 6" />
  <para style="p">
    <verse number="1" style="v" sid="ECC 6:1" />నేను సూర్యుని క్రింద మరొక చెడు చూశాను, అది మనుష్యజాతి మీద ఎంతో భారంగా ఉంది. <verse eid="ECC 6:1" /><verse number="2" style="v" sid="ECC 6:2" />దేవుడు కొందరికి ధనం, ఆస్తి, గౌరవం ఇస్తారు, తద్వార వారి హృదయాలు కోరుకున్నవేవి వారికి కొదువగా ఉండవు. కాని వాటిని అనుభవించే సామర్థ్యాన్ని వారికి దేవుడు ఇవ్వరు, అపరిచితులు వాటిని అనుభవిస్తారు. ఇదంతా అర్థరహితమే, చెడ్డ విషయమే.<verse eid="ECC 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 6:3" />ఒకడు వందమంది పిల్లలను కని అనేక సంవత్సరాలు జీవించినప్పటికీ, అతడు బ్రతికినంత కాలం తన అభివృద్ధిని అనుభవించకపోతే, సరియైన రీతిలో సమాధి చేయబడకపోతే, అతనికంటే గర్భస్రావమైపోయిన పిండమే నయము. <verse eid="ECC 6:3" /><verse number="4" style="v" sid="ECC 6:4" />గర్భస్రావమైన పిండం నిరుపయోగంగా వచ్చి చీకటిలోకి వెళ్లిపోతుంది, చీకటిలో దాని పేరు కప్పబడుతుంది. <verse eid="ECC 6:4" /><verse number="5" style="v" sid="ECC 6:5" />అది ఎన్నడు సూర్యుని చూడకపోయినా దానికి ఏమి తెలియకపోయినా, ఆ మనిషి కన్నా దానికే ఎక్కువ విశ్రాంతి ఉంది. <verse eid="ECC 6:5" /><verse number="6" style="v" sid="ECC 6:6" />అతడు రెండువేల సంవత్సరాలు బ్రతికినా తన అభివృద్ధిని అనుభవించలేడు. అందరు వెళ్లేది ఒకే చోటికే కదా?<verse eid="ECC 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 6:7" />మనుష్యులు పడే శ్రమ అంతా కడుపు కోసమే,</para>
  <para style="q2" vid="ECC 6:7">అయినా వారి ఆశకు తృప్తి కలగదు.<verse eid="ECC 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 6:8" />మూర్ఖుల కంటే జ్ఞానులకున్న ప్రయోజనం ఏముంది?</para>
  <para style="q1" vid="ECC 6:8">ఇతరుల ఎదుట ఎలా జీవించాలో</para>
  <para style="q2" vid="ECC 6:8">తెలుసుకున్న బీదవారికి లాభం ఏంటి?<verse eid="ECC 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 6:9" />కోరిక వెంట పడడం కంటే</para>
  <para style="q2" vid="ECC 6:9">కళ్లకు కనిపించేది మేలు.</para>
  <para style="q1" vid="ECC 6:9">అయినా ఇది కూడా అర్థరహితమే.</para>
  <para style="q2" vid="ECC 6:9">గాలికి ప్రయాసపడడమే.<verse eid="ECC 6:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ECC 6:10" />ఉనికిలో ఉన్నవన్నీ ఇంతకు ముందు తెలిసినవే.</para>
  <para style="q2" vid="ECC 6:10">మనుష్యులు ఎలా ఉంటారో పూర్వం నుండి తెలిసిందే;</para>
  <para style="q2" vid="ECC 6:10">తనకంటే బలవంతుడితో ఎవరు పోరాడలేరు.<verse eid="ECC 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 6:11" />మాటలు ఎక్కువ</para>
  <para style="q2" vid="ECC 6:11">అర్థం తక్కువ,</para>
  <para style="q2" vid="ECC 6:11">దానివల్ల ఎవరికి ప్రయోజనం?<verse eid="ECC 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 6:12" />నీడలా తమ జీవితకాలాన్ని అర్థరహితంగా గడిపే మనుష్యుల బ్రతుకులో వారికి ఏది క్షేమమో ఎవరికి తెలుసు? వారు గతించాక సూర్యుని క్రింద భూమి మీద ఏం జరుగుతుందో వారికి ఎవరు చెప్తారు?<verse eid="ECC 6:12" /></para>
  <chapter eid="ECC 6" />
  <chapter number="7" style="c" sid="ECC 7" />
  <para style="s1">జ్ఞానం</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 7:1" />చక్కని పరిమళం కంటే మంచి పేరు మంచిది,</para>
  <para style="q2" vid="ECC 7:1">జన్మదినం కంటే మరణ దినం మంచిది.<verse eid="ECC 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 7:2" />విందు జరిగే వారి ఇళ్ళకు వెళ్లే కంటే</para>
  <para style="q2" vid="ECC 7:2">ఏడ్చేవారి ఇళ్ళకు వెళ్లడం మంచిది.</para>
  <para style="q1" vid="ECC 7:2">ఎందుకంటే మరణం ప్రతి ఒక్కరికీ వస్తుంది;</para>
  <para style="q2" vid="ECC 7:2">జీవించి ఉన్నవారు దీనిని హృదయపూర్వకంగా స్వీకరించాలి.<verse eid="ECC 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 7:3" />నవ్వడం కంటే దుఃఖపడడం మేలు,</para>
  <para style="q2" vid="ECC 7:3">ఎందుకంటే విచారంగా ఉన్న ముఖం గుండెకు మంచిది.<verse eid="ECC 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 7:4" />జ్ఞానుల హృదయం దుఃఖపడే వారి గృహంలో ఉంటుంది</para>
  <para style="q2" vid="ECC 7:4">కాని బుద్ధిహీనుల మనస్సు సంతోషించే వారి ఇంట్లో ఉంటుంది.<verse eid="ECC 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 7:5" />మూర్ఖుల పాటలు వినడంకంటే,</para>
  <para style="q2" vid="ECC 7:5">జ్ఞానుల గద్దింపు వినడం మేలు.<verse eid="ECC 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 7:6" />కుండ క్రింద చిటపటమనే ముండ్ల కంప మంట ఎలాంటిదో,</para>
  <para style="q2" vid="ECC 7:6">మూర్ఖుల నవ్వు అలాంటిదే.</para>
  <para style="q2" vid="ECC 7:6">అది కూడా అర్థరహితమే.<verse eid="ECC 7:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ECC 7:7" />అన్యాయం జ్ఞానంగల వానిని మూర్ఖునిగా మారుస్తుంది,</para>
  <para style="q2" vid="ECC 7:7">లంచం హృదయాన్ని పాడుచేస్తుంది.<verse eid="ECC 7:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ECC 7:8" />ఆరంభం కంటే అంతం మేలు,</para>
  <para style="q2" vid="ECC 7:8">అహంకారం కంటే సహనం మేలు.<verse eid="ECC 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 7:9" />తొందరపడి కోపపడవద్దు</para>
  <para style="q2" vid="ECC 7:9">ఎందుకంటే కోపం మూర్ఖుల ఒడిలో ఉంటుంది.<verse eid="ECC 7:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ECC 7:10" />“ఇప్పుడు ఉన్న రోజుల కన్నా గడిచిపోయిన రోజులే ఎందుకు మంచివి?” అని అనవద్దు</para>
  <para style="q2" vid="ECC 7:10">అలాంటి ప్రశ్నలు అడగడం తెలివైనది కాదు.<verse eid="ECC 7:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ECC 7:11" />జ్ఞానం ఒక వారసత్వంలా ఒక మంచి విషయమే</para>
  <para style="q2" vid="ECC 7:11">అది సూర్యుని క్రింద బ్రతికి ఉన్నవారికి ప్రయోజనం కలిగిస్తుంది.<verse eid="ECC 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 7:12" />డబ్బుతో భద్రత లభించినట్లే,</para>
  <para style="q2" vid="ECC 7:12">జ్ఞానంతో కూడా భద్రత లభిస్తుంది,</para>
  <para style="q1" vid="ECC 7:12">ప్రయోజనం ఏంటంటే:</para>
  <para style="q2" vid="ECC 7:12">జ్ఞానం తనను కలిగినవారిని కాపాడుతుంది.<verse eid="ECC 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 7:13" />దేవుడు చేసిన వాటిని పరిశీలించండి:</para>
  <para style="q1" vid="ECC 7:13">ఆయన వంకరగా చేసిన దానిని</para>
  <para style="q2" vid="ECC 7:13">ఎవరు సరిచేయగలరు?<verse eid="ECC 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 7:14" />సమయం మంచిగా ఉన్నప్పుడు సంతోషంగా ఉండండి;</para>
  <para style="q2" vid="ECC 7:14">కానీ సమయం చెడుగా ఉన్నప్పుడు ఇలా ఆలోచించండి:</para>
  <para style="q1" vid="ECC 7:14">దేవుడు దీన్ని చేశారు</para>
  <para style="q2" vid="ECC 7:14">అలాగే దాన్ని చేశారు.</para>
  <para style="q1" vid="ECC 7:14">అందువల్ల, తమ భవిష్యత్తు గురించి</para>
  <para style="q2" vid="ECC 7:14">ఎవరూ ఏమీ తెలుసుకోలేరు.<verse eid="ECC 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 7:15" />నా ఈ అర్థరహిత జీవితంలో నేను ఈ రెండు చూశాను;</para>
  <para style="q1" vid="ECC 7:15">నీతిమంతులు తమ నీతిలో నశించారు,</para>
  <para style="q2" vid="ECC 7:15">దుష్టులు తమ దుష్టత్వంలో దీర్ఘకాలం జీవించారు.<verse eid="ECC 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 7:16" />మరీ ఎక్కువ నీతిమంతునిగా ఉండకు,</para>
  <para style="q2" vid="ECC 7:16">మరీ ఎక్కువ జ్ఞానిగా ఉండకు,</para>
  <para style="q2" vid="ECC 7:16">నిన్ను నీవే ఎందుకు నాశనం చేసుకొంటావు?<verse eid="ECC 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 7:17" />మరీ ఎక్కువ దుర్మార్గంగా ఉండకు,</para>
  <para style="q2" vid="ECC 7:17">మూర్ఖునిగా ఉండకు.</para>
  <para style="q2" vid="ECC 7:17">సమయం రాకముందే ఎందుకు చనిపోవాలి?<verse eid="ECC 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 7:18" />ఒకదాన్ని పట్టుకోవడం</para>
  <para style="q2" vid="ECC 7:18">మరొకదాన్ని విడిచిపెట్టకపోవడం మంచిది.</para>
  <para style="q2" vid="ECC 7:18">దేవునికి భయపడేవారు అన్ని విపరీతాలను అధిగమిస్తారు.<verse eid="ECC 7:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="ECC 7:19" />పట్టణంలోని పదిమంది అధికారుల కంటే</para>
  <para style="q2" vid="ECC 7:19">తెలివైన వ్యక్తికి ఉన్న జ్ఞానం శక్తివంతమైనది.<verse eid="ECC 7:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="ECC 7:20" />ఎప్పుడూ పాపం చేయకుండా మంచినే చేస్తూ ఉండే,</para>
  <para style="q2" vid="ECC 7:20">నీతిమంతులు భూమిపై ఒక్కరు లేరు.<verse eid="ECC 7:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="ECC 7:21" />ప్రజలు చెప్పే ప్రతి మాటను వినవద్దు,</para>
  <para style="q2" vid="ECC 7:21">లేకపోతే మీ సేవకుడు మిమ్మల్ని శపించడం మీరు వింటారు.<verse eid="ECC 7:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="ECC 7:22" />ఎందుకంటే మీరే చాలాసార్లు</para>
  <para style="q2" vid="ECC 7:22">ఇతరులను శపించారని మీకు తెలుసు.<verse eid="ECC 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ECC 7:23" />నా జ్ఞానంతో ఇదంతా నేను పరిశోధించాను,</para>
  <para style="q1" vid="ECC 7:23">“నేను జ్ఞానిని కావాలని నిశ్చయించుకున్నాను”</para>
  <para style="q2" vid="ECC 7:23">కాని అది నావల్ల కాలేదు.<verse eid="ECC 7:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="ECC 7:24" />జ్ఞానం దూరంగా లోతుగా ఉంది</para>
  <para style="q2" vid="ECC 7:24">దానిని ఎవరు కనుగొనగలరు?<verse eid="ECC 7:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ECC 7:25" />జ్ఞానాన్ని, సంగతుల మూలకారణాన్ని వెదకి తెలుసుకోడానికి,</para>
  <para style="q2" vid="ECC 7:25">దుష్టత్వంలోని బుద్ధిహీనతను,</para>
  <para style="q1" vid="ECC 7:25">మూర్ఖత్వంలోని వెర్రితనాన్ని గ్రహించడానికి,</para>
  <para style="q2" vid="ECC 7:25">నేను నా హృదయాన్ని నిలుపుకున్నాను.<verse eid="ECC 7:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="ECC 7:26" />నేను మరణం కన్నా దుఃఖకరమైనది తెలుసుకున్నాను,</para>
  <para style="q2" vid="ECC 7:26">అది వల వంటిది,</para>
  <para style="q1" vid="ECC 7:26">ఉచ్చులాంటి మనస్సు కలిగి</para>
  <para style="q2" vid="ECC 7:26">సంకెళ్ల వంటి చేతులు కలిగిన స్త్రీ.</para>
  <para style="q1" vid="ECC 7:26">దేవుని సంతోషపరిచేవారు ఆమె నుండి తప్పించుకుంటారు.</para>
  <para style="q2" vid="ECC 7:26">కాని ఆమె పాపులను పట్టుకుంటుంది.<verse eid="ECC 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ECC 7:27" />ప్రసంగి ఇలా అంటున్నాడు, “నేను తెలుసుకున్నది ఇదే:</para>
  <para style="q1" vid="ECC 7:27">“సంగతుల మూలకారణాలను తెలుసుకోడానికి ఒక దానికి మరొకదాన్ని జోడించాను.<verse eid="ECC 7:27" /></para>
  <para style="q2">
    <verse number="28" style="v" sid="ECC 7:28" />నేను ఇంకా వెదకుతున్నాను</para>
  <para style="q2" vid="ECC 7:28">కాని దొరకడం లేదు,</para>
  <para style="q1" vid="ECC 7:28">వేయిమంది పురుషులలో ఒక్క యథార్థవంతుడు దొరికాడు,</para>
  <para style="q2" vid="ECC 7:28">కానీ స్త్రీలందరిలో ఒక్క యథార్థవంతురాలు కూడా దొరకలేదు.<verse eid="ECC 7:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="ECC 7:29" />నేను తెలుసుకున్నది ఇది ఒక్కటే;</para>
  <para style="q2" vid="ECC 7:29">దేవుడు మనుష్యజాతిని యథార్థవంతులుగానే సృజించారు,</para>
  <para style="q2" vid="ECC 7:29">కానీ వారు అనేక చెడు పథకాల వెంటపడుతున్నారు.”<verse eid="ECC 7:29" /></para>
  <para style="b" />
  <chapter eid="ECC 7" />
  <chapter number="8" style="c" sid="ECC 8" />
  <para style="q1">
    <verse number="1" style="v" sid="ECC 8:1" />జ్ఞానులకు ఎవరు సాటి?</para>
  <para style="q2" vid="ECC 8:1">విషయాలను ఎవరు వివరించగలరు?</para>
  <para style="q1" vid="ECC 8:1">ఒకని జ్ఞానం వాని ముఖాన్ని ప్రకాశవంతం చేస్తుంది</para>
  <para style="q2" vid="ECC 8:1">దాని కఠిన రూపాన్ని మారుస్తుంది.<verse eid="ECC 8:1" /></para>
  <para style="s1">రాజుకు లోబడాలి</para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 8:2" />నీవు దేవుని ఎదుట ప్రమాణం చేశావు కాబట్టి రాజాజ్ఞకు లోబడమని నేను చెప్తున్నాను. <verse eid="ECC 8:2" /><verse number="3" style="v" sid="ECC 8:3" />రాజు సముఖం నుండి తొందరపడి వెళ్లి పోవద్దు. అతడు తనకు ఏది ఇష్టమైతే అది చేస్తాడు కాబట్టి చెడ్డపనులు చేయవద్దు. <verse eid="ECC 8:3" /><verse number="4" style="v" sid="ECC 8:4" />రాజు మాట మహోన్నతమైనది, “మీరు నీవు ఏం చేస్తున్నావు?” అని రాజును ఎవరు అడగగలరు?<verse eid="ECC 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 8:5" />అతని ఆజ్ఞను పాటించే వారెవరికి ఏ హాని జరగదు,</para>
  <para style="q2" vid="ECC 8:5">ఏది సరియైన సమయమో న్యాయమో జ్ఞానుల హృదయానికి తెలుసు.<verse eid="ECC 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 8:6" />ఒక వ్యక్తి కష్టం అతని మీద అధిక భారంగా ఉన్నప్పటికీ,</para>
  <para style="q2" vid="ECC 8:6">ప్రతి దానికి సరియైన సమయం విధానం ఉంది.<verse eid="ECC 8:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ECC 8:7" />భవిష్యత్తు గురించి ఎవరికి తెలియదు కాబట్టి,</para>
  <para style="q2" vid="ECC 8:7">ఏది రాబోతుందో ఒకరికి ఎవరు చెప్పగలరు?<verse eid="ECC 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 8:8" />గాలిని అదుపుచేసే శక్తి ఎవరికీ లేదు,</para>
  <para style="q2" vid="ECC 8:8">కాబట్టి<note caller="+" style="f"><char style="fr" closed="false">8:8 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">దానిని నిలుపుకోవల్సింది మానవ ఆత్మ </char><char style="fq" closed="false">మీద </char><char style="fqa" closed="false">కాబట్టి</char></note> తమ మరణ సమయం మీద ఎవరికీ అధికారం లేదు.</para>
  <para style="q1" vid="ECC 8:8">ఎలాగైతే యుద్ధ సమయంలో ఎవరూ విడుదల చేయబడరో,</para>
  <para style="q2" vid="ECC 8:8">అలాగే దుర్మార్గం దానిని ఆచరించేవారిని విడుదల చేయదు.<verse eid="ECC 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 8:9" />ఇవన్నీ నేను చూశాను, సూర్యుని క్రింద చేసిన ప్రతిదానికీ నేను నా మనస్సులో ఆలోచించాను. ఒకరు ఇతరులపై ఉన్న అధికారంతో తనకే హాని తెచ్చుకుంటున్నారు. <verse eid="ECC 8:9" /><verse number="10" style="v" sid="ECC 8:10" />పవిత్ర స్థలానికి తరచూ వెళ్లేవారు ఇప్పుడు ఎక్కడ నేరాలు చేశారో అదే పట్టణంలో పొగడబడతారు. అలాంటి దుర్మార్గులు సక్రమంగా పాతిపెట్టబడడం నేను చూశాను. ఇది కూడా అర్థరహితమే.<verse eid="ECC 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 8:11" />చేసిన నేరానికి శిక్ష త్వరగా పడకపోతే ప్రజలు భయం లేకుండా చెడుపనులు చేస్తారు. <verse eid="ECC 8:11" /><verse number="12" style="v" sid="ECC 8:12" />వంద నేరాలకు పాల్పడిన దుర్మార్గుడు ఎక్కువకాలం జీవించినప్పటికీ, దేవునికి భయపడుతూ ఆయన పట్ల భక్తిగలవారి స్థితి మేలు అని నాకు తెలుసు. <verse eid="ECC 8:12" /><verse number="13" style="v" sid="ECC 8:13" />దుర్మార్గులు దేవునికి భయపడరు కాబట్టి, వారు అభివృద్ధి చెందరు, వారి రోజులు నీడలా ధీర్ఘకాలం ఉండవు.<verse eid="ECC 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 8:14" />భూమిపై అర్థరహితమైనది మరొకటి ఉంది: దుర్మార్గులు పొందవలసిన దాన్ని నీతిమంతులు, నీతిమంతులు పొందవలసిన దాన్ని దుర్మార్గులు పొందుతున్నారు. ఇది కూడా అర్థరహితమే అని నేను చెప్తున్నాను. <verse eid="ECC 8:14" /><verse number="15" style="v" sid="ECC 8:15" />కాబట్టి జీవితాన్ని ఆనందించడాన్ని నేను అభినందిస్తున్నాను, ఎందుకంటే సూర్యుని క్రింద ఉన్నవారు తిని త్రాగి సంతోషించడం కన్నా గొప్పది లేదు. అప్పుడు దేవుడు సూర్యుని క్రింద వారికి ఇచ్చిన జీవితకాలంలో వారి కష్టంలో వారికి తోడుగా ఉండేది ఆ సంతోషమే.<verse eid="ECC 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 8:16" />జ్ఞానాన్ని పొందడానికి, భూమిపై ప్రజలు పగలు రాత్రి నిద్రలేకుండ చేసే శ్రమను గమనించడానికి నేను నా మనస్సును నిలిపినప్పుడు <verse eid="ECC 8:16" /><verse number="17" style="v" sid="ECC 8:17" />దేవుడు చేస్తున్నదంతా నేను చూశాను. సూర్యుని క్రింద ఏమి జరుగుతుందో ఎవరూ అర్థం చేసుకోలేరు. దీన్ని వెదకడానికి వారు ఎన్ని ప్రయత్నాలు చేసినా, దాని పూర్తిగా గ్రహించలేరు. జ్ఞానులు తమకు తెలుసు అని వాదించినప్పటికీ, వారు దానిని నిజంగా గ్రహించలేరని నేను తెలుసుకున్నాను.<verse eid="ECC 8:17" /></para>
  <chapter eid="ECC 8" />
  <chapter number="9" style="c" sid="ECC 9" />
  <para style="s1">అందరికి ఒకే గమ్యం</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 9:1" />దీని అంతటిని పరిశీలించి నేనో నిర్ణయానికి వచ్చాను ఏంటంటే నీతిమంతులు జ్ఞానులు వారు చేసే పనులు దేవుని చేతుల్లో ఉన్నాయని, అయితే వారి కోసం ప్రేమ ఎదురుచూస్తుందా లేదా ద్వేషమా అనేది ఎవరికీ తెలియదు. <verse eid="ECC 9:1" /><verse number="2" style="v" sid="ECC 9:2" />జరిగేవన్నీ అందరికి ఒకే విధంగా జరుగుతాయి. నీతిమంతులకు దుర్మార్గులకు, మంచివారికి చెడ్డవారికి, అపవిత్రులకు పవిత్రులకు, బలులు అర్పించేవారికి అర్పించని వారికి అందరికి ఒకే విధంగా జరుగుతాయి.</para>
  <para style="q1" vid="ECC 9:2">మంచివారికి ఎలాగో,</para>
  <para style="q2" vid="ECC 9:2">పాపాత్ములకు అలాగే జరుగుతుంది;</para>
  <para style="q1" vid="ECC 9:2">ఒట్టుపెట్టుకునే వారికి,</para>
  <para style="q2" vid="ECC 9:2">ఒట్టు పెట్టుకోడానికి భయపడేవారికి అలాగే జరుగుతుంది.<verse eid="ECC 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 9:3" />అందరికి ఒకే విధంగా జరగడం సూర్యుని క్రింద జరిగే వాటన్నిటిలో చాలా చెడ్డ విషయం. అంతేకాక, మనుష్యుల హృదయాలు చెడుతో నిండి ఉన్నాయి, వారు బ్రతికి ఉన్నప్పుడు వారి హృదయాల్లో పిచ్చి ఉంటుంది, తర్వాత వారు చచ్చినవారితో కలిసిపోతారు. <verse eid="ECC 9:3" /><verse number="4" style="v" sid="ECC 9:4" />బ్రతికి ఉన్నవారి మధ్యలో ఉండే వారికే నిరీక్షణ ఉంటుంది; చనిపోయిన సింహం కంటే బ్రతికి ఉన్న కుక్క నయం కదా!<verse eid="ECC 9:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 9:5" />బ్రతికి ఉన్నవారికి తాము చనిపోతామని తెలుసు,</para>
  <para style="q2" vid="ECC 9:5">కాని చనిపోయినవారికి ఏమి తెలియదు;</para>
  <para style="q1" vid="ECC 9:5">వారికి ఏ బహుమతి లేదు,</para>
  <para style="q2" vid="ECC 9:5">వారి పేరు కూడా మర్చిపోతారు.<verse eid="ECC 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 9:6" />వారి ప్రేమ, వారి ద్వేషం</para>
  <para style="q2" vid="ECC 9:6">వారి అసూయ చాలా కాలం క్రితమే అంతరించిపోయాయి;</para>
  <para style="q1" vid="ECC 9:6">సూర్యుని క్రింద జరిగే ఏ విషయంలో</para>
  <para style="q2" vid="ECC 9:6">వారికిక ఏ భాగం ఉండదు.<verse eid="ECC 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 9:7" />వెళ్లండి, సంతోషంగా మీ ఆహారాన్ని తినండి ఆనందకరమైన హృదయంతో మీ ద్రాక్షరసం త్రాగండి, ఎందుకంటే మీరు చేసే దాన్ని దేవుడు ముందుగానే ఆమోదించారు. <verse eid="ECC 9:7" /><verse number="8" style="v" sid="ECC 9:8" />ఎప్పుడూ తెల్ల బట్టలు వేసుకో, ఎప్పుడూ తలకు నూనె రాసుకో. <verse eid="ECC 9:8" /><verse number="9" style="v" sid="ECC 9:9" />సూర్యుని క్రింద దేవుడు మీకు ఇచ్చిన ఈ అర్థరహితమైన జీవితకాలమంతా మీరు ప్రేమించే మీ భార్యతో జీవితాన్ని ఆస్వాదించండి; ఎందుకంటే ఇది మీ జీవితంలో సూర్యుని క్రింద మీరు పడిన కష్టంలో మీకు లభించే భాగము. <verse eid="ECC 9:9" /><verse number="10" style="v" sid="ECC 9:10" />మీ చేతికి వచ్చిన ఏ పనియైనా శక్తివంచన లేకుండా చేయండి. ఎందుకంటే మీరు వెళ్తున్న పాతాళంలో పని చేయడం గాని ప్రణాళిక వేయడం గాని లేదా తెలివి గాని జ్ఞానం గాని ఉండవు.<verse eid="ECC 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 9:11" />సూర్యుని క్రింద మరొకటి కూడ నేను గమనించాను:</para>
  <para style="q1" vid="ECC 9:11">వేగంగా ఉన్నవారే పందెం గెలవలేరు</para>
  <para style="q2" vid="ECC 9:11">బలంగా ఉన్నవారే యుద్ధాన్ని జయించలేరు,</para>
  <para style="q1" vid="ECC 9:11">జ్ఞానులకు ఆహారం లభించదు</para>
  <para style="q2" vid="ECC 9:11">తెలివైన వారికే సంపద ఉండదు</para>
  <para style="q2" vid="ECC 9:11">చదువుకున్న వారికి దయ లభించదు;</para>
  <para style="q1" vid="ECC 9:11">కాని సమయాన్ని బట్టే అందరికి అవకాశాలు వస్తాయి.<verse eid="ECC 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 9:12" />అంతేకాక, వాటి సమయం ఎప్పుడు వస్తుందో ఎవరికి తెలియదు:</para>
  <para style="q1" vid="ECC 9:12">చేపలు వలలో పట్టబడినట్లు,</para>
  <para style="q2" vid="ECC 9:12">పక్షులు వలలో చిక్కుకున్నట్లు</para>
  <para style="q1" vid="ECC 9:12">హఠాత్తుగా వారి మీద పడే</para>
  <para style="q2" vid="ECC 9:12">చెడు కాలంలో ప్రజలు చిక్కుపడతారు.<verse eid="ECC 9:12" /></para>
  <para style="s1">బుద్ధిహీనత కన్నా జ్ఞానం మిన్న</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 9:13" />నేను సూర్యుని క్రింద నన్ను బాగా ఆకట్టుకొన్న జ్ఞానం యొక్క ఈ ఉదాహరణను నేను చూశాను: <verse eid="ECC 9:13" /><verse number="14" style="v" sid="ECC 9:14" />ఒకప్పుడు కొద్దిమంది మాత్రమే ఉన్న ఒక చిన్న పట్టణం ఉండేది. ఒక శక్తివంతమైన రాజు వచ్చి దానిని చుట్టుముట్టి, దానికి ఎదురుగా భారీ ముట్టడి దిబ్బలు కట్టాడు. <verse eid="ECC 9:14" /><verse number="15" style="v" sid="ECC 9:15" />ఇప్పుడు ఆ పట్టణంలో ఉండే ఒక పేదవాడు తన జ్ఞానంతో ఆ పట్టణాన్ని కాపాడాడు. కానీ ఆ పేదవాన్ని ఎవరూ జ్ఞాపకం ఉంచుకోలేదు. <verse eid="ECC 9:15" /><verse number="16" style="v" sid="ECC 9:16" />కాబట్టి నేను ఇలా అనుకున్నాను, “బలం కన్నా జ్ఞానం మేలు” కానీ ఆ పేదవాడి జ్ఞానం తృణీకరించబడింది, అతని మాటలు ఇకపై పట్టించుకోరు.<verse eid="ECC 9:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 9:17" />మూర్ఖుల పాలకుడి కేకల కంటే</para>
  <para style="q2" vid="ECC 9:17">జ్ఞానులు మెల్లగా చెప్పే మాటలు వినడం మంచిది.<verse eid="ECC 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 9:18" />యుద్ధాయుధాలకంటె జ్ఞానం మేలు,</para>
  <para style="q2" vid="ECC 9:18">కాని ఒక్క పాపి అనేకమైన మంచి వాటిని నాశనం చేస్తాడు.<verse eid="ECC 9:18" /></para>
  <para style="b" />
  <chapter eid="ECC 9" />
  <chapter number="10" style="c" sid="ECC 10" />
  <para style="q1">
    <verse number="1" style="v" sid="ECC 10:1" />పరిమళతైలంలో పడిన చచ్చిన ఈగలు దానికి చెడు వాసన తెచ్చినట్లు,</para>
  <para style="q2" vid="ECC 10:1">కొంచెం మూర్ఖత్వం జ్ఞానాన్ని ఘనతను పాడుచేస్తుంది.<verse eid="ECC 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 10:2" />జ్ఞాని హృదయం కుడి చేతిలో ఉంటుంది,</para>
  <para style="q2" vid="ECC 10:2">కాని మూర్ఖుడి హృదయం ఎడమ చేతిలో ఉంటుంది.<verse eid="ECC 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 10:3" />తెలివిలేనివారు దారిలో సరిగా నడవలేక</para>
  <para style="q2" vid="ECC 10:3">వారు ఎంత తెలివితక్కువ వారు అనేది</para>
  <para style="q2" vid="ECC 10:3">అందరికి చూపిస్తారు.<verse eid="ECC 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 10:4" />వారు ఎంత తెలివితక్కువ వారు అనేది,</para>
  <para style="q2" vid="ECC 10:4">మీ ఉద్యోగాన్ని వదిలేయవద్దు;</para>
  <para style="q2" vid="ECC 10:4">ప్రశాంతత గొప్ప నేరాలు జరుగకుండ ఆపుతుంది.<verse eid="ECC 10:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ECC 10:5" />నేను సూర్యుని క్రింద ఒక చెడ్డ విషయాన్ని చూశాను,</para>
  <para style="q2" vid="ECC 10:5">ఒక పాలకుడు పొరపాటున చేసిన అన్యాయం:<verse eid="ECC 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 10:6" />అదేమిటంటే మూర్ఖులను ఉన్నత పదవులలో,</para>
  <para style="q2" vid="ECC 10:6">సమర్థులను దిగువ స్థాయిలో ఉంచడమే.<verse eid="ECC 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 10:7" />నేను బానిసలు గుర్రాలపై,</para>
  <para style="q2" vid="ECC 10:7">యువరాజులు బానిసల్లా కాలినడకన వెళ్లడం చూశాను.<verse eid="ECC 10:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ECC 10:8" />గొయ్యి త్రవ్వినవారే అందులో పడతారు;</para>
  <para style="q2" vid="ECC 10:8">గోడను పడగొట్టిన వారే పాము కాటుకు గురవుతారు.<verse eid="ECC 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 10:9" />రాళ్లు దొర్లించేవారు దానివల్ల గాయపడతారు;</para>
  <para style="q2" vid="ECC 10:9">మొద్దులను చీల్చేవారు వాటి వల్ల ప్రమాదానికి గురి అవుతారు.<verse eid="ECC 10:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ECC 10:10" />ఒకవేళ గొడ్డలి మొద్దుబారి</para>
  <para style="q2" vid="ECC 10:10">దాని అంచుకు పదును పెట్టకపోతే,</para>
  <para style="q1" vid="ECC 10:10">ఎక్కువ బలం ఉపయోగించాల్సి ఉంటుంది,</para>
  <para style="q2" vid="ECC 10:10">అయితే జ్ఞానం విజయాన్ని తెస్తుంది.<verse eid="ECC 10:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="ECC 10:11" />ఒకవేళ లొంగదీయక ముందే పాము కాటేస్తే,</para>
  <para style="q2" vid="ECC 10:11">పాములు ఆడించేవానికి లాభం ఉండదు.<verse eid="ECC 10:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="ECC 10:12" />జ్ఞానుల నోటి నుండి వచ్చే మాటలు దయగలవి,</para>
  <para style="q2" vid="ECC 10:12">కాని మూర్ఖుని పెదవులు వానినే మ్రింగివేస్తాయి.<verse eid="ECC 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 10:13" />అవివేకంతో మొదలైన వారి మాటలు;</para>
  <para style="q2" vid="ECC 10:13">దుర్మార్గపు వెర్రితనంతో ముగుస్తాయి;<verse eid="ECC 10:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="ECC 10:14" />అయినా మూర్ఖులు వాగుతూనే ఉంటారు.</para>
  <para style="b" vid="ECC 10:14" />
  <para style="q1" vid="ECC 10:14">ఏమి జరుగుతుందో ఎవరికి తెలియదు</para>
  <para style="q2" vid="ECC 10:14">వారు చనిపోయిన తర్వాత ఏమి జరుగుతుందో ఎవరు చెప్పగలరు?<verse eid="ECC 10:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="ECC 10:15" />మూర్ఖులకు పట్టణానికి వెళ్లడానికి దారి తెలియదు;</para>
  <para style="q2" vid="ECC 10:15">కాబట్టి తమ శ్రమతో వారు అలసిపోతారు.<verse eid="ECC 10:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="ECC 10:16" />దాసుడు<note caller="+" style="f"><char style="fr" closed="false">10:16 </char><char style="ft" closed="false">లేదా </char><char style="fq" closed="false">రాజు </char><char style="fqa" closed="false">బాలుడు</char></note> రాజుగా ఉన్న దేశానికి</para>
  <para style="q2" vid="ECC 10:16">ఉదయాన్నే విందు చేసుకొనే యువరాజులు ఉన్న దేశానికి శ్రమ.<verse eid="ECC 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 10:17" />గొప్ప జన్మ కలిగినవాడు రాజుగా ఉన్న దేశం</para>
  <para style="q2" vid="ECC 10:17">మత్తు కోసం కాక బలం కోసం సరైన సమయంలో</para>
  <para style="q2" vid="ECC 10:17">భోజనానికి కూర్చునే అధిపతులు ఉన్న దేశం ధన్యమైనది.<verse eid="ECC 10:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ECC 10:18" />ఒకని సోమరితనం వల్ల ఇంటికప్పు కూలిపోతుంది,</para>
  <para style="q2" vid="ECC 10:18">ఒకని బద్దకం వల్ల ఇల్లు కారిపోతుంది.<verse eid="ECC 10:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="ECC 10:19" />నవ్వడం కోసం విందు చేస్తారు,</para>
  <para style="q2" vid="ECC 10:19">ద్రాక్షరసం జీవితానికి సంతోషం కలిగిస్తుంది,</para>
  <para style="q2" vid="ECC 10:19">డబ్బు ప్రతిదానికీ సమాధానం.<verse eid="ECC 10:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="ECC 10:20" />మీ ఆలోచనలో కూడా రాజును తిట్టవద్దు,</para>
  <para style="q2" vid="ECC 10:20">మీ పడకగదిలో కూడా ధనికులను శపించవద్దు,</para>
  <para style="q1" vid="ECC 10:20">ఎందుకంటే ఆకాశపక్షులు,</para>
  <para style="q2" vid="ECC 10:20">రెక్కలున్న పక్షులు మీరు చెప్పేవాటిని బయట పెట్టవచ్చు.<verse eid="ECC 10:20" /></para>
  <chapter eid="ECC 10" />
  <chapter number="11" style="c" sid="ECC 11" />
  <para style="s1">అనేక చోట్ల పెట్టుబడి</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 11:1" />మీ ధాన్యాన్ని సముద్రం గుండా రవాణ చేయండి;</para>
  <para style="q2" vid="ECC 11:1">చాలా రోజుల తర్వాత దాని నుండి మీరు లాభం పొందవచ్చు.<verse eid="ECC 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 11:2" />ఏడు ఎనిమిదింటిలో పెట్టుబడి పెట్టండి;</para>
  <para style="q2" vid="ECC 11:2">దేశంలో ఎలాంటి విపత్తు వస్తుందో మీకు తెలియదు.<verse eid="ECC 11:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="ECC 11:3" />ఒకవేళ మేఘాల నిండా నీళ్లు ఉంటే,</para>
  <para style="q2" vid="ECC 11:3">అవి భూమిపై వర్షిస్తాయి.</para>
  <para style="q1" vid="ECC 11:3">ఒక చెట్టు దక్షిణంగా కూలినా ఉత్తరంగా కూలినా,</para>
  <para style="q2" vid="ECC 11:3">అది పడిన చోటనే ఉంటుంది.<verse eid="ECC 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 11:4" />గాలిని పరిశీలించేవాడు విత్తనాలు చల్లడు;</para>
  <para style="q2" vid="ECC 11:4">మబ్బులు చూస్తూ ఉండేవాడు పంట కోయడు.<verse eid="ECC 11:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="ECC 11:5" />మీకు గాలి వీచే దిశ తెలియనట్లుగానే,</para>
  <para style="q2" vid="ECC 11:5">తల్లి గర్భంలో పిండం ఎలా రూపుదిద్దుకుంటుందో తెలియనట్లుగా,</para>
  <para style="q1" vid="ECC 11:5">అన్నిటిని చేసినవాడైన</para>
  <para style="q2" vid="ECC 11:5">దేవుని క్రియలు మీకు అర్థం కావు.<verse eid="ECC 11:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ECC 11:6" />ఉదయాన్నే మీ విత్తనాన్ని విత్తండి,</para>
  <para style="q2" vid="ECC 11:6">సాయంత్రం వరకు మీ చేతులను వెనుకకు తీయకండి,</para>
  <para style="q1" vid="ECC 11:6">ఎందుకంటే ఇది ఫలిస్తుందో అది ఫలిస్తుందో,</para>
  <para style="q2" vid="ECC 11:6">లేదా రెండు సమానంగా ఫలిస్తాయో,</para>
  <para style="q2" vid="ECC 11:6">మీకు తెలియదు.<verse eid="ECC 11:6" /></para>
  <para style="s1">బాల్యంలోనే మీ సృష్టికర్తను జ్ఞాపకం చేసుకోండి</para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 11:7" />వెలుగు ఆహ్లాదకరమైనది,</para>
  <para style="q2" vid="ECC 11:7">సూర్యుని చూడడం కళ్లకు సంతోషాన్ని ఇస్తుంది.<verse eid="ECC 11:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 11:8" />ఎవరు ఎన్ని సంవత్సరాలు బ్రతికితే,</para>
  <para style="q2" vid="ECC 11:8">అన్ని సంవత్సరాలు వారు ఆనందంగా ఉండాలి.</para>
  <para style="q1" vid="ECC 11:8">అయితే చీకటి రోజులు చాలా</para>
  <para style="q2" vid="ECC 11:8">రాబోతున్నాయని వారు జ్ఞాపకముంచుకోవాలి.</para>
  <para style="q2" vid="ECC 11:8">రాబోయేదంతా అర్థరహితమే.<verse eid="ECC 11:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="ECC 11:9" />యవ్వనులారా మీరు, మీ యవ్వన దశలో మీరు సంతోషించండి,</para>
  <para style="q2" vid="ECC 11:9">మీ యవ్వన దినాల్లో మీ హృదయాన్ని సంతోషంగా ఉండనివ్వండి</para>
  <para style="q1" vid="ECC 11:9">మీ హృదయ కోరుకున్న వాటిని</para>
  <para style="q2" vid="ECC 11:9">మీ కళ్లు చూసే వాటిని అనుభవించండి,</para>
  <para style="q1" vid="ECC 11:9">కాని వీటన్నిటిని బట్టి దేవుడు మిమ్మల్ని</para>
  <para style="q2" vid="ECC 11:9">తీర్పులోకి తెస్తారని తెలుసుకోండి.<verse eid="ECC 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 11:10" />కాబట్టి, మీ హృదయంలోనుండి ఆందోళన తీసివేయండి,</para>
  <para style="q2" vid="ECC 11:10">మీ శరీర బాధలను వెళ్లగొట్టండి,</para>
  <para style="q2" vid="ECC 11:10">ఎందుకంటే యవ్వనం, దాని బలం అర్థరహితమే.<verse eid="ECC 11:10" /></para>
  <para style="b" />
  <chapter eid="ECC 11" />
  <chapter number="12" style="c" sid="ECC 12" />
  <para style="q1">
    <verse number="1-2" style="v" sid="ECC 12:1-2" />కష్ట దినాలు రాకముందే</para>
  <para style="q2" vid="ECC 12:1-2">“వాటిలో నాకు సంతోషం లేదు” అని నీవు చెప్పే</para>
  <para style="q2" vid="ECC 12:1-2">సంవత్సరాలు రాకముందే,</para>
  <para style="q1" vid="ECC 12:1-2">సూర్యచంద్ర నక్షత్రాలను చీకటి కమ్మక ముందే,</para>
  <para style="q2" vid="ECC 12:1-2">వర్షం తగ్గి మరలా మేఘాలు కమ్మక ముందే,</para>
  <para style="q1" vid="ECC 12:1-2">నీ యవ్వన ప్రాయంలో</para>
  <para style="q2" vid="ECC 12:1-2">నీ సృష్టికర్తను జ్ఞాపకం చేసుకో.<verse eid="ECC 12:1-2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 12:3" />ఆ రోజు ఇంటి కావలివారు వణుకుతారు,</para>
  <para style="q2" vid="ECC 12:3">బలిష్ఠులు వంగిపోతారు,</para>
  <para style="q1" vid="ECC 12:3">తిరగలి విసిరేవారు కొంతమందే ఉండడంతో పని ఆపివేస్తారు,</para>
  <para style="q2" vid="ECC 12:3">కిటికీలో నుండి చూచేవారి దృష్టి మందగిస్తుంది.<verse eid="ECC 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 12:4" />వీధి తలుపులు మూసేస్తారు;</para>
  <para style="q2" vid="ECC 12:4">తిరుగటిరాళ్ల ధ్వని తగ్గిపోతుంది</para>
  <para style="q1" vid="ECC 12:4">పక్షుల కూతకు ప్రజలు మేల్కొంటారు,</para>
  <para style="q2" vid="ECC 12:4">పాటలు పాడే స్త్రీల గొంతులు తగ్గిపోతాయి.<verse eid="ECC 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 12:5" />మనుష్యులు ఎత్తైన స్థలాలకు</para>
  <para style="q2" vid="ECC 12:5">వీధుల్లో అపాయాలకు భయపడతారు;</para>
  <para style="q1" vid="ECC 12:5">బాదం చెట్టు పూలు పూస్తుంది</para>
  <para style="q2" vid="ECC 12:5">మిడత తనను తాను ఈడ్చుకు వెళ్తున్నప్పుడు</para>
  <para style="q2" vid="ECC 12:5">ఇక కోరికలు రేపబడవు.</para>
  <para style="q1" vid="ECC 12:5">మనుష్యులు శాశ్వత నివాసం చేరుకుంటారు</para>
  <para style="q2" vid="ECC 12:5">వారి కోసం ఏడ్చేవారు వీధుల్లో తిరుగుతారు.<verse eid="ECC 12:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="ECC 12:6" />వెండితాడు తెగిపోక ముందే,</para>
  <para style="q2" vid="ECC 12:6">బంగారు గిన్నె పగిలిపోక ముందే,</para>
  <para style="q1" vid="ECC 12:6">నీటి ఊట దగ్గర కుండ బద్దలైపోక ముందే,</para>
  <para style="q2" vid="ECC 12:6">బావి దగ్గర చక్రం విరిగిపోక ముందే,</para>
  <para style="q2" vid="ECC 12:6">నీ సృష్టికర్తను జ్ఞాపకం చేసుకో.<verse eid="ECC 12:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 12:7" />మట్టితో తయారైంది తిరిగి మట్టిలో కలిసిపోతుంది,</para>
  <para style="q2" vid="ECC 12:7">ఆత్మ దేవుని దగ్గరకు వెళ్తుంది.<verse eid="ECC 12:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ECC 12:8" />“అర్థరహితం! అర్థరహితం!” అంటున్నాడు ఈ ప్రసంగి.</para>
  <para style="q2" vid="ECC 12:8">“ప్రతిదీ అర్థరహితమే!”<verse eid="ECC 12:8" /></para>
  <para style="s1">ముగింపు</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 12:9" />ప్రసంగి జ్ఞాని మాత్రమే కాదు అతడు ప్రజలకు కూడా జ్ఞానాన్ని అందించాడు. అతడు లోతుగా ఆలోచించి ఎన్నో సామెతలను క్రమపరిచాడు. <verse eid="ECC 12:9" /><verse number="10" style="v" sid="ECC 12:10" />ఈ ప్రసంగి సరియైన మాటలనే చెప్పాడు; అతడు సత్యమైన యథార్థ వాక్కులు వ్రాశాడు.<verse eid="ECC 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 12:11" />జ్ఞానుల మాటలు ములికోలు లాంటివి, సేకరించిన సూక్తులు గట్టిగా దిగగొట్టిన మేకుల వంటివి; అవి ఒక కాపరి చేత ఇవ్వబడ్డాయి. <verse eid="ECC 12:11" /><verse number="12" style="v" sid="ECC 12:12" />నా కుమారుడా, వీటితో పాటు ఇతర వాటి గురించి జాగ్రత్తగా ఉండు.</para>
  <para style="p" vid="ECC 12:12">పుస్తకాల రచనకు అంతం లేదు, అధిక చదువు శరీరానికి అలసట కలిగిస్తుంది.<verse eid="ECC 12:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 12:13" />ఇవన్నీ విన్న తర్వాత,</para>
  <para style="q2" vid="ECC 12:13">అన్నిటి ముగింపు ఇదే:</para>
  <para style="q1" vid="ECC 12:13">దేవునికి భయపడాలి ఆయన ఆజ్ఞలు పాటించాలి,</para>
  <para style="q2" vid="ECC 12:13">ఇదే మనుష్యులందరి కర్తవ్యము.<verse eid="ECC 12:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 12:14" />దేవుడు ప్రతి పనిని తీర్పులోనికి తెస్తారు,</para>
  <para style="q2" vid="ECC 12:14">దాచబడిన ప్రతి దానిని,</para>
  <para style="q2" vid="ECC 12:14">అది మంచిదైనా చెడ్డదైనా సరే తీర్పులోనికి తెస్తారు.<verse eid="ECC 12:14" /></para>
  <chapter eid="ECC 12" />
</usx>