<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LAM" style="id">- Biblica® Open Telugu Contemporary Version</book>
  <para style="h">విలాప</para>
  <para style="toc1">విలాప గ్రంథం</para>
  <para style="toc2">విలాప</para>
  <para style="toc3">విలాప</para>
  <para style="mt1">విలాప</para>
  <para style="mt2">గ్రంథం</para>
  <chapter number="1" style="c" sid="LAM 1"/>
  <para style="q1">
    <note caller="+" style="f">
      <char style="fr" closed="false">1 </char>
      <char style="ft" closed="false">ఈ అధ్యాయం ఒక అక్రోస్టిక్ పద్యం, ఇందులోని ప్రతి వచనం హెబ్రీ వర్ణమాలకు చెందిన వరుస అక్షరాలతో మొదలవుతాయి</char>
    </note> <verse number="1" style="v" sid="LAM 1:1"/>పట్టణం ఎలా నిర్జనమై ఉంది,</para>
  <para style="q2" vid="LAM 1:1">ఒకప్పుడు జనంతో నిండి ఉండేది!</para>
  <para style="q1" vid="LAM 1:1">ఆమె ఒక విధవరాలిలా ఎలా ఉంది,</para>
  <para style="q2" vid="LAM 1:1">ఒకప్పుడు దేశాల మధ్య గొప్పదిగా ఉండేది!</para>
  <para style="q1" vid="LAM 1:1">ఆమె రాజ్యాల మధ్య రాణిగా ఉండేది,</para>
  <para style="q2" vid="LAM 1:1">కాని ఇప్పుడు బానిసగా మారింది.<verse eid="LAM 1:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 1:2"/>రాత్రంతా ఆమె ఘోరంగా ఏడుస్తూ ఉంటుంది,</para>
  <para style="q2" vid="LAM 1:2">ఆమె చెంపల మీద కన్నీరు ఉంటుంది.</para>
  <para style="q1" vid="LAM 1:2">ఆమె ప్రేమికులందరి మధ్య ఉన్నా</para>
  <para style="q2" vid="LAM 1:2">ఆమెను ఓదార్చడానికి ఎవరూ లేరు.</para>
  <para style="q1" vid="LAM 1:2">ఆమె స్నేహితులందరూ ఆమెను అప్పగించారు;</para>
  <para style="q2" vid="LAM 1:2">వారు ఆమెకు శత్రువులయ్యారు.<verse eid="LAM 1:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 1:3"/>బాధ, కఠిన శ్రమ తర్వాత,</para>
  <para style="q2" vid="LAM 1:3">యూదా చెరకు వెళ్లిపోయింది.</para>
  <para style="q1" vid="LAM 1:3">ఆమె జనాంగాల మధ్య నివసిస్తుంది;</para>
  <para style="q2" vid="LAM 1:3">ఆమెకు విశ్రాంతి స్థలం దొరకడం లేదు.</para>
  <para style="q1" vid="LAM 1:3">ఆమెను వెంటాడే వారంతా ఆమె కష్టాల మధ్య</para>
  <para style="q2" vid="LAM 1:3">ఆమెను దాటి వెళ్లిపోయారు.<verse eid="LAM 1:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 1:4"/>సీయోనుకు వెళ్లే దారులు దుఃఖిస్తున్నాయి,</para>
  <para style="q2" vid="LAM 1:4">ఎందుకంటే దాని నియమించబడిన పండుగలకు ఎవరూ రావట్లేదు.</para>
  <para style="q1" vid="LAM 1:4">దాని ద్వారాలన్నీ నిర్జనమయ్యాయి,</para>
  <para style="q2" vid="LAM 1:4">ఆమె యాజకులు మూలుగుతున్నారు,</para>
  <para style="q1" vid="LAM 1:4">ఆమె యువతులు దుఃఖపడుతున్నారు,</para>
  <para style="q2" vid="LAM 1:4">ఆమె తీవ్ర వేదనలో ఉంది.<verse eid="LAM 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 1:5"/>ఆమె విరోధులు ఆమెకు యజమానులయ్యారు;</para>
  <para style="q2" vid="LAM 1:5">ఆమె శత్రువులు సుఖంగా జీవిస్తున్నారు;</para>
  <para style="q1" vid="LAM 1:5">ఆమె యొక్క అనేక పాపాలను బట్టి</para>
  <para style="q2" vid="LAM 1:5">యెహోవా ఆమెకు దుఃఖం కలిగించారు.</para>
  <para style="q1" vid="LAM 1:5">ఆమె పిల్లలు చెరకు వెళ్లారు,</para>
  <para style="q2" vid="LAM 1:5">వారు శత్రువు ముందు బందీలుగా ఉన్నారు.<verse eid="LAM 1:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 1:6"/>సీయోను కుమారి నుండి</para>
  <para style="q2" vid="LAM 1:6">వైభవమంతా అంతరించింది.</para>
  <para style="q1" vid="LAM 1:6">ఆమె అధిపతులు,</para>
  <para style="q2" vid="LAM 1:6">పచ్చిక దొరకని దుప్పిలా ఉన్నారు;</para>
  <para style="q1" vid="LAM 1:6">బలహీనులై తమను వెంటాడుతున్న వారి</para>
  <para style="q2" vid="LAM 1:6">ఎదుటి నుండి పారిపోయారు.<verse eid="LAM 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 1:7"/>తన బాధలో, ఆమె నిరాశ్రయురాలిగా ఉన్న రోజుల్లో,</para>
  <para style="q2" vid="LAM 1:7">యెరూషలేము పూర్వకాలంలో తనకు చెందిన సంపదలన్నింటినీ</para>
  <para style="q2" vid="LAM 1:7">జ్ఞాపకం చేసుకుంటుంది.</para>
  <para style="q1" vid="LAM 1:7">ఆమె ప్రజలు శత్రువు చేతిలో పడినప్పుడు,</para>
  <para style="q2" vid="LAM 1:7">వారికి సాయం చేయడానికి ఎవరూ లేరు.</para>
  <para style="q1" vid="LAM 1:7">ఆమె శత్రువులు ఆమె వైపు చూసి</para>
  <para style="q2" vid="LAM 1:7">ఆమెకు కలిగిన నాశనాన్ని బట్టి నవ్వారు.<verse eid="LAM 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 1:8"/>యెరూషలేము చాలా పాపం చేసింది</para>
  <para style="q2" vid="LAM 1:8">కాబట్టి అపవిత్రమైనది.</para>
  <para style="q1" vid="LAM 1:8">ఆమెను గౌరవించిన వారందరూ ఆమెను తృణీకరిస్తారు,</para>
  <para style="q2" vid="LAM 1:8">అందరు ఆమెను నగ్నంగా చూశారు.</para>
  <para style="q1" vid="LAM 1:8">ఆమె మూలుగుతూ వెనుదిరిగింది.<verse eid="LAM 1:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 1:9"/>ఆమె అపవిత్రత ఆమె దుస్తులకు అంటుకుంది;</para>
  <para style="q2" vid="LAM 1:9">ఆమె తన భవిష్యత్తు గురించి ఆలోచించలేదు.</para>
  <para style="q1" vid="LAM 1:9">ఆమె పతనం ఆశ్చర్యకరంగా ఉంది;</para>
  <para style="q2" vid="LAM 1:9">ఆమెను ఓదార్చడానికి ఎవరూ లేరు.</para>
  <para style="q1" vid="LAM 1:9">“యెహోవా, నా బాధను చూడు,</para>
  <para style="q2" vid="LAM 1:9">ఎందుకంటే శత్రువు నా మీద విజయం సాధించాడు.”<verse eid="LAM 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 1:10"/>ఆమె సంపదలన్నిటినీ</para>
  <para style="q2" vid="LAM 1:10">ఆమె శత్రువులు చేజిక్కించుకున్నారు;</para>
  <para style="q1" vid="LAM 1:10">యూదేతరుల దేశాలు</para>
  <para style="q2" vid="LAM 1:10">ఆమె పరిశుద్ధాలయంలోకి ప్రవేశించడం ఆమె చూసింది,</para>
  <para style="q1" vid="LAM 1:10">మీరు మీ సమాజంలోకి</para>
  <para style="q2" vid="LAM 1:10">ప్రవేశించకుండ నిషేధించబడినవారు.<verse eid="LAM 1:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 1:11"/>ఆమె ప్రజలందరూ</para>
  <para style="q2" vid="LAM 1:11">ఆహారం కోసం వెదుకుతూ మూల్గుతారు;</para>
  <para style="q1" vid="LAM 1:11">తాము బ్రతికి ఉండడానికి</para>
  <para style="q2" vid="LAM 1:11">వారు తమ సంపదలను ఇచ్చి ఆహారం తెచ్చుకుంటున్నారు.</para>
  <para style="q1" vid="LAM 1:11">“యెహోవా, మమ్మల్ని చూసి, ఏదైనా ఆలోచించు,</para>
  <para style="q2" vid="LAM 1:11">ఎందుకంటే మేము తృణీకరించబడ్డాము.”<verse eid="LAM 1:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 1:12"/>“దారిన పోయే మీకందరికి, ఏమీ అనిపించడం లేదా?</para>
  <para style="q2" vid="LAM 1:12">చుట్టూ తిరిగి చూడండి.</para>
  <para style="q1" vid="LAM 1:12">యెహోవా నా మీదికి</para>
  <para style="q2" vid="LAM 1:12">తన కోపాగ్ని దినాన</para>
  <para style="q1" vid="LAM 1:12">తెచ్చిన బాధలాంటి</para>
  <para style="q2" vid="LAM 1:12">బాధ ఏదైనా ఉందా?<verse eid="LAM 1:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 1:13"/>“ఆయన పైనుండి అగ్ని పంపారు,</para>
  <para style="q2" vid="LAM 1:13">దాన్ని నా ఎముకల్లోకి పంపారు.</para>
  <para style="q1" vid="LAM 1:13">నా పాదాలకు వలవేసి</para>
  <para style="q2" vid="LAM 1:13">నన్ను వెనుకకు తిరిగేలా చేశారు.</para>
  <para style="q1" vid="LAM 1:13">ఆయన నన్ను నిర్జనంగా చేశారు,</para>
  <para style="q2" vid="LAM 1:13">నేను బాధతో మూర్ఛపోయాను.<verse eid="LAM 1:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 1:14"/>“నా పాపాలు కాడికి కట్టబడ్డాయి<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="ft" closed="false">కొ. ప్ర. లలో </char><char style="fqa" closed="false">ఆయన నా పాపాలను కనిపెడుతున్నారు</char></note>;</para>
  <para style="q2" vid="LAM 1:14">ఆయన చేతులతో అవి ఒక్కటిగా నేయబడ్డాయి.</para>
  <para style="q1" vid="LAM 1:14">అవి నా మెడకు వ్రేలాడదీయబడ్డాయి,</para>
  <para style="q2" vid="LAM 1:14">యెహోవా నా బలాన్ని విఫలం చేశారు.</para>
  <para style="q1" vid="LAM 1:14">నేను తట్టుకోలేని వారి చేతుల్లోకి</para>
  <para style="q2" vid="LAM 1:14">ఆయన నన్ను అప్పగించారు.<verse eid="LAM 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 1:15"/>“నా మధ్య ఉన్న బలవంతులందరినీ</para>
  <para style="q2" vid="LAM 1:15">యెహోవా తిరస్కరించారు;</para>
  <para style="q1" vid="LAM 1:15">నా యువకులను అణచివేయడానికి</para>
  <para style="q2" vid="LAM 1:15">ఆయన నా మీదికి సైన్యాన్ని పిలిపించారు.</para>
  <para style="q1" vid="LAM 1:15">కన్యయైన యూదా కుమారిని</para>
  <para style="q2" vid="LAM 1:15">ప్రభువు తన ద్రాక్షగానుగలో త్రొక్కారు.<verse eid="LAM 1:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 1:16"/>“అందుకే నేను ఏడుస్తున్నాను</para>
  <para style="q2" vid="LAM 1:16">నా కళ్ల నుండి కన్నీరు పొర్లి పారుతున్నాయి.</para>
  <para style="q1" vid="LAM 1:16">నన్ను ఓదార్చడానికి నాకు దగ్గరగా ఎవరూ లేరు,</para>
  <para style="q2" vid="LAM 1:16">నా ఆత్మను ఉత్తేజపరచడానికి ఎవరూ లేరు.</para>
  <para style="q1" vid="LAM 1:16">శత్రువు నన్ను జయించాడు కాబట్టి</para>
  <para style="q2" vid="LAM 1:16">నా పిల్లలు నిరుపేదలయ్యారు.”<verse eid="LAM 1:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 1:17"/>సీయోను చేతులు చాచింది,</para>
  <para style="q2" vid="LAM 1:17">ఆమెను ఓదార్చడానికి ఎవరూ లేరు.</para>
  <para style="q1" vid="LAM 1:17">యాకోబుకు తన పొరుగువారే</para>
  <para style="q2" vid="LAM 1:17">శత్రువులుగా మారాలని యెహోవా శాసించారు;</para>
  <para style="q2" vid="LAM 1:17">యెరూషలేము వారి మధ్య అపవిత్రం అయ్యింది.<verse eid="LAM 1:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 1:18"/>“యెహోవా నీతిమంతుడు,</para>
  <para style="q2" vid="LAM 1:18">అయినా నేను ఆయన ఆజ్ఞకు వ్యతిరేకంగా తిరుగుబాటు చేశాను.</para>
  <para style="q1" vid="LAM 1:18">జనాంగములారా, వినండి;</para>
  <para style="q2" vid="LAM 1:18">నా శ్రమను చూడండి.</para>
  <para style="q1" vid="LAM 1:18">నా యువకులు, యువతులు</para>
  <para style="q2" vid="LAM 1:18">చెరకు వెళ్లారు.<verse eid="LAM 1:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 1:19"/>“సహాయం కోసం నేను నా స్నేహితులను పిలిచాను</para>
  <para style="q2" vid="LAM 1:19">కానీ వారు నన్ను మోసం చేశారు.</para>
  <para style="q1" vid="LAM 1:19">నా యాజకులు, నా పెద్దలు</para>
  <para style="q2" vid="LAM 1:19">తాము బ్రతికి ఉండాలని</para>
  <para style="q1" vid="LAM 1:19">ఆహారం కోసం వెదుకుతూ,</para>
  <para style="q2" vid="LAM 1:19">వారు పట్టణంలో చనిపోయారు.<verse eid="LAM 1:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 1:20"/>“యెహోవా, చూడండి, నేను ఎంత బాధలో ఉన్నానో!</para>
  <para style="q2" vid="LAM 1:20">నా లోలోపల చిత్రహింసను అనుభవిస్తున్నాను,</para>
  <para style="q1" vid="LAM 1:20">నా హృదయంలో నేను కలత చెందాను,</para>
  <para style="q2" vid="LAM 1:20">ఎందుకంటే నేను ఘోరంగా తిరుగుబాటు చేశాను.</para>
  <para style="q1" vid="LAM 1:20">బయట, ఖడ్గం హతమారుస్తూ ఉంది;</para>
  <para style="q2" vid="LAM 1:20">లోపల, కేవలం మరణమే.<verse eid="LAM 1:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 1:21"/>“ప్రజలు నా మూలుగు విన్నారు,</para>
  <para style="q2" vid="LAM 1:21">కాని నన్ను ఓదార్చడానికి ఎవరూ లేరు.</para>
  <para style="q1" vid="LAM 1:21">నా శత్రువులందరూ నా బాధను గురించి విన్నారు;</para>
  <para style="q2" vid="LAM 1:21">మీరు నాకు చేసిన దానిని బట్టి వారు సంతోషిస్తున్నారు.</para>
  <para style="q1" vid="LAM 1:21">మీరు ప్రకటించిన రోజును మీరు రప్పించాలి</para>
  <para style="q2" vid="LAM 1:21">అప్పుడు వారు నాలా అవుతారు.<verse eid="LAM 1:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 1:22"/>“వారి దుష్టత్వమంతా మీ ముందుకు రావాలి;</para>
  <para style="q2" vid="LAM 1:22">నా పాపాలన్నిటిని బట్టి</para>
  <para style="q1" vid="LAM 1:22">మీరు నాతో ఎలా వ్యవహరించారో</para>
  <para style="q2" vid="LAM 1:22">వారితో కూడా అలాగే వ్యవహరించాలి.</para>
  <para style="q1" vid="LAM 1:22">నా మూలుగులు అనేకం</para>
  <para style="q2" vid="LAM 1:22">నా హృదయం సొమ్మసిల్లింది.”<verse eid="LAM 1:22"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="LAM 1"/>
  <chapter number="2" style="c" sid="LAM 2"/>
  <para style="q1">
    <note caller="+" style="f">
      <char style="fr" closed="false">2 </char>
      <char style="ft" closed="false">ఈ అధ్యాయం ఒక అక్రోస్టిక్ పద్యం, ఇందులోని ప్రతి వచనం హెబ్రీ వర్ణమాలకు చెందిన వరుస అక్షరాలతో మొదలవుతాయి</char>
    </note> <verse number="1" style="v" sid="LAM 2:1"/>ప్రభువు తన కోపంతో</para>
  <para style="q2" vid="LAM 2:1">సీయోను కుమార్తెను మేఘంతో కప్పివేశారు!</para>
  <para style="q1" vid="LAM 2:1">ఆయన ఇశ్రాయేలు వైభవాన్ని</para>
  <para style="q2" vid="LAM 2:1">ఆకాశం నుండి భూమి మీదికి పడగొట్టారు;</para>
  <para style="q1" vid="LAM 2:1">ఆయన తన కోప్పడిన దినాన</para>
  <para style="q2" vid="LAM 2:1">తన పాదపీఠాన్ని జ్ఞాపకం చేసుకోలేదు.<verse eid="LAM 2:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 2:2"/>దయ లేకుండా ప్రభువు</para>
  <para style="q2" vid="LAM 2:2">యాకోబు నివాసాలన్నింటినీ నాశనం చేశారు.</para>
  <para style="q1" vid="LAM 2:2">తన కోపంలో ఆయన తన కుమార్తెయైన</para>
  <para style="q2" vid="LAM 2:2">యూదా కోటలను పడగొట్టారు.</para>
  <para style="q1" vid="LAM 2:2">ఆయన ఆమె రాజ్యాన్ని, దాని అధిపతులను</para>
  <para style="q2" vid="LAM 2:2">అగౌరపరచి నేలకూల్చారు.<verse eid="LAM 2:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 2:3"/>ఆయన తన కోపాగ్నిలో</para>
  <para style="q2" vid="LAM 2:3">ఇశ్రాయేలీయుల ప్రతి కొమ్మును<note caller="+" style="f"><char style="fr" closed="false">2:3 </char><char style="fq" closed="false">కొమ్ము </char><char style="ft" closed="false">ఇక్కడ బలాన్ని సూచిస్తుంది</char></note> నరికివేశారు.</para>
  <para style="q1" vid="LAM 2:3">శత్రువు దగ్గరికి వచ్చినప్పుడు</para>
  <para style="q2" vid="LAM 2:3">ఆయన తన కుడిచేతిని వెనుకకు తీసుకున్నారు.</para>
  <para style="q1" vid="LAM 2:3">ఆయన యాకోబులో మండుతున్న అగ్నిలా,</para>
  <para style="q2" vid="LAM 2:3">దాని చుట్టూ ఉన్న సమస్తాన్ని దహించే మంటలా ఉన్నారు.<verse eid="LAM 2:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 2:4"/>ఒక శత్రువులా ఆయన తన విల్లు ఎక్కుపెట్టారు;</para>
  <para style="q2" vid="LAM 2:4">ఆయన కుడిచేయి సిద్ధంగా ఉంది.</para>
  <para style="q1" vid="LAM 2:4">ఆయన ఒక శత్రువులా</para>
  <para style="q2" vid="LAM 2:4">కంటికి నచ్చిన వారందరినీ చంపేశారు;</para>
  <para style="q1" vid="LAM 2:4">ఆయన తన కోపాన్ని అగ్నిలా</para>
  <para style="q2" vid="LAM 2:4">సీయోను కుమార్తె గుడారం మీద కుమ్మరించారు.<verse eid="LAM 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 2:5"/>ప్రభువు ఒక శత్రువులా;</para>
  <para style="q2" vid="LAM 2:5">ఇశ్రాయేలును నాశనం చేశారు.</para>
  <para style="q1" vid="LAM 2:5">ఆమె రాజభవనాలన్నింటిని ఆయన కూల్చివేశారు,</para>
  <para style="q2" vid="LAM 2:5">అలాగే ఆమె కోటలను నాశనం చేశారు.</para>
  <para style="q1" vid="LAM 2:5">ఆయన యూదా కుమార్తె కోసం</para>
  <para style="q2" vid="LAM 2:5">దుఃఖాన్ని, విలాపాన్ని అధికం చేశారు.<verse eid="LAM 2:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 2:6"/>ఆయన తన నివాసాన్ని తోటలో ఉండే ఒక పాకలా కూల్చివేశారు;</para>
  <para style="q2" vid="LAM 2:6">ఆయన తన సమావేశ స్థలాన్ని నాశనం చేశారు.</para>
  <para style="q1" vid="LAM 2:6">యెహోవా సీయోనును తన</para>
  <para style="q2" vid="LAM 2:6">నియమించబడిన పండుగలను, సబ్బాతులను మరచిపోయేలా చేశారు;</para>
  <para style="q1" vid="LAM 2:6">ఆయన తన కోపాగ్నిలో</para>
  <para style="q2" vid="LAM 2:6">రాజును, యాజకులను తిరస్కరించారు.<verse eid="LAM 2:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 2:7"/>ప్రభువు తన బలిపీఠాన్ని తిరస్కరించి,</para>
  <para style="q2" vid="LAM 2:7">తన పరిశుద్ధాలయాన్ని విడిచిపెట్టారు.</para>
  <para style="q1" vid="LAM 2:7">ఆయన ఆమె రాజభవనాల గోడలను</para>
  <para style="q2" vid="LAM 2:7">శత్రువుల చేతికి అప్పగించారు;</para>
  <para style="q1" vid="LAM 2:7">నియామక పండుగ రోజున చేసినట్టుగా వారు</para>
  <para style="q2" vid="LAM 2:7">యెహోవా నివాసంలో బిగ్గరగా కేకలు వేశారు.<verse eid="LAM 2:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 2:8"/>సీయోను కుమారి చుట్టూ ఉన్న గోడను</para>
  <para style="q2" vid="LAM 2:8">పడగొట్టాలని యెహోవా నిశ్చయించుకున్నారు.</para>
  <para style="q1" vid="LAM 2:8">ఆయన కొలమానాన్ని గీసాడు</para>
  <para style="q2" vid="LAM 2:8">నాశనం చేయకూడదని తన చేతిని వెనుకకు తీసుకోలేదు.</para>
  <para style="q1" vid="LAM 2:8">ఆయన రక్షణ వ్యవస్థ అంతటిని, గోడలను విలపించేలా చేశారు;</para>
  <para style="q2" vid="LAM 2:8">అవి శిథిలావస్థలో ఉండిపోయాయి.<verse eid="LAM 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 2:9"/>ఆమె ద్వారాలు భూమిలోకి కృంగిపోయాయి;</para>
  <para style="q2" vid="LAM 2:9">ఆయన వాటి బంధాలను పగలగొట్టి నాశనం చేశారు.</para>
  <para style="q1" vid="LAM 2:9">ఆమె రాజు, ఆమె అధిపతులు దేశాల్లోకి చెరకు కొనిపోబడ్డారు,</para>
  <para style="q2" vid="LAM 2:9">ఇక ఉపదేశం లేకుండా పోయింది,</para>
  <para style="q1" vid="LAM 2:9">ఆమె ప్రవక్తలు ఇక</para>
  <para style="q2" vid="LAM 2:9">యెహోవా నుండి దర్శనాలను పొందుకోలేదు.<verse eid="LAM 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 2:10"/>సీయోను కుమార్తె పెద్దలు</para>
  <para style="q2" vid="LAM 2:10">మౌనంగా నేలమీద కూర్చున్నారు;</para>
  <para style="q1" vid="LAM 2:10">తమ తలలపై ధూళి చల్లుకొని</para>
  <para style="q2" vid="LAM 2:10">గోనెపట్ట కట్టుకున్నారు.</para>
  <para style="q1" vid="LAM 2:10">యెరూషలేము యువతులు</para>
  <para style="q2" vid="LAM 2:10">తమ తలలు నేలకు వంచుకున్నారు.<verse eid="LAM 2:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 2:11"/>ఏడ్వడం వల్ల నా కళ్లు క్షీణిస్తున్నాయి,</para>
  <para style="q2" vid="LAM 2:11">నా లోపలి భాగాలు వేదనను అనుభవిస్తున్నాను.</para>
  <para style="q1" vid="LAM 2:11">నా హృదయం నేలమీద కుమ్మరించబడింది,</para>
  <para style="q2" vid="LAM 2:11">ఎందుకంటే నా ప్రజలు నాశనమయ్యారు,</para>
  <para style="q1" vid="LAM 2:11">పిల్లలు, పసిపిల్లలు</para>
  <para style="q2" vid="LAM 2:11">నగర వీధుల్లో మూర్ఛపోయారు.<verse eid="LAM 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 2:12"/>వారు తమ తల్లులతో,</para>
  <para style="q2" vid="LAM 2:12">“తినడానికి, త్రాగడానికి ఏమి లేవా?” అని అడుగుతున్నారు,</para>
  <para style="q1" vid="LAM 2:12">వారు గాయపడిన వారిలా</para>
  <para style="q2" vid="LAM 2:12">నగర వీధుల్లో మూర్ఛపోతున్నారు,</para>
  <para style="q1" vid="LAM 2:12">వారి తల్లుల చేతుల్లో</para>
  <para style="q2" vid="LAM 2:12">వారి ప్రాణాలు పోతున్నాయి.<verse eid="LAM 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 2:13"/>యెరూషలేము కుమారీ!</para>
  <para style="q2" vid="LAM 2:13">నీ గురించి ఏమి చెప్పగలను?</para>
  <para style="q2" vid="LAM 2:13">నిన్ను దేనితో పోల్చగలను?</para>
  <para style="q1" vid="LAM 2:13">సీయోను కుమారీ,</para>
  <para style="q2" vid="LAM 2:13">కన్యకా! నిన్నెలా ఓదార్చడానికి</para>
  <para style="q2" vid="LAM 2:13">నిన్ను దేనితో పోల్చగలను</para>
  <para style="q1" vid="LAM 2:13">నీకు కలిగిన గాయం సముద్రమంత లోతుగా ఉంది</para>
  <para style="q2" vid="LAM 2:13">నిన్నెవరు స్వస్థపరచగలరు?<verse eid="LAM 2:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 2:14"/>నీ ప్రవక్తల దర్శనాలు</para>
  <para style="q2" vid="LAM 2:14">అబద్ధం, పనికిరానివి;</para>
  <para style="q1" vid="LAM 2:14">చెర నుండి నిన్ను తప్పించడానికి</para>
  <para style="q2" vid="LAM 2:14">వారు నీ పాపాన్ని బయటపెట్టలేదు.</para>
  <para style="q1" vid="LAM 2:14">వారు నీకు చెప్పిన ప్రవచనాలు</para>
  <para style="q2" vid="LAM 2:14">అబద్ధం, తప్పుదారి పట్టించేవి.<verse eid="LAM 2:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 2:15"/>నీ దారిన వెళ్లేవారంతా నిన్ను చూసి,</para>
  <para style="q2" vid="LAM 2:15">చప్పట్లు కొడతారు;</para>
  <para style="q1" vid="LAM 2:15">వారు యెరూషలేము దిక్కు చూసి</para>
  <para style="q2" vid="LAM 2:15">ఎగతాళిగా తలలాడిస్తూ ఇలా అంటారు:</para>
  <para style="q1" vid="LAM 2:15">“పరిపూర్ణ సౌందర్య పట్టణమని,</para>
  <para style="q2" vid="LAM 2:15">సమస్త భూనివాసులకు ఆనంద కారణమని</para>
  <para style="q2" vid="LAM 2:15">ఈ పట్టణాన్ని గురించేనా చెప్పుకున్నారు?”<verse eid="LAM 2:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 2:16"/>నీ శత్రువులందరూ</para>
  <para style="q2" vid="LAM 2:16">నీకు వ్యతిరేకంగా నోరు విప్పారు.</para>
  <para style="q1" vid="LAM 2:16">వారు ఎగతాళి చేసి పళ్లు కొరుకుతూ,</para>
  <para style="q2" vid="LAM 2:16">“మేము ఆమెను నాశనం చేశాము.</para>
  <para style="q1" vid="LAM 2:16">ఈ రోజు కోసమే మేము ఎదురు చూసింది;</para>
  <para style="q2" vid="LAM 2:16">దీన్ని చూడడానికే మేము బ్రతికి ఉండింది” అని అంటారు.<verse eid="LAM 2:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 2:17"/>యెహోవా తాను సంకల్పించింది చేశారు,</para>
  <para style="q2" vid="LAM 2:17">చాలా కాలం క్రితం ఆయన శాసించిన,</para>
  <para style="q2" vid="LAM 2:17">తన మాట ఆయన నెరవేర్చారు.</para>
  <para style="q1" vid="LAM 2:17">ఆయన దయ లేకుండా నిన్ను పడగొట్టారు,</para>
  <para style="q2" vid="LAM 2:17">శత్రువు నీ మీద సంతోషించేలా చేశారు,</para>
  <para style="q2" vid="LAM 2:17">ఆయన నీ శత్రువుల కొమ్మును<note caller="+" style="f" category="dup"><char style="fr" closed="false">2:17 </char><char style="fq" closed="false">కొమ్ము </char><char style="ft" closed="false">ఇక్కడ బలాన్ని సూచిస్తుంది</char></note> హెచ్చించారు.<verse eid="LAM 2:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 2:18"/>ప్రజల హృదయాలు</para>
  <para style="q2" vid="LAM 2:18">యెహోవాకు మొరపెడుతున్నాయి.</para>
  <para style="q1" vid="LAM 2:18">సీయోను కుమారి గోడలారా,</para>
  <para style="q2" vid="LAM 2:18">మీ కన్నీటిని నదిలా</para>
  <para style="q2" vid="LAM 2:18">పగలు రాత్రి ప్రవహించనివ్వండి;</para>
  <para style="q1" vid="LAM 2:18">మీకు మీరే ఉపశమనం కలిగించుకోవద్దు,</para>
  <para style="q2" vid="LAM 2:18">మీ కళ్లకు విశ్రాంతి ఇవ్వవద్దు.<verse eid="LAM 2:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 2:19"/>లేచి, రాత్రివేళ కేకలు వేయండి,</para>
  <para style="q2" vid="LAM 2:19">రేయి మొదటి జామున కేకలు వేయండి.</para>
  <para style="q1" vid="LAM 2:19">నీ హృదయాన్ని నీళ్లలా</para>
  <para style="q2" vid="LAM 2:19">ప్రభువు సన్నిధిలో కుమ్మరించండి.</para>
  <para style="q1" vid="LAM 2:19">ప్రతి వీధి చివరిలో</para>
  <para style="q2" vid="LAM 2:19">ఆకలితో మూర్ఛపోయిన</para>
  <para style="q1" vid="LAM 2:19">మీ పిల్లల ప్రాణాల కోసం</para>
  <para style="q2" vid="LAM 2:19">ఆయన వైపు మీ చేతులు ఎత్తండి.<verse eid="LAM 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 2:20"/>“చూడండి, యెహోవా, ఆలోచించండి:</para>
  <para style="q2" vid="LAM 2:20">మీరు ఇంతకుముందు ఎవరితోనైనా ఇలా వ్యవహరించారా?</para>
  <para style="q1" vid="LAM 2:20">స్త్రీలు తమ సంతానాన్ని తినాలా,</para>
  <para style="q2" vid="LAM 2:20">తాము పెంచిన పిల్లలను తినాలా?</para>
  <para style="q1" vid="LAM 2:20">యాజకుడు, ప్రవక్త</para>
  <para style="q2" vid="LAM 2:20">ప్రభువు యొక్క పరిశుద్ధాలయంలో చంపబడాలా?<verse eid="LAM 2:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 2:21"/>“చిన్నవారు, పెద్దవారు కలిసి</para>
  <para style="q2" vid="LAM 2:21">వీధుల్లోని దుమ్ములో పడుకుంటారు;</para>
  <para style="q1" vid="LAM 2:21">నా యువకులు, యువతులు</para>
  <para style="q2" vid="LAM 2:21">ఖడ్గం చేత చంపబడ్డారు.</para>
  <para style="q1" vid="LAM 2:21">మీరు కోప్పడిన దినాన మీరు వారిని చంపారు;</para>
  <para style="q2" vid="LAM 2:21">మీరు జాలి లేకుండా వారిని వధించారు.<verse eid="LAM 2:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 2:22"/>“మీరు ఒక పండుగ దినానికి పిలిచినట్లు,</para>
  <para style="q2" vid="LAM 2:22">నాకు వ్యతిరేకంగా ప్రతి వైపు నుండి భయాందోళనలు పిలిచారు.</para>
  <para style="q1" vid="LAM 2:22">యెహోవా ఉగ్రత దినాన</para>
  <para style="q2" vid="LAM 2:22">ఎవరూ తప్పించుకోలేదు, బ్రతకలేదు;</para>
  <para style="q1" vid="LAM 2:22">నేను అపురూపంగా పెంచుకొన్న వారిని</para>
  <para style="q2" vid="LAM 2:22">నా శత్రువు నాశనం చేశాడు.”<verse eid="LAM 2:22"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="LAM 2"/>
  <chapter number="3" style="c" sid="LAM 3"/>
  <para style="q1">
    <note caller="+" style="f">
      <char style="fr" closed="false">3 </char>
      <char style="ft" closed="false">ఈ అధ్యాయం ఒక అక్రోస్టిక్ పద్యం, ఇందులోని ప్రతి వచనం హెబ్రీ వర్ణమాలకు చెందిన వరుస అక్షరాలతో మొదలవుతాయి</char>
    </note> <verse number="1" style="v" sid="LAM 3:1"/>యెహోవా ఉగ్రత కర్ర చేత</para>
  <para style="q2" vid="LAM 3:1">నేను బాధను అనుభవించిన వాన్ని.<verse eid="LAM 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 3:2"/>ఆయన నన్ను వెళ్లగొట్టి,</para>
  <para style="q2" vid="LAM 3:2">వెలుగులో కాకుండా చీకటిలో నడిచేలా చేశారు.<verse eid="LAM 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 3:3"/>నిజానికి, ఆయన రోజంతా</para>
  <para style="q2" vid="LAM 3:3">మాటిమాటికి నా మీద తన చేయి ఆడిస్తానే ఉన్నారు.<verse eid="LAM 3:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 3:4"/>ఆయన నా చర్మాన్ని, నా మాంసాన్ని క్షీణించిపోయేలా చేసి</para>
  <para style="q2" vid="LAM 3:4">నా ఎముకలను విరగ్గొట్టారు.<verse eid="LAM 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 3:5"/>ఆయన నన్ను ముట్టడించి,</para>
  <para style="q2" vid="LAM 3:5">విషంతో కఠినత్వంతో నన్ను చుట్టుముట్టారు.<verse eid="LAM 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 3:6"/>ఎప్పుడో చనిపోయినవారు పడి ఉన్నట్లుగా</para>
  <para style="q2" vid="LAM 3:6">ఆయన నన్ను చీకటిలో పడి ఉండేలా చేశారు.<verse eid="LAM 3:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 3:7"/>నేను తప్పించుకోకుండా ఆయన నా చుట్టూ గోడ కట్టించారు;</para>
  <para style="q2" vid="LAM 3:7">బరువైన గొలుసులతో ఆయన నన్ను బంధించారు.<verse eid="LAM 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 3:8"/>నేను సహాయం కోసం పిలిచినా, మొరపెట్టినా</para>
  <para style="q2" vid="LAM 3:8">ఆయన నా ప్రార్థనకు తన చెవులు మూసుకుంటారు.<verse eid="LAM 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 3:9"/>ఆయన రాళ్లను నా దారికి అడ్డుపెట్టారు;</para>
  <para style="q2" vid="LAM 3:9">ఆయన నా మార్గాలను వంకర చేశారు.<verse eid="LAM 3:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 3:10"/>పొంచి ఉన్న ఎలుగుబంటిలా,</para>
  <para style="q2" vid="LAM 3:10">దాక్కున్న సింహంలా,<verse eid="LAM 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 3:11"/>ఆయన నన్ను దారిలో నుండి ఈడ్చుకెళ్లి, నన్ను ముక్కలు చేసి,</para>
  <para style="q2" vid="LAM 3:11">నిస్సహాయ స్థితిలో వదిలేశారు.<verse eid="LAM 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 3:12"/>ఆయన తన విల్లు తీసి,</para>
  <para style="q2" vid="LAM 3:12">తన బాణాలకు నన్ను లక్ష్యంగా చేసుకున్నారు.<verse eid="LAM 3:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 3:13"/>ఆయన తన అంబుల పొదిలోని బాణాలతో,</para>
  <para style="q2" vid="LAM 3:13">నా గుండెను గుచ్చారు.<verse eid="LAM 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 3:14"/>నేను నా ప్రజలందరికి నవ్వులాటగా మారాను;</para>
  <para style="q2" vid="LAM 3:14">రోజంతా వారు పాటలో నన్ను హేళన చేస్తున్నారు.<verse eid="LAM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 3:15"/>ఆయన నాతో చేదు మూలికలు తినిపించారు,</para>
  <para style="q2" vid="LAM 3:15">త్రాగడానికి చేదు పానీయాన్ని ఇచ్చారు.<verse eid="LAM 3:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 3:16"/>ఆయన రాళ్లతో నా పళ్లను విరగ్గొట్టారు;</para>
  <para style="q2" vid="LAM 3:16">నన్ను దుమ్ములో త్రొక్కారు.<verse eid="LAM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 3:17"/>సమాధానం నాకు దూరమైంది,</para>
  <para style="q2" vid="LAM 3:17">అభివృద్ధి అంటే ఏంటో మరచిపోయాను.<verse eid="LAM 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 3:18"/>కాబట్టి, “నా వైభవం పోయింది,</para>
  <para style="q2" vid="LAM 3:18">యెహోవా నుండి నేను ఆశించినవన్నీ పోయాయి” అని నేనన్నాను.<verse eid="LAM 3:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 3:19"/>నా శ్రమ, నా నిరాశ్రయ స్థితి,</para>
  <para style="q2" vid="LAM 3:19">నేను త్రాగిన చేదు పానీయం జ్ఞాపకం చేసుకోండి.<verse eid="LAM 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 3:20"/>నేను వాటిని బాగా జ్ఞాపకముంచుకున్నాను,</para>
  <para style="q2" vid="LAM 3:20">నా ప్రాణం నాలో కృంగి ఉంది.<verse eid="LAM 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 3:21"/>అయినప్పటికీ నేను ఇది జ్ఞాపకం చేసుకుంటాను,</para>
  <para style="q2" vid="LAM 3:21">కాబట్టి నాకు నిరీక్షణ ఉంది:<verse eid="LAM 3:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 3:22"/>యెహోవా మహా ప్రేమను బట్టి మనం నాశనం కాలేదు,</para>
  <para style="q2" vid="LAM 3:22">ఎందుకంటే ఆయన కనికరం ఎన్నటికీ తగ్గదు.<verse eid="LAM 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="LAM 3:23"/>ప్రతి ఉదయం అవి క్రొత్తవిగా ఉంటాయి;</para>
  <para style="q2" vid="LAM 3:23">మీ నమ్మకత్వం గొప్పది.<verse eid="LAM 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="LAM 3:24"/>నాలో నేను, “యెహోవా నా స్వాస్థ్యం;</para>
  <para style="q2" vid="LAM 3:24">కాబట్టి నేను ఆయన కోసం వేచి ఉంటాను”</para>
  <para style="q2" vid="LAM 3:24">అని అనుకుంటున్నాను.<verse eid="LAM 3:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="LAM 3:25"/>తన మీద నిరీక్షణ కలిగి ఉన్నవారికి,</para>
  <para style="q2" vid="LAM 3:25">తనను వెదికేవారికి యెహోవా మేలు చేస్తారు;<verse eid="LAM 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="LAM 3:26"/>యెహోవా రక్షణ కోసం</para>
  <para style="q2" vid="LAM 3:26">ఓపికతో వేచి ఉండడం మంచిది.<verse eid="LAM 3:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="LAM 3:27"/>ఒక మనిషి యవ్వన దశలో ఉన్నప్పుడే,</para>
  <para style="q2" vid="LAM 3:27">కాడి మోయడం అతనికి మేలు.<verse eid="LAM 3:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="LAM 3:28"/>యెహోవాయే దాన్ని అతని మీద ఉంచారు,</para>
  <para style="q2" vid="LAM 3:28">కాబట్టి అతడు ఒంటరిగా మౌనంగా కూర్చోవాలి.<verse eid="LAM 3:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="LAM 3:29"/>అతడు తన ముఖం ధూళిలో పెట్టుకోవచ్చు</para>
  <para style="q2" vid="LAM 3:29">ఎందుకంటే ఇంకా నిరీక్షణ ఉండవచ్చు.<verse eid="LAM 3:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="LAM 3:30"/>తనను కొట్టేవానికి తన చెంపను చూపించి,</para>
  <para style="q2" vid="LAM 3:30">నిండా అవమానం పాలుకానివ్వు.<verse eid="LAM 3:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="LAM 3:31"/>ఎవ్వరూ ప్రభువుచేత</para>
  <para style="q2" vid="LAM 3:31">శాశ్వతంగా త్రోసివేయబడరు.<verse eid="LAM 3:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="LAM 3:32"/>ఆయన దుఃఖం కలిగించినప్పటికీ, ఆయన కనికరం చూపుతారు,</para>
  <para style="q2" vid="LAM 3:32">ఆయన మారని ప్రేమ చాలా గొప్పది.<verse eid="LAM 3:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="LAM 3:33"/>ఆయన ఇష్టపూర్వకంగా ఎవరికీ కష్టాలు గాని</para>
  <para style="q2" vid="LAM 3:33">దుఃఖం గాని కలుగజేయరు.<verse eid="LAM 3:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="LAM 3:34"/>దేశంలో ఖైదీలందరిని,</para>
  <para style="q2" vid="LAM 3:34">కాళ్లక్రింద పడేసి త్రొక్కాలని,<verse eid="LAM 3:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="LAM 3:35"/>మహోన్నతుని ఎదుట,</para>
  <para style="q2" vid="LAM 3:35">ప్రజలు తమ హక్కులను త్రోసిపుచ్చాలని,<verse eid="LAM 3:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="LAM 3:36"/>ఒక వ్యక్తికి న్యాయం జరగకుండా చేయడం,</para>
  <para style="q2" vid="LAM 3:36">ఇలాంటివి ప్రభువు చూడరా?<verse eid="LAM 3:36"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="37" style="v" sid="LAM 3:37"/>ప్రభువు శాసించనప్పుడు</para>
  <para style="q2" vid="LAM 3:37">అది జరిగేలా ఎవరు ఆజ్ఞాపించగలరు?<verse eid="LAM 3:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="LAM 3:38"/>మహోన్నతుని నోటి నుండి</para>
  <para style="q2" vid="LAM 3:38">వైపరీత్యాలు, అలాగే మంచి విషయాలు రావా?<verse eid="LAM 3:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="LAM 3:39"/>తమ పాపాలను బట్టి శిక్షించబడినప్పుడు</para>
  <para style="q2" vid="LAM 3:39">సజీవులైన మనుష్యులు ఎందుకు ఫిర్యాదు చేయాలి?<verse eid="LAM 3:39"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="40" style="v" sid="LAM 3:40"/>మన మార్గాలను పరిశీలించి, వాటిని పరీక్షించి,</para>
  <para style="q2" vid="LAM 3:40">యెహోవా దగ్గరకు తిరిగి వెళ్దాము.<verse eid="LAM 3:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="LAM 3:41"/>మన హృదయాలను, చేతులను</para>
  <para style="q2" vid="LAM 3:41">పరలోకంలో ఉన్న దేవుని వైపు ఎత్తి:<verse eid="LAM 3:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="LAM 3:42"/>“మేము పాపం చేశాము, తిరుగుబాటు చేశాము</para>
  <para style="q2" vid="LAM 3:42">మీరు క్షమించలేదు.<verse eid="LAM 3:42"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="43" style="v" sid="LAM 3:43"/>“మీరు కోపంతో కప్పుకుని మమ్మల్ని వెంటాడారు;</para>
  <para style="q2" vid="LAM 3:43">మీరు జాలి లేకుండా చంపారు.<verse eid="LAM 3:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="LAM 3:44"/>ఏ ప్రార్థన ఫలించకుండా,</para>
  <para style="q2" vid="LAM 3:44">మీరు ఒక మేఘంతో మిమ్మల్ని మీరు కప్పుకున్నారు.<verse eid="LAM 3:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="LAM 3:45"/>దేశాల మధ్య</para>
  <para style="q2" vid="LAM 3:45">మీరు మమ్మల్ని చెత్తగా చేశారు.<verse eid="LAM 3:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="LAM 3:46"/>“మా శత్రువులందరూ మాకు వ్యతిరేకంగా</para>
  <para style="q2" vid="LAM 3:46">నోరు తెరిచారు.<verse eid="LAM 3:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="LAM 3:47"/>మేము భయాందోళనలను ఆపదలను ఎదుర్కొన్నాము,</para>
  <para style="q2" vid="LAM 3:47">పతనము నాశనము.”<verse eid="LAM 3:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="LAM 3:48"/>నా ప్రజలు నాశనమయ్యారు కాబట్టి</para>
  <para style="q2" vid="LAM 3:48">నా కళ్ళ నుండి కన్నీటి ధారలు ప్రవహిస్తాయి.<verse eid="LAM 3:48"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="49-50" style="v" sid="LAM 3:49-50"/>యెహోవా పరలోకం నుండి</para>
  <para style="q2" vid="LAM 3:49-50">క్రిందికి వంగి చూసే వరకు,</para>
  <para style="q1" vid="LAM 3:49-50">ఉపశమనం లేకుండా,</para>
  <para style="q2" vid="LAM 3:49-50">నా కంటి నుండి నీరు ఎడతెగకుండా ప్రవహిస్తుంది.<verse eid="LAM 3:49-50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="LAM 3:51"/>నా నగర స్త్రీలందరి వల్ల</para>
  <para style="q2" vid="LAM 3:51">నేను చూసేది నా ప్రాణానికి దుఃఖం కలిగిస్తుంది.<verse eid="LAM 3:51"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="52" style="v" sid="LAM 3:52"/>కారణం లేకుండా నాకు శత్రువులుగా ఉన్నవారు</para>
  <para style="q2" vid="LAM 3:52">పక్షిలా నన్ను వేటాడారు.<verse eid="LAM 3:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="LAM 3:53"/>వారు గొయ్యిలో వేసి నా ప్రాణం తీయాలని చూశారు,</para>
  <para style="q2" vid="LAM 3:53">నాపై రాళ్లు విసిరారు;<verse eid="LAM 3:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="LAM 3:54"/>నీరు నా తలపై మూసుకుపోయాయి,</para>
  <para style="q2" vid="LAM 3:54">నేను నశిస్తానని అనుకున్నాను.<verse eid="LAM 3:54"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="55" style="v" sid="LAM 3:55"/>యెహోవా, నీ నామమున మొరపెట్టాను,</para>
  <para style="q2" vid="LAM 3:55">గొయ్యి లోతుల్లో నుండి నీ నామాన్ని పిలిచాను.<verse eid="LAM 3:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="LAM 3:56"/>“మీరు నా మొరను ఆలకించారు,</para>
  <para style="q2" vid="LAM 3:56">నీ చెవులు మూసుకోకు”</para>
  <para style="q2" vid="LAM 3:56">అనే నా విన్నపాన్ని మీరు విన్నారు.<verse eid="LAM 3:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="LAM 3:57"/>నేను నిన్ను పిలిచినప్పుడు మీరు దగ్గరికి వచ్చి</para>
  <para style="q2" vid="LAM 3:57">“భయపడకు” అన్నారు.<verse eid="LAM 3:57"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="58" style="v" sid="LAM 3:58"/>ప్రభువా, నీవు నా కేసు తీసుకున్నావు.</para>
  <para style="q2" vid="LAM 3:58">నీవు నా ప్రాణాన్ని విమోచించావు.<verse eid="LAM 3:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="LAM 3:59"/>యెహోవా చూశావు.</para>
  <para style="q2" vid="LAM 3:59">నా కారణాన్ని సమర్థించండి!<verse eid="LAM 3:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="LAM 3:60"/>వారి ప్రతీకార తీవ్రతను,</para>
  <para style="q2" vid="LAM 3:60">నాకు వ్యతిరేకంగా వారు పన్నిన కుట్రలన్నీ మీరు చూశారు.<verse eid="LAM 3:60"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="61" style="v" sid="LAM 3:61"/>యెహోవా, వారి అవమానాలను,</para>
  <para style="q2" vid="LAM 3:61">నాకు వ్యతిరేకంగా వారు పన్నిన పన్నాగాలన్నీ మీరు విన్నారు.<verse eid="LAM 3:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="LAM 3:62"/>నా శత్రువులు రోజంతా నాకు వ్యతిరేకంగా</para>
  <para style="q2" vid="LAM 3:62">గుసగుసలాడే గొణుగుతున్నారు.<verse eid="LAM 3:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="LAM 3:63"/>వాటిని చూడు! కూర్చున్నా, నిలబడినా</para>
  <para style="q2" vid="LAM 3:63">తమ పాటల్లో నన్ను వెక్కిరిస్తారు.<verse eid="LAM 3:63"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="64" style="v" sid="LAM 3:64"/>యెహోవా వారి క్రియా కలపలను బట్టి,</para>
  <para style="q2" vid="LAM 3:64">ప్రతీకారం చేస్తావు.<verse eid="LAM 3:64"/></para>
  <para style="q1">
    <verse number="65" style="v" sid="LAM 3:65"/>వారికి కాఠిన్యమైన హృదయాలు ఇవ్వండి,</para>
  <para style="q2" vid="LAM 3:65">మీ శాపం వారి మీదికి వచ్చును గాక.<verse eid="LAM 3:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="LAM 3:66"/>కోపంతో వారిని వెంటాడి,</para>
  <para style="q2" vid="LAM 3:66">యెహోవా ఆకాశాల క్రిందనుండి వారిని నాశనం చేయండి.<verse eid="LAM 3:66"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="LAM 3"/>
  <chapter number="4" style="c" sid="LAM 4"/>
  <para style="q1">
    <note caller="+" style="f" category="dup">
      <char style="fr" closed="false">4 </char>
      <char style="ft" closed="false">ఈ అధ్యాయం ఒక అక్రోస్టిక్ పద్యం, ఇందులోని ప్రతి వచనం హెబ్రీ వర్ణమాలకు చెందిన వరుస అక్షరాలతో మొదలవుతాయి</char>
    </note> <verse number="1" style="v" sid="LAM 4:1"/>బంగారం తన మెరుపును ఎలా కోల్పోయింది,</para>
  <para style="q2" vid="LAM 4:1">మంచి బంగారం ఎలా మొద్దుబారిపోయింది!</para>
  <para style="q1" vid="LAM 4:1">ప్రతి వీధి మూలలో</para>
  <para style="q2" vid="LAM 4:1">ప్రశస్తమైన రాళ్ల వంటి రత్నాలు చెల్లాచెదురుగా ఉన్నాయి.<verse eid="LAM 4:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 4:2"/>ప్రశస్తమైన సీయోను పిల్లలు ఎలా అయిపోయారు,</para>
  <para style="q2" vid="LAM 4:2">ఒకప్పుడు వారి విలువ బంగారంతో తూగేది,</para>
  <para style="q1" vid="LAM 4:2">ఇప్పుడు మట్టి కుండలుగా,</para>
  <para style="q2" vid="LAM 4:2">కుమ్మరి చేతి పనిగా పరిగణించబడుతున్నారు!<verse eid="LAM 4:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 4:3"/>నక్కలు కూడా</para>
  <para style="q2" vid="LAM 4:3">తమ పిల్లలకు పాలివ్వడానికి తమ రొమ్ములిస్తాయి,</para>
  <para style="q1" vid="LAM 4:3">కానీ నా ప్రజలు ఎడారిలో నిప్పుకోడిలా</para>
  <para style="q2" vid="LAM 4:3">హృదయం లేనివారయ్యారు.<verse eid="LAM 4:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 4:4"/>దాహం వల్ల పసివారి నాలుక</para>
  <para style="q2" vid="LAM 4:4">నోటి అంగిటికి అంటుకుపోతుంది;</para>
  <para style="q1" vid="LAM 4:4">పిల్లలు ఆహారం కోసం వేడుకుంటారు,</para>
  <para style="q2" vid="LAM 4:4">కానీ ఎవరూ వారికి ఇవ్వరు.<verse eid="LAM 4:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 4:5"/>ఒకప్పుడు రుచికరమైన పదార్ధాలు తిన్నవారు</para>
  <para style="q2" vid="LAM 4:5">వీధుల్లో నిరుపేదలు.</para>
  <para style="q1" vid="LAM 4:5">రాజ ఊదా రంగులో పెరిగిన</para>
  <para style="q2" vid="LAM 4:5">ఇప్పుడు బూడిద కుప్పల మీద పడుకున్నారు.<verse eid="LAM 4:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 4:6"/>సొదొమ శిక్ష కంటే</para>
  <para style="q2" vid="LAM 4:6">నా ప్రజల శిక్ష గొప్పది,</para>
  <para style="q1" vid="LAM 4:6">ఆమెకు సహాయం చేయడానికి చేయి లేకుండానే</para>
  <para style="q2" vid="LAM 4:6">క్షణాల్లో పడగొట్టబడింది.<verse eid="LAM 4:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 4:7"/>అందలి అధిపతులు మంచుకంటే స్వచ్ఛమైన వారు,</para>
  <para style="q2" vid="LAM 4:7">పాలకంటే తెల్లని వారు.</para>
  <para style="q1" vid="LAM 4:7">శరీరాలు పగడాలకంటే ఎర్రగా ఉన్నాయి,</para>
  <para style="q2" vid="LAM 4:7">వారి దేహకాంతి నీలమణి లాంటిది.<verse eid="LAM 4:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 4:8"/>అలాంటివారి ఆకారం బొగ్గు కంటే నలుపుగా అయింది,</para>
  <para style="q2" vid="LAM 4:8">వీధుల్లో వారిని చూసి వారిని గుర్తు పట్టలేదు.</para>
  <para style="q1" vid="LAM 4:8">వారి చర్మం వారి ఎముకలకు అంటుకుపోయి</para>
  <para style="q2" vid="LAM 4:8">ఎండిన కర్రలా అయింది.<verse eid="LAM 4:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 4:9"/>కరువు వారిని దెబ్బతీసింది,</para>
  <para style="q2" vid="LAM 4:9">పంటలు పండవు.</para>
  <para style="q1" vid="LAM 4:9">ఈ బాధకు క్షీణించిపోయారు,</para>
  <para style="q2" vid="LAM 4:9">ఇంతకంటే ఖడ్గం చేత చావడం మహా భాగ్యం అనిపిస్తుంది.<verse eid="LAM 4:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 4:10"/>కనికరంగల స్త్రీలు</para>
  <para style="q2" vid="LAM 4:10">తమ సొంత చేతులతో తమ పిల్లలను వండుకున్నారు,</para>
  <para style="q1" vid="LAM 4:10">నా ప్రజలు నాశనమైనప్పుడు,</para>
  <para style="q2" vid="LAM 4:10">వారికి ఆహారం అయ్యారు.<verse eid="LAM 4:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 4:11"/>యెహోవా తన కోపాన్ని పూర్తిగా చల్లార్చారు.</para>
  <para style="q2" vid="LAM 4:11">ఆయన తన తీవ్రమైన కోపాన్ని కుమ్మరించాడు.</para>
  <para style="q1" vid="LAM 4:11">ఆయన సీయోనులో అగ్నిని రప్పించారు,</para>
  <para style="q2" vid="LAM 4:11">అది దాని పునాదులను దహించివేసింది.<verse eid="LAM 4:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 4:12"/>శత్రువులు, శత్రువులు</para>
  <para style="q2" vid="LAM 4:12">యెరూషలేము గుమ్మాల్లోకి ప్రవేశించవచ్చని</para>
  <para style="q1" vid="LAM 4:12">భూరాజులు నమ్మలేదు,</para>
  <para style="q2" vid="LAM 4:12">ప్రపంచంలోని జనాంగలెవరూ నమ్మలేదు.<verse eid="LAM 4:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 4:13"/>అయితే అది ఎందువల్ల జరిగిందంటే,</para>
  <para style="q2" vid="LAM 4:13">నీతిమంతుల రక్తాన్ని చిందించిన</para>
  <para style="q1" vid="LAM 4:13">దాని ప్రవక్తల పాపాల వల్ల,</para>
  <para style="q2" vid="LAM 4:13">దాని యాజకుల దోషాల వల్ల జరిగింది.<verse eid="LAM 4:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 4:14"/>ఇప్పుడు వారు గ్రుడ్డివారిలా</para>
  <para style="q2" vid="LAM 4:14">వీధుల్లో తడుముతూ తిరుగుతున్నారు.</para>
  <para style="q1" vid="LAM 4:14">వారు రక్తంతో ఎంతగా అపవిత్రం అయ్యారంటే,</para>
  <para style="q2" vid="LAM 4:14">వారి వస్త్రాలను తాకడానికి ఎవరూ సాహసించరు.<verse eid="LAM 4:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 4:15"/>“వెళ్లిపొండి! మీరు అపవిత్రులు!”</para>
  <para style="q2" vid="LAM 4:15">అని ప్రజలు గట్టిగా వారిమీద అరుస్తారు.</para>
  <para style="q2" vid="LAM 4:15">“దూరం! దూరం! మమ్మల్ని తాకవద్దు!”</para>
  <para style="q1" vid="LAM 4:15">అని వారు పారిపోయి, తిరుగులాడుతున్నప్పుడు,</para>
  <para style="q2" vid="LAM 4:15">దేశాల్లో ఉన్న ప్రజలు,</para>
  <para style="q2" vid="LAM 4:15">“వారు ఇకపై ఇక్కడ ఉండడానికి వీల్లేదు” అని అంటారు.<verse eid="LAM 4:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 4:16"/>యెహోవా తానే వారిని చెదరగొట్టారు;</para>
  <para style="q2" vid="LAM 4:16">ఆయన ఇకపై వారిని పట్టించుకోరు.</para>
  <para style="q1" vid="LAM 4:16">యాజకుల పట్ల ఇక గౌరవం చూపించరు,</para>
  <para style="q2" vid="LAM 4:16">పెద్దల పట్ల దయ చూపించరు.<verse eid="LAM 4:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 4:17"/>పైగా, సహాయం కోసం వ్యర్థంగా,</para>
  <para style="q2" vid="LAM 4:17">మేము మా గోపురాల నుండి;</para>
  <para style="q1" vid="LAM 4:17">మమ్మల్ని రక్షించలేని దేశం కోసం ఎదురుచూస్తూ</para>
  <para style="q2" vid="LAM 4:17">మా కళ్లు క్షీణించిపోయాయి.<verse eid="LAM 4:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 4:18"/>ప్రజలు అడుగడుగునా మమ్మల్ని పొంచి ఉన్నారు,</para>
  <para style="q2" vid="LAM 4:18">మేము మా వీధుల్లో నడవలేకపోయాము.</para>
  <para style="q1" vid="LAM 4:18">మా అంతం దగ్గరపడింది, మా రోజులు లెక్కించబడ్డాయి,</para>
  <para style="q2" vid="LAM 4:18">మా అంతం వచ్చింది.<verse eid="LAM 4:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 4:19"/>మమ్మల్ని వెంటాడుతున్నవారు</para>
  <para style="q2" vid="LAM 4:19">ఆకాశంలో ఎగిరే గ్రద్ద కంటే వేగంగా ఉన్నారు;</para>
  <para style="q1" vid="LAM 4:19">పర్వతాల మీదుగా మమల్ని వెంబడించి</para>
  <para style="q2" vid="LAM 4:19">ఎడారిలో మాకోసం వేచి ఉన్నారు.<verse eid="LAM 4:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 4:20"/>యెహోవా అభిషిక్తుడు, మన ప్రాణానికి ఊపిరి.</para>
  <para style="q2" vid="LAM 4:20">వారి ఉచ్చులో చిక్కుకున్నాడు.</para>
  <para style="q1" vid="LAM 4:20">ఆయన నీడలో</para>
  <para style="q2" vid="LAM 4:20">మనం ప్రజలమధ్య జీవిస్తాం అని అనుకున్నాము.<verse eid="LAM 4:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 4:21"/>ఎదోము కుమారీ,</para>
  <para style="q2" vid="LAM 4:21">ఊజు దేశంలో నివసిస్తున్నదానా, ఆనందించి సంతోషించు.</para>
  <para style="q1" vid="LAM 4:21">అయితే గిన్నె మీకు కూడా పంపబడుతుంది;</para>
  <para style="q2" vid="LAM 4:21">నీవు త్రాగి మత్తెక్కి వస్త్రాలు ఊడిపోయి నగ్నంగా ఉంటావు.<verse eid="LAM 4:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 4:22"/>సీయోను కుమారీ, నీ శిక్ష పూర్తి కాబోతుంది;</para>
  <para style="q2" vid="LAM 4:22">ఆయన మీ చెరను పొడిగించరు.</para>
  <para style="q1" vid="LAM 4:22">కానీ ఎదోము కుమారీ, ఆయన నీ పాపాన్ని శిక్షిస్తారు,</para>
  <para style="q2" vid="LAM 4:22">నీ దుర్మార్గాన్ని బట్టబయలు చేస్తారు.<verse eid="LAM 4:22"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="LAM 4"/>
  <chapter number="5" style="c" sid="LAM 5"/>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 5:1"/>యెహోవా, మాకు ఏమి జరిగిందో జ్ఞాపకముంచుకోండి;</para>
  <para style="q2" vid="LAM 5:1">మా వైపు తిరిగి, మాకు కలిగిన అవమానాన్ని చూడండి.<verse eid="LAM 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 5:2"/>మా వారసత్వం అపరిచితులకు,</para>
  <para style="q2" vid="LAM 5:2">మా ఇళ్ళను విదేశీయులకు అప్పగించారు.<verse eid="LAM 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 5:3"/>మేము తండ్రిలేని వారమయ్యాము,</para>
  <para style="q2" vid="LAM 5:3">మా తల్లులు విధవరాండ్రు.<verse eid="LAM 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 5:4"/>మేము త్రాగే నీటిని మేము కొనుక్కోవలసి వస్తుంది;</para>
  <para style="q2" vid="LAM 5:4">మేము కట్టెలు ఎక్కువ వెలపెట్టి కొనుక్కోవలసి వస్తుంది.<verse eid="LAM 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 5:5"/>మమ్మల్ని వెంటాడేవారు మా వెనుకే ఉన్నారు;</para>
  <para style="q2" vid="LAM 5:5">మేము అలసిపోయాము, కాని విశ్రాంతి దొరకడం లేదు.<verse eid="LAM 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 5:6"/>తగినంత ఆహారం పొందేందుకు మేము ఈజిప్టు, అష్షూరు వారివైపు</para>
  <para style="q2" vid="LAM 5:6">మేము మా చేతులు చాపాము.<verse eid="LAM 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 5:7"/>మా పూర్వికులు పాపం చేశారు, వారు చనిపోయారు,</para>
  <para style="q2" vid="LAM 5:7">వారి శిక్షను మేము భరిస్తున్నాము.<verse eid="LAM 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 5:8"/>బానిసలు మమ్మల్ని పరిపాలిస్తున్నారు,</para>
  <para style="q2" vid="LAM 5:8">వారి చేతుల్లో నుండి మమ్మల్ని విడిపించేవారు ఎవరూ లేరు.<verse eid="LAM 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 5:9"/>ఎడారిలో ఖడ్గం కారణంగా,</para>
  <para style="q2" vid="LAM 5:9">ప్రాణాలను పణంగా పెట్టి ఆహారం తెచ్చుకుంటున్నాము.<verse eid="LAM 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 5:10"/>ఆకలికి జ్వరంగా ఉండి,</para>
  <para style="q2" vid="LAM 5:10">మా చర్మం పొయ్యిలా వేడిగా అయ్యింది.<verse eid="LAM 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 5:11"/>సీయోనులో స్త్రీలు,</para>
  <para style="q2" vid="LAM 5:11">యూదా పట్టణాల్లో కన్యలు హింసించబడ్డారు.<verse eid="LAM 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 5:12"/>అధిపతుల చేతులు కట్టబడి, వ్రేలాడదీయబడ్డారు;</para>
  <para style="q2" vid="LAM 5:12">పెద్దలకు గౌరవం లేదు.<verse eid="LAM 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 5:13"/>యువకులు తిరుగటిరాళ్ల దగ్గర కష్టపడుతున్నారు;</para>
  <para style="q2" vid="LAM 5:13">బాలురు కట్టెల బరువు మోయలేక తూలుతున్నారు.<verse eid="LAM 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 5:14"/>పెద్దలు నగర ద్వారం నుండి వెళ్లిపోయారు,</para>
  <para style="q2" vid="LAM 5:14">యువకులు తమ సంగీతాన్ని ఆపివేశారు.<verse eid="LAM 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 5:15"/>మా హృదయాల్లో నుండి ఆనందం వెళ్లిపోయింది,</para>
  <para style="q2" vid="LAM 5:15">మా నాట్యం దుఃఖంగా మారింది.<verse eid="LAM 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 5:16"/>మా తల మీది నుండి కిరీటం పడిపోయింది,</para>
  <para style="q2" vid="LAM 5:16">పాపం చేశాము, మాకు శ్రమ.<verse eid="LAM 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 5:17"/>మా హృదయాలు ధైర్యం కోల్పోయాయి,</para>
  <para style="q2" vid="LAM 5:17">వీటిని బట్టి మా కళ్లు క్షీణిస్తున్నాయి<verse eid="LAM 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 5:18"/>సీయోను పర్వతం నిర్జనంగా పడి ఉంది,</para>
  <para style="q2" vid="LAM 5:18">నక్కలు దాని మీద విహరిస్తున్నాయి.<verse eid="LAM 5:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 5:19"/>యెహోవా, ఎప్పటికీ పాలించండి;</para>
  <para style="q2" vid="LAM 5:19">మీ సింహాసనం తరతరాలుగా ఉంటుంది.<verse eid="LAM 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 5:20"/>మీరు మమ్మల్ని ఎందుకు మరచిపోతారు?</para>
  <para style="q2" vid="LAM 5:20">ఇంతకాలం వరకు మమ్మల్ని ఎందుకు విడిచిపెట్టారు?<verse eid="LAM 5:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 5:21"/>యెహోవా, మేము తిరిగి వచ్చేలా, మమ్మల్ని మీ దగ్గరకు రప్పించుకోండి;</para>
  <para style="q2" vid="LAM 5:21">మీరు మమ్మల్ని పూర్తిగా తిరస్కరించి,<verse eid="LAM 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 5:22"/>మామీద చెప్పలేనంత కోపాన్ని పెంచుకుంటే తప్ప,</para>
  <para style="q2" vid="LAM 5:22">మా రోజులను పాత రోజుల్లా నూతనపర్చండి.<verse eid="LAM 5:22"/></para>
  <chapter eid="LAM 5"/>
</usx>
