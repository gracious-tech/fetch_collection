<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Biblica® Open Telugu Contemporary Version</book>
  <para style="h">2 యోహాను పత్రిక</para>
  <para style="toc1">యోహాను వ్రాసిన రెండవ పత్రిక</para>
  <para style="toc2">2 యోహాను పత్రిక</para>
  <para style="toc3">2 యోహాను</para>
  <para style="mt1">యోహాను</para>
  <para style="mt2">వ్రాసిన రెండవ పత్రిక</para>
  <chapter number="1" style="c" sid="2JN 1"/>
  <para style="po">
    <verse number="1" style="v" sid="2JN 1:1"/>పెద్దనైన నేను,</para>
  <para style="po" vid="2JN 1:1">దేవుని చేత ఏర్పరచబడిన అమ్మగారికి, ఆమె పిల్లలకు వ్రాయునది: సత్యంలో నేను మిమ్మల్ని ప్రేమిస్తున్నాను. నేను మాత్రమే కాదు, సత్యాన్ని ఎరిగిన వారందరు మిమ్మల్ని ప్రేమిస్తున్నారు. <verse eid="2JN 1:1"/><verse number="2" style="v" sid="2JN 1:2"/>మనలో నివసిస్తున్న, నిత్యం మనతోనే ఉండే సత్యాన్ని బట్టి వారు ప్రేమిస్తున్నారు.<verse eid="2JN 1:2"/></para>
  <para style="po">
    <verse number="3" style="v" sid="2JN 1:3"/>సత్యంలోను ప్రేమలోను తండ్రియైన దేవుని నుండి కుమారుడైన యేసు క్రీస్తు నుండి మనకు కృపా కనికరం సమాధానాలు మనతో ఉంటాయి.<verse eid="2JN 1:3"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4"/>తండ్రి మనకు ఆజ్ఞాపించిన విధంగా నీ బిడ్డలలో కొందరు సత్యంలో జీవించడం చూసి ఎంతో సంతోషించాను. <verse eid="2JN 1:4"/><verse number="5" style="v" sid="2JN 1:5"/>అమ్మా, నేను నీకు క్రొత్త ఆజ్ఞ వ్రాయడం లేదు కాని ఇది మొదటి నుండి మనకు ఉన్న ఆజ్ఞను బట్టి మనం ఒకరినొకరం ప్రేమించాలని అడుగుతున్నాను. <verse eid="2JN 1:5"/><verse number="6" style="v" sid="2JN 1:6"/>ప్రేమ అంటే మనం దేవుని ఆజ్ఞలకు లోబడి జీవించడమే. మొదటి నుండి మీరు వింటున్నట్లుగా మీరందరు ప్రేమలో జీవించాలి అనేదే ఆయన ఇచ్చిన ఆజ్ఞ.<verse eid="2JN 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7"/>ఇది నేను ఎందుకు చెప్తున్నానంటే, యేసు క్రీస్తు మనుష్యునిగా వచ్చారని ఒప్పుకొనని మోసగాళ్లు చాలామంది లోకంలో బయలుదేరారు. వారు క్రీస్తు విరోధులు. <verse eid="2JN 1:7"/><verse number="8" style="v" sid="2JN 1:8"/>మనం<note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="fq" closed="false">మనం </char><char style="ft" closed="false">కొ. ప్ర. లలో </char><char style="fqa" closed="false">మీరు</char></note> ఇంతవరకు దేనికోసం పని చేశామో దానిని కోల్పోకుండా మీ బహుమానాన్ని సంపూర్ణంగా పొందుకునేలా జాగ్రత్త వహించండి. <verse eid="2JN 1:8"/><verse number="9" style="v" sid="2JN 1:9"/>క్రీస్తు బోధలో కొనసాగకుండా దానిని విడిచి ముందుకు వెళ్లే వారికి దేవుడు లేడు; కాని బోధలో కొనసాగేవారు తండ్రిని, కుమారుని ఇరువురిని కలిగి ఉంటారు. <verse eid="2JN 1:9"/><verse number="10" style="v" sid="2JN 1:10"/>ఎవరైనా ఈ బోధను తీసుకురాకుండా మీ దగ్గరకు వస్తే, వారిని మీ ఇంట్లోకి తీసుకెళ్లవద్దు రమ్మనవద్దు. <verse eid="2JN 1:10"/><verse number="11" style="v" sid="2JN 1:11"/>వారిని రమ్మని ఆహ్వానించేవారు వారి చెడుపనులలో భాగం పంచుకొంటారు.<verse eid="2JN 1:11"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12"/>మీకు చాలా సంగతులు వ్రాయవలసి ఉంది, కాని సిరాతో కాగితంతో వ్రాయడం ఇష్టం లేదు. మన సంతోషం సంపూర్ణం కావడానికి, నేను మీ దగ్గరకు వచ్చి ముఖాముఖిగా మాట్లాడాలని నిరీక్షిస్తున్నాను.<verse eid="2JN 1:12"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13"/>దేవుని చేత ఏర్పరచబడిన నీ సహోదరి పిల్లలు నీకు వందనాలు చెప్తున్నారు.<verse eid="2JN 1:13"/></para>
  <chapter eid="2JN 1"/>
</usx>
