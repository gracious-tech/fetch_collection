<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1CH" style="id">- Biblica® Open Telugu Contemporary Version</book>
  <para style="h">1 దినవృత్తాంతములు</para>
  <para style="toc1">దినవృత్తాంతములు మొదటి గ్రంథం</para>
  <para style="toc2">1 దినవృత్తాంతములు</para>
  <para style="toc3">1 దిన</para>
  <para style="mt1">దినవృత్తాంతములు</para>
  <para style="mt2">మొదటి గ్రంథం</para>
  <chapter number="1" style="c" sid="1CH 1"/>
  <para style="s1">ఆదాము నుండి అబ్రాహాము వరకు చర్రిత వివరాలు</para>
  <para style="s2">నోవహు కుమారుల వరకు</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 1:1"/>ఆదాము, షేతు, ఎనోషు,<verse eid="1CH 1:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 1:2"/>కేయినాను, మహలలేలు, యెరెదు,<verse eid="1CH 1:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 1:3"/>హనోకు, మెతూషెల, లెమెకు,</para>
  <para style="li1" vid="1CH 1:3">నోవహు.<verse eid="1CH 1:3"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="4" style="v" sid="1CH 1:4"/>నోవహు కుమారులు:<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">కొ.ప్ర.లలో ఈ మాట లేదు</char></note> షేము, హాము, యాపెతు.<verse eid="1CH 1:4"/></para>
  <para style="s2">యాపెతీయులు</para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 1:5"/>యాపెతు కుమారులు<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">సంతతివారు </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">వారసులు </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">జనాంగాలు</char><char style="ft" closed="false">; <char style="xt" link-href="1CH 1:6-9"><ref loc="1CH 1:6">6-9</ref></char>, <char style="xt" link-href="1CH 1:17"><ref loc="1CH 1:17">17</ref></char>, <char style="xt" link-href="1CH 1:23"><ref loc="1CH 1:23">23</ref></char>.</char></note>:</para>
  <para style="li2" vid="1CH 1:5">గోమెరు, మాగోగు, మాదయి, యవాను, తుబాలు, మెషెకు, తీరసు.<verse eid="1CH 1:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 1:6"/>గోమెరు కుమారులు:</para>
  <para style="li2" vid="1CH 1:6">అష్కెనజు, రీఫతు<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">కొ. ప్ర. లలో </char><char style="fqa" closed="false">డీఫతు; <char style="xt"><ref loc="GEN 10:3">ఆది 10:3</ref></char> </char><char style="ft" closed="false">లో కూడా చూడండి</char></note>, తోగర్మా.<verse eid="1CH 1:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 1:7"/>యవాను కుమారులు:</para>
  <para style="li2" vid="1CH 1:7">ఎలీషా, తర్షీషు, కిత్తీము, దోదానీము.<verse eid="1CH 1:7"/></para>
  <para style="s2">హామీయులు</para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 1:8"/>హాము కుమారులు:</para>
  <para style="li2" vid="1CH 1:8">కూషు, ఈజిప్టు, పూతు, కనాను.<verse eid="1CH 1:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 1:9"/>కూషు కుమారులు:</para>
  <para style="li2" vid="1CH 1:9">సెబా, హవీలా, సబ్తా, రాయమా, సబ్తెకా.</para>
  <para style="li1" vid="1CH 1:9">రాయమా కుమారులు:</para>
  <para style="li2" vid="1CH 1:9">షేబ, దేదాను.<verse eid="1CH 1:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 1:10"/>కూషు నిమ్రోదుకు తండ్రి,</para>
  <para style="li2" vid="1CH 1:10">ఇతడు భూమిపై మొదటి బలమైన యోధుడు అయ్యాడు.<verse eid="1CH 1:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 1:11"/>ఈజిప్టు కుమారులు:</para>
  <para style="li2" vid="1CH 1:11">లూదీయులు, అనామీయులు, లెహాబీయులు, నఫ్తుహీయులు, <verse eid="1CH 1:11"/><verse number="12" style="v" sid="1CH 1:12"/>పత్రూసీయులు, కస్లూహీయులు (వీరినుండి ఫిలిష్తీయులు వచ్చారు) కఫ్తోరీయులు.<verse eid="1CH 1:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 1:13"/>కనాను కుమారులు:</para>
  <para style="li2" vid="1CH 1:13">మొదటి కుమారుడగు సీదోను,<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">సీదోనీయులు</char></note> హిత్తీయులు, <verse eid="1CH 1:13"/><verse number="14" style="v" sid="1CH 1:14"/>యెబూసీయులు, అమోరీయులు, గిర్గాషీయులు, <verse eid="1CH 1:14"/><verse number="15" style="v" sid="1CH 1:15"/>హివ్వీయులు, అర్కీయులు, సీనీయులు, <verse eid="1CH 1:15"/><verse number="16" style="v" sid="1CH 1:16"/>అర్వాదీయులు, సెమారీయులు, హమాతీయులు.<verse eid="1CH 1:16"/></para>
  <para style="s2">షేమీయులు</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 1:17"/>షేము కుమారులు:</para>
  <para style="li2" vid="1CH 1:17">ఏలాము, అష్షూరు, అర్పక్షదు, లూదు, అరాము.</para>
  <para style="li1" vid="1CH 1:17">అరాము కుమారులు:<note caller="+" style="f" category="dup"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false">కొ.ప్ర.లలో ఈ మాట లేదు</char></note></para>
  <para style="li2" vid="1CH 1:17">ఊజు, హూలు, గెతెరు, మెషెకు.<verse eid="1CH 1:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 1:18"/>అర్పక్షదు షేలహుకు తండ్రి,</para>
  <para style="li2" vid="1CH 1:18">షేలహు ఏబెరుకు తండ్రి.<verse eid="1CH 1:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 1:19"/>ఏబెరుకు ఇద్దరు కుమారులు పుట్టారు:</para>
  <para style="li2" vid="1CH 1:19">ఒకనికి పెలెగు అని పేరు పెట్టారు,<note caller="+" style="f"><char style="fr" closed="false">1:19 </char><char style="fq" closed="false">పెలెగు </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">విభజన</char></note> ఎందుకంటే అతని కాలంలోనే భూమి విభజింపబడింది; అతని సోదరునికి యొక్తాను అని పేరు పెట్టారు.<verse eid="1CH 1:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 1:20"/>యొక్తాను కుమారులు:</para>
  <para style="li2" vid="1CH 1:20">అల్మోదాదు, షెలపు, హసర్మావెతు, యెరహు, <verse eid="1CH 1:20"/><verse number="21" style="v" sid="1CH 1:21"/>హదోరము, ఊజాలు, దిక్లా, <verse eid="1CH 1:21"/><verse number="22" style="v" sid="1CH 1:22"/>ఓబాలు,<note caller="+" style="f"><char style="fr" closed="false">1:22 </char><char style="ft" closed="false">కొ.ప్ర.లలో </char><char style="fqa" closed="false">ఏబాలు</char></note> అబీమాయేలు, షేబ, <verse eid="1CH 1:22"/><verse number="23" style="v" sid="1CH 1:23"/>ఓఫీరు, హవీలా, యోబాబు. వీరందరు యొక్తాను కుమారులు.<verse eid="1CH 1:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 1:24"/>షేము, అర్పక్షదు, షేలహు,<verse eid="1CH 1:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 1:25"/>ఏబెరు, పెలెగు, రయూ,<verse eid="1CH 1:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 1:26"/>సెరూగు, నాహోరు, తెరహు,<verse eid="1CH 1:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 1:27"/>అబ్రాము (అనగా అబ్రాహాము).<verse eid="1CH 1:27"/></para>
  <para style="s1">అబ్రాహాము కుటుంబం</para>
  <para style="lh">
    <verse number="28" style="v" sid="1CH 1:28"/>అబ్రాహాము కుమారులు: ఇస్సాకు, ఇష్మాయేలు.<verse eid="1CH 1:28"/></para>
  <para style="s2">హాగరు ద్వారా వచ్చిన సంతానం</para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 1:29"/>వీరు వారి సంతానం:</para>
  <para style="li2" vid="1CH 1:29">ఇష్మాయేలు యొక్క మొదటి కుమారుడు నెబాయోతు, కేదారు, అద్బీయేలు, మిబ్శాము, <verse eid="1CH 1:29"/><verse number="30" style="v" sid="1CH 1:30"/>మిష్మా, దూమా, మశ్శా, హదదు, తేమా, <verse eid="1CH 1:30"/><verse number="31" style="v" sid="1CH 1:31"/>యెతూరు, నాపీషు, కెదెమా.</para>
  <para style="lf" vid="1CH 1:31">వీరు ఇష్మాయేలు కుమారులు.<verse eid="1CH 1:31"/></para>
  <para style="s2">కెతూరా ద్వారా వచ్చిన సంతానం</para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 1:32"/>అబ్రాహాము ఉంపుడుగత్తె కెతూరాకు పుట్టిన కుమారులు:</para>
  <para style="li2" vid="1CH 1:32">జిమ్రాను, యొక్షాను, మెదాను, మిద్యాను, ఇష్బాకు, షూవహు.</para>
  <para style="li1" vid="1CH 1:32">యొక్షాను కుమారులు:</para>
  <para style="li2" vid="1CH 1:32">షేబ, దేదాను.<verse eid="1CH 1:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 1:33"/>మిద్యాను కుమారులు:</para>
  <para style="li2" vid="1CH 1:33">ఏఫా, ఏఫెరు, హనోకు, అబీదా, ఎల్దాయా.</para>
  <para style="lf" vid="1CH 1:33">వీరంతా కెతూరా సంతానము.<verse eid="1CH 1:33"/></para>
  <para style="s2">శారా ద్వారా వచ్చిన సంతానం</para>
  <para style="lh">
    <verse number="34" style="v" sid="1CH 1:34"/>అబ్రాహాము కుమారుడు ఇస్సాకు.</para>
  <para style="li1" vid="1CH 1:34">ఇస్సాకు కుమారులు:</para>
  <para style="li2" vid="1CH 1:34">ఏశావు, ఇశ్రాయేలు.<verse eid="1CH 1:34"/></para>
  <para style="s1">ఏశావు సంతానం</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 1:35"/>ఏశావు కుమారులు:</para>
  <para style="li2" vid="1CH 1:35">ఎలీఫజు, రెయూయేలు, యూషు, యాలాము, కోరహు.<verse eid="1CH 1:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 1:36"/>ఎలీఫజు కుమారులు:</para>
  <para style="li2" vid="1CH 1:36">తేమాను, ఓమారు, సెఫో,<note caller="+" style="f"><char style="fr" closed="false">1:36 </char><char style="ft" closed="false">చాలా హెబ్రీ ప్రతులలో </char><char style="fqa" closed="false">సెఫీ</char></note> గాతాము, కనజు;</para>
  <para style="li2" vid="1CH 1:36">తిమ్నా ద్వారా అమాలేకు.<note caller="+" style="f"><char style="fr" closed="false">1:36 </char><char style="ft" closed="false">కొ.ప్ర.లలో </char><char style="fqa" closed="false">గాతాము, కెనజు, తిమ్నా, అమాలేకు</char></note><verse eid="1CH 1:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 1:37"/>రెయూయేలు కుమారులు:</para>
  <para style="li2" vid="1CH 1:37">నహతు, జెరహు, షమ్మా, మిజ్జ.<verse eid="1CH 1:37"/></para>
  <para style="s2">ఎదోములో ఉన్న శేయీరు వంశావళి</para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 1:38"/>శేయీరు కుమారులు:</para>
  <para style="li2" vid="1CH 1:38">లోతాను, శోబాలు, సిబ్యోను, అనా, దిషోను, ఏసెరు, దిషాను.<verse eid="1CH 1:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 1:39"/>లోతాను కుమారులు:</para>
  <para style="li2" vid="1CH 1:39">హోరీ, హోమాము. లోతాను సోదరి తిమ్నా.<verse eid="1CH 1:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 1:40"/>శోబాలు కుమారులు:</para>
  <para style="li2" vid="1CH 1:40">అల్వాను,<note caller="+" style="f"><char style="fr" closed="false">1:40 </char><char style="ft" closed="false">చాలా హెబ్రీ ప్రతులలో, కొ. ప్ర. లలో </char><char style="fqa" closed="false">అలియాను</char></note> మనహతు, ఏబాలు, షెఫో, ఓనాము.</para>
  <para style="li1" vid="1CH 1:40">సిబ్యోను కుమారులు:</para>
  <para style="li2" vid="1CH 1:40">అయ్యా, అనా.<verse eid="1CH 1:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 1:41"/>అనా కుమారుడు:</para>
  <para style="li2" vid="1CH 1:41">దిషోను.</para>
  <para style="li1" vid="1CH 1:41">దిషోను కుమారులు:</para>
  <para style="li2" vid="1CH 1:41">హెమ్దాను,<note caller="+" style="f"><char style="fr" closed="false">1:41 </char><char style="ft" closed="false">చాలా హెబ్రీ ప్రతులలో, కొ. ప్ర. లలో </char><char style="fqa" closed="false">హమ్రాను</char></note> ఎష్బాను, ఇత్రాను, కెరాను.<verse eid="1CH 1:41"/></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 1:42"/>ఏసెరు కుమారులు:</para>
  <para style="li2" vid="1CH 1:42">బిల్హాను, జవాను, ఆకాను.<note caller="+" style="f"><char style="fr" closed="false">1:42 </char><char style="ft" closed="false">చాలా హెబ్రీ ప్రతులలో, కొ.ప్ర.లలో </char><char style="fqa" closed="false">యహకాను</char></note></para>
  <para style="li1" vid="1CH 1:42">దిషాను<note caller="+" style="f"><char style="fr" closed="false">1:42 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 36:26">ఆది 36:26</ref></char> హెబ్రీ </char><char style="fqa" closed="false">దిషోను, </char><char style="ft" closed="false">ఇంకో విధంగా </char><char style="fq" closed="false">దిషాను</char></note> కుమారులు:</para>
  <para style="li2" vid="1CH 1:42">ఊజు, అరాను.<verse eid="1CH 1:42"/></para>
  <para style="s2">ఎదోము పాలకులు</para>
  <para style="lh">
    <verse number="43" style="v" sid="1CH 1:43"/>ఏ రాజు ఇశ్రాయేలీయులను పరిపాలించక ముందు ఎదోమును పరిపాలించిన రాజులు వీరు:</para>
  <para style="li1" vid="1CH 1:43">బెయోరు కుమారుడైన బేల, అతని పట్టణానికి దిన్హాబా అని పేరు.<verse eid="1CH 1:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 1:44"/>బేల చనిపోయిన తర్వాత, జెరహు కుమారుడు బొస్రావాడైన యోబాబు అతని స్థానంలో రాజయ్యాడు.<verse eid="1CH 1:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 1:45"/>యోబాబు చనిపోయిన తర్వాత, తేమానీయుల దేశస్థుడైన హుషాము అతని స్థానంలో రాజయ్యాడు.<verse eid="1CH 1:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 1:46"/>హుషాము చనిపోయిన తర్వాత, మోయాబు దేశంలో మిద్యానీయులను ఓడించిన బెదెదు కుమారుడైన హదదు అతని స్థానంలో రాజయ్యాడు. అతని పట్టణానికి అవీతు అని పేరు పెట్టబడింది.<verse eid="1CH 1:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 1:47"/>హదదు చనిపోయిన తర్వాత, మశ్రేకావాడైన శమ్లా అతని స్థానంలో రాజయ్యాడు.<verse eid="1CH 1:47"/></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 1:48"/>శమ్లా చనిపోయిన తర్వాత, నది తీరాన ఉన్న రహెబోతువాడైన షావూలు అతని స్థానంలో రాజయ్యాడు.<verse eid="1CH 1:48"/></para>
  <para style="li1">
    <verse number="49" style="v" sid="1CH 1:49"/>షావూలు చనిపోయిన తర్వాత, అక్బోరు కుమారుడైన బయల్-హనాను అతని స్థానంలో రాజయ్యాడు.<verse eid="1CH 1:49"/></para>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 1:50"/>బయల్-హనాను చనిపోయిన తర్వాత, హదదు అతని స్థానంలో రాజయ్యాడు. అతని పట్టణం పేరు పాయు. అతని భార్యపేరు మెహెతబేలు,<note caller="+" style="f"><char style="fr" closed="false">1:50 </char><char style="ft" closed="false">చాలా హెబ్రీ ప్రతులలో, కొ.ప్ర.లలో </char><char style="fqa" closed="false">పాయి</char></note> ఈమె మే-జాహబ్ కుమార్తెయైన మత్రేదు కుమార్తె. <verse eid="1CH 1:50"/><verse number="51" style="v" sid="1CH 1:51"/>హదదు కూడా చనిపోయాడు.</para>
  <para style="b" vid="1CH 1:51"/>
  <para style="lh" vid="1CH 1:51">ఎదోము వంశ నాయకులు:</para>
  <para style="li1" vid="1CH 1:51">తిమ్నా, అల్వా, యతేతు, <verse eid="1CH 1:51"/><verse number="52" style="v" sid="1CH 1:52"/>ఒహోలీబామా, ఏలహు, పీనోను, <verse eid="1CH 1:52"/><verse number="53" style="v" sid="1CH 1:53"/>కనజు, తేమాను, మిబ్సారు, <verse eid="1CH 1:53"/><verse number="54" style="v" sid="1CH 1:54"/>మగ్దీయేలు, ఈరాము.</para>
  <para style="lf" vid="1CH 1:54">వీరు ఎదోము నాయకులు.<verse eid="1CH 1:54"/></para>
  <chapter eid="1CH 1"/>
  <chapter number="2" style="c" sid="1CH 2"/>
  <para style="s1">ఇశ్రాయేలు కుమారులు</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 2:1"/>ఇశ్రాయేలు కుమారులు: రూబేను, షిమ్యోను, లేవీ, యూదా, ఇశ్శాఖారు, జెబూలూను, <verse eid="1CH 2:1"/><verse number="2" style="v" sid="1CH 2:2"/>దాను, యోసేపు, బెన్యామీను, నఫ్తాలి, గాదు, ఆషేరు.<verse eid="1CH 2:2"/></para>
  <para style="s1">యూదా</para>
  <para style="s2">హెస్రోను కుమారుల వరకు</para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 2:3"/>యూదా కుమారులు:</para>
  <para style="li2" vid="1CH 2:3">ఏరు, ఓనాను, షేలా. ఈ ముగ్గురు కనానీయురాలైన బత్-షుయ కుమార్తెకు జన్మించారు.</para>
  <para style="li2" vid="1CH 2:3">యూదాకు మొదటి కుమారుడైన ఏరు యెహోవా దృష్టిలో చెడ్డవానిగా ఉన్నాడు కాబట్టి ఆయన వానిని చంపారు.<verse eid="1CH 2:3"/></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 2:4"/>యూదా కోడలు తామారు ద్వారా అతనికి పెరెసు, జెరహులు పుట్టారు.</para>
  <para style="lf" vid="1CH 2:4">యూదా కుమారులందరు మొత్తం అయిదుగురు.<verse eid="1CH 2:4"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 2:5"/>పెరెసు కుమారులు:</para>
  <para style="li2" vid="1CH 2:5">హెస్రోను, హామూలు.<verse eid="1CH 2:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 2:6"/>జెరహు కుమారులు:</para>
  <para style="li2" vid="1CH 2:6">జిమ్రీ, ఏతాను, హేమాను, కల్కోలు, దార.<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">చాలా హెబ్రీ ప్రతులలో, కొ.ప్ర.లలో </char><char style="fqa" closed="false">దార్దా</char></note> వీరు అయిదుగురు.<verse eid="1CH 2:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 2:7"/>కర్మీ కుమారుడు:</para>
  <para style="li2" vid="1CH 2:7">ఆకారు,<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="fq" closed="false">ఆకారు </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">శ్రమ</char><char style="ft" closed="false">; </char><char style="fq" closed="false">ఆకారు </char><char style="fqa" closed="false">యెహోషువ </char><char style="ft" closed="false">గ్రంథంలో ఆకాను అని పిలువబడింది.</char></note> అతడు ప్రత్యేకపరచబడిన వాటిని ముట్టకూడదని నిషేధించబడిన కొన్నిటిని తీసుకుని ఇశ్రాయేలుకు బాధను తీసుకువచ్చాడు.<verse eid="1CH 2:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 2:8"/>ఏతాను కుమారుడు:</para>
  <para style="li2" vid="1CH 2:8">అజర్యా.<verse eid="1CH 2:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 2:9"/>హెస్రోనుకు జన్మించిన కుమారులు:</para>
  <para style="li2" vid="1CH 2:9">యెరహ్మెయేలు, రాము, కాలేబు.<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="fq" closed="false">కాలేబు </char><char style="ft" closed="false">హెబ్రీలో </char><char style="fqa" closed="false">కెలూబై</char></note><verse eid="1CH 2:9"/></para>
  <para style="s2">హెస్రోను కుమారుడైన రాము నుండి</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 2:10"/>రాము కుమారుడు అమ్మీనాదాబు.</para>
  <para style="li1" vid="1CH 2:10">అమ్మీనాదాబు కుమారుడు నయస్సోను. అతడు యూదా ప్రజల నాయకుడు.<verse eid="1CH 2:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 2:11"/>నయస్సోను కుమారుడు శల్మాను.<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false">హెబ్రీలో </char><char style="fqa" closed="false">శల్మా</char></note></para>
  <para style="li1" vid="1CH 2:11">శల్మాను కుమారుడు బోయజు.<verse eid="1CH 2:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 2:12"/>బోయజు కుమారుడు ఓబేదు.</para>
  <para style="li1" vid="1CH 2:12">ఓబేదు కుమారుడు యెష్షయి.<verse eid="1CH 2:12"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 2:13"/>యెష్షయి కుమారులు:</para>
  <para style="li2" vid="1CH 2:13">మొదటివాడు ఏలీయాబు, రెండవవాడు అబీనాదాబు,</para>
  <para style="li2" vid="1CH 2:13">మూడవవాడు షిమ్యా, <verse eid="1CH 2:13"/><verse number="14" style="v" sid="1CH 2:14"/>నాలుగవవాడు నెతనేలు,</para>
  <para style="li2" vid="1CH 2:14">అయిదవవాడు రద్దయి, <verse eid="1CH 2:14"/><verse number="15" style="v" sid="1CH 2:15"/>ఆరవవాడు ఓజెము,</para>
  <para style="li2" vid="1CH 2:15">ఏడవవాడు దావీదు.<verse eid="1CH 2:15"/></para>
  <para style="li2">
    <verse number="16" style="v" sid="1CH 2:16"/>సెరూయా, అబీగయీలు వారి సహోదరీలు.</para>
  <para style="li3" vid="1CH 2:16">సెరూయా కుమారులు ముగ్గురు: అబీషై, యోవాబు, అశాహేలు.<verse eid="1CH 2:16"/></para>
  <para style="li3">
    <verse number="17" style="v" sid="1CH 2:17"/>అబీగయీలు అమాశా తల్లి. ఇష్మాయేలీయుడైన యెతెరు అమాశా తండ్రి.<verse eid="1CH 2:17"/></para>
  <para style="s2">హెస్రోను కుమారుడైన కాలేబు</para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 2:18"/>హెస్రోను కుమారుడైన కాలేబుకు అతని భార్య అజూబా ద్వారా (యెరీయోతు ద్వారా) పిల్లలు కలిగారు. ఆమె కుమారులు వీరు:</para>
  <para style="li2" vid="1CH 2:18">యేషెరు, షోబాబు, అర్దోను.<verse eid="1CH 2:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 2:19"/>అజూబా చనిపోయాక కాలేబు ఎఫ్రాతాను పెళ్ళి చేసుకున్నాడు, ఆమె ద్వారా అతనికి హూరు పుట్టాడు.<verse eid="1CH 2:19"/></para>
  <para style="li2">
    <verse number="20" style="v" sid="1CH 2:20"/>హూరు కుమారుడు ఊరి. ఊరి కుమారుడు బెసలేలు.<verse eid="1CH 2:20"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 2:21"/>తర్వాత, హెస్రోను అరవై సంవత్సరాల వయస్సులో గిలాదు తండ్రియైన మాకీరు కుమార్తెను పెళ్ళి చేసుకుని ఆమెతో శయనించినప్పుడు ఆమె ద్వారా అతనికి సెగూబు పుట్టాడు.<verse eid="1CH 2:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 2:22"/>సెగూబు కుమారుడు యాయీరు. యాయీరుకు గిలాదులో ఇరవై మూడు పట్టణాలున్నాయి.<verse eid="1CH 2:22"/></para>
  <para style="li2">
    <verse number="23" style="v" sid="1CH 2:23"/>(అయితే గెషూరు, అరాము, హవ్వోత్ యాయీరును,<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">యాయీరు పట్టణాలు </char><char style="fq" closed="false">స్వాధీనం చేసుకున్నారు</char></note> కెనాతును దానికి చెందిన పట్టణాలను మొత్తం అరవై పట్టణాలను వారి నుండి స్వాధీనం చేసుకున్నారు.)</para>
  <para style="lf" vid="1CH 2:23">వీరందరు గిలాదు తండ్రియైన మాకీరు సంతానము.<verse eid="1CH 2:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 2:24"/>కాలేబు ఎఫ్రాతాలో హెస్రోను చనిపోయిన తర్వాత, అతని భార్య అబీయా ద్వారా అతనికి తెకోవాకు తండ్రియైన అష్షూరు పుట్టాడు.<verse eid="1CH 2:24"/></para>
  <para style="s2">హెస్రోను కుమారుడైన యెరహ్మెయేలు</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 2:25"/>హెస్రోను మొదటి కుమారుడైన యెరహ్మెయేలు కుమారులు:</para>
  <para style="li2" vid="1CH 2:25">మొదటి వాడైన రాము, బూనా, ఓరెను, ఓజెము, అహీయా. <verse eid="1CH 2:25"/><verse number="26" style="v" sid="1CH 2:26"/>యెరహ్మెయేలుకు అటారా అనే మరో భార్య ఉంది. ఆమె ఓనాముకు తల్లి.<verse eid="1CH 2:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 2:27"/>యెరహ్మెయేలుకు మొదటి కుమారుడైన రాము కుమారులు:</para>
  <para style="li2" vid="1CH 2:27">మయజు, యామీను, ఏకెరు.<verse eid="1CH 2:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 2:28"/>ఓనాము కుమారులు:</para>
  <para style="li2" vid="1CH 2:28">షమ్మయి యాదా.</para>
  <para style="li1" vid="1CH 2:28">షమ్మయి కుమారులు:</para>
  <para style="li2" vid="1CH 2:28">నాదాబు, అబీషూరు. <verse eid="1CH 2:28"/><verse number="29" style="v" sid="1CH 2:29"/>అబీషూరు భార్యపేరు అబీహయిలు, ఆమె ద్వారా అతనికి అహ్బాను, మొలీదులు పుట్టారు.<verse eid="1CH 2:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 2:30"/>నాదాబు కుమారులు:</para>
  <para style="li2" vid="1CH 2:30">సెలెదు, అప్పయీము. సెలెదు పిల్లలు లేకుండానే చనిపోయాడు.<verse eid="1CH 2:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 2:31"/>అప్పయీము కుమారుడు:</para>
  <para style="li2" vid="1CH 2:31">ఇషీ, ఇషీ కుమారుడు షేషాను. షేషాను కుమారుడు అహ్లయి.<verse eid="1CH 2:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 2:32"/>షమ్మయి సోదరుడైన యాదా కుమారులు:</para>
  <para style="li2" vid="1CH 2:32">యెతెరు, యోనాతాను. యెతెరు పిల్లలు లేకుండానే చనిపోయాడు.<verse eid="1CH 2:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 2:33"/>యోనాతాను కుమారులు:</para>
  <para style="li2" vid="1CH 2:33">పేలెతు, జాజా.</para>
  <para style="lf" vid="1CH 2:33">వీరు యెరహ్మెయేలు సంతానము.<verse eid="1CH 2:33"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 2:34"/>షేషానుకు కుమారులు లేరు, కుమార్తెలే ఉన్నారు.</para>
  <para style="li2" vid="1CH 2:34">షేషానుకు ఈజిప్టు వాడైన యర్హా అనే సేవకుడున్నాడు. <verse eid="1CH 2:34"/><verse number="35" style="v" sid="1CH 2:35"/>షేషాను తన కుమార్తెను తన సేవకుడైన యర్హాకు ఇచ్చి పెళ్ళి చేశాడు. ఆమె ద్వారా అతనికి అత్తయి పుట్టాడు.<verse eid="1CH 2:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 2:36"/>అత్తయి కుమారుడు నాతాను,</para>
  <para style="li1" vid="1CH 2:36">నాతాను కుమారుడు జాబాదు,<verse eid="1CH 2:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 2:37"/>జాబాదు కుమారుడు ఎప్లాలు,</para>
  <para style="li1" vid="1CH 2:37">ఎప్లాలు కుమారుడు ఓబేదు,<verse eid="1CH 2:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 2:38"/>ఓబేదు కుమారుడు యెహు,</para>
  <para style="li1" vid="1CH 2:38">యెహు కుమారుడు అజర్యా,<verse eid="1CH 2:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 2:39"/>అజర్యా కుమారుడు హేలెస్సు,</para>
  <para style="li1" vid="1CH 2:39">హేలెస్సు కుమారుడు ఎల్యాశా,<verse eid="1CH 2:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 2:40"/>ఎల్యాశా కుమారుడు సిస్మాయీ,</para>
  <para style="li1" vid="1CH 2:40">సిస్మాయీ కుమారుడు షల్లూము,<verse eid="1CH 2:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 2:41"/>షల్లూము కుమారుడు యెకమ్యా,</para>
  <para style="li1" vid="1CH 2:41">యెకమ్యా కుమారుడు ఎలీషామా.<verse eid="1CH 2:41"/></para>
  <para style="s2">కాలేబు వంశస్థులు</para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 2:42"/>యెరహ్మెయేలు సోదరుడైన కాలేబు కుమారులు:</para>
  <para style="li2" vid="1CH 2:42">మొదటి కుమారుడు జీఫు తండ్రియైన మేషా,</para>
  <para style="li2" vid="1CH 2:42">హెబ్రోను తండ్రియైన మారేషా.<verse eid="1CH 2:42"/></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 2:43"/>హెబ్రోను కుమారులు:</para>
  <para style="li2" vid="1CH 2:43">కోరహు, తప్పూయ, రేకెము, షెమ.<verse eid="1CH 2:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 2:44"/>షెమ కుమారుడు రహము,</para>
  <para style="li2" vid="1CH 2:44">రహము కుమారుడు యోర్కెయాము.</para>
  <para style="li1" vid="1CH 2:44">రేకెము కుమారుడు షమ్మయి.<verse eid="1CH 2:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 2:45"/>షమ్మయి కుమారుడు మాయోను,</para>
  <para style="li2" vid="1CH 2:45">మాయోను కుమారుడు బేత్-సూరు.<verse eid="1CH 2:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 2:46"/>కాలేబు ఉంపుడుగత్తె ఏఫాకు పుట్టినవారు:</para>
  <para style="li2" vid="1CH 2:46">హారాను, మోజా, గాజేజు.</para>
  <para style="li2" vid="1CH 2:46">హారాను కుమారుడు గాజేజు.<verse eid="1CH 2:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 2:47"/>యహ్దయి కుమారులు:</para>
  <para style="li2" vid="1CH 2:47">రెగెము, యోతాము, గేషాను, పెలెటు, ఏఫా, షయపు.<verse eid="1CH 2:47"/></para>
  <para style="li1">
    <verse number="48" style="v" sid="1CH 2:48"/>కాలేబు ఉంపుడుగత్తె మయకాకు పుట్టినవారు:</para>
  <para style="li2" vid="1CH 2:48">షెబెరు, తిర్హనా.<verse eid="1CH 2:48"/></para>
  <para style="li2">
    <verse number="49" style="v" sid="1CH 2:49"/>ఆమెకు మద్మన్నా తండ్రియైన షయపు,</para>
  <para style="li2" vid="1CH 2:49">మక్బేనా, గిబియాలకు తండ్రియైన షెవా కూడా పుట్టారు.</para>
  <para style="li1" vid="1CH 2:49">కాలేబు కుమార్తె అక్సా.<verse eid="1CH 2:49"/></para>
  <para style="lf">
    <verse number="50" style="v" sid="1CH 2:50"/>వీరు కాలేబు సంతానము.</para>
  <para style="b" vid="1CH 2:50"/>
  <para style="li1" vid="1CH 2:50">ఎఫ్రాతా మొదటి కుమారుడైన హూరు కుమారులు:</para>
  <para style="li2" vid="1CH 2:50">కిర్యత్-యారీము తండ్రియైన శోబాలు, <verse eid="1CH 2:50"/><verse number="51" style="v" sid="1CH 2:51"/>బేత్లెహేము తండ్రియైన శల్మా, బేత్-గాదేరు తండ్రియైన హారేపు.<verse eid="1CH 2:51"/></para>
  <para style="li1">
    <verse number="52" style="v" sid="1CH 2:52"/>కిర్యత్-యారీము తండ్రియైన శోబాలు సంతానం:</para>
  <para style="li2" vid="1CH 2:52">హారోయే, మెనుహోతీయుల్లో సగం మంది, <verse eid="1CH 2:52"/><verse number="53" style="v" sid="1CH 2:53"/>కిర్యత్-యారీము వంశస్థులు: ఇత్రీయులు, పూతీయులు, షుమ్మాతీయులు, మిష్రాయీయులు. వీరినుండి సొరాతీయులు, ఎష్తాయులీయులు వచ్చారు.<verse eid="1CH 2:53"/></para>
  <para style="li1">
    <verse number="54" style="v" sid="1CH 2:54"/>శల్మా వారసులు:</para>
  <para style="li2" vid="1CH 2:54">బేత్లెహేము, నెటోపాతీయులు, అత్రోత్-బేత్-యోవాబు, మనహతీయుల్లో సగభాగంగా ఉన్న జారీయులు, <verse eid="1CH 2:54"/><verse number="55" style="v" sid="1CH 2:55"/>యబ్బేజులో నివసించే లేఖికుల<note caller="+" style="f"><char style="fr" closed="false">2:55 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">సోఫేరీయులు</char></note> వంశాలు: తిరాతీయులు, షిమ్యాతీయులు, శూకోతీయులు. వీరు రేకాబీయులకు తండ్రియైన హమాతుకు నుండి వచ్చిన కెనీయులు.<verse eid="1CH 2:55"/></para>
  <chapter eid="1CH 2"/>
  <chapter number="3" style="c" sid="1CH 3"/>
  <para style="s2">దావీదు కుమారులు</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 3:1"/>దావీదుకు హెబ్రోనులో పుట్టిన కుమారులు వీరు:</para>
  <para style="b" vid="1CH 3:1"/>
  <para style="li1" vid="1CH 3:1">యెజ్రెయేలుకు చెందిన అహీనోయముకు పుట్టిన అమ్నోను మొదటి కుమారుడు;</para>
  <para style="li1" vid="1CH 3:1">కర్మెలుకు చెందిన అబీగయీలుకు పుట్టిన దానియేలు రెండవ కుమారుడు;<verse eid="1CH 3:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 3:2"/>గెషూరు రాజైన తల్మయి కుమార్తెయైన మయకా కుమారుడైన అబ్షాలోము మూడవ కుమారుడు;</para>
  <para style="li1" vid="1CH 3:2">హగ్గీతు కుమారుడైన అదోనియా నాలుగవ కుమారుడు;<verse eid="1CH 3:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 3:3"/>అబీటలు కుమారుడైన షెఫట్యా అయిదవ కుమారుడు;</para>
  <para style="li1" vid="1CH 3:3">దావీదు భార్య ఎగ్లా ద్వారా పుట్టిన ఇత్రెయాము ఆరవ కుమారుడు.<verse eid="1CH 3:3"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="4" style="v" sid="1CH 3:4"/>ఈ ఆరుగురు దావీదుకు హెబ్రోనులో పుట్టినవారు. అక్కడ అతడు ఏడు సంవత్సరాల ఆరు నెలలు పరిపాలించాడు.</para>
  <para style="b" vid="1CH 3:4"/>
  <para style="b" vid="1CH 3:4"/>
  <para style="lh" vid="1CH 3:4">దావీదు యెరూషలేములో ముప్పై మూడు సంవత్సరాలు పరిపాలించాడు. <verse eid="1CH 3:4"/><verse number="5" style="v" sid="1CH 3:5"/>యెరూషలేములో అతనికి పుట్టినవారు వీరు:</para>
  <para style="b" vid="1CH 3:5"/>
  <para style="li1" vid="1CH 3:5">అమ్మీయేలు కుమార్తెయైన బత్షెబకు<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">కొ.ప్రా.ప్ర. లలో </char><char style="fqa" closed="false">బత్-షుయ <char style="xt"><ref loc="2SA 11:3">2 సమూ 11:3</ref></char></char></note> పుట్టిన షమ్మువ,<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">హెబ్రీలో </char><char style="fqa" closed="false">షిమ్యా </char><char style="fq" closed="false">షమ్మువ </char><char style="ft" closed="false">మరొక రూపం</char></note> షోబాబు, నాతాను, సొలొమోను అనే నలుగురు కుమారులు.<verse eid="1CH 3:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 3:6"/>ఇభారు, ఎలీషువ,<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="ft" closed="false">కొ.ప్ర.లలో </char><char style="fqa" closed="false">ఎలీషామా</char></note> ఎలీఫెలెతు, <verse eid="1CH 3:6"/><verse number="7" style="v" sid="1CH 3:7"/>నోగహు, నెఫెగు, యాఫీయ, <verse eid="1CH 3:7"/><verse number="8" style="v" sid="1CH 3:8"/>ఎలీషామా, ఎల్యాదా, ఎలీఫెలెతు. మొత్తం తొమ్మిదిమంది ఇతర కుమారులు.<verse eid="1CH 3:8"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="9" style="v" sid="1CH 3:9"/>ఉంపుడుగత్తెల ద్వారా దావీదుకు పుట్టిన కుమారులు కాకుండా వీరందరు దావీదు కుమారులు. తామారు వీరికి సోదరి.<verse eid="1CH 3:9"/></para>
  <para style="s2">యూదా రాజులు</para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 3:10"/>సొలొమోను కుమారుడు రెహబాము,</para>
  <para style="li1" vid="1CH 3:10">అతని కుమారుడు అబీయా,</para>
  <para style="li1" vid="1CH 3:10">అతని కుమారుడు ఆసా,</para>
  <para style="li1" vid="1CH 3:10">అతని కుమారుడు యెహోషాపాతు,<verse eid="1CH 3:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 3:11"/>అతని కుమారుడు యెహోరాము,<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false">హెబ్రీలో </char><char style="fqa" closed="false">యోరాము </char><char style="fq" closed="false">యెహోరాము </char><char style="ft" closed="false">యొక్క మరో పేరు</char></note></para>
  <para style="li1" vid="1CH 3:11">అతని కుమారుడు అహజ్యా,</para>
  <para style="li1" vid="1CH 3:11">అతని కుమారుడు యోవాషు,<verse eid="1CH 3:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 3:12"/>అతని కుమారుడు అమజ్యా,</para>
  <para style="li1" vid="1CH 3:12">అతని కుమారుడు అజర్యా,</para>
  <para style="li1" vid="1CH 3:12">అతని కుమారుడు యోతాము,<verse eid="1CH 3:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 3:13"/>అతని కుమారుడు ఆహాజు,</para>
  <para style="li1" vid="1CH 3:13">అతని కుమారుడు హిజ్కియా,</para>
  <para style="li1" vid="1CH 3:13">అతని కుమారుడు మనష్షే,<verse eid="1CH 3:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 3:14"/>అతని కుమారుడు ఆమోను,</para>
  <para style="li1" vid="1CH 3:14">అతని కుమారుడు యోషీయా.<verse eid="1CH 3:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 3:15"/>యోషీయా కుమారులు:</para>
  <para style="li2" vid="1CH 3:15">మొదటి కుమారుడు యోహానాను,</para>
  <para style="li2" vid="1CH 3:15">రెండవవాడు యెహోయాకీము,</para>
  <para style="li2" vid="1CH 3:15">మూడవవాడు సిద్కియా,</para>
  <para style="li2" vid="1CH 3:15">నాలుగవవాడు షల్లూము.<verse eid="1CH 3:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 3:16"/>యెహోయాకీము వారసులు:</para>
  <para style="li2" vid="1CH 3:16">యెహోయాకీను,<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="fqa" closed="false">యెకొన్యా </char><char style="fq" closed="false">యెహోయాకీను </char><char style="ft" closed="false">యొక్క మరొక పేరు</char></note></para>
  <para style="li2" vid="1CH 3:16">అతని సోదరుడు<note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="ft" closed="false">హెబ్రీలో </char><char style="fqa" closed="false">కుమారుడు, <char style="xt"><ref loc="2CH 36:10">2 దిన 36:10</ref></char> చూడండి</char></note> సిద్కియా.<verse eid="1CH 3:16"/></para>
  <para style="s2">చెర తర్వాత రాజ వంశస్థులు</para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 3:17"/>ఖైదీగా ఉన్న యెహోయాకీను సంతానం:</para>
  <para style="li2" vid="1CH 3:17">అతని కుమారుడు షయల్తీయేలు, <verse eid="1CH 3:17"/><verse number="18" style="v" sid="1CH 3:18"/>మల్కీరాము, పెదాయా, షెనజ్జరు, యెకమ్యా, హోషామా, నెదబ్యా.<verse eid="1CH 3:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 3:19"/>పెదాయా కుమారులు:</para>
  <para style="li2" vid="1CH 3:19">జెరుబ్బాబెలు, షిమీ.</para>
  <para style="li1" vid="1CH 3:19">జెరుబ్బాబెలు కుమారులు:</para>
  <para style="li2" vid="1CH 3:19">మెషుల్లాము, హనన్యా. షెలోమీతు వారికి సోదరి. <verse eid="1CH 3:19"/><verse number="20" style="v" sid="1CH 3:20"/>మరో అయిదుగురు కూడా ఉన్నారు: హషుబా, ఒహెలు, బెరెక్యా, హసద్యా, యూషబ్-హెసెదు.<verse eid="1CH 3:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 3:21"/>హనన్యా వారసులు:</para>
  <para style="li2" vid="1CH 3:21">పెలట్యా, యెషయా, రెఫాయా కుమారులు, అర్నాను కుమారులు, ఓబద్యా కుమారులు, షెకన్యా కుమారులు.<verse eid="1CH 3:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 3:22"/>షెకన్యా వారసులు:</para>
  <para style="li2" vid="1CH 3:22">షెమయా, అతని కుమారులు: హట్టూషు, ఇగాలు, బారియహు, నెయర్యా, షాపాతు మొత్తం ఆరుగురు.<verse eid="1CH 3:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 3:23"/>నెయర్యా కుమారులు:</para>
  <para style="li2" vid="1CH 3:23">ఎల్యోయేనై, హిజ్కియా, అజ్రీకాము మొత్తం ముగ్గురు.<verse eid="1CH 3:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 3:24"/>ఎల్యోయేనై కుమారులు:</para>
  <para style="li2" vid="1CH 3:24">హోదవ్యా, ఎల్యాషీబు, పెలాయా, అక్కూబు, యోహానాను, దెలాయ్యా, అనాని మొత్తం ఏడుగురు.<verse eid="1CH 3:24"/></para>
  <chapter eid="1CH 3"/>
  <chapter number="4" style="c" sid="1CH 4"/>
  <para style="s2">యూదా యొక్క ఇతర వంశాలు</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 4:1"/>యూదా వారసులు:</para>
  <para style="li2" vid="1CH 4:1">పెరెసు, హెస్రోను, కర్మీ, హూరు, శోబాలు.<verse eid="1CH 4:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 4:2"/>శోబాలు కుమారుడైన రెవాయాకు యహతు పుట్టాడు, యహతుకు అహూమై, లహదు పుట్టారు. ఇవి సొరాతీయుల వంశాలు.<verse eid="1CH 4:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 4:3"/>ఏతాము కుమారులు<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false">హెబ్రీలో </char><char style="fqa" closed="false">తండ్రి</char></note> వీరు:</para>
  <para style="li2" vid="1CH 4:3">యెజ్రెయేలు, ఇష్మా, ఇద్బాషు. వీరి సోదరి పేరు హజ్జెలెల్పోని. <verse eid="1CH 4:3"/><verse number="4" style="v" sid="1CH 4:4"/>గెదోరు తండ్రి పెనూయేలు, హూషా తండ్రి ఏజెరు.</para>
  <para style="li1" vid="1CH 4:4">వీరు హూరు సంతానం, బేత్లెహేముకు తండ్రియైన<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="fq" closed="false">తండ్రి </char><char style="ft" closed="false">బహుశ పాలకుడు </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">సైన్య అధికారి</char></note> ఎఫ్రాతాకు మొదటి కుమారుడు హూరు.<verse eid="1CH 4:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 4:5"/>తెకోవా తండ్రియైన అష్షూరుకు హెలా, నయరా అనే ఇద్దరు భార్యలున్నారు.<verse eid="1CH 4:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 4:6"/>నయరా వలన అతనికి అహుజాము, హెఫెరు, తేమనీ, హాయహష్తారీ పుట్టారు. వీరు నయరా సంతానము.<verse eid="1CH 4:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 4:7"/>హెలా కుమారులు:</para>
  <para style="li2" vid="1CH 4:7">జెరెతు, సోహరు, ఎత్నాను, <verse eid="1CH 4:7"/><verse number="8" style="v" sid="1CH 4:8"/>అనూబు, హజోబేబా, హారూము కుమారుడైన అహర్హేలు వంశాలకు తండ్రియైన కోజు.<verse eid="1CH 4:8"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="9" style="v" sid="1CH 4:9"/>యబ్బేజు<note caller="+" style="f"><char style="fr" closed="false">4:9 </char><char style="fq" closed="false">యబ్బేజు </char><char style="ft" closed="false">హెబ్రీ పదంలా ఉంది </char><char style="fqa" closed="false">వేదన </char><char style="ft" closed="false">అని అర్థం</char></note> తన సోదరులకంటే ఘనత పొందాడు. అతని తల్లి, “వేదనతో ఇతన్ని కన్నాను” అని చెప్పి అతనికి యబ్బేజు అని పేరు పెట్టింది. <verse eid="1CH 4:9"/><verse number="10" style="v" sid="1CH 4:10"/>యబ్బేజు ఇశ్రాయేలు దేవునికి మొరపెట్టి, “మీరు నన్ను ఖచ్చితంగా దీవించి నా సరిహద్దులను విశాలపరచండి! మీ చేయి నాకు తోడుగా ఉంచి, నాకు బాధ కలుగకుండా కీడు నుండి నన్ను తప్పించండి” అని ప్రార్థించాడు. దేవుడు అతని మనవి అంగీకరించి దాని ప్రకారం జరిగించారు.<verse eid="1CH 4:10"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 4:11"/>కెలూబు షూవహుకు సోదరుడు మెహీరుకు తండ్రి, మెహీరు ఎష్తోనుకు తండ్రి. <verse eid="1CH 4:11"/><verse number="12" style="v" sid="1CH 4:12"/>ఎష్తోను బేత్-రాఫాకు పాసెయకు ఈర్-నహాషు<note caller="+" style="f"><char style="fr" closed="false">4:12 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">నాహాషు పట్టణం</char></note> తండ్రియైన తెహిన్నాకు తండ్రి. వీరు రేకా వారసులు.<verse eid="1CH 4:12"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 4:13"/>కెనజు కుమారులు:</para>
  <para style="li2" vid="1CH 4:13">ఒత్నీయేలు, శెరాయా.</para>
  <para style="li1" vid="1CH 4:13">ఒత్నీయేలు కుమారులు:</para>
  <para style="li2" vid="1CH 4:13">హతతు, మెయానొతై.<note caller="+" style="f"><char style="fr" closed="false">4:13 </char><char style="ft" closed="false">కొ.ప్ర.లలో </char><char style="fq" closed="false">మెయానొతై </char><char style="ft" closed="false">లేదు</char></note> <verse eid="1CH 4:13"/><verse number="14" style="v" sid="1CH 4:14"/>మెయానొతై ఒఫ్రాకు తండ్రి.</para>
  <para style="li1" vid="1CH 4:14">శెరాయా యోవాబుకు తండ్రి,</para>
  <para style="li2" vid="1CH 4:14">యోవాబు గె-హరషీముకు<note caller="+" style="f"><char style="fr" closed="false">4:14 </char><char style="fq" closed="false">గె-హరషీము </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">నిపుణులైన పనివారు గల లోయ</char></note> తండ్రి, ఆ ప్రాంతంలో నిపుణులైన పనివారు ఉండేవారు కాబట్టి అలా పిలువబడింది.<verse eid="1CH 4:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 4:15"/>యెఫున్నె కుమారుడైన కాలేబు కుమారులు:</para>
  <para style="li2" vid="1CH 4:15">ఈరూ, ఏలా, నయము,</para>
  <para style="li1" vid="1CH 4:15">ఏలా కుమారుడు:</para>
  <para style="li2" vid="1CH 4:15">కనజు.<verse eid="1CH 4:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 4:16"/>యెహల్లెలేలు కుమారులు:</para>
  <para style="li2" vid="1CH 4:16">జీఫు జీఫా, తీర్యా, అశర్యేలు.<verse eid="1CH 4:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 4:17"/>ఎజ్రా కుమారులు:</para>
  <para style="li2" vid="1CH 4:17">యెతెరు, మెరెదు, ఏఫెరు, యాలోను.</para>
  <para style="li1" vid="1CH 4:17">మెరెదు భార్యల్లో ఒకరికి పుట్టిన వారు మిర్యాము, షమ్మయి, ఎష్టెమో తండ్రియైన ఇష్బాహు. <verse eid="1CH 4:17"/><verse number="18" style="v" sid="1CH 4:18"/>మెరెదు పెళ్ళి చేసుకున్న ఫరో కుమార్తెయైన బిత్యా ద్వారా పుట్టిన కుమారులు వీరే.</para>
  <para style="li1" vid="1CH 4:18">యూదు గోత్రీకురాలైన అతని భార్యకు గెదోరు తండ్రియైన యెరెదు, శోకోకు తండ్రియైన హెబెరు, జానోహ తండ్రియైన యెకూతీయేలు పుట్టారు.<verse eid="1CH 4:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 4:19"/>నహము సోదరియైన హూదీయా భార్యకు పుట్టిన కుమారులు:</para>
  <para style="li2" vid="1CH 4:19">గర్మీయుడైన కెయీలా తండ్రి, మయకాతీయుడైన ఎష్టెమో.<verse eid="1CH 4:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 4:20"/>షీమోను కుమారులు:</para>
  <para style="li2" vid="1CH 4:20">అమ్నోను, రిన్నా, బెన్-హనాను, తీలోను.</para>
  <para style="li1" vid="1CH 4:20">ఇషీ సంతానం:</para>
  <para style="li2" vid="1CH 4:20">జోహేతు, బెన్-జోహేతు.<verse eid="1CH 4:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 4:21"/>యూదా కుమారుడైన షేలా కుమారులు:</para>
  <para style="li2" vid="1CH 4:21">లేకా తండ్రియైన ఏరు, మరేషా తండ్రియైన లద్దా, సన్నని నారబట్టలు నేసే బేత్-అష్బేయ వంశీకులు,<verse eid="1CH 4:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 4:22"/>యోకీము, కోజేబా వారు, యోవాషు, శారాపు, మోయాబులో, యాషూబిలెహెములో పరిపాలన చేశారు. (ఇవి పూర్వకాలంలో వ్రాసి పెట్టిన సంగతులు.) <verse eid="1CH 4:22"/><verse number="23" style="v" sid="1CH 4:23"/>వారు నెతాయీములో, గెదేరాలో నివసించిన కుమ్మరులు. వారు అక్కడే నివసించి రాజు కోసం పని చేశారు.<verse eid="1CH 4:23"/></para>
  <para style="s1">షిమ్యోను</para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 4:24"/>షిమ్యోను వారసులు:</para>
  <para style="li2" vid="1CH 4:24">నెమూయేలు, యామీను, యారీబు, జెరహు, షావూలు;<verse eid="1CH 4:24"/></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 4:25"/>షావూలు కుమారుడు షల్లూము, షల్లూము కుమారుడు మిబ్శాము, మిబ్శాము కుమారుడు మిష్మా.<verse eid="1CH 4:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 4:26"/>మిష్మా సంతానం:</para>
  <para style="li2" vid="1CH 4:26">మిష్మా కుమారుడు హమ్మూయేలు, అతని కుమారుడు జక్కూరు, అతని కుమారుడు షిమీ.<verse eid="1CH 4:26"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="27" style="v" sid="1CH 4:27"/>షిమీకి పదహారుగురు కుమారులు, ఆరుగురు కుమార్తెలు ఉన్నారు కాని అతని సోదరులకు ఎక్కువ మంది పిల్లలు లేరు; కాబట్టి యూదా వారు వృద్ధి చెందినట్లుగా వారి వంశం మొత్తం వృద్ధి చెందలేదు. <verse eid="1CH 4:27"/><verse number="28" style="v" sid="1CH 4:28"/>వారు బెయేర్షేబ, మొలాదా, హజర్-షువలు, <verse eid="1CH 4:28"/><verse number="29" style="v" sid="1CH 4:29"/>బిల్హా, ఎజెము, తోలాదు, <verse eid="1CH 4:29"/><verse number="30" style="v" sid="1CH 4:30"/>బెతూయేలు, హోర్మా, సిక్లగు, <verse eid="1CH 4:30"/><verse number="31" style="v" sid="1CH 4:31"/>బేత్-మర్కాబోతు, హజర్-సూసీము, బేత్-బీరి, షరాయిము అనే పట్టణాల్లో నివసించారు. దావీదు పరిపాలన వరకు వారి పట్టణాలు ఇవే. <verse eid="1CH 4:31"/><verse number="32" style="v" sid="1CH 4:32"/>ఏతాము, ఆయిను, రిమ్మోను, తోకెను, ఆషాను అనే అయిదు గ్రామాలు వారి చుట్టూ ఉండేవి, <verse eid="1CH 4:32"/><verse number="33" style="v" sid="1CH 4:33"/>బయలు<note caller="+" style="f"><char style="fr" closed="false">4:33 </char><char style="ft" closed="false">కొ.ప్ర.లలో </char><char style="fqa" closed="false">బాలతు</char></note> వరకు ఆ పట్టణాల చుట్టూ ఉన్న గ్రామాలన్నీ వారివి. ఇవి వారి నివాసస్థలాలు.</para>
  <para style="b" vid="1CH 4:33"/>
  <para style="lh" vid="1CH 4:33">వారు తమ వంశాలను నమోదు చేసి ఉంచారు:<verse eid="1CH 4:33"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 4:34"/>మెషోబాబు, యమ్లేకు;</para>
  <para style="li1" vid="1CH 4:34">అమజ్యా కుమారుడైన యోషా; <verse eid="1CH 4:34"/><verse number="35" style="v" sid="1CH 4:35"/>యోవేలు;</para>
  <para style="li1" vid="1CH 4:35">అశీయేలు కుమారుడైన శెరాయాకు పుట్టిన యోషిబ్యా కుమారుడు యెహు;<verse eid="1CH 4:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 4:36"/>ఎల్యోయేనై; యహకోబా; యెషోహాయా;</para>
  <para style="li1" vid="1CH 4:36">అశాయా; అదీయేలు; యెశీమీయేలు; బెనాయా;<verse eid="1CH 4:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 4:37"/>షెమయా కుమారుడైన షిమ్రీకి పుట్టిన యెదాయా కుమారుడైన అల్లోనుకు పుట్టిన షిపి కుమారుడు జీజా.<verse eid="1CH 4:37"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="38" style="v" sid="1CH 4:38"/>పైన పేర్లు పేర్కొన్న వారు తమ తమ వంశాలకు నాయకులు.</para>
  <para style="b" vid="1CH 4:38"/>
  <para style="p" vid="1CH 4:38">వీరి కుటుంబాలన్నీ ఎంతో అభివృద్ధి చెందాయి, <verse eid="1CH 4:38"/><verse number="39" style="v" sid="1CH 4:39"/>వారు తమ మందల కోసం మేత వెదకడానికి లోయలో తూర్పుగా ఉన్న గెదోరు పొలిమేర వరకు వెళ్లారు. <verse eid="1CH 4:39"/><verse number="40" style="v" sid="1CH 4:40"/>వారికి అక్కడ మంచి పుష్టికరమైన మేత దొరికింది. ఆ ప్రాంతం విశాలంగా, నెమ్మదిగా, ప్రశాంతంగా ఉంది. గతంలో హాము వంశీయులు కొంతమంది అక్కడ నివసించారు.<verse eid="1CH 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="1CH 4:41"/>జాబితాలో పేర్లు వ్రాయబడిన వీరు యూదా రాజైన హిజ్కియా కాలంలో అక్కడికి వచ్చారు. అక్కడ ఉన్న హాము వంశీయుల మెయునీయుల నివాసాలపై దాడి చేసి వారిని పూర్తిగా నాశనం చేసి, ఈ రోజు వరకు వారు అక్కడే స్థిరపడ్డారు, ఎందుకంటే వారి మందలకు సరిపోయేంత పచ్చిక అక్కడ ఉంది. <verse eid="1CH 4:41"/><verse number="42" style="v" sid="1CH 4:42"/>ఈ షిమ్యోను వంశీయులలో అయిదువందల మంది శేయీరు కొండ ప్రాంతాన్ని ఆక్రమించుకున్నారు. ఇషీ కుమారులైన పెలట్యా, నెయర్యా, రెఫాయా, ఉజ్జీయేలు వారికి నాయకులు. <verse eid="1CH 4:42"/><verse number="43" style="v" sid="1CH 4:43"/>అమాలేకీయులలో తప్పించుకున్న మిగిలిన వారందరిని చంపి, ఈ రోజు వరకు వారక్కడ నివసించారు.<verse eid="1CH 4:43"/></para>
  <chapter eid="1CH 4"/>
  <chapter number="5" style="c" sid="1CH 5"/>
  <para style="s1">రూబేను</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 5:1"/>ఇశ్రాయేలు మొదటి కుమారుడైన రూబేను కుమారులు. (అతడు మొదటి కుమారుడు, కాని అతడు తన తండ్రి పడక ఎక్కి దాన్ని అపవిత్రం చేశాడు కాబట్టి, అతని జ్యేష్ఠత్వపు హక్కులు ఇశ్రాయేలు కుమారుడైన యోసేపు కుమారులకు ఇవ్వబడ్డాయి; కాబట్టి జన్మహక్కుల ప్రకారం వంశావళిలో అతడు నమోదు కాలేదు. <verse eid="1CH 5:1"/><verse number="2" style="v" sid="1CH 5:2"/>యూదా తన అన్నదమ్ములకంటే బలవంతుడు, అతని వంశంలో నుండి పరిపాలకుడు వచ్చాడు, అయినా కూడా జ్యేష్ఠత్వపు హక్కులు యోసేపుకు వచ్చాయి.) <verse eid="1CH 5:2"/><verse number="3" style="v" sid="1CH 5:3"/>ఇశ్రాయేలు మొదటి కుమారుడైన రూబేను కుమారులు వీరు:</para>
  <para style="b" vid="1CH 5:3"/>
  <para style="li2" vid="1CH 5:3">హనోకు, పల్లు, హెస్రోను, కర్మీ.<verse eid="1CH 5:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 5:4"/>యోవేలు సంతానం:</para>
  <para style="li2" vid="1CH 5:4">అతని కుమారుడు షెమయా, అతని కుమారుడు గోగు,</para>
  <para style="li2" vid="1CH 5:4">అతని కుమారుడు షిమీ, <verse eid="1CH 5:4"/><verse number="5" style="v" sid="1CH 5:5"/>అతని కుమారుడు మీకా,</para>
  <para style="li2" vid="1CH 5:5">అతని కుమారుడు రెవాయా, అతని కుమారుడు బయలు,<verse eid="1CH 5:5"/></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 5:6"/>అతని కుమారుడు బెయేర, ఇతన్ని అష్షూరు రాజైన తిగ్లత్-పిలేసెరు<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">తిగ్లత్-పిలేసెరు</char></note> బందీగా తీసుకెళ్లాడు. బెయేర రూబేనీయులకు నాయకుడు.<verse eid="1CH 5:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 5:7"/>వారి వంశావళిలో పేర్కొన్న కుటుంబాల ప్రకారం వారి బంధువులు:</para>
  <para style="li2" vid="1CH 5:7">నాయకుడైన యెహీయేలు, జెకర్యా, <verse eid="1CH 5:7"/><verse number="8" style="v" sid="1CH 5:8"/>యోవేలు కుమారుడైన షెమ కుమారుడైన ఆజాజు కుమారుడైన బేల.</para>
  <para style="b" vid="1CH 5:8"/>
  <para style="p" vid="1CH 5:8">వారు అరోయేరు నుండి నెబో వరకు, బయల్-మెయోను వరకు నివసించారు. <verse eid="1CH 5:8"/><verse number="9" style="v" sid="1CH 5:9"/>వారి పశువులు గిలాదులో విస్తారంగా వృద్ధిచెందడంతో, తూర్పున యూఫ్రటీసు నది దగ్గర నుండి ఎడారి సరిహద్దు వరకు వారు నివసించారు.<verse eid="1CH 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 5:10"/>సౌలు పాలిస్తున్నప్పుడు వారు హగ్రీయీలతో యుద్ధం చేసి వారిని ఓడించారు. వారు గిలాదుకు తూర్పుగా ఉన్న ప్రాంతమంతటిలో ఉన్న హగ్రీయీల నివాస స్థలాలను స్వాధీనం చేసుకున్నారు.<verse eid="1CH 5:10"/></para>
  <para style="s1">గాదు</para>
  <para style="lh">
    <verse number="11" style="v" sid="1CH 5:11"/>గాదీయులు వారికి ఎదురుగా బాషానులో సలేకా వరకు నివసించారు.<verse eid="1CH 5:11"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 5:12"/>వారికి యోవేలు నాయకుడు. అతని తర్వాత షాపాము, తర్వాత యహనై, షాపాతు, వీరు బాషానులో ఉండేవారు.<verse eid="1CH 5:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 5:13"/>వారి కుటుంబాల ప్రకారం వారి బంధువులు:</para>
  <para style="li2" vid="1CH 5:13">మిఖాయేలు, మెషుల్లాము, షేబ, యోరై, యకాను, జీయ, ఏబెరు మొత్తం ఏడుగురు.<verse eid="1CH 5:13"/></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 5:14"/>వీరు హూరీ కుమారుడైన అబీహయిలు కుమారులు: హూరీ యరోయ కుమారుడు, యరోయ గిలాదు కుమారుడు, గిలాదు మిఖాయేలు కుమారుడు, మిఖాయేలు యెషీషై కుమారుడు, యెషీషై యహదో కుమారుడు, యహదో బూజు కుమారుడు.<verse eid="1CH 5:14"/></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 5:15"/>గూనీ కుమారుడైన అబ్దీయేలుకు పుట్టిన అహీ వారి కుటుంబ పెద్ద.<verse eid="1CH 5:15"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="16" style="v" sid="1CH 5:16"/>గాదు వంశస్థులు బాషానులో గిలాదులో, చుట్టుప్రక్కల గ్రామాల్లో, షారోను సరిహద్దుల వరకు ఉన్న పచ్చని మైదానాల్లో నివసించారు.<verse eid="1CH 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 5:17"/>వీరందరు యూదా రాజైన యోతాము రోజుల్లో ఇశ్రాయేలు రాజైన యరొబాము రోజుల్లో వంశావళి పత్రాలలో నమోదయ్యారు.<verse eid="1CH 5:17"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="18" style="v" sid="1CH 5:18"/>రూబేనీయులు, గాదీయులు, మనష్షే అర్థగోత్రం వారిలో డాలు కత్తి పట్టుకోవడంలో నేర్పుగలవారు, విల్లు ఉపయోగించగలవారు, యుద్ధశిక్షణ తీసుకున్నవారు 44,760 మంది ఉన్నారు. <verse eid="1CH 5:18"/><verse number="19" style="v" sid="1CH 5:19"/>వారు హగ్రీయీలతో, యెతూరువారితో, నాపీషువారితో, నోదాబువారితో యుద్ధం చేశారు. <verse eid="1CH 5:19"/><verse number="20" style="v" sid="1CH 5:20"/>వారు యుద్ధ సమయంలో దేవునికి మొరపెట్టారు కాబట్టి దేవుడు వారికి సహాయం చేసి ఆ హగ్రీయీలను, వారితో ఉన్నవారందరిని వారి చేతికి అప్పగించారు. వారు ఆయన మీద నమ్మకముంచారు కాబట్టి ఆయన వారి ప్రార్థన అంగీకరించారు. <verse eid="1CH 5:20"/><verse number="21" style="v" sid="1CH 5:21"/>వారు హగ్రీయీలకు చెందిన యాభైవేల ఒంటెలు, రెండు లక్షల యాభైవేల గొర్రెలు, రెండువేల గాడిదలను పట్టుకున్నారు. అలాగే లక్ష మంది మనుష్యులను బందీలుగా తీసుకెళ్లారు. <verse eid="1CH 5:21"/><verse number="22" style="v" sid="1CH 5:22"/>ఇంకా చాలామంది శత్రువులను చంపారు ఎందుకంటే ఆ యుద్ధం దేవునిది. చెరకు వెళ్లేవరకు వారు అక్కడే నివసించారు.<verse eid="1CH 5:22"/></para>
  <para style="s1">మనష్షే అర్థగోత్రం</para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 5:23"/>మనష్షే అర్థగోత్రీకులు చాలా ఎక్కువ సంఖ్యలో ఉన్నారు; వారు బాషాను నుండి, బయల్-హెర్మోను వరకు, అంటే శెనీరు వరకు (హెర్మోను పర్వతం) నివసించారు.<verse eid="1CH 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 5:24"/>వారి కుటుంబ పెద్దలు వీరే: ఏఫెరు, ఇషీ, ఎలీయేలు, అజ్రీయేలు, యిర్మీయా, హోదవ్యా, యహదీయేలు. వీరు ధైర్యవంతులైన వీరులు, ప్రసిద్ధి చెందినవారు వారి కుటుంబ పెద్దలు. <verse eid="1CH 5:24"/><verse number="25" style="v" sid="1CH 5:25"/>అయితే వారు తమ పూర్వికుల దేవుని పట్ల నమ్మకద్రోహులుగా ఉన్నారు, దేవుడు తమ ఎదుట నాశనం చేసిన దేశ ప్రజల దేవుళ్ళను పూజిస్తూ, వాటితో వ్యభిచారులగా ప్రవర్తించారు. <verse eid="1CH 5:25"/><verse number="26" style="v" sid="1CH 5:26"/>కాబట్టి ఇశ్రాయేలీయుల దేవుడు అష్షూరు రాజైన పూలు మనస్సును (అష్షూరు రాజైన తిగ్లత్-పిలేసెరు) పురికొల్పగా, అతడు రూబేనీయులను, గాదీయులను, మనష్షే అర్థగోత్రీకులను బందీలుగా తీసుకెళ్లాడు. అతడు వారిని హాలహు, హాబోరు, హారా, గోజాను అనే నదీ ప్రాంతాలకు తీసుకెళ్లాడు. ఈ రోజు వరకు వారు అక్కడే ఉన్నారు.<verse eid="1CH 5:26"/></para>
  <chapter eid="1CH 5"/>
  <chapter number="6" style="c" sid="1CH 6"/>
  <para style="s1">లేవీ</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 6:1"/>లేవీ కుమారులు:</para>
  <para style="li2" vid="1CH 6:1">గెర్షోను, కహాతు, మెరారి.<verse eid="1CH 6:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 6:2"/>కహాతు కుమారులు:</para>
  <para style="li2" vid="1CH 6:2">అమ్రాము, ఇస్హారు, హెబ్రోను, ఉజ్జీయేలు.<verse eid="1CH 6:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 6:3"/>అమ్రాము పిల్లలు:</para>
  <para style="li2" vid="1CH 6:3">అహరోను, మోషే, మిర్యాము.</para>
  <para style="li1" vid="1CH 6:3">అహరోను కుమారులు:</para>
  <para style="li2" vid="1CH 6:3">నాదాబు, అబీహు, ఎలియాజరు, ఈతామారు.<verse eid="1CH 6:3"/></para>
  <para style="li2">
    <verse number="4" style="v" sid="1CH 6:4"/>ఎలియాజరు ఫీనెహాసుకు తండ్రి,</para>
  <para style="li2" vid="1CH 6:4">ఫీనెహాసు అబీషూవకు తండ్రి,<verse eid="1CH 6:4"/></para>
  <para style="li2">
    <verse number="5" style="v" sid="1CH 6:5"/>అబీషూవ బుక్కీకి తండ్రి,</para>
  <para style="li2" vid="1CH 6:5">బుక్కీ ఉజ్జీకి తండ్రి,<verse eid="1CH 6:5"/></para>
  <para style="li2">
    <verse number="6" style="v" sid="1CH 6:6"/>ఉజ్జీ జెరహ్యాకు తండ్రి,</para>
  <para style="li2" vid="1CH 6:6">జెరహ్యా మెరాయోతుకు తండ్రి,<verse eid="1CH 6:6"/></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 6:7"/>మెరాయోతు అమర్యాకు తండ్రి,</para>
  <para style="li2" vid="1CH 6:7">అమర్యా అహీటూబుకు తండ్రి,<verse eid="1CH 6:7"/></para>
  <para style="li2">
    <verse number="8" style="v" sid="1CH 6:8"/>అహీటూబు సాదోకుకు తండ్రి,</para>
  <para style="li2" vid="1CH 6:8">సాదోకు అహిమయస్సుకు తండ్రి,<verse eid="1CH 6:8"/></para>
  <para style="li2">
    <verse number="9" style="v" sid="1CH 6:9"/>అహిమయస్సు అజర్యాకు తండ్రి,</para>
  <para style="li2" vid="1CH 6:9">అజర్యా యోహానానుకు తండ్రి,<verse eid="1CH 6:9"/></para>
  <para style="li2">
    <verse number="10" style="v" sid="1CH 6:10"/>యోహానాను అజర్యాకు తండ్రి,</para>
  <para style="li2" vid="1CH 6:10">సొలొమోను యెరూషలేములో కట్టించిన దేవాలయంలో యాజకునిగా అజర్యా సేవ చేశాడు.<verse eid="1CH 6:10"/></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 6:11"/>అజర్యా అమర్యాకు తండ్రి,</para>
  <para style="li2" vid="1CH 6:11">అమర్యా అహీటూబుకు తండ్రి,<verse eid="1CH 6:11"/></para>
  <para style="li2">
    <verse number="12" style="v" sid="1CH 6:12"/>అహీటూబు సాదోకుకు తండ్రి,</para>
  <para style="li2" vid="1CH 6:12">సాదోకు షల్లూముకు తండ్రి,<verse eid="1CH 6:12"/></para>
  <para style="li2">
    <verse number="13" style="v" sid="1CH 6:13"/>షల్లూము హిల్కీయాకు తండ్రి,</para>
  <para style="li2" vid="1CH 6:13">హిల్కీయా అజర్యాకు తండ్రి,<verse eid="1CH 6:13"/></para>
  <para style="li2">
    <verse number="14" style="v" sid="1CH 6:14"/>అజర్యా శెరాయాకు తండ్రి,</para>
  <para style="li2" vid="1CH 6:14">శెరాయా యెహోజాదాకుకు<note caller="+" style="f"><char style="fr" closed="false">6:14 </char><char style="ft" closed="false">హెబ్రీలో </char><char style="fqa" closed="false">యోజాదాకు </char><char style="ft" closed="false"><char style="xt" link-href="1CH 6:15"><ref loc="1CH 6:15">15</ref></char> వచనంలో కూడా</char></note> తండ్రి.<verse eid="1CH 6:14"/></para>
  <para style="li2">
    <verse number="15" style="v" sid="1CH 6:15"/>యెహోవా నెబుకద్నెజరుచేత యూదా వారిని, యెరూషలేము వాసులను బందీలుగా పంపించినప్పుడు యెహోజాదాకు బందీగా వెళ్లాడు.<verse eid="1CH 6:15"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 6:16"/>లేవీ కుమారులు:</para>
  <para style="li2" vid="1CH 6:16">గెర్షోను,<note caller="+" style="f"><char style="fr" closed="false">6:16 </char><char style="ft" closed="false">హెబ్రీ </char><char style="fqa" closed="false">గెర్షోము </char><char style="ft" closed="false">గెర్షోను యొక్క మరొక రూపం </char><char style="ft" closed="false"><char style="xt" link-href="1CH 6:17"><ref loc="1CH 6:17">17</ref></char>, <char style="xt" link-href="1CH 6:20"><ref loc="1CH 6:20">20</ref></char>, <char style="xt" link-href="1CH 6:43"><ref loc="1CH 6:43">43</ref></char>, <char style="xt" link-href="1CH 6:62"><ref loc="1CH 6:62">62</ref></char>, <char style="xt" link-href="1CH 6:71"><ref loc="1CH 6:71">71</ref></char> వచనంలో కూడా</char></note> కహాతు, మెరారి.<verse eid="1CH 6:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 6:17"/>గెర్షోను కుమారుల పేర్లు ఇవి:</para>
  <para style="li2" vid="1CH 6:17">లిబ్నీ, షిమీ.<verse eid="1CH 6:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 6:18"/>కహాతు కుమారులు:</para>
  <para style="li2" vid="1CH 6:18">అమ్రాము, ఇస్హారు, హెబ్రోను, ఉజ్జీయేలు.<verse eid="1CH 6:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 6:19"/>మెరారి కుమారులు:</para>
  <para style="li2" vid="1CH 6:19">మహలి, మూషి.</para>
  <para style="b" vid="1CH 6:19"/>
  <para style="lh" vid="1CH 6:19">వారి తండ్రుల వంశావళి ప్రకారం లేవీయుల కుటుంబాలు ఇవే:<verse eid="1CH 6:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 6:20"/>గెర్షోను:</para>
  <para style="li2" vid="1CH 6:20">అతని కుమారుడు లిబ్నీ, అతని కుమారుడు యహతు,</para>
  <para style="li2" vid="1CH 6:20">అతని కుమారుడు జిమ్మా, <verse eid="1CH 6:20"/><verse number="21" style="v" sid="1CH 6:21"/>అతని కుమారుడు యోవాహు,</para>
  <para style="li2" vid="1CH 6:21">అతని కుమారుడు ఇద్దో, అతని కుమారుడు జెరహు,</para>
  <para style="li2" vid="1CH 6:21">అతని కుమారుడు యెయతిరయి.<verse eid="1CH 6:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 6:22"/>కహాతు సంతానం:</para>
  <para style="li2" vid="1CH 6:22">అతని కుమారుడు అమ్మీనాదాబు, అతని కుమారుడు కోరహు,</para>
  <para style="li2" vid="1CH 6:22">అతని కుమారుడు అస్సీరు, <verse eid="1CH 6:22"/><verse number="23" style="v" sid="1CH 6:23"/>అతని కుమారుడు ఎల్కానా,</para>
  <para style="li2" vid="1CH 6:23">అతని కుమారుడు ఎబ్యాసాపు, అతని కుమారుడు అస్సీరు,<verse eid="1CH 6:23"/></para>
  <para style="li2">
    <verse number="24" style="v" sid="1CH 6:24"/>అతని కుమారుడు తాహతు, అతని కుమారుడు ఊరియేలు,</para>
  <para style="li2" vid="1CH 6:24">అతని కుమారుడు ఉజ్జియా, అతని కుమారుడు షావూలు.<verse eid="1CH 6:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 6:25"/>ఎల్కానా సంతానం:</para>
  <para style="li2" vid="1CH 6:25">అమాశై, అహీమోతు,<verse eid="1CH 6:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 6:26"/>అతని కుమారుడు ఎల్కానా, అతని కుమారుడు జోఫై,</para>
  <para style="li2" vid="1CH 6:26">అతని కుమారుడు నహతు, <verse eid="1CH 6:26"/><verse number="27" style="v" sid="1CH 6:27"/>అతని కుమారుడు ఏలీయాబు,</para>
  <para style="li2" vid="1CH 6:27">అతని కుమారుడు యెరోహాము, అతని కుమారులు ఎల్కానా,</para>
  <para style="li2" vid="1CH 6:27">అతని కుమారుడు సమూయేలు.<note caller="+" style="f"><char style="fr" closed="false">6:27 </char><char style="ft" closed="false">కొ.ప్ర.లలో (<char style="xt"><ref loc="1SA 1:19">1 సమూ 1:19</ref>,<ref loc="1SA 1:20">20</ref></char>, <char style="xt">1 దిన 6:33-34</char> చూడండి), హెబ్రీలో, సమూయేలు అతని కుమారుడు అని లేదు</char></note><verse eid="1CH 6:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 6:28"/>సమూయేలు కుమారులు:</para>
  <para style="li2" vid="1CH 6:28">మొదటివాడు యోవేలు<note caller="+" style="f"><char style="fr" closed="false">6:28 </char><char style="ft" closed="false">కొ.ప్ర.లలో (<char style="xt"><ref loc="1SA 8:2">1 సమూ 8:2</ref></char>, <char style="xt"><ref loc="1CH 6:33">1 దిన 6:33</ref></char> చూడండి), హెబ్రీలో యోవేలు అని లేదు</char></note></para>
  <para style="li2" vid="1CH 6:28">రెండవవాడు అబీయా.<verse eid="1CH 6:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 6:29"/>మెరారి సంతానం:</para>
  <para style="li2" vid="1CH 6:29">మహలి, అతని కుమారుడు లిబ్నీ,</para>
  <para style="li2" vid="1CH 6:29">అతని కుమారుడు షిమీ, అతని కుమారుడు ఉజ్జా,<verse eid="1CH 6:29"/></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 6:30"/>అతని కుమారుడు షిమ్యా, అతని కుమారుడు హగ్గీయా,</para>
  <para style="li2" vid="1CH 6:30">అతని కుమారుడు అశాయా.<verse eid="1CH 6:30"/></para>
  <para style="s2">ఆలయ సంగీతకారులు</para>
  <para style="p">
    <verse number="31" style="v" sid="1CH 6:31"/>నిబంధన మందసం యెహోవా మందిరంలో ఉంచబడిన తర్వాత, అక్కడ సంగీత సేవకు దావీదు నియమించిన వారు వీరు. <verse eid="1CH 6:31"/><verse number="32" style="v" sid="1CH 6:32"/>సొలొమోను యెరూషలేములో యెహోవా మందిరాన్ని కట్టించేవరకు, వీరు సమావేశ గుడారం ఎదుట సంగీత సేవ చేశారు. వారికి ఇచ్చిన నియమాల ప్రకారం తమ విధులు నిర్వహించేవారు.<verse eid="1CH 6:32"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="33" style="v" sid="1CH 6:33"/>తమ కుమారులతో కలిసి సేవ చేసినవారు వీరు:</para>
  <para style="b" vid="1CH 6:33"/>
  <para style="li1" vid="1CH 6:33">కహాతీయుల నుండి:</para>
  <para style="li2" vid="1CH 6:33">సంగీతకారుడైన హేమాను,</para>
  <para style="li2" vid="1CH 6:33">హేమాను యోవేలు కుమారుడు, అతడు సమూయేలు కుమారుడు,<verse eid="1CH 6:33"/></para>
  <para style="li2">
    <verse number="34" style="v" sid="1CH 6:34"/>అతడు ఎల్కానా కుమారుడు, అతడు యెరోహాము కుమారుడు,</para>
  <para style="li2" vid="1CH 6:34">అతడు ఎలీయేలు కుమారుడు, అతడు తోయహు కుమారుడు,<verse eid="1CH 6:34"/></para>
  <para style="li2">
    <verse number="35" style="v" sid="1CH 6:35"/>అతడు సూఫు కుమారుడు, అతడు ఎల్కానా కుమారుడు,</para>
  <para style="li2" vid="1CH 6:35">అతడు మహతు కుమారుడు అతడు అమాశై కుమారుడు,<verse eid="1CH 6:35"/></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 6:36"/>అతడు ఎల్కానా కుమారుడు, అతడు యోవేలు కుమారుడు,</para>
  <para style="li2" vid="1CH 6:36">అతడు అజర్యా కుమారుడు, అతడు జెఫన్యా కుమారుడు,<verse eid="1CH 6:36"/></para>
  <para style="li2">
    <verse number="37" style="v" sid="1CH 6:37"/>అతడు తాహతు కుమారుడు, అతడు అస్సీరు కుమారుడు,</para>
  <para style="li2" vid="1CH 6:37">అతడు ఎబ్యాసాపు కుమారుడు, అతడు కోరహు కుమారుడు,<verse eid="1CH 6:37"/></para>
  <para style="li2">
    <verse number="38" style="v" sid="1CH 6:38"/>అతడు ఇస్హారు కుమారుడు, అతడు కహాతు కుమారుడు,</para>
  <para style="li2" vid="1CH 6:38">అతడు లేవీ కుమారుడు, అతడు ఇశ్రాయేలు కుమారుడు;<verse eid="1CH 6:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 6:39"/>హేమాను సహచరుడైన ఆసాపు అతని కుడి ప్రక్కన సేవ చేశాడు. అతని వంశావళి:</para>
  <para style="li2" vid="1CH 6:39">ఆసాపు బెరెక్యా కుమారుడు, అతడు షిమ్యా కుమారుడు,<verse eid="1CH 6:39"/></para>
  <para style="li2">
    <verse number="40" style="v" sid="1CH 6:40"/>అతడు మిఖాయేలు కుమారుడు, అతడు బయశేయా<note caller="+" style="f"><char style="fr" closed="false">6:40 </char><char style="ft" closed="false">కొ.ప్ర.లలో </char><char style="fqa" closed="false">మయశేయా</char></note> కుమారుడు,</para>
  <para style="li2" vid="1CH 6:40">అతడు మల్కీయా కుమారుడు, <verse eid="1CH 6:40"/><verse number="41" style="v" sid="1CH 6:41"/>అతడు యెత్నీ కుమారుడు,</para>
  <para style="li2" vid="1CH 6:41">అతడు జెరహు కుమారుడు, అతడు అదాయా కుమారుడు,<verse eid="1CH 6:41"/></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 6:42"/>అతడు ఏతాను కుమారుడు, అతడు జిమ్మా కుమారుడు,</para>
  <para style="li2" vid="1CH 6:42">అతడు షిమీ కుమారుడు, <verse eid="1CH 6:42"/><verse number="43" style="v" sid="1CH 6:43"/>అతడు యహతు కుమారుడు,</para>
  <para style="li2" vid="1CH 6:43">అతడు గెర్షోను కుమారుడు, అతడు లేవీ కుమారుడు;<verse eid="1CH 6:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 6:44"/>హేమాను ఎడమ ప్రక్కన మెరారీయులు సేవ చేశారు:</para>
  <para style="li2" vid="1CH 6:44">ఏతాను కీషీ కుమారుడు, అతడు అబ్దీ కుమారుడు,</para>
  <para style="li2" vid="1CH 6:44">అతడు మల్లూకు కుమారుడు, <verse eid="1CH 6:44"/><verse number="45" style="v" sid="1CH 6:45"/>అతడు హషబ్యా కుమారుడు,</para>
  <para style="li2" vid="1CH 6:45">అతడు అమజ్యా కుమారుడు, అతడు హిల్కీయా కుమారుడు,<verse eid="1CH 6:45"/></para>
  <para style="li2">
    <verse number="46" style="v" sid="1CH 6:46"/>అతడు అమ్జీ కుమారుడు, అతడు బానీ కుమారుడు,</para>
  <para style="li2" vid="1CH 6:46">అతడు షమెరు కుమారుడు, <verse eid="1CH 6:46"/><verse number="47" style="v" sid="1CH 6:47"/>అతడు మహలి కుమారుడు,</para>
  <para style="li2" vid="1CH 6:47">అతడు మూషి కుమారుడు, అతడు మెరారి కుమారుడు,</para>
  <para style="li2" vid="1CH 6:47">అతడు లేవీ కుమారుడు.<verse eid="1CH 6:47"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="48" style="v" sid="1CH 6:48"/>వారి తోటి లేవీయులు దేవుని మందిరమనే ప్రత్యక్షగుడారంలో జరగాల్సిన ఇతర పనులన్నిటి కోసం నియమించబడ్డారు. <verse eid="1CH 6:48"/><verse number="49" style="v" sid="1CH 6:49"/>అయితే అహరోను అతని సంతానం దహనబలిపీఠం మీద ధూపవేదిక మీద అర్పణలు అర్పించడానికి, అతి పరిశుద్ధ స్థలంలో చేయవలసిన వాటన్నిటిని చేయడానికి, దేవుని సేవకుడైన మోషే ఆదేశించిన ప్రకారం ఇశ్రాయేలు కోసం ప్రాయశ్చిత్తం చేయడానికి నియమించబడ్డారు.<verse eid="1CH 6:49"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="50" style="v" sid="1CH 6:50"/>వీరు అహరోను సంతానం:</para>
  <para style="li2" vid="1CH 6:50">అహరోను కుమారుడు ఎలియాజరు, అతని కుమారుడు ఫీనెహాసు,</para>
  <para style="li2" vid="1CH 6:50">అతని కుమారుడు అబీషూవ, <verse eid="1CH 6:50"/><verse number="51" style="v" sid="1CH 6:51"/>అతని కుమారుడు బుక్కీ,</para>
  <para style="li2" vid="1CH 6:51">అతని కుమారుడు ఉజ్జీ, అతని కుమారుడు జెరహ్యా,<verse eid="1CH 6:51"/></para>
  <para style="li2">
    <verse number="52" style="v" sid="1CH 6:52"/>అతని కుమారుడు మెరాయోతు, అతని కుమారుడు అమర్యా,</para>
  <para style="li2" vid="1CH 6:52">అతని కుమారుడు అహీటూబు, <verse eid="1CH 6:52"/><verse number="53" style="v" sid="1CH 6:53"/>అతని కుమారుడు సాదోకు,</para>
  <para style="li2" vid="1CH 6:53">అతని కుమారుడు అహిమయస్సు.<verse eid="1CH 6:53"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="54" style="v" sid="1CH 6:54"/>అహరోను సంతతివారైన కహాతీయులకు మొదటి చీటి పడింది, కాబట్టి సరిహద్దులతో వారికి కేటాయించబడిన నివాసస్థలాలు ఇవి:<verse eid="1CH 6:54"/></para>
  <para style="li1">
    <verse number="55" style="v" sid="1CH 6:55"/>యూదాలోని హెబ్రోను, దాని చుట్టూ ఉన్న పచ్చిక మైదానాలు. <verse eid="1CH 6:55"/><verse number="56" style="v" sid="1CH 6:56"/>(అయితే పట్టణం చుట్టూ ఉన్న పొలాలు, గ్రామాలు యెఫున్నె కుమారుడైన కాలేబుకు ఇవ్వబడ్డాయి.) <verse eid="1CH 6:56"/><verse number="57" style="v" sid="1CH 6:57"/>అహరోను సంతానానికి ఇవ్వబడిన పట్టణాలు ఆశ్రయ పట్టణమైన హెబ్రోను, లిబ్నా, యత్తీరు, ఎష్తెమోవా, <verse eid="1CH 6:57"/><verse number="58" style="v" sid="1CH 6:58"/>హీలేను, దెబీరు, <verse eid="1CH 6:58"/><verse number="59" style="v" sid="1CH 6:59"/>ఆషాను, యుత్తా,<note caller="+" style="f"><char style="fr" closed="false">6:59 </char><char style="ft" closed="false"><char style="xt"><ref loc="JOS 21:16">యెహో 21:16</ref></char> చూడండి; </char><char style="fq" closed="false">యుత్తా </char><char style="ft" closed="false">హెబ్రీలో ఈ పదం లేదు.</char></note> బేత్-షెమెషు, వాటి దాని పచ్చిక మైదానాలతో ఇవ్వబడ్డాయి.<verse eid="1CH 6:59"/></para>
  <para style="li1">
    <verse number="60" style="v" sid="1CH 6:60"/>బెన్యామీను గోత్ర ప్రదేశాల్లో, గిబియోను,<note caller="+" style="f"><char style="fr" closed="false">6:60 </char><char style="ft" closed="false"><char style="xt"><ref loc="JOS 21:17">యెహో 21:17</ref></char> చూడండి; </char><char style="fq" closed="false">గిబియోను </char><char style="ft" closed="false">హెబ్రీలో ఈ పదం లేదు</char></note> గెబా, అల్లెమెతు, అనాతోతు వాటి పచ్చిక మైదానాలతో పాటు ఇవ్వబడ్డాయి.</para>
  <para style="lf" vid="1CH 6:60">కహాతీయులకు పంచిపెట్టిన మొత్తం పట్టణాల సంఖ్య పదమూడు.<verse eid="1CH 6:60"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="61" style="v" sid="1CH 6:61"/>కహాతు సంతానంలో మిగిలిన వారికి మనష్షే అర్ధగోత్ర వంశస్థుల నుండి చీట్ల ద్వారా పది పట్టణాలు కేటాయించబడ్డాయి.<verse eid="1CH 6:61"/></para>
  <para style="li1">
    <verse number="62" style="v" sid="1CH 6:62"/>గెర్షోను సంతానం, వారి వంశాల ప్రకారం చీట్ల ద్వారా ఇశ్శాఖారు, ఆషేరు, నఫ్తాలి గోత్రాల ప్రదేశాల నుండి బాషానులో ఉన్న మనష్షే గోత్ర ప్రదేశాల నుండి పదమూడు పట్టణాలు కేటాయించబడ్డాయి.<verse eid="1CH 6:62"/></para>
  <para style="li1">
    <verse number="63" style="v" sid="1CH 6:63"/>మెరారి సంతానం, వారి వంశాల ప్రకారం చీట్లు వేయడం వలన రూబేను, గాదు, జెబూలూను గోత్రాల ప్రదేశాల నుండి పన్నెండు పట్టణాలు కేటాయించబడ్డాయి.<verse eid="1CH 6:63"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="64" style="v" sid="1CH 6:64"/>ఈ విధంగా ఇశ్రాయేలీయులు, లేవీయులకు ఈ పట్టణాలను వాటి పచ్చిక మైదానాలను ఇచ్చారు.<verse eid="1CH 6:64"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="65" style="v" sid="1CH 6:65"/>యూదా, షిమ్యోను, బెన్యామీను గోత్రాల ప్రదేశాల్లో, పై చెప్పిన పట్టణాలు చీట్ల ద్వార వారికి కేటాయించబడ్డాయి.<verse eid="1CH 6:65"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="66" style="v" sid="1CH 6:66"/>కహాతీయులలో కొందరికి ఎఫ్రాయిం గోత్ర ప్రదేశాల నుండి సరిహద్దు పట్టణాలు ఇవ్వబడ్డాయి.<verse eid="1CH 6:66"/></para>
  <para style="li1">
    <verse number="67" style="v" sid="1CH 6:67"/>ఎఫ్రాయిం కొండ సీమలో ఆశ్రయ పట్టణమైన షెకెము, గెజెరు, <verse eid="1CH 6:67"/><verse number="68" style="v" sid="1CH 6:68"/>యొక్మెయాము, బేత్-హోరోను, <verse eid="1CH 6:68"/><verse number="69" style="v" sid="1CH 6:69"/>అయ్యాలోను, గాత్-రిమ్మోను, వాటి పచ్చిక మైదానాలతో పాటు ఇవ్వబడ్డాయి.<verse eid="1CH 6:69"/></para>
  <para style="li1">
    <verse number="70" style="v" sid="1CH 6:70"/>మనష్షే అర్ధగోత్రీకుల దగ్గర నుండి ఇశ్రాయేలీయులు ఆనేరు, బిలియాము వాటి పచ్చిక మైదానాలతో పాటు కహాతీయుల వంశాలలో మిగిలిన వారికి ఇచ్చారు.<verse eid="1CH 6:70"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="71" style="v" sid="1CH 6:71"/>గెర్షోనీయులకు లభించిన పట్టణాలు:</para>
  <para style="li1" vid="1CH 6:71">మనష్షే అర్ధగోత్ర ప్రదేశంలో నుండి బాషానులో ఉన్న గోలాను, అష్తారోతు, వాటి పచ్చిక మైదానాలతో పాటు వారు పొందుకున్నారు;<verse eid="1CH 6:71"/></para>
  <para style="li1">
    <verse number="72" style="v" sid="1CH 6:72"/>ఇశ్శాఖారు గోత్ర ప్రదేశంలో నుండి కెదెషు, దాబెరతు, <verse eid="1CH 6:72"/><verse number="73" style="v" sid="1CH 6:73"/>రామోతు, అనేము, వాటి పచ్చిక మైదానాలతో పాటు వారు పొందుకున్నారు;<verse eid="1CH 6:73"/></para>
  <para style="li1">
    <verse number="74" style="v" sid="1CH 6:74"/>ఆషేరు గోత్ర ప్రదేశంలో నుండి మాషాలు, అబ్దోను, <verse eid="1CH 6:74"/><verse number="75" style="v" sid="1CH 6:75"/>హుక్కోకు, రెహోబు వాటి పచ్చిక మైదానాలతో పాటు వారు పొందుకున్నారు;<verse eid="1CH 6:75"/></para>
  <para style="li1">
    <verse number="76" style="v" sid="1CH 6:76"/>నఫ్తాలి గోత్ర ప్రదేశంలో నుండి గలిలయలో ఉన్న కెదెషు, హమ్మోను, కిర్యతాయిము వాటి పచ్చిక మైదానాలతో పాటు వారు పొందుకున్నారు.<verse eid="1CH 6:76"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="77" style="v" sid="1CH 6:77"/>లేవీయులలో మిగిలిన వారైన మెరారీయులకు లభించిన పట్టణాలు:</para>
  <para style="li1" vid="1CH 6:77">జెబూలూను గోత్ర ప్రదేశంలో నుండి యొక్నెయాము, కర్తహు, రిమ్మోను, తాబోరు వాటి పచ్చిక మైదానాలతో పాటు వారు పొందుకున్నారు;<verse eid="1CH 6:77"/></para>
  <para style="li1">
    <verse number="78" style="v" sid="1CH 6:78"/>యెరికోకు తూర్పుగా యొర్దాను నది అవతల ఉన్న రూబేను గోత్ర ప్రదేశంలో నుండి ఎడారిలో ఉన్న బేసెరు, యహజు, <verse eid="1CH 6:78"/><verse number="79" style="v" sid="1CH 6:79"/>కెదేమోతు, మెఫాతు, వాటి పచ్చిక మైదానాలతో పాటు వారు పొందుకున్నారు;<verse eid="1CH 6:79"/></para>
  <para style="li1">
    <verse number="80" style="v" sid="1CH 6:80"/>గాదు గోత్ర ప్రదేశంలో నుండి గిలాదులో ఉన్న రామోతు, మహనయీము, <verse eid="1CH 6:80"/><verse number="81" style="v" sid="1CH 6:81"/>హెష్బోను, యాజెరు వాటి పచ్చిక మైదానాలతో పాటు వారు పొందుకున్నారు.<verse eid="1CH 6:81"/></para>
  <chapter eid="1CH 6"/>
  <chapter number="7" style="c" sid="1CH 7"/>
  <para style="s1">ఇశ్శాఖారు</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 7:1"/>ఇశ్శాఖారు కుమారులు:</para>
  <para style="li2" vid="1CH 7:1">తోలా, పువా, యాషూబు, షిమ్రోను మొత్తం నలుగురు.<verse eid="1CH 7:1"/></para>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 7:2"/>తోలా కుమారులు:</para>
  <para style="li2" vid="1CH 7:2">ఉజ్జీ, రెఫాయా, యెరీయేలు, యహ్మయి, ఇబ్శాము, సమూయేలు. వీరు తమ కుటుంబాలకు పెద్దలు. దావీదు పాలనలో తోలా సంతానం యుద్ధవీరులుగా లెక్కించబడ్డారు. వీరి సంఖ్య 22,600.<verse eid="1CH 7:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 7:3"/>ఉజ్జీ కుమారుడు:</para>
  <para style="li2" vid="1CH 7:3">ఇజ్రహయా.</para>
  <para style="li1" vid="1CH 7:3">ఇజ్రహయా కుమారులు:</para>
  <para style="li2" vid="1CH 7:3">మిఖాయేలు, ఓబద్యా, యోవేలు, ఇష్షీయా. ఈ అయిదుగురు పెద్దలు. <verse eid="1CH 7:3"/><verse number="4" style="v" sid="1CH 7:4"/>వారికి చాలామంది భార్యలు, పిల్లలు ఉండడం వల్ల వారి వంశావళి ప్రకారం వారిలో యుద్ధవీరుల సంఖ్య 36,000.<verse eid="1CH 7:4"/></para>
  <para style="lf">
    <verse number="5" style="v" sid="1CH 7:5"/>ఇశ్శాఖారు వంశాలన్నిటికి చెందిన వీరి బంధువుల నుండి వారి వంశావళి ప్రకారం యుద్ధవీరుల సంఖ్య 87,000.<verse eid="1CH 7:5"/></para>
  <para style="s1">బెన్యామీను</para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 7:6"/>బెన్యామీనుకు కుమారులు ముగ్గురు:</para>
  <para style="li2" vid="1CH 7:6">బేల, బెకెరు, యెదీయవేలు.<verse eid="1CH 7:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 7:7"/>బేల కుమారులు:</para>
  <para style="li2" vid="1CH 7:7">ఎస్బోను, ఉజ్జీ, ఉజ్జీయేలు, యెరీమోతు, ఈరీ మొత్తం అయిదుగురు. వీరు కుటుంబ పెద్దలు. తమ వంశావళి ప్రకారం యుద్ధవీరుల సంఖ్య 22,034.<verse eid="1CH 7:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 7:8"/>బెకెరు కుమారులు:</para>
  <para style="li2" vid="1CH 7:8">జెమీరా, యోవాషు, ఎలీయెజెరు, ఎల్యోయేనై, ఒమ్రీ, యెరీమోతు, అబీయా, అనాతోతు, ఆలెమెతు. వీరందరు బెకెరు కుమారులు. <verse eid="1CH 7:8"/><verse number="9" style="v" sid="1CH 7:9"/>తమ వంశావళి ప్రకారం వీరు కుటుంబ పెద్దలు; యుద్ధవీరుల సంఖ్య 20,200.<verse eid="1CH 7:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 7:10"/>యెదీయవేలు కుమారుడు:</para>
  <para style="li2" vid="1CH 7:10">బిల్హాను.</para>
  <para style="li1" vid="1CH 7:10">బిల్హాను కుమారులు:</para>
  <para style="li2" vid="1CH 7:10">యూషు, బెన్యామీను, ఏహూదు, కెనయనా, జేతాను, తర్షీషు, అహీషహరు. <verse eid="1CH 7:10"/><verse number="11" style="v" sid="1CH 7:11"/>యెదీయవేలు కుమారులైన వీరందరు తమ కుటుంబాలకు పెద్దలు. వీరిలో యుద్ధానికి వెళ్లడానికి సిద్ధంగా ఉన్న యుద్ధవీరుల సంఖ్య 17,200.<verse eid="1CH 7:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 7:12"/>ఈరు వారసులు షుప్పీము, హుప్పీము. హూషీయులు<note caller="+" style="f"><char style="fr" closed="false">7:12 </char><char style="ft" closed="false">లేదా </char><char style="fq" closed="false">ఈరు </char><char style="fqa" closed="false">దాను కుమారులు: హుషీము </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 46:23">ఆది 46:23</ref></char> చూడండి; హెబ్రీలో, దాను కుమారులు అని లేదు</char></note> అహేరు వారసులు.<verse eid="1CH 7:12"/></para>
  <para style="s1">నఫ్తాలి</para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 7:13"/>నఫ్తాలీయులైన బిల్హా వారసులు:</para>
  <para style="li2" vid="1CH 7:13">యహజీయేలు, గూనీ, యేజెరు, షిల్లేము.<verse eid="1CH 7:13"/></para>
  <para style="s1">మనష్షే</para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 7:14"/>మనష్షే వారసులు:</para>
  <para style="li2" vid="1CH 7:14">అరాము దేశస్థురాలైన ఉంపుడుగత్తె ద్వారా అశ్రీయేలు అతనికి వారసుడు అయ్యాడు.ఆమె గిలాదు తండ్రియైన మాకీరుకు జన్మనిచ్చింది. <verse eid="1CH 7:14"/><verse number="15" style="v" sid="1CH 7:15"/>మాకీరు షుప్పీము, హుప్పీముల సోదరిని పెళ్ళి చేసుకున్నాడు. వారి సోదరి పేరు మయకా. మరో వారసుని పేరు సెలోఫెహాదు. అతనికి కుమార్తెలు మాత్రమే పుట్టారు. <verse eid="1CH 7:15"/><verse number="16" style="v" sid="1CH 7:16"/>మాకీరు భార్యయైన మయకా ఒక కుమారుని కని అతనికి పెరెషు అనే పేరు పెట్టింది. అతని తమ్ముని పేరు షెరెషు. అతని కుమారులు ఊలాము, రాకెము.<verse eid="1CH 7:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 7:17"/>ఊలాము కుమారుడు:</para>
  <para style="li2" vid="1CH 7:17">బెదాను.</para>
  <para style="li1" vid="1CH 7:17">వీరు మనష్షే కుమారుడైన మాకీరుకు పుట్టిన గిలాదు కుమారులు.<verse eid="1CH 7:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 7:18"/>మాకీరు సోదరి హమ్మోలెకెతుకు ఇషోదు, అబీయెజెరు, మహలాలు పుట్టారు.<verse eid="1CH 7:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 7:19"/>షెమీదా కుమారులు:</para>
  <para style="li2" vid="1CH 7:19">అహెయాను, షెకెము, లికీ, అనీయాము.<verse eid="1CH 7:19"/></para>
  <para style="s1">ఎఫ్రాయిం</para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 7:20"/>ఎఫ్రాయిం వారసులు:</para>
  <para style="li2" vid="1CH 7:20">ఎఫ్రాయిం కుమారుడు షూతలహు, అతని కుమారుడు బెరెదు,</para>
  <para style="li2" vid="1CH 7:20">అతని కుమారుడు తాహతు, అతని కుమారుడు ఎల్యాదా,</para>
  <para style="li2" vid="1CH 7:20">అతని కుమారుడు తాహతు, <verse eid="1CH 7:20"/><verse number="21" style="v" sid="1CH 7:21"/>అతని కుమారుడు జాబాదు,</para>
  <para style="li2" vid="1CH 7:21">అతని కుమారుడు షూతలహు.</para>
  <para style="li2" vid="1CH 7:21">(అతని కుమారులైన ఏజెరు ఎల్యాదులు తమ దేశంలో పుట్టిన గాతీయుల పశువులను పట్టుకోడానికి వెళ్లినప్పుడు, గాతీయులు వారిని చంపారు. <verse eid="1CH 7:21"/><verse number="22" style="v" sid="1CH 7:22"/>వారి తండ్రియైన ఎఫ్రాయిం చాలా రోజులు దుఃఖపడ్డాడు, అతని బంధువులు వచ్చి అతన్ని ఓదార్చారు. <verse eid="1CH 7:22"/><verse number="23" style="v" sid="1CH 7:23"/>ఆ తర్వాత అతడు తన భార్యను కలుసుకోగా ఆమె గర్భవతియై ఒక కుమారునికి జన్మనిచ్చింది. తన కుటుంబంలో జరిగిన కీడును బట్టి ఎఫ్రాయిం అతనికి బెరీయా<note caller="+" style="f"><char style="fr" closed="false">7:23 </char><char style="fq" closed="false">బెరీయా </char><char style="ft" closed="false">హెబ్రీ పదంలా ఉంది </char><char style="fq" closed="false">కీడు </char><char style="fqa" closed="false">దురదృష్టం అని అర్థం ఇస్తుంది</char></note> అనే పేరు పెట్టాడు. <verse eid="1CH 7:23"/><verse number="24" style="v" sid="1CH 7:24"/>అతని కుమార్తెయైన షెయెరా దిగువ బేత్-హోరోను, ఎగువ బేత్-హోరోను, ఉజ్జెన్-షెయెరా అనే పట్టణాలను కట్టించింది.)<verse eid="1CH 7:24"/></para>
  <para style="li2">
    <verse number="25" style="v" sid="1CH 7:25"/>ఎఫ్రాయిం కుమారుడు రెపహు, అతని కుమారుడు రెషెపు,</para>
  <para style="li2" vid="1CH 7:25">అతని కుమారుడు తెలహు, అతని కుమారుడు తహను,<verse eid="1CH 7:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 7:26"/>అతని కుమారుడు లద్దాను, అతని కుమారుడు అమీహూదు,</para>
  <para style="li2" vid="1CH 7:26">అతని కుమారుడు ఎలీషామా, <verse eid="1CH 7:26"/><verse number="27" style="v" sid="1CH 7:27"/>అతని కుమారుడు నూను,</para>
  <para style="li2" vid="1CH 7:27">అతని కుమారుడు యెహోషువ.<verse eid="1CH 7:27"/></para>
  <para style="lf">
    <verse number="28" style="v" sid="1CH 7:28"/>వారి ప్రదేశాలు నివాసస్థలాలు ఏవంటే, బేతేలు దాని చుట్టుప్రక్కల గ్రామాలు, తూర్పున ఉన్న నహరాను, పడమర ఉన్న గెజెరు దాని గ్రామాలు, షెకెము దాని గ్రామాలు, అయ్యా దాని గ్రామాల వరకు ఉన్న ప్రాంతాలు. <verse eid="1CH 7:28"/><verse number="29" style="v" sid="1CH 7:29"/>మనష్షే సరిహద్దులలో ఉన్న బేత్-షాను, తానాకు, మెగిద్దో, దోరు, వాటి గ్రామాలతో పాటు వారివే. ఇశ్రాయేలు కుమారుడైన యోసేపు వారసులు ఈ పట్టణాల్లో నివసించారు.<verse eid="1CH 7:29"/></para>
  <para style="s1">ఆషేరు</para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 7:30"/>ఆషేరు కుమారులు:</para>
  <para style="li2" vid="1CH 7:30">ఇమ్నా, ఇష్వా, ఇష్వీ, బెరీయా. వారి సోదరి శెరహు.<verse eid="1CH 7:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 7:31"/>బెరీయా కుమారులు:</para>
  <para style="li2" vid="1CH 7:31">హెబెరు, బిర్జాయీతు తండ్రియైన మల్కీయేలు.<verse eid="1CH 7:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 7:32"/>హెబెరు యప్లేటు, షోమేరు, హోతాము, వారి సోదరియైన షూయాలకు తండ్రి.<verse eid="1CH 7:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 7:33"/>యప్లేటు కుమారులు:</para>
  <para style="li2" vid="1CH 7:33">పాసకు, బింహాలు, అష్వాతు.</para>
  <para style="lf" vid="1CH 7:33">వీరు యప్లేటు కుమారులు.<verse eid="1CH 7:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 7:34"/>షోమేరు కుమారులు:</para>
  <para style="li2" vid="1CH 7:34">అహీ, రోగా,<note caller="+" style="f"><char style="fr" closed="false">7:34 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">వారి సహోదరుడు షోమేరు: రోగా</char></note> యెహుబ్బా, అరాము.<verse eid="1CH 7:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 7:35"/>అతని సోదరుడైన హేలెము కుమారులు:</para>
  <para style="li2" vid="1CH 7:35">జోపహు, ఇమ్నా, షెలెషు, ఆమాలు.<verse eid="1CH 7:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 7:36"/>జోపహు కుమారులు:</para>
  <para style="li2" vid="1CH 7:36">సూయ, హర్నెఫెరు, షూయాలు, బేరీ, ఇమ్రా, <verse eid="1CH 7:36"/><verse number="37" style="v" sid="1CH 7:37"/>బేసెరు, హోదు, షమ్మా, షిల్షా, ఇత్రాను,<note caller="+" style="f"><char style="fr" closed="false">7:37 </char><char style="fqa" closed="false">యెతెరు </char><char style="ft" closed="false">యొక్క మరొక రూపం కావచ్చు</char></note> బెయేర.<verse eid="1CH 7:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 7:38"/>ఎతెరు కుమారులు:</para>
  <para style="li2" vid="1CH 7:38">యెఫున్నె, పిస్పా, అరా.<verse eid="1CH 7:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 7:39"/>ఉల్లా కుమారులు:</para>
  <para style="li2" vid="1CH 7:39">ఆరహు హన్నియేలు రిజెయా<verse eid="1CH 7:39"/></para>
  <para style="lf">
    <verse number="40" style="v" sid="1CH 7:40"/>ఆషేరు వారసులైన వీరందరు తమ కుటుంబాలకు పెద్దలు, ప్రసిద్ధి చెందిన పరాక్రమశాలులు, గొప్ప నాయకులు. వారి వంశావళిలో నమోదు చేయబడినట్లుగా యుద్ధం చేయడానికి సిద్ధంగా ఉన్న వారి సంఖ్య 26,000.<verse eid="1CH 7:40"/></para>
  <chapter eid="1CH 7"/>
  <chapter number="8" style="c" sid="1CH 8"/>
  <para style="s1">బెన్యామీనీయుడైన సౌలు వంశావళి</para>
  <para style="li1">
    <verse number="1" style="v" sid="1CH 8:1"/>బెన్యామీను వీరికి తండ్రి:</para>
  <para style="li2" vid="1CH 8:1">మొదటివాడు బేల,</para>
  <para style="li2" vid="1CH 8:1">రెండవవాడు అష్బేలు, మూడవవాడు అహరహు,<verse eid="1CH 8:1"/></para>
  <para style="li2">
    <verse number="2" style="v" sid="1CH 8:2"/>నాలుగవవాడు నోహా, అయిదవవాడు రాపా.<verse eid="1CH 8:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 8:3"/>బేల కుమారులు:</para>
  <para style="li2" vid="1CH 8:3">అద్దారు, గెరా, అబీహూదు,<note caller="+" style="f"><char style="fr" closed="false">8:3 </char><char style="ft" closed="false">లేదా </char><char style="fq" closed="false">గెరా </char><char style="fqa" closed="false">ఏహూదు యొక్క తండ్రి</char></note> <verse eid="1CH 8:3"/><verse number="4" style="v" sid="1CH 8:4"/>అబీషూవ, నయమాను, అహోయహు, <verse eid="1CH 8:4"/><verse number="5" style="v" sid="1CH 8:5"/>గెరా, షెపూపాను, హూరాము.<verse eid="1CH 8:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 8:6"/>వీరు ఏహూదు వారసులు, గెబాలో నివసిస్తున్న కుటుంబాలకు పెద్దలు. వీరు బలవంతంగా మనహతుకు తరలి వెళ్లాల్సి వచ్చింది:<verse eid="1CH 8:6"/></para>
  <para style="li2">
    <verse number="7" style="v" sid="1CH 8:7"/>నయమాను, అహీయా, గెరా అనేవారు, వారిని మనహతుకు బందీలుగా తీసుకెళ్లారు. గెరా, ఉజ్జా, అహీహూదుల తండ్రి.<verse eid="1CH 8:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 8:8"/>షహరయీము తన భార్యలైన హుషీము, బయారాలను విడాకులు ఇచ్చిన తర్వాత అతనికి మోయాబు దేశంలో కుమారులు పుట్టారు. <verse eid="1CH 8:8"/><verse number="9" style="v" sid="1CH 8:9"/>తన భార్యయైన హోదెషు ద్వారా అతనికి యోబాబు, జిబ్యా, మేషా, మల్కాము, <verse eid="1CH 8:9"/><verse number="10" style="v" sid="1CH 8:10"/>యెపూజు, షాక్యా, మిర్మాలు పుట్టారు. అతని కుమారులైన వీరు తమ కుటుంబాలకు పెద్దలు. <verse eid="1CH 8:10"/><verse number="11" style="v" sid="1CH 8:11"/>హుషీము ద్వారా అతనికి అబీటూబు, ఎల్పయలు పుట్టారు.<verse eid="1CH 8:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 8:12"/>ఎల్పయలు కుమారులు:</para>
  <para style="li2" vid="1CH 8:12">ఏబెరు, మిషాము, షెమెదు (ఓనో, లోదు అనే ఊళ్ళను వాటి చుట్టూ ఉన్న గ్రామాలను కట్టించిన వాడు), <verse eid="1CH 8:12"/><verse number="13" style="v" sid="1CH 8:13"/>బెరీయా, షెమ. వీరు అయ్యాలోనులో నివసిస్తున్నవారి కుటుంబాలకు పెద్దలు, గాతు పట్టణస్థులను వెళ్లగొట్టారు.<verse eid="1CH 8:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 8:14"/>అహ్యో, షాషకు, యెరేమోతు, <verse eid="1CH 8:14"/><verse number="15" style="v" sid="1CH 8:15"/>జెబద్యా, అరాదు, ఏదెరు, <verse eid="1CH 8:15"/><verse number="16" style="v" sid="1CH 8:16"/>మిఖాయేలు, ఇష్పా, యోహా అనేవారు బెరీయా కుమారులు.<verse eid="1CH 8:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 8:17"/>జెబద్యా, మెషుల్లాము, హిజికీ, హెబెరు, <verse eid="1CH 8:17"/><verse number="18" style="v" sid="1CH 8:18"/>ఇష్మెరై, ఇజ్లీయా, యోబాబు అనేవారు ఎల్పయలు కుమారులు.<verse eid="1CH 8:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 8:19"/>యాకీము, జిఖ్రీ, జబ్ది, <verse eid="1CH 8:19"/><verse number="20" style="v" sid="1CH 8:20"/>ఎలీయేనై, జిల్లెతై, ఎలీయేలు, <verse eid="1CH 8:20"/><verse number="21" style="v" sid="1CH 8:21"/>అదాయా, బెరాయా, షిమ్రాతు అనేవారు షిమీ కుమారులు.<verse eid="1CH 8:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 8:22"/>ఇష్పాను, ఏబెరు, ఎలీయేలు, <verse eid="1CH 8:22"/><verse number="23" style="v" sid="1CH 8:23"/>అబ్దోను, జిఖ్రీ, హానాను, <verse eid="1CH 8:23"/><verse number="24" style="v" sid="1CH 8:24"/>హనన్యా, ఏలాము, అంతోతీయా, <verse eid="1CH 8:24"/><verse number="25" style="v" sid="1CH 8:25"/>ఇఫెదయా, పెనూయేలు అనేవారు షాషకు కుమారులు.<verse eid="1CH 8:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 8:26"/>షంషెరై, షెహర్యా, అతల్యా, <verse eid="1CH 8:26"/><verse number="27" style="v" sid="1CH 8:27"/>యయరెష్యా, ఏలీయా, జిఖ్రీ అనేవారు యెరోహాము కుమారులు.<verse eid="1CH 8:27"/></para>
  <para style="lf">
    <verse number="28" style="v" sid="1CH 8:28"/>వీరందరు తమ వంశావళి ప్రకారం కుటుంబాలకు పెద్దలు, ప్రముఖులు; వీరు యెరూషలేములో నివసించారు.<verse eid="1CH 8:28"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 8:29"/>గిబియోను తండ్రియైన<note caller="+" style="f"><char style="fr" closed="false">8:29 </char><char style="fq" closed="false">తండ్రి </char><char style="fqa" closed="false">బహుశ ప్రజ నాయకుడు </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">సైన్య అధికారి</char></note> యెహీయేలు<note caller="+" style="f"><char style="fr" closed="false">8:29 </char><char style="ft" closed="false">కొ.ప్ర.లలో, యెహీయేలు లేదు</char></note> గిబియోనులో నివసించాడు.</para>
  <para style="li2" vid="1CH 8:29">అతని భార్యపేరు మయకా. <verse eid="1CH 8:29"/><verse number="30" style="v" sid="1CH 8:30"/>అతని మొదటి కుమారుడు అబ్దోను. తర్వాత సూరు, కీషు, బయలు, నేరు, నాదాబు, <verse eid="1CH 8:30"/><verse number="31" style="v" sid="1CH 8:31"/>గెదోరు, అహ్యో, జెకెరు, <verse eid="1CH 8:31"/><verse number="32" style="v" sid="1CH 8:32"/>షిమ్యా తండ్రియైన మిక్లోతు పుట్టారు. వీరు కూడా యెరూషలేములో తమ బంధువులకు దగ్గరలో నివసించారు.<verse eid="1CH 8:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 8:33"/>నేరు కీషుకు తండ్రి, కీషు సౌలుకు తండ్రి, యోనాతాను, మల్కీ-షూవ, అబీనాదాబు, ఎష్-బయలు<note caller="+" style="f"><char style="fr" closed="false">8:33 </char><char style="ft" closed="false">ఇష్-బోషెతు అని కూడా పిలువబడ్డాడు</char></note> అనేవారు సౌలు కుమారులు.<verse eid="1CH 8:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 8:34"/>యోనాతాను కుమారుడు:</para>
  <para style="li2" vid="1CH 8:34">మెరీబ్-బయలు,<note caller="+" style="f"><char style="fr" closed="false">8:34 </char><char style="ft" closed="false">మెఫీబోషెతు అని కూడా పిలువబడ్డాడు</char></note> ఇతడు మీకాకు తండ్రి.<verse eid="1CH 8:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 8:35"/>మీకా కుమారులు:</para>
  <para style="li2" vid="1CH 8:35">పీతోను, మెలెకు, తరేయ, ఆహాజు.<verse eid="1CH 8:35"/></para>
  <para style="li2">
    <verse number="36" style="v" sid="1CH 8:36"/>ఆహాజు యెహోయాదాకు తండ్రి, ఆలెమెతు, అజ్మావెతు, జిమ్రీలకు తండ్రి, జిమ్రీ మోజా అనేవారు యెహోయాదా కుమారులు. <verse eid="1CH 8:36"/><verse number="37" style="v" sid="1CH 8:37"/>మోజా బిన్యాకు తండ్రి; అతని కుమారుడు రాపా, అతని కుమారుడు ఎలాశా, అతని కుమారుడు ఆజేలు.<verse eid="1CH 8:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 8:38"/>ఆజేలు కుమారులు ఆరుగురు, వారి పేర్లు ఇవి:</para>
  <para style="li2" vid="1CH 8:38">అజ్రీకాము, బోకెరు, ఇష్మాయేలు, షెయర్యా, ఓబద్యా, హనాను. వీరందరు ఆజేలు కుమారులు.<verse eid="1CH 8:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 8:39"/>అతని సోదరుడైన ఏషెకు కుమారులు:</para>
  <para style="li2" vid="1CH 8:39">మొదటివాడు ఊలాము, రెండవవాడు యెహూషు, మూడవవాడు ఎలీఫెలెతు. <verse eid="1CH 8:39"/><verse number="40" style="v" sid="1CH 8:40"/>ఊలాము కుమారులు పరాక్రమశాలులు, విల్లువిద్యలో ప్రవీణులు. వారికి నూటయాభైమంది కుమారులు, మనుమలు ఉన్నారు.</para>
  <para style="li1" vid="1CH 8:40">వీరందరు బెన్యామీను వారసులు.<verse eid="1CH 8:40"/></para>
  <para style="b"/>
  <chapter eid="1CH 8"/>
  <chapter number="9" style="c" sid="1CH 9"/>
  <para style="p">
    <verse number="1" style="v" sid="1CH 9:1"/>ఇశ్రాయేలు ప్రజలందరి పేర్లు తమ వంశాల ప్రకారం ఇశ్రాయేలు యూదా రాజుల గ్రంథంలో వ్రాయబడ్డాయి. వారు చేసిన నమ్మకద్రోహాన్ని బట్టి వారు బబులోనుకు బందీలుగా కొనిపోబడ్డారు.<verse eid="1CH 9:1"/></para>
  <para style="s1">యెరూషలేములో ఉన్న ప్రజలు</para>
  <para style="lh">
    <verse number="2" style="v" sid="1CH 9:2"/>తమ సొంత పట్టణాల్లో తమ స్వాస్థ్యంలో మొదట నివసించిన వారెవరంటే, కొందరు ఇశ్రాయేలీయులు, యాజకులు, లేవీయులు, ఆలయ సేవకులు.<verse eid="1CH 9:2"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="3" style="v" sid="1CH 9:3"/>యూదా, బెన్యామీను, ఎఫ్రాయిం మనష్షే వారిలో యెరూషలేము పట్టణంలో నివసించినవారు:<verse eid="1CH 9:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 9:4"/>యూదా కుమారుడైన పెరెసు వారసుడు బానీ కుమారుడైన ఇమ్రీకి పుట్టిన ఒమ్రీ కుమారుడైన అమీహూదు పుట్టిన ఊతై.<verse eid="1CH 9:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 9:5"/>షేలానీయుల<note caller="+" style="f"><char style="fr" closed="false">9:5 </char><char style="ft" closed="false">హెబ్రీలో </char><char style="fqa" closed="false">షిలోనీయులు </char><char style="ft" closed="false"><char style="xt"><ref loc="NUM 26:20">సంఖ్యా 26:20</ref></char> చూడండి</char></note> నుండి:</para>
  <para style="li2" vid="1CH 9:5">మొదట కుమారుడైన అశాయా, అతని కుమారులు.<verse eid="1CH 9:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 9:6"/>జెరహు వారిలో నుండి:</para>
  <para style="li2" vid="1CH 9:6">యెవుయేలు.</para>
  <para style="lf" vid="1CH 9:6">యూదా నుండి మొత్తం 690 మంది.<verse eid="1CH 9:6"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="7" style="v" sid="1CH 9:7"/>బెన్యామీనీయుల నుండి:</para>
  <para style="li1" vid="1CH 9:7">హస్సెనూయా కుమారుడైన హోదవ్యాకు పుట్టిన మెషుల్లాము కుమారుడైన సల్లు;<verse eid="1CH 9:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 9:8"/>యెరోహాము కుమారుడైన ఇబ్నియా;</para>
  <para style="li1" vid="1CH 9:8">మిక్రి కుమారుడైన ఉజ్జీకి పుట్టిన ఏలా;</para>
  <para style="li1" vid="1CH 9:8">ఇబ్నెయా కుమారుడైన రెయూయేలుకు పుట్టిన షెఫట్యా కుమారుడైన మెషుల్లాము.<verse eid="1CH 9:8"/></para>
  <para style="lf">
    <verse number="9" style="v" sid="1CH 9:9"/>తమ వంశావళి ప్రకారం బెన్యామీను నుండి ప్రజలు మొత్తం 956 మంది. వీరందరు తమ తమ కుటుంబాలకు పెద్దలు.<verse eid="1CH 9:9"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="10" style="v" sid="1CH 9:10"/>యాజకుల నుండి:</para>
  <para style="li1" vid="1CH 9:10">యెదాయా; యెహోయారీబు; యాకీను;<verse eid="1CH 9:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 9:11"/>అహీటూబు కుమారుడైన మెరాయోతుకు పుట్టిన సాదోకు కుమారుడు మెషుల్లాము పుట్టిన హిల్కీయా కుమారుడైన అజర్యా; ఇతడు దేవుని మందిరంలో ప్రముఖ అధిపతి;<verse eid="1CH 9:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 9:12"/>మల్కీయా కుమారుడైన పషూరుకు పుట్టిన యెరోహాము కుమారుడు అదాయా;</para>
  <para style="li1" vid="1CH 9:12">ఇమ్మేరు కుమారుడైన మెషిల్లేమీతుకు పుట్టిన మెషుల్లాము కుమారుడైన యహజెరాకు పుట్టిన అదీయేలు కుమారుడైన మశై;<verse eid="1CH 9:12"/></para>
  <para style="lf">
    <verse number="13" style="v" sid="1CH 9:13"/>తమ కుటుంబాలకు పెద్దలుగా ఉన్న యాజకుల సంఖ్య 1,760. వారు దేవుని మందిరంలో సేవలు అందించే బాధ్యత కలిగిన సమర్థులు.<verse eid="1CH 9:13"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="14" style="v" sid="1CH 9:14"/>లేవీయుల నుండి:</para>
  <para style="li1" vid="1CH 9:14">మెరారీయుడైన హషబ్యా కుమారుడైన అజ్రీకాముకు పుట్టిన హష్షూబు కుమారుడైన షెమయా;<verse eid="1CH 9:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 9:15"/>బక్బక్కరు, హెరెషు, గాలాలు, ఆసాపు కుమారుడైన జిఖ్రీకి పుట్టిన మీకా కుమారుడైన మత్తన్యా;<verse eid="1CH 9:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 9:16"/>యెదూతూను కుమారుడైన గాలాలుకు పుట్టిన షెమయా కుమారుడైన ఓబద్యా;</para>
  <para style="li1" vid="1CH 9:16">ఎల్కానాకు పుట్టిన ఆసా కుమారుడైన బెరెక్యా; ఇతడు నెటోపాతీయుల గ్రామాల్లో నివసించాడు.<verse eid="1CH 9:16"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="17" style="v" sid="1CH 9:17"/>ద్వారపాలకులు:</para>
  <para style="li1" vid="1CH 9:17">షల్లూము, అక్కూబు, టల్మోను, అహీమాను, వారి తోటి లేవీయులు. వీరిలో షల్లూము పెద్ద. <verse eid="1CH 9:17"/><verse number="18" style="v" sid="1CH 9:18"/>వారు తూర్పున ఉన్న రాజు ద్వారం దగ్గర ఇప్పటివరకు సేవ చేస్తున్నారు. వీరందరు లేవీయుల సమూహానికి చెందిన ద్వారపాలకులు.<verse eid="1CH 9:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 9:19"/>కోరహు కుమారుడైన ఎబ్యాసాపుకు పుట్టిన కోరే కుమారుడైన షల్లూము, తన కోరహీయుల వంశంలోని తన తోటి ద్వారపాలకులు, తమ పూర్వికులు యెహోవా శిబిరానికి కావలివారిగా ఉన్నట్లుగా, వారు ఆలయద్వారాన్ని కాపలా కాసేవారు.<verse eid="1CH 9:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 9:20"/>పూర్వకాలంలో ఎలియాజరు కుమారుడైన ఫీనెహాసు ద్వారపాలకుల మీద అధికారిగా ఉన్నాడు. యెహోవా అతనికి తోడుగా ఉన్నారు.<verse eid="1CH 9:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 9:21"/>మెషెలెమ్యా కుమారుడైన జెకర్యా సమావేశ గుడారపు ద్వారానికి ద్వారపాలకుడు.<verse eid="1CH 9:21"/></para>
  <para style="lf">
    <verse number="22" style="v" sid="1CH 9:22"/>ద్వారాల దగ్గర ద్వారపాలకులుగా ఎన్నుకోబడినవారు 212 మంది. వారు తమ గ్రామాల్లో తమ వంశాల ప్రకారం నమోదు చేయబడ్డారు.</para>
  <para style="b" vid="1CH 9:22"/>
  <para style="p" vid="1CH 9:22">వారు నమ్మకమైన వారని దావీదు, దీర్ఘదర్శియైన సమూయేలు వారిని ఆ స్థానాల్లో నియమించారు. <verse eid="1CH 9:22"/><verse number="23" style="v" sid="1CH 9:23"/>వారు వారి వారసులు సమావేశపు గుడారం అని పిలువబడే యెహోవా మందిరపు ద్వారాలకు కాపలా కాసే బాధ్యత కలిగి ఉన్నారు. <verse eid="1CH 9:23"/><verse number="24" style="v" sid="1CH 9:24"/>ద్వారపాలకులు నలువైపులా ఉన్నారు అనగా తూర్పు, పడమర, ఉత్తరం, దక్షిణం వైపు ఉన్నారు. <verse eid="1CH 9:24"/><verse number="25" style="v" sid="1CH 9:25"/>వారి గ్రామాల్లో ఉండే వారి తోటి లేవీయులు క్రమంగా వస్తూ ఏడు రోజులపాటు తమ విధులను పంచుకునేవారు. <verse eid="1CH 9:25"/><verse number="26" style="v" sid="1CH 9:26"/>అయితే లేవీయులైన నలుగురు ప్రధాన ద్వారపాలకులు నమ్మకమైనవారు కాబట్టి దేవుని మందిరపు గదులకు, ఖజానాకు సంబంధించిన బాధ్యత వారికి ఇవ్వబడింది. <verse eid="1CH 9:26"/><verse number="27" style="v" sid="1CH 9:27"/>వారు దేవుని ఆలయానికి కావలివారు కాబట్టి దాని దగ్గరే రాత్రంతా ఉండేవారు; ప్రతి ఉదయం దాని తలుపులు తెరిచే బాధ్యత వారిదే.<verse eid="1CH 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1CH 9:28"/>వారిలో కొందరికి ఆలయ సేవలో ఉపయోగించే వస్తువుల బాధ్యత ఇవ్వబడింది; వాటిని లోపలికి తెచ్చినప్పుడు బయటకు తీసుకెళ్లినప్పుడు వారు వాటిని లెక్కించేవారు. <verse eid="1CH 9:28"/><verse number="29" style="v" sid="1CH 9:29"/>ఇతరులకు ఉపకరణాలు, పరిశుద్ధాలయంలో ఉన్న ఇతర వస్తువులన్నిటి బాధ్యత ఇవ్వబడింది. వాటితో పాటు సన్నని పిండి, ద్రాక్షరసం, ఒలీవనూనె, ధూపద్రవ్యాలు, సుగంధద్రవ్యాలు వారి ఆధీనంలోనే ఉంటాయి. <verse eid="1CH 9:29"/><verse number="30" style="v" sid="1CH 9:30"/>అయితే యాజకులలో కొంతమంది సుగంధ ద్రవ్యాల మిశ్రమాన్ని చేసేవారు. <verse eid="1CH 9:30"/><verse number="31" style="v" sid="1CH 9:31"/>కోరహు వంశీయుడైన షల్లూము మొదటి కుమారుడైన మత్తిత్యా అనే లేవీయుడు నమ్మకమైనవాడు కాబట్టి అతనికి అర్పణల రొట్టెలు తయారుచేసే బాధ్యత ఇవ్వబడింది. <verse eid="1CH 9:31"/><verse number="32" style="v" sid="1CH 9:32"/>వారి తోటి లేవీయులైన కహాతీయులలో కొందరికి ప్రతి సబ్బాతు దినం కోసం బల్లపై ఉంచే రొట్టెలు సిద్ధం చేసే బాధ్యత ఇవ్వబడింది.<verse eid="1CH 9:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CH 9:33"/>లేవీయుల కుటుంబ పెద్దలలో సంగీతకారులు దేవాలయపు గదుల్లో ఉండేవారు. వారు రాత్రింబగళ్ళు పని చేయాలి కాబట్టి వారికి వేరే ఏ పని అప్పగించబడలేదు.<verse eid="1CH 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1CH 9:34"/>వీరందరు లేవీయుల కుటుంబ పెద్దలు, తమ వంశం ప్రకారం నాయకులు. వారు యెరూషలేములో నివసించారు.<verse eid="1CH 9:34"/></para>
  <para style="s1">సౌలు వంశావళి</para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 9:35"/>గిబియోను తండ్రియైన యెహీయేలు గిబియోనులో నివసించాడు.</para>
  <para style="li2" vid="1CH 9:35">అతని భార్యపేరు మయకా. <verse eid="1CH 9:35"/><verse number="36" style="v" sid="1CH 9:36"/>అతని మొదటి కుమారుడు అబ్దోను, తర్వాత సూరు, కీషు, బయలు, నేరు, నాదాబు, <verse eid="1CH 9:36"/><verse number="37" style="v" sid="1CH 9:37"/>గెదోరు, అహ్యో, జెకర్యా, మిక్లోతు పుట్టారు. <verse eid="1CH 9:37"/><verse number="38" style="v" sid="1CH 9:38"/>మిక్లోతు షిమ్యాముకు తండ్రి. వీరు కూడా యెరూషలేములో తమ బంధువులకు దగ్గరలో నివసించారు.<verse eid="1CH 9:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 9:39"/>నేరు కీషుకు తండ్రి, కీషు సౌలుకు తండ్రి, యోనాతాను, మల్కీ-షూవ, అబీనాదాబు, ఎష్-బయలు<note caller="+" style="f"><char style="fr" closed="false">9:39 </char><char style="ft" closed="false">ఇష్-బోషెతు అని కూడా పిలిచేవారు</char></note> అనేవారు సౌలు కుమారులు.<verse eid="1CH 9:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 9:40"/>యోనాతాను కుమారుడు:</para>
  <para style="li2" vid="1CH 9:40">మెరీబ్-బయలు,<note caller="+" style="f"><char style="fr" closed="false">9:40 </char><char style="ft" closed="false">మెఫీబోషెతు అని కూడా పిలిచేవారు</char></note> ఇతడు మీకాకు తండ్రి.<verse eid="1CH 9:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 9:41"/>మీకా కుమారులు:</para>
  <para style="li2" vid="1CH 9:41">పీతోను, మెలెకు, తరేయా, ఆహాజు.<verse eid="1CH 9:41"/></para>
  <para style="li2">
    <verse number="42" style="v" sid="1CH 9:42"/>ఆహాజు యదాకు<note caller="+" style="f"><char style="fr" closed="false">9:42 </char><char style="ft" closed="false">కొ.ప్ర.లలో </char><char style="fqa" closed="false">యరా</char></note> తండ్రి, ఆలెమెతు, అజ్మావెతు, జిమ్రీలకు తండ్రి. జిమ్రీ మోజా అనేవారు యదా కుమారులు. <verse eid="1CH 9:42"/><verse number="43" style="v" sid="1CH 9:43"/>మోజా బిన్యాకు తండ్రి; బిన్యా కుమారుడు రెఫాయా, అతని కుమారుడు ఎలాశా, అతని కుమారుడు ఆజేలు.<verse eid="1CH 9:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 9:44"/>ఆజేలు కుమారులు ఆరుగురు. వారి పేర్లు ఇవి:</para>
  <para style="li2" vid="1CH 9:44">అజ్రీకాము, బోకెరు, ఇష్మాయేలు, షెయర్యా, ఓబద్యా, హనాను. వీరు ఆజేలు కుమారులు.<verse eid="1CH 9:44"/></para>
  <chapter eid="1CH 9"/>
  <chapter number="10" style="c" sid="1CH 10"/>
  <para style="s1">సౌలు తన ప్రాణాన్ని తీసికొనుట</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 10:1"/>ఫిలిష్తీయులు ఇశ్రాయేలీయులతో యుద్ధం చేశారు; వారి ఎదుట నుండి ఇశ్రాయేలీయులు పారిపోయారు, చాలామంది గిల్బోవ పర్వతం మీద చచ్చి పడిపోయారు. <verse eid="1CH 10:1"/><verse number="2" style="v" sid="1CH 10:2"/>ఫిలిష్తీయులు సౌలును అతని కుమారులను తరిమి అతని కుమారులైన యోనాతాను, అబీనాదాబు, మల్కీ-షూవలను చంపేశారు. <verse eid="1CH 10:2"/><verse number="3" style="v" sid="1CH 10:3"/>సౌలు చుట్టూ యుద్ధం తీవ్రమయ్యింది, బాణాలు వేసేవారు అతన్ని చూసి అతన్ని గాయపరిచారు.<verse eid="1CH 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 10:4"/>సౌలు తన ఆయుధాలు మోసేవానితో, “నీ కత్తి దూసి నన్ను పొడవు, లేకపోతే సున్నతిలేని వీరు వచ్చి నన్ను దూషిస్తారు” అని అన్నాడు.</para>
  <para style="p" vid="1CH 10:4">కాని ఆ ఆయుధాలు మోసేవాడు చాలా భయపడి దానికి ఒప్పుకోలేదు; కాబట్టి సౌలు తన కత్తి తీసుకుని దాని మీద పడ్డాడు. <verse eid="1CH 10:4"/><verse number="5" style="v" sid="1CH 10:5"/>ఆయుధాలు మోసేవాడు సౌలు చనిపోయాడని చూసి అతడు కూడా తన కత్తి మీద పడి చనిపోయాడు. <verse eid="1CH 10:5"/><verse number="6" style="v" sid="1CH 10:6"/>సౌలు, అతని ముగ్గురు కుమారులు, అతని ఇంటివారందరు ఒకేసారి చనిపోయారు.<verse eid="1CH 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 10:7"/>సైన్యం పారిపోయిందని, సౌలు అతని కుమారులు చనిపోయారని లోయలో ఉన్న ఇశ్రాయేలీయులందరు తెలుసుకున్నప్పుడు, వారు తమ పట్టణాలను విడిచి పారిపోయారు. ఫిలిష్తీయులు వచ్చి వాటిని ఆక్రమించుకున్నారు.<verse eid="1CH 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 10:8"/>మరుసటిరోజు చనిపోయినవారిని దోచుకోడానికి ఫిలిష్తీయులు వచ్చినప్పుడు, వారు గిల్బోవ పర్వతం మీద పడి ఉన్న సౌలును, అతని కుమారులను చూశారు. <verse eid="1CH 10:8"/><verse number="9" style="v" sid="1CH 10:9"/>వారు అతన్ని దోచుకుని అతని తలను, అతని ఆయుధాలను తీసుకెళ్లి, తమ విగ్రహాల మధ్య, తమ ప్రజలమధ్య ఈ వార్త తెలియజేయడానికి ఫిలిష్తీయ దేశంలో నలుదిక్కులకు దూతలను పంపారు. <verse eid="1CH 10:9"/><verse number="10" style="v" sid="1CH 10:10"/>వారు అతని ఆయుధాలను తమ దేవుళ్ళ గుడిలో పెట్టి అతని తలను దాగోను గుడిలో వ్రేలాడదీశారు.<verse eid="1CH 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 10:11"/>ఫిలిష్తీయులు సౌలుకు చేసిన దాని గురించి యాబేషు గిలాదు వాసులందరు విన్నప్పుడు, <verse eid="1CH 10:11"/><verse number="12" style="v" sid="1CH 10:12"/>వారి బలశాలులంతా వెళ్లి సౌలు శవాన్ని, అతని కుమారుల శవాలను యాబేషుకు తీసుకువచ్చి వారి ఎముకలు తీసుకుని యాబేషులోని సింధూర వృక్షం క్రింద పాతిపెట్టి, ఏడు రోజులు ఉపవాసమున్నారు.<verse eid="1CH 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 10:13"/>యెహోవాకు నమ్మకద్రోహిగా ఉన్నందుకు సౌలు చనిపోయాడు; అతడు యెహోవా వాక్కును పాటించకుండా సలహా కోసం ఆత్మలతో మాట్లాడేవారి దగ్గరకు వెళ్లాడు. <verse eid="1CH 10:13"/><verse number="14" style="v" sid="1CH 10:14"/>యెహోవా దగ్గర విచారణ చేయలేదు. కాబట్టి యెహోవా అతనికి మరణశిక్ష విధించి రాజ్యాన్ని యెష్షయి కుమారుడైన దావీదుకు అప్పగించారు.<verse eid="1CH 10:14"/></para>
  <chapter eid="1CH 10"/>
  <chapter number="11" style="c" sid="1CH 11"/>
  <para style="s1">ఇశ్రాయేలు మీద రాజైన దావీదు</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 11:1"/>ఇశ్రాయేలీయులందరు హెబ్రోనులో దావీదు దగ్గరకు వచ్చి, “మేము నీ రక్తసంబంధులము. <verse eid="1CH 11:1"/><verse number="2" style="v" sid="1CH 11:2"/>గతంలో సౌలు రాజుగా ఉన్నప్పటికీ, ఇశ్రాయేలు సైన్యాన్ని నీవే నడిపించావు. నీ దేవుడైన యెహోవా నీతో, ‘నా ప్రజలైన ఇశ్రాయేలీయులకు నీవు కాపరిగా ఉంటావు, వారిని పరిపాలిస్తావు’ అని చెప్పారు” అని అన్నారు.<verse eid="1CH 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 11:3"/>ఇశ్రాయేలు పెద్దలందరు హెబ్రోనులో ఉన్న రాజైన దావీదు దగ్గరకు వచ్చినప్పుడు, అతడు హెబ్రోనులో యెహోవా ఎదుట వారితో ఒక ఒడంబడిక చేశాడు. యెహోవా సమూయేలు ద్వారా వాగ్దానం చేసినట్టే వారు దావీదును ఇశ్రాయేలుకు రాజుగా అభిషేకించారు.<verse eid="1CH 11:3"/></para>
  <para style="s1">దావీదు యెరూషలేమును జయించుట</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 11:4"/>దావీదు ఇశ్రాయేలీయులందరు యెబూసు అని కూడా పిలువబడే యెరూషలేముకు వెళ్లారు. యెబూసీయులు అక్కడ నివసిస్తున్నారు. <verse eid="1CH 11:4"/><verse number="5" style="v" sid="1CH 11:5"/>అప్పుడు యెబూసీయులు దావీదుతో, “నీవు లోపలికి రాలేవు” అన్నారు. అయినా దావీదు సీయోను కోటను స్వాధీనం చేసుకున్నాడు. దానిని దావీదు పట్టణం అంటారు.<verse eid="1CH 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 11:6"/>దావీదు, “ఎవడు మొదట యెబూసీయులపై దాడి చేస్తాడో వాడు ప్రముఖ సైన్యాధిపతి అవుతాడు” అని అన్నప్పుడు సెరూయా కుమారుడైన యోవాబు అందరికంటే ముందుగా దాడి చేసి అధిపతి అయ్యాడు.<verse eid="1CH 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 11:7"/>దావీదు కోటలో నివాసం ఏర్పరచుకున్నాడు కాబట్టి దానికి దావీదు పట్టణం అని పేరు వచ్చింది. <verse eid="1CH 11:7"/><verse number="8" style="v" sid="1CH 11:8"/>అతడు మిద్దె<note caller="+" style="f"><char style="fr" closed="false">11:8 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">మిల్లో</char></note> నుండి దాని చుట్టూ పట్టణాన్ని కట్టించగా యోవాబు మిగతా పట్టణ భాగాలను బాగుచేయించాడు. <verse eid="1CH 11:8"/><verse number="9" style="v" sid="1CH 11:9"/>సైన్యాల యెహోవా అతనికి తోడుగా ఉన్నారు కాబట్టి దావీదు అంతకంతకు శక్తిమంతుడయ్యాడు.<verse eid="1CH 11:9"/></para>
  <para style="s1">దావీదు యొక్క గొప్ప వీరులు</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 11:10"/>ఇశ్రాయేలుకు యెహోవా వాగ్దానం చేసిన ప్రకారం దావీదును ఆ ప్రాంతమంతటికి రాజుగా చేయడానికి అతనికి ఇశ్రాయేలు వారందరితో కలిసి సహాయం చేసిన వీరులలో ప్రధానులు వీరు. <verse eid="1CH 11:10"/><verse number="11" style="v" sid="1CH 11:11"/>ఇది దావీదు యొక్క పరాక్రమశాలుల జాబితా:</para>
  <para style="p" vid="1CH 11:11">అధికారులలో ముఖ్యుడు, హక్మోనీయుడైన కుమారుడైన యషోబీము;<note caller="+" style="f"><char style="fr" closed="false">11:11 </char><char style="ft" closed="false">బహుశ </char><char style="fqa" closed="false">యషోబ్ బయలు </char><char style="ft" closed="false">యొక్క మరో రూపం కావచ్చు</char></note> అతడు తన ఈటెతో ఒకే యుద్ధంలో మూడువందల మందిని చంపాడు.<verse eid="1CH 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 11:12"/>అతని తర్వాత శ్రేణిలో అహోహీయుడైన దోదో<note caller="+" style="f"><char style="fr" closed="false">11:12 </char><char style="ft" closed="false">దీనికి మరో రూపం </char><char style="fqa" closed="false">దోదయి</char></note> కుమారుడైన ఎలియాజరు, ఇతడు ముగ్గురు యోధులలో ఒకడు. <verse eid="1CH 11:12"/><verse number="13" style="v" sid="1CH 11:13"/>ఒకసారి ఫిలిష్తీయులు పస్ దమ్మీములో యుద్ధానికి వచ్చినప్పుడు అతడు దావీదుతో పాటు ఉన్నాడు. యవలు నిండి ఉన్న పొలం దగ్గర ఫిలిష్తీయులను చూసి ఇశ్రాయేలు దళాలు పారిపోయారు. <verse eid="1CH 11:13"/><verse number="14" style="v" sid="1CH 11:14"/>కాని వీరు పొలం మధ్యలో నిలబడి, దానిని కాపాడి ఫిలిష్తీయులను చంపారు. యెహోవా వారికి గొప్ప విజయాన్ని ఇచ్చారు.<verse eid="1CH 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 11:15"/>ముప్పైమంది ప్రముఖులలో ముగ్గురు అదుల్లాము అనే రాతి గుహలో ఉన్న దావీదు దగ్గరకు వచ్చారు. అప్పుడు ఫిలిష్తీయుల సైనికుల గుంపు రెఫాయీము లోయలో శిబిరం ఏర్పరచుకుంది. <verse eid="1CH 11:15"/><verse number="16" style="v" sid="1CH 11:16"/>ఆ సమయంలో దావీదు సురక్షితమైన స్థావరంలో ఉన్నాడు. ఫిలిష్తీయుల దండు బేత్లెహేములో ఉంది. <verse eid="1CH 11:16"/><verse number="17" style="v" sid="1CH 11:17"/>దావీదు నీళ్ల కోసం ఆరాటపడుతూ, “బేత్లెహేము ద్వారం దగ్గర ఉన్న బావి నీళ్లు ఎవరైనా నాకు తెచ్చి ఇస్తే ఎంత బాగుండేది!” అన్నాడు. <verse eid="1CH 11:17"/><verse number="18" style="v" sid="1CH 11:18"/>అప్పుడు ఆ ముగ్గురు ఫిలిష్తీయుల శిబిరం గుండా చొరబడి బేత్లెహేము ద్వారం దగ్గర ఉన్న బావి నీళ్లు తోడుకొని దావీదుకు తెచ్చి ఇచ్చారు. అయితే అతడు ఆ నీళ్లు త్రాగడానికి నిరాకరించాడు; బదులుగా వాటిని యెహోవాకు అర్పణగా పారబోశాడు. <verse eid="1CH 11:18"/><verse number="19" style="v" sid="1CH 11:19"/>“నేను ఈ నీళ్లు త్రాగకుండా నా దేవుడు నన్ను కాపాడును గాక! ప్రాణానికి తెగించి వెళ్లి ఈ నీళ్లు తెచ్చిన ఈ మనుష్యుల రక్తాన్ని నేను త్రాగాలా?” అన్నాడు. వాటిని తీసుకురావడానికి వారు తమ ప్రాణాలకు తెగించి తెచ్చారు కాబట్టి దావీదు ఆ నీళ్లు త్రాగలేదు.</para>
  <para style="p" vid="1CH 11:19">ఆ ముగ్గురు పరాక్రమ యోధులు చేసిన సాహసాలు ఇలాంటివి.<verse eid="1CH 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 11:20"/>యోవాబు సోదరుడైన అబీషై ఆ ముగ్గురికి నాయకుడు. ఒక యుద్ధంలో అతడు తన ఈటెను ఆడిస్తూ మూడువందల మందిని చంపాడు కాబట్టి అతడు ఆ ముగ్గురిలా ప్రసిద్ధి పొందాడు. <verse eid="1CH 11:20"/><verse number="21" style="v" sid="1CH 11:21"/>అతడు ఆ ముగ్గురికంటే రెండింతలు గౌరవించబడి వారి దళాధిపతి అయ్యాడు కాని వారిలో ఒకనిగా చేర్చబడలేదు.<verse eid="1CH 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 11:22"/>గొప్ప పోరాట వీరుడు, కబ్సెయేలుకు చెందిన యెహోయాదా కుమారుడైన బెనాయా గొప్ప సాహస కార్యాలను చేశాడు. అతడు మోయాబు యొక్క పరాక్రమశాలులైన ఇద్దరిని చంపాడు. అంతేకాక, మంచుపడే కాలంలో ఒక గుంటలోకి దిగి సింహాన్ని చంపాడు. <verse eid="1CH 11:22"/><verse number="23" style="v" sid="1CH 11:23"/>అతడు అయిదు మూరల<note caller="+" style="f"><char style="fr" closed="false">11:23 </char><char style="ft" closed="false">అంటే, సుమారు 7 అడుగుల 6 అంగుళాలు లేదా 2.3 మీటర్లు</char></note> ఎత్తున్న ఈజిప్టు వానిని చంపాడు. ఆ ఈజిప్టు వాని చేతిలో నేతపనివాని కర్రలాంటి ఈటె ఉన్నప్పటికీ, బెనాయా దుడ్డుకర్ర పట్టుకుని వాని మీదికి పోయాడు. ఆ ఈజిప్టు వాని చేతిలో ఉన్న ఈటెను లాక్కుని దానితోనే అతన్ని చంపాడు. <verse eid="1CH 11:23"/><verse number="24" style="v" sid="1CH 11:24"/>యెహోయాదా కుమారుడైన బెనాయా సాహస కార్యాలు ఇలాంటివి; అతడు కూడా ఆ ముగ్గురు గొప్ప యోధులతో పాటు ప్రసిద్ధి పొందాడు. <verse eid="1CH 11:24"/><verse number="25" style="v" sid="1CH 11:25"/>ఆ ముప్పైమందిలో ఘనతకెక్కాడు గాని, ఆ ముగ్గురి జాబితాలో చేర్చబడలేదు. దావీదు అతన్ని తన అంగరక్షకుల నాయకునిగా నియమించాడు.<verse eid="1CH 11:25"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="26" style="v" sid="1CH 11:26"/>పరాక్రమముగల బలాఢ్యులు వీరే:</para>
  <para style="b" vid="1CH 11:26"/>
  <para style="li1" vid="1CH 11:26">యోవాబు తమ్ముడైన అశాహేలు,</para>
  <para style="li1" vid="1CH 11:26">బేత్లెహేముకు చెందిన దోదో కుమారుడైన ఎల్హానాను,<verse eid="1CH 11:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 11:27"/>హరోరీయుడైన షమ్మోతు,</para>
  <para style="li1" vid="1CH 11:27">పెలోనీయుడైన హేలెస్సు,<verse eid="1CH 11:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 11:28"/>తెకోవాకు చెందిన ఇక్కేషు కుమారుడైన ఈరా,</para>
  <para style="li1" vid="1CH 11:28">అనాతోతుకు చెందిన అబీయెజెరు,<verse eid="1CH 11:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 11:29"/>హుషాతీయుడైన సిబ్బెకై,</para>
  <para style="li1" vid="1CH 11:29">అహోహీయుడైన ఈలై,<verse eid="1CH 11:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 11:30"/>నెటోపాతీయుడైన మహరై,</para>
  <para style="li1" vid="1CH 11:30">నెటోపాతీయుడైన బయనా కుమారుడు హేలెదు,<verse eid="1CH 11:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 11:31"/>బెన్యామీనీయుల గిబియాకు చెందిన రీబై కుమారుడు ఇత్తయి,</para>
  <para style="li1" vid="1CH 11:31">పిరాతోనీయుడైన బెనాయా,<verse eid="1CH 11:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 11:32"/>గాయషు కనుమలకు చెందిన హూరై,</para>
  <para style="li1" vid="1CH 11:32">అర్బాతీయుడైన అబీయేలు,<verse eid="1CH 11:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 11:33"/>బహరూమీయుడైన అజ్మావెతు,</para>
  <para style="li1" vid="1CH 11:33">షయల్బోనీయుడైన ఎల్యహ్బా,<verse eid="1CH 11:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 11:34"/>గిజోనీయుడైన హాషేము కుమారులు,</para>
  <para style="li1" vid="1CH 11:34">హరారీయుడైన షాగే కుమారుడైన యోనాతాను,<verse eid="1CH 11:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 11:35"/>హరారీయుడైన శాకారు కుమారుడైన అహీయాము,</para>
  <para style="li1" vid="1CH 11:35">ఊరు కుమారుడైన ఎలీపాలు,<verse eid="1CH 11:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 11:36"/>మెకేరాతీయుడైన హెఫెరు,</para>
  <para style="li1" vid="1CH 11:36">పెలోనీయుడైన అహీయా,<verse eid="1CH 11:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 11:37"/>కర్మెలీయుడైన హెజ్రో,</para>
  <para style="li1" vid="1CH 11:37">ఎజ్బయి కుమారుడైన నయరై,<verse eid="1CH 11:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="1CH 11:38"/>నాతాను సోదరుడైన యోవేలు,</para>
  <para style="li1" vid="1CH 11:38">హగ్రీ కుమారుడైన మిబ్హారు,<verse eid="1CH 11:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="1CH 11:39"/>అమ్మోనీయుడైన జెలెకు,</para>
  <para style="li1" vid="1CH 11:39">బెయేరోతీయుడైన నహరై, ఇతడు సెరూయా కుమారుడైన యోవాబు ఆయుధాలను మోసేవాడు,<verse eid="1CH 11:39"/></para>
  <para style="li1">
    <verse number="40" style="v" sid="1CH 11:40"/>ఇత్రీయుడైన ఈరా,</para>
  <para style="li1" vid="1CH 11:40">ఇత్రీయుడైన గారేబు,<verse eid="1CH 11:40"/></para>
  <para style="li1">
    <verse number="41" style="v" sid="1CH 11:41"/>హిత్తీయుడైన ఊరియా,</para>
  <para style="li1" vid="1CH 11:41">అహ్లయి కుమారుడైన జాబాదు,<verse eid="1CH 11:41"/></para>
  <para style="li1">
    <verse number="42" style="v" sid="1CH 11:42"/>రూబేనీయుడైన షీజా కుమారుడు రూబేనీయులకు పెద్దయైన అదీనా, అతనితో ఉన్న ముప్పైమంది,<verse eid="1CH 11:42"/></para>
  <para style="li1">
    <verse number="43" style="v" sid="1CH 11:43"/>మయకా కుమారుడైన హానాను,</para>
  <para style="li1" vid="1CH 11:43">మిత్నీయుడైన యెహోషాపాతు,<verse eid="1CH 11:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="1CH 11:44"/>ఆష్తెరాతీయుడైన ఉజ్జీయా,</para>
  <para style="li1" vid="1CH 11:44">అరోయేరీయుడైన హోతాము కుమారులైన షామా, యెహీయేలు,<verse eid="1CH 11:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="1CH 11:45"/>షిమ్రీ కుమారుడైన యెదీయవేలు,</para>
  <para style="li1" vid="1CH 11:45">అతని సోదరుడు తిజీయుడైన యోహా,<verse eid="1CH 11:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="1CH 11:46"/>మహవీయుడైన ఎలీయేలు,</para>
  <para style="li1" vid="1CH 11:46">ఎల్నయము కుమారులైన యెరీబై యోషవ్యా,</para>
  <para style="li1" vid="1CH 11:46">మోయాబీయుడైన ఇత్మా,<verse eid="1CH 11:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="1CH 11:47"/>ఎలీయేలు, ఓబేదు, మెజోబాయా వాడైన యయశీయేలు.<verse eid="1CH 11:47"/></para>
  <chapter eid="1CH 11"/>
  <chapter number="12" style="c" sid="1CH 12"/>
  <para style="s1">దావీదు దగ్గర చేరిన వీరులు</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 12:1"/>కీషు కుమారుడైన సౌలు దగ్గర నుండి బహిష్కరించబడి దావీదు సిక్లగులో ఉన్నప్పుడు అతని దగ్గరకు వచ్చినవారు వీరు (అతనికి యుద్ధంలో సహాయపడిన వీరులలో ఉన్నవారు; <verse eid="1CH 12:1"/><verse number="2" style="v" sid="1CH 12:2"/>వీరు బాణాలు ధరించి కుడిచేతితో ఎడమచేతితో బాణాలు వేయడంలో, వడిసెలతో రాళ్లు రువ్వడంలో సమర్థులు; వీరు బెన్యామీను గోత్రం నుండి వచ్చిన సౌలు బంధువులు):<verse eid="1CH 12:2"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 12:3"/>నాయకుడైన అహీయెజెరు, యోవాషు; వీరు గిబియోనీయుడైన షెమాయా కుమారులు;</para>
  <para style="li1" vid="1CH 12:3">అజ్మావెతు కుమారులైన యెజీయేలు, పెలెటు;</para>
  <para style="li1" vid="1CH 12:3">బెరాకా, అనాతోతీయుడైన యెహు, <verse eid="1CH 12:3"/><verse number="4" style="v" sid="1CH 12:4"/>ముప్పైమందిలో పరాక్రమశాలి, ముప్పైమందికి నాయకుడు, గిబియోనీయుడైన ఇష్మయా;</para>
  <para style="li1" vid="1CH 12:4">యిర్మీయా, యహజీయేలు, యోహానాను, గెదేరాతీయుడైన యోజాబాదు, <verse eid="1CH 12:4"/><verse number="5" style="v" sid="1CH 12:5"/>ఎలూజై, యెరీమోతు, బెయల్యా, షెమర్యా, హరీపీయుడైన షెఫట్యా;<verse eid="1CH 12:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 12:6"/>కోరహీయులైన ఎల్కానా, యెష్షీయా, అజరేలు, యోహెజెరు, యషోబీము;<verse eid="1CH 12:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 12:7"/>గెదోరు వాడైన యెరోహాము కుమారులైన యోహేలా, జెబద్యా.<verse eid="1CH 12:7"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="8" style="v" sid="1CH 12:8"/>కొంతమంది గాదీయులు తమ కూటమిని మార్చుకొని అరణ్యంలో సురక్షితమైన స్థలంలో ఉన్న దావీదు దగ్గర చేరారు. వారు పరాక్రమశాలులు, యుద్ధానికి సిద్ధపడినవారు, డాలు ఈటెలను వాడే సమర్థులు, వారు సింహం ముఖంలాంటి ముఖాలు కలిగి కొండల్లో ఉండే జింకలంత వేగంగా పరుగెత్తగలరు.<verse eid="1CH 12:8"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 12:9"/>వారెవరంటే, నాయకుడైన ఏజెరు,</para>
  <para style="li1" vid="1CH 12:9">రెండవవాడు ఓబద్యా, మూడవవాడు ఏలీయాబు,<verse eid="1CH 12:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 12:10"/>నాలుగవవాడు మిష్మన్నా, అయిదవవాడు యిర్మీయా,<verse eid="1CH 12:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 12:11"/>ఆరవవాడు అత్తయి, ఏడవవాడు ఎలీయేలు,<verse eid="1CH 12:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 12:12"/>ఎనిమిదవ వాడు యోహానాను, తొమ్మిదవ వాడు ఎల్జాబాదు,<verse eid="1CH 12:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 12:13"/>పదవ వాడు యిర్మీయా, పదకొండవ వాడు మక్బన్నయి.<verse eid="1CH 12:13"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="14" style="v" sid="1CH 12:14"/>ఈ గాదీయులు సైన్యాధిపతులు; వీరిలో చివరివాడు వందమందికి, అత్యధికుడు వెయ్యిమందికి అధిపతులుగా ఉన్నారు. <verse eid="1CH 12:14"/><verse number="15" style="v" sid="1CH 12:15"/>యొర్దాను నది గట్లమీదుగా పొర్లి పారుతున్నప్పుడు, మొదటి నెలలో దానిని దాటి వెళ్లి లోయల్లో తూర్పు నుండి పడమర వరకు ఉన్నవారినందరిని తరిమివేసింది వీరే.<verse eid="1CH 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 12:16"/>ఇతర బెన్యామీనీయులు, కొంతమంది యూదా వారు కూడా దావీదు ఉన్న సురక్షిత స్థలానికి వచ్చారు. <verse eid="1CH 12:16"/><verse number="17" style="v" sid="1CH 12:17"/>దావీదు వారిని కలుసుకోడానికి బయలుదేరి వెళ్లి వారితో, “మీరు సమాధానంతో నాకు సహాయం చేయడానికి నా దగ్గరకు వస్తే, మిమ్మల్ని నాతో చేర్చుకోవడానికి నేను సిద్ధంగా ఉన్నాను. అయితే నా వలన మీకు ప్రమాదమేమి లేదని తెలుసుకుని మీరు నన్ను శత్రువులకు అప్పగించడానికి వచ్చి ఉంటే, మన పూర్వికుల దేవుడు దానిని చూసి మీకు తీర్పు తీర్చును గాక” అన్నాడు.<verse eid="1CH 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 12:18"/>అప్పుడు ముప్పైమందికి నాయకుడైన అమాశై మీదికి ఆత్మ రాగా అతడు అన్నాడు:</para>
  <para style="q1" vid="1CH 12:18">“దావీదూ, మేము నీ వారము!</para>
  <para style="q2" vid="1CH 12:18">యెష్షయి కుమారుడా! మేము నీతో ఉన్నాము.</para>
  <para style="q1" vid="1CH 12:18">నీకు సమాధానం, సమాధానం,</para>
  <para style="q2" vid="1CH 12:18">నీ సహాయకులకు సమాధానం కలుగును,</para>
  <para style="q3" vid="1CH 12:18">నీ దేవుడే నీకు సహాయం చేస్తారు.”</para>
  <para style="p" vid="1CH 12:18">కాబట్టి దావీదు వారిని చేర్చుకొని తన బలగాలకు నాయకులుగా నియమించాడు.<verse eid="1CH 12:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 12:19"/>సౌలు మీద యుద్ధం చేయడానికి ఫిలిష్తీయులతో పాటు దావీదు బయలుదేరినప్పుడు, మనష్షే గోత్రంలోని కొంతమంది అతని పక్షం చేరారు. (దావీదు అతని మనుష్యులు ఫిలిష్తీయులకు సహాయం చేయలేదు, ఎందుకంటే ఫిలిష్తీయుల నాయకులు, “అతడు మళ్ళీ తన యజమానియైన సౌలు పక్షం చేరితే మనకు ప్రాణాపాయం కలుగుతుంది” అని భావించి దావీదును పంపివేశారు.) <verse eid="1CH 12:19"/><verse number="20" style="v" sid="1CH 12:20"/>దావీదు సిక్లగుకు వెళ్లినప్పుడు దావీదు దగ్గర చేరిన మనష్షే గోత్రికులు వీరు: వేయిమంది సైన్యానికి అధిపతులైన అద్నా యోజాబాదు, యెదీయవేలు, మిఖాయేలు, యోజాబాదు, ఎలీహు, జిల్లెతై. <verse eid="1CH 12:20"/><verse number="21" style="v" sid="1CH 12:21"/>వారందరు పరాక్రమశాలులు కాబట్టి దావీదు సైన్యంలో అధిపతులుగా ఉండి దోపిడి మూకలను ఎదుర్కోడానికి దావీదుకు సహాయం చేశారు. <verse eid="1CH 12:21"/><verse number="22" style="v" sid="1CH 12:22"/>ప్రతిరోజు దావీదుకు సహాయం చేయడానికి మనుష్యులు వస్తుండడంతో, అతని సైన్యం దేవుని సైన్యంవలె మహా సైన్యంగా మారింది.<verse eid="1CH 12:22"/></para>
  <para style="s1">హెబ్రోనులో దావీదు దగ్గర చేరిన ఇతరులు</para>
  <para style="lh">
    <verse number="23" style="v" sid="1CH 12:23"/>యెహోవా చెప్పినట్లు, సౌలు రాజ్యాన్ని దావీదు వశం చేయడానికి హెబ్రోనులో అతని దగ్గరకు ఆయుధాలు ధరించి వచ్చిన యుద్ధవీరుల లెక్కలు ఇవే:<verse eid="1CH 12:23"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 12:24"/>యూదా వారిలో డాలు, ఈటె పట్టుకుని యుద్ధానికి సిద్ధపడినవారు 6,800 మంది;<verse eid="1CH 12:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 12:25"/>షిమ్యోనీయులలో యుద్ధం చేయడానికి సిద్ధంగా ఉన్న వీరులు 7,100 మంది;<verse eid="1CH 12:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 12:26"/>లేవీయులలో 4,600 మంది, <verse eid="1CH 12:26"/><verse number="27" style="v" sid="1CH 12:27"/>అహరోను కుటుంబానికి నాయకుడైన యెహోయాదా, అతనితో ఉన్న 3,700 మంది, <verse eid="1CH 12:27"/><verse number="28" style="v" sid="1CH 12:28"/>పరాక్రమవంతుడైన సాదోకు అనే యువకునితో పాటు అతని కుటుంబానికి చెందిన అధిపతులు 22 మంది;<verse eid="1CH 12:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 12:29"/>సౌలు గోత్రమైన బెన్యామీనీయులలో 3,000 మంది, అప్పటివరకు వారిలో చాలామంది సౌలు ఇంటికి నమ్మకంగా ఉన్నవారు;<verse eid="1CH 12:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 12:30"/>ఎఫ్రాయిం నుండి తమ వంశాలలో పేరు పొందిన పరాక్రమశాలులైన 20,800 మంది;<verse eid="1CH 12:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 12:31"/>మనష్షే అర్థగోత్రం నుండి, దావీదును రాజుగా చేయడానికి రావాలని పేరుపేరున నియమించబడినవారు 18,000 మంది;<verse eid="1CH 12:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 12:32"/>ఇశ్శాఖారీయుల్లో సమయోచిత జ్ఞానం కలిగి, ఇశ్రాయేలీయులు ఏం చేయాలో తెలిసిన 200 మంది అధిపతులు, వారి ఆజ్ఞకు లోబడి ఉండే వారి బంధువులందరు;<verse eid="1CH 12:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 12:33"/>జెబూలూనీయులలో అన్ని రకాల యుద్ధ ఆయుధాలు ధరించి యుద్ధానికి వెళ్లగలిగిన యుద్ధ నైపుణ్యం కలవారు, దావీదుకు నమ్మకంగా ఉండి యుద్ధం చేయగలవారు 50,000 మంది;<verse eid="1CH 12:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="1CH 12:34"/>నఫ్తాలీయులలో 1,000 అధికారులు, వారితో పాటు డాలు, ఈటె పట్టుకున్నవారు 37,000 మంది;<verse eid="1CH 12:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="1CH 12:35"/>దానీయులలో యుద్ధానికి సిద్ధంగా ఉన్నవారు 28,600 మంది;<verse eid="1CH 12:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="1CH 12:36"/>ఆషేరీయులలో నైపుణ్యం కలిగి యుద్ధానికి సిద్ధంగా ఉన్నవారు 40,000 మంది;<verse eid="1CH 12:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="1CH 12:37"/>ఇంకా యొర్దాను నది తూర్పున ఉండే రూబేనీయులలో, గాదీయులలో, మనష్షే అర్ధగోత్రపు వారిలో అన్ని రకాల ఆయుధాలను ధరించగలిగిన వారు 1,20,000 మంది.<verse eid="1CH 12:37"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="38" style="v" sid="1CH 12:38"/>ఈ వీరులందరు సైన్యంలో పని చేయడానికి స్వచ్ఛందంగా ముందుకు వచ్చారు.</para>
  <para style="b" vid="1CH 12:38"/>
  <para style="p" vid="1CH 12:38">వీరంతా హృదయంలో దావీదును ఇశ్రాయేలు మీద రాజుగా చేయాలని సంపూర్ణంగా తీర్మానించుకొని ఆయుధాలు ధరించి హెబ్రోనుకు వచ్చారు. ఇశ్రాయేలులో మిగిలిన వారందరూ దావీదును రాజుగా చేయాలని ఏకమనస్సుతో కోరుకున్నారు. <verse eid="1CH 12:38"/><verse number="39" style="v" sid="1CH 12:39"/>వారి కుటుంబాలు వారి కోసం భోజనపదార్థాలు సిద్ధం చేశారు, కాబట్టి వారు అక్కడే తిని త్రాగి దావీదుతో పాటు మూడు రోజులు ఉన్నారు. <verse eid="1CH 12:39"/><verse number="40" style="v" sid="1CH 12:40"/>ఇశ్రాయేలీయులు సంతోషంగా ఉన్నారు కాబట్టి ఇశ్శాఖారు, జెబూలూను, నఫ్తాలి సరిహద్దు ప్రాంతాల నుండి వారి పొరుగువారు గాడిదలు, ఒంటెలు, కంచరగాడిదలు, ఎడ్ల మీద ఆహారపదార్థాలు తీసుకువచ్చారు. వాటిలో పిండి వంటకాలు, అంజూర పండ్ల ముద్దలు, ద్రాక్షపండ్ల ముద్దలు, ద్రాక్షరసం, ఒలీవనూనె, పశువులు, గొర్రెలు సమృద్ధిగా ఉన్నాయి.<verse eid="1CH 12:40"/></para>
  <chapter eid="1CH 12"/>
  <chapter number="13" style="c" sid="1CH 13"/>
  <para style="s1">మందసాన్ని ఓబేద్-ఎదోము ఇంటికి తీసుకెళ్లుట</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 13:1"/>దావీదు వేయిమందికి వందమందికి అధిపతులుగా ఉన్నవారందరిని సంప్రదించాడు. <verse eid="1CH 13:1"/><verse number="2" style="v" sid="1CH 13:2"/>తర్వాత అతడు ఇశ్రాయేలు సమాజమంతటితో, “ఈ ఆలోచన మీకు మంచిదనిపిస్తే, ఇది మన దేవుడైన యెహోవా చిత్తమైతే, ఇశ్రాయేలు దేశమంతటా మిగిలి ఉన్న మన ప్రజలందరు, అలాగే వారి పట్టణాల్లో పచ్చిక మైదానాల్లో వారితో పాటు ఉంటున్న యాజకులు, లేవీయులు వచ్చి మనతో చేరాలని వారికి కబురు పంపండి. <verse eid="1CH 13:2"/><verse number="3" style="v" sid="1CH 13:3"/>మన దేవుని నిబంధన మందసాన్ని తిరిగి తీసుకువద్దాము. సౌలు పాలనలో దాని విషయంలో మనం నిర్లక్ష్యంగా ఉన్నాం” అన్నాడు. <verse eid="1CH 13:3"/><verse number="4" style="v" sid="1CH 13:4"/>సమాజమంత దీనికి అంగీకరించింది, ఎందుకంటే వారందరికి అది మంచిదనిపించింది.<verse eid="1CH 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 13:5"/>కాబట్టి దావీదు దేవుని మందసాన్ని కిర్యత్-యారీము నుండి తీసుకురావడానికి ఈజిప్టులో ఉన్న షీహోరు నది నుండి లెబో హమాతు వరకు ఉన్న ఇశ్రాయేలీయులందరిని సమకూర్చాడు. <verse eid="1CH 13:5"/><verse number="6" style="v" sid="1CH 13:6"/>కెరూబుల మధ్య ఆసీనుడైన దేవుడు అని పిలువబడే యెహోవా దేవుని మందసాన్ని తీసుకురావడానికి దావీదు, ఇశ్రాయేలీయులందరు యూదాలోని కిర్యత్-యారీము అని పిలువబడే బాలాకు వెళ్లారు.<verse eid="1CH 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 13:7"/>వారు దేవుని మందసాన్ని క్రొత్త బండిమీద ఎక్కించి అబీనాదాబు ఇంటి నుండి బయలుదేరారు, ఉజ్జా, అహియోలు ఆ బండిని తోలారు. <verse eid="1CH 13:7"/><verse number="8" style="v" sid="1CH 13:8"/>దావీదు, ఇశ్రాయేలీయులందరు పాటలు పాడుతూ, సితారలు, వీణలు, తంబురలు, తాళాలు, బూరలు వాయిస్తూ తమ శక్తి అంతటితో దేవుని ఎదుట ఉత్సహిస్తూ ఉన్నారు.<verse eid="1CH 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 13:9"/>వారు కీదోను నూర్పిడి కళ్ళం దగ్గరకు వచ్చినప్పుడు, ఎడ్లు తడబడినందుకు దేవుని మందసాన్ని పట్టుకోడానికి ఉజ్జా చేయి చాపాడు. <verse eid="1CH 13:9"/><verse number="10" style="v" sid="1CH 13:10"/>ఉజ్జా మందసం మీద చేయి వేసినందుకు యెహోవా కోపం అతని మీద రగులుకుని ఆయన అతన్ని మొత్తగా అతడు అక్కడే దేవుని ఎదుట చనిపోయాడు.<verse eid="1CH 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 13:11"/>యెహోవా కోపం ఉజ్జా మీద రగులుకున్నందుకు దావీదుకు కోపం వచ్చింది కాబట్టి ఆ స్థలానికి పెరెజ్ ఉజ్జా<note caller="+" style="f"><char style="fr" closed="false">13:11 </char><char style="fq" closed="false">పెరెజ్ ఉజ్జా </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">వినాశము </char><char style="fq" closed="false">ఉజ్జా మీద</char></note> అని పేరు పెట్టాడు. ఈ రోజు వరకు దానికి అదే పేరు.<verse eid="1CH 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 13:12"/>ఆ రోజు దావీదు దేవునికి భయపడి, “దేవుని మందసాన్ని నా దగ్గరకు ఎలా తెచ్చుకోవాలి?” అని అడిగాడు. <verse eid="1CH 13:12"/><verse number="13" style="v" sid="1CH 13:13"/>దేవుని మందసాన్ని తన దగ్గర పెట్టుకోడానికి దావీదు పట్టణానికి తీసుకెళ్లకుండా, అతడు దాన్ని గిత్తీయుడైన ఓబేద్-ఎదోము ఇంటికి తీసుకెళ్లాడు. <verse eid="1CH 13:13"/><verse number="14" style="v" sid="1CH 13:14"/>దేవుని మందసం ఓబేద్-ఎదోము ఇంట్లో అతని కుటుంబం దగ్గర మూడు నెలలు ఉంది. యెహోవా అతన్ని, అతని ఇంటివారిని అతనికి కలిగిన సమస్తాన్ని దీవించారు.<verse eid="1CH 13:14"/></para>
  <chapter eid="1CH 13"/>
  <chapter number="14" style="c" sid="1CH 14"/>
  <para style="s1">దావీదు ఇల్లు, కుటుంబం</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 14:1"/>తూరు రాజైన హీరాము దావీదు దగ్గరకు దూతలను, వారితో పాటు దావీదుకు రాజభవనం నిర్మించడానికి దేవదారు దుంగలను, వడ్రంగివారిని, రాళ్లతో పనిచేసే మేస్త్రీలను పంపాడు. <verse eid="1CH 14:1"/><verse number="2" style="v" sid="1CH 14:2"/>ఇశ్రాయేలు ప్రజల మీద యెహోవా తనను రాజుగా స్థిరపరిచారని, ఆయన ప్రజలైన ఇశ్రాయేలీయుల కోసం తన రాజ్యాన్ని ఎంతో గొప్ప చేశారని దావీదు గ్రహించాడు.<verse eid="1CH 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 14:3"/>దావీదు యెరూషలేములో మరికొందరిని భార్యలుగా చేసుకుని ఇంకా చాలామంది కుమారులకు కుమార్తెలకు తండ్రి అయ్యాడు. <verse eid="1CH 14:3"/><verse number="4" style="v" sid="1CH 14:4"/>యెరూషలేములో అతనికి పుట్టిన పిల్లల పేర్లు ఇవి: షమ్మూయ, షోబాబు, నాతాను, సొలొమోను, <verse eid="1CH 14:4"/><verse number="5" style="v" sid="1CH 14:5"/>ఇభారు, ఎలీషువ, ఎల్పెలెతు, <verse eid="1CH 14:5"/><verse number="6" style="v" sid="1CH 14:6"/>నోగహు, నెఫెగు, యాఫీయ, <verse eid="1CH 14:6"/><verse number="7" style="v" sid="1CH 14:7"/>ఎలీషామా, ఎల్యాదా,<note caller="+" style="f"><char style="fr" closed="false">14:7 </char><char style="ft" closed="false">దీనికి మరో రూపం </char><char style="fqa" closed="false">బెయెల్యెదా</char></note> ఎలీఫెలెతు.<verse eid="1CH 14:7"/></para>
  <para style="s1">దావీదు ఫిలిష్తీయులను ఓడించుట</para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 14:8"/>ఇశ్రాయేలు అంతటి మీద దావీదును రాజుగా అభిషేకించారని ఫిలిష్తీయులు విని, అతన్ని పట్టుకోవడానికి సైన్యమంతటితో బయలుదేరి వచ్చారు, అయితే దావీదు ఆ సంగతి విని వారిని ఎదుర్కోడానికి వెళ్లాడు. <verse eid="1CH 14:8"/><verse number="9" style="v" sid="1CH 14:9"/>ఫిలిష్తీయులు వచ్చి రెఫాయీము లోయలో దాడి చేశారు. <verse eid="1CH 14:9"/><verse number="10" style="v" sid="1CH 14:10"/>అప్పుడు దావీదు, “నేను వెళ్లి ఫిలిష్తీయుల మీద దాడి చేయాలా? మీరు నాకు వారిని అప్పగిస్తారా?” అని దేవుని అడిగాడు.</para>
  <para style="p" vid="1CH 14:10">అందుకు యెహోవా, “వెళ్లు, నేను వారిని నీ చేతికి అప్పగిస్తాను” అని అతనికి జవాబిచ్చారు.<verse eid="1CH 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 14:11"/>కాబట్టి దావీదు తన మనుష్యులతో బయల్-పెరాజీముకు వెళ్లి వారిని ఓడించాడు. అతడు, “నీళ్లు కొట్టుకుపోయినట్లుగా దేవుడు నా శత్రువులను నా ఎదుట ఉండకుండ నా చేత నాశనం చేశారు” అని చెప్పి ఆ స్థలానికి బయల్-పెరాజీము<note caller="+" style="f"><char style="fr" closed="false">14:11 </char><char style="fq" closed="false">బయల్-పెరాజీము </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">విరుచుకుపడే ప్రభువు</char></note> అని పేరు పెట్టారు. <verse eid="1CH 14:11"/><verse number="12" style="v" sid="1CH 14:12"/>ఫిలిష్తీయులు తమ దేవతల విగ్రహాలను అక్కడే విడిచిపెట్టి పారిపోగా దావీదు వాటిని అగ్నిలో కాల్చివేయమని ఆజ్ఞాపించాడు.<verse eid="1CH 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 14:13"/>మరోసారి ఫిలిష్తీయులు అదే లోయలో దాడి చేశారు. <verse eid="1CH 14:13"/><verse number="14" style="v" sid="1CH 14:14"/>కాబట్టి దావీదు దేవుని దగ్గర విచారణ చేసినప్పుడు దేవుడు, “నీవు నేరుగా వారి వెనుక వెళ్లకుండా చుట్టూ తిరిగివెళ్లి, కంబళి చెట్లకు ఎదురుగా వారిమీద దాడి చేయి. <verse eid="1CH 14:14"/><verse number="15" style="v" sid="1CH 14:15"/>కంబళి చెట్ల కొనల్లో అడుగుల శబ్దం వినబడగానే, యుద్ధానికి బయలుదేరు. ఎందుకంటే ఫిలిష్తీయుల సైన్యాన్ని నాశనం చేయడానికి దేవుడు నీ ముందుగా వెళ్లారని దాని అర్థం” అని జవాబిచ్చారు. <verse eid="1CH 14:15"/><verse number="16" style="v" sid="1CH 14:16"/>కాబట్టి దేవుడు తనకు ఆజ్ఞాపించినట్లే దావీదు చేశాడు, వారు గిబియోను నుండి గెజెరు వరకు ఫిలిష్తీయుల సైన్యాన్ని తరుముతూ వారిని హతం చేశారు.<verse eid="1CH 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 14:17"/>కాబట్టి దావీదు కీర్తి అన్ని దేశాలకు వ్యాపించింది. యెహోవా ఇతర దేశాలన్నీ అతనికి భయపడేలా చేశారు.<verse eid="1CH 14:17"/></para>
  <chapter eid="1CH 14"/>
  <chapter number="15" style="c" sid="1CH 15"/>
  <para style="s1">యెరూషలేముకు తేబడిన మందసం</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 15:1"/>దావీదు తన కోసం దావీదు పట్టణంలో భవనాలు కట్టించుకున్న తర్వాత, అతడు దేవుని మందసం కోసం ఒక స్థలాన్ని సిద్ధపరచి దాని కోసం గుడారం వేయించాడు. <verse eid="1CH 15:1"/><verse number="2" style="v" sid="1CH 15:2"/>తర్వాత దావీదు, “దేవుని మందసాన్ని మోయడానికి నిత్యంగా తనకు సేవ చేయడానికి యెహోవా లేవీయులను ఎన్నుకున్నారు కాబట్టి వారు తప్ప ఇంకెవరు యెహోవా మందసాన్ని మోయకూడదు” అని చెప్పాడు.<verse eid="1CH 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 15:3"/>యెహోవా మందసాన్ని తాను సిద్ధపరచిన స్థలానికి తీసుకురావడానికి దావీదు ఇశ్రాయేలీయులందరిని యెరూషలేములో సమావేశపరిచాడు.<verse eid="1CH 15:3"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="4" style="v" sid="1CH 15:4"/>అప్పుడు అహరోను వారసులను, లేవీయులను పిలిపించాడు, వారు వీరే:<verse eid="1CH 15:4"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 15:5"/>కహాతు వారసులలో నుండి,</para>
  <para style="li2" vid="1CH 15:5">వారి నాయకుడైన ఊరియేలు, అతని బంధువుల్లో 120 మంది;<verse eid="1CH 15:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 15:6"/>మెరారి వారసులలో నుండి వారి నాయకుడైన అశాయాను,</para>
  <para style="li2" vid="1CH 15:6">అతని బంధువుల్లో 220 మంది;<verse eid="1CH 15:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 15:7"/>గెర్షోను<note caller="+" style="f"><char style="fr" closed="false">15:7 </char><char style="ft" closed="false">హెబ్రీలో </char><char style="fqa" closed="false">గెర్షోము </char><char style="ft" closed="false">గెర్షోనుకు మరొక రూపం</char></note> వారసులలో నుండి వారి నాయకుడైన యోవేలు,</para>
  <para style="li2" vid="1CH 15:7">అతని బంధువుల్లో 130 మంది;<verse eid="1CH 15:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 15:8"/>ఎలీషాపాను వారసులలో నుండి వారి నాయకుడైన షెమయా,</para>
  <para style="li2" vid="1CH 15:8">అతని బంధువుల్లో 200 మంది;<verse eid="1CH 15:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 15:9"/>హెబ్రోను వారసులలో నుండి వారి నాయకుడైన ఎలీయేలు,</para>
  <para style="li2" vid="1CH 15:9">అతని బంధువుల్లో 80 మంది;<verse eid="1CH 15:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 15:10"/>ఉజ్జీయేలు వారసులలో నుండి వారి నాయకుడైన అమ్మీనాదాబు,</para>
  <para style="li2" vid="1CH 15:10">అతని బంధువుల్లో 112 మంది.<verse eid="1CH 15:10"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="11" style="v" sid="1CH 15:11"/>తర్వాత దావీదు యాజకులైన సాదోకు అబ్యాతారులను, లేవీయులైన ఊరియేలు, అశాయాను, యోవేలు, షెమయాను, ఎలీయేలు, అమ్మీనాదాబులను పిలిపించాడు. <verse eid="1CH 15:11"/><verse number="12" style="v" sid="1CH 15:12"/>అతడు వారితో ఇలా అన్నాడు, “మీరు లేవీయుల కుటుంబ పెద్దలు; ఇశ్రాయేలీయుల దేవుడైన యెహోవా మందసాన్ని, నేను సిద్ధపరచిన స్థలానికి తీసుకురావడానికి మీరు, మీ బంధువులు, మిమ్మల్ని మీరు ప్రతిష్ఠించుకోండి. <verse eid="1CH 15:12"/><verse number="13" style="v" sid="1CH 15:13"/>లేవీయులైన మీరు ఇంతకుముందు మన దేవుడైన యెహోవా మందసాన్ని మోయలేదు కాబట్టి మన దేవుడైన యెహోవా కోపంతో మనమీద విరుచుకుపడ్డారు. మనం ఎలా చేయాలో నియమించబడిన విధానం ప్రకారం ఆయనను అడగలేదు.” <verse eid="1CH 15:13"/><verse number="14" style="v" sid="1CH 15:14"/>అప్పుడు ఇశ్రాయేలీయుల దేవుడైన యెహోవా మందసాన్ని తీసుకురావడానికి యాజకులు, లేవీయులు తమను తాము ప్రతిష్ఠించుకున్నారు. <verse eid="1CH 15:14"/><verse number="15" style="v" sid="1CH 15:15"/>యెహోవా చెప్పిన మాట ప్రకారం మోషే ఆజ్ఞాపించినట్లు లేవీయులు దేవుని మందసాన్ని దాని మోతకర్రలతో తమ భుజాల మీదికి ఎత్తుకున్నారు.<verse eid="1CH 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 15:16"/>తమ తోటి లేవీయులను సితారలు, వీణలు, తాళాలు మొదలైన వాయిద్యాలతో సంతోషకరమైన ధ్వని చేయమని సంగీతకారులుగా నియమించమని లేవీ నాయకులకు దావీదు ఆదేశించాడు.<verse eid="1CH 15:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 15:17"/>కాబట్టి లేవీయులు యోవేలు కుమారుడైన హేమానును నియమించారు; అతని బంధువుల్లో బెరెక్యా కుమారుడైన ఆసాపు; వారి బంధువులైన మెరారీయులలో కూషాయాహు కుమారుడైన ఏతాను; <verse eid="1CH 15:17"/><verse number="18" style="v" sid="1CH 15:18"/>వారితో పాటు రెండవ వరుసలో ఉన్న తమ బంధువులు: జెకర్యా, బేను, యహజీయేలు, షెమీరామోతు, యెహీయేలు, ఉన్నీ, ఏలీయాబు, బెనాయా, మయశేయా, మత్తిత్యా, ఎలీఫెలెహు, మిక్నేయాహులు, ద్వారపాలకులైన ఓబేద్-ఎదోము, యెహీయేలు.<verse eid="1CH 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 15:19"/>సంగీతకారులైన హేమాను, ఆసాపు, ఏతానులు ఇత్తడి తాళాలను వాయించాలి; <verse eid="1CH 15:19"/><verse number="20" style="v" sid="1CH 15:20"/>జెకర్యా, అజీయేలు, షెమీరామోతు, యెహీయేలు, ఉన్నీ, ఏలీయాబు, మయశేయా, బెనాయాలు అలామోతు<note caller="+" style="f"><char style="fr" closed="false">15:20 </char><char style="ft" closed="false">బహుశ సంగీత పదం</char></note> శైలిలో వీణలు వాయించాలి, <verse eid="1CH 15:20"/><verse number="21" style="v" sid="1CH 15:21"/>మత్తిత్యా, ఎలీఫెలెహు, మిక్నేయాహు, ఓబేద్-ఎదోము, యెహీయేలు, అజజ్యాహులు షెమినిత్<note caller="+" style="f" category="dup"><char style="fr" closed="false">15:21 </char><char style="ft" closed="false">బహుశ సంగీత పదం</char></note> సితారలు వాయించాలి. <verse eid="1CH 15:21"/><verse number="22" style="v" sid="1CH 15:22"/>లేవీయుల నాయకుడైన కెనన్యా సంగీత నిర్వహణలో నైపుణ్యత గలవాడు కాబట్టి గాయకుల బృందానికి నాయకునిగా నియమించబడ్డాడు.<verse eid="1CH 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 15:23"/>బెరెక్యా, ఎల్కానా దేవుని మందసానికి కావలివారిగా నియమించబడ్డారు. <verse eid="1CH 15:23"/><verse number="24" style="v" sid="1CH 15:24"/>షెబన్యా, యెహోషాపాతు, నెతనేలు, అమాశై, జెకర్యా, బెనాయా, ఎలీయెజెరు అనే యాజకులు దేవుని మందసం ముందు బూరలు ఊదడానికి నియమించబడ్డారు. ఓబేద్-ఎదోము, యెహీయా దేవుని మందసానికి కావలివారిగా కూడ నియమించబడ్డారు.<verse eid="1CH 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 15:25"/>కాబట్టి యెహోవా నిబంధన మందసాన్ని ఓబేద్-ఎదోము ఇంటి నుండి ఉత్సాహంతో తీసుకురావడానికి దావీదు, ఇశ్రాయేలీయుల పెద్దలు, సహస్రాధిపతులు వెళ్లారు. <verse eid="1CH 15:25"/><verse number="26" style="v" sid="1CH 15:26"/>ఎందుకంటే యెహోవా నిబంధన మందసాన్ని మోస్తున్న లేవీయులకు దేవుడు సహాయం చేశారు, వారు ఏడు ఎడ్లను, ఏడు పొట్టేళ్ళను బలిగా అర్పించారు. <verse eid="1CH 15:26"/><verse number="27" style="v" sid="1CH 15:27"/>దావీదు, మందసాన్ని మోసిన లేవీయులందరు, సంగీతకారులు, సంగీత నాయకుడు కెనన్యా సన్నని నారతో నేసిన వస్ర్తాలు ధరించారు. దావీదు సన్నని నారతో నేసిన ఏఫోదును కూడా ధరించాడు. <verse eid="1CH 15:27"/><verse number="28" style="v" sid="1CH 15:28"/>ఇశ్రాయేలీయులందరు ఆనందోత్సాహాలతో పొట్టేళ్ల కొమ్ము బూరల ధ్వనితో, తాళాలు వీణలు సితారలు వాయిస్తూ, యెహోవా నిబంధన మందసాన్ని తీసుకువచ్చారు.<verse eid="1CH 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CH 15:29"/>యెహోవా నిబంధన మందసం దావీదు పట్టణంలోనికి వస్తుండగా, సౌలు కుమార్తె మీకాలు కిటికీలో నుండి చూసింది. రాజైన దావీదు ఆనందోత్సాహాలతో నాట్యం చేయడం చూసి తన మనస్సులో అతన్ని నీచంగా చూసింది.<verse eid="1CH 15:29"/></para>
  <chapter eid="1CH 15"/>
  <chapter number="16" style="c" sid="1CH 16"/>
  <para style="s1">మందసం ఎదుట పరిచర్య</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 16:1"/>వారు దేవుని మందసాన్ని తీసుకువచ్చి, దావీదు దాని కోసం వేసిన గుడారంలో దానిని ఉంచి వారు దేవుని సన్నిధిలో దహనబలులు సమాధానబలులు అర్పించారు. <verse eid="1CH 16:1"/><verse number="2" style="v" sid="1CH 16:2"/>దావీదు దహనబలులు సమాధానబలులు అర్పించిన తర్వాత, అతడు యెహోవా పేరిట ప్రజలను దీవించాడు. <verse eid="1CH 16:2"/><verse number="3" style="v" sid="1CH 16:3"/>అప్పుడతడు ఇశ్రాయేలీయులలో ప్రతి పురుషునికి, స్త్రీకి ఒక రొట్టె, ఒక ఖర్జూర పండ్ల రొట్టె, ఒక ద్రాక్షపండ్ల రొట్టె ఇచ్చాడు.<verse eid="1CH 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 16:4"/>తర్వాత అతడు యెహోవా మందసం దగ్గర సేవ చేయడానికి, ఇశ్రాయేలీయుల దేవుడైన యెహోవాను కీర్తించడానికి స్తుతించడానికి, కృతజ్ఞతలు అర్పించడానికి లేవీయులలో కొంతమందిని నియమించాడు. <verse eid="1CH 16:4"/><verse number="5" style="v" sid="1CH 16:5"/>వారిలో ఆసాపు నాయకుడు, అతని తర్వాతి నాయకుడు జెకర్యా, తర్వాత యహజీయేలు,<note caller="+" style="f"><char style="fr" closed="false">16:5 </char><char style="ft" closed="false">హెబ్రీలో </char><char style="fqa" closed="false">యెహీయేలు </char><char style="ft" closed="false">బహుశ యహజీయేలుకు మరొక పేరు</char></note> షెమీరామోతు, యెహీయేలు, మత్తిత్యా, ఏలీయాబు, బెనాయా, ఓబేద్-ఎదోము, యెహీయేలు. వారు వీణలు, సితారలు వాయించడానికి నియమించబడ్డారు. ఆసాపు తాళాలను వాయించేవాడు. <verse eid="1CH 16:5"/><verse number="6" style="v" sid="1CH 16:6"/>యాజకులైన బెనాయా, యహజీయేలు దేవుని నిబంధన మందసం ఎదుట క్రమంగా బూరలు ఊదేవారు.<verse eid="1CH 16:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 16:7"/>ఆ రోజు దావీదు యెహోవాను స్తుతించడానికి మొదటిసారిగా ఆసాపు, అతని తోటివారికి ఇలా పాడమని చెప్పాడు:<verse eid="1CH 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="1CH 16:8"/>యెహోవాకు స్తుతి చెల్లించండి, ఆయన నామాన్ని ప్రకటించండి;</para>
  <para style="q2" vid="1CH 16:8">ఆయన చేసిన వాటిని దేశాల్లో తెలియజేయండి.<verse eid="1CH 16:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="1CH 16:9"/>ఆయనకు పాడండి, ఆయనకు స్తుతి పాడండి;</para>
  <para style="q2" vid="1CH 16:9">ఆయన అద్భుత కార్యాలన్నిటిని గురించి చెప్పండి.<verse eid="1CH 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="1CH 16:10"/>ఆయన పరిశుద్ధ నామం గురించి గొప్పగా చెప్పండి;</para>
  <para style="q2" vid="1CH 16:10">యెహోవాను వెదికేవారి హృదయాలు ఆనందించును గాక.<verse eid="1CH 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 16:11"/>యెహోవాను, ఆయన బలాన్ని చూడండి;</para>
  <para style="q2" vid="1CH 16:11">ఆయన ముఖాన్ని ఎల్లప్పుడు వెదకండి.<verse eid="1CH 16:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12-13" style="v" sid="1CH 16:12-13"/>ఆయన సేవకులైన ఇశ్రాయేలు వారసులారా!</para>
  <para style="q2" vid="1CH 16:12-13">ఆయన ఎన్నుకున్న యాకోబు సంతానమా!</para>
  <para style="q1" vid="1CH 16:12-13">ఆయన చేసిన ఆశ్చర్య క్రియలను,</para>
  <para style="q2" vid="1CH 16:12-13">ఆయన అద్భుతాలను, ఆయన ప్రకటించిన తీర్పులను జ్ఞాపకం చేసుకోండి.<verse eid="1CH 16:12-13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="1CH 16:14"/>ఆయన మన దేవుడైన యెహోవా;</para>
  <para style="q2" vid="1CH 16:14">ఆయన తీర్పులు భూమి అంతటా ఉన్నాయి.<verse eid="1CH 16:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="1CH 16:15"/>ఆయన తన నిబంధనను,</para>
  <para style="q2" vid="1CH 16:15">తాను చేసిన వాగ్దానాన్ని వెయ్యి తరాల వరకు జ్ఞాపకం ఉంచుకుంటారు.<verse eid="1CH 16:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="1CH 16:16"/>అబ్రాహాముతో ఆయన చేసిన నిబంధనను</para>
  <para style="q2" vid="1CH 16:16">ఇస్సాకుతో ఆయన చేసిన ప్రమాణాన్ని ఎప్పటికీ జ్ఞాపకముంచుకుంటారు.<verse eid="1CH 16:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="1CH 16:17"/>ఆయన దానిని యాకోబుకు శాసనంగా,</para>
  <para style="q2" vid="1CH 16:17">ఇశ్రాయేలుకు శాశ్వతమైన నిబంధనగా స్థిరపరిచారు:<verse eid="1CH 16:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="1CH 16:18"/>“నేను మీకు కనాను దేశాన్ని ఇస్తాను</para>
  <para style="q2" vid="1CH 16:18">మీరు వారసత్వంగా పొందుకునే భాగంగా ఇస్తాను.”<verse eid="1CH 16:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="1CH 16:19"/>వారు లెక్కకు కొద్దిమంది ఉన్నప్పుడు,</para>
  <para style="q2" vid="1CH 16:19">ఆ కొద్దిమంది ఆ దేశంలో పరాయివారిగా ఉన్నప్పుడు,<verse eid="1CH 16:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CH 16:20"/>వారు దేశం నుండి దేశానికి,</para>
  <para style="q2" vid="1CH 16:20">ఒక రాజ్యం నుండి ఇంకొక రాజ్యానికి తిరిగారు.<verse eid="1CH 16:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="1CH 16:21"/>ఆయన ఎవరినీ వారికి హాని చేయనివ్వలేదు;</para>
  <para style="q2" vid="1CH 16:21">వారి కోసం ఆయన రాజులను మందలించారు:<verse eid="1CH 16:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="1CH 16:22"/>“నేను అభిషేకించిన వారిని మీరు ముట్టకూడదు;</para>
  <para style="q2" vid="1CH 16:22">నా ప్రవక్తలకు హాని చేయకూడదు.”<verse eid="1CH 16:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="1CH 16:23"/>సమస్త భూలోకమా! యెహోవాకు పాడండి;</para>
  <para style="q2" vid="1CH 16:23">అనుదినం ఆయన రక్షణను ప్రకటించండి.<verse eid="1CH 16:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="1CH 16:24"/>దేశాల్లో ఆయన మహిమను,</para>
  <para style="q2" vid="1CH 16:24">సకల ప్రజల్లో ఆయన అద్భుత కార్యాలను ప్రకటించండి.<verse eid="1CH 16:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="1CH 16:25"/>యెహోవా ఎంతో గొప్పవారు స్తుతికి ఎంతో అర్హులు;</para>
  <para style="q2" vid="1CH 16:25">దేవుళ్ళందరికంటే ఆయన భయపడదగిన వారు.<verse eid="1CH 16:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="1CH 16:26"/>ఇతర దేశాల దేవుళ్ళందరు వట్టి విగ్రహాలు,</para>
  <para style="q2" vid="1CH 16:26">కాని యెహోవా ఆకాశాలను సృష్టించారు.<verse eid="1CH 16:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="1CH 16:27"/>వైభవం, ప్రభావం ఆయన ఎదుట ఉన్నాయి.</para>
  <para style="q2" vid="1CH 16:27">బలం, ఆనందం ఆయన నివాసస్థలంలో ఉన్నాయి.<verse eid="1CH 16:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="1CH 16:28"/>ప్రజల వంశాల్లారా, యెహోవాకు చెల్లించండి,</para>
  <para style="q2" vid="1CH 16:28">మహిమను బలాన్ని యెహోవాకు చెల్లించండి.<verse eid="1CH 16:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="1CH 16:29"/>యెహోవా నామానికి చెందాల్సిన మహిమను ఆయనకు చెల్లించండి.</para>
  <para style="q2" vid="1CH 16:29">అర్పణను తీసుకుని ఆయన సన్నిధికి రండి.</para>
  <para style="q1" vid="1CH 16:29">తన పవిత్రత యొక్క వైభవంతో యెహోవాను ఆరాధించండి.<verse eid="1CH 16:29"/></para>
  <para style="q2">
    <verse number="30" style="v" sid="1CH 16:30"/>సమస్త భూలోకమా! ఆయన ఎదుట వణకాలి,</para>
  <para style="q2" vid="1CH 16:30">లోకం స్థిరంగా స్థాపించబడింది, అది కదలదు.<verse eid="1CH 16:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="1CH 16:31"/>ఆకాశాలు ఆనందించాలి, భూమి సంతోషించాలి;</para>
  <para style="q2" vid="1CH 16:31">“యెహోవా పరిపాలిస్తున్నారు!” అని దేశాల్లో ప్రకటించబడాలి.<verse eid="1CH 16:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="1CH 16:32"/>సముద్రం, దానిలోని సమస్తం ఘోషించాలి;</para>
  <para style="q2" vid="1CH 16:32">పొలాలు వాటిలోని సమస్తం ఆనంద ధ్వనులు చేయాలి!<verse eid="1CH 16:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="1CH 16:33"/>అడవి చెట్లు పాటలు పాడాలి,</para>
  <para style="q2" vid="1CH 16:33">అవి యెహోవా ఎదుట ఆనందంతో పాటలు పాడాలి,</para>
  <para style="q2" vid="1CH 16:33">యెహోవా భూమికి తీర్పు తీర్చడానికి వస్తున్నారు.<verse eid="1CH 16:33"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="34" style="v" sid="1CH 16:34"/>యెహోవా మంచివాడు, ఆయనకు కృతజ్ఞతలు చెల్లించండి;</para>
  <para style="q2" vid="1CH 16:34">ఆయన మారని ప్రేమ నిరంతరం నిలుస్తుంది.<verse eid="1CH 16:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="1CH 16:35"/>ఇలా మొరపెట్టండి: “దేవా, మా రక్షకా! మమ్మల్ని రక్షించండి;</para>
  <para style="q2" vid="1CH 16:35">ఇతర దేశాల మధ్య నుండి మమ్మల్ని సమకూర్చి, విడిపించండి,</para>
  <para style="q1" vid="1CH 16:35">అప్పుడు మేము మీ పరిశుద్ధ నామానికి కృతజ్ఞతలు చెల్లిస్తాం,</para>
  <para style="q2" vid="1CH 16:35">మిమ్మల్ని స్తుతించడంలో అతిశయిస్తాము.”<verse eid="1CH 16:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="1CH 16:36"/>ఇశ్రాయేలు దేవుడైన యెహోవాకు</para>
  <para style="q2" vid="1CH 16:36">నిత్యత్వం నుండి నిత్యత్వం వరకు స్తుతి కలుగును గాక!</para>
  <para style="m" vid="1CH 16:36">అని అనగానే ప్రజలంతా, “ఆమేన్, యెహోవాకు స్తుతి” అని చెప్పారు.<verse eid="1CH 16:36"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="37" style="v" sid="1CH 16:37"/>యెహోవా నిబంధన మందసం ఎదుట ప్రతిరోజు క్రమంగా సేవ చేయడానికి, దావీదు దాని దగ్గర ఆసాపును, అతని తోటి వారిని నియమించాడు. <verse eid="1CH 16:37"/><verse number="38" style="v" sid="1CH 16:38"/>అలాగే ఓబేద్-ఎదోమును, అతని అరవై ఎనిమిది మంది తోటి వారిని కూడా అక్కడ నియమించాడు. యెదూతూను కుమారుడైన ఓబేద్-ఎదోము, హోసా అనేవారు ద్వారపాలకులు.<verse eid="1CH 16:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CH 16:39"/>దావీదు యాజకుడైన సాదోకును, అతని తోటి యాజకులను గిబియోనులోని ఆరాధన స్థలంలో<note caller="+" style="f"><char style="fr" closed="false">16:39 </char><char style="ft" closed="false">మూ.భా.లో </char><char style="fqa" closed="false">క్షేత్రం</char></note> ఉన్న యెహోవా సమావేశ గుడారం దగ్గర ఉంచాడు. <verse eid="1CH 16:39"/><verse number="40" style="v" sid="1CH 16:40"/>యెహోవా ఇశ్రాయేలీయులకు ఆదేశించిన ధర్మశాస్త్రంలో వ్రాయబడిన ప్రకారం, ప్రతిరోజు ఉదయ సాయంత్రాల్లో క్రమంగా బలిపీఠం మీద దహనబలి యెహోవాకు అర్పించడానికి దావీదు వారిని నియమించాడు. <verse eid="1CH 16:40"/><verse number="41" style="v" sid="1CH 16:41"/>“ఆయన మారని ప్రేమ నిరంతరం ఉంటుంది” అని అంటూ ఆయనకు కృతజ్ఞతలు అర్పించడానికి వారితో కూడ హేమాను, యెదూతూను, పేర్లు చెప్పి ఎన్నుకున్న మరి కొంతమందిని అతడు నియమించాడు. <verse eid="1CH 16:41"/><verse number="42" style="v" sid="1CH 16:42"/>బూరధ్వని చేయడానికి, తాళాలు వాయించడానికి, దేవున్ని స్తుతించడానికి ఇతర వాయిద్యాలను వాయించడానికి హేమాను, యెదూతూనులను నియమించాడు. యెదూతూను కుమారులను ద్వారపాలకులుగా నియమించాడు.<verse eid="1CH 16:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="1CH 16:43"/>తర్వాత ప్రజలంతా ఎవరి ఇంటికి వారు వెళ్లిపోయారు. దావీదు తన కుటుంబాన్ని దీవించడానికి తన ఇంటికి తిరిగి వెళ్లాడు.<verse eid="1CH 16:43"/></para>
  <chapter eid="1CH 16"/>
  <chapter number="17" style="c" sid="1CH 17"/>
  <para style="s1">దావీదుకు దేవుడు చేసిన వాగ్దానం</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 17:1"/>దావీదు తన రాజభవనంలో స్థిరపడిన తర్వాత, అతడు నాతాను ప్రవక్తతో, “ఇదిగో, యెహోవా నిబంధన మందసం గుడారంలో ఉంటుండగా నేను దేవదారు చెక్కలతో కట్టిన భవనంలో నివసిస్తున్నాను” అన్నాడు.<verse eid="1CH 17:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 17:2"/>అందుకు నాతాను దావీదుతో, “దేవుడు నీకు తోడుగా ఉన్నారు, కాబట్టి నీ మనస్సులో ఏముందో అది చేయి” అన్నాడు.<verse eid="1CH 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 17:3"/>అయితే ఆ రాత్రి దేవుని వాక్కు నాతాను దగ్గరకు ఇలా వచ్చింది:<verse eid="1CH 17:3"/></para>
  <para style="pm">
    <verse number="4" style="v" sid="1CH 17:4"/>“నీవు వెళ్లి నా సేవకుడైన దావీదుతో ఇలా చెప్పు: ‘యెహోవా చెప్పే మాట ఇదే: నేను నివసించడానికి ఒక మందిరాన్ని కట్టించేది నీవు కాదు. <verse eid="1CH 17:4"/><verse number="5" style="v" sid="1CH 17:5"/>ఈజిప్టు నుండి నేను ఇశ్రాయేలీయులను తీసుకువచ్చిన రోజు నుండి ఈ రోజు వరకు నేను మందిరంలో నివసించలేదు. ఒక గుడారం నుండి మరో గుడారానికి, ఒక నివాసస్థలం నుండి మరో స్థలానికి మారుతూ వచ్చాను. <verse eid="1CH 17:5"/><verse number="6" style="v" sid="1CH 17:6"/>ఇశ్రాయేలీయులందరితో నేను ఎక్కడికి వెళ్లినా, నా ప్రజలను కాయుమని నేను ఆజ్ఞాపించిన వారి నాయకుల్లో<note caller="+" style="f"><char style="fr" closed="false">17:6 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">న్యాయాధిపతులు </char><char style="ft" closed="false"><char style="xt" link-href="1CH 17:10"><ref loc="1CH 17:10">10</ref></char> వచనంలో కూడా</char></note> ఎవరితోనైనా, “నా కోసం దేవదారు కర్రలతో మందిరాన్ని ఎందుకు కట్టించలేదు” అని అడిగానా?’<verse eid="1CH 17:6"/></para>
  <para style="pm">
    <verse number="7" style="v" sid="1CH 17:7"/>“కాబట్టి ఇప్పుడు నా సేవకుడైన దావీదుతో ఇలా చెప్పు: సైన్యాల యెహోవా చెప్పే మాట ఇదే: పచ్చిక మైదానంలో గొర్రెల కాపరిగా ఉన్న నిన్ను తీసుకువచ్చి నా ప్రజలైన ఇశ్రాయేలీయులకు పాలకునిగా నియమించాను. <verse eid="1CH 17:7"/><verse number="8" style="v" sid="1CH 17:8"/>నీవెక్కడికి వెళ్లినా నేను నీకు తోడుగా ఉండి, నీ ఎదుట నిలబడకుండా నీ శత్రువులందరిని నాశనం చేశాను. ఇప్పుడు భూమి మీద ఉన్న గొప్పవారికున్న పేరులాంటి పేరు నీకు ఇస్తాను. <verse eid="1CH 17:8"/><verse number="9" style="v" sid="1CH 17:9"/>నా ప్రజలైన ఇశ్రాయేలీయులు ఎలాంటి తొందర లేకుండా వారి స్వస్థలంలో నివసించేలా వారిని అందులో నాటుతాను. గతంలో వారు చేసినట్లుగా దుర్మార్గులు వారిని ఇక బాధించరు, <verse eid="1CH 17:9"/><verse number="10" style="v" sid="1CH 17:10"/>అంతేకాదు నా ప్రజలైన ఇశ్రాయేలీయుల మీద నేను న్యాయాధిపతులను నియమించిన కాలం నుండి జరిగినట్టు దుర్మార్గులు ఇక వారిని బాధించరు. నీ శత్రువులందరి నుండి నీకు నెమ్మది కలుగజేస్తాను.</para>
  <para style="pm" vid="1CH 17:10">“ ‘యెహోవా నీకు రాజవంశాన్ని ఇస్తారని నేను నీకు ప్రకటిస్తున్నాను: <verse eid="1CH 17:10"/><verse number="11" style="v" sid="1CH 17:11"/>నీ దినాలు ముగిసి నీ పూర్వికుల దగ్గరకు నీవు వెళ్లినప్పుడు, నీ స్థానంలో నీ సంతానాన్ని, నీ సొంత కుమారులలో ఒకరిని నేను లేవనెత్తుతాను, అతని రాజ్యాన్ని స్థిరపరుస్తాను. <verse eid="1CH 17:11"/><verse number="12" style="v" sid="1CH 17:12"/>నా కోసం ఒక మందిరాన్ని కట్టేవాడు అతడే. నేను అతని సింహాసనాన్ని శాశ్వతంగా స్థిరపరుస్తాను. <verse eid="1CH 17:12"/><verse number="13" style="v" sid="1CH 17:13"/>నేను అతనికి తండ్రిగా ఉంటాను, అతడు నాకు కుమారునిగా ఉంటాడు. నీకంటే ముందున్న వానికి నేను నా ప్రేమను దూరం చేసినట్లుగా అతనికి ఎప్పుడూ దూరం చేయను. <verse eid="1CH 17:13"/><verse number="14" style="v" sid="1CH 17:14"/>నా ఇంటి మీద, నా రాజ్యం మీద నేను అతన్ని నిత్యం స్థిరపరుస్తాను; అతని సింహాసనం శాశ్వతంగా స్థాపించబడుతుంది.’ ”<verse eid="1CH 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CH 17:15"/>నాతాను ఈ దర్శనంలోని మాటలన్నిటిని దావీదుకు చెప్పాడు.<verse eid="1CH 17:15"/></para>
  <para style="s1">దావీదు ప్రార్థన</para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 17:16"/>అప్పుడు రాజైన దావీదు లోపలికి వెళ్లి యెహోవా సన్నిధిలో కూర్చుని ఇలా ప్రార్థించాడు:</para>
  <para style="pm" vid="1CH 17:16">“దేవా యెహోవా, మీరు నన్ను ఈ స్థితిలోనికి తీసుకురావడానికి నేనెంతటివాన్ని? నా కుటుంబం ఏపాటిది? <verse eid="1CH 17:16"/><verse number="17" style="v" sid="1CH 17:17"/>ఇది మీ దృష్టికి చాలదన్నట్టు నా దేవా, మీ సేవకుని కుటుంబ భవిష్యత్తు గురించి కూడా తెలియజేశారు. దేవా యెహోవా, మీరు నన్ను మనుష్యుల్లో చాలా గొప్పవానిగా చూశారు.<verse eid="1CH 17:17"/></para>
  <para style="pm">
    <verse number="18" style="v" sid="1CH 17:18"/>“మీ సేవకుని ఘనపరుస్తున్నందుకు దావీదు మీతో ఇంకేం చెప్పగలడు? మీ సేవకుని గురించి మీకు తెలుసు. <verse eid="1CH 17:18"/><verse number="19" style="v" sid="1CH 17:19"/>యెహోవా! మీ సేవకుని కోసం మీ చిత్తప్రకారం మీరు ఈ గొప్ప కార్యాన్ని చేసి ఈ గొప్ప వాగ్దానాలన్నిటిని తెలియజేశారు.<verse eid="1CH 17:19"/></para>
  <para style="pm">
    <verse number="20" style="v" sid="1CH 17:20"/>“యెహోవా! మా చెవులతో మేము విన్నట్లుగా మీలాంటి వారు లేరు, మీరు తప్ప వేరే దేవుడు లేడు. <verse eid="1CH 17:20"/><verse number="21" style="v" sid="1CH 17:21"/>మీ కోసం మీరు విడిపించిన మీ ప్రజలైన ఇశ్రాయేలు వంటి ప్రజలు ఎవరు ఉన్నారు? వారి దేవుడవైన మీరు వారిని ఈజిప్టులో నుండి విడిపించి, మీ ప్రజల ఎదుట నుండి ఇతర దేశాలను వెళ్లగొట్టినప్పుడు గొప్ప అద్భుతాలను ఆశ్చర్యకార్యాలను చేసి మీకు గొప్ప పేరు తెచ్చుకున్నారు. <verse eid="1CH 17:21"/><verse number="22" style="v" sid="1CH 17:22"/>మీ ఇశ్రాయేలు ప్రజలను నిత్యం మీ సొంత ప్రజలుగా స్థిరపరచి యెహోవావైన మీరు వారికి దేవుడయ్యారు.<verse eid="1CH 17:22"/></para>
  <para style="pm">
    <verse number="23" style="v" sid="1CH 17:23"/>“ఇప్పుడు యెహోవా, మీ సేవకుడనైన నా గురించి నా కుటుంబం గురించి మీరు చేసిన వాగ్దానం ఎల్లకాలం స్థిరపరచబడాలి. మీరు వాగ్దానం చేసినట్టు చేయండి, <verse eid="1CH 17:23"/><verse number="24" style="v" sid="1CH 17:24"/>అప్పుడు అది సుస్థిరమై మీ పేరు ఎప్పటికీ గొప్పగా ఉంటుంది. అప్పుడు ప్రజలు, ‘సైన్యాల యెహోవా, ఇశ్రాయేలు మీద దేవుడే ఇశ్రాయేలీయుల దేవుడు!’ అని అంటారు. మీ సేవకుడైన దావీదు వంశం మీ ఎదుట స్థిరపరచబడుతుంది.<verse eid="1CH 17:24"/></para>
  <para style="pm">
    <verse number="25" style="v" sid="1CH 17:25"/>“నా దేవా! నా కోసం రాజవంశాన్ని స్థాపిస్తాను అని మీరు మీ సేవకునికి తెలియజేశారు. కాబట్టి మీకు ప్రార్థించడానికి మీ సేవకునికి ధైర్యం కలిగింది. <verse eid="1CH 17:25"/><verse number="26" style="v" sid="1CH 17:26"/>యెహోవా, మీరే దేవుడు! మీ సేవకునికి ఈ మంచి విషయాలను వాగ్దానం చేశారు. <verse eid="1CH 17:26"/><verse number="27" style="v" sid="1CH 17:27"/>ఇప్పుడు మీ సేవకుని వంశం నిత్యం మీ సన్నిధిలో ఉండేలా దీవించడం మీకు ఇష్టమైనది; ఎందుకంటే యెహోవా, మీరు దానిని దీవిస్తే అది శాశ్వతంగా దీవించబడుతుంది.”<verse eid="1CH 17:27"/></para>
  <chapter eid="1CH 17"/>
  <chapter number="18" style="c" sid="1CH 18"/>
  <para style="s1">దావీదు విజయాలు</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 18:1"/>కాలక్రమేణా దావీదు ఫిలిష్తీయులను ఓడించి లోబరచుకున్నాడు, వారి ఆధీనంలో నుండి గాతును, దాని చుట్టూ ఉన్న గ్రామాలను స్వాధీనం చేసుకున్నాడు.<verse eid="1CH 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 18:2"/>దావీదు మోయాబీయులను కూడా ఓడించాడు, వారు లొంగిపోయి అతనికి కప్పం<note caller="+" style="f"><char style="fr" closed="false">18:2 </char><char style="ft" closed="false">చక్రవర్తికి తన క్రింద పని చేసే రాజు చెల్లించే వార్షిక పన్ను</char></note> చెల్లించారు.<verse eid="1CH 18:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 18:3"/>అంతేకాక, సోబా రాజైన హదదెజెరు యూఫ్రటీసు నది వరకు తన స్థూపాన్ని<note caller="+" style="f"><char style="fr" closed="false">18:3 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">తన అధికారాన్ని తిరిగి నిలబెట్టుకోవాలని</char></note> నిలబెట్టడానికి బయలుదేరినప్పుడు హమాతు పరిసరాల్లో దావీదు అతన్ని ఓడించాడు. <verse eid="1CH 18:3"/><verse number="4" style="v" sid="1CH 18:4"/>దావీదు అతని దగ్గర నుండి 1,000 రథాలను, 7,000 రథసారధులను, 20,000 మంది సైనికులను పట్టుకున్నాడు. వాటిలో వంద రథాలకు సరిపడా గుర్రాలను ఉంచుకుని మిగతా వాటికి చీలమండల నరాలు తెగగొట్టాడు.<verse eid="1CH 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 18:5"/>సోబా రాజైన హదదెజెరుకు సహాయం చేయడానికి దమస్కులో ఉన్న అరామీయులు వచ్చినప్పుడు, దావీదు వారిలో 22,000 మందిని చంపాడు. <verse eid="1CH 18:5"/><verse number="6" style="v" sid="1CH 18:6"/>దమస్కులో ఉన్న అరామీయుల దేశంలో అతడు తన సైనిక దళాలను ఉంచగా అరామీయులు అతనికి దాసులై, అతనికి కప్పం చెల్లించారు. దావీదు ఎక్కడికి వెళ్లినా యెహోవా అతనికి విజయాన్ని ఇచ్చారు.<verse eid="1CH 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CH 18:7"/>దావీదు హదదెజెరు సైన్యాధిపతులు ధరించిన బంగారు డాళ్లను తీసుకుని, వాటిని యెరూషలేముకు తెచ్చాడు. <verse eid="1CH 18:7"/><verse number="8" style="v" sid="1CH 18:8"/>హదదెజెరుకు చెందిన తెబా<note caller="+" style="f"><char style="fr" closed="false">18:8 </char><char style="ft" closed="false">హెబ్రీలో </char><char style="fqa" closed="false">టిబ్హతు </char><char style="fqa" closed="false">తెబా </char><char style="ft" closed="false">యొక్క మరొక రూపం</char></note> కూను అనే పట్టణాల నుండి దావీదు చాలా మొత్తంలో ఇత్తడిని స్వాధీనం చేసుకున్నాడు. ఆ ఇత్తడితో సొలొమోను ఇత్తడి నీళ్ల తొట్టెను, స్తంభాలను, ఇతర ఇత్తడి వస్తువులను చేయించాడు.<verse eid="1CH 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 18:9"/>సోబా రాజైన హదదెజెరు సైన్యమంతటిని దావీదు ఓడించిన సంగతి హమాతు రాజైన తోయు విన్నప్పుడు, <verse eid="1CH 18:9"/><verse number="10" style="v" sid="1CH 18:10"/>అతడు తన కుమారుడైన హదోరామును రాజైన దావీదు దగ్గరకు అతని క్షేమం గురించి తెలుసుకుని అతనికి శుభాకాంక్షలు చెప్పడానికి పంపాడు, ఎందుకంటే హదదెజెరుకు తోయుకు మధ్య విరోధం ఉంది. హదోరాము బంగారం వెండి ఇత్తడితో చేసిన అన్ని రకాల వస్తువులను తెచ్చాడు.<verse eid="1CH 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 18:11"/>రాజైన దావీదు ఈ వస్తువులను, ఎదోమీయులు, మోయాబీయులు, అమ్మోనీయులు, ఫిలిష్తీయులు, అమాలేకీయుల దేశాల నుండి స్వాధీనం చేసుకున్న వెండి బంగారాలను ప్రతిష్ఠించిన విధంగానే యెహోవాకు ప్రతిష్ఠించాడు.<verse eid="1CH 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CH 18:12"/>సెరూయా కుమారుడైన అబీషై ఉప్పు లోయలో 18,000 మంది ఎదోమీయులను చంపాడు. <verse eid="1CH 18:12"/><verse number="13" style="v" sid="1CH 18:13"/>అతడు ఎదోము దేశంలో సైనిక దళాలను ఉంచాడు. ఎదోమీయులంతా దావీదుకు లొంగిపోయారు. దావీదు ఎక్కడికి వెళ్లినా యెహోవా అతనికి విజయమిచ్చారు.<verse eid="1CH 18:13"/></para>
  <para style="s1">దావీదు అధికారులు</para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 18:14"/>దావీదు ఇశ్రాయేలంతటిని పరిపాలిస్తూ తన ప్రజలందరికి న్యాయాన్ని ధర్మాన్ని జరిగించాడు.<verse eid="1CH 18:14"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 18:15"/>సెరూయా కుమారుడైన యోవాబు సైన్యాధిపతి;</para>
  <para style="li1" vid="1CH 18:15">అహీలూదు కుమారుడైన యెహోషాపాతు రాజ్య దస్తావేజుల మీద అధికారి;<verse eid="1CH 18:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 18:16"/>అహీటూబు కుమారుడైన సాదోకు, అబ్యాతారు కుమారుడైన అహీమెలెకు<note caller="+" style="f"><char style="fr" closed="false">18:16 </char><char style="ft" closed="false">కొ.ప్ర.లలో </char><char style="fqa" closed="false">అబీమెలెకు </char><char style="ft" closed="false"><char style="xt"><ref loc="2SA 8:17">2 సమూ 8:17</ref></char> చూడండి</char></note> యాజకులు;</para>
  <para style="li1" vid="1CH 18:16">షవ్షా కార్యదర్శి;<verse eid="1CH 18:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 18:17"/>యెహోయాదా కుమారుడైన బెనాయా కెరేతీయులకు, పెలేతీయులకు అధిపతి;</para>
  <para style="li1" vid="1CH 18:17">దావీదు కుమారులు రాజు ప్రధాన అధికారులు.<verse eid="1CH 18:17"/></para>
  <chapter eid="1CH 18"/>
  <chapter number="19" style="c" sid="1CH 19"/>
  <para style="s1">దావీదు అమ్మోనీయులను ఓడించుట</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 19:1"/>కొంతకాలం తర్వాత అమ్మోనీయుల రాజు నాహాషు చనిపోయాడు, అతని స్థానంలో అతని కుమారుడు రాజయ్యాడు. <verse eid="1CH 19:1"/><verse number="2" style="v" sid="1CH 19:2"/>అప్పుడు దావీదు, “హానూను తండ్రియైన నాహాషు నా మీద దయ చూపించాడు కాబట్టి నేను హామాను మీద దయ చూపిస్తాను” అని అనుకున్నాడు. కాబట్టి అతని తండ్రి విషయంలో తన సానుభూతి తెలుపడానికి దావీదు తన ప్రతినిధులను పంపించాడు.</para>
  <para style="p" vid="1CH 19:2">దావీదు దూతలు అతనికి సానుభూతి తెలుపడానికి అమ్మోనీయుల దేశంలో ఉన్న హానూను దగ్గరకు వచ్చినప్పుడు, <verse eid="1CH 19:2"/><verse number="3" style="v" sid="1CH 19:3"/>అమ్మోనీయుల దళాధిపతులు హానూనుతో, “నీ తండ్రిని గౌరవించడానికి నీకు సానుభూతి తెలుపాలని దావీదు దూతలను పంపాడని అనుకుంటున్నావా? అతని దూతలు ఈ దేశాన్ని జయించడానికి గూఢాచారులుగా రాలేదా?” అన్నారు. <verse eid="1CH 19:3"/><verse number="4" style="v" sid="1CH 19:4"/>అందువల్ల హానూను దావీదు దూతలను పట్టుకుని వారి జుట్టు గొరిగించి, పిరుదుల దగ్గర వారి వస్త్రాలు కత్తిరించి పంపించేశాడు.<verse eid="1CH 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 19:5"/>కొంతమంది, ఆ మనుష్యుల సంగతి దావీదుకు చెప్పినప్పుడు, వారు చాలా అవమానించబడినట్లు గ్రహించిన రాజు వారి దగ్గరకు మనుష్యులను పంపి, “మీ గడ్డాలు పెరిగే వరకు యెరికో పట్టణంలో ఉండి, ఆ తర్వాత రండి” అని చెప్పాడు.<verse eid="1CH 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 19:6"/>దావీదుకు తాము కోపం తెప్పించామని అమ్మోనీయులు గ్రహించి, హానూను అమ్మోనీయులు వేయి తలాంతుల<note caller="+" style="f"><char style="fr" closed="false">19:6 </char><char style="ft" closed="false">అంటే, సుమారు 38 టన్నుల</char></note> వెండిని పంపి అరాము నహరయీము<note caller="+" style="f"><char style="fr" closed="false">19:6 </char><char style="ft" closed="false">అంటే, వాయువ్య మెసొపొటేమియా</char></note> నుండి, అరాము మయకా నుండి, సోబా నుండి రథాలను, రథసారధులను కిరాయికి తీసుకున్నారు. <verse eid="1CH 19:6"/><verse number="7" style="v" sid="1CH 19:7"/>వారు 32,000 రథాలను, రథసారధులను, మయకా రాజును, అతని సైన్యాన్ని కిరాయికి తీసుకున్నారు. వారు మెదెబా దగ్గరలో శిబిరం ఏర్పరచుకున్నారు, ఆ సమయంలో అమ్మోనీయులు తమ పట్టణాల నుండి సమకూడి యుద్ధం చేయడానికి వెళ్లారు.<verse eid="1CH 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 19:8"/>ఇది విన్న దావీదు యోవాబును యుద్ధ సైనికులందరితో సహా పంపించాడు. <verse eid="1CH 19:8"/><verse number="9" style="v" sid="1CH 19:9"/>అమ్మోనీయులు బయటకు వచ్చి తమ పట్టణ ద్వారం దగ్గర యుద్ధ పంక్తులు తీర్చారు. అక్కడికి వచ్చిన రాజులు విడిగా పొలాల్లో ఉన్నారు.<verse eid="1CH 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 19:10"/>యోవాబు తన ముందు వెనుకా యుద్ధ పంక్తులు ఉండడం చూశాడు; ఇశ్రాయేలులో కొందరు అత్యుత్తమ దళాలను ఎంపికచేసి, వారిని అరామీయులకు ఎదురుగా మోహరించాడు. <verse eid="1CH 19:10"/><verse number="11" style="v" sid="1CH 19:11"/>మిగిలిన వారిని తన సోదరుడైన అబీషై ఆధీనంలో ఉంచాడు, వారిని అమ్మోనీయులకు ఎదురుగా మోహరించాడు. <verse eid="1CH 19:11"/><verse number="12" style="v" sid="1CH 19:12"/>యోవాబు, “అరామీయులను ఎదుర్కోవడం నాకు కష్టమైనప్పుడు నన్ను రక్షించడానికి నీవు రావాలి; అమ్మోనీయులను ఎదుర్కోవడం నీకు కష్టమైనప్పుడు నిన్ను నేను రక్షిస్తాను. <verse eid="1CH 19:12"/><verse number="13" style="v" sid="1CH 19:13"/>ధైర్యంగా ఉండు, మన ప్రజల కోసం, మన దేవుని పట్టణాల కోసం ధైర్యంగా పోరాడదాం. యెహోవా తన దృష్టికి ఏది మంచిదో అది చేస్తారు” అని అబీషైతో చెప్పాడు.<verse eid="1CH 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 19:14"/>అప్పుడు యోవాబు అతనితో ఉన్న దళాలు అరామీయులతో యుద్ధం చేయడానికి ముందుకు వెళ్లగా, అతన్ని ఎదుర్కోలేక వారు పారిపోయారు. <verse eid="1CH 19:14"/><verse number="15" style="v" sid="1CH 19:15"/>అరామీయులు పారిపోయారని గ్రహించిన అమ్మోనీయులు కూడా యోవాబు సోదరుడైన అబీషై ఎదుట నుండి పారిపోయి పట్టణంలోకి వెళ్లారు. అప్పుడు యోవాబు యెరూషలేముకు తిరిగి వెళ్లాడు.<verse eid="1CH 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 19:16"/>తాము ఇశ్రాయేలీయుల చేతిలో ఓడిపోయామని గ్రహించిన అరామీయులు దూతలను పంపి, యూఫ్రటీసు నది అవతల ఉన్న అరామీయులను పిలిపించారు. హదదెజెరు సేనాధిపతియైన షోఫకు వారిని నడిపించాడు.<verse eid="1CH 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 19:17"/>దావీదుకు ఈ సంగతి తెలిసినప్పుడు, అతడు ఇశ్రాయేలు అంతటిని సమకూర్చి యొర్దాను నది దాటి వెళ్లాడు; వారికి ఎదురుగా యుద్ధ పంక్తులు ఏర్పరిచాడు. దావీదు అరామీయులకు ఎదురుగా యుద్ధ పంక్తులు ఏర్పరిచాక వారు అతనితో యుద్ధం చేశారు. <verse eid="1CH 19:17"/><verse number="18" style="v" sid="1CH 19:18"/>అయితే అరామీయులు ఇశ్రాయేలీయుల ఎదుట నుండి పారిపోయారు. దావీదు వారిలో 7,000 మంది రథసారధులను 40,000 సైనికులను చంపాడు. అలాగే వారి సైన్యాధిపతియైన షోఫకును కూడా చంపాడు.<verse eid="1CH 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 19:19"/>హదదెజెరు సేవకులు తాము ఇశ్రాయేలీయుల చేతిలో ఓడిపోతున్నామని గ్రహించి దావీదుతో సమాధానపడి అతనికి లొంగిపోయారు.</para>
  <para style="p" vid="1CH 19:19">అప్పటినుండి ఇంకెప్పుడు అరామీయులు అమ్మోనీయులకు సహాయం చేయడానికి ఇష్టపడలేదు.<verse eid="1CH 19:19"/></para>
  <chapter eid="1CH 19"/>
  <chapter number="20" style="c" sid="1CH 20"/>
  <para style="s1">రబ్బాను పట్టుకొనుట</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 20:1"/>వసంతకాలంలో, రాజులు యుద్ధానికి బయలుదేరే కాలంలో, యోవాబు సైన్యాన్ని సమకూర్చుకున్నాడు. అతడు అమ్మోనీయుల దేశాన్ని నాశనం చేసి రబ్బా పట్టణాన్ని ముట్టడించాడు. అయితే దావీదు యెరూషలేములోనే ఉండిపోయాడు. యోవాబు రబ్బాపై దాడి చేసి దానిని నాశనం చేశాడు. <verse eid="1CH 20:1"/><verse number="2" style="v" sid="1CH 20:2"/>దావీదు వారి రాజు తలమీద నుండి కిరీటాన్ని తీసుకున్నాడు, అది ఒక తలాంతు<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="ft" closed="false">అంటే, సుమారు 34 కి. గ్రా. లు</char></note> బరువు కలిగి ఉండి, ప్రశస్తమైన రాళ్లతో పొదిగించబడి ఉంది. దాన్ని దావీదు తలమీద పెట్టుకున్నాడు. అతడు ఆ పట్టణం నుండి పెద్ద మొత్తంలో దోపుడుసొమ్ము తీసుకెళ్లాడు. <verse eid="1CH 20:2"/><verse number="3" style="v" sid="1CH 20:3"/>అక్కడి ప్రజలను బయటకు తీసుకువచ్చి రంపతో, పదునైన ఇనుప పనిముట్లతో, గొడ్డళ్ళతో కఠినమైన పని చేయించాడు. దావీదు అమ్మోనీయుల పట్టణాలన్నిటికి ఈ విధంగా చేశాడు. తర్వాత దావీదు అతని సైన్యమంతా యెరూషలేముకు తిరిగి వచ్చారు.<verse eid="1CH 20:3"/></para>
  <para style="s1">ఫిలిష్తీయులతో యుద్ధము</para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 20:4"/>కొంతకాలం తర్వాత, గెజెరు దగ్గర ఫిలిష్తీయులతో యుద్ధం జరిగింది. ఆ సమయంలో హుషాతీయుడైన సిబ్బెకై, రెఫాయీయుల వారసుడైన సిప్పయి అనే వాన్ని చంపగా ఫిలిష్తీయులు లొంగిపోయారు.<verse eid="1CH 20:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 20:5"/>ఫిలిష్తీయులతో జరిగిన మరో యుద్ధంలో యాయీరు కుమారుడు ఎల్హానాను, గిత్తీయుడైన గొల్యాతు సోదరుడైన లహ్మీని చంపాడు. అతని ఈటె నేతపనివాని అడ్డకర్రంత పెద్దది.<verse eid="1CH 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 20:6"/>గాతు దగ్గర జరిగిన మరో యుద్ధంలో చాలా పొడవైన వాడొకడు ఉన్నాడు. అతని రెండు చేతులకు కాళ్లకు ఆరు వ్రేళ్ళ చొప్పున మొత్తం ఇరవైనాలుగు వ్రేళ్ళు ఉన్నాయి. అతడు కూడా రాఫా సంతతివాడు. <verse eid="1CH 20:6"/><verse number="7" style="v" sid="1CH 20:7"/>అతడు ఇశ్రాయేలీయులను దూషించినప్పుడు, దావీదు సోదరుడు, షిమ్యా కుమారుడైన యోనాతాను అతన్ని చంపాడు.<verse eid="1CH 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 20:8"/>వీరు గాతుకు చెందిన రాఫా సంతతివారు, వీరు దావీదు అతని సైనికుల చేతిలో చనిపోయారు.<verse eid="1CH 20:8"/></para>
  <chapter eid="1CH 20"/>
  <chapter number="21" style="c" sid="1CH 21"/>
  <para style="s1">దావీదు యుద్ధవీరులను లెక్కించుట</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 21:1"/>సాతాను ఇశ్రాయేలీయులకు వ్యతిరేకంగా లేచి, వారి జనాభా లెక్కపెట్టడానికి దావీదును ప్రేరేపించాడు. <verse eid="1CH 21:1"/><verse number="2" style="v" sid="1CH 21:2"/>కాబట్టి దావీదు యోవాబుతో, సైన్యాధిపతులతో, “మీరు వెళ్లి బెయేర్షేబ నుండి దాను వరకు ఉన్న ఇశ్రాయేలీయులను లెక్కించండి. వారి సంఖ్య నాకు తెలిసేలా ఆ వివరాలు నా దగ్గరకు తీసుకురండి” అని చెప్పాడు.<verse eid="1CH 21:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CH 21:3"/>కాని యోవాబు రాజుతో, “యెహోవా తన సైన్యాన్ని వందరెట్లు పెంచు గాక! నా ప్రభువా, రాజా, వారంతా నా ప్రభువుకు సేవకులే కదా? నా ప్రభువు ఇలా ఎందుకు చేయాలనుకుంటున్నాడు? అతడు ఇశ్రాయేలు మీదికి దోషం ఎందుకు తేవాలి?” అని అన్నాడు.<verse eid="1CH 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 21:4"/>అయితే రాజు యోవాబుపై తన మాట సాధించుకున్నాడు; కాబట్టి యోవాబు వెళ్లి, ఇశ్రాయేలు దేశమంతా తిరిగి యెరూషలేముకు తిరిగి వచ్చాడు. <verse eid="1CH 21:4"/><verse number="5" style="v" sid="1CH 21:5"/>యోవాబు యుద్ధం చేయగలవారి సంఖ్య దావీదుకు తెలియజేశాడు. ఇశ్రాయేలు అంతటిలో కత్తి తిప్పగలవారు పదకొండు లక్షలమంది ఉన్నారు, యూదా వారిలో నాలుగు లక్షల డెబ్బైవేలమంది ఉన్నారు.<verse eid="1CH 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 21:6"/>రాజాజ్ఞ యోవాబుకు అభ్యంతరకరంగా ఉంది కాబట్టి అతడు లేవీ బెన్యామీను వారిని లెక్కలలో చేర్చలేదు. <verse eid="1CH 21:6"/><verse number="7" style="v" sid="1CH 21:7"/>ఈ ఆజ్ఞ దేవుని దృష్టిలో కూడా చెడ్డగా ఉంది; కాబట్టి ఆయన ఇశ్రాయేలును శిక్షించారు.<verse eid="1CH 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 21:8"/>అప్పుడు దావీదు దేవునితో, “నేను ఇది చేసి ఘోరపాపం చేశాను. మీ సేవకుని దోషాన్ని తొలగించమని బ్రతిమాలుకుంటున్నాను. నేను చాలా మూర్ఖంగా ప్రవర్తించాను” అని ప్రార్థన చేశాడు.<verse eid="1CH 21:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 21:9"/>యెహోవా, దావీదుకు దీర్ఘదర్శిగా ఉన్న గాదుతో ఇలా అన్నారు, <verse eid="1CH 21:9"/><verse number="10" style="v" sid="1CH 21:10"/>“వెళ్లి దావీదుతో ఇలా చెప్పు, ‘యెహోవా చెప్పే మాట ఇదే: నేను నీకు మూడు ఎంపికలు ఇస్తున్నాను. వాటిలో ఒకదాన్ని ఎంచుకో, దానిని నీమీదికి రప్పిస్తాను.’ ”<verse eid="1CH 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 21:11"/>కాబట్టి గాదు దావీదు దగ్గరకు వెళ్లి అతనితో, “యెహోవా చెప్పే మాట ఇదే: ‘వీటిలో ఒకదాన్ని ఎంచుకో: <verse eid="1CH 21:11"/><verse number="12" style="v" sid="1CH 21:12"/>మూడు సంవత్సరాల కరువు, మూడు నెలలు నీ శత్రువులు కత్తి దూసి నిన్ను తరిమితే వారి ఎదుట నుండి పారిపోవడం, లేదా మూడు రోజులపాటు దేశంలో యెహోవా ఖడ్గం అనగా తెగులు వ్యాపించడం ద్వారా యెహోవా దేవదూత ఇశ్రాయేలీయుల దేశమంతటిని నాశనం చేయడం.’ ఇప్పుడు, నన్ను పంపిన వ్యక్తికి నేనేమి జవాబివ్వాలో నిర్ణయించుకో” అన్నాడు.<verse eid="1CH 21:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CH 21:13"/>అందుకు దావీదు గాదుతో, “నేను తీవ్ర బాధలో ఉన్నాను. యెహోవా కనికరం ఎంతో గొప్పది కాబట్టి ఆయన చేతిలోనే నేను పడాలి; కాని మనుష్యుల చేతిలో నేను పడకూడదు” అని అన్నాడు.<verse eid="1CH 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 21:14"/>కాబట్టి యెహోవా ఇశ్రాయేలు మీదికి తెగులు రప్పించారు, డెబ్బైవేలమంది ఇశ్రాయేలీయులు చనిపోయారు. <verse eid="1CH 21:14"/><verse number="15" style="v" sid="1CH 21:15"/>దేవుడు యెరూషలేమును నాశనం చేయడానికి ఒక దూతను పంపారు. అయితే ఆ దూత దానిని నాశనం చేస్తున్నప్పుడు, జరిగిన కీడును చూసి యెహోవా మనస్సు కరిగి ప్రజలను నాశనం చేస్తున్న దూతతో, “ఇక చాలు! నీ చేయి వెనుకకు తీసుకో” అని చెప్పారు. ఆ సమయంలో యెహోవా దూత యెబూసీయుడైన ఒర్నాను<note caller="+" style="f"><char style="fr" closed="false">21:15 </char><char style="fq" closed="false">ఒర్నాను </char><char style="fqa" closed="false">అరౌనా </char><char style="ft" closed="false">ఒర్నానుకు మరొక రూపం</char></note> నూర్పిడి కళ్ళం దగ్గర నిలబడ్డాడు.<verse eid="1CH 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CH 21:16"/>దావీదు పైకి చూసినప్పుడు భూమికి ఆకాశానికి మధ్యలో నిలబడి, కత్తి పట్టుకుని దానిని యెరూషలేము మీద చాపి ఉంచిన యెహోవా దూత అతనికి కనిపించాడు. అప్పుడు దావీదు, పెద్దలు గోనెపట్ట కట్టుకుని సాష్టాంగపడ్డారు.<verse eid="1CH 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 21:17"/>దావీదు దేవునితో, “యుద్ధవీరులను లెక్కించమని ఆదేశించింది నేనే కదా? గొర్రెల కాపరినైన నేను పాపం చేశాను! వీరు గొర్రెల వంటి వారు, వీరేమి చేశారు? యెహోవా! నా దేవా, మీ చేతులు నా మీద నా కుటుంబం మీద పడనివ్వండి, కాని మీ ప్రజలమీదికి ఈ తెగులు రానివ్వకండి” అన్నాడు.<verse eid="1CH 21:17"/></para>
  <para style="s1">దావీదు బలిపీఠం కడతాడు</para>
  <para style="p">
    <verse number="18" style="v" sid="1CH 21:18"/>అప్పుడు యెహోవా దూత యెబూసీయుడైన ఒర్నాను నూర్పిడి కళ్ళంలో యెహోవాకు బలిపీఠం కట్టించాలని దావీదుకు చెప్పమని గాదుకు ఆజ్ఞాపించాడు. <verse eid="1CH 21:18"/><verse number="19" style="v" sid="1CH 21:19"/>కాబట్టి యెహోవా పేరిట గాదు చెప్పిన మాటకు లోబడి దావీదు బయలుదేరి వెళ్లాడు.<verse eid="1CH 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 21:20"/>ఒర్నాను గోధుమలు నూరుస్తున్నప్పుడు, అతడు వెనుకకు తిరిగి ఆ దేవదూతను చూసి అతడు, అతనితో ఉన్న అతని నలుగురు కుమారులు దాక్కున్నారు. <verse eid="1CH 21:20"/><verse number="21" style="v" sid="1CH 21:21"/>అప్పుడు దావీదు వస్తూంటే, ఒర్నాను అతన్ని చూసి నూర్పిడి కళ్ళంలో నుండి బయటకు వచ్చి తలను నేలకు వంచి దావీదుకు నమస్కారం చేశాడు.<verse eid="1CH 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CH 21:22"/>దావీదు ఒర్నానుతో, “ప్రజల మీద ఉన్న తెగులు ఆగిపోవడానికి ఈ నూర్పిడి కళ్ళం ఉన్న స్థలంలో నేను యెహోవాకు బలిపీఠం కట్టడానికి పూర్తి ఖరీదుకు దానిని నాకు అమ్ము” అని అన్నాడు.<verse eid="1CH 21:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CH 21:23"/>అందుకు ఒర్నాను దావీదుతో, “నా ప్రభువా, రాజా తీసుకోండి! మీకు ఏది ఇష్టమో అది చేయండి. చూడండి, దహనబలులకు ఎద్దులు, నూర్చే కర్రలు కట్టెలు, భోజనార్పణ కోసం గోధుమలిస్తాను. ఇదంతా ఇచ్చేస్తాను” అని అన్నాడు.<verse eid="1CH 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CH 21:24"/>అయితే రాజైన దావీదు ఒర్నానుతో, “లేదు, నీకు పూర్తి వెల చెల్లించి కొంటాను. నేను నీ వాటిని యెహోవా కోసం ఉచితంగా తీసుకోను లేదా నాకు ఖర్చు కాని దానితో దహనబలి అర్పించను” అన్నాడు.<verse eid="1CH 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 21:25"/>కాబట్టి దావీదు ఆ స్థలానికి ఆరువందల షెకెళ్ళ<note caller="+" style="f"><char style="fr" closed="false">21:25 </char><char style="ft" closed="false">అంటే, సుమారు 6.9 కి. గ్రా. లు</char></note> బంగారాన్ని ఒర్నానుకు ఇచ్చాడు. <verse eid="1CH 21:25"/><verse number="26" style="v" sid="1CH 21:26"/>దావీదు అక్కడ యెహోవాకు బలిపీఠం కట్టి దహనబలులు సమాధానబలులు అర్పించాడు. అప్పుడు అతడు యెహోవాకు ప్రార్థించగా, యెహోవా పరలోకం నుండి బలిపీఠం మీదికి అగ్నిని పంపి అతనికి జవాబిచ్చారు.<verse eid="1CH 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CH 21:27"/>అప్పుడు యెహోవా దూతతో మాట్లాడగా అతడు తన కత్తిని తిరిగి ఒరలో పెట్టాడు. <verse eid="1CH 21:27"/><verse number="28" style="v" sid="1CH 21:28"/>ఆ సమయంలో యెబూసీయుడైన ఒర్నాను నూర్పిడి కళ్ళంలో యెహోవా తనకు జవాబిచ్చాడని గ్రహించి దావీదు అక్కడ బలులర్పించాడు. <verse eid="1CH 21:28"/><verse number="29" style="v" sid="1CH 21:29"/>మోషే అరణ్యంలో చేయించిన యెహోవా సమావేశ గుడారం, దహనబలి బలిపీఠం ఆ కాలంలో గిబియోనులోని ఎత్తైన స్థలంలో ఉన్నాయి. <verse eid="1CH 21:29"/><verse number="30" style="v" sid="1CH 21:30"/>అయితే దావీదు యెహోవా దూత యొక్క ఖడ్గానికి భయపడి, దేవుని దగ్గర విచారణ చేయడానికి ఆ స్థలానికి వెళ్లలేదు.<verse eid="1CH 21:30"/></para>
  <chapter eid="1CH 21"/>
  <chapter number="22" style="c" sid="1CH 22"/>
  <para style="p">
    <verse number="1" style="v" sid="1CH 22:1"/>తర్వాత దావీదు, “దేవుడైన యెహోవా మందిరం, ఇశ్రాయేలు కోసం దహనబలులు అర్పించే బలిపీఠం ఇక్కడ ఉండాలి” అని అన్నాడు.<verse eid="1CH 22:1"/></para>
  <para style="s1">దేవాలయం కోసం సన్నాహాలు</para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 22:2"/>కాబట్టి దావీదు ఇశ్రాయేలు దేశంలో నివసిస్తున్న విదేశీయులను సమావేశపరచమని ఆజ్ఞాపించాడు. అతడు వారిలో కొందరిని దేవుని మందిరం కట్టించడానికి రాళ్లు చెక్కే పనికి నియమించాడు. <verse eid="1CH 22:2"/><verse number="3" style="v" sid="1CH 22:3"/>దావీదు ద్వారాల తలుపులకు కావలిసిన మేకులు, బందుల కోసం చాలా ఇనుమును తూయలేనంత ఇత్తడిని సమకూర్చాడు. <verse eid="1CH 22:3"/><verse number="4" style="v" sid="1CH 22:4"/>సీదోనీయులు, తూరీయులు దావీదుకు పెద్ద సంఖ్యలో దేవదారు మ్రానులను తీసుకురావడం వల్ల, వాటిని కూడా లెక్కపెట్టలేనంతగా సమకూర్చాడు.<verse eid="1CH 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CH 22:5"/>దావీదు, “నా కుమారుడైన సొలొమోను చిన్నవాడు, అనుభవం లేనివాడు, యెహోవాకు కట్టవలసిన మందిరపు కీర్తి, వైభవం బట్టి అది అన్ని దేశాల్లో ప్రసిద్ధి చెందాలి. కాబట్టి దాని నిర్మాణానికి కావలసిన వాటిని నేను సిద్ధం చేస్తాను” అని చెప్పి దావీదు చనిపోవడానికి ముందే విస్తారంగా సామాగ్రిని సిద్ధం చేశాడు.<verse eid="1CH 22:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 22:6"/>తర్వాత అతడు తన కుమారుడైన సొలొమోనును పిలిచి, ఇశ్రాయేలీయుల దేవుడైన యెహోవాకు మందిరం కట్టాలని అతన్ని ఆదేశించాడు. <verse eid="1CH 22:6"/><verse number="7" style="v" sid="1CH 22:7"/>దావీదు సొలొమోనుతో ఇలా అన్నాడు: “నా కుమారుడా, నా దేవుడైన యెహోవా నామం కోసం మందిరాన్ని కట్టించాలని నా హృదయంలో అనుకున్నాను. <verse eid="1CH 22:7"/><verse number="8" style="v" sid="1CH 22:8"/>అయితే యెహోవా మాట నాతో ఇలా చెప్పింది: ‘నీవు చాలా రక్తం చిందించి, చాలా యుద్ధాలు చేశావు. నా ఎదుట నీవు నేల మీద చాలా రక్తాన్ని చిందించావు, కాబట్టి నీవు నా పేరిట మందిరాన్ని కట్టించకూడదు. <verse eid="1CH 22:8"/><verse number="9" style="v" sid="1CH 22:9"/>అయితే నీకు ఒక కుమారుడు జన్మిస్తాడు, అతడు సమాధానం, విశ్రాంతి కలిగిన వ్యక్తిగా ఉంటాడు. అన్నివైపులా అతని శత్రువులందరి నుండి నేనతనికి విశ్రాంతిని ఇస్తాను. అతనికి సొలొమోను<note caller="+" style="f"><char style="fr" closed="false">22:9 </char><char style="ft" closed="false">హెబ్రీ నుండి గ్రహించబడిన పదం </char><char style="fq" closed="false">సమాధానం</char></note> అనే పేరు పెడతారు. అతని కాలంలో ఇశ్రాయేలు ప్రజలకు సమాధానాన్ని, నెమ్మదిని ఇస్తాను. <verse eid="1CH 22:9"/><verse number="10" style="v" sid="1CH 22:10"/>అతడే నా పేరిట ఒక మందిరాన్ని కట్టిస్తాడు. అతడు నాకు కుమారుడై ఉంటాడు, నేనతనికి తండ్రినై ఉంటాను. ఇశ్రాయేలీయుల మీద అతని రాజ్యసింహాసనాన్ని శాశ్వతంగా స్థిరపరుస్తాను.’<verse eid="1CH 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 22:11"/>“నా కుమారుడా, యెహోవా నీకు తోడుగా ఉంటారు, నీవు విజయం సాధించి, నీ దేవుడైన యెహోవా నీ గురించి చెప్పిన ప్రకారం నీవు ఆయనకు మందిరాన్ని కట్టిస్తావు. <verse eid="1CH 22:11"/><verse number="12" style="v" sid="1CH 22:12"/>నీ దేవుడైన యెహోవా ధర్మశాస్త్రాన్ని నీవు అనుసరించేలా ఆయన నిన్ను ఇశ్రాయేలీయుల మీద పాలకునిగా నియమించినప్పుడు, యెహోవా నీకు వివేకాన్ని జ్ఞానాన్ని ఆయన ఇచ్చును గాక. <verse eid="1CH 22:12"/><verse number="13" style="v" sid="1CH 22:13"/>అప్పుడు ఇశ్రాయేలీయుల గురించి యెహోవా మోషేకు ఇచ్చిన నియమనిబంధనలను నీవు జాగ్రత్తగా పాటిస్తే, నీవు విజయం సాధిస్తావు. ధైర్యంగా దృఢంగా ఉండు. భయపడకు, నిరుత్సాహపడకు.<verse eid="1CH 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 22:14"/>“యెహోవా మందిరం కట్టడానికి కావలసిన వాటిని సమకూర్చడం కోసం నేను చాలా శ్రమపడ్డాను. దాని కోసం లక్ష తలాంతుల<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="ft" closed="false">అంటే, సుమారు 3750 టన్నులు</char></note> బంగారాన్ని, పది లక్షల తలాంతుల<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="ft" closed="false">అంటే, 37,500 టన్నులు</char></note> వెండిని, తూయలేనంత ఇత్తడిని, ఇనుమును సమకూర్చాను. చెక్క, రాళ్లు కూడా సమకూర్చాను. నీవింకా వాటికి కలుపవచ్చు. <verse eid="1CH 22:14"/><verse number="15" style="v" sid="1CH 22:15"/>నీ దగ్గర చాలామంది నైపుణ్యం కలిగిన పనివారు అనగా శిల్పకారులు, తాపీ పనివారు, వడ్రంగులు, అన్ని రకాల పనులు చేసేవారు, <verse eid="1CH 22:15"/><verse number="16" style="v" sid="1CH 22:16"/>బంగారం, వెండి, ఇత్తడి, ఇనుములతో పని చేసే శిల్పకారులు సంఖ్యకు మించి ఉన్నారు. కాబట్టి ఇక పని మొదలుపెట్టు. యెహోవా నీకు తోడుగా ఉండును గాక!”<verse eid="1CH 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CH 22:17"/>తర్వాత తన కుమారుడైన సొలొమోనుకు సహాయం చేయాలని దావీదు ఇశ్రాయేలీయుల నాయకులందరికి ఆదేశించాడు. <verse eid="1CH 22:17"/><verse number="18" style="v" sid="1CH 22:18"/>అతడు వారితో ఇలా అన్నాడు, “మీ దేవుడైన యెహోవా మీతో ఉన్నారు కదా? అన్నివైపులా ఆయన మీకు విశ్రాంతి ఇచ్చారు కదా? ముందున్న దేశవాసులను ఆయన నా చేతికి అప్పగించారు కాబట్టి ఇప్పుడు దేశం యెహోవాకు, ఆయన ప్రజలకు స్వాధీనం అయింది. <verse eid="1CH 22:18"/><verse number="19" style="v" sid="1CH 22:19"/>ఇప్పుడు మనసారా మీ దేవుడైన యెహోవాను వెదకండి. యెహోవా నిబంధన మందసాన్ని, దేవుని సంబంధమైన పవిత్ర వస్తువులను, ఆయన పేరున కట్టబడే మందిరంలోకి చేర్చేటట్టు మీరు దేవుడైన యెహోవా పరిశుద్ధాలయాన్ని కట్టడం మొదలుపెట్టండి.”<verse eid="1CH 22:19"/></para>
  <chapter eid="1CH 22"/>
  <chapter number="23" style="c" sid="1CH 23"/>
  <para style="s1">లేవీయులు</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 23:1"/>దావీదు వృద్ధుడై వయస్సు నిండినవాడై ఉన్నప్పుడు, అతడు తన కుమారుడైన సొలొమోనును ఇశ్రాయేలు మీద రాజుగా నియమించాడు.<verse eid="1CH 23:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 23:2"/>అతడు ఇశ్రాయేలు నాయకులందరిని, యాజకులను, లేవీయులను సమకూర్చాడు. <verse eid="1CH 23:2"/><verse number="3" style="v" sid="1CH 23:3"/>ముప్పై సంవత్సరాలు అంతకు పైవయస్సు లేవీయులు లెక్కించబడ్డారు. వారు మొత్తం ముప్పై ఎనిమిది వేలమంది మనుష్యులు. <verse eid="1CH 23:3"/><verse number="4" style="v" sid="1CH 23:4"/>దావీదు, “వీరిలో ఇరవైనాలుగు వేలమంది యెహోవా ఆలయ పని బాధ్యత తీసుకోవాలి, ఆరు వేలమంది అధికారులుగా, న్యాయాధిపతులుగా ఉండాలి. <verse eid="1CH 23:4"/><verse number="5" style="v" sid="1CH 23:5"/>నాలుగు వేలమంది ద్వారపాలకులుగా ఉండాలి, నాలుగు వేలమంది ఉద్దేశ్యం కలిగి నేను చేయించిన సంగీత వాయిద్యాలతో యెహోవాను కీర్తించాలి” అని చెప్పాడు.<verse eid="1CH 23:5"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="6" style="v" sid="1CH 23:6"/>లేవీ కుమారులైన గెర్షోను, కహాతు, మెరారి వంశాల ప్రకారం దావీదు లేవీయులను వేరుచేసి మూడు విభాగాలు చేశాడు.<verse eid="1CH 23:6"/></para>
  <para style="s1">గెర్షోనీయులు</para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 23:7"/>గెర్షోనీయులకు చెందినవారు:</para>
  <para style="li2" vid="1CH 23:7">లద్దాను, షిమీ.<verse eid="1CH 23:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 23:8"/>లద్దాను కుమారులు:</para>
  <para style="li2" vid="1CH 23:8">యెహీయేలు, జేతాము, యోవేలు మొత్తం ముగ్గురు.<verse eid="1CH 23:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 23:9"/>షిమీ కుమారులు:</para>
  <para style="li2" vid="1CH 23:9">షెలోమీతు, హజీయేలు, హారాను మొత్తం ముగ్గురు.</para>
  <para style="li2" vid="1CH 23:9">(వీరు లద్దాను కుటుంబాల పెద్దలు.)<verse eid="1CH 23:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 23:10"/>షిమీ కుమారులు:</para>
  <para style="li2" vid="1CH 23:10">యహతు, జీనా,<note caller="+" style="f"><char style="fr" closed="false">23:10 </char><char style="ft" closed="false">కొ.ప్ర.లలో </char><char style="fqa" closed="false">జీజా</char></note> యూషు, బెరీయా.</para>
  <para style="li2" vid="1CH 23:10">వీరు షిమీ కుమారులు మొత్తం నలుగురు.<verse eid="1CH 23:10"/></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 23:11"/>(యహతు పెద్దవాడు, జీజా రెండవవాడు, అయితే యూషుకు, బెరీయాకు కుమారులు ఎక్కువ మంది లేరు; కాబట్టి తమ కర్తవ్యం విషయంలో వారిని ఒక్క కుటుంబంగానే లెక్కించారు.)<verse eid="1CH 23:11"/></para>
  <para style="s1">కహాతీయులు</para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 23:12"/>కహాతు కుమారులు:</para>
  <para style="li2" vid="1CH 23:12">అమ్రాము, ఇస్హారు, హెబ్రోను, ఉజ్జీయేలు మొత్తం నలుగురు.<verse eid="1CH 23:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 23:13"/>అమ్రాము కుమారులు:</para>
  <para style="li2" vid="1CH 23:13">అహరోను, మోషే.</para>
  <para style="li2" vid="1CH 23:13">అహరోను, అతని వారసులు నిత్యం అతి పరిశుద్ధ వస్తువులను ప్రతిష్ఠించడానికి, యెహోవా సన్నిధిలో బలులు అర్పించడానికి, ఆయన సన్నిధిలో సేవ చేయడానికి, ఆయన నామాన్ని బట్టి ప్రజలను దీవించడానికి ప్రత్యేకించబడ్డారు. <verse eid="1CH 23:13"/><verse number="14" style="v" sid="1CH 23:14"/>దైవజనుడైన మోషే కుమారులు లేవీ గోత్రం వారిలో లెక్కించబడ్డారు.<verse eid="1CH 23:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 23:15"/>మోషే కుమారులు:</para>
  <para style="li2" vid="1CH 23:15">గెర్షోము, ఎలీయెజెరు.<verse eid="1CH 23:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 23:16"/>గెర్షోము వారసులు:</para>
  <para style="li2" vid="1CH 23:16">షెబూయేలు మొదటివాడు.<verse eid="1CH 23:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 23:17"/>ఎలీయెజెరు వారసులు:</para>
  <para style="li2" vid="1CH 23:17">రెహబ్యా మొదటివాడు.</para>
  <para style="li2" vid="1CH 23:17">(ఎలీయెజెరుకు ఇక కుమారులెవరు లేరు, కాని రెహబ్యాకు చాలామంది కుమారులున్నారు.)<verse eid="1CH 23:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 23:18"/>ఇస్హారు కుమారులు:</para>
  <para style="li2" vid="1CH 23:18">షెలోమీతు మొదటివాడు.<verse eid="1CH 23:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 23:19"/>హెబ్రోను కుమారులు:</para>
  <para style="li2" vid="1CH 23:19">యెరీయా మొదటివాడు, అమర్యా రెండవవాడు,</para>
  <para style="li2" vid="1CH 23:19">యహజీయేలు మూడవవాడు, యెక్మెయాము నాలుగవవాడు.<verse eid="1CH 23:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 23:20"/>ఉజ్జీయేలు కుమారులు:</para>
  <para style="li2" vid="1CH 23:20">మీకా మొదటివాడు, ఇష్షీయా రెండవవాడు.<verse eid="1CH 23:20"/></para>
  <para style="s1">మెరారీయులు</para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 23:21"/>మెరారి కుమారులు:</para>
  <para style="li2" vid="1CH 23:21">మహలి, మూషి.</para>
  <para style="li1" vid="1CH 23:21">మహలి కుమారులు:</para>
  <para style="li2" vid="1CH 23:21">ఎలియాజరు, కీషు.<verse eid="1CH 23:21"/></para>
  <para style="li2">
    <verse number="22" style="v" sid="1CH 23:22"/>(ఎలియాజరు కుమారులు లేకుండానే చనిపోయాడు: అతనికి కుమార్తెలు మాత్రమే ఉన్నారు. వారి బంధువులైన కీషు కుమారులు వారిని పెళ్ళి చేసుకున్నారు.)<verse eid="1CH 23:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 23:23"/>మూషి కుమారులు:</para>
  <para style="li2" vid="1CH 23:23">మహలి, ఏదెరు, యెరీమోతు మొత్తం ముగ్గురు.<verse eid="1CH 23:23"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="24" style="v" sid="1CH 23:24"/>వీరు కుటుంబాల ప్రకారం లేవీ వారసులు; పేర్ల నమోదు ప్రకారం కుటుంబ పెద్దలైన వీరు ఇరవై సంవత్సరాలు అంతకు పైవయస్సు కలిగి, తమ తమ పేర్లను బట్టి ఒక్కొక్కరుగా లెక్కించబడి యెహోవా మందిరంలో సేవ చేయడానికి నియమించబడ్డారు. <verse eid="1CH 23:24"/><verse number="25" style="v" sid="1CH 23:25"/>ఎందుకంటే దావీదు, “ఇశ్రాయేలు దేవుడైన యెహోవా తన ప్రజలకు నెమ్మది ప్రసాదించి, శాశ్వతంగా యెరూషలేములో నివసించడానికి వచ్చారు కాబట్టి, <verse eid="1CH 23:25"/><verse number="26" style="v" sid="1CH 23:26"/>ఇకపై లేవీయులకు సమావేశ గుడారాన్ని, దాని సేవకు ఉపయోగించే వస్తువులను మోసే పనిలేదు” అని చెప్పాడు. <verse eid="1CH 23:26"/><verse number="27" style="v" sid="1CH 23:27"/>దావీదు ఇచ్చిన చివరి ఆదేశాల ప్రకారం, లేవీయులలో ఇరవై సంవత్సరాలు అంతకు పైవయస్సు వారిని లెక్కించారు.<verse eid="1CH 23:27"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="28" style="v" sid="1CH 23:28"/>యెహోవా ఆలయ సేవలలో అహరోను వారసులకు సహాయం చేయడమే వారికి అప్పగించబడిన బాధ్యత: ప్రాంగణాలు, ప్రక్క గదుల బాధ్యత, పవిత్ర వస్తువులన్నిటిని శుద్ధి చేయడం, దేవుని మందిరంలో ఇతర పనులు చేయడము. <verse eid="1CH 23:28"/><verse number="29" style="v" sid="1CH 23:29"/>బల్లమీద సన్నిధి రొట్టెలుంచడం, భోజనార్పణల కోసం ప్రత్యేక పిండిని చూడడం, పులియని అప్పడాలు చేయడం, కాల్చడం, కలపడం, అన్ని రకాల పరిమాణాలు కొలతల్లో సిద్ధపరచడము. <verse eid="1CH 23:29"/><verse number="30-31" style="v" sid="1CH 23:30-31"/>వారు ప్రతిరోజు ఉదయం, సాయంకాలం నిలబడి యెహోవాను స్తుతించాలి. వారు సాయంకాలంలో, సబ్బాతు దినాల్లో, అమావాస్యల్లో, నియమించబడిన పండుగల్లో, యెహోవాకు దహనబలులు అర్పించే సమయాలన్నిటిలో వారు ఆయనను స్తుతించాలి. వారికి నియమించబడిన విధానం ప్రకారం క్రమంగా యెహోవా సముఖంలో సేవ చేయాలి.<verse eid="1CH 23:30-31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1CH 23:32"/>కాబట్టి లేవీయులు సమావేశపు గుడారానికి, పరిశుద్ధ స్థలానికి బాధ్యత వహిస్తూ, యెహోవా ఆలయ సేవ కోసం తమ బంధువులైన అహరోను వారసుల క్రింద వారు సేవ చేశారు.<verse eid="1CH 23:32"/></para>
  <chapter eid="1CH 23"/>
  <chapter number="24" style="c" sid="1CH 24"/>
  <para style="s1">యాజకుల విభాగాలు</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 24:1"/>ఇవి అహరోను వారసుల విభాగాలు:</para>
  <para style="p" vid="1CH 24:1">అహరోను కుమారులు నాదాబు, అబీహు, ఎలియాజరు, ఈతామారు. <verse eid="1CH 24:1"/><verse number="2" style="v" sid="1CH 24:2"/>నాదాబు, అబీహు కుమారులు లేకుండానే తమ తండ్రి కంటే ముందే చనిపోయారు; కాబట్టి ఎలియాజరు, ఈతామారు యాజకులుగా సేవ చేశారు. <verse eid="1CH 24:2"/><verse number="3" style="v" sid="1CH 24:3"/>ఎలియాజరు వారసుడైన సాదోకు, ఈతామారు వారసుడైన అహీమెలెకు సహాయంతో, వారికి నియమించబడిన సేవా క్రమంలో, దావీదు వారిని విభాగించాడు. <verse eid="1CH 24:3"/><verse number="4" style="v" sid="1CH 24:4"/>ఈతామారు వారసులలో కంటే ఎలియాజరు వారసులలో ఎక్కువ మంది నాయకులు ఉన్నారు కాబట్టి దాని ప్రకారం ఎలియాజరు వారసులలో పదహారుగురు కుటుంబ పెద్దలు, ఈతామారు వారసులలో ఎనిమిది మంది కుటుంబ పెద్దలుగా నియమించబడ్డారు. <verse eid="1CH 24:4"/><verse number="5" style="v" sid="1CH 24:5"/>ఎలియాజరు వారసులలో, ఈతామారు వారసులలో పరిశుద్ధాలయ అధికారులుగా, దేవుని సేవకులుగా ఉన్నారు కాబట్టి, పక్షపాతం లేకుండా చీట్లు వేసి వారిని విభాగించారు.<verse eid="1CH 24:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 24:6"/>లేవీయులలో లేఖికునిగా ఉన్న నెతనేలు కుమారుడైన షెమయా, వారి పేర్లను రాజు, అతని అధికారులు యాజకుడైన సాదోకు, అబ్యాతారు కుమారుడైన అహీమెలెకు, యాజకుల కుటుంబ పెద్దలు, లేవీయుల ఎదుట నమోదు చేశాడు. ఒక కుటుంబం ఎలియాజరు నుండి, తర్వాత మరొక కుటుంబం ఈతామారు నుండి తీసుకోబడింది.<verse eid="1CH 24:6"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 24:7"/>మొదటి చీటి యెహోయారీబుకు,</para>
  <para style="li1" vid="1CH 24:7">రెండవది యెదాయాకు,<verse eid="1CH 24:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 24:8"/>మూడవది హారీముకు,</para>
  <para style="li1" vid="1CH 24:8">నాలుగవది శెయొరీముకు,<verse eid="1CH 24:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 24:9"/>అయిదవది మల్కీయాకు,</para>
  <para style="li1" vid="1CH 24:9">ఆరవది మీయామినుకు,<verse eid="1CH 24:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 24:10"/>ఏడవది హక్కోజుకు,</para>
  <para style="li1" vid="1CH 24:10">ఎనిమిదవది అబీయాకు,<verse eid="1CH 24:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 24:11"/>తొమ్మిదవది యెషూవకు,</para>
  <para style="li1" vid="1CH 24:11">పదవది షెకన్యాకు,<verse eid="1CH 24:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 24:12"/>పదకొండవది ఎల్యాషీబుకు,</para>
  <para style="li1" vid="1CH 24:12">పన్నెండవది యాకీముకు,<verse eid="1CH 24:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 24:13"/>పదమూడవది హుప్పాకు,</para>
  <para style="li1" vid="1CH 24:13">పద్నాలుగవది యెషెబాబుకు,<verse eid="1CH 24:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 24:14"/>పదిహేనవది బిల్గాకు,</para>
  <para style="li1" vid="1CH 24:14">పదహారవది ఇమ్మేరుకు,<verse eid="1CH 24:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 24:15"/>పదిహేడవది హెజీరుకు,</para>
  <para style="li1" vid="1CH 24:15">పద్దెనిమిదవది హప్పిస్సేసుకు,<verse eid="1CH 24:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 24:16"/>పందొమ్మిదవది పెతహయాకు,</para>
  <para style="li1" vid="1CH 24:16">ఇరవయ్యవది యెహెజ్కేలుకు,<verse eid="1CH 24:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 24:17"/>ఇరవై ఒకటవది యాకీనుకు,</para>
  <para style="li1" vid="1CH 24:17">ఇరవై రెండవది గామూలుకు,<verse eid="1CH 24:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 24:18"/>ఇరవై మూడవది దెలాయ్యాకు,</para>
  <para style="li1" vid="1CH 24:18">ఇరవై నాలుగవది మయజ్యాకు వచ్చాయి.<verse eid="1CH 24:18"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="19" style="v" sid="1CH 24:19"/>ఇశ్రాయేలీయుల దేవుడైన యెహోవా వారి పితరుడైన అహరోనుకు ఆజ్ఞాపించిన ప్రకారం, అహరోను వారికి నియమించిన నిబంధనల ప్రకారం, వారు యెహోవా మందిరంలో ప్రవేశించినప్పుడు వారు చేయాల్సిన సేవా క్రమం ఇది.<verse eid="1CH 24:19"/></para>
  <para style="s1">లేవీయులలో మిగిలినవారు</para>
  <para style="lh">
    <verse number="20" style="v" sid="1CH 24:20"/>లేవీ వారసులలో మిగిలినవారు:</para>
  <para style="b" vid="1CH 24:20"/>
  <para style="li1" vid="1CH 24:20">అమ్రాము కుమారుల నుండి: షూబాయేలు;</para>
  <para style="li2" vid="1CH 24:20">షూబాయేలు కుమారుల నుండి: యెహెద్యాహు.<verse eid="1CH 24:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 24:21"/>రెహబ్యాకు కుమారుల నుండి పెద్దవాడైన ఇష్షీయా.<verse eid="1CH 24:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 24:22"/>ఇస్హారీయుల్లో నుండి: షెలోమోతు;</para>
  <para style="li2" vid="1CH 24:22">షెలోమోతు కుమారుల నుండి: యహతు.<verse eid="1CH 24:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 24:23"/>హెబ్రోను కుమారులు:</para>
  <para style="li2" vid="1CH 24:23">యెరీయా<note caller="+" style="f"><char style="fr" closed="false">24:23 </char><char style="ft" closed="false">చాలా హెబ్రీ ప్రతులలో, కొ. ప్రా. ప్ర.లలో </char><char style="fqa" closed="false">యెరీయా కుమారులు</char></note> మొదటివాడు, అమర్యా రెండవవాడు, యహజీయేలు మూడవవాడు, యెక్మెయాము నాలుగవవాడు.<verse eid="1CH 24:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 24:24"/>ఉజ్జీయేలు కుమారుడు: మీకా;</para>
  <para style="li2" vid="1CH 24:24">మీకా కుమారుల నుండి: షామీరు.<verse eid="1CH 24:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 24:25"/>మీకా సోదరుడు: ఇష్షీయా;</para>
  <para style="li2" vid="1CH 24:25">ఇష్షీయా కుమారుల నుండి: జెకర్యా.<verse eid="1CH 24:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 24:26"/>మెరారి కుమారులు: మహలి, మూషి.</para>
  <para style="li2" vid="1CH 24:26">యహజీయాహు కుమారుడు: బెనో.<verse eid="1CH 24:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 24:27"/>మెరారి కుమారులు:</para>
  <para style="li2" vid="1CH 24:27">యహజీయాహు నుండి: బెనో, షోహము, జక్కూరు, ఇబ్రీ.<verse eid="1CH 24:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 24:28"/>మహలికి నుండి: ఎలియాజరు, ఇతనికి కుమారులు లేరు.<verse eid="1CH 24:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 24:29"/>కీషు నుండి: కీషు కుమారుడు: యెరహ్మెయేలు.<verse eid="1CH 24:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 24:30"/>మూషి కుమారులు: మహలి, ఏదెరు, యెరీమోతు.</para>
  <para style="b" vid="1CH 24:30"/>
  <para style="lf" vid="1CH 24:30">వీరు తమ కుటుంబాల ప్రకారం లేవీయులు.<verse eid="1CH 24:30"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="31" style="v" sid="1CH 24:31"/>వీరు తమ బంధువులైన అహరోను వారసులు చేసినట్టు, రాజైన దావీదు, సాదోకు, అహీమెలెకు, యాజకులు లేవీయుల కుటుంబ పెద్దలు ఎదుట చీట్లు వేసుకున్నారు. పెద్ద సోదరుని కుటుంబాలు చిన్న సోదరుని కుటుంబాలు కలిసి చీట్లు వేసుకున్నారు.<verse eid="1CH 24:31"/></para>
  <chapter eid="1CH 24"/>
  <chapter number="25" style="c" sid="1CH 25"/>
  <para style="s1">సంగీతకారులు</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 25:1"/>దావీదు, తన సైన్యాధిపతులతో కలిసి ఆసాపు, హేమాను, యెదూతూను అనేవారి కుమారులలో కొందరిని సితారాలు, వీణలు, తాళాలు వాయిస్తూ ప్రవచించే పరిచర్య కోసం నియమించారు. ఈ సేవకు నియమించబడినవారి జాబితా ఇది:<verse eid="1CH 25:1"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 25:2"/>ఆసాపు కుమారుల నుండి:</para>
  <para style="li2" vid="1CH 25:2">జక్కూరు, యోసేపు, నెతన్యా, అషరేలా. వీరు రాజు పర్యవేక్షణలో ప్రవచిస్తూ, ఆసాపు పర్యవేక్షణలో ఉన్న ఆసాపు కుమారులు.<verse eid="1CH 25:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="1CH 25:3"/>యెదూతూను కుమారుల నుండి:</para>
  <para style="li2" vid="1CH 25:3">గెదల్యా, జెరీ, యెషయా, షిమ్యా, హషబ్యా, మత్తిత్యా, మొత్తం ఆరుగురు, వీరు స్తుతి పాటలు పాడుతూ యెహోవాను స్తుతించడానికి వీణ వాయిస్తూ ప్రవచించే తమ తండ్రియైన యెదూతూను పర్యవేక్షణలో ఉన్నవారు.<verse eid="1CH 25:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 25:4"/>హేమాను కుమారుల నుండి:</para>
  <para style="li2" vid="1CH 25:4">బక్కీయాహు, మత్తన్యా, ఉజ్జీయేలు, షెబూయేలు, యెరీమోతు; హనన్యా, హనానీ, ఎలీయాతా, గిద్దల్తీ, రోమమ్తీ-యెజెరు; యొష్బెకాషా, మల్లోతి, హోతీరు, మహజీయోతు. <verse eid="1CH 25:4"/><verse number="5" style="v" sid="1CH 25:5"/>(వీరంతా రాజుకు దీర్ఘదర్శిగా ఉన్న హేమాను కుమారులు. తన వాగ్దానాల ప్రకారం హేమానును గొప్ప చేయడానికి దేవుడు హేమానుకు పద్నాలుగు మంది కుమారులను, ముగ్గురు కుమార్తెలను ఇచ్చారు.)<verse eid="1CH 25:5"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="6" style="v" sid="1CH 25:6"/>వీరందరు తమ తండ్రుల పర్యవేక్షణలో ఉండి, యెహోవా మందిరంలో తాళాలు, వీణలు, సితారాలు వాయిస్తూ, పాటలు పాడుతూ దేవుని మందిరం దగ్గర సేవ చేసేవారు.</para>
  <para style="p" vid="1CH 25:6">ఆసాపు, యెదూతూను, హేమానులు రాజు పర్యవేక్షణలో ఉండేవారు. <verse eid="1CH 25:6"/><verse number="7" style="v" sid="1CH 25:7"/>యెహోవాకు పాటలు పాడడంలో నైపుణ్యం ఉన్న వీరి బంధువులందరితో కలిపి వీరి సంఖ్య 288. <verse eid="1CH 25:7"/><verse number="8" style="v" sid="1CH 25:8"/>చిన్నా, పెద్దా, గురువు శిష్యుడు అనే భేదం లేకుండా చీట్లు వేసి విధులు నిర్ణయించుకున్నారు.<verse eid="1CH 25:8"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 25:9"/>మొదటి చీటి ఆసాపు వంశంలో ఉన్న యోసేపు పేరిట వచ్చింది,</para>
  <para style="li2" vid="1CH 25:9">రెండవది గెదల్యా పేరిట వచ్చింది,</para>
  <para style="li2" vid="1CH 25:9">ఇతని కుమారులు బంధువులు<note caller="+" style="f"><char style="fr" closed="false">25:9 </char><char style="ft" closed="false">కొ.ప్ర.లలో </char><char style="fq" closed="false">ఇతని కుమారులు బంధువులు </char><char style="ft" closed="false">అని లేదు</char></note> పన్నెండుమంది.<verse eid="1CH 25:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 25:10"/>మూడవది జక్కూరు పేరిట వచ్చింది,</para>
  <para style="li2" vid="1CH 25:10">ఇతని కుమారులు బంధువులు పన్నెండుమంది.<verse eid="1CH 25:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 25:11"/>నాలుగవది యిజ్రీ<note caller="+" style="f"><char style="fr" closed="false">25:11 </char><char style="fqa" closed="false">జెరీ </char><char style="ft" closed="false">మరొక పేరు</char></note> పేరిట వచ్చింది,</para>
  <para style="li2" vid="1CH 25:11">ఇతని కుమారులు బంధువులు పన్నెండుమంది.<verse eid="1CH 25:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 25:12"/>అయిదవది నెతన్యా పేరిట వచ్చింది,</para>
  <para style="li2" vid="1CH 25:12">ఇతని కుమారులు బంధువులు పన్నెండుమంది.<verse eid="1CH 25:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 25:13"/>ఆరవది బక్కీయాహు పేరిట వచ్చింది,</para>
  <para style="li2" vid="1CH 25:13">ఇతని కుమారులు బంధువులు పన్నెండుమంది.<verse eid="1CH 25:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 25:14"/>ఏడవది యెషర్యేలా<note caller="+" style="f"><char style="fr" closed="false">25:14 </char><char style="fqa" closed="false">అషర్యేలా </char><char style="ft" closed="false">మరొక పేరు</char></note> పేరిట వచ్చింది,</para>
  <para style="li2" vid="1CH 25:14">ఇతని కుమారులు బంధువులు పన్నెండుమంది.<verse eid="1CH 25:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 25:15"/>ఎనిమిదవది యెషయా పేరిట వచ్చింది,</para>
  <para style="li2" vid="1CH 25:15">ఇతని కుమారులు బంధువులు పన్నెండుమంది.<verse eid="1CH 25:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 25:16"/>తొమ్మిదవది మత్తన్యా పేరిట వచ్చింది,</para>
  <para style="li2" vid="1CH 25:16">ఇతని కుమారులు బంధువులు పన్నెండుమంది.<verse eid="1CH 25:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 25:17"/>పదవది షిమీ పేరట వచ్చింది,</para>
  <para style="li2" vid="1CH 25:17">ఇతని కుమారులు బంధువులు పన్నెండుమంది.<verse eid="1CH 25:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 25:18"/>పదకొండవది అజరేలు<note caller="+" style="f"><char style="fr" closed="false">25:18 </char><char style="fqa" closed="false">ఉజ్జీయేలు </char><char style="fq" closed="false">అజరేలు </char><char style="ft" closed="false">యొక్క మరొక పేరు</char></note> పేరిట వచ్చింది,</para>
  <para style="li2" vid="1CH 25:18">ఇతని కుమారులు బంధువులు పన్నెండుమంది.<verse eid="1CH 25:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 25:19"/>పన్నెండవది హషబ్యా పేరిట వచ్చింది,</para>
  <para style="li2" vid="1CH 25:19">ఇతని కుమారులు బంధువులు పన్నెండుమంది.<verse eid="1CH 25:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 25:20"/>పదమూడవది షూబాయేలు పేరిట వచ్చింది,</para>
  <para style="li2" vid="1CH 25:20">ఇతని కుమారులు బంధువులు పన్నెండుమంది.<verse eid="1CH 25:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 25:21"/>పద్నాలుగవది మత్తిత్యా పేరిట వచ్చింది,</para>
  <para style="li2" vid="1CH 25:21">ఇతని కుమారులు బంధువులు పన్నెండుమంది.<verse eid="1CH 25:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 25:22"/>పదిహేనవది యెరేమోతు పేరిట వచ్చింది,</para>
  <para style="li2" vid="1CH 25:22">ఇతని కుమారులు బంధువులు పన్నెండుమంది.<verse eid="1CH 25:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="1CH 25:23"/>పదహారవది హనన్యా పేరిట వచ్చింది,</para>
  <para style="li2" vid="1CH 25:23">ఇతని కుమారులు బంధువులు పన్నెండుమంది.<verse eid="1CH 25:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="1CH 25:24"/>పదిహేడవది యొష్బెకాషా పేరిట వచ్చింది,</para>
  <para style="li2" vid="1CH 25:24">ఇతని కుమారులు బంధువులు పన్నెండుమంది.<verse eid="1CH 25:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 25:25"/>పద్దెనిమిదవది హనానీ పేరిట వచ్చింది,</para>
  <para style="li2" vid="1CH 25:25">ఇతని కుమారులు బంధువులు పన్నెండుమంది.<verse eid="1CH 25:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 25:26"/>పందొమ్మిదవది మల్లోతి పేరిట వచ్చింది,</para>
  <para style="li2" vid="1CH 25:26">ఇతని కుమారులు బంధువులు పన్నెండుమంది.<verse eid="1CH 25:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 25:27"/>ఇరవయ్యవది ఎలీయాతా పేరిట వచ్చింది,</para>
  <para style="li2" vid="1CH 25:27">ఇతని కుమారులు బంధువులు పన్నెండుమంది.<verse eid="1CH 25:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 25:28"/>ఇరవై ఒకటవది హోతీరు పేరిట వచ్చింది,</para>
  <para style="li2" vid="1CH 25:28">ఇతని కుమారులు బంధువులు పన్నెండుమంది.<verse eid="1CH 25:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 25:29"/>ఇరవై రెండవది గిద్దల్తీ పేరిట వచ్చింది,</para>
  <para style="li2" vid="1CH 25:29">ఇతని కుమారులు బంధువులు పన్నెండుమంది.<verse eid="1CH 25:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 25:30"/>ఇరవై మూడవది మహజీయోతు పేరిట వచ్చింది,</para>
  <para style="li2" vid="1CH 25:30">ఇతని కుమారులు బంధువులు పన్నెండుమంది.<verse eid="1CH 25:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 25:31"/>ఇరవై నాలుగవది రోమమ్తీ-యెజెరు పేరిట వచ్చింది,</para>
  <para style="li2" vid="1CH 25:31">ఇతని కుమారులు బంధువులు పన్నెండుమంది.<verse eid="1CH 25:31"/></para>
  <chapter eid="1CH 25"/>
  <chapter number="26" style="c" sid="1CH 26"/>
  <para style="s1">ద్వారపాలకులు</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 26:1"/>ద్వారపాలకుల విభాగాలు:</para>
  <para style="b" vid="1CH 26:1"/>
  <para style="lh" vid="1CH 26:1">కోరహీయుల నుండి:</para>
  <para style="li1" vid="1CH 26:1">ఆసాపు కుమారులలో ఒక్కడైన కోరే కుమారుడైన మెషెలెమ్యా. <verse eid="1CH 26:1"/><verse number="2" style="v" sid="1CH 26:2"/>మెషెలెమ్యాకు కుమారులు ఉన్నారు:</para>
  <para style="li2" vid="1CH 26:2">జెకర్యా మొదటివాడు, యెదీయవేలు రెండవవాడు,</para>
  <para style="li2" vid="1CH 26:2">జెబద్యా మూడవవాడు, యత్నీయేలు నాలుగవవాడు,<verse eid="1CH 26:2"/></para>
  <para style="li2">
    <verse number="3" style="v" sid="1CH 26:3"/>ఏలాము అయిదవవాడు, యెహోహనాను ఆరవవాడు,</para>
  <para style="li2" vid="1CH 26:3">ఎల్యోయేనై ఏడవవాడు.<verse eid="1CH 26:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 26:4"/>ఓబేద్-ఎదోముకు కూడా కుమారులు ఉన్నారు:</para>
  <para style="li2" vid="1CH 26:4">షెమయా మొదటివాడు, యెహోజాబాదు రెండవవాడు,</para>
  <para style="li2" vid="1CH 26:4">యోవాహు మూడవవాడు, శాకారు నాలుగవవాడు,</para>
  <para style="li2" vid="1CH 26:4">నెతనేలు అయిదవవాడు, <verse eid="1CH 26:4"/><verse number="5" style="v" sid="1CH 26:5"/>అమ్మీయేలు ఆరవవాడు,</para>
  <para style="li2" vid="1CH 26:5">ఇశ్శాఖారు ఏడవవాడు, పెయుల్లెతై ఎనిమిదవ వాడు.</para>
  <para style="li2" vid="1CH 26:5">(దేవుడు ఓబేద్-ఎదోమును ఆశీర్వదించారు.)<verse eid="1CH 26:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="1CH 26:6"/>ఓబేద్-ఎదోము కుమారుడైన షెమయాకు కూడా కుమారులు ఉన్నారు, వారు చాలా సమర్థులు కాబట్టి తమ తండ్రి కుటుంబంలో నాయకులుగా ఉన్నారు. <verse eid="1CH 26:6"/><verse number="7" style="v" sid="1CH 26:7"/>షెమయా కుమారులు:</para>
  <para style="li2" vid="1CH 26:7">ఒత్ని, రెఫాయేలు, ఓబేదు, ఎల్జాబాదు;</para>
  <para style="li2" vid="1CH 26:7">అతని బంధువులు ఎలీహు, సెమక్యాలు కూడా బలవంతులు.<verse eid="1CH 26:7"/></para>
  <para style="lf">
    <verse number="8" style="v" sid="1CH 26:8"/>వీరందరు ఓబేద్-ఎదోము వారసులు; వారు వారి కుమారులు వారి బంధువుల్లో పని చేయగల బలసామర్థ్యం గలవారు మొత్తం 62 మంది.<verse eid="1CH 26:8"/></para>
  <para style="lf">
    <verse number="9" style="v" sid="1CH 26:9"/>మెషెలెమ్యాకు కుమారులు, బంధువులు ఉన్నారు, వారిలో మొత్తం 18 మంది సమర్థులు.<verse eid="1CH 26:9"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 26:10"/>మెరారీయుడైన హోసాకు కుమారులు ఉన్నారు:</para>
  <para style="li2" vid="1CH 26:10">షిమ్రీ మొదటివాడు (అతడు మొదట పుట్టినవాడు కాకపోయినా, అతని తండ్రి అతన్ని మొదటివానిగా నియమించాడు),<verse eid="1CH 26:10"/></para>
  <para style="li2">
    <verse number="11" style="v" sid="1CH 26:11"/>హిల్కీయా రెండవవాడు, టెబల్యాహు మూడవవాడు,</para>
  <para style="li2" vid="1CH 26:11">జెకర్యా నాలుగవవాడు,</para>
  <para style="lf" vid="1CH 26:11">హోసా కుమారులు బంధువులు మొత్తం 13 మంది.<verse eid="1CH 26:11"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="12" style="v" sid="1CH 26:12"/>వారి నాయకులకు అనుగుణంగా, ఇలా ఏర్పాటైన ద్వారపాలకుల విభాగాలకు తమ బంధువులు చేసినట్లే యెహోవా మందిరంలో సేవ చేయడానికి బాధ్యతలు అప్పగించారు. <verse eid="1CH 26:12"/><verse number="13" style="v" sid="1CH 26:13"/>చిన్నవారికి పెద్దవారికి ఒకే విధంగా తమ కుటుంబాల ప్రకారం, ప్రతి ఒక్క ద్వారం దగ్గర కావలివారిగా ఉండడానికి చీట్లు వేశారు.<verse eid="1CH 26:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 26:14"/>తూర్పు వైపు ద్వారం షెలెమ్యాకు<note caller="+" style="f"><char style="fr" closed="false">26:14 </char><char style="fqa" closed="false">మెషెలెమ్యా </char><char style="ft" closed="false">మరొక రూపం</char></note> వచ్చింది.</para>
  <para style="li1" vid="1CH 26:14">తర్వాత తెలివిగల సలహాదారుడైన అతని కుమారుడైన జెకర్యాకు కూడా చీటి వేయగా అతనికి ఉత్తరం వైపు ద్వారం వచ్చింది.<verse eid="1CH 26:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 26:15"/>ఓబేద్-ఎదోముకు దక్షిణం వైపు ద్వారం వచ్చింది, గిడ్డంగుల కాపలా అతని కుమారులకు వచ్చింది.<verse eid="1CH 26:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="1CH 26:16"/>పడమటి వైపు ద్వారం, ఎత్తైన రహదారిలో ఉన్న షల్లెకెతు ద్వారం కాపలా షుప్పీముకు, హోసాకు వచ్చింది.</para>
  <para style="b" vid="1CH 26:16"/>
  <para style="lh" vid="1CH 26:16">వీరంతా ఒకరి ప్రక్కన ఒకరు ఉండి కాపలా కాసేవారు:<verse eid="1CH 26:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 26:17"/>ప్రతిరోజు తూర్పున ఆరుగురు లేవీయులు,</para>
  <para style="li1" vid="1CH 26:17">ఉత్తరాన నలుగురు,</para>
  <para style="li1" vid="1CH 26:17">దక్షిణాన నలుగురు,</para>
  <para style="li1" vid="1CH 26:17">గిడ్డంగి దగ్గర ఇద్దరిద్దరు ఉన్నారు.<verse eid="1CH 26:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 26:18"/>పడమటి ఆవరణం విషయానికి వస్తే, దగ్గర ఉన్న రాజమార్గం దగ్గర నలుగురు, ఆవరణం దగ్గర ఇద్దరు ఉన్నారు.<verse eid="1CH 26:18"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="19" style="v" sid="1CH 26:19"/>కోరహు, మెరారి వారసులైన ద్వారపాలకుల విభాగాలు ఇవి.<verse eid="1CH 26:19"/></para>
  <para style="s1">కోశాధికారులు ఇతర అధికారులు</para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 26:20"/>అహీయా నాయకత్వంలో నడిపించబడిన ఇతర లేవీయులు, దేవుని మందిరంలోని ఖజానాలకు యెహోవాకు సమర్పించబడిన కానుకల ఖజానాలకు బాధ్యత వహించారు.<verse eid="1CH 26:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 26:21"/>గెర్షోనీయుడైన లద్దానుకు చెందిన కుటుంబాల పెద్దలైన గెర్షోనీయుడైన లద్దాను వారసులు యెహీయేలీ, <verse eid="1CH 26:21"/><verse number="22" style="v" sid="1CH 26:22"/>యెహీయేలీ కుమారులు, జేతాము అతని సోదరుడైన యోవేలు. వీరికి యెహోవా ఆలయ ఖజానాల బాధ్యత అప్పగించబడింది.<verse eid="1CH 26:22"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="23" style="v" sid="1CH 26:23"/>అమ్రామీయులు, ఇస్హారీయులు, హెబ్రోనీయులు, ఉజ్జీయేలీయులు అనేవారి నుండి:<verse eid="1CH 26:23"/></para>
  <para style="b"/>
  <para style="li2">
    <verse number="24" style="v" sid="1CH 26:24"/>మోషే కుమారుడైన గెర్షోము వారసుడు షెబూయేలు ఖజానా మీద ప్రధానిగా నియమించబడ్డాడు. <verse eid="1CH 26:24"/><verse number="25" style="v" sid="1CH 26:25"/>ఎలీయెజెరు ద్వారా అతని బంధువులు: ఎలీయెజెరు కుమారుడైన రెహబ్యా, అతని కుమారుడైన యెషయా, అతని కుమారుడైన యోరాము, అతని కుమారుడైన జిఖ్రీ, అతని కుమారుడైన షెలోమీతు.<verse eid="1CH 26:25"/></para>
  <para style="li2">
    <verse number="26" style="v" sid="1CH 26:26"/>(రాజైన దావీదు, సహస్రాధిపతులు, శతాధిపతులు యైన కుటుంబ పెద్దలు ఇతర సైన్యాధిపతులు ప్రతిష్ఠించిన వస్తువులున్న ఖజానాలన్నిటి బాధ్యత షెలోమీతుకు, అతని బంధువులకు అప్పగించబడింది. <verse eid="1CH 26:26"/><verse number="27" style="v" sid="1CH 26:27"/>వారు యుద్ధంలో స్వాధీనం చేసుకున్న సొమ్ములో కొంత భాగాన్ని యెహోవా ఆలయ మరమత్తు కోసం ప్రతిష్ఠించారు. <verse eid="1CH 26:27"/><verse number="28" style="v" sid="1CH 26:28"/>దీర్ఘదర్శి సమూయేలు, కీషు కుమారుడైన సౌలు, నేరు కుమారుడైన అబ్నేరు, సెరూయా కుమారుడైన యోవాబు ప్రతిష్ఠించినవన్నీ, ఇతర ప్రతిష్ఠితమైన వస్తువులన్నీ షెలోమీతు అతని బంధువుల సంరక్షణలో ఉన్నాయి.)<verse eid="1CH 26:28"/></para>
  <para style="li2">
    <verse number="29" style="v" sid="1CH 26:29"/>ఇస్హారీయుల నుండి:</para>
  <para style="li2" vid="1CH 26:29">కెనన్యా అతని కుమారులు మందిరపు బయటి పనులు చేయడానికి ఇశ్రాయేలీయులకు అధికారులుగా, న్యాయాధిపతులుగా నియమించబడ్డారు.<verse eid="1CH 26:29"/></para>
  <para style="li2">
    <verse number="30" style="v" sid="1CH 26:30"/>హెబ్రోనీయుల నుండి:</para>
  <para style="li2" vid="1CH 26:30">హషబ్యా, అతని బంధువులు పదిహేడు వందల మంది సమర్థులైన వారికి యొర్దాను నదికి పడమర వైపున ఉన్న ఇశ్రాయేలు ప్రాంతంలో యెహోవాకు చేసే మొత్తం సేవ రాజుకు చేసే సేవ బాధ్యత అప్పగించబడింది. <verse eid="1CH 26:30"/><verse number="31" style="v" sid="1CH 26:31"/>హెబ్రోనీయులలో వారి కుటుంబ వంశావళుల ప్రకారం, యెరీయా వారికి ప్రధాన నాయకుడు.</para>
  <para style="li2" vid="1CH 26:31">(దావీదు పరిపాలనలోని నలభైయవ సంవత్సరంలో వంశావళులను పరిశీలించినప్పుడు, గిలాదులోని యాజెరులో ఉన్న హెబ్రోనీయులలో పరాక్రమశాలులు ఉన్నారని తెలిసింది. <verse eid="1CH 26:31"/><verse number="32" style="v" sid="1CH 26:32"/>కుటుంబ పెద్దలుగా ఉన్న సమర్థులైన యెరీయా బంధువులు రెండువేల ఏడువందలమంది. రాజైన దావీదు వారిని దేవుని విషయాలన్నిటిలో, రాజ వ్యవహారాలలో రూబేనీయులమీద, గాదీయులమీద, మనష్షే అర్థగోత్రం వారిమీద నియమించాడు.)<verse eid="1CH 26:32"/></para>
  <chapter eid="1CH 26"/>
  <chapter number="27" style="c" sid="1CH 27"/>
  <para style="s1">సైన్య విభాగాలు</para>
  <para style="lh">
    <verse number="1" style="v" sid="1CH 27:1"/>ఇది ఇశ్రాయేలీయుల కుటుంబ నాయకులు, సహస్రాధిపతులు, శతాధిపతులు, వివిధ విషయాల్లో రాజుకు సేవలందించే అధికారుల జాబితా. వీరిలో ప్రతి విభాగం సంవత్సరంలో ఒక నెల చొప్పున సేవ చేస్తారు. ఒక్కొక్క విభాగంలో 24,000 మంది సైనికులు ఉన్నారు.<verse eid="1CH 27:1"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="2" style="v" sid="1CH 27:2"/>మొదటి నెలలో మొదటి విభాగం మీద జబ్దీయేలు కుమారుడైన యషోబీము అధిపతిగా ఉన్నాడు. అతని విభాగంలో 24,000 మంది సైనికులు ఉన్నారు. <verse eid="1CH 27:2"/><verse number="3" style="v" sid="1CH 27:3"/>అతడు పెరెసు వారసుడు, మొదటి నెల సైన్యాధిపతులందరికీ అధిపతిగా ఉన్నాడు.<verse eid="1CH 27:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="1CH 27:4"/>రెండవ నెల విభాగం మీద అహోహీయుడైన దోదైది అధిపతిగా ఉన్నాడు; అతని విభాగానికి నాయకుడు మిక్లోతు. అతని విభాగంలో 24,000 మంది సైనికులు ఉన్నారు.<verse eid="1CH 27:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="1CH 27:5"/>మూడవ నెలకు యాజకుడైన యెహోయాదా కుమారుడైన బెనాయా మూడవ సైన్యాధిపతిగా ఉన్నాడు. అతని విభాగంలో 24,000 మంది సైనికులు ఉన్నారు. <verse eid="1CH 27:5"/><verse number="6" style="v" sid="1CH 27:6"/>ఈ బెనాయా పరాక్రమశాలి, ముప్పైమంది వీరులలో ఒకనిగా, ఆ ముప్పైమందికి అధిపతిగా ఉన్నాడు. అతని కుమారుడైన అమ్మీజాబాదు అతని విభాగంలో అధిపతిగా ఉన్నాడు.<verse eid="1CH 27:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="1CH 27:7"/>నాలుగవ నెలకు యోవాబు సోదరుడైన అశాహేలు నాలుగో విభాగం మీద అధిపతిగా ఉన్నాడు; అతని తర్వాత, అతని కుమారుడైన జెబద్యా అధిపతి అయ్యాడు. అతని విభాగంలో 24,000 మంది సైనికులు ఉన్నారు.<verse eid="1CH 27:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="1CH 27:8"/>అయిదవ నెలకు ఇశ్రాహేతీయుడైన షంహూతు అయిదవ విభాగం మీద అధిపతిగా ఉన్నాడు. అతని విభాగంలో 24,000 మంది సైనికులు ఉన్నారు.<verse eid="1CH 27:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="1CH 27:9"/>ఆరవ నెలకు తెకోవీయుడైన ఇక్కేషు కుమారుడైన ఈరా, ఆరవ విభాగం మీద అధిపతిగా ఉన్నాడు. అతని విభాగంలో 24,000 మంది సైనికులు ఉన్నారు.<verse eid="1CH 27:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="1CH 27:10"/>ఏడవ నెలకు ఎఫ్రాయిమీయుడు పెలోనీయుడైన హేలెస్సు ఏడవ విభాగం మీద అధిపతిగా ఉన్నాడు. అతని విభాగంలో 24,000 మంది సైనికులు ఉన్నారు.<verse eid="1CH 27:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="1CH 27:11"/>ఎనిమిదవ నెలకు జెరహీయుల బంధువైన హుషాతీయుడైన సిబ్బెకై ఎనిమిదవ విభాగం మీద అధిపతిగా ఉన్నాడు. అతని విభాగంలో 24,000 మంది సైనికులు ఉన్నారు.<verse eid="1CH 27:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="1CH 27:12"/>తొమ్మిదవ నెలకు బెన్యామీనీయుడు అనాతోతీయుడైన అబీయెజెరు తొమ్మిదవ విభాగం మీద అధిపతిగా ఉన్నాడు. అతని విభాగంలో 24,000 మంది సైనికులు ఉన్నారు.<verse eid="1CH 27:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="1CH 27:13"/>పదవ నెలకు జెరహీయుడు, నెటోపాతీయుడైన మహరై పదవ విభాగం మీద అధిపతిగా ఉన్నాడు. అతని విభాగంలో 24,000 మంది సైనికులు ఉన్నారు.<verse eid="1CH 27:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="1CH 27:14"/>పదకొండవ నెలకు ఎఫ్రాయిమీయుడు పిరాతోనీయుడునైన బెనాయా పదకొండవ విభాగం మీద అధిపతిగా ఉన్నాడు. అతని విభాగంలో 24,000 మంది సైనికులు ఉన్నారు.<verse eid="1CH 27:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="1CH 27:15"/>పన్నెండవ నెలకు నెటోపాతీయుడునైన ఒత్నీయేలు వంశస్థుడైన హెల్దయి పన్నెండవ విభాగం మీద అధిపతిగా ఉన్నాడు. అతని విభాగంలో 24,000 మంది సైనికులు ఉన్నారు.<verse eid="1CH 27:15"/></para>
  <para style="s1">గోత్రాల నాయకులు</para>
  <para style="lh">
    <verse number="16" style="v" sid="1CH 27:16"/>ఇశ్రాయేలీయుల గోత్రాల నాయకులు:</para>
  <para style="b" vid="1CH 27:16"/>
  <para style="li1" vid="1CH 27:16">రూబేనీయులమీద: జిఖ్రీ కుమారుడైన ఎలీయెజెరు;</para>
  <para style="li1" vid="1CH 27:16">షిమ్యోనీయుల మీద: మయకా కుమారుడైన షెఫట్యా;<verse eid="1CH 27:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="1CH 27:17"/>లేవీయుల మీద: కెమూయేలు కుమారుడైన హషబ్యా;</para>
  <para style="li1" vid="1CH 27:17">అహరోనీయుల మీద: సాదోకు;<verse eid="1CH 27:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="1CH 27:18"/>యూదా వారి మీద: దావీదు సోదరుడైన ఎలీహు;</para>
  <para style="li1" vid="1CH 27:18">ఇశ్శాఖారీయుల మీద: మిఖాయేలు కుమారుడైన ఒమ్రీ;<verse eid="1CH 27:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="1CH 27:19"/>జెబూలూనీయుల మీద: ఓబద్యా కుమారుడైన ఇష్మయా;</para>
  <para style="li1" vid="1CH 27:19">నఫ్తాలీయుల మీద: అజ్రీయేలు కుమారుడైన యెరీమోతు;<verse eid="1CH 27:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="1CH 27:20"/>ఎఫ్రాయిమీయుల మీద: అజజ్యాహు కుమారుడైన హోషేయ;</para>
  <para style="li1" vid="1CH 27:20">మనష్షే అర్థగోత్రం మీద: పెదాయా కుమారుడైన యోవేలు;<verse eid="1CH 27:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="1CH 27:21"/>గిలాదులోని మనష్షే అర్థగోత్రం మీద: జెకర్యా కుమారుడైన ఇద్దో;</para>
  <para style="li1" vid="1CH 27:21">బెన్యామీనీయుల మీద: అబ్నేరు కుమారుడైన యయశీయేలు;<verse eid="1CH 27:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="1CH 27:22"/>దానీయుల మీద: యెరోహాము కుమారుడైన అజరేలు.</para>
  <para style="b" vid="1CH 27:22"/>
  <para style="lf" vid="1CH 27:22">వీరు ఇశ్రాయేలు గోత్రాలకు నాయకులు.<verse eid="1CH 27:22"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="23" style="v" sid="1CH 27:23"/>ఇశ్రాయేలును ఆకాశ నక్షత్రాలంత విస్తారంగా చేస్తానని యెహోవా వాగ్దానం చేశారు, కాబట్టి ఇరవై సంవత్సరాలు, అంతకన్నా తక్కువ వయస్సున్న వారిని దావీదు లెక్కించలేదు. <verse eid="1CH 27:23"/><verse number="24" style="v" sid="1CH 27:24"/>సెరూయా కుమారుడైన యోవాబు జనాభా లెక్కలు వ్రాయడానికి ఆరంభించాడు కాని దానిని ముగించలేదు. జనాభా లెక్కలు వ్రాయడం వలన ఇశ్రాయేలు మీదికి దేవుని ఉగ్రత వచ్చింది కాబట్టి ఆ జనసంఖ్య రాజైన దావీదు చరిత్ర గ్రంథంలో నమోదు కాలేదు.<verse eid="1CH 27:24"/></para>
  <para style="s1">రాజు పర్యవేక్షకులు</para>
  <para style="li1">
    <verse number="25" style="v" sid="1CH 27:25"/>రాజ్య గిడ్డంగులకు అదీయేలు కుమారుడైన అజ్మావెతు అధికారి.</para>
  <para style="li1" vid="1CH 27:25">పల్లెప్రాంతాలలో, పట్టణాల్లో గ్రామాల్లో కోటలలో ఉన్న గిడ్డంగులకు ఉజ్జియా కుమారుడైన యోనాతాను అధికారి.<verse eid="1CH 27:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="1CH 27:26"/>పొలాల్లో పని చేసేవారిమీద, భూమి దున్నే వారి మీద కెలూబు కుమారుడైన ఎజ్రీ అధికారి.<verse eid="1CH 27:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="1CH 27:27"/>ద్రాక్షతోటల మీద రామతీయుడైన షిమీ అధికారి.</para>
  <para style="li1" vid="1CH 27:27">ద్రాక్షతోటల నుండి ఉత్పత్తి అయ్యే ద్రాక్షరసాన్ని నిల్వజేసే తొట్టెల మీద షిప్మీయుడైన జబ్ది అధికారి.<verse eid="1CH 27:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="1CH 27:28"/>పశ్చిమ దిగువ ప్రాంతంలో<note caller="+" style="f"><char style="fr" closed="false">27:28 </char><char style="ft" closed="false">హెబ్రీలో </char><char style="fqa" closed="false">షెఫేలా</char></note> ఉన్న ఒలీవచెట్లు, మేడిచెట్ల మీద గెదేరీయుడైన బయల్-హనాను అధికారి.</para>
  <para style="li1" vid="1CH 27:28">ఒలీవనూనె గిడ్డంగులకు యోవాషు అధికారి.<verse eid="1CH 27:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="1CH 27:29"/>షారోనులో మేసే పశువులమీద షారోనీయుడైన షిట్రయి అధికారి.</para>
  <para style="li1" vid="1CH 27:29">లోయలలోని పశువులమీద అద్లయి కుమారుడైన షాపాతు అధికారి.<verse eid="1CH 27:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="1CH 27:30"/>ఒంటెల మీద ఇష్మాయేలీయుడైన ఓబీలు అధికారి.</para>
  <para style="li1" vid="1CH 27:30">గాడిదల మీద మేరోనోతీయుడైన యెహెద్యాహు అధికారి.<verse eid="1CH 27:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="1CH 27:31"/>మందల మీద హగ్రీయుడైన యాజీజు అధికారి.</para>
  <para style="lf" vid="1CH 27:31">వీరందరు రాజైన దావీదు ఆస్తి మీద నియమించబడిన అధికారులు.<verse eid="1CH 27:31"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="32" style="v" sid="1CH 27:32"/>దావీదు పినతండ్రియైన యోనాతాను సలహాదారుడు, వివేకం ఉన్నవాడు, లేఖికుడు.</para>
  <para style="li1" vid="1CH 27:32">హక్మోనీ కుమారుడైన యెహీయేలు రాజకుమారుల సంరక్షకుడు.<verse eid="1CH 27:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="1CH 27:33"/>అహీతోపెలు రాజు యొక్క సలహాదారుడు.</para>
  <para style="li1" vid="1CH 27:33">అర్కీయుడైన హూషై రాజుకు సన్నిహితుడైన మిత్రుడు.<verse eid="1CH 27:33"/></para>
  <para style="lf">
    <verse number="34" style="v" sid="1CH 27:34"/>అహీతోపెలు తర్వాత బెనాయా కుమారుడైన యెహోయాదా, అబ్యాతారులు అతని స్థానంలో సలహాదారులయ్యారు.</para>
  <para style="li1" vid="1CH 27:34">రాజ్య సైన్యానికి యోవాబు అధిపతి.<verse eid="1CH 27:34"/></para>
  <chapter eid="1CH 27"/>
  <chapter number="28" style="c" sid="1CH 28"/>
  <para style="s1">దేవాలయాన్ని గురించి దావీదు ఏర్పాట్లు</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 28:1"/>దావీదు ఇశ్రాయేలీయుల అధికారులందరిని అనగా, గోత్రాల అధికారులను, రాజు సేవలో ఉన్న సైన్యాల విభాగాల అధిపతులను, సహస్రాధిపతులను, శతాధిపతులను, రాజుకు రాజకుమారులకు ఉన్న ఆస్తి మీద, పశువులన్నిటి మీద ఉన్న అధికారులను, రాజపరివారాన్ని, పరాక్రమశాలులను, యుద్ధ వీరులందరిని యెరూషలేములో సమావేశపరిచాడు.<verse eid="1CH 28:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="1CH 28:2"/>రాజైన దావీదు లేచి నిలబడి ఇలా అన్నాడు: “నా తోటి ఇశ్రాయేలీయులారా, నా ప్రజలారా, వినండి. మన దేవునికి పాదపీఠంగా యెహోవా నిబంధన మందసాన్ని ఉంచే మందిరాన్ని నేను నిర్మించాలని నా హృదయంలో అనుకున్నాను, దాన్ని కట్టడానికి సన్నాహాలు చేశాను. <verse eid="1CH 28:2"/><verse number="3" style="v" sid="1CH 28:3"/>అయితే దేవుడు నాతో, ‘నీవు యుద్ధాలు చేసి రక్తం చిందించావు కాబట్టి, నీవు నా పేరిట మందిరాన్ని కట్టించకూడదు’ అని చెప్పారు.<verse eid="1CH 28:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CH 28:4"/>“అయినా, ఇశ్రాయేలీయుల మీద ఎప్పుడు రాజుగా ఉండడానికి ఇశ్రాయేలీయుల దేవుడైన యెహోవా నన్ను, నా కుటుంబమంతటి నుండి ఎన్నుకున్నారు. ఆయన యూదా గోత్రాన్ని, యూదా గోత్రంలో నా తండ్రి కుటుంబాన్ని ఎన్నుకుని, నా తండ్రి కుమారులలో నుండి నన్ను ఇశ్రాయేలు అంతటి మీద రాజుగా చేయడానికి ఇష్టపడ్డారు. <verse eid="1CH 28:4"/><verse number="5" style="v" sid="1CH 28:5"/>యెహోవా నాకు అనేక కుమారులను ఇచ్చారు. వారందరి నుండి, ఇశ్రాయేలీయులపై యెహోవా రాజ్యసింహాసనం మీద కూర్చోడానికి ఆయన నా కుమారుడైన సొలొమోనును ఎన్నుకున్నారు. <verse eid="1CH 28:5"/><verse number="6" style="v" sid="1CH 28:6"/>ఆయన నాతో ఇలా అన్నారు: ‘నేను నీ కుమారుడైన సొలొమోనును నాకు కుమారునిగా ఎన్నుకున్నాను, నేను అతనికి తండ్రిగా ఉంటాను కాబట్టి అతడు నా మందిరాన్ని, ఆవరణాలను కట్టిస్తాడు. <verse eid="1CH 28:6"/><verse number="7" style="v" sid="1CH 28:7"/>ఈ రోజుల్లో జరుగుతున్నట్లుగానే, అతడు నా ఆజ్ఞలను న్యాయాన్ని స్థిరంగా అనుసరిస్తే, నేనతని రాజ్యాన్ని శాశ్వతంగా స్థిరపరుస్తాను.’<verse eid="1CH 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CH 28:8"/>“కాబట్టి ఇప్పుడు యెహోవా సమాజంగా చేరిన ఇశ్రాయేలీయులందరు చూస్తుండగా, మన దేవుడు వింటుండగా, నేను మీకు చెప్పేది ఏంటంటే, మీరు ఈ మంచి దేశాన్ని స్వాధీనపరచుకుని, మీ తర్వాత మీ వారసులకు దానిని శాశ్వతమైన వారసత్వంగా అందించేలా మీ దేవుడైన యెహోవా ఇచ్చిన ఆజ్ఞలన్నిటిని జాగ్రత్తగా పాటించండి.<verse eid="1CH 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CH 28:9"/>“సొలొమోనూ, నా కుమారుడా! నీ తండ్రి యొక్క దేవుడైన యెహోవా అందరి హృదయాలను పరిశోధిస్తారు, ఆలోచనల ఉద్దేశాలన్నిటిని గ్రహిస్తారు కాబట్టి నీవు ఆయనను తెలుసుకుని పూర్ణహృదయంతో చిత్తశుద్ధితో ఆయనను సేవించు. నీవు ఆయనను వెదికితే, ఆయన నీకు దొరుకుతారు; అయితే నీవు ఆయనను విడిచిపెడితే, ఆయన నిన్ను శాశ్వతంగా తిరస్కరిస్తారు. <verse eid="1CH 28:9"/><verse number="10" style="v" sid="1CH 28:10"/>పరిశుద్ధాలయంగా ఉండేలా ఒక ఇల్లు కట్టడానికి యెహోవా నిన్ను ఎన్నుకున్నారు అనే సంగతిని గ్రహించి ధైర్యంగా ఉండి పని చేయి.”<verse eid="1CH 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CH 28:11"/>అప్పుడు దావీదు తన కుమారుడైన సొలొమోనుకు, దేవాలయ మంటపము, దాని భవనాలకు, గిడ్డంగులకు, దాని పైభాగానికి, దాని లోపలి గదులకు, ప్రాయశ్చిత్త స్థలానికి సంబంధించిన నమూనాలు ఇచ్చాడు. <verse eid="1CH 28:11"/><verse number="12" style="v" sid="1CH 28:12"/>దేవుని ఆత్మ దావీదు హృదయంలో పెట్టిన నమూనాలను అతడు సొలొమోనుకు ఇచ్చాడు. యెహోవా మందిర ఆవరణాలకు, చుట్టూ ఉండే గదులకు, దేవుని ఆలయ ఖజానాలకు, సమర్పించబడిన వస్తువుల ఖజానాలకు నమూనాలు అతడు ఇచ్చాడు. <verse eid="1CH 28:12"/><verse number="13" style="v" sid="1CH 28:13"/>యాజకుల లేవీయుల విభాగాల గురించి, యెహోవా మందిరంలో జరగాల్సిన సేవలన్నిటి గురించి, అలాగే దాని సేవలో ఉపయోగించబడే పాత్రల గురించి కూడా దావీదు అతనికి నియమాలు తెలియజేశాడు. <verse eid="1CH 28:13"/><verse number="14" style="v" sid="1CH 28:14"/>వివిధ సేవలలో ఉపయోగించబడే బంగారు ఉపకరణాలను చేయడానికి కావలసినంత బంగారాన్ని, వివిధ సేవలలో ఉపయోగించబడే వెండి ఉపకరణాలను చేయడానికి కావలసినంత వెండిని దావీదు అతనికి అప్పగించాడు. <verse eid="1CH 28:14"/><verse number="15" style="v" sid="1CH 28:15"/>బంగారు దీపస్తంభాలకు వాటి దీపాలకు ఒక్కొక్క దీపస్తంభానికి దీపాలకు కావలసిన బరువు ప్రకారం బంగారాన్ని, వెండి దీపస్తంభాలకు వాటి దీపాలకు ఒక్కొక్క దీపస్తంభానికి దీపాలకు కావలసిన బరువు ప్రకారం వెండిని; <verse eid="1CH 28:15"/><verse number="16" style="v" sid="1CH 28:16"/>దేవుని సన్నిధిలో రొట్టెలుంచే ఒక్కొక్క బంగారు బల్లకు కావలసిన బంగారాన్ని; వెండి బల్లలకు కావలసిన వెండిని; <verse eid="1CH 28:16"/><verse number="17" style="v" sid="1CH 28:17"/>కొంకులు, గిన్నెలు, పాత్రలకు కావలసిన మేలిమి బంగారాన్ని; ఒక్కొక్క బంగారు పాత్రకు కావలసిన బరువు ప్రకారం బంగారాన్ని; ఒక్కొక్క వెండి పాత్రకు కావలసిన బరువు ప్రకారం వెండిని; <verse eid="1CH 28:17"/><verse number="18" style="v" sid="1CH 28:18"/>ధూపవేదికకు కావలసిన స్వచ్ఛమైన బంగారాన్ని దావీదు అతనికి ఇచ్చాడు. తమ రెక్కలు విప్పి యెహోవా నిబంధన మందసాన్ని కప్పివుంచే బంగారు కెరూబుల రథం యొక్క నమూనాను కూడా దావీదు అతనికిచ్చాడు.<verse eid="1CH 28:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CH 28:19"/>అప్పుడు దావీదు, “ఇదంతా యెహోవా తన చేతిని నా మీద ఉంచడం వలన నేను వీటన్నిటిని వ్రాశాను, ఈ నమూనా వివరాలన్ని నేను గ్రహించగలిగేలా ఆయన చేశారు” అని చెప్పాడు.<verse eid="1CH 28:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 28:20"/>దావీదు తన కుమారుడైన సొలొమోనుతో ఇంకా మాట్లాడుతూ ఇలా చెప్పాడు, “దృఢంగా, ధైర్యంగా ఉంటూ పని చేయి. నా దేవుడైన యెహోవా నీతో కూడా ఉంటారు కాబట్టి భయపడకు దిగులుపడకు. యెహోవా ఆలయ సేవకు సంబంధించిన పనులన్నీ ముగిసేవరకు ఆయన నిన్ను ఏమాత్రం విడిచిపెట్టరు. <verse eid="1CH 28:20"/><verse number="21" style="v" sid="1CH 28:21"/>దేవుని ఆలయ సేవ అంతటి కోసం యాజకులు, లేవీయుల విభాగాల ప్రకారం ఏర్పాటయ్యారు. ఈ పనులన్నీ చేయడానికి రకరకాల పనులలో నైపుణ్యం గలవారు మనస్పూర్తిగా నీకు సహాయం చేస్తారు. అధిపతులు, ప్రజలందరూ నీ ప్రతి ఆజ్ఞకు లోబడతారు.”<verse eid="1CH 28:21"/></para>
  <chapter eid="1CH 28"/>
  <chapter number="29" style="c" sid="1CH 29"/>
  <para style="s1">ఆలయ నిర్మాణానికి కానుకలు</para>
  <para style="p">
    <verse number="1" style="v" sid="1CH 29:1"/>అప్పుడు రాజైన దావీదు సమావేశంలో ఉన్నవారందరితో ఇలా అన్నాడు: “దేవుడు ఎన్నుకున్న నా కుమారుడైన సొలొమోను ఇంకా చిన్నవాడు, అనుభవం లేనివాడు. మందిరం నిర్మించేది మనుష్యునికి కాదు, దేవుడైన యెహోవా కోసం, కాబట్టి పని చాలా గొప్పది. <verse eid="1CH 29:1"/><verse number="2" style="v" sid="1CH 29:2"/>నాకున్న శక్తికొలది నా దేవుని మందిరానికి కావలసిన బంగారు పనికి బంగారాన్ని, వెండి పనికి వెండిని, ఇత్తడి పనికి ఇత్తడిని, ఇనుప పనికి ఇనుమును, చెక్క పనికి చెక్కను, పెద్ద మొత్తంలో గోమేధికపురాళ్లను, వైడూర్యాలను, రకరకాల రంగుల రాళ్లను, అన్ని రకాల జాతి మేలిమి రాళ్లను, పాలరాతిని సమృద్ధిగా సమకూర్చి పెట్టాను. <verse eid="1CH 29:2"/><verse number="3" style="v" sid="1CH 29:3"/>పరిశుద్ధ మందిరం కోసం నేను సమకూర్చినవన్నీ కాకుండా, ఇప్పుడు నా దేవుని మందిరం పట్ల నాకున్న నిబద్ధతను చూపించడానికి నా సొంత ఖజానాలో ఉన్న బంగారాన్ని, వెండిని, నా దేవుని మందిరానికి ఇస్తున్నవి: <verse eid="1CH 29:3"/><verse number="4-5" style="v" sid="1CH 29:4-5"/>భవనాల గోడలకు పూత వేయడానికి, బంగారపు పనికి, వెండి పనికి, పనివారు చేసే ప్రతి పనికి మూడువేల తలాంతుల<note caller="+" style="f"><char style="fr" closed="false">29:4-5 </char><char style="fq" closed="false">మూడువేల తలాంతుల </char><char style="ft" closed="false">అంటే, సుమారు 110 టన్నులు</char></note> ఓఫీరు బంగారం, ఏడువేల<note caller="+" style="f"><char style="fr" closed="false">29:4-5 </char><char style="ft" closed="false">అంటే, సుమారు 260 టన్నులు</char></note> తలాంతుల శుద్ధి చేసిన వెండి. ఇప్పుడు, యెహోవాకు మనస్పూర్తిగా సమర్పించుకునే వారు మీలో ఎవరైనా ఉన్నారా?”<verse eid="1CH 29:4-5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CH 29:6"/>అప్పుడు కుటుంబ నాయకులు, ఇశ్రాయేలు గోత్రాల అధికారులు, సహస్రాధిపతులు, శతాధిపతులు, రాజు పనుల మీద నియమించబడిన అధికారులు అందరు ఇష్టపూర్వకంగా సమర్పించారు. <verse eid="1CH 29:6"/><verse number="7" style="v" sid="1CH 29:7"/>వారు దేవుని మందిరం పనికి అయిదువేల తలాంతుల<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">అంటే, సుమారు 190 టన్నులు</char></note> బంగారాన్ని, పదివేల డారిక్కుల<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">అంటే, సుమారు 84 కి. గ్రా. లు</char></note> బంగారాన్ని, పదివేల తలాంతుల<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">అంటే, 380 టన్నులు</char></note> వెండిని, పద్దెనిమిది వేల తలాంతుల<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">అంటే, సుమారు 675 టన్నులు</char></note> ఇత్తడిని, లక్ష తలాంతుల<note caller="+" style="f"><char style="fr" closed="false">29:7 </char><char style="ft" closed="false">అంటే, సుమారు 3800 టన్నులు</char></note> ఇనుమును ఇచ్చారు. <verse eid="1CH 29:7"/><verse number="8" style="v" sid="1CH 29:8"/>ప్రశస్తమైన రాళ్లు ఉన్నవారు వాటిని తెచ్చి యెహోవా మందిర ఖజానాకు అధికారిగా ఉన్న గెర్షోనీయుడైన యెహీయేలుకు ఇచ్చారు. <verse eid="1CH 29:8"/><verse number="9" style="v" sid="1CH 29:9"/>తమ నాయకులు హృదయమంతటితో స్వేచ్ఛగా యెహోవాకు సమర్పించడం చూసి ప్రజలు వారిని బట్టి సంతోషించారు. రాజైన దావీదు కూడా చాలా సంతోషించాడు.<verse eid="1CH 29:9"/></para>
  <para style="s1">దావీదు ప్రార్థన</para>
  <para style="p">
    <verse number="10" style="v" sid="1CH 29:10"/>దావీదు, అక్కడ సమావేశమైన వారందరి ఎదుట యెహోవాను ఇలా స్తుతించాడు:</para>
  <para style="q1" vid="1CH 29:10">“యెహోవా, మా తండ్రియైన ఇశ్రాయేలు దేవా!</para>
  <para style="q2" vid="1CH 29:10">యుగయుగాల వరకు</para>
  <para style="q2" vid="1CH 29:10">మీకు స్తుతి కలుగును గాక.<verse eid="1CH 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1CH 29:11"/>యెహోవా! మహాత్మ్యం, ప్రభావం,</para>
  <para style="q2" vid="1CH 29:11">వైభవం, తేజస్సు, మహిమ మీకే చెందుతాయి.</para>
  <para style="q2" vid="1CH 29:11">ఎందుకంటే భూమ్యాకాశాల్లో ఉన్నవన్నీ మీవే.</para>
  <para style="q1" vid="1CH 29:11">యెహోవా రాజ్యం మీదే;</para>
  <para style="q2" vid="1CH 29:11">మీరు అందరి మీద అధిపతిగా హెచ్చింపబడ్డారు.<verse eid="1CH 29:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="1CH 29:12"/>ఐశ్వర్యం, ఘనత మీ మూలంగా వస్తాయి;</para>
  <para style="q2" vid="1CH 29:12">మీరు సమస్తానికి పాలకులు.</para>
  <para style="q1" vid="1CH 29:12">అందరిని హెచ్చించి, బలపరచడానికి</para>
  <para style="q2" vid="1CH 29:12">మీ చేతిలో బలం, శక్తి ఉన్నాయి.<verse eid="1CH 29:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="1CH 29:13"/>మా దేవా! మేము మీకు కృతజ్ఞతలు చెల్లిస్తూ,</para>
  <para style="q2" vid="1CH 29:13">మీ ఘనమైన నామాన్ని స్తుతిస్తున్నాము.<verse eid="1CH 29:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CH 29:14"/>“అయితే, ఇంత ధారాళంగా ఇచ్చే సామర్థ్యం కలిగి ఉండడానికి నేను ఏపాటివాన్ని? నా ప్రజలు ఏపాటివారు? అన్నీ మీ నుండే వస్తాయి. మీ చేతి నుండి వచ్చిన దానిలో నుండే మేము మీకు ఇచ్చాము. <verse eid="1CH 29:14"/><verse number="15" style="v" sid="1CH 29:15"/>మా పూర్వికుల్లా మేము మీ దృష్టిలో విదేశీయులం, అపరిచితులము. భూమిమీద మా జీవితకాలం నిరీక్షణలేని నీడలాంటిది. <verse eid="1CH 29:15"/><verse number="16" style="v" sid="1CH 29:16"/>యెహోవా, మా దేవా, నీ పరిశుద్ధ నామం కోసం మందిరాన్ని కట్టించడానికి మేము సమకూర్చిన ఈ సంపదంతా మీ చేతి నుండి వచ్చేదే, దానిలో సమస్తం మీకు చెందినదే. <verse eid="1CH 29:16"/><verse number="17" style="v" sid="1CH 29:17"/>నా దేవా! మీరు హృదయాన్ని పరిశోధిస్తారని, నిజాయితీ అంటే మీకు ఇష్టమని నాకు తెలుసు. నేను ఇవన్నీ ఇష్టపూర్వకంగా నిజాయితితో ఇచ్చాను. ఇప్పుడు ఇక్కడ ఉన్న మీ ప్రజలు కూడా మీకు ఇష్టపూర్వకంగా ఇవ్వడం చూసి నేను సంతోషిస్తున్నాను. <verse eid="1CH 29:17"/><verse number="18" style="v" sid="1CH 29:18"/>యెహోవా! మా పూర్వికులైన అబ్రాహాము, ఇస్సాకు, ఇశ్రాయేలు దేవా, ఈ ఆశలు, తలంపులు మీ ప్రజల హృదయాల్లో ఎప్పుడూ ఉండేలా, వారి హృదయాలు మీ పట్ల నమ్మకంగా ఉండేలా చేయండి. <verse eid="1CH 29:18"/><verse number="19" style="v" sid="1CH 29:19"/>నా కుమారుడైన సొలొమోను మీ ఆజ్ఞలను, శాసనాలను, నియమాలను పాటిస్తూ, నేను ఆలయ నిర్మాణం కోసం సమకూర్చిన వాటితో అతడు కట్టించడానికి అతడు పూర్ణహృదయంతో భక్తి కలిగి ఉండునట్లు చేయండి.”<verse eid="1CH 29:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CH 29:20"/>తర్వాత దావీదు సమావేశమైన వారందరితో, “మీ దేవుడైన యెహోవాను స్తుతించండి” అని చెప్పాడు. అప్పుడు వారందరూ తమ పూర్వికుల దేవుడైన యెహోవాను స్తుతించి, యెహోవా ఎదుట, రాజు ఎదుట తలలు వంచి, సాగిలపడ్డారు.<verse eid="1CH 29:20"/></para>
  <para style="s1">సొలొమోను రాజుగా నియమించబడుట</para>
  <para style="p">
    <verse number="21" style="v" sid="1CH 29:21"/>మరుసటిరోజు వారు యెహోవాకు అర్పణలు ఇచ్చి దహనబలులు అర్పించారు: వెయ్యి ఎద్దులు, వెయ్యి పొట్టేళ్లు, వెయ్యి మగ గొర్రెపిల్లలు, వాటితో పాటు పానార్పణలను ఇశ్రాయేలీయులందరి పక్షాన సరిపడా ఇతర బలులు అర్పించారు. <verse eid="1CH 29:21"/><verse number="22" style="v" sid="1CH 29:22"/>ఆ రోజు వారు యెహోవా సన్నిధిలో చాలా ఆనందంతో విందు చేసుకున్నారు.</para>
  <para style="p" vid="1CH 29:22">అప్పుడు వారు దావీదు కుమారుడైన సొలొమోనుకు రెండవసారి పట్టాభిషేకం చేసి, యెహోవా సన్నిధిలో అతన్ని పాలకునిగా, సాదోకును యాజకునిగా అభిషేకించారు. <verse eid="1CH 29:22"/><verse number="23" style="v" sid="1CH 29:23"/>కాబట్టి సొలొమోను రాజుగా తన తండ్రియైన దావీదు స్థానంలో యెహోవా రాజ్యసింహాసనం మీద కూర్చున్నాడు. అతడు అన్నిటిలో వృద్ధి చెందాడు, ఇశ్రాయేలీయులందరు అతనికి విధేయులయ్యారు. <verse eid="1CH 29:23"/><verse number="24" style="v" sid="1CH 29:24"/>అధిపతులందరు, యుద్ధ వీరులందరు, రాజైన దావీదు కుమారులందరు, సొలొమోను రాజుకు విధేయత చూపించారు.<verse eid="1CH 29:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CH 29:25"/>యెహోవా సొలొమోనును ఇశ్రాయేలీయులందరి ఎదుట ఎంతో ఉన్నతంగా చేసి, అతనికి ముందున్న ఇశ్రాయేలీయుల రాజులలో ఏ రాజుకు కలగని రాజ వైభవాన్ని అతనికి ప్రసాదించారు.<verse eid="1CH 29:25"/></para>
  <para style="s1">దావీదు మరణము</para>
  <para style="p">
    <verse number="26" style="v" sid="1CH 29:26"/>యెష్షయి కుమారుడైన దావీదు ఇశ్రాయేలు అంతటి మీద రాజుగా ఉన్నాడు. <verse eid="1CH 29:26"/><verse number="27" style="v" sid="1CH 29:27"/>అతడు ఇశ్రాయేలును నలభై సంవత్సరాలు అంటే హెబ్రోనులో ఏడు సంవత్సరాలు, యెరూషలేములో ముప్పై మూడు సంవత్సరాలు పరిపాలించాడు. <verse eid="1CH 29:27"/><verse number="28" style="v" sid="1CH 29:28"/>అతడు దీర్ఘకాలం జీవించి ఐశ్వర్యాన్ని ఘనతను పొంది మంచి వృద్ధాప్యంలో చనిపోయాడు. అతని స్థానంలో అతని కుమారుడైన సొలొమోను రాజయ్యాడు.<verse eid="1CH 29:28"/></para>
  <para style="p">
    <verse number="29-30" style="v" sid="1CH 29:29-30"/>రాజైన దావీదుకు సంబంధించిన ఇతర వివరాలన్నీ మొదటి నుండి చివరి వరకు, అతని పాలనకు అధికారానికి సంబంధించిన వివరాలు, అతడు, ఇశ్రాయేలీయులు ఇతర దేశాల రాజ్యాలు ఎదుర్కొన్న పరిస్థితుల వివరాలు దీర్ఘదర్శి సమూయేలు, నాతాను ప్రవక్త, దీర్ఘదర్శి గాదు వ్రాసిన చరిత్ర గ్రంథాల్లో ఉన్నాయి.<verse eid="1CH 29:29-30"/></para>
  <chapter eid="1CH 29"/>
</usx>
