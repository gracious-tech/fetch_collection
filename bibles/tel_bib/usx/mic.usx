<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MIC" style="id">- Biblica® Open Telugu Contemporary Version</book>
  <para style="h">మీకా</para>
  <para style="toc1">మీకా ప్రవచనం</para>
  <para style="toc2">మీకా</para>
  <para style="toc3">మీకా</para>
  <para style="mt1">మీకా</para>
  <para style="mt2">ప్రవచనం</para>
  <chapter number="1" style="c" sid="MIC 1"/>
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1"/>యోతాము, ఆహాజు, హిజ్కియా అనే యూదా రాజుల పరిపాలన కాలాల్లో మోరెషెతు వాడైన మీకా దగ్గరకు వచ్చిన యెహోవా వాక్కు. సమరయ, యెరూషలేముల గురించి అతడు చూసిన దర్శనం.<verse eid="MIC 1:1"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 1:2"/>ప్రజలారా, మీరంతా వినండి,</para>
  <para style="q2" vid="MIC 1:2">భూమీ, నీవు నీలోని నివాసులందరూ ఆలకించండి,</para>
  <para style="q1" vid="MIC 1:2">ప్రభువైన యెహోవా మీమీద నేరారోపణ చేయబోతున్నారు,</para>
  <para style="q2" vid="MIC 1:2">ప్రభువు తన పరిశుద్ధ ఆలయం నుండి మాట్లాడుతున్నారు.<verse eid="MIC 1:2"/></para>
  <para style="s1">సమరయ యెరూషలేముల మీద తీర్పు</para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 1:3"/>చూడండి! యెహోవా తన నివాసస్థలం నుండి వస్తున్నారు;</para>
  <para style="q2" vid="MIC 1:3">ఆయన దిగి భూమిమీది ఉన్నతస్థలాల మీద నడవబోతున్నారు.<verse eid="MIC 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 1:4"/>అగ్నికి మైనం కరిగినట్లు,</para>
  <para style="q2" vid="MIC 1:4">వాలు మీద నీరు ప్రవహించినట్లు,</para>
  <para style="q1" vid="MIC 1:4">ఆయన పాదాల క్రింద పర్వతాలు కరుగుతాయి,</para>
  <para style="q2" vid="MIC 1:4">లోయలు చీలిపోతాయి.<verse eid="MIC 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 1:5"/>దీనంతటికీ యాకోబు అతిక్రమం,</para>
  <para style="q2" vid="MIC 1:5">ఇశ్రాయేలు ప్రజల పాపాలే కారణం.</para>
  <para style="q1" vid="MIC 1:5">యాకోబు అతిక్రమం ఏంటి?</para>
  <para style="q2" vid="MIC 1:5">అది సమరయ కాదా?</para>
  <para style="q1" vid="MIC 1:5">యూదా యొక్క క్షేత్రం ఏంటి?</para>
  <para style="q2" vid="MIC 1:5">అది యెరూషలేము కాదా?<verse eid="MIC 1:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 1:6"/>“కాబట్టి నేను సమరయను రాళ్ల కుప్పగా చేస్తాను,</para>
  <para style="q2" vid="MIC 1:6">అది ద్రాక్షతోటలు నాటే స్థలం అవుతుంది.</para>
  <para style="q1" vid="MIC 1:6">దాని రాళ్లను లోయలో పారవేస్తాను,</para>
  <para style="q2" vid="MIC 1:6">దాని పునాదులు బయట పడతాయి.<verse eid="MIC 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 1:7"/>దాని విగ్రహాలన్నీ ముక్కలుగా విరగ్గొట్టబడతాయి;</para>
  <para style="q2" vid="MIC 1:7">దాని గుడి కానుకలన్ని అగ్నితో కాల్చబడతాయి;</para>
  <para style="q2" vid="MIC 1:7">నేను దాని ప్రతిమలన్నిటినీ నాశనం చేస్తాను.</para>
  <para style="q1" vid="MIC 1:7">అది వేశ్య సంపాదనతో తన బహుమానాలను పోగుచేసింది కాబట్టి</para>
  <para style="q2" vid="MIC 1:7">అవి మళ్ళీ వేశ్య జీతంగా ఇవ్వబడతాయి.”<verse eid="MIC 1:7"/></para>
  <para style="s1">ఏడ్వడం, దుఃఖించడం</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 1:8"/>దీనిని బట్టి నేను ఏడుస్తూ విలపిస్తాను;</para>
  <para style="q2" vid="MIC 1:8">నేను చెప్పులు లేకుండా, దిగంబరిగా బయట తిరుగుతాను.</para>
  <para style="q1" vid="MIC 1:8">నేను నక్కలా అరుస్తాను,</para>
  <para style="q2" vid="MIC 1:8">గుడ్లగూబలాగా మూలుగుతాను.<verse eid="MIC 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 1:9"/>ఎందుకంటే సమరయ తెగులు బాగు చేయలేనిది;</para>
  <para style="q2" vid="MIC 1:9">అది యూదాకు వ్యాపించింది.</para>
  <para style="q1" vid="MIC 1:9">అది నా ప్రజల ద్వారాల వరకు,</para>
  <para style="q2" vid="MIC 1:9">యెరూషలేము వరకు కూడా వ్యాపించింది.<verse eid="MIC 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 1:10"/>ఈ సంగతి గాతు<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="fq" closed="false">గాతు </char><char style="ft" closed="false">హెబ్రీలో </char><char style="fqa" closed="false">మాట్లాడు</char></note> పట్టణంలో చెప్పకండి;</para>
  <para style="q2" vid="MIC 1:10">ఏమాత్రం ఏడవకండి.</para>
  <para style="q1" vid="MIC 1:10">బేత్-లీఫ్రాలో<note caller="+" style="f"><char style="fr" closed="false">1:10 </char><char style="fq" closed="false">బేత్-లీఫ్రాలో </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">దుమ్ము గల ఇల్లు</char></note></para>
  <para style="q2" vid="MIC 1:10">నేను ధూళిలో పొర్లాడాను.<verse eid="MIC 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 1:11"/>షాఫీరు<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="fq" closed="false">షాఫీరు </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">ఆహ్లాదకరం</char></note> వాసులారా,</para>
  <para style="q2" vid="MIC 1:11">దిగంబరులై సిగ్గు పడుతూ దాటి వెళ్లండి.</para>
  <para style="q1" vid="MIC 1:11">జయనాను<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="fq" closed="false">జయనాను </char><char style="ft" closed="false">హెబ్రీలో </char><char style="fqa" closed="false">బయటకు రావడం</char></note> నివాసులు</para>
  <para style="q2" vid="MIC 1:11">బయటకు రారు.</para>
  <para style="q1" vid="MIC 1:11">బేత్-ఏజెల్ శోకంలో ఉంది;</para>
  <para style="q2" vid="MIC 1:11">అది ఇక ఎన్నడు మిమ్మల్ని కాపాడదు.<verse eid="MIC 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 1:12"/>మారోతు<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="fq" closed="false">మారోతు </char><char style="ft" closed="false">హెబ్రీలో </char><char style="fqa" closed="false">చేదు</char></note> వాసులు బాధలో ఉన్నారు,</para>
  <para style="q2" vid="MIC 1:12">ఉపశమనం కోసం ఎదురు చూస్తున్నారు,</para>
  <para style="q1" vid="MIC 1:12">ఎందుకంటే, ఎందుకంటే, యెహోవా దగ్గర నుండి కీడు వచ్చింది,</para>
  <para style="q2" vid="MIC 1:12">అది యెరూషలేము ద్వారం వరకు వచ్చింది.<verse eid="MIC 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 1:13"/>లాకీషులో నివాసులారా,</para>
  <para style="q2" vid="MIC 1:13">రథాలకు గుర్రాలను కట్టండి.</para>
  <para style="q1" vid="MIC 1:13">ఇశ్రాయేలు అతిక్రమాలు మీలో కనిపించాయి,</para>
  <para style="q2" vid="MIC 1:13">సీయోను కుమార్తె పాపానికి ప్రారంభం మీరు.<verse eid="MIC 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 1:14"/>కాబట్టి మీరు మోరెషెత్-గాతుకు</para>
  <para style="q2" vid="MIC 1:14">వీడుకోలు కానుకలిస్తారు.</para>
  <para style="q1" vid="MIC 1:14">అక్సీబు పట్టణం ఇశ్రాయేలు రాజులను</para>
  <para style="q2" vid="MIC 1:14">మోసగిస్తుందని రుజువు అవుతుంది.<verse eid="MIC 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 1:15"/>మరేషా<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="fq" closed="false">మరేషా </char><char style="ft" closed="false">హెబ్రీలో </char><char style="fqa" closed="false">జయించేవాడు</char></note> వాసులారా!</para>
  <para style="q2" vid="MIC 1:15">మీ పట్టణాన్ని స్వాధీనపరచుకునేవారిని పంపుతాను.</para>
  <para style="q1" vid="MIC 1:15">ఇశ్రాయేలు ఘనులు</para>
  <para style="q2" vid="MIC 1:15">అదుల్లాముకు పారిపోతారు.<verse eid="MIC 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 1:16"/>మీకు ఇష్టమైన పిల్లల కోసం</para>
  <para style="q2" vid="MIC 1:16">శోకంలో మీ తలలు గొరిగించుకోండి;</para>
  <para style="q1" vid="MIC 1:16">రాబందులా బోడితల చేసుకోండి</para>
  <para style="q2" vid="MIC 1:16">ఎందుకంటే మీ పిల్లలు మీ నుండి బందీలుగా వెళ్తారు.<verse eid="MIC 1:16"/></para>
  <chapter eid="MIC 1"/>
  <chapter number="2" style="c" sid="MIC 2"/>
  <para style="s1">మానవ ప్రణాళికలు, దేవుని ప్రణాళికలు</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 2:1"/>తమ పడకల మీద పాపపు ఆలోచనలు చేసేవారికి,</para>
  <para style="q2" vid="MIC 2:1">కీడును తలంచే వారికి శ్రమ!</para>
  <para style="q1" vid="MIC 2:1">వారికి అధికారం ఉంది కాబట్టి,</para>
  <para style="q2" vid="MIC 2:1">ఉదయకాల వెలుగులో వారు చెడు చేస్తారు.<verse eid="MIC 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 2:2"/>వారు భూములను ఆశించి ఆక్రమించుకుంటారు,</para>
  <para style="q2" vid="MIC 2:2">ఇళ్ళను ఆశించి తీసుకుంటారు.</para>
  <para style="q1" vid="MIC 2:2">వారు ప్రజలను మోసం చేసి వారి ఇళ్ళను లాక్కుంటారు,</para>
  <para style="q2" vid="MIC 2:2">ప్రజల నుండి వారి స్వాస్థ్యాన్ని దోచుకుంటారు.<verse eid="MIC 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MIC 2:3"/>కాబట్టి యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="MIC 2:3">“నేను ఈ వంశం మీదికి విపత్తు రప్పించబోతున్నాను,</para>
  <para style="q2" vid="MIC 2:3">దాని నుండి మీరు మిమ్మల్ని కాపాడుకోలేరు.</para>
  <para style="q1" vid="MIC 2:3">అది విపత్తు కాలం కాబట్టి</para>
  <para style="q2" vid="MIC 2:3">మీరు ఇక ఎన్నడు గర్వంగా నడవలేరు.<verse eid="MIC 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 2:4"/>ఆ రోజు ప్రజలు మీ గురించి ఒక సామెత చెప్తారు;</para>
  <para style="q2" vid="MIC 2:4">మీ గురించి ఈ విషాద గీతం పాడుతూ ఎగతాళి చేస్తారు:</para>
  <para style="q1" vid="MIC 2:4">‘మేము పూర్తిగా పాడైపోయాం;</para>
  <para style="q2" vid="MIC 2:4">నా ప్రజల ఆస్తి విభజింపబడింది</para>
  <para style="q1" vid="MIC 2:4">ఆయన దాన్ని నా నుండి తీసుకుంటారు!</para>
  <para style="q2" vid="MIC 2:4">ఆయన మా భూములను దేశద్రోహులకు అప్పగించారు.’ ”<verse eid="MIC 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 2:5"/>అందువల్ల చీట్లువేసి భూమిని కొలమానం ప్రకారం పంచడానికి</para>
  <para style="q2" vid="MIC 2:5">యెహోవా సమాజంలో ఎవరూ ఉండరు.<verse eid="MIC 2:5"/></para>
  <para style="s1">అబద్ధ ప్రవక్తలు</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 2:6"/>“ప్రవచించకండి” అని వారి ప్రవక్తలు అంటారు,</para>
  <para style="q2" vid="MIC 2:6">“వీటి గురించి ప్రవచించకండి;</para>
  <para style="q2" vid="MIC 2:6">మనకు అవమానం కలుగకూడదు.”<verse eid="MIC 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 2:7"/>యాకోబు వారసులారా,</para>
  <para style="q2" vid="MIC 2:7">“యెహోవా సహనం కోల్పోయారా?</para>
  <para style="q2" vid="MIC 2:7">ఆయన ఇలాంటి పనులు చేస్తారా?” అని అనవచ్చా?</para>
  <para style="b" vid="MIC 2:7"/>
  <para style="q1" vid="MIC 2:7">“యథార్థంగా ప్రవర్తించే వారికి</para>
  <para style="q2" vid="MIC 2:7">నా మాటలు క్షేమం కలిగించవా?<verse eid="MIC 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 2:8"/>ఇటీవల నా ప్రజలే</para>
  <para style="q2" vid="MIC 2:8">శత్రువుగా లేచారు.</para>
  <para style="q1" vid="MIC 2:8">యుద్ధం నుండి తిరిగి వచ్చే మనుష్యుల్లా,</para>
  <para style="q2" vid="MIC 2:8">నిర్భయంగా దారిన పోతూ ఉన్న వారి నుండి</para>
  <para style="q2" vid="MIC 2:8">సంపన్న వస్త్రాన్ని మీరు లాగివేస్తారు.<verse eid="MIC 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 2:9"/>నా ప్రజల స్త్రీలను</para>
  <para style="q2" vid="MIC 2:9">వారికిష్టమైన గృహాలలో నుండి వెళ్లగొడతారు.</para>
  <para style="q1" vid="MIC 2:9">వారి పిల్లల మీద ఎప్పటికీ</para>
  <para style="q2" vid="MIC 2:9">నా ఆశీర్వాదం ఉండకుండా చేస్తున్నారు.<verse eid="MIC 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 2:10"/>మీరు లేచి వెళ్లిపోండి!</para>
  <para style="q2" vid="MIC 2:10">ఇది మీ విశ్రాంతి స్థలం కాదు,</para>
  <para style="q1" vid="MIC 2:10">ఎందుకంటే అది అపవిత్రమైంది,</para>
  <para style="q2" vid="MIC 2:10">అది పూర్తిగా నిర్మూలమైంది.<verse eid="MIC 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 2:11"/>ఒకవేళ అబద్ధికుడు మోసగాడు వచ్చి,</para>
  <para style="q2" vid="MIC 2:11">‘ద్రాక్షరసం గురించి, మద్యం గురించి నేను మీకు ప్రవచిస్తాను’</para>
  <para style="q2" vid="MIC 2:11">అంటే, వాడే ఈ ప్రజలకు తగిన ప్రవక్త!<verse eid="MIC 2:11"/></para>
  <para style="s1">విమోచన వాగ్దానం</para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 2:12"/>“యాకోబూ, నేను ఖచ్చితంగా మీ అందరిని సమకూరుస్తాను;</para>
  <para style="q2" vid="MIC 2:12">నేను ఖచ్చితంగా మిగిలిన ఇశ్రాయేలీయులను పోగుచేస్తాను.</para>
  <para style="q1" vid="MIC 2:12">నేను వారిని గొర్రెల దొడ్డిలోని గొర్రెల్లా,</para>
  <para style="q2" vid="MIC 2:12">పచ్చిక బయళ్లలోని మందలా సమకూరుస్తాను,</para>
  <para style="q2" vid="MIC 2:12">ఈ స్థలం మనుష్యులతో కిటకిటలాడుతుంది.<verse eid="MIC 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 2:13"/>అడ్డును పడగొట్టేవాడు వారికి ముందుగా వెళ్తాడు;</para>
  <para style="q2" vid="MIC 2:13">వారు గుమ్మాన్ని పడగొట్టి, దానిగుండా బయటకు వెళ్తారు.</para>
  <para style="q1" vid="MIC 2:13">వారి రాజు వారికి ముందుగా వెళ్తాడు,</para>
  <para style="q2" vid="MIC 2:13">యెహోవా వారికి నాయకునిగా ఉంటారు.”<verse eid="MIC 2:13"/></para>
  <chapter eid="MIC 2"/>
  <chapter number="3" style="c" sid="MIC 3"/>
  <para style="s1">నాయకులు, ప్రవక్తలు గద్దించబడుట</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 3:1"/>అప్పుడు నేను ఇలా అన్నాను,</para>
  <para style="q1" vid="MIC 3:1">“యాకోబు నాయకులారా,</para>
  <para style="q2" vid="MIC 3:1">ఇశ్రాయేలు పాలకులారా, వినండి.</para>
  <para style="q1" vid="MIC 3:1">న్యాయాన్ని మీరు తెలుసుకోవద్దా?<verse eid="MIC 3:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="MIC 3:2"/>మీరు మంచిని అసహ్యించుకుని చెడును ప్రేమిస్తారు;</para>
  <para style="q1" vid="MIC 3:2">నా ప్రజల చర్మం ఒలిచి,</para>
  <para style="q2" vid="MIC 3:2">వారి ఎముకల మీద మాంసాన్ని చీలుస్తారు;<verse eid="MIC 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 3:3"/>నా ప్రజల మాంసాన్ని తింటారు,</para>
  <para style="q2" vid="MIC 3:3">వారి చర్మం ఒలిచి,</para>
  <para style="q2" vid="MIC 3:3">వారి ఎముకలను ముక్కలుగా విరగ్గొడతారు;</para>
  <para style="q1" vid="MIC 3:3">పాత్రలో వేసే మాంసాన్ని ముక్కలు చేసినట్లు,</para>
  <para style="q2" vid="MIC 3:3">కుండలో వేసే మాంసాన్ని ముక్కలు చేసినట్లు చేస్తారు.”<verse eid="MIC 3:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 3:4"/>తర్వాత వారు యెహోవాకు మొరపెడతారు,</para>
  <para style="q2" vid="MIC 3:4">కాని ఆయన వారికి జవాబివ్వరు.</para>
  <para style="q1" vid="MIC 3:4">వారు చేసిన చెడు కారణంగా</para>
  <para style="q2" vid="MIC 3:4">ఆయన ఆ కాలంలో తన ముఖం దాచుకుంటారు.<verse eid="MIC 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 3:5"/>యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="MIC 3:5">“నా ప్రజలను తప్పుదారి పట్టించిన</para>
  <para style="q2" vid="MIC 3:5">ప్రవక్తల విషయానికి వస్తే,</para>
  <para style="q1" vid="MIC 3:5">వారికి తినడానికి ఏదైన ఉంటే,</para>
  <para style="q2" vid="MIC 3:5">వారు ‘సమాధానం’ ప్రకటిస్తారు,</para>
  <para style="q1" vid="MIC 3:5">కాని ఎవరైనా వారికి భోజనం పెట్టకపోతే,</para>
  <para style="q2" vid="MIC 3:5">వారి మీద యుద్ధానికి సిద్ధపడతారు.<verse eid="MIC 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 3:6"/>కాబట్టి మీకు దర్శనాలేమీ రాకుండా రాత్రి కమ్ముతుంది,</para>
  <para style="q2" vid="MIC 3:6">సోదె చెప్పకుండా మిమ్మల్ని చీకటి ఆవరిస్తుంది.</para>
  <para style="q1" vid="MIC 3:6">ప్రవక్తలకు సూర్యాస్తమయం అవుతుంది,</para>
  <para style="q2" vid="MIC 3:6">పగలు వారికి చీకటిగా మారుతుంది.<verse eid="MIC 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 3:7"/>అప్పుడు దీర్ఘదర్శులు సిగ్గుపడతారు</para>
  <para style="q2" vid="MIC 3:7">సోదె చెప్పేవారు అవమానపడతారు.</para>
  <para style="q1" vid="MIC 3:7">దేవుని దగ్గర నుండి జవాబేమీ రాక</para>
  <para style="q2" vid="MIC 3:7">వారంతా తమ ముఖాలను కప్పుకుంటారు.”<verse eid="MIC 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 3:8"/>నేనైతే, యాకోబుకు అతని అతిక్రమాన్ని</para>
  <para style="q2" vid="MIC 3:8">ఇశ్రాయేలుకు అతని పాపాన్ని తెలియజేయడానికి,</para>
  <para style="q2" vid="MIC 3:8">యెహోవా ఆత్మను పొంది</para>
  <para style="q1" vid="MIC 3:8">శక్తితో నింపబడి ఉన్నాను,</para>
  <para style="q2" vid="MIC 3:8">న్యాయబుద్ధితో, బలంతో ఉన్నాను.<verse eid="MIC 3:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 3:9"/>యాకోబు నాయకులారా,</para>
  <para style="q2" vid="MIC 3:9">ఇశ్రాయేలు పాలకులారా, మీరు ఇది వినండి.</para>
  <para style="q1" vid="MIC 3:9">మీరు న్యాయాన్ని తృణీకరించి,</para>
  <para style="q2" vid="MIC 3:9">సరియైన దానినంతటిని వంకర చేస్తారు;<verse eid="MIC 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 3:10"/>మీరు రక్తపాతంతో సీయోనును కడతారు,</para>
  <para style="q2" vid="MIC 3:10">దుష్టత్వంతో యెరూషలేమును నిర్మిస్తారు.<verse eid="MIC 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 3:11"/>దాని నాయకులు లంచం తీసుకుని తీర్పు చెప్తారు,</para>
  <para style="q2" vid="MIC 3:11">దాని యాజకులు జీతానికి ఉపదేశిస్తారు.</para>
  <para style="q2" vid="MIC 3:11">దాని ప్రవక్తలు డబ్బు కోసం సోదె చెప్తారు.</para>
  <para style="q1" vid="MIC 3:11">అయినా వారు యెహోవా సహాయం కోసం చూస్తూ,</para>
  <para style="q2" vid="MIC 3:11">“యెహోవా మన మధ్య ఉన్నారు గదా!</para>
  <para style="q2" vid="MIC 3:11">ఏ కీడు మన మీదికి రాదు” అంటారు.<verse eid="MIC 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 3:12"/>కాబట్టి మీ కారణంగా,</para>
  <para style="q2" vid="MIC 3:12">సీయోను ఒక పొలంలా దున్నబడుతుంది,</para>
  <para style="q1" vid="MIC 3:12">యెరూషలేము రాళ్ల కుప్పగా మారుతుంది</para>
  <para style="q2" vid="MIC 3:12">ఆలయమున్న కొండ దట్టమైన పొదలతో మట్టి దిబ్బగా మారుతుంది.<verse eid="MIC 3:12"/></para>
  <chapter eid="MIC 3"/>
  <chapter number="4" style="c" sid="MIC 4"/>
  <para style="s1">యెహోవా పర్వతం</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 4:1"/>చివరి రోజుల్లో</para>
  <para style="q1" vid="MIC 4:1">యెహోవా ఆలయ పర్వతం</para>
  <para style="q2" vid="MIC 4:1">పర్వతాలన్నిటిలో ఉన్నతమైనదిగా స్థిరపరచబడుతుంది;</para>
  <para style="q1" vid="MIC 4:1">అది కొండలకు పైగా హెచ్చింపబడుతుంది,</para>
  <para style="q2" vid="MIC 4:1">ప్రజలు ప్రవాహంలా దాని దగ్గరకు వెళ్తారు.<verse eid="MIC 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MIC 4:2"/>అన్య దేశాల వారనేకులు వచ్చి ఇలా అంటారు,</para>
  <para style="q1" vid="MIC 4:2">“రండి, మనం యెహోవా పర్వతం మీదికి,</para>
  <para style="q2" vid="MIC 4:2">యాకోబు దేవుని ఆలయానికి వెళ్దాము.</para>
  <para style="q1" vid="MIC 4:2">మనం ఆయన మార్గంలో నడిచేలా,</para>
  <para style="q2" vid="MIC 4:2">ఆయన మనకు తన మార్గాల్ని బోధిస్తారు.”</para>
  <para style="q1" vid="MIC 4:2">సీయోనులో నుండి ధర్మశాస్త్రం,</para>
  <para style="q2" vid="MIC 4:2">యెరూషలేములో నుండి యెహోవా వాక్కు బయటకు వెళ్తాయి.<verse eid="MIC 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 4:3"/>ఆయన అనేక ప్రజలకు తీర్పు తీరుస్తారు,</para>
  <para style="q2" vid="MIC 4:3">దూరంగా ఉన్న బలమైన దేశాల వివాదాలను పరిష్కరిస్తారు.</para>
  <para style="q1" vid="MIC 4:3">వారు తమ ఖడ్గాలను సాగగొట్టి నాగటి నక్కులుగా,</para>
  <para style="q2" vid="MIC 4:3">తమ ఈటెలను సాగగొట్టి మడ్డికత్తులుగా చేస్తారు.</para>
  <para style="q1" vid="MIC 4:3">దేశం మరొక దేశం మీది ఖడ్గం తీయదు,</para>
  <para style="q2" vid="MIC 4:3">వారు ఇకపై యుద్ధానికి శిక్షణ పొందరు.<verse eid="MIC 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 4:4"/>ప్రతి ఒక్కరు తమ సొంత ద్రాక్షచెట్టు క్రింద,</para>
  <para style="q2" vid="MIC 4:4">తమ అంజూర చెట్టు క్రింద కూర్చుంటారు,</para>
  <para style="q1" vid="MIC 4:4">ఎవరూ వారిని భయపెట్టరు,</para>
  <para style="q2" vid="MIC 4:4">ఎందుకంటే సైన్యాల యెహోవా మాట ఇచ్చారు.<verse eid="MIC 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 4:5"/>అన్ని దేశాల ప్రజలు తమ దేవుళ్ళ పేరిట నడుచుకుంటారు,</para>
  <para style="q2" vid="MIC 4:5">అయితే మేము మా దేవుడైన</para>
  <para style="q2" vid="MIC 4:5">యెహోవా పేరును బట్టి ఎల్లకాలం నడుచుకుంటాము.<verse eid="MIC 4:5"/></para>
  <para style="s1">యెహోవా ప్రణాళిక</para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 4:6"/>యెహోవా ఇలా అంటున్నారు, “ఆ రోజు,</para>
  <para style="q2" vid="MIC 4:6">నేను కుంటివారిని పోగుచేస్తాను;</para>
  <para style="q1" vid="MIC 4:6">బందీలుగా వెళ్లిన వారిని,</para>
  <para style="q2" vid="MIC 4:6">నేను బాధకు గురిచేసిన వారిని సమకూరుస్తాను.<verse eid="MIC 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 4:7"/>కుంటివారిని నా శేషంగా,</para>
  <para style="q2" vid="MIC 4:7">వెళ్లగొట్టబడిన వారిని బలమైన దేశంగా చేస్తాను.</para>
  <para style="q1" vid="MIC 4:7">యెహోవా సీయోను కొండమీద</para>
  <para style="q2" vid="MIC 4:7">ఆ రోజు నుండి ఎల్లప్పుడూ వారిని పరిపాలిస్తారు.<verse eid="MIC 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 4:8"/>మందకు కావలికోటగా,</para>
  <para style="q2" vid="MIC 4:8">సీయోను కుమార్తె దుర్గంగా<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">కొండ</char></note> ఉన్న నీకైతే,</para>
  <para style="q1" vid="MIC 4:8">మునుపటి అధికారం తిరిగి ఇవ్వబడుతుంది;</para>
  <para style="q2" vid="MIC 4:8">యెరూషలేము కుమార్తెకు రాజ్యాధికారం వస్తుంది.”<verse eid="MIC 4:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 4:9"/>ఇప్పుడు మీరెందుకు కేకలు వేస్తున్నారు?</para>
  <para style="q2" vid="MIC 4:9">మీకు రాజు లేడా?</para>
  <para style="q1" vid="MIC 4:9">మీ పరిపాలకుడు నాశనమయ్యాడా?</para>
  <para style="q2" vid="MIC 4:9">స్త్రీ ప్రసవవేదన పడినట్లు మీరెందుకు వేదన చెందుతున్నారు?<verse eid="MIC 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 4:10"/>సీయోను కుమార్తె, నీవు</para>
  <para style="q2" vid="MIC 4:10">ప్రసవ వేదనలో ఉన్న స్త్రీలా వేదనతో మెలికలు తిరుగు,</para>
  <para style="q1" vid="MIC 4:10">ఎందుకంటే ఇప్పుడు నీవు పట్టణం వదిలిపెట్టి,</para>
  <para style="q2" vid="MIC 4:10">బయట నివసించాలి.</para>
  <para style="q1" vid="MIC 4:10">మీరు బబులోనుకు వెళ్తారు,</para>
  <para style="q2" vid="MIC 4:10">అక్కడే మీరు విడిపించబడతారు.</para>
  <para style="q1" vid="MIC 4:10">అక్కడే యెహోవా మీ శత్రువు చేతిలో నుండి</para>
  <para style="q2" vid="MIC 4:10">మిమ్మల్ని విడిపిస్తారు.<verse eid="MIC 4:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 4:11"/>ఇప్పుడు అనేక దేశాలు</para>
  <para style="q2" vid="MIC 4:11">మీకు విరుద్ధంగా కూడుకుని,</para>
  <para style="q1" vid="MIC 4:11">“సీయోను అపవిత్రం కావాలి,</para>
  <para style="q2" vid="MIC 4:11">దాని నాశనం మేము కళ్లారా చూడాలి!” అంటున్నారు.<verse eid="MIC 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 4:12"/>కాని వారికి</para>
  <para style="q2" vid="MIC 4:12">యెహోవా తలంపులు తెలియవు;</para>
  <para style="q1" vid="MIC 4:12">ఆయన ప్రణాళిక వారు గ్రహించరు.</para>
  <para style="q2" vid="MIC 4:12">నూర్పిడి కళ్ళంలో పనలు సమకూర్చినట్లు ఆయన వారిని సమకూరుస్తారు.<verse eid="MIC 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 4:13"/>“సీయోను కుమార్తె, లేచి, కళ్ళం త్రొక్కు,</para>
  <para style="q2" vid="MIC 4:13">నేను నీకు ఇనుప కొమ్ములు ఇస్తాను;</para>
  <para style="q1" vid="MIC 4:13">ఇత్తడి డెక్కలు ఇస్తాను.</para>
  <para style="q2" vid="MIC 4:13">నీవు అనేక దేశాలను ముక్కలుగా విరగ్గొడతావు.”</para>
  <para style="q1" vid="MIC 4:13">నీవు వారి అన్యాయపు సంపదను యెహోవాకు సమర్పిస్తావు.</para>
  <para style="q2" vid="MIC 4:13">వారి ఆస్తులను సర్వలోక ప్రభువుకు సమర్పిస్తావు.<verse eid="MIC 4:13"/></para>
  <chapter eid="MIC 4"/>
  <chapter number="5" style="c" sid="MIC 5"/>
  <para style="s1">బేత్లెహేము నుండి వాగ్దాన పాలకుడు</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 5:1"/>సైన్య సమూహాలు గల నగరమా, సమూహాలను సమకూర్చు,</para>
  <para style="q2" vid="MIC 5:1">శత్రువులు మనల్ని ముట్టడించారు.</para>
  <para style="q1" vid="MIC 5:1">వారు ఇశ్రాయేలు ప్రజల పాలకున్ని</para>
  <para style="q2" vid="MIC 5:1">బెత్తంతో చెంపమీద కొడతారు.<verse eid="MIC 5:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 5:2"/>“అయితే బేత్లెహేము ఎఫ్రాతా,</para>
  <para style="q2" vid="MIC 5:2">యూదా వారి కుటుంబాల మధ్య నీవు చిన్నదానివైనప్పటికి,</para>
  <para style="q1" vid="MIC 5:2">నా కోసం</para>
  <para style="q2" vid="MIC 5:2">ఇశ్రాయేలు మీద పరిపాలన చేసే అధిపతి నీలో నుండి వస్తాడు,</para>
  <para style="q1" vid="MIC 5:2">ఆయన పూర్వకాలం నుండి</para>
  <para style="q2" vid="MIC 5:2">శాశ్వతకాలం ఉన్నవాడు.”<verse eid="MIC 5:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 5:3"/>కాబట్టి ప్రసవ వేదన పడే స్త్రీ బిడ్డను కనేవరకు</para>
  <para style="q2" vid="MIC 5:3">ఇశ్రాయేలు విడిచిపెట్టబడుతుంది.</para>
  <para style="q1" vid="MIC 5:3">అతని సోదరులలో మిగిలిన వారు,</para>
  <para style="q2" vid="MIC 5:3">ఇశ్రాయేలీయులతో చేరడానికి తిరిగి వస్తారు.<verse eid="MIC 5:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 5:4"/>ఆయన యెహోవా బలం పొంది</para>
  <para style="q2" vid="MIC 5:4">తన దేవుడైన యెహోవా నామ మహిమతో</para>
  <para style="q2" vid="MIC 5:4">లేచి తన మందను మేపుతాడు.</para>
  <para style="q1" vid="MIC 5:4">ఆయన మహాత్యం భూదిగంతాల వరకు వ్యాపిస్తుంది,</para>
  <para style="q2" vid="MIC 5:4">కాబట్టి వారు సురక్షితంగా నివసిస్తారు.<verse eid="MIC 5:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 5:5"/>అష్షూరు వారు దండెత్తి మన దేశంలోకి వచ్చి</para>
  <para style="q2" vid="MIC 5:5">మన కోటలలో ప్రవేశించేటప్పుడు,</para>
  <para style="q2" vid="MIC 5:5">ఆయన మన సమాధానం అవుతారు</para>
  <para style="q1" vid="MIC 5:5">మనం వారికి విరుద్ధంగా ఏడుగురు కాపరులను,</para>
  <para style="q2" vid="MIC 5:5">ఎనిమిది మంది నాయకులుగా నియమిస్తాము.<verse eid="MIC 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 5:6"/>వీరు ఖడ్గంతో అష్షూరు దేశాన్ని,</para>
  <para style="q2" vid="MIC 5:6">దూసిన ఖడ్గంతో నిమ్రోదు దేశాన్ని పరిపాలిస్తారు.</para>
  <para style="q1" vid="MIC 5:6">అష్షూరు వారు దండెత్తి మన సరిహద్దులను దాటి,</para>
  <para style="q2" vid="MIC 5:6">మన దేశాన్ని ఆక్రమించుకున్నప్పుడు</para>
  <para style="q2" vid="MIC 5:6">ఆయన మనల్ని రక్షిస్తారు.<verse eid="MIC 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 5:7"/>యాకోబు సంతానంలో మిగిలినవారు,</para>
  <para style="q2" vid="MIC 5:7">అనేక జనాల మధ్యలో,</para>
  <para style="q1" vid="MIC 5:7">యెహోవా కురిపించే మంచులా,</para>
  <para style="q2" vid="MIC 5:7">ఎవరి కోసం ఎదురుచూడకుండ</para>
  <para style="q1" vid="MIC 5:7">ఏ మనిషి మీద ఆధారపడకుండా</para>
  <para style="q2" vid="MIC 5:7">గడ్డి మీద కురిసే వానజల్లులా ఉంటారు.<verse eid="MIC 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 5:8"/>యాకోబు సంతానంలో మిగిలినవారు దేశాల మధ్య,</para>
  <para style="q2" vid="MIC 5:8">అనేక జనాల మధ్య,</para>
  <para style="q1" vid="MIC 5:8">అడవి మృగాలలో సింహంలా,</para>
  <para style="q2" vid="MIC 5:8">గొర్రెల మందలలో దూరి,</para>
  <para style="q1" vid="MIC 5:8">ఎవ్వరూ విడిపించలేనంతగా</para>
  <para style="q2" vid="MIC 5:8">వాటిని త్రొక్కి చీల్చే కొదమసింహంలా ఉంటారు.<verse eid="MIC 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 5:9"/>మీ హస్తం మీ విరోధుల మీద విజయం సాధిస్తుంది,</para>
  <para style="q2" vid="MIC 5:9">మీ శత్రువులందరూ నాశనమవుతారు.<verse eid="MIC 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MIC 5:10"/>యెహోవా ఇలా ప్రకటిస్తున్నారు, “ఆ దినాన”</para>
  <para style="q1" vid="MIC 5:10">“నేను మీ మధ్య నుండి మీ గుర్రాలను నాశనం చేస్తాను,</para>
  <para style="q2" vid="MIC 5:10">మీ రథాలను ధ్వంసం చేస్తాను.<verse eid="MIC 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 5:11"/>మీ దేశంలోని పట్టణాలను నాశనం చేస్తాను</para>
  <para style="q2" vid="MIC 5:11">మీ కోటలను పడగొడతాను,<verse eid="MIC 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 5:12"/>మీ మధ్య మంత్రవిద్య లేకుండా నాశనం చేస్తాను</para>
  <para style="q2" vid="MIC 5:12">ఇక ఎన్నడూ మీరు సోదె చెప్పరు.<verse eid="MIC 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 5:13"/>నేను మీ విగ్రహాలను,</para>
  <para style="q2" vid="MIC 5:13">మీ పవిత్ర రాళ్లను మీ మధ్య నుండి నిర్మూలిస్తాను;</para>
  <para style="q1" vid="MIC 5:13">ఇకపై మీరు ఎన్నడు</para>
  <para style="q2" vid="MIC 5:13">మీ చేతి పనులకు మ్రొక్కరు.<verse eid="MIC 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 5:14"/>నేను మీ పట్టణాలను పడగొట్టినప్పుడు,</para>
  <para style="q2" vid="MIC 5:14">మీ మధ్య నుండి అషేరా స్తంభాలను పెళ్లగిస్తాను.<verse eid="MIC 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 5:15"/>నా మాట వినని దేశాల మీద</para>
  <para style="q2" vid="MIC 5:15">కోపంతో, క్రోధంతో ప్రతీకారం తీసుకుంటాను.”<verse eid="MIC 5:15"/></para>
  <chapter eid="MIC 5"/>
  <chapter number="6" style="c" sid="MIC 6"/>
  <para style="s1">ఇశ్రాయేలుపై యెహోవా అభియోగం</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 6:1"/>యెహోవా చెప్పేది వినండి:</para>
  <para style="q1" vid="MIC 6:1">“మీరు నిలబడి, పర్వతాల ఎదుట నా వాదన వినిపించండి;</para>
  <para style="q2" vid="MIC 6:1">కొండలు మీరు చెప్పేది వినాలి.<verse eid="MIC 6:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 6:2"/>“పర్వతాల్లారా, యెహోవా చేసిన నేరారోపణ వినండి;</para>
  <para style="q2" vid="MIC 6:2">భూమికి నిత్యమైన పునాదుల్లారా, ఆలకించండి.</para>
  <para style="q1" vid="MIC 6:2">యెహోవా తన ప్రజలకు వ్యతిరేకంగా ఫిర్యాదు చేస్తున్నారు;</para>
  <para style="q2" vid="MIC 6:2">ఆయన ఇశ్రాయేలుపై అభియోగం మోపుతున్నారు.<verse eid="MIC 6:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 6:3"/>“నా ప్రజలారా! నేను మీకేం చేశాను?</para>
  <para style="q2" vid="MIC 6:3">నేను మిమ్మల్ని ఎలా కష్టపెట్టాను? నాకు జవాబివ్వండి.<verse eid="MIC 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 6:4"/>నేను మిమ్మల్ని ఈజిప్టు నుండి తీసుకువచ్చాను</para>
  <para style="q2" vid="MIC 6:4">మిమ్మల్ని దాస్యంలో ఉంచిన ఆ దేశం నుండి విడిపించాను.</para>
  <para style="q1" vid="MIC 6:4">మీకు దారి చూపడానికి</para>
  <para style="q2" vid="MIC 6:4">మోషే అహరోను మిర్యాములను పంపించాను.<verse eid="MIC 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 6:5"/>నా ప్రజలారా! మోయాబు రాజైన బాలాకు ఎలా కుట్ర చేశాడో,</para>
  <para style="q2" vid="MIC 6:5">బెయోరు కుమారుడైన బిలాము అతనికి ఎలా జవాబిచ్చాడో</para>
  <para style="q2" vid="MIC 6:5">జ్ఞాపకం చేసుకోండి.</para>
  <para style="q1" vid="MIC 6:5">యెహోవా నీతి క్రియలు మీరు గ్రహించేలా</para>
  <para style="q2" vid="MIC 6:5">షిత్తీము నుండి గిల్గాలు వరకు జరిగిన మీ ప్రయాణం జ్ఞాపకం చేసుకోండి.”<verse eid="MIC 6:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 6:6"/>ఏమి తీసుకుని నేను యెహోవా సన్నిధిలోకి రావాలి,</para>
  <para style="q2" vid="MIC 6:6">మహోన్నతుడైన దేవుని ఎదుట నమస్కరించాలి?</para>
  <para style="q1" vid="MIC 6:6">నేను దహనబలులను, ఏడాది దూడలను</para>
  <para style="q2" vid="MIC 6:6">ఆయన సన్నిధికి తీసుకురావాలా?<verse eid="MIC 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 6:7"/>వేల కొలది పొట్టేళ్ళూ,</para>
  <para style="q2" vid="MIC 6:7">పదివేల నదులంత నూనెను అర్పిస్తే యెహోవా సంతోషిస్తారా?</para>
  <para style="q1" vid="MIC 6:7">నా అతిక్రమం కోసం నా జ్యేష్ఠ కుమారున్ని,</para>
  <para style="q2" vid="MIC 6:7">నా పాపం కోసం నా గర్భఫలాన్ని అర్పించాలా?<verse eid="MIC 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 6:8"/>ఓ మనుష్యుడా, ఏది మంచిదో ఆయన నీకు చూపించారు.</para>
  <para style="q2" vid="MIC 6:8">యెహోవా నీ నుండి కోరేదేంటి?</para>
  <para style="q1" vid="MIC 6:8">న్యాయంగా ప్రవర్తించడం, కరుణను ప్రేమించడం,</para>
  <para style="q2" vid="MIC 6:8">వినయం<note caller="+" style="f"><char style="fr" closed="false">6:8 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">జ్ఞానం</char></note> కలిగి నీ దేవునితో కలిసి నడవడమే కదా.<verse eid="MIC 6:8"/></para>
  <para style="s1">ఇశ్రాయేలు అపరాధం శిక్ష</para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 6:9"/>వినండి! యెహోవా పట్టణానికి ఇలా ప్రకటన చేస్తున్నారు:</para>
  <para style="q2" vid="MIC 6:9">మీ నామానికి భయపడడమే జ్ఞానం,</para>
  <para style="q2" vid="MIC 6:9">“శిక్షను, దానిని విధించేవాని మాటలు వినండి.<verse eid="MIC 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 6:10"/>దుర్మార్గపు ఇల్లా, మీ అక్రమ సంపాదనలు,</para>
  <para style="q2" vid="MIC 6:10">అసహ్యకరమైన మీ తప్పుడు కొలతలు ఇంకా ఉన్నాయి కదా?<verse eid="MIC 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 6:11"/>తప్పుడు త్రాసు, మోసపు తూనిక రాళ్లున్న సంచి కలిగిన</para>
  <para style="q2" vid="MIC 6:11">వారిని నిర్దోషి అని నేను తీర్పు ఇవ్వాలా?<verse eid="MIC 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 6:12"/>మీ ధనవంతులు దౌర్జన్యం చేస్తున్నారు;</para>
  <para style="q2" vid="MIC 6:12">మీ నివాసులు అబద్ధికులు</para>
  <para style="q2" vid="MIC 6:12">వారి నాలుకలు కపటంగా మాట్లాడతాయి.<verse eid="MIC 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 6:13"/>కాబట్టి మీ పాపాల కారణంగా నేను మిమ్మల్ని</para>
  <para style="q2" vid="MIC 6:13">నాశనం చేసి నిర్మూలిస్తాను.<verse eid="MIC 6:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 6:14"/>మీరు తింటారు కాని తృప్తి చెందరు;</para>
  <para style="q2" vid="MIC 6:14">మీ కడుపులు ఇంకా ఖాళీగా ఉంటాయి.</para>
  <para style="q1" vid="MIC 6:14">మీరు కూడబెట్టుకుంటారు కాని ఏమి కాపాడుకోలేరు,</para>
  <para style="q2" vid="MIC 6:14">ఎందుకంటే మీరు భద్రపరచుకుంది నేను ఖడ్గానికి అప్పగిస్తాను.<verse eid="MIC 6:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 6:15"/>మీరు నాటుతారు కాని పంట కోయరు;</para>
  <para style="q2" vid="MIC 6:15">మీరు ఒలీవపండ్లను త్రొక్కుతారు కాని ఆ నూనెను వాడరు;</para>
  <para style="q2" vid="MIC 6:15">ద్రాక్షలను త్రొక్కుతారు కాని ద్రాక్షరసం త్రాగరు.<verse eid="MIC 6:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 6:16"/>మీరు ఒమ్రీ కట్టడాలను పాటించారు</para>
  <para style="q2" vid="MIC 6:16">అహాబు ఇంటివారి విధానాలన్నీ పాటించారు;</para>
  <para style="q2" vid="MIC 6:16">వారి సంప్రదాయాలను అనుసరించారు;</para>
  <para style="q1" vid="MIC 6:16">కాబట్టి నేను మిమ్మల్ని నాశనం చేస్తాను</para>
  <para style="q2" vid="MIC 6:16">ప్రజలు మిమ్మల్ని అపహాస్యం చేస్తారు;</para>
  <para style="q2" vid="MIC 6:16">మీరు నా ప్రజల నిందను భరిస్తారు.”<verse eid="MIC 6:16"/></para>
  <chapter eid="MIC 6"/>
  <chapter number="7" style="c" sid="MIC 7"/>
  <para style="s1">ఇశ్రాయేలు దుస్థితి</para>
  <para style="q1">
    <verse number="1" style="v" sid="MIC 7:1"/>ఏంటి నా దుస్థితి!</para>
  <para style="q1" vid="MIC 7:1">నా పరిస్థితి వేసవికాలపు పండ్లు ఏరుకునే వానిలా</para>
  <para style="q2" vid="MIC 7:1">ద్రాక్షతోట పరిగె సేకరించేవానిలా ఉంది;</para>
  <para style="q1" vid="MIC 7:1">తినడానికి ద్రాక్షపండ్ల గెల లేదు,</para>
  <para style="q2" vid="MIC 7:1">నేను ఆశించే క్రొత్త అంజూరపు పండ్లు లేవు.<verse eid="MIC 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="MIC 7:2"/>నమ్మకమైనవారు దేశంలో లేకుండా పోయారు;</para>
  <para style="q2" vid="MIC 7:2">యథార్థవంతుడు ఒక్కడూ లేడు.</para>
  <para style="q1" vid="MIC 7:2">అందరు రక్తం చిందించడానికి పొంచి ఉన్నారు;</para>
  <para style="q2" vid="MIC 7:2">వారు ఒకరిని ఒకరు వలలతో వేటాడతారు.<verse eid="MIC 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MIC 7:3"/>వారి రెండు చేతులు కీడు చేస్తాయి;</para>
  <para style="q2" vid="MIC 7:3">పాలకులు బహుమతులు కోరతారు,</para>
  <para style="q1" vid="MIC 7:3">న్యాయాధిపతులు లంచాలు పుచ్చుకుంటారు,</para>
  <para style="q2" vid="MIC 7:3">గొప్పవారు తమ కోరికను తెలియజేస్తారు.</para>
  <para style="q2" vid="MIC 7:3">వారంతా కలిసి కుట్ర చేస్తారు.<verse eid="MIC 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MIC 7:4"/>వారిలో మంచి వారు ముళ్ళపొద వంటివారు,</para>
  <para style="q2" vid="MIC 7:4">వారిలో అత్యంత యథార్థవంతులు ముండ్లకంచె కంటే ఘోరము.</para>
  <para style="q1" vid="MIC 7:4">దేవుడు మిమ్మల్ని దర్శించే రోజు,</para>
  <para style="q2" vid="MIC 7:4">మీ కాపరులు<note caller="+" style="f"><char style="fr" closed="false">7:4 </char><char style="ft" closed="false">ఇది ప్రవక్తలను సూచిస్తుంది</char></note> హెచ్చరించే రోజు వచ్చింది.</para>
  <para style="q2" vid="MIC 7:4">ఇప్పుడే మీరు కలవరపడే సమయము.<verse eid="MIC 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MIC 7:5"/>పొరుగువారిని నమ్మకండి;</para>
  <para style="q2" vid="MIC 7:5">స్నేహితుని మీద నమ్మకం పెట్టుకోకండి.</para>
  <para style="q1" vid="MIC 7:5">మీ కౌగిటిలో ఉండే స్త్రీ దగ్గర కూడా</para>
  <para style="q2" vid="MIC 7:5">మీ పెదవుల నుండి వచ్చే మాటలను కాచుకోండి.<verse eid="MIC 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MIC 7:6"/>కుమారుడు తండ్రిని నిర్లక్ష్యం చేస్తాడు,</para>
  <para style="q2" vid="MIC 7:6">తల్లి మీదికి కుమార్తె,</para>
  <para style="q1" vid="MIC 7:6">అత్త మీదికి తన కోడలు తిరగబడతారు,</para>
  <para style="q2" vid="MIC 7:6">సొంత ఇంటివారే వారికి శత్రువులవుతారు.<verse eid="MIC 7:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="MIC 7:7"/>నేనైతే యెహోవా వైపు నిరీక్షణతో చూస్తాను,</para>
  <para style="q2" vid="MIC 7:7">నా రక్షకుడైన దేవుని కోసం వేచి ఉంటాను;</para>
  <para style="q2" vid="MIC 7:7">నా దేవుడు నా ప్రార్ధన వింటారు.<verse eid="MIC 7:7"/></para>
  <para style="s1">ఇశ్రాయేలు తిరిగి లేస్తుంది</para>
  <para style="q1">
    <verse number="8" style="v" sid="MIC 7:8"/>నా విరోధీ, నా మీద అతిశయించకు,</para>
  <para style="q2" vid="MIC 7:8">నేను పడిపోయినా తిరిగి లేస్తాను.</para>
  <para style="q1" vid="MIC 7:8">నేను చీకటిలో కూర్చున్నా,</para>
  <para style="q2" vid="MIC 7:8">యెహోవా నాకు వెలుగై ఉంటారు.<verse eid="MIC 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MIC 7:9"/>నేను యెహోవాకు వ్యతిరేకంగా పాపం చేశాను కాబట్టి,</para>
  <para style="q2" vid="MIC 7:9">ఆయన నాకు న్యాయం తీర్చేవరకు</para>
  <para style="q1" vid="MIC 7:9">ఆయన నా పక్షాన ఉండే వరకు</para>
  <para style="q2" vid="MIC 7:9">నేను ఆయన కోపాగ్నిని భరిస్తాను.</para>
  <para style="q1" vid="MIC 7:9">ఆయన నన్ను వెలుగులోకి తీసుకువస్తారు,</para>
  <para style="q2" vid="MIC 7:9">నేను ఆయన నీతిని చూస్తాను.<verse eid="MIC 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MIC 7:10"/>అప్పుడు నా శత్రువు దాన్ని చూసి,</para>
  <para style="q2" vid="MIC 7:10">ఇలా జరగడం చూసి సిగ్గుపడుతుంది.</para>
  <para style="q1" vid="MIC 7:10">“నీ దేవుడైన యెహోవా ఎక్కడ?”</para>
  <para style="q2" vid="MIC 7:10">అని నాతో అన్న ఆమె</para>
  <para style="q1" vid="MIC 7:10">నా కళ్లు ఆమె పతనం చూస్తాయి;</para>
  <para style="q2" vid="MIC 7:10">ఇప్పుడు కూడా ఆమె వీధిలోని బురదలా</para>
  <para style="q2" vid="MIC 7:10">కాళ్లక్రింద త్రొక్కబడుతుంది.<verse eid="MIC 7:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="MIC 7:11"/>మీ గోడలు కట్టే రోజు వస్తుంది</para>
  <para style="q2" vid="MIC 7:11">మీ సరిహద్దులు విశాలపరిచే రోజు వస్తుంది.<verse eid="MIC 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MIC 7:12"/>ఆ రోజు ప్రజలు అష్షూరు నుండి</para>
  <para style="q2" vid="MIC 7:12">ఈజిప్టు పట్టణాల నుండి మీ దగ్గరకు వస్తారు,</para>
  <para style="q1" vid="MIC 7:12">ఈజిప్టు మొదలుకొని యూఫ్రటీసు వరకు,</para>
  <para style="q2" vid="MIC 7:12">సముద్రం నుండి సముద్రం వరకు</para>
  <para style="q2" vid="MIC 7:12">పర్వతం నుండి పర్వతం వరకు ఉన్న ప్రజలు వస్తారు.<verse eid="MIC 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MIC 7:13"/>భూనివాసులు చేసిన క్రియలకు ఫలితంగా</para>
  <para style="q2" vid="MIC 7:13">దేశం పాడవుతుంది.<verse eid="MIC 7:13"/></para>
  <para style="s1">ప్రార్ధన స్తుతి</para>
  <para style="q1">
    <verse number="14" style="v" sid="MIC 7:14"/>మీ చేతికర్రతో మీ ప్రజలను కాయండి,</para>
  <para style="q2" vid="MIC 7:14">వారు మీ వారసత్వపు మంద,</para>
  <para style="q1" vid="MIC 7:14">వారు అడవిలో ఒంటరిగా,</para>
  <para style="q2" vid="MIC 7:14">సారవంతమైన పచ్చికబయళ్లలో<note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">కర్మెలు మధ్య ప్రాంతం</char></note> నివసిస్తున్నారు.</para>
  <para style="q1" vid="MIC 7:14">పూర్వకాలంలో మేసినట్లు</para>
  <para style="q2" vid="MIC 7:14">వారిని బాషాను, గిలాదులో మేస్తారు.<verse eid="MIC 7:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="MIC 7:15"/>“మీరు ఈజిప్టు నుండి వచ్చిన రోజుల్లో చేసినట్లు,</para>
  <para style="q2" vid="MIC 7:15">నేను నా అద్భుతాలు వారికి చూపిస్తాను.”<verse eid="MIC 7:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="MIC 7:16"/>దేశాల ప్రజలు అది చూసి</para>
  <para style="q2" vid="MIC 7:16">తమ శక్తి కోల్పోయి సిగ్గుపడతారు.</para>
  <para style="q1" vid="MIC 7:16">వారు తమ చేతులతో నోరు మూసుకుంటారు,</para>
  <para style="q2" vid="MIC 7:16">వారి చెవులకు చెవుడు వస్తుంది.<verse eid="MIC 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="MIC 7:17"/>పాములా, నేల మీద ప్రాకే పురుగులా,</para>
  <para style="q2" vid="MIC 7:17">వారు ధూళిని నాకుతారు.</para>
  <para style="q1" vid="MIC 7:17">వారు తమ గుహల్లో నుండి వణకుతూ బయటకు వస్తారు;</para>
  <para style="q2" vid="MIC 7:17">వారు భయంతో మన దేవుడైన యెహోవా వైపు తిరుగుతారు,</para>
  <para style="q2" vid="MIC 7:17">నిన్ను బట్టి భయపడతారు.<verse eid="MIC 7:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MIC 7:18"/>మీలాంటి దేవుడెవరు?</para>
  <para style="q2" vid="MIC 7:18">మీరు మీ వారసత్వమైన వారిలో మిగిలిన వారి</para>
  <para style="q2" vid="MIC 7:18">పాపాలను మన్నించి, అతిక్రమాలను క్షమిస్తారు,</para>
  <para style="q1" vid="MIC 7:18">మీరు నిత్యం కోపంతో ఉండరు</para>
  <para style="q2" vid="MIC 7:18">కాని దయ చూపడంలో ఆనందిస్తారు.<verse eid="MIC 7:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="MIC 7:19"/>మీరు మళ్ళీ మమ్మల్ని కనికరిస్తారు;</para>
  <para style="q2" vid="MIC 7:19">మీరు మా పాపాలను అణగద్రొక్కుతారు,</para>
  <para style="q2" vid="MIC 7:19">మా అతిక్రమాలన్నిటిని సముద్రంలో లోతుల్లో పడవేస్తారు.<verse eid="MIC 7:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="MIC 7:20"/>మీరు పూర్వకాలంలో మా పూర్వికులకు</para>
  <para style="q2" vid="MIC 7:20">ప్రమాణం చేసిన విధంగా</para>
  <para style="q1" vid="MIC 7:20">యాకోబు పట్ల నమ్మకత్వాన్ని,</para>
  <para style="q2" vid="MIC 7:20">అబ్రాహాము పట్ల మారని ప్రేమ చూపుతారు.<verse eid="MIC 7:20"/></para>
  <chapter eid="MIC 7"/>
</usx>
