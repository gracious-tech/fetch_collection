<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JOL" style="id">- Biblica® Open Telugu Contemporary Version</book>
  <para style="h">యోవేలు</para>
  <para style="toc1">యోవేలు ప్రవచనం</para>
  <para style="toc2">యోవేలు</para>
  <para style="toc3">యోవేలు</para>
  <para style="mt1">యోవేలు</para>
  <para style="mt2">ప్రవచనం</para>
  <chapter number="1" style="c" sid="JOL 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JOL 1:1"/>ఇది పెతూయేలు కుమారుడైన యోవేలుకు వచ్చిన యెహోవా వాక్కు.<verse eid="JOL 1:1"/></para>
  <para style="b"/>
  <para style="s1">మిడతల దండు</para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 1:2"/>పెద్దలారా, దీనిని వినండి;</para>
  <para style="q2" vid="JOL 1:2">దేశ నివాసులారా, మీరంతా ఆలకించండి.</para>
  <para style="q1" vid="JOL 1:2">ఇప్పుడు జరుగుతున్నది, మీ కాలంలో గాని,</para>
  <para style="q2" vid="JOL 1:2">మీ పూర్వికుల కాలంలో గాని ఎప్పుడైనా జరిగిందా?<verse eid="JOL 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 1:3"/>ఈ సంగతి మీ పిల్లలకు చెప్పండి,</para>
  <para style="q2" vid="JOL 1:3">మీ పిల్లలు తమ పిల్లలకు చెప్పాలి,</para>
  <para style="q2" vid="JOL 1:3">వారి పిల్లలు రాబోయే తరం వారికి చెప్పాలి.<verse eid="JOL 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 1:4"/>మిడతల గుంపు విడిచిపెట్టిన దానిని</para>
  <para style="q2" vid="JOL 1:4">పెద్ద మిడతలు తినేశాయి;</para>
  <para style="q1" vid="JOL 1:4">పెద్ద మిడతలు విడిచిపెట్టిన దానిని</para>
  <para style="q2" vid="JOL 1:4">చిన్న మిడతలు తినేశాయి;</para>
  <para style="q1" vid="JOL 1:4">చిన్న మిడతలు విడిచిపెట్టిన దానిని</para>
  <para style="q2" vid="JOL 1:4">ఇతర మిడతలు<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">ఈ నాలుగు హెబ్రీ పదాల యొక్క ఖచ్చితమైన అర్థం తెలియదు</char></note> తినేశాయి.<verse eid="JOL 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 1:5"/>త్రాగుబోతులారా, మేల్కొని ఏడవండి!</para>
  <para style="q2" vid="JOL 1:5">ద్రాక్షరసం త్రాగే మీరందరు విలపించండి;</para>
  <para style="q1" vid="JOL 1:5">క్రొత్త ద్రాక్షరసం కోసం విలపించండి,</para>
  <para style="q2" vid="JOL 1:5">ఎందుకంటే అది మీ నోటి పెదవుల దగ్గర నుండి తీసివేయబడింది.<verse eid="JOL 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 1:6"/>లెక్కలేనంత గొప్ప సైన్యం ఉన్న ఒక దేశం,</para>
  <para style="q2" vid="JOL 1:6">నా దేశాన్ని ఆక్రమించింది;</para>
  <para style="q1" vid="JOL 1:6">దానికి సింహం పళ్లు ఉన్నాయి</para>
  <para style="q2" vid="JOL 1:6">ఆడసింహం కోరలు ఉన్నాయి.<verse eid="JOL 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 1:7"/>అది నా ద్రాక్ష చెట్లను పాడుచేసింది</para>
  <para style="q2" vid="JOL 1:7">నా అంజూర చెట్లను నాశనం చేసింది.</para>
  <para style="q1" vid="JOL 1:7">అది వాటి బెరడు ఒలిచి పడవేసినందుకు,</para>
  <para style="q2" vid="JOL 1:7">చెట్ల కొమ్మలు తెల్లగా కనిపించాయి.<verse eid="JOL 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 1:8"/>తన యవ్వన భర్తను కోల్పోయి గోనెపట్ట కట్టుకుని,</para>
  <para style="q2" vid="JOL 1:8">దుఃఖించే కన్యలా దుఃఖించండి.<verse eid="JOL 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 1:9"/>భోజనార్పణలు పానార్పణలు</para>
  <para style="q2" vid="JOL 1:9">యెహోవా మందిరంలోకి రాకుండ నిలిచిపోయాయి.</para>
  <para style="q1" vid="JOL 1:9">యెహోవ ఎదుట సేవచేసే</para>
  <para style="q2" vid="JOL 1:9">యాజకులు శోకంలో ఉన్నారు.<verse eid="JOL 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 1:10"/>పొలాలు పాడయ్యాయి,</para>
  <para style="q2" vid="JOL 1:10">నేల ఎండిపోయింది;</para>
  <para style="q1" vid="JOL 1:10">ధాన్యం నాశనమైంది,</para>
  <para style="q2" vid="JOL 1:10">క్రొత్త ద్రాక్షరసం ఎండిపోయింది,</para>
  <para style="q2" vid="JOL 1:10">ఒలీవనూనె అయిపోయింది.<verse eid="JOL 1:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 1:11"/>రైతులారా, నిరాశ చెందండి,</para>
  <para style="q2" vid="JOL 1:11">ద్రాక్షలను పెంచే వారలారా, విలపించండి,</para>
  <para style="q1" vid="JOL 1:11">గోధుమ, యవల కోసం దుఃఖించండి,</para>
  <para style="q2" vid="JOL 1:11">ఎందుకంటే పొలం పంట పాడైపోయింది.<verse eid="JOL 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 1:12"/>ద్రాక్ష ఎండిపోయింది</para>
  <para style="q2" vid="JOL 1:12">అంజూర చెట్టు వాడిపోయింది;</para>
  <para style="q1" vid="JOL 1:12">దానిమ్మ, తాటి చెట్టు, ఆపిల్<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="ft" closed="false">లేదా బహుశ </char><char style="fqa" closed="false">నేరేడు</char></note> పండు చెట్లు,</para>
  <para style="q2" vid="JOL 1:12">పొలం లోని చెట్లన్నీ ఎండిపోయాయి.</para>
  <para style="q1" vid="JOL 1:12">ఖచ్చితంగా మనుష్యులకు ఆనందం</para>
  <para style="q2" vid="JOL 1:12">లేకుండా పోయింది.<verse eid="JOL 1:12"/></para>
  <para style="s1">విలపించండి అని పిలుపు</para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 1:13"/>యాజకులారా, మీరు గోనెపట్ట కట్టుకుని ఏడవండి;</para>
  <para style="q2" vid="JOL 1:13">బలిపీఠం దగ్గర సేవ చేసేవారలారా, మీరు రోదించండి.</para>
  <para style="q1" vid="JOL 1:13">నా దేవుని ఎదుట సేవ చేసేవారలారా,</para>
  <para style="q2" vid="JOL 1:13">రండి, రాత్రంత గోనెపట్ట కట్టుకుని గడపండి;</para>
  <para style="q1" vid="JOL 1:13">ఎందుకంటే దేవుని మందిరంలోకి</para>
  <para style="q2" vid="JOL 1:13">భోజనార్పణలు పానార్పణలు రాకుండ నిలిచిపోయాయి.<verse eid="JOL 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 1:14"/>పరిశుద్ధ ఉపవాసం ప్రకటించండి;</para>
  <para style="q2" vid="JOL 1:14">పరిశుద్ధ సభను నిర్వహించండి.</para>
  <para style="q1" vid="JOL 1:14">మీ దేవుడైన యెహోవా మందిరానికి వచ్చి,</para>
  <para style="q2" vid="JOL 1:14">యెహోవాకు మొరపెట్టడానికి</para>
  <para style="q1" vid="JOL 1:14">పెద్దలను పిలిపించండి,</para>
  <para style="q2" vid="JOL 1:14">దేశవాసులందరిని పిలిపించండి.<verse eid="JOL 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 1:15"/>యెహోవా దినం దగ్గరపడింది;</para>
  <para style="q2" vid="JOL 1:15">అయ్యో! ఆ దినం</para>
  <para style="q2" vid="JOL 1:15">నాశనంలా సర్వశక్తుని నుండి వస్తుంది.<verse eid="JOL 1:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 1:16"/>మన కళ్లెదుటే</para>
  <para style="q2" vid="JOL 1:16">దేవుని మందిరంలో</para>
  <para style="q1" vid="JOL 1:16">ఆహారం నిలిపివేయబడలేదా</para>
  <para style="q2" vid="JOL 1:16">సంతోషం ఆనందం నిలిచిపోలేదా?<verse eid="JOL 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 1:17"/>విత్తనాలు మట్టిగడ్డల క్రింద కుళ్లిపోతున్నాయి.</para>
  <para style="q2" vid="JOL 1:17">ధాన్యం ఎండిపోవడంతో,</para>
  <para style="q1" vid="JOL 1:17">గిడ్డంగులు పాడైపోయాయి</para>
  <para style="q2" vid="JOL 1:17">ధాన్యాగారాలు పడగొట్టబడ్డాయి.<verse eid="JOL 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 1:18"/>తినడానికి మేత లేక</para>
  <para style="q2" vid="JOL 1:18">పశువులు ఎంతగానో మూలుగుతున్నాయి!</para>
  <para style="q1" vid="JOL 1:18">మందలు అటూ ఇటూ తిరుగుతున్నాయి;</para>
  <para style="q2" vid="JOL 1:18">గొర్రెల మందలు కూడా శిక్షను అనుభవిస్తున్నాయి.<verse eid="JOL 1:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 1:19"/>యెహోవా మీకు నేను మొరపెడుతున్నాను,</para>
  <para style="q2" vid="JOL 1:19">ఎందుకంటే అరణ్యంలో పచ్చికబయళ్లను అగ్ని కాల్చివేసింది</para>
  <para style="q2" vid="JOL 1:19">పొలం లోని చెట్లన్నిటిని మంటలు కాల్చివేశాయి.<verse eid="JOL 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 1:20"/>కాలువలు ఎండిపోయాయి;</para>
  <para style="q2" vid="JOL 1:20">అరణ్యంలో అగ్ని పచ్చికబయళ్లను కాల్చివేసింది</para>
  <para style="q2" vid="JOL 1:20">మీ కోసం అడవి జంతువులు కూడా దాహంతో ఉన్నాయి.<verse eid="JOL 1:20"/></para>
  <chapter eid="JOL 1"/>
  <chapter number="2" style="c" sid="JOL 2"/>
  <para style="s1">మిడతల సైన్యం</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 2:1"/>సీయోనులో బూర ఊదండి;</para>
  <para style="q2" vid="JOL 2:1">నా పరిశుద్ధ పర్వతం మీద నినాదాలు చేయండి.</para>
  <para style="b" vid="JOL 2:1"/>
  <para style="q1" vid="JOL 2:1">యెహోవా దినం రాబోతుంది కాబట్టి,</para>
  <para style="q2" vid="JOL 2:1">దేశ నివాసులంతా వణకాలి,</para>
  <para style="q1" vid="JOL 2:1">ఆ దినం సమీపంగా ఉంది.<verse eid="JOL 2:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="JOL 2:2"/>అది దట్టమైన చీకటి ఉండే దినం,</para>
  <para style="q2" vid="JOL 2:2">అది కారు మబ్బులు గాఢాంధకారం ఉండే దినం,</para>
  <para style="q1" vid="JOL 2:2">పర్వతాలమీద ఉదయకాంతి ప్రసరించినట్టు,</para>
  <para style="q2" vid="JOL 2:2">బలమైన మహా గొప్ప సైన్యం వస్తుంది,</para>
  <para style="q1" vid="JOL 2:2">అలాంటివి పూర్వకాలంలో ఎన్నడూ లేవు,</para>
  <para style="q2" vid="JOL 2:2">ఇకమీదట రాబోయే తరాలకు ఉండవు.<verse eid="JOL 2:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 2:3"/>వాటి ముందు అగ్ని మండుతూ ఉంది,</para>
  <para style="q2" vid="JOL 2:3">వాటి వెనుక మంటలు మండుతూ ఉన్నాయి.</para>
  <para style="q1" vid="JOL 2:3">అవి రాకముందు భూమి ఏదెను తోటలా ఉంది,</para>
  <para style="q2" vid="JOL 2:3">అవి వచ్చిన తర్వాత ఎండిన ఎడారిలా మారింది</para>
  <para style="q2" vid="JOL 2:3">ఏదీ వాటినుండి తప్పించుకోలేదు.<verse eid="JOL 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JOL 2:4"/>అవి గుర్రాల్లా కనిపిస్తున్నాయి;</para>
  <para style="q2" vid="JOL 2:4">సైనికుల గుర్రాల్లా అవి పరుగెడుతున్నాయి.<verse eid="JOL 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JOL 2:5"/>రథాలు కదిలే ధ్వనిలా,</para>
  <para style="q2" vid="JOL 2:5">అగ్నిజ్వాలలు కాల్చుతున్న శబ్దంలా,</para>
  <para style="q1" vid="JOL 2:5">యుద్ధానికి సిద్ధమైన మహా సైన్యంలా,</para>
  <para style="q2" vid="JOL 2:5">అవి పర్వత శిఖరాల మీద దూకుతున్నాయి,<verse eid="JOL 2:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="JOL 2:6"/>వాటిని చూసి ప్రజలు వేదన చెందుతున్నారు,</para>
  <para style="q2" vid="JOL 2:6">అందరి ముఖాలు పాలిపోతున్నాయి.<verse eid="JOL 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="JOL 2:7"/>అవి వీరుల్లా ముందుకు వస్తున్నాయి,</para>
  <para style="q2" vid="JOL 2:7">సైనికుల్లా అవి గోడలెక్కి వస్తున్నాయి.</para>
  <para style="q1" vid="JOL 2:7">అవి అటూ ఇటూ తిరుగకుండా,</para>
  <para style="q2" vid="JOL 2:7">తిన్నగా నడుస్తున్నాయి.<verse eid="JOL 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="JOL 2:8"/>ఒక దానినొకటి త్రోసుకోకుండా,</para>
  <para style="q2" vid="JOL 2:8">అన్నీ నేరుగా ముందుకు వస్తున్నాయి.</para>
  <para style="q1" vid="JOL 2:8">వాటికి ఆయుధాలు ఎదురుపడినా,</para>
  <para style="q2" vid="JOL 2:8">అవి వరుస మాత్రం తప్పవు.<verse eid="JOL 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 2:9"/>అవి పట్టణం మీదికి దూసుకు వస్తాయి.</para>
  <para style="q2" vid="JOL 2:9">గోడ మీద పరుగెత్తుతూ వస్తాయి.</para>
  <para style="q1" vid="JOL 2:9">దొంగలు కిటికీల నుండి చొరబడినట్లు,</para>
  <para style="q2" vid="JOL 2:9">అవి ఇళ్ళలోనికి దూరుతున్నాయి.<verse eid="JOL 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 2:10"/>వాటికి ముందు భూమి కంపిస్తుంది,</para>
  <para style="q2" vid="JOL 2:10">ఆకాశాలు వణకుతాయి,</para>
  <para style="q1" vid="JOL 2:10">సూర్యచంద్రులకు చీకటి కమ్ముతుంది.</para>
  <para style="q2" vid="JOL 2:10">నక్షత్రాలు ఇక ప్రకాశించవు.<verse eid="JOL 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 2:11"/>యెహోవా తన సైన్యాన్ని నడిపిస్తూ</para>
  <para style="q2" vid="JOL 2:11">ఉరుములా గర్జిస్తారు;</para>
  <para style="q1" vid="JOL 2:11">ఆయన బలగాలు లెక్కకు మించినవి,</para>
  <para style="q2" vid="JOL 2:11">ఆయన ఆజ్ఞకు లోబడే సైన్యం గొప్పది,</para>
  <para style="q1" vid="JOL 2:11">యెహోవా దినం గొప్పది;</para>
  <para style="q2" vid="JOL 2:11">అది భయంకరమైనది,</para>
  <para style="q2" vid="JOL 2:11">దాన్ని ఎవరు తట్టుకోగలరు?<verse eid="JOL 2:11"/></para>
  <para style="s1">మీ హృదయాన్ని చీల్చుకోండి</para>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 2:12"/>యెహోవా ఇలా ప్రకటిస్తున్నారు,</para>
  <para style="q2" vid="JOL 2:12">“ఇప్పుడైనా ఉపవాసముండి ఏడుస్తూ దుఃఖిస్తూ</para>
  <para style="q2" vid="JOL 2:12">మీ హృదయమంతటితో నా దగ్గరకు రండి.”<verse eid="JOL 2:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 2:13"/>మీ వస్త్రాలను కాదు,</para>
  <para style="q2" vid="JOL 2:13">మీ హృదయాలను చీల్చుకుని,</para>
  <para style="q1" vid="JOL 2:13">మీ దేవుడైన యెహోవా దగ్గరకు తిరిగి రండి,</para>
  <para style="q2" vid="JOL 2:13">ఆయన కృపా కనికరం గలవాడు,</para>
  <para style="q1" vid="JOL 2:13">త్వరగా కోప్పడడు, మారని ప్రేమగలవాడు</para>
  <para style="q2" vid="JOL 2:13">ఆయన జాలిపడుతూ విపత్తును పంపించకుండా ఉంటారు.<verse eid="JOL 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 2:14"/>ఆయన మీ వైపు తిరిగి మనస్సు మార్చుకుంటారేమో,</para>
  <para style="q2" vid="JOL 2:14">ఆయన మిమ్మల్ని ఆశీర్వదించవచ్చు,</para>
  <para style="q1" vid="JOL 2:14">మళ్ళీ మీరు మీ దేవుడైన యెహోవాకు</para>
  <para style="q2" vid="JOL 2:14">భోజనార్పణలు, పానార్పణలు తెస్తారేమో, ఎవరికి తెలుసు?<verse eid="JOL 2:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 2:15"/>సీయోనులో బూర ఊదండి,</para>
  <para style="q2" vid="JOL 2:15">పరిశుద్ధ ఉపవాసం ప్రకటించండి,</para>
  <para style="q2" vid="JOL 2:15">పరిశుద్ధ సభకు ప్రజలను పిలువండి.<verse eid="JOL 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 2:16"/>ప్రజలను సమకూర్చండి,</para>
  <para style="q2" vid="JOL 2:16">సమావేశాన్ని ప్రతిష్ఠించండి;</para>
  <para style="q1" vid="JOL 2:16">పెద్దలను రప్పించండి,</para>
  <para style="q2" vid="JOL 2:16">పిల్లలను సమకూర్చండి,</para>
  <para style="q2" vid="JOL 2:16">చంటి పిల్లలను కూడా తీసుకురండి.</para>
  <para style="q1" vid="JOL 2:16">పెళ్ళికుమారుడు తన గదిని</para>
  <para style="q2" vid="JOL 2:16">పెళ్ళికుమార్తె తన పెద్ద గదిని విడిచి రావాలి.<verse eid="JOL 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 2:17"/>యెహోవా ఎదుట సేవచేసే యాజకులు</para>
  <para style="q2" vid="JOL 2:17">మంటపానికి బలిపీఠానికి మధ్య నిలబడి ఏడ్వాలి.</para>
  <para style="q1" vid="JOL 2:17">వారు, “యెహోవా! మీ ప్రజలను కనికరించండి.</para>
  <para style="q2" vid="JOL 2:17">మీ స్వాస్థ్యమైన వారిని అవమాన పడనివ్వకండి</para>
  <para style="q2" vid="JOL 2:17">వారు దేశాల మధ్య హేళన చేయబడకూడదు.</para>
  <para style="q1" vid="JOL 2:17">‘వీరి దేవుడు ఎక్కడ?’</para>
  <para style="q2" vid="JOL 2:17">అని ప్రజలు ఎందుకు అనుకోవాలి?”<verse eid="JOL 2:17"/></para>
  <para style="s1">యెహోవా సమాధానం</para>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 2:18"/>అప్పుడు యెహోవా తన దేశంపట్ల ఆసక్తి చూపి,</para>
  <para style="q2" vid="JOL 2:18">ప్రజలను కనికరించారు.<verse eid="JOL 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JOL 2:19"/>యెహోవా వారికి ఇలా జవాబిచ్చారు:</para>
  <para style="q1" vid="JOL 2:19">“నేను మిమ్మల్ని పూర్తిగా తృప్తిపరచడానికి,</para>
  <para style="q2" vid="JOL 2:19">ధాన్యం, క్రొత్త ద్రాక్షరసం, ఒలీవనూనె పంపుతున్నాను;</para>
  <para style="q1" vid="JOL 2:19">ఇక ఎన్నడూ మిమ్మల్ని</para>
  <para style="q2" vid="JOL 2:19">దేశాల్లో అవమానానికి గురిచేయను.<verse eid="JOL 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 2:20"/>“నేను ఉత్తర దిక్కునుండి వచ్చే సైన్యాన్ని మీకు దూరంగా తరిమివేస్తాను.</para>
  <para style="q2" vid="JOL 2:20">ఎండిపోయిన, నిస్సారమైన ప్రాంతానికి దానిని పంపివేస్తాను;</para>
  <para style="q1" vid="JOL 2:20">తూర్పు వైపున్న దాని సైన్యం మృత సముద్రంలో మునిగిపోతుంది,</para>
  <para style="q2" vid="JOL 2:20">పశ్చిమ వైపున్న దాని సైన్యం మధ్యధరా సముద్రంలో మునిగిపోతుంది.</para>
  <para style="q1" vid="JOL 2:20">అది కంపు కొడుతుంది,</para>
  <para style="q2" vid="JOL 2:20">దాని దుర్వాసన లేస్తుంది.”</para>
  <para style="b" vid="JOL 2:20"/>
  <para style="q1" vid="JOL 2:20">నిజంగా ఆయన గొప్పకార్యాలు చేశారు!<verse eid="JOL 2:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="JOL 2:21"/>యూదా దేశమా, భయపడకు;</para>
  <para style="q2" vid="JOL 2:21">సంతోషించు, ఆనందించు.</para>
  <para style="q1" vid="JOL 2:21">నిజంగా యెహోవా గొప్పకార్యాలు చేశారు!<verse eid="JOL 2:21"/></para>
  <para style="q2">
    <verse number="22" style="v" sid="JOL 2:22"/>అడవి జంతువులారా, భయపడకండి,</para>
  <para style="q2" vid="JOL 2:22">ఎందుకంటే అరణ్యంలో పచ్చికబయళ్లు పచ్చగా మారుతున్నాయి.</para>
  <para style="q1" vid="JOL 2:22">చెట్లు తమ ఫలాలు ఇస్తాయి.</para>
  <para style="q2" vid="JOL 2:22">అంజూర చెట్లు, ద్రాక్షచెట్లు సమృద్ధిగా ఫలిస్తాయి.<verse eid="JOL 2:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="JOL 2:23"/>సీయోను ప్రజలారా, సంతోషించండి,</para>
  <para style="q2" vid="JOL 2:23">మీ దేవుడైన యెహోవాను బట్టి ఆనందించండి,</para>
  <para style="q1" vid="JOL 2:23">ఆయన నమ్మదగినవారు కాబట్టి,</para>
  <para style="q2" vid="JOL 2:23">ఆయన మీకు తొలకరి వర్షం ఇచ్చారు.</para>
  <para style="q1" vid="JOL 2:23">ఆయన సమృద్ధి వర్షాలు పంపిస్తారు,</para>
  <para style="q2" vid="JOL 2:23">ఆయన ముందు పంపినట్లు తొలకరి వర్షం, కడవరి వర్షం పంపిస్తారు.<verse eid="JOL 2:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="JOL 2:24"/>నూర్పిడి కళ్ళాలు ధాన్యంతో నిండి ఉంటాయి,</para>
  <para style="q2" vid="JOL 2:24">క్రొత్త ద్రాక్షరసం, నూనెతో గానుగ తొట్లు పొర్లిపారుతాయి.<verse eid="JOL 2:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="JOL 2:25"/>“నేను మీ మధ్యకు పంపిన నా గొప్ప సైన్యం</para>
  <para style="q2" vid="JOL 2:25">పెద్ద మిడతలు, చిన్న మిడతలు,</para>
  <para style="q2" vid="JOL 2:25">ఇతర మిడతలు, మిడతల గుంపులు</para>
  <para style="q1" vid="JOL 2:25">తినేసిన సంవత్సరాల పంటను నేను తిరిగి మీకు ఇస్తాను.<verse eid="JOL 2:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="JOL 2:26"/>మీరు కడుపునిండా తిని తృప్తి పొందేవరకు మీకు సమృద్ధి ఉంటుంది,</para>
  <para style="q2" vid="JOL 2:26">మీ కోసం అద్భుతాలు చేసిన</para>
  <para style="q2" vid="JOL 2:26">మీ దేవుడైన యెహోవా నామాన్ని మీరు స్తుతిస్తారు;</para>
  <para style="q1" vid="JOL 2:26">ఇక మరెన్నడు నా ప్రజలు సిగ్గుపడరు.<verse eid="JOL 2:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="JOL 2:27"/>అప్పుడు నేను ఇశ్రాయేలీయుల మధ్యలో ఉన్నానని,</para>
  <para style="q2" vid="JOL 2:27">నేను మీ దేవుడైన యెహోవానని,</para>
  <para style="q2" vid="JOL 2:27">వేరే దేవుడు ఎవరూ లేరని మీరు తెలుసుకుంటారు;</para>
  <para style="q1" vid="JOL 2:27">ఇక మరెన్నడు నా ప్రజలు సిగ్గుపడరు.<verse eid="JOL 2:27"/></para>
  <para style="s1">యెహోవా దినం</para>
  <para style="q1">
    <verse number="28" style="v" sid="JOL 2:28"/>“ఆ తర్వాత</para>
  <para style="q2" vid="JOL 2:28">నేను ప్రజలందరి మీద నా ఆత్మను కుమ్మరిస్తాను.</para>
  <para style="q1" vid="JOL 2:28">మీ కుమారులు, కుమార్తెలు ప్రవచిస్తారు,</para>
  <para style="q2" vid="JOL 2:28">మీ వృద్ధులు కలలు కంటారు,</para>
  <para style="q2" vid="JOL 2:28">మీ యువకులు దర్శనాలు చూస్తారు.<verse eid="JOL 2:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="JOL 2:29"/>ఆ రోజుల్లో నా సేవకుల మీద, సేవకురాండ్ర మీద కూడా</para>
  <para style="q2" vid="JOL 2:29">నా ఆత్మను కుమ్మరిస్తాను.<verse eid="JOL 2:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="JOL 2:30"/>నేను ఆకాశంలో అద్భుతాలను,</para>
  <para style="q2" vid="JOL 2:30">భూమి మీద</para>
  <para style="q2" vid="JOL 2:30">రక్తం, అగ్ని, గొప్ప పొగను చూపిస్తాను.<verse eid="JOL 2:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="JOL 2:31"/>యెహోవా భయంకరమైన మహాదినం రాకముందు,</para>
  <para style="q2" vid="JOL 2:31">సూర్యుడు చీకటిగా,</para>
  <para style="q2" vid="JOL 2:31">చంద్రుడు రక్తంగా మారుతాడు.<verse eid="JOL 2:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="JOL 2:32"/>యెహోవా పేరట మొరపెట్టిన</para>
  <para style="q2" vid="JOL 2:32">ప్రతి ఒక్కరూ రక్షింపబడతారు;</para>
  <para style="q1" vid="JOL 2:32">యెహోవా చెప్పినట్టే, సీయోను పర్వతం మీద,</para>
  <para style="q2" vid="JOL 2:32">యెరూషలేములో విడుదల ఉంటుంది,</para>
  <para style="q1" vid="JOL 2:32">ఎవరినైతే యెహోవా పిలుచుకుంటారో,</para>
  <para style="q2" vid="JOL 2:32">వారు రక్షింపబడతారు.<verse eid="JOL 2:32"/></para>
  <chapter eid="JOL 2"/>
  <chapter number="3" style="c" sid="JOL 3"/>
  <para style="s1">దేశాలకు తీర్పు</para>
  <para style="q1">
    <verse number="1" style="v" sid="JOL 3:1"/>“ఆ దినాల్లో ఆ కాలంలో,</para>
  <para style="q2" vid="JOL 3:1">నేను యూదా, యెరూషలేము వారిని తిరిగి రప్పించినప్పుడు,<verse eid="JOL 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="JOL 3:2"/>నేను దేశాలన్నిటిని సమకూర్చి,</para>
  <para style="q2" vid="JOL 3:2">యెహోషాపాతు<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="fq" closed="false">యెహోషాపాతు </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">యెహోవా తీర్పు తీర్చును</char><char style="ft" closed="false">; <char style="xt" link-href="JOL 3:12"><ref loc="JOL 3:12">12</ref></char> వచనంలో కూడా</char></note> లోయలోకి నడిపిస్తాను.</para>
  <para style="q1" vid="JOL 3:2">నా స్వాస్థ్యమైన ఇశ్రాయేలీయులకు వారు చేసిన దానిని బట్టి,</para>
  <para style="q2" vid="JOL 3:2">అక్కడ వారికి న్యాయ విచారణ జరిగిస్తాను,</para>
  <para style="q1" vid="JOL 3:2">ఎందుకంటే వారు నా ప్రజలను దేశాల్లో చెదరగొట్టారు</para>
  <para style="q2" vid="JOL 3:2">నా దేశాన్ని విభజించారు.<verse eid="JOL 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JOL 3:3"/>వారు నా ప్రజల కోసం చీట్లు వేసి</para>
  <para style="q2" vid="JOL 3:3">అబ్బాయిలను ఇచ్చి వేశ్యలను తీసుకున్నారు.</para>
  <para style="q2" vid="JOL 3:3">అమ్మాయిలను అమ్మి ద్రాక్షరసం కొన్నారు.<verse eid="JOL 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JOL 3:4"/>“తూరూ, సీదోనూ, ఫిలిష్తియా ప్రాంతాలందరూ, నా మీద మీకున్న వ్యతిరేకత ఏంటి? నేను చేసిన దానికి నాకు ప్రతీకారం చేస్తున్నారా? ఒకవేళ మీరు నాకు ప్రతీకారం చేస్తే, మీరు చేసిన దాన్ని త్వరలోనే, చాలా వేగంగా మీ తల మీదికి రప్పిస్తాను. <verse eid="JOL 3:4"/><verse number="5" style="v" sid="JOL 3:5"/>ఎందుకంటే మీరు నా వెండి బంగారాలను తీసుకెళ్లారు, నా శ్రేష్ఠమైన వస్తువులను మీ గుళ్ళకు<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">భవనాలకు</char></note> తీసుకెళ్లారు. <verse eid="JOL 3:5"/><verse number="6" style="v" sid="JOL 3:6"/>యూదా, యెరూషలేము ప్రజలు తమ ప్రాంతానికి దూరం ఉండాలని వారిని గ్రీకులకు<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="ft" closed="false">హెబ్రీలో </char><char style="fqa" closed="false">యావాను ప్రజలకు</char></note> అమ్మివేశారు.<verse eid="JOL 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JOL 3:7"/>“చూడండి, మీరు వారిని అమ్మి వేసిన స్థలాల నుండి వారిని రప్పిస్తాను. మీరు చేసిన దాన్ని మీ తల మీదికే రప్పిస్తాను. <verse eid="JOL 3:7"/><verse number="8" style="v" sid="JOL 3:8"/>నేను మీ కుమారులను, కుమార్తెలను యూదా ప్రజలకు అమ్ముతాను, వారు దూర దేశస్థులైన షెబాయీయులకు వారిని అమ్మివేస్తారు.” యెహోవా చెప్పింది ఇదే.<verse eid="JOL 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JOL 3:9"/>దేశాల మధ్య ఈ విషయం చాటించండి,</para>
  <para style="q2" vid="JOL 3:9">యుద్ధానికి సిద్ధపడండి!</para>
  <para style="q1" vid="JOL 3:9">వీరులను పురికొల్పండి,</para>
  <para style="q2" vid="JOL 3:9">పోరాడేవారందరు సమకూడి వచ్చి దాడి చేయాలి.<verse eid="JOL 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="JOL 3:10"/>మీ నాగటి నక్కులను సాగగొట్టి ఖడ్గాలు చేయండి,</para>
  <para style="q2" vid="JOL 3:10">మడ్డికత్తులను సాగగొట్టి ఈటెలుగా చేయండి.</para>
  <para style="q1" vid="JOL 3:10">“నేను బలవంతున్ని!”</para>
  <para style="q2" vid="JOL 3:10">అని బలహీనులు అనుకోవాలి.<verse eid="JOL 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="JOL 3:11"/>ప్రతి వైపు ఉన్న అన్ని దేశాల్లారా, త్వరగా రండి,</para>
  <para style="q2" vid="JOL 3:11">అక్కడ సమకూడండి.</para>
  <para style="b" vid="JOL 3:11"/>
  <para style="q1" vid="JOL 3:11">యెహోవా, మీ వీరులను తీసుకురండి!<verse eid="JOL 3:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="JOL 3:12"/>“దేశాలు లేవాలి;</para>
  <para style="q2" vid="JOL 3:12">అవి యెహోషాపాతు లోయ వైపు వెళ్లాలి</para>
  <para style="q1" vid="JOL 3:12">నలుదిశల ఉన్న అన్ని దేశాలకు</para>
  <para style="q2" vid="JOL 3:12">తీర్పు తీర్చడానికి నేను అక్కడ కూర్చుంటాను.<verse eid="JOL 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="JOL 3:13"/>పంట పండింది కాబట్టి,</para>
  <para style="q2" vid="JOL 3:13">కొడవలి తిప్పండి,</para>
  <para style="q1" vid="JOL 3:13">ద్రాక్షగానుగ నిండింది</para>
  <para style="q2" vid="JOL 3:13">తొట్లు పొర్లి పారుతున్నాయి కాబట్టి</para>
  <para style="q2" vid="JOL 3:13">రండి, ద్రాక్షలను త్రొక్కండి,</para>
  <para style="q1" vid="JOL 3:13">వారి దుష్టత్వం అధికంగా ఉంది!”<verse eid="JOL 3:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="JOL 3:14"/>తీర్పు తీర్చే లోయలో ప్రజలు</para>
  <para style="q2" vid="JOL 3:14">గుంపులు గుంపులుగా ఉన్నారు,</para>
  <para style="q1" vid="JOL 3:14">ఎందుకంటే తీర్పు తీర్చే లోయలో</para>
  <para style="q2" vid="JOL 3:14">యెహోవా దినం ఆసన్నమైంది.<verse eid="JOL 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JOL 3:15"/>సూర్యచంద్రులు చీకటిగా మారుతాయి,</para>
  <para style="q2" vid="JOL 3:15">నక్షత్రాలు ఇక ప్రకాశించవు.<verse eid="JOL 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="JOL 3:16"/>యెహోవా సీయోను నుండి గర్జిస్తారు,</para>
  <para style="q2" vid="JOL 3:16">యెరూషలేములో నుండి ఉరుముతారు;</para>
  <para style="q2" vid="JOL 3:16">భూమ్యాకాశాలు వణకుతాయి,</para>
  <para style="q1" vid="JOL 3:16">అయితే యెహోవా తన ప్రజలకు ఆశ్రయంగా ఉంటారు,</para>
  <para style="q2" vid="JOL 3:16">ఇశ్రాయేలు ప్రజలకు దుర్గంగా ఉంటారు.<verse eid="JOL 3:16"/></para>
  <para style="s1">దేవుని ప్రజలకు దీవెనలు</para>
  <para style="q1">
    <verse number="17" style="v" sid="JOL 3:17"/>“అప్పుడు మీ దేవుడైన యెహోవానైన నేను</para>
  <para style="q2" vid="JOL 3:17">నా పవిత్ర కొండయైన సీయోను మీద నివసిస్తానని మీరు తెలుసుకుంటారు.</para>
  <para style="q1" vid="JOL 3:17">యెరూషలేము పరిశుద్ధంగా ఉంటుంది;</para>
  <para style="q2" vid="JOL 3:17">ఇక ఎన్నడు ఇతర దేశాల సైన్యాలు దానిని ఆక్రమించరు.<verse eid="JOL 3:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="JOL 3:18"/>“ఆ రోజు పర్వతాల నుండి క్రొత్త ద్రాక్షరసం ప్రవహిస్తుంది,</para>
  <para style="q2" vid="JOL 3:18">కొండల నుండి పాలు ప్రవహిస్తాయి;</para>
  <para style="q2" vid="JOL 3:18">యూదాలోని వాగులన్నిటిలో నీళ్లు పారతాయి.</para>
  <para style="q1" vid="JOL 3:18">యెహోవా మందిరంలో నుండి ఒక ఊట ప్రవహిస్తూ,</para>
  <para style="q2" vid="JOL 3:18">షిత్తీము లోయను తడుపుతుంది.<verse eid="JOL 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="JOL 3:19"/>అయితే ఈజిప్టు పాడైపోతుంది,</para>
  <para style="q2" vid="JOL 3:19">ఎదోము పాడైపోయిన ఎడారిగా అవుతుంది.</para>
  <para style="q1" vid="JOL 3:19">ఎందుకంటే ఈ దేశాలు యూదా ప్రజలపై దౌర్జన్యం చేశాయి,</para>
  <para style="q2" vid="JOL 3:19">వారి దేశంలో నిర్దోషుల రక్తం చిందించారు.<verse eid="JOL 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="JOL 3:20"/>యూదాలో ప్రజలు నిత్యం నివసిస్తారు,</para>
  <para style="q2" vid="JOL 3:20">యెరూషలేము తరతరాలకు నివాస స్థలంగా ఉంటుంది.<verse eid="JOL 3:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="JOL 3:21"/>వారు చిందించిన నిర్దోషుల రక్తాన్ని బట్టి ప్రతీకారం</para>
  <para style="q2" vid="JOL 3:21">తీసుకోకుండా వారిని వదిలేయాలా?</para>
  <para style="q2" vid="JOL 3:21">నేను ప్రతీకారం చేస్తాను.”</para>
  <para style="b" vid="JOL 3:21"/>
  <para style="qc" vid="JOL 3:21">యెహోవా సీయోనులో నివసిస్తున్నారు!<verse eid="JOL 3:21"/></para>
  <chapter eid="JOL 3"/>
</usx>
