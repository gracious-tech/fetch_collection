<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ISA" style="id">- Biblica® Open Telugu Contemporary Version</book>
  <para style="h">యెషయా</para>
  <para style="toc1">యెషయా ప్రవచనం</para>
  <para style="toc2">యెషయా</para>
  <para style="toc3">యెషయా</para>
  <para style="mt1">యెషయా</para>
  <para style="mt2">ప్రవచనం</para>
  <chapter number="1" style="c" sid="ISA 1"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 1:1"/>ఉజ్జియా, యోతాము, ఆహాజు, హిజ్కియా యూదా రాజులుగా ఉన్న కాలంలో యూదా గురించి, యెరూషలేము గురించి ఆమోజు కుమారుడైన యెషయాకు వచ్చిన దర్శనము.<verse eid="ISA 1:1"/></para>
  <para style="b"/>
  <para style="s1">తిరుగుబాటు చేసిన దేశం</para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 1:2"/>ఆకాశాల్లారా, నా మాట వినండి! భూమీ శ్రద్ధగా విను!</para>
  <para style="q2" vid="ISA 1:2">యెహోవా ఇలా చెప్తున్నారు:</para>
  <para style="q1" vid="ISA 1:2">“నేను పిల్లలను పెంచి గొప్పవారిగా చేశాను,</para>
  <para style="q2" vid="ISA 1:2">కాని వారు నా మీద తిరుగబడ్డారు.<verse eid="ISA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 1:3"/>ఎద్దు తన యజమానిని గుర్తిస్తుంది,</para>
  <para style="q2" vid="ISA 1:3">గాడిదకు తన యజమానుని పశువుల దొడ్డి తెలుసు,</para>
  <para style="q1" vid="ISA 1:3">కాని ఇశ్రాయేలుకు వారి యజమాని ఎవరో తెలియదు,</para>
  <para style="q2" vid="ISA 1:3">నా ప్రజలు గ్రహించరు.”<verse eid="ISA 1:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 1:4"/>పాపిష్ఠి దేశానికి శ్రమ,</para>
  <para style="q2" vid="ISA 1:4">ఆ ప్రజల దోషం గొప్పది,</para>
  <para style="q1" vid="ISA 1:4">వారిది దుష్ట సంతానం,</para>
  <para style="q2" vid="ISA 1:4">అవినీతికి అప్పగించబడిన పిల్లలు!</para>
  <para style="q1" vid="ISA 1:4">వారు యెహోవాను విడిచిపెట్టారు;</para>
  <para style="q2" vid="ISA 1:4">ఇశ్రాయేలు యొక్క పరిశుద్ధుని తృణీకరించారు.</para>
  <para style="q2" vid="ISA 1:4">వారు ఆయనను విడిచి తొలగిపోయారు.<verse eid="ISA 1:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 1:5"/>ఎందుకు మీరు ఇంకా దెబ్బలు తింటున్నారు?</para>
  <para style="q2" vid="ISA 1:5">ఎందుకు మీరు ఇంకా తిరుగుబాటు కొనసాగిస్తున్నారు?</para>
  <para style="q1" vid="ISA 1:5">మీ తలంతా గాయపరచబడింది,</para>
  <para style="q2" vid="ISA 1:5">మీ గుండె మొత్తం బాధించబడింది.<verse eid="ISA 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 1:6"/>అరికాలు నుండి నడినెత్తి వరకు</para>
  <para style="q2" vid="ISA 1:6">పుండు లేనిచోటు లేదు.</para>
  <para style="q1" vid="ISA 1:6">ఎక్కడ చూసినా గాయాలు, దెబ్బలు,</para>
  <para style="q2" vid="ISA 1:6">పచ్చి పుండ్లు,</para>
  <para style="q1" vid="ISA 1:6">వాటిని శుభ్రం చేయలేదు, కట్టు కట్టలేదు,</para>
  <para style="q2" vid="ISA 1:6">ఒలీవనూనెతో చికిత్స చేయలేదు.<verse eid="ISA 1:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 1:7"/>మీ దేశం నాశనమైపోయింది.</para>
  <para style="q2" vid="ISA 1:7">మీ పట్టణాలు అగ్నిచేత కాలిపోయాయి;</para>
  <para style="q1" vid="ISA 1:7">మీ కళ్లెదుటే మీ పొలాలు</para>
  <para style="q2" vid="ISA 1:7">విదేశీయులచేత దోచుకోబడ్డాయి,</para>
  <para style="q2" vid="ISA 1:7">కంటికి కనబడినవాటిని పరాయివారిగా నాశనం చేశారు.<verse eid="ISA 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 1:8"/>ద్రాక్షతోటలోని గుడిసెలా,</para>
  <para style="q2" vid="ISA 1:8">దోసకాయ పొలంలోని పాకలా,</para>
  <para style="q1" vid="ISA 1:8">ముట్టడించబడిన పట్టణంలా,</para>
  <para style="q2" vid="ISA 1:8">సీయోను కుమార్తె విడిచిపెట్టబడింది.<verse eid="ISA 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 1:9"/>సైన్యాల యెహోవా</para>
  <para style="q2" vid="ISA 1:9">కొద్దిమందిని ప్రాణాలతో మనకు మిగల్చకపోయుంటే,</para>
  <para style="q1" vid="ISA 1:9">మనం సొదొమలా మారేవారం,</para>
  <para style="q2" vid="ISA 1:9">గొమొర్రాను పోలి ఉండేవారము.<verse eid="ISA 1:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 1:10"/>సొదొమ పాలకులారా,</para>
  <para style="q2" vid="ISA 1:10">యెహోవా మాట వినండి;</para>
  <para style="q1" vid="ISA 1:10">గొమొర్రా ప్రజలారా!</para>
  <para style="q2" vid="ISA 1:10">మన దేవుని ఉపదేశాన్ని శ్రద్ధగా వినండి.<verse eid="ISA 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 1:11"/>యెహోవా ఇలా అంటున్నారు,</para>
  <para style="q2" vid="ISA 1:11">“విస్తారమైన మీ బలులు నాకెందుకు?</para>
  <para style="q1" vid="ISA 1:11">దహనబలులుగా ఇచ్చిన పొట్టేళ్లు,</para>
  <para style="q2" vid="ISA 1:11">బాగా క్రొవ్విన జంతువుల క్రొవ్వు నాకు వెగటు కలిగించాయి;</para>
  <para style="q1" vid="ISA 1:11">ఎద్దుల, గొర్రెపిల్లల, మేకపోతుల రక్తంలో</para>
  <para style="q2" vid="ISA 1:11">నాకు ఆనందం లేదు.<verse eid="ISA 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 1:12"/>మీరు నా సన్నిధికి వస్తున్నప్పుడు,</para>
  <para style="q2" vid="ISA 1:12">నా ఆవరణాలను త్రొక్కడానికి</para>
  <para style="q2" vid="ISA 1:12">మిమ్మల్ని ఎవరు రమ్మన్నారు?<verse eid="ISA 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 1:13"/>విలువలేని అర్పణలు తీసుకురావడం ఆపండి!</para>
  <para style="q2" vid="ISA 1:13">మీ ధూపం నాకు అసహ్యం కలిగిస్తుంది.</para>
  <para style="q1" vid="ISA 1:13">అమావాస్యలు, సబ్బాతులు, ప్రత్యేక సమావేశాలు</para>
  <para style="q2" vid="ISA 1:13">మీ దుష్ట సమావేశాలు నేను భరించలేను.<verse eid="ISA 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 1:14"/>మీ అమావాస్య ఉత్సవాలు, నియమించబడిన పండుగలు</para>
  <para style="q2" vid="ISA 1:14">నా పూర్ణాత్మతో నేను అసహ్యిస్తున్నాను.</para>
  <para style="q1" vid="ISA 1:14">అవి నాకు భారంగా ఉన్నాయి;</para>
  <para style="q2" vid="ISA 1:14">వాటిని భరించలేక అలిసిపోయాను.<verse eid="ISA 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 1:15"/>ప్రార్థనలో మీరు మీ చేతులు చాచినప్పుడు,</para>
  <para style="q2" vid="ISA 1:15">మిమ్మల్ని చూడకుండ కళ్లు కప్పుకుంటాను;</para>
  <para style="q1" vid="ISA 1:15">మీరు చాలా ప్రార్థనలు చేసినా</para>
  <para style="q2" vid="ISA 1:15">నేను వినను.</para>
  <para style="b" vid="ISA 1:15"/>
  <para style="q1" vid="ISA 1:15">“మీ చేతులు రక్తంతో నిండిపోయాయి!<verse eid="ISA 1:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 1:16"/>“మిమ్మల్ని మీరు కడుక్కుని శుభ్రం చేసుకోండి.</para>
  <para style="q2" vid="ISA 1:16">మీ చెడు కార్యాలు నాకు కనిపించకుండా వాటిని తొలగించండి;</para>
  <para style="q2" vid="ISA 1:16">తప్పు చేయడం మానండి.<verse eid="ISA 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 1:17"/>సరియైనది చేయడం నేర్చుకోండి; న్యాయాన్ని వెదకండి.</para>
  <para style="q2" vid="ISA 1:17">అణచివేయబడుతున్న వారి<note caller="+" style="f"><char style="fr" closed="false">1:17 </char><char style="ft" closed="false">లేదా </char><char style="fq" closed="false">న్యాయం </char><char style="fqa" closed="false">హింసిస్తున్న వారిని సరిచేయండి</char></note> పక్షాన ఉండండి.</para>
  <para style="q1" vid="ISA 1:17">తండ్రిలేనివారికి న్యాయం తీర్చండి.</para>
  <para style="q2" vid="ISA 1:17">విధవరాలి పక్షాన వాదించండి.<verse eid="ISA 1:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 1:18"/>“రండి, మనం విషయాన్ని పరిష్కరించుకుందాం”</para>
  <para style="q2" vid="ISA 1:18">అని యెహోవా అంటున్నారు.</para>
  <para style="q1" vid="ISA 1:18">“మీ పాపాలు రక్తంలా ఎర్రగా ఉన్నా,</para>
  <para style="q2" vid="ISA 1:18">అవి మంచులా తెల్లగా అవుతాయి;</para>
  <para style="q1" vid="ISA 1:18">కెంపులా ఎర్రగా ఉన్నా,</para>
  <para style="q2" vid="ISA 1:18">అది ఉన్నిలా తెల్లగా అవుతాయి.<verse eid="ISA 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 1:19"/>మీరు ఇష్టపడి నా మాట వింటే,</para>
  <para style="q2" vid="ISA 1:19">మీరు భూమి ఇచ్చే మంచి పంటను తింటారు;<verse eid="ISA 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 1:20"/>ఒకవేళ మీరు ఎదిరించి తిరుగుబాటు చేస్తే,</para>
  <para style="q2" vid="ISA 1:20">మీరు ఖడ్గం చేత నాశనమవుతారు”</para>
  <para style="q1" vid="ISA 1:20">యెహోవా ఈ మాట చెప్తున్నారు.<verse eid="ISA 1:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 1:21"/>చూడండి, నమ్మకమైన పట్టణం</para>
  <para style="q2" vid="ISA 1:21">వేశ్యగా ఎలా అయ్యిందో!</para>
  <para style="q1" vid="ISA 1:21">ఒక్కప్పుడు అది న్యాయంతో నిండి ఉండేది;</para>
  <para style="q2" vid="ISA 1:21">నీతి దానిలో నివసించేది,</para>
  <para style="q2" vid="ISA 1:21">కాని ఇప్పుడు హంతకులు ఉంటున్నారు!<verse eid="ISA 1:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 1:22"/>నీ వెండి మలినం అయిపోయింది,</para>
  <para style="q2" vid="ISA 1:22">నీ శ్రేష్ఠమైన ద్రాక్షరసం నీళ్లతో కలిసి పలచబడి పోయింది.<verse eid="ISA 1:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 1:23"/>నీ పాలకులు తిరుగుబాటుదారులు,</para>
  <para style="q2" vid="ISA 1:23">దొంగలతో సహవాసం చేస్తారు.</para>
  <para style="q1" vid="ISA 1:23">వారందరికి లంచాలు ఇష్టం</para>
  <para style="q2" vid="ISA 1:23">కానుకల వెంటపడతారు.</para>
  <para style="q1" vid="ISA 1:23">తండ్రిలేనివారి పక్షంగా న్యాయం తీర్చరు.</para>
  <para style="q2" vid="ISA 1:23">విధవరాలి సమస్యను పరిష్కరించరు.<verse eid="ISA 1:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 1:24"/>కాబట్టి ప్రభువైన, సైన్యాల యెహోవా,</para>
  <para style="q2" vid="ISA 1:24">ఇశ్రాయేలు బలవంతుడు ఇలా చెప్తున్నారు:</para>
  <para style="q1" vid="ISA 1:24">ఆహా! నా శత్రువులపై నా ఉగ్రతను బయటపెట్టి,</para>
  <para style="q2" vid="ISA 1:24">నా విరోధుల మీద పగ తీర్చుకుంటాను.<verse eid="ISA 1:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 1:25"/>నీకు<note caller="+" style="f"><char style="fr" closed="false">1:25 </char><char style="ft" closed="false">అంటే, యెరూషలేముకు వ్యతిరేకంగా</char></note> వ్యతిరేకంగా నా చేయి ఉంచుతాను;</para>
  <para style="q2" vid="ISA 1:25">నీ లోహపు మలినాన్ని శుద్ధి చేసి</para>
  <para style="q2" vid="ISA 1:25">నీ మలినాలను తొలగిస్తాను.<verse eid="ISA 1:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 1:26"/>పూర్వం ఉన్నట్లు నీకు న్యాయాధిపతులను,</para>
  <para style="q2" vid="ISA 1:26">తొలి రోజుల్లో ఉన్నట్లు నీకు పాలకులను నియమిస్తాను.</para>
  <para style="q1" vid="ISA 1:26">అప్పుడు నీవు</para>
  <para style="q2" vid="ISA 1:26">నీతిగల పట్టణమని,</para>
  <para style="q2" vid="ISA 1:26">నమ్మకమైన పట్టణమని పిలువబడతావు.<verse eid="ISA 1:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 1:27"/>సీయోనుకు న్యాయంతో,</para>
  <para style="q2" vid="ISA 1:27">పశ్చాత్తాపపడే వారికి నీతితో విడుదల కలుగుతుంది.<verse eid="ISA 1:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 1:28"/>అయితే తిరుగుబాటుదారులు, పాపులు నలుగగొట్టబడతారు,</para>
  <para style="q2" vid="ISA 1:28">యెహోవాను విడిచిపెట్టిన వారు నశిస్తారు.<verse eid="ISA 1:28"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 1:29"/>“మీరు వేటిని బట్టి ఆనందించారో</para>
  <para style="q2" vid="ISA 1:29">ఆ పవిత్ర సింధూర వృక్షాల గురించి మీరు సిగ్గుపడతారు;</para>
  <para style="q1" vid="ISA 1:29">మీరు ఎంచుకున్న సింధూర తోటల గురించి</para>
  <para style="q2" vid="ISA 1:29">మీరు అవమానించబడతారు.<verse eid="ISA 1:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 1:30"/>మీరు ఆకులు వాడిపోతున్న సింధూర వృక్షంలా,</para>
  <para style="q2" vid="ISA 1:30">నీరు లేని తోటలా అవుతారు.<verse eid="ISA 1:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 1:31"/>బలవంతుడు పీచులా అవుతాడు</para>
  <para style="q2" vid="ISA 1:31">అతని పని నిప్పురవ్వలా అవుతుంది;</para>
  <para style="q1" vid="ISA 1:31">అవి రెండూ కలిసి కాలిపోతాయి,</para>
  <para style="q2" vid="ISA 1:31">మంటను ఆర్పేవారు ఎవరూ ఉండరు.”<verse eid="ISA 1:31"/></para>
  <chapter eid="ISA 1"/>
  <chapter number="2" style="c" sid="ISA 2"/>
  <para style="s1">యెహోవా పర్వతం</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 2:1"/>యూదా గురించి, యెరూషలేము గురించి ఆమోజు కుమారుడైన యెషయాకు వచ్చిన దర్శనం:<verse eid="ISA 2:1"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="2" style="v" sid="ISA 2:2"/>చివరి రోజుల్లో</para>
  <para style="q1" vid="ISA 2:2">యెహోవా మందిరం</para>
  <para style="q2" vid="ISA 2:2">పర్వతాలన్నిటిలో ఉన్నతమైనదిగా స్థిరపరచబడుతుంది;</para>
  <para style="q1" vid="ISA 2:2">అది కొండలకు పైగా హెచ్చింపబడుతుంది,</para>
  <para style="q2" vid="ISA 2:2">జనాంగాలన్నీ దాని దగ్గరకు ప్రవాహంలా వెళ్తారు.<verse eid="ISA 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 2:3"/>చాలా జనాంగాలు వచ్చి ఇలా అంటారు,</para>
  <para style="q1" vid="ISA 2:3">“రండి, మనం యెహోవా పర్వతం మీదికి,</para>
  <para style="q2" vid="ISA 2:3">యాకోబు దేవుని ఆలయానికి వెళ్దాము.</para>
  <para style="q1" vid="ISA 2:3">మనం ఆయన మార్గంలో నడిచేలా,</para>
  <para style="q2" vid="ISA 2:3">ఆయన మనకు తన మార్గాల్ని బోధిస్తారు.”</para>
  <para style="q1" vid="ISA 2:3">సీయోనులో నుండి ధర్మశాస్త్రం,</para>
  <para style="q2" vid="ISA 2:3">యెరూషలేములో నుండి యెహోవా వాక్కు బయటకు వెళ్తాయి.<verse eid="ISA 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 2:4"/>ఆయన దేశాల మధ్య తీర్పు తీరుస్తారు,</para>
  <para style="q2" vid="ISA 2:4">అనేక జనాంగాల వివాదాలను పరిష్కరిస్తారు.</para>
  <para style="q1" vid="ISA 2:4">వారు తమ ఖడ్గాలను సాగగొట్టి నాగటి నక్కులుగా,</para>
  <para style="q2" vid="ISA 2:4">తమ ఈటెలను సాగగొట్టి మడ్డికత్తులుగా చేస్తారు.</para>
  <para style="q1" vid="ISA 2:4">ఒక దేశం మరొక దేశం మీద ఖడ్గం ఎత్తదు,</para>
  <para style="q2" vid="ISA 2:4">వారు ఇకపై యుద్ధానికి శిక్షణ పొందరు.<verse eid="ISA 2:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 2:5"/>యాకోబు వారసులారా రండి,</para>
  <para style="q2" vid="ISA 2:5">మనం యెహోవా వెలుగులో నడుద్దాము.<verse eid="ISA 2:5"/></para>
  <para style="s1">యెహోవా దినం</para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 2:6"/>యెహోవా, యాకోబు వారసులైన</para>
  <para style="q2" vid="ISA 2:6">మీ ప్రజలను మీరు విడిచిపెట్టారు.</para>
  <para style="q1" vid="ISA 2:6">వారు తూర్పు దేశాలకున్న మూఢనమ్మకాలతో నిండి ఉన్నారు;</para>
  <para style="q2" vid="ISA 2:6">వారు ఫిలిష్తీయుల్లా భవిష్యవాణి చూస్తారు,</para>
  <para style="q2" vid="ISA 2:6">ఇతరుల ఆచారాలను పాటిస్తారు.<verse eid="ISA 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 2:7"/>వారి దేశం వెండి బంగారాలతో నిండి ఉంది;</para>
  <para style="q2" vid="ISA 2:7">వారి ధనానికి అంతులేదు.</para>
  <para style="q1" vid="ISA 2:7">వారి దేశం గుర్రాలతో నిండి ఉంది;</para>
  <para style="q2" vid="ISA 2:7">వారి రథాలకు అంతులేదు.<verse eid="ISA 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 2:8"/>వారి దేశం విగ్రహాలతో నిండి ఉంది.</para>
  <para style="q2" vid="ISA 2:8">వారు తమ చేతులతో చేసిన వాటికి,</para>
  <para style="q2" vid="ISA 2:8">తమ వ్రేళ్లతో చేసిన వాటికి తలవంచి నమస్కరిస్తారు.<verse eid="ISA 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 2:9"/>కాబట్టి ప్రజలు అణచివేయబడతారు</para>
  <para style="q2" vid="ISA 2:9">ప్రతి ఒక్కరు తగ్గించబడతారు</para>
  <para style="q2" vid="ISA 2:9">వారిని క్షమించకండి.<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">వారిని లేవనెత్తకండి</char></note><verse eid="ISA 2:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 2:10"/>యెహోవా భీకర సన్నిధి నుండి,</para>
  <para style="q2" vid="ISA 2:10">ఆయన ప్రభావ మహాత్మ్యం నుండి</para>
  <para style="q2" vid="ISA 2:10">బండ సందులకు వెళ్లి నేలలో దాక్కోండి.<verse eid="ISA 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 2:11"/>మనుష్యుల అహంకారపు చూపు తగ్గించబడుతుంది,</para>
  <para style="q2" vid="ISA 2:11">మనుష్యుల గర్వం అణచివేయబడుతుంది;</para>
  <para style="q1" vid="ISA 2:11">ఆ రోజున యెహోవా మాత్రమే ఘనత పొందుతారు.<verse eid="ISA 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 2:12"/>సైన్యాల యెహోవా</para>
  <para style="q2" vid="ISA 2:12">అహంకారం, గర్వం ఉన్న ప్రతివారి కోసం</para>
  <para style="q1" vid="ISA 2:12">హెచ్చింపబడిన వాటన్నిటి కోసం ఒక రోజును నియమించారు.</para>
  <para style="q2" vid="ISA 2:12">(అవి అణచివేయబడతాయి),<verse eid="ISA 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 2:13"/>ఎందుకంటే ఎత్తైన పొడవైన లెబానోను దేవదారు చెట్లన్నిటికి,</para>
  <para style="q2" vid="ISA 2:13">బాషాను సింధూర వృక్షాలన్నిటికి,<verse eid="ISA 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 2:14"/>పెద్ద పర్వతాలన్నిటికి,</para>
  <para style="q2" vid="ISA 2:14">ఎత్తైన కొండలన్నిటికి<verse eid="ISA 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 2:15"/>ఉన్నతమైన ప్రతి గోపురానికి</para>
  <para style="q2" vid="ISA 2:15">ప్రతి కోటగోడకు,<verse eid="ISA 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 2:16"/>ప్రతీ వాణిజ్య నౌకకు<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">హెబ్రీలో </char><char style="fqa" closed="false">తర్షీషు ఓడలన్నిటికి</char></note></para>
  <para style="q2" vid="ISA 2:16">మనోహరమైన నౌకలకు ఒక రోజును నియమించారు.<verse eid="ISA 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 2:17"/>మనుష్యుల అహంకారం అణచివేయబడుతుంది</para>
  <para style="q2" vid="ISA 2:17">మానవుల గర్వం తగ్గించబడుతుంది;</para>
  <para style="q1" vid="ISA 2:17">ఆ రోజు యెహోవా మాత్రమే ఘనపరచబడతారు.<verse eid="ISA 2:17"/></para>
  <para style="q2">
    <verse number="18" style="v" sid="ISA 2:18"/>విగ్రహాలు పూర్తిగా అదృశ్యమవుతాయి.<verse eid="ISA 2:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 2:19"/>యెహోవా భూమిని వణికించడానికి లేచినప్పుడు,</para>
  <para style="q2" vid="ISA 2:19">ఆయన భీకర సన్నిధి నుండి</para>
  <para style="q1" vid="ISA 2:19">ఆయన ప్రభావ మహాత్మ్యం నుండి పారిపోయి</para>
  <para style="q2" vid="ISA 2:19">వారు కొండల గుహల్లో</para>
  <para style="q2" vid="ISA 2:19">నేలలో ఉన్న సందుల్లో దాక్కుంటారు.<verse eid="ISA 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 2:20"/>ఆ రోజున మనుష్యులు</para>
  <para style="q2" vid="ISA 2:20">తాము పూజించడానికి తయారుచేసుకున్న</para>
  <para style="q1" vid="ISA 2:20">వెండి విగ్రహాలను బంగారు విగ్రహాలను</para>
  <para style="q2" vid="ISA 2:20">ఎలుకలకు గబ్బిలాలకు పారేస్తారు.<verse eid="ISA 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 2:21"/>యెహోవా భూమిని వణికించడానికి లేచినప్పుడు,</para>
  <para style="q2" vid="ISA 2:21">ఆయన భీకర సన్నిధి నుండి పారిపోయి</para>
  <para style="q1" vid="ISA 2:21">ఆయన ప్రభావ మహాత్మ్యం నుండి</para>
  <para style="q2" vid="ISA 2:21">వారు కొండల గుహల్లో</para>
  <para style="q2" vid="ISA 2:21">బండ బీటల్లో దాక్కుంటారు.<verse eid="ISA 2:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 2:22"/>తమ నాసికారంధ్రాలలో ఊపిరి తప్ప ఏమీ లేని</para>
  <para style="q2" vid="ISA 2:22">నరులను నమ్మడం మానండి.</para>
  <para style="q2" vid="ISA 2:22">వారిని ఎందుకు లక్ష్యపెట్టాలి?<verse eid="ISA 2:22"/></para>
  <chapter eid="ISA 2"/>
  <chapter number="3" style="c" sid="ISA 3"/>
  <para style="s1">యెరూషలేముకు యూదాకు తీర్పు</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 3:1"/>చూడండి, ప్రభువును,</para>
  <para style="q2" vid="ISA 3:1">సైన్యాలకు అధిపతియైన యెహోవా</para>
  <para style="q1" vid="ISA 3:1">యెరూషలేములో నుండి యూదాలో నుండి</para>
  <para style="q2" vid="ISA 3:1">జీవనాధారాన్ని, మద్దతును తీసివేయబోతున్నారు:</para>
  <para style="q1" vid="ISA 3:1">అన్ని ఆహార సరఫరాలు, అన్ని నీటి సరఫరాలు,<verse eid="ISA 3:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="ISA 3:2"/>వీరులు, యోధులు,</para>
  <para style="q1" vid="ISA 3:2">న్యాయాధిపతులు, ప్రవక్తలు,</para>
  <para style="q2" vid="ISA 3:2">సోదె చెప్పేవారు, పెద్దలు,<verse eid="ISA 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 3:3"/>పంచదశాధిపతులను, ఘనత వహించినవారు,</para>
  <para style="q2" vid="ISA 3:3">సలహాదారులు, నైపుణ్యం కలిగిన హస్తకళాకారులు,</para>
  <para style="q2" vid="ISA 3:3">తెలివిగల మాంత్రికులు, వీరందరిని తీసివేస్తారు.<verse eid="ISA 3:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 3:4"/>“నేను యవ్వనులను వారికి అధిపతులుగా నియమిస్తాను.</para>
  <para style="q2" vid="ISA 3:4">పిల్లలు వారిని పరిపాలిస్తారు.”<verse eid="ISA 3:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 3:5"/>ప్రజలు ఒకరిని ఒకరు</para>
  <para style="q2" vid="ISA 3:5">ఒకరి మీదికి ఒకరు, పొరుగువారి మీదికి పొరుగువారు.</para>
  <para style="q1" vid="ISA 3:5">యువకులు పెద్దవారి మీదికి,</para>
  <para style="q2" vid="ISA 3:5">అనామకులు ఘనుల మీదికి లేస్తారు.<verse eid="ISA 3:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 3:6"/>ఒకడు తన తండ్రి ఇంట్లో</para>
  <para style="q2" vid="ISA 3:6">తన సోదరుని పట్టుకుని,</para>
  <para style="q1" vid="ISA 3:6">“నీకు బట్టలు ఉన్నాయి, నీవు మాకు నాయకునిగా ఉండు;</para>
  <para style="q2" vid="ISA 3:6">ఈ పాడైపోయిన స్థలం నీ ఆధీనంలోనికి తీసుకో!” అంటాడు.<verse eid="ISA 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 3:7"/>కాని ఆ రోజు అతడు కేక వేసి,</para>
  <para style="q2" vid="ISA 3:7">“నా దగ్గర పరిష్కారం లేదు.</para>
  <para style="q1" vid="ISA 3:7">నా ఇంట్లో ఆహారం గాని బట్టలు గాని లేవు;</para>
  <para style="q2" vid="ISA 3:7">నన్ను ప్రజలకు నాయకునిగా చేయవద్దు” అంటాడు.<verse eid="ISA 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 3:8"/>యెరూషలేము పాడైపోయింది,</para>
  <para style="q2" vid="ISA 3:8">యూదా పతనమవుతుంది,</para>
  <para style="q1" vid="ISA 3:8">వారి మాటలు పనులు యెహోవాకు వ్యతిరేకంగా ఉన్నాయి,</para>
  <para style="q2" vid="ISA 3:8">ఆయన మహిమగల సన్నిధిని వారు ధిక్కరించారు.<verse eid="ISA 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 3:9"/>వారి ముఖమే వారి మీద సాక్ష్యమిస్తుంది;</para>
  <para style="q2" vid="ISA 3:9">వారు తమ పాపాన్ని సొదొమలా ప్రకటిస్తారు;</para>
  <para style="q2" vid="ISA 3:9">వారు దానిని దాచిపెట్టరు.</para>
  <para style="q1" vid="ISA 3:9">వారికి శ్రమ!</para>
  <para style="q2" vid="ISA 3:9">వారు తమ మీద తామే విపత్తు తెచ్చుకున్నారు.<verse eid="ISA 3:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 3:10"/>మీకు మేలు కలుగుతుందని నీతిమంతులకు చెప్పండి</para>
  <para style="q2" vid="ISA 3:10">ఎందుకంటే వారు తాము చేసిన క్రియల ప్రతిఫలాన్ని అనుభవిస్తారు.<verse eid="ISA 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 3:11"/>దుష్టులకు శ్రమ!</para>
  <para style="q2" vid="ISA 3:11">వారికి చెడు జరుగుతుంది!</para>
  <para style="q1" vid="ISA 3:11">వారి చేతులు చేసిన దాని ప్రతిఫలం</para>
  <para style="q2" vid="ISA 3:11">వారికి ఇవ్వబడుతుంది.<verse eid="ISA 3:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 3:12"/>నా ప్రజలను యువకులు అణచివేస్తారు</para>
  <para style="q2" vid="ISA 3:12">స్త్రీలు వారిని పాలిస్తారు.</para>
  <para style="q1" vid="ISA 3:12">నా ప్రజలారా, మీ నాయకులు మిమ్మల్ని తప్పుదారి పట్టిస్తారు</para>
  <para style="q2" vid="ISA 3:12">మార్గం నుండి వారు మిమ్మల్ని తప్పిస్తారు.<verse eid="ISA 3:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 3:13"/>యెహోవా న్యాయస్థానంలో తన స్థానం తీసుకుంటారు;</para>
  <para style="q2" vid="ISA 3:13">ప్రజలకు తీర్పు తీర్చడానికి ఆయన లేస్తారు.<verse eid="ISA 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 3:14"/>యెహోవా తన ప్రజల పెద్దలకు నాయకులకు</para>
  <para style="q2" vid="ISA 3:14">తీర్పు ప్రకటించడానికి వస్తున్నారు:</para>
  <para style="q1" vid="ISA 3:14">“మీరే నా ద్రాక్షతోటను నాశనం చేశారు;</para>
  <para style="q2" vid="ISA 3:14">పేదల నుండి దోచుకున్న సొమ్ము మీ ఇళ్ళలో ఉంది.<verse eid="ISA 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 3:15"/>మీరు నా ప్రజలను ఎందుకు నలుగగొడుతున్నారు?</para>
  <para style="q2" vid="ISA 3:15">పేదల ముఖాలను ఎందుకు నూరుతున్నారు?”</para>
  <para style="q2" vid="ISA 3:15">అని సైన్యాల అధిపతియైన యెహోవా అంటున్నారు.<verse eid="ISA 3:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 3:16"/>యెహోవా ఇలా అంటున్నారు,</para>
  <para style="q2" vid="ISA 3:16">“సీయోను స్త్రీలు గర్విష్ఠులు</para>
  <para style="q1" vid="ISA 3:16">వారు మెడలు చాచి నడుస్తూ</para>
  <para style="q2" vid="ISA 3:16">ఓర చూపులు చూస్తూ</para>
  <para style="q1" vid="ISA 3:16">ఠీవిగా పిరుదులు త్రిప్పుతూ నడుస్తూ</para>
  <para style="q2" vid="ISA 3:16">తమ కాళ్ల గజ్జలు మ్రోగిస్తున్నారు.<verse eid="ISA 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 3:17"/>కాబట్టి ప్రభువు సీయోను స్త్రీల తలలపై పుండ్లు పుట్టిస్తారు;</para>
  <para style="q2" vid="ISA 3:17">యెహోవా వారి తలల్ని బోడి చేస్తారు.”<verse eid="ISA 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 3:18"/>ఆ రోజు ప్రభువు వారి సొగసును లాక్కుంటారు: గాజులు, శిరోభూషణాలు, నెలవంక హారాలు, <verse eid="ISA 3:18"/><verse number="19" style="v" sid="ISA 3:19"/>చెవిపోగులు, కడియాలు, మేలి ముసుగులు, <verse eid="ISA 3:19"/><verse number="20" style="v" sid="ISA 3:20"/>తలపాగాలు, కాళ్లపట్టీలు, ఒడ్డాణాలు, సుగంధద్రవ్య బుడ్డీలు, తాయెత్తులు, <verse eid="ISA 3:20"/><verse number="21" style="v" sid="ISA 3:21"/>ఉంగరాలు, ముక్కుపుడకలు, <verse eid="ISA 3:21"/><verse number="22" style="v" sid="ISA 3:22"/>పండుగ వస్త్రాలు, పైవస్త్రాలు, అంగీలు, సంచులు, <verse eid="ISA 3:22"/><verse number="23" style="v" sid="ISA 3:23"/>అద్దాలు, సన్నపునారతో చేసిన ముసుగులు, తలపాగాలు, శాలువాల్ని తీసివేస్తారు.<verse eid="ISA 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 3:24"/>సువాసనకు బదులు దుర్వాసన ఉంటుంది;</para>
  <para style="q2" vid="ISA 3:24">నడికట్టుకు బదులు తాడు;</para>
  <para style="q1" vid="ISA 3:24">అల్లిన జడకు బదులు బోడితల;</para>
  <para style="q2" vid="ISA 3:24">ప్రశస్తమైన పైవస్త్రానికి బదులు గోనెపట్ట;</para>
  <para style="q2" vid="ISA 3:24">అందానికి బదులు ఖైదీ వాత ఉంటుంది.<verse eid="ISA 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 3:25"/>మీ మనుష్యులు ఖడ్గానికి కూలిపోతారు,</para>
  <para style="q2" vid="ISA 3:25">మీ వీరులు యుద్ధంలో చనిపోతారు.<verse eid="ISA 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 3:26"/>సీయోను గుమ్మాలు విలపిస్తూ దుఃఖిస్తాయి;</para>
  <para style="q2" vid="ISA 3:26">ఆమె ఒంటరిదై, నేల మీద కూర్చుంటుంది.<verse eid="ISA 3:26"/></para>
  <chapter eid="ISA 3"/>
  <chapter number="4" style="c" sid="ISA 4"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 4:1"/>ఆ రోజున ఏడుగురు స్త్రీలు</para>
  <para style="q2" vid="ISA 4:1">ఒక్క పురుషుని పట్టుకుని</para>
  <para style="q1" vid="ISA 4:1">“మేము మా అన్నమే తింటాము,</para>
  <para style="q2" vid="ISA 4:1">మా బట్టలే మేము కట్టుకుంటాము;</para>
  <para style="q1" vid="ISA 4:1">నీ పేరు మాత్రం మాకు పెట్టి</para>
  <para style="q2" vid="ISA 4:1">మా అవమానాన్ని తీసివేయి చాలు!”</para>
  <para style="m" vid="ISA 4:1">అని చెప్తారు.<verse eid="ISA 4:1"/></para>
  <para style="s1">యెహోవా కొమ్మ</para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 4:2"/>ఆ రోజు యెహోవా కొమ్మ అందంగా, మహిమగలదిగా ఉంటుంది; ఇశ్రాయేలులో తప్పించుకున్నవారికి భూమి పంట అతిశయంగా, ఘనతగా ఉంటుంది. <verse eid="ISA 4:2"/><verse number="3" style="v" sid="ISA 4:3"/>సీయోనులో మిగిలిన వారికి, యెరూషలేములో ఉన్నవారికి అనగా యెరూషలేములో నివసించే వారిలో నమోదు చేయబడ్డ ప్రతివారు పరిశుద్ధులని పిలువబడతారు. <verse eid="ISA 4:3"/><verse number="4" style="v" sid="ISA 4:4"/>ప్రభువు సీయోను స్త్రీల మురికిని కడిగివేస్తారు; ఆయన తీర్పు తీర్చు ఆత్మతో, దహించే ఆత్మతో, యెరూషలేము నుండి రక్తం మరకల్ని శుభ్రం చేస్తారు. <verse eid="ISA 4:4"/><verse number="5" style="v" sid="ISA 4:5"/>అప్పుడు యెహోవా సీయోను పర్వతం అంతట, అక్కడ కూడుకునేవారి మీద పగలు పొగతో ఉన్న మేఘాన్ని, రాత్రి మండుతున్న అగ్నిని సృష్టిస్తారు; ప్రతి దాని మీద మహిమ<note caller="+" style="f"><char style="fr" closed="false">4:5 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">అక్కడ ఉన్న మహిమ అంతటి మీద</char></note> పందిరిగా ఉంటుంది. <verse eid="ISA 4:5"/><verse number="6" style="v" sid="ISA 4:6"/>అది పగలు ఎండ వేడి నుండి ఆశ్రయంగా, నీడగా, తుఫాను, వానల నుండి కాపాడే దాగుచోటుగా ఉంటుంది.<verse eid="ISA 4:6"/></para>
  <chapter eid="ISA 4"/>
  <chapter number="5" style="c" sid="ISA 5"/>
  <para style="s1">ద్రాక్షతోట గీతం</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 5:1"/>నా ప్రియుని గురించి పాడతాను.</para>
  <para style="q2" vid="ISA 5:1">తన ద్రాక్షతోట గురించి పాట పాడతాను:</para>
  <para style="q1" vid="ISA 5:1">సారవంతమైన కొండమీద</para>
  <para style="q2" vid="ISA 5:1">నా ప్రియునికి ఒక ద్రాక్షతోట ఉండేది.<verse eid="ISA 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 5:2"/>ఆయన దానిని త్రవ్వి రాళ్లను ఏరి బాగుచేసి</para>
  <para style="q2" vid="ISA 5:2">అందులో శ్రేష్ఠమైన ద్రాక్షతీగెలు నాటాడు.</para>
  <para style="q1" vid="ISA 5:2">దానిలో కాపలా గోపురం కట్టాడు</para>
  <para style="q2" vid="ISA 5:2">ద్రాక్షతొట్టిని తొలిపించాడు.</para>
  <para style="q1" vid="ISA 5:2">మంచి ద్రాక్షపండ్లు కాయాలని ఆయన ఎదురుచూశాడు,</para>
  <para style="q2" vid="ISA 5:2">కాని దానిలో చెడ్డ ద్రాక్షలు కాసాయి.<verse eid="ISA 5:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 5:3"/>“కాబట్టి యెరూషలేము నివాసులారా, యూదా ప్రజలారా,</para>
  <para style="q2" vid="ISA 5:3">నాకు, నా ద్రాక్షతోటకు మధ్య న్యాయం చేయండి.<verse eid="ISA 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 5:4"/>నేను నా ద్రాక్షతోటకు చేసిన దానికంటే</para>
  <para style="q2" vid="ISA 5:4">దానికి ఇంకేమి చేయాలి?</para>
  <para style="q1" vid="ISA 5:4">మంచి ద్రాక్షపండ్ల కోసం నేను చూస్తే</para>
  <para style="q2" vid="ISA 5:4">ఎందుకు అది చెడ్డ ద్రాక్షలను కాసింది?<verse eid="ISA 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 5:5"/>నా ద్రాక్షతోటకు నేనేమి చేయబోతున్నానో</para>
  <para style="q2" vid="ISA 5:5">ఇప్పుడు మీకు చెప్తాను.</para>
  <para style="q1" vid="ISA 5:5">దాని కంచె నేను తీసివేస్తాను</para>
  <para style="q2" vid="ISA 5:5">అప్పుడు అది నాశనం అవుతుంది;</para>
  <para style="q1" vid="ISA 5:5">దాని గోడను పడగొడతాను</para>
  <para style="q2" vid="ISA 5:5">అప్పుడు అది త్రొక్కబడుతుంది.<verse eid="ISA 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 5:6"/>నేను దానిని బంజరు భూమిలా చేస్తాను,</para>
  <para style="q2" vid="ISA 5:6">అది త్రవ్వరు, సాగు చేయరు,</para>
  <para style="q2" vid="ISA 5:6">అక్కడ గచ్చపొదలు ముళ్ళచెట్లు పెరుగుతాయి.</para>
  <para style="q1" vid="ISA 5:6">దానిపై వర్షం కురిపించవద్దని</para>
  <para style="q2" vid="ISA 5:6">మేఘాలను ఆజ్ఞాపిస్తాను.”<verse eid="ISA 5:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 5:7"/>ఇశ్రాయేలు వంశం</para>
  <para style="q2" vid="ISA 5:7">సైన్యాల యెహోవా ద్రాక్షతోట,</para>
  <para style="q1" vid="ISA 5:7">యూదా ప్రజలు</para>
  <para style="q2" vid="ISA 5:7">ఆయన ఆనందించే ద్రాక్షలు.</para>
  <para style="q1" vid="ISA 5:7">ఆయన న్యాయం కోసం చూడగా రక్తపాతం కనబడింది;</para>
  <para style="q2" vid="ISA 5:7">నీతి కోసం చూడగా రోదనలు వినబడ్డాయి.<verse eid="ISA 5:7"/></para>
  <para style="s1">శ్రమలు, తీర్పులు</para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 5:8"/>చోటు మిగులకుండ</para>
  <para style="q2" vid="ISA 5:8">మీరు మాత్రమే దేశంలో నివసించేలా</para>
  <para style="q1" vid="ISA 5:8">ఇంటికి ఇల్లు,</para>
  <para style="q2" vid="ISA 5:8">పొలానికి పొలం కలుపుకునేవారికి శ్రమ.<verse eid="ISA 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 5:9"/>నేను వినేలా సైన్యాల యెహోవా చెప్పిన మాట:</para>
  <para style="q1" vid="ISA 5:9">“నిజంగా గొప్ప ఇల్లు ఖాళీగా అయిపోతాయి,</para>
  <para style="q2" vid="ISA 5:9">చక్కటి భవనాలు నివాసులు లేక పాడైపోతాయి.<verse eid="ISA 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 5:10"/>పది ఎకరాల ద్రాక్షతోట ఒక బాతు<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false">అంటే, సుమారు 22 లీటర్లు</char></note> ద్రాక్షరసాన్నే ఇస్తుంది.</para>
  <para style="q2" vid="ISA 5:10">హోమెరు<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false">అంటే, సుమారు 160 కి. గ్రా. లు</char></note> గింజలు ఒక ఏఫా<note caller="+" style="f"><char style="fr" closed="false">5:10 </char><char style="ft" closed="false">అంటే, సుమారు 16 కి. గ్రా. లు</char></note> పంట మాత్రమే ఇస్తాయి.”<verse eid="ISA 5:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 5:11"/>మద్యం త్రాగడానికి</para>
  <para style="q2" vid="ISA 5:11">ఉదయాన్నే లేచి మత్తెక్కే వరకు</para>
  <para style="q1" vid="ISA 5:11">చాలా రాత్రివరకు</para>
  <para style="q2" vid="ISA 5:11">త్రాగే వారికి శ్రమ.<verse eid="ISA 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 5:12"/>వారు సితారాలు, తంతి వాయిద్యాలు, కంజరలు, పిల్లనగ్రోవులు వాయిస్తూ</para>
  <para style="q2" vid="ISA 5:12">ద్రాక్షరసం త్రాగుతూ విందు చేసుకుంటారు,</para>
  <para style="q1" vid="ISA 5:12">కాని యెహోవా చేస్తున్న దానిని వారు గుర్తించరు</para>
  <para style="q2" vid="ISA 5:12">ఆయన చేతిపనిని గౌరవించరు.<verse eid="ISA 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 5:13"/>కాబట్టి నా ప్రజలు తెలివిలేక</para>
  <para style="q2" vid="ISA 5:13">బందీలుగా వెళ్తున్నారు.</para>
  <para style="q1" vid="ISA 5:13">వారిలో ఘనులు ఆకలితో చనిపోతారు.</para>
  <para style="q2" vid="ISA 5:13">సామాన్య ప్రజలు దప్పికతో ఎండిపోతారు.<verse eid="ISA 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 5:14"/>కాబట్టి మరణం తన దవడలను పెద్దగా</para>
  <para style="q2" vid="ISA 5:14">తన నోరు వెడల్పుగా తెరుస్తుంది.</para>
  <para style="q1" vid="ISA 5:14">అందులోకి యెరూషలేము సంస్థానాధిపతులు, సామాన్య ప్రజలు,</para>
  <para style="q2" vid="ISA 5:14">ఆకతాయిలు, ఆనందించేవారు దిగిపోతారు.<verse eid="ISA 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 5:15"/>మనుష్యులు అణగద్రొక్కబడతారు.</para>
  <para style="q2" vid="ISA 5:15">అందరు తగ్గించబడతారు,</para>
  <para style="q2" vid="ISA 5:15">గర్విష్ఠుల చూపు తగ్గించబడుతుంది.<verse eid="ISA 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 5:16"/>కాని సైన్యాల యెహోవా తీర్పు తీర్చి మహిమపరచబడతారు,</para>
  <para style="q2" vid="ISA 5:16">తన నీతి క్రియలనుబట్టి పరిశుద్ధుడైన దేవుడు పరిశుద్ధునిగా నిరూపించబడతారు.<verse eid="ISA 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 5:17"/>అప్పుడు గొర్రెపిల్లలు తమ పచ్చికబయళ్లలో ఉన్నట్లుగా అక్కడ మేస్తాయి;</para>
  <para style="q2" vid="ISA 5:17">ధనవంతుల బీడు భూములలో గొర్రెపిల్లలు మేస్తాయి.<verse eid="ISA 5:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 5:18"/>మోసమనే త్రాళ్లతో పాపాన్ని లాక్కొనే వారికి,</para>
  <para style="q2" vid="ISA 5:18">బండి త్రాళ్లతో దుర్మార్గాన్ని లాక్కొనే వారికి శ్రమ.<verse eid="ISA 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 5:19"/>“దేవుడు త్వరపడాలి;</para>
  <para style="q2" vid="ISA 5:19">ఆయన పనిని త్వరగా చేయాలి</para>
  <para style="q2" vid="ISA 5:19">అప్పుడు ఆయన కార్యాలు మేము చూస్తాము.</para>
  <para style="q1" vid="ISA 5:19">ఇశ్రాయేలు పరిశుద్ధుని ఆలోచన</para>
  <para style="q2" vid="ISA 5:19">ఆచరణలోకి రావాలి, అప్పుడు మేము తెలుసుకుంటాము”</para>
  <para style="q2" vid="ISA 5:19">అనే వారికి శ్రమ.<verse eid="ISA 5:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 5:20"/>కీడును మేలని,</para>
  <para style="q2" vid="ISA 5:20">మేలును కీడని చెప్పేవారికి,</para>
  <para style="q1" vid="ISA 5:20">చీకటిని వెలుగుగా</para>
  <para style="q2" vid="ISA 5:20">వెలుగును చీకటిగా</para>
  <para style="q1" vid="ISA 5:20">చేదును తీపిగా</para>
  <para style="q2" vid="ISA 5:20">తీపిని చేదుగా మార్చేవారికి శ్రమ.<verse eid="ISA 5:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 5:21"/>తమకు తామే జ్ఞానులమని</para>
  <para style="q2" vid="ISA 5:21">తమ దృష్టిలో తామే తెలివైనవారమని అనుకునేవారికి శ్రమ.<verse eid="ISA 5:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 5:22"/>ద్రాక్షరసం త్రాగడంలో పేరు పొందినవారికి</para>
  <para style="q2" vid="ISA 5:22">మద్యం కలపడంలో నేర్పు గలవారికి శ్రమ.<verse eid="ISA 5:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 5:23"/>వారు లంచం తీసుకుని దోషులను వదిలేస్తారు,</para>
  <para style="q2" vid="ISA 5:23">నిర్దోషులకు న్యాయం చేయడానికి నిరాకరిస్తారు.<verse eid="ISA 5:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 5:24"/>వారు సైన్యాల యెహోవా ధర్మశాస్త్రాన్ని తిరస్కరించారు,</para>
  <para style="q2" vid="ISA 5:24">ఇశ్రాయేలు పరిశుద్ధ దేవుని వాక్యాన్ని తృణీకరించారు,</para>
  <para style="q1" vid="ISA 5:24">కాబట్టి మంటలు గడ్డిని కాల్చినట్లుగా</para>
  <para style="q2" vid="ISA 5:24">ఎండుగడ్డి మంటలో కాలిపోయినట్లుగా</para>
  <para style="q1" vid="ISA 5:24">వారి వేరులు కుళ్లిపోతాయి,</para>
  <para style="q2" vid="ISA 5:24">వారి పూలు ధూళిలా ఎగిరిపోతాయి.<verse eid="ISA 5:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 5:25"/>కాబట్టి యెహోవా కోపం ఆయన ప్రజల మీద మండుతుంది;</para>
  <para style="q2" vid="ISA 5:25">ఆయన వారి మీదికి తన చేయి చాచి వారిని కొడతారు.</para>
  <para style="q1" vid="ISA 5:25">పర్వతాలు వణుకుతాయి,</para>
  <para style="q2" vid="ISA 5:25">వీధుల్లో వారి శవాలు పెంటలా పడి ఉన్నాయి.</para>
  <para style="b" vid="ISA 5:25"/>
  <para style="q1" vid="ISA 5:25">ఇంత జరిగినా ఆయన కోపం చల్లారలేదు,</para>
  <para style="q2" vid="ISA 5:25">ఆయన చేయి ఇంకా ఎత్తి ఉంది.<verse eid="ISA 5:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 5:26"/>ఆయన దూరంగా ఉన్న దేశాలను పిలువడానికి జెండా ఎత్తుతారు,</para>
  <para style="q2" vid="ISA 5:26">భూమి అంచుల్లో ఉన్నవారిని రప్పించడానికి ఈల వేస్తారు.</para>
  <para style="q1" vid="ISA 5:26">చూడండి వారందరు</para>
  <para style="q2" vid="ISA 5:26">తొందరగా, వేగంగా వస్తున్నారు.<verse eid="ISA 5:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 5:27"/>వారిలో ఒక్కరు కూడా అలిసిపోరు, తూలిపోరు.</para>
  <para style="q2" vid="ISA 5:27">వారిలో ఒక్కరు కూడా కునుకరు నిద్రపోరు.</para>
  <para style="q1" vid="ISA 5:27">వారి నడికట్టు విడిపోదు.</para>
  <para style="q2" vid="ISA 5:27">వారి చెప్పుల వారు తెగిపోదు.<verse eid="ISA 5:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 5:28"/>వారి బాణాలు పదునుగా ఉన్నాయి.</para>
  <para style="q2" vid="ISA 5:28">వారి విల్లులన్ని ఎక్కుపెట్టి ఉన్నాయి;</para>
  <para style="q1" vid="ISA 5:28">వారి గుర్రాల డెక్కలు చెకుముకి రాళ్లవలె ఉన్నాయి,</para>
  <para style="q2" vid="ISA 5:28">వారి రథచక్రాలు సుడిగాలి తిరిగినట్టు తిరుగుతాయి.<verse eid="ISA 5:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 5:29"/>వారి గర్జన సింహగర్జనలా ఉంది.</para>
  <para style="q2" vid="ISA 5:29">కొదమసింహం గర్జించినట్లు గర్జిస్తారు;</para>
  <para style="q1" vid="ISA 5:29">వారు తమ వేటను పట్టుకుని ఎత్తుకుపోతారు</para>
  <para style="q2" vid="ISA 5:29">కాపాడే వారెవరు ఉండరు.<verse eid="ISA 5:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 5:30"/>వారు ఆ రోజు సముద్ర ఘోషలా</para>
  <para style="q2" vid="ISA 5:30">తమ శత్రువు మీద గర్జిస్తారు.</para>
  <para style="q1" vid="ISA 5:30">ఒకవేళ ఎవరైనా భూమివైపు చూస్తే,</para>
  <para style="q2" vid="ISA 5:30">అక్కడ చీకటి, బాధ మాత్రమే కనబడుతుంది;</para>
  <para style="q2" vid="ISA 5:30">మేఘాలు కమ్మి వెలుగు కూడా చీకటిగా అవుతుంది.<verse eid="ISA 5:30"/></para>
  <chapter eid="ISA 5"/>
  <chapter number="6" style="c" sid="ISA 6"/>
  <para style="s1">యెషయా నియామకం</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 6:1"/>రాజైన ఉజ్జియా చనిపోయిన సంవత్సరంలో అత్యున్నతమైన సింహాసనం మీద ప్రభువు కూర్చుని ఉండడం నేను చూశాను; ఆయన వస్త్రపు అంచు దేవాలయాన్ని నింపింది. <verse eid="ISA 6:1"/><verse number="2" style="v" sid="ISA 6:2"/>ఆయన పైన సెరాపులు ఒక్కొక్కరు ఆరు రెక్కలతో నిలబడి ఉన్నారు; రెండు రెక్కలతో తమ ముఖాలను, రెండింటితో తమ కాళ్లను కప్పుకుని, రెండింటితో ఎగురుతున్నారు. <verse eid="ISA 6:2"/><verse number="3" style="v" sid="ISA 6:3"/>వారు ఒకరితో ఒకరు,</para>
  <para style="q1" vid="ISA 6:3">“సైన్యాల యెహోవా పరిశుద్ధుడు, పరిశుద్ధుడు, పరిశుద్ధుడు;</para>
  <para style="q2" vid="ISA 6:3">సమస్త భూమి ఆయన మహిమతో నిండి ఉంది”</para>
  <para style="m" vid="ISA 6:3">అని పాడుతున్నారు.<verse eid="ISA 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 6:4"/>వారి స్వరాల ధ్వనికి ద్వారబంధాలు, పునాదులు కదిలాయి. మందిరం పొగతో నిండిపోయింది.<verse eid="ISA 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 6:5"/>నేను, “నాకు శ్రమ! నేను నశించిపోయాను! ఎందుకంటే నేను అపవిత్ర పెదవులు గలవాడను. అపవిత్ర పెదవులు ఉన్న ప్రజలమధ్య నేను నివసిస్తున్నాను, నా కళ్లు రాజు, సైన్యాల యెహోవాను చూశాయి” అని మొరపెట్టాను.<verse eid="ISA 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 6:6"/>అప్పుడు ఆ సెరాపులలో ఒకడు బలిపీఠం మీద నుండి పటకారుతో తీసిన నిప్పును తన చేతితో పట్టుకుని ఎగురుతూ నా దగ్గరకు వచ్చాడు. <verse eid="ISA 6:6"/><verse number="7" style="v" sid="ISA 6:7"/>దానితో నా నోటిని ముట్టి, “చూడు, ఇది నీ పెదవులను తాకింది; నీ దోషం తీసివేయబడింది, నీ పాపం క్షమించబడింది” అన్నాడు.<verse eid="ISA 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 6:8"/>అప్పుడు ప్రభువు స్వరం, “నేను ఎవరిని పంపాలి? మాకోసం ఎవరు వెళ్తారు?” అని అనడం నేను విన్నాను.</para>
  <para style="p" vid="ISA 6:8">నేను, “నేనున్నాను. నన్ను పంపండి!” అన్నాను.<verse eid="ISA 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 6:9"/>అందుకు ఆయన, “నీవు వెళ్లి ఈ ప్రజలతో ఇలా చెప్పు:</para>
  <para style="q1" vid="ISA 6:9">“ ‘మీరు ఎప్పుడు వింటూనే ఉంటారు, కాని అర్థం చేసుకోరు;</para>
  <para style="q2" vid="ISA 6:9">ఎప్పుడు చూస్తూనే ఉంటారు, కాని గ్రహించరు.’<verse eid="ISA 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 6:10"/>వారి హృదయాలను కఠినపరచు;</para>
  <para style="q2" vid="ISA 6:10">వారి చెవులకు చెవుడు</para>
  <para style="q2" vid="ISA 6:10">వారి కళ్లకు గుడ్డితనం కలిగించు</para>
  <para style="q1" vid="ISA 6:10">లేదంటే వారు తమ కళ్లతో చూసి,</para>
  <para style="q2" vid="ISA 6:10">చెవులతో విని,</para>
  <para style="q2" vid="ISA 6:10">హృదయాలతో గ్రహించి,</para>
  <para style="q1" vid="ISA 6:10">మనస్సు మార్చుకొని స్వస్థత పొందుతారు.”<verse eid="ISA 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 6:11"/>అందుకు నేను, “ప్రభువా! ఇలా ఎంతకాలం వరకు?” అని అడిగాను.</para>
  <para style="p" vid="ISA 6:11">అందుకు ఆయన ఇలా జవాబిచ్చారు:</para>
  <para style="q1" vid="ISA 6:11">“నివాసులు లేక</para>
  <para style="q2" vid="ISA 6:11">పట్టణాలు నాశనం అయ్యేవరకు,</para>
  <para style="q1" vid="ISA 6:11">మనుష్యులు లేక ఇల్లు పాడై విడిచిపెట్టబడే వరకు,</para>
  <para style="q2" vid="ISA 6:11">భూమి పూర్తిగా నాశనమై బీడుగా అయ్యేవరకు,<verse eid="ISA 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 6:12"/>యెహోవా మనుష్యులను దూరం పంపించే వరకు</para>
  <para style="q2" vid="ISA 6:12">భూమి పూర్తిగా విడిచిపెట్టబడే వరకు.<verse eid="ISA 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 6:13"/>దానిలో పదవ భాగం మాత్రమే విడిచిపెట్టబడినా</para>
  <para style="q2" vid="ISA 6:13">అది కూడా నాశనమవుతుంది.</para>
  <para style="q1" vid="ISA 6:13">అయితే మస్తకి సింధూర చెట్లు నరకబడిన తర్వాత</para>
  <para style="q2" vid="ISA 6:13">మొద్దులు ఎలా మిగులుతాయో</para>
  <para style="q2" vid="ISA 6:13">అలాగే పరిశుద్ధ విత్తనం మొద్దులా నేలపై ఉంటుంది.”<verse eid="ISA 6:13"/></para>
  <chapter eid="ISA 6"/>
  <chapter number="7" style="c" sid="ISA 7"/>
  <para style="s1">ఇమ్మానుయేలు గురించి సూచన</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 7:1"/>యూదా రాజైన ఉజ్జియాకు పుట్టిన యోతాము కుమారుడైన ఆహాజు కాలంలో సిరియా రాజైన రెజీను, ఇశ్రాయేలు రాజైన రెమల్యా కుమారుడైన పెకహు యెరూషలేము మీదికి యుద్ధానికి వచ్చారు కాని అది వారు జయించలేకపోయారు.<verse eid="ISA 7:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 7:2"/>అప్పుడు దావీదు ఇంటివారికి, “అరాము ఎఫ్రాయిముతో పొత్తు పెట్టుకుంది” అని తెలియజేయబడింది; కాబట్టి గాలికి అడవి చెట్లు కదిలినట్లు ఆహాజు, అతని ప్రజల హృదయాలు వణికాయి.<verse eid="ISA 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 7:3"/>అప్పుడు యెహోవా యెషయాతో ఇలా అన్నారు, “ఆహాజును కలుసుకోడానికి నీవు, నీ కుమారుడైన షెయార్యాషూబు<note caller="+" style="f"><char style="fr" closed="false">7:3 </char><char style="fq" closed="false">షెయార్యాషూబు </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">మిగిలినవారు తిరిగి వస్తారు</char></note> చాకలి రేవుకు వెళ్లే దారిలో ఉన్న పై కోనేటి కాలువ చివరికి వెళ్లండి. <verse eid="ISA 7:3"/><verse number="4" style="v" sid="ISA 7:4"/>అతనితో, ‘జాగ్రత్త, నెమ్మదిగా ఉండు, భయపడకు. పొగరాజుకుంటున్న ఈ రెండు కాగడాలకు అనగా రెజీను, అరాము, రెమల్యా కుమారుడైన పెకహు యొక్క తీవ్రమైన కోపానికి అధైర్యపడకు. <verse eid="ISA 7:4"/><verse number="5" style="v" sid="ISA 7:5"/>అరాము, ఎఫ్రాయిం, రెమల్యా కుమారుడు నీకు కీడు చేయాలని కుట్రపన్ని, <verse eid="ISA 7:5"/><verse number="6" style="v" sid="ISA 7:6"/>“మనం యూదాపై దాడి చేద్దాము; మనం దానిని చీల్చివేసి, మన మధ్యలో పంచుకుందాం, టాబెయేలు కుమారున్ని దానికి రాజుగా చేద్దాం” అని చెప్పుకున్నారు.’ ” <verse eid="ISA 7:6"/><verse number="7" style="v" sid="ISA 7:7"/>అయితే ప్రభువైన యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="ISA 7:7">“అది నిలబడదు,</para>
  <para style="q2" vid="ISA 7:7">అలా జరుగదు.<verse eid="ISA 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 7:8"/>ఎందుకంటే అరాము రాజధాని దమస్కు.</para>
  <para style="q2" vid="ISA 7:8">దమస్కు రాజు రెజీను మాత్రమే.</para>
  <para style="q1" vid="ISA 7:8">అరవై అయిదు సంవత్సరాలు కాకముందే</para>
  <para style="q2" vid="ISA 7:8">ఎఫ్రాయిం ఒక జాతిగా ఉండకుండా నాశనం అయిపోతుంది.<verse eid="ISA 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 7:9"/>ఎఫ్రాయిముకు సమరయ రాజధాని,</para>
  <para style="q2" vid="ISA 7:9">సమరయకు రెమల్యా కుమారుడు రాజు.</para>
  <para style="q1" vid="ISA 7:9">మీరు మీ విశ్వాసంలో స్థిరంగా ఉండకపోతే</para>
  <para style="q2" vid="ISA 7:9">మీరు క్షేమంగా ఉండలేరు.”<verse eid="ISA 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 7:10"/>యెహోవా ఆహాజుతో మరలా మాట్లాడుతూ, <verse eid="ISA 7:10"/><verse number="11" style="v" sid="ISA 7:11"/>“నీ దేవుడైన యెహోవాను ఒక సూచన అడుగు. అది పాతాళమంత లోతైనా సరే, ఆకాశమంత ఎత్తైనా సరే” అన్నారు.<verse eid="ISA 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 7:12"/>అయితే ఆహాజు, “నేను అడగను, యెహోవాను పరీక్షించను” అన్నాడు.<verse eid="ISA 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 7:13"/>అప్పుడు యెషయా, “దావీదు కుటుంబమా! వినండి. మనుష్యుల ఓపికను పరీక్షించడం సరిపోదని, నా దేవుని ఓపికను కూడా పరీక్షిస్తున్నారా? <verse eid="ISA 7:13"/><verse number="14" style="v" sid="ISA 7:14"/>కాబట్టి, ప్రభువే స్వయంగా మీకు ఒక సూచన ఇస్తారు: ఇదిగో ఒక కన్య గర్భం ధరించి ఒక కుమారుని కని, అతనికి ఇమ్మానుయేలు<note caller="+" style="f"><char style="fr" closed="false">7:14 </char><char style="fq" closed="false">ఇమ్మానుయేలు </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">దేవుడు మనకు తోడు</char></note> అని పేరు పెడతారు. <verse eid="ISA 7:14"/><verse number="15" style="v" sid="ISA 7:15"/>తప్పును తిరస్కరించి, సరియైనది ఎంచుకోవడం తెలిసినప్పుడు అతడు పెరుగు, తేనె తింటాడు. <verse eid="ISA 7:15"/><verse number="16" style="v" sid="ISA 7:16"/>ఎందుకంటే తప్పును తిరస్కరించి సరియైనది ఎంచుకునే తెలివి ఆ బాలునికి రాకముందు నిన్ను భయపెట్టే ఆ ఇద్దరు రాజుల దేశాలు పాడుచేయబడతాయి. <verse eid="ISA 7:16"/><verse number="17" style="v" sid="ISA 7:17"/>యెహోవా నీ మీదికి, నీ ప్రజలమీదికి, నీ తండ్రి ఇంటి మీదికి, ఎఫ్రాయిం యూదా నుండి విడిపోయిన రోజు నుండి ఇప్పటివరకు రాని రోజులను రప్పిస్తారు. ఆయన అష్షూరు రాజును నీ మీదికి రప్పిస్తారు” అని అన్నాడు.<verse eid="ISA 7:17"/></para>
  <para style="s1">అష్షూరు యెహోవా పనిముట్టు</para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 7:18"/>ఆ రోజున ఈజిప్టులో నైలు నది పాయల నుండి ఈగలను, అష్షూరు దేశం నుండి కందిరీగలను యెహోవా ఈలవేసి పిలుస్తారు. <verse eid="ISA 7:18"/><verse number="19" style="v" sid="ISA 7:19"/>అవన్నీ వచ్చి మెట్ట కనుమలలో, రాళ్ల పగుళ్లలో, ముళ్ళపొదల్లో, పచ్చికబయళ్లలో నివసిస్తాయి. <verse eid="ISA 7:19"/><verse number="20" style="v" sid="ISA 7:20"/>ఆ రోజున యెహోవా యూఫ్రటీసు నది అవతలి నుండి కూలికి తెచ్చిన మంగలకత్తితో అనగా, అష్షూరు రాజుతో మీ తలవెంట్రుకలు కాళ్లవెంట్రుకలు క్షౌరం చేయిస్తారు. అది మీ గడ్డాలను కూడా గీసివేస్తారు. <verse eid="ISA 7:20"/><verse number="21" style="v" sid="ISA 7:21"/>ఆ రోజున ఒకనికి ఒక చిన్న ఆవు రెండు గొర్రెలు ఉంటాయి. <verse eid="ISA 7:21"/><verse number="22" style="v" sid="ISA 7:22"/>అవి సమృద్ధిగా ఇచ్చిన పాలవలన అతడు తినడానికి పెరుగు ఉంటుంది. ఆ దేశంలో మిగిలిన వారందరు పెరుగు, తేనె తింటారు. <verse eid="ISA 7:22"/><verse number="23" style="v" sid="ISA 7:23"/>ఆ రోజున వెయ్యి వెండి షెకెళ్ళు<note caller="+" style="f"><char style="fr" closed="false">7:23 </char><char style="ft" closed="false">అంటే, సుమారు 12 కి. గ్రా. లు</char></note> విలువ కలిగిన వెయ్యి ద్రాక్షతీగెలు ఉన్న ప్రతిచోట గచ్చపొదలు ముళ్ళచెట్లు ఉంటాయి. <verse eid="ISA 7:23"/><verse number="24" style="v" sid="ISA 7:24"/>ఆ దేశమంతా గచ్చపొదలు ముళ్ళతో నిండి ఉంటుంది కాబట్టి బాణాలు విల్లులు పట్టుకుని వేటగాళ్లు అక్కడికి వెళ్తారు. <verse eid="ISA 7:24"/><verse number="25" style="v" sid="ISA 7:25"/>గచ్చపొదలకు, ముళ్ళకు భయపడి పారతో సాగుచేసిన కొండలన్నిటికి మీరు దూరంగా ఉంటారు; ఆ స్థలాలు పశువులు తిరగడానికి, గొర్రెలు త్రొక్కడానికి ఉపయోగపడతాయి.<verse eid="ISA 7:25"/></para>
  <chapter eid="ISA 7"/>
  <chapter number="8" style="c" sid="ISA 8"/>
  <para style="s1">సూచనలుగా యెషయా, అతని పిల్లలు</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 8:1"/>యెహోవా నాతో ఇలా అన్నారు, “నీవు పెద్ద పలక తీసుకుని దానిపై మహేర్-షాలాల్-హాష్-బజ్<note caller="+" style="f"><char style="fr" closed="false">8:1 </char><char style="fq" closed="false">మహేర్-షాలాల్-హాష్-బజ్ </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">దోచుకోవడానికి త్వరపడడం లేదా కొల్లగొట్టడానికి తొందరపడడం</char><char style="ft" closed="false">; <char style="xt" link-href="ISA 8:3"><ref loc="ISA 8:3">3</ref></char> వచనంలో కూడా</char></note> అని సామాన్యమైన అక్షరాలతో వ్రాయి. <verse eid="ISA 8:1"/><verse number="2" style="v" sid="ISA 8:2"/>నా కోసం నమ్మకమైన సాక్షులుగా ఉండడానికి యాజకుడైన ఊరియాను, యేబెరెక్యా కుమారుడైన జెకర్యాను పిలిచాను. <verse eid="ISA 8:2"/><verse number="3" style="v" sid="ISA 8:3"/>తర్వాత నేను ప్రవక్త్రితో శయనించగా ఆమె గర్భవతియై కుమారునికి జన్మనిచ్చింది. అప్పుడు యెహోవా, ‘అతనికి మహేర్-షాలాల్-హాష్-బజ్ అని పేరు పెట్టు’ అని నాతో చెప్పారు. <verse eid="ISA 8:3"/><verse number="4" style="v" sid="ISA 8:4"/>ఆ పిల్లవాడు నాన్న అమ్మ అని పిలువకముందే, అష్షూరు రాజు దమస్కు సంపదని సమరయ దోపుడుసొమ్మును ఎత్తుకుని పోతాడు.”<verse eid="ISA 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 8:5"/>యెహోవా నాతో మరలా ఇలా మాట్లాడారు:<verse eid="ISA 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 8:6"/>“ఈ ప్రజలు మెల్లగా పారే షిలోహు నీటిని</para>
  <para style="q2" vid="ISA 8:6">వద్దు అని,</para>
  <para style="q1" vid="ISA 8:6">రెజీను గురించి,</para>
  <para style="q2" vid="ISA 8:6">రెమల్యా కుమారుని గురించి సంతోషిస్తున్నారు,<verse eid="ISA 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 8:7"/>కాబట్టి ప్రభువు భయంకరమైన యూఫ్రటీసు నది వరద నీటిని</para>
  <para style="q2" vid="ISA 8:7">అనగా అష్షూరు రాజును, అతని బలగమంతటిని</para>
  <para style="q2" vid="ISA 8:7">వారి మీదికి రప్పించబోతున్నారు.</para>
  <para style="q1" vid="ISA 8:7">అవి దాని కాలువలన్నిటి నుండి ఉప్పొంగి</para>
  <para style="q2" vid="ISA 8:7">దాని ఒడ్డులన్నిటి మీది నుండి ప్రవహిస్తాయి.<verse eid="ISA 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 8:8"/>అవి యూదాలోకి వచ్చి పొంగిపొర్లి ప్రవహిస్తూ,</para>
  <para style="q2" vid="ISA 8:8">గొంతు లోతు వరకు చేరుతాయి.</para>
  <para style="q1" vid="ISA 8:8">ఇమ్మానుయేలూ, దాని చాచిన రెక్కలు</para>
  <para style="q2" vid="ISA 8:8">నీ దేశమంతట వ్యాపిస్తాయి.”<verse eid="ISA 8:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 8:9"/>దేశాల్లారా, మీరు ముక్కలై నాశనమైపోతారు!</para>
  <para style="q2" vid="ISA 8:9">దూర దేశాల్లారా! మీరందరూ వినండి.</para>
  <para style="q1" vid="ISA 8:9">యుద్ధానికి సిద్ధపడండి, మీరు ముక్కలై పొండి!</para>
  <para style="q2" vid="ISA 8:9">అవును, యుద్ధానికి సిద్ధపడండి, మీరు ముక్కలై పొండి!<verse eid="ISA 8:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 8:10"/>మీరు వ్యూహం రచించండి, అది విఫలమవుతుంది;</para>
  <para style="q2" vid="ISA 8:10">మీ ప్రణాళికను ప్రతిపాదించండి, అది నిలబడదు,</para>
  <para style="q2" vid="ISA 8:10">ఎందుకంటే దేవుడు మాతో ఉన్నారు.<note caller="+" style="f"><char style="fr" closed="false">8:10 </char><char style="ft" closed="false">హెబ్రీలో </char><char style="fqa" closed="false">ఇమ్మానుయేలు</char></note><verse eid="ISA 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 8:11"/>ఈ ప్రజల మార్గాన్ని అనుసరించకూడదని యెహోవా నన్ను హెచ్చరించి నాతో ఖచ్చితంగా చెప్పిన మాట ఇదే:<verse eid="ISA 8:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 8:12"/>“ఈ ప్రజలు కుట్ర అని చెప్పే ప్రతిదాన్ని</para>
  <para style="q2" vid="ISA 8:12">కుట్ర అనకండి.</para>
  <para style="q1" vid="ISA 8:12">వారు భయపడే దానికి భయపడకండి.</para>
  <para style="q2" vid="ISA 8:12">దానికి బెదిరిపోకండి.<verse eid="ISA 8:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 8:13"/>సైన్యాల యెహోవాయే పరిశుద్ధుడని మీరు గుర్తించాలి,</para>
  <para style="q2" vid="ISA 8:13">ఆయనకే మీరు భయపడాలి,</para>
  <para style="q2" vid="ISA 8:13">ఆయనకే మీరు భయపడాలి.<verse eid="ISA 8:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 8:14"/>ఆయన పరిశుద్ధ స్థలంగా ఉంటారు;</para>
  <para style="q2" vid="ISA 8:14">అయితే ఆయన ఇశ్రాయేలుకు, యూదాకు</para>
  <para style="q1" vid="ISA 8:14">ప్రజలను తడబడేలా చేసే రాయిలా</para>
  <para style="q2" vid="ISA 8:14">వారిని పడిపోయేలా చేసే బండలా ఉంటారు.</para>
  <para style="q1" vid="ISA 8:14">ఆయన యెరూషలేము ప్రజలకు</para>
  <para style="q2" vid="ISA 8:14">బోనుగా, ఉచ్చుగా ఉంటారు.<verse eid="ISA 8:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 8:15"/>వారిలో అనేకమంది తడబడతారు;</para>
  <para style="q2" vid="ISA 8:15">వారు పడిపోతారు, గాయపరచబడతారు</para>
  <para style="q2" vid="ISA 8:15">వారు ఉచ్చులో చిక్కుకుని పట్టబడతారు.”<verse eid="ISA 8:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 8:16"/>ఈ హెచ్చరిక సాక్ష్యాన్ని కట్టండి</para>
  <para style="q2" vid="ISA 8:16">దేవుని బోధను నా శిష్యుల మధ్యలో ముద్రించండి.<verse eid="ISA 8:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 8:17"/>యాకోబు వారసుల నుండి తన ముఖాన్ని దాస్తున్న</para>
  <para style="q2" vid="ISA 8:17">యెహోవా కోసం నేను ఎదురుచూస్తాను.</para>
  <para style="q1" vid="ISA 8:17">ఆయనపై నా నమ్మకాన్ని ఉంచుతాను.<verse eid="ISA 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 8:18"/>ఇదిగో నేను, యెహోవా నాకిచ్చిన పిల్లలు, సీయోను కొండమీద నివసించే సైన్యాల యెహోవా వలన సూచనలుగా, గుర్తులుగా ఇశ్రాయేలీయుల మధ్య ఉన్నాము.<verse eid="ISA 8:18"/></para>
  <para style="s1">చీకటి వెలుగుగా మారుట</para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 8:19"/>మీతో ఎవరైనా, గుసగుసలాడే గొణిగే మృతుల ఆత్మలతో మాట్లాడేవారిని, ఆత్మలతో మాట్లాడేవారిని సంప్రదించమని చెప్పినప్పుడు, ప్రజలు తమ దేవుని దగ్గరే విచారించాలి కదా? సజీవుల గురించి చచ్చిన వారిని ఎందుకు సంప్రదించాలి? <verse eid="ISA 8:19"/><verse number="20" style="v" sid="ISA 8:20"/>దేవుని బోధను, హెచ్చరిక సాక్ష్యాన్ని దృష్టి నిలపండి. ఈ వాక్యం ప్రకారం మాట్లాడని వారికి ఉదయపు వెలుగు ఉండదు. <verse eid="ISA 8:20"/><verse number="21" style="v" sid="ISA 8:21"/>వారు బాధపడుతూ ఆకలితో దేశమంతా తిరుగుతారు; వారు ఆకలితో ఉన్నప్పుడు వారు కోపంతో పైకి చూస్తూ తమ రాజును, తమ దేవుని శపిస్తారు. <verse eid="ISA 8:21"/><verse number="22" style="v" sid="ISA 8:22"/>వారు భూమివైపు చూడగా వారికి బాధ, చీకటి, భయంకరమైన దుఃఖం మాత్రమే కనబడతాయి. వారు దట్టమైన చీకటిలోకి త్రోయబడతారు.<verse eid="ISA 8:22"/></para>
  <chapter eid="ISA 8"/>
  <chapter number="9" style="c" sid="ISA 9"/>
  <para style="p">
    <verse number="1" style="v" sid="ISA 9:1"/>అయినప్పటికీ బాధలో ఉన్నవారికి ఇక చీకటి ఉండదు. పూర్వకాలంలో ఆయన జెబూలూను, నఫ్తాలి ప్రాంతాలను అవమానపరిచారు కాని రాబోయే కాలంలో ఆయన సముద్ర ప్రాంతాన్ని అనగా యొర్దానుకు అవతలనున్న సముద్రతీరంలో యూదేతరులు ఉండే గలిలయ ప్రాంతాన్ని ఘనపరుస్తారు.<verse eid="ISA 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 9:2"/>చీకటిలో జీవిస్తున్న ప్రజలు</para>
  <para style="q2" vid="ISA 9:2">గొప్ప వెలుగును చూశారు;</para>
  <para style="q1" vid="ISA 9:2">చిమ్మచీకటిగల దేశంలో నివసించేవారి మీద</para>
  <para style="q2" vid="ISA 9:2">ఒక వెలుగు ప్రకాశించింది.<verse eid="ISA 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 9:3"/>మీరు దేశాన్ని విస్తరింపజేశారు</para>
  <para style="q2" vid="ISA 9:3">వారి సంతోషాన్ని అధికం చేశారు;</para>
  <para style="q1" vid="ISA 9:3">కోతకాలంలో ప్రజలు సంతోషించినట్లు</para>
  <para style="q2" vid="ISA 9:3">దోపుడుసొమ్ము పంచుకుంటున్నప్పుడు</para>
  <para style="q1" vid="ISA 9:3">యుద్ధవీరులు సంతోషించినట్లు</para>
  <para style="q2" vid="ISA 9:3">వారు మీ ఎదుట సంతోషిస్తున్నారు.<verse eid="ISA 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 9:4"/>మిద్యాను ఓడిపోయిన రోజు జరిగినట్లు,</para>
  <para style="q2" vid="ISA 9:4">వారికి భారం కలిగించే కాడిని</para>
  <para style="q1" vid="ISA 9:4">వారి భుజాలమీద ఉన్న కర్రను,</para>
  <para style="q2" vid="ISA 9:4">వారిని హింసించేవాని కర్రను</para>
  <para style="q2" vid="ISA 9:4">మీరు విరిచివేశారు.<verse eid="ISA 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 9:5"/>యుద్ధంలో వాడిన వీరుల చెప్పులు</para>
  <para style="q2" vid="ISA 9:5">రక్తంలో చుట్టబడిన బట్టలు</para>
  <para style="q1" vid="ISA 9:5">మంటలో వేయబడతాయి</para>
  <para style="q2" vid="ISA 9:5">అగ్నికి ఇంధనంగా అవుతాయి.<verse eid="ISA 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 9:6"/>ఎందుకంటే మన కోసం ఒక శిశువు పుట్టాడు,</para>
  <para style="q2" vid="ISA 9:6">మనకు కుమారుడు అనుగ్రహించబడ్డాడు.</para>
  <para style="q2" vid="ISA 9:6">ఆయన భుజం మీద రాజ్యభారం ఉంటుంది.</para>
  <para style="q1" vid="ISA 9:6">ఆయన అద్భుతమైన ఆలోచనకర్త, బలవంతుడైన దేవుడు</para>
  <para style="q2" vid="ISA 9:6">నిత్యుడైన తండ్రి, సమాధానాధిపతి</para>
  <para style="q2" vid="ISA 9:6">అని పిలువబడతాడు.<verse eid="ISA 9:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 9:7"/>ఆయన ప్రభుత్వానికి, సమాధానానికి గొప్పతనానికి</para>
  <para style="q2" vid="ISA 9:7">ముగింపు ఉండదు.</para>
  <para style="q1" vid="ISA 9:7">ఆయన అప్పటినుండి ఎల్లకాలం వరకు</para>
  <para style="q2" vid="ISA 9:7">దావీదు సింహాసనం మీద,</para>
  <para style="q1" vid="ISA 9:7">అతని రాజ్యాన్ని ఏలుతూ,</para>
  <para style="q2" vid="ISA 9:7">న్యాయంతోను నీతితోను</para>
  <para style="q2" vid="ISA 9:7">రాజ్యాన్ని స్థాపించి స్థిరంగా ఉంచుతారు.</para>
  <para style="q1" vid="ISA 9:7">సైన్యాలకు అధిపతియైన యెహోవా</para>
  <para style="q2" vid="ISA 9:7">ఆసక్తి దీనిని నెరవేరుస్తుంది.<verse eid="ISA 9:7"/></para>
  <para style="s1">ఇశ్రాయేలీయుల మీద యెహోవా కోపం</para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 9:8"/>ప్రభువు యాకోబుకు వ్యతిరేకంగా ఒక సందేశం పంపారు;</para>
  <para style="q2" vid="ISA 9:8">అది ఇశ్రాయేలు మీద పడుతుంది.<verse eid="ISA 9:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 9:9"/>గర్వం, అహంకారంతో నిండిన</para>
  <para style="q2" vid="ISA 9:9">హృదయం కలిగిన ప్రజలందరు</para>
  <para style="q1" vid="ISA 9:9">అనగా ఎఫ్రాయిం, సమరయ వాసులు</para>
  <para style="q2" vid="ISA 9:9">దానిని తెలుసుకుంటారు.<verse eid="ISA 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 9:10"/>“ఇటుకలు పడిపోయాయి,</para>
  <para style="q2" vid="ISA 9:10">కాని మనం చెక్కిన రాళ్లతో మళ్ళీ కడదాము;</para>
  <para style="q1" vid="ISA 9:10">రావి చెట్లు నరకబడ్డాయి,</para>
  <para style="q2" vid="ISA 9:10">వాటికి బదులుగా దేవదారులను వేద్దాం” అని అంటారు.<verse eid="ISA 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 9:11"/>అయితే యెహోవా వారి మీదికి రెజీను విరోధులను లేపారు</para>
  <para style="q2" vid="ISA 9:11">వారి శత్రువులను పురికొల్పారు.<verse eid="ISA 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 9:12"/>తూర్పు నుండి అరామీయులు, పడమర నుండి ఫిలిష్తీయులు</para>
  <para style="q2" vid="ISA 9:12">నోరు తెరచి ఇశ్రాయేలును మ్రింగివేశారు.</para>
  <para style="b" vid="ISA 9:12"/>
  <para style="q1" vid="ISA 9:12">ఇంత జరిగినా ఆయన కోపం చల్లారలేదు,</para>
  <para style="q2" vid="ISA 9:12">ఆయన చేయి ఇంకా ఎత్తి ఉంది.<verse eid="ISA 9:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 9:13"/>అయితే ప్రజలు తమను కొట్టినవాడి వైపు తిరుగలేదు,</para>
  <para style="q2" vid="ISA 9:13">సైన్యాల యెహోవాను వారు వెదకలేదు.<verse eid="ISA 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 9:14"/>కాబట్టి యెహోవా ఇశ్రాయేలులో నుండి తలను, తోకను,</para>
  <para style="q2" vid="ISA 9:14">తాటికొమ్మను, జమ్ము రెల్లును ఒకేరోజున తొలగిస్తారు.<verse eid="ISA 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 9:15"/>పెద్దలు ప్రముఖులు తల అయితే,</para>
  <para style="q2" vid="ISA 9:15">అబద్ధాలు చెప్పే ప్రవక్తలు తోక.<verse eid="ISA 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 9:16"/>ఈ ప్రజలను నడిపించేవారు వారిని తప్పుదారి పట్టిస్తారు;</para>
  <para style="q2" vid="ISA 9:16">వారిని వెంబడించేవారు చెదిరిపోతారు.<verse eid="ISA 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 9:17"/>కాబట్టి ప్రభువు యువకులను చూసి సంతోషించరు</para>
  <para style="q2" vid="ISA 9:17">తండ్రిలేనివారి పట్ల, విధవరాండ్ర పట్ల జాలి చూపరు.</para>
  <para style="q1" vid="ISA 9:17">ఎందుకంటే, ప్రతి ఒక్కరు భక్తిహీనులుగా దుర్మార్గులుగా ఉన్నారు,</para>
  <para style="q2" vid="ISA 9:17">ప్రతి నోరు మూర్ఖంగా మాట్లాడుతుంది.</para>
  <para style="b" vid="ISA 9:17"/>
  <para style="q1" vid="ISA 9:17">ఇంత జరిగినా ఆయన కోపం చల్లారలేదు,</para>
  <para style="q2" vid="ISA 9:17">ఆయన చేయి ఇంకా ఎత్తి ఉంది.<verse eid="ISA 9:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 9:18"/>ఖచ్చితంగా దుష్టత్వం అగ్నిలా మండుతుంది</para>
  <para style="q2" vid="ISA 9:18">అది గచ్చపొదలను, ముళ్ళచెట్లను కాల్చివేస్తుంది;</para>
  <para style="q1" vid="ISA 9:18">అడవి పొదలను దహనం చేసి</para>
  <para style="q2" vid="ISA 9:18">దట్టమైన పొగలా పైకి లేస్తుంది.<verse eid="ISA 9:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 9:19"/>సైన్యాల యెహోవా ఉగ్రత వలన</para>
  <para style="q2" vid="ISA 9:19">భూమి కాలిపోతుంది</para>
  <para style="q1" vid="ISA 9:19">ప్రజలు అగ్నికి ఇంధనం అవుతారు;</para>
  <para style="q2" vid="ISA 9:19">వారిలో ఒకరిపై మరొకరికి కనికరం ఉండదు.<verse eid="ISA 9:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 9:20"/>కుడి ప్రక్కన దానిని వారు మ్రింగుతారు</para>
  <para style="q2" vid="ISA 9:20">కాని ఇంకా ఆకలితోనే ఉంటారు.</para>
  <para style="q1" vid="ISA 9:20">ఎడమ ప్రక్కన దానిని తింటారు</para>
  <para style="q2" vid="ISA 9:20">కాని తృప్తి పొందరు.</para>
  <para style="q1" vid="ISA 9:20">వారిలో ప్రతిఒక్కరు తన సంతానం<note caller="+" style="f"><char style="fr" closed="false">9:20 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">చేతి</char></note> యొక్క మాంసాన్ని తింటారు.<verse eid="ISA 9:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="ISA 9:21"/>మనష్షే ఎఫ్రాయిమును, ఎఫ్రాయిం మనష్షేను తింటారు.</para>
  <para style="q2" vid="ISA 9:21">వీరిద్దరు కలిసి యూదా మీద పడతారు.</para>
  <para style="b" vid="ISA 9:21"/>
  <para style="q1" vid="ISA 9:21">ఇంత జరిగినా ఆయన కోపం చల్లారలేదు,</para>
  <para style="q2" vid="ISA 9:21">ఆయన చేయి ఇంకా ఎత్తి ఉంది.<verse eid="ISA 9:21"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 9"/>
  <chapter number="10" style="c" sid="ISA 10"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 10:1"/>అన్యాయపు చట్టాలు చేసేవారికి,</para>
  <para style="q2" vid="ISA 10:1">చెడు శాసనాలు చేసేవారికి శ్రమ.<verse eid="ISA 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 10:2"/>వారు పేదల హక్కులను హరిస్తారు,</para>
  <para style="q2" vid="ISA 10:2">నా ప్రజల్లో అణచివేయబడిన వారికి న్యాయం చేరనివ్వరు</para>
  <para style="q1" vid="ISA 10:2">వారు విధవరాండ్రను తమ దోపుడు సొమ్ముగా చేసుకుంటూ</para>
  <para style="q2" vid="ISA 10:2">తండ్రిలేనివారిని దోచుకుంటారు.<verse eid="ISA 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 10:3"/>తీర్పు తీర్చే రోజున,</para>
  <para style="q2" vid="ISA 10:3">దూరం నుండి విపత్తు వచ్చినప్పుడు మీరేమి చేస్తారు?</para>
  <para style="q1" vid="ISA 10:3">సహాయం కోసం ఎవరి దగ్గరకు పరుగెత్తుతారు?</para>
  <para style="q2" vid="ISA 10:3">మీ సంపదను ఎక్కడ వదిలివేస్తారు?<verse eid="ISA 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 10:4"/>బంధించబడిన వారి మధ్య మోకరిల్లడం</para>
  <para style="q2" vid="ISA 10:4">చనిపోయినవారి మధ్య పడిపోవడం తప్ప మరేమీ మిగలదు.</para>
  <para style="b" vid="ISA 10:4"/>
  <para style="q1" vid="ISA 10:4">ఇంత జరిగినా ఆయన కోపం చల్లారలేదు</para>
  <para style="q2" vid="ISA 10:4">ఆయన చేయి ఇంకా ఎత్తి ఉంది.<verse eid="ISA 10:4"/></para>
  <para style="s1">అష్షూరుపై దేవుని తీర్పు</para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 10:5"/>అష్షూరుకు శ్రమ, అతడు నా కోపం అనే దండం</para>
  <para style="q2" vid="ISA 10:5">నా ఉగ్రత అనే దుడ్డుకర్ర అతని చేతిలో ఉంది.<verse eid="ISA 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 10:6"/>దేవుడు లేని దేశం మీదికి నేను అతన్ని పంపుతాను,</para>
  <para style="q2" vid="ISA 10:6">దోచుకోడానికి కొల్లగొట్టడానికి,</para>
  <para style="q1" vid="ISA 10:6">వీధుల్లో మట్టిలా వారిని త్రొక్కడానికి</para>
  <para style="q2" vid="ISA 10:6">నాకు కోపం కలిగించిన ప్రజల గురించి అతన్ని ఆజ్ఞాపిస్తాను.<verse eid="ISA 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 10:7"/>అయితే ఇది అతడు ఉద్దేశించింది కాదు,</para>
  <para style="q2" vid="ISA 10:7">ఇది అతని మనస్సులో ఉన్నది అది కాదు.</para>
  <para style="q1" vid="ISA 10:7">నాశనం చేయాలని,</para>
  <para style="q2" vid="ISA 10:7">చాలా దేశాలను నిర్మూలించాలన్నది అతని ఉద్దేశము.<verse eid="ISA 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 10:8"/>అతడు, “నా అధిపతులందరు రాజులు కారా?<verse eid="ISA 10:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="ISA 10:9"/>కల్నో, కర్కెమీషులా ఉండలేదా?</para>
  <para style="q1" vid="ISA 10:9">హమాతు అర్పదులా ఉండలేదా</para>
  <para style="q2" vid="ISA 10:9">సమరయ దమస్కులా ఉండలేదా?<verse eid="ISA 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 10:10"/>విగ్రహాలను పూజించే రాజ్యాలను నా చేయి పట్టుకున్నట్లు,</para>
  <para style="q2" vid="ISA 10:10">వాటి విగ్రహాలు యెరూషలేము సమరయుల విగ్రహాల కన్న ఎక్కువగా ఉన్నాయి.<verse eid="ISA 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 10:11"/>నేను సమరయకు దాని విగ్రహాలకు చేసినట్లు</para>
  <para style="q2" vid="ISA 10:11">యెరూషలేముకు దాని విగ్రహాలకు చేయవద్దా?”<verse eid="ISA 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 10:12"/>ప్రభువు సీయోను పర్వతానికి, యెరూషలేముకు వ్యతిరేకంగా పని ముగించిన తర్వాత ఆయన ఇలా అంటారు, “నేను అష్షూరు రాజుకు ఉన్న హృదయపు గర్వం యొక్క ఫలితం బట్టి అతని కళ్లల్లో ఉన్న అహంకారపు చూపును బట్టి అతన్ని శిక్షిస్తాను. <verse eid="ISA 10:12"/><verse number="13" style="v" sid="ISA 10:13"/>ఎందుకంటే అతడు ఇలా అన్నాడు:</para>
  <para style="q1" vid="ISA 10:13">“ ‘నేను వివేకిని, నా బాహుబలం చేత,</para>
  <para style="q2" vid="ISA 10:13">నా జ్ఞానంతో దీన్ని చేశాను.</para>
  <para style="q1" vid="ISA 10:13">నేను ప్రజల సరిహద్దులు తీసివేశాను,</para>
  <para style="q2" vid="ISA 10:13">వారి సంపదలు దోచుకున్నాను;</para>
  <para style="q2" vid="ISA 10:13">బలవంతునిలా వారి రాజులను అణచివేశాను.<note caller="+" style="f"><char style="fr" closed="false">10:13 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">బలవంతులను అణచివేశాను</char></note><verse eid="ISA 10:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 10:14"/>పక్షి గూటిలోనికి చేరునట్లు</para>
  <para style="q2" vid="ISA 10:14">నా చేయి దేశాల సంపదను చేరుకుంది;</para>
  <para style="q1" vid="ISA 10:14">ప్రజలు విడిచిపెట్టిన గుడ్లు ఏరుకున్నట్లుగా,</para>
  <para style="q2" vid="ISA 10:14">నేను అన్ని దేశాలను సమకూర్చుకున్నాను;</para>
  <para style="q1" vid="ISA 10:14">ఏ ఒక్కటి రెక్కలు ఆడించలేదు లేదా</para>
  <para style="q2" vid="ISA 10:14">కిచకిచమనడానికి నోరు తెరవలేదు.’ ”<verse eid="ISA 10:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 10:15"/>గొడ్డలి తనను ఉపయోగించే వ్యక్తి కన్నా అతిశయపడుతుందా,</para>
  <para style="q2" vid="ISA 10:15">రంపం దానిని ఉపయోగించే వ్యక్తి మీద ప్రగల్భాలు పలుకుతుందా?</para>
  <para style="q1" vid="ISA 10:15">కర్ర తనను ఎత్తేవానిని ఆడించినట్లు</para>
  <para style="q2" vid="ISA 10:15">దుడ్డుకర్ర కర్రకానివాన్ని ఆడిస్తుంది!<verse eid="ISA 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 10:16"/>కాబట్టి, సైన్యాల అధిపతియైన యెహోవా,</para>
  <para style="q2" vid="ISA 10:16">అష్షూరీయుల బలమైన వీరుల మీదికి పాడుచేసే రోగాన్ని పంపుతారు;</para>
  <para style="q1" vid="ISA 10:16">వారి మహిమను కాల్చడానికి</para>
  <para style="q2" vid="ISA 10:16">వారి క్రింద మండుతున్న జ్వాలల వంటి అగ్ని మండుతుంది.<verse eid="ISA 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 10:17"/>ఇశ్రాయేలు వెలుగు అగ్నిగా మారుతుంది,</para>
  <para style="q2" vid="ISA 10:17">వారి పరిశుద్ధ దేవుడు అగ్నిజ్వాలగా మారుతారు;</para>
  <para style="q1" vid="ISA 10:17">అతని ముళ్ళచెట్లను, గచ్చపొదలను</para>
  <para style="q2" vid="ISA 10:17">ఒక రోజులోనే వాటిని కాల్చి, దహించివేస్తుంది.<verse eid="ISA 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 10:18"/>ఒక రోగి ఆరోగ్యం క్షీణించిపోవునట్లు</para>
  <para style="q2" vid="ISA 10:18">అతని అడవికి, సారవంతమైన పొలాలకు ఉన్న వైభవాన్ని</para>
  <para style="q2" vid="ISA 10:18">అది పూర్తిగా నాశనం చేస్తుంది.<verse eid="ISA 10:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 10:19"/>అతని అడవిలో మిగిలిన చెట్లు కొన్నే మిగులుతాయి</para>
  <para style="q2" vid="ISA 10:19">పిల్లవాడు కూడా వాటిని లెక్కపెట్టవచ్చు.<verse eid="ISA 10:19"/></para>
  <para style="s1">ఇశ్రాయేలులో మిగిలినవారు</para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 10:20"/>ఆ రోజున ఇశ్రాయేలులో మిగిలినవారు</para>
  <para style="q2" vid="ISA 10:20">యాకోబు కుటుంబంలో తప్పించుకున్నవారు</para>
  <para style="q1" vid="ISA 10:20">తమను మొత్తిన వానిని</para>
  <para style="q2" vid="ISA 10:20">ఇక ఆశ్రయించరు</para>
  <para style="q1" vid="ISA 10:20">కాని ఇశ్రాయేలీయుల పరిశుద్ధ దేవుడైన యెహోవాను</para>
  <para style="q2" vid="ISA 10:20">వారు నిజంగా ఆశ్రయిస్తారు.<verse eid="ISA 10:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 10:21"/>మిగిలినవారు తిరిగి వస్తారు, యాకోబులో మిగిలినవారు</para>
  <para style="q2" vid="ISA 10:21">బలవంతుడైన దేవుని వైపు తిరుగుతారు.<verse eid="ISA 10:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 10:22"/>నీ ప్రజలైన ఇశ్రాయేలు సముద్రపు ఇసుకంత విస్తారంగా ఉన్నా,</para>
  <para style="q2" vid="ISA 10:22">వారిలో మిగిలినవారే తిరుగుతారు.</para>
  <para style="q1" vid="ISA 10:22">నాశనం శాసించబడింది</para>
  <para style="q2" vid="ISA 10:22">నీతియుక్తమైన శిక్ష ఉప్పొంగి ప్రవహిస్తుంది.<verse eid="ISA 10:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 10:23"/>ప్రభువు, సైన్యాల యెహోవా</para>
  <para style="q2" vid="ISA 10:23">భూమి అంతటా నిర్ణయించబడిన నాశనాన్ని కలుగజేస్తారు.<verse eid="ISA 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 10:24"/>కాబట్టి సైన్యాల అధిపతియైన యెహోవా చెప్పే మాట ఇది:</para>
  <para style="q1" vid="ISA 10:24">“సీయోనులో నివసిస్తున్న నా ప్రజలారా,</para>
  <para style="q2" vid="ISA 10:24">ఈజిప్టులో చేసినట్టు కర్రతో మిమ్మల్ని కొట్టి</para>
  <para style="q1" vid="ISA 10:24">మీమీద తన దుడ్డుకర్ర ఎత్తిన</para>
  <para style="q2" vid="ISA 10:24">అష్షూరీయులకు భయపడకండి.<verse eid="ISA 10:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 10:25"/>అతిత్వరలో మీమీద నా కోపం చల్లారుతుంది</para>
  <para style="q2" vid="ISA 10:25">నా ఉగ్రత వారి నాశనానికి దారి తీస్తుంది.”<verse eid="ISA 10:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 10:26"/>ఓరేబు బండ దగ్గర మిద్యానును చంపినట్లు</para>
  <para style="q2" vid="ISA 10:26">సైన్యాల యెహోవా తన కొరడాతో వారిని కొడతారు;</para>
  <para style="q1" vid="ISA 10:26">ఆయన ఈజిప్టులో చేసినట్టు</para>
  <para style="q2" vid="ISA 10:26">తన దండాన్ని సముద్రం మీద ఎత్తుతారు.<verse eid="ISA 10:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 10:27"/>ఆ రోజు వారి భుజాలపై నుండి వారి బరువు తీసివేయబడుతుంది,</para>
  <para style="q2" vid="ISA 10:27">మీ మెడపై నుండి వారి కాడి కొట్టివేయబడుతుంది.</para>
  <para style="q1" vid="ISA 10:27">మీరు బలంగా ఉన్నందుకు</para>
  <para style="q2" vid="ISA 10:27">ఆ కాడి విరిగిపోతుంది.<verse eid="ISA 10:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 10:28"/>అష్షూరీయులు ఆయాతులో ప్రవేశించారు;</para>
  <para style="q2" vid="ISA 10:28">మిగ్రోను గుండా వెళ్లారు;</para>
  <para style="q2" vid="ISA 10:28">మిక్మషులో తమ సామాను ఉంచారు.<verse eid="ISA 10:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 10:29"/>వారు మార్గం దాటి వెళ్తూ,</para>
  <para style="q2" vid="ISA 10:29">“మేము గెబాలో రాత్రి బస చేస్తాం” అంటున్నారు.</para>
  <para style="q1" vid="ISA 10:29">రామా వణకుతుంది;</para>
  <para style="q2" vid="ISA 10:29">సౌలు గిబియా పారిపోతుంది.<verse eid="ISA 10:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 10:30"/>గల్లీము కుమార్తె! కేకలు వేయి</para>
  <para style="q2" vid="ISA 10:30">లాయిషా, విను!</para>
  <para style="q2" vid="ISA 10:30">అయ్యయ్యో, అనాతోతు!<verse eid="ISA 10:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 10:31"/>మద్మేనా ప్రజలు పారిపోతారు.</para>
  <para style="q2" vid="ISA 10:31">గెబీము నివాసులు దాక్కుంటారు.<verse eid="ISA 10:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 10:32"/>ఈ రోజే వారు నోబులో దిగుతారు;</para>
  <para style="q2" vid="ISA 10:32">ఈ రోజే సీయోను కుమారి పర్వతం,</para>
  <para style="q1" vid="ISA 10:32">యెరూషలేము కొండ వైపు</para>
  <para style="q2" vid="ISA 10:32">వారు తమ పిడికిలి ఆడిస్తారు.<verse eid="ISA 10:32"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="33" style="v" sid="ISA 10:33"/>చూడండి, ప్రభువు, సైన్యాల అధిపతియైన యెహోవా</para>
  <para style="q2" vid="ISA 10:33">మహాబలంతో కొమ్మలు నరుకుతారు.</para>
  <para style="q1" vid="ISA 10:33">ఉన్నతమైన చెట్లు నరకబడతాయి,</para>
  <para style="q2" vid="ISA 10:33">ఎత్తైనవి పడగొట్టబడతాయి.<verse eid="ISA 10:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="ISA 10:34"/>ఆయన అడవి పొదలను గొడ్డలితో నరుకుతారు;</para>
  <para style="q2" vid="ISA 10:34">బలవంతుని ఎదుట లెబానోను పడిపోతుంది.<verse eid="ISA 10:34"/></para>
  <chapter eid="ISA 10"/>
  <chapter number="11" style="c" sid="ISA 11"/>
  <para style="s1">యెష్షయి కొమ్మ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 11:1"/>యెష్షయి మొద్దు నుండి చిగురు పుడుతుంది;</para>
  <para style="q2" vid="ISA 11:1">అతని వేరుల నుండి కొమ్మ ఫలిస్తుంది.<verse eid="ISA 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 11:2"/>యెహోవా ఆత్మ జ్ఞానం వివేకం కలిగించే ఆత్మ,</para>
  <para style="q2" vid="ISA 11:2">ఆలోచనను బలాన్ని ఇచ్చే ఆత్మ,</para>
  <para style="q2" vid="ISA 11:2">తెలివిని, యెహోవా పట్ల భయం కలిగించే ఆత్మ,</para>
  <para style="q2" vid="ISA 11:2">అతని మీద ఉంటుంది.<verse eid="ISA 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 11:3"/>యెహోవాయందలి భయంతో అతడు సంతోషిస్తాడు.</para>
  <para style="b" vid="ISA 11:3"/>
  <para style="q1" vid="ISA 11:3">అతడు తన కళ్లతో చూసిన దానిని బట్టి తీర్పు తీర్చడు,</para>
  <para style="q2" vid="ISA 11:3">తన చెవులతో విన్నదానిని బట్టి నిర్ణయం తీసుకోడు;<verse eid="ISA 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 11:4"/>కాని నీతిగా పేదలకు తీర్పు తీరుస్తాడు,</para>
  <para style="q2" vid="ISA 11:4">భూమిపై ఉన్న పేదల కోసం న్యాయంతో నిర్ణయాలు తీసుకుంటాడు.</para>
  <para style="q1" vid="ISA 11:4">అతడు తన నోటి దండంతో భూమిని కొడతాడు;</para>
  <para style="q2" vid="ISA 11:4">తన పెదవుల ఊపిరిచేత దుష్టులను చంపుతాడు.<verse eid="ISA 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 11:5"/>నీతి అతని నడికట్టుగా ఉంటుంది</para>
  <para style="q2" vid="ISA 11:5">నమ్మకత్వం అతని తుంటికి నడికట్టుగా ఉంటుంది.<verse eid="ISA 11:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 11:6"/>తోడేలు గొర్రెపిల్లతో నివసిస్తుంది,</para>
  <para style="q2" vid="ISA 11:6">చిరుతపులి మేకతో పడుకుంటుంది,</para>
  <para style="q1" vid="ISA 11:6">దూడ, కొదమసింహం, బలిపశువు కలిసి ఉంటాయి;</para>
  <para style="q2" vid="ISA 11:6">చిన్న పిల్లవాడు వాటిని నడిపిస్తాడు.<verse eid="ISA 11:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 11:7"/>ఆవు ఎలుగుబంటి కలిసి మేస్తాయి,</para>
  <para style="q2" vid="ISA 11:7">వాటి పిల్లలు ఒక్క చోటే పడుకుంటాయి.</para>
  <para style="q2" vid="ISA 11:7">ఎద్దు మేసినట్లు సింహం గడ్డిమేస్తుంది.<verse eid="ISA 11:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 11:8"/>పసిపిల్ల నాగుపాము పుట్ట దగ్గర ఆటలాడుతుంది.</para>
  <para style="q2" vid="ISA 11:8">విషసర్పం పుట్టలో చిన్న బిడ్డ తన చేయి పెడుతుంది.<verse eid="ISA 11:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 11:9"/>నా పరిశుద్ధ పర్వతమంతటా</para>
  <para style="q2" vid="ISA 11:9">అవి హాని చేయవు, నాశనం చేయవు.</para>
  <para style="q1" vid="ISA 11:9">నీళ్లు సముద్రాన్ని కప్పినట్లు</para>
  <para style="q2" vid="ISA 11:9">యెహోవా జ్ఞానంతో భూమి నిండి ఉంటుంది.<verse eid="ISA 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="ISA 11:10"/>ఆ రోజున యెష్షయి వేరు జనాంగాలకు ధ్వజంగా నిలుస్తుంది; దేశాలు అతనివైపు వస్తాయి, అతని విశ్రాంతి స్థలం మహిమగలదిగా ఉంటుంది. <verse eid="ISA 11:10"/><verse number="11" style="v" sid="ISA 11:11"/>ఆ రోజున తన ప్రజల్లో మిగిలి ఉన్న శేషాన్ని అష్షూరు, ఈజిప్టు, పత్రూసు, కూషు,<note caller="+" style="f"><char style="fr" closed="false">11:11 </char><char style="ft" closed="false">అంటే, నైలు ఉపరితల ప్రాంతం</char></note> ఏలాము, బబులోను<note caller="+" style="f"><char style="fr" closed="false">11:11 </char><char style="ft" closed="false">అంటే, </char><char style="fqa" closed="false">షీనారు</char></note>, హమాతులలో నుండి, మధ్యధరా సముద్ర ద్వీపాల్లో నుండి విడిపించి రప్పించడానికి యెహోవా రెండవసారి తన చేయి చాపుతారు.<verse eid="ISA 11:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 11:12"/>దేశాల కోసం ఆయన ఒక జెండా పైకి ఎత్తుతారు</para>
  <para style="q2" vid="ISA 11:12">చెరగొనిపోబడిన ఇశ్రాయేలీయులను పోగుచేస్తారు;</para>
  <para style="q1" vid="ISA 11:12">భూమి నలుదిక్కుల నుండి</para>
  <para style="q2" vid="ISA 11:12">ఆయన చెదరిపోయిన యూదా ప్రజలను సమకూర్చుతారు.<verse eid="ISA 11:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 11:13"/>ఎఫ్రాయిముకున్న అసూయ పోతుంది,</para>
  <para style="q2" vid="ISA 11:13">యూదా శత్రువులు నశిస్తారు.</para>
  <para style="q1" vid="ISA 11:13">ఎఫ్రాయిం యూదాపై అసూయపడదు,</para>
  <para style="q2" vid="ISA 11:13">యూదా ఎఫ్రాయింతో విరోధంగా ఉండదు.<verse eid="ISA 11:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 11:14"/>వారు పడమటి వైపు ఫిలిష్తీయ వాలుల మీద దూకుతారు;</para>
  <para style="q2" vid="ISA 11:14">వారు కలిసి తూర్పు ప్రజలను దోచుకుంటారు.</para>
  <para style="q1" vid="ISA 11:14">వారు ఎదోమును, మోయాబును లోబరచుకుంటారు,</para>
  <para style="q2" vid="ISA 11:14">అమ్మోనీయులు వారికి లోబడతారు.<verse eid="ISA 11:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 11:15"/>యెహోవా ఈజిప్టు సముద్రపు</para>
  <para style="q2" vid="ISA 11:15">అగాధాన్ని నాశనం చేస్తారు;</para>
  <para style="q1" vid="ISA 11:15">తన వేడి గాలితో</para>
  <para style="q2" vid="ISA 11:15">యూఫ్రటీసు నది మీద తన చేయి ఆడిస్తారు.</para>
  <para style="q1" vid="ISA 11:15">ఆయన ఏడు కాలువలుగా దానిని చీల్చుతారు</para>
  <para style="q2" vid="ISA 11:15">చెప్పులు తడువకుండ మనుష్యులు దానిని దాటేలా చేస్తారు.<verse eid="ISA 11:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 11:16"/>ఈజిప్టు దేశం నుండి ఇశ్రాయేలు వచ్చిన రోజున</para>
  <para style="q2" vid="ISA 11:16">వారికి దారి ఏర్పడినట్లు</para>
  <para style="q1" vid="ISA 11:16">అష్షూరు నుండి వచ్చే</para>
  <para style="q2" vid="ISA 11:16">ఆయన ప్రజల్లో మిగిలిన వారికి రాజమార్గం ఉంటుంది.<verse eid="ISA 11:16"/></para>
  <chapter eid="ISA 11"/>
  <chapter number="12" style="c" sid="ISA 12"/>
  <para style="s1">స్తుతి పాటలు</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 12:1"/>ఆ రోజున మీరు ఇలా అంటారు:</para>
  <para style="q1" vid="ISA 12:1">“యెహోవా, నేను మిమ్మల్ని స్తుతిస్తాను.</para>
  <para style="q2" vid="ISA 12:1">మీరు నాపై కోప్పడినా కూడా</para>
  <para style="q1" vid="ISA 12:1">మీ కోపం చల్లారింది</para>
  <para style="q2" vid="ISA 12:1">మీరు నన్ను ఆదరించారు.<verse eid="ISA 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 12:2"/>నిజంగా దేవుడే నా రక్షణ;</para>
  <para style="q2" vid="ISA 12:2">నేను భయపడను ఆయనను నమ్ముతాను.</para>
  <para style="q1" vid="ISA 12:2">యెహోవా యెహోవాయే నా బలం, నా ఆత్మరక్షణ;</para>
  <para style="q2" vid="ISA 12:2">ఆయనే నా రక్షణ అయ్యారు.”<verse eid="ISA 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 12:3"/>మీరు రక్షణ బావులలో నుండి</para>
  <para style="q2" vid="ISA 12:3">ఆనందంతో నీళ్లు చేదుతారు.<verse eid="ISA 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 12:4"/>ఆ రోజున మీరు ఇలా అంటారు:</para>
  <para style="q1" vid="ISA 12:4">“యెహోవాకు స్తుతి చెల్లించండి, ఆయన నామాన్ని ప్రకటించండి;</para>
  <para style="q2" vid="ISA 12:4">దేశాల్లో ఆయన చేసిన కార్యాలను తెలియజేయండి,</para>
  <para style="q2" vid="ISA 12:4">ఆయన పేరు ఘనమైనదని ప్రకటించండి.<verse eid="ISA 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 12:5"/>యెహోవాకు స్తుతి చెల్లించండి, ఆయన మహిమగల కార్యాలు చేశారు;</para>
  <para style="q2" vid="ISA 12:5">లోకమంతటికి ఇది తెలియాలి.<verse eid="ISA 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 12:6"/>సీయోను ప్రజలారా, బిగ్గరగా కేకలువేస్తూ సంతోషంతో పాడండి,</para>
  <para style="q2" vid="ISA 12:6">ఎందుకంటే, మీ మధ్య ఉన్న ఇశ్రాయేలు పరిశుద్ధుడు గొప్పవాడు.”<verse eid="ISA 12:6"/></para>
  <chapter eid="ISA 12"/>
  <chapter number="13" style="c" sid="ISA 13"/>
  <para style="s1">బబులోనుకు వ్యతిరేకంగా ప్రవచనం</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 13:1"/>బబులోను గురించి ఆమోజు కుమారుడైన యెషయాకు వచ్చిన ప్రవచనం:<verse eid="ISA 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 13:2"/>చెట్లులేని కొండ శిఖరం మీద జెండా నిలబెట్టండి,</para>
  <para style="q2" vid="ISA 13:2">కేకలు వేసి వారిని పిలువండి;</para>
  <para style="q1" vid="ISA 13:2">ప్రజల ప్రధానులను గుమ్మాల్లో</para>
  <para style="q2" vid="ISA 13:2">చేతులతో సైగ చేయండి.<verse eid="ISA 13:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 13:3"/>నేను యుద్ధానికి ప్రతిష్ఠించిన వారికి ఆజ్ఞ ఇచ్చాను;</para>
  <para style="q2" vid="ISA 13:3">నా కోపం తీర్చుకోవాలని నా వీరులను పిలిపించాను,</para>
  <para style="q2" vid="ISA 13:3">నా విజయాన్ని బట్టి సంతోషించేవారిని పిలిపించాను.<verse eid="ISA 13:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 13:4"/>పెద్ద జనసమూహం ఉన్నట్లుగా</para>
  <para style="q2" vid="ISA 13:4">కొండల్లో వస్తున్న శబ్దం వినండి!</para>
  <para style="q1" vid="ISA 13:4">దేశాలు ఒక్కటిగా చేరుతునట్లు</para>
  <para style="q2" vid="ISA 13:4">రాజ్యాల మధ్య అల్లరి శబ్దం వినండి!</para>
  <para style="q1" vid="ISA 13:4">సైన్యాల యెహోవా</para>
  <para style="q2" vid="ISA 13:4">యుద్ధానికి సైన్యాన్ని సమకూరుస్తున్నారు.<verse eid="ISA 13:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 13:5"/>దేశాన్ని మొత్తం పాడుచేయడానికి,</para>
  <para style="q2" vid="ISA 13:5">యెహోవా కోపాన్ని తీర్చే ఆయుధాలుగా,</para>
  <para style="q1" vid="ISA 13:5">వారు దూరదేశం నుండి,</para>
  <para style="q2" vid="ISA 13:5">ఆకాశపు అంచుల నుండి వస్తున్నారు.<verse eid="ISA 13:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 13:6"/>యెహోవా దినం దగ్గరలో ఉందని రోదించండి;</para>
  <para style="q2" vid="ISA 13:6">అది సర్వశక్తుడు దేవుని దగ్గర నుండి వచ్చే నాశనంలా వస్తుంది.<verse eid="ISA 13:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 13:7"/>దీనిని బట్టి, చేతులన్నీ బలహీనపడతాయి,</para>
  <para style="q2" vid="ISA 13:7">ప్రతి హృదయం భయంతో కరిగిపోతుంది.<verse eid="ISA 13:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 13:8"/>భయం వారిని పట్టుకుంటుంది,</para>
  <para style="q2" vid="ISA 13:8">వేదన బాధలు వారిని గట్టిగా పట్టుకుంటాయి;</para>
  <para style="q2" vid="ISA 13:8">స్త్రీ ప్రసవ వేదన పడినట్లు వారు వేదన పడతారు.</para>
  <para style="q1" vid="ISA 13:8">వారు ఒకరిపట్ల ఒకరు విసుగుతో చూసుకుంటారు,</para>
  <para style="q2" vid="ISA 13:8">వారి ముఖాలు అగ్నిజ్వాలల్లా ఉంటాయి.<verse eid="ISA 13:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 13:9"/>చూడండి, యెహోవా దినం వస్తుంది.</para>
  <para style="q2" vid="ISA 13:9">దేశాన్ని పాడుచేయడానికి</para>
  <para style="q1" vid="ISA 13:9">దానిలో ఉన్న పాపులను పూర్తిగా నాశనం చేయడానికి</para>
  <para style="q2" vid="ISA 13:9">క్రూరమైన ఉగ్రతతో తీవ్రమైన కోపంతో ఆ రోజు వస్తుంది.<verse eid="ISA 13:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 13:10"/>ఆకాశ నక్షత్రాలు వాటి నక్షత్రరాసులు</para>
  <para style="q2" vid="ISA 13:10">తమ వెలుగు ఇవ్వవు.</para>
  <para style="q1" vid="ISA 13:10">ఉదయించే సూర్యుడు చీకటిగా మారుతాడు</para>
  <para style="q2" vid="ISA 13:10">చంద్రుడు తన వెలుగునివ్వడు.<verse eid="ISA 13:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 13:11"/>దాని చెడుతనం బట్టి లోకాన్ని</para>
  <para style="q2" vid="ISA 13:11">వారి పాపాన్ని బట్టి దుర్మార్గులను నేను శిక్షిస్తాను.</para>
  <para style="q1" vid="ISA 13:11">గర్విష్ఠుల అహంకారాన్ని అంతం చేస్తాను.</para>
  <para style="q2" vid="ISA 13:11">క్రూరుల గర్వాన్ని అణచివేస్తాను.<verse eid="ISA 13:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 13:12"/>నేను మనుష్యులను స్వచ్ఛమైన బంగారం కంటే కొరతగా,</para>
  <para style="q2" vid="ISA 13:12">ఓఫీరు దేశ బంగారం కంటే అరుదుగా ఉండేలా చేస్తాను.<verse eid="ISA 13:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 13:13"/>సైన్యాల యెహోవా ఉగ్రత కారణంగా</para>
  <para style="q2" vid="ISA 13:13">ఆయన కోపం రగులుకున్న రోజున</para>
  <para style="q1" vid="ISA 13:13">ఆకాశం వణికేలా చేస్తాను;</para>
  <para style="q2" vid="ISA 13:13">భూమి తన స్థానం నుండి తప్పుకునేలా చేస్తాను.<verse eid="ISA 13:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 13:14"/>తరుమబడుతున్న జింకలా,</para>
  <para style="q2" vid="ISA 13:14">కాపరి లేని గొర్రెలా,</para>
  <para style="q1" vid="ISA 13:14">వారు తమ సొంత ప్రజల వైపు తిరుగుతారు,</para>
  <para style="q2" vid="ISA 13:14">వారు తమ స్వదేశాలకు పారిపోతారు.<verse eid="ISA 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 13:15"/>పట్టబడిన ప్రతిఒక్కరు కత్తిపోటుకు గురవుతారు;</para>
  <para style="q2" vid="ISA 13:15">బందీగా పట్టబడిన వారందరు ఖడ్గానికి చస్తారు.<verse eid="ISA 13:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 13:16"/>వారి కళ్లముందే వారి పసిపిల్లలు ముక్కలుగా నలుగ కొట్టబడతారు;</para>
  <para style="q2" vid="ISA 13:16">వారి ఇల్లు దోచుకోబడతాయి వారి భార్యలు అత్యాచారం చేయబడతారు.<verse eid="ISA 13:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 13:17"/>చూడండి, వారి మీద దాడి చేయడానికి నేను మెదీయ వారిని రేపుతాను.</para>
  <para style="q2" vid="ISA 13:17">వారు వెండిని లెక్కచేయరు.</para>
  <para style="q2" vid="ISA 13:17">బంగారం మీద వారికి ఆసక్తి లేదు.<verse eid="ISA 13:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 13:18"/>వారి విల్లులు యవ్వనస్థులను నలగ్గొడతాయి;</para>
  <para style="q2" vid="ISA 13:18">పసిపిల్లలపై వారు జాలిపడరు.</para>
  <para style="q2" vid="ISA 13:18">పిల్లలపై వారు దయ చూపరు.<verse eid="ISA 13:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 13:19"/>అప్పుడు రాజ్యాలకు వైభవంగా,</para>
  <para style="q2" vid="ISA 13:19">బబులోనీయుల<note caller="+" style="f"><char style="fr" closed="false">13:19 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">కల్దీయుల</char></note> గర్వానికి ఘనతకు కారణంగా ఉన్న బబులోనును</para>
  <para style="q1" vid="ISA 13:19">సొదొమ గొమొర్రాల వలె</para>
  <para style="q2" vid="ISA 13:19">దేవుడు పడగొడతారు.<verse eid="ISA 13:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 13:20"/>ఇకపై దానిలో ఎవరూ నివసించరు</para>
  <para style="q2" vid="ISA 13:20">తరతరాలకు దానిలో ఎవరూ కాపురముండరు;</para>
  <para style="q1" vid="ISA 13:20">అరబీయులు<note caller="+" style="f"><char style="fr" closed="false">13:20 </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">సంచార జాతులు</char></note> అక్కడ తమ డేరాలు వేసుకోరు,</para>
  <para style="q2" vid="ISA 13:20">గొర్రెల కాపరులు తమ మందలను అక్కడ విశ్రాంతి తీసుకోనివ్వరు.<verse eid="ISA 13:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 13:21"/>ఎడారి జీవులు అక్కడ పడుకుంటాయి,</para>
  <para style="q2" vid="ISA 13:21">వారి ఇళ్ళ నిండ నక్కలు ఉంటాయి;</para>
  <para style="q1" vid="ISA 13:21">గుడ్లగూబలు అక్కడ నివసిస్తాయి</para>
  <para style="q2" vid="ISA 13:21">కొండమేకలు అక్కడ గంతులు వేస్తాయి.<verse eid="ISA 13:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 13:22"/>దాని కోటలలో హైనాలు,</para>
  <para style="q2" vid="ISA 13:22">దాని విలాసవంతమైన భవనాలలో నక్కలు నివసిస్తాయి.</para>
  <para style="q1" vid="ISA 13:22">దాని కాలం ముగిసిపోతుంది</para>
  <para style="q2" vid="ISA 13:22">దాని రోజులు పొడిగించబడవు.<verse eid="ISA 13:22"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 13"/>
  <chapter number="14" style="c" sid="ISA 14"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 14:1"/>యెహోవా యాకోబుపై జాలి చూపుతారు;</para>
  <para style="q2" vid="ISA 14:1">ఆయన మరలా ఇశ్రాయేలును ఏర్పరచుకొని</para>
  <para style="q2" vid="ISA 14:1">వారిని వారి స్వదేశంలో స్థిరపరుస్తారు.</para>
  <para style="q1" vid="ISA 14:1">విదేశీయులు వారిని కలుసుకుంటారు</para>
  <para style="q2" vid="ISA 14:1">యాకోబు వారసులతో ఏకమై ఉంటారు.<verse eid="ISA 14:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 14:2"/>ప్రజలు వారిని తీసుకువచ్చి</para>
  <para style="q2" vid="ISA 14:2">వారి సొంత దేశంలో వారిని చేర్చుతారు.</para>
  <para style="q1" vid="ISA 14:2">ఇశ్రాయేలు దేశాలను స్వాధీనపరచుకుని</para>
  <para style="q2" vid="ISA 14:2">యెహోవా దేశంలో వారిని తమ దాసదాసీలుగా చేసుకుంటారు.</para>
  <para style="q1" vid="ISA 14:2">వారు తమను బందీలుగా పట్టుకెళ్లిన వారిని బందీలుగా పట్టుకుని</para>
  <para style="q2" vid="ISA 14:2">తమను బాధించిన వారిని పాలిస్తారు.<verse eid="ISA 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 14:3"/>నీ బాధ నుండి వేదన నుండి నీతో బలవంతంగా చేయించిన కఠినమైన పని నుండి యెహోవా నీకు ఉపశమనం ఇచ్చిన రోజున, <verse eid="ISA 14:3"/><verse number="4" style="v" sid="ISA 14:4"/>నీవు బబులోను రాజును హేళన చేస్తూ ఇలా మాట్లాడతావు:</para>
  <para style="q1" vid="ISA 14:4">బాధ పెట్టినవాడు ఎలా నశించాడు!</para>
  <para style="q2" vid="ISA 14:4">రేగుతున్న కోపం ఎలా అంతమయ్యింది!<verse eid="ISA 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 14:5"/>దుర్మార్గుల దుడ్డుకర్రను</para>
  <para style="q2" vid="ISA 14:5">పాలకుల రాజదండాన్ని యెహోవా విరగ్గొట్టారు.<verse eid="ISA 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 14:6"/>వారు కోపంతో ఎడతెగని దెబ్బలతో</para>
  <para style="q2" vid="ISA 14:6">ప్రజలను క్రూరంగా కొట్టారు,</para>
  <para style="q1" vid="ISA 14:6">కోపంతో ప్రజలను పరిపాలించి</para>
  <para style="q2" vid="ISA 14:6">కనికరం లేకుండా వారిని అణచివేశారు.<verse eid="ISA 14:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 14:7"/>భూమి అంతా విశ్రాంతిలో సమాధానంతో ఉంది;</para>
  <para style="q2" vid="ISA 14:7">వారు పాడడం మొదలుపెట్టారు.<verse eid="ISA 14:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 14:8"/>సరళ వృక్షాలు లెబానోను దేవదారు చెట్లు</para>
  <para style="q2" vid="ISA 14:8">నీ గురించి సంతోషిస్తూ ఇలా అంటాయి,</para>
  <para style="q1" vid="ISA 14:8">“నీవు పడుకుంటున్నప్పటి నుండి</para>
  <para style="q2" vid="ISA 14:8">మమ్మల్ని నరకడానికి ఎవరూ రారు.”<verse eid="ISA 14:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 14:9"/>నీవు వస్తుండగా నిన్ను కలుసుకోడానికి</para>
  <para style="q2" vid="ISA 14:9">క్రింద పాతాళం నీ గురించి ఆవేశపడుతుంది;</para>
  <para style="q1" vid="ISA 14:9">అది నిన్ను చూసి చచ్చిన వారి ఆత్మలను అనగా</para>
  <para style="q2" vid="ISA 14:9">భూమి మీద నాయకులుగా ఉన్నవారందరిని రేపుతుంది;</para>
  <para style="q1" vid="ISA 14:9">దేశాలకు రాజులుగా ఉన్నవారందరిని</para>
  <para style="q2" vid="ISA 14:9">తమ సింహాసనాలు నుండి లేపుతుంది.<verse eid="ISA 14:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 14:10"/>వారందరు నిన్ను చూసి</para>
  <para style="q2" vid="ISA 14:10">నీతో ఇలా అంటారు,</para>
  <para style="q1" vid="ISA 14:10">“నీవు కూడా మాలాగే బలహీనమయ్యావు;</para>
  <para style="q2" vid="ISA 14:10">నీవు కూడా మాలా అయ్యావు.”<verse eid="ISA 14:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 14:11"/>నీ వీణల సందడితో పాటు నీ ఆడంబరం అంతా</para>
  <para style="q2" vid="ISA 14:11">క్రింద సమాధిలో పడవేయబడింది;</para>
  <para style="q1" vid="ISA 14:11">నీ క్రింద పురుగులు వ్యాపిస్తాయి</para>
  <para style="q2" vid="ISA 14:11">క్రిములు నిన్ను కప్పివేస్తాయి.<verse eid="ISA 14:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 14:12"/>తేజోనక్షత్రమా, వేకువచుక్కా,</para>
  <para style="q2" vid="ISA 14:12">నీవెలా ఆకాశం నుండి పడ్డావు?</para>
  <para style="q1" vid="ISA 14:12">దేశాలను పడగొట్టిన నీవు</para>
  <para style="q2" vid="ISA 14:12">భూమి మీద ఎలా పడవేయబడ్డావు?<verse eid="ISA 14:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 14:13"/>నీవు నీ హృదయంలో,</para>
  <para style="q2" vid="ISA 14:13">“నేను ఆకాశాలను ఎక్కుతాను;</para>
  <para style="q1" vid="ISA 14:13">దేవుని నక్షత్రాల కన్నా ఎత్తుగా</para>
  <para style="q2" vid="ISA 14:13">నా సింహాసనాన్ని హెచ్చిస్తాను;</para>
  <para style="q1" vid="ISA 14:13">ఉత్తర దిక్కున ఉన్న సభా పర్వతం మీద,</para>
  <para style="q2" vid="ISA 14:13">సాఫోన్<note caller="+" style="f"><char style="fr" closed="false">14:13 </char><char style="fq" closed="false">సాఫోన్ </char><char style="ft" closed="false">కనానీయుల చేత </char><char style="fqa" closed="false">అతి పవిత్ర </char><char style="ft" closed="false">పర్వతముగా పరిగణించబడింది.</char></note> పర్వతం యొక్క ఎత్తైన స్థలాల మీద కూర్చుంటాను.<verse eid="ISA 14:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 14:14"/>మేఘ మండలం మీదికి ఎక్కుతాను.</para>
  <para style="q2" vid="ISA 14:14">నన్ను నేను మహోన్నతునిగా చేసుకుంటాను” అనుకున్నావు.<verse eid="ISA 14:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 14:15"/>కాని నీవు పాతాళంలో చచ్చిన వారి స్థలంలో</para>
  <para style="q2" vid="ISA 14:15">లోతైన గోతిలో త్రోయబడ్డావు.<verse eid="ISA 14:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 14:16"/>నిన్ను చూసేవారు నిన్ను గమనించి చూస్తూ</para>
  <para style="q2" vid="ISA 14:16">నీ విధి గురించి ఇలా అనుకుంటారు:</para>
  <para style="q1" vid="ISA 14:16">“భూమిని కంపింపజేసి</para>
  <para style="q2" vid="ISA 14:16">రాజ్యాలను వణికించింది ఇతడేనా?<verse eid="ISA 14:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 14:17"/>లోకాన్ని అడవిగా చేసి</para>
  <para style="q2" vid="ISA 14:17">దాని పట్టణాలను పాడుచేసినవాడు ఇతడేనా?</para>
  <para style="q2" vid="ISA 14:17">తాను బంధించిన వారిని తమ ఇళ్ళకు పోనివ్వనివాడు ఇతడేనా?”<verse eid="ISA 14:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 14:18"/>దేశాల రాజులందరూ ఘనత వహించినవారై</para>
  <para style="q2" vid="ISA 14:18">తమ తమ సమాధుల్లో నిద్రిస్తున్నారు.<verse eid="ISA 14:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 14:19"/>అయితే నీవు తిరస్కరించబడిన కొమ్మలా</para>
  <para style="q2" vid="ISA 14:19">నీ సమాధి నుండి పారవేయబడ్డావు.</para>
  <para style="q1" vid="ISA 14:19">నీవు చంపబడినవారితో</para>
  <para style="q2" vid="ISA 14:19">కత్తితో పొడవబడిన వారితో</para>
  <para style="q2" vid="ISA 14:19">పాతాళంలో ఉన్న రాళ్ల దగ్గరకు దిగిపోయిన వారితో కప్పబడి ఉన్నావు.</para>
  <para style="q1" vid="ISA 14:19">కాళ్లతో తొక్కబడిన శవంలా ఉన్నావు.<verse eid="ISA 14:19"/></para>
  <para style="q2">
    <verse number="20" style="v" sid="ISA 14:20"/>నీవు నీ దేశాన్ని పాడుచేసి</para>
  <para style="q1" vid="ISA 14:20">నీ ప్రజలను చంపేశావు</para>
  <para style="q2" vid="ISA 14:20">కాబట్టి నీవు సమాధిలో వారితో పాటు కలిసి ఉండవు.</para>
  <para style="b" vid="ISA 14:20"/>
  <para style="b" vid="ISA 14:20"/>
  <para style="q1" vid="ISA 14:20">దుర్మార్గుని సంతానం</para>
  <para style="q2" vid="ISA 14:20">ఎప్పుడూ జ్ఞాపకానికి రాదు.<verse eid="ISA 14:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 14:21"/>వారు పెరిగి భూమిని స్వాధీనం చేసుకుని</para>
  <para style="q2" vid="ISA 14:21">తమ పట్టణాలతో భూమిని నింపకుండా</para>
  <para style="q1" vid="ISA 14:21">తమ పూర్వికుల పాపాన్ని బట్టి</para>
  <para style="q2" vid="ISA 14:21">అతని పిల్లలను వధించడానికి చోటు సిద్ధం చేయండి.<verse eid="ISA 14:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 14:22"/>“నేను వారి మీదికి లేస్తాను” అని</para>
  <para style="q2" vid="ISA 14:22">సైన్యాల యెహోవా ప్రకటిస్తున్నారు,</para>
  <para style="q1" vid="ISA 14:22">“బబులోను పేరును దానిలో మిగిలినవారిని,</para>
  <para style="q2" vid="ISA 14:22">సంతానాన్ని, వారసులను కొట్టివేస్తాను”</para>
  <para style="q2" vid="ISA 14:22">అని యెహోవా తెలియజేస్తున్నారు.<verse eid="ISA 14:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 14:23"/>“నేను దానిని గుడ్లగూబలు ఉండే స్థలంగా చేస్తాను</para>
  <para style="q2" vid="ISA 14:23">నీటిమడుగులుగా చేస్తాను;</para>
  <para style="q1" vid="ISA 14:23">నాశనమనే చీపురుకట్టతో దానిని తుడిచివేస్తాను” అని</para>
  <para style="q2" vid="ISA 14:23">సైన్యాల యెహోవా తెలియజేస్తున్నారు.<verse eid="ISA 14:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ISA 14:24"/>సైన్యాల యెహోవా చేసిన ప్రమాణం ఇదే:</para>
  <para style="q1" vid="ISA 14:24">“నేను ఉద్దేశించినట్లే అది తప్పక ఉంటుంది,</para>
  <para style="q2" vid="ISA 14:24">నేను ఆలోచించినట్లే అది జరుగుతుంది.<verse eid="ISA 14:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 14:25"/>నా దేశంలో అష్షూరును విరగ్గొడతాను;</para>
  <para style="q2" vid="ISA 14:25">నా పర్వతాలమీద అతన్ని నలగదొక్కుతాను.</para>
  <para style="q1" vid="ISA 14:25">అతని కాడి నా ప్రజల మీద నుండి తీసివేయబడుతుంది,</para>
  <para style="q2" vid="ISA 14:25">అతని భారం వారి భుజాలపై నుండి తొలగించబడుతుంది.”<verse eid="ISA 14:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 14:26"/>లోకమంతటి గురించి నిర్ణయించిన ఆలోచన ఇదే;</para>
  <para style="q2" vid="ISA 14:26">ప్రజలందరిపై చాపబడిన చేయి ఇదే.<verse eid="ISA 14:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 14:27"/>సైన్యాల యెహోవా దానిని ఉద్దేశిస్తే ఆయనను అడ్డుకునేవారు ఎవరు?</para>
  <para style="q2" vid="ISA 14:27">ఆయన చేయి చాచి ఉన్నది, దాన్ని త్రిప్పగలవారెవరు?<verse eid="ISA 14:27"/></para>
  <para style="s1">ఫిలిష్తీయులకు వ్యతిరేకంగా ప్రవచనం</para>
  <para style="p">
    <verse number="28" style="v" sid="ISA 14:28"/>రాజైన ఆహాజు చనిపోయిన సంవత్సరం వచ్చిన ప్రవచనం:<verse eid="ISA 14:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 14:29"/>ఫిలిష్తియా, మిమ్మల్ని కొట్టిన కర్ర</para>
  <para style="q2" vid="ISA 14:29">విరిగిపోయిందని మీరందరు సంతోషించకండి;</para>
  <para style="q1" vid="ISA 14:29">సర్పమూలం నుండి విషపూరిత పాము పుడుతుంది,</para>
  <para style="q2" vid="ISA 14:29">దాని సంతానం ఎగిరే విషసర్పము.<verse eid="ISA 14:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 14:30"/>అప్పుడు అతి బీదవారు భోజనం చేస్తారు,</para>
  <para style="q2" vid="ISA 14:30">అవసరతలో ఉన్నవారు క్షేమంగా పడుకుంటారు.</para>
  <para style="q1" vid="ISA 14:30">కాని కరువుతో మీ మూలాన్ని నాశనం చేస్తాను;</para>
  <para style="q2" vid="ISA 14:30">అది మీలో మిగిలి ఉన్నవారిని చంపేస్తుంది.<verse eid="ISA 14:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 14:31"/>గుమ్మమా, దుఃఖించు! పట్టణమా, కేకలు వేయి!</para>
  <para style="q2" vid="ISA 14:31">ఫిలిష్తియా, మీరంతా కరిగిపోవాలి!</para>
  <para style="q1" vid="ISA 14:31">ఉత్తర దిక్కునుండి పొగలేస్తుంది.</para>
  <para style="q2" vid="ISA 14:31">పంక్తులు తీరిన సైన్యంలో వెనుదిరిగేవారు ఎవరూ లేరు.<verse eid="ISA 14:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 14:32"/>ఆ దేశ దూతలకు</para>
  <para style="q2" vid="ISA 14:32">ఇవ్వవలసిన జవాబు ఏది?</para>
  <para style="q1" vid="ISA 14:32">“యెహోవా సీయోనును స్థాపించారు,</para>
  <para style="q2" vid="ISA 14:32">ఆయన ప్రజల్లో శ్రమ పొందినవారు దానిని ఆశ్రయిస్తారు.”<verse eid="ISA 14:32"/></para>
  <chapter eid="ISA 14"/>
  <chapter number="15" style="c" sid="ISA 15"/>
  <para style="s1">మోయాబుకు వ్యతిరేకంగా ప్రవచనం</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 15:1"/>మోయాబుకు వ్యతిరేకంగా ప్రవచనం:</para>
  <para style="q1" vid="ISA 15:1">ఒక రాత్రిలోనే మోయాబులోని ఆరు పట్టణం</para>
  <para style="q2" vid="ISA 15:1">పాడై నశిస్తుంది!</para>
  <para style="q1" vid="ISA 15:1">ఒక రాత్రిలోనే మోయాబులోని కీరు పట్టణం</para>
  <para style="q2" vid="ISA 15:1">పాడై నశిస్తుంది!<verse eid="ISA 15:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 15:2"/>దీబోను ఏడ్వడానికి గుడికి</para>
  <para style="q2" vid="ISA 15:2">తన క్షేత్రాలకు వెళ్తుంది;</para>
  <para style="q2" vid="ISA 15:2">నెబో మెదెబా బట్టి మోయాబు రోదిస్తుంది.</para>
  <para style="q1" vid="ISA 15:2">ప్రతి తల క్షౌరం చేయబడింది</para>
  <para style="q2" vid="ISA 15:2">ప్రతివాని గడ్డం గొరిగించబడింది.<verse eid="ISA 15:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 15:3"/>వారు తమ సంతవీధులలో గోనెపట్ట కట్టుకుంటారు;</para>
  <para style="q2" vid="ISA 15:3">తమ మేడల మీద, బహిరంగ స్థలాల్లో</para>
  <para style="q1" vid="ISA 15:3">వారందరు రోదిస్తారు,</para>
  <para style="q2" vid="ISA 15:3">ఏడుస్తూ కన్నీరు కారుస్తారు.<verse eid="ISA 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 15:4"/>హెష్బోను ఎల్యాలెహు మొరపెడుతున్నారు,</para>
  <para style="q2" vid="ISA 15:4">యాహాజు వరకు వారి స్వరం వినబడుతుంది.</para>
  <para style="q1" vid="ISA 15:4">కాబట్టి మోయాబీయుల వీరులు మొరపెడతారు,</para>
  <para style="q2" vid="ISA 15:4">వారి హృదయాలు క్రుంగిపోతాయి.<verse eid="ISA 15:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 15:5"/>మోయాబు గురించి నా హృదయం మొరపెడుతుంది;</para>
  <para style="q2" vid="ISA 15:5">వారిలో పారిపోయినవారు సోయరు వరకు,</para>
  <para style="q2" vid="ISA 15:5">ఎగ్లత్-షెలీషియా వరకు పారిపోతారు.</para>
  <para style="q1" vid="ISA 15:5">వారు లూహీతు ఎక్కుతున్నప్పుడు</para>
  <para style="q2" vid="ISA 15:5">ఆ దారిలో ఏడుస్తూ ఎక్కుతారు;</para>
  <para style="q1" vid="ISA 15:5">హొరొనయీము వెళ్లే దారిలో</para>
  <para style="q2" vid="ISA 15:5">తమ నాశనం గురించి విలపిస్తారు.<verse eid="ISA 15:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 15:6"/>నిమ్రీము నీళ్లు ఎండిపోయాయి</para>
  <para style="q2" vid="ISA 15:6">గడ్డి ఎండిపోయింది;</para>
  <para style="q1" vid="ISA 15:6">వృక్ష సంపద ఉండదు</para>
  <para style="q2" vid="ISA 15:6">పచ్చదనం ఎక్కడా మిగల్లేదు.<verse eid="ISA 15:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 15:7"/>కాబట్టి వారు సంపాదించి సమకూర్చుకున్న ఆస్తిని</para>
  <para style="q2" vid="ISA 15:7">నిరవంజి చెట్లున్న నది అవతలకు వారు మోసికొని వెళ్తారు.<verse eid="ISA 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 15:8"/>వారి ఆర్తనాదాలు మోయాబు సరిహద్దులలో ప్రతిధ్వనిస్తాయి;</para>
  <para style="q2" vid="ISA 15:8">వారి రోదన ఎగ్లయీము వరకు</para>
  <para style="q2" vid="ISA 15:8">వారి ఏడ్పు బెయేర్-ఎలీము వరకు వినబడుతుంది.<verse eid="ISA 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 15:9"/>దీమోను నీళ్లు రక్తంతో నిండిపోయాయి</para>
  <para style="q2" vid="ISA 15:9">కాని నేను దీమోను మీదికి ఇంకొక బాధను రప్పిస్తాను.</para>
  <para style="q1" vid="ISA 15:9">మోయాబు నుండి తప్పించుకున్నవారి మీదికి</para>
  <para style="q2" vid="ISA 15:9">ఆ దేశంలో మిగిలిన వారి మీదికి సింహాన్ని రప్పిస్తాను.<verse eid="ISA 15:9"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 15"/>
  <chapter number="16" style="c" sid="ISA 16"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 16:1"/>ఎడారి వైపు ఉన్న సెల నుండి</para>
  <para style="q2" vid="ISA 16:1">దేశాన్ని పాలించేవానికి</para>
  <para style="q1" vid="ISA 16:1">కప్పంగా గొర్రెపిల్లలను</para>
  <para style="q2" vid="ISA 16:1">సీయోను కుమార్తె పర్వతానికి పంపండి.<verse eid="ISA 16:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 16:2"/>గూటినుండి చెదరగొట్టబడి</para>
  <para style="q2" vid="ISA 16:2">ఇటు అటు ఎగిరే పక్షుల్లా</para>
  <para style="q1" vid="ISA 16:2">అర్నోను రేవుల దగ్గర</para>
  <para style="q2" vid="ISA 16:2">మోయాబు స్త్రీలు ఉంటారు.<verse eid="ISA 16:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 16:3"/>మోయాబు అంటుంది, “మనస్సు సిద్ధం చేసుకో,</para>
  <para style="q2" vid="ISA 16:3">నిర్ణయం తీసుకో.</para>
  <para style="q1" vid="ISA 16:3">చీకటి కమ్మినట్టుగా మిట్టమధ్యాహ్నం</para>
  <para style="q2" vid="ISA 16:3">నీ నీడ మామీద ఉండనివ్వు.</para>
  <para style="q1" vid="ISA 16:3">పారిపోయినవారిని దాచి పెట్టు,</para>
  <para style="q2" vid="ISA 16:3">శరణార్థులకు ద్రోహం చేయకు.<verse eid="ISA 16:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 16:4"/>పారిపోయిన మోయాబీయులను నీతో ఉండనివ్వు;</para>
  <para style="q2" vid="ISA 16:4">నాశనం చేసేవాని నుండి కాపాడే ఆశ్రయంగా ఉండు.”</para>
  <para style="b" vid="ISA 16:4"/>
  <para style="q1" vid="ISA 16:4">హాని చేసేవారు అంతం అవుతారు,</para>
  <para style="q2" vid="ISA 16:4">విధ్వంసం ఆగిపోతుంది;</para>
  <para style="q2" vid="ISA 16:4">అణచివేసేవారు భూమి మీద లేకుండా మాయమవుతారు.<verse eid="ISA 16:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 16:5"/>మారని ప్రేమలో సింహాసనం స్థాపించబడుతుంది;</para>
  <para style="q2" vid="ISA 16:5">దావీదు కుటుంబం నుండి</para>
  <para style="q2" vid="ISA 16:5">సత్యవంతుడైన ఒకడు దానిపై కూర్చుని</para>
  <para style="q1" vid="ISA 16:5">న్యాయంగా తీర్పు తీర్చుతూ</para>
  <para style="q2" vid="ISA 16:5">నీతిన్యాయాలను జరిగించడానికి త్వరపడతాడు.<verse eid="ISA 16:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 16:6"/>మోయాబు గర్వం గురించి మేము విన్నాము</para>
  <para style="q2" vid="ISA 16:6">దాని అహంకారం చాలా ఎక్కువ</para>
  <para style="q1" vid="ISA 16:6">దాని ప్రగల్భాలు, గర్వం, దౌర్జన్యం గురించి విన్నాం;</para>
  <para style="q2" vid="ISA 16:6">అయితే దాని ప్రగల్భాలు వట్టివే.<verse eid="ISA 16:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 16:7"/>కాబట్టి మోయాబీయులు రోదిస్తారు,</para>
  <para style="q2" vid="ISA 16:7">వారందరూ కలిసి మోయాబు గురించి ఏడుస్తారు.</para>
  <para style="q1" vid="ISA 16:7">కీర్ హరెశెతుకు ఎండు ద్రాక్షపండ్ల</para>
  <para style="q2" vid="ISA 16:7">విలపించి దుఃఖిస్తారు.<verse eid="ISA 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 16:8"/>హెష్బోను పొలాలు,</para>
  <para style="q2" vid="ISA 16:8">షిబ్మా ద్రాక్షతీగెలు కూడా వాడిపోయాయి.</para>
  <para style="q1" vid="ISA 16:8">యాజెరు వరకు వ్యాపించిన</para>
  <para style="q2" vid="ISA 16:8">అరణ్యం వరకు ప్రాకిన</para>
  <para style="q1" vid="ISA 16:8">శ్రేష్ఠమైన ద్రాక్షతీగెలను</para>
  <para style="q2" vid="ISA 16:8">దేశాల పాలకులు త్రొక్కివేశారు.</para>
  <para style="q1" vid="ISA 16:8">వాటి తీగెలు విశాలంగా వ్యాపించి</para>
  <para style="q2" vid="ISA 16:8">సముద్రాన్ని<note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="ft" closed="false">బహుశ మృత సముద్రం</char></note> దాటాయి.<verse eid="ISA 16:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 16:9"/>అందువల్ల యాజెరు ఏడ్చినట్లు</para>
  <para style="q2" vid="ISA 16:9">నేను షిబ్మా ద్రాక్షతీగెల కోసం ఏడుస్తాను.</para>
  <para style="q1" vid="ISA 16:9">హెష్బోనూ ఎల్యాలెహు,</para>
  <para style="q2" vid="ISA 16:9">నా కన్నీటి చేత మిమ్మల్ని తడుపుతాను.</para>
  <para style="q1" vid="ISA 16:9">నీ పండిన ఫలాల కోసం</para>
  <para style="q2" vid="ISA 16:9">నీ పంటల కోసం వేసే సంతోషపు కేకలు ఆగిపోయాయి.<verse eid="ISA 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 16:10"/>ఫలభరితమైన పొలాల నుండి ఆనంద సంతోషాలు తీసివేయబడతాయి;</para>
  <para style="q2" vid="ISA 16:10">ద్రాక్షతోటలో ఎవరూ పాడరు, కేకలు వేయరు;</para>
  <para style="q1" vid="ISA 16:10">గానుగులలో ద్రాక్షగెలలను ఎవరూ త్రొక్కరు.</para>
  <para style="q2" vid="ISA 16:10">ఎందుకంటే, నేను వారి సంతోషపు అరుపులు ఆపివేశాను.<verse eid="ISA 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 16:11"/>నా హృదయం వీణలా మోయాబు గురించి,</para>
  <para style="q2" vid="ISA 16:11">నా అంతరంగం కీర్ హరెశెతు గురించి విలపిస్తుంది.<verse eid="ISA 16:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 16:12"/>మోయాబు తన క్షేత్రాల దగ్గరకు వెళ్లినప్పుడు</para>
  <para style="q2" vid="ISA 16:12">అది కేవలం ఆయాసపడుతుంది;</para>
  <para style="q1" vid="ISA 16:12">ప్రార్ధన చేయడానికి తన క్షేత్రానికి వెళ్లినప్పుడు</para>
  <para style="q2" vid="ISA 16:12">దానికి ఏమి దొరకదు.<verse eid="ISA 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 16:13"/>యెహోవా మోయాబు గురించి ముందే పలికిన వాక్కు ఇది. <verse eid="ISA 16:13"/><verse number="14" style="v" sid="ISA 16:14"/>అయితే యెహోవా ఇప్పుడు ఇలా చెప్తున్నారు: “మూడు సంవత్సరాల్లో, కూలివాని లెక్క ప్రకారం ఖచ్చితంగా మోయాబు ఘనతతో పాటు దానిలోని అనేకమంది తృణీకరించబడతారు; దానిలో మిగిలినవారు అతితక్కువగా, బలహీనంగా ఉంటారు.”<verse eid="ISA 16:14"/></para>
  <chapter eid="ISA 16"/>
  <chapter number="17" style="c" sid="ISA 17"/>
  <para style="s1">దమస్కుకు వ్యతిరేకంగా ప్రవచనం</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 17:1"/>దమస్కుకు వ్యతిరేకంగా ప్రవచనం:</para>
  <para style="q1" vid="ISA 17:1">“చూడండి, దమస్కు ఒక పట్టణంగా ఇక ఉండదు,</para>
  <para style="q2" vid="ISA 17:1">కాని అది శిథిలాల కుప్పగా మారుతుంది.<verse eid="ISA 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 17:2"/>అరోయేరు పట్టణాలు నిర్జనమవుతాయి</para>
  <para style="q2" vid="ISA 17:2">అవి గొర్రెల మందలకు వదిలేయబడతాయి,</para>
  <para style="q2" vid="ISA 17:2">ఎవరి భయం లేకుండా అవి అక్కడ పడుకుంటాయి.<verse eid="ISA 17:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 17:3"/>ఎఫ్రాయిములో నుండి కోటగల పట్టణం మాయమవుతుంది,</para>
  <para style="q2" vid="ISA 17:3">దమస్కు రాజ్యాధికారాన్ని కోల్పోతుంది;</para>
  <para style="q1" vid="ISA 17:3">ఇశ్రాయేలీయుల ప్రభావానికి జరిగినట్లు</para>
  <para style="q2" vid="ISA 17:3">అరాములో మిగిలినవారికి జరుగుతుంది”</para>
  <para style="q2" vid="ISA 17:3">అని సైన్యాల యెహోవా తెలియజేస్తున్నారు.<verse eid="ISA 17:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 17:4"/>“ఆ రోజున యాకోబు ప్రభావం తగ్గిపోతుంది;</para>
  <para style="q2" vid="ISA 17:4">అతని శరీరం యొక్క క్రొవ్వు తరిగిపోతుంది.<verse eid="ISA 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 17:5"/>అది కోత కోసేవారు ధాన్యం కోసినప్పుడు</para>
  <para style="q2" vid="ISA 17:5">వారి చేతుల్లో వెన్నులు కోసినట్లుగా ఉంటుంది.</para>
  <para style="q1" vid="ISA 17:5">రెఫాయీము లోయలో</para>
  <para style="q2" vid="ISA 17:5">ఒకడు పరిగె ఏరుకున్నట్లుగా ఉంటుంది.<verse eid="ISA 17:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 17:6"/>అయినా ఒలీవచెట్టు కొమ్మలు దులపగా</para>
  <para style="q2" vid="ISA 17:6">పై కొమ్మ చివర రెండు మూడు పండ్లు మిగిలినట్లు,</para>
  <para style="q1" vid="ISA 17:6">ఫలించు చెట్టు కొమ్మల్లో మూడు, నాలుగు పండ్లు మిగిలినట్లు,</para>
  <para style="q2" vid="ISA 17:6">కొంత పరిగె మిగిలి ఉంటుంది” అని</para>
  <para style="q2" vid="ISA 17:6">ఇశ్రాయేలు దేవుడైన యెహోవా తెలియజేస్తున్నారు.<verse eid="ISA 17:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 17:7"/>ఆ రోజున మనుష్యులు తమ సృష్టికర్త వైపు చూస్తారు</para>
  <para style="q2" vid="ISA 17:7">వారు ఇశ్రాయేలు పరిశుద్ధ దేవుని వైపు తమ దృష్టిని మరల్చుకుంటారు.<verse eid="ISA 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 17:8"/>వారు తమ చేతుల పనియైన</para>
  <para style="q2" vid="ISA 17:8">బలిపీఠాల వైపు చూడరు,</para>
  <para style="q1" vid="ISA 17:8">తమ చేతివ్రేళ్లు చేసిన అషేరా స్తంభాలను</para>
  <para style="q2" vid="ISA 17:8">ధూపవేదికలను పట్టించుకోరు.<verse eid="ISA 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 17:9"/>ఆ రోజున ఇశ్రాయేలీయుల కారణంగా వారు విడిచిపెట్టిన బలమైన నిర్మానుష్యంగా పట్టణాలు పొదలు తుప్పలు పెరిగే స్థలాల్లా ఉంటాయి. అవి పాడైపోతాయి.<verse eid="ISA 17:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 17:10"/>నీ రక్షకుడైన దేవుని నీవు మరచిపోయావు;</para>
  <para style="q2" vid="ISA 17:10">నీ బలానికి ఆధారమైన బండను గుర్తు చేసుకోలేదు.</para>
  <para style="q1" vid="ISA 17:10">కాబట్టి నీవు అందమైన తోటలు పెంచినా</para>
  <para style="q2" vid="ISA 17:10">వాటిలో విదేశీ ద్రాక్షతీగెలు నాటినా,<verse eid="ISA 17:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 17:11"/>నీవు వాటిని నాటిన రోజున అవి పెరిగేలా నీవు చేసినా,</para>
  <para style="q2" vid="ISA 17:11">ఉదయాన నీవు వేసిన విత్తనాలు పూలు పూచేలా నీవు చేసినా,</para>
  <para style="q1" vid="ISA 17:11">రోగం, తీరని దుఃఖం కలిగే రోజున</para>
  <para style="q2" vid="ISA 17:11">పంట ఏమి లేనట్లుగా ఉంటుంది.<verse eid="ISA 17:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 17:12"/>ఘోషిస్తున్న అనేక దేశాలకు శ్రమ</para>
  <para style="q2" vid="ISA 17:12">వారు హోరెత్తిన సముద్రంలా ఘోషిస్తున్నారు!</para>
  <para style="q1" vid="ISA 17:12">గర్జిస్తున్న ప్రజలకు శ్రమ</para>
  <para style="q2" vid="ISA 17:12">వారు గొప్ప నీటి ప్రవాహాల్లా గర్జిస్తున్నారు!<verse eid="ISA 17:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 17:13"/>ఉప్పొంగుతున్న నీటిలా ప్రజలు గర్జించినా</para>
  <para style="q2" vid="ISA 17:13">ఆయన వారిని బెదిరించగా, వారు దూరంగా పారిపోతారు.</para>
  <para style="q1" vid="ISA 17:13">కొండల మీది పొట్టు గాలికి ఎగిరిపోయినట్లు,</para>
  <para style="q2" vid="ISA 17:13">సుడిగాలికి గిరగిరా తిరుగుతూ ఎగిరిపోయే పిచ్చిమొక్కలా తరమబడతారు.<verse eid="ISA 17:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 17:14"/>సాయంకాలంలో ఆకస్మిక భయం!</para>
  <para style="q2" vid="ISA 17:14">ఉదయం కాక ముందే వారు కనుమరుగవుతారు!</para>
  <para style="q1" vid="ISA 17:14">మమ్మల్ని దోచుకునేవారి భాగం ఇదే,</para>
  <para style="q2" vid="ISA 17:14">మా సొమ్ము దొంగతనం చేసేవారికి దొరికేది ఇదే.<verse eid="ISA 17:14"/></para>
  <chapter eid="ISA 17"/>
  <chapter number="18" style="c" sid="ISA 18"/>
  <para style="s1">కూషుకు వ్యతిరేకంగా ప్రవచనం</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 18:1"/>కూషు<note caller="+" style="f"><char style="fr" closed="false">18:1 </char><char style="ft" closed="false">అంటే, నైలు ఉపరితల ప్రాంతం</char></note> నదుల అవతల</para>
  <para style="q2" vid="ISA 18:1">సందడి చేసే రెక్కల దేశమా<note caller="+" style="f"><char style="fr" closed="false">18:1 </char><char style="fq" closed="false">రెక్కల దేశమా </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">మిడతల దేశమా</char></note>, నీకు శ్రమ!<verse eid="ISA 18:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 18:2"/>అది సముద్ర మార్గంలో నీటి మీద</para>
  <para style="q2" vid="ISA 18:2">జమ్ము పడవలలో దూతలను పంపుతుంది.</para>
  <para style="b" vid="ISA 18:2"/>
  <para style="q1" vid="ISA 18:2">తొందరపడే దూతలారా!</para>
  <para style="q1" vid="ISA 18:2">వారు నునుపైన చర్మం గల ఎత్తైన ప్రజల దగ్గరకు,</para>
  <para style="q2" vid="ISA 18:2">దూరంలోనున్న భయపెట్టే ప్రజల దగ్గరకు,</para>
  <para style="q1" vid="ISA 18:2">నదులు పారుచున్న దేశం కలిగి</para>
  <para style="q2" vid="ISA 18:2">దౌర్జన్యం వింత భాష కలిగిన దేశం దగ్గరకు వెళ్లండి.<verse eid="ISA 18:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 18:3"/>సమస్త లోకవాసులారా,</para>
  <para style="q2" vid="ISA 18:3">భూలోక నివాసులారా,</para>
  <para style="q1" vid="ISA 18:3">పర్వతాలమీద ఒక జెండాను ఎత్తినప్పుడు</para>
  <para style="q2" vid="ISA 18:3">మీరు చూస్తారు,</para>
  <para style="q1" vid="ISA 18:3">బూర ఊదినప్పుడు</para>
  <para style="q2" vid="ISA 18:3">మీరు వింటారు.<verse eid="ISA 18:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 18:4"/>యెహోవా నాతో చెప్పే మాట ఇది:</para>
  <para style="q2" vid="ISA 18:4">“సూర్యకాంతిలోని తీవ్రమైన వేడిలా,</para>
  <para style="q1" vid="ISA 18:4">వేసవి కోతకాలంలోని పొగమంచు మేఘంలా,</para>
  <para style="q2" vid="ISA 18:4">నేను నిశ్శబ్దంగా నా నివాసస్థలం నుండి చూస్తాను.”<verse eid="ISA 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 18:5"/>కోతకాలం రాకముందే, పువ్వు వాడిపోయినప్పుడు</para>
  <para style="q2" vid="ISA 18:5">పువ్వు ద్రాక్షగా మారుతున్నప్పుడు</para>
  <para style="q1" vid="ISA 18:5">ఆయన మడ్డికత్తులతో ద్రాక్షతీగెలను కత్తిరించి</para>
  <para style="q2" vid="ISA 18:5">విస్తరించే తీగెలను తీసివేస్తారు.<verse eid="ISA 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 18:6"/>అవి పర్వత పక్షులకు,</para>
  <para style="q2" vid="ISA 18:6">భూమిమీది మృగాలకు విడిచిపెట్టబడతాయి;</para>
  <para style="q1" vid="ISA 18:6">వాటిని వేసవి కాలమంతా పక్షులు,</para>
  <para style="q2" vid="ISA 18:6">శీతాకాలమంతా భూమిమీది మృగాలు తింటాయి.<verse eid="ISA 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 18:7"/>ఆ కాలంలో</para>
  <para style="q1" vid="ISA 18:7">ఎత్తైన వారు నునుపైన చర్మం గల ప్రజలు</para>
  <para style="q2" vid="ISA 18:7">దూరంలోనున్న భయపెట్టే ప్రజలు</para>
  <para style="q1" vid="ISA 18:7">నదులు పారుచున్న దేశం కలిగి</para>
  <para style="q2" vid="ISA 18:7">దౌర్జన్యం చేసి వింత భాష కలిగిన దేశం</para>
  <para style="m" vid="ISA 18:7">సైన్యాల యెహోవాకు కానుకలు తెస్తారు. సైన్యాల యెహోవా నామానికి నివాసస్థలమైన సీయోను పర్వతానికి ఆ కానుకలు తీసుకువస్తారు.<verse eid="ISA 18:7"/></para>
  <chapter eid="ISA 18"/>
  <chapter number="19" style="c" sid="ISA 19"/>
  <para style="s1">ఈజిప్టుకు వ్యతిరేకంగా ప్రవచనం</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 19:1"/>ఈజిప్టుకు వ్యతిరేకంగా ప్రవచనం:</para>
  <para style="q1" vid="ISA 19:1">చూడండి, యెహోవా వేగంగల మేఘం ఎక్కి</para>
  <para style="q2" vid="ISA 19:1">ఈజిప్టుకు వస్తున్నారు.</para>
  <para style="q1" vid="ISA 19:1">ఈజిప్టు విగ్రహాలు ఆయన ఎదుట వణకుతాయి,</para>
  <para style="q2" vid="ISA 19:1">ఈజిప్టు ప్రజల గుండెలు భయంతో కరిగిపోతాయి.<verse eid="ISA 19:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 19:2"/>“నేను ఈజిప్టువారి మీదికి ఈజిప్టువారిని రేపుతాను,</para>
  <para style="q2" vid="ISA 19:2">సోదరుని మీదికి సోదరుడు,</para>
  <para style="q2" vid="ISA 19:2">పొరుగువారి మీదికి పొరుగువారు,</para>
  <para style="q2" vid="ISA 19:2">పట్టణం మీదికి పట్టణం,</para>
  <para style="q2" vid="ISA 19:2">రాజ్యం మీదికి రాజ్యం రేపుతాను.<verse eid="ISA 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 19:3"/>ఈజిప్టువారు ఆత్మస్థైర్యం కోల్పోతారు,</para>
  <para style="q2" vid="ISA 19:3">వారి ఆలోచనలను నాశనం చేస్తాను;</para>
  <para style="q1" vid="ISA 19:3">వారు విగ్రహాలను, మరణించిన వారి ఆత్మలను,</para>
  <para style="q2" vid="ISA 19:3">భవిష్యవాణి చెప్పేవారిని, ఆత్మలతో మాట్లాడేవారిని సంప్రదిస్తారు.<verse eid="ISA 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 19:4"/>నేను ఈజిప్టువారిని</para>
  <para style="q2" vid="ISA 19:4">క్రూరమైన అధికారి చేతికి అప్పగిస్తాను,</para>
  <para style="q1" vid="ISA 19:4">భయంకరమైన రాజు వారిని పాలిస్తాడు” అని</para>
  <para style="q2" vid="ISA 19:4">సైన్యాల అధిపతియైన యెహోవా ప్రకటిస్తున్నారు.<verse eid="ISA 19:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 19:5"/>సముద్రంలో నీళ్లు ఎండిపోతాయి,</para>
  <para style="q2" vid="ISA 19:5">నదులు ఎండిపోయి పొడినేల అవుతాయి.<verse eid="ISA 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 19:6"/>కాలువలు కంపుకొడతాయి;</para>
  <para style="q2" vid="ISA 19:6">ఈజిప్టు కాలువలు ఇంకి ఎండిపోతాయి.</para>
  <para style="q1" vid="ISA 19:6">రెల్లు, గడ్డి వాడిపోతాయి,<verse eid="ISA 19:6"/></para>
  <para style="q2">
    <verse number="7" style="v" sid="ISA 19:7"/>నైలు నది ప్రాంతంలో</para>
  <para style="q2" vid="ISA 19:7">దాని ఒడ్డున ఉన్న మొక్కలు కూడా వాడిపోతాయి,</para>
  <para style="q1" vid="ISA 19:7">నైలు తీరం వెంట ఉన్న ప్రతి పొలం</para>
  <para style="q2" vid="ISA 19:7">వాడిపోయి దుమ్ములా కొట్టుకు పోయి ఇక కనబడవు.<verse eid="ISA 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 19:8"/>జాలరులు మూల్గుతారు, దుఃఖిస్తారు,</para>
  <para style="q2" vid="ISA 19:8">నైలు నదిలో గాలాలు వేసే వారందరు ఏడుస్తారు;</para>
  <para style="q2" vid="ISA 19:8">నీటి మీద వలలు వేసేవారు విలపిస్తారు.<verse eid="ISA 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 19:9"/>దువ్వెనతో చిక్కుతీసి జనపనారతో పని చేసేవారు నిరాశపడతారు,</para>
  <para style="q2" vid="ISA 19:9">సన్నని నారతో అల్లేవారు నిరీక్షణ కోల్పోతారు.<verse eid="ISA 19:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 19:10"/>బట్టలు తయారుచేసేవారు నిరుత్సాహపడతారు,</para>
  <para style="q2" vid="ISA 19:10">కూలిపని చేసే వారందరు మనోవేదన పొందుతారు.<verse eid="ISA 19:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 19:11"/>సోయను అధిపతులు మూర్ఖులు తప్ప మరేమీ కాదు;</para>
  <para style="q2" vid="ISA 19:11">ఫరో సలహాదారులు అర్థంలేని సలహాలు ఇస్తారు.</para>
  <para style="q1" vid="ISA 19:11">“నేను జ్ఞానులలో ఒకడిని,</para>
  <para style="q2" vid="ISA 19:11">పూర్వపురాజుల శిష్యుడను”</para>
  <para style="q2" vid="ISA 19:11">అని ఫరోతో మీరెలా చెప్తారు?<verse eid="ISA 19:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 19:12"/>నీ జ్ఞానులు ఏమయ్యారు?</para>
  <para style="q2" vid="ISA 19:12">సైన్యాల యెహోవా</para>
  <para style="q1" vid="ISA 19:12">ఈజిప్టు గురించి నిర్ణయించిన దానిని</para>
  <para style="q2" vid="ISA 19:12">వారు నీకు చూపించి, తెలియజేయనివ్వు.<verse eid="ISA 19:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 19:13"/>సోయను అధిపతులు మూర్ఖులయ్యారు,</para>
  <para style="q2" vid="ISA 19:13">మెంఫిసు నాయకులు మోసపోయారు.</para>
  <para style="q1" vid="ISA 19:13">ఈజిప్టు గోత్రానికి మూలరాళ్లుగా ఉన్నవారు</para>
  <para style="q2" vid="ISA 19:13">దానిని దారి తప్పేలా చేశారు.<verse eid="ISA 19:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 19:14"/>యెహోవా వారి మీద</para>
  <para style="q2" vid="ISA 19:14">భ్రమపరిచే ఆత్మను కుమ్మరించారు;</para>
  <para style="q1" vid="ISA 19:14">ఒక త్రాగుబోతు తన వాంతిలో తూలిపడినట్లు,</para>
  <para style="q2" vid="ISA 19:14">తాను చేసే పనులన్నిటిలో ఈజిప్టు తూలిపడేలా వారు చేస్తారు.<verse eid="ISA 19:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 19:15"/>తల గాని తోక గాని తాటి మట్ట గాని జమ్ము రెల్లు గాని</para>
  <para style="q2" vid="ISA 19:15">ఈజిప్టు కోసం ఎవరు ఏమి చేయలేరు.<verse eid="ISA 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 19:16"/>ఆ రోజున ఈజిప్టువారు స్త్రీలలా బలహీనంగా అవుతారు. సైన్యాల యెహోవా వారిపై తన చేయి ఆడించడం చూసి వారు భయంతో వణికిపోతారు. <verse eid="ISA 19:16"/><verse number="17" style="v" sid="ISA 19:17"/>యూదా దేశం ఈజిప్టువారికి భయం కలిగిస్తుంది; తమకు వ్యతిరేకంగా సైన్యాల యెహోవా ఉద్దేశించిన దానిని బట్టి యూదా గురించి విన్న ప్రతి ఒక్కరు భయపడతారు.<verse eid="ISA 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 19:18"/>ఆ రోజున ఈజిప్టులో ఉండే అయిదు పట్టణాలు కనాను భాష మాట్లాడి, సైన్యాల యెహోవా వారమని ప్రమాణం చేస్తాయి. వాటిలో ఒకదాని పేరు సూర్యుని పట్టణము.<note caller="+" style="f"><char style="fr" closed="false">19:18 </char><char style="ft" closed="false">కొ.ప్రా.ప్ర.లలో </char><char style="fqa" closed="false">నాశన పట్టణం</char></note><verse eid="ISA 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 19:19"/>ఆ రోజున ఈజిప్టు దేశంలో మధ్యలో యెహోవాకు ఒక బలిపీఠం, దాని సరిహద్దులో యెహోవాకు ఒక స్మారక చిహ్నం ఉంటాయి. <verse eid="ISA 19:19"/><verse number="20" style="v" sid="ISA 19:20"/>అది ఈజిప్టు దేశంలో సైన్యాల యెహోవాకు సూచనగా, సాక్ష్యంగా ఉంటుంది. తమను బాధించేవారిని గురించి వారు దేవునికి మొరపెట్టగా, ఆయన వారిని కాపాడడానికి రక్షకుడిని విమోచకుడిని పంపుతారు, అతడు వారిని రక్షిస్తాడు. <verse eid="ISA 19:20"/><verse number="21" style="v" sid="ISA 19:21"/>ఈజిప్టువారికి యెహోవా తనను తాను బయలుపరచుకుంటారు; ఆ రోజున వారు యెహోవాను తెలుసుకుంటారు. వారు బలులు, భోజనార్పణలు సమర్పించి ఆయనను ఆరాధిస్తారు. వారు యెహోవాకు మ్రొక్కుబడులు చేసి వాటిని చెల్లిస్తారు. <verse eid="ISA 19:21"/><verse number="22" style="v" sid="ISA 19:22"/>యెహోవా ఈజిప్టును తెగులుతో బాధిస్తారు; వారిని బాధించి వారిని స్వస్థపరుస్తారు. వారు యెహోవా వైపు తిరుగుతారు, ఆయన వారి విన్నపాలు విని వారిని స్వస్థపరుస్తారు.<verse eid="ISA 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ISA 19:23"/>ఆ రోజున ఈజిప్టు నుండి అష్షూరుకు రహదారి ఉంటుంది. అష్షూరీయులు ఈజిప్టుకు, ఈజిప్టువారు అష్షూరుకు వస్తూ పోతుంటారు. ఈజిప్టువారు అష్షూరీయులు కలిసి ఆరాధిస్తారు. <verse eid="ISA 19:23"/><verse number="24" style="v" sid="ISA 19:24"/>ఆ రోజున, ఈజిప్టు అష్షూరుతో పాటు ఇశ్రాయేలు మూడవదిగా ఉండి, భూమిపై ఆశీర్వాదంగా<note caller="+" style="f"><char style="fr" closed="false">19:24 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">వారి పేర్లు ఆశీర్వదించడానికి వాడబడతాయి</char></note> ఉంటుంది. <verse eid="ISA 19:24"/><verse number="25" style="v" sid="ISA 19:25"/>సైన్యాల యెహోవా, “నా ప్రజలైన ఈజిప్టు వారలారా, నా చేతి పనియైన అష్షూరీయులారా, నా స్వాస్థ్యమైన ఇశ్రాయేలీయులారా! మీరు ఆశీర్వదింపబడతారు” అని చెప్పి వారిని ఆశీర్వదిస్తారు.<verse eid="ISA 19:25"/></para>
  <chapter eid="ISA 19"/>
  <chapter number="20" style="c" sid="ISA 20"/>
  <para style="s1">ఈజిప్టుకు కూషుకు వ్యతిరేకంగా ప్రవచనం</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 20:1"/>అష్షూరు రాజైన సర్గోను తన సైన్యాధిపతిని పంపిన సంవత్సరంలో అతడు అష్డోదుకు వచ్చి, దానిపై దాడిచేసి దానిని స్వాధీనం చేసుకున్నాడు. <verse eid="ISA 20:1"/><verse number="2" style="v" sid="ISA 20:2"/>ఆ సమయంలో యెహోవా ఆమోజు కుమారుడైన యెషయా ద్వారా మాట్లాడారు. ఆయన, “నీ నడుముకున్న గోనె పట్టాను, నీ పాదాలకున్న చెప్పులు తీసివేయి” అన్నారు. అతడు అలాగే చేసి, బట్టలు తీసివేసి చెప్పులు లేకుండా నడిచాడు.<verse eid="ISA 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 20:3"/>అప్పుడు యెహోవా, “నా సేవకుడైన యెషయా ఈజిప్టు గురించి, కూషు<note caller="+" style="f"><char style="fr" closed="false">20:3 </char><char style="ft" closed="false">అంటే, నైలు ఉపరితల ప్రాంతం; <char style="xt" link-href="ISA 20:5"><ref loc="ISA 20:5">5</ref></char> వచనంలో కూడా</char></note> గురించి సూచనగా సంకేతంగా మూడు సంవత్సరాలు బట్టలు, చెప్పులు లేకుండా తిరిగిన విధంగానే <verse eid="ISA 20:3"/><verse number="4" style="v" sid="ISA 20:4"/>అష్షూరు రాజు చెరపట్టబడిన ఈజిప్టువారిని, కూషు బందీలను, పిల్లలను పెద్దలను బట్టలు లేకుండా చెప్పులు లేకుండా తీసుకు పోతాడు. ఈజిప్టువారిని అవమానం కలిగేలా వారి పిరుదుల కనిపించేలా వారిని తీసుకెళ్తాడు. <verse eid="ISA 20:4"/><verse number="5" style="v" sid="ISA 20:5"/>కూషును నమ్ముకుని ఈజిప్టును బట్టి గర్వపడినవారు దిగులుపడి, సిగ్గుపడతారు. <verse eid="ISA 20:5"/><verse number="6" style="v" sid="ISA 20:6"/>ఆ రోజున ఆ తీరప్రాంతంలో నివసించేవారు, ‘అష్షూరు రాజు చేతిలో నుండి విడుదల, సహయం కోసం మనం పారిపోయి ఆశ్రయించిన వారికి ఏమి జరిగిందో చూడండి! ఇప్పుడు మనమెలా తప్పించుకోగలం?’ అని అంటారు.”<verse eid="ISA 20:6"/></para>
  <chapter eid="ISA 20"/>
  <chapter number="21" style="c" sid="ISA 21"/>
  <para style="s1">బబులోనుకు వ్యతిరేకంగా ప్రవచనం</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 21:1"/>సముద్రపు తీరాన ఉన్న ఎడారికి వ్యతిరేకంగా ప్రవచనం:</para>
  <para style="q1" vid="ISA 21:1">దక్షిణ దిక్కున సుడిగాలి వీచినట్లుగా</para>
  <para style="q2" vid="ISA 21:1">ఎడారిలో నుండి</para>
  <para style="q2" vid="ISA 21:1">భయంకరమైన దేశం నుండి దోచుకునేవాడు వస్తాడు.<verse eid="ISA 21:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 21:2"/>భయంకరమైన దర్శనం నాకు వచ్చింది:</para>
  <para style="q2" vid="ISA 21:2">మోసం చేసేవారు మోసం చేస్తారు, దోచుకొనేవారు దోచుకుంటారు.</para>
  <para style="q1" vid="ISA 21:2">ఏలామూ, వెళ్లి దాడి చేయి! మెదీయా, ముట్టడించు!</para>
  <para style="q2" vid="ISA 21:2">దాని మూలుగు అంతటిని నేను ఆపివేస్తాను.<verse eid="ISA 21:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 21:3"/>కాబట్టి నా నడుము చాలా నొప్పిగా ఉంది,</para>
  <para style="q2" vid="ISA 21:3">ప్రసవించే స్త్రీ వేదన నాకు కలిగింది;</para>
  <para style="q1" vid="ISA 21:3">నేను విన్నదానిని బట్టి నేను తడబడ్డాను,</para>
  <para style="q2" vid="ISA 21:3">నేను చూసిన దానిని బట్టి నేను దిగ్భ్రాంతి చెందాను.<verse eid="ISA 21:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 21:4"/>నా గుండె దడదడలాడుతుంది</para>
  <para style="q2" vid="ISA 21:4">భయంతో వణుకు పుడుతుంది;</para>
  <para style="q1" vid="ISA 21:4">నేను ఇష్టమైన సంధ్యవేళ</para>
  <para style="q2" vid="ISA 21:4">నాకు భయం పుట్టించింది.<verse eid="ISA 21:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 21:5"/>వారు భోజనపు బల్లలను సిద్ధం చేశారు,</para>
  <para style="q2" vid="ISA 21:5">వారు తివాసీలు పరిచారు,</para>
  <para style="q2" vid="ISA 21:5">వారు తిని త్రాగుతారు!</para>
  <para style="q1" vid="ISA 21:5">అధిపతులారా! లేవండి</para>
  <para style="q2" vid="ISA 21:5">డాళ్లకు నూనె రాయండి.<verse eid="ISA 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 21:6"/>ప్రభువు నాతో చెప్పిన మాట ఇదే:</para>
  <para style="q1" vid="ISA 21:6">“వెళ్లి కాపలా పెట్టండి</para>
  <para style="q2" vid="ISA 21:6">అతడు చూసింది తెలియజేయాలి.<verse eid="ISA 21:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 21:7"/>అతడు రథాలను</para>
  <para style="q2" vid="ISA 21:7">గుర్రాల జట్లను</para>
  <para style="q1" vid="ISA 21:7">గాడిదల మీద వచ్చేవారిని</para>
  <para style="q2" vid="ISA 21:7">ఒంటెల మీద వచ్చేవారిని చూడగానే</para>
  <para style="q1" vid="ISA 21:7">అతడు జాగ్రత్తగా</para>
  <para style="q2" vid="ISA 21:7">చాలా జాగ్రత్తగా ఉండాలి.”<verse eid="ISA 21:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 21:8"/>కావలివాడు సింహంలా కేకలు వేసి</para>
  <para style="q1" vid="ISA 21:8">“నా ప్రభువా, ప్రతిరోజు పగలంతా కావలి గోపురం మీద నిలబడుతున్నాను;</para>
  <para style="q2" vid="ISA 21:8">రాత్రంతా కాపలా కాస్తూనే ఉన్నాను.<verse eid="ISA 21:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 21:9"/>చూడు, జతలు జతలుగా గుర్రపు రౌతులతో కలిసి</para>
  <para style="q2" vid="ISA 21:9">రథం మీద ఓ మనిషి వస్తున్నాడు అనగా</para>
  <para style="q1" vid="ISA 21:9">అతడు ఇలా సమాధానం చెప్పాడు:</para>
  <para style="q2" vid="ISA 21:9">‘బబులోను కూలిపోయింది, కూలిపోయింది!</para>
  <para style="q1" vid="ISA 21:9">దాని దేవతల విగ్రహాలన్నీ</para>
  <para style="q2" vid="ISA 21:9">నేలమీద బద్దలై పడి ఉన్నాయి.’ ”<verse eid="ISA 21:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 21:10"/>నూర్పిడి కళ్ళాల్లో నలిగిపోతున్న నా ప్రజలారా!</para>
  <para style="q2" vid="ISA 21:10">సైన్యాల యెహోవా నుండి</para>
  <para style="q1" vid="ISA 21:10">ఇశ్రాయేలు దేవుని నుండి</para>
  <para style="q2" vid="ISA 21:10">నేను విన్నది నీకు చెప్తాను.<verse eid="ISA 21:10"/></para>
  <para style="s1">ఎదోముకు వ్యతిరేకంగా ప్రవచనం</para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 21:11"/>దూమాకు<note caller="+" style="f"><char style="fr" closed="false">21:11 </char><char style="fq" closed="false">దూమా </char><char style="ft" closed="false">ఎదోముకు పదప్రయోగం </char><char style="ft" closed="false">అంటే, </char><char style="fqa" closed="false">నిశబ్దం</char></note> వ్యతిరేకంగా ప్రవచనం:</para>
  <para style="q1" vid="ISA 21:11">ఒకడు శేయీరులో నుండి నన్ను పిలుస్తున్నాడు,</para>
  <para style="q2" vid="ISA 21:11">“కావలివాడా, రాత్రి ఇంకా ఎంత ఉంది?</para>
  <para style="q2" vid="ISA 21:11">కావలివాడా, రాత్రి ఇంకా ఎంత ఉంది?”<verse eid="ISA 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 21:12"/>కావలివాడు, “ఉదయం అవుతుంది,</para>
  <para style="q2" vid="ISA 21:12">రాత్రి కూడా అవుతుంది.</para>
  <para style="q1" vid="ISA 21:12">మీరు అడగాలనుకుంటే అడగండి;</para>
  <para style="q2" vid="ISA 21:12">మరలా తిరిగి రండి” అని సమాధానం ఇస్తాడు.<verse eid="ISA 21:12"/></para>
  <para style="s1">అరేబియాకు వ్యతిరేకంగా ప్రవచనం</para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 21:13"/>అరేబియాకు వ్యతిరేకంగా ప్రవచనం:</para>
  <para style="q1" vid="ISA 21:13">అరేబియా ఎడారిలో బసచేసే</para>
  <para style="q2" vid="ISA 21:13">దెదానీయులైన యాత్రికులారా,<verse eid="ISA 21:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="ISA 21:14"/>మీరు దాహంతో ఉన్నవారికి నీళ్లు తీసుకురండి;</para>
  <para style="q1" vid="ISA 21:14">తేమా దేశ నివాసులారా,</para>
  <para style="q2" vid="ISA 21:14">పారిపోతున్నవారి కోసం ఆహారం తీసుకురండి.<verse eid="ISA 21:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 21:15"/>ఖడ్గం నుండి,</para>
  <para style="q2" vid="ISA 21:15">దూసిన ఖడ్గం నుండి,</para>
  <para style="q1" vid="ISA 21:15">ఎక్కుపెట్టిన బాణాల నుండి,</para>
  <para style="q2" vid="ISA 21:15">తీవ్రమైన యుద్ధం నుండి వారు పారిపోతారు.<verse eid="ISA 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 21:16"/>ప్రభువు నాతో చెప్పిన మాట ఇదే: “కూలివాని లెక్క ప్రకారం ఒక సంవత్సరంలోనే కేదారు వైభవమంతా ముగిసిపోతుంది. <verse eid="ISA 21:16"/><verse number="17" style="v" sid="ISA 21:17"/>కేదారు వీరులైన విలుకాండ్రలో కొంతమందే మిగిలి ఉంటారు.” ఇలా జరుగుతుందని ఇశ్రాయేలు దేవుడైన యెహోవా చెప్పారు.<verse eid="ISA 21:17"/></para>
  <chapter eid="ISA 21"/>
  <chapter number="22" style="c" sid="ISA 22"/>
  <para style="s1">యెరూషలేము గురించి ప్రవచనం</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 22:1"/>దర్శనపు లోయకు వ్యతిరేకంగా ప్రవచనం:</para>
  <para style="q1" vid="ISA 22:1">ఏ కారణంగా మీరందరు</para>
  <para style="q2" vid="ISA 22:1">మేడల మీదికి ఎక్కారు?<verse eid="ISA 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 22:2"/>కల్లోలంతో నిండిన పట్టణమా!</para>
  <para style="q2" vid="ISA 22:2">కోలాహలం, ఉల్లాసంతో ఉన్న పట్టణమా!</para>
  <para style="q1" vid="ISA 22:2">నీలో చనిపోయినవారు ఖడ్గం వలన చనిపోలేదు.</para>
  <para style="q2" vid="ISA 22:2">యుద్ధంలో మరణించలేదు.<verse eid="ISA 22:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 22:3"/>నీ నాయకులందరు కలిసి పారిపోయారు;</para>
  <para style="q2" vid="ISA 22:3">విల్లు వాడకుండానే వారు పట్టుబడ్డారు.</para>
  <para style="q1" vid="ISA 22:3">శత్రువు దూరంగా ఉండగానే పారిపోయిన వారందరిని,</para>
  <para style="q2" vid="ISA 22:3">మీలో పట్టుబడిన వారందరిని కలిపి బందీలుగా తీసుకెళ్లారు.<verse eid="ISA 22:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 22:4"/>అప్పుడు నేను, “నా నుండి దూరంగా వెళ్లండి;</para>
  <para style="q2" vid="ISA 22:4">నన్ను గట్టిగా ఏడవనివ్వండి.</para>
  <para style="q1" vid="ISA 22:4">నా ప్రజలకు కలిగిన నాశనం గురించి</para>
  <para style="q2" vid="ISA 22:4">నన్ను ఓదార్చడానికి ప్రయత్నించకండి” అని చెప్తాను.<verse eid="ISA 22:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 22:5"/>దర్శనపు లోయలో</para>
  <para style="q2" vid="ISA 22:5">సైన్యాల అధిపతియైన యెహోవా</para>
  <para style="q2" vid="ISA 22:5">నియమించిన రోజున కల్లోలం, తొక్కిసలాట, గందరగోళం ఉంటాయి,</para>
  <para style="q1" vid="ISA 22:5">గోడలు కూలిపోతాయి</para>
  <para style="q2" vid="ISA 22:5">పర్వతాల వైపు కేకలతో ఏడ్వడం ఉంటుంది.<verse eid="ISA 22:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 22:6"/>ఏలాము రథసారధులతో గుర్రాలతో</para>
  <para style="q2" vid="ISA 22:6">తన అంబులపొదిని నింపుకుంది.</para>
  <para style="q2" vid="ISA 22:6">కీరు మనుష్యులు డాలును బయటకు తీశారు.<verse eid="ISA 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 22:7"/>కాబట్టి మీకు ఇష్టమైన లోయల నిండా రథాలు ఉన్నాయి,</para>
  <para style="q2" vid="ISA 22:7">గుర్రపురౌతులు పట్టణపు గుమ్మాల దగ్గర తమ స్థానాల్లో ఉన్నారు.<verse eid="ISA 22:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 22:8"/>ప్రభువు యూదా నుండి రక్షణ కవచాన్ని తీసివేశారు,</para>
  <para style="q2" vid="ISA 22:8">ఆ రోజున మీరు అరణ్య రాజభవనంలో ఉన్న</para>
  <para style="q2" vid="ISA 22:8">ఆయుధాల వైపు చూశారు.<verse eid="ISA 22:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 22:9"/>దావీదు పట్టణపు గోడలు</para>
  <para style="q2" vid="ISA 22:9">చాలా స్థలాల్లో పాడైనట్లు చూశారు</para>
  <para style="q1" vid="ISA 22:9">దిగువన ఉన్న కొలనులో</para>
  <para style="q2" vid="ISA 22:9">మీరు నీటిని సమకూర్చారు.<verse eid="ISA 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 22:10"/>మీరు యెరూషలేములోని భవనాలను లెక్కపెట్టి</para>
  <para style="q2" vid="ISA 22:10">గోడను పటిష్టం చేయడానికి ఇళ్ళను పడగొట్టారు.<verse eid="ISA 22:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 22:11"/>పాత కొలనులో నీటి కోసం</para>
  <para style="q2" vid="ISA 22:11">మీరు రెండు గోడల మధ్య జలాశయం కట్టారు.</para>
  <para style="q1" vid="ISA 22:11">కాని దానిని నిర్మించిన వ్యక్తి వైపు మీరు చూడలేదు.</para>
  <para style="q2" vid="ISA 22:11">పూర్వకాలంలో దానిని ఆలోచించిన వ్యక్తిని మీరు లెక్కచేయలేదు.<verse eid="ISA 22:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 22:12"/>ఆ రోజున ఏడ్వడానికి కన్నీరు కార్చడానికి</para>
  <para style="q2" vid="ISA 22:12">తలలు గొరిగించుకోడానికి</para>
  <para style="q1" vid="ISA 22:12">గోనెపట్ట కట్టుకోడానికి</para>
  <para style="q2" vid="ISA 22:12">సైన్యాల అధిపతియైన యెహోవా మిమ్మల్ని పిలుస్తారు.<verse eid="ISA 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 22:13"/>కాని మీరు, “రేపు చనిపోతాం కాబట్టి</para>
  <para style="q2" vid="ISA 22:13">మనం తిని త్రాగుదాం” అని చెప్పి,</para>
  <para style="q2" vid="ISA 22:13">పశువులను నరుకుతూ గొర్రెలను చంపుతూ,</para>
  <para style="q1" vid="ISA 22:13">మాంసం తింటూ, ద్రాక్షరసం త్రాగుతూ,</para>
  <para style="q2" vid="ISA 22:13">మీరు సంతోషించి ఉల్లసిస్తారు.<verse eid="ISA 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 22:14"/>ప్రభువు, సైన్యాల యెహోవా బయలుపరిచింది ఇది: “నీ మరణించే రోజు వరకు ఈ పాపానికి ప్రాయశ్చిత్తం లేదు” అని సర్వశక్తిమంతుడైన సైన్యాల యెహోవా తెలియజేస్తున్నారు.<verse eid="ISA 22:14"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="15" style="v" sid="ISA 22:15"/>సైన్యాల అధిపతియైన యెహోవా ఇలా అంటున్నారు:</para>
  <para style="q1" vid="ISA 22:15">“నిర్వాహకుడు, అనగా రాజభవన నిర్వాహకుడైన</para>
  <para style="q2" vid="ISA 22:15">షెబ్నా దగ్గరకు వెళ్లి అతనితో ఇలా చెప్పు:<verse eid="ISA 22:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 22:16"/>నీవిక్కడేం చేస్తున్నావు</para>
  <para style="q2" vid="ISA 22:16">నీకోసం ఇక్కడ సమాధిని ఎందుకు తొలిపించుకున్నావు?</para>
  <para style="q1" vid="ISA 22:16">నీ సమాధిని ఎత్తైన స్థలంలో తొలిపించుకున్నావు?</para>
  <para style="q2" vid="ISA 22:16">నీ విశ్రాంతి స్థలాన్ని బండపై ఎందుకు చెక్కించుకున్నావు?</para>
  <para style="q2" vid="ISA 22:16">నీకు ఎవరు అనుమతి ఇచ్చారు?<verse eid="ISA 22:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 22:17"/>“ఓ బలవంతుడా, యెహోవా నిన్ను గట్టిగా పట్టుకుని,</para>
  <para style="q2" vid="ISA 22:17">వేగంగా విసిరివేస్తారు, జాగ్రత్త!<verse eid="ISA 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 22:18"/>ఆయన నిన్ను ఒక బంతిలా దొర్లించి</para>
  <para style="q2" vid="ISA 22:18">విశాలమైన దేశంలోనికి నిన్ను విసిరివేస్తారు.</para>
  <para style="q1" vid="ISA 22:18">అక్కడ నీవు చనిపోతావు,</para>
  <para style="q2" vid="ISA 22:18">నీ గొప్ప రథాలు అక్కడే పడి ఉంటాయి;</para>
  <para style="q2" vid="ISA 22:18">నీ యజమాని ఇంటికి అవమానాన్ని తెస్తావు.<verse eid="ISA 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 22:19"/>నీ పని నుండి నేను నిన్ను తొలగిస్తాను,</para>
  <para style="q2" vid="ISA 22:19">నీ హోదా నుండి త్రోసివేయబడతావు.<verse eid="ISA 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="ISA 22:20"/>“ఆ రోజున నేను, నా సేవకుడైన హిల్కీయా కుమారుడైన ఎల్యాకీమును పిలిపించి, <verse eid="ISA 22:20"/><verse number="21" style="v" sid="ISA 22:21"/>నీ చొక్కా అతనికి తొడిగించి, నీ నడికట్టు అతనికి కట్టి, నీ అధికారాన్ని అతనికి ఇస్తాను. అతడు యెరూషలేములో నివసించేవారికి, యూదా ప్రజలకు తండ్రిగా ఉంటాడు. <verse eid="ISA 22:21"/><verse number="22" style="v" sid="ISA 22:22"/>నేను దావీదు ఇంటి తాళపు చెవిని అతని భుజం మీద ఉంచుతాను; అతడు తెరచిన దానిని ఎవరూ మూయలేరు. అతడు మూసివేసిన దానిని ఎవరూ తెరవలేరు. <verse eid="ISA 22:22"/><verse number="23" style="v" sid="ISA 22:23"/>బలమైన చోట మేకు కొట్టినట్లు నేను అతని స్థిరపరుస్తాను; అతడు తన తండ్రి ఇంటికి గౌరవాన్ని ఘనతను తెచ్చే సింహాసనంగా ఉంటాడు. <verse eid="ISA 22:23"/><verse number="24" style="v" sid="ISA 22:24"/>చిన్న గిన్నెలను పాత్రలను మేకుకు వ్రేలాడదీసినట్టు అతని కుటుంబ ఘనతను అతనిపై వ్రేలాడి ఉంటుంది.<verse eid="ISA 22:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ISA 22:25"/>“సైన్యాల యెహోవా ఇలా ప్రకటిస్తున్నారు, ఆ రోజున బలమైన చోట స్థిరంగా కొట్టబడిన మేకు ఊడిపోయి క్రిందపడిపోతుంది. దానిపై ఉన్న బరువు తెగి క్రిందపడుతుంది.” ఇదే యెహోవా చెప్పిన మాట.<verse eid="ISA 22:25"/></para>
  <chapter eid="ISA 22"/>
  <chapter number="23" style="c" sid="ISA 23"/>
  <para style="s1">తూరుకు వ్యతిరేకంగా ప్రవచనం</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 23:1"/>తూరుకు వ్యతిరేకంగా ప్రవచనం:</para>
  <para style="q1" vid="ISA 23:1">తర్షీషు ఓడలారా! రోదించండి:</para>
  <para style="q2" vid="ISA 23:1">తూరు నాశనమయ్యింది,</para>
  <para style="q2" vid="ISA 23:1">అది ఇల్లు గాని ఓడరేవు గాని లేకుండ మిగిలింది.</para>
  <para style="q1" vid="ISA 23:1">కుప్ర దేశం నుండి</para>
  <para style="q2" vid="ISA 23:1">ఈ విషయం వారికి తెలియజేయబడింది.<verse eid="ISA 23:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 23:2"/>సముద్ర తీర వాసులారా,</para>
  <para style="q2" vid="ISA 23:2">సీదోను వ్యాపారులారా, మౌనంగా ఉండండి,</para>
  <para style="q2" vid="ISA 23:2">సముద్ర నావికులు మిమ్మల్ని సంపన్నులుగా చేశారు.<verse eid="ISA 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 23:3"/>గొప్ప జలాల మీద</para>
  <para style="q2" vid="ISA 23:3">షీహోరు ధాన్యం వచ్చింది;</para>
  <para style="q1" vid="ISA 23:3">నైలు ప్రాంతంలో పండిన పంట తూరుకు ఆదాయం ఇచ్చింది,</para>
  <para style="q2" vid="ISA 23:3">అది దేశాలకు వాణిజ్య కేంద్రంగా మారింది.<verse eid="ISA 23:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 23:4"/>సీదోనూ, సముద్రపు కోట సిగ్గుపడండి,</para>
  <para style="q2" vid="ISA 23:4">సముద్రం ఇలా మాట్లాడింది:</para>
  <para style="q1" vid="ISA 23:4">“నేను ప్రసవ వేదన పడలేదు, పిల్లలు కనలేదు,</para>
  <para style="q2" vid="ISA 23:4">కుమారులను పోషించలేదు కుమార్తెలను పెంచలేదు.”<verse eid="ISA 23:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 23:5"/>వార్త ఈజిప్టుకు చేరినప్పుడు</para>
  <para style="q2" vid="ISA 23:5">తూరు గురించి వారు వేదన పడతారు.<verse eid="ISA 23:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 23:6"/>తర్షీషుకు వెళ్లండి;</para>
  <para style="q2" vid="ISA 23:6">సముద్ర తీర వాసులారా దుఃఖపడండి.<verse eid="ISA 23:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 23:7"/>మీకు ఉల్లాసం కలిగించిన పట్టణం ఇదేనా?</para>
  <para style="q2" vid="ISA 23:7">పాతది, ప్రాచీన పట్టణం,</para>
  <para style="q1" vid="ISA 23:7">దూరదేశంలో నివసించడానికి</para>
  <para style="q2" vid="ISA 23:7">సుదూర ప్రయాణం చేసింది ఇదేనా?<verse eid="ISA 23:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 23:8"/>తూరు కిరీటాలు పంచిపెట్టే పట్టణం,</para>
  <para style="q2" vid="ISA 23:8">దాని వ్యాపారులు రాకుమారులు,</para>
  <para style="q1" vid="ISA 23:8">దాని వర్తకులు భూమి మీద ప్రసిద్ధులు,</para>
  <para style="q2" vid="ISA 23:8">అలాంటి తూరుకు వ్యతిరేకంగా ఎవరు ఆలోచన చేశారు?<verse eid="ISA 23:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 23:9"/>తనకున్న అందాన్ని బట్టి కలిగిన గర్వాన్ని అణచడానికి</para>
  <para style="q2" vid="ISA 23:9">భూమి మీద ప్రసిద్ధులందరిని అవమానపరచడానికి</para>
  <para style="q2" vid="ISA 23:9">సైన్యాల యెహోవా ఇలా చేశారు.<verse eid="ISA 23:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 23:10"/>తర్షీషు కుమారీ,</para>
  <para style="q2" vid="ISA 23:10">నీ దేశానికి ఇక ఓడరేవు లేదు కాబట్టి</para>
  <para style="q2" vid="ISA 23:10">నైలు నది దాటునట్లు మీ దేశానికి తిరిగి వెళ్లు.<verse eid="ISA 23:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 23:11"/>యెహోవా సముద్రం మీద తన చేయి చాపి</para>
  <para style="q2" vid="ISA 23:11">దాని రాజ్యాలు వణికేలా చేశారు.</para>
  <para style="q1" vid="ISA 23:11">కనాను కోటలను నాశనం చేయడానికి</para>
  <para style="q2" vid="ISA 23:11">ఆయన దాని గురించి ఆజ్ఞ ఇచ్చారు.<verse eid="ISA 23:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 23:12"/>ఆయన ఇలా అన్నారు, “అణచివేతకు గురైన సీదోను కుమార్తె,</para>
  <para style="q2" vid="ISA 23:12">ఇకపై నీకు సంతోషం ఉండదు.</para>
  <para style="b" vid="ISA 23:12"/>
  <para style="q1" vid="ISA 23:12">“నీవు లేచి కుప్రకు వెళ్లు,</para>
  <para style="q2" vid="ISA 23:12">అక్కడ కూడా నీకు విశ్రాంతి దొరకదు.”<verse eid="ISA 23:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 23:13"/>బబులోనీయుల<note caller="+" style="f"><char style="fr" closed="false">23:13 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">కల్దీయుల</char></note> దేశాన్ని చూడు,</para>
  <para style="q2" vid="ISA 23:13">వారు తమ గుర్తింపును కోల్పోయారు!</para>
  <para style="q1" vid="ISA 23:13">అష్షూరీయులు దానిని</para>
  <para style="q2" vid="ISA 23:13">ఎడారి జీవులకు నివాసంగా చేశారు.</para>
  <para style="q1" vid="ISA 23:13">వారు దానిలో ముట్టడి గోపురాలు కట్టించి,</para>
  <para style="q2" vid="ISA 23:13">దాని కోటలు పడగొట్టి</para>
  <para style="q2" vid="ISA 23:13">శిథిలాలుగా మార్చారు.<verse eid="ISA 23:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 23:14"/>తర్షీషు ఓడలారా, రోదించండి;</para>
  <para style="q2" vid="ISA 23:14">మీ కోట నాశనమయ్యింది.<verse eid="ISA 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 23:15"/>ఒక రాజు జీవితకాలంలా డెబ్బై సంవత్సరాలు తూరు గురించి మరచిపోతారు. అయితే డెబ్బై సంవత్సరాలు ముగింపులో వేశ్యల పాటలో ఉన్నట్లుగా తూరుకు జరుగుతుంది:<verse eid="ISA 23:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 23:16"/>“మరవబడిన వేశ్యా,</para>
  <para style="q2" vid="ISA 23:16">సితారా తీసుకుని పట్టణంలో తిరుగు;</para>
  <para style="q1" vid="ISA 23:16">నీవు జ్ఞాపకం వచ్చేలా</para>
  <para style="q2" vid="ISA 23:16">సితారా మంచిగా వాయిస్తూ చాలా పాటలు పాడు.”<verse eid="ISA 23:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 23:17"/>డెబ్బై సంవత్సరాల తర్వాత యెహోవా తూరు మీద దయ చూపిస్తారు. కాని అది తన లాభదాయకమైన వ్యభిచారానికి తిరిగివెళ్లి భూమిపై ఉన్న అన్ని రాజ్యాలతో వ్యాపారం చేస్తుంది. <verse eid="ISA 23:17"/><verse number="18" style="v" sid="ISA 23:18"/>అయినా దాని లాభం, దాని సంపాదన యెహోవాకు చెందుతుంది; వాటిని నిల్వ ఉంచరు, కూడబెట్టరు. దాని లాభాలు యెహోవా సన్నిధిలో నివసించేవారికి సమృద్ధి ఆహారం, విలువైన వస్త్రాలు అందించడానికి ఉపయోగించబడతాయి.<verse eid="ISA 23:18"/></para>
  <chapter eid="ISA 23"/>
  <chapter number="24" style="c" sid="ISA 24"/>
  <para style="s1">యెహోవా భూమిని నాశనం చేయుట</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 24:1"/>చూడండి, యెహోవా భూమిని పాడుచేసి</para>
  <para style="q2" vid="ISA 24:1">నాశనం చేయబోతున్నారు;</para>
  <para style="q1" vid="ISA 24:1">ఆయన దాని ఉపరితలాన్ని పాడుచేసి</para>
  <para style="q2" vid="ISA 24:1">దానిలో నివసించేవారిని చెదరగొడతారు.<verse eid="ISA 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 24:2"/>అందరికి ఒకేలా ఉంటుంది;</para>
  <para style="q2" vid="ISA 24:2">ప్రజలకు కలిగినట్లే యాజకునికి,</para>
  <para style="q2" vid="ISA 24:2">సేవకునికి కలిగినట్లే యజమానికి,</para>
  <para style="q2" vid="ISA 24:2">సేవకురాలికి కలిగినట్లే యజమానురాలికి,</para>
  <para style="q2" vid="ISA 24:2">కొనేవారికి కలిగినట్లే అమ్మేవారికి,</para>
  <para style="q2" vid="ISA 24:2">అప్పు ఇచ్చేవారికి కలిగినట్లే అప్పు తీసుకునేవారికి,</para>
  <para style="q2" vid="ISA 24:2">వడ్డీకి ఇచ్చేవారికి కలిగినట్లే వడ్డీకి తీసుకునేవారికి కలుగుతుంది.<verse eid="ISA 24:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 24:3"/>భూమి పూర్తిగా పాడుచేయబడి</para>
  <para style="q2" vid="ISA 24:3">పూర్తిగా దోచుకోబడుతుంది.</para>
  <para style="q1" vid="ISA 24:3">యెహోవా ఈ మాట చెప్పారు.<verse eid="ISA 24:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 24:4"/>భూమి ఎండిపోయి వాడిపోతుంది,</para>
  <para style="q2" vid="ISA 24:4">లోకం క్షీణించి వాడిపోతుంది,</para>
  <para style="q2" vid="ISA 24:4">ఆకాశాలు భూమితో పాటు క్షీణించిపోతాయి.<verse eid="ISA 24:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 24:5"/>భూప్రజలును బట్టి భూమి అపవిత్రమైంది;</para>
  <para style="q2" vid="ISA 24:5">వారు చట్టాలకు లోబడలేదు,</para>
  <para style="q1" vid="ISA 24:5">వారు కట్టడలను ఉల్లంఘించారు</para>
  <para style="q2" vid="ISA 24:5">వారు నిత్యనిబంధనను భంగం చేశారు.<verse eid="ISA 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 24:6"/>కాబట్టి ఒక శాపం భూమిని మ్రింగివేస్తుంది;</para>
  <para style="q2" vid="ISA 24:6">దాని ప్రజలు తమ అపరాధాన్ని భరించాలి.</para>
  <para style="q1" vid="ISA 24:6">కాబట్టి భూనివాసులు కాలిపోయారు</para>
  <para style="q2" vid="ISA 24:6">కేవలం కొద్దిమంది మిగిలారు.<verse eid="ISA 24:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 24:7"/>క్రొత్త ద్రాక్షరసం ఎండిపోతుంది, ద్రాక్షతీగె వాడిపోతుంది;</para>
  <para style="q2" vid="ISA 24:7">సంతోషంగా ఉన్నవారు మూల్గుతారు.<verse eid="ISA 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 24:8"/>ఆనందంతో చేసే తంబురల ధ్వనులు నిలిచిపోయాయి,</para>
  <para style="q2" vid="ISA 24:8">కేకలు వేసే వారి ధ్వని ఆగిపోయింది</para>
  <para style="q2" vid="ISA 24:8">ఆనందంగా ఉన్న సితార నిశ్శబ్దంగా ఉంది.<verse eid="ISA 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 24:9"/>ఇక వారు పాటలు పాడుతూ ద్రాక్షరసం త్రాగరు;</para>
  <para style="q2" vid="ISA 24:9">మద్యం త్రాగే వారికి అది చేదుగా మారింది.<verse eid="ISA 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 24:10"/>శిథిలమైన పట్టణం నిర్జనంగా ఉంది;</para>
  <para style="q2" vid="ISA 24:10">ప్రతి ఇంటి గుమ్మం మూయబడింది.<verse eid="ISA 24:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 24:11"/>ద్రాక్షరసం కోసం వారు వీధుల్లో కేకలు వేస్తున్నారు;</para>
  <para style="q2" vid="ISA 24:11">ఆనందమంతా దిగులుగా మారుతుంది,</para>
  <para style="q2" vid="ISA 24:11">దేశం ఆనంద ధ్వనులన్నీ నిషేధించబడ్డాయి.<verse eid="ISA 24:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 24:12"/>పట్టణం శిథిలాల్లో ఉన్నది,</para>
  <para style="q2" vid="ISA 24:12">దాని గుమ్మం ముక్కలుగా విరిగిపోయింది.<verse eid="ISA 24:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 24:13"/>ఒలీవ చెట్టుని దులిపినప్పుడు,</para>
  <para style="q2" vid="ISA 24:13">ద్రాక్షపండ్ల కోత తర్వాత పరిగె పళ్ళు ఏరుకుంటున్నప్పుడు జరిగినట్లుగా</para>
  <para style="q1" vid="ISA 24:13">భూమి మీద</para>
  <para style="q2" vid="ISA 24:13">భూమి మీద ప్రజలందరి మధ్యలో ఇది జరుగుతుంది.<verse eid="ISA 24:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 24:14"/>వారు తమ స్వరాలెత్తి ఆనందంతో కేకలు వేస్తారు;</para>
  <para style="q2" vid="ISA 24:14">పశ్చిమ నుండి వారు యెహోవా గొప్పతనాన్ని కొనియాడుతారు.<verse eid="ISA 24:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 24:15"/>కాబట్టి తూర్పున ఉన్నవారలారా, యెహోవాను ఘనపరచండి.</para>
  <para style="q2" vid="ISA 24:15">సముద్ర ద్వీపవాసులారా,</para>
  <para style="q2" vid="ISA 24:15">ఇశ్రాయేలు దేవుడైన యెహోవా నామాన్ని ఘనపరచండి.<verse eid="ISA 24:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 24:16"/>భూమి అంచుల నుండి మేము ఇలా పాడడం వింటున్నాము:</para>
  <para style="q2" vid="ISA 24:16">“నీతిమంతునికి<note caller="+" style="f"><char style="fr" closed="false">24:16 </char><char style="ft" closed="false">అంటే, </char><char style="fqa" closed="false">దేవునికి</char></note> ఘనత.”</para>
  <para style="b" vid="ISA 24:16"/>
  <para style="q1" vid="ISA 24:16">అయితే నేను అన్నాను, “నేను చెడిపోయాను, చెడిపోయాను!</para>
  <para style="q2" vid="ISA 24:16">నాకు శ్రమ!</para>
  <para style="q1" vid="ISA 24:16">మోసగాళ్ళు ద్రోహం చేస్తారు,</para>
  <para style="q2" vid="ISA 24:16">మోసగాళ్ళు మోసంతో ద్రోహం చేస్తారు!”<verse eid="ISA 24:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 24:17"/>భూలోక ప్రజలారా!</para>
  <para style="q2" vid="ISA 24:17">మీ కోసం భయం, గుంట, ఉరి వేచి ఉన్నాయి.<verse eid="ISA 24:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 24:18"/>భయంకరమైన శబ్దం విని ఎవరైతే పారిపోతారో</para>
  <para style="q2" vid="ISA 24:18">వారు గుంటలో పడతారు;</para>
  <para style="q1" vid="ISA 24:18">ఎవరైతే గుంటలో నుండి పైకి వస్తారో,</para>
  <para style="q2" vid="ISA 24:18">వారు ఉరిలో చిక్కుకుంటారు.</para>
  <para style="b" vid="ISA 24:18"/>
  <para style="q1" vid="ISA 24:18">ఆకాశపు తూములు తెరవబడ్డాయి</para>
  <para style="q2" vid="ISA 24:18">భూమి పునాదులు కదిలాయి.<verse eid="ISA 24:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 24:19"/>భూమి బద్దలై పోయింది,</para>
  <para style="q2" vid="ISA 24:19">భూమి ముక్కలుగా చీలిపోయింది,</para>
  <para style="q2" vid="ISA 24:19">భూమి భయంకరంగా అదురుతుంది.<verse eid="ISA 24:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 24:20"/>భూమి త్రాగుబోతులా తూలుతుంది,</para>
  <para style="q2" vid="ISA 24:20">గాలికి ఊగే పాకలా ఇటు అటు ఊగుతుంది.</para>
  <para style="q1" vid="ISA 24:20">దాని తిరుగుబాటు అపరాధం దానిపై బరువుగా ఉంది</para>
  <para style="q2" vid="ISA 24:20">అది ఇక లేవనంతగా పడిపోతుంది.<verse eid="ISA 24:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 24:21"/>ఆ రోజున యెహోవా</para>
  <para style="q2" vid="ISA 24:21">పైన ఆకాశాల్లో ఉన్న శక్తులను,</para>
  <para style="q2" vid="ISA 24:21">భూమి మీద ఉన్న రాజులను శిక్షిస్తారు.<verse eid="ISA 24:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 24:22"/>చెరసాలలో బంధించబడిన ఖైదీలవలె</para>
  <para style="q2" vid="ISA 24:22">వారు చెరసాలలో వేయబడతారు.</para>
  <para style="q1" vid="ISA 24:22">చాలా రోజులు అక్కడ ఉన్న తర్వాత</para>
  <para style="q2" vid="ISA 24:22">వారు శిక్షించబడతారు.<note caller="+" style="f"><char style="fr" closed="false">24:22 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">విడుదల చేయబడతారు</char></note><verse eid="ISA 24:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 24:23"/>చంద్రుడు దిగులు చెందుతాడు</para>
  <para style="q2" vid="ISA 24:23">సూర్యుడు సిగ్గుపడతాడు;</para>
  <para style="q1" vid="ISA 24:23">సైన్యాల యెహోవా</para>
  <para style="q2" vid="ISA 24:23">సీయోను కొండమీద యెరూషలేములో,</para>
  <para style="q2" vid="ISA 24:23">దాని పెద్దల ఎదుట గొప్ప మహిమతో రాజ్యమేలుతారు.<verse eid="ISA 24:23"/></para>
  <chapter eid="ISA 24"/>
  <chapter number="25" style="c" sid="ISA 25"/>
  <para style="s1">యెహోవాకు స్తుతి</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 25:1"/>యెహోవా, మీరే నా దేవుడు;</para>
  <para style="q2" vid="ISA 25:1">నేను మిమ్మల్ని ఘనపరచి మీ నామాన్ని స్తుతిస్తాను,</para>
  <para style="q1" vid="ISA 25:1">పరిపూర్ణ నమ్మకత్వంతో</para>
  <para style="q2" vid="ISA 25:1">మీరు ఎంతో కాలం క్రితం ఆలోచించిన</para>
  <para style="q2" vid="ISA 25:1">అద్భుతాలను మీరు చేశారు.<verse eid="ISA 25:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 25:2"/>మీరు పట్టణాన్ని శిథిలాల కుప్పగా</para>
  <para style="q2" vid="ISA 25:2">కోట ఉన్న పట్టణాన్ని పాడైన దానిగా,</para>
  <para style="q1" vid="ISA 25:2">విదేశీయుల దుర్గాన్ని పట్టణంగా ఉండకుండా చేశారు;</para>
  <para style="q2" vid="ISA 25:2">అది ఎప్పటికీ తిరిగి కట్టబడదు.<verse eid="ISA 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 25:3"/>కాబట్టి బలమైన జనాంగాలు మిమ్మల్ని గౌరవిస్తారు;</para>
  <para style="q2" vid="ISA 25:3">క్రూరమైన దేశాల పట్టణాలు మీకు భయపడతాయి.<verse eid="ISA 25:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 25:4"/>మీరు పేదవారికి ఆశ్రయంగా ఉన్నారు,</para>
  <para style="q2" vid="ISA 25:4">అవసరతలో ఉన్నవారికి తమ బాధలో మీరు ఆశ్రయంగా ఉన్నారు,</para>
  <para style="q1" vid="ISA 25:4">తుఫానులో ఉన్నవారికి ఆశ్రయంగా,</para>
  <para style="q2" vid="ISA 25:4">వేడి నుండి తప్పించే నీడగా ఉన్నారు.</para>
  <para style="q1" vid="ISA 25:4">ఎందుకంటే, క్రూరుల శ్వాస</para>
  <para style="q2" vid="ISA 25:4">గోడకు తాకే తుఫానులా,<verse eid="ISA 25:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="ISA 25:5"/>ఎడారి వేడిలా ఉంటుంది.</para>
  <para style="q1" vid="ISA 25:5">మీరు విదేశీయుల ప్రగల్భాలను అణచివేశారు;</para>
  <para style="q2" vid="ISA 25:5">మేఘాల నీడ ద్వారా వేడి తగ్గునట్లు</para>
  <para style="q2" vid="ISA 25:5">క్రూరుల పాట నిలిపివేయబడుతుంది.<verse eid="ISA 25:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 25:6"/>ఈ పర్వతం మీద సైన్యాల యెహోవా</para>
  <para style="q2" vid="ISA 25:6">ప్రజలందరి కోసం క్రొవ్విన వాటిలో విందు సిద్ధం చేస్తారు</para>
  <para style="q1" vid="ISA 25:6">ఈ విందులో పాత ద్రాక్షరసం ఉంటుంది</para>
  <para style="q2" vid="ISA 25:6">లేత మాంసం, ఎంపిక చేసిన ద్రాక్షరసం ఉంటాయి.<verse eid="ISA 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 25:7"/>ఈ పర్వతంపై ఆయన</para>
  <para style="q2" vid="ISA 25:7">ప్రజలందరి ముఖాల మీద ఉన్న ముసుగును</para>
  <para style="q1" vid="ISA 25:7">సమస్త దేశాల మీద ఉన్న తెరను తీసివేస్తారు;<verse eid="ISA 25:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="ISA 25:8"/>శాశ్వతంగా ఆయన మరణాన్ని మ్రింగివేస్తారు.</para>
  <para style="q1" vid="ISA 25:8">ప్రభువైన యెహోవా ప్రతివాని ముఖం మీది</para>
  <para style="q2" vid="ISA 25:8">కన్నీటిని తుడిచివేస్తారు;</para>
  <para style="q1" vid="ISA 25:8">సమస్త భూమి మీద నుండి</para>
  <para style="q2" vid="ISA 25:8">తన ప్రజల అవమానాన్ని తొలగిస్తారు.</para>
  <para style="q1" vid="ISA 25:8">యెహోవా ఇది తెలియజేశారు.<verse eid="ISA 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 25:9"/>ఆ రోజున వారు ఇలా అంటారు,</para>
  <para style="q1" vid="ISA 25:9">“నిజంగా ఈయనే మన దేవుడు</para>
  <para style="q2" vid="ISA 25:9">ఈయనను మనం నమ్ముకున్నాం, ఈయన మనల్ని రక్షించారు.</para>
  <para style="q1" vid="ISA 25:9">మనం నమ్మిన యెహోవా ఈయనే;</para>
  <para style="q2" vid="ISA 25:9">ఆయన రక్షణను బట్టి సంతోషించి ఆనందిద్దాము.”<verse eid="ISA 25:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 25:10"/>యెహోవా చేయి ఈ పర్వతంపై నిలిచి ఉంటుంది;</para>
  <para style="q2" vid="ISA 25:10">అయితే పెంటకుప్పలో గడ్డిని త్రొక్కినట్లు,</para>
  <para style="q2" vid="ISA 25:10">మోయాబీయులు తమ దేశంలోనే త్రొక్కబడతారు.<verse eid="ISA 25:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 25:11"/>ఈతగాళ్లు ఈదడానికి తమ చేతులు చాపినట్లు</para>
  <para style="q2" vid="ISA 25:11">వారు దాని మధ్య తమ చేతులు చాపుతారు.</para>
  <para style="q1" vid="ISA 25:11">వారి చేతులు యుక్తితో ఉన్నా</para>
  <para style="q2" vid="ISA 25:11">దేవుడు వారి గర్వాన్ని అణచివేస్తారు.<verse eid="ISA 25:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 25:12"/>మోయాబూ, నీ ఎత్తైన కోటలను</para>
  <para style="q2" vid="ISA 25:12">ఆయన పడగొడతారు.</para>
  <para style="q1" vid="ISA 25:12">వాటిని నేలకు అణగద్రొక్కి</para>
  <para style="q2" vid="ISA 25:12">ధూళిలో పడవేస్తారు.<verse eid="ISA 25:12"/></para>
  <chapter eid="ISA 25"/>
  <chapter number="26" style="c" sid="ISA 26"/>
  <para style="s1">స్తుతి గీతం</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 26:1"/>ఆ రోజున యూదా దేశంలో ఈ పాట పాడతారు:</para>
  <para style="q1" vid="ISA 26:1">మనకు ఒక బలమైన పట్టణం ఉంది;</para>
  <para style="q2" vid="ISA 26:1">దేవుడు రక్షణను</para>
  <para style="q2" vid="ISA 26:1">దానికి గోడలుగా, ప్రాకారాలుగా ఉంచుతారు.<verse eid="ISA 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 26:2"/>నీతిగల దేశం</para>
  <para style="q2" vid="ISA 26:2">నమ్మదగిన దేశం ప్రవేశించేలా</para>
  <para style="q2" vid="ISA 26:2">గుమ్మాలు తీయండి.<verse eid="ISA 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 26:3"/>మీరు స్థిరమైన మనస్సుగల వారిని</para>
  <para style="q2" vid="ISA 26:3">సంపూర్ణ సమాధానంతో కాపాడతారు,</para>
  <para style="q2" vid="ISA 26:3">ఎందుకంటే వారు మీపై విశ్వాసముంచారు.<verse eid="ISA 26:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 26:4"/>యెహోవా యెహోవాయే శాశ్వతమైన బండ</para>
  <para style="q2" vid="ISA 26:4">కాబట్టి నిత్యం యెహోవాను నమ్ముకోండి.<verse eid="ISA 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 26:5"/>ఆయన ఎత్తైన స్ధలంలో నివసించేవారిని అణచివేస్తారు</para>
  <para style="q2" vid="ISA 26:5">ఎత్తైన కోటలను పడగొడతారు;</para>
  <para style="q1" vid="ISA 26:5">ఆయన దానిని నేల మట్టుకు పడగొట్టి</para>
  <para style="q2" vid="ISA 26:5">దానిని ధూళిలో కలుపుతారు.<verse eid="ISA 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 26:6"/>అణచివేయబడినవారి కాళ్లతో</para>
  <para style="q2" vid="ISA 26:6">పేదవారి అడుగులతో</para>
  <para style="q2" vid="ISA 26:6">అది త్రొక్కబడుతుంది.<verse eid="ISA 26:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 26:7"/>నీతిమంతుల దారి సమంగా ఉంటుంది;</para>
  <para style="q2" vid="ISA 26:7">యథార్థవంతుడా, మీరు నీతిమంతుల మార్గం సరాళం చేస్తావు.<verse eid="ISA 26:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 26:8"/>అవును యెహోవా, మీ న్యాయవిధుల మార్గాల్లో నడుస్తూ</para>
  <para style="q2" vid="ISA 26:8">మేము మీ కోసం వేచి ఉన్నాము;</para>
  <para style="q1" vid="ISA 26:8">మీ నామం మీ కీర్తి</para>
  <para style="q2" vid="ISA 26:8">మా హృదయాల కోరిక.<verse eid="ISA 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 26:9"/>రాత్రివేళ నా ప్రాణం మీ కోసం ఆరాటపడుతుంది;</para>
  <para style="q2" vid="ISA 26:9">ఉదయం నా ఆత్మ మిమ్మల్ని వెదుకుతుంది.</para>
  <para style="q1" vid="ISA 26:9">మీ తీర్పులు భూమి మీదికి వచ్చినప్పుడు,</para>
  <para style="q2" vid="ISA 26:9">ఈ లోక ప్రజలు నీతిని నేర్చుకుంటారు.<verse eid="ISA 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 26:10"/>కాని చెడ్డవారికి దయ చూపిస్తే,</para>
  <para style="q2" vid="ISA 26:10">వారు నీతిని నేర్చుకోరు.</para>
  <para style="q1" vid="ISA 26:10">యథార్థమైన దేశంలో ఉన్నా కూడా వారు చెడు చేస్తూనే ఉంటారు</para>
  <para style="q2" vid="ISA 26:10">యెహోవా ఘనతను వారు పట్టించుకోరు.<verse eid="ISA 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 26:11"/>యెహోవా! మీ చేయి ఎత్తుగా ఎత్తబడింది,</para>
  <para style="q2" vid="ISA 26:11">కాని వారు దానిని చూడరు.</para>
  <para style="q1" vid="ISA 26:11">మీ ప్రజల పట్ల మీకున్న ఆసక్తి చూసి వారు సిగ్గుపడతారు;</para>
  <para style="q2" vid="ISA 26:11">మీ శత్రువుల కోసం కేటాయించబడిన అగ్ని వారిని కాల్చివేయాలి.<verse eid="ISA 26:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 26:12"/>యెహోవా! మీరు మాకు సమాధానాన్ని స్థాపిస్తారు;</para>
  <para style="q2" vid="ISA 26:12">మేము సాధించిందంతా మీరు మాకోసం చేసిందే.<verse eid="ISA 26:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 26:13"/>యెహోవా! మా దేవా! మీరు కాకుండా వేరే ప్రభువులు మమ్మల్ని పాలించారు,</para>
  <para style="q2" vid="ISA 26:13">కాని మేము మీ నామాన్ని మాత్రమే ఘనపరుస్తాము.<verse eid="ISA 26:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 26:14"/>వారు చనిపోయారు, మరల బ్రతకరు;</para>
  <para style="q2" vid="ISA 26:14">వారి ఆత్మలు లేవవు.</para>
  <para style="q1" vid="ISA 26:14">మీరు వారిని శిక్షించి నాశనం చేశారు;</para>
  <para style="q2" vid="ISA 26:14">మీరు వారి జ్ఞాపకాలన్నిటిని తుడిచివేశారు.<verse eid="ISA 26:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 26:15"/>యెహోవా, మీరు దేశాన్ని వృద్ధిచేశారు;</para>
  <para style="q2" vid="ISA 26:15">మీరు దేశాన్ని వృద్ధిచేశారు.</para>
  <para style="q1" vid="ISA 26:15">మీరు మీకే మహిమ సంపాదించుకున్నారు;</para>
  <para style="q2" vid="ISA 26:15">మీరు దేశపు సరిహద్దులన్నిటిని విస్తరింపజేశారు.<verse eid="ISA 26:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 26:16"/>యెహోవా! వారు తమ బాధలో మీ దగ్గరకు వచ్చారు;</para>
  <para style="q2" vid="ISA 26:16">మీరు వారిని శిక్షించినప్పుడు</para>
  <para style="q2" vid="ISA 26:16">వారు దీన ప్రార్థనలు చేశారు.<verse eid="ISA 26:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 26:17"/>గర్భిణి స్త్రీ ప్రసవానికి సిద్ధమైనప్పుడు</para>
  <para style="q2" vid="ISA 26:17">ఆ నొప్పికి బాధతో కేకలు వేసినట్లు</para>
  <para style="q2" vid="ISA 26:17">యెహోవా మీ సన్నిధిలో మేము ఉన్నాము.<verse eid="ISA 26:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 26:18"/>మేము గర్భం ధరించి ప్రసవవేదన పడ్డాము.</para>
  <para style="q2" vid="ISA 26:18">కాని గాలికి జన్మనిచ్చాము.</para>
  <para style="q1" vid="ISA 26:18">మేము భూమికి రక్షణను తీసుకురాలేదు,</para>
  <para style="q2" vid="ISA 26:18">ఈ లోక ప్రజలు పుట్టలేదు.<verse eid="ISA 26:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 26:19"/>కాని యెహోవా, చనిపోయిన మీ వారు బ్రతుకుతారు;</para>
  <para style="q2" vid="ISA 26:19">వారి శరీరాలు పైకి లేస్తాయి</para>
  <para style="q1" vid="ISA 26:19">మట్టిలో నివసిస్తున్నవారు,</para>
  <para style="q2" vid="ISA 26:19">మేల్కొని సంతోషించాలి.</para>
  <para style="q1" vid="ISA 26:19">మీ మంచు ఉదయపు మంచు వంటిది;</para>
  <para style="q2" vid="ISA 26:19">భూమి తన మృతులకు జన్మనిస్తుంది.<verse eid="ISA 26:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 26:20"/>నా ప్రజలారా! మీ గదిలోకి వెళ్లి</para>
  <para style="q2" vid="ISA 26:20">మీ వెనక తలుపులు వేసుకోండి;</para>
  <para style="q1" vid="ISA 26:20">ఆయన ఉగ్రత పోయే వరకు</para>
  <para style="q2" vid="ISA 26:20">కొంతకాలం మీరు దాక్కోండి.<verse eid="ISA 26:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 26:21"/>ఇదిగో వారి పాపాలను బట్టి భూప్రజలను శిక్షించడానికి</para>
  <para style="q2" vid="ISA 26:21">యెహోవా తన నివాసంలో నుండి వస్తున్నారు.</para>
  <para style="q1" vid="ISA 26:21">భూమి తనపై చిందిన రక్తాన్ని వెల్లడిస్తుంది;</para>
  <para style="q2" vid="ISA 26:21">భూమి చంపబడిన వారిని ఇకపై దాచదు.<verse eid="ISA 26:21"/></para>
  <chapter eid="ISA 26"/>
  <chapter number="27" style="c" sid="ISA 27"/>
  <para style="s1">ఇశ్రాయేలు విడుదల</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 27:1"/>ఆ రోజున</para>
  <para style="q1" vid="ISA 27:1">యెహోవా భయంకరమైన, గొప్పదైన</para>
  <para style="q2" vid="ISA 27:1">శక్తిగల తన ఖడ్గంతో</para>
  <para style="q1" vid="ISA 27:1">లెవియాథన్ అనే ఎగిరే పాము,</para>
  <para style="q2" vid="ISA 27:1">లెవియాథన్ అనే చుట్టుకునే పామును ఆయన శిక్షిస్తారు.</para>
  <para style="q1" vid="ISA 27:1">ఆయన సముద్రపు మృగాన్ని చంపుతారు.<verse eid="ISA 27:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 27:2"/>ఆ రోజున</para>
  <para style="q1" vid="ISA 27:2">“ఫలభరితమైన ద్రాక్షతోట గురించి పాడండి:<verse eid="ISA 27:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="ISA 27:3"/>యెహోవానైన నేను దానిని కాపాడతాను;</para>
  <para style="q2" vid="ISA 27:3">నేను దానికి క్రమంగా నీరు పెడతాను.</para>
  <para style="q1" vid="ISA 27:3">ఎవరూ దానిని పాడు చేయకుండ</para>
  <para style="q2" vid="ISA 27:3">రాత్రి పగలు కాపలా కాస్తాను.<verse eid="ISA 27:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="ISA 27:4"/>నాకు కోపం లేదు.</para>
  <para style="q1" vid="ISA 27:4">ఒకవేళ గచ్చపొదలు ముళ్ళచెట్లు ఉంటే</para>
  <para style="q2" vid="ISA 27:4">యుద్ధం చేయడానికి వాటికి ఎదురు వెళ్తాను</para>
  <para style="q2" vid="ISA 27:4">వాటన్నిటిని కాల్చివేస్తాను.<verse eid="ISA 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 27:5"/>ఆశ్రయం కోసం వారు నా దగ్గరకు రానివ్వండి;</para>
  <para style="q2" vid="ISA 27:5">వారు నాతో సమాధానపడాలి,</para>
  <para style="q2" vid="ISA 27:5">అవును, వారు నాతో సమాధానపడాలి.”<verse eid="ISA 27:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 27:6"/>రాబోయే రోజుల్లో యాకోబు వేరు పారుతుంది,</para>
  <para style="q2" vid="ISA 27:6">ఇశ్రాయేలు చిగురించి వికసించి</para>
  <para style="q2" vid="ISA 27:6">లోకమంతటిని ఫలంతో నింపుతుంది.<verse eid="ISA 27:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 27:7"/>ఇశ్రాయేలును కొట్టిన వారిని ఆయన కొట్టినట్లు,</para>
  <para style="q2" vid="ISA 27:7">యెహోవా ఇశ్రాయేలును కొట్టారా?</para>
  <para style="q1" vid="ISA 27:7">ఇశ్రాయేలును చంపినవారిని ఆయన చంపినట్లు</para>
  <para style="q2" vid="ISA 27:7">ఇశ్రాయేలును చంపరా?<verse eid="ISA 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 27:8"/>మీరు యుద్ధంతో వెళ్లగొట్టి దానిని శిక్షించారు</para>
  <para style="q2" vid="ISA 27:8">తూర్పు నుండి బలమైన గాలి వీచినట్లు</para>
  <para style="q2" vid="ISA 27:8">ఆయన తన బలమైన గాలితో దానిని తరిమికొట్టారు.<verse eid="ISA 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 27:9"/>ఈ విధంగా యాకోబు అపరాధం ప్రాయశ్చిత్తం చేయబడుతుంది,</para>
  <para style="q2" vid="ISA 27:9">ఇదంతా అతని పాప పరిహారానికి కలిగే సంపూర్ణ ఫలం ఇదే:</para>
  <para style="q1" vid="ISA 27:9">సున్నపురాయిని ముక్కలుగా నలగ్గొట్టినట్లు,</para>
  <para style="q2" vid="ISA 27:9">అతడు బలిపీఠపు రాళ్లన్నిటిని చేసినప్పుడు</para>
  <para style="q1" vid="ISA 27:9">అషేరా స్తంభాలు కాని ధూప బలిపీఠాలు కాని</para>
  <para style="q2" vid="ISA 27:9">మిగిలి ఉండవు.<verse eid="ISA 27:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 27:10"/>బలమైన పట్టణం ఒంటరిగా నిలిచిపోతుంది,</para>
  <para style="q2" vid="ISA 27:10">పాడుబడిన స్థలంగా మారి అరణ్యంలా విడిపెట్టబడుతుంది.</para>
  <para style="q1" vid="ISA 27:10">అక్కడ దూడలు మేస్తాయి</para>
  <para style="q2" vid="ISA 27:10">అక్కడే అవి పడుకుంటాయి;</para>
  <para style="q2" vid="ISA 27:10">అవి దాని చెట్ల కొమ్మలు తినివేస్తాయి.<verse eid="ISA 27:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 27:11"/>దాని కొమ్మలు ఎండి విరిగిపోతాయి</para>
  <para style="q2" vid="ISA 27:11">స్త్రీలు వచ్చి వాటితో మంట పెడతారు.</para>
  <para style="q1" vid="ISA 27:11">ఎందుకంటే, ఈ ప్రజలు వివేచన లేనివారు;</para>
  <para style="q2" vid="ISA 27:11">కాబట్టి వారిని రూపించినవాడు వారిపై జాలిపడరు.</para>
  <para style="q2" vid="ISA 27:11">వారి సృష్టికర్త వారికి దయ చూపించరు.<verse eid="ISA 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 27:12"/>ఆ రోజున యెహోవా పారుతున్న యూఫ్రటీసు నది నుండి ఈజిప్టు వాగువరకు నూర్చుతారు. ఓ ఇశ్రాయేలూ! నీవు ఒక్కొక్కరిగా సమకూర్చబడతావు. <verse eid="ISA 27:12"/><verse number="13" style="v" sid="ISA 27:13"/>ఆ రోజున ఓ గొప్ప బూరధ్వని వినబడుతుంది. అష్షూరులో నశిస్తున్నవారు ఈజిప్టులో చెరపట్టబడినవారు వచ్చి యెరూషలేములోని పరిశుద్ధ పర్వతం మీద యెహోవాను ఆరాధిస్తారు.<verse eid="ISA 27:13"/></para>
  <chapter eid="ISA 27"/>
  <chapter number="28" style="c" sid="ISA 28"/>
  <para style="s1">ఎఫ్రాయిం, యూదా నాయకులకు శ్రమ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 28:1"/>ఎఫ్రాయిం త్రాగుబోతుల గర్వకారణమైన పూల కిరీటానికి శ్రమ,</para>
  <para style="q2" vid="ISA 28:1">వాడిపోతున్న పువ్వు వంటి అతని మహిమగల సౌందర్యానికి శ్రమ,</para>
  <para style="q1" vid="ISA 28:1">ద్రాక్షరసం మత్తులో పడిపోయిన వారి</para>
  <para style="q2" vid="ISA 28:1">సంపన్న లోయ తలమీద ఉన్న కిరీటానికి శ్రమ.<verse eid="ISA 28:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 28:2"/>చూడండి, బలం, పరాక్రమం కలిగిన ఒకడు ప్రభువుకు ఉన్నాడు.</para>
  <para style="q2" vid="ISA 28:2">వడగండ్లు, తీవ్రమైన గాలులు</para>
  <para style="q1" vid="ISA 28:2">కుండపోత వర్షం, తీవ్రమైన వరద కొట్టివేసినట్లు</para>
  <para style="q2" vid="ISA 28:2">ఆయన తన బలంతో దానిని నేలమీద పడవేస్తారు.<verse eid="ISA 28:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 28:3"/>ఎఫ్రాయిం త్రాగుబోతుల గర్వకారణమైన పూల కిరీటం</para>
  <para style="q2" vid="ISA 28:3">కాళ్లతో త్రొక్కబడుతుంది.<verse eid="ISA 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 28:4"/>ఫలవంతమైన లోయ తలపై ఉన్న</para>
  <para style="q2" vid="ISA 28:4">వాడిపోయిన పువ్వు లాంటి అతని వైభవం</para>
  <para style="q1" vid="ISA 28:4">కోతకాలం రాకముందే పండిన అంజూర పండులా ఉంటుంది.</para>
  <para style="q2" vid="ISA 28:4">ప్రజలు వాటిని చూడగానే తమ చేతిలోనికి తీసుకుని</para>
  <para style="q2" vid="ISA 28:4">వెంటనే వాటిని మ్రింగివేస్తారు.<verse eid="ISA 28:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 28:5"/>ఆ రోజున సైన్యాల యెహోవా</para>
  <para style="q2" vid="ISA 28:5">మిగిలిన తన ప్రజలకు</para>
  <para style="q1" vid="ISA 28:5">తానే మహిమగల కిరీటంగా</para>
  <para style="q2" vid="ISA 28:5">సుందరమైన పూల కిరీటంగా ఉంటారు.<verse eid="ISA 28:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 28:6"/>ఆయన న్యాయస్థానంపై కూర్చునే వారికి</para>
  <para style="q2" vid="ISA 28:6">వివేచన ఆత్మగా</para>
  <para style="q1" vid="ISA 28:6">గుమ్మం దగ్గరే యుద్ధాన్ని త్రిప్పికొట్టేవారికి</para>
  <para style="q2" vid="ISA 28:6">బలానికి మూలంగా ఉంటారు.<verse eid="ISA 28:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 28:7"/>అయితే వీరు కూడ ద్రాక్షరసం త్రాగి తూలుతారు</para>
  <para style="q2" vid="ISA 28:7">తీర్పు చెప్పవలసి వచ్చినప్పుడు తడబడతారు</para>
  <para style="q1" vid="ISA 28:7">యాజకులు ప్రవక్తలు మద్యం మత్తులో తూలుతారు</para>
  <para style="q2" vid="ISA 28:7">ద్రాక్షరసం వలన అయోమయంగా ఉంటారు;</para>
  <para style="q1" vid="ISA 28:7">మద్యం మత్తులో తడబడతారు</para>
  <para style="q2" vid="ISA 28:7">దర్శనం వచ్చినప్పుడు తూలుతారు</para>
  <para style="q2" vid="ISA 28:7">తీర్పు చెప్పవలసిన సమయం వచ్చినప్పుడు తడబడతారు.<verse eid="ISA 28:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 28:8"/>వారి బల్లలన్నీ వాంతితో నిండి ఉన్నాయి</para>
  <para style="q2" vid="ISA 28:8">మురికి లేనిచోటు ఉండదు.<verse eid="ISA 28:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 28:9"/>“ఆయన ఎవరికి బోధించే ప్రయత్నం చేస్తున్నారు?</para>
  <para style="q2" vid="ISA 28:9">ఆయన తన సందేశాన్ని ఎవరికి వివరిస్తున్నారు?</para>
  <para style="q1" vid="ISA 28:9">తల్లి రొమ్ము విడిచిన వారికా,</para>
  <para style="q2" vid="ISA 28:9">స్తన్యమును విడిచిన వారికా?<verse eid="ISA 28:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 28:10"/>ఇది చేయండి, అది చేయండి</para>
  <para style="q2" vid="ISA 28:10">దీనికి ఈ నియమం, దానికి ఆ నియమం;</para>
  <para style="q2" vid="ISA 28:10">కొంత ఇక్కడ, కొంత అక్కడ” అని వారు అనుకుంటారు.<verse eid="ISA 28:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 28:11"/>అప్పుడు పరదేశీయుల పెదాలతో వింత భాషలో</para>
  <para style="q2" vid="ISA 28:11">దేవుడు ఈ ప్రజలతో మాట్లాడతారు.<verse eid="ISA 28:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 28:12"/>గతంలో ఆయన వారితో,</para>
  <para style="q2" vid="ISA 28:12">“ఇది విశ్రాంతి స్థలం, అలసిపోయినవారిని విశ్రాంతి తీసుకోనివ్వండి;</para>
  <para style="q1" vid="ISA 28:12">ఇది నెమ్మది దొరికే స్థలం”</para>
  <para style="q2" vid="ISA 28:12">అని చెప్పారు కాని వారు వినలేదు.<verse eid="ISA 28:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 28:13"/>కాబట్టి వారికి యెహోవా వాక్కు ఇలా అవుతుంది:</para>
  <para style="q2" vid="ISA 28:13">ఇది చేయాలి, అది చేయాలి</para>
  <para style="q2" vid="ISA 28:13">దీనికి ఆజ్ఞ, దానికి ఆజ్ఞ</para>
  <para style="q2" vid="ISA 28:13">కొంత ఇక్కడ కొంత అక్కడ</para>
  <para style="q1" vid="ISA 28:13">అప్పుడు వారు వెళ్తుండగా వెనుకకు పడతారు;</para>
  <para style="q2" vid="ISA 28:13">వారు గాయపరచబడతారు, ఉచ్చులో పడతారు, పట్టబడతారు.<verse eid="ISA 28:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 28:14"/>కాబట్టి యెరూషలేములో ఉన్న ఈ ప్రజలను పాలిస్తున్న</para>
  <para style="q2" vid="ISA 28:14">ఎగతాళి చేసేవారలారా, యెహోవా వాక్కు వినండి.<verse eid="ISA 28:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 28:15"/>“మేము చావుతో నిబంధన చేసుకున్నాం,</para>
  <para style="q2" vid="ISA 28:15">పాతాళంతో ఒప్పందం చేసుకున్నాము.</para>
  <para style="q1" vid="ISA 28:15">ప్రమాదం ప్రవాహంలా వేగంగా వచ్చినప్పుడు</para>
  <para style="q2" vid="ISA 28:15">అది మమ్మల్ని తాకదు,</para>
  <para style="q1" vid="ISA 28:15">ఎందుకంటే అబద్ధాన్ని మాకు అండగా చేసుకున్నాం,</para>
  <para style="q2" vid="ISA 28:15">అసత్యాన్ని<note caller="+" style="f"><char style="fr" closed="false">28:15 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">అబద్ధ దేవుళ్ళు</char></note> మా దాగు స్థలంగా చేసుకున్నాం”</para>
  <para style="m" vid="ISA 28:15">అని మీరు అతిశయిస్తున్నారు.<verse eid="ISA 28:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 28:16"/>కాబట్టి ప్రభువైన యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="ISA 28:16">“చూడండి, నేను సీయోనులో ఒక రాయిని,</para>
  <para style="q2" vid="ISA 28:16">పరీక్షించబడిన రాయిని వేశాను,</para>
  <para style="q2" vid="ISA 28:16">అది స్థిరమైన పునాదికి అమూల్యమైన మూలరాయి;</para>
  <para style="q1" vid="ISA 28:16">దానిపై నమ్మకముంచేవారు</para>
  <para style="q2" vid="ISA 28:16">ఎప్పుడూ భయాందోళనలకు గురికారు.<verse eid="ISA 28:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 28:17"/>నేను న్యాయాన్ని కొలమానంగా,</para>
  <para style="q2" vid="ISA 28:17">నీతిని మట్టపు గుండుగా చేస్తాను:</para>
  <para style="q1" vid="ISA 28:17">వడగండ్లు మీ అబద్ధం అనే ఆశ్రయాన్ని తుడిచివేస్తాయి.</para>
  <para style="q2" vid="ISA 28:17">మీ దాగుచోటు నీటికి కొట్టుకుపోతుంది.<verse eid="ISA 28:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 28:18"/>చావుతో మీరు చేసుకున్న నిబంధన కొట్టివేయబడుతుంది;</para>
  <para style="q2" vid="ISA 28:18">పాతాళంతో మీరు చేసుకున్న ఒప్పందం నిలవదు.</para>
  <para style="q1" vid="ISA 28:18">ప్రవాహంలా శాపం మీ మీదికి వచ్చినప్పుడు</para>
  <para style="q2" vid="ISA 28:18">మీరు దానిచే కొట్టబడతారు.<verse eid="ISA 28:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 28:19"/>అది వచ్చిన ప్రతిసారి మిమ్మల్ని ఈడ్చుకెళ్తుంది;</para>
  <para style="q2" vid="ISA 28:19">ప్రతి ఉదయం, ప్రతి పగలు, ప్రతి రాత్రి</para>
  <para style="q2" vid="ISA 28:19">అది ఈడ్చుకెళ్తుంది.”</para>
  <para style="b" vid="ISA 28:19"/>
  <para style="q1" vid="ISA 28:19">ఈ సందేశాన్ని గ్రహించినప్పుడు</para>
  <para style="q2" vid="ISA 28:19">చాలా భయం పుడుతుంది.<verse eid="ISA 28:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 28:20"/>పడుకోడానికి మంచం పొడవు సరిపోదు.</para>
  <para style="q2" vid="ISA 28:20">కప్పుకోడానికి దుప్పటి వెడల్పు చాలదు.<verse eid="ISA 28:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 28:21"/>నిజంగా తన పనిని తన ఆశ్చర్యకరమైన పనిని</para>
  <para style="q2" vid="ISA 28:21">అపూర్వమైన తన పని చేయడానికి</para>
  <para style="q1" vid="ISA 28:21">ఆయన పెరాజీము అనే కొండమీద లేచినట్లుగా యెహోవా లేస్తారు.</para>
  <para style="q2" vid="ISA 28:21">గిబియోను లోయలో ఆయన రెచ్చిపోయినట్లు రెచ్చిపోతారు.<verse eid="ISA 28:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 28:22"/>ఇప్పుడు మీ ఎగతాళి మానండి</para>
  <para style="q2" vid="ISA 28:22">లేదంటే మీ సంకెళ్ళు మరింత భారమవుతాయి;</para>
  <para style="q1" vid="ISA 28:22">భూమంతా ఖచ్చితంగా నాశనం చేయబడుతుందని</para>
  <para style="q2" vid="ISA 28:22">సైన్యాల అధిపతియైన యెహోవా నాకు చెప్పారు.<verse eid="ISA 28:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 28:23"/>జాగ్రత్తగా నా మాట వినండి;</para>
  <para style="q2" vid="ISA 28:23">నేను చెప్పేది శ్రద్ధగా వినండి.<verse eid="ISA 28:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 28:24"/>రైతు నాటడానికి ఎప్పుడూ తన పొలాన్ని దున్నుతూనే ఉంటాడా?</para>
  <para style="q2" vid="ISA 28:24">అతడు మట్టి పెల్లలు ఎప్పుడూ పగులగొడుతూనే ఉంటాడా?<verse eid="ISA 28:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 28:25"/>అతడు నేల చదును చేసిన తర్వాత</para>
  <para style="q2" vid="ISA 28:25">సోంపు, జీలకర్ర విత్తనాలు చల్లడా?</para>
  <para style="q1" vid="ISA 28:25">గోధుమలను వాటి స్థలంలో నాటడా?</para>
  <para style="q2" vid="ISA 28:25">యవలను వాటి చోట వేయడా?</para>
  <para style="q2" vid="ISA 28:25">పొలం అంచుల్లో ధాన్యం నాటడా?<verse eid="ISA 28:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 28:26"/>అతని దేవుడు అతనికి నేర్పిస్తారు</para>
  <para style="q2" vid="ISA 28:26">సరిగా ఎలా చేయాలో ఆయనే అతనికి బోధిస్తారు.<verse eid="ISA 28:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 28:27"/>సోంపును యంత్రంతో నూర్చరు,</para>
  <para style="q2" vid="ISA 28:27">జీలకర్ర మీద బండి చక్రం నడిపించరు;</para>
  <para style="q1" vid="ISA 28:27">కర్రతో సోంపును</para>
  <para style="q2" vid="ISA 28:27">దుడ్డుకర్రతో జీలకర్రను కొట్టి దులుపుతారు.<verse eid="ISA 28:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 28:28"/>రొట్టె చేయడానికి ధాన్యాన్ని దంచాలి;</para>
  <para style="q2" vid="ISA 28:28">కాబట్టి ఎప్పుడూ దానిని నూర్చుతూనే ఉండరు.</para>
  <para style="q1" vid="ISA 28:28">నూర్చే బండి చక్రాలు దానిపై నడిపిస్తారు,</para>
  <para style="q2" vid="ISA 28:28">కాని వాటిని పిండి చేయడానికి గుర్రాలను ఉపయోగించరు.<verse eid="ISA 28:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 28:29"/>ఇదంతా సైన్యాల యెహోవా నుండి నేర్చుకుంటారు,</para>
  <para style="q2" vid="ISA 28:29">ఆయన ఆలోచన అద్భుతం,</para>
  <para style="q2" vid="ISA 28:29">ఆయన జ్ఞానం గొప్పది.<verse eid="ISA 28:29"/></para>
  <chapter eid="ISA 28"/>
  <chapter number="29" style="c" sid="ISA 29"/>
  <para style="s1">దావీదు పట్టణానికి శ్రమ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 29:1"/>అరీయేలుకు శ్రమ</para>
  <para style="q2" vid="ISA 29:1">దావీదు శిబిరం వేసుకున్న అరీయేలు పట్టణానికి శ్రమ!</para>
  <para style="q1" vid="ISA 29:1">సంవత్సరం తర్వాత సంవత్సరం గడవనివ్వండి</para>
  <para style="q2" vid="ISA 29:1">పండుగలు క్రమంగా జరుగనివ్వండి.<verse eid="ISA 29:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 29:2"/>అయినా నేను అరీయేలును ముట్టడిస్తాను;</para>
  <para style="q2" vid="ISA 29:2">అది దుఃఖించి రోదిస్తుంది.</para>
  <para style="q2" vid="ISA 29:2">అది నాకు అగ్నిగుండంలా అవుతుంది.<verse eid="ISA 29:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 29:3"/>నీకు వ్యతిరేకంగా అన్నివైపులా నేను శిబిరం ఏర్పాటు చేస్తాను;</para>
  <para style="q2" vid="ISA 29:3">గోపురాలతో నిన్ను చుట్టుముట్టి</para>
  <para style="q2" vid="ISA 29:3">నీకు వ్యతిరేకంగా ముట్టడి దిబ్బలు ఏర్పాటు చేస్తాను.<verse eid="ISA 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 29:4"/>అప్పుడు నీవు క్రిందపడి నేలపై నుండి మాట్లాడతావు;</para>
  <para style="q2" vid="ISA 29:4">నీ మాట ధూళినుండి గొణుగుతున్నట్లు ఉంటుంది.</para>
  <para style="q1" vid="ISA 29:4">దయ్యం స్వరంలా నీ స్వరం నేల నుండి వస్తుంది;</para>
  <para style="q2" vid="ISA 29:4">ధూళినుండి నీ మాట గుసగుసలాడుతుంది.<verse eid="ISA 29:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 29:5"/>కాని నీ శత్రువులు సన్నటి ధూళిలా మారతారు;</para>
  <para style="q2" vid="ISA 29:5">క్రూరుల గుంపు ఎగిరిపోయే పొట్టులా ఉంటుంది.</para>
  <para style="q1" vid="ISA 29:5">హఠాత్తుగా ఒక క్షణంలోనే ఇది జరుగుతుంది.<verse eid="ISA 29:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="ISA 29:6"/>ఉరుముతో, భూకంపంతో, గొప్ప శబ్దంతో</para>
  <para style="q1" vid="ISA 29:6">సుడిగాలి తుఫానుతో దహించే అగ్నిజ్వాలలతో</para>
  <para style="q2" vid="ISA 29:6">సైన్యాల యెహోవా వస్తారు.<verse eid="ISA 29:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 29:7"/>అప్పుడు అరీయేలుతో యుద్ధం చేసే అన్ని దేశాల గుంపులు</para>
  <para style="q2" vid="ISA 29:7">దాని మీద దాడి చేసి దాని కోటను ముట్టడించేవారు</para>
  <para style="q1" vid="ISA 29:7">ఒక కలలా ఉంటారు</para>
  <para style="q2" vid="ISA 29:7">రాత్రివేళలో వచ్చే దర్శనంలా ఉంటారు.<verse eid="ISA 29:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 29:8"/>ఆకలితో ఉన్నవారు తింటున్నట్లు కల కని</para>
  <para style="q2" vid="ISA 29:8">కాని ఇంకా ఆకలితోనే మేల్కొన్నట్లు,</para>
  <para style="q1" vid="ISA 29:8">దాహంతో ఉన్నవారు త్రాగినట్లు కల కని</para>
  <para style="q2" vid="ISA 29:8">ఇంకా అలసిపోయి దాహంతోనే మేల్కొన్నట్లు ఉంటారు.</para>
  <para style="q1" vid="ISA 29:8">సీయోను కొండకు వ్యతిరేకంగా యుద్ధం చేసే</para>
  <para style="q2" vid="ISA 29:8">అన్ని దేశాల గుంపులకు ఇలా ఉంటుంది.<verse eid="ISA 29:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 29:9"/>నివ్వెరపోండి, ఆశ్చర్యపడండి.</para>
  <para style="q2" vid="ISA 29:9">మిమ్మల్ని మీరు చూపులేని గ్రుడ్డివారిగా చేసుకోండి;</para>
  <para style="q1" vid="ISA 29:9">ద్రాక్షరసం త్రాగకుండానే మత్తులో ఉండండి,</para>
  <para style="q2" vid="ISA 29:9">మద్యపానం చేయకుండానే తూలుతూ ఉండండి.<verse eid="ISA 29:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 29:10"/>యెహోవా మీకు గాఢనిద్ర కలిగించారు:</para>
  <para style="q2" vid="ISA 29:10">మీకు కళ్లుగా ఉన్న ప్రవక్తలను ఆయన మూసివేశారు;</para>
  <para style="q2" vid="ISA 29:10">మీ తలలుగా ఉన్న దీర్ఘదర్శులకు ఆయన ముసుగు వేశారు.<verse eid="ISA 29:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 29:11"/>మీకు ఈ దర్శనమంతా ముద్ర వేసిన గ్రంథంలోని మాటల్లా ఉంది. మీరు దానిని చదవగలిగిన వారికి ఇచ్చి, “దయచేసి దీనిని చదవండి” అని అంటే, వారు, “నేను చదవలేను; అది ముద్రించబడింది” అని జవాబిస్తారు. <verse eid="ISA 29:11"/><verse number="12" style="v" sid="ISA 29:12"/>చదవడం రాని వానికి గ్రంథపుచుట్ట ఇచ్చి, “దయచేసి దీనిని చదవండి” అని అంటే, వారు, “నాకు చదవడం రాదు” అని జవాబిస్తారు.<verse eid="ISA 29:12"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="13" style="v" sid="ISA 29:13"/>ప్రభువు ఇలా అంటున్నారు:</para>
  <para style="q1" vid="ISA 29:13">“ఈ ప్రజలు నోటి మాటతో నా దగ్గరకు వస్తున్నారు.</para>
  <para style="q2" vid="ISA 29:13">పెదవులతో నన్ను ఘనపరుస్తున్నారు,</para>
  <para style="q2" vid="ISA 29:13">కాని వారి హృదయాలు నా నుండి దూరంగా ఉన్నాయి.</para>
  <para style="q1" vid="ISA 29:13">వారికి బోధించబడిన మానవ నియమాల ప్రకారం మాత్రమే</para>
  <para style="q2" vid="ISA 29:13">నా పట్ల భయభక్తులు చూపుతున్నారు.<note caller="+" style="f"><char style="fr" closed="false">29:13 </char><char style="ft" closed="false">మూ.భా.లో </char><char style="fqa" closed="false">వారు వ్యర్థంగా నన్ను ఆరాధిస్తున్నారు; వారి బోధలు మానవ నియమాలు మాత్రమే</char></note><verse eid="ISA 29:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 29:14"/>కాబట్టి నేను మరొకసారి ఈ ప్రజలను</para>
  <para style="q2" vid="ISA 29:14">ఆశ్చర్యాలతో ఆశ్చర్యపరుస్తాను;</para>
  <para style="q1" vid="ISA 29:14">జ్ఞానుల జ్ఞానం నశిస్తుంది</para>
  <para style="q2" vid="ISA 29:14">వివేకుల వివేకం మాయమైపోతుంది.”<verse eid="ISA 29:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 29:15"/>తమ ఆలోచనలు యెహోవాకు కనబడకుండా</para>
  <para style="q2" vid="ISA 29:15">దాచడానికి గొప్ప లోతుల్లోకి వెళ్లే వారికి శ్రమ.</para>
  <para style="q1" vid="ISA 29:15">“మమ్మల్ని ఎవరు చూస్తారు? ఎవరు తెలుసుకుంటారు?” అని అనుకుని,</para>
  <para style="q2" vid="ISA 29:15">చీకటిలో తమ పనులు చేసేవారికి శ్రమ.<verse eid="ISA 29:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 29:16"/>మీరు విషయాలను తలక్రిందులుగా చూస్తారు</para>
  <para style="q2" vid="ISA 29:16">కుమ్మరిని మట్టితో సమానంగా చూస్తారు!</para>
  <para style="q1" vid="ISA 29:16">చేయబడిన వస్తువు దానిని చేసినవానితో,</para>
  <para style="q2" vid="ISA 29:16">“నీవు నన్ను చేయలేదు” అని అనవచ్చా?</para>
  <para style="q1" vid="ISA 29:16">కుండ కుమ్మరితో,</para>
  <para style="q2" vid="ISA 29:16">“నీకు ఏమి తెలియదు” అని అనవచ్చా?<verse eid="ISA 29:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 29:17"/>ఇంకా కొంతకాలం తర్వాత లెబానోను సారవంతమైన పొలంగా,</para>
  <para style="q2" vid="ISA 29:17">సారవంతమైన పొలం అడవిగా మారదా?<verse eid="ISA 29:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 29:18"/>ఆ రోజున చెవిటివారు గ్రంథంలోని మాటలు వింటారు,</para>
  <para style="q2" vid="ISA 29:18">చీకటిలో చిమ్మ చీకటిలో</para>
  <para style="q2" vid="ISA 29:18">గ్రుడ్డివారి కళ్లు చూస్తాయి.<verse eid="ISA 29:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 29:19"/>మరోసారి దీనులు యెహోవాలో సంతోషిస్తారు;</para>
  <para style="q2" vid="ISA 29:19">మనుష్యుల్లో పేదవారు ఇశ్రాయేలు పరిశుద్ధ దేవునిలో ఆనందిస్తారు.<verse eid="ISA 29:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 29:20"/>దయలేని మనుష్యులు అదృశ్యమవుతారు,</para>
  <para style="q2" vid="ISA 29:20">హేళన చేసేవారు మాయమవుతారు</para>
  <para style="q2" vid="ISA 29:20">చెడు చేయడానికి ఇష్టపడేవారందరు,<verse eid="ISA 29:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 29:21"/>ఒక వ్యక్తి మీద తప్పుడు సాక్ష్యమిచ్చేవారు,</para>
  <para style="q2" vid="ISA 29:21">న్యాయస్థానంలో మధ్యవర్తిత్వం చేసేవారిని వలలో వేసుకునేవారు</para>
  <para style="q2" vid="ISA 29:21">అబద్ధసాక్ష్యంతో అమాయకులకు న్యాయం జరుగకుండా చేసేవారు తొలగించబడతారు.<verse eid="ISA 29:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 29:22"/>కాబట్టి అబ్రాహామును విడిపించిన యెహోవా యాకోబు వారసుల గురించి చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="ISA 29:22">“ఇకపై యాకోబు సిగ్గుపడడు;</para>
  <para style="q2" vid="ISA 29:22">ఇకపై వారి ముఖాలు చిన్నబోవు.<verse eid="ISA 29:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 29:23"/>వారు వారి పిల్లల మధ్య</para>
  <para style="q2" vid="ISA 29:23">నేను చేసే కార్యాలను చూసినప్పుడు,</para>
  <para style="q1" vid="ISA 29:23">వారు నా నామాన్ని పరిశుద్ధపరుస్తారు:</para>
  <para style="q2" vid="ISA 29:23">యాకోబు పరిశుద్ధ దేవుని ఘనపరుస్తారు,</para>
  <para style="q2" vid="ISA 29:23">ఇశ్రాయేలు దేవునికి భయపడతారు.<verse eid="ISA 29:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 29:24"/>ఆత్మలో దారి తప్పినవారు వివేకులవుతారు;</para>
  <para style="q2" vid="ISA 29:24">సణిగేవారు ఉపదేశాన్ని అంగీకరిస్తారు.”<verse eid="ISA 29:24"/></para>
  <chapter eid="ISA 29"/>
  <chapter number="30" style="c" sid="ISA 30"/>
  <para style="s1">మూర్ఖపు పట్టుగల దేశానికి శ్రమ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 30:1"/>యెహోవా ఇలా అంటున్నారు,</para>
  <para style="q2" vid="ISA 30:1">“మూర్ఖులైన పిల్లలకు శ్రమ,</para>
  <para style="q1" vid="ISA 30:1">వారు నావి కాని ఆలోచనలు చేస్తారు,</para>
  <para style="q2" vid="ISA 30:1">నా ఆత్మ నియమించని పొత్తు చేసుకుంటూ</para>
  <para style="q2" vid="ISA 30:1">పాపానికి పాపం జత చేస్తున్నారు;<verse eid="ISA 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 30:2"/>వారు నన్ను సంప్రదించకుండా</para>
  <para style="q2" vid="ISA 30:2">ఈజిప్టుకు వెళ్తారు;</para>
  <para style="q1" vid="ISA 30:2">వారు సహాయం కోసం ఫరో కాపుదల కోసం చూస్తారు,</para>
  <para style="q2" vid="ISA 30:2">ఆశ్రయం కోసం ఈజిప్టు నీడ కోసం చూస్తారు.<verse eid="ISA 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 30:3"/>కాని ఫరో ఇచ్చే రక్షణ మీకు సిగ్గు కలిగిస్తుంది,</para>
  <para style="q2" vid="ISA 30:3">ఈజిప్టు నీడ మీకు అవమానంగా ఉంటుంది.<verse eid="ISA 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 30:4"/>వారి అధిపతులు సోయనులో ఉన్నా,</para>
  <para style="q2" vid="ISA 30:4">వారి రాయబారులు హనేసు చేరుకున్నా<verse eid="ISA 30:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 30:5"/>వారికి సహాయకరంగా ఉపయోగకరంగా</para>
  <para style="q2" vid="ISA 30:5">ఉండకుండా అవమానాన్ని సిగ్గును కలిగించే</para>
  <para style="q1" vid="ISA 30:5">ప్రజల కారణంగా</para>
  <para style="q2" vid="ISA 30:5">వారందరు సిగ్గుపరచబడతారు.”<verse eid="ISA 30:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 30:6"/>దక్షిణ దేశంలోని జంతువుల గురించి ప్రవచనం:</para>
  <para style="q1" vid="ISA 30:6">సింహాలు ఆడ సింహాలు,</para>
  <para style="q2" vid="ISA 30:6">నాగుపాములు ఎగిరే సర్పాలు,</para>
  <para style="q2" vid="ISA 30:6">కష్టాలు బాధలున్న దేశం గుండా రాయబారులు,</para>
  <para style="q1" vid="ISA 30:6">గాడిదల వీపుల మీద తమ ఆస్తిని</para>
  <para style="q2" vid="ISA 30:6">ఒంటెల మూపుల మీద తమ సంపదలను ఎక్కించుకొని</para>
  <para style="q1" vid="ISA 30:6">తమకు లాభం కలిగించని ఆ దేశానికి,<verse eid="ISA 30:6"/></para>
  <para style="q2">
    <verse number="7" style="v" sid="ISA 30:7"/>సహాయం వలన ప్రయోజనం లేని ఆ ఈజిప్టుకు వెళ్తారు.</para>
  <para style="q1" vid="ISA 30:7">కాబట్టి నేను దానిని</para>
  <para style="q2" vid="ISA 30:7">ఏమి చేయని రాహాబు<note caller="+" style="f"><char style="fr" closed="false">30:7 </char><char style="ft" closed="false">పురాతన సాహిత్యంలో గందరగోళాన్ని సూచించే పౌరాణిక </char><char style="fqa" closed="false">సముద్ర రాక్షసుడి </char><char style="ft" closed="false">పేరు.</char></note> అని పిలుస్తాను.<verse eid="ISA 30:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 30:8"/>ఇప్పుడు వెళ్లు, రాబోయే రోజుల్లో శాశ్వతమైన</para>
  <para style="q2" vid="ISA 30:8">సాక్షంగా ఉండేలా</para>
  <para style="q1" vid="ISA 30:8">వారి కోసం పలక మీద దీనిని వ్రాయి</para>
  <para style="q2" vid="ISA 30:8">వీటిని గ్రంథస్తం చేయి.<verse eid="ISA 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 30:9"/>ఎందుకంటే వీరు తిరుగుబాటు చేసే ప్రజలు, మోసపూరిత పిల్లలు,</para>
  <para style="q2" vid="ISA 30:9">యెహోవా హెచ్చరికకు లోబడడానికి ఇష్టపడని పిల్లలు.<verse eid="ISA 30:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 30:10"/>వారు దీర్ఘదర్శులతో,</para>
  <para style="q2" vid="ISA 30:10">“ఇకపై దర్శనాలు చూడవద్దు!” అంటారు.</para>
  <para style="q1" vid="ISA 30:10">అలాగే ప్రవక్తలతో,</para>
  <para style="q2" vid="ISA 30:10">“సరియైనదాని గురించి ఇకపై దర్శనాలు ఇవ్వవద్దు! అంటారు.</para>
  <para style="q1" vid="ISA 30:10">మాకు అనుకూలమైన విషయాలు</para>
  <para style="q2" vid="ISA 30:10">భ్రాంతి కలిగించే ప్రవచనాలు తెలియజేయండి.<verse eid="ISA 30:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 30:11"/>మా దారిని వదలండి,</para>
  <para style="q2" vid="ISA 30:11">ఈ మార్గం నుండి తొలగిపోండి.</para>
  <para style="q1" vid="ISA 30:11">ఇశ్రాయేలు పరిశుద్ధ దేవుని సంగతి చెప్తూ</para>
  <para style="q2" vid="ISA 30:11">మమ్మల్ని ఎదుర్కోవడం ఆపండి!”<verse eid="ISA 30:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 30:12"/>కాబట్టి ఇశ్రాయేలు పరిశుద్ధ దేవుడు చెప్పిన మాట ఇదే:</para>
  <para style="q1" vid="ISA 30:12">“మీరు ఈ వర్తమానాన్ని తిరస్కరించారు,</para>
  <para style="q2" vid="ISA 30:12">బాధించడాన్ని నమ్ముకుని,</para>
  <para style="q2" vid="ISA 30:12">మోసాన్ని ఆధారం చేసుకున్నారు కాబట్టి,<verse eid="ISA 30:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 30:13"/>ఈ పాపం మీకు బీటలు తీసి</para>
  <para style="q2" vid="ISA 30:13">ఉబ్బిపోయిన ఎత్తైన గోడలా ఉండబోతుంది,</para>
  <para style="q2" vid="ISA 30:13">అది ఏ క్షణమైనా కూలిపోవచ్చు.<verse eid="ISA 30:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 30:14"/>అది మట్టికుండలా పగిలిపోతుంది,</para>
  <para style="q2" vid="ISA 30:14">కరుణ లేకుండా పగులగొట్టబడుతుంది,</para>
  <para style="q1" vid="ISA 30:14">పొయ్యిలో నుండి నిప్పు తీయడానికి గాని</para>
  <para style="q2" vid="ISA 30:14">కుండలో నుండి నీళ్లు తీయడానికి గాని</para>
  <para style="q2" vid="ISA 30:14">దానిలో ఒక్క పెంకు కూడా దొరకదు.”<verse eid="ISA 30:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ISA 30:15"/>ఇశ్రాయేలీయుల పరిశుద్ధుడు ప్రభువైన యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="ISA 30:15">“పశ్చాత్తాపం, విశ్రాంతిలో మీకు రక్షణ ఉన్నది,</para>
  <para style="q2" vid="ISA 30:15">ప్రశాంతత, నమ్మకంలో మీకు బలం లభిస్తుంది</para>
  <para style="q2" vid="ISA 30:15">కానీ మీకు ఇవేవి లభించవు.<verse eid="ISA 30:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 30:16"/>మీరు, ‘లేదు, మేము గుర్రాల మీద పారిపోతాం’ అన్నారు.</para>
  <para style="q2" vid="ISA 30:16">కాబట్టి మీరు పారిపోతారు!</para>
  <para style="q1" vid="ISA 30:16">మీరు, ‘మేము వేగంగా పరుగెత్తే గుర్రాల మీద స్వారీ చేస్తాం’ అన్నారు.</para>
  <para style="q2" vid="ISA 30:16">కాబట్టి మిమ్మల్ని వెంటాడేవారు వేగంగా తరమబడతారు!<verse eid="ISA 30:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 30:17"/>పర్వతంపై ఉన్న ఒక జెండా కర్రలా</para>
  <para style="q2" vid="ISA 30:17">కొండమీద ఉన్న జెండాలా</para>
  <para style="q1" vid="ISA 30:17">మీరు మిగిలేవరకు</para>
  <para style="q2" vid="ISA 30:17">ఒకరు గద్దించగా</para>
  <para style="q1" vid="ISA 30:17">మీలో వెయ్యిమంది పారిపోతారు;</para>
  <para style="q2" vid="ISA 30:17">అయిదుగురు గద్దించగా</para>
  <para style="q2" vid="ISA 30:17">మీరందరు పారిపోతారు.”<verse eid="ISA 30:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 30:18"/>అయినా, యెహోవా మీమీద దయ చూపించాలని కోరుతున్నారు;</para>
  <para style="q2" vid="ISA 30:18">కాబట్టి మీ పట్ల దయ చూపించడానికి ఆయన సిద్ధంగా ఉన్నారు.</para>
  <para style="q1" vid="ISA 30:18">యెహోవా న్యాయం తీర్చే దేవుడు</para>
  <para style="q2" vid="ISA 30:18">ఆయన కోసం ఎదురు చూసే వారందరు ధన్యులు!<verse eid="ISA 30:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 30:19"/>యెరూషలేములో నివసించే సీయోను ప్రజలారా! ఇకపై మీరు ఏడవరు. సహాయం కోసం మీరు చేసే మొరను విని ఆయన దయ చూపిస్తారు. ఆయన విన్న వెంటనే మీకు జవాబు ఇస్తారు. <verse eid="ISA 30:19"/><verse number="20" style="v" sid="ISA 30:20"/>ప్రభువు మీకు శత్రువులనే రొట్టెను బాధలనే నీటిని ఇచ్చినప్పటికీ, మీ బోధకులు దాగి ఉండరు; మీ సొంత కళ్లతో వారిని చూస్తారు. <verse eid="ISA 30:20"/><verse number="21" style="v" sid="ISA 30:21"/>మీరు కుడి వైపుకు గాని ఎడమ వైపుకు గాని తిరిగినా, “ఇదే సరియైన దారి; దీనిలో నడవండి” అని మీ చెవుల వెనుక నుండి ఒక శబ్దం వింటారు. <verse eid="ISA 30:21"/><verse number="22" style="v" sid="ISA 30:22"/>అప్పుడు వెండితో పొదిగిన మీ విగ్రహాలను, బంగారంతో పొదిగిన మీ ప్రతిమలను మీరు అపవిత్రం చేస్తారు; రుతు గుడ్డను పడేసినట్లు వాటిని పడేసి, “ఇక్కడినుండి పొండి” అని వాటితో అంటారు.<verse eid="ISA 30:22"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="23" style="v" sid="ISA 30:23"/>మీరు భూమిలో నాటే విత్తనాలకు కావలసిన వాన ఆయన కురిపిస్తారు. ఆ భూమి నుండి వచ్చే ఆహారం గొప్పగా, సమృద్ధిగా ఉంటుంది. ఆ రోజున మీ పశువులు విశాలమైన మైదానాల్లో మేస్తాయి. <verse eid="ISA 30:23"/><verse number="24" style="v" sid="ISA 30:24"/>భూమిని దున్నే ఎడ్లు గాడిదలు చేటతో జల్లెడతో చెరిగిన మేత, కుడితి తింటాయి. <verse eid="ISA 30:24"/><verse number="25" style="v" sid="ISA 30:25"/>గోపురాలు కూలిపోయే గొప్ప వధ జరిగే రోజున, ఎత్తైన ప్రతి పర్వతం మీద, ఎత్తైన ప్రతి కొండమీద నీటి వాగులు ప్రవహిస్తాయి. <verse eid="ISA 30:25"/><verse number="26" style="v" sid="ISA 30:26"/>యెహోవా తన ప్రజల గాయాలను కట్టి, వారి దెబ్బలను బాగుచేసిన రోజున, చంద్రుడు సూర్యునిలా ప్రకాశిస్తాడు. సూర్యుని వెలుగు ఏడు రెట్లు, అంటే ఏడు రోజుల పూర్తి వెలుగులా ఉంటుంది.<verse eid="ISA 30:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 30:27"/>చూడండి, కోపంతో మండుతూ దట్టమైన పొగతో</para>
  <para style="q2" vid="ISA 30:27">యెహోవా నామం దూరం నుండి వస్తుంది;</para>
  <para style="q1" vid="ISA 30:27">ఆయన పెదవులు ఉగ్రతతో నిండి ఉన్నాయి.</para>
  <para style="q2" vid="ISA 30:27">ఆయన నాలుక దహించే అగ్నిలా ఉంది.<verse eid="ISA 30:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 30:28"/>ఆయన ఊపిరి మెడ లోతు వరకు</para>
  <para style="q2" vid="ISA 30:28">ప్రవహించే ధారలా ఉంది.</para>
  <para style="q1" vid="ISA 30:28">ఆయన నాశనమనే జల్లెడలో దేశాలను గాలిస్తారు;</para>
  <para style="q2" vid="ISA 30:28">దారి తప్పించే కళ్లెమును</para>
  <para style="q2" vid="ISA 30:28">ప్రజల దవడలలో ఆయన అమర్చుతారు.<verse eid="ISA 30:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 30:29"/>రాత్రివేళ పరిశుద్ధ పండుగను జరుపుకుంటున్నట్లుగా</para>
  <para style="q2" vid="ISA 30:29">మీరు పాడతారు</para>
  <para style="q1" vid="ISA 30:29">ఇశ్రాయేలుకు ఆశ్రయ కోటయైన</para>
  <para style="q2" vid="ISA 30:29">యెహోవా పర్వతానికి</para>
  <para style="q1" vid="ISA 30:29">పిల్లనగ్రోవి వాయిస్తూ వెళ్లే వారిలా</para>
  <para style="q2" vid="ISA 30:29">మీ హృదయాలు సంతోషిస్తాయి.<verse eid="ISA 30:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 30:30"/>యెహోవా తన ప్రభావం గల స్వరాన్ని ప్రజలకు వినిపిస్తారు,</para>
  <para style="q2" vid="ISA 30:30">భయంకరమైన కోపంతో దహించే అగ్నితో</para>
  <para style="q1" vid="ISA 30:30">మేఘ విస్పోటంతో, ఉరుముల తుఫానుతో, వడగండ్లతో</para>
  <para style="q2" vid="ISA 30:30">తన చేయి క్రిందికి రావడాన్ని ప్రజలు చూసేలా చేస్తారు.<verse eid="ISA 30:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 30:31"/>యెహోవా స్వరం అష్షూరును పడగొడుతుంది;</para>
  <para style="q2" vid="ISA 30:31">తన దండంతో ఆయన వారిని మొత్తుతారు.<verse eid="ISA 30:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 30:32"/>యెహోవా తన శిక్షించే దండంతో</para>
  <para style="q2" vid="ISA 30:32">అష్షూరు మీద వేసే ప్రతి దెబ్బ</para>
  <para style="q1" vid="ISA 30:32">తంబుర సితారాల సంగీతంతో కలిసి ఉంటుంది.</para>
  <para style="q2" vid="ISA 30:32">ఆయన తన చేయి ఆడించి యుద్ధం చేస్తారు.<verse eid="ISA 30:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="ISA 30:33"/>చాలా కాలం క్రితమే మండుతున్న స్థలం<note caller="+" style="f"><char style="fr" closed="false">30:33 </char><char style="ft" closed="false">అంటే, </char><char style="fqa" closed="false">తోఫెతు</char></note> సిద్ధపరచబడింది;</para>
  <para style="q2" vid="ISA 30:33">అది రాజు కోసం సిద్ధపరచబడింది.</para>
  <para style="q1" vid="ISA 30:33">విస్తారమైన అగ్ని, చెక్కతో</para>
  <para style="q2" vid="ISA 30:33">దాని అగ్ని గుంట లోతుగా విశాలంగా చేయబడింది;</para>
  <para style="q1" vid="ISA 30:33">యెహోవా ఊపిరి</para>
  <para style="q2" vid="ISA 30:33">మండుతున్న గంధక ప్రవాహంలా</para>
  <para style="q2" vid="ISA 30:33">దానిని రగిలిస్తుంది.<verse eid="ISA 30:33"/></para>
  <chapter eid="ISA 30"/>
  <chapter number="31" style="c" sid="ISA 31"/>
  <para style="s1">ఈజిప్టుపై ఆధారపడేవారికి శ్రమ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 31:1"/>ఇశ్రాయేలు పరిశుద్ధ దేవుని లెక్కచేయకుండా</para>
  <para style="q2" vid="ISA 31:1">యెహోవా నుండి సహాయం కోసం చూడకుండ</para>
  <para style="q1" vid="ISA 31:1">సహయం కోసం ఈజిప్టుకు వెళ్లే వారికి</para>
  <para style="q2" vid="ISA 31:1">గుర్రాలపై ఆధారపడేవారికి,</para>
  <para style="q1" vid="ISA 31:1">తమ రథాల సంఖ్యపై</para>
  <para style="q2" vid="ISA 31:1">గుర్రపురౌతుల గొప్ప బలం మీద నమ్మకం ఉంచే వారికి శ్రమ.<verse eid="ISA 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 31:2"/>అయినా ఆయన చాలా తెలివైనవారు, వినాశనం తీసుకురాగలరు;</para>
  <para style="q2" vid="ISA 31:2">ఆయన తన మాట వెనుకకు తీసుకోరు.</para>
  <para style="q1" vid="ISA 31:2">ఆయన దుష్టప్రజల మీద,</para>
  <para style="q2" vid="ISA 31:2">కీడు చేసేవారికి సహయపడేవారి మీద లేస్తారు.<verse eid="ISA 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 31:3"/>ఈజిప్టువారు కేవలం మనుష్యులే, దేవుడు కాదు;</para>
  <para style="q2" vid="ISA 31:3">వారి గుర్రాలు మాంసమే కాని ఆత్మ కాదు.</para>
  <para style="q1" vid="ISA 31:3">యెహోవా తన చేయి చాపగా</para>
  <para style="q2" vid="ISA 31:3">సహయం చేసేవారు తడబడతారు,</para>
  <para style="q2" vid="ISA 31:3">సహయం పొందేవారు పడతారు;</para>
  <para style="q2" vid="ISA 31:3">వారందరు కలిసి నాశనమవుతారు.<verse eid="ISA 31:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 31:4"/>యెహోవా నాతో చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="ISA 31:4">తప్పించడానికి గొర్రెల కాపరులందరు కలిసివచ్చి</para>
  <para style="q2" vid="ISA 31:4">ఎన్ని శబ్దాలు చేసినా భయపడకుండా</para>
  <para style="q1" vid="ISA 31:4">వారి కేకలకు కలవరపడకుండా</para>
  <para style="q2" vid="ISA 31:4">సింహం ఒక కొదమసింహం</para>
  <para style="q1" vid="ISA 31:4">తనకు దొరికిన దాని మీద గర్జించినట్లు</para>
  <para style="q2" vid="ISA 31:4">సైన్యాల యెహోవా</para>
  <para style="q1" vid="ISA 31:4">యుద్ధం చేయడానికి సీయోను పర్వతం మీదికి</para>
  <para style="q2" vid="ISA 31:4">దాని కొండ మీదికి దిగి వస్తారు.<verse eid="ISA 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 31:5"/>అటూ ఇటూ ఎగిరే పక్షుల్లా</para>
  <para style="q2" vid="ISA 31:5">సైన్యాల యెహోవా యెరూషలేమును కాపాడతారు;</para>
  <para style="q1" vid="ISA 31:5">ఆయన దానిని కాపాడుతూ విడిపిస్తారు.</para>
  <para style="q2" vid="ISA 31:5">దాని మీద దాటి వెళ్తూ దానిని రక్షిస్తారు.<verse eid="ISA 31:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="ISA 31:6"/>ఇశ్రాయేలీయులారా, మీరు ఎవరిపై తిరుగుబాటు చేశారో ఆయన వైపు తిరగండి. <verse eid="ISA 31:6"/><verse number="7" style="v" sid="ISA 31:7"/>మీ పాపిష్ఠి చేతులు తయారుచేసిన వెండి బంగారు విగ్రహాలను ఆ రోజున మీలో ప్రతి ఒక్కరు పారవేస్తారు.<verse eid="ISA 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 31:8"/>“మనుష్యులు చేయని ఖడ్గానికి అష్షూరు పడిపోతుంది.</para>
  <para style="q2" vid="ISA 31:8">మానవులు చేయని ఖడ్గం వారిని మ్రింగివేస్తుంది.</para>
  <para style="q1" vid="ISA 31:8">వారు ఖడ్గం ఎదుట నుండి పారిపోతారు</para>
  <para style="q2" vid="ISA 31:8">వారి యవ్వనస్థులు వెట్టిచాకిరి చేస్తారు.<verse eid="ISA 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 31:9"/>వారి ఆశ్రయ కోట భయంతో పడిపోతుంది;</para>
  <para style="q2" vid="ISA 31:9">వారి అధిపతులు యుద్ధ జెండా చూసి భయపడిపోతారు”</para>
  <para style="q1" vid="ISA 31:9">అని యెహోవా ప్రకటించారు.</para>
  <para style="q2" vid="ISA 31:9">సీయోనులో ఆయన అగ్ని</para>
  <para style="q2" vid="ISA 31:9">యెరూషలేములో ఆయన కొలిమి ఉన్నాయి.<verse eid="ISA 31:9"/></para>
  <chapter eid="ISA 31"/>
  <chapter number="32" style="c" sid="ISA 32"/>
  <para style="s1">నీతి రాజ్యం</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 32:1"/>చూడండి, ఒక రాజు నీతిగా రాజ్యపాలన చేస్తాడు</para>
  <para style="q2" vid="ISA 32:1">అధికారులు న్యాయంగా పాలిస్తారు.<verse eid="ISA 32:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 32:2"/>వారిలో ప్రతి ఒక్కరు గాలి వీచినప్పుడు దాక్కునే స్థలంలా</para>
  <para style="q2" vid="ISA 32:2">తుఫానులో ఆశ్రయంగా</para>
  <para style="q1" vid="ISA 32:2">ఎడారిలో నీటి ప్రవాహాల్లా</para>
  <para style="q2" vid="ISA 32:2">ఎండిన భూమిలో ఒక గొప్ప కొండ నీడలా ఉంటారు.<verse eid="ISA 32:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 32:3"/>అప్పుడు చూసేవారి కళ్లు ఎప్పుడూ మూసుకుపోవు,</para>
  <para style="q2" vid="ISA 32:3">వినేవారి చెవులు వింటాయి.<verse eid="ISA 32:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 32:4"/>భయంతో ఉండే హృదయం తెలుసుకొని, గ్రహిస్తుంది,</para>
  <para style="q2" vid="ISA 32:4">నత్తిగల నాలుక చక్కగా, స్పష్టంగా మాట్లాడుతుంది.<verse eid="ISA 32:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 32:5"/>ఇకపై మూర్ఖులు ఘనులని పిలువబడరు.</para>
  <para style="q2" vid="ISA 32:5">దుష్టులు ఉన్నతంగా గౌరవించబడరు.<verse eid="ISA 32:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 32:6"/>మూర్ఖులు మూర్ఖంగా మాట్లాడతారు,</para>
  <para style="q2" vid="ISA 32:6">వారి హృదయాలు చెడు ఆలోచిస్తాయి;</para>
  <para style="q1" vid="ISA 32:6">వారు భక్తిహీనతను పాటిస్తూ</para>
  <para style="q2" vid="ISA 32:6">యెహోవా గురించి తప్పుడు వార్త ప్రకటిస్తారు;</para>
  <para style="q1" vid="ISA 32:6">ఆకలితో ఉన్నవారికి ఏమి లేకుండా చేస్తారు</para>
  <para style="q2" vid="ISA 32:6">దప్పికతో ఉన్నవారికి నీళ్లు లేకుండా చేస్తారు.<verse eid="ISA 32:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 32:7"/>దుష్టులు చెడ్డ పద్ధతులను ఉపయోగిస్తారు,</para>
  <para style="q2" vid="ISA 32:7">నిరుపేదలు న్యాయమైన అభ్యర్థన చేసినా,</para>
  <para style="q1" vid="ISA 32:7">అబద్ధాలతో పేదవారిని నాశనం చేయడానికి</para>
  <para style="q2" vid="ISA 32:7">వారు చెడ్డ ఆలోచనలు చేస్తారు.<verse eid="ISA 32:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 32:8"/>అయితే గొప్పవారు గొప్ప ఆలోచనలు చేస్తారు,</para>
  <para style="q2" vid="ISA 32:8">వారు చేసే గొప్ప పనులను బట్టి నిలబడతారు.<verse eid="ISA 32:8"/></para>
  <para style="s1">యెరూషలేము స్త్రీలు</para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 32:9"/>ఆత్మసంతృప్తితో ఉన్న స్త్రీలారా,</para>
  <para style="q2" vid="ISA 32:9">లేచి నా మాట వినండి;</para>
  <para style="q1" vid="ISA 32:9">భద్రంగా ఉన్నారనే భావనలో ఉన్న కుమార్తెలారా,</para>
  <para style="q2" vid="ISA 32:9">నేను చెప్పే మాట వినండి!<verse eid="ISA 32:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 32:10"/>ఇక ఒక సంవత్సరంలో,</para>
  <para style="q2" vid="ISA 32:10">భద్రంగా ఉన్న మీరు భయంతో వణుకుతారు;</para>
  <para style="q1" vid="ISA 32:10">ద్రాక్ష పంట పడిపోతుంది.</para>
  <para style="q2" vid="ISA 32:10">పండ్లు పంటకు రావు.<verse eid="ISA 32:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 32:11"/>ఆత్మసంతృప్తితో ఉన్న స్త్రీలారా వణకండి;</para>
  <para style="q2" vid="ISA 32:11">భద్రంగా ఉన్నారనే భావనలో ఉన్న కుమార్తెలారా, వణకండి</para>
  <para style="q1" vid="ISA 32:11">మీ మంచి బట్టలు తీసివేసి</para>
  <para style="q2" vid="ISA 32:11">మీ నడుముకు గోనెపట్ట కట్టుకోండి.<verse eid="ISA 32:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 32:12"/>ఆహ్లాదకరమైన పొలాల గురించి ఫలించే ద్రాక్షతీగెల గురించి</para>
  <para style="q2" vid="ISA 32:12">మీ రొమ్ము కొట్టుకోండి.<verse eid="ISA 32:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 32:13"/>నా ప్రజల భూమిలో</para>
  <para style="q2" vid="ISA 32:13">గచ్చపొదలు, ముళ్ళచెట్లు పెరుగుతాయి.</para>
  <para style="q1" vid="ISA 32:13">ఆనందోత్సాహాలతో ఉన్న ఇళ్ళన్నిటి కోసం</para>
  <para style="q2" vid="ISA 32:13">ఉల్లాసంతో ఉన్న ఈ పట్టణం కోసం దుఃఖించండి.<verse eid="ISA 32:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 32:14"/>కోట విడిచిపెట్టబడుతుంది</para>
  <para style="q2" vid="ISA 32:14">కోలాహలంగా ఉన్న పట్టణం నిర్మానుష్యంగా మారుతుంది;</para>
  <para style="q1" vid="ISA 32:14">కోట, కావలికోట శాశ్వతంగా బంజరు భూమిలా మారుతాయి,</para>
  <para style="q2" vid="ISA 32:14">అవి అడవి గాడిదలకు ఇష్టమైన చోటుగా,</para>
  <para style="q2" vid="ISA 32:14">మందలకు పచ్చికబయళ్లుగా ఉంటాయి,<verse eid="ISA 32:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 32:15"/>పైనుండి మామీద ఆత్మ కుమ్మరించబడేవరకు ఇలా ఉంటాయి.</para>
  <para style="q2" vid="ISA 32:15">తర్వాత అరణ్యం ఫలభరితమైన భూమిలా,</para>
  <para style="q2" vid="ISA 32:15">ఫలభరితమైన భూమి అడవిగా మారుతాయి.<verse eid="ISA 32:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 32:16"/>అప్పుడు యెహోవా న్యాయం అరణ్యంలో నివసిస్తుంది,</para>
  <para style="q2" vid="ISA 32:16">ఆయన నీతి ఫలభరితమైన భూమిలో ఉంటుంది.<verse eid="ISA 32:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 32:17"/>సమాధానం ఆ నీతి యొక్క ఫలంగా ఉంటుంది;</para>
  <para style="q2" vid="ISA 32:17">దాని ఫలితంగా నెమ్మది భద్రత నిత్యం కలుగుతాయి.<verse eid="ISA 32:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 32:18"/>అప్పుడు నా ప్రజలు సమాధానకరమైన నివాసాల్లో</para>
  <para style="q2" vid="ISA 32:18">సురక్షితమైన ఇళ్ళలో</para>
  <para style="q2" vid="ISA 32:18">ఎలాంటి ఆటంకాలు లేని విశ్రాంతి స్థలాల్లో నివసిస్తారు.<verse eid="ISA 32:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 32:19"/>వడగండ్లు అడవిని నాశనం చేసినా</para>
  <para style="q2" vid="ISA 32:19">పట్టణం పూర్తిగా నేలమట్టమైనా,<verse eid="ISA 32:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 32:20"/>మీరు ఎంతో ధన్యులై ఉంటారు,</para>
  <para style="q2" vid="ISA 32:20">మీరు నీటి ప్రవాహాల ఒడ్డులన్నిటి దగ్గర మీ విత్తనాలు చల్లుతూ,</para>
  <para style="q2" vid="ISA 32:20">మీ పశువులను గాడిదలను స్వేచ్ఛగా తిరగనిస్తారు.<verse eid="ISA 32:20"/></para>
  <chapter eid="ISA 32"/>
  <chapter number="33" style="c" sid="ISA 33"/>
  <para style="s1">శ్రమ, సహాయం</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 33:1"/>నాశనం చేసేవాడా,</para>
  <para style="q2" vid="ISA 33:1">ఇంకా నాశనం చేయబడని నీకు శ్రమ!</para>
  <para style="q1" vid="ISA 33:1">మోసం చేసేవాడా,</para>
  <para style="q2" vid="ISA 33:1">ఇంకా మోసం చేయబడని నీకు శ్రమ!</para>
  <para style="q1" vid="ISA 33:1">నీవు నాశనం చేయడం ముగించిన తర్వాతే</para>
  <para style="q2" vid="ISA 33:1">నీవు నాశనం చేయబడతావు;</para>
  <para style="q1" vid="ISA 33:1">నీవు మోసగించడం ముగించిన తర్వాతే</para>
  <para style="q2" vid="ISA 33:1">నీవు మోసగించబడతావు.<verse eid="ISA 33:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 33:2"/>యెహోవా! మమ్మల్ని కరుణించండి;</para>
  <para style="q2" vid="ISA 33:2">మీ కోసం ఎదురుచూస్తున్నాము.</para>
  <para style="q1" vid="ISA 33:2">ప్రతి ఉదయం మాకు బలంగా,</para>
  <para style="q2" vid="ISA 33:2">శ్రమకాలంలో మాకు రక్షణగా ఉండండి.<verse eid="ISA 33:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 33:3"/>మీ సైన్యం యొక్క గొప్ప శబ్దాన్ని విని జనాంగాలు పారిపోతాయి.</para>
  <para style="q2" vid="ISA 33:3">మీరు లేచినప్పుడు దేశాలు చెదిరిపోతాయి.<verse eid="ISA 33:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 33:4"/>దేశాల్లారా, మిడతలు పంటను తిన్నట్లుగా మీ సొమ్ము దోచుకోబడుతుంది;</para>
  <para style="q2" vid="ISA 33:4">మిడతల దండులా ప్రజలు దాని మీద పడతారు.<verse eid="ISA 33:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 33:5"/>యెహోవా ఘనత పొందుతారు, ఆయన ఎత్తైన చోట నివసిస్తారు;</para>
  <para style="q2" vid="ISA 33:5">ఆయన తన న్యాయంతో, నీతితో సీయోనును నింపుతారు.<verse eid="ISA 33:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 33:6"/>ఆయన నీ కాలాల్లో స్థిరమైన పునాది,</para>
  <para style="q2" vid="ISA 33:6">విస్తారమైన రక్షణ బుద్ధి జ్ఞానాలు ఇస్తారు.</para>
  <para style="q2" vid="ISA 33:6">యెహోవా భయం ఈ సంపదకు మూలము.<verse eid="ISA 33:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 33:7"/>చూడండి, వారి యోధులు వీధుల్లో ఘోరంగా ఏడుస్తున్నారు;</para>
  <para style="q2" vid="ISA 33:7">సమాధాన రాయబారులు ఎక్కువగా ఏడుస్తున్నారు.<verse eid="ISA 33:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 33:8"/>రహదారులు నిర్మానుష్యంగా ఉన్నాయి</para>
  <para style="q2" vid="ISA 33:8">దారుల్లో ప్రయాణికులు లేరు.</para>
  <para style="q1" vid="ISA 33:8">ఒప్పందాన్ని మీరారు,</para>
  <para style="q2" vid="ISA 33:8">పట్టణాలను అవమానపరిచారు,</para>
  <para style="q2" vid="ISA 33:8">ఏ ఒక్కరూ గౌరవించబడరు.<verse eid="ISA 33:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 33:9"/>దేశం ఎండిపోయి క్షీణించిపోతుంది,</para>
  <para style="q2" vid="ISA 33:9">లెబానోను సిగ్గుపడి వాడిపోతుంది;</para>
  <para style="q1" vid="ISA 33:9">షారోను ఎడారిలా మారింది</para>
  <para style="q2" vid="ISA 33:9">బాషాను కర్మెలు తమ చెట్ల ఆకులు రాల్చుతాయి.<verse eid="ISA 33:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 33:10"/>యెహోవా ఇలా అంటున్నారు, “ఇప్పుడు నేను లేస్తాను,</para>
  <para style="q2" vid="ISA 33:10">ఇప్పుడు నేను ఘనపరచబడతాను;</para>
  <para style="q2" vid="ISA 33:10">ఇప్పుడు నేను హెచ్చింపబడతాను<verse eid="ISA 33:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 33:11"/>మీరు పొట్టును గర్భం ధరించి</para>
  <para style="q2" vid="ISA 33:11">గడ్డికి జన్మనిస్తారు;</para>
  <para style="q2" vid="ISA 33:11">మీ ఊపిరి అగ్నిలా మిమ్మల్ని కాల్చివేస్తుంది.<verse eid="ISA 33:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 33:12"/>ప్రజలు కాలి బూడిద అవుతారు;</para>
  <para style="q2" vid="ISA 33:12">వారు నరకబడిన ముళ్ళపొదల్లా కాల్చబడతారు.”<verse eid="ISA 33:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 33:13"/>దూరంగా ఉన్నవారలారా, నేను ఏమి చేశానో వినండి;</para>
  <para style="q2" vid="ISA 33:13">దగ్గరగా ఉన్నవారలారా, నా బలాన్ని గుర్తించండి!<verse eid="ISA 33:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 33:14"/>సీయోనులో ఉన్న పాపులు భయపడుతున్నారు;</para>
  <para style="q2" vid="ISA 33:14">భక్తిహీనులకు వణుకు పుడుతుంది.</para>
  <para style="q1" vid="ISA 33:14">“మనలో ఎవరు దహించే అగ్నితో నివసించగలరు?</para>
  <para style="q2" vid="ISA 33:14">మనలో ఎవరు నిత్యం మండే అగ్నితో నివసించగలరు?”<verse eid="ISA 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 33:15"/>నీతిగా నడుచుకుంటూ</para>
  <para style="q2" vid="ISA 33:15">నిజాయితీగా మాట్లాడేవారు,</para>
  <para style="q1" vid="ISA 33:15">అవినీతి వలన వచ్చే లాభాన్ని విడిచిపెట్టి</para>
  <para style="q2" vid="ISA 33:15">తమ చేతులతో లంచం తీసుకోకుండ,</para>
  <para style="q1" vid="ISA 33:15">హత్య చేయాలనే కుట్రలు వినబడకుండ చెవులు మూసుకుని</para>
  <para style="q2" vid="ISA 33:15">చెడుతనం చూడకుండ కళ్లు మూసుకునేవారు,<verse eid="ISA 33:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 33:16"/>వారు ఉన్నత స్థలాల్లో నివసిస్తారు,</para>
  <para style="q2" vid="ISA 33:16">పర్వతాల కోటలు వారికి ఆశ్రయంగా ఉంటాయి.</para>
  <para style="q1" vid="ISA 33:16">వారికి ఆహారం దొరుకుతుంది,</para>
  <para style="q2" vid="ISA 33:16">వారికి నీళ్లు శాశ్వతంగా ఉంటాయి.<verse eid="ISA 33:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 33:17"/>మీ కళ్లు రాజును అతని వైభవంలో చూస్తాయి,</para>
  <para style="q2" vid="ISA 33:17">విశాలంగా విస్తరించిన దేశాన్ని చూస్తాయి.<verse eid="ISA 33:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 33:18"/>మీ తలంపులలో మీ గత భయాన్ని గుర్తుచేసుకుంటారు:</para>
  <para style="q2" vid="ISA 33:18">“ఆ ప్రధానాధికారి ఎక్కడ ఉన్నాడు?</para>
  <para style="q1" vid="ISA 33:18">ఆదాయాన్ని తీసుకున్నవారు ఎక్కడ?</para>
  <para style="q2" vid="ISA 33:18">గోపురాల అధికారి ఎక్కడ?”<verse eid="ISA 33:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 33:19"/>ఆ గర్వించే ప్రజలను మీరు ఇక చూడరు,</para>
  <para style="q2" vid="ISA 33:19">వారు అర్థం చేసుకోలేని భాష మాట్లాడే ప్రజలు,</para>
  <para style="q2" vid="ISA 33:19">వారి భాష వింతగా గ్రహించలేనిదిగా ఉంటుంది.<verse eid="ISA 33:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 33:20"/>మనం పండుగలు చేసుకునే సీయోను పట్టణాన్ని చూడండి;</para>
  <para style="q2" vid="ISA 33:20">మీ కళ్లు యెరూషలేమును చూస్తాయి,</para>
  <para style="q2" vid="ISA 33:20">అది ప్రశాంత నివాసంగా, కదలని గుడారంగా ఉంటుంది;</para>
  <para style="q1" vid="ISA 33:20">దాని మేకులు ఎప్పటికీ ఊడదీయబడవు,</para>
  <para style="q2" vid="ISA 33:20">దాని త్రాళ్లలో ఏ ఒక్కటి తెగిపోదు.<verse eid="ISA 33:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 33:21"/>అక్కడ యెహోవా మన బలాఢ్యుడైన రాజుగా ఉంటారు.</para>
  <para style="q2" vid="ISA 33:21">అది విశాలమైన నదులు, వాగులు ఉన్న స్థలంగా ఉంటుంది.</para>
  <para style="q1" vid="ISA 33:21">వాటిలో తెడ్ల ఓడ నడువదు</para>
  <para style="q2" vid="ISA 33:21">వాటిలో ఏ పెద్ద నౌక ప్రయాణించదు.<verse eid="ISA 33:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 33:22"/>యెహోవా మనకు న్యాయాధిపతి,</para>
  <para style="q2" vid="ISA 33:22">యెహోవా మన శాసనకర్త,</para>
  <para style="q1" vid="ISA 33:22">యెహోవా మన రాజు;</para>
  <para style="q2" vid="ISA 33:22">మనల్ని రక్షించేది ఆయనే.<verse eid="ISA 33:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 33:23"/>నీ ఓడ త్రాళ్లు వదులయ్యాయి:</para>
  <para style="q2" vid="ISA 33:23">ఓడ స్తంభం క్షేమంగా లేదు,</para>
  <para style="q2" vid="ISA 33:23">తెరచాప విప్పబడలేదు.</para>
  <para style="q1" vid="ISA 33:23">అప్పుడు విస్తారమైన దోపుడుసొమ్ము విభజించబడుతుంది,</para>
  <para style="q2" vid="ISA 33:23">కుంటివారు కూడా దోపుడుసొమ్మును తీసుకెళ్తారు.<verse eid="ISA 33:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 33:24"/>సీయోనులో నివసించేవారెవరూ, “నాకు ఆరోగ్యం బాగోలేదు” అని చెప్పరు;</para>
  <para style="q2" vid="ISA 33:24">దానిలో నివసించే ప్రజల పాపాలు క్షమించబడతాయి.<verse eid="ISA 33:24"/></para>
  <chapter eid="ISA 33"/>
  <chapter number="34" style="c" sid="ISA 34"/>
  <para style="s1">దేశాలపై తీర్పు</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 34:1"/>దేశాల్లారా, నా దగ్గరకు వచ్చి వినండి;</para>
  <para style="q2" vid="ISA 34:1">ప్రజలారా, మీరు శ్రద్ధగా వినండి!</para>
  <para style="q1" vid="ISA 34:1">భూమి దానిలోని సమస్తం,</para>
  <para style="q2" vid="ISA 34:1">లోకం, దాని నుండి వచ్చేవన్ని వినును గాక.<verse eid="ISA 34:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 34:2"/>సమస్త దేశాల మీద యెహోవా కోపంగా ఉన్నారు;</para>
  <para style="q2" vid="ISA 34:2">వారి సైన్యాలన్నిటి మీద ఆయన ఉగ్రత ఉంది.</para>
  <para style="q1" vid="ISA 34:2">ఆయన వారిని<note caller="+" style="f"><char style="fr" closed="false">34:2 </char><char style="ft" closed="false">ఇక్కడ హెబ్రీ పదం వస్తువులను లేదా వ్యక్తులను తిరిగి మార్చుకోలేని విధంగా యెహోవాకు ఇవ్వడాన్ని సూచిస్తుంది; <char style="xt" link-href="ISA 34:5"><ref loc="ISA 34:5">5</ref></char> వచనంలో కూడా</char></note> పూర్తిగా నాశనం చేస్తారు,</para>
  <para style="q2" vid="ISA 34:2">వారిని వధకు అప్పగిస్తారు.<verse eid="ISA 34:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 34:3"/>వారిలో చంపబడినవారు పూడ్చిపెట్టబడరు,</para>
  <para style="q2" vid="ISA 34:3">వారి శవాలు కంపుకొడతాయి.</para>
  <para style="q2" vid="ISA 34:3">పర్వతాలు వారి రక్తంతో తడిసిపోతాయి.<verse eid="ISA 34:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 34:4"/>ఆకాశ నక్షత్రాలన్నీ కరిగిపోతాయి</para>
  <para style="q2" vid="ISA 34:4">గ్రంథపుచుట్టలా ఆకాశాలు చుట్టబడతాయి;</para>
  <para style="q1" vid="ISA 34:4">ద్రాక్షతీగె నుండి వాడిన ఆకు రాలినట్లుగా</para>
  <para style="q2" vid="ISA 34:4">అంజూర చెట్టు నుండి వాడిన కాయ రాలినట్లుగా</para>
  <para style="q2" vid="ISA 34:4">నక్షత్ర సైన్యమంతా రాలిపోతుంది.<verse eid="ISA 34:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 34:5"/>ఆకాశంలో నా ఖడ్గం దానికి కావల్సింది త్రాగింది;</para>
  <para style="q2" vid="ISA 34:5">చూడండి, ఎదోము మీద తీర్పు తీర్చడానికి,</para>
  <para style="q2" vid="ISA 34:5">నేను పూర్తిగా నాశనం చేసిన ప్రజలు మీదికి అది దిగుతుంది.<verse eid="ISA 34:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 34:6"/>యెహోవా ఖడ్గం రక్తసిక్తం అవుతుంది,</para>
  <para style="q2" vid="ISA 34:6">అది క్రొవ్వుతో కప్పబడి ఉంది.</para>
  <para style="q1" vid="ISA 34:6">గొర్రెపిల్లల, మేకల రక్తంతో,</para>
  <para style="q2" vid="ISA 34:6">పొట్టేళ్ల మూత్రపిండాల మీది క్రొవ్వుతో కప్పబడి ఉంది.</para>
  <para style="q1" vid="ISA 34:6">ఎందుకంటే బొస్రాలో యెహోవా బలి జరిగిస్తారు.</para>
  <para style="q2" vid="ISA 34:6">ఎదోము దేశంలో ఆయన గొప్ప వధ జరిగిస్తారు.<verse eid="ISA 34:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 34:7"/>వాటితో పాటు అడవి ఎద్దులు,</para>
  <para style="q2" vid="ISA 34:7">కోడెలు, బలమైన ఎద్దులు చస్తాయి.</para>
  <para style="q1" vid="ISA 34:7">వారి భూమి రక్తంతో తడుస్తుంది.</para>
  <para style="q2" vid="ISA 34:7">వారి మట్టి క్రొవ్వులో నానుతుంది.<verse eid="ISA 34:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 34:8"/>యెహోవా ప్రతీకారం చేయడానికి ఒక రోజును,</para>
  <para style="q2" vid="ISA 34:8">సీయోను పక్షంగా ప్రాయశ్చిత్తం చేసే ఒక సంవత్సరాన్ని నియమించారు.<verse eid="ISA 34:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 34:9"/>ఎదోము నీటిప్రవాహాలు కీలుగా</para>
  <para style="q2" vid="ISA 34:9">దాని మట్టి మండుతున్న గంధకంగా మారుతుంది.</para>
  <para style="q2" vid="ISA 34:9">దాని భూమి మండుతున్న కీలుగా ఉంటుంది.<verse eid="ISA 34:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 34:10"/>అది రాత్రింబగళ్ళు ఆరిపోదు;</para>
  <para style="q2" vid="ISA 34:10">దాని పొగ నిత్యం లేస్తూనే ఉంటుంది.</para>
  <para style="q1" vid="ISA 34:10">అది తరతరాల వరకు నిర్మానుష్యంగానే ఉంటుంది;</para>
  <para style="q2" vid="ISA 34:10">దానిగుండా ఎవ్వరూ ఎప్పటికీ ప్రయాణించరు.<verse eid="ISA 34:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 34:11"/>గూడబాతులు, జీరగపిట్ట దానిని స్వాధీనం చేసుకుంటాయి;</para>
  <para style="q2" vid="ISA 34:11">గుడ్లగూబ, కాకి దానిలో నివసిస్తాయి.</para>
  <para style="q1" vid="ISA 34:11">దేవుడు తారుమారనే కొలమానాన్ని</para>
  <para style="q2" vid="ISA 34:11">శూన్యమనే మట్టపు గుండును</para>
  <para style="q2" vid="ISA 34:11">ఏదోముపై చాపుతారు.<verse eid="ISA 34:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 34:12"/>రాజ్యమని ప్రకటించడానికి వారి ఘనులకు అక్కడ ఏమీ మిగలదు,</para>
  <para style="q2" vid="ISA 34:12">వారి అధిపతులందరు మాయమవుతారు.<verse eid="ISA 34:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 34:13"/>దాని కోటలలో ముళ్ళచెట్లు,</para>
  <para style="q2" vid="ISA 34:13">దాని దుర్గాలలో దురదగొండ్లు గచ్చపొదలు పెరుగుతాయి.</para>
  <para style="q1" vid="ISA 34:13">అది తోడేళ్లకు నివాసంగా</para>
  <para style="q2" vid="ISA 34:13">గుడ్లగూబలకు ఇల్లుగా ఉంటుంది.<verse eid="ISA 34:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 34:14"/>ఎడారి జీవులు, హైనాలు అక్కడ కలిసి తిరుగుతాయి</para>
  <para style="q2" vid="ISA 34:14">అడవి మేకలు ఒకదానిపై ఒకటి విరుచుకుపడతాయి;</para>
  <para style="q1" vid="ISA 34:14">అక్కడ రాత్రివేళ తిరిగే ప్రాణులు కూడా పడుకుంటాయి</para>
  <para style="q2" vid="ISA 34:14">అక్కడ అవి వాటికి విశ్రాంతి స్థలాలను కనుగొంటారు.<verse eid="ISA 34:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 34:15"/>అక్కడ గుడ్లగూబ గూడు కట్టి గుడ్లు పెట్టి,</para>
  <para style="q2" vid="ISA 34:15">వాటిని పొదిగి, తన రెక్కల నీడలో వాటిని ఉంచి,</para>
  <para style="q2" vid="ISA 34:15">దాని పిల్లలను పోషిస్తుంది.</para>
  <para style="q1" vid="ISA 34:15">అక్కడ తెల్ల గద్దలు</para>
  <para style="q2" vid="ISA 34:15">ప్రతి ఒక్కటి తమ జాతి పక్షులతో జతకడతాయి.<verse eid="ISA 34:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 34:16"/>యెహోవా గ్రంథాన్ని పరిశీలించి చదవండి:</para>
  <para style="q1" vid="ISA 34:16">వీటిలో ఏవి తప్పిపోవు,</para>
  <para style="q2" vid="ISA 34:16">ఏ ఒక్కటి కూడా తన జత లేకుండా ఉండదు.</para>
  <para style="q1" vid="ISA 34:16">ఎందుకంటే, ఆయన నోరే ఈ ఆదేశాన్ని ఇచ్చింది,</para>
  <para style="q2" vid="ISA 34:16">ఆయన ఆత్మ వాటిని పోగుచేస్తారు.<verse eid="ISA 34:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 34:17"/>ఆయన వాటికి వాటి భాగాలు కేటాయిస్తారు;</para>
  <para style="q2" vid="ISA 34:17">ఆయన చేతి కొలత ప్రకారం వాటికి పంచిపెడుతుంది.</para>
  <para style="q1" vid="ISA 34:17">అవి శాశ్వతంగా దానిని స్వాధీనం చేసుకుంటాయి</para>
  <para style="q2" vid="ISA 34:17">తరతరాలు అందులో నివసిస్తాయి.<verse eid="ISA 34:17"/></para>
  <chapter eid="ISA 34"/>
  <chapter number="35" style="c" sid="ISA 35"/>
  <para style="s1">విమోచన పొందినవారి ఆనందం</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 35:1"/>ఎడారి, ఎండిన భూమి సంతోషిస్తాయి;</para>
  <para style="q2" vid="ISA 35:1">అరణ్యం సంతోషించి పూస్తుంది.</para>
  <para style="q1" vid="ISA 35:1">అది కుంకుమ పువ్వులా, <verse eid="ISA 35:1"/><verse number="2" style="v" sid="ISA 35:2"/>ఒక్కసారిగా విచ్చుకుంటుంది;</para>
  <para style="q2" vid="ISA 35:2">అది గొప్పగా సంతోషించి ఆనందంతో కేకలు వేస్తుంది.</para>
  <para style="q1" vid="ISA 35:2">లెబానోను మహిమ దానికి ఇవ్వబడుతుంది,</para>
  <para style="q2" vid="ISA 35:2">కర్మెలు షారోనుల వైభవం దానికి ఉంటుంది;</para>
  <para style="q1" vid="ISA 35:2">వారు యెహోవా మహిమను</para>
  <para style="q2" vid="ISA 35:2">మన దేవుని వైభవాన్ని చూస్తారు.<verse eid="ISA 35:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 35:3"/>బలహీనమైన చేతులను బలపరచండి,</para>
  <para style="q2" vid="ISA 35:3">వణుకుతున్న మోకాళ్లను స్థిరపరచండి;<verse eid="ISA 35:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 35:4"/>భయపడేవారితో ఇలా అనండి:</para>
  <para style="q2" vid="ISA 35:4">“ధైర్యంగా ఉండండి, భయపడకండి;</para>
  <para style="q1" vid="ISA 35:4">మీ దేవుడు వస్తారు</para>
  <para style="q2" vid="ISA 35:4">ఆయన ప్రతీకారంతో వస్తారు.</para>
  <para style="q1" vid="ISA 35:4">దైవిక ప్రతీకారంతో</para>
  <para style="q2" vid="ISA 35:4">ఆయన మిమ్మల్ని రక్షించడానికి వస్తారు.”<verse eid="ISA 35:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 35:5"/>అప్పుడు గ్రుడ్డివారి కళ్లు తెరవబడతాయి</para>
  <para style="q2" vid="ISA 35:5">చెవిటి వారి చెవులు వినబడతాయి.<verse eid="ISA 35:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 35:6"/>అప్పుడు కుంటివారు జింకలా గంతులు వేస్తారు,</para>
  <para style="q2" vid="ISA 35:6">మూగవాని నాలుక ఆనందంతో కేకలు వేస్తుంది.</para>
  <para style="q1" vid="ISA 35:6">అరణ్యంలో నీళ్లు ఉబుకుతాయి</para>
  <para style="q2" vid="ISA 35:6">ఎడారిలో కాలువలు పారతాయి.<verse eid="ISA 35:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 35:7"/>మండుతున్న ఇసుక చెరువులా మారుతుంది</para>
  <para style="q2" vid="ISA 35:7">ఎండిన నేలలో నీటిబుగ్గలు పుడతాయి.</para>
  <para style="q1" vid="ISA 35:7">ఒక్కప్పుడు తోడేళ్లు పడుకున్న స్థలంలో</para>
  <para style="q2" vid="ISA 35:7">గడ్డి, రెల్లు, జమ్ము పెరుగుతాయి.<verse eid="ISA 35:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 35:8"/>అక్కడ రహదారి ఉంటుంది;</para>
  <para style="q2" vid="ISA 35:8">అది పరిశుద్ధ మార్గమని పిలువబడుతుంది;</para>
  <para style="q2" vid="ISA 35:8">అది ఆ మార్గంలో నడిచే వారికి మాత్రమే.</para>
  <para style="q1" vid="ISA 35:8">అపవిత్రులు ఆ దారిలో వెళ్లకూడదు;</para>
  <para style="q2" vid="ISA 35:8">దుర్మార్గమైన మూర్ఖులు దానిలో నడవరు.<verse eid="ISA 35:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 35:9"/>అక్కడ ఏ సింహం ఉండదు,</para>
  <para style="q2" vid="ISA 35:9">ఏ క్రూర జంతువు ఉండదు;</para>
  <para style="q2" vid="ISA 35:9">అవి అక్కడ కనబడవు.</para>
  <para style="q1" vid="ISA 35:9">విమోచన పొందిన వారే అక్కడ నడుస్తారు.<verse eid="ISA 35:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="ISA 35:10"/>యెహోవా విడిపించిన వారు తిరిగి వస్తారు.</para>
  <para style="q1" vid="ISA 35:10">వారు పాటలు పాడుతూ సీయోనులో ప్రవేశిస్తారు;</para>
  <para style="q2" vid="ISA 35:10">నిత్యమైన ఆనందం వారి తలల మీద కిరీటంగా ఉంటుంది.</para>
  <para style="q1" vid="ISA 35:10">వారు ఆనంద సంతోషాలతో నిండి ఉంటారు.</para>
  <para style="q2" vid="ISA 35:10">దుఃఖం, నిట్టూర్పు పారిపోతాయి.<verse eid="ISA 35:10"/></para>
  <chapter eid="ISA 35"/>
  <chapter number="36" style="c" sid="ISA 36"/>
  <para style="s1">సన్హెరీబు యెరూషలేమును భయపెట్టుట</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 36:1"/>రాజైన హిజ్కియా పాలన పద్నాలుగవ సంవత్సరంలో అష్షూరు రాజైన సన్హెరీబు యూదా దేశంలోని కోటగోడలున్న పట్టణాలన్నిటి మీద దాడిచేసి వాటిని స్వాధీనం చేసుకున్నాడు. <verse eid="ISA 36:1"/><verse number="2" style="v" sid="ISA 36:2"/>అప్పుడు అష్షూరు రాజు లాకీషు నుండి యెరూషలేములో ఉన్న రాజైన హిజ్కియా మీదికి గొప్ప సైన్యంతో తన యుద్ధభూమిలో ఉన్న సైన్యాధిపతిని పంపించాడు. ఆ సైన్యాధిపతి చాకలి రేవు దారిలో ఉన్న పై కోనేటి కాలువ దగ్గర ఆగినప్పుడు, <verse eid="ISA 36:2"/><verse number="3" style="v" sid="ISA 36:3"/>హిల్కీయా కుమారుడు రాజభవన నిర్వాహకుడైన ఎల్యాకీము, శాస్త్రి షెబ్నా, ఆసాపు కుమారుడు, రాజ్య లేఖికుడైన యోవాహు అతని దగ్గరకు వెళ్లారు.<verse eid="ISA 36:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 36:4"/>అప్పుడు సైన్యాధిపతి వారితో ఇలా అన్నాడు, “హిజ్కియాకు చెప్పండి:</para>
  <para style="pm" vid="ISA 36:4">“ ‘మహారాజు, అష్షూరు రాజు చెప్పే మాట ఇది: దేన్ని చూసుకుని నీకు ఈ ధైర్యం? <verse eid="ISA 36:4"/><verse number="5" style="v" sid="ISA 36:5"/>యుద్ధం విషయంలో నీకు ఆలోచన, బలం ఉంది అంటావు, కాని నీవు మాట్లాడేవి వట్టి మాటలే. ఎవరిని నమ్ముకొని నామీద తిరుగుబాటు చేస్తున్నావు? <verse eid="ISA 36:5"/><verse number="6" style="v" sid="ISA 36:6"/>చూడు, నీవు నలిగిన రెల్లులాంటి ఈజిప్టును నమ్ముకుంటున్నావు, ఎవరైనా దాని మీద ఆనుకుంటే అది అతని చేతికి గుచ్చుకుని లోపలికి దిగుతుంది. ఈజిప్టు రాజైన ఫరోను నమ్ముకునే వారందరికి అతడు చేసేది అదే. <verse eid="ISA 36:6"/><verse number="7" style="v" sid="ISA 36:7"/>అయితే, “మా దేవుడైన యెహోవా మీద మేము ఆధారపడుతున్నాం” అని మీరు నాతో అంటే, “ఈ బలిపీఠం దగ్గర మీరు ఆరాధించాలి” అని యూదా వారితో యెరూషలేము వారితో చెప్పిన ఆయన ఉన్నత స్థలాలను, బలిపీఠాలనే కదా హిజ్కియా పడగొట్టింది?<verse eid="ISA 36:7"/></para>
  <para style="pm">
    <verse number="8" style="v" sid="ISA 36:8"/>“ ‘ఇప్పుడు రండి, నా యజమానియైన అష్షూరు రాజుతో బేరం కుదుర్చుకోండి: మీ దగ్గర రెండువేల గుర్రాలకు సరిపడే రౌతులు ఉంటే, నేను వాటిని మీకు ఇస్తాను! <verse eid="ISA 36:8"/><verse number="9" style="v" sid="ISA 36:9"/>రథాలు రౌతుల కోసం ఈజిప్టు రాజును నమ్ముకున్నా, మీరు నా యజమాని అధికారులలో అతి అల్పుడైన ఒక్క అధికారినైనా ఎలా ఎదిరించగలరు? <verse eid="ISA 36:9"/><verse number="10" style="v" sid="ISA 36:10"/>యెహోవా నుండి అనుమతి లేకుండానే ఈ స్థలంపై దాడి చేసి నాశనం చేయడానికి వచ్చానా? ఈ దేశంపై దాడి చేసి నాశనం చేయమని స్వయాన యెహోవాయే చెప్పారు.’ ”<verse eid="ISA 36:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ISA 36:11"/>అప్పుడు ఎల్యాకీము, షెబ్నా, యోవాహు సైన్యాధిపతితో, “నీ దాసులమైన మాకు అరామిక్ భాష అర్థం అవుతుంది కాబట్టి ఆ భాషలో మాట్లాడండి. గోడ మీద ఉన్న ప్రజలకు వినిపించేలా హెబ్రీ భాషలో మాట్లాడకండి” అన్నారు.<verse eid="ISA 36:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 36:12"/>అయితే సైన్యాధిపతి జవాబిస్తూ, “ఈ విషయాలు కేవలం మీకు, మీ యజమానికి మాత్రమే చెప్పటానికి నా యజమాని నన్ను పంపాడని, గోడ మీద కూర్చున్న ప్రజలకు కాదనుకున్నారా? వారు కూడా మీలాగే తమ మలం తింటూ తమ మూత్రం త్రాగాల్సిందే” అని అన్నాడు.<verse eid="ISA 36:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 36:13"/>అప్పుడు సైన్యాధిపతి నిలబడి బిగ్గరగా హెబ్రీ భాషలో ఇలా అన్నాడు, “మహారాజైన అష్షూరు రాజు మాటలు వినండి! <verse eid="ISA 36:13"/><verse number="14" style="v" sid="ISA 36:14"/>రాజు చెప్పే మాట ఇదే: హిజ్కియా మిమ్మల్ని మోసం చేయకుండ చూసుకోండి. అతడు మిమ్మల్ని విడిపించలేడు. <verse eid="ISA 36:14"/><verse number="15" style="v" sid="ISA 36:15"/>హిజ్కియా, ‘యెహోవా మనల్ని తప్పక విడిపిస్తారు; ఈ పట్టణం అష్షూరు రాజు చేతికి చిక్కదు’ అని చెప్తూ యెహోవా మీద నమ్మకం ఉంచేలా ప్రేరేపించనివ్వకండి.<verse eid="ISA 36:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 36:16"/>“హిజ్కియా మాటలు వినకండి. అష్షూరు రాజు చెప్పే మాట ఇదే: నాతో సమాధాన ఒప్పందం చేసుకుని, నా దగ్గరకు రండి. అప్పుడు నేను వచ్చేవరకు, మీలో ప్రతి ఒక్కరూ మీ ద్రాక్షచెట్టు పండ్లు, మీ అంజూర చెట్టు పండ్లు తింటూ, మీ బావి నీళ్లు త్రాగుతారు. <verse eid="ISA 36:16"/><verse number="17" style="v" sid="ISA 36:17"/>తర్వాత నేను వచ్చి మిమ్మల్ని మీ సొంత దేశం లాంటి దేశానికి తీసుకెళ్తాను. అది ధాన్యాలు, క్రొత్త ద్రాక్షరసం ఉన్న దేశం.<verse eid="ISA 36:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 36:18"/>“హిజ్కియా, ‘యెహోవా మనల్ని విడిపిస్తారు’ అని చెప్తూ మిమ్మల్ని తప్పుత్రోవ పట్టనివ్వకండి. ఇతర దేశాల దేవుళ్ళు ఎవరైనా తన దేశాన్ని అష్షూరు రాజు చేతిలో నుండి విడిపించారా? <verse eid="ISA 36:18"/><verse number="19" style="v" sid="ISA 36:19"/>హమాతు, అర్పదు దేవుళ్ళు ఎక్కడ? సెఫర్వయీము దేవుళ్ళు ఎక్కడ? వారు నా చేతిలో నుండి సమరయను రక్షించగలిగారా? <verse eid="ISA 36:19"/><verse number="20" style="v" sid="ISA 36:20"/>ఈ దేశాల దేవుళ్ళలో ఎవరైనా తమ దేశాలను నా చేతిలో నుండి రక్షించగలిగారా? అలాగైతే, యెహోవా నా చేతిలో నుండి యెరూషలేమును ఎలా విడిపిస్తారు?”<verse eid="ISA 36:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 36:21"/>అయితే, “అతనికి జవాబివ్వకండి” అని రాజు వారికి ఆజ్ఞాపించడంతో ప్రజలు ఏమి జవాబివ్వకుండా మౌనంగా ఉన్నారు.<verse eid="ISA 36:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 36:22"/>అప్పుడు హిల్కీయా, రాజభవన నిర్వాహకుడైన ఎల్యాకీము, కార్యదర్శియైన షెబ్నా, ఆసాపు కుమారుడు, రాజ్య లేఖికుడైన యోవాహు, తమ బట్టలు చింపుకొని హిజ్కియా దగ్గరకు వెళ్లి అష్షూరు సైన్యాధిపతి చెప్పింది అతనికి తెలియజేశారు.<verse eid="ISA 36:22"/></para>
  <chapter eid="ISA 36"/>
  <chapter number="37" style="c" sid="ISA 37"/>
  <para style="s1">యెరూషలేము విడుదల ముందే తెలియజేయుట</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 37:1"/>ఇది విని రాజైన హిజ్కియా తన బట్టలు చింపుకుని గోనెపట్ట కట్టుకుని యెహోవా మందిరంలోకి వెళ్లాడు. <verse eid="ISA 37:1"/><verse number="2" style="v" sid="ISA 37:2"/>అతడు రాజభవన నిర్వాహకుడైన ఎల్యాకీమును, కార్యదర్శియైన షెబ్నాను, యాజకులలో పెద్దవారిని ఆమోజు కుమారుడును ప్రవక్తయునైన యెషయా దగ్గరకు పంపాడు, వారంత గోనెపట్ట కట్టుకున్నారు. <verse eid="ISA 37:2"/><verse number="3" style="v" sid="ISA 37:3"/>వారు అతనితో ఇలా అన్నారు, “హిజ్కియా చెప్పిన మాట ఇదే: ఈ రోజు బాధ, చీవాట్లు, అవమానం ఉన్న రోజు, బిడ్డ పుట్టడానికి సమయం దగ్గరకు వచ్చినా కనే శక్తిలేని స్త్రీలా ఉంది. <verse eid="ISA 37:3"/><verse number="4" style="v" sid="ISA 37:4"/>జీవంగల దేవున్ని దూషించడానికి అష్షూరు రాజు తన సేవకుడైన సైన్యాధిపతి పంపించాడు. అతడు పలికిన మాటలన్నీ మీ దేవుడైన యెహోవా విని అతని మాటలనుబట్టి మీ దేవుడైన యెహోవా అష్షూరు రాజును గద్దిస్తారేమో, కాబట్టి ఇక్కడ మిగిలే వారి కోసం ప్రార్థించండి.”<verse eid="ISA 37:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 37:5"/>రాజైన హిజ్కియా సేవకులు యెషయా దగ్గరకు వచ్చినప్పుడు, <verse eid="ISA 37:5"/><verse number="6" style="v" sid="ISA 37:6"/>యెషయా వారితో ఇలా అన్నాడు, “మీ యజమానికి చెప్పండి, ‘యెహోవా చెప్పే మాట ఇదే: మీరు విన్న వాటికి అనగా అష్షూరు రాజు సేవకులు నన్ను దూషిస్తూ మాట్లాడిన మాటలకు భయపడకండి. <verse eid="ISA 37:6"/><verse number="7" style="v" sid="ISA 37:7"/>వినండి! అతడు ఒక వదంతి విని తన దేశానికి వెళ్ళిపోయేలా నేను చేస్తాను, అక్కడ అతడు ఖడ్గం చేత చనిపోయేలా చేస్తాను.’ ”<verse eid="ISA 37:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 37:8"/>అంతలో అష్షూరు రాజు లాకీషును విడిచి వెళ్లాడని అతని సైన్యాధిపతి విని, అతడు తిరిగివెళ్లి రాజు లిబ్నాతో పోరాడుతున్నాడని తెలుసుకున్నాడు.<verse eid="ISA 37:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ISA 37:9"/>అప్పుడు, కూషు<note caller="+" style="f"><char style="fr" closed="false">37:9 </char><char style="ft" closed="false">అంటే, నైలు ఉపరితల ప్రాంతం</char></note> రాజైన తిర్హాకా తన మీద యుద్ధం చేయడానికి వస్తున్నాడనే వార్త సన్హెరీబు విన్నప్పుడు, అతడు దూతలతో హిజ్కియా దగ్గరకు ఇలా సందేశం పంపాడు: <verse eid="ISA 37:9"/><verse number="10" style="v" sid="ISA 37:10"/>“యూదా రాజైన హిజ్కియాకు ఇలా చెప్పండి: నీవు నమ్ముకున్న నీ దేవుడు నీతో, ‘యెరూషలేము అష్షూరు రాజు చేతికి ఇవ్వబడదు’ అని చెప్పే మోసపు మాటలకు మోసపోవద్దు. <verse eid="ISA 37:10"/><verse number="11" style="v" sid="ISA 37:11"/>అష్షూరు రాజులు అన్ని దేశాలను పూర్తిగా నాశనం చేసిన సంగతి నీవు ఖచ్చితంగా వినే ఉంటావు. మీరు మాత్రం తప్పించుకోగలరా? <verse eid="ISA 37:11"/><verse number="12" style="v" sid="ISA 37:12"/>గోజాను, హారాను, రెజెపు, తెలశ్శారు పట్టణంలో ఉండే ఏదెను ప్రజలను నా పూర్వికులు నాశనం చేసినప్పుడు, ఆ జనాల దేవుళ్ళు వారిని విడిపించారా? <verse eid="ISA 37:12"/><verse number="13" style="v" sid="ISA 37:13"/>హమాతు రాజు, అర్పదు రాజు ఎక్కడ? లాయిరు, సెఫర్వయీము, హేన, ఇవ్వా పట్టణాల రాజులు ఏమయ్యారు?”<verse eid="ISA 37:13"/></para>
  <para style="s1">హిజ్కియా ప్రార్థన</para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 37:14"/>హిజ్కియా దూతల నుండి లేఖ తీసుకుని దానిని చదివాడు. తర్వాత యెహోవా ఆలయానికి వెళ్లి, యెహోవా సముఖంలో ఆ ఉత్తరాన్ని తెరిచాడు. <verse eid="ISA 37:14"/><verse number="15" style="v" sid="ISA 37:15"/>హిజ్కియా యెహోవాకు ఇలా ప్రార్థన చేశాడు: <verse eid="ISA 37:15"/><verse number="16" style="v" sid="ISA 37:16"/>“సైన్యాల యెహోవా! ఇశ్రాయేలు దేవా! కెరూబుల మధ్యలో సింహాసనాసీనుడా! ఈ లోక రాజ్యాలకు మీరు మాత్రమే దేవుడు. మీరు భూమ్యాకాశాలను సృష్టించారు. <verse eid="ISA 37:16"/><verse number="17" style="v" sid="ISA 37:17"/>యెహోవా, శ్రద్ధగా వినండి; యెహోవా, కళ్లు తెరచి చూడండి. జీవంగల దేవున్ని దూషించడానికి సన్హెరీబు చెప్పి పంపిన మాటలన్నిటిని వినండి.<verse eid="ISA 37:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 37:18"/>“యెహోవా! అష్షూరు రాజులు ఈ ప్రజలందరినీ, వారి దేశాలను నాశనం చేశారన్నది వాస్తవం. <verse eid="ISA 37:18"/><verse number="19" style="v" sid="ISA 37:19"/>వారు వారి దేవుళ్ళను అగ్నిలో వేసి నాశనం చేశారు, ఎందుకంటే అవి దేవుళ్ళు కాదు, కేవలం మనుషుల చేతులతో చేసిన కర్ర, రాళ్లు మాత్రమే. <verse eid="ISA 37:19"/><verse number="20" style="v" sid="ISA 37:20"/>ఇప్పుడు యెహోవా, మా దేవా, మమ్మల్ని అతని చేతిలో నుండి విడిపించండి, అప్పుడు ఈ లోక రాజ్యాలన్ని యెహోవాయైన మీరే దేవుడని తెలుసుకుంటారు.”<verse eid="ISA 37:20"/></para>
  <para style="s1">సన్హెరీబు పతనం</para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 37:21"/>అప్పుడు ఆమోజు కుమారుడైన యెషయా హిజ్కియాకు ఇలా సందేశం పంపాడు: “ఇశ్రాయేలు దేవుడైన యెహోవా చెప్పే మాట ఇదే: అష్షూరు రాజైన సన్హెరీబు గురించి నీవు నాకు ప్రార్థన చేసినందుకు, <verse eid="ISA 37:21"/><verse number="22" style="v" sid="ISA 37:22"/>అతని గురించి యెహోవా చెప్పిన మాట ఇదే:</para>
  <para style="q1" vid="ISA 37:22">“కన్యయైన సీయోను కుమార్తె</para>
  <para style="q2" vid="ISA 37:22">నిన్ను తృణీకరించి ఎగతాళి చేస్తుంది.</para>
  <para style="q1" vid="ISA 37:22">యెరూషలేము కుమార్తె</para>
  <para style="q2" vid="ISA 37:22">నీవు పారిపోతుంటే తల ఊపుతుంది.<verse eid="ISA 37:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 37:23"/>నీవు ఎవరిని నిందించి దూషించావు?</para>
  <para style="q2" vid="ISA 37:23">ఎవరి మీద నీవు అరిచి</para>
  <para style="q1" vid="ISA 37:23">గర్వంతో నీ కళ్ళెత్తి చూశావు?</para>
  <para style="q2" vid="ISA 37:23">ఇశ్రాయేలు పరిశుద్ధ దేవునినే గదా!<verse eid="ISA 37:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 37:24"/>నీవు పంపిన దూతల ద్వారా</para>
  <para style="q2" vid="ISA 37:24">ప్రభువును దూషించావు.</para>
  <para style="q1" vid="ISA 37:24">నీవు అన్నావు,</para>
  <para style="q2" vid="ISA 37:24">‘నాకున్న అనేక రథాల చేత,</para>
  <para style="q1" vid="ISA 37:24">పర్వత శిఖరాల మీదికి ఎక్కాను,</para>
  <para style="q2" vid="ISA 37:24">లెబానోను ఎత్తైన స్థలాలను ఎక్కాను.</para>
  <para style="q1" vid="ISA 37:24">దాని పొడువైన దేవదారులను నరికివేశాను,</para>
  <para style="q2" vid="ISA 37:24">శ్రేష్ఠమైన సరళ వృక్షాలను నరికివేశాను.</para>
  <para style="q1" vid="ISA 37:24">దాని చివరి సరిహద్దులను చేరుకున్నాను,</para>
  <para style="q2" vid="ISA 37:24">దాని సారవంతమైన అడవులను చేరుకున్నాను.<verse eid="ISA 37:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 37:25"/>నేను పరదేశి నేలలో బావులు త్రవ్వి</para>
  <para style="q2" vid="ISA 37:25">అక్కడి నీళ్లు త్రాగాను.</para>
  <para style="q1" vid="ISA 37:25">నా అరికాలితో</para>
  <para style="q2" vid="ISA 37:25">ఈజిప్టు నది ప్రవాహాలన్నీ ఎండిపోయేలా చేశాను.’<verse eid="ISA 37:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 37:26"/>“చాలా కాలం క్రితం నేనే నిర్ణయించానని,</para>
  <para style="q2" vid="ISA 37:26">నీవు వినలేదా?</para>
  <para style="q1" vid="ISA 37:26">పూర్వకాలంలో నేను సంకల్పించాను.</para>
  <para style="q2" vid="ISA 37:26">ఇప్పుడు నేను అలా జరిగేలా చేశాను,</para>
  <para style="q1" vid="ISA 37:26">నీవు కోటగోడలు గల పట్టణాలను</para>
  <para style="q2" vid="ISA 37:26">రాళ్ల కుప్పలుగా చేసేలా చేశాను.<verse eid="ISA 37:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 37:27"/>వారి ప్రజలు బలహీనులై,</para>
  <para style="q2" vid="ISA 37:27">భయాక్రాంతులై అవమానం పాలయ్యారు.</para>
  <para style="q1" vid="ISA 37:27">వారు పొలంలో మొక్కల్లా,</para>
  <para style="q2" vid="ISA 37:27">పచ్చని మొక్కల్లా,</para>
  <para style="q1" vid="ISA 37:27">ఇంటికప్పు మీద పెరిగే గడ్డిలా</para>
  <para style="q2" vid="ISA 37:27">పెరగక ముందే వాడిపోయినట్టు ఉన్నారు.<verse eid="ISA 37:27"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 37:28"/>“అయితే నీవు ఎక్కడ ఉన్నావో</para>
  <para style="q2" vid="ISA 37:28">ఎప్పుడు వస్తావో ఎప్పుడు వెళ్తావో</para>
  <para style="q2" vid="ISA 37:28">నా మీద ఎంత కోపంగా ఉన్నావో నాకు తెలుసు.<verse eid="ISA 37:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 37:29"/>నీవు నాకు వ్యతిరేకంగా లేస్తున్నందుకు,</para>
  <para style="q2" vid="ISA 37:29">నీ అహంకారం నా చెవిని చేరినందుకు,</para>
  <para style="q1" vid="ISA 37:29">నా గాలాన్ని నీ ముక్కుకు తగిలిస్తాను,</para>
  <para style="q2" vid="ISA 37:29">నా కళ్లెం నీ నోటిలో వేస్తాను.</para>
  <para style="q1" vid="ISA 37:29">నీవు వచ్చిన దారిలోనే</para>
  <para style="q2" vid="ISA 37:29">నీవు తిరిగి వెళ్లేలా చేస్తాను.<verse eid="ISA 37:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="ISA 37:30"/>“హిజ్కియా, దానికి నీకిదే సూచన:</para>
  <para style="q1" vid="ISA 37:30">“ఈ సంవత్సరం దాని అంతట అదే పండే పంటను మీరు తింటారు,</para>
  <para style="q2" vid="ISA 37:30">రెండవ ఏట దాని నుండి కలిగే ధాన్యాన్ని మీరు తింటారు.</para>
  <para style="q1" vid="ISA 37:30">అయితే మూడవ ఏట విత్తనాలు చల్లి కోత కోస్తారు,</para>
  <para style="q2" vid="ISA 37:30">ద్రాక్షతోటలు నాటి వాటి ఫలాలు మీరు తింటారు.<verse eid="ISA 37:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 37:31"/>యూదా రాజ్యంలో శేషం మరోసారి</para>
  <para style="q2" vid="ISA 37:31">క్రిందికి వేర్లు తన్ని చిగురించి ఫలిస్తుంది.<verse eid="ISA 37:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="ISA 37:32"/>యెరూషలేము నుండి శేషం వస్తుంది,</para>
  <para style="q2" vid="ISA 37:32">సీయోను పర్వతం నుండి తప్పించుకున్నవారు వస్తారు.</para>
  <para style="q1" vid="ISA 37:32">సైన్యాల యెహోవా రోషం</para>
  <para style="q2" vid="ISA 37:32">దీన్ని సాధిస్తుంది.<verse eid="ISA 37:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="ISA 37:33"/>“కాబట్టి, అష్షూరు రాజు గురించి యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="ISA 37:33">“అతడు ఈ పట్టణంలోకి ప్రవేశించడు</para>
  <para style="q2" vid="ISA 37:33">ఒక్క బాణమైనా వేయడు.</para>
  <para style="q1" vid="ISA 37:33">ఒక్క డాలును దానికి చూపించడు</para>
  <para style="q2" vid="ISA 37:33">దాని ఎదురుగా ముట్టడి దిబ్బ వేయడు.<verse eid="ISA 37:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="ISA 37:34"/>అతడు వచ్చిన దారినే తిరిగి వెళ్లిపోతాడు.</para>
  <para style="q2" vid="ISA 37:34">అతడు ఈ పట్టణంలోకి ప్రవేశించడు”</para>
  <para style="q2" vid="ISA 37:34">అని యెహోవా ప్రకటిస్తున్నారు.<verse eid="ISA 37:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="ISA 37:35"/>“నా కోసం, నా సేవకుడైన దావీదు కోసం</para>
  <para style="q2" vid="ISA 37:35">నేను ఈ పట్టణాన్ని కాపాడి రక్షిస్తాను!”<verse eid="ISA 37:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="ISA 37:36"/>అప్పుడు యెహోవా దూత బయలుదేరి అష్షూరు శిబిరంలో 1,85,000 మంది సైనికులను హతం చేశాడు. ప్రొద్దున ప్రజలు లేచి చూస్తే వారంతా శవాలుగా పడి ఉన్నారు. <verse eid="ISA 37:36"/><verse number="37" style="v" sid="ISA 37:37"/>అప్పుడు అష్షూరు రాజైన సన్హెరీబు తిరిగి వెళ్లిపోయాడు, నీనెవెకు తిరిగివెళ్లి అక్కడ ఉండిపోయాడు.<verse eid="ISA 37:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="ISA 37:38"/>ఒక రోజు, అతడు నిస్రోకు అనే తన దేవుని గుడిలో పూజ చేస్తుండగా అతని కుమారులు ఆద్రమ్మెలెకు, షెరెజరు ఖడ్గంతో అతన్ని చంపి, అరారతు ప్రాంతానికి పారిపోయారు. అతని తర్వాత అతని కుమారుడైన ఏసర్హద్దోను రాజయ్యాడు.<verse eid="ISA 37:38"/></para>
  <chapter eid="ISA 37"/>
  <chapter number="38" style="c" sid="ISA 38"/>
  <para style="s1">హిజ్కియాకు అస్వస్థత</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 38:1"/>ఆ రోజుల్లో హిజ్కియాకు జబ్బుచేసి మరణానికి దగ్గరలో ఉన్నాడు. ఆమోజు కుమారుడైన యెషయా ప్రవక్త అతని దగ్గరకు వెళ్లి, “యెహోవా చెప్పే మాట ఇదే: నీవు చనిపోబోతున్నావు; నీవు కోలుకోవు, కాబట్టి నీ ఇంటిని చక్కబెట్టుకో” అన్నాడు.<verse eid="ISA 38:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="ISA 38:2"/>హిజ్కియా తన ముఖాన్ని గోడవైపు త్రిప్పుకుని యెహోవాకు ఇలా ప్రార్థన చేశాడు, <verse eid="ISA 38:2"/><verse number="3" style="v" sid="ISA 38:3"/>“యెహోవా, నేను నమ్మకంగా యథార్థ హృదయంతో, మీ సన్నిధిలో ఎలా నడుచుకున్నానో, మీ దృష్టిలో సరియైనది ఎలా చేశానో జ్ఞాపకం చేసుకోండి.” హిజ్కియా భారంగా ఏడ్చాడు.<verse eid="ISA 38:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 38:4"/>అప్పుడు యెహోవా వాక్కు యెషయాకు ఇలా వచ్చింది: <verse eid="ISA 38:4"/><verse number="5" style="v" sid="ISA 38:5"/>“నీవు వెళ్లి హిజ్కియాకు ఇలా చెప్పు, ‘నీ పూర్వికుడైన దావీదు దేవుడైన యెహోవా చెప్పే మాట ఇదే: నేను నీ ప్రార్థన విని నీ కన్నీరు చూశాను. నీ జీవితంలో ఇంకా పదిహేను సంవత్సరాల ఆయుష్షు పెంచుతాను. <verse eid="ISA 38:5"/><verse number="6" style="v" sid="ISA 38:6"/>అంతేకాక, నిన్ను, ఈ పట్టణాన్ని అష్షూరు రాజు చేతి నుండి రక్షిస్తాను. నేను ఈ పట్టణాన్ని కాపాడతాను.<verse eid="ISA 38:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ISA 38:7"/>“ ‘యెహోవా తాను చెప్పిన మాట నెరవేరుస్తారని తెలియజేయడానికి యెహోవా నీకు ఇచ్చే సూచన ఇదే: <verse eid="ISA 38:7"/><verse number="8" style="v" sid="ISA 38:8"/>ఆహాజు ఎండ గడియారం మీద సూర్యకాంతి వలన ముందుకు జరిగిన నీడ మళ్ళీ పది మెట్లు వెనుకకు వెళ్లేలా నేను చేస్తాను.’ ” కాబట్టి సూర్యకాంతి ముందుకు జరిగిన మెట్లలో పది మెట్లు మరలా వెనుకకు జరిగింది.<verse eid="ISA 38:8"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="9" style="v" sid="ISA 38:9"/>యూదా రాజైన హిజ్కియా అనారోగ్యం నుండి కోలుకున్న తర్వాత అతని రచన:<verse eid="ISA 38:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 38:10"/>నేను, “నా జీవిత సగభాగంలో</para>
  <para style="q2" vid="ISA 38:10">నేను మరణ ద్వారం గుండా వెళ్లాలా,</para>
  <para style="q2" vid="ISA 38:10">నా మిగిలిన జీవితకాలమంతా పొగొట్టుకున్నానా?”<verse eid="ISA 38:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 38:11"/>నేను, “సజీవుల దేశంలో</para>
  <para style="q2" vid="ISA 38:11">నేనిక యెహోవాను చూడలేను;</para>
  <para style="q1" vid="ISA 38:11">నా తోటి మనుష్యులను చూడలేను</para>
  <para style="q2" vid="ISA 38:11">ఈ లోకంలో ఇప్పుడు నివసించే వారితో ఉండలేను.<verse eid="ISA 38:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 38:12"/>గొర్రెల కాపరి గుడారంలా నా ఇల్లు</para>
  <para style="q2" vid="ISA 38:12">పడవేయబడి నా నుండి తీసివేయబడింది.</para>
  <para style="q1" vid="ISA 38:12">నేతపనివాడు వస్త్రం చుట్టినట్లు నా జీవితాన్ని ముగిస్తున్నాను,</para>
  <para style="q2" vid="ISA 38:12">ఆయన నన్ను మగ్గం నుండి వేరుచేశారు.</para>
  <para style="q2" vid="ISA 38:12">ఒక్క రోజులోనే మీరు నాకు ముగింపు తెచ్చారు.<verse eid="ISA 38:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 38:13"/>ఉదయం వరకు ఓపికగా ఉన్నాను,</para>
  <para style="q2" vid="ISA 38:13">కాని సింహం విరిచినట్లు ఆయన నా ఎముకలన్నీ విరిచారు;</para>
  <para style="q2" vid="ISA 38:13">పగలు రాత్రి మీరు నా ముగింపు తెచ్చారు.<verse eid="ISA 38:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 38:14"/>కొంగలా చిన్న పిట్టలా నేను కిచకిచ అరిచాను,</para>
  <para style="q2" vid="ISA 38:14">దుఃఖపడే పావురంలా మూలిగాను</para>
  <para style="q1" vid="ISA 38:14">ఆకాశాల వైపు చూసి నా కళ్లు అలసిపోయాయి.</para>
  <para style="q2" vid="ISA 38:14">నేను బెదిరిపోయాను; ప్రభువా, నాకు సహాయం చేయండి.”<verse eid="ISA 38:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 38:15"/>కాని నేనేమి అనగలను?</para>
  <para style="q2" vid="ISA 38:15">ఆయనే నాకు మాట ఇచ్చారు, ఆయనే ఇది నెరవేర్చారు.</para>
  <para style="q1" vid="ISA 38:15">నాకు కలిగిన వేదన బట్టి</para>
  <para style="q2" vid="ISA 38:15">నా సంవత్సరాలన్నీ దీనుడిగా జీవిస్తాను.<verse eid="ISA 38:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 38:16"/>ప్రభువా! వీటి వలన మనుష్యులు జీవిస్తారు.</para>
  <para style="q2" vid="ISA 38:16">వాటిలో కూడా నా ఆత్మకు జీవం దొరుకుతుంది.</para>
  <para style="q1" vid="ISA 38:16">మీరు నాకు ఆరోగ్యాన్ని తిరిగి ఇచ్చారు</para>
  <para style="q2" vid="ISA 38:16">నన్ను జీవింపచేశారు.<verse eid="ISA 38:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 38:17"/>నేను అనుభవించిన ఈ వేదన</para>
  <para style="q2" vid="ISA 38:17">ఖచ్చితంగా నాకు నెమ్మది కలగడానికే.</para>
  <para style="q1" vid="ISA 38:17">మీ ప్రేమతో నా ప్రాణాన్ని</para>
  <para style="q2" vid="ISA 38:17">నాశనం అనే గోతినుండి విడిపించారు;</para>
  <para style="q1" vid="ISA 38:17">నా పాపాలన్నిటిని</para>
  <para style="q2" vid="ISA 38:17">మీ వెనుక పారవేశారు.<verse eid="ISA 38:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 38:18"/>ఎందుకంటే, సమాధి మిమ్మల్ని స్తుతించలేదు,</para>
  <para style="q2" vid="ISA 38:18">మరణం మీకు స్తుతులు పాడలేదు.</para>
  <para style="q1" vid="ISA 38:18">సమాధిలోనికి వెళ్లేవారు</para>
  <para style="q2" vid="ISA 38:18">మీ నమ్మకత్వం కోసం నిరీక్షించలేరు.<verse eid="ISA 38:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 38:19"/>నేను ఈ రోజు స్తుతిస్తున్నట్లు,</para>
  <para style="q2" vid="ISA 38:19">సజీవులు, సజీవులే కదా మిమ్మల్ని స్తుతిస్తారు;</para>
  <para style="q1" vid="ISA 38:19">తల్లిదండ్రులు తమ పిల్లలకు</para>
  <para style="q2" vid="ISA 38:19">మీ నమ్మకత్వాన్ని తెలియజేస్తారు.<verse eid="ISA 38:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 38:20"/>యెహోవా నన్ను రక్షిస్తారు.</para>
  <para style="q2" vid="ISA 38:20">మనం బ్రతికినన్ని రోజులు</para>
  <para style="q1" vid="ISA 38:20">యెహోవా మందిరంలో</para>
  <para style="q2" vid="ISA 38:20">తంతి వాద్యాలు వాయిస్తూ పాడదాము.<verse eid="ISA 38:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 38:21"/>యెషయా, “అంజూర పండ్ల ముద్ద తయారుచేసి ఆ పుండుకు రాస్తే అతడు బాగుపడతాడు” అన్నాడు.<verse eid="ISA 38:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 38:22"/>హిజ్కియా, “నేను యెహోవా ఆలయానికి వెళ్తాను అనడానికి గుర్తు ఏంటి?” అని అడిగాడు.<verse eid="ISA 38:22"/></para>
  <chapter eid="ISA 38"/>
  <chapter number="39" style="c" sid="ISA 39"/>
  <para style="s1">బబులోను నుండి రాయబారులు</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 39:1"/>ఆ కాలంలో బలదాను కుమారుడును బబులోను రాజైన మర్దూక్-బలదాను హిజ్కియాకు జబ్బుచేసి, తిరిగి కోలుకున్నాడని విని అతనికి ఉత్తరాలు, కానుక పంపాడు. <verse eid="ISA 39:1"/><verse number="2" style="v" sid="ISA 39:2"/>హిజ్కియా సంతోషంగా ఆ రాయబారులను ఆహ్వానించి, వారికి తన భవనంలో ఉన్న ఖజానాలోని వెండి, బంగారం, సుగంధద్రవ్యాలు, ఒలీవనూనెతో సహా ఆయుధాలు, ధనాగారాలలో ఉన్నవన్నీ వారికి చూపించాడు. తన భవనంలో గాని, రాజ్యమంతట్లో గాని హిజ్కియా వారికి చూపించనిదేది లేదు.<verse eid="ISA 39:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 39:3"/>తర్వాత రాజైన హిజ్కియా దగ్గరకు ప్రవక్తయైన యెషయా వెళ్లి, “ఆ మనుష్యులు ఏమి చెప్పారు? ఎక్కడి నుండి నీ దగ్గరకు వచ్చారు?” అని అడిగాడు.</para>
  <para style="p" vid="ISA 39:3">అందుకు హిజ్కియా, “వారు బబులోను అనే దూరదేశం నుండి వచ్చారు” అని జవాబిచ్చాడు.<verse eid="ISA 39:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 39:4"/>“నీ భవనంలో వారు ఏమేమి చూశారు?” అని ప్రవక్త అడిగాడు.</para>
  <para style="p" vid="ISA 39:4">హిజ్కియా, “నా భవనంలో ఉన్నవన్నీ చూశారు. నా ధనాగారంలో ఏదీ దాచకుండా అన్నీ వారికి చూపించాను” అన్నాడు.<verse eid="ISA 39:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 39:5"/>అప్పుడు యెషయా హిజ్కియాతో ఇలా అన్నాడు, “సైన్యాల యెహోవా వాక్కు విను: <verse eid="ISA 39:5"/><verse number="6" style="v" sid="ISA 39:6"/>ఒక సమయం రాబోతుంది, నీ భవనంలో ఉన్నవన్నీ, ఈనాటి వరకు మీ పూర్వికుల కూడబెట్టినవన్నీ బబులోనుకు తీసుకెళ్తారు. ఇక్కడ ఏమీ మిగలదని యెహోవా చెప్తున్నారు. <verse eid="ISA 39:6"/><verse number="7" style="v" sid="ISA 39:7"/>నీకు పుట్టబోయే నీ సంతానంలో కొంతమంది బబులోనుకు కొనిపోబడి బబులోను రాజు యొక్క రాజభవనంలో నపుంసకలుగా అవుతారు.”<verse eid="ISA 39:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 39:8"/>హిజ్కియా యెషయాతో, “నీవు చెప్పిన యెహోవా వాక్కు మంచిదే. నా జీవితకాలంలో సమాధానం సత్యం ఉంటాయి” అని అన్నాడు.<verse eid="ISA 39:8"/></para>
  <chapter eid="ISA 39"/>
  <chapter number="40" style="c" sid="ISA 40"/>
  <para style="s1">దేవుని ప్రజలకు ఆదరణ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 40:1"/>నా ప్రజలను ఓదార్చండి, ఓదార్చండి,</para>
  <para style="q2" vid="ISA 40:1">అని మీ దేవుడు చెప్తున్నారు.<verse eid="ISA 40:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 40:2"/>యెరూషలేముతో ప్రేమగా మాట్లాడండి</para>
  <para style="q2" vid="ISA 40:2">ఆమె యుద్ధకాలం ముగిసిందని</para>
  <para style="q1" vid="ISA 40:2">ఆమె పాపదోషం తీరిపోయిందని</para>
  <para style="q2" vid="ISA 40:2">యెహోవా చేతిలో ఆమె పాపాలన్నిటి కోసం</para>
  <para style="q1" vid="ISA 40:2">రెండింతల ఫలం పొందిందని</para>
  <para style="q2" vid="ISA 40:2">ఆమెకు తెలియజేయండి.<verse eid="ISA 40:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 40:3"/>బిగ్గరగా కేక వేస్తున్న ఒక స్వరం:</para>
  <para style="q1" vid="ISA 40:3">“అరణ్యంలో యెహోవా కోసం</para>
  <para style="q2" vid="ISA 40:3">మార్గాన్ని సిద్ధపరచండి<note caller="+" style="f"><char style="fr" closed="false">40:3 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">అరణ్యంలో కేక వేస్తున్న ఒక స్వరం: “యెహోవా మార్గం సిద్ధపరచండి”</char></note></para>
  <para style="q1" vid="ISA 40:3">ఎడారిలో మన దేవునికి</para>
  <para style="q2" vid="ISA 40:3">రహదారిని సరాళం చేయండి.<verse eid="ISA 40:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 40:4"/>ప్రతి లోయ ఎత్తు చేయబడుతుంది,</para>
  <para style="q2" vid="ISA 40:4">ప్రతి పర్వతం ప్రతి కొండ సమం చేయబడుతుంది;</para>
  <para style="q1" vid="ISA 40:4">వంకర త్రోవ తిన్నగా,</para>
  <para style="q2" vid="ISA 40:4">గరుకు మార్గాలు నున్నగా చేయబడతాయి.<verse eid="ISA 40:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 40:5"/>యెహోవా మహిమ వెల్లడవుతుంది.</para>
  <para style="q2" vid="ISA 40:5">దాన్ని ప్రజలందరు చూస్తారు.</para>
  <para style="q1" vid="ISA 40:5">యెహోవాయే ఇది తెలియజేశారు.”<verse eid="ISA 40:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 40:6"/>“మొరపెట్టు” అని ఒక స్వరం అంటుంది,</para>
  <para style="q2" vid="ISA 40:6">నేను, “నేనేమని మొరపెట్టాలి?” అన్నాను.</para>
  <para style="b" vid="ISA 40:6"/>
  <para style="q1" vid="ISA 40:6">“ప్రజలందరు గడ్డి వంటివారు,</para>
  <para style="q2" vid="ISA 40:6">వారి నమ్మకత్వమంతా పొలంలోని పువ్వు వంటిది.<verse eid="ISA 40:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 40:7"/>గడ్డి వాడిపోతుంది, పువ్వులు రాలిపోతాయి</para>
  <para style="q2" vid="ISA 40:7">ఎందుకంటే యెహోవా తన ఊపిరి వాటి మీద ఊదుతారు.</para>
  <para style="q2" vid="ISA 40:7">నిజంగా ప్రజలు గడ్డిలా ఉన్నారు.<verse eid="ISA 40:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 40:8"/>గడ్డి ఎండిపోతుంది, పువ్వులు వాడిపోతాయి,</para>
  <para style="q2" vid="ISA 40:8">కాని మన దేవుని వాక్యం నిత్యం నిలిచి ఉంటుంది.”<verse eid="ISA 40:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 40:9"/>సువార్త ప్రకటిస్తున్న సీయోనూ,</para>
  <para style="q2" vid="ISA 40:9">ఎత్తైన పర్వతం ఎక్కు.</para>
  <para style="q1" vid="ISA 40:9">సువార్త ప్రకటిస్తున్న యెరూషలేమా,</para>
  <para style="q2" vid="ISA 40:9">నీ గొంత్తెత్తి బలంగా</para>
  <para style="q1" vid="ISA 40:9">భయపడకుండా ప్రకటించు;</para>
  <para style="q2" vid="ISA 40:9">యూదా పట్టణాలకు,</para>
  <para style="q2" vid="ISA 40:9">“ఇదిగో మీ దేవుడు” అని చెప్పు.<verse eid="ISA 40:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 40:10"/>చూడండి, ప్రభువైన యెహోవా శక్తితో వస్తున్నారు,</para>
  <para style="q2" vid="ISA 40:10">తన బలమైన చేతితో పరిపాలిస్తారు.</para>
  <para style="q1" vid="ISA 40:10">చూడండి, ఆయన ఇచ్చే బహుమానం ఆయన దగ్గర ఉంది,</para>
  <para style="q2" vid="ISA 40:10">ఆయన ఇచ్చే ప్రతిఫలం ఆయనను అనుసరిస్తుంది.<verse eid="ISA 40:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 40:11"/>గొర్రెల కాపరిలా ఆయన తన మందను మేపుతారు;</para>
  <para style="q2" vid="ISA 40:11">తన చేతితో గొర్రెపిల్లలను చేర్చుకుని</para>
  <para style="q1" vid="ISA 40:11">తన హృదయానికి ఆనించి వాటిని మోస్తారు;</para>
  <para style="q2" vid="ISA 40:11">పాలిచ్చే గొర్రెలను ఆయన నెమ్మదిగా నడిపిస్తారు.<verse eid="ISA 40:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 40:12"/>తన చేతితో నీటిని కొలిచిన వారెవరు?</para>
  <para style="q2" vid="ISA 40:12">జేనతో ఆకాశాన్ని కొలిచిన వారెవరు?</para>
  <para style="q1" vid="ISA 40:12">భూమిలోని మట్టి అంతటిని బుట్టలో ఉంచిన వాడెవడు?</para>
  <para style="q2" vid="ISA 40:12">త్రాసుతో పర్వతాలను తూచిన వాడెవడు?</para>
  <para style="q2" vid="ISA 40:12">తూనికతో కొండలను తూచిన వాడెవడు?<verse eid="ISA 40:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 40:13"/>యెహోవా ఆత్మను తెలుసుకున్న వారెవరు?</para>
  <para style="q2" vid="ISA 40:13">యెహోవాకు సలహాదారునిగా ఆలోచన చెప్పగలవారెవరు?<verse eid="ISA 40:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 40:14"/>ఎవరి దగ్గర యెహోవా ఆలోచన అడిగారు?</para>
  <para style="q2" vid="ISA 40:14">న్యాయ మార్గాన్ని ఆయనకు నేర్పిన వారెవరు?</para>
  <para style="q1" vid="ISA 40:14">ఆయనకు తెలివిని నేర్పించిన వారెవరు?</para>
  <para style="q2" vid="ISA 40:14">ఆయనకు బుద్ధి మార్గాన్ని చూపించిన వారెవరు?<verse eid="ISA 40:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 40:15"/>నిజంగా దేశాలు చేద నుండి జారే నీటి బిందువుల వంటివి.</para>
  <para style="q2" vid="ISA 40:15">వారు కొలబద్దల మీది ధూళివంటి వారు;</para>
  <para style="q2" vid="ISA 40:15">ఆయన ద్వీపాలను సన్నటి ధూళిలా కొలుస్తారు.<verse eid="ISA 40:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 40:16"/>బలిపీఠపు అగ్నికి లెబానోను చెట్లు సరిపోవు,</para>
  <para style="q2" vid="ISA 40:16">దహనబలికి దాని జంతువులు చాలవు.<verse eid="ISA 40:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 40:17"/>అన్ని దేశాలు ఆయన ముందు వట్టివే;</para>
  <para style="q2" vid="ISA 40:17">ఆయన దృష్టికి అవి విలువలేనివిగా</para>
  <para style="q2" vid="ISA 40:17">శూన్యం కంటే తక్కువగా ఉంటాయి.<verse eid="ISA 40:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 40:18"/>కాబట్టి మీరు ఎవరితో దేవుని పోలుస్తారు?</para>
  <para style="q2" vid="ISA 40:18">ఏ రూపంతో ఆయనను పోలుస్తారు?<verse eid="ISA 40:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 40:19"/>విగ్రహాన్ని ఒక శిల్పి పోతపోస్తాడు,</para>
  <para style="q2" vid="ISA 40:19">కంసాలి దానికి బంగారు రేకులు పొదిగి</para>
  <para style="q2" vid="ISA 40:19">దానికి వెండి గొలుసులు చేస్తాడు.<verse eid="ISA 40:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 40:20"/>అలాంటి విలువైన దానిని అర్పణగా ఇవ్వలేని పేదవారు</para>
  <para style="q2" vid="ISA 40:20">పుచ్చిపోని చెక్కను ఎంచుకుంటారు;</para>
  <para style="q1" vid="ISA 40:20">విగ్రహం కదలకుండా నిలబెట్టడానికి</para>
  <para style="q2" vid="ISA 40:20">వారు నిపుణుడైన పనివానిని వెదుకుతారు.<verse eid="ISA 40:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 40:21"/>మీకు తెలియదా?</para>
  <para style="q2" vid="ISA 40:21">మీరు వినలేదా?</para>
  <para style="q1" vid="ISA 40:21">మొదటి నుండి ఎవరు మీకు చెప్పలేదా?</para>
  <para style="q2" vid="ISA 40:21">భూమి స్థాపించబడడాన్ని బట్టి మీరు గ్రహించలేదా?<verse eid="ISA 40:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 40:22"/>ఆయన భూమండలంపై ఆసీనుడై కూర్చున్నారు.</para>
  <para style="q2" vid="ISA 40:22">ఆయన ముందు ప్రజలు మిడతల్లా ఉన్నారు.</para>
  <para style="q1" vid="ISA 40:22">తెరను విప్పినట్లు ఆయన ఆకాశాన్ని పరిచి</para>
  <para style="q2" vid="ISA 40:22">గుడారం వేసినట్లు ఆయన దానిని నివాస స్థలంగా ఏర్పరిచారు.<verse eid="ISA 40:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 40:23"/>ఆయన రాజులను నిష్ఫలం చేస్తారు</para>
  <para style="q2" vid="ISA 40:23">ఈ లోక పాలకులను ఏమీ లేకుండా చేస్తారు.<verse eid="ISA 40:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 40:24"/>వారు నాటబడిన వెంటనే,</para>
  <para style="q2" vid="ISA 40:24">వారు విత్తబడిన వెంటనే,</para>
  <para style="q2" vid="ISA 40:24">వారి భూమిలో వేరు పారకముందే</para>
  <para style="q1" vid="ISA 40:24">ఆయన వారి మీద ఊదగా వారు వాడిపోతారు.</para>
  <para style="q2" vid="ISA 40:24">సుడిగాలికి పొట్టు ఎగురునట్లు ఆయన వారిని ఎగరగొడతారు.<verse eid="ISA 40:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 40:25"/>“నన్ను ఎవరితో పోలుస్తారు?</para>
  <para style="q2" vid="ISA 40:25">నాకు సమానులెవరు?” అని పరిశుద్ధుడైన దేవుడు అడుగుతున్నారు.<verse eid="ISA 40:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 40:26"/>మీ కళ్లు ఎత్తి ఆకాశం వైపు చూడండి:</para>
  <para style="q2" vid="ISA 40:26">వీటన్నటిని సృజించింది ఎవరు?</para>
  <para style="q1" vid="ISA 40:26">నక్షత్ర సమూహాన్ని ఒక్కొక్క దానిని తీసుకువస్తూ,</para>
  <para style="q2" vid="ISA 40:26">వాటి వాటి పేర్ల ప్రకారం పిలిచేవాడే గదా.</para>
  <para style="q1" vid="ISA 40:26">తన గొప్ప శక్తినిబట్టి, తనకున్న శక్తివంతమైన బలాన్నిబట్టి</para>
  <para style="q2" vid="ISA 40:26">వాటిలో ఏ ఒక్క దానిని విడిచిపెట్టలేదు.<verse eid="ISA 40:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 40:27"/>యాకోబూ, “నా త్రోవ యెహోవాకు మరుగై ఉంది;</para>
  <para style="q2" vid="ISA 40:27">నా న్యాయాన్ని నా దేవుడు పట్టించుకోలేదు” అని</para>
  <para style="q1" vid="ISA 40:27">నీవెందుకు అంటున్నావు?</para>
  <para style="q2" vid="ISA 40:27">ఇశ్రాయేలూ, నీవెందుకు ఇలా చెప్తున్నావు?<verse eid="ISA 40:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 40:28"/>నీకు తెలియదా?</para>
  <para style="q2" vid="ISA 40:28">నీవు వినలేదా?</para>
  <para style="q1" vid="ISA 40:28">భూమి అంచులను సృష్టించిన</para>
  <para style="q2" vid="ISA 40:28">యెహోవా నిత్యుడైన దేవుడు.</para>
  <para style="q1" vid="ISA 40:28">ఆయన సొమ్మసిల్లరు, అలసిపోరు,</para>
  <para style="q2" vid="ISA 40:28">ఆయన జ్ఞానాన్ని ఎవరూ గ్రహించలేరు.<verse eid="ISA 40:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 40:29"/>ఆయన అలిసిపోయిన వారికి బలమిస్తారు</para>
  <para style="q2" vid="ISA 40:29">శక్తిలేనివారికి శక్తిని ఇస్తారు.<verse eid="ISA 40:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="ISA 40:30"/>యువత సొమ్మసిల్లి అలసిపోతారు,</para>
  <para style="q2" vid="ISA 40:30">యువకులు తడబడి పడిపోతారు.<verse eid="ISA 40:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="ISA 40:31"/>కాని యెహోవా కోసం ఎదురు చూసేవారు,</para>
  <para style="q2" vid="ISA 40:31">నూతన బలాన్ని పొందుతారు.</para>
  <para style="q1" vid="ISA 40:31">వారు గ్రద్ద వలె రెక్కలు చాచి పైకి ఎగురుతారు;</para>
  <para style="q2" vid="ISA 40:31">అలసిపోకుండా పరుగెత్తుతారు.</para>
  <para style="q2" vid="ISA 40:31">సొమ్మసిల్లకుండా నడుస్తారు.<verse eid="ISA 40:31"/></para>
  <chapter eid="ISA 40"/>
  <chapter number="41" style="c" sid="ISA 41"/>
  <para style="s1">ఇశ్రాయేలు సహాయకుడు</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 41:1"/>ద్వీపాల్లారా, నా ఎదుట మౌనంగా ఉండండి!</para>
  <para style="q2" vid="ISA 41:1">దేశాలు తమ బలాన్ని నూతన పరచుకోవాలి!</para>
  <para style="q1" vid="ISA 41:1">వారు ముందుకు వచ్చి మాట్లాడాలి;</para>
  <para style="q2" vid="ISA 41:1">తీర్పు తీర్చే స్థలం దగ్గర మనం కలుసుకుందాము.<verse eid="ISA 41:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 41:2"/>“తన సేవ కోసం తూర్పు నుండి ఒకరిని పురికొల్పి</para>
  <para style="q2" vid="ISA 41:2">నీతిలో పిలిచింది ఎవరు?</para>
  <para style="q1" vid="ISA 41:2">ఆయన అతనికి దేశాలు అప్పగిస్తారు</para>
  <para style="q2" vid="ISA 41:2">రాజులను అతని ఎదుట అణచివేస్తారు.</para>
  <para style="q1" vid="ISA 41:2">అతడు తన ఖడ్గంతో వాటిని ధూళిగా చేస్తాడు,</para>
  <para style="q2" vid="ISA 41:2">తన విల్లుతో గాలికి ఎగిరే పొట్టులా మారుస్తాడు.<verse eid="ISA 41:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 41:3"/>అతడు వారిని వెంటాడుతాడు,</para>
  <para style="q2" vid="ISA 41:3">ఇంతకుముందు తాను వెళ్లని దారైనా క్షేమంగా వెళ్తాడు.<verse eid="ISA 41:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 41:4"/>ఎవరు దీనిని ఆలోచించి జరిగించారు?</para>
  <para style="q2" vid="ISA 41:4">మొదటి నుండి తరాలను పిలిచింది ఎవరు?</para>
  <para style="q1" vid="ISA 41:4">యెహోవానైన నేనే; వారిలో మొదటి వారితో ఉంది నేనే,</para>
  <para style="q2" vid="ISA 41:4">చివరి వరకు వారితో ఉండేది నేనే.”<verse eid="ISA 41:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 41:5"/>ద్వీపాలు దానిని చూసి భయపడుతున్నాయి;</para>
  <para style="q2" vid="ISA 41:5">భూమి అంచులు వణుకుతున్నాయి.</para>
  <para style="q1" vid="ISA 41:5">వారు వచ్చి చేరుతున్నారు;<verse eid="ISA 41:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="ISA 41:6"/>వారు ఒకరికొకరు సహాయం చేసుకుంటూ,</para>
  <para style="q2" vid="ISA 41:6">“ధైర్యంగా ఉండండి!” అని ఒకరితో ఒకరు చెప్పుకుంటారు.<verse eid="ISA 41:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 41:7"/>శిల్పి కంసాలివాన్ని ప్రోత్సహిస్తాడు,</para>
  <para style="q2" vid="ISA 41:7">సుత్తితో నునుపు చేసేవాడు,</para>
  <para style="q2" vid="ISA 41:7">“అది బాగుంది” అని అతుకు గురించి చెప్తూ</para>
  <para style="q1" vid="ISA 41:7">దాగిలి మీద కొట్టే వానిని ప్రోత్సహిస్తాడు.</para>
  <para style="q2" vid="ISA 41:7">ఇంకొకడు విగ్రహం కదలకుండా మేకులతో దానిని బిగిస్తాడు.<verse eid="ISA 41:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 41:8"/>“అయితే, నా సేవకుడవైన ఇశ్రాయేలూ,</para>
  <para style="q2" vid="ISA 41:8">నేను ఏర్పరచుకున్న యాకోబూ,</para>
  <para style="q2" vid="ISA 41:8">నా స్నేహితుడైన అబ్రాహాము వారసులారా,<verse eid="ISA 41:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 41:9"/>భూమి అంచుల నుండి నేను మిమ్మల్ని తీసుకువచ్చాను,</para>
  <para style="q2" vid="ISA 41:9">మారుమూల ప్రాంతాల నుండి పిలుచుకున్నాను.</para>
  <para style="q1" vid="ISA 41:9">నేను అన్నాను, ‘నీవు నా సేవకుడవు’;</para>
  <para style="q2" vid="ISA 41:9">నేను నిన్ను ఏర్పరచుకున్నాను, నిన్ను త్రోసివేయలేదు.<verse eid="ISA 41:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 41:10"/>కాబట్టి భయపడకు, నేను నీకు తోడుగా ఉన్నాను;</para>
  <para style="q2" vid="ISA 41:10">దిగులుపడకు, నేను నీ దేవుడను.</para>
  <para style="q1" vid="ISA 41:10">నేను నిన్ను బలపరచి నీకు సహాయం చేస్తాను;</para>
  <para style="q2" vid="ISA 41:10">నీతిగల నా కుడిచేతితో నిన్ను ఆదరిస్తాను.<verse eid="ISA 41:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 41:11"/>“నీ మీద కోప్పడిన వారందరు</para>
  <para style="q2" vid="ISA 41:11">ఖచ్చితంగా సిగ్గుపడి అవమానం పొందుతారు;</para>
  <para style="q1" vid="ISA 41:11">నిన్ను వ్యతిరేకించేవారు</para>
  <para style="q2" vid="ISA 41:11">కనబడకుండా నశించిపోతారు.<verse eid="ISA 41:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 41:12"/>నీ శత్రువుల కోసం నీవు వెదకినా,</para>
  <para style="q2" vid="ISA 41:12">వారు నీకు కనపడరు.</para>
  <para style="q1" vid="ISA 41:12">నీతో యుద్ధం చేసేవారు</para>
  <para style="q2" vid="ISA 41:12">ఏమి లేనివారిగా అవుతారు.<verse eid="ISA 41:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 41:13"/>నీ దేవుడనైన యెహోవాను,</para>
  <para style="q2" vid="ISA 41:13">నేను నీ కుడిచేతిని పట్టుకుని,</para>
  <para style="q1" vid="ISA 41:13">భయపడకు అని</para>
  <para style="q2" vid="ISA 41:13">నేను నీకు సహాయం చేస్తానని చెప్తున్నాను.<verse eid="ISA 41:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 41:14"/>భయపడకు, పురుగులాంటి యాకోబూ!</para>
  <para style="q2" vid="ISA 41:14">కొద్ది మందిగా ఉన్న ఇశ్రాయేలూ, భయపడకు.</para>
  <para style="q1" vid="ISA 41:14">నేను నీకు సహాయం చేస్తాను” అని నీ విమోచకుడు</para>
  <para style="q2" vid="ISA 41:14">ఇశ్రాయేలు పరిశుద్ధ దేవుడైన యెహోవా చెప్తున్నారు.<verse eid="ISA 41:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 41:15"/>“చూడు, నేను నిన్ను పదునుగా ఉండి, అనేకమైన పళ్ళు కలిగిన</para>
  <para style="q2" vid="ISA 41:15">క్రొత్త నూర్చే పలకగా చేస్తాను.</para>
  <para style="q1" vid="ISA 41:15">నీవు పర్వతాలను నూర్చి నలగ్గొడతావు,</para>
  <para style="q2" vid="ISA 41:15">కొండలను పొట్టులా చేస్తావు.<verse eid="ISA 41:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 41:16"/>నీవు వాటిని చెరగగా, గాలికి కొట్టుకుపోతాయి,</para>
  <para style="q2" vid="ISA 41:16">సుడిగాలి వాటిని చెదరగొడుతుంది.</para>
  <para style="q1" vid="ISA 41:16">అయితే నీవు యెహోవాలో సంతోషిస్తావు,</para>
  <para style="q2" vid="ISA 41:16">ఇశ్రాయేలు పరిశుద్ధ దేవుని బట్టి అతిశయపడతావు.<verse eid="ISA 41:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 41:17"/>“పేదవారు, దరిద్రులు నీళ్లు వెదకుతారు</para>
  <para style="q2" vid="ISA 41:17">కాని వారికి నీరు దొరకక</para>
  <para style="q2" vid="ISA 41:17">వారి నాలుకలు దాహంతో ఎండిపోతాయి.</para>
  <para style="q1" vid="ISA 41:17">అయితే, యెహోవానైన నేను వారికి జవాబిస్తాను;</para>
  <para style="q2" vid="ISA 41:17">ఇశ్రాయేలు దేవుడనైన నేను వారిని విడిచిపెట్టను.<verse eid="ISA 41:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 41:18"/>నేను చెట్లులేని ఎత్తు స్థలాల మీద నదులను ప్రవహింపచేస్తాను,</para>
  <para style="q2" vid="ISA 41:18">లోయల మధ్యలో ఊటలు ఉబికేలా చేస్తాను.</para>
  <para style="q1" vid="ISA 41:18">ఎడారిని నీటి మడుగుగా,</para>
  <para style="q2" vid="ISA 41:18">ఎండిపోయిన నేలను ఊటలుగా చేస్తాను.<verse eid="ISA 41:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 41:19"/>నేను ఎడారిలో దేవదారు వృక్షాలు,</para>
  <para style="q2" vid="ISA 41:19">తుమ్మచెట్లు, గొంజిచెట్లు, ఓలీవ చెట్లు నాటుతాను.</para>
  <para style="q1" vid="ISA 41:19">అరణ్యంలో సరళ వృక్షాలను, ఈత చెట్లను,</para>
  <para style="q2" vid="ISA 41:19">నేరేడు చెట్లను కలిపి నాటుతాను.<verse eid="ISA 41:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 41:20"/>అప్పుడు ప్రజలు అది చూసి</para>
  <para style="q2" vid="ISA 41:20">యెహోవా చేయి దీనిని చేసిందని,</para>
  <para style="q1" vid="ISA 41:20">ఇశ్రాయేలు పరిశుద్ధ దేవుడే దీనిని కలుగజేశారని</para>
  <para style="q2" vid="ISA 41:20">తెలుసుకుని స్పష్టంగా గ్రహిస్తారు.<verse eid="ISA 41:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 41:21"/>“మీ వాదన చెప్పండి”</para>
  <para style="q2" vid="ISA 41:21">అని యెహోవా అంటున్నారు.</para>
  <para style="q1" vid="ISA 41:21">“మీ రుజువులు చూపించండి”</para>
  <para style="q2" vid="ISA 41:21">అని యాకోబు రాజు అంటున్నారు.<verse eid="ISA 41:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 41:22"/>“విగ్రహాల్లారా, ఏమి జరుగబోతుందో</para>
  <para style="q2" vid="ISA 41:22">మాకు చెప్పండి.</para>
  <para style="q1" vid="ISA 41:22">గతంలో జరిగిన వాటి గురించి చెప్పండి,</para>
  <para style="q2" vid="ISA 41:22">తద్వారా మేము వాటిని పరిశీలించి</para>
  <para style="q2" vid="ISA 41:22">అవి ఎలా నెరవేరాయో తెలుసుకుంటాము.</para>
  <para style="q1" vid="ISA 41:22">జరుగబోయే సంగతులను మాకు తెలియజేయండి,<verse eid="ISA 41:22"/></para>
  <para style="q2">
    <verse number="23" style="v" sid="ISA 41:23"/>భవిష్యత్తులో ఏమి జరుగబోతుందో చెప్పండి,</para>
  <para style="q2" vid="ISA 41:23">అప్పుడు మీరు దేవుళ్ళని మేము గ్రహిస్తాము.</para>
  <para style="q1" vid="ISA 41:23">మేము దిగులుపడి భయపడేలా</para>
  <para style="q2" vid="ISA 41:23">మేలైనా కీడైనా, ఏదో ఒకటి చేయండి.<verse eid="ISA 41:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 41:24"/>కాని మీరు వట్టివారి కంటే తక్కువవారు</para>
  <para style="q2" vid="ISA 41:24">మీ పనులు ఏమాత్రం విలువలేనివి;</para>
  <para style="q2" vid="ISA 41:24">మిమ్మల్ని కోరుకునేవారు అసహ్యులు.<verse eid="ISA 41:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 41:25"/>“ఉత్తరం వైపు నుండి నేను ఒకడిని రేపుతున్నాను.</para>
  <para style="q2" vid="ISA 41:25">నా పేరిట ప్రార్థించే వాడొకడు సూర్యోదయ దిక్కునుండి వస్తున్నాడు.</para>
  <para style="q1" vid="ISA 41:25">కుమ్మరి మట్టిని త్రొక్కినట్లు</para>
  <para style="q2" vid="ISA 41:25">ఒకడు బురదను త్రొక్కినట్లు అతడు పాలకులను త్రొక్కుతాడు.<verse eid="ISA 41:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 41:26"/>మేము అంగీకరించేలా మొదటి నుండి జరిగిన వాటిని మాకు ఎవరు చెప్పారు?</para>
  <para style="q2" vid="ISA 41:26">‘అతడు చేసింది న్యాయమే’ అని మేము చెప్పేలా గతాన్ని ఎవరు చెప్పారు?</para>
  <para style="q1" vid="ISA 41:26">దాని గురించి చెప్పిన వారెవరూ లేరు,</para>
  <para style="q2" vid="ISA 41:26">దాని గురించి ముందే ఎవరు చెప్పలేదు.</para>
  <para style="q2" vid="ISA 41:26">మీ మాటలు విన్న వారెవరూ లేరు.<verse eid="ISA 41:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 41:27"/>‘చూడండి, వారిక్కడ ఉన్నారు!’</para>
  <para style="q2" vid="ISA 41:27">అని మొదట సీయోనుతో చెప్పింది నేనే.</para>
  <para style="q2" vid="ISA 41:27">యెరూషలేముకు శుభవార్త చెప్పడానికి నేను ఒక దూతను పంపాను.<verse eid="ISA 41:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 41:28"/>నేను చూడగా అక్కడ ఎవరూ లేరు,</para>
  <para style="q2" vid="ISA 41:28">దేవుళ్ళలో సలహా చెప్పడానికి ఎవరూ లేరు,</para>
  <para style="q2" vid="ISA 41:28">నేను వారిని ప్రశ్నిస్తే జవాబు ఇవ్వడానికి ఎవరూ లేరు.<verse eid="ISA 41:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ISA 41:29"/>చూడండి, వారందరు మాయాస్వరూపులే</para>
  <para style="q2" vid="ISA 41:29">వారి క్రియలు మోసమే;</para>
  <para style="q2" vid="ISA 41:29">వారి పోత విగ్రహాలు వట్టి గాలి అవి శూన్యములే.<verse eid="ISA 41:29"/></para>
  <chapter eid="ISA 41"/>
  <chapter number="42" style="c" sid="ISA 42"/>
  <para style="s1">యెహోవా సేవకుడు</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 42:1"/>“ఇదిగో, నేను నిలబెట్టుకునే నా సేవకుడు,</para>
  <para style="q2" vid="ISA 42:1">నేను ఏర్పరచుకున్నవాడు, ఇతని గురించి నేను ఆనందిస్తున్నాను;</para>
  <para style="q1" vid="ISA 42:1">ఇతనిపై నా ఆత్మను ఉంచుతాను.</para>
  <para style="q2" vid="ISA 42:1">ఇతడు దేశాలకు న్యాయం జరిగిస్తాడు.<verse eid="ISA 42:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 42:2"/>అతడు కేకలు వేయడు, అరవడు,</para>
  <para style="q2" vid="ISA 42:2">వీధుల్లో ఆయన స్వరం వినబడనీయడు.<verse eid="ISA 42:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 42:3"/>నలిగిన రెల్లును అతడు విరువడు,</para>
  <para style="q2" vid="ISA 42:3">మసకగా వెలుగుతున్న వత్తిని ఆర్పడు.</para>
  <para style="q1" vid="ISA 42:3">అతడు నమ్మకంగా న్యాయాన్ని చేస్తాడు;<verse eid="ISA 42:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="ISA 42:4"/>భూమి మీద న్యాయాన్ని స్థాపించే వరకు</para>
  <para style="q1" vid="ISA 42:4">అతడు అలసిపోడు నిరుత్సాహపడడు.</para>
  <para style="q2" vid="ISA 42:4">అతని బోధలో ద్వీపాలు నిరీక్షణ కలిగి ఉంటాయి.”<verse eid="ISA 42:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 42:5"/>ఆకాశాలను సృష్టించి వాటిని విశాలపరచి,</para>
  <para style="q1" vid="ISA 42:5">భూమిని దానిలో పుట్టిన సమస్తాన్ని విస్తరింపజేసి,</para>
  <para style="q2" vid="ISA 42:5">దానిపై ఉన్న ప్రజలకు ఊపిరిని,</para>
  <para style="q2" vid="ISA 42:5">దానిపై నడిచే వారికి జీవాన్ని ఇస్తున్న</para>
  <para style="q2" vid="ISA 42:5">దేవుడైన యెహోవా చెప్పే మాట ఇదే:<verse eid="ISA 42:5"/></para>
  <para style="q1">
    <verse number="6-7" style="v" sid="ISA 42:6-7"/>“యెహోవానైన నేను నీతిలో నిన్ను పిలిచాను;</para>
  <para style="q2" vid="ISA 42:6-7">నేను నీ చేయి పట్టుకుంటాను.</para>
  <para style="q1" vid="ISA 42:6-7">గుడ్డివారి కళ్లు తెరవడానికి,</para>
  <para style="q2" vid="ISA 42:6-7">చెరసాలలోని ఖైదీలను విడిపించడానికి,</para>
  <para style="q2" vid="ISA 42:6-7">చీకటి గుహల్లో నివసించేవారిని</para>
  <para style="q1" vid="ISA 42:6-7">బయటకు తీసుకురావడానికి,</para>
  <para style="q2" vid="ISA 42:6-7">నేను నిన్ను కాపాడి ప్రజలకు నిబంధనగా,</para>
  <para style="q2" vid="ISA 42:6-7">యూదేతరులకు వెలుగుగా చేస్తాను.<verse eid="ISA 42:6-7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 42:8"/>“నేనే యెహోవాను. అదే నా పేరు!</para>
  <para style="q2" vid="ISA 42:8">నా మహిమను నేను మరొకరికి ఇవ్వను</para>
  <para style="q2" vid="ISA 42:8">నాకు రావలసిన స్తుతులను విగ్రహాలకు చెందనివ్వను.<verse eid="ISA 42:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 42:9"/>చూడండి, గతంలో చెప్పిన సంగతులు జరిగాయి.</para>
  <para style="q2" vid="ISA 42:9">క్రొత్త సంగతులు నేను తెలియజేస్తున్నాను.</para>
  <para style="q1" vid="ISA 42:9">అవి జరగకముందే</para>
  <para style="q2" vid="ISA 42:9">వాటిని మీకు తెలియజేస్తాను.”<verse eid="ISA 42:9"/></para>
  <para style="s1">యెహోవాకు స్తుతి గీతం</para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 42:10"/>సముద్రయానం చేసేవారలారా, సముద్రంలోని సమస్తమా,</para>
  <para style="q2" vid="ISA 42:10">ద్వీపాల్లారా, వాటిలో నివసించేవారలారా!</para>
  <para style="q1" vid="ISA 42:10">యెహోవాకు క్రొత్త గీతం పాడండి.</para>
  <para style="q2" vid="ISA 42:10">భూమి అంచుల నుండి ఆయనను స్తుతించండి.<verse eid="ISA 42:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 42:11"/>అరణ్యం, దాని పట్టణాలు, తమ స్వరాలు ఎత్తాలి;</para>
  <para style="q2" vid="ISA 42:11">కేదారు నివాస గ్రామాలు సంతోషించాలి.</para>
  <para style="q1" vid="ISA 42:11">సెల ప్రజలు ఆనందంతో పాడాలి;</para>
  <para style="q2" vid="ISA 42:11">పర్వత శిఖరాల నుండి వారు కేకలు వేయాలి.<verse eid="ISA 42:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 42:12"/>వారు యెహోవాకు మహిమ చెల్లించి</para>
  <para style="q2" vid="ISA 42:12">ద్వీపాల్లో ఆయన స్తుతిని ప్రకటించాలి.<verse eid="ISA 42:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 42:13"/>యెహోవా శూరునిలా బయలుదేరతారు</para>
  <para style="q2" vid="ISA 42:13">యోధునిలా ఆయన తన రోషాన్ని రేకెత్తిస్తారు;</para>
  <para style="q1" vid="ISA 42:13">ఆయన హుంకరిస్తూ యుద్ధ నినాదం చేస్తూ,</para>
  <para style="q2" vid="ISA 42:13">తన శత్రువుల మీద గెలుస్తారు.<verse eid="ISA 42:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 42:14"/>“చాలా కాలం నేను మౌనంగా ఉన్నాను,</para>
  <para style="q2" vid="ISA 42:14">నేను నిశ్శబ్దంగా ఉంటూ నన్ను నేను అణచుకున్నాను.</para>
  <para style="q1" vid="ISA 42:14">కాని ఇప్పుడు ప్రసవవేదన పడే స్త్రీలా</para>
  <para style="q2" vid="ISA 42:14">నేను కేకలువేస్తూ, రొప్పుతూ, ఊపిరి పీల్చుకుంటున్నాను.<verse eid="ISA 42:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 42:15"/>పర్వతాలను, కొండలను పాడుచేస్తాను.</para>
  <para style="q2" vid="ISA 42:15">వాటి వృక్ష సంపద అంతటిని ఎండిపోయేలా చేస్తాను;</para>
  <para style="q1" vid="ISA 42:15">నదులను ద్వీపాలుగా చేస్తాను</para>
  <para style="q2" vid="ISA 42:15">మడుగులను ఆరిపోయేలా చేస్తాను.<verse eid="ISA 42:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 42:16"/>గ్రుడ్డివారిని వారికి తెలియని దారుల్లో తీసుకెళ్తాను,</para>
  <para style="q2" vid="ISA 42:16">తెలియని మార్గాల్లో నేను వారిని నడిపిస్తాను.</para>
  <para style="q1" vid="ISA 42:16">వారి ఎదుట చీకటిని వెలుగుగా,</para>
  <para style="q2" vid="ISA 42:16">వంకర దారులను చక్కగా చేస్తాను.</para>
  <para style="q1" vid="ISA 42:16">నేను ఈ కార్యాలు చేస్తాను;</para>
  <para style="q2" vid="ISA 42:16">నేను వారిని విడిచిపెట్టను.<verse eid="ISA 42:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 42:17"/>అయితే చెక్కిన విగ్రహాలను నమ్మినవారు</para>
  <para style="q2" vid="ISA 42:17">ప్రతిమలతో, ‘మీరు మాకు దేవుళ్ళు’ అని చెప్పేవారు,</para>
  <para style="q2" vid="ISA 42:17">చాలా సిగ్గుతో వెనుకకు తిరుగుతారు.<verse eid="ISA 42:17"/></para>
  <para style="s1">గ్రుడ్డి చెవిటి ఇశ్రాయేలు</para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 42:18"/>“చెవిటి వారలారా! వినండి.</para>
  <para style="q2" vid="ISA 42:18">చూడండి, గ్రుడ్డి వారలారా! చూడండి.<verse eid="ISA 42:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 42:19"/>నా సేవకుడు తప్ప మరి ఎవడు గ్రుడ్డివాడు?</para>
  <para style="q2" vid="ISA 42:19">నేను పంపిన దూత కాకుండా మరి ఎవడు చెవిటివాడు?</para>
  <para style="q1" vid="ISA 42:19">నాతో నిబంధన ఉన్నవాని కన్నా ఎవడు గ్రుడ్డివాడు,</para>
  <para style="q2" vid="ISA 42:19">యెహోవా సేవకుడు తప్ప మరి ఎవడు గ్రుడ్డివాడు?<verse eid="ISA 42:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 42:20"/>నీవు చాలా సంగతులను చూశావు,</para>
  <para style="q2" vid="ISA 42:20">కాని నీవు వాటిపై శ్రద్ధ పెట్టవు;</para>
  <para style="q2" vid="ISA 42:20">నీ చెవులు తెరచి ఉన్నాయి, కాని నీవు వినవు.”<verse eid="ISA 42:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 42:21"/>యెహోవా తన నీతిని బట్టి</para>
  <para style="q2" vid="ISA 42:21">తన ధర్మశాస్త్రాన్ని గొప్పగా, మహిమగలదిగా</para>
  <para style="q2" vid="ISA 42:21">చేయడానికి ఇష్టపడ్డారు.<verse eid="ISA 42:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 42:22"/>కాని ఈ ప్రజలు దోచుకోబడి కొల్లగొట్టబడ్డారు,</para>
  <para style="q2" vid="ISA 42:22">వారందరూ గుహల్లో చిక్కుకున్నారు,</para>
  <para style="q2" vid="ISA 42:22">చెరసాలలో దాచబడ్డారు.</para>
  <para style="q1" vid="ISA 42:22">వారు దోచుకోబడ్డారు</para>
  <para style="q2" vid="ISA 42:22">వారిని విడిపించే వారెవరూ లేరు.</para>
  <para style="q1" vid="ISA 42:22">వారు దోపుడు సొమ్ముగా చేయబడ్డారు,</para>
  <para style="q2" vid="ISA 42:22">“వారిని వెనుకకు పంపండి” అని చెప్పేవారు ఎవరూ లేరు.<verse eid="ISA 42:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 42:23"/>మీలో ఎవరు దీనిని వింటారు</para>
  <para style="q2" vid="ISA 42:23">రాబోయే కాలంలో ఎవరు శ్రద్ధ చూపిస్తారు?<verse eid="ISA 42:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 42:24"/>యాకోబును దోపుడు సొమ్ముగా అప్పగించింది,</para>
  <para style="q2" vid="ISA 42:24">ఇశ్రాయేలును దోపిడి చేసేవారికి అప్పగించింది ఎవరు?</para>
  <para style="q1" vid="ISA 42:24">యెహోవా కాదా,</para>
  <para style="q2" vid="ISA 42:24">మేము ఆయనకు వ్యతిరేకంగా పాపం చేసినందుకు కాదా?</para>
  <para style="q1" vid="ISA 42:24">వారు ఆయన మార్గాలను అనుసరించలేదు</para>
  <para style="q2" vid="ISA 42:24">ఆయన ధర్మశాస్త్రానికి లోబడలేదు.<verse eid="ISA 42:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 42:25"/>కాబట్టి ఆయన వారిమీద తన కోపాగ్నిని</para>
  <para style="q2" vid="ISA 42:25">యుద్ధ వినాశనాన్నీ కుమ్మరించారు.</para>
  <para style="q1" vid="ISA 42:25">అది వారి చుట్టూ మంటలతో చుట్టుకుంది,</para>
  <para style="q2" vid="ISA 42:25">అయినా వారు గ్రహించలేదు;</para>
  <para style="q2" vid="ISA 42:25">అది వారిని కాల్చింది, కాని వారు దాన్ని పట్టించుకోలేదు.<verse eid="ISA 42:25"/></para>
  <chapter eid="ISA 42"/>
  <chapter number="43" style="c" sid="ISA 43"/>
  <para style="s1">ఇశ్రాయేలు యొక్క ఏకైక రక్షకుడు</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 43:1"/>అయితే యాకోబూ, నిన్ను సృజించిన యెహోవా</para>
  <para style="q2" vid="ISA 43:1">ఇశ్రాయేలూ, నిన్ను రూపించినవాడు</para>
  <para style="q2" vid="ISA 43:1">ఇలా చెప్తున్నారు:</para>
  <para style="q1" vid="ISA 43:1">“భయపడకు నేను నిన్ను విడిపించాను.</para>
  <para style="q2" vid="ISA 43:1">పేరు పెట్టి నిన్ను పిలిచాను; నీవు నా వాడవు.<verse eid="ISA 43:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 43:2"/>నీవు నీళ్లను దాటుతున్నప్పుడు</para>
  <para style="q2" vid="ISA 43:2">నేను నీతో ఉంటాను;</para>
  <para style="q1" vid="ISA 43:2">నీవు నదులను దాటుతున్నప్పుడు</para>
  <para style="q2" vid="ISA 43:2">అవి నిన్ను ముంచవు.</para>
  <para style="q1" vid="ISA 43:2">నీవు అగ్ని గుండా నడుస్తున్నప్పుడు</para>
  <para style="q2" vid="ISA 43:2">నీవు కాలిపోవు.</para>
  <para style="q2" vid="ISA 43:2">మంటలు నిన్ను కాల్చవు.<verse eid="ISA 43:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 43:3"/>యెహోవానైన నేను నీకు దేవుడను.</para>
  <para style="q2" vid="ISA 43:3">ఇశ్రాయేలు పరిశుద్ధ దేవుడనైన నేను నీ రక్షకుడిని.</para>
  <para style="q1" vid="ISA 43:3">నీ క్రయధనంగా ఈజిప్టును ఇచ్చాను,</para>
  <para style="q2" vid="ISA 43:3">నీకు బదులుగా కూషు సెబాలను ఇచ్చాను.<verse eid="ISA 43:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 43:4"/>నీవు నా దృష్టిలో విలువైనవాడవు, ఘనుడవు కాబట్టి,</para>
  <para style="q2" vid="ISA 43:4">నేను నిన్ను ప్రేమిస్తున్నాను,</para>
  <para style="q1" vid="ISA 43:4">నీకు బదులుగా మనుష్యులను అప్పగిస్తాను</para>
  <para style="q2" vid="ISA 43:4">నీ ప్రాణానికి బదులుగా దేశాలను అప్పగిస్తాను.<verse eid="ISA 43:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 43:5"/>భయపడకు, నేను నీతో ఉన్నాను;</para>
  <para style="q2" vid="ISA 43:5">తూర్పు నుండి నీ సంతానాన్ని తీసుకువస్తాను,</para>
  <para style="q2" vid="ISA 43:5">పడమటి నుండి నిన్ను సమకూరుస్తాను.<verse eid="ISA 43:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 43:6"/>‘వారిని అప్పగించు’ అని ఉత్తరదిక్కుకు,</para>
  <para style="q2" vid="ISA 43:6">‘వారిని ఆపవద్దు’ అని దక్షిణ దిక్కుకు చెప్తాను.</para>
  <para style="q1" vid="ISA 43:6">దూరం నుండి నా కుమారులను</para>
  <para style="q2" vid="ISA 43:6">భూమి అంచుల నుండి నా కుమార్తెలను తీసుకురండి.<verse eid="ISA 43:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 43:7"/>నా పేరుపెట్టబడిన వారందరిని,</para>
  <para style="q2" vid="ISA 43:7">నా మహిమ కోసం నేను సృష్టించిన వారిని,</para>
  <para style="q2" vid="ISA 43:7">నేను రూపించి కలుగజేసిన వారిని తీసుకురండి.”<verse eid="ISA 43:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 43:8"/>కళ్లుండి గ్రుడ్డివారైన వారిని,</para>
  <para style="q2" vid="ISA 43:8">చెవులుండి చెవిటివారైన వారిని తీసుకురండి.<verse eid="ISA 43:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 43:9"/>సర్వ దేశాలు గుమికూడాలి</para>
  <para style="q2" vid="ISA 43:9">జనములు సమావేశమవ్వాలి.</para>
  <para style="q1" vid="ISA 43:9">వారిలో ఎవరి దేవుళ్ళు ఇలాంటి సంగతులు మాకు తెలియజేశారు?</para>
  <para style="q2" vid="ISA 43:9">గతంలో జరిగిన వాటిని ఎవరు మాకు చెప్పారు?</para>
  <para style="q1" vid="ISA 43:9">తాము నిర్దోషులని నిరూపించడానికి తమ సాక్షులను తీసుకురావాలి,</para>
  <para style="q2" vid="ISA 43:9">అప్పుడు ఇతరులు విని, “ఇది నిజమే” అని చెప్తారు.<verse eid="ISA 43:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 43:10"/>“మీరు నా సాక్షులు” అని యెహోవా చెప్తున్నారు,</para>
  <para style="q2" vid="ISA 43:10">“నేను ఏర్పరచుకున్న నా సేవకుడవు,</para>
  <para style="q1" vid="ISA 43:10">తద్వారా నీవు నన్ను తెలుసుకొని, నన్ను నమ్మి,</para>
  <para style="q2" vid="ISA 43:10">నేనే ఆయననని నీవు గ్రహిస్తావు.</para>
  <para style="q1" vid="ISA 43:10">నాకు ముందుగా ఏ దేవుడు లేడు.</para>
  <para style="q2" vid="ISA 43:10">నా తర్వాత ఏ దేవుడు ఉండడు.<verse eid="ISA 43:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 43:11"/>నేను నేనే యెహోవాను,</para>
  <para style="q2" vid="ISA 43:11">నేను తప్ప వేరొక రక్షకుడు లేడు.<verse eid="ISA 43:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 43:12"/>బయలుపరిచింది రక్షించింది ప్రకటించింది నేనే</para>
  <para style="q2" vid="ISA 43:12">మీ మధ్య ఉన్నది నేనే, ఏ ఇతర దేవుడో కాదు.</para>
  <para style="q1" vid="ISA 43:12">నేనే దేవుడను మీరు నా సాక్షులు” అని యెహోవా ప్రకటిస్తున్నారు.<verse eid="ISA 43:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="ISA 43:13"/>“అవును, పూర్వ రోజులనుండి ఉన్నవాడను నేనే.</para>
  <para style="q1" vid="ISA 43:13">నా చేతిలో నుండి ఎవరు విడిపించలేరు.</para>
  <para style="q2" vid="ISA 43:13">నేను చేసే పనిని తిప్పగలవారు ఎవరు?”</para>
  <para style="q2" vid="ISA 43:13">అని యెహోవా చెప్తున్నారు.<verse eid="ISA 43:13"/></para>
  <para style="s1">దేవుని కరుణ, ఇశ్రాయేలు నమ్మకద్రోహం</para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 43:14"/>ఇశ్రాయేలు పరిశుద్ధ దేవుడు</para>
  <para style="q2" vid="ISA 43:14">మీ విమోచకుడైన యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="ISA 43:14">“మీ కోసం నేను బబులోనుకు సైన్యాన్ని పంపి</para>
  <para style="q2" vid="ISA 43:14">బబులోనీయులందరూ వేటిని బట్టి గర్వించేవారో</para>
  <para style="q2" vid="ISA 43:14">వారిని ఆ ఓడలలో పారిపోయేలా చేస్తాను.<verse eid="ISA 43:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 43:15"/>యెహోవానైన నేనే మీకు పరిశుద్ధ దేవుడను.</para>
  <para style="q2" vid="ISA 43:15">ఇశ్రాయేలును సృజించిన నేనే మీకు రాజును.”<verse eid="ISA 43:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 43:16"/>యెహోవా ఇలా అంటున్నారు:</para>
  <para style="q2" vid="ISA 43:16">సముద్రంలో మార్గాన్ని ఏర్పరచినవాడు,</para>
  <para style="q2" vid="ISA 43:16">గొప్ప జలాల్లో దారిని కలుగజేసినవాడు,<verse eid="ISA 43:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 43:17"/>రథాలను గుర్రాలను,</para>
  <para style="q2" vid="ISA 43:17">సైన్యాన్ని వీరులను రప్పించిన యెహోవా చెప్పే మాట ఇదే</para>
  <para style="q1" vid="ISA 43:17">వారందరు కలిసి పడిపోయారు మరలా ఎప్పటికీ లేవరు,</para>
  <para style="q2" vid="ISA 43:17">ఆరిపోయిన వత్తిలా వారు నిర్మూలించబడతారు:<verse eid="ISA 43:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 43:18"/>“పూర్వ విషయాల్ని మరచిపోండి;</para>
  <para style="q2" vid="ISA 43:18">గత సంగతులను ఆలోచించకండి.<verse eid="ISA 43:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 43:19"/>చూడండి, నేను ఒక క్రొత్త పని చేస్తున్నాను!</para>
  <para style="q2" vid="ISA 43:19">ఇప్పుడే అది మొలకెత్తుతుంది; మీరు దానిని గ్రహించలేదా?</para>
  <para style="q1" vid="ISA 43:19">నేను అరణ్యంలో దారి కలుగజేస్తున్నాను,</para>
  <para style="q2" vid="ISA 43:19">ఎడారిలో నదులు ప్రవహించేలా చేస్తున్నాను.<verse eid="ISA 43:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 43:20"/>నేను ఏర్పరచుకున్న నా ప్రజలు త్రాగడానికి</para>
  <para style="q2" vid="ISA 43:20">అరణ్యంలో నీళ్లు ఇస్తున్నాను</para>
  <para style="q1" vid="ISA 43:20">ఎడారిలో నదులు ప్రవహించేలా చేస్తున్నాను కాబట్టి</para>
  <para style="q2" vid="ISA 43:20">అడవి జంతువులు, నక్కలు</para>
  <para style="q1" vid="ISA 43:20">నిప్పుకోళ్లు నన్ను ఘనపరుస్తాయి.<verse eid="ISA 43:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="ISA 43:21"/>వారు నా కోసం నేను నిర్మించుకున్న ప్రజలు,</para>
  <para style="q2" vid="ISA 43:21">వారు నా సుత్తిని ప్రకటిస్తారు.<verse eid="ISA 43:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 43:22"/>“అయినా యాకోబూ, నీవు నాకు మొరపెట్టలేదు.</para>
  <para style="q2" vid="ISA 43:22">ఇశ్రాయేలూ, నా గురించి నీవు విసిగిపోయావు.<verse eid="ISA 43:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 43:23"/>దహనబలులకు గొర్రెలను నా దగ్గరకు తీసుకురాలేదు,</para>
  <para style="q2" vid="ISA 43:23">నీ బలులతో నన్ను ఘనపరచలేదు.</para>
  <para style="q1" vid="ISA 43:23">భోజనార్పణల కోసం నేను నీ మీద భారం మోపలేదు</para>
  <para style="q2" vid="ISA 43:23">ధూపం వేయమని నిన్ను విసిగించలేదు.<verse eid="ISA 43:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 43:24"/>నీవు నా కోసం సువాసనగల లవంగపు చెక్కను డబ్బుతో కొనలేదు,</para>
  <para style="q2" vid="ISA 43:24">నీ బలి పశువుల క్రొవ్వుతో నన్ను తృప్తిపరచలేదు.</para>
  <para style="q1" vid="ISA 43:24">కాని నీ పాపాలతో నన్ను విసిగించావు</para>
  <para style="q2" vid="ISA 43:24">నీ దోషాలతో నేను అలసిపోయేలా చేశావు.<verse eid="ISA 43:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 43:25"/>“నేను నేనే నా ఇష్టానుసారంగా</para>
  <para style="q2" vid="ISA 43:25">నీ పాపాలను తుడిచివేస్తున్నాను,</para>
  <para style="q2" vid="ISA 43:25">నీ పాపాలను జ్ఞాపకం చేసుకోను.<verse eid="ISA 43:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 43:26"/>నాకు గతంలో జరిగింది గుర్తు చేయి</para>
  <para style="q2" vid="ISA 43:26">మనం కలిసి వాదించుకుందాం;</para>
  <para style="q2" vid="ISA 43:26">నిన్ను నీవు నీతిమంతునిగా రుజువు చేసుకో.<verse eid="ISA 43:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 43:27"/>నీ మూలపురుషుడు పాపం చేశాడు;</para>
  <para style="q2" vid="ISA 43:27">నీకు బోధించమని నేను పంపినవారు నా మీద తిరుగుబాటు చేశారు.<verse eid="ISA 43:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 43:28"/>కాబట్టి నేను నీ మందిరంలోని ప్రధానులను అవమానించాను;</para>
  <para style="q2" vid="ISA 43:28">నేను యాకోబును నాశనానికి<note caller="+" style="f"><char style="fr" closed="false">43:28 </char><char style="ft" closed="false">ఇక్కడ హెబ్రీ పదం వస్తువులను లేదా వ్యక్తులను తిరిగి మార్చుకోలేని విధంగా యెహోవాకు అప్పగించడాన్ని సూచిస్తుంది, తరచుగా వాటిని పూర్తిగా నాశనం చేయడమే.</char></note></para>
  <para style="q2" vid="ISA 43:28">ఇశ్రాయేలును దూషణకు అప్పగించాను.<verse eid="ISA 43:28"/></para>
  <chapter eid="ISA 43"/>
  <chapter number="44" style="c" sid="ISA 44"/>
  <para style="s1">ఏర్పరచుకోబడ్డ ఇశ్రాయేలు</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 44:1"/>“అయితే నా సేవకుడవైన యాకోబూ,</para>
  <para style="q2" vid="ISA 44:1">నేను ఏర్పరచుకున్న ఇశ్రాయేలూ, విను.<verse eid="ISA 44:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 44:2"/>నిన్ను పుట్టించి, గర్భంలో నిన్ను నిర్మించి</para>
  <para style="q2" vid="ISA 44:2">నీకు సహాయం చేసేవాడైన</para>
  <para style="q2" vid="ISA 44:2">యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="ISA 44:2">నా సేవకుడవైన యాకోబూ,</para>
  <para style="q2" vid="ISA 44:2">నేను ఏర్పరచుకున్న యెషూరూను<note caller="+" style="f"><char style="fr" closed="false">44:2 </char><char style="fq" closed="false">యెషూరూను </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">యథార్థవంతుడు, </char><char style="ft" closed="false">అంటే, ఇశ్రాయేలు</char></note> భయపడకు.<verse eid="ISA 44:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 44:3"/>నేను దాహంతో ఉన్న దేశం మీద నీళ్లు,</para>
  <para style="q2" vid="ISA 44:3">ఎండిన భూమి మీద నీటి ప్రవాహాలను కుమ్మరిస్తాను.</para>
  <para style="q1" vid="ISA 44:3">నీ సంతానంపై నా ఆత్మను,</para>
  <para style="q2" vid="ISA 44:3">నీ వారసులపై నా ఆశీర్వాదాలను కుమ్మరిస్తాను.<verse eid="ISA 44:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 44:4"/>వారు మైదానంలో గడ్డిలా పెరుగుతారు,</para>
  <para style="q2" vid="ISA 44:4">నీటికాలువల దగ్గర నాటిన నిరవంజి చెట్లలా ఎదుగుతారు.<verse eid="ISA 44:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 44:5"/>కొంతమంది, ‘నేను యెహోవా వాడను’ అని అంటారు;</para>
  <para style="q2" vid="ISA 44:5">ఇతరులు యాకోబు పేరుతో తమను తాము పిలుచుకుంటారు;</para>
  <para style="q1" vid="ISA 44:5">ఇంకా కొందరు తమ చేతిపై ‘యెహోవా వారము’ అని రాసుకుని</para>
  <para style="q2" vid="ISA 44:5">ఇశ్రాయేలు పేరును పెట్టుకుంటారు.<verse eid="ISA 44:5"/></para>
  <para style="s1">విగ్రహాలు కాదు, యెహోవాయే</para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 44:6"/>“ఇశ్రాయేలీయుల రాజు, విమోచకుడు,</para>
  <para style="q2" vid="ISA 44:6">సైన్యాల యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="ISA 44:6">నేను మొదటివాడను చివరివాడను;</para>
  <para style="q2" vid="ISA 44:6">నేను తప్ప ఏ దేవుడు లేడు.<verse eid="ISA 44:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 44:7"/>నాలా ఎవరు ఉన్నారు? అతడు ప్రకటించాలి.</para>
  <para style="q2" vid="ISA 44:7">నేను నా మొదటి ప్రజలను నియమించినప్పటి నుండి ఏమి జరిగిందో,</para>
  <para style="q1" vid="ISA 44:7">ఇంకా ఏమి జరగబోతుందో</para>
  <para style="q2" vid="ISA 44:7">అతడు తెలియజేయాలి, నా ముందు ఉంచాలి.</para>
  <para style="q2" vid="ISA 44:7">అవును ఏమి జరగబోతుందో వారు తెలియజేయాలి.<verse eid="ISA 44:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 44:8"/>మీరు బెదరకండి, భయపడకండి.</para>
  <para style="q2" vid="ISA 44:8">చాలా కాలం క్రితం నేను ఈ విషయం చెప్పి మీకు ప్రకటించలేదా?</para>
  <para style="q1" vid="ISA 44:8">మీరే నాకు సాక్షులు. నేను తప్ప వేరొక దేవుడున్నాడా?</para>
  <para style="q2" vid="ISA 44:8">నేను తప్ప, ఆశ్రయ దుర్గమేదీ లేదు. ఉన్నట్లు నేనెరుగను.”<verse eid="ISA 44:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 44:9"/>విగ్రహాలను చేసే వారందరు వట్టివారు.</para>
  <para style="q2" vid="ISA 44:9">వారు నిధిగా ఉంచిన వస్తువులు పనికిరానివి.</para>
  <para style="q1" vid="ISA 44:9">వారి కోసం మాట్లాడేవారు గ్రుడ్డివారు;</para>
  <para style="q2" vid="ISA 44:9">వారు తెలివిలేనివారు, వారు సిగ్గుపరచబడతారు.<verse eid="ISA 44:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 44:10"/>ఎందుకు పనికిరాని విగ్రహాన్ని పోతపోసిన</para>
  <para style="q2" vid="ISA 44:10">దానినొక దేవునిగా రూపించేవాడు ఎవడు?<verse eid="ISA 44:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 44:11"/>అలా చేసే ప్రజలందరూ సిగ్గుపరచబడతారు.</para>
  <para style="q2" vid="ISA 44:11">ఆ శిల్పకారులు కేవలం మనుష్యులే.</para>
  <para style="q1" vid="ISA 44:11">వారందరు కలిసివచ్చి నిలబడాలి;</para>
  <para style="q2" vid="ISA 44:11">వారు భయానికి గురై సిగ్గుపడతారు.<verse eid="ISA 44:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 44:12"/>కమ్మరి తన పనిముట్టు తీసుకుని</para>
  <para style="q2" vid="ISA 44:12">దానితో నిప్పుల మీద పని చేస్తాడు;</para>
  <para style="q1" vid="ISA 44:12">సుత్తితో విగ్రహానికి రూపిస్తాడు</para>
  <para style="q2" vid="ISA 44:12">తన చేతి బలంతో దానిని తయారుచేస్తాడు.</para>
  <para style="q1" vid="ISA 44:12">అతనికి ఆకలి వేస్తుంది, అతని బలం తగ్గిపోతుంది.</para>
  <para style="q2" vid="ISA 44:12">అతడు నీళ్లు త్రాగడు, సొమ్మసిల్లిపోతాడు.<verse eid="ISA 44:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 44:13"/>వడ్రంగి నూలు త్రాడుతో కొలతలు వేసి</para>
  <para style="q2" vid="ISA 44:13">రూపం యొక్క రూపురేఖలను గుర్తిస్తాడు;</para>
  <para style="q1" vid="ISA 44:13">అతడు ఉలితో దానిని చెక్కి</para>
  <para style="q2" vid="ISA 44:13">దిక్సూచితో గుర్తులు పెడతాడు.</para>
  <para style="q1" vid="ISA 44:13">క్షేత్రంలో అది ఉండడానికి</para>
  <para style="q2" vid="ISA 44:13">దానికి నర రూపాన్ని ఇచ్చి</para>
  <para style="q2" vid="ISA 44:13">నర సౌందర్యం కలదానిగా తయారుచేస్తాడు.<verse eid="ISA 44:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 44:14"/>అతడు దేవదారు చెట్లను నరుకుతాడు</para>
  <para style="q2" vid="ISA 44:14">సరళ వృక్షాన్ని గాని సింధూర వృక్షాన్ని గాని తీసుకుంటాడు.</para>
  <para style="q1" vid="ISA 44:14">అతడు అడవి చెట్ల మధ్యలో దానిని ఎదిగేటట్లు చేస్తాడు,</para>
  <para style="q2" vid="ISA 44:14">దేవదారు చెట్టు నాటుతాడు, వర్షం దానిని పెంచుతుంది.<verse eid="ISA 44:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 44:15"/>ఒక మనుష్యుడు దాని కట్టెలను మంట పెట్టడానికి ఉపయోగిస్తాడు;</para>
  <para style="q2" vid="ISA 44:15">అతడు ఆ కట్టెలలో కొన్ని తీసుకుని చలి కాచుకుంటాడు,</para>
  <para style="q2" vid="ISA 44:15">అవే కట్టెలతో అతడు నిప్పు రాజేసి రొట్టె కాల్చుకుంటాడు.</para>
  <para style="q1" vid="ISA 44:15">మిగిలిన కర్రతో ఒక దేవున్ని చేసికొని దానిని పూజిస్తాడు;</para>
  <para style="q2" vid="ISA 44:15">దానితో ఒక విగ్రహాన్ని చేసి దానికి నమస్కారం చేస్తాడు.<verse eid="ISA 44:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 44:16"/>సగం కట్టెలను నిప్పుతో కాల్చి</para>
  <para style="q2" vid="ISA 44:16">ఆ కట్టెల మీద తన ఆహారం వండుకుంటాడు.</para>
  <para style="q2" vid="ISA 44:16">దానిపై అతడు మాంసం వండుకుని తృప్తిగా తింటాడు.</para>
  <para style="q1" vid="ISA 44:16">అంతేకాదు, అతడు చలి కాచుకుంటూ,</para>
  <para style="q2" vid="ISA 44:16">“ఆహా! నాకు వెచ్చగా ఉంది; నాకు మంట కనబడుతుంది” అని అనుకుంటాడు.<verse eid="ISA 44:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 44:17"/>మిగిలిన దానితో అతడు తనకు దేవునిగా ఒక విగ్రహాన్ని చేసుకుంటాడు.</para>
  <para style="q2" vid="ISA 44:17">అతడు దానికి నమస్కారం చేసి పూజిస్తాడు.</para>
  <para style="q1" vid="ISA 44:17">“నీవే నా దేవుడవు! నన్ను రక్షించు!”</para>
  <para style="q2" vid="ISA 44:17">అని దానికి ప్రార్థిస్తాడు.<verse eid="ISA 44:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 44:18"/>ఈ మనుష్యులకు ఏమీ తెలియదు, దేన్ని గ్రహించరు;</para>
  <para style="q2" vid="ISA 44:18">చూడకుండ వారి కళ్లు కప్పబడ్డాయి,</para>
  <para style="q2" vid="ISA 44:18">గ్రహించకుండా వారి మనస్సులు మూయబడ్డాయి.<verse eid="ISA 44:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 44:19"/>ఎవరూ ఆలోచించడం లేదు,</para>
  <para style="q2" vid="ISA 44:19">“దీనిలో సగం ఇంధనంగా వాడాను;</para>
  <para style="q1" vid="ISA 44:19">దాని నిప్పుల మీద రొట్టె కూడా కాల్చాను,</para>
  <para style="q2" vid="ISA 44:19">నేను మాంసం వండుకుని తిన్నాను.</para>
  <para style="q2" vid="ISA 44:19">నేను మిగిలిన దానితో అసహ్యమైన దానిని చేయాలా?</para>
  <para style="q1" vid="ISA 44:19">నేను చెట్టు మొద్దుకు నమస్కారం చేయాలా?” అని</para>
  <para style="q2" vid="ISA 44:19">ఆలోచించడానికి ఎవరికీ తెలివి గాని వివేచన గాని లేదు.<verse eid="ISA 44:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 44:20"/>అలాంటివాడు బూడిద తింటాడు; మోసపూరితమైన హృదయం అతన్ని దారి తప్పిస్తుంది;</para>
  <para style="q2" vid="ISA 44:20">తనను తాను రక్షించుకోలేడు,</para>
  <para style="q2" vid="ISA 44:20">“నా కుడి చేతిలో ఉన్నది అబద్ధం కాదా?” అని అనలేడు.<verse eid="ISA 44:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 44:21"/>“యాకోబూ, వీటిని గుర్తు చేసుకో,</para>
  <para style="q2" vid="ISA 44:21">ఎందుకంటే, ఇశ్రాయేలు, నీవు నా సేవకుడవు.</para>
  <para style="q1" vid="ISA 44:21">నేను నిన్ను నిర్మించాను, నీవు నా సేవకుడవు;</para>
  <para style="q2" vid="ISA 44:21">ఇశ్రాయేలూ, నేను నిన్ను మరచిపోను.<verse eid="ISA 44:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 44:22"/>మేఘం విడిపోవునట్లు నీ దోషాలను</para>
  <para style="q2" vid="ISA 44:22">ఉదయకాలపు మంచు మబ్బు తొలగిపోయేలా నీ పాపాలను, తుడిచివేశాను.</para>
  <para style="q1" vid="ISA 44:22">నేను నిన్ను విడిపించాను.</para>
  <para style="q2" vid="ISA 44:22">నా దగ్గరకు తిరిగి రా.”<verse eid="ISA 44:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 44:23"/>యెహోవా దీనిని చేశారు కాబట్టి ఆకాశాల్లారా, ఆనందంతో పాడండి;</para>
  <para style="q2" vid="ISA 44:23">భూమి లోతుల్లారా, బిగ్గరగా అరవండి.</para>
  <para style="q1" vid="ISA 44:23">పర్వతాల్లారా, అరణ్యమా,</para>
  <para style="q2" vid="ISA 44:23">నీలో ఉన్న ప్రతి చెట్టు సంగీత నాదం చేయండి.</para>
  <para style="q1" vid="ISA 44:23">యెహోవా యాకోబును విడిపించారు</para>
  <para style="q2" vid="ISA 44:23">ఆయన ఇశ్రాయేలులో తన మహిమను చూపిస్తారు.<verse eid="ISA 44:23"/></para>
  <para style="s1">యెరూషలేము నివాస స్థలంగా మారుట</para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 44:24"/>“నిన్ను గర్భంలో రూపించిన నీ విమోచకుడైన</para>
  <para style="q2" vid="ISA 44:24">యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="b" vid="ISA 44:24"/>
  <para style="q1" vid="ISA 44:24">“యెహోవాను నేనే</para>
  <para style="q2" vid="ISA 44:24">అన్నిటిని సృష్టించాను,</para>
  <para style="q2" vid="ISA 44:24">నేనే ఆకాశాలను విశాలపరిచాను</para>
  <para style="q2" vid="ISA 44:24">నేను నేనే భూమికి ఆకారమిచ్చాను.<verse eid="ISA 44:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 44:25"/>నేనే అబద్ధ ప్రవక్తల సూచనలను భంగం చేస్తాను,</para>
  <para style="q2" vid="ISA 44:25">సోదె చెప్పేవారిని వెర్రివారిగా చేస్తాను.</para>
  <para style="q1" vid="ISA 44:25">జ్ఞానులను వెనుకకు త్రిప్పి</para>
  <para style="q2" vid="ISA 44:25">వారి చదువును వ్యర్థం చేసేది నేనే.<verse eid="ISA 44:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 44:26"/>నా సేవకుని మాటలను స్థిరపరచి</para>
  <para style="q2" vid="ISA 44:26">నా దూతల ఆలోచనను నెరవేర్చేది నేనే.</para>
  <para style="b" vid="ISA 44:26"/>
  <para style="q1" vid="ISA 44:26">“యెరూషలేము నివాస స్థలంగా అవుతుందని</para>
  <para style="q2" vid="ISA 44:26">యూదా పట్టణాలు మరలా కట్టబడతాయని</para>
  <para style="q2" vid="ISA 44:26">వాటిలో పాడైన స్థలాలను బాగుచేయబడతాయని చెప్పాను.<verse eid="ISA 44:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="ISA 44:27"/>నేను నీటి లోతులతో, ‘ఎండిపో,</para>
  <para style="q2" vid="ISA 44:27">నీ ప్రవాహాలను ఎండిపోయేటట్లు చేస్తాను’ అని చెప్పాను.<verse eid="ISA 44:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="ISA 44:28"/>నేను కోరెషు గురించి, ‘అతడు నా కాపరి,</para>
  <para style="q2" vid="ISA 44:28">నా ఇష్టాన్నంతటిని నెరవేరుస్తాడు’ అని చెప్పాను.</para>
  <para style="q1" vid="ISA 44:28">అతడు, ‘యెరూషలేము తిరిగి కట్టబడాలి’ అని</para>
  <para style="q2" vid="ISA 44:28">‘మందిరం పునాదులు వేయబడాలి’ అని చెప్తాడు.”<verse eid="ISA 44:28"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 44"/>
  <chapter number="45" style="c" sid="ISA 45"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 45:1"/>కోరెషు పక్షంగా దేశాలను జయించడానికి</para>
  <para style="q2" vid="ISA 45:1">రాజులను నిరాయుధులుగా చేయడానికి</para>
  <para style="q1" vid="ISA 45:1">అతని ఎదుట ద్వారాలు మూయబడకుండా</para>
  <para style="q2" vid="ISA 45:1">తలుపులు తీయడానికి</para>
  <para style="q1" vid="ISA 45:1">నేను అతని కుడిచేతిని పట్టుకున్నాను.</para>
  <para style="q2" vid="ISA 45:1">తన అభిషిక్తుడైన ఈ కోరెషుతో యెహోవా చెప్పే మాట ఇదే:<verse eid="ISA 45:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 45:2"/>నేను నీకు ముందుగా వెళ్లి</para>
  <para style="q2" vid="ISA 45:2">పర్వతాలను చదును చేస్తాను;</para>
  <para style="q1" vid="ISA 45:2">ఇత్తడి తలుపుల్ని పగలగొట్టి,</para>
  <para style="q2" vid="ISA 45:2">ఇనుప గడియలను విరగ్గొడతాను.<verse eid="ISA 45:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 45:3"/>పేరు పెట్టి నిన్ను పిలిచిన ఇశ్రాయేలు దేవుడనైన యెహోవాను</para>
  <para style="q2" vid="ISA 45:3">నేనేనని నీవు తెలుసుకునేలా</para>
  <para style="q1" vid="ISA 45:3">రహస్య స్థలాల్లో ఉంచిన నిధులను</para>
  <para style="q2" vid="ISA 45:3">దాచబడిన ధనాన్ని నీకిస్తాను.<verse eid="ISA 45:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 45:4"/>నా సేవకుడైన యాకోబు కోసం</para>
  <para style="q2" vid="ISA 45:4">నేను ఏర్పరచుకున్న ఇశ్రాయేలు కోసం</para>
  <para style="q1" vid="ISA 45:4">నేను పేరు పెట్టి నిన్ను పిలిచాను.</para>
  <para style="q2" vid="ISA 45:4">నీవు నన్ను గుర్తించకపోయినా</para>
  <para style="q2" vid="ISA 45:4">నీకు గౌరవ బిరుదు ఇచ్చాను.<verse eid="ISA 45:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 45:5"/>నేను యెహోవాను, వేరే ఏ దేవుడు లేడు;</para>
  <para style="q2" vid="ISA 45:5">నేను తప్ప ఏ దేవుడు లేడు.</para>
  <para style="q1" vid="ISA 45:5">నీవు నన్ను గుర్తించకపోయినా</para>
  <para style="q2" vid="ISA 45:5">నేను నిన్ను బలపరుస్తాను.<verse eid="ISA 45:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 45:6"/>అప్పుడు సూర్యోదయ దిక్కునుండి సూర్యాస్తమయ స్థలం వరకు</para>
  <para style="q2" vid="ISA 45:6">నేను తప్ప ఏ దేవుడు లేడని</para>
  <para style="q1" vid="ISA 45:6">ప్రజలు తెలుసుకుంటారు.</para>
  <para style="q2" vid="ISA 45:6">యెహోవాను నేనే; నేను తప్ప వేరే ఎవరూ లేడు.<verse eid="ISA 45:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 45:7"/>నేను వెలుగును రూపిస్తాను, చీకటిని కలుగజేస్తాను,</para>
  <para style="q2" vid="ISA 45:7">నేను వృద్ధిని తెస్తాను, విపత్తును కలుగజేస్తాను.</para>
  <para style="q2" vid="ISA 45:7">యెహోవానైన నేను వీటన్నిటిని చేస్తాను.<verse eid="ISA 45:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 45:8"/>“పైనున్న ఆకాశాల్లారా, నా నీతిని వర్షింపనివ్వండి;</para>
  <para style="q2" vid="ISA 45:8">మేఘాలు వాటిని క్రిందికి కురిపించాలి.</para>
  <para style="q1" vid="ISA 45:8">భూమి విశాలంగా తెరవాలి,</para>
  <para style="q2" vid="ISA 45:8">రక్షణ మొలవాలి,</para>
  <para style="q1" vid="ISA 45:8">నీతి దానితో కలిసి వర్ధిల్లాలి;</para>
  <para style="q2" vid="ISA 45:8">యెహోవానైన నేను దానిని సృష్టించాను.<verse eid="ISA 45:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 45:9"/>“మట్టి కుండ పెంకులలో ఒక పెంకుగా ఉండి</para>
  <para style="q2" vid="ISA 45:9">తనను చేసినవానితో</para>
  <para style="q2" vid="ISA 45:9">వాదించే వారికి శ్రమ.</para>
  <para style="q1" vid="ISA 45:9">జిగటమన్ను కుమ్మరితో,</para>
  <para style="q2" vid="ISA 45:9">‘నీవు ఏం తయారుచేస్తున్నావు?’ అని అంటుందా?</para>
  <para style="q1" vid="ISA 45:9">అతని పని అతనితో,</para>
  <para style="q2" vid="ISA 45:9">‘కుమ్మరికి నైపుణ్యం లేదు’ అని అంటుందా?<verse eid="ISA 45:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 45:10"/>‘నీవు కన్నది ఏంటి?’</para>
  <para style="q2" vid="ISA 45:10">అని తండ్రితో అనే వానికి,</para>
  <para style="q1" vid="ISA 45:10">‘నీ గర్భంలో పుట్టింది ఏంటి?’</para>
  <para style="q2" vid="ISA 45:10">అని తల్లితో అనే వానికి శ్రమ.<verse eid="ISA 45:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 45:11"/>“ఇశ్రాయేలు పరిశుద్ధ దేవుడు</para>
  <para style="q2" vid="ISA 45:11">దానిని సృష్టించిన యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="ISA 45:11">జరుగబోయే వాటి గురించి,</para>
  <para style="q2" vid="ISA 45:11">నా కుమారుల గురించి నన్ను అడుగుతారా?</para>
  <para style="q2" vid="ISA 45:11">నా చేతిపనుల గురించి నన్నే ఆజ్ఞాపిస్తారా?<verse eid="ISA 45:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 45:12"/>భూమిని కలుగచేసింది</para>
  <para style="q2" vid="ISA 45:12">దాని మీద ఉన్న నరులను సృష్టించింది నేనే.</para>
  <para style="q1" vid="ISA 45:12">నా సొంత చేతులు ఆకాశాలను విశాలపరిచాయి;</para>
  <para style="q2" vid="ISA 45:12">నేను వాటి నక్షత్ర సమూహాలను నడిపిస్తాను.<verse eid="ISA 45:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 45:13"/>నేను నీతిని బట్టి కోరెషును పురికొల్పుతాను:</para>
  <para style="q2" vid="ISA 45:13">అతని మార్గాలన్నీ తిన్నగా చేస్తాను.</para>
  <para style="q1" vid="ISA 45:13">అతడు నా పట్టణాన్ని మరలా కడతాడు</para>
  <para style="q2" vid="ISA 45:13">ఏ వెల ఏ బహుమానం తీసుకోకుండ</para>
  <para style="q1" vid="ISA 45:13">బందీలుగా ఉన్నవారిని అతడు విడిపిస్తాడు</para>
  <para style="q2" vid="ISA 45:13">అని సైన్యాల యెహోవా అన్నారు.”<verse eid="ISA 45:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 45:14"/>యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="ISA 45:14">“ఈజిప్టు సంపాదన, కూషు వ్యాపార లాభాలు,</para>
  <para style="q2" vid="ISA 45:14">పొడవైన సెబాయీయులు;</para>
  <para style="q1" vid="ISA 45:14">నీ దగ్గరకు వచ్చి నీవారవుతారు;</para>
  <para style="q1" vid="ISA 45:14">సంకెళ్ళతో నీ దగ్గరకు వచ్చి</para>
  <para style="q2" vid="ISA 45:14">నీ ఎదుట మోకరిస్తారు.</para>
  <para style="q1" vid="ISA 45:14">‘నిజంగా దేవుడు నీతో ఉన్నారు,</para>
  <para style="q2" vid="ISA 45:14">వేరే ఎవరూ లేరు;</para>
  <para style="q1" vid="ISA 45:14">వేరే ఏ దేవుడు లేడు’ అని</para>
  <para style="q2" vid="ISA 45:14">నీ ఎదుట నమస్కారం చేసి మనవి చేస్తారు.”<verse eid="ISA 45:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 45:15"/>ఇశ్రాయేలు దేవా, రక్షకా, నిశ్చయంగా మీరు</para>
  <para style="q2" vid="ISA 45:15">కనబడకుండా చేసుకున్న దేవుడవు.<verse eid="ISA 45:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 45:16"/>విగ్రహాలను చేసే వారందరు సిగ్గుపడి అవమానపడతారు.</para>
  <para style="q2" vid="ISA 45:16">వారందరు కలిసి అవమానానికి గురవుతారు.<verse eid="ISA 45:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 45:17"/>అయితే యెహోవా వలన ఇశ్రాయేలు</para>
  <para style="q2" vid="ISA 45:17">నిత్యమైన రక్షణ పొందుతుంది;</para>
  <para style="q1" vid="ISA 45:17">మీరు మరలా ఎప్పటికీ</para>
  <para style="q2" vid="ISA 45:17">సిగ్గుపరచబడరు, అవమానం పొందరు.<verse eid="ISA 45:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 45:18"/>యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="ISA 45:18">ఆకాశాలను సృష్టించిన</para>
  <para style="q2" vid="ISA 45:18">యెహోవాయే దేవుడు.</para>
  <para style="q1" vid="ISA 45:18">ఆయన భూమికి ఆకారమిచ్చి</para>
  <para style="q2" vid="ISA 45:18">దానిని స్థిరపరిచారు:</para>
  <para style="q1" vid="ISA 45:18">దానిని శూన్యంగా సృష్టించలేదు కాని,</para>
  <para style="q2" vid="ISA 45:18">నివాస స్థలంగా దానిని చేశారు.</para>
  <para style="q1" vid="ISA 45:18">ఆయన అంటున్నారు:</para>
  <para style="q1" vid="ISA 45:18">“యెహోవాను నేనే</para>
  <para style="q2" vid="ISA 45:18">మరి వేరే ఎవరూ లేరు.<verse eid="ISA 45:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 45:19"/>నేను ఎక్కడో చీకటి దేశంలో నుండి</para>
  <para style="q2" vid="ISA 45:19">రహస్యంగా మాట్లాడలేదు;</para>
  <para style="q1" vid="ISA 45:19">‘వ్యర్థంగా నన్ను వెదకండి’ అని</para>
  <para style="q2" vid="ISA 45:19">యాకోబు సంతానంతో నేను చెప్పలేదు.</para>
  <para style="q1" vid="ISA 45:19">యెహోవానైన నేను సత్యం మాట్లాడతాను;</para>
  <para style="q2" vid="ISA 45:19">నేను యథార్థమైనవే తెలియజేస్తాను.<verse eid="ISA 45:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 45:20"/>“అంతా కలిసి రండి;</para>
  <para style="q2" vid="ISA 45:20">దేశాల నుండి తప్పించుకు పారిపోయినవారలారా రండి.</para>
  <para style="q1" vid="ISA 45:20">చెక్క విగ్రహాలను మోస్తూ,</para>
  <para style="q2" vid="ISA 45:20">రక్షించలేని దేవుళ్ళకు మొరపెట్టే వారికి తెలివిలేదు.<verse eid="ISA 45:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 45:21"/>నా సన్నిధిలోకి వచ్చి సంగతులు తెలియజేయండి,</para>
  <para style="q2" vid="ISA 45:21">వారు కలిసి ఆలోచన చేయాలి.</para>
  <para style="q1" vid="ISA 45:21">పూర్వకాలం నుండి దీనిని తెలియజేసింది ఎవరు?</para>
  <para style="q2" vid="ISA 45:21">చాలా కాలం క్రితం దానిని ప్రకటించింది ఎవరు?</para>
  <para style="q1" vid="ISA 45:21">యెహోవానైన నేను కాదా?</para>
  <para style="q2" vid="ISA 45:21">నేను తప్ప వేరొక దేవుడు లేడు.</para>
  <para style="q1" vid="ISA 45:21">నేను నీతిగల దేవుడను, రక్షకుడను;</para>
  <para style="q2" vid="ISA 45:21">నేను తప్ప వేరే ఎవరూ లేరు.<verse eid="ISA 45:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 45:22"/>“భూమి అంచుల్లో నివసించే మీరందరు</para>
  <para style="q2" vid="ISA 45:22">నా వైపు తిరిగి రక్షణ పొందండి;</para>
  <para style="q2" vid="ISA 45:22">నేనే దేవుడను, వేరే ఎవరూ లేరు.<verse eid="ISA 45:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 45:23"/>నా ఎదుట ప్రతి మోకాలు వంగుతుందని</para>
  <para style="q2" vid="ISA 45:23">ప్రతి నాలుక నాతోడని ప్రమాణం చేస్తుందని</para>
  <para style="q2" vid="ISA 45:23">నేను నా పేరిట ప్రమాణం చేశాను.</para>
  <para style="q1" vid="ISA 45:23">నీతిగల నా నోటి నుండి వచ్చిన మాట</para>
  <para style="q2" vid="ISA 45:23">ఏదీ వ్యర్థం కాదు.<verse eid="ISA 45:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 45:24"/>‘యెహోవాలోనే నీతి, బలము’ అని</para>
  <para style="q2" vid="ISA 45:24">ప్రజలు నా గురించి చెప్తారు.”</para>
  <para style="q1" vid="ISA 45:24">ఆయన మీద కోప్పడిన వారందరు</para>
  <para style="q2" vid="ISA 45:24">ఆయన దగ్గరకు వస్తారు, వారు సిగ్గుపరచబడతారు.<verse eid="ISA 45:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 45:25"/>అయితే ఇశ్రాయేలు సంతతివారందరు</para>
  <para style="q2" vid="ISA 45:25">యెహోవాలోనే నీతిమంతులుగా తీర్చబడతారు,</para>
  <para style="q2" vid="ISA 45:25">వారు ఆయనలోనే అతిశయిస్తారు.<verse eid="ISA 45:25"/></para>
  <chapter eid="ISA 45"/>
  <chapter number="46" style="c" sid="ISA 46"/>
  <para style="s1">బబులోను దేవుళ్ళు</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 46:1"/>బేలు మోకరిస్తుంది, నెబో క్రిందికి వంగుతుంది.</para>
  <para style="q2" vid="ISA 46:1">వాటి విగ్రహాలను బరువులు మోసే జంతువులు<note caller="+" style="f"><char style="fr" closed="false">46:1 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">జంతువులు, పశువులు</char></note> మోస్తాయి.</para>
  <para style="q1" vid="ISA 46:1">ఆ బరువైన ప్రతిమలను మోయడం కష్టం,</para>
  <para style="q2" vid="ISA 46:1">అలసిపోయిన పశువులకు భారము.<verse eid="ISA 46:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 46:2"/>అవన్నీ కలిసి వంగి మోకరిస్తాయి;</para>
  <para style="q2" vid="ISA 46:2">ఆ బరువును తప్పించుకోలేక</para>
  <para style="q2" vid="ISA 46:2">అవి కూడా బందీలుగా పట్టుబడతాయి.<verse eid="ISA 46:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 46:3"/>“యాకోబు వారసులారా, నా మాట వినండి,</para>
  <para style="q2" vid="ISA 46:3">ఇశ్రాయేలు ప్రజల్లో మిగిలిన వారలారా, నా మాట వినండి,</para>
  <para style="q1" vid="ISA 46:3">మీ పుట్టుక నుండి నేను మిమ్మల్ని నిలబెట్టాను,</para>
  <para style="q2" vid="ISA 46:3">మీరు పుట్టినప్పటి నుండి నేను మిమ్మల్ని మోసాను.<verse eid="ISA 46:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 46:4"/>మీ వృద్ధాప్యం వరకు, వెంట్రుకలు తెల్లగా అయ్యేవరకు</para>
  <para style="q2" vid="ISA 46:4">నేను, నేనే మిమ్మల్ని నిలబెడతాను.</para>
  <para style="q1" vid="ISA 46:4">నేనే మిమ్మల్ని చేశాను, నేనే మిమ్మల్ని మోస్తాను.</para>
  <para style="q2" vid="ISA 46:4">నేనే మిమ్మల్ని నిలబెడతాను, నేనే మిమ్మల్ని రక్షిస్తాను.<verse eid="ISA 46:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 46:5"/>“మీరు నన్ను ఎవరితో పోలుస్తారు, ఎవరితో సమానంగా ఎంచుతారు?</para>
  <para style="q2" vid="ISA 46:5">నాతో సమానమని ఎవరిని మీరు నాకు పోటీగా ఉంచుతారు?<verse eid="ISA 46:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 46:6"/>కొంతమంది తమ సంచుల నుండి బంగారం కుమ్మరించి</para>
  <para style="q2" vid="ISA 46:6">వెండిని తీసుకువచ్చి బరువు తూచి,</para>
  <para style="q1" vid="ISA 46:6">తమకు దేవున్ని తయారుచేయడానికి కంసాలిని నియమిస్తారు,</para>
  <para style="q2" vid="ISA 46:6">తర్వాత దానికి నమస్కరించి పూజిస్తారు.<verse eid="ISA 46:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 46:7"/>వారు దానిని తమ భుజాలపై ఎత్తుకుని మోస్తారు;</para>
  <para style="q2" vid="ISA 46:7">దాని చోటులో దానిని నిలబెడతారు,</para>
  <para style="q2" vid="ISA 46:7">ఆ చోటు నుండి అది కదల్లేదు.</para>
  <para style="q1" vid="ISA 46:7">ఎవరైనా దానికి మొరపెట్టినా, అది జవాబివ్వలేదు;</para>
  <para style="q2" vid="ISA 46:7">వారి కష్టాల నుండి వారిని రక్షించలేదు.<verse eid="ISA 46:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 46:8"/>“దీనిని జ్ఞాపకం ఉంచుకోండి, మనస్సులో పెట్టుకోండి,</para>
  <para style="q2" vid="ISA 46:8">తిరుగుబాటు చేసే మీరు మీ హృదయంలో పెట్టుకోండి,<verse eid="ISA 46:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 46:9"/>చాలా కాలం క్రితం జరిగిన వాటిని జ్ఞాపకం చేసుకోండి;</para>
  <para style="q2" vid="ISA 46:9">నేనే దేవుడను, వేరే ఎవరూ లేరు;</para>
  <para style="q2" vid="ISA 46:9">నేను దేవుడును, నాలా ఎవరూ లేరు.<verse eid="ISA 46:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 46:10"/>నేనే మొదటి నుండి చివర కలుగబోయే వాటిని ప్రకటిస్తాను.</para>
  <para style="q2" vid="ISA 46:10">పూర్వకాలం నుండి రాబోయే వాటిని తెలియజేస్తాను.</para>
  <para style="q1" vid="ISA 46:10">‘నా ఉద్దేశం నిలబడుతుంది</para>
  <para style="q2" vid="ISA 46:10">నాకు ఏది ఇష్టమో, అదంతా చేస్తాను’ అని నేను చెప్తున్నాను.<verse eid="ISA 46:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 46:11"/>తూర్పు నుండి క్రూరపక్షిని రప్పిస్తాను;</para>
  <para style="q2" vid="ISA 46:11">దూరదేశం నుండి నా ఉద్దేశాన్ని నెరవేర్చే వానిని పిలుస్తాను.</para>
  <para style="q1" vid="ISA 46:11">నేను చెప్పిన దానిని నెరవేరుస్తాను;</para>
  <para style="q2" vid="ISA 46:11">నా ప్రణాళిక ప్రకారం నేను చేస్తాను.<verse eid="ISA 46:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 46:12"/>మొండి హృదయంతో నా నీతికి దూరంగా ఉన్నవారలారా,</para>
  <para style="q2" vid="ISA 46:12">నా మాట వినండి.<verse eid="ISA 46:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 46:13"/>నా నీతిని దగ్గరకు తెస్తున్నాను.</para>
  <para style="q2" vid="ISA 46:13">అది దూరంగా లేదు;</para>
  <para style="q2" vid="ISA 46:13">నా రక్షణ ఆలస్యం కాదు.</para>
  <para style="q1" vid="ISA 46:13">నేను సీయోనుకు రక్షణను</para>
  <para style="q2" vid="ISA 46:13">ఇశ్రాయేలుకు నా వైభవాన్ని ఇస్తున్నాను.<verse eid="ISA 46:13"/></para>
  <chapter eid="ISA 46"/>
  <chapter number="47" style="c" sid="ISA 47"/>
  <para style="s1">బబులోను పతనము</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 47:1"/>“కన్యయైన బబులోను కుమార్తె,</para>
  <para style="q2" vid="ISA 47:1">క్రిందికి దిగి ధూళిలో కూర్చో;</para>
  <para style="q1" vid="ISA 47:1">బబులోనీయుల<note caller="+" style="f"><char style="fr" closed="false">47:1 </char><char style="ft" closed="false">లేదా </char><char style="ft" closed="false">కల్దీయుల</char><char style="ft" closed="false">; <char style="xt" link-href="ISA 47:5"><ref loc="ISA 47:5">5</ref></char> వచనంలో కూడా</char></note> రాణి పట్టణమా, సింహాసనం లేకుండా</para>
  <para style="q2" vid="ISA 47:1">నేల మీద కూర్చో.</para>
  <para style="q1" vid="ISA 47:1">నీవు సున్నితమైన దానవని సుకుమారివని</para>
  <para style="q2" vid="ISA 47:1">ఇకపై పిలువబడవు.<verse eid="ISA 47:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 47:2"/>తిరగలి తీసుకుని పిండి విసురు;</para>
  <para style="q2" vid="ISA 47:2">నీ ముసుగు తీసివేయి.</para>
  <para style="q1" vid="ISA 47:2">లంగాలు పైకెత్తి</para>
  <para style="q2" vid="ISA 47:2">కాలిమీద బట్ట తీసి నదులు దాటు.<verse eid="ISA 47:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 47:3"/>నీ నగ్నత్వం బయటపడుతుంది</para>
  <para style="q2" vid="ISA 47:3">నీ సిగ్గు కనబడుతుంది.</para>
  <para style="q1" vid="ISA 47:3">నేను ప్రతీకారం తీసుకుంటాను;</para>
  <para style="q2" vid="ISA 47:3">నేను ఎవరిని క్షమించను.”<verse eid="ISA 47:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 47:4"/>మన విమోచకుడు ఇశ్రాయేలు పరిశుద్ధ దేవుడు</para>
  <para style="q2" vid="ISA 47:4">ఆయన పేరు సైన్యాల యెహోవా.<verse eid="ISA 47:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 47:5"/>“బబులోనీయుల రాణి పట్టణమా,</para>
  <para style="q2" vid="ISA 47:5">మౌనంగా కూర్చో, చీకటిలోనికి వెళ్లిపో;</para>
  <para style="q1" vid="ISA 47:5">రాజ్యాలకు రాణివని</para>
  <para style="q2" vid="ISA 47:5">ఇకపై నీవు పిలువబడవు.<verse eid="ISA 47:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 47:6"/>నా ప్రజల మీద నేను కోప్పడి</para>
  <para style="q2" vid="ISA 47:6">నా స్వాస్థ్యాన్ని అపవిత్రపరిచాను;</para>
  <para style="q1" vid="ISA 47:6">నేను వారిని నీ చేతికి అప్పగించాను,</para>
  <para style="q2" vid="ISA 47:6">నీవు వారిమీద జాలి చూపలేదు.</para>
  <para style="q1" vid="ISA 47:6">వృద్ధుల మీద కూడా నీవు</para>
  <para style="q2" vid="ISA 47:6">చాలా బరువైన కాడిని ఉంచావు.<verse eid="ISA 47:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 47:7"/>నీవు ‘నేను ఎప్పటికీ</para>
  <para style="q2" vid="ISA 47:7">నిత్య రాణిగా ఉంటాను!’ అని అనుకున్నావు.</para>
  <para style="q1" vid="ISA 47:7">కాని వీటి గురించి ఆలోచించలేదు</para>
  <para style="q2" vid="ISA 47:7">ఏమి జరగబోతుందో తెలుసుకోలేదు.<verse eid="ISA 47:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 47:8"/>“నీవు సుఖాన్ని ప్రేమిస్తూ</para>
  <para style="q2" vid="ISA 47:8">క్షేమంగా జీవిస్తూ,</para>
  <para style="q1" vid="ISA 47:8">‘నేనే ఉన్నాను, నేను తప్ప వేరే ఎవరూ లేరు.</para>
  <para style="q2" vid="ISA 47:8">నేను ఎప్పటికీ విధవరాలిని కాను</para>
  <para style="q1" vid="ISA 47:8">బిడ్డల్ని పోగొట్టుకొని బాధపడను’ అని నీలో నీవు అనుకుంటున్నావు,</para>
  <para style="q2" vid="ISA 47:8">కాని ఇప్పుడు ఈ మాట విను.<verse eid="ISA 47:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 47:9"/>ఒక్క క్షణంలోనే ఒక్క రోజులోనే</para>
  <para style="q2" vid="ISA 47:9">ఈ రెండు నీకు సంభవిస్తాయి:</para>
  <para style="q2" vid="ISA 47:9">బిడ్డల్ని పోగొట్టుకుంటావు విధవరాలిగా మారతావు.</para>
  <para style="q1" vid="ISA 47:9">నీవు చాలా శకునాలు చూసినా,</para>
  <para style="q2" vid="ISA 47:9">అనేక కర్ణపిశాచ తంత్రాల మీద ఆధారపడినా</para>
  <para style="q2" vid="ISA 47:9">ఈ విషాదాలు నీ మీదికి పూర్తిగా వస్తాయి.<verse eid="ISA 47:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 47:10"/>నీ చెడుతనాన్ని నీవు నమ్ముకుని</para>
  <para style="q2" vid="ISA 47:10">‘ఎవరూ నన్ను చూడరు’ అని అనుకున్నావు.</para>
  <para style="q1" vid="ISA 47:10">‘నేనే, నేను తప్ప వేరే ఎవరూ లేరు’</para>
  <para style="q2" vid="ISA 47:10">అని నీకు నీవు అనుకున్నప్పుడు</para>
  <para style="q2" vid="ISA 47:10">నీ జ్ఞానం నీ తెలివి నిన్ను తప్పుదారి పట్టించాయి.<verse eid="ISA 47:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 47:11"/>విపత్తు నీ మీదికి వస్తుంది,</para>
  <para style="q2" vid="ISA 47:11">దానిని మాయాజాలంతో ఎలా పోగొట్టాలో నీవు తెలుసుకోలేవు.</para>
  <para style="q1" vid="ISA 47:11">ఒక కీడు నీ మీద పడుతుంది</para>
  <para style="q2" vid="ISA 47:11">దానిని నీవు డబ్బుతో నివారించలేవు;</para>
  <para style="q1" vid="ISA 47:11">నీకు తెలియని నాశనం</para>
  <para style="q2" vid="ISA 47:11">నీ మీదికి అకస్మాత్తుగా వస్తుంది.<verse eid="ISA 47:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 47:12"/>“నీ చిన్నప్పటి నుండి నీవు కష్టపడి నేర్చుకున్న</para>
  <para style="q2" vid="ISA 47:12">నీ కర్ణపిశాచ తంత్రాలను</para>
  <para style="q2" vid="ISA 47:12">నీ విస్తారమైన శకునాలను ప్రయోగించుకో</para>
  <para style="q1" vid="ISA 47:12">బహుశ నీవు విజయం సాధిస్తావేమో,</para>
  <para style="q2" vid="ISA 47:12">బహుశ నీవు భయం కలిగించగలవేమో.<verse eid="ISA 47:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 47:13"/>నీవు తీసుకున్న సలహాలన్నీ విని నీవు అలసిపోయావు.</para>
  <para style="q2" vid="ISA 47:13">నీ జ్యోతిష్యులు, నెలలవారీగా</para>
  <para style="q1" vid="ISA 47:13">రాశి ఫలాలను చెప్పేవారిని రమ్మను,</para>
  <para style="q2" vid="ISA 47:13">నీ మీదికి వచ్చే వాటినుండి నిన్ను వారు రక్షించాలి.<verse eid="ISA 47:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 47:14"/>నిజంగా వారు గడ్డిపరకలా అవుతారు;</para>
  <para style="q2" vid="ISA 47:14">అగ్ని వారిని కాల్చివేస్తుంది.</para>
  <para style="q1" vid="ISA 47:14">అగ్ని జ్వాలల నుండి వారు</para>
  <para style="q2" vid="ISA 47:14">తమను తాము కాపాడుకోలేరు.</para>
  <para style="q1" vid="ISA 47:14">అవి చలికాచుకోవడానికి వాడే నిప్పులు కాదు;</para>
  <para style="q2" vid="ISA 47:14">ఎదురుగా కూర్చుని కాచుకునే అగ్ని కూడా కాదు.<verse eid="ISA 47:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 47:15"/>నీ చిన్నప్పటి నుండి</para>
  <para style="q2" vid="ISA 47:15">నీవు ఎవరి కోసం శ్రమపడ్డావో</para>
  <para style="q2" vid="ISA 47:15">వారంతా నిన్ను నిరాశపరుస్తారు.</para>
  <para style="q1" vid="ISA 47:15">వారంతా తమ తప్పుదారిలో వెళ్లిపోతారు.</para>
  <para style="q2" vid="ISA 47:15">నిన్ను రక్షించగలిగే వారొక్కరూ ఉండడు.<verse eid="ISA 47:15"/></para>
  <chapter eid="ISA 47"/>
  <chapter number="48" style="c" sid="ISA 48"/>
  <para style="s1">మొండిగా ఉన్న ఇశ్రాయేలు</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 48:1"/>“యాకోబు వారసులారా,</para>
  <para style="q2" vid="ISA 48:1">ఇశ్రాయేలు అనే పేరుతో పిలువబడి</para>
  <para style="q2" vid="ISA 48:1">యూదా కుటుంబం నుండి వచ్చే వారలారా వినండి,</para>
  <para style="q1" vid="ISA 48:1">యెహోవా పేరిట ప్రమాణం చేస్తూ</para>
  <para style="q2" vid="ISA 48:1">ఇశ్రాయేలు దేవుని వేడుకుంటూ</para>
  <para style="q2" vid="ISA 48:1">సత్యాన్ని గాని నీతి గాని అనుసరించని వారలారా వినండి.<verse eid="ISA 48:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 48:2"/>మీ గురించి మీరు పరిశుద్ధ పట్టణస్థులమని చెప్పుకుంటూ</para>
  <para style="q2" vid="ISA 48:2">ఇశ్రాయేలు దేవుని మీద ఆధారపడుతున్నామని చెప్పుకుంటున్న మీరు వినండి,</para>
  <para style="q2" vid="ISA 48:2">ఆయన పేరు సైన్యాల యెహోవా:<verse eid="ISA 48:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 48:3"/>గతంలో జరిగిన వాటి గురించి నేను చాలా కాలం క్రితమే చెప్పాను.</para>
  <para style="q2" vid="ISA 48:3">నా నోరు వాటిని ప్రకటించింది నేను వాటిని తెలియజేశాను;</para>
  <para style="q2" vid="ISA 48:3">తర్వాత నేను అకస్మాత్తుగా వాటిని చేయగా అవి జరిగాయి.<verse eid="ISA 48:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 48:4"/>ఎందుకంటే మీరు ఎంత మొండివారో నాకు తెలుసు;</para>
  <para style="q2" vid="ISA 48:4">నీ మెడ నరాలు ఇనుపవని,</para>
  <para style="q2" vid="ISA 48:4">నీ నుదురు ఇత్తడిదని నాకు తెలుసు.<verse eid="ISA 48:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 48:5"/>కాబట్టి వీటి గురించి నేను చాలా కాలం క్రితం చెప్పాను;</para>
  <para style="q2" vid="ISA 48:5">‘నా విగ్రహం ఈ పనులను జరిగించింది</para>
  <para style="q1" vid="ISA 48:5">నేను చెక్కిన ప్రతిమ, నేను పోతపోసిన విగ్రహం వాటిని నియమించాయి’ అని</para>
  <para style="q2" vid="ISA 48:5">నీవు ఎప్పుడూ చెప్పకుండా ఉండేలా</para>
  <para style="q2" vid="ISA 48:5">అవి జరగకముందే నీకు వాటిని ప్రకటించాను.<verse eid="ISA 48:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 48:6"/>నీవు ఈ సంగతులను విన్నావు; వాటన్నిటిని చూడు.</para>
  <para style="q2" vid="ISA 48:6">అవి నిజమని నీవు ఒప్పుకోవా?</para>
  <para style="b" vid="ISA 48:6"/>
  <para style="q1" vid="ISA 48:6">“నీకు తెలియకుండా దాచబడిన</para>
  <para style="q2" vid="ISA 48:6">క్రొత్త విషయాలను ఇకపై నేను నీకు చెప్తాను.<verse eid="ISA 48:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 48:7"/>అవి ఇప్పుడే సృజించినవి, ఎప్పుడో చేసినవి కావు;</para>
  <para style="q2" vid="ISA 48:7">ఈ రోజుకు ముందు నీవు వాటి గురించి వినలేదు.</para>
  <para style="q1" vid="ISA 48:7">అప్పుడు, ‘అవును, వాటి గురించి నాకు తెలుసు’</para>
  <para style="q2" vid="ISA 48:7">అని నీవు చెప్పలేవు.<verse eid="ISA 48:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 48:8"/>నీవు వాటి గురించి వినలేదు, అవి నీకు తెలియదు;</para>
  <para style="q2" vid="ISA 48:8">పూర్వం నుండి నీ చెవులు తెరవబడలేదు.</para>
  <para style="q1" vid="ISA 48:8">నీవు ఎంత ద్రోహివో నాకు తెలుసు;</para>
  <para style="q2" vid="ISA 48:8">నీ పుట్టుక నుండి తిరుగుబాటుదారుడవు.<verse eid="ISA 48:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 48:9"/>నేను నిన్ను పూర్తిగా నాశనం చేయకుండా</para>
  <para style="q2" vid="ISA 48:9">నా నామాన్ని బట్టి నా కోపాన్ని ఆపుకున్నాను;</para>
  <para style="q2" vid="ISA 48:9">నా కీర్తి కోసం నీ నుండి దానిని నేను నిగ్రహించుకున్నాను.<verse eid="ISA 48:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 48:10"/>చూడు, నేను నిన్ను శుద్ధి చేశాను, కాని వెండిని చేసినట్లు కాదు;</para>
  <para style="q2" vid="ISA 48:10">బాధల కొలిమిలో నిన్ను పరీక్షించాను.<verse eid="ISA 48:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 48:11"/>నా కోసం, నా కొరకే, నేను ఇలా చేస్తాను.</para>
  <para style="q2" vid="ISA 48:11">నా పేరును ఎలా అపవిత్రం చేయనిస్తాను?</para>
  <para style="q2" vid="ISA 48:11">నేను నా మహిమను మరొకరికి ఇవ్వను.<verse eid="ISA 48:11"/></para>
  <para style="s1">ఇశ్రాయేలు విడిపించబడుట</para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 48:12"/>“యాకోబూ, నేను పిలిచిన ఇశ్రాయేలూ,</para>
  <para style="q2" vid="ISA 48:12">నా మాట విను.</para>
  <para style="q1" vid="ISA 48:12">నేనే ఆయనను;</para>
  <para style="q2" vid="ISA 48:12">నేనే మొదటివాడను నేను చివరివాడను.<verse eid="ISA 48:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 48:13"/>నా సొంత చేయి భూమికి పునాదులను వేసింది,</para>
  <para style="q2" vid="ISA 48:13">నా కుడిచేయి ఆకాశాలను విశాలపరిచింది;</para>
  <para style="q1" vid="ISA 48:13">నేను వాటిని పిలిచినప్పుడు</para>
  <para style="q2" vid="ISA 48:13">అవన్నీ కలసి నిలబడతాయి.<verse eid="ISA 48:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 48:14"/>“మీరందరూ కలసి వచ్చి వినండి:</para>
  <para style="q2" vid="ISA 48:14">విగ్రహాలలో ఏది ఈ విషయాలను ముందే చెప్పింది?</para>
  <para style="q1" vid="ISA 48:14">యెహోవా స్నేహితునిగా ఎంచుకున్నవాడు</para>
  <para style="q2" vid="ISA 48:14">ఆయన ఉద్దేశాన్ని బబులోనుకు చేస్తాడు</para>
  <para style="q2" vid="ISA 48:14">ఆయన చేయి బబులోనీయులకు<note caller="+" style="f"><char style="fr" closed="false">48:14 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">కల్దీయులకు </char><char style="ft" closed="false"><char style="xt" link-href="ISA 48:20"><ref loc="ISA 48:20">20</ref></char> వచనంలో కూడా ఉంది</char></note> వ్యతిరేకంగా ఉంటుంది.<verse eid="ISA 48:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 48:15"/>నేను, నేనే చెప్పాను;</para>
  <para style="q2" vid="ISA 48:15">అవును, నేనే అతన్ని పిలిచాను.</para>
  <para style="q1" vid="ISA 48:15">నేను అతన్ని రప్పిస్తాను</para>
  <para style="q2" vid="ISA 48:15">అతడు తన పనిలో విజయం సాధిస్తాడు.<verse eid="ISA 48:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ISA 48:16"/>“నా దగ్గరకు వచ్చి ఈ మాట విను:</para>
  <para style="q1" vid="ISA 48:16">“మొదటి ప్రకటన నుండి నేను రహస్యంగా మాట్లాడలేదు;</para>
  <para style="q2" vid="ISA 48:16">అది జరిగినప్పుడు నేను అక్కడే ఉన్నాను.”</para>
  <para style="b" vid="ISA 48:16"/>
  <para style="q1" vid="ISA 48:16">ఇప్పుడు ప్రభువైన యెహోవా</para>
  <para style="q2" vid="ISA 48:16">తన ఆత్మతో నన్ను పంపారు.<verse eid="ISA 48:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 48:17"/>నీ విమోచకుడు, ఇశ్రాయేలు పరిశుద్ధ దేవుడైన</para>
  <para style="q2" vid="ISA 48:17">యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="ISA 48:17">నీ దేవుడనైన యెహోవాను నేనే,</para>
  <para style="q2" vid="ISA 48:17">నీకు ఏది మంచిదో అది నీకు బోధిస్తాను</para>
  <para style="q2" vid="ISA 48:17">నీవు వెళ్లవలసిన మార్గాన్ని నీకు చూపిస్తాను.<verse eid="ISA 48:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 48:18"/>నీవు నా ఆజ్ఞల పట్ల శ్రద్ధ చూపించి ఉంటే</para>
  <para style="q2" vid="ISA 48:18">నీ సమాధానం నదిలా</para>
  <para style="q2" vid="ISA 48:18">నీ నీతి సముద్రపు అలలుగా ఉండేవి.<verse eid="ISA 48:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 48:19"/>నీ వారసులు ఇసుకలా,</para>
  <para style="q2" vid="ISA 48:19">నీ పిల్లలు లెక్కించలేని రేణువుల్లా ఉండేవారు.</para>
  <para style="q1" vid="ISA 48:19">వారి పేరు ఎప్పటికీ కొట్టివేయబడదు</para>
  <para style="q2" vid="ISA 48:19">ఎప్పుడూ నా ఎదుట నుండి నిర్మూలం కావు.<verse eid="ISA 48:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 48:20"/>బబులోనును విడిచిపెట్టండి.</para>
  <para style="q2" vid="ISA 48:20">బబులోనీయుల నుండి పారిపోండి!</para>
  <para style="q1" vid="ISA 48:20">“యెహోవా తన సేవకుడైన యాకోబును విడిపించారు” అని</para>
  <para style="q2" vid="ISA 48:20">ఆనంద కేకలతో తెలియజేయండి.</para>
  <para style="q1" vid="ISA 48:20">దానిని ప్రకటించండి.</para>
  <para style="q2" vid="ISA 48:20">భూమి అంచుల వరకు దానిని తెలియజేయండి.<verse eid="ISA 48:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 48:21"/>ఎడారుల గుండా ఆయన వారిని నడిపించినా వారికి దాహం వేయలేదు;</para>
  <para style="q2" vid="ISA 48:21">ఆయన వారి కోసం బండ నుండి నీళ్లు ప్రవహించేలా చేశారు.</para>
  <para style="q1" vid="ISA 48:21">ఆయన బండను చీల్చారు,</para>
  <para style="q2" vid="ISA 48:21">నీళ్లు ఉప్పొంగుతూ బయటకు వచ్చాయి.<verse eid="ISA 48:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 48:22"/>“దుర్మార్గులకు నెమ్మది ఉండదు” అని యెహోవా చెప్తున్నారు.<verse eid="ISA 48:22"/></para>
  <chapter eid="ISA 48"/>
  <chapter number="49" style="c" sid="ISA 49"/>
  <para style="s1">యెహోవా సేవకుడు</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 49:1"/>ద్వీపాల్లారా, నా మాట వినండి;</para>
  <para style="q2" vid="ISA 49:1">దూరంగా ఉన్న దేశాల్లారా, ఇది వినండి:</para>
  <para style="q1" vid="ISA 49:1">నేను పుట్టక ముందే యెహోవా నన్ను పిలిచారు.</para>
  <para style="q2" vid="ISA 49:1">నా తల్లి గర్భంలో ఉండగానే ఆయన నా పేరు పలికారు.<verse eid="ISA 49:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 49:2"/>ఆయన నా నోటిని పదునైన ఖడ్గంగా చేశారు,</para>
  <para style="q2" vid="ISA 49:2">తన చేతి నీడలో నన్ను దాచారు;</para>
  <para style="q1" vid="ISA 49:2">నన్ను మెరుగుపెట్టిన బాణంలా చేసి</para>
  <para style="q2" vid="ISA 49:2">తన అంబులపొదిలో నన్ను దాచారు.<verse eid="ISA 49:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 49:3"/>“ఇశ్రాయేలూ, నీవు నా సేవకుడవు.</para>
  <para style="q2" vid="ISA 49:3">నీ ద్వారా నా మహిమను కనుపరుస్తాను” అని ఆయన నాతో చెప్పారు.<verse eid="ISA 49:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 49:4"/>అయితే నేను, “నేను వృధాగా కష్టపడ్డాను;</para>
  <para style="q2" vid="ISA 49:4">ఫలితం లేకుండా నా బలాన్ని ఖర్చు చేశాను</para>
  <para style="q1" vid="ISA 49:4">కాని ఖచ్చితంగా నా తీర్పు యెహోవా దగ్గరే ఉంది,</para>
  <para style="q2" vid="ISA 49:4">నా బహుమానం నా దేవుని దగ్గరే ఉంది” అని అన్నాను.<verse eid="ISA 49:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 49:5"/>యెహోవా దృష్టిలో నేను ఘనపరచబడ్డను</para>
  <para style="q2" vid="ISA 49:5">నా దేవుడే నాకు బలంగా ఉన్నారు</para>
  <para style="q2" vid="ISA 49:5">తన దగ్గరకు యాకోబును తిరిగి రప్పించడానికి</para>
  <para style="q1" vid="ISA 49:5">ఇశ్రాయేలును తన కోసం సమకూర్చడానికి</para>
  <para style="q2" vid="ISA 49:5">తన సేవకునిగా ఉండడానికి నన్ను గర్భంలో నిర్మించిన,</para>
  <para style="q1" vid="ISA 49:5">యెహోవా ఇలా అంటున్నారు:<verse eid="ISA 49:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 49:6"/>ఆయన అంటున్నారు:</para>
  <para style="q1" vid="ISA 49:6">“నీవు యాకోబు గోత్రాలను పునరుద్ధరించడానికి,</para>
  <para style="q2" vid="ISA 49:6">ఇశ్రాయేలులో నేను తప్పించిన వారిని తిరిగి రప్పించడానికి</para>
  <para style="q2" vid="ISA 49:6">నా సేవకునిగా ఉండడం నీకు చాలా చిన్న విషయము.</para>
  <para style="q1" vid="ISA 49:6">నేనిచ్చే రక్షణ భూమి అంచుల వరకు చేరడానికి</para>
  <para style="q2" vid="ISA 49:6">యూదేతర ప్రజలకు వెలుగుగా నేను నిన్ను చేస్తాను.”<verse eid="ISA 49:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 49:7"/>రాజ్యాలచేత త్రోసివేయబడి ద్వేషానికి గురైన</para>
  <para style="q2" vid="ISA 49:7">పాలకుల సేవకునితో</para>
  <para style="q1" vid="ISA 49:7">ఇశ్రాయేలు విమోచకుడును పరిశుద్ధ దేవుడునైన</para>
  <para style="q2" vid="ISA 49:7">యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="ISA 49:7">“యెహోవా నమ్మకమైనవాడు కాబట్టి</para>
  <para style="q2" vid="ISA 49:7">ఇశ్రాయేలు పరిశుద్ధ దేవుడు నిన్ను ఏర్పరచుకున్నారు కాబట్టి</para>
  <para style="q1" vid="ISA 49:7">రాజులు నిన్ను చూసి లేచి నిలబడతారు,</para>
  <para style="q2" vid="ISA 49:7">యువరాజులు చూసి నమస్కారం చేస్తారు.”<verse eid="ISA 49:7"/></para>
  <para style="s1">ఇశ్రాయేలు పునరుద్ధరణ</para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 49:8"/>యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="ISA 49:8">“అనుకూల సమయంలో నేను నీకు జవాబు ఇస్తాను,</para>
  <para style="q2" vid="ISA 49:8">రక్షణ దినాన నేను నీ మీద దయ చూపిస్తాను;</para>
  <para style="q1" vid="ISA 49:8">దేశాన్ని పునరుద్ధరించి</para>
  <para style="q2" vid="ISA 49:8">పాడైన స్వాస్థ్యాలను పంచడానికి</para>
  <para style="q1" vid="ISA 49:8">బంధించబడిన వారితో, ‘బయలుదేరండి’ అని,</para>
  <para style="q2" vid="ISA 49:8">చీకటిలో ఉన్నవారితో ‘బయటికి రండి’ అని చెప్పడానికి,<verse eid="ISA 49:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 49:9"/>నిన్ను కాపాడి</para>
  <para style="q2" vid="ISA 49:9">ప్రజలకు నిబంధనగా నియమిస్తాను.</para>
  <para style="b" vid="ISA 49:9"/>
  <para style="q1" vid="ISA 49:9">“వారు దారి ప్రక్కన తింటారు</para>
  <para style="q2" vid="ISA 49:9">చెట్లులేని కొండలమీద పచ్చిక దొరుకుతుంది.<verse eid="ISA 49:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 49:10"/>వారికి ఆకలి గాని దాహం గాని వేయదు.</para>
  <para style="q2" vid="ISA 49:10">ఎడారి వేడిగాలి గాని, ఎండ గాని వారికి తగలదు.</para>
  <para style="q1" vid="ISA 49:10">వారిపట్ల దయగలవాడు వారిని తీసుకెళ్లి</para>
  <para style="q2" vid="ISA 49:10">నీటి ఊటల ప్రక్క వారిని నడిపిస్తాడు.<verse eid="ISA 49:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 49:11"/>నా పర్వతాలన్నిటిని దారులుగా చేస్తాను</para>
  <para style="q2" vid="ISA 49:11">నా రహదారులు ఎత్తు చేయబడతాయి.<verse eid="ISA 49:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 49:12"/>చూడండి, వారు దూరం నుండి వస్తారు</para>
  <para style="q2" vid="ISA 49:12">కొందరు ఉత్తరం నుండి కొందరు పడమటి నుండి,</para>
  <para style="q2" vid="ISA 49:12">కొందరు సీనీయుల<note caller="+" style="f"><char style="fr" closed="false">49:12 </char><char style="ft" closed="false">కొ.ప్ర.లలో </char><char style="fqa" closed="false">అశ్వాను</char></note> దేశం నుండి వస్తారు.”<verse eid="ISA 49:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 49:13"/>ఆకాశాల్లారా, ఉత్సాహ ధ్వని చేయండి;</para>
  <para style="q2" vid="ISA 49:13">భూమీ, సంతోషించు;</para>
  <para style="q2" vid="ISA 49:13">పర్వతాల్లారా, ఆనందంతో పాట పాడండి!</para>
  <para style="q1" vid="ISA 49:13">ఎందుకంటే, యెహోవా తన ప్రజలను ఓదారుస్తారు,</para>
  <para style="q2" vid="ISA 49:13">బాధించబడిన తన ప్రజల పట్ల జాలి చూపిస్తారు.<verse eid="ISA 49:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 49:14"/>అయితే సీయోను, “యెహోవా నన్ను విడిచిపెట్టారు.</para>
  <para style="q2" vid="ISA 49:14">ప్రభువు నన్ను మరచిపోయారు” అని అన్నది.<verse eid="ISA 49:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 49:15"/>“తల్లి తన చంటిబిడ్డను మరచిపోతుందా?</para>
  <para style="q2" vid="ISA 49:15">తాను కన్న బిడ్డ మీద జాలిపడకుండ ఉంటుందా?</para>
  <para style="q1" vid="ISA 49:15">తల్లియైన మరచిపోవచ్చు కాని</para>
  <para style="q2" vid="ISA 49:15">నేను నిన్ను మరవను!<verse eid="ISA 49:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 49:16"/>చూడు, నా అరచేతుల మీద నేను నిన్ను చెక్కుకున్నాను;</para>
  <para style="q2" vid="ISA 49:16">నీ గోడలు నిత్యం నా ఎదుట ఉన్నాయి.<verse eid="ISA 49:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 49:17"/>నీ కుమారులు తొందరగా తిరిగి వస్తారు.</para>
  <para style="q2" vid="ISA 49:17">నిన్ను నాశనం చేసినవారు నీ నుండి వెళ్లిపోతారు.<verse eid="ISA 49:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 49:18"/>నీ కళ్ళెత్తి చుట్టూ చూడు;</para>
  <para style="q2" vid="ISA 49:18">నీ పిల్లలందరు కలిసి నీ దగ్గరకు వస్తున్నారు.</para>
  <para style="q1" vid="ISA 49:18">‘వారందరిని నీవు ఆభరణంగా ధరించుకుంటావు;</para>
  <para style="q2" vid="ISA 49:18">పెళ్ళికుమార్తెలా నీవు వారిని ధరించుకుంటావు.</para>
  <para style="q2" vid="ISA 49:18">నా జీవం తోడని ప్రమాణం చేస్తున్నాను’ అని యెహోవా ప్రకటిస్తున్నారు.<verse eid="ISA 49:18"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 49:19"/>“నీవు నాశనమై నిర్మానుష్యంగా చేయబడినా</para>
  <para style="q2" vid="ISA 49:19">నీ దేశం పాడుబడినా</para>
  <para style="q1" vid="ISA 49:19">నీ భూమి నీ ప్రజలకు ఇరుకుగా ఉంటుంది,</para>
  <para style="q2" vid="ISA 49:19">నిన్ను మ్రింగివేసినవారు దూరంగా ఉంటారు.<verse eid="ISA 49:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 49:20"/>నీవు కోల్పోయిన దుఃఖంలో ఉన్నప్పుడు పుట్టిన పిల్లలు,</para>
  <para style="q2" vid="ISA 49:20">‘ఈ స్ధలం మాకు ఇరుకుగా ఉంది.</para>
  <para style="q1" vid="ISA 49:20">ఇంకా విశాలమైన స్ధలం మాకు ఇవ్వు’ అని</para>
  <para style="q2" vid="ISA 49:20">నీవు వింటుండగా అంటారు.<verse eid="ISA 49:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 49:21"/>అప్పుడు నీవు నీ హృదయంలో,</para>
  <para style="q2" vid="ISA 49:21">‘వీరిని నా కోసం ఎవరు కన్నారు?</para>
  <para style="q1" vid="ISA 49:21">నేను నా పిల్లల్ని కోల్పోయిన గొడ్రాలిని;</para>
  <para style="q2" vid="ISA 49:21">నేను బందీ అయ్యాను, తిరస్కరించబడ్డాను.</para>
  <para style="q2" vid="ISA 49:21">ఈ పిల్లల్ని ఎవరు పెంచారు?</para>
  <para style="q1" vid="ISA 49:21">నేను ఒంటరిగా విడిచిపెట్టబడ్డాను.</para>
  <para style="q2" vid="ISA 49:21">కానీ వీరు ఎక్కడ నుండి వచ్చారు?’ ”</para>
  <para style="m" vid="ISA 49:21">అని అనుకుంటావు.<verse eid="ISA 49:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ISA 49:22"/>ప్రభువైన యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="ISA 49:22">“చూడు, నేను దేశాలకు సైగ చేస్తాను,</para>
  <para style="q2" vid="ISA 49:22">జనాంగాల వైపు నా జెండాను ఎత్తుతాను;</para>
  <para style="q1" vid="ISA 49:22">వారు నీ కుమారులను తమ చేతుల్లో తీసుకువస్తారు</para>
  <para style="q2" vid="ISA 49:22">నీ కుమార్తెలను తమ భుజాల మీద మోసుకువస్తారు.<verse eid="ISA 49:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 49:23"/>రాజులు నిన్ను పోషించే తండ్రులుగా</para>
  <para style="q2" vid="ISA 49:23">వారి రాణులు నీకు పాలిచ్చే తల్లులుగా ఉంటారు.</para>
  <para style="q1" vid="ISA 49:23">వారు నీ ఎదుట తమ ముఖాన్ని నేలకు ఆనించి నమస్కారం చేస్తారు;</para>
  <para style="q2" vid="ISA 49:23">నీ పాదాల దగ్గర ఉన్న దుమ్మును నాకుతారు.</para>
  <para style="q1" vid="ISA 49:23">అప్పుడు నీవు, నేను యెహోవాను అని,</para>
  <para style="q2" vid="ISA 49:23">నా కోసం నిరీక్షణతో ఉన్నవారు నిరాశ చెందరని తెలుసుకుంటావు.”<verse eid="ISA 49:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 49:24"/>యోధుల నుండి దోపుడుసొమ్ము తీసుకోబడుతుందా?</para>
  <para style="q2" vid="ISA 49:24">నీతిమంతుని నుండి బందీలు విడిపించబడతారా?<verse eid="ISA 49:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="ISA 49:25"/>అయితే యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="ISA 49:25">“అవును, వీరుల నుండి బందీలు విడిపించబడతారు,</para>
  <para style="q2" vid="ISA 49:25">క్రూరుల నుండి దోపుడుసొమ్ము తిరిగి వస్తుంది;</para>
  <para style="q1" vid="ISA 49:25">నీతో యుద్ధం చేసేవారితో నేను యుద్ధం చేస్తాను.</para>
  <para style="q2" vid="ISA 49:25">నీ పిల్లలను నేను రక్షిస్తాను.<verse eid="ISA 49:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="ISA 49:26"/>నిన్ను బాధించేవారు తమ మాంసాన్ని తామే తినేలా చేస్తాను;</para>
  <para style="q2" vid="ISA 49:26">ద్రాక్షరసంతో మత్తు ఎక్కినట్లు వారు తమ రక్తాన్ని త్రాగి మత్తులో ఉంటారు.</para>
  <para style="q1" vid="ISA 49:26">అప్పుడు యెహోవానైన నేనే నీ రక్షకుడనని</para>
  <para style="q2" vid="ISA 49:26">యాకోబు బలవంతుడైన నీ విమోచకుడని</para>
  <para style="q2" vid="ISA 49:26">మానవులందరూ తెలుసుకుంటారు.”<verse eid="ISA 49:26"/></para>
  <chapter eid="ISA 49"/>
  <chapter number="50" style="c" sid="ISA 50"/>
  <para style="s1">ఇశ్రాయేలు పాపం, దాసుని విధేయత</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 50:1"/>యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="ISA 50:1">“నేను మీ తల్లిని విడిచిపెట్టి ఇచ్చిన</para>
  <para style="q2" vid="ISA 50:1">విడాకుల పత్రం ఎక్కడ?</para>
  <para style="q1" vid="ISA 50:1">నా అప్పుల వారిలో</para>
  <para style="q2" vid="ISA 50:1">ఎవరికి మిమ్మల్ని అమ్మివేశాను?</para>
  <para style="q1" vid="ISA 50:1">మీ పాపాలను బట్టి మీరు అమ్మబడ్డారు;</para>
  <para style="q2" vid="ISA 50:1">మీ అతిక్రమాలను బట్టి మీ తల్లి పంపివేయబడింది.<verse eid="ISA 50:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 50:2"/>నేను వచ్చినప్పుడు అక్కడ ఎందుకు ఎవరూ లేరు?</para>
  <para style="q2" vid="ISA 50:2">నేను పిలిచినప్పుడు ఎందుకు ఎవరూ జవాబివ్వలేదు?</para>
  <para style="q1" vid="ISA 50:2">నా చేయి నిన్ను విడిపించలేనంత చిన్నగా ఉందా?</para>
  <para style="q2" vid="ISA 50:2">నిన్ను రక్షించడానికి నాకు బలం లేదా?</para>
  <para style="q1" vid="ISA 50:2">కేవలం ఒక గద్దింపుతో నేను సముద్రం ఎండిపోయేలా చేస్తాను,</para>
  <para style="q2" vid="ISA 50:2">నదులను ఎడారిగా చేస్తాను;</para>
  <para style="q1" vid="ISA 50:2">నీళ్లు లేక వాటి చేపలు కుళ్ళిపోయి</para>
  <para style="q2" vid="ISA 50:2">దాహంతో చస్తాయి.<verse eid="ISA 50:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 50:3"/>ఆకాశాలకు చీకటి కమ్మేలా చేస్తాను</para>
  <para style="q2" vid="ISA 50:3">దానిని గోనెపట్టతో కప్పుతాను.”<verse eid="ISA 50:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 50:4"/>అలసినవారిని బలపరిచే మాటలు మాట్లాడడానికి</para>
  <para style="q2" vid="ISA 50:4">చక్కగా ఉపదేశించే నాలుకను ప్రభువైన యెహోవా నాకు ఇచ్చారు.</para>
  <para style="q1" vid="ISA 50:4">ఆయన ప్రతి ఉదయం నన్ను మేల్కొలుపుతారు,</para>
  <para style="q2" vid="ISA 50:4">శిష్యునిలా నేను శ్రద్ధగా వినేలా చేస్తారు.<verse eid="ISA 50:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 50:5"/>ప్రభువైన యెహోవా నా చెవులు తెరిచారు;</para>
  <para style="q2" vid="ISA 50:5">నేను తిరుగుబాటు చేయలేదు.</para>
  <para style="q2" vid="ISA 50:5">వినకుండా నేను వెనుతిరగలేదు.<verse eid="ISA 50:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 50:6"/>నన్ను కొట్టినవారికి నా వీపు అప్పగించాను,</para>
  <para style="q2" vid="ISA 50:6">నా గడ్డం పెరికినవారికి నా చెంపలు అప్పగించాను;</para>
  <para style="q1" vid="ISA 50:6">హేళన చేసిన వారి నుండి, ఉమ్మివేసిన వారి నుండి</para>
  <para style="q2" vid="ISA 50:6">నా ముఖం దాచుకోలేదు.<verse eid="ISA 50:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 50:7"/>ప్రభువైన యెహోవా నాకు సహాయం చేస్తారు కాబట్టి</para>
  <para style="q2" vid="ISA 50:7">నేను సిగ్గుపరచబడను.</para>
  <para style="q1" vid="ISA 50:7">నేను సిగ్గుపరచబడనని నాకు తెలుసు</para>
  <para style="q2" vid="ISA 50:7">కాబట్టి నా ముఖాన్ని చెకుముకి రాయిలా చేసుకున్నాను.<verse eid="ISA 50:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 50:8"/>నన్ను నీతిమంతునిగా ఎంచే వాడు సమీపంలోనే ఉన్నాడు.</para>
  <para style="q2" vid="ISA 50:8">నాపై ఎవరు అభియోగాలు మోగపలరు?</para>
  <para style="q2" vid="ISA 50:8">మనం కలిసి వాదించుకుందాం!</para>
  <para style="q1" vid="ISA 50:8">నా ప్రతివాది ఎవడు?</para>
  <para style="q2" vid="ISA 50:8">అతడు నన్ను ఎదిరించాలి!<verse eid="ISA 50:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 50:9"/>ప్రభువైన యెహోవా నాకు సహాయం చేస్తారు.</para>
  <para style="q2" vid="ISA 50:9">నన్ను ఎవరు ఖండిస్తారు?</para>
  <para style="q1" vid="ISA 50:9">వారందరూ వస్త్రంలా పాతబడిపోతారు.</para>
  <para style="q2" vid="ISA 50:9">చిమ్మెటలు వారిని తినివేస్తాయి.<verse eid="ISA 50:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 50:10"/>మీలో యెహోవాకు భయపడి</para>
  <para style="q2" vid="ISA 50:10">ఆయన సేవకుని మాట వినే వారెవరు?</para>
  <para style="q1" vid="ISA 50:10">వెలుగు లేకుండా ఉంటూ</para>
  <para style="q2" vid="ISA 50:10">చీకటిలో నడిచేవాడు</para>
  <para style="q1" vid="ISA 50:10">యెహోవా నామాన్ని నమ్మి</para>
  <para style="q2" vid="ISA 50:10">తన దేవునిపై ఆధారపడాలి.<verse eid="ISA 50:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 50:11"/>అయితే ఇప్పుడు అగ్నిని ముట్టించి</para>
  <para style="q2" vid="ISA 50:11">మీ చుట్టూ మండుతున్న దివిటీలను పెట్టుకునే మీరందరు,</para>
  <para style="q1" vid="ISA 50:11">వెళ్లండి, మీ మంటల వెలుగులో నడవండి</para>
  <para style="q2" vid="ISA 50:11">మీరు వెలిగించిన దివిటీల మంటల్లో నడవండి.</para>
  <para style="q1" vid="ISA 50:11">నా చేతి నుండి మీరు పొందుకునేది ఇదే:</para>
  <para style="q2" vid="ISA 50:11">మీరు వేదనలో పడుకుంటారు.<verse eid="ISA 50:11"/></para>
  <chapter eid="ISA 50"/>
  <chapter number="51" style="c" sid="ISA 51"/>
  <para style="s1">సీయోనుకు శాశ్వతమైన రక్షణ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 51:1"/>“నీతిని అనుసరిస్తూ యెహోవాను వెదికే వారలారా,</para>
  <para style="q2" vid="ISA 51:1">నా మాట వినండి:</para>
  <para style="q1" vid="ISA 51:1">మీరు ఏ బండ నుండి చెక్కబడ్డారో దానివైపు చూడండి,</para>
  <para style="q2" vid="ISA 51:1">మీరు ఏ గని నుండి తీయబడ్డారో దానివైపు చూడండి;<verse eid="ISA 51:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 51:2"/>మీ తండ్రియైన అబ్రాహామును,</para>
  <para style="q2" vid="ISA 51:2">మీకు జన్మనిచ్చిన శారాను చూడండి,</para>
  <para style="q1" vid="ISA 51:2">అతడు ఒంటరిగా ఉన్నప్పుడు నేను అతన్ని పిలిచాను,</para>
  <para style="q2" vid="ISA 51:2">అతన్ని ఆశీర్వదించి అతన్ని అనేకమందిగా చేశాను.<verse eid="ISA 51:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 51:3"/>యెహోవా తప్పకుండా సీయోనును ఓదారుస్తారు</para>
  <para style="q2" vid="ISA 51:3">దాని శిథిలాలన్నిటిని దయతో చూస్తారు;</para>
  <para style="q1" vid="ISA 51:3">దాని ఎడారులను ఏదెనులా చేస్తారు.</para>
  <para style="q2" vid="ISA 51:3">దాని బీడుభూములను యెహోవా తోటలా చేస్తారు.</para>
  <para style="q1" vid="ISA 51:3">ఆనంద సంతోషాలు,</para>
  <para style="q2" vid="ISA 51:3">కృతజ్ఞతాస్తుతులు, సంగీత ధ్వనులు దానిలో కనబడతాయి.<verse eid="ISA 51:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 51:4"/>“నా ప్రజలారా, మా మాట వినండి;</para>
  <para style="q2" vid="ISA 51:4">నా దేశమా, నా మాట విను:</para>
  <para style="q1" vid="ISA 51:4">నా దగ్గర నుండి ఒక హెచ్చరిక వెళ్తుంది;</para>
  <para style="q2" vid="ISA 51:4">నా న్యాయం దేశాలకు వెలుగుగా మారుతుంది.<verse eid="ISA 51:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 51:5"/>నా నీతి వేగంగా సమీపిస్తుంది,</para>
  <para style="q2" vid="ISA 51:5">నా రక్షణ మార్గంలో ఉంది.</para>
  <para style="q2" vid="ISA 51:5">నా చేయి దేశాలకు తీర్పు తీరుస్తుంది.</para>
  <para style="q1" vid="ISA 51:5">ద్వీపాలు నా వైపు చూస్తాయి,</para>
  <para style="q2" vid="ISA 51:5">నిరీక్షణతో నా చేయి కోసం వేచి ఉంటాయి.<verse eid="ISA 51:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 51:6"/>ఆకాశాల వైపు మీ కళ్ళెత్తి చూడండి,</para>
  <para style="q2" vid="ISA 51:6">క్రిందున్న భూమిని చూడండి;</para>
  <para style="q1" vid="ISA 51:6">ఆకాశాలు పొగలా మాయమైపోతాయి,</para>
  <para style="q2" vid="ISA 51:6">భూమి వస్త్రంలా పాతబడిపోతుంది</para>
  <para style="q2" vid="ISA 51:6">దాని నివాసులు జోరీగల్లా చనిపోతారు.</para>
  <para style="q1" vid="ISA 51:6">అయితే నా రక్షణ నిత్యం ఉంటుంది,</para>
  <para style="q2" vid="ISA 51:6">నా నీతి ఎన్నటికీ విఫలం కాదు.<verse eid="ISA 51:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 51:7"/>“సరియైనది తెలిసినవారలారా, నా మాట వినండి.</para>
  <para style="q2" vid="ISA 51:7">నా బోధను హృదయంలో ఉంచుకున్న ప్రజలారా, వినండి:</para>
  <para style="q1" vid="ISA 51:7">కేవలం మనుష్యులు వేసే నిందలకు భయపడకండి</para>
  <para style="q2" vid="ISA 51:7">వారి దూషణకు దిగులుపడకండి.<verse eid="ISA 51:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 51:8"/>వస్త్రాన్ని కొరికినట్లు చిమ్మెట వారిని తినివేస్తుంది;</para>
  <para style="q2" vid="ISA 51:8">పురుగు బొచ్చును కొరికినట్లు వారిని మ్రింగివేస్తుంది.</para>
  <para style="q1" vid="ISA 51:8">అయితే నా నీతి నిత్యం ఉంటుంది,</para>
  <para style="q2" vid="ISA 51:8">నా రక్షణ తరతరాలు ఉంటుంది.”<verse eid="ISA 51:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 51:9"/>యెహోవా హస్తమా, మేలుకో మేలుకో,</para>
  <para style="q2" vid="ISA 51:9">బలాన్ని ధరించుకో!</para>
  <para style="q1" vid="ISA 51:9">పాత తరంలో ఉన్నట్లు</para>
  <para style="q2" vid="ISA 51:9">గడచిన కాలంలో ఉన్నట్లు లేచిరా.</para>
  <para style="q1" vid="ISA 51:9">రాహాబును ముక్కలుగా నరికింది నీవే కదా?</para>
  <para style="q2" vid="ISA 51:9">సముద్రపు మృగాన్ని పొడిచింది నీవే కదా?<verse eid="ISA 51:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 51:10"/>సముద్రాన్ని లోతైన జలాలను</para>
  <para style="q2" vid="ISA 51:10">ఎండిపోయేలా చేసింది నీవే కదా,</para>
  <para style="q1" vid="ISA 51:10">విడిపించబడిన వారు దాటి వెళ్లేలా</para>
  <para style="q2" vid="ISA 51:10">సముద్ర లోతుల్లో దారి చేసింది నీవే కదా?<verse eid="ISA 51:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 51:11"/>యెహోవా విడిపించిన వారు తిరిగి వస్తారు.</para>
  <para style="q2" vid="ISA 51:11">వారు పాటలు పాడుతూ సీయోనులో ప్రవేశిస్తారు;</para>
  <para style="q2" vid="ISA 51:11">నిత్యమైన ఆనందం వారి తలల మీద కిరీటంగా ఉంటుంది.</para>
  <para style="q1" vid="ISA 51:11">వారు ఆనంద సంతోషాలతో నిండి ఉంటారు.</para>
  <para style="q2" vid="ISA 51:11">దుఃఖం, నిట్టూర్పు పారిపోతాయి.<verse eid="ISA 51:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 51:12"/>“నేను నేనే మిమ్మల్ని ఓదార్చుతాను.</para>
  <para style="q2" vid="ISA 51:12">చనిపోయే మనుష్యులకు గడ్డివంటి మనుష్యులకు</para>
  <para style="q2" vid="ISA 51:12">మీరు ఎందుకు భయపడతారు?<verse eid="ISA 51:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 51:13"/>ఆకాశాలను విస్తరింపజేసి</para>
  <para style="q2" vid="ISA 51:13">భూమి పునాదులను వేసిన</para>
  <para style="q2" vid="ISA 51:13">మీ సృష్టికర్తయైన యెహోవాను ఎందుకు మరచిపోయారు?</para>
  <para style="q1" vid="ISA 51:13">బాధించేవాడు నాశనం చేయడానికి ప్రయత్నిస్తున్నప్పుడు</para>
  <para style="q2" vid="ISA 51:13">వాని కోపాన్ని చూసి</para>
  <para style="q2" vid="ISA 51:13">ప్రతిరోజు ఎందుకు భయపడుతూ బ్రతుకుతున్నారు?</para>
  <para style="q1" vid="ISA 51:13">బాధించేవాని కోపం ఏమయ్యింది?<verse eid="ISA 51:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="ISA 51:14"/>క్రుంగిపోయిన ఖైదీలు త్వరలో విడుదల పొందుతారు;</para>
  <para style="q1" vid="ISA 51:14">వారు తమ చెరసాల గోతిలో చనిపోరు.</para>
  <para style="q2" vid="ISA 51:14">వారికి ఆహారం తక్కువకాదు.<verse eid="ISA 51:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 51:15"/>నేను మీ దేవుడనైన యెహోవాను,</para>
  <para style="q2" vid="ISA 51:15">సముద్రపు అలలు ఘోషించేలా నేను దానిని రేపుతాను.</para>
  <para style="q2" vid="ISA 51:15">సైన్యాల యెహోవా అని ఆయనకు పేరు.<verse eid="ISA 51:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 51:16"/>నీ నోటిలో నా మాటలు ఉంచి</para>
  <para style="q2" vid="ISA 51:16">నా చేతి నీడలో నిన్ను కప్పాను,</para>
  <para style="q1" vid="ISA 51:16">నేను ఆకాశాలను స్థాపించాను,</para>
  <para style="q2" vid="ISA 51:16">భూమి పునాదులు వేసినవాడను</para>
  <para style="q2" vid="ISA 51:16">‘మీరే నా ప్రజలు’ అని సీయోనుతో చెప్పాను.”<verse eid="ISA 51:16"/></para>
  <para style="s1">యెహోవా ఉగ్రత పాత్ర</para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 51:17"/>యెరూషలేమా లే,</para>
  <para style="q2" vid="ISA 51:17">మేలుకో, మేలుకో!</para>
  <para style="q1" vid="ISA 51:17">యెహోవా ఉగ్రత పాత్రను</para>
  <para style="q2" vid="ISA 51:17">ఆయన చేతి నుండి తీసుకుని నీవు త్రాగావు.</para>
  <para style="q1" vid="ISA 51:17">ప్రజలను తడబడేలా చేసే పాత్రలోనిది అంతా</para>
  <para style="q2" vid="ISA 51:17">మడ్డితో సహా పూర్తిగా నీవు త్రాగావు.<verse eid="ISA 51:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 51:18"/>ఆమెకు పుట్టిన పిల్లలందరిలో</para>
  <para style="q2" vid="ISA 51:18">తనకు దారి చూపడానికి ఎవరూ లేరు;</para>
  <para style="q1" vid="ISA 51:18">ఆమె పెంచిన పిల్లలందరిలో</para>
  <para style="q2" vid="ISA 51:18">తన చేతిని పట్టుకునే వారెవరూ లేరు.<verse eid="ISA 51:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 51:19"/>ఈ రెండు విపత్తులు నీ మీదికి వచ్చాయి.</para>
  <para style="q2" vid="ISA 51:19">నిన్ను ఎవరు ఓదార్చగలరు?</para>
  <para style="q1" vid="ISA 51:19">విధ్వంసం, వినాశనం, కరువు, ఖడ్గం నీ మీదికి వచ్చాయి,</para>
  <para style="q2" vid="ISA 51:19">నిన్ను ఎవరు ఆదరించగలరు?<verse eid="ISA 51:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 51:20"/>నీ పిల్లలు మూర్ఛపోయారు.</para>
  <para style="q2" vid="ISA 51:20">దుప్పి వలలో చిక్కుకున్నట్లు</para>
  <para style="q2" vid="ISA 51:20">ప్రతి వీధి మూలల్లో వారు పడిపోయారు.</para>
  <para style="q1" vid="ISA 51:20">యెహోవా ఉగ్రతతో</para>
  <para style="q2" vid="ISA 51:20">నీ దేవుని గద్దింపుతో వారు నిండిపోయారు.<verse eid="ISA 51:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 51:21"/>ద్రాక్షరసం లేకుండానే మత్తులో మునిగి</para>
  <para style="q2" vid="ISA 51:21">శ్రమపడినదానా, ఈ మాట విను.<verse eid="ISA 51:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 51:22"/>తన ప్రజల కోసం వాదించే నీ దేవుడు</para>
  <para style="q2" vid="ISA 51:22">నీ ప్రభువైన యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="ISA 51:22">“చూడు, నిన్ను తడబడేలా చేసే పాత్రను,</para>
  <para style="q2" vid="ISA 51:22">నా ఉగ్రత పాత్రను</para>
  <para style="q1" vid="ISA 51:22">నీ చేతిలో నుండి తీసివేశాను.</para>
  <para style="q2" vid="ISA 51:22">నీవు మరలా దానిని త్రాగవు.<verse eid="ISA 51:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 51:23"/>‘మేము మీమీద నడిచేటట్లు క్రింద పడుకో’</para>
  <para style="q2" vid="ISA 51:23">అని నీతో చెప్పి</para>
  <para style="q2" vid="ISA 51:23">నిన్ను బాధపెట్టేవాని చేతుల్లో దానిని పెడతాను,</para>
  <para style="q1" vid="ISA 51:23">నీవు నీ వీపును నేలకు వంచి</para>
  <para style="q2" vid="ISA 51:23">నడిచి వెళ్లడానికి ఒక వీధిగా చేశావు.”<verse eid="ISA 51:23"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 51"/>
  <chapter number="52" style="c" sid="ISA 52"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 52:1"/>సీయోనూ, మేలుకో మేలుకో,</para>
  <para style="q2" vid="ISA 52:1">నీ బలాన్ని ధరించుకో!</para>
  <para style="q1" vid="ISA 52:1">పరిశుద్ధ పట్టణమైన యెరూషలేమా!</para>
  <para style="q2" vid="ISA 52:1">నీ సుందరమైన వస్త్రాలను ధరించుకో.</para>
  <para style="q1" vid="ISA 52:1">సున్నతి పొందనివారు గాని అపవిత్రులు గాని</para>
  <para style="q2" vid="ISA 52:1">నీ లోనికి మరలా ప్రవేశించరు.<verse eid="ISA 52:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 52:2"/>నీ దుమ్ము దులుపుకో;</para>
  <para style="q2" vid="ISA 52:2">యెరూషలేమా, లేచి కూర్చో.</para>
  <para style="q1" vid="ISA 52:2">బందీగా ఉన్న సీయోను కుమారీ,</para>
  <para style="q2" vid="ISA 52:2">నీ మెడకున్న సంకెళ్ళు తీసివెయ్యి.<verse eid="ISA 52:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ISA 52:3"/>యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="ISA 52:3">“మీరు ఉచితంగా అమ్మబడ్డారు,</para>
  <para style="q2" vid="ISA 52:3">డబ్బులు ఇవ్వకుండానే మీరు విడిపించబడతారు.”<verse eid="ISA 52:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 52:4"/>ప్రభువైన యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="ISA 52:4">“నా ప్రజలు మొదట నివసించడానికి ఈజిప్టుకు వెళ్లారు;</para>
  <para style="q2" vid="ISA 52:4">తర్వాత అష్షూరు వారిని బాధించింది.<verse eid="ISA 52:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="ISA 52:5"/>“ఇప్పుడు ఇక్కడ నాకున్నది ఏంటి?” అని యెహోవా అంటున్నారు.</para>
  <para style="q1" vid="ISA 52:5">“నా ప్రజలు ఏ కారణం లేకుండా కొనిపోబడ్డారు.</para>
  <para style="q2" vid="ISA 52:5">వారిని పాలించేవారు వారిని ఎగతాళి చేస్తున్నారు</para>
  <para style="q1" vid="ISA 52:5">రోజంతా నా నామం దూషించబడుతుంది”</para>
  <para style="q2" vid="ISA 52:5">అని యెహోవా అంటున్నారు.<verse eid="ISA 52:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 52:6"/>“కాబట్టి నా ప్రజలు నా పేరు తెలుసుకుంటారు;</para>
  <para style="q2" vid="ISA 52:6">కాబట్టి దీని గురించి ముందుగా చెప్పింది నేనని</para>
  <para style="q1" vid="ISA 52:6">వారు తెలుసుకుంటారు.</para>
  <para style="q2" vid="ISA 52:6">అవును, అది నేనే.”<verse eid="ISA 52:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 52:7"/>సువార్త ప్రకటిస్తూ,</para>
  <para style="q2" vid="ISA 52:7">సమాధానాన్ని చాటిస్తూ,</para>
  <para style="q1" vid="ISA 52:7">శుభవార్తను తీసుకువస్తూ,</para>
  <para style="q2" vid="ISA 52:7">రక్షణ గురించి ప్రకటిస్తూ,</para>
  <para style="q2" vid="ISA 52:7">సీయోనుతో, “నీ దేవుడు పాలిస్తున్నారు”</para>
  <para style="q1" vid="ISA 52:7">అనే సువార్తను తెచ్చేవారి పాదాలు</para>
  <para style="q2" vid="ISA 52:7">పర్వతాలమీద ఎంతో అందమైనవి.<verse eid="ISA 52:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 52:8"/>వినండి! మీ కావలివారు కేకలు వేస్తున్నారు;</para>
  <para style="q2" vid="ISA 52:8">వారంతా కలిసి సంతోషంతో కేకలు వేస్తున్నారు.</para>
  <para style="q1" vid="ISA 52:8">యెహోవా సీయోనుకు తిరిగి వచ్చినప్పుడు</para>
  <para style="q2" vid="ISA 52:8">వారు తమ కళ్లారా చూస్తారు.<verse eid="ISA 52:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 52:9"/>యెహోవా తన ప్రజలను ఆదరించారు,</para>
  <para style="q2" vid="ISA 52:9">ఆయన యెరూషలేమును విడిపించారు.</para>
  <para style="q1" vid="ISA 52:9">కాబట్టి యెరూషలేము శిథిలాల్లారా,</para>
  <para style="q2" vid="ISA 52:9">కలిసి సంతోషంతో పాటలు పాడండి.<verse eid="ISA 52:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 52:10"/>అన్ని దేశాలు చూస్తుండగా</para>
  <para style="q2" vid="ISA 52:10">యెహోవా తన పరిశుద్ధ చేతిని విప్పుతారు.</para>
  <para style="q1" vid="ISA 52:10">భూమి అంచుల వరకు ఉండేవారంతా</para>
  <para style="q2" vid="ISA 52:10">మన దేవుని రక్షణను చూస్తారు.<verse eid="ISA 52:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 52:11"/>వెళ్లండి, వెళ్లండి, అక్కడినుండి వెళ్లండి!</para>
  <para style="q2" vid="ISA 52:11">అపవిత్రమైన దానిని తాకకండి!</para>
  <para style="q1" vid="ISA 52:11">యెహోవా మందిరపు ఉపకరణాలను మోసేవారలారా,</para>
  <para style="q2" vid="ISA 52:11">అక్కడినుండి వెళ్లి మిమ్మల్ని మీరు శుద్ధి చేసుకోండి.<verse eid="ISA 52:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 52:12"/>యెహోవా మీకు ముందుగా వెళ్తారు,</para>
  <para style="q2" vid="ISA 52:12">ఇశ్రాయేలు దేవుడు మీ వెనుక కాపలా ఉంటారు.</para>
  <para style="q1" vid="ISA 52:12">కాని మీరు తొందరగా బయలుదేరి వెళ్లరు.</para>
  <para style="q2" vid="ISA 52:12">పారిపోతున్నట్లు వెళ్లరు.<verse eid="ISA 52:12"/></para>
  <para style="s1">సేవకుని బాధలు, మహిమ</para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 52:13"/>చూడండి, నా సేవకుడు తెలివిగా ప్రవర్తిస్తాడు;<note caller="+" style="f"><char style="fr" closed="false">52:13 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">వృద్ధి చెందుతాడు</char></note></para>
  <para style="q2" vid="ISA 52:13">అతడు హెచ్చింపబడి ప్రసిద్ధిచెంది ఉన్నతంగా ఘనపరచబడతాడు.<verse eid="ISA 52:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 52:14"/>మనుష్యులందరి కంటే అతని ముఖం చాలా వికారమని</para>
  <para style="q2" vid="ISA 52:14">అతని రూపం మనిషిలా లేదని</para>
  <para style="q2" vid="ISA 52:14">అతన్ని చూసి అనేకమంది దిగ్భ్రాంతి చెందినట్లు,<verse eid="ISA 52:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 52:15"/>అతడు అనేక దేశాలను ఆశ్చర్యపడేలా చేస్తారు,</para>
  <para style="q2" vid="ISA 52:15">అతన్ని బట్టి రాజులు నోళ్ళు మూసుకుంటారు.</para>
  <para style="q1" vid="ISA 52:15">ఎందుకంటే తమకు తెలియజేయబడని సంగతులను వారు చూస్తారు.</para>
  <para style="q2" vid="ISA 52:15">తాము వినని వాటిని వారు గ్రహిస్తారు.<verse eid="ISA 52:15"/></para>
  <para style="b"/>
  <chapter eid="ISA 52"/>
  <chapter number="53" style="c" sid="ISA 53"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 53:1"/>మా సందేశాన్ని ఎవరు నమ్మారు?</para>
  <para style="q2" vid="ISA 53:1">యెహోవా హస్తం ఎవరికి వెల్లడయింది?<verse eid="ISA 53:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 53:2"/>లేత మొక్కలా ఎండిన భూమిలో మొలిచిన మొక్కలా</para>
  <para style="q2" vid="ISA 53:2">అతడు ఆయన ఎదుట పెరిగాడు.</para>
  <para style="q1" vid="ISA 53:2">మనల్ని అతనివైపు ఆకర్షించేంత అందం గాని ఘనత గాని అతనికి లేదు,</para>
  <para style="q2" vid="ISA 53:2">మనం అతన్ని కోరుకునేంతగా మంచి రూపమేమీ అతనికి లేదు.<verse eid="ISA 53:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 53:3"/>అతడు మనుష్యులచే తృణీకరించబడి తిరస్కరించబడినవానిగా,</para>
  <para style="q2" vid="ISA 53:3">శ్రమలు అనుభవించినవానిగా, బాధను ఎరిగినవానిగా ఉన్నాడు.</para>
  <para style="q1" vid="ISA 53:3">ప్రజలు అతన్ని చూడకుండ ముఖం దాచుకుంటారు;</para>
  <para style="q2" vid="ISA 53:3">అతడు నిర్లక్ష్యం చేయబడ్డాడు, మనం అతన్ని చిన్న చూపు చూశాము.<verse eid="ISA 53:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 53:4"/>ఖచ్చితంగా అతడు మన బాధలను భరించాడు.</para>
  <para style="q2" vid="ISA 53:4">మన రోగాలను భరించారు;</para>
  <para style="q1" vid="ISA 53:4">అయినా అతడు దేవునిచే శిక్షించబడ్డాడని</para>
  <para style="q2" vid="ISA 53:4">దెబ్బలు బాధలు అనుభవించాడని మనం అనుకున్నాము.<verse eid="ISA 53:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 53:5"/>అయితే మన అతిక్రమాల కోసం అతడు గాయపడ్డాడు</para>
  <para style="q2" vid="ISA 53:5">మన దోషాల కారణంగా నలగ్గొట్టబడ్డాడు.</para>
  <para style="q1" vid="ISA 53:5">మనకు సమాధానం ఇచ్చే శిక్ష అతని మీద పడింది.</para>
  <para style="q2" vid="ISA 53:5">అతని గాయాల కారణంగా మనం స్వస్థత పొందాము.<verse eid="ISA 53:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 53:6"/>మనమందరం గొర్రెల్లా దారి తప్పిపోయాము.</para>
  <para style="q2" vid="ISA 53:6">మనలో ప్రతి ఒక్కరూ తనకిష్టమైన దారిలో తిరిగిపోయారు.</para>
  <para style="q1" vid="ISA 53:6">యెహోవా మనందరి దోషాన్ని</para>
  <para style="q2" vid="ISA 53:6">అతని మీద మోపారు.<verse eid="ISA 53:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 53:7"/>అతడు పీడించబడి బాధించబడినా</para>
  <para style="q2" vid="ISA 53:7">అతడు తన నోరు తెరవలేదు;</para>
  <para style="q1" vid="ISA 53:7">వధించబడడానికి తేబడిన గొర్రెపిల్లలా,</para>
  <para style="q2" vid="ISA 53:7">బొచ్చు కత్తిరించే వాని ఎదుట గొర్రె మౌనంగా ఉన్నట్లు,</para>
  <para style="q2" vid="ISA 53:7">ఆయన తన నోరు తెరవలేదు.<verse eid="ISA 53:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 53:8"/>అన్యాయమైన తీర్పుతో అతన్ని తీసుకెళ్లారు.</para>
  <para style="q2" vid="ISA 53:8">అయినా అతని తరంలో నిరసన తెలిపింది ఎవరు?</para>
  <para style="q1" vid="ISA 53:8">సజీవుల భూమి మీద నుండి అతడు తీసివేయబడ్డాడు;</para>
  <para style="q2" vid="ISA 53:8">అతడు నా ప్రజల పాపాల కోసం శిక్షించబడ్డాడు.<verse eid="ISA 53:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 53:9"/>అతడు అన్యాయమేమీ చేయలేదు,</para>
  <para style="q2" vid="ISA 53:9">అతని నోటిలో ఏ మోసం లేదు కాని</para>
  <para style="q1" vid="ISA 53:9">అతడు చనిపోయినప్పుడు దుర్మార్గులతో సమాధి చేశారు,</para>
  <para style="q2" vid="ISA 53:9">ధనవంతుల సమాధిలో అతన్ని ఉంచారు.<verse eid="ISA 53:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 53:10"/>అయినా అతన్ని నలగ్గొట్టడం యెహోవాకు ఇష్టమైంది,</para>
  <para style="q2" vid="ISA 53:10">యెహోవా అతని జీవితాన్ని పాపపరిహారబలిగా అర్పించినా,</para>
  <para style="q1" vid="ISA 53:10">అతడు తన సంతానాన్ని చూస్తాడు, దీర్ఘకాలం జీవిస్తాడు,</para>
  <para style="q2" vid="ISA 53:10">యెహోవా చిత్తం అతని హస్తంలో వృద్ధిచెందుతుంది.<verse eid="ISA 53:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 53:11"/>అతడు శ్రమ పొందిన తర్వాత</para>
  <para style="q2" vid="ISA 53:11">జీవిత వెలుగును<note caller="+" style="f"><char style="fr" closed="false">53:11 </char><char style="ft" closed="false">కొ.ప్రా.ప్ర.లలో జీవిత వెలుగు అని లేదు</char></note> చూసి తృప్తి చెందుతాడు<note caller="+" style="f"><char style="fr" closed="false">53:11 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">తన శ్రమ యొక్క ఫలితం చూస్తాడు, తృప్తి చెందుతాడు</char></note>;</para>
  <para style="q1" vid="ISA 53:11">నీతిమంతుడైన నా సేవకుడు తన జ్ఞానంతో అనేకమందిని సమర్థిస్తాడు,</para>
  <para style="q2" vid="ISA 53:11">వారి దోషాలను అతడు భరిస్తాడు.<verse eid="ISA 53:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 53:12"/>కాబట్టి గొప్పవారితో నేనతనికి భాగం ఇస్తాను.</para>
  <para style="q2" vid="ISA 53:12">బలవంతులతో కలిసి అతడు దోపుడుసొమ్ము పంచుకుంటాడు.</para>
  <para style="q1" vid="ISA 53:12">ఎందుకంటే తన ప్రాణాన్ని మరణం పొందడానికి ధారపోసాడు,</para>
  <para style="q2" vid="ISA 53:12">అతడు అపరాధులలో ఒకనిగా ఎంచబడ్డాడు.</para>
  <para style="q1" vid="ISA 53:12">అతడు అనేకుల పాపభారాన్ని భరిస్తూ,</para>
  <para style="q2" vid="ISA 53:12">అపరాధుల గురించి విజ్ఞాపన చేశాడు.<verse eid="ISA 53:12"/></para>
  <chapter eid="ISA 53"/>
  <chapter number="54" style="c" sid="ISA 54"/>
  <para style="s1">సీయోనుకు కలుగబోయే మహిమ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 54:1"/>“గొడ్రాలా, పిల్లలు కననిదానా,</para>
  <para style="q2" vid="ISA 54:1">పాటలు పాడు.</para>
  <para style="q1" vid="ISA 54:1">ప్రసవవేదన పడనిదానా,</para>
  <para style="q2" vid="ISA 54:1">ఆనందంతో కేకలు వేయి.</para>
  <para style="q1" vid="ISA 54:1">ఎందుకంటే భర్త ఉన్నదాని పిల్లలకంటే</para>
  <para style="q2" vid="ISA 54:1">విడిచిపెట్టబడిన స్త్రీ పిల్లలు ఎక్కువగా ఉంటారు”</para>
  <para style="q2" vid="ISA 54:1">అని యెహోవా తెలియజేస్తున్నారు.<verse eid="ISA 54:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 54:2"/>“నీ గుడారపు స్థలాన్ని పెద్దగా చేయి.</para>
  <para style="q2" vid="ISA 54:2">నీ గుడారపు తెరలను ఆటంకం లేకుండా</para>
  <para style="q2" vid="ISA 54:2">ముందుకు పొడిగించు</para>
  <para style="q1" vid="ISA 54:2">నీ త్రాళ్లను పొడవుగా చేయి.</para>
  <para style="q2" vid="ISA 54:2">నీ మేకుల్ని లోతుగా దిగగొట్టు.<verse eid="ISA 54:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 54:3"/>నీవు కుడి వైపుకు ఎడమవైపుకు వ్యాపిస్తావు;</para>
  <para style="q2" vid="ISA 54:3">నీ వారసులు దేశాలను స్వాధీనం చేసుకుని</para>
  <para style="q2" vid="ISA 54:3">నిర్జనమైన వారి పట్టణాల్లో స్థిరపడతారు.<verse eid="ISA 54:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 54:4"/>“భయపడకు; నీవు సిగ్గుపరచబడవు</para>
  <para style="q2" vid="ISA 54:4">అవమానానికి భయపడకు; నీవు అవమానపరచబడవు.</para>
  <para style="q1" vid="ISA 54:4">నీ యవ్వనపు సిగ్గును నీవు మరచిపోతావు</para>
  <para style="q2" vid="ISA 54:4">నీ వైధవ్యపు నిందను ఇకపై జ్ఞాపకం చేసుకోవు.<verse eid="ISA 54:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 54:5"/>నిన్ను సృష్టించినవాడే నీ భర్త</para>
  <para style="q2" vid="ISA 54:5">ఆయన పేరు సైన్యాల యెహోవా,</para>
  <para style="q1" vid="ISA 54:5">ఇశ్రాయేలు పరిశుద్ధ దేవుడు నీ విమోచకుడు;</para>
  <para style="q2" vid="ISA 54:5">ఆయన భూమి అంతటికి దేవుడు.<verse eid="ISA 54:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 54:6"/>విడిచిపెట్టబడి మనోవేదనకు గురైన భార్యను భర్త పిలిచినట్లు</para>
  <para style="q2" vid="ISA 54:6">తిరస్కరించబడిన యవ్వనంలో ఉన్న భార్యను భర్త పిలిచినట్లు,</para>
  <para style="q1" vid="ISA 54:6">యెహోవా నిన్ను తిరిగి పిలుస్తారు”</para>
  <para style="q2" vid="ISA 54:6">అని నీ దేవుడు చెప్తున్నారు.<verse eid="ISA 54:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 54:7"/>“కొద్ది కాలం నేను నిన్ను విడిచిపెట్టాను,</para>
  <para style="q2" vid="ISA 54:7">కానీ గొప్ప జాలితో నేను నిన్ను తిరిగి చేర్చుకుంటాను.<verse eid="ISA 54:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 54:8"/>తీవ్రమైన కోపంలో</para>
  <para style="q2" vid="ISA 54:8">కొంతకాలం నీవైపు నేను చూడలేదు</para>
  <para style="q1" vid="ISA 54:8">కాని నిత్యమైన కృపతో</para>
  <para style="q2" vid="ISA 54:8">నీపై జాలి చూపిస్తాను”</para>
  <para style="q2" vid="ISA 54:8">అని నీ విమోచకుడైన యెహోవా అంటున్నారు.<verse eid="ISA 54:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 54:9"/>“ఇది నాకు నోవహు కాలంలోని జలప్రళయంలా ఉంది,</para>
  <para style="q2" vid="ISA 54:9">జలప్రళయం భూమి మీదికి ఇకపై రాదని నోవహు కాలంలో నేను ప్రమాణం చేశాను.</para>
  <para style="q1" vid="ISA 54:9">అలాగే ఇప్పుడు నీ మీద కోప్పడనని, ఎన్నడు నిన్ను గద్దించనని</para>
  <para style="q2" vid="ISA 54:9">నేను ప్రమాణం చేశాను.<verse eid="ISA 54:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 54:10"/>పర్వతాలు కదిలినా</para>
  <para style="q2" vid="ISA 54:10">కొండలు తొలగిపోయినా</para>
  <para style="q1" vid="ISA 54:10">నా మారని ప్రేమ నిన్ను విడిచిపోదు.</para>
  <para style="q2" vid="ISA 54:10">నా సమాధాన నిబంధన తొలిగిపోదు”</para>
  <para style="q2" vid="ISA 54:10">అని నీపై దయ చూపించే యెహోవా చెప్తున్నారు.<verse eid="ISA 54:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 54:11"/>“తుఫానులతో కొట్టుకుపోతూ ఓదార్పు లేక బాధపడుతున్న పట్టణమా,</para>
  <para style="q2" vid="ISA 54:11">వైడూర్యాలతో నేను నిన్ను తిరిగి కడతాను,</para>
  <para style="q2" vid="ISA 54:11">నీలమణులతో నీ పునాదులను వేస్తాను.<verse eid="ISA 54:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 54:12"/>రత్నాలతో నీ కోట బురుజులపై గోడలు,</para>
  <para style="q2" vid="ISA 54:12">మెరిసే వజ్రాలతో నీ గుమ్మాలు</para>
  <para style="q2" vid="ISA 54:12">ప్రశస్తమైన రాళ్లతో నీకు గోడలు కడతాను.<verse eid="ISA 54:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 54:13"/>యెహోవా నీ పిల్లలందరికి బోధిస్తారు</para>
  <para style="q2" vid="ISA 54:13">వారికి గొప్ప సమాధానం కలుగుతుంది.<verse eid="ISA 54:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 54:14"/>నీవు నీతిలో స్థాపించబడతావు:</para>
  <para style="q1" vid="ISA 54:14">బాధించేవారు నీకు దూరంగా ఉంటారు.</para>
  <para style="q2" vid="ISA 54:14">నీవు దేనికి భయపడే అవసరం లేదు.</para>
  <para style="q1" vid="ISA 54:14">భయం నీకు దూరంగా ఉంటుంది.</para>
  <para style="q2" vid="ISA 54:14">అది నీ దగ్గరకు రాదు.<verse eid="ISA 54:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 54:15"/>ఎవరైనా నీ మీద దాడి చేస్తే, అది చేసింది నేను కాదు;</para>
  <para style="q2" vid="ISA 54:15">నీ మీద దాడి చేసినవారు నీకు లొంగిపోతారు.<verse eid="ISA 54:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 54:16"/>“చూడు, నిప్పులు ఊది మండించి</para>
  <para style="q2" vid="ISA 54:16">తన పనికి తగిన ఆయుధాన్ని తయారుచేసే</para>
  <para style="q2" vid="ISA 54:16">కమ్మరిని సృజించింది నేనే.</para>
  <para style="q1" vid="ISA 54:16">నాశనం చేయడానికి నాశనం చేసేవాన్ని సృష్టించింది నేనే.<verse eid="ISA 54:16"/></para>
  <para style="q2">
    <verse number="17" style="v" sid="ISA 54:17"/>నీకు వ్యతిరేకంగా తయారుచేయబడిన ఏ ఆయుధం విజయం సాధించదు,</para>
  <para style="q2" vid="ISA 54:17">నిన్ను దూషించే ప్రతి నాలుకను నీవు ఖండిస్తావు.</para>
  <para style="q1" vid="ISA 54:17">యెహోవా సేవకులు పొందే స్వాస్థ్యం ఇదే,</para>
  <para style="q2" vid="ISA 54:17">నా వలన వారికి కలిగే నిరూపణ ఇదే”</para>
  <para style="q2" vid="ISA 54:17">అని యెహోవా ప్రకటిస్తున్నారు.<verse eid="ISA 54:17"/></para>
  <chapter eid="ISA 54"/>
  <chapter number="55" style="c" sid="ISA 55"/>
  <para style="s1">దాహంతో ఉన్నవారికి ఆహ్వానం</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 55:1"/>దాహంతో ఉన్నవారలారా,</para>
  <para style="q2" vid="ISA 55:1">నీళ్ల దగ్గరకు రండి.</para>
  <para style="q1" vid="ISA 55:1">డబ్బులేని వారలారా,</para>
  <para style="q2" vid="ISA 55:1">మీరు వచ్చి కొని తినండి!</para>
  <para style="q1" vid="ISA 55:1">డబ్బు లేకపోయినా ఏమీ చెల్లించకపోయినా,</para>
  <para style="q2" vid="ISA 55:1">ద్రాక్షరసం, పాలు కొనండి.<verse eid="ISA 55:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 55:2"/>ఆహారం కాని దాని కోసం మీరెందుకు డబ్బు ఖర్చుపెడతారు?</para>
  <para style="q2" vid="ISA 55:2">తృప్తి కలిగించని వాటికోసం ఎందుకు కష్టార్జితాన్ని వెచ్చిస్తారు?</para>
  <para style="q1" vid="ISA 55:2">వినండి, నా మాట వినండి, ఏది మంచిదో దానిని తినండి,</para>
  <para style="q2" vid="ISA 55:2">అప్పుడు మీరు గొప్ప వాటిని ఆనందిస్తారు.<verse eid="ISA 55:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 55:3"/>శ్రద్ధగా విని నా దగ్గరకు రండి;</para>
  <para style="q2" vid="ISA 55:3">మీరు వింటే బ్రతుకుతారు.</para>
  <para style="q1" vid="ISA 55:3">నేను మీతో నిత్య నిబంధన చేస్తాను,</para>
  <para style="q2" vid="ISA 55:3">దావీదుకు వాగ్దానం చేసిన నా శాశ్వత ప్రేమను మీకు చూపిస్తాను.<verse eid="ISA 55:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 55:4"/>చూడండి, నేను అతన్ని జనాంగాలకు సాక్షిగా చేశాను,</para>
  <para style="q2" vid="ISA 55:4">జనాంగాలకు రాజుగా అధిపతిగా అతన్ని నియమించాను.<verse eid="ISA 55:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 55:5"/>ఖచ్చితంగా నీకు తెలియని దేశాలను నీవు పిలుస్తావు.</para>
  <para style="q2" vid="ISA 55:5">యెహోవా నిన్ను మహిమపరచడం చూసి</para>
  <para style="q1" vid="ISA 55:5">నీ దేవుడైన యెహోవాను బట్టి</para>
  <para style="q2" vid="ISA 55:5">ఇశ్రాయేలు పరిశుద్ధ దేవుని బట్టి</para>
  <para style="q2" vid="ISA 55:5">నీవెవరో తెలియని దేశాలు నీ దగ్గరకు పరుగెత్తుకొని వస్తాయి.<verse eid="ISA 55:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 55:6"/>యెహోవా మీకు దొరికే సమయంలో ఆయనను వెదకండి;</para>
  <para style="q2" vid="ISA 55:6">ఆయన సమీపంలో ఉండగానే ఆయనను వేడుకోండి.<verse eid="ISA 55:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 55:7"/>దుష్టులు తమ మార్గాలను</para>
  <para style="q2" vid="ISA 55:7">అవినీతిపరులు తమ ఆలోచనలు విడిచిపెట్టాలి.</para>
  <para style="q1" vid="ISA 55:7">వారు యెహోవా వైపు తిరిగితే ఆయన వారిపై జాలి పడతారు.</para>
  <para style="q2" vid="ISA 55:7">మన దేవుడు వారిని ఉచితంగా క్షమిస్తారు.<verse eid="ISA 55:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 55:8"/>“నా ఆలోచనలు మీ ఆలోచనల వంటివి కావు,</para>
  <para style="q2" vid="ISA 55:8">మీ మార్గాలు నా మార్గాల వంటివి కావు”</para>
  <para style="q2" vid="ISA 55:8">అని యెహోవా చెప్తున్నారు.<verse eid="ISA 55:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 55:9"/>“ఆకాశాలు భూమి కన్నా ఎంత ఎత్తుగా ఉన్నాయో,</para>
  <para style="q2" vid="ISA 55:9">మీ మార్గాల కన్నా నా మార్గాలు</para>
  <para style="q2" vid="ISA 55:9">మీ ఆలోచనల కన్నా నా ఆలోచనలు అంత ఎత్తుగా ఉన్నాయి.<verse eid="ISA 55:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 55:10"/>వర్షం మంచు ఆకాశం నుండి క్రిందికి వచ్చి</para>
  <para style="q2" vid="ISA 55:10">ఎలా తిరిగి వెళ్లకుండా భూమిని తడిపి</para>
  <para style="q1" vid="ISA 55:10">విత్తువానికి విత్తనాన్ని తినేవానికి ఆహారాన్ని ఇవ్వడానికి</para>
  <para style="q2" vid="ISA 55:10">భూమిని తడిపి</para>
  <para style="q1" vid="ISA 55:10">విత్తువానికి విత్తనాన్ని తినేవానికి ఆహారాన్ని ఇవ్వడానికి</para>
  <para style="q2" vid="ISA 55:10">అది చిగురించి ఫలించేలా చేస్తాయో,<verse eid="ISA 55:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 55:11"/>అలాగే నా నోటి నుండి వచ్చిన నా మాట ఉంటుంది:</para>
  <para style="q2" vid="ISA 55:11">అది వట్టిగా నా దగ్గరకు తిరిగి రాకుండా</para>
  <para style="q1" vid="ISA 55:11">నేను కోరుకున్న ప్రకారం చేసి</para>
  <para style="q2" vid="ISA 55:11">నేను దానిని పంపిన ఉద్దేశాన్ని నెరవేరుస్తుంది.<verse eid="ISA 55:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 55:12"/>మీరు సంతోషంగా బయటకు వెళ్తారు,</para>
  <para style="q2" vid="ISA 55:12">మీరు సమాధానంగా తీసుకెళ్తారు.</para>
  <para style="q1" vid="ISA 55:12">మీ ఎదుట పర్వతాలు కొండలు</para>
  <para style="q2" vid="ISA 55:12">పాటలు పాడడం ప్రారంభిస్తాయి,</para>
  <para style="q1" vid="ISA 55:12">పొలం లోని చెట్లన్నీ</para>
  <para style="q2" vid="ISA 55:12">తమ చేతులతో చప్పట్లు కొడతాయి.<verse eid="ISA 55:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 55:13"/>ముండ్ల చెట్లకు బదులు సరళ వృక్షాలు పెరుగుతాయి,</para>
  <para style="q2" vid="ISA 55:13">దురదగొండి చెట్లకు బదులు గొంజిచెట్లు ఎదుగుతాయి.</para>
  <para style="q1" vid="ISA 55:13">ఇది యెహోవా కీర్తిగా నిత్యమైన గుర్తుగా</para>
  <para style="q2" vid="ISA 55:13">ఎప్పటికీ నిలిచి ఉంటుంది.”<verse eid="ISA 55:13"/></para>
  <chapter eid="ISA 55"/>
  <chapter number="56" style="c" sid="ISA 56"/>
  <para style="s1">ఇతరులకు రక్షణ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 56:1"/>యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="ISA 56:1">“నా రక్షణ రావడానికి సిద్ధంగా ఉంది,</para>
  <para style="q2" vid="ISA 56:1">నా నీతి త్వరలో వెల్లడవుతుంది,</para>
  <para style="q1" vid="ISA 56:1">కాబట్టి న్యాయంగా ఉండండి</para>
  <para style="q2" vid="ISA 56:1">సరియైనది చేయండి.<verse eid="ISA 56:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 56:2"/>ఎవరైతే సబ్బాతును అపవిత్రం చేయకుండ</para>
  <para style="q2" vid="ISA 56:2">దానిని పట్టుదలతో ఆచరించేవారు,</para>
  <para style="q1" vid="ISA 56:2">ఏ కీడు చేయకుండ,</para>
  <para style="q2" vid="ISA 56:2">తమ చేతిని బిగబట్టుకునేవారు ధన్యులు.”<verse eid="ISA 56:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 56:3"/>యెహోవాను వెంబడించే ఏ విదేశీయుడైనా,</para>
  <para style="q2" vid="ISA 56:3">“యెహోవా తన ప్రజల్లో నుండి నన్ను వెలివేస్తారు” అని అనకూడదు.</para>
  <para style="q1" vid="ISA 56:3">ఏ నపుంసకుడైనా,</para>
  <para style="q2" vid="ISA 56:3">“నేను కేవలం ఎండిన చెట్టును” అని అనకూడదు.<verse eid="ISA 56:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ISA 56:4"/>ఎందుకంటే యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="ISA 56:4">“నేను నియమించిన సబ్బాతును పాటిస్తూ</para>
  <para style="q2" vid="ISA 56:4">నాకిష్టమైన వాటిని కోరుకుంటూ</para>
  <para style="q2" vid="ISA 56:4">నా నిబంధనకు నమ్మకంగా ఉండే నపుంసకులకు,<verse eid="ISA 56:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 56:5"/>నా మందిరంలో, నా గోడలలో,</para>
  <para style="q2" vid="ISA 56:5">కుమారులు, కుమార్తెలు కలిగి ఉన్న దానికన్న</para>
  <para style="q2" vid="ISA 56:5">శ్రేష్ఠమైన జ్ఞాపకార్థాన్ని, పేరును ఇస్తాను.</para>
  <para style="q1" vid="ISA 56:5">ఎప్పటికీ నిలిచివుండే</para>
  <para style="q2" vid="ISA 56:5">నిత్యమైన పేరు వారికి నేను ఇస్తాను.<verse eid="ISA 56:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 56:6"/>యెహోవాకు కట్టుబడి ఉంటూ</para>
  <para style="q2" vid="ISA 56:6">ఆయనకు సేవ చేస్తూ,</para>
  <para style="q1" vid="ISA 56:6">యెహోవా నామాన్ని ప్రేమిస్తూ,</para>
  <para style="q2" vid="ISA 56:6">ఆయన సేవకులుగా ఉంటూ</para>
  <para style="q1" vid="ISA 56:6">సబ్బాతును అపవిత్రపరచకుండా పాటిస్తూ,</para>
  <para style="q2" vid="ISA 56:6">నా నిబంధన నమ్మకంగా పాటిస్తున్న విదేశీయులందరిని<verse eid="ISA 56:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 56:7"/>నా పరిశుద్ధ పర్వతం దగ్గరకు తీసుకువస్తాను,</para>
  <para style="q2" vid="ISA 56:7">నా ప్రార్థన మందిరంలో వారికి ఆనందాన్ని ఇస్తాను.</para>
  <para style="q1" vid="ISA 56:7">నా బలిపీఠం మీద వారు అర్పించే</para>
  <para style="q2" vid="ISA 56:7">దహనబలులు అర్పణలు అంగీకరించబడతాయి;</para>
  <para style="q1" vid="ISA 56:7">నా మందిరం అన్ని దేశాలకు</para>
  <para style="q2" vid="ISA 56:7">ప్రార్థన మందిరం అని పిలువబడుతుంది.”<verse eid="ISA 56:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 56:8"/>ఇశ్రాయేలీయులలో బందీగా కొనిపోబడినవారిని సమకూర్చే</para>
  <para style="q2" vid="ISA 56:8">ప్రభువైన యెహోవా ఇలా తెలియజేస్తున్నారు:</para>
  <para style="q1" vid="ISA 56:8">“నేను సమకూర్చిన వారే కాకుండా</para>
  <para style="q2" vid="ISA 56:8">వారితో పాటు ఇతరులను సమకూర్చుతాను.”<verse eid="ISA 56:8"/></para>
  <para style="s1">దుష్టులపై దేవుని ఆరోపణ</para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 56:9"/>పొలం లోని సమస్త జంతువులారా, రండి,</para>
  <para style="q2" vid="ISA 56:9">అడవిలోని సమస్త మృగాల్లారా, వచ్చి తినండి!<verse eid="ISA 56:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 56:10"/>ఇశ్రాయేలు కావలివారు గ్రుడ్డివారు.</para>
  <para style="q2" vid="ISA 56:10">వారందరికి తెలివిలేదు;</para>
  <para style="q1" vid="ISA 56:10">వారందరు మూగ కుక్కలు,</para>
  <para style="q2" vid="ISA 56:10">వారు మొరగలేరు;</para>
  <para style="q1" vid="ISA 56:10">వారు పడుకుని కలలు కంటారు,</para>
  <para style="q2" vid="ISA 56:10">నిద్రంటే వారికి ఇష్టము.<verse eid="ISA 56:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 56:11"/>వారు తిండి కోసం ఆరాటపడే కుక్కల వంటి వారు.</para>
  <para style="q2" vid="ISA 56:11">ఎంత తిన్నా వారికి తృప్తి ఉండదు.</para>
  <para style="q1" vid="ISA 56:11">వారు వివేచనలేని కాపరులుగా ఉన్నారు;</para>
  <para style="q2" vid="ISA 56:11">వారందరు తమకిష్టమైన దారుల్లో పోతారు,</para>
  <para style="q2" vid="ISA 56:11">తమ సొంత ప్రయోజనం చూసుకుంటారు.<verse eid="ISA 56:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 56:12"/>వారు, “రండి, నేను ద్రాక్షరసం తెప్పిస్తాను</para>
  <para style="q2" vid="ISA 56:12">మనం తృప్తిగా మద్యం త్రాగుదాం!</para>
  <para style="q1" vid="ISA 56:12">ఈ రోజులానే రేపు ఉంటుంది,</para>
  <para style="q2" vid="ISA 56:12">ఇంకా మంచిగా ఉంటుంది” అంటారు.<verse eid="ISA 56:12"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 56"/>
  <chapter number="57" style="c" sid="ISA 57"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 57:1"/>నీతిమంతులు నశిస్తారు,</para>
  <para style="q2" vid="ISA 57:1">ఎవరూ ఆ విషయాన్ని పట్టించుకోరు;</para>
  <para style="q1" vid="ISA 57:1">భక్తులు మాయమైపోతారు,</para>
  <para style="q2" vid="ISA 57:1">కీడు చూడకుండ</para>
  <para style="q1" vid="ISA 57:1">నీతిమంతులు కొనిపోబడడం</para>
  <para style="q2" vid="ISA 57:1">ఎవరూ గ్రహించరు.<verse eid="ISA 57:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 57:2"/>యథార్థంగా జీవించేవారు</para>
  <para style="q2" vid="ISA 57:2">సమాధానంలో ప్రవేశిస్తారు;</para>
  <para style="q2" vid="ISA 57:2">వారు చనిపోయినప్పుడు వారికి విశ్రాంతి కలుగుతుంది.<verse eid="ISA 57:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 57:3"/>“అయితే మంత్రగత్తె పిల్లలారా! వ్యభిచారసంతానమా!</para>
  <para style="q2" vid="ISA 57:3">వేశ్యసంతానమా! ఇక్కడకు రండి.<verse eid="ISA 57:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 57:4"/>మీరు ఎవరిని ఎగతాళి చేస్తున్నారు?</para>
  <para style="q2" vid="ISA 57:4">ఎవరిని చూసి వెక్కిరిస్తూ</para>
  <para style="q2" vid="ISA 57:4">మీ నాలుక చాపుతున్నారు</para>
  <para style="q1" vid="ISA 57:4">మీరు తిరుగుబాటుదారులు,</para>
  <para style="q2" vid="ISA 57:4">అబద్ధికుల సంతానం కాదా?<verse eid="ISA 57:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 57:5"/>మీరు సింధూర వృక్షాల క్రింద పచ్చని ప్రతి చెట్టు క్రింద</para>
  <para style="q2" vid="ISA 57:5">కామంతో రగిలిపోతున్నారు;</para>
  <para style="q1" vid="ISA 57:5">మీరు కనుమలలో, రాతిసందుల క్రింద</para>
  <para style="q2" vid="ISA 57:5">మీ పిల్లలను బలి ఇస్తారు.<verse eid="ISA 57:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 57:6"/>కనుమలలోని నున్నని రాళ్ల మధ్యలో ఉన్న విగ్రహాలు మీ భాగము;</para>
  <para style="q2" vid="ISA 57:6">నిజంగా అవే మీకు భాగము.</para>
  <para style="q1" vid="ISA 57:6">అవును వాటికి మీ పానార్పణలు పోశారు,</para>
  <para style="q2" vid="ISA 57:6">భోజనార్పణలు చెల్లించారు.</para>
  <para style="q2" vid="ISA 57:6">ఇదంతా చూసి నేను క్షమించాలా?<verse eid="ISA 57:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 57:7"/>చాలా ఎత్తైన పర్వతం మీద మీరు మీ పరుపు వేసుకున్నారు;</para>
  <para style="q2" vid="ISA 57:7">బలులు అర్పించడానికి అక్కడికి ఎక్కి వెళ్లారు.<verse eid="ISA 57:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 57:8"/>తలుపుల వెనుక ద్వారబంధాల వెనుక</para>
  <para style="q2" vid="ISA 57:8">మీ యూదేతర గుర్తులు పెట్టారు.</para>
  <para style="q1" vid="ISA 57:8">నన్ను విడిచిపెట్టి మీ పరుపును పరిచారు</para>
  <para style="q2" vid="ISA 57:8">దాని మీదకు ఎక్కి దానిని వెడల్పు చేశారు;</para>
  <para style="q1" vid="ISA 57:8">మీరు వారి మంచాలను ప్రేమించి వారితో నిబంధన చేసుకున్నారు.</para>
  <para style="q2" vid="ISA 57:8">వారి నగ్న శరీరాలను కామంతో చూశారు.<verse eid="ISA 57:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 57:9"/>మీరు ఒలీవనూనె తీసుకుని మోలెకు<note caller="+" style="f"><char style="fr" closed="false">57:9 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">రాజు</char></note> దగ్గరకు వెళ్లారు</para>
  <para style="q2" vid="ISA 57:9">ఎన్నో సుగంధ ద్రవ్యాలను తీసుకెళ్లారు.</para>
  <para style="q1" vid="ISA 57:9">మీరు మీ రాయబారులను<note caller="+" style="f"><char style="fr" closed="false">57:9 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">విగ్రహాలను</char></note> దూరప్రాంతానికి పంపించారు;</para>
  <para style="q2" vid="ISA 57:9">మీరు పాతాళమంత లోతుగా దిగబడిపోయారు!<verse eid="ISA 57:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 57:10"/>మీరు దూర ప్రయాణాలు చేసి అలసిపోయారు,</para>
  <para style="q2" vid="ISA 57:10">అయినా ‘అది సాధ్యం కాదు’ అని మీరు అనుకోలేదు.</para>
  <para style="q1" vid="ISA 57:10">మీరు మీ తిరిగి బలం పొందుకున్నారు</para>
  <para style="q2" vid="ISA 57:10">కాబట్టి మీరు సొమ్మసిల్లలేదు.<verse eid="ISA 57:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 57:11"/>“మీరు ఎవరికి జడిసి భయపడి</para>
  <para style="q2" vid="ISA 57:11">నా పట్ల నిజాయితీగా లేకుండా,</para>
  <para style="q1" vid="ISA 57:11">నన్ను జ్ఞాపకం చేసుకోకుండా</para>
  <para style="q2" vid="ISA 57:11">దీనిని పట్టించుకోకుండా ఉన్నారు?</para>
  <para style="q1" vid="ISA 57:11">చాలా కాలం నేను మౌనంగా ఉన్నానని</para>
  <para style="q2" vid="ISA 57:11">మీరు నాకు భయపడడం లేదు కదా?<verse eid="ISA 57:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 57:12"/>నీ నీతిని పనులను నేను బయటపెడతాను</para>
  <para style="q2" vid="ISA 57:12">అవి మీకు ప్రయోజనకరంగా ఉండవు.<verse eid="ISA 57:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 57:13"/>మీరు సహాయం కోసం మొరపెట్టినప్పుడు</para>
  <para style="q2" vid="ISA 57:13">మీరు సేకరించిన మీ విగ్రహాలే మిమ్మల్ని రక్షించాలి!</para>
  <para style="q1" vid="ISA 57:13">గాలి వాటన్నిటిని తీసుకెళ్తుంది,</para>
  <para style="q2" vid="ISA 57:13">కేవలం ఒకని ఊపిరి వాటిని చెదరగొడుతుంది.</para>
  <para style="q1" vid="ISA 57:13">అయితే నన్ను ఆశ్రయించినవారు</para>
  <para style="q2" vid="ISA 57:13">దేశాన్ని స్వతంత్రించుకుంటారు</para>
  <para style="q2" vid="ISA 57:13">నా పరిశుద్ధ పర్వతాన్ని స్వాధీనం చేసుకుంటారు.”<verse eid="ISA 57:13"/></para>
  <para style="s1">పశ్చాత్తాపం చెందిన వారికి ఆదరణ</para>
  <para style="p">
    <verse number="14" style="v" sid="ISA 57:14"/>ఇలా చెప్పబడుతుంది:</para>
  <para style="q1" vid="ISA 57:14">“కట్టండి, కట్టండి, దారిని సిద్ధపరచండి!</para>
  <para style="q2" vid="ISA 57:14">నా ప్రజల మార్గంలో నుండి అడ్డుగా ఉన్నవాటిని తీసివేయండి.”<verse eid="ISA 57:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 57:15"/>ఎందుకంటే మహాఘనుడు, మహోన్నతుడు,</para>
  <para style="q2" vid="ISA 57:15">పరిశుద్ధుడు, నిత్యనివాసియైన దేవుడు ఇలా చెప్తున్నారు:</para>
  <para style="q1" vid="ISA 57:15">“నేను ఉన్నతమైన పరిశుద్ధ స్థలంలో నివసిస్తాను,</para>
  <para style="q2" vid="ISA 57:15">అంతేకాక వినయం గలవారి ఆత్మకు చైతన్యం కలిగించడానికి</para>
  <para style="q1" vid="ISA 57:15">నలిగినవారి ప్రాణానికి చైతన్యం కలిగించడానికి</para>
  <para style="q2" vid="ISA 57:15">ఆత్మలో వినయం, దీనమనస్సు గలవారి దగ్గర నివసిస్తాను.<verse eid="ISA 57:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 57:16"/>నేను వారిని నిత్యం నిందించను,</para>
  <para style="q2" vid="ISA 57:16">నేను ఎప్పుడు కోపంగా ఉండను</para>
  <para style="q1" vid="ISA 57:16">ఎందుకంటే నా వలన వారు నీరసించిపోతారు.</para>
  <para style="q2" vid="ISA 57:16">నేను పుట్టించిన ప్రజలు నీరసించిపోతారు.<verse eid="ISA 57:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 57:17"/>వారి పాపిష్ఠి దురాశను బట్టి కోప్పడ్డాను</para>
  <para style="q2" vid="ISA 57:17">నేను వారిని శిక్షించి కోపంతో నా ముఖం త్రిప్పుకున్నాను,</para>
  <para style="q2" vid="ISA 57:17">అయినా వారు తమకిష్టమైన మార్గాల్లో నడుస్తూ ఉన్నారు.<verse eid="ISA 57:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 57:18"/>నేను వారి మార్గాలను చూశాను, కాని వారిని బాగుచేస్తాను;</para>
  <para style="q2" vid="ISA 57:18">నేను వారిని నడిపించి ఇశ్రాయేలులో దుఃఖించేవారిని ఓదారుస్తూ,<verse eid="ISA 57:18"/></para>
  <para style="q2">
    <verse number="19" style="v" sid="ISA 57:19"/>వారి పెదవులపై స్తుతి కలుగజేస్తాను.</para>
  <para style="q1" vid="ISA 57:19">దూరంగా ఉన్నవారికి దగ్గరగా ఉన్నవారికి</para>
  <para style="q2" vid="ISA 57:19">సమాధానం, సమాధానం” అని యెహోవా అంటున్నారు.</para>
  <para style="q1" vid="ISA 57:19">“నేను వారిని బాగుచేస్తాను.”<verse eid="ISA 57:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 57:20"/>దుర్మార్గులు ఎగసిపడే సముద్రం వంటివారు.</para>
  <para style="q2" vid="ISA 57:20">అది నెమ్మదిగా ఉండలేదు,</para>
  <para style="q2" vid="ISA 57:20">దాని అలలు బురదను మురికిని పైకి తెస్తాయి.<verse eid="ISA 57:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 57:21"/>“దుర్మార్గులకు సమాధానం ఉండదు” అని నా దేవుడు చెప్తున్నారు.<verse eid="ISA 57:21"/></para>
  <chapter eid="ISA 57"/>
  <chapter number="58" style="c" sid="ISA 58"/>
  <para style="s1">నిజమైన ఉపవాసం</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 58:1"/>“గట్టిగా కేకలు వేయండి, ఆపకండి.</para>
  <para style="q2" vid="ISA 58:1">బూర ఊదినట్లు మీ స్వరం వినిపించండి.</para>
  <para style="q1" vid="ISA 58:1">నా ప్రజలకు వారు చేసిన తిరుగుబాటును తెలియజేయండి,</para>
  <para style="q2" vid="ISA 58:1">యాకోబు వారసులకు వారి పాపాలను తెలియజేయండి.<verse eid="ISA 58:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 58:2"/>ప్రతిరోజు వారు నన్ను వెదకుతారు;</para>
  <para style="q2" vid="ISA 58:2">తమ దేవుని ఆజ్ఞలను విడిచిపెట్టని వారిగా</para>
  <para style="q1" vid="ISA 58:2">నీతిని అనుసరించే దేశంగా</para>
  <para style="q2" vid="ISA 58:2">నా మార్గాలు తెలుసుకోవడానికి అత్యాసక్తి చూపిస్తారు.</para>
  <para style="q1" vid="ISA 58:2">తమకు న్యాయమైన తీర్పులు ఇవ్వాలని నన్ను అడుగుతారు,</para>
  <para style="q2" vid="ISA 58:2">దేవుడు తమ దగ్గరకు రావాలని కోరుకుంటారు.<verse eid="ISA 58:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 58:3"/>వారంటారు, ‘మేము ఉపవాసం ఉండగా</para>
  <para style="q2" vid="ISA 58:3">మీరెందుకు చూడరు?</para>
  <para style="q1" vid="ISA 58:3">మమ్మల్ని మేము తగ్గించుకుంటే</para>
  <para style="q2" vid="ISA 58:3">మీరెందుకు గమనించరు?’</para>
  <para style="b" vid="ISA 58:3"/>
  <para style="q1" vid="ISA 58:3">“అయినా మీరు ఉపవాసం ఉన్న రోజున మీకు నచ్చినట్లుగా చేశారు</para>
  <para style="q2" vid="ISA 58:3">మీ పనివారినందరిని దోచుకున్నారు.<verse eid="ISA 58:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 58:4"/>మీ ఉపవాసం గొడవలతో దెబ్బలాటలతో,</para>
  <para style="q2" vid="ISA 58:4">ఒకరినొకరు పిడికిలితో గుద్దులాడడంతో ముగుస్తుంది.</para>
  <para style="q1" vid="ISA 58:4">మీ స్వరం పరలోకంలో వినపడాలని</para>
  <para style="q2" vid="ISA 58:4">మీరు ఈ రోజులా ఉపవాసం ఉండకూడదు.<verse eid="ISA 58:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 58:5"/>ఇలాంటి ఉపవాసమా నేను కోరుకున్నది?</para>
  <para style="q2" vid="ISA 58:5">మనుష్యులు ఆ ఒక్కరోజు తమను తాము తగ్గించుకుంటే సరిపోతుందా?</para>
  <para style="q1" vid="ISA 58:5">ఒకడు జమ్ము రెల్లులా తలవంచుకొని</para>
  <para style="q2" vid="ISA 58:5">గోనెపట్ట కట్టుకుని బూడిదలో కూర్చోవడమే ఉపవాసమా?</para>
  <para style="q1" vid="ISA 58:5">యెహోవాకు ఇష్టమైన ఉపవాసం</para>
  <para style="q2" vid="ISA 58:5">ఇదేనని మీరనుకుంటున్నారా?<verse eid="ISA 58:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 58:6"/>“నేను కోరుకునే ఉపవాసం</para>
  <para style="q1" vid="ISA 58:6">అన్యాయపు సంకెళ్ళను విప్పడం,</para>
  <para style="q2" vid="ISA 58:6">బరువైన కాడి త్రాళ్లు తీసివేయడం,</para>
  <para style="q1" vid="ISA 58:6">బాధించబడిన వారిని విడిపించడం,</para>
  <para style="q2" vid="ISA 58:6">ప్రతీ కాడిని విరగ్గొట్టడం కాదా?<verse eid="ISA 58:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 58:7"/>మీ ఆహారాన్ని ఆకలితో ఉన్నవారితో పంచుకోవడం,</para>
  <para style="q2" vid="ISA 58:7">ఇల్లు లేక తిరుగుతున్న పేదలకు ఆశ్రయం కల్పించడం,</para>
  <para style="q1" vid="ISA 58:7">మీరు ఎవరినైనా నగ్నంగా చూస్తే, వారికి బట్టలు ఇవ్వడం,</para>
  <para style="q2" vid="ISA 58:7">మీ రక్తసంబంధులకు ముఖం దాచకపోవడమే కదా ఉపవాసం?<verse eid="ISA 58:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 58:8"/>అప్పుడు మీ వెలుగు ఉదయకాంతిలా ప్రకాశిస్తుంది.</para>
  <para style="q2" vid="ISA 58:8">మీకు వెంటనే స్వస్థత కలుగుతుంది;</para>
  <para style="q1" vid="ISA 58:8">అప్పుడు మీ నీతి<note caller="+" style="f"><char style="fr" closed="false">58:8 </char><char style="ft" closed="false">లేదా </char><char style="fq" closed="false">మీ </char><char style="fqa" closed="false">నీతిమంతుడు</char></note> మీ ముందుగా నడుస్తుంది</para>
  <para style="q2" vid="ISA 58:8">యెహోవా మహిమ మీ వెనుక కాపలాగా ఉంటుంది.<verse eid="ISA 58:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 58:9"/>అప్పుడు మీరు పిలిస్తే యెహోవా జవాబిస్తారు;</para>
  <para style="q2" vid="ISA 58:9">మీరు మొరపెడితే ఆయన నేనున్నాను అంటారు.</para>
  <para style="b" vid="ISA 58:9"/>
  <para style="q1" vid="ISA 58:9">“మీరు ఇతరులను బాధించడం,</para>
  <para style="q2" vid="ISA 58:9">వ్రేలుపెట్టి చూపిస్తూ చెడు మాట్లాడడం మానేస్తే,<verse eid="ISA 58:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 58:10"/>ఆకలితో ఉన్నవారికి మీ దగ్గర ఉన్నది ఇచ్చి,</para>
  <para style="q2" vid="ISA 58:10">బాధించబడినవారి అవసరాలను తీరిస్తే,</para>
  <para style="q1" vid="ISA 58:10">చీకటిలో మీ వెలుగు ప్రకాశిస్తుంది,</para>
  <para style="q2" vid="ISA 58:10">మీ చీకటి మధ్యాహ్నపు వెలుగుగా మారుతుంది.<verse eid="ISA 58:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 58:11"/>యెహోవా మిమ్మల్ని నిత్యం నడిపిస్తారు;</para>
  <para style="q2" vid="ISA 58:11">కరువు కాలంలో ఆయన మిమ్మల్ని తృప్తిపరచి</para>
  <para style="q2" vid="ISA 58:11">మీ ఎముకలను బలపరుస్తారు.</para>
  <para style="q1" vid="ISA 58:11">మీరు నీరు పెట్టిన తోటలా</para>
  <para style="q2" vid="ISA 58:11">ఎప్పుడూ నీరు వచ్చే నీటి ఊటలా ఉంటారు.<verse eid="ISA 58:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 58:12"/>పూర్వకాలపు శిథిలాలను మీ ప్రజలు కడతారు.</para>
  <para style="q2" vid="ISA 58:12">అనేక తరాల నాటి పునాదులను మీరు మరల వేస్తారు;</para>
  <para style="q1" vid="ISA 58:12">మీరు కూలిన గోడలను మరమత్తు చేసే మేస్త్రీగా,</para>
  <para style="q2" vid="ISA 58:12">నివాసయోగ్యంగా వీధుల్ని బాగు చేసేవారిగా పిలువబడతారు.<verse eid="ISA 58:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 58:13"/>“నా పరిశుద్ధ దినాన మీకు ఇష్టం వచ్చినట్లు చేయకుండా</para>
  <para style="q2" vid="ISA 58:13">నా సబ్బాతును పాటిస్తే,</para>
  <para style="q1" vid="ISA 58:13">సబ్బాతు ఆనందాన్ని కలిగిస్తుందని</para>
  <para style="q2" vid="ISA 58:13">యెహోవా పరిశుద్ధ దినం ఘనమైనదని అనుకుంటే,</para>
  <para style="q1" vid="ISA 58:13">దానిని గౌరవించి మీ సొంత మార్గంలో మీరు వెళ్లకుండా,</para>
  <para style="q2" vid="ISA 58:13">మీకిష్టమైన పనులు చేయకుండా వట్టిమాటలు మాట్లాడకుండా ఉంటే,<verse eid="ISA 58:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 58:14"/>అప్పుడు మీరు యెహోవాలో ఆనందిస్తారు,</para>
  <para style="q2" vid="ISA 58:14">దేశంలో ఉన్నతస్థలాల మీద నేను మిమ్మల్ని ఎక్కిస్తాను,</para>
  <para style="q2" vid="ISA 58:14">మీ తండ్రియైన యాకోబు స్వాస్థ్యాన్ని మీరు అనుభవించేలా చేస్తాను.”</para>
  <para style="q1" vid="ISA 58:14">యెహోవా తెలియజేసిన మాట ఇదే.<verse eid="ISA 58:14"/></para>
  <chapter eid="ISA 58"/>
  <chapter number="59" style="c" sid="ISA 59"/>
  <para style="s1">పాపం, ఒప్పుకోలు, విమోచన</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 59:1"/>నిజంగా రక్షించలేనంతగా యెహోవా చేయి కురుచకాలేదు,</para>
  <para style="q2" vid="ISA 59:1">వినలేనంతగా ఆయన చెవులు మందం కాలేదు.<verse eid="ISA 59:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 59:2"/>కాని మీ పాపాలు మిమ్మల్ని</para>
  <para style="q2" vid="ISA 59:2">మీ దేవుని నుండి వేరు చేశాయి;</para>
  <para style="q1" vid="ISA 59:2">మీ పాపాలు ఆయన ముఖాన్ని మీకు కనబడకుండా చేశాయి,</para>
  <para style="q2" vid="ISA 59:2">కాబట్టి ఆయన వినడం లేదు.<verse eid="ISA 59:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 59:3"/>మీ చేతులు రక్తంతో</para>
  <para style="q2" vid="ISA 59:3">మీ వ్రేళ్లు దోషంతో మలినమయ్యాయి.</para>
  <para style="q1" vid="ISA 59:3">మీ పెదవులు అబద్ధాలు పలికాయి,</para>
  <para style="q2" vid="ISA 59:3">మీ నాలుక చెడ్డ మాటలు మాట్లాడింది.<verse eid="ISA 59:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 59:4"/>న్యాయం గురించి ఎవరూ పట్టించుకోరు;</para>
  <para style="q2" vid="ISA 59:4">ఎవరూ నిజాయితితో వాదించరు.</para>
  <para style="q1" vid="ISA 59:4">వారు వట్టి వాదనలను నమ్ముకుని అబద్ధాలు చెప్తారు;</para>
  <para style="q2" vid="ISA 59:4">వారు హింసను గర్భం దాల్చి చెడును కంటారు.<verse eid="ISA 59:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 59:5"/>వారు మిడునాగుల గుడ్లను పొదుగుతారు</para>
  <para style="q2" vid="ISA 59:5">సాలెగూడు నేస్తారు.</para>
  <para style="q1" vid="ISA 59:5">వారి గుడ్లు తిన్నవారు చనిపోతారు,</para>
  <para style="q2" vid="ISA 59:5">ఒక గుడ్డు పగిలితే విషపాము పుడుతుంది.<verse eid="ISA 59:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 59:6"/>వారి సాలెగూళ్లు దుస్తులకు పనికిరావు</para>
  <para style="q2" vid="ISA 59:6">వారు తయారుచేసిన వాటితో తమను తాము కప్పుకోలేరు.</para>
  <para style="q1" vid="ISA 59:6">వారి పనులు చెడుపనులు.</para>
  <para style="q2" vid="ISA 59:6">వారి చేతులతో హింసాత్మక క్రియలు ఉన్నాయి.<verse eid="ISA 59:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 59:7"/>వారి కాళ్లు పాపంలోకి పరుగెత్తుతాయి;</para>
  <para style="q2" vid="ISA 59:7">నిరపరాధుల రక్తాన్ని చిందించడానికి వారు త్వరపడతారు.</para>
  <para style="q1" vid="ISA 59:7">వారు దుష్ట పథకాలు అనుసరిస్తారు.</para>
  <para style="q2" vid="ISA 59:7">హింస క్రియలు వారి మార్గాల్లో ఉన్నాయి.<verse eid="ISA 59:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 59:8"/>సమాధాన మార్గం వారికి తెలియదు;</para>
  <para style="q2" vid="ISA 59:8">వారి మార్గాల్లో న్యాయం ఉండదు.</para>
  <para style="q1" vid="ISA 59:8">వాటిని వారు వంకర దారులుగా చేశారు;</para>
  <para style="q2" vid="ISA 59:8">వాటిలో నడిచే వారెవరికి సమాధానం ఉండదు.<verse eid="ISA 59:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 59:9"/>కాబట్టి న్యాయం మనకు దూరంగా ఉంది,</para>
  <para style="q2" vid="ISA 59:9">నీతి మనకు అందడం లేదు.</para>
  <para style="q1" vid="ISA 59:9">మేము వెలుగు కోసం చూస్తున్నాం కాని అంతా చీకటే ఉంది;</para>
  <para style="q2" vid="ISA 59:9">ప్రకాశం కోసం చూస్తున్నాం కాని కటిక చీకటిలోనే నడుస్తున్నాము.<verse eid="ISA 59:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 59:10"/>గ్రుడ్డివారిలా గోడ కోసం తడుముకుంటున్నాము,</para>
  <para style="q2" vid="ISA 59:10">కళ్లులేని వారిలా తడుముకుంటున్నాము.</para>
  <para style="q1" vid="ISA 59:10">సంధ్య చీకటి అన్నట్టు మధ్యాహ్నం కాలుజారి పడుతున్నాము.</para>
  <para style="q2" vid="ISA 59:10">బలవంతుల మధ్యలో చచ్చిన వారిలా ఉన్నాము.<verse eid="ISA 59:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 59:11"/>మేమంతా ఎలుగుబంట్లలా కేకలు వేస్తున్నాము;</para>
  <para style="q2" vid="ISA 59:11">పావురాల్లా దుఃఖంతో మూలుగుతున్నాము.</para>
  <para style="q1" vid="ISA 59:11">మేము న్యాయం కోసం చూస్తున్నాం కాని అది దొరకడం లేదు.</para>
  <para style="q2" vid="ISA 59:11">రక్షణ కోసం చూస్తున్నాం కాని అది మాకు దూరంగా ఉంది.<verse eid="ISA 59:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 59:12"/>మా అపరాధాలన్నీ మా ఎదుట ఉన్నాయి</para>
  <para style="q2" vid="ISA 59:12">మా పాపాలు మామీద సాక్ష్యం ఇస్తున్నాయి.</para>
  <para style="q1" vid="ISA 59:12">మా అపరాధాలన్నీ ఎల్లప్పుడు మాతో ఉన్నాయి,</para>
  <para style="q2" vid="ISA 59:12">మా దోషాలు మాకు తెలుసు.<verse eid="ISA 59:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 59:13"/>తిరుగుబాటు చేసి యెహోవాకు ద్రోహం చేశాం,</para>
  <para style="q2" vid="ISA 59:13">మా దేవునికి విరుద్ధంగా ఉంటూ,</para>
  <para style="q1" vid="ISA 59:13">తిరుగుబాటును ప్రేరేపించడం బాధపెట్టడం,</para>
  <para style="q2" vid="ISA 59:13">మా హృదయంలో ఆలోచించుకుని, అబద్ధాలు చెప్పడము.<verse eid="ISA 59:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 59:14"/>కాబట్టి న్యాయం వెనుకకు నెట్టబడింది,</para>
  <para style="q2" vid="ISA 59:14">నీతి దూరంగా నిలబడింది.</para>
  <para style="q1" vid="ISA 59:14">సత్యం వీధుల్లో పడి ఉంది.</para>
  <para style="q2" vid="ISA 59:14">నిజాయితీ లోపలికి రాలేకపోతుంది.<verse eid="ISA 59:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 59:15"/>సత్యం ఎక్కడా కనిపించడం లేదు,</para>
  <para style="q2" vid="ISA 59:15">చెడును విడిచిపెట్టేవాడు దోచుకోబడుతున్నాడు.</para>
  <para style="b" vid="ISA 59:15"/>
  <para style="q1" vid="ISA 59:15">న్యాయం జరగకపోవడం చూసి</para>
  <para style="q2" vid="ISA 59:15">యెహోవా అసంతృప్తి చెందారు.<verse eid="ISA 59:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 59:16"/>ఎవరూ లేరని ఆయన చూశారు,</para>
  <para style="q2" vid="ISA 59:16">మధ్యవర్తి ఎవరూ లేకపోవడం చూసి ఆయన ఆశ్చర్యపోయారు;</para>
  <para style="q1" vid="ISA 59:16">కాబట్టి ఆయన చేయి ఆయనకు సహాయం చేసింది,</para>
  <para style="q2" vid="ISA 59:16">ఆయన నీతి ఆయనను నిలబెట్టింది.<verse eid="ISA 59:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 59:17"/>ఆయన నీతిని తన కవచంగా ధరించారు,</para>
  <para style="q2" vid="ISA 59:17">రక్షణను తన తలమీద శిరస్త్రాణంగా ధరించారు;</para>
  <para style="q1" vid="ISA 59:17">ఆయన ప్రతీకార వస్త్రాలను ధరించారు</para>
  <para style="q2" vid="ISA 59:17">పై వస్త్రం ధరించినట్లు ఆయన తనను తాను ఆసక్తితో చుట్టుకున్నారు.<verse eid="ISA 59:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 59:18"/>వారు చేసిన దానిని బట్టి</para>
  <para style="q2" vid="ISA 59:18">ఆయన ప్రతిఫలం ఇస్తారు</para>
  <para style="q1" vid="ISA 59:18">తన శత్రువులకు కోపం చూపిస్తారు</para>
  <para style="q2" vid="ISA 59:18">తన విరోధులకు ప్రతీకారం చేస్తారు;</para>
  <para style="q2" vid="ISA 59:18">ఆయన ద్వీపాలకు తగిన ప్రతిఫలాన్ని చెల్లిస్తారు.<verse eid="ISA 59:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 59:19"/>పశ్చిమలో ఉన్నవారు యెహోవా నామానికి భయపడతారు.</para>
  <para style="q2" vid="ISA 59:19">సూర్యోదయ దిక్కున ఉన్నవారు ఆయన మహిమను గౌరవిస్తారు.</para>
  <para style="q1" vid="ISA 59:19">యెహోవా ఊపిరి తీసుకువచ్చే ఉధృతమైన</para>
  <para style="q2" vid="ISA 59:19">వరదలా ఆయన వస్తారు.<verse eid="ISA 59:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 59:20"/>“సీయోను దగ్గరకు, యాకోబులో తమ పాపాలకు పశ్చాత్తాపం చెందినవారి దగ్గరకు</para>
  <para style="q2" vid="ISA 59:20">విమోచకుడు వస్తాడు,”</para>
  <para style="q2" vid="ISA 59:20">అని యెహోవా తెలియజేస్తున్నారు.<verse eid="ISA 59:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="ISA 59:21"/>“నేను వారితో చేసే నా నిబంధన ఇదే” అని యెహోవా చెప్తున్నారు. “మీమీద ఉన్న నా ఆత్మ మీ నుండి తొలిగిపోదు, నేను మీ నోటిలో ఉంచిన నా మాటలు, మీ పెదవుల నుండి, మీ పిల్లల పెదవుల నుండి, వారి వారసుల పెదవుల నుండి, ఇప్పటినుండి ఎప్పటికీ తొలగిపోవు” అని యెహోవా తెలియజేస్తున్నారు.<verse eid="ISA 59:21"/></para>
  <chapter eid="ISA 59"/>
  <chapter number="60" style="c" sid="ISA 60"/>
  <para style="s1">సీయోను యొక్క మహిమ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 60:1"/>“లేచి ప్రకాశించు, నీ వెలుగు వచ్చింది,</para>
  <para style="q2" vid="ISA 60:1">యెహోవా మహిమ నీ మీద ఉదయించింది.<verse eid="ISA 60:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 60:2"/>చూడు, భూమిని చీకటి కమ్ముతుంది</para>
  <para style="q2" vid="ISA 60:2">కటిక చీకటి జనాంగాలను కమ్ముకుంటుంది.</para>
  <para style="q1" vid="ISA 60:2">కాని యెహోవా నీ మీద ఉదయిస్తున్నారు.</para>
  <para style="q2" vid="ISA 60:2">ఆయన మహిమ నీ మీద కనబడుతుంది.<verse eid="ISA 60:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 60:3"/>దేశాలు నీ వెలుగు దగ్గరకు వస్తాయి,</para>
  <para style="q2" vid="ISA 60:3">రాజులు నీ ఉదయకాంతి దగ్గరకు వస్తారు.<verse eid="ISA 60:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 60:4"/>“నీ కళ్లు పైకెత్తి చూడు:</para>
  <para style="q2" vid="ISA 60:4">అందరు కలిసి నీ దగ్గరకు వస్తున్నారు;</para>
  <para style="q1" vid="ISA 60:4">నీ కుమారులు దూరం నుండి వస్తున్నారు,</para>
  <para style="q2" vid="ISA 60:4">నీ కుమార్తెలు చంకనెక్కి వస్తున్నారు.<verse eid="ISA 60:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 60:5"/>అప్పుడు నీవు చూసి ప్రకాశిస్తావు.</para>
  <para style="q2" vid="ISA 60:5">నీ గుండె కొట్టుకొంటూ ఆనందంతో పొంగుతుంది;</para>
  <para style="q1" vid="ISA 60:5">సముద్ర సంపద నీ దగ్గరకు త్రిప్పబడుతుంది,</para>
  <para style="q2" vid="ISA 60:5">దేశాల సంపద నీ దగ్గరకు వస్తుంది.<verse eid="ISA 60:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 60:6"/>ఒంటెల మందలు, మిద్యాను ఏఫాల ఒంటె పిల్లలతో</para>
  <para style="q2" vid="ISA 60:6">నీ దేశం నిండిపోతుంది.</para>
  <para style="q1" vid="ISA 60:6">వారందరు షేబ నుండి వస్తారు,</para>
  <para style="q2" vid="ISA 60:6">బంగారం ధూపద్రవ్యాలను తీసుకువస్తారు,</para>
  <para style="q2" vid="ISA 60:6">యెహోవా స్తుతిని ప్రకటిస్తారు.<verse eid="ISA 60:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 60:7"/>నీ దగ్గర కేదారు గొర్రె మందలన్నీ సమకూడతాయి.</para>
  <para style="q2" vid="ISA 60:7">నెబాయోతు పొట్టేళ్లు నీకు సేవ చేస్తాయి;</para>
  <para style="q1" vid="ISA 60:7">అవి నా బలిపీఠం మీద అర్పణలుగా అంగీకరించబడతాయి.</para>
  <para style="q2" vid="ISA 60:7">నేను నా మహిమగల మందిరాన్ని అలంకరిస్తాను.<verse eid="ISA 60:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 60:8"/>“మేఘాల్లా, తమ గూళ్లకు ఎగిరిపోయే పావురాల్లా</para>
  <para style="q2" vid="ISA 60:8">ఎగిరే వీరెవరు?<verse eid="ISA 60:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 60:9"/>నిజంగా ద్వీపాలు నా వైపు చూస్తాయి;</para>
  <para style="q2" vid="ISA 60:9">నీ దేవుడైన యెహోవాను</para>
  <para style="q1" vid="ISA 60:9">ఇశ్రాయేలు పరిశుద్ధ దేవుని ఘనపరచడానికి,</para>
  <para style="q2" vid="ISA 60:9">తర్షీషు ఓడలు మొదట వస్తున్నాయి,</para>
  <para style="q1" vid="ISA 60:9">దూరము నుండి నీ పిల్లలను</para>
  <para style="q2" vid="ISA 60:9">తమ వెండి బంగారాలను తీసుకువస్తున్నాయి,</para>
  <para style="q2" vid="ISA 60:9">ఎందుకంటే ఆయన నిన్ను వైభవంతో అలంకరించారు.<verse eid="ISA 60:9"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 60:10"/>“విదేశీయులు నీ గోడల్ని మరల కడతారు,</para>
  <para style="q2" vid="ISA 60:10">వారి రాజులు నీకు సేవ చేస్తారు.</para>
  <para style="q1" vid="ISA 60:10">నేను కోపంలో నిన్ను కొట్టాను కాని,</para>
  <para style="q2" vid="ISA 60:10">నేను కరుణించి నీ మీద దయ చూపిస్తాను.<verse eid="ISA 60:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 60:11"/>నీ దగ్గరకు దేశాల సంపద తీసుకురావడానికి,</para>
  <para style="q2" vid="ISA 60:11">జయోత్సవంతో వారి రాజులను నడిపించడానికి,</para>
  <para style="q1" vid="ISA 60:11">నీ ద్వారాలు రాత్రింబగళ్ళు మూసివేయకుండా</para>
  <para style="q2" vid="ISA 60:11">నిత్యం తెరిచే ఉంటాయి.<verse eid="ISA 60:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 60:12"/>నిన్ను సేవించని దేశమైనా రాజ్యమైనా నాశనమవుతుంది;</para>
  <para style="q2" vid="ISA 60:12">అది పూర్తిగా నాశనమవుతుంది.<verse eid="ISA 60:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 60:13"/>“నా పరిశుద్ధాలయాన్ని అలంకరించడానికి</para>
  <para style="q2" vid="ISA 60:13">లెబానోను యొక్క వైభవమైన దేవదారు వృక్షాలు,</para>
  <para style="q1" vid="ISA 60:13">సరళ వృక్షాలు, గొంజిచెట్లు నీ దగ్గరకు తీసుకువస్తారు.</para>
  <para style="q2" vid="ISA 60:13">నేను నా పాదాలు పెట్టే స్థలాన్ని మహిమపరుస్తాను.<verse eid="ISA 60:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 60:14"/>నిన్ను బాధించినవారి పిల్లలు నీ ఎదుటకు వచ్చి నమస్కరిస్తారు.</para>
  <para style="q2" vid="ISA 60:14">నిన్ను తృణీకరించిన వారందరు వచ్చి నీ పాదాల దగ్గర మోకరిస్తారు,</para>
  <para style="q1" vid="ISA 60:14">యెహోవా పట్టణమని, ఇశ్రాయేలు పరిశుద్ధ దేవుని యొక్క</para>
  <para style="q2" vid="ISA 60:14">సీయోనని వారు నిన్ను పిలుస్తారు.<verse eid="ISA 60:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 60:15"/>“నీవు విడిచిపెట్టబడి, ద్వేషించబడి</para>
  <para style="q2" vid="ISA 60:15">నీ మార్గంలో ఎవరూ ప్రయాణించకపోయినా,</para>
  <para style="q1" vid="ISA 60:15">నేను నిన్ను శాశ్వత ఘనతగా</para>
  <para style="q2" vid="ISA 60:15">అన్ని తరాలకు ఆనందంగా చేస్తాను.<verse eid="ISA 60:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 60:16"/>నీవు దేశాల పాలు త్రాగుతావు</para>
  <para style="q2" vid="ISA 60:16">రాజుల చనుపాలు త్రాగుతావు.</para>
  <para style="q1" vid="ISA 60:16">అప్పుడు నీవు యెహోవానైన నేనే నీ రక్షకుడనని</para>
  <para style="q2" vid="ISA 60:16">యాకోబు యొక్క బలవంతుడైన నీ విమోచకుడని తెలుసుకుంటావు.<verse eid="ISA 60:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 60:17"/>నేను ఇత్తడికి బదులు బంగారాన్ని</para>
  <para style="q2" vid="ISA 60:17">ఇనుముకు బదులు వెండిని నీకు తెస్తాను.</para>
  <para style="q1" vid="ISA 60:17">నేను కర్రకు బదులు ఇత్తడిని</para>
  <para style="q2" vid="ISA 60:17">రాళ్లకు బదులు ఇనుమును నీకు తెస్తాను.</para>
  <para style="q1" vid="ISA 60:17">నేను సమాధానాన్ని నీకు అధిపతిగా</para>
  <para style="q2" vid="ISA 60:17">నీతిని నీకు పాలకునిగా నియమిస్తాను.<verse eid="ISA 60:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 60:18"/>ఇకపై నీ దేశంలో హింస అనేది వినబడదు,</para>
  <para style="q2" vid="ISA 60:18">నీ సరిహద్దులలో నాశనం గాని విధ్వంసం గాని వినపడదు.</para>
  <para style="q1" vid="ISA 60:18">అయితే నీవు నీ గోడలను రక్షణ అని</para>
  <para style="q2" vid="ISA 60:18">నీ గుమ్మాలను స్తుతి అని పిలుస్తావు.<verse eid="ISA 60:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 60:19"/>ఇకమీదట పగలు సూర్యుని వెలుగు నీకు ఉండదు,</para>
  <para style="q2" vid="ISA 60:19">చంద్రుని వెన్నెల నీపై ప్రకాశించదు,</para>
  <para style="q1" vid="ISA 60:19">యెహోవా నీకు నిత్యమైన వెలుగుగా ఉంటారు.</para>
  <para style="q2" vid="ISA 60:19">నీ దేవుడు నీకు మహిమగా ఉంటారు.<verse eid="ISA 60:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 60:20"/>నీ సూర్యుడికపై అస్తమించడు.</para>
  <para style="q2" vid="ISA 60:20">నీ చంద్రుడు క్షీణించడు.</para>
  <para style="q1" vid="ISA 60:20">యెహోవా నీకు నిత్యమైన వెలుగుగా ఉంటారు,</para>
  <para style="q2" vid="ISA 60:20">నీ దుఃఖ దినాలు అంతమవుతాయి.<verse eid="ISA 60:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 60:21"/>అప్పుడు నీ ప్రజలందరు నీతిమంతులుగా ఉంటారు;</para>
  <para style="q2" vid="ISA 60:21">వారు దేశాన్ని శాశ్వతంగా స్వతంత్రించుకుంటారు.</para>
  <para style="q1" vid="ISA 60:21">నా వైభవం కనుపరచడానికి</para>
  <para style="q2" vid="ISA 60:21">వారు నేను నాటిన కొమ్మగా</para>
  <para style="q2" vid="ISA 60:21">నా చేతుల పనిగా ఉంటారు.<verse eid="ISA 60:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 60:22"/>నీలో చిన్నవాడు వేయిమంది అవుతాడు,</para>
  <para style="q2" vid="ISA 60:22">కొద్దిగా ఉన్నది బలమైన దేశమవుతుంది.</para>
  <para style="q1" vid="ISA 60:22">నేను యెహోవాను;</para>
  <para style="q2" vid="ISA 60:22">సరియైన సమయంలో ఈ పనిని త్వరగా చేస్తాను.”<verse eid="ISA 60:22"/></para>
  <chapter eid="ISA 60"/>
  <chapter number="61" style="c" sid="ISA 61"/>
  <para style="s1">యెహోవా యొక్క దయా సంవత్సరము</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 61:1"/>ప్రభువైన యెహోవా ఆత్మ నా మీద ఉన్నది.</para>
  <para style="q2" vid="ISA 61:1">బీదలకు సువార్త ప్రకటించడానికి</para>
  <para style="q2" vid="ISA 61:1">యెహోవా నన్ను అభిషేకించారు.</para>
  <para style="q1" vid="ISA 61:1">విరిగిన హృదయం గలవారిని బలపరచడానికి</para>
  <para style="q2" vid="ISA 61:1">బందీలకు విడుదలను</para>
  <para style="q2" vid="ISA 61:1">ఖైదీలకు చీకటి నుండి విముక్తిని ప్రకటించడానికి,<verse eid="ISA 61:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 61:2"/>యెహోవా హితవత్సరాన్ని,</para>
  <para style="q2" vid="ISA 61:2">మన దేవుని ప్రతీకార దినాన్ని ప్రకటించడానికి</para>
  <para style="q1" vid="ISA 61:2">దుఃఖిస్తున్న వారందరినీ ఓదార్చడానికి,<verse eid="ISA 61:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="ISA 61:3"/>సీయోనులో దుఃఖిస్తున్న వారికి</para>
  <para style="q1" vid="ISA 61:3">బూడిదకు బదులుగా</para>
  <para style="q2" vid="ISA 61:3">అందమైన కిరీటాన్ని</para>
  <para style="q1" vid="ISA 61:3">దుఃఖానికి బదులు</para>
  <para style="q2" vid="ISA 61:3">ఆనంద తైలాన్ని</para>
  <para style="q1" vid="ISA 61:3">భారమైన ఆత్మకు బదులు</para>
  <para style="q2" vid="ISA 61:3">స్తుతి వస్త్రాన్ని అందించడానికి నన్ను పంపారు.</para>
  <para style="q1" vid="ISA 61:3">యెహోవా తన వైభవాన్ని కనుపరచడానికి,</para>
  <para style="q2" vid="ISA 61:3">నీతి అనే సింధూర చెట్లని</para>
  <para style="q2" vid="ISA 61:3">యెహోవా నాటిన చెట్లని వారు పిలువబడతారు.<verse eid="ISA 61:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 61:4"/>పురాతన శిథిలాలను వారు మరలా కడతారు</para>
  <para style="q2" vid="ISA 61:4">గతంలో నాశనమైన స్థలాలను వారు పునరుద్ధరిస్తారు;</para>
  <para style="q1" vid="ISA 61:4">పాడైపోయిన పట్టణాలను</para>
  <para style="q2" vid="ISA 61:4">తరతరాల నుండి నాశనమైన ఉన్న స్థలాలను వారు నూతనపరుస్తారు.<verse eid="ISA 61:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 61:5"/>అపరిచితులు మీ మందల్ని మేపుతారు;</para>
  <para style="q2" vid="ISA 61:5">విదేశీయులు మీ పొలాల్లో ద్రాక్షతోటల్లో పని చేస్తారు.<verse eid="ISA 61:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 61:6"/>మీరు యెహోవా యాజకులని పిలువబడతారు,</para>
  <para style="q2" vid="ISA 61:6">మా దేవుని సేవకులు అని మీకు పేరు పెట్టబడుతుంది.</para>
  <para style="q1" vid="ISA 61:6">దేశాల సంపదను మీరు అనుభవిస్తారు</para>
  <para style="q2" vid="ISA 61:6">వారి ఐశ్వర్యాన్ని పొంది అతిశయిస్తారు.<verse eid="ISA 61:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 61:7"/>మీ అవమానానికి బదులుగా</para>
  <para style="q2" vid="ISA 61:7">రెట్టింపు ఘనత పొందుతారు.</para>
  <para style="q1" vid="ISA 61:7">నిందకు బదులుగా</para>
  <para style="q2" vid="ISA 61:7">మీ స్వాస్థ్యంలో మీరు సంతోషిస్తారు.</para>
  <para style="q1" vid="ISA 61:7">మీరు మీ దేశంలో రెట్టింపు స్వాస్థ్యాన్ని పొందుతారు,</para>
  <para style="q2" vid="ISA 61:7">శాశ్వతమైన ఆనందం మీకు కలుగుతుంది.<verse eid="ISA 61:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 61:8"/>“ఎందుకంటే యెహోవానైన నాకు న్యాయమంటే ఇష్టము;</para>
  <para style="q2" vid="ISA 61:8">దోపిడి చేయడం, చెడు చేయడం నాకు అసహ్యము.</para>
  <para style="q1" vid="ISA 61:8">నా నమ్మకత్వాన్ని బట్టి నా ప్రజలకు ప్రతిఫలమిస్తాను</para>
  <para style="q2" vid="ISA 61:8">వారితో శాశ్వతమైన నిబంధన చేస్తాను.<verse eid="ISA 61:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 61:9"/>వారి వారసులు దేశాల మధ్య</para>
  <para style="q2" vid="ISA 61:9">వారి సంతానం జనాంగాల మధ్య ప్రసిద్ధి పొందుతారు.</para>
  <para style="q1" vid="ISA 61:9">వారు యెహోవా ఆశీర్వదించిన ప్రజలని</para>
  <para style="q2" vid="ISA 61:9">వారిని చూసినవారందరు గుర్తిస్తారు.”<verse eid="ISA 61:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 61:10"/>యాజకునిలా తలపాగా ధరించిన పెండ్లికుమారునిలా</para>
  <para style="q2" vid="ISA 61:10">నగలతో అలంకరించుకున్న పెండ్లికుమార్తెలా</para>
  <para style="q1" vid="ISA 61:10">ఆయన నాకు రక్షణ వస్త్రాలను ధరింపచేశారు</para>
  <para style="q2" vid="ISA 61:10">ఆయన నీతి అనే పైబట్టను నాకు ధరింపచేశారు</para>
  <para style="q1" vid="ISA 61:10">కాబట్టి యెహోవాలో నేను ఎంతో ఆనందిస్తున్నాను.</para>
  <para style="q2" vid="ISA 61:10">నా దేవునిలో నా ఆత్మ సంతోషిస్తుంది.<verse eid="ISA 61:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 61:11"/>భూమి మొలకను మొలిపించినట్లు,</para>
  <para style="q2" vid="ISA 61:11">విత్తనాలు ఎదిగేలా చేసే తోటలా,</para>
  <para style="q1" vid="ISA 61:11">అన్ని దేశాల ఎదుట ప్రభువైన యెహోవా</para>
  <para style="q2" vid="ISA 61:11">నీతిని, స్తుతిని మొలకెత్తేలా చేస్తారు.<verse eid="ISA 61:11"/></para>
  <chapter eid="ISA 61"/>
  <chapter number="62" style="c" sid="ISA 62"/>
  <para style="s1">సీయోను యొక్క క్రొత్త పేరు</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 62:1"/>సీయోను నీతి ఉదయకాంతిలా ప్రకాశించే వరకు,</para>
  <para style="q2" vid="ISA 62:1">దాని రక్షణ కాగడాలా వెలిగే వరకు,</para>
  <para style="q1" vid="ISA 62:1">సీయోను పక్షంగా నేను మౌనంగా ఉండను.</para>
  <para style="q2" vid="ISA 62:1">యెరూషలేము పక్షంగా నేను ఊరుకోలేను.<verse eid="ISA 62:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 62:2"/>దేశాలు నీ నీతిని చూస్తాయి.</para>
  <para style="q2" vid="ISA 62:2">రాజులందరూ నీ మహిమను చూస్తారు.</para>
  <para style="q1" vid="ISA 62:2">యెహోవా నీకు ఇవ్వబోయే</para>
  <para style="q2" vid="ISA 62:2">క్రొత్త పేరుతో నీవు పిలువబడతావు.<verse eid="ISA 62:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 62:3"/>నీవు యెహోవా చేతిలో వైభవ కిరీటంగా,</para>
  <para style="q2" vid="ISA 62:3">నీ దేవుని చేతిలో రాజకిరీటంగా ఉంటావు.<verse eid="ISA 62:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 62:4"/>ఇకపై నీవు విడిచిపెట్టబడిన దానివని పిలువబడవు,</para>
  <para style="q2" vid="ISA 62:4">నీ దేశం పాడైపోయిందని పిలువబడదు.</para>
  <para style="q1" vid="ISA 62:4">అయితే నీవు హెఫ్సీబా<note caller="+" style="f"><char style="fr" closed="false">62:4 </char><char style="fq" closed="false">హెఫ్సీబా </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">నా ఆనందం ఆమెలో ఉంది</char></note> అని</para>
  <para style="q2" vid="ISA 62:4">నీ దేశం బ్యూలా<note caller="+" style="f"><char style="fr" closed="false">62:4 </char><char style="fq" closed="false">బ్యూలా </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">పెళ్ళి అయ్యింది</char></note> అని పిలువబడుతుంది;</para>
  <para style="q1" vid="ISA 62:4">యెహోవా నీలో ఆనందిస్తారు</para>
  <para style="q2" vid="ISA 62:4">నీ దేశానికి పెళ్ళి అవుతుంది.<verse eid="ISA 62:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 62:5"/>యువకుడు యువతిని పెళ్ళి చేసుకున్నట్లు</para>
  <para style="q2" vid="ISA 62:5">నిన్ను కట్టేవాడు నిన్ను చేసుకుంటాడు;</para>
  <para style="q1" vid="ISA 62:5">పెళ్ళికుమారుడు పెళ్ళికుమార్తెను చూసి సంతోషించినట్లు,</para>
  <para style="q2" vid="ISA 62:5">నీ దేవుడు నిన్ను బట్టి సంతోషిస్తారు.<verse eid="ISA 62:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 62:6"/>యెరూషలేమా! నీ గోడల మీద నేను కావలివారిని నియమించాను;</para>
  <para style="q2" vid="ISA 62:6">పగలు గాని రాత్రి గాని వారు మౌనంగా ఉండరు.</para>
  <para style="q1" vid="ISA 62:6">యెహోవాకు మొరపెట్టే వారలారా</para>
  <para style="q2" vid="ISA 62:6">విశ్రాంతి తీసుకోకండి,<verse eid="ISA 62:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 62:7"/>యెరూషలేమును స్థాపించే వరకు</para>
  <para style="q2" vid="ISA 62:7">భూమి మీద దానికి ప్రసిద్ధి కలుగజేసే వరకు ఆయనకు విశ్రాంతి ఇవ్వకండి.<verse eid="ISA 62:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 62:8"/>యెహోవా తన కుడిచేతితో</para>
  <para style="q2" vid="ISA 62:8">తన బలమైన హస్తంతో ఇలా ప్రమాణం చేశారు:</para>
  <para style="q1" vid="ISA 62:8">“ఇకనుండి ఎప్పుడూ నీ ధాన్యాన్ని</para>
  <para style="q2" vid="ISA 62:8">నీ శత్రువులకు ఆహారంగా నేనివ్వను.</para>
  <para style="q1" vid="ISA 62:8">నీవు కష్టపడి తీసిన ద్రాక్షారసాన్ని</para>
  <para style="q2" vid="ISA 62:8">విదేశీయులు ఇక ఎన్నడు త్రాగరు;<verse eid="ISA 62:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 62:9"/>అయితే పంట పండించిన వారే దానిని తిని</para>
  <para style="q2" vid="ISA 62:9">యెహోవాను స్తుతిస్తారు.</para>
  <para style="q1" vid="ISA 62:9">ద్రాక్షలను సమకూర్చిన వారే</para>
  <para style="q2" vid="ISA 62:9">నా పరిశుద్ధాలయ ఆవరణాల్లో దాని త్రాగుతారు.”<verse eid="ISA 62:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 62:10"/>రండి, గుమ్మాల ద్వారా రండి!</para>
  <para style="q2" vid="ISA 62:10">ప్రజలకు మార్గం సిద్ధపరచండి.</para>
  <para style="q1" vid="ISA 62:10">నిర్మించండి, రహదారిని నిర్మించండి!</para>
  <para style="q2" vid="ISA 62:10">రాళ్లను తొలగించండి.</para>
  <para style="q1" vid="ISA 62:10">దేశాలు చూసేలా జెండాను ఎత్తండి.<verse eid="ISA 62:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 62:11"/>భూమి అంచుల వరకు</para>
  <para style="q2" vid="ISA 62:11">యెహోవా చేస్తున్న ప్రకటన:</para>
  <para style="q1" vid="ISA 62:11">“ ‘ఇదిగో నీ రక్షకుడు వస్తున్నాడు!</para>
  <para style="q2" vid="ISA 62:11">ఆయన ఇచ్చే బహుమానం ఆయన దగ్గరే ఉంది</para>
  <para style="q1" vid="ISA 62:11">ఆయన ఇచ్చే జీతం ఆయన దగ్గరే ఉంది’ అని</para>
  <para style="q2" vid="ISA 62:11">సీయోను కుమార్తెతో చెప్పండి.”<verse eid="ISA 62:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 62:12"/>వారు పరిశుద్ధ ప్రజలని,</para>
  <para style="q2" vid="ISA 62:12">యెహోవా విడిపించినవారని పిలువబడతారు;</para>
  <para style="q1" vid="ISA 62:12">నీవు అందరికి కావలసిన దానివని</para>
  <para style="q2" vid="ISA 62:12">పాడుబడని పట్టణమని పిలువబడతావు.<verse eid="ISA 62:12"/></para>
  <chapter eid="ISA 62"/>
  <chapter number="63" style="c" sid="ISA 63"/>
  <para style="s1">దేవుని తీర్పు, విమోచన దినం</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 63:1"/>రక్తపు మరకలు కలిగిన బట్టలు వేసుకుని ఎదోము నుండి</para>
  <para style="q2" vid="ISA 63:1">బొస్రానుండి వస్తున్న ఇతడెవరు?</para>
  <para style="q1" vid="ISA 63:1">రాజ వస్త్రాలను ధరించి గంభీరంగా నడుస్తూ</para>
  <para style="q2" vid="ISA 63:1">గొప్ప బలంతో వస్తున్న ఇతడెవరు?</para>
  <para style="b" vid="ISA 63:1"/>
  <para style="q1" vid="ISA 63:1">“విజయాన్ని ప్రకటిస్తూ</para>
  <para style="q2" vid="ISA 63:1">రక్షించగల సమర్థుడనైన నేనే.”<verse eid="ISA 63:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 63:2"/>నీ బట్టలు ద్రాక్షగానుగను త్రొక్కేవాని బట్టల్లా</para>
  <para style="q2" vid="ISA 63:2">ఎర్రగా ఎందుకు ఉన్నాయి?<verse eid="ISA 63:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 63:3"/>“నేను ఒంటరిగా ద్రాక్షగానుగను త్రొక్కాను;</para>
  <para style="q2" vid="ISA 63:3">దేశాల్లో ఏ ఒక్కరూ నాతో లేరు.</para>
  <para style="q1" vid="ISA 63:3">నా కోపంలో వారిని త్రొక్కివేశాను</para>
  <para style="q2" vid="ISA 63:3">నా ఉగ్రతలో వారిని అణగద్రొక్కాను;</para>
  <para style="q1" vid="ISA 63:3">వారి రక్తం నా బట్టలమీద చిందింది,</para>
  <para style="q2" vid="ISA 63:3">నా బట్టలన్నిటికి మరకలయ్యాయి.<verse eid="ISA 63:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 63:4"/>అది నేను పగతీర్చుకునే రోజు;</para>
  <para style="q2" vid="ISA 63:4">నేను విమోచించే సంవత్సరం వచ్చింది.<verse eid="ISA 63:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 63:5"/>నేను చూశాను కాని సహాయం చేయడానికి ఎవరూ లేరు;</para>
  <para style="q2" vid="ISA 63:5">ఎవరూ సహకారం అందించకపోవడం చూసి నేను ఆశ్చర్యపోయాను;</para>
  <para style="q1" vid="ISA 63:5">కాబట్టి నా సొంత చేయి నాకు రక్షణ ఇచ్చింది</para>
  <para style="q2" vid="ISA 63:5">నా కోపమే నన్ను ఆదుకుంది.<verse eid="ISA 63:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 63:6"/>నేను నా కోపంతో దేశాలను త్రొక్కివేశాను</para>
  <para style="q2" vid="ISA 63:6">నా ఉగ్రతలో వారు మత్తెక్కేలా చేశాను</para>
  <para style="q2" vid="ISA 63:6">వారి రక్తాన్ని నేలమీద పారబోశాను.”<verse eid="ISA 63:6"/></para>
  <para style="s1">స్తుతి, ప్రార్థన</para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 63:7"/>యెహోవా మనకు చేసినదంతటిని బట్టి,</para>
  <para style="q2" vid="ISA 63:7">యెహోవా కృపలను,</para>
  <para style="q2" vid="ISA 63:7">యెహోవా స్తుతులను నేను ప్రకటిస్తాను.</para>
  <para style="q1" vid="ISA 63:7">అవును, ఆయన తన కనికరాన్ని బట్టి, గొప్ప దయను బట్టి</para>
  <para style="q2" vid="ISA 63:7">ఇశ్రాయేలుకు ఆయన చేసిన అనేక మేలుల గురించి</para>
  <para style="q2" vid="ISA 63:7">నేను చెప్తాను.<verse eid="ISA 63:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 63:8"/>ఆయన అన్నారు, “నిజంగా వారు నా ప్రజలు,</para>
  <para style="q2" vid="ISA 63:8">నాకు నమ్మకంగా ఉండే పిల్లలు”;</para>
  <para style="q2" vid="ISA 63:8">కాబట్టి ఆయన వారికి రక్షకుడయ్యారు.<verse eid="ISA 63:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 63:9"/>వారి బాధంతటిలో ఆయన కూడా బాధ అనుభవించారు,</para>
  <para style="q2" vid="ISA 63:9">ఆయన సన్నిధి యొక్క దూత వారిని రక్షించాడు.<note caller="+" style="f"><char style="fr" closed="false">63:9 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">రక్షకుడు </char><char style="ft" closed="false">అక్కడ రాయబారి లేదా దూత కాదు కాని ఆయన సన్నిధే వారిని రక్షించింది</char></note></para>
  <para style="q1" vid="ISA 63:9">ఆయన ప్రేమతో, జాలితో వారిని విడిపించారు;</para>
  <para style="q2" vid="ISA 63:9">పూర్వ రోజులన్నిటిలో</para>
  <para style="q2" vid="ISA 63:9">ఆయన వారిని ఎత్తుకుంటూ, మోస్తూ వచ్చారు.<verse eid="ISA 63:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 63:10"/>అయినా వారు తిరుగుబాటు చేసి</para>
  <para style="q2" vid="ISA 63:10">ఆయన పరిశుద్ధాత్మను దుఃఖపరిచారు.</para>
  <para style="q1" vid="ISA 63:10">కాబట్టి ఆయన వారికి శత్రువయ్యారు</para>
  <para style="q2" vid="ISA 63:10">తానే వారితో యుద్ధం చేశారు.<verse eid="ISA 63:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 63:11"/>అప్పుడు ఆయన ప్రజలు పూర్వ రోజులను,</para>
  <para style="q2" vid="ISA 63:11">మోషేను తన ప్రజలను జ్ఞాపకం చేసుకున్నారు</para>
  <para style="q1" vid="ISA 63:11">తన మందకాపరులతో పాటు</para>
  <para style="q2" vid="ISA 63:11">తమను సముద్రంలో నుండి తీసుకువచ్చిన ఆయనేరి?</para>
  <para style="q1" vid="ISA 63:11">తమలో తన పరిశుద్ధాత్మను</para>
  <para style="q2" vid="ISA 63:11">ఉంచిన ఆయనేరి?<verse eid="ISA 63:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 63:12"/>మోషే కుడిచేతి వైపు</para>
  <para style="q2" vid="ISA 63:12">మహిమగల తన చేతిని పంపిన ఆయనేరి?</para>
  <para style="q1" vid="ISA 63:12">తనకు శాశ్వతమైన కీర్తి రాడానికి</para>
  <para style="q2" vid="ISA 63:12">వారి ఎదుట నీళ్లను విభజించిన ఆయనేరి?<verse eid="ISA 63:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 63:13"/>మైదానంలో గుర్రం నడిచినట్లు</para>
  <para style="q1" vid="ISA 63:13">వారు పడిపోకుండా</para>
  <para style="q2" vid="ISA 63:13">లోతైన జలాల్లో నడిపించిన ఆయనేరి?<verse eid="ISA 63:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 63:14"/>లోయలోనికి దిగివెళ్లే పశువుల్లా</para>
  <para style="q2" vid="ISA 63:14">యెహోవా ఆత్మ వారికి విశ్రాంతి కలుగజేసింది.</para>
  <para style="q1" vid="ISA 63:14">మీకు ఘనమైన పేరు రావాలని</para>
  <para style="q2" vid="ISA 63:14">మీరు మీ ప్రజలను ఇలా నడిపించారు.<verse eid="ISA 63:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 63:15"/>పరలోకం నుండి,</para>
  <para style="q2" vid="ISA 63:15">గంభీరమైన, పరిశుద్ధమైన మహిమగల సింహాసనం నుండి క్రిందికి చూడండి.</para>
  <para style="q1" vid="ISA 63:15">మీ ఆసక్తి మీ బలము ఏవి?</para>
  <para style="q2" vid="ISA 63:15">మా పట్ల మీకున్న జాలి కనికరం మా నుండి నిలిపివేయబడ్డాయి.<verse eid="ISA 63:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 63:16"/>అయితే అబ్రాహాముకు మేము తెలియకపోయినా</para>
  <para style="q2" vid="ISA 63:16">ఇశ్రాయేలు మమ్మల్ని గుర్తించకపోయినా</para>
  <para style="q2" vid="ISA 63:16">మాకు తండ్రి మీరే;</para>
  <para style="q1" vid="ISA 63:16">యెహోవా! మాకు తండ్రి మీరే,</para>
  <para style="q2" vid="ISA 63:16">పూర్వకాలం నుండి మా విమోచకుడవని మీకు పేరు.<verse eid="ISA 63:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 63:17"/>యెహోవా! మేము మీ మార్గాల నుండి తొలగిపోయి తిరిగేలా ఎందుకు చేశారు?</para>
  <para style="q2" vid="ISA 63:17">మిమ్మల్ని భయపడకుండా మా హృదయాల్ని ఎందుకు కఠినపరిచారు?</para>
  <para style="q1" vid="ISA 63:17">మీ సేవకుల కోసం,</para>
  <para style="q2" vid="ISA 63:17">మీ స్వాస్థ్యమైన గోత్రాల కోసం తిరిగి రండి.<verse eid="ISA 63:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 63:18"/>మీ ప్రజలు కొద్ది కాలమే మీ పరిశుద్ధ స్థలాన్ని స్వాధీనం చేసుకున్నారు</para>
  <para style="q2" vid="ISA 63:18">కాని ఇప్పుడు మా శత్రువులు మీ పరిశుద్ధాలయాన్ని త్రొక్కివేశారు.<verse eid="ISA 63:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 63:19"/>పూర్వం నుండి మేము మీ వారము;</para>
  <para style="q2" vid="ISA 63:19">కాని మీరెన్నడు వారిని పాలించలేదు,</para>
  <para style="q2" vid="ISA 63:19">వారు మీ పేరుతో పిలువబడలేదు.<verse eid="ISA 63:19"/></para>
  <para style="b"/>
  <para style="b"/>
  <chapter eid="ISA 63"/>
  <chapter number="64" style="c" sid="ISA 64"/>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 64:1"/>మీరు ఆకాశాన్ని చీల్చివేసి దిగివస్తే,</para>
  <para style="q2" vid="ISA 64:1">పర్వతాలు మీ ఎదుట వణుకుతాయి!<verse eid="ISA 64:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 64:2"/>మంట ఎండుకొమ్మల్ని కాల్చినప్పుడు,</para>
  <para style="q2" vid="ISA 64:2">ఆ మంటకు నీళ్లు మరిగినట్లు,</para>
  <para style="q1" vid="ISA 64:2">మీ శత్రువులకు మీ పేరు తెలిసేలా మీరు దిగిరండి,</para>
  <para style="q2" vid="ISA 64:2">మీ ఎదుట దేశాలు వణికేలా చేయండి!<verse eid="ISA 64:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 64:3"/>మేము ఊహించని భయంకరమైన పనులు మీరు చేసినప్పుడు</para>
  <para style="q2" vid="ISA 64:3">మీరు దిగివచ్చారు, పర్వతాలు మీ ఎదుట వణికాయి.<verse eid="ISA 64:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 64:4"/>తన కోసం ఎదురు చూసే వారి పక్షంగా కార్యం చేసే మిమ్మల్ని తప్ప</para>
  <para style="q2" vid="ISA 64:4">అనాది కాలం నుండి ఏ దేవున్ని ఎవరూ చూడలేదు</para>
  <para style="q1" vid="ISA 64:4">అలాంటి దేవుడు ఉన్నాడని ఎవరూ వినలేదు</para>
  <para style="q2" vid="ISA 64:4">ఎవరూ గ్రహించలేదు.<verse eid="ISA 64:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 64:5"/>మీ మార్గాలను గుర్తుచేసుకుంటూ</para>
  <para style="q2" vid="ISA 64:5">సంతోషంగా సరియైనది చేసేవారికి సహాయం చేయడానికి మీరు వస్తారు.</para>
  <para style="q1" vid="ISA 64:5">అయితే మేము వాటికి వ్యతిరేకంగా పాపం చేస్తూ ఉన్నప్పుడు</para>
  <para style="q2" vid="ISA 64:5">మీరు కోప్పడ్డారు.</para>
  <para style="q2" vid="ISA 64:5">అలా అయితే మేము ఎలా రక్షింపబడగలం?<verse eid="ISA 64:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 64:6"/>మేమందరం అపవిత్రులమయ్యాము,</para>
  <para style="q2" vid="ISA 64:6">మా నీతిక్రియలన్నీ మురికి గుడ్డలుగా ఉన్నాయి;</para>
  <para style="q1" vid="ISA 64:6">మేమందరం ఆకులా వాడిపోయాము,</para>
  <para style="q2" vid="ISA 64:6">గాలిలా మా పాపాలు మమ్మల్ని తుడిచివేస్తున్నాయి.<verse eid="ISA 64:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 64:7"/>ఎవరూ మీ పేరిట మొరపెట్టడం లేదు</para>
  <para style="q2" vid="ISA 64:7">మిమ్మల్ని ఆధారం చేసుకోవడానికి ఆరాటపడడం లేదు.</para>
  <para style="q1" vid="ISA 64:7">మీరు మా నుండి మీ ముఖం దాచుకున్నారు.</para>
  <para style="q2" vid="ISA 64:7">మమ్మల్ని మా పాపాలకు అప్పగించారు.<verse eid="ISA 64:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 64:8"/>అయినా యెహోవా! మీరే మాకు తండ్రి.</para>
  <para style="q2" vid="ISA 64:8">మేము మట్టి, మీరు కుమ్మరి.</para>
  <para style="q2" vid="ISA 64:8">మేమందరం మీ చేతి పనిగా ఉన్నాము.<verse eid="ISA 64:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 64:9"/>యెహోవా! ఎక్కువగా కోప్పడకండి;</para>
  <para style="q2" vid="ISA 64:9">నిత్యం మా పాపాల్ని జ్ఞాపకం చేసుకోకండి.</para>
  <para style="q1" vid="ISA 64:9">మేమంతా మీ ప్రజలమే కాబట్టి</para>
  <para style="q2" vid="ISA 64:9">మా పట్ల దయ చూపించమని ప్రార్థిస్తున్నాము.<verse eid="ISA 64:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 64:10"/>మీ పరిశుద్ధ పట్టణాలు బంజరు భూమిగా మారాయి;</para>
  <para style="q2" vid="ISA 64:10">చివరకు సీయోను బంజరు భూమిగా, యెరూషలేము నిర్జనంగా మారాయి.<verse eid="ISA 64:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 64:11"/>మా పూర్వికులు మిమ్మల్ని స్తుతించిన సుందరమైన మా కీర్తిగల మందిరం</para>
  <para style="q2" vid="ISA 64:11">అగ్నితో కాల్చబడింది,</para>
  <para style="q2" vid="ISA 64:11">మా ఆహ్లాదకరమైనవన్నీ నాశనమైపోయాయి.<verse eid="ISA 64:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 64:12"/>యెహోవా! ఇదంతా జరిగిన తర్వాత, మీరు చూసి ఊరుకుంటారా?</para>
  <para style="q2" vid="ISA 64:12">మీరు మౌనంగా ఉండి మమ్మల్ని ఇంకా శిక్షిస్తూనే ఉంటారా?<verse eid="ISA 64:12"/></para>
  <chapter eid="ISA 64"/>
  <chapter number="65" style="c" sid="ISA 65"/>
  <para style="s1">తీర్పు, రక్షణ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ISA 65:1"/>“నన్ను అడగని వారికి నన్ను నేను బయలుపరచుకొన్నాను;</para>
  <para style="q2" vid="ISA 65:1">నన్ను వెదకనివారికి నేను దొరికాను.</para>
  <para style="q1" vid="ISA 65:1">‘నేనున్నాను, ఇదిగో నేనున్నాను’ అని</para>
  <para style="q2" vid="ISA 65:1">నా పేరిట మొరపెట్టని దేశంతో చెప్పాను.<verse eid="ISA 65:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 65:2"/>తమ ఊహల ప్రకారం చేస్తూ</para>
  <para style="q2" vid="ISA 65:2">చెడు మార్గంలో నడుస్తూ ఉన్న</para>
  <para style="q1" vid="ISA 65:2">మూర్ఖులైన ప్రజలకు నేను దినమంతా</para>
  <para style="q2" vid="ISA 65:2">నా చేతులు చాపాను.<verse eid="ISA 65:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 65:3"/>వారు తోటల్లో బలులు అర్పిస్తూ</para>
  <para style="q2" vid="ISA 65:3">ఇటుకల బలిపీఠం మీద ధూపం వేస్తూ</para>
  <para style="q1" vid="ISA 65:3">నా ముఖం మీద</para>
  <para style="q2" vid="ISA 65:3">నాకు కోపం తెప్పించిన ప్రజలు;<verse eid="ISA 65:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 65:4"/>వారు సమాధుల మధ్యలో కూర్చుని</para>
  <para style="q2" vid="ISA 65:4">రహస్య జాగారం చేస్తూ వారి రాత్రులు గడుపుతారు;</para>
  <para style="q1" vid="ISA 65:4">వారు పందిమాంసం తింటారు.</para>
  <para style="q2" vid="ISA 65:4">అపవిత్రమైన మాంసం కూర వారి పాత్రల్లో ఉంది;<verse eid="ISA 65:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 65:5"/>వారు, ‘నా దగ్గరకు రావద్దు. దూరంగా ఉండండి,</para>
  <para style="q2" vid="ISA 65:5">మీకంటే నేను ఎంతో పరిశుద్ధున్ని’ అని అంటారు.</para>
  <para style="q1" vid="ISA 65:5">అలాంటివారు నా నాసిక రంధ్రాలకు పొగలా,</para>
  <para style="q2" vid="ISA 65:5">రోజంతా మండే నిప్పులా ఉన్నారు.<verse eid="ISA 65:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6-7" style="v" sid="ISA 65:6-7"/>“చూడండి, ఇది నా ఎదుట గ్రంథంలో వ్రాయబడింది:</para>
  <para style="q2" vid="ISA 65:6-7">నేను మౌనంగా ఉండను, వారికి పూర్తి ప్రతిఫలం చెల్లిస్తాను;</para>
  <para style="q2" vid="ISA 65:6-7">మీ పాపాలకు మీ పూర్వికుల పాపాలకు,</para>
  <para style="q1" vid="ISA 65:6-7">నేను వారికి వారి ఒడిలో ప్రతిఫలం చెల్లిస్తాను”</para>
  <para style="q2" vid="ISA 65:6-7">అని యెహోవా అంటున్నారు.</para>
  <para style="q1" vid="ISA 65:6-7">“ఎందుకంటే, వారు పర్వతాలమీద ధూపం వేశారు,</para>
  <para style="q2" vid="ISA 65:6-7">కొండలమీద నన్ను అవమానించారు,</para>
  <para style="q1" vid="ISA 65:6-7">గతంలో వారు చేసిన వాటన్నిటికి వారి ఒడిలోనే</para>
  <para style="q2" vid="ISA 65:6-7">పూర్ణ ప్రతీకారాన్ని కొలిచి పోస్తాను.”<verse eid="ISA 65:6-7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="ISA 65:8"/>యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="ISA 65:8">“ద్రాక్షగుత్తిలో ఇంకా రసం కనబడినప్పుడు</para>
  <para style="q2" vid="ISA 65:8">ప్రజలు, ‘దానిలో ఆశీర్వాదం ఉంది,</para>
  <para style="q2" vid="ISA 65:8">దానిని నాశనం చేయకండి’ అని చెప్తారు కదా.</para>
  <para style="q1" vid="ISA 65:8">అలాగే నా సేవకులందరి కోసం చేస్తాను;</para>
  <para style="q2" vid="ISA 65:8">నేను వారందరిని నాశనం చేయను.<verse eid="ISA 65:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 65:9"/>యాకోబు నుండి యూదా నుండి వారసుల్ని తీసుకువస్తాను,</para>
  <para style="q2" vid="ISA 65:9">వారు నా పర్వతాల్ని స్వాధీనపరచుకుంటారు.</para>
  <para style="q1" vid="ISA 65:9">నేను ఏర్పరచుకున్న ప్రజలు వాటిని స్వతంత్రించుకుంటారు.</para>
  <para style="q2" vid="ISA 65:9">నా సేవకులు అక్కడ నివసిస్తారు.<verse eid="ISA 65:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 65:10"/>నన్ను వెదకే నా ప్రజల కోసం</para>
  <para style="q2" vid="ISA 65:10">షారోను గొర్రెలకు పచ్చికబయళ్లుగా,</para>
  <para style="q2" vid="ISA 65:10">ఆకోరు లోయ పశువులకు విశ్రాంతి తీసుకునే చోటుగా ఉంటాయి.<verse eid="ISA 65:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 65:11"/>“అయితే యెహోవాను విడిచి,</para>
  <para style="q2" vid="ISA 65:11">నా పరిశుద్ధ పర్వతాన్ని మరచి,</para>
  <para style="q1" vid="ISA 65:11">గాదు<note caller="+" style="f"><char style="fr" closed="false">65:11 </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">అదృష్టం</char></note> దేవునికి బల్లను సిద్ధపరచి,</para>
  <para style="q2" vid="ISA 65:11">మెనీ<note caller="+" style="f"><char style="fr" closed="false">65:11 </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">విధి, తలరాత</char></note> దేవునికి ద్రాక్షరస పాత్రలు నింపేవారలారా,<verse eid="ISA 65:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ISA 65:12"/>నేను ఖడ్గానికి మిమ్మల్ని అప్పగిస్తాను,</para>
  <para style="q2" vid="ISA 65:12">మీరందరు వధకు గురై కూలిపోతారు;</para>
  <para style="q1" vid="ISA 65:12">ఎందుకంటే, నేను పిలిస్తే మీరు సమాధానం ఇవ్వలేదు,</para>
  <para style="q2" vid="ISA 65:12">నేను మాట్లాడితే మీరు వినలేదు.</para>
  <para style="q1" vid="ISA 65:12">నా దృష్టిలో మీరు చెడుగా ప్రవర్తించి</para>
  <para style="q2" vid="ISA 65:12">నాకు అయిష్టమైన వాటిని ఎంచుకున్నారు.”<verse eid="ISA 65:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ISA 65:13"/>కాబట్టి ప్రభువైన యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="ISA 65:13">“నా సేవకులు భోజనం చేస్తారు,</para>
  <para style="q2" vid="ISA 65:13">కాని మీరు ఆకలితో ఉంటారు;</para>
  <para style="q1" vid="ISA 65:13">నా సేవకులు త్రాగుతారు</para>
  <para style="q2" vid="ISA 65:13">కాని మీరు దాహంతో ఉంటారు;</para>
  <para style="q1" vid="ISA 65:13">నా సేవకులు సంతోషిస్తారు</para>
  <para style="q2" vid="ISA 65:13">కాని మీరు సిగ్గుపరచబడతారు.<verse eid="ISA 65:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 65:14"/>నా సేవకులు తమ ఆనంద హృదయాలతో</para>
  <para style="q2" vid="ISA 65:14">పాటలు పాడతారు,</para>
  <para style="q1" vid="ISA 65:14">మీరు హృదయ వేదనతో ఏడుస్తారు</para>
  <para style="q2" vid="ISA 65:14">నలిగిన ఆత్మలతో రోదిస్తారు.<verse eid="ISA 65:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 65:15"/>నేను ఏర్పరచుకున్నవారు వారి శాపవచనాల్లో</para>
  <para style="q2" vid="ISA 65:15">మీ పేరును ఉపయోగిస్తారు;</para>
  <para style="q1" vid="ISA 65:15">ప్రభువైన యెహోవా మిమ్మల్ని చంపుతారు.</para>
  <para style="q2" vid="ISA 65:15">ఆయన తన సేవకులకు మరొక పేరు పెడతారు.<verse eid="ISA 65:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 65:16"/>దేశంలో ఆశీర్వాదం ఉండాలని కోరుకునేవారు</para>
  <para style="q2" vid="ISA 65:16">ఖచ్చితంగా ఏకైక నిజ దేవుని పేరిట ఆశీర్వదించబడాలని కోరుకుంటారు;</para>
  <para style="q1" vid="ISA 65:16">దేశంలో ప్రమాణం చేసేవారు,</para>
  <para style="q2" vid="ISA 65:16">ఖచ్చితంగా ఏకైక నిజ దేవుని పేరిట ప్రమాణం చేస్తారు.</para>
  <para style="q1" vid="ISA 65:16">గతకాలపు సమస్యలన్నీ మరచిపోయాను.</para>
  <para style="q2" vid="ISA 65:16">అవి నా కళ్ల నుండి దాచబడ్డాయి.<verse eid="ISA 65:16"/></para>
  <para style="s1">క్రొత్త ఆకాశం క్రొత్త భూమి</para>
  <para style="q1">
    <verse number="17" style="v" sid="ISA 65:17"/>“చూడండి, నేను క్రొత్త ఆకాశాన్ని</para>
  <para style="q2" vid="ISA 65:17">క్రొత్త భూమిని సృష్టిస్తాను.</para>
  <para style="q1" vid="ISA 65:17">గత విషయాలు గుర్తు చేసుకోబడవు.</para>
  <para style="q2" vid="ISA 65:17">వాటి గురించి ఎవరూ ఆలోచించరు.<verse eid="ISA 65:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ISA 65:18"/>అయితే నేను సృష్టించబోయే వాటి గురించి</para>
  <para style="q2" vid="ISA 65:18">మీరు ఎప్పుడూ సంతోషించి ఆనందించండి.</para>
  <para style="q1" vid="ISA 65:18">నేను యెరూషలేమును సంతోషకరమైన స్థలంగా</para>
  <para style="q2" vid="ISA 65:18">ప్రజలను ఆనందంగా చేస్తాను.<verse eid="ISA 65:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="ISA 65:19"/>నేను యెరూషలేము గురించి సంతోషిస్తాను</para>
  <para style="q2" vid="ISA 65:19">నా ప్రజల్లో ఆనందిస్తాను;</para>
  <para style="q1" vid="ISA 65:19">ఏడ్పు రోదన శబ్దం</para>
  <para style="q2" vid="ISA 65:19">ఇకపై దానిలో వినపడవు.<verse eid="ISA 65:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ISA 65:20"/>“ఇకపై అక్కడ కొన్ని రోజులు మాత్రమే</para>
  <para style="q2" vid="ISA 65:20">బ్రతికి ఉండే శిశువులు ఉండరు.</para>
  <para style="q2" vid="ISA 65:20">తన కాలం పూర్తి కాకుండా చనిపోయే వృద్ధుడు ఉండడు;</para>
  <para style="q1" vid="ISA 65:20">వంద సంవత్సరాల వయస్సులో</para>
  <para style="q2" vid="ISA 65:20">చనిపోయేవారిని పిల్లలుగా పరిగణించబడతారు;</para>
  <para style="q1" vid="ISA 65:20">వంద సంవత్సరాలకన్నా ముందే చనిపోయే</para>
  <para style="q2" vid="ISA 65:20">పాపిని శాపగ్రస్తుడు అంటారు.<verse eid="ISA 65:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="ISA 65:21"/>వారు ఇల్లు కట్టుకుని వాటిలో నివసిస్తారు;</para>
  <para style="q2" vid="ISA 65:21">వారు ద్రాక్షతోటలు నాటి వాటి పండ్లు తింటారు.<verse eid="ISA 65:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ISA 65:22"/>ఇకపై వారు కట్టుకున్న ఇళ్ళలో వేరొకరు నివసించరు.</para>
  <para style="q2" vid="ISA 65:22">వారు నాటిన వాటి పండ్లను వేరొకరు తినరు.</para>
  <para style="q1" vid="ISA 65:22">నా ప్రజల ఆయుష్షు</para>
  <para style="q2" vid="ISA 65:22">చెట్ల ఆయుష్షంత ఉంటుంది;</para>
  <para style="q1" vid="ISA 65:22">నేను ఏర్పరచుకున్నవారు తమ చేతిపనిని</para>
  <para style="q2" vid="ISA 65:22">పూర్తిగా అనుభవిస్తారు.<verse eid="ISA 65:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="ISA 65:23"/>వారు వృధాగా కష్టపడరు,</para>
  <para style="q2" vid="ISA 65:23">దురదృష్టాన్ని అనుభవించడానికి పిల్లల్ని కనరు;</para>
  <para style="q1" vid="ISA 65:23">వారు యెహోవాచేత ఆశీర్వదించబడిన ప్రజలుగా,</para>
  <para style="q2" vid="ISA 65:23">వారు, వారి వారసులు ఉంటారు.<verse eid="ISA 65:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ISA 65:24"/>వారు మొరపెట్టక ముందే నేను జవాబిస్తాను;</para>
  <para style="q2" vid="ISA 65:24">వారు ఇంకా మాట్లాడుతుండగానే నేను వింటాను.<verse eid="ISA 65:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ISA 65:25"/>తోడేలు గొర్రెపిల్ల కలిసి మేస్తాయి,</para>
  <para style="q2" vid="ISA 65:25">సింహం ఎద్దులా గడ్డి తింటుంది,</para>
  <para style="q2" vid="ISA 65:25">దుమ్ము సర్పానికి ఆహారమవుతుంది.</para>
  <para style="q1" vid="ISA 65:25">నా పరిశుద్ధ పర్వతం మీద</para>
  <para style="q2" vid="ISA 65:25">అవి హానిని గాని నాశనాన్ని గాని చేయవు”</para>
  <para style="q2" vid="ISA 65:25">అని యెహోవా చెప్తున్నారు.<verse eid="ISA 65:25"/></para>
  <chapter eid="ISA 65"/>
  <chapter number="66" style="c" sid="ISA 66"/>
  <para style="s1">తీర్పు, నిరీక్షణ</para>
  <para style="p">
    <verse number="1" style="v" sid="ISA 66:1"/>యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="ISA 66:1">“ఆకాశం నా సింహాసనం</para>
  <para style="q2" vid="ISA 66:1">భూమి నా పాదపీఠం.</para>
  <para style="q1" vid="ISA 66:1">మీరు నా కోసం కట్టాలనుకున్న ఇల్లు ఎక్కడ?</para>
  <para style="q2" vid="ISA 66:1">నా విశ్రాంతి స్థలం ఏది?<verse eid="ISA 66:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ISA 66:2"/>వీటన్నిటిని చేసింది నా చేయి కాదా,</para>
  <para style="q2" vid="ISA 66:2">ఈ విధంగా అవి కలిగాయి కదా?”</para>
  <para style="q2" vid="ISA 66:2">అని యెహోవా తెలియజేస్తున్నారు.</para>
  <para style="b" vid="ISA 66:2"/>
  <para style="q1" vid="ISA 66:2">“ఎవరైతే వినయంతో పశ్చాత్తాప హృదయం కలిగి</para>
  <para style="q2" vid="ISA 66:2">నా మాట విని వణుకుతారో,</para>
  <para style="q2" vid="ISA 66:2">వారికే నేను దయ చూపిస్తాను.<verse eid="ISA 66:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ISA 66:3"/>అయితే కోడెను బలిచ్చేవారు</para>
  <para style="q2" vid="ISA 66:3">నరబలి ఇచ్చేవారి వంటివారే,</para>
  <para style="q1" vid="ISA 66:3">గొర్రెపిల్లను బలిగా అర్పించేవారు,</para>
  <para style="q2" vid="ISA 66:3">కుక్క మెడను విరిచేవారి వంటివారే;</para>
  <para style="q1" vid="ISA 66:3">భోజనార్పణ చేసేవారు</para>
  <para style="q2" vid="ISA 66:3">పందిరక్తం అర్పించేవారి వంటివారే,</para>
  <para style="q1" vid="ISA 66:3">జ్ఞాపకార్థ ధూపం వేసేవారు</para>
  <para style="q2" vid="ISA 66:3">విగ్రహాలను పూజించేవారి వంటివారే.</para>
  <para style="q1" vid="ISA 66:3">వారు తమకిష్టమైన దుష్ట మార్గాలను ఎంచుకున్నారు</para>
  <para style="q2" vid="ISA 66:3">వారి అసహ్యమైన పనులలో వారు సంతోషిస్తారు;<verse eid="ISA 66:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ISA 66:4"/>కాబట్టి నేను వారి కోసం కఠినమైన శిక్షను ఎంచుకుంటాను</para>
  <para style="q2" vid="ISA 66:4">వారు భయపడేవాటిని వారి మీదికి రప్పిస్తాను.</para>
  <para style="q1" vid="ISA 66:4">ఎందుకంటే, నేను పిలిస్తే ఎవరూ జవాబు ఇవ్వలేదు</para>
  <para style="q2" vid="ISA 66:4">నేను మాట్లాడితే ఎవరూ వినలేదు.</para>
  <para style="q1" vid="ISA 66:4">నా దృష్టిలో మీరు చెడుగా ప్రవర్తించి</para>
  <para style="q2" vid="ISA 66:4">నాకు అయిష్టమైన వాటిని ఎంచుకున్నారు.”<verse eid="ISA 66:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ISA 66:5"/>యెహోవా మాటకు భయపడేవారలారా,</para>
  <para style="q2" vid="ISA 66:5">ఆయన మాట వినండి.</para>
  <para style="q1" vid="ISA 66:5">“మిమ్మల్ని ద్వేషిస్తూ నా నామాన్ని బట్టి</para>
  <para style="q2" vid="ISA 66:5">మిమ్మల్ని త్రోసివేసే మీ సొంతవారు,</para>
  <para style="q1" vid="ISA 66:5">‘మీ సంతోషం మాకు కనిపించేలా</para>
  <para style="q2" vid="ISA 66:5">యెహోవాకు మహిమ కలుగును గాక!’ అని అన్నారు.</para>
  <para style="q2" vid="ISA 66:5">అయినా వారు సిగ్గుపరచబడతారు.<verse eid="ISA 66:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ISA 66:6"/>పట్టణం నుండి వచ్చే కోలాహలం వినండి</para>
  <para style="q2" vid="ISA 66:6">మందిరం నుండి వస్తున్న ఆ శబ్దం వినండి!</para>
  <para style="q1" vid="ISA 66:6">తన శత్రువులకు తగిన ప్రతిఫలాన్ని ఇస్తున్న</para>
  <para style="q2" vid="ISA 66:6">యెహోవా యొక్క శబ్దం అది.<verse eid="ISA 66:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ISA 66:7"/>“ఆమె ప్రసవవేదన పడక ముందే</para>
  <para style="q2" vid="ISA 66:7">ఆమె బిడ్డకు జన్మనిస్తుంది;</para>
  <para style="q1" vid="ISA 66:7">ఆమెకు నొప్పులు రాకముందే</para>
  <para style="q2" vid="ISA 66:7">కుమారున్ని కంటుంది.<verse eid="ISA 66:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ISA 66:8"/>అలాంటి సంగతులు ఎవరైనా ఎప్పుడైనా విన్నారా?</para>
  <para style="q2" vid="ISA 66:8">అలాంటి సంగతులు ఎవరైనా ఎప్పుడైనా చూశారా?</para>
  <para style="q1" vid="ISA 66:8">ఒక్క రోజులో దేశం పుడుతుందా</para>
  <para style="q2" vid="ISA 66:8">ఒక్క నిమిషంలోనే ఒక జనం జన్మిస్తుందా?</para>
  <para style="q1" vid="ISA 66:8">అయితే సీయోనుకు ప్రసవవేదన కలగగానే</para>
  <para style="q2" vid="ISA 66:8">ఆమె తన బిడ్డలకు జన్మనిస్తుంది.<verse eid="ISA 66:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ISA 66:9"/>నేను ప్రసవవేదన కలిగించి</para>
  <para style="q2" vid="ISA 66:9">జన్మనివ్వకుండా ఉంటానా?”</para>
  <para style="q2" vid="ISA 66:9">అని యెహోవా అడుగుతున్నారు.</para>
  <para style="q1" vid="ISA 66:9">“పుట్టుక వరకు తీసుకువచ్చి</para>
  <para style="q2" vid="ISA 66:9">గర్భాన్ని మూస్తానా?”</para>
  <para style="q2" vid="ISA 66:9">అని నీ దేవుడు అడుగుతున్నారు.<verse eid="ISA 66:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ISA 66:10"/>“యెరూషలేమును ప్రేమించే మీరందరూ</para>
  <para style="q2" vid="ISA 66:10">ఆమెతో సంతోషించి ఆనందించండి.</para>
  <para style="q1" vid="ISA 66:10">ఆమె గురించి ఏడ్చే మీరందరూ</para>
  <para style="q2" vid="ISA 66:10">ఆమెతో గొప్పగా సంతోషించండి.<verse eid="ISA 66:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ISA 66:11"/>ఆదరణకరమైన ఆమె రొమ్ము పాలు త్రాగి</para>
  <para style="q2" vid="ISA 66:11">మీరు తృప్తిపొందుతారు.</para>
  <para style="q1" vid="ISA 66:11">మీరు తృప్తిగా త్రాగి</para>
  <para style="q2" vid="ISA 66:11">ఆమె సమృద్ధిని అనుభవిస్తూ ఆనందిస్తారు.”<verse eid="ISA 66:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ISA 66:12"/>యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="ISA 66:12">“వినండి. ఆమె దగ్గరకు సమాధానం నదిలా ప్రవహించేలా చేస్తాను,</para>
  <para style="q2" vid="ISA 66:12">దేశాల సంపదలు పొంగిపొర్లే ప్రవాహంలా వస్తాయి;</para>
  <para style="q1" vid="ISA 66:12">మీరు పోషించబడి ఆమె చంకనెక్కుతారు</para>
  <para style="q2" vid="ISA 66:12">ఆమె మోకాళ్లమీద ఆడుకుంటారు.<verse eid="ISA 66:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ISA 66:13"/>తల్లి తన బిడ్డను ఆదరించినట్లు</para>
  <para style="q2" vid="ISA 66:13">నేను మిమ్మల్ని ఆదరిస్తాను.</para>
  <para style="q2" vid="ISA 66:13">యెరూషలేములోనే మీరు ఆదరించబడతారు.”<verse eid="ISA 66:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="ISA 66:14"/>మీరు ఇది చూసినప్పుడు మీ హృదయం సంతోషిస్తుంది</para>
  <para style="q2" vid="ISA 66:14">మీరు గడ్డిలా వర్ధిల్లుతారు;</para>
  <para style="q1" vid="ISA 66:14">యెహోవా యొక్క చేతి బలం తన సేవకులకు తెలియజేయబడుతుంది,</para>
  <para style="q2" vid="ISA 66:14">కాని ఆయన కోపం తన శత్రువులకు చూపించబడుతుంది.<verse eid="ISA 66:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ISA 66:15"/>చూడండి, యెహోవా అగ్నితో వస్తున్నారు,</para>
  <para style="q2" vid="ISA 66:15">ఆయన రథాలు సుడిగాలిలా వస్తున్నాయి.</para>
  <para style="q1" vid="ISA 66:15">ఆయన తన కోపాన్ని తీవ్రతతో క్రిందికి తెస్తున్నారు,</para>
  <para style="q2" vid="ISA 66:15">ఆయన గద్దింపు అగ్ని మంటలతో వస్తుంది.<verse eid="ISA 66:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ISA 66:16"/>అగ్నితో తన ఖడ్గంతో</para>
  <para style="q2" vid="ISA 66:16">యెహోవా ప్రజలందరికి తీర్పు అమలుచేస్తారు,</para>
  <para style="q2" vid="ISA 66:16">యెహోవా ద్వారా అనేకమంది చంపబడతారు.<verse eid="ISA 66:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ISA 66:17"/>“ఎవరైతే పందిమాంసం, ఎలుకలు, ఇతర అపవిత్రమైన వాటిని తినేవాన్ని అనుసరిస్తూ, పవిత్ర తోటలోకి వెళ్లి పూజించడానికి తమను తాము ప్రతిష్ఠించుకుని శుద్ధి చేసుకుంటారో, వారు తాము అనుసరించే వానితో పాటు నశిస్తారు” అని యెహోవా తెలియజేస్తున్నారు.<verse eid="ISA 66:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ISA 66:18"/>“వారి యొక్క పనులు వారి ఆలోచనలను బట్టి నేను అన్ని దేశాల ప్రజలను, రకరకాల భాషలు మాట్లాడేవారిని ఒక్కచోట చేర్చడానికి వస్తున్నాను. వారు వచ్చి నా మహిమను చూస్తారు.<verse eid="ISA 66:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="ISA 66:19"/>“నేను వారి ఎదుట ఒక సూచనను పెడతాను. వారిలో తప్పించుకున్న వారిని వేరే దేశాలకు అనగా, తర్షీషు, పూలు, లూదు (ప్రసిద్ధ విల్లుకాండ్రు) అనే దేశాల దగ్గరకు, తుబాలు గ్రీసులకు, నా గురించి నా మహిమ గురించి వినని దూరంగా ఉన్న ద్వీపవాసుల దగ్గరకు పంపిస్తాను. వారు దేశాల మధ్య నా మహిమ గురించి ప్రకటిస్తారు. <verse eid="ISA 66:19"/><verse number="20" style="v" sid="ISA 66:20"/>ఇశ్రాయేలీయులు పవిత్రమైన పాత్రల్లో భోజనార్పణల్ని యెహోవా మందిరంలోనికి తెచ్చినట్లు, గుర్రాల మీద, రథాల మీద, బండ్ల మీద, కంచరగాడిదల మీద, ఒంటెల మీద ఎక్కించి అన్ని దేశాల నుండి నా పరిశుద్ధ పర్వతమైన యెరూషలేముకు మీ ప్రజలందరినీ యెహోవాకు అర్పణగా వారు తీసుకువస్తారు” అని యెహోవా చెప్తున్నారు. <verse eid="ISA 66:20"/><verse number="21" style="v" sid="ISA 66:21"/>“యాజకులుగా లేవీయులుగా ఉండడానికి నేను వారిలో కొందరిని ఏర్పరచుకుంటాను” అని యెహోవా చెప్తున్నారు.<verse eid="ISA 66:21"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="22" style="v" sid="ISA 66:22"/>“నేను చేయబోయే క్రొత్త ఆకాశం, క్రొత్త భూమి, నా ఎదుట నిత్యం నిలిచి ఉన్నట్లు, నీ పేరు నీ సంతానం నిలిచి ఉంటుంది” అని యెహోవా తెలియజేస్తున్నారు. <verse eid="ISA 66:22"/><verse number="23" style="v" sid="ISA 66:23"/>“ప్రతి అమావాస్య రోజున, ప్రతి సబ్బాతు దినాన నా ఎదుట ఆరాధించడానికి ప్రజలందరూ వస్తారు” అని యెహోవా చెప్తున్నారు. <verse eid="ISA 66:23"/><verse number="24" style="v" sid="ISA 66:24"/>“వారు వెళ్లి నా మీద తిరుగుబాటు చేసిన వారి శవాలను చూస్తారు; వాటిని తినే పురుగులు చావవు, వాటిని కాల్చే అగ్ని ఆరిపోదు, మనుష్యులందరికి అది అసహ్యంగా ఉంటుంది.”<verse eid="ISA 66:24"/></para>
  <chapter eid="ISA 66"/>
</usx>
