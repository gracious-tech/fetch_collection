<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="DEU" style="id">- Biblica® Open Telugu Contemporary Version</book>
  
  <para style="h">ద్వితీయో</para>
  <para style="toc1">ద్వితీయోపదేశకాండం</para>
  <para style="toc2">ద్వితీయో</para>
  <para style="toc3">ద్వితీ</para>
  <para style="mt1">ద్వితీయోపదేశకాండం</para>
  <chapter number="1" style="c" sid="DEU 1" />
  <para style="s1">హోరేబును విడిచి వెళ్లమని ఆజ్ఞ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 1:1" />యొర్దానుకు తూర్పున ఉన్న అరణ్యంలో అనగా పారానుకు తోపెలు, లాబాను, హజేరోతు, దీజాహబ్ అనే స్థలాలకు మధ్య సూఫుకు ఎదురుగా ఉన్న అరాబాలో మోషే ఇశ్రాయేలీయులందరితో చెప్పిన మాటలు ఇవి. <verse eid="DEU 1:1" /><verse number="2" style="v" sid="DEU 1:2" />(సాధారణంగా శేయీరు పర్వత దారి గుండా హోరేబు నుండి కాదేషు బర్నియాకు ప్రయాణించడానికి పదకొండు రోజులు పడుతుంది.)<verse eid="DEU 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 1:3" />నలభైయవ సంవత్సరం, పదకొండవ నెల మొదటి రోజున మోషే ఇశ్రాయేలీయులను ఉద్దేశించి యెహోవా ఆజ్ఞాపించినదంతా వారికి ప్రకటించాడు. <verse eid="DEU 1:3" /><verse number="4" style="v" sid="DEU 1:4" />ఇది తాను హెష్బోనులో పరిపాలించిన అమోరీయుల రాజైన సీహోనును ఓడించిన తర్వాత, ఎద్రెయీ దగ్గర అష్తారోతులో పరిపాలించిన బాషాను రాజైన ఓగును ఓడించిన తర్వాత వారికి ప్రకటించాడు.<verse eid="DEU 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 1:5" />యొర్దాను తూర్పున మోయాబు దేశంలో మోషే ఈ ధర్మశాస్త్రాన్ని వివరించడం మొదలుపెట్టి ఇలా అన్నాడు:<verse eid="DEU 1:5" /></para>
  <para style="b" />
  <para style="p">
    <verse number="6" style="v" sid="DEU 1:6" />దేవుడైన యెహోవా హోరేబు దగ్గర మనతో ఇలా మాట్లాడారు, “మీరు ఈ పర్వతం దగ్గర చాలా కాలం నుండి ఉన్నారు. <verse eid="DEU 1:6" /><verse number="7" style="v" sid="DEU 1:7" />మీరు తిరిగి ప్రయాణమై అమోరీయుల కొండ ప్రాంతం వైపు వెళ్లండి; అరాబాలో, పర్వతాల్లో, పశ్చిమ కొండ ప్రాంతంలో, దక్షిణం వైపున సముద్రతీరంలో ఉన్న అన్ని స్థలాలకు, కనాను దేశానికి, లెబానోనుకు మహానదియైన యూఫ్రటీసు వరకు ఉన్న పొరుగు దేశాలకు వెళ్లండి. <verse eid="DEU 1:7" /><verse number="8" style="v" sid="DEU 1:8" />చూడండి, ఈ దేశాన్ని నేను మీకిచ్చాను. కాబట్టి మీరు వెళ్లి యెహోవా మీ పితరులైన అబ్రాహాము ఇస్సాకు యాకోబులకు, వారి తర్వాత వారి సంతానానికి ఇస్తానని ప్రమాణం చేసిన దేశాన్ని స్వాధీనం చేసుకోండి.”<verse eid="DEU 1:8" /></para>
  <para style="s1">నాయకుల నియామకం</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 1:9" />ఆ సమయంలో నేను మీతో, “నేను ఒంటరిగా మోయలేనంత భారంగా మీరున్నారు. <verse eid="DEU 1:9" /><verse number="10" style="v" sid="DEU 1:10" />మీ దేవుడైన యెహోవా మిమ్మల్ని విస్తరింపజేశారు కాబట్టి ఇప్పుడు మీరు ఆకాశ నక్షత్రాల్లా లెక్కించలేనంతగా ఉన్నారు. <verse eid="DEU 1:10" /><verse number="11" style="v" sid="DEU 1:11" />మీ పూర్వికుల దేవుడైన యెహోవా మిమ్మల్ని వెయ్యిరెట్లు ఎక్కువ చేసి ఆయన వాగ్దానం చేసినట్లుగా మిమ్మల్ని ఆశీర్వదించును గాక! <verse eid="DEU 1:11" /><verse number="12" style="v" sid="DEU 1:12" />అయితే నేనొక్కడినే మీ సమస్యలను మీ భారాలను మీ వివాదాలను ఎలా తీర్చగలను? <verse eid="DEU 1:12" /><verse number="13" style="v" sid="DEU 1:13" />ప్రతి గోత్రంలో నుండి జ్ఞాన వివేకాలు కలిగిన పురుషులను ఎంపిక చేయండి, నేను వారిని మీకు నాయకులుగా నియమిస్తాను” అని చెప్పాను.<verse eid="DEU 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 1:14" />అందుకు మీరు, “నీవు చెప్పింది బాగుంది” అని జవాబిచ్చారు.<verse eid="DEU 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 1:15" />కాబట్టి మీ గోత్రాల్లో నుండి జ్ఞానం కలిగి ప్రసిద్ధులైన వారిని పిలిపించి, వారిని మీ గోత్రాలకు అధికారులుగా, వేయిమందికి, వందమందికి, యాభైమందికి, పదిమందికి ఒక అధికారి ప్రకారం అధికారులుగా నియమించాను. <verse eid="DEU 1:15" /><verse number="16" style="v" sid="DEU 1:16" />అప్పుడు నేను మీ న్యాయాధిపతులతో, “మీ ప్రజలమధ్య ఉన్న వివాదాలు విని, ఇద్దరు ఇశ్రాయేలీయుల మధ్య అయినా లేదా ఒక ఇశ్రాయేలీయునికి ఒక విదేశీయునికి మధ్య అయినాసరే, న్యాయంగానే తీర్పు తీర్చాలి. <verse eid="DEU 1:16" /><verse number="17" style="v" sid="DEU 1:17" />తీర్పు తీర్చడంలో పక్షపాతం చూపించవద్దు; పేదవారైనా గొప్పవారైనా సరే ఒకే రీతిగా వినాలి, తీర్పు దేవునికి సంబంధించింది కాబట్టి ఎవరికి భయపడవద్దు. మీకు పరిష్కరించడానికి కష్టంగా ఉన్న సమస్యను నా దగ్గరకు తీసుకురండి, నేను దానిని వింటాను” అని చెప్పాను. <verse eid="DEU 1:17" /><verse number="18" style="v" sid="DEU 1:18" />మీరు చేయవలసిందంతా ఆ సమయంలో నేను మీకు చెప్పాను.<verse eid="DEU 1:18" /></para>
  <para style="s1">గూఢాచారులను పంపుట</para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 1:19" />తర్వాత మన దేవుడైన యెహోవా మనకు ఆజ్ఞాపించిన ప్రకారం, హోరేబు నుండి బయలుదేరి మీరు చూసిన భయంకరమైన మహారణ్యం గుండా వచ్చి, అమోరీయుల కొండ ప్రాంతం ద్వారా ప్రయాణించి కాదేషు బర్నియాకు చేరుకున్నాము. <verse eid="DEU 1:19" /><verse number="20" style="v" sid="DEU 1:20" />అప్పుడు నేను మీతో, “మన దేవుడైన యెహోవా మనకు ఇస్తున్న అమోరీయుల కొండ ప్రాంతానికి మీరు చేరుకున్నారు. <verse eid="DEU 1:20" /><verse number="21" style="v" sid="DEU 1:21" />చూడండి, మీ దేవుడైన యెహోవా మీకు ఈ దేశాన్ని ఇచ్చారు. మీ పూర్వికుల దేవుడైన యెహోవా మీతో చెప్పినట్లుగా, వెళ్లి దానిని స్వాధీనపరచుకోండి. భయపడకండి; అధైర్యపడకండి” అని చెప్పాను.<verse eid="DEU 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 1:22" />అప్పుడు మీరందరు నా దగ్గరకు వచ్చి, “ఆ దేశంలో గూఢచర్యం చేసి మనం వెళ్లవలసిన దారి, మనం వెళ్లే పట్టణాల గురించి సమాచారం తెలుసుకోవడానికి ముందుగానే కొంతమందిని పంపుదాం” అన్నారు.<verse eid="DEU 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 1:23" />ఈ ఆలోచన నాకు నచ్చింది కాబట్టి మీలో ప్రతి గోత్రం నుండి ఒకరు చొప్పున పన్నెండుమందిని పంపాను. <verse eid="DEU 1:23" /><verse number="24" style="v" sid="DEU 1:24" />వారు అక్కడినుండి కొండ ప్రాంతానికి ఎక్కి వెళ్లి ఎష్కోలు లోయకు వచ్చి దాన్ని పరిశీలించారు. <verse eid="DEU 1:24" /><verse number="25" style="v" sid="DEU 1:25" />వారు ఆ దేశపు పండ్లు కొన్ని మన దగ్గరకు తెచ్చి, “మన దేవుడైన యెహోవా మనకిస్తున్న దేశం మంచిది” అని చెప్పారు.<verse eid="DEU 1:25" /></para>
  <para style="s1">యెహోవాకు వ్యతిరేకంగా తిరుగుబాటు</para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 1:26" />కాని మీరు వెళ్లడానికి ఇష్టపడలేదు; మీ దేవుడైన యెహోవా ఆజ్ఞకు తిరుగుబాటు చేశారు. <verse eid="DEU 1:26" /><verse number="27" style="v" sid="DEU 1:27" />మీ గుడారాల్లో సణుగుతూ, “యెహోవా మనలను ద్వేషించి మనలను నాశనం చేయడానికి అమోరీయుల చేతికి మనలను అప్పగించడానికి ఈజిప్టు నుండి మనలను బయటకు తీసుకువచ్చారు. <verse eid="DEU 1:27" /><verse number="28" style="v" sid="DEU 1:28" />మనం ఎక్కడికి వెళ్లగలం? మన సహోదరులు, ‘అక్కడి ప్రజలు మనకన్నా బలవంతులు, పొడవైనవారు; ఆ పట్టణాలు ఎంతో పెద్దవిగా ఆకాశమంత ఎత్తైన గోడలతో ఉన్నాయి; అక్కడ అనాకీయులను కూడా చూశాం’ అని చెప్పి మా గుండెలు భయంతో చెదిరిపోయేలా చేశారు” అన్నారు.<verse eid="DEU 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DEU 1:29" />అప్పుడు నేను మీతో, “దిగులుపడకండి, వారికి భయపడకండి. <verse eid="DEU 1:29" /><verse number="30" style="v" sid="DEU 1:30" />మీకు ముందుగా నడుస్తున్న మీ దేవుడైన యెహోవా మీ కళ్ళెదుట ఈజిప్టులోను అరణ్యంలోను మీ కోసం చేసినట్లు ఆయన మీ కోసం యుద్ధం చేస్తారు, <verse eid="DEU 1:30" /><verse number="31" style="v" sid="DEU 1:31" />మీరు ఈ స్థలానికి చేరుకునేవరకు తండ్రి తన కుమారుని ఎత్తుకున్నట్లు మీ దేవుడైన యెహోవా మీ మార్గమంతటిలో మిమ్మల్ని ఎలా ఎత్తుకుని వచ్చారో మీరు చూశారు” అని అన్నాను.<verse eid="DEU 1:31" /></para>
  <para style="p">
    <verse number="32-33" style="v" sid="DEU 1:32-33" />ఇంత చెప్పినా, మీ ప్రయాణమంతటిలో మీరు బస కోసం చోటు వెదకడానికి, మీరు వెళ్లవలసిన మార్గాన్ని మీకు చూపించడానికి రాత్రివేళ అగ్నిలో, పగటివేళ మేఘంలో మీకు ముందుగా నడిచిన మీ దేవుడైన యెహోవాయందు మీరు నమ్మకం ఉంచలేదు.<verse eid="DEU 1:32-33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="DEU 1:34" />మీరు చెప్పిన మాటలు యెహోవా విన్నప్పుడు ఆయన కోపంతో, కాబట్టి ఆయన ప్రమాణ చేస్తూ, <verse eid="DEU 1:34" /><verse number="35" style="v" sid="DEU 1:35" />“నేను మీ పూర్వికులకు ఇస్తానని వాగ్దానం చేసిన ఈ మంచి దేశాన్ని ఈ చెడ్డతరంలో <verse eid="DEU 1:35" /><verse number="36" style="v" sid="DEU 1:36" />యెఫున్నె కుమారుడైన కాలేబు తప్ప మరి ఎవరు చూడరు. అతడు హృదయమంతటితో యెహోవాను అనుసరించాడు కాబట్టి దానిని చూస్తాడు. అతడు అడుగుపెట్టిన దేశాన్ని అతనికి, అతని సంతానానికి నేను ఇస్తాను” అని ప్రమాణం చేశారు.<verse eid="DEU 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="DEU 1:37" />మీ కారణంగా యెహోవా నా మీద కూడా కోప్పడి, “నీవు కూడా ఆ దేశంలో అడుగుపెట్టవు. <verse eid="DEU 1:37" /><verse number="38" style="v" sid="DEU 1:38" />కాని, నీ సహాయకుడు నూను కుమారుడైన యెహోషువ దానిలో అడుగుపెడతాడు. దానిని స్వాధీనపరచుకునేలా అతడు ఇశ్రాయేలీయులను నడిపిస్తాడు కాబట్టి అతన్ని ప్రోత్సహించు. <verse eid="DEU 1:38" /><verse number="39" style="v" sid="DEU 1:39" />బందీలుగా వెళ్తారని మీరు చెప్పిన మంచి చెడు తెలియని మీ పిల్లలు ఆ దేశంలో అడుగుపెడతారు. నేను దానిని వారికి ఇస్తాను, వారు దానిని స్వాధీనం చేసుకుంటారు. <verse eid="DEU 1:39" /><verse number="40" style="v" sid="DEU 1:40" />మీరైతే వెనుకకు తిరిగి ఎర్ర సముద్ర మార్గంలో అరణ్యంలోనికి ప్రయాణించండి” అని అన్నారు.<verse eid="DEU 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="DEU 1:41" />అప్పుడు మీరు, “మేము యెహోవాకు వ్యతిరేకంగా పాపం చేశాము. మా దేవుడైన యెహోవా మాకు ఆజ్ఞాపించిన ప్రకారం మేము వెళ్లి పోరాడతాం” అని నాతో చెప్పి మీ ఆయుధాలను ధరించి కొండసీమ మీదికి వెళ్లడం సులభమనుకుని మీలో ప్రతి ఒక్కరు సిద్ధపడ్డారు.<verse eid="DEU 1:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="DEU 1:42" />అయితే యెహోవా నాతో, “యుద్ధానికి మీరు వెళ్లకండి. ఎందుకంటే నేను మీతో ఉండను. మీరు మీ శత్రువుల చేతిలో ఓడిపోతారు” అని చెప్పారు.<verse eid="DEU 1:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="DEU 1:43" />నేను మీతో ఆ సంగతి చెప్పాను కాని మీరు వినలేదు. యెహోవా ఆజ్ఞకు వ్యతిరేకంగా మీరు తిరుగుబాటు చేసి మీ అహంకారాన్ని బట్టి కొండసీమ ప్రాంతానికి ఎక్కి వెళ్లారు. <verse eid="DEU 1:43" /><verse number="44" style="v" sid="DEU 1:44" />ఆ కొండల్లో నివసిస్తున్న అమోరీయులు మీ మీదికి వచ్చి కందిరీగల్లా మిమ్మల్ని శేయీరు నుండి హోర్మా వరకు తరిమికొట్టారు. <verse eid="DEU 1:44" /><verse number="45" style="v" sid="DEU 1:45" />అప్పుడు మీరు తిరిగివచ్చి యెహోవా ఎదుట ఏడ్చారు కాని ఆయన మిమ్మల్ని లక్ష్యపెట్టలేదు మీ మొర వినలేదు. <verse eid="DEU 1:45" /><verse number="46" style="v" sid="DEU 1:46" />కాబట్టి మీరు కాదేషులో చాలా రోజులు ఉండిపోయారు. అక్కడ ఎన్ని రోజులు నివసించారో మీకు తెలుసు.<verse eid="DEU 1:46" /></para>
  <chapter eid="DEU 1" />
  <chapter number="2" style="c" sid="DEU 2" />
  <para style="s1">అరణ్యంలో సంచారం</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 2:1" />యెహోవా నాతో చెప్పిన ప్రకారం మనం వెనుకకు తిరిగి ఎర్ర సముద్ర మార్గంలో అరణ్యంలోనికి ప్రయాణమై వెళ్లి చాలా రోజులు శేయీరు కొండ ప్రాంతం చుట్టూ తిరిగాము.<verse eid="DEU 2:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="DEU 2:2" />అప్పుడు యెహోవా నాతో ఇలా అన్నారు, <verse eid="DEU 2:2" /><verse number="3" style="v" sid="DEU 2:3" />“మీరు ఈ కొండ ప్రాంతం చుట్టూ తిరిగింది చాలు; ఉత్తరం వైపు తిరగండి. <verse eid="DEU 2:3" /><verse number="4" style="v" sid="DEU 2:4" />ప్రజలకు ఈ ఆదేశాలు ఇవ్వు: ‘శేయీరులో నివసిస్తున్న ఏశావు సంతానమైన మీ బంధువుల భూభాగం గుండా వెళ్లబోతున్నారు. వారు మీకు భయపడతారు, కానీ చాలా జాగ్రత్తగా ఉండండి. <verse eid="DEU 2:4" /><verse number="5" style="v" sid="DEU 2:5" />వారితో ఘర్షణ పడకండి, ఎందుకంటే నేను వారి భూమిలో ఒక్క అడుగు కూడా మీకు ఇవ్వను. నేను ఏశావుకు స్వాస్థ్యంగా శేయీరు కొండ ప్రాంతాన్ని ఇచ్చాను. <verse eid="DEU 2:5" /><verse number="6" style="v" sid="DEU 2:6" />మీరు వారికి వెండి ఇచ్చి తినడానికి ఆహారం, త్రాగడానికి నీరు కొనుక్కోవాలి.’ ”<verse eid="DEU 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 2:7" />మీ దేవుడైన యెహోవా మీ చేతి పనులన్నిటిని ఆశీర్వదించారు, ఈ గొప్ప అరణ్యం గుండా మీ ప్రయాణాన్ని ఆయన చూసుకున్నారు. ఈ నలభై సంవత్సరాలు మీ దేవుడైన యెహోవా మీకు తోడుగా ఉన్నారు, మీకు ఏది తక్కువ కాలేదు.<verse eid="DEU 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 2:8" />శేయీరులో నివసిస్తున్న మన బంధువులైన ఏశావు సంతతివారిని విడిచిపెట్టి ముందుకు సాగాము. ఏలతు, ఎసోన్-గెబెరు నుండి వచ్చే అరాబా మార్గం నుండి మనం బయలుదేరి మోయాబు ఎడారి మార్గంలో ప్రయాణించాము.<verse eid="DEU 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 2:9" />అప్పుడు యెహోవా నాతో అన్నారు, “మోయాబీయులను బాధపెట్టకండి లేదా వారితో ఘర్షణ పడకండి, ఎందుకంటే వారి భూమిలో మీకు ఏమి ఇవ్వను. నేను లోతు సంతానానికి ఆరు దేశాన్ని స్వాస్థ్యంగా ఇచ్చాను.”<verse eid="DEU 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 2:10" />గతంలో ఎమీయులు ఆ దేశంలో నివసించేవారు, వారు బలవంతులు అనేకమంది, వారు అనాకీయుల్లా పొడవైనవారు. <verse eid="DEU 2:10" /><verse number="11" style="v" sid="DEU 2:11" />అనాకీయుల్లా వారిని కూడా రెఫాయీయులుగా పరిగణించేవారు కాని మోయాబీయులు వారికి ఎమీయులు అని పేరు పెట్టారు. <verse eid="DEU 2:11" /><verse number="12" style="v" sid="DEU 2:12" />గతంలో హోరీయులు శేయీరులో నివసించేవారు, అయితే ఏశావు సంతతివారు, ఇశ్రాయేలీయులు యెహోవా తమకు స్వాస్థ్యంగా ఇచ్చిన దేశంలో చేసినట్లుగా, వారిని తరిమివేశారు. వారు హోరీయులను తమ ఎదుట నుండి నాశనం చేసి వారి దేశంలో స్థిరపడ్డారు.<verse eid="DEU 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 2:13" />యెహోవా అన్నారు, “ఇప్పుడు మీరు లేచి జెరెదు వాగు దాటండి.” కాబట్టి మనం వాగు దాటాము.<verse eid="DEU 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 2:14" />మనం కాదేషు బర్నియాలో నుండి బయలుదేరి జెరెదు వాగు దాటే వరకు ముప్పై ఎనిమిది సంవత్సరాలు గడిచాయి. యెహోవా వారికి ప్రమాణం చేసిన రీతిగా, సైనికులుగా ఉన్న వారి తరమంతా అప్పటి శిబిరం నుండి నశించిపోయింది. <verse eid="DEU 2:14" /><verse number="15" style="v" sid="DEU 2:15" />ఆయన వారిని శిబిరంలో నుండి పూర్తిగా తొలగించే వరకు యెహోవా చేయి వారికి వ్యతిరేకంగా ఉంది.<verse eid="DEU 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 2:16" />ప్రజల మధ్యలో నుండి ఈ సైనికులు అందరు చనిపోయిన తర్వాత, <verse eid="DEU 2:16" /><verse number="17" style="v" sid="DEU 2:17" />యెహోవా నాతో ఇలా చెప్పారు, <verse eid="DEU 2:17" /><verse number="18" style="v" sid="DEU 2:18" />“ఈ రోజు మీరు మోయాబుకు సరిహద్దుగా ఉన్న ఆరు దేశాన్ని దాటబోతున్నారు. <verse eid="DEU 2:18" /><verse number="19" style="v" sid="DEU 2:19" />మీరు అమ్మోనీయుల దగ్గరకు వచ్చినప్పుడు, మీరు వారిని బాధించవద్దు వారిని యుద్ధానికి రెచ్చగొట్టవద్దు. ఎందుకంటే అమ్మోనీయులకు చెందిన దేశంలో ఏది మీకు ఇవ్వను. ఆ దేశాన్ని నేను లోతు సంతతికి స్వాస్థ్యంగా ఇచ్చాను.”<verse eid="DEU 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 2:20" />అది కూడా రెఫాయీయుల దేశం అని పరిగణించబడింది; గతంలో రెఫాయీయులు అక్కడ నివసించేవారు. అయితే అమ్మోనీయులు వారికి జంజుమ్మీయులు అని పిలిచేవారు. <verse eid="DEU 2:20" /><verse number="21" style="v" sid="DEU 2:21" />వారు బలవంతులు, అనేకమంది, అనాకీయుల్లా పొడువైనవారు. యెహోవా అమ్మోనీయుల ఎదుట నుండి వారిని వెళ్లగొట్టారు, కాబట్టి అమ్మోనీయులు వారి దేశాన్ని స్వాధీనం చేసుకుని వారి దేశంలో స్థిరపడ్డారు. <verse eid="DEU 2:21" /><verse number="22" style="v" sid="DEU 2:22" />శేయీరులో నివసిస్తున్న ఏశావు సంతానం కోసం కూడా యెహోవా ఇలాగే చేశారు. ఆయన వారి ఎదుట నుండి హోరీయులను నాశనం చేశారు, కాబట్టి వారు వారిని తరిమి ఇప్పటివరకు వారి దేశంలో నివసిస్తున్నారు. <verse eid="DEU 2:22" /><verse number="23" style="v" sid="DEU 2:23" />గాజా వరకు గ్రామాల్లో నివసించిన ఆవీయులను కఫ్తోరులో<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false">అంటే, క్రేతు</char></note> నుండి వచ్చిన కఫ్తోరీయులు నాశనం చేసి వారి దేశంలో స్థిరపడ్డారు.<verse eid="DEU 2:23" /></para>
  <para style="s1">హెష్బోను రాజైన సీహోను యొక్క ఓటమి</para>
  <para style="p">
    <verse number="24" style="v" sid="DEU 2:24" />“మీరు లేచి బయలుదేరి అర్నోను వాగు దాటండి. చూడండి, అమోరీయుడైన హెష్బోను రాజైన సీహోనును అతని దేశాన్ని మీ చేతికి అప్పగించాను. దానిని స్వాధీనం చేసుకోవడం మొదలుపెట్టి అతనితో యుద్ధం చేయండి. <verse eid="DEU 2:24" /><verse number="25" style="v" sid="DEU 2:25" />ఈ రోజే నేను ఆకాశం క్రింద ఉన్న అన్ని దేశాలకు మీరంటే భయాన్ని, వణుకుని కలిగించడం మొదలుపెడతాను. వారు మీ గురించి సమాచారాన్ని విని వణుకుతారు; మీ కారణంగా వారు కలవరపడతారు.”<verse eid="DEU 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 2:26" />కెదేమోతు ఎడారి నుండి నేను హెష్బోను రాజైన సీహోను దగ్గరకు దూతలను పంపి సమాధానాన్ని తెలియజేశాను, <verse eid="DEU 2:26" /><verse number="27" style="v" sid="DEU 2:27" />“మీ దేశం మీదుగా మమ్మల్ని వెళ్లనివ్వండి. మేము కుడి ఎడమల వైపు తిరగము, రహదారి మీదనే వెళ్తాము. <verse eid="DEU 2:27" /><verse number="28" style="v" sid="DEU 2:28" />మా దగ్గర నుండి వెండి తీసుకుని తినడానికి ఆహారం త్రాగడానికి నీళ్లు ఇవ్వండి. మమ్మల్ని కాలినడకన వెళ్లనివ్వండి. <verse eid="DEU 2:28" /><verse number="29" style="v" sid="DEU 2:29" />శేయీరులో నివసించే ఏశావు సంతతివారు ఆరులో మోయాబీయులు మాకు చేసినట్టే మా దేవుడైన యెహోవా మాకు ఇస్తున్న దేశానికి వెళ్లడానికి కాలినడకన యొర్దాను దాటి వెళ్లనివ్వండి” అని తెలియజేశాను. <verse eid="DEU 2:29" /><verse number="30" style="v" sid="DEU 2:30" />అయితే హెష్బోను రాజైన సీహోను మనం అతని దేశం గుండా వెళ్లడానికి అనుమతించలేదు. ఎందుకంటే ఇప్పుడు జరిగినట్లుగా అతన్ని మీ చేతికి అప్పగించడానికి మీ దేవుడైన యెహోవా అతని మనస్సు కఠినపరచి అతని హృదయాన్ని మొండిగా మార్చారు.<verse eid="DEU 2:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="DEU 2:31" />అప్పుడు యెహోవా నాతో అన్నారు, “చూడండి, నేను సీహోనును, అతని దేశాన్ని మీకు అప్పగించడం మొదలుపెట్టాను. అతని దేశాన్ని జయించి స్వాధీనం చేసుకోవడం మొదలుపెట్టండి.”<verse eid="DEU 2:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="DEU 2:32" />సీహోను అతని సైన్యమంతా యాహాజులో మనతో యుద్ధం చేయడానికి వచ్చినప్పుడు, <verse eid="DEU 2:32" /><verse number="33" style="v" sid="DEU 2:33" />మన దేవుడైన యెహోవా అతన్ని మనకు అప్పగించారు కాబట్టి అతన్ని, అతని కుమారులను, అతని సైన్యమంతటిని మనం హతం చేశాము. <verse eid="DEU 2:33" /><verse number="34" style="v" sid="DEU 2:34" />ఆ సమయంలో అతని పట్టణాలన్నిటిని, వాటిలో ఉన్న పురుషులు, స్త్రీలు, పిల్లలు ఎవరు మిగులకుండా పూర్తిగా నాశనం చేశాము. <verse eid="DEU 2:34" /><verse number="35" style="v" sid="DEU 2:35" />అయితే మన కోసం పశువులను, ఆ పట్టణాల సొమ్మును దోచుకున్నాము. <verse eid="DEU 2:35" /><verse number="36" style="v" sid="DEU 2:36" />అర్నోను వాగు ఒడ్డున ఉన్న అరోయేరు నుండి, ఆ వాగు దగ్గర ఉన్న పట్టణం మొదలుపెట్టి గిలాదు వరకు మనలను మించి బలం కలిగిన పట్టణం ఒకటి కూడా లేదు. మన దేవుడైన యెహోవా వాటన్నిటిని మనకు అప్పగించారు. <verse eid="DEU 2:36" /><verse number="37" style="v" sid="DEU 2:37" />అయితే మన దేవుడైన యెహోవా ఆజ్ఞ ప్రకారం అమ్మోనీయుల దేశాన్ని కాని యబ్బోకు వాగు లోయలోని ఏ ప్రాంతాన్ని కాని కొండల్లో ఉన్న పట్టణాలను కాని మీరు ఆక్రమించలేదు.<verse eid="DEU 2:37" /></para>
  <chapter eid="DEU 2" />
  <chapter number="3" style="c" sid="DEU 3" />
  <para style="s1">బాషాను రాజైన ఓగు ఓటమి</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 3:1" />తర్వాత మనం తిరిగి బాషానుకు వెళ్లే మార్గంలో వెళ్లాము. అప్పుడు బాషాను రాజైన ఓగు తన సైన్యమంతటితో ఎద్రెయీ దగ్గర యుద్ధంలో మనలను ఎదుర్కోడానికి బయలుదేరాడు. <verse eid="DEU 3:1" /><verse number="2" style="v" sid="DEU 3:2" />యెహోవా నాతో, “అతనికి భయపడకండి, ఎందుకంటే అతన్ని, అతని సైన్యమంతటిని, అతని దేశాన్ని మీ చేతికి అప్పగించాను. హెష్బోనును పరిపాలించిన అమోరీయుల రాజైన సీహోనుకు చేసినట్లు అతనికి చేయండి” అని అన్నారు.<verse eid="DEU 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 3:3" />కాబట్టి మన దేవుడైన యెహోవా బాషాను రాజైన ఓగును, అతని సైన్యమంతటిని మన చేతికి అప్పగించారు. వారిలో ఎవరిని మిగల్చకుండా అందరిని హతం చేశాము. <verse eid="DEU 3:3" /><verse number="4" style="v" sid="DEU 3:4" />ఆ సమయంలో అతని పట్టణాలన్నిటిని మనం స్వాధీనం చేసుకున్నాము. బాషానులో ఓగు రాజ్యమైన అర్గోబు ప్రాంతమంతటిలో ఉన్న అరవై పట్టణాల్లో స్వాధీనం చేసుకోనిది ఒక్కటి కూడా లేదు. <verse eid="DEU 3:4" /><verse number="5" style="v" sid="DEU 3:5" />ఈ పట్టణాలన్ని ఎత్తైన గోడలు, ద్వారాలు గడియలతో పటిష్టంగా ఉన్నాయి, వీటితో పాటు గోడలులేని అనేక గ్రామాలు కూడా ఉన్నాయి. <verse eid="DEU 3:5" /><verse number="6" style="v" sid="DEU 3:6" />హెష్బోను రాజైన సీహోనుకు చేసినట్లే ప్రతి పట్టణంలోని స్త్రీ పురుషులు, పిల్లలను పూర్తిగా నాశనం చేశాము. <verse eid="DEU 3:6" /><verse number="7" style="v" sid="DEU 3:7" />అయితే మన కోసం పశువులన్నిటిని, వారి పట్టణాల నుండి సొమ్మును దోచుకున్నాము.<verse eid="DEU 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 3:8" />ఆ సమయంలో ఈ ఇద్దరు అమోరీయుల రాజుల నుండి అర్నోను వాగు మొదలుకొని హెర్మోను పర్వతం వరకు యొర్దానుకు తూర్పున ఉన్న ప్రాంతాన్ని స్వాధీనం చేసుకున్నాము. <verse eid="DEU 3:8" /><verse number="9" style="v" sid="DEU 3:9" />హెర్మోనును సీదోనీయులు షిర్యోను అంటారు; అమోరీయులు శెనీరు అని పిలుస్తారు. <verse eid="DEU 3:9" /><verse number="10" style="v" sid="DEU 3:10" />పీఠభూమిలో ఉన్న పట్టణాలన్నిటిని, బాషానులో ఓగు రాజ్యంలోని పట్టణాలైన సలేకా ఎద్రెయీల వరకు గిలాదు అంతటిని, బాషానును అంతటిని స్వాధీనం చేసుకున్నాము. <verse eid="DEU 3:10" /><verse number="11" style="v" sid="DEU 3:11" />రెఫాయీయులలో బాషాను రాజైన ఓగు చివరివాడు. అతని సమాధి ఇనుముతో చేయబడి తొమ్మిది మూరల పొడవు నాలుగు మూరల వెడల్పు<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false">సుమారు 4 మీటర్ల పొడవు 1.8 మీటర్ల వెడల్పు</char></note> కలది. అది ఇంకా అమ్మోనీయులకు చెందిన రబ్బాలో ఉంది.<verse eid="DEU 3:11" /></para>
  <para style="s1">భూభాగాన్ని విభజించుట</para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 3:12" />ఆ సమయంలో మనం స్వాధీనం చేసుకున్న దేశాన్ని అనగా అర్నోను వాగు లోయలో ఉన్న అరోయేరు నుండి గిలాదు కొండ ప్రాంతంలోని సగభాగాన్ని దానిలో ఉన్న పట్టణాలతో కలిపి రూబేనీయులకు గాదీయులకు ఇచ్చాను. <verse eid="DEU 3:12" /><verse number="13" style="v" sid="DEU 3:13" />గిలాదులో మిగతా ప్రాంతాన్ని, ఓగు రాజ్యమైన బాషాను అంతటిని మనష్షే అర్ధగోత్రానికి ఇచ్చాను. బాషానులోని అర్గోబు ప్రాంతమంతా రెఫాయీయుల దేశమని పిలువబడేది. <verse eid="DEU 3:13" /><verse number="14" style="v" sid="DEU 3:14" />మనష్షే సంతానమైన యాయీరు అర్గోబు ప్రాంతమంతా గెషూరీయుల మయకాతీయుల సరిహద్దుల వరకు స్వాధీనపరచుకున్నాడు. దానికి అతని పేరు పెట్టబడింది కాబట్టి నేటికీ బాషాను హవ్వోత్ యాయీరు<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">యాయీరు స్థావరాలు</char></note> అని పిలుస్తారు. <verse eid="DEU 3:14" /><verse number="15" style="v" sid="DEU 3:15" />గిలాదును మాకీరుకు ఇచ్చాను. <verse eid="DEU 3:15" /><verse number="16" style="v" sid="DEU 3:16" />అయితే రూబేనీయులకు, గాదీయులకు గిలాదు నుండి అర్నోను వాగు లోయ మధ్య వరకు, యబ్బోకు నది వరకు, అమ్మోనీయుల సరిహద్దు వరకు నేను ఇచ్చాను. <verse eid="DEU 3:16" /><verse number="17" style="v" sid="DEU 3:17" />దాని పశ్చిమ సరిహద్దు కిన్నెరెతు<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">గలిలయ సరస్సు</char></note> నుండి పిస్గా కొండచరియల తూర్పున, మృత సముద్రమనే అరాబా సముద్రం వరకు వ్యాపించి ఉన్న అరాబాలోని యొర్దాను నది.<verse eid="DEU 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 3:18" />ఆ సమయంలో నేను యొర్దాను తూర్పున నివసిస్తున్న గోత్రాలకు మీకు ఇలా ఆజ్ఞాపించాను: “మీ దేవుడైన యెహోవా మీరు స్వాధీనం చేసుకోవడానికి మీకు ఈ దేశాన్ని ఇచ్చారు. అయితే మీలో ధృడమైనవారు, యుద్ధానికి సిద్ధపడినవారు ఇతర ఇశ్రాయేలీయులకు ముందుగా నది దాటాలి. <verse eid="DEU 3:18" /><verse number="19-20" style="v" sid="DEU 3:19-20" />అయితే యెహోవా మీకు విశ్రాంతి ఇచ్చినట్టు మీ సోదరులకును విశ్రాంతి ఇచ్చేవరకు, అంటే యొర్దాను అవతల మీ దేవుడైన యెహోవా వారికి ఇస్తున్న దేశాన్ని వారు స్వాధీనం చేసుకునేవరకు మీ భార్యలు, మీ పిల్లలు మీ పశువులు నేను మీకిచ్చిన పట్టణాల్లోనే ఉండాలి. ఆ తర్వాత నేను మీకు ఇచ్చిన స్వాస్థ్యాలకు ప్రతి ఒక్కరు తిరిగి వెళ్లవచ్చు.”<verse eid="DEU 3:19-20" /></para>
  <para style="s1">యొర్దాను దాటడం మోషేకు నిషేధం</para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 3:21" />ఆ సమయంలో నేను యెహోషువకు ఆజ్ఞాపించాను: “నీవు నీ కళ్లారా దేవుడైన యెహోవా ఈ ఇద్దరు రాజులకు చేసిందంతా చూశావు. నీవు వెళ్లబోయే చోటులో ఉన్న అన్ని రాజ్యాలకు యెహోవా అలాగే చేస్తారు. <verse eid="DEU 3:21" /><verse number="22" style="v" sid="DEU 3:22" />వారికి నీవు భయపడకు; నీ దేవుడైన యెహోవా మీ పక్షంగా యుద్ధం చేస్తారు.”<verse eid="DEU 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 3:23" />ఆ సమయంలో నేను యెహోవాను బ్రతిమాలుకున్నాను: <verse eid="DEU 3:23" /><verse number="24" style="v" sid="DEU 3:24" />“ప్రభువైన యెహోవా, మీ గొప్పతనాన్ని, మీ బలమైన చేతిని మీ సేవకునికి చూపించడం మొదలుపెట్టారు. ఆకాశంలో గాని భూమిమీదగాని మీరు చేసే పనులు, అద్భుతకార్యాలు చేయగల దేవుడెవరున్నారు? <verse eid="DEU 3:24" /><verse number="25" style="v" sid="DEU 3:25" />నేను వెళ్లి యొర్దాను అవతల ఉన్న మంచి దేశాన్ని, మంచి కొండ ప్రాంతాన్ని, లెబానోనును చూడనివ్వండి.”<verse eid="DEU 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 3:26" />అయితే మీ కారణంగా యెహోవా నా మీద కోప్పడి, నా మొర వినలేదు. యెహోవా నాతో అన్నారు, “ఇక చాలు, ఈ విషయమై నాతో ఇక మాట్లాడవద్దు. <verse eid="DEU 3:26" /><verse number="27" style="v" sid="DEU 3:27" />నీవు పిస్గా కొండ శిఖరం పైకెక్కి అక్కడినుండి పడమర, ఉత్తరం, దక్షిణం, తూర్పు వైపులకు చూడు. నీవు యొర్దాను నది దాటవు కాబట్టి నీ కళ్లారా ఆ దేశాన్ని చూడు. <verse eid="DEU 3:27" /><verse number="28" style="v" sid="DEU 3:28" />అయితే యెహోషువను నియమించి, అతన్ని ప్రోత్సాహించి బలపరచు, ఎందుకంటే అతడు ఈ ప్రజలను నది దాటిస్తాడు, నీవు చూడబోయే దేశాన్ని వారు స్వాధీనపరచుకునేలా చేస్తాడు.” <verse eid="DEU 3:28" /><verse number="29" style="v" sid="DEU 3:29" />కాబట్టి మనం బేత్-పెయోరు దగ్గర ఉన్న లోయలో ఉన్నాము.<verse eid="DEU 3:29" /></para>
  <chapter eid="DEU 3" />
  <chapter number="4" style="c" sid="DEU 4" />
  <para style="s1">విధేయత చూపాలని ఆజ్ఞ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 4:1" />ఇప్పుడు, ఇశ్రాయేలూ, నేను మీకు బోధించే శాసనాలు చట్టాలను వినండి. మీరు జీవించి, మీ పూర్వికుల దేవుడైన యెహోవా మీకు ఇస్తున్న దేశంలోకి వెళ్లి స్వాధీనం చేసుకోవడానికి వాటిని అనుసరించండి. <verse eid="DEU 4:1" /><verse number="2" style="v" sid="DEU 4:2" />నేను మీకు ఆజ్ఞాపించిన మాటతో దేన్ని కలుపకూడదు, దాని నుండి దేన్ని తీసివేయకూడదు, కాని నేను మీకు ఇస్తున్న మీ దేవుడైన యెహోవా ఆజ్ఞలను పాటించండి.<verse eid="DEU 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 4:3" />బయల్-పెయోరు విషయంలో యెహోవా చేసిన దానిని మీరు కళ్లారా చూశారు. బయల్-పెయోరును వెంబడించిన వారందరిని మీ దేవుడైన యెహోవా మీ మధ్యలో ఉండకుండా నాశనం చేశారు, <verse eid="DEU 4:3" /><verse number="4" style="v" sid="DEU 4:4" />కాని మీ దేవుడైన యెహోవాను నమ్మకంగా పట్టుకుని ఉన్న మీరందరు ఈ రోజు వరకు బ్రతికి ఉన్నారు.<verse eid="DEU 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 4:5" />చూడండి, నా దేవుడైన యెహోవా నాకు ఆజ్ఞాపించిన ప్రకారం మీరు స్వాధీనం చేసుకోబోయే దేశంలో మీరు పాటించవలసిన శాసనాలను చట్టాలను నేను మీకు బోధించాను. <verse eid="DEU 4:5" /><verse number="6" style="v" sid="DEU 4:6" />వాటిని జాగ్రతగా పాటించండి. ఈ శాసనాలన్నిటి గురించి వినే దేశాలకు అవే మీ జ్ఞానాన్ని మీ వివేకాన్ని తెలియజేస్తాయి; వారు, “ఈ గొప్ప దేశం ఖచ్చితంగా జ్ఞానం వివేకం కలిగిన ప్రజలు” అని చెప్పుకుంటారు. <verse eid="DEU 4:6" /><verse number="7" style="v" sid="DEU 4:7" />మనం ఆయనకు ప్రార్థన చేసినప్పుడు మన దేవుడైన యెహోవా మనకు సమీపంగా ఉన్నట్లు మరి ఏ గొప్పప్రజలకు వారి దేవుళ్ళు సమీపంగా ఉంటారు? <verse eid="DEU 4:7" /><verse number="8" style="v" sid="DEU 4:8" />ఈ రోజు నేను మీ ఎదుట పెట్టిన ఈ ధర్మశాస్త్రమంతటిలో నీతిగల శాసనాలు, చట్టాలు ఏ గొప్ప దేశం కలిగి ఉంది?<verse eid="DEU 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 4:9" />అయితే జాగ్రత్తగా ఉండండి, మీరు మీ కళ్లారా చూసినవాటిని మరచిపోకుండా, మీరు జీవితాంతం మీ హృదయంలోనుండి చెరిగిపోకుండా జాగ్రత్త వహించండి. మీ పిల్లలకు వారి తర్వాత వారి పిల్లలకు వాటిని బోధించండి. <verse eid="DEU 4:9" /><verse number="10" style="v" sid="DEU 4:10" />హోరేబు దగ్గర మీ దేవుడైన యెహోవా ఎదుట మీరు నిలబడినప్పుడు ఆయన నాతో, “వారు ఆ దేశంలో జీవించినంత వరకు నాకు భయపడడం నేర్చుకొని, వాటిని తమ పిల్లలకు నేర్పేలా వారు నా మాటలు వినడానికి ప్రజలందర్ని సమకూర్చు” అని చెప్పిన రోజును జ్ఞాపకం ఉంచుకోండి. <verse eid="DEU 4:10" /><verse number="11" style="v" sid="DEU 4:11" />మీరంతా దగ్గరకు వచ్చి ఆ పర్వతం క్రింద నిలబడ్డారు, అది దట్టమైన మేఘాలు, కటిక చీకటి కమ్మి, ఆకాశం వరకు అగ్నితో మండుతూ ఉంది, <verse eid="DEU 4:11" /><verse number="12" style="v" sid="DEU 4:12" />యెహోవా ఆ అగ్నిలో నుండి మీతో మాట్లాడారు. మీరు మాటల శబ్దం విన్నారు కాని ఏ రూపాన్ని మీరు చూడలేదు; స్వరం మాత్రమే వినిపించింది. <verse eid="DEU 4:12" /><verse number="13" style="v" sid="DEU 4:13" />ఆయన మీకు తన నిబంధనను ప్రకటించారు, అనగా మీరు పాటించాలని పది ఆజ్ఞలు మీకు ఆజ్ఞాపించి, వాటిని రెండు రాతి పలకలమీద వ్రాశారు. <verse eid="DEU 4:13" /><verse number="14" style="v" sid="DEU 4:14" />మీరు యొర్దాను దాటి స్వాధీనం చేసుకోబోయే దేశంలో మీరు అనుసరించాల్సిన శాసనాలను చట్టాలను మీకు నేర్పించమని యెహోవా నాకు ఆదేశించారు.<verse eid="DEU 4:14" /></para>
  <para style="s1">విగ్రహారాధన నిషేధము</para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 4:15" />అయితే చాలా జాగ్రతగా ఉండండి! హోరేబులో యెహోవా అగ్ని మధ్యలో నుండి మీతో మాట్లాడిన రోజున మీరు ఏ రూపాన్ని చూడలేదు. <verse eid="DEU 4:15" /><verse number="16" style="v" sid="DEU 4:16" />మీ కోసం ఎలాంటి విగ్రహాన్ని, ఎలాంటి రూపంలో ఉన్న దానినైన, స్త్రీ లేదా పురుషుని రూపంలో కాని, <verse eid="DEU 4:16" /><verse number="17" style="v" sid="DEU 4:17" />లేదా భూమి మీద ఉండే ఏ జంతువులా కాని, ఆకాశంలో ఎగిరే పక్షిలా కాని, <verse eid="DEU 4:17" /><verse number="18" style="v" sid="DEU 4:18" />లేదా నేల మీద ప్రాకే ఏ ప్రాణిలా కాని, నీటి క్రింద ఉండే ఏ చేపలా కాని విగ్రహం తయారుచేసుకోకండి. <verse eid="DEU 4:18" /><verse number="19" style="v" sid="DEU 4:19" />మీరు ఆకాశం వైపు కళ్ళెత్తి ఆకాశ సైన్యాలైన సూర్యచంద్ర నక్షత్రాలను చూసిన వాటిచే ఆకర్షించబడి, మీ దేవుడైన యెహోవా ఆకాశం క్రింద సమస్త దేశాల కోసం పంచి ఇచ్చిన వాటికి నమస్కరించి వాటికి సేవచేయకుండ మీరు జాగ్రత్తపడండి. <verse eid="DEU 4:19" /><verse number="20" style="v" sid="DEU 4:20" />మీరైతే, యెహోవా మిమ్మల్ని పట్టుకుని నేడు మీరున్నట్లుగా ఆయన వారసత్వ ప్రజలుగా ఉండడానికి ఇనుప కొలిమిలో నుండి, ఈజిప్టు నుండి, మిమ్మల్ని బయటకు తీసుకువచ్చారు.<verse eid="DEU 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 4:21" />మీ కారణంగా యెహోవా నా మీద కోప్పడి నేను ఈ యొర్దాను దాటకూడదని, మీ దేవుడైన యెహోవా మీకు స్వాస్థ్యంగా ఇస్తున్న మంచి దేశంలో ప్రవేశించకూడదని ఆయన ప్రమాణము చేశారు. <verse eid="DEU 4:21" /><verse number="22" style="v" sid="DEU 4:22" />నేను ఈ దేశంలో చనిపోతాను; నేను యొర్దానును దాటను; కాని మీరు నది దాటి వెళ్లి ఆ మంచి దేశాన్ని స్వాధీనం చేసుకోబోతున్నారు. <verse eid="DEU 4:22" /><verse number="23" style="v" sid="DEU 4:23" />మీ దేవుడైన యెహోవా మీతో చేసిన నిబంధనను మరచిపోకుండా జాగ్రత్తపడండి; మీ దేవుడైన యెహోవా నిషేధించిన వాటి యొక్క ఎలాంటి రూపంలోను మీ కోసం విగ్రహాన్ని చేసుకోకండి. <verse eid="DEU 4:23" /><verse number="24" style="v" sid="DEU 4:24" />ఎందుకంటే మీ దేవుడైన యెహోవా దహించు అగ్ని, ఆయన రోషం గల దేవుడు.<verse eid="DEU 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 4:25" />మీకు పిల్లలు మనవళ్లు కలిగి, ఆ దేశంలో చాలా కాలం నివసించిన తర్వాత, మీరు అప్పుడు చెడిపోయి ఏ రూపంలోనైనా విగ్రహాన్ని చేసుకుని మీ దేవుడైన యెహోవా కళ్ళెదుట చెడు చేసి ఆయనకు కోపం పుట్టిస్తే, <verse eid="DEU 4:25" /><verse number="26" style="v" sid="DEU 4:26" />మీరు ఈ యొర్దాను దాటి స్వాధీనం చేసుకోబోయే ఆ దేశంలో ఎక్కువకాలం నివసించకుండా వెంటనే నశిస్తారని ఈ రోజు ఆకాశాలను భూమిని మీమీద సాక్షులుగా ఉంచుతున్నాను. ఆ దేశంలో ఎక్కువకాలం నివసించరు ఖచ్చితంగా నశించిపోతారు. <verse eid="DEU 4:26" /><verse number="27" style="v" sid="DEU 4:27" />యెహోవా జనాంగాల మధ్యలో మిమ్మల్ని చెదరగొడతారు, యెహోవా మిమ్మల్ని తోలివేసే దేశాల మధ్యలో మీలో కొద్దిమంది మాత్రమే మిగులుతారు. <verse eid="DEU 4:27" /><verse number="28" style="v" sid="DEU 4:28" />అక్కడ మీరు మనుష్యులు తయారుచేసిన కర్ర, రాతి దేవుళ్ళను సేవిస్తారు. అవి చూడలేవు, వినలేవు, తినలేవు, వాసన చూడలేవు. <verse eid="DEU 4:28" /><verse number="29" style="v" sid="DEU 4:29" />అయితే అక్కడినుండి మీరు మీ దేవుడైన యెహోవాను వెదికితే, మీ పూర్ణహృదయంతో మీ పూర్ణాత్మతో వెదికినప్పుడు ఆయన మీకు దొరుకుతారు. <verse eid="DEU 4:29" /><verse number="30" style="v" sid="DEU 4:30" />మీరు దుఃఖంలో ఉన్నప్పుడు, ఈ సంగతులన్ని మీకు జరిగిన తర్వాత, అప్పుడు చివరి రోజుల్లో మీరు మీ దేవుడైన యెహోవా వైపు తిరిగి ఆయన మాట వింటారు. <verse eid="DEU 4:30" /><verse number="31" style="v" sid="DEU 4:31" />మీ దేవుడైన యెహోవా జాలిగల దేవుడు; కాబట్టి ఆయన మిమ్మల్ని విడిచిపెట్టడు, మిమ్మల్ని నాశనం చేయడు, ఆయన మీ పూర్వికులతో ప్రమాణం ద్వార నిశ్చయం చేసిన నిబంధనను మరచిపోరు.<verse eid="DEU 4:31" /></para>
  <para style="s1">యెహోవాయే దేవుడు</para>
  <para style="p">
    <verse number="32" style="v" sid="DEU 4:32" />దేవుడు భూమి మీద నరుని సృజించిన రోజు నుండి, మీకంటే ముందు ఉన్న గత కాలం గురించి అడగండి; ఆకాశం యొక్క ఒక చివరి నుండి మరో చివరి వరకు అడగండి. ఇలాంటి గొప్ప కార్యం ఎప్పుడైనా జరిగిందా? లేదా అటువంటి దాని గురించి ఎప్పుడైనా విన్నారా? <verse eid="DEU 4:32" /><verse number="33" style="v" sid="DEU 4:33" />అగ్ని మధ్యలో నుండి మాట్లాడిన దేవుని స్వరాన్ని మీరు విన్నట్లు మరి ఏ ప్రజలైనా విని బ్రతికారా? <verse eid="DEU 4:33" /><verse number="34" style="v" sid="DEU 4:34" />మీ దేవుడైన యెహోవా ఈజిప్టులో మీ కళ్ళెదుట మీ కోసం శోధనలతో, సూచకక్రియలతో, అద్భుతాలతో, యుద్ధంతో, బలమైన హస్తంతో, చాచిన చేతితో మహా భయంకరమైన కార్యాలతో సమస్త కార్యాలను చేసినట్లు ఏ దేవుడైన తన కోసం ఒక దేశం నుండి మరొక దేశాన్ని బయటకు తీసుకువచ్చే ప్రయత్నం చేశాడా?<verse eid="DEU 4:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="DEU 4:35" />యెహోవాయే దేవుడని ఆయన తప్ప మరి ఎవరు లేరని మీరు తెలుసుకునేలా ఇవన్నీ మీకు చూపబడ్డాయి. <verse eid="DEU 4:35" /><verse number="36" style="v" sid="DEU 4:36" />మిమ్మల్ని క్రమపరచడానికి ఆకాశం నుండి తన స్వరాన్ని మీకు వినిపించారు. భూమి మీద మీకు తన గొప్ప అగ్నిని చూపించారు, ఆ అగ్ని మధ్యలో నుండి ఆయన మాటలు మీరు విన్నారు. <verse eid="DEU 4:36" /><verse number="37-38" style="v" sid="DEU 4:37-38" />ఆయన మీ పూర్వికులను ప్రేమించి వారి సంతతిని ఎంపిక చేసుకున్నారు కాబట్టి, మీకంటే బలమైన గొప్ప దేశాలను మీ ఎదుట నుండి వెళ్లగొట్టి, వారి దేశంలోనికి మిమ్మల్ని తీసుకువచ్చి, ఈ రోజు ఇస్తున్నట్లుగా వారి దేశాన్ని మీకు స్వాస్థ్యంగా ఇవ్వడానికి ఆయన తన సన్నిధితో, తన మహాబలంతో మిమ్మల్ని ఈజిప్టు నుండి బయటకు రప్పించారు.<verse eid="DEU 4:37-38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="DEU 4:39" />కాబట్టి పైనున్న పరలోకంలో గాని, క్రిందున్న భూమిమీద గాని, యెహోవాయే దేవుడని, మరొక దేవుడు లేడని ఈ రోజే మీరు గుర్తించి, మీ హృదయాల్లో జ్ఞాపకం ఉంచుకోండి. <verse eid="DEU 4:39" /><verse number="40" style="v" sid="DEU 4:40" />మీకు, మీ తర్వాత మీ సంతతివారికి క్షేమం కలగడానికి యెహోవా శాశ్వతంగా మీకు ఇస్తున్న దేశంలో మీరు అధిక కాలం జీవించేలా ఈ రోజు నేను మీకు ఇస్తున్న శాసనాలను ఆజ్ఞలను పాటించండి.<verse eid="DEU 4:40" /></para>
  <para style="s1">ఆశ్రయ పట్టణాలు</para>
  <para style="p">
    <verse number="41" style="v" sid="DEU 4:41" />తర్వాత మోషే యొర్దానుకు తూర్పు వైపు ఉన్న మూడు పట్టణాలను ప్రత్యేకంగా ఉంచాడు. <verse eid="DEU 4:41" /><verse number="42" style="v" sid="DEU 4:42" />ఒక వ్యక్తిని చంపిన ఎవరైనా ఏ దురుద్దేశం లేకుండా పొరుగువారిని చంపినట్లయితే పారిపోవచ్చు. వారు ఈ పట్టణాల్లో ఒక దానికి పారిపోయి తమ ప్రాణాలను కాపాడుకోవచ్చు. <verse eid="DEU 4:42" /><verse number="43" style="v" sid="DEU 4:43" />ఆ పట్టణాలు ఇవి: రూబేనీయులకు అరణ్య పీఠభూమిలో ఉన్న బేసెరు; గాదీయులకు గిలాదులో ఉన్న రామోతు; మనష్షీయులకు బాషానులో ఉన్న గోలాను.<verse eid="DEU 4:43" /></para>
  <para style="s1">ధర్మశాస్త్ర పరిచయము</para>
  <para style="p">
    <verse number="44" style="v" sid="DEU 4:44" />మోషే ఇశ్రాయేలీయులకు ఇచ్చిన ధర్మశాస్త్రం ఇది. <verse eid="DEU 4:44" /><verse number="45-46" style="v" sid="DEU 4:45-46" />ఈ నిబంధనలు శాసనాలు చట్టాలు, ఇశ్రాయేలీయులు ఈజిప్టులో నుండి బయటకు వచ్చినప్పుడు యొర్దాను తూర్పున బేత్-పెయోరుకు ఎదురుగా ఉన్న లోయలో హెష్బోనులో పరిపాలించి, మోషే, ఇశ్రాయేలీయుల చేతిలో ఓడిపోయిన అమోరీయుల రాజైన సీహోను దేశంలో వారికి ఇవ్వబడినవి. <verse eid="DEU 4:45-46" /><verse number="47" style="v" sid="DEU 4:47" />యొర్దానుకు తూర్పున ఉన్న అతని దేశాన్ని, బాషాను రాజైన ఓగు దేశాన్ని, ఈ ఇద్దరు అమోరీయుల రాజుల దేశాలను వారు స్వాధీనం చేసుకున్నారు. <verse eid="DEU 4:47" /><verse number="48" style="v" sid="DEU 4:48" />ఆ దేశం అర్నోను వాగు లోయ ఒడ్డున ఉన్న అరోయేరు నుండి హెర్మోను అనే సీయోను<note caller="+" style="f"><char style="fr" closed="false">4:48 </char><char style="ft" closed="false">కొ.ప్రా.ప్ర.లో </char><char style="fqa" closed="false">సిరియోను</char></note> కొండ వరకు, <verse eid="DEU 4:48" /><verse number="49" style="v" sid="DEU 4:49" />యొర్దాను తూర్పున ఉన్న అరాబా ప్రాంతమంతా, పిస్గా కొండచరియల దిగువగా ఉప్పు సముద్రం<note caller="+" style="f"><char style="fr" closed="false">4:49 </char><char style="ft" closed="false">హెబ్రీలో </char><char style="fqa" closed="false">అరాబా సముద్రం, అంటే, మృత సముద్రం</char></note> వరకు ఉంది.<verse eid="DEU 4:49" /></para>
  <chapter eid="DEU 4" />
  <chapter number="5" style="c" sid="DEU 5" />
  <para style="s1">పది ఆజ్ఞలు</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 5:1" />మోషే ఇశ్రాయేలీయులందరిని పిలిపించి వారితో ఇలా చెప్పాడు:</para>
  <para style="p" vid="DEU 5:1">ఇశ్రాయేలూ, మీ వినికిడిలో నేను ప్రకటించే శాసనాలను, చట్టాలను వినండి. వాటిని నేర్చుకొని ఖచ్చితంగా పాటించండి. <verse eid="DEU 5:1" /><verse number="2" style="v" sid="DEU 5:2" />మన దేవుడైన యెహోవా హోరేబులో మనతో నిబంధన చేశారు. <verse eid="DEU 5:2" /><verse number="3" style="v" sid="DEU 5:3" />యెహోవా ఈ నిబంధన చేసింది మన పూర్వికులతో కాదు, మనతో, ఈ రోజు సజీవంగా ఉన్న మనందరితో చేశారు. <verse eid="DEU 5:3" /><verse number="4" style="v" sid="DEU 5:4" />ఆ పర్వతం మీద అగ్నిలో నుండి యెహోవా మీతో ముఖాముఖిగా మాట్లాడారు. <verse eid="DEU 5:4" /><verse number="5" style="v" sid="DEU 5:5" />అయితే మీరు ఆ అగ్నికి భయపడి పర్వతం ఎక్కలేదు కాబట్టి యెహోవా మాట మీకు తెలియజేయడానికి నేను యెహోవాకు మీకు మధ్యలో నిలబడ్డాను.</para>
  <para style="p" vid="DEU 5:5">ఆయన ఇలా అన్నారు:<verse eid="DEU 5:5" /></para>
  <para style="b" />
  <para style="lh">
    <verse number="6" style="v" sid="DEU 5:6" />“బానిస దేశమైన ఈజిప్టు నుండి మిమ్మల్ని బయటకు రప్పించిన మీ దేవుడనైన యెహోవాను నేనే.<verse eid="DEU 5:6" /></para>
  <para style="b" />
  <para style="li1">
    <verse number="7" style="v" sid="DEU 5:7" />“నేను తప్ప వేరొక దేవుడు మీకు ఉండకూడదు.<verse eid="DEU 5:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="DEU 5:8" />పైన ఆకాశంలో గాని, క్రింద భూమిమీద గాని భూమి క్రింద నీళ్లలో గాని ఉన్న దేని రూపంలో మీరు మీకోసం ప్రతిమను చేసుకోకూడదు. <verse eid="DEU 5:8" /><verse number="9" style="v" sid="DEU 5:9" />మీరు వాటికి నమస్కరించకూడదు పూజింపకూడదు; ఎందుకంటే నేను, మీ దేవుడనైన యెహోవాను, రోషం గల దేవుడను, నన్ను ద్వేషించినవారి విషయంలో మూడు నాలుగు తరాల వరకు తండ్రుల పాపం యొక్క శిక్షను వారి పిల్లల మీదికి రప్పిస్తాను. <verse eid="DEU 5:9" /><verse number="10" style="v" sid="DEU 5:10" />అయితే నన్ను ప్రేమించి నా ఆజ్ఞలను పాటించే వారికి వెయ్యి తరాల వరకు కరుణను చూపిస్తాను.<verse eid="DEU 5:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="DEU 5:11" />మీ దేవుడైన యెహోవా నామాన్ని అనవసరంగా ఉపయోగించకూడదు, ఎందుకంటే తన నామాన్ని అనవసరంగా ఉపయోగించే వారిని యెహోవా నిర్దోషులుగా వదిలేయరు.<verse eid="DEU 5:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="DEU 5:12" />యెహోవా మీకు ఆజ్ఞాపించినట్లు సబ్బాతు దినాన్ని పరిశుద్ధంగా పాటించడం జ్ఞాపకముంచుకోండి. <verse eid="DEU 5:12" /><verse number="13" style="v" sid="DEU 5:13" />ఆరు రోజులు మీరు కష్టపడి మీ పని అంతటిని చేసుకోవాలి, <verse eid="DEU 5:13" /><verse number="14" style="v" sid="DEU 5:14" />కాని ఏడవ రోజు మీ దేవుడైన యెహోవాకు సబ్బాతు దినము. ఆ రోజు మీరు ఏ పని చేయకూడదు, మీరు గాని, మీ కుమారుడు లేదా కుమార్తె గాని, మీ దాసదాసీలు గాని, మీ ఎద్దు గాని, మీ గాడిద గాని, మీ పశువులు గాని, మీ పట్టణాల్లో ఉంటున్న విదేశీయులు గాని ఏ పని చేయకూడదు తద్వార మీలా మీ దాసదాసీలు విశ్రాంతి తీసుకుంటారు. <verse eid="DEU 5:14" /><verse number="15" style="v" sid="DEU 5:15" />మీరు ఈజిప్టులో బానిసత్వంలో ఉన్నప్పుడు, మీ దేవుడైన యెహోవా బలమైన హస్తంతో, చాచిన చేతితో మిమ్మల్ని అక్కడినుండి బయటకు తీసుకువచ్చారని జ్ఞాపకం ఉంచుకోండి. కాబట్టి సబ్బాతు దినాన్ని పాటించమని మీ దేవుడైన యెహోవా మీకు ఆజ్ఞాపించారు.<verse eid="DEU 5:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="DEU 5:16" />మీ దేవుడైన యెహోవా మీకు ఇచ్చే దేశంలో మీరు దీర్ఘాయుష్మంతులై మీకు క్షేమం కలిగేలా మీ దేవుడైన యెహోవా మీకు ఆజ్ఞాపించిన ప్రకారం, మీ తండ్రిని తల్లిని గౌరవించాలి.<verse eid="DEU 5:16" /></para>
  <para style="li1">
    <verse number="17" style="v" sid="DEU 5:17" />మీరు హత్య చేయకూడదు.<verse eid="DEU 5:17" /></para>
  <para style="li1">
    <verse number="18" style="v" sid="DEU 5:18" />మీరు వ్యభిచారం చేయకూడదు.<verse eid="DEU 5:18" /></para>
  <para style="li1">
    <verse number="19" style="v" sid="DEU 5:19" />మీరు దొంగతనం చేయకూడదు.<verse eid="DEU 5:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="DEU 5:20" />మీ పొరుగువారికి వ్యతిరేకంగా అబద్ధసాక్ష్యం చెప్పకూడదు.<verse eid="DEU 5:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="DEU 5:21" />మీ పొరుగువాని భార్యను మీరు ఆశించకూడదు. మీ పొరుగువాని ఇంటిని గాని స్థలాన్ని గాని అతని దాసుని గాని, దాసిని గాని, అతని ఎద్దును గాని గాడిదను గాని, మీ పొరుగువానికి చెందిన దేన్ని మీరు ఆశించకూడదు.”<verse eid="DEU 5:21" /></para>
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" sid="DEU 5:22" />ఈ ఆజ్ఞలు యెహోవా ఆ పర్వతం మీద అగ్ని, మేఘం, కటిక చీకటిలో నుండి గొప్ప స్వరంతో మీ సమాజమంతటికి ప్రకటించారు; ఆయన ఇంకా ఏది కలుపలేదు. ఆ తర్వాత ఆయన రెండు రాతి పలకల మీద వాటిని వ్రాసి నాకు ఇచ్చారు.<verse eid="DEU 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 5:23" />ఆ పర్వతం అగ్నితో మండుతున్నప్పుడు, ఆ చీకటిలో నుండి స్వరాన్ని మీరు విన్నప్పుడు, మీ గోత్రాల నాయకులందరు, మీ పెద్దలు నా దగ్గరకు వచ్చారు. <verse eid="DEU 5:23" /><verse number="24" style="v" sid="DEU 5:24" />మీరు నాతో అన్నారు, “మన దేవుడైన యెహోవా తన మహిమను తన ఘనతను మాకు చూపించారు, అగ్నిలో నుండి ఆయన స్వరాన్ని మేము విన్నాము. దేవుడు మనుష్యులతో మాట్లాడినా వారు బ్రతికే ఉంటారని ఈ రోజు మేము చూశాము. <verse eid="DEU 5:24" /><verse number="25" style="v" sid="DEU 5:25" />అయితే ఇప్పుడు మేమెందుకు చావాలి? ఈ గొప్ప అగ్ని మమ్మల్ని కాల్చివేస్తుంది, మేము మన దేవుడైన యెహోవా స్వరాన్ని ఇంకా వింటే చనిపోతాము. <verse eid="DEU 5:25" /><verse number="26" style="v" sid="DEU 5:26" />మేము విన్నట్లు మానవులలో ఎవరైనా సజీవుడైన దేవుని స్వరం అగ్నిలో నుండి మాట్లాడడం విని బ్రతికి ఉన్నారా? <verse eid="DEU 5:26" /><verse number="27" style="v" sid="DEU 5:27" />నీవే దగ్గరకు వెళ్లి మన దేవుడైన యెహోవా చెప్పినదంతా విను. తర్వాత మన దేవుడైన యెహోవా నీకు చెప్పినదంతా నీవు మాకు చెప్పు, మేము వింటాము, లోబడతాము.”<verse eid="DEU 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DEU 5:28" />మీరు నాతో మాట్లాడినప్పుడు యెహోవా మీ మాటలు విన్నారు, యెహోవా నాతో ఇలా అన్నారు, “ఈ ప్రజలు నీతో చెప్పిన మాటలు నేను విన్నాను. వారు చెప్పిందంతా మంచిదే. <verse eid="DEU 5:28" /><verse number="29" style="v" sid="DEU 5:29" />వారికి వారి సంతతికి నిరంతరం క్షేమం కలిగేలా వారు నా పట్ల భయం కలిగి, నా ఆజ్ఞలన్నిటిని అనుసరించే హృదయం వారికుంటే ఎంతో మంచిది.<verse eid="DEU 5:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="DEU 5:30" />“నీవు వెళ్లి, వారి గుడారలకు వారిని తిరిగి వెళ్లమని చెప్పు. <verse eid="DEU 5:30" /><verse number="31" style="v" sid="DEU 5:31" />అయితే నీవు ఇక్కడ నాతో ఉండు, ఎందుకంటే వారు స్వాధీనం చేసుకోవడానికి నేను వారికి ఇస్తున్న దేశంలో పాటించేలా నీవు బోధించాల్సిన ఆజ్ఞలు, శాసనాలు చట్టాలు నీకు ఇస్తాను.”<verse eid="DEU 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="DEU 5:32" />కాబట్టి మీ దేవుడైన యెహోవా ఆజ్ఞాపించిన వాటిని చేయడంలో జాగ్రత్త వహించండి; కుడికి గాని ఎడమకు గాని తిరగకూడదు. <verse eid="DEU 5:32" /><verse number="33" style="v" sid="DEU 5:33" />మీరు స్వాధీనం చేసుకోబోయే దేశంలో మీరు జీవిస్తూ, అభివృద్ధి పొందుతూ, ఎక్కువకాలం జీవించేలా, మీ దేవుడైన యెహోవా మీకు ఆజ్ఞాపించిన మార్గంలో నడవండి.<verse eid="DEU 5:33" /></para>
  <chapter eid="DEU 5" />
  <chapter number="6" style="c" sid="DEU 6" />
  <para style="s1">మీ దేవుడైన యెహోవాను ప్రేమించండి</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 6:1" />మీరు యొర్దాను దాటి స్వాధీనపరుచుకోబోయే దేశంలో మీరు పాటించాలని మీకు బోధించమని మీ దేవుడైన యెహోవా నాకు నిర్దేశించిన ఆజ్ఞలు, శాసనాలు చట్టాలు ఇవే. <verse eid="DEU 6:1" /><verse number="2" style="v" sid="DEU 6:2" />మీరు, మీ పిల్లలు, వారి పిల్లలు జీవితకాలమంతా మీ దేవుడైన యెహోవాకు భయపడి, నేను మీకు ఇచ్చే ఆయన శాసనాలు, ఆజ్ఞలు పాటించడం ద్వారా మీరు దీర్ఘాయువును అనుభవిస్తారు. <verse eid="DEU 6:2" /><verse number="3" style="v" sid="DEU 6:3" />ఇశ్రాయేలూ విను, మీ పూర్వికుల దేవుడైన యెహోవా మీకు వాగ్దానం చేసిన రీతిగా పాలు తేనెలు ప్రవహించే దేశంలో మీకు శ్రేయస్సు కలిగి అధికంగా అభివృద్ధి కలిగేలా మీరు వాటికి లోబడి ఉండేలా జాగ్రత్త వహించండి.<verse eid="DEU 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 6:4" />ఓ ఇశ్రాయేలీయులారా, వినండి: మన దేవుడైన యెహోవా, యెహోవా ఒక్కరే. <verse eid="DEU 6:4" /><verse number="5" style="v" sid="DEU 6:5" />మీ పూర్ణహృదయంతో, మీ పూర్ణాత్మతో, మీ పూర్ణబలంతో మీ దేవుడైన యెహోవాను ప్రేమించాలి. <verse eid="DEU 6:5" /><verse number="6" style="v" sid="DEU 6:6" />ఈ రోజు నేను మీకు ఇస్తున్న ఈ ఆజ్ఞలు మీ హృదయాల్లో నిలిచి ఉండాలి. <verse eid="DEU 6:6" /><verse number="7" style="v" sid="DEU 6:7" />వాటిని మీ పిల్లలకు నేర్పించాలి. మీరు ఇంటి దగ్గర కూర్చున్నప్పుడు, దారిలో నడుస్తున్నప్పుడు, మీరు పడుకున్నప్పుడు, లేచినప్పుడు, వాటి గురించి మాట్లాడాలి. <verse eid="DEU 6:7" /><verse number="8" style="v" sid="DEU 6:8" />వాటిని సూచనలుగా మీ చేతికి కట్టుకోండి, మీ నుదిటి మీద బాసికాలుగా కట్టుకోండి. <verse eid="DEU 6:8" /><verse number="9" style="v" sid="DEU 6:9" />మీ ఇళ్ళ ద్వారబంధాల మీద, ద్వారాల మీద వాటిని వ్రాయండి.<verse eid="DEU 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 6:10" />మీ దేవుడైన యెహోవా మీ పితరులైన అబ్రాహాము, ఇస్సాకు, యాకోబులతో ప్రమాణం చేసిన రీతిగా మిమ్మల్ని ఆ దేశంలోనికి తీసుకువచ్చి మీరు కట్టని విశాలమైన మంచి పట్టణాలను, <verse eid="DEU 6:10" /><verse number="11" style="v" sid="DEU 6:11" />మీరు సమకూర్చని అన్ని రకాల మంచి వస్తువులతో నిండిన ఇళ్ళను, మీరు తవ్వని బావులను, మీరు నాటని ద్రాక్షతోటలు, ఒలీవల తోటలను మీకు ఇస్తారు; మీరు తిని తృప్తిపొందిన తర్వాత, <verse eid="DEU 6:11" /><verse number="12" style="v" sid="DEU 6:12" />బానిస దేశమైన ఈజిప్టులో నుండి మిమ్మల్ని బయటకు తీసుకువచ్చిన యెహోవాను మరచిపోకుండా జాగ్రత్తగా ఉండండి.<verse eid="DEU 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 6:13" />మీ దేవుడైన యెహోవాకు భయపడి, ఆయనను మాత్రమే సేవించి, ఆయన పేరిట మాత్రమే మీరు ప్రమాణం చేయాలి. <verse eid="DEU 6:13" /><verse number="14" style="v" sid="DEU 6:14" />ఇతర దేవుళ్ళను అనగా మీ చుట్టూ ఉన్న ప్రజల దేవుళ్ళను అనుసరించకూడదు; <verse eid="DEU 6:14" /><verse number="15" style="v" sid="DEU 6:15" />మీ మధ్యనున్న మీ దేవుడైన యెహోవా రోషం గల దేవుడు, ఆయన కోపం మీమీద రగులుకొని దేశంలో ఉండకుండా ఆయన మిమ్మల్ని నాశనం చేస్తారు. <verse eid="DEU 6:15" /><verse number="16" style="v" sid="DEU 6:16" />మీరు మస్సాలో మీ దేవుడైన యెహోవాను పరీక్షించినట్లు ఆయనను పరీక్షించకూడదు. <verse eid="DEU 6:16" /><verse number="17" style="v" sid="DEU 6:17" />మీ దేవుడైన యెహోవా ఆజ్ఞలను, అనగా ఆయన మీకు ఇచ్చిన నిబంధనలను, శాసనాలను జాగ్రత్తగా పాటించండి. <verse eid="DEU 6:17" /><verse number="18-19" style="v" sid="DEU 6:18-19" />మీకు మేలు కలిగేలా యెహోవా చెప్పినట్లు మీ శత్రువులందరిని మీ ఎదుట నుండి తరిమివేసి యెహోవా మీ పూర్వికులతో ప్రమాణం చేసిన ఆ మంచి దేశంలో మీరు ప్రవేశించి దానిని స్వాధీనం చేసుకోవాలంటే మీరు యెహోవా దృష్టికి యథార్థమైనది ఉత్తమమైనది చేయాలి.<verse eid="DEU 6:18-19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 6:20" />భవిష్యత్తులో, “మన దేవుడైన యెహోవా మనకు ఆజ్ఞాపించిన నిబంధనలు, శాసనాలు, చట్టాలకు అర్థం ఏంటి?” అని మీ పిల్లలు మిమ్మల్ని అడిగినప్పుడు, <verse eid="DEU 6:20" /><verse number="21" style="v" sid="DEU 6:21" />మీరు వారితో, “మనం ఈజిప్టులో ఫరోకు బానిసలుగా ఉన్నప్పుడు, యెహోవా బలమైన హస్తంతో మనలను ఈజిప్టులో నుండి బయటకు తీసుకువచ్చారు. <verse eid="DEU 6:21" /><verse number="22" style="v" sid="DEU 6:22" />మన కళ్లముందు యెహోవా ఈజిప్టు మీద, ఫరో మీద, అతని ఇంటివారందరి మీద గొప్ప, భయంకరమైన అసాధారణ గుర్తులను, అద్భుతాలను చేశారు. <verse eid="DEU 6:22" /><verse number="23" style="v" sid="DEU 6:23" />ఆయన మన పూర్వికులతో ప్రమాణం చేసిన దేశంలోనికి మనలను తీసుకువచ్చి దానిని మనకు ఇవ్వడానికి అక్కడినుండి మనలను బయటకు తీసుకువచ్చారు. <verse eid="DEU 6:23" /><verse number="24" style="v" sid="DEU 6:24" />మనం ఎల్లప్పుడు వర్ధిల్లుతూ, నేడు ఉన్నట్లుగా మనం బ్రతికి ఉండడానికి ఈ శాసనాలన్నిటికి లోబడి మన దేవుడైన యెహోవాకు భయపడమని యెహోవా మనకు ఆజ్ఞాపించారు. <verse eid="DEU 6:24" /><verse number="25" style="v" sid="DEU 6:25" />మన దేవుడైన యెహోవా మనకు ఆజ్ఞాపించినట్లు ఆయన ఎదుట మనం ఈ ఆజ్ఞలన్నిటిని జాగ్రత్తగా అనుసరిస్తే అది మనకు నీతిగా పరిగణించబడుతుంది” అని చెప్పండి.<verse eid="DEU 6:25" /></para>
  <chapter eid="DEU 6" />
  <chapter number="7" style="c" sid="DEU 7" />
  <para style="s1">ఇతర జనాంగాలను వెళ్లగొట్టుట</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 7:1" />మీరు స్వాధీనం చేసుకోబోయే దేశంలోనికి మీ దేవుడైన యెహోవా మిమ్మల్ని తీసుకువచ్చి, మీ ఎదుట నుండి అనేక జనాంగాలను అనగా మీకన్నా విస్తారమైన, బలమైన ఏడు జనాంగాలను హిత్తీయులు, గిర్గాషీయులు, అమోరీయులు, కనానీయులు, పెరిజ్జీయులు, హివ్వీయులు, యెబూసీయులను వెళ్లగొట్టి, <verse eid="DEU 7:1" /><verse number="2" style="v" sid="DEU 7:2" />మీ దేవుడైన యెహోవా వారిని మీకు అప్పగించగా, మీరు వారిని ఓడించినప్పుడు, వారిని పూర్తిగా నాశనం చేయాలి. వారితో సంధి చేసుకోకూడదు వారిని కరుణించకూడదు. <verse eid="DEU 7:2" /><verse number="3" style="v" sid="DEU 7:3" />వారితో పెళ్ళి సంబంధాలు పెట్టుకోవద్దు. వారి కుమారులకు మీ కుమార్తెలను ఇవ్వకూడదు, మీ కుమారులకు వారి కుమార్తెలను పుచ్చుకోకూడదు, <verse eid="DEU 7:3" /><verse number="4" style="v" sid="DEU 7:4" />ఎందుకంటే వారు నన్ను అనుసరించకుండా ఇతర దేవుళ్ళను సేవించేలా మీ పిల్లలను త్రిప్పివేస్తారు, అప్పుడు యెహోవా కోపం మీమీద రగులుకొని మిమ్మల్ని త్వరగా నాశనం చేస్తుంది. <verse eid="DEU 7:4" /><verse number="5" style="v" sid="DEU 7:5" />మీరు వారికి ఇలా చేయాలి: వారి బలిపీఠాలను పడగొట్టండి, వారి పవిత్ర రాళ్లను పగులగొట్టండి, వారి అషేరా స్తంభాలను<note caller="+" style="f"><char style="fr" closed="false">7:5 </char><char style="ft" closed="false">అంటే, అషేరా దేవత యొక్క కర్ర చిహ్నాలు</char></note> ముక్కలు చేయండి, వారి విగ్రహాలను అగ్నితో కాల్చివేయండి. <verse eid="DEU 7:5" /><verse number="6" style="v" sid="DEU 7:6" />ఎందుకంటే, మీరు మీ దేవుడైన యెహోవాకు పరిశుద్ధ ప్రజలు. ఈ భూమి మీద ప్రజలందరిలో నుండి మీ దేవుడైన యెహోవా మిమ్మల్ని తన సొంత ప్రజలుగా, విలువైన ఆస్తిగా ఎన్నుకున్నారు.<verse eid="DEU 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 7:7" />మీరు ఇతర జనాంగాల కంటే ఎక్కువగా ఉన్నారని కాదు జనాంగాలన్నిటిలో మీరే తక్కువగా ఉన్నారని యెహోవా మిమ్మల్ని ప్రేమించి ఏర్పరచుకున్నారు. <verse eid="DEU 7:7" /><verse number="8" style="v" sid="DEU 7:8" />అయితే యెహోవా మిమ్మల్ని ప్రేమించారు కాబట్టి, మీ పూర్వికులతో చేసిన ప్రమాణం నెరవేర్చారు కాబట్టి, తన బలమైన హస్తంతో మిమ్మల్ని బయటకు తీసుకువచ్చి బానిస దేశం నుండి, ఈజిప్టు రాజైన ఫరో శక్తి నుండి మిమ్మల్ని విడిపించారు. <verse eid="DEU 7:8" /><verse number="9" style="v" sid="DEU 7:9" />కాబట్టి మీ దేవుడైన యెహోవాయే దేవుడని తెలుసుకోండి; ఆయన నమ్మదగిన దేవుడు, తనను ప్రేమిస్తూ, తన ఆజ్ఞలను పాటించే వారికి, ఆయన వెయ్యి తరాల వరకు తన నిబంధన స్థిరపరిచేవారు. <verse eid="DEU 7:9" /><verse number="10" style="v" sid="DEU 7:10" />అయితే,</para>
  <para style="q1" vid="DEU 7:10">తనను ద్వేషించేవారిని నేరుగా నాశనం చేస్తారు;</para>
  <para style="q2" vid="DEU 7:10">ఆలస్యం చేయకుండా నేరుగా వారికి ప్రతిఫలం చెల్లిస్తారు.<verse eid="DEU 7:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="DEU 7:11" />కాబట్టి ఈ రోజు నేను మీకు ఆజ్ఞాపిస్తున్న ఆజ్ఞలు, శాసనాలు, చట్టాలను జాగ్రత్తగా అనుసరించండి.<verse eid="DEU 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 7:12" />మీరు ఈ చట్టాలను శ్రద్ధగా విని వాటిని జాగ్రత్తగా అనుసరిస్తే, మీ దేవుడైన యెహోవా మీ పూర్వికులకు ప్రమాణం చేసినట్లుగా, మీతో తన ప్రేమ నిబంధనను కొనసాగిస్తారు. <verse eid="DEU 7:12" /><verse number="13" style="v" sid="DEU 7:13" />ఆయన మిమ్మల్ని ప్రేమించి దీవించి అభివృద్ధి కలుగజేస్తారు. మీకు ఇస్తానని మీ పూర్వికులకు ప్రమాణం చేసిన దేశంలో, మీ గర్భఫలాన్ని, మీ భూఫలమైన మీ ధాన్యం, క్రొత్త ద్రాక్షరసం, ఒలీవనూనె, పశువుల దూడలను, మందల గొర్రెపిల్లలను దీవిస్తారు. <verse eid="DEU 7:13" /><verse number="14" style="v" sid="DEU 7:14" />ఇతర ప్రజలకన్నా అధికంగా మీరు ఆశీర్వదించబడతారు; మీలో పురుషులలో కాని స్త్రీలలో కాని సంతానలేమి ఉండదు, మీ పశువుల్లో కూడా ఉండదు. <verse eid="DEU 7:14" /><verse number="15" style="v" sid="DEU 7:15" />యెహోవా మిమ్మల్ని ప్రతీ వ్యాధి నుండి కాపాడతారు. ఈజిప్టులో మీకు తెలిసిన భయంకరమైన రోగాల మీ మీదికి రాకుండా చేస్తారు, కాని మిమ్మల్ని ద్వేషించే వారందరి మీదికి వాటిని రప్పిస్తారు. <verse eid="DEU 7:15" /><verse number="16" style="v" sid="DEU 7:16" />మీ దేవుడైన యెహోవా మీకు అప్పగించే ప్రజలందరినీ పూర్తిగా నాశనం చేయాలి. వారి మీద దయ చూపించకూడదు, వారి దేవుళ్ళను సేవించకూడదు, ఎందుకంటే అది మీకు ఉరిగా బిగుసుకుంటుంది.<verse eid="DEU 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 7:17" />“ఈ జనాంగాలు మా కన్నా బలవంతులు. మేము వారినెలా వెళ్లగొట్టగలము?” అని మీలో మీరు అనుకోవచ్చు. <verse eid="DEU 7:17" /><verse number="18" style="v" sid="DEU 7:18" />అయితే వారికి భయపడకండి; మీ దేవుడైన యెహోవా ఫరోకు, ఈజిప్టు దేశమంతటికి చేసింది జాగ్రతగా జ్ఞాపకం చేసుకోండి. <verse eid="DEU 7:18" /><verse number="19" style="v" sid="DEU 7:19" />గొప్ప శోధనలు, సూచకక్రియలు, అద్భుతాలు, బలమైన హస్తం చాచిన చేతితో మీ దేవుడైన యెహోవా మిమ్మల్ని బయటకు తీసుకురావడం మీ కళ్లతో మీరే చూశారు. మీరు భయపడుతున్న ప్రజలందరికి మీ దేవుడైన యెహోవా అలాగే చేస్తారు. <verse eid="DEU 7:19" /><verse number="20" style="v" sid="DEU 7:20" />అంతేకాక, మీకు కనబడకుండా దాక్కున్న మిగిలినవారంతా నశించే వరకు, మీ దేవుడైన యెహోవా వారి మీదికి పెద్ద కందిరీగలను పంపుతారు. <verse eid="DEU 7:20" /><verse number="21" style="v" sid="DEU 7:21" />మీరు వారికి భయపడకండి, ఎందుకంటే మీ మధ్య ఉన్న మీ దేవుడైన యెహోవా గొప్పవాడు, అద్భుత దేవుడు <verse eid="DEU 7:21" /><verse number="22" style="v" sid="DEU 7:22" />మీ దేవుడైన యెహోవా ఆ జనాంగాలను మీ ఎదుట నుండి కొద్దికొద్దిగా తొలగిస్తారు. అడవి జంతువులు ఎక్కువయ్యే ప్రమాదం ఉంది కాబట్టి మీరు ఒకేసారి వారందరిని నాశనం చేయడానికి అనుమతి లేదు. <verse eid="DEU 7:22" /><verse number="23" style="v" sid="DEU 7:23" />అయితే మీ దేవుడైన యెహోవా వారిని మీ చేతికి అప్పగించి, వారు నాశనం చేయబడేవరకు, వారికి గొప్ప కలవరాన్ని పుట్టిస్తారు. <verse eid="DEU 7:23" /><verse number="24" style="v" sid="DEU 7:24" />ఆయన వారి రాజులను మీ చేతికి అప్పగిస్తారు. మీరు వారి పేర్లను ఆకాశం క్రిందనుండి తుడిచివేస్తారు. మీకు విరోధంగా ఎవరు నిలువలేరు; మీరు వారిని నాశనం చేస్తారు. <verse eid="DEU 7:24" /><verse number="25" style="v" sid="DEU 7:25" />మీరు వారి దేవుళ్ళ విగ్రహాలను అగ్నిలో కాల్చివేయాలి. వాటి మీది వెండి బంగారాలను ఆశించి, మీ కోసం తీసుకోకూడదు, లేకపోతే దాని వలన మీరు చిక్కులో పడతారు. మీ దేవుడైన యెహోవాకు అది అసహ్యము. <verse eid="DEU 7:25" /><verse number="26" style="v" sid="DEU 7:26" />అసహ్యమైన వాటిని మీరు ఇంటికి తీసుకురాకూడదు, లేదా మీరు, దానివలె నాశనానికి మీరు వేరు చేయబడతారు. అది నాశనం కోసం వేరు చేయబడుతుంది కాబట్టి దానిని నీచమైనదిగా చూసి పూర్తిగా అసహ్యించుకోవాలి.<verse eid="DEU 7:26" /></para>
  <chapter eid="DEU 7" />
  <chapter number="8" style="c" sid="DEU 8" />
  <para style="s1">యెహోవాను మరచిపోకండి</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 8:1" />మీరు జీవించి అభివృద్ధిచెంది, యెహోవా మీ పూర్వికులకు ప్రమాణం చేసిన దేశానికి వెళ్లి దానిని స్వాధీనం చేసుకునేలా, ఈ రోజు నేను మీకిచ్చే ప్రతి ఆజ్ఞను జాగ్రత్తగా అనుసరించాలి. <verse eid="DEU 8:1" /><verse number="2" style="v" sid="DEU 8:2" />మీరు ఆయన ఆజ్ఞలను పాటిస్తారో లేదో అని మిమ్మల్ని పరీక్షించి మీ హృదయంలో ఏమున్నదో తెలుసుకోవడానికి మిమ్మల్ని దీనులుగా చేయడానికి మీ దేవుడైన యెహోవా మిమ్మల్ని అరణ్యంలో ఈ నలభై సంవత్సరాలు ఎలా నడిపించారో జ్ఞాపకం చేసుకోండి. <verse eid="DEU 8:2" /><verse number="3" style="v" sid="DEU 8:3" />మనుష్యులు కేవలం ఆహారం వల్లనే జీవించరు కాని యెహోవా నోటి నుండి వచ్చే ప్రతి మాట వలన జీవిస్తారు అని మీకు నేర్పించడానికి ఆయన మిమ్మల్ని అణచి మీకు ఆకలి కలిగించి మీకు గాని మీ పూర్వికులకు గాని ఇంతకుముందు తెలియని మన్నాతో మిమ్మల్ని పోషించారు. <verse eid="DEU 8:3" /><verse number="4" style="v" sid="DEU 8:4" />ఈ నలభై సంవత్సరాలు మీరు వేసుకున్న బట్టలు పాతబడలేదు, మీ కాళ్లు వాయలేదు. <verse eid="DEU 8:4" /><verse number="5" style="v" sid="DEU 8:5" />ఒకరు తన కుమారుని ఎలా క్రమశిక్షణలో పెడతారో, అలాగే మీ దేవుడైన యెహోవా మిమ్మల్ని క్రమశిక్షణలో పెడతారని మీ హృదయంలో మీరు గ్రహించాలి.<verse eid="DEU 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 8:6" />మీరు మీ దేవుడైన యెహోవాయందు భయం కలిగి, ఆయన మార్గంలో నడుస్తూ, ఆయన ఆజ్ఞలను పాటించాలి. <verse eid="DEU 8:6" /><verse number="7" style="v" sid="DEU 8:7" />మీ దేవుడైన యెహోవా మిమ్మల్ని మంచి దేశంలోకి తీసుకెళ్తారు; అది నదులు నీటిప్రవాహాలు లోయల నుండి కొండల నుండి ఉబికే లోతైన నీటి ఊటలు ఉండే దేశం; <verse eid="DEU 8:7" /><verse number="8" style="v" sid="DEU 8:8" />అంతేకాదు గోధుమలు యవలు ద్రాక్షచెట్లు అంజూర చెట్లు దానిమ్మపండ్లు ఒలీవనూనె తేనె దొరికే దేశం; <verse eid="DEU 8:8" /><verse number="9" style="v" sid="DEU 8:9" />ఆ దేశంలో రొట్టెలకు కొరత ఉండదు మీకు ఏది తక్కువకాదు; ఇనుప రాళ్లు గల దేశం, దాని కొండల్లో మీరు రాగి త్రవ్వితీయవచ్చు.<verse eid="DEU 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 8:10" />మీరు తిని తృప్తి చెందిన తర్వాత, మీ దేవుడైన యెహోవా మీకు ఇచ్చిన మంచి దేశాన్ని బట్టి ఆయనను స్తుతించండి. <verse eid="DEU 8:10" /><verse number="11" style="v" sid="DEU 8:11" />ఈ రోజు నేను మీకు ఇచ్చే ఆయన ఆజ్ఞలను, చట్టాలను శాసనాలను పాటించడంలో విఫలమై మీ దేవుడనైన యెహోవాను మరచిపోకుండ జాగ్రత్తపడండి. <verse eid="DEU 8:11" /><verse number="12" style="v" sid="DEU 8:12" />లేకపోతే మీరు తిని తృప్తి చెందినప్పుడు, మీరు మంచి ఇళ్ళు కట్టుకుని వాటిలో స్థిరపడినప్పుడు, <verse eid="DEU 8:12" /><verse number="13" style="v" sid="DEU 8:13" />మీ పశువుల మందలు విస్తరించి, వెండి బంగారాలు విస్తరించి, మీకు ఉన్నదంతా వృద్ధి చెందినప్పుడు, <verse eid="DEU 8:13" /><verse number="14" style="v" sid="DEU 8:14" />మీ హృదయం గర్వించి, బానిస దేశమైన ఈజిప్టులో నుండి మిమ్మల్ని బయటకు తీసుకువచ్చిన మీ దేవుడైన యెహోవాను మరచిపోతారు. <verse eid="DEU 8:14" /><verse number="15" style="v" sid="DEU 8:15" />ఆయన మిమ్మల్ని విషసర్పాలు, తేళ్లు ఉన్న నీళ్లు లేని భయంకరమైన పెద్ద అరణ్యంలో నుండి నడిపించారు. రాతి బండ నుండి మీకు నీళ్లు ఇచ్చారు. <verse eid="DEU 8:15" /><verse number="16" style="v" sid="DEU 8:16" />ఆయన అరణ్యంలో మీ పూర్వికులకు ఎన్నడూ తెలియని మన్నాను మీకు తినడానికి ఇచ్చారు, మిమ్మల్ని తగ్గించడానికి మిమ్మల్ని పరీక్షించడానికి మీ మంచి కోసం ఇచ్చారు. <verse eid="DEU 8:16" /><verse number="17" style="v" sid="DEU 8:17" />“నా శక్తి, నా చేతుల బలం ఈ సంపదను నాకు సంపాదించాయి” అని మీలో మీరు అనుకోవచ్చు. <verse eid="DEU 8:17" /><verse number="18" style="v" sid="DEU 8:18" />కాని, మీ దేవుడైన యెహోవాను జ్ఞాపకం చేసుకోండి, ఆయన మీ పూర్వికులకు ప్రమాణం చేసినట్లు, తన నిబంధన ఈ రోజు ఉన్నట్లుగా స్థిరపరచడానికి మీరు సంపదను సంపాదించే సామర్థ్యం ఇచ్చేవారు ఆయనే.<verse eid="DEU 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 8:19" />మీరు మీ దేవుడనైన యెహోవాను మరచిపోయి, ఇతర దేవుళ్ళను వెంబడించి పూజించి వాటిని సేవిస్తే, మీరు ఖచ్చితంగా నశించిపోతారని మీకు వ్యతిరేకంగా సాక్ష్యమిస్తున్నాను. <verse eid="DEU 8:19" /><verse number="20" style="v" sid="DEU 8:20" />మీ దేవుడైన యెహోవాకు లోబడకపోతే, మీ ఎదుట ఉండకుండా యెహోవా నాశనం చేసిన దేశాల్లా మీరు నాశనమవుతారు.<verse eid="DEU 8:20" /></para>
  <chapter eid="DEU 8" />
  <chapter number="9" style="c" sid="DEU 9" />
  <para style="s1">ఇశ్రాయేలీయుల నీతిని బట్టి కాదు</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 9:1" />ఇశ్రాయేలూ, విను: ఇప్పుడు మీరు ఆకాశాన్నంటే ఎత్తైన గోడలున్న పెద్ద పట్టణాలు గల మీకన్నా గొప్ప బలమైన దేశాలను, స్వాధీనం చేసుకోవడానికి మీరు యొర్దాను దాటబోతున్నారు. <verse eid="DEU 9:1" /><verse number="2" style="v" sid="DEU 9:2" />అక్కడి ప్రజలు బలవంతులు పొడవైనవారు, వారు మీకు తెలిసిన అనాకీయుల వంశస్థులు. వారి గురించి, “అనాకీయుల ఎదుట ఎవరు నిలబడగలరు?” అని చెప్పడం మీరు విన్నారు కదా. <verse eid="DEU 9:2" /><verse number="3" style="v" sid="DEU 9:3" />అయితే దహించే అగ్నిలా మీ దేవుడైన యెహోవా మీకు ముందుగా దాటి వెళ్తారని మీరు నమ్మండి. ఆయన వారిని నాశనం చేస్తారు; మీ ఎదుట వారిని అణచివేస్తారు. యెహోవా మీకు ప్రమాణం చేసిన ప్రకారం, మీరు వారిని వెళ్లగొట్టి త్వరగా వారిని నిర్మూలం చేస్తారు.<verse eid="DEU 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 9:4" />మీ దేవుడైన యెహోవా మీ ఎదుట నుండి వారిని వెళ్లగొట్టిన తర్వాత, “మా నీతిని బట్టే ఈ దేశాన్ని స్వాధీనం చేసుకోవడానికి యెహోవా మమ్మల్ని ఇక్కడకు తీసుకువచ్చారు” అని మీ హృదయంలో అనుకోవద్దు. ఈ జనాంగాల దుర్మార్గాన్ని బట్టే యెహోవా మీ ఎదుట నుండి వారిని వెళ్లగొట్టబోతున్నారు. <verse eid="DEU 9:4" /><verse number="5" style="v" sid="DEU 9:5" />మీ నీతి, నిష్కపటమైన మీ హృదయం కారణంగా మీరు వారి దేశాన్ని స్వాధీనం చేసుకోవడంలేదు కాని ఈ జనాంగాల దుర్మార్గాన్ని బట్టే యెహోవా మీ పితరులైన అబ్రాహాము, ఇస్సాకు, యాకోబులతో చేసిన ప్రమాణాన్ని నెరవేర్చడానికి మీ దేవుడైన యెహోవా మీ ఎదుట నుండి వారిని వెళ్లగొడతారు. <verse eid="DEU 9:5" /><verse number="6" style="v" sid="DEU 9:6" />మీరు మొండి ప్రజలు కాబట్టి, మీ దేవుడైన యెహోవా స్వాధీనం చేసుకోవడానికి ఈ మంచి దేశాన్ని మీకు ఇవ్వడానికి మీ నీతి కారణం కాదని మీరు గ్రహించండి.<verse eid="DEU 9:6" /></para>
  <para style="s1">బంగారు దూడ</para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 9:7" />అరణ్యంలో మీరు మీ దేవుడైన యెహోవాకు ఎలా కోపం పుట్టించారో జ్ఞాపకం చేసుకోండి. మీరు ఈజిప్టు విడిచిన రోజు నుండి ఇక్కడకు వచ్చిన కాలం వరకు యెహోవా మీద తిరుగుబాటు చేస్తూనే ఉన్నారు. <verse eid="DEU 9:7" /><verse number="8" style="v" sid="DEU 9:8" />హోరేబులో యెహోవా మిమ్మల్ని నాశనం చేసేంతగా ఆయనకు కోపం పుట్టించారు. <verse eid="DEU 9:8" /><verse number="9" style="v" sid="DEU 9:9" />రాతిపలకలు అనగా, యెహోవా మీతో చేసిన నిబంధనకు సంబంధించి పలకలను తీసుకోవడానికి నేను పర్వతం మీదికి ఎక్కి వెళ్లినప్పుడు, ఆ పర్వతం మీద నేను నలభై పగళ్లు, నలభై రాత్రులు ఉన్నాను; నేను ఆహారం తినలేదు, నీళ్లు త్రాగలేదు. <verse eid="DEU 9:9" /><verse number="10" style="v" sid="DEU 9:10" />దేవుని వ్రేలితో వ్రాయబడిన రెండు రాతిపలకలను యెహోవా నాకు ఇచ్చారు. మీరందరు సమావేశమైన రోజున పర్వతం మీద అగ్ని మధ్యలో నుండి యెహోవా మీకు ప్రకటించిన ఆజ్ఞలు ఆ పలకల మీద ఉన్నాయి.<verse eid="DEU 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 9:11" />నలభై పగళ్లు, నలభై రాత్రులు గడిచినప్పుడు, యెహోవా రెండు రాతిపలకలు అనగా, నిబంధనకు సంబంధించిన పలకలు నాకు ఇచ్చారు. <verse eid="DEU 9:11" /><verse number="12" style="v" sid="DEU 9:12" />అప్పుడు యెహోవా నాతో, “నీవు వెంటనే ఇక్కడినుండి క్రిందికి వెళ్లు, నీవు ఈజిప్టు నుండి తీసుకువచ్చిన నీ ప్రజలు చెడిపోయారు. నేను వారికి ఆజ్ఞాపించిన మార్గం నుండి త్వరగా తొలగిపోయి తమ కోసం ఒక విగ్రహాన్ని తయారుచేసుకున్నారు” అని చెప్పారు.<verse eid="DEU 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 9:13" />ఇంకా యెహోవా నాతో, “నేను ఈ ప్రజలను చూశాను, వారు నిజంగా మొండి ప్రజలు. <verse eid="DEU 9:13" /><verse number="14" style="v" sid="DEU 9:14" />నన్ను విడిచిపెట్టు, నేను వారిని నాశనం చేసి, ఆకాశం క్రింద వారి పేరు ఉండకుండా తుడిచివేస్తాను. నిన్ను వారికంటే బలమైన దేశంగా, సంఖ్యలో వారికంటే ఎక్కువ ఉండేలా చేస్తాను” అని అన్నారు.<verse eid="DEU 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 9:15" />కాబట్టి నేను పర్వతం అగ్నితో మండుతున్నప్పుడు తిరిగి పర్వతం దిగి వచ్చాను. రెండు నిబంధన పలకలు నా చేతిలో ఉన్నాయి. <verse eid="DEU 9:15" /><verse number="16" style="v" sid="DEU 9:16" />నేను చూసినప్పుడు, మీ దేవుడైన యెహోవాకు వ్యతిరేకంగా మీరు పాపం చేశారని నేను చూశాను; దూడ రూపంలో తయారుచేసిన విగ్రహాన్ని మీ కోసం తయారుచేసుకున్నారు. యెహోవా మీకు ఆజ్ఞాపించిన మార్గంలో నుండి త్వరగా తొలగిపోయారు. <verse eid="DEU 9:16" /><verse number="17" style="v" sid="DEU 9:17" />కాబట్టి నా చేతుల్లో ఉన్న రెండు పలకలను విసిరి, మీ కళ్లముందే వాటిని ముక్కలు చేశాను.<verse eid="DEU 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 9:18" />యెహోవా దృష్టిలో చెడుగా ప్రవర్తించి చేసిన పాపాలన్నిటిని బట్టి మీరు ఆయనకు కోపం పుట్టించిన కారణంగా మళ్ళీ నేను నలభై పగళ్లు నలభై రాత్రులు ఆహారం తినకుండా నీళ్లు త్రాగకుండా యెహోవా ఎదుట సాష్టాంగపడ్డాను. <verse eid="DEU 9:18" /><verse number="19" style="v" sid="DEU 9:19" />మిమ్మల్ని నాశనం చేయాలన్నంతగా కోప్పడిన యెహోవా కోపాన్ని ఉగ్రతను చూసి నేను భయపడ్డాను. కాని యెహోవా మరలా నా మనవి ఆలకించారు. <verse eid="DEU 9:19" /><verse number="20" style="v" sid="DEU 9:20" />అహరోనును కూడా నాశనం చేసేంతగా యెహోవా అతనిపై కోప్పడ్డారు, కాని నేను అప్పుడు అహరోను కోసం కూడా ప్రార్థన చేశాను. <verse eid="DEU 9:20" /><verse number="21" style="v" sid="DEU 9:21" />అలాగే మీరు చేసిన పాపిష్ఠి పని, అనగా దూడ విగ్రహాన్ని తీసుకుని అగ్నిలో కాల్చివేశాను. తర్వాత నలగ్గొట్టి దుమ్ము అంత మెత్తగా దానిని పొడిచేసి, ఆ పర్వతం నుండి ప్రవహిస్తున్న వాగులో పడేశాను.<verse eid="DEU 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 9:22" />తబేరా, మస్సా, కిబ్రోతు హత్తావాలలో కూడా మీరు యెహోవాకు కోపం పుట్టించారు.<verse eid="DEU 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 9:23" />యెహోవా మిమ్మల్ని కాదేషు బర్నియాలో నుండి పంపిస్తున్నప్పుడు ఆయన మీతో, “మీరు వెళ్లి నేను మీకు ఇచ్చిన దేశాన్ని స్వాధీనం చేసుకోండి” అని చెప్పారు. కాని మీరు మీ దేవుడైన యెహోవా ఆజ్ఞకు తిరుగుబాటు చేశారు. మీరు ఆయనను నమ్మలేదు, లోబడలేదు. <verse eid="DEU 9:23" /><verse number="24" style="v" sid="DEU 9:24" />మీరు నాకు తెలిసినప్పటినుండి మీరు యెహోవా మీద తిరుగుబాటు చేస్తూనే ఉన్నారు.<verse eid="DEU 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 9:25" />యెహోవా మిమ్మల్ని నాశనం చేస్తానని చెప్పిన కారణంగా నేను ఆ నలభై పగళ్లు నలభై రాత్రులు యెహోవా ఎదుట సాష్టాంగపడ్డాను. <verse eid="DEU 9:25" /><verse number="26" style="v" sid="DEU 9:26" />నేను యెహోవాకు ఇలా ప్రార్థన చేశాను, “ప్రభువైన యెహోవా! మీ గొప్ప బలంతో విడిపించి, మీ బలమైన హస్తంతో ఈజిప్టులో నుండి బయటకు తీసుకువచ్చిన మీ స్వాస్థ్యమైన మీ ప్రజలను నాశనం చేయవద్దు. <verse eid="DEU 9:26" /><verse number="27" style="v" sid="DEU 9:27" />మీ సేవకులైన అబ్రాహాము, ఇస్సాకు, యాకోబులను జ్ఞాపకం చేసుకోండి. ఈ ప్రజల మొండితనాన్ని చెడుతనాన్ని పాపాన్ని పట్టించుకోకండి. <verse eid="DEU 9:27" /><verse number="28" style="v" sid="DEU 9:28" />లేకపోతే మీరు మమ్మల్ని ఏ దేశం నుండి బయటకు తీసుకువచ్చారో ఆ ప్రజలు, ‘యెహోవా వారికి వాగ్దానం చేసిన దేశంలోనికి వారిని తీసుకెళ్లలేక పోయారు, వారిని ద్వేషించారు కాబట్టి అరణ్యంలో చంపడానికి వారిని బయటకు తీసుకెళ్లారు’ అని చెప్పుకుంటారు. <verse eid="DEU 9:28" /><verse number="29" style="v" sid="DEU 9:29" />అయితే వారు మీ ప్రజలు, మీ అధిక బలం చేత, మీ చాచిన చేతి చేత మీరు బయటకు తీసుకువచ్చిన మీ స్వాస్థ్యము.”<verse eid="DEU 9:29" /></para>
  <chapter eid="DEU 9" />
  <chapter number="10" style="c" sid="DEU 10" />
  <para style="s1">మొదటి పలకలవంటి పలకలు</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 10:1" />అప్పుడు యెహోవా నాతో అన్నారు, “నీవు మొదటి పలకలవంటి మరో రెండు రాతిపలకలను చెక్కి పర్వతమెక్కి నా దగ్గరకు రా. అలాగే ఒక కర్ర మందసాన్ని తయారుచేయు. <verse eid="DEU 10:1" /><verse number="2" style="v" sid="DEU 10:2" />నీవు పగులగొట్టిన మొదటి పలకల మీద ఉన్న మాటలనే నేను వాటిపై వ్రాస్తాను. తర్వాత నీవు వాటిని ఆ మందసంలో ఉంచాలి.”<verse eid="DEU 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 10:3" />కాబట్టి నేను తుమ్మకర్రతో మందసం చేసి, మొదటి వాటిలా రెండు రాతిపలకలను చెక్కి, నా చేతులతో ఆ రెండు రాతిపలకలు పట్టుకుని నేను పైకి వెళ్లాను. <verse eid="DEU 10:3" /><verse number="4" style="v" sid="DEU 10:4" />సమావేశమైన రోజున, పర్వతం మీద, అగ్ని మధ్యలో నుండి మీకు ప్రకటించిన పది ఆజ్ఞలను మొదట వ్రాసినట్లుగానే, యెహోవా ఆ పలకల మీద వ్రాశారు. యెహోవా వాటిని నాకు ఇచ్చారు. <verse eid="DEU 10:4" /><verse number="5" style="v" sid="DEU 10:5" />తర్వాత నేను పర్వతం దిగివచ్చి, యెహోవా నాకు ఆజ్ఞాపించిన ప్రకారం, నేను చేసిన మందసంలో ఆ పలకలను ఉంచాను. ఇప్పుడవి దానిలో ఉన్నాయి.<verse eid="DEU 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 10:6" />ఇశ్రాయేలీయులు బెనె యహకాను బావులనుండి మొసేరాకు ప్రయాణించారు. అక్కడ అహరోను చనిపోయి పాతిపెట్టబడ్డాడు, అతని కుమారుడైన ఎలియాజరు అతనికి బదులుగా యాజకుడయ్యాడు. <verse eid="DEU 10:6" /><verse number="7" style="v" sid="DEU 10:7" />అక్కడినుండి వారు గుద్గోదకు, తర్వాత నీటిప్రవాహాలు ఉన్న దేశమైన యొత్బాతాకు ప్రయాణించారు. <verse eid="DEU 10:7" /><verse number="8" style="v" sid="DEU 10:8" />నేటి వరకు చేస్తున్నట్లుగా, యెహోవా నిబంధన మందసాన్ని మోయడానికి, యెహోవా సన్నిధిలో నిలబడి సేవ చేయడానికి, ఆయన పేరిట ఆశీర్వచనం పలకడానికి లేవీ గోత్రికులను ఆ సమయంలో యెహోవా ప్రత్యేకించుకున్నారు. <verse eid="DEU 10:8" /><verse number="9" style="v" sid="DEU 10:9" />అందుకే లేవీయులకు వారి తోటి ఇశ్రాయేలీయులతో పాటు వాటా గాని స్వాస్థ్యం గాని లేదు; మీ దేవుడైన యెహోవా వారితో చెప్పినట్లు యెహోవాయే వారి స్వాస్థ్యము.<verse eid="DEU 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 10:10" />మొదట ఉన్నట్లే నేను ఆ పర్వతం మీద నలభై పగళ్లు నలభై రాత్రులు ఉన్నాను, ఈసారి కూడా యెహోవా నా మనవి ఆలకించారు. మిమ్మల్ని నాశనం చేయడం ఆయన చిత్తం కాదు. <verse eid="DEU 10:10" /><verse number="11" style="v" sid="DEU 10:11" />యెహోవా నాతో అన్నారు, “నీవు లేచి వెళ్లు, వారికి ఇస్తానని వారి పూర్వికులతో నేను ప్రమాణం చేసిన దేశంలోనికి వారు వెళ్లి, దానిని స్వాధీనం చేసుకునేటట్లు నీవు వారిని నడిపించు.”<verse eid="DEU 10:11" /></para>
  <para style="s1">యెహోవాకు భయపడండి</para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 10:12" />ఇశ్రాయేలూ, మీ దేవుడైన యెహోవా మిమ్మల్ని ఏమి అడుగుతున్నారు? మీ దేవుడైన యెహోవాయందు మీరు భయం కలిగి ఉండాలని, ఆయన మార్గంలో నడవాలని, ఆయనను ప్రేమించాలని, మీ పూర్ణమనస్సుతో, మీ పూర్ణాత్మతో మీ దేవుడనైన యెహోవాను సేవించాలని, <verse eid="DEU 10:12" /><verse number="13" style="v" sid="DEU 10:13" />మీ మేలుకోసం ఈ రోజు నేను మీకు ఆజ్ఞాపిస్తున్న యెహోవా ఆజ్ఞలు శాసనాలు పాటించమనే కదా?<verse eid="DEU 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 10:14" />ఆకాశాలు, మహాకాశాలు, భూమి, భూమిపై ఉన్నవన్నీ మీ దేవుడైన యెహోవాకు చెందినవి. <verse eid="DEU 10:14" /><verse number="15" style="v" sid="DEU 10:15" />అయితే యెహోవా మీ పూర్వికులపై తన దయ చూపించి, వారిని ప్రేమించి, జనాంగాలందరిలో వారి సంతానమైన మిమ్మల్ని ఈ రోజు వలె ఏర్పరచుకున్నారు. <verse eid="DEU 10:15" /><verse number="16" style="v" sid="DEU 10:16" />కాబట్టి మీ హృదయాలను సున్నతి చేసుకుని ఇకపై మొండిగా ఉండకండి. <verse eid="DEU 10:16" /><verse number="17" style="v" sid="DEU 10:17" />ఎందుకంటే, మీ దేవుడైన యెహోవా దేవుళ్ళకు దేవుడు ప్రభువులకు ప్రభువు, గొప్ప దేవుడు, బలవంతుడు, అద్భుత దేవుడు, పక్షపాతం లేనివారు, లంచం పుచ్చుకోని దేవుడు. <verse eid="DEU 10:17" /><verse number="18" style="v" sid="DEU 10:18" />తండ్రిలేనివారికి, విధవరాండ్రకు న్యాయం తీరుస్తారు, మీ మధ్యన ఉన్న విదేశీయులను ప్రేమించి వారికి అన్నవస్త్రాలు ఇస్తారు. <verse eid="DEU 10:18" /><verse number="19" style="v" sid="DEU 10:19" />మీరు కూడ ఈజిప్టులో విదేశీయులుగా ఉన్నారు కాబట్టి మీరు విదేశీయులను ప్రేమించాలి. <verse eid="DEU 10:19" /><verse number="20" style="v" sid="DEU 10:20" />మీ దేవుడైన యెహోవాకు భయపడి, ఆయనను సేవించండి. ఆయనను గట్టిగా పట్టుకుని ఆయన పేరిట ప్రమాణాలు చేయండి. <verse eid="DEU 10:20" /><verse number="21" style="v" sid="DEU 10:21" />మీరు స్తుతించవలసింది ఆయననే; మీ కళ్లారా మీరు చూసిన గొప్ప భయంకరమైన అద్భుతాలను మీ కోసం చేసిన మీ దేవుడు ఆయనే. <verse eid="DEU 10:21" /><verse number="22" style="v" sid="DEU 10:22" />ఈజిప్టుకు వెళ్లినప్పుడు మీ పూర్వికులు మొత్తం డెబ్బైమంది, అయితే ఇప్పుడు మీ దేవుడైన యెహోవా ఆకాశంలోని నక్షత్రాలవలె మిమ్మల్ని అసంఖ్యాకంగా వృద్ధిచేశారు.<verse eid="DEU 10:22" /></para>
  <chapter eid="DEU 10" />
  <chapter number="11" style="c" sid="DEU 11" />
  <para style="s1">యెహోవాను ప్రేమించి ఆయనకు లోబడండి</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 11:1" />మీ దేవుడైన యెహోవాను ప్రేమించి ఆయన మీకు చెప్పేవాటన్నిటిని, ఆయన శాసనాలను, ఆయన చట్టాలను, ఆయన ఆజ్ఞలను ఎల్లప్పుడు పాటించాలి. <verse eid="DEU 11:1" /><verse number="2" style="v" sid="DEU 11:2" />మీ దేవుడైన యెహోవా క్రమశిక్షణను చూసింది, అనుభవించింది మీ పిల్లలు కాదని ఈ రోజు జ్ఞాపకం చేసుకోండి: ఆయన మహిమను, ఆయన బలమైన హస్తాన్ని, ఆయన చాచిన చేయిని; <verse eid="DEU 11:2" /><verse number="3" style="v" sid="DEU 11:3" />ఈజిప్టులో, ఈజిప్టు రాజైన ఫరోకు అతని దేశమంతటికి ఆయన చేసిన అసాధారణ గుర్తులు; <verse eid="DEU 11:3" /><verse number="4" style="v" sid="DEU 11:4" />ఈజిప్టు సైన్యానికి, దాని గుర్రాలకు రథాలకు ఆయన చేసింది, వారు మిమ్మల్ని తరుముతున్నప్పుడు ఆయన ఎర్ర సముద్రపు నీటితో వారిని కప్పివేయడం, యెహోవా వారిపై నిత్య నాశనం ఎలా తెచ్చారో మీరు చూశారు. <verse eid="DEU 11:4" /><verse number="5" style="v" sid="DEU 11:5" />మీరు ఈ చోటికి చేరుకునేవరకు అరణ్యంలో ఆయన మీ కోసం ఏమి చేశారో చూసింది మీ పిల్లలు కాదు. <verse eid="DEU 11:5" /><verse number="6" style="v" sid="DEU 11:6" />ఆయన రూబేనీయుడైన ఏలీయాబు కుమారులైన దాతాను అబీరాములకు చేసిన దానిని అనగా ఇశ్రాయేలీయులందరి మధ్యలో భూమి నోరు తెరిచి వారిని వారు కుటుంబాలను వారి గుడారాలను వారికి చెందిన ప్రతి జీవిని మ్రింగివేసిన విధానాన్ని మీరు చూశారు. <verse eid="DEU 11:6" /><verse number="7" style="v" sid="DEU 11:7" />యెహోవా చేసిన ఈ గొప్ప కార్యాలన్నిటిని చూసింది మీ సొంత కళ్లు.<verse eid="DEU 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 11:8" />కాబట్టి ఈ రోజు నేను మీకు ఇస్తున్న ఆజ్ఞలన్నిటిని పాటించండి, అప్పుడు మీరు స్వాధీనం చేసుకోవడానికి యొర్దాను దాటి వెళ్తున్న ఆ దేశంలోనికి వెళ్లడానికి బలం కలిగి ఉంటారు, <verse eid="DEU 11:8" /><verse number="9" style="v" sid="DEU 11:9" />తద్వార వారికి వారి సంతానానికి ఇస్తానని యెహోవా మీ పూర్వికులతో వాగ్దానం చేసిన దేశంలో అనగా పాలు తేనెలు ప్రవహించే దేశంలో మీరు అధిక కాలం జీవిస్తారు. <verse eid="DEU 11:9" /><verse number="10" style="v" sid="DEU 11:10" />మీరు స్వాధీనం చేసుకోబోయే దేశం మీరు విడిచి వచ్చిన ఈజిప్టు దేశం వంటిది కాదు; అక్కడ మీరు విత్తనాలు విత్తి కూరతోటలలో చేసినట్లు వాటికి కాళ్లతో నీరు పెట్టారు. <verse eid="DEU 11:10" /><verse number="11" style="v" sid="DEU 11:11" />మీరు యొర్దాను దాటి వెళ్లి స్వాధీనం చేసుకోబోయే దేశం ఆకాశపు వర్షాన్ని త్రాగే పర్వతాలు లోయలు ఉన్న దేశము. <verse eid="DEU 11:11" /><verse number="12" style="v" sid="DEU 11:12" />అది మీ దేవుడైన యెహోవా సంరక్షించే దేశము; సంవత్సరాది మొదలుకొని సంవత్సరాంతం వరకు మీ దేవుడైన యెహోవా దృష్టి దాని మీద నిలిచి ఉంటుంది.<verse eid="DEU 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 11:13" />కాబట్టి ఈ రోజు నేను మీకు ఇచ్చే ఆజ్ఞలకు నమ్మకంగా లోబడితే, మీరు మీ పూర్ణహృదయంతో మీ పూర్ణాత్మతో మీ దేవుడైన యెహోవాను ప్రేమించి ఆయనను సేవించాలి. <verse eid="DEU 11:13" /><verse number="14" style="v" sid="DEU 11:14" />అప్పుడు మీ దేశంలో సకాలంలో తొలకరి కడవరి వర్షాలు కురిపిస్తాను. అప్పుడు మీరు ధాన్యాన్ని క్రొత్త ద్రాక్షరసాన్ని, ఒలీవ నూనెను సమకూర్చుకోవచ్చు. <verse eid="DEU 11:14" /><verse number="15" style="v" sid="DEU 11:15" />మీ పశువుల కోసం మీ పొలాల్లో గడ్డి మొలిపిస్తాను; మీరు తిని తృప్తి చెందుతారు.<verse eid="DEU 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 11:16" />జాగ్రత్తపడండి, లేదా మీరు మోసపోయి ఇతర దేవుళ్ళ వైపు తిరిగి వాటిని పూజించి సేవిస్తారు. <verse eid="DEU 11:16" /><verse number="17" style="v" sid="DEU 11:17" />అప్పుడు యెహోవా కోపం మీమీద రగులుకొని ఆయన ఆకాశాన్ని మూసేస్తారు, అప్పుడు వాన కురవదు, భూమి పండదు, యెహోవా మీకు ఇవ్వబోయే ఆ మంచి దేశంలో ఉండకుండా మీరు త్వరలోనే నశించిపోతారు. <verse eid="DEU 11:17" /><verse number="18" style="v" sid="DEU 11:18" />ఈ నా మాటలు మీ మనస్సులో హృదయంలో ఉంచుకోండి; వాటిని సూచనలుగా మీ చేతికి కట్టుకోండి, మీ నుదిటి మీద బాసికాలుగా కట్టుకోండి. <verse eid="DEU 11:18" /><verse number="19" style="v" sid="DEU 11:19" />వాటిని మీ పిల్లలకు నేర్పించండి. మీరు ఇంటి దగ్గర కూర్చున్నప్పుడు, దారిలో నడుస్తున్నప్పుడు మీరు పడుకున్నప్పుడు లేచినప్పుడు వాటి గురించి మాట్లాడుతూ ఉండాలి. <verse eid="DEU 11:19" /><verse number="20" style="v" sid="DEU 11:20" />మీ ఇంటి ద్వారబంధాల మీద ద్వారాల మీద వాటిని వ్రాయండి, <verse eid="DEU 11:20" /><verse number="21" style="v" sid="DEU 11:21" />తద్వార యెహోవా మీ పూర్వికులకు ఇస్తానని ప్రమాణం చేసిన దేశంలో మీరు, మీ పిల్లలు ఎక్కువ రోజులు అనగా భూమిపై ఆకాశం ఉన్నంత కాలం మీరు జీవిస్తారు.<verse eid="DEU 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 11:22" />మీరు పాటించాలని నేను మీకు ఇస్తున్న ఆజ్ఞలను మీరు జాగ్రతగా పాటిస్తే అనగా మీ దేవుడైన యెహోవాను ప్రేమించి, ఆయన మార్గాల్లో నడుస్తూ, ఆయనను అంటిపెట్టుకుని ఉండాలి. <verse eid="DEU 11:22" /><verse number="23" style="v" sid="DEU 11:23" />అప్పుడు యెహోవా మీ ఎదుట నుండి ఈ జనాంగాలన్నిటిని వెళ్లగొడతారు. మీకంటే విస్తారమైన, బలమైన దేశాలను మీరు వెళ్లగొడతారు. <verse eid="DEU 11:23" /><verse number="24" style="v" sid="DEU 11:24" />మీరు అడుగుపెట్టే ప్రతి చోటు మీదే అవుతుంది: ఎడారి నుండి లెబానోను వరకు, యూఫ్రటీసు నది నుండి మధ్యధరా సముద్రం వరకు మీ సరిహద్దులు వ్యాపిస్తాయి. <verse eid="DEU 11:24" /><verse number="25" style="v" sid="DEU 11:25" />మీకు ఎదురుగా ఎవరు నిలబడలేరు. ఆయన మీకు వాగ్దానం చేసిన ప్రకారం మీ దేవుడైన యెహోవా మీరు వెళ్లే దేశమంతటికి మీరంటే వణుకును భయాన్ని పుట్టిస్తారు.<verse eid="DEU 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 11:26" />చూడండి, ఈ రోజు నేను మీ ముందు దీవెనను శాపాన్ని ఉంచుతున్నాను. <verse eid="DEU 11:26" /><verse number="27" style="v" sid="DEU 11:27" />ఈ రోజు నేను మీకు ఇచ్చే మీ దేవుడైన యెహోవా ఆజ్ఞలకు లోబడితే మీకు దీవెన; <verse eid="DEU 11:27" /><verse number="28" style="v" sid="DEU 11:28" />మీ దేవుడైన యెహోవా ఆజ్ఞలకు లోబడకుండా, ఈ రోజు నేను మీకు ఆజ్ఞాపించే మార్గాన్ని విడిచిపెట్టి మీకు తెలియని ఇతర దేవుళ్ళను అనుసరిస్తే మీకు శాపం. <verse eid="DEU 11:28" /><verse number="29" style="v" sid="DEU 11:29" />మీరు స్వాధీనం చేసుకోబోతున్న దేశంలోనికి మీ దేవుడైన యెహోవా మిమ్మల్ని చేర్చిన తర్వాత, గెరిజీము పర్వతం మీద దీవెనను ఏబాలు పర్వతంమీద శాపాన్ని ప్రకటించాలి. <verse eid="DEU 11:29" /><verse number="30" style="v" sid="DEU 11:30" />మీకు తెలిసినట్లు, ఈ పర్వతాలు యొర్దాను అవతల సూర్యుడు అస్తమించే దిక్కుకు వెనుక మోరె లోని సింధూర వృక్షాల దగ్గర గిల్గాలు ప్రాంతంలో ఉన్న అరాబాలో నివసించే కనానీయుల సరిహద్దులో ఉన్నాయి. <verse eid="DEU 11:30" /><verse number="31" style="v" sid="DEU 11:31" />మీ దేవుడైన యెహోవా మీకు ఇవ్వబోతున్న దేశాన్ని స్వాధీనం చేసుకోవడానికి మీరు యొర్దాను నది దాటబోతున్నారు. మీరు దానిని స్వాధీనం చేసుకుని దానిలో నివసించినప్పుడు, <verse eid="DEU 11:31" /><verse number="32" style="v" sid="DEU 11:32" />ఈ రోజు నేను మీ ముందు ఉంచిన అన్ని శాసనాలను చట్టాలను తప్పనిసరిగా పాటించండి.<verse eid="DEU 11:32" /></para>
  <chapter eid="DEU 11" />
  <chapter number="12" style="c" sid="DEU 12" />
  <para style="s1">ఆరాధించే స్థలము</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 12:1" />మీరు స్వాధీనం చేసుకోవడానికి మీ పూర్వికుల దేవుడైన యెహోవా మీకు ఇచ్చిన దేశంలో మీరు నివసించినంత కాలం మీరు జాగ్రత్తగా అనుసరించవలసిన శాసనాలు చట్టాలు ఇవి. <verse eid="DEU 12:1" /><verse number="2" style="v" sid="DEU 12:2" />మీరు స్వాధీనం చేసుకోబోయే దేశాల్లో ఎక్కడైతే ప్రజలు తమ దేవుళ్ళను సేవిస్తారో, అనగా ఎత్తైన పర్వతాలమీద కొండల పైన విస్తరించి ఉన్న చెట్టు క్రింద ఉన్న ఆ స్థలాలన్నిటిని పూర్తిగా నాశనం చేయాలి. <verse eid="DEU 12:2" /><verse number="3" style="v" sid="DEU 12:3" />వారి బలిపీఠాలను పడగొట్టాలి, వారి పవిత్ర రాళ్లను పగులగొట్టాలి, వారి అషేరా స్తంభాలను అగ్నితో కాల్చివేయాలి; వారి దేవతల ప్రతిమలను కూల్చివేసి, వాటి పేర్లు ఆ స్థలంలో లేకుండా నిర్మూలం చేయాలి.<verse eid="DEU 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 12:4" />మీరు మీ దేవుడైన యెహోవాను వారి విధానంలో ఆరాధించకూడదు. <verse eid="DEU 12:4" /><verse number="5" style="v" sid="DEU 12:5" />కాని మీ దేవుడైన యెహోవా మీ గోత్రాలన్నిటిలో తన పేరును స్థాపించడానికి ఆయనకు నివాస స్థానంగా ఏర్పరచుకొనే స్థలాన్ని మీరు వెదికి ఆ స్థలానికి మీరు వెళ్లాలి; <verse eid="DEU 12:5" /><verse number="6" style="v" sid="DEU 12:6" />అక్కడికే మీరు మీ దహనబలులు, మీ బలులు, మీ దశమభాగాలు, ప్రత్యేక అర్పణలు, మీరు ఇస్తామన్న మ్రొక్కుబడులు, స్వేచ్ఛార్పణలు, పశువుల మందలో గొర్రెల మందలోని మొదట పుట్టిన వాటిని తీసుకురావాలి. <verse eid="DEU 12:6" /><verse number="7" style="v" sid="DEU 12:7" />మీ దేవుడైన యెహోవా మిమ్మల్ని ఆశీర్వదించారు కాబట్టి, అక్కడ మీ దేవుడైన యెహోవా సన్నిధిలో మీరు, మీ కుటుంబాలు తిని, మీ చేతి పనులన్నిటిని బట్టి సంతోషించాలి.<verse eid="DEU 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 12:8" />ఈ రోజు మనం ఇక్కడ చేస్తున్నట్లు మీలో ప్రతిఒక్కరు తమ దృష్టికి సరియైనది అనుకున్న దానిని చేయకూడదు, <verse eid="DEU 12:8" /><verse number="9" style="v" sid="DEU 12:9" />ఎందుకంటే, ఇంకా మీరు మీ దేవుడైన యెహోవా మీకు ఇస్తున్న విశ్రాంతి స్థలానికి వారసత్వ దేశాన్ని చేరుకోలేదు. <verse eid="DEU 12:9" /><verse number="10" style="v" sid="DEU 12:10" />అయితే మీరు యొర్దాను దాటి మీ దేవుడైన యెహోవా మీకు వారసత్వంగా ఇస్తున్న దేశంలో స్థిరపడాలి, మీరు క్షేమంగా జీవించేలా ఆయన మీ చుట్టూ ఉన్న శత్రువులందరి నుండి మీకు విశ్రాంతినిస్తారు. <verse eid="DEU 12:10" /><verse number="11" style="v" sid="DEU 12:11" />అప్పుడు యెహోవా తన నామానికి నివాస స్థలాన్ని ఏర్పరచుకుంటారు. నేను మీకు ఆజ్ఞాపించిన వాటన్నిటిని అనగా, మీ దహనబలులు, మీ బలులు, మీ దశమభాగాలు, ప్రత్యేక అర్పణలు, మీరు యెహోవాకు ఇస్తామని మ్రొక్కుబడి చేసుకున్న కానుకలు అక్కడికే తీసుకురావాలి. <verse eid="DEU 12:11" /><verse number="12" style="v" sid="DEU 12:12" />అక్కడ మీరు, మీ కుమారులు, మీ కుమార్తెలు, మీ దాసులు దాసీలు, భాగం గాని స్వాస్థ్యం గాని లేకుండా మీ ఇళ్ళలో ఉండే లేవీయులు మీ దేవుడైన యెహోవా సన్నిధిలో సంతోషించాలి. <verse eid="DEU 12:12" /><verse number="13" style="v" sid="DEU 12:13" />మీరు నచ్చిన ప్రతి స్థలంలో మీ దహనబలులు అర్పించకుండ జాగ్రత్తపడండి. <verse eid="DEU 12:13" /><verse number="14" style="v" sid="DEU 12:14" />మీ గోత్రాల్లో ఒకదానిలో యెహోవా ఏర్పరచుకొనే స్థలంలోనే మీ దహనబలులు అర్పించి, అక్కడే నేను ఆజ్ఞాపించే వాటన్నిటిని జరిగించాలి.<verse eid="DEU 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 12:15" />అయితే మీ దేవుడైన యెహోవా మీకు ఇచ్చిన ఆశీర్వాదం ప్రకారం, మీ ఇళ్ళలో ఉన్న పశువులను, జింకను లేదా దుప్పిని తిన్నట్లుగా మీకు ఇష్టం వచ్చినంత మాంసాన్ని తినవచ్చు. ఆచారరీత్య పవిత్రులైనవారు, అపవిత్రులైనవారు దానిని తినవచ్చు. <verse eid="DEU 12:15" /><verse number="16" style="v" sid="DEU 12:16" />అయితే మీరు రక్తాన్ని తినకూడదు; దానిని నీళ్లవలె నేలమీద పారవేయాలి. <verse eid="DEU 12:16" /><verse number="17" style="v" sid="DEU 12:17" />మీ ధాన్యంలో, క్రొత్త ద్రాక్షరసంలో, ఒలీవ నూనెలో దశమభాగాన్ని, లేదా మీ పశువుల్లో, మందలలో మొదట పుట్టిన దానిని, లేదా మీరు ఇస్తామన్న మ్రొక్కుబడులు, స్వేచ్ఛార్పణలు ప్రత్యేక అర్పణలు వేటిని మీ పట్టణాల్లో తినకూడదు. <verse eid="DEU 12:17" /><verse number="18" style="v" sid="DEU 12:18" />అయితే మీ దేవుడైన యెహోవా ఏర్పరచుకొను స్థలంలోనే మీరు, మీ కుమారులు, మీ కుమార్తెలు, మీ దాసదాసీలు, మీ పట్టణాల్లో ఉండే లేవీయులు, అందరు మీ దేవుడైన యెహోవా సన్నిధిలో తిని, మీ చేతి పనులన్నిటిని బట్టి మీ దేవుడైన యెహోవా సన్నిధిలో సంతోషించాలి. <verse eid="DEU 12:18" /><verse number="19" style="v" sid="DEU 12:19" />మీరు మీ దేశంలో ఉన్నంతకాలం లేవీయులను నిర్లక్ష్యం చేయకుండా జాగ్రత్తపడండి.<verse eid="DEU 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 12:20" />మీ దేవుడైన యెహోవా మీకు వాగ్దానం చేసిన ప్రకారం ఆయన మీ సరిహద్దులు విశాలపరచినప్పుడు, మీకు మాంసం తినాలనే ఆశ కలిగి, “నేను కొంత మాంసాన్ని తింటాను” అని అనుకోవచ్చు. అప్పుడు మీకు కావలసినంత మాంసాన్ని తినవచ్చు. <verse eid="DEU 12:20" /><verse number="21" style="v" sid="DEU 12:21" />మీ దేవుడైన యెహోవా తన నామం కోసం ఏర్పరచుకున్న స్థలం మీకు చాలా దూరంగా ఉంటే, యెహోవా మీకు ఇచ్చిన పశువుల్లో, మందలో నుండి పశువులను వధించి, నేను మీకు ఆజ్ఞాపించిన ప్రకారం మీ స్వస్థలాలలోనే మీకు కావలసినంత మాంసాన్ని మీరు తినవచ్చు. <verse eid="DEU 12:21" /><verse number="22" style="v" sid="DEU 12:22" />జింకను దుప్పిని తిన్నట్లుగా మీరు వాటిని తినవచ్చు. ఆచారరీత్య పవిత్రులైనవారు అపవిత్రులైనవారు తినవచ్చు. <verse eid="DEU 12:22" /><verse number="23" style="v" sid="DEU 12:23" />రక్తం తినకుండా చూసుకోండి, రక్తమంటే ప్రాణము కాబట్టి మాంసంతో పాటు ప్రాణాన్ని తినకూడదు. <verse eid="DEU 12:23" /><verse number="24" style="v" sid="DEU 12:24" />ఖచ్చితంగా మీరు రక్తాన్ని తినకూడదు; దానిని నీళ్లవలె నేలమీద పారవేయాలి. <verse eid="DEU 12:24" /><verse number="25" style="v" sid="DEU 12:25" />యెహోవా దృష్టిలో సరియైన దానిని మీరు చేస్తారు కాబట్టి దానిని తినకండి, అప్పుడు మీకు మీ తర్వాత మీ పిల్లలకు మేలు కలుగుతుంది.<verse eid="DEU 12:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 12:26" />అయితే మీ పవిత్ర వస్తువులను, మీరు ఇస్తానని మ్రొక్కుబడి చేసినవన్నీ తీసుకుని, యెహోవా ఎన్నుకునే ప్రదేశానికి వెళ్లండి. <verse eid="DEU 12:26" /><verse number="27" style="v" sid="DEU 12:27" />మీ దహనబలులను, వాటి రక్తమాంసాలను మీ దేవుడైన యెహోవా బలిపీఠం మీద అర్పించాలి. మీ బలుల రక్తాన్ని మీ దేవుడైన యెహోవా బలిపీఠం మీద పోయాలి, అయితే ఆ మాంసాన్ని మీరు తినవచ్చు. <verse eid="DEU 12:27" /><verse number="28" style="v" sid="DEU 12:28" />మీ దేవుడైన యెహోవా దృష్టిలో సరియైన దానిని మీరు చేస్తారు కాబట్టి మీకు, మీ తర్వాత మీ పిల్లలకు మేలు కలిగేలా నేను మీకు ఇస్తున్న నిబంధనలన్నిటిని మీరు జాగ్రత్తగా విని పాటించాలి.<verse eid="DEU 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DEU 12:29" />మీరు దాడి చేసి వెళ్లగొట్టబోతున్న జనాంగాలను మీ దేవుడైన యెహోవా మీ ఎదుట నుండి తొలగిస్తారు. అయితే మీరు వారిని వెళ్లగొట్టి వారి దేశంలో స్థిరపడిన తర్వాత, <verse eid="DEU 12:29" /><verse number="30" style="v" sid="DEU 12:30" />వారు మీ ఎదుట నుండి నిర్మూలమైనప్పుడు, మీరు వారి పద్ధతులను అనుసరించి, “ఈ ప్రజలు తమ దేవుళ్ళను ఎలా సేవిస్తున్నారు? మేము కూడా అలాగే చేస్తాము” అని అంటూ చిక్కుల్లో పడిపోకుండా జాగ్రత్తపడండి. <verse eid="DEU 12:30" /><verse number="31" style="v" sid="DEU 12:31" />వారి విధానాల్లో మీ దేవుడనైన యెహోవాను మీరు ఆరాధించకూడదు, ఎందుకంటే వారు తమ దేవుళ్ళను పూజిస్తూ యెహోవా ద్వేషించే అసహ్యమైన సమస్తాన్ని చేస్తారు. వారు తమ కుమారులను కుమార్తెలను తమ దేవుళ్ళకు బలిగా అగ్నిలో కాల్చివేస్తారు.<verse eid="DEU 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="DEU 12:32" />నేను మీకు ఆజ్ఞాపించిన వాటన్నిటిని మీరు పాటించేలా చూడండి; దానికి ఏది కలపవద్దు, దానిలో నుండి ఏది తీసివేయవద్దు.<verse eid="DEU 12:32" /></para>
  <chapter eid="DEU 12" />
  <chapter number="13" style="c" sid="DEU 13" />
  <para style="s1">ఇతర దేవుళ్ళను పూజించుట</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 13:1" />ప్రవక్త గాని కలల ద్వారా భవిష్యత్తును చెప్పగలవారు గాని మీ మధ్యకు వచ్చి, మీ ఎదుట ఒక గుర్తును లేదా అద్భుతాన్ని ప్రకటిస్తే, <verse eid="DEU 13:1" /><verse number="2" style="v" sid="DEU 13:2" />ఒకవేళ చెప్పిన గుర్తు లేదా అద్భుతం జరిగి, ఆ ప్రవక్త, “మనం ఇతర దేవుళ్ళను అనుసరిద్దాం” (మీకు తెలియని దేవుళ్ళు) “వాటిని సేవిద్దాం” అని ప్రలోభపెడితే, <verse eid="DEU 13:2" /><verse number="3" style="v" sid="DEU 13:3" />ఆ ప్రవక్త మాటలు లేదా కలలు కనేవారి మాటలు గాని మీరు వినకూడదు. మీరు మీ దేవుడైన యెహోవాను మీ పూర్ణహృదయంతో, మీ పూర్ణాత్మతో ప్రేమిస్తున్నారో లేదో తెలుసుకోవడానికి ఆయన మిమ్మల్ని పరీక్షిస్తున్నారు. <verse eid="DEU 13:3" /><verse number="4" style="v" sid="DEU 13:4" />మీరు మీ దేవుడైన యెహోవాను వెంబడించి ఆయనకు భయపడాలి; ఆయన ఆజ్ఞలను అనుసరించి ఆయనకు లోబడాలి; ఆయనను సేవించి ఆయనను హత్తుకుని ఉండాలి. <verse eid="DEU 13:4" /><verse number="5" style="v" sid="DEU 13:5" />ఈజిప్టు దేశంలో నుండి మిమ్మల్ని బయటకు తీసుకువచ్చి, బానిస దేశం నుండి మిమ్మల్ని విడిపించిన మీ దేవుడైన యెహోవా మీద మీరు తిరుగుబాటు చేయడానికి వారు మిమ్మల్ని ప్రేరేపించారు కాబట్టి వారు చంపబడాలి. ప్రవక్త లేదా కలలు కనేవారు మీ దేవుడైన యెహోవా మిమ్మల్ని అనుసరించమని ఆజ్ఞాపించిన మార్గం నుండి మిమ్మల్ని త్రిప్పివేయడానికి ప్రయత్నించారు. ఈ విధంగా మీ మధ్యలో నుండి చెడుతనాన్ని తొలగించాలి.<verse eid="DEU 13:5" /></para>
  <para style="p">
    <verse number="6-7" style="v" sid="DEU 13:6-7" />మీ సొంత సోదరుడు లేదా మీ కుమారుడు గాని కుమార్తె గాని, లేదా మీరు ప్రేమిస్తున్న భార్య లేదా మీ ప్రాణస్నేహితుడు గాని రహస్యంగా మిమ్మల్ని ప్రలోభపెట్టి, “మనం వెళ్లి ఇతర దేవుళ్ళను (మీకు గాని మీ పూర్వికులకు తెలియని దేవుళ్ళు, మీ చుట్టూ ఉన్న, మీకు దగ్గరగా ఉన్న, దూరంగా ఉన్న ప్రజల దేవుళ్ళు, భూమి ఒక చివరి నుండి ఇంకొక చివరి వరకు ఉన్న దేవుళ్ళు) సేవిద్దాం” అని చెప్తే, <verse eid="DEU 13:6-7" /><verse number="8" style="v" sid="DEU 13:8" />మీరు వారి మాటలు అంగీకరించవద్దు, వారి మాట వినవద్దు. వారి మీద జాలి చూపవద్దు. వారిని విడిచిపెట్టవద్దు, వారిని కాపాడవద్దు. <verse eid="DEU 13:8" /><verse number="9" style="v" sid="DEU 13:9" />వారిని ఖచ్చితంగా చంపాల్సిందే. వారిని చంపడానికి మిగిలిన ప్రజలందరి కంటే ముందు మీ చేయి వారి మీద పడాలి. <verse eid="DEU 13:9" /><verse number="10" style="v" sid="DEU 13:10" />వారిని రాళ్లతో కొట్టి చంపాలి ఎందుకంటే, ఈజిప్టు దేశంలో నుండి మిమ్మల్ని బయటకు తీసుకువచ్చి బానిస దేశం నుండి మిమ్మల్ని విడిపించిన మీ దేవుడైన యెహోవా దగ్గర నుండి మిమ్మల్ని దూరం చేయడానికి వారు ప్రయత్నించారు. <verse eid="DEU 13:10" /><verse number="11" style="v" sid="DEU 13:11" />అప్పుడు ఇశ్రాయేలీయులందరు విని భయపడతారు, మీలో ఎవరూ మరలా అలాంటి దుర్మార్గం చేయరు.<verse eid="DEU 13:11" /></para>
  <para style="p">
    <verse number="12-13" style="v" sid="DEU 13:12-13" />మీరు నివసించడానికి మీ దేవుడైన యెహోవా మీకు ఇస్తున్న పట్టణాల్లో దేనిలోనైనా దుష్టులు కొందరు మీ మధ్యలో లేచి, “మనం ఇతర దేవుళ్ళను సేవిద్దాం” అని చెప్పి (మీకు తెలియని దేవుళ్ళను) తమ పట్టణంలోని ప్రజలను ప్రోత్సహించినట్లు మీరు వినివుంటే, <verse eid="DEU 13:12-13" /><verse number="14" style="v" sid="DEU 13:14" />దాని గురించి మీరు విచారణ చేసి పూర్తిగా పరిశోధించి తెలుసుకోవాలి. అది నిజమై, మీ మధ్య ఈ అసహ్యకరమైన పని జరిగిందని నిరూపించబడితే, <verse eid="DEU 13:14" /><verse number="15" style="v" sid="DEU 13:15" />ఆ పట్టణంలో ఉన్న ప్రజలందరినీ ఖచ్చితంగా ఖడ్గంతో సంహరించాలి; దానిలో ఉన్న సమస్తాన్ని, అంటే ప్రజలను పశువులను పూర్తిగా నాశనం చేయాలి.<note caller="+" style="f"><char style="fr" closed="false">13:15 </char><char style="ft" closed="false">ఇక్కడ హెబ్రీ పదం వస్తువులను లేదా వ్యక్తులను తిరిగి మార్చుకోలేని విధంగా యెహోవాకు అప్పగించడాన్ని సూచిస్తుంది, తరచుగా వాటిని పూర్తిగా నాశనం చేయడమే; </char><char style="ft" closed="false">అలాగే <char style="xt"><ref loc="DEU 13:17">ద్వితీ 13:17</ref></char></char></note> <verse eid="DEU 13:15" /><verse number="16" style="v" sid="DEU 13:16" />దానిలో ఉన్న విలువైన వస్తువులన్నిటిని పట్టణంలో మధ్యలోనికి తీసుకువచ్చి మీ దేవుడైన యెహోవాకు దహనబలిగా ఆ పట్టణాన్ని, దానిలోని వస్తువులను పూర్తిగా కాల్చివేయాలి. ఆ పట్టణం మరలా కట్టబడకుండా ఎల్లప్పుడు పాడుపడిన దానిగానే ఉండాలి, <verse eid="DEU 13:16" /><verse number="17" style="v" sid="DEU 13:17" />నాశనానికి చెందిన వాటిలో ఏది మీ దగ్గర ఉండకూడదు. అప్పుడు యెహోవా తన తీవ్రమైన కోపాన్ని విడిచిపెట్టి, మిమ్మల్ని కనికరించి, మీమీద దయ చూపుతారు. మీ పూర్వికులకు ఇచ్చిన వాగ్దానం మేరకు మిమ్మల్ని అసంఖ్యాకంగా విస్తరింపజేస్తారు, <verse eid="DEU 13:17" /><verse number="18" style="v" sid="DEU 13:18" />ఎందుకంటే నేను ఈ రోజు మీకు ఇస్తున్న ఆయన ఆజ్ఞలన్నిటిని పాటించడం ద్వారా, మీ దేవుడైన యెహోవాకు మీరు విధేయత చూపించి ఆయన దృష్టిలో సరియైన వాటిని మీరు చేస్తున్నారు.<verse eid="DEU 13:18" /></para>
  <chapter eid="DEU 13" />
  <chapter number="14" style="c" sid="DEU 14" />
  <para style="s1">పవిత్రమైన అపవిత్రమైన ఆహారం</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 14:1" />మీరు మీ దేవుడైన యెహోవాకు పిల్లలు. చనిపోయినవారి కోసం మిమ్మల్ని మీరు కోసుకోకూడదు, మీ కనుబొమ్మల మధ్య క్షవరం చేసుకోకూడదు, <verse eid="DEU 14:1" /><verse number="2" style="v" sid="DEU 14:2" />ఎందుకంటే మీ దేవుడైన యెహోవాకు మీరు పవిత్ర ప్రజలు. భూమి మీద ఉన్న ప్రజలందరిలో యెహోవా మిమ్మల్ని తన విలువైన స్వాస్థ్యంగా ఏర్పరచుకున్నారు.<verse eid="DEU 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 14:3" />అసహ్యమైనదేది తినకూడదు. <verse eid="DEU 14:3" /><verse number="4" style="v" sid="DEU 14:4" />మీరు తినదగిన జంతువులు: ఎద్దు, గొర్రె, మేక, <verse eid="DEU 14:4" /><verse number="5" style="v" sid="DEU 14:5" />జింక, దుప్పి, ఎర్రచిన్న జింక, అడవి మేకలు, అడవి గొర్రెలు, లేడి దుప్పులు, కొండ గొర్రెలు, <verse eid="DEU 14:5" /><verse number="6" style="v" sid="DEU 14:6" />చీలిన డెక్కలు ఉండి నెమరువేసే ఏ జంతువునైనా మీరు తినవచ్చు. <verse eid="DEU 14:6" /><verse number="7" style="v" sid="DEU 14:7" />అయితే, నెమరువేసే జంతువు లేదా చీలిన డెక్కలు కలిగి ఉన్న ఒంటెలు, కుందేలు, పొట్టి కుందేలు లాంటివి మీరు తినకూడదు. అవి నెమరువేసేవైనా వాటికి చీలిన డెక్కలు లేవు; అవి మీకు ఆచారరీత్య అపవిత్రమైనవి. <verse eid="DEU 14:7" /><verse number="8" style="v" sid="DEU 14:8" />పంది కూడా అపవిత్రమైనది; దానికి చీలిన డెక్కలు ఉంటాయి కాని అది నెమరువేయదు. వాటి మాంసం తినవద్దు వాటి కళేబరాలు ముట్టుకోవద్దు.<verse eid="DEU 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 14:9" />నీటిలో నివసించే జీవులన్నిటిలో రెక్కలు పొలుసులు గలవాటిని మీరు తినవచ్చు. <verse eid="DEU 14:9" /><verse number="10" style="v" sid="DEU 14:10" />రెక్కలు పొలుసులు లేనివాటిని మీరు తినకూడదు; అవి మీకు అపవిత్రమైనవి.<verse eid="DEU 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 14:11" />పవిత్రమైన ప్రతి పక్షిని మీరు తినవచ్చు. <verse eid="DEU 14:11" /><verse number="12" style="v" sid="DEU 14:12" />కాని మీరు తినకూడనివి ఇవే: గ్రద్ద, రాబందు, నల్ల రాబందు, <verse eid="DEU 14:12" /><verse number="13" style="v" sid="DEU 14:13" />ఎర్ర గ్రద్ద, నల్ల గ్రద్ద, ప్రతి రకమైన తెల్ల గ్రద్ద, <verse eid="DEU 14:13" /><verse number="14" style="v" sid="DEU 14:14" />ప్రతి రకమైన కాకి, <verse eid="DEU 14:14" /><verse number="15" style="v" sid="DEU 14:15" />కొమ్ముల గుడ్లగూబ, జీరగపిట్ట, కోకిల, ప్రతి రకమైన డేగ, <verse eid="DEU 14:15" /><verse number="16" style="v" sid="DEU 14:16" />పైడికంటే, గుడ్లగూబ, హంస, <verse eid="DEU 14:16" /><verse number="17" style="v" sid="DEU 14:17" />గూడబాతు, నల్లబోరువ, చెరువు కాకి, <verse eid="DEU 14:17" /><verse number="18" style="v" sid="DEU 14:18" />సంకు బుడ్డి కొంగ, ప్రతి రకమైన కొంగ, కూకుడు గువ్వ, గబ్బిలము.<verse eid="DEU 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 14:19" />ఎగిరే పురుగులన్నీ మీకు అపవిత్రమైనవి; మీరు వాటిని తినకూడదు. <verse eid="DEU 14:19" /><verse number="20" style="v" sid="DEU 14:20" />ఆచారరీత్య పవిత్రమైన రెక్కలు గల ప్రతి ప్రాణిని మీరు తినవచ్చు.<verse eid="DEU 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 14:21" />మీరు ముందే కనుగొన్న చచ్చినదానిని తినకూడదు. మీ పట్టణాల్లో నివసించే విదేశీయులకు మీరు దానిని ఇవ్వవచ్చు, వారు దానిని తినవచ్చు లేదా ఇతర విదేశీయులకు దానిని అమ్మవచ్చు. అయితే మీరు మీ దేవుడైన యెహోవాకు పవిత్ర ప్రజలు.</para>
  <para style="p" vid="DEU 14:21">మేకపిల్లను దాని తల్లిపాలతో వండకూడదు.<verse eid="DEU 14:21" /></para>
  <para style="s1">దశమభాగాలు</para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 14:22" />ప్రతి సంవత్సరం మీ పొలాల్లో పండే పంటల్లో పదవ వంతును ఖచ్చితంగా ప్రత్యేకంగా ఉంచాలి. <verse eid="DEU 14:22" /><verse number="23" style="v" sid="DEU 14:23" />మీ దేవుడైన యెహోవాకు మీరు ఎల్లప్పుడు భయపడడం నేర్చుకునేలా మీ దేవుడైన యెహోవా తన నామానికి నివాస స్థలంగా ఏర్పరచుకొనే స్థలంలో మీ ధాన్యంలో, క్రొత్త ద్రాక్షరసంలో, ఒలీవ నూనెలో దశమభాగాన్ని, పశువుల్లో, మందలలో మొదటి పిల్లల్లో పదవ దానిని యెహోవా సన్నిధిలో తినాలి. <verse eid="DEU 14:23" /><verse number="24" style="v" sid="DEU 14:24" />ఒకవేళ ఆ స్థలం అంటే యెహోవా తన నామానికి నివాస స్థలంగా ఏర్పరచుకొనే స్థలం మీకు చాలా దూరంగా ఉంటే, మీ దేవుడైన యెహోవా మిమ్మల్ని ఆశీర్వదించినందున మీ దశమభాగాన్ని అక్కడికి మోసుకొని వెళ్లలేనప్పుడు, <verse eid="DEU 14:24" /><verse number="25" style="v" sid="DEU 14:25" />మీ దశమభాగాన్ని వెండికి మార్చి, దానిని మీ దేవుడైన యెహోవా ఏర్పరచుకొనే స్థలానికి తీసుకురావాలి. <verse eid="DEU 14:25" /><verse number="26" style="v" sid="DEU 14:26" />ఆ వెండితో మీకు నచ్చిన వాటిని కొనండి: పశువులు, గొర్రెలు, ద్రాక్షరసం లేదా మద్యం లేదా మీకు నచ్చింది ఏదైన. తర్వాత మీరు మీ కుటుంబీకులు అక్కడే మీ దేవుడైన యెహోవా సన్నిధిలో వాటిని తిని సంతోషించాలి. <verse eid="DEU 14:26" /><verse number="27" style="v" sid="DEU 14:27" />మీ పట్టణాల్లో నివసించే లేవీయులను నిర్లక్ష్యం చేయకూడదు, ఎందుకంటే వారికి మీతో పాటు భాగం గాని వారసత్వం గాని లేదు.<verse eid="DEU 14:27" /></para>
  <para style="p">
    <verse number="28-29" style="v" sid="DEU 14:28-29" />మీ దేవుడైన యెహోవా మీ చేతిపనిని ఆశీర్వదించేలా, ప్రతి మూడు సంవత్సరాలకు ఒకసారి, ఆ సంవత్సరం పండిన పంటలో దశమభాగాన్ని తెచ్చి మీ పట్టణాల్లో నిలువచేయాలి, తద్వార మీతో పాటు భాగం గాని వారసత్వం గాని లేని లేవీయులు, మీ పట్టణాల్లో నివసించే విదేశీయులు, తండ్రిలేనివారు, విధవరాండ్రు వచ్చి భోజనం చేసి తృప్తిపొందుతారు.<verse eid="DEU 14:28-29" /></para>
  <chapter eid="DEU 14" />
  <chapter number="15" style="c" sid="DEU 15" />
  <para style="s1">అప్పులను మాఫీ చేసే సంవత్సరం</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 15:1" />ప్రతి ఏడు సంవత్సరాల చివర మీరు అప్పులు రద్దు చేయాలి. <verse eid="DEU 15:1" /><verse number="2" style="v" sid="DEU 15:2" />రద్దు చేయవలసిన విధానం ఇది: తన తోటి ఇశ్రాయేలీయునికి అప్పు ఇచ్చిన ప్రతి అప్పులవాడు దానిని రద్దు చేయాలి. ఆ సంవత్సరం అప్పు తీర్చమని అడగకూడదు, ఎందుకంటే అది అప్పులు రద్దు చేయడానికి యెహోవా సమయంగా ప్రకటించబడింది. <verse eid="DEU 15:2" /><verse number="3" style="v" sid="DEU 15:3" />మీరు విదేశీయులను అప్పు చెల్లించమని అడగవచ్చు కాని మీ తోటి ఇశ్రాయేలీయుని ప్రతి అప్పు రద్దు చేయాలి. <verse eid="DEU 15:3" /><verse number="4" style="v" sid="DEU 15:4" />అయితే, మీ మధ్యలో పేదవారు ఎవరు ఉండకూడదు, ఎందుకంటే మీ స్వాస్థ్యంగా మీరు స్వాధీనం చేసుకోవడానికి మీ దేవుడైన యెహోవా మీకు ఇస్తున్న దేశంలో ఆయన మిమ్మల్ని అధికంగా దీవిస్తారు. <verse eid="DEU 15:4" /><verse number="5" style="v" sid="DEU 15:5" />కాబట్టి ఈ రోజు నేను మీకు ఆజ్ఞాపిస్తున్న ఈ ఆజ్ఞలన్నిటిని జాగ్రత్తగా పాటించి మీ దేవుడైన యెహోవాకు మీరు పూర్తిగా లోబడి జీవించాలి. <verse eid="DEU 15:5" /><verse number="6" style="v" sid="DEU 15:6" />మీ దేవుడైన యెహోవా మీకు వాగ్దానం చేసిన ప్రకారం ఆయన మిమ్మల్ని దీవిస్తారు. మీరు అనేకమంది ప్రజలకు అప్పు ఇస్తారు కాని అప్పు చేయరు. మీరు అనేక దేశాలను పరిపాలిస్తారు అయితే మిమ్మల్ని ఎవరు పరిపాలించరు.<verse eid="DEU 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 15:7" />మీ దేవుడైన యెహోవా మీకు ఇస్తున్న దేశపు పట్టణాల్లో ఎక్కడైనా మీ తోటి ఇశ్రాయేలీయులలో ఎవరైనా పేదవారు ఉంటే, వారి పట్ల మీ హృదయాలను కఠినంగా లేదా పిసినారిగా ఉంచకూడదు. <verse eid="DEU 15:7" /><verse number="8" style="v" sid="DEU 15:8" />కాని వారికి అవసరమైనంత దానిని వారికి గుప్పిలి విప్పి ధారాళంగా అప్పు ఇవ్వాలి. <verse eid="DEU 15:8" /><verse number="9" style="v" sid="DEU 15:9" />ఈ దుష్ట ఆలోచన మీ హృదయాల్లో పుట్టకుండా జాగ్రత్తపడండి: “ఏడవ సంవత్సరం, అప్పులు రద్దు చేసే సంవత్సరం సమీపించింది” తద్వార మీ తోటి ఇశ్రాయేలీయుల మధ్య ఉన్న పేదవారి పట్ల దయ చూపించకుండ మీరు వారికి ఏమి ఇవ్వకుండ ఉండకూడదు. మీరు అలా చేస్తే, వారు మీకు వ్యతిరేకంగా యెహోవాకు మొరపెడతారు; అప్పుడు మీరు పాపం చేసినవారిగా పరిగణించబడతారు. <verse eid="DEU 15:9" /><verse number="10" style="v" sid="DEU 15:10" />వారికి ధారాళంగా ఇవ్వండి, సణిగే హృదయం లేకుండా వారికి ఇవ్వండి; అప్పుడు మీ దేవుడైన యెహోవా మీ పనులన్నిటిలో మీరు చేసే ప్రతీ దానిలో మిమ్మల్ని దీవిస్తారు. <verse eid="DEU 15:10" /><verse number="11" style="v" sid="DEU 15:11" />దేశంలో ఎల్లప్పుడు పేదవారు ఉంటారు. కాబట్టి మీ దేశంలో తోటి ఇశ్రాయేలీయులలో పేదవారికి, అవసరంలో ఉన్నవారికి ధారాళంగా మీ గుప్పిలి విప్పాలని నేను మిమ్మల్ని ఆజ్ఞాపిస్తున్నాను.<verse eid="DEU 15:11" /></para>
  <para style="s1">దాసులను విడుదల చేయుట</para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 15:12" />మీ ప్రజల్లో హెబ్రీ పురుషులే గాని స్త్రీలే గాని మీకు అమ్ముకుని ఆరు సంవత్సరాలు మీకు సేవ చేస్తే, ఏడవ సంవత్సరంలో మీరు వారిని స్వేచ్ఛగా వెళ్లనివ్వాలి. <verse eid="DEU 15:12" /><verse number="13" style="v" sid="DEU 15:13" />మీరు వారిని విడుదల చేసినప్పుడు, వారిని వట్టి చేతులతో పంపకూడదు. <verse eid="DEU 15:13" /><verse number="14" style="v" sid="DEU 15:14" />మీ మందలో నుండి మీ నూర్పిడి కళ్ళం నుండి, మీ ద్రాక్ష గానుగ తొట్టి నుండి వారికి ధారాళంగా ఇచ్చి పంపాలి. మీ దేవుడైన యెహోవా మిమ్మల్ని ఆశీర్వదించిన దానికి తగినట్టుగా వారికి ఇవ్వాలి. <verse eid="DEU 15:14" /><verse number="15" style="v" sid="DEU 15:15" />మీరు ఈజిప్టులో దాసులై ఉన్నారని, మీ దేవుడైన యెహోవా మిమ్మల్ని విమోచించారని జ్ఞాపకం ఉంచుకోండి. అందుకే నేను ఈ రోజు మీకు ఈ ఆజ్ఞను ఇస్తున్నాను.<verse eid="DEU 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 15:16" />కాని ఒకవేళ దాసుడు మీ దగ్గర సంతోషంగా ఉండి, మిమ్మల్ని మీ కుటుంబాన్ని ప్రేమిస్తున్న కారణంగా, “నేను మిమ్మల్ని విడిచి వెళ్లను” అని అంటే, <verse eid="DEU 15:16" /><verse number="17" style="v" sid="DEU 15:17" />మీరు కదురు తీసుకుని, వాని చెవిని తలుపుకు ఆనించి తలుపు లోనికి దిగేలా కదురుతో గుచ్చాలి. అప్పుడు వాడు మీకు జీవితకాల దాసునిగా ఉంటాడు. మీ దాసికి కూడా అలాగే చేయాలి.<verse eid="DEU 15:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 15:18" />మీ దాసులను స్వేచ్ఛగా పోనివ్వడానికి మీరు కష్టం భావించవద్దు, ఎందుకంటే ఆరు సంవత్సరాలు వారు మీకు చేసిన సేవ మామూలు కూలివారు చేసే దానికన్నా రెట్టింపు ఉంటుంది. మీరు అలా చేస్తే మీ దేవుడైన యెహోవా మీరు చేసేవాటన్నిటిలో మిమ్మల్ని దీవిస్తారు.<verse eid="DEU 15:18" /></para>
  <para style="s1">మొదట పుట్టిన జంతువులు</para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 15:19" />పశువుల మందలో మొదట పుట్టిన ప్రతి మగదానిని మీ దేవుడైన యెహోవా కోసం పవిత్రపరచాలి. మీ ఎద్దులలో మొదట పుట్టిన దానితో పని చేయించకూడదు, గొర్రెలలో మొదట పుట్టిన దాని బొచ్చు కత్తిరించకూడదు. <verse eid="DEU 15:19" /><verse number="20" style="v" sid="DEU 15:20" />యెహోవా ఏర్పరచుకున్న స్థలంలో మీ దేవుడైన యెహోవా సన్నిధిలో ప్రతి సంవత్సరం మీరు మీ కుటుంబం వాటిని తినాలి. <verse eid="DEU 15:20" /><verse number="21" style="v" sid="DEU 15:21" />ఆ జంతువుల్లో లోపం అంటే అది కుంటిదైనా గ్రుడ్డిదైనా లేదా వేరే ఏదైన లోపం ఉంటే మీరు దానిని మీ దేవుడైన యెహోవాకు అర్పించకూడదు. <verse eid="DEU 15:21" /><verse number="22" style="v" sid="DEU 15:22" />మీరు దానిని మీ సొంత పట్టణాల్లోనే తినాలి. జింకను దుప్పిని తిన్నట్లు ఆచారరీత్య పవిత్రులు, అపవిత్రులు, ఇద్దరు దానిని తినవచ్చు. <verse eid="DEU 15:22" /><verse number="23" style="v" sid="DEU 15:23" />అయితే మీరు రక్తాన్ని తినకూడదు; దానిని నీళ్లవలె నేలమీద పారవేయాలి.<verse eid="DEU 15:23" /></para>
  <chapter eid="DEU 15" />
  <chapter number="16" style="c" sid="DEU 16" />
  <para style="s1">పస్కా పండుగ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 16:1" />అబీబు నెలను ఆచరించి మీ దేవుడైన యెహోవాకు పస్కా పండుగ జరిగించాలి, ఎందుకంటే అబీబు నెలలో రాత్రివేళ మీ దేవుడైన యెహోవా ఈజిప్టులో నుండి మిమ్మల్ని తీసుకువచ్చారు. <verse eid="DEU 16:1" /><verse number="2" style="v" sid="DEU 16:2" />యెహోవా తన నామానికి నివాస స్థలంగా ఏర్పరచుకొనే స్థలంలో మీ దేవుడైన యెహోవాకు పస్కా పండుగ ఆచరించి పశువుల్లో నుండి గాని మందలో నుండి గాని ఒక జంతువును బలి ఇవ్వాలి. <verse eid="DEU 16:2" /><verse number="3" style="v" sid="DEU 16:3" />పులిసిన దానితో చేసిన రొట్టెలు తినకూడదు, కాని మీరు ఈజిప్టులో నుండి త్వరగా బయలుదేరి వచ్చారు కాబట్టి, ఈజిప్టు దేశం నుండి వచ్చిన ఆ రోజును జీవితకాలమంతా జ్ఞాపకముంచుకోడానికి ఏడు రోజులు మీరు బాధను సూచించే రొట్టె అనగా పులియని రొట్టెలు తినాలి. <verse eid="DEU 16:3" /><verse number="4" style="v" sid="DEU 16:4" />ఆ ఏడు రోజులు మీ దేశంలో ఎక్కడా పులిసిన పదార్థమేదీ కనిపించకూడదు. మీరు మొదటి రోజు సాయంకాలం వధించిన బలి మాంసంలో ఏదీ ఉదయం వరకు మిగలకూడదు.<verse eid="DEU 16:4" /></para>
  <para style="p">
    <verse number="5-6" style="v" sid="DEU 16:5-6" />మీ దేవుడైన యెహోవా తన నామానికి నివాసంగా ఏర్పరచుకొనే స్థలంలో తప్ప ఆయన మీకు ఇచ్చే ఏ పట్టణాల్లో పస్కా పశువును అర్పించకూడదు. ఈజిప్టు నుండి మీరు బయలుదేరిన సందర్భంగా, సూర్యుడు అస్తమించే సమయంలో, సాయంకాలంలో ఆ స్థలంలోనే మీరు పస్కా పశువును బలి ఇవ్వాలి. <verse eid="DEU 16:5-6" /><verse number="7" style="v" sid="DEU 16:7" />మీ దేవుడైన యెహోవా ఎన్నుకునే స్థలంలో దానిని కాల్చి తినాలి. ఉదయం మీ గుడారాలకు తిరిగి వెళ్లాలి. <verse eid="DEU 16:7" /><verse number="8" style="v" sid="DEU 16:8" />ఆరు రోజులు పులియని రొట్టెలు తినాలి, ఏడవ రోజు మీ దేవుడైన యెహోవాకు ఒక సభను నిర్వహించాలి, అప్పుడు మీరు ఏ పని చేయకూడదు.<verse eid="DEU 16:8" /></para>
  <para style="s1">వారాల పండుగ</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 16:9" />పంటపై కొడవలి వేయడం మొదలుపెట్టినప్పటి నుండి ఏడు వారాలు లెక్కించాలి. <verse eid="DEU 16:9" /><verse number="10" style="v" sid="DEU 16:10" />మీ దేవుడైన యెహోవా మిమ్మల్ని ఆశీర్వదించి ఇచ్చిన దానిలో నుండి స్వేచ్ఛార్పణలు ఇవ్వడం ద్వారా మీ దేవుడైన యెహోవాకు వారాల పండుగ<note caller="+" style="f"><char style="fr" closed="false">16:10 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">వార పండుగ </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 34:22">నిర్గమ 34:22</ref></char>; <char style="xt">లేవీ 23:15-22</char>; </char><char style="fqa" closed="false">తదనంతరం పెంతెకొస్తు పండుగగా పిలువబడింది. </char><char style="ft" closed="false"><char style="xt"><ref loc="ACT 2:1">అపొ. కా. 2:1</ref></char> </char><char style="ft" closed="false">ఈనాడు ఇది </char><char style="fqa" closed="false">షావౌట్ లేదా షాబౌట్ </char><char style="ft" closed="false">అని పిలువబడుతుంది</char></note> ఆచరించాలి. <verse eid="DEU 16:10" /><verse number="11" style="v" sid="DEU 16:11" />మీరు, మీ కుమారులు, కుమార్తెలు, మీ దాసదాసీలు, మీ పట్టణాల్లో నివసించే లేవీయులు, మీ మధ్య ఉండే విదేశీయులు, తండ్రిలేనివారు, విధవరాండ్రు, అందరు యెహోవా తన నామానికి నివాస స్థలంగా ఏర్పరచుకొన్న స్థలంలో మీ దేవుడైన యెహోవా సన్నిధిలో ఆనందించాలి. <verse eid="DEU 16:11" /><verse number="12" style="v" sid="DEU 16:12" />మీరు ఈజిప్టులో బానిసలుగా ఉన్న సంగతి జ్ఞాపకం చేసుకుని ఈ శాసనాలను జాగ్రత్తగా పాటించండి.<verse eid="DEU 16:12" /></para>
  <para style="s1">గుడారాల పండుగ</para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 16:13" />మీరు మీ నూర్పిడి కళ్ళం నుండి ధాన్యాన్ని, ద్రాక్ష గానుగ తొట్టె నుండి ద్రాక్షరసాన్ని సమకూర్చుకున్న తర్వాత గుడారాల పండుగ ఏడు రోజులు ఆచరించాలి. <verse eid="DEU 16:13" /><verse number="14" style="v" sid="DEU 16:14" />మీరు, మీ కుమారులు కుమార్తెలు, మీ దాసదాసీలు, మీ పట్టణాల్లో నివసించే లేవీయులు, మీ మధ్య ఉండే విదేశీయులు, తండ్రిలేనివారు, విధవరాండ్రు, అందరు ఈ పండుగలో ఆనందించాలి. <verse eid="DEU 16:14" /><verse number="15" style="v" sid="DEU 16:15" />యెహోవా ఏర్పరచుకొన్న స్థలంలో మీ దేవుడైన యెహోవాకు మీరు ఈ పండుగ ఏడు రోజులు ఆచరించాలి. ఎందుకంటే, మీ దేవుడైన యెహోవా మీ పంట అంతటిలో మీ చేతి పనులన్నిటిలో మిమ్మల్ని ఆశీర్వదిస్తారు, మీ ఆనందం పరిపూర్ణం అవుతుంది.<verse eid="DEU 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 16:16" />సంవత్సరానికి మూడుసార్లు మీ పురుషులందరు మీ దేవుడైన యెహోవా తన నామానికి నివాస స్థలంగా ఏర్పరచుకొనే స్థలంలో కనబడాలి: పులియని రొట్టెల పండుగలో, వారాల పండుగలో, గుడారాల పండుగలో. యెహోవా సన్నిధిలో ఎవరూ వట్టి చేతులతో కనిపించకూడదు. <verse eid="DEU 16:16" /><verse number="17" style="v" sid="DEU 16:17" />మీ దేవుడైన యెహోవా మిమ్మల్ని ఆశీర్వదించిన ప్రకారం మీలో ప్రతి ఒకరు తమ శక్తి కొద్ది కానుకలు తీసుకురావాలి.<verse eid="DEU 16:17" /></para>
  <para style="s1">న్యాయాధిపతులు</para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 16:18" />మీ దేవుడైన యెహోవా మీకు ఇస్తున్న ప్రతి పట్టణంలో మీ గోత్రాలకు న్యాయాధిపతులను, అధికారులను మీరు నియమించాలి, వారు న్యాయంగా ప్రజలకు తీర్పు తీర్చాలి. <verse eid="DEU 16:18" /><verse number="19" style="v" sid="DEU 16:19" />న్యాయం తప్పి తీర్పు చెప్పకూడదు లేదా పక్షపాతం చూపించకూడదు. లంచం తీసుకోకూడదు, ఎందుకంటే లంచం జ్ఞానుల కళ్లకు గ్రుడ్డితనాన్ని కలిగిస్తుంది, నిర్దోషుల మాటలను వక్రీకరిస్తుంది. <verse eid="DEU 16:19" /><verse number="20" style="v" sid="DEU 16:20" />మీ దేవుడైన యెహోవా మీకు ఇస్తున్న దేశాన్ని స్వాధీనం చేసుకుని దానిలో మీరు జీవించేలా న్యాయాన్ని కేవలం న్యాయాన్ని అనుసరించి నడుచుకోవాలి.<verse eid="DEU 16:20" /></para>
  <para style="s1">ఇతర దేవుళ్ళను ఆరాధించుట</para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 16:21" />మీ దేవుడైన యెహోవాకు మీరు నిర్మించే బలిపీఠం ప్రక్కన ఏ అషేరా స్తంభాన్ని ఏర్పాటు చేయకూడదు, <verse eid="DEU 16:21" /><verse number="22" style="v" sid="DEU 16:22" />పవిత్ర రాతిని నిలబెట్టకూడదు, ఎందుకంటే మీ దేవుడైన యెహోవాకు ఇవి అసహ్యము.<verse eid="DEU 16:22" /></para>
  <chapter eid="DEU 16" />
  <chapter number="17" style="c" sid="DEU 17" />
  <para style="p">
    <verse number="1" style="v" sid="DEU 17:1" />మీ దేవుడైన యెహోవాకు మచ్చ గాని లోపంగాని ఉన్న ఎద్దునైనా గొర్రెనైనా బలిగా అర్పించకూడదు, అది మీ దేవుడైన యెహోవాకు అసహ్యము.<verse eid="DEU 17:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="DEU 17:2" />ఒకవేళ మీ దేవుడైన యెహోవా మీకు ఇచ్చే పట్టణాల్లో దేనిలోనైనా మీ మధ్య నివసిస్తున్న పురుషుడు గాని స్త్రీ గాని మీ దేవుడైన యెహోవా నిబంధన మీరి ఆయన దృష్టిలో చెడును చేస్తూ, <verse eid="DEU 17:2" /><verse number="3" style="v" sid="DEU 17:3" />నా ఆజ్ఞకు వ్యతిరేకంగా ఇతర దేవుళ్ళను సేవించి, వాటికి గాని ఆకాశంలో ఉండే సూర్యచంద్ర నక్షత్రాలకు గాని నమస్కరిస్తూ ఉంటే, <verse eid="DEU 17:3" /><verse number="4" style="v" sid="DEU 17:4" />ఆ విషయం మీ దృష్టికి తీసుకురాబడితే, మీరు దానిని క్షుణ్ణంగా పరిశోధించాలి. ఒకవేళ అది నిజమై, ఆ అసహ్యకరమైన విషయం ఇశ్రాయేలులో జరిగిందని నిరూపించబడితే, <verse eid="DEU 17:4" /><verse number="5" style="v" sid="DEU 17:5" />ఆ దుర్మార్గం చేసిన పురుషుని గాని స్త్రీని గాని మీ పట్టణ ద్వారం దగ్గరకు తీసుకెళ్లి వారిని రాళ్లతో కొట్టి చంపాలి. <verse eid="DEU 17:5" /><verse number="6" style="v" sid="DEU 17:6" />ఇద్దరు లేదా ముగ్గురు సాక్షుల వాంగ్మూలం మీదనే ఒక వ్యక్తికి మరణశిక్ష విధించాలి, కానీ ఒక్క సాక్షి వాంగ్మూలంపై ఎవరికి మరణశిక్ష విధించకూడదు. <verse eid="DEU 17:6" /><verse number="7" style="v" sid="DEU 17:7" />ఆ వ్యక్తికి మరణశిక్ష విధించడంలో మొదట సాక్షుల చేతులు, తర్వాత ప్రజలందరి చేతులు ఉండాలి. మీరు మీ మధ్య నుండి దుర్మార్గాన్ని తొలగించాలి.<verse eid="DEU 17:7" /></para>
  <para style="s1">న్యాయస్థానాలు</para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 17:8" />మీ దగ్గరకు వచ్చిన వివాదాలలో మీరు తీర్పు తీర్చడానికి చాలా కష్టంగా ఉన్న వివాదాలను అంటే రక్తపాతానికి సంబంధించినవి గాని వాదనలు గాని దాడులు గాని అలాంటి వాటిని మీ దేవుడైన యెహోవా ఏర్పరచుకునే స్థలానికి తీసుకెళ్లండి. <verse eid="DEU 17:8" /><verse number="9" style="v" sid="DEU 17:9" />లేవీయ యాజకుల దగ్గరకు, ఆ సమయంలో విధి నిర్వహణలో ఉన్న న్యాయమూర్తి దగ్గరకు వెళ్లండి. వాటి గురించి విచారించండి, వారు మీకు తీర్పు ఇస్తారు. <verse eid="DEU 17:9" /><verse number="10" style="v" sid="DEU 17:10" />మీ దేవుడైన యెహోవా ఏర్పరచుకునే స్థలంలో వారు మీకు తెలియజేసిన నిర్ణయాల ప్రకారం మీరు నడుచుకోవాలి. మీరు చేయాలని వారు మీకు చెప్పే ప్రతిదీ జాగ్రత్తగా చేయాలి. <verse eid="DEU 17:10" /><verse number="11" style="v" sid="DEU 17:11" />వారు మీకు బోధించిన, ఇచ్చిన నిర్ణయాల ప్రకారం మీరు చేయాలి. వారు మీకు చెప్పిన వాటినుండి కుడికి గాని ఎడమకు గాని తిరుగకూడదు. <verse eid="DEU 17:11" /><verse number="12" style="v" sid="DEU 17:12" />న్యాయమూర్తి పట్ల గాని మీ దేవుడైన యెహోవాకు సేవచేసే యాజకుని పట్ల గాని ఎవరైనా ధిక్కారం ప్రదర్శిస్తే, వారికి మరణశిక్ష విధించబడాలి. మీరు ఈ దుర్మార్గాన్ని ఇశ్రాయేలు నుండి తొలగించాలి. <verse eid="DEU 17:12" /><verse number="13" style="v" sid="DEU 17:13" />ప్రజలందరూ వింటారు, భయపడతారు, మళ్ళీ ధిక్కారంగా ఉండరు.<verse eid="DEU 17:13" /></para>
  <para style="s1">రాజు</para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 17:14" />మీ దేవుడైన యెహోవా మీకు ఇస్తున్న దేశంలో మీరు ప్రవేశించి దానిని స్వాధీనం చేసుకుని స్థిరపడినప్పుడు మీరు, “మన చుట్టూ ఉన్న దేశాలవలె మనమీద కూడా రాజును నియమించుకుందాము” అని అంటే, <verse eid="DEU 17:14" /><verse number="15" style="v" sid="DEU 17:15" />మీ దేవుడైన యెహోవా ఏర్పరచే వ్యక్తినే మీరు రాజుగా నియమించుకోవాలి. అతడు మీ మధ్యలో నుండి వచ్చిన తోటి ఇశ్రాయేలీయుడై ఉండాలి. ఇశ్రాయేలీయుడు కాని పరదేశిని మీమీద నియమించకూడదు. <verse eid="DEU 17:15" /><verse number="16" style="v" sid="DEU 17:16" />అంతేకాక, రాజు గుర్రాలను అధిక సంఖ్యలో సంపాదించవద్దు, వాటిని ఇంకా ఎక్కువ సంపాదించుకునేందుకు ప్రజలను ఈజిప్టుకు తిరిగి వెళ్లనివ్వకూడదు. ఎందుకంటే, “మీరు మరలా ఆ త్రోవలో వెళ్లకూడదు” అని యెహోవా మీకు చెప్పారు. <verse eid="DEU 17:16" /><verse number="17" style="v" sid="DEU 17:17" />అతడు చాలామంది భార్యలను చేసుకోకూడదు, లేదా అతని హృదయం దారి తప్పుతుంది. అతడు పెద్ద మొత్తంలో వెండి, బంగారాన్ని కూడబెట్టుకోకూడదు.<verse eid="DEU 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 17:18" />అతడు తన రాజ్యసింహాసనం మీద ఆసీనుడైనప్పుడు, లేవీయ యాజకుల దగ్గర ఉన్న ధర్మశాస్త్రాన్ని చూసి తన కోసం ఒక ప్రతిని వ్రాసుకోవాలి. <verse eid="DEU 17:18" /><verse number="19" style="v" sid="DEU 17:19" />అది అతని దగ్గర ఉండాలి, అతడు దానిని తన జీవితకాలంతా చదువుతూ ఉండాలి తద్వార అతడు తన దేవుడైన యెహోవాకు భయపడడం నేర్చుకొని, ఈ ధర్మశాస్త్రంలోని మాటలన్నిటిని, శాసనాలను జాగ్రత్తగా అనుసరిస్తాడు, <verse eid="DEU 17:19" /><verse number="20" style="v" sid="DEU 17:20" />తన తోటి ఇశ్రాయేలీయునికన్నా తాను గొప్పవాడినని భావించడు, ధర్మశాస్త్రం నుండి కుడికి గాని ఎడమకు గాని తొలగిపోడు. అప్పుడు అతడు, అతని సంతానం ఇశ్రాయేలు రాజ్యాన్ని ఎక్కువకాలం పరిపాలిస్తారు.<verse eid="DEU 17:20" /></para>
  <chapter eid="DEU 17" />
  <chapter number="18" style="c" sid="DEU 18" />
  <para style="s1">యాజకులకు లేవీయులకు కానుకలు</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 18:1" />లేవీయులైన యాజకులకు అంటే, లేవీ గోత్రమంతటికి ఇశ్రాయేలీయులతో పాటు వాటా గాని వారసత్వం గాని ఉండదు. యెహోవాకు సమర్పించబడిన హోమబలుల పైనే వారు బ్రతకాలి, ఎందుకంటే అది వారి వారసత్వము. <verse eid="DEU 18:1" /><verse number="2" style="v" sid="DEU 18:2" />వారి తోటి ఇశ్రాయేలీయులతో వారికి వారసత్వం ఉండదు; యెహోవా వాగ్దానం చేసినట్టుగా యెహోవాయే వారి వారసత్వము.<verse eid="DEU 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 18:3" />ప్రజలు అర్పణలుగా తీసుకువచ్చే పశువులు, గొర్రెలు మేకల నుండి యాజకులకు చెందవలసిన వాటా: భుజం, లోపలి అవయవాలు, చెంపలు. <verse eid="DEU 18:3" /><verse number="4" style="v" sid="DEU 18:4" />మీ ధాన్యం, క్రొత్త ద్రాక్షరసం, ఒలీవ నూనెలలో ప్రథమ ఫలాలు, అలాగే గొర్రెబొచ్చు కత్తిరించినప్పుడు మొదటి నూలు వారికే ఇవ్వాలి. <verse eid="DEU 18:4" /><verse number="5" style="v" sid="DEU 18:5" />యెహోవా పేర నిలిచి ఎల్లప్పుడు సేవ చేయటానికి అతని గోత్రాలన్నిటిలో అతన్ని అతని సంతానాన్ని మీ దేవుడైన యెహోవా ఎన్నుకున్నాడు.<verse eid="DEU 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 18:6" />ఒక లేవీయుడు అతడు నివసించే ఇశ్రాయేలులో ఎక్కడైనా మీ పట్టణాల్లో ఒకదాని నుండి వెళ్తే, యెహోవా ఎంచుకునే ప్రదేశానికి పూర్తి శ్రద్ధతో వస్తే, <verse eid="DEU 18:6" /><verse number="7" style="v" sid="DEU 18:7" />అతడు తన దేవుడైన యెహోవా పేరిట అక్కడ సేవచేసే తన తోటి లేవీయులందరిలా సేవ చేయవచ్చు <verse eid="DEU 18:7" /><verse number="8" style="v" sid="DEU 18:8" />కుటుంబ ఆస్తులు అమ్మిన దానిలో డబ్బు వచ్చినప్పటికీ, వారి ప్రయోజనాలలో అతడు సమానంగా పంచుకోవాలి.<verse eid="DEU 18:8" /></para>
  <para style="s1">జనుల దుష్టత్వాన్ని అనుసరించకూడదు</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 18:9" />మీ దేవుడైన యెహోవా మీకిచ్చే దేశంలో మీరు ప్రవేశించాక అక్కడి దేశాల అసహ్యకరమైన మార్గాలను అనుకరించడం నేర్చుకోకండి. <verse eid="DEU 18:9" /><verse number="10" style="v" sid="DEU 18:10" />తమ కుమారున్ని లేదా కుమార్తెను అగ్నిలో బలి ఇచ్చే వారినైననూ, భవిష్యవాణి లేదా మంత్రవిద్య, శకునాలను చెప్పు వారినైననూ, మంత్రవిద్యలో నిమగ్నమయ్యేవారునూ మీలో ఎవరూ కనబడకూడదు. <verse eid="DEU 18:10" /><verse number="11" style="v" sid="DEU 18:11" />మంత్రాలు జపించేవారు గాని, ఆత్మలతో మాట్లాడేవారు గాని, చనిపోయినవారిని సంప్రదించేవారు గాని మీలో ఉండకూడదు. <verse eid="DEU 18:11" /><verse number="12" style="v" sid="DEU 18:12" />ఇలాంటివి అభ్యసించేవారు యెహోవాకు అసహ్యులు; ఇలాంటి హేయక్రియలు చేస్తారు కాబట్టే యెహోవా మీ ముందు నుండి జనాలను వెళ్లగొడుతున్నారు. <verse eid="DEU 18:12" /><verse number="13" style="v" sid="DEU 18:13" />మీ దేవుడైన యెహోవా దృష్టిలో మీరు నిందారహితులై ఉండాలి.<verse eid="DEU 18:13" /></para>
  <para style="s1">ప్రవక్త</para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 18:14" />మీరు స్వాధీనం చేసుకోబోయే జనులు మంత్రవిద్య లేదా భవిష్యవాణి పాటించేవారి మాట వింటారు. అయితే, మీ దేవుడైన యెహోవా మిమ్మల్ని అలా అనుమతించలేదు. <verse eid="DEU 18:14" /><verse number="15" style="v" sid="DEU 18:15" />మీ దేవుడైన యెహోవా నా లాంటి ఒక ప్రవక్తను మీలో నుండి మీ కోసం లేవనెత్తుతాడు, మీరు అతని మాట వినాలి. <verse eid="DEU 18:15" /><verse number="16" style="v" sid="DEU 18:16" />ఆ సభ రోజున హోరేబు దగ్గర మీ దేవుడనైన యెహోవాను మీరు అడిగింది ఇదే, “మన దేవుడైన యెహోవా స్వరాన్ని వినవద్దు, ఈ గొప్ప అగ్నిని ఇక చూడము, చూస్తే మేము చనిపోతాము.”<verse eid="DEU 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 18:17" />యెహోవా నాతో, “వారన్న మాట సరియైనది. <verse eid="DEU 18:17" /><verse number="18" style="v" sid="DEU 18:18" />వారి తోటి ఇశ్రాయేలీయులలో నుండే నీలాంటి ప్రవక్తను లేపుతాను. ఆయన నోట నా మాటలుంటాయి, నా ఆజ్ఞలన్నీ వారికి చెప్తాను. <verse eid="DEU 18:18" /><verse number="19" style="v" sid="DEU 18:19" />నా పేరట ప్రవక్త చెప్పే మాటలకు ఎవరైనా స్పందించకపోతే వారిని నేనే లెక్క అడుగుతాను. <verse eid="DEU 18:19" /><verse number="20" style="v" sid="DEU 18:20" />కానీ నేను ఆజ్ఞాపించనిదేదైనా నా పేరున మాట్లాడాలని భావించే ప్రవక్త లేదా ఇతర దేవుళ్ళ పేరిట మాట్లాడే ప్రవక్తను చంపాలి” అని అన్నారు.<verse eid="DEU 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 18:21" />“ఒక సందేశం యెహోవా మాట్లాడింది కాదు అని మనం ఎలా తెలుసుకోగలము?” అని మీలో మీరు అనుకుంటారు, <verse eid="DEU 18:21" /><verse number="22" style="v" sid="DEU 18:22" />ఒకవేళ యెహోవా పేరెత్తి ఒక ప్రవక్త ప్రకటించి అది నెరవేరకపోయినా లేదా నిజం కాకపోయినా, అది యెహోవా మాట్లాడింది కాదు. ఆ ప్రవక్త అహంకారంతో మాట్లాడాడు, కాబట్టి భయపడవద్దు.<verse eid="DEU 18:22" /></para>
  <chapter eid="DEU 18" />
  <chapter number="19" style="c" sid="DEU 19" />
  <para style="s1">ఆశ్రయపురాలు</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 19:1" />మీ దేవుడైన యెహోవా మీకు ఇవ్వబోయే దేశంలో ఉన్న జనాన్ని ముందు నాశనం చేసినప్పుడు, ఆ దేశాన్ని మీరు స్వాధీనం చేసుకుని, మీరు వారిని తరిమివేసి వారి పట్టణాల్లో వారి ఇళ్ళలో నివసించాలి. <verse eid="DEU 19:1" /><verse number="2" style="v" sid="DEU 19:2" />మీ దేవుడైన యెహోవా వాగ్దానం చేసి ఇస్తున్న భూమిని మీరు స్వాధీనం చేసుకున్న తర్వాత, అందులో మూడు పట్టణాలను ప్రత్యేకించాలి. <verse eid="DEU 19:2" /><verse number="3" style="v" sid="DEU 19:3" />మీ దేవుడైన యెహోవా మీకిచ్చే దేశాన్ని మూడు ప్రాంతాలుగా విభజించి ఆ పట్టణాలకు త్రోవలు ఏర్పరచాలి, ఒకడు ఎవరినైనా చంపితే అతడు ఆ పట్టణాల్లో ఒక దానికి పారిపోయేలా ఉండాలి.<verse eid="DEU 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 19:4" />మునుపటి శత్రుత్వం ఏదీ లేకపోయినా ఎవరైనా అనుకోకుండ మరొకరిని చంపితే, హంతకుడు ప్రాణాలతో బ్రతకడానికి ఈ ఆశ్రయపురాల్లో దేనికైనా పారిపోవచ్చు. <verse eid="DEU 19:4" /><verse number="5" style="v" sid="DEU 19:5" />ఉదాహరణకు, చెట్లు నరకడానికి పొరుగువాడితో అడవికి వెళ్లి గొడ్డలితో చెట్టు కొట్టినప్పుడు గొడ్డలి పడి ఊడి అవతలి వాడికి తగిలి చనిపోయిన, చంపినవాడు ఆ మూడు పట్టణాల్లో ఒక దానిలోకి పారిపోయి తన ప్రాణం దక్కించుకోవచ్చు. <verse eid="DEU 19:5" /><verse number="6" style="v" sid="DEU 19:6" />ఎక్కువ దూరమైతే, ప్రతీకారం చేయాలని వెంటాడినవాడు అతన్ని పట్టుకుని చంపుతాడేమో! అతడు ద్వేషంతో పొరుగువానిని చంపలేదు కాబట్టి, అతనికి మరణశిక్ష తగదు. <verse eid="DEU 19:6" /><verse number="7" style="v" sid="DEU 19:7" />అందువల్లనే మూడు పట్టణాలను మీరు ఎంచుకోవాలని ఆజ్ఞాపించాను.<verse eid="DEU 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 19:8" />మీ పూర్వికులకు ప్రమాణం చేసినట్లు మీ దేవుడైన యెహోవా మీ సరిహద్దులను విశాలపరచి వారికి వాగ్దానం చేసిన దేశమంతటిని మీకు ఇస్తే, <verse eid="DEU 19:8" /><verse number="9" style="v" sid="DEU 19:9" />నేడు నేను మీకు ఆజ్ఞాపిస్తున్న ఈ చట్టాలన్నిటిని మీరు జాగ్రత్తగా అనుసరించి అనగా మీ దేవుడనైన యెహోవాను ప్రేమిస్తూ, నిత్యం ఆయన పట్ల విధేయత కలిగి మీరు నడుస్తూ, మరో మూడు పట్టణాలు ప్రత్యేకించాల్సి ఉంటుంది. <verse eid="DEU 19:9" /><verse number="10" style="v" sid="DEU 19:10" />మీ దేవుడైన యెహోవా నీకు వారసత్వంగా ఇస్తున్న మీ దేశంలో నిర్దోషి రక్తం చిందించబడకుండ, మీరు రక్తపాతానికి పాల్పడకుండ ఉండడానికి ఇలా చేయండి.<verse eid="DEU 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 19:11" />కాని ఎవరైనా ద్వేషంతో ఎవరి కొరకైనా పొంచి ఉండి, అతని మీద పడి చంపితే అతడా పట్టణాల్లో ఒక దానిలోకి పారిపోయినా ఊరి పెద్దలు అతన్ని బయటకు రప్పించాలి. <verse eid="DEU 19:11" /><verse number="12" style="v" sid="DEU 19:12" />హంతకుని పట్టణ పెద్దలు పిలిపించి, ప్రతీకారం చేయడానికి వచ్చిన వానికి అతన్ని అప్పగించాలి. <verse eid="DEU 19:12" /><verse number="13" style="v" sid="DEU 19:13" />జాలి చూపవద్దు. నిర్దోషి రక్తాన్ని చిందించిన అపరాధాన్ని మీరు ఇశ్రాయేలు నుండి ప్రక్షాళన చేయాలి, తద్వారా మీరు బాగుంటారు.<verse eid="DEU 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 19:14" />మీ దేవుడైన యెహోవా స్వాధీనం చేసుకోమని మీకు ఇవ్వబోతున్న దేశంలో మీరు పొందే వారసత్వంలో మీ పూర్వికులు ఏర్పాటుచేసిన మీ పొరుగువారి సరిహద్దు రాయిని తరలించవద్దు.<verse eid="DEU 19:14" /></para>
  <para style="s1">సాక్ష్యాలు</para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 19:15" />ఒకడు చేసిన పాపం విషయంలో గాని అపరాధం విషయంలో గాని దాన్ని నిర్ధారించడానికి కేవలం ఒక్క వ్యక్తి సాక్ష్యాన్ని పరిగణలోకి తీసుకోకూడదు, ఇద్దరు లేదా ముగ్గురు సాక్ష్యాల మీద నేరం నిర్ధారణ చేయాలి.<verse eid="DEU 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 19:16" />ఒకవేళ కపట బుద్ధి గలవాడు ఎవరిమీదైనా నేరారోపణ చేయడానికే పూనుకుంటే, <verse eid="DEU 19:16" /><verse number="17" style="v" sid="DEU 19:17" />ఆ వివాదంలో ఉన్న ఇద్దరూ యెహోవా ఎదుట అంటే ఆ సమయంలో విధి నిర్వహణలో ఉన్న యాజకుల ఎదుట న్యాయాధిపతుల ఎదుట నిలబడాలి. <verse eid="DEU 19:17" /><verse number="18" style="v" sid="DEU 19:18" />న్యాయాధిపతులు ఆ వాదనను బాగా విచారణ చేయాలి, సాక్షి అబద్ధికుడని రుజువైతే, తోటి ఇశ్రాయేలీయులపై అబద్ధ సాక్ష్యమును పలికిన ఎడల, <verse eid="DEU 19:18" /><verse number="19" style="v" sid="DEU 19:19" />వాడు తలపెట్టిన కీడు వాడి మీదకే రావాలి, ఆ విధంగా న్యాయమైన తీర్పు చెప్పి మీ మధ్య నుండి దుర్మార్గాన్ని తొలగించాలి. <verse eid="DEU 19:19" /><verse number="20" style="v" sid="DEU 19:20" />ప్రజలు ఇది చూసి భయపడి అలాంటి దుర్మార్గపు పనులు మీ దేశంలో మళ్ళీ చేయరు. <verse eid="DEU 19:20" /><verse number="21" style="v" sid="DEU 19:21" />జాలి పడకూడదు: ప్రాణానికి ప్రాణం కంటికి కన్ను, పంటికి పన్ను, చేతికి చేయి, కాలికి కాలు. ఇదే నియమం పాటించి తీరాలి.<verse eid="DEU 19:21" /></para>
  <chapter eid="DEU 19" />
  <chapter number="20" style="c" sid="DEU 20" />
  <para style="s1">యుద్ధానికి వెళ్లేటప్పుడు పాటించవలసిన నియమాలు</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 20:1" />మీ శత్రువులతో యుద్ధానికి వెళ్లినప్పుడు, మీ దగ్గర ఉన్నవాటి కంటే వారి దగ్గర ఎక్కువ గుర్రాలు, రథాలను చూసినప్పుడు, వారికి భయపడవద్దు, ఎందుకంటే ఈజిప్టు నుండి క్షేమంగా రప్పించిన మీ దేవుడైన యెహోవా మీతో ఉంటారు. <verse eid="DEU 20:1" /><verse number="2" style="v" sid="DEU 20:2" />మీరు యుద్ధానికి వెళ్లబోయేటప్పుడు, యాజకుడు ముందుకు వచ్చి సైన్యాన్ని ఉద్దేశించి మాట్లాడుతాడు. <verse eid="DEU 20:2" /><verse number="3" style="v" sid="DEU 20:3" />అతడు వారితో ఇలా అంటారు: “ఇశ్రాయేలు విను: ఈ రోజు మీరు మీ శత్రువుల మీదికి యుద్ధానికి వెళ్తున్నారు. మీరు మూర్ఛపోవద్దు, భయపడవద్దు, జడియవద్దు, వారికి భయపడకండి. <verse eid="DEU 20:3" /><verse number="4" style="v" sid="DEU 20:4" />శత్రువులతో యుద్ధం చేసేది, మిమ్మల్ని రక్షించేది మీ దేవుడైన యెహోవాయే! ఆయన మీతో ఉన్నాడు.”<verse eid="DEU 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 20:5" />అధికారులు సైనికులతో చెప్పవలసిన మాటలు: “మీలో ఎవరైనా క్రొత్తగా ఇల్లు కట్టుకుని ఇంకా గృహప్రవేశం చేయనట్లైతే, వెంటనే ఇంటికి వెళ్లిపోవాలి, లేకపోతే ఒకవేళ అతడు యుద్ధంలో చనిపోతే మరొకరు ఆ ఇంట్లో నివసిస్తారు. <verse eid="DEU 20:5" /><verse number="6" style="v" sid="DEU 20:6" />ఎవడైనా ద్రాక్షతోట వేసి దాని ఫలసాయం అనుభవించకుండా ఉన్నాడా? అలాగైతే అతడు ఇంటికి తిరిగి వెళ్లవచ్చు, లేదా అతడు యుద్ధంలో చనిపోతే అతని తోట ఫలసాయం మరొకరు అనుభవిస్తారు. <verse eid="DEU 20:6" /><verse number="7" style="v" sid="DEU 20:7" />ప్రధానం చేసుకుని ఇంకా పెండ్లి చేసుకోకుండా ఉన్నవాడు మీలో ఉంటే అతడు ఇంటికి వెళ్లిపోవచ్చు, అతడు ఒకవేళ యుద్ధంలో చనిపోతే మరొకడు ఆమెను పెళ్ళి చేసుకోవచ్చు.” <verse eid="DEU 20:7" /><verse number="8" style="v" sid="DEU 20:8" />అధిపతులు చేయవలసిన హెచ్చరికలు, “ఎవనికైనా భయాందోళనలున్నాయా? అలాగైతే ఇంటికి వెళ్లిపోవచ్చు, లేకపోతే ఆ పిరికితనం మిగతా సైనికులకు కూడా వ్యాపిస్తుంది.” <verse eid="DEU 20:8" /><verse number="9" style="v" sid="DEU 20:9" />అధిపతులు ప్రజలకు ఈ సందేశమిచ్చిన తర్వాత సేనాధిపతులు తమ బాధ్యతలను స్వీకరిస్తారు.<verse eid="DEU 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 20:10" />పట్టణాన్ని ముట్టడించినప్పుడు ముందు దాని ప్రజలకు సమాధానం కోసం రాయబారం పంపాలి. <verse eid="DEU 20:10" /><verse number="11" style="v" sid="DEU 20:11" />ఒకవేళ వారు సమాధానపడడానికి ఒప్పుకుని వారి ద్వారాలు తెరిస్తే, అందులో ఉన్న ప్రజలంతా మీకు లొంగిపోయి మీ కోసం వెట్టిచాకిరి చేస్తారు. <verse eid="DEU 20:11" /><verse number="12" style="v" sid="DEU 20:12" />ఒకవేళ వారు సంధికి నిరాకరించి మీతో యుద్ధానికి వస్తే, ఆ పట్టణాన్ని ముట్టడించండి. <verse eid="DEU 20:12" /><verse number="13" style="v" sid="DEU 20:13" />మీ దేవుడైన యెహోవా దానిని మీ చేతికి అప్పగిస్తే, దానిలో ఉన్న మనుష్యులందరిని ఖడ్గంతో హతమార్చాలి. <verse eid="DEU 20:13" /><verse number="14" style="v" sid="DEU 20:14" />స్త్రీలను, చిన్న పిల్లలను పశువులను మీరు కొల్లగొట్టిన ఆస్తిని మీరు తీసుకోవచ్చు; మీ దేవుడైన యెహోవా మీకిచ్చే మీ శత్రువుల దోపుడుసొమ్ము మీదే అవుతుంది. <verse eid="DEU 20:14" /><verse number="15" style="v" sid="DEU 20:15" />మీకు దూరంగా ఉన్న సమీపంలోని దేశాలకు చెందని అన్ని పట్టణాల పట్ల మీరు ఈ విధంగా వ్యవహరిస్తారు.<verse eid="DEU 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 20:16" />యెహోవా దేవుడు మీకు వారసత్వంగా ఇచ్చే పట్టణాల్లో ఊపిరి పీల్చేదేదీ మిగలకూడదు. <verse eid="DEU 20:16" /><verse number="17" style="v" sid="DEU 20:17" />మీ దేవుడైన యెహోవా ఆజ్ఞమేరకు హిత్తీయులను, అమోరీయులను కనానీయులను, పెరిజ్జీయులను, హివ్వీయులను, యెబూసీయులను పూర్తిగా నాశనం చేయాలి. <verse eid="DEU 20:17" /><verse number="18" style="v" sid="DEU 20:18" />లేకపోతే తమ దేవుళ్ళకు చేసే హేయ క్రియలను మీకు నేర్పుతారు, మీరు మీ దేవుడైన యెహోవాకు విరోధంగా పాపాలు చేస్తారు, అందుకే వారిని నిర్మూలించమని చెప్తున్నాను.<verse eid="DEU 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 20:19" />మీరు ఒక పట్టణాన్ని ముట్టడి వేసి, దానిని స్వాధీనపరచుకోడానికి ఎక్కువసేపు దానితో పోరాడవలసి వస్తే, మీరు దాని చెట్లను గొడ్డలితో నరికివేయవద్దు, ఎందుకంటే వాటి ఫలాలు మీరు తినవచ్చు. చెట్లేమైనా మనుష్యులా మీరు వాటిని నరికివేయడానికి? <verse eid="DEU 20:19" /><verse number="20" style="v" sid="DEU 20:20" />ఏదేమైనా, పండ్లచెట్లు కాదని మీకు తెలిసిన చెట్లను మీరు నరికివేయవచ్చు, వాటి కర్రను మీరు ముట్టడి వేసిన పట్టణం పతనం అయ్యేవరకు ముట్టడి పనులను నిర్మించడానికి ఉపయోగించవచ్చు.<verse eid="DEU 20:20" /></para>
  <chapter eid="DEU 20" />
  <chapter number="21" style="c" sid="DEU 21" />
  <para style="s1">పరిష్కరించబడని హత్యకు ప్రాయశ్చిత్తం</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 21:1" />మీరు స్వాధీనం చేసుకోవడానికి మీ దేవుడైన యెహోవా మీకు ఇస్తున్న దేశంలోని ఒక పొలంలో ఎవరైనా హత్యకు గురియై పడి ఉండడం కనబడి, ఆ హంతకుడు ఎవరో తెలియనప్పుడు, <verse eid="DEU 21:1" /><verse number="2" style="v" sid="DEU 21:2" />మీ పెద్దలు, న్యాయాధిపతులు బయటకు వెళ్లి మృతదేహం నుండి దగ్గరలో ఉన్న పట్టణాలకు దూరం కొలుస్తారు. <verse eid="DEU 21:2" /><verse number="3" style="v" sid="DEU 21:3" />తర్వాత మృతుడికి దగ్గరగా ఉన్న పట్టణ పెద్దలు ఎప్పుడూ పని చేయని, కాడి కట్టని ఓ దూడను తెచ్చి, <verse eid="DEU 21:3" /><verse number="4" style="v" sid="DEU 21:4" />దానిని ప్రవహించే ప్రవాహం ఉండి, ఎన్నడు దున్నబడని నాటబడని లోయ దగ్గరకు తోలుకుపోవాలి. అక్కడ ఆ లోయలో పట్టణ పెద్దలు దూడ మెడను విరిచివేయాలి. <verse eid="DEU 21:4" /><verse number="5" style="v" sid="DEU 21:5" />లేవీయ యాజకులు ముందుకు సాగాలి, ఎందుకంటే మీ దేవుడైన యెహోవా వారిని పరిచర్య కోసం, యెహోవా పేరిట ఆశీర్వాదాలు పలకడానికి, వివాదాలు దాడులకు సంబంధించిన అన్ని దావాలను నిర్ణయించడానికి వారిని ఎన్నుకున్నారు. <verse eid="DEU 21:5" /><verse number="6" style="v" sid="DEU 21:6" />మృతుడి గ్రామానికి చెందిన పట్టణ పెద్దలు లోయలో మెడ విరగదీసిన దూడ మీద చేతులు కడుక్కుని, <verse eid="DEU 21:6" /><verse number="7" style="v" sid="DEU 21:7" />వారు ఇలా ప్రకటించాలి: “మా చేతులు రక్తపాతం చేయలేదు, మా కళ్లు అది చేయడం చూడలేదు. <verse eid="DEU 21:7" /><verse number="8" style="v" sid="DEU 21:8" />యెహోవా, మీరు విమోచించిన మీ ప్రజలైన ఇశ్రాయేలు కోసం ఈ ప్రాయశ్చిత్తాన్ని అంగీకరించండి, నిర్దోషి యొక్క రక్తాన్ని బట్టి మీ ప్రజలను దోషులుగా పరిగణించవద్దు” అప్పుడు రక్తపాతం ప్రాయశ్చిత్తం చేయబడుతుంది, <verse eid="DEU 21:8" /><verse number="9" style="v" sid="DEU 21:9" />యెహోవా దృష్టిలో మీరు సరియైనది చేశారు కాబట్టి, నిర్దోషి రక్తం చిందించిన అపరాధం మీ నుండి తొలగిపోతుంది.<verse eid="DEU 21:9" /></para>
  <para style="s1">చెరపట్టబడిన స్త్రీని పెళ్ళి చేసికొనుట</para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 21:10" />మీరు మీ శత్రువుల మీద యుద్ధానికి వెళ్లినప్పుడు మీ దేవుడైన యెహోవాకు వారిని మీ చేతులకు అప్పగించి, మీరు బందీలను తెచ్చినప్పుడు, <verse eid="DEU 21:10" /><verse number="11" style="v" sid="DEU 21:11" />ఒకవేళ నీవు బందీలలో ఒక అందమైన స్త్రీని గమనించి, ఆమె పట్ల ఆకర్షితుడవైతే, నీవు ఆమెను మీ భార్యగా తీసుకోవచ్చు. <verse eid="DEU 21:11" /><verse number="12" style="v" sid="DEU 21:12" />ఆమెను మీ ఇంటికి తీసుకురండి ఆమె తలను గుండు చేసుకోవాలి, గోర్లు కత్తిరించుకోవాలి, <verse eid="DEU 21:12" /><verse number="13" style="v" sid="DEU 21:13" />చెరపట్టబడినప్పుడు ఆమె వేసుకుని ఉన్న వస్త్రాలు తీసివేయాలి. నెలరోజులు ఆమె మీ ఇంట్లోనే ఉండి, తన తల్లిదండ్రుల కోసం విలపించిన తర్వాత, నీవు ఆమె దగ్గరకు వెళ్లవచ్చు, నీవు ఆమెకు భర్తగా ఆమె నీకు భార్యగా ఉండవచ్చు. <verse eid="DEU 21:13" /><verse number="14" style="v" sid="DEU 21:14" />వద్దనుకుంటే, ఆమె కిష్ఠమైన చోటికి ఆమెను పంపివేయాలి. నీవు ఆమెను అగౌరపరచినట్టే కాబట్టి ఆమెను డబ్బుకు అమ్మకూడదు బానిసగా చూడకూడదు.<verse eid="DEU 21:14" /></para>
  <para style="s1">జ్యేష్ఠ సంతానం యొక్క హక్కు</para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 21:15" />ఒక వ్యక్తికి ఇద్దరు భార్యలు ఉంటే, అతడు ఒకరిని ప్రేమిస్తాడు, మరొకరిని ప్రేమించడు, ఇద్దరూ అతనికి కుమారులను కంటారు కాని జ్యేష్ఠ కుమారుడు అతడు ప్రేమించని భార్య కుమారుడు, <verse eid="DEU 21:15" /><verse number="16" style="v" sid="DEU 21:16" />అతడు తన కుమారులకు తన ఆస్తిని పంచినప్పుడు, నిజానికి జ్యేష్ఠ కుమారుడైన తాను ప్రేమించని భార్య కుమారుని స్థానంలో అతడు ప్రేమించే భార్య కుమారునికి జ్యేష్ఠత్వపు హక్కును ఇవ్వకూడదు. <verse eid="DEU 21:16" /><verse number="17" style="v" sid="DEU 21:17" />అతడు తనకున్న అన్నిటిలో రెట్టింపు వాటా ఇవ్వడం ద్వారా తాను ప్రేమించని భార్య కుమారుడిని జ్యేష్ఠ కుమారునిగా గుర్తించాలి. ఆ కుమారుడు తన తండ్రి శక్తికి మొదటి సంకేతము. జ్యేష్ఠత్వపు హక్కు అతనికి చెందినది.<verse eid="DEU 21:17" /></para>
  <para style="s1">తిరుగుబాటు చేసిన కుమారుడు</para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 21:18" />ఒకవేళ ఎవరికైనా తండ్రికి తల్లికి లోబడని, వారు వాన్ని క్రమశిక్షణ చేసినప్పుడు వారికి వినని, మొండితనం గల తిరుగుబాటు చేసే కుమారుడు ఉంటే, <verse eid="DEU 21:18" /><verse number="19" style="v" sid="DEU 21:19" />అతని తండ్రి, తల్లి అతన్ని పట్టుకుని పట్టణ ద్వారం దగ్గర ఉన్న పెద్దల దగ్గరకు తీసుకురావాలి. <verse eid="DEU 21:19" /><verse number="20" style="v" sid="DEU 21:20" />వారు పెద్దలతో, “ఈ మా కుమారుడు మొండివాడు, తిరుగుబాటు చేసేవాడు. వీడు మాకు లోబడడు. వీడు తిండిబోతు, త్రాగుబోతు” అని చెప్పాలి. <verse eid="DEU 21:20" /><verse number="21" style="v" sid="DEU 21:21" />అప్పుడు అతని పట్టణంలోని పురుషులందరు వాన్ని రాళ్లతో కొట్టి చంపాలి. మీరు మీ మధ్య నుండి చెడును ప్రక్షాళన చేయాలి. ఇశ్రాయేలీయులందరు దాని గురించి విని భయపడతారు.<verse eid="DEU 21:21" /></para>
  <para style="s1">వివిధ చట్టాలు</para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 21:22" />ఒకవేళ ఎవరైనా మరణశిక్షకు తగిన పాపం చేసి చంపబడి వారి దేహం చెట్టుకు వ్రేలాడదీయబడి ఉంటే, <verse eid="DEU 21:22" /><verse number="23" style="v" sid="DEU 21:23" />దేహం రాత్రిపూట చెట్టుకు వ్రేలాడుతూ ఉండకూడదు. అదే రోజు దానిని పాతిపెట్టేలా చూడాలి, ఎందుకంటే మ్రానుపై వ్రేలాడదీయబడిన ఎవరైనా దేవుని శాపానికి గురవుతారు. మీ దేవుడైన యెహోవా మీకు స్వాస్థ్యంగా ఇస్తున్న దేశాన్ని మీరు అపవిత్రం చేయకూడదు!<verse eid="DEU 21:23" /></para>
  <chapter eid="DEU 21" />
  <chapter number="22" style="c" sid="DEU 22" />
  <para style="p">
    <verse number="1" style="v" sid="DEU 22:1" />మీ తోటి ఇశ్రాయేలీయుల ఎద్దు లేదా గొర్రెలు దారితప్పినట్లు మీరు చూస్తే దానిని విస్మరించవద్దు. కానీ దానిని తిరిగి దాని యజమాని దగ్గరకు తీసుకెళ్లండి. <verse eid="DEU 22:1" /><verse number="2" style="v" sid="DEU 22:2" />ఒకవేళ వారు మీ దగ్గర నివసించకపోయినా లేదా దాని యజమాని ఎవరో మీకు తెలియకపోయినా, దానిని మీతో ఇంటికి తీసుకెళ్లి, వారు దానిని వెదుక్కునే వరకు ఉంచి, తర్వాత తిరిగి ఇచ్చేయండి. <verse eid="DEU 22:2" /><verse number="3" style="v" sid="DEU 22:3" />గాడిద గాని వస్త్రం గాని మరి ఏ వస్తువైనా దొరికితే ఇలాగే చేయాలి. దాన్ని విస్మరించవద్దు.<verse eid="DEU 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 22:4" />మీ తోటి ఇశ్రాయేలీయుని గాడిద గాని ఎద్దు గాని దారిలో పడి ఉండడం మీరు చూస్తే, దానిని విస్మరించవద్దు. అది తిరిగి లేచి నిలబడేలా దాని యజమానికి సహాయం చేయండి.<verse eid="DEU 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 22:5" />స్త్రీలు పురుషుల దుస్తులు వేసుకోకూడదు, పురుషులు స్త్రీల వస్త్రాలు వేసుకోకూడదు, ఎందుకంటే అలా చేసేవారిని మీ దేవుడైన యెహోవా అసహ్యించుకుంటారు.<verse eid="DEU 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 22:6" />రోడ్డు ప్రక్కన, చెట్టు ప్రక్కన లేదా నేలపై పక్షుల గూడు కనిపిస్తే, తల్లి చిన్నపిల్లలపై లేదా గుడ్లపై కూర్చుంటే, తల్లిని పిల్లలతో తీసుకెళ్లవద్దు. <verse eid="DEU 22:6" /><verse number="7" style="v" sid="DEU 22:7" />మీరు పిల్లలను తీసుకెళ్లవచ్చు, కాని తల్లిని వదిలేయాలి, తద్వార మీరు బాగుంటారు దీర్ఘాయువు కలిగి ఉంటారు.<verse eid="DEU 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 22:8" />మీరు ఒక క్రొత్త ఇంటిని కట్టుకున్నప్పుడు, మీ పైకప్పు చుట్టూ ఒక పిట్టగోడను కట్టుకోండి, తద్వారా ఎవరైనా పైకప్పు నుండి క్రింద పడితే మీ ఇంటిపైకి రక్తపాతం యొక్క అపరాధం తీసుకురాదు.<verse eid="DEU 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 22:9" />మీ ద్రాక్షతోటలో రెండు రకాల విత్తనాలను నాటవద్దు; మీరు అలా చేస్తే, మీరు వేసే పంటలు మాత్రమే కాకుండా ద్రాక్షతోట యొక్క పండు కూడా అపవిత్రమవుతుంది.<verse eid="DEU 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 22:10" />ఒక ఎద్దును ఒక గాడిదను జతచేసి దున్నకూడదు.<verse eid="DEU 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 22:11" />ఉన్ని జనపనార కలిపి నేసిన బట్టలు ధరించకూడదు.<verse eid="DEU 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 22:12" />మీరు ధరించే వస్త్రం యొక్క నాలుగు మూలల్లో కుచ్చులు చేయండి.<verse eid="DEU 22:12" /></para>
  <para style="s1">పెళ్ళి ఉల్లంఘనలు</para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 22:13" />ఒకవేళ ఒక వ్యక్తి భార్యను తీసుకుని, ఆమెతో పడుకున్న తర్వాత, ఆమెను ఇష్టపడక, <verse eid="DEU 22:13" /><verse number="14" style="v" sid="DEU 22:14" />ఆమెను దూషించి, ఆమె పేరు చెడ్డ చేసి, “నేను ఈ స్త్రీని పెళ్ళి చేసుకున్నాను, కానీ నేను ఆమె దగ్గరకు వెళ్లినప్పుడు, ఆమె కన్యత్వానికి రుజువు దొరకలేదు” అని చెప్తే, <verse eid="DEU 22:14" /><verse number="15" style="v" sid="DEU 22:15" />అప్పుడు ఆ యువతి తల్లిదండ్రులు ఆమె కన్య అనే రుజువును పట్టణ పెద్దల దగ్గరకు తీసుకురావాలి. <verse eid="DEU 22:15" /><verse number="16" style="v" sid="DEU 22:16" />ఆమె తండ్రి పెద్దలతో, “నేను నా కుమార్తెను ఈ వ్యక్తికిచ్చి పెళ్ళి చేశాను, కాని అతనికి ఆమెపై ఇష్టం లేదు. <verse eid="DEU 22:16" /><verse number="17" style="v" sid="DEU 22:17" />ఇప్పుడు అతడు ఆమెను దూషించి, ‘మీ కుమార్తె కన్యగా నాకు కనిపించలేదు’ అని అంటున్నాడు. కానీ, నా కుమార్తె కన్యత్వానికి ఇది రుజువు” అని ఆమె తల్లిదండ్రులు పట్టణ పెద్దల ముందు వస్త్రాన్ని ప్రదర్శించాలి, <verse eid="DEU 22:17" /><verse number="18" style="v" sid="DEU 22:18" />పట్టణ పెద్దలు ఆ వ్యక్తిని తీసుకెళ్లి అతన్ని శిక్షించాలి. <verse eid="DEU 22:18" /><verse number="19" style="v" sid="DEU 22:19" />వారు అతనికి వంద షెకెళ్ళ<note caller="+" style="f"><char style="fr" closed="false">22:19 </char><char style="ft" closed="false">అంటే సుమారు 1.2 కి. గ్రా. లు</char></note> వెండి జరిమానా విధించి, ఆ యువతి తండ్రికి ఇవ్వాలి, ఎందుకంటే ఈ వ్యక్తి ఇశ్రాయేలు కన్యకు చెడ్డ పేరు పెట్టాడు. ఆమె అతని భార్యగా ఉంటుంది; అతడు బ్రతికున్నంత కాలం అతడు ఆమెకు విడాకులు ఇవ్వకూడదు.<verse eid="DEU 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 22:20" />ఒకవేళ, ఆరోపణ నిజమైతే ఆ యువతి కన్యత్వానికి రుజువు దొరకనట్లైతే, <verse eid="DEU 22:20" /><verse number="21" style="v" sid="DEU 22:21" />ఆమెను తన తండ్రి ఇంటి తలుపు దగ్గరకు తీసుకురావాలి; అక్కడ ఆ పట్టణ పురుషులు ఆమెను రాళ్లతో కొట్టి చంపుతారు. ఆమె తన తండ్రి ఇంట్లో ఉన్నప్పుడు వేశ్యావృత్తి చేయడం ద్వారా ఆమె ఇశ్రాయేలులో తప్పుడు పని చేసింది. మీరు మీ మధ్య నుండి చెడును ప్రక్షాళన చేయాలి.<verse eid="DEU 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 22:22" />ఒక వ్యక్తి మరొకరి భార్యతో పడుకున్నట్లు కనిపించినట్లయితే, ఆమెతో పడుకున్న వ్యక్తి, ఆ స్త్రీ ఇద్దరూ మరణించాలి. మీరు ఇశ్రాయేలు నుండి చెడును ప్రక్షాళన చేయాలి.<verse eid="DEU 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 22:23" />ఒకవేళ ఒక పురుషుడు ఒక పట్టణంలో పెళ్ళి నిశ్చయమైన ఒక కన్యను కలవడం జరిగి, అతడు ఆమెతో పడుకున్నట్లైతే, <verse eid="DEU 22:23" /><verse number="24" style="v" sid="DEU 22:24" />మీరు వారిద్దరిని ఆ పట్టణ ద్వారం దగ్గరకు తీసుకెళ్లి, ఆ యువతి పట్టణంలో ఉండి కూడా సహాయం కోసం కేకలు వేయనందుకు తనను, మరొక వ్యక్తి భార్యను చెరిపినందుకు అతన్ని రాళ్లతో కొట్టి చంపాలి. ఆ విధంగా మీరు మీ మధ్య నుండి చెడును ప్రక్షాళన చేయాలి.<verse eid="DEU 22:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 22:25" />అయితే దేశంలో ఒకడు అనుకోకుండ పెళ్ళి నిశ్చయమైన ఒక యువతిని కలిసినప్పుడు, వాడు ఆమెను పాడు చేస్తే, అది చేసిన వ్యక్తి మాత్రమే చావాలి. <verse eid="DEU 22:25" /><verse number="26" style="v" sid="DEU 22:26" />స్త్రీని ఏమీ చేయవద్దు; ఎందుకంటే ఆమె చంపబడేంత పాపం చేయలేదు. ఈ దావా ఒక పొరుగువాని మీద దాడి చేసి హత్యచేసిన దానిలా ఉంది, <verse eid="DEU 22:26" /><verse number="27" style="v" sid="DEU 22:27" />ఎందుకంటే ఆ పురుషుడు దేశంలో ఆ యువతిని చూశాడు, నిశ్చితార్థమైన ఆ యువతి కేకలు వేసింది, కాని ఆమెను రక్షించడానికి ఎవరూ రాలేదు.<verse eid="DEU 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DEU 22:28" />ఒకవేళ ఒక పురుషుడు పెళ్ళి నిశ్చయం కాని ఒక కన్యను కలవడం జరిగి ఆమెను బలత్కారం చేసి వారు పట్టుబడితే, <verse eid="DEU 22:28" /><verse number="29" style="v" sid="DEU 22:29" />అతడు ఆమె తండ్రికి యాభై షెకెళ్ళ<note caller="+" style="f"><char style="fr" closed="false">22:29 </char><char style="ft" closed="false">అంటే సుమారు 575 గ్రాములు</char></note> వెండి చెల్లించాలి. అతడు ఆ యువతిని అవమానించాడు కాబట్టి ఆమెను పెళ్ళి చేసుకోవాలి. అతడు బ్రతికున్నంత కాలం ఆమెకు విడాకులు ఇవ్వకూడదు.<verse eid="DEU 22:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="DEU 22:30" />ఒక పురుషుడు తన తండ్రి భార్యను పెళ్ళి చేసుకోకూడదు; అతడు తన తండ్రి పడకను అగౌరపరచకూడదు.<verse eid="DEU 22:30" /></para>
  <chapter eid="DEU 22" />
  <chapter number="23" style="c" sid="DEU 23" />
  <para style="s1">సమాజం నుండి బహిష్కరణ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 23:1" />నలిగిన బీజములు ఉన్నవారు, పురుషాంగం కత్తిరించబడిన వారు యెహోవా సమాజంలో ప్రవేశించకూడదు.<verse eid="DEU 23:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="DEU 23:2" />అక్రమ సంతానమైన వ్యక్తి గాని అతని సంతతివారు గాని పదవ తరాల వరకు కూడా యెహోవా సమాజంలో ప్రవేశించకూడదు.<verse eid="DEU 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="DEU 23:3" />అమ్మోనీయులే గాని మోయాబీయులే గాని లేదా వారి సంతతివారే గాని పదితరాల వరకు కూడా యెహోవా సమాజంలో ప్రవేశించలేరు. <verse eid="DEU 23:3" /><verse number="4" style="v" sid="DEU 23:4" />మీరు ఈజిప్టు నుండి బయటకు వచ్చినప్పుడు వారు మిమ్మల్ని దారిలో రొట్టె గాని నీళ్లు గాని తీసుకుని కలవడానికి రాలేదు. వారు మిమ్మల్ని శపించడానికి అరాము నహరయీములోని<note caller="+" style="f"><char style="fr" closed="false">23:4 </char><char style="ft" closed="false">అంటే, వాయువ్య మెసొపొటేమియా</char></note> పెతోరు నుండి బెయోరు కుమారుడు బిలామును తెచ్చుకున్నారు. <verse eid="DEU 23:4" /><verse number="5" style="v" sid="DEU 23:5" />ఎలాగైతేనేం, మీ దేవుడైన యెహోవా బిలాము మాటలను ఆమోదించ లేదు. దేవుడైన యెహోవా మిమ్మల్ని ఎంతో ప్రేమిస్తున్నారు. అందుకే శాపాన్ని దీవెనగా మార్చారు. <verse eid="DEU 23:5" /><verse number="6" style="v" sid="DEU 23:6" />మీరు బ్రతికి ఉన్నంత వరకు వారితో స్నేహ ఒప్పందం కోరవద్దు.<verse eid="DEU 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 23:7" />ఎదోమీయులను తృణీకరించవద్దు, ఎందుకంటే ఎదోమీయులు మీ బంధువులు. ఈజిప్టువారిని తృణీకరించవద్దు, ఎందుకంటే మీరు వారి దేశంలో విదేశీయులుగా నివసించారు. <verse eid="DEU 23:7" /><verse number="8" style="v" sid="DEU 23:8" />వారికి జన్మించిన మూడవ తరం పిల్లలు యెహోవా సమాజంలో ప్రవేశించవచ్చు.<verse eid="DEU 23:8" /></para>
  <para style="s1">శిబిరంలో అపవిత్రత</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 23:9" />మీరు మీ శత్రువులకు వ్యతిరేకంగా గుడారాలు వేసుకున్నప్పుడు, అపవిత్రమైన ప్రతీ దానికి దూరంగా ఉండండి. <verse eid="DEU 23:9" /><verse number="10" style="v" sid="DEU 23:10" />రాత్రి జరిగినదాని వల్ల అపవిత్రమైన వ్యక్తి, శిబిరం బయటకు వెళ్లి అక్కడ ఉండాలి. <verse eid="DEU 23:10" /><verse number="11" style="v" sid="DEU 23:11" />కానీ సాయంకాలం అవుతుండగా అతడు స్నానం చేసుకోవాలి, సూర్యాస్తమయం అయినప్పుడు అతడు శిబిరానికి తిరిగి రావచ్చు.<verse eid="DEU 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 23:12" />మీ విసర్జన కోసం శిబిరం బయట ప్రత్యేకంగా స్థలం ఏర్పరచుకోవాలి. <verse eid="DEU 23:12" /><verse number="13" style="v" sid="DEU 23:13" />త్రవ్వడానికి మీ దగ్గర పరికరాలతో పాటు ఒక పారను దగ్గర ఉంచుకుని దానితో గుంట త్రవ్వి, మలవిసర్జన తర్వాత మట్టితో మలాన్ని కప్పివేయాలి. <verse eid="DEU 23:13" /><verse number="14" style="v" sid="DEU 23:14" />మీ దేవుడైన యెహోవా మిమ్మల్ని రక్షించడానికి, మీ శత్రువులను మీకు అప్పగించడానికి మీ శిబిరంలో సంచరిస్తారు. మీ శిబిరం తప్పనిసరిగా పరిశుద్ధంగా ఉండాలి, తద్వారా ఆయన మీ మధ్య అసభ్యకరమైనదేది చూడరు, మీ నుండి తప్పుకోరు.<verse eid="DEU 23:14" /></para>
  <para style="s1">ఇతర చట్టాలు</para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 23:15" />బానిసలు మిమ్మల్ని ఆశ్రయిస్తే, వారిని వారి యజమానికి అప్పగించవద్దు. <verse eid="DEU 23:15" /><verse number="16" style="v" sid="DEU 23:16" />వారిని మీ మధ్య వారికి ఇష్టమైనట్లు, వారు ఎంచుకున్న పట్టణంలో నివసింపనివ్వండి. వారిని అణచివేయవద్దు.<verse eid="DEU 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 23:17" />ఏ ఇశ్రాయేలు పురుషుడు గాని స్త్రీ గాని ఆలయ వేశ్యగా మారకూడదు. <verse eid="DEU 23:17" /><verse number="18" style="v" sid="DEU 23:18" />మీ దేవుడైన యెహోవా వారిద్దరిని అసహ్యిస్తారు కాబట్టి ఏ మ్రొక్కుబడినైనా చెల్లించడానికి వేశ్యలైన స్త్రీలు గాని పురుషులు గాని<note caller="+" style="f"><char style="fr" closed="false">23:18 </char><char style="ft" closed="false">హెబ్రీలో </char><char style="fqa" closed="false">కుక్క</char></note> వారి సంపాదనలు మీరు మీ దేవుడైన యెహోవా మందిరంలోకి తీసుకురాకూడదు.<verse eid="DEU 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 23:19" />వడ్డీ సంపాదించగల డబ్బు గాని ఆహారమే గాని వేరే ఏదైనా గాని, తోటి ఇశ్రాయేలు దగ్గర వడ్డీ వసూలు చేయకూడదు. <verse eid="DEU 23:19" /><verse number="20" style="v" sid="DEU 23:20" />మీరు విదేశీయుల దగ్గర వడ్డీని వసూలు చేయవచ్చు, కానీ తోటి ఇశ్రాయేలు దగ్గర కాదు, తద్వారా మీరు స్వాధీనం చేసుకునే దేశంలో మీరు చేయి పెట్టిన ప్రతి దానిలో మీ దేవుడైన యెహోవా మిమ్మల్ని ఆశీర్వదిస్తారు.<verse eid="DEU 23:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 23:21" />మీరు మీ దేవుడైన యెహోవాకు మ్రొక్కుబడి చేస్తే, దానిని తీర్చడానికి ఆలస్యం చేయకండి, ఎందుకంటే మీ దేవుడైన యెహోవా ఖచ్చితంగా మీ నుండి దాన్ని కోరతారు, మీరు పాపాన్ని బట్టి దోషులవుతారు. <verse eid="DEU 23:21" /><verse number="22" style="v" sid="DEU 23:22" />కానీ మీరు మ్రొక్కుబడి చేయడం మానుకుంటే, మీరు దోషులు కారు. <verse eid="DEU 23:22" /><verse number="23" style="v" sid="DEU 23:23" />మీ పెదవులు ఏది చెప్పినా మీరు తప్పకుండా చేయాలి, ఎందుకంటే మీరు మీ దేవుడైన యెహోవాకు మీ నోటితో స్వేచ్ఛగా మ్రొక్కుబడి చేశారు.<verse eid="DEU 23:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DEU 23:24" />మీరు మీ పొరుగువారి ద్రాక్షతోటలోనికి ప్రవేశిస్తే, మీకు కావలసిన ద్రాక్షపండ్లను మీరు తినవచ్చు, కానీ మీ బుట్టలో వాటిని వేసుకోకూడదు. <verse eid="DEU 23:24" /><verse number="25" style="v" sid="DEU 23:25" />మీరు మీ పొరుగువారి ధాన్యపు పొలంలోకి ప్రవేశిస్తే, మీరు మీ చేతులతో విత్తనాలను తీసుకోవచ్చు, కానీ మీరు పండిన పంటను కొడవలితో కోయకూడదు.<verse eid="DEU 23:25" /></para>
  <chapter eid="DEU 23" />
  <chapter number="24" style="c" sid="DEU 24" />
  <para style="p">
    <verse number="1" style="v" sid="DEU 24:1" />ఒక వ్యక్తి ఒక స్త్రీని పెళ్ళి చేసుకున్న తర్వాత ఆమె అంతకుముందే వేరొకనితో సంబంధం కలిగి ఉన్నట్లు అనుమానం కలిగి ఆమె మీద ఇష్టం తొలగిపోతే, అతడు ఆమెకు విడాకుల ధృవీకరణ పత్రం వ్రాసి ఆమెకు ఇచ్చి తన ఇంట్లోనుండి పంపివేయాలి. <verse eid="DEU 24:1" /><verse number="2" style="v" sid="DEU 24:2" />ఒకవేళ ఆమె అతని ఇంటి నుండి వెళ్లిన తర్వాత ఆమె మరొక వ్యక్తికి భార్య అయితే, <verse eid="DEU 24:2" /><verse number="3" style="v" sid="DEU 24:3" />ఆమె రెండవ భర్త కూడా ఆమెను ఇష్టపడలేదు, ఆమెకు విడాకుల ధృవీకరణ పత్రం వ్రాసి ఆమెకు ఇచ్చి అతని ఇంటి నుండి పంపిస్తే లేదా అతడు చనిపోతే, <verse eid="DEU 24:3" /><verse number="4" style="v" sid="DEU 24:4" />అప్పుడు ఆమె విడాకులు తీసుకున్న ఆమె మొదటి భర్త, ఆమె అపవిత్రమైన తర్వాత ఆమెను మళ్ళీ పెళ్ళి చేసుకోవడానికి అనుమతించబడలేదు. అది యెహోవా దృష్టిలో అసహ్యకరమైనది. మీ దేవుడైన యెహోవా మీకు వారసత్వంగా ఇస్తున్న దేశం మీదికి మీరు దోషం తీసుకురావద్దు.<verse eid="DEU 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 24:5" />ఒక వ్యక్తి క్రొత్తగా పెళ్ళి చేసుకున్నట్లయితే, అతన్ని యుద్ధానికి పంపకూడదు, ఏ ఇతర భారాన్ని మోపకూడదు. ఒక సంవత్సరం పాటు అతడు స్వేచ్ఛగా ఇంట్లో ఉండి పెళ్ళి చేసుకున్న భార్యను సంతోషపెట్టాలి.<verse eid="DEU 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="DEU 24:6" />అప్పు కోసం పూచీకత్తుగా ఒక తిరగలిని గాని, తిరగలి పై రాతిని గాని తాకట్టు పెట్టకూడదు. ఎందుకంటే అది మనిషి జీవనాధారాన్ని తాకట్టు పెట్టినట్లవుతుంది.<verse eid="DEU 24:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 24:7" />ఎవరైనా తోటి ఇశ్రాయేలును ఎత్తుకెళ్లి, బానిసగా చూస్తూ లేదా అమ్ముతూ పట్టుబడినా, ఎత్తుకెళ్లిన వాడు మరణించాలి. మీ మధ్య నుండి చెడును ప్రక్షాళన చేయాలి.<verse eid="DEU 24:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 24:8" />అపవిత్రం చేసే కుష్ఠు<note caller="+" style="f"><char style="fr" closed="false">24:8 </char><char style="ft" closed="false">హెబ్రీ భాషలో ఏ చర్మ వ్యాధి గురించియైనా </char><char style="fqa" closed="false">కుష్ఠువ్యాధి </char><char style="ft" closed="false">అని వాడబడింది</char></note> లాంటి వ్యాధి విషయాల్లో, లేవీయ యాజకులు మీకు సూచించిన విధంగా ఖచ్చితంగా చేయండి. నేను వారికి ఆజ్ఞాపించిన వాటిని మీరు జాగ్రత్తగా పాటించాలి. <verse eid="DEU 24:8" /><verse number="9" style="v" sid="DEU 24:9" />మీరు ఈజిప్టు నుండి ప్రయాణమై వస్తూ ఉండగా మీ దేవుడైన యెహోవా మిర్యాముకు ఏమి చేశారో జ్ఞాపకం ఉంచుకోండి.<verse eid="DEU 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 24:10" />మీరు మీ పొరుగువానికి ఏదైనా అప్పు ఇచ్చినప్పుడు, వారు తాకట్టుగా పెట్టిన దాన్ని తెచ్చుకోడానికి ఇంట్లో చొరబడకూడదు. <verse eid="DEU 24:10" /><verse number="11" style="v" sid="DEU 24:11" />బయటనే నిలవాలి, ఇంట్లోనుండి వచ్చి అతడే స్వయంగా ఆ వస్తువు తెచ్చి ఇవ్వాలి. <verse eid="DEU 24:11" /><verse number="12" style="v" sid="DEU 24:12" />పొరుగువాడు పేదవాడైతే, వాని తాకట్టును మీ దగ్గర పెట్టుకుని నిద్రపోవద్దు. <verse eid="DEU 24:12" /><verse number="13" style="v" sid="DEU 24:13" />సూర్యాస్తమయానికి వారి వస్త్రాన్ని తిరిగి ఇవ్వండి, తద్వారా మీ పొరుగువారు దానిపై నిద్రపోవచ్చు. అప్పుడు వారు మిమ్మల్ని దీవిస్తారు, అది మీ దేవుడైన యెహోవా దృష్టిలో నీతిగా లెక్కించబడుతుంది.<verse eid="DEU 24:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 24:14" />మీ తోటి ఇశ్రాయేలీయులలో గాని మీ పట్టణాల్లో నివసిస్తున్న విదేశీయులలో గాని పేదవారై అవసరంలో ఉన్న కూలివారిని బాధించవద్దు. <verse eid="DEU 24:14" /><verse number="15" style="v" sid="DEU 24:15" />ప్రతిరోజు సూర్యాస్తమయానికి ముందు వారి వేతనాలు చెల్లించండి, ఎందుకంటే వారు పేదవారు దానిని లెక్కిస్తున్నారు. లేకపోతే వారు మీకు వ్యతిరేకంగా యెహోవాకు మొర పెట్టవచ్చు, అప్పుడు మీరు దోషులుగా పరిగణించబడతారు.<verse eid="DEU 24:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 24:16" />తల్లిదండ్రులు తమ పిల్లల కోసం మరణశిక్ష పొందకూడదు, లేదా వారి తల్లిదండ్రుల కోసం పిల్లలు మరణశిక్ష పొందకూడదు; ప్రతి ఒక్కరూ తమ సొంత పాపం కోసం చనిపోతారు.<verse eid="DEU 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 24:17" />న్యాయం విషయంలో విదేశీయులను గాని తండ్రిలేనివారిని గాని వంచించకండి లేదా విధవరాలి యొక్క వస్త్రాన్ని తాకట్టుగా తీసుకోకండి, <verse eid="DEU 24:17" /><verse number="18" style="v" sid="DEU 24:18" />మీరు ఈజిప్టులో బానిసలుగా ఉన్నారని, మీ దేవుడైన యెహోవా మిమ్మల్ని అక్కడినుండి విడిపించారని జ్ఞాపకముంచుకోండి. అందుకే ఇలా చేయండని నేను మీకు ఆజ్ఞాపిస్తున్నాను.<verse eid="DEU 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 24:19" />మీరు మీ పొలంలో పంట కోసినప్పుడు, మీరు ఒక పనను పట్టించుకోకపోతే, దాన్ని తెచ్చుకోడానికి తిరిగి వెనుకకు వెళ్లవద్దు. మీ చేతుల యొక్క అన్ని పనులలో మీ దేవుడైన యెహోవా మిమ్మల్ని ఆశీర్వదించేలా విదేశీయులు, తండ్రిలేనివారు, విధవరాండ్ర కోసం వదిలేయండి. <verse eid="DEU 24:19" /><verse number="20" style="v" sid="DEU 24:20" />మీరు మీ చెట్ల నుండి ఒలీవలను కొట్టినప్పుడు, రెండవసారి కొమ్మలపైకి వెళ్లవద్దు. విదేశీయులు, తండ్రిలేనివారు, విధవరాండ్ర కోసం మిగిలి ఉన్నవాటిని వదిలేయండి. <verse eid="DEU 24:20" /><verse number="21" style="v" sid="DEU 24:21" />మీరు మీ ద్రాక్షతోటలో ద్రాక్షను కోసినప్పుడు, మళ్ళీ తీగెల మీద వెదకవద్దు. మిగిలి ఉన్నవాటిని విదేశీయులు, తండ్రిలేనివారు, విధవరాండ్ర కోసం వదిలేయండి. <verse eid="DEU 24:21" /><verse number="22" style="v" sid="DEU 24:22" />మీరు ఈజిప్టులో బానిసలుగా ఉంటిరని జ్ఞాపకముంచుకోండి. అందుకే ఇలా చేయండని నేను మీకు ఆజ్ఞాపిస్తున్నాను.<verse eid="DEU 24:22" /></para>
  <chapter eid="DEU 24" />
  <chapter number="25" style="c" sid="DEU 25" />
  <para style="p">
    <verse number="1" style="v" sid="DEU 25:1" />ప్రజలకు వివాదం ఉన్నప్పుడు, వారు దానిని న్యాయస్థానానికి తీసుకెళ్లాలి, న్యాయాధిపతులు నిర్దోషులను విముక్తులుగా ప్రకటిస్తూ, దోషులను దోషులుగా ప్రకటిస్తారు. <verse eid="DEU 25:1" /><verse number="2" style="v" sid="DEU 25:2" />ఒకవేళ దోషులు శిక్షార్హులైతే న్యాయాధిపతి వారిని పడుకోబెట్టి అతని సమక్షంలో నేరానికి తగ్గట్టుగా కొరడా దెబ్బల సంఖ్యతో కొరడాతో కొట్టాలి, <verse eid="DEU 25:2" /><verse number="3" style="v" sid="DEU 25:3" />కానీ న్యాయాధిపతి నలభైకి మించి కొరడా దెబ్బలు వేయకూడదు. దోషిని అంతకు మించి కొరడాలతో కొడితే మీ తోటి ఇశ్రాయేలీయుడు మీ దృష్టిలో దిగజారిపోతాడు.<verse eid="DEU 25:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DEU 25:4" />ఎద్దు ధాన్యాన్ని త్రొక్కుతున్నప్పుడు మూతికి చిక్కం కట్టవద్దు.<verse eid="DEU 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 25:5" />అన్నదమ్ములు కలిసి ఉమ్మడి కుటుంబంగా వుంటున్నప్పుడు వారిలో ఒకడు సంతానం లేకుండా చనిపోతే అతని భార్య పరాయివాడ్ని చేసుకోకూడదు, గతించిన తన భర్త తోబుట్టువు ఆమెను పెళ్ళి చేసుకోవాలి, ఆమె పట్ల బావమరిది విధిని నెరవేర్చాలి. <verse eid="DEU 25:5" /><verse number="6" style="v" sid="DEU 25:6" />ఆమె కనిన మొదటి కుమారుడు చనిపోయిన సోదరుడి పేరును కొనసాగించాలి, తద్వారా అతని పేరు ఇశ్రాయేలు నుండి తొలగించబడదు.<verse eid="DEU 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 25:7" />ఏదేమైనా, ఒక వ్యక్తి తన సోదరుడి భార్యను పెళ్ళి చేసుకోకూడదనుకుంటే, ఆమె పట్టణ ద్వారం దగ్గర ఉన్న పెద్దల దగ్గరకు వెళ్లి, “నా భర్త సోదరుడు ఇశ్రాయేలీయులలో తన సోదరుని పేరును కొనసాగించడానికి నా నిరాకరిస్తున్నాడు. అతడు నా పట్ల ఒక బావమరిది కర్తవ్యాన్ని నెరవేర్చడం లేదు” అని చెప్పాలి. <verse eid="DEU 25:7" /><verse number="8" style="v" sid="DEU 25:8" />అప్పుడు పట్టణ పెద్దలు అతన్ని పిలిపించి మాట్లాడాలి. అప్పటికీ అతడు, “ఆమెను పెళ్ళి చేసుకోవడం నాకు ఇష్టం లేదు” అని మొండిగా ఉంటే, <verse eid="DEU 25:8" /><verse number="9" style="v" sid="DEU 25:9" />అతని సోదరుని విధవరాలు పెద్దల సమక్షంలో అతని దగ్గరకు వెళ్లి, అతని కాలి చెప్పు ఊడదీసి అతని ముఖం మీద ఉమ్మివేసి, “తన సోదరుని కుటుంబాన్ని నిలబెట్టని వ్యక్తికి ఇలాగే జరుగుతుంది” అని చెప్పాలి. <verse eid="DEU 25:9" /><verse number="10" style="v" sid="DEU 25:10" />అప్పుడు వాని వంశం ఇశ్రాయేలులో చెప్పు ఊడదీయబడిన కుటుంబం అని పిలువబడుతుంది.<verse eid="DEU 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 25:11" />ఇద్దరు పురుషులు పోట్లాడుకుంటునప్పుడు వారిలో ఒకని భార్య అవతలివాని బారి నుండి తన భర్తను విడిపించడానికి వచ్చి వాని మర్మాంగాన్ని పట్టుకున్నట్లయితే, <verse eid="DEU 25:11" /><verse number="12" style="v" sid="DEU 25:12" />ఆమె చేతిని తెగనరకాలి. ఆమె మీద దయ చూపకూడదు.<verse eid="DEU 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 25:13" />మీ సంచిలో రెండు వేరువేరు తూనిక రాళ్లు ఒకటి బరువైనవి ఇంకొకటి తేలికైనవి ఉండకూడదు. <verse eid="DEU 25:13" /><verse number="14" style="v" sid="DEU 25:14" />మీ ఇంట్లో రెండు విభిన్న కొలతలు ఒకటి పెద్దది, ఒకటి చిన్నది ఉండకూడదు. <verse eid="DEU 25:14" /><verse number="15" style="v" sid="DEU 25:15" />మీ ఖచ్చితమైన, న్యాయమైన తూనిక రాళ్లు న్యాయమైన త్రాసులు ఉండాలి, తద్వారా మీ దేవుడైన యెహోవా మీకు ఇస్తున్న భూమిలో మీరు ఎక్కువకాలం జీవిస్తారు. <verse eid="DEU 25:15" /><verse number="16" style="v" sid="DEU 25:16" />అన్యాయపు తూకం వేసేవారిని, అన్యాయం చేసేవారిని మీ దేవుడైన యెహోవా అసహ్యించుకుంటారు.<verse eid="DEU 25:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 25:17" />ఈజిప్టు నుండి మీరు వచ్చినప్పుడు మీ ప్రయాణంలో అమాలేకీయులు మీకు చేసింది జ్ఞాపకముంచుకోండి. <verse eid="DEU 25:17" /><verse number="18" style="v" sid="DEU 25:18" />మీరు అలసిపోయి బడలికతో ఉన్నప్పుడు, వారు మీ ప్రయాణంలో మిమ్మల్ని కలుసుకున్నారు వెనుకబడిన వారందరిపై దాడి చేశారు; వారికి దేవుని భయం లేదు. <verse eid="DEU 25:18" /><verse number="19" style="v" sid="DEU 25:19" />మీ దేవుడైన యెహోవా స్వాస్థ్యంగా మీకిస్తున్న దేశాన్ని మీరు స్వాధీనపరచుకున్న తర్వాత మీ చుట్టూ ఉన్న శత్రువులను పారద్రోలి మీకు విశ్రాంతి ప్రసాదించిన తర్వాత ఆకాశం క్రింద అమాలేకీయులను నామరూపాలు లేకుండా తుడిచివేయాలని మరచిపోవద్దు.<verse eid="DEU 25:19" /></para>
  <chapter eid="DEU 25" />
  <chapter number="26" style="c" sid="DEU 26" />
  <para style="s1">ప్రథమ ఫలాలు, దశమభాగాలు</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 26:1" />మీరు మీ దేవుడైన యెహోవా మీకు వారసత్వంగా ఇస్తున్న దేశంలోకి ప్రవేశించినప్పుడు దానిని స్వాధీనం చేసుకుని దానిలో స్థిరపడాలి. <verse eid="DEU 26:1" /><verse number="2" style="v" sid="DEU 26:2" />మీ దేవుడైన యెహోవా మీకు ఇస్తున్న భూమి నేల నుండి మీరు ఉత్పత్తి చేసే అన్ని ఫలాలను తీసుకుని వాటిని బుట్టలో ఉంచండి, తర్వాత మీ దేవుడైన యెహోవా తన నామానికి నివాసంగా ఎన్నుకునే ప్రదేశానికి వెళ్లి, <verse eid="DEU 26:2" /><verse number="3" style="v" sid="DEU 26:3" />ఆ సమయంలో విధి నిర్వహణలో ఉన్న యాజకునికి, “మాకు ఇస్తానని యెహోవా మా పూర్వికులకు ప్రమాణం చేసిన దేశానికి నేను వచ్చానని ఈ రోజు మీ దేవుడైన యెహోవాకు ప్రకటిస్తున్నాను” అని చెప్పండి. <verse eid="DEU 26:3" /><verse number="4" style="v" sid="DEU 26:4" />యాజకుడు మీ చేతుల్లో నుండి ఆ గంపను తీసుకుని మీ దేవుడైన యెహోవా బలిపీఠం ముందు క్రింద పెట్టాలి. <verse eid="DEU 26:4" /><verse number="5" style="v" sid="DEU 26:5" />అప్పుడు మీరు మీ దేవుడైన యెహోవా ఎదుట ఇలా ప్రకటించాలి: “నా తండ్రి సంచరించే అరామీయుడు, అతడు కొద్దిమంది వ్యక్తులతో ఈజిప్టుకు వెళ్లి అక్కడ నివసించి, శక్తివంతమైన, అసంఖ్యాకమైన గొప్ప దేశంగా అయ్యాడు. <verse eid="DEU 26:5" /><verse number="6" style="v" sid="DEU 26:6" />కాని ఈజిప్టువారు మనలను హింసించి, బాధపెట్టి, మనలను కఠినమైన శ్రమకు గురి చేశారు. <verse eid="DEU 26:6" /><verse number="7" style="v" sid="DEU 26:7" />మనం మన పూర్వికుల దేవుడైన యెహోవాకు మొరపెట్టుకున్నాము. యెహోవా మన మొర విని, మన బాధ, ప్రయాస, మనకు కలిగిన హింసను చూశారు. <verse eid="DEU 26:7" /><verse number="8" style="v" sid="DEU 26:8" />యెహోవా తన బలమైన హస్తంతో చేయి చాపి మహా భయంకరమైన విధంగా చర్య తీసుకున్నాడు, అసాధారణ గుర్తులను, అద్భుతాలను చూపించారు. <verse eid="DEU 26:8" /><verse number="9" style="v" sid="DEU 26:9" />ఈ స్థలానికి మనలను తెచ్చి పాలు తేనెలు నదులైపారే ఈ దేశాన్ని మనకిచ్చారు. <verse eid="DEU 26:9" /><verse number="10" style="v" sid="DEU 26:10" />యెహోవా, మీరు నాకు ఇచ్చిన భూమిలోని మొదటి ఫలాలను ఇప్పుడు తెస్తున్నాను.” ఆ గంపను మీ దేవుడైన యెహోవా ముందు పెట్టి ఆయన ముందు నమస్కరించాలి. <verse eid="DEU 26:10" /><verse number="11" style="v" sid="DEU 26:11" />నీకు మీ ఇంటివారికి మీ దేవుడైన యెహోవా అనుగ్రహించిన మేలును బట్టి మీరూ లేవీయులు అలాగే మీ మధ్య ఉన్న విదేశీయులు కలిసి సంతోషించాలి.<verse eid="DEU 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 26:12" />పదవ భాగం ఇచ్చే సంవత్సరం, అనగా మూడవ సంవత్సరం మీ రాబడిలో దశమభాగం చెల్లించి, అది లేవీయులకు విదేశీయులకు తండ్రిలేనివారికి విధవరాండ్రకు ఇవ్వాలి. వారు మీ గ్రామాల్లో వీరంతా తిని తృప్తి పొందాలి. <verse eid="DEU 26:12" /><verse number="13" style="v" sid="DEU 26:13" />అప్పుడు మీరు మీ దేవుడైన యెహోవా సన్నిధిలో ఇలా చెప్పాలి: “మీరు ఆజ్ఞాపించిన ప్రకారము నేను ప్రతిష్ఠితమైన దాన్ని నా ఇంటి నుండి తీసివేసి లేవీయులకు విదేశీయులకు, తండ్రిలేనివారికి విధవరాండ్రకు ఇచ్చాను. నేను మీ ఆజ్ఞలను ప్రక్కన పెట్టలేదు వాటిలో దేన్ని నేను మరచిపోలేదు. <verse eid="DEU 26:13" /><verse number="14" style="v" sid="DEU 26:14" />నేను దుఃఖంలో ఉన్నప్పుడు ప్రతిష్ఠితమైన దానిలోనిది ఏదీ తినలేదు, నేను అపవిత్రంగా ఉన్న సమయంలో అందులో ఏదీ తీసివేయలేదు, చనిపోయినవారి కోసం దాన్ని అర్పించలేదు.నేను నా దేవుడైన యెహోవాకు లోబడ్డాను; మీరు ఆజ్ఞాపించిన ప్రతిదీ నేను చేశాను. <verse eid="DEU 26:14" /><verse number="15" style="v" sid="DEU 26:15" />మీ పవిత్ర నివాసమైన ఆకాశం నుండి క్రిందికి చూడండి మీ పూర్వికులకు ప్రమాణం చేసినట్లుగా మీ ప్రజలైన ఇశ్రాయేలీయులను, మీరు మాకు ఇచ్చిన పాలు తేనెలు ప్రవహించే ఈ భూమిని ఆశీర్వదించండి.”<verse eid="DEU 26:15" /></para>
  <para style="s1">యెహోవా ఆజ్ఞలను అనుసరించుట</para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 26:16" />మీ దేవుడైన యెహోవా ఈ రోజున మీకాజ్ఞాపిస్తున్న ఈ శాసనాలు చట్టాలు మీరు పాటించాలి; మీ పూర్ణహృదయంతో, మీ ప్రాణమంతటితో మీరు జాగ్రత్తగా వాటిని పాటించాలి. <verse eid="DEU 26:16" /><verse number="17" style="v" sid="DEU 26:17" />మీరు ఈ రోజు యెహోవాయే మీ దేవుడని మీరు ఆయనకు విధేయులై నడుస్తారని, మీరు ఆయన శాసనాలను, ఆజ్ఞలను, చట్టాలను పాటిస్తారని, ఆయన మార్గంలో నడుస్తారని మీరు ప్రకటించారు. <verse eid="DEU 26:17" /><verse number="18" style="v" sid="DEU 26:18" />యెహోవా ఈ రోజున మీరు ఆయన ప్రజలని, ఆయన వాగ్దానం చేసినట్లుగా మీరు ఆయన స్వంత ప్రజలుగా ఉంటూ ఆయన ఆజ్ఞలన్నిటిని పాటించాలని ప్రకటించారు. <verse eid="DEU 26:18" /><verse number="19" style="v" sid="DEU 26:19" />ఆయన తాను చేసిన అన్ని దేశాల కంటే మిమ్మల్ని హెచ్చిస్తారని, అప్పుడు మీరు ప్రశంసలు, కీర్తి, గౌరవం పొందుకుంటారని, ఆయన వాగ్దానం చేసినట్లుగా మీరు మీ దేవుడైన యెహోవాకు పరిశుద్ధ ప్రజలుగా ఉంటారని ఆయన ప్రకటించారు.<verse eid="DEU 26:19" /></para>
  <chapter eid="DEU 26" />
  <chapter number="27" style="c" sid="DEU 27" />
  <para style="s1">ఏబాలు కొండమీద బలిపీఠం</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 27:1" />మోషే, ఇశ్రాయేలు పెద్దలు ప్రజలకు ఇలా ఆజ్ఞాపించారు: “ఈ రోజు మీకు ఇస్తున్న ఈ ఆజ్ఞలన్నిటిని మీరు పాటించాలి. <verse eid="DEU 27:1" /><verse number="2" style="v" sid="DEU 27:2" />మీకు దేవుడైన యెహోవా ఇస్తున్న వాగ్దాన దేశంలో ప్రవేశించడానికి యొర్దాను దాటిన రోజున, మీరు పెద్ద రాళ్లు నిలబెట్టి వాటికి సున్నం వేయాలి. <verse eid="DEU 27:2" /><verse number="3" style="v" sid="DEU 27:3" />మీ పూర్వికుల దేవుడైన యెహోవా మీకు వాగ్దానం చేసినట్లే, మీ దేవుడైన యెహోవా మీకు ఇస్తున్న పాలు తేనెలు ప్రవహించే దేశంలోకి ప్రవేశించడానికి మీరు దాటునప్పుడు ఈ చట్టం లోని పూర్తి మాటలను వాటిపై వ్రాయండి. <verse eid="DEU 27:3" /><verse number="4" style="v" sid="DEU 27:4" />మీరు యొర్దాను దాటినప్పుడు, సున్నం వేసిన ఈ రాళ్లను నేను ఈ రోజు మీకు ఆజ్ఞాపించినట్లు ఏబాలు పర్వతం మీద నిలబెట్టండి. <verse eid="DEU 27:4" /><verse number="5" style="v" sid="DEU 27:5" />అక్కడ మీ దేవుడైన యెహోవాకు ఒక బలిపీఠం రాళ్లతో కట్టాలి. వాటిపై ఎలాంటి ఇనుప సాధనాన్ని వాడకూడదు. <verse eid="DEU 27:5" /><verse number="6" style="v" sid="DEU 27:6" />చెక్కని రాళ్లతో యెహోవాకు బలిపీఠం కట్టి దాని మీద దహనబలులు అర్పించాలి. <verse eid="DEU 27:6" /><verse number="7" style="v" sid="DEU 27:7" />అక్కడ సమాధానబలులు సమర్పించి, వాటిని తింటూ మీ దేవుడైన యెహోవా సన్నిధిలో సంతోషించాలి. <verse eid="DEU 27:7" /><verse number="8" style="v" sid="DEU 27:8" />మీరు నిలబెట్టిన రాళ్లమీద ఈ ధర్మశాస్త్రంలోని అన్ని మాటలను స్పష్టంగా వ్రాయండి.”<verse eid="DEU 27:8" /></para>
  <para style="s1">ఏబాలు కొండ నుండి శాపాలు</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 27:9" />తర్వాత మోషే, లేవీయ యాజకులు ఇశ్రాయేలు ప్రజలందరితో ఇలా అన్నారు, “ఇశ్రాయేలూ, మౌనంగా ఉండి నేను చెప్పేది విను! ఇప్పుడు మీరు మీ దేవుడైన యెహోవాకు ప్రజలయ్యారు. <verse eid="DEU 27:9" /><verse number="10" style="v" sid="DEU 27:10" />మీరు దేవుడైన యెహోవాకు లోబడి, నేను మీకు ఈ రోజు ఇస్తున్న ఆయన ఆజ్ఞలను, శాసనాలను మీరు పాటించాలి.”<verse eid="DEU 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 27:11" />ఆ రోజే మోషే ప్రజలకు ఆజ్ఞాపించాడు:<verse eid="DEU 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 27:12" />మీరు యొర్దాను నది దాటిన తర్వాత, షిమ్యోను, లేవీ, యూదా, ఇశ్శాఖారు, యోసేపు, బెన్యామీను గోత్రాల వారు గెరిజీము పర్వతం మీద నిలబడి ప్రజలను దీవించాలి. <verse eid="DEU 27:12" /><verse number="13" style="v" sid="DEU 27:13" />రూబేను, గాదు, ఆషేరు, జెబూలూను, దాను, నఫ్తాలి గోత్రాల వారు ఏబాలు పర్వతం మీద నిలబడి, శాపాలు పలకాలి.<verse eid="DEU 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 27:14" />లేవీయులు ఇశ్రాయేలు ప్రజలందరికి బిగ్గరగా ఇలా చెప్పాలి:<verse eid="DEU 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 27:15" />“శిల్పి చేతులతో చెక్కబడి పోతపోయబడిన యెహోవాకు అసహ్యమైన విగ్రహాలను రహస్య స్థలంలో దాచుకునే వారెవరైనా శాపగ్రస్తులు” అని అన్నప్పుడు</para>
  <para style="pr" vid="DEU 27:15">ప్రజలంతా, “ఆమేన్!” అనాలి.<verse eid="DEU 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 27:16" />“తండ్రిని గాని తల్లిని గాని అవమానపరచే వారు శాపగ్రస్తులు” అని అన్నప్పుడు</para>
  <para style="pr" vid="DEU 27:16">ప్రజలంతా, “ఆమేన్!” అనాలి.<verse eid="DEU 27:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 27:17" />“తన పొరుగువాడి సరిహద్దు రాయిని తీసివేసేవారు శాపగ్రస్తులు” అని అన్నప్పుడు,</para>
  <para style="pr" vid="DEU 27:17">ప్రజలంతా, “ఆమేన్!” అనాలి.<verse eid="DEU 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 27:18" />“గ్రుడ్డివాన్ని త్రోవ తప్పించేవారు శాపగ్రస్తులు” అని అన్నప్పుడు,</para>
  <para style="pr" vid="DEU 27:18">ప్రజలంతా, “ఆమేన్!” అనాలి.<verse eid="DEU 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 27:19" />“విదేశీయుల పట్ల, తండ్రిలేనివారి పట్ల, విధవరాండ్ర పట్ల న్యాయం తప్పి తీర్పు తీర్చేవారు శాపగ్రస్తులు” అని అన్నప్పుడు,</para>
  <para style="pr" vid="DEU 27:19">ప్రజలంతా, “ఆమేన్!” అనాలి.<verse eid="DEU 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 27:20" />“తన తండ్రి భార్యతో లైంగిక సంబంధం పెట్టుకుని తండ్రి పాన్పును అపవిత్రపరచినవారు శాపగ్రస్తులు” అని అన్నప్పుడు,</para>
  <para style="pr" vid="DEU 27:20">ప్రజలంతా, “ఆమేన్!” అనాలి.<verse eid="DEU 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="DEU 27:21" />“ఏ జంతువుతోనైనా లైంగిక సంబంధం పెట్టుకునేవారు శాపగ్రస్తులు” అని అన్నప్పుడు,</para>
  <para style="pr" vid="DEU 27:21">ప్రజలంతా, “ఆమేన్!” అనాలి.<verse eid="DEU 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 27:22" />“తోబుట్టువుతో అనగా తన తండ్రి కుమార్తెతో గాని, తన తల్లి కుమార్తెతో గాని లైంగిక సంబంధం పెట్టుకునేవారు శాపగ్రస్తులు” అని అన్నప్పుడు,</para>
  <para style="pr" vid="DEU 27:22">ప్రజలంతా, “ఆమేన్!” అనాలి.<verse eid="DEU 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 27:23" />“అత్తతో లైంగిక సంబంధం పెట్టుకునేవారు శాపగ్రస్తులు” అని అన్నప్పుడు,</para>
  <para style="pr" vid="DEU 27:23">ప్రజలంతా, “ఆమేన్!” అనాలి.<verse eid="DEU 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DEU 27:24" />“పొరుగువాన్ని రహస్యంగా చంపేవారు శాపగ్రస్తులు” అని అన్నప్పుడు</para>
  <para style="pr" vid="DEU 27:24">ప్రజలంతా, “ఆమేన్!” అనాలి.<verse eid="DEU 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 27:25" />“నిర్దోషి ప్రాణం తీయటానికి లంచం తీసుకునేవారు శాపగ్రస్తులు” అని అన్నప్పుడు,</para>
  <para style="pr" vid="DEU 27:25">ప్రజలంతా, “ఆమేన్!” అనాలి.<verse eid="DEU 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="DEU 27:26" />“ఈ ధర్మశాస్త్రంలోని మాటలను అమలు చేయడం ద్వారా వాటిని పాటించనివారు శాపగ్రస్తులు” అని అన్నప్పుడు,</para>
  <para style="pr" vid="DEU 27:26">ప్రజలంతా, “ఆమేన్!” అనాలి.<verse eid="DEU 27:26" /></para>
  <chapter eid="DEU 27" />
  <chapter number="28" style="c" sid="DEU 28" />
  <para style="s1">విధేయతకు దీవెనలు</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 28:1" />మీరు మీ దేవుడైన యెహోవా మాట శ్రద్ధగా వింటూ, నేను ఈ రోజు మీకిచ్చే ఆయన ఆజ్ఞలన్నిటిని అనుసరిస్తే, మీ దేవుడైన యెహోవా భూమి మీద ఉన్న సమస్త దేశాల కంటే పైగా మిమ్మల్ని హెచ్చిస్తారు. <verse eid="DEU 28:1" /><verse number="2" style="v" sid="DEU 28:2" />మీ దేవుడైన యెహోవాకు మీరు లోబడితే, ఈ దీవెనలన్నీ మీ మీదికి వచ్చి, మిమ్మల్ని వెంబడిస్తాయి:<verse eid="DEU 28:2" /></para>
  <para style="pm">
    <verse number="3" style="v" sid="DEU 28:3" />మీరు పట్టణంలో దీవించబడతారు, పొలంలో దీవించబడతారు.<verse eid="DEU 28:3" /></para>
  <para style="pm">
    <verse number="4" style="v" sid="DEU 28:4" />మీ గర్భఫలం దీవించబడుతుంది, భూ పంటలు, పశువుల మందల్లోని దూడలు గొర్రెల మందల్లోని గొర్రెపిల్లలు దీవించబడతాయి.<verse eid="DEU 28:4" /></para>
  <para style="pm">
    <verse number="5" style="v" sid="DEU 28:5" />మీ గంప, మీ పిండి పిసికే తొట్టి దీవించబడుతుంది.<verse eid="DEU 28:5" /></para>
  <para style="pm">
    <verse number="6" style="v" sid="DEU 28:6" />మీరు లోపలికి వచ్చినప్పుడు, బయటకు వెళ్లినప్పుడు దీవించబడతారు.<verse eid="DEU 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 28:7" />శత్రువులు మీ మీదికి లేచినప్పుడు, యెహోవా వారిని మీ ముందు ఓడిపోయేలా చేస్తారు. వారు ఒకవైపు నుండి మీ దగ్గరకు వస్తారు కాని నీ దగ్గరి నుండి ఏడు వైపుల్లో పారిపోతారు.<verse eid="DEU 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 28:8" />మీ కొట్ల మీదకు మీ ప్రయత్నాలన్నిటి మీదకు యెహోవా దీవెనలు పంపుతారు. మీ దేవుడైన యెహోవా మీకు ఇస్తున్న దేశంలో ఆయన మిమ్మల్ని ఆశీర్వదిస్తారు.<verse eid="DEU 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 28:9" />మీ దేవుడైన యెహోవా ఆజ్ఞలను పాటించి, ఆయన మార్గంలో మీరు నడుచుకుంటే, యెహోవా ప్రమాణ పూర్వకంగా వాగ్దానం చేసినట్లుగా, యెహోవా మిమ్మల్ని తన పరిశుద్ధ ప్రజలుగా స్థాపిస్తారు. <verse eid="DEU 28:9" /><verse number="10" style="v" sid="DEU 28:10" />అప్పుడు భూమి మీద ఉన్న జనాంగాలందరూ మీరు యెహోవా పేరుతో పిలువబడ్డారని చూసి, వారు మీకు భయపడతారు. <verse eid="DEU 28:10" /><verse number="11" style="v" sid="DEU 28:11" />యెహోవా మీకు ఇస్తానని మీ పూర్వికులకు ప్రమాణం చేసిన దేశంలో, మీ గర్భ ఫలంలో, మీ పశువుల పిల్లల్లో, మీ నేల పంటల్లో మీకు సమృద్ధిగా వృద్ధిని ఇస్తారు.<verse eid="DEU 28:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 28:12" />కాలానుగుణంగా మీ భూమిపై వర్షం కురిపించడానికి, మీ చేతి పనులన్నింటినీ దీవించడానికి యెహోవా తన ఆకాశ గిడ్డంగులను తెరుస్తారు. మీరు అనేక దేశాలకు అప్పు ఇస్తారు, కానీ ఎవరినుండి అప్పు తీసుకోరు. <verse eid="DEU 28:12" /><verse number="13" style="v" sid="DEU 28:13" />యెహోవా మిమ్మల్ని తలగా చేస్తారు, తోకగా కాదు. ఈ రోజు నేను మీకు ఇచ్చే మీ దేవుడైన యెహోవా ఆజ్ఞలను మీరు శ్రద్ధగా గమనించి, వాటిని జాగ్రత్తగా పాటిస్తే, మీరు పై వారిగా ఉంటారు, క్రింది వారిగా ఉండరు. <verse eid="DEU 28:13" /><verse number="14" style="v" sid="DEU 28:14" />ఇతర దేవుళ్ళను అనుసరిస్తూ, వారిని సేవిస్తూ, ఈ రోజు నేను మీకు ఇచ్చే ఆజ్ఞల నుండి కుడికి గాని ఎడమకు గాని తిరగవద్దు.<verse eid="DEU 28:14" /></para>
  <para style="s1">అవిధేయతకు శాపాలు</para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 28:15" />అయితే, మీరు మీ దేవుడైన యెహోవాకు విధేయత చూపక, నేను ఈ రోజు మీకు ఇస్తున్న ఆయన ఆజ్ఞలన్నిటిని, శాసనాలను జాగ్రత్తగా పాటించకపోతే, ఈ శాపాలన్నీ మీపైకి వచ్చి మిమ్మల్ని ముంచేస్తాయి.<verse eid="DEU 28:15" /></para>
  <para style="pm">
    <verse number="16" style="v" sid="DEU 28:16" />మీరు పట్టణంలో శపించబడతారు, పొలంలో శపించబడతారు.<verse eid="DEU 28:16" /></para>
  <para style="pm">
    <verse number="17" style="v" sid="DEU 28:17" />మీ గంప, పిండి పిసికే తొట్టి శపించబడతాయి.<verse eid="DEU 28:17" /></para>
  <para style="pm">
    <verse number="18" style="v" sid="DEU 28:18" />మీ గర్భఫలం శపించబడుతుంది, మీ భూమి పంటలు, మీ పశువుల దూడలు, మీ మందల గొర్రెపిల్లలు శపించబడతాయి.<verse eid="DEU 28:18" /></para>
  <para style="pm">
    <verse number="19" style="v" sid="DEU 28:19" />మీరు లోపలికి వచ్చినప్పుడు శపించబడతారు, బయటకు వెళ్లినప్పుడు శపించబడతారు.<verse eid="DEU 28:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 28:20" />మీరు ఆయనను విడిచిపెట్టి చేసిన చెడు కారణంగా, అకస్మాత్తుగా నాశనమయ్యే వరకు, యెహోవా మీరు చేయి వేసిన ప్రతి దాని మీదికి శాపాలు, నిరాశను, నిరుత్సాహాన్ని పంపుతారు. <verse eid="DEU 28:20" /><verse number="21" style="v" sid="DEU 28:21" />మీరు స్వాధీనపరచుకోడానికి ప్రవేశిస్తున్న దేశంలో ఉండకుండ మిమ్మల్ని నాశనం చేసే వరకు యెహోవా మిమ్మల్ని రోగాలతో తెగులుతో బాధిస్తారు. <verse eid="DEU 28:21" /><verse number="22" style="v" sid="DEU 28:22" />యెహోవా వ్యాధితో, జ్వరం, వాపు, తీవ్రమైన వేడి, ఖడ్గంతో,<note caller="+" style="f"><char style="fr" closed="false">28:22 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">కరువుతో</char></note> ముడత, బూజుతో మీమీద దాడి చేస్తారు, మీరు నశించే వరకు ఇది తెగులుగా మిమ్మల్ని వేధిస్తుంది. <verse eid="DEU 28:22" /><verse number="23" style="v" sid="DEU 28:23" />మీ తలమీద ఆకాశం ఇత్తడిలా మీ క్రింద నేల ఇనుములా ఉంటాయి. <verse eid="DEU 28:23" /><verse number="24" style="v" sid="DEU 28:24" />యెహోవా మీ దేశపు వర్షాన్ని దుమ్ము, పొడిగా మారుస్తారు; మీరు నాశనం అయ్యేవరకు అది ఆకాశాల నుండి దిగి వస్తుంది.<verse eid="DEU 28:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 28:25" />మీ శత్రువుల చేతిలో యెహోవా మిమ్మల్ని ఓడిపోయేలా చేస్తారు.మీరు వారి దగ్గరకు ఒకవైపు నుండి వస్తారు, కాని వారి నుండి ఏడు వైపుల్లో పారిపోతారు. మీరంటే అన్ని రాజ్యాలకు భయం కలుగుతుంది. <verse eid="DEU 28:25" /><verse number="26" style="v" sid="DEU 28:26" />మీ కళేబరాలు ఆకాశపక్షులకు అడవి మృగాలకు ఆహారమవుతాయి, వాటిని వెళ్లగొట్టే వారెవరూ ఉండరు. <verse eid="DEU 28:26" /><verse number="27" style="v" sid="DEU 28:27" />యెహోవా మిమ్మల్ని నయం కాలేని ఈజిప్టు కురుపులు, గడ్డలు, చీముపట్టిన పుండ్లు, దురదతో బాధిస్తారు. <verse eid="DEU 28:27" /><verse number="28" style="v" sid="DEU 28:28" />యెహోవా మిమ్మల్ని వెర్రితనంతో, గ్రుడ్డితనంతో, మానసిక ఆందోళనతో బాధిస్తారు. <verse eid="DEU 28:28" /><verse number="29" style="v" sid="DEU 28:29" />మధ్యాహ్న సమయంలో మీరు చీకటిలో గ్రుడ్డివానిలా తడుముకుంటారు. మీరు చేసే ప్రతీ పనిలో మీరు విఫలమవుతారు; రోజు రోజుకు మీరు అణచివేయబడతారు, దోచుకోబడతారు, మిమ్మల్ని రక్షించడానికి ఎవరూ ఉండరు.<verse eid="DEU 28:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="DEU 28:30" />మీకు ఒక స్త్రీతో పెళ్ళి నిశ్చయమవుతుంది, కానీ మరొకరు ఆమెను తీసుకెళ్లి పాడుచేస్తారు. మీరు ఇల్లు కట్టుకుంటారు, కానీ మీరు అందులో నివసించరు. మీరు ద్రాక్షతోటను నాటుతారు, కానీ మీరు దాని ఫలాలను తినరు. <verse eid="DEU 28:30" /><verse number="31" style="v" sid="DEU 28:31" />మీరు చూస్తూ ఉండగానే మీ ఎద్దు వధించబడుతుంది, కానీ మీరు దాంట్లో నుండి ఏమి తినరు. మీ గాడిద బలవంతంగా తీసుకెళ్తారు, మళ్ళీ మీకివ్వరు. మీ గొర్రెలు మేకలు శత్రువుల వశమవుతాయి, వాటిని ఎవ్వరూ రక్షించరు. <verse eid="DEU 28:31" /><verse number="32" style="v" sid="DEU 28:32" />మీ కుమారులు కుమార్తెలు వేరొక దేశానికి ఇవ్వబడతారు, దినదినం వారి కోసం ఎదురుచూసి మీ కళ్లు అలసిపోతాయి, చేయి ఎత్తడానికి కూడా శక్తి ఉండదు. <verse eid="DEU 28:32" /><verse number="33" style="v" sid="DEU 28:33" />మీకు తెలియని ప్రజలు మీ భూమి, మీ శ్రమ ఉత్పత్తి చేసే వాటిని తింటారు, మీ జీవితమంతా క్రూరమైన అణచివేత తప్ప మీకు ఏమీ ఉండదు. <verse eid="DEU 28:33" /><verse number="34" style="v" sid="DEU 28:34" />మీరు చూసే దృశ్యాలు మిమ్మల్ని పిచ్చివారిని చేస్తాయి. <verse eid="DEU 28:34" /><verse number="35" style="v" sid="DEU 28:35" />యెహోవా మీ మోకాళ్లను, కాళ్లను నయం చేయలేని బాధాకరమైన కురుపులతో బాధిస్తారు, అవి మీ అరికాళ్ల నుండి నడినెత్తి వరకు వ్యాపిస్తాయి.<verse eid="DEU 28:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="DEU 28:36" />మీకు, మీ పూర్వికులకు తెలియని దేశానికి యెహోవా మిమ్మల్ని మీరు నియమించుకున్న రాజును తోలివేస్తారు. అక్కడ మీరు ఇతర దేవుళ్ళు, చెక్క, రాతి దేవుళ్ళను సేవిస్తారు. <verse eid="DEU 28:36" /><verse number="37" style="v" sid="DEU 28:37" />యెహోవా మిమ్మల్ని నడిపించే ప్రజలందరి మధ్య మీరు భయానకమైన, ఒక సామెతగా హేళనకు కారణంగా మారతారు.<verse eid="DEU 28:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="DEU 28:38" />మీరు పొలంలో చాలా విత్తనాలు విత్తుతారు, కానీ మిడుతలు దాన్ని మ్రింగివేస్తాయి కాబట్టి మీరు కొద్దిగా పంట కోస్తారు. <verse eid="DEU 28:38" /><verse number="39" style="v" sid="DEU 28:39" />మీరు ద్రాక్షతోటలు నాటి వాటిని శ్రమపడి సేద్యం చేస్తారు కాని ద్రాక్షరసం త్రాగరు, ద్రాక్షపండ్లు ఏరుకోరు, కారణం పురుగులు వాటిని తినేస్తాయి. <verse eid="DEU 28:39" /><verse number="40" style="v" sid="DEU 28:40" />మీకు ఒలీవచెట్లు ఉంటాయి గాని మీరు నూనె వాడరు, ఎందుకంటే ఒలీవలు రాలిపోతాయి. <verse eid="DEU 28:40" /><verse number="41" style="v" sid="DEU 28:41" />మీకు కుమారులు, కుమార్తెలు ఉంటారు, కానీ వారు మీ దగ్గర ఉండరు, ఎందుకంటే వారు చెరలోకి వెళ్లిపోతారు. <verse eid="DEU 28:41" /><verse number="42" style="v" sid="DEU 28:42" />మీ చెట్లను మీ పొలం పంటలను మిడతల గుంపులు వచ్చి ఆక్రమించుకుంటాయి.<verse eid="DEU 28:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="DEU 28:43" />మీ మధ్య నివసించే విదేశీయులు మీకంటే అంతకంతకు పైకి ఎదుగుతారు, కానీ మీరు అంతకంతకు దిగజారిపోతారు. <verse eid="DEU 28:43" /><verse number="44" style="v" sid="DEU 28:44" />వారు మీకు అప్పిస్తారు గాని, మీరు వారికి అప్పు ఇవ్వరు. వారు తలగా ఉంటారు, మీరు తోకగా ఉంటారు.<verse eid="DEU 28:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="DEU 28:45" />ఈ శాపాలన్నీ మీ మీదికి వస్తాయి. మీరు నాశనమయ్యే వరకు వారు మిమ్మల్ని వెంటాడి, మిమ్మల్ని అధిగమిస్తారు, ఎందుకంటే మీరు మీ దేవుడైన యెహోవాకు విధేయత చూపలేదు, ఆయన మీకు ఇచ్చిన ఆజ్ఞలను, శాసనాలను మీరు పాటించలేదు. <verse eid="DEU 28:45" /><verse number="46" style="v" sid="DEU 28:46" />అవి మీకు, మీ వారసులకు ఎప్పటికీ సూచనలుగా ఆశ్చర్యం కలిగించేవిగా ఉంటాయి. <verse eid="DEU 28:46" /><verse number="47" style="v" sid="DEU 28:47" />ఎందుకంటే మీరు సమృద్ధి కలిగి ఉన్నప్పటికీ మీ దేవుడైన యెహోవాకు సంతోషంగా, ఆనందంగా సేవ చేయలేదు. <verse eid="DEU 28:47" /><verse number="48" style="v" sid="DEU 28:48" />అందువల్ల ఆకలి, దాహం, నగ్నత్వం, పేదరికంలో, యెహోవా మీకు వ్యతిరేకంగా పంపే శత్రువులకు మీరు సేవ చేస్తారు. మిమ్మల్ని నాశనం చేసే వరకు ఆయన మీ మెడ మీద ఇనుప కాడి మోపుతాడు.<verse eid="DEU 28:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="DEU 28:49" />యెహోవా మీకు వ్యతిరేకంగా దూర ప్రాంతాల నుండి, భూమి చివర్ల నుండి, ఒక గ్రద్ద దూసుకు వస్తున్నట్లుగా, మీకు అర్థం చేసుకోలేని భాష మాట్లాడే ఒక దేశాన్ని తెస్తారు. <verse eid="DEU 28:49" /><verse number="50" style="v" sid="DEU 28:50" />అది వృద్ధుల పట్ల గౌరవం గాని చిన్నవారి పట్ల జాలి గాని లేని క్రూరంగా కనిపించే దేశము. <verse eid="DEU 28:50" /><verse number="51" style="v" sid="DEU 28:51" />మీరు నాశనమయ్యే వరకు వారు మీ పశువుల పిల్లలను, మీ భూమిలోని పంటలను మ్రింగివేస్తారు. మీరు నాశనమయ్యే వరకు వారు మీకు ధాన్యం గాని, క్రొత్త ద్రాక్షరసం గాని, ఒలీవనూనె గాని, మీ పశువుల దూడలను గాని, మీ మందల గొర్రెపిల్లలను వదిలిపెట్టరు. <verse eid="DEU 28:51" /><verse number="52" style="v" sid="DEU 28:52" />మీరు నమ్మే ఎత్తైన కోటగోడలు కూలిపోయే వరకు వారు మీ దేశంలోని అన్ని పట్టణాలను ముట్టడిస్తారు. మీ దేవుడైన యెహోవా మీకు ఇస్తున్న దేశంలోని అన్ని పట్టణాలను వారు ముట్టడిస్తారు.<verse eid="DEU 28:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="DEU 28:53" />ముట్టడి సమయంలో మీ శత్రువు మీకు కలిగించే బాధల కారణంగా, మీ దేవుడైన యెహోవా మీకు ఇచ్చిన గర్భఫలం, కుమారులు కుమార్తెల మాంసాన్ని మీరు తింటారు. <verse eid="DEU 28:53" /><verse number="54" style="v" sid="DEU 28:54" />మీలో అత్యంత సౌమ్యుడైన, సున్నితమైన పురుషునికి కూడా తన సొంత సోదరునిపై గాని లేదా తాను ప్రేమించే భార్యపై గాని లేదా మిగిలి ఉన్న పిల్లలపై గాని కనికరం ఉండదు. <verse eid="DEU 28:54" /><verse number="55" style="v" sid="DEU 28:55" />అతడు తినే తన పిల్లల మాంసంలో కొంచెమైనా అతడు వారికి ఇవ్వడు. ఎందుకంటే మీ పట్టణాలన్ని ముట్టడి చేయబడిన సమయంలో మీ శత్రువు మీకు కలిగించిన బాధను బట్టి అతనికి మిగిలింది అదే. <verse eid="DEU 28:55" /><verse number="56" style="v" sid="DEU 28:56" />మీలో అత్యంత సౌమ్యమైన సున్నితమైన స్త్రీ తన పాదం కూడా నేలమీద మోపే సాహసం చేయని స్త్రీ తాను ప్రేమించిన భర్తను, తన సొంత కుమారుడు లేదా కుమార్తెను వేధిస్తుంది. <verse eid="DEU 28:56" /><verse number="57" style="v" sid="DEU 28:57" />మీ పట్టణాలు ముట్టడి చేయబడిన సమయంలో మీ శత్రువు మిమ్మల్ని పెట్టే బాధను బట్టి ఆమె వేరే దారి లేక ఆమె గర్భం నుండి స్రవించే మావిని, కనిన పిల్లలను రహస్యంగా తినాలని అనుకుంటుంది.<verse eid="DEU 28:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="DEU 28:58" />ఈ గ్రంథంలో వ్రాసి ఉన్న ధర్మశాస్త్ర మాటలన్నిటిని ఒకవేళ మీరు జాగ్రత్తగా పాటించక, మీ దేవుడైన యెహోవా మహిమగల అద్భుతమైన నామానికి మీరు భయపడకపోతే, <verse eid="DEU 28:58" /><verse number="59" style="v" sid="DEU 28:59" />యెహోవా మీకు, మీ వారసులకు భయంకరమైన తెగుళ్ళు, కఠినమైన, సుదీర్ఘమైన విపత్తులు, తీవ్రమైన, దీర్ఘకాలిక అనారోగ్యాలను పంపుతారు. <verse eid="DEU 28:59" /><verse number="60" style="v" sid="DEU 28:60" />మీరు భయపడే ఈజిప్టు వ్యాధులన్నిటిని ఆయన మీ మీదికి తెస్తారు, అవి మిమ్మల్ని అంటిపెట్టుకుని ఉంటాయి. <verse eid="DEU 28:60" /><verse number="61" style="v" sid="DEU 28:61" />మీరు నాశనం అయ్యేవరకు ఈ ధర్మశాస్త్ర పుస్తకంలో నమోదు చేయబడని ప్రతి విధమైన రోగాన్ని, విపత్తును కూడా యెహోవా మీపైకి తెస్తారు. <verse eid="DEU 28:61" /><verse number="62" style="v" sid="DEU 28:62" />ఆకాశంలోని నక్షత్రాల్లా అనేకమైన మీరు కొద్దిమంది మాత్రమే మిగిలి ఉంటారు, ఎందుకంటే మీరు మీ దేవుడైన యెహోవాకు లోబడలేదు. <verse eid="DEU 28:62" /><verse number="63" style="v" sid="DEU 28:63" />మీరు వృద్ధి చెందడం, సంఖ్య పెరగడం యెహోవాకు ఎంత సంతోషాన్ని కలిగించిందో, మిమ్మల్ని పతనం చేయడం, నాశనం చేయడం కూడా ఆయనను అంతే సంతోషపరుస్తుంది. మీరు స్వాధీనం చేసుకోవడానికి ప్రవేశిస్తున్న దేశం నుండి మీరు పెరికివేయబడతారు.<verse eid="DEU 28:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="DEU 28:64" />అప్పుడు యెహోవా భూమి యొక్క ఒక చివర నుండి మరొక చివర వరకు అన్ని దేశాల మధ్య మిమ్మల్ని చెదరగొడతారు. అక్కడ మీరు ఇతర దేవుళ్ళను మీకు గాని మీ పూర్వికులకు గాని తెలియని చెక్కతో రాతితో చేయబడిన దేవుళ్ళను సేవిస్తారు. <verse eid="DEU 28:64" /><verse number="65" style="v" sid="DEU 28:65" />ఆ దేశాల్లో మీకు విశ్రాంతి దొరకదు, మీ అరికాలుకు కూడా విశ్రాంతి స్థలం ఉండదు. అక్కడ యెహోవా మీకు మనోవేదన, ఎదురుచూపులతో మసకబారిన కళ్లను, కలవరపడుతున్న హృదయాన్ని ఇస్తారు. <verse eid="DEU 28:65" /><verse number="66" style="v" sid="DEU 28:66" />మీరు రాత్రి, పగలు దిగులుతో నిండుకొని, ఎప్పుడూ ప్రాణభయంతో జీవిస్తారు, మీరు బ్రతుకుతారన్న నమ్మకం మీకు ఉండదు. <verse eid="DEU 28:66" /><verse number="67" style="v" sid="DEU 28:67" />ఎందుకంటే మీ హృదయాలను నింపే భయం మీ కళ్లు చూసే దృశ్యాలను బట్టి మీరు ఉదయాన, “ఒకవేళ ఇది సాయంత్రం అయితే బాగుండు!” అని సాయంత్రం, “ఒకవేళ ఇది ఉదయం అయితే బాగుండు!” అని అంటారు. <verse eid="DEU 28:67" /><verse number="68" style="v" sid="DEU 28:68" />మీరు మళ్ళీ ఎన్నడూ ఈజిప్టుకు ప్రయాణం చేయకూడదని నేను చెప్పిన ఈజిప్టుకు యెహోవా మిమ్మల్ని ఓడలలో తిరిగి పంపుతారు. అక్కడ మీరు మగ, ఆడ బానిసలుగా మీ శత్రువులకు మిమ్మల్ని మీరు అమ్మకానికి పెట్టుకుంటారు, కానీ ఎవరూ మిమ్మల్ని కొనరు.<verse eid="DEU 28:68" /></para>
  <chapter eid="DEU 28" />
  <chapter number="29" style="c" sid="DEU 29" />
  <para style="s1">ఒడంబడిక షరతులు</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 29:1" />యెహోవా హోరేబులో ఇశ్రాయేలీయులతో చేసిన ఒడంబడికతో పాటు, మోయాబు దేశంలో వారితో మరో ఒడంబడిక చేయమని ఆయన మోషేకు ఆజ్ఞాపించిన ఒడంబడిక షరతులు.<verse eid="DEU 29:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="DEU 29:2" />మోషే ఇశ్రాయేలీయులందరిని పిలిపించి, వారితో ఇలా అన్నాడు:</para>
  <para style="b" vid="DEU 29:2" />
  <para style="p" vid="DEU 29:2">యెహోవా ఈజిప్టులో ఫరోకు అతని అధికారులందరికి, అతని దేశమంతటికి చేసింది మీ కళ్లు చూశాయి. <verse eid="DEU 29:2" /><verse number="3" style="v" sid="DEU 29:3" />మీ కళ్లతో మీరు ఆ గొప్ప పరీక్షలను, ఆ అసాధారణ గుర్తులను, గొప్ప అద్భుతాలను చూశారు. <verse eid="DEU 29:3" /><verse number="4" style="v" sid="DEU 29:4" />అయినా నేటి వరకు గ్రహించే మనస్సును గాని, చూసే కళ్లను గాని, వినే చెవులను గాని యెహోవా మీకు ఇవ్వలేదు. <verse eid="DEU 29:4" /><verse number="5" style="v" sid="DEU 29:5" />అయినప్పటికీ యెహోవా అంటున్నారు, “నేను మిమ్మల్ని అరణ్యంలో నడిపించిన నలభై సంవత్సరాల్లో, మీ బట్టలు గాని, కాళ్ల చెప్పులు గాని పాతగిల్లలేదు. <verse eid="DEU 29:5" /><verse number="6" style="v" sid="DEU 29:6" />మీరు రొట్టెలు తినలేదు ద్రాక్షరసం గాని మద్యం గాని త్రాగలేదు. నేనే మీ దేవుడనైన యెహోవానని మీరు తెలుసుకుంటారని ఇలా చేశాను.”<verse eid="DEU 29:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 29:7" />మీరిక్కడికి వచ్చినప్పుడు హెష్బోను రాజు సీహోను, బాషాను రాజు ఓగు మనతో పోరాడడానికి వచ్చారు, కాని మనం వారిని ఓడించాము. <verse eid="DEU 29:7" /><verse number="8" style="v" sid="DEU 29:8" />మనం వారి దేశాన్ని స్వాధీనపరచుకుని రూబేనీయులకు, గాదీయులకు, మనష్షే అర్థగోత్రానికి వారసత్వంగా దాన్ని ఇచ్చాము.<verse eid="DEU 29:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 29:9" />ఈ ఒడంబడిక షరతులను జాగ్రత్తగా పాటించాలి, తద్వార మీరు చేసేవాటన్నిటిలో మీరు వృద్ధిచెందుతారు. <verse eid="DEU 29:9" /><verse number="10-13" style="v" sid="DEU 29:10-13" />మీ దేవుడైన యెహోవా మీతో చెప్పిన ప్రకారం మీ పితరులైన అబ్రాహాము ఇస్సాకు యాకోబులతో ప్రమాణము చేసిన ప్రకారం, నేడు మిమ్మల్ని తనకు ప్రజలుగా నియమించుకొని తానే మీకు దేవుడైయుండేలా మీ దేవుడైన యెహోవా నేడు మీకు నియమిస్తున్న మీ దేవుడైన యెహోవా నిబంధనలోను ఆయన ప్రమాణంలోను మీరు ఈ రోజున మీరంతా అనగా మీ నాయకులు, ముఖ్య పురుషులు, మీ పెద్దలు, అధికారులు, ఇశ్రాయేలీయులలో ఇతర పురుషులందరు, మీ పిల్లలు, మీ భార్యలు, మీ పాళెంలో నివసిస్తున్న విదేశీయులు, మీ కట్టెలను నరికేవారు, మీ నీటిని తోడేవారు, అందరు నేడు మీ దేవుడైన యెహోవాతో ఒక ఒడంబడికలోకి ప్రవేశించడానికి ఇక్కడ నిలబడి ఉన్నారు, ఈ రోజు యెహోవా ప్రమాణం చేయడం ద్వారా, ఈ రోజు మిమ్మల్ని తన ప్రజలుగా నియమించుకొని, ఆయన మీకు వాగ్దానం చేసినట్లుగా మీ తండ్రులైన అబ్రాహాము, ఇస్సాకు, యాకోబుతో ప్రమాణం చేసినట్లుగా మీ దేవునిగా ఉంటారు. <verse eid="DEU 29:10-13" /><verse number="14" style="v" sid="DEU 29:14" />నేను ఈ ఒడంబడిక ప్రమాణాన్ని మీతో మాత్రమే కాదు, మన దేవుడైన యెహోవా సన్నిధిలో మాతోపాటు నిలబడి ఉన్నవారితో కూడా చేస్తున్నాను. <verse eid="DEU 29:14" /><verse number="15" style="v" sid="DEU 29:15" />మా దేవుడైన యెహోవా సన్నిధిలో ఈ రోజు మాతో పాటు నిలబడ్డ వారు కానీ ఈ రోజు ఇక్కడ లేని వారితో కూడా ఉన్నారు.<verse eid="DEU 29:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DEU 29:16" />మేము ఈజిప్టులో ఎలా జీవించామో, ఇక్కడి మార్గంలో దేశాల గుండా ఎలా వెళ్లామో మీకే తెలుసు. <verse eid="DEU 29:16" /><verse number="17" style="v" sid="DEU 29:17" />వాటిలో మీరు వారి అసహ్యకరమైన చిత్రాలు చెక్క రాతి, వెండి బంగారు విగ్రహాలను చూశారు. <verse eid="DEU 29:17" /><verse number="18" style="v" sid="DEU 29:18" />ఆ దేశాల దేవుళ్ళను సేవించడానికి వెళ్లి మన దేవుడైన యెహోవా నుండి తమ హృదయాన్ని మనస్సు ప్రక్కకు త్రిప్పుకున్న పురుషుడు గాని, స్త్రీ గాని, వంశం గాని గోత్రం గాని లేరనే విషయాన్ని నిర్ధారించుకోండి; అటువంటి చేదు విషాన్ని ఉత్పత్తి చేసే మూలం మీ మధ్యలో లేదనేది నిర్ధారించుకోండి.<verse eid="DEU 29:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 29:19" />అలాంటి వ్యక్తులు ఈ ప్రమాణం యొక్క మాటలు విన్నప్పుడు, వారు తమ మీదికి ఆశీర్వాదాన్ని ఆహ్వానించుకుంటూ, “నేను నా సొంత మార్గంలో వెళ్లాలని పట్టుదలతో ఉన్నప్పటికీ, నేను సమాధానం కలిగి ఉంటాను” అని అనుకుంటారు, వారు నీటితో తడపబడిన భూమిపైకి, అలాగే ఎండిన భూమిపైకి విపత్తును తెస్తారు. <verse eid="DEU 29:19" /><verse number="20" style="v" sid="DEU 29:20" />యెహోవా వారిని క్షమించడానికి ఎన్నటికీ ఇష్టపడరు; ఆయన కోపం, రోషం వారిపై భగ్గుమంటాయి. ఈ గ్రంథంలో వ్రాయబడిన శాపాలన్నీ వారి పైకి వస్తాయి, యెహోవా ఆకాశం క్రిందనుండి వారి పేర్లను తుడిచివేస్తారు. <verse eid="DEU 29:20" /><verse number="21" style="v" sid="DEU 29:21" />ఈ ధర్మశాస్త్ర గ్రంథంలో వ్రాయబడిన ఒడంబడిక యొక్క అన్ని శాపాల ప్రకారం, కీడు కలుగజేయడానికి యెహోవా వారిని ఇశ్రాయేలు యొక్క అన్ని గోత్రాల నుండి వేరు చేస్తారు.<verse eid="DEU 29:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 29:22" />తర్వాతి తరాలలో మిమ్మల్ని అనుసరించే మీ పిల్లలు, సుదూర దేశాల నుండి వచ్చిన విదేశీయులు, దేశంపై పడిన ఆపదలను, వ్యాధులను వేటితోనైతే యెహోవా దాన్ని బాధించారో చూస్తారు. <verse eid="DEU 29:22" /><verse number="23" style="v" sid="DEU 29:23" />దేశమంతా ఉప్పు, గంధకం చేత తగలబడుతున్న వ్యర్థంలా ఉంటుంది అనగా ఏదీ నాటబడదు, ఏదీ మొలకెత్తదు, దానిపై ఏ కూరగాయలు పెరగవు. ఈ నాశనం యెహోవా తీవ్ర కోపంతో పడగొట్టిన సొదొమ గొమొర్రా, అద్మా, సెబోయిము పట్టణాల నాశనంలా ఉంటుంది. <verse eid="DEU 29:23" /><verse number="24" style="v" sid="DEU 29:24" />దేశాలన్నీ, “ఈ దేశానికి యెహోవా ఎందుకు ఇలా చేశారు? ఎందుకు ఈ భయంకరమైన, మండుతున్న కోపం?” అని అడుగుతాయి.<verse eid="DEU 29:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DEU 29:25" />దానికి సమాధానం ఇలా ఉంటుంది: “ఈ ప్రజలు తమ పూర్వికుల దేవుడైన యెహోవా ఒడంబడికను, ఆయన వారిని ఈజిప్టు నుండి బయటకు తీసుకువచ్చినప్పుడు ఆయన వారితో చేసుకున్న ఒడంబడికను విడిచిపెట్టారు. <verse eid="DEU 29:25" /><verse number="26" style="v" sid="DEU 29:26" />వారు వెళ్లి ఇతర దేవుళ్ళను సేవించారు, వారికి నమస్కరించారు, వారు వారికి తెలియని దేవుళ్ళు, ఆయన వారికి ఇవ్వని దేవుళ్ళు. <verse eid="DEU 29:26" /><verse number="27" style="v" sid="DEU 29:27" />అందువల్ల ఆ దేశంపై యెహోవా కోపం భగ్గుమంది, అందుకే గ్రంథంలో వ్రాయబడి ఉన్న అన్ని శాపాలను ఆయన వారి పైకి తీసుకువచ్చారు. <verse eid="DEU 29:27" /><verse number="28" style="v" sid="DEU 29:28" />యెహోవా భీకరమైన కోపంలో, గొప్ప క్రోధంలో వారి దేశంలో నుండి వారిని పెకిలించి, ఇప్పుడున్నట్లుగా, వారిని వేరే దేశంలోకి నెట్టివేశారు.”<verse eid="DEU 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DEU 29:29" />రహస్య విషయాలు మన దేవుడైన యెహోవాకు చెందినవి, కానీ వెల్లడించబడిన విషయాలు మనకు మన పిల్లలకు ఎప్పటికీ ఉంటాయి, ఈ ధర్మశాస్త్రంలోని మాటలన్నిటినీ మనం పాటించాలి.<verse eid="DEU 29:29" /></para>
  <chapter eid="DEU 29" />
  <chapter number="30" style="c" sid="DEU 30" />
  <para style="s1">యెహోవా వైపుకు తిరిగిన తర్వాత కలిగే వృద్ధి</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 30:1" />నేను మీ ముందుంచిన ఈ దీవెనలు, శాపాలన్నీ మీ మీదికి వచ్చి, మీ దేవుడైన యెహోవా మిమ్మల్ని చెదరగొట్టిన దేశాల్లో మీరు వాటిని హృదయంలో భద్రం చేసుకుని, <verse eid="DEU 30:1" /><verse number="2" style="v" sid="DEU 30:2" />మీరు మీ పిల్లలు మీ దేవుడైన యెహోవా దగ్గరకు తిరిగివచ్చి, ఈ రోజు నేను మీకు ఆజ్ఞాపించే ప్రతీదాని ప్రకారం మీ పూర్ణహృదయంతో, మీ పూర్ణ ఆత్మతో ఆయనకు లోబడితే, <verse eid="DEU 30:2" /><verse number="3" style="v" sid="DEU 30:3" />మీ దేవుడైన యెహోవా మీ భాగ్యాలను పునరుద్ధరిస్తారు,<note caller="+" style="f"><char style="fr" closed="false">30:3 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">మిమ్మల్ని చెర నుండి తీసుకువస్తారు</char></note> మీపై కనికరం చూపించి ఆయన మిమ్మల్ని చెదరగొట్టిన అన్ని దేశాలన్నిటి నుండి మిమ్మల్ని మళ్ళీ సమకూరుస్తారు. <verse eid="DEU 30:3" /><verse number="4" style="v" sid="DEU 30:4" />మీరు ఆకాశం క్రింద అత్యంత సుదూర దేశానికి చెదరిపోయినప్పటికి, అక్కడినుండి మీ దేవుడైన యెహోవా మిమ్మల్ని సమకూర్చి తిరిగి తీసుకువస్తారు. <verse eid="DEU 30:4" /><verse number="5" style="v" sid="DEU 30:5" />మీ దేవుడైన యెహోవా మిమ్మల్ని మీ పూర్వికులకు చెందిన దేశానికి తీసుకువస్తారు. మీరు దాన్ని స్వాధీనం చేసుకుంటారు. మీ పూర్వికులకంటే ఆయన మిమ్మల్ని వృద్ధిలోను, సంఖ్యలోను అధికం చేస్తారు. <verse eid="DEU 30:5" /><verse number="6" style="v" sid="DEU 30:6" />మీ దేవుడైన యెహోవా మీ హృదయాలను, మీ సంతతివారి హృదయాలను సున్నతి చేస్తారు. అప్పుడు మీరు ఆయనను మీ పూర్ణ హృదయం, మీ పూర్ణ ఆత్మతో ప్రేమించి జీవిస్తారు. <verse eid="DEU 30:6" /><verse number="7" style="v" sid="DEU 30:7" />మీ దేవుడైన యెహోవా ఈ శాపాలన్నింటినీ మిమ్మల్ని ద్వేషించే, మిమ్మల్ని హింసించే మీ శత్రువులపైకి తెస్తారు. <verse eid="DEU 30:7" /><verse number="8" style="v" sid="DEU 30:8" />మీరు తిరిగివచ్చిన తర్వాత యెహోవాకు లోబడి ఆయన ఆజ్ఞలన్నిటిని పాటిస్తారు. <verse eid="DEU 30:8" /><verse number="9" style="v" sid="DEU 30:9" />అప్పుడు మీ దేవుడైన యెహోవా మీ చేతిపనులన్నిటిలోను మీ గర్భఫలాల్లో మీ పశువుల పిల్లల్లోను మీ భూమిలోని పంటల్లోను మిమ్మల్ని వర్ధిల్ల చేస్తారు. యెహోవా మీ పూర్వికుల విషయంలో సంతోషించి మిమ్మల్ని అభివృద్ధి చేస్తారు. <verse eid="DEU 30:9" /><verse number="10" style="v" sid="DEU 30:10" />అయితే, మీరు మీ దేవుడైన యెహోవాకు విధేయులై ఉండి, ఈ ధర్మశాస్త్రంలో వ్రాయబడిన ఆయన ఆజ్ఞలను శాసనాలను పాటించి మీ పూర్ణహృదయంతో మీ పూర్ణాత్మతో యెహోవా వైపు తిరగాలి.<verse eid="DEU 30:10" /></para>
  <para style="s1">మరణం కావాలా లేదా జీవం కావాలా</para>
  <para style="p">
    <verse number="11" style="v" sid="DEU 30:11" />నేను ఈ రోజున మీకిస్తున్న ఆజ్ఞ అంత కష్టమైందేమీ కాదు, ఇది మీరు అందుకోలేనిదీ కాదు. <verse eid="DEU 30:11" /><verse number="12" style="v" sid="DEU 30:12" />మీరు, “దానిని పొందడానికి పరలోకంలోకి ఎవరు ఎక్కి వెళ్లి, మేము దానిని పాటించేలా మాకు ఎవరు ప్రకటిస్తారు?” అని అడగడానికి ఇది పరలోకంలో లేదు. <verse eid="DEU 30:12" /><verse number="13" style="v" sid="DEU 30:13" />లేదా, “సముద్రాన్ని దాటి దాన్ని తెచ్చి, మేము దానిని పాటించేలా మాకు ఎవరు ప్రకటిస్తారు?” అని మీరు అడగడానికి అది సముద్రం అవతల లేదు. <verse eid="DEU 30:13" /><verse number="14" style="v" sid="DEU 30:14" />మీరు దానిని పాటించేలా ఆ వాక్యం మీకు చాలా దగ్గరగా ఉంది; అది మీ నోటిలో, మీ హృదయంలో ఉంది.<verse eid="DEU 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 30:15" />చూడండి, నేను ఈ రోజు జీవాన్ని వృద్ధిని, మరణాన్ని నాశనాన్ని మీ ముందు ఉంచాను. <verse eid="DEU 30:15" /><verse number="16" style="v" sid="DEU 30:16" />మీ దేవుడైన యెహోవాను ప్రేమించాలని, ఆయన మార్గంలో నడుచుకోవాలని, ఆయన ఆజ్ఞలు, శాసనాలు, చట్టాలను పాటించాలని నేను ఈ రోజు మీకు ఆజ్ఞాపిస్తున్నాను; అప్పుడు మీరు జీవిస్తారు, వృద్ధిచెందుతారు, మీరు స్వాధీనం చేసుకోవడానికి ప్రవేశించే దేశంలో మీ దేవుడైన యెహోవా మిమ్మల్ని ఆశీర్వదిస్తారు.<verse eid="DEU 30:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DEU 30:17" />కానీ ఒకవేళ మీ హృదయం మారి, మీరు విధేయత చూపకుండ ఇతర దేవుళ్ళకు నమస్కరించి వారిని సేవించడానికి ఆకర్షించబడితే, <verse eid="DEU 30:17" /><verse number="18" style="v" sid="DEU 30:18" />మీరు ఖచ్చితంగా నాశనం చేయబడతారని నేను ఈ రోజు మీకు ప్రకటిస్తున్నాను. మీరు ప్రవేశించి, స్వాధీనం చేసుకోవడానికి యొర్దాను దాటుతున్న దేశంలో మీరు ఎక్కువకాలం జీవించలేరు.<verse eid="DEU 30:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 30:19" />ఈ రోజు నేను మీ ముందు జీవాన్ని మరణాన్ని, దీవెనలు శాపాలను ఉంచి, ఆకాశాలను భూమిని మీకు మీద సాక్షులుగా పిలుస్తాను. ఇప్పుడు జీవాన్ని ఎంచుకోండి, అప్పుడు మీరు, మీ పిల్లలు బ్రతకవచ్చు. <verse eid="DEU 30:19" /><verse number="20" style="v" sid="DEU 30:20" />మీరు మీ దేవుడైన యెహోవాను ప్రేమించేలా, ఆయన స్వరాన్ని విని ఆయనను గట్టిగా పట్టుకోండి. ఎందుకంటే యెహోవాయే మీ జీవం; మీ పితరులైన అబ్రాహాము, ఇస్సాకు, యాకోబులకు ఇస్తానని ప్రమాణం చేసిన దేశంలో ఆయన మీకు దీర్ఘాయుష్షు ఇస్తారు.<verse eid="DEU 30:20" /></para>
  <chapter eid="DEU 30" />
  <chapter number="31" style="c" sid="DEU 31" />
  <para style="s1">మోషే తర్వాతి నాయకుడు యెహోషువ</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 31:1" />మోషే బయటకు వెళ్లి ఇశ్రాయేలీయులతో ఈ మాటలు చెప్పాడు: <verse eid="DEU 31:1" /><verse number="2" style="v" sid="DEU 31:2" />“నాకు ఇప్పుడు నూట ఇరవై సంవత్సరాలు, నేను ఇకపై మిమ్మల్ని నడిపించలేను. ‘నీవు యొర్దాను దాటవు’ అని యెహోవా నాకు చెప్పారు. <verse eid="DEU 31:2" /><verse number="3" style="v" sid="DEU 31:3" />మీ దేవుడైన యెహోవా స్వయంగా మీకు ముందుగా దాటి వెళ్లి మీ ముందు ఉండకుండ ఈ దేశాలను నాశనం చేస్తారు. మీరు వారి దేశాన్ని స్వాధీనం చేసుకుంటారు. యెహోవా చెప్పినట్టుగా, యెహోషువ కూడా మీకు ముందుగా దాటివెళ్తాడు. <verse eid="DEU 31:3" /><verse number="4" style="v" sid="DEU 31:4" />అమోరీయుల రాజులైన సీహోను, ఓగులను వారి దేశంతో పాటు నాశనం చేసినట్టుగా, యెహోవా వారికి చేస్తారు. <verse eid="DEU 31:4" /><verse number="5" style="v" sid="DEU 31:5" />యెహోవా వారిని మీకు అప్పగిస్తారు, నేను మీకు ఆజ్ఞాపించినవన్నీ మీరు వారికి చేయాలి. <verse eid="DEU 31:5" /><verse number="6" style="v" sid="DEU 31:6" />నిబ్బరంగా, ధైర్యంగా ఉండండి. వారికి మీరు భయపడవద్దు దిగులుపడవద్దు, ఎందుకంటే మీ దేవుడైన యెహోవా మీతో వెళ్తారు; ఆయన మిమ్మల్ని ఎన్నడూ వదిలేయరు, మీ చేయి విడువరు.”<verse eid="DEU 31:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 31:7" />తర్వాత మోషే యెహోషువను పిలిపించి, ఇశ్రాయేలీయులందరి సమక్షంలో అతనితో ఇలా అన్నాడు: “నిబ్బరంగా, ధైర్యంగా ఉండు, ఈ ప్రజలకు ఇస్తానని వారి పూర్వికులకు యెహోవా ప్రమాణం చేసిన దేశంలోకి నీవు ఈ ప్రజలతో పాటు వెళ్లి దానిని వారికి వారసత్వంగా ఇవ్వాలి. <verse eid="DEU 31:7" /><verse number="8" style="v" sid="DEU 31:8" />యెహోవాయే స్వయంగా మీ ముందు వెళ్తారు మీతో ఉంటారు; ఆయన నిన్ను ఎన్నడూ వదిలేయరు, నిన్ను చేయి విడువరు. భయపడవద్దు; నిరుత్సాహపడవద్దు.”<verse eid="DEU 31:8" /></para>
  <para style="s1">బహిరంగంగా ధర్మశాస్త్రాన్ని చదువుట</para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 31:9" />కాబట్టి మోషే ఈ ధర్మశాస్త్రాన్ని వ్రాసి, లేవీయులైన యాజకులకు అంటే యెహోవా నిబంధన మందసాన్ని మోసేవారికి, ఇశ్రాయేలీయుల పెద్దలందరికి ఇచ్చాడు. <verse eid="DEU 31:9" /><verse number="10" style="v" sid="DEU 31:10" />తర్వాత మోషే, “ప్రతి ఏడు సంవత్సరాల చివరిలో, అప్పులు రద్దు చేసే సంవత్సరంలో, గుడారాల పండుగ సమయంలో, <verse eid="DEU 31:10" /><verse number="11" style="v" sid="DEU 31:11" />ఇశ్రాయేలీయులందరు మీ దేవుడైన యెహోవా ఎదుట ఆయన ఎంచుకున్న స్థలంలో కనబడినప్పుడు, మీరు వారందరికి ఈ ధర్మశాస్త్రాన్ని చదివి వినిపించాలి. <verse eid="DEU 31:11" /><verse number="12" style="v" sid="DEU 31:12" />మీ పట్టణాల్లో నివసిస్తున్న పురుషులు, స్త్రీలు, పిల్లలు, విదేశీయులను సమకూర్చండి. అప్పుడు వారు విని మీ దేవుడైన యెహోవాకు భయపడటం, ఈ ధర్మశాస్త్రంలోని అన్ని మాటలను జాగ్రత్తగా పాటించడం నేర్చుకుంటారు. <verse eid="DEU 31:12" /><verse number="13" style="v" sid="DEU 31:13" />ఈ ధర్మశాస్త్రం తెలియని వారి పిల్లలు తప్పక విని, మీరు స్వాధీనం చేసుకోవడానికి యొర్దాను దాటి వెళ్లబోయే దేశంలో మీరు నివసించినంత కాలం మీ దేవుడైన యెహోవాకు భయపడటం నేర్చుకోవాలి.”<verse eid="DEU 31:13" /></para>
  <para style="s1">ఇశ్రాయేలీయుల తిరుగుబాటును గురించి ముందుగానే చెప్పబడుట</para>
  <para style="p">
    <verse number="14" style="v" sid="DEU 31:14" />ఆ తర్వాత యెహోవా మోషేతో, “నీవు చనిపోయే రోజు దగ్గరలో ఉంది. యెహోషువను పిలిచి, సమావేశ గుడారం దగ్గరకు రండి, అక్కడ నేను అతన్ని నియమిస్తాను” అని చెప్పారు. కాబట్టి మోషే, యెహోషువ వచ్చి సమావేశ గుడారం దగ్గర ఉన్నారు.<verse eid="DEU 31:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="DEU 31:15" />అప్పుడు యెహోవా గుడారం దగ్గర మేఘస్తంభంలో ప్రత్యక్షమయ్యారు, మేఘం గుడార ద్వారం మీద నిలిచింది. <verse eid="DEU 31:15" /><verse number="16" style="v" sid="DEU 31:16" />యెహోవా మోషేతో ఇలా అన్నారు, “నీవు నీ పూర్వికులతో విశ్రాంతి తీసుకోబోతున్నావు, ఈ ప్రజలు త్వరలో తాము ప్రవేశించే దేశంలోని పరదేశి దేవతలకు వేశ్యగా మారతారు. వారు నన్ను విడిచిపెట్టి నేను వారితో చేసుకున్న నిబంధనను ఉల్లంఘిస్తారు. <verse eid="DEU 31:16" /><verse number="17" style="v" sid="DEU 31:17" />ఆ రోజున నేను వారిపై కోప్పడి వారి చేయి విడిచిపెడతాను; నేను వారి నుండి నా ముఖాన్ని దాచుకుంటాను, వారు నాశనమవుతారు. అనేక విపత్తులు, ఆపదలు వారి పైకి వస్తాయి, ఆ రోజు వారు, ‘ఈ విపత్తులు మనపైకి రావడానికి కారణం మన దేవుడు మనతో లేకపోవడం కాదా?’ అని అనుకుంటారు. <verse eid="DEU 31:17" /><verse number="18" style="v" sid="DEU 31:18" />వారు ఇతర దేవుళ్ళ వైపు తిరిగి చేసిన దుష్టత్వాన్ని బట్టి నేను ఆ రోజు ఖచ్చితంగా నా ముఖాన్ని దాచుకుంటాను.<verse eid="DEU 31:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DEU 31:19" />“ఇప్పుడు ఈ పాటను వ్రాసి ఇశ్రాయేలీయులకు నేర్పించి వారితో పాడించండి, అది వారికి వ్యతిరేకంగా నాకు సాక్ష్యంగా ఉంటుంది. <verse eid="DEU 31:19" /><verse number="20" style="v" sid="DEU 31:20" />నేను వారి పూర్వికులకు ప్రమాణం చేసిన ప్రకారం వారిని పాలు తేనెలు ప్రవహించే దేశంలోకి తీసుకువచ్చినప్పుడు, వారు తృప్తిగా తిని లావెక్కినప్పుడు, వారు ఇతర దేవుళ్ళ వైపు తిరిగి వాటిని సేవించి, నన్ను తిరస్కరిస్తూ, నా నిబంధనను ఉల్లంఘిస్తారు. <verse eid="DEU 31:20" /><verse number="21" style="v" sid="DEU 31:21" />వారి మీదికి అనేక విపత్తులు, ఆపదలు వచ్చి పడతాయి. ఈ అనుభవాలకు సాక్ష్యంగా ఈ పాట పాడుకుంటారు. దీన్ని వారి సంతతివారు ఎన్నడూ మరచిపోరు. ప్రమాణం చేసిన వాగ్దాన దేశంలో నేను ఇంకా వారిని తీసుకురాకముందే, ఈ రోజే వారేం ఆలోచన చేస్తున్నారో నాకు తెలుసు.” <verse eid="DEU 31:21" /><verse number="22" style="v" sid="DEU 31:22" />కాబట్టి మోషే ఆ రోజు ఈ పాటను వ్రాసి ఇశ్రాయేలీయులకు నేర్పించాడు.<verse eid="DEU 31:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 31:23" />యెహోవా నూను కుమారుడైన యెహోషువకు ఈ ఆజ్ఞ ఇచ్చారు: “నిబ్బరంగా, ధైర్యంగా ఉండు, ఎందుకంటే నేను ఇశ్రాయేలీయులకు ప్రమాణంతో వాగ్దానం చేసిన దేశంలోకి నీవు వారిని తీసుకువస్తావు, నేను నీతో ఉంటాను.”<verse eid="DEU 31:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DEU 31:24" />మోషే ఈ ధర్మశాస్త్రం యొక్క మాటలన్నీ మొదటి నుండి చివరి వరకు ఒక గ్రంథంలో వ్రాయడం పూర్తి చేశాక, <verse eid="DEU 31:24" /><verse number="25" style="v" sid="DEU 31:25" />యెహోవా నిబంధన మందసాన్ని మోసే లేవీయులకు మోషే ఇలా ఆజ్ఞాపించాడు: <verse eid="DEU 31:25" /><verse number="26" style="v" sid="DEU 31:26" />“ఈ ధర్మశాస్త్ర గ్రంథాన్ని తీసుకుని మీ దేవుడైన యెహోవా నిబంధన మందసం ప్రక్కన ఉంచండి. అది మీమీద సాక్షిగా ఉంటుంది. <verse eid="DEU 31:26" /><verse number="27" style="v" sid="DEU 31:27" />ఎందుకంటే మీ తిరుగుబాటుతనం, మొండితనం నాకు తెలుసు. నేను ఇంకా మీతో బ్రతికి ఉన్నప్పుడే మీరు యెహోవాపై తిరుగుబాటు చేస్తే, నేను చనిపోయిన తర్వాత మీరు ఇంకెంత ఎక్కువ తిరుగుబాటు చేస్తారు కదా! <verse eid="DEU 31:27" /><verse number="28" style="v" sid="DEU 31:28" />గోత్ర పెద్దలందరినీ, మీ అధికారులందరినీ సమావేశపరచండి. ఆకాశాన్ని భూమిని వారి మీద సాక్షులుగా ఉంచి వారు వింటుండగా నేను మాట్లాడతాను. <verse eid="DEU 31:28" /><verse number="29" style="v" sid="DEU 31:29" />ఎందుకంటే నేను చనిపోయాక మీరు పూర్తిగా అవినీతిపరులై నేను ఆజ్ఞాపించిన మార్గం నుండి మీరు తొలగిపోతారని నాకు తెలుసు. రాబోయే రోజుల్లో, మీరు యెహోవా దృష్టికి చెడు చేసి, మీ చేతులు చేసిన వాటి వల్ల ఆయనకు కోపం పుట్టిస్తారు కాబట్టి రాబోయే రోజుల్లో విపత్తు మీ మీదికి వస్తుంది.”<verse eid="DEU 31:29" /></para>
  <para style="s1">మోషే పాట</para>
  <para style="p">
    <verse number="30" style="v" sid="DEU 31:30" />ఇశ్రాయేలు సమాజమంతా వింటుండగా మోషే ఈ పాటలోని పదాలను మొదటి నుండి చివరి వరకు పూర్తిగా చదివాడు:<verse eid="DEU 31:30" /></para>
  <chapter eid="DEU 31" />
  <chapter number="32" style="c" sid="DEU 32" />
  <para style="q1">
    <verse number="1" style="v" sid="DEU 32:1" />ఆకాశాల్లారా, ఆలకించండి, నేను మాట్లాడతాను;</para>
  <para style="q2" vid="DEU 32:1">భూమీ, నా నోటి మాటలు విను.<verse eid="DEU 32:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="DEU 32:2" />నా ఉపదేశం వర్షంలా కురుస్తుంది</para>
  <para style="q2" vid="DEU 32:2">నా మాటలు మంచు బిందువుల్లా దిగుతాయి,</para>
  <para style="q1" vid="DEU 32:2">లేతగడ్డి మీద జల్లులా,</para>
  <para style="q2" vid="DEU 32:2">లేత మొక్కల మీద సమృద్ధి వర్షంలా ఉంటుంది.<verse eid="DEU 32:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="DEU 32:3" />నేను యెహోవా నామాన్ని ప్రకటిస్తాను.</para>
  <para style="q2" vid="DEU 32:3">మన దేవుని గొప్పతనాన్ని స్తుతించండి!<verse eid="DEU 32:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="DEU 32:4" />ఆయన మనకు ఆశ్రయదుర్గం, ఆయన పనులు పరిపూర్ణం,</para>
  <para style="q2" vid="DEU 32:4">ఆయన మార్గాలన్నీ న్యాయమైనవి.</para>
  <para style="q1" vid="DEU 32:4">ఆయన తప్పుచేయని నమ్మదగిన దేవుడు,</para>
  <para style="q2" vid="DEU 32:4">ఆయన యథార్థవంతుడు న్యాయవంతుడు.<verse eid="DEU 32:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="DEU 32:5" />ఆయన ప్రజలు అవినీతిపరులు, వారు ఆయన పిల్లలు కారు;</para>
  <para style="q2" vid="DEU 32:5">వారి అవమానం పొందిన మూర్ఖులైన వక్ర తరం వారు.<verse eid="DEU 32:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="DEU 32:6" />అవివేకులైన తెలివితక్కువ ప్రజలారా,</para>
  <para style="q2" vid="DEU 32:6">యెహోవాకు మీరు తిరిగి చెల్లించే విధానం ఇదేనా?</para>
  <para style="q1" vid="DEU 32:6">మిమ్మల్ని చేసిన, మిమ్మల్ని రూపించిన,</para>
  <para style="q2" vid="DEU 32:6">మీ తండ్రి, మీ సృష్టికర్త ఆయన కాడా?<verse eid="DEU 32:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="DEU 32:7" />పాత రోజులను జ్ఞాపకముంచుకోండి;</para>
  <para style="q2" vid="DEU 32:7">గత తరాలను గురించి ఆలోచించండి.</para>
  <para style="q1" vid="DEU 32:7">తండ్రిని అడగండి, ఆయనే మీకు చెప్తారు,</para>
  <para style="q2" vid="DEU 32:7">మీ పెద్దలను అడగండి, వారే మీకు వివరిస్తారు.<verse eid="DEU 32:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="DEU 32:8" />మహోన్నతుడు జనాంగాలకు వారి వారి వారసత్వాలను ఇచ్చినప్పుడు,</para>
  <para style="q2" vid="DEU 32:8">సర్వ మనుష్యజాతిని విభజించినప్పుడు,</para>
  <para style="q1" vid="DEU 32:8">ఇశ్రాయేలు కుమారుల సంఖ్య ప్రకారం</para>
  <para style="q2" vid="DEU 32:8">జనములకు ఆయన సరిహద్దులు ఏర్పరిచారు.<verse eid="DEU 32:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="DEU 32:9" />యెహోవా ప్రజలే ఆయన భాగం,</para>
  <para style="q2" vid="DEU 32:9">యాకోబు ఆయనకు కేటాయించబడిన వారసత్వము.<verse eid="DEU 32:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10-11" style="v" sid="DEU 32:10-11" />ఆయన అతన్ని ఎడారి ప్రదేశంలో,</para>
  <para style="q2" vid="DEU 32:10-11">శబ్దాలు వినబడే బంజరు భూమిలో కనుగొన్నారు.</para>
  <para style="q1" vid="DEU 32:10-11">తన గూడును కదిలించి,</para>
  <para style="q2" vid="DEU 32:10-11">తన పిల్లల పైగా అల్లాడుతూ ఉండే,</para>
  <para style="q1" vid="DEU 32:10-11">వాటిని పైకి తీసుకెళ్లడానికి దాని రెక్కలు చాపి</para>
  <para style="q2" vid="DEU 32:10-11">వాటిని పైకి మోసుకెళ్లే గ్రద్దలా,</para>
  <para style="q1" vid="DEU 32:10-11">ఆయన అతన్ని చుట్టూ ఆవరించి సంరక్షిస్తూ,</para>
  <para style="q2" vid="DEU 32:10-11">తన కనుపాపలా ఆయన అతన్ని కాపాడారు.<verse eid="DEU 32:10-11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="DEU 32:12" />యెహోవా ఒక్కడే అతన్ని నడిపించారు;</para>
  <para style="q2" vid="DEU 32:12">ఏ ఇతర దేవుడు అతనితో ఉండలేదు.<verse eid="DEU 32:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="DEU 32:13" />ఆయన అతన్ని ఎత్తైన స్థలాలపైకి ఎక్కించారు</para>
  <para style="q2" vid="DEU 32:13">పొలాల పంటను అతనికి తినిపించారు.</para>
  <para style="q1" vid="DEU 32:13">బండ నుండి తీసిన తేనెతో,</para>
  <para style="q2" vid="DEU 32:13">రాళ్లమయమైన పర్వత శిఖరం నుండి తీసిన నూనెతో అతన్ని పోషించారు,<verse eid="DEU 32:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="DEU 32:14" />ఆవు పెరుగును, గొర్రెల, మేకల పాలను, గొర్రెపిల్లల క్రొవ్వును,</para>
  <para style="q2" vid="DEU 32:14">మేకపోతులను, పశువుల మంద, గొర్రెల మంద నుండి పెరుగు, పాలతో</para>
  <para style="q2" vid="DEU 32:14">క్రొవ్విన గొర్రెపిల్లలను, మేకలను,</para>
  <para style="q1" vid="DEU 32:14">బాషాను శ్రేష్ఠమైన పొట్టేళ్లను</para>
  <para style="q2" vid="DEU 32:14">నాణ్యమైన గోధుమలను మీకిచ్చారు.</para>
  <para style="q1" vid="DEU 32:14">మీరు ద్రాక్షరసంతో చేసిన మద్యాన్ని త్రాగారు.<verse eid="DEU 32:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="DEU 32:15" />యెషూరూను<note caller="+" style="f"><char style="fr" closed="false">32:15 </char><char style="fq" closed="false">యెషూరూను </char><char style="ft" closed="false">అర్థం </char><char style="fqa" closed="false">యథార్థవంతులు </char><char style="ft" closed="false">అంటే, ఇశ్రాయేలు.</char></note> క్రొవ్వుపట్టి కాలు జాడించాడు;</para>
  <para style="q2" vid="DEU 32:15">తిండి ఎక్కువై, వారు బలిసి మొద్దులయ్యారు.</para>
  <para style="q1" vid="DEU 32:15">వారు తమను చేసిన దేవున్ని విసర్జించి</para>
  <para style="q2" vid="DEU 32:15">రక్షకుడైన తమ ఆశ్రయ దుర్గాన్ని తృణీకరించారు.<verse eid="DEU 32:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="DEU 32:16" />వారు ఇతర దేవుళ్ళ వల్ల ఆయనకు రోషం పుట్టించారు,</para>
  <para style="q2" vid="DEU 32:16">వారి అసహ్యకరమైన విగ్రహాలతో ఆయనకు కోపం కలిగించారు.<verse eid="DEU 32:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="DEU 32:17" />దేవుడు కాని దయ్యాలకు వారు బలులర్పించారు</para>
  <para style="q2" vid="DEU 32:17">తమకు తెలియని దేవుళ్ళకు,</para>
  <para style="q2" vid="DEU 32:17">క్రొత్తగా వచ్చిన దేవుళ్ళకు,</para>
  <para style="q2" vid="DEU 32:17">మీ పూర్వికులు లెక్కచెయ్యని దేవుళ్ళకు మ్రొక్కారు.<verse eid="DEU 32:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="DEU 32:18" />మీకు తండ్రిగా ఉన్న ఆశ్రయ దుర్గాన్ని మీరు విడిచిపెట్టారు;</para>
  <para style="q2" vid="DEU 32:18">మీకు జన్మనిచ్చిన దేవుని మీరు మరచిపోయారు.<verse eid="DEU 32:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="DEU 32:19" />యెహోవా ఇది చూసి వారిని తృణీకరించారు,</para>
  <para style="q2" vid="DEU 32:19">ఎందుకంటే ఆయన తన కుమారులు కుమార్తెల వల్ల కోప్పడ్డారు.<verse eid="DEU 32:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="DEU 32:20" />“నేను వారి నుండి నా ముఖాన్ని దాచుకుంటాను,</para>
  <para style="q2" vid="DEU 32:20">వారి అంతం ఎలా ఉంటుందో చూస్తాను;</para>
  <para style="q1" vid="DEU 32:20">ఎందుకంటే వారొక దుర్బుద్ధి కలిగిన తరం,</para>
  <para style="q2" vid="DEU 32:20">నమ్మకద్రోహులైన పిల్లలు.<verse eid="DEU 32:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="DEU 32:21" />దేవుడు కాని దానితో వారు నాకు రోషం పుట్టించారు,</para>
  <para style="q2" vid="DEU 32:21">అయోగ్యమైన విగ్రహాలతో నాకు కోపం తెప్పించారు.</para>
  <para style="q1" vid="DEU 32:21">జనులు<note caller="+" style="f"><char style="fr" closed="false">32:21 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">బలహీనులైన జనులు</char></note> కాని వారిని చూసి వారు అసూయపడేలా చేస్తాను;</para>
  <para style="q2" vid="DEU 32:21">తెలివిలేని జనులను చూసి వారికి కోపం వచ్చేలా చేస్తాను.<verse eid="DEU 32:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="DEU 32:22" />ఎందుకంటే నా ఉగ్రత అగ్నిలా రగులుకుంటుంది,</para>
  <para style="q2" vid="DEU 32:22">పాతాళం వరకు అది మండుతుంది.</para>
  <para style="q1" vid="DEU 32:22">అది భూమిని దాని పంటను మ్రింగివేస్తుంది</para>
  <para style="q2" vid="DEU 32:22">పర్వతాల పునాదులకు నిప్పు పెడుతుంది.<verse eid="DEU 32:22" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="23" style="v" sid="DEU 32:23" />“నేను ఆపదలను వారిపై కుప్పగా చేస్తాను,</para>
  <para style="q2" vid="DEU 32:23">నా బాణాలను వారి మీదికి వేస్తాను.<verse eid="DEU 32:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="DEU 32:24" />నేను వారి మీదికి తీవ్రమైన కరువును పంపుతాను,</para>
  <para style="q2" vid="DEU 32:24">తీవ్ర జ్వరం, మరణకరమైన తెగులు వారిని వేధిస్తాయి,</para>
  <para style="q1" vid="DEU 32:24">నేను అడవి మృగాల కోరలను,</para>
  <para style="q2" vid="DEU 32:24">దుమ్ములో ప్రాకే ప్రాణుల విషాన్ని నేను వారి మీదికి పంపుతాను.<verse eid="DEU 32:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="DEU 32:25" />బయట ఖడ్గం వారిని సంతానం లేనివారినిగా చేస్తుంది;</para>
  <para style="q2" vid="DEU 32:25">వారి ఇళ్ళలో భయం పరిపాలిస్తుంది,</para>
  <para style="q1" vid="DEU 32:25">యువతీ యువకులు, నశిస్తారు</para>
  <para style="q2" vid="DEU 32:25">శిశువులు, తల నెరసినవారు నశిస్తారు.<verse eid="DEU 32:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="DEU 32:26" />నేను వారిని చెదరగొడతాను,</para>
  <para style="q2" vid="DEU 32:26">మానవ జ్ఞాపకంలో నుండి వారి పేరును తుడిచివేస్తాను.<verse eid="DEU 32:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="DEU 32:27" />కాని వారి శత్రువులు తప్పుగా అర్థం చేసుకుని,</para>
  <para style="q2" vid="DEU 32:27">‘ఇదంతా యెహోవా చేసినది కాదు,</para>
  <para style="q1" vid="DEU 32:27">మా బలంతోనే గెలిచాం’ అని అంటారేమోనని</para>
  <para style="q2" vid="DEU 32:27">శత్రువుల దూషణకు భయపడి అలా చేయలేదు.”<verse eid="DEU 32:27" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="28" style="v" sid="DEU 32:28" />వారు ఆలోచనలేని జనులు,</para>
  <para style="q2" vid="DEU 32:28">వారిలో వివేచన లేదు.<verse eid="DEU 32:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="DEU 32:29" />వారు తెలివైన వారైతే ఈ విషయాన్ని అర్థం చేసుకుంటారు,</para>
  <para style="q2" vid="DEU 32:29">వారి అంతం ఏమిటో వివేచిస్తారు!<verse eid="DEU 32:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="DEU 32:30" />తమ ఆశ్రయదుర్గం వారిని అప్పగిస్తేనే తప్ప,</para>
  <para style="q2" vid="DEU 32:30">యెహోవా వారిని వదిలివేస్తేనే తప్ప,</para>
  <para style="q1" vid="DEU 32:30">ఒక్కడు వేయిమందిని తరుమగలడా?</para>
  <para style="q2" vid="DEU 32:30">ఇద్దరు పదివేలమందిని పారిపోయేలా చేయగలరా?<verse eid="DEU 32:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="DEU 32:31" />వారి బండ మన ఆశ్రయదుర్గం వంటిది కాదు,</para>
  <para style="q2" vid="DEU 32:31">మన శత్రువులు కూడా ఒప్పుకుంటారు.<verse eid="DEU 32:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="DEU 32:32" />వారి ద్రాక్షచెట్టు సొదొమ ద్రాక్షచెట్టు నుండి వచ్చింది</para>
  <para style="q2" vid="DEU 32:32">అది గొమొర్రా పొలాల్లో నుండి వచ్చింది.</para>
  <para style="q1" vid="DEU 32:32">వాటి ద్రాక్షపండ్లు విషంతో నిండి ఉన్నాయి,</para>
  <para style="q2" vid="DEU 32:32">వాటి గెలలు చేదుగా ఉన్నాయి.<verse eid="DEU 32:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="DEU 32:33" />వాటి ద్రాక్షరసం సర్ప విషం,</para>
  <para style="q2" vid="DEU 32:33">నాగుపాముల మరణకరమైన విషము.<verse eid="DEU 32:33" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="34" style="v" sid="DEU 32:34" />“వారి క్రియలు ఎలాంటివో ఆ లెక్క అంతా నా దగ్గరే ఉంది,</para>
  <para style="q2" vid="DEU 32:34">దాన్ని నిల్వచేసే నా ఖజానాలో భద్రపరచలేదా?<verse eid="DEU 32:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="DEU 32:35" />పగ తీర్చుకోవడం నా పని; నేను తిరిగి చెల్లిస్తాను.</para>
  <para style="q2" vid="DEU 32:35">సరియైన సమయంలో వారి పాదం జారుతుంది;</para>
  <para style="q1" vid="DEU 32:35">వారి ఆపద్దినం దగ్గరపడింది</para>
  <para style="q2" vid="DEU 32:35">వారి విధి వేగంగా వారి మీదికి వస్తుంది.”<verse eid="DEU 32:35" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="36" style="v" sid="DEU 32:36" />వారి బలం పోయిందని</para>
  <para style="q2" vid="DEU 32:36">బానిసలు గాని స్వతంత్రులు గాని ఎవరు మిగలలేదని చూసి,</para>
  <para style="q1" vid="DEU 32:36">యెహోవా తన ప్రజలకు తీర్పు తీరుస్తారు</para>
  <para style="q2" vid="DEU 32:36">తన సేవకుల మీద జాలి పడతారు.<verse eid="DEU 32:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="DEU 32:37" />ఆయన ఇలా అంటున్నారు: “వారి దేవుళ్ళు ఎక్కడ,</para>
  <para style="q2" vid="DEU 32:37">వారు ఆశ్రయంగా ఏర్పరచుకున్న బండ ఎక్కడ,<verse eid="DEU 32:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="DEU 32:38" />వారి బలుల క్రొవ్వు తిని</para>
  <para style="q2" vid="DEU 32:38">వారి పానార్పణల ద్రాక్షరసం త్రాగిన వారి దేవుళ్ళు ఎక్కడ?</para>
  <para style="q1" vid="DEU 32:38">మీకు సాయం చేయడానికి వారు లేచెదరు గాక!</para>
  <para style="q2" vid="DEU 32:38">వారు మీకు ఆశ్రయమిచ్చెదరు గాక!<verse eid="DEU 32:38" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="39" style="v" sid="DEU 32:39" />“చూడండి, నేనే ఏకైక దేవున్ని!</para>
  <para style="q2" vid="DEU 32:39">నేను తప్ప మరో దేవుడు లేడు</para>
  <para style="q1" vid="DEU 32:39">చంపేవాడను నేనే బ్రతికించేవాడను నేనే.</para>
  <para style="q2" vid="DEU 32:39">గాయం చేసేది నేనే, బాగు చేసేది నేనే,</para>
  <para style="q2" vid="DEU 32:39">నా చేతిలో నుండి ఎవరూ విడిపించలేరు.<verse eid="DEU 32:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="DEU 32:40" />నేను ఆకాశం వైపు నా చేయి ఎత్తి రూఢిగా ప్రమాణం చేస్తున్నాను:</para>
  <para style="q2" vid="DEU 32:40">నా శాశ్వత జీవం తోడని చెప్తున్న,<verse eid="DEU 32:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="DEU 32:41" />నేను నా మెరిసే ఖడ్గానికి పదును పెట్టి,</para>
  <para style="q2" vid="DEU 32:41">నా చేయి న్యాయాన్ని పట్టుకున్నప్పుడు,</para>
  <para style="q1" vid="DEU 32:41">నేను నా ప్రత్యర్థులపై ప్రతీకారం తీర్చుకుంటాను</para>
  <para style="q2" vid="DEU 32:41">నన్ను ద్వేషించే వారికి ప్రతిఫలమిస్తాను.<verse eid="DEU 32:41" /></para>
  <para style="q1">
    <verse number="42" style="v" sid="DEU 32:42" />నా ఖడ్గం మాంసాన్ని తింటుండగా,</para>
  <para style="q2" vid="DEU 32:42">నేను నా బాణాలను రక్తంతో మత్తెక్కేలా చేస్తాను:</para>
  <para style="q1" vid="DEU 32:42">చంపబడినవారి రక్తం, బందీల రక్తంతో,</para>
  <para style="q2" vid="DEU 32:42">శత్రు నాయకుల తలలను అవి తింటాయి.”<verse eid="DEU 32:42" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="43" style="v" sid="DEU 32:43" />జనులారా, ఆయన ప్రజలతో కూడా సంతోషించండి,</para>
  <para style="q2" vid="DEU 32:43">ఎందుకంటే ఆయన తన సేవకుల రక్తానికి ప్రతీకారం తీర్చుకుంటారు;</para>
  <para style="q1" vid="DEU 32:43">ఆయన తన శత్రువుల మీద పగతీర్చుకుంటారు</para>
  <para style="q2" vid="DEU 32:43">తన దేశం కోసం తన ప్రజల కోసం ప్రాయశ్చిత్తం చేస్తారు.<verse eid="DEU 32:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="DEU 32:44" />మోషే నూను కుమారుడైన యెహోషువతో పాటు వచ్చి ప్రజలు వింటుండగా ఈ పాటలోని అన్ని మాటలను వినిపించాడు. <verse eid="DEU 32:44" /><verse number="45" style="v" sid="DEU 32:45" />మోషే ఈ మాటలన్నీ ఇశ్రాయేలీయులందరికి వినిపించడం ముగించి, <verse eid="DEU 32:45" /><verse number="46" style="v" sid="DEU 32:46" />వారితో, “ఈ ధర్మశాస్త్రంలోని మాటలన్నిటిని జాగ్రత్తగా పాటించమని మీ పిల్లలకు ఆజ్ఞాపించేలా, ఈ రోజు నేను మీకు హెచ్చరికగా ప్రకటించిన మాటలన్నిటిని జ్ఞాపకముంచుకోండి. <verse eid="DEU 32:46" /><verse number="47" style="v" sid="DEU 32:47" />అవి కేవలం మామూలు మాటలు కావు, అవి మీకు జీవము. మీరు యొర్దాను దాటి వెళ్లి స్వాధీనపరుచుకోబోయే దేశంలో దీర్ఘకాలం జీవిస్తారు” అన్నాడు.<verse eid="DEU 32:47" /></para>
  <para style="s1">మోషే నెబో పర్వతం మీద చనిపోవుట</para>
  <para style="p">
    <verse number="48" style="v" sid="DEU 32:48" />అదే రోజు యెహోవా మోషేతో మాట్లాడుతూ, <verse eid="DEU 32:48" /><verse number="49" style="v" sid="DEU 32:49" />“యెరికోకు ఎదురుగా మోయాబులోని నెబో పర్వతానికి అబారీము పర్వతశ్రేణిలోకి వెళ్లి, నేను ఇశ్రాయేలీయులకు వారి సొంత స్వాస్థ్యంగా ఇస్తున్న కనాను దేశాన్ని చూడు. <verse eid="DEU 32:49" /><verse number="50" style="v" sid="DEU 32:50" />నీ సహోదరుడు అహరోను హోరు కొండపై చనిపోయి తన ప్రజల దగ్గరకు చేరుకున్నట్టు, నీవు ఎక్కిన కొండమీద నీవు చనిపోయి నీ ప్రజల దగ్గరకు చేరుతావు. <verse eid="DEU 32:50" /><verse number="51" style="v" sid="DEU 32:51" />అసలు ఇలా జరిగిందంటే, మీరు సీను ఎడారిలోని మెరీబా కాదేషు నీళ్ల దగ్గర ఇశ్రాయేలీయుల ముందు మీరిద్దరూ నా పట్ల నమ్మకద్రోహం చేశారు, ఇశ్రాయేలీయుల ఎదుట మీరు నా పరిశుద్ధతను గౌరవించకపోవడము. <verse eid="DEU 32:51" /><verse number="52" style="v" sid="DEU 32:52" />కాబట్టి, నీవు దూరం నుండి మాత్రమే దేశాన్ని చూస్తావు; నేను ఇశ్రాయేలు ప్రజలకు ఇస్తున్న దేశంలో నీవు ప్రవేశించవు” అని అన్నారు.<verse eid="DEU 32:52" /></para>
  <chapter eid="DEU 32" />
  <chapter number="33" style="c" sid="DEU 33" />
  <para style="s1">ఇశ్రాయేలు గోత్రాలను దీవించిన మోషే</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 33:1" />దైవజనుడైన మోషే తాను చనిపోకముందు ఇశ్రాయేలు ప్రజలపై పలికిన ఆశీర్వాద వచనాలు. <verse eid="DEU 33:1" /><verse number="2" style="v" sid="DEU 33:2" />అతడు ఇలా అన్నాడు:</para>
  <para style="q1" vid="DEU 33:2">“యెహోవా సీనాయి పర్వతం నుండి వచ్చారు</para>
  <para style="q2" vid="DEU 33:2">శేయీరు నుండి వారి మీద ఉదయించారు;</para>
  <para style="q2" vid="DEU 33:2">పారాను పర్వతం నుండి ప్రకాశించారు.</para>
  <para style="q1" vid="DEU 33:2">వేవేల పరిశుద్ధులతో ఆయన వచ్చారు,</para>
  <para style="q2" vid="DEU 33:2">దక్షిణం నుండి, పర్వత వాలు నుండి వచ్చారు.<verse eid="DEU 33:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="DEU 33:3" />నిజంగా ఆయన తన జనులను ప్రేమిస్తున్నారు;</para>
  <para style="q2" vid="DEU 33:3">పరిశుద్ధులందరు మీ చేతిలో ఉన్నారు.</para>
  <para style="q1" vid="DEU 33:3">వారు మీ పాదాల దగ్గర వంగి,</para>
  <para style="q2" vid="DEU 33:3">మీ నుండి ఉపదేశాన్ని పొందుకుంటారు,<verse eid="DEU 33:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="DEU 33:4" />మోషే మనకు ఇచ్చిన ధర్మశాస్త్రం</para>
  <para style="q2" vid="DEU 33:4">యాకోబు సమాజానికి స్వాస్థ్యము.<verse eid="DEU 33:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="DEU 33:5" />ప్రజల నాయకులు,</para>
  <para style="q2" vid="DEU 33:5">ఇశ్రాయేలు గోత్రాలతో పాటు సమావేశమైనప్పుడు</para>
  <para style="q2" vid="DEU 33:5">ఆయన యెషూరూనుకు<note caller="+" style="f"><char style="fr" closed="false">33:5 </char><char style="fq" closed="false">యెషూరూనుకు </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">యథార్థవంతుడు </char><char style="ft" closed="false">అంటే, ఇశ్రాయేలు; <char style="xt" link-href="DEU 33:26"><ref loc="DEU 33:26">33:26</ref></char> వచనంలో కూడా</char></note> రాజుగా ఉన్నాడు.<verse eid="DEU 33:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="DEU 33:6" />“రూబేను చనిపోకుండ బ్రతికి ఉండును గాక,</para>
  <para style="q2" vid="DEU 33:6">అతని ప్రజల సంఖ్య తగ్గకుండును గాక.”<verse eid="DEU 33:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DEU 33:7" />యూదా గురించి అతడు ఇలా అన్నాడు:</para>
  <para style="q1" vid="DEU 33:7">“యెహోవా, యూదా మొరను వినండి;</para>
  <para style="q2" vid="DEU 33:7">అతని ప్రజల దగ్గరకు అతన్ని చేర్చండి.</para>
  <para style="q1" vid="DEU 33:7">అతడు తన చేతులతో తన కోసం పోరాడేలా,</para>
  <para style="q2" vid="DEU 33:7">అతని శత్రువులకు వ్యతిరేకంగా అతనికి సహాయంగా ఉండండి!”<verse eid="DEU 33:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DEU 33:8" />లేవీ గురించి అతడు ఇలా అన్నాడు:</para>
  <para style="q1" vid="DEU 33:8">“యెహోవా, మీ తుమ్మీము, ఊరీము</para>
  <para style="q2" vid="DEU 33:8">మీ నమ్మకమైన సేవకునికి చెందినవి.</para>
  <para style="q1" vid="DEU 33:8">మస్సాలో మీరతనిని పరీక్షించారు;</para>
  <para style="q2" vid="DEU 33:8">మెరీబా నీళ్ల దగ్గర అతనితో మీరు వాదించారు.<verse eid="DEU 33:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="DEU 33:9" />అతడు తన తండ్రి తల్లి గురించి చెబుతూ,</para>
  <para style="q2" vid="DEU 33:9">‘నేను వారిని చూడలేదు’</para>
  <para style="q1" vid="DEU 33:9">అతడు తన సోదరులను గుర్తించలేదు</para>
  <para style="q2" vid="DEU 33:9">తన సొంత పిల్లలను అంగీకరించలేదు.</para>
  <para style="q1" vid="DEU 33:9">కాని అతడు నీ మాట గమనించాడు</para>
  <para style="q2" vid="DEU 33:9">నీ నిబంధనను కాపాడాడు.<verse eid="DEU 33:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="DEU 33:10" />అతడు యాకోబుకు నీ కట్టడలను</para>
  <para style="q2" vid="DEU 33:10">ఇశ్రాయేలీయులకు నీ ధర్మశాస్త్రాన్ని బోధిస్తాడు,</para>
  <para style="q1" vid="DEU 33:10">అతడు మీ ఎదుట ధూపం వేస్తాడు,</para>
  <para style="q2" vid="DEU 33:10">మీ బలిపీఠం మీద దహనబలులు అర్పిస్తాడు.<verse eid="DEU 33:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="DEU 33:11" />యెహోవా, అతని సేవను దీవించండి,</para>
  <para style="q2" vid="DEU 33:11">అతని చేతి పనులను బట్టి సంతోషించండి.</para>
  <para style="q1" vid="DEU 33:11">అతనికి వ్యతిరేకంగా లేచినవారిని కొట్టండి,</para>
  <para style="q2" vid="DEU 33:11">అతని శత్రువులను తిరిగి లేవనంతగా కొట్టండి.”<verse eid="DEU 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="DEU 33:12" />బెన్యామీను గురించి అతడు ఇలా అన్నాడు:</para>
  <para style="q1" vid="DEU 33:12">“యెహోవాకు ప్రియమైనవాడు ఆయనలో క్షేమంగా ఉండును గాక,</para>
  <para style="q2" vid="DEU 33:12">ఎందుకంటే రోజంతా ఆయన రక్షణగా ఉంటారు,</para>
  <para style="q2" vid="DEU 33:12">యెహోవా ప్రేమించేవాడు ఆయన భుజాల మధ్య ఉంటాడు.”<verse eid="DEU 33:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DEU 33:13" />యోసేపు గురించి అతడు ఇలా అన్నాడు:</para>
  <para style="q1" vid="DEU 33:13">“యెహోవా అతని భూమిని</para>
  <para style="q2" vid="DEU 33:13">ఆకాశం నుండి కురిసే శ్రేష్ఠమైన మంచుతో</para>
  <para style="q2" vid="DEU 33:13">క్రింద ఉన్న లోతైన జలాలతో దీవించును గాక;<verse eid="DEU 33:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="DEU 33:14" />సూర్యుని వలన కలిగే ఉత్తమమైన ఫలాలతో</para>
  <para style="q2" vid="DEU 33:14">చంద్రుడు ఫలింపచేసే శ్రేష్ఠమైన ఫలాలతో;<verse eid="DEU 33:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="DEU 33:15" />పురాతన పర్వతాల శ్రేష్ఠమైన వాటితో</para>
  <para style="q2" vid="DEU 33:15">శాశ్వత కొండల శ్రేష్ఠమైన పంటతో;<verse eid="DEU 33:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="DEU 33:16" />భూమి ఇచ్చే ప్రశస్తమైన పదార్థాలతో వాటి సమృద్ధితో</para>
  <para style="q2" vid="DEU 33:16">మండుతున్న పొదలో నివసించే ఆయన దయతో దీవించును గాక.</para>
  <para style="q1" vid="DEU 33:16">ఇవన్నీ యోసేపు తలపై ఉండును గాక,</para>
  <para style="q2" vid="DEU 33:16">అతని సోదరుల మధ్యలో యువరాజు నుదుటి మీద ఉండును గాక.<verse eid="DEU 33:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="DEU 33:17" />ప్రభావంలో అతడు మొదట పుట్టిన కోడెలాంటి వాడు;</para>
  <para style="q2" vid="DEU 33:17">అతని కొమ్ములు అడవి ఎద్దు కొమ్ములు.</para>
  <para style="q1" vid="DEU 33:17">వాటితో అతడు జనులను,</para>
  <para style="q2" vid="DEU 33:17">భూమి అంచులో ఉన్నవారిని కూడా కుమ్ముతాడు.</para>
  <para style="q1" vid="DEU 33:17">ఎఫ్రాయిముకు చెందిన పదివేలమంది అలాంటివారు,</para>
  <para style="q2" vid="DEU 33:17">మనష్షేకు చెందిన వేలమంది అలాంటివారు.”<verse eid="DEU 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DEU 33:18" />జెబూలూను గురించి అతడు ఇలా అన్నాడు:</para>
  <para style="q1" vid="DEU 33:18">“జెబూలూనూ, నీవు బయటకు వెళ్లునప్పుడు, సంతోషించు,</para>
  <para style="q2" vid="DEU 33:18">ఇశ్శాఖారూ, నీవు నీ గుడారాల్లో సంతోషించు.<verse eid="DEU 33:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="DEU 33:19" />వారు జనులను పర్వతం దగ్గరకు పిలుస్తారు</para>
  <para style="q2" vid="DEU 33:19">అక్కడ నీతి బలులు అర్పిస్తారు;</para>
  <para style="q1" vid="DEU 33:19">వారు సముద్రాల సమృద్ధి మీద</para>
  <para style="q2" vid="DEU 33:19">ఇసుకలో దాగి ఉన్న నిధుల మీద విందు చేస్తారు.”<verse eid="DEU 33:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DEU 33:20" />గాదు గురించి అతడు ఇలా అన్నాడు:</para>
  <para style="q1" vid="DEU 33:20">“గాదు దేశాన్ని విశాలం చేసినవారు ధన్యులు!</para>
  <para style="q2" vid="DEU 33:20">గాదు అక్కడ సింహంలా నివసిస్తాడు,</para>
  <para style="q2" vid="DEU 33:20">చేతిని గాని నడినెత్తిని చీల్చివేస్తాడు.<verse eid="DEU 33:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="DEU 33:21" />అతడు తన కోసం శ్రేష్ఠమైన భాగాన్ని ఎంచుకున్నాడు;</para>
  <para style="q2" vid="DEU 33:21">నాయకుని భాగం అతని కోసం ఉంచబడుతుంది.</para>
  <para style="q1" vid="DEU 33:21">ప్రజల పెద్దలు సమావేశమైనప్పుడు</para>
  <para style="q2" vid="DEU 33:21">యెహోవా యొక్క నీతియుక్తమైన చిత్తాన్ని,</para>
  <para style="q2" vid="DEU 33:21">ఇశ్రాయేలీయు గురించి ఆయన తీర్పులను, అతడు అమలుచేస్తాడు.”<verse eid="DEU 33:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="DEU 33:22" />దాను గురించి అతడు ఇలా చెప్పాడు:</para>
  <para style="q1" vid="DEU 33:22">“దాను గోత్రం సింహం పిల్లలాంటిది,</para>
  <para style="q2" vid="DEU 33:22">బాషాను నుండి దూకుతుంది.”<verse eid="DEU 33:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DEU 33:23" />నఫ్తాలి గురించి అతడు ఇలా అన్నాడు:</para>
  <para style="q1" vid="DEU 33:23">“నఫ్తాలి యెహోవా దయతో తృప్తి చెంది</para>
  <para style="q2" vid="DEU 33:23">ఆయన దీవెనలతో నింపబడ్డాడు;</para>
  <para style="q2" vid="DEU 33:23">దక్షిణం నుండి సముద్రం వరకు అతడు స్వాధీనం చేసుకుంటాడు.”<verse eid="DEU 33:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DEU 33:24" />ఆషేరు గురించి అతడు ఇలా అన్నాడు:</para>
  <para style="q1" vid="DEU 33:24">“కుమారులలో ఆషేరు అందరికంటే ఎక్కువగా ఆశీర్వదించబడ్డాడు;</para>
  <para style="q2" vid="DEU 33:24">అతడు తన సోదరుల దయను పొందును గాక.</para>
  <para style="q2" vid="DEU 33:24">అతడు తన పాదాలను నూనెలో ముంచును గాక.<verse eid="DEU 33:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="DEU 33:25" />నీ ద్వారపు గడియలు ఇనుపవి, ఇత్తడివి</para>
  <para style="q2" vid="DEU 33:25">నీ బలం నీ రోజులకు సమానంగా ఉంటుంది.<verse eid="DEU 33:25" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="26" style="v" sid="DEU 33:26" />“యెషూరూను దేవుని పోలినవారు ఎవరు లేరు,</para>
  <para style="q2" vid="DEU 33:26">ఆకాశవాహనుడై వచ్చి నీకు సహాయం చేయడానికి ఆయన ఆకాశం గుండా వస్తారు,</para>
  <para style="q2" vid="DEU 33:26">తన తేజస్సుతో మేఘాలపై వస్తారు.<verse eid="DEU 33:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="DEU 33:27" />శాశ్వతమైన దేవుడు నీకు ఆశ్రయం,</para>
  <para style="q2" vid="DEU 33:27">నిత్యమైన హస్తాలు నీ క్రింద ఉన్నాయి.</para>
  <para style="q1" vid="DEU 33:27">‘వారిని నాశనం చెయ్యండి!’</para>
  <para style="q2" vid="DEU 33:27">అంటూ ఆయన నీ శత్రువులను నీ ఎదుట నుండి తరిమివేస్తారు.<verse eid="DEU 33:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="DEU 33:28" />కాబట్టి ఇశ్రాయేలు ప్రజలు క్షేమంగా నివసిస్తారు;</para>
  <para style="q2" vid="DEU 33:28">ధాన్యం క్రొత్త ద్రాక్షరసం ఉన్న దేశంలో</para>
  <para style="q1" vid="DEU 33:28">యాకోబు ఊట క్షేమంగా ఉంటుంది,</para>
  <para style="q2" vid="DEU 33:28">అక్కడ ఆకాశం మంచు కురిపిస్తుంది.<verse eid="DEU 33:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="DEU 33:29" />ఇశ్రాయేలూ, మీరు ధన్యులు!</para>
  <para style="q2" vid="DEU 33:29">యెహోవా రక్షించిన ప్రజలారా,</para>
  <para style="q2" vid="DEU 33:29">మీలాంటి వారు ఎవరు?</para>
  <para style="q1" vid="DEU 33:29">ఆయన మీకు డాలు, సహాయకుడు</para>
  <para style="q2" vid="DEU 33:29">మీ మహిమగల ఖడ్గము.</para>
  <para style="q1" vid="DEU 33:29">మీ శత్రువులు మీ ఎదుట భయపడతారు;</para>
  <para style="q2" vid="DEU 33:29">మీరు వారి వీపుపై త్రొక్కుతారు.”<verse eid="DEU 33:29" /></para>
  <chapter eid="DEU 33" />
  <chapter number="34" style="c" sid="DEU 34" />
  <para style="s1">మోషే మరణం</para>
  <para style="p">
    <verse number="1" style="v" sid="DEU 34:1" />తర్వాత మోషే మోయాబు సమతల మైదానాల నుండి వెళ్లి యెరికో ఎదురుగా ఉన్న పిస్గా పర్వత శిఖరం వరకు వెళ్లి నెబో పర్వతమెక్కాడు. అక్కడ యెహోవా అతనికి గిలాదు నుండి దాను వరకు ఉన్న దేశాన్నంతా చూపించారు, <verse eid="DEU 34:1" /><verse number="2" style="v" sid="DEU 34:2" />నఫ్తాలి ప్రాంతమంతటిని, ఎఫ్రాయిం మనష్షేల ప్రాంతాలను, పశ్చిమదిక్కున ఉన్న మధ్యధరా సముద్రం వరకు ఉన్న యూదా ప్రాంతాన్ని, <verse eid="DEU 34:2" /><verse number="3" style="v" sid="DEU 34:3" />దక్షిణ ప్రాంతాన్ని, ఖర్జూర చెట్ల పట్టణమైన యెరికో లోయ నుండి సోయరు వరకు ఉన్న మొత్తం ప్రాంతాన్ని అతనికి చూపించారు. <verse eid="DEU 34:3" /><verse number="4" style="v" sid="DEU 34:4" />అప్పుడు యెహోవా అతనితో ఇలా అన్నారు, “నేను మీ సంతానానికి ఇస్తానని అబ్రాహాము, ఇస్సాకు, యాకోబులకు ప్రమాణంతో వాగ్దానం చేసిన దేశం ఇదే. కళ్ళారా నిన్ను దాన్ని చూడనిస్తున్నాను కాని, నది దాటి నీవు అక్కడికి వెళ్లవు.”<verse eid="DEU 34:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DEU 34:5" />యెహోవా చెప్పిన ప్రకారంగా యెహోవా సేవకుడైన మోషే మోయాబు దేశంలోనే చనిపోయాడు. <verse eid="DEU 34:5" /><verse number="6" style="v" sid="DEU 34:6" />బేత్-పెయోరు ఎదుట మోయాబులో ఉన్న ఒక లోయలో ఆయన అతన్ని పాతిపెట్టారు.<note caller="+" style="f"><char style="fr" closed="false">34:6 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">అతడు పాతిపెట్టబడ్డాడు</char></note> అతని సమాధి ఎక్కడ ఉందో నేటివరకు ఎవరికీ తెలియదు. <verse eid="DEU 34:6" /><verse number="7" style="v" sid="DEU 34:7" />మోషే చనిపోయినప్పుడు అతని వయస్సు నూట ఇరవై సంవత్సరాలు, అతని కళ్లు మసక బారలేదు అతని బలం తగ్గలేదు. <verse eid="DEU 34:7" /><verse number="8" style="v" sid="DEU 34:8" />సంతాప దినాల సమయం పూర్తి అయ్యేవరకు ఇశ్రాయేలీయులు మోయాబు సమతల మైదానాల్లో మోషే కోసం ముప్పై రోజులు దుఃఖించారు.<verse eid="DEU 34:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="DEU 34:9" />అంతకుముందే మోషే తన చేతులను నూను కుమారుడైన యెహోషువ మీద ఉంచాడు కాబట్టి అతడు జ్ఞానాత్మతో నింపబడ్డాడు. కాబట్టి ఇశ్రాయేలీయులు అతని మాట విని యెహోవా మోషేకు ఆజ్ఞాపించిన ప్రకారం చేశారు.<verse eid="DEU 34:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DEU 34:10" />అప్పటినుండి ఇశ్రాయేలులో యెహోవా ముఖాముఖిగా మాట్లాడిన మోషే వంటి ప్రవక్త, <verse eid="DEU 34:10" /><verse number="11" style="v" sid="DEU 34:11" />ఈజిప్టులో ఫరోకు, అతని అధికారులందరికి, అతని దేశమంతటికి సూచనలను, అద్భుతాలను చేయడానికి యెహోవా పంపిన అలాంటి ప్రవక్త ఇశ్రాయేలులో లేడు. <verse eid="DEU 34:11" /><verse number="12" style="v" sid="DEU 34:12" />ఎందుకంటే ఇశ్రాయేలీయులందరి దృష్టిలో మోషే చేసిన భయం పుట్టించే శక్తివంతమైన కార్యాలు ఎవ్వరూ చేయలేదు.<verse eid="DEU 34:12" /></para>
  <chapter eid="DEU 34" />
</usx>