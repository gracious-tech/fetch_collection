<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ZEP" style="id">- Biblica® Open Telugu Contemporary Version</book>
  
  <para style="h">జెఫన్యా</para>
  <para style="toc1">జెఫన్యా ప్రవచనం</para>
  <para style="toc2">జెఫన్యా</para>
  <para style="toc3">జెఫన్యా</para>
  <para style="mt1">జెఫన్యా</para>
  <para style="mt2">ప్రవచనం</para>
  <chapter number="1" style="c" sid="ZEP 1" />
  <para style="p">
    <verse number="1" style="v" sid="ZEP 1:1" />ఇది యూదా రాజైన ఆమోను కుమారుడు యోషీయా పాలనలో జెఫన్యాకు యెహోవా నుండి వచ్చిన వాక్కు. జెఫన్యా కూషీ కుమారుడు, కూషీ గెదల్యా కుమారుడు, గెదల్యా అమర్యా కుమారుడు, అమర్యా హిజ్కియాకు కుమారుడు.<verse eid="ZEP 1:1" /></para>
  <para style="b" />
  <para style="s1">యెహోవా దినాన భూమి అంతటికి తీర్పు</para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 1:2" />“భూమి మీద ఏమీ మిగలకుండా</para>
  <para style="q2" vid="ZEP 1:2">నేను సమస్తాన్ని తుడిచివేస్తాను,”</para>
  <para style="q2" vid="ZEP 1:2">అని యెహోవా ప్రకటిస్తున్నారు.<verse eid="ZEP 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 1:3" />“మనుష్యులను మృగాలను తుడిచివేస్తాను;</para>
  <para style="q2" vid="ZEP 1:3">ఆకాశంలో ఎగిరే పక్షులను,</para>
  <para style="q2" vid="ZEP 1:3">సముద్రంలోని చేపలను తుడిచివేస్తాను,</para>
  <para style="q2" vid="ZEP 1:3">దుర్మార్గులను పడిపోయేలా చేసే విగ్రహాలను తుడిచివేస్తాను.”</para>
  <para style="b" vid="ZEP 1:3" />
  <para style="q1" vid="ZEP 1:3">“నేను మానవజాతి అంతటిని</para>
  <para style="q2" vid="ZEP 1:3">భూమి మీద ఉండకుండా చేస్తాను”</para>
  <para style="q2" vid="ZEP 1:3">అని యెహోవా ప్రకటిస్తున్నారు.<verse eid="ZEP 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 1:4" />“యూదా వారి మీద,</para>
  <para style="q2" vid="ZEP 1:4">యెరూషలేములో నివసిస్తున్న వారందరి మీద నా చేయి చాపుతాను.</para>
  <para style="q1" vid="ZEP 1:4">ఈ స్థలంలో మిగిలి ఉన్న బయలు దేవత ఆరాధికులను</para>
  <para style="q2" vid="ZEP 1:4">ఆ విగ్రహాన్ని పూజించేవారి పూజారుల పేర్లతో సహా నిర్మూలిస్తాను.<verse eid="ZEP 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 1:5" />మిద్దెమీద ఎక్కి</para>
  <para style="q2" vid="ZEP 1:5">ఆకాశ నక్షత్ర సమూహాన్ని పూజించేవారిని,</para>
  <para style="q1" vid="ZEP 1:5">యెహోవా పేర మోలెకు<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">హెబ్రీలో </char><char style="fqa" closed="false">మల్కాము</char></note> దేవత పేర</para>
  <para style="q2" vid="ZEP 1:5">మొక్కి ఒట్టు వేసుకునేవారిని నేను నాశనం చేస్తాను.<verse eid="ZEP 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 1:6" />యెహోవాను అనుసరించకుండా ప్రక్కకు తిరిగినవారిని</para>
  <para style="q2" vid="ZEP 1:6">ఆయనను వెదకకుండ, ఆయన దగ్గర విచారణ చేయనివారిని నాశనం చేస్తాను.”<verse eid="ZEP 1:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 1:7" />ప్రభువైన యెహోవా దినం సమీపించింది,</para>
  <para style="q2" vid="ZEP 1:7">కాబట్టి ఆయన సన్నిధిలో మౌనంగా ఉండండి.</para>
  <para style="q1" vid="ZEP 1:7">యెహోవా బలి సిద్ధం చేశారు;</para>
  <para style="q2" vid="ZEP 1:7">తాను ఆహ్వానించిన వారిని ఆయన పవిత్రపరిచారు.<verse eid="ZEP 1:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 1:8" />“యెహోవా ఏర్పరచిన బలి దినాన</para>
  <para style="q2" vid="ZEP 1:8">నేను అధికారులను, రాజకుమారులను,</para>
  <para style="q1" vid="ZEP 1:8">విదేశీయుల్లా దుస్తులు</para>
  <para style="q2" vid="ZEP 1:8">వేసుకున్నవారందరిని శిక్షిస్తాను.<verse eid="ZEP 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 1:9" />ఆ రోజున, ఇంటి గుమ్మం<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="1SA 5:5">1 సమూ 5:5</ref></char></char></note> దాటివచ్చి,</para>
  <para style="q2" vid="ZEP 1:9">తమ దేవతల మందిరాన్ని హింసతో</para>
  <para style="q2" vid="ZEP 1:9">మోసంతో నింపేవారందరినీ నేను శిక్షిస్తాను.<verse eid="ZEP 1:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 1:10" />“ఆ దినాన యెరూషలేములో ఉన్న</para>
  <para style="q2" vid="ZEP 1:10">చేప ద్వారం నుండి ఏడుపు,</para>
  <para style="q1" vid="ZEP 1:10">పట్టణ దిగువ భాగం నుండి రోదన,</para>
  <para style="q2" vid="ZEP 1:10">కొండల దిక్కునుండి గొప్ప నాశనం వస్తుంది,</para>
  <para style="q2" vid="ZEP 1:10">అని యెహోవా ప్రకటిస్తున్నారు.<verse eid="ZEP 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 1:11" />వర్తక ప్రాంతంలో<note caller="+" style="f"><char style="fr" closed="false">1:11 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">మోర్తారు</char></note> నివసించేవారలారా! రోదించండి;</para>
  <para style="q2" vid="ZEP 1:11">నీ వర్తకులంతా తుడిచివేయబడతారు,</para>
  <para style="q2" vid="ZEP 1:11">వెండితో వ్యాపారం చేసేవారంతా నాశనం చేయబడతారు.<verse eid="ZEP 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 1:12" />ఆ కాలంలో నేను దీపాలు పట్టుకుని యెరూషలేమును సోదా చేస్తాను,</para>
  <para style="q2" vid="ZEP 1:12">మడ్డి మీద నిలిచిన ద్రాక్షరసం లాంటివారై</para>
  <para style="q2" vid="ZEP 1:12">‘యెహోవా మేలు గాని కీడు గాని ఏదీ చేయడు’ అనుకుంటూ,</para>
  <para style="q1" vid="ZEP 1:12">ఆత్మసంతృప్తితో ఉన్నవారిని</para>
  <para style="q2" vid="ZEP 1:12">నేను శిక్షిస్తాను.<verse eid="ZEP 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 1:13" />వారి ధనం దోపిడి అవుతుంది,</para>
  <para style="q2" vid="ZEP 1:13">వారి ఇల్లు పాడవుతాయి.</para>
  <para style="q1" vid="ZEP 1:13">వారు ఇళ్ళు కట్టుకున్నా</para>
  <para style="q2" vid="ZEP 1:13">వాటిలో నివసించలేరు;</para>
  <para style="q1" vid="ZEP 1:13">వారు ద్రాక్షతోటలు నాటినా</para>
  <para style="q2" vid="ZEP 1:13">వాటి ద్రాక్షరసం త్రాగలేరు.”<verse eid="ZEP 1:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 1:14" />యెహోవా మహాదినం సమీపంగా ఉంది,</para>
  <para style="q2" vid="ZEP 1:14">అది ఆసన్నమై త్వరగా రాబోతుంది.</para>
  <para style="q1" vid="ZEP 1:14">యెహోవా దినాన ఏడ్పు భయంకరంగా ఉంటుంది;</para>
  <para style="q2" vid="ZEP 1:14">ఆ దినాన బలాఢ్యులు ఘోరంగా ఏడుస్తారు.<verse eid="ZEP 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 1:15" />ఆ దినం ఉగ్రత దినం;</para>
  <para style="q2" vid="ZEP 1:15">బాధ, వేదన కలుగుతుంది.</para>
  <para style="q3" vid="ZEP 1:15">అది నాశనం, ధ్వంసం,</para>
  <para style="q2" vid="ZEP 1:15">చీకటి అంధకారం కమ్మే దినం,</para>
  <para style="q3" vid="ZEP 1:15">మబ్బులు, గాఢాంధకారం కమ్మే రోజు.<verse eid="ZEP 1:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="ZEP 1:16" />ప్రాకార పట్టణాల దగ్గర</para>
  <para style="q1" vid="ZEP 1:16">ఎత్తైన గోపురాల దగ్గర యుద్ధఘోష,</para>
  <para style="q2" vid="ZEP 1:16">బాకానాదం వినబడే రోజు.<verse eid="ZEP 1:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 1:17" />“ప్రజలు యెహోవాకు విరోధంగా పాపం చేశారు,</para>
  <para style="q2" vid="ZEP 1:17">కాబట్టి మనుష్యులందరి మీదికి నేను బాధను రప్పించగా</para>
  <para style="q2" vid="ZEP 1:17">వారు గ్రుడ్డివారిలా తడుముకుంటారు.</para>
  <para style="q1" vid="ZEP 1:17">వారి రక్తం దుమ్ములా,</para>
  <para style="q2" vid="ZEP 1:17">వారి మాంసం పెంటలా పారవేయబడుతుంది.<verse eid="ZEP 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 1:18" />యెహోవా ఉగ్రత దినాన</para>
  <para style="q2" vid="ZEP 1:18">వారి వెండి బంగారాలు</para>
  <para style="q2" vid="ZEP 1:18">వారిని తప్పించలేవు.”</para>
  <para style="b" vid="ZEP 1:18" />
  <para style="q1" vid="ZEP 1:18">ఆయన రోషాగ్ని చేత</para>
  <para style="q2" vid="ZEP 1:18">లోకమంతా దగ్దమవుతుంది,</para>
  <para style="q1" vid="ZEP 1:18">ఆయన హఠాత్తుగా భూనివాసులందరినీ</para>
  <para style="q2" vid="ZEP 1:18">సర్వనాశనం చేయబోతున్నారు.<verse eid="ZEP 1:18" /></para>
  <chapter eid="ZEP 1" />
  <chapter number="2" style="c" sid="ZEP 2" />
  <para style="s1">దేశాలతో పాటు యూదా యెరూషలేము కూడా తీర్పుకు గురయ్యాయి</para>
  <para style="s2">పశ్చాత్తాపపడాలని యూదాకు పిలుపు</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 2:1" />సిగ్గుమాలిన దేశమా,</para>
  <para style="q2" vid="ZEP 2:1">సమకూడండి, మిమ్మల్ని మీరు సమకూర్చుకొండి<verse eid="ZEP 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 2:2" />శాసనం అమలులోకి రాకముందే</para>
  <para style="q2" vid="ZEP 2:2">ఆ దినం గాలికి కొట్టుకుపోయే పొట్టులా కనుమరుగు కాక ముందే,</para>
  <para style="q1" vid="ZEP 2:2">యెహోవా కోపాగ్ని</para>
  <para style="q2" vid="ZEP 2:2">మీ మీదికి రాకముందే,</para>
  <para style="q1" vid="ZEP 2:2">యెహోవా ఉగ్రత దినం</para>
  <para style="q2" vid="ZEP 2:2">మీ మీదికి రాకముందే సమకూడండి.<verse eid="ZEP 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 2:3" />దేశంలోని సమస్త దీనులారా,</para>
  <para style="q2" vid="ZEP 2:3">ఆయన ఆజ్ఞను పాటించేవారలారా, యెహోవాను వెదకండి.</para>
  <para style="q1" vid="ZEP 2:3">నీతిని వెదకండి, దీనత్వాన్ని వెదకండి;</para>
  <para style="q2" vid="ZEP 2:3">యెహోవా కోప్పడే దినాన</para>
  <para style="q2" vid="ZEP 2:3">బహుశ మీకు ఆశ్రయం దొరకవచ్చు.<verse eid="ZEP 2:3" /></para>
  <para style="s2">ఫిలిష్తీయ</para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 2:4" />గాజా విడిచిపెట్టబడుతుంది,</para>
  <para style="q2" vid="ZEP 2:4">అష్కెలోను పాడైపోతుంది.</para>
  <para style="q1" vid="ZEP 2:4">మధ్యాహ్న సమయంలో అష్డోదు ఖాళీ చేయబడుతుంది,</para>
  <para style="q2" vid="ZEP 2:4">ఎక్రోను పట్టణం పెళ్ళగించబడుతుంది.<verse eid="ZEP 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 2:5" />సముద్రతీరాన కాపురమున్న</para>
  <para style="q2" vid="ZEP 2:5">కెరేతీయులారా! మీకు శ్రమ.</para>
  <para style="q1" vid="ZEP 2:5">ఫిలిష్తీయ ప్రజలు కాపురమున్న కనాను దేశమా!</para>
  <para style="q2" vid="ZEP 2:5">యెహోవా వాక్కు నీకు వ్యతిరేకంగా ఉంది,</para>
  <para style="q1" vid="ZEP 2:5">“నీలో ఎవరూ మిగలకుండా</para>
  <para style="q2" vid="ZEP 2:5">నేను నిన్ను నాశనం చేస్తాను” అని ఆయన అంటున్నారు.<verse eid="ZEP 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 2:6" />సముద్రతీరాన ఉన్న దేశం,</para>
  <para style="q2" vid="ZEP 2:6">గొర్రెల కాపరులకు పచ్చికబయళ్లుగా అవుతుంది;</para>
  <para style="q2" vid="ZEP 2:6">బావులు, మందల కోసం దొడ్లు ఉంటాయి.<verse eid="ZEP 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 2:7" />ఆ ప్రాంతం యూదా వంశంలో</para>
  <para style="q2" vid="ZEP 2:7">మిగిలిన వారికి స్వాధీనం అవుతుంది.</para>
  <para style="q2" vid="ZEP 2:7">వారి దేవుడు యెహోవా వారి పట్ల శ్రద్ధ చూపిస్తారు,</para>
  <para style="q1" vid="ZEP 2:7">వారు బందీలుగా వెళ్లిన స్థలాల నుండి</para>
  <para style="q2" vid="ZEP 2:7">ఆయన వారిని రప్పిస్తారు.</para>
  <para style="q1" vid="ZEP 2:7">వారు ఆ ప్రాంతంలో తమ మందలు మేపుతారు.</para>
  <para style="q2" vid="ZEP 2:7">సాయంకాల సమయంలో అష్కెలోను ఇళ్ళలో పడుకుంటారు.<verse eid="ZEP 2:7" /></para>
  <para style="s2">మోయాబు, అమ్మోను</para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 2:8" />“నా ప్రజల ప్రాంతంలోకి ప్రవేశించి</para>
  <para style="q2" vid="ZEP 2:8">వారిని దూషించిన,</para>
  <para style="q1" vid="ZEP 2:8">మోయాబు వారు చేసిన అవమానాల గురించి,</para>
  <para style="q2" vid="ZEP 2:8">అమ్మోనీయుల దూషణల గురించి నేను విన్నాను.<verse eid="ZEP 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 2:9" />కాబట్టి, నా జీవం తోడు,</para>
  <para style="q2" vid="ZEP 2:9">మోయాబు సొదొమలా,</para>
  <para style="q2" vid="ZEP 2:9">అమ్మోను గొమొర్రాలా అవుతుంది.</para>
  <para style="q1" vid="ZEP 2:9">కలుపు మొక్కలు ఉప్పు గుంటలతో,</para>
  <para style="q2" vid="ZEP 2:9">అవి ఎప్పటికీ బంజరు భూమిగానే ఉంటాయి.</para>
  <para style="q1" vid="ZEP 2:9">నా ప్రజల్లో శేషించినవారు వారిని దోచుకుంటారు;</para>
  <para style="q2" vid="ZEP 2:9">నా దేశంలో బ్రతికినవారు తమ దేశాన్ని స్వతంత్రించుకుంటారు”</para>
  <para style="q1" vid="ZEP 2:9">అని ఇశ్రాయేలు దేవుడైన</para>
  <para style="q2" vid="ZEP 2:9">సైన్యాల యెహోవా ప్రకటిస్తున్నారు.<verse eid="ZEP 2:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 2:10" />ఈ విధంగా వారు గర్వంతో,</para>
  <para style="q2" vid="ZEP 2:10">సైన్యాల యెహోవా ప్రజలను అవమానించినందుకు,</para>
  <para style="q2" vid="ZEP 2:10">ఎగతాళి చేసినందుకు ప్రతిఫలం పొందుతారు.<verse eid="ZEP 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 2:11" />ఆయన భూమ్మీద ఉన్న దేవతలందరినీ నాశనం చేసినప్పుడు</para>
  <para style="q2" vid="ZEP 2:11">యెహోవా వారికి భయంకరంగా ఉంటాడు.</para>
  <para style="q1" vid="ZEP 2:11">ద్వీపాల్లో నివసించే జనులంతా తమ స్థలాల నుండి,</para>
  <para style="q2" vid="ZEP 2:11">ఆయనకు నమస్కారం చేస్తారు.<verse eid="ZEP 2:11" /></para>
  <para style="s2">కూషు</para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 2:12" />“కూషీయులారా, మీరు కూడా</para>
  <para style="q2" vid="ZEP 2:12">నా ఖడ్గం చేత చంపబడతారు.”<verse eid="ZEP 2:12" /></para>
  <para style="s2">అష్షూరు</para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 2:13" />ఆయన తన చేయి ఉత్తరం వైపు చాచి</para>
  <para style="q2" vid="ZEP 2:13">అష్షూరును నాశనం చేస్తారు.</para>
  <para style="q1" vid="ZEP 2:13">నీనెవెను పూర్తిగా నిర్జనమై</para>
  <para style="q2" vid="ZEP 2:13">ఎడారిలా ఎండిపోయేలా చేస్తారు.<verse eid="ZEP 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 2:14" />గొర్రెల మందలు, పశువుల మందలు,</para>
  <para style="q2" vid="ZEP 2:14">దేశంలోని అన్ని రకాల జీవులు అక్కడ పడుకుంటాయి.</para>
  <para style="q1" vid="ZEP 2:14">ఎడారి గుడ్లగూబ, పెద్ద గుడ్లగూబ</para>
  <para style="q2" vid="ZEP 2:14">దాని స్తంభాలపై కూర్చుంటాయి.</para>
  <para style="q1" vid="ZEP 2:14">వారి కూత కిటికీల గుండా ప్రతిధ్వనిస్తుంది,</para>
  <para style="q2" vid="ZEP 2:14">రాళ్లతో తలుపులు నిండిపోతాయి,</para>
  <para style="q2" vid="ZEP 2:14">దేవదారు దూలాలు నాశనమవుతాయి.<verse eid="ZEP 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 2:15" />ఇది క్షేమకరమైన</para>
  <para style="q2" vid="ZEP 2:15">ఆనందకరమైన పట్టణము.</para>
  <para style="q1" vid="ZEP 2:15">ఆమె తనలో తాను,</para>
  <para style="q2" vid="ZEP 2:15">“నా వంటి పట్టణం మరొకటి లేదని అనుకున్నది.</para>
  <para style="q1" vid="ZEP 2:15">ఆమె ఎంతగా పాడైపోయింది,”</para>
  <para style="q2" vid="ZEP 2:15">క్రూరమృగాలకు గుహలా మారింది!</para>
  <para style="q1" vid="ZEP 2:15">ఆ దారి గుండా వెళ్లే వారందరూ</para>
  <para style="q2" vid="ZEP 2:15">ఎగతాళి చేస్తూ చేతులు ఆడిస్తున్నారు.<verse eid="ZEP 2:15" /></para>
  <chapter eid="ZEP 2" />
  <chapter number="3" style="c" sid="ZEP 3" />
  <para style="s2">యెరూషలేము</para>
  <para style="q1">
    <verse number="1" style="v" sid="ZEP 3:1" />అణచివేత, తిరుగుబాటుతనం,</para>
  <para style="q2" vid="ZEP 3:1">అపవిత్రత నిండిన పట్టణానికి శ్రమ!<verse eid="ZEP 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="ZEP 3:2" />ఆమె ఎవరికీ లోబడదు,</para>
  <para style="q2" vid="ZEP 3:2">ఆమె దిద్దుబాటును అంగీకరించదు.</para>
  <para style="q1" vid="ZEP 3:2">ఆమె యెహోవా మీద నమ్మకముంచదు,</para>
  <para style="q2" vid="ZEP 3:2">ఆమె తన దేవున్ని సమీపించదు.<verse eid="ZEP 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="ZEP 3:3" />దానిలో ఉన్న అధికారులు</para>
  <para style="q2" vid="ZEP 3:3">గర్జించే సింహాలు;</para>
  <para style="q1" vid="ZEP 3:3">దాని పాలకులు రాత్రివేళ తిరుగుతూ,</para>
  <para style="q2" vid="ZEP 3:3">ఉదయానికి ఏమీ మిగల్చకుండా తినే తోడేళ్లు.<verse eid="ZEP 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="ZEP 3:4" />దాని ప్రవక్తలు నీతిలేనివారు;</para>
  <para style="q2" vid="ZEP 3:4">వారు నమ్మకద్రోహులు.</para>
  <para style="q1" vid="ZEP 3:4">దాని యాజకులు పరిశుద్ధస్థలాన్ని అపవిత్రం చేస్తారు</para>
  <para style="q2" vid="ZEP 3:4">ధర్మశాస్త్రాన్ని హింసిస్తారు.<verse eid="ZEP 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="ZEP 3:5" />అయితే యెహోవా నీతిమంతుడు;</para>
  <para style="q2" vid="ZEP 3:5">ఆయన తప్పు చేయరు.</para>
  <para style="q1" vid="ZEP 3:5">అనుదినం ఆయన మానకుండా,</para>
  <para style="q2" vid="ZEP 3:5">ఉదయాన్నే తన న్యాయాన్ని అమలుచేస్తారు,</para>
  <para style="q2" vid="ZEP 3:5">అయినప్పటికీ నీతిలేని వానికి సిగ్గు తెలియదు.<verse eid="ZEP 3:5" /></para>
  <para style="s2">పశ్చాత్తాపపడని యెరూషలేము</para>
  <para style="q1">
    <verse number="6" style="v" sid="ZEP 3:6" />“నేను దేశాలను నాశనం చేశాను;</para>
  <para style="q2" vid="ZEP 3:6">వాటి కోటలు పడగొట్టబడ్డాయి.</para>
  <para style="q1" vid="ZEP 3:6">నేను వాటి వీధులను ఎడారిగా వదిలేశాను,</para>
  <para style="q2" vid="ZEP 3:6">ఎవరూ వాటి గుండా వెళ్లరు.</para>
  <para style="q1" vid="ZEP 3:6">వాటిలో ఎవరూ నివసించకుండా</para>
  <para style="q2" vid="ZEP 3:6">వారి పట్టణాలను నిర్జనంగా చేశాను.<verse eid="ZEP 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ZEP 3:7" />నేను యెరూషలేము గురించి,</para>
  <para style="q2" vid="ZEP 3:7">‘ఖచ్చితంగా నీవు నాకు భయపడి</para>
  <para style="q2" vid="ZEP 3:7">దిద్దుబాటును అంగీకరిస్తావు!</para>
  <para style="q1" vid="ZEP 3:7">అప్పుడు దాని ఆశ్రయ స్థలం<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">పరిశుద్ధాలయం</char></note> నాశనం చేయబడదు,</para>
  <para style="q2" vid="ZEP 3:7">నా శిక్షలేవీ దాని మీదికి<note caller="+" style="f"><char style="fr" closed="false">3:7 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">నేను దాని మీదికి నియమించినవన్నీ</char></note> రావు’ అని అనుకున్నాను.</para>
  <para style="q1" vid="ZEP 3:7">కాని వారు అన్ని రకాల</para>
  <para style="q2" vid="ZEP 3:7">చెడుపనులు చేయాలని ఆతృతగా ఉన్నారు.<verse eid="ZEP 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ZEP 3:8" />కాబట్టి నా కోసం వేచి ఉండండి,”</para>
  <para style="q2" vid="ZEP 3:8">అని యెహోవా ఇలా ప్రకటిస్తున్నారు.</para>
  <para style="q2" vid="ZEP 3:8">“నేను సాక్ష్యం చెప్పడానికి నిలబడే రోజు కోసం వేచి ఉండండి.<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="ft" closed="false">కొ.ప్ర.లలో </char><char style="fqa" closed="false">దోచుకోడానికి లేస్తాను</char></note></para>
  <para style="q1" vid="ZEP 3:8">నేను దేశాలను పోగుచేయాలని,</para>
  <para style="q2" vid="ZEP 3:8">రాజ్యాలను సమకూర్చాలని</para>
  <para style="q1" vid="ZEP 3:8">వాటి మీద నా ఉగ్రతను</para>
  <para style="q2" vid="ZEP 3:8">నా కోపాగ్ని అంతటిని కుమ్మరించాలని నిర్ణయించుకున్నాను.</para>
  <para style="q1" vid="ZEP 3:8">రోషంతో కూడిన నా కోపానికి</para>
  <para style="q2" vid="ZEP 3:8">లోకమంతా దహించబడుతుంది.<verse eid="ZEP 3:8" /></para>
  <para style="s1">మిగిలి ఉన్న ఇశ్రాయేలును పునరుద్ధరించుట</para>
  <para style="q1">
    <verse number="9" style="v" sid="ZEP 3:9" />“నేను ప్రజల పెదవులను శుద్ధి చేస్తాను,</para>
  <para style="q2" vid="ZEP 3:9">అప్పుడు వారంతా యెహోవా నామానికి మొరపెట్టి</para>
  <para style="q2" vid="ZEP 3:9">ఏక మనసుతో ఆయనను సేవిస్తారు.<verse eid="ZEP 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ZEP 3:10" />చెదిరిపోయిన నన్ను ఆరాధించే నా ప్రజలు</para>
  <para style="q2" vid="ZEP 3:10">కూషు<note caller="+" style="f"><char style="fr" closed="false">3:10 </char><char style="ft" closed="false">అంటే, నైలు ఉపరితల ప్రాంతం</char></note> నదుల అవతల నుండి</para>
  <para style="q2" vid="ZEP 3:10">నాకు అర్పణలు తెస్తారు.<verse eid="ZEP 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ZEP 3:11" />ఆ దినాన యెరూషలేమా,</para>
  <para style="q2" vid="ZEP 3:11">నీవు నా మీద తిరుగబడి చేసిన పనుల గురించి నీవు సిగ్గుపడవు,</para>
  <para style="q1" vid="ZEP 3:11">ఎందుకంటే నీ గర్వాన్ని బట్టి సంతోషించేవారిని</para>
  <para style="q2" vid="ZEP 3:11">నేను నీలో నుండి తొలగిస్తాను.</para>
  <para style="q1" vid="ZEP 3:11">నా పరిశుద్ధ కొండపై</para>
  <para style="q2" vid="ZEP 3:11">ఇంకెప్పుడు నీవు గర్వపడవు.<verse eid="ZEP 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ZEP 3:12" />అయితే నేను మీలో</para>
  <para style="q2" vid="ZEP 3:12">సాత్వికులను, దీనులను వదిలివేస్తాను.</para>
  <para style="q1" vid="ZEP 3:12">ఇశ్రాయేలులో మిగిలినవారు</para>
  <para style="q2" vid="ZEP 3:12">యెహోవా నామాన్ని నమ్ముతారు.<verse eid="ZEP 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ZEP 3:13" />ఇశ్రాయేలులో మిగిలినవారు ఏ తప్పు చేయరు;</para>
  <para style="q2" vid="ZEP 3:13">వారు అబద్ధాలు చెప్పరు.</para>
  <para style="q1" vid="ZEP 3:13">మోసపూరిత నాలుక</para>
  <para style="q2" vid="ZEP 3:13">వారి నోళ్లలో ఉండదు.</para>
  <para style="q1" vid="ZEP 3:13">వారు తిని పడుకుంటారు</para>
  <para style="q2" vid="ZEP 3:13">వారికి ఎవరి భయం ఉండదు.”<verse eid="ZEP 3:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="ZEP 3:14" />సీయోను కుమారీ, పాట పాడు;</para>
  <para style="q2" vid="ZEP 3:14">ఇశ్రాయేలూ, బిగ్గరగా కేకవేయి!</para>
  <para style="q1" vid="ZEP 3:14">యెరూషలేము కుమారీ,</para>
  <para style="q2" vid="ZEP 3:14">నీ పూర్ణహృదయంతో సంతోషించి ఆనందించు!<verse eid="ZEP 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ZEP 3:15" />యెహోవా నీ శిక్షను తొలగించారు,</para>
  <para style="q2" vid="ZEP 3:15">నీ శత్రువును తిప్పికొట్టారు.</para>
  <para style="q1" vid="ZEP 3:15">ఇశ్రాయేలు రాజైన యెహోవా నీకు తోడుగా ఉన్నారు;</para>
  <para style="q2" vid="ZEP 3:15">ఇంకెప్పుడు ఏ హానికి నీవు భయపడవు.<verse eid="ZEP 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ZEP 3:16" />ఆ రోజున</para>
  <para style="q2" vid="ZEP 3:16">వారు యెరూషలేముతో,</para>
  <para style="q1" vid="ZEP 3:16">“సీయోనూ, భయపడకు;</para>
  <para style="q2" vid="ZEP 3:16">నీ చేతులను బలహీన పడనివ్వవద్దు.<verse eid="ZEP 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ZEP 3:17" />నీ దేవుడైన యెహోవా,</para>
  <para style="q2" vid="ZEP 3:17">రక్షించే పరాక్రమశాలి నీకు తోడుగా ఉన్నారు.</para>
  <para style="q1" vid="ZEP 3:17">ఆయన నిన్ను చూసి చాలా సంతోషిస్తారు;</para>
  <para style="q2" vid="ZEP 3:17">ఆయన తన ప్రేమను బట్టి ఆయన ఇకపై నిన్ను గద్దించరు,</para>
  <para style="q2" vid="ZEP 3:17">పాడుతూ నిన్ను చూసి సంతోషిస్తారు.”<verse eid="ZEP 3:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="ZEP 3:18" />“నీ నియమించబడిన పండుగలకు రాలేక దుఃఖించే వారందరినీ</para>
  <para style="q2" vid="ZEP 3:18">నేను మీ మధ్య నుండి తొలగిస్తాను.</para>
  <para style="q2" vid="ZEP 3:18">వారు మీకు భారంగా నిందగా ఉన్నారు.<verse eid="ZEP 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ZEP 3:19" />ఆ సమయంలో</para>
  <para style="q2" vid="ZEP 3:19">నిన్ను హింసించిన వారందరిని నేను శిక్షిస్తాను.</para>
  <para style="q1" vid="ZEP 3:19">కుంటివారిని నేను రక్షిస్తాను;</para>
  <para style="q2" vid="ZEP 3:19">చెదరగొట్టబడిన వారిని సమకూరుస్తాను.</para>
  <para style="q1" vid="ZEP 3:19">వారు అవమానానికి గురైన ప్రతి దేశంలో</para>
  <para style="q2" vid="ZEP 3:19">నేను వారికి కీర్తిని, ఘనతను ఇస్తాను.<verse eid="ZEP 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ZEP 3:20" />ఆ సమయంలో నేను మిమ్మల్ని సమకూర్చుతాను;</para>
  <para style="q2" vid="ZEP 3:20">ఆ సమయంలో నేను మిమ్మల్ని ఇంటికి తీసుకువస్తాను.</para>
  <para style="q1" vid="ZEP 3:20">నేను మిమ్మల్ని</para>
  <para style="q2" vid="ZEP 3:20">చెరలో నుండి తిరిగి తీసుకువచ్చినప్పుడు</para>
  <para style="q1" vid="ZEP 3:20">భూమ్మీద ఉన్న ప్రజలందరిలో</para>
  <para style="q2" vid="ZEP 3:20">నేను మీకు కీర్తిని, ఘనతను ఇస్తాను”</para>
  <para style="q2" vid="ZEP 3:20">అని యెహోవా అంటున్నారు.<verse eid="ZEP 3:20" /></para>
  <chapter eid="ZEP 3" />
</usx>