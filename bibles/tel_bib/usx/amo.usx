<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="AMO" style="id">- Biblica® Open Telugu Contemporary Version</book>
  
  <para style="h">ఆమోసు</para>
  <para style="toc1">ఆమోసు ప్రవచనం</para>
  <para style="toc2">ఆమోసు</para>
  <para style="toc3">ఆమోసు</para>
  <para style="mt1">ఆమోసు</para>
  <para style="mt2">ప్రవచనం</para>
  <chapter number="1" style="c" sid="AMO 1" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />యూదాకు రాజుగా ఉజ్జియా, ఇశ్రాయేలు రాజుగా యెహోయాషు<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="ft" closed="false">హెబ్రీలో </char><char style="fqa" closed="false">యోవాషు</char></note> కుమారుడైన యరొబాము ఉన్న సమయంలో, భూకంపం రావడానికి రెండు సంవత్సరాలు ముందే ఇశ్రాయేలు ప్రజలను గురించి తెకోవలోని గొర్రెల కాపరులలో ఒకడైన ఆమోసు చూసిన దర్శనము.<verse eid="AMO 1:1" /></para>
  <para style="b" />
  <para style="b" />
  <para style="p">
    <verse number="2" style="v" sid="AMO 1:2" />ఆమోసు ఇలా చెప్పాడు:</para>
  <para style="q1" vid="AMO 1:2">“యెహోవా సీయోను నుండి గర్జిస్తున్నారు</para>
  <para style="q2" vid="AMO 1:2">యెరూషలేము నుండి ఉరుముతున్నారు;</para>
  <para style="q1" vid="AMO 1:2">కాపరుల పచ్చికబయళ్లు ఎండిపోతున్నాయి,</para>
  <para style="q2" vid="AMO 1:2">కర్మెలు పర్వత శిఖరం వాడిపోతుంది.”<verse eid="AMO 1:2" /></para>
  <para style="s1">ఇశ్రాయేలు పొరుగువారికి తీర్పు</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3" />యెహోవా ఇలా చెప్తున్నారు:</para>
  <para style="q1" vid="AMO 1:3">“దమస్కు చేసిన మూడు పాపాల గురించి,</para>
  <para style="q2" vid="AMO 1:3">దాని నాలుగు పాపాల గురించి నేను దానిని తప్పకుండా శిక్షిస్తాను.</para>
  <para style="q1" vid="AMO 1:3">ఎందుకంటే అది గిలాదును</para>
  <para style="q2" vid="AMO 1:3">ఇనుప పనిముట్లతో నూర్చింది.<verse eid="AMO 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 1:4" />నేను హజాయేలు ఇంటి మీదికి అగ్నిని పంపుతాను,</para>
  <para style="q2" vid="AMO 1:4">అది బెన్-హదదు కోటలను దగ్ధం చేస్తుంది.<verse eid="AMO 1:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 1:5" />దమస్కు ద్వారాన్ని విరగ్గొడతాను;</para>
  <para style="q2" vid="AMO 1:5">ఆవెను<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="fq" closed="false">ఆవెను </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">దుష్టత్వం</char></note> లోయలో ఉన్న రాజును<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">నివాసులను</char></note> నాశనం చేస్తాను</para>
  <para style="q1" vid="AMO 1:5">అతడు బేత్-ఏదెనులో రాజదండం పట్టుకున్నవాడు.</para>
  <para style="q2" vid="AMO 1:5">అరాము ప్రజలు కీరుకు బందీలుగా వెళ్తారు”</para>
  <para style="q2" vid="AMO 1:5">అని యెహోవా చెప్తున్నారు.<verse eid="AMO 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6" />యెహోవా ఇలా చెప్తున్నారు:</para>
  <para style="q1" vid="AMO 1:6">“గాజా చేసిన మూడు పాపాల గురించి,</para>
  <para style="q2" vid="AMO 1:6">నాలుగు పాపాల గురించి నేను దానిని తప్పకుండా శిక్షిస్తాను.</para>
  <para style="q1" vid="AMO 1:6">ఎందుకంటే అది సమాజమంతటిని బందీలుగా తీసుకెళ్లి</para>
  <para style="q2" vid="AMO 1:6">ఎదోముకు అమ్మివేసింది.<verse eid="AMO 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 1:7" />నేను గాజా ప్రాకారాల మీదికి అగ్నిని పంపుతాను,</para>
  <para style="q2" vid="AMO 1:7">అది దాని కోటలను దగ్ధం చేస్తుంది.<verse eid="AMO 1:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 1:8" />నేను అష్డోదు రాజును నాశనం చేస్తాను,</para>
  <para style="q2" vid="AMO 1:8">అతడు అష్కెలోనులో రాజదండం పట్టుకున్నవాడు.</para>
  <para style="q1" vid="AMO 1:8">నేను ఫిలిష్తీయులలో చివరి వారు మరణించే వరకు,</para>
  <para style="q2" vid="AMO 1:8">నేను ఎక్రోనుకు విరుద్ధంగా నా చేతిని ఉంచుతాను”</para>
  <para style="q2" vid="AMO 1:8">అని ప్రభువైన యెహోవా చెప్తున్నారు.<verse eid="AMO 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9" />యెహోవా ఇలా చెప్తున్నారు:</para>
  <para style="q1" vid="AMO 1:9">“తూరు చేసిన మూడు పాపాల గురించి,</para>
  <para style="q2" vid="AMO 1:9">దాని నాలుగు పాపాల గురించి నేను దానిని తప్పకుండా శిక్షిస్తాను.</para>
  <para style="q1" vid="AMO 1:9">ఎందుకంటే సహోదర ఒప్పందాన్ని పరిగణించకుండా,</para>
  <para style="q2" vid="AMO 1:9">అది సమాజమంతటిని బందీలుగా ఎదోముకు అమ్మివేసింది.<verse eid="AMO 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 1:10" />నేను తూరు ప్రాకారాల మీదికి అగ్నిని పంపుతాను,</para>
  <para style="q2" vid="AMO 1:10">అది దాని కోటలను దగ్ధం చేస్తుంది.”<verse eid="AMO 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11" />యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="AMO 1:11">“ఎదోము చేసిన మూడు పాపాల గురించి,</para>
  <para style="q2" vid="AMO 1:11">అతని నాలుగు పాపాల గురించి నేను వారిని తప్పకుండా శిక్షిస్తాను.</para>
  <para style="q1" vid="AMO 1:11">ఎందుకంటే అతడు తన సోదరున్ని ఖడ్గంతో వెంటాడాడు,</para>
  <para style="q2" vid="AMO 1:11">ఆ దేశ స్త్రీలను చంపేశాడు,</para>
  <para style="q1" vid="AMO 1:11">అతని కోపం అధికమవుతూ ఉంది,</para>
  <para style="q2" vid="AMO 1:11">ఎప్పుడూ రగులుతూ ఉంది.<verse eid="AMO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 1:12" />నేను తేమాను మీదికి అగ్నిని పంపుతాను,</para>
  <para style="q2" vid="AMO 1:12">అది బొస్రాలోని కోటలను దగ్ధం చేస్తుంది.”<verse eid="AMO 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13" />యెహోవా ఇలా చెప్తున్నారు:</para>
  <para style="q1" vid="AMO 1:13">“అమ్మోను చేసిన మూడు పాపాల గురించి,</para>
  <para style="q2" vid="AMO 1:13">అతని నాలుగు పాపాల గురించి నేను దానిని తప్పకుండా శిక్షిస్తాను.</para>
  <para style="q1" vid="AMO 1:13">ఎందుకంటే అతడు తన సరిహద్దులను విశాల పరచడానికి,</para>
  <para style="q2" vid="AMO 1:13">గిలాదులో ఉన్న గర్భిణి స్త్రీల కడుపులను చీల్చాడు.<verse eid="AMO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 1:14" />నేను రబ్బా ప్రాకారాలను తగలబెడతాను,</para>
  <para style="q2" vid="AMO 1:14">యుద్ధం రోజున యుద్ధ నినాదాల మధ్యలో,</para>
  <para style="q1" vid="AMO 1:14">తుఫాను రోజున పెనుగాలి వీస్తూ ఉన్నప్పుడు,</para>
  <para style="q2" vid="AMO 1:14">అగ్ని దాని కోటలను దగ్ధం చేస్తుంది.<verse eid="AMO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 1:15" />దాని రాజు, తన రాజ పరివారంతో పాటు</para>
  <para style="q2" vid="AMO 1:15">బందీగా వెళ్తాడు”</para>
  <para style="q2" vid="AMO 1:15">అని యెహోవా చెప్తున్నారు.<verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" sid="AMO 2" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1" />యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="AMO 2:1">“మోయాబు చేసిన మూడు పాపాల గురించి,</para>
  <para style="q2" vid="AMO 2:1">అతని నాలుగు పాపాల గురించి నేను అతన్ని తప్పకుండా శిక్షిస్తాను.</para>
  <para style="q1" vid="AMO 2:1">ఎందుకంటే అతడు ఎదోము రాజు ఎముకలను</para>
  <para style="q2" vid="AMO 2:1">కాల్చి బూడిద చేశాడు.<verse eid="AMO 2:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 2:2" />నేను మోయాబు మీదికి అగ్నిని పంపుతాను,</para>
  <para style="q2" vid="AMO 2:2">అది కెరీయోతు కోటలను<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">దాని పట్టణాలు</char></note> దగ్ధం చేస్తుంది.</para>
  <para style="q1" vid="AMO 2:2">యుద్ధ నినాదాల మధ్యలో, బూర శబ్దం వినబడినప్పుడు,</para>
  <para style="q2" vid="AMO 2:2">మోయాబు గొప్ప కలవరంతో అంతరిస్తుంది.<verse eid="AMO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 2:3" />నేను దాని పరిపాలకున్ని నిర్మూలిస్తాను,</para>
  <para style="q2" vid="AMO 2:3">అతనితో పాటు దాని అధిపతులందరినీ హతం చేస్తాను,”</para>
  <para style="q2" vid="AMO 2:3">అని యెహోవా చెప్తున్నారు.<verse eid="AMO 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4" />యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="AMO 2:4">“యూదా వారు చేసిన మూడు పాపాల గురించి,</para>
  <para style="q2" vid="AMO 2:4">వారి నాలుగు పాపాల గురించి నేను వారిని తప్పకుండా శిక్షిస్తాను,</para>
  <para style="q1" vid="AMO 2:4">ఎందుకంటే వారు యెహోవా ఉపదేశాలను విసర్జించారు,</para>
  <para style="q2" vid="AMO 2:4">ఆయన శాసనాలను పాటించలేదు,</para>
  <para style="q1" vid="AMO 2:4">వారి పూర్వికులు అనుసరించిన అబద్ధ దేవుళ్ళను<note caller="+" style="f"><char style="fr" closed="false">2:4 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">అబద్ధాలను</char></note> నమ్ముకొని,</para>
  <para style="q2" vid="AMO 2:4">వారి వల్ల దారి తప్పారు.<verse eid="AMO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 2:5" />నేను యూదా మీదికి అగ్నిని పంపుతాను,</para>
  <para style="q2" vid="AMO 2:5">అది యెరూషలేము కోటలను దగ్ధం చేస్తుంది.”<verse eid="AMO 2:5" /></para>
  <para style="s1">ఇశ్రాయేలు మీద తీర్పు</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6" />యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="AMO 2:6">“ఇశ్రాయేలు చేసిన మూడు పాపాల గురించి,</para>
  <para style="q2" vid="AMO 2:6">వారి నాలుగు పాపాల గురించి నేను వారిని తప్పకుండా శిక్షిస్తాను,</para>
  <para style="q1" vid="AMO 2:6">వారు నిర్దోషులను వెండి కోసం అమ్మారు,</para>
  <para style="q2" vid="AMO 2:6">బీదలను చెప్పుల కోసం అమ్మారు.<verse eid="AMO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 2:7" />వారు నేల మట్టిని త్రొక్కినట్టు</para>
  <para style="q2" vid="AMO 2:7">బీదల తలలను త్రొక్కుతున్నారు</para>
  <para style="q2" vid="AMO 2:7">హింసించబడే వారికి న్యాయం జరగనివ్వలేదు.</para>
  <para style="q1" vid="AMO 2:7">తండ్రీ, కుమారులు ఒకే స్త్రీ దగ్గరకు వెళ్లారు</para>
  <para style="q2" vid="AMO 2:7">అలా నా పరిశుద్ధ నామాన్ని అవమానపరిచారు.<verse eid="AMO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 2:8" />తాకట్టు పెట్టిన బట్టలు అప్పగించకుండా,</para>
  <para style="q2" vid="AMO 2:8">ప్రతి బలిపీఠం దగ్గర వాటిని పరుచుకొని పడుకుంటారు.</para>
  <para style="q1" vid="AMO 2:8">వారు జరిమానాలతో కొనుక్కున్న ద్రాక్షరసాన్ని,</para>
  <para style="q2" vid="AMO 2:8">తమ దేవుని మందిరంలోనే త్రాగుతారు.<verse eid="AMO 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 2:9" />“దేవదారు వృక్షమంత ఎత్తుగా, అయినా నేను వారి</para>
  <para style="q2" vid="AMO 2:9">సింధూర వృక్షమంత బలంగా ఉన్న,</para>
  <para style="q2" vid="AMO 2:9">అమోరీయులను వారి ఎదుట ఉండకుండా నేను నాశనం చేశాను.</para>
  <para style="q1" vid="AMO 2:9">నేను పైనున్న వారి ఫలాన్ని,</para>
  <para style="q2" vid="AMO 2:9">క్రిందున్న వారి వేరును నాశనం చేశాను.<verse eid="AMO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 2:10" />అమోరీయుల దేశాన్ని మీరు స్వాధీనపరచుకోవాలని,</para>
  <para style="q2" vid="AMO 2:10">నేను మిమ్మల్ని ఈజిప్టు నుండి బయటకు తీసుకువచ్చి,</para>
  <para style="q2" vid="AMO 2:10">నలభై సంవత్సరాలు అరణ్యంలో నడిపించాను.<verse eid="AMO 2:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 2:11" />“అంతేకాక నేను మీ సంతానం నుండి ప్రవక్తలను,</para>
  <para style="q2" vid="AMO 2:11">మీ యవకులలో నుండి నాజీరులను లేవనెత్తాను.</para>
  <para style="q1" vid="AMO 2:11">ఇశ్రాయేలీయులారా! ఇది నిజం కాదా?”</para>
  <para style="q2" vid="AMO 2:11">అని యెహోవా ప్రకటిస్తున్నారు.<verse eid="AMO 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 2:12" />“అయితే మీరు నాజీరులతో ద్రాక్షరసం త్రాగించారు,</para>
  <para style="q2" vid="AMO 2:12">ప్రవచించ వద్దని ప్రవక్తలను ఆదేశించారు.<verse eid="AMO 2:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="AMO 2:13" />“కాబట్టి ధాన్యపు మోపులతో నిండిన బండి నేలను అణగద్రొక్కినట్టు,</para>
  <para style="q2" vid="AMO 2:13">ఇప్పుడు నేను మిమ్మల్ని అణగద్రొక్కుతాను.<verse eid="AMO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 2:14" />వేగంగా పరుగెత్తేవారు తప్పించుకోలేరు,</para>
  <para style="q2" vid="AMO 2:14">బలాఢ్యులు ధైర్యం తెచ్చుకోలేరు,</para>
  <para style="q2" vid="AMO 2:14">వీరుడు తన ప్రాణాన్ని రక్షించుకోలేడు.<verse eid="AMO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 2:15" />విలుకాడు నిలబడలేడు,</para>
  <para style="q2" vid="AMO 2:15">బాగా పరుగెత్తగల సైనికుడు తప్పించుకోలేడు,</para>
  <para style="q2" vid="AMO 2:15">గుర్రపురౌతు తన ప్రాణాన్ని కాపాడుకోలేడు.<verse eid="AMO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="AMO 2:16" />ఆ రోజున ధైర్యవంతులైన వీరులు కూడా</para>
  <para style="q2" vid="AMO 2:16">దిగంబరులై పారిపోతారు,”</para>
  <para style="q2" vid="AMO 2:16">అని యెహోవా ప్రకటిస్తున్నారు.<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" sid="AMO 3" />
  <para style="s1">ఇశ్రాయేలుకు వ్యతిరేకంగా పిలువబడిన సాక్షులు</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />ఇశ్రాయేలీయులారా! యెహోవా ఈజిప్టు నుండి బయటకు తెచ్చిన కుటుంబమంతటి గురించి నేను పలికిన ఈ మాట వినండి:<verse eid="AMO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 3:2" />“భూలోకంలోని కుటుంబాలన్నిటి నుండి</para>
  <para style="q2" vid="AMO 3:2">మిమ్మల్ని మాత్రమే ఎన్నుకున్నాను.</para>
  <para style="q1" vid="AMO 3:2">కాబట్టి మీరు చేసిన పాపాలన్నిటిని బట్టి</para>
  <para style="q2" vid="AMO 3:2">నేను మిమ్మల్ని శిక్షిస్తాను.”<verse eid="AMO 3:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="AMO 3:3" />పరస్పర సమ్మతి లేకుండా</para>
  <para style="q2" vid="AMO 3:3">ఇద్దరూ కలిసి నడుస్తారా?<verse eid="AMO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 3:4" />ఆహారం దొరకక పోతే,</para>
  <para style="q2" vid="AMO 3:4">సింహం అడవిలో గర్జిస్తుందా?</para>
  <para style="q1" vid="AMO 3:4">దేనినీ పట్టుకోకుండానే</para>
  <para style="q2" vid="AMO 3:4">అది దాని గుహలో గుర్రుమంటుందా?<verse eid="AMO 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 3:5" />నేల మీద ఎరపెట్టనిదే,</para>
  <para style="q2" vid="AMO 3:5">పక్షి ఉరిలో చిక్కుకుంటుందా?</para>
  <para style="q1" vid="AMO 3:5">ఉరిలో ఏదీ చిక్కకపోతే,</para>
  <para style="q2" vid="AMO 3:5">ఆ ఉరి నేల నుండి పైకి లేస్తుందా?<verse eid="AMO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 3:6" />పట్టణంలో బూరధ్వని వినబడితే,</para>
  <para style="q2" vid="AMO 3:6">ప్రజలు వణకరా?</para>
  <para style="q1" vid="AMO 3:6">పట్టణంలో విపత్తు వచ్చినప్పుడు</para>
  <para style="q2" vid="AMO 3:6">అది యెహోవా పంపింది కాదా?<verse eid="AMO 3:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 3:7" />తన సేవకులైన ప్రవక్తలకు</para>
  <para style="q2" vid="AMO 3:7">తన ప్రణాళికను తెలియజేయకుండా</para>
  <para style="q2" vid="AMO 3:7">ప్రభువైన యెహోవా ఏదీ చేయరు.<verse eid="AMO 3:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 3:8" />సింహం గర్జించింది,</para>
  <para style="q2" vid="AMO 3:8">భయపడని వారెవరు?</para>
  <para style="q1" vid="AMO 3:8">ప్రభువైన యెహోవా చెప్పారు</para>
  <para style="q2" vid="AMO 3:8">దానిని ప్రవచించకుండ ఉన్నవారెవరు?<verse eid="AMO 3:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 3:9" />అష్డోదు కోటలకు ఇలా చాటించండి,</para>
  <para style="q2" vid="AMO 3:9">ఈజిప్టు కోటలకు ఇలా చాటించండి:</para>
  <para style="q1" vid="AMO 3:9">“సమరయ పర్వతాలమీద కూడుకోండి;</para>
  <para style="q2" vid="AMO 3:9">దానిలో జరుగుతున్న గొప్ప అల్లరిని,</para>
  <para style="q2" vid="AMO 3:9">దాని ప్రజలమధ్య ఉన్న దౌర్జన్యాన్ని చూడండి.”<verse eid="AMO 3:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 3:10" />“సరియైనది ఎలా చేయాలో వారికి తెలియదు,”</para>
  <para style="q2" vid="AMO 3:10">అని యెహోవా చెప్తున్నారు,</para>
  <para style="q1" vid="AMO 3:10">“వారు తమ కోటలలో</para>
  <para style="q2" vid="AMO 3:10">తాము కొల్లగొట్టిన దోపుడుసొమ్మును దాచుకుంటారు.”<verse eid="AMO 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 3:11" />కాబట్టి ప్రభువైన యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="AMO 3:11">“శత్రువు నీ ప్రాంతంలో చొరబడతాడు,</para>
  <para style="q2" vid="AMO 3:11">మీ దుర్గాలను పడగొడతాడు,</para>
  <para style="q2" vid="AMO 3:11">మీ కోటలను దోచుకుంటాడు.”<verse eid="AMO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12" />యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="AMO 3:12">“గొర్రెల కాపరి సింహం నోటి నుండి విడిపించేటప్పుడు,</para>
  <para style="q2" vid="AMO 3:12">దాని రెండు కాళ్లను గాని లేదా చెవి ముక్కను గాని విడిపించినట్లుగా,</para>
  <para style="q1" vid="AMO 3:12">సమరయలో మంచాల మీద</para>
  <para style="q2" vid="AMO 3:12">పట్టు దిండ్లమీద కూర్చుని ఉన్న,</para>
  <para style="q2" vid="AMO 3:12">ఇశ్రాయేలీయులు రక్షించబడతారు.”<verse eid="AMO 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 3:13" />“దీనిని విని, యాకోబు వారసులకు వ్యతిరేకంగా తెలియజేయండి” అని ప్రభువు, సైన్యాల యెహోవా దేవుడు చెప్తున్నారు.<verse eid="AMO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 3:14" />“ఇశ్రాయేలు పాపాలను శిక్షించే రోజున</para>
  <para style="q2" vid="AMO 3:14">బేతేలులోని బలిపీఠాలను నేను నాశనం చేస్తాను;</para>
  <para style="q2" vid="AMO 3:14">ఆ బలిపీఠపు కొమ్మలు విరగ్గొట్టబడి నేలరాలుతాయి.<verse eid="AMO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 3:15" />చలికాలపు విడిది భవనాన్ని,</para>
  <para style="q2" vid="AMO 3:15">ఎండకాలపు విడిది భవనాన్ని పడగొడతాను;</para>
  <para style="q1" vid="AMO 3:15">ఏనుగు దంతంతో అలంకరించబడ్డ భవనాలు నాశనమవుతాయి</para>
  <para style="q2" vid="AMO 3:15">గొప్ప భవనాలు నిర్మూలించబడతాయి,”</para>
  <para style="q2" vid="AMO 3:15">అని యెహోవా చెప్తున్నారు.<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" sid="AMO 4" />
  <para style="s1">ఇశ్రాయేలు దేవుని దగ్గరకు తిరిగి రాలేదు</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 4:1" />సమరయ పర్వతం మీద తిరిగే బాషాను ఆవులారా!</para>
  <para style="q2" vid="AMO 4:1">దిక్కులేని వారిని బాధిస్తూ, బీదలను అణగద్రొక్కుతూ</para>
  <para style="q2" vid="AMO 4:1">“మాకు కొంచెం మద్యం తీసుకురండి!”</para>
  <para style="q2" vid="AMO 4:1">అని భర్తలకు చెప్పే స్త్రీలారా, ఈ మాట వినండి.<verse eid="AMO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 4:2" />ప్రభువైన యెహోవా తన పవిత్రత తోడని ప్రమాణం చేశారు:</para>
  <para style="q2" vid="AMO 4:2">“మిమ్మల్ని కొంకులతో పట్టుకుని,</para>
  <para style="q1" vid="AMO 4:2">మీలో మిగిలిన వారిని గాలంతో పట్టుకుని</para>
  <para style="q2" vid="AMO 4:2">తీసుకెళ్లే కాలం ఖచ్చితంగా రాబోతుంది.<verse eid="AMO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 4:3" />మీరంతా ప్రాకారాలలో పగుళ్ళ గుండా</para>
  <para style="q2" vid="AMO 4:3">తిన్నగా పోతారు.</para>
  <para style="q1" vid="AMO 4:3">మీరు హర్మోను వైపుకు పారవేయబడతారు,”</para>
  <para style="q2" vid="AMO 4:3">అని యెహోవా చెప్తున్నారు.<verse eid="AMO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 4:4" />“బేతేలుకు వెళ్లి పాపం చేయండి;</para>
  <para style="q2" vid="AMO 4:4">గిల్గాలుకు వెళ్లి ఇంకా ఎక్కువ పాపం చేయండి.</para>
  <para style="q1" vid="AMO 4:4">ప్రతి ఉదయం మీ బలులు తీసుకరండి,</para>
  <para style="q2" vid="AMO 4:4">మూడు సంవత్సరాలకు<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">రోజులు</char></note> ఒకసారి మీ దశమ భాగాల్ని తీసుకురండి.<verse eid="AMO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 4:5" />పులిసిన రొట్టెను కృతజ్ఞతార్పణగా కాల్చండి</para>
  <para style="q2" vid="AMO 4:5">మీ స్వేచ్ఛార్పణల గురించి ప్రకటించండి.</para>
  <para style="q1" vid="AMO 4:5">ఇశ్రాయేలీయులారా, వాటి గురించి ప్రకటన చేయండి,</para>
  <para style="q2" vid="AMO 4:5">ఇలా చేయడం మీకు చాలా ఇష్టం కదా”</para>
  <para style="q2" vid="AMO 4:5">అని ప్రభువైన యెహోవా అంటున్నారు.<verse eid="AMO 4:5" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="6" style="v" sid="AMO 4:6" />“మీ ప్రతి పట్టణానికి తినడానికి ఏమీ దొరక్కుండా చేశాను,</para>
  <para style="q2" vid="AMO 4:6">ప్రతి పట్టణంలో ఆహారం లేకుండ చేశాను,</para>
  <para style="q1" vid="AMO 4:6">అయినా మీరు నా వైపు తిరగలేదు”</para>
  <para style="q2" vid="AMO 4:6">అని యెహోవా ప్రకటిస్తున్నారు.<verse eid="AMO 4:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 4:7" />“కోతకాలానికి మూడు నెలలు ముందు</para>
  <para style="q2" vid="AMO 4:7">వర్షం కురవకుండా చేశాను,</para>
  <para style="q1" vid="AMO 4:7">నేను ఒక పట్టణం మీద వర్షం కురిపించి,</para>
  <para style="q2" vid="AMO 4:7">మరో పట్టణం మీద కురిపించలేదు.</para>
  <para style="q1" vid="AMO 4:7">ఒక పొలం మీద వర్షం కురిసింది;</para>
  <para style="q2" vid="AMO 4:7">వర్షం లేనిచోటు ఎండిపోయింది.<verse eid="AMO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 4:8" />ప్రజలు నీళ్ల కోసం పట్టణం నుండి పట్టణానికి తడబడుతూ వెళ్లారు</para>
  <para style="q2" vid="AMO 4:8">కాని వారికి త్రాగడానికి సరిపడా నీళ్లు దొరకలేదు.</para>
  <para style="q1" vid="AMO 4:8">అయినా మీరు నా వైపు తిరగలేదు”</para>
  <para style="q2" vid="AMO 4:8">అని యెహోవా అంటున్నారు.<verse eid="AMO 4:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="AMO 4:9" />“ఎన్నోసార్లు నేను మీ తోటలను, ద్రాక్షతోటలను</para>
  <para style="q2" vid="AMO 4:9">వడగాలి వల్ల కాటుక తెగుళ్ళ వల్ల పాడు చేశాను.</para>
  <para style="q1" vid="AMO 4:9">మిడతలు మీ అంజూర చెట్లను ఒలీవ చెట్లను మ్రింగివేశాయి.</para>
  <para style="q2" vid="AMO 4:9">అయినా మీరు నా వైపు తిరగలేదు”</para>
  <para style="q2" vid="AMO 4:9">అని యెహోవా అంటున్నారు.<verse eid="AMO 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 4:10" />“నేను ఈజిప్టు మీదికి రప్పించినట్లు</para>
  <para style="q2" vid="AMO 4:10">మీ మీదికి తెగుళ్ళు రప్పించాను.</para>
  <para style="q1" vid="AMO 4:10">మీరు కొల్లగొట్టిన గుర్రాలతో పాటు</para>
  <para style="q2" vid="AMO 4:10">మీ యువకులను కత్తితో చంపాను.</para>
  <para style="q1" vid="AMO 4:10">మీ శిబిరాల పుట్టిన దుర్వాసన మీ ముక్కు పుటలను చేరింది.</para>
  <para style="q2" vid="AMO 4:10">అయినా మీరు నా వైపుకు తిరగలేదు”</para>
  <para style="q2" vid="AMO 4:10">అని యెహోవా అంటున్నారు.<verse eid="AMO 4:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 4:11" />“నేను సొదొమ గొమొర్రా పట్టణాలను పడగొట్టినట్టు</para>
  <para style="q2" vid="AMO 4:11">మీలో కొంతమందిని పడగొట్టాను.</para>
  <para style="q1" vid="AMO 4:11">మీరు మంటలో నుండి లాగివేసిన కట్టెలా ఉన్నారు,</para>
  <para style="q2" vid="AMO 4:11">అయినా మీరు నా వైపుకు తిరగలేదు,</para>
  <para style="q2" vid="AMO 4:11">అని యెహోవా అంటున్నారు.<verse eid="AMO 4:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="AMO 4:12" />“కాబట్టి ఇశ్రాయేలూ, నేను నీకు చేసేది ఇదే,</para>
  <para style="q2" vid="AMO 4:12">ఇశ్రాయేలూ, నేను ఇలా చేస్తాను కాబట్టి</para>
  <para style="q2" vid="AMO 4:12">నీ దేవుని కలుసుకోడానికి సిద్ధపడు.”<verse eid="AMO 4:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="AMO 4:13" />పర్వతాలను ఏర్పరచింది</para>
  <para style="q2" vid="AMO 4:13">గాలిని సృష్టించింది ఆయనే,</para>
  <para style="q2" vid="AMO 4:13">తన ఆలోచనలను మనుష్యులకు వెల్లడి చేసేది,</para>
  <para style="q1" vid="AMO 4:13">ఉదయాన్ని చీకటిగా మార్చేది ఆయనే,</para>
  <para style="q2" vid="AMO 4:13">భూమి ఎత్తైన స్థలాల్లో ఆయన నడుస్తారు</para>
  <para style="q2" vid="AMO 4:13">ఆయన పేరు దేవుడైన సైన్యాల యెహోవా.<verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" sid="AMO 5" />
  <para style="s1">విలాపం పశ్చాత్తాపానికి పిలుపు</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1" />ఇశ్రాయేలూ! ఈ మాట విను, ఇది మిమ్మల్ని గురించి విలాప వాక్కు:<verse eid="AMO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 5:2" />“ఇశ్రాయేలు కన్య పడిపోయింది,</para>
  <para style="q2" vid="AMO 5:2">ఆమె మరి ఎన్నడు లేవదు,</para>
  <para style="q1" vid="AMO 5:2">ఆమెను లేపడానికి ఎవరూ లేక</para>
  <para style="q2" vid="AMO 5:2">తన సొంత నేలపై పడి ఉంది.”<verse eid="AMO 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3" />ప్రభువైన యెహోవా ఇశ్రాయేలుతో చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="AMO 5:3">“నీ పట్టణం నుండి వేయిమంది బలమైన వారు బయలుదేరితే,</para>
  <para style="q2" vid="AMO 5:3">వందమంది మాత్రమే మిగులుతారు.</para>
  <para style="q1" vid="AMO 5:3">నీ పట్టణం నుండి వందమంది బలమైన వారు బయలుదేరితే</para>
  <para style="q2" vid="AMO 5:3">పదిమంది మాత్రమే మిగులుతారు.”<verse eid="AMO 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4" />యెహోవా ఇశ్రాయేలుతో చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="AMO 5:4">“నన్ను వెదికితే బ్రతుకుతారు.<verse eid="AMO 5:4" /></para>
  <para style="q2">
    <verse number="5" style="v" sid="AMO 5:5" />బేతేలును ఆశ్రయించకండి;</para>
  <para style="q1" vid="AMO 5:5">గిల్గాలు క్షేత్రాలకు వెళ్లకండి,</para>
  <para style="q2" vid="AMO 5:5">బెయేర్షేబకు ప్రయాణించకండి.</para>
  <para style="q1" vid="AMO 5:5">గిల్గాలు ప్రజలు ఖచ్చితంగా బందీలుగా వెళ్తారు,</para>
  <para style="q2" vid="AMO 5:5">విపత్తులతో బేతేలు శూన్యంగా మారుతుంది.”<verse eid="AMO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 5:6" />యెహోవాను వెదకండి మీరు బ్రతుకుతారు,</para>
  <para style="q2" vid="AMO 5:6">లేదంటే యోసేపు గోత్రాల మీద ఆయన అగ్నిలా పడతారు;</para>
  <para style="q1" vid="AMO 5:6">అది వారిని కాల్చివేస్తుంది</para>
  <para style="q2" vid="AMO 5:6">బేతేలులో దాన్ని ఆర్పివేయగల వారెవరూ ఉండరు.<verse eid="AMO 5:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 5:7" />వారు న్యాయాన్ని చేదుగా మార్చి</para>
  <para style="q2" vid="AMO 5:7">నీతిని నేల మీద పడవేస్తారు.<verse eid="AMO 5:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 5:8" />ఆయన సప్తర్షి నక్షత్రాలను మృగశీర్ష నక్షత్రాలను సృష్టించారు,</para>
  <para style="q2" vid="AMO 5:8">ఆయన మధ్యరాత్రిని ఉదయంగా మారుస్తారు,</para>
  <para style="q2" vid="AMO 5:8">పగటిని చీకటి చేస్తారు.</para>
  <para style="q1" vid="AMO 5:8">ఆయన సముద్రంలోని నీటిని రప్పించి.</para>
  <para style="q2" vid="AMO 5:8">భూమి మీద కుమ్మరిస్తారు</para>
  <para style="q2" vid="AMO 5:8">ఆయన పేరు యెహోవా.<verse eid="AMO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 5:9" />ఆయన మెరుపు వేగంతో దుర్గాన్ని నాశనం చేస్తారు,</para>
  <para style="q2" vid="AMO 5:9">వారి కోటగల పట్టణాన్ని నాశనం చేస్తారు.<verse eid="AMO 5:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="AMO 5:10" />న్యాయస్థానంలో న్యాయం కోసం నిలబడే వారిని</para>
  <para style="q2" vid="AMO 5:10">యథార్థంగా మాట్లాడేవారిని ద్వేషించేవారు మీలో ఉన్నారు.<verse eid="AMO 5:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 5:11" />మీరు బీదలను అణగద్రొక్కుతూ,</para>
  <para style="q2" vid="AMO 5:11">వారి ధాన్యం మీద పన్ను వేస్తారు.</para>
  <para style="q1" vid="AMO 5:11">కాబట్టి మీరు రాళ్లతో భవనాలను కట్టుకున్నా,</para>
  <para style="q2" vid="AMO 5:11">వాటిలో కాపురముండరు;</para>
  <para style="q1" vid="AMO 5:11">అందమైన ద్రాక్షతోటలు నాటినా</para>
  <para style="q2" vid="AMO 5:11">మీరు ఆ పండ్ల రసం త్రాగరు.<verse eid="AMO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 5:12" />ఎందుకంటే మీ అపరాధాలు ఎన్ని ఉన్నాయో</para>
  <para style="q2" vid="AMO 5:12">మీ పాపాలు ఎంత ఘోరమైనవో నాకు తెలుసు.</para>
  <para style="b" vid="AMO 5:12" />
  <para style="q1" vid="AMO 5:12">మీరు లంచాలు తీసుకుని అమాయకులను బాధిస్తారు,</para>
  <para style="q2" vid="AMO 5:12">న్యాయస్థానంలో వచ్చే బీదలకు న్యాయం జరగనివ్వరు.<verse eid="AMO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 5:13" />ఇది చెడుకాలం కాబట్టి,</para>
  <para style="q2" vid="AMO 5:13">అలాంటి సమయాల్లో వివేకవంతులు మౌనంగా ఉంటారు.<verse eid="AMO 5:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="AMO 5:14" />చెడును విడిచిపెట్టి మంచిని వెదకండి,</para>
  <para style="q2" vid="AMO 5:14">అప్పుడు మీరు బ్రతుకుతారు.</para>
  <para style="q1" vid="AMO 5:14">అప్పుడు ఆయన గురించి మీరనుకున్న విధంగా</para>
  <para style="q2" vid="AMO 5:14">సైన్యాల యెహోవా దేవుడు మీతో ఉంటారు.<verse eid="AMO 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 5:15" />చెడును ద్వేషించి మంచిని ప్రేమించండి;</para>
  <para style="q2" vid="AMO 5:15">న్యాయస్థానాల్లో న్యాయం జరిగించండి.</para>
  <para style="q1" vid="AMO 5:15">బహుశ సైన్యాల యెహోవా దేవుడు,</para>
  <para style="q2" vid="AMO 5:15">యోసేపు వంశంలో మిగిలి ఉన్నవారిపై దయ చూపిస్తారేమో.<verse eid="AMO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16" />కాబట్టి ప్రభువు, సైన్యాల యెహోవా దేవుడు చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="AMO 5:16">“వీధులన్నిటిలో విలాపం ఉండబోతుంది</para>
  <para style="q2" vid="AMO 5:16">ప్రతి రాజ మార్గంలో వేదనతో కూడిన ఏడ్పులు.</para>
  <para style="q1" vid="AMO 5:16">ఏడ్వడానికి రైతులను</para>
  <para style="q2" vid="AMO 5:16">దుఃఖపడడానికి విలపించేవారిని పిలుస్తారు.<verse eid="AMO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="AMO 5:17" />ద్రాక్షతోటలన్నిటిలో శోకం ఉంటుంది,</para>
  <para style="q2" vid="AMO 5:17">ఎందుకంటే నేను మీ మధ్యలో సంచరిస్తాను,”</para>
  <para style="q2" vid="AMO 5:17">అని యెహోవా అంటున్నారు.<verse eid="AMO 5:17" /></para>
  <para style="s1">యెహోవా దినం</para>
  <para style="q1">
    <verse number="18" style="v" sid="AMO 5:18" />యెహోవా దినం రావాలని ఆశించే</para>
  <para style="q2" vid="AMO 5:18">మీకు శ్రమ!</para>
  <para style="q1" vid="AMO 5:18">యెహోవా దినం కోసం ఎందుకు మీరు ఆశిస్తున్నారు?</para>
  <para style="q2" vid="AMO 5:18">ఆ దినం వెలుగుగా కాదు, చీకటిగా ఉంటుంది.<verse eid="AMO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="AMO 5:19" />అది ఒక మనిషి సింహం నుండి తప్పించుకుని</para>
  <para style="q2" vid="AMO 5:19">ఎలుగుబంటి ఎదురు పడినట్లు,</para>
  <para style="q1" vid="AMO 5:19">అతడు ఇంట్లోకి ప్రవేశించి</para>
  <para style="q2" vid="AMO 5:19">గోడ మీద చేయి పెడితే</para>
  <para style="q2" vid="AMO 5:19">పాము కరిచినట్టుగా ఉంటుంది.<verse eid="AMO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="AMO 5:20" />యెహోవా దినం వెలుగుగా కాకుండా అంధకారంగా ఉంటుంది కదా,</para>
  <para style="q2" vid="AMO 5:20">ఒక్క కాంతి కిరణం కూడా లేకుండ కారుచీకటిగా ఉంటుంది కదా?<verse eid="AMO 5:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="AMO 5:21" />“మీ పండుగలంటే నాకు అసహ్యం, వాటిని నేను ద్వేషిస్తాను;</para>
  <para style="q2" vid="AMO 5:21">మీ సమావేశాల్లో నేను సంతోషించను.<verse eid="AMO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="AMO 5:22" />మీరు నాకు దహనబలులు, భోజనార్పణలు సమర్పించినా,</para>
  <para style="q2" vid="AMO 5:22">నేను వాటిని స్వీకరించను.</para>
  <para style="q1" vid="AMO 5:22">మీరు క్రొవ్విన జంతువులను సమాధానబలులుగా సమర్పించినా,</para>
  <para style="q2" vid="AMO 5:22">నేను వాటిని లెక్కచేయను.<verse eid="AMO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="AMO 5:23" />మీ పాటల ధ్వని నా నుండి తీసివేయండి!</para>
  <para style="q2" vid="AMO 5:23">మీ సితారాల సంగీతం నేను వినను.<verse eid="AMO 5:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="AMO 5:24" />అయితే న్యాయం నదీ ప్రవాహంలా,</para>
  <para style="q2" vid="AMO 5:24">నీతి ఎన్నడూ ఎండిపోని కాలువలా ప్రవహించాలి.<verse eid="AMO 5:24" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="25" style="v" sid="AMO 5:25" />“ఇశ్రాయేలు ప్రజలారా, అరణ్యంలో నలభై సంవత్సరాలు,</para>
  <para style="q2" vid="AMO 5:25">మీరు నాకు బలులు, అర్పణలు తెచ్చారా?<verse eid="AMO 5:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="AMO 5:26" />మీరు మీ సక్కూతు రాజ దేవుని క్షేత్రాన్ని,</para>
  <para style="q2" vid="AMO 5:26">మీ కైవాన్ విగ్రహాలను,</para>
  <para style="q2" vid="AMO 5:26">మీ కోసం మోసుకొచ్చారు.</para>
  <para style="q2" vid="AMO 5:26">అది మీరు మీ కోసం చేసుకుంది.<verse eid="AMO 5:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="AMO 5:27" />కాబట్టి నేను మిమ్మల్ని దమస్కు అవతలికి బందీలుగా పంపిస్తాను,”</para>
  <para style="q2" vid="AMO 5:27">అని సైన్యాల దేవుడు అని పేరు కలిగిన యెహోవా అంటున్నారు.<verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" sid="AMO 6" />
  <para style="s1">సంతృప్తి గలవారికి శ్రమ</para>
  <para style="q1">
    <verse number="1" style="v" sid="AMO 6:1" />సీయోనులో సంతృప్తిగా ఉన్నవారికి శ్రమ,</para>
  <para style="q2" vid="AMO 6:1">సమరయ పర్వతం మీద ఆధారపడి ఉన్న మీకు శ్రమ,</para>
  <para style="q1" vid="AMO 6:1">ఇశ్రాయేలు ప్రజలకు సలహాదారులుగా ఉన్న,</para>
  <para style="q2" vid="AMO 6:1">గొప్ప దేశాల్లో ప్రముఖులైన మీకు శ్రమ!<verse eid="AMO 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 6:2" />మీరు కల్నేకు వెళ్లి చూడండి;</para>
  <para style="q2" vid="AMO 6:2">అక్కడినుండి హమాతుకు<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">మహా హమాతు</char></note> వెళ్లండి,</para>
  <para style="q2" vid="AMO 6:2">తర్వాత ఫిలిష్తీయలోని గాతుకు వెళ్లండి.</para>
  <para style="q1" vid="AMO 6:2">మీ రెండు రాజ్యాల కంటే అవి గొప్పవా?</para>
  <para style="q2" vid="AMO 6:2">వాటి నేల మీకంటే పెద్దది కాదా?<verse eid="AMO 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 6:3" />ఆపద్దినం దూరంగా ఉందనుకుని,</para>
  <para style="q2" vid="AMO 6:3">దౌర్జన్య పరిపాలనను త్వరగా రప్పిస్తున్నారు.<verse eid="AMO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 6:4" />మీరు దంతపు మంచాల మీద పడుకుంటారు,</para>
  <para style="q2" vid="AMO 6:4">పరుపులపై ఆనుకుంటారు.</para>
  <para style="q1" vid="AMO 6:4">శ్రేష్ఠమైన గొర్రెపిల్లలను,</para>
  <para style="q2" vid="AMO 6:4">శాలలోని క్రొవ్విన దూడలను మీరు తింటారు.<verse eid="AMO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="AMO 6:5" />మీరు దావీదులా సితారా వాయిస్తూ</para>
  <para style="q2" vid="AMO 6:5">వాయిద్యాలు మెరుగుపరుస్తారు.<verse eid="AMO 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 6:6" />మీరు ద్రాక్షరసం పాత్ర నిండా నింపుకొని త్రాగుతారు,</para>
  <para style="q2" vid="AMO 6:6">పరిమళ తైలాలు పూసుకుంటారు,</para>
  <para style="q2" vid="AMO 6:6">కాని మీరు యోసేపు నాశనం గురించి విచారపడరు.<verse eid="AMO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="AMO 6:7" />కాబట్టి బందీలుగా మొదట దేశాంతరం పోయే వారిలో మీరు ఉంటారు;</para>
  <para style="q2" vid="AMO 6:7">మీ ఉత్సవాలు, మీ విలాసాలు గతించిపోతాయి.<verse eid="AMO 6:7" /></para>
  <para style="s1">యెహోవా ఇశ్రాయేలు గర్వాన్ని అణచివేయుట</para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8" />ప్రభువైన యెహోవా తన తోడని ప్రమాణం చేసి, సైన్యాల యెహోవా ఇలా ప్రకటిస్తున్నారు:</para>
  <para style="q1" vid="AMO 6:8">“నేను యాకోబు గర్వాన్ని అసహ్యించుకుంటున్నాను</para>
  <para style="q2" vid="AMO 6:8">అతని కోటలను ద్వేషిస్తున్నాను;</para>
  <para style="q1" vid="AMO 6:8">నేను పట్టణాన్ని దానిలో ఉన్న అంతటితో</para>
  <para style="q2" vid="AMO 6:8">శత్రువు వశం చేస్తాను.”<verse eid="AMO 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9" />ఒక్క కుటుంబంలో పదిమంది మిగిలి ఉన్నా, <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" />ఆ శవాలను ఇంట్లోనుండి తీసుకుపోయి వాటిని దహనం చేయడానికి వచ్చిన బంధువు ఇంట్లో దాక్కొని ఉన్నవానితో, “నీతో ఇంకెవరైన ఉన్నారా?” అని అడిగితే, “లేదు” అని అతడు చెప్తే, “మాట్లాడకు, మనం యెహోవా పేరును ప్రస్తావించకూడదు” అని అంటాడు.<verse eid="AMO 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="AMO 6:11" />ఎందుకంటే యెహోవా ఇచ్చిన ఆజ్ఞ ప్రకారంగా,</para>
  <para style="q2" vid="AMO 6:11">పెద్ద కుటుంబాలు ముక్కలుగా విడిపోతాయి</para>
  <para style="q2" vid="AMO 6:11">చిన్నా కుటుంబాలు చీలిపోతాయి.<verse eid="AMO 6:11" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="12" style="v" sid="AMO 6:12" />గుర్రాలు బండ మీద పరుగెత్తుతాయా?</para>
  <para style="q2" vid="AMO 6:12">బండ మీద ఎవరైనా ఎద్దులతో దున్నుతారా?</para>
  <para style="q1" vid="AMO 6:12">కాని న్యాయాన్ని విషంగా మార్చారు,</para>
  <para style="q2" vid="AMO 6:12">నీతి ఫలాన్ని చేదుగా మార్చారు.<verse eid="AMO 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="AMO 6:13" />లో దెబారును<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="fq" closed="false">లో దెబారును </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">ఏమి లేదు</char></note> జయించి ఆనందిస్తున్న మీరు,</para>
  <para style="q2" vid="AMO 6:13">“మా సొంత బలంతోనే కర్నాయీమును<note caller="+" style="f"><char style="fr" closed="false">6:13 </char><char style="fq" closed="false">కర్నాయీమును </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">కొమ్ములు</char><char style="ft" closed="false">; </char><char style="fqa" closed="false">కొమ్ము </char><char style="ft" closed="false">ఇక్కడ బలాన్ని సూచిస్తుంది</char></note> పట్టుకోలేదా?” అంటారు.<verse eid="AMO 6:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="AMO 6:14" />అయితే సైన్యాల యెహోవా దేవుడు ఇలా అంటున్నారు,</para>
  <para style="q2" vid="AMO 6:14">“ఇశ్రాయేలూ, నేను నీ మీదికి ఒక దేశాన్ని రప్పిస్తాను,</para>
  <para style="q1" vid="AMO 6:14">అది నిన్ను హమాతు మొదలుకొని అరాబా లోయవరకు</para>
  <para style="q2" vid="AMO 6:14">ఆ అరణ్య మార్గమంతా నిన్ను హింసిస్తుంది.”<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" sid="AMO 7" />
  <para style="s1">మిడతలు, అగ్ని, కొలనూలు</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />ప్రభువైన యెహోవా నాకు చూపించింది ఇది: రాజుకు రావలసిన పంట వచ్చిన తర్వాత గడ్డి మళ్ళీ మొలిచినప్పుడు, యెహోవా మిడత గుంపులను సిద్ధపరిచారు. <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />అవి మొత్తం పంటను తినివేసినప్పుడు, “ప్రభువైన యెహోవా, క్షమించండి! యాకోబు వంశం చిన్నది అది ఎలా మనుగడ సాగించగలదు?” అని నేను మొరపెట్టాను.<verse eid="AMO 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 7:3" />కాబట్టి యెహోవా జాలిపడ్డారు.</para>
  <para style="p" vid="AMO 7:3">“ఇది జరగదు” అని యెహోవా అన్నారు.<verse eid="AMO 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4" />ప్రభువైన యెహోవా నాకు చూపించింది ఇది: ప్రభువైన యెహోవా అగ్ని ద్వారా తీర్పును ప్రకటిస్తున్నారు; అది మహా అగాధాన్ని ఎండగొట్టి, నేలను మ్రింగివేసింది. <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />అప్పుడు నేను, “ప్రభువైన యెహోవా, దయచేసి ఆపండి! యాకోబు వంశం చిన్నది అది ఎలా మనుగడ సాగించగలదు?” అని మొరపెట్టాను.<verse eid="AMO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 7:6" />కాబట్టి యెహోవా జాలిపడ్డారు.</para>
  <para style="p" vid="AMO 7:6">“ఇది కూడా జరగదు” అని ప్రభువైన యెహోవా అన్నారు.<verse eid="AMO 7:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7" />ఆయన నాకు చూపించింది ఇదే: ప్రభువు తన చేతిలో కొలనూలు పట్టుకుని, మట్టపు గుండు ప్రకారం కట్టబడిన గోడ దగ్గర నిలబడి ఉన్నారు. <verse eid="AMO 7:7" /><verse number="8" style="v" sid="AMO 7:8" />యెహోవా నన్ను, “ఆమోసూ, నీవు ఏమి చూస్తున్నావు?” అని అడిగారు.</para>
  <para style="p" vid="AMO 7:8">“కొలనూలు” అని నేను జవాబిచ్చాను.</para>
  <para style="p" vid="AMO 7:8">అప్పుడు ప్రభువు అన్నారు, “చూడు, నా ఇశ్రాయేలు ప్రజలమధ్య కొలనూలు వేయబోతున్నాను, ఇకమీదట వారిని శిక్షించకుండ వదలను.<verse eid="AMO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 7:9" />“ఇస్సాకు క్షేత్రాలు నాశనమవుతాయి</para>
  <para style="q2" vid="AMO 7:9">ఇశ్రాయేలు పరిశుద్ధ స్థలాలు పాడైపోతాయి;</para>
  <para style="q2" vid="AMO 7:9">యరొబాము ఇంటి మీదికి నా కత్తి ఎత్తుతాను.”<verse eid="AMO 7:9" /></para>
  <para style="s1">ఆమోసు అమజ్యా</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />తర్వాత బేతేలు యాజకుడైన అమజ్యా ఇశ్రాయేలు రాజైన యరొబాముకు ఇలా వర్తమానం పంపాడు: “ఇశ్రాయేలు ప్రజల మధ్యలోనే ఆమోసు నీ మీద కుట్ర పన్నుతున్నాడు. దేశం అతని మాటలన్నిటిని భరించలేకపోతుంది. <verse eid="AMO 7:10" /><verse number="11" style="v" sid="AMO 7:11" />ఎందుకంటే ఆమోసు చెప్పేది ఇదే:</para>
  <para style="q1" vid="AMO 7:11">“ ‘యరొబాము ఖడ్గం చేత చస్తాడు,</para>
  <para style="q2" vid="AMO 7:11">ఇశ్రాయేలు ప్రజలు తమ సొంత దేశం నుండి</para>
  <para style="q2" vid="AMO 7:11">బందీలుగా దేశాంతరం పోతారు.’ ”<verse eid="AMO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12" />అప్పుడు అమజ్యా ఆమోసుతో, “దీర్ఘదర్శీ నీవు వెళ్లిపో! యూదా దేశానికి తిరిగి వెళ్లు! అక్కడ నీకు ఆహారం సంపాదించుకో, అక్కడే నీవు ప్రవచించుకో. <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" />బేతేలులో ప్రవచించడం ఆపు, ఎందుకంటే రాజు గుడి, రాజభవనం ఇక్కడే ఉన్నాయి” అని చెప్పాడు.<verse eid="AMO 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14" />ఆమోసు అమజ్యాకు జవాబిస్తూ ఇలా అన్నాడు, “నేను ప్రవక్తను కాదు, ప్రవక్త కుమారున్ని కాదు. నేను గొర్రెల కాపరిగా ఉంటూ మేడిచెట్లను చూసుకునే వాన్ని. <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" />అయితే యెహోవా, మందను కాసుకుంటున్న నన్ను పిలిచి, ‘వెళ్లు, నా ఇశ్రాయేలు ప్రజలకు ప్రవచించు’ అన్నారు. <verse eid="AMO 7:15" /><verse number="16" style="v" sid="AMO 7:16" />కాబట్టి ఇప్పుడు యెహోవా చెప్పేది వినండి. నీవు ఇలా అంటున్నావు,</para>
  <para style="q1" vid="AMO 7:16">“ ‘ఇశ్రాయేలుకు విరుద్ధంగా ప్రవచించకు,</para>
  <para style="q2" vid="AMO 7:16">ఇస్సాకు సంతానానికి విరుద్ధంగా ప్రసంగించడం ఆపు.’<verse eid="AMO 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="AMO 7:17" />“కాబట్టి యెహోవా చెప్పే మాట ఇదే:</para>
  <para style="q1" vid="AMO 7:17">“ ‘నీ భార్య పట్టణంలో వేశ్యగా మారుతుంది,</para>
  <para style="q2" vid="AMO 7:17">నీ కుమారులు, కుమార్తెలు ఖడ్గానికి కూలుతారు.</para>
  <para style="q1" vid="AMO 7:17">నీ భూమి కొలవబడి విభజించబడుతుంది,</para>
  <para style="q2" vid="AMO 7:17">నీవు యూదేతర<note caller="+" style="f"><char style="fr" closed="false">7:17 </char><char style="ft" closed="false">హెబ్రీలో </char><char style="fqa" closed="false">అపవిత్రమైన</char></note> దేశంలో చస్తావు.</para>
  <para style="q1" vid="AMO 7:17">ఇశ్రాయేలు ప్రజలు తమ సొంత దేశానికి దూరంగా,</para>
  <para style="q2" vid="AMO 7:17">బందీలుగా వెళ్తారు.’ ”<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" sid="AMO 8" />
  <para style="s1">పండిన పండ్ల గంప</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />ప్రభువైన యెహోవా నాకు చూపించింది ఇదే: పండిన పండ్ల గంప. <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" />“ఆమోసూ! నీవేం చూస్తున్నావు?” అని ఆయన అడిగారు.</para>
  <para style="p" vid="AMO 8:2">“పండిన పండ్ల గంప” అని నేను జవాబిచ్చాను.</para>
  <para style="p" vid="AMO 8:2">అప్పుడు యెహోవా నాతో ఇలా అన్నారు, “నా ప్రజలైన ఇశ్రాయేలుకు సమయం దగ్గరపడింది; ఇక నేను వారిని శిక్షించకుండా ఉండను.<verse eid="AMO 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 8:3" />“ఆ రోజు గుడిలో వారు పాడే పాటలు విలాపంగా<note caller="+" style="f"><char style="fr" closed="false">8:3 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">మందిరంలో గాయకులు విలపిస్తారు</char></note> మారుతాయి. ఎన్నో శవాలు ఉంటాయి; ఎక్కడ చూసినా అవే! ఊరుకోండి!” అని ప్రభువైన యెహోవా చెప్తున్నారు.<verse eid="AMO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 8:4" />అవసరతలో ఉన్నవారిని అణగద్రొక్కే వారలారా,</para>
  <para style="q2" vid="AMO 8:4">దేశంలో ఉన్న పేదలను అంతం చేసేవారలారా,<verse eid="AMO 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 8:5" />అలా చేస్తూ,</para>
  <para style="q1" vid="AMO 8:5">“మనం ధాన్యం అమ్ముకోడానికి,</para>
  <para style="q2" vid="AMO 8:5">అమావాస్య ఎప్పుడు దాటి పోతుందో,</para>
  <para style="q1" vid="AMO 8:5">గోధుమ వ్యాపారం సాగటానికి విశ్రాంతి దినం</para>
  <para style="q2" vid="AMO 8:5">ఎప్పుడు గతించి పోతుందో?” అనుకునేవారలారా వినండి.</para>
  <para style="q1" vid="AMO 8:5">మీరు కొల గంపలు చిన్నగా చేస్తూ,</para>
  <para style="q2" vid="AMO 8:5">ధర ఎక్కువ చేస్తూ,</para>
  <para style="q2" vid="AMO 8:5">దొంగ త్రాసుతో మోసగిస్తారు,<verse eid="AMO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 8:6" />బీదలను వెండికి కొంటారు,</para>
  <para style="q2" vid="AMO 8:6">చెప్పులిచ్చి అవసరతలో ఉన్నవారిని కొంటారు,</para>
  <para style="q2" vid="AMO 8:6">పాడైపోయి గింజలు కూడా అమ్మివేస్తారు.<verse eid="AMO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7" />యాకోబు ఆత్మగౌరవమైన తన నామం తోడని యెహోవా ఇలా ప్రమాణం చేశారు: “నేను వారు చేసిన వాటిలో ఒక్కటి కూడా ఎన్నటికీ మరువను.<verse eid="AMO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="AMO 8:8" />“ఈ కారణంచేత భూమి కంపించదా?</para>
  <para style="q2" vid="AMO 8:8">దేశవాసులందరూ దుఃఖపడరా?</para>
  <para style="q1" vid="AMO 8:8">నైలు నది పొంగినట్లు దేశమంతా పొంగుతుంది,</para>
  <para style="q2" vid="AMO 8:8">అది పైకి లేచి తర్వాత</para>
  <para style="q2" vid="AMO 8:8">ఈజిప్టు నదిలా అణగిపోతుంది.<verse eid="AMO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 8:9" />“ఆ రోజున,” అంటూ ప్రభువైన యెహోవా ఇలా ప్రకటిస్తున్నారు,</para>
  <para style="q1" vid="AMO 8:9">మధ్యాహ్నమే సూర్యుడు అస్తమించేలా,</para>
  <para style="q2" vid="AMO 8:9">పట్ట పగటివేళ భూమికి చీకటి కమ్మేలా చేస్తాను.<verse eid="AMO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 8:10" />నేను మీరు ఆచరించే పండుగలను విలాపంగా,</para>
  <para style="q2" vid="AMO 8:10">మీ పాటలన్నీ విషాద గీతాలుగా మారుస్తాను.</para>
  <para style="q1" vid="AMO 8:10">నేను మీరంతా గోనెపట్ట కట్టుకునేలా,</para>
  <para style="q2" vid="AMO 8:10">తల గొరిగించుకునేలా చేస్తాను.</para>
  <para style="q1" vid="AMO 8:10">ఏకైక కుమారుని కోసం ఏడ్చినట్లుగా ఆ సమయాన్ని చేస్తాను,</para>
  <para style="q2" vid="AMO 8:10">దాని అంతం ఘోరమైన రోజుగా ఉంటుంది.<verse eid="AMO 8:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="AMO 8:11" />ప్రభువైన యెహోవా ఇలా ప్రకటిస్తున్నారు,</para>
  <para style="q2" vid="AMO 8:11">“రాబోయే రోజుల్లో నేను ఈ దేశంలో కరువు పుట్టిస్తాను,</para>
  <para style="q1" vid="AMO 8:11">ఆహారం నీళ్లు లేకపోవడం వల్ల కలిగే కరువు కాదు,</para>
  <para style="q2" vid="AMO 8:11">యెహోవా వాక్కుల కరువు పుట్టిస్తాను.<verse eid="AMO 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 8:12" />ప్రజలు యెహోవా వాక్కు కోసం వెతుకుతూ,</para>
  <para style="q2" vid="AMO 8:12">ఆ సముద్రం నుండి ఈ సముద్రం వరకు,</para>
  <para style="q1" vid="AMO 8:12">ఉత్తర దిక్కునుండి తూర్పుదిక్కు వరకు తిరుగుతారు</para>
  <para style="q2" vid="AMO 8:12">కాని అది వారికి దొరకదు.<verse eid="AMO 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 8:13" />“ఆ రోజున</para>
  <para style="q1" vid="AMO 8:13">“అందమైన కన్యలు బలమైన యువకులు</para>
  <para style="q2" vid="AMO 8:13">దప్పికతో మూర్ఛపోతారు.<verse eid="AMO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="AMO 8:14" />సమరయ దోషానికి కారణమైనదాని తోడని,</para>
  <para style="q2" vid="AMO 8:14">‘దాను దేవుని తోడు’ అని,</para>
  <para style="q2" vid="AMO 8:14">‘బెయేర్షేబ దేవుని తోడు’ అని ప్రమాణం చేసేవారు</para>
  <para style="q2" vid="AMO 8:14">మళ్ళీ లేవకుండా కూలిపోతారు.”<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" sid="AMO 9" />
  <para style="s1">ఇశ్రాయేలు నాశనం</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />బలిపీఠం దగ్గర ప్రభువు నిలబడి ఉండడం నేను చూశాను, ఆయన ఇలా అన్నారు:</para>
  <para style="q1" vid="AMO 9:1">“గడపలు కదిలి పోయేలా,</para>
  <para style="q2" vid="AMO 9:1">స్తంభాల పైభాగాలను కొట్టు.</para>
  <para style="q1" vid="AMO 9:1">వాటిని ప్రజలందరి తలల మీద పడవేయు;</para>
  <para style="q2" vid="AMO 9:1">మిగిలిన వారిని నేను ఖడ్గంతో హతం చేస్తాను.</para>
  <para style="q1" vid="AMO 9:1">ఒక్కడు కూడా పారిపోలేడు,</para>
  <para style="q2" vid="AMO 9:1">ఎవ్వడూ తప్పించుకోలేడు.<verse eid="AMO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="AMO 9:2" />వారు పాతాళం లోతుల్లోనికి త్రవ్వుకొని వెళ్లినా,</para>
  <para style="q2" vid="AMO 9:2">అక్కడినుండి నా చేయి వారిని తీసుకుంటుంది.</para>
  <para style="q1" vid="AMO 9:2">వారు పైనున్న ఆకాశాల పైకి ఎక్కినా,</para>
  <para style="q2" vid="AMO 9:2">అక్కడినుండి వారిని క్రిందికి తీసుకువస్తాను.<verse eid="AMO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="AMO 9:3" />వారు కర్మెలు పర్వత శిఖరాన దాక్కున్నా,</para>
  <para style="q2" vid="AMO 9:3">అక్కడ నేను వారిని వెంటబడి పట్టుకుంటాను.</para>
  <para style="q1" vid="AMO 9:3">నా కళ్లకు కనిపించకుండా వారు సముద్రపు అడుగుభాగంలో దాక్కున్నా,</para>
  <para style="q2" vid="AMO 9:3">అక్కడ వారిని కరవమని సర్పానికి ఆజ్ఞ ఇస్తాను.<verse eid="AMO 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="AMO 9:4" />శత్రువులు వారిని బందీలుగా దేశాంతరం తీసుకెళ్లినా,</para>
  <para style="q2" vid="AMO 9:4">అక్కడ వారిని చంపమని ఖడ్గానికి ఆజ్ఞ ఇస్తాను.</para>
  <para style="b" vid="AMO 9:4" />
  <para style="q1" vid="AMO 9:4">“నా చూపు వారి మీద నిలుపుతాను,</para>
  <para style="q2" vid="AMO 9:4">అది కీడుకోసమే కాని మేలుకోసం కాదు.”<verse eid="AMO 9:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="AMO 9:5" />సైన్యాల అధిపతియైన యెహోవా</para>
  <para style="q1" vid="AMO 9:5">ఆయన భూమిని ముట్టగా అది కరిగిపోతుంది,</para>
  <para style="q2" vid="AMO 9:5">భూనివాసులు అందరు విలపిస్తారు;</para>
  <para style="q1" vid="AMO 9:5">దేశమంతా నైలు నదిలా పొంగుతుంది,</para>
  <para style="q2" vid="AMO 9:5">ఈజిప్టు నదిలా అణగిపోతుంది.<verse eid="AMO 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="AMO 9:6" />ఆయన ఆకాశాల్లో తన ఉన్నత రాజభవనాన్ని కట్టుకుంటారు,</para>
  <para style="q2" vid="AMO 9:6">దాని పునాదిని భూమి మీద నిర్మిస్తారు.</para>
  <para style="q1" vid="AMO 9:6">ఆయన సముద్రం నీటిని పిలిపించి</para>
  <para style="q2" vid="AMO 9:6">భూమి మీద కుమ్మరిస్తారు,</para>
  <para style="q2" vid="AMO 9:6">ఆయన పేరు యెహోవా.<verse eid="AMO 9:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="AMO 9:7" />“ఇశ్రాయేలీయులైన మీరు</para>
  <para style="q2" vid="AMO 9:7">నా దృష్టికి కూషు దేశస్థులతో<note caller="+" style="f"><char style="fr" closed="false">9:7 </char><char style="ft" closed="false">అంటే, ఇతియొపియా వారు</char></note> సమానం కారా?”</para>
  <para style="q2" vid="AMO 9:7">అని యెహోవా అంటున్నారు.</para>
  <para style="q1" vid="AMO 9:7">“నేను ఇశ్రాయేలును ఈజిప్టు నుండి,</para>
  <para style="q2" vid="AMO 9:7">ఫిలిష్తీయులను కఫ్తోరు<note caller="+" style="f"><char style="fr" closed="false">9:7 </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">క్రేతు</char></note> నుండి,</para>
  <para style="q2" vid="AMO 9:7">అరామీయులను కీరు నుండి తీసుకురాలేదా?<verse eid="AMO 9:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="AMO 9:8" />“నిజంగా ప్రభువైన యెహోవా కళ్లు</para>
  <para style="q2" vid="AMO 9:8">పాపిష్ఠి రాజ్యం మీద ఉన్నాయి.</para>
  <para style="q1" vid="AMO 9:8">నేను దాన్ని భూమి మీద ఉండకుండ</para>
  <para style="q2" vid="AMO 9:8">నాశనం చేస్తాను.</para>
  <para style="q1" vid="AMO 9:8">అయినా యాకోబు సంతానాన్ని</para>
  <para style="q2" vid="AMO 9:8">సంపూర్ణంగా నాశనం చేయను,”</para>
  <para style="q2" vid="AMO 9:8">అని యెహోవా అంటున్నారు.<verse eid="AMO 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="AMO 9:9" />“నేను ఆజ్ఞ ఇస్తాను,</para>
  <para style="q2" vid="AMO 9:9">మనిషి ధాన్యం జల్లెడలో వేసి,</para>
  <para style="q2" vid="AMO 9:9">ఒక్క గింజ కూడా నేల పడకుండా జల్లించే విధంగా,</para>
  <para style="q1" vid="AMO 9:9">ఇశ్రాయేలు ప్రజలను</para>
  <para style="q2" vid="AMO 9:9">అన్ని దేశాల వారి మధ్య జల్లిస్తాను.<verse eid="AMO 9:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="AMO 9:10" />నా ప్రజల్లోని పాపులందరు</para>
  <para style="q2" vid="AMO 9:10">‘విపత్తు మనల్ని తరమదు, మన మీదికి రాదు’</para>
  <para style="q1" vid="AMO 9:10">అని అనుకునే వారందరు,</para>
  <para style="q2" vid="AMO 9:10">ఖడ్గానికి గురై చస్తారు.<verse eid="AMO 9:10" /></para>
  <para style="s1">ఇశ్రాయేలు పునరుద్ధరణ</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11" />“ఆ రోజున,</para>
  <para style="q1" vid="AMO 9:11">“పడిపోయిన దావీదు గుడారాన్ని నేను తిరిగి కడతాను,</para>
  <para style="q2" vid="AMO 9:11">నేను దాని విరిగిన గోడలను మరమ్మత్తు చేసి,</para>
  <para style="q2" vid="AMO 9:11">దాని శిథిలాలను తిరిగి నిర్మిస్తాను,</para>
  <para style="q2" vid="AMO 9:11">మునుపు ఉండినట్లుగా దాన్ని తిరిగి కడతాను.<verse eid="AMO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="AMO 9:12" />అలా వారు ఎదోము జనంలో మిగిలిన వారిని,</para>
  <para style="q2" vid="AMO 9:12">నా నామం కలిగిన యూదేతరులనందరినీ స్వాధీనం చేసుకుంటారు,”</para>
  <para style="q2" vid="AMO 9:12">అని ఈ కార్యాలన్ని చేసే యెహోవా అంటున్నారు.<verse eid="AMO 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 9:13" />యెహోవా ఇలా ప్రకటిస్తున్నారు,</para>
  <para style="q1" vid="AMO 9:13">“రాబోయే రోజుల్లో పంట కోసేవారిని దున్నేవాడు దాటిపోతాడు,</para>
  <para style="q2" vid="AMO 9:13">నాటే వారిని ద్రాక్ష పండ్లు త్రొక్కేవాడు దాటిపోతాడు,</para>
  <para style="q1" vid="AMO 9:13">నూతన ద్రాక్షరసం పర్వతాలమీద నుండి,</para>
  <para style="q2" vid="AMO 9:13">అన్ని కొండల నుండి ప్రవహిస్తుంది.<verse eid="AMO 9:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="AMO 9:14" />నేను నా ఇశ్రాయేలు ప్రజలను బందీల నుండి తిరిగి తీసుకువస్తాను.<note caller="+" style="f"><char style="fr" closed="false">9:14 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">నా ఇశ్రాయేలు ప్రజల భాగ్యాలను తిరిగి రప్పిస్తాను</char></note></para>
  <para style="b" vid="AMO 9:14" />
  <para style="q1" vid="AMO 9:14">“వారు శిథిలమైన పట్టణాలను పునర్నిర్మించుకుని వాటిలో నివసిస్తారు.</para>
  <para style="q2" vid="AMO 9:14">వారు ద్రాక్షతోటలు వేసి వాటి ద్రాక్షరసం త్రాగుతారు;</para>
  <para style="q2" vid="AMO 9:14">వారు వనాలు నాటి వాటి పండ్లు తింటారు.<verse eid="AMO 9:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="AMO 9:15" />నేను ఇశ్రాయేలును తమ స్వదేశంలో నాటుతాను,</para>
  <para style="q2" vid="AMO 9:15">నేను వారికిచ్చిన దేశంలో నుండి</para>
  <para style="q2" vid="AMO 9:15">వారు ఇక ఎన్నడు పెళ్లగించబడరు,”</para>
  <para style="m" vid="AMO 9:15">అని మీ దేవుడైన యెహోవా చెప్తున్నారు.<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>