<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- Biblica® Open Telugu Contemporary Version</book>
  
  <para style="h">హెబ్రీ పత్రిక</para>
  <para style="toc1">హెబ్రీయులకు వ్రాసిన పత్రిక</para>
  <para style="toc2">హెబ్రీ పత్రిక</para>
  <para style="toc3">హెబ్రీ</para>
  <para style="mt1">హెబ్రీయులకు</para>
  <para style="mt2">వ్రాసిన పత్రిక</para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="s1">దేవుని తుది వాక్కు: ఆయన కుమారుడు</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />గతంలో దేవుడు మన పితరులతో ప్రవక్తల ద్వారా ఎన్నోసార్లు ఎన్నో విధాలుగా మాట్లాడారు. <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />కాని ఈ చివరి దినాల్లో ఆయన తన కుమారుని ద్వారా మనతో మాట్లాడారు, ఆయన తన కుమారున్ని సమస్తానికి వారసునిగా నియమించారు, ఆయన ద్వారానే ఈ జగత్తును కూడా సృష్టించారు. <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />ఆ కుమారుడు తన శక్తిగల మాటచేత సమస్తాన్ని సంరక్షిస్తూ, దేవుని మహిమ యొక్క ప్రకాశంగా, ఆయన ఉనికికి ఖచ్చితమైన ప్రాతినిధ్యంగా ఉన్నారు. పాపాలకు ఆయన శుద్ధీకరణను సిద్ధపరచిన తర్వాత, ఆయన పరలోకంలో మహోన్నతుని కుడి వైపున కూర్చున్నారు. <verse eid="HEB 1:3" /><verse number="4" style="v" sid="HEB 1:4" />కాబట్టి ఆయన దేవదూతల కంటే ఉన్నతమైన నామాన్ని వారసత్వంగా పొందినట్లే ఆయన దేవదూతల కంటే ఉన్నతమైన స్థానాన్ని పొందారు.<verse eid="HEB 1:4" /></para>
  <para style="s1">కుమారుడు దేవదూతల కంటే ఉన్నతుడు</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 1:5" />దేవదూతల్లో ఎవరితోనైనా ఎన్నడైన దేవుడు,</para>
  <para style="q1" vid="HEB 1:5">“నీవు నా కుమారుడవు;</para>
  <para style="q2" vid="HEB 1:5">ఈ రోజు నేను నీకు తండ్రిని అయ్యాను”<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 2:7">కీర్తన 2:7</ref></char></char></note></para>
  <para style="m" vid="HEB 1:5">అని గాని,</para>
  <para style="q1" vid="HEB 1:5">“నేను అతనికి తండ్రిగా ఉంటాను,</para>
  <para style="q2" vid="HEB 1:5">అతడు నాకు కుమారునిగా ఉంటాడు,”<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="2SA 7:14">2 సమూ 7:14</ref>; <ref loc="1CH 17:13">1 దిన 17:13</ref></char></char></note> అని గాని అన్నారా?<verse eid="HEB 1:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 1:6" />దేవుడు తన మొదటి సంతానాన్ని భూలోకానికి తెచ్చినప్పుడు, ఆయన,</para>
  <para style="q1" vid="HEB 1:6">“దేవదూతలందరు ఆయనను ఆరాధించాలి,”<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 32:43">ద్వితీ 32:43</ref></char></char></note> అని చెప్పారు.<verse eid="HEB 1:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="HEB 1:7" />దేవదూతల గురించి మాట్లాడుతూ ఆయన ఇలా అన్నారు,</para>
  <para style="q1" vid="HEB 1:7">“ఆయన తన దూతలను ఆత్మలుగా,</para>
  <para style="q2" vid="HEB 1:7">తన సేవకులను అగ్ని జ్వాలలుగా చేస్తారు,”<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 104:4">కీర్తన 104:4</ref></char></char></note></para>
  <para style="m" vid="HEB 1:7">అని అన్నారు.<verse eid="HEB 1:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 1:8" />కాని తన కుమారుని గురించి ఆయన,</para>
  <para style="q1" vid="HEB 1:8">“ఓ దేవా, మీ సింహాసనం నిరంతరం నిలుస్తుంది;</para>
  <para style="q2" vid="HEB 1:8">మీ న్యాయ దండం మీ రాజ్య రాజదండం.<verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />మీరు నీతిని ప్రేమించి దుష్టత్వాన్ని ద్వేషించారు;</para>
  <para style="q2" vid="HEB 1:9">కాబట్టి దేవుడు, మీ దేవుడు, ఆనంద తైలంతో మిమ్మల్ని అభిషేకించి,</para>
  <para style="q2" vid="HEB 1:9">మీ తోటివారి కన్నా మిమ్మల్ని ఉన్నతస్థితికి హెచ్చించారు,”<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 45:6">కీర్తన 45:6</ref>,<ref loc="PSA 45:7">7</ref></char></char></note> అని అన్నారు.<verse eid="HEB 1:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="HEB 1:10" />ఇంకా ఆయన,</para>
  <para style="q1" vid="HEB 1:10">“ప్రభువా, ఆదిలో మీరు భూమికి పునాదులు వేశారు,</para>
  <para style="q2" vid="HEB 1:10">ఆకాశాలు మీ చేతి పని.<verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />అవి అంతరించిపోతాయి, కాని మీరు నిలిచి ఉంటారు;</para>
  <para style="q2" vid="HEB 1:11">ఒక వస్త్రంలా అవన్నీ పాతగిల్లుతాయి.<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />వాటిని మీరు అంగీలా చుట్టి పెడతారు;</para>
  <para style="q2" vid="HEB 1:12">వస్త్రంలా అవన్నీ మార్చబడతాయి.</para>
  <para style="q1" vid="HEB 1:12">కానీ మీరు అలాగే ఉంటారు,</para>
  <para style="q2" vid="HEB 1:12">మీ సంవత్సరాలకు అంతం ఉండదు,”<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="ft" closed="false"><char style="xt">కీర్తన 102:25-27</char></char></note> అని అన్నారు.<verse eid="HEB 1:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13" />దేవుడు దేవదూతల్లో ఎవరితోనైనా ఎప్పుడైనా,</para>
  <para style="q1" vid="HEB 1:13">“నేను నీ శత్రువులను</para>
  <para style="q2" vid="HEB 1:13">నీ పాదాలకు పాదపీఠంగా చేసే వరకు</para>
  <para style="q2" vid="HEB 1:13">నా కుడి వైపున కూర్చో అని చెప్పారా”<note caller="+" style="f"><char style="fr" closed="false">1:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 110:1">కీర్తన 110:1</ref></char></char></note>?<verse eid="HEB 1:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="HEB 1:14" />దేవదూతలందరు రక్షణను వారసత్వంగా పొందబోయే వారికి పరిచర్య చేయడానికి పంపబడిన ఆత్మలు కారా?<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s1">శ్రద్ధ వహించాలని హెచ్చరిక</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />కాబట్టి మనం ప్రక్కకు మళ్ళించబడకుండా ఉండడానికి, మనం విన్న వాటి పట్ల అత్యంత జాగ్రత్తగా శ్రద్ధ వహించాలి. <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />ఎందుకంటే దేవదూతల ద్వారా చెప్పబడిన వర్తమానం స్థిరపరచబడింది కాబట్టి, ప్రతి అతిక్రమం అవిధేయత న్యాయమైన శిక్షను పొందగా, <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />మనం గొప్ప రక్షణను నిర్లక్ష్యం చేస్తే, మనం ఎలా తప్పించుకోగలం? ఈ రక్షణను ప్రభువే మొదట ప్రకటించారు. ఆయన మాటలు విన్నవారి ద్వారా అది మనకు నిరూపించబడింది. <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />సూచకక్రియలు, ఆశ్చర్యకార్యాలు, వివిధ రకాల అద్భుతాలు, తన చిత్తానుసారంగా పరిశుద్ధాత్మ వరాలను పంచిపెట్టడం ద్వారా దేవుడు కూడా వాటి గురించి సాక్ష్యమిచ్చారు.<verse eid="HEB 2:4" /></para>
  <para style="s1">సంపూర్ణ మానవునిగా యేసు</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />మనం దేని గురించి మాట్లాడుతున్నామో, ఆ రాబోవు లోకాన్ని ఆయన దేవదూతల చేతి క్రింద ఉంచలేదు. <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />అయితే ఒకచోట ఒకరు ఇలా సాక్ష్యమిచ్చారు:</para>
  <para style="q1" vid="HEB 2:6">“మీరు మానవాళిని లక్ష్యపెట్టడానికి వారు ఏపాటివారు?</para>
  <para style="q2" vid="HEB 2:6">మీరు నరపుత్రుని గురించి శ్రద్ధ చూపడానికి అతడు ఎంతటివాడు?<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />మీరు వారిని దేవదూతల కంటే కొంచెం<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="fq" closed="false">కొంచెం </char><char style="ft" closed="false">కొంతకాలం వరకు</char></note> తక్కువగా చేశారు;</para>
  <para style="q2" vid="HEB 2:7">మీరు మహిమ ఘనతను వారికి కిరీటంగా పెట్టారు.<verse eid="HEB 2:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 2:8" />సమస్తాన్ని వారి పాదాల క్రింద ఉంచారు,”<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="ft" closed="false"><char style="xt">కీర్తన 8:4-6</char></char></note></para>
  <para style="m" vid="HEB 2:8">సమస్తాన్ని వారి క్రింద ఉంచుతూ, వారికి లోబరచకుండా దేవుడు దేన్ని విడిచిపెట్టలేదు. అయినాసరే వారికి ప్రతిదీ లోబడడం ప్రస్తుతానికి మనమింకా చూడలేదు. <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />కాని, యేసు కొంతకాలం వరకు దేవదూతల కంటే తక్కువ చేయబడి, దేవుని కృప వల్ల అందరి కోసం మరణాన్ని రుచిచూశారు కాబట్టి ఇప్పుడు మహిమ ప్రభావాలతో కిరీటం ధరించుకొని ఉన్నట్లు మనం ఆయనను చూస్తున్నాము.<verse eid="HEB 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 2:10" />ఎవరి కోసం, ఎవరి ద్వారా సమస్తం కలిగిందో ఆ దేవునికి, అనేకమంది కుమారులను కుమార్తెలను మహిమలో తీసుకురావడంలో, వారి రక్షణకు మార్గదర్శి యైన వానిని శ్రమల ద్వారా పరిపూర్ణునిగా చేయడం తగినదిగా ఉండింది. <verse eid="HEB 2:10" /><verse number="11" style="v" sid="HEB 2:11" />ప్రజలను పరిశుద్ధపరచే వానిది పరిశుద్ధపరచబడిన వారిది ఒక్కటే కుటుంబము. కాబట్టి వారిని సహోదరీ సహోదరులు అని పిలువడానికి యేసు సిగ్గుపడలేదు. <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />ఆయన ఇలా అన్నారు,</para>
  <para style="q1" vid="HEB 2:12">“నేను మీ నామాన్ని నా సహోదరీ సహోదరులకు ప్రకటిస్తాను;</para>
  <para style="q2" vid="HEB 2:12">సమాజంలో మీ కీర్తిని నేను గానం చేస్తాను.”<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 22:22">కీర్తన 22:22</ref></char></char></note><verse eid="HEB 2:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13" />అంతేకాక,</para>
  <para style="q1" vid="HEB 2:13">“నేను ఆయనలో నా నమ్మకాన్ని ఉంచుతాను.”<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 8:17">యెషయా 8:17</ref></char></char></note></para>
  <para style="m" vid="HEB 2:13">అంతేకాక,</para>
  <para style="q1" vid="HEB 2:13">“ఇదిగో నేను, దేవుడు నాకిచ్చిన పిల్లలు,”<note caller="+" style="f"><char style="fr" closed="false">2:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 8:18">యెషయా 8:18</ref></char></char></note> అని ఆయన చెప్తున్నారు.<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />ఈ పిల్లలు రక్తమాంసాలు కలిగి ఉన్నవారు కాబట్టి, తన మరణం ద్వారా మరణంపై అధికారం కలవాడైన అపవాది అధికారాన్ని విరుగగొట్టడానికి, <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />మరణ భయంతో దాస్యంలో ఉంచబడినవారిని విడిపించడానికి, ఆయన కూడా మానవరూపంలో పాలుపంచుకున్నాడు. <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />ఇది ఖచ్చితంగా అబ్రాహాము సంతానానికే గాని దేవదూతలకు సహాయం చేయడానికి కాదు. <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />దేవుని సేవచేయడంలో కనికరం కలిగిన నమ్మకమైన ప్రధాన యాజకునిగా ఉండడానికి, ప్రజల పాపాల కోసం ప్రాయశ్చిత్తం చేయడానికి, ఆయన అన్ని విధాలుగా వారిలా సంపూర్ణ మానవునిగా చేయబడ్డారు. <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />ఆయన మానవునిగా శోధించబడినప్పుడు బాధను అనుభవించారు కాబట్టి శోధించబడుతున్న వారికి ఆయన సహాయం చేయగలరు.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s1">యేసు మోషే కంటే గొప్పవాడు</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />కాబట్టి, పరలోక పిలుపులో భాగస్థులైన పరిశుద్ధ సహోదరీ సహోదరులారా, మన అపొస్తలునిగా ప్రధాన యాజకునిగా మనం అంగీకరించిన యేసు మీద మీ ఆలోచనలను ఉంచండి. <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />దేవుని ఇల్లంతటిలో మోషే నమ్మకంగా ఉన్నట్లు ఈయన తనను నియమించిన వానికి నమ్మకంగా ఉన్నాడు. <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />ఇల్లు కంటే దాన్ని కట్టినవాడు ఎక్కువ ఘనత పొందినట్టు, మోషే కంటే యేసు అధికమైన మహిమకు అర్హుడుగా కనబడ్డాడు. <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />ప్రతి ఇల్లు ఎవరో ఒకరి ద్వారా కట్టబడింది, అయితే దేవుడు సమస్తానికి నిర్మాణకుడు. <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />“మోషే దేవుని సేవకునిగా దేవుని ఇల్లంతటిలో నమ్మకమైన వానిగా ఉన్నాడు”<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="NUM 12:7">సంఖ్యా 12:7</ref></char></char></note> దేవుడు భవిష్యత్తులో చెప్పబోయేవాటికి సాక్షిగా ఉన్నాడు. <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />అయితే క్రీస్తు, కుమారుడిగా దేవుని ఇంటిపైన నమ్మకంగా ఉన్నాడు. ఒకవేళ మన ధైర్యాన్ని, మనం కీర్తించే నిరీక్షణను గట్టిగా పట్టుకుంటే, మనమే ఆయన గృహము.<verse eid="HEB 3:6" /></para>
  <para style="s1">విశ్వాసంలేనివారికి హెచ్చరిక</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />కాబట్టి, పరిశుద్ధాత్మ చెప్పినట్లు:</para>
  <para style="q1" vid="HEB 3:7">“నేడు, ఆయన స్వరాన్ని మీరు వింటే,<verse eid="HEB 3:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 3:8" />అరణ్యంలో శోధన సమయంలో,</para>
  <para style="q1" vid="HEB 3:8">మీరు తిరుగుబాటు చేసిన విధంగా,</para>
  <para style="q2" vid="HEB 3:8">మీ హృదయాలను కఠినం చేసుకోకండి;<verse eid="HEB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9" />అక్కడ నలభై సంవత్సరాలు నేను చేసిన కార్యాలు వారు చూసి కూడా,</para>
  <para style="q2" vid="HEB 3:9">మీ పూర్వికులు నన్ను పరీక్షించారు.<verse eid="HEB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10" />అందుకే నేను ఆ తరం వారిపై కోప్పడి ఇలా అన్నాను;</para>
  <para style="q2" vid="HEB 3:10">‘వారి హృదయాలు ఎల్లప్పుడు దారి తప్పిపోతున్నాయి,</para>
  <para style="q2" vid="HEB 3:10">వారు నా మార్గాలను తెలుసుకోలేదు’<verse eid="HEB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11" />కాబట్టి, ‘వారు ఎన్నడు నా విశ్రాంతిలో ప్రవేశింపరు’</para>
  <para style="q2" vid="HEB 3:11">అని నేను కోపంలో ప్రమాణం చేశాను.”<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false"><char style="xt">కీర్తన 95:7-11</char></char></note><verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />కాబట్టి సహోదరీ సహోదరులారా, జీవంగల దేవుని నుండి దూరంచేసే పాప స్వభావం, అవిశ్వాసపు హృదయం మీలో ఎవరికి ఉండకుండ జాగ్రత్తగా చూసుకోండి. <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />పాపం యొక్క మోసంచేత మీలో ఎవరూ కఠినపరచబడకుండ ఉండడానికి, నేడు అని పిలువబడుతున్న దినం ఉండగానే మీరు ప్రతిదినం ఒకరినొకరు ధైర్యపరచుకొంటూ ఉండండి. <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />ఒకవేళ మనకున్న మొదటి నిశ్చయతను అంతం వరకు గట్టిగా పట్టుకుని ఉంటే, మనం క్రీస్తులో పాలుపంచుకుంటాము. <verse eid="HEB 3:14" /><verse number="15" style="v" sid="HEB 3:15" />ఇప్పుడే చెప్పబడినట్లుగా,</para>
  <para style="q1" vid="HEB 3:15">“నేడు, ఆయన స్వరాన్ని మీరు వింటే,</para>
  <para style="q2" vid="HEB 3:15">మీరు తిరుగుబాటులో చేసినట్టుగా</para>
  <para style="q2" vid="HEB 3:15">మీ హృదయాలను కఠినం చేసుకోకండి.”<note caller="+" style="f"><char style="fr" closed="false">3:15 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 95:7">కీర్తన 95:7</ref>,<ref loc="PSA 95:8">8</ref></char></char></note><verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />దేవుని స్వరాన్ని విని ఆయన మాటను వ్యతిరేకించి తిరుగుబాటు చేసింది ఎవరు? వారందరు ఈజిప్టు నుండి మోషే చేత బయటకు నడిపించబడినవారు కారా? <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />ఆయన ఎవరితో నలభై సంవత్సరాలు కోపంగా ఉన్నాడు? పాపం చేయడం వల్ల ఎవరి శరీరాలు అరణ్యంలో నశించాయో, వారితో కాదా? <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />తన విశ్రాంతిలో ఎన్నడూ ప్రవేశించరని దేవుడు అవిధేయులతో కాక, మరెవరికి ప్రమాణం చేశాడు? <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />కాబట్టి వారి అవిశ్వాసం వల్లనే వారు ప్రవేశించలేక పోయారని మనం గ్రహిస్తున్నాము.<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="s1">దేవుని ప్రజలకు విశ్రాంతి</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />అందువల్ల, ఆయన విశ్రాంతిలోకి ప్రవేశిస్తామన్న వాగ్దానం ఇప్పటికీ ఉంది కాబట్టి, మీలో ఎవరూ దాన్ని పొందలేని పరిస్థితిలో లేకుండా జాగ్రత్తపడదాము. <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />ఎందుకంటే సువార్త వారికి ప్రకటించబడిన విధంగానే మనకు ప్రకటించబడింది; అయితే సువార్తకు విధేయత చూపించినవారితో వారు విశ్వాసంతో కలిసి ఉండలేదు కాబట్టి విన్న సువార్త వారికి ప్రయోజనంగా లేదు. <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />అయితే విశ్వసించిన మనం ఆ విశ్రాంతిలో ప్రవేశిస్తాము. అయితే దేవుడు ఇలా అన్నారు,</para>
  <para style="q1" vid="HEB 4:3">“ ‘కాబట్టి వారు ఎన్నడు నా విశ్రాంతిలో ప్రవేశింపరు’</para>
  <para style="q2" vid="HEB 4:3">అని నేను కోపంలో ప్రమాణం చేశాను.”<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 95:11">కీర్తన 95:11</ref>; <ref loc="PSA 5">5</ref></char></char></note></para>
  <para style="m" vid="HEB 4:3">ఆయన తన కార్యాలన్ని లోకాన్ని సృష్టించినప్పుడే పూర్తి చేశారు. <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />దేవుడు ఏడవ దినాన్ని గురించి ఇంకొక చోట ఇలా అన్నారు: “దేవుడు ఏడవ రోజున తన పనులన్నిటిని నుండి విశ్రాంతి తీసుకున్నారు.”<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 2:2">ఆది 2:2</ref></char></char></note> <verse eid="HEB 4:4" /><verse number="5" style="v" sid="HEB 4:5" />పై వచనంలో ఆయన, “వారు ఎన్నడు నా విశ్రాంతిలో ప్రవేశింపరు” అని అన్నారు.<verse eid="HEB 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 4:6" />అయితే కొందరు ఆ విశ్రాంతిని గురించిన సువార్తను విన్నా కూడ తాము విన్నవాటిని వారు నమ్మలేదు కాబట్టి ఆ విశ్రాంతిలోనికి ప్రవేశించలేకపోయారు. <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />మరల దేవుడు ఒక దినాన్ని సిద్ధపరచి దాన్ని “నేడు” అని పిలిచారు. వాక్యంలో వ్రాయబడిన ప్రకారం చాలా కాలం తర్వాత ఆయన దావీదు ద్వారా కూడా ఇదే మాటను మాట్లాడారు:</para>
  <para style="q1" vid="HEB 4:7">“నేడు, ఆయన స్వరాన్ని మీరు వింటే,</para>
  <para style="q2" vid="HEB 4:7">మీ హృదయాలను కఠినం చేసుకోకండి.”<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 95:7">కీర్తన 95:7</ref>,<ref loc="PSA 95:8">8</ref></char></char></note><verse eid="HEB 4:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 4:8" />ఒకవేళ యెహోషువ వారికి విశ్రాంతి ఇచ్చి ఉంటే, దేవుడు మరొక దినాన్ని గురించి మాట్లాడి ఉండేవాడు కాడు. <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />కాబట్టి దేవుని ప్రజలకు ఏడవ రోజు సబ్బాతు దినం; <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />ఎవరైనా దేవుని విశ్రాంతిలోకి ప్రవేశిస్తే, దేవుడు తన పనుల నుండి విశ్రాంతి పొందినట్లే, వారు కూడా తమ పనుల నుండి విశ్రాంతి పొందుతారు. <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />కాబట్టి, వారి అవిధేయత మాదిరిని అనుసరించి ఎవరూ నశించిపోకుండా ప్రతి ప్రయత్నాన్ని చేసి దేవుని విశ్రాంతిలో ప్రవేశిద్దాము.<verse eid="HEB 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12" />దేవుని వాక్యం సజీవమైనది చురుకైనది. అది రెండంచులు కలిగిన ఏ ఖడ్గం కన్నా పదును కలిగి, ప్రాణాన్ని, ఆత్మను, కీళ్ళను, మూలుగను వేరు చేస్తూ లోనికి చొచ్చుకొని పోతూ, హృదయం యొక్క ఆలోచనలను, వైఖరిని పరీక్షిస్తుంది. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />సృష్టి అంతటిలో దేవుని దృష్టి నుండి దాచబడింది ఏది లేదు. మనం ఎవరికి లెక్క అప్పగించాల్సి ఉందో ఆయన కళ్లెదుట ప్రతిదీ తెరవబడి స్పష్టంగా ఉంది.<verse eid="HEB 4:13" /></para>
  <para style="s1">యేసు గొప్ప ప్రధాన యాజకుడు</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />కాబట్టి, పరలోకానికి ఎక్కివెళ్లిన<note caller="+" style="f"><char style="fr" closed="false">4:14 </char><char style="ft" closed="false">గ్రీకులో </char><char style="fqa" closed="false">ఆకాశాల గుండా వెళ్లినవాడు</char></note> దేవుని కుమారుడైన యేసు అనే గొప్ప ప్రధాన యాజకుడు మనకు ఉన్నాడు కాబట్టి మనం అంగీకరించిన విశ్వాసాన్ని గట్టిగా పట్టుకుందాము. <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />అయితే మన ప్రధాన యాజకుడు మనలానే అన్ని విధాలుగా శోధించబడినప్పటికి ఆయన పాపం చేయలేదు కాబట్టి మన బలహీనతల గురించి సానుభూతి చూపించేవాడు. <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />కాబట్టి మన అవసర సమయంలో సహాయపడేలా కనికరం కృప పొందడానికి మనం ధైర్యంగా దేవుని కృపా సింహాసనాన్ని సమీపిద్దాము.<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />ప్రతి ప్రధాన యాజకుడు ప్రజల నుండి ఏర్పరచబడి, దేవునికి సంబంధించిన విషయాల్లో ప్రజల ప్రతినిధిగా పాపపరిహార బలులను కానుకలను అర్పించడానికి నియమించబడ్డాడు. <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />తాను కూడా బలహీనతలకు గురైనవానిగా ఉన్నా, అవివేకులైన వారిని దారి తప్పిపోతున్న వారిని దయతో నడిపించగల సమర్ధుడు. <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />ఈ కారణంగా, అతడు తన పాపాల కోసం అలాగే ప్రజల పాపాల కోసం బలి అర్పించాల్సి ఉంది. <verse eid="HEB 5:3" /><verse number="4" style="v" sid="HEB 5:4" />ఈ గౌరవాన్ని ఎవరు తమంతట తాము పొందలేరు, కాని అహరోను ఎలా పిలువబడ్డాడో అలాగే దేవుని చేత పిలువబడినప్పుడు వారు దానిని పొందుకుంటారు.<verse eid="HEB 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 5:5" />అదేరీతిగా, క్రీస్తు కూడా ప్రధాన యాజకునిగా అవ్వడానికి తనంతట తానే మహిమను తీసుకోలేదు. అయితే దేవుడే ఆయనతో ఇలా అన్నారు,</para>
  <para style="q1" vid="HEB 5:5">“నీవు నా కుమారుడవు;</para>
  <para style="q2" vid="HEB 5:5">ఈ రోజు నేను నీకు తండ్రిని అయ్యాను.”<note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 2:7">కీర్తన 2:7</ref></char></char></note><verse eid="HEB 5:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 5:6" />మరొక చోట ఆయన ఇలా అన్నారు,</para>
  <para style="q1" vid="HEB 5:6">“మెల్కీసెదెకు క్రమంలో,</para>
  <para style="q2" vid="HEB 5:6">నీవు నిరంతరం యాజకునిగా ఉన్నావు.”<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 110:4">కీర్తన 110:4</ref></char></char></note><verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />యేసు భూమి మీద జీవించిన రోజుల్లో, మరణం నుండి తనను రక్షించడానికి శక్తి కలిగిన దేవునికి తీవ్రమైన రోదనతో, కన్నీటితో ప్రార్థనలు విన్నపాలు అర్పించారు, ఆయనకున్న భక్తి విధేయతల కారణంగా దేవుడు ఆయన ప్రార్థనలు ఆలకించారు. <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />ఆయన కుమారుడై ఉండి కూడా, తాను అనుభవించిన శ్రమల ద్వారా విధేయతను నేర్చుకున్నారు, <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />ఆయన పరిపూర్ణుడవ్వగానే తనకు లోబడే వారందరికి శాశ్వతమైన రక్షణకు మూలాధారం అయ్యారు. <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />మెల్కీసెదెకు క్రమంలో ప్రధాన యాజకునిగా దేవుని చేత నియమింపబడ్డారు.<verse eid="HEB 5:10" /></para>
  <para style="s1">పడిపోకుండా ఉండాలని హెచ్చరిక</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />దీనిని గురించి మేము చెప్పాల్సింది చాలా ఉంది కాని, గ్రహించడానికి మీరు ఏమాత్రం ప్రయత్నించడం లేదు కాబట్టి మీకు వివరించడం కష్టము. <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />నిజానికి, ఈ సమయానికి మీరు బోధకులై ఉండాల్సింది, కాని ఇప్పటికి మీకు మరొకరు దేవుని వాక్యంలోని ప్రాథమిక సత్యాలను బోధించాల్సిన అవసరం ఉంది. బలమైన ఆహారం కాదు, మీకు పాలు అవసరము. <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />పాలు త్రాగుతూ జీవించేవారు ఇంకా శిశువుగానే ఉన్నారు, కాబట్టి నీతిని గురించిన బోధతో పరిచయం లేదు. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />అయితే బలమైన ఆహారం పరిణతి చెందిన వారికి, అంటే ఎవరైతే నిరంతరం ఉపయోగించడం ద్వారా తమకు తాముగా మంచి చెడులను వేరు చేసే శిక్షణ పొందుకున్నవారికి.<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />అందువల్ల మనం క్రీస్తు గురించిన ప్రాధమిక బోధన అంటే, మరణానికి దారితీసే చర్యల నుండి పశ్చాత్తాపం, దేవుని యందు విశ్వాసముంచడం వంటి వాటితో మళ్ళీ పునాదిని మళ్ళీ వేయక, దానికి మించి, పరిపక్వతకు వైపుకు వెళ్దాం, <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />శుద్ధీకరణ ఆచారాలు,<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="fq" closed="false">శుద్ధీకరణ ఆచారాలు </char><char style="fqa" closed="false">బాప్తిస్మం గురించి</char></note> హస్త నిక్షేపణ, మృతుల పునరుత్థానం, నిత్య తీర్పు గురించిన మళ్ళీ ఉపదేశం అవసరం లేదు. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />దేవుడు అనుమతిస్తే, మనం అలా చేద్దాము.<verse eid="HEB 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4" />ఒకసారి వెలిగించబడి, పరలోకసంబంధమైన వరాలను అనుభవించినవారు తెలుసుకొని, పరిశుద్ధాత్మలో పాలిభాగస్థులై, <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />దేవుని వాక్యం యొక్క అనుగ్రహాన్ని, భవిష్యత్కాలాల శక్తుల ప్రభావాలను రుచి చూసినప్పటికి, <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />తప్పిపోయినవారిని<note caller="+" style="f"><char style="fr" closed="false">6:6 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">వారు తప్పిపోతే</char></note> తిరిగి పశ్చాత్తాపం వైపుకు నడిపించడం అసాధ్యము. అలాంటివారు తమ నాశనానికే దేవుని కుమారుని మళ్ళీ సిలువవేస్తూ, ఆయనను బహిరంగంగా అవమానానికి గురిచేస్తున్నారు. <verse eid="HEB 6:6" /><verse number="7" style="v" sid="HEB 6:7" />భూమి తనపై తరచుగా కురిసే వర్షపు నీటిని త్రాగి, దానిపై వ్యవసాయం చేసేవారికి ప్రయోజనకరమైన పంటను ఇస్తుండగా పండించినవారు దాన్ని దేవుని దీవెనగా పొందుతున్నారు. <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />అయితే ముళ్ళపొదలను కలుపు మొక్కలను పండించే భూమి విలువలేనిదై శాపానికి గురి అవుతుంది ఆ తర్వాత చివరిలో అది కాల్చివేయబడుతుంది.<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />అయితే ప్రియమైన వారలారా, మేము ఇలా మాట్లాడుతున్నప్పటికి, మీ రక్షణ గురించి మంచి సంగతులు ఉన్నాయని మేము నిశ్చయంగా ఉన్నాము. <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />దేవుడు అన్యాయస్థుడు కాడు; ఆయనపై మీరు చూపిస్తున్న ప్రేమను బట్టి ఆయన ప్రజలకు మీరు చేసిన చేస్తున్న సహాయాన్ని మరచిపోయేవాడు కాడు. <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />మీలో ప్రతి ఒక్కరు, మీరు కలిగి ఉన్న నిరీక్షణ సంపూర్ణంగా నెరవేరేలా ఇదే ఆసక్తిని చివరి వరకు చూపించాలని మేము కోరుతున్నాము. <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />అంతేగాక, మీరు సోమరులుగా ఉండక, విశ్వాసం, ఓర్పు ద్వారా వాగ్దానం చేయబడినదానికి వారసులైన వారిని మీరు అనుకరించాలని మేము కోరుతున్నాము.<verse eid="HEB 6:12" /></para>
  <para style="s1">దేవుని వాగ్దానం యొక్క నిశ్చయత</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />దేవుడు అబ్రాహాముకు వాగ్దానం చేసినపుడు, ఆయన కంటే గొప్పవాడు మరియొకడు లేడు కాబట్టి ఆయన తన మీదనే ప్రమాణం చేసి, <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />“నిశ్చయంగా నేను నిన్ను దీవిస్తాను, నీ సంతానాన్ని అభివృద్ధి చేస్తాను”<note caller="+" style="f"><char style="fr" closed="false">6:14 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 22:17">ఆది 22:17</ref></char></char></note> అని చెప్పారు. <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />ఓర్పుతో వేచి ఉన్న తర్వాత, చేయబడిన వాగ్దానఫలాన్ని అబ్రాహాము పొందుకొన్నాడు.<verse eid="HEB 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 6:16" />ప్రజలు ప్రమాణం చేసినప్పుడు తమకంటే గొప్పవారి తోడని ప్రమాణం చేస్తారు, దాంతో వారి అన్ని వివాదాలు పరిష్కారమవుతాయి. <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />తన వాగ్దానానికి వారసులైన వారికి తన మార్పులేని స్వభావంలోని ఉద్దేశాన్ని స్పష్టం చేయడానికి దేవుడు తాను చేసిన వాగ్దానాన్ని ప్రమాణంతో దృఢపరిచారు. <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />దేవుడు అబద్ధమాడడం అసాధ్యమైన రెండు మార్పులేని విషయాల ద్వారా, మన ముందు ఉంచిన నిరీక్షణను పట్టుకోవడానికి పరుగెత్తిన మనల్ని ఎంతో ప్రోత్సహించగలిగేలా, దేవుడు ఇలా చేశారు. <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />మనకు ఉన్న ఈ నిరీక్షణ మన ఆత్మకు లంగరులా స్థిరపరచి భద్రపరుస్తుంది. ఇది తెర వెనుక ఉన్న గర్భాలయంలోకి ప్రవేశింప చేస్తుంది. <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />అక్కడే యేసు మనకంటే ముందుగా మెల్కీసెదెకు క్రమంలో నిరంతరం ప్రధాన యాజకునిగా మన పక్షాన దానిలోనికి ప్రవేశించారు.<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s1">యాజకుడైన మెల్కీసెదెకు</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />ఈ మెల్కీసెదెకు షాలేముకు రాజు సర్వోన్నతుడైన దేవుని యాజకుడు. అబ్రాహాము నలుగురు రాజులను ఓడించి తిరిగి వస్తున్నప్పుడు షాలేము రాజైన మెల్కీసెదెకు అబ్రాహామును కలిసి అతన్ని ఆశీర్వదించాడు. <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />అబ్రాహాము అన్నిటిలో పదవ భాగాన్ని అతనికి ఇచ్చాడు. మెల్కీసెదెకు అనగా మొదట, “నీతికి రాజు అని అర్థం” అటు తర్వాత “షాలేము రాజు” అనగా, “శాంతికి రాజు” అని అర్థం <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />తల్లి తండ్రి లేకపోయినా, వంశావళి లేకపోయినా, జీవిత ఆరంభం అంతం లేకపోయినా అతడు దేవుని కుమారునికి సాదృశ్యంగా, నిరంతరం యాజకునిగా ఉన్నాడు.<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />ఇతడెంత గొప్పవాడో ఆలోచించండి: మన పితరుడైన అబ్రాహాము కొల్లగొట్టిన దానిలో నుండి పదో భాగాన్ని ఇచ్చాడు! <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />లేవీ సంతతిలో నుండి యాజకులైనవారు ప్రజల నుండి అంటే, అబ్రాహాము నుండి వచ్చిన తోటివారైనా ఇశ్రాయేలీయుల నుండి పదవ వంతు వసూలు చేయాలని ధర్మశాస్త్రం ఆదేశిస్తుంది. <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />ఈ మనుష్యుడు లేవీ సంతతివాడు కానప్పటికి, అబ్రాహాము నుండి పదో భాగాన్ని తీసుకుని, దేవుని వాగ్దానాలను పొందిన అతన్ని దీవించాడు. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />తక్కువవాడు గొప్పవానిచేత దీవించబడతాడు అనడంలో సందేహం లేదు. <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />ఒక సందర్భంలో, దశమభాగం చనిపోయేవారి చేత వసూలు చేయబడింది; మరో సందర్భంలో, బ్రతికి ఉన్నాడని ప్రకటించబడిన వారి ద్వారా వసూలు చేయబడింది. <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />దశమభాగం పుచ్చుకొనే లేవీయులు అబ్రాహాము ద్వారా పదో భాగాన్ని చెల్లించారు అని చెప్పవచ్చు, <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />ఎందుకంటే మెల్కీసెదెకు అబ్రాహామును కలుసుకొన్నపుడు, లేవీ ఇంకా తన పితరుని శరీరంలోనే ఉన్నాడు.<verse eid="HEB 7:10" /></para>
  <para style="s1">యేసు మెల్కీసెదెకు వంటివాడు</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />ప్రజలకు ఇవ్వబడిన ధర్మశాస్త్రం స్థాపించిన లేవీయుల యాజకత్వం ద్వారా పరిపూర్ణతను సాధించగలిగివుంటే మరొక యాజకుడు అహరోను క్రమంలో కాక, మెల్కీసెదెకు క్రమంలో రావలసిన అవసరం ఏంటి? <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />యాజకత్వం మార్చబడినపుడు, ధర్మశాస్త్రం కూడా మార్చబడాలి. <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />ఈ సంగతులు ఎవరి గురించి చెప్పబడ్డాయో అతడు వేరొక వంశానికి చెందిన వాడు, ఆ వంశం నుండి ఎవరు, ఎన్నడు బలిపీఠం దగ్గర పరిచర్య చేయలేదు. <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />మన ప్రభువు యూదా సంతానం నుండి వచ్చాడనేది స్పష్టం కాని ఆ గోత్రానికి సంబంధించి యాజకులను గురించి మోషే ఏమి చెప్పలేదు. <verse eid="HEB 7:14" /><verse number="15" style="v" sid="HEB 7:15" />మెల్కీసెదెకు వంటి వేరొక యాజకుడు వస్తే మేము చెప్పింది మరింత స్పష్టంగా అర్థమవుతుంది, <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />యాజకుడైనవాడు వంశపారంపర్య నియమం ప్రకారం యాజకుడు కాలేదు, కాని నాశనములేని జీవానికున్న శక్తినిబట్టి యాజకుడయ్యాడు. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />అందుకే ఇలా ప్రకటించబడింది:</para>
  <para style="q1" vid="HEB 7:17">“మెల్కీసెదెకు క్రమంలో,</para>
  <para style="q2" vid="HEB 7:17">నీవు నిరంతరం యాజకునిగా ఉంటావు.”<note caller="+" style="f"><char style="fr" closed="false">7:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 110:4">కీర్తన 110:4</ref></char></char></note><verse eid="HEB 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 7:18" />పాత నియమం బలహీనం, నిరుపయోగం కాబట్టి ప్రక్కకు పెట్టబడింది. <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />ఎందుకంటే ఆ ధర్మశాస్త్రం దేన్ని పరిపూర్ణం చేయలేదు, కాబట్టి మనల్ని దేవునికి దగ్గర చేసే, మెరుగైన నిరీక్షణ పరిచయం చేయబడింది.<verse eid="HEB 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20" />అది ప్రమాణం లేకుండా కాదు! ఇతరులు ఏ ప్రమాణం చేయకుండానే యాజకులయ్యారు, <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />అయితే ఆయన ప్రమాణంతో యాజకుడు అయ్యేటప్పుడు దేవుడు ఆయనతో ఇలా అన్నారు:</para>
  <para style="q1" vid="HEB 7:21">“ప్రభువు ప్రమాణం చేశారు</para>
  <para style="q2" vid="HEB 7:21">ఆయన తన మనస్సు మార్చుకోరు:</para>
  <para style="q2" vid="HEB 7:21">‘నీవు నిరంతరం యాజకునిగా ఉంటావు.’ ”<note caller="+" style="f" category="dup"><char style="fr" closed="false">7:21 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 110:4">కీర్తన 110:4</ref></char></char></note><verse eid="HEB 7:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="HEB 7:22" />ఈ ప్రమాణం వలన, యేసు మరింత మేలైన నిబంధనకు హామీదారు అయ్యాడు.<verse eid="HEB 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23" />మరణం వారిని ఆ పదవిలో కొనసాగనివ్వలేదు కాబట్టి యాజకులైనవారు అనేకమంది ఉన్నారు. <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />అయితే యేసు నిరంతరం జీవిస్తున్నాడు కాబట్టి ఆయన శాశ్వత యాజకత్వాన్ని కలిగి ఉన్నాడు. <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />తన ద్వారా దేవుని దగ్గరకు వచ్చేవారి కోసం ఎల్లప్పుడు విజ్ఞాపన చేయడానికి ఆయన నిరంతరం జీవిస్తున్నాడు కాబట్టి వారిని ఆయన సంపూర్ణంగా<note caller="+" style="f"><char style="fr" closed="false">7:25 </char><char style="fq" closed="false">సంపూర్ణంగా </char><char style="fqa" closed="false">నిరంతరం</char></note> రక్షించగలడు.<verse eid="HEB 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26" />పరిశుద్ధుడు, నిందారహితుడు, పవిత్రుడు, పాపుల నుండి ప్రత్యేకించబడినవాడు, ఆకాశాల కంటే పైగా హెచ్చింపబడినవాడు, మన అవసరాలను తీర్చగల ప్రధాన యాజకుడు. <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />ఆయన ఇతర ప్రధాన యాజకుల వంటివాడు కాదు, ప్రతిదినం, మొదట తన పాపాల కోసం, తర్వాత ప్రజల పాపాల కోసం బలులు అర్పించాల్సిన అవసరం ఆయనకు లేదు. తనను తాను అర్పించుకున్నప్పుడే వారందరి పాపాల కోసం ఒకేసారి అర్పించాడు. <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />ధర్మశాస్త్రం బలహీనతతో ఉన్న మనుష్యులను ప్రధాన యాజకులుగా నియమిస్తుంది; కాని ధర్మశాస్త్రం తర్వాత వచ్చిన దేవుని ప్రమాణం నిత్యం పరిపూర్ణునిగా చేయబడిన దేవుని కుమారున్ని ప్రధాన యాజకునిగా నియమించింది.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s1">యేసు మన ప్రధాన యాజకుడు</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />మనం చెప్తున్న దానిలోని ముఖ్య సారాంశమిది: పరలోకంలో సర్వోన్నతుని సింహాసనం యొక్క కుడి వైపున కూర్చుని ఉన్న వానిని మనం ప్రధాన యాజకునిగా కలిగి ఉన్నాం, <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />ఆయన మానవుని చేత కాక దేవుని చేత తయారుచేయబడిన నిజమైన ప్రత్యక్షగుడారంలో అతిపరిశుద్ధమైన స్థలంలో ప్రధాన యాజకునిగా పరిచర్య చేస్తున్నాడు.<verse eid="HEB 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3" />ప్రతి ప్రధాన యాజకుడు దేవునికి కానుకలను బలులను అర్పించడానికి నియమించబడి ఉన్నాడు కాబట్టి ఈయన కూడ దేవునికి ఏదైనా సమర్పించాల్సిన అవసరం ఉండింది. <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />ఆయన భూమి మీద ఉండి ఉంటే, ఒక యాజకుడై ఉండేవాడు కాడు, ధర్మశాస్త్రంలో వ్రాసి ఉన్న ప్రకారం అర్పణలు అర్పించే యాజకులు ఇప్పటికే ఉన్నారు. <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />పరలోకంలో ఉన్న దానికి కేవలం ఒక నమూనాగా ఛాయాచిత్రంగా ఉన్న పరిశుద్ధ స్థలంలో యాజకులుగా వారు సేవ చేస్తారు. ఇందుకే మోషే గుడారాన్ని నిర్మిస్తున్నప్పుడు దాన్ని గురించి ఇలా హెచ్చరిక పొందాడు: “పర్వతం మీద నేను నీకు చూపించిన నమూనా ప్రకారమే ప్రతిదీ చేసేలా చూడాలి.”<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 25:40">నిర్గమ 25:40</ref></char></char></note> <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />అయితే నిజానికి నూతన నిబంధన మరింత గొప్ప వాగ్దానాలపై స్థాపించబడింది కాబట్టి, యేసు మధ్యవర్తిగా ఉన్న ఈ నిబంధన గత నిబంధన కన్న శ్రేష్ఠమైనదైనట్లే ఆయనకు అప్పగించబడిన పరిచర్య కూడా శ్రేష్ఠమైనదే.<verse eid="HEB 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7" />అయితే మొదటి నిబంధన లోపం లేనిదైతే, రెండవ దాని కోసం వెదకాల్సిన అవసరమే లేదు. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />అయితే దేవుడు ప్రజల్లో దోషాన్ని కనుగొని ఇలా చెప్పారు:<note caller="+" style="f"><char style="fr" closed="false">8:8 </char><char style="ft" closed="false">కొ.ప్ర.లలో </char><char style="fqa" closed="false">దోషము కనుగొని ప్రజలతో ఇలా చెప్పారు </char><char style="ft" closed="false">అని తర్జుమా చేయబడింది</char></note></para>
  <para style="q1" vid="HEB 8:8">“ప్రభువు ఇలా ప్రకటిస్తున్నారు, ఆ రోజులు వస్తున్నాయి,</para>
  <para style="q2" vid="HEB 8:8">అప్పుడు నేను ఇశ్రాయేలు ప్రజలతోనూ</para>
  <para style="q1" vid="HEB 8:8">యూదా ప్రజలతోనూ</para>
  <para style="q2" vid="HEB 8:8">క్రొత్త నిబంధన చేస్తాను.<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />ఆ నిబంధన, ఈజిప్టు దేశం నుండి నేను వారి పూర్వికుల</para>
  <para style="q2" vid="HEB 8:9">చేయి పట్టుకొని బయటకు నడిపించినపుడు</para>
  <para style="q1" vid="HEB 8:9">నేను వారితో చేసిన</para>
  <para style="q2" vid="HEB 8:9">నిబంధనలా ఉండదు,</para>
  <para style="q1" vid="HEB 8:9">ఎందుకంటే వారు నా నిబంధనకు నమ్మకంగా నిలబడలేదు,</para>
  <para style="q2" vid="HEB 8:9">అందుకే నేను వారి నుండి దూరమయ్యాను,</para>
  <para style="q2" vid="HEB 8:9">అని ప్రభువు చెప్తున్నారు.<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />ఆ కాలం తర్వాత, ఇశ్రాయేలు ప్రజలతో</para>
  <para style="q2" vid="HEB 8:10">నేను స్థాపించే నిబంధన ఇదే అని ప్రభువు ప్రకటిస్తున్నారు.</para>
  <para style="q1" vid="HEB 8:10">వారి మనస్సులో నా న్యాయవిధులను ఉంచుతాను</para>
  <para style="q2" vid="HEB 8:10">వారి హృదయాల మీద వాటిని వ్రాస్తాను.</para>
  <para style="q1" vid="HEB 8:10">నేను వారి దేవుడనై ఉంటాను,</para>
  <para style="q2" vid="HEB 8:10">వారు నా ప్రజలై ఉంటారు.<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />ఇకపై వారిలో ఎవ్వరూ తమ పొరుగువారికి బోధించరు,</para>
  <para style="q2" vid="HEB 8:11">‘ప్రభువును తెలుసుకోండి’ అని ఒకరికొకరు చెప్పుకోరు,</para>
  <para style="q1" vid="HEB 8:11">ఎందుకంటే వారిలో సామాన్యులు మొదలుకొని గొప్పవారి వరకు</para>
  <para style="q2" vid="HEB 8:11">అందరు నన్ను తెలుసుకుంటారు.<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />ఎందుకంటే నేను దయతో వారి దుష్టత్వాన్ని క్షమించి</para>
  <para style="q2" vid="HEB 8:12">వారి పాపాలను ఇక ఎన్నడు జ్ఞాపకం చేసుకోను.”<note caller="+" style="f"><char style="fr" closed="false">8:12 </char><char style="ft" closed="false"><char style="xt">యిర్మీయా 31:31-34</char></char></note><verse eid="HEB 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13" />ఆయన ఈ నిబంధనను, “క్రొత్త” అని పిలువడం చేత మొదటి దాన్ని వాడుకలో లేకుండ చేశారు; వాడుకలో లేనివి పాతవి త్వరలో అదృశ్యమవుతాయి.<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s1">భూసంబంధమైన ప్రత్యక్షగుడారంలో ఆరాధన</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />మొదటి నిబంధనలో దేవుని ఆరాధించడానికి కొన్ని నియమాలు, భూసంబంధమైన ప్రత్యక్ష గుడారం ఉన్నాయి. <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />ఆ గుడారం ఇలా ఏర్పరచబడింది. దానిలోని మొదటి గదిలో ఒక దీప దీపస్తంభం, ఒక బల్ల దానిపై అర్పించబడిన రొట్టెలు ఉన్నాయి, ఆ గదికి పరిశుద్ధ స్థలమని పేరు. <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />రెండవ తెర వెనుక అతి పరిశుద్ధ స్థలం అని పిలువబడే గది ఉంది, <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />దానిలో ధూపం వేయడానికి బంగారు బలిపీఠం, బంగారంతో కప్పబడిన నిబంధన పెట్టె ఉన్నాయి. ఆ పెట్టెలో మన్నా ఉంచబడిన బంగారు పాత్ర, చిగురించిన అహరోను కర్ర, వ్రాయబడిన నిబంధన రాతిపలకలు ఉన్నాయి. <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />ఈ పెట్టె పైన మహిమగల కెరూబులు తమ రెక్కలతో ప్రాయశ్చిత్త పీఠంను కాపాడుతూ ఉన్నాయి. అయితే ఈ సంగతుల గురించి వివరంగా ఇప్పుడు మనం చర్చించలేము.<verse eid="HEB 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6" />ఇలా అన్ని ఏర్పాటు చేయబడిన తర్వాత, ప్రతిరోజు యాజకులు తమ పరిచర్యను చేయడానికి మొదటి గదిలోకి వెళ్తారు. <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />అయితే కేవలం ప్రధాన యాజకుడు మాత్రమే లోపలి గదిలోకి ప్రవేశించాడు, అది కూడా సంవత్సరానికి ఒక్కసారే. తెలియక చేసిన పాపాల కోసం తన కోసం, ప్రజల కోసం అతడు అర్పించి ఆ రక్తాన్ని తీసుకెళ్లాలి, రక్తం లేకుండా వెళ్లడానికి లేదు. <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />అంటే మొదటి గుడారం నిలిచి ఉన్నంత కాలం అతి పరిశుద్ధ స్థలంలోనికి వెళ్లే మార్గం ఇంకా తెరవబడలేదని పరిశుద్ధాత్మ దీని ద్వారా చూపిస్తున్నాడు. <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />ఇది ప్రస్తుత కాలాన్ని సూచించే ఒక ఉపమానం, దేవునికి అర్పించబడే కానుకలు, బలులు ఆరాధించేవారి మనస్సాక్షిని శుధ్ధిచేయలేవని తెలియజేస్తుంది. <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />అవి కేవలం తినడం త్రాగడం, వివిధ శుద్ధీకరణ ఆచారాలకు సంబంధించిన బాహ్య నియమాలు క్రొత్త క్రమం వచ్చేవరకు వర్తిస్తాయి.<verse eid="HEB 9:10" /></para>
  <para style="s1">క్రీస్తు రక్తం</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />అయితే ఇప్పుడు ఇక్కడ ఉన్న మంచి విషయాల యొక్క ప్రధాన యాజకునిగా క్రీస్తు వచ్చినప్పుడు, మానవుల చేతితో చేయబడని గొప్పదైన పరిపూర్ణమైన గుడారం గుండా ఆయన వెళ్లాడు, అంటే అది ఈ సృష్టిలో ఒక భాగం కాదు. <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />ఆయన మేకల దూడల రక్తాన్ని తీసుకుని ప్రవేశించలేదు; కాని శాశ్వత విమోచన సంపాదించడానికి స్వరక్తంతో అతి పరిశుద్ధ స్థలంలోకి ఆయన ఒక్కసారే ప్రవేశించాడు. <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />ఆచారపరంగా అపవిత్రులైనవారు బాహ్యంగా పవిత్రులయ్యేలా మేకల ఎడ్ల రక్తంను దహించబడిన దూడ బూడిదను వారిపై చల్లి వారిని పవిత్రులుగా చేస్తాడు. <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />నిత్యమైన ఆత్మ ద్వారా తనను తాను దేవునికి నిర్దోషిగా అర్పించుకొన్న క్రీస్తు రక్తం, మనం జీవంగల దేవుని సేవించేలా, మరణానికి నడిపించే వ్యర్థమైన క్రియల<note caller="+" style="f"><char style="fr" closed="false">9:14 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">నిరర్ధకమైన ఆచారాల</char></note> నుండి మన మనస్సాక్షిని ఇంకెంత ఎక్కువగా పవిత్రపరుస్తుంది!<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />ఈ కారణంవల్లనే, పిలువబడిన వారు వాగ్దానం చేయబడిన శాశ్వత వారసత్వాన్ని పొందడానికి క్రొత్త నిబంధనకు క్రీస్తు మధ్యవర్తిగా ఉన్నాడు. మొదటి నిబంధన ప్రకారం చేసిన పాపాల నుండి వారిని విడిపించడానికి ఆయన మరణించి క్రయధనం చెల్లించాడు.<verse eid="HEB 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16" />వీలునామా<note caller="+" style="f"><char style="fr" closed="false">9:16 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">నిబంధన </char><char style="ft" closed="false">అనే అర్థం వచ్చే మరొక గ్రీకు పదం</char><char style="ft" closed="false">; <char style="xt" link-href="HEB 9:17"><ref loc="HEB 9:17">17</ref></char> వచనంలో కూడా</char></note> విషయంలో, దాన్ని తయారుచేసిన వాడు చనిపోయాడని నిరూపించడం అవసరం, <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />ఎందుకంటే, వీలునామా వ్రాసినవారు బ్రతికి ఉన్నంత వరకు ఆ వీలునామా చెల్లదు; వారు మరణించిన తర్వాత మాత్రమే అది అమల్లోకి వస్తుంది. <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />అందుకే, మొదటి నిబంధన కూడా రక్తం లేకుండా అమలు పరచబడలేదు. <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />ధర్మశాస్త్రంలోని ప్రతి ఆజ్ఞను మోషే ప్రజలందరికి వినిపించాక, అతడు నీరు, ఎర్రని ఉన్ని, హిస్సోపు కొమ్మలతో దూడల మేకల రక్తాన్ని తీసుకుని, గ్రంథంపైన ప్రజలందరిపైన చల్లాడు. <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />అతడు, “పాటించుమని మీకు దేవుడు ఆజ్ఞాపించిన, నిబంధన రక్తం ఇదే”<note caller="+" style="f"><char style="fr" closed="false">9:20 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 24:8">నిర్గమ 24:8</ref></char></char></note> అన్నాడు. <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />అదే విధంగా, అతడు గుడారంపై దాని ఆచారాల్లో ఉపయోగించే అన్ని వస్తువుల పైన రక్తాన్ని చల్లాడు. <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />నిజానికి, ధర్మశాస్త్రాన్ని అనుసరించి దాదాపు అన్ని వస్తువులను రక్తంతో శుద్ధి చేయాలి, రక్తం చిందించకుండ పాపక్షమాపణ కలుగదు.<verse eid="HEB 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />కాబట్టి, ఈ బలులతో పరలోకపు వాటిని పోలి ఉన్న ఈ వస్తువులు శుద్ధి చేయబడటం అవసరం, కానీ పరలోకానికి సంబంధించినవి వీటికన్నా మెరుగైన బలులతో చేయబడాలి. <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />ఎందుకంటే నిజమైన దాని పోలికలో మానవ హస్తాలతో చేయబడిన పరిశుద్ధ స్థలంలోకి క్రీస్తు ప్రవేశించలేదు; కాని ఇప్పుడు మన కోసం దేవుని సన్నిధిలో కనబడటానికి ఆయన పరలోకంలోనికే ప్రవేశించాడు. <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />యూదుల ప్రధాన యాజకుడు, ప్రతి సంవత్సరం అతి పరిశుద్ధ స్థలంలోకి ప్రవేశించినట్టుగా క్రీస్తు పదే పదే తనది కాని రక్తాన్ని అర్పించడానికి పరలోకంలోకి ప్రవేశించలేదు. <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />లేకపోతే ప్రపంచం సృష్టింపబడినప్పటి నుండి అనేకసార్లు క్రీస్తు శ్రమపడాల్సి ఉండేది. అయితే తనను తాను బలిగా అర్పించుకోవడం ద్వారా ప్రజల అపరాధాలను పూర్తిగా కొట్టివేయాలని అన్ని యుగాల కోసం ఒక్కసారే ఆయన ప్రత్యక్షమయ్యాడు. <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />మనుష్యులు ఒక్కసారే చనిపోవాలని, ఆ తర్వాత తీర్పును పొందాలని నియమించబడిన ప్రకారం, <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />అనేకుల పాపాలను తొలగించడానికి క్రీస్తు కూడా ఒక్కసారే బలిగా అర్పించబడ్డాడు; పాపాన్ని భరించడానికి కాకుండా, తన కొరకై వేచి ఉన్నవారిని రక్షించడానికి ఆయన రెండవసారి వస్తారు.<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="s1">అందరి కోసం ఒక్కసారే క్రీస్తు అర్పించబడుట</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />ధర్మశాస్త్రం రాబోయే మంచి విషయాల నీడ మాత్రమే కాని నిజ స్వరూపం కాదు. ప్రతి సంవత్సరం అర్పించే అవే బలుల ద్వార అది, ఆరాధించడానికి వచ్చేవారిని పరిపూర్ణులను చేయలేదు. <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />లేకపోతే, వారు బలులు అర్పించడం మానేసేవారు కాదా? ఎందుకంటే ఆరాధించేవారు ఒక్కసారే శుద్ధి చేయబడ్డారు, ఇక అప్పటినుండి వారికి పాపాల గురించి ఇకపై అపరాధ మనస్సాక్షి లేదు. <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />అయితే ఆ బలులు ప్రతి సంవత్సరం పాపాల గురించి వారికి గుర్తు చేసేవిగా ఉండేవి. <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />ఎడ్ల మేకల రక్తానికి పాపాలను తొలగించడం అసాధ్యము.<verse eid="HEB 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />అందుకని, క్రీస్తు ఈ లోకానికి వచ్చినపుడు ఇలా అన్నారు:</para>
  <para style="q1" vid="HEB 10:5">“బలిని అర్పణను మీరు కోరలేదు,</para>
  <para style="q2" vid="HEB 10:5">కాని మీరు నాకొక శరీరాన్ని సిద్ధపరచారు;<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />దహనబలులతో పాపపరిహార బలులతో</para>
  <para style="q2" vid="HEB 10:6">మీరు సంతోషించలేదు.<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />అప్పుడు నేను ఇలా అన్నాను, ‘ఇదిగో నేను ఉన్నాను;</para>
  <para style="q2" vid="HEB 10:7">గ్రంథపుచుట్టలో నా గురించి వ్రాయబడినట్లు</para>
  <para style="q2" vid="HEB 10:7">నా దేవా, మీ చిత్తం చేయడానికి నేను వచ్చాను.’ ”<note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="ft" closed="false"><char style="xt">కీర్తన 40:6-8</char></char></note><verse eid="HEB 10:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 10:8" />ఆయన మొదట ఇలా అన్నారు, “బలులు, అర్పణలు, దహనబలులు, పాపపరిహార బలులను కోరలేదు, అవి ధర్మశాస్త్ర ప్రకారమే అర్పించబడినప్పటికి వాటిని బట్టి మీరు సంతోషించలేదు.” <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />తర్వాత ఆయన, “నేను ఇక్కడే ఉన్నాను, మీ చిత్తం చేయడానికి నేను వచ్చాను” అని చెప్పాడు. ఆయన రెండవదానిని స్థాపించడానికి మొదటి దానిని ప్రక్కన పెడతాడు. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />ఆ చిత్తాన్ని బట్టి, యేసు క్రీస్తు శరీరాన్ని అందరి కోసం ఒక్కసారే అర్పించుట ద్వారా మనం పరిశుద్ధులుగా చేయబడ్డాము.<verse eid="HEB 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />ప్రతిదినం ప్రతి యాజకుడు నిలబడి మతపరమైన విధులు నిర్వర్తిస్తాడు; పాపాలను ఎన్నటికిని తీసివేయలేని అదే బలులను పదే పదే అర్పిస్తాడు. <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />అయితే ఈ యాజకుడు పాపాల కోసం అన్ని కాలాలకు ఒకే ఒక బలిని అర్పించి, దేవుని కుడి ప్రక్కన కూర్చున్నాడు, <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />ఆ సమయం నుండి తన శత్రువులు తన పాదపీఠంగా చేయబడేవరకు ఆయన అక్కడ వేచి ఉంటాడు. <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />పరిశుద్ధులుగా చేయబడిన వారిని, ఒకే ఒక బలి ద్వారా ఆయన శాశ్వతంగా పరిపూర్ణులను చేశాడు.<verse eid="HEB 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15" />పరిశుద్ధాత్మ కూడా దీనిని గురించి మనకు సాక్ష్యమిస్తున్నాడు. మొదట ఆయన ఇలా అన్నాడు:<verse eid="HEB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />“ఆ కాలం తర్వాత నేను వారితో చేసే</para>
  <para style="q2" vid="HEB 10:16">నిబంధన ఇదే అని ప్రభువు చెప్పారు.</para>
  <para style="q1" vid="HEB 10:16">వారి మనస్సులో నా న్యాయవిధులను ఉంచుతాను</para>
  <para style="q2" vid="HEB 10:16">వారి హృదయాల మీద వాటిని వ్రాస్తాను.”<note caller="+" style="f"><char style="fr" closed="false">10:16 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 31:33">యిర్మీయా 31:33</ref></char></char></note><verse eid="HEB 10:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="HEB 10:17" />ఆయన ఇంకా ఇలా అన్నారు:</para>
  <para style="q1" vid="HEB 10:17">“వారి పాపాలను, అధర్మ క్రియలను</para>
  <para style="q2" vid="HEB 10:17">నేను ఇక ఎన్నడు జ్ఞాపకం చేసుకోను.”<note caller="+" style="f"><char style="fr" closed="false">10:17 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 31:34">యిర్మీయా 31:34</ref></char></char></note><verse eid="HEB 10:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="HEB 10:18" />ఇవి క్షమింపబడినప్పడు, పాప పరిహారానికి ఇక బలి అవసరం ఉండదు.<verse eid="HEB 10:18" /></para>
  <para style="s1">విశ్వాసంలో పట్టుదలకు పిలుపు</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />కాబట్టి, సహోదరీ సహోదరులారా, యేసు తన శరీరమనే తెర ద్వారా మన కోసం తెరవబడిన సజీవమైన ఒక క్రొత్త మార్గం ద్వారా, <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />యేసు రక్తాన్ని బట్టి అతి పరిశుద్ధ స్థలంలోకి ప్రవేశిస్తామనే నమ్మకాన్ని మనం కలిగి ఉన్నాము. <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />దేవుని గృహంపైన ఒక గొప్ప యాజకుని మనం కలిగి ఉన్నాము. <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />విశ్వాస విషయంలో సంపూర్ణ నిశ్చయత కలిగిన యథార్థ హృదయంతో, అపరాధ మనస్సాక్షి నుండి శుద్ధి చేయబడిన హృదయంతో, స్వచ్ఛమైన నీటితో కడిగిన శరీరంతో దేవుని సమీపిద్దాము. <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />వాగ్దానం చేసినవాడు నమ్మదగినవాడు కాబట్టి, మనం గొప్పగా చెప్పుకొనే నిరీక్షణను గట్టిగా పట్టుకుందాము. <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />ప్రేమ మంచిపనుల పట్ల మనం ఒకరినొకరం ఎలా ప్రేరేపించవచ్చో ఆలోచిద్దాం, <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />కొందరు అలవాటుగా మానివేసినట్లుగా, మనం కలవడం మానివేయకుండా, ఆ దినం సమీపించడం మీరు చూసినప్పుడు ఇంకా ఎక్కువగా కలుసుకొంటూ, ఒకరినొకరు ప్రోత్సహించుకుందాము.<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />సత్యం మనకు తెలియజేయబడిన తర్వాత కూడా ఒకవేళ మనం పాపాలు చేస్తూనే ఉంటే, ఆ పాపాలను తొలగించగల బలి ఏది లేదు, <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />అయితే తీర్పు కోసం, దేవుని శత్రువులను దహించబోయే ప్రచండమైన అగ్ని కోసం మాత్రమే భయంతో ఎదురుచూడడం మిగిలి ఉంటుంది. <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />మోషే ధర్మశాస్త్రాన్ని తిరస్కరించినవారు ఎవరైనా సరే ఇద్దరు లేదా ముగ్గురు సాక్షుల సాక్ష్యాన్ని బట్టి దయ లేకుండా చంపివేయబడ్డారు. <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />అలాంటప్పుడు దేవుని కుమారుని తమ పాదాల క్రింద త్రొక్కినవారు, తమను పరిశుద్ధపరచే నిబంధన రక్తాన్ని అపవిత్రమైనదానిగా భావించినవారు, కృప గల ఆత్మను అవమానించినవారు ఎంత గొప్ప తీవ్రమైన శిక్షను పొందుతారో మీరు ఊహించగలరా? <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />“పగ తీర్చుకోవడం నా పని, నేను ప్రతిఫలాన్ని ఇస్తాను”<note caller="+" style="f"><char style="fr" closed="false">10:30 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 32:35">ద్వితీ 32:35</ref></char></char></note> అని, మరలా, “ప్రభువు, తన ప్రజలకు తీర్పు తీరుస్తాడు”<note caller="+" style="f"><char style="fr" closed="false">10:30 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 32:36">ద్వితీ 32:36</ref>; <ref loc="PSA 135:14">కీర్తన 135:14</ref></char></char></note> అని చెప్పిన వాడు మనకు తెలుసు. <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />సజీవుడైన దేవుని చేతుల్లో పడడం మహా భయంకరమైన విషయము.<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />మీరు వెలుగును పొందిన తర్వాత, అనేక శ్రమలతో నిండిన గొప్ప పోరాటాన్ని మీరు ఓర్చుకున్న ప్రారంభపు రోజులను జ్ఞాపకం చేసుకోండి. <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />కొన్నిసార్లు మీరు బహిరంగంగా అవమానపరచబడ్డారు, హింసించబడ్డారు; మరికొన్నిసార్లు మీరు అలాంటివి అనుభవించిన వారితో పాలివారయ్యారు. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />చెరసాలలో వేయబడిన వారితో పాటు మీరు శ్రమ అనుభవించారు, మీ ఆస్తులను దోచుకున్నా సంతోషంగా స్వీకరించారు, వాటికంటే శాశ్వతంగా నిలిచే మరింత మేలైన ఆస్తులను కలిగి ఉన్నారని మీకు తెలుసు కాబట్టి మీరు వాటిని భరించారు. <verse eid="HEB 10:34" /><verse number="35" style="v" sid="HEB 10:35" />కాబట్టి మీ ధైర్యాన్ని కోల్పోవద్దు; దానికి మీరు గొప్ప ఫలాన్ని పొందుతారు.<verse eid="HEB 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="HEB 10:36" />దేవుని చిత్తాన్ని చేసేప్పుడు మీరు పట్టుదలగా ఉండడం అవసరం, ఆయన వాగ్దానం చేసిన దాన్ని మీరు పొందుకుంటారు.<verse eid="HEB 10:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="HEB 10:37" />“ఎందుకంటే ఇంకాసేపట్లో,</para>
  <para style="q2" vid="HEB 10:37">రాబోయేవాడు వస్తాడు</para>
  <para style="q2" vid="HEB 10:37">ఆలస్యం చేయడు.”<note caller="+" style="f"><char style="fr" closed="false">10:37 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 26:20">యెషయా 26:20</ref>; <ref loc="HAB 2:3">హబ 2:3</ref></char></char></note><verse eid="HEB 10:37" /></para>
  <para style="m">
    <verse number="38" style="v" sid="HEB 10:38" />ఇంకా,</para>
  <para style="q1" vid="HEB 10:38">“నా నీతిమంతుడు<note caller="+" style="f"><char style="fr" closed="false">10:38 </char><char style="ft" closed="false">కొ.ప్ర.లలో </char><char style="fqa" closed="false">అయితే నీతిమంతుడు</char></note> విశ్వాసమూలంగా జీవిస్తాడు.</para>
  <para style="q2" vid="HEB 10:38">అయితే వెనుతిరిగే వానిని బట్టి</para>
  <para style="q2" vid="HEB 10:38">నా హృదయం ఏమాత్రం ఆనందించదు.”<note caller="+" style="f"><char style="fr" closed="false">10:38 </char><char style="ft" closed="false"><char style="xt"><ref loc="HAB 2:4">హబ 2:4</ref></char></char></note><verse eid="HEB 10:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="HEB 10:39" />అయితే మనం వెనుతిరిగి నశించేవారితో లేము, కానీ విశ్వాసం కలిగి, తమ ఆత్మలను కాపాడుకునేవారితో ఉన్నాము.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s1">క్రియలలో విశ్వాసం</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />విశ్వాసమనేది మనం ఎదురు చూసే వాటిని గురించిన నమ్మకం, మన కళ్లముందు లేనివాటిని గురించిన నిశ్చయత. <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />దీనిని బట్టి పూర్వికులు మెప్పుపొందారు.<verse eid="HEB 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3" />దేవుని ఆజ్ఞ చేత సృష్టి రూపించబడింది, కాబట్టి కనిపించే వాటినుండి కనిపిస్తున్నవి చేయబడలేదని విశ్వాసం ద్వారా మనం గ్రహిస్తున్నాము.<verse eid="HEB 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4" />విశ్వాసం ద్వారానే హేబెలు కయీను కంటే ఉత్తమమైన అర్పణను దేవునికి తెచ్చాడు. విశ్వాసం ద్వారానే అతడు నీతిమంతునిగా ప్రశంసించబడ్డాడు. దేవుడు అతని అర్పణను మెచ్చుకొన్నాడు. చనిపోయినప్పటికి విశ్వాసం ద్వారానే హేబెలు ఇంకా మాట్లాడుతున్నాడు.<verse eid="HEB 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5" />విశ్వాసం ద్వారానే హనోకు ఈ జీవితంలో మరణాన్ని పొందకుండానే కొనిపోబడ్డాడు; “దేవుడు అతన్ని తీసుకెళ్లారు కాబట్టి అతడు కనబడలేదు.”<note caller="+" style="f"><char style="fr" closed="false">11:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 5:24">ఆది 5:24</ref></char></char></note> అతడు కొనిపోబడక ముందు అతడు దేవుని సంతోషపెట్టినవానిగా ప్రశంసించబడ్డాడు. <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />విశ్వాసం లేకుండా దేవుని సంతోషపెట్టడం అసాధ్యం ఎందుకంటే, దేవుని దగ్గరకు వచ్చే ప్రతివాడు దేవుడు ఉన్నాడని, తన కోసం ఆసక్తితో వెదకేవారికి ఆయన ప్రతిఫలం ఇస్తాడని నమ్మాలి.<verse eid="HEB 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7" />విశ్వాసం ద్వారానే నోవహు అప్పటివరకు చూడనివాటి గురించి హెచ్చరించబడి పవిత్ర భయం కలిగినవాడై తన కుటుంబాన్ని రక్షించుకోవడానికి ఒక ఓడను నిర్మించాడు. తన విశ్వాసం వల్లనే అతడు లోకాన్ని ఖండిస్తూ విశ్వాసంతో కొనసాగుతూ నీతికి వారసుడయ్యాడు.<verse eid="HEB 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8" />విశ్వాసం ద్వారానే అబ్రాహాము, తాను స్వాస్థ్యంగా పొందబోతున్న ప్రదేశానికి వెళ్లమని పిలువబడినపుడు ఆ పిలుపుకు లోబడి తాను ఎక్కడికి వెళ్తున్నాడో అతనికి తెలియకపోయినా అతడు బయలుదేరి వెళ్లాడు. <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />విశ్వాసం ద్వారానే దేవుడు తనకు వాగ్దానం చేసిన దేశంలో పరదేశిలా గుడారంలో నివసించాడు, అతనితో పాటు అదే వాగ్దానానికి వారసులైన ఇస్సాకు యాకోబులు కూడా అలాగే చేశారు. <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />ఎందుకంటే అతడు ఎదురుచూస్తున్నది పునాదులుగల పట్టణం కోసం, దానికి దేవుడే శిల్పి నిర్మాణకుడు. <verse eid="HEB 11:10" /><verse number="11" style="v" sid="HEB 11:11" />వాగ్దానం చేసినవాడు నమ్మదగిన వాడని శారా నమ్మింది కాబట్టి శారాకు పిల్లలను కనే వయస్సు దాటిపోయినా, విశ్వాసం ద్వారానే ఆమె<note caller="+" style="f"><char style="fr" closed="false">11:11 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">అబ్రాహాము పిల్లలను కనలేనంత ముసలివాడు శారా కూడా తల్లికాలేని స్ధితిలో ఉన్నప్పటికీ విశ్వాసం వల్లనే అబ్రాహాము తండ్రి కాగలిగాడు</char></note> బిడ్డను కనగలిగింది. <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />చనిపోయినవానితో సమానమైన ఈ ఒక్క మనుష్యుని నుండే ఆకాశంలోని నక్షత్రాల సంఖ్యలా, సముద్రతీరంలోని ఇసుక రేణువుల్లా లెక్కకు మించిన సంతానం కలిగింది.<verse eid="HEB 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13" />వీరందరు చనిపోయినా, విశ్వాసం ద్వారానే ఇంకా జీవిస్తున్నారు. వాగ్దానం చేసిన వాటిని వారు పొందలేదు; వారు కేవలం దూరం నుండి చూసి వాటిని ఆహ్వానించి, ఈ భూమిపై తాము విదేశీయులమని అపరిచితులమని ఒప్పుకున్నారు. <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />అలాంటి విషయాలు చెప్పే ప్రజలు తమ స్వదేశం కోసం చూస్తున్నారని స్పష్టం చేస్తారు. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />వారు తాము వదిలి వచ్చిన దేశం గురించి ఆలోచిస్తూ ఉంటే, వారు తిరిగి వెళ్లడానికి అవకాశం కలిగి ఉండేవారు. <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />అయితే, వారు అంతకంటే ఉత్తమమైన దేశాన్ని అంటే పరలోకసంబంధమైన దేశం కోసం ఆరాటపడ్డారు. కాబట్టి వారి దేవున్ని వారి చేత పిలిపించుకోవడానికి దేవుడు సిగ్గుపడలేదు. ఎందుకంటే ఆయన వారికి ఒక పట్టణాన్ని సిద్ధపరిచాడు.<verse eid="HEB 11:16" /></para>
  <para style="p">
    <verse number="17-19" style="v" sid="HEB 11:17-19" />దేవుడు అబ్రాహామును పరీక్షించినపుడు, విశ్వాసం ద్వారానే అబ్రాహాము తన కుమారుడైన ఇస్సాకును బలిగా అర్పించాడు. “ఇస్సాకు మూలంగానే నీ సంతానం లెక్కించబడుతుంది”<note caller="+" style="f"><char style="fr" closed="false">11:17-19 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 21:12">ఆది 21:12</ref></char></char></note> అని దేవుడు అతనితో చెప్పినప్పటికి, వాగ్దానాలను పొందిన అబ్రాహాము తన ఏకైక కుమారుని బలిగా అర్పించడానికి సిద్ధపడ్డాడు. చనిపోయినవారిని సహితం లేపడానికి దేవుడు శక్తిమంతుడని అబ్రాహాము భావించాడు, దానిని ఉపమానరీతిలో చెప్పాలంటే అతడు తన కుమారుడైన ఇస్సాకును మరణం నుండి తిరిగి పొందుకున్నాడు.<verse eid="HEB 11:17-19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20" />విశ్వాసం ద్వారానే ఇస్సాకు తన సంతానమైన యాకోబు ఏశావులను వారి భవిష్యత్తు గురించి ఆశీర్వదించాడు.<verse eid="HEB 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21" />విశ్వాసం ద్వారానే యాకోబు తాను చనిపోయే సమయంలో యోసేపు కుమారులలో అందరిని ఆశీర్వదించి, తన చేతికర్ర మీద ఆనుకుని ఆరాధించాడు.<verse eid="HEB 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22" />విశ్వాసం ద్వారానే యోసేపు తాను చనిపోయే సమయంలో ఈజిప్టు నుండి ఇశ్రాయేలీయుల ప్రయాణం గురించి చెప్పి, తన ఎముకలను సమాధి చేయమని ఆదేశాలిచ్చాడు.<verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />విశ్వాసం ద్వారానే మోషే తల్లిదండ్రులు అతడు పుట్టిన తర్వాత మూడు నెలల వరకు దాచి ఉంచారు, ఎందుకంటే అతడు సాధారణమైన బాలుడు కాడని వారు గ్రహించారు, రాజాజ్ఞకు వారు భయపడలేదు.<verse eid="HEB 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24" />విశ్వాసం ద్వారానే మోషే, పెరిగి పెద్దవాడైన తర్వాత ఫరో కుమార్తె యొక్క కుమారుడనని అనిపించుకోడానికి నిరాకరించాడు. <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />అతడు అశాశ్వతమైన పాపభోగాలను అనుభవించేకంటే దేవుని ప్రజలతో పాటు శ్రమ పొందడాన్ని ఎంచుకున్నాడు. <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />క్రీస్తు కొరకైన అవమానాన్ని ఈజిప్టు ధనం కన్నా గొప్ప విలువైనదిగా భావించాడు, ఎందుకంటే అతడు తన బహుమానం కోసం ఎదురు చూస్తున్నాడు. <verse eid="HEB 11:26" /><verse number="27" style="v" sid="HEB 11:27" />విశ్వాసం ద్వారానే మోషే, రాజు కోపాన్ని లెక్కచేయక, ఈజిప్టును విడిచి వెళ్లాడు; అతడు కనిపించని దేవుని చూస్తూ పట్టువదలక సాగిపోయాడు. <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />అతడు విశ్వాసం ద్వారానే, పస్కాను ఆచరించి ఆ పస్కా బలి పశువు రక్తాన్ని పూయడం వలన జ్యేష్ఠ సంతానాన్ని సంహరించే మరణ దూత, ఇశ్రాయేలీయుల జ్యేష్ఠ సంతానాన్ని ముట్టకుండా చేశాడు.<verse eid="HEB 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29" />విశ్వాసం ద్వారానే ప్రజలు ఎర్ర సముద్రంలో ఆరిన నేలపై నడిచివెళ్లారు; అయితే ఈజిప్టువారు అలాగే నడిచి వారి వెనుక వెళ్లడానికి ప్రయత్నించి, మునిగిపోయారు.<verse eid="HEB 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30" />విశ్వాసం ద్వారానే ఇశ్రాయేలు సైన్యం యెరికో గోడల చుట్టూ ఏడు రోజులు తిరుగగా, యెరికో గోడలు కూలిపోయాయి.<verse eid="HEB 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="HEB 11:31" />విశ్వాసం ద్వారానే వేశ్యయైన రాహాబు, గూఢచారులను అతిథులుగా స్వీకరించింది కాబట్టి అవిధేయులతో<note caller="+" style="f"><char style="fr" closed="false">11:31 </char><char style="ft" closed="false">లేదా, </char><char style="fqa" closed="false">అవిశ్వాసులు</char></note> పాటు చంపబడకుండా రక్షించబడింది.<verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />ఇంకా నేనేం చెప్పాలి? గిద్యోను, బారాకు, సంసోను, యెఫ్తా, దావీదు, సమూయేలు అనేవారి గురించి, ప్రవక్తల గురించి వివరించడానికి నాకు సమయం లేదు. <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />వారు విశ్వాసం ద్వారానే రాజ్యాలను జయించారు, న్యాయాన్ని జరిగించారు, వాగ్దానఫలాన్ని పొందారు, సింహాల నోళ్లను మూయించారు, <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />తీవ్రమైన అగ్ని జ్వాలలను చల్లార్చారు, ఖడ్గపు అంచు నుండి తప్పించుకున్నారు; వారికి వారి బలహీనతే బలంగా మార్చబడింది; వారు యుద్ధాలలో మహాశక్తివంతులై శత్రు సైన్యాలను ఓడించారు. <verse eid="HEB 11:34" /><verse number="35" style="v" sid="HEB 11:35" />కొందరు స్త్రీలు చనిపోయిన తమ వారిని తిరిగి సజీవులుగా పొందారు. హింసించబడినవారు ఇంకా కొందరు దేవునితో శ్రేష్ఠమైన పునరుత్థానాన్ని పొందడానికి ఆ హింసను తప్పించుకోలేదు. <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />కొందరు ఎగతాళిచేయబడి కొరడా దెబ్బలు తిన్నారు, సంకెళ్ళతో బంధించబడ్డారు. <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />వారు చంపబడటానికి రాళ్లతో కొట్టబడ్డారు,<note caller="+" style="f"><char style="fr" closed="false">11:37 </char><char style="ft" closed="false">కొ.ప్రా.ప్ర.లలో </char><char style="fqa" closed="false">వారిని శోధించడానికి రాళ్లు వేశారు</char></note> రంపాలచేత భాగాలుగా కోయబడ్డారు, కత్తితో చంపబడ్డారు. గొర్రెల మేకల చర్మాలను కప్పుకుని, శ్రమలు హింసలు పొందుతూ దరిద్రుల్లా బాధలు అనుభవించారు. <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />ఈ లోకం వారికి యోగ్యమైనది కాదు. వారు ఎడారుల్లో, పర్వతాల్లో, గుహల్లో, సొరంగాల్లో తిరుగుతూ జీవించారు.<verse eid="HEB 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39" />వీరందరు వారి విశ్వాసం ద్వారానే ఎంతో మెప్పుపొందినా కాని దేవుడు చేసిన వాగ్దానాన్ని వారు పొందలేదు, <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />ఎందుకంటే, కేవలం మనతో మాత్రమే కలిపి వారిని పరిపూర్ణులుగా చేయడానికి దేవుడు మన కోసం మరింత ఉన్నతమైన ప్రణాళిక నిర్ణయించారు.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />కాబట్టి, ఇంత గొప్ప సాక్షిసమూహం మన చుట్టూ ఆవరించి ఉంది కాబట్టి, మనకు ఆటంకం కలిగించే సమస్తాన్ని, సుళువుగా చిక్కులు పెట్టే పాపాలను విడిచిపెడదాము. విశ్వాసానికి కర్తయైన దాన్ని పరిపూర్ణం చేసేవాడైన యేసువైపు చూస్తూ, <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />మన ముందు ఉన్న పరుగు పందెంలో ఓపికతో పరుగెడదాము. ఆయన తన ఎదుట ఉంచబడిన ఆనందం కోసం సిలువను భరించి దానివల్ల కలిగే అవమానాలను లక్ష్యపెట్టక, ఇప్పుడు దేవుని సింహాసనానికి కుడి వైపున కూర్చుని ఉన్నారు. <verse eid="HEB 12:2" /><verse number="3" style="v" sid="HEB 12:3" />పాపుల నుండి అలాంటి వ్యతిరేకతను భరించిన వ్యక్తిని గురించి ఆలోచించండి, తద్వారా మీరు అలసట చెందరు, మీ హృదయాలు క్రుంగిపోవు.<verse eid="HEB 12:3" /></para>
  <para style="s1">దేవుడు తన పిల్లలకు క్రమశిక్షణ ఇస్తారు</para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 12:4" />మీరు పాపంతో పోరాడటంలో మీ రక్తం చిందేంతగా ప్రతిఘటించలేదు. <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />తండ్రి తన కుమారునితో మాట్లాడినట్లుగా ఆయన మీతో ప్రోత్సాహకరంగా మాట్లాడిన మాటలను పూర్తిగా మరచిపోయారా? అవి ఇలా చెప్తున్నాయి,</para>
  <para style="q1" vid="HEB 12:5">“నా కుమారుడా, ప్రభువు క్రమశిక్షణను చులకనగా చూడకు,</para>
  <para style="q2" vid="HEB 12:5">ఆయన నిన్ను గద్దించినపుడు నీవు నిరాశ చెందకు,<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />ఎందుకంటే, ప్రభువు తాను ప్రేమించేవారిని క్రమశిక్షణలో ఉంచుతారు,</para>
  <para style="q2" vid="HEB 12:6">తన కుమారునిగా అంగీకరించిన ప్రతివారికి ఆయన శిక్షణనిస్తారు.”<note caller="+" style="f"><char style="fr" closed="false">12:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="PRO 3:11">సామెత 3:11</ref>,<ref loc="PRO 3:12">12</ref></char></char></note><verse eid="HEB 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7" />మీరు పొందే బాధలన్నిటిని క్రమశిక్షణగా సహించండి; ఎందుకంటే దేవుడు మిమ్మల్ని తన కుమారులుగా భావిస్తున్నాడు. తమ తండ్రిచేత క్రమశిక్షణ పొందని కుమారుడెవడు? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />అందరు క్రమశిక్షణ పొందినట్లు మీరు క్రమశిక్షణ పొందకపోతే చట్టబద్ధమైన సంతానం అవ్వరు మీరు నిజమైన కుమారులు కుమార్తెలు కారు. <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />మనల్ని క్రమశిక్షణలో పెంచిన మానవ తండ్రులను మనమందరం కలిగి ఉన్నాం, ఈ విషయంలో వారిని గౌరవిస్తాము. అలాగే ఆత్మలకు తండ్రియైన దేవునికి మనం ఇంకా ఎంత అధికంగా లోబడి జీవించాలి! <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />తాము మంచిదని తలంచిన విధంగా మన తండ్రులు కొంతకాలం మనల్ని క్రమశిక్షణలో పెంచారు కాని దేవుడు తన పరిశుద్ధతలో మనం పాలుపంచుకోవడానికి మన మేలు కొరకే ఆ క్రమశిక్షణలో ఉంచాడు. <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />ఆ సమయంలో ఏ క్రమశిక్షణా ఆనందంగా అనిపించదు కాని బాధగా అనిపిస్తుంది. కాని దాని ద్వారా శిక్షణ పొందినవారు నీతి సమాధానం అనే పంట కోస్తారు.<verse eid="HEB 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />కాబట్టి, దుర్బలమైన మీ చేతులను బలహీనమైన మీ మోకాళ్లను బలపరచండి. <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />కుంటివారు పడిపోకుండా వారు స్వస్థత పొందేలా, “మీ పాదాల కోసం సమమైన మార్గాలను తయారుచేయండి.”<note caller="+" style="f"><char style="fr" closed="false">12:13 </char><char style="ft" closed="false"><char style="xt"><ref loc="PRO 4:26">సామెత 4:26</ref></char></char></note><verse eid="HEB 12:13" /></para>
  <para style="s1">హెచ్చరిక ప్రోత్సాహం</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />అందరితో సమాధానం కలిగి జీవించడానికి, పరిశుద్ధులుగా ఉండడానికి ప్రతి ప్రయత్నం చేయండి; పరిశుద్ధత లేకుండ ఎవరు ప్రభువును చూడలేరు. <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />దేవుని కృపను పొందడంలో ఎవరు తప్పిపోకుండా, చేదైన వేరు మొలిచి మిమ్మల్ని కలవరపరచి అనేకమందిని అపవిత్రులుగా చేయకుండా జాగ్రత్తపడండి. <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />లైంగిక అనైతికతను సాగించేవారు గాని ఒక్కపూట తిండి కోసం జ్యేష్ఠత్వాన్ని అమ్ముకున్న ఏశావులాంటి దైవభక్తిలేని వారు గాని మీలో లేకుండ జాగ్రత్తపడండి. <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />ఆ తర్వాత ఏశావు ఆ ఆశీర్వాదాన్ని పొందాలని అనుకున్నప్పుడు అతడు పొందలేక పోయాడని మీకు తెలుసు. ఎందుకంటే అతడు పశ్చాత్తాపపడేప్పటికి చాలా ఆలస్యమైంది. అతడు కన్నీటితో వెదకినా, తాను చేసిన దాన్ని మార్చలేకపోయాడు.<verse eid="HEB 12:17" /></para>
  <para style="s1">భయం కలిగించే పర్వతం ఆనందం కలిగించే పర్వతం</para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />తాకగల పర్వతం దగ్గరకు మీరు రాలేదు అది అగ్నితో మండుతుంది; చీకటి, కారు మబ్బు, తుఫాను; <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />ఒక బూర శబ్దం లేదా అలాంటి గంభీరస్వరంతో మాట్లాడే చోటుకు మీరు రాలేదు. ఆ స్వరం యొక్క మాటలు విన్న వారు తమతో ఇంకొక్క మాట మాట్లాడకూడదని బ్రతిమాలుకొన్నారు, <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />“ఒకవేళ ఒక జంతువైనా ఆ పర్వతాన్ని తాకితే, రాళ్లతో కొట్టబడి చంపబడాలి”<note caller="+" style="f"><char style="fr" closed="false">12:20 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 19:12">నిర్గమ 19:12</ref>,<ref loc="EXO 19:13">13</ref></char></char></note> అని ఇవ్వబడిన ఆజ్ఞను వారు భరించలేకపోయారు. <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />ఆ దృశ్యం చాలా భయానకం కాబట్టి మోషే, “నేను భయంతో వణుకుతున్నాను”<note caller="+" style="f"><char style="fr" closed="false">12:21 <char style="xt"><ref loc="DEU 9:19">ద్వితీ 9:19</ref></char></char></note> అన్నాడు.<verse eid="HEB 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22" />అయితే మీరు సీయోను పర్వతానికి, సజీవ దేవుని పట్టణమైన పరలోకపు యెరూషలేముకు వచ్చారు. మీరు సంతోషకరమైన సభలో వేలాదిమంది దేవదూతల దగ్గరకు వచ్చారు. <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />పరలోకంలో పేర్లు వ్రాయబడి ఉన్న దేవుని జ్యేష్ఠ సంతానమనే సంఘానికి మీరు వచ్చారు. మనుష్యులందరికి న్యాయాధిపతియైన దేవుని దగ్గరకు, నిర్దోషులుగా తీర్చబడిన నీతిమంతుల్లా పరిపూర్ణత పొందిన ఆత్మల దగ్గరకు మీరు వచ్చారు. <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />క్రొత్త నిబంధనకు మధ్యవర్తియైన యేసు దగ్గరకు, హేబెలు రక్తంకంటే ఉత్తమంగా మాట్లాడే చిందించబడిన రక్తం దగ్గరకు మీరు వచ్చారు.<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />మాట్లాడుతున్నవానిని మీరు తిరస్కరించకుండా చూసుకోండి. భూమి మీద హెచ్చరించిన వానిని తిరస్కరించినవారు తప్పించుకోలేకపోతే, ఇక పరలోకం నుండి మనల్ని హెచ్చరించే వానిని మనం తిరస్కరిస్తే, మనమెలా తప్పించుకోగలం? <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />ఆ సమయంలో ఆయన స్వరానికి భూమి కంపించింది, కాని ఆయన ఇప్పుడు, “మరోసారి నేను భూమిని మాత్రమే కాక పరలోకాన్ని కూడ కంపింపజేస్తాను”<note caller="+" style="f"><char style="fr" closed="false">12:26 </char><char style="ft" closed="false"><char style="xt"><ref loc="HAG 2:6">హగ్గయి 2:6</ref></char></char></note> అని వాగ్దానం చేశాడు. <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />“ఇంకొకసారి” అనే మాట కదలనివి నిలిచి ఉండేలా కదిలింపబడేవి అంటే సృష్టింపబడినవి తీసివేయబడతాయి అని అర్థాన్నిస్తుంది.<verse eid="HEB 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28" />మనం నిశ్చలమైన రాజ్యాన్ని పొందుకొంటున్నాం కాబట్టి, కృతజ్ఞతగలవారమై, భయభక్తులతో ఆమోదయోగ్యమైన రీతిలో దేవుని ఆరాధిద్దాం, <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />ఎందుకంటే మన “దేవుడు దహించు అగ్ని.”<note caller="+" style="f"><char style="fr" closed="false">12:29 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 4:24">ద్వితీ 4:24</ref></char></char></note><verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s1">ముగింపు హెచ్చరికలు</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />సహోదరీ సహోదరులుగా, ఒకరిని ఒకరు ఎల్లప్పుడు ప్రేమిస్తూ ఉండండి. <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />క్రొత్తవారికి ఆతిథ్యం ఇవ్వడం మరువవద్దు, ఎందుకంటే క్రొత్తవారికి ఆతిథ్యం ఇస్తుండడం వలన కొందరు తమకు తెలియకుండానే దేవదూతలకు ఆతిథ్యమిచ్చారు. <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />చెరసాలలో ఉన్నవారిని మీరు కూడా వారితో పాటు చెరసాలలో ఉన్నట్లుగా, బాధలుపడుతున్న వారితో మీరు కూడా ఆ బాధల్లో వారితో ఉన్నట్లుగా వారిని జ్ఞాపకం చేసుకోండి.<verse eid="HEB 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4" />పెళ్ళి అందరిచేత గౌరవించబడాలి, పెళ్ళి పాన్పు శుద్ధమైనదిగా ఉండాలి, ఎందుకంటే దేవుడు వ్యభిచారులను లైంగిక అనైతికత గల వారందరిని తీర్పు తీరుస్తాడు. <verse eid="HEB 13:4" /><verse number="5" style="v" sid="HEB 13:5" />మీ జీవితాలను ధన వ్యామోహానికి దూరంగా ఉంచండి, మీ దగ్గర ఉన్నదానితో సంతృప్తి చెందండి, ఎందుకంటే దేవుడు ఇలా అన్నాడు,</para>
  <para style="q1" vid="HEB 13:5">“నేను నిన్ను ఎన్నడు విడిచిపెట్టను;</para>
  <para style="q2" vid="HEB 13:5">నిన్ను ఎన్నడు త్రోసివేయను.”<note caller="+" style="f"><char style="fr" closed="false">13:5 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 31:6">ద్వితీ 31:6</ref></char></char></note><verse eid="HEB 13:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 13:6" />కాబట్టి మనం ధైర్యంతో ఇలా చెబుదాం,</para>
  <para style="q1" vid="HEB 13:6">“ప్రభువే నాకు సహాయకుడు; నేను భయపడను.</para>
  <para style="q2" vid="HEB 13:6">నరమాత్రులు నన్నేమి చేయగలరు?”<note caller="+" style="f"><char style="fr" closed="false">13:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:6">కీర్తన 118:6</ref>,<ref loc="PSA 118:7">7</ref></char></char></note><verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />దేవుని వాక్యాన్ని మీకు బోధించిన మీ నాయకులను జ్ఞాపకం చేసుకోండి. వారి జీవిత విధానం వలన కలిగిన ఫలితాన్ని తెలుసుకోండి, వారి విశ్వాసాన్ని అనుకరించండి. <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />యేసు క్రీస్తు నిన్న, నేడు, నిరంతరం ఒకే విధంగా ఉన్నాడు.<verse eid="HEB 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 13:9" />అన్ని రకాల వింత బోధలచేత దూరంగా వెళ్లిపోకండి. ఆచార సంబంధమైన ఆహారం తినడం వల్ల కాదు, కాని కృప చేత మన హృదయాలు బలపరచబడటం మంచిది; ఆచారాలను పాటించే వారికి ఏ ప్రయోజనం కలుగదు. <verse eid="HEB 13:9" /><verse number="10" style="v" sid="HEB 13:10" />మనకు ఒక బలిపీఠం ఉంది, అయితే ప్రత్యక్షగుడారంలో పరిచర్య చేసేవారికి దాని నుండి తీసుకుని తినే అధికారం లేదు.<verse eid="HEB 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 13:11" />ప్రధాన యాజకుడు జంతువుల రక్తాన్ని పాపపరిహారబలిగా అతి పరిశుద్ధ స్థలం లోపలికి తీసుకెళ్తాడు, కాని వాటి శరీరాలు శిబిరం బయటే దహించబడతాయి. <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />కాబట్టి, యేసు కూడా తన రక్తం చేత ప్రజలను పాపాల నుండి శుద్ధి చేయడానికి పట్టణ ద్వారానికి బయటే బాధపడ్డాడు. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />కాబట్టి మనం కూడా శిబిరం బయట ఉన్న ఆయన దగ్గరకు వెళ్లి ఆయన భరించిన అవమానాన్ని మనం కూడా భరిద్దాము. <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />ఎందుకంటే మనకు ఇక్కడ శాశ్వతమైన పట్టణం లేదు, అయితే రాబోతున్న పట్టణం కోసం మనం ఎదురుచూస్తున్నాము.<verse eid="HEB 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 13:15" />కాబట్టి, యేసు ద్వారా, ఆయన పేరును బహిరంగంగా ఒప్పుకునే పెదవుల ఫలంతో మనం నిరంతరం దేవునికి స్తుతి బలిని అర్పిద్దాము. <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />ఉపకారం చేయడం, ఇతరులతో పంచుకోవడం అనే యాగాలను చేయడం మరువకండి, ఎందుకంటే అవి దేవునికి ఇష్టమైనవి.<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />మీ నాయకులపై నమ్మకం ఉంచండి, వారి అధికారానికి లోబడి ఉండండి, ఎందుకంటే వారు మీ ఆత్మలను గురించి లెక్క అప్పగించాల్సిన వారుగా మిమ్మల్ని జాగ్రత్తగా చూసుకుంటున్నారు. వారు తమ పనిని భారంగా భావించి చేస్తే, మీకు ఏ ప్రయోజనం ఉండదు, కాబట్టి వారు చేయవలసిన పనిని భారంగా కాకుండా ఆనందంగా చేసేలా చూడండి.<verse eid="HEB 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />మాకోసం ప్రార్థించండి. మేము అన్ని విధాలుగా గౌరవప్రదంగా జీవించాలనే ఆశ కలిగి స్వచ్ఛమైన మనస్సాక్షి కలిగి ఉన్నామని నమ్ముతున్నాము. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />త్వరలో నేను మిమ్మల్ని కలుసుకొనేలా నా కోసం ప్రార్థించమని మిమ్మల్ని ప్రత్యేకంగా బ్రతిమాలుతున్నాను.<verse eid="HEB 13:19" /></para>
  <para style="s1">ఆశీర్వచనం చివరి శుభాలు</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />నిత్య నిబంధన యొక్క రక్తం ద్వారా గొర్రెల గొప్ప కాపరియైన, ప్రభువైన యేసును మృతులలో నుండి తిరిగి వెనుకకు తెచ్చిన సమాధానకర్తయైన దేవుడు, <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />తన చిత్తాన్ని నెరవేర్చడానికి ప్రతి మంచిదానితో మిమ్మల్ని సిద్ధపరచును గాక, ఆయనకు ఇష్టమైనదాన్ని యేసు క్రీస్తు ద్వారా ఆయన మనలో జరిగించుగాక, ఆయనకే నిరంతరం మహిమ కలుగును గాక ఆమేన్.<verse eid="HEB 13:21" /></para>
  <para style="b" />
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />సహోదరీ సహోదరులారా! నా హెచ్చరిక మాటను భరించాలని నేను మిమ్మల్ని కోరుతున్నాను, వాస్తవానికి నేను మీకు చాలా క్లుప్తంగా వ్రాశాను.<verse eid="HEB 13:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="HEB 13:23" />మన సహోదరుడైన తిమోతి చెరసాల నుండి విడుదల అయ్యాడని మీరు తెలుసుకోవాలని కోరుతున్నాను. అతడు త్వరగా వస్తే, నేను మిమ్మల్ని చూడడానికి అతనితో కలిసి వస్తాను.<verse eid="HEB 13:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />మీ నాయకులందరికి, పరిశుద్ధులందరికి వందనాలు తెలియజేయండి.</para>
  <para style="p" vid="HEB 13:24">ఇటలీ దేశపు సహోదరులు మీకు వందనాలు తెలియజేస్తున్నారు.<verse eid="HEB 13:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />కృప మీ అందరితో ఉండును గాక.<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>