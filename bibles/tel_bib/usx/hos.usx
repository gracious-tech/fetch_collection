<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HOS" style="id">- Biblica® Open Telugu Contemporary Version</book>
  
  <para style="h">హోషేయ</para>
  <para style="toc1">హోషేయ ప్రవచనం</para>
  <para style="toc2">హోషేయ</para>
  <para style="toc3">హోషేయ</para>
  <para style="mt1">హోషేయ</para>
  <para style="mt2">ప్రవచనం</para>
  <chapter number="1" style="c" sid="HOS 1" />
  <para style="p">
    <verse number="1" style="v" sid="HOS 1:1" />ఉజ్జియా, యోతాము, ఆహాజు, హిజ్కియా అనే యూదా రాజుల పాలన కాలంలో, యెహోయాషు కుమారుడైన యరొబాము అనే ఇశ్రాయేలు రాజు కాలంలో, బెయేరి కుమారుడైన హోషేయకు యెహోవా వాక్కు వచ్చింది:<verse eid="HOS 1:1" /></para>
  <para style="b" />
  <para style="s1">హోషేయ భార్య, పిల్లలు</para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 1:2" />యెహోవా హోషేయ ద్వారా మాట్లాడడం ఆరంభించినప్పుడు, యెహోవా ఇలా అన్నారు, “వెళ్లు, ఒక వ్యభిచారిణిని పెళ్ళి చేసుకో, ఆమెతో పిల్లలు కను, ఎందుకంటే ఈ దేశం కూడా ఒక వ్యభిచారిణిలా యెహోవాకు నమ్మకద్రోహం చేస్తూ ఉంది.” <verse eid="HOS 1:2" /><verse number="3" style="v" sid="HOS 1:3" />కాబట్టి అతడు దిబ్లయీము కుమార్తెయైన గోమెరును పెళ్ళి చేసుకున్నాడు, ఆమె గర్భవతియై అతనికి కుమారున్ని కన్నది.<verse eid="HOS 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 1:4" />అప్పుడు యెహోవా హోషేయతో అన్నారు, “అతనికి యెజ్రెయేలు అనే పేరు పెట్టు, ఎందుకంటే యెజ్రెయేలులో జరిగిన రక్తపాతాన్ని బట్టి త్వరలో నేను యెహు వంశాన్ని శిక్షిస్తాను, ఇశ్రాయేలు రాజ్యాన్ని తుదముట్టిస్తాను. <verse eid="HOS 1:4" /><verse number="5" style="v" sid="HOS 1:5" />ఆ రోజు యెజ్రెయేలు లోయలో నేను ఇశ్రాయేలు విల్లు విరగ్గొడతాను.”<verse eid="HOS 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HOS 1:6" />గోమెరు మళ్ళీ గర్భవతియై ఆడపిల్లను కన్నది. అప్పుడు యెహోవా హోషేయతో ఇలా అన్నారు, “ఆమెకు లో-రుహామా<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="fq" closed="false">లో-రుహామా </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">ప్రేమించబడకపోవడం</char></note> అని పేరు పెట్టు, ఎందుకంటే నేను ఇక ఇశ్రాయేలును ప్రేమించను వారిని ఏమాత్రం క్షమించను. <verse eid="HOS 1:6" /><verse number="7" style="v" sid="HOS 1:7" />అయితే యూదా వారికి నా ప్రేమను చూపించి వారిని రక్షిస్తాను; విల్లు, ఖడ్గం, యుద్ధం, గుర్రాలు, రౌతుల వల్ల కాదు, కాని వారి దేవుడనైన యెహోవా అనే నేనే వారిని రక్షిస్తాను.”<verse eid="HOS 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HOS 1:8" />ఆమె లో-రుహామాను పాలు మాన్పించిన తర్వాత, గోమెరుకు మరో కుమారుడు పుట్టాడు. <verse eid="HOS 1:8" /><verse number="9" style="v" sid="HOS 1:9" />అప్పుడు యెహోవా ఇలా అన్నారు, “అతనికి లో-అమ్మీ<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="fq" closed="false">లో-అమ్మీ </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">నా ప్రజలు కాదు</char></note> అని పేరు పెట్టు, ఎందుకంటే మీరు నా జనం కాదు, నేను మీ దేవుడను కాదు.<verse eid="HOS 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HOS 1:10" />“అయినా ఇశ్రాయేలీయులు సముద్రతీరాన ఉన్న ఇసుకంత విస్తారంగా కొలువలేనంతగా లెక్కపెట్టలేనంతగా ఉంటారు. ‘మీరు నా ప్రజలు కారు’ అని ఏ స్థలంలో అయితే వారితో చెప్పబడిందో, అక్కడే వారు ‘సజీవుడైన దేవుని పిల్లలు’ అని పిలువబడతారు. <verse eid="HOS 1:10" /><verse number="11" style="v" sid="HOS 1:11" />యూదా ప్రజలు, ఇశ్రాయేలు ప్రజలు ఏకమవుతారు; వారు ఒక నాయకున్ని నియమించుకుంటారు, వారు ఈ దేశంలో ఎదుగుతారు, ఎందుకంటే యెజ్రెయేలు దినం గొప్పగా ఉండబోతుంది.<verse eid="HOS 1:11" /></para>
  <chapter eid="HOS 1" />
  <chapter number="2" style="c" sid="HOS 2" />
  <para style="p">
    <verse number="1" style="v" sid="HOS 2:1" />“మీరు మీ సోదరులతో, ‘మీరు నా ప్రజలు’ అని, మీ సహోదరీలతో, ‘నా ప్రియమైన వారలారా’ అని అనండి.<verse eid="HOS 2:1" /></para>
  <para style="s1">ఇశ్రాయేలు శిక్షంచబడుట, పునరుద్ధరించబడుట</para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 2:2" />“మీ తల్లిని గద్దించండి, గద్దించండి,</para>
  <para style="q2" vid="HOS 2:2">ఆమె నా భార్య కాదు,</para>
  <para style="q2" vid="HOS 2:2">నేను ఆమె భర్తను కాను.</para>
  <para style="q1" vid="HOS 2:2">ఆమె తన వ్యభిచార చూపును మానుకోవాలి,</para>
  <para style="q2" vid="HOS 2:2">తన రొమ్ముల మధ్య నుండి పరపురుషులను తొలగించాలి.<verse eid="HOS 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 2:3" />లేకపోతే ఆమెను దిగంబరిని చేస్తాను,</para>
  <para style="q2" vid="HOS 2:3">ఆమె బట్టలు తీసివేసి ఆమె పుట్టిన రోజున ఉన్నట్లు ఆమెను నగ్నంగా చేస్తాను.</para>
  <para style="q1" vid="HOS 2:3">ఆమెను ఎడారిలా చేస్తాను,</para>
  <para style="q2" vid="HOS 2:3">ఎండిపోయిన భూమిలా చేస్తాను</para>
  <para style="q2" vid="HOS 2:3">దప్పికతో ఆమె చచ్చునట్లు చేస్తాను.<verse eid="HOS 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 2:4" />ఆమె పిల్లల మీద నా ప్రేమను చూపించను,</para>
  <para style="q2" vid="HOS 2:4">ఎందుకంటే, వారు వ్యభిచారం వలన పుట్టిన పిల్లలు.<verse eid="HOS 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 2:5" />వారి తల్లి వ్యభిచారం చేసింది,</para>
  <para style="q2" vid="HOS 2:5">అవమానంలో వారిని కన్నది.</para>
  <para style="q1" vid="HOS 2:5">ఆమె, ‘నేను నా ప్రేమికుల వెంట వెళ్తాను,</para>
  <para style="q2" vid="HOS 2:5">వారు నాకు నా ఆహారం, నీళ్లు,</para>
  <para style="q2" vid="HOS 2:5">ఉన్ని, జనపనార, ఒలీవనూనె, పానీయం ఇస్తారు’ అన్నది.<verse eid="HOS 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 2:6" />కాబట్టి ముళ్ళపొదలను ఆమె దారిని అడ్డుగా వేస్తాను;</para>
  <para style="q2" vid="HOS 2:6">ఆమె తన దారి కనబడకుండ నేను గోడ కడతాను.<verse eid="HOS 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 2:7" />ఆమె తన ప్రేమికుల వెంటపడుతుంది కాని వారిని కలుసుకోలేదు;</para>
  <para style="q2" vid="HOS 2:7">ఆమె వారిని వెదుకుతుంది కాని వారు కనబడరు.</para>
  <para style="q1" vid="HOS 2:7">అప్పుడు ఆమె ఇలా అంటుంది,</para>
  <para style="q2" vid="HOS 2:7">‘నేను నా మొదటి భర్త దగ్గరకు తిరిగి వెళ్తాను,</para>
  <para style="q2" vid="HOS 2:7">ఇప్పటి కంటే అప్పుడే నా స్థితి బాగుండేది.’<verse eid="HOS 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 2:8" />ఆమెకు ధాన్యం, నూతన ద్రాక్షరసం, నూనె,</para>
  <para style="q2" vid="HOS 2:8">విస్తారమైన వెండి, బంగారాలు,</para>
  <para style="q1" vid="HOS 2:8">ఇచ్చింది నేనే అని ఆమె గుర్తించలేదు,</para>
  <para style="q2" vid="HOS 2:8">వాటిని బయలు కోసం వాడింది.<verse eid="HOS 2:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="HOS 2:9" />“కాబట్టి కోతకాలంలో నా ధాన్యం నేను తీసివేస్తాను,</para>
  <para style="q2" vid="HOS 2:9">ద్రాక్షరసం సిద్ధంగా ఉన్నప్పుడు దానిని తీసివేస్తాను.</para>
  <para style="q1" vid="HOS 2:9">ఆమె దిగంబరత్వాన్ని కప్పుకోడానికి నేను ఇచ్చిన</para>
  <para style="q2" vid="HOS 2:9">నా ఉన్నిని, నా జనపనారను తిరిగి తీసుకుంటాను.<verse eid="HOS 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 2:10" />కాబట్టి ఇప్పుడు ఆమె ప్రేమికుల కళ్లెదుట,</para>
  <para style="q2" vid="HOS 2:10">ఆమె కామాతురతను బయటపెడతాను,</para>
  <para style="q2" vid="HOS 2:10">ఆమెను నా చేతిలో నుండి ఎవ్వరూ విడిపించలేరు.<verse eid="HOS 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 2:11" />ఆమె ఉత్సవ వేడుకలన్నిటిని:</para>
  <para style="q2" vid="HOS 2:11">ఆమె వార్షిక పండుగలు, అమావాస్యలు,</para>
  <para style="q2" vid="HOS 2:11">ఆమె సబ్బాతు దినాలు అన్ని ఆగిపోయేలా చేస్తాను.<verse eid="HOS 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 2:12" />తన ప్రేమికులు తనకు ఇచ్చిన జీతం అని ఆమె చెప్పుకునే,</para>
  <para style="q2" vid="HOS 2:12">ఆమె ద్రాక్షలను అంజూర చెట్లను నేను పాడుచేస్తాను;</para>
  <para style="q1" vid="HOS 2:12">వాటిని దట్టమైన అడవిగా మారుస్తాను,</para>
  <para style="q2" vid="HOS 2:12">అడవి జంతువులు వాటిని తినివేస్తాయి.<verse eid="HOS 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 2:13" />ఆమె బయలులకు ధూపం వేసిన రోజుల గురించి,</para>
  <para style="q2" vid="HOS 2:13">నేను ఆమెను శిక్షిస్తాను;</para>
  <para style="q2" vid="HOS 2:13">ఆమె నగలు ఆభరణాలతో అలంకరించుకుని,</para>
  <para style="q1" vid="HOS 2:13">తన ప్రేమికుల వెంట వెళ్లిపోయింది,</para>
  <para style="q2" vid="HOS 2:13">కాని నన్ను మరచిపోయింది”</para>
  <para style="q2" vid="HOS 2:13">అని యెహోవా చెప్తున్నారు.<verse eid="HOS 2:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="HOS 2:14" />కాబట్టి ఆమెను ఆకర్షించబోతున్నాను;</para>
  <para style="q2" vid="HOS 2:14">నేను ఆమెను అరణ్యంలోకి నడిపించి,</para>
  <para style="q2" vid="HOS 2:14">ఆమెతో మృదువుగా మాట్లాడతాను.<verse eid="HOS 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 2:15" />అక్కడ ఆమె ద్రాక్షతోటలను ఆమెకు తిరిగి ఇస్తాను,</para>
  <para style="q2" vid="HOS 2:15">ఆకోరు<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="fq" closed="false">ఆకోరు </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">శ్రమ</char></note> లోయను నిరీక్షణ ద్వారంగా చేస్తాను.</para>
  <para style="q1" vid="HOS 2:15">అక్కడ ఆమె తన యవ్వన రోజుల్లో ఉన్నట్లు,</para>
  <para style="q2" vid="HOS 2:15">ఈజిప్టు నుండి బయటకు వచ్చిన రోజున ఉన్నట్లు స్పందిస్తుంది.<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">పాడుతుంది</char></note><verse eid="HOS 2:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="HOS 2:16" />యెహోవా ఇలా అంటున్నారు,</para>
  <para style="q2" vid="HOS 2:16">“ఆ రోజున నీవు నన్ను, ‘నా భర్తవు’ అని అంటావు;</para>
  <para style="q2" vid="HOS 2:16">నీవు నన్ను ఇక ఎన్నడు ‘నా బయలు<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">హెబ్రీలో </char><char style="fqa" closed="false">నా యజమాని</char></note>’ అని పిలువవు.<verse eid="HOS 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 2:17" />నేను ఆమె పెదవుల నుండి బయలుల పేర్లు తీసివేస్తాను;</para>
  <para style="q2" vid="HOS 2:17">ఇక ఎన్నడు వారి పేర్లు ప్రస్తావించబడవు.<verse eid="HOS 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 2:18" />ఆ రోజున నా ప్రజల కోసం అడవి జంతువులతో,</para>
  <para style="q2" vid="HOS 2:18">ఆకాశ పక్షులతో,</para>
  <para style="q2" vid="HOS 2:18">నేలను ప్రాకే జంతువులతో నిబంధన చేస్తాను.</para>
  <para style="q1" vid="HOS 2:18">విల్లు, ఖడ్గం, యుద్ధం</para>
  <para style="q2" vid="HOS 2:18">దేశంలో లేకుండా చేస్తాను,</para>
  <para style="q2" vid="HOS 2:18">అప్పుడు వారు క్షేమంగా పడుకుంటారు.<verse eid="HOS 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 2:19" />నీవు శాశ్వతంగా నాతో ఉండేలా,</para>
  <para style="q2" vid="HOS 2:19">నేను నిన్ను నీతి, న్యాయంతో,</para>
  <para style="q2" vid="HOS 2:19">మారని ప్రేమతో, దయతో ప్రధానం చేసుకుంటాను.<verse eid="HOS 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="HOS 2:20" />నీవు యెహోవాను తెలుసుకునేలా,</para>
  <para style="q2" vid="HOS 2:20">నేను నమ్మకాన్ని బట్టి నిన్ను ప్రధానం చేసుకుంటాను.<verse eid="HOS 2:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="HOS 2:21" />“ఆ రోజున నేను జవాబిస్తాను,”</para>
  <para style="q2" vid="HOS 2:21">అని యెహోవా అంటున్నారు.</para>
  <para style="q1" vid="HOS 2:21">“నేను ఆకాశాలకు జవాబిస్తాను,</para>
  <para style="q2" vid="HOS 2:21">అవి భూమికి జవాబిస్తాయి;<verse eid="HOS 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="HOS 2:22" />భూమి ధాన్యంతో, నూతన ద్రాక్షరసంతో,</para>
  <para style="q2" vid="HOS 2:22">ఒలీవనూనెతో మాట్లాడుతుంది.</para>
  <para style="q2" vid="HOS 2:22">అవి యెజ్రెయేలుతో<note caller="+" style="f"><char style="fr" closed="false">2:22 </char><char style="fq" closed="false">యెజ్రెయేలు </char><char style="ft" closed="false">అంటే, దేవుని మొక్కలు</char></note> మాట్లాడతాయి.<verse eid="HOS 2:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="HOS 2:23" />నేను ఆమెను నా కోసం దేశంలో నాటుతాను;</para>
  <para style="q2" vid="HOS 2:23">‘నా ప్రియురాలు కాదు,<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false">హెబ్రీలో </char><char style="fqa" closed="false">లో-రుహామా</char><char style="ft" closed="false">; <char style="xt"><ref loc="HOS 1:6">1:6</ref></char> వచనం చూడండి</char></note>’ అని ఎవరి గురించి అన్నానో ఆ వ్యక్తికే నా ప్రేమను చూపిస్తాను.</para>
  <para style="q1" vid="HOS 2:23">‘నా ప్రజలు కారు,<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false">హెబ్రీలో </char><char style="fqa" closed="false">లో-అమ్మీ</char><char style="ft" closed="false">; <char style="xt"><ref loc="HOS 1:9">1:9</ref></char> వచనం చూడండి</char></note>’ అని ఎవరి గురించి అన్నానో వారితో, ‘మీరు నా ప్రజలు’ అని చెప్తాను;</para>
  <para style="q2" vid="HOS 2:23">అప్పుడు వారు, ‘మీరే మా దేవుడు’ అంటారు.”<verse eid="HOS 2:23" /></para>
  <chapter eid="HOS 2" />
  <chapter number="3" style="c" sid="HOS 3" />
  <para style="s1">హోషేయ తన భార్యతో సమాధానపడుట</para>
  <para style="p">
    <verse number="1" style="v" sid="HOS 3:1" />యెహోవా నాతో, “వెళ్లు, నీ భార్యను వేరే వ్యక్తి ప్రేమించినా, వ్యభిచారిగా ఉన్నా ఆమెకు నీ ప్రేమను చూపించు. ఇశ్రాయేలీయులు ఇతర దేవుళ్ళను పూజించి పవిత్ర ద్రాక్షపండ్ల ముద్దలను ఆశించనప్పటికి, యెహోవా వారిని ప్రేమించినట్లు ఆమెను ప్రేమించు” అని చెప్పారు.<verse eid="HOS 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="HOS 3:2" />కాబట్టి నేను పదిహేను వెండి నాణేలు,<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">అంటే, 170 గ్రాములు</char></note> ఒక హోమెరు, ఒక లెతెకు<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">ఒక హోమెరు, ఒక లెతెకు అంటే సుమారు 195 కి. గ్రా. లు</char></note> యవలు ఇచ్చి ఆమెను కొనుక్కున్నాను. <verse eid="HOS 3:2" /><verse number="3" style="v" sid="HOS 3:3" />అప్పుడు ఆమెతో, “నీవు నాతో చాలా కాలం జీవించాలి; నీవు వేశ్యగా ఉండకూడదు, వేరే ఏ పురుషునితో సన్నిహితంగా ఉండకూడదు, అలాగే నేను నీ పట్ల నమ్మకంగా ఉంటాను” అన్నాను.<verse eid="HOS 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HOS 3:4" />ఎందుకంటే ఇశ్రాయేలీయులు చాలా కాలం రాజు గాని పాలకుడు గాని లేకుండా, బలులు గాని పవిత్ర రాళ్లు గాని లేకుండా, ఏఫోదు గాని గృహ దేవుళ్ళు గాని లేకుండా ఉంటారు. <verse eid="HOS 3:4" /><verse number="5" style="v" sid="HOS 3:5" />తర్వాత ఇశ్రాయేలీయులు తిరిగివచ్చి, తమ దేవుడైన యెహోవాను, తమ రాజైన దావీదును వెదుకుతారు. చివరి రోజుల్లో యెహోవా దగ్గరకు, ఆయన దీవెనలు దగ్గరకు వారు వణకుతూ వస్తారు.<verse eid="HOS 3:5" /></para>
  <chapter eid="HOS 3" />
  <chapter number="4" style="c" sid="HOS 4" />
  <para style="s1">ఇశ్రాయేలుపై అభియోగం</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 4:1" />ఇశ్రాయేలీయులారా, యెహోవా వాక్కు వినండి,</para>
  <para style="q2" vid="HOS 4:1">యెహోవా ఈ దేశ వాసులైన మీమీద</para>
  <para style="q2" vid="HOS 4:1">నేరం మోపుతున్నారు:</para>
  <para style="q1" vid="HOS 4:1">“ఈ దేశంలో నమ్మకత్వం, ప్రేమ</para>
  <para style="q2" vid="HOS 4:1">దేవుని గురించిన జ్ఞానం అనేవి లేవు.<verse eid="HOS 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 4:2" />శపించడం,<note caller="+" style="f"><char style="fr" closed="false">4:2 </char><char style="ft" closed="false">అంటే, శాపం పలకడం</char></note> అబద్ధాలు చెప్పడం, హత్య చేయడం,</para>
  <para style="q2" vid="HOS 4:2">దొంగిలించడం, వ్యభిచారం చేయడం మాత్రమే ఉన్నాయి;</para>
  <para style="q1" vid="HOS 4:2">వారు దౌర్జన్యాలు మానలేదు,</para>
  <para style="q2" vid="HOS 4:2">నిత్యం రక్తపాతం జరుగుతూ ఉంది.<verse eid="HOS 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 4:3" />ఈ కారణంచేత దేశం ఎండిపోతుంది,</para>
  <para style="q2" vid="HOS 4:3">అందులో నివసించేవారు నీరసించి పోతున్నారు;</para>
  <para style="q1" vid="HOS 4:3">అడవి జంతువులు, ఆకాశపక్షులు,</para>
  <para style="q2" vid="HOS 4:3">సముద్రపు చేపలు నశించిపోతున్నాయి.<verse eid="HOS 4:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HOS 4:4" />“అయితే ఏ ఒకరిపై నేరం మోపకండి,</para>
  <para style="q2" vid="HOS 4:4">ఏ ఒక్కరు ఇంకొకరిని నిందించకండి,</para>
  <para style="q1" vid="HOS 4:4">ఎందుకంటే మీ ప్రజలు</para>
  <para style="q2" vid="HOS 4:4">యాజకుని మీద నేరం మోపుతారు.<verse eid="HOS 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 4:5" />మీరు పగలు రాత్రులు తడబడతారు,</para>
  <para style="q2" vid="HOS 4:5">ప్రవక్తలు మీతో కలిసి తడబడతారు,</para>
  <para style="q1" vid="HOS 4:5">కాబట్టి నేను నీ తల్లిని నాశనం చేస్తాను.<verse eid="HOS 4:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 4:6" />జ్ఞానం లేక నా ప్రజలు నశిస్తున్నారు.</para>
  <para style="b" vid="HOS 4:6" />
  <para style="q1" vid="HOS 4:6">“మీరు జ్ఞానాన్ని త్రోసివేశారు కాబట్టి,</para>
  <para style="q2" vid="HOS 4:6">నేను కూడా మిమ్మల్ని నా యాజకులుగా ఉండకుండా త్రోసివేస్తున్నాను;</para>
  <para style="q1" vid="HOS 4:6">మీరు మీ దేవుని ఉపదేశాన్ని పట్టించుకోలేదు కాబట్టి,</para>
  <para style="q2" vid="HOS 4:6">నేను కూడా మీ పిల్లలను పట్టించుకోను.<verse eid="HOS 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 4:7" />యాజకుల సంఖ్య పెరిగిన కొద్దీ,</para>
  <para style="q2" vid="HOS 4:7">వారు నాకు వ్యతిరేకంగా పాపం చేస్తున్నారు;</para>
  <para style="q2" vid="HOS 4:7">వారి ఘనతను అవమానంగా మారుస్తాను.<verse eid="HOS 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 4:8" />నా ప్రజల పాపాన్ని ఆహారంగా చేసుకుంటారు</para>
  <para style="q2" vid="HOS 4:8">వారి దుష్టత్వం ఎక్కువ కావాలని కోరుకుంటారు.<verse eid="HOS 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 4:9" />కాబట్టి ప్రజలు జరిగినట్లే యాజకులకు జరుగుతుంది.</para>
  <para style="q2" vid="HOS 4:9">వారి విధానాలను బట్టి వారిద్దరిని నేను శిక్షిస్తాను</para>
  <para style="q2" vid="HOS 4:9">వారి క్రియలకు తగిన ప్రతిఫలం వారికిస్తాను.<verse eid="HOS 4:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="HOS 4:10" />“వారు తింటారు, కాని తృప్తి పొందరు;</para>
  <para style="q2" vid="HOS 4:10">వారు వ్యభిచారం చేస్తారు, కాని అభివృద్ధి చెందరు,</para>
  <para style="q1" vid="HOS 4:10">ఎందుకంటే వారు యెహోవాను వదిలేశారు,</para>
  <para style="q2" vid="HOS 4:10">తమను తాము <verse eid="HOS 4:10" /><verse number="11" style="v" sid="HOS 4:11" />వ్యభిచారానికి అప్పగించుకున్నారు;</para>
  <para style="q1" vid="HOS 4:11">పాత ద్రాక్షరసం, క్రొత్త ద్రాక్షరసం</para>
  <para style="q2" vid="HOS 4:11">వారి మతిని పోగొట్టాయి.<verse eid="HOS 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 4:12" />నా ప్రజలు చెక్క విగ్రహాన్ని సంప్రదిస్తారు,</para>
  <para style="q2" vid="HOS 4:12">సోదె చెప్పే వాని కర్ర వారితో మాట్లాడుతుంది.</para>
  <para style="q1" vid="HOS 4:12">వ్యభిచార ఆత్మ వారిని చెదరగొడుతుంది;</para>
  <para style="q2" vid="HOS 4:12">వారు తమ దేవుని పట్ల నమ్మకద్రోహులుగా ఉన్నారు.<verse eid="HOS 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 4:13" />వారు పర్వత శిఖరాల మీద బలులు అర్పిస్తారు</para>
  <para style="q2" vid="HOS 4:13">కొండలమీద ధూపం వేస్తారు,</para>
  <para style="q1" vid="HOS 4:13">సింధూర, చినారు, మస్తకి వృక్షాల క్రింద</para>
  <para style="q2" vid="HOS 4:13">నీడ మంచిగా ఉన్నచోట బలులు అర్పిస్తారు.</para>
  <para style="q1" vid="HOS 4:13">కాబట్టి మీ కుమార్తెలు వేశ్యలయ్యారు</para>
  <para style="q2" vid="HOS 4:13">మీ కోడళ్ళు వ్యభిచారిణులయ్యారు.<verse eid="HOS 4:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="HOS 4:14" />“మీ కుమార్తెలు వేశ్యలు అయినందుకు,</para>
  <para style="q2" vid="HOS 4:14">నేను వారిని శిక్షించను,</para>
  <para style="q1" vid="HOS 4:14">మీ కోడళ్ళు వ్యభిచారం చేసినందుకు,</para>
  <para style="q2" vid="HOS 4:14">నేను వారిని శిక్షించను</para>
  <para style="q1" vid="HOS 4:14">ఎందుకంటే, మనుష్యులు వ్యభిచారిణులుతో పోతారు,</para>
  <para style="q2" vid="HOS 4:14">క్షేత్ర వ్యభిచారులతో పాటు బలులు అర్పిస్తారు,</para>
  <para style="q2" vid="HOS 4:14">గ్రహింపు లేని ప్రజలు నాశనమవుతారు.<verse eid="HOS 4:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="HOS 4:15" />“ఇశ్రాయేలూ, నీవు వ్యభిచారం చేసినా సరే,</para>
  <para style="q2" vid="HOS 4:15">యూదా అపరాధం చేయకూడదు.</para>
  <para style="b" vid="HOS 4:15" />
  <para style="q1" vid="HOS 4:15">“గిల్గాలుకు వెళ్లవద్దు;</para>
  <para style="q2" vid="HOS 4:15">బేత్-ఆవెనుకు<note caller="+" style="f"><char style="fr" closed="false">4:15 </char><char style="fq" closed="false">బేత్-ఆవెను </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">దుష్టత్వం గల ఇల్లు</char></note> వెళ్లవద్దు.</para>
  <para style="q2" vid="HOS 4:15">‘యెహోవా జీవం తోడు’ అని ఒట్టు పెట్టుకోవద్దు.<verse eid="HOS 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 4:16" />పొగరుబోతు పెయ్యలా</para>
  <para style="q2" vid="HOS 4:16">ఇశ్రాయేలీయులు మొండిగా ఉన్నారు.</para>
  <para style="q1" vid="HOS 4:16">అలాగైతే యెహోవా వారిని విశాల మైదానంలో</para>
  <para style="q2" vid="HOS 4:16">గొర్రెపిల్లలను మేపినట్టు ఎలా పోషిస్తారు?<verse eid="HOS 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="HOS 4:17" />ఎఫ్రాయిం విగ్రహాలతో కలుసుకున్నాడు;</para>
  <para style="q2" vid="HOS 4:17">అతన్ని అలాగే వదిలేయండి!<verse eid="HOS 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="HOS 4:18" />వారి పానీయాలు అయిపోయినా,</para>
  <para style="q2" vid="HOS 4:18">వారి వ్యభిచారం కొనసాగిస్తున్నారు;</para>
  <para style="q2" vid="HOS 4:18">వారి పాలకులు సిగ్గుమాలిన విధానాలను ఎంతో ఇష్టపడతారు.<verse eid="HOS 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="HOS 4:19" />సుడిగాలి వారిని చెదరగొడుతుంది,</para>
  <para style="q2" vid="HOS 4:19">వారి బలుల వలన వారికి అవమానం కలుగుతుంది.<verse eid="HOS 4:19" /></para>
  <chapter eid="HOS 4" />
  <chapter number="5" style="c" sid="HOS 5" />
  <para style="s1">ఇశ్రాయేలుపై తీర్పు</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 5:1" />“యాజకులారా! ఇది వినండి,</para>
  <para style="q2" vid="HOS 5:1">ఇశ్రాయేలీయులారా! శ్రద్ధగా వినండి,</para>
  <para style="q1" vid="HOS 5:1">రాజ వంశస్థులారా! వినండి,</para>
  <para style="q2" vid="HOS 5:1">ఈ తీర్పు మీ కొరకే ఇవ్వబడింది:</para>
  <para style="q1" vid="HOS 5:1">మీరు మిస్పాలో ఉరిగా,</para>
  <para style="q2" vid="HOS 5:1">తాబోరు మీద వలలా ఉన్నారు.<verse eid="HOS 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 5:2" />తిరుగుబాటుదారులు ఘోరమైన హత్యలు చేశారు.</para>
  <para style="q2" vid="HOS 5:2">వారందరిని నేను శిక్షిస్తాను.<verse eid="HOS 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 5:3" />ఎఫ్రాయిం గురించి నాకు అంతా తెలుసు;</para>
  <para style="q2" vid="HOS 5:3">ఇశ్రాయేలు నా నుండి దాచబడలేదు.</para>
  <para style="q1" vid="HOS 5:3">ఎఫ్రాయిమూ! ఇప్పుడు నీవు వ్యభిచారం వైపు తిరిగావు;</para>
  <para style="q2" vid="HOS 5:3">ఇశ్రాయేలు అపవిత్రపరచబడింది.<verse eid="HOS 5:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HOS 5:4" />“వారి పనుల వలన</para>
  <para style="q2" vid="HOS 5:4">వారు తమ దేవుని దగ్గరకు తిరిగి రారు.</para>
  <para style="q1" vid="HOS 5:4">వారి హృదయాల్లో వ్యభిచార ఆత్మ ఉంది;</para>
  <para style="q2" vid="HOS 5:4">వారు యెహోవాను గుర్తించరు.<verse eid="HOS 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 5:5" />ఇశ్రాయేలీయుల అహంకారం వారికి విరోధంగా సాక్ష్యమిస్తుంది;</para>
  <para style="q2" vid="HOS 5:5">ఇశ్రాయేలీయులు, ఎఫ్రాయిమువారు కూడా తమ పాపంలో తడబడతారు;</para>
  <para style="q2" vid="HOS 5:5">యూదా కూడా వారితో తడబడుతుంది.<verse eid="HOS 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 5:6" />వారు యెహోవాను వెదకడానికి</para>
  <para style="q2" vid="HOS 5:6">తమ గొర్రెలను, పశువులను వెంటబెట్టుకొని వెళ్లినప్పుడు,</para>
  <para style="q1" vid="HOS 5:6">ఆయనను కనుగొనరు;</para>
  <para style="q2" vid="HOS 5:6">ఎందుకంటే ఆయన వారికి దూరంగా ఉన్నారు.<verse eid="HOS 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 5:7" />వారు యెహోవా పట్ల అపనమ్మకంగా ఉన్నారు;</para>
  <para style="q2" vid="HOS 5:7">వారు అక్రమ సంతానాన్ని కన్నారు.</para>
  <para style="q1" vid="HOS 5:7">వారు అమావాస్య ఉత్సవాలు జరుపుకున్నప్పుడు,</para>
  <para style="q2" vid="HOS 5:7">ఆయన వారి భూములను నాశనం చేస్తారు.<verse eid="HOS 5:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="HOS 5:8" />“గిబియాలో బాకానాదం చేయండి,</para>
  <para style="q2" vid="HOS 5:8">రామాలో బూర ఊదండి.</para>
  <para style="q1" vid="HOS 5:8">బెన్యామీనూ, నీ వెనుకే వస్తున్నాము;</para>
  <para style="q2" vid="HOS 5:8">బేత్-ఆవెనులో<note caller="+" style="f" category="dup"><char style="fr" closed="false">5:8 </char><char style="fq" closed="false">బేత్-ఆవెను </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">దుష్టత్వం గల ఇల్లు</char></note> యుద్ధ నినాదాలు చేయండి.<verse eid="HOS 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 5:9" />దండన రోజున</para>
  <para style="q2" vid="HOS 5:9">ఎఫ్రాయిం పాడైపోతుంది.</para>
  <para style="q1" vid="HOS 5:9">తప్పనిసరిగా జరగబోయే దానిని</para>
  <para style="q2" vid="HOS 5:9">నేను ఇశ్రాయేలు గోత్రాలకు ప్రకటిస్తున్నాను.<verse eid="HOS 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 5:10" />యూదా నాయకులు</para>
  <para style="q2" vid="HOS 5:10">సరిహద్దు రాళ్లను జరిపే వారిలా ఉన్నారు.</para>
  <para style="q1" vid="HOS 5:10">వారి మీద నా కోపాన్ని</para>
  <para style="q2" vid="HOS 5:10">నీటి ప్రవాహంలా కుమ్మరిస్తాను.<verse eid="HOS 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 5:11" />ఎఫ్రాయిమీయులు విగ్రహాల వెంట వెళ్తున్నారు కాబట్టి</para>
  <para style="q2" vid="HOS 5:11">వారు హింసించబడతారు,</para>
  <para style="q2" vid="HOS 5:11">తీర్పులో త్రొక్కబడతారు.<verse eid="HOS 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 5:12" />నేను ఎఫ్రాయిం వారికి చిమ్మెట పురుగులా ఉన్నాను,</para>
  <para style="q2" vid="HOS 5:12">యూదా ప్రజలకు కుళ్లు పట్టించే తెగులుగా ఉంటాను.<verse eid="HOS 5:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="HOS 5:13" />“ఎఫ్రాయిం తన రోగాన్ని,</para>
  <para style="q2" vid="HOS 5:13">యూదా తన పుండ్లను చూసుకున్నప్పుడు,</para>
  <para style="q1" vid="HOS 5:13">ఎఫ్రాయిం అష్షూరు వైపు తిరిగి</para>
  <para style="q2" vid="HOS 5:13">గొప్ప రాజును సహాయం కోరాడు.</para>
  <para style="q1" vid="HOS 5:13">అయితే అతడు నిన్ను బాగుచేయలేదు,</para>
  <para style="q2" vid="HOS 5:13">నీ పుండ్లను స్వస్థపరచలేదు.<verse eid="HOS 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 5:14" />ఎందుకంటే నేను ఎఫ్రాయిముకు సింహంలా</para>
  <para style="q2" vid="HOS 5:14">యూదాకు కొదమసింహంలా ఉంటాను.</para>
  <para style="q1" vid="HOS 5:14">నేను వారిని ముక్కలుగా చీల్చి వెళ్లిపోతాను;</para>
  <para style="q2" vid="HOS 5:14">వారిని మోసుకెళ్తాను, వారిని కాపాడేవారెవరూ ఉండరు.<verse eid="HOS 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 5:15" />వారు తమ అపరాధం ఒప్పుకుని</para>
  <para style="q2" vid="HOS 5:15">నన్ను వెదికే వరకు</para>
  <para style="q2" vid="HOS 5:15">నేను నా స్థలానికి తిరిగి వెళ్తాను,</para>
  <para style="q1" vid="HOS 5:15">వారు తమ దురవస్థలో</para>
  <para style="q2" vid="HOS 5:15">నన్ను తీవ్రంగా వెదకుతారు.”<verse eid="HOS 5:15" /></para>
  <chapter eid="HOS 5" />
  <chapter number="6" style="c" sid="HOS 6" />
  <para style="s1">పశ్చాత్తాపపడని ఇశ్రాయేలు</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 6:1" />“రండి, మనం యెహోవా దగ్గరకు తిరిగి వెళ్దాము.</para>
  <para style="q1" vid="HOS 6:1">ఆయన మనల్ని ముక్కలుగా చీల్చారు</para>
  <para style="q2" vid="HOS 6:1">కాని ఆయనే మనల్ని బాగుచేస్తారు;</para>
  <para style="q1" vid="HOS 6:1">ఆయన మనల్ని గాయపరచారు</para>
  <para style="q2" vid="HOS 6:1">కాని ఆయన మన గాయాలను కడతారు.<verse eid="HOS 6:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 6:2" />రెండు రోజుల తర్వాత ఆయన మనల్ని బ్రతికిస్తారు,</para>
  <para style="q2" vid="HOS 6:2">ఆయన సన్నిధిలో మనం బ్రతికేటట్టు,</para>
  <para style="q2" vid="HOS 6:2">మూడవ రోజున ఆయన మనల్ని పునరుద్ధరిస్తారు.<verse eid="HOS 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 6:3" />మనం యెహోవా గురించి తెలుసుకుందాం;</para>
  <para style="q2" vid="HOS 6:3">ఆయనను తెలుసుకోవడానికి ప్రయత్నం చేద్దాము.</para>
  <para style="q1" vid="HOS 6:3">సూర్యోదయం ఎంత నిశ్చయమో,</para>
  <para style="q2" vid="HOS 6:3">ఆయన ప్రత్యక్షమవ్వడం అంతే నిశ్చయం;</para>
  <para style="q1" vid="HOS 6:3">ఆయన శీతాకాలం వర్షాల్లా,</para>
  <para style="q2" vid="HOS 6:3">భూమిని తడిపే తొలకరి వానలా దగ్గరకు వస్తారు.”<verse eid="HOS 6:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HOS 6:4" />“ఎఫ్రాయిమూ, నిన్ను నేనేం చేయాలి?</para>
  <para style="q2" vid="HOS 6:4">యూదా, నిన్ను నేనేం చేయాలి?</para>
  <para style="q1" vid="HOS 6:4">మీ ప్రేమ ప్రొద్దున వచ్చే పొగమంచులా,</para>
  <para style="q2" vid="HOS 6:4">ఉదయకాలపు మంచులా అదృశ్యమవుతుంది.<verse eid="HOS 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 6:5" />కాబట్టి నా ప్రవక్తల ద్వారా మిమ్మల్ని ముక్కలు చేశాను,</para>
  <para style="q2" vid="HOS 6:5">నా నోటిమాటల ద్వారా మిమ్మల్ని చంపాను,</para>
  <para style="q2" vid="HOS 6:5">అప్పుడు నా తీర్పులు మెరుపులా ప్రకాశిస్తాయి.<verse eid="HOS 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 6:6" />ఎందుకంటే నేను దయను కోరుతున్నాను బలిని కాదు,</para>
  <para style="q2" vid="HOS 6:6">దహనబలుల కంటే దేవుని గురించిన జ్ఞానం నాకు ఇష్టము.<verse eid="HOS 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 6:7" />ఆదాములా<note caller="+" style="f"><char style="fr" closed="false">6:7 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">మానవుల్లా</char></note> వారు నా నిబంధనను మీరారు;</para>
  <para style="q2" vid="HOS 6:7">వారు నాకు నమ్మకద్రోహం చేశారు.<verse eid="HOS 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 6:8" />గిలాదు దుర్మార్గుల పట్టణం,</para>
  <para style="q2" vid="HOS 6:8">దానిలో రక్తపు అడుగుజాడలు ఉన్నాయి.<verse eid="HOS 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 6:9" />బందిపోటు దొంగల్లా మాటున పొంచి ఉన్నట్లు,</para>
  <para style="q2" vid="HOS 6:9">యాజకుల గుంపు పొంచి ఉంది;</para>
  <para style="q1" vid="HOS 6:9">షెకెము మార్గంలో వారు హత్య చేస్తారు,</para>
  <para style="q2" vid="HOS 6:9">దుర్మార్గపు కుట్రలు చేస్తూ ఉంటారు.<verse eid="HOS 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 6:10" />నేను ఇశ్రాయేలులో ఘోరమైన విషయాన్ని చూశాను:</para>
  <para style="q2" vid="HOS 6:10">అక్కడ ఎఫ్రాయిం వ్యభిచారానికి అప్పగించుకుంది,</para>
  <para style="q2" vid="HOS 6:10">ఇశ్రాయేలు అపవిత్రపరచబడింది.<verse eid="HOS 6:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HOS 6:11" />“నేను నా ప్రజలను</para>
  <para style="q2" vid="HOS 6:11">మునుపటి స్థితికి తీసుకువచ్చినప్పుడు,</para>
  <para style="b" vid="HOS 6:11" />
  <para style="q1" vid="HOS 6:11">“యూదా వారలారా, మీ కోసం కూడా కోత సిద్ధంగా ఉంది.<verse eid="HOS 6:11" /></para>
  <chapter eid="HOS 6" />
  <chapter number="7" style="c" sid="HOS 7" />
  <para style="q2">
    <verse number="1" style="v" sid="HOS 7:1" />నేను ఇశ్రాయేలును స్వస్థపరిచేటప్పుడు,</para>
  <para style="q1" vid="HOS 7:1">ఎఫ్రాయిం పాపాలు బహిర్గతం అవుతున్నాయి,</para>
  <para style="q2" vid="HOS 7:1">సమరయ నేరాలు బయటపడుతున్నాయి.</para>
  <para style="q1" vid="HOS 7:1">వారు మోసం చేస్తూనే ఉంటారు,</para>
  <para style="q2" vid="HOS 7:1">దొంగలు ఇళ్ళలో చొరబడతారు,</para>
  <para style="q2" vid="HOS 7:1">బందిపోటు దొంగలు వీధుల్లో దోచుకుంటారు;<verse eid="HOS 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 7:2" />అయితే వారి చెడు పనులన్నీ నేను జ్ఞాపకం చేసుకుంటానని</para>
  <para style="q2" vid="HOS 7:2">వారు గ్రహించరు.</para>
  <para style="q1" vid="HOS 7:2">వారి పాపాలు వారిని చుట్టుముట్టాయి;</para>
  <para style="q2" vid="HOS 7:2">అవి ఎప్పుడూ నా ఎదుటే ఉన్నాయి.<verse eid="HOS 7:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="HOS 7:3" />“వారు తమ దుష్టత్వంతో రాజును,</para>
  <para style="q2" vid="HOS 7:3">వారి అబద్ధాలతో అధిపతులను సంతోషపరుస్తారు.<verse eid="HOS 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 7:4" />వారంతా వ్యభిచారులు,</para>
  <para style="q2" vid="HOS 7:4">పొయ్యిలా మండుతూ ఉంటారు,</para>
  <para style="q1" vid="HOS 7:4">వంటమనిషి ముద్ద పిసికిన తర్వాత అది పొంగే వరకు</para>
  <para style="q2" vid="HOS 7:4">వేడి చేసిన పొయ్యివంటి వారు.<verse eid="HOS 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 7:5" />మన రాజు పండుగ దినాన,</para>
  <para style="q2" vid="HOS 7:5">అధిపతులు ద్రాక్ష మద్యం మత్తులో ఉంటారు.</para>
  <para style="q2" vid="HOS 7:5">అతడు అపహాసకులతో చేతులు కలుపుతాడు.<verse eid="HOS 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 7:6" />వారి హృదయాలు పొయ్యివంటివి;</para>
  <para style="q2" vid="HOS 7:6">కుట్రతో వారు అతన్ని సమీపిస్తారు.</para>
  <para style="q1" vid="HOS 7:6">రాత్రంతా వారి కోపాగ్ని రగులుతూ ఉంటుంది;</para>
  <para style="q2" vid="HOS 7:6">ఉదయాన అది మండే అగ్నిలా ప్రజ్వలిస్తుంది.<verse eid="HOS 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 7:7" />వారంతా పొయ్యిలా వేడిగా ఉన్నారు;</para>
  <para style="q2" vid="HOS 7:7">వారు తమ పాలకులను మ్రింగివేస్తారు</para>
  <para style="q1" vid="HOS 7:7">వారి రాజులందరూ కూలిపోతారు,</para>
  <para style="q2" vid="HOS 7:7">వారిలో ఏ ఒక్కడు నన్ను ప్రార్థించడు.<verse eid="HOS 7:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="HOS 7:8" />“ఎఫ్రాయిం దేశాలతో కలిసిపోతుంది;</para>
  <para style="q2" vid="HOS 7:8">ఎఫ్రాయిం తిరిగేయని అప్పం లాంటిది.<verse eid="HOS 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 7:9" />విదేశీయులు అతని బలాన్ని లాగేస్తారు,</para>
  <para style="q2" vid="HOS 7:9">కాని అతడు గ్రహించడు.</para>
  <para style="q1" vid="HOS 7:9">అతని తలమీద నెరసిన వెంట్రుకలు ఉంటాయి,</para>
  <para style="q2" vid="HOS 7:9">కాని అతడు గమనించడు.<verse eid="HOS 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 7:10" />ఇశ్రాయేలు అహంకారం అతనికి విరుద్ధంగా సాక్ష్యం ఇస్తుంది,</para>
  <para style="q2" vid="HOS 7:10">కాని ఇదంతా జరిగినా కూడా</para>
  <para style="q1" vid="HOS 7:10">అతడు తన దేవుడైన యెహోవా వైపు తిరగడం లేదు,</para>
  <para style="q2" vid="HOS 7:10">ఆయనను వెదకడం లేదు.<verse eid="HOS 7:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HOS 7:11" />“ఎఫ్రాయిం గువ్వ లాంటిది,</para>
  <para style="q2" vid="HOS 7:11">బుద్ధిలేక సులభంగా మోసపోతుంది,</para>
  <para style="q1" vid="HOS 7:11">అది ఈజిప్టును పిలుస్తుంది,</para>
  <para style="q2" vid="HOS 7:11">అది అష్షూరు వైపు తిరుగుతుంది.<verse eid="HOS 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 7:12" />వారు వెళ్లేటప్పుడు, నేను వారి మీద నా వల వేస్తాను;</para>
  <para style="q2" vid="HOS 7:12">నేను వారిని ఆకాశంలో పక్షుల్లా క్రిందికి లాగుతాను.</para>
  <para style="q1" vid="HOS 7:12">వారు సమాజంగా కూడుకుంటున్నారని నేను విన్నప్పుడు,</para>
  <para style="q2" vid="HOS 7:12">నేను వారిని శిక్షిస్తాను.<verse eid="HOS 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 7:13" />వారికి శ్రమ కలుగుతుంది,</para>
  <para style="q2" vid="HOS 7:13">ఎందుకంటే నా మీద తిరుగుబాటు చేశారు!</para>
  <para style="q1" vid="HOS 7:13">వారికి నాశనం కలుగుతుంది,</para>
  <para style="q2" vid="HOS 7:13">ఎందుకంటే నాకు విరుద్ధంగా తిరుగుబాటు చేశారు.</para>
  <para style="q1" vid="HOS 7:13">నేను వారిని విమోచించాలని ఆశిస్తాను,</para>
  <para style="q2" vid="HOS 7:13">కాని వారు నా గురించి అబద్ధాలు చెప్పారు.<verse eid="HOS 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 7:14" />వారు తమ హృదయపూర్వకంగా నాకు మొరపెట్టరు,</para>
  <para style="q2" vid="HOS 7:14">కాని తమ పడకల మీద విలపిస్తారు.</para>
  <para style="q1" vid="HOS 7:14">ధాన్యం కోసం, నూతన ద్రాక్షరసం కోసం,</para>
  <para style="q2" vid="HOS 7:14">వారు తమ దేవుళ్ళను వేడుకుంటూ తమను తాము కొట్టుకుంటారు</para>
  <para style="q2" vid="HOS 7:14">కాని వారు నా నుండి తొలగిపోయారు.<verse eid="HOS 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 7:15" />నేను వారికి శిక్షణ ఇచ్చి బలపరిచాను,</para>
  <para style="q2" vid="HOS 7:15">కాని నాకు విరుద్ధంగా దురాలోచన చేస్తున్నారు.<verse eid="HOS 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 7:16" />వారు సర్వోన్నతుని వైపు తిరుగరు,</para>
  <para style="q2" vid="HOS 7:16">వారు పనికిరాని విల్లులా ఉన్నారు.</para>
  <para style="q1" vid="HOS 7:16">వారి నాయకులు తమ గర్వపు మాటల వలన</para>
  <para style="q2" vid="HOS 7:16">కత్తివేటుకు పడిపోతారు.</para>
  <para style="q1" vid="HOS 7:16">ఇందుచేత ఈజిప్టు దేశంలో</para>
  <para style="q2" vid="HOS 7:16">వారు ఎగతాళి చేయబడతారు.<verse eid="HOS 7:16" /></para>
  <chapter eid="HOS 7" />
  <chapter number="8" style="c" sid="HOS 8" />
  <para style="s1">ఇశ్రాయేలు సుడిగాలిని కోస్తారు</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 8:1" />“బూర నీ పెదవులపై పెట్టుకో!</para>
  <para style="q2" vid="HOS 8:1">ఒక గ్రద్ద యెహోవా ఇంటి మీద వ్రాలింది.</para>
  <para style="q1" vid="HOS 8:1">ఎందుకంటే ప్రజలు నా నిబంధనను మీరి,</para>
  <para style="q2" vid="HOS 8:1">నా ధర్మశాస్త్రాన్ని అతిక్రమించారు.<verse eid="HOS 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 8:2" />ఇశ్రాయేలు, ‘మా దేవా!</para>
  <para style="q2" vid="HOS 8:2">మిమ్మల్ని మేము తెలుసుకున్నాం’ అని మొరపెడుతుంది.<verse eid="HOS 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 8:3" />కాని ఇశ్రాయేలు మంచి దానిని విసర్జించారు;</para>
  <para style="q2" vid="HOS 8:3">కాబట్టి శత్రువులు వారిని తరుముతారు.<verse eid="HOS 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 8:4" />వారు నా సమ్మతి లేకుండా రాజులను నియమించుకున్నారు,</para>
  <para style="q2" vid="HOS 8:4">వారు నా ఆమోదం లేకుండా అధిపతులను ఎన్నుకున్నారు.</para>
  <para style="q1" vid="HOS 8:4">వారి వెండి బంగారాలతో</para>
  <para style="q2" vid="HOS 8:4">తమ కోసం విగ్రహాలు చేసుకున్నారు.</para>
  <para style="q2" vid="HOS 8:4">అవి వారి సొంత నాశనానికే.<verse eid="HOS 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 8:5" />సమరయా, నీ దూడ విగ్రహాన్ని తీసివేయి!</para>
  <para style="q2" vid="HOS 8:5">నా కోపం వాటి మీద రగులుకుంది</para>
  <para style="q1" vid="HOS 8:5">ఎంతకాలం మీరు అపవిత్రులుగా ఉంటారు?<verse eid="HOS 8:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 8:6" />ఆ విగ్రహాలు ఇశ్రాయేలువి!</para>
  <para style="q1" vid="HOS 8:6">ఈ దూడను కంసాలి తయారుచేశాడు.</para>
  <para style="q2" vid="HOS 8:6">అది దేవుడు కాదు,</para>
  <para style="q1" vid="HOS 8:6">ఆ సమరయ దూడ</para>
  <para style="q2" vid="HOS 8:6">ముక్కలుగా విరగ్గొట్టబడుతుంది.<verse eid="HOS 8:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="HOS 8:7" />“వారు గాలిని విత్తుతారు,</para>
  <para style="q2" vid="HOS 8:7">సుడిగాలిని కోస్తారు.</para>
  <para style="q1" vid="HOS 8:7">పైరుకు కంకులు లేవు,</para>
  <para style="q2" vid="HOS 8:7">దాని నుండి పిండి రాదు.</para>
  <para style="q1" vid="HOS 8:7">అది ఒకవేళ పంటకు వస్తే,</para>
  <para style="q2" vid="HOS 8:7">విదేశీయులు దాన్ని మ్రింగివేస్తారు.<verse eid="HOS 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 8:8" />ఇశ్రాయేలు మ్రింగివేయబడింది;</para>
  <para style="q2" vid="HOS 8:8">ఇప్పుడు అది ఎవరికీ ఇష్టం లేనిదానిగా,</para>
  <para style="q2" vid="HOS 8:8">ఇతర దేశాల మధ్య ఉంది.<verse eid="HOS 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 8:9" />వారు ఒంటరిగా తిరిగే అడవి గాడిదలా,</para>
  <para style="q2" vid="HOS 8:9">అష్షూరుకు వెళ్లారు,</para>
  <para style="q2" vid="HOS 8:9">ఎఫ్రాయిం తనను తాను విటులకు అమ్ముకుంది.<verse eid="HOS 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 8:10" />వారు తమను ఇతర దేశాల్లో అమ్ముకున్నప్పటికీ,</para>
  <para style="q2" vid="HOS 8:10">నేను వారిని ఇప్పుడు సమకూరుస్తాను.</para>
  <para style="q1" vid="HOS 8:10">బలవంతుడైన రాజు పెట్టే భారం క్రింద,</para>
  <para style="q2" vid="HOS 8:10">వారు నీరసించిపోతారు.<verse eid="HOS 8:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HOS 8:11" />“పాపపరిహార బలులు అర్పించడానికి ఎఫ్రాయిం అనేక బలిపీఠాలు నిర్మించింది,</para>
  <para style="q2" vid="HOS 8:11">కాని అవే పాపం చేయడానికి కారణమయ్యాయి.<verse eid="HOS 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 8:12" />నేను వారి కోసం నా ధర్మశాస్త్ర విషయాలు ఎన్నో వ్రాశాను,</para>
  <para style="q2" vid="HOS 8:12">కాని అవి తమకు సంబంధించినవి కావన్నట్లు పరిగణించారు.<verse eid="HOS 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 8:13" />వారు తమ బలులు నాకు బహుమానంగా ఇచ్చినా,</para>
  <para style="q2" vid="HOS 8:13">వాటి మాంసం తిన్నా సరే,</para>
  <para style="q2" vid="HOS 8:13">యెహోవా వారిని బట్టి సంతోషించడం లేదు.</para>
  <para style="q1" vid="HOS 8:13">ఇప్పుడు ఆయన వారి దుష్టత్వాన్ని జ్ఞాపకం చేసుకుని,</para>
  <para style="q2" vid="HOS 8:13">వారి పాపాలను శిక్షిస్తారు:</para>
  <para style="q2" vid="HOS 8:13">వారు ఈజిప్టుకు తిరిగి వెళ్తారు.<verse eid="HOS 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 8:14" />ఇశ్రాయేలు తమ సృష్టికర్తను మరచిపోయి</para>
  <para style="q2" vid="HOS 8:14">రాజభవనాలను కట్టుకున్నారు;</para>
  <para style="q2" vid="HOS 8:14">యూదావారు చాలా పట్టణాలకు కోటలు కట్టుకున్నారు.</para>
  <para style="q1" vid="HOS 8:14">అయితే నేను వారి పట్టణాల మీద అగ్ని కురిపిస్తాను,</para>
  <para style="q2" vid="HOS 8:14">అది వాటి కోటలను దహించి వేస్తుంది.”<verse eid="HOS 8:14" /></para>
  <chapter eid="HOS 8" />
  <chapter number="9" style="c" sid="HOS 9" />
  <para style="s1">ఇశ్రాయేలుకు శిక్ష</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 9:1" />ఇశ్రాయేలూ, ఆనందించకు;</para>
  <para style="q2" vid="HOS 9:1">ఇతర దేశాల్లా ఉత్సాహపడకు.</para>
  <para style="q1" vid="HOS 9:1">నీవు నీ దేవుని పట్ల నమ్మకంగా లేవు;</para>
  <para style="q2" vid="HOS 9:1">ధాన్యం దుల్లగొట్టే నీ నూర్పిడి కళ్ళాలన్నిటిలో</para>
  <para style="q2" vid="HOS 9:1">నీవు వేశ్యల జీతాన్ని తీసుకోవడానికి ఇష్టపడ్డావు.<verse eid="HOS 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 9:2" />నూర్పిడి కళ్ళాలు, ద్రాక్ష గానుక తొట్లు ప్రజలను పోషించవు,</para>
  <para style="q2" vid="HOS 9:2">క్రొత్త ద్రాక్షరసం వారికి మిగలదు.<verse eid="HOS 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 9:3" />వారు యెహోవా దేశంలో నిలిచి ఉండరు,</para>
  <para style="q2" vid="HOS 9:3">ఎఫ్రాయిం ఈజిప్టుకు తిరిగి వెళ్తుంది,</para>
  <para style="q2" vid="HOS 9:3">అష్షూరులో అపవిత్ర ఆహారాన్ని తింటుంది.<verse eid="HOS 9:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 9:4" />వారు యెహోవాకు ద్రాక్షరస పానార్పణలు అర్పించరు,</para>
  <para style="q2" vid="HOS 9:4">వారి బలులు ఆయనను సంతోషపరచవు.</para>
  <para style="q1" vid="HOS 9:4">అట్టి బలులు ఏడ్చేవారి రొట్టెలా ఉంటాయి.</para>
  <para style="q2" vid="HOS 9:4">వాటిని తినేవారందరు అపవిత్రులవుతారు.</para>
  <para style="q1" vid="HOS 9:4">ఈ ఆహారం వారికే సరిపడుతుంది;</para>
  <para style="q2" vid="HOS 9:4">అది యెహోవా మందిరంలోకి రాదు.<verse eid="HOS 9:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="HOS 9:5" />మీ నియమించబడిన పండుగల దినాన,</para>
  <para style="q2" vid="HOS 9:5">యెహోవా విందు దినాల్లో మీరేం చేస్తారు?<verse eid="HOS 9:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 9:6" />వారు నాశనాన్ని తప్పించుకున్నా సరే,</para>
  <para style="q2" vid="HOS 9:6">ఈజిప్టువారిని సమకూరుస్తుంది,</para>
  <para style="q2" vid="HOS 9:6">మెంఫిసు వారిని పాతిపెడుతుంది.</para>
  <para style="q1" vid="HOS 9:6">వారికి ప్రియమైన వెండి వస్తువులను దురదగొండ్లు ఆక్రమిస్తాయి,</para>
  <para style="q2" vid="HOS 9:6">వారి గుడారాలు ముళ్ళతో నిండుతాయి.<verse eid="HOS 9:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 9:7" />శిక్షా దినాలు వస్తున్నాయి,</para>
  <para style="q2" vid="HOS 9:7">వెల చెల్లించే దినాలు సమీపంగా ఉన్నాయి.</para>
  <para style="q2" vid="HOS 9:7">ఇశ్రాయేలు దీనిని తెలుసుకోవాలి.</para>
  <para style="q1" vid="HOS 9:7">ఎందుకంటే మీ అపరాధాలు అనేకం,</para>
  <para style="q2" vid="HOS 9:7">మీరు చూపిన శత్రుత్వం తీవ్రమైంది కాబట్టి</para>
  <para style="q1" vid="HOS 9:7">ప్రవక్త మూర్ఖునిగా,</para>
  <para style="q2" vid="HOS 9:7">ప్రభావం గల వ్యక్తి పిచ్చివానిగా పరిగణించబడుతున్నారు.<verse eid="HOS 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 9:8" />నా దేవునితో పాటు ఉండే ప్రవక్త</para>
  <para style="q2" vid="HOS 9:8">ఎఫ్రాయిం ప్రజలకు కావలివాడు,</para>
  <para style="q1" vid="HOS 9:8">అయినప్పటికీ అతని త్రోవలన్నిట్లో ఉచ్చులు పొంచి ఉన్నాయి.</para>
  <para style="q2" vid="HOS 9:8">తన దేవుని ఆలయంలో కూడా శత్రువులు ఉన్నారు.<verse eid="HOS 9:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 9:9" />గిబియా రోజుల్లో ఉన్నట్లు,</para>
  <para style="q2" vid="HOS 9:9">వారు అవినీతిలో లోతుగా మునిగిపోయారు.</para>
  <para style="q1" vid="HOS 9:9">దేవుడు వారి దుష్టత్వాన్ని జ్ఞాపకం చేసుకుని,</para>
  <para style="q2" vid="HOS 9:9">వారి పాపాల కోసం వారిని శిక్షిస్తారు.<verse eid="HOS 9:9" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="10" style="v" sid="HOS 9:10" />“నాకు ఇశ్రాయేలు దొరికినప్పుడు,</para>
  <para style="q2" vid="HOS 9:10">ఎడారిలో ద్రాక్షపండ్లు చూసినట్లు అనిపించింది;</para>
  <para style="q1" vid="HOS 9:10">నేను మీ పూర్వికులను చూసినప్పుడు,</para>
  <para style="q2" vid="HOS 9:10">అంజూర చెట్టు మీద తొలి పండ్లను చూసినట్లు అనిపించింది.</para>
  <para style="q1" vid="HOS 9:10">అయితే వారు బయల్-పెయోరు వచ్చినప్పుడు,</para>
  <para style="q2" vid="HOS 9:10">వారు ఆ సిగ్గుమాలిన విగ్రహానికి తమను తాము ప్రతిష్ఠించుకొన్నారు,</para>
  <para style="q2" vid="HOS 9:10">తాము ఇష్టపడింది ఎంత నీచమో, వారు అంత నీచులయ్యారు.<verse eid="HOS 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 9:11" />ఎఫ్రాయిం యొక్క ఘనత పక్షిలా ఎగిరిపోతుంది,</para>
  <para style="q2" vid="HOS 9:11">పుట్టుక, గర్భధారణ, పిల్లలను కనడం వారిలో ఉండవు.<verse eid="HOS 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 9:12" />వారు పిల్లలను పెంచినా సరే,</para>
  <para style="q2" vid="HOS 9:12">నేను వారికి మనుష్యులందరిని దూరం చేస్తాను.</para>
  <para style="q1" vid="HOS 9:12">నేను వారిని విడిచిపెట్టినప్పుడు,</para>
  <para style="q2" vid="HOS 9:12">వారికి శ్రమ!<verse eid="HOS 9:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 9:13" />నేను ఎఫ్రాయిమును,</para>
  <para style="q2" vid="HOS 9:13">అందమైన స్థలంలో నాటబడిన తూరులా చూశాను.</para>
  <para style="q1" vid="HOS 9:13">కాని ఎఫ్రాయిం తన పిల్లలను,</para>
  <para style="q2" vid="HOS 9:13">వధించే వాని దగ్గరకు తెస్తుంది.”<verse eid="HOS 9:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="HOS 9:14" />యెహోవా, వారికి ఇవ్వండి,</para>
  <para style="q2" vid="HOS 9:14">వారికి మీరేమి ఇస్తారు,</para>
  <para style="q1" vid="HOS 9:14">జన్మనివ్వలేని గర్భాలను,</para>
  <para style="q2" vid="HOS 9:14">ఎండిపోయిన రొమ్ములను వారికి ఇవ్వండి.<verse eid="HOS 9:14" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="15" style="v" sid="HOS 9:15" />“గిల్గాలులో వారి చెడుతనం అంతటిని బట్టి,</para>
  <para style="q2" vid="HOS 9:15">అక్కడ వారిని ద్వేషిస్తున్నాను.</para>
  <para style="q1" vid="HOS 9:15">వారు పాప క్రియలనుబట్టి,</para>
  <para style="q2" vid="HOS 9:15">నేను వారిని నా మందిరంలో నుండి వెళ్లగొడతాను.</para>
  <para style="q1" vid="HOS 9:15">నేను ఇక ఎన్నడూ వారిని ప్రేమించను;</para>
  <para style="q2" vid="HOS 9:15">వారి నాయకులంతా తిరుగుబాటుదారులు.<verse eid="HOS 9:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 9:16" />ఎఫ్రాయిమువారు మొత్తబడ్డారు,</para>
  <para style="q2" vid="HOS 9:16">వారి వేరు ఎండిపోయింది,</para>
  <para style="q2" vid="HOS 9:16">వారు ఇక ఫలించరు.</para>
  <para style="q1" vid="HOS 9:16">ఒకవేళ వారు పిల్లలు కన్నా,</para>
  <para style="q2" vid="HOS 9:16">వారి ప్రియమైన సంతతిని నేను నాశనం చేస్తాను.”<verse eid="HOS 9:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="HOS 9:17" />వారు నా దేవునికి లోబడలేదు కాబట్టి,</para>
  <para style="q2" vid="HOS 9:17">ఆయన వారిని తిరస్కరించారు;</para>
  <para style="q2" vid="HOS 9:17">వారు ఇతర దేశాల్లో తిరుగుతూ ఉంటారు.<verse eid="HOS 9:17" /></para>
  <para style="b" />
  <chapter eid="HOS 9" />
  <chapter number="10" style="c" sid="HOS 10" />
  <para style="q1">
    <verse number="1" style="v" sid="HOS 10:1" />ఇశ్రాయేలు విస్తరించిన ద్రాక్షచెట్టు;</para>
  <para style="q2" vid="HOS 10:1">అతడు బాగా ఫలించాడు.</para>
  <para style="q1" vid="HOS 10:1">అతడు ఫలించినకొద్దీ,</para>
  <para style="q2" vid="HOS 10:1">అతడు ఎక్కువ బలిపీఠాలను కట్టాడు.</para>
  <para style="q1" vid="HOS 10:1">అతని భూమి సారవంతమైన కొద్ది,</para>
  <para style="q2" vid="HOS 10:1">అతడు తన పవిత్ర రాళ్లను అలంకరించాడు.<verse eid="HOS 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 10:2" />వారి హృదయం కపటమైనది,</para>
  <para style="q2" vid="HOS 10:2">ఇప్పుడు వారు తమ అపరాధానికి శిక్షను భరించాలి.</para>
  <para style="q1" vid="HOS 10:2">యెహోవా వారి బలిపీఠాలను పడగొట్టి,</para>
  <para style="q2" vid="HOS 10:2">వారి పవిత్ర రాళ్లను నాశనం చేస్తారు.<verse eid="HOS 10:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="HOS 10:3" />అప్పుడు వారు, “మనకు రాజు లేడు</para>
  <para style="q2" vid="HOS 10:3">ఎందుకంటే మనం యెహోవాకు భయపడలేదు.</para>
  <para style="q1" vid="HOS 10:3">ఒకవేళ మనకు రాజు ఉన్నా కూడా,</para>
  <para style="q2" vid="HOS 10:3">అతడు మనకు ఏమి చేయగలడు?” అంటారు.<verse eid="HOS 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 10:4" />వారు ఎన్నో వాగ్దానాలు చేస్తారు,</para>
  <para style="q2" vid="HOS 10:4">అబద్ధ ప్రమాణాలు చేస్తారు</para>
  <para style="q2" vid="HOS 10:4">ఒప్పందాలు చేసుకుంటారు;</para>
  <para style="q1" vid="HOS 10:4">కాబట్టి వాదనలు దున్నబడిన పొలంలో</para>
  <para style="q2" vid="HOS 10:4">విషపు మొక్కల్లా మొలుస్తాయి.<verse eid="HOS 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 10:5" />సమరయలో నివసించే ప్రజలు,</para>
  <para style="q2" vid="HOS 10:5">బేత్-ఆవెనులో<note caller="+" style="f"><char style="fr" closed="false">10:5 </char><char style="fq" closed="false">బేత్-ఆవెనులో </char><char style="ft" closed="false">అంటే </char><char style="fqa" closed="false">దుష్టత్వం గల ఇల్లు</char></note> ఉన్న దూడ విగ్రహం గురించి భయపడతారు.</para>
  <para style="q1" vid="HOS 10:5">దాని ఘనత పోయిందని</para>
  <para style="q2" vid="HOS 10:5">దాని ప్రజలు దుఃఖపడతారు,</para>
  <para style="q1" vid="HOS 10:5">దాని వైభవం గురించి ఆనందించిన</para>
  <para style="q2" vid="HOS 10:5">దాని యాజకులు ఏడుస్తారు.<verse eid="HOS 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 10:6" />అది అష్షూరుకు కొనిపోబడి,</para>
  <para style="q2" vid="HOS 10:6">మహారాజుకు కానుకగా ఇవ్వబడుతుంది.</para>
  <para style="q1" vid="HOS 10:6">ఎఫ్రాయిం అవమానించబడుతుంది;</para>
  <para style="q2" vid="HOS 10:6">ఇశ్రాయేలు తాను చేసిన తప్పుడు ఆలోచనలను బట్టి సిగ్గుపడుతుంది.<verse eid="HOS 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 10:7" />సమరయ రాజు నాశనమవుతాడు,</para>
  <para style="q2" vid="HOS 10:7">అతడు నీటిలో విరిగిపోయిన రెమ్మలా కొట్టుకు పోతాడు.<verse eid="HOS 10:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 10:8" />ఇశ్రాయేలు పాపానికి ప్రతిరూపాలైన</para>
  <para style="q2" vid="HOS 10:8">దుష్టత్వం<note caller="+" style="f"><char style="fr" closed="false">10:8 </char><char style="ft" closed="false">హెబ్రీలో </char><char style="fqa" closed="false">ఆవెను </char><char style="ft" closed="false">బేత్-ఆవెన్ ను సూచిస్తుంది; 5 వచనం చూడండి</char></note> కలిగిన క్షేత్రాలు నాశనం చేయబడతాయి.</para>
  <para style="q1" vid="HOS 10:8">ముండ్ల చెట్లు, గచ్చపొదలు పెరిగి</para>
  <para style="q2" vid="HOS 10:8">వారి బలిపీఠాలను కప్పుతాయి.</para>
  <para style="q1" vid="HOS 10:8">అప్పుడు వారు పర్వతాలతో, “మమ్మల్ని కప్పండి!” అని</para>
  <para style="q2" vid="HOS 10:8">కొండలతో, “మామీద పడండి!” అని అంటారు.<verse eid="HOS 10:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="HOS 10:9" />“ఇశ్రాయేలూ, గిబియా కాలం నుండి నీవు పాపం చేస్తూ ఉన్నావు.</para>
  <para style="q2" vid="HOS 10:9">నీవు అదే స్థితిలో ఉండిపోయావు.</para>
  <para style="q1" vid="HOS 10:9">గిబియాలోని దుర్మార్గుల మీదికి</para>
  <para style="q2" vid="HOS 10:9">మరలా యుద్ధం రాలేదా?<verse eid="HOS 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 10:10" />నాకు ఇష్టమైనప్పుడు, నేను వారిని శిక్షిస్తాను;</para>
  <para style="q2" vid="HOS 10:10">వారి రెండంతల పాపం కోసం వారిని బంధకాలలో పెట్టడానికి</para>
  <para style="q2" vid="HOS 10:10">దేశాలు వారికి విరుద్ధంగా కూడుకుంటాయి.<verse eid="HOS 10:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 10:11" />ఎఫ్రాయిం శిక్షణ పొందిన పెయ్యలా ఉంది,</para>
  <para style="q2" vid="HOS 10:11">నూర్పిడి అంటే దానికి ఇష్టం;</para>
  <para style="q1" vid="HOS 10:11">కాబట్టి దాని నున్నటి మెడ మీద</para>
  <para style="q2" vid="HOS 10:11">నేను కాడి పెడతాను,</para>
  <para style="q1" vid="HOS 10:11">నేను ఎఫ్రాయిం మీద స్వారీ చేస్తాను,</para>
  <para style="q2" vid="HOS 10:11">యూదా భూమిని దున్నాలి,</para>
  <para style="q2" vid="HOS 10:11">యాకోబు భూమిని చదును చేయాలి.<verse eid="HOS 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 10:12" />మీ కోసం నీతిని విత్తండి,</para>
  <para style="q2" vid="HOS 10:12">మారని ప్రేమ అనే పంట కోయండి.</para>
  <para style="q1" vid="HOS 10:12">దున్నబడని భూమిని చదును చేయండి;</para>
  <para style="q2" vid="HOS 10:12">ఎందుకంటే, యెహోవా మీ దగ్గరకు వచ్చి,</para>
  <para style="q1" vid="HOS 10:12">నీతి వర్షం మీపై కురిపించే వరకు,</para>
  <para style="q2" vid="HOS 10:12">యెహోవాను వెదికే సమయం ఇదే.<verse eid="HOS 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 10:13" />కాని మీరు దున్ని దుష్టత్వాన్ని నాటారు,</para>
  <para style="q2" vid="HOS 10:13">మీరు చెడును కోశారు,</para>
  <para style="q2" vid="HOS 10:13">మీరు వంచన ఫలాలు తిన్నారు.</para>
  <para style="q1" vid="HOS 10:13">మీరు మీ సొంత బలాన్ని,</para>
  <para style="q2" vid="HOS 10:13">మీకున్న అనేకమంది యోధులను నమ్ముకున్నారు.<verse eid="HOS 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 10:14" />కాబట్టి మీ ప్రజల్లో అల్లకల్లోలం ఏర్పడుతుంది,</para>
  <para style="q2" vid="HOS 10:14">షల్మాను యుద్ధంలో బేత్-అర్బేలును పాడుచేసినట్లు,</para>
  <para style="q1" vid="HOS 10:14">మీ కోటలన్నీ నాశనమవుతాయి,</para>
  <para style="q2" vid="HOS 10:14">ఆ రోజు తల్లులు తమ పిల్లలతో పాటు నేలకు కొట్టబడతారు.<verse eid="HOS 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="HOS 10:15" />బేతేలు, నీకు ఇలా జరుగుతుంది,</para>
  <para style="q2" vid="HOS 10:15">ఎందుకంటే, నీ దుష్టత్వం ఘోరంగా ఉంది.</para>
  <para style="q1" vid="HOS 10:15">ఆ రోజు ఉదయించినప్పుడు,</para>
  <para style="q2" vid="HOS 10:15">ఇశ్రాయేలు రాజు సంపూర్ణంగా నాశనమవుతాడు.<verse eid="HOS 10:15" /></para>
  <chapter eid="HOS 10" />
  <chapter number="11" style="c" sid="HOS 11" />
  <para style="s1">ఇశ్రాయేలుపై దేవుని ప్రేమ</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 11:1" />“ఇశ్రాయేలు శిశువుగా ఉన్నప్పుడు నేను అతన్ని ప్రేమించాను,</para>
  <para style="q2" vid="HOS 11:1">ఈజిప్టులో నుండి నేను నా కుమారుని పిలిచాను.<verse eid="HOS 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 11:2" />అయితే ఎంత ఎక్కువగా వారిని పిలిస్తే,</para>
  <para style="q2" vid="HOS 11:2">అంతగా వారు నా నుండి దూరమయ్యారు.</para>
  <para style="q1" vid="HOS 11:2">వారు బయలుకు బలులు అర్పించారు,</para>
  <para style="q2" vid="HOS 11:2">విగ్రహాలకు ధూపం వేశారు.<verse eid="HOS 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 11:3" />ఎఫ్రాయిం ప్రజలను చేయి పట్టుకుని,</para>
  <para style="q2" vid="HOS 11:3">నడవడం నేర్పింది నేనే;</para>
  <para style="q1" vid="HOS 11:3">అయితే వారిని స్వస్థపరచింది నేనని</para>
  <para style="q2" vid="HOS 11:3">వారు గ్రహించలేదు.<verse eid="HOS 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 11:4" />నేను మనుష్యుల మంచితనం అనే త్రాళ్లతో,</para>
  <para style="q2" vid="HOS 11:4">ప్రేమ బంధాలతో వారిని నడిపించాను.</para>
  <para style="q1" vid="HOS 11:4">ఒకడు చిన్నబిడ్డను ముఖం దగ్గరకు ఎలా తీసుకుంటారో,</para>
  <para style="q2" vid="HOS 11:4">అలా నేను వారికి ఉంటూ వారి మీద నుండి కాడిని తీసివేశాను,</para>
  <para style="q2" vid="HOS 11:4">నేను క్రిందికి వంగి వారిని పోషించాను.<verse eid="HOS 11:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="HOS 11:5" />“వారు ఈజిప్టుకు తిరిగి వెళ్లరా?</para>
  <para style="q2" vid="HOS 11:5">అష్షూరు రాజు వారిమీద అధికారం చేయడా?</para>
  <para style="q2" vid="HOS 11:5">ఎందుకంటే వారు పశ్చాత్తాపపడడానికి నిరాకరించారు.<verse eid="HOS 11:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 11:6" />వారి పట్టణాల్లో ఖడ్గం తళుక్కుమంటుంది;</para>
  <para style="q2" vid="HOS 11:6">అది వారి అబద్ధ ప్రవక్తలను మ్రింగివేస్తుంది,</para>
  <para style="q2" vid="HOS 11:6">వారి ఉపాయాలను తుదముట్టిస్తుంది.<verse eid="HOS 11:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 11:7" />నా ప్రజలు నా నుండి తిరిగిపోవాలని నిశ్చయించుకున్నారు.</para>
  <para style="q2" vid="HOS 11:7">వారు మహోన్నత దేవుడనైన నాకు మొరపెట్టినా,</para>
  <para style="q2" vid="HOS 11:7">నేను ఏ విధంగాను వారిని హెచ్చించను.<verse eid="HOS 11:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="HOS 11:8" />“ఎఫ్రాయిమూ, నిన్ను ఎలా వదిలేయగలను?</para>
  <para style="q2" vid="HOS 11:8">ఇశ్రాయేలూ, నిన్ను ఎలా అప్పగించగలను?</para>
  <para style="q1" vid="HOS 11:8">నిన్ను ఎలా అద్మాలా పరిగణించగలను?</para>
  <para style="q2" vid="HOS 11:8">సెబోయిములా నిన్ను ఎలా చేయగలను?</para>
  <para style="q1" vid="HOS 11:8">నా హృదయం నాలో మారింది;</para>
  <para style="q2" vid="HOS 11:8">నా జాలి అంతా ఉప్పొంగుతుంది.<verse eid="HOS 11:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HOS 11:9" />నేను నా కోపాగ్నిని చూపించను,</para>
  <para style="q2" vid="HOS 11:9">ఎఫ్రాయిమును మరలా నాశనం చేయను.</para>
  <para style="q1" vid="HOS 11:9">నేను దేవుడను, మనిషిని కాను,</para>
  <para style="q2" vid="HOS 11:9">మీ మధ్య ఉన్న పరిశుద్ధ దేవుడను.</para>
  <para style="q2" vid="HOS 11:9">నేను వారి పట్టణాలకు విరుద్ధంగా రాను.<verse eid="HOS 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 11:10" />వారు యెహోవాను అనుసరిస్తారు;</para>
  <para style="q2" vid="HOS 11:10">ఆయన సింహంలా గర్జిస్తారు,</para>
  <para style="q1" vid="HOS 11:10">ఆయన గర్జించినప్పుడు,</para>
  <para style="q2" vid="HOS 11:10">ఆయన పిల్లలు పడమటి నుండి వణకుతూ వస్తారు.<verse eid="HOS 11:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 11:11" />వారు వణకుతూ ఈజిప్టు నుండి</para>
  <para style="q2" vid="HOS 11:11">పక్షుల్లా ఎగిరి వస్తారు,</para>
  <para style="q2" vid="HOS 11:11">అష్షూరు నుండి గువ్వల్లా అల్లాడుతూ వస్తారు.</para>
  <para style="q1" vid="HOS 11:11">వారిని తమ ఇళ్ళలో నివసించేలా చేస్తాను,”</para>
  <para style="q2" vid="HOS 11:11">అని యెహోవా ప్రకటిస్తున్నారు.<verse eid="HOS 11:11" /></para>
  <para style="s1">ఇశ్రాయేలీయుల పాపం</para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 11:12" />ఎఫ్రాయిం అబద్ధాలతో నన్ను చుట్టుముట్టింది,</para>
  <para style="q2" vid="HOS 11:12">ఇశ్రాయేలు మోసంతో నన్ను ఆవరించింది.</para>
  <para style="q1" vid="HOS 11:12">యూదా దేవునికి విరుద్ధంగా ఉంది,</para>
  <para style="q2" vid="HOS 11:12">నమ్మకమైన పరిశుద్ధ దేవుని మీద తిరుగుబాటు చేస్తున్నారు.<verse eid="HOS 11:12" /></para>
  <chapter eid="HOS 11" />
  <chapter number="12" style="c" sid="HOS 12" />
  <para style="q1">
    <verse number="1" style="v" sid="HOS 12:1" />ఎఫ్రాయిం గాలిని మేస్తున్నాడు;</para>
  <para style="q2" vid="HOS 12:1">అతడు రోజంతా తూర్పు గాలిని వెంటాడుతున్నాడు,</para>
  <para style="q2" vid="HOS 12:1">విస్తారంగా అబద్ధాలాడుతూ, దౌర్జన్యం చేస్తున్నాడు.</para>
  <para style="q1" vid="HOS 12:1">అతడు అష్షూరుతో ఒప్పందం చేస్తున్నాడు</para>
  <para style="q2" vid="HOS 12:1">ఈజిప్టుకు ఒలీవనూనె పంపిస్తున్నాడు.<verse eid="HOS 12:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 12:2" />యెహోవా యూదా మీద నేరారోపణ చేస్తున్నారు;</para>
  <para style="q2" vid="HOS 12:2">ఆయన యాకోబును తన మార్గాలను బట్టి శిక్షిస్తారు</para>
  <para style="q2" vid="HOS 12:2">ఆయన అతని క్రియలనుబట్టి అతనికి ప్రతిఫలం ఇస్తారు.<verse eid="HOS 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 12:3" />తల్లి గర్భంలో అతడు తన సోదరుని కాలి మడమను పట్టుకున్నాడు;</para>
  <para style="q2" vid="HOS 12:3">అతడు పెద్దవాడయ్యాక దేవునితో పోరాడాడు.<verse eid="HOS 12:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="HOS 12:4" />అతడు దేవదూతతో పోరాడి గెలిచాడు;</para>
  <para style="q2" vid="HOS 12:4">అతడు ఏడ్చి, దయచూపమని వేడుకున్నాడు.</para>
  <para style="q1" vid="HOS 12:4">బేతేలులో అతడు దేవున్ని కనుగొన్నాడు</para>
  <para style="q2" vid="HOS 12:4">అక్కడ అతడు ఆయనతో మాట్లాడాడు.<verse eid="HOS 12:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 12:5" />ఆయన సైన్యాల అధిపతియైన యెహోవా,</para>
  <para style="q2" vid="HOS 12:5">ఆయన పేరు యెహోవా!<verse eid="HOS 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 12:6" />అయితే నీవు నీ దేవుని దగ్గరకు తిరిగి రావాలి;</para>
  <para style="q2" vid="HOS 12:6">ప్రేమ, న్యాయం కలిగి ఉండాలి,</para>
  <para style="q2" vid="HOS 12:6">నీ దేవుని కోసం ఎల్లప్పుడు వేచి ఉండాలి.<verse eid="HOS 12:6" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="7" style="v" sid="HOS 12:7" />వ్యాపారి తప్పుడు తూకం వాడుతూ</para>
  <para style="q2" vid="HOS 12:7">మోసం చేయడానికి ఇష్టపడతాడు.<verse eid="HOS 12:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 12:8" />“నేను చాలా ధనవంతుడను;</para>
  <para style="q2" vid="HOS 12:8">నాకున్న ధనాన్ని బట్టి వారు నాలో</para>
  <para style="q1" vid="HOS 12:8">ఏ తప్పును కాని పాపాన్ని కాని చూపించలేరు” అని</para>
  <para style="q2" vid="HOS 12:8">ఎఫ్రాయిం అతిశయిస్తున్నాడు.<verse eid="HOS 12:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="HOS 12:9" />“మీరు ఈజిప్టు నుండి బయటకు వచ్చినప్పటి నుండి</para>
  <para style="q2" vid="HOS 12:9">యెహోవానైన నేను మీకు దేవునిగా ఉన్నాను;</para>
  <para style="q1" vid="HOS 12:9">మీ నియమించబడిన పండుగ రోజుల్లో ఉన్నట్లు</para>
  <para style="q2" vid="HOS 12:9">నేను మిమ్మల్ని మరలా గుడారాల్లో నివసింపజేస్తాను.<verse eid="HOS 12:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 12:10" />నేను ప్రవక్తలతో మాట్లాడాను.</para>
  <para style="q2" vid="HOS 12:10">వారికి అనేక దర్శనాలను ఇచ్చి</para>
  <para style="q2" vid="HOS 12:10">ఉపమానరీతిగా వారికి చెప్పాను.”<verse eid="HOS 12:10" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="11" style="v" sid="HOS 12:11" />గిలాదు చెడ్డదా?</para>
  <para style="q2" vid="HOS 12:11">దాని ప్రజలు వ్యర్థమైన వారు!</para>
  <para style="q1" vid="HOS 12:11">వారు గిల్గాలులో కోడెలను బలి అర్పిస్తున్నారా?</para>
  <para style="q2" vid="HOS 12:11">వారి బలిపీఠాలు దున్నబడిన పొలంలోని</para>
  <para style="q2" vid="HOS 12:11">రాళ్ల కుప్పల్లా ఉన్నాయి.<verse eid="HOS 12:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 12:12" />యాకోబు అరాము దేశానికి పారిపోయాడు;</para>
  <para style="q2" vid="HOS 12:12">ఇశ్రాయేలు భార్యను పొందడానికి సేవ చేశాడు,</para>
  <para style="q2" vid="HOS 12:12">భార్యను సంపాదించడానికి గొర్రెలు కాచాడు.<verse eid="HOS 12:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 12:13" />యెహోవా ఇశ్రాయేలీయులను ఈజిప్టు నుండి తీసుకురావడానికి ఒక ప్రవక్తను వాడుకున్నారు,</para>
  <para style="q2" vid="HOS 12:13">ప్రవక్త ద్వారా ఆయన వారిని సంరక్షించారు.<verse eid="HOS 12:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="HOS 12:14" />కాని ఎఫ్రాయిం ఆయన మహా కోపాన్ని రేపాడు</para>
  <para style="q2" vid="HOS 12:14">అతడు చేసిన రక్తపాతం బట్టి దేవుడు అతని మీద నేరం మోపుతారు</para>
  <para style="q2" vid="HOS 12:14">అతని ధిక్కారం బట్టి ఆయన అతనికి ప్రతీకారం చేస్తారు.<verse eid="HOS 12:14" /></para>
  <chapter eid="HOS 12" />
  <chapter number="13" style="c" sid="HOS 13" />
  <para style="s1">ఇశ్రాయేలుపై యెహోవా కోపం</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 13:1" />ఎఫ్రాయిం మాట్లాడినప్పుడు ప్రజలు వణికారు;</para>
  <para style="q2" vid="HOS 13:1">అతడు ఇశ్రాయేలులో ఘనపరచబడ్డాడు.</para>
  <para style="q2" vid="HOS 13:1">కాని అతడు బయలును పూజించి అపరాధిగా చనిపోయాడు.<verse eid="HOS 13:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 13:2" />ఇప్పుడు వారు మరి ఎక్కువ పాపం చేస్తున్నారు;</para>
  <para style="q2" vid="HOS 13:2">వారు వెండితో తమ కోసం విగ్రహాలను చేసుకుంటున్నారు,</para>
  <para style="q1" vid="HOS 13:2">అవి నైపుణ్యంతో చేయబడిన ప్రతిమలు,</para>
  <para style="q2" vid="HOS 13:2">అవన్నీ కళాకారుని చేతిపనులు.</para>
  <para style="q1" vid="HOS 13:2">ఈ ప్రజల గురించి ఇలా చెప్తారు,</para>
  <para style="q2" vid="HOS 13:2">“వారు నరబలులు అర్పిస్తారు!</para>
  <para style="q2" vid="HOS 13:2">దూడ విగ్రహాలను ముద్దు పెట్టుకుంటారు!”<verse eid="HOS 13:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 13:3" />కాబట్టి వారు ఉదయకాలపు పొగలా ఉంటారు,</para>
  <para style="q2" vid="HOS 13:3">ఉదయకాలపు మంచులా అదృశ్యం అవుతారు,</para>
  <para style="q2" vid="HOS 13:3">నూర్పిడి కళ్ళంలో నుండి గాలికి ఎగిరే పొట్టులా ఉంటారు,</para>
  <para style="q2" vid="HOS 13:3">కిటికీలో గుండా పోయే పొగలా అయిపోతారు.<verse eid="HOS 13:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HOS 13:4" />“మీరు ఈజిప్టు నుండి బయటకు వచ్చినప్పటి నుండి</para>
  <para style="q2" vid="HOS 13:4">యెహోవానైన నేను మీకు దేవునిగా ఉన్నాను;</para>
  <para style="q1" vid="HOS 13:4">మీరు నన్ను తప్ప మరే దేవున్ని అంగీకరించకూడదు,</para>
  <para style="q2" vid="HOS 13:4">నేను తప్ప రక్షకుడు ఎవరూ లేరు.<verse eid="HOS 13:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 13:5" />మీరు తీవ్రమైన వేడిగల అరణ్యంలో ఉన్నప్పుడు,</para>
  <para style="q2" vid="HOS 13:5">నేను మిమ్మల్ని సంరక్షించాను.<verse eid="HOS 13:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HOS 13:6" />నేను వారిని పోషించగా వారు తృప్తి చెందారు.</para>
  <para style="q2" vid="HOS 13:6">వారు తృప్తి చెందిన తర్వాత గర్వించి;</para>
  <para style="q2" vid="HOS 13:6">నన్ను మరచిపోయారు.<verse eid="HOS 13:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 13:7" />కాబట్టి నేను వారికి సింహంలా ఉంటాను,</para>
  <para style="q2" vid="HOS 13:7">చిరుతపులిలా దారిలో పొంచి ఉంటాను.<verse eid="HOS 13:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 13:8" />పిల్లలు పోయిన ఎలుగుబంటిలా,</para>
  <para style="q2" vid="HOS 13:8">నేను వారిపై పడి వారిని చీల్చివేస్తాను;</para>
  <para style="q1" vid="HOS 13:8">సింహంలా వారిని మ్రింగివేస్తాను,</para>
  <para style="q2" vid="HOS 13:8">అడవి మృగంలా వారిని చీల్చివేస్తాను.<verse eid="HOS 13:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="HOS 13:9" />“ఇశ్రాయేలూ! నీవు నాశనమవుతావు</para>
  <para style="q2" vid="HOS 13:9">ఎందుకంటే నీవు నీ సహాయకుడనైన నాకు విరుద్ధంగా ఉన్నావు.<verse eid="HOS 13:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HOS 13:10" />నిన్ను కాపాడగలిగే నీ రాజు ఎక్కడా?</para>
  <para style="q2" vid="HOS 13:10">మీ పట్టణాలన్నిటిలో ఉండే మీ అధిపతులు ఎక్కడా?</para>
  <para style="q1" vid="HOS 13:10">వారి గురించి నీవు, ‘నాకు రాజును అధిపతులను ఇవ్వండి’</para>
  <para style="q2" vid="HOS 13:10">అని నీవు అడిగావు కదా?<verse eid="HOS 13:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HOS 13:11" />కాబట్టి నేను కోపంలో నీకు రాజును ఇచ్చాను.</para>
  <para style="q2" vid="HOS 13:11">నా ఆగ్రహంతో అతన్ని తొలగించాను.<verse eid="HOS 13:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HOS 13:12" />ఎఫ్రాయిం అపరాధం పోగుచేయబడింది,</para>
  <para style="q2" vid="HOS 13:12">అతని పాపాలు వ్రాయబడ్డాయి.<verse eid="HOS 13:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="HOS 13:13" />ప్రసవ వేదనలాంటి శ్రమ అతనికి కలుగుతుంది,</para>
  <para style="q2" vid="HOS 13:13">కాన్పు సమయం వచ్చినప్పుడు కాని అతడు జ్ఞానంలేని శిశువుగా ఉన్నాడు;</para>
  <para style="q1" vid="HOS 13:13">గర్భం నుండి బయటకు రాని శిశువులా</para>
  <para style="q2" vid="HOS 13:13">అతడు జ్ఞానంలేనివానిగా ఉన్నాడు.<verse eid="HOS 13:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="HOS 13:14" />“నేను ఈ ప్రజలను పాతాళం శక్తి నుండి విడిపిస్తాను;</para>
  <para style="q2" vid="HOS 13:14">మరణం నుండి వారిని విమోచిస్తాను.</para>
  <para style="q1" vid="HOS 13:14">ఓ మరణమా, నీవు కలిగించే తెగుళ్ళు ఎక్కడ?</para>
  <para style="q2" vid="HOS 13:14">ఓ పాతాళమా, నీవు కలిగించే నాశనం ఎక్కడ?</para>
  <para style="b" vid="HOS 13:14" />
  <para style="q1" vid="HOS 13:14">“అతడు తన సోదరుల మధ్య ఎదుగుతున్నా సరే,<verse eid="HOS 13:14" /></para>
  <para style="q2">
    <verse number="15" style="v" sid="HOS 13:15" />నేను ఎఫ్రాయిం పట్ల దయ చూపించను.</para>
  <para style="q1" vid="HOS 13:15">యెహోవా నుండి తూర్పు గాలి వస్తుంది,</para>
  <para style="q2" vid="HOS 13:15">ఎడారి నుండి అది వీస్తుంది.</para>
  <para style="q1" vid="HOS 13:15">అతని నీటిబుగ్గ ఎండిపోతుంది</para>
  <para style="q2" vid="HOS 13:15">అతని బావి ఇంకిపోతుంది.</para>
  <para style="q2" vid="HOS 13:15">అతని ధననిధులు, ప్రియమైన వస్తువులు దోచుకోబడతాయి.<verse eid="HOS 13:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HOS 13:16" />సమరయ ప్రజలు తమ అపరాధాన్ని భరించాలి,</para>
  <para style="q2" vid="HOS 13:16">ఎందుకంటే వారు తమ దేవుని మీద తిరుగుబాటు చేశారు.</para>
  <para style="q1" vid="HOS 13:16">వారు ఖడ్గానికి కూలుతారు;</para>
  <para style="q2" vid="HOS 13:16">వారి చంటి పిల్లలు నేలకు కొట్టబడతారు,</para>
  <para style="q2" vid="HOS 13:16">వారి గర్భిణీల కడుపులు చీల్చబడతాయి.”<verse eid="HOS 13:16" /></para>
  <chapter eid="HOS 13" />
  <chapter number="14" style="c" sid="HOS 14" />
  <para style="s1">దీవెన రావాలంటే పశ్చాత్తాపపడాలి</para>
  <para style="q1">
    <verse number="1" style="v" sid="HOS 14:1" />ఇశ్రాయేలూ, నీ దేవుడైన యెహోవా దగ్గరకు మరలా రా!</para>
  <para style="q2" vid="HOS 14:1">నీ పాపాలను బట్టి నీవు పడిపోయావు!<verse eid="HOS 14:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="HOS 14:2" />మాటలు సిద్ధపరచుకొని</para>
  <para style="q2" vid="HOS 14:2">యెహోవా దగ్గరకు రా.</para>
  <para style="q1" vid="HOS 14:2">ఆయనతో ఇలా చెప్పు:</para>
  <para style="q2" vid="HOS 14:2">“మా పాపాలన్నీ క్షమించండి</para>
  <para style="q1" vid="HOS 14:2">మమ్మల్ని దయతో స్వీకరించండి,</para>
  <para style="q2" vid="HOS 14:2">కోడెలకు బదులుగా మేము మా పెదవులను అర్పిస్తాము.<verse eid="HOS 14:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="HOS 14:3" />అష్షూరు మమ్మల్ని రక్షించలేదు;</para>
  <para style="q2" vid="HOS 14:3">మేము యుద్ధ గుర్రాలను ఎక్కము.</para>
  <para style="q1" vid="HOS 14:3">మా చేతులు చేసిన వాటితో మేము,</para>
  <para style="q2" vid="HOS 14:3">‘మా దేవుళ్ళు’ అని ఇక ఎన్నడు చెప్పము,</para>
  <para style="q2" vid="HOS 14:3">ఎందుకంటే మీరు తండ్రిలేనివారికి దయ చూపుతారు.”<verse eid="HOS 14:3" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="4" style="v" sid="HOS 14:4" />“నేను వారి నమ్మకద్రోహాన్ని సరిచేస్తాను,</para>
  <para style="q2" vid="HOS 14:4">మనస్పూర్తిగా వారిని ప్రేమిస్తాను,</para>
  <para style="q2" vid="HOS 14:4">ఎందుకంటే వారి మీదున్న నా కోపం చల్లారింది.<verse eid="HOS 14:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="HOS 14:5" />నేను ఇశ్రాయేలుకు మంచులా ఉంటాను;</para>
  <para style="q2" vid="HOS 14:5">అతడు తామరలా వికసిస్తాడు.</para>
  <para style="q1" vid="HOS 14:5">లెబానోను దేవదారు చెట్టులా</para>
  <para style="q2" vid="HOS 14:5">అతని వేర్లు భూమి లోతుకు వెళ్తాయి;<verse eid="HOS 14:5" /></para>
  <para style="q2">
    <verse number="6" style="v" sid="HOS 14:6" />అతని చిగురు పెరుగుతుంది.</para>
  <para style="q1" vid="HOS 14:6">అతని వైభవం ఒలీవ చెట్టులా,</para>
  <para style="q2" vid="HOS 14:6">అతని సువాసన లెబానోను దేవదారులా ఉంటుంది.<verse eid="HOS 14:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HOS 14:7" />అతని నీడలో ప్రజలు నివసిస్తారు;</para>
  <para style="q2" vid="HOS 14:7">వారు ధాన్యంలా అభివృద్ధి చెందుతారు,</para>
  <para style="q1" vid="HOS 14:7">వారు ద్రాక్షలా వికసిస్తారు,</para>
  <para style="q2" vid="HOS 14:7">ఇశ్రాయేలు కీర్తి లెబానోను ద్రాక్షరసంలా ఉంటుంది.<verse eid="HOS 14:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HOS 14:8" />ఎఫ్రాయిమూ, ఇకనుండి విగ్రహాలతో నాకేం పని?</para>
  <para style="q2" vid="HOS 14:8">నేనే అతనికి జవాబిస్తాను, అతన్ని సంరక్షిస్తాను.</para>
  <para style="q1" vid="HOS 14:8">నేను పచ్చని సరళ వృక్షం వంటి వాన్ని;</para>
  <para style="q2" vid="HOS 14:8">నా వలనే నీకు ఫలం కలుగుతుంది.”<verse eid="HOS 14:8" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="9" style="v" sid="HOS 14:9" />జ్ఞానులెవరు? వారు ఈ విషయాలు గ్రహించాలి.</para>
  <para style="q2" vid="HOS 14:9">వివేచన గలవారెవరు? వారు కూడ గ్రహించాలి.</para>
  <para style="q1" vid="HOS 14:9">యెహోవా మార్గాలు సరియైనవి;</para>
  <para style="q2" vid="HOS 14:9">నీతిమంతులు వాటిలో నడుస్తారు,</para>
  <para style="q2" vid="HOS 14:9">కాని తిరుగుబాటుదారులు వాటిలో తొట్రిల్లుతారు.<verse eid="HOS 14:9" /></para>
  <chapter eid="HOS 14" />
</usx>