<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- Biblica® Open Telugu Contemporary Version</book>
  <para style="h">యాకోబు పత్రిక</para>
  <para style="toc1">యాకోబు వ్రాసిన పత్రిక</para>
  <para style="toc2">యాకోబు పత్రిక</para>
  <para style="toc3">యాకోబు</para>
  <para style="mt1">యాకోబు</para>
  <para style="mt2">వ్రాసిన పత్రిక</para>
  <chapter number="1" style="c" sid="JAS 1"/>
  <para style="po">
    <verse number="1" style="v" sid="JAS 1:1"/>దేవునికి, ప్రభువైన యేసు క్రీస్తుకు సేవకుడనైన యాకోబు,</para>
  <para style="po" vid="JAS 1:1">వివిధ దేశాలకు చెదిరిపోయిన పన్నెండు గోత్రాల వారికి వ్రాస్తున్నాను:</para>
  <para style="po" vid="JAS 1:1">మీకు శుభాలు.<verse eid="JAS 1:1"/></para>
  <para style="s1">శ్రమలు, శోధనలు</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2"/>నా సహోదరీ సహోదరులారా, మీ విశ్వాసానికి ఎదురయ్యే పరీక్షలవల్ల ఓర్పు వస్తుందని మీకు తెలుసు కాబట్టి, <verse eid="JAS 1:2"/><verse number="3" style="v" sid="JAS 1:3"/>మీకు ఎప్పుడైనా ఎలాంటి శోధనలు ఎదురైనా వాటిని బట్టి సంతోషించండి. <verse eid="JAS 1:3"/><verse number="4" style="v" sid="JAS 1:4"/>మీరు పరిణతి చెంది సంపూర్ణులై ఏ విషయంలో కొదువలేనివారై ఉండేలా పట్టుదల తన పనిని చేయనివ్వండి. <verse eid="JAS 1:4"/><verse number="5" style="v" sid="JAS 1:5"/>మీలో ఎవరికైనా జ్ఞానం కొరతగా ఉంటే దేవున్ని అడగాలి, ఆయన తప్పులను ఎంచకుండా అందరికి ధారాళంగా ఇస్తారు. <verse eid="JAS 1:5"/><verse number="6" style="v" sid="JAS 1:6"/>మీరు అడిగినప్పుడు సందేహించకుండా విశ్వాసంతో అడగండి ఎందుకంటే, సందేహించేవారు గాలికి రేగి ఎగసిపడే సముద్రపు అలల్లాంటివారు; <verse eid="JAS 1:6"/><verse number="7" style="v" sid="JAS 1:7"/>కాబట్టి వారు ప్రభువు నుండి తమకు ఏమైనా దొరుకుతుందని ఆశించకూడదు. <verse eid="JAS 1:7"/><verse number="8" style="v" sid="JAS 1:8"/>అలాంటివారు రెండు రకాల మనస్సులను కలిగి ఉంటారు, తాము చేసేవాటన్నిటిలో అస్థిరంగా ఉంటారు.<verse eid="JAS 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9"/>దీనస్థితిలో ఉన్న విశ్వాసులు తమకు కలిగిన ఉన్నత స్థితిని బట్టి అతిశయించాలి. <verse eid="JAS 1:9"/><verse number="10" style="v" sid="JAS 1:10"/>అయితే ధనవంతులైనవారు తమ దీనస్థితిని బట్టి అతిశయించాలి, ఎందుకంటే వారు గడ్డి పువ్వులా కనుమరుగవుతారు. <verse eid="JAS 1:10"/><verse number="11" style="v" sid="JAS 1:11"/>కాల్చివేసే వేడిమితో సూర్యుడు ఉదయించినప్పుడు గడ్డి వాడిపోతుంది; దాని పువ్వు రాలిపోతుంది, దాని అందం నశించిపోతుంది; ధనవంతుల పట్ల కూడా అలాగే జరుగుతుంది; తమ తీరికలేని జీవితం మధ్యలో వారు వాడిపోతారు.<verse eid="JAS 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12"/>శోధన సహించినవారు ధన్యులు. పరీక్షలో నిలబడినవారు ప్రభువు తాను ప్రేమించినవారికి ఇస్తానని వాగ్దానం చేసిన జీవకిరీటాన్ని పొందుతారు.<verse eid="JAS 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 1:13"/>దేవుడు కీడు చేత శోధించబడడు; ఆయన ఎవరిని శోధించడు కాబట్టి ఎవరికైనా శోధన ఎదురైతే, “నేను దేవుని చేత శోధించబడుతున్నాను” అని అనకూడదు. <verse eid="JAS 1:13"/><verse number="14" style="v" sid="JAS 1:14"/>ఒకరు తమ సొంత కోరికతోనే ఆకర్షించబడి వాటి ద్వారా ప్రలోభాలకు గురై శోధించబడతారు. <verse eid="JAS 1:14"/><verse number="15" style="v" sid="JAS 1:15"/>చెడు కోరిక గర్భాన్ని ధరించి పాపానికి జన్మనిస్తుంది, ఆ పాపం పండి మరణానికి జన్మనిస్తుంది.<verse eid="JAS 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16"/>నా ప్రియ సహోదరీ సహోదరులారా, మోసపోకండి. <verse eid="JAS 1:16"/><verse number="17" style="v" sid="JAS 1:17"/>పైనుండి వచ్చే ప్రతీ శ్రేష్ఠమైన సంపూర్ణమైన బహుమానం వెలుగును కలిగించిన తండ్రి దగ్గర నుండి క్రిందకు వస్తున్నాయి, ఆయన ఒకచోట నిలబడని నీడల్లా ఎన్నడు మారరు. <verse eid="JAS 1:17"/><verse number="18" style="v" sid="JAS 1:18"/>ఆయన సృష్టంతటిలో మనం మొదటి ఫలాలుగా ఉండాలని, సత్యవాక్యం చేత మనకు జన్మనివ్వడానికి ఎంచుకున్నారు.<verse eid="JAS 1:18"/></para>
  <para style="s1">వినుట ఆచరించుట</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19"/>నా ప్రియ సహోదరీ సహోదరులారా, మీరు దీనిని గ్రహించాలి: ప్రతి ఒక్కరు వినడానికి తొందరపడాలి, మాట్లాడడానికి నిదానించాలి, అలాగే తొందరపడి కోపపడవద్దు; <verse eid="JAS 1:19"/><verse number="20" style="v" sid="JAS 1:20"/>ఎందుకంటే మీ కోపం దేవుని నీతిని జరిగించదు. <verse eid="JAS 1:20"/><verse number="21" style="v" sid="JAS 1:21"/>కాబట్టి మీ జీవితాల్లోని సమస్త మలినాన్ని చెడును వదిలిపెట్టి, దేవుడు మీ హృదయాల్లో నాటిన వాక్యాన్ని వినయంతో అంగీకరించండి, ఎందుకంటే మీ ఆత్మలను రక్షించే శక్తి దానికే ఉంది.<verse eid="JAS 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22"/>మీరు వాక్యాన్ని వినేవారిగా మాత్రమే ఉండి మిమ్మల్ని మీరు మోసం చేసుకోకండి. వాక్యం చెప్పేది చేయండి. <verse eid="JAS 1:22"/><verse number="23" style="v" sid="JAS 1:23"/>ఎవరైతే వాక్యాన్ని విని అది చెప్పిన ప్రకారం చేయరో, వారు తమ ముఖాన్ని అద్దంలో చూసుకునే వారిలా ఉంటారు; <verse eid="JAS 1:23"/><verse number="24" style="v" sid="JAS 1:24"/>వారు తమను చూసుకొని ప్రక్కకు వెళ్లిన వెంటనే తాము ఎలా ఉన్నారో మరచిపోతారు. <verse eid="JAS 1:24"/><verse number="25" style="v" sid="JAS 1:25"/>అయితే స్వాతంత్ర్యాన్ని ఇచ్చే సంపూర్ణమైన ధర్మశాస్త్రంలోనికి పరిశీలనగా చూసి దానిలో కొనసాగేవారు, విని మరచేవారిగా ఉండకుండా అది చెప్పిన ప్రకారం చేస్తారు; వారు తాము చేసిన దానిలో దీవించబడతారు.<verse eid="JAS 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26"/>తాము భక్తిపరులమని భావిస్తూ తమ నాలుకను అదుపులో పెట్టుకోనివారు తమ హృదయాలను తామే మోసం చేసుకుంటారు. అలాంటివారి భక్తి విలువలేనిది. <verse eid="JAS 1:26"/><verse number="27" style="v" sid="JAS 1:27"/>తండ్రియైన దేవుని దృష్టిలో పవిత్రమైన నిష్కళంకమైన ధర్మం ఏంటంటే: అనాధలను, ఇబ్బందుల్లో ఉన్న విధవరాండ్రను సంరక్షించడం, లోక మాలిన్యం అంటకుండా తమను కాపాడుకోవడము.<verse eid="JAS 1:27"/></para>
  <chapter eid="JAS 1"/>
  <chapter number="2" style="c" sid="JAS 2"/>
  <para style="s1">పక్షపాతం చూపకూడదు</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1"/>నా సహోదరీ సహోదరులారా, మహిమగల మన ప్రభువైన యేసు క్రీస్తులో విశ్వాసం గలవారిగా పక్షపాతం చూపకండి. <verse eid="JAS 2:1"/><verse number="2" style="v" sid="JAS 2:2"/>బంగారు ఉంగరాలు, విలువైన బట్టలు వేసుకున్న ధనవంతుడు, అలాగే మురికిబట్టలు వేసుకున్న పేదవాడు మీ సంఘానికి వచ్చినప్పుడు, <verse eid="JAS 2:2"/><verse number="3" style="v" sid="JAS 2:3"/>విలువైన బట్టలు వేసుకున్న ధనవంతుడిని ప్రత్యేకంగా గమనించి, “దయచేసి ఇక్కడ కూర్చోండి” అని చెప్పి, పేదవానితో “అక్కడ నిలబడు” అని “నా కాళ్ల దగ్గర కూర్చో” అని చెబితే, <verse eid="JAS 2:3"/><verse number="4" style="v" sid="JAS 2:4"/>మీరు వ్యత్యాసాలు చూపిస్తూ దుర్మార్గపు ఆలోచనలతో విమర్శించినవారు అవుతారు కదా?<verse eid="JAS 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5"/>నా ప్రియమైన సహోదరి సహోదరులారా, వినండి. దేవుడు తనను ప్రేమించినవారికి వాగ్దానం చేసిన ప్రకారం విశ్వాసంలో ధనవంతులుగా ఉండడానికి, తన రాజ్యానికి వారసులుగా ఉండడానికి ఈ లోకంలో పేదవారిని దేవుడు ఎంచుకోలేదా? <verse eid="JAS 2:5"/><verse number="6" style="v" sid="JAS 2:6"/>అయితే మీరు పేదవారిని అవమానించారు. మీకు అన్యాయం చేసింది ధనవంతులు కాదా? మిమ్మల్ని న్యాయస్థానానికి లాగింది వారు కాదా? <verse eid="JAS 2:6"/><verse number="7" style="v" sid="JAS 2:7"/>మిమ్మల్ని పిలిచిన దేవుని ఘనమైన నామాన్ని దూషించింది వాళ్ళు కాదా?<verse eid="JAS 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8"/>“మీలా మీ పొరుగువారిని ప్రేమించాలి”<note caller="+" style="f"><char style="fr" closed="false">2:8 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 19:18">లేవీ 19:18</ref></char></char></note> అని లేఖనాల్లో వ్రాసి ఉన్న ప్రాముఖ్యమైన ఆజ్ఞను మీ ప్రవర్తన సరిగా ఉన్నట్లే. <verse eid="JAS 2:8"/><verse number="9" style="v" sid="JAS 2:9"/>అయితే మీరు పక్షపాతం చూపిస్తే ధర్మశాస్త్రాన్ని బట్టి మీరు అపరాధులుగా నిర్ధారించబడి పాపం చేసినవారవుతారు. <verse eid="JAS 2:9"/><verse number="10" style="v" sid="JAS 2:10"/>ఎవరైనా ధర్మశాస్త్రంలోని అన్ని ఆజ్ఞలను పాటించి ఒకే ఒక్క ఆజ్ఞ విషయంలో తప్పిపోయినప్పటికి వారు అన్ని ఆజ్ఞల విషయంలో అపరాధులు అవుతారు. <verse eid="JAS 2:10"/><verse number="11" style="v" sid="JAS 2:11"/>“వ్యభిచారం చేయకూడదు,”<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:14">నిర్గమ 20:14</ref>; <ref loc="DEU 5:18">ద్వితీ 5:18</ref></char></char></note> అని చెప్పిన దేవుడు, “మీరు హత్య చేయకూడదు”<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:13">నిర్గమ 20:13</ref>; <ref loc="DEU 5:17">ద్వితీ 5:17</ref></char></char></note> అని కూడా చెప్పారు. నీవు వ్యభిచారం చేయకపోయినా నరహత్య చేస్తే, దేవుని ధర్మశాస్త్రాన్ని మీరినట్టే.<verse eid="JAS 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 2:12"/>కాబట్టి మీరు స్వాతంత్ర్యాన్ని ఇచ్చే ధర్మశాస్త్రం ప్రకారం తీర్పు పొందబోయే వానిలా మాట్లాడాలి, అలాగే ప్రవర్తించాలి. <verse eid="JAS 2:12"/><verse number="13" style="v" sid="JAS 2:13"/>ఎందుకంటే దయచూపించనివారి మీద దయ చూపక తీర్పు తీర్చబడుతుంది; దయ తీర్పుపై జయం పొందుతుంది.<verse eid="JAS 2:13"/></para>
  <para style="s1">విశ్వాసం, క్రియలు</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14"/>నా సహోదరీ సహోదరులారా, క్రియలు లేకుండా ఎవరైనా మాకు విశ్వాసం ఉందని చెప్తే ఏం ప్రయోజనం? ఆ విశ్వాసం మిమ్మల్ని రక్షిస్తుందా? <verse eid="JAS 2:14"/><verse number="15-16" style="v" sid="JAS 2:15-16"/>ఒక సహోదరునికి గాని సహోదరికి గాని వేసుకోవడానికి బట్టలు తినడానికి తిండి లేనప్పుడు మీరు వారి శరీరాలకు అవసరమైనవి ఇవ్వకుండ వారితో, “సమాధానంతో వెళ్లి చలి కాచుకుని, తృప్తిగా తిను” అని చెప్తే ఏం ప్రయోజనం? <verse eid="JAS 2:15-16"/><verse number="17" style="v" sid="JAS 2:17"/>అలాగే క్రియలు లేకపోతే ఆ విశ్వాసం దానికదే మరణిస్తుంది.<verse eid="JAS 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18"/>అయితే ఎవరైనా, “నీకు విశ్వాసం ఉంది, నాకు క్రియలు ఉన్నాయి.”</para>
  <para style="p" vid="JAS 2:18">క్రియలు లేకుండా మీ విశ్వాసాన్ని నాకు చూపించు, నా క్రియల ద్వారా నా విశ్వాసాన్ని నీకు చూపిస్తానని చెప్పవచ్చు. <verse eid="JAS 2:18"/><verse number="19" style="v" sid="JAS 2:19"/>దేవుడు ఒక్కడే అని నీవు నమ్ముతున్నావు అది మంచిదే. దయ్యాలు కూడా నమ్మి వణుకుతాయి.<verse eid="JAS 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JAS 2:20"/>వివేకంలేనివాడా, క్రియలు లేని విశ్వాసం వ్యర్థమని<note caller="+" style="f"><char style="fr" closed="false">2:20 </char><char style="ft" closed="false">కొ.ప్రా.ప్ర.లలో </char><char style="fqa" closed="false">మృతము</char></note> నీకు రుజువులు కావాలా? <verse eid="JAS 2:20"/><verse number="21" style="v" sid="JAS 2:21"/>మన పితరుడైన అబ్రాహాము తన కుమారుడైన ఇస్సాకును బలిపీఠంపై అర్పించినప్పుడు తాను చేసిన దాన్ని బట్టి నీతిమంతుడని చెప్పబడలేదా? <verse eid="JAS 2:21"/><verse number="22" style="v" sid="JAS 2:22"/>అతని క్రియలు అతని విశ్వాసం కలిసి పని చేశాయి. అతడు చేసిన దాన్ని బట్టి అతని విశ్వాసం సంపూర్ణం అయ్యింది. <verse eid="JAS 2:22"/><verse number="23" style="v" sid="JAS 2:23"/>నెరవేరబడిన లేఖనాలు ఏమి చెప్తున్నాయంటే, “అబ్రాహాము దేవుని నమ్మాడు, అది అతనికి నీతిగా ఎంచబడింది”<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 15:6">ఆది 15:6</ref></char></char></note> అనే లేఖనం నెరవేరింది. అలాగే అబ్రాహాము దేవుని స్నేహితుడని పిలువబడ్డాడు. <verse eid="JAS 2:23"/><verse number="24" style="v" sid="JAS 2:24"/>ఒక వ్యక్తి కేవలం విశ్వాసం ద్వారా మాత్రమే కాకుండా అతని క్రియలనుబట్టి నీతిమంతునిగా పరిగణించడం మీరు చూశారు.<verse eid="JAS 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25"/>అలాగే వేశ్యయైన రాహాబు<note caller="+" style="f"><char style="fr" closed="false">2:25 </char><char style="ft" closed="false"><char style="xt">యెహో 2:1-21</char></char></note> దూతలను ఆదరించి, వేరొక మార్గం గుండా వారిని పంపివేసినప్పుడు తాను చేసిన క్రియలనుబట్టి ఆమె నీతిమంతురాలిగా చెప్పబడలేదా? <verse eid="JAS 2:25"/><verse number="26" style="v" sid="JAS 2:26"/>ప్రాణం లేని శరీరం మరణించినట్లే క్రియలు లేని విశ్వాసం కూడా మరణిస్తుంది.<verse eid="JAS 2:26"/></para>
  <chapter eid="JAS 2"/>
  <chapter number="3" style="c" sid="JAS 3"/>
  <para style="s1">నాలుకను అదుపుచేయడం</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1"/>నా సహోదరీ సహోదరులారా, బోధకులమైన మనం అత్యంత కఠినంగా తీర్పు తీర్చబడతామని మీకు తెలుసు కాబట్టి మీలో అనేకమంది బోధకులుగా మారకండి. <verse eid="JAS 3:1"/><verse number="2" style="v" sid="JAS 3:2"/>మనమందరం అనేక విషయాల్లో తడబడతాము. మాట్లాడంలో తప్పులు చేయనివారు పరిపూర్ణులై శరీరమంతటిని ఒక కళ్లెంతో అదుపులో ఉంచుకోగల శక్తిని కలిగి ఉంటారు.<verse eid="JAS 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JAS 3:3"/>మనం గుర్రాలను లోబరచుకోవడానికి వాటి నోటికి కళ్లెం వేసి దాని ఆధారంగా వాటి శరీరమంతటిని త్రిప్పుతాము. <verse eid="JAS 3:3"/><verse number="4" style="v" sid="JAS 3:4"/>ఓడలను చూడండి; చాలా పెద్దగా ఉంటాయి, అవి బలమైన గాలికి కొట్టుకొనిపోతున్నా దానిని నడిపేవాని ఇష్ట ప్రకారం చాలా చిన్నగా ఉండే చుక్కాని సహాయంతో త్రిప్పబడుతుంది. <verse eid="JAS 3:4"/><verse number="5" style="v" sid="JAS 3:5"/>అలాగే నాలుక చిన్న అవయవమే కానీ అది అధికంగా ప్రగల్భాలు పలుకుతుంది. చిన్న నిప్పురవ్వ వల్ల ఎంతో పెద్ద అడవి కాల్చివేయబడుతుంది. <verse eid="JAS 3:5"/><verse number="6" style="v" sid="JAS 3:6"/>కాబట్టి నాలుక అగ్నిలాంటిది. నాలుక ఒక పాపాల పుట్టగా మన అవయవాల మధ్య ఉంచబడింది; అది శరీరమంతటిని పాడుచేస్తుంది, ప్రకృతి చక్రంలో చిచ్చు పెడుతుంది; నరకాగ్ని చేత దానికదే కాలిపోతుంది.<verse eid="JAS 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 3:7"/>మృగాలను, పక్షులను, ప్రాకే ప్రాణులను, సముద్రపు జీవులను మానవజాతి అదుపుచేస్తుంది, అదుపుచేసింది. <verse eid="JAS 3:7"/><verse number="8" style="v" sid="JAS 3:8"/>కాని నిరంతరం చెడుచేస్తూ, మరణకరమైన విషంతో నిండిన నాలుకను ఎవరూ అదుపుచేయలేరు.<verse eid="JAS 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 3:9"/>ఆ నాలుకతోనే తండ్రియైన దేవుని స్తుతిస్తాం, ఆ నాలుకతోనే దేవుని పోలికతో చేయబడిన వారిని శపిస్తాము. <verse eid="JAS 3:9"/><verse number="10" style="v" sid="JAS 3:10"/>ఒకే నోటి నుండి స్తుతి శాపాలు వస్తున్నాయి. నా సహోదరీ సహోదరులారా, మనం అలా ఉండకూడదు. <verse eid="JAS 3:10"/><verse number="11" style="v" sid="JAS 3:11"/>ఒక నీటి ఊటలో ఒకే చోట నుండి మంచినీరు ఉప్పునీరు వస్తాయా? <verse eid="JAS 3:11"/><verse number="12" style="v" sid="JAS 3:12"/>నా సహోదరీ సహోదరులారా, అంజూర చెట్టుకు ఒలీవల పండ్లు, ద్రాక్షతీగెలకు అంజూర పండ్లు కాస్తాయా? అదే విధంగా ఉప్పునీటి ఊట నుండి మంచినీరు రావు.<verse eid="JAS 3:12"/></para>
  <para style="s1">రెండు రకాల జ్ఞానం</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13"/>మీలో జ్ఞానం, గ్రహింపు కలవారు ఎవరు? జ్ఞానం వలన వచ్చిన సహనంతో మీ క్రియలను మీ మంచి ప్రవర్తన ద్వారా చూపించాలి. <verse eid="JAS 3:13"/><verse number="14" style="v" sid="JAS 3:14"/>అయితే మీ హృదయాల్లో తీవ్రమైన అసూయ, స్వార్థపూరితమైన దురాశలు ఉన్నప్పుడు గొప్పలు చెప్పుకోవద్దు, సత్యాన్ని తృణీకరించవద్దు. <verse eid="JAS 3:14"/><verse number="15" style="v" sid="JAS 3:15"/>అలాంటి జ్ఞానం పరలోక నుండి దిగివచ్చింది కాదు ఈ లోక సంబంధమైంది, ఆత్మ సంబంధమైంది కాదు దయ్యాలకు సంబంధించిన జ్ఞానము. <verse eid="JAS 3:15"/><verse number="16" style="v" sid="JAS 3:16"/>ఎక్కడైతే అసూయ స్వార్థపూరితమైన దురాశలు ఉంటాయో అక్కడ ప్రతి విధమైన అక్రమాలు దుర్మార్గాలు ఉంటాయి.<verse eid="JAS 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 3:17"/>పైనుండి వచ్చిన జ్ఞానం మొదట స్వచ్ఛంగా ఉంటుంది, తర్వాత శాంతికరంగా, సహనంతో, లోబడేదానిగా, దయతో నిండుకొని మంచి ఫలాలను కలిగి, పక్షపాతం కాని మోసం కాని లేనిదై ఉంటుంది. <verse eid="JAS 3:17"/><verse number="18" style="v" sid="JAS 3:18"/>శాంతిలో విత్తిన శాంతిని కలుగజేసినవారు నీతి అనే పంట కోస్తారు.<verse eid="JAS 3:18"/></para>
  <chapter eid="JAS 3"/>
  <chapter number="4" style="c" sid="JAS 4"/>
  <para style="s1">మిమ్మల్ని మీరు దేవునికి సమర్పించుకోండి</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1"/>మీ మధ్యలో ఉన్న తగాదాలు, గొడవలు ఎక్కడ నుండి వచ్చాయి? మీలో పోరాడుతున్న దురాశల నుండి వచ్చినవే కదా? <verse eid="JAS 4:1"/><verse number="2" style="v" sid="JAS 4:2"/>మీరు కోరుకున్నదానిని పొందలేదు కాబట్టి మీరు హత్య చేస్తారు. మీరు ఆశపడిన దానిని సంపాదించుకోలేదు కాబట్టి మీరు పోరాటాలు, గొడవలు చేస్తారు. మీరు దేవుని అడగలేదు కాబట్టి మీరు పొందలేదు. <verse eid="JAS 4:2"/><verse number="3" style="v" sid="JAS 4:3"/>మీరు అడిగినప్పుడు మీ సంతోషాల కోసం ఉపయోగించుకోవాలనే దురుద్ధేశ్యంతో అడుగుతారు కాబట్టి మీకు ఏమి దొరకదు.<verse eid="JAS 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JAS 4:4"/>వ్యభిచారులారా!<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">అవిశ్వాస ఒడంబడికకు సూచన, <char style="xt"><ref loc="HOS 3:1">హోషేయ 3:1</ref></char></char></note> ఈ లోకంతో స్నేహం చేయడమంటే దేవునితో విరోధం పెట్టుకోవడమేనని మీకు తెలియదా? కాబట్టి ఈ లోకంతో స్నేహం చేసిన ప్రతివారు దేవునికి విరోధులుగా మారతారు. <verse eid="JAS 4:4"/><verse number="5" style="v" sid="JAS 4:5"/>లేదా, “దేవుడు మనలో నివసింపచేసిన ఆత్మ కోసం ఆయన ఆరాటపడుతున్నారని” లేఖనం చెప్పడం అనవసరం అని అనుకుంటున్నారా?<note caller="+" style="f"><char style="fr" closed="false">4:5 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">ఆయన మనలో నివసింపచేసిన ఆత్మ తీవ్రంగా అసూయపడుచున్నాడు.</char></note> <verse eid="JAS 4:5"/><verse number="6" style="v" sid="JAS 4:6"/>అయితే ఆయన అందరికి ఎక్కువ కృపను ఇస్తారు కాబట్టి,</para>
  <para style="q1" vid="JAS 4:6">“దేవుడు గర్విష్ఠులను వ్యతిరేకిస్తారు కాని,</para>
  <para style="q2" vid="JAS 4:6">దీనులకు దయ చూపిస్తారు”<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false"><char style="xt"><ref loc="PRO 3:34">సామెత 3:34</ref></char></char></note></para>
  <para style="m" vid="JAS 4:6">అని లేఖనం చెప్తుంది.<verse eid="JAS 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7"/>కాబట్టి మీరు దేవునికి లోబడి ఉండండి. అపవాదిని ఎదిరించండి, అప్పుడు వాడు మీ నుండి పారిపోతాడు. <verse eid="JAS 4:7"/><verse number="8" style="v" sid="JAS 4:8"/>దేవునికి దగ్గరగా రండి అప్పుడు ఆయన మీకు దగ్గరగా వస్తారు. పాపులారా, మీ చేతులను కడుక్కోండి. రెండు మనస్సులు కలవారలారా, మీ హృదయాలను శుద్ధి చేసుకోండి. <verse eid="JAS 4:8"/><verse number="9" style="v" sid="JAS 4:9"/>విచారపడుతూ దుఃఖిస్తూ కన్నీరు కార్చండి. మీ నవ్వును దుఃఖంగా, మీ సంతోషాన్ని విచారంగా మార్చుకోండి. <verse eid="JAS 4:9"/><verse number="10" style="v" sid="JAS 4:10"/>ప్రభువు ఎదుట మిమ్మల్ని మీరు తగ్గించుకోండి. అప్పుడు ఆయన మిమ్మల్ని హెచ్చిస్తారు.<verse eid="JAS 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11"/>నా సహోదరీ సహోదరులారా, ఒకరి గురించి ఒకరు చెడుగా మాట్లాడవద్దు. ఇతరుల గురించి చెడుగా మాట్లాడేవారు లేదా ఇతరులకు తీర్పు తీర్చేవారు ధర్మశాస్త్రానికి వ్యతిరేకంగా మాట్లాడతారు, ధర్మశాస్త్రానికి తీర్పు తీరుస్తారు. మీరు ధర్మశాస్త్రానికి తీర్పుతీర్చితే అప్పుడు మీరు ధర్మశాస్త్రాన్ని పాటించేవారిగా కాకుండా న్యాయాధికారిగా ఉన్నారని అర్థము. <verse eid="JAS 4:11"/><verse number="12" style="v" sid="JAS 4:12"/>ధర్మశాస్త్రాన్ని ఇచ్చినవారు న్యాయాధికారి ఒక్కరే, ఆయన రక్షించగలరు నాశనం చేయగలరు. కాబట్టి మీ పొరుగువారికి తీర్పు తీర్చడానికి మీరు ఎవరు?<verse eid="JAS 4:12"/></para>
  <para style="s1">రేపటి గురించి గొప్పలు చెప్పుకోవడం</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13"/>“ఈ రోజైనా లేక రేపైనా ఏదో ఒక పట్టణానికి వెళ్లి అక్కడ ఒక సంవత్సరం ఉండి వ్యాపారం చేసి డబ్బు సంపాదించుకుందాం” అని చెప్పేవారలారా రండి. <verse eid="JAS 4:13"/><verse number="14" style="v" sid="JAS 4:14"/>రేపు ఏమి జరుగుతుందో మీకు తెలియదు. మీ జీవితం ఏపాటిది? కొంతసేపు కనిపించి అంతలోనే మాయమైపోయే ఆవిరివంటిది. <verse eid="JAS 4:14"/><verse number="15" style="v" sid="JAS 4:15"/>కాబట్టి, “ప్రభువు చిత్తమైతే మనం జీవించి ఇది చేద్దాం అది చేద్దాం” అని మీరు చెప్పాలి. <verse eid="JAS 4:15"/><verse number="16" style="v" sid="JAS 4:16"/>కాని మీరు అహంకారంతో గొప్పలు చెప్పుకుంటున్నారు. ఆ విధంగా గొప్పలు చెప్పుకోవడం చాలా చెడ్డది. <verse eid="JAS 4:16"/><verse number="17" style="v" sid="JAS 4:17"/>కాబట్టి చేయవలసిన మంచి వాటి గురించి తెలిసి దాన్ని చేయడంలో విఫలమైతే వారు పాపం చేసినవారు అవుతారు.<verse eid="JAS 4:17"/></para>
  <chapter eid="JAS 4"/>
  <chapter number="5" style="c" sid="JAS 5"/>
  <para style="s1">హింసించే ధనవంతులకు హెచ్చరిక</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1"/>ధనవంతులారా రండి, మీపైకి రాబోతున్న దురవస్థలను బట్టి దుఃఖించి ఏడవండి. <verse eid="JAS 5:1"/><verse number="2" style="v" sid="JAS 5:2"/>మీ ధనం పాడైపోతుంది, మీ వస్త్రాలను చిమ్మటలు తినివేస్తాయి. <verse eid="JAS 5:2"/><verse number="3" style="v" sid="JAS 5:3"/>మీ బంగారము వెండి తుప్పుపడతాయి; వాటి తుప్పు మీకు వ్యతిరేక సాక్ష్యంగా ఉండి అగ్నిలా మీ శరీరాన్ని తింటుంది. మీరు చివరిరోజుల కోసం ధనాన్ని కూడబెట్టారు. <verse eid="JAS 5:3"/><verse number="4" style="v" sid="JAS 5:4"/>చూడండి మీ పొలాలను కోసిన పనివారికి ఇవ్వకుండా మోసంతో మీరు దాచిపెట్టిన వారి జీతాలు మొరపెట్టాయి. కోతపనివారి మొరలు సర్వశక్తిమంతుడైన ప్రభుని చెవులకు చేరాయి. <verse eid="JAS 5:4"/><verse number="5" style="v" sid="JAS 5:5"/>మీరు భూమిపై విలాసవంతంగా సుఖంగా జీవించారు; సంహార దినాన<note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="ft" closed="false">లేదా </char><char style="fqa" closed="false">విందు దినాన</char></note> మీ హృదయాలను మిమ్మల్ని మీరు పోషించుకున్నారు. <verse eid="JAS 5:5"/><verse number="6" style="v" sid="JAS 5:6"/>మిమ్మల్ని ఎదిరించలేని నీతిమంతులను మీరు శిక్షించి వారిని హత్య చేశారు.<verse eid="JAS 5:6"/></para>
  <para style="s1">శ్రమలలో ఓర్పు</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7"/>కాబట్టి సహోదరీ సహోదరులారా, ప్రభువు వచ్చేవరకు ఓపికతో ఉండండి. రైతు భూమి నుండి విలువైన పంటను పొందడానికి తొలకరి వాన చివరి వానలు పడేవరకు ఓపికతో ఎదురుచూస్తాడు. <verse eid="JAS 5:7"/><verse number="8" style="v" sid="JAS 5:8"/>మీరు కూడా ఓపిక కలిగి ఉండండి. ప్రభువు రాకడ దగ్గరలో ఉన్నది కాబట్టి మీ హృదయాలను బలపరచుకోండి. <verse eid="JAS 5:8"/><verse number="9" style="v" sid="JAS 5:9"/>సహోదరీ సహోదరులారా, మీరు తీర్పు తీర్చబడకుండా ఉండడానికి ఒకరిపై ఒకరు సణుగుకోవద్దు. చూడండి, న్యాయాధిపతి తలుపు దగ్గరే నిలబడి ఉన్నాడు!<verse eid="JAS 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JAS 5:10"/>సహోదరీ సహోదరులారా, మన ప్రభువు నామంలో మాట్లాడిన ప్రవక్తలను శ్రమలకు ఓపికకు మాదిరిగా తీసుకోండి. <verse eid="JAS 5:10"/><verse number="11" style="v" sid="JAS 5:11"/>సహనాన్ని చూపినవారిని ధన్యులు అని పిలుస్తాము. యోబుకు గల సహనం గురించి మీకు తెలుసు. చివరకు ప్రభువు అతనికి చేసిన దాన్ని చూసి ప్రభువు ఎంతో జాలి దయ గలవారని మీరు తెలుసుకున్నారు.<verse eid="JAS 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12"/>అన్నిటికి మించి, నా సహోదరీ సహోదరులారా, ఆకాశంతోడని గాని భూమితోడని గాని లేదా ఇంకా దేనిపైనైనా గాని ప్రమాణం చేయవద్దు. మీరు, అవునంటే “అవును” కాదంటే “కాదు” అని లేకపోతే మీరు శిక్షించబడతారు.<verse eid="JAS 5:12"/></para>
  <para style="s1">విశ్వాసంతో ప్రార్థన</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13"/>మీలో ఎవరైనా శ్రమలు అనుభవిస్తున్నారా? అయితే వారు ప్రార్థించాలి. ఎవరైనా సంతోషంగా ఉన్నారా? అయితే వారు స్తుతి గీతాలను పాడాలి. <verse eid="JAS 5:13"/><verse number="14" style="v" sid="JAS 5:14"/>మీలో ఎవరైనా అనారోగ్యంతో ఉన్నారా? అయితే వారు సంఘ పెద్దలను పిలిపించాలి. ఆ పెద్దలు ప్రభువు పేరిట వారికి నూనె రాసి వారి కోసం ప్రార్థన చేయాలి. <verse eid="JAS 5:14"/><verse number="15" style="v" sid="JAS 5:15"/>విశ్వాసంతో చేసిన ప్రార్థన రోగులను బాగుచేస్తుంది. ప్రభువు వారిని లేపుతారు; ఎవరైనా పాపం చేస్తే వారి పాపాలు క్షమించబడతాయి. <verse eid="JAS 5:15"/><verse number="16" style="v" sid="JAS 5:16"/>కాబట్టి మీ పాపాలను ఒకరితో ఒకరు ఒప్పుకుని మీరు స్వస్థత పొందేలా ఒకరి కోసం ఒకరు ప్రార్థన చేయండి. నీతిమంతుని ప్రార్థన శక్తివంతమైనది, ఫలవంతమైనది.<verse eid="JAS 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 5:17"/>ఏలీయా మనవంటి మనుష్యుడే; కాని అతడు వర్షం పడకూడదని మనఃపూర్వకంగా ప్రార్థన చేయగా మూడున్నర సంవత్సరాలు భూమిపై వర్షం పడలేదు. <verse eid="JAS 5:17"/><verse number="18" style="v" sid="JAS 5:18"/>అతడు మళ్ళీ ప్రార్థన చేసినప్పుడు ఆకాశం నుండి వర్షం కురిసింది, భూమి తన పంటను ఇచ్చింది.<verse eid="JAS 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19"/>నా సహోదరీ సహోదరులారా, మీలో ఎవరైనా సత్యం నుండి తొలగిపోతే ఎవరో ఒకరు వారిని తిరిగి వెనుకకు తీసుకువస్తే, <verse eid="JAS 5:19"/><verse number="20" style="v" sid="JAS 5:20"/>తప్పిపోయిన ఆ ఒక్క పాపిని తిరిగి వెనుకకు తీసుకువచ్చినవారు ఆ పాపి ఆత్మను మరణం నుండి రక్షించారని, అనేక పాపాలు కప్పివేయబడ్డాయని మీరు తెలుసుకోండి.<verse eid="JAS 5:20"/></para>
  <chapter eid="JAS 5"/>
</usx>
