<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Gaˈanda</book>
  <para style="h">Matiyu</para>
  <para style="toc3">Mat</para>
  <para style="toc2">Matiyu</para>
  <para style="toc1">Kwastǝ ndikta tǝmɗi Matiyu</para>
  <para style="mt1">Mat</para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">Kwathl Yesu Kǝristi</para>
  <para style="r">(<ref loc="LUK 3:23-38">Luk 3:23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />Thleya nech kǝ thlǝm kaakech Yesu Kǝristi. Yesu Kǝristi waˈi Dauda, Dauda thlaˈtǝ kwathl Ibrahim.<verse eid="MAT 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2" />Ibrahim nggǝtchǝ Ishaku,</para>
  <para style="li" vid="MAT 1:2">Ishaku nggǝtchǝ Yakub.</para>
  <para style="li" vid="MAT 1:2">Yakub nggǝtchǝ Yahuda tǝ wanmanchaˈan.<verse eid="MAT 1:2" /></para>
  <para style="li">
    <verse number="3" style="v" sid="MAT 1:3" />Yahuda paɗ nggǝtchǝ Feresa tǝ wanmanan Zera. Mananndǝ thlǝ ˈya fee wa Tamar.</para>
  <para style="li" vid="MAT 1:3">Feresa nggǝtchǝ Hesruna,</para>
  <para style="li" vid="MAT 1:3">Hesruna nggǝtchǝ Aram.<verse eid="MAT 1:3" /></para>
  <para style="li">
    <verse number="4" style="v" sid="MAT 1:4" />Aram nggǝtchǝ Aminadab. Aminadab nggǝtchǝ Nashan, Nashan nggǝtchǝ Salmon. <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />Salmon nggǝtchǝ Boˈaza, manan thla thlǝ ˈyafee wa Rahab. Boˈaza nggǝtchǝ Obida. Manan Ruth, Obida nggǝtchǝ Jesse. <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" />Jesse nggǝtchǝ kwitira Dauda. Dauda nggǝtchǝ solomon, tǝmɗi nu Uriah. <verse eid="MAT 1:6" /><verse number="7" style="v" sid="MAT 1:7" />Solomon nggǝtchǝ Rehobowam. Rehobowam nggǝtchǝ Abija, Abija nggǝtchǝ Asa. <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />Asa nggǝtchǝ Jehoshafat, Jehoshafat nggǝtchǝ Yoram, Yoram nggǝtchǝ Uziya. <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />Uziya nggǝtchǝ Jotam, Jotam nggǝtchǝ Ahaz, Ahaz nggǝtchǝ Hezekiya. <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />Hezekiya nggǝtchǝ Manassa, Manassa nggǝtchǝ Amon, Amon nggǝtchǝ Josiya. <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />Josiya nggǝtchǝ Jekoniya tǝ wanmanchaˈan, ǝ fartǝɗi harandǝ fee tandǝ kǝ chok mafakǝta ǝ hahi Babila. <verse eid="MAT 1:11" /><verse number="12" style="v" sid="MAT 1:12" />Kǝrsǝ ɗǝt tǝ tandǝ kǝ Babila. Jekoniya nggǝt kan Shiyaltiyel, Shiyatiyel nggǝtchǝ Zerubabel. <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />Zerubabel nggǝtchǝ Abihud, Abihud nggǝtchǝ Eliyakim, Eliyakim nggǝtchǝ Azuro. <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />Azuro nggǝtchǝ Zadok, Zadok nggǝtchǝ Akim, Akim nggǝtchǝ Aliyud. <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />Aliyud nggǝtchǝ Eliyazar, Eliyazar nggǝtchǝ Mattan, Mattan nggǝtchǝ Yakubu. <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />Yakubu nggǝtchǝ Yusufu, chǝma Maryamu. Maryamu man Yesu thla thlǝ ˈya fee wa Kǝrǝsti.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />Kǝthlǝm ndaˈan, thlaˈta Ibrahim, kǝ Dauda, kwathlchǝ kum nggǝrsǝ foɗɗa (14). Thlaˈtǝ Dauda kǝ fartǝɗi harandǝ fee tanda kǝ chok mafakǝta ǝ Babila, kwathlchǝ kum nggǝrsǝ foɗɗa. Thlaˈtǝ ǝ chok mafakǝta ǝ Babila kǝ nggǝtti Kǝrǝsti kwathl kum nggǝrsǝ foɗɗa paɗ.<verse eid="MAT 1:17" /></para>
  <para style="s">Mbanɗi nggǝttǝ fee Yesu Kǝristi</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />Ə mbanɗi nggǝttǝ fee Yesu Kǝristi ya. Ə fartaˈan, Yusufu nggwanantǝ Maryamu man Kǝristi Yesu kǝ chok kǝ nuwan. Tapawa ɓitaˈanchi kyeuriyan wa, chat ɓǝsankǝ fee tǝ waa hwirˈyan, tǝmɗi Shemeti Farta. <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />Chimaɗan taˈan Yusufu thlǝ kafata, paɗ yah wasi kǝ harantǝ fat hur nafcha wa. Chat sakan kan ha kǝ kal tǝ anchi ha kǝmmaˈ ǝ wuɓtǝ fa. <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />Tǝ kǝɗu mǝthlan hur kaɗeˈ ini, chat ɓak thlǝ thlǝndi Chinda kǝmɗiyan hur sǝnaˈta. Ndang kan wa, “Yusufu waˈi Dauda, mǝ lekǝn tǝr nuwa Maryamu kyeuriyo wa. Kǝthlǝm wanɗi nech hurˈyan ɓechan tǝmɗi Shemeti Farta. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" />Nan nggǝt hish waa, necho ɗǝfanda wa Yesu (thla nech hǝraˈandǝ nafcha). Kǝthlǝm mǝthlan nech hǝraˈndǝ nafchiyan hur ɓǝɓifechˈyanda.” <verse eid="MAT 1:21" /><verse number="22" style="v" sid="MAT 1:22" />Ichiɗiya sǝɓchan kǝɗu nat, ndiiɗan tǝ ǝnɗi ha mbuˈtǝ Chinda tǝmɗi thlǝ shenuˈtǝ tǝ yahti Farta choh. Ndat wa,<verse eid="MAT 1:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="MAT 1:23" />“Wannuwanɗi sǝnwakchi hishnefa, nan ɗǝftǝ hur, kǝ nggǝttǝ hish waa.</para>
  <para style="q2" vid="MAT 1:23">Nech fee ɗǝfan thlima wa Immanuwel.” Saktǝ Immanuwel ndaˈan nech kǝ, Farta mǝthlan tǝ minchi. <verse eid="MAT 1:23" /><verse number="24" style="v" sid="MAT 1:24" />Kǝ nahǝnkǝ Yusufu ǝ ena, parakan ǝnɗi mbuˈtǝ thlǝ thlǝndi Farta. Tǝrkan Maryamu kǝ chok kǝ nuwan. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" />Yusufu hunawa Maryamu wa, kǝ fartǝɗi nggǝttǝn waˈyan kǝ hishwaa. Yusufu paɗ ɗǝfan kan wa Yesu.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">Ɓi fǝ sǝn wan ndǝricha naa Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />Kǝ nggǝt kǝ fee Yesu ǝ mǝrǝɓ Baitalami, ǝ hahi Yahudiya. Thlǝhaɗi naa Hiridus kǝ kwitira. Fowun fǝ sǝn wan ndǝricha ǝ mǝt che farta, ɓakandǝ kǝ Urshelima. Chǝhakanda mee, ndat wa, <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />“Ai wanɗi nggǝttǝ fee kǝ kwitiri Yahudawecha? Kǝthlǝm ni ǝn wan ndǝrˈyan mǝt che farta thla pǝnchǝ nggǝttiyan. Paɗ ɓechaˈan kǝ fǝraˈǝn maanda.”<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />Kǝ sǝkkǝ kwitira Hiridus kǝɗu, thlaˈkǝ hur indiyan, kǝɗu paɗ nat tǝ nafchi Urshelima. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />Kǝrsǝ nggomaandǝ nat paktǝ pangngǝncha, tǝ fǝ chaˈandǝ kusiˈ i Musa kaɗi, chihan kan mee tanda mǝɗi naa fee nggǝt Kǝristi. <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />Nggǝrang kandǝs wa, “Hur mǝrǝɓ Baitalami, ǝ hahi Yahudiya.” Kǝthlǝm yarech thlǝ shenuˈtǝ tǝ yahti Farta kǝɗu ndat wa,<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />“‘Kǝthlǝm cha Baitalami, thla nech ǝ hahi Yahudiya.</para>
  <para style="q2" vid="MAT 2:6">Ngga chǝ nech nguɗyeh hur paktǝ hahichi Yahudiya wa.</para>
  <para style="q1" vid="MAT 2:6">Kǝthlǝm mǝɗˈyo naa kwitir cheta, thla</para>
  <para style="q2" vid="MAT 2:6">nech parat tǝ nafchinchi Israˈilawecha.’ ”<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />Chat Hiridus ˈyakan fǝ sǝn ǝnechaˈan ngguɗuk, chihangkan mee tanda, kǝ mbuˈandǝ wanshengngǝnɗi che wandǝriˈan kesh. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />Chat thlǝn kan tanda kǝ Baitalami nda kan wa, “Ɗama kǝ kowun mǝɗi naa wanɗi hǝɓakka. Maa ǝ mbǝsawun, ɓakowun mbuˈita, kǝthlǝm nggǝt paɗ kǝɗi maananda.”<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />Kǝrsǝ kan thlǝmat kutǝran, chat pǝɗakanɗǝ kumichǝ nanda. Wan ndǝriɗi nat ndǝ mǝt che fartǝ yu naa kan wiˈtǝ pangngǝn nanda, kǝ thlartǝ ha ǝ mǝɗi naa wanan. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />Kǝ nakan ndǝ wan ndǝriˈan, ndiiɗ kandǝ kaɗ tǝ mbǝn fat kaˈan. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />Kǝ yimkandǝ kauran, chat nakandǝ wannan tǝ manan Maryamu, kopkandǝ ha fǝran kan ndǝ maanda. Kwasankandǝ ich yandǝ ha, fǝran kandǝ wanan pafǝn i rathlecha, tǝ chiɗɗaa thla naa saˈtaˈan mbinchan, tǝ yowun thla thlǝ ˈya fee wa mur. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />Nggǝrang kan ndǝ in kaɗ kǝ hahiyanda tǝ mbandǝ samǝn. Kǝthlǝm thlaman fee thlǝmechˈyanda hur sǝnaˈta ndat wa, kǝ nggǝra ndǝ in tǝmɗi Hiridus wa.<verse eid="MAT 2:12" /></para>
  <para style="s">Raki Yusufu tǝ nuwan, tǝ waanan kǝ hahi Masar</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />Kǝrsǝ pǝɗati fǝ sǝn wan ndǝrichaˈan, chat thlǝ thlǝndi Farta, pǝnan kan fat Yusufu ǝ hur sǝnaˈta. Ndang kan wa, “Thlaˈu, tǝru wannan, tǝ maanan kǝ rakowun kǝ hahi Masar. Kǝ chok wun minni kǝ fartǝɗi nati mbuˈuta. Kǝthlǝm Hiridus nan kaa wanan kǝ ɓǝlanchi.” <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />Yusufu thlaˈkan, tǝrkan wanan tǝ manan wita pǝɗakandǝ kǝ hahi Masar. <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />Chok kan minni kǝ fartǝ mǝrti Hiridus. Chich ichiˈini kǝɗuyu, ndiiɗantǝ ǝnɗi ha mbuˈtǝ Chinda, tǝmɗi thlǝ shenuˈtǝ tǝ yahti Farta. Ndakan wa, “Thlaˈtǝ ǝ Masar ˈyati waˈinchi.”<verse eid="MAT 2:15" /></para>
  <para style="s">Ɓǝlan Hiridus wanwancha</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />Kǝ sǝnkǝ Hiridus wa fǝ sǝn ichaˈan wa tǝ lǝmndǝ anchi, sǝɓkǝ wanɗǝkaɗatˈyan kaɗ kaˈan. Thlǝn kan kǝ ɓǝlan fee wancha kǝ hǝssa fee nech ǝ Baitalami nat, tǝ wan chiɗi nat nech mǝrǝɓchǝɗi tauranchi ha. Thlaˈtǝ hurat chap kaha. Chich fee thleya keˈke tǝ fartǝɗi che wan ndǝriyan kesh kǝɗ ǝnɗi mbuˈandǝ fǝ sǝn ǝnechaˈan. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />Tǝ mbanɗiya ndiiɗ mbuˈti thlǝ shenuˈtǝ tǝ yahti Farta Irmiya. Ndat wa,<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />“Sǝk fee tǝt mǝrta ǝ mǝrǝɓ Rama,</para>
  <para style="q2" vid="MAT 2:18">fee tǝta kaˈan, yi sǝɓtǝ hwira,</para>
  <para style="q1" vid="MAT 2:18">Rahila tǝta kǝthlǝm wanchiyan,</para>
  <para style="q2" vid="MAT 2:18">fee mǝrcha.</para>
  <para style="q2" vid="MAT 2:18">Karkan fǝ kǝ lǝm fee ndi.”<verse eid="MAT 2:18" /></para>
  <para style="s">Nggǝrandi Yusufu in tǝ nafchiyan kǝ hahi Israˈila</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />Kǝrsǝ mǝrti Hiridus, chat nggǝrkǝ thlǝ thlǝndi Farta pǝnan fat Yusufu ǝ hur sǝnaˈta ǝ hahi Masar. <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />Ndangkan wa, “Thlaˈu, tǝru wanan tǝ manan kǝ nggǝreen in kǝ hahi Israˈila. Kǝthlǝm fee nech kat kǝ ɓǝlandǝ wanan, ǝ mǝrnda.”<verse eid="MAT 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21" />Chat thlaˈkan, tǝrkan wanan tǝ manan pǝɗakan kǝ hahi Israˈila. <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />Kǝ sǝk kanwa Arkilayus sǝmchǝ kǝrsǝ mǝrti chinan Hiridus, mǝthlan chit kutǝrakta hahi Yahudiya, lekǝkan kǝ ɗǝ kǝ minni. Thlaman kǝ Farta thlǝmat ˈyan ǝ hur sǝnaˈta, lengkan ha kǝ mǝrǝɓ Galili. <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" />Ɗǝkan kǝ chok tǝ ǝ yowun mǝrɓa thla thlǝ ˈya fee wa Nazarat. Kǝthlǝm ndaˈan, ndiiɗan fee ǝnɗi ha mbuˈtǝ thlǝ shenuˈtǝ tǝ yahti Farta. Ndat wa, “Nech fee ˈyaˈanchǝ wa thlǝ Nazarata.”<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">Yohanna thlǝ chǝt baptisma tahsanchi mbandǝ kaɗi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />Ə wanmǝnchǝˈini Yohanna thlǝ chit baptisma pǝɗakan, nakan ɓassa ǝ hur chanjeyi Yahudiya. <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" />Nakan ndat wa, “Tǝramha, kǝthlǝm kutǝrakti hulafǝrta ǝ ɓi nduk ha.” <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />Thleya nech kǝ ǝnɗi ndiktǝ thlǝ shenuˈtǝ tǝ yahti Farta Ishaya, kǝ inan. Ndakan wa,</para>
  <para style="q1" vid="MAT 3:3">“Yowun nefa ˈya fat hur chanjeya, mǝthlan ndat wa,</para>
  <para style="q1" vid="MAT 3:3">‘Tahsaman mbandi Chindǝ kaɗi, kǝthlǝm ɓati Waˈi nef kaha.</para>
  <para style="q2" vid="MAT 3:3">Panaman ha kǝn ndelengnga kǝthlǝm kǝ wiˈ ǝ ɗaran.’”<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />Kapaɗi paa Yohanna tahǝschǝ fee tǝ weshi ngelupa, paɗ ndǝɓtiyan yi fiya kǝndǝn. Ɗǝsǝmndǝ yan chalata tǝ ˈyam ɗeya yi chanjeya. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />Nat nafchi Urshelima, tǝ fee nat ǝ Yahudiya, tǝ nat nafchiɗi mǝrǝɓchǝɗi nech kufi Urdun, nakandǝ ɓat kǝmɗiyan. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />Nakan ndǝ mbuˈ ɓǝɓifechˈyanda, chankan baptisma tanda ǝ kufi Urdun.<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />Tǝkǝɗu kǝ nak Yohanna tertǝ nafchi Farisiyawecha, tǝ Sadukiyawecha ɓata kǝthlǝm kǝ chandech fee baptisma. Chat ndang kan tanda wa, “Kun wan pandechiɗiya. Wun ndowunchǝ wa kǝ rakawun sǝɓtǝ hwiri Farta har nech ɓata? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />Cham ichiɗi nech pǝn ndǝ wa malawun chǝt ɓǝɓifata. <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" />Mǝ kaɗowun wa nowun mbahǝn ndandǝ indiyowun wa, ‘Ibrahim nech kǝ chin ǝn, kǝthlǝm ndaˈan, sǝɓtǝ hwiri Farta nen mbǝn nggaˈan fa wa.’ Nggǝt ndowun nda, Farta alkǝtyansi kǝ mbeɗantǝ ɗakwanchiɗi haya kǝ chokndǝ kǝ wancha kǝmɗi Ibrahim. <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" />Nakanya, tapi nɗǝf fee mi wurta chathl ɗǝfcha kǝ fǝlan. Nat ɗǝf tǝɗi nggǝtwakchǝ wanchǝ ndiˈchan, naa fee chathlaa ndǝ kaɗi kǝ mǝk fee kǝ wata.”<verse eid="MAT 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11" />Nggǝt chowun chi baptisma tǝ ema, kǝthlǝm pǝnndǝ wa malawun chǝt ɓǝɓifata. Paɗ thla nech ɓat kǝrsǝna mbǝrichi ha tǝ maanda, thla chika pahǝmchiyan chaˈwisi kǝ kǝsi har wa. Mǝthlan nech chowun baptisma tǝ Shemeta thla chǝɗchǝɗ, tǝ wat paɗ. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />Tapi tǝrtǝ ǝna pǝr hwermiyan chip kǝ hera. Nan tangsandǝ wan hwermiyan kaɗi kǝ kohanchi kǝ thlǝr kǝ ɓǝndǝw ˈyan. Kwichinan paɗ, nan nja ndǝ kaɗi tǝ waɗi thlǝ lifwakcha.<verse eid="MAT 3:12" /></para>
  <para style="s">Chan Yohanna baptisma Yesu</para>
  <para style="r">(<ref loc="MRK 1:9-11">Mar 1:9-11</ref>; <ref loc="LUK 3:21-22">Luk 3:21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />Kǝrsǝ fartiˈini, ɓak Yesu thlaˈtǝ hahi Galili, ɗǝkan kǝ kufi Urdun kǝmɗi Yohanna, kǝthlǝm kǝ chantǝ baptisma. <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />Yohanna yah kan si kǝ ˈyatanchi. Ndang kan wa, “Kǝmchansi chi nech chi baptisma, mǝ chich natu ɓat kǝmɗinchi kǝ chuchi baptisma?”<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />Nggǝran kǝ Yesu sǝ wa, “Malan kǝ chok kǝɗu nakanya, kǝthlǝm tǝkǝɗu natmǝn ndiiɗandǝ kakǝti Fartǝ ha.” Kǝn Yohanna nggǝmandǝ si.<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />Kǝ tǝɓang kǝ Yohanna chan Yesu baptisma, chek Yesu kesh hur ˈyaman. Chat kǝɗuyu, in kǝ hulafǝrtǝ ha, nak Yesu Shemeti Farta ɓat kaha kǝ ndǝn wa kunggurha, kopkan kafˈyan. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" />Chat sǝkkǝ fee ɓǝrata ǝ hulafǝrta tǝ ndat wa, “Thleya nech kǝ Waˈinchi thla thlǝ mbǝndifaɗan fa, thlǝ sǝkti mbǝnan fǝ kaan.”<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">Kaɗan Hweˈrǝ Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />Chat Shemeti Farta ɗǝkan tǝ Yesu kǝ hur chanjeya, kǝthlǝm kǝ kaɗan Hweˈra. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />Yesu kǝrtǝ kwichimnda mǝnda kumchit foɗɗa (40), witǝ tǝ farta, sǝm wa ǝna wa. Tǝkǝɗu nak mitǝfiyan. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />Ɓak Hweˈra kǝmɗiyan, ndang kan wa, “Maa chǝ Waˈi Farta, ndandǝn ɗakwanchiɗiya wa, kǝ chǝndǝ kaɗ kǝ njohǝma.”<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />Nggǝman kǝ Yesu wa, “Yaranchǝ fee ha hur Lawlawati Farta ndat wa, ‘Ngga tǝ ɗǝsǝmndǝ ndak naa nef nat ha wa. Nan nat ha tǝmɗi ndiktǝɗi ɓech mǝɗi Farta.’”<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />Pǝɗak Hweˈrǝ tǝ Yesu kǝ Urshelima mǝrɓa thla chiɗ chiɗ. Ɗǝfkan anchi kǝ thlar ha mǝɗi nech njang ǝ Wiri Farta. <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />Ndangkan wa, “Maa chǝ Waˈi Farta, puru kaha. Kǝthlǝm nechan kǝ yaraɗan ndat wa,</para>
  <para style="q1" vid="MAT 4:6">‘Nan shenuˈandǝ fǝ thlǝnchiyan kǝ ɓǝratu wa.</para>
  <para style="q2" vid="MAT 4:6">Nan ɗǝf tanda kǝ choˈuchǝnda,</para>
  <para style="q1" vid="MAT 4:6">kǝthlǝm kǝ thlǝfeen sarchiyo ɗekwena wa.’ ”<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />Ndangkǝ Yesu wa, “Nechan kǝ yaraɗan paɗ tǝ ndat wa, ‘Kǝ keɗeen Chinda Fartiyo wa.’ ”<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />Tǝ paɗ, nggǝrkǝ Hweˈrǝ ɗǝt taˈanchi kǝ ɓǝra yowun ngwela thla njang kaˈan pǝnankan nat kutǝrakti heshiɗiya nat tǝ maandiyanda. <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />Ndangkan wa, “Nat ichiɗiya ni fǝruta ma koppin ha pangngǝnna kǝ firichin maanda.”<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />Ndangkǝ Yesu wa, “Pǝɗo mǝɗiya, chǝ Hweˈra. Kǝthlǝm nechan kǝ yaraɗan ndat wa, ‘Kǝ meneen Chinda Fartiyo, mǝthlan ndak natu maananda.’ ”<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />Chat malkǝ Hweˈrǝ anchi ha. Chat fǝ thlǝnchi Farta ɓakanda, nakandǝ maananda.<verse eid="MAT 4:11" /></para>
  <para style="s">Nggak Yesu teryan ǝ hahi Galili</para>
  <para style="r">(<ref loc="MRK 1:14-15">Mar 1:14-15</ref>; <ref loc="LUK 4:14-15">Luk 4:14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />Kǝ sǝkkǝ Yesu wa kǝsan fee Yohanna nggǝlan fee ǝ pursuna, chat thlaˈkan nggǝrangkan in kǝ hahi Galili. <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" />Malkan mǝrɓi Nazarat ha, nggǝran kan in kǝ mǝrɓi Kafarnahum tǝ chokta. Kafarnahum paɗ, nechan mii hawurta, ǝ sǝrtǝ hahi Zabaluna tǝ Naptali. <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />Chokti Yesu ǝ minni ndiiɗan tǝ ǝnɗi ha mbuˈtǝ thlǝ shenuˈtǝ tǝ yahti Farta Ishaya. Thla ndech wa,<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />“Nafchi hahi Zabaluna tǝ nafchi hahi Naptali.</para>
  <para style="q2" vid="MAT 4:15">Kun tǝ ɗi nech ǝ mban hawurta, tǝ paɗ heshi kufi Urdun,</para>
  <para style="q2" vid="MAT 4:15">nafchi hahi Galili yi fee nawakchǝ kǝ Yahudawecha.<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />Nafchiɗi thlǝ chokcha hur wuthla,</para>
  <para style="q2" vid="MAT 4:16">ni ndǝ kapa ɗaˈkǝta.</para>
  <para style="q1" vid="MAT 4:16">Kǝ ɗar fee thlǝ chokchǝ ǝ kanɗǝftǝ mǝrta,</para>
  <para style="q2" vid="MAT 4:16">naa ɗaˈkǝt finandata.”<verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />Thlaˈtǝ ǝ fartǝˈini, nggakkǝ Yesu ɓasa, nakan ndat wa, “Tǝramha kǝthlǝm kutǝrakti Hulafǝrta nduk ha.”<verse eid="MAT 4:17" /></para>
  <para style="s">I Yesu kǝmsichiyan yi tǝrkwathl kanan</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />Kǝ nak Yesu wiˈtǝ kǝlaar hawurti Galili, nakan nafchi chap, Siman (thla thlǝ ˈya fee wa Biturus), tǝ wanmanan Andrawus. Tandǝ cham mapatˈyanda kǝ hur hawurta, kǝthlǝm fen fǝ tǝmǝncha. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />Ndang kǝ Yesu tanda wa, “Ɓama, param nenchi, ni nggǝrowundǝ kaɗ kǝ fǝ ˈya nafcha, kǝmɗi Farta.” <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />Chat kǝɗuyu malkandǝ mapechˈyandǝ ha parakan ndǝ ndi.<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />Kǝ malkan minni ha, nakan fowun nafchǝ chap wanmankakta, Yakubu waˈi Zabadi tǝ wanmanan Yahaya. Tandǝ ɗas tǝ chinnanda hur kombawalˈyanda, tandǝ tahǝs mapecha. ˈYak Yesu tanda, <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />chat kǝɗuyu malkandǝ kombawaltaˈan ha tǝ chinnanda, parakandǝ ndi.<verse eid="MAT 4:22" /></para>
  <para style="s">Chaˈan Yesu nafchi har paɗ kǝnanchi tandǝ kaɗi</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />Wiˈyankǝ Yesu nat hahi Galili. Nakan chaˈandǝ kaɗi ǝ hur kǝtǝn nggomndiyanda, paɗ nakan ɓas kusheˈtǝ ndik tǝ kutǝrakti Farta. Nakan kǝnandǝ fee nech haˈchan kaɗ hurnandǝ nat. <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />Kusheˈtaˈan fen ha chik tǝ yeni hur hahi Suriya. Nak nafchǝ ɓat tǝ fee nech haˈchan nat, tǝ hatǝ fech fǝ samǝn samǝn. Fee nech kofiˈta, fowun paɗ tǝ hwaˈarchǝ fa, tǝ fee tǝ chandarchif yu, ta fee saa fechˈyandǝ kaɗi, kǝnan kan tandǝ kaɗ paɗ. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />Kapa nggomnda kaˈan thlaˈta ǝ hahi Galili, tǝ mǝrǝɓ chi kum, thla thlǝ ˈya fee wa Ɗikafolis, tǝ Urshelima, tǝ hahi Yahudiya. Nat ta fee nech heshi kufi Urdun, parech ndi.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">Chaˈan Yesu ǝn nafchǝ har ǝ tingringnda</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />Kǝ nak Yesu ǝ nggom nafchǝ terchan kǝmɗiyan, tǝrkan kǝ ɓǝra tingringnda chokkan ha. Kǝmsichiyan paɗ ɓakandǝ kǝ thlǝmaɗan.<verse eid="MAT 5:1" /></para>
  <para style="s">Mbǝsˈichi Har</para>
  <para style="r">(<ref loc="LUK 6:20-23">Luk 6:20-23</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 5:2" />Nggakkan chaˈandǝ tandǝ har tǝ ndat wa,<verse eid="MAT 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />“Fǝ mbǝs ichǝ har, fee sinchǝ wa wulan fat tanda hur Shemeta.</para>
  <para style="q2" vid="MAT 5:3">Kǝthlǝm kutǝrakti hulafǝrta yinanda.<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />Fǝ mbǝs ichǝ har, fee nech tǝ sǝɓtǝ wanɗǝkaɗata,</para>
  <para style="q2" vid="MAT 5:4">kǝthlǝm naa Farta mbiɗaandǝ wanɗǝkaɗechˈyanda.<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />Fǝ mbǝs ichǝ har, kǝmɗi fee thlǝ thlaˈawakchǝ inda,</para>
  <para style="q2" vid="MAT 5:5">kǝthlǝm naa Farta fǝranda ǝnɗi ɗǝftǝn miyan.<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />Fǝ mbǝs ichǝ har, kǝmɗi fee thlǝ yahtǝ wanɗǝkaɗechˈyanda, ndaˈan nech kǝ thlǝnandǝ ǝnɗi yahtǝ Farta.</para>
  <para style="q2" vid="MAT 5:6">Kǝthlǝm nandǝ choktǝ kǝ nafchǝɗi naa fee nggallandata.<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />Fǝ mbǝs ichǝ har, fee thlǝ haɗandǝ nafchǝ fa,</para>
  <para style="q2" vid="MAT 5:7">kǝthlǝm nandǝ haɗandǝ Farta fa.<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />Fǝ mbǝs ichǝ har, fee nech chiɗ chiɗ tǝ wanɗǝkaɗata,</para>
  <para style="q2" vid="MAT 5:8">kǝthlǝm nandǝ naa Farta.<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />Fǝ mbǝs ichǝ har, kǝmɗi fee thlǝ mbǝnanchi pǝthlǝr nafchǝ kaɗi,</para>
  <para style="q2" vid="MAT 5:9">kǝthlǝm nech Farta ˈya tanda wa wanchiyan.<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />Fǝ mbǝs ichǝ har, kǝmɗi fee naa fee ɓahandata kǝthlǝm chǝt ǝnɗi yah tǝ Farta.</para>
  <para style="q2" vid="MAT 5:10">Kutǝrakti hulafǝrta nan choktǝ kǝ yinanda.<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />“Kun fǝ mbǝs ichǝ har, maa nafchǝ ˈyarawunchi, kǝ fǝrowunchǝ ndǝ ɓahta, tandǝ mbuˈ sǝɓtǝ icha kǝ inwun tǝ lekta, kǝthlǝm nggǝta. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" />Mbǝnam fata tǝ chiɗ chiɗ tǝ wanɗǝkaɗata kaˈan, kǝthlǝm nowun mbǝs kǝnawan kaˈan hulafǝrta. Kǝthlǝm kǝɗu paɗ ɓahandǝ ndǝ fee fǝ shenuˈtǝ tǝ yahti Farta fee lech nat ha mǝ kun.<verse eid="MAT 5:12" /></para>
  <para style="s">Fisha tǝ ɗaˈkǝta</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />“Kun nech kǝ fisha ǝ hur heshi. Tǝkǝɗu ma ǝ tǝr mbǝndi fish kaɗi, tǝ kǝn naa fee nggǝrandǝ mbinan kaɗi? Chokchan kǝ kohaɗan peˈwu fee chǝt ǝnsǝ wa. Tǝn fee thlǝrandǝ kaɗ ndak kǝn fee ɗǝsanda.<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />“Kun nech kǝ ɗaˈkǝta ǝ hur heshi. Nat mǝrǝɓɗi tǝndǝ fee ɗar tingringnda wuɓ wa ha wa. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" />Njawu fee tikesha kǝ chipan fee tǝ ɗuliya wa. Naa fee ɗǝftǝ kǝ yikaa, kǝthlǝm kǝ fǝrantǝ ɗaˈkǝt nat nafchiɗi ǝ wuran. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" />Kǝɗu paɗ, malaman kǝ nǝ nafcha ɗaˈkǝtɗi nech hwirˈyowun. Kǝthlǝm maa ǝ nii ndǝ kwastǝ tarchiɗi thlǝnandǝwun, nandǝ fǝran maandǝ Chinwun thla nech hulafǝrta.”<verse eid="MAT 5:16" /></para>
  <para style="s">Chaˈandi Yesu kaɗ kǝ ɓǝra kusiˈ</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />“Kǝ sak wun wa ɓechi kǝthlǝm kǝ welani kusiˈ i Musa kaɗ wa, ndu yarechiɗi fǝ shenuˈtǝ tǝ yahti Farta wa. Ɓawi kǝthlǝm kǝ welani tandǝ kaɗ wa, ɓechi kǝthlǝm kǝ ndiiɗani tandǝ ha. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" />Kittaˈan nati mbuˈowunda, kǝn hulafǝrtǝ tǝ heshi paˈtǝ kaɗi, nggǝ ɗuhwal tǝ wan nggaˈal ndiktǝ kusiˈ si nech wethlǝ kaɗ wa. Nan ndiiɗ ha nat. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />Kǝthlǝm ndaˈan nat thla chenchǝ artǝ kaɗ hur kusiˈ chǝɗi nech ngguɗyeh ya, paɗ kǝ chaˈantǝ nafchǝ har kǝ chendǝ kaɗ kǝɗ ǝnɗi chǝtǝn. Nech fee ndat tǝ ndǝ wa, thla nech top ǝ kutǝrakti hulafǝrta. Nat thla perech har, chaˈan kan kaɗ paɗ. Nech fee ˈya ndǝ wa thlǝ maanda ǝ kutǝrakti hulafǝrta. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />Nggǝt ndowun nda, maa ǝ mbǝrawowun Farisiyawecha ha tǝ fǝ chaˈan ɗǝ kusiˈ i Musa kaɗ tǝ kaakǝta wa. Nowun yim kǝ kutǝrakti hulafǝrta wa.”<verse eid="MAT 5:20" /></para>
  <para style="s">Chaˈandi Yesu kaɗ kǝ ɓǝra sǝɓtǝ hwira</para>
  <para style="r">(<ref loc="LUK 12:57-59">Luk 12:57-59</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />“Sǝkwun ndan fee nafchǝ choh wa, ‘Mǝ ɓǝlǝn fata wa. Nat thla ɓǝlchǝ fata, nafee kǝnaanda.’ <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />Nggǝt ndowun nda, thla thlǝ nech sǝɓandǝ hwirkaɗ tǝ sheɗan, nafee chakan mee. Thla erech sheɗan, nafee ɗǝt taˈanchi kǝ mǝt chak mee. Thla paɗ ech sheɗan wa, ‘Chǝ ɓema,’ naa fee mǝkndǝ kǝ wur wata.<verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />“Kǝthlǝm ndaˈan, ma chǝ mǝt fǝr pafǝn ˈyo, mǝt thle ɓǝra icha, chat kuɗuk ko wa shetusi tǝ wech hur, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />malanko fǝr pafǝn taˈan ǝ minni. Ɗǝko kaa mban tahsandǝ kaɗi tǝ shet wa. Kǝno ɓat fǝr pafǝn ˈyo kǝmɗi Farta.<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />“Maa ɗi yowun mǝk wanhar wa, wesheko ka mban tahsanan kaɗ tǝ ndi peˈwun ɗar mbanda, kǝ nowun saˈtǝ kǝ mǝt chak miyan. Maangga kǝɗu wa, nan ɗǝt tǝ wech kǝmɗi thlǝ chak mee. Thlǝ chak miyan paɗ nan ɗǝt tǝ wech kǝmɗi wanfangnda. Wanfangnan paɗ nan pǝk wech kǝ pursuna. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />Kittaˈan nati mbuˈowunda, chewu fee kesh minni wa. Maangga tǝ tiyin nat ǝnɗi thlutǝ fee wa, kǝnen chet kesh ǝ minni.<verse eid="MAT 5:26" /></para>
  <para style="s">Chaˈandi Yesu kaɗ kǝ ɗar fǝlaukǝta</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />“Sǝk wun ndi fee wa, ‘Kǝ chin fǝlaukǝtawa.’ <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />Nggǝt mbuˈowunda, chika wun ɗǝpanchǝ nunefa tǝ kaɗa hunandi, chok chan yuwa ǝ huni tǝ ndi ǝ wanɗǝkaɗatˈyan. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" />Maa wenitiyo yi harsǝm thlǝ ɗǝfchǝ wech kǝ chin ɓǝɓifata, huhlanko kaɗi kǝ mikeen kaɗi. Kwechan kǝ kuɓen tanggathla fat arta ǝ fiyo mǝ kǝ mǝk fee nat fatˈyo kǝ hur wur wata. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" />Maa herˈyo yi harsǝm thlǝ ɗǝfchǝ wech kǝ chin ɓiɓǝfata thlen ko kaɗ kǝ mǝkeen kaɗi. Kwechan kǝ kuɓen tanggathla fat arta ǝ fiyo mǝ kǝ mǝk fee nat fatˈyo kǝ hur wur wata.<verse eid="MAT 5:30" /></para>
  <para style="s">Chaˈandi Yesu kaɗ kǝ ɗar chak reta</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />“Ndi fee paɗ wa, ‘Nat thla karchǝ nuwan, nwaat kǝ yaran tǝ ɗerwel si yi chak reta.’ <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" />Paɗ nggǝt mbuˈowunda wa, nat thla karchǝ nuwan, mangga kǝ ɗar fǝlaukǝta wa, ɗǝf tǝ anchi kǝ chit fǝlaukǝta. Thla paɗ kahanchi nuɗi kartǝ fee, chok kǝ thlǝ chǝt fǝlaukǝta.<verse eid="MAT 5:32" /></para>
  <para style="s">Chaˈandi Yesu kaɗ kǝ ɗar ransata</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />“Tapi sǝk wun ǝnɗi mbuˈandǝ Farta nafchi choh. Ndakan wa, ‘Kǝ en thlǝm Farta kǝɗu wa, paɗ chamandǝn Chinda ǝnɗi ɗǝftǝwun miyan.’ <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" />Nakanya nggǝt mbuˈowun nda wa, kǝ ransowun wa chǝk ngguɗyeh. Kǝ ransowun tǝ hulafǝrta wa, kǝthlǝm ndaˈan nech kǝ mǝt chokti Farta. <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />Mǝ ransowun tǝ heshi wa, kǝthlǝm ndaˈan nech kǝ mǝt sǝt sarchiyan. Mǝ ransowun paɗ tǝ Urshelima wa, kǝthlǝm ndaˈan nech kǝ kapa mǝrǝɓan i kapa kwitira. <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />Mǝ rensen tǝ indiyo paɗ wa, kǝthlǝm no mbahǝn chantǝ wesho kaɗ chǝk arta kǝn kuɗkuɗ, ndu heɗɗǝɗa wa. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />Ənɗi kǝmchǝs kǝ mbuˈ nefa, ndaˈan nech kǝ, ‘Əa’ ndu ‘Auwa.’ Ənɗi mbǝranchi ha kǝɗu, thlaˈchan yu mǝɗi hweˈra, ɓǝɓiˈan.<verse eid="MAT 5:37" /></para>
  <para style="s">Chaˈandi Yesu kaɗ kǝ ɗar tii ǝnɗi chu tǝ fee</para>
  <para style="r">(<ref loc="LUK 6:21-30">Luk 6:21-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />“Sǝk wun ǝ mbuˈ fee hur Laulawati Farta choh ndat wa, ‘Nafɗi huhlanchi weniti sheɗan kaɗi, mǝthlan paɗ kǝ kǝtan fee yaˈan kaɗ kǝ kwaran. Nafɗi kǝtanchi thleni sheɗan kaɗi, mǝthlan paɗ kǝ kǝtan fee yaˈan kaɗ kǝ kwaran.’ <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />Nggǝt mbuˈowunda tǝ ndat wa, thla yahchǝ chu ɓǝɓifat fa, malangko tǝ ǝna chitˈyan. Maa ǝ mbali yowun wech ǝ mbertǝyo yi harsǝm, tǝɓranko mbertǝ thla fǝ paɗ. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />Ma mǝk yowun wan har wa tǝ kaɗat wa tǝn thlǝnandǝ kapatˈyo, malangko chika ǝna chiptiyo. <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />Maa thlǝ yandǝsi kweˈyuchǝ wiˈtǝkaf kǝɗ mel arta, ɗu kǝ wiˈwun mel chap. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />Maa ǝ shiyuchi yowun ǝna, fǝrandǝn. Thla paɗ ɓech ka kumata mǝɗyo, mǝ njenǝ wa.<verse eid="MAT 5:42" /></para>
  <para style="s">Chaˈandi Yesu kaɗ kǝ ɗar mbǝn fa atǝkrita</para>
  <para style="r">(<ref loc="LUK 6:27-28">Luk 6:27-28</ref>; <ref loc="LUK 6:32-36">6:32-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />“Sǝk wun ndi fee choh wa, ‘Kǝ yehin wanmu, kǝ kerin atǝkretu wa.’ <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />Tǝkǝɗu nggǝt ndowundǝ wa, kǝ yehin atǝkrechǝwun, kǝ shiwun kǝ ɗar fee nech ɓahowunda. <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />Tǝkǝɗu nat wun chokta kǝ wanchi Chinwun thla nech hulafǝrta. Thla thlǝ ɗǝfchǝ watfartiyan kǝ wenantǝ mǝt kaɗ kǝ ɗar fǝ kaa kǝta tǝ fǝ ɓǝɓifecha. Thlǝ ɗǝfchan er kǝ ɓa kǝ ɗar nat fǝ kafecha, tǝ fǝ kumi kafat paɗ. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />Maa thlǝ yahchowun fee thlǝ yahchǝ wunchǝ ndak, nechowun mbǝs ǝn har wa kǝni? Awi ngga kǝɗu chika fǝ thlǝt chamincha thlǝ chǝtndǝ paɗ wa, fen tǝɗi nech kǝ fǝ ɓǝɓifech hacha? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />Maa wanmanchǝwun ndak thlǝ ndandǝwun ǝna, mǝ thlǝ chǝt wun thla mbǝranchi yi takǝɗ nafchǝ ha? Awi chika fee nawakchǝ kǝ Yahudawecha, ngga kǝɗu thlǝ chǝtndǝ paɗ wa? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />Kǝthlǝm ndaˈan kǝ nɗiiɗ wun kaɗi, kǝɗ ǝnɗi naa Chinwun thla nech hulafǝrta kǝ ndiiɗan.<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s1">Ndik Yesu kǝ ɗar kǝsandǝ fǝ ɓahchǝsi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />“Mbǝramsi tǝ tar kaakǝt ˈyowun kǝchok kǝyi nat ǝ wenitǝ ndak wa. Kǝthlǝm maa chǝwun kǝɗu, nowun mbǝs kǝnau pafǝn mǝɗi Chinwun thla nech hulafǝrta wa.<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />“Kǝthlǝm ndaˈan, maa no kǝsandǝ fǝ ɓahchǝsi, mǝthl nowun fǝɗandǝ pandǝra kǝthlǝm sǝnandǝ nafchǝs wa kun chicha wa. Kǝɗ ǝnɗi thlǝ chǝt ɓǝɓi nafcha ǝ wur nggomndiyanda tǝ ɗar njartǝ mbanchi pǝthlǝr wurcha, kǝthlǝm kǝ chǝm nafchǝ tanda. Kittaˈan kǝ wathlowunchǝ ha, tapi mbǝsndǝ kǝnau pafǝn ˈyandǝ hacha. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />Paɗ maano fǝran kǝnau pafǝn fǝ ɓahcha, kǝ yehǝn kǝ sǝn yowun ǝnɗi natu chǝta wa, <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />kǝthlǝm kǝnau pafǝn tǝɗi natu fǝrta kǝ chok ǝ wuptǝ kaɗi. Chinwun tǝɗi nech naa ichiɗi nech wupta, mǝthlan nech furu kǝnawan.<verse eid="MAT 6:4" /></para>
  <para style="s">Chaˈandi Yesu kaɗ kǝ ɗar shita</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />“Paɗ maa nowun shita, kǝ chokwun kǝɗ ɓǝɓi nafcha wa. Nafchǝɗi thlǝ yahchǝ shitǝ wur nggomincha tǝ njartǝ mbancha, maˈ nǝ nafchǝ naa tanda. Kittaˈan kǝ wathlowunchǝ ha, tapi mbǝs ndǝ kǝnaun pafǝn ˈyanda. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />Maa yehǝn shita, yimko kǝ kǝnˈndo, ngǝlanko mii kǝnnda, kǝ shiyin kǝmɗi Chu tǝɗi thlǝ nawaktǝ fee. Chu tǝɗi nech ichiɗi wuɓta mǝthlan nech furu kǝnau pafǝn. <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" />Maa kun shita, mǝthl nowun nggǝrandǝ kan wa, kǝɗ fee sǝnwakchǝ Farta wa. Sak tanda na Farta sǝk tanda kǝthlǝm tertǝ shenuˈtiyanda. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />Kǝ chuwun kǝɗ tanda wa, kǝthlǝm Chinwun sǝntǝ ichiɗi kǝmchǝs kǝ mbǝswun, kǝnowun shiyanda.<verse eid="MAT 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 6:9" />Ə mbanɗi natwun shitǝ ya.</para>
  <para style="q1" vid="MAT 6:9">“‘Chinmǝn, thla hulafǝrta,</para>
  <para style="q1" vid="MAT 6:9">kǝ manan fee thlǝmwa,<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />kǝ sǝn nafcha wa chǝnech kǝ kwitira,</para>
  <para style="q1" vid="MAT 6:10">kǝ chifee ǝnɗi yahtu hur heshi kǝɗ thla thlǝ chǝt fee hulafǝrta.<verse eid="MAT 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11" />Kǝ fǝreˈǝnchǝn ɗisǝmǝn yi chik yen parta.<verse eid="MAT 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12" />Kǝ keleˈǝnchǝn ɓǝɓifechyaˈan ha,</para>
  <para style="q2" vid="MAT 6:12">kǝɗ thla thlǝ kalandǝˈǝn fee ha thlǝ chaˈanchǝ ɓǝɓifat fa.<verse eid="MAT 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13" />Kǝ yehǝn Hweˈra kǝ kaɗaˈanchi tǝ ǝnɗi pǝɗanchi alkitˈyaˈan ha wa,</para>
  <para style="q2" vid="MAT 6:13">Paɗ thlu nggaˈan kaɗ har ˈyan.’<verse eid="MAT 6:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 6:14" />Kǝthlǝm maa kalawun nafchǝ ɓǝɓiˈ ichiɗi ha chowundǝ nda, Chinwun thla hulafǝrta nan kalowun ɓǝɓi ichiɗi thlǝnandǝwun paɗ. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />Maa kalawowun nafchǝ ɓǝɓi ichiɗi chowun ndǝ nda wa, Chinwun hulafǝrta paɗ nen kalowunchǝ ɓǝɓi ichiɗi thlǝnandǝ wun kaɗ paɗ wa.<verse eid="MAT 6:15" /></para>
  <para style="s">Chaˈandi Yesu kaɗ kǝ ɗar kǝrkuchimnda</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />“Maa kun kǝrkuchimnda, kǝ sǝɓawun chimandǝ kaɗ kǝɗ ɓǝɓi nafcha wa. Kǝthlǝm thlǝ siɓanchandǝ chimanchǝ kaɗ kǝ pǝnandǝ nafchǝs wa tanda kǝrkuchimnda. Kittaˈan kǝ wathlowunchǝ ha, tapi mbǝs ndǝ kǝnau pafǝn ˈyanda. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />Paɗ maachǝ kǝrkuchimnda, kǝ chepeen chǝmaɗo kaɗi, kǝ peˈǝn fiɗet kǝ inda, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />kǝthlǝm kǝ sǝn fee wa chǝ kǝrkuchimnda wa. Chu tǝɗi thlǝ nawaktǝ fee, thla thlǝ nech ichiɗi thlǝ chit fee ǝ wuɓtǝ kaɗi, mǝthlan nech fǝru kǝnau pafǝn.<verse eid="MAT 6:18" /></para>
  <para style="s">Chaˈandǝ kaɗ kǝ ɗar nggommandǝ kǝnau ha ǝ hulafǝrta</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />“Kǝ nggommawun kǝnau indiyowunsi ǝ hur heshi wa, mǝɗi naa chaˈkǝɓcha tǝ lenjeta nech sǝɓandi kaɗ wa. Mǝɗi paɗ naa yaarchǝ yimndǝsi kǝ yarkanda wa. <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />Paɗ nggomamaandǝn kǝnau indiyowunsi hulafǝrta, mǝɗi nawaktǝ chaˈkǝɓcha, ndu lenjeta nech sǝɓandi kaɗ wa. Mǝɗi paɗ nawaktǝ fǝ thlar mbanchǝ tokandǝ kaɗ kǝ yarkanda wa. <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />Kǝthlǝm mǝɗi naa kǝnauˈyo, nech wanɗikaɗatˈyo nat minni.<verse eid="MAT 6:21" /></para>
  <para style="s">Ɗaˈkǝti fata</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />“Wenita nechan kǝɗ ɗaˈkǝti fata. Maa wenito hashas, nat fatˈyo nan ndiiɗ kaɗ tǝ ɗaˈkǝta. <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />Paɗ maa wenitiyo hashas wa, nat fatˈyo nan nat hur wuthla. Maa ɗaˈkǝt ɗi nech fiyo chǝ kaɗ kǝ wuthla, nech maandi wuthlan nat wa kǝni?<verse eid="MAT 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />“Nggǝ nefsi nech mbahǝn maanandi fǝ wurchǝ chap wa. Ndu kǝ yahtǝ arta, kǝ kartǝ arta, ndu kǝ maananchi arta, kǝ njirtǝ thla arta. Mbandǝs natu maanandi Farta tǝ wanɗǝɓǝthla wa.<verse eid="MAT 6:24" /></para>
  <para style="s">Kǝ chokwun hur saka inda wa</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />“Kǝthlǝm ndaˈan, nggǝt mbuˈowunda, mǝ sakowunchǝ inda tǝ natˈyowun ha kǝ ɓǝra ǝnɗi natwun sǝmnda, ndu ǝnɗi natwun sata wa. Ndu kǝ mbǝs wun ǝnɗi natwun pat kafa wa. Shishingnda pǝɗawa ɗǝsǝmndǝ ha wa? Paɗ fatˈyowun pǝɗawa kapech ha thla natwun pata wa? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />Ɗǝpaman ɗiicha. hǝfwanda wa, hathl wanda wa, ngomawandǝ kǝ ɓinducha paɗ wa. Nat tǝ kǝɗu Chinwun thla hulafǝrta thlǝ sǝmanchan ǝn tanda. Awi pǝɗawowun ɗiichǝ ha tǝ maanda wa? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />Wun hurwun, kǝthlǝm saka inda, nech mbahǝn chekan wanshenndǝ arta indiyan hur choktǝyan?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />“Kǝthlǝm mǝ naa indǝ sakowun nda kǝ ɗar kapecha thla natwun pata? Ɗǝpaman fitǝ ichǝ hur hwalita tandǝ maanda, chiwa ndǝ tera, ndu kǝ yoˈumndǝ kapecha wa. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />Chǝk tǝ kǝɗu ngǝt mbuˈowunda, chika Sulemanu tǝ kǝnauˈyan nat, tam wa kwaasa ndiˈchan kǝɗ artǝ hur fitǝ ichiɗa wa. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />Kǝɗu, maa na Farta mbahǝn kwasandǝ hwalichi chanjeya fee nessi ɓukuya, ǝssi paɗ kǝ njang fee tandǝ kaɗ hur wata, mǝ nggun wa? Fǝ fǝr kit ngguɗyeh.<verse eid="MAT 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 6:31" />“Kǝthlǝm ndaˈan mǝ sakowunchǝ indǝ tǝ ndat wa, ‘Mǝnat mǝn sǝmnda? Ndu, Mǝ nat mǝn sata? Ndu, Mǝ nat mǝn pat kafa wa?’ <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />(Ichiɗiya na fǝ kumi fǝr kit kata.) Chinwun hulafǝrta shin wa yahwun ichiɗi nat ya, nan kǝsowun ndǝsi. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />Kǝthlǝm kǝt ndaˈan, tǝrkwathl kan ǝnɗi kǝmchǝs kǝ chuwun ndat wa, kam nat ichiɗi nech kǝ yi kutǝrakti Farta, tǝ thlǝrɗaktiyan. Kǝn Farta chekowun ichiɗiya kafˈyan nat. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />Kǝthlǝm ndaˈan mǝ sakowunchǝ inda tǝ ǝssi wa, kǝthlǝm ǝssi ɓat tǝ ɓahtiyan. Ɓahchiɗiha ɓukiya chaˈowun chǝnda kǝthlǝm ɓukiya.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">Mǝ chakawun mee raˈan wa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />“Mǝ chakawun mee raˈan wa, kǝthlǝm kun paɗ nggǝ fee chakowunchǝ wa. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" />Kǝthlǝm tǝ weˈtǝ chakmiɗi chakandǝwun raˈan, tǝ weˈtǝ ndaˈan na Farta chakowun ndǝ paɗ. Tǝɓ tartǝɗi kaɗat wunsi, tǝ ndaˈan na Farta kaɗowundǝsi.<verse eid="MAT 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3" />“Kǝthlǝm mǝ thlǝ ɗǝpandu wan usunɗi nech ǝ weniti shetwa, paɗ kaɗewen har tǝ kunggul ɗǝftǝɗi nech ǝ wenito wa? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />Necho ndandǝ wanmu wa kǝni, ‘Suku kǝ kǝtani wan usunɗi nech ǝ hur wenitiyo,’ kǝrsaɗan kunggul ɗǝftǝs ǝ hur wenitiyo? <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />Chǝ ɓǝɓi nefa, lo kǝtan kunggul ɗǝftǝɗi kaɗ nech ǝ wenitiyo kwaɗǝn. Kǝno mbahǝn nat ha ndiˈchan thla natu kǝtandǝ wan usunɗi kaɗ weniti shetwa.<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />“Kǝ ferawun yiɗchǝ ǝnɗi nech chiɗ chiɗ wa, kǝ fǝrawun paɗ kǝlanggarchǝ ɗakwan pǝthlaarchǝɗi mǝnandǝwun wa. Kǝthlǝm maa chǝwun kǝɗu nandǝ ɗǝssandata, kǝ tǝɓǝrndǝ ha kǝ chowunchǝndǝ mboro fa.”<verse eid="MAT 7:6" /></para>
  <para style="s">Shiyama, kama, kǝ fǝɗawun</para>
  <para style="r">(<ref loc="LUK 11:9-13">Luk 11:9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />“Nam shiyama na fee fǝrowunda, nam kama nowun mbǝstǝ paɗ. Nam cham kǝɓi mii kǝtǝnan na fee inowundǝsi. <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />Kǝthlǝm thla shicha nan mbǝsta, nat thla kecha na fee fǝranda. Nat thla chich kǝɓi paɗ na fee inan mikǝnndǝsi.<verse eid="MAT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9" />“Wun ǝ hurwun chincha thla maa ǝ chǝhan waˈyan kwasata, kǝ fǝrantǝ ɗekwena? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />Paɗ ndu kǝ chǝhan tǝ yirfa, kǝ fǝrantǝ wirɓa? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />Ma kun tǝɗi, nech kǝ ɓǝɓi nafcha, ǝ sǝnwun fǝran kaa ǝn wanchiyowun, chek kǝ Chinwun thla hulafǝrta nan fǝr kwastǝ icha kǝ fee shiyancha. <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" />“Kǝthlǝm ndaˈan, hur chǝkami nat chandǝn fowun nat ǝnɗi yahtusi kǝ chuchinda. Kǝthlǝm ndaˈan nech kǝ saktǝ Kusiˈ i Musa, tǝ ǝnɗi yara fǝ shenuˈchǝ tǝ yahti Farta.”<verse eid="MAT 7:12" /></para>
  <para style="s">Mbandǝ kǝmɗi Farta</para>
  <para style="r">(<ref loc="LUK 7:13-24">Luk 7:13-24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />“Yimam tǝ mikǝnda thla nech ɓeukɓeuk. Kǝthlǝm mikǝn ndǝ kǝ tǝktǝha nechan hang. Paɗ mbandǝyan paˈpa ha tǝ paraɗan. Fǝ yiminchaˈan kǝ huran paɗ terchanda. <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />Paɗ mikǝndǝ kǝ mǝt shishingda, ngguɗyeh, mbandiyan paɗ ˈyangˈyang paraɗan. Fee thlǝ parech sǝ paɗ terwanda wa.<verse eid="MAT 7:14" /></para>
  <para style="s">Thlǝ sinchǝ fee ɗǝfta tǝ wanchiyan</para>
  <para style="r">(<ref loc="LUK 6:43-44">Luk 6:43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />“Mbǝramsǝ tǝ fǝ shenuˈchǝ tǝ yahti Farta kǝ fǝ lekcha. Fee thlǝ ɓech kǝmɗiyowun kǝɗ kaa nafcha. Yi kittaˈan, nechandǝ kǝɗ wanmerucha, fee thlǝ chanchǝ mboro nafchǝ fa. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />Nechowun sǝn tandǝ tǝ weˈtǝ ter ˈyanda. Na fee mbahǝn ɗam wanwulma ɓǝra shelǝma wa? Ndu kǝ mbǝs fee wanshikwata, ǝ ɓǝra fǝrtǝtaha wa? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />Kǝɗu paɗ, chǝk yen ɗǝfta thla nech ndiˈchan, thlǝ nggǝtchan wanchǝ ndiˈchan. Paɗ ɗǝftǝɗi nawakchǝ ndiˈchan, thlǝ nggǝtchan wanchiɗi nawachǝ ndiˈchan. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />Ɗǝfta thla nech ndiˈchan nggǝt wa ɓǝɓi wancha wa, kǝɗu paɗ ɓǝɓi ɗǝfta nggǝt wa wanchǝɗi nech ndiˈchan wa. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" />Nat ɗǝftǝɗi thlǝ nggǝtwakchǝ wanchǝ ndiˈchan, thlǝ chathlanchǝ fee kaɗi, kǝ mǝk fee kǝ hur wata. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" />Kǝthlǝm ndaˈan, tǝ weˈtǝ teri fǝ shenuˈchǝ tǝ yahti Farta kǝ fǝ lekchǝ yu, natwun sǝn tandǝsi.<verse eid="MAT 7:20" /></para>
  <para style="s">Tamwi sǝnwunchǝ wa</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />“Ngga nat thla thlǝ ndiicha wa, ‘Chinda, Chinda’ nech yimndǝ kǝ kutǝrakti hulafǝrta wa. Maangga thla chich ǝnɗi yahtǝ Papa thla nech hulafǝrta wa. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />Ə fartǝ chak mee nafchǝ terchan nandǝ ndii tǝ wa ‘Chinda, Chinda, ngga ǝ ɓasˈǝn tǝ thlǝmwa wa? Ngga ǝ rǝkˈǝn hwaˈarchǝ terchan tǝ thlǝmwa wa? Chǝwaˈan tar ǝna sakaˈinchǝ terchan hur thlǝmwa wa?’ <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />Kǝni ndandǝ tandǝ hayang wa, ‘Nggǝt tamwi sǝnwunchǝ wa. Chakamha tǝnenchi, kun fǝchǝt ɓǝɓi icha.’<verse eid="MAT 7:23" /></para>
  <para style="s">Saktǝ tǝ fǝ tǝnchǝ chap</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />“Kǝthlǝm ndaˈan, nat thla sǝkchǝ shenuˈtǝɗinchiya, paɗ kǝ chit tersi, nechan choktǝ kǝɗ thlǝ sǝnˈǝna thla tinchǝ wirˈyan ɗar fera. <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />Kǝ ɓak ˈyer kaha, ndiiɗ kǝ kuficha, welkǝ ˈyaman ha, thlaˈkǝ rǝnnaa kǝ pok wuran, chǝk tǝ kǝɗu hǝmwaha wa. Kǝthlǝm ɗǝfchǝ fee la tǝnan ɗar fera. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />Nat thla sǝkchǝ shenuˈtǝɗinchiya paɗ kartǝ chǝt tersi, nechan kǝɗ yowun ɓema thla tinchi wiryan ɗar chokita. <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />Kǝ ɓak ˈyer kaha, ndiiɗ kǝ kuficha. Welkǝ ˈyaman ha, thlaˈkǝ rǝnnaa kǝ pok wuran. Chat wuran, hǝmkan ha pǝrǝf.”<verse eid="MAT 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />Kǝ tǝɓang kǝ Yesu mbuˈ ichiɗa, chat nggomndi nafchaˈan sakandak inda tǝ chaˈaɗanˈyan. <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />Kǝthlǝm chaˈanchan tandǝ har kǝɗ nafɗi nech tǝ alkǝtfa, ngga kǝɗ fǝ chaˈandǝ kusiˈ i Musa kaɗ wa.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">Kǝnan Yesu thlǝ hatǝfa tarkwai kaɗi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />Kǝ ɓak Yesu kaha ǝ nggwalan, nggommǝn nafchǝ terchan parakandǝ ndi. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />Chat yowun nefa tǝ hatǝfa tarkwai fa, ɓakan kǝmɗi Yesu kop kan ha kǝ pangngǝnan. Ndakan wa, “Chinda, maa ǝ nggiminfa, no mbahǝn chitǝ kaɗ chiɗchiɗ.”<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />Panan kǝ Yesu herˈyan ha tǝkankan her fa, nakan ndat wa “Nggǝmani, kǝ nen chǝɗchǝɗ.” Chat kǝɗuyu, kǝnkǝ hatǝfa tarkwaiˈyan kaɗi. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />Ndangkǝ Yesu wa, “Suku ndiˈchan, kǝ mbuˈen chikawun ǝnɗi sǝɓcha wa. Paɗ ɗu kǝ pǝneen fatyo pangnda, tǝ paɗ kǝ firin kǝnaupafǝn kǝɗ ǝnɗi mbuˈtǝ kusiˈ i Musa. Kǝ chin kǝɗu kǝthlǝm sǝnnandǝ tandǝs wa, chuchi fee kaɗ chǝɗchǝɗ.”<verse eid="MAT 8:4" /></para>
  <para style="s">Kǝnan Yesu mafati kappa thlǝ yandi Romawech kaɗi</para>
  <para style="r">(<ref loc="LUK 7:1-10">Luk 7:1-10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />Kǝ yim kǝ Yesu kǝ mǝrǝɓ Kaparnahum, chat yowun kapa thlǝ yaandi Romawecha ɓakan kǝmɗiyan. Shiyankan Yesu kǝ kǝsanchi sǝ. <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />Ndakan wa, “Chinda, maafatinchi mǝthlan ɗuk wiri, mbahǝn wa tǝɓǝrtǝha wa. Mǝthlan saa ɓahtǝ kaan.”<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />Ndang kǝ Yesu wa, “Ni ɗǝt kǝ kǝnandǝ kaɗi.”<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />Chat kapa thlǝ yaanan i Romawechaˈan nggǝman kan wa, “Chinda chaˈwisi kǝ ɓen kyeurinchi wa, ndiku ndak, maafatinchi nan kǝndǝ kaɗi. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />Kǝthlǝm nggǝt paɗ nechi hur heri yowuna, tǝpaɗ fǝ yaanchǝs ǝ hur herinchi. Thlǝ ndanchi thleya wa, ‘Ɗu,’ chat kǝ ɗa. Yowun paɗ kǝ ndani wa, ‘Ɓo,’ chat ɓakan. Kǝ ndani maafatinchi wa, ‘Chu ǝn kǝɗa,’ chat chikan.”<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />Kǝ sǝkkǝ Yesu kǝɗu, chat fǝrankan saka inda. Ndang kan fee nech para ndǝ yuwa, “Kittaˈan nati mbuˈowunda, ǝ hur Israˈila tamwi mbǝs thlǝ fǝrkit tǝ alkǝtfǝ kǝɗ thleya wa. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" />Kittaˈan nggǝt sǝnowundǝsi, ndat wa, terchan hur fǝ fǝr kitcha kǝɗ weˈtǝ thleya, nandǝ ɓat ǝ mǝt che farta, tǝ mǝt hǝmǝn farta. Kǝ chok ndǝ ha, kǝ sǝmnda mǝt nggomnda nat tǝ Ibrahim, Ishaku tǝ Yakubu, ǝ kutǝrakti hulafǝrta. <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" />Fee chefee tahsanda kuturakti Farta, paɗ karndǝ fǝr kit, na fee cham tandǝ kesh, kǝ hur wuthla. Mǝɗi na fee tǝta tǝ kang wanthlancha.”<verse eid="MAT 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13" />Chat tǝɓǝrkǝ Yesu ha, ndang kan kapa thlǝ yaandi Roma taˈan wa, “Ɗu kaɗi, na fee chuta kǝɗ ǝnɗi fǝrtu kit.” Chat kǝɗuyu maafaɗan i kapa thlǝ yaanan kǝnkan kaɗi.<verse eid="MAT 8:13" /></para>
  <para style="s">Kǝnan Yesu man nu Biturus kaɗi</para>
  <para style="r">(<ref loc="MRK 1:29-31">Mar 1:29-31</ref>; <ref loc="LUK 4:38-39">Luk 4:38-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />Kǝ yim kǝ Yesu keuri Biturus, chat nakan man nu Biturus ɗuk, tǝ hatǝfa ɓǝɓɓa thlǝfanchi ha. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />Chat tǝkankan herˈyan fa, kalkǝ hatǝfa ɓǝɓɓiˈan ndǝ ha. Thlaˈkan fǝrangkan Yesu ɗǝsǝmnda.<verse eid="MAT 8:15" /></para>
  <para style="s">Kǝnan Yesu nafchǝ kaɗ terchan</para>
  <para style="r">(<ref loc="MRK 1:32-34">Mar 1:32-34</ref>; <ref loc="LUK 4:40-41">Luk 4:40-41</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />Kǝ wulkǝ mǝta, nafchǝ ɓangkandǝ Yesu fee tǝ hwaˈarchǝf terchan. Paɗ rǝkankan hwaˈarchaˈan kesh fiyanda tǝ shenuˈtǝ ndak. Kǝnan kan nat fee kaɗ nech haˈchan. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />Tǝ chit kǝɗu, ndiiɗantǝ ǝnɗi ha mbuˈtǝ fee tǝ me i thlǝ shenuˈtǝ tǝ yahti Farta Ishaya. Ndat wa,</para>
  <para style="q1" vid="MAT 8:17">“Tǝran tǝ huhuthl kak tamǝn kaɗi,</para>
  <para style="q2" vid="MAT 8:17">kǝnan kan hatǝfechˈyamǝn kaɗi.”<verse eid="MAT 8:17" /></para>
  <para style="s">Fee ndech wa nandǝ para Yesu</para>
  <para style="r">(<ref loc="LUK 9:57-62">Luk 9:57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />Kǝ nak Yesu kapa nggomndi nafcha taurandǝ ha, ɗǝfkan kǝ cheendǝ kesh kǝ kǝlaar kufi thlaa. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />Chat ǝ yowun thlǝ chaˈandǝ kusiˈ i Musa kaɗi ɓakan kǝmɗi Yesu, ndakan wa, “Thlǝ chaˈandǝ nafchǝ har, nii parawechi nat kǝ mǝɗi natu ɗǝta.”<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />Nggǝman kǝ Yesu wa, “Charuˈcha tǝ kwichiyandǝsi, ɗiicha tanda tǝ mǝt minchiyanda. Paɗ Waˈi Nefa mǝt mǝndǝyansi arta wa.”<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />Yowun hur kǝmsichiyan ndang kan wa, “Chinda suku kwaɗǝn kǝɗi la thlohandǝ papa, kǝni ɓat parawechi.”<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />Paɗ ndang kǝ Yesu wa, “Paro nenchi, malan mǝmatecha kǝ thlohandǝ mǝmatech ˈyanda.”<verse eid="MAT 8:22" /></para>
  <para style="s">Thlaran Yesu rǝnni er ha</para>
  <para style="r">(<ref loc="MRK 4:35-41">Mar 4:35-41</ref>; <ref loc="LUK 8:22-25">Luk 8:22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />Kǝ yimkǝ Yesu kǝ hur kwombawal, parak kǝmsichiyan ndi. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />Sǝn wandǝs wa, thlaˈkǝ rǝnna ǝ kufiˈan kaan, nak ˈyaman thlaˈta nakan yimndǝ kǝ hur kwombawal taˈan. Paɗ Yesu mǝthlan saˈ ena. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />Ɗǝk Kǝmsichaˈan nahnanda ndang kanda wa, “Chinda, hǝrraˈamǝndǝn, namǝn tǝktǝ ha.”<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />Nggǝman kan tanda wa, “Kǝthlǝm mǝ nat wun lekǝt kǝɗu, kun fǝ fǝr kit ngguɗyeh?” Kǝnan thlaˈta yanan kan rǝnniˈan tǝ pǝrti ˈyam kufiˈan ha, chat nggaskǝ mǝɗan kǝmma.<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />Nafcha sakandak inda ndakanda wa, “Weˈtǝ nafmǝ thleya, thla chika rǝnna ta pǝrti ˈyam kufa fǝrandǝ maanda?”<verse eid="MAT 8:27" /></para>
  <para style="s">Kǝnan Yesu nafchi kaɗ chap naa whaˈarchi fiyanda</para>
  <para style="r">(<ref loc="MRK 5:1-20">Mar 5:1-20</ref>; <ref loc="LUK 8:26-39">Luk 8:26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />Kǝ saˈkan kǝ heshi kufi thla ǝ thle Gadarawa. Nafchǝ chap tǝ hwaˈarchǝfa chekandǝ kesh mǝɗi thlǝ thlohandǝ fee mǝmatecha, ɗǝkandǝ mbǝs ndi. Chok ndǝ kǝ ǝna lekǝt kaan mbahǝn wu yowun mbǝrtǝ ha tǝ minni wa. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />Chat kǝɗuyu hwakanda ndaka nda wa, “Mǝpuchǝ tǝ nggaˈan, chǝ Waˈi Farta? Tǝ ɓen kǝthlǝm kǝ fireˈinchin ɓahta kǝn wanshengnan saˈta wa?”<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />Kǝ pang ngguɗyeh paɗ, fowun kapa chaap kǝllanggarchǝs tandǝ parata. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />Hwaˈarchaˈan shiyan kandǝ Yesu ndaka nda wa, “Maa ǝ cheˈǝnchǝn kesh, pǝkko nggaˈan kǝ hur chaap kǝllanggǝrchiɗa.”<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />Ndangkan tanda wa, “Pǝɗama.” Chat chekandǝ kesh yimkandǝ kǝ hur chaap kǝllanggarchaˈan. Nat chaap kǝllanggarchaˈan rakakandǝ tǝ weshet fa firewh kandǝ kaha tǝ mii chichangngǝnɗi nech hwengnga yimkandǝ kǝ hur hawurtaˈan. Tǝkkandǝ ha hur ˈyaman. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />Fǝ para kǝllanggarchaˈan rakakanda, yimkandǝ kǝ mǝrɓan, chat mbuˈkandǝ kusheˈtaˈan nat, tǝ ǝnɗi sǝɓchǝ tǝ nafchiɗi naa hwaˈarchǝ fiyanda. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />Chat nafchi mǝrɓan chekandǝ kesh kǝ mbǝs Yesu. Kǝ nakandǝ ndi, shiyankanda kǝ maltǝ thle mǝt ˈyandǝ ha.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">Kǝnan Yesu thla saa fatˈyan kaɗi</para>
  <para style="r">(<ref loc="MRK 2:1-12">Mar 2:1-12</ref>; <ref loc="LUK 5:17-26">Luk 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />Chat yimkǝ Yesu kǝ hur kombawal, chen kan ˈyaman pǝɗakan kǝ Kafarnahum, mǝrǝɓɗi maandǝn. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />Tukuthl, fowun nafchi ɓakandǝ tǝ thla saafatˈyan kaɗi, ɗuk ɗar wenicha. Kǝ nak Yesu fǝrkit ˈyanda, ndang kan thla saa faɗanˈyan kaɗ yu wa, “Waˈinchi, tǝran hwirha, kaluchi ɓǝɓi fechˈyo ha.” <verse eid="MAT 9:2" /><verse number="3" style="v" sid="MAT 9:3" />Sǝktǝ kǝɗu, fowun fǝ chaˈandǝ kusiˈ i Musa kaɗi fee nech minni ndangkandǝ raˈan wa, “Nafɗa mǝthlan ˈyara Farta.”<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />Yesu sǝntǝ ǝnɗi natndǝ saktǝ kǝ ɗaran, ndang kan tanda wa, “Kǝthlǝm mǝ, natwun kaɗa ɓǝɓiˈan kǝɗuyu hur wanɗǝkaɗech ˈyowun? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />Yen nech paˈpa, kǝ ndǝ fee wa, ‘Kaluchǝfee ɓǝɓifechˈyo ha wa,’ ndu ndat wa, ‘Thlaˈu kǝ wiˈin’? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />Yah chisi kǝ sǝn wun wa nggǝta Waˈi Nefa alkǝtˈyansi kǝ kallantǝ ɓǝɓifech ha hur heshi.” Chat ndang kan thla saa faɗanˈyan kaɗ wa, “Thlaˈu, tǝru wenichiyo, kǝ pǝɗen kaɗi.” <verse eid="MAT 9:6" /><verse number="7" style="v" sid="MAT 9:7" />Nafan paɗ thlaˈkan pǝɗakan kaɗi. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />Kǝ nak nggomndi nafchaˈan kǝɗu chat lekǝkanda, manangkandǝ Farta thla fǝranchǝ nafcha weˈtǝ alkǝt ini.<verse eid="MAT 9:8" /></para>
  <para style="s">ˈYi Yesu Matiyu kǝ para ndi</para>
  <para style="r">(<ref loc="MRK 2:13-14">Mar 2:13-14</ref>; <ref loc="LUK 5:27-32">Luk 5:27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />Kǝ nak Yesu kǝ pang tǝ wiˈta, nakan yowun nefa thlǝ thlǝt chamnda thlǝ ˈya fee ndǝ wa Matiyu, mǝthlan ɗas mǝt thlǝt chamnda. Ndang kǝ Yesu wa, “Paro nenchi.” Chat thlaˈkǝ Matiyu parakan ndi.<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />Kǝ nak Yesu sǝmˈǝna ǝ wiri Matiyu, terchan fǝ thlǝt chamincha tǝ fowun fen paɗ fǝ ɓǝɓifecha, ɓech kǝ sǝmndǝ tǝ ndi tǝ kǝmsichiyan. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />Kǝ nak Farisiyawech kǝɗu. Chihan kandǝ kǝmsichiyan wa, “Kǝthlǝm mǝ thlǝna thlǝ chaˈanan ˈyowun har sǝmˈǝn tǝ fǝ thlǝt chamincha, tǝ fowun fen paɗ fǝ ɓǝɓifecha?”<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />Kǝ sǝkkǝ Yesu inini ndakan wa, “Fǝ hashas tǝ fecha pandawu ǝn tǝ thlǝ ɗǝpa fata wa, thla nech haɗchan ndak. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" />Ɗama kǝ tausawun mǝ na ndiktǝɗiya sakta. Ndiktǝɗi ndech wa, ‘Thlǝrɗakta yahti mǝɗyowun, ngga thle ɓǝra ichawa.’ Kǝthlǝm ngga ɓechi kǝ ˈya fǝ kafecha wa, ɓechi kǝthlǝm fǝ ɓǝɓifecha.”<verse eid="MAT 9:13" /></para>
  <para style="s">Chǝha mee kǝ ɗar kǝrkuchimnda</para>
  <para style="r">(<ref loc="MRK 2:18-22">Mar 2:18-22</ref>; <ref loc="LUK 5:33-39">Luk 5:33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />Chat ɓak kǝmsichi Yohanna kǝmɗi Yesu. Chǝhan kanda wa, “Mǝchicha nggaˈan tǝ Farisiyawecha thlǝ kǝrchaˈan kwichimnda paɗ kǝmsichiyo kǝrwandǝ kwichimnda wa?”<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />Nggǝman kǝ Yesu tanda wa, “Shikechǝ chima perra nandǝ chǝt sǝɓtǝ hwira maa peˈ chima perriˈan tǝ tanda wa? Na wanshengnan ɓata thla na fee tǝrandǝ chima perriˈan kǝ malfee tandǝ ichǝt nanda. Ə fartiˈni nandǝ kǝr kwichimnda.<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />“Yowunsi nech mbumandǝ ɗohtǝ kapata tǝ yuwa chimbita wa, kǝthlǝm mbumnan nan thlahandǝ kapaɗan kaɗi, thlahtaˈan nan mbǝrandǝ thlaha tangtang. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />Ndu kǝ thlǝr yowun yuwa ˈyam inambi kǝ hur ɗohtǝ kuruɓtǝ fiya wa. Ma ǝ thlǝr fee si, ɗohtǝ kuruɓtǝ fiyan nandǝ ɗathlǝ kaɗi, kǝ thlǝr ˈyam inabi taˈan kaɗi, sǝɓkǝ kuruɓtǝ fiyan kaɗi. Yuwa ˈyam inabi thlǝrkǝ fee kǝ yuwa kuruɓtǝ fiya. Tǝ kǝɗu nggǝ fee kuɓa ˈyam yanngga taˈan, ndu kuruɓtǝ fiyan wa.”<verse eid="MAT 9:17" /></para>
  <para style="s">Kǝnan Yesu nunef kaɗi thla na hatǝfa thlǝr fer fiyan, paɗ thlaˈankan mǝrtǝ wannuwaa</para>
  <para style="r">(<ref loc="MRK 5:21-43">Mar 5:21-43</ref>; <ref loc="LUK 8:40-56">Luk 8:40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />Kǝ nak Yesu ɗar mbuˈandat kǝɗu, chat yowun pangndi wur nggomndi Yahudawecha ɓakan koptǝ pangngǝnan. Ndangkan wa, “Waˈinchi kǝ nuwaa mir chatchat ya. Ɓo kǝ ɗifeen her kafa, nan thlaˈta.” <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />Thlaˈkǝ Yesu parakan nafan. Kǝmsichiyan paɗ parakandǝ ndi.<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />Chat yowun nunefa thla hurech kum nggǝrsǝ chap mǝthlan ɓahtǝ ha tǝ hatǝfa thlǝr fera. Ɓakan tǝ kǝrsǝ Yesu, tǝkan kan her mii kapatˈyan fa. <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />Kǝthlǝm mbuˈchan hur wanɗǝkaɗatˈyan wa, “Maa ǝ tǝkani her chika kapatˈyan fǝ ndak, ni kǝndǝ kaɗi.”<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />Tǝɓǝr kǝ Yesu ha nakan ndi, chat ndakan wa, “Waˈinchi, tǝran hwirha. Fǝr kit ˈyo kǝnuchǝ kaɗi.” Chat kǝnkan kaɗi.<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />Kǝ ɓak Yesu kyeuri pangndi wur nggomndi Yahudawechaˈan, nakan fǝ pe shilacha tǝ nggomndi nafcha tǝt hwanya ǝ wur mǝrtaˈan. <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />Ndangkan tanda wa, “Chem kesh mǝɗya. Wannuwanan ngga tǝ mǝrwa, tǝn saˈyen ndak.” Masan kanda yi njir fata. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />Kǝrsǝ chendǝ tertǝ nggomnan kesh, yimkǝ Yesu kǝ hur kǝnndi wannuwanan kǝskan herˈyan har, thlaˈkan tǝ shishingndǝfa. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />Welkǝ kusheˈtǝ ǝnɗi chǝtǝn ha chǝk tǝ yenni, ǝ thle hahiˈyan.<verse eid="MAT 9:26" /></para>
  <para style="s">Kǝnan Yesu komminchi kaɗ chap</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />Kǝ nak Yesu pǝɗat thlaˈtǝ minni, chat kominchǝ chap parakandǝ ndi, nakandǝ ˈya ndi tǝ alkǝta, “Kǝ haɗuchǝˈǝn fa, Waˈi Dauda.”<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />Kǝ yim kǝ Yesu kǝ yowun wira, ɓak kominchiɗi kǝmɗiyan, chihangkan tandǝ mee wa, “Fǝrwun kit wa nii mbahan kǝnowundǝ kaɗ wa?” Nggǝmankan nda wa, “Aa, Chinda.” <verse eid="MAT 9:28" /><verse number="29" style="v" sid="MAT 9:29" />Kǝna tǝkan her weniti chikawun fa ndakan wa, “Kǝthlǝm fǝr kit ˈyowun na fee kǝnowundǝ kaɗi.” <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />Inkǝ weniti chik yen ha. Kǝn Yesu tǝɗa ndǝ thlǝmech ˈyandǝ kaan ndakan wa, “Kǝ yahwunsi kǝ sǝn yowun ǝnɗi chowun ndi wa.” <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />Paɗ chet ˈyandǝ kesh, nakandǝ fanandǝ kusheˈtǝ Yesu ha chǝk tǝ yeni, ǝ thle hahiˈan.<verse eid="MAT 9:31" /></para>
  <para style="s">Kǝnan Yesu ɓem kaɗi</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />Kǝ nak kominchǝɗi chap yu pǝɗat kesh, ɓak fowun nafchǝ tǝ yowun hishnefa thla njandǝ hwaˈǝrchǝ shenuˈta kǝmɗi Yesu. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />Kǝ chen kǝ Yesu hwaˈarchaˈan kesh, nafɗi mbahan wakchǝ shenuˈtaˈanyu shenuˈkan. Nggomndi nafchaˈan sakandak inda ndakandǝ wa, “Tamwamǝn na weˈtǝ ǝn kǝɗ thleya ǝ hahi Israˈila wa.”<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />Paɗ ndak Farisiyawecha wa, “Tǝ alkǝti kutur hwaˈarcha, thlǝ rǝkandǝn hwaˈarchaˈan kesh.”<verse eid="MAT 9:34" /></para>
  <para style="s">Haɗan nafchǝ Yesu fa</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />Thlaˈtǝ minni Yesu parakan nat mǝrǝɓcha tǝ wanmǝrǝɓcha. Nakan chaˈandǝ kaɗ ǝ hur wur nggomndi Yahudawechaˈan. Nakan ɓas kusheˈtǝ kwastǝ ndik kuturakti hulafǝrta. Nakan kǝnandǝ chǝk ˈyen kumi hashas tǝ fata, tǝ hatǝfech kaɗi. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" />Kǝ nakan nggomndi nafchǝ terchan, haɗan kǝ nafchaˈan fa. Kǝthlǝm tandǝ ɓahtǝ ha, paɗ yowunsi nech kǝsandat su wa. Kǝɗ chohrechǝɗi nawaktǝ thlǝ paratsi. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" />Ndang kǝ Yesu kǝmsichiyan wa, “Tar sǝfaktǝ kaan paɗ nakan fǝ tarchaˈan terwanda wa. <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />Kǝthlǝm ndaˈan shiyaman Chinda thlǝ hǝnggaɗan, kǝ thlǝntǝ fǝ tarcha kǝ chandǝ tar sǝfaktaˈan.”<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">Thlǝn Yesu Kǝmsichiyan kum nggǝrsǝ chap</para>
  <para style="r">(<ref loc="MRK 3:13-19">Mar 3:13-19</ref>; <ref loc="LUK 6:12-16">Luk 6:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />ˈYak Yesu kǝmsichiyan kum nggǝrsǝ chap. Fǝran kan alkǝt tanda kǝ rǝkandǝ ɓǝɓi shemecha, kǝ kǝnandǝ kumi hashas tǝ fata, tǝ chǝk yen hatǝfenǝ kaɗi.<verse eid="MAT 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 10:2" />Ə thlǝm kǝmsichǝɗi kum nggǝrsǝ chap ya. Tǝrkanan Siman (thla thlǝˈya fee wa Biturus) tǝ wanmanan Andrawus, Yakubu waˈi Zabadi, tǝ wanmanan Yohanna. <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />Filibus tǝ Bartalamawus, Toma tǝ Matiyu thlǝ thlǝt chamnda, tǝ Yakubu waˈi Alfiyus, tǝ Taddawus. <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />Siman thla thlǝ yahwakchǝ hahiyan kǝ nggǝranchǝ in kǝrsǝn, tǝ Yahuda Iskaryoti thla hǝyan chǝ Yesu kaɗ kǝmɗi atǝkrechiyan.<verse eid="MAT 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />Thlǝnkǝ Yesu fee kum nggǝrsǝ chap yu, ndang kan tandǝ tǝ alkǝt fa wa, “Kǝ ɗuwun kǝmɗi fee nawakchǝ kǝ Yahudawecha wa. Paɗ kǝ yimwun kǝ yowun mirɓi Samariyawecha wa. <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />Ɗama kǝmɗi Israˈilawecha, fee chokchǝ kǝɗ chohrechiɗi sakecha. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />Maa kun ɗar wiˈta, kǝ wellawun kusheˈtǝɗa ha ndat wa, ‘Kutǝrakti hulafǝrta nduk ha.’ <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />Kǝnan kowun fee kaɗ nech haˈchan. Kǝ thlaˈawun fee mǝrcha. Kǝnan kowun fee kaɗ tǝ hatǝfa tarkwangchǝ fa. Kǝ rǝkawun hwaˈarcha. Thlichowun pafǝn, kun paɗ kǝ fǝrwun pafǝn.<verse eid="MAT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 10:9" />“Kǝ kǝswun wanɗǝɓǝthl i rathlata, tǝ ɓisheta, tǝ ngaˈitǝ tipesha, ǝ hur thlipochiyowun wa. <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" />Kǝɗu paɗ mǝ kǝswun yowun yakwat har kǝthlǝm wiˈta wa, ndu chek tǝ kapata, ndu pahǝmcha, ndu fangnda. Kǝthlǝm thlǝ tera kimsi kǝ chan fee ǝnɗi kǝmchisi.<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />“Nat mirɓa ndu wanmǝrǝɓɗi yimndǝwunsi, kowun nefa thlǝ kafata kǝ chokwun wirˈyan kǝ fartǝɗi natwun pǝɗata. <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />Maa kun yimndǝ kauran, kǝ ndawun ǝn tanda, tǝ shiyandǝ Farta kǝ ɗǝfandech mbǝs ǝn kǝ har. <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />Maa ǝ thlǝ nafchǝɗi wuran wunchi, nda ǝnˈyowun yi chok hashas kǝt ˈyowun kǝ chok tǝ tanda. Paɗ maa ǝ thlǝ wa ndǝ wunchǝ wa, chok hashas kǝt ˈyowun kǝ nggǝranchǝ in kaɗ kǝmɗiyowun. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" />Nat wurɗi, ndu mǝrǝɓɗi karchǝ thlǝt wunchi, ndu ndiktiyowun thlǝfan kowun tǝnaˈtǝ sarchiyowun kaɗi ma ǝ chiwun kesh wuran, ndu ǝ mǝrɓan. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" />Kittaˈan nati mbuˈowunda, fartǝ chak mee, naa nafchi mǝrǝɓ Sodom, tǝ Gomora haɗandǝ Farta fa kaan, mǝ nafchi mǝrǝɓ ini. <verse eid="MAT 10:15" /><verse number="16" style="v" sid="MAT 10:16" />Nggǝt thlǝn wunchi kǝɗ chohrech hur wanmerucha. Kǝthlǝm ndaˈan kǝ chok wun ɗathlchan kǝɗ wuruɓcha, paɗ ngga fǝ wenikicha wa, kǝ chok wun kǝɗ ngguɗungcha.<verse eid="MAT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 10:17" />“Mbǝramsǝ tǝ nafcha, kǝthlǝm nandǝ ɗǝt tǝ wunchi kǝ mit chak mee, paɗ kǝ thlǝfowunchinda hur wur nggominchi yanda. <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />Kǝthlǝm nggǝt paɗ, nandǝ ɗǝt tǝ wunchi kǝ pangngǝn paktecha, tǝ kuturcha. Kǝthlǝm kǝ sǝnawun kusheˈtǝ ndiktǝɗisi thla nech mbinchan ǝ pangngǝnanda, tǝ paɗ pangngǝn fee nawakchǝ kǝ Yahudawecha. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />Fartǝɗi kǝsowun ndǝ nda, kǝ sakowunchǝ inda tǝ ǝnɗi natwun ndikta wa, ndu nechowun mbuˈtǝ wa kǝn wa. Kǝthlǝm na fee fǝrowun ǝnɗi natwun mbuˈta ǝ wanshengngǝn ini. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />Kǝthlǝm ngga kun nech shenuˈta wa, Shemeti Chinwun nech naa shenuˈta tǝmɗiyowun.<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />“Wanmanda nan fǝr wanmanan kǝ ɓǝlan fee, chindǝ paɗ nan fǝr waˈyan kǝ ɓǝlan fee. Wanchi paɗ nandǝ thlaˈandǝ parchinandǝ fa, kǝ ɗǝf ndǝ paɗ kǝ ɓǝlan fee tanda. <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" />Naa nafchǝ terchan karwunchi kǝthlǝm nggǝta. Paɗ nat thla kǝrǝschǝ kǝ ɗukwaɗan nan hǝraˈta. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />Maa tandǝ fǝrowun ɓahta ǝ mǝrǝɓ yowuna, rakakowun kǝ yowuna. Kittaˈan nati mbuˈowunda, nowun tǝɓantǝ taurandǝ nat mǝrǝɓchi Israˈila ha wa, nggǝta Waˈi Nefa ni ɓat kaɗi.<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />“Kimshasi tamchǝ mbǝrandǝ thlaha chaˈanchi har tǝ maanda wa. Ndu paɗ wan wira kǝ pǝɗan tǝ thlǝwirˈyan ha tǝ maanda wa. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" />Kǝmsiˈan nan mbahǝn choktǝ kǝɗ thla chaˈanchi har, wan wir paɗ kǝ chok kǝɗ thlǝwirˈyan. Maa i ndǝ thlǝ wuran wa, ‘Kutur hweˈrǝ,’ nakan, tǝ weˈtǝ ɓǝɓi thlǝm mǝ na fee ˈya nafchi wuran hacha?<verse eid="MAT 10:25" /></para>
  <para style="s">Thla kǝmchǝs kǝ kwaran fee</para>
  <para style="r">(<ref loc="LUK 12:2-7">Luk 12:2-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />“Kǝthlǝm ndaˈan, mǝ kwarawun tanda wa. Nggǝ ǝnsi thla sǝn waktǝ fee, nawaktǝ fee chendǝ kesh hayang wa. Ndu ǝnɗi nech ǝ wuɓta, nawaktǝ fee sǝnda wa. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />Ənɗi mbuˈowundi ǝ wuthla, kǝ mbuˈwun hayang. Ənɗi mbuˈowun ndǝ fee kǝ thlǝmata, mbuˈam tǝ alkǝta kǝthlǝm kǝ sǝk chikawuni. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />Mǝ lekawun nafchiɗi nech mbahǝn ɓǝllandǝ fata paɗ nandǝ mbahǝn ɓǝllanchi shemeɗi nech chet kesh ma mǝr nefa wa. Lekaman thla nech mbahǝn ɓǝllandǝ fata, tǝ shemeɗi nech chet kesh ma mǝr nef nat ǝ wur wata. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />Ngga thlǝ hǝyanchǝ fee chichi chǝ kaɗ chap in tipesh arta wa? Kǝɗu, yowunsǝ arta ǝ hur nanda nech mǝrta, ngga tǝ sǝndi Chinwunsǝ wa. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />Chika waas inchiyowun ǝ shengngan fee. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />Kǝthlǝm ndaˈan, mǝ lekǝwun tanda wa. Kun mbǝrawun chichi chǝ ha tǝ ndǝt kaan.<verse eid="MAT 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />“Nat thla pǝnchǝ wa yaˈan naki ǝ pangngǝn nafcha, nggǝt paɗ ni nggǝmandǝ wa, yin nakan pangngǝn papa thla nech hulafǝrta. <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" />Paɗ nat thla aschǝ in nenchi ǝ pangngǝn nafcha, nggǝt paɗ ni as in ndi ǝ pangngǝn papa thla nech hulafǝrta.<verse eid="MAT 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />“Kaɗowun wa ɓechi, tǝ ɓi tǝ chok hashas kǝta kǝ hur heshi wa. Ngga ɓechi tǝ ɓi tǝ chok hashas kǝta wa, paɗ yaanda. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />Kǝthlǝm ɓechi,</para>
  <para style="q1" vid="MAT 10:35">“‘Kǝ wumani yaanda pǝthlǝr waa tǝ chinnan,</para>
  <para style="q2" vid="MAT 10:35">wannuwaa tǝ manan,</para>
  <para style="q1" vid="MAT 10:35">Nunef paɗ tǝ man chimaɗan.<verse eid="MAT 10:35" /></para>
  <para style="q2">
    <verse number="36" style="v" sid="MAT 10:36" />Atǝkrechi nef paɗ, nandǝ choktǝ kǝ nafchǝɗi nech wirˈyan.’<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />“Nat thla yahchǝ chinan ndu manan kaan mǝ nggǝta, chaˈwasi kǝn kǝ yina wa. Tǝpaɗ nat thla yahchi waˈyan, ndu waˈyan kǝ nuwaa mǝ nggǝta, chaˈwasi kǝn kǝ yina wa. <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" />Nat thla tǝr wakchǝ pallangndiyan kǝ para nenchi (kǝ ɓah ha kǝ mǝra kǝthlǝm nggǝta wa), chaˈwasi kǝn kǝ yina wa. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" />Thla yahchi shishingndiyan nan kuɓata. Thla paɗ ɓǝlandǝ fee kǝthlǝm nggǝta, nan mbǝs shishingndǝ kǝ kweˈkǝchi.<verse eid="MAT 10:39" /></para>
  <para style="s">Tarchi kǝnau pafǝn</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />“Nat thla thlich wunchi tǝ chǝɗchǝɗ tǝ wanɗǝkaɗata, thlǝt nenchi. Nat thla thlich nenchi paɗ, thlǝt thla thlinchi nenchi. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />Nat thla thlich thlǝ shenuˈtǝ tǝ yahti Farta kǝthlǝm thlǝ shenuˈtǝ tǝ yahti Farta nakan, nan mbǝs kǝnau pafǝn i thlǝ shenuˈtǝ tǝ yahti Farta. Paɗ nat thla thlich thlǝ kafata, nakan wa thlǝ kafat nakan, nan mbǝs kǝnau pafǝn i thlǝ kafata. <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />Nat thla fǝranchi tǝɓ sa ˈyem thla nech hashas yowun arta thla nech ngguɗyeh kǝthlǝm tǝn kǝ kimshaˈinchi, kittaˈan nee tam kuɓa kǝnauˈyan wa.”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">Thlǝn Yohana thlǝ chǝt baptisma kǝmsichiyan kǝmɗi Yesu</para>
  <para style="r">(<ref loc="LUK 7:18-35">Luk 7:18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />Kǝ tǝɓangkǝ Yesu mbuˈan ichiɗiya kǝmsichiɗan kum nggǝrsǝ chap yu. Chat thlaˈkan malkan mǝɗan ha, pǝɗakan nakan chaˈandǝ kaɗi tǝ ɓasǝ ǝ wan mǝrǝbchi Galili.<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />Ə fartǝˈini Yohana thlǝ chǝt baptisma ǝ pursuna. Sǝk kan ichiɗi na Kǝristi chǝta, thlǝnkan fowun hur kǝmsichiyan kǝmɗiyan. <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />Kǝ chǝhanda ndat wa, “Chǝ nech kǝ thla nech ɓata wa, ndu kǝ ɗǝf ǝn kǝfat kǝyowun samǝn wa?”<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />Nggǝmang kǝ Yesu tanda wa, “Nggǝramanˈin kǝ mbuˈawun Yohanna ǝnɗi sǝktǝwun tǝ ǝnɗi natwun. <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />Komincha tandǝ naa mǝta, tǝraɗcha tandǝ wiˈta. Fee kǝnandǝ fǝ hatǝfa tarkwangchǝfa kaɗi. Tipengcha tandǝ sǝk mǝta. Fee thlaˈandǝ mǝmatecha. Paɗ fee ɓasandǝ fǝɓahchǝ kwastǝ ndiktǝsi. <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />Mbǝs ǝn har kǝmɗi nat thla thlǝ aswakchǝ in sǝn nenchi hur wanɗǝkaɗech ˈyanda.”<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />Kǝ nak kǝmsichi Yohana pǝɗata, nggak kǝ Yesu ndikta tǝ nggomǝn nafchaˈan kǝ ɗar Yohanna thlǝ chǝt baptisma. Ndakan wa, “Mǝ ɗitwun kǝ nata hur chanjeya? Tǝ ɗǝwun na nafɗi nech kǝɗ mbara pǝpǝmchǝɗi na rǝnna yiraˈandǝyu wa? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />Maa ngga kǝɗu wa, weˈtǝ nafmǝ chet wun kesh kǝ ɗiwun nata? Tǝrchowun wa nowun na thla mǝkchǝ kapechǝɗi na wanɗǝɓithl fǝ manchan wa? Auwa, fee thlǝ mǝkchǝ weˈtǝ kapechiˈini, thlǝ nechandǝ wurchi kuturcha. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />Mǝ hacha chetwun kesh kǝ ɗuwun nata? Thlǝ shenuˈtǝ tǝ yahti Farta wa? Aa, nggǝt mbuˈowunda, mbǝrantǝ thlǝ shenuˈtǝ yahti Farta ha. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />Thleya ndaˈan yarandǝ fee ha kǝ ɓǝrataˈan ndat wa,</para>
  <para style="q1" vid="MAT 11:10">“‘Ni thlǝn thlǝ thlǝndinchi kǝ thlǝ kǝ pangnga.</para>
  <para style="q2" vid="MAT 11:10">Thla nech tahsaandǝ mbandiyo kaɗi, kǝ nen ɓata.’<verse eid="MAT 11:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11" />Kittaˈan nati mbuˈowunda, tamwu fee nggǝt yowun ǝ hur heshiɗiya thla saˈanchǝ Yohana thlǝ chǝt baptisma wa. Nat tǝ kǝɗu, thla nech ngguɗyeh tǝ maanda kuturakti hulafǝrta, mbǝrantǝ Yohana ha tǝ maanda. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" />Ə thlǝhaɗi nggaktǝ Yohanna thlǝ chǝt baptisma ɓasa kǝ nakanya, kuturakti hulafǝrta mǝthlan saa ɓahta. Fee nech fǝr ɓahtaˈan paɗ fen yahchǝs kǝ thlǝnandǝ kuturakti hulafǝrtaˈan tǝ alkǝta. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />Kǝthlǝm chaˈati Musa tǝ fǝ shenuˈchǝ yahti Farta nat, ndikndǝ kǝ ɗar kutǝraktaˈan kǝn Yohanna ɓata. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" />Paɗ manowun nggǝmandǝ tǝ thlǝn yanda, Yohanna mǝthlan nech kǝ Iliya thla nda fee wa nan nggǝr ɓata. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />Nat thla nech sǝk ǝnɗi nati mbuˈta, kǝ sǝka.<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />“Paɗ tǝ mii nati kaɗa ndǝ nafchi yuwa heshi ɗiya? Nii kaɗandǝ tanda tǝ wanwanchǝɗi nech chokta ǝ thlǝmo nakandǝ ˈya shikechǝ tarakchiyanda. Nakandǝ ndat wa.<verse eid="MAT 11:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17" />“‘Pewunchǝˈǝn shilatǝsi,</para>
  <para style="q2" vid="MAT 11:17">karkowun rǝɓta.</para>
  <para style="q1" vid="MAT 11:17">Inkaˈǝn ˈyamǝs tǝt mǝrta,</para>
  <para style="q2" vid="MAT 11:17">karkowun tǝta.’<verse eid="MAT 11:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18" />“Kǝthlǝm kǝ ɓak Yohanna, sǝmwa ɗǝsǝmǝnɗi thlǝ sǝmndǝ nafcha wa, ndu kǝ satǝ ˈyam inabi, ndaka nda wa, ‘hwaˈarchansi.’ <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />Kǝ ɓaki nggǝta Waˈi Nefa nggǝt sǝmnda nggǝt sata, ndaka nda wa, ‘Thlǝ sheura, tǝ thlǝ saa mballa. Shiketǝ fǝ thlǝt chamincha tǝ fowun fen paɗ fǝ ɓǝɓifecha.’ Paɗaa, tarchiɗi thlǝ chǝt nefa ndaˈan thlǝ pǝnchǝ wa, wun nech kǝ thlǝ sǝn ǝna.”<verse eid="MAT 11:19" /></para>
  <para style="s">Mǝrǝɓchiɗi tǝrwaktǝ nafchiyandǝ ha</para>
  <para style="r">(<ref loc="LUK 10:13-15">Luk 10:13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />Nggakkan ˈyanandǝ nafchi mǝrǝɓchaˈan ha, mǝɗi chǝtǝn tarchiyan yi ǝna sakaˈincha, kǝthlǝm nafchaˈan tǝrwandǝ ha wa. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />“Aiˈyo, nafchi Korasinu. Aiˈyo, nafchi Betsaida. Kǝthlǝm ma ǝna tar sakaˈincha chit fee ǝ mǝrǝɓchi yowun, chǝt fee ǝ Taya tǝ Sidon, mǝ tǝr ndǝ ha nduk wa. Kǝ pandǝ sǝɓtǝ kapecha, tǝ paɗ kǝ pǝt ndǝ ficha kǝ fechˈyanda, kǝthlǝm kǝ pǝntǝ tǝrtǝyandǝ ha. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />Paɗ nggǝt mbuˈowunda, ǝ fartǝ chakmee na fee shishandǝ nafchi Taya si tǝ nafchi Sidom mǝ kun. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />Kun nafchi mǝrǝɓ Kafarnahum, choˈowun chan fa wa na fee ɗǝt tǝ wunchi kǝ hulafǝrta wa? Auwa, ngga kǝɗu wa, tǝn fee cham wunchi kǝ hur wata. Maa ǝna tar sakaˈinchiɗi chǝt fee ǝ pǝthlǝr wun, mamwa fen chǝt fee ǝ Sodom, mǝ mǝthlansi kǝ ɓukwiya. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" />Paɗ nggǝt mbuˈowunda, fartǝ chak mee na fee shishandǝ nafchi Sodom si mǝ kun.”<verse eid="MAT 11:24" /></para>
  <para style="s">Ndech Yesu wa, ɓam kǝmɗinchi, kǝ fǝrowunchi yipta</para>
  <para style="r">(<ref loc="LUK 10:21-22">Luk 10:21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />Ə wanshengngǝn chǝˈini nda Yesu wa, “Chuchi usoko, Chinda, chaɗi nech kǝ Chinda yi hulafǝrta tǝ heshi. Kǝthlǝm wuɓeen ichǝɗa kǝmɗi fǝ mbǝrˈicha tǝ fǝ hurˈincha. Paɗ pǝnanko wanwancha. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />Kǝɗu yu Chinda, kǝthlǝm chin keˈkeˈ kǝɗ ǝnɗi yahtusi.<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />“Papa fǝritǝ chikami nat. Yowunsi sinchǝ Wanan wa Chinan ndak, paɗ yowunsi sinchi Chinan wa Wanan ndak. Tǝ paɗ fee tatǝ Wanan pǝnangkan tandǝ Chinan.<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />“Ɓam kǝmɗinchi, kun tǝɗi hatech ha nat, kun paɗ ɓahtǝ ha tǝ sǝfcha fee nech lǝklǝk ǝ indiyowun. Ni fǝrowun yiptǝ paɗ. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />Fǝram inchiyowun kǝ nowun para ǝnɗi yahti, kǝɗ ǝnɗi thlǝ fǝrtǝ thlahuɗat ɓǝratiyan kǝ palangngan fee ɗǝftǝ palangnan kǝ ɓǝryu. Kǝ chaˈowun paɗ mǝɗinchi, kǝthlǝm nggǝt maan indǝs finchi wa. Tǝ paɗ thlǝ chǝt tar hunandǝ wanɗǝkaɗat ha. Paɗ nowun mbǝs yipta wanɗǝkaɗech ˈyowun. <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />Kǝthlǝm wanɗǝ palangndinchi paˈpa. Sǝftǝɗi nati ɗǝf wunchi kǝ tǝrwun paɗ, lǝklǝk wa chǝk ngguɗyeh.”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">Chǝha mee kǝ ɓǝra fartǝ yipti Yahudawecha</para>
  <para style="r">(<ref loc="MRK 2:23-28">Mar 2:23-28</ref>; <ref loc="LUK 6:1-5">Luk 6:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />Ə fartǝˈini, far yipti Yahudawecha. Yesu tǝ kǝmsichiyan mbǝr kandǝ ha tǝ hǝngga alkama. Kǝmsichiyan paɗ mitǝfiˈyanda, nggak kandǝ ɓerǝt wan alkama taˈan, nakandǝ kangnda. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />Kǝ nak Farisiyawechǝ kǝɗu, ndang kanda wa, “No, kǝmsichiyo tandǝ chǝt ǝnɗi ˈyata kusiˈ i Musa kǝ chǝ fee far yipta wa.”<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />Nggǝmang kǝ Yesu tanda wa, “Awi, tamwowun changgandǝ ǝnɗi chǝt Dauda tǝ shikechǝ wiˈtiyan, fartǝɗi naa mitǝ fiyanda wa? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />Yimkan Wiri Farta, kangkan kwasaɗi tahsandǝ fee ha. Thla kǝmwakchǝsi chǝka mǝthlan ndu shekechǝ wiˈtiyan kǝ kang nda wa, fǝ pangngǝn chǝ ndak thlǝ kangcha. <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />Ndu changgawak nowun ǝ hur kusiˈ i Musa ndat wa, pangngǝncha tǝr wandǝ fartǝ yipta kǝɗ kaa ǝna wa? Paɗ chokwandǝ kǝ fǝ sǝɓanchi kaɗ wa. <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />Nggǝt mbuˈowunnda, thla ɓǝranchǝ kǝtǝn shitǝ ha, mǝthlan mǝɗiya. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" />Maa tǝ sǝn wun saktǝ nggaˈal ndik taˈan ndat wa, ‘Kafat yahti, ngga thle ɓǝra icha yahti wa.’ Mǝ nowun chakan mee fee chǝwakchǝ ɓǝɓifata wa, chǝndǝ ɓǝɓifata wa. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />Kǝthlǝm nggǝta Waˈi Nefa nggǝt nech kǝ Chinda yi fartǝ yipta.”<verse eid="MAT 12:8" /></para>
  <para style="s">Kǝnan Yesu thla saa herˈyan kaɗi</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />Malkǝ Yesu minni ha yimkan kǝ hur wur nggomndiyanda. <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />Yowun nefsi minni thla saa herˈyan kaɗi. Fowun Farisiyawecha chǝhanka ndǝ mee Yesu ndakanda wa, “Kimsi ǝ kusiˈ i Musa kǝ kǝnan fee yowun kaɗ far yipta wa?” Chihechandǝ mi ini kǝthlǝm kǝ kǝsandǝ tǝ ǝnfa.<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />Nggǝmankǝ Yesu tanda wa, “Wun ǝ hurwun naa chohratyansi, hǝm kan kǝ kwiya far yipta. Awi thlǝ chohraɗan nen kǝtan chǝ kesh wa? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />Nefa pǝɗantǝ chohrat ha kaˈan, kǝthlǝm ndaˈan ndiˈchansi kǝ chǝ fee kaakǝta far yipta.”<verse eid="MAT 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13" />Ndang kǝ Yesu nafan wa, “Panan herˈyo ha.” Panan kan ha chat kǝɗu yu kǝn kǝ haran kaɗi, chokkan kǝɗ har thlaa. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />Paɗ chek Farisawechaˈan kesh sakankandǝ ha ǝ mbanɗi nat ndǝ ɓǝllandǝ Yesu.<verse eid="MAT 12:14" /></para>
  <para style="s">Ndiiɗ ǝnɗi ha mbuˈtǝ Ishaya</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />Kǝ Sǝnkǝ Yesu ǝnɗi nech sǝɓta, malkan minni ha. Parak tertǝ nggomǝn nafchǝ ndi. Kǝnan kan fee nech haˈchan kaɗ nat. <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />Tǝɗan kan thlǝmechˈyanda kǝ mbuˈandǝ nef kusheˈtaˈan wa. <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />Ichiɗiya chich fee kǝthlǝm kǝ ndiiɗan fee ǝnɗi mbuˈtǝ thlǝ shenuˈtǝ tǝ yahti Farta Ishaya ndat wa.<verse eid="MAT 12:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />“Ə mafatinchiya thla tati,</para>
  <para style="q2" vid="MAT 12:18">mǝthlan yahti, thlǝ sǝkchǝ mbǝnanfǝ kaan.</para>
  <para style="q1" vid="MAT 12:18">Nii ndiiɗandǝ kaɗ tǝ shemeta,</para>
  <para style="q2" vid="MAT 12:18">paɗ nan chak mee yi kit kǝmɗi fee nawakchǝ kǝ Yahudawecha.<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />Nee ass inda wa, ndu kǝ shenuˈ tǝ alkǝta wa,</para>
  <para style="q2" vid="MAT 12:19">nǝ fee sǝk ɓǝratan ǝ njartǝ mbanchǝɗi pǝthlǝr wurcha wa.<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />Kwafɗi nech nduk chet kaɗi, nee chenchǝ kaɗ wa,</para>
  <para style="q2" vid="MAT 12:20">Tǝkassɗi nech nduk lifta, nee lifan chǝ wa.</para>
  <para style="q1" vid="MAT 12:20">Nechan nat kǝɗuyu kǝ fartǝɗi natǝn chak mee yi kit.<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />Fee nawakchǝ kǝ Yahudawech paɗ, nandǝ ɗǝf wanɗǝkaɗat kǝ thlǝman.”<verse eid="MAT 12:21" /></para>
  <para style="s">Yesu tǝ kutur hwaˈarcha</para>
  <para style="r">(<ref loc="MRK 3:20-30">Mar 3:20-30</ref>; <ref loc="LUK 11:14-23">Luk 11:14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />Ɓan kǝ fee thla na hwaˈarchǝ fiyan shenuˈwa wa, paɗ komnda. Kǝ nan kǝ Yesu kaɗi, nggakkan shenuˈta, tǝ paɗ mǝthlan namǝta. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />Nat nafchaˈan sakandak inda, nda kanda wa, “Thleya, ngga mǝthlan nech kǝ Waˈi Dauda wa?”<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />Paɗ kǝ sǝkkǝ Farisiyawechǝ kǝɗu, nda kanda wa, “Tǝ alkǝti kutur hwaˈarcha thlǝ kǝtandǝ nafɗiya hwaˈarchǝ kesh.”<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />Nakan tapi sǝn Yesu ǝnɗi nat ndǝ kaɗata, ndangkan tanda wa, “Nat kuturaktǝɗi chakchǝ ha chap, tandǝ chǝt atǝkrechi tǝ raˈan. Paɗ nee mǝn chap wa. Paɗ ndu mǝrɓa ndu wira thla chakchǝ ha chap, tandǝ chǝt atǝkrechi tǝ raˈan, paɗ nee thlar ha wa. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />Maa hweˈrǝ thlǝ kǝtanchan hweˈrǝ kǝsh, tǝn yaandǝ tǝ indiyan hacha. Kǝɗu nech kuturaktǝyan mǝndǝ chap wa kǝni? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />Maa tǝ alkǝti kutur hwaˈarchǝ thlǝ kǝtandi hwaˈarchǝ kesh, tǝ alkǝti wun thlǝ kǝtandǝ kǝmsichiyowun kesh? Kǝthlǝm ndaˈan kǝmsichiyowun nech chakowun mee kǝ ɓǝrataˈan. <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />Maa nggǝt thlǝ chǝchi ter tǝ Shemeti hulafǝrta kǝ rǝkani hwaˈarchǝ kesh, awi, kuturakti hulafǝrta ɓi kǝmɗowun ha cha.<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />“Nǝ fee mbahǝn yim keuri nefa thla nech kwaˈkwaˈ kǝ haran fee ichiyan wa. Maangga tǝ kǝnan fee kwaɗǝn, kǝn fee mbahǝn kohandǝ ichǝɗi wirˈyan wa.<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />“Thla nawakchǝ tǝ nenchi, tǝn kǝ aterekǝtǝna, paɗ nat thla nggomawakcha tǝ nggǝta tǝn wellandǝ kaɗi. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />Kǝthlǝm ndaˈan nggǝt mbuˈowunda, na fee mbahan kallandǝ nafchǝ chǝk yen weˈtǝ ɓǝɓi faɗi chǝt nda. Paɗ nat thla erech Shemeta nǝ fee kalanchǝ ɓǝɓi fat ˈyan ha wa. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" />Nat thla ndikchǝ sǝɓtaˈan kǝ ɗar nggǝta Waˈi Nefa naa fee kallandǝ ha. Paɗ nat thla ndikchǝ sǝɓtaˈan kǝ ɗar Shemeta thla chǝɗchǝɗ nǝ fee kallanchǝ ha wa, ndu nakanya ndu yuwa heshiɗi nech ɓata.<verse eid="MAT 12:32" /></para>
  <para style="s">Thlǝ sǝnchi fee ɗǝfta tǝ weˈtǝ wanchiyan</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />“Maa ɗǝfwun ɗǝftowun kǝn ndiˈchan, nan nggǝt wanchǝ ndiˈchan. Maa ɗǝfwowun ɗǝftowun kǝn ndiˈchan wa, nan nggǝt wanchǝɗi nawakchǝ ndiˈchan. Kǝthlǝm thlǝ sǝnchǝ fee ɗǝfta tǝ weˈtǝ wanchǝɗi thlǝ nggǝttǝn. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" />Nakan kun ɓǝɓi nafcha kǝɗ wan pandecha, tǝ kǝn natwun mbuˈ kaa icha? Kǝthlǝm tertǝ ǝnɗi nech hur wanɗikaɗata, ndaˈan thlǝ mbuˈtǝ mee. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />Kaa nefa, mǝt ɗǝf kaa ichi yan ha, thlǝ kǝtanchan kwastǝ ǝn kesh. Ɓǝɓi nefa, mǝt ɗǝf sǝɓtǝ ǝnˈyan ha, thlǝ kǝtanchan sǝɓtǝ ǝn kesh. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />“Kittaˈan nggǝt mbuˈowunda, far chak mee, nat koha shenuˈchǝɗi chǝt nafcha, nan mbuˈ ǝnɗi chich mbuˈtǝndǝ kǝɗu. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />Kǝthlǝm tǝmɗi shenuˈtiyo na fee hǝraˈuta, ndu kǝ kǝnuchǝ fee.”<verse eid="MAT 12:37" /></para>
  <para style="s">Fowun nafchǝ kata kǝ pǝnandech fee ǝna saka inda</para>
  <para style="r">(<ref loc="MRK 8:11-12">Mar 8:11-12</ref>; <ref loc="LUK 11:29-32">Luk 11:29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />Fowun Farisiyawecha tǝ fǝ chaˈandǝ kusiˈ i Musa kaɗi ndang kanda wa, “Thlǝ chaˈanan kaɗi, yahˈǝnsi kǝ pineˈinchǝn ǝna saka inda. Kǝthlǝm kǝ pǝnaˈanchi wa, ɓecho hulafǝrta.”<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />Nggǝmankǝ Yesu tanda wa, “Kun ɓǝɓi nafchi, fǝlaucha, yi yuwa heshiɗiya. Kun kata kǝ pǝnowun chǝ fee ǝna saka inda ǝ hulafǝrta, paɗ nǝ fee pǝnowunchǝ wa. Maangga yi Yunana thlǝ shenuˈtǝ tǝ yahti Farta ndak wa. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />Kǝɗ ǝnɗi mǝndǝ Yunana mahkan wita tǝ farta, mǝthlan hwiri kapa yirfa. Kǝɗu paɗ na nggǝta Waˈi Nefa chǝt mǝndǝ mahkan witǝ tǝ farta ǝ hur kwaa. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />Far chak mee nafchi Neneba nandǝ thlaˈta ɓukwa tǝ nafchi yuwa heshiɗiya, kǝ pǝnandǝ nafchi yuwa heshiɗiya wa chǝ wandǝ keˈke wa. Kǝthlǝm fen tǝrndǝ ha kǝthlǝm ɓasi Yunana. Tǝ paɗ nakanya, thla mbǝranchǝ Yunana ha mǝthlan mǝɗya, paɗ tǝrwowun ha wa. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />Far chak mee, kwitir kǝ nunefa yi hahi Sheba, nan thlaˈtǝ ɓukwa tǝ nafchi yuwa heshiɗiya. Kǝ pǝnanchǝ nafchi yuwa heshiɗiya wa, chǝwandǝ keˈke wa. Kǝthlǝm ɓechan thlaˈtǝ ndukwa heshi kǝ sǝkti mbǝr ndikti kwitira Solomon. Nama paɗ thla ɓǝranchǝ Solomon ha mǝthlan mǝɗya, paɗ tǝrwowun ha wa.”<verse eid="MAT 12:42" /></para>
  <para style="s">Nggǝrandi ɓǝɓi shemet in kafi nefa</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />“Maa ǝ chi ɓǝɓi shemet kesh fi nefa, thlǝ nechan wiˈtǝ michǝɗi nawaktǝ emsi, kǝthlǝm kǝ mbǝstǝ mǝt yipta. Paɗ ma mbǝswa wa, <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />ndakan wa, ‘Ni nggǝrandǝˈin kǝ wurɗinchi maathli ha.’ Kǝ ɓakan nat yowunsi wa, paˈan fee kaɗi, paɗ thlaɗan fee ichiɗi nech wuran. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />Nggǝran kan in kǝ har pongngǝn shemecha muɗ, fee mbǝranchǝ ha tǝ ɓǝɓifata, kǝ ɓandǝ yimndǝsi kǝ chokndǝ ha wuran. Kǝ kǝrsa, chokti nǝfˈini nan mbǝrandǝ thla ha tǝrkwathl kanan. Kǝɗu natǝn nata tǝ ɓǝɓi nafchi yuwa heshiɗiya.”<verse eid="MAT 12:45" /></para>
  <para style="s">Man Yesu tǝ wanmanchi Yesu</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />Kǝnak Yesu ɗar ndikˈtǝ tǝ nggomnan, manan tǝ wanmanchǝ Yesu tandǝ heshi. Yahndǝ kǝ shenuˈndǝ tǝ ndi. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />Ndangkǝ yowun hur nggomnan wa, “Mu tǝ wanmanchuwa thlarndǝ ha ǝ heshi. Yahndǝs kǝ shenuˈndǝ tǝ wechi.” <verse eid="MAT 12:47" /><verse number="48" style="v" sid="MAT 12:48" />Paɗ nggǝman kǝ Yesu nafan wa, “Wun nech kǝ yaa, paɗ wun nech kǝ wanmanchǝn kǝ hǝssa?” <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />Pǝnkan kǝmsichiyan tǝ hera ndakan wa, “Feeya nech kǝ yaa tǝ wanmanchǝna. <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />Kǝthlǝm nat thla chich ǝnɗi yahtǝ Papa thla nech ǝ hulafǝrta kǝ cha, mǝthlan nech kǝ wanmana kǝ hǝsnefa, tǝ nunefa, tǝ yaa.”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">Wuɓtǝ ndikta tǝ nefa thlǝ weˈya weˈta</para>
  <para style="r">(<ref loc="MRK 4:1-9">Mar 4:1-9</ref>; <ref loc="LUK 8:4-8">Luk 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />Kǝmǝn fartiˈni chek Yesu kesh ǝ hur wuran, pǝɗakan choktǝ ha mii hawurta, kǝthlǝm kǝ chaˈanchi nafchi har. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" />Tertǝ nggommǝn nafchǝ tauran kandǝ ha, chich yimndǝn kǝ hur kombawal chokkan ha, paɗ nat tertǝ nggommǝn nafchaˈan thlarkandǝha mii hawurtaˈan.<verse eid="MAT 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 13:3" />Mbuˈankan ichǝ tanda terchan tǝ sakchaˈan, ndat wa, “Thlǝ huɗatsi ɗikan kǝ hǝngga kǝthlǝm kǝ weˈya weˈta. <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />Mǝthlan hur weˈya weˈtaˈan, fowun weˈchaˈan hǝmkandǝ kǝ hur mbanda, ɓak ɗiicha chehanda. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />Fowun paɗ hǝmkandǝ kǝ ɓǝra fǝrtǝɗi nech ɗar fera. Tifkandǝ kesh lelet kǝthlǝm fǝrtǝɗi nech minni hwengnga wa. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />Paɗ kǝ tǝkkǝ wat fartǝ ha, lifirkandǝ kaɗi, hwarkandǝ kaɗi, kǝthlǝm thlaarchǝyandǝ pawandǝ fat ha kǝ hahǝ kaan wa. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />Fowun weˈtaˈan hǝmkandǝ kǝ mǝɗi na tahchǝsi. Mankanda, njipang kǝ tahchǝ tanda. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />Fowun weˈchaˈan paɗ hǝmkandǝ kǝ kwastǝ haha. Nggǝt kandǝ wancha kumchǝt kum (100), fowun kumchit mitcha (60), fowun paɗ kumchit mahkan (30). <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />Nat thla yahchǝ kǝ sǝktǝ ǝnɗi nati mbuˈta, kǝ sakanchǝ ha.”<verse eid="MAT 13:9" /></para>
  <para style="s1">Mbuˈ Yesu ǝnɗi chicha chǝtǝn ter tǝ wuɓtǝ ndikcha</para>
  <para style="r">(<ref loc="MRK 4:10-12">Mar 4:10-12</ref>; <ref loc="LUK 8:9-10">Luk 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />Ɓak kǝmsichi Yesu kǝmɗiyan, chǝhan kanda wa, “Kǝthlǝm mǝ thlǝ natu chǝt ter tǝ wuɓtǝ ndikcha maachǝ shenuˈtǝ tǝ nafcha?”<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />Nggǝman kǝ Yesu tanda wa, “Kun malowunchǝ fee kǝ sǝnwun saktǝ kuturakti hulafǝrta, paɗ fen fǝrawu fee tanda wa. <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" />Chikawuni thla naa ǝnˈyansi naa fee chekandǝ kafˈyan tǝ paɗ kǝ mbǝs manchan. Thla nawaktǝ ǝnˈyansi, chǝka thla nessan nguɗyeh naa fee thlǝta. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />Ənɗi chich thlǝ ndikti tǝ wuɓtǝ ndiktǝ kǝmɗiyanda, ndaˈan nech kǝ, “Kǝthlǝm chika thlǝ nechandǝ ɗimbanda, nawanda. Thlǝ kechandǝ thlǝmat ha, paɗ sǝk wanda wa, ndu paɗ kǝ wathlandech ha. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />Ə mǝɗyanda mbuˈtǝ Ishaya thlǝ shenuˈtǝ tǝ yahti Farta ndiiɗ ha kǝ ɓǝra tǝnanda. Ndakan wa,</para>
  <para style="q1" vid="MAT 13:14">“Nowun naa sǝktǝ tǝ thlǝmechˈyowun,</para>
  <para style="q2" vid="MAT 13:14">paɗ nee wathlowun chǝ ha wa.</para>
  <para style="q1" vid="MAT 13:14">Nowun naa ndǝpat ha tǝ wenitǝyowun,</para>
  <para style="q2" vid="MAT 13:14">paɗ nowun sǝn ǝnɗi nech huran wa.<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />Kǝthlǝm wanɗǝkaɗati nafchiɗa shin kaɗi,</para>
  <para style="q2" vid="MAT 13:15">thlǝ chanchan tandǝf ˈyangˈyang kǝ sǝkndǝ tǝ thlǝmechˈyanda.</para>
  <para style="q2" vid="MAT 13:15">Paɗ nggǝlandǝ wenitǝyanda</para>
  <para style="q2" vid="MAT 13:15">kǝthlǝm mǝ nandǝ tǝ wenitǝyanda wa,</para>
  <para style="q1" vid="MAT 13:15">paɗ mǝ sǝkndǝ tǝ thlǝmechˈyanda wa.</para>
  <para style="q2" vid="MAT 13:15">Kǝthlǝm kǝ sǝnndǝ sakchaˈan ǝ wanɗikadechˈyanda wa,</para>
  <para style="q2" vid="MAT 13:15">nech ɗǝf tandǝ kǝ malandǝ ɓǝɓifechˈyanda. Kǝ nggǝrandǝˈin kaɗ kǝmɗinchi, nggǝt paɗ kǝ kǝnani tandǝ kaɗi.<verse eid="MAT 13:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="MAT 13:16" />Mbǝs ǝnhar kǝmɗi wenitiyowun, kǝthlǝm thlǝ nechandǝ mǝta. Thlǝmechˈyowun paɗ kǝɗu kǝthlǝm thlǝ sǝkchanda. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />Kittaˈan nati mbuˈowunda. Fǝ shenuˈtǝ tǝ yahti Farta, tǝ kaa nafcha terchan mǝthlan kwaskwassa tandǝ kaan, kǝ nandǝ ǝnɗi nat wun nata, paɗ nawanda wa. Paɗ kǝ sǝk ndǝ ǝnɗi natwun sǝkta, paɗ sǝk wanda wa.”<verse eid="MAT 13:17" /></para>
  <para style="s">Mbuˈ Yesu saktǝ wuɓtǝ ndiktǝɗi chǝtǝn kǝ dar nafɗi weˈech weˈta</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />“Kamthlǝmat ha kǝ sǝkwun saktǝ wuɓtǝ ndikta tǝ nefa thlǝ weˈya weˈta. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />Sǝk fowun nafchǝ kusheˈtǝ saktǝ kuturakta paɗ wathlawu kusheˈtan tandǝ ha wa, ɓak hweˈrǝ thlǝnandǝ ǝnɗi hǝftǝ fee hur wanɗǝkaɗati nafan. Thleya nech kǝ weˈtǝɗi hǝftǝ fee ɗar mbanda. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />Weˈtǝɗi hǝmchǝ kǝ ɗar fǝrtǝɗi farɗi paɗ, mǝthlan nech kǝ nafɗi sǝkchǝ ndikti kuturakti hulafǝrta, chat thlǝ kan tǝ wanɗǝkaɗat chǝɗchǝɗ. <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />Paɗ nakan pawa thlaarchǝ ha ndiˈchan wa, kǝrǝs kandǝ yi wanmǝnchǝ ngguɗyeh. Kǝ ɓak ɓahta kǝthlǝm ndik kuturakti hulafǝrta, chat nggǝrang kandǝ in kǝrsǝn hur fǝr kitˈyanda. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />Weˈtǝɗi hǝmchǝ kǝ hur tahchǝ paɗ, mǝthlan nech kǝ nafɗi sǝk chǝ ndik kuturakti hulafǝrta. Ɓak ɓillacha yi heshi, tǝ yah wurmakta njipang kan ndiktaˈan, chokkan pawa wanchǝ kafa wa. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />Weˈtǝɗi hǝmchǝ kǝ kwastǝ mǝt paɗ, mǝthlan nech kǝ nafɗi maa sǝktǝ ndik kuturakti hulafǝrta, paɗ wathlankǝ ndiktaˈan ha. Pakan wanchǝ kaf yowuna kumchǝt kum (100), yowun kumchǝt michcha (60), ǝ yowun paɗ kumchǝt mahkan (30).”<verse eid="MAT 13:23" /></para>
  <para style="s">Wuɓtǝ ndikta tǝ ushina hur alkama</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />Nggǝr kǝ Yesu mbuˈan wuɓtǝ ndiktǝ tanda ndakan wa, “Naa fee mbahan kaɗandǝ kutǝrakti hulafǝrta tǝ nafɗi hǝfchǝ weˈtǝ ndiˈchan ǝ hǝnggǝyan. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />Paɗ ǝ wanshengngǝnɗi na chǝkawun saˈena, atekretiyan ɗǝkan hǝf weˈtǝ yowun ushina ǝ hǝnggi alkama, pǝɗakan kumichaˈan. <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />Kǝ tif kǝ alkamataˈan mankan, nggakkan chendǝ wanɗar indǝ kesh kǝ nggǝt tǝ wancha, mankǝ usunchaˈan paɗ. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />Fǝ tarchi thlǝwuran ɓakandǝ chǝhan mee wa, ‘Thlǝ wira, awi, ngga kwastǝ weˈta hǝftu ǝ hǝngiyo wa? Ɓech usunchiɗiya ayi?’<verse eid="MAT 13:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28" />“Ndangkan tanda wa, ‘atǝkretǝna chich ǝnɗiya.’</para>
  <para style="p" vid="MAT 13:28">“Ndangkǝ fǝ tarchiyan wa, ‘Yehǝnsi kǝ ɗǝˈǝn ɓǝtandǝ usunchaˈan kaɗ wa?’<verse eid="MAT 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29" />“Paɗ ndakan wa, ‘Auwa, maˈ ya kan ɓǝtandǝ usunchaˈan kaɗi, nowun ɓǝtandǝ kaɗ nat tǝ alkamataˈan. <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />Malaman usunchaˈan kǝ manndǝ ɓukwa tǝ alkamataˈan kǝ fartǝ hathla. Far hathlan ni ndaandǝ fǝ hathl chaˈan wa, tǝrkwathl kan ǝnɗi natndǝ chǝta. Kǝ hwaˈchandǝ usunchaˈan kǝ kǝthlar, kǝ kǝnanda njir njir, kǝ njang fee kaɗi. Kǝrsaɗan paɗ, kǝ wumawun alkamataˈan kǝ thlǝrwun kǝ hur ɓiɗǝuwinchi.’”<verse eid="MAT 13:30" /></para>
  <para style="s">Wuɓtǝ ndikta tǝ weˈtǝ wan mastad</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />Nggǝr kǝ Yesu fǝran tandǝ yowun wuɓta ndikta ndakan wa, “Kuturakti hulafǝrta nechan kǝɗ weˈtǝ mastad thla tǝrtǝ yowun hǝfkan ǝ hǝnggǝyan. <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />Chǝka nakan mǝthlan nech ngguɗyeh hur takǝt weˈcha, paɗ maa menni, thlǝ pǝɗanchan takǝt ichiɗi ha nech hur sǝsata tǝ manda. Kǝ ɓǝ ɗiicha tahǝs kǝnndǝya nda ǝ wanharchaˈan.”<verse eid="MAT 13:32" /></para>
  <para style="s">Wuɓtǝ ndikta tǝ yisti</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />Nggǝr kǝ Yesu fǝran tandǝ wuɓtǝ ndikta. Ndakan wa, “Kuturakti hulafǝrta nechan kǝɗ yisti, tǝrkǝ nunefa kurtankan ha tǝ fuwha alkamataˈan taso mahkan. Kǝmankǝ yistitaˈan fuwha alkamataˈan ha, hupkan.”<verse eid="MAT 13:33" /></para>
  <para style="s">Chǝ Yesu ter tǝ wuɓtǝ ndikcha</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />Ɗikchǝ Yesu tǝ nggomǝn nafchaˈan tǝ wuɓtǝ ndikta. Mbuˈawa tandǝ ǝna wa, maangga wuɓtǝ ndikta wa. <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" />Kǝthlǝm chich fee ǝnɗa, ndiiɗan tǝ ǝnɗi mbuˈtǝ thlǝ shenuˈtǝ tǝ yahtǝ Farta Ishaya ha. Ndakan wa,</para>
  <para style="q1" vid="MAT 13:35">“Ni ndikta tǝ tandǝ hur wuɓtǝ ndikta,</para>
  <para style="q2" vid="MAT 13:35">nii mbuˈandǝ tandǝ ǝnɗi nech wuɓta tǝrkwathl kan tǝn heshi.”<verse eid="MAT 13:35" /></para>
  <para style="s">Mbuˈ Yesu saktǝ wuɓtǝ ndikta yi usuncha hur hǝngga alkama</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />Malkǝ Yesu nggomǝn nafchaˈan ha, yimkan kǝ hur wira, ɓak kǝmsichiyan mbǝsˈndi paɗ. Ndang kanda wa, “Mbuˈaˈanndǝn mǝ na wuɓtǝ ndiktǝ usunɗi ǝ hur hǝngga alkama tǝɗi sakta.”<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />Nggǝman kǝ Yesu, ndakan wa, “Thla hǝfchǝ weˈtǝ ndiˈchan mǝthlan nech kǝ nggǝta Waˈi Nefa. <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />Hǝnggiˈan paɗ ndaˈan nech kǝ heshi. Kwastǝ weˈtaˈan paɗ ndaˈan nech kǝ wanchi kuturakta. Usunchaˈan paɗ fen nech kǝ wanchi hweˈra. <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />Paɗ atǝkretǝɗi hǝfchi usunɗi, mǝthlan nech kǝ hweˈra. Fartǝ hathlan paɗ, ndukwa heshi. Fǝ hathl chaˈan paɗ fen nech kǝ fǝ thlǝnchi Farta.<verse eid="MAT 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40" />“Kǝɗ ǝnɗi nggomandǝ fee usuncha kǝ njang fee kaɗi, nechan nat kǝɗu ǝ ndukwa heshi. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />Nggǝta Waˈi Nefa nii thlǝn fǝ thlǝnchinchi, nandǝ kǝtandǝ nat thlaˈtǝ kuturaktiyan. Nat ichiɗi thlǝ ɗǝf chǝ nafcha kǝ chǝndǝ ɓǝɓifata, tǝ paɗ fee thlǝ kǝwakchǝ ǝnɗi kǝmwakchǝsi, kǝ chen fee tandǝ kesh. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />Nandǝ cham tandǝ kǝ hur wur wata thla nech welǝla kaˈan. Ə minni nandǝ naa tǝta tǝ kang wanthlancha. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />Wanshengngǝn chǝˈini fee nech chiɗ chiɗ nandǝ chimndǝfa kǝɗ watfarta hur kuturakti Chinnanda. Nat thla yahchǝ sǝk ǝnɗi nati mbuˈta, kǝ sǝka.”<verse eid="MAT 13:43" /></para>
  <para style="s">Wuɓtǝ ndikta tǝ kǝnawa thla nech ǝ wuɓta</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />“Kuturakti hulafǝrta nechan nat kǝɗ kǝnawa thla wuɓandǝ fee ǝ hǝngga. Thla naa yowuna, nggǝrkan wuɓanda. Kǝthlǝm ɓǝnfata hiyankan ichiɗi nessiyan kaɗ nat, hiyan kan hǝnggiˈan.”<verse eid="MAT 13:44" /></para>
  <para style="s1">Wuɓtǝ ndiktǝ tǝ ɗakwan pǝlaarǝcha</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />“Paˈ kǝ nakanya, kuturakti hulafǝrta nechan kǝɗ wan lǝmo, thlǝ kaa ɗakwan pǝlaarǝcha. <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />Kǝ mbǝskan yowun ɗakwan pǝlaaran thla nech ˈyangˈyang, pǝɗakan hiyandǝ ichiyan kaɗ nat thla nessan, hiyan kan.”<verse eid="MAT 13:46" /></para>
  <para style="s1">Wuɓtǝ ndikta tǝ mapaa kǝs yirfa</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />“Paˈ kǝ nakanya, kuturakti hulafǝrta nechan kǝɗ mapaa kǝs yirǝfcha, thla mǝk tǝ fee kǝ hur hawurta kǝskan weˈtǝ yirifchǝ samǝn samǝn. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />Kǝ ndiiɗ kǝ mapaɗan, kahangkǝ fǝ kǝsh yirifchaˈan kesh kǝ mii chichangnda. Chokkandǝ ha, taɗan kandǝ kwastǝ yirǝfchaˈan, thlǝr kandǝ kǝ hur inafta. Thlǝran kandǝ sǝɓchaˈan kaɗi. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />Nechan choktǝ kǝɗu ǝ ndukwa heshi. Fǝ thlǝnchi Farta nandǝ ɓat kǝ taɗandǝ kesh, kǝ ɗatandǝ ɓǝɓi nafchǝ kesh hur fǝ kaa fee cha. <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />Paɗ kǝ chamndǝ sǝɓtǝ nafcha kǝ hur wur wata thla nech welǝla kaˈan. Mǝɗi nat ɗǝ tǝta tǝ kang wanthlancha.<verse eid="MAT 13:50" /></para>
  <para style="s">Yuwa kǝnawa tǝ ɗohtaˈan</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />“Chǝhan kǝ Yesu tanda wa, “Tapi wathlowunchi chaˈaɗiya ha nat wa?” Nggǝmang kanda, ndakanda wa, “Aa, wathlaˈanchǝ ha.”<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />Ndangkan tanda wa, “Kǝthlǝm ndaˈan nat thlǝ chaˈandǝ kusiˈ i Musa kaɗi, thla chok paɗ kǝ kǝmsha i kuturakti hulafǝrta. Nechan kǝɗ thlǝwira, thla kǝtanchi yuwa icha tǝ ɗohtaˈan kesh ǝ hur ɓinɗǝuˈyan, kǝthlǝm kǝ chakantǝ nafcha.”<verse eid="MAT 13:52" /></para>
  <para style="s1">Nafchi mǝrɓi Nazarat, karndǝ Yesu</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />Kǝ tǝɓankǝ Yesu mbuˈ wuɓtǝ ndikchiˈini, chat malkan minni ha. <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />Ɓak Yesu kǝ mǝɗi nggǝt tǝ fee ndi ǝ Nazarat, chaˈankan nafchǝ har hur wur nggomndiyanda. Fee sǝkchǝ ndi, sakan kǝ indǝ tanda. Ndakanda wa, “Mbǝschǝ nafɗa mbǝrˈǝniɗa ai kǝɗaya, tǝ paɗ alkǝt chǝt ichiɗa yi saka inchiɗiya? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />Ngga mǝthlan nech kǝ waˈi thlǝ kukwa ichiɗi kǝ hishwa wa? Ngga manan nech kǝ Maryamu wa? Ngga wanmanchaˈan nech kǝndǝ Yakubu, tǝ Yusufu, tǝ Siman, tǝ Yahuda wa? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />Ngga wanmanchaˈan kǝ nǝssa tandǝ mǝɗya tǝ minchǝ wa? Thlǝch nafɗa ichiɗiya ayi?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" />Kǝthlǝm ndaˈan, karkandǝ fǝr kit kǝ ndi.</para>
  <para style="p" vid="MAT 13:57">Ndang kǝ Yesu tanda wa, “Thlǝ fǝranchǝ fee maandǝ thlǝ shenuˈtǝ tǝ yahti Farta chǝktǝ yenni, paɗ mǝrɓiyan, tǝ wirˈyan, fǝranwandǝ maanda wa.” <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />Kǝthlǝm ndaˈan, chǝwa tar sakaˈincha ǝ minni kaan wa, kǝthlǝm kumi fǝrkit ˈyanda.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">Mǝrti Yohanna thlǝ chǝt baptisma</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />Ə fartǝˈini, Hiridus kwitiri hahi Galili, sǝkkan kusheˈtǝ Yesu. <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />Ndangkan fǝ tarchiyan wa “Ai, thleya Yohanna thlǝ chit baptisma niya. Thlaˈan fee hur mǝmatecha, ndaˈan chicha mbǝstǝn alkǝt chǝt ǝna sakaˈinchiɗiya.”<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />Nakanya Hiridus tapi kǝsan tǝ Yohana kǝnanchǝ, mǝthlan mǝk chǝ ndǝ kǝ Pursuna kǝthlǝm Hirudiya, nu wanmanan Filibus. <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />Kǝthlǝm kǝ tangtang Yohana kurɓan tǝna mbuˈandǝ Hiridus. Ndat wa, “Kǝmwasi kǝ kahantǝ Hirudiya nu wanmanan Filibus, thla peˈchǝ ha tǝ shinshingnda wa.” <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />Chǝka mǝnakan Hiridus yehsi kǝ ɓǝlantǝ Yohanna, paɗ mǝthlan kwarandǝ nafcha, kǝthlǝm tǝrchanda Yohana wa thlǝ shenuˈtǝ tǝ yahti Farta nakan.<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />Kǝ nggǝrkǝ fartǝ nggǝtti Hiridus ɓata, waˈi Hirudiya kǝ nuwaa rǝɓkan pangngǝn ramcha fee ɓecha. Tǝrkǝ hwiri Hiridus ha kaan. <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />Kǝthlǝm ndaˈan, ɗǝfkan mee tǝ ransata ndat wa, nan fǝran nat ǝnɗi shitǝn. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />Manan ndanchi waˈyan kǝ nuwaa ǝnɗi natǝn shita, ndat wa, “Fǝramitǝn indi Yohanna thlǝ chǝt baptisma nakanya ǝ hur tafata.” <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />Hiridus kwitira chǝt maasǝnchi, paɗ kǝthlǝm ransaɗi chǝtǝn ǝ pangngǝn ramcha, fǝr kan mee tǝ ndat wa kǝ fǝran fee ǝnɗi shitǝn. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />Thlǝnkan fowun fǝ yaanchiyan kǝ pursuna kǝ thlendǝ indi Yohanna thlǝ chǝt baptisma. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />Ɓakandǝ tǝ indi Yohana thlǝ chǝt baptisma ǝ hur tafata, fǝran kǝ fee wan nuwanan, ɗankan manan. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />Ɓak kǝmsichi Yohanna, tǝr kandǝ takǝɗ faɗan thlohankanda. Ɗǝkandǝ mbuˈandǝ Yesu ǝnɗi sǝɓcha.<verse eid="MAT 14:12" /></para>
  <para style="s1">Sǝman Yesu ǝn nafcha aru ɗǝrman</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />Kǝ sǝkkǝ Yesu ǝnɗi sǝɓcha, thlaˈkan yimkan kǝ kombawal chen kan kǝmɗi nawak tǝ nefsi kǝthlǝm kǝ chok tǝ kǝmsichiyan. Paɗ kǝ sǝnkǝ nggommǝn nafcha wa, maltǝ minni ha, chekanndǝ kesh thlaˈtǝ wan mǝrǝɓchiyanda, parakandǝ ndi tǝ sarcha. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />Kǝ chek Yesu kesh hur kombawal taˈan, nakan tertǝ nggommǝn nafchǝ kaan tandǝ pǝk ndi. Haɗankǝ nafchaˈan fa, kǝnan kan hachiɗi kaɗ ɓatndǝ tǝ tanda.<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />Kǝ chǝk farwita, ɓak Kǝmsichi Yesu kǝmɗiyan ndangkanda wa, “Nefsi thlǝ chokchi mǝɗya wa, paɗ nakanya chi farwita. Kallu nggomǝn nafchǝɗa ha kǝthlǝm kǝ ɗǝndǝ kǝ wan mǝrǝɓcha kǝ ɗǝndǝ hi ǝnɗi natndǝ sǝmnda.”<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />Nggǝran kǝ Yesu tandǝs wa, “Ngga nwaat kǝ pǝɗa nda wa, fǝraman tanda ǝna kǝ sǝmnda.”<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />Nggǝrang kandǝs tǝ ndat wa, “Ənsi harˈyan mǝɗa wa, ɓilshet ɗǝrman tǝ yirfǝ chap nessiyaˈan ndak.” <verse eid="MAT 14:17" /><verse number="18" style="v" sid="MAT 14:18" />Ndang kan tanda wa, “Ɓamitǝn tandǝ kǝmɗiya.” <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />Ɗǝfkan nggomǝn nafchaˈan kǝ chokndǝ ha kǝ ɗar ndau hwalita. Tǝrkǝ Yesu ɓilsheɗi ɗǝrman tǝ yirifɗi chap yu, thlaˈan kan indǝ kǝ hulafǝrta, chǝkan usuko kǝmɗi Farta. Chakan kan ɓilsheɗan ha, fǝrakan kǝmsichiyan, kǝmsichaˈan paɗ fǝrankandǝ nafcha. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />Natnda sǝm kanda nggal kanda. Nggomman kǝ kǝmsichiyan takǝt fishirchaˈan, inaftǝ kum nggǝrsǝ chap. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />Nafchǝɗi sǝmchǝ ɗǝsǝmnan saa ndǝ aru ɗǝrman kǝ hǝssa, shengngawu fee nǝssa, tǝ wan wancha hurang wa.<verse eid="MAT 14:21" /></para>
  <para style="s">Wiˈ Yesu ɗar ema</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />Chat kǝ tǝɓang kanda, ndang kǝ Yesu kǝmsichiyan wa, kǝ yimndǝ kǝ hur kombawal kǝ landǝ nggǝrandǝˈin kǝ kǝthlaar kufiˈ thlaa. Mǝthlan thlarkan ha kǝ wellantǝ nggommǝn nafchaˈan ha. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />Kǝrsǝ wellandǝ nggomnan ha, tǝrkan kǝ ɗar tingringnda ichiɗan kǝthlǝm kǝ shenuˈ tǝ Farta. Kǝ farwita mǝthlan minni ichiɗan.<verse eid="MAT 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 14:24" />Paɗ ǝ wanshengngǝnˈini kombawal taˈan pǝɗi langnga tǝ mii chichangngǝn kufiˈan. Pǝrti ˈyaman nakan yiraˈandǝ kombawaltaˈan, kǝthlǝm rǝnniˈan kwaˈkwaˈ.<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />Kǝ wanshengnan mahkan yi walwurta, nak Yesu wiˈta ɗar ˈyaman kǝ ɗi kǝmɗi kǝmsichiyan. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />Kǝ nak kǝmsichiyan ndi mǝthlan wiˈta ɗar ˈyaman, chat lǝkǝkanda, ndaka nda wa, “Ɓǝɓi shemeta.” Nggakkandǝ hwata kǝthlǝm tandǝ lekǝta.<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />Paɗ chat kǝɗuyu, ndangkǝ Yesu tanda wa, “Kǝ sakkowunchǝ inda wa, nggǝta Yesu. Mǝ lekǝwun wa.”<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />Nggǝman kǝ Biturus ndakan wa, “Chinda, ma kittaˈan cha, fǝritǝn mbanda kǝ wiˈi ɗar ˈyaman, kǝ ɓi mbǝswechi.”<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />Ndak Yesu wa, “Ɓo lee.”</para>
  <para style="p" vid="MAT 14:29">Kǝn Biturus chet kesh hur kombawal taˈan, nggakkan wiˈtǝ ɗar ˈyaman kǝ ɓi kǝmɗi Yesu. <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />Paɗ kǝ nakan rǝnniˈan chit alkǝta, lekǝkan nggakan yimndǝ ha. Hwakan ndangkan wa, “Chinda, hǝraˈitǝn.”<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />Chat fǝrkǝ Yesu heryan kǝskanndǝ har, ndangkan wa, “Cha thlǝ fǝr kit ngguɗyeh, kǝthlǝm mǝ saktu icha?”<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />Kǝ yim kandǝ kǝ hur kombawal taˈan, chat thlar kǝ rǝnniˈan ha. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />Kǝmsichiɗi nech hur kombawaltaˈan fǝran kandǝ mandǝ Yesu, ndakanda wa, “Kittaˈan, chǝ Waˈi Farta.”<verse eid="MAT 14:33" /></para>
  <para style="s">Kǝnan Yesu hachǝ kaɗi ǝ Janisarat</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />Kǝ chen kǝndǝ Yesu hawurtaˈan tǝ kǝmsichiyan, saˈkandǝ kǝ thle hahi Janisarat. <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />Kǝ sǝnkǝ nafchi mǝrɓan wun nech kǝ Yesu, thlǝnkandǝ fata kǝmɗi chikawuni thla nech tǝ choktǝ hur thle mǝɗan ndat wa ɓi Yesu. Ɓakandǝ tǝ nat nafchǝɗi nech hachan. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />Shiyankanda, kǝ nggǝm fa fee nech haˈchan kǝ tǝkandǝ chǝka mii kapatˈyan herfa. Nat fee tǝ kanchǝ mii kapatˈyan herfa, kǝndǝ kaɗi.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">Chaˈandi kaakech kaɗi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />Ə fartǝɗiya fowun Farisiyawecha tǝ fǝ chaˈandǝ kusiˈ i Musa kaɗi ɓech kǝmɗi Yesu, thlaˈtǝ ǝ Urshelima. Chihankandǝ Yesu wa, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“Michicha thlǝ fǝr waktǝ kimsichiyo maanda kǝ ǝnɗi chaˈamǝndǝ kakechmǝn har wa kǝ chǝmǝn? Chapawandǝ harchiyandǝ kǝɗ ǝnɗi chaˈaˈandǝ kaakechˈyaˈan har wa, kǝ nandǝ sǝm ɗǝsǝmnda wa.”<verse eid="MAT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3" />Nggǝmangkǝ Yesu wa, “Michicha thlǝ chenduwun kusiˈ i Farta kaɗi kǝthlǝm raˈatˈyowun? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />Ɗowun wu Farta wa, ‘Kǝ fǝrawun maandǝ chindǝ tǝ manda wa’? Nggǝrkan ndat paɗ wa, ‘Nat thla mbuˈanchi ɓǝɓi mee chinan ndu manan, kǝ ɓǝlan fee wa’? <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />Paɗ thlǝnechowun ndat wa, ma ndan yowun chinan ndu manan wa, ǝnɗi kǝmchǝs mǝ kǝ kǝsowun chǝsi tapi fǝrani Farta. <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />Kǝthlǝm ndaˈan, kǝmwasi kǝ kǝsantǝ chinansi tǝ ǝnaɗan wa. Karkowun para ǝnɗi mbuˈtǝ Farta kǝthlǝm para raˈatˈyowun. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />Kun koha nafcha, ǝnɗi mbuˈtǝ Ishaya, thlǝ shenuˈtǝ tǝ yahti Farta kǝ ɗar indiyowun kit. Ndatǝn wa.<verse eid="MAT 15:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />“Nafchiɗiya thlǝ manichandǝ tǝ mee ndak,</para>
  <para style="q2" vid="MAT 15:8">paɗ wanɗǝkaɗechǝˈyanda langngǝ kaan tǝ nenchi.<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />Thlǝ manichandǝ ɗar pafǝn,</para>
  <para style="q2" vid="MAT 15:9">thlǝ chaˈanchandǝ kusiˈchi nafchǝ kaɗ kǝɗ tandǝ nech kǝ kusiˈchi Farta.<verse eid="MAT 15:9" /></para>
  <para style="s">Ichiɗi thlǝ tǝkmanchǝ nef kaɗ pangngǝn Farta</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />“Ndang kǝ Yesu nggomnan wa mbǝham nduk kǝ thlǝmanna. Ndangkan tanda wa, “Kam thlǝmat ha kǝ wathlowunchǝ ǝnɗi nati mbuˈtǝ ya. <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />Ngga ǝnɗi yimchǝ kǝ meˈi nef kǝ yim kǝ hwirˈyan ndaˈan thlǝ tǝk manchi nef kaɗ wa. Paɗ ǝnɗi thlǝ chech kesh i meˈi nefa ndaˈan thlǝ tǝkmanchi kaɗi.”<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />Ɓak kǝmsichiyan mbǝs ndi chihan kanda wa, “Shinin wa fen Farisawecha, sǝɓ hwirˈyandǝ kaɗ kǝ sǝkkandǝ ndiktǝɗiya wa?”<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />Nggǝman kǝ Yesu wa, “Nat ɗǝftǝɗi paˈwaktǝ Papa hulafǝrta, naa fee kǝtandǝ kaɗi. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" />Mallaman tanda. Nechandǝ kǝ komǝn nafcha, fee thlǝ parech tǝ komincha. Maa na komnda kǝs kalati komnda, nat nda nandǝ hǝmndǝ kǝ hur kwiya.”<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />Ndak Biturus wa, “Mbuˈaˈandǝn saktǝ wuɓtǝ ndiktǝɗiya.”<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />Ndak Yesu wa, “Paˈkǝ nakanya kun paɗ wathlowonwu ǝnɗi ha nati ndiktǝ kǝ ɗaran wa? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />Sǝnwowun wa ǝnɗi yimchǝ kǝ meˈi nefa, thlǝ mbǝrchan ha kǝ hwirˈyan. Nee nǝ minni kǝ poriˈ wa, paɗ kǝ kǝrsa kǝ kǝtang fee kesh. <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" />Paɗ ichiɗi thlǝ ɓech kesh meˈi nefa, thlǝ chechandǝ kesh hur wanɗǝkaɗatˈyan. Fen thlǝ tǝkmanchi nef kaɗi. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />Kǝthlǝm hur wanɗǝkaɗati nefa thlǝ ɓa ɓǝɓi kaɗecha. Ɓǝɓi ichi kǝɗ, ɓǝlfata, fǝlaukǝta hur reta, fǝlaukǝta hur kumi reta, yarkǝta, mbuˈlekcha, tǝ sǝɓandǝ thlǝm fowun kaɗi. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />Ichiɗiya thlǝ tǝkmanchi nef kaɗi. Sǝm ǝn ngga tǝ chapandǝ her kaɗ kǝɗ ǝnɗi mbuˈtǝ raˈata, nee ɗǝf nef kǝ tǝkǝmǝn kaɗ pangngǝn Farta wa.”<verse eid="MAT 15:20" /></para>
  <para style="s1">Fǝr kit i nunefa thlaˈtǝ hahi Kanˈana</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />Malkǝ Yesu mǝɗan ha pǝɗakan kǝ thle wanmǝrǝɓchi Taya tǝ Sidon. <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />Kǝɗ kwishya nunefa thlǝ Kanˈana, thla nech tǝ choktǝ ǝ thle mǝɗan, ɓakan kǝmɗi Yesu, nakan tǝta. Nakan ndat wa, “Ai Chinda, Waˈi Dauda, kǝ haɗuchi fa. Ɓǝɓi hweˈrǝ ɓahandǝ waˈinchi kǝ nuwaa kaan.”<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />Mbuˈawu Yesu nunafan ǝna wa. Chika tǝ kǝɗu, nunafan malawa paraˈ tandǝ tǝ shita wa. Minni ɓak kǝmsichiyan, shiyan kandǝ Yesu, ndat wa, “Ndandǝn nuɗa wa, kǝ pǝɗa, kǝthlǝm mǝthlan ɓilla mǝnchǝ kǝrsa tǝ tǝta.”<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />Ndak Yesu wa, “Nggǝtta thlǝnchǝ fee nenchi kǝmɗi nafchi Israˈilawechǝ ndak. Nechandǝ kǝɗ chaap chohrecha fee sakecha.”<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />Ɓak nunafan nduk. kopkan ha shiyankan, “Komkom kǝsisi, Chinda.”<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />Nggǝrkǝ Yesu sǝ wa, “Ɗǝɗ wa sǝwa kǝ tǝr fee ɗǝsǝmndi wancha paɗ kǝ fǝran fee yiɗcha wa.”<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />Ndak nunafan wa, “Ənɗi mbuˈtu ndaˈan nech kǝ kittaˈan Chinda. Paɗ yiɗcha thlǝ mbǝschandǝ fishirtǝ ɗǝsǝmǝnɗi hǝmchǝ kah fartǝɗi na thlǝ wirˈyandǝ sǝm ǝna.”<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />Nggǝman kǝ Yesu wa, “Chǝ nunefa, thla na fǝr kitˈyan manchan. Ənɗi yahtǝ wanɗǝkaɗatˈyo naa fee chuta.” Chat kǝɗuyu, waˈyan kǝ nuwaa, kǝn kan kaɗi.<verse eid="MAT 15:28" /></para>
  <para style="s1">Kǝnan Yesu nafchǝ kaɗ terchan</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />Ə minni, Yesu pǝɗakan kǝ mii hawurti Galili. Minni tǝrkan kǝ kǝlaar tingringnda, chokkan ha. <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />Tertǝ nggommǝn nafcha ɓakandǝ kǝmɗiyan, ɓakandǝ tǝ fee sa fechǝyandǝ kaɗi, tǝ komincha, tǝ tǝraɗcha, tǝ ɓamcha, tǝ fowun terchan. Sǝkandǝ tandǝ ha kǝ pangngǝn Yesu, kǝnankan tandǝ kaɗi. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />Nafchaˈan sakandak inda, kǝ nakandǝ. Nafchiɗi tamwakchǝ shenuˈta tandǝ ndikta. Tǝraɗcha kǝndǝ kaɗi, fee sa fechiyandǝ kaɗi tandǝ wiˈta, paɗ komincha tandǝ namǝta. Manankandǝ Farta i Israˈla.<verse eid="MAT 15:31" /></para>
  <para style="s">Sǝman Yesu ǝn nafchǝ aru foɗɗa</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />ˈYak Yesu kǝmsichiyan kǝ ɓandǝ nduk kǝ thlǝmaɗan. Ndangkan tanda wa, “Nggomǝn nafchǝɗa haɗi tǝfa. Kǝthlǝm ɓukwiya mǝnyandǝ mahkan thlǝman naa, paɗ ɗǝsǝmndes kǝ sǝm nda wa. Ə yahwisi kǝ kali tandǝ ha ǝ mita wa. Kǝthlǝm yahwisi kǝ kǝt fowun hur nandǝ ǝ mbanda wa.”<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />Ndak kǝmsichaˈan ˈyan wa, “Nechamǝn mbǝs ɓilshet ǝ ayi thla natmǝn sǝman ǝn tertǝ nggomǝnɗiya, ǝ chanje kǝ ɗa ya?”<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />Chihankǝ Yesu mee tanda wa ɓilshet kurmi nessiyowun. Nggǝrkandǝs wa, “Ɓilshet muɗ nessi tǝ wan yirǝfchǝ ngguɗyeh.”<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />Ndangkǝ Yesu nafcha wa, kǝ chokndǝ ha kǝ haha. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />Kǝ tǝrkǝ Yesu ɓilsheɗi muɗyu tǝ yirfan, chǝkan usoko kǝmɗi Farta, chǝchen kan ha, fǝrankan kǝmsichiyan. Kǝmsichaˈan nakandǝ fǝrandǝ nggommǝn nafchaˈan.<verse eid="MAT 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 15:37" />Nat nda sǝmkanda nggal kanda. Nggomankǝ kǝmsichiyan fishirchaˈan paktǝ inafchǝ muɗ. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />Fee sǝmcha hǝssǝ aruˈ foɗɗa, shengngawu fee tǝ nǝssǝ, tǝ wancha wa. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />Kǝ welankǝ Yesu tertǝ nggomnan ha, chat yimkan kǝ hur kombawal pǝɗakan kǝ hahi Magadan.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">Fowun Farisawecha tǝ Sadukiyawecha yahndǝs kǝ pǝnandech fee ǝna saka incha</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />Ɓak fowun Farisayawecha tǝ Sadukiyawecha kǝthlǝm kǝ kaɗandǝ Yesu tǝ chihan mee wa, kǝ pǝnan tǝ tandǝ ǝna saka inda. Thla nech pǝndǝ wa, mǝthlan ɓechan hulafǝrta. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />Nggǝmankan tanda wa, “Maa ǝ hǝm farta, thlǝ dechowun wa, ‘Nǝ ˈyer nǝs wa ndu kapa rǝnnaa, kǝthlǝm hulafǝrtaˈan nga.’ <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />Paɗ walwurta, ‘Maa hulafǝrta nga, paɗ husamba sǝ kaan, thlǝ ndechowun wa, nafee chǝt ˈyera.’ Thlǝ mbahǝnchowun sǝndǝ wa naa fee chǝt ˈyera, ndu nǝ fee cha wa, paɗ mbahǝnwowun sǝn mǝna wanɗǝsǝn yuwa heshiɗiya pǝnda wa. <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" />Kun ɓǝɓi nafcha, fǝlaucha, yi yuwa heshiɗiya. Kun kata kǝ pǝnowun chǝ fee ǝna saka inda ǝ hulafǝrta, paɗ nǝ fee pǝnowunchǝ wa. Maangga yi Yunana thlǝ shenuˈtǝ tǝ yahti Farta ndak wa.” Chat malkǝ Yesu tandǝ ha pǝɗakan kumichaˈan.<verse eid="MAT 16:4" /></para>
  <para style="s">Tǝɗan Yesu thlǝmati nafcha kǝ ɗar yisti i Farisawecha tǝ Sadukiyawecha</para>
  <para style="r">(<ref loc="MRK 8:14-21">Mar 8:14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />Kǝ tallankǝ kǝmsichiyan kǝ heshi hawurtǝ thla, mbǝtankan tandǝ tǝrwandǝ ɓilsheta wa. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" />Ndangkǝ Yesu tanda wa, “Mbǝramsi, kǝnowun mbǝrtǝs tǝ yisti i Farisiyawecha tǝ Sadukiyawecha.” <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />Nggak kandǝ ndiktǝ pǝthlǝr nanda tǝ ndat wa, “Mbuˈchan kǝɗu, kǝthlǝm ǝnɗi ɓawaktǝmǝn tǝ ɓilsheta.” <verse eid="MAT 16:7" /><verse number="8" style="v" sid="MAT 16:8" />Paɗ Yesu sǝntǝ mǝ nat ndǝ ndiktǝ kǝ ɗaran. Chihangkan tanda wa, “Nggun tǝɗi naa fǝr kit ˈyowun ngudyeh, kǝthlǝm mǝ natwun ndiktǝ pǝthlǝrwun kǝ ɗar ndat wa ɓilshet ˈyowun sǝ wa? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" />Paˈ kǝ nakanya wathlowun wa ha wa? Kuɗuk wak nowun ɓilsheɗi ɗǝrman (5) sǝmandǝn ǝn nafchǝ aru ɗǝrman (5,000) yu wa? Inaftǝ kurmi nggomanduwun fishirchaˈan? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" />Kuɗuk wak nowun ɓilsheɗi muɗ (7) sǝmandǝn ǝn nafchi aru foɗɗa (4,000) yu wa? Inaftǝ kurmi nggomanduwun fishirchaˈan? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />Mǝ chich mbahǝn waktǝwun sǝnda wa ngga nechi ndiktǝ tǝ wunchi kǝ ɗar ɓilsheta wa? Paɗ ndat wa kǝ mbǝrwunsi tǝ yisti i Farisiyawecha, tǝ Sadukiyawecha.” <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />Chat sǝnkanda wa ngga kǝ ɗar yisti tǝ ɗi thlǝ chǝt fee tersi ǝ hur ɓilshet natǝn ndikta kǝ ɗaran wa. Paɗ kǝ chaˈandi Farisiyawech kaɗ, tǝ Sadukiyawecha.<verse eid="MAT 16:12" /></para>
  <para style="s">Mbuˈ Biturus wa Yesu nech kǝ Kǝristi.</para>
  <para style="r">(<ref loc="MRK 8:27-30">Mar 8:27-30</ref>; <ref loc="LUK 9:18-21">Luk 9:18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />Kǝ ɓak Yesu nduk tǝ thle mǝti Kasariya yi Filipi, chǝhankan kǝmsichiyan ndakan wa, “Thlǝ ndech nafcha wa, wun nech kǝ nggǝta Waˈi Nefa?” <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" />Nggǝrang kandǝs wa, “Fowun ndechanda wa cha Yohana thlǝ chǝt baptisma. Fowun ndechanda wa cha Iliya. Fowun paɗ ndakanda wa cha Irmiya ndu paɗ artǝ hur fǝ shenuˈchǝ tǝ yahti Farta.” <verse eid="MAT 16:14" /><verse number="15" style="v" sid="MAT 16:15" />Chǝhankan tanda wa, “Kun paɗ kǝni? Thlǝ ndechowun wa wun naki?” <verse eid="MAT 16:15" /><verse number="16" style="v" sid="MAT 16:16" />Nggǝmankǝ Siman Biturus su wa, “Chǝnech kǝ Kǝristi, Waˈi Farta thlǝ shishingnda.” <verse eid="MAT 16:16" /><verse number="17" style="v" sid="MAT 16:17" />Nggǝman kǝ Yesu wa, “Thlǝ mbǝs ǝnhar nako, Siman waˈi Yunusa, kǝthlǝm ngga nef punuchǝ ǝnɗa wa, paɗ Papa thla hulafǝrta, mǝthlan punuchǝ ǝnɗa. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />Nggǝt ndu ta wa chǝ nech kǝ Biturus (Thla naa saktaˈan wa fera), ǝ ɗar farɗa paɗ nati tin nafchinchi, fǝ fǝr kit cha. Tǝ paɗ alkǝti mǝrtǝs nech mbǝrandǝ alkǝtˈyan ha wa. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" />Nii furu ǝnna in mikǝtǝnchi yimndǝ kǝ kuturakti hulafǝrta. Nat ǝnɗi kartu fǝ hur heshi, kǝɗu paɗ naa fee kartǝ hulafǝrta. Paɗ nat ǝnɗi nggǝmndu fa hur heshi, kǝɗu paɗ naa fee nggǝmɗǝf hulafǝrta.” <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />Chat tǝɗan kan thlǝmati kǝmsichiyan kaan, kǝ mbuˈandǝ chikan wun wa mǝthlan nech kǝ Kǝristi wa.<verse eid="MAT 16:20" /></para>
  <para style="s">Ndik Yesu kǝ ɗar ɓahtǝɗi natǝn sata tǝ mǝrtǝyan</para>
  <para style="r">(<ref loc="MRK 8:31">Mar 8:31</ref>; <ref loc="LUK 9:22-27">Luk 9:22-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />Thlaˈtǝ fartǝ inni, nggakkǝ Yesu sǝnandǝ kǝmsichiyansi ndat wa, nwaat kǝ ɗi kǝ Urshelima. Paɗ kǝ saa ɓahtǝ kaan ǝ hari paktechi Yahudawecha, tǝ paktǝ pangngǝncha, tǝ fǝ chaˈandǝ kusiˈ i Musa kaɗi. Kǝ ɓilanfee, mahkaan partǝ paɗ, kǝ thlaˈan fee tǝ shishingnda. <verse eid="MAT 16:21" /><verse number="22" style="v" sid="MAT 16:22" />Kaɓ kǝ Biturus ndǝ kǝ kǝlaar. Nggakkan ˈyanandǝ ha, ndakan wa, “Kǝ malantǝ ndiktǝ kǝɗu. Farta kǝ mbǝhanchi kaɗi. Chinda, ǝnɗa nech sǝɓtǝ tǝ wech wa, chǝk ngguɗyeh.” <verse eid="MAT 16:22" /><verse number="23" style="v" sid="MAT 16:23" />Tǝɓǝr kǝ Yesu ha ndangkan Biturus wa, “Mbǝho langnga tǝ nenchi, hweˈra, chǝ ɗakwan chǝt wansartǝ kǝmɗinchi. Kǝthlǝm kewen ǝnɗi nech kǝyi Farta wa, paɗ yi nafcha.”<verse eid="MAT 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />Chat ndangkǝ Yesu kǝmsichiyan wa, “Nat thla yahchǝs kǝ para nenchi. Nwaat kǝ kartǝ indiyan, kǝ tǝrtǝ palandiyan (Ndaˈan nech kǝ, kǝ nggǝm fa, kǝ saa ɓahta, kǝ mǝra kǝthlǝm nggǝta). Kǝnan para nenchi. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" />Nat thla yahchǝ kǝ hǝraˈantǝ shishingndiyan nan kuɓata. Paɗ nat thla kuɓech shishingndiyan kǝthlǝm nggǝta nan mbǝs shishingndǝ kǝ kweˈkǝchi. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />Mǝ nech nat kǝ mbǝs ǝnhar kǝmɗi nefa maa mbǝstǝ heshiɗiya nat, paɗ kǝ kuɓatǝ shishingndiyan? Ndu mǝ na nef mbahǝn fǝrta, kǝthlǝm kǝ fǝran fee shishingnda? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" />Kǝthlǝm nggǝta Waˈi Nefa nechi ɓat hur maandi Papa, tǝ fǝ thlǝnchiyan. Kǝ fǝrani chikawun kǝnau terˈyan, keˈke tǝ ǝnɗi chitǝn. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />Kittaˈan nati mbuˈowunda, fowunsi nech kit kit mǝɗya nggandǝ mǝr wa kwaɗǝn. Se maa niinda nggǝta Waˈi Nefa ɓat kaha hur Kuturaktinchi.”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">Pǝn fee kuturakti Yesu ǝ ɗar ngwella</para>
  <para style="r">(<ref loc="MRK 9:2-13">Mar 9:2-13</ref>; <ref loc="LUK 9:28-36">Luk 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />Kǝrsǝ mǝndǝ michcha, tǝ nda ɗi nda Biturus wa, Yesu nech kǝ Kǝristi. Pǝɗak Yesu tǝ Biturus, tǝ Yakubu, tǝ Yohana mbuˈtǝ Yakubu, kǝ ɓǝra ngwell njang, fen ichǝt nanda. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />Minni ɓeɗak fatˈyan ha pangngǝn nanda. Nak chǝmandiyan chǝm ndǝf kǝɗ watfarta. Kapatˈyan paɗ chǝkan kaɗ heɗiɗi kaan. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />Chat nak kǝmsichiyan Musa, tǝ Iliya ɓindǝ kǝ thlǝma Yesu, paɗ tandǝ ndikta tǝ ndi.<verse eid="MAT 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4" />Ndangkǝ Biturus Yesu wa, “Chinda, ndiˈchansi nat ǝn mǝɗya. Maa nggǝminfa, ni tahǝs kuwurchǝ mahkan, arta yuwa, arta yi Musa, arta paɗ yi Iliya.”<verse eid="MAT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5" />Biturus ɗar shenuˈta, chat ɓak husamba heɗiɗi nggǝlandǝ tanda. Sǝkkandǝ ɓǝratǝ hur husambiyan, ndat wa, “Thleya Waˈinchi yahǝnchi anchi, thlǝ mbindi fat kǝ anchi kaan. Kam thlǝmat kǝ ndiktiyan.”<verse eid="MAT 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6" />Kǝ sǝk kǝ kǝmsichaˈan kǝɗuyu, lekǝkandǝ kaan. Hunakandǝ ha chǝp kandǝ hwir ha. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />Ɓak Yesu kǝ thlǝmat nanda tǝkan kan her tandǝ fa ndangkan tanda wa, “Thlaˈama, mǝ lekuwun wa.” <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />Kǝ thlaˈan kandǝ inda, ɗǝmbakandǝ ha, nawandǝ yowun wa, Yesu ichiɗan.<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />Kǝ nakandǝ ɓat kah ɓǝra ngwallan, tǝɗankǝ Yesu thlǝmatˈyanda. Ndakan wa, “Kǝ mbuˈawun nǝf ǝnɗi natwun wa, se kǝrsǝ fartǝɗi thlaˈandǝ fee nggǝta Waˈi Nefa ǝ mǝrta.”<verse eid="MAT 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10" />Chihankǝ kǝmsichiyan wa, “Maa kǝɗu, kǝthlǝm mǝ nda fǝ chaˈandǝ kusiˈ i Musa kaɗ wa, waat kǝ ɓǝ thlǝ shenuˈtǝ tǝ yahti Farta Iliya kwaɗǝn. Kǝn Kǝristi ɓata?”<verse eid="MAT 17:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11" />Nggǝmankǝ Yesu wa, “Kittaˈan kǝɗuyu, na Iliya ɓat kǝ nggǝrandǝ chika mǝ kaɗ ndiˈchan, kǝɗ thla natǝn choh. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" />Paɗ nggǝt mbuˈowunda, tapi ǝ ɓi Iliya, fen paɗ sǝnwanda wa mǝthlan wa. Chankandǝ nat ɓǝɓi ichiɗi yahtǝnda kǝ chanda. Kǝɗu paɗ na nggǝta Waˈi Nef saa ɓahtǝ ǝ harˈyanda.” <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />Chat sǝnkǝ kǝmsichaˈan wa nechan ndiktǝ tǝ tanda kǝ ɗar Yohana thlǝ chǝt baptisma.<verse eid="MAT 17:13" /></para>
  <para style="s">Kǝnan Yesu waa kaɗ na hatǝfa chandartǝ fiyan</para>
  <para style="r">(<ref loc="MRK 9:14-29">Mar 9:14-29</ref>; <ref loc="LUK 9:37-43">Luk 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />Kǝ ɓakandǝ kaɗ kǝ thlǝma nggomnan, ɓak yowun nef mbǝs Yesu kopkan ha pangngǝn nan. <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />Ndakan wa, “Chinda, kǝ haɗuchǝ waˈinchi fa, hatǝfa chandartǝ fiyan paɗ mǝthlan ɓahtǝ ha kaan. Thlǝ kurɓanchan hǝmndǝ kǝ wata fartǝyowun paɗ kǝ hur ema. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />Ɓǝnchi taˈanchi kǝmɗi kǝmsichiyo, paɗ mbahǝnwandǝ kǝnandǝ kaɗ wa.”<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />Nggǝmankǝ Yesu wa, “Kun nafcha fǝ kumi fǝr kit cha, yi ɓǝɓi yuwa heshiɗiya. Kǝ kwati nati choktǝ tǝ wunchi? Kǝ kwat paɗ nati kǝrǝs wunchi? Ɓamatǝn ndi.” <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />Yanankǝ Yesu hwaˈran ha, paɗ chek hwaˈran kesh fi waanan, chat kǝn kǝ waanan kaɗi.<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />Kǝmsichaˈan ɓakandǝ kǝ thlǝma Yesu fartǝɗi natǝn ichǝɗan, chǝhan kanda wa, “Kǝthlǝm mǝ mbahǝnwaktǝˈin chendǝ kesh?”<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />Nggǝrangkan tandǝs wa, “Kǝthlǝm fǝr kit ˈyowun ngguɗyeh. Kittaˈan nati mbuˈowunda, maa fǝr kit ˈyowunsi ngguɗyeh kǝɗ wan mustad. Nowun mbahǝn ndandǝ nggwal ɗa wa, ‘Thlaˈu mǝɗya kǝ mǝɗi,’ paɗ nan thlaˈta. Paɗ ǝnsi nech wulowun nda wa. <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />[weˈtǝ ǝnɗa chewa kesh kǝɗu wa, maangga tǝ shiyandǝ Farta, tǝ kǝr kuchumnda wa.]”<verse eid="MAT 17:21" /></para>
  <para style="s">Nggǝr Yesu ndiktǝ kǝ ɗar mǝrtiyan tǝ thlaˈtiyan</para>
  <para style="r">(<ref loc="MRK 9:30-32">Mar 9:30-32</ref>; <ref loc="LUK 9:43-45">Luk 9:43-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />Kǝ kǝmkǝ kǝmsichiyan kǝ thle Galili, ndangkǝ Yesu tanda wa, “Naa fee fǝr nggǝta Waˈi Nefa kǝ hari nafcha. <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />Nandǝ ɓǝlita, paɗ kǝrsǝ mǝndǝ mahkan nii thlaˈtǝ tǝ shishingnda.” Paɗ sakan kǝ indǝ kǝmsichiyan.<verse eid="MAT 17:23" /></para>
  <para style="s">Ndik Yesu kǝ ɗar ti chamǝn kǝtǝn shita.</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />Kǝrsǝ ɓati Yesu tǝ kǝmsichiyan kǝ Kaparnahum, ɓak fǝ thlǝt chaminchi chap kǝthlǝm Wiri Farta mbǝs Biturus. Chǝhan kanda wa, “Thlǝ tichǝ thlǝ chaˈananˈyowun chamndǝ kǝthlǝm Wiri Farta kuɗa wa?”<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />Nggǝmang kǝ Biturus wa, “Aa, thlǝ tichan.”</para>
  <para style="p" vid="MAT 17:25">Kǝ yimkǝ Biturus kǝ hur wuran, Yesu nggakchǝ ndiktǝ tǝ ndi. Chihan kan wa, “Mǝ nech kǝ kaɗatˈyo Biturus? Mǝɗi micha thlǝ thlǝt kutǝrchǝ wanɗǝɓithl icha ndu chamnda? Mǝɗi wanchiyanda wa, ndu mǝɗi fowun wa?”<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />Nggǝman kǝ Biturus wa, “Mǝɗi ramcha.”</para>
  <para style="p" vid="MAT 17:26">Ndangkǝ Yesu wa, “Wanchǝ hahiˈan tiwanda wa hacha. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />Paɗ kǝthlǝm kǝ sǝɓandǝ hwirkaɗ tǝ nggǝmnan wa. Ɗu kǝ kufa kǝ mikin nggalkǝm ˈyo. Kǝ tirin yirif ɗi latu kǝsta, kǝ i neen meˈyan ha. No naa wanɗǝɓǝthl tipesha thla saˈchǝ ndǝnari foɗɗa hwirˈyan. Tǝrko fǝranko tanda, chamndinchi tǝ yuwa.”<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">Wun nech kǝ kapa nafɗi mbǝranchǝ tandǝ nat</para>
  <para style="r">(<ref loc="MRK 9:33-37">Mar 9:33-37</ref>; <ref loc="LUK 9:46-48">Luk 9:46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />Ə wanshengngǝn ini kǝmsichiyan ɓakandǝ kǝ thlǝma Yesu. Chǝhankandǝ tǝ ndat wa, “Wun nech kǝ kapa nafɗi mbǝramchǝ tandǝ ha nat, ǝ hur kuturakti hulafǝrta?” <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />ˈYakan wan waa, ɗǝf kan ndi kǝ hurɗǝfi tǝ nanda. <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" />Ndakan wa, “Kittaˈan nggǝt mbuˈowunnda, maangga tǝ nggǝrawun ǝna chich ˈyowun ha, kǝ chok kǝɗ yi wan wancha wa. Nowun tam yim kǝ kuturakti hulafǝrta wa. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />Kǝthlǝm ndaˈan, nat nafɗi nggǝranchǝ indiyan ha kǝɗ wanɗiya, mǝthlan nech kǝ kapa nafɗi mbǝranchǝ tandǝ ha nat, ǝ kuturakti hulafǝrta.<verse eid="MAT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 18:5" />“Paɗ nat nafɗi thlǝch wan waa kǝɗ thleya kǝthlǝm nggǝta, thlǝt nenchi. <verse eid="MAT 18:5" /><verse number="6" style="v" sid="MAT 18:6" />Paɗ nat thla ɗǝfchǝ artǝ hur wan wanchiɗa, fee fǝr chǝ kit kǝ nenchi, kǝ chǝndǝ ɓǝɓifata. Kwech mǝ kǝ wokan fee kapa ɗakwan fǝndǝ kǝ ɓǝrata, kǝ mǝk fee ndǝ kǝ kwiɗimǝn hawurta.<verse eid="MAT 18:6" /></para>
  <para style="s">Ichiɗi nech ɗǝf nef kǝ chǝt ɓǝɓifata</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7" />“Ai i nafchi heshiɗiya, kǝthlǝm ichǝs huran thla nech ɗǝf nafchǝ kǝ chǝndǝ ɓǝɓifata. Weˈtǝ ichiˈini waat kǝ ɓanda, paɗ ai i nafɗi nech kǝ ɗakwan chǝt wansartaˈan.<verse eid="MAT 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8" />“Maa heryo ndu sartiyo thlǝ ɗǝfchan wech kǝ chǝn ɓǝɓifata, thlenkaɗi mǝkan ko kaɗi. Kwechchan mǝ kǝ yimin tǝ shishingndǝ kǝ kuturakti hulafǝrta tǝ her arta ndu sartǝ arta. Mǝ kǝ yimin tǝ harchi chap, ndu sarchǝ chap, kǝ hur waɗi thlǝ lifwakcha. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" />Paɗ maa thlǝ ɗǝfchǝ wenitiyo wech kǝ chin ɓǝɓifata, kǝtanko kaɗi mǝkan ko kaɗi. Kwechchan mǝ kǝ yimin tǝ shishingndǝ kǝ kuturakti hulafǝrta tǝ wenitǝ arta. Mǝ kǝ chokin tǝ wenitǝ chap, paɗ kǝ mǝk fee wech kǝ waɗi thlǝ lifwakcha.<verse eid="MAT 18:9" /></para>
  <para style="s">Wuɓtǝ ndikta tǝ chohraɗi sakecha</para>
  <para style="r">(<ref loc="LUK 15:3-7">Luk 15:3-7</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />“Kǝ wathlowunchi ha, mǝ nggǝmwun fa kǝ njirawun chǝka arta kaɗ, hur wanwan chǝɗiya wa. Kǝthlǝm fǝ thlǝnchi Farta yi wanchaˈan tandǝ ɓukwa tǝ Papa ǝ hulafǝrta weenmǝta. <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />[Kǝthlǝm nggǝta Waˈi Nefa ɓechi kǝ hǝraˈani fee sakecha.]<verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />“Mǝ nech kǝ kaɗatˈyowun? Maa nefsi naa chohrech ˈyansi kumchǝt kum (100), paɗ artǝ sakakan, mǝ natǝn chǝta? Nee mal kumchǝt wanherhaˈarta nggǝrsi wanherhaˈartiɗi (99) ha, kǝlaar nggwella mǝɗi natnda, kǝ ɗǝ ka thla sakecha wa? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />Paɗ maa ǝ mbǝsanchi. Kittaˈan nati mbuˈowunda. Naa fat mbǝnandǝ kaan kǝ ɗar thla artǝ yu, mǝni fee kumchǝt wanherhaˈarta nggǝrsǝ wanherhaˈarta (99) fee sakawakchǝ yu. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />Tǝkǝɗu paɗ Chinwun ǝ hulafǝrta yahwasi kǝ sak artǝ hur wanchiɗiya wa.<verse eid="MAT 18:14" /></para>
  <para style="s">Maa chuchǝ wanmu thlǝ fǝr kit, ɓǝɓifat fa</para>
  <para style="r">(<ref loc="LUK 17:3">Luk 17:3</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />“Maa chuchǝ wanmu thlǝ fǝr kit, ɓǝɓifat fa, ɗu mbuˈandǝn ǝnɗi chutǝn, chǝ tǝ mǝthlan ichǝt wun. Maa ǝ sǝktǝ wechi, hǝreˈen wanmu. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />Paɗ maa sǝk wa wech wa, tǝru nef in arta ndu chap kǝ nggǝrwun ɗǝt mbǝs ndi. Kǝthlǝm ndech ndikti Farta wa, naa fee mbǝsandǝ kit tǝ shenuˈtaˈan mǝɗi nafchǝ chap ndu mahkan, maa mbuˈndǝ ǝnɗi sǝndǝ ndǝsi kǝ ɗaran. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />Maa ǝ kartǝ sǝk tanda, mbuˈanko takǝt fǝ tǝr mbanchi Farta. Paɗ maa ǝ kartǝ sǝk chika takǝt fǝ tǝr mbanchi Farta, tǝrkowun ndi kǝɗ nafɗi sǝnwakchǝ Farta, ndu kǝɗ thlǝ thlǝt chamnda.<verse eid="MAT 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />“Kittaˈan nati mbuˈowunda, nat ǝnɗi kartuwun fa hur heshi, kǝɗu paɗ naa fee kartǝ hulafǝrta. Paɗ nat ǝnɗi nggǝmnduwun fa hur heshi, kǝɗu paɗ naa fee nggǝmɗǝf hulafǝrta.<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />“Kǝɗu, nggǝt nggǝr mbuˈowundǝ tǝ ndat wa, maa nafchǝs chap hurwun hur heshi nggǝmandǝ kǝ ɗar nat ǝnɗi shitǝ nda. Papa thla hulafǝrta nan chandǝ tanda. <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />Kǝthlǝm nat mǝɗi nggomndǝ nafchǝ chap ndu mahkan hur thlǝmna, nggǝt minni tǝ tanda.”<verse eid="MAT 18:20" /></para>
  <para style="s">Wuɓtǝ ndikta tǝ mafaɗi thlǝ kalwakchǝ ǝn ha</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />Kǝrsi thlenni, ɓak Biturus kǝ thlǝma Yesu chǝhan kan ndat wa, “Chinda, nechi kal wanmanǝ ha kurmi maa kurɓanchi chǝ ɓǝɓifat fa? Muɗ wa?”<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />Nggǝmankǝ Yesu su wa, “Nduwi wa, muɗ wa, paɗ muɗ kurɓandǝ kumchǝt muɗ.<verse eid="MAT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23" />“Kǝthlǝm ndaˈan, nech kuturakti hulafǝrta kǝɗ kwitira thla yahchǝs kǝ tiyan mafechˈyan wanɗǝɓithlˈyan natǝn para tanda. <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />Kǝ nggak kan. Ɓak fee tǝ artǝ kǝmɗiyan thla natǝn parandi wanɗǝɓithl aru kum (10,000) i talenti, (talenti arta seˈ titǝ thlǝ tera hurat kum chǝt chap). <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />Kǝthlǝm nee mbahan ti wa. Chat ɗǝf kǝ kuturan, mǝthlan, tǝ nuwan, tǝ wanchiyan, paɗ tǝ ǝnɗi nessiyan nat, kǝ hǝyan fee kaɗ kǝ tiyan fee wanɗǝɓithlˈyan.<verse eid="MAT 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26" />“Chat kopkǝ mafaɗan ha pangngǝnan, shiyankan tǝ ndat wa, ‘Kǝrsu nenchǝ har, ni tiyu chǝka mǝ kaɗi.’ <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />Kuturan haɗankǝ mafaɗi fa, kalankan kumataˈan ha, kalkanndǝ ha.<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />“Paɗ kǝrsaɗan kǝ chek mafaɗan kesh, mbǝsankan yowun mafata thla natǝn paraˈandi ndǝnari kumchǝt kum (100). Kǝsankan ɓǝratiyan nggakkan yaˈanda, ndangkan wa, ‘Tiyitǝn kumatǝɗi nati parawechi.’<verse eid="MAT 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29" />“Chat shiketǝ terˈyan chamkan kuruminchǝha kǝ pangngǝnan shiyankan tǝ ndat wa, ‘Kǝrsu nenchǝ har, ni tiyu chǝka mǝ kaɗi.’<verse eid="MAT 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30" />“Mafaɗi tǝrkananyu karkan kǝrǝs ndi. Paɗ ɗǝfkan kǝ mǝk fee ndi kǝ pursuna, kǝ fartǝɗi natǝn tiyan wanɗǝɓithlɗi natǝn paraˈndi. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />Kǝ nak takǝɗ shikechǝ fǝ tarchiyan ǝnɗi chǝt maafaɗiya, sǝɓkǝ hwirˈyandǝ kaɗ kaan, ɗǝkandǝ mbuˈandǝ kuturan nat ǝnɗi sǝɓcha.<verse eid="MAT 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32" />“Kǝrsǝ ndaˈan, kuturan thlǝnkan kǝ ˈyan fee ndi ndangkan wa, ‘Chǝ ɓǝɓi mafata, kaluchǝ ha nat ǝnɗi nati parawechi, kǝthlǝm ǝ shiyichin. <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />Awi, kǝmwasi kǝ shisheen shiketǝ terˈyosi, kǝɗ ǝnɗi shisheti wech wa?’ <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />Hur sǝɓtǝ hwira, kuturan fǝrkan ndi kǝmɗi fǝ para pursunecha kǝ ɓahan fee, se titǝ nat ǝnɗi na fee parandi.<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />“Kǝɗu paɗ na Papa hulafǝrta chandǝ chǝkwun hurwun, thla karchǝ kalandǝ wanmanan ha tǝ hwir arta.”<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">Chaˈandi Yesu kaɗ kǝ ɗar ɓǝlandǝ ret kaɗi</para>
  <para style="r">(<ref loc="MRK 10:1-12">Mar 10:1-12</ref>; <ref loc="LUK 16:18">Luk 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />Kǝ tǝɓangkǝ Yesu chaˈandǝ kaɗ kǝ ɗar ichiˈini, malkan hahi Galili ha pǝɗakan kǝ thle mǝti Yahudiya kǝ heshi kufi Urdun. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />Tertǝ nggomǝn nafcha parakandǝ ndi, paɗ minni kǝnan kan fee kaɗ nech haˈchan hurnanda.<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />Fowun Farisiyawecha ɓakandǝ kǝmɗi Yesu kǝthlǝm kǝ kǝsandǝ tǝ ǝnfa tǝmɗi ndiktiyan. Chǝhan kanda ndat wa, “Nggǝmaˈanchǝ kusiˈ i Musa su wa, keˈkeˈ si kǝ kal nef nuwan ha kǝ ɗar chǝka yen ǝnɗi chǝtǝn thla mbǝnawakchi nef fa wa?” <verse eid="MAT 19:3" /><verse number="4" style="v" sid="MAT 19:4" />Nggǝrangkǝ Yesu tandǝs wa, “Chan ngga waknowun hur ndikti Farta wa. Thla ndech wa, ǝ tǝrkwathl kanan Farta tǝnchan tandǝ hishnefa, tǝ nunefa.” <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" />Ndak Farta paɗ wa, ‘Kǝthlǝm ndaˈan nefa nan mal chinan ha tǝ manan. Kǝ chok ndǝ tǝ nuwan, chapndǝ paɗ kǝ chok ndǝ kǝ fat arta.’ <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />Kǝthlǝm ndaˈan peˈwandǝ chap wa, paɗ fat arta. Tǝkǝɗu nat ǝnɗi wumandǝ Farta, mǝ chakan nef ha wa.”<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />Fasirisawechaˈan chǝhankanda. Tǝ ndat wa, “Maa kǝɗu, kǝthlǝm mǝ hacha ɗǝftǝ Musa nggaˈansi, kǝ yaran nef ɗelwer tǝ chak ret nuwansi, paɗ kǝ rǝktǝ ndi?”<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />Ndangkǝ Yesu tanda wa, “Kǝthlǝm kwaˈkwa tǝ wanɗǝkaɗechˈyowun ndaˈan chicha malowunndǝ Musa kǝ kalwun nǝssiyowun ha. Paɗ ngga nechan kǝɗu ǝ tǝrkwathl kan tǝn heshi wa. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" />Nggǝt mbuˈowunda, nat thla kalchǝ nuwan ha, maangga ɗar fǝlaukǝta wa, paɗ kahkan nunef samǝn, chǝt fǝlaukǝta.”<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />Ndangkǝ kǝmsichiyan wa, “Maa kǝ ɗar fǝlaukǝt ndak naa nef mbahǝn kal nuwan ha, awi kwech chan choktǝ nggǝ nunef su wa.”<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />Nggǝrankǝ Yesu tandǝs wa, “Ngga chǝka wun nech nggǝmandǝ chaˈaɗowun yawa. Maangga fee fǝrandǝ Farta alkǝt chok ndǝlakǝta wa. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />Fowun kulabcha kǝthlǝm nggǝtchǝ fee tandǝ kǝɗu. Fowun nafchǝ chanchǝ tandǝ kaɗ kǝɗu. Fowun paɗ fen chanchǝ indiyandǝ kaɗ kǝ kulabcha kǝthlǝm tar kuturakti hulafǝrta. Nat thla nech mbahǝn thlǝt chaˈaɗiya, kǝ thla.”<verse eid="MAT 19:12" /></para>
  <para style="s">Ɗǝfan Yesu wanwanchǝ mbǝsˈǝnhar kǝ in</para>
  <para style="r">(<ref loc="MRK 10:13-16">Mar 10:13-16</ref>; <ref loc="LUK 18:15-17">Luk 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />Kǝrisaɗan ɓankǝ fee Yesu wanwancha, kǝthlǝm kǝ ɗǝfan tǝ her tandǝ kǝ inda, kǝ ɗǝfan tǝ mbǝsˈin tandǝ kǝ in. Tǝ paɗ kǝ shiyandech kǝ in. Paɗ yanankǝ kǝmsichiyan nafchiɗi ɓet tǝ wanwanchaˈan. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />Paɗ ndangkǝ Yesu tanda wa, “Malaman wancha kǝ ɓandǝ kǝmɗinchi, kǝ ˈyatawun tanda wa. Kǝthlǝm kuturakti hulafǝrta nechan kǝ yi nafchǝ kǝɗ wanwanchiɗiya.” <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />Kǝ ɗǝfan kǝ Yesu wanchiɗiya mbǝs ǝn har kǝ in, pǝɗakan kumichaˈan.<verse eid="MAT 19:15" /></para>
  <para style="s">Kimshaa thlǝ kǝnawa</para>
  <para style="r">(<ref loc="MRK 10:17-31">Mar 10:17-31</ref>; <ref loc="LUK 18:18-30">Luk 18:18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />Fee minni ɓak yowun nefa kǝmɗi Yesu. Chǝhankan tǝ ndat wa, “Thlǝ chaˈanan kaɗi, kaa ichi mǝ nati chǝta kǝthlǝm kǝ mbǝsi shishingndǝ kǝ kwekǝchi?”<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />Nggǝrang kǝ Yesu sǝ wa, “Kǝthlǝm mǝ chǝhitu mee kǝ ɗar kaa icha? Farta ndak nech ndiˈchan. Maa yehǝn kǝ mbishin shishingndǝ kǝ kweˈkǝchi, paro ǝnɗi mbuˈtǝ kusiˈchi Musa.”<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />Ndangkan Yesu wa, “Yen kusiˈ tina hurnanda?”</para>
  <para style="p" vid="MAT 19:18">Nggǝrang kǝ Yesu su wa, “‘Mǝ ɓillin fata wa. Mǝ chin fǝlaukǝta wa. Mǝ yerkǝn wa. Mǝ mbuˈin lektǝ kǝ in ǝnɗi chǝwaktǝ shetwa wa.’ <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />‘Kǝ fǝreen mandǝ chu tǝ mu. Paɗ kǝ yehǝn nafchiɗi natwun choktǝ nduk nduk kǝɗ ǝnɗi thlǝ yahtu indiyo.’” <verse eid="MAT 19:19" /><verse number="20" style="v" sid="MAT 19:20" />Ndangkǝ kǝmsiˈan wa, “Nat ichiɗa thlǝ parinchihar. Mǝ takicha?”<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />Nggǝrangkǝ Yesu su wa, “Maa yehǝn kǝnen ke ndiiɗan, ɗu, kǝ hǝyeen ǝnɗi nessiyo kaɗ nat kǝ fǝreen fǝ ɓahchǝ wanɗǝɓithlan. Tǝkǝɗu no mbǝs kǝnawa ǝ hulafǝrta. Kǝno ɓat parennenchi.” <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" />Kǝ sǝkkǝ kǝmsiˈan kǝɗuyu, pǝɗakan kesh tǝ sǝɓtǝ hwira, kǝthlǝm kǝnauˈyansi kaan. <verse eid="MAT 19:22" /><verse number="23" style="v" sid="MAT 19:23" />Chat ndangkǝ Yesu kǝmsichiyan wa, “Kittaˈan nati mbuˈowunnda, nan nat ˈyangˈyang thlǝ kǝnawa kǝ yim kǝ kuturakti hulafǝrta. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />Nggǝt nggǝr mbuˈowunda. Nan nat paˈpa fi ngelupa kǝ yim tǝ kwi lipira mǝni thlǝ kǝnawa kǝ yim kǝ kuturakti hulafǝrta.”<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />Kǝ sǝkkǝ kǝmsichiyan kǝɗu, sakandak indǝ kaan ndaka nda wa, “Maa kǝɗuyu, wun hacha nech hǝraˈta?”<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />Paɗ ɗi mbangkǝ Yesu tanda ndangkan tanda wa, “Ənɗa ˈyangˈyang mǝɗi nefa, paɗ mǝɗi Farta chikamǝ ˈyangˈyang wa.”<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />Nggǝmankǝ Biturus wa, “Mal ǝn chikamǝ ha kǝ paraˈan wechi. Mǝ nat ǝn mbǝstǝ hacha?”<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />Ndangkǝ Yesu tanda wa, “Kittaˈan nati mbuˈowunda, ǝ yuwa heshiɗi nech ɓata. Fartǝɗi na nggǝta Waˈi Nef choktǝ kǝ ɗar mǝtchoktiyan yi maanda ǝ kuturaktinchi. Kun tǝɗi parech nenchi, nowun choktǝ kǝ ɗar mitchok kuturaktǝ kum nggǝrsi chap. Kǝ chuwun kuturaktǝ kwalaar wurchǝ kum nggǝrsǝ chap i nafchi Israˈilawecha. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />Nat thla malchǝ wurchǝ ha, ndu wanmanchaˈan kǝ hǝssa, ndu wanmanchaˈan kǝ nǝssa, ndu chǝnda, ndu manda, ndu wancha, ndu hǝnggicha kǝthlǝm maanandǝ thlǝm naa. Nan mbǝstǝ kǝ pǝɗanchǝ kǝɗu ha kum chǝt kum (100), paɗ kǝ mbǝstǝ shishingndǝ kǝ kwekǝchi. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" />Paɗ nat fee nech manchan nakanya, naa fee njirandǝ tandǝ kaɗi. Fee nech kǝ njirchaˈan nakanya, naa fee manandǝ tanda.”<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">Chaˈandǝ kaɗ tǝ nafchǝɗi pǝɗech chǝt ter ǝ hǝngga inabi</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />“Kuturakti hulafǝrta nechan kǝɗ thlǝwira thla warchi kǝsh walwurtǝ pung kǝthlǝm kǝ kaa nafchiɗi nech chan tera ǝ hǝngga inabi ˈyan. <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />Kǝ tahsan kandǝ ha tǝ fǝ tarchaˈan kǝ ɗar ndǝnari arta ǝ parta, thlǝn kan tandǝ kǝ hǝngga inabi taˈanˈyan. <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />Ə wanshengnan wanhǝhaˈarta yi walwurta, chekan kesh nakan fowun nafchǝ paɗ ǝ mi lǝmo tandǝ chǝt ǝna wa. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />Ndangkan tandǝ wa, ‘Kun paɗ ɗama kǝ chǝwun ter ǝ hǝnginchi, nii tiyowun ǝnɗi kǝmchǝsi.’ <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />Pǝɗa kandǝ kǝ hǝnggaɗan.</para>
  <para style="p" vid="MAT 20:5">“Nggǝrkan chet kesh hurfartǝ paɗ tǝ wanshengnan mahkan yi yartifarta, nggǝrkan thlǝn nafchǝ kǝ hǝnggiyan kǝɗ ǝnɗi chǝtǝn kǝrsa. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />Nggǝrkan chet kesh wanshengnan ndǝrman yi farwita, mbǝsan kan fowum kikit. Chǝhan kan tandǝ wa, ‘Kǝthlǝm mǝ natwun kikit mǝɗa kǝ parta kun chǝt ǝna wa?’<verse eid="MAT 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7" />“Nggǝman kandǝ wa, ‘Kǝthlǝm yowunsi tǝrchǝ nggaˈan kǝ chaˈǝn tera wa.’</para>
  <para style="p" vid="MAT 20:7">“Ndangkan tanda wa, ‘Kun paɗ ɗam cham ter ǝ hǝnggi inabi inchi.’ ”<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />Kǝ hǝmkǝ farta, thlǝ hǝngiˈyan ndangkan thla thlǝ parech har tǝ hǝngiˈyan wa, ‘ˈYo fǝ tarchaˈan kǝ tiyeen tandǝ kǝnau terˈyanda. Tǝrtǝ ǝ fee kǝrsa kǝ fee ǝ tǝrkwahtlkanan.’<verse eid="MAT 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9" />Fǝ tarchiɗi ɓech wanshengnan ndǝrman yi farwitǝyu, tiyankǝ kǝ fee tandǝ ndǝnari artǝ-arta. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />Ɓak fee tǝrkananyu sakchandǝ wa, nandǝ thlǝt manchan, tandǝ paɗ, tiyankǝ fee tandǝ ndǝnari artǝ-arta chǝk wuni. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />Thlǝkanda nakandǝ hurumandǝ tǝ thlǝ hǝnggaɗan. <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />Nakandǝ ndat wa, ‘Fee ɓech ǝ kǝrsa, chǝchandǝ ter wanshengndǝ artǝ ndak, tiyaˈanko kǝɗ ǝnɗi tiyandu tanda. Nggaˈantǝɗi parchǝ nggaˈan chǝt tera, hur watfartǝ kaan.’ <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />Nggǝmankan artǝ hurnanda ndangkan wa, “Shiketǝna, ɗathluwi fa wa. Ngga ndikmǝn tǝ wech wa ni tiyutǝ kǝɗ ǝnɗi thlǝ tiyandǝ fee thlǝ ter ǝ parta wa?” <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />Thlu ǝnɗi nech kǝ yuwa kǝ pǝɗen. Nggǝt yahchǝs kǝ tiyani fee ɓech kǝrsa keˈkeˈ kǝɗ ǝnɗi tiyuti. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />Chaˈwisi kǝ chi ter tǝ kǝnawinchi kǝɗ ǝnɗi yahti wa? Ndu tǝnen sǝraˈ kaa kǝɗɗi pǝndi sok wa? <verse eid="MAT 20:15" /><verse number="16" style="v" sid="MAT 20:16" />Kǝthlǝm ndaˈan, nggǝt mbuˈowunda, “Fee nech manchan nakanya, naa fee njirandǝ tandǝ kaɗi. Fee nech kǝ njirchaˈan paɗ, naa fee manandǝ tanda.”<verse eid="MAT 20:16" /></para>
  <para style="s">Nggǝr Yesu ndiktǝ yi mahkanan kǝ ɗar mǝrtiyan.</para>
  <para style="r">(<ref loc="MRK 10:32-34">Mar 10:32-34</ref>; <ref loc="LUK 18:31-34">Luk 18:31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />Kǝ nak Yesu pǝɗat kafǝr kǝ Urshalima, ǝ mbanda kaɓ kan kǝmsichiɗan kum nggǝrsǝ chapyu kǝ kǝlaar. Ndangkan tanda wa, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“Sǝkama, nggǝmǝn kafǝr kǝ Urshalima. Mǝɗi naa fee fǝr nggǝta Waˈi Nefa kǝ hari paktǝ pangngǝncha tǝ fǝ chaˈandǝ kusiˈ i Musa kaɗi. Nandǝ chakan mee yi mǝrta. <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />Kǝ fǝrndǝ ndi kǝ hari fee nawakchǝ kǝ Yahudawecha, fen paɗ nandǝ chen mee ha, kǝ thlǝfanda, kǝ kukwandǝ ha paɗ. Far mahkanda paɗ naa Farta thlaˈandǝ tǝ shishingnda.”<verse eid="MAT 20:19" /></para>
  <para style="s">Manndǝ Yakubu tǝ Yohanna ǝ shiyi kǝthlǝm tanda</para>
  <para style="r">(<ref loc="MRK 10:35-45">Mar 10:35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />Kǝrsanɗan ɓak man wanchi Zabadi tǝ wanchiyan kǝmɗi Yesu, kopkan ha pangngǝnan shiyankan kǝ chanchi ǝna yowun. <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />Chǝhankan tǝ ndat wa, “Mǝ yahtu?” Ndangkan wa, “Kǝ ɗifin wanchiɗinchi chap ya kǝ chokndǝ, arta ǝ harsǝmˈyo, arti thla paɗ ǝ kakuˈyo, ǝ hur kuturaktiyo.” <verse eid="MAT 20:21" /><verse number="22" style="v" sid="MAT 20:22" />Paɗ ndangkǝ Yesu wanchaˈan wa, “Sǝnwowun ǝnɗi natwun shitawa, nowun mbǝlaˈ sat ǝ hur tǝɓ ɓahtǝɗi nati sata wa?”</para>
  <para style="p" vid="MAT 20:22">Nggǝman kanda wa, “Naˈan mbahanda.”<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />Ndangkǝ Yesu tanda wa, “Nowun mbǝlaˈ sat tǝ tǝɓ ɓahtinchi, paɗ choktǝ ǝ harsǝm inchi, ndu kaku inchi, ngga nggǝt nech tǝ alkǝt fǝrta wa. Mǝtchokchiˈini yi fee tahsandǝ Papa ha kǝthlǝm tanda.” <verse eid="MAT 20:23" /><verse number="24" style="v" sid="MAT 20:24" />Kǝ sǝkkǝ takǝɗ kǝmsichiɗi kum yu shitiyanda, sǝɓkǝ hurchaandǝ kaɗ kaan kǝ ɗar fee chap yu. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" />Paɗ ˈyak Yesu tandǝ nat kǝ thlǝmanɗan, ndangkan tanda wa, “Sǝnwun wa kutǝrchǝ fee nawakchǝ kǝ Yahudawecha thlǝ ɓahanchandǝ nafchiyanda. Paktǝchiyandǝ paɗ thlǝ pǝnchandǝ alkǝt kǝ ɗar nanda. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" />Kǝmwasǝ kǝn kǝɗu pǝthlǝrwun wa. Kǝthlǝm ndaˈan nat thla yahchǝ kǝn manchan pǝthlǝrwun, nwaat kǝ chok kǝ thlǝ chan ter takichaˈan. <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />Thla paɗ yahchǝ kǝ chǝt kuturaktǝ indiyowun, nwaat kǝn kǝ thlǝ terˈyowun. <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />Kǝɗu paɗ nggǝta Waˈi Nefa ngga ɓechi kǝthlǝm kǝ manichǝ fee wa, ɓechi kǝthlǝm kǝ manani nafcha. Kǝ fǝri shishingndinchi paɗ, kǝthlǝm hǝraˈandǝ nafchǝ terchan.”<verse eid="MAT 20:28" /></para>
  <para style="s">Kǝnan Yesu kominchi kaɗ chap</para>
  <para style="r">(<ref loc="MRK 10:46-52">Mar 10:46-52</ref>; <ref loc="LUK 18:35-43">Luk 18:35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />Kǝ nak Yesu tǝ kǝmsichiyan mal mǝrɓi Yeriko ha, parak tertǝ nggomǝn nafchǝ ndi. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />Chat fowun komminchǝ chap, chokndǝ haa kǝlaar mbanda. Kǝ sǝkkandǝ Yesu mbǝrtǝ ha, thlaˈankandǝ ɓǝrata. Ndakanda wa, “Thlǝmaanda, Waˈi Dauda, kǝ haɗuchǝˈǝnfa” <verse eid="MAT 20:30" /><verse number="31" style="v" sid="MAT 20:31" />Yanankǝ nggomǝn nafchaˈan tandǝ ha, ndangkandǝ tanda wa, kǝ nggasndǝ ɓaˈ. Paɗ nak kominchaˈan nggǝr thlaˈandǝ ɓǝratǝ kaan ndat wa, “Chinda, Waˈi Dauda, kǝ haɗuchǝˈǝnfa.” <verse eid="MAT 20:31" /><verse number="32" style="v" sid="MAT 20:32" />Thlarkǝ Yesu ha, ˈyakan tanda ndangkan tanda wa, “Mǝ yahtǝwun kǝ chowunchi?” <verse eid="MAT 20:32" /><verse number="33" style="v" sid="MAT 20:33" />Ndankanda wa, “Thlǝ manda, kǝ mbǝs ǝn naa mǝta.” <verse eid="MAT 20:33" /><verse number="34" style="v" sid="MAT 20:34" />Haɗan kandǝ fa, tǝkankan her wenichiyandǝ fa. Chat kǝɗuyu mbǝs kandǝ naa mǝta paɗ parakandǝ ndi.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">Thlǝ nafchi Urshelima Yesu tǝ mbǝnfata</para>
  <para style="r">(<ref loc="MRK 11:1-11">Mar 11:1-11</ref>; <ref loc="LUK 19:28-40">Luk 19:28-40</ref>; <ref loc="JHN 12:12-19">Yoh 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />Nakandǝ nduk saˈtǝ kǝ Urshalima, saˈkandǝ kǝ Betafaji mǝɗi na Nggwal Zaitun, thlǝnkǝ Yesu kǝmsichiyan chap. <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />Ndangkan tanda wa, “Ɗam kǝ wan mǝrǝɓɗi pangǝnwun yu, maa nggun yimndǝ kǝ huran nowun naa kwaari tǝ waˈyan kǝnan fee ha. Kwasankowun ha, kǝ ɓichǝwun tanda. <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />Maa innowunchi yowun mee, kǝ ndawunwa thlǝ mandǝ yahchǝ tanda, nan ɓowun tandǝ kaɗ tollaa wa.” <verse eid="MAT 21:3" /><verse number="4" style="v" sid="MAT 21:4" />Ichiˈini sǝɓchǝyu ndiiɗan tǝ ǝnɗi mbuˈtǝ thlǝ shenuˈtǝ tǝ yahti Farta Zakariya ha, ndat wa. <verse eid="MAT 21:4" /><verse number="5" style="v" sid="MAT 21:5" />“Mbaˈamandǝn nafchi Siyona, ɗǝposi, kwitirˈyowun ɓat kǝmɗiyowun. Nefa thla nawaktǝ maan idiyansi, mǝthlan ɓat ɗar kwaari. Ə ɗar wan kwaari.” <verse eid="MAT 21:5" /><verse number="6" style="v" sid="MAT 21:6" />Pǝɗak kǝmsichaˈan chikandǝ kǝɗ ǝnɗi ndandǝ Yesu taˈan tanda. <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />Ɓakandǝ tǝ kwaari taˈan tǝ wayan kǝmɗi Yesu chipkandǝ ǝnachipchi yandǝ kǝ ɗar nanda. Tǝrkǝ Yesu si, chokkan kǝ ɗaran. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />Tertǝ nafchiɗi nech hur nggomnan nakandǝ chip ǝnachipchi yandǝ ha kǝ ɗar mbanda. Fowun paɗ chathl kandǝ saˈcha chamkandǝ ha kǝ ɗar mbanan. <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />Nggomǝn nafchǝɗi pangngǝnan tǝ fee kǝrsaˈan thlaˈankandǝ ɓǝratiyanda nakandǝ ndat wa, “Maanaman Waˈi Dauda. Mbǝs ǝn har mǝɗi thla nech ɓat hur thlǝm Chinda.” Maanaman Farta thla nech hulafǝrta thla nawaktǝ sǝrtaˈansi. <verse eid="MAT 21:9" /><verse number="10" style="v" sid="MAT 21:10" />Kǝ yimkǝ Yesu kǝ Urshelima, nat mǝrɓan sakandak inda. Nakandǝ chǝha mee tǝ ndat wa, “Wuneniya?” <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />Ndak tertǝ nafchiɗi nech tǝ Yesu yu wa, “Thleya thlǝ shenuˈtǝ tǝ yahti Farta, Yesu thla ɓech ǝ Nazarat, ǝ hahi Galili.”<verse eid="MAT 21:11" /></para>
  <para style="s">Yim Yesu kǝ kǝtǝn shita</para>
  <para style="r">(<ref loc="MRK 11:15-19">Mar 11:15-19</ref>; <ref loc="LUK 19:45-48">Luk 19:45-48</ref>; <ref loc="JHN 2:13-22">Yoh 2:13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />Yimkǝ Yesu kǝ hur kǝtǝn shitaˈan, paɗ rǝkkan nat nafcha fee nech hita tǝ fee nech hǝyandǝ kaɗi hur kǝtǝn shitaˈan. Paɗ mbulmankan tembǝr chi fǝ ɓeɗe wanɗǝɓǝthlcha tǝ mǝtchokti fǝ hiyandǝ ɗiikuturchǝ kaɗi. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" />Ndangkan tanda wa, “Nechan kǝ yaraɗan hur Laulawati Farta ndat wa, ‘Wirinchi nech fee ˈyat wa Wiri Farta.’ Paɗ chankowun kaɗ kǝ mǝt wuɓti yaarcha.” <verse eid="MAT 21:13" /><verse number="14" style="v" sid="MAT 21:14" />Ɓak komincha tǝ tǝraɗcha mbǝsndi hur wuran. Paɗ kǝnankan tandǝ kaɗi. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />Paɗ kǝ nak paktǝ pangngǝncha tǝ fǝ chaˈandǝ kusiˈ i Musa Kaɗ ǝna sakaa inɗi chǝtǝn. Paɗ nakandǝ sǝk ǝnɗi na wanchǝ mbuˈta tǝ ndat wa, “Maanda kǝmɗi Waˈi Dauda. Sǝɓkǝ hurchandǝ kaɗ kaan.” <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />Chǝhan kandǝ Yesu tǝ ndat wa, “Chǝ sǝk ǝnɗi naa wanchiɗa ndata wa?” Ndangkǝ Yesu tanda wa, “Aa tamwowun channggandǝ hur ndikti Farta wa. Thla ndech wa, ‘Chǝ ɗǝfchǝ usoko tǝ maanda kǝ meˈi wancha tǝ wanwaaˈyaarcha fee nech iˈta.’” <verse eid="MAT 21:16" /><verse number="17" style="v" sid="MAT 21:17" />Malkǝ Yesu tandǝ ha, chekan kesh mǝrɓan, pǝɗakan kǝ Betani, mǝnkan minni.<verse eid="MAT 21:17" /></para>
  <para style="s">Ɗǝf Yesu si kǝ mǝr ɗǝftǝ shukwat kaɗi.</para>
  <para style="r">(<ref loc="MRK 11:12-14">Mar 11:12-14</ref>; <ref loc="MRK 11:20-24">11:20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />Pung walwurta nakan nggǝrandǝ in kǝ mǝrɓan, kǝsankǝ mita. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />Kǝnakan yowun ɗǝftǝ shukwata nduk kǝlaar mbanda, ɗikan kimni, paɗ mbǝs wa wanchaˈan wa, kǝ saˈchǝ ndak. Ndangkan shukwaɗan wa, “Mǝ nggirin nggǝt tawa kǝ kweekǝɗan. Chat hwarkǝ shukwaɗan kaɗi.” <verse eid="MAT 21:19" /><verse number="20" style="v" sid="MAT 21:20" />Nak kǝmsichaˈan kǝɗuyu, sakankǝ indǝ tanda ndakanda wa, “Chich in kǝn hwartǝ shukwaɗi kaɗ chat kǝda ya?” <verse eid="MAT 21:20" /><verse number="21" style="v" sid="MAT 21:21" />Nggǝmankǝ Yesu ndangkan tanda wa, “Kittaˈan nati mbuˈowunda, ma fǝr kit yowunsi as wowun inda wa. Ngga ǝnɗi chandǝ fee shukwaɗa ndak natwun chǝta wa. Paɗ nowun mbahǝn ndandǝ ɗekwen wa thlaˈu mǝɗya kǝ hǝmin kǝ hawurta, nan chǝt kǝɗu. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />Ma fǝrwun kit chǝka mǝ shiyanduwun Farta hur shita, nowun mbǝsta.”<verse eid="MAT 21:22" /></para>
  <para style="s">Chǝhan fee mee Yesu mbǝschan alkǝt ˈyan ayi</para>
  <para style="r">(<ref loc="MRK 11:27-33">Mar 11:27-33</ref>; <ref loc="LUK 20:1-8">Luk 20:1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />Kǝ yimkǝ Yesu kǝ kǝtǝn shitaˈan, mǝthlan hur chaˈandǝ nafchǝ har, ɓak paktǝ pangngǝncha tǝ paktechi Yahudawecha kǝmɗiyan. Chǝhan kanda wa, “Tǝ weˈtǝ alkǝt mii thlǝ chǝtu ichǝɗiya? Paɗ wun fǝruchǝ alkǝɗan?” <verse eid="MAT 21:23" /><verse number="24" style="v" sid="MAT 21:24" />Ngǝmankǝ Yesu tanda wa, “Nggǝt paɗ ni chǝhowun mee arta, ma fǝrichǝwun nggǝmnan, nggǝt paɗ ni mbuˈowun tǝ weˈtǝ alkǝt mǝ thlǝ chiti ichiɗiya. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />Baptisma i Yohana ɓechan ǝ ayi? Ə hulafǝrta wa, ndu mǝɗi nefa wa?” Nakandǝ sakandǝ ha pǝrthlǝr nanda, ndakanda wa ma ndi mǝnwa hulafǝrta nechan ndat wa mǝ chǝt fǝrwak tǝ wun kit kǝ ndi? <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />Ma ndimǝn wa, ‘Ɓechan mǝɗi nefa,’ nggǝmǝn lekǝt ǝnɗi na nafchǝ chamǝnnda, kǝthlǝm nat nafcha fǝrndǝ kit wa Yohana thlǝ shenuˈtǝ tǝ yahti Farta.” <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />Nggǝman kandǝ Yesu, ndakanda wa, “Sǝnwaˈan wa.” Mǝthlan paɗ, ndangkan tanda wa, “Nggǝt paɗ ni mbuˈowunchi ndu tǝ weˈtǝ alkǝt mǝ thlǝ chiti ichiɗiya wa.”<verse eid="MAT 21:27" /></para>
  <para style="s">Sakta tǝ hǝssǝ wanchi chap i yowun nefa</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />“Mǝ natwun hacha? Yowun nefsi tǝ wancha kǝ hǝssǝ chap, ɓakan kǝmɗi thla tǝrkanan ndangkan wa ‘Waˈinchi, ɗu chu ter ǝ hǝngga inabi ɓukwiya.’ <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />Nggǝmankan wa, “Ni ɗawa.” paɗ kǝ kǝrsa ɓeɗankan kaɗatˈyan ha, ɗǝkan kǝ hǝnggaɗan. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />Ɗǝk chinnandǝ kǝmɗi chapatǝ wanan, mbuˈankan kǝɗuyu paɗ, nggǝman kan wa ni ɗǝta papa, paɗ ɗǝwa wa. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />“Hur wanchǝɗi chap ya, wun chich ǝnɗi yahtǝ chinan?” Nggǝman kanda wa, “Thla tǝrkanan.” Ndangkǝ Yesu tanda wa, “Kittaˈan nati mbuˈowunda fǝ thlǝt chamincha, tǝ fǝlaucha kǝ nǝssa tandǝ la yimndǝ kǝ kuturakti hulafǝrta mǝ kun. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" />Kǝthlǝm ɓech Yohanna kǝ pǝnowun mban kakǝta, fǝrwowun kit wa. Paɗ fǝ thlǝt chamincha, tǝ fǝlaucha fǝrndǝ kit kǝ ndi. Chǝk tǝ kǝɗu paɗ, ǝ kǝrsa niwun tǝrwowun ha kǝ fǝr wun kit kǝ ndǝ wa.”<verse eid="MAT 21:32" /></para>
  <para style="s">Saktǝ thlǝ hǝngga thla malanchǝ fowun ha kǝ ɗimbandǝ har</para>
  <para style="r">(<ref loc="MRK 12:1-12">Mar 12:1-12</ref>; <ref loc="LUK 20:9-19">Luk 20:9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />Sǝkam saktaˈan paɗ ya. Chǝ fee yowun nefa thla chich hǝngga inabi, sǝsankan hǝnggaɗan, rekan mǝɗi na fee thlǝ yim wan inabitaˈan. Tǝnkan mǝt njang yi thlǝ ndii hǝnggaɗan. Malkan hǝnggaɗan ha hari fowun fǝ huɗecha, pǝɗakan kǝ hahǝ samǝn. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />Kǝ saˈkǝ sǝfakti inabitaˈan nduk ha, thlǝnkan mafechˈyan kǝmɗi fǝ huɗechaˈan kǝ ɗǝndǝ thlan yaˈan. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />Paɗ fǝ huɗechaˈan kǝsankandǝ mafechaˈan, thlǝfan kandǝ arta, ɓǝlang kandǝ arta, mǝmakan kandǝ artǝf paɗ tǝ ɗakwancha. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />Nggǝrkǝ thlǝwuran thlǝn mafecha, pǝɗanchi fee ha tǝrkwathl kanan tǝ terta. Fǝ huɗechaˈan chan kandǝ tandǝ kǝɗ ǝnɗi chandǝndǝ fee tǝrkwathl kanan. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />Ə nggǝl miyan thlǝn kǝ thlǝ hǝnggaɗan waˈyan kǝmɗiyanda ndakan wa, ‘Asˈindǝs wa nandǝ fǝran mandǝ waˈinchi.’ <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />Paɗ kǝ nak fǝ huɗechaˈan wanan, ndang kandǝ raˈan wa, ‘Əhǝǝ, thleya nech sǝm kǝrsǝ mǝrtǝ hǝnggaɗan. Ɓǝlaman, sǝm kǝrsǝ mǝrti hǝnggaɗan, kǝ chok kǝ yimǝn.’ <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />Chat kǝsan kanda, mǝkkandǝ ndi kǝ kǝrsǝ sǝsaɗan, paɗ ɓǝlan kanda.<verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />“Chǝhan kǝ Yesu mee tanda, fartǝɗi ɓa thlǝ hǝnggaɗan, mǝ natǝn chandǝ fǝ huɗechǝɗa?” <verse eid="MAT 21:40" /><verse number="41" style="v" sid="MAT 21:41" />Nggǝrang kandǝs wa, “Nan ɓǝlandǝ ɓǝɓi nafchiˈini ǝ mbanɗi ɗǝɗwaktǝ naɗan, kǝ fǝrantǝ fowun hǝnggaɗan. Fee nech na fǝran yaˈan fartǝɗi nǝhatǝn.” <verse eid="MAT 21:41" /><verse number="42" style="v" sid="MAT 21:42" />Ndangkǝ Yesu tanda wa, “Awi, tamwowun channggadǝ hur ndikti Farta ɗi yarandǝ fee ha wa? Thla Ndech wa, ɗakwanɗi kartǝ fǝ tǝncha ndaˈan chokchi kǝ chǝma ɗakwan tǝnan. Thleya teri Chinda, ǝna saka indǝ paɗ ǝ wenitiyamǝn. <verse eid="MAT 21:42" /><verse number="43" style="v" sid="MAT 21:43" />Kǝthlǝm ndaˈan nggǝt mbuˈowunda, na fee thlǝt kuturakti Farta mǝɗˈyowun, kǝ fǝran fee, fee nech nggǝt wanchǝ ndiˈchan yi kuturaktaˈan. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />Nat thla hǝmchǝ kǝ in ɗakwanɗiya nan fǝfalat kaɗi, paɗ nat thla hǝmandǝ ɗakwanɗiya kǝ in, nan haˈandǝ kaɗ kǝɗ fuhwata.” <verse eid="MAT 21:44" /><verse number="45" style="v" sid="MAT 21:45" />Kǝ sǝkkǝ paktǝ pamgngǝnchiˈini tǝ Farisawecha saktǝˈinini fǝrtǝn yu, sǝnkanda wa awi kǝɗar nandǝ natǝn ndikta. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />Yahndǝs kǝ kǝsanda, paɗ tandǝ kwarandǝ nafcha. Kǝthlǝm tǝr nafchǝ ndǝ wa thlǝ shenuˈtǝ tǝ yahti Farta nakan.<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">Sakta tǝ kǝn reta.</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />Nggǝrkǝ Yesu mbaˈanda wuɓtǝ ndikta tǝ ndat wa, <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />“Na fee kaɗandǝ kuturakti hulafǝrta kǝɗ kuturɗi tahsanchi kǝn reti waˈyan ha. <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />Thlǝn kǝ kuturɗi mafech ˈyan kǝmɗi fee thlǝnandǝ fee tandǝ kǝ ɓanda kǝ mǝt kǝn reɗan, paɗ karkandǝ ɓata. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />Ngǝrkan thlǝn fowun mafechˈyan. Ndang kan tanda wa, mbaˈaman nafchiɗi thlǝna ndi tanda ndat wa, “Tahsani ɗǝsǝmndǝ ha, thlithli fee paktǝ thlecha fee kǝrtǝ fee tandǝ ndiˈchan. Tahsan fee chika mǝ ha nat. Ɓam kǝ mǝt mbǝnfa reɗan.” <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />Paɗ ɗǝpawandǝs wa, pǝɗakandǝ kumichinanda. Yowun pǝɗi kahngiˈyan, yowun pǝɗi kǝ tar lumokǝtˈyan, <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />Takichaˈan paɗ kǝsan kandǝ mafechˈyan, fǝrankandǝ panchi tanda, ɓǝlankandǝ fowun. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />Sǝɓ kǝ hwiri kuturan kaɗ kaan. Thlǝn kan fǝ yaan chiyan kǝ ɓǝlandǝ fee ɓǝlanchǝ mafechˈyan, kǝ ˈyandǝ mǝrɓiˈyandǝ kaɗ nat. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />Ndangkan takǝɗ mafechaˈan wa, tǝɓan fee tahǝsfa kǝ kǝn reɗan, paɗ fee thlǝnandǝ fee tanda kǝ ɓanda, kǝmwandǝs kǝ ɓanda wa. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />Kǝthlǝm ndaˈan, param paktǝ mbancha kǝ ndawun nat fee mbǝsandǝwun kǝ ɓandǝ kǝ mǝt kǝn reɗan. <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />Pǝɗak mafechiˈini kǝ mbanchaˈan, nggomankandǝ nat thla mbǝstǝnda, fee nech tǝ kaa kǝta tǝ fee nawaktǝ kafat fiyanda. Ndiiɗ kǝ kǝtǝn kǝn reɗan kaɗ kǝ ramcha. <verse eid="MAT 22:10" /><verse number="11" style="v" sid="MAT 22:11" />“Paɗaa kǝ yimkǝ kuturan kǝ kǝtǝnan kǝthlǝm kǝ na ramchǝɗi, nakan yowun nefa pawa kapa kǝn reɗan wa. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />Ndangkan wa, ‘Shiketǝna, chich fee wa kǝni yimndu kǝmɗa ngga tǝ pa kapa kǝn reta wa?’ Paɗ nafan sakan kǝ indǝ ǝnɗi natǝn mbuˈta, nggaskan kǝmma. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" />Ndang kǝ kuturan mafechˈyan wa, “Kǝnaman harchiyan tǝ sarchiyan, kǝ mǝk wun ndi kǝ hur wuthlǝ kaan, mǝɗi na fee tǝta tǝ kang wan thlancha. <verse eid="MAT 22:13" /><verse number="14" style="v" sid="MAT 22:14" />Nggǝlankǝ Yesu ndiktaˈan ha tǝ ndat wa, “Terchan ˈya fee paɗ fee tatǝ fee ngguɗyeh.”<verse eid="MAT 22:14" /></para>
  <para style="s">Chǝha mee kǝ ɓǝra tii chamnda kǝmɗi Kaisar</para>
  <para style="r">(<ref loc="MRK 12:13-17">Mar 12:13-17</ref>; <ref loc="LUK 20:20-26">Luk 20:20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />Ɗǝk Farisiyawecha tahsandǝ mbanɗi ha nat ndǝ kǝsandǝ Yesu si hur ndiktiyan. <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />Thlǝnkandǝ fowun kǝmsichi yanda tǝ fee thlǝ kǝnanchi kirshi Heridus. Ndang kandǝ Yesu wa, “Thlǝ chaˈanan kaɗi, sǝn ǝn wa thlǝ mbuˈcho kit, paɗ thlǝ chaˈancho ndikti Farta kaɗ ɗar kit. Puwu ǝn tǝ sakti chǝka wun wa, paɗ kǝthlǝm nafchi nat arta mǝɗˈyo. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />Mbuˈaˈǝnndǝn mǝ nech kǝ kaɗatˈyo. Nggǝman kusiˈ ˈyamǝn kǝ ti ǝn chamnda kǝmɗi Kaisar wa, ndu kǝ ti ǝn wa wa?” <verse eid="MAT 22:17" /><verse number="18" style="v" sid="MAT 22:18" />Paɗ tapi sǝn Yesu sǝɓtǝ kaɗatˈyanda. Ndang kan tanda wa, kun fǝ wenikicha, fǝ thlǝm nafcha, kǝthlǝm mǝ natwun kaɗita? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />Pǝnami tǝn wanɗǝɓithlɗi thlǝ titǝwun chamnansi, ɓangkandǝ ndenari. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />Ndang kǝ Yesu tanda wa, “Mirshishingndi wuni, tǝ thlǝm wuni nech ɗar wanɗǝɓǝthl ɗa?” <verse eid="MAT 22:20" /><verse number="21" style="v" sid="MAT 22:21" />Ndang kanda wa, “Mirshishingnda tǝ thlǝm Kaisar nech ɗaran.” Ndang kǝ Yesu tanda wa, “Fǝraman Kaisar ǝnɗi nǝch kǝyi Kaisar, fǝraman Farta ǝnɗi nǝch kǝyi Farta.” <verse eid="MAT 22:21" /><verse number="22" style="v" sid="MAT 22:22" />Kǝ sǝk kandǝ kǝɗuyu, saka ndak inda, malkandǝ anchi ha, pǝɗakanda kumichinanda.<verse eid="MAT 22:22" /></para>
  <para style="s">Chǝhi Sadukiyawech mee kǝ ɗar thlaˈti mǝmatecha</para>
  <para style="r">(<ref loc="MRK 12:18-27">Mar 12:18-27</ref>; <ref loc="LUK 20:27-40">Luk 20:27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />Ə fartǝ thlaa, ɓak fowun Sadukiyawecha kǝmɗi Yesu. Sadukiyawechaˈan thlǝ ndechanda wa, thlaˈti mǝmatechis wa. Chǝhan kandǝ mee, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />ndakanda wa, “Thlǝ chaˈanan kaɗi, ndech Musa wa, ma mǝr nǝfa wanchan suwa. Nwaat wanmanan kǝ sǝm tǝ yati nuwan kǝthlǝm kǝ nggǝtanchi wanmanan wanchisi. <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />Fowun hǝssǝ si muɗ kǝ wanmanchi raˈan hur ǝn. Walla wanan kahtǝ nunefa, mǝrkan nggǝtwa wa, malangkan wanmanan nuwan ha. <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />Keɗu sǝɓtǝn tǝ chapataˈan, tǝ mahkanan, paɗ saˈankan muɗataˈan, nggǝt wandǝ wancha wa. <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />Kǝrsǝ nandǝ nat mǝrkǝ nuɗi. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />Nakanya ǝ thlaˈti mǝmatecha, nechan nat kǝ nu wun hur nanda? Nakan nat ndǝ muɗ rindǝ ndi.” <verse eid="MAT 22:28" /><verse number="29" style="v" sid="MAT 22:29" />Paɗaa nggǝrankǝ Yesu tandǝs wa, “Sakiwun kaan, sǝnwowun yara ndikti Farta wa, sǝnwowun alkǝti Farta paɗ wa. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />Kǝthlǝm ǝ thlaˈti mǝmatecha, kahwu fee kanwa, fǝr wufee kan wa. Kǝthlǝm ndaˈan nafchaˈan nechandǝ choktǝ ǝ hulafǝrta keˈke kǝɗ fǝ thlǝnchi Farta. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />Kǝ ɗar thlaˈti mǝmatecha, awi, tamwowun channggandǝ ǝnɗi mbuˈowunndǝ Farta wa? <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" />Ndech Farta wa, ‘Nggǝt nech kǝ Farta yi Ibrahim, tǝ Farta yi Ishaku, tǝ Farta yi Yakubu,’ mǝthlan ngga Farta yi mǝmatǝcha wa.” Mǝthlan Farta yi nafchiɗa fee nech tǝ shishingngǝncha. <verse eid="MAT 22:32" /><verse number="33" style="v" sid="MAT 22:33" />Kǝ sǝkkǝ nggommǝn nafchiɗi nech minni kǝɗuyu, sakandak indǝ tǝ chaˈaɗanyan.<verse eid="MAT 22:33" /></para>
  <para style="s">Kusiˈ tǝɗi nech manchan nat</para>
  <para style="r">(<ref loc="MRK 12:28-34">Mar 12:28-34</ref>; <ref loc="LUK 10:25-28">Luk 10:25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />Kǝ sǝkkǝ Farisiyawecha wa, Sadukiyawecha ǝnsi natndǝ nggǝr mbahan mbuˈandǝ Yesu paɗ wa, chat nggomkǝ Farisawechaˈan ha. <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />Artǝ hur nanda thla sǝnchi kusiˈ i Musa kaan, chǝhan kan mee kǝthlǝm kǝ kaɗanchi. Ndat wa <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“Thlǝ chaˈanan kaɗi, yen kusiˈ tin nech manchan hur kusiˈ cha nat?” <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />Nggǝmankǝ Yesu wa, “‘Yahu Chu Fartiyo tǝ wanɗikaɗatˈyo nat, tǝ shishingndiyo nat, tǝ hur indiyo nat.’ <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />Thleya nech kǝ kapa kusiˈ nat, paɗ thla nech kǝ tǝrkannan. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />Chapataˈan nechan kǝɗ thla tǝrkanan paɗ, yahu nef kǝɗ cha, kǝɗ ǝnɗi yahtu indiyo. <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" />Nat ǝnɗi mbuˈtǝ kusiˈ i Musa tǝ ǝnɗi mbuˈtǝ fǝ shenuˈcha tǝ yahti Farta yu, thlarchandǝ ha kǝ ɗar kusiˈ chiˈini chap yu.”<verse eid="MAT 22:40" /></para>
  <para style="s">Chǝha mee tǝ ndat wa Kǝristi waˈi wuni</para>
  <para style="r">(<ref loc="MRK 12:35-37">Mar 12:35-37</ref>; <ref loc="LUK 20:41-44">Luk 20:41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />Kǝ nggomkǝ fowun Farisiyawechǝ ha kǝ mǝt arta, chǝhan kǝ Yesu mee tanda, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />Ndat wa, “Mǝ nech kǝ kaɗatˈyowun kǝ ɗar Kǝristi? Waˈi wun nakan?” Ndang kanda wa, “Waˈi Dauda nakan.” <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />Ndangkǝ Yesu tanda wa, “Chich in kǝni, Dauda tǝmɗi alkǝti shemeta ˈyatǝn ndǝ wa Chinda? Ndak Dauda wa,<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />“‘Chinda ndangkan Chinnawa.</para>
  <para style="q2" vid="MAT 22:44">“‘Choku ha har harsǝm inchi,</para>
  <para style="q1" vid="MAT 22:44">se ma ɗǝfinchi atǝkrechuwa</para>
  <para style="q2" vid="MAT 22:44">kǝ kan sarchiyo?’”<verse eid="MAT 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 22:45" />“Ma na Dauda ˈya anchi wa Chinda, chich in kǝni na Kǝristi kǝ waˈyan?” <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />Nefsǝ mbahanchǝ fǝran nggǝmnan Yesu wa, thlaˈtǝ fartǝˈini nefsǝ mbǝschǝ alkǝt nggǝr chǝhan mee paɗ wa.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">Tǝɗan Yesu thlǝmati nafcha kǝɗar chaˈandi fǝ chaˈandǝ kusiˈ i Musa kaɗi tǝ yi Farisawecha</para>
  <para style="r">(<ref loc="MRK 12:38-40">Mar 12:38-40</ref>; <ref loc="LUK 11:37-54">Luk 11:37-54</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />Ndangkǝ Yesu tertǝ nggommǝn nafchǝ tǝ kǝmsichiyan wa, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />Fǝ chaˈandǝ kusiˈ i Musa kaɗi tǝ Farisawecha, tandǝ chǝt teri Musa yi chaˈandǝ kusiˈchi kaɗi. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />Kǝthlǝm ndaˈan, kǝ chuwun ǝnɗi nat chaˈowunndǝ ndǝ har, paɗ kǝ chuwun ǝnɗi thlǝ chǝtnda wa, kǝthlǝm chǝwandǝ ǝnɗi thlǝ chaˈandǝ ndǝ kaɗ wa. <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />Thlǝ kǝnan chandǝ ichǝ ha lǝklǝk, thla na tǝrtaˈan ˈyang ˈyang, kǝ ɗǝfndǝ nafchǝ kǝ tǝrnda. Paɗaa kǝsawandǝ tandǝs kǝ thlaˈandǝ chika tǝ wan hera wa. <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" />Nat tarchiɗi thlǝ chǝt nda thlǝ chichandǝ kǝthlǝm kǝ nǝ nafcha. Thlǝ kinchandǝ paktǝ fǝttǝ ndikti Farta kǝ paˈanchannda, thlǝ pǝsanchandǝ mii kapechˈyanda kǝnandǝ njang njang. <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />Thlǝ yahchandǝ kǝthl nǝ fee fǝran paktǝ mǝtchokti paktech tanda ǝ mǝt mbǝnfata. Thlǝ yahchandǝ kwastǝ mitchokcha thla nech ndiˈchan ǝ wur nggomnda. <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />Thlǝ yahchandǝ kǝn fee ndan ǝn tanda tǝ fǝr maanda ǝ lǝmo, paɗ kǝthl nǝfee ˈya tanda wa fǝ chaˈan chaˈan kaɗi. <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />Paɗaa ngguwun kǝ i fee wunchi wa fǝ chaˈan chaˈan kaɗ wa, kǝthlǝm thlǝ chaˈanan ˈyowun kaɗ arta, ngguwun natwun wanmanchǝ raˈan. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />Kǝ ˈyowun nef hur heshiɗiya wa Chinda wa. Kǝthlǝm Chindǝ arta mǝɗyowun thla nech hulafǝrta. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />Kǝ nggǝmwun fǝ kǝ i fee wunchi wa pangnda wa. Kǝthlǝm pangndiyowun arta mǝthlan nech kǝ Kǝristi. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" />Thla nech manchan hurwun kǝ chok kǝ thlǝ terˈyowun. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" />Thla mananchi indiyan nafee njirandǝ kaɗi, thla njiranchi indiyan kaɗ paɗ nafee mananda.<verse eid="MAT 23:12" /></para>
  <para style="s">Yanan Yesu fǝ thlǝm inchiyandǝ ha</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />“Aiˈyowun kun fǝ chaˈandǝ kusiˈ i Musa kaɗi tǝ Farisawecha. Kun fǝ wenicha. Nggǝlawun mikǝnndi nafchǝ kǝ yimndǝ kǝ kuturakti hulafǝrta wa, kun paɗ yimwowun su wa, ˈyatankowun fee nech yah yimndǝsi, kǝ yimndǝsi. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" />[Aiˈyowun kun fǝ chaˈandǝ kusiˈ i Musa kaɗi tǝ Farisawecha, kun fǝ wenicha. Thlǝ yimchowun kǝ wurchi nǝssǝɗi mǝrtǝ hǝssiyanda, kǝ thlǝnawun ichiɗi malandǝ fee tandǝ ha. Thlǝ nechowun tulongandǝ shita yi lekta kǝthlǝm kǝ thlǝmwun nafcha, kǝthlǝm ndaˈan chakmiɗi naa fee choˈwun nda nan nat welǝlǝ kaan.] <verse eid="MAT 23:14" /><verse number="15" style="v" sid="MAT 23:15" />Aiˈyowun kun fǝ chaˈandǝ kusiˈ i Musa kaɗi tǝ Farisawecha, kun fǝ wenicha. Thlǝ tallang chowun hawurcha, kǝ ɗǝwun kǝ hahichǝ langnga kǝthlǝm kǝ mbǝswun thla nech tǝrtǝ ha arta. Maa mbǝswun, thlǝ tǝɓranchowun ha kǝ pǝɗowunchǝ ha chap kǝ chok kǝ wan wata kǝɗ kun. <verse eid="MAT 23:15" /><verse number="16" style="v" sid="MAT 23:16" />Ai yowun, komincha fǝ pǝn mbancha. Thlǝ ndechowun wa, ‘Nat thla ransech tǝ Wiri Farta, chok wa nwaat kǝ chǝt ǝnɗi ransatǝn kǝ ɗaran wa. Paɗ nat thla ransech tǝ rathlaɗi hur Wiri Farta, chokchan nwaat kǝ chǝt ǝnɗi ransatǝn kǝ ɗaran.’ <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />Kun ɓam komincha, yen nech manchan. Rathlaɗan wa, ndu Wiri Farta thla chanchi rathlaɗan chiɗ chiɗ wa? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />Thlǝ ndechowun paɗ wa, ‘Nat thla ransech tǝ mǝt thle ɓǝra icha, chok wa nwaat kǝ chǝt ǝnɗi ransatǝn kǝ ɗaran wa. Paɗ nat thla ransech tǝ pafǝn tǝɗi nech ɗar mǝt thle ɓǝra ichaˈan, nwaat kǝ chǝt ǝnɗi ransatǝn kǝ ɗaran.’ <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />Kun komincha, yen nech manchan, pafǝn taˈan wa, ndu mǝt thle ɓǝra ichiɗi thlǝ chanchi pafǝntaˈan kaɗ chiɗ chiɗ wa? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />Kǝthlǝm ndaˈan nat thla ransech tǝ mǝt thle ɓǝra icha, ransechan tǝ mǝt thle ɓǝra icha, tǝ ǝnɗi nech ɗar mǝt thle ɓǝra ichaˈan. <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />Paɗ nat thla ransech tǝ Wiri Farta, ransechan tǝ Wiri Farta, tǝ paɗ Farta thla nech ɗas huran. <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" />Paɗ nat thla ransech tǝ hulafǝrta, ransechan tǝ mitchokti Farta, tǝ thla nech ɗas ɗar mitchoktaˈan paɗ. <verse eid="MAT 23:22" /><verse number="23" style="v" sid="MAT 23:23" />“Aiˈyowun kun fǝ chaˈandǝ kusiˈ i Musa kaɗi tǝ Farisawecha, kun fǝ wenicha. Thlǝ fǝranchowun arta hur kum Farta pafǝn ichiɗi thlǝ chanchǝ ɗǝsǝmndǝ wathlthla. Paɗ ɗǝpawowunsǝ tǝ ichiɗi nech manchan ǝ hur kusiˈ i Musa wa. Ichǝ kǝɗ, chakandǝ kit ha tǝ lekta, tǝ haɗandǝ nafchǝ fa, tǝ thlǝnandǝ ǝnɗi kaɗ nech keˈke. Feya kǝmchisi kǝthl nowun chǝta, ngga kǝ malawun takichaˈan wa. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />Kun komincha fǝ pǝn mbancha, thlǝ yimanchowun wan thlǝriya, paɗ kǝ mǝɗnggawun ngellupa. <verse eid="MAT 23:24" /><verse number="25" style="v" sid="MAT 23:25" />“Aiˈyowun kun fǝ chaˈandǝ kusiˈ i Musa kaɗi tǝ Farisawecha, kun fǝ wenicha. Thlǝ chapanchowun kǝrsǝ tǝɓ saa ˈyem kaɗi tǝ tiɓa, paɗ huran ndiiɗ ndǝ kaɗ tǝ tǝkǝmǝn ichiɗi thlǝnanduwun hari nafcha tǝ alkǝta, tǝ yah inda. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />Chǝ komin thlǝ Farisawata, lo chapandǝn hur tǝɓ saa ˈyaman kaɗi tǝ tǝɓan, kǝno chapandǝ kǝrsaˈan kaɗ paɗ. <verse eid="MAT 23:26" /><verse number="27" style="v" sid="MAT 23:27" />“Aiˈyowun kun fǝ chaˈandǝ kusiˈ i Musa kaɗi tǝ Farisawecha, kun fǝ wenicha. Nechowun kǝɗ kwi mǝmatechiɗi thla paˈandǝ fee heɗɗitǝ fǝrta, kǝ chok ndiˈchan ǝ wenitǝ ǝ heshi. Paɗ tǝ huran pef kǝ alchi nafcha, tǝ pata samǝn samǝn. <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />Nechowun kǝɗu paɗ, ǝ mǝɗi nafcha thlǝ nechandǝ wunchi kǝɗ kaa nafchǝ nakowun, paɗ tǝ huran, ndiiɗ wun kaɗ tǝ wenikǝta tǝ sǝɓtǝ fata.<verse eid="MAT 23:28" /></para>
  <para style="s">Mbuˈ Yesu ɓahtǝɗi ha natndǝ sata</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />“Aiˈyowun kun fǝ chaˈandǝ kusiˈ i Musa kaɗi tǝ Farisawecha, kun fǝ wenicha. Thlǝ tǝnchowun kwichi fǝ shenuˈchǝ tǝ yahti Farta, tǝ paɗ thlǝ tǝnchowun ichiɗi naa fee kǝɗuktǝ tǝ kaa nafcha paɗ kǝ kwasawun tǝnchaˈan. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />Thlǝ ndechowun wa, ‘Mamwa nggǝmǝnsi thlǝhaɗi i kakechmǝn, mǝ wumawamǝn indǝ tǝ tandǝ tǝ thlǝrandǝ farchi fǝ shenuˈtǝ yahti Farta wa.’ <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />Tǝkǝɗu pǝndǝwun wa kun wanchi fee ɓǝlanchǝ fǝ shenuˈtǝ tǝ yahti Farta. <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />Hacha, ndiiɗaman tǝɓtartǝ sǝɓtǝ tarchǝɗi nggaktǝ kakechwun ha. <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" />Kun wuruɓcha, kun nggomǝn paɗechiɗiya. Tǝ kǝn natwun hǝraˈta, tǝ chak miɗi nech ɗǝftǝs, kǝ cham fee wunchǝ kǝ hur wata ǝ pan? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />Kǝthlǝm ndaˈan nggǝt thlǝnowun fǝ shenuˈchǝ tǝ yahti Farta, tǝ fǝ mbǝrˈicha, tǝ fǝ chaˈandǝ kusiˈ i Musa kaɗi. Nowun ɓǝlandǝ fowuna. Kǝ kukwawun fowun ha ɓǝra palangnda. Tǝ paɗ kǝ thlǝfawun fowun ǝ kǝtǝn shichiyowun. Kǝnowun para tandǝ mǝrɓǝ-mǝrɓa, kǝnowun fǝran panchǝ tanda. <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />Tǝ kǝɗu, feri kaa nafchiɗi nat thlǝrandǝ fee kaɗ ǝ hur heshi nan nggǝrowunndǝ kǝ in. Thlaˈtǝ ǝ feri Habila thlǝ kafata, ɓakan kǝ Zakariya waˈi Barakiya thla ɓǝlandǝwun pǝthlǝr mǝɗi nech chǝɗchǝɗ tǝ mǝt thle ɓǝra icha. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />Kittaˈan nati mbuˈowunda, nat nggwar kwanachiɗiya nan ɓat kǝɗar nafchi yuwa heshiɗiya.”<verse eid="MAT 23:36" /></para>
  <para style="s">Yah Yesu Urshelima kaan</para>
  <para style="r">(<ref loc="LUK 13:34-35">Luk 13:34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />Aiˈyowun aiˈyowun kun nafchi Urshelima, Urshelima. Kun tǝɗi ɓǝlanchi fǝ shenuˈchǝ tǝ yahti Farta, nggun tǝɗi paɗ mǝmakanchi fee thlǝndǝ fee kǝmɗiyowun. Kurɓandǝ kurmi yahti kǝ nggommowunchi kǝ mǝt arta, kǝɗ ǝnɗi thlǝ nggomandǝ chemsǝ wanchiyan kǝ hur pǝpahchiyan, paɗ nggǝmiwowun fa wa. <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />Nakanya mallowunchi fee wirˈyowun kuflǝng. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />Sǝkam kǝ mbuˈowunchi nowun nggǝr naa nenchi paɗ wa, se ma ndiwun wa, ‘Thlǝ mbǝsˈǝnhar nakan thla nech ɓat hur thlǝm Chinda.’”<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">Ndik Yesu kǝ ɗar mbanɗi naa fee tokandǝ Wiri Farta ha</para>
  <para style="r">(<ref loc="MRK 13:1-2">Mar 13:1-2</ref>; <ref loc="LUK 21:5-6">Luk 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />Kǝ chek Yesu kesh hur kǝtǝn shitaˈan mǝthlan ɗar wiˈta, chat pǝnankǝ kǝmsichiyan tǝnchi Wiri Fartaˈan. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />Chǝhan kan mee tanda ndakan wa, “Niwun tǝnchiɗi nat ya wa? Kittaˈan nati mbuˈowun nda, Naa fee tutokandǝ ha. Ɗekwensǝ chǝk arta thla na fee maltǝ ɗar yowun wa.”<verse eid="MAT 24:2" /></para>
  <para style="s">Ɓahtǝɗi ha naa fee sata ǝ ndukwa wanmincha</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />Yesu ɗas ɗar Tinringǝn Ɗǝfchǝ Zaitun, ɓak kǝmsichiyan mbǝsndi ichǝt nanda chǝhankanda wa, “Mbuˈaˈanndǝn kwat na ichiɗa sǝɓta? Paɗaa mǝ nech kǝ wanɗǝsǝn ɓatˈyo kaɗi tǝ paɗ ndukwati yuwa heshi?” <verse eid="MAT 24:3" /><verse number="4" style="v" sid="MAT 24:4" />Nggǝmankǝ Yesu tandǝsi ndakan wa, “Kaɗam har, mǝ thlǝm yowun wunchi wa. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />Kǝthlǝm na nafchǝ terchan ɓat ǝ hur thlǝmna, nandǝ ndat wa, ‘Nggaˈan nech kǝ Kǝristi,’ kǝ thlǝm ndǝ nafchǝ terchan. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />Nowun sǝk ndiktǝ yaancha tǝ kusheˈtǝ yaancha. Mǝ lekuwun wa, kǝthlǝm nwaat kǝɗu kǝ sǝɓa, paɗ ɓawu ndukwaɗan kwaɗǝn wa. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />Na hahǝ thlaˈandǝ hahǝ fa, kuturakta kǝ thlaˈanchi yowun kuturaktǝ fa. Paɗ na fee chǝt mita tǝ yiraˈti hahǝ fa ǝ michi samǝn samǝn. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />Paɗ nat ichiɗa tǝrkwathl kan nggwarkwana kwaɗǝn, kǝɗ ǝnɗi naa tǝrkwathl kan hatǝ nggǝtti nunefa. <verse eid="MAT 24:8" /><verse number="9" style="v" sid="MAT 24:9" />“Kǝrsaɗan nandǝ fǝrwunchi kǝ ɓahowun chǝ fee, tǝ paɗ kǝ ɓǝlowunchǝ nda. Naa fee karwunchǝ ǝ heshiɗiya nat kǝthlǝm thlǝmna. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />Ə fartǝˈini terchan fee nech chǝt wansarta hur fǝr kit. Kǝ fǝrndǝ raˈan mi, tǝ paɗ kǝ karndǝ raˈan. <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />Fǝ shenuˈtǝ yahti Farta fee nech kǝ fǝ lekcha terchan nech thlaˈta, kǝ sakandǝ nafchǝ terchan. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />Kǝthlǝm tertǝ ɓǝɓifata, thlǝrɗaktǝɗi thlǝ chǝt nafchǝ kǝmɗi raˈan nan mbit kaɗi. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" />Paɗ nat thla kǝrǝschǝ kǝ ndukaɗan, nan hǝraˈta. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />Paɗ na fee ɓas kusheˈtǝ kwastǝ ndikta yi sǝkta yi kutarakti hulafǝrta ǝ hur heshi nat. Kǝchok kǝ wanɗǝsǝnan kǝmɗi kwathl nafchi heshi nat, kǝn ndukwaɗan ɓata.<verse eid="MAT 24:14" /></para>
  <para style="s">Nggwarnggwariˈ tǝ ɓahta</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />“Kǝthlǝm ndaˈan, maa niwun ǝna tǝkǝmndǝ thla thlǝ ɓech tǝ tǝktǝkaɗi, thla mbuˈtǝ thlǝ shenuˈtǝ tǝ yahti Farta Daniyel, mǝthlan kit Mǝɗi Nech Chiɗ chiɗ. Malan thla nech channgga nda, kǝ wathlanchi ha. <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />Tǝkǝɗu, fee nech hur hahi Yahudiya kǝ rakandǝ kǝ hur nggwalcha. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" />Thla nech ɗar kǝnnda mǝ tǝrkah wa tǝn ɓat tǝr ǝn hur wirˈyan wa. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />Thla nech hǝnggǝ paɗ mǝ nggǝranchi in wa tǝn ɓat tǝr ǝna chip ta wa. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />Ai i nǝssiɗi na wanchi hwirˈyanda, tǝ fee na wanwaˈyaarchandǝsi ǝ hur wanmǝnchaˈan. <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />Shiyaman Farta kǝ ɓǝ rakaɗiya ndǝri mbita ndu far yipta wa (Asabar). <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" />Ə wanshengǝnˈini na ngwarkwana natsi kaan. Weˈtǝ thla tamwaktǝ fee chǝta thlaˈtǝ tǝrkwathl kan heshi se nakanya. Nǝ fee tamchǝ weˈtǝ ndaˈan paɗ wa. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />Mangga kǝthlǝm kǝt ǝnɗi takandǝ fee wanmǝnchaˈan ha wa, mǝ nggǝ nefsǝ nech hǝraˈta wa. Paɗ kǝthlǝm kǝt tachaˈan na fee takandǝ wanmǝnchaˈan ha. <verse eid="MAT 24:22" /><verse number="23" style="v" sid="MAT 24:23" />Ə wanshengǝnˈini, chǝka ndowunchǝ yowun wa, ‘Nama, ǝ Kǝristi ya.’ ndu, ‘Mǝthlan yu,’ mǝ fǝrwun kit suwa. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />Kǝthlǝm Kǝristi i lekcha tǝ fǝ shenuˈtǝ tǝ yahti Farta kǝ fǝ lekcha nandǝ naa chet kesh. Kǝ chǝndǝ paktǝ wanɗǝsǝncha tǝ ǝna saka incha kǝthlǝm kǝ sakandǝ nafchiɗi tatǝ Farta, ma nan chǝta. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />Nama, tapi mbuˈowunchi leɗ. <verse eid="MAT 24:25" /><verse number="26" style="v" sid="MAT 24:26" />Kǝthlǝm ndaˈan maa ǝ ndowunchi nda wa, ‘Mǝthlan ǝ hur chanjeyu,’ mǝ chowun kesh wa. Maa ǝ ndi ndǝ paɗ wa, ‘Mǝthlan hur wan kǝnnda,’ mǝ fǝrwun kit su wa. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />Kǝthlǝm kǝɗ ǝnɗi thlǝ thlaˈtǝ withlwiˈta mǝt che farta na fee nata kǝ mǝt hǝmǝn farta, kǝɗu na ɓati nggǝta Waˈi Nef nata. <verse eid="MAT 24:27" /><verse number="28" style="v" sid="MAT 24:28" />Mǝɗi na mǝrtǝ ǝna, minni thlǝ nggomndǝ kutukcha.<verse eid="MAT 24:28" /></para>
  <para style="s">Nggǝr ɓati nggǝta Waˈi Nefa</para>
  <para style="r">(<ref loc="MRK 13:24-27">Mar 13:24-27</ref>; <ref loc="LUK 21:25-28">Luk 21:25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />“Kǝrsǝ ngawarnggwariˈ tǝ ɓahtiˈini,</para>
  <para style="q1" vid="MAT 24:29">“‘Chat naa watfartǝ chǝt kaɗ kǝ wuthla,</para>
  <para style="q2" vid="MAT 24:29">ndǝr paɗ nech fǝr ɗaˈkǝta wa.</para>
  <para style="q1" vid="MAT 24:29">Wanndǝrichǝ paɗ nandǝ hǝhatat kaha ǝ hulafǝrta,</para>
  <para style="q2" vid="MAT 24:29">paɗ na fee yiraˈandǝ alkǝchi hulafǝrta.’”<verse eid="MAT 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30" />Ə wanshengngǝnˈini wansǝndi nggǝta Waˈi Nefa nan pǝn fatˈyan ǝ hulafǝrta. Kwathl heshi nat paɗ nandǝ tǝta. Maa nindǝ nggǝta Waˈi Nefa ɓata hur husaba tǝ alkǝta tǝ manda kaa kaan. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />Paɗ nan thlǝn fǝ thlǝnchiyan kǝ peendǝ mboˈumndǝ kaan. Fen paɗ kǝ nggomandǝ tachaˈan chǝk ǝ ayi ǝ hur heshi, thlaˈtǝ ǝ ndukwa heshiɗiya kǝ ndukwa heshi thla.<verse eid="MAT 24:31" /></para>
  <para style="s">Chaˈata ǝ ɓǝra ɗǝftǝ shukwata</para>
  <para style="r">(<ref loc="MRK 13:28-31">Mar 13:28-31</ref>; <ref loc="LUK 21:29-33">Luk 21:29-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />“Chaˈam ǝna yowuna fi ɗǝftǝ shukwata, ma niwun njarchiyan mǝthlan nggǝrtǝ ha, mǝthlan chithl yuwa saˈcha, kǝ sǝn wun suwa fektǝ nduk ha. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />Kǝɗu paɗ, ma niwun ichiɗi nat mbuˈowundiya, kǝ sǝn wun suwa mǝthlan nduk ha, mǝthlan mikǝnnda. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />Kittaˈan nati mbuˈowunda, nafchi yuwa heshiɗiya nandǝ timwa, se ma ndiiɗ ichiɗi ha ya nat. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />Hulafǝrtǝ tǝ heshi nandǝ timnda, paɗ ndiktinchi nech timwa.”<verse eid="MAT 24:35" /></para>
  <para style="s">Nefsǝ sǝnchǝ fartaˈan ndu wanshengngǝn ɓati Kǝristi kaɗ wa</para>
  <para style="r">(<ref loc="MRK 13:32-37">Mar 13:32-37</ref>; <ref loc="LUK 17:26-30">Luk 17:26-30</ref>; <ref loc="LUK 17:34-36">17:34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />“Paɗ kǝɗar fartaˈan ndu wanshengnan yowun sǝ sǝncha wa. Ndu fǝ thlǝnchi Farta ǝ hulafǝrta, ndu Wanan, se Chinan ndak. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />Kǝɗ thla chǝt fee ǝ thlǝhati Nuhu, nech ɓati Waˈi nef nat kǝɗu paɗ. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />Kǝthlǝm ǝ thlǝheˈini kǝn kappa erˈini. Fee sǝmnda, fee sata, hǝssa tǝrtǝ kan, fee fǝr nǝssǝ kan paɗ, kǝ fartǝɗi yimndǝ Nuhu kǝ hur shirkin tǝ ˈyaman. <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />Sǝnwandǝ ǝnɗi nech sǝɓta wa, ɓak kappa ˈyamɗi nggǝlanda, ɓǝlandǝ tandǝ nat. Kǝɗu paɗ na nggǝr ɓati Waˈi nef nata. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />Ə wanshengngǝnˈini, naa nafchǝ nat ǝ hǝngga, naa fee tǝrandǝ arta, kǝ mal fee artǝ si. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />Naa nǝssǝ naa haˈtǝ ɗar ɗakwan fǝndǝ rat, naa fee tǝr arta, kǝ mal fee artǝ si. <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />Kǝthlǝm ndaˈan chokam tǝ tahǝsfa, kǝthlǝm sǝnwowun fartǝɗi naa Chindǝ ɓat kaɗ wa. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" />Paɗ kǝ wathlowunchǝ ǝnɗa ha, mam wa tǝ sǝn thlǝwir wanshengngǝnɗi na yerǝ ɓat wita, mǝ ngech saˈena wa. Paɗ nee malanchi kǝ yim fee kweuriyan wa. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />Kǝthlǝm ndaˈan nwaat kun paɗ kǝ chok wun tǝ tahǝsfa, kǝthlǝm ǝ wanshengngǝnɗi sakwaktǝ wun, naa Waˈi Nef ɓat kaɗi.<verse eid="MAT 24:44" /></para>
  <para style="s">Mafata thlǝ thlǝnandǝ ǝn kaɗ keˈkeˈ ndu thlǝ thlǝnawaktǝ ǝn kaɗ keˈkeˈ.</para>
  <para style="r">(<ref loc="LUK 12:41-48">Luk 12:41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />“Wun nech kǝ mafaɗiya thlǝ thlǝnandǝ ǝn kaɗ keˈkeˈ, thlǝ hur inda, thla naa thlǝwirˈyan ɗǝf anchis kǝ ɗǝɓ har tǝ maafechiɗi nech wirˈyan. Kǝ fǝranchi tandǝ ɗǝsǝmndiyandǝ ǝ wanshengngǝnchǝɗi kǝmchǝsi? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />Thlǝ mbǝs ǝn har kǝmɗi mafanɗi, maa ǝ ɓi thlǝwirˈyan ɓat mbǝsandǝ mǝthlan chǝt ǝnɗi ndanɗǝ fee wa kǝn chǝta. <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />Kittaˈan nati mbuˈowunnda, nan ɗǝf mafaɗiya kǝ ɗǝɓ har tǝ ichiɗi nessiyan nat. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />Paɗ maa mafaɗan kǝ sǝɓtǝ nefa, ndangkan indiyan paɗ wa, ‘Thlǝwirinchi nee ɓi kaɗ leɗ wa.’ <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />Kǝ nggaktǝ thlǝfandǝ shikechǝ terˈyan, mǝthlan sǝmnda, mǝthlan sata tǝ fǝ saa mbaalcha. <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />Nech thlǝwiri mafeˈini ɓat ǝ fartǝɗi sakwaktǝn, paɗ ǝ wanshengngǝnɗi sǝnwaktǝn. <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />Naa thlǝ wuranˈyan thlifanda farchǝ kaha, ǝnɗi nech kǝs fǝ wenikicha fee thlǝ thlǝmchǝ nafcha, mǝthlan maa ndaˈan nech kǝsndi. Ə minni naa nafchǝ tǝta tǝ kan wanthlancha.<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">Wuɓtǝ ɗikta tǝ wanterechǝ kum fee sǝn wakchǝ hǝssa</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />“Fartǝˈini, nech fee kanda ndǝ kuturakti Hulafǝrta tǝ wanterchiɗi kum fee sǝn wakchǝ hish nef yu, fee tǝrchǝ wech ˈyanda kǝ ndǝ ɗǝ pǝk chǝma perra. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />Ɗǝrman hurnanda mbamcha, ɗǝrman paɗ ɗathlchan nda. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />Ɓamchǝɗi ɗǝrman yu tǝrkandǝ fitillachanda paɗ takwandǝ chektǝ fiɗetˈin wa. <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />Fee nech ɗathlchan yu paɗ kǝsndǝ fiɗechǝhar hur kuruɓcha ɓukwa tǝ fitillachanda. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />Chǝ maa perriˈyan paɗ ɓawa leɗ wa, nak en fiyandǝ nat nda, saˈ kandǝ enna.<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />Paɗ ɗar wita, hwak fee tǝ kapa ɓǝrata, ndat wa, ‘Ə chǝ maperriyan nech ɓat yu. Chemkesh kǝ mboˈwun kakndǝ fa.’<verse eid="MAT 25:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7" />Nat wan terechǝɗi kum yu thlaˈ kanda tasankandǝ fitillachanda. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />Chat ndangkǝ ɓamchǝɗi fee nech ɗathlchan yu wa, ‘Chamaˈan fiɗet ˈyowunsi, kǝthlǝm fitilachiyaˈan thlefta.’<verse eid="MAT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9" />Paɗ nggǝmankǝ fee nech ɗathlchan yu tanda wa, “‘Auwa, chokkan nggaˈan tǝ kun fiɗeɗan nee chaˈamǝn chǝ wa. Kwechchan ɗǝtwun kǝmɗi thlǝ hiyandǝ fee kaɗi kǝ hiwun yuwun.’ <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />Tandǝ ɗar wiˈtǝ kǝ mǝt hi fiɗeɗan, saˈ kǝ chǝma perriˈyan. Fee harchǝf yu, yimkandǝ kǝ mǝt rǝɓtaˈan tǝ chǝma perriˈyan. Nggǝlang kǝ fee mii kǝtǝnan. <verse eid="MAT 25:10" /><verse number="11" style="v" sid="MAT 25:11" />Kǝ kǝrsa takǝt wanterechiɗi ɗich hi fiɗet yu, ɓakanda, nda kanda wa, ‘Thlǝmanda, thlǝmanda, inaˈan ndǝnsi.’<verse eid="MAT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12" />Paɗ nggǝrangkǝ chǝma perriˈyan tandǝs wa, ‘Kittaˈan nati mbuˈowunda, sǝnwi wunchi wa.’<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />“Kǝthlǝm ndaˈan chokam tǝ tahǝsfa, kǝthlǝm sǝn wowun fartaˈan ndu wanshengǝnɗi naa nggǝta Waˈi Nef ɓat kaɗ wa.”<verse eid="MAT 25:13" /></para>
  <para style="s">Chaˈandǝ kaɗ kǝ ɗar fǝ tarchi mahkan</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />“Kuturakti Hulafǝrta nechan nat kǝɗ yowun nefa thla nech wita, ˈyakan mafechˈyan, fǝrangkan kǝnauˈyan tandǝ kǝ harˈyanda. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />Fǝrankan arta talanti ɗǝrman, chapataˈan talanti chap, yowun fǝrankan arta, chikawuni keˈkeˈ tǝ alkǝtˈyan. Chat pǝɗakan kumichaˈan. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />Thla thlǝch talanti ɗǝrman yu, chat kǝɗuyu ɗǝkan nakan chǝt lǝmo kǝɗ si, mbǝskan ǝnsi kǝ ɗaran ndǝrman paɗ. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />Kǝɗu paɗ thla thlǝch talanti chap yu, mǝthlan paɗ mbǝstǝ chektǝ kǝ ɗaran chap. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />Paɗ thla thlǝch talanti artǝ yu, ɗǝkan kohhǝt haha teshankan kǝnauɗi thlǝwuranˈyan ha yu ǝ huran. <verse eid="MAT 25:18" /><verse number="19" style="v" sid="MAT 25:19" />“Kǝrsǝ wanmǝnchǝ terchan, ɓak thlǝwuran ˈyandǝ kaɗi. ˈYankan tandǝ kǝthlǝm kǝ mbuˈndǝ ǝnɗi chǝt ndǝs tǝ wanɗǝɓithlɗi chakandǝn tanda. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />Ɓak thla fǝrandǝ fee talanti ɗǝrman yu. Ɓakan kǝ pangnga tǝ talanti ɗǝrman ndakan wa, ‘Thlǝwira, firichin talanti ɗǝrman. An paɗ ya, mbǝsinchi chektǝ kǝ inan ɗǝrman.’ <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />Ndangkǝ thlǝ wuran ˈyanwa, ‘Ahaa, kaa mafata, thlǝ kaa kǝta. Chǝn kaa kǝta kǝ ɗar ǝn ngguɗyeh, nii ɗǝf wech kǝ ɗǝmben har tǝ ichǝ terchan. Ɓo choku ha, kǝ mbinin fata tǝ nggǝta.’ <verse eid="MAT 25:21" /><verse number="22" style="v" sid="MAT 25:22" />Ɓak thla fǝrandǝ fee talanti chap yu ɗuk, ndakan wa, ‘Thlǝ wira, firichin talanti chap, mbǝski chektǝ kǝ inan chap paɗ.’ <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />Ndangkǝ thlǝ wuran wa, ‘Ahaa, kaa mafata, thlǝ kakǝta. Chǝn kaa kǝta kǝ ɗar ǝn ngguɗyeh, nii ɗǝf wech kǝ ɗǝmben har tǝ ichǝ terchan. Ɓo choku ha, kǝ mbinin fata tǝ nggǝta.’ <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />Thla fǝrandǝ fee talanti arta yu mǝthlan paɗ ɓakan nduk, ndakan wa, ‘Thlǝ wira, sǝninchǝ wa chǝ nefa thla thlǝ mbǝrwaktǝ fee si. Thlǝ hwechecho mǝɗi ngga chi weˈech weˈtaˈan wa. Thlǝ hathlcho mǝɗi ngga chǝ hǝf cha wa. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />Ndaˈan chǝt lekǝti, ɗiki kohǝt haha wuɓanki wanɗǝɓǝthlˈyo ha. Aˈan thlu ǝnɗi nech kǝ yu wa.’ <verse eid="MAT 25:25" /><verse number="26" style="v" sid="MAT 25:26" />Nggǝmang kǝ thlǝ wuran ˈyan ndangkan wa, ‘Chǝ ɓǝɓi mafata, yiɗa, awi shinin wa thlǝ halchi mǝɗi ngga kǝɗ hǝfcha wa. Ngǝt paɗ thlǝ hwechechi mǝɗi ngga nggǝt weˈech weˈtaˈan wa? <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />Mǝ kǝmchansi kǝ ɗǝfichǝn wanɗǝɓithlǝnchi ha kǝ mǝɗi nati mbǝs chektǝ kǝ ɗaran, ma ɓinchǝ kaɗi thlǝki ichinchi tǝ ˈyaman. <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />Kǝthlǝm ndaˈan thlam talanti tǝɗi nech haryan, kǝ fǝrawun thla nessan kum yu. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" />Kǝthlǝm nat thla na ǝnˈyansi, naa fee chekan nda, kǝ mbǝs terchan. Thla nawaktǝ ǝnyansi paɗ, chǝka ǝnɗi nessiyan ngguɗyeh, nafee thlǝt ǝ mǝɗ ˈyan. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" />Paɗ mǝkam koha mafaɗa kǝ pongngǝn wuthla. Mǝɗi na fee tǝta tǝ kang wanthlancha.’ ”<verse eid="MAT 25:30" /></para>
  <para style="s">Chak mee yi ndukwaɗan</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />“Fartǝ ɗi na nggǝta Waˈi Nefa ɓat kaɗi hur maandinchi tǝ fǝ thlǝnchǝ nat, chat kǝ choki ha kǝ ɗar mitchoktǝ kuturaktinchi yi maada. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />Naa fee nggommandǝ kwathl nafchǝ heshi nat kǝ pangngǝnaa, kǝ chakandǝ tandǝ ha sam-samǝn. Kǝɗ ǝnɗi thlǝ taɗandǝ thlǝ parat chohrechi kesh ǝ hur yukwecha. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />Nii ɗǝf chorecha tǝ har harsǝm inchi, yukwechǝ paɗ kǝ kaaku inchi. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />Kǝn Kuturan ndandǝ fee nech tǝ harsǝmˈyan wa, ‘Ɓama, kun tǝɗi ɗǝfowun ndǝ Papa mbǝs ǝn kǝ har. Kǝ thlǝwun sǝm kǝrsǝ mǝrtǝ kuturaktǝɗi tahsowun ndǝ Fartǝsi kǝn fee tǝn heshi. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />Kǝthlǝm kǝ sǝkki mita fǝrichǝwun ɗǝsǝmnda kǝ sǝmi. Kǝ sǝkki kwichimnda, fǝrichǝ wun ema kǝsi. Wiˈki ramkǝta, fǝrikowun mǝt hunata. <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />Nggǝt tandǝr kwaiˈ, fǝri kowun kapata. Haɗinchi, ɗǝpakowunsi nenchi. Nggǝt ǝ pursuna, wiˈikowun fa.’ <verse eid="MAT 25:36" /><verse number="37" style="v" sid="MAT 25:37" />Kǝn fǝ kafechaˈan nggǝmaanda wa, ‘Chinda, kwat nat ǝn wech mitǝfˈyo, furutǝˈǝn ɗǝsǝmnda? Ndu kwichǝmndǝ fiyo furutǝˈǝn em kǝ sen? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />Kwat paɗ nat ǝn wech kǝ rema, thlǝt ǝn wechi? Ndu tandǝr kwaiˈ, furutǝˈǝn kapata? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />Ndu kwat nat ǝn wech haˈchan ndu ǝ pursuna wiˈyu tǝ ǝn fa?’ <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />Na kuturan nggǝmandǝ tandǝ wa, ‘Kittaˈan nggǝt mbuˈowunnda, nakan chawun artǝ hur wanmanchiniɗa hǝssa tǝ nǝssa fee nech ngguɗyeh kaan. Nggǝt chandǝ wun.’ <verse eid="MAT 25:40" /><verse number="41" style="v" sid="MAT 25:41" />Kǝnan nda ndǝ fee nech kaaku ˈyan wa, ‘Chakam ha tǝ nenchi kun nafchiɗi hommbandǝ fee, yimam kǝ waɗi nawakchǝ tam lǝfta kǝ kwekǝchi. Thla tah sandǝ fee hweˈrǝsi tǝ fǝ thlǝnchiyan. <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />Kǝthlǝm mitifinchi fǝriwowun ɗǝsǝmnda kǝ sǝmi wa. Kǝsichi kwichimnda, fǝ riwowun ˈyam sata wa. <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />Chinchi ram kǝta, thlǝwowun nenchi wa. Nggǝ tandǝr kwaiˈ, fǝriwowun kapata wa. Haɗinchi paɗ nggǝt ǝ pursuna wiˈiwowun fa wa.’ <verse eid="MAT 25:43" /><verse number="44" style="v" sid="MAT 25:44" />Fen paɗ nandǝ nggǝmaanda wa, ‘Chinda, kwat nat ǝn wech mita, ndu kwichǝmnda, ndu ramkǝta, ndu tandǝr kwaiˈ, ndu hatǝ fata, ndu ǝ pursuna, kǝsu waˈan su wa?’ <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />Kǝn kuturan nggǝmandǝ tanda wa, ‘Kittaˈan nati mbuˈowun nda, nakan chawowun artǝ hur fee nech ngguɗyeh kaan ya wa, chiwowun wa.’ <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />Fee ya, naa fee pǝktanda kǝ ɓahta thla nawakchǝ tǝɓata. Fee nech tǝ kafat fǝ paɗ nandǝ yimndǝ kǝ shishingnda kǝ kwekǝchi.”<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">Wuman fee inda kǝ ɓilan fee Yesu</para>
  <para style="r">(<ref loc="MRK 11:1-2">Mar 11:1-2</ref>; <ref loc="LUK 22:1-2">Luk 22:1-2</ref>; <ref loc="JHN 11:45-53">Yoh 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />Kǝ tǝɓangkǝ Yesu mbuˈichiˈini nat yu. Chat ndangkan kǝmsichiyan wa, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />“Sǝnwunwa mbinfa tathla takchan mǝndǝ chap, naa fee fǝr nggǝta Waˈi Nefa kǝthlǝm kǝ kukwichi fee ha.”<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />Chat nggomkǝ paktǝ pangngǝnchǝ ha tǝ paktechi Yahudawecha ǝ wiri kappa pangnda thla naa thlǝman wa Kayafa. <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />Wuman kandǝ mee ǝ mbanɗi natndǝ kǝsandǝ Yesu ǝ wuɓta kǝ ɓilanda. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />Paɗ ndaka nda wa, “Ngga far mbǝnfaɗan wa, kǝthlǝm kǝ thlaˈan nafchǝ hur indi yanda wa.”<verse eid="MAT 26:5" /></para>
  <para style="s">Thlǝran fee Yesu fiɗet kǝ inda ǝ Betanya</para>
  <para style="r">(<ref loc="MRK 14:3-9">Mar 14:3-9</ref>; <ref loc="LUK 7:37-38">Luk 7:37-38</ref>; <ref loc="JHN 12:1-8">Yoh 12:1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />Kǝnak Yesu ǝ Betani ǝ wiri nafɗi thlǝ ˈya fee wa Siman, thla naa hatǝfa tarkwai fiyan choh. <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" />Chat ɓak yowun nunefa kǝmɗi Yesu tǝ kuruɓtǝɗi nech ndiˈchan kaan heet tǝ fiɗeɗi nech ˈyangˈyang. Thlǝrankan Yesu fiɗeɗan kǝ inda, ǝ wanshengngǝnɗi natǝn sǝm ɗǝsǝmnda.<verse eid="MAT 26:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8" />Paɗ kǝ nak kǝmsichaˈan kǝɗu, chat sǝɓkǝ hurchandǝ kaɗi ndang kandǝ raˈan wa, “Mǝ naa fee sǝɓandǝ ǝn kaɗ kǝɗa. <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />Mam wa tǝ hiyan fee fiɗeɗa kaɗi, mǝ naa fee hiyandǝ kaɗ ɗar wanɗǝɓithl kaan, mǝ tǝr wu fee wanɗǝɓithlan kǝ chakan fee fǝ ɓahcha wa?”<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />Paɗ nakan tapi sǝn Yesu ǝnɗi natndǝ mbuˈta ndangkan tanda wa, “Kǝthlǝm mǝ natwun ɓilla nuɗiya? Ai, ǝn ndiˈchan chitǝn. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />Fǝ ɓahcha tandǝ tǝ wunchi weenmǝta, paɗ nggǝta ngga weenmǝt nati nat tǝ wunchǝ wa. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />Fiɗeɗi thlǝritǝn kafya, tǝ tahsanchi fatinchi kǝthlǝm thlohta. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />Kittaˈan nati mbuˈowun nda, nat mǝɗi naa fee ɓas kwastǝ kusheˈtǝ ndiktǝɗa yi sǝkta, ǝ hur heshi nat. Naa fee mbuˈ ǝnɗi chǝt nuɗiya kǝthlǝm kuɗuktǝ tǝ ndi.”<verse eid="MAT 26:13" /></para>
  <para style="s">Nggim Yahuda Iskariyoti fa kǝ hiyanchi Yesu kaɗi</para>
  <para style="r">(<ref loc="MRK 14:10-11">Mar 14:10-11</ref>; <ref loc="LUK 22:3-6">Luk 22:3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />Chat artǝ hur kum nggǝrsǝ chap taˈan, thlana thlǝman wa Yahuda Iskariyoti. Ɗǝkan kǝmɗi paktǝ pangngǝncha, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />ndakan wa, “Mǝ nat wun fǝrita, maa hiyowunchi Yesu?” Shengngan kandǝ wanɗǝɓithl ɓishet kum chǝt mahkan fǝrang kanda. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />Nggak tǝ ǝ wanshengngǝnˈini nggakkan kaa mbanɗi natǝn hiyandǝ tandǝ Yesu.<verse eid="MAT 26:16" /></para>
  <para style="s">Sǝm Yesu ɗǝsǝmǝn mbǝnfa ɗathla tǝ kǝmsichiyan</para>
  <para style="r">(<ref loc="MRK 14:12-21">Mar 14:12-21</ref>; <ref loc="LUK 22:7-23">Luk 22:7-23</ref>; <ref loc="JHN 13:21-30">Yoh 13:21-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />Ə tǝrkwathl fartǝ mbǝnfa njohǝma thla nawaktǝ yistisi fiyan, ɓak kǝmsichaˈan kǝmɗi Yesu. Chǝhankandǝ tǝ ndat wa, “Ə ayi yahtusi kǝ tahsuchǝˈǝn mǝtsi, kǝthlǝm kǝ sǝmin ɗǝsǝmǝn mbǝnfa tathla?”<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />Nggǝmankan tanda wa, “Ɗam kǝ hur mǝrɓan kǝmɗi yowun nefa. Kǝ ndawun wa, ‘Ndech Thlǝchaˈanan kaɗ wa, wanshengnan inchi nduk ha, nii sǝm ɗǝsǝmǝn mbǝnfa tathla ǝ wirˈyo tǝ kǝmsichinchi.’” <verse eid="MAT 26:18" /><verse number="19" style="v" sid="MAT 26:19" />Kǝmsichaˈan paɗ chikandǝ kǝɗ ǝnɗi mbuˈandǝ Yesu tanda kǝ chǝ nda. Tahsan kandǝ ɗǝsǝmǝn mbǝnfa tathlan ha ǝ minni.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />Kǝ chǝk farwita, chokkǝ Yesu ha kǝthlǝm kǝ sǝm ndǝ ɗǝsǝmnan tǝ kǝmsichiɗan kum nggǝrsǝ chap yu. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />Tandǝ hur sǝm ɗǝsǝmnda chat ndangkǝ Yesu tanda wa, “Kittaˈan nati mbuˈowun nda, artǝ hur wun nan hiyitǝ kaɗi.”<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />Mbiɗ kǝ fatˈyandǝ kaɗi, nggakkandǝ chǝhan mee artǝ-arta nakandǝ ndat wa, “Nggǝta wa, Chinda?”<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />Nggǝmankǝ Yesu tanda, ndakan wa, “Thla nech sǝm ɗǝsǝmnda ǝ tiɓ arta tǝ nggǝta, mǝthlan nech hiyitǝ kaɗi. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />Nggǝta Waˈi Nefa nii mǝrta kǝɗ ǝnɗi yarandǝ fee ha hur Laulawati Farta kǝ indinchi. Paɗ ai i nafɗi nech hiyandǝ nggǝta Waˈi Nef kaɗi. Mǝ nat nan ndiˈchan mǝɗi nef ini mam wa mǝ nggǝt wu fee ndǝ wa.”<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />Chat ndak Yahuda thla nech hiyandǝ Yesu kaɗ yu wa, “Thlǝ chaˈanan kaɗi, ndu nggǝta wa?”</para>
  <para style="p" vid="MAT 26:25">Nggǝrangkǝ Yesu su wa, “Aa, ǝ mbuˈin.”<verse eid="MAT 26:25" /></para>
  <para style="s">Ndukwa sǝm ɗǝsǝmndi Yesu tǝ kǝmsichiyan</para>
  <para style="r">(<ref loc="MRK 14:22-26">Mar 14:22-26</ref>; <ref loc="LUK 22:15-20">Luk 22:15-20</ref>; <ref loc="1CO 11:23-25">1 Kor 11:23-25</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />Tandǝ hur sǝm ɗǝsǝmnda, Chat tǝrkǝ Yesu njohǝman, chǝkan usoko kǝmɗi Farta. Chichenkan njohǝman ha fǝrangkan kǝmsichiyan ndakan wa, “Thlama kǝ kangwun, thleya fatinchiniya.”<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />Tǝrkan tǝɓ saa ema thla naa ˈyam inabi huran. Kǝrsǝ chan usoko Farta, chat fǝrangkan tanda, ndakan wa, “Sama natwun. <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />Thleya ferinchi niya yi ndiiɗandǝ ɗǝf mee ha, thla naa fee thlǝrandǝ kaɗ kǝthlǝm nafchǝ terchan. Kǝthlǝm kǝ kalan Farta tandǝ ɓǝɓifechˈyandǝ ha. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />Nggǝt mbuˈowunda, peˈwi nggǝr saa ˈyam inabi tǝɗa wa, maangga fartǝɗi nati saa yuwa ˈyam inabi ɓukwa tǝ wunchi ǝ kuturakti Papa wa.<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />Kǝ in kǝ Yesu tǝ kǝmsichiyan emsa, chat chekandǝ kesh, pǝɗakandǝ kǝ Mǝt Ɗakwan Zaitun.<verse eid="MAT 26:30" /></para>
  <para style="s">Mbuˈ Yesu wa naa Biturus ass in sǝn ndi</para>
  <para style="r">(<ref loc="MRK 14:27-31">Mar 14:27-31</ref>; <ref loc="LUK 22:31-34">Luk 22:31-34</ref>; <ref loc="JHN 13:36-38">Yoh 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />Chat ndangkǝ Yesu tanda wa, “Natwun nowun rakata kǝ malwun nenchi ha ǝ witǝɗa, kǝthlǝm ǝnɗi nech sǝɓtǝ tǝ nggǝta. Nechan kǝ yaraɗan hur Laulawati Farta ndat wa,</para>
  <para style="q1" vid="MAT 26:31">“‘Nii ɓǝlandǝ thlǝ paraɗan,</para>
  <para style="q2" vid="MAT 26:31">chohrechiɗi chapan paɗ nandǝ wethlǝ ha.’”<verse eid="MAT 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 26:32" />“Paɗ kǝrsǝ thlaˈitǝ ǝ mǝrta, nii lat mǝ kun kǝ Galili.”<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />Nggǝmangkǝ Biturus wa, “Chǝka tǝ rakandǝ natnda kǝthlǝm ǝnɗi nech sǝɓtǝ tǝ wechi, nggǝt nii tam rakawa.”<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />Nggǝmangkǝ Yesu wa, “Kittaˈan nati mbuˈuta, ǝ witǝ ɗa, kǝn chakkartǝ kwarta, no ass in sǝn nenchi harke mahkan.”<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />Nggǝmangkǝ Biturus wa, “Chǝka tǝn fee ɓilitǝ tǝ wechi, nii ass in sǝn wech wa.”</para>
  <para style="p" vid="MAT 26:35">Takǝɗ kǝmsichaˈan nat mbuˈ kandǝ kǝɗu paɗ.<verse eid="MAT 26:35" /></para>
  <para style="s">Shii Yesu ǝ Gǝtsemani.</para>
  <para style="r">(<ref loc="MRK 14:32-42">Mar 14:32-42</ref>; <ref loc="LUK 22:39-46">Luk 22:39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />Kǝn Yesu tǝ kǝmsihichiyan ɗǝkandǝ kǝ mǝɗi thlǝ ˈya fee wa Getsemani mǝɗi thlǝ yimandǝ fee wan inabi. Ə minni ndangkan kǝmsichiyan wa, “Chokam ha mǝɗa, nggǝt chi kǝmɗi kǝ shiyi.” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />Chat pǝɗakan tǝ Biturus tǝ wanchiɗi Zabadi chap yu, Yabuku tǝ Yohanna. Nggakkan chǝt sǝɓtǝ hwira tǝ ɓillat kaan. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />Ndangkan tanda wa, “Sǝɓ hwirin chǝ kaɗ kaan, kǝɗ tǝni mǝrta. Thlaram ha mǝɗa, kǝ nowun tǝ tahǝsfa tǝ nggǝta.”<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />Kǝ ɗǝkan kǝ pang ngguɗyeh hǝmkan ha tǝ chimaandiyan ǝ haha shikan ndakan wa, “Papa, maa nan chǝta, tǝrandǝn tǝɓ saa ˈyam ɓahtǝɗinchi kaɗ ya. Ckǝka mǝ nakan wa ngga ǝnɗi yahti naa fee chǝta wa paɗ ǝnɗi yahtu.”<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />Ɓakan kaɗ kǝmɗi kǝmsichiɗan mahkan yu ɓakan mbǝsandǝ tandǝ saˈena. Ndangkan Biturus wa, “Awi, nowun mbahan chok tǝ tahǝsfa tǝ nenchi chǝka wanshengnan arta wa? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />Chokam tǝ tahǝsfa, paɗ kǝ nowun shita kǝ yimwun kǝ hur kaɗata wa. Shemeɗan yehi, paɗ faɗan alkǝtsǝ wa.”<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />Nggǝrkan nggǝrandǝˈin yi chapataˈan shikan. Ndakan wa, “Papa, manggǝ tǝɓ saa ˈyam ngwarkwana tǝɗa mbǝr ha wa, nwaat kǝ si, malan kanɗat ˈyo kǝ ndiiɗ ha.”<verse eid="MAT 26:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 26:43" />Nggǝrkan ɓat kaɗ kǝ thlǝmat nanda ɓakan mbǝsandǝ tandǝ saˈena, kǝthlǝm wenitǝˈyanda ndiiɗ kaɗ tǝ ena. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />Nggǝrkan maltandǝ ha ndǝkan shita yi mahkannan, nggǝrkan nggǝrandǝ shitǝɗi chǝtǝn choh.<verse eid="MAT 26:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45" />Ɓakan kaɗ kǝmɗi kǝmsichaˈan, ndangkan tanda wa, “Paˈkǝ nakanya nggun saˈena, kun yipta? Nama, wanshengnan nduk ha thla naa fee fǝr nggǝta Waˈi Nefa kǝ hari fǝ ɓǝɓifecha. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />Thlaˈama kǝ pǝɗamǝn. Thla nech fǝr nenchi, ǝ seˈi.”<verse eid="MAT 26:46" /></para>
  <para style="s">Mbanɗi fǝr tǝ Yahuda Yesu</para>
  <para style="r">(<ref loc="MRK 14:43-50">Mar 14:43-50</ref>; <ref loc="LUK 22:47-53">Luk 22:47-53</ref>; <ref loc="JHN 18:3-12">Yoh 18:3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />Kǝ nak Yesu ɗar shenuˈta chat ǝ Yahuda ya arta hur kǝmsichiɗan kum nggǝrsǝ chap yu ǝ seˈi. Tǝ nggommǝn nafchǝ terchan, kǝsndǝ wan fuhwichǝ har, tǝ nggoˈloorcha. Paktǝ pangngǝncha tǝ paktechi Yahudawech thlǝnchi tanda. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />Thla nech fǝr ndi tapi fǝranchǝ nggomǝn nafchaˈan wanɗǝsǝnan ndangkan tanda wa, “Thlanati nggǝthl ndǝ kafa, mǝthlan nech kǝ nafan. Kǝsa maandǝn.”<verse eid="MAT 26:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49" />Kǝ ɓak Yahuda chat mbǝrkan ha ndelengnga kǝ thlǝma Yesu ndangkan wa, “Kaɓikaɗi, Thlǝ chaˈanan kaɗi” Nggǝthl kan ndǝ kafa.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />Nggǝmangkǝ Yesu wa, “Shiketǝna, chu ǝnɗi ɓech tǝ wechi.”</para>
  <para style="p" vid="MAT 26:50">Chat ɓak nafchaˈan kǝsan kandǝ Yesu, kǝskandǝ anchi har ɓakrak. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />Tǝ nat kǝɗu, artǝ hur fee nech tǝ Yesu, kǝtankan wan fuhwaˈyan kesh, chathl kan mafati kappa pangnda, thlenkan thlǝmatˈyan kaɗi.<verse eid="MAT 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52" />Ndangkǝ Yesu wa, “Nggǝran wan fuhwaˈyo kaɗi, kǝthlǝm nat thla yanchǝ tǝ wan fuhwa, nechan mǝrta tǝmɗi wan fuhwa. <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />Sakcho wa nii mbahǝn shiyanchi Papa, paɗ kǝɗ thlǝ nakanya kǝ thlǝnichǝ fǝ thlǝnchiɗi nech pǝɗandǝ wumǝn fǝ thlǝrwecha ha kum nggǝrsǝ chap wa? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />Hacha, kan tǝ kǝni naa fee ndiiɗa ndǝ ǝnɗi ha mbuˈtǝ fee hur Ndikti Fartǝɗi ndech wa nwaat ǝnɗa kǝ sǝɓa?”<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />Ə wanshengngǝnˈini ndangkǝ Yesu nggomǝn nafchaˈan wa, “Ɓechowun kesh tǝ wan fuhwi cha, tǝ nggoˈloorcha kǝ kǝsi chuwun kǝɗ tǝni kǝ thlǝ fasa fata? Weenmǝta thlǝ chokchi ǝ Wiri Farta thlǝ chaˈanchi kaɗi kǝsi wowun wa. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />Paɗ nat ichiɗi sǝɓchiya ndiiɗantǝ ǝnɗi ha mbuˈtǝ fǝ shenuˈta tǝ yahti Farta ǝ hur yara ndikti Farta.”</para>
  <para style="p" vid="MAT 26:56">Kǝ sǝkkǝ kǝmsichiyan kǝɗuyu rakakanda, malkandǝ anchi ha.<verse eid="MAT 26:56" /></para>
  <para style="s">Ɗǝ fee tǝ Yesu kǝ pangngǝn Kayafa tǝ paktecha</para>
  <para style="r">(<ref loc="MRK 14:53-65">Mar 14:53-65</ref>; <ref loc="LUK 22:54-55">Luk 22:54-55</ref>; <ref loc="JHN 18:13-14">Yoh 18:13-14</ref>; <ref loc="JHN 18:19-24">18:19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />Chat fee kǝsanchi Yesu ɗǝkandǝ tǝ ndi kǝ pangngǝn Kayafa, kapa pangnda, mǝɗi nggomndǝ fǝ chaˈandǝ kusiˈ i Musa kaɗi tǝ paktechi Yahudawecha. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />Paɗ nak Biturus para ndi mǝt langngǝ toppaˈ, har kǝ saˈndǝ kǝ hur wiri kapa thlǝ pangnda. Kǝ yimkansi chokkan ha tǝ fǝ pǝk mii mbanchǝ har kǝthlǝm kǝ naa ndukwa ǝnɗi na fee tǝɓanda. <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />Tǝkǝɗu, paktǝ pangngǝncha tǝ takǝɗ paktechaˈan, kakandǝ koha lekcha thla naa fee chandǝ Yesu kafa kǝthlǝm kǝ mbǝsndǝ mban ɓilanda. <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />Paɗ mbǝswa nda wa, chǝka nakan fowunsi terchan fǝrchǝ koha lekchi kafˈyan. Ə ndukwaɗan ɓak fowun nafchǝ chap kǝ pangnga. <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" />Ndakanda wa, “Ndech naf ɗa wa nan mbahan tǝtokandǝ Wiri Farta kaɗi paɗ kǝ nggǝrtǝ tǝnanda ǝ hur mǝndǝ mahkan.”<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />Chat thlaˈkǝ kapa pangnan kit ndangkan wa, “Ə nggǝmndiyosi kǝ ɗar ǝnɗi mbuˈtǝ nafchiɗa kǝ ɗar wa wa?” <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />Paɗ nggaskǝ Yesu ɓaˈ. Chat ndangkǝ kapa pangnan wa, “Wumuchi tǝ Farta thlǝ Shishingnda, mbuˈaˈan ndǝn ndu chǝ nech kǝ Kǝristi Waˈi Farta wa.”<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />Nggǝmangkǝ Yesu wa, “Aa kit mbuˈtu. Paɗ nggǝt mbuˈowunda, thlaˈtǝ nakanya nowun naa nggǝta Waˈi Nef ɗas ǝ harsǝm i Thlǝ Maanda, mǝthlan ɓat paɗ ǝ hur husamba ǝ hulafǝrta.”<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />Chat kapa pangnan thlahankan kapatˈyan kaɗi kǝthlǝm sǝɓtǝ hwira, ndakan wa, “Mǝthlan ˈyara Farta. Shendi mǝ peˈtǝ mǝn kata? Nakanya sǝk wun ˈyaraɗi ˈyaratǝn Farta. <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />Mǝ nech kǝ kaɗatˈyowun?”</para>
  <para style="p" vid="MAT 26:66">Nggǝman kanda wa, “Cheˈsi kǝ ɓǝlan fee, kǝ ɗar ǝnɗi mbuˈtǝn.”<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />Chat chǝhan kandǝ yahtǝ kǝ chimanda, thlǝ thla fangkandǝ fa. Fee mbǝmbalan chǝf yu, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />ndakanda wa, “Kulo, nakan chǝ nech kǝ Kǝristi. Mbuˈaˈan ndǝn wun mbalech wechi?”<verse eid="MAT 26:68" /></para>
  <para style="s">Ass Biturus in sǝn Yesu</para>
  <para style="r">(<ref loc="MRK 14:66-72">Mar 14:66-72</ref>; <ref loc="LUK 22:56-62">Luk 22:56-62</ref>; <ref loc="JHN 18:15">Yoh 18:15</ref>; <ref loc="JHN 18:25-27">18:25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />Ə wanshengǝnchǝˈini Biturus mǝthlan ɗas file wuran. Chat ɓak yowun wannuwaa thla thlǝ chich ter ǝ wuran mbǝsndi ndangkan wa, “Chǝ paɗ necho tǝ Yesu thlǝ Galiliyawa tǝɗa.”<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />Paɗ askǝ Biturus inda ǝ pangngǝn nandǝ nat ndakan wa, “Nggǝt sǝn wi ǝnɗi natu ndiktǝ kǝ ɗaran wa.” <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />Kǝ ɓakan kesh kǝ mii wuran, chat nggǝrkǝ mafa wannuwaa nandi, ndangkan fee nech kikit minni wa, “Naf ɗiya mǝthlan tǝ Yesu thlǝ Nazarata.”<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />Nggǝrkǝ Biturus asˈinda tǝ ransata nakan ndat wa, “Lawi la sǝn nafan wa.”<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />Machi tollaa chat fee nech kikit minni ɓakandǝ nda ndǝ Biturus wa, “Asˈindǝs wa chǝ paɗ artǝ hurnanda. Kǝthlǝm weˈtǝ ndiktiyo pǝntǝ mǝɗi ɓatu.”<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />Chat nggakkan hommbandǝ indiyan nakan ransata, nakan ndat wa, “Lawi la sǝn naf ɗa wa.”</para>
  <para style="p" vid="MAT 26:74">Chat chat kǝɗuyu kwarkǝ chakkarta. <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />Chat kuɗukkǝ Biturus tǝ ndiktǝɗi nda ndǝ Yesu tǝ ndat wa, “Kǝn chakkartǝ kwarta, no ass in sǝn nenchi harke mahkan.” Chat chek Biturus kesh tǝkan kaan.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">Ɗǝ fee tǝ Yesu kǝ pangngǝn nggomna Bilatus kǝ chakan tǝ mee</para>
  <para style="r">(<ref loc="MRK 15:1">Mar 15:1</ref>; <ref loc="LUK 23:2">Luk 23:2</ref>; <ref loc="JHN 18:28-32">Yoh 18:28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />Kǝ wen kǝ mǝta, chat paktǝ pangngǝncha tǝ paktechi Yahudawecha tahsan kandǝ ha kǝthlǝm kǝ ɓǝlan fee Yesu. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />Chat kǝnan kandǝ ha, pǝɗa kandǝ taˈanchi, fǝr kandǝ ndi kǝ hari nggomna Bilatus.<verse eid="MAT 27:2" /></para>
  <para style="s">Kǝn Yahuda ǝn kǝ ɓǝr</para>
  <para style="r">(<ref loc="ACT 1:18-20">Aman 1:18-20</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />Kǝnak Yahuda Iskaryoyi ǝ chakan fee mee Yesu yi mǝrta, chǝkan sǝɓtǝ hwir kaan. Ɓakan kaɗ kǝmɗi paktǝ pangngǝncha tǝ paktechi Yahudawecha, nggǝrang kan tandǝ wanɗǝɓthl ɓishet kum chǝt mahkan tǝɗi kaɗi. <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />Ndakan wa, “Chinchi ɓǝɓifata hiyani feri thla mbisaa waktǝ fee tǝ ǝnfa kǝ ɓǝlan fee.”</para>
  <para style="p" vid="MAT 27:4">Paɗ ndakan nda wa, “Mǝ paˈancha? Thlenni ɓillaˈyo ni.”<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />Chat weˈyan kan wanɗǝɓthl ɓisheɗi kaɗi ǝ Wiri Farta, chekan kesh ɗǝkan kǝn ǝn kǝ ɓǝr.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />Paɗ paktǝ pangngǝnchaˈan kohkandǝ wanɗǝɓithlan. Nda kanda wa, “Kǝmwasi kǝ ɗǝf mǝn wanɗǝɓithl ɗiya kǝmǝt ɗǝf ǝni Wiri Farta wa, nakan wanɗǝɓithl fera.” <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />Chat tahsan kandǝ ha, hiyan kandǝ mǝti thlǝ tǝn ɓucha, kǝthlǝm mǝɗan kǝ chok kǝ mǝt thloh ramcha. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />Kǝthlǝm ndaˈan kǝnakan ya thlǝ ndech fee tǝ mǝ ɗan wa, mǝt fera. <verse eid="MAT 27:8" /><verse number="9" style="v" sid="MAT 27:9" />Tǝkǝɗu ndiiɗ ǝnɗi ha mbuˈtǝ thlǝ shenuˈtǝ tǝ yahti Farta Irmiya. Ndakan wa, “Tǝrkandǝ wanɗǝɓithl ɓisheɗi kum chǝt mahkan yu, wanɗǝɓithlɗi nggǝmandǝ nafchi Israˈilawecha kǝti fee kǝ ɗaran. <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />Hiyan kandǝ mǝti thlǝ tǝn ɓucha, kǝɗ ǝnɗi mbaˈitǝ Chinda.”<verse eid="MAT 27:10" /></para>
  <para style="s">Chakan Bilatus mee Yesu</para>
  <para style="r">(<ref loc="MRK 15:2-5">Mar 15:2-5</ref>; <ref loc="LUK 23:3-5">Luk 23:3-5</ref>; <ref loc="JHN 18:33-38">Yoh 18:33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />Chat thlarkǝ Yesu ha ǝ pangngǝn nggomna taˈan, chǝnhan kǝ nggomna taˈan mee tǝ ndat wa, “Chǝ nech kǝ Kwitiri Yahudawecha wa?” Nggǝmangkǝ Yesu wa, “Aa, kǝɗ ǝnɗi mbuˈtu.” <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />Paɗ kǝ mbuˈkǝ paktǝ pangngǝncha tǝ paktechi Yahudawech sǝɓtǝ ichiɗi tǝrtǝ nda wa ǝ chi, mbuˈ wa ǝna wa. <verse eid="MAT 27:12" /><verse number="13" style="v" sid="MAT 27:13" />Ndangkǝ Bilatus wa, “Sǝk wen ichiɗi mbuˈtǝ nda kǝ ɗar wa wa?” <verse eid="MAT 27:13" /><verse number="14" style="v" sid="MAT 27:14" />Paɗ nggǝma wu Yesu chǝha mee ˈyan chǝk arta wa, sakan kǝ indǝ nggomna taˈan kaan.<verse eid="MAT 27:14" /></para>
  <para style="s">Thlen fee Yesu chak mii mǝrtǝsi</para>
  <para style="r">(<ref loc="MRK 15:6-15">Mar 15:6-15</ref>; <ref loc="LUK 23:13-25">Luk 23:13-25</ref>; <ref loc="JHN 18:39">Yoh 18:39</ref>; <ref loc="JHN 19:16">19:16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />Ə chǝk yen wanshengngǝn mbǝnfa tathla, thlǝ kalanchǝ nggomna nafchǝ nef ha arta ǝ pursuna thla tatǝ nda. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />Ə fartaˈan yowunsi ǝ pursuna thla na thlǝman wa Yesu Barabas thla wulcha. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />Kǝ nggomkǝ nafchǝ ha ndangkǝ Bilatus tanda wa, “Wun yah tuwun kǝ kalowunchi ha? Yesu Barabas wa ndu Yesu tǝɗi thlǝ nda fee wa Kǝristi nakan?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />Kǝthlǝm Bilatus shin wa ɓechandǝ tǝ Yesu kǝ chakan fee mee kǝthlǝm sǝraˈta.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />Kǝ nak Bilatus ɗas ɗar mitchoktiyan yi chak mee, thlǝnan kǝ nuwan. Ndakan wa, “Kǝtan heryo kesh ɗar nafɗiya thla chǝwak chǝ ǝnya. Kǝthlǝm ɓukiya sǝnchi ɓahtǝ kaan tǝmɗi sǝnaˈtǝ kǝ ɗaran.”<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />Chat paktǝ pangngǝncha chǝkan kandǝ nafchǝɗi nech minni kǝ nda nda wa kǝ kal fee Barabas ha, kǝ ɓǝlan fee Kǝristi.<verse eid="MAT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21" />Nggǝrkǝ nggomna taˈan ndandǝ tanda wa, “Wun ǝ hur chap tǝɗa yahtǝ wun kǝ kalowunchi ndǝ ha?”</para>
  <para style="p" vid="MAT 27:21">Ndakan nda wa “Barabas.”<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />Ndangkǝ Bilatus tanda wa, “Mǝnati chǝssi Yesu thla thlǝ nda fee tǝ ndǝ wa Kǝristi nakan.”</para>
  <para style="p" vid="MAT 27:22">Nat nda ndaka nda wa, “Kǝ kukwan fee ha.”<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />Chǝhangkan tanda wa, “Kǝthlǝm mii? Weˈtǝ ɓǝɓifamǝ chǝtǝn?” Paɗ nafchaˈan nggǝr kandǝ thlaˈandǝ ɓǝrata nakandǝ ndat wa, “Kǝ kukwan fee ha.”<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />Kǝ nak Bilatus ǝnsi natǝn mbahǝn chǝta wa, paɗ yah nafchǝ thlaˈandǝ hur inda, chǝkan em har chapangkan herkaɗ ǝ pangngǝn nafchaˈan. ndangkan tanda wa, “Nggǝt herinchǝs ɗar mǝrti nafɗi chǝwak chǝ ǝn ya wa. Thleya ɓillaˈyowun nii.”<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />Chat nat nafchaˈan nggǝman kanda nda kandǝ wa, “Ferˈyan kǝ chok ǝ indiyaˈan, nggaˈan tǝ wanchaˈan.”<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />Kǝnan kalandǝ tandǝ Barabas ha. Kǝrsǝ ɗǝf tǝs kǝ thlǝfan fee Yesu Kǝristi, fǝrkan ndi kǝ kukwan fee ha.<verse eid="MAT 27:26" /></para>
  <para style="s">Masan fǝ yaanchǝ Yesu</para>
  <para style="r">(<ref loc="MRK 15:16-20">Mar 15:16-20</ref>; <ref loc="JHN 19:2-3">Yoh 19:2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />Chat ɗǝk fǝ yaanchi nggomna taˈan tǝ Yesu kǝ hur file wiri nggomna taˈan taurankǝ wumǝn fǝ yaanchaˈan ha nat. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />Kǝtang kandǝ ichi Yesu ha, pang kandǝ yowun kapat nga, kapata weˈtǝ yi kuturcha. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />Tahǝs kandǝ yowun lǝɓokǝr kuturakta tǝ tahcha, pang kandǝ kǝ inda. Ɗǝfan kandǝ fangngǝn kuturakta kǝ harsǝmˈyan, kop kandǝ ha pangngǝnan nggak kandǝ ndan ǝna tǝ njir fata. Nakandǝ ndat wa, “Kǝ mbar shishingndiyo kwitiri Yahudawecha.” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />Chǝhan kandǝ yahchǝ kafa, thlǝ kandǝ fangngǝnɗi nech harˈyan, thlǝ thla fang kandǝ fa ǝ inda. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />Kǝ tǝɓang kandǝ chen mee ha, chat kǝtang kandǝ kapaɗi ha nga fiyan yu, pang kandǝ kapechˈyan, chen kandǝ kesh kǝthlǝm kǝ ɗǝndǝ kukwandǝ ha.<verse eid="MAT 27:31" /></para>
  <para style="s">Kukwan fee Yesu ha</para>
  <para style="r">(<ref loc="MRK 15:21-32">Mar 15:21-32</ref>; <ref loc="LUK 23:26-43">Luk 23:26-43</ref>; <ref loc="JHN 19:17-27">Yoh 19:17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />Kǝ nakandǝ chet kesh, kǝm kandǝ tǝ yowun nǝfa thlǝ Sayirin, thla naa thlǝman wa Siman. Ɗǝf kandǝ anchǝs nwaat kǝ tǝrtǝ pallangndi Yesu. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />Saˈ kandǝ kǝmndi thlǝ ˈya fee wa Golgota, (thla thlǝ nda fee wa, mǝt al incha). <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />Fǝrang kandǝ ˈyam inabi thla wumandǝ fee tǝ ǝn ɗǝhɗǝh kǝthlǝm kǝ saa. Paɗ kǝ tǝkankan, kar kan sata. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />Kǝ kukwan kandǝ ha ɓǝra palangnda. Tarak kandǝ ɓǝra kapechˈyan kǝthlǝm kǝ nanda chika wun yen kapenǝ natǝn mbǝsta. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />Kǝrsǝ ndaˈan chat chokkandǝ ha minni nakandǝ pǝk ndǝ har. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />Keˈke ɗar indiyan fi palangnan chepkandǝ sǝɓtǝ ǝnɗi chǝtǝn ndat wa, “Thleya mǝthlan nech kǝ Yesu Kǝristi, Kwitiri Yahudawecha.” <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />Paɗ kukwan kǝ fee fǝ fasa fechǝ ha chap ɓukwa tǝ ndi, chǝka wuni ɗar palangndiyan, arta tǝ harsǝm ˈyan, arta tǝ kaku ˈyan. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />Nafchiɗi nech mbǝrtǝ ha nakandǝ mbuˈan ɓawa michǝ kafa, nakandǝ yiraˈandǝ incha. <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" />Nankandǝ ndat wa, “Chiɗi ndech wa no tutokandǝ Wiri Farta ha, paɗ kǝ tǝnen hur mǝndǝ mahkan, hǝraˈandǝn indiyo le. Maa chǝ Waˈi Farta, ɓo kah ɓǝra palangnan.”<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />Kǝɗu paɗ pakte pangngǝncha tǝ fǝ chaˈandǝ kusiˈ i Musa kaɗi tǝ paktechi Yahudawecha, fen paɗ nakandǝ chen mee ha. Nakandǝ ndat wa, <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“Ə hǝraˈantǝ fowun nafcha, wulan hǝraˈandǝ indiyan. Ngga mǝthlan nech kǝ kwitiri Israˈilawecha wa, kǝ ɓǝ kah ɓǝra palangnan nakanya, kǝthlǝm kǝ fǝr mǝn kit kǝ ndi. <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />Fǝr tǝ kit kǝ Farta. Suku kǝ ɓi Farta hǝraˈandǝ nakanya, maa ǝ yah Farta ndi, kǝthlǝm ndechan wa, mǝthlan nech kǝ Waˈi Farta.” <verse eid="MAT 27:43" /><verse number="44" style="v" sid="MAT 27:44" />Kǝɗu paɗ yaarchǝɗi kukwandǝ fee tandǝ ha ɓukwa yu, iˈyaran kandǝ fa, kǝɗ ǝnɗi chǝt fee yu.<verse eid="MAT 27:44" /></para>
  <para style="s">Mǝrti Yesu</para>
  <para style="r">(<ref loc="MRK 15:33-41">Mar 15:33-41</ref>; <ref loc="LUK 23:44-49">Luk 23:44-49</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />Thlaˈtǝ hur farta, nggǝlangkǝ wuthlǝ hahiˈyan kaɗ nat, kǝ wanshengnan mahkan yi farwita. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />Ə wanshengnan mahkan paɗ thlaˈan kǝ Yesu ɓǝrata tǝ alkǝta ndakan wa, “Eloi, Eloi, lama sabaktani?” thla naa saktaˈan wa, “Fartinchi, Fartinchi, kǝthlǝm mǝ mathlu nenchi ha?”<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />Kǝ sǝkkǝ fee nech kikit nduk minni yu kǝɗu ndaka nda wa, “Nafɗa mǝthlan ˈya thlǝ shenuˈtǝ tǝ yahti Farta Iliya.” <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />Chat kǝɗ thlǝ nakanya rakak yowun, tǝtnan kan wanɗǝ chapta tǝ ˈyamɗi nech ɓang ɓang, pakan kǝ fangnda kweˈkan ha kǝthlǝm kǝ sǝ Yesu. <verse eid="MAT 27:48" /><verse number="49" style="v" sid="MAT 27:49" />Paɗ ndak takichaˈan wa, “Mallaman kǝ namǝn, ndu naa Iliya ɓat hǝraˈanda.”<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />Chat nggǝrkǝ Yesu thlaˈandǝ ɓǝrata tǝ alkǝta, kǝnan kal shishingndiyan ha.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />Chat labule tǝɗi nech ǝ kuwurtǝɗi mii kǝtǝn chiɗchiɗ tǝ Wiri Farta tǝ mǝɗi mbǝranchǝ mǝɗi nech chiɗchiɗ ha. Thlah kan kaɗi chakkan ha kwalaran chap thlaˈtǝ fǝrtǝ kǝ kanan. Yiraˈkǝ hahǝ fa, fǝ fa lak ɗakwanchi kaɗi. <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />Inkǝ kwi mǝmatǝch ha, tertǝ chiɗ chiɗ tǝ nafchi Fartǝɗi nech huran, thlaˈan kǝ fee tandǝ ǝ mǝrta. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />Chekandǝ kesh ǝ kwa, Kǝrsǝ thlaˈti Yesu ǝ mǝrta, chat yimkandǝ kǝ mǝrǝɓɗi nech chiɗ chiɗ, pǝn kandǝ fat ˈyanda kǝmɗi nafchǝ terchan.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />Ə wanshengngǝnchǝˈini, kapa thlǝ yandǝ Roma tǝ takǝɗ fee nech tǝ ndi, nech pǝk mǝrti fati Yesu har. Kǝ nakandǝ rǝɓti hahǝ fa tǝ paɗ ǝnɗi sǝɓchǝ nat, lekǝkandǝ kaan. Ndakanda wa, “Kittaˈan, nafɗiya Waˈi Farta.”<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />Fowun nǝssis terchan fee parech Yesu thlaˈtǝ ǝ Galili tandǝ kǝsandǝsi. Thlarkandǝ ha langnga nakandǝ naa ǝnɗi nech sǝɓta. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />Hur nanda Maryamu thlaˈtǝ Magdala, tǝ Maryamu man Yakubu tǝ Yusufu, tǝ paɗ man wanchi Zabadi.<verse eid="MAT 27:56" /></para>
  <para style="s">Thlohan fee Yesu</para>
  <para style="r">(<ref loc="MRK 15:42-47">Mar 15:42-47</ref>; <ref loc="LUK 23:50-56">Luk 23:50-56</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />Kǝ chǝk farwita, chat yowun thlǝ kǝnawa, thlǝ Arimatiya, thla na thlǝman wa Yusufu ɓakan, mǝthlan paɗ kǝmsha i Yesu nakan. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />Ndǝkan kǝmɗi Bilatus shikan kǝ fǝran fee mǝrtǝ Yesu. Paɗ ndak Bilatus wa kǝ fǝran fee. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />Chat tǝrkǝ Yusufu mǝrtǝ fati Yesu fǝtankan kǝ hur yuwa kukwata thla nawaktǝ pat fiyan. <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />Ɗǝf kan mǝrtǝ faɗan kǝ hur yuwa kwa, thla chuhtǝn fi ɗe kwena. Patakan kapa ɗekwen kǝ mii kwiyan, pǝɗakan. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />Maryamu thlaˈtǝ Magdala, tǝ arti Maryamu tandǝ ɗas minni tandǝ naa kwiyan.<verse eid="MAT 27:61" /></para>
  <para style="s">Nafchiɗi pǝkchǝ kwiyan har</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />Əssanɗan, ǝ fartǝ yipta, chat ɗǝk paktǝ pangngǝncha tǝ Farisawecha kǝ pangngǝn Bilatus. <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" />Ndang kanda wa, “Kǝ mbar shishing, kuɗuk ǝn tǝ ǝnɗi nda thlǝ thlǝm nafchǝɗa peˈtǝn ha tǝ shishingnda. Waa kǝrsǝ mǝndǝ mahkan nan thlaˈtǝ tǝ shishingnda thlaˈtǝ ǝ mǝrta. <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />Kǝthlǝm ndaˈan ɗǝfusi kǝ pǝk fee kwiɗa har kaan kǝ far mahkanda. Kǝthlǝm kǝ ɗǝ kǝmsichiyan yarkandǝ mǝrtiyan wa, kǝ nda ndǝ nafcha wa ǝ thleˈi ǝ mǝrta wa. Lǝmǝnɗi ǝ ndukwaɗan ya nan mbǝrandǝ thla ha tǝrkwathl kanan.” <verse eid="MAT 27:64" /><verse number="65" style="v" sid="MAT 27:65" />Ndangkǝ Bilatus tanda wa, “Haram fǝ yaanchǝ har, kǝ ɗǝndǝ pǝk kwiyan har kaan kǝthlǝm kǝ tǝkan fee her fa wa. Kǝɗ ǝnɗi yahtǝ wun.” <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />Ɗǝkandǝ thlǝf wanɗǝ sǝndi kwitir kafi ɗakwanan, mǝni yowun tǝkan her fa wa, paɗ ɗǝf kandǝ fǝ pǝk ichi har kǝ pǝk ndǝ kwiyan har.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">Thlaˈti Yesu ǝ mǝmatecha</para>
  <para style="r">(<ref loc="MRK 16:1-8">Mar 16:1-8</ref>; <ref loc="LUK 24:1-12">Luk 24:1-12</ref>; <ref loc="JHN 20:1-10">Yoh 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />Kǝ tǝɓak fartǝ yipta. Walwurtǝ pung mǝt shimma ǝ tǝrkwathl far mǝn lǝmo Maryamu thlaˈtǝ Magdala tǝ arti Maryamu taˈan ɗǝkandǝ kǝ ɗǝmbandǝ kwiyan. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />Kǝnndǝ Maryamu thlaˈtǝ Magdala tǝ arti Maryamutaˈan ɗǝta tapi chǝ fee kapa yiraˈti hahǝ fa. Kǝthlǝm tǝɓǝ yowun thlǝ thlǝndi Chindǝ kaha thlaˈtǝ hulafǝrta, ɓakan patandǝ ɗakwanan kaɗ mii kwiyan, chokkan ǝ ɗaran. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />Fatˈyan chǝmndǝ fa kǝɗ withlwiˈta, kapechˈyan paɗ heɗǝɗa kaan kǝɗ warathlata. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />Kǝ nak fǝ pǝk kwiyan ndi lekǝkandǝ kaan nak fatˈyandǝ rǝɓtǝ fa, hǝmkandǝ ha kǝ haha kǝɗ mǝmatecha. <verse eid="MAT 28:4" /><verse number="5" style="v" sid="MAT 28:5" />Paɗ ndangkǝ thlǝ thlǝndi Fartǝɗi nǝssaˈan wa, “Mǝ lekuwun wa, sǝninchi wa tǝ nowun kaa Yesu thla kukwandǝ fee ha. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />Mǝthlan su wa, ǝ thleˈi, kǝɗ ǝnɗi mbuˈtǝn. Ɓam nam mǝɗi ɗǝf tǝ fee ndi. <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />Ɗam leɗ leɗ kǝ ndawun kǝmsichiyan tǝ ndat wa, ‘Ə thleˈi ǝ mǝrta. Paɗ nan lat mǝ kun kǝ Galili, ǝ minni natwun naa ndi.’ Tapi mbuˈowunchi.” <verse eid="MAT 28:7" /><verse number="8" style="v" sid="MAT 28:8" />Chat mal kǝ nǝssaˈan mii kwiyan ha leɗ leɗ. Tandǝ lekǝta, paɗ tǝ chiɗ chiɗ tǝ wanɗǝkaɗat kaan. Tandǝ ɗar rakat kǝ ɗǝndǝ mbuˈandǝ kǝmsichi Yesu hacha, <verse eid="MAT 28:8" /><verse number="9" style="v" sid="MAT 28:9" />chat Yesu tǝ indiyan kǝm kan tǝ tanda, ndangkan tanda wa, “Kǝɓi kǝmɗiyowun.” Mbǝha kandǝ nduk kǝs kandǝ sarchiyan har, manan kanda. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />Ndangkǝ Yesu tanda wa, “Mǝ lekǝwun wa. Ɗam ndamandǝn wanmanchina kǝ ɗǝndǝ kǝ Galili. Ə minni nat ndǝ naa nenchi.”<verse eid="MAT 28:10" /></para>
  <para style="s">Ənɗi mbuˈtǝ fǝ pǝk kwichaˈan har</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />Kǝ nak nessǝɗi ɗar wita, chat fowun hur fǝ pǝk kwiɗi har yu yim kandǝ kǝ hur mǝrɓan, fǝrang kandǝ pakktǝ pangngǝncha kusheˈtǝ ǝnɗi sǝɓchǝ nat. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />Chat ndikkǝ paktǝ pangngǝncha tǝ paktechi Yahudawecha, fǝran kandǝ fǝ yaanchaˈan wanɗǝɓithl kaan. <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />Ndangkandǝ tanda wa, “Nda ma ndǝn nafcha wa, ‘Kǝmsichiyan ɓech yarkandǝ mǝrtiyan wita wanshengngǝnɗi nat ǝn saˈena.’ <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />Maa saˈ kusheˈtaˈan kǝmɗi nggomna paɗ, naˈan inan mee paɗ, nowun yim kǝ hur ɓahtǝ ha wa.” <verse eid="MAT 28:14" /><verse number="15" style="v" sid="MAT 28:15" />Thlǝk fǝ pǝk ichaˈan wanɗǝɓithlan chǝkandǝ kǝɗ ǝnɗi mbuˈandǝ fee tanda kǝ chǝ nda. Tǝkǝɗu kusheˈtǝɗiya welha hur Yahudawecha kǝ ɓukiya.<verse eid="MAT 28:15" /></para>
  <para style="s">Tar ɗi fǝrandǝ Yesu kǝmsichiyan</para>
  <para style="r">(<ref loc="MRK 16:14-18">Mar 16:14-18</ref>; <ref loc="LUK 24:36-49">Luk 24:36-49</ref>; <ref loc="JHN 20:19-23">Yoh 20:19-23</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />Kǝrsǝ inini, chat kǝmsichiɗi kum nggǝrsǝ artǝ yu pǝɗa kandǝ kǝ Galili, ɗǝkandǝ kǝ kapa tinringǝnɗi nda ndǝ Yesu tanda wa kǝ kǝm nda. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />Kǝ nakandǝ ndi chat manan kanda, paɗ fowun ǝ hur nanda fǝr wandǝ kit wa Yesu wa. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />Chat ɓak Yesu nduk ndangkan tanda wa, “Fǝrichǝ fee nat alkǝtɗi nech ǝ hulafǝrta tǝ paɗ ǝ heshi. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" />Kǝthlǝm ndaˈan ɗama kǝmɗi nafchi heshi nat kǝ ɗǝfwun tandǝ kǝ chok ndǝ kǝ kǝmsichinchi. Kǝnowun chan tandǝ baptisma hur thlǝm Chinda, tǝ yi Wanan, tǝ yi Shemeti thla chiɗchiɗ. <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />Kǝ nowun chaˈanda tandǝ har, kǝthl nandǝ parat har tǝ ichiɗi mbuˈowundi nat. Nii nat tǝ wunchi weenmǝta kǝ ndukwa heshi.”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>