<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">MRK MRK Gaˈanda Mar Mark Markus</book>
  <para style="h">Maruku</para>
  <para style="toc3">Mar</para>
  <para style="toc2">Maruku</para>
  <para style="toc1">Kwastǝ ndikta tǝmɗi Maruku</para>
  <para style="mt1">Mar</para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">Ɓasi Yohanna thlǝ chǝt baptisma</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mat 3:1-12</ref>; <ref loc="LUK 3:1-9">Luk 3:1-9</ref>; <ref loc="LUK 15:17">15:17</ref>; <ref loc="JHN 1:19-28">Yoh 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />Thlǝya nech kǝ tǝrkwathl kan kusheˈ tǝ ndikta thla nech mbinchan yi sǝkta kǝ ɗar Yesu Kǝristi, Wa ˈi Farta. <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />Nggakchan, kǝɗ ǝnɗi yarandǝ fee ha hur Laulawati Ishaya, thlǝ shenuˈtǝ tǝ yahti Farta. Ndat wa,</para>
  <para style="q1" vid="MRK 1:2">“Nggǝta nii thlǝn thlǝ thlǝndinchi kǝ lǝ kǝ pangngǝn wa,</para>
  <para style="q2" vid="MRK 1:2">thla nech tahsandǝ mbandiyo kaɗi”<verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />“Ɓǝratǝ ˈya fata hur chennjeya, tǝ ndat wa,</para>
  <para style="q1" vid="MRK 1:3">‘Tahsaman mbandi Chindǝ kaɗi,</para>
  <para style="q2" vid="MRK 1:3">panaman ha kǝn ndellengnga kǝ wiˈsi.’”<verse eid="MRK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />Ɓak Yohanna thlǝ chǝt baptisma hur channjeya. Nakan mbuˈandǝ nafcha ndikti Farta, kǝ tǝrndǝ ha, kǝ malandǝ chǝt ɓǝɓifata, kǝ chan fee tandǝ baptisma, naa Farta kalanda ɓǝɓifechˈyandǝ ha. <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />Nafchǝ terchan hahi Yahudiya tǝ nat nafchi Urshelima, ɓakandǝ kǝmɗi Yohanna. Nakandǝ mbuˈ ɓǝɓifechˈyanda, mǝthlan paɗ chan kan baptisma tanda ǝ kufi Urdun.<verse eid="MRK 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6" />Kapaɗi paa Yohanna, tahǝschi fee tǝ weshi nggelupa, paɗ kǝntǝ fiya ǝ filˈya. ɗǝsǝmndiyan mbeɗecha tǝ ˈyam ɗeya hur channjeya. <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />Ɓas kan, ndakan wa, “Nefsi nech ɓata kǝrsǝ na, thla pǝɗichǝ ha tǝ alkǝta, chǝka sahtǝ pahamchiyan chaˈawisi kǝ kwasani ha wa. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />Nggǝta chowunchi baptisma tǝ ema, paɗ mǝthlan nechan chowun baptisma tǝ Shemeti Farta.”<verse eid="MRK 1:8" /></para>
  <para style="s">Chan fee Yesu baptisma</para>
  <para style="r">(<ref loc="MAT 3:13-17">Mat 3:13-17</ref>; <ref loc="LUK 3:21-22">Luk 3:21-22</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />Ə wanminchiˈini ɓak Yesu kǝ thle mirɓi Nazarat ǝ hahi Galili. Chan kǝ Yohanna baptisma ǝ kufi Urdun. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />Kǝ nak Yesu ɓat kesh hur ˈyaman, chat kǝɗuyu nakan in hulafǝrtǝ ha, ɓak Shemeti Farta kah kǝ indiyan kǝɗ kunggurha. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />Sǝkkandǝ ɓǝrata ǝ hulafǝrta ndat wa, “Chi nech kǝ waˈinchi, yahinchi wechi, nggǝt mbenfat kǝ wech kaan.”<verse eid="MRK 1:11" /></para>
  <para style="s">Kaɗan Hweˈrǝ Yesu</para>
  <para style="r">(<ref loc="MAT 4:1-11">Mat 4:1-11</ref>; <ref loc="LUK 4:1-13">Luk 4:1-13</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />Chat kǝɗuyu, pǝkkǝ Shemeti Farta ndi kǝ hur channjeya. <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />Mǝthlan hur chanjangngan mǝndǝ kum chǝt foɗɗa, nak Hweˈra kaɗanda. Nechan ɓukwa tǝ wanɗiyahcha, ɓak fǝ thlinchi Farta kǝsandǝ si.<verse eid="MRK 1:13" /></para>
  <para style="s">Tǝrkwathl kan teri Yesu ǝ Galili</para>
  <para style="r">(<ref loc="MAT 4:12-17">Mat 4:12-17</ref>; <ref loc="LUK 4:14-15">Luk 4:14-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />Kǝrsǝ mǝk Yohanna thlǝ chǝt baptisma kǝ pursuna. Pǝɗak Yesu kǝ hahi Galili, nakan ɓas kwastǝ ndikta thla mbinchan yi Farta. <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />Ndakan wa, “Wanshengnan ǝ ndiiɗ ha, kuturakti Farta ɓi nduk. Tǝramha paɗ kǝ fǝrwun kit kǝ kwastǝ ndiktiɗiya yi Farta.”<verse eid="MRK 1:15" /></para>
  <para style="s">ˈYi Yesu fǝ tǝm yirǝfchǝ foɗɗa</para>
  <para style="r">(<ref loc="MAT 4:18-22">Mat 4:18-22</ref>; <ref loc="LUK 5:1-11">Luk 5:1-11</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />Kǝ nak Yesu mbǝrtǝ ha kǝlaar hawurti Galili, nakan Siman tǝ wanmanan Andrawus tandǝ cham mapechˈyandǝ hur kapa kufiˈyan, kǝthlǝm terˈyanda tǝm yirifcha. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />Ndang kǝ Yesu tanda wa, “Ɓama param nenchi, nakanya nafchi natwun naa kaɓta kǝmɗinchi.” <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />Chat kǝɗuyu malkandǝ mapechˈyanda ha parakandǝ Yesu.<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />Kǝ ɗǝkan kǝ pang ngguɗyeh, nakan Yakubu tǝ wanmanan Yohanna wanchi Zabadi hur kombawal, tandǝ tahsaandǝ mapech ˈyanda. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />Chat, ˈyakan tanda, paɗ malkandǝ chin nanda ha Zabadi hur kombawal taˈan tǝ takǝt fǝ tarchiyanda Parakandǝ Yesu.<verse eid="MRK 1:20" /></para>
  <para style="s">Rǝkan Yesu ɓǝɓi shemeta fi yowuna</para>
  <para style="r">(<ref loc="LUK 4:31-37">Luk 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />Pǝɗakandǝ kǝ Kafarnahum, ǝ fartǝ yipti Yahudawecha. Pǝɗak Yesu kǝ wur nggomndi Yahudawecha nakan chaˈandǝ kaɗi. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />Nafchaˈan sakandak inda tǝ chaˈaɗan ˈyan. Kǝthlǝm chaˈanchan tandǝ har kǝɗ thla tǝ alkǝtfa, ngga kǝɗ fǝ chaˈandǝ kusiˈ chaˈan kaɗ wa.<verse eid="MRK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23" />Chat kǝɗuyu nefsi hur wur nggomnan ˈyanda thla naa ɓǝɓi shemet fiyan, thlaˈan kan ɓǝrata tǝ hwata, <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />ndangkan wa, “Mǝ kǝmuchǝ tǝ nggaˈan, Yesu thlǝ Nazarata? Tǝ ɓen kǝ tǝkaˈandǝ ha wa? Nggǝta sǝninchi ndu wun nako thla Chiɗ Chiɗ i Farta.”<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />Yanan kǝ Yesu ha tǝ alkǝta, ndang kan wa, “Nggasu ɓaˈ, cho kesh fiyan.”<verse eid="MRK 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26" />Chat kǝɗuyu, pongngǝn hwaˈran thlǝf kan ndǝ ha, nak fatˈyan saktat fa, hwakan, chekan kesh fi nafan. <verse eid="MRK 1:26" /><verse number="27" style="v" sid="MRK 1:27" />Nat nafchaˈan sakandak inda, chǝhan kandǝ raˈan tǝ ndat wa, “Thleya weˈtǝ mǝ kǝɗaya? Yuwa chaˈata paɗ tǝ alkǝtfa. Thlǝ nechan yanandǝ ɓǝɓi hwaˈarchǝ ha kǝ nandǝ sǝk anchi paɗ.”<verse eid="MRK 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28" />Kusheˈtaˈan chat kǝɗuyu welha nat chǝktǝ yeni hur hahi Galili.<verse eid="MRK 1:28" /></para>
  <para style="s">Kǝnan Yesu man nu Biturus kaɗi</para>
  <para style="r">(<ref loc="MAT 8:14-15">Mat 8:14-15</ref>; <ref loc="LUK 4:38-39">Luk 4:38-39</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />Kǝ chekandǝ kesh ǝ wur nggomndi Yahudawechaˈan, pǝɗak Yesu, tǝ Yakubu, tǝ Yohanna kyeuri ndǝ Siman, tǝ Andrawus. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />Thlaɓǝrtǝ Siman kǝ nunefa ɗuk haɗchan tǝ hatǝfa ɓǝɓa, paɗ chat mbuˈan kǝ nafchǝ Yesu hatǝfaɗan ˈyan. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />Kǝɗu ɗǝk Yesu kǝ mbǝs ndi, kǝskan herˈyan, thlaˈan kan. Hatǝfa ɓǝɓiˈan kal kan anchi ha, thlaˈkǝ nunafan tahsankan tandǝ ɗǝsemndǝsi.<verse eid="MRK 1:31" /></para>
  <para style="s">Kǝnan Yesu nafchi kaɗ terchan</para>
  <para style="r">(<ref loc="MAT 8:16-17">Mat 8:16-17</ref>; <ref loc="LUK 4:40-41">Luk 4:40-41</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />Farwitaˈan nduk tǝ hǝmndi Farta, ɓak nafcha tǝ fee nat nech haɗchan paɗ tǝ fee tǝ hwaˈarchǝ fiyanda kǝmɗi Yesu. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />Nafchi hahiˈyan terchan nggomkandǝ kǝ mii wuran. <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />Kǝnankǝ Yesu nafchǝ kaɗ tǝrchan fee nech tǝ hatǝfech fǝ samǝn samǝn. Mǝthlan paɗ rǝkan kan tertǝ hwaˈarchǝ kesh fi nafcha. Nggǝma wa hwaˈarchaˈan kǝ ndik nda wa, kǝthlǝm sǝnda ndu wun nakan.<verse eid="MRK 1:34" /></para>
  <para style="s">Shi Yesu mǝɗi nawaktǝ nafchisi</para>
  <para style="r">(<ref loc="LUK 4:42-44">Luk 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />Ə kataa mǝta, kǝ peˈkǝ mǝt shim shim, thlaˈkǝ Yesu, malkan wuran ha pǝɗakan kǝ mǝɗi nawak tǝ nefsi, minni shitǝn. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />Siman tǝ fee natndǝ mǝt arta, pǝɗa kandǝ kaa ndi. <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />Paɗ kǝ mbǝsan kanda, ndang ka nda wa, “Nat nafcha tandǝ kawechi.”<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />Nggǝrankǝ Yesu tandǝs wa, “Tamǝ kǝ mǝchi sam samǝn fee nech ɗuk ɗuk kǝthlǝm kǝ ɓasi ǝ minni paɗ. Kǝthlǝm ndaˈan nech kǝ saktǝ ɓatinchi.” <verse eid="MRK 1:38" /><verse number="39" style="v" sid="MRK 1:39" />Kǝɗu wiˈyan kan nat hahi Galili, nakan ɓaasa hur kǝtǝn nggomǝnchi yanda paɗ nakan rǝkandǝ hwaˈarchǝ kesh fi nafcha.<verse eid="MRK 1:39" /></para>
  <para style="s">Kǝnan Yesu nef kaɗi thla naa tarkwai fiyan</para>
  <para style="r">(<ref loc="MAT 8:1-4">Mat 8:1-4</ref>; <ref loc="LUK 5:12-16">Luk 5:12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />Ɓak yowun nefa, tǝ tarkwai fa kǝmɗiyan kopkan ha, paɗ shiyan kan Yesu ndakan wa, “Maa ǝ yahǝnsi, alkǝt ˈyosi no mbahan kǝnitǝ kaɗi.”<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />Kǝ haɗan kǝ nafɗiya Yesu fa, panan kan her ha tǝkan kan her nafan fa. “Nggǝmani, kǝnu kaɗi.” <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />Chat kǝɗuyu malkǝ tarkwaiˈyan ndǝ ha, kǝn kan kaɗi.<verse eid="MRK 1:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 1:43" />Chat tǝɗankǝ Yesu thlǝmatˈyan tǝ alkǝta ndangkan wa, ɗu kaɗi, <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />“Kǝ sǝninsi, kǝ mbuˈeen nef ǝnɗi chutǝ Farta wa. Ɗu, pǝneen fatˈyo thla thlǝ fǝranchi Farta icha, fǝrko pafǝn kǝmɗi Farta yi kǝndǝ kaɗi, kǝɗ ǝnɗi mbuˈtǝ Musa hur kusiˈ taˈan, kǝthlǝm kǝ pǝn wa kinin kaɗi.”<verse eid="MRK 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45" />Chǝka kǝɗu, kǝ chek nafan kesh nggas wa ɓaˈ wa, nakan mbuˈ ǝnɗi chandǝ Yesu hayang. Kǝthlǝm ndaˈan, mbahǝn wu Yesu nggǝr yimndǝ kǝ hur mirɓa hayang wa. Chokkan mǝchiɗi nggawaktǝ nafchisi. Kǝɗu nak, nafchǝ terchan ɓat kǝmɗiyan thlaˈtǝ michi samǝn samǝn chǝka tǝ yeni.<verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">Kǝnan Yesu nef kaɗ saa fatˈyan kaɗi</para>
  <para style="r">(<ref loc="MAT 9:1-8">Mat 9:1-8</ref>; <ref loc="LUK 5:17-26">Luk 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />Kǝrsǝ wan mǝnchaˈan top kǝɗa, fartǝɗi nggǝr tǝ Yesu yim ndǝ kǝ wan mǝrɓi Kafarnahum, sǝk kǝ nafchǝ wa ɓi kaɗ kyeuri. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />Kǝthlǝm ndaˈan, nggom kǝ nafchǝ terchan, takwu mǝssǝ wa, chǝka ǝ mikǝtǝnan, paɗ ɓassan kǝ Yesu kwastǝ ndiktǝ tandǝs minni. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />Tandǝ minni, tǝrkǝ nafchi foɗɗa nefa thla saa fatˈyan kaɗi, ɓakandǝ taˈanchi kǝmɗi Yesu. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />Mbǝs wandǝ mbanda kǝ saˈndǝ kǝmɗi Yesu wa, kǝthlǝm terti nafcha. Terkandǝ kǝ ɗar kǝtǝn ɗi naa Yesu huran tǝ nafan, chuhwankandǝ ɗar kǝtǝnan keˈke tǝmɗi naa Yesu, kǝ nandǝ fǝr nafɗi saa fatˈyan kaɗ yu kaha tǝ mǝt hunatˈyan kǝ pangngǝn Yesu. <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />Kǝ nak Yesu fǝr kit ˈyanda, ndang kan nafɗa safatˈyan kaɗ wa, “Waˈinchi, kaluchǝ fee ɓǝɓifechˈyo ha.”<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />Fartiˈini fowun fǝ chaˈandǝ kusiˈ chǝsi ɗas ɗas, nakandǝ kaɗandǝ ha hur wanɗǝkaɗechˈyanda. <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />“Mǝ chicha naa nafɗa mbuˈtǝ kǝɗuyu? Tǝr tǝ indiyan kǝɗ Farta. Wun naa alkǝt kal ɓǝɓifechˈyan sǝ ha kǝɗu maangga Farta ndak wa?”<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />Chat kǝɗuyu Yesu shin ǝ hur Shemetˈyan ǝnɗi nat ndǝ sakta hur wandǝkaɗech ˈyanda, chat ndang kan tanda wa, “Mǝ chicha natwun kaɗa ichiɗiya hur wanɗǝkaɗechˈyowun? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />Yen nech paˈpa, kǝ ndang fee thla saa fatˈyan kaɗ wa, ‘Kaluchife ɓǝɓifechˈyo ha wa’, ndu ndat wa ‘Thlaˈu, tǝru wenichiyo, wiˈu wa’? <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />Kǝthlǝm yahchisi kǝ sǝnwun wa nggǝta, Waˈi Nefa, alkǝtˈyansi hur heshiɗiya kǝ kaltǝ ɓǝɓifech ha.” Ndangkan thla saa fatˈyan kaɗyu wa, <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />“Nduchi wa, thlaˈu, tǝru wenichiyo kǝ pǝɗen kaɗi.”<verse eid="MRK 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12" />Thlaˈkǝ nafɗi saa fatˈyan kaɗ chat kǝɗuyu tǝrkan wenichiyan, chekan kesh pangngǝn nanda nakandǝ ɗǝpaanda. Nat nda sakandak inda, manan kandǝ Farta, nakandǝ ndat wa, “Tamwaˈan naa weˈtǝ ǝnɗa wa.”<verse eid="MRK 2:12" /></para>
  <para style="s">ˈYi Yesu, Lawi</para>
  <para style="r">(<ref loc="MAT 9:9-13">Mat 9:9-13</ref>; <ref loc="LUK 5:27-32">Luk 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />Nggǝr kǝ Yesu chet kesh kǝ mii kufa. Tertǝ nggomnda ɓakandǝ kǝmɗiyan, paɗ nggak kan chaˈandat har. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />Nakan mbǝrtǝ ha mii kufiˈan, nakan Lawi waˈi Alfiyus ɗas kǝtǝn thlǝt chamnda. Ndang kan wa, “Paro nenchi,” Thlaˈkǝ Lawi, paɗ parakan ndi.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />Nak Yesu sǝm ɗǝsǝmnda wiri Lawi, terchan fǝ thlǝt chamincha tǝ fowun fen paɗ fǝ ɓǝɓifecha tandǝ sǝm ɗǝsǝmnda tǝ ndi tǝ kǝmsichiyan. Kǝthlǝm weˈtǝ nafchǝ terchan parech ndi. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />Fǝ chaˈandǝ Kusiˈ i Musa kaɗi, fee nech kǝ Farisiyawecha, nakandǝ ndi sǝm ɗǝsemndǝ tǝ fǝ ɓǝɓifecha paɗ tǝ fowun fǝ thlǝt chamincha. Chǝhan kandǝ kǝmsichiyan wa, “Kǝthlǝm mǝ natǝn sem ǝna tǝ fǝ thlǝt chamincha, tǝ fee paɗ nech kǝ fǝ ɓǝɓifecha?”<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />Kǝ sǝk kǝ Yesu kǝɗu, ndangkan tanda wa, “Fee nech has has kǝmawu ǝn tanda tǝ thlǝ fǝr wanɓǝɓa wa, fee nech haɗchan ndak. Ɓawi kǝthlǝm fee nech kǝ kaa nafcha wa, ɓechi kǝthlǝm fǝ ɓǝɓifecha.”<verse eid="MRK 2:17" /></para>
  <para style="s">Chǝha mee kǝ ɗar kǝr kuchimnda</para>
  <para style="r">(<ref loc="MAT 9:14-17">Mat 9:14-17</ref>; <ref loc="LUK 5:33-39">Luk 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />Kǝmsichi Yohanna thlǝ chǝt baptisma tǝ kǝmsichi Farisiyawecha thlǝ kǝrcha ndǝ kuchimnda. Ɓak fowun nafcha chǝhan mee Yesu, “Kǝthlǝm mǝ thlǝ kǝrwaktǝ kǝmsichiyo kuchimnda, kǝɗ thla thlǝ kǝrtǝ kǝmsichi Yohanna thlǝ chǝt Baptisma, tǝ kǝmsichi Farisiyawecha?”<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />Nggǝrangkǝ Yesu tandǝs wa, “Shikechi chima pera nandǝ kǝr kuchimnda ma chima periˈan tǝ tanda wa? Maa tana, peˈ chǝma periˈan tǝ tanda nggandǝ kǝr kuchimnda wa. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />Wanshengnan ɓata, thla naa fee tǝrandǝ chima peraˈan, fartǝ ini natndǝ kǝr kuchimnda.<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />“Nefsi nech mbumandǝ ɗohtǝ kapata tǝ yuwaɗan wa. Machi kǝɗu naa yuwaɗan taˈan thlahandǝ ɗohtaˈan kaɗi, naa thlah taˈan mbǝrandǝ thla ha tang tang. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />Nefsi nech thlǝr yuwa ˈyam yangga kǝ hur ɗohtǝ kuruɓtǝ fiya wa. Kǝthlǝm maa chikǝɗu, ˈyam yanggiˈan, nan fohandǝ kuruɓtǝ fiyan kaɗi. Nat ˈyam yanggiˈyan tǝ kuruɓtǝ fiyan nandǝ sǝɓ tǝ kaɗi. Tǝ kǝɗu thlǝ thlǝrchi fee yuwa ˈyam yangga kǝ hur yuwa kuruɓtǝ fiya.”<verse eid="MRK 2:22" /></para>
  <para style="s">Chǝha mee kǝ ɗar fartǝ yipta</para>
  <para style="r">(<ref loc="MAT 12:1-8">Mat 12:1-8</ref>; <ref loc="LUK 6:1-5">Luk 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />Fartǝ thleya yi yipta, nak Yesu wiˈta para kan tǝ hur hǝngga pǝkata tǝ kǝmsichiyan. Nak kǝmsichiyan ɓerǝt sanggǝmǝn pǝkaɗan har ɗar wiˈta nakandǝ kangnda. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />Ndangkǝ Farisiwechaˈan Yesu wa, “Noo, kǝthlǝm mǝ naa kǝmsichiyo chǝt tera fartǝ yipta?”<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />Nggǝrang kǝ Yesu tandǝs wa, “Changgawowun ǝnɗi chǝt Dauda wa, fartǝ ini naa mitǝfiyan tǝ takǝt shikechǝ wiˈtǝyan wa? <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />Yimkan kǝ Wiri Farta, fartǝɗi naa Abiyatha, kǝ kappa thla thlǝ fǝranchi Farta icha. Tǝrkan johuma, thla ɗǝftǝ fee ha, thla kǝmwakchisi chǝka wuni kǝ kangnga, yi fee thlǝ fǝranchi Farta icha ndak. Kangkan tǝ shikechǝ wiˈtǝyan.”<verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />Ndangkǝ Yesu Farisawechaˈan wa, “Tahǝschǝ fee fartǝ yipta kǝthlǝm nafcha, tahǝswu fee nafcha kǝthlǝm fartǝ yipta wa. <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />Kǝthlǝm ndaˈan ngǝt Waˈi Nefa nech kǝ Chinda paɗ tǝ yi fartǝ yipta.”<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">Kǝnan Yesu nef thla saa herˈyan kaɗ ǝ Kafarnahum</para>
  <para style="r">(<ref loc="MAT 12:9-14">Mat 12:9-14</ref>; <ref loc="LUK 6:6-11">Luk 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />Fartǝ yowun paɗ, Yesu pǝɗakan kǝ wur nggomndi Yahudawecha. Paɗ ǝ minni nefsi thla saa herˈyan kaɗi. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />Fowun nafchaˈan hur nanda kaa mbanɗi natndǝ mbǝsaandǝ Yesu tǝ ǝnfa, kǝthlǝm ndaˈan nakandǝ fiingan wenita, kǝ nanda maa nan kǝnandǝ nafan kaɗi fartǝ yiptaˈan. <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />Ndangkǝ Yesu thla sa herˈyan kaɗ yu wa, “Thlaˈu, ɓo kesh kǝ thlerin ha pangngǝn chǝka wuni.”<verse eid="MRK 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 3:4" />Kǝn Yesu chǝha ndata, “Mǝ kǝmchisi kǝ chǝ fee fartǝ yipta? Kǝ chǝ fee kaafata a wa, ndu ɓǝɓifata wa? Kǝ hǝraˈan fee shishingnda wa, ndu kǝ ɓǝl fee fata wa?” Paɗ nggas kandǝ kǝmma.<verse eid="MRK 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 3:5" />Tǝɓǝr kan ha tǝ sǝɓtǝ hwira, nakan haɗ ndǝ hur, kǝthlǝm kwaˈkwa tǝ wandǝkaɗǝchˈyanda. Ndangkan nafan wa, “Panan herˈyo ha.” Panan kan ha, chat kǝnkǝ haran kaɗi. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />Chat, Farisiwechaˈan kǝna kandǝ ǝnɗi sǝɓcha chekandǝ kesh. Nggak kandǝ tahsandǝ ha, tǝ fee thlǝ kǝnanchi fili Hiridus, kǝ ɗar mbanɗi nandǝ ɓǝlandǝ Yesu.<verse eid="MRK 3:6" /></para>
  <para style="s">Pari tertǝ nafchǝ Yesu</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />Nggǝrangkǝ Yesu in tǝ kǝmsichiyan kǝ mii kufi Galili. Nafchǝ terchan ɓakandǝ kǝmɗiyan thlaˈtǝ hahi Galili parakandǝ ndi. <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />Tǝ nafchi hahi Yahudiya, tǝ Urshelima, tǝ Idumiya. Tǝ wan mǝrǝɓcha kǝrsǝ kufi Urdun, tǝ Taya, tǝ Sidon, terchan ndǝ nggomcha kǝthlǝm sǝkndǝ ǝnɗi nat thlǝ chǝtǝn.<verse eid="MRK 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 3:9" />Kǝthlǝm tertǝ nafchiɗi nech minni, ndangkǝ Yesu kǝmsichiyan wa, kǝ tahsandǝ mǝtsi hur kwombawal, kǝthlǝm tertǝ nafchiɗi nech njekǝthl ndi. <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />Chichan kǝɗu kǝthlǝm tapi kǝnantǝ nafchǝ kaɗ terchan, ndaˈan chicha fee tǝ hatǝfech fa tandǝ ɓat nduk tǝ ndi, kǝthlǝm kǝ tǝkandǝ her fa. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />Ɓǝɓi hwaˈarchǝ paɗ, maa ni ndǝ ndi nakandǝ hǝmndǝ ha ǝ pangngǝnan nakandǝ hwata tǝ ndat wa, “Chǝ nech kǝ Waˈi Farta.” <verse eid="MRK 3:11" /><verse number="12" style="v" sid="MRK 3:12" />Paɗ, tǝɗan kan thlǝmechˈyanda tǝ alkǝta, ndat wa, kǝ mbuˈ ndǝ wa, ndu wun nakan wa.<verse eid="MRK 3:12" /></para>
  <para style="s">Taɗ Yesu kǝmsichiyan kum nggǝrsǝ chap</para>
  <para style="r">(<ref loc="MAT 10:1-4">Mat 10:1-4</ref>; <ref loc="LUK 6:12-16">Luk 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />Tǝrkǝ Yesu kǝ ɗar nggwella, ˈyakan fee yahtǝn, ɓakandǝ kǝmɗiyan. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />Taɗ kǝ Yesu kum nggǝrsǝ chap hur nanda, kǝthlǝm kǝ chok ndǝ kǝ fǝ thlǝncha. Kǝ wiˈndǝ rǝmma tǝ ndi, kǝ chaˈandǝ mǝɗˈyan, kǝ thlǝntǝ tandǝ paɗ kǝ mbuˈandǝ nafcha ndikti Farta. <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />Tǝ paɗ fǝrandech alkǝt chendǝ hwaˈarchi kesh fii nafcha. <verse eid="MRK 3:15" /><verse number="16" style="v" sid="MRK 3:16" />Fee kum nggǝrsǝ chaptaˈan tatǝn ya,</para>
  <para style="b" vid="MRK 3:16" />
  <para style="li" vid="MRK 3:16">ɗǝfankan Siman wa, Biturus.<verse eid="MRK 3:16" /></para>
  <para style="li">
    <verse number="17" style="v" sid="MRK 3:17" />Yakub waˈi Zabadi, tǝ Yohanna wanman Yakub, ɗǝfankan tanda wa Buwarnarjis, ndaˈan nech kǝ wanchi yaan era.<verse eid="MRK 3:17" /></para>
  <para style="li">
    <verse number="18" style="v" sid="MRK 3:18" />tǝ Andrawus,</para>
  <para style="li" vid="MRK 3:18">tǝ Filibus,</para>
  <para style="li" vid="MRK 3:18">tǝ Bartalamawus,</para>
  <para style="li" vid="MRK 3:18">tǝ Matta,</para>
  <para style="li" vid="MRK 3:18">tǝ Toma,</para>
  <para style="li" vid="MRK 3:18">tǝ Yakub wa ˈi Halfa,</para>
  <para style="li" vid="MRK 3:18">tǝ Taddawus,</para>
  <para style="li" vid="MRK 3:18">tǝ Siman, thlǝ Kanˈanata,<verse eid="MRK 3:18" /></para>
  <para style="li">
    <verse number="19" style="v" sid="MRK 3:19" />tǝ Yahuda Iskariyoti, thla hiyanchǝ kaɗi.<verse eid="MRK 3:19" /></para>
  <para style="s">Yesu tǝ kutur hwaˈarcha, Mbaalzabul</para>
  <para style="r">(<ref loc="MAT 12:22-32">Mat 12:22-32</ref>; <ref loc="LUK 11:14-23">Luk 11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />Kǝrsǝ ndaˈan, yim kǝ Yesu kǝ yowun wira, paɗ nggom kǝ nafchǝ terchan, kǝthlǝm tertǝ nafcha mǝthlan tǝ kǝmsichiyan mbǝswandǝ kǝ sǝmndǝ ǝna wa. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />Kǝ sǝk kǝ wanmanchaˈan ichiɗi sǝbcha, ɗǝkandǝ wa nandǝ kǝsanda, kǝthlǝm fee ndat wa, “Tirkafǝrta.”<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />Fǝ chaˈndǝ kusiˈ i Musa kaɗi fee ɓech Urshelima, nda kanda wa, “Mbaalzabul nech fiyan, paɗaa, tǝ alkǝti kutur hwaˈarcha thlǝ kǝtandǝn hwaˈarchi kesh.”<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />Tǝ kǝɗu ˈyak Yesu nafchaˈan kǝmɗiyan, mbuˈan kan tanda saktaˈan ɗar chaˈata, ndat wa, “Nech Hweˈra mbahǝn kǝtan ndǝ hweˈrǝ kesh wa kǝni?” <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />Maa ǝ chak kuturaktǝ ha kwalaran chap, nech kuturaktaˈan mbahǝn thlartǝ ha wa kǝni? <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />Paɗaa, maa chak wir ha kwalaran chap, nech wuran mbahǝn thlartǝ ha wa kǝni? <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />Tǝ kǝɗu, maa thlaˈan Hweˈrǝ indiyan fa kǝ chak ha chap, alkǝtˈyansi kǝ thlar ha wa, ɓi hǝmdiyan ha. <verse eid="MRK 3:26" /><verse number="27" style="v" sid="MRK 3:27" />“Nefsi chaˈchǝs kǝ yim kǝ wiri nefa, thla nech kwaˈkwa kǝ haranchi ichiyan wa. Maangga tǝ kǝnantǝ nef ini ha kwaɗǝn wa, kǝnan mbahǝn harandǝ ichiɗi nech hur wuran wa.<verse eid="MRK 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28" />“Kittaˈan nati mbuˈowunda, naa fee kalandǝ nafchǝ ɓǝɓifaɗi ha chǝt ndǝ nat, tǝ njir Farta hur heshiɗiya. <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />Paɗaa, nat thla ndikchǝ njir fata kǝ Shemeti Farta, nggǝ fee tam kalanchi ha wa, kǝ kweˈkǝchi.” <note caller="*" style="x"><char style="xo" closed="false">3:29 </char><char style="xt" closed="false"><ref loc="LUK 12:10">Luk 12:10</ref></char></note> <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />Ndikchǝ Yesu kǝɗuyu, kǝthlǝm ndi nafchaˈan wa, “Ɓǝɓi hwaˈarchǝ fiyan.”<verse eid="MRK 3:30" /></para>
  <para style="s">Man Yesu tǝ wanmanchaˈan</para>
  <para style="r">(<ref loc="MAT 12:46-50">Mat 12:46-50</ref>; <ref loc="LUK 8:19-21">Luk 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />Tandǝ minni, ɓak man Yesu, tǝ wanmanchaˈan saˈkanda, thlarkandǝ ha heshi. Thlǝn kandǝ wa kǝ ˈyan fee tandǝ Yesu. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />Nafchǝ terchan taurandǝ ha ɗǝɗas sǝk chaˈatˈyan, ndangkanda wa, “Wanmanchuwa tǝ mu tandǝ kaa wech heshi.”<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />Nggǝrangkan tandǝs wa, “Wun nech kǝ yaa, paɗ micha nech kǝ wanmanchina?” <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />Tǝɓǝr kǝ Yesu ha, ɗǝpang kan nafchiɗi nech thlǝmaɗan, ndakana, “Ə yaa ya, tǝ wanmanchin ya. <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />Kǝthlǝm nat thla nech thlǝnandǝ ǝnɗi yah tǝ Farta, mǝthlan nech kǝ wanmana, kǝ hǝsnefa, tǝ nunefa, tǝ yaa.”<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">Saktaˈan kǝ ɗar thlǝ chehta</para>
  <para style="r">(<ref loc="MAT 13:1-9">Mat 13:1-9</ref>; <ref loc="LUK 8:4-8">Luk 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />Fartǝ thleya, nggak kǝ Yesu chaˈandǝ nafchi har ǝ mii kufi Galili. Nggom kǝ nafchi terchan tauran kandǝ ha. Kǝthlǝm ndaˈan yimkan kǝ hur kwombawal chok kan ha ǝ huran. Nat nafchaˈan paɗ nakandǝ kikit mii kufiˈan. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />Chaˈan kan ichi tandǝ har terchan tǝ sakchaˈan. Hur chaˈaɗan ˈyan ndangkan tanda wa, <verse eid="MRK 4:2" /><verse number="3" style="v" sid="MRK 4:3" />“Kam thlǝmat ha, yowun thlǝ huɗatsi pǝɗakan weˈya weˈta ǝ hǝnggǝyan. <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />Nakan weˈya weˈtiɗi, fowun weˈtaˈan hǝhatakandǝ ka ha kǝ hur mbanda, ɓak ɗǝngcha paɗ chehan kanda. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />Fowun hǝhatechandǝ kǝ hǝrang fera, mǝɗi nggowaktǝ fǝrtǝs kaˈan. Chat tif kanda leɗ leɗ kǝthlǝm fǝrtaˈan minni hwengngǝ kaan wa. <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />Paɗaa kǝ tǝk kǝ fartǝ ha hwar kandǝ kaɗi kǝthlǝm thlaarchiyandǝs kaan wa. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />Fowun weˈtaˈan hǝhatakandǝ kǝ hur tahcha, tifkan. Mangkǝ tahchaˈan paɗ njipangkan, chiwandǝ wancha wa. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />Fowun weˈtaˈan paɗ hǝhatakandǝ kah kǝ hahǝ thla nech ndiˈchan. Mankanda, pakandǝ wakaf kum chǝt mahkan, fowun, kum chǝt michˈcha, fowun, paɗ kum chǝt kum.”<verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />Ndak Yesu wa, “Nat thla naa thlǝma sǝktiyansi, sǝkkan.”<verse eid="MRK 4:9" /></para>
  <para style="s">Ənɗi chicha thlǝ ndiktǝ Yesu tǝ saktaˈan</para>
  <para style="r">(<ref loc="MAT 13:10-17">Mat 13:10-17</ref>; <ref loc="LUK 8:9-10">Luk 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />Fartǝɗi naa Yesu ichiɗan, kǝmsichiyan kum nggǝrsǝ chap, tǝ fowun nafchǝɗi sǝkchǝ ǝnɗi mbuˈtǝn, chǝhan kandǝ mee kǝ ɗar saktǝ ǝnɗi mbuˈtǝn. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />Ndangkan tanda wa,</para>
  <para style="p" vid="MRK 4:11">“Ngguwun nggǝmowunchi fee si kǝ sǝnwun ǝnɗi nech ǝ wuɓta ǝ maandi Kuturakti Farta, paɗ tǝ kǝɗu nafchiɗi nawakchǝ hurwun, chǝka mǝ naa fee mbuˈandata, tǝ saktaˈan ndak. <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />Kǝthlǝm,</para>
  <para style="b" vid="MRK 4:12" />
  <para style="q1" vid="MRK 4:12">“ ‘Nat tǝ wenita, nandǝ nata, paɗaa nggandǝ naa wa,</para>
  <para style="q2" vid="MRK 4:12">Sǝkta tǝ thlǝmata, nandǝ sǝkta, paɗaa ngen wathlandech ha wa,</para>
  <para style="q1" vid="MRK 4:12">Kǝthlǝm maa ǝ sǝnda, nandǝ tǝrtǝ ha naa fee kalandat ha paɗ.’”<verse eid="MRK 4:12" /></para>
  <para style="s">Mbuˈ Yesu saktǝ thlǝ chehtǝɗi</para>
  <para style="r">(<ref loc="MAT 13:18-23">Mat 13:18-23</ref>; <ref loc="LUK 8:11-15">Luk 8:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />Ndangkǝ Yesu tanda wa, “Sǝnwowun saktǝ ndiktǝɗiya wa? Maa sǝnwowun saktǝɗiya wa, yen sakchaˈan natwun mbahǝn sǝnda? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />Weˈtǝɗi weˈya thlǝ huɗaɗiya, ndaˈan nech kǝ ndikti Farta. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />Weˈtǝɗi hǝhatech kǝ hur mbandǝ yu, pǝnchan wa nafchiɗi sǝkchǝ ndikti Farta. Kǝ sǝkkanda, chat ɓak Hweˈra huppandǝ ndiktǝɗi kesh chehtǝ fee hur wandǝkaɗatˈyanda. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />Weˈtǝɗi hǝhatech kǝ hǝrang feryu paɗ, fen kaɗandǝ fee tǝ weˈtǝ nafchǝɗi sǝkchi ndiktaˈan kǝ sǝkkanda thlǝkandǝ leɗ leɗ, tǝ mbǝnfata. <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />Kǝthlǝm thlaarchandǝs yimwandǝ ha wa, kǝrǝs wa nda wa. Kǝ ɓak ɓahta, tǝ nggwarkwana kǝmɗiyanda, kǝthlǝm ndikti Farta, chat nggǝrankandǝ in kǝrsǝn. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />Weˈtǝɗi hǝhatech kǝ hur tahchiyu paɗ, fen kaɗandǝ fee tǝ nafchǝɗi sǝkchǝ ndiktaˈan. <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />Kaɗa ichi heshiɗiya, tǝ lǝm inda thla thlǝ ɓa kǝnau taˈanchi, tǝ yah ichi kaan, ɓakan ɓǝlandǝ ndikti Farta kaɗ wanɗikaɗechˈyanda, pawa wanchi kafa wa. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />Weˈtǝɗi hǝhatech kǝ kwastǝ mǝt yu, fen kaɗandǝ fee tǝ nafchǝɗi sǝkchi ndikti Farta, thlǝkanda, chikandǝ tersi, nggǝt kan ndǝ wanchǝ kaan, fowun kum chǝt mahkan, fowun kum chǝt michˈcha, fowun paɗ, kum chǝt kum.”<verse eid="MRK 4:20" /></para>
  <para style="s">Sakta kǝ ɗar tikesha</para>
  <para style="r">(<ref loc="LUK 8:16-18">Luk 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />Chǝhan kǝ Yesu mee tanda wa, “Na nafchǝ nja ndǝ tikesha kǝ mbulmandǝ tǝ ɗuliya wa? Ndu kǝ wuɓanchi kan mǝt hunata wa? Ngga thlǝ ɗǝf chowun kǝ mǝɗi nech ɗengel wa? <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />Nat ǝnɗi nech ǝ wuɓta, nafe kuɓsandǝ kesh. Ənɗi nech ǝ nggǝthla, nwaat naa fee inandǝ ha hayang. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />Nat thla naa thlǝma sǝktiyansi, kǝ sǝkka.”<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />Ɗǝkan kǝ pang tǝ ndat wa, “Sǝkama ndiˈchan tasau tǝɗi kaɗa ndu nefsi, tǝ ndaˈan nafee kaɗu tǝssi, tǝ chektaˈan. <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />Nat thla naa ǝn ˈyansi, naa fee chekanda, thla nawaktǝn ˈyansi paɗ, chǝka ǝnɗi nessiyan ngguɗyeh naa fee thlandǝ har.”<verse eid="MRK 4:25" /></para>
  <para style="s">Saktǝ weˈtǝɗi tifcha</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />Ndak Yesu wa, “Nech kutǝrakti Farta kǝɗ nefa, thla weˈech weˈta ǝ hǝngga. <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />Kǝ mǝngkan ha tifkǝ weˈtiɗi, mangkan, sǝnwu nef ini ǝnɗi chicha kǝnan maanda wa. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />Fǝrtǝ thlǝ kǝssanchǝ ǝnsi kǝ maana, tǝrkanan thlǝ tifchan kǝ kwefa, kǝnan mbǝthla kǝnan paa waa kafa. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />Ma ǝ nǝhi ɗisǝmnan, tǝrkǝ fee wanggǝta chathlan kǝ fee ha, kǝthlǝm sheˈ fartǝ haathla.”<verse eid="MRK 4:29" /></para>
  <para style="s">Saktaˈan tǝ wan mustaɗ</para>
  <para style="r">(<ref loc="MAT 13:31-32">Mat 13:31-32</ref>,<ref loc="MAT 13:34">34</ref>; <ref loc="LUK 13:18-19">Luk 13:18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />Ndangkǝ Yesu tandǝ paɗ wa, “Tǝ mii natmǝn kaɗa ndǝ kutǝrakti Farta? Tǝ weˈti saktǝ mii natmǝn pǝnda? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />Nechan kǝɗ wan mustad, thla nech ngguɗyeh hur weˈta thla thlǝ chehtǝ fee. <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />Chǝka kǝɗu maa ǝ chehan fee, thlǝ nechan maanda kǝ pǝɗanchǝ takǝt ɗǝf chǝ ha, paɗ thlǝ njarchan ha kaan, ɗǝngchǝ paɗ thlǝ tǝrchandǝ kaha kǝ kan ɗǝftaˈan.”<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />Tǝ weˈtǝ sakchiɗiya terchan, mbuˈanda Yesu ndikti Farta, ɓakan keˈke tǝ sǝndiyanda. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />Mbuˈa wa tandǝ ǝnawa, maan ngga tǝ saktaˈan wa. Paɗaa maa mǝthlan tǝ kǝmsichiyan, thlǝ nechan mbuˈanda chǝkamǝ hayang.<verse eid="MRK 4:34" /></para>
  <para style="s">Yanan Yesu rǝnna ha</para>
  <para style="r">(<ref loc="MAT 8:23-27">Mat 8:23-27</ref>; <ref loc="LUK 8:22-25">Luk 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />Ə fartǝ ini, farwita, ndang kǝ Yesu kǝmsichiyan wa, “Cheman hawurtǝɗiya.” <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />Malkanndǝ takǝt nafchǝ ha, yimkandǝ kǝ hur kwombawal tǝɗi natǝn huran, pǝɗakanda. Fowun kwombawal chǝs minni. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />Thlaˈkǝ kapa rǝnnaa, nakan thlaˈandǝ ˈyam kufiˈan nakan thlǝftǝ kafi kwombawal ˈyanda. Nak ˈyamɗi yimndǝ kǝ huran, nak kwombawal taˈan yimndǝ ha kǝ hur ˈyaman. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />Nak Yesu saˈen tǝ kǝrsǝ kwombawal taˈan ɗǝftǝ indiyan kǝ ɗar mǝt ɗǝf inda. Ɓak Kǝmsichiyan nah nanda, ndang kanda wa, “Thlǝ chaˈanan kaɗi, kǝmuwu ǝnawa, nggǝmǝn meˈi mǝrta?”<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />Kǝ nahǝnkǝ Yesu, yanan kan rǝnniˈyan ha. Ndang kan hawurtaˈan wa, “No kǝmma, nggasu ɓaˈ.” Chat rǝnni ini thlarkan ha nak mǝɗan kǝmma.<verse eid="MRK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 4:40" />Ndang kan kǝmsichiyan wa, “Kǝthlǝm mǝ natwun lekǝt kǝɗuyu? Paˈ kǝ nakanya fǝrwowun kit wa?”<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />Lekǝkandǝ kaan, ndang kandǝ raˈan wa, “Weˈtǝ naf mǝ kǝɗaya? Rǝnna, tǝ ˈyam hawurta, tandǝ fǝran maanda?”<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">Kǝnan Yesu nef kaɗ tǝ ɓǝɓi shemet fa</para>
  <para style="r">(<ref loc="MAT 8:28-34">Mat 8:28-34</ref>; <ref loc="LUK 8:36-39">Luk 8:36-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />Yesu tǝ kǝmsichiyan, talang kandǝ kufi ˈyan kǝ hahi Garasin.<note caller="+" style="f"><char style="fr" closed="false">5:1 </char><char style="fk">Gadara:</char> Fowun yarechaˈan yi choha yarechandǝ wa “Garasinawecha” ndu “Gergesena” minni.</note> <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />Kǝ tǝrkǝ Yesu kaha hur kombawal taˈan, chat ɓak nefa thla naa ɓǝɓi shemet fiyan, chechan kesh mǝt thloh mǝrcha, kǝ kakndǝ fa. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />Thlǝ minchi nafan ǝ mǝt thloh mǝrcha. Mbahǝn wu fee kǝnanda wa, chǝka tǝ chalala. <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />Kurɓan fee kǝnandǝ harchiyan tǝ sarchiyan tǝ chalala, thlǝ nechan ɗǝɗahandǝ kaɗi, kǝ chichenchi tǝpas chaˈan kaɗ thla kǝnandǝ fee sarchiyan. Nefsǝ tǝ alkǝtfa chaˈchǝs kǝ kǝsanchi ha wa. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />Ndǝ wita tǝ weenmǝta thlǝ nechan wiˈtǝ ha ǝ mǝt thloh mǝrta, tǝ ɗar ɗakwancha, nakan hwata, nakan thle thlendǝ fatˈyan fa tǝ ɗakwancha.<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />Kǝ nak nafan Yesu ɓata langnga, ɓǝt kansi tǝ rakata chamkan kuruminchan ha ǝ pangngǝnan. <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />Hwakan tǝ kappa ɓǝrata, ndakana, “Mǝ kǝmuchǝ tǝ nenchi Yesu, Waˈi Farta thlǝ Maanda? Shiyuchi tǝ thlǝm Farta, kǝ ɓehichin wa” <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />Mbuˈchan kǝɗu kǝthlǝm tapi ǝ ndan Yesu ɓǝɓi hwaˈran wa, “Chaku ha tǝ nafan, ɓǝɓi hweˈra.”<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />Paɗ, chǝhangkǝ Yesu wa “Thlǝmwa wa kǝni?”</para>
  <para style="p" vid="MRK 5:9">Nggǝrang kǝ nafan suwa, “Thlǝmna wa, Terchan, kǝthlǝm terchan ǝn.” <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />Nakan shiyandǝ Yesu kaan, wa mǝ rǝk tǝ tandǝ kesh mǝɗan wa.<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />Chaap kǝlangarchǝsi nech parata nduk tǝ mǝɗan kǝlaar ngwela. <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />Shiyankǝ hwaˈarchaˈan Yesu, “Puku nggaˈan kǝ hur chaap kǝlangarchiɗi, kǝ yim ǝn kǝ hur nanda.” <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />Nggǝmankan ˈyanda. Chek ɓǝɓi hwaˈarchaˈan kesh fii nafan, yimkandǝ kǝ hur kǝlanggarchaˈan. Naa kǝlanggar chaˈan saˈta aruˈ chap. Thlaˈkanda nakandǝ rakat kaha, kǝ hur kufiyan, tǝmɗi nech hwengnga, tǝkkandǝ haa minni.<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />Kǝ nak fee nech para chaap kǝlanggarchiɗi, ǝnɗi sǝɓcha rakakanda kǝ hur wan mǝrɓan tǝ wan mǝrǝɓchaˈan mbuˈ kandǝ ǝnɗi sǝbcha. Chek nafchaˈan kesh kǝ ɓandǝ naa ǝnɗi sǝɓcha. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />Saˈchandǝ kǝmɗi Yesu, nakandǝ nafɗaa choh tǝ hwaˈarchif terchanyu, ɗas tǝ kapat fiyan ɓi hur indiyan kaɗi, nakandǝ lekǝta. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />Fee nech ǝnɗi sǝɓcha tǝrkwathl kanan. Mbuˈankandǝ takǝt nafcha ǝnɗi sǝɓchǝ minni, kǝ ɗar nafɗi nech tǝ hwaˈarchǝ fa tǝ chaap kǝlangarchiɗi paɗ. <verse eid="MRK 5:16" /><verse number="17" style="v" sid="MRK 5:17" />Chat nafchaˈan nggak kandǝ shiyandǝ Yesu, kǝ maltǝ hahi ˈyandǝ ha.<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />Nak Yesu yim ndǝ kǝ kwombawal tǝɗi ɓat ndǝ huran, ɓak nafɗi kǝnandǝ fee kaɗ tǝ hwaˈarchifyu, kǝ shiyanda, kǝ nggǝmfa kǝ pǝɗa nda waˈ taˈanchi. <verse eid="MRK 5:18" /><verse number="19" style="v" sid="MRK 5:19" />Paɗaa nggǝmawu Yesu fa wa, ndang kan wa, “Nggǝrang in kyeuri, kǝmɗi parchuwa, paɗ mbuˈanko tanda ǝnɗi chu tǝ Chinda, tǝ pǝn kaakǝt ɗi chutǝn.” <verse eid="MRK 5:19" /><verse number="20" style="v" sid="MRK 5:20" />Pǝɗak nafan, thlaˈtǝ ǝ Decapolis ɗǝkan naa mbuˈ ǝnɗi chandǝ Yesu. Nat nafchiɗi sǝkcha sakan ndak inda.<verse eid="MRK 5:20" /></para>
  <para style="s">Kǝnan Yesu waˈi Yayirus kǝ nuwaa tǝ nu nef nech thlǝr fera</para>
  <para style="r">(<ref loc="MAT 9:18-26">Mat 9:18-26</ref>; <ref loc="LUK 8:40-56">Luk 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />Nggǝrkǝ Yesu chendǝ hawurtaˈan paɗ tǝ kwombawal. Nggom kǝ nafchǝ terchan taurankandǝ ha, ǝ mii hawurtaˈan. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />Artǝ hur paktechi kǝtǝn shita naa thlǝman wa Yayirus, ɓakan kǝmǝɗan. Kǝ nakan Yesu, ɓakan kǝmɗiyan, chamkan kuruminchi ha pangngǝnan, <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />shiyankan kaan, ndangkan wa, “Waˈinchi kǝ nuwaa nech me i mǝrta. Komkom ɓo ɗǝfan her kǝ inda, kǝthlǝm kǝ kǝn kaɗi, kǝ chok tǝ shishing ndǝfa.” <verse eid="MRK 5:23" /><verse number="24" style="v" sid="MRK 5:24" />Tǝ kǝɗu, pǝɗak Yesu tǝ ndi.</para>
  <para style="p" vid="MRK 5:24">Tertǝ nafcha kaan parech ndi, nakandǝ njekǝthl ndi.<verse eid="MRK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25" />Hur nanda yowun nunefsi nech saa ɓahta tǝ hatǝfa thlǝr fera, yi hurech kum nggǝrsǝ chap. <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />Sii tǝ ɓahtǝ kaan mǝɗi fǝ fǝr wanɓǝɓicha. Sǝɓɓantǝ ichiyan kaɗ nat, chǝk kǝɗu mbǝswa kǝndǝ kaɗ wa. Nak hatǝfaɗan chekta. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />Kǝ sǝkkan kusheˈtǝ Yesu, chat parakan tǝ hur nafcha ɓakan tǝ kǝrsaˈan, tǝkankan her kapatˈyan fa. <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />Kǝthlǝm kaɗechan wa, “Maa ǝ tǝkani her kapatˈyan fǝ ndak, ni mbǝs kǝndǝ kaɗi.” <verse eid="MRK 5:28" /><verse number="29" style="v" sid="MRK 5:29" />Chat kǝɗuyu thlarkǝ thlǝr farɗa hayu, paɗ sǝkkan fi fatˈyan, ǝ kin kaɗ hur ɓahtiyan ha. <verse eid="MRK 5:29" /><verse number="30" style="v" sid="MRK 5:30" />Chat kǝɗuyu sǝn Yesu wa chi alkǝt kesh fi fatˈyan, chǝt yowun tera. Tǝɓǝrkǝ Yesu ha hur ngomnan, ndakan wa, “Wun tǝ kan chi her kapatinchi fa?”<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />Nggǝrang kǝ kǝmsichiyan suwa, “Chǝ naa tertǝ nafchi chǝka tǝ yeni njek njek kǝlaarwa, kǝ no naa chǝhata wa, ‘Wun tǝkichi herfa wa?’ ”<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />Paɗaa, nak Yesu ɗǝpat ha chǝk tǝ yeni maˈnan naa thla tǝkanchi herfa. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />Kǝ sǝnkǝ nuɗi ǝnɗi sǝɓcha tǝ ndi, chekan kesh, kopkanha pangngǝn Yesu, fatˈyan rǝɓtǝfa, tǝ lekǝta. Mbuˈankan Yesu kit tǝ ǝnɗi sǝɓcha. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />Ndangkǝ Yesu wa, “Waˈinchi, fǝr kitˈyo kǝnuchi kaɗi, ɗu kaɗ hashas. Ɓahtiyo ha tǝɓi.”<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />Mǝthlan hur shenuˈtaˈan, chat ɓak nafcha ǝ wiri Yayirus pangnda yi wur nggomnan, nakandǝ nda ndǝ Yayirus wa, “Mǝr wanan ˈyo. Kǝ ɗǝfin thlǝ chaˈanan kaɗi kǝ ɓah ha wa.”<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />Kǝmawu ǝn Yesu tǝ ndiktiyanda wa, ndang kan Yayirus wa, “Mǝ thlaˈ hur indiyowa, yu furu kit ndak.”<verse eid="MRK 5:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 5:37" />Nggǝmwa fǝ kǝ par nef ndǝ wa, maangga Biturus, tǝ Yakubu, tǝ Yohanna wanman Yakubu wa. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />Kǝ saˈ kan ndǝ kauran i Yayirus, nak Yesu nafchiɗi nech wuran, tandǝ tǝta, tandǝ hwata tǝ kappa ɓǝratǝ kaan. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />Yim kansi, ndangkan tanda wa, “Mǝ thlaˈanchǝ hurˈinchowun, natwun hwat kǝɗaya? Wannu wannan ngga tǝ mǝrwa, tǝn saˈ en ndak.” <verse eid="MRK 5:39" /><verse number="40" style="v" sid="MRK 5:40" />Chat nakan ndǝ massa njir fata.</para>
  <para style="p" vid="MRK 5:40">Rǝkkan tandǝ kesh nat nda, mǝthlan tǝ chin wanan, tǝ manan, tǝ kǝmsichiɗi ɓat nda, yimkandǝ kǝmɗi naa wan nuwanan. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />Kǝskǝ Yesu herˈyan har, ndang kan wa, “Talita kumi.” (ndat wa, “Wannuwaa, ngǝt nduta wa, thlaˈu.”)<verse eid="MRK 5:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42" />Chat kǝɗuyu thlaˈkǝ wannu wanan wiˈkan ha (Huratˈyan kum nggǝrsǝ chap). Kǝthlǝm ndaˈan, nat nda sakandak indǝ kaan. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />Kahankǝ Yesu thlǝmechˈyandǝ kaan, mǝ mbuˈandǝ nef ǝn ɗi sǝɓcha wa. Chat ndang kan tanda wa, fǝramandǝn ɗǝsǝmndǝ wannu wanan, kǝ sǝma.<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">Kar fee Yesu ǝ Nazarat</para>
  <para style="r">(<ref loc="MAT 13:53-58">Mat 13:53-58</ref>; <ref loc="LUK 4:16-30">Luk 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />Malkǝ Yesu minni ha, pǝɗakan kǝ hahiɗi maandǝn. Pǝɗak kǝmsichiyan ɓukwaˈ tǝ ndi. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />Kǝ saˈkǝ fartǝ yipti Yahudawecha, yim kan kǝ hur kǝtǝn nggomnda, ngakkan chaˈandǝ kaɗi, tertǝ nafchiɗi sǝkchi ndi saka ndak inda.</para>
  <para style="p" vid="MRK 6:2">Nakandǝ chihandǝ raˈan wa, “Mbǝschi nafɗa ichiɗiya ayi? Weˈtǝ ɗathl mii fǝrandǝ fee thlǝ mbahǝndǝn chit weˈtǝ ǝnna sakaˈinɗiya?”<verse eid="MRK 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 6:3" />“Ngga thlǝ kukwa ichiɗi nawa? Ngga wanɗi nggǝttǝ Maryamu niyawa? Ngga wanman ndǝ Yakubu, tǝ Yusufu, Yahuda tǝ Siman wa? Ngga fenchaˈan kǝ nǝssa tandǝ mǝɗiya tǝ mǝnchǝ wa?” Sǝɓan kandǝ hwir kaɗ tǝ ndi, karkandǝ anchi.<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />Ndang kǝ Yesu tanda wa, “Thlǝ fǝranchi fee maanda thlǝ shenuˈta tǝ yahti Farta chika tǝyeni, mangga mǝɗi maandǝn, hur wanmanchaˈan, tǝ wirˈyanda, thlǝ chǝwaktǝ fee wa.”<verse eid="MRK 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 6:5" />Mbahǝn wa chit ǝna saka indǝ minni wa. Ɗǝf kan her kǝ ɗar fowun nafchǝ ɗǝmok nech haˈchan ndak, kǝnan kan tandǝ kaɗi. <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />Sakan kǝ inda Yesu, kǝ ɗar kumi fǝr kit ˈyanda.</para>
  <para style="s" vid="MRK 6:6">Thlǝn Yesu kǝmsichiyan kum nggǝrsǝ chap</para>
  <para style="r" vid="MRK 6:6">(<ref loc="MAT 10:5-15">Mat 10:5-15</ref>; <ref loc="LUK 9:1-6">Luk 9:1-6</ref>)</para>
  <para style="p" vid="MRK 6:6">Wiˈyan Yesu wan mǝrǝɓcha, nakan chaˈandǝ ndikti Farta kaɗi. <verse eid="MRK 6:6" /><verse number="7" style="v" sid="MRK 6:7" />ˈYakan fee nech kum nggǝrsǝ chap yu, thlǝnkan tandǝ chap chap, fǝrankan tandǝ alkǝta kǝ ɗar ɓǝɓi hwaˈarcha. <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />Paɗ ndang kan tanda wa, “Mǝ kǝswun ǝn har wa kǝthlǝm wiˈtaˈan wa, ndu yaata, ndu yakwata, ndu wandǝɓǝthla, ǝ thlipoˈyowun wa. Fangndǝ ndak natwun kǝstǝ har. <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />Kǝ powun pyehma, mǝ kǝswun kapat har samǝn wa mangga thla fiyowun wa.” <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />Nat wurɗi yimnduwunsi tǝrkwathl kanan, chokamsi kǝ fartǝɗi nat wun mal mǝrɓan ha. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />Nat mǝɗi thlǝwak tǝndǝ wunchi, paɗ karkandǝ sǝk ndiktǝ ˈyowun, maa kun mal mǝrɓan ha, kǝ thlǝfawun tǝnaˈtǝ sarchiyowun kaɗi kǝ chok kǝ ɗǝ sǝnan kǝ ɗar indiyanda ndat wa, nat inɗi kǝssǝ tanda heˈtaˈan yinanda.”<verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />Thlaˈkanda pǝɗakanda, nakandǝ ɓasandǝ nafchǝsi ndat wa, kǝ mallandǝ chǝt ɓǝɓifata kǝ tǝrndǝ ha. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />Rǝkan kandǝ hwaˈarchi kesh terchan fi nafcha. Paˈan kandǝ nafchǝ terchan fiɗeta fee nech haˈchan, kǝnan kandǝ tandǝ kaɗi.<verse eid="MRK 6:13" /></para>
  <para style="s">Mǝrti Yohanna thlǝ chit baptisma</para>
  <para style="r">(<ref loc="MAT 14:1-12">Mat 14:1-12</ref>; <ref loc="LUK 9:7-9">Luk 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />Sǝkkǝ Hiridus kwitira kusheˈtǝ ǝnɗi sǝɓcha, kǝthlǝm wel kusheˈtǝ ǝnɗi chǝt Yesu ha chǝk tǝ yeni. Nak fowun nafchǝ ndat wa, “Yohanna thlǝ chǝt baptisma niya thlaˈcha ǝ hur mǝmatecha, ndaˈan mbǝs tǝn alkǝt chit ichiɗiya yi saka inda.”<verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />Fowun ndat wa, “Nafɗiya, Iliya ni thlǝ shenuˈta tǝ yahti Farta.” Fowun paɗ ndaka nda wa, “Auwa thlǝ shenuˈta tǝ yahti Farta, kǝɗ arta hur fǝ shenuˈta tǝ yahti Farta yi choh.<verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />Kǝ sǝkkǝ Hiridus ndikchiɗiya, ndakan wa, “Thleya Yohanna, thla ɗǝf tisi kǝ thlen fee ɓǝrata, methlan thlaˈa ndǝ fee ǝ mǝmatecha.”<verse eid="MRK 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 6:17" />Kǝthlǝm choh Hiridus tǝ indiyan fǝr chǝ mee kǝ kǝsan fee Yohanna, kǝ kǝnan fee ǝ pursuna. Chich Hiridus kǝɗuyu kǝthlǝm kǝt Hirudiya nu wanmanan Filibus, thla kaha ndǝn, peˈ Filibus ha tǝ shishingnda. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />Kǝ tang tang thlǝ nech Yohanna ndandǝ Hiridus wa, “Kǝmwasǝ kǝ thlǝ neeni nu wan mu wa.”<verse eid="MRK 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19" />Kǝthlǝm ndaˈan, Hirudiya taˈan, chok tǝ sǝɓtǝ hwira hur wanɗǝkaɗatˈyan tǝ Yohanna. Yahkan si kǝ ɓǝlanchi, paɗ mbǝs wa mbanan wa, <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />kǝthlǝm Hiridus lekantǝ Yohanna kaan. Shin wa nefa thla nech tǝ thlǝrɗakta mǝɗi Farta. Chiɗ chiɗ paɗ, ndaˈan kǝskǝ Hiridus Yohanna har ndiˈchan kǝthlǝm kǝ ɓilan fee wa. Thlǝ tǝrchan kafǝrta nat fartǝ ɗi naa Yohanna ndiktǝ taˈanchi, chika kǝɗu thlǝ yahchan sǝk ndiktiyan.<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />Ə ndukwadan Hirudiya ɓi mbǝs mbanda. Fartǝɗi ndiɗan ndǝ Hiridus hura nggǝttǝyan ha, tahsan kan mbǝnfata ˈyakan paktǝ fǝ tarchiyan, tǝ paktǝ fǝ yaanchi yan, tǝ paktecha ǝ hahi Galili kǝthlǝm kǝ sǝmndǝ ǝna. <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />Kǝ yim kǝ waˈi Hirudiya kǝ nunefa kǝ pangngǝn Hiridus, rǝɓkan pangngǝn Hiridus tǝ ramchiyan. Kwalkandǝ fat fǝ kaan. Ndang kǝ Hiridus wa, “Shiyu nat ǝnɗi yahtu, nii furu ta.” <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />Ɗǝfangkan mee tǝ hwunˈnata, “Chika mǝ yahtu, nii furuta. Chika chak tǝ kutǝraktinchi.”<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />Chekan kesh chihangkan manan wa, “Mǝ nati shita?”</para>
  <para style="p" vid="MRK 6:24">Ndak manan wa, “Indi Yohanna thlǝ chǝt Baptisma.”<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />Chat kǝɗuyu nggǝrankan in kǝmɗi kutǝran tǝ wesheta, ndangkan wa, “Chat chat kǝɗaya, indi Yohanna thlǝ chit Baptisma yahti hur tafata.”<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />Kǝ sǝkkǝ kutǝran kǝɗuyu, thlaˈkǝ hur indiyan kaan, paɗ kǝthlǝm ɗǝf miiɗi chǝtǝn tǝ hunnata, tǝ ramchiyan, yahwa kǝ tǝnganchi ɗǝf miiɗi chǝtǝn wa. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />Kǝthlǝm ndaˈan, chat thlǝnkan artǝ hur fǝ yaanchiyan tǝ ndat wa, kǝ ɓǝ tǝ indi Yohanna thlǝ chǝt Baptisma. Peɗak nafan, thlenkan ɓǝrati Yohanna thla nech ǝ pursuna. <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />Ɓakan taˈanchi hur tafata, fǝran kan wan nuwanan, mǝthlan paɗ ɗangkan manan. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />Kǝ sǝk kǝ kǝmsichi Yohanna ǝnɗi sǝɓcha, ɗǝkandǝ tǝr koha fati Yohanna taˈan, ɗǝkandǝ thlohanda.<verse eid="MRK 6:29" /></para>
  <para style="s">Sǝman Yesu ǝn nafchǝ aruˈ ɗǝrman</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mat 14:13-21</ref>; <ref loc="LUK 9:10-17">Luk 9:10-17</ref>; <ref loc="JHN 6:1-14">Yoh 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />Kǝrsi wanmǝnchaˈan, kǝmsichiɗi thlǝndǝ Yesu kum nggǝrsi chap choh yu. Ɓakandǝ kaɗ kǝmɗi yan, mbuˈankandǝ ǝnɗi nat chǝt nda, tǝ ǝnɗi chaˈandǝndǝ nafchǝ har. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />Kǝthlǝm nafchǝ terchan nakan ɗǝt tǝ ɓat kaɗi, mbǝs wandǝ mbanda kǝ sǝmndǝ ǝna wa, ndang kǝ Yesu tanda wa, “Ɓama tamǝ kǝmɗi nawaktǝ nafchi si, kǝthlǝm kǝ yipmǝn minni.” <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />Yim kǝ Yesu tǝ kǝmsichiyan kǝ hur kwombawal, pǝɗakandǝ kǝmɗi nawaktǝ nafchissi, fen ndak.<verse eid="MRK 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33" />Ni nafchǝ tandǝ terchan fartǝɗi nat ndǝ mal mǝɗan ha, paɗ sǝn fee tanda. Rakka kanda tǝ sarcha thlaˈtǝ wan mǝrǝbchi samǝn samǝn, paɗ saˈkandǝ mǝ tanda. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />Kǝ tǝrkǝ Yesu kah hur kwombawal taˈan, nakan nafchi terchan. Paɗ haɗan kǝ nafchiɗi fa, kǝthlǝm nechandǝ kǝɗ chohrechǝ ɗi nawak tǝ thlǝ parat si. Chat nggak kan chaˈanda ichi har samǝn samǝn. <verse eid="MRK 6:34" /><verse number="35" style="v" sid="MRK 6:35" />Nduk tǝ hǝmɗi Farta, ɓak kǝmsichiyan kǝmɗiyan, ndangkanda wa, “Mǝɗiya wurchis wa. Paɗaa fartǝ hǝm nda. <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />Nda ndǝn nafchǝɗiya wa, kǝ ɗǝ ndǝ kǝ mǝrǝɓcha tǝ wan mǝrǝɓ chiɗi mǝɗiya. Kǝ hiyandǝ indi yandǝ ɗǝsǝmndǝsi.”<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />Nggǝran kǝ Yesu tandǝs wa, “Kun fǝraman tandǝ ɗǝsǝmnda, kǝ sǝmnda.” Nggǝrankǝ kǝmsichaˈan ˈyansu wa, “Yahcho sǝ kǝ ɗǝ ǝn hi ɗǝsǝmǝnɗa yi ndǝnari kum chǝt kum chap kǝ fǝran ǝn tandǝ kǝ sǝmnda wa?”<verse eid="MRK 6:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38" />Tǝ kǝɗu chǝhan kǝ Yesu tanda wa, “Ɓilshet kurmi nessiyowun? Ɗam ɗǝpamandǝn.” Ɗǝpang kanda, ndang kan nda wa, “Ɓilshet ɗǝrman tǝ yirfǝ chap.”<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />Ndang kǝ Yesu kǝmsichiyan wa, kǝ chokandǝ nafchǝ ha tukut tukut, kǝ ɗar hwalita. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />Chokkǝ nafchaˈan ha michi samǝn samǝn, fowun nechan ndǝ kum chǝt kum arta, fowun kum chǝt ɗǝrman . <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />Tǝrkǝ Yesu ɓilsheɗi ɗǝrman tǝ yirefɗi chap yu, thlaˈankan indiyan kafǝrta, changkan Farta usoko. Chichenkan ɓilsheɗan ha, fǝrangkan kǝmsichiyan, kǝ chakkaandǝ nafcha. Yirǝfɗi chap yu paɗ, chakankan ha kǝthlǝm nafchaˈan nat. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />Nat nda sǝm kanda, paɗ nggalkanda. <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />Kǝmsichiyan paɗ ngomman kandǝ takǝt chiche ɓilsheɗi, tǝ yirǝf ɗi. Ndiɗantǝ inafta kum nggǝrsǝ chap. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />Tertǝ nafchiɗi sǝmchi ɗǝsǝmǝn ini, hǝssǝ aruˈ ɗǝrman.<verse eid="MRK 6:44" /></para>
  <para style="s">Wiˈ Yesu ɗar ema</para>
  <para style="r">(<ref loc="MAT 14:22-33">Mat 14:22-33</ref>; <ref loc="JHN 6:16-21">Yoh 6:16-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />Chat kǝɗuyu Yesu ndang kan kǝmsichiyan wa kǝ yim ndǝ kǝ hur kombawal kǝ tallandǝ kǝ laandǝ kǝ Betsaida, mǝthlan nakan ndandǝ nafcha wa kǝ ɗǝndǝ kaɗi. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />Kǝrsǝ mal nafchaˈan ha, pǝɗakan kǝ ɗar ngwella kǝthlǝm kǝ shenuˈ tǝ Farta <verse eid="MRK 6:46" /><verse number="47" style="v" sid="MRK 6:47" />Chǝk far wita, kombawal taˈan hur ɗǝfi tǝ hawurta. Yesu paɗ mǝthlan ɗar wan tingringnda ichiɗan. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />Nakan tandǝ ɓahtǝ ha tǝ kombawal tǝɗi, kǝthlǝm yah ndǝssi kǝ hurandǝ kombawal taˈan kǝ pangnga, paɗ nak rǝnniˈan nggǝra ndat kǝrsin. Katamǝta, ɓakan nduk tǝ tanda, mǝthlan wiˈtǝ ɗar ˈyaman. Yehsi kǝ pǝɗandech ha. <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />Kǝ nakandǝ anchi mǝthlan wiˈtǝ ɗar hawurtaˈan, tǝr kanda wa shemeti mǝrta. Hwakanda tǝ alkǝta. <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />Kǝthlǝm nii ndǝ anchi nat nda, paɗ lekǝ kanda.</para>
  <para style="p" vid="MRK 6:50">Chat kǝɗuyu ndikkǝ Yesu tǝ tanda, ndakan wa, “Kǝ thlaˈ hur indiyowun wa, nggǝta kǝ lekǝwun wa.” <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />Yimkan kǝ hur kombawal tǝɗi nat ndǝ huran, chat hunak rǝnni ˈyan ha. Sakan kǝ indǝ tandǝ kaan, <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />kǝthlǝm sǝnwandǝ saktǝ sǝman ǝn nafchǝɗi tǝ ɓilsheɗi kwaɗǝn wa. Nakan nggǝl wanɗǝkaɗat ˈyandǝ kaɗi, kǝthlǝm kwaˈkwa tǝ inda.<verse eid="MRK 6:52" /></para>
  <para style="s">Kǝnan Yesu hachǝ kaɗi ǝ Janisarat</para>
  <para style="r">(<ref loc="MAT 14:34-36">Mat 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />Kǝ chen kandǝ hawurtaˈan, saˈkandǝ kǝ hahi Janisarat, kǝnan kandǝ kombawal taˈan ha mii chichang nda. <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />Kǝ chekan ndǝ kesh hur kombawal taˈan, chat kǝɗuyu nafchiɗi nech minni, nakandǝ Yesu, sǝnkanda wa, mithlan. <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />Nafchiɗi nakandǝ rakata, ɗǝkandǝ ɗǝt kǝ wan mǝrǝɓchiɗi nech hur hahiˈyan. Nakan ndǝ ɓat tǝ fee nech haˈchan ɗar wenichiyanda, nat ǝ mǝɗi sǝktǝ nda wa Yesu minni. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />Nat mǝɗi sǝktǝ nda wa Yesu minni, ndu kǝ hur wan mǝrǝɓ chaˈan, tǝ pak tǝ mǝrǝɓ cha, ndu mi wurcha, thlǝ nech nafchǝ ɓat tǝ hachaˈan kǝ ɗǝf ndǝ tandǝ ha mǝɗi thlǝ nggomndǝ nafcha kǝ hunandǝ tandǝ ha. Nakandǝ shiyanda, kǝ ngǝmfa, hachaˈan kǝ tǝkandǝ her mii kapatˈyan fa. Nat fee tǝkanchi her mii kapatˈyan fa, kǝndǝ kaɗi.<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">Chaˈandi Yesu kaɗ kǝ ɗar raˈati pangngǝncha</para>
  <para style="r">(<ref loc="MAT 1:1-9">Mat 1:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />Fǝ Chaˈandǝ Kusiˈ i Musa kaɗi, tǝ Farisiyawecha, fee ɓech ǝ Urshelima nggom kandǝ kǝ thlǝma Yesu. <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />Nakandǝ fowuna hur kǝmsichiyan sǝm ǝn tǝ harcha yohthlǝm nda, ndaˈan nech ngga tǝ chapa ndǝ her kaɗ kǝɗ ǝnɗi mbuˈtǝ raˈat ˈyanda wa.<verse eid="MRK 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3" />(Kǝthlǝm Yahudawecha, tǝ Farisiyawecha, nat nda, sǝm wandǝ ǝn maa ngga tǝ chapandǝ her kaɗ wa, thlǝ nechan ndǝ chǝt tar raˈat ˈyanda kǝɗ yi kaakechnanda. <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />Maa ǝ ɓi ndǝ kaɗ ǝ lǝmo, sǝmwa ndǝ ǝnawa maangga tǝ chappandǝ harchi kaɗ wa. Ichǝs terchan thlǝ thlǝna ndǝ nda, kǝthlǝm kǝ par fee, kǝɗ chapandǝ tǝɓ saa em kaɗi, tǝ ɓucha tǝ kuruɓcha.<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />Chǝhan kǝ Farisiyawecha ɗi tǝ fǝ Chaˈanchaˈan kaɗi tǝ ndat wa, “Kǝthlǝm mǝ thlǝ para waktǝ kǝmsichiyo ǝnɗi mathlǝ pangngǝnchamǝn ha choh, nakandǝ sǝm ǝna ngga tǝ harchiɗi nech chiɗ chiɗ wa?”<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />Nggǝrang kan tandǝs wa, “Keˈkeˈ mbuˈtǝ thlǝ shenuˈta tǝ yahti Farta Ishaya kǝ ɗarwun kun fǝ wenikicha ndat wa,</para>
  <para style="q1" vid="MRK 7:6">“Nafchiɗiya thlǝ nechandǝ manita tǝ mee ndak,</para>
  <para style="q2" vid="MRK 7:6">paɗaa wanɗǝkaɗech ˈyanda pǝɗi langnga tǝ nenchi.<verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />Pafǝn thlǝ nat ndǝ manita.</para>
  <para style="q2" vid="MRK 7:7">kǝthlǝm ichiɗi thlǝ nat ndǝ chaˈandǝ kaɗi kusiˈ i nafcha kǝɗ kusiˈ i Farta thlǝ nat ndǝ chaˈandǝ kaɗi.”<verse eid="MRK 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8" />Ndang kǝ Yesu tanda wa,“Malawun kusiˈ i Farta, nakowun para raˈati nafcha.”<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />Ndang kan tanda wa, ‘Kittaˈan ɗathl mal mban kusiˈ i Farta ha ˈyowunsi, kǝthlǝm kǝ nowun chǝt tar raˈat ˈyowun ndak. <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />Kǝthlǝm ndech Musa wa, ‘Kǝ fireen maanda kǝ chu tǝ mu.’ Ndakan paɗ wa, ‘Nat thla ˈyarech chinan tǝ manan nwaat kǝ ɓǝlan fee.’ <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />Paɗaa kun ndechowun wa, maa ǝ ndan nef chinan ndu manan wa, ‘Nat ǝnɗi mǝ natwun mbǝs tǝ mǝɗinchi tapi chok kǝ Korban,’ ndaˈan nech kǝ ǝnɗi fǝrandǝ fee Farta. <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />Tǝ kǝɗu njankowun nef ini kǝ nggǝr tǝ chan ǝn chinan tǝ manan wa. <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />Tǝ kǝɗu thlǝ natwun tǝr ndikti Farta, kǝɗ ngga ǝnawa. Kǝthlǝm tar raˈatˈyowun thlǝ chaˈandǝ wun nafchǝ har. Thlǝ natwun chǝt ichi kaan kǝɗ thlenni.”<verse eid="MRK 7:13" /></para>
  <para style="s">Ənɗi nech tǝkmandǝ nef kaɗ ǝ pangngǝn Farta</para>
  <para style="r">(<ref loc="MAT 15:10-20">Mat 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />Nggǝrkǝ Yesu ˈya nafcha, ndang kan tanda wa, “Kam thlǝ mat ha natwun kǝ sǝkwun nenchi, tǝ paɗ kǝ wathlowunchǝ ǝnɗi ha nati nbuˈta. <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />Ngga ǝnɗi thlǝ yimchǝ kǝ hwiri nefa, ndaˈan thlǝ tǝkma kaɗ ǝ pangngǝn Farta wa, ǝnɗi thlǝ chech kesh meˈi nefa ndaˈan thlǝ ɗǝfchi nefa kǝ tǝkǝm nan ǝ pangngǝn Farta.” <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />[Thla naa thlǝma sǝk tansi kǝ sǝka.]<verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />Kǝrsi mal nafchaˈan ha yim kan kyeuri, chǝhan kǝ kǝmsichiyan wan ngaˈal saktǝ ndiktaˈan. <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />Nggǝrang kan tandǝs wa, “Kun paɗ wathlowun wa ha wa?” Sǝnwowun wa nat ǝnɗi yimchǝ kǝ hwiri nefa thlaˈ tǝ heshi, tǝkma wa nef kaɗ ǝ pangngǝn Farta wa, <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />Kǝthlǝm ǝnɗi nech heshi ngga thlǝ yimchan kǝ hur wanɗǝkaɗatˈyan wa, yimchan kǝ hwirˈyan, kǝnan chet kesh.” (Tǝ ndiktiɗiya pǝndǝ Yesu nat ɗǝsǝm nda chiɗ chiɗ ǝ pangngǝn Farta)<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />Ɗǝkan kǝ pang tǝ ndat wa, “Ənɗi chech kesh meˈi nefa ndaˈan thlǝ tǝkman chǝ nef kaɗi pangngǝn Farta. <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />Kǝthlǝm thlaˈtǝ hur wanɗǝkaɗati nefa, thlǝ naa ɓǝɓi kaɗat ɓat kesh. Kaɗa ɓǝɓifata, rinnikǝta, yarkǝta, ɓǝlfata, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />tǝ fǝlaukǝta, tǝ yah inda, tǝ sǝraˈta, tǝ lǝkta, tǝ kǝs ǝn kǝ hur, tǝ sǝɓandǝ thlǝm nef kaɗi, tǝ maan inda, tǝ kumi kaɗa ǝna. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />Nat ichiɗiya thlǝ nechandǝ ɓat kesh hur wanɗǝkaɗati nefa, nakandǝ tǝkǝmandǝ nef kaɗi.”<verse eid="MRK 7:23" /></para>
  <para style="s">Fǝr kit i nunefa</para>
  <para style="r">(<ref loc="MAT 15:21-28">Mat 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />Thlaˈkǝ Yesu minni, pǝɗakan nduk tǝ mǝrɓi Taya tǝ Sidon. Yim kan kǝ wiri nefa, yah wa kǝ sǝn nafcha wa, chǝka kǝɗu mbahǝn wa wuɓandǝ indiyan wa. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />Chat kǝɗuyu nunef si thla naa waˈyan kǝ nuwa tǝ ɓǝɓi shemet fa sǝk kan kusheˈtaˈan, ɓakan chamkan kuruminchǝ ha ǝ pangngǝn Yesu. <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />Nunafan thlǝ Helenawata. Nggǝt chǝ fee ndi ǝ mǝrɓi Fonikiya, thla nech hahi Suriya. Shiyan kan Yesu kǝ chen tǝ ɓǝɓi shemet kesh fi waˈyan. <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />Nggǝrang kǝ Yesu su wa, “Malan wancha kǝ sǝm nda kǝ ngal ndǝ kwaɗǝn, kǝthlǝm kǝmwa si kǝ mǝkan fee ɗǝsǝmndi wancha yiɗcha wa.”<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />Tǝ kǝɗu, nggǝrang kǝ nuɗi suwa, “Aa, kǝɗuyu, Chinda, paɗaa chǝka yiɗcha thlǝ nechandǝ sǝm fishir tǝ ǝnɗi thlǝ nech hǝhataɗ kah mǝɗi wancha.”<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />Ndangkǝ Yesu wa, “Kǝthlǝm ngǝmǝn ɗi fǝrtu ya, ɗu kaɗi, pongngǝn hwaˈran maltǝ wannan ˈyo ha.<verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />Nggǝrang kǝ nuɗi in kaɗi, mbessankan waˈyan ɗuk ɗar mǝt hunata, hwaˈran paɗ chi kesh fiyan.<verse eid="MRK 7:30" /></para>
  <para style="s">Kǝnan Yesu tipeng kaɗi</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />Chek Yesu kesh ǝ thle Taya, parakan tǝ Sidon ɗǝkan kǝ Hawurtǝ Galili ǝ thle Dikafolis. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />Ə minni ɓang kǝ fee tǝpeng, thla thlǝ mbahǝn wakchǝ ndikta, shiyan kanda, kǝ tǝkantǝ her nafan fa. <verse eid="MRK 7:32" /><verse number="33" style="v" sid="MRK 7:33" />Kaɓ kǝ Yesu tǝpeng tǝɗi kǝ mǝɗi nawaktǝ nefsi, pakan wan harchiyan kǝ thlǝmechi nafan, chǝhakan yahta, tǝkankan her wanshenuˈti nafan fa. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />Thlaˈan kǝ Yesu indǝ kafǝrta kǝt kan yiptǝ, ndakana, “Iffata” (ndaˈan nech kǝ) “Inuha.”<verse eid="MRK 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 7:35" />Chat kǝɗuyu inkǝ thlǝmati tipeng tǝ ɗa hayu, ǝnɗi kǝnanchi wanshenuˈtiyan, kwaskan ha, nggak kan shenuˈtǝ ndiˈchan. <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />Kahankǝ Yesu thlǝmat ˈyanda mǝ mbuˈandǝ nefa wa. Nat tǝ ter tǝɗi nda ndǝn tanda wa mǝ mbuˈ nda wa, fen paɗ nakandǝ ɗǝt kǝ pang tǝ mbuˈ ǝnɗi sǝɓcha. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />Nafchaˈan ndiiɗ kandǝ tǝ saka inda, ndaka nda wa, “Chǝt chǝkami ndiˈchan. Mbahǝn tǝ ɗǝf tǝpeng kǝ ndika. Fee thlǝ sǝk wakchǝ mǝt paɗ, ɗǝf tǝ tandǝ kǝ sǝk nda.”<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">Sǝman Yesu ǝn nafchǝ aruˈ foɗɗa</para>
  <para style="r">(<ref loc="MAT 15:32-39">Mat 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />Ə hur wan minchiˈini, nggǝr kǝ nafchǝ nggom ndǝ terchan. Nakan ǝnsi nat ndǝ sǝm nda wa, ˈyak Yesu kǝmsichiyan, ndang kan tanda wa, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />“Nggomǝnɗiya tandǝ haɗitǝ fa, kǝthlǝm mǝndǝ mahkan tandǝ tǝ nggǝta, paɗ ǝnsi natndǝ sǝmnda wa. <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />Maa ǝ kallinchǝ tandǝ ha kǝ ɗǝ ndǝ kaɗi tǝ mita, fowuna naa fat wulandǝ tandǝ ɗar mbanda, kǝthlǝm fowun ɓechandǝ mǝt langnga.”<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />Nggǝmang kǝ kǝmsichiyan wa, “Nech fee mbǝs ɗǝsǝmǝnɗi nech nggallandǝ tertǝ nafchǝɗa hur chanjang ɗiya ayi?”<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />Chǝhan kan mee tanda wa, “Ɓilshet kurmi nessiyowun?” Nggǝrang kandǝs wa, “Muɗ.”<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />Ndang kan tertǝ nafchaˈan wa kǝ chok ndǝ ha kǝ haha. Tǝr kan ɓilsheɗi muɗ yu, chankan usoko Farta, chichenkan ha, chakan kan kǝmsichiyan kǝthlǝm kǝ fǝrandǝ nafchaˈan, fen paɗ chǝkandǝ kǝɗu. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />Wan yirǝf chiyandǝs ngguɗyeh. Chankan usoko Farta, ndang kan kǝmsichaˈan wa kǝ chakandǝ nafchaˈan paɗ. <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />Sǝm kǝ nafchaˈan, nggal kanda, ngomankandǝ takǝt fishirchaˈan, ndiiɗan tǝ inaftǝ muɗ. <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />Tertǝ nafchǝɗi sǝmchǝ ɗǝsǝmǝnɗi hǝssa aruˈ foɗɗa. Kalkan tandǝ ha. <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />Chat kǝɗuyu yim kan kǝ hur kombawal fen tǝ kǝmsichiyan pǝɗakandǝ kǝ thle Dalmanuta.<verse eid="MRK 8:10" /></para>
  <para style="s">Kaa wanɗǝ sǝnda</para>
  <para style="r">(<ref loc="MAT 12:38-42">Mat 12:38-42</ref>; <ref loc="MAT 16:1-4">16:1-4</ref>; <ref loc="LUK 12:54-56">Luk 12:54-56</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />Ɓak fowun Farisiyawecha kesh nggak kandǝ as indǝ tǝ Yesu. Nakandǝ chǝhan mee kǝ pǝnantǝ tandǝ wanɗǝ sǝnda ǝ hulafǝrta, kǝthlǝm kǝ kaɗa nda. <note caller="*" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="MAT 12:38">Mat 12:38</ref>; <ref loc="LUK 11:16">Luk 11:16</ref></char></note> <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />Kǝt kan yiptǝ tǝ alkǝta, ndakan wa, “Kǝthlǝm mii naa nafchi yuwa heshiɗiya kaa wanɗǝ sǝnda? Kittaˈan nati mbuˈowunda, nggǝ fee fǝr wanɗǝ sǝnda kǝ nafchi yuwa heshiɗiya wa.” <note caller="*" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 12:39">Mat 12:39</ref>; <ref loc="LUK 11:29">Luk 11:29</ref></char></note> <verse eid="MRK 8:12" /><verse number="13" style="v" sid="MRK 8:13" />Malkan tandǝ ha, nggǝr kan yim ndǝ kǝ hur kombawal, chenkan hawurtaˈan kǝ kǝ heshi thla.<verse eid="MRK 8:13" /></para>
  <para style="s">Yisti i Farisiyawecha tǝ yi Hiridus</para>
  <para style="r">(<ref loc="MAT 16:5-12">Mat 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />Nakan kǝmsichi Yesu mbǝtan kan tanda, ɓawandǝ tǝ njohǝma wa, njohǝm artǝ ndak nesiyanda hur kombawal taˈan. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />Kahan kǝ Yesu thlǝmechˈyanda, ndakan wa, “Mbǝranmsi tǝ yisti i Farisiyawecha tǝ yi Hiridus.” <note caller="*" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="LUK 12:1">Luk 12:1</ref></char></note> <verse eid="MRK 8:15" /><verse number="16" style="v" sid="MRK 8:16" />Nakandǝ chǝhandǝ raˈan, ndakanda wa, “Mbuˈchan kǝɗu kǝthlǝm kǝɗ ǝnɗi nawaktǝ njohǝm ˈyamǝn su wa?”<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />Yesu sǝntǝ ǝnɗi nat ndǝ kaɗata, chat ndang kan tanda wa, “Kǝthlǝm mii natwun naa chihandǝ raˈan wa njohǝm yowun su wa? Wathlowun wa ha paˈ kǝ nakan ya wa, paɗ sǝnwowun wa? Kǝthlǝm mǝ naa wanɗǝkaɗech ˈyowun kwaˈkwa? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />Wenitǝ yowunsi, nawowun mǝta wa? Thlǝmechˈyowunsi, sǝk wowun mǝtsǝ wa? Kuɗuk wowun ǝna wa wa? <note caller="*" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="JER 5:21">Irm 5:21</ref>; <ref loc="EZK 12:2">Eze 12:2</ref>; <ref loc="MRK 4:12">Mar 4:12</ref></char></note> <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />Kǝ chichenki ɓilsheɗi ɗǝrman yu kǝthlǝm nafchi aruˈ ɗǝrman, nggoman chowun fishir chaˈan inaftǝ kurmi?”</para>
  <para style="p" vid="MRK 8:19">Nggǝmang kanda wa, “Inaftǝ kum nggǝrsǝ chap.”<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />Nggǝr kǝ Yesu chihanda mee ndat wa, “Chichenki ɓilsheɗi ha muɗ yu kǝthlǝm nafchiɗi aruˈ foɗɗa, inaftǝ kurmi ngomandǝ wun fishir chaˈan?”</para>
  <para style="p" vid="MRK 8:20">Nggǝrkandǝs wa, “Inaftǝ muɗ.”<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />Ndang kan tanda wa, “Paˈya wathlowun wa ha wa?”<verse eid="MRK 8:21" /></para>
  <para style="s">Kǝnan Yesu komndǝ kaɗi ǝ Betseda</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />Ɓakandǝ kǝ mǝrɓi Betsaida, chat ɓak fee tǝ komnda, shiyan kanda kǝ tǝkantǝ her fa. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />Kǝskan heri komǝnɗi chekandǝ kesh kǝ kǝrsǝ wan mǝrɓan, chǝhangkan yahtǝ kǝ wenita, ɗǝfankan herˈyan kǝ in, chǝhangkan mee, “Thlǝ mbahǝncho naa ǝna wa?”<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />Thlaˈan kǝ komǝnɗi indǝ kafǝrta, nda kan wa, “Nggǝt naa nafchǝ kuɗa, paɗ nggǝt naa tandǝ kǝɗ ɗǝfcha, tandǝ wiˈta.”<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />Nggǝr kǝ Yesu ɗǝf herˈyan kǝ wenitaˈan ˈyan, inan kǝ nafan wenitaˈyan ha. Kǝnkǝ wenitaˈyan kaɗi, nakan chǝka mǝ ha ndiˈchan. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />Kalkan nafan ha kǝ pǝɗ kaɗi, ndang kana, “Kǝ ɓehǝn laa parat tǝ hur wan mǝrɓan wa.”<verse eid="MRK 8:26" /></para>
  <para style="s">Mbuˈ Biturus wa Yesu nech kǝ Kǝristi</para>
  <para style="r">(<ref loc="MAT 16:13-20">Mat 16:13-20</ref>; <ref loc="LUK 9:18-21">Luk 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />Chek Yesu kesh, pǝɗakan ndǝ tǝ kǝmsichiyan, yim kandǝ kǝ wan mǝrǝɓ chaˈan i mǝrǝɓ Kaisariya Filipi. Tandǝ ɗar mbanda, chǝhan kǝ Yesu kǝmsichiyan wa, “Thlǝ ndech nafchǝ wa wun naki?”<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />Nggǝman kanda wa thlǝ ndech fowun wa, “Chǝ Yohanna thlǝ chǝt baptisma. Fowun ndat wa chǝ Iliya thlǝ shenuˈtǝ tǝ yahti Farta. Paɗ fowun ndat wa arta hur fǝ shenuˈtǝ tǝ yahti Farta.” <verse eid="MRK 8:28" /><verse number="29" style="v" sid="MRK 8:29" />Chǝhangkan tanda wa, “Kun paɗ kǝni? Thlǝ ndechowun wa wun naki?” Nggǝmankǝ Biturus wa, “Chǝ nech kǝ Kǝristi.” <verse eid="MRK 8:29" /><verse number="30" style="v" sid="MRK 8:30" />Kahan kan thlǝmechˈyanda, mǝ mbuˈandǝ chǝka wun inɗiya wa.<verse eid="MRK 8:30" /></para>
  <para style="s">Mbuˈ Yesu weˈtǝ mǝrtǝɗi natǝn chǝta</para>
  <para style="r">(<ref loc="MAT 16:21-28">Mat 16:21-28</ref>; <ref loc="LUK 9:22-27">Luk 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />Ə farti ini, nggak kǝ Yesu chaˈandǝ tandǝ har tǝ ndat wa, Waˈi Nefa nwaat kǝ saa ɓahtǝ samǝn samǝn. Paɗ kǝ kar paktechǝ nafcha ndi, tǝ paktǝ pangngǝncha, ta fǝ chaˈandǝ kussiˈ i Musa kaɗi. Nandǝ ɓǝlanda, paɗ far mahkanan kǝ thlaˈ tǝ shishingnda.” <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />Ndiktǝɗiya mbuˈchan hayang. Kaɓ kǝ Biturus ndi kǝ kǝthlar, nakan yananda. <verse eid="MRK 8:32" /><verse number="33" style="v" sid="MRK 8:33" />Tǝɓǝr kan ha ɗǝpan kan takǝɗ kǝmsichiyan paɗ, yanan kan Biturus ha, ndangkan wa, “Nggǝran in kǝrsǝna Hweˈra, Kǝthlǝm tǝthl nen kaɗa ǝnɗi nech kǝ yi nafchǝ ngga yi Farta wa.”<verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />ˈYakan nggomnan tǝ kǝmsichiyan kə ɓandǝ nduk tǝ ndi, ndang kan tanda wa, “Nat thla nech paranenchi, nwaat kǝ kartǝ fatˈyan, kǝ tǝrtǝ palangndiyan kǝ paranenchi. <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />Nat thla yahchǝ kǝ hǝraˈantǝ shishingndiyan nan kuɓata, nat thla paɗ fǝrchǝ shishingndiyan kǝthlǝm nggǝta, tǝ kwastǝ ndiktǝɗiya yi sǝkta, nan hǝraˈandǝ shishingndiyan. <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />Mǝnan thlendi i nef kaɗi ma mbǝstǝ heshi nat, kǝ kuɓa shishingndiyan? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />Mǝ naa nef mbahǝn fǝrta kǝ ɓeɗa shishingndiyan? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />Nakan chǝk wun harandǝ fata kǝthlǝm nggǝta, tǝ ǝnɗi thlǝ chaˈandǝ kaɗi, hur sǝɓtǝ heshiɗiya yi kumi kaakǝta, tǝ ɓǝɓifat kaan. Paɗ naa fat harandǝ Waˈi Nefa kǝthlǝm kǝt ndi, fartǝɗi natǝn ɓat kaɗ hur maandi Chinan, tǝ fǝ thlǝnchiyan fee chiɗ chiɗ.”<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />Ndangkan tanda wa, “Kittaˈan, nati mbuˈowunnda, fowunsi kikit mǝɗiya nggandǝ mǝr kwaɗǝn wa, naa ndǝ naa kutǝrakti Farta ɓat tǝ alkǝtˈyan.”<verse eid="MRK 9:1" /></para>
  <para style="s">Nggǝr fati Yesu ha</para>
  <para style="r">(<ref loc="MAT 17:1-8">Mat 17:1-8</ref>; <ref loc="LUK 9:28-36">Luk 9:28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />Kǝrsǝ mǝndǝ mich cha, tǝrkǝ Yesu Biturus tǝ Yakubu tǝ Yohanna, tǝr kan ndǝ kǝ ɗar ngwela thla nech njang, fen ichǝt nanda mǝt arta. Ə ɓeɗek fati Yesu ha ǝ pangngǝn nanda, <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />chǝk kapatˈyan kaɗ heɗǝɗǝ kaan mǝthlan chǝmndǝ fa, thla nawaktǝ nef mbahǝn chapandǝ kaɗ kaa heɗǝɗaa hur heshiɗiya kǝɗ thla natǝn. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />Ɓak ndǝ Iliya tǝ Musa kǝmɗiyanda, nakandǝ ndiktǝ tǝ Yesu.<verse eid="MRK 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 9:5" />Ndang kǝ Biturus, Yesu wa, “Thlǝwira, keˈkesi nat mǝn mǝɗiya, naa ǝn tahǝs kuwurchǝ mahkan, arta kǝthlǝm cha, arta yi Iliya paɗ arta yi Musa.” <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />Sǝnwa ǝnɗi natǝn mbuˈta wa, kǝthlǝm pǝparindǝ ha kaan.<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />Ɓak husamba nggǝlandata, chek ɓǝratǝ kesh hur husambiˈan, nda kan wa, “Thleya Waˈinchi. Thla thlǝ mbǝndifaɗan kaan. Sǝkamndi.” <note caller="*" style="x"><char style="xo" closed="false">9:2-7 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2 Bit 1:17-18</ref></char></note><verse eid="MRK 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 9:8" />Chat nakandǝ ɗǝpat ha, nawandǝ nefa wa, nakan ndǝ Yesu ichiɗan thlǝmat nanda.<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />Kǝ nakandǝ ɓat kah ɗar ngwallan, kahan kǝ Yesu thlǝmech ˈyanda mǝ mbuˈa ndǝ nef ǝnɗi nat nda wa, maangga tǝ thlaˈan fee Waˈi Nefa ǝ mǝrtǝ kwaɗǝn wa.<verse eid="MRK 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10" />Kǝthlǝm ndaˈan kǝskandǝ ndiktaˈan har, nakandǝ chǝhandǝ raˈan wa, “Mǝ natǝn saktǝ tǝ thlaˈti mǝmatecha?”<verse eid="MRK 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 9:11" />Chǝhan kandǝ mee, nda ka nda wa, “Kǝthlǝm mǝ nda fǝ Chaˈandǝ Kusiˈchi kaɗ wa, naa Iliya ɓat kwaɗǝn kǝn Kǝristi ɓata?”<verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />Nggǝrang kan tandǝs wa, “Kittaˈan naa Iliya ɓat kwaɗǝn, kǝ nggǝranchǝ kaɗ kǝ nandǝ keˈke. Nggǝrkan chihandǝ tandǝ mee, kǝthlǝm mi yara ndǝ fee ha kǝ ɗar Waˈi Nefa wa nan saa ɓahtǝ samǝn samǝn, kǝ njiran fee kaɗi? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />Paɗaa nggǝt mbuˈowunda, tapi ɓi Iliya, paɗ chan nafchǝ ichiɗi yahtǝ nda, kǝɗ ǝnɗi yarandǝ fee ha hur Laulawati Farta kǝ ɗaran. <note caller="*" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="MAT 17:13">Mat 17:13</ref></char></note><verse eid="MRK 9:13" /></para>
  <para style="s">Kǝnan Yesu wa kaɗ tǝ hwaˈarchifa</para>
  <para style="r">(<ref loc="MAT 17:4-8">Mat 17:4-8</ref>; <ref loc="MRK 9:14-27">Mar 9:14-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />Kǝ ɓakandǝ kah kǝmɗi takǝɗ kǝmsichaˈan, nakandǝ nggomnan tauran ndǝ takǝɗ kǝmsichaˈan ha, nakandǝ fǝ Chaˈandǝ Kussiˈ i Musa kaɗ asˈinda tǝ tanda. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />Nat ngomnan, kǝ nakan ndǝ Yesu, sakandak indǝ kaan, rakaka ndǝ kǝmɗiyan kǝthlǝm kǝ ndandǝ ǝna.<verse eid="MRK 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 9:16" />Chǝhangkan tandǝ mee, “Mǝ natwun asˈinda tǝ tandǝ kǝ ɗaran?”<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />Yowun hur nggomnan nggǝman kan wa, “Thlǝ chaˈanan kaɗi, tǝ ɓuchi waˈinchi, thla naa ɓǝɓi shemet fiyan, njanchi shenuˈta. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />Nat fartǝɗi thlaˈandǝn, thlǝ nechan thlǝf anchi ha, huɓ kǝ meˈyan, nakan kang wan thlancha, paɗ thlǝ shingnganchan fatˈyan kaɗi. Shiyani kǝmsichiyo kǝm kǝ kǝtandǝ ɓǝɓi shemeɗan kesh, paɗ mbahǝn wanda wa.”<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />Nggǝmang kǝ Yesu tanda wa, “Aˈyowun, nafchi sǝɓtǝ heshiɗiya fǝ kumi fǝr kit. Kǝ kwat nati choktǝ tǝ wunchi? Kǝ kwat nati kǝriswunchi? Ɓamitǝn ndi.” <verse eid="MRK 9:19" /><verse number="20" style="v" sid="MRK 9:20" />Ɓakandǝ tǝ wannan kǝm ɗan.</para>
  <para style="p" vid="MRK 9:20">Kǝ nak shemeɗan Yesu, chat ɗǝfkan wanan ha nak fatˈyan rǝɓtǝ fa. Hǝm kan ha, nakan takǝrtǝ ha, nak meeˈyan huɓta. <verse eid="MRK 9:20" /><verse number="21" style="v" sid="MRK 9:21" />Chǝhankǝ Yesu chin wannan, nggak chǝ ǝnɗiya kwati?</para>
  <para style="p" vid="MRK 9:21">Nggǝman kan wa, “Kǝ natǝn kǝ waa. <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />Thlǝ nechan mǝk anchi kǝ wata, tǝ ema, kǝthlǝm kǝ ɓǝllanchi. Paɗaa maa no mbahǝn chǝt ǝna, kǝ haɗu chǝ ǝnfa, kǝssaˈansi.”<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />Ndaˈan nda Yesu wa, “Michich chǝhitu wa, ‘Ma no mbahanda’? Nat ichi paˈpaˈ kǝmɗi thla fǝrchi kit.”<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />Chat kǝɗuyu, thlaˈankǝ chin wannan ɓǝrata tǝ alkǝta ndakan wa, “Fǝrinchi kit, kǝsisi chekan fǝr kit inchi.”<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />Kǝ nak Yesu nafchǝ chekta kǝmɗiyanda, yanan kan ɓǝɓi shemeɗan ha, ndang kana, “Shemeta thla thlǝ njanchǝ wanɗiya shenuˈta tǝ sǝkta, nduchi wa ɓo kesh fiyan, mǝ nggirin yimndǝ kafˈyan wa.”<verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />Hwak shemeɗan, nakan saktat fǝ kaan, chekan kesh fǝ wannan. Wanan ɗuk haha kǝɗ tǝ mǝra, nak nafchǝ terchan ndat wa, “Ə miri.” <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />Paɗaa kǝskǝ Yesu heri wannan, thlaˈan kan, mǝthlan paɗ thlarkan kit.<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />Kǝrsǝ nggǝrandi Yesu in kaɗ kyeuri, chǝhankǝ kǝmsichiyan mee ǝ wuɓta, ndang kanda wa, “Kǝthlǝm mǝ mbahǝn waktǝ ǝn chendǝ ɓǝɓi shemeɗan kesh?”<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />Ndang kan tanda wa, “Ɓǝɓi shemet kǝɗ thleya, chewa ndǝ kesh kǝɗu wa, mangga shenuˈtǝ tǝ Farta wa.”<verse eid="MRK 9:29" /></para>
  <para style="s">Nggǝr Yesu ndiktǝ kǝ ɗar mǝrtiyan</para>
  <para style="r">(<ref loc="MAT 17:22-23">Mat 17:22-23</ref>; <ref loc="LUK 9:43-45">Luk 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />Chek Yesu kesh tǝ kǝmsichiyan minni, para kandǝ tǝ thle Galili. Yahwa kǝ sǝn nafcha wa tandǝ minni wa, <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />kǝthlǝm thlǝ chaˈanchan kǝmsichiyan har tǝ ndat wa, “Naa fee fǝr Waˈi nefa kǝ hari nafcha. Nandǝ ɓǝlanda. Kǝrsǝ mǝndǝ mahkan nan thlaˈtǝ paɗ.” <verse eid="MRK 9:31" /><verse number="32" style="v" sid="MRK 9:32" />Paɗaa sǝn wandǝ ǝnɗi natǝn mbuˈta wa, nakandǝ lekǝt chǝhan mee.<verse eid="MRK 9:32" /></para>
  <para style="s">Wun nech manchan kaan?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Mat 18:1-5</ref>; <ref loc="LUK 9:46-48">Luk 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />Yesu tǝ kǝmsichiyan ɓakandǝ kǝ Kafarnahum. Kǝ yim kǝ Yesu kyeuri, chǝhan kan kǝmsichiyan tǝ ndat wa, “Kǝ ɗar mǝ natwun asˈindǝ mbanda?”<verse eid="MRK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34" />Paɗaa nggas kandǝ ɓaˈ kǝthlǝm hur mbanda tandǝ asˈin ndǝ tǝ ndat wa wun nech manchan kaan. <note caller="*" style="x"><char style="xo" closed="false">9:34 </char><char style="xt" closed="false"><ref loc="LUK 22:4">Luk 22:4</ref></char></note> <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" />Chok kǝ Yesu ha, ˈyakan fee kum nggǝrsǝ chap yu, ndang kan tanda wa, “Nat thla yah chǝ kǝn manchan, nwaat kǝ chok tǝ maan inda wa, kǝ chok kǝ thla nech ngguɗyeh. Kǝ chok kǝ mafati chǝka wun paɗ.” <note caller="*" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 20:26-27">Mat 20:26-27</ref>; <ref loc="MAT 23:11">Mat 23:11</ref>; <ref loc="MRK 10:43-44">Mar 10:43-44</ref>; <ref loc="LUK 22:26">Luk 22:26</ref></char></note><verse eid="MRK 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 9:36" />Chat tǝrkan wan waa thlaran kan ha kǝ hur ɗǝfi tǝ nanda. Kǝs kan heri wanan har, ndang kan tanda wa, <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />“Nat thla thlich wan waa kǝɗ thleya kǝthlǝm thlǝm na, nggǝt thlǝtǝn, thla thlich nenchi paɗ, ngga nggǝt thlǝtǝn wa, thla thlinchi nenchi thlǝtǝn.” <note caller="*" style="x"><char style="xo" closed="false">9:37 </char><char style="xt" closed="false"><ref loc="MAT 10:40">Mat 10:40</ref>; <ref loc="LUK 10:16">Luk 10:16</ref>; <ref loc="JHN 13:20">Yoh 13:20</ref></char></note><verse eid="MRK 9:37" /></para>
  <para style="s">Thla nawakchǝ kǝ Atekǝritǝmǝn, yimǝn</para>
  <para style="r">(<ref loc="LUK 9:49-50">Luk 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />Ndang kǝ Yohanna, Yesu wa, “Thlǝ chaˈanan kaɗi, ni ǝn nefa kǝtandǝ hwaˈarchi kesh hur thlǝm wa, njankaˈan paɗ, kǝthlǝm mǝthlan artǝ hur ǝn wa.”<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />Paɗaa ndak Yesu wa, “Kǝ ˈyata wun wa, kǝthlǝm nefsi nech mbahǝn chǝt ǝna saka inda hur thlǝm na, kǝ nggǝr tǝ mbuˈ sǝɓtǝ ǝn kǝ indinchǝ wa. <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />Kǝthlǝm nat thla nawakchǝ kǝ atǝkretǝmǝn, yimǝn ni. <note caller="*" style="x"><char style="xo" closed="false">9:40 </char><char style="xt" closed="false"><ref loc="MAT 12:30">Mat 12:30</ref>; <ref loc="LUK 11:23">Luk 11:23</ref></char></note> <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />Nggǝt mbuˈowun kittaˈan, nat thla fǝrowun chi ˈyam sata chǝka hur tǝɓ saa ema hur thlǝmna, kittaˈan nati mbuˈowunda, nggech kuɓa titiyan chǝka ngguɗyeh wa.” <note caller="*" style="x"><char style="xo" closed="false">9:41 </char><char style="xt" closed="false"><ref loc="MAT 10:42">Mat 10:42</ref></char></note><verse eid="MRK 9:41" /></para>
  <para style="s">Əchiɗi thlǝ ɗǝfchǝ nef kǝ chǝt ɓǝɓifata</para>
  <para style="r">(<ref loc="MAT 18:6-9">Mat 18:6-9</ref>; <ref loc="LUK 17:1-2">Luk 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />“Maa ɗǝf yowun arta hur wan wanchiɗiya, fee fǝrchi kit kǝmɗinchi kǝ chǝ ndǝ ɓǝɓifata. Ɓahtǝɗi natǝn sata, kwech chan kǝ kǝnan fee ɗakwan fǝn haˈta kǝ ɓǝrata, kǝ mǝk fee ndi kǝ hur hawurta. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />Ma thlǝ ɗǝfchǝ herˈyo wechi kǝ chin ɓǝɓifata, kwech chan kǝ thleen kaɗi. Nan nat ndiˈchan kǝ yimin kǝ shishingnda kǝ kwekǝchi tǝ her arta, mǝni yim ndǝ kǝ hur wata tǝ harchi chap. Waɗan ɓǝlawu fee wa, <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />[ǝ minni paɗ waˈchiɗi nech kangnga ndǝ tanda mǝrwa nda wa, waɗan paɗ nggǝ fee mbahǝn lifanchi wa.] <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />Maa thlǝ ɗǝfchǝ sartiyo wech kǝ chin ɓǝɓifata, thlen ko kaɗi. Kwech chan kǝ yimin kǝ hur shishingnda kǝ kwekǝchi tǝ sartǝ arta, mǝni kǝ mǝk fee wech kǝ hur wata tǝ sarchi chap.” <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />[ǝ minni paɗ waˈchiɗi nech kangnga ndǝ tanda mǝrwa nda wa, waɗan paɗ nggǝ fee mbahǝn lifanchi wa.] <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />Ma naa wenitiyo ɗǝf wech kǝ chin ɓǝɓifata, huhlanko kaɗi. Kwech chan yimndu kǝ hur kutǝrakti Farta tǝ wenitǝ arta, mǝni kǝ mǝk fee wech kǝ wata, tǝ wenichiyo chap.<note caller="*" style="x"><char style="xo" closed="false">9:47 </char><char style="xt" closed="false"><ref loc="MAT 5:29">Mat 5:29</ref></char></note> <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />Ə minni,</para>
  <para style="b" vid="MRK 9:48" />
  <para style="q1" vid="MRK 9:48">“ ‘Waˈchiɗi nech kangnga ndǝ tanda mǝrwa nda wa.</para>
  <para style="q2" vid="MRK 9:48">waɗan paɗ nggǝ fee mbahǝn lifanchi wa.’ ” <note caller="*" style="x"><char style="xo" closed="false">9:48 </char><char style="xt" closed="false"><ref loc="ISA 66:24">Ish 66:24</ref></char></note><verse eid="MRK 9:48" /></para>
  <para style="b" />
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49" />“Na fee hilengnga ndǝ chǝka wuni kǝn chiɗ chiɗ tǝ wata, kǝɗ thla thle chapandǝ fee ɗǝsǝm ndǝ kaɗ tǝ fisha. <note caller="*" style="x"><char style="xo" closed="false">9:49 </char><char style="xt" closed="false"><ref loc="LEV 2:13">Lfr 2:13</ref></char></note><verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />“Fisha ǝna thla nech ndiˈchan, paɗaa maa tapi tǝr mbǝnan kaɗi, tǝ mǝ naa fee nggǝrandǝ mbǝnan kaɗi? Chokam tǝ mbǝndi fish fǝ pǝthlǝrwun, kǝthlǝm kǝ chok wun has has tǝ raˈan.” <note caller="*" style="x"><char style="xo" closed="false">9:50 </char><char style="xt" closed="false"><ref loc="MAT 5:13">Mat 5:13</ref>; <ref loc="LUK 14:34-35">Luk 14:34-35</ref></char></note><verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">Chaˈan Yesu kaɗi kǝ ɓǝra chak reta</para>
  <para style="r">(<ref loc="MAT 19:1-12">Mat 19:1-12</ref>; <ref loc="LUK 16:18">Luk 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />Malkǝ Yesu minni ha, pǝɗakan kǝ thle Yahuda, chenkan kufi Urdun. Nggǝr kǝ nafchi terchan ngom ndǝ kǝmɗiyan. Mǝthlan paɗ chaˈan kan tandǝ har kǝɗ ǝnɗi sǝdǝn ha. <verse eid="MRK 10:1" /><verse number="2" style="v" sid="MRK 10:2" />Fowun Farisiyawecha ɓakandǝ kǝmɗiyan kǝthlǝm kǝ kaɗa nda, chǝhan kandǝ mee ndang kan nda wa, “Kǝ ɓǝra kusiˈ i Musa, kǝmsi kǝ kal nef nuwan ha wa?<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />Nggǝrang kǝ Yesu tandǝs wa, “Mǝ mbuˈowundǝ Musa wa kǝ chǝwun?” <note caller="*" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">Msh 24:1-4</ref>; <ref loc="MAT 5:31">Mat 5:31</ref></char></note><verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />Ndang kanda wa, “Kalaˈanchǝ Musa wa naa nef mbahǝn fǝran ɗelwer nuwan yi chaktǝ ha, kǝ pǝɗa.”<verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />Ndang kǝ Yesu tanda wa, “Kǝthlǝm kwaˈkwa tǝ inchiyowun ɗǝf chi Musa kǝ yarowunchǝ kusiˈ tǝ ini sǝ kǝɗuyu. <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />Paɗ ǝ tǝrkwathl kan tǝn icha, tahǝschǝ Farta nafcha hǝsh nefa tǝ nunefa. <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />Kǝthlǝm ndaˈan, nefa nan mal chinan ha tǝ manan, kǝ chok ndǝ ɓukwaˈ tǝ nuwan, <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />fen chap paɗ naa ndǝ choktǝ kǝ fat arta. Kǝthlǝm ndaˈan, peˈ wandǝ choktǝ chap wa, paɗaa nef arta. <note caller="*" style="x"><char style="xo" closed="false">10:7-8 </char><char style="xt" closed="false"><ref loc="GEN 2:24">Far 2:24</ref></char></note> <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />Kǝthlǝm ndaˈan, nat ǝnɗi wumandǝ Farta, mǝ chakan nef ha wa.”<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />Kǝ yim kǝ Yesu kyeuri, nggǝr kǝ kǝmsichayan chǝhan mee kǝ ɗar ndiktaˈan. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />Ndang kan tanda wa, “Nat thla kalchi nuwan ha, kah kan yowun samǝn, chen tǝ ɗǝf miɗi chǝtǝn tǝ thla kartǝn, ǝ chǝt fǝlaukǝta. <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />Kǝɗu paɗ maa ǝ kar nu nef chimaɗan pǝɗakan kani yowun samǝn, chǝt fǝlaukǝta.” <note caller="*" style="x"><char style="xo" closed="false">10:11-12 </char><char style="xt" closed="false"><ref loc="MAT 5:32">Mat 5:32</ref>; <ref loc="1CO 7:10-11">1 Kor 7:10-11</ref></char></note><verse eid="MRK 10:12" /></para>
  <para style="s">Ɗǝfan Yesu wan wanchǝ mbǝs ǝn har kǝ in</para>
  <para style="r">(<ref loc="MAT 19:13-15">Mat 19:13-15</ref>; <ref loc="LUK 18:15-17">Luk 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />Nak nafchi ɓat tǝ wan wancha kǝmɗi Yesu kǝthlǝm kǝ ɗǝfandech mbǝsˈǝn har kǝ in. Paɗaa nak kǝmsichiyan yana ndǝ nafchaˈan. <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />Paɗ kǝ nak Yesu kǝɗuyu, sǝɓkǝ hwirˈyan kaɗi, ndang kan kǝmsichiyan wa, “Malaman wan wancha kǝ ɓandǝ kǝmɗin chi, kǝ ˈyatawun tanda wa. Kǝthlǝm kuturakti Farta yi weˈtǝ naa nda. <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />Kittaˈan nati mbuˈowun nda, nat thla thlǝwakchǝ kuturakti Farta kǝɗ thla thlǝ chǝt wan waa, nee yim kǝ mandǝ hulafǝrta wa.” <note caller="*" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 18:3">Mat 18:3</ref></char></note> <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />Nggǝthl kǝ Yesu wan waanchaˈan kǝ kǝfatˈyan, ɗǝfan kan tandǝ her kǝ inda, ɗǝfan kan tandǝ mbǝs ǝn kǝ in.<verse eid="MRK 10:16" /></para>
  <para style="s">Kimshaa thla naa kǝnau ˈyansi</para>
  <para style="r">(<ref loc="MAT 19:16-30">Mat 19:16-30</ref>; <ref loc="LUK 18:18-30">Luk 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />Kǝ thlaˈkǝ Yesu kǝthlǝm kǝ maltǝ mǝɗan ha, chat ɓak yowun nef tǝ rakat kǝmɗiyan, chamkan kuruminchǝ ha pangngǝn nan, chǝhan kan mee, “Kaa thlǝ chaˈandǝ nafchi har, mǝnati chǝta kǝni mbǝs shishingnda kǝ kwekichi?”<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />Ndang kǝ Yesu wa, “Kǝthlǝm mǝ ˈyatu nenchǝ wa kaa nefa? Nefsi nech kǝ kaa nefa wa, mangga Farta ndak wa. <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />Shinin kusiˈ chaˈan, ‘Kǝ ɓilin fata wa. Kǝ chin fǝlaukǝta wa. Kǝ yerkǝn wa. Mǝ lekǝn kǝ ɓǝra ǝnɗi sǝnwaktu wa. Kǝ pupukin nef har wa. Fǝran maandǝ chu tǝ mu.’” <note caller="*" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">Fit 20:12-16</ref>; <ref loc="DEU 5:16-21">Msh 5:16-21</ref></char></note><verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />Ndangkǝ nafan wa, “Thlǝ chaˈanan kaɗi thlǝ nechi thlǝnandǝ ichi inni thlaˈtǝ fartǝɗi peˈtǝ kǝ kimshaa.”<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />Ɗǝpang kǝ Yesu ɗǝmba kafata, ndang kan wa, “Ən arta ndak takucha. Ɗu hiyan ichiyo kaɗ nat, kǝ chekeen fǝ ɓahcha kǝnawan, no mbǝs wurmakta ǝ hulafǝrta. Kǝrsaɗan kǝno ɓat paranenchi.”<verse eid="MRK 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 10:22" />Kǝ sǝkkan kǝɗuyu mbinawu ndiktaˈan wa, pǝɗakan kaɗi tǝ sǝɓtǝ hwira, kǝthlǝm wurumndǝ nakan kaan.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />Ɗǝpang kǝ Yesu kǝmsichiyan ndangkan tanda wa, “Nan nat ˈYangˈyang wurumincha kǝ yimndǝ kǝ kuturakti Farta.”<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />Kǝmsichiyan saka ndak indǝ tǝ ndiktaˈan. Chat nggǝr kǝ Yesu nda ndǝ tanda wa, “Wanchinchi, nan nat ˈyangˈyang kǝ yim nef kǝ kuturakti Farta. <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />Nan nat paˈpa fii nggelupa kǝ yim tǝ kwi lipira mǝni wurumnda kǝ yim kǝ kutǝrakti Farta.”<verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />Ke sǝkkǝ kǝmsichiyan ndiktaˈan nggǝr indǝ sakandata, ndang kandǝ raˈan wa, “Maa kǝɗu wun nech hǝraˈtǝ hacha?”<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />Ɗǝpang kǝ Yesu tanda, ndang kan tanda wa, “Mǝɗi nafcha nech chǝ kǝɗu wa, nan nat paˈpa mǝɗi Farta. Kǝthlǝm, ichi nat paˈpa mǝɗi Farta.”<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />Ndang kǝ Biturus, Yesu wa, “Mal ǝn chǝka mǝ ha nat, pariˈǝn wechi”<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />Nggǝrangkǝ Yesu su wa, “Kittaˈan nati mbuˈowunda, yowunsi nech mal wirˈyan ha, ndu wanmanchaˈan, ndu chinan, ndu manan, ndu wanchiyan, ndu hǝngechiyan, kǝthlǝm nggǝt tǝ kwastǝ ndiktǝɗiya yi sǝkta. <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />Ənɗi natǝn mbǝsta hur heshiɗiya, nan pǝɗandǝ kurɓandǝ kum chǝt kum arta ha, yi wurcha, tǝ wanmanchǝ kǝ hǝssa, tǝ wanmancha kǝ nǝssa, tǝ mancha, tǝ wancha, tǝ hǝnngngecha, paɗ tǝ nggwarkwana. Kǝrsǝ ndaˈan hur heshiɗi nech ɓata nan mbǝs shishingnda kǝ kwekǝɗan. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />Hur tertǝ nafchiɗi nech pang nakanya, nandǝ chok tǝ kǝ fee nech kǝrsǝn. Tǝ kǝɗu, hur tertǝ nafchiɗi nech kǝrsǝn nakanya, nandǝ chok tǝ ǝ pangnga.”<verse eid="MRK 10:31" /></para>
  <para style="s">Nggǝr Yesu ndiktǝ kǝ ɗar mǝrtǝyan</para>
  <para style="r">(<ref loc="MAT 20:17-19">Mat 20:17-19</ref>; <ref loc="LUK 18:31-34">Luk 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />Nakandǝ pǝɗat kafǝr kǝ Urshelima, Yesu wiˈtǝ ǝ pangngǝn nanda, kǝmsichiyan paɗ sakandech inda. Fee nech parandi kǝrsa paɗ tandǝ lekǝta. Kaɓ kǝ Yesu fee kum nggǝrsǝ chap yu kǝ kǝlar, nggǝr kan mbuˈandǝ tandǝ ǝnɗi nech sǝɓtǝ tǝ ndi. <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />Ndakan wa, “Namǝn kafǝr kǝ Urshelima. Naa fee fǝr Waˈi Nefa kǝ hari paktǝ pangngǝncha, tǝ fǝ chaˈandǝ kussiˈchi kaɗi. Nandǝ chakan mi mǝrta, kǝ ɓǝlan fee, kǝ fǝrndǝ anchi paɗ kǝmɗi nafchiɗi nggawakchi kǝ Yahudawecha. <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />Nandǝ chan tehletu, tǝ chǝhan yahtǝ kafa, nandǝ thlǝfanda, kǝ ɓǝlandǝ paɗ. Kǝrsǝ mǝndǝ mahkan nan thlaˈta tǝ shishingnda.”<verse eid="MRK 10:34" /></para>
  <para style="s">Shiti Yakubu tǝ Yohanna</para>
  <para style="r">(<ref loc="MAT 20:20-28">Mat 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />Ɓak Yakubu tǝ Yohanna, wanchi Zabadi, kǝmɗiyan. Ndang kan nda wa, “Thlǝ chaˈandǝ nafchi har, yah ǝn si kǝ cheˈǝnchin ǝnɗi shiyutǝ ǝn nat.”<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />Chǝhangkan tanda wa, “Mǝ yahtǝ wunsi kǝ chowunchi?”<verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />Ndaka nda wa, “Fartǝ maandi kutǝraktiyo, nggǝmu fa kǝ chok artǝ hurˈǝn tǝ harsǝm ˈyo, artǝ paɗ tǝ kaku ˈyo.”<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />Nggǝrang kǝ Yesu tandǝs wa, “Sǝn wowun ǝnɗi natwun shita wa. Nowun mbahǝn sa wankonga ɓahtǝɗi ha nati sata wa? Ndu kǝ chowunchi fee weˈtǝ baptisma tǝɗi na fee chita wa?” <note caller="*" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="LUK 12:50">Luk 12:50</ref></char></note><verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />Nggǝr kandǝs wa, “Aa naˈan mbahǝnda.”</para>
  <para style="p" vid="MRK 10:39">Ndang kǝ Yesu tanda wa, “Nowun sa tǝɓsaˈyam ɓahtǝɗi nati sata, paɗ kǝ chowunchi fee baptisma tǝɗi naa fee chita. <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />Paɗaa ngga nggǝt nech tǝ alkǝt fǝr chokta tǝ harsǝm ndu kaku inchi wa. Michaˈan tahsanchi fee ha kǝthlǝm fee tahsandǝ fee ha kǝ tanda.”<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />Kǝ sǝkkǝ takǝɗ kǝmsichiɗi kum yu kǝɗuyu, sǝɓankandǝ hwir kaɗ tǝ Yakubu tǝ Yohanna.<verse eid="MRK 10:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 10:42" />ˈYak Yesu kǝmsichiyan kǝ mǝt arta nat, ndakan wa, “Sǝnwun wa mǝɗi fee nawakchi kǝ Yahudawecha, fee nech kǝ kuturcha, thlǝ pǝnanchandǝ nafchiyanda alkǝta. Paktechaˈan ˈyandǝ paɗ thlǝ pǝnan chandǝ nafchiyandǝ pongngǝn alkǝt paɗ. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />Paɗaa ngga nechan nat kǝɗu pǝthlǝrwun wa. Paɗ nat thla yahchi kǝn manchan hurwun, nwaat kǝ chǝt tar mafakǝta kǝ takichaˈan. <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />Paɗ nat thla yahchǝ kǝ chok kǝ pangndǝ yowun, nwaat kǝn kǝ mafati chǝka wuni. <note caller="*" style="x"><char style="xo" closed="false">10:42-43 </char><char style="xt" closed="false"><ref loc="LUK 22:25-26">Luk 22:25-26</ref></char></note> <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />Kǝthlǝm chǝka Waˈi Nefa, ngga ɓechan kǝthlǝm kǝ chan fee tar mafa kǝta wa. Paɗ ɓechan kǝthlǝm kǝ chan tǝ nafchǝ tar mafa kǝta, kǝ fǝr tǝ shishingndiyan kǝthlǝm kǝ pǝltǝ nafchi terchan hur ɓǝɓifechˈyanda.”<verse eid="MRK 10:45" /></para>
  <para style="s">Kǝnan Yesu komndǝ kaɗi thlǝ ˈya fee wa Bartimawus</para>
  <para style="r">(<ref loc="MAT 20:29-34">Mat 20:29-34</ref>; <ref loc="LUK 18:35-43">Luk 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />Ɓakandǝ kǝ Yeriko. Nak Yesu tǝ kǝmsichiyan tǝ takǝt nafchi chet kesh mǝrɓan, komndǝs ɗas ǝ kǝlaar mbanda, mǝthlan shita. Thlǝman wa Bartimawus (waˈi Timawus.) <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />Kǝ sǝkkan wa Yesu thlǝ Nazarat nech ɓǝrtǝ ha, chat kǝɗu thlaˈankan ɓǝrata ndakana, “Yesu, Waˈi Dauda, kǝ haɗuchifa.”<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />Nak fowun nafchǝ terchan yana ndǝ ha, ndat wa kǝ nggas ɓaˈ. Thlat tǝ kǝɗu nakan chekandǝ thlaˈa ndǝ ɓǝrata tǝ alkǝta, ndat wa, “Waˈi Dauda, kǝ haɗuchifa.”<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />Thlarkǝ Yesu ha, ndang kan tanda wa, “ˈYamndi.”</para>
  <para style="p" vid="MRK 10:49">Ndang kandǝ komnan wa, “Mbunufata, thlaˈu, mǝthlan ˈyawechi.”<verse eid="MRK 10:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 10:50" />Chat mǝkan kan ǝna chiptiyan kaɗi, thlaˈkan tǝ weshet fa, ɓakan kǝmɗi Yesu.<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />Chǝhan kǝ Yesu mee, “Mǝ yah tusi kǝ chuchi?”</para>
  <para style="p" vid="MRK 10:51">Ndang kǝ komnan wa, “Thlǝ Chaˈanan kaɗi, kǝ mbǝssi naa mǝta.”<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />Ndang kǝ Yesu wa, “Ɗu, fǝr kitˈyo ǝ kǝnuchi kaɗi.”</para>
  <para style="p" vid="MRK 10:52">Chat kǝɗuyu mbǝstǝ naa mǝta, parakan Yesu pǝɗa kanda.<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">Yim Yesu kǝ Urshelima</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mat 21:1-11</ref>; <ref loc="LUK 19:28-40">Luk 19:28-40</ref>; <ref loc="JHN 12:12-19">Yoh 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />Kǝ saˈkandǝ nduk tǝ Urshelima. Tandǝ nduk tǝ Betafaji tǝ Betani ǝ kǝlaar ngwalɗi thlǝ ˈyafewa Zaitun. Thlǝnkǝ Yesu kǝmsichiyan chap, <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />ndang kan tanda wa, “Ɗam kǝ wan mǝrǝɓɗi pangngǝn wunya, paɗ maa nggǝwun yimnɗǝsi, nowun mbǝsandǝ wan kwaari sǝ thlang ǝ minni, thla tamwak tǝ nef pǝrtǝsi. Kǝ kwasawun ha kǝ ɓowun taˈanchi kǝmɗiya. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />Maa ǝ chǝhowunchǝ yowun na, ‘Mǝ chich nat wun kwasandǝ ha?’ Ndankowun wa, ‘Thlǝwiryaˈan yahcha tǝ paɗ nan thlǝndǝ kaɗ chat chat ya.’”<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />Ɗǝchan ndǝ ɓǝssandǝ wan kwaari taˈan kǝnan fee ha mii mbeya, nduk tǝ kǝlaar mbanda. Nakandǝ kwasandǝ wan kwaari taˈan ha, <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />fowun nafchǝs kit kit minni chǝhan kandǝ mee tanda, “Mǝ nat wun chǝta natwun kwasandǝ wan kwaari taˈan ha?”<verse eid="MRK 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 11:6" />Mbuˈan kandǝ tanda ǝnɗi mbuˈandǝ Yesu tanda. Minni malangkǝ nafchaˈan tanda. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />Ɓakandǝ tǝ wan kwaari taˈan kǝmɗi Yesu, tǝr kandǝ ǝna chiptiyanda chip kandǝ kǝ ɗar wan kwaari taˈan, tǝ paɗ tǝr kǝ Yesu kǝ ɗaran chokkansi. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />Nafchi terchan chip ǝna chiptiyandǝ ha kǝ hur mbanan, fowun paɗ chichekandǝ saˈchǝ ǝ hǝngga nakandǝ sǝt ha hur mbanan. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />Fee nech pangnga tǝ fee nech kǝrsaˈan nakandǝ thlaˈandǝ ɓǝrata tǝ ndat wa,</para>
  <para style="q1" vid="MRK 11:9">“Hossana.</para>
  <para style="q1" vid="MRK 11:9">Thlǝ mbǝs ǝnhar thla nech ɓata hur thlǝm Chinda.<verse eid="MRK 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10" />Mbǝs ǝnsi har kǝ ɓǝra kutǝraktiɗi nech ɓata yi chinmǝn Dauda.</para>
  <para style="q1" vid="MRK 11:10">Hossana kǝmɗi Farta hulafǝrta.” <note caller="*" style="x"><char style="xo" closed="false">11:10 </char><char style="xt" closed="false"><ref loc="2SA 7:11-14">2 Sam 7:11-14</ref></char></note><verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />Yimkan kǝ hur Urshelima, ɗǝkan kǝ Wiri Farta. Wiˈkan ha, ɗǝpang kan ichaˈan nat. Paɗ nakan fartǝ nduk hǝmnda, chekan kesh tǝ kǝmsichiyan kum nggǝrsǝ chap pǝɗa kandǝ kǝ Betani.<verse eid="MRK 11:11" /></para>
  <para style="s">Ndan Yesu ɗeftǝ shukwata wa no nata</para>
  <para style="r">(<ref loc="MAT 21:18-19">Mat 21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />Əssaɗan kǝ nakan ndǝ mal Betani ha, nak mitǝ fi Yesu. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />Nakan ɗǝftǝ shukwata langnga tǝ saˈchǝ ndiˈchan, ɗǝkan ɗǝpanda ndu nan mbǝs wan ɗǝftaˈan ɗaran. Kǝ saˈkan, mbǝs wa wanan wa saˈchi ndak, kǝthlǝm ngga fartǝ nggǝttǝyan wa. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />Ndang kan ɗǝftaˈan wa, “Mǝ nggǝr yowun kan wan chiyo paɗ wa.” Paɗ sǝkkǝ kǝmsichiyan ǝnɗi mbuˈtǝn.<verse eid="MRK 11:14" /></para>
  <para style="s">Rǝkan Yesu nafchǝ kesh Wiri Farta</para>
  <para style="r">(<ref loc="MAT 21:12-17">Mat 21:12-17</ref>; <ref loc="LUK 19:45-48">Luk 19:45-48</ref>; <ref loc="JHN 2:13-22">Yoh 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />Kǝ saˈkandǝ kǝ Urshelima, yim kǝ Yesu kǝ hur Wiri Farta, ngakkan rǝkandǝ nafchǝ kesh fee nech hiyandǝ ichi kaɗi tǝ fee nech hita. Nakan pǝpakandǝ tebǝr i fee nech mbeɗa wanɗǝɓǝthl kaɗi tǝ mǝt chokchi fee nech hiyandǝ ɗiikuturchǝ kaɗi. <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />Nggǝma wa nef kǝ tǝrtǝ ǝna hiyandiyan kaɗi kǝ mbǝrha tǝ mǝt Wiri Farta wa. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />Nakan chaˈandǝ tandǝ har, ndang kan tanda wa “Nechan kǝ yaranɗan hur Laulawati Farta wa,</para>
  <para style="b" vid="MRK 11:17" />
  <para style="q1" vid="MRK 11:17">‘Nech fee ˈya wirinchi wa, mǝta thla naa nafchǝ nat ɓata michi samǝn samǝn kǝ shenuˈndǝ tǝ Farta?’</para>
  <para style="q2" vid="MRK 11:17">Paɗaa nggun changkowun kaɗ kǝ mǝt ngomndi fǝ thlar mbancha.”<verse eid="MRK 11:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />Kǝ sǝk kandǝ kǝɗuyu, paktǝ pangngǝnchaˈan, tǝ fǝ chaˈanchǝ kusi i Musa kaɗi, ngakkandǝ kaa mbanɗi nat ndǝ mbǝlanda. Tandǝ kwaranda, kǝthlǝm nggomnan nat sakan indǝ tandǝ tǝ chaˈaɗan ˈyan.<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />Chǝk yen farwita, Yesu tǝ kǝmshichiyan thlǝ chechandǝ kesh hur mǝrɓan.<verse eid="MRK 11:19" /></para>
  <para style="s">Ɗǝftǝ shukwaɗi hwarchǝ kaɗi</para>
  <para style="r">(<ref loc="MAT 21:20-22">Mat 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />Walwurtaˈan nakandǝ mbǝrtǝ ha, nakandǝ ɗǝftǝ shukwaɗan hwerkaɗ thlaˈtǝ thlarchiyan kǝ wan harchiyan. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />Kuɗuk kǝ Biturus ǝnɗi nda ndǝ Yesu, dǝftǝ shukwaɗan, ndang kan wa, “Thlǝ chaˈanan kaɗi, ɗǝpa ndǝn ɗǝftǝ shukwaɗi ndaa ndu wa no natyu, hwerkaɗi.”<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />Nggǝmang kǝ Yesu wa, “Fǝram kit kǝ Farta,” <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />Kittaˈan nati mbuowunda, maa naa yowun mbahǝn nda ndǝ nggwalɗiya wa, ‘Ɗu, mǝku fatˈyo kǝ hur hawurta,’ paɗ aswa indǝ hur wanɗǝkaɗatˈyan wa, fǝr kan kitsi tǝ ndat wa ǝnɗi mbuˈtǝn nan chok tǝ kǝɗu, nechan nat kǝɗu paɗ. <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />Kǝthlǝm ndaˈan nggǝt mbuˈowunda, nat ǝnɗi shitǝwun hur shenuˈtǝ tǝ Farta, kǝ fǝrwun kitsi wa mbǝswun, nechan nat kǝ yuwun paɗ. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />Maa thlar wun ha nowun shenuˈtǝ tǝ Farta, maa yowunsi hur wanɗǝkaɗatˈyowun, kalam ndǝ ha. Maˈna Chinwun hulafǝrta, kalowun ɓǝɓifech ˈyowun ha. <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />[Maa kalawowun nafchǝ ɓǝɓifech ˈyandǝ ha wa, chinwun thla hulafǝrta ngech kalawunchǝ ɓǝɓifechˈyowun ha paɗ wa]<verse eid="MRK 11:26" /></para>
  <para style="s">Chǝhan fee mee Yesu, mbǝschan alkǝtˈyan ayi</para>
  <para style="r">(<ref loc="MAT 21:23-27">Mat 21:23-27</ref>; <ref loc="LUK 20:1-8">Luk 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />Nggǝr kǝ Yesu tǝ kǝmsichiyan yimndǝ kǝ Urshelima. Nakan wiˈyandǝ Wiri Farta, ɓak paktǝ pangngǝncha tǝ fǝ chaˈandǝ kusiˈ i Musa kaɗi, tǝ paktechi Yahudawecha kǝmɗiyan. <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />Chǝhan kandǝ Yesu wa, “Mbuaˈandǝn kǝn mbǝstu alkǝt chǝt ichiɗiya. Paɗaa wun fǝruchǝ alkǝt kǝ chin ichiɗa?”<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />Nggǝrang kan tandǝs wa, “Nii chǝhowun mee ǝn arta. Mbuaˈmitǝn, nggǝt paɗ nii mbahǝn mbuˈowunda ndu tǝ weˈtǝ yen alkǝt thlǝ chǝti ichiɗiya. <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />Baptisma i Yohanna, mbǝs chan alkǝt chiɗan mǝɗi Farta wa, ndu mǝɗi nafcha wa?” Fǝramitǝn nggǝmnan.<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />Ndik kandǝ pǝthlǝr nanda, ndang kandǝ raˈan wa, “Maa ǝ ndimǝn wa, ‘Thlaˈtǝ mǝɗi Farta,’ nan chǝha mǝn mee ndat wa, ‘Kǝthlǝm mii fǝrwaktǝ mǝn kit kǝ ndi?’ <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />Paɗaa maa ǝ ndimǝn wa, ‘Ɓechan mǝɗi nafcha’?” (Tandǝ lekandǝ nggomnan kǝthlǝm nat chika wuni fǝr tǝ kit suwa Yohanna thlǝ shenuˈta tǝ yahti Farta nakan.) <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />Nggǝmang kandǝ Yesu wa, “Sǝnwaˈan wa.”</para>
  <para style="p" vid="MRK 11:33">Ndangkǝ Yesu tanda wa, “Nggǝt paɗ nii mbuˈowunchǝ ndu tǝ yen alkǝt naa thlǝ nati chǝt ichiɗiya wa.”<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">Sakta kǝ ɗar nafchiɗi thlǝ ɗǝpech hǝnggǝ har</para>
  <para style="r">(<ref loc="MAT 21:33-46">Mat 21:33-46</ref>; <ref loc="LUK 20:9-19">Luk 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />Chat nggak kǝ Yesu chaˈandǝ tandǝ har tǝ saktaˈan ndat wa. “Nefsi chehchǝ hǝngga inabi, taurankan ha tǝ sǝsata. Rekan kwi yim wan ɗǝftaˈan, tǝnkan mǝt tanggam thla naa fee thlartǝsi kǝnandǝ pǝk hǝnnggaɗan har. Fǝrankan fowun fǝ huɗecha kǝnandǝ ɗǝpat har kǝ. Chat wiˈkan kǝ yowun hahǝ samǝn. <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />Saˈkǝ sǝfakta thlǝnkan artǝ hur mafechˈyan kǝmɗi fee tǝ hǝnggi ˈyan har kǝ thlan chǝ fowun wan ɗǝftǝɗi ɗam ndǝ ndǝ hǝnggaɗan. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />Paɗaa kǝsan kanda, thlǝfan kanda rǝkkandǝ anchi kaɗ her chaˈ. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />Thlǝ hǝnggaɗan thlǝnkan maafat samǝn kǝmɗiya nda, chik kǝɗu mbǝsan kandǝ mǝri ǝ inda, paɗ ɓahan kanda. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />Nggǝrkan thlǝn maafat samǝn, thlǝnni ɓǝlankanda. Thlǝn kan fowun maafech terchan. Fowun thlǝfankandǝ tanda, takichaˈan paɗ ɓǝlankandǝ tanda.<verse eid="MRK 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6" />“Takǝɗ nefsi arta thla natǝn thlǝnda, waˈyan thla yahtǝn kaan. Mǝthlan thlǝ ndǝn kǝrsa tǝ ndat wa, ‘Nandǝ fǝran maandǝ waˈinchi.’<verse eid="MRK 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7" />“Paɗaa ndang kǝ fǝ ɗǝpa hǝnggechaˈan raˈan wa, ‘Əhǝ. Thleya mǝthlan nech sǝm kǝrsǝ mǝrta. Wumaman mee kǝ ɓǝlamǝn, ǝnɗi natǝn sǝmndǝ kǝrsǝ mǝrta kǝ chok kǝ yimǝn.’ <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />Kǝsan kandǝ wanan, ɓǝlankanda, mǝkkandǝ anchi kesh tǝ kǝrsǝ sǝsa hǝnggaɗan.”<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />“Chokkan kǝɗuyu mǝna thlǝ hǝnggaɗan chǝta? Nan ɓat mbǝlandǝ fǝ pǝk hǝnggaɗan har paɗ kǝ fǝrantǝ fowun samǝn fee nech ɗǝpa hǝnggaɗan har. <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />Changgawak nowun ndiktǝɗiya hur Laulawati Farta wa? Thla ndech wa,</para>
  <para style="b" vid="MRK 12:10" />
  <para style="q1" vid="MRK 12:10">“ ‘Ɗakwanɗi kartǝ fǝ tǝncha,</para>
  <para style="q2" vid="MRK 12:10">ndaˈan chok chǝ kǝ chǝmaa ɗakwan tǝnan.<verse eid="MRK 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11" />Theya chiti Chinda,</para>
  <para style="q2" vid="MRK 12:11">chok kǝ ǝna saka indǝ paɗ ǝ wenitiyamǝn.’ ”<verse eid="MRK 12:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />Nak paktechaˈan i Yahudawecha kaa mbanɗi natndǝ kǝsanda, paɗ tan ndǝ lekandǝ nafcha. Kǝthlǝm sǝnda wa saktǝ ndik tǝɗi fǝr tǝ Yesu yu kǝ ɗar nanda. Tǝ kǝɗu, malan kanda pǝɗakan nda.<verse eid="MRK 12:12" /></para>
  <para style="s">Chǝha mee kǝ ɗar ti chamnda kǝmɗi Kwitira Kaisar</para>
  <para style="r">(<ref loc="MAT 22:15-22">Mat 22:15-22</ref>; <ref loc="LUK 20:20-26">Luk 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />Kǝrsǝ ndaˈan thlǝn kǝ paktechi Yahudawecha, fowun Farisiyawecha tǝ nafchiɗi thlǝ sǝkchǝ ndikti Hiridus kǝmɗi Yesu kǝthlǝm kǝ kǝsanda, tǝmɗi ndiktǝɗi natǝn chǝta. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />Ɓakandǝ kǝmɗiyan ndaka nda wa, “Thlǝ chaˈanan kaɗi, sǝn ǝn wa nef nako thla thlǝ mbuˈchǝ kit, paɗ thlǝ tǝrcho nafchǝ nat arta ǝ wenitiyo, taɗwen nafchi har wa. Kǝthlǝm ke wen thlǝmat ndu michǝ nakanda wa. Paɗ thlǝ chaˈancho mbandi Fartǝ kaɗ kǝɗ ǝnɗi kǝmchisi ɗar kittaˈan. Mbuˈa an ndǝn keˈke suwa kǝ tii ǝn chamnda kǝmɗi Kaisar wa ndu kǝ tii ǝn wa wa?” <verse eid="MRK 12:14" /><verse number="15" style="v" sid="MRK 12:15" />Kǝ tii ǝn, ndu mǝ wa wa?</para>
  <para style="p" vid="MRK 12:15">Paɗ sǝn Yesu ǝnɗi nat ndǝ kaɗat wanɗikaɗechˈyanda, ndaˈan ndang kan tanda wa, “Kǝthlǝm mii natwun yah kaɗita? Ɓa mii tǝn wandǝ ɓǝthlɗi thlǝ ˈya fee wa ndinari kǝ ɗǝpani.”<verse eid="MRK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 12:16" />Ɓang kandǝ arta, chǝhan kan tandǝ mee, “Mir shishingndi wunni, tǝ paɗ thlǝmwun nech ɗaran?”</para>
  <para style="p" vid="MRK 12:16">Nggǝman kanda wa, “Yi Kaisar.”<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />Ndang kan tanda wa, “Fǝraman Kaisar ǝnɗi nech kǝ yi Kaisar, tǝ paɗ fǝraman Farta ǝnɗi nech kǝ yi Farta.” Sakandak indǝ tǝ ndi kaˈan.<verse eid="MRK 12:17" /></para>
  <para style="s">Chǝha mee kǝ ɗar thlaˈti mǝmatecha</para>
  <para style="r">(<ref loc="MAT 22:23-33">Mat 22:23-33</ref>; <ref loc="LUK 20:27-40">Luk 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />Ɓak fowun nafchi Sadukiwecha kǝmɗi Yesu. Tandǝ nech kǝ nafchiɗi fǝrchǝ kit suwa nggǝ thlaˈti mǝmatechǝs wa. Ɓakan ndǝ tǝ chǝha mee. <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />Nda kanda wa, “Thlǝ chaˈanan kaɗi, yaraˈanchǝ Musa suwa, maa ǝ mǝr wanman yowun ǝ malkan nunef ha, waˈyan suwa, wanmanan kǝ kahantǝ nu mǝrtaˈan, maˈ nan nggǝtan waa wanmanan. <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />Nakanya wan manchisi muɗ kǝ hǝssa. Thlaman nanda kahtǝ nunefa, mǝrkan paɗ nggǝt wanda wa. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />Sǝmkǝ chapataˈan yati nu mǝrtaˈan, nggǝt wanda wa, paɗ mǝrkan. Nechan kǝɗu paɗ tǝ mahkaˈan wanmana ndiˈan. <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />Nakan nat ndǝ kǝɗu muɗ mǝrkanda, malwandǝ wanchǝ ha wa. Kǝrsaˈan mǝrkǝ nunafan paɗ. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />Maa ǝ saˈ thlaˈti mǝmatecha, yen arta nech kǝ chǝma nuɗi? Nakan nat ndǝ muɗ riindǝ anchi.”<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />Nggǝrang kǝ Yesu tandǝs wa, “Ngga thleya ɗǝfchǝ wunchǝs kǝ sakowun wa? Kǝthlǝm senwowun Laulawati Farta ndu alkǝti Farta wa. <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />Kǝthlǝm maa ǝ thlaˈ mǝmatecha, hǝssa ngga ndǝ kah kan wa ndu nǝssa kǝ fǝr fee tandǝ kǝ kana wa, nechan ndǝ choktǝ kǝɗ fǝ thlinchi Farta ǝ hulafǝrta. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />Nakanya kǝ ɗar thlaˈti mǝmatecha, chan nggawowun hur kusiˈ i Musa wa, kǝ ɗar ɗǝfta thla kǝschi wata, tǝ mbuˈtǝɗi mbuˈandǝ Farta, Musa wa, ‘Nggǝt nech kǝ Farti Ibrahim, tǝ Farti Ishaku, tǝ paɗ Farti Yakubu?’ <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />Mǝthlan ngga Farta yi mematecha wa, paɗaa Farti fee tǝ shishingndǝfa. Sakiwun ha kaan.”<verse eid="MRK 12:27" /></para>
  <para style="s">Kusiˈ tǝɗi nech manchan</para>
  <para style="r">(<ref loc="MAT 22:34-40">Mat 22:34-40</ref>; <ref loc="LUK 10:25-28">Luk 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />Artǝ hur fǝ chaˈandǝ Kusiˈ i Musa kaɗi, mǝthlan minni, nakan sǝk shenuˈtǝ yanda. Sǝk kan Yesu fǝr tǝ nggǝm nda thla nech ndiˈchan, chǝhangkan Yesu mee, “Hur kusiˈchaˈan nat, yen nech manchan?<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />Nggǝrang kǝ Yesu suwa, “Thla nech manchan ndaˈan niya, ‘Sǝkama nafchi Israˈila, Chinda Farti yamǝn, mǝthlan nech kǝ Fartǝ arta. <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />Kǝ chin thlǝrɗakta kǝmɗi Chu Fartiˈyo tǝ wandǝkaɗatˈyo nat, tǝ shishingndiyo nat, tǝ hur indiyo nat tǝ alkǝtˈyo nat.’ <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />Chapataˈan ndaˈan nech kǝ, ‘Yahu thla nech nduk tǝ wechi kǝɗ ǝnɗi thlǝ yahtu indiyo.’ Nggǝ kusiˈ si pǝɗan chi feya ha wa.”<verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />Nggǝmangkǝ nafan wa, “Thlǝ chaˈan nan kaɗi, inini mbuˈtuyu keˈke. Keˈke mbuˈtu wa Farta arta ndak, yowun sǝ paɗ wa mǝthlan ndak. <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />Kǝ chin thlǝrɗakta kǝmɗiyan tǝ wandǝkaɗat nat, tǝ sǝndǝyo nat, tǝ alkǝt nat, paɗ kǝ yehin thla nech nduk tǝ wechi kǝɗ ǝnɗi thlǝ yahtu indiyo, mbǝrantǝ chika mǝ ha nat tǝ maanda kǝɗ fǝr thle ɓǝra icha tǝ kǝnau pafǝn.”<verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />Kǝ nak Yesu fǝr tǝ nggǝm ndǝ sǝnndǝ keˈke ndang kana, “Chǝ langngǝ tǝ kutǝrakti Farta wa.” Thlaˈtǝ fartaˈan, nefsǝ nggǝrchi chǝhan mee wa.<verse eid="MRK 12:34" /></para>
  <para style="s">Kǝristi, Waˈi wuni</para>
  <para style="r">(<ref loc="MAT 22:41-46">Mat 22:41-46</ref>; <ref loc="LUK 20:41-44">Luk 20:41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />Nak Yesu chaˈandǝ nafchi har hur Wiri Farta, ndaˈan chǝhatǝn mee wa, “Tǝ kǝni thlǝ nda fǝ chaˈandǝ kusiˈchi kaɗ wa Kǝristi, Waˈi Dauda? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />Dauda tǝ indiyan mbuˈchan tǝmɗi Shemeti Farta ndat wa,</para>
  <para style="q1" vid="MRK 12:36">“ ‘Chinda ndanchǝ Chinna wa.</para>
  <para style="q2" vid="MRK 12:36">Choku tǝ harsǝm inchi, paɗ</para>
  <para style="q2" vid="MRK 12:36">ni chandǝ atǝkrechǝwa</para>
  <para style="q2" vid="MRK 12:36">kǝ chok ndǝ kǝ mǝt sǝt sarchiyo.’”<verse eid="MRK 12:36" /></para>
  <para style="b" />
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />“Thlǝ ˈyech Dauda Kǝristi wa ‘Chinda.’ Tǝ kǝn naa Kǝristi choktǝ kǝ waˈyan?”</para>
  <para style="p" vid="MRK 12:37">Kǝ sǝkkǝ kapa nggomnan ǝnɗi mbuˈtǝ Yesu, mbǝn kandǝ fata.<verse eid="MRK 12:37" /></para>
  <para style="s">Kah Thlǝmati Yesu kǝ ɗar ǝna chiti fǝ chaˈandǝ kusiˈ i Musa kaɗi</para>
  <para style="r">(<ref loc="MAT 23:1-36">Mat 23:1-36</ref>; <ref loc="LUK 11:7-54">Luk 11:7-54</ref>; <ref loc="LUK 20:45-47">20:45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />Kǝ nak Yesu chaˈandǝ tandǝ har, ndakan wa, “Cham hǝɓakka tǝ fǝ chaˈandǝ kusiˈ kaɗi. Thlǝ yah chandǝs kǝ nandǝ wiˈta tǝ kapechǝ njang, paɗ nafchǝɗi nech ɓǝrtǝha kǝna ndǝ ndan ǝn tandǝ lǝmo. <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />Kǝ mbǝs ndǝ mǝt chok cha fee nech ndiˈchan hur wur nggomǝncha, tǝ mǝt chokti paktǝ nafcha mǝt sǝk mbǝndǝ fa. <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />Thlǝ nechan ndǝ lǝm tanda tǝ thlǝt ǝnɗi nessi nessǝɗi mǝrtǝ hǝssiyanda, kǝthlǝm ndaˈan thlǝ shichandǝ tǝ long long. Na Farta ɓahandǝ weˈti nafchi ini kaan mǝni takǝɗ nafcha.”<verse eid="MRK 12:40" /></para>
  <para style="s">Fǝr kǝnau pafǝn i nuɗi mǝrtǝ chimaɗan</para>
  <para style="r">(<ref loc="LUK 21:1-4">Luk 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />Chokkǝ Yesu ha nduk tǝ mǝɗi thlǝ fǝrtǝ fee kǝnau pafǝn. Nakan ɗǝpandǝ nggomnan fǝr kǝnau pafǝn ˈyanda. Fowun wurumǝnchǝ paɗ cham kǝnau pafǝn ˈyandǝ ha kaan. <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />Te kǝɗu nunef si thlǝ ɓahta mǝrtǝ chimaɗan, ɓakan cham wanɗǝ mbǝthl ha top tǝpesh chap. <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />ˈYakan kǝmsichiyan kǝ thlǝmaɗan, ndangkan tanda wa “Kittaˈan nati mbuˈowunnda, nuɗi kǝ thlǝ ɓahtiya mǝrtǝ chimaɗan ya, wandǝɓǝthlɗi fǝrtǝn, mbǝrantǝ yi takǝɗ nafchǝ ha nat. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />Nafchiɗi nat ya fǝrchandǝ pafǝn hur wurmaktǝ yanda, paɗaa nuɗi mǝrtǝ chimaɗan kǝ thlǝ ɓahtǝya, fǝrchan nat ichiɗi nesssiyan hur takǝɗ ǝnɗi mǝnandǝn.”<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">Ndik Yesu kǝ ɗar hǝmndi Wiri Farta ha.</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />Kǝ nak Yesu chet kesh Wiri Fartaˈan ha, artǝ hur kǝmsichiyan ndang kan wa, “Thlǝ chaˈanan kaɗi, ɗǝmban weˈtǝ paktǝ ɗakwanchǝɗa, tǝ weˈtǝ ndǝti tǝnchaˈan paɗ.” <verse eid="MRK 13:1" /><verse number="2" style="v" sid="MRK 13:2" />Nggǝrang kǝ Yesu su wa, “Niˈin weˈtǝ paktǝ tǝnchiɗiya wa? Nggǝ ɗǝkwensi naa fee mathlǝ chǝka artǝ ɗar sheɗan wa. Nat naa fee pǝpakandǝ ha.”<verse eid="MRK 13:2" /></para>
  <para style="s">Tǝrkwathl kan nggwarkana</para>
  <para style="r">(<ref loc="MAT 24:3-14">Mat 24:3-14</ref>; <ref loc="LUK 21:7-19">Luk 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />Nak Yesu ɗas ɗar ngwal Zaitun thla nech ɗelengngǝ tǝ Wiri Farta. Ɓak Biturus, tǝ Yohanna, tǝ Yakubu, tǝ Andrawus kǝmɗiyan, paɗ chǝhan kandǝ mee ǝ wuɓtǝ fa. Ndang kanda wa, <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />“Mbuˈaˈandǝn, kwati naa ichiɗiya sǝɓta? Paɗ mǝ nech nat kǝ wanɗǝ sǝnansǝ wa ichiɗiya nggak ndǝ ndiitǝha?”<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />Nggǝrang kǝ Yesu tandǝs wa, “Mbǝramsi mǝ sakowunchǝ yowun wa. <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />Tǝrchan nafcha nech ɓat hur thlǝmna ndat wa, nggǝt nech kǝ Kǝristi, nandǝ naa ɗǝf nafchi terchan kǝ lengndǝ ha. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />Maa ǝ sǝkwun yaancha, tǝ paɗ kusheˈtǝ yaancha, mǝ thlaˈ hurˈinchiyowun wa. Nwaat kǝ landǝ sǝɓta, nat tǝ kǝɗu saˈwu mecheɗan wa. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />Na hahǝ thlaˈandǝ hahǝ fa, paɗ kuturcha kǝ thlaˈandǝ mǝt kuturaktǝ fa. Na hahǝ rǝbtǝf kaan michǝ samǝn samǝn, naa fee chǝt mita. Ndaˈan nech kǝ tǝrkwathl kan nggwarkwana.<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />“Paɗaa kǝ mbǝrwunsi indiyowun. Nandǝ kǝssowunda kǝ ɗǝndǝ tǝ wunchi kǝ pangngǝn kutǝrcha, kǝ thlǝfowun chinda hur wur nggom ndi Yahudawecha. Nat kǝthlǝm thlǝmna naa fee ɗǝt tǝ wunchi kǝmɗi nggomnaticha tǝ kutǝrcha kǝthlǝm nggǝta. Nowun mbuˈandǝ tandǝ paɗ ǝnɗi sǝndǝwun kǝ ɗar na. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />Paɗaa kwastǝ ndiktǝɗiya naa fee ɓassandǝ kaɗ hur hahichi nat kwanɗǝn, kǝn ndukwa heshi ɓata. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />Maa ǝ kǝsowunchi nda kǝ ɗǝndǝ tǝ wunchi kǝmɗi fǝ chak mii cha, mǝ lekǝwun kǝ ɗar mǝ natwun mbuˈta wa. Mbuˈam ǝnɗi fǝrowundǝ fee fartǝ ini. Kǝthlǝm ngga kun nech ndikta wa, Shemeta thla Chiɗ Chiɗ.<verse eid="MRK 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 13:12" />Nafchǝ tǝ wanmanan naa yowun fǝr sheɗan kǝ ɓǝlan fee, chindǝ paɗ nan fǝr waˈyan, naa wanchǝ thlaˈandǝ parchina ndǝ fa, kǝ fǝr ndǝ tandǝ kǝ ɓǝlan fee tanda. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />Naa chǝka wun kar wunchi kǝthlǝm nggǝta, paɗaa nat thla kǝrǝschǝ kǝ ndukwaɗan nan hǝraˈta.<verse eid="MRK 13:13" /></para>
  <para style="s">Əna lekǝta thla nech tǝkmandǝ Wiri Farta kaɗi</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />Maa niwun ǝna lekǝta thla nech tǝkmandǝ Wiri Farta kaɗi, kǝ ɗǝf tǝ nafchǝ nggandǝ yim sǝ wa. (Nat thla nech changata kǝ sǝntǝ ǝnɗi naa fee mbuˈta) Fee nech ǝ hahi Yahudiya, kǝ rakandǝ kǝ hur nggwalcha. <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />Nafɗi nech ɗas ɗar kǝnda, mǝ ndawa nan ɓat kaha, kǝ yim keuriyan kǝ tǝr tǝ ǝnawa. <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />Nafɗi nech hǝngga, mǝ nda wa nan nggǝrandǝ in kaɗ kǝ tǝr tǝ ǝna chiptiyan wa. <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />Ai i nǝssǝɗi nech tǝ wanchi hur tǝ fee nech tǝ wanchi kǝrǝssa wan mǝnchaˈan. <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />Shiyama mǝ ɓǝ fartǝ ini hur ɗǝfi tǝ fekta wa. <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />Kǝthlǝm naa fee sa nggwarkana kaan wan mǝnchi ini. Weˈtǝ ɓahtǝɗi ha ya tamwu fee chǝta wa thlaˈtǝ fartǝɗi tǝndǝ Farta heshi kǝ nakanya. Peˈwu fee nggǝr chǝt weˈtǝ ndaˈan paɗ wa.<verse eid="MRK 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 13:20" />Mangga ǝnɗi takankǝ Farta wanmǝn chaˈan ha wa, mǝ yowunsi nech hǝraˈata wa. Paɗaa kǝthlǝm tachaˈan tǝɗi tatǝn, ndaˈan chicha takandǝn wanminchaˈan ha. <verse eid="MRK 13:20" /><verse number="21" style="v" sid="MRK 13:21" />Fartǝ ini maa ndi yowun wa, ‘Ɗǝpama, ǝ Kǝristi ya.’ Ndu ‘Ɗǝpama, mǝthlan yu.’ Kǝ fǝrwun kit su wa. <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />Kǝthlǝm fee thlǝ ˈyech inchi yanda wa tandǝ nech kǝ Kǝristi tǝ fǝ shenuˈtǝ tǝ yahti Farta yi lekta nandǝ ɓata. Nandǝ chǝt ǝna saka incha tǝ ǝna lekǝchǝ kaan kǝthlǝm kǝ lǝm ndǝ nafcha. Maa nan chǝt kǝɗu, naa ndǝ lǝm tachaˈan. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />Kǝthlǝm ndaˈan, chokam tǝ tahǝs fa. Tapi mbuˈowunchi ichaˈan nat kǝn fartaˈan ɓata.<verse eid="MRK 13:23" /></para>
  <para style="s">Nggǝr ɓati Waˈi Nef kaɗi</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />Paɗaa farti ini, kǝrsǝ ɓahtiˈini ha yu,</para>
  <para style="q1" vid="MRK 13:24">“ ‘Naa wat fartǝ chǝt kǝ wuthla,</para>
  <para style="q2" vid="MRK 13:24">ndǝr paɗ ngee fǝr ɗaˈkǝt ˈyan wa.<verse eid="MRK 13:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="MRK 13:25" />wandǝrichǝ hulafǝrta paɗ nandǝ hǝhatat kaha,</para>
  <para style="q2" vid="MRK 13:25">tǝ paktǝ alkǝchiɗi nech hulafǝrta nandǝ rǝɓtǝ fa.’<verse eid="MRK 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 13:26" />Fartǝ ini naa nafchi naa Waˈi Nefa ɓat kah hur husamba tǝ alkǝta, paɗ tǝ kapa maanda kaan. <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />Paɗ nan thlǝn fǝ thlinchiyan kǝ ngomandǝ fee tatǝn. Nechandǝ nggaktǝ thlaˈtǝ konggal heshi foɗɗa. Nandǝ ngomandat nat thlaˈtǝ ndukwa heshi kǝ ndukwa hulafǝrta.<verse eid="MRK 13:27" /></para>
  <para style="s">Ənɗi nat mǝn chaˈata fi ɗǝftǝ shukwata</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />“Nakanya chaˈam ǝn ɗar dǝftǝ shukwata, maa chǝpantǝ saˈchiyan kaɗi mǝthlan nggak chithla, sǝnwun wa fektǝ nduk ha. <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />Nechan kǝɗu mǝɗiyon, maa ǝ niwun ichiˈini sǝɓta, kǝ sǝnwun su wa fartǝ ɓati Waˈi Nef kaɗ nduk ha, mǝthlan ǝ miimbeya. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />Kittaˈan nati mbuˈowunda, yuwa heshiɗiya nee thlǝrǝt wa maangga tǝ sǝɓ ichiɗiya nat wa. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />Chǝk mǝ ǝ hulafǝrta tǝ heshi, nan thlǝrǝt tǝ kaɗi, ndiktinchi ngee tam thlǝrǝt kaɗ wa.<verse eid="MRK 13:31" /></para>
  <para style="s">Nefsǝ sǝnchǝ fartǝ ɓati Waˈi Nef kaɗ wa</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />“Paɗaa kǝ ɓǝra fartaˈan ndu wanshengnan nefsǝ sǝncha wa. Chǝka fǝ thlǝnchi Farta hulafǝrta, ndu Wanan wa, Chinan ndak. <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />Kǝ mbǝrwunsi, kǝ chok wun tǝ tahǝsfa. Kǝ nowun shita, Kǝthlǝm sǝnwowun wanshengngǝnɗi naa fartaˈan ɓata wa. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />Chok chan kǝɗ nefa thla nech chǝt wiˈta kǝ yowun haha. Kǝ nakan mal wirˈyan ha fǝrankan chǝka wun mafaɗan ǝnɗi natǝn chǝta. mbuˈankan thla nech pǝk mii mbangngan har yuwa kǝ chok tǝ tahǝsfa.<verse eid="MRK 13:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 13:35" />“Kǝthlǝm ndaˈan chokam tǝ tahǝsfa. Kǝthlǝm sǝnwowun wan shengngǝnɗi naa thlǝ wuran ɓat kaɗ wa. Ndu kǝɓǝ kaɗ farwita, ndu ɗar wita, ndu ǝ kwarti chemsa ndu walwurta. <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />Kǝ ɓǝ tukuthl, kǝ ɓǝ mbǝsowunda kun saˈena wa. <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />Ənɗi nati mbuˈowundiya, nggǝt mbuˈandi nafchǝ nat. ‘Chokam tǝ tahǝsfa.’”<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">Paktechi Yahudawecha tahsandǝ mbanɗi ha natndǝ ɓǝlandǝ Yesu</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />Tak chan mǝndǝ chap kǝ chǝ fee mbǝnfa tathla tǝ mbǝnfa njohumɗi nggawaktǝ yisti fiyan, paktǝ pangngǝncha tǝ fǝ chaˈandǝ kusiˈ i Musa kaɗi nakan ndǝ kaa mbanɗi nat ndǝ kǝsandǝ Yesu ǝ wuɓta kǝ ɓǝlanda. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />“Paɗaa ndaka nda wa, “Ngga fartǝ mbǝnfaɗan wa, kǝthlǝm naa nafchi thlaˈa mǝndǝ fa.”<verse eid="MRK 14:2" /></para>
  <para style="s">Pǝtan fee Yesu fiɗet kǝ inda ǝ Betanya</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />Kǝ nak Yesu ǝ Betani wiri nefa thla thlǝ ˈyafee wa Siman thla naa tarkwai fiyan, nakandǝ sǝm ɗǝsǝmnda, ɓak yowun nunefa tǝ fiɗeta thla nech tǝ kǝnau fǝ kaˈan, hur kwastǝ kuruɓta thla tahǝstǝ fee tǝ ɗakwan pǝlaarcha. Fiɗeɗan tahǝschǝ fee tǝ ˈyam ɗǝftǝɗi thlǝ ˈya fee wa nad. Fohankan ɓǝra kuruɓtaˈan kaɗi, thlǝrang kan fiɗeɗan kǝ inda. <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />Fowun hur nafchǝɗi nech minni, sǝɓ kǝ hurchiyandǝ kaɗi, ndang kandǝ raˈan wa, “Mǝ chicha sǝɓandǝ fee fiɗeɗi kaɗ kǝɗaya? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />Mam wa tǝ hiyan fee kaɗi mǝ nan mbǝra ndǝ wanɗǝɓǝthli fǝ tarchǝ ha yi hurat arta, kǝ fǝran fee wanɗǝɓǝthlan fǝ ɓahcha.” Sǝɓ kǝ hwirˈyandǝ kaɗi, nakandǝ hurumɗǝf tǝ ndi. <verse eid="MRK 14:5" /><verse number="6" style="v" sid="MRK 14:6" />Ndak Yesu wa, “Malamandǝn nuˈini, kǝthlǝm mǝ natwun ɗahandǝ in? Kaakǝt chitǝn. <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />Fǝ ɓahcha tandǝ tǝ wunchi kǝ porei, chǝkakwati nowun mbahǝn chan kaakǝt tanda. Nggǝt paɗ ngga kǝ porei nati nat tǝ wunchi wa. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />Tǝ chǝt ǝnɗi natǝn mbahǝn chǝta. Pǝtichan fiɗeɗiya kǝthlǝm tahǝstǝ fa kǝ fartǝɗi naa fee thlohita. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />Kittaˈan nati mbuˈowunda, nat mǝɗi naa fee ɓas kusheˈtǝ kwastǝ ndiktǝɗiya hur heshi nat, naa fee naa mbuˈ kusheˈtǝ ǝnɗi chǝt nuɗiya, kǝthlǝm kuɗuktǝ tǝ ndi.”<verse eid="MRK 14:9" /></para>
  <para style="s">Nggǝm Yahuda Iskariyoti fa wa nan fǝr Yesu</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />Nakandǝ minni, Yahuda Iskariyoti artǝ hur kǝmsichiɗi kum nggǝrsǝ chap yu, ɗǝkan kǝmɗi paktǝ pangngǝncha kǝthlǝm kǝ fǝr tǝ Yesu kǝmɗi yanda. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />Kǝ sǝk kanda kǝɗuyu, chǝkandǝ mbǝnfat kaan ɗǝfan kandǝ mee tǝ ndat wa nandǝ fǝran wanɗǝɓǝthla. Chat nggakǝ Yahuda Iskariyoti kaa mbanɗi natǝn fǝr ndi.<verse eid="MRK 14:11" /></para>
  <para style="s">Sǝm Yesu ɗǝsǝmǝn mbǝnfa Tathla tǝ kǝmsichiyan</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />Ə fartǝ tǝrkwathl homba njohǝma ngga tǝ yisti fa wa, ndaˈan nech kǝ fartǝɗi thlǝ thlendǝ ndǝ chohra homba Tathla, chǝhankǝ kǝmsichi Yesu mee wa, “Ə ai yahtu kǝ ɗǝˈǝn tahsu mǝtsi yi sǝm ɗǝsǝmǝn Tathla?”<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />Ndaˈan thlǝndǝn chap hur kǝmsichiyan, ndang kan tanda wa, “Ɗam kǝ hur wira. Minni naa yowun nef ɓat kǝmndǝ tǝ wunchi thla nech rǝf ɓutǝ ema. Parakowun ndi. <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />Nat wurɗi yim ndǝn, kǝ ndawun thlǝ wuran wa, ‘Ndech thlǝ chaˈanan kaɗ wa, ai kǝtǝn ɗi tahsandu ha kǝthlǝm nggǝta, kǝ sǝmi ɗǝsǝmǝn homba Tathla tǝ kǝmsichinchi?’ <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />Mǝthlan paɗ nan pǝnowun kapa kǝnda thla nech ɗar sheɗan fǝrta thla tahsandǝ fee chǝka mǝ ha ǝ huran. Minni natwun tahsamǝn ɗǝsǝm ndǝsi.”<verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />Thlaˈkǝ kǝmsichaˈan pǝɗakandǝ kǝ hur mǝrɓan, ɗǝkandǝ mbǝsanda kǝɗ ǝnɗi mbuˈanda Yesu tanda. Tahsan kandǝ ɗǝsǝmǝn homba Tathlan ha ǝ kǝtǝnan.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />Kǝ saˈkǝ farwita, Yesu tǝ kǝmsichiɗan kum nggǝrsǝ chapyu ɓakandǝ kǝ wuran. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />Kǝ nakandǝ sǝm ɗǝsǝmnda, minni ndak Yesu wa, Kittaˈan nati mbuˈowunda, artǝ hurwun nan fǝr nenchi, mǝthlan tǝɗi nech sǝm ǝn tǝ nenchi nakanya.”<verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />Sǝɓkǝ hwiri kǝmshichaˈan kaɗi, chǝkawun nakan chǝhan mee artǝ artǝ tǝ ndat wa, “Nggǝta wa?”<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />Nggǝmangkǝ Yesu tanda wa, “Artǝ hur wun kum nggǝrsǝ chap yu, thla nat ǝn sǝm ǝn hur tiɓ artǝ tǝ ndi. <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />Na Waˈi Nef mǝrta, kǝɗ ǝnɗi yarandǝ fee ha hur Laulawati Farta, kǝ ɗar indiyan. Ai i nafɗi nech fǝr Waˈi Nefa, kwechchan mǝ nggǝt waktǝ fee nef ini.”<verse eid="MRK 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />Nak Yesu tǝ kǝmsichiyan sǝm ǝna, tǝrkǝ Yesu njohǝman, chan kan usoko Farta. Chichen kan ha, fǝran kan kǝmsichiyan, ndakana, “Thlama. Thlǝya fatinchi.”<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />Kǝrsǝ ndaˈan, tǝrkan kongnga tǝɓɗi naa ˈyam inabi huran, chankan Farta usoko fǝrankan tanda. Nat nda saka ndǝ paɗ huran.<verse eid="MRK 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 14:24" />Kǝnan ndandǝ tanda wa, “Thlǝya ferinchi, thla nech pǝnda wa yuwa ɗǝfmiɗi chandǝ Farta nafcha nan ndiitǝ ha. Ferinchi thla thlǝrandǝ fee kaɗ kǝthlǝm nafchǝ terchan. <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />Kittaˈan nati mbuˈowunda, peˈwi nggǝr sa ˈyam inabi paɗ wa, maangga fartǝɗi nati sa yuwa ˈyam inabi fartǝ kutǝrakti Farta wa.<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />In kandǝ emsa, chekan ndǝ kesh kǝ hur ngwal Zaitun.<verse eid="MRK 14:26" /></para>
  <para style="s">Mbuˈ Yesu wa naa Biturus asˈin sǝn ndi</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mat 26:31-35</ref>; <ref loc="LUK 22:31-34">Luk 22:31-34</ref>; <ref loc="JHN 13:36-38">Yoh 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />Ndang kǝ Yesu tanda wa, “Nat wun nowun rakata, kǝ mal wun nen chǝ ha, kǝthlǝm yaranchǝ fee ha hur Laulawati Farta ndat wa, ‘Ni ɓǝlandǝ thlǝ paraɗan, chohrechaˈan paɗ nandǝ wethlǝ ha.’ <verse eid="MRK 14:27" /><verse number="28" style="v" sid="MRK 14:28" />Paɗaa kǝrsǝ thlaˈitinchi ǝ mǝrta, nii lat kǝ Galili mǝ kun.”<verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />Ndangkǝ Biturus, Yesu wa, “Chǝka tǝ rak takichanˈan nat, nggǝtta nii raka wa.”<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />Ndangkǝ Yesu wa, “Kittaˈan nati mbaˈuta, ɓukwiya ǝ witǝɗiya, no asˈin nenchi harkeˈya mahkan, kǝn chakkarta kwartǝ chap.”<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />Paɗaa nggǝrangkǝ Biturus si tǝ alkǝt fǝ kaan ndat wa, “Chǝka tǝn fee ɓǝlitǝ tǝ wechi, nii tam asˈin sǝn wech wa.” Nat takichaˈan mbuˈkandǝ kǝɗu.<verse eid="MRK 14:31" /></para>
  <para style="s">Shenuˈ Yesu tǝ Farta ǝ Getsemani</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />Pǝɗakandǝ kǝ mǝɗi thlǝ ˈyafewa Getsemani (ndaˈan nech kǝ mǝɗi thlǝ yim ndǝ fee wan inabi), ndang kan kǝmsichiyan wa, “Chokam ha mǝɗiya chi shenuˈtǝ tǝ Farta kwaɗǝn.” <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />Tǝrkan Biturus, tǝ Yakubu, tǝ Yohanna. Nakandǝ pǝɗata, nggak kǝ fatˈyan mǝrtǝ kaɗi tǝ sǝɓ tǝ wanɗikaɗata. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />Ndangkan tanda wa, “Nggǝt hur sǝɓtǝ hwir kaan kǝɗ tǝ nii mǝrta. Thlaram ha mǝɗiya kǝ chokwun tǝ tahǝs fa.”<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />Ɗǝkan kǝ pang ngguɗyeh, sǝkan kuruminchi ha kǝ haha, shenuˈkan tǝ Farta, ndat wa, maa nan chǝta kǝ tǝreen ɓahti wanshengngǝnɗiya kaɗi. <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />Ɗǝkan kǝ pang tǝ shita, ndat wa, “Papa, no mbahǝn chǝt chǝka mii. Tǝran kongnga nggwarkana tǝɗinchiya kaɗi. Ngga nwaat ǝnɗi yahtisi kǝ chi fee wa, paɗ ǝnɗi yahtusi kǝ ndiiɗ ha.”<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />Nggǝrangkan in kǝmɗi kǝmsichiyan, ɗǝkan mbǝsandǝ tanda saˈena. Ndang kan Biturus wa, “Siman, tǝ nen saˈena wa? Awi no mbahan chok tǝ tahǝs fa chǝk wanshengnan arta wa? <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />Shiyama kǝ nowun choktǝ tǝ tahǝs fa kǝthlǝm kǝ yimwun kǝ hur kaɗata wa. Shemeɗan yehsi kǝ chok tǝ tahǝs fa, paɗaa faɗan nen mbahan wa.”<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />Nggǝr kan pǝɗata, ɗǝkan nggǝr shenuˈtǝ tǝ Farta kǝɗ thla tǝrkwathl kanan yu. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />Kǝ ɓakan kaɗi mbǝsankan tanda saˈen paɗ. Kǝthlǝm en fiyandǝ kaan, paɗ sǝnwandǝ ǝnɗi nat ndǝ mbuˈa nda wa.<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />Kǝ nggǝr kan ɓat yi mahkanan, ndangkan tanda wa, “Peˈchowun saˈena tǝ yipta wa? Cheˈ kǝɗu, saˈ wanshengnan. Ɗǝpama, fǝr fee Waˈi Nefa kǝ hari fǝ ɓǝɓifecha. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />Thlaˈama. Tamǝ kaɗi, thla nech hiyitǝ kaɗi mbǝhi nduk.”<verse eid="MRK 14:42" /></para>
  <para style="s">Kǝsan fee Yesu</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />Kǝ nak Yesu ɗar shenuˈta, chat Yahuda, artǝ hur kǝmsichiɗan kum nggǝrsǝ chap yu, ɓakan. Fen tǝ nafchi terchan tǝ fangngǝncha tǝ pangsalmicha, paktǝ pangngǝncha, tǝ fǝ chaˈandǝ kusiˈ kaɗi tǝ paktechaˈan thlǝnchi tanda.<verse eid="MRK 14:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MRK 14:44" />Yahuda thla nech fǝr Yesu tapi tahsandǝ wanɗǝsǝnan ha, thla nech pǝnda wa mǝthlan nech kǝ Yesu. Ndangkan tanda wa. “Thla nati nggǝthl anchi kafa mǝthlan nech kǝ nafan. Kǝ kǝsawun kǝ pǝɗowun taˈanchi. Kǝ kǝswun anchǝ har ndiˈchan <verse eid="MRK 14:44" /><verse number="45" style="v" sid="MRK 14:45" />Kǝ saˈ kǝ Yahuda, chat ɗǝkan kǝ thlǝma Yesu, ndangkan wa, “Thlǝ chaˈanan kaɗi.” Nakan nggǝthl anchi kafa. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />Chat nafchaˈan kǝsankandǝ Yesu. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />Artǝ hur kǝmsichi Yesu thla nech kit nduk taˈanchi kǝt kan wan fuwha, chathlan kan thlǝmati mafati kapa pangndǝ kaɗi.<verse eid="MRK 14:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 14:48" />Ndangkǝ Yesu tanda wa, “Ɓechowun kesh tǝ fangngǝncha tǝ wan fuwhicha, kǝthlǝm kǝ kǝsichǝ wun, tǝni kǝ thlǝ fasa fata wa? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />Chǝk yen parta nggǝt tǝ wunchi hur Wiri Farta, nggǝt chaˈandǝ kaɗi, kǝsiwowun wa. Ənsu wa. Chich fee kǝɗaya kǝthlǝm kǝ ndiiɗan fee ǝnɗi mbuˈtǝ fee, hur Laulawata.” <verse eid="MRK 14:49" /><verse number="50" style="v" sid="MRK 14:50" />Ə minni nat kǝmsichiyan malkandǝ anchi ha, rakakanda.<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />Kimsha si thla nech para Yesu, kapat sǝ fiyan wa, ǝna chiptǝ ndak. Yahkǝ nafchaˈan wa nandǝ kǝsanda, <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />chat malkan ǝna chip taˈan ˈyan ha mǝɗiyanda, rakakkan tandǝr kwai.<verse eid="MRK 14:52" /></para>
  <para style="s1">Yesu ǝ pangngǝn fǝ chak miicha</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />Ɗǝkandǝ tǝ Yesu kǝ wiri kapa pangnda, mǝɗi nggomndǝ paktǝ panggǝncha, tǝ paktecha, tǝ fǝ chaˈandǝ kusiˈ i Musa kaɗi. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />Parak Biturus Yesu kǝrsǝ, langnga, parechan ndǝ kǝ file wiri kapa pangnda. Minni chokkan ha tǝ fee nech pǝk wuran har, nakandǝ hwarta.<verse eid="MRK 14:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MRK 14:55" />Paktǝ pangngǝn chaˈan, nat tǝ fǝ chak mii chaˈan nakandǝ ka mbanɗi nat ndǝ kǝsandǝ Yesu tǝ ǝnfa kǝthlǝm kǝ ɓǝlanda, paɗ mbǝsawandǝ tǝ ǝnfa wa. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />Nafchi terchan lekandǝ kafa, paɗaa ɓawu meˈyandǝ arta wa.<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />Kǝrsaˈan thlaˈkǝ fowuna, mbuˈ kandǝ lekta kǝ ɗar Yesu, ndat wa, <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />“Sǝk ǝn ndi ndat wa, ‘Nii tutokandǝ Wiri Farta kaɗi thla tǝndǝ nafcha, hur mǝndǝ mahkan kǝ nggǝri tǝn yowun, ngga tǝndi nefa wa.’” <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />Chǝka kǝɗu, ǝnɗi mbuˈtǝnda, ɓawa keˈke wa.<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />Thlaˈkǝ kapa pangnda hur ɗǝfi tǝ nanda, chǝhangkan mee Yesu ndakan wa, “Ə nggǝmndiyo su wa? Ənɗi naa nafchǝɗiya mbuˈtǝ kǝ indiyo ya kǝni? <verse eid="MRK 14:60" /><verse number="61" style="v" sid="MRK 14:61" />Paɗaa nggas kǝ Yesu ɓaˈ nggǝma wa tanda wa.</para>
  <para style="p" vid="MRK 14:61">Nggǝr kǝ kapa pangnan chǝhan mee ndat wa, “Chǝ nech kǝ Kǝristi, Waˈi Chinda, Farta thlǝ maanda wa?”<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />Nggǝrangkǝ Yesu su wa, “Nggǝta. Nowun naa Waˈi Nefa ɗas har sǝm i thlǝ alkǝt nat, mǝthlan ɓata hur husamba ǝ hulafǝrta.”<verse eid="MRK 14:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />Kapa pangnan thlahan kan kapat ˈyan kaɗi, ndakana, “Weˈtǝ yen sǝnan paɗ natmǝn kata? <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />Sǝk wun ǝ njiran tǝ Farta kaɗi. Mǝ ɗǝpandǝ wun?”</para>
  <para style="p" vid="MRK 14:64">Nat nda thlen kandǝ ha tǝ ndat wa, chǝt ǝnɗi kǝmwak chǝsi, kǝ ɓǝlan fee. <verse eid="MRK 14:64" /><verse number="65" style="v" sid="MRK 14:65" />Fowun nggak kandǝ chǝhan yahtǝ kafa. Kǝnan kandǝ chimandiyan, mbǝmbalan kandǝ fa, ndang kanda wa, “Mbuˈu wun mbalech wechi.” Fǝ pǝk wuran har paɗ tǝr kandǝ anchi thlǝthlafan kandǝf tǝ harcha.<verse eid="MRK 14:65" /></para>
  <para style="s">As Biturus in sǝn Yesu</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />Nak Biturus ɗas haha file wuran, ɓak yowun wannuwa hur mafechi kapa pangnan kǝ minni. <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />Kǝ nakan Biturus tǝk wat fa, chat dǝpankan ha ndiˈchan, ndakana,</para>
  <para style="p" vid="MRK 14:67">“Chǝ paɗ chǝ tǝ Yesu, thlǝ Nazarat tǝɗiya.”<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />Askǝ Biturus inda, ndakana, “Sǝnwi ǝnɗi natu mbuˈta wa paɗ wathliwa wa.” Kǝ mbuˈkan kǝɗu chekan kesh kǝ kǝtǝn mii mbeya chat kwarkǝ chemsa.<verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />Kǝ nggǝrkǝ wan nuwanan naa anchi minni, mbuˈankan fee nech kit kit mǝɗan, “Nafɗa mǝthlan artǝ hur nanda.” <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />Nggǝr kǝ Biturus asˈin inda.</para>
  <para style="p" vid="MRK 14:70">Chǝkan tolla, fee nech kikit nduk tǝ Biturus, ndang kanda wa “Asˈin indǝs wa, kittaˈan chǝ hur nanda, kǝthlǝm thlǝ Galiliyawata nako.”<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />Nggak kǝ Biturus mbuˈ sǝɓtǝ ichǝ kǝ ɗar indiyan tǝ ransata, ndat wa, “Sǝnwi nafɗi natwun ndiktǝ kǝ ɗaran ya wa.”<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />Chat kǝɗuyu kwarkǝ chakkarta yi chapataˈan. Kuɗuk kǝ Biturus tǝ ndiktǝɗi mbuˈandǝ Yesu. “Kǝn chakkarta kwartǝ harkeya chap, no asˈin sǝn nenchi harkeya mahkan.” Kǝ kuɗuk kan tǝ ndikti ini, chat nakan tǝta.<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">Ɗi fee tǝ Yesu kǝ pangngǝn Nggomna Bilatus</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />Walwurtaˈan paktǝ pangngǝncha, tǝ paktecha, tǝ fǝ chaˈandǝ kusiˈ i Musa kaɗi, nat tǝ takǝɗ fǝchak miicha, sakan kandǝ ha. Kǝnan kandǝ Yesu, pǝɗakandǝ tǝ ndi kǝmɗi Bilatus.<verse eid="MRK 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 15:2" />Chǝhankǝ Bilatus, Yesu mee wa, “Chǝ nech kǝ kwitiri Yahudawecha wa?”</para>
  <para style="p" vid="MRK 15:2">Nggǝman kan wa, “Aa, kǝɗ ǝnɗi mbuˈtu.”<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />Paktǝ pangngǝn chaˈan nakandǝ ˈyan sǝɓtǝ ichi kaf samǝn samǝn terchan. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />Nggǝrkǝ Bilatus chǝhan mee, “No fǝran nggǝm nan tanda wa? Ndǝpa ndǝn tandǝ ˈya sǝɓtǝ ichi terchan kafˈyo”<verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />Paɗaa Yesu in wa mee wa, kǝthlǝm ndaˈan sakan kǝ indǝ Bilatus.<verse eid="MRK 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />Ənɗi nech kǝ raˈati Bilatus far homba tathla, thlǝ kalchan nef ha arta hur pursuna thla shitǝ nafcha. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />Nefsi thlǝman wa Barabas. Arta hur fee cham ndǝ fee kǝ pursuna kǝthlǝm thlaˈ mbata. Fartiɗi thlaˈandǝ ndǝ mbaɗan ɓǝl fee nefa. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />Nggomnan mbǝha kandǝ nduk, nggak kandǝ shiyanda, kǝ kallandech pursuna ha, kǝɗ ǝnɗi sǝndǝn ha tǝ chǝta.<verse eid="MRK 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 15:9" />Nggǝman kǝ Bilatus ndang kan tanda wa, “Yah wunsi kǝ kalowunchi kwitiri Yahudawech ha wa?” <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />Kǝthlǝm ǝ shin Bilatus wa sǝraˈtǝ ɗǝfchi paktǝ panggǝncha kǝ fǝrndǝ Yesu kǝmɗiyan. <verse eid="MRK 15:10" /><verse number="11" style="v" sid="MRK 15:11" />Paktǝ pangngǝnchaˈan chǝ kan kandǝ nafcha kǝ nda nda wa kǝ kal fee Barabas ha mǝni Yesu.<verse eid="MRK 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 15:12" />Chat Bilatus chǝhangkan tanda wa, “Mǝnati chandǝ thla ˈyat wun wa kwitiri Yahudawecha?”<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />Thlaˈankandǝ ɓǝrata tǝ ndat wa, “Kukwa maandǝn.”<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />Ndak Bilatus wa, “Kǝthlǝm mii? Ɓǝɓifa mǝ chǝtǝn?”</para>
  <para style="p" vid="MRK 15:14">Hwakandǝ kafǝrta, ndaka nda wa, “Kukwa maandǝn”.<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />Yah kǝ Bilatus si kǝ hunantǝ wanɗǝkaɗati nggomnan ha, kalan kan tandǝ Barabas ha. Kǝrsǝ thlǝfandǝ Yesu tǝ kwirɓa, fǝrankan tanda kǝ kukwa nda.<verse eid="MRK 15:15" /></para>
  <para style="s">Fǝ yaanchi Romawecha maasandǝ Yesu i njirfata</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />Fǝ yaanchaˈan pǝɗa kandǝ tǝ Yesu kǝ wiri kwitira, (thla nech kǝ wur kutǝrakta). Nggoman kandǝ takǝɗ fǝ yaanchaˈan nat kǝ ɓanda. <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />Pang kandǝ kapat nga weˈtǝ thla thlǝ pa kuturcha, faɗ kandǝ tahcha kǝɗ lǝɓokǝr kuturakta, pankandǝ kǝ inda. <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />Chat nggak kandǝ ndan ǝna, ndat wa, “Kǝ mbar shishingndiyo kapa kwitiri Yahudawecha.” <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />Nakan ndǝ ruroˈandǝf ǝ inda tǝ fangnda, nakan ndǝ chǝhan yahtǝ kafa. Kop kandǝ ha kǝɗ nandǝ fǝran mananda. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />Kǝ tǝɓang kandǝ njir anchi, kǝtan kandǝ kapaɗi ha ngaa paa ndǝ ndǝ yu, mǝkan kandǝ kapech ˈyan kafa. Ɗǝkandǝ taˈanchi kesh kǝthlǝm kǝ kukwa nda.<verse eid="MRK 15:20" /></para>
  <para style="s">Kukwan fee Yesu</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />Nakandǝ chet kesh hur mǝrɓan, nak nef ɓat mbǝrtǝ ha kǝ hur mǝrɓan, thlǝ man wa Siman, chin Alekzanda tǝ Rufus. Nefi hahi Sayarin ɗǝfka ndǝ anchi nwaat kǝ tǝrtǝ palang ndi Yesu. <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />Ɗǝkandǝ tǝ Yesu kǝ mǝɗi thlǝ ˈyafewa Golgota, (ndaˈan nech kǝ mǝɗi nech kǝɗ tǝɓ alˈincha.) <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />Minni fǝrang kandǝ ˈyam inabi thla kurtandǝ fee ha tǝ mur, paɗaa karkan sata. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />Kukwan kandǝ ha. Tarak kandǝ ɓǝra kapech ˈyan kǝthlǝm kǝ nanda chǝka wun yen kapenǝ natǝn mbǝsta, chakan kandǝ kapech ˈyan ha pǝthlǝr nanda.<verse eid="MRK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 15:25" />Saˈkǝ wanshengnan wanherha arta yi walwurta, kukwan kanda. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />Yara kandǝ ǝnɗi ndat nda wa ǝ chi, ɗǝf kandǝ ha ɗar palangnan tǝ ndat wa, “Kwitiri Yahudawecha.” <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />Fowun fǝ fasa fechǝs chap kukwan ndǝ fee ha ɓǝra palangngǝncha nduk tǝ palangndi Yesu, arta tǝ harsǝm ˈyan arta tǝ paɗ tǝ kaku ˈyan. <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />[Tǝ kǝɗu, ǝnɗi yara ndǝ fee ha hur Laulawati Farta choh ndiiɗ ha. Thla ndech wa, “Shengngan fee hur fǝ ɓǝɓifecha.”] <verse eid="MRK 15:28" /><verse number="29" style="v" sid="MRK 15:29" />Nafchiɗi nech mbǝrtǝha nakandǝ kǝkrandǝ inda tǝ mbuˈ ɓǝɓi ndikta, tǝ ndat wa, “Awi. Chaɗi ndech wa no tokandǝ Wiri Farta ha, kǝ tǝneen hur mǝndǝ mahkan. <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />Hǝraˈandǝn indiyo, kǝ tirin ka ha ɗar palangngǝnɗa.”<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />Kǝɗu paɗ paktǝ pangngǝnchaˈan, tǝ fǝ chaˈa ndǝ kussiˈ i Musa kaɗi, nakan ndǝ njir ndǝ. Naka ndǝ nda ndǝ raˈan tǝ ndat wa, “Hǝranˈantǝ fowuna, paɗ wulan tǝ thlǝt indiyan. <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />Kǝristi tǝɗiya, kwitiri Israˈilawecha, kǝ tǝr ka ha ɓǝra palangngǝn ɗiya kǝ namǝn, maˈ namǝn fǝr kit.” Fǝ fasa fechǝɗi kukwandǝ fee tǝ mǝthlan, paɗ nakandǝ ˈyara ndi.<verse eid="MRK 15:32" /></para>
  <para style="s">Mǝrti Yesu</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />Hur Farta, wulkǝ mǝt nat hahiˈan, kǝ wan shengnan mahkan yi farwita. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />Ə wan shengnan mahkan, thlaˈan kǝ Yesu ɓǝrata tǝ alkǝta ndakana, “Eloi, Eloi, lama sabachthani?” Ndat wa, “Fartinchi, Fartinchi, kǝthlǝm mii kiitu kirshifa?”<verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />Fowun nafcha fee thlarchi ha nduk ǝ mǝɗan sǝk kandǝ kǝɗu, ndaka nda wa, “Sǝkama, mǝthlan ˈya thlǝ shenuˈtǝ tǝ yahti Farta, Iliya.”<verse eid="MRK 15:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 15:36" />Rakak yowun hur nanda, tǝtnan kan wanɗǝ chapta tǝ ˈyam inabi thla ɓangɓang, pakan kǝ fangnda fǝrang kanYesu kǝthlǝm kǝ sa. Ndak nafan wa, “Thlaram ha kǝ namǝn ndu naa Iliya ɓat kǝ tǝrandǝ kaha ɓǝra palangnan.”<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />Hwak Yesu tǝ alkǝta, kǝt kan yipta yi ndukwaɗan, chat mǝrkan.<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />Kapaɗi lanchǝ mǝɗi ha nech Chiɗ Chiɗ ǝ Wiri Farta mbǝthl kan ha kwalaran chap thlaˈtǝ ɗaran kǝ kanan. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />Kapa thlǝ yaanan thla nech kit nduk tǝ Yesu, kǝ nakan weˈtǝ mǝrti Yesu, nda kana, “Kittaˈan, nafɗa Waˈi Farta.”<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />Fowun nǝssǝ paɗ tandǝ nat mǝt langnga. Hur nanda Maryamu thlaˈtǝ Magdaliya, tǝ Maryamu man Yakubu, thla nech ngguɗyeh mǝ Yusufu, tǝ Salomi paɗ. <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />Parech nǝssiɗa ndi thlaˈtǝ Galili nakan ndǝ kǝsandǝsi. Fowun nǝssǝs paɗ terchan fee ɓat ndǝ thlaˈtǝ Urshelima, tandǝ minni.<verse eid="MRK 15:41" /></para>
  <para style="s">Thlohan fee Yesu</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />Fartǝ ini tǝ farwitǝ fa, fartiɗi thlǝ tahǝstǝ Yahudawech fa kǝthlǝm fartǝ yipta. <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />Yowun nefa thlǝman wa Yusufu ɓechan ǝ Arimatiya. Thla thlǝ fǝrandǝ fee manda hur paktecha, mǝthlan ɗǝfkǝfatsi kǝ ɓati kuturakti Farta. Ɗǝkan tǝ hish kǝta, kǝmɗi Bilatus kǝ shiya kǝ fǝran fee mǝrtǝ Yesu. <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />Sakan kǝ indǝ Bilatus, kǝ sǝk kan wa tapi mǝr Yesu. Chat thlǝn kan kǝ ˈyan fee kapa fǝ yaanchaˈan, chǝhangkan mee ndu tapi mǝri. <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />Kǝ wathlan kan ha ǝ mee i kapa thlǝ yaanan wa ǝ mǝr Yesu, nggǝman kan wa kǝ fǝran fee Yusufu mǝrtǝ Yesu. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />Hikǝ Yusufu kapa thloh mǝrta, tǝrankan fati Yesu kaha, fǝtankan tǝ kapa thloh mǝrtaˈan. Ɗǝf kan ndi kǝ hur kwa thla chuh tǝ fee fii ɗǝkwena. Patang kan papalaɗan, nggǝlankan mii kwiyan si. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />Maryamu thlaˈtǝ Magdaliya, tǝ Maryamu man Yusufu, naka ndǝ naa mǝɗi huna ndǝ fee fati Yesu ha.<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">Thlaˈ Yesu hur mǝmatecha</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />Kǝ mbǝr kǝ fartǝ yiptǝ ha, Maryamu thlaˈtǝ Magdaliya, tǝ Maryamu man Yakubu tǝ Salomi, hikandǝ fiɗeta thla naa saˈtaˈan mbinchan, kǝthlǝm kǝ ɗǝndǝ paˈandǝ fati Yesu. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />Kǝrsǝ fartǝ yipta, walwurta tapi chi farta, ɗǝkandǝ kǝ mǝt kwiyan. <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />Naka ndǝ wiˈtǝ mbanda, nakan ndǝ chihandǝ raˈan, ndat wa, “Wun nech patandǝ papalaɗan ˈyamǝn kaɗ ǝ mii kwiyan?”<verse eid="MRK 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 16:4" />Paɗaa kǝ saˈ kandǝ nduk tǝ mii kwiyan, thlaˈan kandǝ inda, naka ndǝ tapi patan fee kapa papalaɗan kaɗi. <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />Kǝ yim kandǝ kǝ hur kwiyan, nakandǝ kimsha ɗas tǝ harsǝm ˈyanda, tǝ kapat heɗǝɗa fiyan, chat lekǝkanda.<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />Ndang kan tanda wa, “Mǝ lekǝwun wa, tǝ nowun ka Yesu i Nazarat thla kukwandǝ fee ha ɓǝra palangnda wa? Mǝthlan si mǝɗiya wa, ǝ thleˈi. Ɗǝpaman mǝɗi huna ndǝ fee ha. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />Nakanya nggǝraman in, kǝ mbuˈawun Biturus tǝ takǝɗ kǝmsichiyan, ndat wa ‘Nan lat mǝ kun kǝ Galili, ǝ minni nandǝ naa ndi kǝɗ ǝnɗi mbuˈandǝn tanda.’”<verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />Chekandǝ kesh hur kwiyan, rakaka nda, tandǝ saktat fa tǝ lekǝta. Mbuˈa wandǝ ǝn nefa wa, kǝthlǝm tandǝ lekǝta. [<verse eid="MRK 16:8" /></para>
  <para style="s">Pǝnan Yesu fatˈyan Maryamu thlaˈtǝ Magdaliya</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />Kǝ thlaˈkǝ Yesu hur mǝmatecha, walwurtǝ pung ǝ kǝr sǝ fartǝ yipti Yahudawecha, nggakchan pǝn indiyan kǝmɗi Maryamu thlaˈtǝ Magdaliya, thla kǝtandǝn hwaˈarchi kesh muɗ fiyan. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />Mǝthlan paɗ ɗǝkan mbuˈandǝ nafchiɗi nech tǝ Yesu tǝrkwathl kanan, tǝ fenech tǝta tǝ sǝɓtǝ hwira. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />Paɗaa kǝ sǝkkanda wa thlaˈ Yesu tǝ shishingndǝ fa, paɗ ni tǝ anchi, fǝr wandǝ kit su wa.<verse eid="MRK 16:11" /></para>
  <para style="s">Pǝnan Yesu fatˈyan kǝmsichiyan chap</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />Kǝrsǝ ndaˈan mbeɗak fati Yesu ha, pǝn kan indiyan kǝmɗi kǝmsichiyan chap, nech wiˈta kǝ wan mǝrɓa. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />Nggǝrang kandǝ in mbuˈankandǝ takichaˈan, karkandǝ fǝr kit kǝ tandǝ paɗ.<verse eid="MRK 16:13" /></para>
  <para style="s">Pǝnan Yesu fat kǝmsichiɗan kum nggǝrsǝ artǝ yu</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />Kǝrsaɗan, pǝng kǝ Yesu indiyan kǝmɗi fee kum nggǝrsǝ artǝ yu, fartǝ ɗi nat ndǝ sǝmɗǝsǝm nda. Yanan kan tanda kǝ ɗar kumi fǝr kit tǝ kwaˈkwa tǝ indiyanda, kǝthlǝm fǝr wandǝ kit kǝ ndikti fee nech anchi, kǝrsǝ thlaˈtiyan wa.<verse eid="MRK 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 16:15" />Ndangkan tanda wa, “Ɗama kǝ hur heshi nat, kǝ ɓasawun kwastǝ ndiktǝɗiya pong nafchǝ nat. <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />Nat thla fǝrchi kit, chan kǝ fee baptisma, nan mbǝs shishingnda kǝ kweˈkǝchi. Nat thla sǝkcha paɗ fǝr wa kit wa, naa fee chakan mee. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />Naa Farta fǝran alkǝt fee fǝrchi kit kǝ nggǝta, kǝ chindǝ icha thla nech ɗǝf nafchǝ kǝ saka ndech inda. Hur thlǝm na, nandǝ rekandǝ hwaˈarchi kesh, naa ndǝ ndiktǝ paɗ, tǝ michi samǝn samǝn. <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />Nandǝ har wuruɓchǝ tǝ harchi yanda. Maa ǝ si ndǝ warkam ndi, nan chanda ǝna wa. Nandǝ ɗǝfan fee nech haˈchan harchi kǝ in, paɗ kǝ kǝndǝ kaɗi.”<verse eid="MRK 16:18" /></para>
  <para style="s">Tǝr fee Yesu kǝ hulafǝrta</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />Kǝrsǝ ndiktǝɗi mbuˈanda Chinda Yesu, tǝran kǝ fee kǝ hulafǝrta, chokkan tǝ harsǝm i Farta. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />Chek kǝmsichiyan kesh, nakandǝ ɓas kwastǝ ndikta chǝka tǝ yeni. Chinda paɗ mǝthlan tǝ tanda, nakan pǝnnan nafcha wa ɓasi kǝmsichiɗan yu kit si, tǝmɗi ǝna saka inɗi thlǝ nat ndǝ chǝta tǝ ndiktǝɗi thlǝ natndǝ ndikta.]<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>