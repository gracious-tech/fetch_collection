<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ROM" style="id">ROM Gaˈanda HA 46. All Gaanda ELISMAR SBB 01/10/2004, CROSS REF 25/09/2007 A.J.T.; CORRECTED 12/03/08</book>
  <para style="h">ROMAWECHA /toc 1ROMAWECHA /toc 2 ROM /mt YARA NDIKTI BULUS KƏMƊI /mt1 ROMAWECHA</para>
  <para style="toc3">Rom</para>
  <para style="toc2">Romans</para>
  <para style="toc1">Romawa</para>
  <para style="mt1">Romans</para>
  <chapter number="1" style="c" sid="ROM 1" />
  <para style="s">Nda ǝna</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1" />Yara ndiktǝɗiya ɓechan mǝɗi Bulus, mafati Yesu Kǝristi, thla ˈya fee ndi kǝ chok kǝ tatǝ kimshaˈyan. Paɗ tataˈan, kǝthlǝm ɓas ndiktǝ Farta. <verse eid="ROM 1:1" /><verse number="2" style="v" sid="ROM 1:2" />Kusheˈtaˈan thla mbinchan ndaˈan ɗǝftǝ Farta miyan kǝ choh, tǝmɗi fǝ shenuˈchǝ tǝ yahtǝyan, kǝɗ ǝnɗi yarandǝ fee ha hur Lawlawechi Farta fee chiɗ chiɗ. <verse eid="ROM 1:2" /><verse number="3" style="v" sid="ROM 1:3" />Kwastǝ ndiktǝɗi nech mbinchan ya nechan kǝ ɗar Waˈyan, Chinmǝn Yesu Kǝristi. Tǝmɗi fata nechan ǝ kwathl Dauda, <verse eid="ROM 1:3" /><verse number="4" style="v" sid="ROM 1:4" />kǝɗu pǝnchǝ fee ndi kǝ Waˈi Farta, tǝmɗi alkǝti Shemeta thla chiɗ chiɗ, tǝmɗi thlaˈtiyan hur mǝmatecha, ndaˈan nech kǝ Yesu Kǝristi Chinmǝn. <verse eid="ROM 1:4" /><verse number="5" style="v" sid="ROM 1:5" />Tǝmɗiyan, mbǝstǝmǝn kaakǝta chokmǝn kǝ kǝmsicha kǝthlǝm thlǝman, kǝ ˈyamǝn nat pong nafcha, kǝ fǝr ndǝ kit, kǝ fǝr ndǝ maanda. <verse eid="ROM 1:5" /><verse number="6" style="v" sid="ROM 1:6" />Thleya paɗ ǝ mbǝn tǝ wunchǝ fa, Kun tǝɗi ˈya Farta wunchi kǝ chok wun kǝ yi Yesu Kǝristi.<verse eid="ROM 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 1:7" />Kǝmɗi yowun nat kun tǝɗi nech ǝ Roma. Kun tǝɗi thlǝ mbǝndǝ Farta faɗan, ˈyakan wunchǝ paɗ kǝ chok wun kǝ nafchiyan fee nech chiɗ chiɗ.</para>
  <para style="p" vid="ROM 1:7">Kaakǝta tǝ kǝɓikaɗi thlaˈtǝ mǝɗi Farta Chinmǝn tǝ Chinda Yesu Kǝristi kǝ chok tǝ wunchi.<verse eid="ROM 1:7" /></para>
  <para style="s">Yahti Bulus kǝ ɗǝ kǝ Roma</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8" />Ə tǝrkwathl kanan nggǝt chan usoko Fartinchi, tǝmɗi Yesu Kǝristi kǝthlǝm kun nat, kǝthlǝm fee fǝr kusheˈtǝ fǝrkit ˈyowun chǝk tǝ yeni hur heshi nat. <verse eid="ROM 1:8" /><verse number="9" style="v" sid="ROM 1:9" />Farta, thla nati chan tera nat tǝ wanɗǝkaɗatinchi yi kwastǝ ndikta thla nech mbinchan yi Waˈyan, thla pǝncha wa nggǝt kuɗuktǝ tǝ wunchi weenmǝta <verse eid="ROM 1:9" /><verse number="10" style="v" sid="ROM 1:10" />Nggǝt shita, chǝka kwati ndat wa, tǝ yahti Farta, kǝ mbǝsi mbanda chǝka tǝ kǝni nakanya kǝ ɓi kǝmɗiyowun.<verse eid="ROM 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 1:11" />Kǝthlǝm nggǝt yitǝ ha kǝ wiˈyowunchi fa, kǝ fǝrowunchǝ mbǝs ǝn har yi shemeta thla nech ndǝksowunda. <verse eid="ROM 1:11" /><verse number="12" style="v" sid="ROM 1:12" />Ndat wa nggǝt tǝ kun, kǝ ndǝksamǝn raˈan tǝ fǝrkit ˈyamǝn, yina tǝ yuwun. <verse eid="ROM 1:12" /><verse number="13" style="v" sid="ROM 1:13" />Wanmanchina, yahchi si kǝ sǝnwun, kurɓani ɗǝf wanɗǝkaɗatsi kǝ wiˈyowun chi fa, kǝɗu paˈ kǝ nakanya nggǝma wandǝ inchǝ wa. kǝthlǝm yahchi si kǝ mbǝsi chekta ǝ mǝɗiyowun kǝɗ thla mbǝsti hur kwaan pong nafcha.<verse eid="ROM 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 1:14" />Heˈti Helenawechǝs indinchǝ, tǝ fee nawak chǝ kǝ Helenawecha, tǝ yi fǝ sǝn icha, tǝ fee sǝn wakchǝ ǝna. <verse eid="ROM 1:14" /><verse number="15" style="v" sid="ROM 1:15" />Kǝthlǝm ndaˈan chich fǝrti fatsi kaan, kǝ ɓasi kwastǝ ndikti Farta thla mbinchan, kǝmɗi kun tǝɗi nech ǝ Roma.<verse eid="ROM 1:15" /></para>
  <para style="s">Alkǝtǝ ndikti Farta</para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16" />Kǝthlǝm hariwu fat tǝ kwastǝ ndikta thla mbinchan yi sǝkta i Farta wa, kǝthlǝm ndaˈan nech kǝ alkǝti Farta, thla thlǝ fǝr chi hǝraˈta kǝmɗi chikawun fǝr chǝ kit, kǝmɗi Yahudawecha tǝrkwathl kanan, kǝn pong nafcha. <verse eid="ROM 1:16" /><verse number="17" style="v" sid="ROM 1:17" />Kǝthlǝm ǝ hur kwastǝ ndikta thla mbinchan i Farta, pǝn fee yowun mbanda thla naa nef mbǝs chok chiɗ chiɗ kǝta pangngǝn Farta, mbanan paɗ ndaˈan nech kǝ fǝr kit, thlaˈtǝ tǝrkwathl kanan kǝ ndukwaɗan, kǝɗ ǝnɗi natǝn kǝ yaraɗan ndat wa, “Nat thla nech chiɗ chiɗ tǝmɗi fǝr kit nan nat ha.”<verse eid="ROM 1:17" /></para>
  <para style="s">Sǝɓan Farta hwir kaɗ tǝ nafcha</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18" />Kǝthlǝm thlǝ pinchǝ fee hatǝ hwiri Farta thlaˈtǝ hulafǝrta, kǝ ɗar kumi para Farta nat, tǝ tar ɓǝɓifata yi nafcha fee thlǝ njekanchǝ kittaˈan, tǝmɗi tar ɓǝɓifechˈyanda. <verse eid="ROM 1:18" /><verse number="19" style="v" sid="ROM 1:19" />Kǝthlǝm nat ǝnɗi nafee mbahǝn sǝnda kǝ Farta, nechan hayang kǝmɗi yanda. Kǝthlǝm Farta pǝnandech kǝɗu. <verse eid="ROM 1:19" /><verse number="20" style="v" sid="ROM 1:20" />Kǝthlǝm fartǝɗi nggak tǝ fee tǝn heshi. Ichi Farta thla thlǝ mbahǝn waktǝ fee nat tǝ wenita, ndat wa alkǝˈyan yi kǝ kwekǝɗan tǝ choktiyan kǝ Farta, nechan hayang tǝmɗi ichiɗi tǝndǝn. Kǝthlǝm ndaˈan nafcha ǝ mban hǝraˈtǝ yandǝs wa.<verse eid="ROM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 1:21" />Chika nakan wa ǝ sǝndǝ Farta, nat tǝ kǝɗu manawandǝ kǝɗ Farta wa, chawandǝ usoko paɗ wa. Kaɗat ˈyanda chikan kǝ kohaɗan. Wanɗǝkaɗech ˈyanda sǝnwakcha ǝna, pong kaɗi. <verse eid="ROM 1:21" /><verse number="22" style="v" sid="ROM 1:22" />Thlǝ tǝrchanda wa ɗathl chanda, kǝɗu chokka ndǝ kǝ ɓam cha. <verse eid="ROM 1:22" /><verse number="23" style="v" sid="ROM 1:23" />Mbeɗan kandǝ maandǝ Farta thla thlǝ mǝr wakcha, tǝ saktǝ fati nefa thla thlǝ mǝrcha. Mbeɗan kandǝ ha tǝ saˈmbǝrcha fee tǝndǝ fee kǝɗ ɗingcha, tǝ yi ɗǝparecha, tǝ ˈYi weˈ tǝ ichiɗi thlǝ kah chǝ hwir haha.<verse eid="ROM 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24" />Kǝthlǝm ndaˈan fǝr kǝ Farta tandǝ kǝ thlǝnadǝ ɓǝɓi icha, thla nawakchǝ chǝdchǝɗ thla yah tǝ wanɗǝkaɗech ˈyanda, naka ndǝ ɓahandǝ fech ˈyanda kǝ raˈan. <verse eid="ROM 1:24" /><verse number="25" style="v" sid="ROM 1:25" />Mbenɗan kandǝ kittaˈan tǝ ɗi ha nech kǝ yi Farta tǝ lekta. Nakandǝ maanandǝ ichiɗi tahǝs tǝ fee, mǝni thla nggǝtchǝ minchi. Mǝthlan tǝɗi chaˈchǝ si kǝ chim fee anchi kǝ poriˈ. Kǝ chok kǝɗu.<verse eid="ROM 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26" />Kǝthlǝm ndaˈan fǝr kǝ Farta tanda kǝ yah ti wanfata fee thlǝ fǝrchǝ hartǝfata. Nǝssi yandǝ paɗ mbeɗa kandǝha kǝm ɗi nunef tǝ hish nef ha, thla nech keˈkeˈ si kǝɗ ǝnɗi tahǝs tǝ Farta, tǝ weˈ tǝ kǝmǝnɗi tahǝs waktǝ Farta. <verse eid="ROM 1:26" /><verse number="27" style="v" sid="ROM 1:27" />Kǝɗu paɗ hǝssa mbenɗan kandǝ kǝmndǝ ha tǝ nǝssa thla tahǝs tǝ Farta tǝ kǝmnda tǝ hǝssa kǝɗ fen. Hǝssa tǝ hǝssa nakan ndǝ thlǝnadǝ ǝna har tǝfatkaɗi, nakandǝ kaɓan indiyandǝ ɓǝɓi ǝna thla nech keˈkeˈ tǝ tanda kǝthlǝm ɓǝɓifechiɗi thlǝ chit nda.<verse eid="ROM 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28" />Nakan nawandǝ kim si kǝ sǝndǝ Farta wa, Fǝr kǝ Farta tanda kǝ koha kaɗata, yi chit ǝnɗi kǝm wakchǝ si kǝ chǝ fee wa. <verse eid="ROM 1:28" /><verse number="29" style="v" sid="ROM 1:29" />Ndiiɗ kandǝ kaɗi tǝ chika weˈtǝ yen kumi kaakǝta, tǝ ɓǝɓifata, tǝ yahti wanfata, tǝ atekrikǝta hur wanɗǝkaɗata, ndiiɗ ndǝ kaɗ tǝ sǝraˈta, tǝ ɓǝlfata, tǝ yaanda, lekta, tǝ pongǝn wanɗǝkaɗata. Fǝn nech kǝ fǝ kalwar micha, <verse eid="ROM 1:29" /><verse number="30" style="v" sid="ROM 1:30" />Tǝ fǝ sǝɓandǝ thlǝm nafchǝ kaɗi, tǝ fee nech kǝ atǝkrechǝ Farta, tǝ fǝ ˈyara fecha, tǝ fǝ thlaˈandǝ incha, tǝ fǝ maanandǝ inchi yanda, tǝ fǝ kaa mban chit ɓǝɓifecha, tǝ fee thlǝ fǝrawak chǝ maandǝ parchǝ nanda. <verse eid="ROM 1:30" /><verse number="31" style="v" sid="ROM 1:31" />Fen fǝ kumi ɗaathlcha, fee thlǝ ndiiɗa wakchǝ ɗǝf mee ha, fǝ kumi mbǝnfecha, tǝ fee thlǝ haɗawak tǝ ǝn tandǝ fa. <verse eid="ROM 1:31" /><verse number="32" style="v" sid="ROM 1:32" />Chika nakan wa ǝ sǝndǝ chakmeˈi Farta tǝ ndat wa, fee thlǝ nech thlǝnadǝ weˈtǝ inchiɗiya kǝmdǝs kǝ mǝrnda, kǝɗu ngga wa tǝthl thlǝnandǝ ichiɗiya ɗeng wa, thlǝ nechan ndǝ nggǝ maandǝ fee thlǝ nech chiɗan kǝɗu.<verse eid="ROM 1:32" /></para>
  <chapter eid="ROM 1" />
  <chapter number="2" style="c" sid="ROM 2" />
  <para style="s">Chak meˈi Farta keˈkeˈ si kǝ ɗar fee thlǝ chich ɓǝɓifata</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1" />Kǝthlǝm ndaˈan chaɗi thlǝ nech chakan me yowuna kǝ nden wa mban hǝraˈtiyo sǝ wa, chika wun nako. Kǝɗ ǝnɗi natu chakan mee yowuna, tǝ nen chakan mee indiˈyo. Kǝthlǝm chaɗi thlǝ nech naa ǝnɗi chit yowun naa ndǝɗwa wa, ndaˈan paɗ thlǝ natu thlǝnanda. <verse eid="ROM 2:1" /><verse number="2" style="v" sid="ROM 2:2" />Sǝn mǝn tǝ ndat wa chak meˈi Farta keˈkeˈ si kǝ ɗar fee thlǝ nech thlǝnandǝ ichiɗiya. <verse eid="ROM 2:2" /><verse number="3" style="v" sid="ROM 2:3" />Chǝ nefa, chaɗi thlǝ nech naa ǝnɗi ha sǝɓandǝ nafchǝɗi thlǝ nech chit kǝɗu, chǝ tǝ indiyo thlǝ thlǝnancho, chuchan fǝ wa no hǝraˈta tǝ chak meˈi Farta wa? <verse eid="ROM 2:3" /><verse number="4" style="v" sid="ROM 2:4" />Ndu paɗ tǝ nen njir tertǝ kaakǝti Farta wa, tǝ kǝris ǝn ˈyan, tǝ kumi wesha sǝɓtǝ hwira thla thlǝ chitǝn kaf ˈyo yu? Awi shinwen tǝ ndat wa, saktǝ kaakǝti Farta ndaˈan nech kaɓwech kǝ tǝrtǝ ha wa?<verse eid="ROM 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 2:5" />Kǝɗu tǝmɗi kwaˈkwaˈ tǝ inda thlǝ natu chita, tǝ kwaˈkwaˈ tǝ wanɗǝkaɗaɗi nech siyo, tǝ nen nggoman indiyo sǝɓtǝ hwiri Farta, thla nech pǝkwechi, fartǝ sǝɓtǝ hwiri Farta. Ə wanshengǝn ini, naa fee pǝn chakmeˈyan thla kǝmchǝ si. <verse eid="ROM 2:5" /><verse number="6" style="v" sid="ROM 2:6" />Farta “Nech tiyan chika wuni kǝnau tarchǝɗi thlǝnandǝn kaɗi.” <verse eid="ROM 2:6" /><verse number="7" style="v" sid="ROM 2:7" />Nan fǝr shishingnda thla nech tarat ha kǝ poriˈ, kǝmɗi fee kǝrischa tǝ thlǝnandǝ kwastǝ ichiɗi nech ndiˈchan, nakandǝ kaa maanda, tǝ kapakǝta tǝ tarat ha. <verse eid="ROM 2:7" /><verse number="8" style="v" sid="ROM 2:8" />Tǝ kǝɗu fee nech tǝ yah indǝf kaan, nakandǝ kar kittaˈan, hatǝ hwiri Farta, nan choktǝ fiyanda. Na Farta ɓahandata. <verse eid="ROM 2:8" /><verse number="9" style="v" sid="ROM 2:9" />Nat pong nefa thla thlǝ thlǝnanchǝ ɓǝɓifata nan sa mɓahta, nan sa nggwarkana. Nech fee tǝrkwathl kanan tǝ Yahudawecha, kǝna ɓat kǝ pong nafcha. <verse eid="ROM 2:9" /><verse number="10" style="v" sid="ROM 2:10" />Na Farta fǝr kapa kǝta tǝ maanda, tǝ kǝɓikaɗi kǝmɗi fee thlǝ chich kaa ǝna, tǝrkwathl kanan tǝ Yahudawecha kǝna ɓat kǝ pong nafcha. <verse eid="ROM 2:10" /><verse number="11" style="v" sid="ROM 2:11" />Kǝthlǝm Farta pǝnwa yahˈinda wa.<verse eid="ROM 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 2:12" />Nat fee chich ɓǝɓifata ngga ɓukwa tǝ sǝn kusiˈ wa, nandǝ tǝktǝkaɗi ngga nat tǝ kusiˈtaˈan wa. Kǝɗu nat fee chich ɓǝɓifata hur sǝn kusiˈ, naa fee chakanda mee tǝ kusiˈ. <verse eid="ROM 2:12" /><verse number="13" style="v" sid="ROM 2:13" />Kǝthlǝm ngga fee sǝkchǝ kusiˈtaˈan nech chokta kǝ chǝɗchǝɗ chaˈan pangngǝn Farta wa. Kǝɗu fee thlǝnanchǝ ǝnɗi mbuˈtǝ kusiˈ taˈan fen naa fee hǝraˈndata <verse eid="ROM 2:13" /><verse number="14" style="v" sid="ROM 2:14" />(Ma pong nafcha fee nawak tǝ kusiˈtaˈan ˈyandǝ si, pǝnandak fatˈyandǝs wa chǝndǝ ǝnɗi nda kusiˈ kaɗi. Thleya pinchan wa, fen tǝ indiyanda chokchandǝ kǝ kusiˈ tǝ ˈyi indiyanda. Chika mǝ nakan wa ǝ kusiˈ ˈyandǝs wa. <verse eid="ROM 2:14" /><verse number="15" style="v" sid="ROM 2:15" />Tar chiyanda ǝ pin wa, ǝnɗi mbuˈtǝ kusiˈ nechan kǝ yaraɗan hur wanɗǝkaɗech yanda. Kaɗatˈyanda mǝthlan mbuˈtǝ wa nechan kǝɗu. Kaɗatˈyanda nda ndat wa ǝ chindǝ ɓǝɓifata. Fartǝ yowuna thlǝ nechan nda ndat wa ǝnɗi chit nda keˈkeˈ si.) <verse eid="ROM 2:15" /><verse number="16" style="v" sid="ROM 2:16" />Ə fartǝɗiya Farta, nan chakan mee pong nafcha, kǝ ichiɗi thlǝ thlǝnandǝ ndǝ nda tǝ wuɓtǝfa, tǝmɗi Yesu Kǝristi, kǝ kusheˈtǝ kwastǝ ndiktǝ mbinchan ˈyi sǝkta thla natǝn ɓassa.<verse eid="ROM 2:16" /></para>
  <para style="s">Yahudawecha tǝ kusiˈ</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17" />Kǝɗu ma ndiin wa thlǝ Yahudawat nako, tǝ ndat wa ɗǝfcho fat kǝ kusiˈ, saɓ chǝ thlaˈndǝ kirsha tǝ Farta, <verse eid="ROM 2:17" /><verse number="18" style="v" sid="ROM 2:18" />Ma, shinin ǝnɗi yahtǝn paɗ shinin mban chakandǝ ichiɗi ha nech ndiˈchan, kǝthlǝm ǝ chaˈuchǝ kusiˈ har. <verse eid="ROM 2:18" /><verse number="19" style="v" sid="ROM 2:19" />Paɗ ǝ wathluchǝ wa chǝ nech kǝ thlǝ kǝs kalati komincha, chǝ ɗaˈkǝta thla thlǝ pǝnchǝ mǝta kǝmɗi fee nech hur wuthla, <verse eid="ROM 2:19" /><verse number="20" style="v" sid="ROM 2:20" />thla thlǝ chaˈan chǝ mɓamchǝ har, thla thlǝ chaˈanchǝ nafchǝ har nech kǝ yuwa tǝrtǝ ha, kǝthlǝm hur kusiˈ, hur indiyosi ˈyi sǝnda tǝ sǝnda ˈyi kittaˈan. <verse eid="ROM 2:20" /><verse number="21" style="v" sid="ROM 2:21" />Kǝɗu, chaɗi thlǝ nech chaˈandǝ nafchǝ har nggo mbahǝn chaˈan tǝ indiyo har wa? Chiɗi thlǝ ɓascha wa mǝ yarkǝ fee wa, chaɗana yerkǝwen wa? <verse eid="ROM 2:21" /><verse number="22" style="v" sid="ROM 2:22" />Chaɗi thlǝndech wa kǝ chinfe fǝlaukǝta wa, chaɗan chiwen wa? chaɗi thlǝnech wiɗek tar nɗǝhacha, yerkǝwen hur kǝtǝn nɗǝhachawa? <verse eid="ROM 2:22" /><verse number="23" style="v" sid="ROM 2:23" />Chaɗi thlǝ nech tarakta tǝ kusiˈ, awi, ngga tǝthl nen njir Farta, tǝ chendǝ kusiˈ kaɗ wa? <verse eid="ROM 2:23" /><verse number="24" style="v" sid="ROM 2:24" />Kǝɗ ǝnɗi natǝn kǝ yaraɗan laulawaɗan, “Thlǝ nech fee njirandǝ thlǝm Farta kaɗi hur pong nafcha kǝthlǝm kun.”<verse eid="ROM 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25" />Kittaˈan hecheta kaa ǝna, ma thlǝ parecho kusiˈ. Kǝɗu ma thlǝ perewen kusiˈchaˈan wa, hechetˈyo ngga nechan meeˈi ǝna wa. <verse eid="ROM 2:25" /><verse number="26" style="v" sid="ROM 2:26" />Paɗ ma nafɗi hechawakcha thlǝ perechan ichiɗi nda kusiˈ, nǝ fee tǝr ndi kǝɗ thla hechandǝ fee wa? <verse eid="ROM 2:26" /><verse number="27" style="v" sid="ROM 2:27" />Awi thla hechawakcha mǝthlan para kusiˈ, pǝɗan tǝ thla ha hechecha mǝthlan para kusiˈtaˈanwa.<verse eid="ROM 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 2:28" />Nefa ngga thlǝ Yahudawata wa kǝthlǝm nat ǝ chimanda ndu ndat wa ǝ hechan fee hur fata wa. <verse eid="ROM 2:28" /><verse number="29" style="v" sid="ROM 2:29" />Auwa, nefa thla nech kǝ thlǝ Yahudawata nechan hur wanɗǝkaɗata, hechata ˈyi kit ndaˈan nechan kǝ hechata hur wanɗǝkaɗta tǝmɗi Shemeta ngga tǝmɗi yara kusiˈ wa. Weˈtǝ nef ini Farta, thlǝ nech chim anchi, ngga wanpong nefa wa.<verse eid="ROM 2:29" /></para>
  <chapter eid="ROM 2" />
  <chapter number="3" style="c" sid="ROM 3" />
  <para style="s">Thlǝ ndiiɗan chǝ Farta ɗǝf meˈyan ha</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1" />Mǝ nech kǝ ndat wa thlǝ Yahudawata nako? Ai chekti hecheta? <verse eid="ROM 3:1" /><verse number="2" style="v" sid="ROM 3:2" />Aa, chektǝ si chik tǝ yen mbenna. Tǝrkwathl kanan, Yahudawecha fen fǝranda Farta ndiktiyan kǝ harˈyanda.<verse eid="ROM 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 3:3" />Hacha, ma fowunsi hurnada pǝnwakchǝ kumi fǝr kit kǝni? Mǝ nech kǝ saktǝ ǝnɗiya? Kǝthlǝm kumi kaakǝt ˈyanda nan ɗǝf Farta kǝ wulantǝ ndiiɗa ndǝ kaakǝt ˈyan ha hacha wa? <verse eid="ROM 3:3" /><verse number="4" style="v" sid="ROM 3:4" />Ngga kǝɗu wa. chika ngguɗyah. Malan kǝ sǝn fee wa Farta mǝthlan nech tǝ kit fa chika mǝ nakan wa chika wun nefa thlǝ lektǝ nakan. Kǝɗ ǝnɗi natǝn kǝ yaraɗan hur laulawaɗan ndat wa.</para>
  <para style="q1" vid="ROM 3:4">“Nɗiktiˈyo kitsi,</para>
  <para style="q2" vid="ROM 3:4">Paɗ ǝ thlǝ thlǝn pang kǝˈin kǝ ɓǝra chika mii, ma tǝn fee tawus ǝna chit ˈyo.”<verse eid="ROM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 3:5" />Kǝɗu ma kumi kaakǝt ˈyamǝn nech pǝn kafati Farta hayang, mǝ natmǝn ndata? Namǝn ndat wa, nga Farta thlǝ kafata wa, ma fǝramǝn tǝ ɓahta? “Tǝni fǝr kaɗanan ha ndak.” <verse eid="ROM 3:5" /><verse number="6" style="v" sid="ROM 3:6" />Auwa, nga kǝɗu wa. Ma kǝɗuyu wa, tǝkǝni naa Farta chakan me heshi? <verse eid="ROM 3:6" /><verse number="7" style="v" sid="ROM 3:7" />Ma kumi fǝr kit inchi tǝ lektinchi, Kittaˈan i Farta mǝthlan chekandǝ pǝn fata, saɓ chekan kan fǝran maanda, kǝthlǝm mi naa fee kǝnita kǝ ɗar ndat wa, nggǝt thlǝ ɓǝɓifata? <verse eid="ROM 3:7" /><verse number="8" style="v" sid="ROM 3:8" />Ma kǝɗu yuwa, mǝ nawak tǝ mǝn ɗǝt kǝ pang tǝ chit ɓǝɓi tarchaˈan, kǝthlǝm kǝ ɓǝ kaa ǝn hacha wa? kǝɗ ǝnɗi thlǝ naa fowun leka ǝn ndǝ kafa tǝ ndat wa, thlǝ mbuˈchaˈan kǝɗu. Chak mii ɗi naa fee chanda weˈtǝ feya keˈkeˈ si.<verse eid="ROM 3:8" /></para>
  <para style="s">Chik arta nggǝ thlǝ kafatsi wa</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9" />Mǝ nat ǝn mbuˈta? Nggaˈan Yahudawecha ǝ mbraˈǝn takǝchaˈan ha wa? Auwa, chika top kǝɗa. Kǝthlǝm ɗǝfa ǝn Yahudawech tǝ pong nafcha ndat wa sǝɓandǝ kaɗi, ndat wa nat nda ɓǝɓifat nech chit alkǝt tǝ tanda. <verse eid="ROM 3:9" /><verse number="10" style="v" sid="ROM 3:10" />Kǝɗ thla natǝn kǝ yaraɗan hur ndikti Farta tǝ ndat wa.</para>
  <para style="q1" vid="ROM 3:10">“Yowun si nech tǝ kafat fa wa,</para>
  <para style="q2" vid="ROM 3:10">neˈsǝ wa, chika arta.<verse eid="ROM 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ROM 3:11" />Yowun si thlǝ wathlandǝ ǝna wa,</para>
  <para style="q2" vid="ROM 3:11">yowun si thlǝ kech Farta wa.<verse eid="ROM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ROM 3:12" />Nat nda ɗafǝrndǝ kaɗi, kang kangndǝ kirshi Farta fa,</para>
  <para style="q2" vid="ROM 3:12">Yowun si thlǝ nech thlǝnandǝ kafata wa,</para>
  <para style="q2" vid="ROM 3:12">yowun si wa, chika arta.”<verse eid="ROM 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ROM 3:13" />“Nggor nggorech ˈyanda kǝɗ kwi mǝrcha thla nech cha.</para>
  <para style="q2" vid="ROM 3:13">Tarchi wan shenuˈchi yanda ndaˈan nech kǝ tar lek nafcha.”</para>
  <para style="q1" vid="ROM 3:13">“Ya hafchisi hur kǝsǝmǝn michi yanda.”<verse eid="ROM 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="ROM 3:14" />“Michi yanda ndiiɗ kaɗ tǝ ɓǝɓǝ mee tǝ ˈyara fata.”<verse eid="ROM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ROM 3:15" />“Thlǝ weshachandǝ ha tǝ thlǝrandǝ fer kaɗi,<verse eid="ROM 3:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="ROM 3:16" />Nat mǝɗi parat nda, chat tǝktǝkaɗi tǝ sǝɓtǝ hwira.<verse eid="ROM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ROM 3:17" />Paɗ sǝn wandǝ mban kǝɓikaɗ wa.”<verse eid="ROM 3:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="ROM 3:18" />“Kwarandǝ Fartǝs ǝ wenitanda wa.”<verse eid="ROM 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19" />Nakanya sǝnmǝn tǝ ndat wa nat ǝnɗi thlǝ mbuˈtǝ kusiˈ, tǝn mbuˈandǝ fee nech kan ɗukwatˈyan. Kǝthlǝm kǝ nggǝlan fee meˈi chika wuni, paɗ nat nafchi heshi kǝ sǝnda wa, nechan kan ɗukwati chak meˈi Farta. <verse eid="ROM 3:19" /><verse number="20" style="v" sid="ROM 3:20" />Tǝ mban para ǝnɗi nda kusiˈ wa kǝ chǝ fee, yowun si nech chok tǝ chǝɗchǝɗ kǝtfa panggǝn Farta wa. Ənɗi thlǝ chit kusiˈ taˈan kǝ pǝnan tǝ nef ɓǝɓifatˈyan.<verse eid="ROM 3:20" /></para>
  <para style="s">Kafata tǝmɗi fǝr kit</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21" />Kǝɗu nakanya ǝ pǝn fee yowun mbanda ˈYi mbǝs kafata ǝ panggǝn Farta. Ngga tǝmɗi kusiˈ wa, chika nakan wa kusiˈ tǝ fee thlǝ ndikcha tǝ yahti Farta, fǝr ndǝ sǝnansi kǝ ndaˈan. <verse eid="ROM 3:21" /><verse number="22" style="v" sid="ROM 3:22" />Kafaɗiya i Farta, thlǝ mbǝs chǝ fee tǝmɗi fǝr kit, hur Yesu Kǝristi. Kafaɗiya ˈYi nat nafcha fee fǝr chǝ kit, nggǝ ndat sǝ wa thlǝ Yahudawata samǝn ha tǝ pong nefa wa, <verse eid="ROM 3:22" /><verse number="23" style="v" sid="ROM 3:23" />Kǝthlǝm nat nafcha ǝ chindǝ ɓǝɓifata, paɗ ǝ wulandech saˈ tǝ kǝ naa maandi Farta. <verse eid="ROM 3:23" /><verse number="24" style="v" sid="ROM 3:24" />Kǝɗu kǝ ɓǝra kaakǝt ɗi chaa ndǝ Farta chika wuni pafǝn, chika wuni mbǝstǝ chokta ˈYi kumi sǝɓandǝ ǝn kaɗi pangngǝn Farta tǝmɗi Kǝristi Yesu. <verse eid="ROM 3:24" /><verse number="25" style="v" sid="ROM 3:25" />Farta fǝr chan Yesu kǝ chok kǝnau pafǝn, ˈYi tǝr heˈti ɓǝɓifechˈyamǝn, kǝthlǝm tǝmɗi ferˈyan, fǝr pafǝnˈyan nan kalandǝ nafchǝ ɓǝɓifech ˈyandǝ ha, tǝmɗi fǝr kitˈyanda. Chich Farta thleya kǝthlǝm kǝ pǝn tǝ kafatˈyan, kǝthlǝm choh hur kǝris ǝn ˈyan, tǝran kan chimandǝ kaɗi ǝ ɓǝɓifechiɗi chit fee. <verse eid="ROM 3:25" /><verse number="26" style="v" sid="ROM 3:26" />Kǝɗuyu Farta pǝntǝ kafatˈyan ǝ wan shengngǝnɗiya, kǝthlǝm mǝthlan tǝ indiyan thlǝ kafat nakan, paɗ thlǝ ɗǝf chan nat thla thlǝ fǝrchǝ kit kǝ Yesu, kǝ mbǝs tǝ chok sǝɓa waktǝˈǝn kaɗi ǝ pangngǝn Farta.<verse eid="ROM 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27" />Ma Kǝɗuyu, kǝ mǝ natmǝn nat thlaˈandǝ kirsha? Ə mban thlaˈandǝ kirshawa. Tǝ yen mbenna mbǝhandǝ fee kaɗi, tǝmɗi chit tar chiɗi mbuˈtǝ kusiˈ yi Musa wa ngga kǝɗu wa, tǝmɗi fǝr kit ndak. <verse eid="ROM 3:27" /><verse number="28" style="v" sid="ROM 3:28" />Kǝthlǝm ǝ nggǝmamǝn tǝ ndat wa tǝmɗi fǝr kit, thlǝ mbǝstǝ fee chok ta kǝ thlǝ sǝɓawaktǝ kaɗi ǝ pangngǝn Farta, ngga wa tǝmɗi chit tar kusiˈ yi Musa wa. <verse eid="ROM 3:28" /><verse number="29" style="v" sid="ROM 3:29" />Ndu Farta, Farta Yahudawech ndak wa? Auwa, ngga ˈYi nafcha fee nawak chǝ kǝ Yahudawecha wa? Kittaˈan Farta i pong nafchǝ nakan paɗ. <verse eid="ROM 3:29" /><verse number="30" style="v" sid="ROM 3:30" />Farta arta. Nan ɗǝf fǝ hechecha kǝ mbǝs ndǝ chok ta kǝ fee sǝɓawakchǝ ǝn kaɗi kafˈyan tǝmɗi fǝrkit, kǝɗu paɗ fee hechewakcha nan ndǝ mbǝs chokta kǝ fee sǝɓawak chǝ ǝn kaɗi ǝ pangngǝnan tǝmɗi fǝrkit. <verse eid="ROM 3:30" /><verse number="31" style="v" sid="ROM 3:31" />Hachaa, tǝ mbǝhamǝn kusiˈ kaɗi kǝthlǝm fǝrkit tǝɗiya wa? Chika ngguɗyeh. Kǝ kwar ndaˈan, nggǝmǝn wathlandǝ kusiˈtaˈan ha.<verse eid="ROM 3:31" /></para>
  <chapter eid="ROM 3" />
  <chapter number="4" style="c" sid="ROM 4" />
  <para style="s">Ibrahim chok chǝɗchǝɗ pangngǝn Farta tǝmɗi fǝr kit</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1" />Kǝɗu, mǝ natmǝn ndata kǝ indi Ibrahim, kaakat kaakechmǝn tǝmɗi fata? <verse eid="ROM 4:1" /><verse number="2" style="v" sid="ROM 4:2" />Ma mbǝs chǝ Ibrahim chok chǝdchǝɗ kǝta ǝ pangngǝn Farta, tǝmɗi tarchiyan hacha, ǝn ˈyansi thla natǝn hupandǝ kirshi si. Kǝɗu taˈan ngga ǝ pangngǝn Farta wa. <verse eid="ROM 4:2" /><verse number="3" style="v" sid="ROM 4:3" />Mǝ nda ndikti Fartaˈan? “Fǝr Ibrahim kit kǝ Farta, fǝr kittiˈini ˈyanyu shengngan fee tǝ ndat wa, kaakǝta kǝmɗiyan.”<verse eid="ROM 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 4:4" />Nafɗi nech chit tar tita, titiyan ngga pafǝn wa, kǝnau terˈyan. <verse eid="ROM 4:4" /><verse number="5" style="v" sid="ROM 4:5" />Thla thlǝ chiwak chǝ tar tita, paɗ fǝr tǝ kit kǝmɗi Farta, thla thlǝ hǝraˈanchǝ fee nawakchǝ chǝdchǝɗ. Thlǝ shengngan chǝ fee fǝrkit ˈyan, tǝ ndat wa, kaakǝt hacha. <verse eid="ROM 4:5" /><verse number="6" style="v" sid="ROM 4:6" />Kǝɗu paɗ mbuˈtǝ Dauda kǝ ɗar mbǝsˈǝn har, nafɗi thla shengnga ndǝ Farta kaakǝta kǝmɗiyan, ngga kǝthlǝm tǝ chit tar tita wa. Nda kan wa,<verse eid="ROM 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ROM 4:7" />“Fe mbǝsˈichi har nafchǝdi</para>
  <para style="q2" vid="ROM 4:7">kalandǝ fee, ɓǝɓifech ˈyandǝ ha,</para>
  <para style="q2" vid="ROM 4:7">fee paɗ kalandǝ fee ɓǝɓifech ˈyandǝ ha.<verse eid="ROM 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ROM 4:8" />Thlǝ mbǝs ǝn har nafɗi,</para>
  <para style="q2" vid="ROM 4:8">shengnga wak tǝ Farta ɓǝɓifech ˈyan chika ngguɗyah.”<verse eid="ROM 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9" />Mbǝsˈǝnaɗi har ya yi fee hecha ndǝ fee ndakwa, ndu nat tǝ fee hecha wak tǝ fee wa? Ai, ǝnɗi thlǝ natmǝm mbuˈta ndaˈan nech wa, “Shengngan fee fǝr kit i Ibrahim ndat wa, kaakǝta kǝmɗiyan.” <verse eid="ROM 4:9" /><verse number="10" style="v" sid="ROM 4:10" />Kǝɗu, tǝ yen mbenna shengnga ndǝ fee kaakǝt ɗiyan ya? Shengngan chǝ fee, kǝn fee hechanda wa, ndu kǝrsǝ hechet ˈyan wa?<verse eid="ROM 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 4:11" />Hecheta thla chandǝ fee Ibrahim tǝn kǝ wanɗǝsǝnda, thla wathlanchǝ ha tǝ ndat wa, mbǝs chan kaakǝta tǝmɗi fǝrkit thla nech siyan, fartǝɗi hechawak tǝ fee kwaɗǝn. Kǝthlǝm ndaˈan mǝthlan nech kǝ chinda kǝmɗi fee fǝr chǝ kit paɗ hechawu fee tanda wa, kǝthlǝm kǝ shengngan fee kaakǝt tandǝ kaf paɗ. <verse eid="ROM 4:11" /><verse number="12" style="v" sid="ROM 4:12" />Paɗ Ibrahim nech kǝ chinda kǝmɗi fee hechecha, ngga fee hechandǝ fee tandǝ ndak wa, kǝɗu fee thlǝ nech wiˈta hur fǝrkit, thla nech si chinmǝn Ibrahim kǝn fee hechanda.<verse eid="ROM 4:12" /></para>
  <para style="s">Dǝf meˈi Farta tǝmdi fǝr kit.</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13" />Ɗǝf mii ɗi chandǝ fee Ibrahim waa tǝ kwathlan, ndat wa, nan chokta kǝ thlǝ sǝm kǝrsǝ mǝrta yi heshi, ngga tǝmɗi kusiˈ chandǝ fee wa, kǝthlǝm tǝ fǝr tǝ kit hacha, ndaˈan chicha thlǝt Farta anchi kǝ thlǝ kafat hacha. <verse eid="ROM 4:13" /><verse number="14" style="v" sid="ROM 4:14" />Ma fee thlǝ parech kusiˈ tandǝ nech nat kǝ fǝ sǝm kǝrsǝ mǝrcha, awi, fǝrkit chok kǝ koha ǝna, ɗǝf mii yan chok wa kǝɗ ngga ǝna wa. <verse eid="ROM 4:14" /><verse number="15" style="v" sid="ROM 4:15" />Kǝthlǝm kusiˈ thlǝ kaɓchan sǝbtǝ hwiri Farta. Mǝɗi nggawak tǝ kusiˈsi, nggǝ talandǝ kusiˈ sǝ wa.<verse eid="ROM 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 4:16" />Kǝthlǝm ndaˈan, ɗǝf miyan thlǝ ɓechan tǝmɗi fǝr kit, kǝthlǝm kǝ chok wa tǝmɗi kaakǝta, kǝ wathlanchi fee nech kǝ kwathl Ibrahim, ngga kǝmɗi fee nech kan ɗukwati kusiˈ ndak wa, kǝɗu fee naa fǝr kit ˈyanda kǝɗ Ibrahim. Mǝthlan nech kǝ chinmǝn nat. <verse eid="ROM 4:16" /><verse number="17" style="v" sid="ROM 4:17" />Kǝɗ ǝnɗi natǝn kǝ yaraɗan ndat wa, “Ɗǝfinchǝ wechi kǝ chokin kǝ chinda kǝmɗi nafchi hahi chǝ terchan.” Mǝthlan nech kǝ chinmǝn ǝ panggǝn Farta, thla fǝrtǝn kitsi. Mǝthlan thlǝ fǝr chǝ shishinggǝnchǝ kǝmɗi mǝmatecha, thlǝ ˈyechan ichiɗi choh nawakchǝ si kǝ nden wa tan ndǝ si.<verse eid="ROM 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 4:18" />Paɗ Ibrahim chika mǝ nakan wa, nggǝ ǝna chit ˈyansi yi ɗǝf wanɗǝkaɗatsi fiyan wa, chat nakan ɗǝftǝ si. Fǝr tǝ kit wa nan chok ta kǝ chin pong nafchǝ terchan, kǝɗ ǝnɗi mbuˈandǝ fee tǝ ndat wa, “Kǝɗaya naa kwathlchu terta.” <verse eid="ROM 4:18" /><verse number="19" style="v" sid="ROM 4:19" />Fǝr kit ˈyan chi wa hashas wa, ɗǝ pawa sherkǝt ˈyan wa, kǝthlǝm hurech ˈyan sheˈ kumchit kum arta ǝ fartǝ ini, ɗǝ pa wa tǝ ndat wa, Saratu kware ya wa. <verse eid="ROM 4:19" /><verse number="20" style="v" sid="ROM 4:20" />Chiwa tuˈta tǝ ɗǝf meˈi Farta wa, tǝ pǝn kumi fǝr kit wa, kǝɗu chekan kan alkǝta hur fǝr kit ˈyan, nakan maanadǝ Farta. <verse eid="ROM 4:20" /><verse number="21" style="v" sid="ROM 4:21" />Wathlanchi ha hur wanɗǝkaɗat ˈyan ndat wa, Farta alkǝtˈyansi kǝ chit ǝnɗi ɗǝftǝn miyan wa nan chita. <verse eid="ROM 4:21" /><verse number="22" style="v" sid="ROM 4:22" />Ndaˈan chicha, “Shengnga ndǝ fee fǝr kit i Ibrahim kǝ kafata, kaf ˈyan.” <verse eid="ROM 4:22" /><verse number="23" style="v" sid="ROM 4:23" />Thleya ndiktǝɗiya, “Ə shengngan fee kafˈyan,” ngga kǝthlǝm mǝthlan ichiɗan yara fee wa. <verse eid="ROM 4:23" /><verse number="24" style="v" sid="ROM 4:24" />Kǝɗu yaran chǝ fee thleya kǝthlǝm nggǝmǝn paɗ, nggǝmǝn tǝɗi naa Farta shengnga mǝnda wa nggǝmǝn fǝ kafecha, nggǝmǝn tǝɗi fǝr chǝ kit kǝmɗi yan, mǝthlan tǝɗi thlaˈanchǝ Yesu Chinmǝn, hur mǝmatecha. <verse eid="ROM 4:24" /><verse number="25" style="v" sid="ROM 4:25" />Kǝthlǝm ɓǝɓifechˈyamǝn fǝr tǝ fee Yesu kǝ mǝrta, paɗ thlaˈan fee tǝ shishingndǝ fa, kǝthlǝm kǝ mbǝs mǝn chokta kǝ fǝ sǝ ɓawakchǝˈǝn kaɗi ǝ panggǝn Farta.<verse eid="ROM 4:25" /></para>
  <chapter eid="ROM 4" />
  <chapter number="5" style="c" sid="ROM 5" />
  <para style="s">Kǝnau choktǝ kǝ thlǝ sǝɓawakchi ǝn kaɗi pangǝn Farta</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1" />Kǝthlǝm ndaˈan, mbǝsmǝn choktǝ kǝ fǝ sǝɓawakchi ǝn kaɗi ǝ pangngǝn Farta tǝmɗi fǝr kit, kaɓikaɗi ˈyamǝn si tǝ Farta tǝmɗi Chinmǝn Yesu Kǝristi. <verse eid="ROM 5:1" /><verse number="2" style="v" sid="ROM 5:2" />Tǝmɗiyan mbǝstǝ mǝn yimnda kǝ hur kaakǝt ɗiya, thla nakanya thlar tǝmǝn si, tǝmɗi fǝrkit ˈyamǝn. Paɗ nggǝmǝn thlaˈandǝ kirsha tǝ ɗǝf kǝfat si ˈYi mbǝs maanɗiya i Farta. <verse eid="ROM 5:2" /><verse number="3" style="v" sid="ROM 5:3" />Ngga ndaˈan ndak wa, kǝthlǝm paɗ nggǝmǝn thlaˈandǝ kirsha hur ɓahtiyamǝn ha, kǝthlǝm ǝ sǝnmǝn wa ɓahtǝha thlǝ kaɓchan kǝrǝs ǝna, <verse eid="ROM 5:3" /><verse number="4" style="v" sid="ROM 5:4" />kǝrǝs ǝna, thlǝ ɓechan tǝ nat ha ndiˈchan, nat ha ndiˈchan thlǝ ɓechan tǝ ɗǝf wanɗǝkaɗat si. <verse eid="ROM 5:4" /><verse number="5" style="v" sid="ROM 5:5" />Paɗ dǝf wanɗǝkaɗat si, nech ɗǝf minchi kǝ haraminchǝ fata wa chika ngguɗyah, kǝthlǝm Farta thlǝr tǝ kafatˈyan kǝ hur wanɗǝkaɗech ˈyamǝn, tǝmɗi Shemeti Farta, thla fǝramǝndǝ fee.<verse eid="ROM 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6" />Fartǝɗi nawak tǝ alkǝt si fiyamǝn kwaɗǝn, keˈkeˈ ǝ wanshengngǝn ɗi kǝmchǝ si mǝr kǝ Kǝristi kǝthlǝm fee thlǝ para wakchǝ Farta. <verse eid="ROM 5:6" /><verse number="7" style="v" sid="ROM 5:7" />Nan nat ˈyangˈyang kǝ mbǝs fee yowuna, kǝ fǝr tǝ shishingndi yan kǝthlǝm thlǝ kafata. Chika mǝ nakan wa, maˈ ya kǝthlǝm thlǝ kafata, yowuna nan yahtǝsi kǝ fǝr tǝ shishingndi yan. <verse eid="ROM 5:7" /><verse number="8" style="v" sid="ROM 5:8" />Kǝɗu paɗ Farta wathlan chi ya mǝn ha, tǝ kafaɗi thlǝ natǝn chamǝnda. Ndat wa kǝ peˈkamǝn kǝ fǝ ɓǝɓifecha, Kǝristi mǝrchan kǝthlǝm nggǝmǝn.<verse eid="ROM 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 5:9" />Kǝɗ thlǝ nakan wa, hǝraˈamin chǝ fee nakanya tǝmɗi ferˈyan, awi ǝnɗi natǝn chamǝnda nan mbǝrandǝ thle ya ha, nan hǝraˈamǝnda hur sǝɓtǝ hwiri Farta. <verse eid="ROM 5:9" /><verse number="10" style="v" sid="ROM 5:10" />Kǝ peˈchamǝn kǝ fee thlǝ chich atekrikǝt tǝ Farta, mbǝnaminchǝ fee kaɗi tǝ anchi tǝmɗi mǝrti Waˈyan. Kǝɗu, kǝɗ mbǝnamǝn kǝ fee kaɗya, naa fee hǝraˈamǝnda tǝmɗi natˈyan ha tǝ shishingndǝ fa. <verse eid="ROM 5:10" /><verse number="11" style="v" sid="ROM 5:11" />Ngga kǝɗuyu ndak naa ǝnaɗan wa, kǝɗu nechamǝn thlaˈandǝ kirsha tǝmɗi Chinmǝn Yesu Kǝristi, thla nech tǝmɗi yan nakanya tahsandǝ fee pǝthlǝr mǝn kaɗi tǝ Farta.<verse eid="ROM 5:11" /></para>
  <para style="s">Mǝrta tǝmɗi Adamu, shishingndǝ paɗ tǝmɗi Kǝristi</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12" />Kǝthlǝm ndaˈan, kǝɗ ǝnɗi yimndǝ ɓǝɓifata kǝ hur heshi tǝmɗi nef arta, ɓǝɓifat paɗ ɓechan tǝmɗi mǝrta. Nakanya nat nafcha chǝndǝ ɓǝɓifata, kǝthlǝm ndaˈan, mǝrta chokkan kǝ ˈYi chika wuni. <verse eid="ROM 5:12" /><verse number="13" style="v" sid="ROM 5:13" />Wan shǝgngǝnɗi fǝr waktǝ Farta kusiˈ ˈyan kwaɗǝn, ɓǝɓifata mǝthlan si hur heshi. Farta yara wa ǝn kǝ ɗar ɓǝɓifata wa, kǝthlǝm fǝr wa kusiˈ kwaɗǝn wa. <verse eid="ROM 5:13" /><verse number="14" style="v" sid="ROM 5:14" />Nat tǝ kǝɗuyu, mǝrta chit kuturakta thlaˈta ǝ thlǝhati Adamu kǝ thlǝhati Musa, saɓ chika kǝ ɗar fee chewak chǝ kusiˈ kaɗi, kǝɗ ǝnɗi chit Adamu, thla nech kǝ saktǝ thla nech ɓaɗan.<verse eid="ROM 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 5:15" />Kǝthlǝm fǝr pafǝn tǝɗiya nechan samǝn ha tǝ ɓǝɓifaɗan. Ma tǝmɗi ɓǝɓifati nafɗi artiya ndat wa Adamu, mǝrtǝ nafchǝ terchan. Mǝ nechan choktǝ wa kǝni, kaakǝti Farta, tǝ kǝnau pafǝn tǝɗi natǝn fǝrta, tǝmɗi kaakǝti nafɗi artiya Yesu Kǝristi, nan wethlǝ ha kǝ ɗar nafchǝ terchan. <verse eid="ROM 5:15" /><verse number="16" style="v" sid="ROM 5:16" />Fǝr pafǝn i Fartǝɗiya ngga nechan kǝɗ heˈtǝ ɓǝɓifati nafɗiya wa. Chak miyan thla chit fee kǝ ɗar ɓǝɓifati nafɗi artǝ yu, ndaˈan ɓech tǝ chak mee ˈYi tǝktǝkaɗi. Kǝɗu pafǝn tǝɗiya thla chit fee kǝ ɗar ɓǝɓifech terchan, ɓi tǝ mban hǝraˈta ǝ ɓǝɓifechǝɗi chitmǝn terchan. <verse eid="ROM 5:16" /><verse number="17" style="v" sid="ROM 5:17" />Ma paɗ kǝthlǝm ɓǝɓifaɗi Adamu ya hacha, mǝrtǝ chit kuturakta, nggǝ fee kaɗan tǝ thleya tǝ thla chit Yesu wa. Nafchǝɗi chandǝ Farta kaakǝt tandǝ terchan, nggǝrandech kaɗ kǝ chok ndǝ tǝ kaakǝtfa ǝ panggǝnan, nandǝ chokta tǝ shishingndǝ fa kǝ chindǝ kuturakta tǝmɗi nafɗi artiya Yesu Kǝristi.<verse eid="ROM 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 5:18" />Kǝɗu, kǝɗ ǝnɗi kaɓtǝ ɓǝɓifati nef arta chak mee, kǝ indi nafchǝ nat, kǝɗu paɗ tar kaakǝti nafɗi artǝ yu Yesu Kǝristi chokkan wa, ndaˈan ɗǝfchǝ nafcha kǝ chok ndǝ kǝ fǝ kafecha ǝ panggǝn Farta. Nan ɗǝf nafchǝ nat kǝ mbǝs ndǝ shishingnda. <verse eid="ROM 5:18" /><verse number="19" style="v" sid="ROM 5:19" />Kǝɗ ǝnɗi naa nafchǝ terchan choktǝ kǝ fǝ ɓǝɓifecha tǝmɗi kumi fǝr maandi nef arta, kǝɗu paɗ tǝmɗi fǝr maandi nef arta, naa fee nggǝrandǝ nafchǝ terchan kǝ chok ndǝ tǝ kaakǝt fa.<verse eid="ROM 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 5:20" />Ɓech Farta tǝ Kusiˈ ˈyan, kǝthlǝm ɓǝɓifata kǝ chikesh hayang. Kǝɗu ǝ mǝɗi naa ɓǝɓifat chekta, kaakǝti Farta mbǝran tǝ chektǝ ha kaan paɗ. <verse eid="ROM 5:20" /><verse number="21" style="v" sid="ROM 5:21" />Kǝthlǝm ndaˈan, kǝɗ ǝnɗi naa ɓǝɓifata chit kuturakta kǝ ɓǝra mǝrta, kǝɗu paɗ kaakǝti Farta nan chit kuturakta kǝ ɗar nat ha ˈYi kafata, ǝ panggǝn Farta. Kǝɗu kǝ mbǝs mǝn shishingnda thla kǝ poriˈ, tǝmɗi Chinmǝn Yesu Kǝristi.<verse eid="ROM 5:21" /></para>
  <chapter eid="ROM 5" />
  <chapter number="6" style="c" sid="ROM 6" />
  <para style="s">Mǝrtǝ kaɗ kǝ ɓǝɓifata, nat ha kǝ Kǝristi</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1" />Ma kǝɗu, mǝ nat mǝn ndat hacha? Namǝn ɗit kǝ pang tǝ nat ha hur ɓǝɓifata kǝthlǝm kǝ chek kaakǝ ti Farta wa? <verse eid="ROM 6:1" /><verse number="2" style="v" sid="ROM 6:2" />Ngga kǝɗu wa. chika ngguɗyah. Ai tapi mǝrmǝn kǝ ɓǝɓifata. Mǝchicha nat mǝn ɗǝt kǝ pangga tǝ nat ha hur ɓǝɓifata? <verse eid="ROM 6:2" /><verse number="3" style="v" sid="ROM 6:3" />Awi sǝn wowun wa nat nggǝmǝn tǝɗi chamǝndǝ fee Baptisma kǝ hur Kǝristi Yesu, chamǝnchǝ fee Baptisma kǝ hur mǝrtiˈyan hacha wa? <verse eid="ROM 6:3" /><verse number="4" style="v" sid="ROM 6:4" />Ndat wa, tǝmɗi Baptisma ˈyamǝn tǝ thlohaminchǝ fee ɓukwa tǝ anchi, chok mǝn paɗ arta tǝ anchi hur mǝrtiyan, kǝthlǝm kǝɗ ǝnɗi thlaˈandǝ fee Kǝristi thlaˈtǝ hur mǝmatecha tǝmɗi alkǝti thlǝ maanda Chinda, Kǝɗu paɗ nggǝmǝn kǝ chokmǝn kǝ yuwa nat ha.<verse eid="ROM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5" />Kǝthlǝm kǝɗ nakan wa chokmǝn arta tǝ anchi hur weˈtǝ mǝrtiyan, nggǝ tutǝs wa namǝn choktǝ arta tǝ anchi hur thlaˈtiyan thlaˈtǝ hur mǝmatecha kǝɗu paɗ naafe thlaˈamǝnda. <verse eid="ROM 6:5" /><verse number="6" style="v" sid="ROM 6:6" />Sǝn mǝn paɗ tǝ ndat wa ǝ kukwan fee teri fechˈyamǝn ˈyi choh ɓukwa tǝ anchi, kǝthlǝm kǝ mbǝhan fee alkǝti ɓǝɓifaɗi kaɗi nech hur fatˈyamǝn. chich fee kǝɗu kǝthlǝm mǝ nggǝrmǝn chok ta kǝ mafechi ɓǝɓifata wa. <verse eid="ROM 6:6" /><verse number="7" style="v" sid="ROM 6:7" />Kǝthlǝm ma ǝ mǝr nefa, ǝ mbǝstǝ chok indiyan thlaˈta ǝ alkǝti ɓǝɓifat hacha.<verse eid="ROM 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 6:8" />Ma tapi mǝrmǝn ɓukwa tǝ Kǝristi, fǝrmǝn kit wa namǝn nat ha ɓukwa tǝ anchi paɗ. <verse eid="ROM 6:8" /><verse number="9" style="v" sid="ROM 6:9" />Kǝthlǝm ǝ sǝn mǝn si tǝ ndat wa ǝ thlaˈan fee Kǝristi thlaˈtǝ hur mǝmatecha, paɗ nggech nggǝr tam mǝrwa wa, ndat wa, mǝrta peˈwu alkǝtˈyansi kǝ indiyan wa. <verse eid="ROM 6:9" /><verse number="10" style="v" sid="ROM 6:10" />Mǝrtǝɗiˈyan chitǝn ya, mǝrchan kaɗ artǝ ndak chektaˈan sǝ wa kǝthlǝm kǝ chen tǝ alkǝti ɓǝɓifat kaɗi. Kǝɗu naɗi ha natǝn chit nakanya, nechan ha kǝ thlǝrɗaktǝ tǝ Farta.<verse eid="ROM 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 6:11" />Kǝɗuyu kun paɗ kǝ tǝr wun inchiyowun kǝɗ mǝrcha kǝ alkǝti ɓǝɓifata. Nakanya fee naa natˈyandǝha kǝ Farta, tǝmɗi Kǝristi Yesu. <verse eid="ROM 6:11" /><verse number="12" style="v" sid="ROM 6:12" />Kǝthlǝm ndaˈan kǝ nggǝm wun fa ɓǝɓifat kǝ chit kuturakta hur faɗowun ˈyi thla nech mǝrtǝ kaɗ wa, kǝ ɗǝftǝ wunchi kǝ ɓǝɓi yahti wanfata wa. <verse eid="ROM 6:12" /><verse number="13" style="v" sid="ROM 6:13" />Kǝ panawun tangathlech ˈyowunha kǝ ɓǝɓifata wa, paɗ kǝ chok ndǝ kǝ ǝna tarchi kumi kaakǝta wa. Kǝɗu taˈan kǝ fǝr wun inchiyowun kǝmɗi Farta, kǝɗ ǝnɗi kǝmchǝsi kǝd fee ɓǝtandǝ fee tandǝ kesh hari mǝrta kǝ mbǝs shishingnda, paɗ kǝ panawun tangathlechˈyowun ha kǝmɗi Farta, kǝthlǝm kǝ chok ndǝ kǝ ǝna tarcha ˈyi tar kaakǝta. <verse eid="ROM 6:13" /><verse number="14" style="v" sid="ROM 6:14" />Kǝthlǝm ɓǝɓifata nech chit kuturakta kǝ indiyowun wa, kǝɗ thlǝ nakan wa ngga nechanwun fǝl kusiˈ nat wun wa, paɗ fǝl kaakǝti Farta.<verse eid="ROM 6:14" /></para>
  <para style="s">Mafechi Kaakǝta</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15" />Mǝ paɗi? Ndat wa, namǝn nɗǝt kǝ npang tǝ ɓǝɓifata nakan wa ngga nechamǝn fǝl kusiˈ wa kǝɗu ǝ kaakǝti Farta wa? Auwa. Chika ngguɗeyh. <verse eid="ROM 6:15" /><verse number="16" style="v" sid="ROM 6:16" />Sǝn wowun wa ma fǝr wun inchi yowun kǝthlǝm kǝ chok wun kǝ fee thlǝ fǝran chǝ maandǝ yowuna, chok wun kǝ mafech hacha ǝ hari thla thlǝ fǝrandǝ wun maanan wa. Thlǝ mbahǝn chowun chok ta kǝ mafechi ɓǝɓifata, thla thlǝ saˈchǝ kǝ mǝrta, ndu paɗ mafechi maanda kǝmɗi Farta, thla thlǝ saˈchǝ kǝmɗi kaakǝta. <verse eid="ROM 6:16" /><verse number="17" style="v" sid="ROM 6:17" />Kǝɗu usoko kǝ wathl ha kǝmɗi Farta, kǝthlǝm chika nakan wa choh kun mafechi ɓǝɓifata, kǝɗu nakan kǝɗaya thlǝ fǝr chowun maanda nat tǝ wanɗǝkaɗech yowun hur kit tǝɗi chaˈowundǝ fee har thla thlǝtwun. <verse eid="ROM 6:17" /><verse number="18" style="v" sid="ROM 6:18" />Ə hǝraˈowun chǝ fee hur ɓǝɓifata, kuɗu paɗ chokko wun kǝ mafechi kaakǝta.<verse eid="ROM 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 6:19" />Thlǝ nechi ndikta tǝ wunchi kǝɗ ǝnɗi thlǝ ndiktǝ pong nefa, kǝthlǝm wulandǝ sǝn ǝnˈyowun yi tar fata. Kǝɗ thla choh fǝr tǝwun tanggathla fech ˈyowun kǝ mafechǝ tǝkǝmǝn icha tǝ ɓǝɓifata, tǝ paɗ, tǝ kumǝ fǝr maanda thla thlǝ nech chektǝ kǝɗu. Nakanya kǝɗu paɗ fǝram tanggathla fech ˈyowun kǝ mafakǝti kaakǝta, kǝthlǝm kǝ chok wun kǝ fee sǝsandǝ fee tǝ chǝdchǝɗ kǝta kǝ Farta. <verse eid="ROM 6:19" /><verse number="20" style="v" sid="ROM 6:20" />Ə wanshengngǝn ɗi nat wun kǝ mafechi ɓǝɓifata, kǝmowun wu ǝn tǝ kaakǝta wa. <verse eid="ROM 6:20" /><verse number="21" style="v" sid="ROM 6:21" />Mǝ nech kǝ ǝna chekta mbǝstǝ wun hur ichiɗi nakanya chokowunchǝf kǝ ǝna har tǝ fata? Ai, kǝnau ichiɗi enya mǝrta. <verse eid="ROM 6:21" /><verse number="22" style="v" sid="ROM 6:22" />Kǝɗu nakanya ǝ hǝraˈowun chǝ fee ǝ hur ɓǝɓifata, chokkowun paɗ kǝ mafechi Farta. Chektǝ ɗi mbǝstǝ wun thlaˈtǝ ǝ thleya ndaˈan ɗich tǝ wunchi kǝ nat ha thla nech chǝdchǝɗ, thla paɗ thlǝ nggǝtowun chǝ shishingndǝ si thla kǝ poriˈ <verse eid="ROM 6:22" /><verse number="23" style="v" sid="ROM 6:23" />Kǝthlǝm kǝnau ɓǝɓifata ndaˈan nech kǝ mǝrta, kǝɗu pafǝn i Farta ndaˈan nech kǝ shishingnda thla kǝ poriˈ tǝmɗi Chinmǝn Yesu Kǝristi.<verse eid="ROM 6:23" /></para>
  <chapter eid="ROM 6" />
  <chapter number="7" style="c" sid="ROM 7" />
  <para style="s">Saktǝ chokti thlǝ para Farta tǝ chok reta</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1" />Wanmanchina hǝssa tǝ nǝssa sǝnwowun wa? Kǝthlǝm nechi shenuˈta tǝ fee sinchǝ kusiˈ. Ndatwa kusiˈ tǝɗiya nechan tǝ alkǝtfa fi nefa ma peˈ tǝ shishingndǝf ndak. <verse eid="ROM 7:1" /><verse number="2" style="v" sid="ROM 7:2" />Saktaˈan, nunefa thla nech kǝndi chimaɗan. Kusiˈ kǝnanchi ha fi chimaɗan ma peˈ ha tǝ shishingndǝ fa. Kǝɗu ma ǝ mǝr chimaɗan mbǝstǝ chok indiyan ǝ chaˈaɗi kǝnanchǝha kafi chimaɗan. <verse eid="ROM 7:2" /><verse number="3" style="v" sid="ROM 7:3" />Kǝthlǝm ndaˈan ma chok tǝ yowun hǝsnef samǝn, ma peˈ chǝmaɗan ha, nech fee ˈyaˈan chǝ wa fǝlau. Kǝɗu ma ǝ mǝr chimaɗan mbǝstǝ chokta ˈYi indiyan hacha kǝɗ ǝnɗi chaˈandǝ kusiˈ kaɗi kǝ ɗar kǝn reta. Ma paɗ nggǝrtǝ kǝn ret tǝ yowun samǝn, ngga tǝn chit fǝlaukǝta wa.<verse eid="ROM 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ROM 7:4" />Kǝɗu wanmanchina, saktaˈan tǝɗiya nechan kǝ kun. Tǝmɗi wumowunda tǝ fati Kǝristi chok wun kǝ mǝmatecha tǝ alkǝti kusiˈ, kǝthlǝm kǝ chok wun kǝ ˈyaˈan, ndat wa ˈYi thla thlaˈandǝ fee hur mǝmatecha, kǝthlǝm kǝ chǝmǝn tarchiɗǝ nech ndiˈchan kǝmɗi Farta. <verse eid="ROM 7:4" /><verse number="5" style="v" sid="ROM 7:5" />Thlǝhaɗi natmǝn nat ha hur tar fata, faɗi ˈyamǝn thlǝ yahchǝ chit tar ɓǝɓifata, thleˈ kaˈan kǝthlǝm kusiˈ nɗǝfchǝndǝsi. Nat ǝchiɗiya thlǝ natmǝn chit ya thlǝ nɗichan tǝ mǝnchi kǝ mǝrta ndak. <verse eid="ROM 7:5" /><verse number="6" style="v" sid="ROM 7:6" />Nakanya hǝraˈmǝn tǝ kusiˈ ǝ Musa, mǝrmǝn kǝ ɓǝra ichidi kǝnamǝncha. Kǝ thlǝm kǝ manamǝn Farta hur yuwa shishingnda tǝ shemeta nga tǝ ɗoh tǝ kusiˈ tǝɗawa.<verse eid="ROM 7:6" /></para>
  <para style="s">Ɓahtǝha tǝ ɓǝɓifata</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7" />Nechamǝn ndat wa kǝni? kusiˈ ɓǝɓǝfatawa? ngeng chok kǝɗuwa. paɗ chǝk kǝɗu, kǝthlǝm kusiˈ chich kǝ sǝni ɓǝɓǝfata. Ma ndawu kusiˈ taˈan wa, “Kǝ yehǝn ǝni nefawa,” mǝ sǝnwi yah ǝni nefa wa. <verse eid="ROM 7:7" /><verse number="8" style="v" sid="ROM 7:8" />Paɗ ɓǝɓǝfata mbǝstǝ mbanda tǝmɗi kusiˈ, ɓakan tǝ yah ichi samǝn samǝn hur wanɗǝˈkaɗatinchi, kǝthlǝm mannga kǝ kusiˈ ǝ Musa wa, ɓǝɓǝfata nechan kǝ mǝrta. <verse eid="ROM 7:8" /><verse number="9" style="v" sid="ROM 7:9" />Choh tǝɗi sǝnwaktǝ kusiˈ, ngǝt tǝ shishingdǝfa, ɓak kusiˈ tǝɗaa, nak ɓǝɓǝfat tǝ shishingndǝfa, mǝrki kaɗi. <verse eid="ROM 7:9" /><verse number="10" style="v" sid="ROM 7:10" />Kǝthlǝm ndaˈan Kusiˈ tǝdi fǝrtife kǝthlǝm kǝ ɓǝtǝ shishingnda, ǝ mǝɗǝnchi ɓǝtǝ mǝrta. <verse eid="ROM 7:10" /><verse number="11" style="v" sid="ROM 7:11" />Ɓǝɓǝfata mbǝs tǝ mbanda tǝmɗi kusiˈ tǝɗaa, lǝmkan nenchi, tǝmɗiyan paɗ ɓǝlikan. <verse eid="ROM 7:11" /><verse number="12" style="v" sid="ROM 7:12" />Kǝthlǝm kǝt ndaˈan kusiˈ tǝ indiyan nechan chǝɗchǝɗ, chaˈanan kaɗ paɗ nechan chǝɗchǝɗ, ɓǝɓi fatsǝ huran wa, paɗ ndǝˈchan si.<verse eid="ROM 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 7:13" />Nakanya, ni ndat wa ǝnɗi nech ndiˈchan nan ɓi mǝrtǝ hacha wa? Auwa, nen chǝ kǝɗu wa. Ɓǝɓifat ɓech tǝ mǝrta, tǝmɗi chǝt ter tǝ ǝnɗi nech ndiˈchan ɓakan mǝrta kǝthlǝm pǝntǝ indiyan ndat wa ɓǝɓifat nakan, tǝmɗi chaˈanan kaɗ paɗ, ɓǝɓifata pǝntǝ chok ndiiɗ ˈyan ha kǝ thlǝ ɓǝɓifat kaan.<verse eid="ROM 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14" />Sǝnmǝnwa kusiˈ kusheˈti shemeta. Paɗ ngǝt hur fata, mafatǝ ɓǝɓǝfat ndak naki. <verse eid="ROM 7:14" /><verse number="15" style="v" sid="ROM 7:15" />Sǝnwi ǝnɗi thlǝ chitiwa. Kǝthlǝm ichiɗi yahti kǝthl thlǝnani kaɗi, nga ndaan thlǝ chǝtiwa, ǝnɗi karti, ndaan ndak thlǝ chiti. <verse eid="ROM 7:15" /><verse number="16" style="v" sid="ROM 7:16" />Ma thlǝ thlǝnani inɗi yahwakti chǝta, ngimani hachawa kusiˈ ǝn ndǝˈchan. <verse eid="ROM 7:16" /><verse number="17" style="v" sid="ROM 7:17" />Nakanya hach nga ngǝt thlǝ chich ichǝ nɗawa, ɓǝɓifaɗi chokchǝha hwǝrinchi. <verse eid="ROM 7:17" /><verse number="18" style="v" sid="ROM 7:18" />Sǝninchiswa nga ǝn ndǝˈchan nech finchǝwa, ndat wa hur tar fatǝnchi. Kǝthlǝm yahǝnchǝs kǝ thlǝnani ǝnɗi kaɗ nech ndiˈchan paɗ mɓahǝnwi thlǝna ndawa. <verse eid="ROM 7:18" /><verse number="19" style="v" sid="ROM 7:19" />Ənɗi nech ndiˈchan thla yahti kǝ chi, nga ndaan thlǝ chitiwa. Nakan sǝɓtǝ ǝnɗi nawakchǝ ndiˈchan thla yahwaktisi kǝ chi, ndaan thlǝ nati chita. <verse eid="ROM 7:19" /><verse number="20" style="v" sid="ROM 7:20" />Ma ngǝt chit ǝnɗi yahwakti kǝ chi, nga gǝt thlǝ chichawa, ɓǝɓifaɗi nech hur wanɗǝ kaɗatinchi thlǝ chicha.<verse eid="ROM 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 7:21" />Kǝthlǝm ndaˈan, sǝnninchiwa, chokchan kǝ kusiˈ, nat fartǝɗi yahti chǝt ǝnɗi nech ndiˈchan, thlǝ nechi indinchi chit ǝnɗi nawak chi ndiˈchan. <verse eid="ROM 7:21" /><verse number="22" style="v" sid="ROM 7:22" />Hur wandǝ kaɗatinchi nakanya, ngǝminchi kusiˈ ǝ Farta fa. <verse eid="ROM 7:22" /><verse number="23" style="v" sid="ROM 7:23" />Paɗ ngǝt naa kusiˈ samǝn, thla nech hur tangathlechinchi thla nech yanda tǝ kusiˈ tǝɗi nech hur wandǝ kadatichi chikan kǝ mafati ɓǝɓǝfata thla nech chit ter tǝ tangathlechi fatinchi. <verse eid="ROM 7:23" /><verse number="24" style="v" sid="ROM 7:24" />Ai inchi. wun nech hǝraˈita hur faɗinchiya thla nech mǝrtǝ kaɗi? <verse eid="ROM 7:24" /><verse number="25" style="v" sid="ROM 7:25" />Usoko kǝmɗi Farta, tǝmɗi chinmǝn Yesu Kǝristi. Kǝthlǝm ndaˈan ngǝt tǝ indinchi ni manani kusiˈ ǝ Farta tǝ wanɗǝ kaɗatinchi, paɗ tǝ fatinchi ngǝt manandǝ kusiˈ i ɓǝɓǝfata.<verse eid="ROM 7:25" /></para>
  <chapter eid="ROM 7" />
  <chapter number="8" style="c" sid="ROM 8" />
  <para style="s">Nat ha hur alkǝti shemeta</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1" />Nakanya peˈwu chakmee su wa kǝmɗi fee nech kǝ yi Yesu Kǝristi. <verse eid="ROM 8:1" /><verse number="2" style="v" sid="ROM 8:2" />Kǝthlǝm tarchi Yesu Kǝristi ǝnɗi naa shemeɗan mɓuˈta kǝ chifee kǝthlǝm kǝ mbǝsmǝn shishingnda hǝraˈamǝnchi mǝɗi ǝnɗi naa ɓǝɓifat mbuˈta kǝ chifee thla thlǝ ɓech tǝ mǝrta. <verse eid="ROM 8:2" /><verse number="3" style="v" sid="ROM 8:3" />Ənɗi mbahǝnwaktǝ Kusiˈ chita kǝthlǝm kuɓandǝ fati pong nefa, ǝ chǝ Farta. Chapankǝ Farta alkǝti ɓǝɓifat kaɗi ǝ fi nefa, tǝmɗi waˈyan Yesu Kǝristi. Thlǝndǝn thla ɓech kǝ pong nefa nawaktǝ ɓǝɓifat ˈyansi. <verse eid="ROM 8:3" /><verse number="4" style="v" sid="ROM 8:4" />Chich Farta thleya paɗ, kǝthlǝm kǝ chokmǝn kǝɗ ǝnɗi yahtǝ Shemeti Farta ngga kǝɗ ǝnɗi yahtǝ fati nefawa. Kǝ chimǝn ǝnɗi nech ndiˈchan thla yahtǝ kusiˈ i Farta kǝ chimǝn paɗ kǝ chimǝn keˈkeˈ.<verse eid="ROM 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 8:5" />Fee thlǝ nech ha hur tar fata, ǝnɗi yahtǝ fata ndaˈan thlǝ nech parat har tǝ wanɗǝkaɗech ˈyanda. Fee thlǝ nech ha kǝɗ ǝnɗi mbuˈtǝ shemeta, ǝnɗi yahtǝ shemeta ndaˈan thlǝ nech parat har tǝ wanɗǝkaɗech ˈyanda <verse eid="ROM 8:5" /><verse number="6" style="v" sid="ROM 8:6" />Dǝf wanɗikaɗaɗ kǝ ǝnɗi yahtǝ fata, nggǝl miyan mǝrta. Dǝf wanɗikaɗaɗ kǝ ǝnɗi yahtǝ shemeta, nggǝl miyan kǝ mbǝs shishingnda tǝ kǝɓikaɗi. <verse eid="ROM 8:6" /><verse number="7" style="v" sid="ROM 8:7" />Ɗǝf wanɗǝkaɗat kǝ ɓǝra ǝnɗi yahtǝ fata atǝkretǝ tǝ Farta ni, Nech para kusiˈ ˈyi Farta wa, paɗ nen mbahǝnwa. <verse eid="ROM 8:7" /><verse number="8" style="v" sid="ROM 8:8" />Fee thlǝ nech ha hur fata, ngandǝ tam tǝrantǝ wanɗǝkaɗati Farta ha wa, chǝk ngudyeh.<verse eid="ROM 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 8:9" />Paɗ kun nakanya, nga fǝ chit tar fat nakonwa, yi Shemet nakonwun, ma Shemeti Farta hur wanɗikaɗechˈyowun. Nat thla nawaktǝ shemetǝ Kǝristi yansi, nga yi Kǝristi nakanwa. <verse eid="ROM 8:9" /><verse number="10" style="v" sid="ROM 8:10" />Ma Kǝristi si wanɗikaɗechˈyowun, kǝmmowunwu ǝn tǝ ɓǝɓifata wa, tǝn Shemet choktǝ kǝ shishingnda kǝmɗiyowun kǝthlǝm mbiswun kaafatǝ Farta. <verse eid="ROM 8:10" /><verse number="11" style="v" sid="ROM 8:11" />Ma Shemeɗi Farta thlaˈanchǝ Yesu hur mǝmatecha nech wanɗikaɗechˈyowun, mǝthlan tǝɗi thlaˈanci Kristi hur mǝmatecha nan fǝran shishingnda mǝrtǝ fatˈyowun tǝmɗi Shemetˈyan thla nech wanɗikaɗech yowun.<verse eid="ROM 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12" />Kǝthlǝm daˈan fenchina, niwun tar fata, nen mbisaminchi inawa nat mǝn nat tǝndǝwa. <verse eid="ROM 8:12" /><verse number="13" style="v" sid="ROM 8:13" />Ma kun chit tar fata, nowun mǝrta, paɗ ma alkǝti Shemet thlǝ ɓǝlandǝwun tar fata, mbǝskowun hǝraˈta <verse eid="ROM 8:13" /><verse number="14" style="v" sid="ROM 8:14" />Nat thla thlǝ para Shemeti Farta tǝ tanda, tandǝ nech kǝ wanchi Farta. <verse eid="ROM 8:14" /><verse number="15" style="v" sid="ROM 8:15" />Shemeɗi fǝrowun ndǝ Farta, ɗǝf wa wunchǝ kǝ chok wun kǝ mafechawa, kǝ chok wun paɗ tǝ lekǝtawa. Auwa, Shemeɗan ɗǝftǝ wunchi kǝ chokwun kǝ wanchi Farta, tǝmɗi alkǝti Shemeɗan paɗ thlǝ mbahǝn chamǝn ˈyatawa Farta, “Chinech kǝ Papa.” <verse eid="ROM 8:15" /><verse number="16" style="v" sid="ROM 8:16" />Shemeɗan tǝ indiyan nat tǝ shemetˈyamǝn, sǝnamǝn chǝndǝs tǝ ndat wa, ngǝmǝn wanchi Farta. <verse eid="ROM 8:16" /><verse number="17" style="v" sid="ROM 8:17" />Nakan chok mǝn kǝ wanchi Farta, kǝthl sǝnmǝnsǝwa namǝn mbǝs ǝn kǝ har thla naa Farta fǝrandǝ wanchi yan. Nggamǝn tǝ Kǝristi Yesu namǝn mbǝs ǝn kǝ har tǝɗiya. Ma ɓahmǝn ha tǝ anchi namǝn mbǝs shishingnda paɗ tǝ anchi.<verse eid="ROM 8:17" /></para>
  <para style="s">Maanda thla nech ɓatˈ kǝ pangga</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18" />Ə saktinchi, ɓahtǝɗi ha natmǝn fiyan ya, chaˈwa kǝ kaɗanfee tǝ maanɗi nafee pinamǝndawa. <verse eid="ROM 8:18" /><verse number="19" style="v" sid="ROM 8:19" />Nat nafchǝɗi tǝndǝ Farta tandǝ pǝkta tǝ ɗǝfkǝfatsi kaˈan fartǝɗi natǝn pǝn wanchiyan hayang. <verse eid="ROM 8:19" /><verse number="20" style="v" sid="ROM 8:20" />Nat ichiɗi chit Farta tandǝ chit njiiɓ, sǝnwandǝ ǝnɗi nafee huranwa. Thleya ngga tǝ yahtiyanda wa, paɗ tǝmɗi yahti Farta mǝthlan tǝɗi chich ichiɗiya paɗ ɗǝf tǝ wanɗikaɗsi kǝ ɗarnanda. <verse eid="ROM 8:20" /><verse number="21" style="v" sid="ROM 8:21" />Ichiɗi tǝndǝ Farta, nat tǝ idiyan nadǝ hǝraˈata tǝ ɓahta, naandǝ mǝthl kaɗwa. Kǝ mɓǝs ndǝ kwas tǝ yipta thla natǝn fǝrandǝ wanchan.<verse eid="ROM 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 8:22" />Kǝthlǝm ndaˈan sǝnmǝnwa ichiɗi tǝnɗǝ Farta, paˈ kǝ nakanya tandǝ fǝfǝrta welǝla hur fat ˈyanda, kǝɗ hatǝ ngǝtta. <verse eid="ROM 8:22" /><verse number="23" style="v" sid="ROM 8:23" />Ngga ichiɗi tǝndǝ Farta ndak thlǝ nech fǝfǝrtawa, paɗ ngamǝn tǝɗi tapech kǝ mbǝsmǝn Shemeta, thla tǝrkwathl kanan, hur ichiɗi natmǝn mbǝsta, ngamǝn fǝfǝrtǝ hur wanɗǝkaɗechˈyamǝn, ngamǝn pǝktǝ kǝ chokamǝn chifee kǝ wanchi Farta, paɗ, kǝ hǝraˈanfee fechˈyamǝn. <verse eid="ROM 8:23" /><verse number="24" style="v" sid="ROM 8:24" />Tǝmɗi ɗǝf wanɗǝkaɗeˈini mbǝstǝmǝn hǝraˈta. Ɗǝf wanɗǝkaɗat kǝ ɗar ǝnɗi thlǝ natmǝn ngga ɗǝf wanɗǝkaɗat ni wa. Wun thlǝ ɗǝf chi wanɗǝkaɗat kǝ ɓǝra ǝnɗi tapatǝn kǝ mbǝsa? <verse eid="ROM 8:24" /><verse number="25" style="v" sid="ROM 8:25" />Ma thlǝ ɗǝfchamǝn wanɗǝkaɗat kǝ ɓǝra ǝnɗi mbǝswaktǝmǝn kwaɗǝn, pǝkkamǝn tǝ kǝrǝsa.<verse eid="ROM 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26" />Tǝ kǝɗu thlǝ kǝsamǝn ndǝ Shemeti Farta tǝsi kǝthlǝm hatatˈyamǝn ha. Sǝnwamǝn ǝnɗi kǝmchǝs nat mǝn shitǝ kǝ ɗaran wa, paɗ Shemeti Farta thlǝ nechan shitǝ tǝ fǝfǝrta thla nawaktǝ wanshenuˈta mbahǝn mbuˈta. <verse eid="ROM 8:26" /><verse number="27" style="v" sid="ROM 8:27" />Mǝthlan tǝɗi thlǝ tausanchi wanɗikaɗechˈyamǝn, sǝntǝ ǝnɗi naa Shemet kaɗata. Kǝthlǝm Shemeta thlǝ nechan shiyandǝ Farta kǝthlǝm nafchiɗi nech kǝ yaˈan. Thlǝ shichan kǝɗ ǝnɗi kaɗa Farta.<verse eid="ROM 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 8:28" />Sǝnmǝnwa hur ichi nat, Farta thlǝ nechan chit tanda, kǝ chok ndǝ kaakǝta kǝmɗi fee yahchindi. Kǝmɗi fee ˈyatǝn tanda tǝmɗi kaɗatˈyan. <verse eid="ROM 8:28" /><verse number="29" style="v" sid="ROM 8:29" />Fee tatǝ Farta tǝrkwathl kanan yu, fen tahsandǝn ha kǝnandǝ kǝɗ Waˈyan, kǝthlǝm Wanan kǝ chok kǝ walla waa hur fenchaˈan terchan. <verse eid="ROM 8:29" /><verse number="30" style="v" sid="ROM 8:30" />Fee tahsandǝn hayu, tandǝ ˈyatǝn. Fee ˈyatǝn paɗ yu, chan kan tandǝ kǝ fee nawaktǝ ɓǝɓifat ˈyandǝsi ǝ pangngǝnan. Fee nawaktǝ ɓǝɓifat ˈyandǝsi ǝ pangngǝnan, manankan tanda.<verse eid="ROM 8:30" /></para>
  <para style="s">Yahti Farta hur Kǝristi</para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31" />Nakanya, mǝ natmǝn mɓaˈta kǝ ɗar ichiɗiya? Ma Farta tǝ mǝnchi, wun chaˈchǝsi kǝ chit atǝkrekǝta tǝ mǝnchi? <verse eid="ROM 8:31" /><verse number="32" style="v" sid="ROM 8:32" />Farta, mǝthlan tǝɗi ˈyatawakchǝ waˈyan, paɗ firtǝndi kǝthlǝm kǝt ngamǝn nat, nen fǝramǝnchi ichi nat pafǝn wa? <verse eid="ROM 8:32" /><verse number="33" style="v" sid="ROM 8:33" />Wun nech ndatawa, nat tati Farta chindǝ ɓǝɓifata? Farta ndak thlǝ ndechawa nafcha chokndǝ kǝ fee nawaktǝ ɓǝɓifat ˈyandǝsi ǝ pangngǝ ɗan. <verse eid="ROM 8:33" /><verse number="34" style="v" sid="ROM 8:34" />Wun chaˈchǝs kǝ chakan tǝ mee tanda? Kǝristi Yesu ndak thla mǝrcha ǝ ɓǝra palangnda, paɗ thlaˈankǝfe hur mǝmatecha. Mǝthlan ɗas harsǝm i Farta, mǝthlan shita kǝthlǝm ngǝmǝn. <verse eid="ROM 8:34" /><verse number="35" style="v" sid="ROM 8:35" />Wun nech chakamǝndiha tǝ thlǝrɗakti Kǝristi? Na ɓahta, sǝbtǝ wanɗikaɗata, mita, ɓah kapecha, mii mǝrta ndu mǝrta tǝ thluta? <verse eid="ROM 8:35" /><verse number="36" style="v" sid="ROM 8:36" />Kǝɗ ǝnɗi yarandǝfee ha hur laulawati Farta ndat wa,</para>
  <para style="q1" vid="ROM 8:36">“Kǝthlǝm kǝt cha thlǝ ɓǝlaˈandǝ fee thlaˈtǝ walwurta kǝ hǝmǝn Farta,</para>
  <para style="q2" vid="ROM 8:36">chamǝnchifee kaɗ kǝɗ chohrechiɗi nafe ɗǝt thleˈnda ɓǝrata.”<verse eid="ROM 8:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="ROM 8:37" />Chǝk tǝ kǝɗu, hur ichǝˈinni nat nech sǝɓtǝ tǝ mǝnchi yu, mbǝramǝn alkǝtˈyandǝ ha kaˈan tǝmɗi Farta mǝthlan tǝɗi yahchimǝnchi. <verse eid="ROM 8:37" /><verse number="38" style="v" sid="ROM 8:38" />Kǝthlǝm sǝninchǝsi ndat wa, ǝnsi nech chakamǝndǝ ha tǝ thlǝrɗakti Kǝristi wa. Chika mǝrta, natˈha, fǝ thlǝnchi Farta, kuturcha, ndu ichiɗi nechsi nakanya, ichiɗi nech ɓata, tǝ alkicha. <verse eid="ROM 8:38" /><verse number="39" style="v" sid="ROM 8:39" />Ichiɗi nech hulafǝrta, ichiɗi nech kan haha, ndu ǝnsi hur ichiɗi nat tǝndi fee, nen mbahǝn chakaˈǝn chiha tǝ yahti Farta thla pǝnamǝndǝn tǝmɗi Yesu Kǝristi chinmǝn wa.<verse eid="ROM 8:39" /></para>
  <chapter eid="ROM 8" />
  <chapter number="9" style="c" sid="ROM 9" />
  <para style="s">Taɗ Farta Israilawecha</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1" />Thlǝ nechi mɓuˈ kittaˈan hur Kǝristi, nga tǝni lektawa, saktǝ wanɗǝkaɗatinchi tǝmɗi Shemeta, pǝnichǝswa ngga tǝni lektawa. <verse eid="ROM 9:1" /><verse number="2" style="v" sid="ROM 9:2" />Ngǝt tǝ sǝɓtǝ hwǝrfǝ kaˈan tǝ ɓilla weenmǝta hur wanɗǝkaɗatinchi. <verse eid="ROM 9:2" /><verse number="3" style="v" sid="ROM 9:3" />Ngǝt ndat wa kǝ ɗǝfichife ǝn kafa, ndu kǝ chaki chife ha tǝ Kǝristi, kǝthlǝm wanmanchina fee nech kǝ kwathl na, <verse eid="ROM 9:3" /><verse number="4" style="v" sid="ROM 9:4" />ndat wa nafchi Israˈilawacha. Tanɗǝ ɗi chadi Farta tandǝ kaɗ kǝ wanchan, pǝnankan tandi maanɗiˈyan, nɗǝf kan mǝyan tǝ tanda fǝrankan tandǝ kusiˈ i Musa, pǝnankan taɗi nban manandǝ Farta i kit, nɗǝf kan miyan tǝ tanda. <verse eid="ROM 9:4" /><verse number="5" style="v" sid="ROM 9:5" />Ɓechandi kesh hur kwathl kaakech kaakech nandi ɗiya. Kǝristi paɗ kǝd pong nefa, nechan ǝ kwathl nanɗa. Malaman kǝ manan fee Farta thla thlǝ chich kurakta kǝ ɓǝra chikami, kǝ kwǝkǝchi. kǝ chokkǝɗu.<verse eid="ROM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6" />Nga wa tǝni ndata wa nɗikti Farta ǝ wulanchi ndiit ha wa. Kǝthlǝm nga nat nafchiɗi ɓech kesh hur kwathl Israˈilawacha, nech kǝ kaa nafchi Israˈilawecha wa. <verse eid="ROM 9:6" /><verse number="7" style="v" sid="ROM 9:7" />Nga nat kwahtl Ibrahim nech kǝ wanchi Ibrahim wa. Ndangkǝ Farta Ibrahim wa, ndat wa, “Wanchiɗi naa Ishaku ngǝtta fen naa fee ˈyatawa kwathl wa.” <verse eid="ROM 9:7" /><verse number="8" style="v" sid="ROM 9:8" />Nga wanchiɗi ngǝttǝ Ibrahim tǝ indiyan nech kǝ wanchi Farta wa, auwa, wanchiɗi ɗǝfandi Farta miyan Ibrahim fen thlǝ ndafe wa kwathl Ibrahim. <verse eid="ROM 9:8" /><verse number="9" style="v" sid="ROM 9:9" />Kǝɗaya mbuˈtǝ fee kǝ ɗar ɗǝfmiyan. Ndatwa, “Huraɗi nech ɓatyu mǝt kǝɗaya ni nggǝr ɓata, Saratu paɗ nan ngǝt waa.”<verse eid="ROM 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 9:10" />Ngga thleya ndak wa. Wanchiɗi Rifkatu chapyu, chin nanda arta, thla nech kǝ chinmǝn Ishaku. <verse eid="ROM 9:10" /><verse number="11" style="v" sid="ROM 9:11" />Tapawa ngǝt fee wanchaˈan wa, ndu kǝ sǝndǝ ǝnɗi nech ndiˈchan ndu sǝɓtaˈan mbuˈankǝ Farta maananda ǝnɗi nech sǝɓta, yah Farta kǝ taɗ har arta hurnanda kǝ chok kǝ ǝnɗi yahtǝn. <verse eid="ROM 9:11" /><verse number="12" style="v" sid="ROM 9:12" />Ngga kǝthlǝm tarchɗi chit nda wa, paɗ tǝmɗi ˈyatˈyan, ndangkan wa, “Thla manchan nan choktǝ kǝ mafati thla nguɗyeh.” <verse eid="ROM 9:12" /><verse number="13" style="v" sid="ROM 9:13" />Kǝɗ thla yarandǝfe ha ndat wa, “Yahǝnchi Yakubu, karki Isuwa.”<verse eid="ROM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14" />Mǝnatmǝn ndat hacha? Thlǝna wu Farta kaɗ ndiˈchan waˈ wa? auwa, chǝk nguɗyeh. <verse eid="ROM 9:14" /><verse number="15" style="v" sid="ROM 9:15" />Kǝthlǝm ndanchan Musa wa,</para>
  <para style="q1" vid="ROM 9:15">“Nan haɗitǝfa, thla kǝmchis kǝ haɗichǝ fa.</para>
  <para style="q2" vid="ROM 9:15">Nafɗi yahti chan kaakǝta, ni chan kaakǝta.”<verse eid="ROM 9:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="ROM 9:16" />Kǝthlǝm ndaˈan, chokwa kǝ ɓǝra ǝnɗi thlǝ yahtǝ nefa wa ndu kweˈtiyan ha wa, paɗ kǝ ɓǝra haɗaanɗǝ thlǝ haɗandǝmǝn Farta fa. <verse eid="ROM 9:16" /><verse number="17" style="v" sid="ROM 9:17" />Kǝthlǝm ǝ hur ndikti Farta, yarankǝfe tǝ nadtwa, ndangkǝ Farta Firˈauna ndat wa, “Thla u chi kǝnen kǝ kwitira kǝthlǝm ǝn arta. Yahǝnchi kǝ pǝni alkǝtinchi tǝmɗiyo, paɗ thlǝmna kǝ welha hurheshi nat.” <verse eid="ROM 9:17" /><verse number="18" style="v" sid="ROM 9:18" />Kǝthlǝm ndaˈan, thlǝ haɗanchan thla kǝmchis kǝ haɗanchifa, paɗ thlǝ chanchan wanɗǝkaɗati thla yahtǝn kaɗ kwaˈkwaˈ.<verse eid="ROM 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19" />Arta hurwun nech ndǝtawa, “Ma chok kǝɗu, mǝchich thlǝ naa Farta naa ɓǝbǝfati yowun ha nakanya? Wun chaˈchǝsi kǝ yatanchi Farta ǝnɗi natǝn chita”? <verse eid="ROM 9:19" /><verse number="20" style="v" sid="ROM 9:20" />Paɗ wun nako, chi nefa, natu ass ǝndǝ tǝ Farta? “Ənɗi tǝndǝfe chaˈwasi kǝ ɓahǝn tǝ ndaˈdǝ thla tǝnchiɗi wa ‘Mǝchich tǝndu nenchǝ kǝɗaya?’ ” <verse eid="ROM 9:20" /><verse number="21" style="v" sid="ROM 9:21" />Thlǝ tahǝs ɓucha tǝ taɓta alkǝtˈyansi kǝ chǝt ter tǝ taɓtaˈan kǝɗ ǝnɗi yahtǝn wa. Thlǝ mbahǝnchan chǝt ter tǝ fowun taɓtaˈan kǝ tǝnti ɓucha kǝthlǝm tarchiɗi kǝmchǝsi fowun kǝthlǝm tarchiɗi kǝmwakchǝsi wa.<verse eid="ROM 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 9:22" />Ngga kǝɗu yahtǝ Farta wa? Ma yahsǝ kǝ pǝntǝ sǝɓtǝ hwǝrˈyan, paɗ kǝ pǝntǝ alkǝtˈyan hayang. Kǝ kǝrǝs tǝ fee kǝmchǝs kǝ sǝɓanchǝ hwǝr kaɗ kǝ ɗarnanda, chaˈwasi wa? <verse eid="ROM 9:22" /><verse number="23" style="v" sid="ROM 9:23" />Ma chichan ichiɗiya, kǝthlǝm kǝ inantǝ kutǝraktiyanha hayang kǝmɗi fee thlǝ haɗanchifa, kǝthlǝm fee tahsandǝn kutǝraktǝ tandǝs turkwathl kanan, <verse eid="ROM 9:23" /><verse number="24" style="v" sid="ROM 9:24" />chika nggǝmǝn, ngamǝn tǝɗi ˈya Farta, ngga hur Yahudawecha ndak wa, paɗ hur fee nawakchi kǝ Yahudawecha. <verse eid="ROM 9:24" /><verse number="25" style="v" sid="ROM 9:25" />Kǝɗ thla mɓuˈtǝfe hur laulawati Hosiya ndat wa, “Fee choh nawakchǝ kǝ nafchinchǝ, ni ˈya tandawa ‘Nafchinchi.’ Nafchi hahǝɗi choh yahwakti nechi ˈya tandawa ‘Fee yahti.’” <verse eid="ROM 9:25" /><verse number="26" style="v" sid="ROM 9:26" />Paɗ “Mǝɗi ndandǝfe tandawa, ‘Nggun ngga nafchinchiwa’ Minni nafe ˈya tandawa ‘Wanchi Farta thlǝ shishingnda.’” <verse eid="ROM 9:26" /><verse number="27" style="v" sid="ROM 9:27" />Thlǝ shenuˈta tǝ yahti Farta, Ishaya, shenuˈkan tǝ kapa ɓǝrata kǝ ɗar Israˈilawa ndat wa, “Chika nakan wa Israˈilawa chi terchan, kǝɗ chokita mǝ kufa, ngguɗeh hur nandǝ nech hǝraˈta. <verse eid="ROM 9:27" /><verse number="28" style="v" sid="ROM 9:28" />Kǝthlǝm chinmǝn Farta nan ndǝɗandi chakmeeˈyan ha kǝ ɗar heshi ngga tǝ sǝɓandǝ wanshengnan kaɗwa.” <verse eid="ROM 9:28" /><verse number="29" style="v" sid="ROM 9:29" />Kǝɗ ǝnɗi mbuˈtǝ thlǝ thlǝndi Farta Ishaya choh ndadwa, “Ma ngga ǝnɗi malamǝn kan fowun hur kwathlan wa, mǝ nechamǝn nat kǝɗ Sodom, kǝ ngǝramǝn chifee ha kǝɗ Gomora.” <verse eid="ROM 9:29" /><verse number="30" style="v" sid="ROM 9:30" />Mǝ natmǝn ndad hacha? Fee nawakchi kǝ Yahudawecha fee kawakchǝ chok ndǝ kaakǝta pangngǝn Farta wa, mɓǝsnda, tǝmɗi fǝr kit. <verse eid="ROM 9:30" /><verse number="31" style="v" sid="ROM 9:31" />Paɗ Israˈilawa, chǝɗi kech chok kaakǝta pangngǝn Farta tǝmɗi kusiˈ i Musa mbǝswandawa. <verse eid="ROM 9:31" /><verse number="32" style="v" sid="ROM 9:32" />Mǝ chich kǝɗu? kawa ndǝ tǝmɗi fǝr kit wa, kechanda tǝmɗi mbǝs ǝn kǝ har. chekandǝ wansarta tǝ ɗakwanɗǝ thlǝ chefe wansarta. <verse eid="ROM 9:32" /><verse number="33" style="v" sid="ROM 9:33" />Kǝɗ thla yarandǝfe ha hur nɗǝkti Farta, ndat wa, “Nakanya thlohanni ɗakwen ha thla nech ɗǝf nafcha kǝ che wansarta ǝ Sihiyona. Kapa ɗakwana thla nech ɗǝf tanda kǝ hǝmndǝ ha. Nat thla tǝngngǝs chiha kafi ɗakwanan nggǝ fat haranchiwa.”<verse eid="ROM 9:33" /></para>
  <chapter eid="ROM 9" />
  <chapter number="10" style="c" sid="ROM 10" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1" />Wanmanchina, ǝnɗi kapati yahta nat tǝ wanɗikaɗatinchi, tǝ shitinchi kǝmɗi Farta, wanmanchǝn Israˈilawecha kǝ hǝraˈnda. <verse eid="ROM 10:1" /><verse number="2" style="v" sid="ROM 10:2" />Ni mɓahǝn mbuˈowunnda nggǝ tuˈtǝs wa ndat wa, thlǝ kweˈchanɗi ha tǝ para Farta, paɗ kweˈtandǝ ha ngga kǝ ɓǝra sǝn kit wa. <verse eid="ROM 10:2" /><verse number="3" style="v" sid="ROM 10:3" />Sǝnwandǝ mbanɗi tahsandǝ Farta, ha thla thlǝ chandǝn nafchǝ kaɗ kǝ nandǝ chǝɗchǝd ǝ pangngǝn nan wa. Ə kiindǝ mban yinanda, parawandǝ mbanɗi tahsandǝ Farta ha wa. <verse eid="ROM 10:3" /><verse number="4" style="v" sid="ROM 10:4" />Kǝristi nech kǝ ndiit chaˈandi Musa kaɗi. Kǝthlǝm nat thla thlǝ fǝrchi kit, kǝ chok chǝdchǝɗ ǝ pangngǝn Farta.<verse eid="ROM 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5" />Kǝɗaya yarandǝ Musa ha kǝ ɗar chok chǝdchǝɗ kǝta pangngǝn Farta tǝmɗi para kusiˈ. Ndatwa, “Nat thla perech chaˈati kusiˈ taˈan nan nat ha tǝmɗiyan.” <verse eid="ROM 10:5" /><verse number="6" style="v" sid="ROM 10:6" />Paɗ ǝnɗi mbuˈtǝ ndikti Farta, ya kǝ ndar chok chǝdchǝɗ kǝta ǝ pagngǝn Farta, thla ɓech tǝmɗi fǝr kit. Ndatwa, “Kǝ nden hur wanɗǝkaɗat ˈyo wa, ‘Wun nech tǝrtǝ kǝ hulafǝrta ‘Kǝthlǝm kǝ ɓǝ kah tǝ Kǝristi.’” <verse eid="ROM 10:6" /><verse number="7" style="v" sid="ROM 10:7" />Ndu kǝ nden wa “‘Wun nech ɗǝt kaha kǝ kan haha ‘Kǝ thlaˈantǝ Kǝristi hur mǝmatecha.’” <verse eid="ROM 10:7" /><verse number="8" style="v" sid="ROM 10:8" />Mǝna ndikti Farta mbuˈta? Ndichan wa, “Ndikti Farta nduk tǝwechi, nechan kǝssǝmǝn meˈyo tǝ paɗ hur wanɗǝkaɗatˈyo.” Ndaˈan nech kǝ ndikti fǝr kit thla thlǝ ɓasimǝn. <verse eid="ROM 10:8" /><verse number="9" style="v" sid="ROM 10:9" />Ndatwa, ma mbuˈin tǝ mee ˈyo, “Yesu nech kǝ Chinda,” paɗ fǝrko kit hur wanɗǝkaɗechˈyo ndat wa, thlaˈan Farta, hur mǝmatecha, no mbǝs hǝraˈta. <verse eid="ROM 10:9" /><verse number="10" style="v" sid="ROM 10:10" />Kǝthlǝm tǝ wanɗǝkaɗat thlǝ fǝrchi nef kit kǝ mɓǝsti chǝdchǝɗ kǝti Farta, tǝ mee paɗ, thlǝ nbuˈti fee kǝ mɓǝsfe hǝraˈta. <verse eid="ROM 10:10" /><verse number="11" style="v" sid="ROM 10:11" />Kǝɗ ǝnɗi nɓuˈti laulawaɗan ndat wa, “Nat thla thlǝ fǝrchi kit kǝmɗiyan nǝǝ fat haranchǝ wa.” <verse eid="ROM 10:11" /><verse number="12" style="v" sid="ROM 10:12" />Pǝn suwa, samsamǝn kǝt suwa chik ngguɗyah. Samsamǝn kǝt suwa pǝthlǝr Yahudawecha tǝ fee nawakchi kǝ Yahudawecha wa. Chǝnɗi artiya methlan nech kǝ chǝn chikawuni, mǝthlan paɗ thlǝ fǝrchi mbǝsˈichihar nat kǝ ɗar fee thlǝ ˈyech ndi. <verse eid="ROM 10:12" /><verse number="13" style="v" sid="ROM 10:13" />Kǝthlǝm mbuˈchi ndikti Farta ndat wa, “Nat thla echa hur thlǝm Chinda Yesu, nan hǝraˈta.”<verse eid="ROM 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 10:14" />Nechandǝ mbǝr ˈyandǝ wa kǝni kǝ hǝraˈandechi, kǝ ɗar thla fǝrwak tǝndǝ kit kǝ anchi? Nechanɗi mbǝr fǝr kit wa kǝni kǝ ndar thla tamwaktǝndǝ sǝk kusheˈ taˈan? Nechandǝ mɓǝr sǝktawa kǝni maa ngga tǝ ɓasan fee tandǝs wa? <verse eid="ROM 10:14" /><verse number="15" style="v" sid="ROM 10:15" />Nechandǝ mɓǝr ɓasa wa kǝni, mangga tǝ thlǝn fee tanda wa? Kǝɗ thla yarandǝfeha hur laulawati Farta ndat wa, “Ɓa tǝ fǝ wiˈ ɓaas kwastǝ ndikti Farta, ndiˈchansi.” <verse eid="ROM 10:15" /><verse number="16" style="v" sid="ROM 10:16" />Ngga nat Israiˈlawecha wa thlich kwasti ndiktǝ ɗǝya wa, kǝɗ ǝnɗi mbuˈtǝ Ishaya ndat wa, “Chinda, wun fǝrchi kit kǝ ndar ɓaasɗi, ˈyaˈan ya?” <verse eid="ROM 10:16" /><verse number="17" style="v" sid="ROM 10:17" />Thle ya penchan tǝ ndat wa, Nǝfa nan fǝr kit tǝmɗi sik ndikti Farta. Ndikti Farta tǝ ɗi, thlǝsik tǝ fee ndaˈan nǝch kǝ ndikti kǝristi. <verse eid="ROM 10:17" /><verse number="18" style="v" sid="ROM 10:18" />Paɗ ni chiha mee, kaa kittaˈan sikwak nandǝ ɓasan wa? Ai ǝ sǝk nda. Nakan mbuˈchi laulawaɗan ndat wa,</para>
  <para style="q1" vid="ROM 10:18">“Ɓǝrati shenuˈti yanda kǝmanti heshiha nat,</para>
  <para style="q2" vid="ROM 10:18">Ndikti yanda sheˈ kǝ ndukwa heshi.”<verse eid="ROM 10:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="ROM 10:19" />Nii nggǝr chiha mee, sǝnwaknǝ Israˈilawecha saktǝ shenuˈtaˈan wa? Tǝrkwathl kanan ndech Musa wa,</para>
  <para style="q1" vid="ROM 10:19">“Nii ɗǝf wunchi kǝ sǝraˈwun fee chaˈwakchǝ kǝ nafcha,</para>
  <para style="q2" vid="ROM 10:19">Nii ɗǝf wunchi kǝ sǝɓawun hwirkaɗi kǝ ɗar hahǝɗi nawaktǝ ɗathlǝ yandǝsi.”<verse eid="ROM 10:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="ROM 10:20" />Ishaya ndik chan nggǝ lekǝt fa wa,</para>
  <para style="q1" vid="ROM 10:20">“Ə ɓǝssichi fee ka wakchi nenchi,</para>
  <para style="q2" vid="ROM 10:20">pǝninchi fatinchi kǝmɗi fee chihawakchi nenchi.”<verse eid="ROM 10:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="ROM 10:21" />Paɗ kǝ ɗar Israˈilawecha ndakanwa,</para>
  <para style="q1" vid="ROM 10:21">“nat parta thlǝ pannanchi harchi chiha,</para>
  <para style="q2" vid="ROM 10:21">kǝmɗi nafchiɗi thlǝ fǝrwakchi mannda tǝ paɗ kumthlǝmatˈyadǝsi.”<verse eid="ROM 10:21" /></para>
  <chapter eid="ROM 10" />
  <chapter number="11" style="c" sid="ROM 11" />
  <para style="s">Kar wu Farta nafchiyan wa</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1" />Nii chihaa mee, kar Farta nafchiyan wa? Auwa, nggǝt tǝ indinchi thlǝ Israˈila naki, kwathl Ibrahim, paɗ weˈtǝ ndǝ Benjamin. <verse eid="ROM 11:1" /><verse number="2" style="v" sid="ROM 11:2" />Kar wu Farta nafchiyan wa, fee taatǝn tǝrkwathl kanan. Sǝnwowun ǝnɗi mbuˈtǝ laulati Farta, kǝ ɗar Iliya mǝɗi ɗǝtǝn tǝ tǝta kǝmɗi Farta, kǝ ɗar nafchi Israˈila? <verse eid="ROM 11:2" /><verse number="3" style="v" sid="ROM 11:3" />Ndatwa, “Chinda, ɓǝlandi fǝ mbanchiyo, paɗ fufohankandi mǝt thle ɓǝra ichiyo kaɗi. ngǝt ndak takcha, paɗ tandǝ kata kǝ ɓǝlichinda”? <verse eid="ROM 11:3" /><verse number="4" style="v" sid="ROM 11:4" />Weˈtǝ nggǝmǝn mi fǝraandǝ Farta? “Ɗǝfani indinchi nafchǝha aru muɗ, fee kopwakchǝha kǝ manaandǝ Farta yi lekta thla thlǝ ˈya fee wa Baˈal.” <verse eid="ROM 11:4" /><verse number="5" style="v" sid="ROM 11:5" />Kǝɗu choktǝn nakanya, Takǝt nafchis fee tatǝ Farta nguɗeyh kǝthlǝm kaakǝtˈyan. <verse eid="ROM 11:5" /><verse number="6" style="v" sid="ROM 11:6" />Taˈtǝ Farta chok kǝ ɓǝra kaakǝtyan nga kǝ ɗar tarchiɗi chǝt ndat wa, ma taˈtǝ Farta chok kǝ ɓǝra ǝnɗi chit nafcha, kaakǝtˈyan chokwa kǝ ka kaakǝtawa.<verse eid="ROM 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 11:7" />Kǝn hacha? Tǝ wulan nafchi Israˈilawecha mbǝsandǝ ǝnɗi natndi kata wa. Paɗ fee tatǝ Farta nggudeyh mbǝssancha, kwaan nafchaˈan nggǝlan kandǝ thlǝmech ˈyanda kǝ ɓǝra ˈyati Farta. <verse eid="ROM 11:7" /><verse number="8" style="v" sid="ROM 11:8" />Kǝɗ thla yarandǝ fee ha ndat wa,</para>
  <para style="q1" vid="ROM 11:8">“Fǝran Farta tandǝ Shemeta yi kumi sǝnwaktǝ ǝna, wenita yi kumi nata,</para>
  <para style="q2" vid="ROM 11:8">thlǝmata yi kumi sǝkta, paˈ kǝ ɓukiya.”<verse eid="ROM 11:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="ROM 11:9" />Ndak Dauda wa:</para>
  <para style="q1" vid="ROM 11:9">“Sǝm ǝn ˈyanda kǝ chok kǝ ɗafta,</para>
  <para style="q2" vid="ROM 11:9">thla ɗǝ faandǝ fee tanda kǝthlǝm kǝ kǝsandǝchi, kǝ hǝmndiyandǝha. Kǝ chok kǝ nɗakwan che wansar tanda,<verse eid="ROM 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ROM 11:10" />Kǝ chok wenichanda tǝ wuthlǝ fa thla nawaktǝndǝ naa mǝta,</para>
  <para style="q2" vid="ROM 11:10">kǝ kun felchandǝha kǝ kweˈkǝɗan.”<verse eid="ROM 11:10" /></para>
  <para style="s">Hǝraˈandǝ fee nawakchǝ kǝ Yahudawecha</para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11" />Paˈ kǝ nakanya ngǝt chiha mee. Chek Israˈlawecha wansarta, hǝmchandǝha kǝ nggǝr thlaˈta wa wa? Auwa, paɗ ɓǝɓifaɗi chindiya, chok kan kǝ mban hǝraˈti fee nawakchi kǝ Yahudawecha, chichan kǝɗu, kǝthlǝm kǝ ɗǝftǝ Israˈilawecha kǝ sǝraˈta. <verse eid="ROM 11:11" /><verse number="12" style="v" sid="ROM 11:12" />Ma ɓǝɓifaɗi chǝt nda ndaˈan ɓech tǝ mbǝs ǝn har hurheshi, wulandǝyanda paɗ ɓi tǝ mbǝs ichikǝhar kǝmɗi fee nawakchǝ kǝ Yahudawecha, wun nech sǝn sǝrtǝ mbǝs ǝn kǝ har ma nggom Israˈilawechi kaɗ nat? <verse eid="ROM 11:12" /><verse number="13" style="v" sid="ROM 11:13" />Ngǝt ndiktǝ tǝ wunchi kun tǝɗi nawakchi kǝ Yahudawecha. Nakan ngǝt nech kǝ kimshaa yi Yesu kǝmɗi fee nawakchǝ kǝ Yahudawecha, ni nat tǝ thlaˈkirsha tǝ terchi. <verse eid="ROM 11:13" /><verse number="14" style="v" sid="ROM 11:14" />Paɗ kǝ ɗǝfi nafchin chi kǝ sǝraˈta, tǝ kǝɗu nati hǝraˈndǝ feuna hurnanda. <verse eid="ROM 11:14" /><verse number="15" style="v" sid="ROM 11:15" />Ma kartǝɗi kartǝfe tanda, chok kǝ ǝna tahsandǝ nafchi heshiɗiya tǝ Farta, nech thlǝt tandǝ nat wa kǝni? Nechan ɓat tǝ mbǝs shishingnda mǝɗi fee mǝrcha. <verse eid="ROM 11:15" /><verse number="16" style="v" sid="ROM 11:16" />Ma njohǝmǝn ɗi nggak tǝ fee chit har fǝrandǝ fee Farta chǝdchǝɗ, pinwa takǝɗan nan nat chǝdchǝɗ. Kǝɗu ma thlaran chǝdchǝɗ naa njartaan nat chǝdchǝɗ paɗ. <verse eid="ROM 11:16" /><verse number="17" style="v" sid="ROM 11:17" />Paɗ ma chalthlan fee njartǝ ɗǝftǝ inabi kaɗi yi wira, chi ɗǝ nech kǝ njartǝ ɗǝftǝ inabi yi chanjeya, kǝnan fee ret ˈyowun tǝ ɗǝftǝ inabi yi wiri, thlǝ necho mbǝs ɗǝsǝmɗiyo fii thlaar ɗǝftǝ inabin, <verse eid="ROM 11:17" /><verse number="18" style="v" sid="ROM 11:18" />mǝthl nen thlaˈandǝ kirshawa kǝ ɓǝra njartǝ ɗǝftǝ inabi tǝɗi chicha thla ndǝ fee kaɗi. Maachi thlaˈandǝ kirsha kǝ kuɗukin tǝ ndat wa ngga chi thlǝ kǝrchǝ thlaar ɗǝftaˈan wa, thlaar chaˈan thlǝ furuchi ɗǝsǝmnda. <verse eid="ROM 11:18" /><verse number="19" style="v" sid="ROM 11:19" />Maˈ kǝ ndenwa, chathlanfe njarchaˈan kaɗi maˈ kǝ kǝnan fee retˈyo tǝ inabi taˈan. <verse eid="ROM 11:19" /><verse number="20" style="v" sid="ROM 11:20" />Chok kǝɗu, chicha thlanchi fee kaɗi kǝthlǝm kumi fǝr kit ˈyanda. Kun paɗ thlarwun ha kǝ dar fǝr kit yowun, kǝthlǝm daˈan kǝ chok wun tǝ thlaˈkirshi fawa, lekaman Farta. <verse eid="ROM 11:20" /><verse number="21" style="v" sid="ROM 11:21" />Ma malawu Farta kaa njartǝ dǝftǝ inabi taˈan wa, chikǝni, nen maluchu wa.<verse eid="ROM 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 11:22" />Ə mǝɗa thlǝ mbahǝndǝmǝn naa kafati Farta tǝ paɗ ɓahta, pǝntǝ ɓahtiyanha kǝmɗi fee hǝmchiha, paɗ pǝnkan kafatˈyan kǝmɗiyo, ma nɗin kǝ pangnga tǝ choktǝ hur kaakǝtˈyan. Maa ɗiwen kǝ pangnga tǝ choktǝ hur kaakǝtˈyan wa, chi paɗ nafe chalthlu tǝ kaɗi ǝ fǝl inabi taˈan. <verse eid="ROM 11:22" /><verse number="23" style="v" sid="ROM 11:23" />Tǝ paɗ ma ɗǝwu Yahudawecha kǝ pangngga tǝ kumi fǝr kit ˈyandawa, nafe wumandadha tǝ fǝl inabi taˈan, kǝthlǝm naa Farta mbahǝn ngǝrandad kaɗi kǝ fǝl inabi mǝɗi natndǝ choh. <verse eid="ROM 11:23" /><verse number="24" style="v" sid="ROM 11:24" />Ma kun tǝɗi nawakchi kǝ Yahudawecha, kun tǝɗi nech kǝɗ njartǝ ɗǝftǝ inabi yi hurhwalita thla chalthlandǝfe kaɗi, wumankǝ fee ret tanda tǝ thla nech ǝ wiri, chich fee thleya paɗ nga kǝɗ thla thlǝ kǝnadǝ fee reti ɗǝfchawa. Chika nakan wa nafchi Israˈilawacha nechandǝ kǝɗ weˈtǝ inabi yi wira, nan nat paˈpa kaˈan mǝɗi Farta kǝ ngǝrtǝ ngǝrandǝ njarchaˈan tǝɗi chathlandǝ fee kaɗi ǝ ɗǝf tǝɗiya thla nech kǝ fǝlan.<verse eid="ROM 11:24" /></para>
  <para style="s">Na Farta hǝraˈandǝ nafchi Israˈilawecha nat</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25" />Wanmanchina, yahǝnchis kǝ sǝnwun wuɓtǝ ndiktǝɗiya, kǝthlǝm nan ˈyatowun saktǝ ndat wa ɗathliyowun nggǝ sǝrtaˈan suwa. Kwaˈkwa tǝ indi nafchi Israˈilawecha ngga kǝ pori wa, paɗ nan ɗǝt kǝ pangnga har kǝ fartǝɗi naa tertǝ fee nawakchi kǝ Yahudawecha kǝmchis kǝ ɓaanda kǝmɗi Farta kǝ tǝrndǝha ǝ ndiiɗi. <verse eid="ROM 11:25" /><verse number="26" style="v" sid="ROM 11:26" />Tǝ mbanɗiya nafe hǝraˈandǝ nat nafchi Israˈilawecha. Kǝɗ ǝnɗi yarandǝ fee ha ndat wa,</para>
  <para style="q1" vid="ROM 11:26">“Thlǝ hǝraˈta nechan ɓat thlaˈtǝ Sihiyona.</para>
  <para style="q2" vid="ROM 11:26">nan mbǝhandǝ nat kumi para Farta kaɗi ǝ hur wanɗǝkaɗati wanchi Yakubu.”<verse eid="ROM 11:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ROM 11:27" />Ə ɗǝf miiɗi chiti tǝ tandiya tǝ khunnata,</para>
  <para style="q2" vid="ROM 11:27">fartǝɗi nati tǝrandi ɓǝɓǝfatˈyandǝ kaɗi.<verse eid="ROM 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 11:28" />Kǝthlǝm karndǝ kwastǝ ndikta, chok kǝ Yahudawecha kǝ fǝ atǝkrekǝti Farta kǝthlǝm ngun. Paɗ kǝthlǝm tatǝɗi chit Farta, chok ndǝ kǝ shikechaˈan kǝthlǝm kaakech nanda. <verse eid="ROM 11:28" /><verse number="29" style="v" sid="ROM 11:29" />Nakan pafǝn kǝti Farta tǝ ˈyatˈyan chokndǝ kǝɗ ǝnɗi natnda. Nga ichiɗi naa Farta tam malanda wa. <verse eid="ROM 11:29" /><verse number="30" style="v" sid="ROM 11:30" />Choh ngun tǝɗi nawakchi kǝ Yahudawecha ngun fǝ kumi fǝr manda kǝmɗi Farta, paɗ nakanya mbǝswun chok tǝ kǝ fee haɗanchi Farta fa tǝmɗi kumi fǝr mandi Yahudawecha. <verse eid="ROM 11:30" /><verse number="31" style="v" sid="ROM 11:31" />Kǝɗu paɗ nakanya Yahudawecha fǝr wandǝ manda kǝmɗi Farta wa. Thleya paɗ nakanya naa Farta haɗandatfa kǝɗ thla haɗandǝwunfǝyu. <verse eid="ROM 11:31" /><verse number="32" style="v" sid="ROM 11:32" />Kǝthlǝm ngǝran Farta chika wun nefa kǝ mafata yi kumi fǝr manda, kǝthlǝm kǝ haɗanchi chika wunfǝ nat.<verse eid="ROM 11:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="ROM 11:33" />Hwengǝkǝti kaɗati Farta, tǝ sǝn ǝnˈyan, tǝ langǝ kǝtˈyan, sǝrtaˈan suwa. Chakmiɗi naa Farta</para>
  <para style="q2" vid="ROM 11:33">chandǝ nafcha hwenga,</para>
  <para style="q2" vid="ROM 11:33">nefsi nech mbahǝn sǝn mbanchiyan wa.<verse eid="ROM 11:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="ROM 11:34" />Wun tamchi sǝn enɗi nech hur wanɗikaɗati Farta?</para>
  <para style="q2" vid="ROM 11:34">Ndu thlǝ sakanchan ǝn ha tǝndi?<verse eid="ROM 11:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ROM 11:35" />Wun tamchǝ fǝran pafǝn Farta,</para>
  <para style="q2" vid="ROM 11:35">kǝ chok nwaat kǝ tiyan fee?<verse eid="ROM 11:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="ROM 11:36" />Chǝk mii nat mǝthlan tǝncha. Chǝk mii nat chechan tǝmɗiyan. Ə mǝɗiyan nafe mbǝs chikamǝ.</para>
  <para style="q2" vid="ROM 11:36">Chika mǝ nat yaˈan. Maanda kǝn kǝ yaˈan kǝ kweˈkǝchi. Kǝ chok kǝɗu.<verse eid="ROM 11:36" /></para>
  <chapter eid="ROM 11" />
  <chapter number="12" style="c" sid="ROM 12" />
  <para style="s">Naɗi ha kǝmchǝsi, kǝmɗi nafɗi thlǝ parech Farta</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1" />Kǝthlǝm ndaˈan, wanmanchina, kǝthlǝm tertǝ haɗandǝ nafchi Farta fa kǝmɗiyamǝn, nggǝt shiyowunnda, fǝram indiyowun kǝɗ kǝnau pafǝn yi shishingnda, chiɗ chiɗ ina thlǝta kǝmɗi Farta. Thleya nech kǝ fǝr kǝnau pafǝn yi kit natwun chita kǝmɗi Farta. <verse eid="ROM 12:1" /><verse number="2" style="v" sid="ROM 12:2" />Kǝ nggǝmwunfa natˈyowun ha, kǝ chokwun kǝɗ ǝnɗi naa nati nafchi heshiɗiya wa. Paɗ malan Farta, kǝ mbeɗanchǝ saktǝ wanɗǝ kaɗaɗˈyowunha nat. Tǝ kǝɗu, natwun sǝn ǝnɗi yahtǝ Farta kǝ chiwun. Kǝ sǝnwun ǝnɗi nech ndiˈchan, ǝnɗi nech mbǝnandǝ Farta fa, tǝ ǝnɗi nech keˈkeˈ nat.<verse eid="ROM 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3" />Kǝthlǝm kaakǝɗ ɗi chi tǝ Farta ya, ngǝt tǝɗandǝ thlǝmati chika wun hur wun, ndat wa, mǝ tǝr chika wun indiyan tǝ maanda kǝɗ thla kǝmwackchǝs kǝ chawa. Paɗ chikawun kǝ tǝrtǝ indiyan keˈke kǝɗ inɗi natǝn. Kǝthl nen chakan mee indiyo keˈke tǝ fǝrkit tǝɗi fǝrutǝ Farta. <verse eid="ROM 12:3" /><verse number="4" style="v" sid="ROM 12:4" />Tanngathla fat ˈyamǝnsi terchan fǝ fat arta, paɗ nat tanngathlechaˈan tarchiyanda samǝn samǝn. <verse eid="ROM 12:4" /><verse number="5" style="v" sid="ROM 12:5" />Kǝɗu paɗ natǝn tǝ mǝnchi, chika mǝ nakamǝn terchan, chok mǝn kǝ fat arta hur Kǝristi, nechamǝn terchan wumamǝnchi fee ha kafi fat arta, chikayen tangathlata tangathlati sheɗan nakan. <verse eid="ROM 12:5" /><verse number="6" style="v" sid="ROM 12:6" />Nakan fǝramǝn kǝ Farta mbǝr ǝn samǝn samǝn tǝmɗi kaakǝɗɗi chamǝn ndǝ Farta, paɗ kǝmsi kǝ chimǝn tersi tǝ tanda. Ma fǝramǝnchan mbaˈ ǝnɗi nech sǝbtǝ kǝ pannga, kǝmsi kǝ chimǝn tersi taˈanchi tǝmɗi fǝr kit tǝɗi nessiyamǝn. <verse eid="ROM 12:6" /><verse number="7" style="v" sid="ROM 12:7" />Ma mbǝr ǝnɗi fǝramǝndǝn yi manaandǝ nafcha, manankamǝn nafcha. Ma yi chaˈanan kaɗ fǝramǝndǝn, chaˈankamǝn kaɗi. <verse eid="ROM 12:7" /><verse number="8" style="v" sid="ROM 12:8" />Ma fǝramǝnchan mbǝrˈinɗiya yi ndǝksandǝ raˈan, malan kǝ chokmǝn kǝ fǝ ndǝksandǝ raˈan. Ma fǝranmǝnchan mbǝr ǝnɗiya yi kǝsandǝ raˈansi, chikamǝn kǝɗu tǝ her chaˈ. Ma thlǝ pangndǝ nako, ɗǝko kǝ pang tǝ pangndiyo tǝ hwir arta. Ma yi haɗandǝ raˈanfa chikamǝn kǝɗu tǝ mbǝnfata arta.<verse eid="ROM 12:8" /></para>
  <para style="s">Tǝmɗi nafe sǝn thlǝ para Farta yi kit</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9" />Kǝmchansi yahraˈan ˈyowun kǝ chok tǝ kit fa. Kǝ karwun nat ǝnɗi nech kǝ ɓǝɓiˈan, paɗ kǝ kǝswun ǝnɗi har nech ndiˈchan kaˈan. <verse eid="ROM 12:9" /><verse number="10" style="v" sid="ROM 12:10" />Tǝmɗi yahraˈan paɗ, yahamraˈan kaˈan. Tǝmɗi fǝr maandǝ paɗ, chikawun kǝ manantǝ sheɗan kǝ pǝɗantǝ thla ha thlǝ chǝt sheɗan. <verse eid="ROM 12:10" /><verse number="11" style="v" sid="ROM 12:11" />Mǝ hatowun ha, tǝ kweˈtǝha, tǝ chǝtˈtera wa. Manamandǝn Farta nat tǝ wanɗǝkaɗech ˈyowun. <verse eid="ROM 12:11" /><verse number="12" style="v" sid="ROM 12:12" />Malaman ɗǝf wanɗǝkaɗech ˈyowun kǝ ɗǝftǝwunchi kǝ chokwun tǝ mbǝn fata. Kǝ kǝriswun hur ɓahti ˈyowun. Kǝnowun shiyandǝ Farta nweenmǝta. <verse eid="ROM 12:12" /><verse number="13" style="v" sid="ROM 12:13" />Chakam ǝnɗi nessiyowun tǝ fǝ para mbanchi Farta fee nech kata, kǝthl nowun thlǝt ramcha tǝharchi chap-chap.<verse eid="ROM 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 12:14" />Shiyaman Farta kǝ ndǝfantǝ mbǝs ǝnkǝhar fee thlǝ ɓahowuncha. Kǝ ɗǝfantǝ tandǝ mbǝsˈǝnkǝhar, kǝ hwombanchi tandawa. <verse eid="ROM 12:14" /><verse number="15" style="v" sid="ROM 12:15" />Mbǝnam fata tǝ fǝ nech mbǝnfata. Paɗ tama, tǝ fee nech tǝta. <verse eid="ROM 12:15" /><verse number="16" style="v" sid="ROM 12:16" />Chokam hashas tǝ raˈan kǝ pǝnwun thlaˈtǝ indawa, paɗ chokam shikekǝt tǝ fee ɗǝpaandǝ fee wa ngga ǝn nakanda wa. Kǝ pǝnwun indiyowun wa, pǝɗawun nafchiha tǝ ɗathla wa.<verse eid="ROM 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 12:17" />Mǝ tiwun mbǝɓifat kaɗ tǝ mbǝɓifatawa, mbǝramsi kǝthlǝm kǝ thlǝ naawun ǝnɗi naa nafchi natha, nat ndichan. <verse eid="ROM 12:17" /><verse number="18" style="v" sid="ROM 12:18" />Ma nan chita kǝmɗiyowun, kweˈyamha kǝ chokwun hashas tǝ chikawuni. <verse eid="ROM 12:18" /><verse number="19" style="v" sid="ROM 12:19" />Wanmanchina, kǝ tiwun mɓǝɓifat kaɗwa, malamandǝn Farta kǝ tiyamǝchis kaɗi tǝ sǝbtǝ hwǝrˈyan. Kǝthlǝm nechan kǝ yaraɗan hur ndikti Farta, ndat wa, “Titǝkaɗi yina, ngǝt paɗ nii tiyowundǝs kaɗi nda chinda.” <verse eid="ROM 12:19" /><verse number="20" style="v" sid="ROM 12:20" />Yaran kǝfeha paɗ hur ndikti Farta ndat wa, “Ma mitǝfi atǝkretǝwa, fǝranko ndǝsǝmnda kǝ sǝma. Ma kuchǝmndǝ fiyan, fǝranko ˈyema kǝ sa, ma ngun chǝt kǝɗu nowun ndǝf tandǝ kǝ haran fat tanda hur wanɗikaɗat ˈyanda.” <verse eid="ROM 12:20" /><verse number="21" style="v" sid="ROM 12:21" />Kǝ malawun ɓǝɓifata, kǝ ngwanowunchiwa. Kǝrsǝ ndaˈan, ngwanaman ɓǝɓifata, tǝmɗi chǝt tarchiɗi nech ndiˈchan.<verse eid="ROM 12:21" /></para>
  <chapter eid="ROM 12" />
  <chapter number="13" style="c" sid="ROM 13" />
  <para style="s">Fǝr maanda kǝmɗi pangngǝncha</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1" />Nwaat chikawun nefa kǝ fǝrtǝ manda kǝ pangngǝnchi haha. Kǝthlǝm alkǝt pangndǝswa, ma nga mǝɗi Farta wa. Paɗ nat fǝ alkǝt pangngǝn chiɗi nessiyamǝn Farta ɗǝfchi tandǝsi. <verse eid="ROM 13:1" /><verse number="2" style="v" sid="ROM 13:2" />Kǝthlǝm ndaˈan nat thla karchǝ fǝr maandǝ kǝ pangngǝnchi haha, kartǝ fǝr maandǝ kǝ ndar nafchǝɗi ɗǝftǝ Farta ha, nat thla thlǝ chich kǝɗu nan kab chak mee kafa. <verse eid="ROM 13:2" /><verse number="3" style="v" sid="ROM 13:3" />Kǝthlǝm pangngǝnchi haha nga ina lekandata wa, maa thlǝ chicho ǝnɗi kǝmchisi, ma nga fee thlǝ chich ɓǝɓifata wa. Yehǝnsi kǝ chekǝnha tǝ lekandǝ nafɗi naa alkǝt pang ndiyan suwa? Chiko ǝnɗi nech ndiˈchan, mǝthlan paɗ nan chǝmwechi. <verse eid="ROM 13:3" /><verse number="4" style="v" sid="ROM 13:4" />Kǝthlǝm pangngǝn chaˈan fǝ tarchi Farta nakanda, kǝthlǝm kǝ kǝsowun chindǝsi. Paɗ ma thlǝ chicho mɓǝɓifata, leka ndǝn tanda, kǝthlǝm alkǝtˈyandǝsi kǝ chuchindǝ kita yi kit. Tandǝ fǝ tarchi Farta, kǝthlǝm kǝ chandǝ kita fee thlǝ thlǝnanchǝ mɓǝɓifat kaɗi. <verse eid="ROM 13:4" /><verse number="5" style="v" sid="ROM 13:5" />Kǝthlǝm ndaˈan nwaat kǝ fǝrwun maanda kǝmɗi pangngǝncha. Ngga kǝthlǝm kǝ rakawun sǝɓtǝ hwiri Farta harwa, paɗ kǝthlǝm ǝnɗi mbuˈtǝ wanɗǝ kaɗat ˈyowun kǝ chǝwun.<verse eid="ROM 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 13:6" />Ndaˈan chicha thlǝ titǝwun chamnda, kǝthlǝm pangngǝncha fǝ tarchi Farta, fee malanchǝ tarchanda kǝ ɗar tar pangnda. <verse eid="ROM 13:6" /><verse number="7" style="v" sid="ROM 13:7" />Tiyaman chikawun ǝnɗi natǝn parawunchi. Ma chamnda kǝmchǝsi kǝ tiwun, tikowun, ndu yi ichiyowun, tikowun. Lekaman thla kǝmchǝsi kǝ lekan fee, manaman thla kǝmchǝsi kǝ manan fee paɗ.<verse eid="ROM 13:7" /></para>
  <para style="s">Ndiɗandǝ kusiˈ ha tǝmɗi yah raˈan</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8" />Mǝ par yowun wunchǝ kuma ǝna wa, maangga yi yahraˈan ndakwa. Kǝthlǝm thla thlǝ yahchǝ sheɗan, ndiɗan tǝ kusiˈ i Musa ha paɗ. <verse eid="ROM 13:8" /><verse number="9" style="v" sid="ROM 13:9" />Kusiˈ chǝɗi ndechwa, “Mǝ chin fǝlaukǝtawa, ɓilin fatawa, yerkǝn wa, yehǝn ǝni nefawa, nat tǝ kwaan kusiˈ chaˈan mbǝsndǝ ndiiɗ tǝ ha, tǝmɗi kusiˈ tǝɗi ndechawa, yaham chika wun nefa kǝɗ ǝnɗi thlǝ yahtu indiˈyo.” <verse eid="ROM 13:9" /><verse number="10" style="v" sid="ROM 13:10" />Ma thlǝ yahcho yowuna, no tam chantǝ mɓǝɓifata wa. Kǝthlǝm ndaˈan yah raˈan ndaˈan nech kǝ ndiiɗ tǝ kusiˈ taˈan.<verse eid="ROM 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11" />Nwaat kǝ chǝwun kǝɗu, nakan sǝnwun weˈtǝ yuwa heshiɗi natmǝn huran, saˈ fartǝɗi natwun nahǝndǝ ǝ ˈyena. Kǝthlǝm fartǝɗi naafe hǝraˈamǝnda, ǝ ɓi nduk ha nakanya, pǝɗantǝ fartǝɗi tǝrtǝmǝnha. <verse eid="ROM 13:11" /><verse number="12" style="v" sid="ROM 13:12" />Mǝt nduk weendǝ kaɗi, wat fartǝ ɓat kesh. Kǝthlǝm ndaˈan welaman tarchi wuthlǝ kaɗi, pam kapa yaˈancha yi ɗaˈkǝta. <verse eid="ROM 13:12" /><verse number="13" style="v" sid="ROM 13:13" />Wi ˈyam kǝɗ ǝnɗi kǝmchǝsi tǝ fee thlǝ chokchǝ hur ɗaˈkǝta. Ngga tǝ nggaathla, tǝ saaɓǝɓiˈicha wa, ndu tǝ fǝlaukǝta wa. Ngga tǝ ka chok sǝk mbǝndǝfa yi kumi hartǝfata wa, tǝ mbata, tǝ sǝraˈta wa. <verse eid="ROM 13:13" /><verse number="14" style="v" sid="ROM 13:14" />Kǝthlǝm ndaˈan tǝram ɗǝchiti chinmǝn Yesu Kǝristi. Kǝ fǝrawun fech ˈyowun mbanda kǝ chǝt ǝnɗi yahtǝn wa.<verse eid="ROM 13:14" /></para>
  <chapter eid="ROM 13" />
  <chapter number="14" style="c" sid="ROM 14" />
  <para style="s">Mǝ cheken mee wanmu wa</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1" />Thlam nafɗi nawaktǝ fǝr kit yan kwaˈkwa. Kǝ wumowunchi asˈinda ha tǝ yowuna wa kǝ ɗar ǝnɗi naa kaɗatˈyo tǝ yaˈan sam samǝn wa. <verse eid="ROM 14:1" /><verse number="2" style="v" sid="ROM 14:2" />Fǝr kit i yowuna, nan ngǝmandǝs kǝ sǝmtǝ chik yen ɗǝsǝmnda, yowun paɗ thla nawakchǝ kwaˈkwa hur fǝr kit ˈyan, wan ɗǝftǝ ndak thlǝ sǝmndǝn. <verse eid="ROM 14:2" /><verse number="3" style="v" sid="ROM 14:3" />Nafɗi thlǝ sǝmchǝ chik yen ɗǝsǝmnda kǝ njǝr tǝ thla thlǝ sǝmwakchǝ koha ɗǝsǝmnda wa. Thla thlǝ sǝmchǝ wan ɗǝftǝ ndak kǝ chakan tǝ mee thla thlǝ sǝmchǝ koha ɗǝsǝmnda, kǝthlǝm tapi thlǝ Farta ndi. <verse eid="ROM 14:3" /><verse number="4" style="v" sid="ROM 14:4" />Wun nako hacha natu chakan mee mafati yowuna? Ndu mafaɗan kǝ thlarha ndu kǝ hǝmha nat nechan ɓǝrati thlǝ wǝrˈyan, nan mbahǝn thlartǝ ha, kǝthlǝm chinda nan mbahǝn ɗǝf ndi kǝ thlar ha.<verse eid="ROM 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 14:5" />Yowun thlǝ mananchan fartǝ arta mǝni kwaˈan farchaˈan. Yowun paɗ thlǝ tǝrchan Fartaˈan nat arta mǝɗiyan. Chik wuni kǝ thlarha kǝ ɗar ǝnɗi sǝndǝnsi hur wanɗikaɗatˈyan. <verse eid="ROM 14:5" /><verse number="6" style="v" sid="ROM 14:6" />Nat thla thlǝ tǝrchi fartǝ arta kǝ kappa fartǝ ǝ mǝɗˈyan, thlǝ chichan kǝɗu kǝ manan tǝ Farta. Nat thla thlǝ kangchǝ chik yen thlǝwa thlǝ chikan kǝɗu kǝ manan te Farta, nakan thlǝ chanchan usoko Farta. Nat thla thlǝ kang wakchǝ chik yen thlǝwa, chikan kǝɗu kǝ manan te Farta, nakan thlǝ chanchan usoko Farta. <verse eid="ROM 14:6" /><verse number="7" style="v" sid="ROM 14:7" />Yowunsǝ hur mǝn nech nat ha ndu mǝrtǝ kaɗ tǝ alkǝt indiyan wa. <verse eid="ROM 14:7" /><verse number="8" style="v" sid="ROM 14:8" />Ma ngamǝn nat ha nechamǝn nat ha kǝthlǝm kǝ manamǝn Farta. Ma mǝrmǝn, kǝ mǝrmǝn paɗ kǝthlǝm kǝ manamǝn Farta. Kǝthlǝm kǝt ndaˈan, ndu tǝ namǝn nat ha, ndu mǝrtǝ kaɗi, tǝ namǝn kǝ yi chinmǝn.<verse eid="ROM 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 14:9" />Kǝthlǝm kǝt ndaˈan, mǝr Kǝristi, paɗ thleˈ tǝ shishingnda, kǝthlǝm kǝ chok kǝ chin fee nech kǝ mǝmatecha, tǝ fee nech nat ha. <verse eid="ROM 14:9" /><verse number="10" style="v" sid="ROM 14:10" />Chikǝni, thlǝ sǝmchǝ wan ɗǝftǝ ndak, mǝ chich thlǝ natu chakan mee fowuna? Chi paɗ, thla thlǝ sǝmchǝ chik yen ɗǝsǝmnda, mǝ chich thlǝ njǝr tu fee paɗ fǝrchǝ kit? Natmǝn, namǝn thlartǝha pangngǝn Farta, mǝthlan nech chakamǝn mee. <verse eid="ROM 14:10" /><verse number="11" style="v" sid="ROM 14:11" />Nechan kǝ yaraɗan hur laulawaɗan, ndat wa,</para>
  <para style="q1" vid="ROM 14:11">“Ngǝt nech kǝ chinda Farta thlǝ shishingnda, ndakǝwa,</para>
  <para style="q1" vid="ROM 14:11">‘Chik yen weɗa nan cham kuruminchiha ǝ pangǝnna,</para>
  <para style="q2" vid="ROM 14:11">chik wan shenuˈta paɗ kǝ ndawa ngǝt nech kǝ Farta.’ ” <verse eid="ROM 14:11" /><verse number="12" style="v" sid="ROM 14:12" />Kǝthlǝm ndaˈan, chikwun nefa nan mbuˈ ǝnɗi chitǝn tǝ indiyan pangngǝn Farta.<verse eid="ROM 14:12" /></para>
  <para style="s">Kǝ chin ǝnɗi naa shetu hǝmndǝha wa</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13" />Kǝthlǝm ndaˈan, malaman naa ɓǝɓifati raˈan ha. Chik wun kǝ tǝrtǝ sheɗan hur wanɗǝkaɗat ˈyan, ndat wa, ngen chok kǝ ɗakwan che wansartiyanwa, thla thlǝ ɗǝf chǝ sheɗan kǝ ɓǝɓifata wa. <verse eid="ROM 14:13" /><verse number="14" style="v" sid="ROM 14:14" />Sǝninchi, paɗ nii mbahǝn mbuˈta hur thlǝm chinda Yesu, ndat wa, ngǝ ǝnsi tǝ indiyan nawakchǝ chǝɗchǝɗ wa. Paɗ ma tǝr yowun wa ǝnsi nawakchǝ chǝɗchǝɗ, chǝɗchǝɗ mǝɗˈyan wa. <verse eid="ROM 14:14" /><verse number="15" style="v" sid="ROM 14:15" />Ma ɗǝsǝmǝnɗi thlǝ sǝmndu thlǝ ɗǝfchan kǝ sǝɓ hwiri wanmu kaɗi, chi chok kaafata wa. Kǝ nggǝmen ɗǝsǝmǝnɗi thlǝ sǝmndu kǝ ɓǝlan tǝ wanmu thla mǝrtǝ Kǝristi kǝ ɗaran wa. <verse eid="ROM 14:15" /><verse number="16" style="v" sid="ROM 14:16" />Kǝ nggǝmen ǝnɗi nech ndiˈchan, kǝ ndik fee sǝɓtaˈan kǝ ɗaran wa. <verse eid="ROM 14:16" /><verse number="17" style="v" sid="ROM 14:17" />Kǝthlǝm kutǝrakti Farta, nga ndiktǝ sǝmnda, tǝ sata wa, nechan kǝ ndiktǝ kaakǝta, kǝɓikaɗi, tǝ mbǝn fata, hur Shemeti Farta. <verse eid="ROM 14:17" /><verse number="18" style="v" sid="ROM 14:18" />Nat thla thlǝ mananchǝ Kǝristi tǝ mban ɗiya, thlǝ tǝranchan hwiri Farta ha, paɗ naa nafchǝ thlǝt ndi.<verse eid="ROM 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 14:19" />Kǝthlǝm kǝt ndaˈan, kweˈyamha tǝ ichiɗi nech ɓat tǝ kǝɓikaɗi, tǝ ndǝkˈsandǝ raˈan. <verse eid="ROM 14:19" /><verse number="20" style="v" sid="ROM 14:20" />Kǝ sǝɓawun teri Farta kaɗ kǝthlǝm sǝm ɗǝsǝmndiyowunwa. Chǝkayen ɗisǝmnda nechan chǝɗchǝɗ, nat tǝ kǝɗu sǝɓtǝ ǝna ma ɗǝsǝmǝnɗi thlǝ sǝmndu nech ɗǝf wanmawa kǝ che wansarta. <verse eid="ROM 14:20" /><verse number="21" style="v" sid="ROM 14:21" />Ndǝɗˈwa suwa, kǝ kengngǝn thlǝwa wa, ndu sa ˈyam innabi, ndu kǝ chin chǝkamǝ nat, thla nech ɗǝf wanmu kǝ hǝmha wa. <verse eid="ROM 14:21" /><verse number="22" style="v" sid="ROM 14:22" />Fǝr kit ˈyo suwa? Kǝsu har pathlthlang wa tǝ Farta. Thlǝ mbǝs ǝnhar thla pǝnandǝ wanɗikaɗatˈyan ǝnɗi chǝtǝn ndiˈchan. <verse eid="ROM 14:22" /><verse number="23" style="v" sid="ROM 14:23" />Thla hunawaktǝ wanɗikaɗatˈyan, paɗ ǝ sǝmi, chǝt ɓǝɓifata. Kǝthlǝm sǝmchan hur kumi fǝr kit. Nat ǝnɗi chǝt fee ngga hur fǝr kit wa, ɓǝɓifata.<verse eid="ROM 14:23" /></para>
  <chapter eid="ROM 14" />
  <chapter number="15" style="c" sid="ROM 15" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1" />Ngamǝn tǝɗi nech kwaˈkwa hur fǝr kit ˈyamǝn, kǝmchansi kǝ tǝrmǝn heˈti fee nawaktǝ alkǝtˈyandǝsi hur fǝr kit, kǝthlǝm kǝ kǝsamǝn tandǝsi hur kumi fǝr kit ˈyanda, paɗ kǝ chǝmǝn ǝnɗi nech mbǝnadǝ fatˈyamǝn fa ichǝtmǝn wa. <verse eid="ROM 15:1" /><verse number="2" style="v" sid="ROM 15:2" />Chikwuni kǝ tǝrantǝ wanɗǝkaɗati wanmanan ha kǝthlǝm ǝnɗi nech kǝsandǝsi tǝ paɗ tǝnandǝ fǝr kit ˈyan. <verse eid="ROM 15:2" /><verse number="3" style="v" sid="ROM 15:3" />Kǝthlǝm chika Kǝristi, ǝnɗi chǝtǝn ngga yi yah indiyan wa. Kǝɗ thla yarandǝ fee, ndat wa, “ˈYaraɗi thlǝ ˈyara fee wechi, chokkan nggǝt thlǝ ˈyara fee.” <verse eid="ROM 15:3" /><verse number="4" style="v" sid="ROM 15:4" />Ənɗi yarandǝfee choh hur laulawati Farta, yaranchǝ fee kǝthlǝm kǝ chaˈamǝn chǝfee har, ndat wa, tǝmɗi kǝrǝsiˈyamǝn tǝ ndǝkǝsǝfa tǝ ndikti Farta kǝ chokmǝn tǝ ɗǝf wanɗikaɗata. <verse eid="ROM 15:4" /><verse number="5" style="v" sid="ROM 15:5" />Malan Farta thla thlǝ fǝrchǝ kǝrǝsa tǝ ndǝkǝsǝfa, kǝ fǝrowunchǝ hashaskǝt tǝ raˈan kǝɗ thla thlǝ parat wun Kǝristi Yesu. <verse eid="ROM 15:5" /><verse number="6" style="v" sid="ROM 15:6" />Tǝ kǝɗu natwun kǝ chokwun mee arta, tǝ wanɗǝkaɗatˈyamǝn artǝ paɗ, kǝthlǝm kǝ manawun Fartaˈan, mǝthlan nech kǝ Farta tǝ chinda, yi chinmǝn Yesu Kǝristi.<verse eid="ROM 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7" />Kǝthlǝm ndaˈan, thlam raˈan tǝ harchǝ chap-chap kǝɗ ǝnɗi thlǝt Kǝristi wunchǝ tǝ harchǝ chap-chap yu, kǝthlǝm kǝ mananfee Farta. <verse eid="ROM 15:7" /><verse number="8" style="v" sid="ROM 15:8" />Ngǝt mbuˈowun saktǝɗi chich choktǝ Yesu kǝ mafata kǝmɗi Yahudawecha, kǝthlǝm kǝ pǝntǝ kit i Farta, kǝ sǝnadech ɗǝfmiɗi chandǝ Farta kaakech kaakech nandǝ choh, Farta nan ndiiɗa ndǝ ha. <verse eid="ROM 15:8" /><verse number="9" style="v" sid="ROM 15:9" />Kǝ ɗǝftǝ fee nawakchǝ kǝ Yahudawecha kǝ maanandǝ Farta kǝthlǝm kaakǝtˈyan. Kǝɗ thla yarandǝfee ha hur laulawata, ndat wa, “Kǝthlǝm kǝt ndaˈan chinda, nii chǝm wechi hur fee nawakchǝ kǝ Yahudawecha, nii in emsa kǝ maanani thlǝmwa.” <verse eid="ROM 15:9" /><verse number="10" style="v" sid="ROM 15:10" />Kǝ ɓukiya ndech ndikti Farta wa, “Kuntǝɗi nawakchǝ kǝ Yahudawecha, mbǝnam fa raˈanfa tǝ nafchǝ Farta.” <verse eid="ROM 15:10" /><verse number="11" style="v" sid="ROM 15:11" />Laulawa ɗan nggǝrkan ndat paɗ wa, “Chimam chinda nat kun tǝɗi nawakchǝ kǝ Yahudawecha. Chimamndi nat kun nafchiɗi nech hahichǝ samǝn samǝn.” <verse eid="ROM 15:11" /><verse number="12" style="v" sid="ROM 15:12" />Ndak Ishaya paɗ wa, “Yowun hur wanchi Yesse nan ɓata, nan chit kuturakta ti nafchǝɗi nawakchǝ kǝ Yahudawecha kǝmɗiyan naa ɗǝf wanɗǝkaɗata.”<verse eid="ROM 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13" />Malaman Farta, thla thlǝ ɗǝfchǝ nefa kǝ ɗǝftǝ wanɗǝkaɗata kǝ ɗar ǝna, kǝ ɗǝftǝ wanɗǝkaɗat ˈyowun kǝ chok tǝ mbǝnfata kaˈan. Kǝ fǝrowunchǝ kǝɓikaɗi, thla nech terchan kǝthlǝm kǝt fǝr kitˈyowun. Kǝthlǝm kǝ chekowun tǝ ɗǝf wanɗǝkaɗata kǝmɗiyan, tǝmɗi alkǝtǝ Shemeti Farta.<verse eid="ROM 15:13" /></para>
  <para style="s">Bulus tatǝ kimshaa kǝmɗi fee nawakchǝ kǝ Yahudawecha</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14" />Wanmanchǝna ngǝt tǝ indinchi ngǝmǝnchǝ wunchǝ fa, ndat wa kun tǝ indiyowun ndiiɗ wun kaɗ tǝ chǝt icha ndiˈchan, ndiiɗ wun kaɗ paɗ tǝ sǝnda, chaˈwunsi kǝ chaˈawun raˈan har. <verse eid="ROM 15:14" /><verse number="15" style="v" sid="ROM 15:15" />Nat tǝ kǝɗu yarowunchǝsi kǝ ɓǝra ǝna fowuna tǝ kapa ɓǝrata, kǝthlǝm kǝ kuɗukowunchi, kǝthlǝm maanɗi fǝritǝ Farta. <verse eid="ROM 15:15" /><verse number="16" style="v" sid="ROM 15:16" />Ɗǝftǝnenchǝ kǝ choki kǝ thlǝ chǝt teri Kǝristi Yesu, kǝ ɓǝra fee nawakchǝ kǝ Yahudawecha. Chokǝnchi kǝ thlǝ ɓas kwastǝ nɗiktǝɗiya yi Farta, kǝɗ thla thlǝ fǝranchǝ Farta icha, kǝthlǝm fee nawakchǝ kǝ Yahudawecha. Kǝ chokndǝ kǝ kǝnau pafǝn, yi thlǝta kǝmɗi Farta, chǝɗchǝɗ tǝmɗi Shemetǝ Farta. <verse eid="ROM 15:16" /><verse number="17" style="v" sid="ROM 15:17" />Kǝthlǝm ndaˈan thlǝ mbahǝnchi thlaˈandǝ kǝrsha hur kǝristi Yesu kǝ ɗar tarɗi nati chandǝ Farta. <verse eid="ROM 15:17" /><verse number="18" style="v" sid="ROM 15:18" />Ənsǝ nati mbuˈtawa, maangga ǝnɗi chit Kǝristi tǝmɗinchi wa. Tǝmɗi ɓat tǝ fee nawakchǝ kǝ Yahudawecha, kǝ maanandǝ Farta, tǝmɗi shenuˈtǝnchi tǝ tarchinchi. <verse eid="ROM 15:18" /><verse number="19" style="v" sid="ROM 15:19" />Tǝmɗi ichiɗi nech kǝ yi saka inda, tǝ paɗ tǝmɗi alkǝti Shemeti Farta, thlaˈtǝ Urshelima kǝ Ilirikun ɓasinchi kwastǝ nɗikti Kǝristi yi sǝkta thla takawakti ǝnha chika ngguɗyeh. <verse eid="ROM 15:19" /><verse number="20" style="v" sid="ROM 15:20" />Yahtinchi chǝk kwati kǝ ɓasi kwastǝ nɗiktiɗiya yi Farta, mǝɗi tam waktǝ fee sǝk kusheˈtǝ ndikti Kǝristi. Kǝ tǝni kǝ ɗar tǝrkan tǝnɗi ngga yowun chicha wa. <verse eid="ROM 15:20" /><verse number="21" style="v" sid="ROM 15:21" />Kǝɗ ǝnɗi natǝn kǝ yaraɗan hur ndikti Farta, “Fee tamwaktǝ fee ɓaˈanda kusheˈtǝyan, kǝ sǝndǝ anchi. Fee tamwakchi sǝk kusheˈtǝ ndiktiyan, kǝ sǝnnda.”<verse eid="ROM 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 15:22" />Ndaˈan chicha fartǝ terchan mbahǝn waktǝ ɓat kǝmɗiyowun.<verse eid="ROM 15:22" /></para>
  <para style="s">Tahǝsi Bulus fa kǝ wiˈyanchi hahi Roma</para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 15:23" />Nakanya pǝˈwu mǝtsi ǝ thle wan mǝrǝɓ ɗiya natǝ chit tera wa. Paɗ nakan hurechǝ terchan yahinchǝs kǝ ɓi nawunchi. <verse eid="ROM 15:23" /><verse number="24" style="v" sid="ROM 15:24" />Tachsinchǝf nakanya ma ngǝt ɗǝt kǝ hahi Asbaniya, ni parat tǝmɗiyowun. Kǝ mbǝnmǝn fat tǝ raˈan yi wan mǝnchi ngguɗyeh. Kǝrsǝ ndaˈan, kǝ fǝrichiwun ǝnɗi yahti, maa nggǝt pǝɗata. <verse eid="ROM 15:24" /><verse number="25" style="v" sid="ROM 15:25" />Nakanya tǝni kǝ Urshelima kǝ ɗani fee thlǝ fǝrchǝ kit kǝ Farta, ǝna kǝsandatsi. <verse eid="ROM 15:25" /><verse number="26" style="v" sid="ROM 15:26" />Wanmanchina hur Kǝristi, fee nǝch ǝ hahichi Makidoniya tǝ Akaya, sǝkndǝ mbǝn ndǝfa kǝ nggomandǝ icha kǝthlǝm fǝ ɓahcha hur fǝ fǝr kit kǝ Farta, fee nech Urshelima. <verse eid="ROM 15:26" /><verse number="27" style="v" sid="ROM 15:27" />Sǝkndǝ mbǝndǝf kǝɗu, chika nakan chok kǝ heˈtǝ indanda. Kǝthlǝm maa fen tǝɗi nawakchǝ kǝ Yahudawecha, mbǝs ndǝ mbǝs ǝn har yi Shemeta thlaˈtǝ Yahudawa, chanchi tandǝf nwaat kǝ kǝsandǝ Yahudawechisi tǝ kǝnau pafǝn yi ichiɗi nessanda. <verse eid="ROM 15:27" /><verse number="28" style="v" sid="ROM 15:28" />Ma tǝɓani tarɗa, fǝrandechi kǝsanan tandǝs kǝ har thla fǝrtǝfe kǝthlǝm tanda, ni wiˈyowun ndǝfa maa nggǝt kǝ Asbaniya. <verse eid="ROM 15:28" /><verse number="29" style="v" sid="ROM 15:29" />Sǝninchǝs ma ɓinchǝ kǝmɗiyowun, ni ɓowun ndiiɗ mbǝs ǝnhar yi Kǝristi.<verse eid="ROM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30" />Wanmanchǝna, nggǝt shiyowunda hur thlǝm Chinmǝn, Yesu Kǝristi, tǝ paɗ yahtǝɗi thlǝ fǝr tǝ Shemeta, nggǝt shiyowun nda ndat wa. Kǝsamitǝnsi tǝ shiita tǝ kweˈtǝ ha kǝmɗi Farta, kǝthlǝm ngǝta. <verse eid="ROM 15:30" /><verse number="31" style="v" sid="ROM 15:31" />Shiyama kǝthlǝm kǝ hǝraˈi heri fǝ kumi fǝr kit ǝ Yahudiya, paɗ kǝnau pafǝn tǝɗi nati fǝrta hahi Urshelima, kǝ chok kǝ ǝna thlǝta kǝmɗi fǝ fǝr kitcha ǝ hahiˈyan. <verse eid="ROM 15:31" /><verse number="32" style="v" sid="ROM 15:32" />Kǝthlǝm kǝɓi kǝmɗiyowun tǝ mbǝnfata, maa nggǝman Farta, kǝ yipi ǝ mǝɗˈyowun. <verse eid="ROM 15:32" /><verse number="33" style="v" sid="ROM 15:33" />Malan Farta thla thlǝ fǝrchǝ kǝɓikaɗi, kǝ chok tǝ wunchǝ nat. Kǝ chok kǝɗu.<verse eid="ROM 15:33" /></para>
  <chapter eid="ROM 15" />
  <chapter number="16" style="c" sid="ROM 16" />
  <para style="s">Nda ǝni Bulus kǝmɗi nafchi Roma</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1" />Nggǝt pǝnowun Fibi wanmanmǝn, thla thlǝ chich ter kǝtǝn shiita ǝ Kankiriya, ndat wa, kaa nef nakan. <verse eid="ROM 16:1" /><verse number="2" style="v" sid="ROM 16:2" />Thlamndi hur thlǝm chinmǝn, cham kǝɗu ǝ mbanɗi kǝmchǝsi, kǝɗ thla thlǝ chǝt fǝ para mbanchi Farta. Kǝsamandǝnsi chik tǝ yen mbenna thla yahtǝn, kǝthlǝm mǝthlan tǝ indiyan, chok kǝ kaa shiketǝ nafchǝ terchan, nat tǝ nggǝt paɗ. <verse eid="ROM 16:2" /><verse number="3" style="v" sid="ROM 16:3" />Ndaman ǝn Biriskila fa tǝ Akila paɗ nat ndǝ wa shikechǝ tarchinchi hur Kǝristi Yesu. <verse eid="ROM 16:3" /><verse number="4" style="v" sid="ROM 16:4" />Fǝrndǝ shishingǝn chiyanda nduk mǝrtǝ kaɗi, kǝthlǝm nggǝta, ngga nggǝt ichinna nech chan usoko kǝmɗiyandawa. Auwa, nat nafchiɗi thlǝ fǝrchǝ kit kǝmɗi Farta, fee nawakchǝ kǝ Yahudawecha fen paɗ naandǝ chan tandǝ usoko. <verse eid="ROM 16:4" /><verse number="5" style="v" sid="ROM 16:5" />Ndaman ǝn nafchǝfa fǝ parecha thlǝ ngomchǝha wirˈyanda. Ndaman ǝn Afanitus, shiketǝna thla nggakchǝ thlǝt Kǝristi ǝ hahi Asiya. <verse eid="ROM 16:5" /><verse number="6" style="v" sid="ROM 16:6" />Ndaman ǝn Maryamu fa, thla chich tǝr kaˈan kǝthlǝm kun. <verse eid="ROM 16:6" /><verse number="7" style="v" sid="ROM 16:7" />Ndaman ǝn Andaronikus tǝ Yuniya fee nech kǝ Yahudawecha kǝɗ nggǝta, fee paɗ kǝnandǝ fee tanda ǝ pursuna nat tǝ nggǝta. Sǝn fee tandǝ kaˈan pǝthlǝr taatǝ kǝmsicha, paɗ liindǝ thlǝt Yesu Kǝristi. <verse eid="ROM 16:7" /><verse number="8" style="v" sid="ROM 16:8" />Ndaman ǝn Amfilitus, shiketǝna thla thlǝ yahti hur Chinda. <verse eid="ROM 16:8" /><verse number="9" style="v" sid="ROM 16:9" />Ndaman ǝn Urbanus shiketǝ terˈyamǝn hur Kǝristi, tǝ shiketǝna Sitakis. <verse eid="ROM 16:9" /><verse number="10" style="v" sid="ROM 16:10" />Ndaman ǝn Afalis thla sǝndǝ fee ndi tǝ chan ter Kǝristi. Ndaman ǝn nafchǝɗi wiri Aristobus fa. <verse eid="ROM 16:10" /><verse number="11" style="v" sid="ROM 16:11" />Ndaman ǝn Hirudiyan fa wanmana thlǝ Yahudawata. Ndaman ǝn fee fǝrchǝ kit kǝmɗi Chinda, nafchǝɗi wiri Narkisas.<verse eid="ROM 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 16:12" />Ndaman ǝn Tǝrafina, tǝ Tǝrafusa, nǝssǝɗi fee chanchǝ ter Chinda kaˈan. Ndaman ǝn Barsisa shiketǝna thla yahti, nuɗi chanchǝ ter Chinda kaˈan. <verse eid="ROM 16:12" /><verse number="13" style="v" sid="ROM 16:13" />Ndaman ǝn Rufus fa thla sǝndǝ fee ndǝ hur teri Chinda. Paɗ ndaman ǝn mananfa thla tǝrchǝ nenchǝ kǝɗ waˈyan. <verse eid="ROM 16:13" /><verse number="14" style="v" sid="ROM 16:14" />Ndaman ǝn Askitus, tǝ Filigona, tǝ Hermes, tǝ Faturobas, tǝ Harmas, tǝ paɗ tǝ takǝt wanmancha fǝ fǝr kit tǝɗi nandǝ mǝt arta. <verse eid="ROM 16:14" /><verse number="15" style="v" sid="ROM 16:15" />Ndaman ǝn Filologus, tǝ Yuliya, tǝ Niriyus, tǝ wanmanan kǝ nunefa. Ndaman ǝn Olimfas, tǝ paɗ tǝ takǝt wanmancha fǝ fǝr kit tǝɗi nandǝ mǝt arta. <verse eid="ROM 16:15" /><verse number="16" style="v" sid="ROM 16:16" />Ndaman ǝn raˈanfa tǝ nggǝthl fatkafa yi mbǝnfata, tǝ chǝɗchǝɗ tǝ wanɗikaɗata. Nat fǝ parechǝ Kǝristi mǝɗiya, tandǝ paɗ tandǝ ndowun ǝn fa.<verse eid="ROM 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17" />Nggǝt shiyowunda wanmanchǝna, mbǝramsi tǝ fee nech chakowundǝha, kǝ ɗǝfndǝ wunchǝ kǝ che wansarta, kǝ ɓǝra chaˈaɗi thlǝtwun. Mbǝham langǝ tǝ weˈtǝ nafchiˈinni. <verse eid="ROM 16:17" /><verse number="18" style="v" sid="ROM 16:18" />Kǝthlǝm weˈtǝ nafchiˈinni ngga teri Kǝristi Chinmǝn thlǝ chǝt ndawa. Hwir ˈyandǝ dak thlǝ chaandǝ ndǝ tera. Tǝmɗi mbǝn meˈyanda thlǝ lǝmndǝ ndǝ fee nech tǝ paˈpaˈ tǝ incha. <verse eid="ROM 16:18" /><verse number="19" style="v" sid="ROM 16:19" />Kun paɗ, chika wuni tapi shiki saktǝ fǝr mandǝyowun kǝ ɓǝra ndiktǝ Kǝristi Yesu. Kǝthlǝm kǝt ndaˈan wanɗǝkaɗatinchi chǝɗchǝɗ kǝ ɗarwun. Nat tǝ kǝɗu, yahinchǝs kǝnowun ɗathlchan tǝ ǝnɗi nech ndiˈchan. Kǝ kǝmowunchǝ ǝn tǝ ǝnɗi nawakchǝ ndiˈchan wa. <verse eid="ROM 16:19" /><verse number="20" style="v" sid="ROM 16:20" />Farta thla thlǝ fǝrchǝ kǝɓikaɗi, nduk ha kǝ rǝɓantǝ Hweˈra, kǝ furowuntǝ alkǝta kǝ ɗaran.</para>
  <para style="p" vid="ROM 16:20">Kaakǝti Chinmǝn Yesu, kǝ choktǝ wunchi.<verse eid="ROM 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21" />Timoti shiketǝ terinchi, mǝthlan ndowun ǝnfa. Kǝɗu paɗ Lukiyas, tǝ Yason, tǝ paɗ Sosifata, wanmanchina, Yahudawecha.<verse eid="ROM 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 16:22" />Nggǝt, Tartiyus, thlǝ yara wan ɗelwer tǝɗa, nggǝt ndowun ǝnfa hur Chinda.<verse eid="ROM 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 16:23" />Gayus thla tǝrti kah wirˈyan, tǝ kwaan nafcha fǝ fǝr kit, fee thlǝ kǝmchǝ kyeuriyan tandǝ ndowun ǝn fa. Erastus thlǝ kǝs kopo i hahǝ har, tǝ Kwartus wanmanmǝn tandǝ ndowun ǝn fa.</para>
  <para style="p" vid="ROM 16:23">[<verse eid="ROM 16:23" /><verse number="24" style="v" sid="ROM 16:24" />Kaakǝti Yesu Kǝristi Chinmǝn, kǝ chok tǝ wunchǝ nat. Kǝ chok kǝɗu.]<verse eid="ROM 16:24" /></para>
  <para style="s">Nggǝlmii shiita tǝ usoko</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25" />Malaman kǝ fǝramǝn Farta, mǝthlan tǝɗi naa alkǝtˈyansi, kǝ ɗǝftǝ wunchi kǝ chok wun tǝ alkǝtfa, kǝ ɓǝra kwastǝ ndikta thla binchan kǝ ɗar Yesu Kǝristi, thla sǝktǝ wun mǝɗinchi. Ndiktǝɗi nech ǝ wubtǝ kaɗ choh choh. <verse eid="ROM 16:25" /><verse number="26" style="v" sid="ROM 16:26" />Nakanya paɗ chenfe kesh hayang, tǝmɗi yarechi fǝ shenuˈta tǝ yahti Farta. Tǝ mbaˈti Farta, thlǝ maanda mbaˈan kǝ fee kaɗi kǝmɗi hahi heshi nat, kǝthlǝm nat nafcha kǝ fǝrndǝ kit kǝ anchi paɗ kǝ mananda. <verse eid="ROM 16:26" /><verse number="27" style="v" sid="ROM 16:27" />Nakan maanda kǝmɗi Farta, mǝthlan ndak thlǝ ɗathla. Kǝ manan fee tǝmɗi Yesu Kǝristi, kǝ kweˈkǝchi. Kǝ chok kǝɗu.<verse eid="ROM 16:27" /></para>
  <chapter eid="ROM 16" />
</usx>