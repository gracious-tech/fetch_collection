<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EPH" style="id">- Gaˈanda</book>
  <para style="h">Afisa</para>
  <para style="toc1">Afisa</para>
  <para style="toc2">Afisa</para>
  <para style="toc3">Afi</para>
  <para style="mt1">Afisa</para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="s1">Nda ǝni Bulus kǝmɗi fǝ fǝr kitchiɗi nech ǝ Afisa</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />Ɗelwer tǝɗiya thlaˈtǝ mǝɗinchi Bulus, tatǝ kimsha i Yesu Kǝristi, tǝmɗi yahti Farta,</para>
  <para style="p" vid="EPH 1:1">kǝmɗi fee chiɗ chiɗ fee nech hur Afisa, fee nech tǝ kaafata hur para Yesu Kǝristi.<verse eid="EPH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 1:2" />Kaafata tǝ kaɓi kaɗi thlaˈtǝ mǝɗi Farta Chinmǝn tǝ Chinda Yesu Kǝristi kǝ chok tǝ wunchǝ.<verse eid="EPH 1:2" /></para>
  <para style="s1">Mbǝs ichǝ har yi shemeta hur Kǝristi</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />Chaman Farta usoko, mǝthlan tǝɗi nech kǝ Farta, tǝ chin Chinmǝn Yesu Kǝrǝsti. Thla ɗǝfaminchǝ chǝka yen mbǝs ichǝ har yi shemetǝɗi nech hulafǝrta, tǝmɗi Yesu Kǝristi. <verse eid="EPH 1:3" /><verse number="4" style="v" sid="EPH 1:4" />Kǝthlǝm tat tǝ minchi hur Kǝristi choh kwaɗǝn, kǝnan tǝn heshi, kǝthlǝm kǝ chokmǝn Chiɗ Chiɗ, paɗ fee nggowakchǝ kǝ ǝna ˈyarata ǝ pangngǝn nan. Kǝthlǝm yahtǝɗi yahtǝn minchi,<verse eid="EPH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 1:5" />tapi tahsan Fartǝ ha kǝ chok mǝn kǝ wanchiyan tǝmɗi Yesu Kǝrǝsti, tǝmɗi kaɗatˈyan yi kafata. <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" />Chichan kǝɗu kǝthlǝm kǝ maanamǝn kafatˈyan yi maandiyan thla fǝramǝn ndǝn herchaˈ tǝmɗi Waˈyan thla yahtǝn. <verse eid="EPH 1:6" /><verse number="7" style="v" sid="EPH 1:7" />Tǝmɗi mǝrti Kǝristi mbǝs tǝmǝn hǝraˈta, tǝ kalamǝn ɓǝɓifechiyamǝn ha. Chich Fartǝ ǝnɗa tǝmɗi maan kafatˈyan. <verse eid="EPH 1:7" /><verse number="8" style="v" sid="EPH 1:8" />Kaafaɗi fǝramǝn ndǝn thla nawaktǝ sǝrtaˈansi, ɓukwa tǝ sǝnda tǝ mbǝrtaˈan paɗ.<verse eid="EPH 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 1:9" />Ɗǝf Fartǝsi kǝ sǝn mǝn ǝnɗi kaɗatǝn thla choh sǝnwaktǝ nefa. Thla paɗ tahsandǝn ha kǝ ndiiɗ ha tǝmɗi Kǝristi. <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" />Kaɗatˈyan wa, maa ndiiɗ fartaˈan ha, kǝ wumanchǝ nat icha ǝ kan ɗukwa alkǝti Kǝrǝsti. Ndat wa nat ichiɗi nech hulafǝrta tǝ thla nech hur heshi.<verse eid="EPH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11" />Ə hur Kǝrǝsti paɗ, tatǝ Farta minchi kǝ mbǝsmǝn sǝm kǝrsǝ mǝrtiyan. Farta tapi tahsanchǝ ha kǝ chokmǝn kǝ nafchiyan hur Kǝristi. Mǝthlan tǝɗi thlǝ chich chǝka mii tǝmɗi kaɗatˈyan. <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />Kaɗati Farta, ndaˈan nech wa, nggǝmǝn tǝɗi nggakchǝ ɗǝf kǝfat kǝ Kǝrǝsti, kǝ chokmǝn kǝ fee nech maanandǝ kapakǝti Farta.<verse eid="EPH 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 1:13" />Tǝmɗi Kǝristi, kun paɗ sǝktǝwun kit tǝ ndikta, kwastǝ ndikta thla mbinchan yi hǝraˈtǝyowun. Kǝ fǝr kowun kit kǝ Kǝristi, ɗǝfowun kǝ fee wanɗǝsǝnda yi Shemeta Thla Chiɗ Chiɗ thla ɗǝf tǝ fee miyan, kǝ pǝn wa kun yaˈan. <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" />Shemeta Tha Chiɗ Chiɗ ndaˈan wathlamǝnchǝ ha ndat wa Farta nan fǝramǝn sǝm kǝrsǝ mǝrtǝɗi ɗǝftǝn miyan, thla nech choktǝ kǝ yimǝn fartǝɗi naa Farta hǝraˈandǝ fee nech kǝ yaˈan. Ənɗiya paɗ kǝthlǝm manandǝ kapakǝtˈyan.<verse eid="EPH 1:14" /></para>
  <para style="s1">Shiti Bulus kǝthlǝm nafchi Afisa</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />Kǝthlǝm ndaˈan, kǝthlǝm tapi sǝkichi mbanɗi fǝr tǝ wun kit kǝ Chinda Yesu, tǝ paɗ mbanɗi thlǝ natwun yah nafchi Farta, <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" />malawi chan Farta usoko kǝmthlǝm kun wa. Nat fartǝɗi nati shita thlǝ nechi kǝɗuktǝ tǝ wunchi. <verse eid="EPH 1:16" /><verse number="17" style="v" sid="EPH 1:17" />Ndat wa Farta yi Chinmǝn Yesu Kǝristi, Papa thlǝ maanda, kǝ fǝrowunchǝ Shemeta yi mbǝr ǝna tǝ sǝn ǝna kǝ sǝn wun ndi ndiˈchan. <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />Nggǝt shiti paɗ Farta kǝ ɗǝftǝ ɗaˈkǝtˈyan kǝ wanɗǝkaɗechˈyowun. Kǝthlǝm kǝ sǝn wun nech ɗǝf wanɗǝkaɗaɗi ˈyatǝn wunchǝ kǝ ɗaran. Paɗ kǝ sǝnwun maandi wurmaktiɗiyan yi mbǝs ǝn har thla nech kǝ fee nech chiɗ chiɗ, ndaˈan nech kǝ mbǝs ichi har. <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />Nggǝt shiti paɗ kǝ sǝnwun maandi Alkǝti Farta thla pǝɗanchǝ sǝndǝ ha, thla nech kǝ yimǝn nggǝmǝm tǝɗi fǝrchǝ kit. Alkǝɗi nech chǝt ter ǝ hurmǝn, artǝ tǝ Alkitɗi Alkǝɗɗi nech, <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" />chǝt ter hur Kǝrǝsti fartǝɗi thlaˈandǝ Farta hur mǝmatecha. Paɗ fǝrankan mǝt chokta thla nech manchan tǝ har harsǝm ˈyan ǝ hukafǝrta. <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" />Minni naa Kǝrǝsti chǝt kutǝraktiyan ɗar chǝka yen kurakta, tǝ alkǝta, tǝ thlaˈ kirsha. Thlǝman pǝɗantǝ thlǝmchiɗi ha nat thlǝ naa fee fǝrta, ngga hur heshiɗiya ndak wa, tǝ heshiɗi nech ɓat paɗ. <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" />Ɗǝfchǝ Farta ichi nat kǝ kan alkǝti Kǝristi. Paɗ ɗǝf kan ndi kǝ choka kǝ in chǝka mii hur nggomǝn fǝ fǝr kitcha. <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" />Thla nech kǝ fatˈyan. Hur nandǝ paɗ chok kǝ Kǝrǝsti kǝ ndiiɗan, thla ndiiɗanchǝ chǝka mǝ ha, chǝka tǝ yen mbenna.<verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="s1">Hǝraˈamǝnchǝ Farta tǝmɗi Kǝristi</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />Kun paɗ, choh nechowun kǝɗ mǝmatecha kǝthlǝm kumthlǝmatˈyowun tǝ ɓǝɓifechˈyowun. <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />Ə fartǝˈini thlǝ nechowun para mbanchi nafchi heshiɗiya. Nakowun para kutur ɓǝɓi hwaˈarcha ǝ fǝrta. Thla nech kǝ shemeɗi thlǝ nech chǝt ter hur wanɗǝkaɗati nafchǝɗi thlǝ nech chan kumthlǝmat Farta. <verse eid="EPH 2:2" /><verse number="3" style="v" sid="EPH 2:3" />Natmǝn chokmǝn kǝɗ tandǝ choh. Nakamǝn chǝt ǝnɗi yahtǝ fatˈyamǝn ndak paɗ tǝ ǝnɗi yahtǝ wanɗǝkaɗechˈyamǝn. Kǝmchansi kǝ ɓǝ sǝɓtǝ hwiri Farta kǝ ɗar indiyamǝn kǝɗ tanda.<verse eid="EPH 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 2:4" />Paɗaa nakan Farta thlǝ haɗandǝ nef fǝ manchan, yahkan mǝnchǝ kaan, <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />fǝraˈkan shinshingnda tǝ Kǝristi. Chǝka mǝ nakan wa mǝmatechǝ nakamǝn tǝmɗi ɓǝɓifechˈyamǝn. Hǝraˈamǝnchi fee tǝmɗi kaafatˈyan. <verse eid="EPH 2:5" /><verse number="6" style="v" sid="EPH 2:6" />Kǝthlǝm thlaˈa minchan hur mǝmatecha tǝ Kǝristi. Dǝfkan minchi kǝ chok mǝn kǝ chǝmǝn kuturakta kǝ ɗar shemechi heshi ɓukwaˈ tǝ Kǝristi Yesu. <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />Chich Fartǝ ǝnɗa kǝthlǝm kǝ chokmǝn arta tǝ Kǝristi. Chichan ǝnɗa kǝthlǝm kǝ pangnga, kǝ pǝnamǝnchǝ kaafatˈyan thla nawaktǝ sǝrtaˈansi tǝmɗi Kǝristi Yesu. <verse eid="EPH 2:7" /><verse number="8" style="v" sid="EPH 2:8" />Kǝthlǝm tǝmɗi kafati Farta mbǝstǝwun hǝraˈta, tǝmɗi fǝr kit. Ənɗiya paɗ ngga chǝt ˈyowun wa, pafǝn mǝɗi Farta. <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />Paɗ ngga tǝmɗi tarcha wa, kǝthlǝm kǝ thlaˈan yowun kirsha wa. <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />Nggǝmǝn tǝ indiyamǝn tar harchiyan. Nggǝrchǝ fee tǝn mǝnchǝ ǝ hur Kǝristi Yesu. Kapaɗan kǝthlǝm kǝ chǝmǝn tarchǝɗi nech ndiˈchan. Thla tahsandǝ Fartǝ ha tǝrkwathl kanan kǝ chǝmǝn.<verse eid="EPH 2:10" /></para>
  <para style="s1">Wuman Farta indi natchǝ nat tǝmɗi Yesu</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />Kǝthlǝm ndaˈan, kuɗukama choh ngga Yahudawech nakowun wa tǝmɗi nggǝtta. Kun tǝɗi thlǝ ˈya Yahudawecha wa, “Hechowowun wu fee wa.” Nakanya, heche ini yi fata, thla thlǝ chǝt fee tǝ hera. <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />Kuɗu kama, fartǝˈini ǝnsǝ wumowunchǝ ha tǝ Kǝrǝsti wa. Paɗ nggikkektǝyowunsi tǝ nafchi Israˈila wa, paɗ ramchǝ nakowun kǝ ɗǝf miɗi chǝt Farta. Chok chowun hur heshiɗiya ɗǝf wandǝkaɗatˈyowun su wa, paɗ Fartiyowun su wa. <verse eid="EPH 2:12" /><verse number="13" style="v" sid="EPH 2:13" />Paɗaa nakanya nggun hur Kǝrǝsti Yesu. Kuntǝɗi choh nech langngan tǝ Farta, nakanya ɓi fee tǝ wunchǝ nduk tǝ ndi tǝmɗi mǝrti Kǝrǝsti.<verse eid="EPH 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 2:14" />Kǝthlǝm Kǝristi mǝthlan ɗǝfchǝsi kǝ chokmǝn hur kǝɓikaɗi, mǝthlan tǝɗi nggǝranchǝ Yahudawecha tǝ fee nawakchǝ kǝ Yahudawecha kaɗ arta. Paɗ tokan kan thlartǝɗi chakan chǝ tandǝ ha tǝmɗi fatˈyan, ndat wa karraˈan tǝɗi nech pǝthlǝrwun. <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" />Chichan ǝnɗa tǝmɗi tǝrandǝ kusiˈ i Musa kaɗi tǝ ɓuˈchiyan paɗ tǝ ndikchiyan tǝmɗi fǝr fatˈyan. Chichan kǝɗu kǝthlǝm kǝ tǝntǝ yuwa kwathla thlaˈtǝ ǝ kwathlchiɗi chap ya. Tǝ kǝɗu paɗ ɓatǝn tǝ kǝɓi kaɗi pǝthlǝr nanda. <verse eid="EPH 2:15" /><verse number="16" style="v" sid="EPH 2:16" />Tǝmɗi mǝrtǝɗiˈyan ɗar palangndiya Kǝristi ɓenganchǝ karraˈan tǝɗi kaɗ nech pǝthlǝr mǝn tǝ raˈan. Paɗ tahsankan pǝthlǝr nafchǝɗi kaɗ chap ya tǝ Farta. Tǝ kǝɗu ɓengankan karraˈan tǝɗi chakanchǝ tandǝ ha choh.<verse eid="EPH 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 2:17" />Ɓakan ɓasowun kǝɓikaɗi, kǝmɗi kun tǝɗi nech langngǝ tǝ Farta tǝ fee nech nduk tǝ ndǝ paɗ. <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />Kǝthlǝm tǝmɗiyan natmǝn chap namǝn mbahan ɗǝt kǝmɗi Farta tǝ mbandǝ arta. Ndat wa Shemeti Farta.<verse eid="EPH 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19" />Kǝthlǝm ndaˈan, nakanya kun tǝɗi nawakchǝ kǝ Yahudawecha ngga ramchǝ nakowun paɗ wa. Paɗaa wanchǝ haha ɓukwa tǝ nafchi Farta. Wanchǝ wurchǝyan, kǝɗ ǝnɗi naa takǝɗ nafchi wirˈyan. <verse eid="EPH 2:19" /><verse number="20" style="v" sid="EPH 2:20" />Tǝnowunchǝ fee nat ɗar chǝma tǝnɗi ɗǝf tǝ taatǝ kǝmsicha tǝ fǝ shenuˈchǝ tǝ yahti Farta. Kǝrǝsti Yesu tǝ indiyan mǝthlan nech kǝ ɗakwanɗi kǝschǝ tǝnan har. <verse eid="EPH 2:20" /><verse number="21" style="v" sid="EPH 2:21" />Tǝmɗiyan naa tǝnan nat kǝ wumnan, ɗǝf kǝ fee ndǝsi kǝ maana kǝ Wiri Farta tǝmɗi Chinda Yesu Kǝristi. <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />Ə hwirˈyan paɗ tǝnowun ndǝ fee tǝ takichaˈan, kǝthlǝm kǝ chokwun kǝ wira mǝɗi thlǝ choktǝ Farta tǝmɗi Shemetˈyan.<verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="s1">Tarchi Bulus kǝthlǝm fee nawakchǝ kǝ Yahudawecha</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />Kǝthlǝm ndaˈan, nggǝt Bulus, chokin chi kǝ wan pursuna i Kǝrǝsti Yesu kǝthlǝm kun fee nawakchǝ kǝ Yahudawecha. <verse eid="EPH 3:1" /><verse number="2" style="v" sid="EPH 3:2" />Fǝrinchǝ kit su wa sǝkwun kusheˈtǝ mbǝr ǝnaɗi fǝri tǝ Farta, kǝthlǝm tar kaafata kǝthlǝm kun. <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />Ndat wa tǝmɗi ǝn kǝɗ hur sǝnaˈta mbuˈichǝ Farta wuɓtǝ kaɗatˈyan. Kǝɗ ǝnɗi tapati kǝ yari chawat. <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" />Maa chan nggawun ǝnɗa, nowun mbahǝn sǝn hwengngǝkǝt ǝnɗi sǝndi kǝ ɗar ichiɗi nech ǝ wuɓta i Kǝrǝsti. <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />Mbuˈwu fee ǝnɗi nech ǝ wuɓtǝ ya kǝmɗi nafchi heshiɗi choh wa. Paɗaa ǝ nakanya pǝn fee hayang tǝmɗi Shemeta Thla Chiɗ Chiɗ kǝmɗi taatǝ kǝmsichi Kǝristi tǝ fǝ shenuˈchǝ tǝ yahti Farta. <verse eid="EPH 3:5" /><verse number="6" style="v" sid="EPH 3:6" />Wuɓtǝ ǝnɗiya ndaˈan nech kǝ, tǝmɗi kusheˈtǝ ndikta thla mbinchan yi Kǝristi Yesu, ndat wa fee nawakchǝ kǝ Yahudawecha kǝ chok ndǝ kǝ fee nech sǝm kǝrsǝ mǝrta ɓukwaˈ Yahudawecha. Fen tǝ nggǝmǝn nat chokkamǝn kǝɗ tanggathlechǝ fat arta. Kǝ chok mǝn kǝ shikechǝ choktǝ paɗ, kǝ ɗǝfmichiɗiya ǝ hur Kǝrǝsti Yesu.<verse eid="EPH 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7" />Chokin chǝ kǝ maafati kusheˈtǝ kwastǝ ndiktǝɗiya, tǝmɗi pafǝn i kaafati Farta thla fǝri tǝ fee, tǝmɗi alkǝtɗiˈyan nech chǝt ter tǝ nenchi.<verse eid="EPH 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EPH 3:8" />Chǝka mǝ nakan wa nggǝt nech ngguɗyeh kaan hur nafchi Chinda. Nggǝt fǝraˈndǝ fee kaafaɗiya kǝ ɓasi kusheˈtǝ kwastǝ ndikta, kǝmɗi fee nawakchǝ kǝ Yahudawecha. Kusheˈtǝɗi pǝɗanchǝ alkǝt sǝndi nef ha. <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />Paɗ kǝthlǝm kǝ mbuˈani nafchǝ nat wuɓtu ǝnɗi tahsandǝ Fartǝ ha. Wuɓtǝ ǝnɗiya, Farta thla tǝnchǝ chǝkamǝ nat wuɓan kan mǝni nafcha hurata kǝ hurecha.<verse eid="EPH 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 3:10" />Kaɗatˈyan ndaˈan nech kǝ nakanya tǝmɗi nafcha fǝ fǝr kitcha, kǝ mbuˈ fee mbǝr ǝni Farta samǝn samǝn, kǝmɗi fǝ chǝt kuturakta tǝ alkicha ǝ fǝrta. <verse eid="EPH 3:10" /><verse number="11" style="v" sid="EPH 3:11" />Thla nech kǝ tahastǝyan fa thla kǝ poreˈ, paɗ thla thlǝnandǝ fee kaɗ tǝmɗi Kǝrǝsti Yesu Chinmǝn.<verse eid="EPH 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EPH 3:12" />Ə hwirˈyan, paɗ tǝmɗi fǝr kit kǝmɗiyan natmǝn tǝ alkǝt ɗǝt nduk tǝ Farta, lekǝt su wa. <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />Kǝthlǝm ndaˈan, mǝ yiraˈwun fa hur fǝr kit kǝthlǝm ǝnɗi naa fee chitǝ mǝɗya wa. Kǝthlǝm kun nati saa ɓahchiɗiya. Ɓahtǝɗinchiya nan chokowun ɗǝf kǝ ǝnɗi naa fee maanowun nda.<verse eid="EPH 3:13" /></para>
  <para style="s">Shiti Bulus kǝthlǝm fǝ fǝr kitchiɗi ǝ Afisa</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />Kǝthlǝm ndaˈan, chaminchi kuruminchǝ ha ǝ pangngǝn Chinda Farta, <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />thla fǝranchǝ chǝka yen wira thlǝma, ǝ hulafǝrta tǝ hur heshi. <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />Shiyani Farta thlaˈtǝ hur wurmaktǝ maandiyan kǝ ɗǝksowun chǝ tǝ alkǝtˈyan. Kǝthlǝm kǝ chokwun tǝ alkǝt fa hur wanɗǝkaɗechˈyowun tǝmɗi Shemetˈyan. <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />Kǝthlǝm Kǝristi kǝ chok ha hur wanɗǝkaɗechˈyowun tǝmɗi fǝr kit. Nggǝt shitǝ paɗ yahraˈan kǝ pǝha tǝ thlaarchǝyan kaan ǝ hur wanɗǝkaɗechˈyowun. <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />Kǝthlǝm kǝ mbǝswun alkǝt sǝn ǝna, ɓukwaˈ tǝ nafchi Fartǝ nat. Kǝ wathlowunchǝ hǝthl mbǝrkǝta, tǝ njang kǝta, tǝ maanda, tǝ hwengkǝti yahraˈan i Kǝristi. <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />Paɗ kǝ sǝn wun yahraˈan tǝɗi nessi Kǝristi kǝthlǝm nggǝmǝn thla pǝɗanchǝ sǝndi nef ha. Kǝthlǝm natˈyowun ha kǝ chok kǝɗ yi Farta.<verse eid="EPH 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20" />Malaman maanda kǝ chok kǝ yi Fartǝyamǝn thla tǝmɗi alkǝtˈyan ǝ hur mǝn. Mǝthlan chǝt tera paɗ mǝthlan thlǝnandǝ ichǝɗi kaɗ pǝɗanchǝ thla ha nat natmǝn shita, ndu ǝnɗi natmǝn kaɗata. <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />Maanda kǝmɗiyan kǝ chok hur nafchi fǝ fǝr kitcha tǝ paɗ hur Kǝristi Yesu. Thlaˈtǝ heshiɗiya, taˈkǝ yuwa heshichiɗi nech ɓat nat, kǝ kweˈkǝɗan. Kǝchok kǝɗu.<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="s1">Choktǝ Arta</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />Kǝthlǝm ndaˈan, nggǝta, pursuna kǝthlǝm para Chinda, ni shiyowunda kǝ chokkam tǝmɗi ˈyaɗi ˈyat fee wunchi, kǝthlǝm Farta ˈyech wunchi. <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" />Chika kwati kǝ nowun kǝmma tǝ hashaskǝta. Kǝ nowun tǝ kǝrǝs raˈan, nakowun nggǝmandǝ raˈan kǝ ɗar kafaɗi nechsi yowun. <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />Kweˈyam ha kǝ nowun tǝ wum inda hur Shemeta, kǝnankowun fechˈyowun hur kǝɓikaɗi. <verse eid="EPH 4:3" /><verse number="4" style="v" sid="EPH 4:4" />Kǝthlǝm faɗan arta tǝ Shemet artǝ paɗ, kǝɗ thla ˈyech fee wunchi kǝ hur kappa maanda tǝ ɗǝf kǝfatsi kǝ ichiɗi nech ɓata ǝ pangga. <verse eid="EPH 4:4" /><verse number="5" style="v" sid="EPH 4:5" />Chinda arta, tǝ fǝrkit arta, tǝ baptisma artǝ paɗ, <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />mǝthlan neck ɗar chikamǝ nat hur mǝ nat paɗ nakan ha hur nat paɗ.<verse eid="EPH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7" />Chika kǝɗu, fǝran tǝ chika wuni mbǝr ǝna tǝmɗi kafati Kǝrǝsti. <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" />Ndaˈan mbutǝ Lawlawaɗan wa,</para>
  <para style="b" vid="EPH 4:8" />
  <para style="q1" vid="EPH 4:8">“Fartǝɗi pǝɗatǝn kafǝrta,</para>
  <para style="q2" vid="EPH 4:8">tǝrtǝ fee kǝssandǝn tanda<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="fk">fee kǝssandǝn:</char> Nan nat ngga nefchǝ ndak wa ta shemecha.</note> tǝ anchi,</para>
  <para style="q1" vid="EPH 4:8">fǝrankan wanchi Adamu mbǝr ichǝ samǝn samǝn.”<note caller="*" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="PSA 68:18">Zab 68:18</ref></char></note><verse eid="EPH 4:8" /></para>
  <para style="b" />
  <para style="m">
    <verse number="9" style="v" sid="EPH 4:9" />Mǝ nech kǝ “tir kafǝrta.” Ə pinwa Kǝrǝsti ɗǝ kah kǝ ndukwa kan haha. <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />Thla saˈchǝ kaha mǝthlan paɗ pǝɗech kafǝrta pǝɗankan hulafǝrtǝ ha, kǝthlǝm kǝ ndiiɗan tǝ hulafǝrta tǝ heshi nat ǝ indiyan.<verse eid="EPH 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 4:11" />Nakanya mbǝr ichiɗiya fǝrtǝ Kǝrǝsti kǝmɗi nafchiyan: ndǝ kǝmsicha, fǝ mbancha, fǝ ɓascha, tǝ mbuˈ ndiktiyan, fǝ chaˈandǝ nafchi kaɗi. <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />Tarchiyandǝ kǝ thsandǝ nafchi Farta kǝ chit ndǝ tarchiyan kǝ paɗ tǝnandǝ fati Kǝrǝsti. <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />Nan ɗǝt kǝ pangga tarɗiya kǝ fartǝɗi natmǝn choktǝ kǝ nafchi arta hur Chinda, kǝ chokmǝn paɗ hur sǝn Wa ˈi Farta. Namǝn choktǝ kǝ ndiiɗ ti nafcha kǝ saˈmǝn kǝ mǝɗi yahtǝ Farta hur Kǝrǝsti.<verse eid="EPH 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 4:14" />Chich fee kǝɗu kǝthlǝm kǝ chokmǝn tǝ ǝna chiti wancha wa, ndu kǝ chokmǝn kǝɗ fee naa taraktǝs tǝ hur inchiyanda, kǝn fee shipa mǝn nda kǝ renna tǝ chaˈaɗanˈyanda nakandǝ terandǝ hur inchiyamǝn, nafchiɗi nech tǝ hwanaˈata nakandǝ lǝmminchi tǝ ɗathla mǝn nda. <verse eid="EPH 4:14" /><verse number="15" style="v" sid="EPH 4:15" />Tǝ kǝɗu mbuˈankamǝn raˈan kittaˈan hur kafata, nakamǝn maanda hur tarchiyamǝn nat kǝ saˈamǝn weˈtǝ chiti Kǝrǝsti thl nech kǝ indi nafchi nat. <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" />Kǝthlǝm mǝthlan nech parat tǝ nat ɓǝtǝl tǝ fata nat kǝnandǝ chit ter ndiˈchan. Chika yeni mǝthlan thlǝnandǝ terˈyan, nakandǝ kǝssandǝ raˈan kǝ nandǝ maanda, thla ɗǝfchǝ faɗan nat kǝn has has tǝ maanda hur ndiiɗ ti kafata.<verse eid="EPH 4:16" /></para>
  <para style="s1">Chokta Kǝɗ Wachi Ɗaˈkǝta</para>
  <para style="m">
    <verse number="17" style="v" sid="EPH 4:17" />Nggǝt mbuˈowunda tǝ alkǝti Chinda: Kǝ chokwun kǝɗ Pong nafchi paɗ wa, kǝthlǝm tapi chohiˈ hur inchiyandǝ kaɗi. <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />Ndiiɗ kǝ wandǝkaɗechˈyandǝ kaɗi tǝ wuthla; pǝɗi ndǝ langga tǝ Farta thla thlǝ fǝrchǝ shishingnda kǝthlǝm wandǝkaɗechˈyanda kwaˈkwa paɗ chi wandǝ ǝn ɗi yahtǝn wa. <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />Haraw fat tanda wa. Ɗǝf kandǝ inchiyanda kǝ fǝlawkǝta, nakandǝ chit chika yen tǝkǝmǝn icha.<verse eid="EPH 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20" />Ngga ndaˈan chaˈat wun mǝɗi Kǝrǝsti wa. <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />Kǝfartǝɗi sǝktǝwun ndikta kǝ indi Yesu paɗ sǝkkowun kittaˈan thla ɓech mǝɗiyan. <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" />Ənɗi chaˈowundǝfee har ndat wa, mǝkaman ɗohtǝ ǝna chitˈyowun kaɗi paɗ kǝ parowun chit fata wa ndu lǝmndǝ paɗ wa.<note caller="*" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="COL 3:9">Kol 3:9</ref></char></note> <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />Tǝ kǝɗu, malaman Shemeti Farta kǝn parata tǝ wunchi tǝmɗi mbǝɗa ndǝ kaɗechˈyowun ha tǝ ǝna chitˈyowun. <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" />Mǝkkowun yuwa chita, thla nech kǝ yi thla tahǝs tǝ Farta, thla nech ɗǝt tǝ wunchǝ kǝ kaakǝta tǝ chiɗ chiɗ kǝta.<verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />Malaman mbuˈ lekta. Nakamǝn mbuˈandǝ raˈan kittaˈan, kǝthlǝm natmǝn nechamǝn kǝ ɓǝtǝl tǝ fati raˈan nat.<note caller="*" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="ZEC 8:16">Zak 8:16</ref></char></note> <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />Ma ǝ sǝɓanwun hwirkaɗi, kǝ malawun kǝ ɗǝ tǝ wunchi kǝ chit ɓǝɓifata wa. Kǝ malawun sǝɓtǝ hwirˈyowun kǝ ndǝrǝm kǝ hǝm farta.<note caller="*" style="x"><char style="xo" closed="false">4:26 </char><char style="xt" closed="false"><ref loc="PSA 4:4">Zab 4:4</ref></char></note> <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />Kǝ fǝrawun Hweˈrǝ mbanda wa. <verse eid="EPH 4:27" /><verse number="28" style="v" sid="EPH 4:28" />Thla thlǝ yarkǝchǝ choh kǝ malanchi. Tǝ kǝɗu chikan tertǝ harchiyan yi kit thla natǝn mbahǝn mbǝs ichi har tǝ paɗ kǝssantǝ fowun si fee nawaktǝnˈyandǝ si. <verse eid="EPH 4:28" /><verse number="29" style="v" sid="EPH 4:29" />Kǝ nggǝrwun mbuˈan nef ɓawa mee wa, ndiktǝɗi nech mbahǝn kǝssandǝ nafchis ndak nat wun mbuˈta. Tǝ minni naa ndiktiyowun choktǝ kǝ ǝna kǝssandǝ fee nech sǝkwunchi.<verse eid="EPH 4:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EPH 4:30" />Parakowun har ndiˈchan kǝthlǝm kǝ sǝɓawun hwiri Shemeti Farta kaɗ wa, kǝthlǝm nechan klu saktǝ thlǝ chektaˈan i Farta indiyowun thla natǝn pǝnda ǝ Ndukwa heshi tǝ ndat wa kun yaˈan. <verse eid="EPH 4:30" /><verse number="31" style="v" sid="EPH 4:31" />Chakan ha tǝ sǝɓtǝ hwira, tǝ nduhul ɓǝstǝ hwira, tǝ kǝnandǝ chimanda, tǝ yaka ˈyara fata, tǝ tǝhuɓta, tǝ chika weˈtǝ yen ɓǝɓifata. <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" />Cham thlǝrɗakta tǝ raˈan, nakowun haɗa ndǝ raˈan fa, kǝnowun kalandǝ raˈan ha kǝɗ thla thlǝ kalowundǝ Fartǝ ha tǝmɗi Kǝrǝsti.<note caller="*" style="x"><char style="xo" closed="false">4:32 </char><char style="xt" closed="false"><ref loc="COL 3:13">Kol 3:13</ref></char></note><verse eid="EPH 4:32" /></para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="s1">Chokta Hur Ɗaˈkǝta</para>
  <para style="m">
    <verse number="1" style="v" sid="EPH 5:1" />Tapi chokwun kǝ wanchi Farta thla yahtǝn, tǝram saktaˈan mǝɗiyan hur choktǝ yowun. <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" />Chokam tǝ thlǝrɗakta kǝɗ thla naa Kǝrǝsti chaminda, fǝrkan indiyan kǝ kǝnaw pafǝn thla chokchǝ kǝ ǝna tithla thla nech mbinchan kǝmɗi Farta.<note caller="*" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="EXO 29:18">Fit 29:18</ref>; <ref loc="PSA 40:6">Zab 40:6</ref></char></note><verse eid="EPH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3" />Kǝ tamfe sǝk fǝlawkǝta hur wun wa ndu tǝkǝmnda wa, ndu yah ichǝ hur wun wa kǝmwasi kǝn pathlang nafchi Farta wa. <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />Chika ɓǝɓi ndikcha, tǝ ndikta wuwwa, tǝ ndikta kǝ sǝɓtaˈan kǝmwa sǝ kǝn hur wun wa. Tǝ kǝɗu, chokam kǝ nafchiɗi thlǝ chich usoko kǝmɗi Farta. <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />Kǝsǝn wu suwa nggǝ fǝlaw ndu fǝlawcha, ndu fǝ yah icha (ndu fǝ para ɗǝhacha wa), nggǝ chaktiyandǝs hur kutarakti Farta chika nguɗeh wa.<verse eid="EPH 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 5:6" />Mǝ lǝmyowun wunchi tǝ ndiktǝ samǝn samǝn wa. Kǝthlǝm ndaˈan fǝ ndikchiɗiya thlǝ naa sǝɓtǝ hwiri Farta ɓak kah kǝ inchiyanda fee karchǝ sǝk anchi. <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />Kǝthlǝm ndaˈan kǝ wumawun indǝ tǝ tanda wa.<verse eid="EPH 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EPH 5:8" />Kǝthlǝm choh kun choktǝ hur wuthla nakanya nechowun kǝ yi Chinda thla nech kǝ ɗaˈkǝta. Kǝthlǝm ndaˈan chokam kǝ nafchi ɗaˈkǝta. <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />Kǝthlǝm ɗaˈkǝtɗi nech hur wun ya thlǝ ɓechan tǝ kaa icha tǝ thla nech ndiˈchan tǝ kit paɗ.<verse eid="EPH 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 5:10" />Kǝ sǝnwunsǝ paɗ wa ichiɗi natwun chita ǝna thla nech mbǝnandǝ Chindǝ si. <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />Chakan ha tǝ sǝɓtǝ tarcha yi wuthla thla naa nafchǝ chita, tǝ kǝɗu nakowun koh tandǝ tandǝ kesh. <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />Kǝthlǝm ǝna hartǝ fata ma fee sǝkta kun ndikta kǝ ɗar ichiɗi naa ɓǝɓi nafcha chita ǝ wuɓta. <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />Na ichiɗi thlǝ chit nda ɓat kesh ma ɓi ɗaˈkǝta kǝ indiyanda kǝ paɗ sǝn fee ndu weˈtǝ nafchi mǝ nakanda. <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />Kǝthlǝm ndaˈan nda fee wa,</para>
  <para style="b" vid="EPH 5:14" />
  <para style="q1" vid="EPH 5:14">“Thlaˈu chiɗi nech saˈyena.</para>
  <para style="q2" vid="EPH 5:14">Thlaˈu hur mǝmatecha.</para>
  <para style="q2" vid="EPH 5:14">Na Kǝrǝsti finuta.”<verse eid="EPH 5:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />Kǝthlǝm ndaˈan param har ndiˈchan tǝ wiˈtiyowun. Kǝ chokwun kǝɗ ɓamcha wa, chokam kǝɗ fee sǝnchǝ ǝna. <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" />Nakowun chit ter tǝ mbanchiɗi natwun mbǝsta kǝ chiwun kaakǝta, kǝthlǝm wanminchaˈan sǝɓchaˈan.<note caller="*" style="x"><char style="xo" closed="false">5:16 </char><char style="xt" closed="false"><ref loc="COL 4:5">Kol 4:5</ref></char></note> <verse eid="EPH 5:16" /><verse number="17" style="v" sid="EPH 5:17" />Kǝ chokwun kǝɗ ɓamcha wa, tǝ kǝɗu kweˈyam ha kǝ sǝnwun mǝ nech kǝ ǝnɗi yahtǝ Farta. <verse eid="EPH 5:17" /><verse number="18" style="v" sid="EPH 5:18" />Mǝ nggalwun tǝ mbala wa, thla nech ɗǝfwunchi kǝ sǝɓtǝkaɗi. Kwech chan, kǝ ndiiɗ wun kaɗ tǝ Shemeti Farta, <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" />nakowun ndiktǝ tǝ raˈan tǝ ndikti Zabura ta in ˈyamǝs sa kǝmɗi Chinda tǝ nat wandǝkaɗechˈyowun. <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />Chika yen parta kǝ chawun Farta usoko tǝ thlǝm Chinmǝn Yesu Kǝrǝsti kǝ ɗar ichi nat.<note caller="*" style="x"><char style="xo" closed="false">5:19-20 </char><char style="xt" closed="false"><ref loc="COL 3:16-17">Kol 3:16-17</ref></char></note> <verse eid="EPH 5:20" /><verse number="21" style="v" sid="EPH 5:21" />Kǝ pangga, fǝram inchiyowun raˈan tǝmɗi tǝ maandǝ Kǝristi.<verse eid="EPH 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22" />Nǝssa, fǝraman ichiyowun kǝ hǝssiyowun kǝɗ kǝmɗi Farta.<note caller="*" style="x"><char style="xo" closed="false">5:22 </char><char style="xt" closed="false"><ref loc="COL 3:18">Kol 3:18</ref>; <ref loc="1PE 3:1">1 Bit 3:1</ref></char></note> <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />Kǝthlǝm hǝssa fen nech kǝ indi nǝssiyanda kǝɗ thla naa Kǝristi kǝ indi fǝ parandi. Mǝthlan nech kǝ thlǝ hǝraˈandǝ tanda, fee nech kǝ yaˈan. <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />Fe thlǝ nech parandi yu thlǝ fǝrchandǝ inchiyanda kǝmɗi Kǝristi, nggǝwun nǝssi paɗ fǝram inchiyowun kǝmɗi hǝssǝyowun hur chika mǝ nat. <verse eid="EPH 5:24" /><verse number="25" style="v" sid="EPH 5:25" />Hǝssǝ paɗ yaham nǝssiyowun, kǝɗ thla yahtǝ Kǝristi fee nech parandi. Fǝrtǝn shishingndiyan kǝmthlǝm tanda, <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />kǝ chapanchi kaɗi tǝ chiɗchiɗ kǝta, chaptǝ kaɗ tǝmɗi ndikti Farta. <verse eid="EPH 5:26" /><verse number="27" style="v" sid="EPH 5:27" />Chichan kǝɗu kǝthlǝm kǝ fǝrtǝ anchi kǝmɗiyan kǝ ɗar kwastǝ ikkilisiya thla nggowakchǝ tǝ ǝnfa ndu sǝɓtǝfa. Tǝ kǝɗu nechan nat chiɗ chiɗ ngga tǝ ɓǝɓi anwa. <verse eid="EPH 5:27" /><verse number="28" style="v" sid="EPH 5:28" />Tǝ mben ini paɗ, kǝmchis kǝ yah hǝssǝ nǝssiyanda kǝ fechˈyanda. Kǝthlǝm nafɗi yahchi nuwan indiyan yahtǝn. <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />Nefsi nech kar fatˈyan wa tǝ kǝɗu thlǝ nech sǝmandǝ ǝna tǝ parat tǝ indiyan ndiˈchan, kǝɗ thla thlǝ chit Kǝristi kǝ ikkilisiya. <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />Necha mǝn kǝ nafchiyan.<verse eid="EPH 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EPH 5:31" />Kǝɗ thla mbuˈtǝ Lawlawaɗan tǝ ndat wa,</para>
  <para style="q1" vid="EPH 5:31">“Na nef mal chinan tǝ manan kǝ chok ndǝ artǝ tǝ nuwan,</para>
  <para style="q1" vid="EPH 5:31">chapnda nandǝ nat kǝ fat arta.”<note caller="*" style="x"><char style="xo" closed="false">5:31 </char><char style="xt" closed="false"><ref loc="GEN 2:24">Far 2:24</ref></char></note><verse eid="EPH 5:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="EPH 5:32" />Thlǝya nech kǝ ǝna sakainda, tǝ kǝɗu thla paɗ nech kǝ saktaˈan kǝ ɗar Kǝristi tǝ fee nech para anchi ǝn arta. <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />Nggǝt chekowundǝs paɗ, chikawun nefa kǝ yahtǝ nuwan kǝɗ indiyan, nussi paɗ kǝ fǝrndǝ maandǝ kǝmɗi hǝssiyanda.<verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="s1">Chokti Parcha tǝ Wanchiyanda</para>
  <para style="m">
    <verse number="1" style="v" sid="EPH 6:1" />Wancha, cham thlǝrɗaktǝ tǝ parchiwun kǝthlǝm nechowun kǝ yi Chinda, paɗ ndaˈan nech kǝ ǝnɗi nech ndiˈchan kǝ chiwun. <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" />Kussiˈ yi tǝrkwathl kanan wumandǝ fee ha tǝ ɗǝfmee ndaˈan nech kǝ:</para>
  <para style="q1" vid="EPH 6:2">“Fǝram maandǝ chu tǝ mu,<verse eid="EPH 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="EPH 6:3" />maˈ maanawun chinchiwun tǝ manchiwun, “Nat ichiɗi natwun chita nan wiˈtǝ keˈke kǝmɗiyowun, paɗ nowun nat ha kǝ hurechǝ kaan hur.”<verse eid="EPH 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 6:4" />Chincha, kǝ sǝɓawun hurchi wanchiyowun kaɗwa tǝ mbanɗi thlǝ paratwun tǝ tanda. Tǝ kǝɗu, param tǝ tandǝ tǝ chaˈandat har tǝ para kussiˈ thla ɓech mǝɗi Farta.<verse eid="EPH 6:4" /></para>
  <para style="s1">Mafecha Tǝ Fǝ Wurchiyanda</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />Kun mafecha, cham thlǝrɗakta tǝ fǝ wurchiyowun fee nech hur heshiɗiya. Kǝ pǝnawun fǝr maanda tanda, nakowun para tanda hur chika mǝ nat, tǝ hwir arta paɗ, kǝɗ tǝ nowun chit teri Kǝrǝsti. <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />Kǝ chiwun ter kǝthlǝm fee ɗǝpowun nda wa, kǝɗ fee nech kaa chimndǝ nafcha wa, tǝ kǝɗu nakan wa kun mafechi Kǝrǝsti, cham ǝn ɗi yahtǝ Farta tǝ hwir arta. <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />Cham tarchiyowun tǝ kafata tǝ kaɗat ndiˈchan, kǝɗ tǝnowun chandǝ Chinda ngga kǝmɗi nafcha wa. <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />Kǝ sǝn wunsǝ paɗ wa, nat kaakǝt ɗi chit nefa, ndu nechan kǝ mafata ndu wan hwira, Chinda ndak nech tiyanda.<verse eid="EPH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9" />Kun fǝ wurcha, kun paɗ chaman mafechiyowun kǝɗu. Kǝ malawun kwara nda ta. Kǝ sǝnwunsǝ paɗ wa kun tǝ tanda Chin wun arta hulafǝrta, mǝthlan paɗ pǝnwa taata wa.<verse eid="EPH 6:9" /></para>
  <para style="s1">Nat Ichi Yaandi Farta</para>
  <para style="m">
    <verse number="10" style="v" sid="EPH 6:10" />Ndukwa Ndikta: Chokam kwaˈkwa hur Chinda tǝ alkǝtˈyan thla nech kwaˈkwa. <verse eid="EPH 6:10" /><verse number="11" style="v" sid="EPH 6:11" />Ɗǝfam icha yi yaanchi Farta kafˈyowun nat kǝthlǝm kǝt kǝ mbahǝnwun thlarta kǝ ɗar ɗafǝrtǝ mbandi hwerǝ nat. <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />Kǝthlǝm kǝt yaandǝ ˈyamǝn ngga tǝ atekǝritǝ fer ndu tǝ fata wa, nechan tǝ ɓǝɓi kutǝrcha tǝ fǝ alkǝta fee nech parat tǝ wuthlɗi nech hur heshiɗiya, tǝ ɓǝɓi shemecha hur hulafǝrtǝ kaɗi michǝ sam samǝn. <verse eid="EPH 6:12" /><verse number="13" style="v" sid="EPH 6:13" />Kǝthlǝm ndaˈan pam ǝna yaandi Farta nat kǝthlǝm kǝ mbahǝn wun thlartǝ tǝ atekǝrichiyowun hur ɓǝɓi minchaˈan. Kǝrsǝ yaanan kǝ chokwun kwaˈkwa.<verse eid="EPH 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 6:14" />Thlaram ha tǝ alkǝta, tǝ sahtǝ kǝnda kan sheɓtǝyowun tǝ kapata yi yaandi Farta yi thlǝrɗakta. <verse eid="EPH 6:14" /><verse number="15" style="v" sid="EPH 6:15" />Pahamchǝ paɗ yi kǝɓikaɗi natwun pata yi ɓas Kwastǝ Ndiktǝɗiya nakowun tǝ tahǝstǝ fa. <verse eid="EPH 6:15" /><verse number="16" style="v" sid="EPH 6:16" />Chektaˈan kǝ ɗar ichiɗiya nat, kǝsam kǝsǝmnda yi fǝr kit kǝ mbahǝn wun thlarandǝ wanhafchi hweˈra.<verse eid="EPH 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 6:17" />Pakowun hǝraˈta kǝɗ lǝɓokra lu indiyowun, tǝrkowun wanfuha I Shemeta, thla nech kǝ ndikti Farta. <verse eid="EPH 6:17" /><verse number="18" style="v" sid="EPH 6:18" />Shiyama hur Shemeta chika kwati tǝ paɗ hur mǝ nat Chokam tǝ tahǝstǝ fa tǝ ɗǝt kǝ pangga hur shitǝyowun kǝthlǝm fee nech para Farta nat chika ayi. <verse eid="EPH 6:18" /><verse number="19" style="v" sid="EPH 6:19" />Shiyam paɗ kǝthlǝm nenchi paɗ. Shiyam kǝthlǝm nenchi. Shiyan kowun Farta kǝ fǝritǝ kaa ndikta thla nati mbahǝn mbuˈta kǝ ɗar ichiɗi chit Farta tǝ thla tahsandǝn ha kǝthlǝm kǝt Kwastǝ Ndiktiya yi Yahudawecha tǝ takǝt nafchǝ nat. <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />Nggǝt hur chalala nakanya, paɗ naki ɓassa kǝɗ thla thlǝndǝ fee i Farta. Shiyama maˈ ni mbahǝn ndiktǝ tǝ alkǝta kǝthlǝm anchi kǝɗ ǝnɗi kǝmchisi<verse eid="EPH 6:20" /></para>
  <para style="s1">Nda Əna yi Ndukwaɗan</para>
  <para style="m">
    <verse number="21" style="v" sid="EPH 6:21" />Tikikus wanmanan mǝn thla yahti, thlǝ chitera, thlǝ kaakǝt paɗ kǝmɗi Chinda, nan sǝnowun chika mǝ nat kǝthlǝm kǝ sǝnwun ndu nechi kǝni tǝ ichiɗi yimndǝ huran. <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />Thlinchi ndi kǝmɗiyowun kǝthlǝm kǝ sǝnwun ndu nechi kǝni, paɗ kǝ ndǝksantǝ wandǝkaɗechˈyowun. <verse eid="EPH 6:22" /><verse number="23" style="v" sid="EPH 6:23" />Wanmanchina, kǝɓikaɗi i Farta Papa tǝ Chinda Yesu Kǝrǝsti kǝ chok tǝ wunchi, tǝ thlǝrɗakta tǝ fǝr kit paɗ. <verse eid="EPH 6:23" /><verse number="24" style="v" sid="EPH 6:24" />Kaakǝta kǝ choktǝ wunchi tǝ nat fee yahchǝ Chinmǝn Yesu Kǝrǝsi tǝ kafata thla thlǝ tǝɓawakcha.<verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>