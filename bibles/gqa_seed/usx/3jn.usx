<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Gaanda</book>
  <para style="h">3 John</para>
  <para style="toc3">3 Yah</para>
  <para style="toc2">3 John</para>
  <para style="toc1">3 Yahaya</para>
  <para style="mt2">Mahkaan yarati</para>
  <para style="mt">Yohanna</para>
  <para style="imt">Tǝrkwathl kan ndikta</para>
  <para style="im">Yohanna yarech ɗelwer tǝɗiya ǝ hur hurat kum chet foɗfoɗa nggǝrsǝ ɗerman (85) kǝ kum chet wanherhaˈarta nggǝrse ɗerman (95) kersǝ nggeti Yesu, kǝmɗi yowun thlǝ pangndi fǝ fǝr kitcha na thlǝman wa Gayus. Ɗelwer taˈan chǝmtǝ Gayus kǝthlǝm kaa tarɗi thlǝ chǝtǝn. Kapaɗan kǝɗ ǝnɗi thlǝ thlǝtǝn fǝ chaˈanchǝ kaɗi yi kit fee thlǝ thlǝndǝn Yohanna kǝmɗiyan. Ə hur ɗelwer taˈan kaɗi fee har tǝ yowun nefa thla na thlǝman wa Diyotarifis thla thlǝ chich atǝkrekǝt tǝ teri Chinda.</para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="s">Nda ǝna</para>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />Ɗelwer tǝɗiya thlaˈtǝ mǝɗinchi nggǝt shertǝ nefa, Kǝmɗi Gayus thla yahti, thla yahti tǝ kit.<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />Shiketǝna thla yahti, nggǝt shiyutǝsi, kǝ mbishin ɗǝt kǝ pangnga ǝ hur chǝka mǝ nat, tǝ paɗ kǝ chokǝn tǝ has has kǝt fata, kǝɗ ǝnɗi naa shishingndǝyo has has. <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />Mbǝninchi fat kaan kǝ ɓak fowun wanmancha fǝ fǝr kit mbuˈ ǝnɗi sǝndǝ ndǝsi kǝ ɗar kafatˈyo hur kit, kǝɗ ǝnɗi thlǝ wiˈtu hur kit. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />Ənsi thlǝ mbǝnichǝf kaan thla pǝɗanchǝ kǝ sǝki wa wanchinchi tandǝ nat ha ǝ hur kit wa.<verse eid="3JN 1:4" /></para>
  <para style="s">Chǝm fee Gayus</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />Shiketǝna thla yahti, kaakǝt ˈyosi hur tarɗi thlǝ chǝtu nat kǝ ɗar wanmanchu wa fǝ fǝr kit cha, kapaɗan kǝ ɗar fee sǝnwaktu tanda. <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />Nafchiɗi kǝsandu tandǝsi, mbuˈndǝ mǝɗiya mbanɗi thlǝ yahtu fǝ fǝr kit cha. Nan nat ndiˈchan kǝ kǝseen tandǝs hur wiˈtǝyanda ǝ mbanɗi nech mbǝnandǝ Fartǝ fa. <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />Malndǝ wurchandǝ ha kǝthlǝm ɓas ndikti Yesu Kǝristi, thlǝwandǝ ǝn hari nafchǝɗi nawakchǝ kǝ fǝ tǝr mbancha wa. <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />Kǝthlǝm ndaˈan, kǝmchansi kǝ kǝsamǝn weˈtǝ nafchǝ ini si. Kǝ chokmǝn kǝ shikechi tera tǝ tanda kǝthlǝm kittaˈan.<verse eid="3JN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />Yarani kǝtǝn shitǝyowun ɗelwersi, paɗaa Diyotarifis, thla yahchǝs kǝn manchan hurwun nat, nggǝma wa ndiktiyaˈan wa. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />Maa ɓinchi, nii mbuˈowun ichiɗi thlǝ chǝtǝn hayang. Mbanɗi thlǝ natǝn sǝɓandǝ thlǝm ǝn kaɗi tǝmɗi sǝɓtǝ shenutǝɗi thlǝ natǝn mbuˈtǝ kǝ ɗar ǝn. Thlenni chaˈawa fa wa, thlǝ nechan kar fǝ fǝr kit chǝɗi ɓecha. Paɗ thlǝ ˈyatanchan fǝ fǝr kit chǝɗi yahchǝ thlǝt tanda. Paɗ thlǝ rǝkchan fee thlich ramchaˈan hur kǝtǝn shita.<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />Shiketǝna thla yahti, kǝ paren sǝɓtǝ nat ha wa, chaˈo kaɗan. Nat thla thlǝ chich kaa ǝna Waˈi Farta. Thla thlǝ chich ɓǝɓi ǝna sǝn wa Farta wa. <verse eid="3JN 1:11" /><verse number="12" style="v" sid="3JN 1:12" />Chǝkawun thlǝ ndikchan kaɗan kǝ ɗar Dimitiriyus. Kittaˈan tǝ indiyan thlǝ pǝnchan, chǝka nggaˈan paɗ thlǝ mbuˈchaˈan kǝɗu. Shinin paɗ wa ǝnɗi thlǝ mbuˈtǝ ǝn kit.<verse eid="3JN 1:12" /></para>
  <para style="s1">Nggǝl mii ndikta</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />Ichisi terchan yahti mbuˈuta, yahwisi kǝ yaru chǝsi wa. <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />Ɗǝfinchǝ kǝfatsi nii ɓat kǝmɗiyo ngga tǝ ndǝrǝmnda wa, kǝ ndikmǝn mee tǝ mee.<verse eid="3JN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15" />Kǝɓi kaɗi i Farta kǝ chok tǝ wechi.</para>
  <para style="p" vid="3JN 1:15">Shikechǝmǝn fee mǝɗya ndu ǝnfa, kǝ ndeen ǝn shikechǝmǝn fa fee minni, artǝ arta.<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>