<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Gaanda</book>
  <para style="h">2 John</para>
  <para style="toc3">2 Yah</para>
  <para style="toc2">2 John</para>
  <para style="toc1">2 Yahaya</para>
  <para style="mt2">Chapatǝ yarati</para>
  <para style="mt">Yohanna</para>
  <para style="imt">Tǝrkwathl kan ndikta</para>
  <para style="ip">Yarech Yohanna ɗelwertǝɗa yi chapataˈan kǝthlǝm kǝ ɗǝksanchǝ fǝ fǝr kitchǝɗi thlǝ nech kan thlǝmat fǝ chaˈanchǝɗi kaɗ thlǝ nech wiˈta. Ə hur chaˈanchǝɗi kaɗ ya fǝ chaˈanchǝs yi kit tǝ fee thlǝ chaˈanchǝ kaɗ yi lekta. Chaˈandǝ yi kit ndat wa nwaat kǝ nggǝmanda wa Kǝristi Yesu ɓechan kǝ hur heshi hur fata.</para>
  <para style="ip">Ɗelwertaˈan paɗ ndik kǝ ɓǝra naafu yi yahraˈan hur nati fǝ fǝr kitcha. Pin paɗ hayan wa, ndat wa, yahraˈan tǝ kit thlǝ wiˈchandǝ ɓukwa.</para>
  <chapter number="1" style="c" sid="2JN 1" />
  <para style="s1">Nda ǝna</para>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1" />Nggǝt kapa nefa, nggǝt yaru ɗelwer tǝɗisiya chǝ nunefa thla tatǝ Farta tǝ wanchiyan, fee yahti kaan hur kit. Ngga nggǝt ichǝt naa yahchǝ wunchǝ wa, paɗ nat tǝ nafchiɗi sǝnchǝ kit fen paɗ tandǝ yah wunchi. <verse eid="2JN 1:1" /><verse number="2" style="v" sid="2JN 1:2" />Thlǝ yahchaˈan wunchi kǝthlǝm kit tǝɗi nech hur wanɗǝkaɗechyaˈan. Kittaˈan paɗ nan nat hur ǝn kǝ kweˈkǝchi.<verse eid="2JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3" />Malan kaakǝta, tǝ haɗandǝ nafchi fa, tǝ has has kǝta thla ɓech mǝɗi Farta Chinmǝn tǝ Yesu Kǝristi Waˈi Farta, kǝ chok tǝ mǝnchi hur kit tǝ yahraˈan.<verse eid="2JN 1:3" /></para>
  <para style="s">Para chaˈati Kǝristi</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4" />Mbǝninchi fat kaan kǝthlǝm sǝkinchi mǝɗi fowun ndat wa fowun wanchǝyo tandǝ wiˈta hur kit, kǝɗ ǝnɗi nda Chinmǝn Farta wa kǝ chǝmǝn. <verse eid="2JN 1:4" /><verse number="5" style="v" sid="2JN 1:5" />Kǝthlǝm ndaˈan chǝ nunefa. Ngga yuwa kusiˈ nati yarutǝs wa. Paɗ thla sǝktǝwun fartǝɗi nggaktǝ wun fǝr kit kǝ Kǝristi. Nggǝt shiyuta kǝ yahmǝn raˈan. <verse eid="2JN 1:5" /><verse number="6" style="v" sid="2JN 1:6" />Yahraˈan ndaˈan nech kǝ nat-ha hur para kusiˈchi Farta. Kǝɗ ǝnɗi sǝktǝwun tǝrkwalth kanan, ndat wa kǝ chokwun hur yahraˈan.<verse eid="2JN 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7" />Mbuˈchi kǝɗu kǝthlǝm fǝ lǝm nafchǝ terchan welndǝ ha kǝ hur heshi. Fen nech kǝ nafchiɗi nggǝmawakchǝ wa Yesu Kǝristi ɓawa kǝ hur heshiɗiya hur fata wa. Weˈtǝ nef ini, mǝthlan thlǝ lǝm nafcha paɗ atǝkreti Kǝristi. <verse eid="2JN 1:7" /><verse number="8" style="v" sid="2JN 1:8" />Kǝsaman inchiyowun ndiˈchan, kǝthlǝm kǝ mǝkawun ǝnɗi kaɗ chǝt ǝn taran kǝ ɗaran wa. Kweˈyam ha kǝthlǝm kǝ mbǝswun ndiiɗ kǝnauˈyowun. <verse eid="2JN 1:8" /><verse number="9" style="v" sid="2JN 1:9" />Nat thla thlarwakchǝ ha kǝ ɗar chaˈati Kǝristi, paɗ nakan chekandǝ kǝ ɗaran, nafɗiya Fartǝs hwirˈyan wa. Paɗaa nat thla naa nat-ˈyan ha hur chaˈati Kǝristi mǝthlan tǝ Chinda Farta tǝ paɗ Wanan. <verse eid="2JN 1:9" /><verse number="10" style="v" sid="2JN 1:10" />Kǝthlǝm ndaˈan, nat nafɗi ɓech kǝmɗiyowun, ɓawa tǝ chaˈaɗiya wa, kǝ thlǝwun ndi kawurchiyowun wa, ndu kǝ ndawun ǝna wa. <verse eid="2JN 1:10" /><verse number="11" style="v" sid="2JN 1:11" />Chǝkawun ndan chi ǝn weˈtǝ nef ini, heryansi hur ɓǝɓi tarchiyan.<verse eid="2JN 1:11" /></para>
  <para style="s">Nggǝl mii ndikta</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12" />Ichǝs terchan yahti kǝ mbuˈowunchi paɗ yahwisi kǝ yarowunchisi wa. Kǝthlǝm ɗǝfinchi kǝfatsi nii ɓat kǝmɗiyowun, kǝ ndikmǝn mee tǝ mee, maˈ naa ɓǝnfatˈyamǝn ndiita.<verse eid="2JN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13" />Wanchi wanmu thla tatǝ Farta, tandǝ ndu ǝn fa.<verse eid="2JN 1:13" /></para>
  <chapter eid="2JN 1" />
</usx>