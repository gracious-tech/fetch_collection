<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2CO" style="id">- Gaˈanda</book>
  <para style="h">2 Corinthians</para>
  <para style="toc3">2 Kor</para>
  <para style="toc2">2 Corinthians</para>
  <para style="toc1">2 Korintiyawa</para>
  <para style="mt2">Chapatǝ yarati Bulus kǝmɗi</para>
  <para style="mt1">Korintiyawecha</para>
  <para style="imt">Tǝrkwathl kan ndikta</para>
  <para style="im">Chapatǝ yarati Bulus kǝmɗi Korintiyawecha, yerech fee hurawa terchan wa kǝrsǝ thla yara fee tǝrkwathl kanan. Tǝrchǝ fee Bulus tatǝ kǝmsha i Yesu yarechan wanshenggǝnchǝɗi natǝn ǝ thle Makiɗoniya, mǝɗi chǝtǝn tar ɓaas kwastǝ ɗikta yi sǝkta hurechǝ kum chǝt ɗǝrman nggǝrsǝ ɗǝrman kǝrsǝ nggǝt Yesu.</para>
  <para style="ip">Yarech fee ɗelwertǝɗiya kǝthlǝm kǝ wathlan fee fǝ fǝr kit chǝɗi nech ǝ Korinti sǝ wa, kǝ nakanya peˈchi Bulus yah tanda. Sǝnan fee tandǝs wa, ndiktǝɗi thlǝnowun ndǝn thla ndech wa kǝ chok wun kǝ shikechi Farta tǝmɗi Yesu peˈchan ha, nggǝrwa ha wa. Thleya chokchan kǝɗu, chǝka nakan wa tapi yananchi tandǝ ha ǝ hur yowun ɗelwertǝɗi yarandǝn tandǝsi. Kǝrsi ndiktǝɗiya, chat shiyankǝ Bulus tanda kǝ wumandǝ kǝnau pafǝn thla natǝn ɗǝt taˈanchi kǝ Urshelima nakan nat ɓat kǝmɗiyandǝ tolla wa.</para>
  <para style="ip">Naa fee nata ndik Bulus kaan kǝ ɗar indiyan hur ɗelwertǝɗiya mǝ takǝt ǝnɗi yaratǝn hur ɗelwerchiɗi yaratǝn. Thleya chokchan kǝɗu kǝthlǝm ǝ fartǝɗi naa Bulus yara ɗelwertǝɗiya ɓillasi kaan pǝthlǝr nandǝ tǝ fowun hur nafcha fǝ fǝr kit ǝ Korinti.</para>
  <para style="ip">Ə hur ɗelwer taˈan, Bulus chentǝ indiyan kesh ǝ ɗar ˈyaraɗi thlǝ chandǝ fǝ chaˈachǝ kaɗ kǝ fǝ lekchǝ yu yi ndat wa mǝthlan ngga tatǝ kǝmsha yi kit wa.</para>
  <chapter number="1" style="c" sid="2CO 1" />
  <para style="s">Ndaˈǝni Bulus</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 1:1" />Ɗelwertǝɗa thlaˈtǝ mǝɗinchi Bulus, tatǝ kǝmsha i Yesu Kǝristi tǝ nggǝmndi Farta fa. Wanmanmǝn hur fǝr kit Timoti mǝthlan mǝɗa tǝ nggǝta.</para>
  <para style="p" vid="2CO 1:1">Ɗelwertǝɗa kǝmɗi fǝ tǝr mbanchi Farta thla nech ǝ mǝrǝɓ Koranti, nat tǝ fee nech chiɗ chiɗ ǝ hahi Akaya.<verse eid="2CO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 1:2" />Kafata tǝ chok hashas kǝta i Papa Farta, tǝ yi Chinda Yesu Kristi kǝ chok ndǝ tǝ wunchi.<verse eid="2CO 1:2" /></para>
  <para style="s">Chan Bulus usoko Farta kǝrsǝ ɓahtiyan ha</para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 1:3" />Usoko kǝmɗi Farta, mǝthlan tǝɗi nech kǝ Farta, tǝ Papa yi Chinmǝn Yesu Kǝristi. Mǝthlan nech kǝ chinda yi kafata, tǝ paɗ Farta yi sǝsi nat. <verse eid="2CO 1:3" /><verse number="4" style="v" sid="2CO 1:4" />Mǝthlan tǝɗi thlǝ nech chamǝn sǝsi nat hur ɓahtiyamǝn ha, kǝthlǝm nggǝmǝn paɗ kǝ mbahǝn mǝn chan sǝsi fee nech sa chika weˈtǝ yen ɓahta. Cham kǝɗu tǝmɗi sǝsi tǝɗi thlǝ mbǝstǝ mǝn mǝɗi Farta. <verse eid="2CO 1:4" /><verse number="5" style="v" sid="2CO 1:5" />Kǝthlǝm paɗ kǝɗ ǝnɗi nat mǝn ɓahtǝ ha, weˈtǝ thla saa Kǝristi, kǝɗu paɗ thlǝ naa Farta chamǝn sǝsi kaan, tǝmɗi Kǝristi. <verse eid="2CO 1:5" /><verse number="6" style="v" sid="2CO 1:6" />Chǝka nechaˈan ɓahtǝ ha, nat kǝthlǝm sǝsi ˈyowun, tǝ paɗ kǝ ɗǝksanchi natˈyowun ha hur Shemeta. Chǝka nech fee ndamǝn sǝssi, nat kǝthlǝm nda sǝssiˈyowun, thla thlǝ ɗǝfchǝ wunchi, kǝ kǝriswun weˈtǝ ɓahtǝɗiya thlǝ natˈmǝn sata. <verse eid="2CO 1:6" /><verse number="7" style="v" sid="2CO 1:7" />Ɗǝf wanɗǝkaɗatˈyaˈǝn kǝ indiyowun nechan tǝ alkǝt fa. Kǝthlǝm sǝnˈǝn wa, kǝɗ ǝnɗi wumandǝwun inda tǝ nggaˈan hur ɓahtǝ ha, kǝɗu paɗ natˈwun mbǝs weˈtǝ sǝsi tǝɗi thlǝ chaˈan ndǝ fee.<verse eid="2CO 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 1:8" />Wanmanchina, yahwaˈansi kǝ nowun kǝ fǝ kumisǝn icha, tǝ ɓahtǝɗi satˈǝn ǝ hahi Asiya wa. Kǝthlǝm siˈǝn ɓahtǝ kaan nggǝ sǝrtaˈansǝ wa, ǝnaɗan ǝ tǝktǝ nggaˈan kaan, saɓ chi wanɗǝkaɗat ˈyaˈan kǝsh wa peˈwaˈan nat ha paɗ wa. <verse eid="2CO 1:8" /><verse number="9" style="v" sid="2CO 1:9" />Chaˈan chan fa kǝɗ tapi thleˈanchǝ fee chak mii mǝrtǝsi. Paɗaa ǝnɗa sǝɓchan kǝɗu, kǝthlǝm kǝ fǝrˈǝn alkǝt kǝ chok indiyaˈan wa, paɗ kǝmɗi Farta ndak, thla thlǝ thlaˈanchǝ fee mǝmatecha. <verse eid="2CO 1:9" /><verse number="10" style="v" sid="2CO 1:10" />Farta hǝraˈaˈǝncha meˈi ɓǝɓi mǝrta, nan hǝraˈaˈanndǝ paɗ. Paɗaa ɗǝf ǝn wanɗǝkaɗat sǝ wa nan hǝraˈaˈannda chǝkakwati, <verse eid="2CO 1:10" /><verse number="11" style="v" sid="2CO 1:11" />Kun paɗaa, kǝ kǝsaˈan chǝwunsi tǝ shita. Tǝ kǝɗu nafchǝ terchan nandǝ chan usoko Farta kǝthlǝm nggaˈan, kǝthlǝm mbǝsˈǝnaɗi har natˈǝn mbǝsta yi nggǝmandǝ shichi nafchi terchan.<verse eid="2CO 1:11" /></para>
  <para style="s">Tharan Bulus tahǝstǝyan fa yi wiˈyandǝ tandǝ fa</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 1:12" />Ənɗi thlǝ ɗǝfchǝ nggaˈan kǝ thlaˈ kirsha hacha. Hur ɓǝrati wanɗǝkaɗech yaˈan mǝthlan sǝnaˈǝndǝs wa, natˈyaˈan ha hur heshiɗiya chichaˈan tǝ wanɗǝkaɗat arta kapaɗan nggitkektiyaˈan tǝ kun. Chichaˈan kǝɗu ngga wa kǝthlǝm ɗathlǝ heshi wa, kǝthlǝm kafati Farta ndak. <verse eid="2CO 1:12" /><verse number="13" style="v" sid="2CO 1:13" />Kǝthlǝm ngga nechaˈan yarowun ǝnɗi si nawaktu wun mbahan changgandǝ kǝ wathlowunchǝ ha wa. Nggǝt ɗǝf kǝfatsi kǝ wathlowunchǝ chǝka mǝ ha nat. <verse eid="2CO 1:13" /><verse number="14" style="v" sid="2CO 1:14" />Nakan ya ndiktiyaˈan wathlowun wa ha nat wa. Ndat wa, nowun mbahǝn ɗǝf kǝfat kǝ nggaˈan, kǝɗ ǝnɗi nat ǝn mbahǝn ɗǝf kǝfat kǝ kun paɗ, ǝ farti ɓati Chinmǝn Yesu kaɗi.<verse eid="2CO 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 1:15" />Kǝthlǝm sǝninchi tǝ ndat wa kǝɗuyu natǝn sǝɓta, ndaˈan chicha yahti kǝ ɓi kǝmɗiyowun ǝ tǝrkwathl kanan, kǝthlǝm kǝ mbǝswun mbǝsˈǝnhar kǝ inan chap. <verse eid="2CO 1:15" /><verse number="16" style="v" sid="2CO 1:16" />Tahsinchi fa kǝ wiˈyowun chifa maa nggǝt pǝɗat kǝ Makidoniya, kǝ nggǝri parat tǝmɗiyowun maa nggǝt ɓat kaɗ ǝ Makidoniya, kǝ kusichǝ wunsi tǝ ǝnɗi yahti kǝthlǝm pǝɗatinchi kǝ Yahudiya. <verse eid="2CO 1:16" /><verse number="17" style="v" sid="2CO 1:17" />Awi, chowunchan fa wa chichi kǝɗu hur kumi sǝnda wa? Ndu tahǝstinchǝ nechan hur fata wa, kǝthlǝm kǝ ndi wa, “Aa” Kǝ nggǝri ndat paɗ wa, “Auwa” Kǝɗar ǝn arta wa?<verse eid="2CO 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2CO 1:18" />Kǝɗ ǝnɗi natǝn asˈindǝs wa Farta thlǝ kafat nakan, kǝɗu natǝn ndiktǝɗi mbuˈowun ndǝ ǝn ngga yi ndat wa, “Aa” tǝ “Auwa” wa. <verse eid="2CO 1:18" /><verse number="19" style="v" sid="2CO 1:19" />Kǝthlǝm Waˈi Farta Yesu Kǝristi, thlaˈtǝ nggǝta tǝ Sila tǝ Timoti ɓasowun ndǝ ǝn kǝ ɗaran. Ngga mǝthlan yi “Aa” tǝ “Auwa” wa, paɗ ǝ hwirˈyan “Aa” weenmǝta. <verse eid="2CO 1:19" /><verse number="20" style="v" sid="2CO 1:20" />Kǝthlǝm tǝmɗiyan ndiiɗandǝ Farta nat ɗǝf michiɗi chǝtǝn. Ndaˈan chicha tǝmɗi Yesu Kǝristi thlǝ ndat mǝn wa, “Kǝchok kǝɗu” Kǝthlǝm maandi Farta. <verse eid="2CO 1:20" /><verse number="21" style="v" sid="2CO 1:21" />Nakanya Farta mǝthlan nggǝraˈanchǝ ha tǝ kun kǝ mbahanmǝn thlarta tǝ alkǝt fa hur Kǝristi. Mǝthlan taɗchǝ mǝnchi, <verse eid="2CO 1:21" /><verse number="22" style="v" sid="2CO 1:22" />ɗǝfamǝnkan wanɗǝsǝndiyan kǝ indiyamǝn thla nech pǝndǝ wa nggǝmǝn yaˈan. Paɗ ndǝfamǝnkan Shemetˈyan kǝ hur wanɗǝkaɗechˈyamǝn, kǝthlǝm wathlandǝ ǝnɗi ha natǝn chǝt thla kǝ pangnga.<verse eid="2CO 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2CO 1:23" />Paɗ Farta ǝ shinsǝwa, maa lektǝ nati chǝta ndati wa ǝnɗi chich ɗǝwakti tǝ Korinti kǝthlǝm kǝ chekowun chi heˈta wa. <verse eid="2CO 1:23" /><verse number="24" style="v" sid="2CO 1:24" />Ngga wa tǝ naˈan pǝnowun alkǝt kǝ ɗar fǝr kit ˈyowun wa, auwa, tǝnamǝn chǝt ter mǝt arta, kǝthlǝm kǝ mbǝnwun fata. Kǝthlǝm tǝmɗi fǝr kit ˈyowun thlartǝwun ha tǝ alkǝt fa.<verse eid="2CO 1:24" /></para>
  <chapter eid="2CO 1" />
  <chapter number="2" style="c" sid="2CO 2" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 2:1" />Kǝthlǝm ndaˈan thlarani ha hur wanɗǝkaɗatinchi wa, peˈwi wiˈyowundǝ fa thla nech ɗǝf wunchi kǝ sǝɓtǝ hwira wa. <verse eid="2CO 2:1" /><verse number="2" style="v" sid="2CO 2:2" />Kǝthlǝm maa ɗǝfinchǝ wunchi kǝ sǝɓtǝ hwira, wun nech tǝrandǝ hwirinchǝ ha, maangga kun tǝɗi sǝɓandi wanɗǝkaɗechˈyowun kaɗ wa? <verse eid="2CO 2:2" /><verse number="3" style="v" sid="2CO 2:3" />Ndaˈan chicha yarowundi ɗelwel tǝɗisi, kǝthlǝm yahwisi kǝ ɓi mbǝs nafchiɗi kǝmchǝs kǝ tǝrandi hwirinchi ha, kǝ ɗǝf ndǝ nenchi kǝ sǝɓtǝ hwira wa. Kǝthlǝm fǝrinchǝ kit kǝ wunchǝ nat, ndat wa natˈwun nowun mbǝnfat tǝ nenchi.<verse eid="2CO 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 2:4" />Yarowunchisi hur sǝɓtǝ hwira tǝ ɓahtǝ ha, tǝ ˈyamǝt kaan, ngga wa kǝ ɗǝfi wunchǝ kǝ sǝɓtǝ hwira wa, paɗ kǝthlǝm kǝ sǝnwun kwiɗimǝn yahtǝɗi nessinchin kǝthlǝm kǝt kun.<verse eid="2CO 2:4" /></para>
  <para style="s">Kalaman thla ha chich ɓǝɓifata</para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 2:5" />Maa ɗǝf yowun wunchǝ kǝ sǝɓtǝ hwira, ngga nggǝt ichǝnnǝ sǝɓandǝn hwirˈyan kaɗ wa, nat wun sǝɓandǝn hwirˈyowun kaɗi, ngga nechi mbuˈtǝ kǝɗu kǝthlǝm kǝ ɗahowunchi in wa. <verse eid="2CO 2:5" /><verse number="6" style="v" sid="2CO 2:6" />Ɓahtǝɗi saa nafɗa, mǝɗi tertǝwun, ǝ cheˈ kǝɗu. <verse eid="2CO 2:6" /><verse number="7" style="v" sid="2CO 2:7" />Kwechchan kǝ kalawun ɓǝɓifatˈyan ha, kǝ ndǝksawun wanɗǝkaɗatˈyan, kǝthlǝm kǝ ɓǝ sǝɓtǝ hwir mbǝrandǝ alkǝtˈyan ha wa. <verse eid="2CO 2:7" /><verse number="8" style="v" sid="2CO 2:8" />Kǝthlǝm ndaˈan, nggǝt shiyowunda, kǝ wathlawun yah raˈan ˈyowun ha kafˈyan. <verse eid="2CO 2:8" /><verse number="9" style="v" sid="2CO 2:9" />Ənɗi chicha yarowundi ɗelwertǝɗisi, kǝthlǝm kǝ kaɗowunchi, kǝ nii ndu thlǝ parechowun ǝnɗi thlǝ mbaˈowun ndi chǝk tǝ yen mbanda. <verse eid="2CO 2:9" /><verse number="10" style="v" sid="2CO 2:10" />Thla kalandǝ wun chǝka mǝ ha, nggǝt paɗ kalani ha. Ənɗi kathli ha paɗ, ma ǝnsi yi kathlǝ ha, chichi kǝthlǝm kun, ǝ pangngǝn Kǝristi, <verse eid="2CO 2:10" /><verse number="11" style="v" sid="2CO 2:11" />kǝthlǝm kǝ pǝɗan hwǝˈrǝ alkǝt ˈyamǝn ha wa. Nakan sǝn mǝn mban ɗathl chiyan.<verse eid="2CO 2:11" /></para>
  <para style="s">Ənɗi ɗahanchǝ Bulus in ǝ Taruwasa</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 2:12" />Kǝ saˈki kǝ Taruwasa kǝ ɓasi kwastǝ ndikti Kǝristi, sǝninchi paɗ wa inichi Chindǝ mbandǝsi kǝ chi taran ǝ mǝɗa. <verse eid="2CO 2:12" /><verse number="13" style="v" sid="2CO 2:13" />Chǝka tǝ kǝɗu hunawu hur indinchi ha wa, kǝthlǝm ǝ mbǝsa wi wanmanǝ Titus hur fǝr kit ǝ minni wa, kǝthlǝm ndaˈan, ndanki tanda wa nggǝt nii mbǝrtǝ ha, mbǝrki ha kǝ Makidoniya.<verse eid="2CO 2:13" /></para>
  <para style="s">Thlǝthla pangkǝˈin hur Kǝristi</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 2:14" />Paɗaa usoko kǝmɗi Farta. Mǝthlan tǝɗi thlǝ nech kǝs kalatˈyamǝn kǝɗ tǝ thlǝthlamǝn pangkǝˈin hur Kǝristi, tǝmɗiyamǝn thlǝnatǝn welandǝ saˈtaˈan tǝɗi nech mbinchan yi sǝn Kǝristi chǝka tǝyeni. <verse eid="2CO 2:14" /><verse number="15" style="v" sid="2CO 2:15" />Kǝthlǝm paɗaa, ǝ mǝɗi Farta nggǝmǝn nech kǝ saˈtaˈan nech mbinchan yi Kǝristi hur fee naa fee hǝraˈa ndata, tǝ fee nech ǝ mban tǝktǝ ha. <verse eid="2CO 2:15" /><verse number="16" style="v" sid="2CO 2:16" />Kǝmɗi feuwuna saˈtǝɗi mbǝnchan ya mǝrta, kǝmɗi fowun paɗ saˈtǝɗi mbinchan ya shishingnda. Wun nech mbahan chǝt weˈtǝ tarɗiya? <verse eid="2CO 2:16" /><verse number="17" style="v" sid="2CO 2:17" />Kǝthlǝm ngga nechamin kǝɗ takǝɗ nafcha wa, fee thlǝ ɓaschi Ndikti Farta kǝthlǝm mbǝs chekta. Paɗ nakan Farta thlǝnchi nggaˈan, thlǝ nechaˈan ndikta hur kit ǝ pangngǝnan, tǝmɗi Kǝristi.<verse eid="2CO 2:17" /></para>
  <chapter eid="2CO 2" />
  <chapter number="3" style="c" sid="2CO 3" />
  <para style="s1">Fǝ chǝt tar yuwa ɗǝf mee</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 3:1" />Tǝ namǝn nggak chim inchamǝn paɗ wa? Ndu tǝ yahmǝn kǝ yaramǝnchǝ fowun ɗelwer chǝsi kǝthlǝm kǝ ɗiˈǝn kǝmɗiyowun, kǝɗ ǝnɗi thlǝ chǝt fowun wa, ndu thlaˈtǝ mǝɗˈyowun kǝmɗi fowun wa? <verse eid="2CO 3:1" /><verse number="2" style="v" sid="2CO 3:2" />Kun tǝ indiyowun nggun nech kǝ yara ɗelwer tǝɗi nessiyaˈan, thla yarandǝ fee ha hur wanɗǝkaɗechˈyaˈan, kǝthlǝm kǝ nǝ chǝka wuni tǝ paɗ chǝka wun kǝ chan ngganchi. <verse eid="2CO 3:2" /><verse number="3" style="v" sid="2CO 3:3" />Pǝnwun hayan wa, kun nech kǝ yara ɗelwer i Kǝristi, tǝmɗi ɓasiyaˈan. Yara ɗelwer tǝɗi paɗ ya yarawu fee ha tǝ ǝna yarata wa, paɗ yaran chǝ fee ha tǝ Shemeta thla chiɗ chiɗ yi Farta thlǝ Shishingnda. Ngga ǝ ɗar ɓohtǝ fera wa, paɗ ǝ hur wanɗǝkaɗati nafcha. <verse eid="2CO 3:3" /><verse number="4" style="v" sid="2CO 3:4" />Mbuˈchaˈan kǝɗu kǝthlǝm wathlaˈanchǝ ha naa Farta thlǝt ndiktǝyaˈan tǝmɗi Kǝristi. <verse eid="2CO 3:4" /><verse number="5" style="v" sid="2CO 3:5" />Ənˈyamǝnsi natmǝn mbahan pǝnda wa, ndat wa tǝ mbǝr ǝnˈyamǝn thlǝ natmǝn chǝt tarɗa wa. Mbǝr ǝnˈyamǝn thlaˈchan mǝɗi Farta. <verse eid="2CO 3:5" /><verse number="6" style="v" sid="2CO 3:6" />Mǝthlan chicha mbahandǝmǝn choktǝ kǝ fǝ tar yuwa ɗǝf mee. Yuwa ɗǝf miɗiya ngga yuwa kusiˈ wa, Shemeta Fartǝ ɓech taˈanchi. Kusiˈ tǝɗi yara ndǝ fee ha ya ndaˈan thlǝ ɓech tǝ mǝrta, paɗ Shemeta thlǝ fǝrchan Shishingnda.<verse eid="2CO 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 3:7" />Yaran fee kusiˈ i Musa ha ǝ ɗar ɓohtǝ fera, paɗ maandi Farta ǝ pǝntǝ fatˈyan fartǝɗi fǝr tǝ fee. Chǝka nakan wa chǝmǝnɗi fǝ nech ǝ chimandi Musa nan thlǝrǝt tǝ kaɗi, pǝntǝ ɗaˈkǝt kaan, chicha nafchi Israˈilawecha wulandǝ ɗǝpandǝ chimaandi Musa ɗelengnga. Maa chaˈaˈanɗi kaɗ thlǝ ɓech tǝ mǝrta ɓi tǝ maandǝ kǝɗaya, <verse eid="2CO 3:7" /><verse number="8" style="v" sid="2CO 3:8" />nech tertǝ maan tar thla nech kǝyi Shemet nat wa kǝni? <verse eid="2CO 3:8" /><verse number="9" style="v" sid="2CO 3:9" />Maa ǝnɗi thlǝ ɓech tǝ mǝrta mbǝstǝ maanda, kittaˈan ǝnɗi thlǝ ɓech tǝ mbǝs kaakǝti Farta pǝɗanchǝ ha tǝ maandǝ langnga. <verse eid="2CO 3:9" /><verse number="10" style="v" sid="2CO 3:10" />Kittaˈan ɗohtǝ ɗǝf mee maandiyansi nakanya wa, maa ǝ kaɗan fee tǝ maandi yuwa ɗǝf mee. <verse eid="2CO 3:10" /><verse number="11" style="v" sid="2CO 3:11" />Maa ǝnɗi nech thlǝrǝt tǝ kaɗi ɓi tǝ maanda, nech maandi ǝnɗi nech choktǝ kǝ kwekǝchi nat wa kǝni?<verse eid="2CO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 3:12" />Nakan weˈtǝ ɗǝf wanɗǝkaɗaɗiyamǝn siya, ndaˈan chicha thlǝ mbahandǝ ǝn ndikta lekǝtsi wa. <verse eid="2CO 3:12" /><verse number="13" style="v" sid="2CO 3:13" />Ngga nechamǝn kǝɗ Musa wa, thla chipanchi chimandiyan tǝ ǝna chipta wa, kǝthlǝm kǝ nǝ Israˈilawechǝ ndukwa maanɗi nech thlǝrǝt tǝ kaɗ wa. <verse eid="2CO 3:13" /><verse number="14" style="v" sid="2CO 3:14" />Paɗaa chǝ hur inchiyandǝ kaɗ kwaˈkwa, kǝthlǝm paˈ kǝ ɓukwiya ǝna chiptaˈan thlǝ nechan ˈyatanda naa kit, maa fee chan nggandǝ ɗohtǝ ɗǝf mee. Mbahan wu fee kǝtandǝ kaɗ wa maangga tǝmɗi Kǝristi ndak wa. <verse eid="2CO 3:14" /><verse number="15" style="v" sid="2CO 3:15" />Paˈ kǝ ɓukwiya maa fee changga ndǝ kusiˈ i Musa, se maa nggǝlan ǝna chip tǝɗiya wanɗǝkaɗechˈyanda. <verse eid="2CO 3:15" /><verse number="16" style="v" sid="2CO 3:16" />Paɗaa naa fee mbahan kǝtandǝ kaɗi maa tǝɓǝr nef ha ɓi kǝmɗi Chinda Kǝristi. <verse eid="2CO 3:16" /><verse number="17" style="v" sid="2CO 3:17" />Chinda mǝthlan nech kǝ Shemeta. Ə mǝɗi naa Shemeti Chindǝ paɗ, ǝ minni naa kumi chok maa fa kǝta. <verse eid="2CO 3:17" /><verse number="18" style="v" sid="2CO 3:18" />Natˈmǝn tǝɗi chipawaktǝ fee chimaanchi yamǝn, thlǝnechamǝn ɗaˈkǝt maandi Chinda. Paɗ thlǝ nech fee ɓeɗamǝn ndǝ ha kǝ chok mǝn kǝɗ mǝthlan. Mbeɗeɗi thlǝ mbeɗamǝn ndǝ fee ha ya, thlǝ nechan chektǝ hur maanda kǝ maanda. Thleya ɓechan kesh mǝɗi Chinda, thla nech kǝ Shemeta.<verse eid="2CO 3:18" /></para>
  <chapter eid="2CO 3" />
  <chapter number="4" style="c" sid="2CO 4" />
  <para style="s">Shemeti Farta hwirˈyamǝn</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 4:1" />Kǝthlǝm ndaˈan, nakan tǝmɗi haɗaanɗi haɗandǝmǝn Fartǝ fa naa tarɗiyamǝnsi ya, mbiɗwu wanɗǝkaɗechˈyamǝn kaɗ wa. <verse eid="2CO 4:1" /><verse number="2" style="v" sid="2CO 4:2" />Ə paˈanwu ǝn tǝ wuɓandǝ ichiɗi nech kǝ ǝna hartǝ fata wa. Lǝm waˈan nafcha wa ndu kǝ tǝɓraˈǝn ndikti Fartǝ ha wa. Paɗ thlǝ nechaˈan mbuˈ kit hayang. Tǝ kǝɗu naa chǝka wuni mbuˈ ǝnɗi sǝndǝnsi kǝɗar kitˈyaˈan ǝ pangngǝn Farta hur wanɗǝkaɗatˈyan. <verse eid="2CO 4:2" /><verse number="3" style="v" sid="2CO 4:3" />Chǝka mǝ kǝ ndǝ fee wa ɓasiyaˈan ǝ nggǝthla, nechan ǝ nggǝthla ǝ mǝɗi fee nech ǝ mban tǝktǝ ha ndak. <verse eid="2CO 4:3" /><verse number="4" style="v" sid="2CO 4:4" />Fen fǝ kumi fǝr kit, kǝthlǝm kutur heshiɗiya ndat wa hweˈra, komantǝ tanda, thla nawak tǝndǝ mbahǝn naa ɗaˈkǝti ndikti Kǝrǝsti ha, mǝthlan tǝɗi nech kǝɗ Farta. <verse eid="2CO 4:4" /><verse number="5" style="v" sid="2CO 4:5" />Kǝthlǝm ngga ɓas indiyaˈan nat ǝn chita wa, yi Yesu Kǝristi, ndat wa mǝthlan nech kǝ Chinda, nggaˈan paɗ kǝɗ mafechˈyowun nakaˈan kǝthlǝm kǝt Yesu. <verse eid="2CO 4:5" /><verse number="6" style="v" sid="2CO 4:6" />Kǝthlǝm Fartǝɗi ndecha wa, “Malan ɗaˈkǝta kǝ ɓǝ kesh hur wuthla kǝ fǝr tǝ ɗaˈkǝta,” mǝthlan paɗ ɗǝfchǝ ɗaˈkǝtˈyansi kǝ fǝrtǝ ɗaˈkǝt hur wanɗǝkaɗech ˈyamǝn. Kǝthlǝm kǝ fǝraminchǝ ɗaˈkǝt sǝn mandi Farta thla pǝnchǝ fat ǝ chimaandi Kǝristi.<verse eid="2CO 4:6" /></para>
  <para style="s">Kǝnawa ǝ hur ɓutǝ taɓta</para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 4:7" />Kǝnauɗi nessiyamǝn ya nechan ǝ hur ɓutǝɗi tǝndǝ fee tǝ taɓta, ndat wa, fechˈyamǝn, kǝthlǝm kǝ pǝnfe ndiiɗ alkǝtɗiya thla pǝɗanchi tandǝ ha nat thlaˈtǝ mǝɗi Farta, ngga thlaˈtǝ mǝɗˈyamǝn wa. <verse eid="2CO 4:7" /><verse number="8" style="v" sid="2CO 4:8" />Thlǝ nech fee fǝramǝn ɓahta chǝka tǝ yen mbenna, chǝka kǝɗu wulamǝn wu taran wa. Fartǝ yowun sǝnwamǝn ǝnɗi nat mǝn chǝta wa, chǝk tǝ kǝɗu kǝta wa mǝn wanɗǝkaɗat kesh wa. <verse eid="2CO 4:8" /><verse number="9" style="v" sid="2CO 4:9" />Fǝraˈanchǝ fee pancha, chǝk tǝ kǝɗu malaˈǝnwu Farta wa. Fartǝ yowun thlǝ thlǝfchǝ fee nggaˈan ha kǝ haha, nat tǝ kǝɗu ɓǝlaˈanwu fee wa. <verse eid="2CO 4:9" /><verse number="10" style="v" sid="2CO 4:10" />Weendi mǝta nggaˈan ǝ meˈi mǝrta kǝɗ ǝnɗi chaandǝ fee Yesu, kǝthlǝm kǝ pǝn fee nati Yesu ha fii fatˈyamǝn. <verse eid="2CO 4:10" /><verse number="11" style="v" sid="2CO 4:11" />Ə natˈyamǝn ha hur heshi, nggǝmǝn meˈi mǝrta ween mǝta kǝthlǝm Kǝristi, kǝthlǝm kǝ nǝ fee nati Yesu ha fi faɗiyamǝn ya thla nech mǝrta. <verse eid="2CO 4:11" /><verse number="12" style="v" sid="2CO 4:12" />Ndaˈan chicha thlǝ nat ǝn meˈi mǝrta, kǝthlǝm kun kǝ mbǝswun shishingnda.<verse eid="2CO 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 4:13" />Ndech Yara Ndikti Farta wa, “Fǝrinchi kit, kǝthlǝm ndaˈan chich ndikti.” Nakan Sheme fǝr kit ˈyamǝn weˈtaˈan arta, kǝɗu paɗ fǝr ǝn kitsi, ndaˈan chicha nat ǝn ndikta. <verse eid="2CO 4:13" /><verse number="14" style="v" sid="2CO 4:14" />Kǝthlǝm sǝn mǝn paɗ wa mǝthlan tǝɗi thlaˈanchi Chinda Yesu ǝ mǝrta, nan thlaˈamǝn nda ɓukwa tǝ Kǝristi, tǝ paɗ kǝ fǝrtǝ nggaˈan kǝ pangngǝnan ɓukwa tǝ kun. <verse eid="2CO 4:14" /><verse number="15" style="v" sid="2CO 4:15" />Nat ichiɗiya kǝthlǝm naafu ˈyowun, kǝthlǝm kaafaɗi Farta thlǝ saˈchǝ kǝmɗi nafchǝ terchan, maa chok kǝɗu nan ɗǝf nafchǝ terchan kǝ chekandǝ usoko kǝmɗi Farta, kǝthlǝm kǝ maanan fee.<verse eid="2CO 4:15" /></para>
  <para style="s">Natˈha tǝmɗi fǝr kit</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 4:16" />Kǝthlǝm ndaˈan kǝta wa mǝn wanɗǝkaɗat kesh wa. Chǝka mǝ nakan wa tǝ heshi, faɗiyamǝn ya mǝthlan sǝɓtǝ kaɗi, paɗ tǝ huran, fee nggǝramǝn ndǝ ha weendi mǝta. <verse eid="2CO 4:16" /><verse number="17" style="v" sid="2CO 4:17" />Kǝthlǝm wan ɓahtǝɗi nat mǝn sat ya nech nǝ tolla wa, nan nggǝtamǝn maandǝs kaan, thla nawaktǝ sǝrtaˈansi, paɗ kǝnsi kǝ kwekǝchi. <verse eid="2CO 4:17" /><verse number="18" style="v" sid="2CO 4:18" />Kǝthlǝm ndaˈan ɗǝfwaˈan wenitǝyaˈan kǝ ɓǝra ichiɗi thlǝ naa fee wa, se kǝ ɓǝra ichiɗi thlǝ nawaktǝ fee. Nakan ichiɗi thlǝ naa fee, nandǝ mbǝrtǝ ha leɗ leɗ, paɗ ichiɗi thlǝ nawaktǝ fee nandǝ natˈsi kǝ kwekǝchi.<verse eid="2CO 4:18" /></para>
  <chapter eid="2CO 4" />
  <chapter number="5" style="c" sid="2CO 5" />
  <para style="s">Yuwa faɗi natˈmǝn mbǝsta</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 5:1" />Kǝthlǝm sǝnmǝn wa maa chen fee kuwurtǝɗi kaɗ natˈmǝn huran hur heshiɗiya, wirsi tahsamǝn ndǝ Fartǝs ǝ hulafǝrta, wurɗiya ngga nef tahǝscha wa, wuran nan natsi kǝ kwekǝchi. <verse eid="2CO 5:1" /><verse number="2" style="v" sid="2CO 5:2" />Ə nakan ya nggǝmǝn fǝfǝrta, nggǝmǝn kwechkwech kaan kǝ mbǝsmǝn faɗi naa fee pamǝn ndǝ ǝ hulafǝrta. <verse eid="2CO 5:2" /><verse number="3" style="v" sid="2CO 5:3" />Paɗ maa kwasamǝnchǝ fee si, nǝ fee mbǝsamǝnchǝ tandǝrkwaˈ wa. <verse eid="2CO 5:3" /><verse number="4" style="v" sid="2CO 5:4" />Fartǝɗi nat mǝn chok tǝ hur kuwurtǝɗi heshiɗiya, nggǝmǝn fǝfǝrta, kǝthlǝm ɓahchiɗi natˈmǝn sata. Nggǝmǝn fǝfǝrta ngga wa kǝthlǝm tǝ yahmǝn kǝ chakmǝn ha tǝ faɗi heshi ya wa, paɗ kǝthlǝm tǝ yahmǝnsi kǝ pamǝnchǝ fee yi hulafǝrta. Kǝthlǝm ǝn tǝ shishingnda thla kǝ kwekǝchi nan ɓeɗandǝ faɗi ha nech mǝrta nat. <verse eid="2CO 5:4" /><verse number="5" style="v" sid="2CO 5:5" />Farta mǝthlan chich mǝnchi kǝthlǝm ɓeɗa faɗi ya, paɗ fǝramǝn kan Shemetˈyan kǝthlǝm kǝ wathlamǝnchǝ ǝnɗi ha natǝn chamǝn ndǝ kǝ pangnga.<verse eid="2CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 5:6" />Kǝthlǝm ndaˈan, wathlamǝnchi weenmǝta sǝn mǝn paɗ wa, maa tana nggǝmǝn hur faɗi heshi ya, chakmǝn ha tǝ Chinda. <verse eid="2CO 5:6" /><verse number="7" style="v" sid="2CO 5:7" />Kǝthlǝm natˈyamǝn ha ɓǝra fǝr kit, ngga tǝmɗi ǝnɗi thlǝ natˈmǝn tǝ wenita wa. <verse eid="2CO 5:7" /><verse number="8" style="v" sid="2CO 5:8" />Kittaˈan wathlamǝnchǝ ha hur wanɗǝkaɗechˈyamǝn, ndat wa, kǝmchansi kǝ chakmǝn ha tǝ faɗiya, kǝ chokmǝn ɓukwa tǝ Chinda ǝ hulafǝrta. <verse eid="2CO 5:8" /><verse number="9" style="v" sid="2CO 5:9" />Kǝthlǝm ndaˈan, yahtiyamǝn, kǝ sǝk tǝ mbǝndiyamǝn fa, ndu nggǝmǝn ǝ heshi hur faɗiya, ndu nggǝmǝn sǝ hur faɗan wa. <verse eid="2CO 5:9" /><verse number="10" style="v" sid="2CO 5:10" />Kǝthlǝm nwaat natˈmǝn kǝ thlarmǝn ha ǝ pangngǝn Kǝristi, kǝ chakamǝn tǝ mee. Kǝthlǝm chǝkawuni nan thlǝt kǝnau ǝnɗi chǝtǝn tǝ faɗi heshiɗiya, ndu kaɗan ndu sǝbtaˈan.<verse eid="2CO 5:10" /></para>
  <para style="s">Tar tahsandǝ pǝthlǝr nafchi kaɗ tǝ Farta</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 5:11" />Nakanya sǝn mǝn ǝnɗi nech kǝ lekandǝ Chinda, ndaˈan chicha natˈmǝn kweˈtǝ ha kǝ kaɓmǝn nafcha. Natˈyamǝn ha paɗ ǝ sǝn Farta, paɗ ɗǝfinchǝ kǝfatsǝ wa ǝ sǝn wun thleya ǝ hur wanɗǝkaɗechˈyowun. <verse eid="2CO 5:11" /><verse number="12" style="v" sid="2CO 5:12" />Ngga wa tǝ yah ǝn chǝm inchiyaˈan ǝ pangngǝn wun wa. Tǝnaˈan fǝrowun mban thlaˈ kirshi tǝ nggaˈan. Kun paɗ kǝ mbahan wun fǝran nggǝmndǝ fee nech thlaˈ kirshi kǝthlǝm maandiyanda, mǝni ǝnɗi nech hur wanɗǝkaɗechˈyanda. <verse eid="2CO 5:12" /><verse number="13" style="v" sid="2CO 5:13" />Tǝ tǝraˈanchi hwaˈarcha wa, kǝɗ ǝnɗi mbuˈtǝ fowun wa? Chǝka tǝ tǝraˈanchi hwaˈarcha, nechaˈan chǝta kǝthlǝm maanandǝ Farta. Maa ngga tǝ tǝraˈanchǝ hwaˈarcha wa, thleya kǝthlǝm kun. <verse eid="2CO 5:13" /><verse number="14" style="v" sid="2CO 5:14" />Yahraˈan i Kǝristi thlǝ nech parat har tǝ nggaˈan. Kǝthǝm ndaˈan sǝn ǝn hayan wa mǝr nef arta kǝthlǝm nafchǝ nat. Thleya pǝnchan wa nat mǝrchandǝ ɓukwa tǝ ndi. <verse eid="2CO 5:14" /><verse number="15" style="v" sid="2CO 5:15" />Mǝrchan kǝthlǝm chǝkawun nat, kǝthlǝm fee nech tǝ shishindǝ fa kǝ nandǝ haa kǝthlǝm indǝyanda wa. Kǝ nandǝ haa kǝthlǝm mǝthlan tǝɗi mǝrchi kǝ tanda, thlaˈan fee paɗ kǝthlǝm tanda. <verse eid="2CO 5:15" /><verse number="16" style="v" sid="2CO 5:16" />Kǝthlǝm ndaˈan, kǝ panˈnga naˈan nggǝr ɗǝpantǝ yowun kǝ ɓǝra sǝndi nefa wa. Chǝka mǝ nakan wa tam ǝn ɗǝpandǝ Kǝristi kǝ ɓǝra sǝndi nefa. Nakanya peˈwaˈan ɗǝpandǝ kǝɗu wa. <verse eid="2CO 5:16" /><verse number="17" style="v" sid="2CO 5:17" />Kǝthlǝm ndaˈan, nat nafɗi nech hur Kǝristi, chok chan kǝ yuwa nefa. Mbǝr ɗohtǝ ichǝ ha, ɓi yuwechaˈan. <verse eid="2CO 5:17" /><verse number="18" style="v" sid="2CO 5:18" />Nat ichiɗiya chǝti Farta, thla ɓech tahsandǝ pǝthlǝr mǝn kaɗ tǝ ndi tǝmɗi Kǝristi. Fǝramǝn kan tar tahsandǝ pǝthlǝr nafchǝ kaɗ tǝ ndi. <verse eid="2CO 5:18" /><verse number="19" style="v" sid="2CO 5:19" />Ndiktiyaˈan ndaˈan nech kǝ, thlǝ nech Farta tahsandǝ pǝthlǝr pong nafchǝ kaɗ tǝ ndi tǝmɗi Kǝristi. Shengnga wa ɓǝɓifechˈyandǝ kǝ ɗar nanda wa. Fǝramǝn kǝ Fartǝ heˈtǝ tar tahsandǝ pǝthlǝr nafchǝ kaɗ tǝ ndi. <verse eid="2CO 5:19" /><verse number="20" style="v" sid="2CO 5:20" />Kǝthlǝm ndaˈan nggǝmǝn nech kǝ fǝ thlǝnchi Kǝristi, kǝɗ Farta tǝ indiyan nech kaa nafcha tǝmɗi chǝt ter tǝ nggaˈan. Nggaˈan shiyowunda kǝ kwar Kǝristi, tahsaman pǝthlǝr wun kaɗ tǝ Farta. Kǝ chok wun kǝ atǝkrechiyan wa. <verse eid="2CO 5:20" /><verse number="21" style="v" sid="2CO 5:21" />Methlan tǝɗi tamwakchǝ chǝt ɓǝbifata, paɗ kǝthlǝm nggǝmǝn nggǝrandǝ Fartǝ kaɗ kǝɗ thlǝ ɓǝɓifata. Kǝthlǝm tǝmɗiyan mbǝstǝmǝn kaakǝti Farta.<verse eid="2CO 5:21" /></para>
  <chapter eid="2CO 5" />
  <chapter number="6" style="c" sid="2CO 6" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 6:1" />Nggaˈan chǝt ter ɓukwa tǝ Farta. Kǝthlǝm ndaˈan, nggaˈan shiyowunda hur kweˈtǝ ha, kaafaɗi Fartǝ thlǝtwunya kǝ chok pafǝn wa. <verse eid="2CO 6:1" /><verse number="2" style="v" sid="2CO 6:2" />Kǝthlǝm ndech Farta wa,</para>
  <para style="q1" vid="2CO 6:2">“Ə fartǝɗi nati pǝnowun kaafata, ǝ kowunchǝ thlǝmata,</para>
  <para style="q2" vid="2CO 6:2">paɗ fartǝ mbǝs hǝraˈta kǝsowunchisi.”</para>
  <para style="m" vid="2CO 6:2">Nggǝt mbuˈowunda nakanya nech kǝ fartǝ thlǝt kaafati Farta, paɗ nakanya nech kǝ fartǝ mbǝs hǝraˈta.<verse eid="2CO 6:2" /></para>
  <para style="s">Ɓahchi Bulus ha</para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 6:3" />Yahwaˈan teryaˈan kǝ chok kǝ ǝna ˈyarata wa. Kǝthlǝm ndaˈan, nggaˈan kweˈtǝ ha kǝ chok ǝn kǝ ɗakwan chǝt wansarti chǝkawun wa. <verse eid="2CO 6:3" /><verse number="4" style="v" sid="2CO 6:4" />Paɗaa nat ǝnɗi nat ǝn chǝta, thlǝ chichaˈan kǝthlǝm kǝ pǝnˈǝn wa nggaˈan fǝ chǝt teri Farta. Thlǝ chichaˈan kǝɗu hur kǝrǝsa, tǝ ngwarkwana, tǝ ɓahtǝ ha, tǝ mboro. <verse eid="2CO 6:4" /><verse number="5" style="v" sid="2CO 6:5" />Thlǝfaˈanchi fee, cham fee nggaˈan kǝ pursuna, mbǝsaˈan chǝndǝ mǝrinchǝ fa hur thlaˈ hur inda. Chǝˈǝn tera thla pǝɗanchǝ alkǝt ˈyaˈan ha, tǝ kumi ena, tǝ kumi ɗǝsǝmnda. <verse eid="2CO 6:5" /><verse number="6" style="v" sid="2CO 6:6" />Paɗ nggaˈan pǝn kittaˈan ˈyaˈan tǝmɗi chiɗ chiɗ tǝ wanɗǝkaɗata. Tǝ sǝnˈǝna, tǝ kǝrǝs ǝna, tǝ kaakǝta. Chichaˈan thleya kǝ pǝnˈǝn wa nggaˈan fǝ tarchi Farta tǝmɗi Shemeta thla chiɗ chiɗ, paɗ tǝ yahraˈan yi kit, <verse eid="2CO 6:6" /><verse number="7" style="v" sid="2CO 6:7" />tǝ ndik kit, tǝ alkǝti Farta. Kaa tarchǝɗi thlǝ chǝt ǝn, chok chan kǝɗen wa ǝna yaˈancha thla natmǝn laa ndǝ indiyamǝnsi ha. <verse eid="2CO 6:7" /><verse number="8" style="v" sid="2CO 6:8" />Fee fǝraˈan maanda, paɗ fee ɓahaˈan nda. Fee chǝm nggaˈan, paɗ fee sǝɓandǝ thlǝm ǝn kaɗi. Thlǝ ɗǝpaˈanchǝ fee kǝɗ fǝ lǝm nafcha, paɗ nggaˈan ngga fǝ lǝm nafchǝ nakaˈan wa. <verse eid="2CO 6:8" /><verse number="9" style="v" sid="2CO 6:9" />Thlǝ chaˈan chǝ fee kaɗ kǝɗ sǝnwu fee nggaˈan wa, paɗ ǝ sǝn fee nggaˈan kaan. Kǝɗ nechaˈan meˈi mǝrta, paɗ nggaˈan hur fǝ shishingǝncha. Fee ɓahaˈan ndǝ kaan, paɗ ɓǝlaˈanwu fee wa. <verse eid="2CO 6:9" /><verse number="10" style="v" sid="2CO 6:10" />Kǝɗ nggaˈan hur sǝbtǝ hwira, chǝka kǝɗu ween mǝta nggaˈan mbǝn fata. Kǝɗ fǝ ɓahcha, chǝka kǝɗu nggaˈan chandǝ nafchi kaɗ terchan kǝ wurumǝncha. Kǝɗ ǝnyaˈansiwa, paɗ chǝka mǝ nat yiˈǝn. <verse eid="2CO 6:10" /><verse number="11" style="v" sid="2CO 6:11" />Kun Korintiyawecha wuɓowun waˈan ǝna wa, paɗ pǝn ǝn wa nggaˈan yah wunchi kaan. <verse eid="2CO 6:11" /><verse number="12" style="v" sid="2CO 6:12" />Ngga nggaˈan karchǝ yah wunchǝ wa, kun karchǝ inandǝ wanɗǝkaɗechˈyowun ha kǝ yah wun nggaˈan. <verse eid="2CO 6:12" /><verse number="13" style="v" sid="2CO 6:13" />Ə ndiktǝɗiya, nggǝt ndiktǝ tǝ wunchi kǝɗ wanchinchi, kun paɗ kǝ pǝnaˈan chǝwun wa yah wun nggaˈan.<verse eid="2CO 6:13" /></para>
  <para style="s1">Kǝ wumawun indǝ tǝ fǝ kumi fǝr kitcha wa</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 6:14" />Kǝ wumawun indǝ tǝ fǝ kumi fǝr kitcha wa. Mǝ wumanchǝ kaakǝt ha tǝ ɓǝɓifata? Paɗ ndu mǝ wumanchǝ ɗaˈkǝt ha tǝ wuthla? <verse eid="2CO 6:14" /><verse number="15" style="v" sid="2CO 6:15" />Mǝ nech kǝ nggǝtkekti Kǝristi tǝ hweˈra? Paɗ mǝ wumanchi thlǝ fǝr kit ha tǝ thla thlǝ fǝr wakchǝ kit? <verse eid="2CO 6:15" /><verse number="16" style="v" sid="2CO 6:16" />Mǝ wumanchi fee thlǝ fǝrchǝ mananda Wiri Farta tǝ fee thlǝ fǝrchǝ maanda wurchi ɗǝhacha? Kǝthlǝm nggǝmǝn kǝtǝn shiti Farta thla tǝ shishingndǝ fa. Kǝɗ ǝnɗi nda Farta wa,</para>
  <para style="q1" vid="2CO 6:16">“Ni choktǝ tǝ tanda,</para>
  <para style="q2" vid="2CO 6:16">kǝ wiˈi pǝthlǝr nanda,</para>
  <para style="q1" vid="2CO 6:16">nii nat kǝ Fartǝ ˈyanda,</para>
  <para style="q2" vid="2CO 6:16">fen paɗ nandǝ nat kǝ nafchinchi.”<verse eid="2CO 6:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="2CO 6:17" />“Kǝthlǝm ndaˈan, ndech Fartǝ paɗ wa,</para>
  <para style="q1" vid="2CO 6:17">“Chemkesh hur nanda,</para>
  <para style="q2" vid="2CO 6:17">kǝ chaurawun indiyowun kesh hur nanda,</para>
  <para style="q4" vid="2CO 6:17">nda Chinda.”</para>
  <para style="q1" vid="2CO 6:17">Kǝ tǝkawun her tǝkǝmǝn ǝn fa wa,</para>
  <para style="q2" vid="2CO 6:17">ngǝt paɗ ni thlǝt wunchi,<verse eid="2CO 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="2CO 6:18" />nii chok kǝ chinda mǝɗˈyowun,</para>
  <para style="q2" vid="2CO 6:18">kun paɗ kǝ chok wun kǝ wanchinchi hǝssa tǝ nǝssa,</para>
  <para style="q4" vid="2CO 6:18">nda Chinda thlǝ maanda.<verse eid="2CO 6:18" /></para>
  <chapter eid="2CO 6" />
  <chapter number="7" style="c" sid="2CO 7" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 7:1" />Wanmanchǝna fee yahti, nakan chamǝn chǝ fee weˈtǝ ɗǝfmichǝɗiya, kǝ nggǝm mǝn fa kǝ tǝkman ǝn fechˈyamǝn kaɗ tǝ wanɗǝkaɗechˈyamǝn wa. Paɗ kǝ namǝn tǝ ndiiɗ chiɗ chiɗ kǝta hur lekandǝ Farta.<verse eid="2CO 7:1" /></para>
  <para style="s">Chǝ Bulus mbǝn fata kǝthlǝm ǝ tǝr nafchi Korintiyawech ha</para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 7:2" />Pǝnam wa yahwun nggaˈan, chawaˈan ǝn yowun wa, chǝwaˈan ǝnɗi nech ɗǝf yowun kǝ chǝt wansarta wa, ɗathlawaˈan yowun fa wa. <verse eid="2CO 7:2" /><verse number="3" style="v" sid="2CO 7:3" />Ngga ndikchi ǝnɗa kǝthlǝm kǝ ɗǝfowunchi ǝn kafa wa. Kǝɗ ǝnɗi mbuˈowundi, ǝnsi nech mbahǝn chakowun ndǝ ha tǝ yahtǝɗi yahtǝˈǝn wunchi wa, ndu nggaˈan hur fǝ shishingngǝn cha ndu nggaˈansi hur fǝ shishingngǝn cha wa, nggaˈan ɓukwa tǝ ngguwun. <verse eid="2CO 7:3" /><verse number="4" style="v" sid="2CO 7:4" />Fǝrinchǝ kit kǝ kun kaan, paɗ thlǝ nechi ɗǝf kǝfat kǝ kun kaan. Nat tǝ ɓahtǝɗi sat ǝn, nggǝt chǝt mbǝnfat kaan tǝ kit.<verse eid="2CO 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 7:5" />Thlaˈtǝ fartǝɗi saˈtǝ ǝn kǝ hahi Makidoniya, mbǝswaˈan yipta wa. Nat mǝɗi tǝɓǝrtǝ ǝn ha fee pataˈan nda. Tǝ heshi fee yan nggaˈan, tǝ hur wanɗǝkaɗechˈyaˈan paɗ ndiiɗaˈanchǝ lekǝt kaɗi. <verse eid="2CO 7:5" /><verse number="6" style="v" sid="2CO 7:6" />Paɗaa Farta thla thlǝ fǝranchi nafchiɗi sǝɓ tǝ hwirˈyandǝ kaɗ kǝrisa, fǝramǝntǝ kǝrisan tǝmɗi ɓati Titus. <verse eid="2CO 7:6" /><verse number="7" style="v" sid="2CO 7:7" />Ngga wa kǝthlǝm ɓat ˈyan ndak wa, paɗ tǝ sǝsi tǝɗi fǝrandǝwun. Mbaˈaˈanchi yahtǝɗi yahtǝwun naa nenchi kaan, paɗ mbaˈaˈanchǝ sǝɓtǝ hwirˈyowun kǝ ɗar ǝnɗi sǝɓcha, tǝ kweˈtǝ yowun ha kǝ parowun kǝrsi na. Ənɗa ɗǝfchǝ nenchǝs kǝ sǝki mbǝndǝf kaan.<verse eid="2CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 7:8" />Chǝka mǝ nakan wa ɗelwer tǝɗi yarowun ndisi sǝɓantǝ hwirˈyowun kaɗ kaan, haɗwanenchi hur wa. Chǝka mǝ nakan wa choh sǝɓani hwir kaɗi, kǝthlǝm kaɗinchǝ har ɗelwer tǝɗi yarowun ndisi sǝɓantǝ hwirˈyowun kaɗi, paɗ chǝka mǝ nakan wa yi wanshengngǝn chǝ ngguɗyeh. <verse eid="2CO 7:8" /><verse number="9" style="v" sid="2CO 7:9" />Nat tǝ kǝɗu, nakanya nggǝt mbǝn fata, ngga wa kǝthlǝm ǝnɗi ɗǝfti wunchi kǝ sǝɓtǝ hwira wa, paɗ kǝthlǝm sǝɓtǝ hwiryowun ɗǝftǝ wunchi kǝ tǝrwun ha, paɗ ɓeɗawun wanɗǝkaɗechˈyowun ha. Kǝthlǝm sǝɓawun hwir kaɗi, tǝɓǝrkowun ha kǝɗ ǝnɗi yahtǝ Farta. Kǝthlǝm ndaˈan, ɓahwowun ǝna kǝthlǝm nggaˈan wa. <verse eid="2CO 7:9" /><verse number="10" style="v" sid="2CO 7:10" />Sǝɓtǝ hurɗi thlǝ ɓech mǝɗi Farta thlǝ ɗǝfchan nef kǝ malanchi ɓǝɓifata, kǝ mbǝstǝ shishingndǝ kǝ kweˈkǝchi, paɗ ɓawa tǝ masǝnchi wa. Paɗ sǝɓtǝ hwira weˈtǝ yi heshi thlǝ ɓechan tǝ mǝrta. <verse eid="2CO 7:10" /><verse number="11" style="v" sid="2CO 7:11" />Ɗǝpaman ǝnɗi ɓowun ndǝ weˈtǝ sǝɓtǝ hurɗi ɓech mǝɗi Fartǝ ya. Ɗǝftǝ wunchǝs kwech kwech kǝ chǝwun ǝnɗi kǝmchǝsi, tǝ pǝnda wa sǝɓawun kaɗi. Ndaˈan ɗǝfchǝ wunchǝs kǝ kǝɗandǝ wanhera, paɗ chek kǝfatˈyowun. Ndaˈan chicha natˈwun kwech kwech kǝ nowun nggaˈan, paɗ ɗǝftǝ wunchǝs kǝnowun kweˈtǝ ha. Chicha natˈwun tǝ tahǝsfa kǝnowun chǝ fee chak miɗi kǝmchǝsi. Kǝ ɗar ndiktǝɗiya, kittaˈan pǝnwun chǝka tǝ yen mbenna sǝɓawowun kaɗ wa chǝk ngguɗyeh. <verse eid="2CO 7:11" /><verse number="12" style="v" sid="2CO 7:12" />Chǝka mǝ nakan wa yarowunchǝ ɗelwer tǝɗisi ngga kǝthlǝm thla sǝɓanchǝ kaɗ pǝthlǝr wun wa, paɗ ngga kǝthlǝm thla ɗathlandǝ fee fa wa. Yarechi kǝthlǝm kǝ pǝnowunchǝsi hayan wa ǝ sǝn Farta wa yah wun nggaˈan kaan. <verse eid="2CO 7:12" /><verse number="13" style="v" sid="2CO 7:13" />Kǝthlǝm ndaˈan chicha mbǝstǝˈǝn ɗǝkǝs fa hur wanɗǝkaɗechˈyaˈan.</para>
  <para style="p" vid="2CO 7:13">Kǝrsǝ ɗǝkǝsɗi mbǝstǝˈǝn hur wanɗǝkaɗechˈyaˈan, sǝkˈǝn mbǝndǝf kaan natˈǝn Titus hur chiɗ chiɗ tǝ wanɗǝkaɗata. Mbǝnanchi fa, kǝthlǝm natˈwun kǝsawunsi tǝ ɗǝkǝsɗi fǝ mbǝstǝn. <verse eid="2CO 7:13" /><verse number="14" style="v" sid="2CO 7:14" />Thlaˈinchǝ kirshi tǝ kun ǝ pangngǝɗan, paɗ hariwowun fata wa. Kǝɗ ǝnɗi natǝn, nat ǝnɗi mbuˈowun ndǝ ǝn kit, kǝɗu paɗ thlaˈ kirshi yaˈan kǝ ɗar wun ǝ pangngǝn Titus chok kǝ kit ǝ mǝɗyan. <verse eid="2CO 7:14" /><verse number="15" style="v" sid="2CO 7:15" />Yahtǝɗi yahtǝ Titus wunchi mǝthlan chektǝ kaan, maa kuɗuktǝ mbanɗi thlǝ natwun para ndiktiyan nat, paɗ tǝ weˈtǝ fǝr maanɗi pǝnandǝ wun fartǝɗi thlǝt wun ndi. <verse eid="2CO 7:15" /><verse number="16" style="v" sid="2CO 7:16" />Nggǝt mbǝn fat kǝthlǝm nii mbahan fǝr kit kǝ wunchi hur chǝka mǝ nat.<verse eid="2CO 7:16" /></para>
  <chapter eid="2CO 7" />
  <chapter number="8" style="c" sid="2CO 8" />
  <para style="s">Fǝr ǝna tǝ yahta</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 8:1" />Nakanya paɗ, wanmanchina, yahˈǝn kǝ sǝn wun ǝnɗi chǝt kafati Farta ǝ hur nafcha fǝ fǝr kit fee nech ǝ Makidoniya. <verse eid="2CO 8:1" /><verse number="2" style="v" sid="2CO 8:2" />Kǝthlǝm ɓahndǝ ha kaan tǝ nggwar kwana tǝɗi yim ndǝ ndǝsi, chicha tertǝ mbǝn fatˈyanda ɗǝftǝ tandǝ kǝ chǝt kakǝta yi fǝr pafǝn kaan kǝmɗi fowuna, chǝka mǝ nakan wa tandǝ hur pongngǝn ɓahtǝ kaan. <verse eid="2CO 8:2" /><verse number="3" style="v" sid="2CO 8:3" />Kǝthlǝm fǝrinchǝ kit si fǝrchandǝ ɓǝra ǝnɗi nessiyanda, thla pǝɗanchǝ alkǝt ˈyandǝ ha. Fǝrchandǝ paɗ tǝ yahtǝ yanda, ngga tǝ kweˈyan fee tandǝ kafa wa. <verse eid="2CO 8:3" /><verse number="4" style="v" sid="2CO 8:4" />Shiyaˈan chǝndǝ kaan, kǝ nggǝman fee tandǝsi, fen paɗ kǝ fǝrndǝ pafǝn, kǝmɗi fǝ para Farta fee nawaktǝ ǝn ˈyandǝsi. <verse eid="2CO 8:4" /><verse number="5" style="v" sid="2CO 8:5" />Paɗ fǝrchandǝ pafǝn ˈyandǝ kaan pǝɗantǝ ǝnɗi ha saktǝ ǝn. Tǝrkwathl kanan fǝrndǝ indiyandǝ kǝmɗi Chinda Yesu, thlaˈtǝ minni paɗ fǝr kandǝ indiyandǝ kǝmɗi yaˈan, tǝ yahti Farta. <verse eid="2CO 8:5" /><verse number="6" style="v" sid="2CO 8:6" />Nakaˈan kǝɗu, shiyan kaˈan Titus kǝ ɗǝ kǝ pangnga tǝ tar nggomandǝ fǝr kǝnau pafǝn yi yahti wanɗǝkaɗata, nakan mǝthlan nggakcha. <verse eid="2CO 8:6" /><verse number="7" style="v" sid="2CO 8:7" />Hur chǝka mii kun nech pangnga, ndu tǝ fǝr kit ˈyowun hur Kǝristi, ndu hur ndikta, ndu hur sǝn kit, ndu hur yah kǝsandǝ nafchǝsi, tǝ paɗ yahtǝɗi thlǝ pǝnaˈan ndǝ wun, thla nggaˈan thlaˈanchǝ hur wun. Kǝthlǝm ndaˈan, yahchaˈansi kun paɗ kǝɗuwun kǝ pangnga hur tar kafata yi fǝr pafǝn tǝɗa.<verse eid="2CO 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 8:8" />Ngga kusiˈ nati fǝrowun ndǝ kǝ ɓǝra ndiktǝɗa wa. Paɗ tǝni yah kaɗandǝ kit tǝ yahraˈan ˈyowun, tǝmɗi kaɗandǝ tǝ kweˈti fowun na. <verse eid="2CO 8:8" /><verse number="9" style="v" sid="2CO 8:9" />Kǝthlǝm sǝnwun kaakǝti Chinmǝn Yesu Kǝristi. Chǝka mǝnakan wurumndǝ nakan, nat tǝ kǝɗu chok kǝ thlǝ ɓahta kǝthlǝm kun. Kǝthlǝm tǝmɗi ɓahtiyan kǝ mbǝswun chǝka mii ǝ mǝɗi Farta.<verse eid="2CO 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 8:10" />Nii mbuˈowun ǝnɗi kǝmchisi kǝ ɗar ndiktǝɗa, nan nat ndiˈchan kǝ tǝɓawun ǝnɗi ha tǝrtǝwun kanan ǝ huraɗi mbǝrchǝ ha yu, ngga wa tǝ fǝr wun ndak wa, auwa, paɗ fǝrchowun kǝthlǝm tǝ yahwun fǝrta. <verse eid="2CO 8:10" /><verse number="11" style="v" sid="2CO 8:11" />Nakanya tǝɓaman taran ha tǝ weˈtǝ wanɗǝkaɗaɗi nggaktǝwunsi. Kǝnowun kwech kwech tǝ tǝɓanan kǝɗ ǝnɗi natˈwun kwech kwech tǝrkanan. Cham kǝɗu keˈke tǝ ǝnɗi nessiyowun. <verse eid="2CO 8:11" /><verse number="12" style="v" sid="2CO 8:12" />Maa wanɗǝkaɗa fǝrtǝ yowunsi, fǝr pafǝn ˈyowun nan mbǝnandǝ Fartǝ fa, maa fǝr wun keˈke tǝ ǝnɗi nessiyowun. Yahwu Farta kǝ fǝrwun ǝnɗi saˈwaktǝ alkǝt ˈyowun wa.<verse eid="2CO 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 8:13" />Ngga wa tǝni yah fǝran fowun ǝnɗi nech paˈpa, paɗ kǝ fǝrowunchi thla nech ˈyangˈyang wa. Paɗ keˈkesi kǝ kǝsawun fee nawaktǝn ˈyandǝsi. <verse eid="2CO 8:13" /><verse number="14" style="v" sid="2CO 8:14" />Paɗaa tertǝ ǝnɗi ˈyowun nessi kǝ kǝsanchǝ fee nawaktǝn ˈyandǝsi. Kun paɗ fartǝɗi nawaktǝn ˈyowunsi, fen paɗ neˈsiyanda kǝsowun kandǝsi. Tǝ kǝɗu chǝka mǝ nan nat keˈke. <verse eid="2CO 8:14" /><verse number="15" style="v" sid="2CO 8:15" />Kǝɗ ǝnɗi yarandǝ fee ha hur ndikti Farta, “Thla nggomanchǝ ha kaan, cha wa fǝ manchan wa, thla nggomchǝ nggudyeh paɗ, cha wa fǝ ngguɗyeh wa.”<verse eid="2CO 8:15" /></para>
  <para style="s">Thlǝn fee Titus kǝ Korinti kǝthlǝm kǝ thlǝt kǝnau pafǝn ˈyanda</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 8:16" />Chaˈǝn usoko Farta, ɗǝftǝn kǝ wanɗǝkaɗati Titus, kǝ tǝrtǝ heˈtǝ kǝsowundǝsi, kǝɗ ǝnɗi ɗǝftǝn kǝ hur wanɗǝkaɗatinchi. <verse eid="2CO 8:16" /><verse number="17" style="v" sid="2CO 8:17" />Ngga wa ɗichan kǝmɗowun kǝthlǝm ǝnɗi shiyandǝˈǝn wa, paɗ ɓechan kǝɗ ǝnɗi tapatǝn kǝ tǝr hur wanɗǝkaɗatˈyan wa nan ɓata. <verse eid="2CO 8:17" /><verse number="18" style="v" sid="2CO 8:18" />Nama thlǝn ǝn wanman ǝn ɓukwa tǝɗi, mǝthlan tǝɗi thlǝ manandǝ fǝ fǝr kit cha hur kǝtǝn shicha, kǝthlǝm terˈyan yi ɓas kwastǝ ndikta thla mbinchan yi sǝkta. <verse eid="2CO 8:18" /><verse number="19" style="v" sid="2CO 8:19" />Kǝrsǝ ndaˈan, nafcha fǝ fǝr kit chiɗi hur kǝtǝn shita, taɗndǝ ndi kǝ wiˈ ɓukwa tǝ nggaˈan. Maa nggaˈan chak kǝnau pafǝn tǝɗiya, kǝthlǝm manandǝ Chinda. Kǝ pǝn ǝn paɗ wa nggaˈan kwech kwech kǝ kǝsaˈǝn tandǝsi. <verse eid="2CO 8:19" /><verse number="20" style="v" sid="2CO 8:20" />Tǝ naˈan rakandǝ ndat wa kǝ sǝɓan yowun thlǝm ǝn kaɗ wa, kǝ ɓǝra chak kǝnau pafǝn tǝɗi fǝr tǝ fee her chaˈ ya. <verse eid="2CO 8:20" /><verse number="21" style="v" sid="2CO 8:21" />Yah tiyaˈan kǝ chǝˈǝn ǝnɗi nech keˈke, ngga wa ǝ pangngǝn Chindǝ ndak wa, paɗ nat tǝ pangngǝn nafcha.<verse eid="2CO 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CO 8:22" />Nggaˈan paɗ thlǝn yowun wanmanˈǝn ɓukwa tǝ tanda. Wanmanˈǝn tǝɗi kurɓaɗǝ ǝn kaaɗa nda, niˈǝn paɗ thlǝ kweˈchan ha kaan, kǝ ɓǝra ichǝ samǝn samǝn. Nakanya fǝrkan kit kǝ kunya, mǝthlan kwech kwech kǝthlǝm kǝ ɓǝ kǝsowun ndǝsi. <verse eid="2CO 8:22" /><verse number="23" style="v" sid="2CO 8:23" />Kǝ ɓǝra Titus, nefinchi paɗ mǝthlan shiketǝ terinchi kǝthlǝm kun. Kǝ ɗar wanmanchǝˈǝn tǝɗi nech ɓukwa tanda, nafchi fǝ fǝr kit cha thlǝnchǝ tanda. Ter ˈyandǝ thlǝ ɓechan tǝ maanda kǝmɗi Kǝristi. <verse eid="2CO 8:23" /><verse number="24" style="v" sid="2CO 8:24" />Kǝthlǝm ndaˈan, pǝnamandǝn nafchǝɗa wa thlǝ yahchowun raˈan. Paɗ kǝ pǝnawun tandǝ ǝnɗi chich thlǝ natˈǝn thlaˈ kirshi tǝ kun. Kǝthlǝm kǝ sǝn nafchǝ fǝ fǝr kitcha wa, thlaˈ kǝrǝsɗi thlǝ natˈǝn chǝt kǝ ɗar indiyowun yi kit.<verse eid="2CO 8:24" /></para>
  <chapter eid="2CO 8" />
  <chapter number="9" style="c" sid="2CO 9" />
  <para style="s">Kǝsandǝ fee si nech Chiɗ Chiɗ ǝ Urshelima</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 9:1" />Ngga nwaat kǝ yarowunchisi kǝ ɗar kǝsandǝ fee si nech chiɗ chiɗ wa. <verse eid="2CO 9:1" /><verse number="2" style="v" sid="2CO 9:2" />Kǝthlǝm sǝninchi kweˈtǝ yowun ha kǝ kǝsanwun fee si nech chiɗ chiɗ. Kǝthlǝm ndaˈan nggǝt chǝt thlaˈ kirsha tǝ kun ǝ mǝɗi nafchi Makidoniya. Nggǝt mbuˈandǝ tanda wa, kun nafchi Akaya tahǝs wun fa ǝ huraɗi mbǝrchǝ ha yu, kǝthlǝm chǝt kǝɗu. Weˈtǝ kweˈtǝɗi ha nessowun, ndaˈan chicha tertǝ nafchiɗa thlaˈ tǝ ndǝ kit. <verse eid="2CO 9:2" /><verse number="3" style="v" sid="2CO 9:3" />Nakan paɗ ya, nggǝt thlǝn wanmanchǝmǝn, kǝthlǝm kǝ chok thlaˈkǝrshaˈan thla thlǝ chǝtˈǝn kǝ kun ǝ hur tar ɗiya, kǝ chok kǝ ndiktǝ pafǝn kǝt tǝ kwahoɗan wa. Paɗ yah chi kǝ chokwun tǝ tahǝs fa, kǝɗ thla mbuˈti. <verse eid="2CO 9:3" /><verse number="4" style="v" sid="2CO 9:4" />Kǝthlǝm maa ɓinchi ɓukwa tǝ fowun fǝ fǝr kit cha thlaˈ tǝ Makiɗoniya, yah wisi kǝ ɓandǝ mbǝsandǝ tahsawowun kǝnau pafǝn ˈyowun ha wa. Maa shiɓ kǝɗu, ni sǝk hartǝ fata kǝthlǝm tertǝ thlaˈ kǝrǝsɗi chǝti tǝ kun, ngga nggǝt ichǝt na nech sǝk hartǝ fata wa, hartǝ faɗi natˈwun sǝkta sǝrtaˈansi wa. <verse eid="2CO 9:4" /><verse number="5" style="v" sid="2CO 9:5" />Kǝthlǝm ndaˈan, ndǝpani ndiˈchansi kǝ shiyani wanmanchǝmǝn kǝ ɓandǝ kwaɗǝn kǝni ɓata, kǝ tǝɓandǝ nggomandǝ ichiɗi ɗǝftuwun miyan wa nowun fǝrta, kǝthlǝm kǝ mbǝsan fee tandǝ ɗǝktǝr. Theya nech pǝnda wa, tǝ yahti wanɗǝkaɗechˈyowun fǝrtuwun, ngga tǝ kweˈ fee wunchi wa.<verse eid="2CO 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 9:6" />Kuɗukama, nafɗi hǝfcha weˈtǝ ngguɗyeh, nechan mbǝs ɗǝsǝmndǝ ngguɗyeh. Paɗaa nafɗi hǝfchǝ weˈtǝ manchan, nan mbǝs ɗǝsǝmndǝ manchan. <verse eid="2CO 9:6" /><verse number="7" style="v" sid="2CO 9:7" />Chǝka wuni kǝ fǝr kǝɗ ǝnɗi tahsandǝ ha hur wanɗǝkadatˈyan, ngga tǝ sǝɓtǝ hwira ndu nwaat wa. Kǝthlǝm Farta thlǝ sǝkchan mbǝn nafɗi fa thlǝ fǝrchǝ tǝ wanɗǝkaɗat arta. <verse eid="2CO 9:7" /><verse number="8" style="v" sid="2CO 9:8" />Thlǝ mbahanchǝ Farta fǝrowun mbǝsˈǝn har, kǝ mbǝrantǝ thla ha yahtuwun. Kǝthlǝm chǝka kwati thlǝ mbǝs chowun ǝnɗi thlǝ yahtuwun. Kǝ mbǝrantǝ ǝnɗi ha kaɗatwun. Kǝ mbahan wun fǝrtǝ her chaˈ. <verse eid="2CO 9:8" /><verse number="9" style="v" sid="2CO 9:9" />Kǝɗ ǝnɗi natin kǝ ˈyaradan hur ndikti Farta wa,</para>
  <para style="q1" vid="2CO 9:9">“Thlǝ fǝranchan fǝ ɓahcha her chaˈ.</para>
  <para style="q2" vid="2CO 9:9">Kaakǝtˈyan wathlandech ha kǝ kweˈkǝchi.”<verse eid="2CO 9:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="2CO 9:10" />Fartǝ thlǝ fǝranchǝ thlǝ chehtǝ weˈta kǝ hǝfa, paɗ kǝ fǝranchǝ ɗǝsǝmnda. Nan fǝrowun weˈtǝɗi natwun hǝfta, mathlan paɗ nech ɗǝf weˈtaˈan kǝ tasǝr ha. Tǝ kǝɗu, natǝn ɗǝf fǝr kǝnau pafǝn tǝɗi ˈyowun yi yahti wanɗǝkaɗata kǝ chekowunchi mbǝsˈǝn har yi tarchowun tǝ kaakǝta. <verse eid="2CO 9:10" /><verse number="11" style="v" sid="2CO 9:11" />Chǝkakwati nan kǝ sowunɗǝsi hur chǝka mii, kǝthlǝm kǝ chok wun kǝ fǝ fǝr pafǝn tǝ yahti wanɗǝkaɗata ween mǝta. Tǝ kǝɗu, naa nafchǝ terchan chit usoko kǝmɗi Farata kǝthlǝm pafǝnchǝɗi natwun thlǝnandata tǝmɗi yaˈan.<verse eid="2CO 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 9:12" />Kǝthlǝm tar kaakǝtɗi thlǝ chit wunya, ngga ti ɗakchi fǝ chiɗ chiɗ kǝɗ ndak thlǝ chǝtǝn wa, paɗ thlǝ ɗǝfchan usoko tǝɗi thlǝ chandǝ fee Farta kǝ cheka. <verse eid="2CO 9:12" /><verse number="13" style="v" sid="2CO 9:13" />Kǝthlǝm tar kaakǝtɗi thlǝ chǝtwun ndaˈan pǝnchǝ fǝr kit ˈyowun. Fowun nafchǝ paɗ nandǝ maanandǝ Farta kǝthlǝm nggǝmawun kwastǝ ndikta thla mbinchan yi sǝkta yi Kǝristi. Paɗ kǝthlǝm kǝnau pafǝn tǝɗi chǝtwun her chaˈ kǝmɗi takǝɗ nafchǝ nat. <verse eid="2CO 9:13" /><verse number="14" style="v" sid="2CO 9:14" />Fen paɗ nandǝ naa shiyowundǝsi, kǝ nandǝ kuɗuktǝ tǝ wunchi ǝ wanɗǝkaɗechˈyanda. Kǝthlǝm kaafaɗi fǝrowundǝ Farta thla nawaktǝ sǝrtaˈan si. <verse eid="2CO 9:14" /><verse number="15" style="v" sid="2CO 9:15" />Chaman usoko Farta, kǝthlǝm kǝnau pafǝn tǝɗi fǝramǝn ndǝn ya. Kǝnau pafǝntǝɗi nawaktǝ fee kaaɗa nda.<verse eid="2CO 9:15" /></para>
  <chapter eid="2CO 9" />
  <chapter number="10" style="c" sid="2CO 10" />
  <para style="s">Chapan Bulus indiyan kaɗ ɗar terˈyan</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 10:1" />Nggǝt Bulus tǝ indinchi, thlǝ paˈpaˈ tǝ hur inda, tǝ thlǝ kǝsandǝ inda kǝɗ Kǝristi, nggǝt shiyowun nda. Nggǝtiɗi thlǝ nda fee wa, “Thlǝ hartǝfata,” maa ngǝt thlǝmatwun, paɗ maa ngǝt langnga thlǝ nechi ndiktǝ tǝ alkǝt fa kǝmɗowun. <verse eid="2CO 10:1" /><verse number="2" style="v" sid="2CO 10:2" />Nggǝt shiyowunda, mǝ kweˈwun nenchi kǝ ɗahowunchi in kǝɗ ǝnɗi ɗǝfti wanɗǝkaɗat su wa nii ɗahandǝ nafchiɗi thlǝ ndech wa, natˈyaˈan ha weˈtǝ yi heshi ndak wa. <verse eid="2CO 10:2" /><verse number="3" style="v" sid="2CO 10:3" />Chǝka nakan nechaˈan wiˈtǝ hur fata, yandi yaˈan ngga weˈtǝ yi heshi wa. <verse eid="2CO 10:3" /><verse number="4" style="v" sid="2CO 10:4" />Kǝthlǝm ǝna yaanchiɗi nessiyaˈan ngga i heshi wa, paɗ i alkǝti Farta. Fee naa alkǝt ˈyandǝsi kǝ ɓilanchi ǝna yaanchi hweˈrǝ kaɗi. <verse eid="2CO 10:4" /><verse number="5" style="v" sid="2CO 10:5" />Thlǝ pǝkanchaˈan fǝ as incha ha, thlǝ tutokanchaˈan nat ǝnɗi nech yata sǝn Farta, paɗ thlǝ nggǝrang chaˈan chǝka yen kaɗat ha kǝthlǝm kǝ para ndikti Kǝristi. <verse eid="2CO 10:5" /><verse number="6" style="v" sid="2CO 10:6" />Tahisˈǝnfa kǝ chakaˈǝn mee fǝ tar kumthlǝmecha, maa tapi ndiiɗ fǝr mandiyowun ha kǝmɗi Kǝristi.<verse eid="2CO 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 10:7" />Ɗǝpanman ǝnɗi thlǝ natwun tǝ wenita, maa wathlanchǝ yowun ha wa methlan i Kǝristi, kǝ kuɗuka wa kǝɗ ǝnɗi natǝn kǝ i Kǝristi, nggaˈan paɗ kǝɗu. <verse eid="2CO 10:7" /><verse number="8" style="v" sid="2CO 10:8" />Chǝka mǝ ndǝ fee wa nggǝt thlaˈ indǝ kaan tǝ alkǝtɗi fǝraˈandǝ Farta ya, nǝ fat harichi wa, fǝraˈanchi Farta alkǝtɗiya kǝthlǝm kǝ tǝnowunchi ǝn, ngga tutokowun ndǝ ha wa. <verse eid="2CO 10:8" /><verse number="9" style="v" sid="2CO 10:9" />Yahwesi kǝ tǝrwun wa tǝ ni yah kwarowunndǝ tǝ ɗelwer chin chǝ wa. <verse eid="2CO 10:9" /><verse number="10" style="v" sid="2CO 10:10" />Kǝthlǝm thlǝ ndech fowun wa, “Ɗelwer chiyan lǝk lǝk nda, paɗ tǝ alkǝt fa, paɗaa maa mǝthlan thlǝmat ǝn tǝ indiyan, mǝthlan ngga thlǝ ndiktǝ tǝ alkǝt fa wa, paɗ ndiktiyan ngga ǝna wa.” <verse eid="2CO 10:10" /><verse number="11" style="v" sid="2CO 10:11" />Weˈtǝ nafchi ini kǝ sǝn nda wa, ǝnɗi thlǝ nbuˈtǝ ǝn hur ɗelwer chiyaˈan fartǝɗi nawaktǝ ǝnsi, ndaˈan thlǝ chǝtˈǝn fartǝɗi nat ǝnsi.<verse eid="2CO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 10:12" />Chaˈwaˈansi kǝ kaɗaˈǝn inchiyaˈan tǝ fee thlǝ chimchǝ inchiyanda wa. Kǝthlǝm weˈtǝ nafchi ini thlǝ nechandǝ kaɗandǝ inchandǝ tǝ raˈan, paɗ kǝ tǝrndǝ inchiyandǝ kǝɗ raˈan, sǝn ǝn ˈyandǝs wa. <verse eid="2CO 10:12" /><verse number="13" style="v" sid="2CO 10:13" />Paɗaa nggaˈan naˈǝn thlaˈ kirsha kǝ mbǝranchǝ hǝnggǝ ha tǝ weˈta wa, nechaˈan thlar tǝ ha kǝ ɓǝra sǝrtǝ mǝɗi thleˈen ndǝ Fartǝsi. Sǝrtaˈan tǝɗa wumchan ha nat tǝ kun. <verse eid="2CO 10:13" /><verse number="14" style="v" sid="2CO 10:14" />Kǝthlǝm, thlaˈ kirshiyaˈan mbǝra wa hǝngngǝ ha tǝ weˈta wa. Mǝ naa fee ndat wa mbǝraˈǝn hǝnggǝ ha weˈta manngga ǝnɗi ɓakaˈan kǝmɗiyowun wa, kǝthlǝm nggaˈan ɓech kǝmɗiyowun tǝ kwastǝ ndikta thla mbinchan i sǝkta i Kǝristi. <verse eid="2CO 10:14" /><verse number="15" style="v" sid="2CO 10:15" />Thlaˈ kirshiyaˈan pǝɗawa mǝɗi ha natˈǝn wa, paɗ mbǝn wa teri fowun fa wa. Paɗaa ɗǝf kǝfatˈyaˈan, fǝr kit ˈyowun nan naa chekta. Paɗ teryaˈan hurwun nan naa chektǝ kaan tǝ kit fa. <verse eid="2CO 10:15" /><verse number="16" style="v" sid="2CO 10:16" />Kǝthlǝm kǝ mbahan ǝn ɓas kwastǝ ndikta thla mbinchan yi sǝkta ǝ hahichiɗi pangngǝn wun. Ngga tǝ kaa thlima ǝ ɗar teri yowun thla tapatǝn kǝ cha ǝ mǝɗi ɗǝftǝ fee ndǝs wa. <verse eid="2CO 10:16" /><verse number="17" style="v" sid="2CO 10:17" />Paɗaa kǝɗ ǝnɗi mbuˈtǝ yara Ndikti Farta, “Nat thla nech thlaˈ kirsha, kǝ thlaˈtǝ kirsha tǝ ǝnɗi chǝt Chinda.” <verse eid="2CO 10:17" /><verse number="18" style="v" sid="2CO 10:18" />Kǝthlǝm ngga nafɗi thlǝ chimchi indiyan thlǝ fǝrtǝ Farta kit kǝ ndǝ wa. Paɗ thla chimndǝ Chinda Yesu, mǝthlan thlǝ fǝr tǝ Farta kit kǝ ndi.<verse eid="2CO 10:18" /></para>
  <chapter eid="2CO 10" />
  <chapter number="11" style="c" sid="2CO 11" />
  <para style="s">Bulus tǝ tatǝ kǝmsichǝ kǝ fǝ lekcha</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 11:1" />Saktinchi nowun kǝrǝs nenchi tǝ ɓamkǝtɗi nati chǝta. Nggǝt shiyowunda kǝ kǝrǝswun tǝ nenchi. <verse eid="2CO 11:1" /><verse number="2" style="v" sid="2CO 11:2" />Nggǝt sǝraˈta kǝthlǝm kun, kǝɗ ǝnɗi thlǝ sǝraˈtǝ Farta kǝthlǝm kun. Kun nechowun kǝɗ perra thla sǝnwakchǝ hisnefa. Thla ɗǝfti mee nii fǝrwunchi kǝmɗi Kǝristi, kǝ chok kǝ chǝmatwun mǝthlan ichiɗan. <verse eid="2CO 11:2" /><verse number="3" style="v" sid="2CO 11:3" />Paɗaa nggǝt lekǝta, kǝ chok ǝnɗi sǝɓchǝ tǝ Hauwawu yu, kǝ kǝstǝ wunchi wa. Lǝm wirɓǝ ndi tǝ ɗathliyan chicha chǝtǝn ɓǝɓifata. Kǝɗu kun paɗ, kǝ sakan fee hur inchiyowun kǝ malawun fǝr kit yi kit, tǝ fǝr indiyown kǝmɗi Kǝristi wa. <verse eid="2CO 11:3" /><verse number="4" style="v" sid="2CO 11:4" />Kǝthlǝm maa ɓi yowun ɓasowun yowun Kǝristi si samǝn tǝ thla ɓasowundǝ ǝnsi. Ndu maa thlǝwun shemet samǝn tǝ thla thlǝtwun ǝ mǝɗyaˈan, ndu ɓas kwastǝ ndikta thla mbinchan yi sǝkta samǝn tǝ thla thlǝtwun mǝɗyaˈan. Pǝnchan wa nggǝmawun tandǝ hur paˈpaˈ tǝ inda.<verse eid="2CO 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 11:5" />Paɗaa ǝnatinchi fenni thlǝ ndat wun wa, “Fen tatǝ kǝmsicha thla yowunsi kǝɗ tanda wa,” pǝɗiwandǝ ha tǝ ǝna wa. <verse eid="2CO 11:5" /><verse number="6" style="v" sid="2CO 11:6" />Chǝk mǝ nawaki kǝ thlǝ mbǝr ndiktǝ kǝɗ tanda, paɗaa sǝn ǝninchisi. Paɗ pǝnowunchǝ ǝn hayan chǝk tǝ yen mbenna, ǝ hur natˈyaˈan ha nat tǝ kun. <verse eid="2CO 11:6" /><verse number="7" style="v" sid="2CO 11:7" />Awi ɓǝɓifat chǝti manawakti indinchi kǝthlǝm kǝ manowunchi fee wa? Ndat wa, kǝthlǝm kǝɗ ɗinchi ɓasowun ndikti Fartǝs pafǝn wa? <verse eid="2CO 11:7" /><verse number="8" style="v" sid="2CO 11:8" />Chokchan kǝɗ tǝ thlǝnani ichi fowun fǝ fǝr kitcha tǝ alkǝta, tǝmɗi thlǝt kǝnau pafǝn ǝ mǝɗˈyanda, kǝthlǝm kǝ chowunchi tera. <verse eid="2CO 11:8" /><verse number="9" style="v" sid="2CO 11:9" />Fartidi nati mǝdyowun, ɗaktinchisi, nat tǝ kǝɗu ɗahowonwi in wa. Wanmanchina fǝ fǝr kit cha fee ɓech thlaˈtǝ Makidoniya fen ɓichǝ ǝnɗi nat yahti. Ɗǝfowunwi heˈtǝ ǝ chǝka yen mbenna wa, paɗ nechi ɗǝt kǝ pang tǝ chǝt kǝɗu. <verse eid="2CO 11:9" /><verse number="10" style="v" sid="2CO 11:10" />Asˈindǝs wa kǝɗ ǝnɗi naa kit i Keristi wanɗǝkaɗatinchi, nefsǝ hur hahi Akaya nech ˈyati thlaˈ kirsha wa. <verse eid="2CO 11:10" /><verse number="11" style="v" sid="2CO 11:11" />Kǝthlǝm mǝ nati mbuˈtǝ kǝɗu? Kǝthlǝm yahwakni wunchi wa? Sǝn Farta wa yahinchi wunchi.<verse eid="2CO 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 11:12" />Paɗ nii ɗǝt kǝ pangnga tǝ ǝnɗi thlǝ chiti, maˈni ˈyatan nafchiɗi thlǝ nech thlaˈandǝ kirsha, ndat wa tarɗi thlǝ chǝt ǝn, ǝn artǝ tǝ yinanda. <verse eid="2CO 11:12" /><verse number="13" style="v" sid="2CO 11:13" />Kǝthlǝm weˈti nafchǝˈini tatǝ kǝmsichǝ fǝ lekcha, tǝ fǝ lǝm nafcha. Thlǝ tahsan chandǝ fatyandǝ ha kǝɗ tatǝ kǝmsichi Kǝristi. <verse eid="2CO 11:13" /><verse number="14" style="v" sid="2CO 11:14" />Ngga ǝna saka inda wa, kǝthlǝm chǝka hweˈra thlǝ chanchan indiyan kaɗ kǝɗ thlǝ thlǝndi ɗaˈkǝta. <verse eid="2CO 11:14" /><verse number="15" style="v" sid="2CO 11:15" />Kǝthlǝm ndaˈan, ngga ǝna saka inda wa, maa chǝ mafechi hweˈrǝ kaɗ kǝɗ mafechi kaakǝta. Ə ndukwaɗan nandǝ mbǝs kǝnau terˈyanda keˈke tǝ ǝnɗi chǝt nda.<verse eid="2CO 11:15" /></para>
  <para style="s">Ɓahtǝɗi saa Bulus kǝthlǝm mǝthlan tatǝ kimsha i Kǝristi</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 11:16" />Nggǝt nggǝr mbuˈta wa, mǝ kaɗ yowun wa ɓem naki wa. Paɗ maa tǝrwun nenchi kǝɗu, tǝram nenchi kǝɗ ɓema, kǝthlǝm nggǝt paɗ kǝ mbǝsi mban thlaˈ kirsha. <verse eid="2CO 11:16" /><verse number="17" style="v" sid="2CO 11:17" />Weˈtǝ thlaˈ kǝrǝsɗi thlǝ chiti ya, ngga nechi ndikta ǝ mbanɗi yahtǝ Chinda kǝ mbuˈi wa. Auwa, ǝ ɗar ndiktǝɗiya, thlǝ nechi thlaˈ kirsha kǝɗ ɓema. <verse eid="2CO 11:17" /><verse number="18" style="v" sid="2CO 11:18" />Nakan nafchǝ terchan thlǝ nechandǝ thlaˈ kirsha kǝɗ weˈtǝ yi heshi, nggǝt paɗ kǝɗu nati chǝta. <verse eid="2CO 11:18" /><verse number="19" style="v" sid="2CO 11:19" />Kun paɗ tǝnowun ɗathlchan kaan hacha wa, tǝ mbǝnfata thlǝ kǝrǝs tǝwun ɓamcha wa? <verse eid="2CO 11:19" /><verse number="20" style="v" sid="2CO 11:20" />Kǝthlǝm maa ɗǝf yowun wunchǝ kǝ chǝka yen mafakǝta, thlǝ mbahan chowun kǝrǝs ndi. Ndu tǝ thlǝnowunchǝ ǝn har, ndu tǝ pǝpeh tǝ wunchǝ har, ndu tǝ pǝnowunchǝ wa cheˈsi, ndu tǝ mbalatǝ wunchǝ ǝ chǝmanda. <verse eid="2CO 11:20" /><verse number="21" style="v" sid="2CO 11:21" />Nggǝt thlǝ kǝsichǝ hartǝ fata kǝ nggǝmani wa, kǝthlǝm kumi alkǝtˈyamǝn, mbahan waktǝmǝn chǝt ichiɗiya.</para>
  <para style="p" vid="2CO 11:21">Paɗaa maa tǝran yowun fata thlaˈtǝ kirshi kǝ ɗar ǝna yowun, nggǝt paɗ nii tǝrandǝ fata kǝchi kǝɗu. Ə mǝɗya nechi ndiktǝ kǝɗ ɓema. <verse eid="2CO 11:21" /><verse number="22" style="v" sid="2CO 11:22" />Maa fen Yahudawecha, nggǝt paɗ kǝdu. Maa Israilawecha, nggǝt paɗ kǝdu. Maa fen kwathl Ibrahim nakanda, nggǝt paɗ kǝdu. <verse eid="2CO 11:22" /><verse number="23" style="v" sid="2CO 11:23" />Maa thlǝ nechandǝ thlaˈ kirsha wa fen fǝ tarchi Kǝristi, nggǝt mbǝrani tandǝ ha tǝ chǝt taran. Nechi ndikta kǝɗ tǝ tǝrichǝ hwaˈarcha, kittaˈan pǝɗani tandǝ ha tǝ ter kaan. Kǝnichǝ fee terchan mǝ tanda, thlǝfichǝ fee kaan sǝrtaˈansi wa, kurɓanin yimndǝ kǝ meˈi mǝrta terchan. <verse eid="2CO 11:23" /><verse number="24" style="v" sid="2CO 11:24" />Ɗǝf paktechi Yahudawecha kǝ thlǝfichǝ fee kumchit mahkan ngǝrsi wanherhaˈartǝ yu, kurɓandǝ ɗǝrman <verse eid="2CO 11:24" /><verse number="25" style="v" sid="2CO 11:25" />Kurɓanchǝ Romawech thlǝfita mahkan tǝ fangǝncha. Paɗ tam fee mǝmaki tǝf kurɓandǝ arta tǝ ɗakwancha. Kurɓan shirkin tǝ ema fǝfalat kaɗ mahkan nggǝt huran. Kurɓani mǝnda tǝ parta hur hawurta, kǝn fee ɓat kǝti tǝ kesh. <verse eid="2CO 11:25" /><verse number="26" style="v" sid="2CO 11:26" />Ə hur wiˈchinchi kurɓani yimndǝ kǝ pancha ǝ hur kuficha, kǝminchi tǝ pancha hari fǝ fasa fecha. Kurɓani yimndǝ kǝ pancha ǝ hari wanmanchǝna Yahudawecha, paɗ kurɓani yimndǝ kǝ pancha ǝ hari fee nawakchǝ kǝ Yahudawecha. Kurɓani yimndǝ kǝ pancha ǝ mǝrǝɓcha, kurɓani yimndǝ kǝ pancha ǝ hur wan mǝrǝɓcha, kurɓani yimndǝ kǝ pancha ǝ hur hawurta. Paɗ kurɓani yimndǝ kǝ pancha ǝ hari fǝ fǝr kitcha kǝ fǝ lekcha. <verse eid="2CO 11:26" /><verse number="27" style="v" sid="2CO 11:27" />Chinchǝ tera, ɓahinchǝ ha, kurɓandǝ terchan saˈwi ena wa. Haɗ metǝ nenchi tǝ kuchimnda. kurɓani ɓah ndǝsǝmda, sǝkinchǝ mbita, paɗ mbǝswi kapaɗi nati pata wa. <verse eid="2CO 11:27" /><verse number="28" style="v" sid="2CO 11:28" />Ngga tǝ ǝna fowun sam samǝn paɗ wa, weenmǝta nggǝt tǝ heˈta yi ɗǝmbat har tǝ nat nafcha fǝ fǝr kitcha. <verse eid="2CO 11:28" /><verse number="29" style="v" sid="2CO 11:29" />Wun kuɓech alkǝta, mirwaktǝ fatinchǝ kaɗ kǝthlǝm mǝthlan? Paɗ wun ɗǝftǝ fee kǝ chǝt ɓǝɓifata, thla haɗwaktǝn nenchǝ hur kaan?<verse eid="2CO 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2CO 11:30" />Maa chok wa nwaat kǝ thlaˈi kirsha, nii thlaˈ kirsha tǝ ichiɗi thlǝ pǝnchi huhuthlkaktinchi. <verse eid="2CO 11:30" /><verse number="31" style="v" sid="2CO 11:31" />Sǝn Farta wa ngga tǝni lekta wa, mǝthlan tǝɗi nech kǝ Farta, tǝ paɗ Papa Chinda i Yesu Kǝristi. Thla kǝmchǝs kǝ manan fee kǝ kweˈkǝchi. <verse eid="2CO 11:31" /><verse number="32" style="v" sid="2CO 11:32" />Fartǝɗi nati ǝ Dimaska, nggomna tǝɗi nech kanɗukwati kwitira Aretas ɗǝfsi kǝn fee ɗǝwe mimbanchi mǝrǝɓ Dimaska har kǝthlǝm kǝ kǝsichi. <verse eid="2CO 11:32" /><verse number="33" style="v" sid="2CO 11:33" />Paɗaa fǝrkǝ fǝ fǝr kitchǝ nenchi kah hur kapa inafta tǝ chuhtǝɗi fi thlarti mǝrɓan. Kǝthlǝm ndaˈan heraˈki harˈyan.<verse eid="2CO 11:33" /></para>
  <chapter eid="2CO 11" />
  <chapter number="12" style="c" sid="2CO 12" />
  <para style="s">Ichiɗi pǝnandǝ Kǝristi Bulus kǝɗ ǝ hur sǝnaˈta</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 12:1" />Chǝka mǝ nakan wa ǝnsi nati mbǝstǝs wa, nwaat kǝɗi kǝ pangnga tǝ thlaˈ kirsha. Nakanya, nii ɗǝt kǝ pang tǝ ichiɗi pǝnitǝ Chinda Yesu Kǝristi kǝɗ ǝ hur sǝnaˈta, tǝ paɗ hur Shemeta. <verse eid="2CO 12:1" /><verse number="2" style="v" sid="2CO 12:2" />Sǝninchi yowun nefa, thla kǝ ɓukuya hurat kum nggǝrsǝ foɗɗa hacha, tǝr kǝ fee ndi kǝ hulafǝrta yi mahkanan tǝ alkǝti Kǝristi. Ndu nechan hur fat ya, ndu ngga hur fata wa, sǝnwi wa, Farta ndak sǝncha. <verse eid="2CO 12:2" /><verse number="3" style="v" sid="2CO 12:3" />Paɗ sǝninchi nafɗiya, tǝr fee ndi kǝ mǝɗi naa Farta, ndu nechan hur fat ya, ndu nga nechan hur fata wa, sǝnwi wa, Farta ndak sǝncha. <verse eid="2CO 12:3" /><verse number="4" style="v" sid="2CO 12:4" />Ə mǝnni sǝktǝ ichǝ samǝn samǝn thla nawaktǝn mbahan mbuˈta, weˈtǝ thla nawaktǝ pong nef mbahǝn ndiktǝ kǝ ɗaran. <verse eid="2CO 12:4" /><verse number="5" style="v" sid="2CO 12:5" />Nii thlaˈ kirsha kǝ ɗar nef kǝɗ thleya, paɗaa nii thlaˈ kirsha kǝ indinchǝ wa. Nechi thlaˈ kirsha kǝ ɗar ichiɗi pǝnchǝ huhuthlkaktinchi. <verse eid="2CO 12:5" /><verse number="6" style="v" sid="2CO 12:6" />Chǝka tǝ ndǝ fee wa tǝ yahi thlaˈ kirsha, mǝ nii nǝ kǝ ɓema wa, kǝthlǝm kit nati mbuˈta. Paɗaa nii thlaˈ kirsha wa, kǝthlǝm yahwisi yowun kǝ tǝr tǝ nenchi kǝ mbǝrantǝ thla ha thlǝ natǝn naa nenchǝ wa. Tǝmɗi ǝnɗi thlǝ chiti tǝ ǝnɗi thlǝ sǝktǝn.<verse eid="2CO 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 12:7" />Kǝthlǝm kǝ thlaˈi kirsha kǝ ɗar ichiɗi pǝni tǝ Farta yi fǝr saka inda wa. Thlǝ nii kǝ fee yowun hatǝ fata thla nech haɗchan kaan, thla chokichǝf kǝɗ taha ǝ fi fatinchi. Thleˈya chokchan kǝ thlǝ thlǝnda thla thlǝndǝ hweˈra kǝthlǝm kǝn firi ɓahta, paɗ kǝ ˈyatichi thlaˈandǝ inda. <verse eid="2CO 12:7" /><verse number="8" style="v" sid="2CO 12:8" />Kurɓani shiyandǝ Chinda Yesu mahkan kǝthlǝm kǝ chakichi ha tǝ ǝnɗa. <verse eid="2CO 12:8" /><verse number="9" style="v" sid="2CO 12:9" />Paɗaa ndikan wa, “Kaafatinchi ǝ chaˈuchi, kǝthlǝm ǝ hur huhuthlkaktiyo thlǝ naa fee ndiiɗ alkǝtinchi.” Kǝthlǝm ndaˈan, tǝ mbǝnfat nati chekandǝ thlaˈ kirshinchi tǝ huhulkaktǝɗinchi ya. Kǝthlǝm kǝ choki tǝ alkǝti Kǝristi. <verse eid="2CO 12:9" /><verse number="10" style="v" sid="2CO 12:10" />Kǝthlǝm ndaˈan, wathlichǝ huhuthlkaktinchǝ ha, tǝ ˈyaraɗi thlǝ naa fee i ˈyaritǝ fa, tǝ saa ɓahta, tǝ nggwarkwana, tǝ mboro kǝthlǝm Kǝristi. Kǝthlǝm ǝ fartǝɗi nawaktǝ alkǝtinchǝsi, ǝ fartaˈan nati tǝ alkǝt fa.<verse eid="2CO 12:10" /></para>
  <para style="s">Saka indǝ Bulus tǝ fǝ fǝr kitcha ǝ Korinti</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 12:11" />Chinchi ɓam kǝt kuɗa, paɗ kun ɗǝfchǝ nenchisi. Kun kǝmchǝs mǝ kǝ chǝm wun nenchi. Chǝka mǝ nakan wa ngga ǝn naki wa, chokwa wa, “Fen tatǝ kǝmsichǝɗi tǝrchǝ indiyanda wa yowunsi kǝɗ tanda wa,” pǝɗiwandǝ ha tǝ ǝna yowun wa. <verse eid="2CO 12:11" /><verse number="12" style="v" sid="2CO 12:12" />I chǝ Farta ǝna wanɗǝsǝncha tǝ ǝna tar sakaˈincha tǝmɗinchi ǝ hur wun. Əna saka inchiɗiya pǝn nda wa nggǝt tatǝ kimsha naki yi kit. Chǝti terinchi hur kǝrǝsa. <verse eid="2CO 12:12" /><verse number="13" style="v" sid="2CO 12:13" />Mǝ chaandi fowun kǝtǝn shicha chowun wakti? Ndu kǝthlǝm ǝnɗi ˈyatowun ndi kǝ kǝsichiwun si tǝ ǝnɗi yahti wa? Kǝɗu, sǝɓani kaɗi, kalam nenchǝ ha.<verse eid="2CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 12:14" />Tahsinchǝf kǝ wiˈyowunchi fǝ yi mahkanan nakanya. Nii ɗǝfowun heˈta wa, kǝthlǝm kun yahti, ngga wanɗǝɓithlˈyowun yahti wa. Kǝthlǝm kǝm wasi wanchǝ kǝ nggomandǝ ichǝ ha kǝthlǝm parchǝ nanda wa, paɗ kǝmchansi parchǝ nech nggomandǝ ichǝ ha kǝthlǝm wanchi yanda. <verse eid="2CO 12:14" /><verse number="15" style="v" sid="2CO 12:15" />Nii sǝk mbǝndǝfa kǝ ɓǝlani ǝnɗi nessǝnchi kaɗ nat, paɗ kǝ fǝri indinchǝ, kǝthlǝm kǝ kǝsowunchisi. Maa yahinchi wunchi kaan, awi, nowun takandǝ yahtǝɗi ha thlǝ chǝtǝ wun wa? <verse eid="2CO 12:15" /><verse number="16" style="v" sid="2CO 12:16" />Nowun nggǝmandǝ tǝ ndat wa, nggǝta chokowunwi fǝ kǝ heˈta wa. Nat tǝ kǝɗu, kun ndat wa, tǝ lǝmi wunchi, tǝ paɗ ɗathlowunchi fa, tǝ lǝmwuchǝ tǝ lekta. <verse eid="2CO 12:16" /><verse number="17" style="v" sid="2CO 12:17" />Tǝ ɗathlowunchi fa tǝmɗi yowun ǝ hur fee thlǝndi kǝmɗiyowun wa? <verse eid="2CO 12:17" /><verse number="18" style="v" sid="2CO 12:18" />Shiyani Titus wumanki tǝ yowun wanmanda kǝ ɗǝndǝ kǝmɗiyowun. Nowun ndat wa ɗathlowunchǝ Titus fa wa? Awi, Shemeɗi thlǝ parech har tǝ ndi, ngga ndaˈan thlǝ parecha har tǝ nggaˈan wa? Paɗ ngga mbandǝ arta thlǝ parat ǝn wa?<verse eid="2CO 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CO 12:19" />Awi, kǝ choh chowunchan fǝ wa tǝthlǝ naˈan chapandǝ indiyaˈan kaɗ mǝɗˈyowun wa? Fartǝ sǝnchǝsi, tǝthl naˈan mbuˈ kit hur Kǝristi. Kun tǝɗi yahti, nat ǝnɗi thlǝ chǝt ǝn, chichaˈan kǝthlǝm kǝ tǝnowun chǝ ǝn. <verse eid="2CO 12:19" /><verse number="20" style="v" sid="2CO 12:20" />Kǝthlǝm thlǝ nechi lekǝta, fartǝɗi ɓati, maˈya nii mbǝsowunchi kǝɗ ǝnɗi yahti wa. Kun paɗ nowun mbǝsichǝ kǝɗ ǝnɗi yahtǝwun wa. Nggǝt lekǝta nii mbǝsandǝ yanda, tǝ sǝraˈta, tǝ peˈtǝ hwira, tǝ yah inda, tǝ sǝɓandǝ thlǝm fowun kaɗi, tǝ ǝsfata, tǝ maaan inda, tǝ paɗ thlaˈ hur inda. <verse eid="2CO 12:20" /><verse number="21" style="v" sid="2CO 12:21" />Nggǝt lekǝta ndat wa maa nggǝrinchǝ ɓat kǝmɗiyowun, Fartinchi nan dǝftǝ kǝ harichǝ fata ǝ pangngǝn wun. Nii sǝɓandǝ hwir kaɗi kǝthlǝm nafchǝ terchan fee chich ɓǝbifata ǝ choh tǝrwakchǝ ha ǝ hur tar fǝlaukǝta, tǝ tar tǝkǝmnda, tǝ ka mban sǝk mbǝndǝfa yi kumi hartǝfata.<verse eid="2CO 12:21" /></para>
  <chapter eid="2CO 12" />
  <chapter number="13" style="c" sid="2CO 13" />
  <para style="s">Nggǝlmi tǝɗ thlǝmati Bulus</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 13:1" />Nggǝt ɓat kǝmɗiyowun yi mahkanan. Nggǝt ɓat yi mahkanan kǝɗ ǝnɗi nbuˈtǝ yara ndikti Farta. “Nwaat kǝ sǝk fee chǝka yen ndikta meˈi nafchǝ chap ndu mahkan.” <verse eid="2CO 13:1" /><verse number="2" style="v" sid="2CO 13:2" />Ə chapatǝ ɓatinchi tǝɗani thlǝmatǝ fee chich ɓebifata choh tǝ takǝɗ nafchǝ nat kǝ malandǝ chǝt ɓǝbifata. Nakanya nggǝtsi pathlangnwun wa, nggǝt nggǝr tǝɗandǝ thlǝmechˈyowun. Kǝthlǝm maa ɓinchi thlǝ ɓǝɓifatsi nati malanda tǝɗawi thlǝmaˈyan wa. <verse eid="2CO 13:2" /><verse number="3" style="v" sid="2CO 13:3" />Nakan yahwun kǝ wathlowunchǝ ha ndu thlǝ ndikchǝ Kǝristi tǝmɗinchi, maa kǝɗu ǝ sǝnanya. Kǝristi kuɓawa alkǝt ǝ hurwun wa, paɗ thlǝ pinchan alkǝtˈyan ǝ hurwun. <verse eid="2CO 13:3" /><verse number="4" style="v" sid="2CO 13:4" />Chǝka mǝ nakan wa kukwanchǝ fee ha tǝmɗi kumi alkǝta, paɗ mǝthlansǝ tǝ shishingnda tǝmɗi alkǝti Farta. Kǝɗu paɗ nggaˈan ǝ alkǝtˈyaˈansi ǝ hwirˈyan wa, chǝka kǝɗu nggǝmǝn tǝ shishingnda tǝmɗi alkǝti Farta kǝthlǝm tarɗi thlǝ chǝtˈǝn ǝ hurwun.<verse eid="2CO 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 13:5" />Kaɗaman inchowun kǝthlǝm kǝ sǝnwun ndu ngguwun hur fǝr kit. Kǝthl nowun kaɗandǝ inchowun. Awi, sǝnwowun wa Yesu Kǝristi hurwun wa? Maa sǝnwowun wa, chokchan wa hǝmwunha tǝ kaɗaɗiya. <verse eid="2CO 13:5" /><verse number="6" style="v" sid="2CO 13:6" />Fǝrinchi kit sǝ tǝ ndat wa nowun sǝndǝ wa hǝmwaˈan ha tǝ kaɗaɗiya wa. <verse eid="2CO 13:6" /><verse number="7" style="v" sid="2CO 13:7" />Paɗaa nggaˈan shiyandǝ Farta kǝ chǝwun ǝnɗi kǝmwakchǝs wa. Ngga kǝthlǝm tǝ yahˈǝn pǝnda wa nggaˈan mbǝraˈǝn kaɗaɗan ha wa, paɗ kǝthlǝm kun kǝ chǝwun ǝnɗi nech keˈke. Chǝka mǝ nakan wa nechan pǝnda wa kǝɗ tǝ wulaˈanchǝ fata. <verse eid="2CO 13:7" /><verse number="8" style="v" sid="2CO 13:8" />Kǝthlǝm naˈan para kǝrsi kit, nggaˈan mbahǝn chǝt ǝnɗi thlǝ chich atǝkrekǝt tǝ kit wa. <verse eid="2CO 13:8" /><verse number="9" style="v" sid="2CO 13:9" />Mbǝnfat thlǝ chǝt ǝn maa alkǝt yaˈansǝ wa, paɗ kun alkǝt ˈyowunsǝ. Paɗ nggaˈan shita kǝ chokwun kǝ ndiiɗ chaˈan. <verse eid="2CO 13:9" /><verse number="10" style="v" sid="2CO 13:10" />Ndaˈan chicha nati yarowun ǝnɗasi fartǝɗi nawakti tǝ wunchi. Kǝthlǝm ma ɓinchi, kǝ chok nwaat mǝɗinchi kǝ fǝrowunchi ngwarkwana kǝ ɗar chǝt ter tǝ alkǝtɗi fǝritǝ Chinda wa. Alkǝtɗi fǝrintǝn yi tǝnanda, ngga yi tǝtokandǝ kaɗ wa.<verse eid="2CO 13:10" /></para>
  <para style="s">Nggǝlmi ndikti Bulus</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 13:11" />Ə nggel miyan, wanmanchǝna, mbǝnam fata. Kweyamha kǝ chokwun kǝ ndiiɗ chaˈan. Ndǝksaman raˈan, chokam tǝ kaɗat arta, kǝ chokwun hashas tǝ raˈan. Tǝ kǝɗu Fartǝ thlǝ yahraˈan, te has has kǝta, nan choktǝ mbukwa tǝ wunchi. <verse eid="2CO 13:11" /><verse number="12" style="v" sid="2CO 13:12" />Ndaman ǝn raˈan hur yahraˈan yi kit. <verse eid="2CO 13:12" /><verse number="13" style="v" sid="2CO 13:13" />Nat fǝ fǝr kitchǝɗi nech mǝɗa tandǝ ndowun ǝn fa.<verse eid="2CO 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 13:14" />Kafati Chinda Yesu Kǝristi, tǝ yahraˈan i Farta, tǝ thlǝrɗakti Shemeta thla Chiɗ Chiɗ, kǝ chok tǝ wunchǝ nat. Kǝchok kǝɗu.<verse eid="2CO 13:14" /></para>
  <chapter eid="2CO 13" />
</usx>