<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- Gaanda</book>
  <para style="h">1 John</para>
  <para style="toc3">1 Yah</para>
  <para style="toc2">1 John</para>
  <para style="toc1">1 Yahaya</para>
  <para style="mt2">Tǝrkwathl kan yarati</para>
  <para style="mt">Yohanna</para>
  <para style="imt">Tǝrkwathl kan ndikta</para>
  <para style="im">Ɗelwer tǝɗa, tatǝ kǝmsha Yohanna yarecha ǝ mǝrǝɓ Afisa. Yerech fee ɗelwer taˈan kǝthlǝm kǝ ndǝksan fee fǝ fǝr kitcha. Kǝ chǝndǝ thlǝrɗakta tǝ Farta tǝ Waˈyan Yesu Kǝristi. Ɗelwer taˈan paɗ ndik kǝ ɗar chaˈandǝ kaɗi yi lekta, thla thlǝ chǝt fee, kǝthlǝm kǝ sǝɓan fee thlǝrɗaktǝɗi kaɗ ya. Chaˈaɗǝ kaɗ yi lektǝ ɗa, mǝthlan ndat wa, yimwu Yesu kǝ hur heshi tǝ weˈtǝ fati nefa wa. Thlǝ yaraɗan wathlanchǝ tandǝ ha wa Yesu ɓechan hur fati nefa. Ndat wa, Yesu ngga nef kǝɗ takǝɗ pong nafcha wa. Yerech fee ɗelwer taˈan paɗ, kǝthlǝm kǝ ndǝksan fee fǝ fǝr kit cha, kǝ wathlandǝch ha paɗ kǝ ɓǝra fǝr kit ˈyanda. Kǝ yah ndǝ raˈan kǝɗ ǝnɗi yahtǝ Fartǝ tanda.</para>
  <chapter number="1" style="c" sid="1JN 1" />
  <para style="s">Ndikta i shishingnda</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1" />Nggaˈan yarowundǝs kǝ ɓǝra thla nech tǝrkwathl kan heshi mǝthlansi. Thla sǝktǝˈǝn tǝ thlǝmech ˈyaˈan, ɗǝpaˈǝn tǝ wenitiyaˈan, niiˈǝn ndi paɗ tǝka ǝn herfa tǝ harchiyaˈan. Mǝthlan thlǝ fǝrchǝ shishingnda. <verse eid="1JN 1:1" /><verse number="2" style="v" sid="1JN 1:2" />Pǝn fee thla thlǝ fǝrchǝ shishing ngǝɗa hayan paɗ niiˈǝn ndi tǝ wenitiyaˈan. Nggaˈan ndik ǝnɗi sǝndǝˈǝn kǝ ɗaran. Nggaˈan ndiktǝ kǝ ɓǝra thla thlǝ fǝrchǝ shishingnda kǝ kwekǝɗan. Thla nech choh tǝ Chinmǝn Farta paɗ pǝnamǝnchǝ fee ndi kǝmɗiyamǝn hayan. <verse eid="1JN 1:2" /><verse number="3" style="v" sid="1JN 1:3" />Nggaˈan sǝnowun ndǝs kǝ ɓǝra nafɗi natˈǝn tǝ wenitiyaˈan tǝ paɗ sǝkˈǝn ndi. Kǝthlǝm kun paɗ kǝ chokwun thlǝrɗakta tǝ nggaˈan. Chok thlǝrɗaktǝyamǝn mǝthlan tǝ Chinda Farta tǝ paɗ Wayan Yesu Kǝristi. <verse eid="1JN 1:3" /><verse number="4" style="v" sid="1JN 1:4" />Nggaˈan yarowun ǝnɗisiya kǝthlǝm mbǝn fat ˈyaˈan tǝ yuwun kǝ ndiiɗ ha.<verse eid="1JN 1:4" /></para>
  <para style="s">Farta ɗaˈkǝta</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5" />Thleya nech kǝ ndiktǝɗi sǝktǝˈǝn meˈi Wayan tǝ paɗ ndaˈan natˈǝn mbuˈowunnda. Farta ɗaˈkǝt nakan, ǝnsi wumanchǝ ha tǝ wuthla wa chǝk ngguɗyeh. <verse eid="1JN 1:5" /><verse number="6" style="v" sid="1JN 1:6" />Maa ǝ ndimǝn wa nggǝmǝn chǝt thlǝrɗakta tǝ Farta, paɗ peˈkamǝn wiˈtǝ hur wuthla, pǝnchan wa namǝn lekta paɗ kittaˈansi hur natˈyamǝn ha wa. <verse eid="1JN 1:6" /><verse number="7" style="v" sid="1JN 1:7" />Maa wiˈ mǝn hur ɗaˈkǝta, kǝɗ thla naa Farta kǝ ɗaˈkǝta, pǝnchansi wa nggǝmǝn chok thlǝrɗaktǝ tǝ raˈan. Feri Yesu Waˈyan ɗǝftǝ minchi kǝ namǝn chiɗ chiɗ ɗar chǝka yen ɓǝɓifata.<verse eid="1JN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8" />Maa ndimǝn wa ɓǝɓifatsi fiyamǝn wa, chokchan tǝ namǝn lǝm indiyamǝn, paɗ kitsǝ hwirˈyamǝn wa. <verse eid="1JN 1:8" /><verse number="9" style="v" sid="1JN 1:9" />Maa mbuˈamǝn Farta ɓǝɓifechˈyamǝn nat, Farta thlǝ kafata, thlǝ thlǝrɗakta nan kalamǝn ɓǝɓifechˈyamǝn ha nat paɗ kǝ chapamǝn chǝ kaɗ hur ɓǝɓifechˈyamǝn nat, kǝ namǝn chiɗ chiɗ. <verse eid="1JN 1:9" /><verse number="10" style="v" sid="1JN 1:10" />Maa ndimǝn wa tamwamǝn chǝt ɓǝɓifata wa, tǝ ndamǝn wa Farta thlǝ lekta, ndiktiyan paɗ neˈsi hwirˈyamǝn wa.<verse eid="1JN 1:10" /></para>
  <chapter eid="1JN 1" />
  <chapter number="2" style="c" sid="1JN 2" />
  <para style="s">Kǝristi thlǝ thlaramǝnchǝs ǝ pangngǝn Papa</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1" />Wanchinchi fee nech wechicha, nggǝt yarowun ǝnɗisiya kǝthlǝm kǝ chiwun ɓǝɓifata wa. Paɗ maa chǝ yowun ɓǝɓifata thlǝ thlaramǝn ndǝs ǝ pangngǝn Farta kǝthlǝm nggǝmǝn. Mǝthlan nech kǝ Yesu Kǝristi, thlǝ kafata. <verse eid="1JN 2:1" /><verse number="2" style="v" sid="1JN 2:2" />Mǝthlan fǝrchǝ shishingndiyan kǝthlǝm ɓǝɓifechˈyamǝn. Ngga kǝthlǝm ɓǝɓifechˈyamǝn ndak wa, paɗ kǝthlǝm ɓǝɓifechi nafchiɗi nech hur heshi nat. <verse eid="1JN 2:2" /><verse number="3" style="v" sid="1JN 2:3" />Maa parimǝn kusiˈ chǝɗi mbuˈamǝn ndǝ Farta, ndaˈan nech pǝnamǝn ndǝ wa sǝnmǝn ndi. <verse eid="1JN 2:3" /><verse number="4" style="v" sid="1JN 2:4" />Nat thla ndech wa, “Sǝntǝ Farta,” paɗ mǝthlan para kusiˈ chi Farta wa, nef ini thlǝ lekta, kittaˈansǝ hwirˈyan wa. <verse eid="1JN 2:4" /><verse number="5" style="v" sid="1JN 2:5" />Paɗaa thla nech para ǝnɗi mbuˈtǝ Farta, kafatˈyan kǝmɗi Farta ndiiɗ ha. Tǝ kǝɗu natmǝn sǝnda wa nggǝmǝn hwirˈyan. <verse eid="1JN 2:5" /><verse number="6" style="v" sid="1JN 2:6" />Nat thla ndech wa natˈyan ha hwiri Farta, nwaat kǝn wiˈtiyan kǝɗ ǝnɗi chǝt Yesu.<verse eid="1JN 2:6" /></para>
  <para style="s">Yuwa kusiˈ</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7" />Wanmanchina fee yahti, ngga yuwa kusiˈ nati yarowundǝs wa. Auwa, kusiˈ yi choh thla sǝktǝwun tǝrkwathl kan fartǝɗi nggaktǝwun sǝk ndikti Farta. Ɗohtǝ kusiˈ taˈan, ndaˈan nech kǝ ndiktǝɗi tamndǝwun sǝkta. <verse eid="1JN 2:7" /><verse number="8" style="v" sid="1JN 2:8" />Paɗ nat tǝ kǝɗu, yuwa kusiˈ nati yarowun ndǝsi. Thlǝ nech fee kit tǝ ndiktǝɗiya hwiri Kǝristi tǝ paɗ ǝ hwirˈyowun. Wuthla mǝthlan pǝɗata, ɗaˈkǝta thla nech kǝ kit mǝthlan wenandǝ mǝt kaɗi.<verse eid="1JN 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9" />Nat thla ndech wa mǝthlan hur ɗaˈkǝta, paɗ mǝthlan kar wanmanan thlǝ fǝr kit, pǝnchan wa peˈchan hur wuthla. <verse eid="1JN 2:9" /><verse number="10" style="v" sid="1JN 2:10" />Kǝɗu nat thla yahchi wanmanan, chok chan wa natˈyan ha hur ɗaˈkǝta. Kǝthlǝm ndaˈan ǝnsi hwirˈyan thla nech ɗǝf yowun kǝ chǝt wansarta ndu kǝ chǝt ɓǝɓifata wa. <verse eid="1JN 2:10" /><verse number="11" style="v" sid="1JN 2:11" />Nat thla karchǝ wanmanan methlan hur wuthla, paɗ methlan wiˈtǝ hur wuthlan. sǝn wa ndu chan kai wa, kǝthlǝm koman wuthlan.<verse eid="1JN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12" />Wanchinchi fee nech wechicha yarowunchǝsi,</para>
  <para style="q2" vid="1JN 2:12">kalowunchi fee ɓǝɓifechˈyowun ha kǝthlǝm thlǝm Yesu.<verse eid="1JN 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="1JN 2:13" />Chincha, nggǝt yarowundǝssi</para>
  <para style="q2" vid="1JN 2:13">kǝthlǝm tapi sǝnwun ndi. Thla nechsi tǝrkwathl kanan.</para>
  <para style="q1" vid="1JN 2:13">Kun tǝɗi nech kǝ kǝmsicha yarowunchisi,</para>
  <para style="q2" vid="1JN 2:13">kǝthlǝm tapi pǝɗawun hwaˈran ha.<verse eid="1JN 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="1JN 2:14" />Wanchinchi fee nech wechicha nggǝt yarowundǝssi,</para>
  <para style="q2" vid="1JN 2:14">kǝthlǝm sǝnwun Papa.</para>
  <para style="q1" vid="1JN 2:14">Kun tǝɗi nech kǝ chincha yarowunchisi</para>
  <para style="q2" vid="1JN 2:14">kǝthlǝm tapi sǝnwun ndi mǝthlan tǝɗi nech tǝrkwathl kanan.</para>
  <para style="q1" vid="1JN 2:14">Kǝmsicha yarowunchisi,</para>
  <para style="q2" vid="1JN 2:14">kǝthlǝm tǝ nowun kwaˈkwa</para>
  <para style="q2" vid="1JN 2:14">ndikti Farta mǝthlan hur wanɗǝkaldechˈyowun,</para>
  <para style="q2" vid="1JN 2:14">paɗ mbǝrawun alkǝti hweˈrǝ ha.<verse eid="1JN 2:14" /></para>
  <para style="b" />
  <para style="s">Kǝ yahwun heshi wa</para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15" />Mǝ yahwun heshi wa, ndu ichiɗi nech huran wa. Nat thla yahchǝ heshi, ǝ thlǝrɗakti Papa sǝ hwirˈyan wa. <verse eid="1JN 2:15" /><verse number="16" style="v" sid="1JN 2:16" />Kǝthlǝm nat inchiɗi nech hur heshiɗiya, kǝɗ, chǝt ǝnɗi thlǝ yahtǝ fata, tǝ ǝnɗi thlǝ yahtǝ wenita, tǝ thlaˈandǝ inda kǝ ɗar ǝnɗi nessiyamǝn. Ichiɗiya ngga ɓechandǝ thlǝma Chinda wa, paɗ ɓechandǝ hur heshi. <verse eid="1JN 2:16" /><verse number="17" style="v" sid="1JN 2:17" />Heshiɗiya tǝ ɓǝɓi ichiɗi nat thlǝ yahtǝ nafcha, tandǝ mbǝrtǝ ha. Paɗ nat thla nech thlǝnandǝ ǝnɗi mbuˈtǝ Farta, nan nat ha kǝ kwekǝɗan.<verse eid="1JN 2:17" /></para>
  <para style="s">Atǝkreti Kǝristi</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18" />Wanchinchi fee nech wechicha, fartǝɗi naa heshiɗiya tǝɓata nduk ha. Kǝɗ ǝnɗi sǝktǝwun ndat wa, naa atǝkreti Kǝristi ɓata. Nggǝt mbuˈowun nda atǝkrechi Kǝristi terchan tapi ɓi ndǝ kǝ hur heshi. Kǝthlǝn ndaˈan sǝnmǝn tǝ ndat wa nggǝmǝn ǝ ndukwa heshi. <verse eid="1JN 2:18" /><verse number="19" style="v" sid="1JN 2:19" />Nafchiɗiya choh tandǝ tǝ mǝnchi, paɗ malndǝ mǝnchǝ ha, kǝthlǝm kǝ choh ngga yimǝn nakanda wa. Kǝthlǝm maa yimǝn nakanda, mǝ pǝˈchandǝ tǝ mǝnchi. Chi ndǝ kesh malndǝ mǝnchǝ ha, thleya pin hayan ndat wa nat nda ngga yimǝn wa.<verse eid="1JN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20" />Kun ngga kǝɗu natwun wa, kǝthlǝm thlǝ Chiɗ Chiɗ kǝɗ ɗiya tapi fǝrowun tǝ Shemetˈyan. Kǝthlǝm ndaˈan nat wun sǝnwun kittaˈan. <verse eid="1JN 2:20" /><verse number="21" style="v" sid="1JN 2:21" />Yarowunchisi ngga kǝthlǝm sǝnwowun kitwa wa. Yarowunchisi kǝthlǝm sǝnwun kit, tǝ paɗ tapi sǝnwun nggǝtwu kit kǝ lekta wa. <verse eid="1JN 2:21" /><verse number="22" style="v" sid="1JN 2:22" />Wun thlǝ lekta? Mǝthlan ndech wa Yesu ngga Kǝristi wa. Chǝkawun aschǝ in Chinda tǝ Wannan mǝthlan nech kǝ atǝkreti Kristi. <verse eid="1JN 2:22" /><verse number="23" style="v" sid="1JN 2:23" />Nat thla aschǝ in Wannan, Chinan ˈyan sǝ wa. Kǝɗu paɗ, thla thlich Wannan, thlǝt Chinan.<verse eid="1JN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24" />Kun paɗ, ǝnɗi sǝktǝwun terkwathl kanan kǝ chok hur wanɗǝkaɗatˈyowun. Maa chok ǝ wanɗǝkaɗatˈyowun, nowun nat hwiri Wannan tǝ Chinan. <verse eid="1JN 2:24" /><verse number="25" style="v" sid="1JN 2:25" />Thleya nech kǝ ɗǝf miɗi chamǝn ndǝ Wannan ndat wa namǝn mbǝs shishingnda thla kǝ kwekǝɗan.<verse eid="1JN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26" />Nggǝt yarowun ichiɗisiya kǝ ɗar fee yahchǝ kǝ sakowunchǝ nda. <verse eid="1JN 2:26" /><verse number="27" style="v" sid="1JN 2:27" />Kun paɗ Shemeɗi Farta thla fǝrowun ndǝ Kǝristi ya, mǝthlan ɗas hurwun. Kǝthlǝm ndaˈan peˈwowun yah yowun kǝ ɓǝ chaˈowun ǝn har wa. Nat ǝnɗi chaˈowun ndǝ Shemet har kittaˈan, lektǝs huran wa. Kǝɗ ǝnɗi chaˈowun ndǝ Shemet har, chokam tǝ Kǝristi hur natˈyowun ha.<verse eid="1JN 2:27" /></para>
  <para style="s">Wanchi Farta</para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28" />Nakanya, wanchinchi fee nech wechicha fee yahti, ɗam kǝ pang tǝ natˈyowun ha hur Kǝristi, kǝthlǝm ǝ fartǝɗi natǝn pǝn fatˈyan, namǝn chok tǝ lekǝta, ndu hartǝfata ǝ pangngǝnan wa. <verse eid="1JN 2:28" /><verse number="29" style="v" sid="1JN 2:29" />Maa sǝnwun wa Kǝristi thlǝ kafata, no wun sǝndǝs wa nat thla naa natˈyan ha hur kafata, chok kǝ Waˈi Farta.<verse eid="1JN 2:29" /></para>
  <chapter eid="1JN 2" />
  <chapter number="3" style="c" sid="1JN 3" />
  <para style="s">Wanchi Farta</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1" />Ɗǝpaman weˈtǝ yahtǝɗi pǝnamǝn ndǝ Farta, thlǝ ˈya fee mǝnchi wa wanchi Farta, paɗ nechamǝn kǝɗuyu. Ənɗi chicha sǝnwaktǝ nafchi heshi mǝnchi, kǝhtlǝm sǝnwandǝ ndǝ wa. <verse eid="1JN 3:1" /><verse number="2" style="v" sid="1JN 3:2" />Wanmanchina fee yahti, nakanya nggǝmǝn wanchi Farta. Paɗ weˈtǝ nafchiɗi natmǝn chokta ǝ pangnga pǝnwu fee kwaɗǝn wa. Paɗ sǝnmǝn wa maa pǝn Kristi fatˈyan, nechamǝn nat kǝɗ mǝthlan, kǝthlǝm namǝn naa ndi kǝɗ ǝnɗi natǝn. <verse eid="1JN 3:2" /><verse number="3" style="v" sid="1JN 3:3" />Nat thla thlǝ ɗǝfchǝ kǝfatsi kǝ Kǝristi nan chandǝ fatˈyan kaɗ chiɗ chiɗ, kǝɗ ǝnɗi naa Kǝristi Chiɗ Chiɗ.<verse eid="1JN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4" />Nat thla thlǝ chich ɓǝɓifata tǝthl chenchi kusiˈ i Farta kaɗi. Kǝthlǝm ɓǝɓifata ndaˈan nech kǝ kumi chǝt ǝnɗi nda Farta. <verse eid="1JN 3:4" /><verse number="5" style="v" sid="1JN 3:5" />Sǝnwun wa ɓech Yesu kǝthlǝm kǝ ɓǝ tǝrandǝ ɓǝɓifechˈyamǝn kaɗi. Mǝthlan paɗ ɓǝɓifatsi hwirˈyan wa. <verse eid="1JN 3:5" /><verse number="6" style="v" sid="1JN 3:6" />Kǝthlǝm ndaˈan nat thla nech hwiri Kǝristi ɗǝwa kǝ pang tǝ chǝt ɓǝɓifata wa. Nat thla ɗich kǝ pangnga tǝ chǝt ɓǝɓifata, kǝɗu, tamwa naa Yesu wa, tamwa la sǝn ndǝ wa.<verse eid="1JN 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7" />Kun wanchinchi fee yahti, kǝ nggǝm wun fa kǝ sakowunchǝ yowun wa. Nat thla thlǝ ɗich kǝ pangnga tǝ thlǝnandǝ kafata thlǝ kafat nakan, kǝɗ ǝnɗi naa Kǝristi kǝ thlǝ kafata. <verse eid="1JN 3:7" /><verse number="8" style="v" sid="1JN 3:8" />Nat thla thlǝ ɗich kǝ pang tǝ chǝt ɓǝɓifata, yi Hweˈrǝ nakan. Kǝthlǝm ǝ tǝrkwathlkanan Hweˈra thlǝ thlǝn ɓǝɓifata. Saktǝ ɓati Waˈi Farta ndaˈan nech kǝ ɓǝ tutokandǝ teri Hweˈrǝ kaɗi.<verse eid="1JN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 3:9" />Nat thla nech kǝ waˈi Farta nawa kǝ pangnga tǝ chǝt ɓǝɓifata wa, kǝthlǝm nati Fartǝ ha mǝthlan ǝ hwirˈyan. Peˈwa ɗǝt kǝ pangnga tǝ chǝt ɓǝɓifata wa, kǝthlǝm chok kǝ waˈi Farta. <verse eid="1JN 3:9" /><verse number="10" style="v" sid="1JN 3:10" />Ə mbanɗi naa fee sǝn wanchi Fartǝ ya, tǝ paɗ wanchi Hweˈra. Nat thla thlǝ thlǝnawakchǝ ǝnɗi nech keˈkeˈ, mǝthlan ngga waˈi Farta wa, paɗ nat thla thlǝ yahwakchi sheɗan thlǝ fǝr kit, mǝthlan ngga waˈi Farta wa.<verse eid="1JN 3:10" /></para>
  <para style="s">Yaham raˈan</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11" />Thlǝya nech kǝ ndiktǝɗi sǝktǝwun tǝrkwathl kanan, tǝ ndat wa kǝ yahwun raˈan. <verse eid="1JN 3:11" /><verse number="12" style="v" sid="1JN 3:12" />Kǝ chokwun kǝɗ Kayinu wa, thla chokchi kǝ yi hweˈra, ɓǝlangkan wanmanan. Kǝthlǝm mǝ ɓǝlandǝn wanmanan? Ɓǝlanchan kǝthlǝm tarchiyan nech kǝ ɓǝɓiˈan, paɗ yi sheɗan taˈan yi kafata. <verse eid="1JN 3:12" /><verse number="13" style="v" sid="1JN 3:13" />Kǝ sakowunchǝ inda wa wanmanchina fǝ fǝr kit, maa kar nafchi heshi wunchi. <verse eid="1JN 3:13" /><verse number="14" style="v" sid="1JN 3:14" />Nggǝmǝn ya, sǝnmǝn wa tapi talamǝn mǝrta, kǝ shishinggnda, kǝthlǝm thlǝ yahchamǝn wanmanchǝmǝn fǝ fǝr kit. Paɗaa nat thla thlǝ yahwakchi wanmanchaˈan fǝ fǝr kit, paˈya peˈchǝ alkǝti mǝrtǝ ǝ ɗar indiyan. <verse eid="1JN 3:14" /><verse number="15" style="v" sid="1JN 3:15" />Nat thla thlǝ karchi wanmanan thlǝ fǝr kit, thlǝ ɓǝlfata. Paɗ sǝnwun wa thlǝ ɓǝlfatsi naa shishingndiyansi kǝ kwekǝchi ǝ hwirˈyan wa.<verse eid="1JN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 3:16" />Ə mbanɗi natmǝn sǝn mǝnech kǝ yahraˈan ya, fǝr Yesu Kǝristi shishinggndiyan kǝthlǝm nggǝmǝn. Kǝmchansi nggǝmǝn paɗ kǝ fǝrmǝn shishingndiyamǝn kǝthlǝm wanmanchǝmǝn fǝ fǝr kit. <verse eid="1JN 3:16" /><verse number="17" style="v" sid="1JN 3:17" />Nat thla naa kǝnauˈyansi, paɗ nakan wanmanan hur ɓillaa, haɗawa fǝ ǝ hur wanɗǝkaɗatˈyan wa, kaakǝti Fartǝs hwirˈyan kuɗa wa? <verse eid="1JN 3:17" /><verse number="18" style="v" sid="1JN 3:18" />Kun wanchinchi fee yahti, kǝ pǝnmǝn yahraˈan ǝ hur me ndak wa. Mallan kǝ pǝnmǝn yahraˈan ˈyamǝn tǝmɗi thlǝnandǝ ichiɗi nech ndiˈchan tǝ nat ha hur kit.<verse eid="1JN 3:18" /></para>
  <para style="s">Mǝ lekamǝn thlartǝ ha ǝ pangngǝn Farta wa</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19" />Ə mbanɗi natǝn wathlamǝndǝ ha ya wa nggǝmǝn yi kit, tǝ paɗ wanɗǝkaɗatˈyamǝn kǝ wathlaminchi ha tǝ ndat wa, namǝn mbahan thlartǝ ha ǝ pangngǝn Farta lekǝtsi wa. <verse eid="1JN 3:19" /><verse number="20" style="v" sid="1JN 3:20" />Ndu chǝka tǝ pǝnamǝnchi wanɗǝkaɗechˈyamǝn wa nggǝmǝn fǝ ɓǝɓifecha, nggǝmǝn hur kaɓikaɗi. Kǝthlǝm sǝnmǝn wa Farta pǝɗanchi wanɗǝkaɗatˈyamǝn ha, paɗ sǝntǝ chǝka mǝ nat. <verse eid="1JN 3:20" /><verse number="21" style="v" sid="1JN 3:21" />Kuntǝɗi yahti, maa pǝnamǝnwu wanɗǝkaɗǝchˈyamǝn wa ɓǝɓifatˈyamǝn su wa, wathlamǝnchǝ ha ǝ wanɗǝkaɗatˈyamǝn ndat wa, namǝn mbahǝn thlartǝ ha ǝ pangngǝn Farta. <verse eid="1JN 3:21" /><verse number="22" style="v" sid="1JN 3:22" />Thlǝ mbǝschamǝn nat ǝnɗi shitǝmǝn mǝɗiyan, kǝthlǝm thlǝ parechamǝn kusiˈ ˈyan paɗ thlǝ thlǝnan chamǝn ǝnɗi thlǝ tǝranchi hwirˈyan ha. <verse eid="1JN 3:22" /><verse number="23" style="v" sid="1JN 3:23" />Kusiˈ taˈan ndaˈan nech kǝ fǝrmǝn kit kǝ Waˈyan Yesu Kǝristi, paɗ kǝ yahmǝn wanmanchǝmǝn fǝ fǝr kit, kǝɗ ǝnɗi ndamǝn ndǝ Kǝristi. <verse eid="1JN 3:23" /><verse number="24" style="v" sid="1JN 3:24" />Nat fee thlǝ parech kusiˈ ˈyan tandǝ ɗas hwirˈyan, mǝthlan paɗ hwirˈyanda. Tǝ kǝn natmǝn sǝnda wa mǝthlan hurmǝn? Nechamǝn sǝnda, tǝmɗi Shemeɗi fǝramǝndǝn.<verse eid="1JN 3:24" /></para>
  <chapter eid="1JN 3" />
  <chapter number="4" style="c" sid="1JN 4" />
  <para style="s">Kaɗaman shemecha</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1" />Nafchinchi fee yahti, kǝ fǝr wun kit kǝ chǝkawun ndech wa Shemeti Fartǝˈs ǝ hwirˈyan wa. Kaɗaman tandǝ nat kǝthlǝm kǝ sǝnwun wa ndu Shemeɗi fiyanda yi Farta. Kǝthlǝm wel fǝ shenuˈchǝ tǝ yahti Farta ha kǝ fǝ lekcha terchan, ǝ hur heshi. <verse eid="1JN 4:1" /><verse number="2" style="v" sid="1JN 4:2" />Nechowun sǝn nafɗi thla naa Shemeti Fartǝˈs fiyan kǝɗaya, nat nafɗi ndech wa Yesu Kǝristi ɓi hur fata, nefˈini Shemeti Fartǝs hwirˈyan. <verse eid="1JN 4:2" /><verse number="3" style="v" sid="1JN 4:3" />Paɗaa nat nafɗi mbuˈwakchǝ kǝɗu kǝ ɗar Yesu, shemeɗi nech hwirˈyan ngga yi Farta wa. Thleya nech kǝ Shemeɗi thlǝ chich atǝkrekǝt tǝ Kǝristi thla sǝktǝwun tǝ ndat wa nan ɓata kǝ hur heshi. Nakan kǝɗaya tapi ɓi kǝ hur heshi.<verse eid="1JN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4" />Kun wanchinchi fee yahti, kunya yi Farta, kun tapi mbǝrawun nafchiɗi ha ya, kǝthlǝm Shemeti Farta ɗi nech hurwun pǝɗantǝ shemeɗi ha nech hwiri nafchiɗi nech hur heshi tǝ alkǝta. <verse eid="1JN 4:4" /><verse number="5" style="v" sid="1JN 4:5" />Kǝ choh taˈan yi heshi nakanda. Kǝthlǝm ndaˈan nat ǝnɗi mbuˈtǝ nda yi heshi, nafchi heshiˈan paɗ tandǝ sǝk tanda. <verse eid="1JN 4:5" /><verse number="6" style="v" sid="1JN 4:6" />Nggǝmǝn, yi Farta nakamǝn. Thla sǝnchi Farta thlǝ parechan ndiktiyamǝn. Thla nawakchi kǝ yi Farta, para wa ndiktǝ yamǝn wa. Tǝ kǝɗu, tǝ minni thlǝ sǝndǝmǝn nafɗi nech tǝ Shemeta thla nech kǝ kit tǝ thla nech kǝ yi lekta.<verse eid="1JN 4:6" /></para>
  <para style="s">Farta mǝthlan nech kǝ yahraˈan</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7" />Nafchinchi fee yahti, yahamraˈan, kǝthlǝm yahraˈan ɓechan mǝɗi Farta. Nat thla nech pǝn yahraˈan waˈi Farta nakan, paɗ sǝntǝ Farta. <verse eid="1JN 4:7" /><verse number="8" style="v" sid="1JN 4:8" />Nat thla yahwakchǝ wanmanan, sǝnwa Farta wa, kǝthlǝm Farta mǝthlan nech kǝ yahraˈan. <verse eid="1JN 4:8" /><verse number="9" style="v" sid="1JN 4:9" />Ə mbanɗi pǝnamǝn ndǝ Farta yahraˈan ˈyan hayan ya. Fǝrtǝ Wanɗengthlutiyan kǝ hur heshi, kǝthlǝm tǝmɗiyan kǝ mbǝsmǝn shishingndǝ kǝ kwekǝchi. <verse eid="1JN 4:9" /><verse number="10" style="v" sid="1JN 4:10" />Kǝɗaya naa yahraˈan yi kit. Ndaˈan nech kǝ, ngga nggǝmǝn yahchi Farta wa, mǝthlan yahchi minchi, thlǝnkan Waˈyan kǝ fǝrtǝ shishingndiyan kǝthlǝm kalamǝnchǝ ɓǝɓifechˈyamǝn ha.<verse eid="1JN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11" />Nafchinchi fee yahti, chokkan wa yah Farta minchi kǝɗaya, kǝmchansi nggǝmǝn paɗ kǝ yahmǝnraˈan. <verse eid="1JN 4:11" /><verse number="12" style="v" sid="1JN 4:12" />Nefsi tamchi naa Farta tǝ wenita wa. Maa thlǝ yahchamǝn raˈan, Farta mǝthlǝn hur mǝn, yahraˈan ˈyan ndiiɗ ha hurmǝn.<verse eid="1JN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13" />Tǝ mbanɗiya sǝndǝmǝn wa nggǝmǝn choktǝ ǝ hwirˈyan, mǝthlan paɗ hurmǝn, kǝthlǝm fǝramǝn tǝ Shemetˈyan. <verse eid="1JN 4:13" /><verse number="14" style="v" sid="1JN 4:14" />Nimǝn tǝ wenitiyamǝn, paɗ nggǝmǝn mbaˈandǝ nafcha ndat wa, thlǝn Papa Farta Waˈyan kǝthlǝm Thlǝt nafchi heshi. <verse eid="1JN 4:14" /><verse number="15" style="v" sid="1JN 4:15" />Nat thla ndech wa Yesu Waˈi Farta nakan, pǝnchan wa Farta hwirˈyan, mǝthlan paɗ hwiri Farta. <verse eid="1JN 4:15" /><verse number="16" style="v" sid="1JN 4:16" />Kǝthlǝm nggǝmǝn tǝ indiyamǝn ǝ sǝnmǝn, paɗ fǝrkamǝn kit kǝ yahraˈan tǝɗi nessi Farta kǝthlǝm nggǝmǝn.</para>
  <para style="p" vid="1JN 4:16">Farta mǝthlan nech kǝ yahraˈan, nat thla thlǝ pǝnchi yahraˈan, mǝthlan ɗas hwiri Farta, Farta paɗ mǝthlan hwirˈyan.<verse eid="1JN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1JN 4:17" />Yahraˈan ˈyan chokkan kǝ ndiiɗan hurmǝn, kǝthlǝm kǝ chok mǝn tǝ lekǝta wa fartǝɗi naa Farta chakan mee heshi. Kǝthlǝm kǝɗ ǝnɗi naa Kǝristi, kǝɗu paɗ natmǝn hur heshiɗiya. <verse eid="1JN 4:17" /><verse number="18" style="v" sid="1JN 4:18" />Mǝɗi naa yahraˈan i Farta, lekǝt si minni wa. Kǝthlǝm yahraˈan thla ndiiɗ chǝha thlǝ rǝkchan lekǝta. Thleya pǝnchan wa nat nafɗi nech lekǝta nggǝ yahraˈan sǝ hwirˈyan thla ndiiɗ chǝha wa.<verse eid="1JN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19" />Nggǝmǝn yahraˈan, kǝthlǝm Farta yahchiminchi terkwathl kanan. <verse eid="1JN 4:19" /><verse number="20" style="v" sid="1JN 4:20" />Maa ǝ ndi yowun wa, “Nggǝt yahinchi Farta,” paɗ mǝthlan kar sheɗan thlǝ fǝr kit, nef ini thlǝ lekta. Kǝthlǝm nat thla yahwakchi wanmanan thla thlǝ natǝn, nechan mbahǝn yah Farta wa kǝni thla tamwaktǝn nata? <verse eid="1JN 4:20" /><verse number="21" style="v" sid="1JN 4:21" />Kusiˈ tǝɗi fǝramǝn ndǝ Kǝristi ndaˈan nech kǝ, nat thla thlǝ yahchi Farta, nwaat kǝ yahtǝ sheɗan thlǝ fǝr kit paɗ.<verse eid="1JN 4:21" /></para>
  <chapter eid="1JN 4" />
  <chapter number="5" style="c" sid="1JN 5" />
  <para style="s">Fǝr kit nech kǝ mban mbǝrandǝ alkǝti heshi ha</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1" />Nat thla fǝrchi kit tǝ ndat wa Yesu nech kǝ Kǝristi, nafɗiya waˈi Fartǝ nakan. Nat thla yahchǝ Chinan nan yah wanan paɗ. <verse eid="1JN 5:1" /><verse number="2" style="v" sid="1JN 5:2" />Ə mbanɗi natmǝn sǝndǝya wa nggǝmǝn yah wanchi Fartǝ ya, maa thlǝ yahchamǝn Farta paɗ thlǝ nechamǝn para kusiˈ ˈyan. <verse eid="1JN 5:2" /><verse number="3" style="v" sid="1JN 5:3" />Yah Farta yi kit ndaˈan nech kǝ, thlǝnamǝn kusiˈchiyan, paɗ kusiˈyan ˈyangˈyang kǝ par fee wa. <verse eid="1JN 5:3" /><verse number="4" style="v" sid="1JN 5:4" />Kǝthlǝm chǝka wun Waˈi Farta alkǝtˈyansi kǝ ɓǝra heshi. Fǝrkitˈyamǝn kǝmɗi Kǝristi ndaˈan thlǝ fǝramǝnchi alkǝt ɗiya. <verse eid="1JN 5:4" /><verse number="5" style="v" sid="1JN 5:5" />Wun nech tǝ alkǝt fa kǝ ɗar heshiɗiya? Thla fǝrchi kit wa Yesu Waˈi Farta.<verse eid="1JN 5:5" /></para>
  <para style="s">Mbuˈ ǝnɗi sǝndǝ nef kǝ ɗar Waˈi Farta</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6" />Pǝn fee wa Yesu Kǝristi nech kǝ Waˈi Farta, tǝmɗi baptisma tǝɗi chandǝ fee hur ema, tǝ farɗi thlǝrandǝn kaɗ ɗar palang nda. Ɓawa tǝmɗi em ndak wa, ɓechan tǝmɗi ema tǝ fera. Shemeta mbuˈchǝ ǝnɗi sǝndǝn kǝɗu kǝ ɗaran. kǝthlǝm Shemeta mǝthlan nech kǝ kit. <verse eid="1JN 5:6" /><verse number="7" style="v" sid="1JN 5:7" />Ichisi mahkan fee mbuˈchǝ ǝnɗi sǝndǝ nda kǝ ɗaran, ndat wa Yesu Wa ˈi Farta nakan. <verse eid="1JN 5:7" /><verse number="8" style="v" sid="1JN 5:8" />Fen nech kǝ Shemeti Farta, ˈyam chǝt baptisma, tǝ ferˈyan thla thlǝrandǝn kaɗi kǝthlǝm nggǝmǝn. Fen taˈan mahkandǝ yu ǝn artǝ nat ndǝ mbuˈta. <verse eid="1JN 5:8" /><verse number="9" style="v" sid="1JN 5:9" />Maa thlǝ nggǝman chamǝn ǝnɗi mbuˈtǝ nafcha thla sǝndǝ ndǝsi ndat wa kit, ai, sǝndi Farta pǝɗantǝ yi nafchi ha tǝ alkǝta. Kǝthlǝm thleya nech kǝ mbuˈ ǝnɗi sǝndǝ Fartǝsi, thla fǝrtǝn kǝ ɗar Waˈyan. <verse eid="1JN 5:9" /><verse number="10" style="v" sid="1JN 5:10" />Kǝthlǝm ndaˈan, nat nafɗi fǝrchǝ kit kǝ Waˈi Farta, nggǝmanchi tǝ ǝnɗi sǝndǝnsi ǝ hur wanɗǝkaɗatˈyan. Paɗ nat nafɗi fǝrwakchi kit kǝ Farta, chantǝ Farta kaɗ kǝ thlǝ lektǝ hacha. Kǝthlǝm fǝr wa kit kǝ in ǝnɗi sǝndǝ Fartǝsi kǝ ɗar Waˈyan wa. <verse eid="1JN 5:10" /><verse number="11" style="v" sid="1JN 5:11" />Thleya nech kǝ sǝnɗisi, ndat wa, fǝraminchǝ Farta shishingnda thla kǝ kwekǝchi. Shishingngǝnɗiya paɗ, nechan hwiri Waˈyan. <verse eid="1JN 5:11" /><verse number="12" style="v" sid="1JN 5:12" />Nat thla naa Wanan mǝɗiyan, shishingndiyansi. Paɗaa nat thla nawaktǝ Waˈi Fartǝs mǝɗiyan, ǝ shishingndiyan su wa.<verse eid="1JN 5:12" /></para>
  <para style="s">Shishingnda thla kǝ kwekǝchi</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13" />Kun tǝɗi fǝrchi kit kǝ Waˈi Farta, yarowunchǝ ichiɗiyasǝ nat kǝthlǝm kǝ sǝnwunsǝ wa shishingndiyowunsi thla kǝ kweˈkǝɗan. <verse eid="1JN 5:13" /><verse number="14" style="v" sid="1JN 5:14" />Thleya wathlamǝn chǝha tǝ ndat wa namǝn mbahan thlartǝ ha ǝ pangngǝn Farta lekǝt su wa. Kǝthlǝm sǝnmǝn wa chǝka mǝ shitǝmǝn tǝ yahtǝyan nan sǝk mǝnchi. <verse eid="1JN 5:14" /><verse number="15" style="v" sid="1JN 5:15" />Nakan sǝnmǝn wa thlǝ sǝkchan mǝnchi chǝk kwat shiyandǝmǝn ǝnayowun, sǝnmǝn tǝ ndat wa namǝn mbǝs ǝnɗi shitǝmǝn.<verse eid="1JN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16" />Maa ǝ ni yowun wanmanan thlǝ fǝr kit chǝt ɓǝɓifata thla saˈwakchǝ kǝ yi mǝrta, shiyankan kǝ in, Farta paɗ nan fǝran shishingnda. Nechi ndiktǝ kǝ ɗar fee saˈwaktǝ ɓǝɓifatˈyandǝ kǝ yi mǝrta. Ɓǝɓifatsi thla thlǝ saˈchǝ kǝ yi mǝrta, nda wi wa kǝ shi fee kǝ ɗar ndaˈan wa. <verse eid="1JN 5:16" /><verse number="17" style="v" sid="1JN 5:17" />Nat kumi kafata ɓǝɓifata, paɗ ngga chǝka yen ɓǝɓi fata thlǝ saˈchǝ kǝ yi mǝrta wa.<verse eid="1JN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18" />Sǝnmǝn wa nat nafɗi nech kǝ Waˈi Farta ɗǝwa kǝ pangnga tǝ chǝt ɓǝɓifata wa. Kǝthlǝm Waˈi Farta thlǝ nechan parat har tǝ ndi, kǝ chan Hweˈrǝ mboro fa wa.<verse eid="1JN 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 5:19" />Sǝnmǝn wa nggǝmǝn wanchi Farta, nat heshiɗiya paɗ nechan heri Hweˈra.<verse eid="1JN 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 5:20" />Sǝnmǝn wa ɓi Waˈi Farta kǝ hur heshi, paɗ fǝramǝn kan sǝn ǝna kǝ sǝnmǝn thla nech kǝyi kit. Nggǝmǝn paɗ hwiri thla nech kǝ kit, ndat wa hwiri Waˈyan Yesu Kǝristi. Mǝthlan nech kǝ Farta thlǝ kit paɗ thlǝ shishingnda kǝ kweˈkǝchi.<verse eid="1JN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21" />Wanchinchi fee yahti, kǝ wumowunchǝ ǝn ha tǝ maanandǝ ɗǝhacha wa.<verse eid="1JN 5:21" /></para>
  <chapter eid="1JN 5" />
</usx>