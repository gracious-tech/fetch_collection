<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GAL" style="id">GALATIYAWA</book>
  <para style="h">Galatians</para>
  <para style="toc1">Gal</para>
  <para style="toc2">Galatians</para>
  <para style="toc3">Galtiyawa</para>
  <para style="mt1">Galatians</para>
  <chapter number="1" style="c" sid="GAL 1" />
  <para style="s">Nda ǝna</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1" />Yaraɗiya ɓechan mǝɗi Ɓulus tatǝ kimshaa. Tatǝ kimshaa ngga nafchǝ thlincha wa, paɗ ngga wa nafchǝ taɗcha wa. Yesu Kǝrǝsti, tǝ Farta Chinda, thla thlaˈanchǝ Yesu Kǝristi hur mǝmatecha. <verse eid="GAL 1:1" /><verse number="2" style="v" sid="GAL 1:2" />Nggǝt nat tǝ wan manchǝmǝn tǝɗi nech thlǝmanna, nggaˈan ndowun ǝn fa, kun tǝɗi nat fǝrchǝ kit kǝ Farta ǝ hahi Galatiya.<verse eid="GAL 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3" />Kaakǝta tǝ kǝɓikaɗi i Farta Chinmǝn, tǝ yi Chinda Yesu Kǝrǝsti kǝ chok tǝ wunchi. <verse eid="GAL 1:3" /><verse number="4" style="v" sid="GAL 1:4" />Thla fǝrchi fatˈyan kǝthlǝm ɓǝɓifechˈyamǝn, kǝ hǝraˈaminchi hur ɓǝɓi yuwa heshiɗiya, tǝmɗi sakti Fartiyamǝn tǝ Chinmǝn. <verse eid="GAL 1:4" /><verse number="5" style="v" sid="GAL 1:5" />Kǝmɗiyan maanda kǝ kweˈkǝchi, kǝ kweˈkǝchi. Kǝ chok kǝɗu.<verse eid="GAL 1:5" /></para>
  <para style="s1">Ndikti Farta thla nech mbinchan artǝ ndak</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6" />Sakichǝ inda, weshet wun ha kǝ malwun thla ha ˈyech wunchi, kǝthlǝm kǝ nowun ha hur kaakǝti Kǝrǝsti, nakowun para yowun kwastǝ ndiktǝ samǝn. <verse eid="GAL 1:6" /><verse number="7" style="v" sid="GAL 1:7" />Kittaˈan, yowun kwastǝ ndiktǝs samǝm wa, nechi mbuˈtǝ kǝɗu kǝthlǝm fowun si thlǝ nech hurandǝ hur inchi yowun, paɗ nakandǝ kweˈtǝ ha kǝ tǝɓrandǝ kwastǝ ndiktǝ ha mbinchan yi sǝkta, i Kǝristi.<verse eid="GAL 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 1:8" />Paɗaa chǝka nggaˈan, ndu yowun thlǝ thlǝndi Farta ǝ hulafǝrta, ma mbuˈowun tǝ kwastǝ ndiktǝ samǝn, mǝni thlat lat ǝn ɓasowun nda. Kǝ kǝsan chak meˈi Farta kǝ indiyan. <verse eid="GAL 1:8" /><verse number="9" style="v" sid="GAL 1:9" />Kǝɗ thla mbuˈtǝ ǝn choh, kǝɗu paɗ nati nggǝr mbuˈta, ndat wa chǝka wun ɓassowun chǝ kwastǝ ndiktǝs mbinchan samǝn tǝ thla thlǝtwun, kǝ ɓi chak meˈi Farta kǝ indiyan.<verse eid="GAL 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10" />Nggǝt tǝ ni ka yahti nefa ndu yi Farta wa? Ndu tǝni kweˈtǝ ha kǝ tǝrani wanɗǝkaɗati nafchǝ ha wa? Mamwa paˈkǝ nankanya tǝ ni yahta kǝ tǝranni wanɗǝkaɗati nafchǝ ha, mǝ chokwi kǝ mafati Kǝrǝsti wa.<verse eid="GAL 1:10" /></para>
  <para style="s">Mbanɗi chok tǝ Bulus kǝ tatǝ kimshaa</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11" />Wanmanchina, yahchi si kǝ sǝnowunchi sǝ wa, kwastǝ ndiktiɗi mbinchan ɓassowun ndi si ngga yi pong nefa wa. <verse eid="GAL 1:11" /><verse number="12" style="v" sid="GAL 1:12" />Kǝthlǝm ngga mǝɗi nef mbǝsti wa. Paɗ ngga tǝ chaˈichǝ fee har wa. Kǝɗu thlichi mǝɗi Yesu Kǝrǝsti, tǝmɗi pǝn indiyan kǝmɗinchi.<verse eid="GAL 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13" />Sǝkwun kusheˈtǝ choktinchi choh hur para mbandi Yahudawecha. Sǝkwun mbanɗi ɓahandi fǝ tǝr mbanchi Farta tǝ alkǝtfa. Kweˈinchǝ ha kaan kǝthlǝm kǝ timmani tanda. <verse eid="GAL 1:13" /><verse number="14" style="v" sid="GAL 1:14" />Paɗ ǝ mbǝrani mbǝrchin ha fee nech kǝ Yahudawecha kǝɗ nggǝta, ǝ hur chaˈati tǝr mbandi Yahudawecha. Fǝrinchi fatsǝ kaan kǝ para ǝna chiti kaakech na.<verse eid="GAL 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 1:15" />Paɗaa taɗ kǝ Farta nenchi kǝn fee nggǝt nenchi, ˈyakan nenchi tǝmɗi kafatˈyan, ɗǝpan kan wa kǝmsi, <verse eid="GAL 1:15" /><verse number="16" style="v" sid="GAL 1:16" />pǝnkan Waˈyan tǝmɗinchi, kǝthlǝm kǝ ɓasi pǝthlǝr pong nafcha. Saka wi ha tǝ nefa wa. <verse eid="GAL 1:16" /><verse number="17" style="v" sid="GAL 1:17" />Ɗǝwi kǝ Urshelima kǝ ni fee lech choktǝ kǝ tatǝ kǝmsicha, mǝ nggǝta wa. Kǝɗu, pǝɗaki kǝ hahi Larabawa, thlaˈtǝ minni nggǝrki nggǝranndǝ in kǝ Dimaska.<verse eid="GAL 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 1:18" />Kǝrsǝ hurat mahkan pǝɗaki kǝ Urshelima kǝ naa Kefas. Chokki tǝ ndi mǝndǝ kum nggǝrsǝ ɗǝrman. <verse eid="GAL 1:18" /><verse number="19" style="v" sid="GAL 1:19" />Nawi chǝka artǝ hur takǝt tatǝ kǝmsicha wa, Yakubu ndak, wanman Chinda <verse eid="GAL 1:19" /><verse number="20" style="v" sid="GAL 1:20" />Ənɗi nati yarowun ndǝs ya, kittaˈan nati mbuˈowun nda ǝ pangngǝn Farta, ngga lekta wa.<verse eid="GAL 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 1:21" />Kǝrsaɗan, pǝɗaki kǝ hahi Suriya tǝ hahi Kilikiya. <verse eid="GAL 1:21" /><verse number="22" style="v" sid="GAL 1:22" />Kǝɗu paɗ kǝtǝn shichiɗi Kǝristi, thla nech ǝ hahi Judiya sǝn wandǝ nenchǝ kwaɗǝn wa. <verse eid="GAL 1:22" /><verse number="23" style="v" sid="GAL 1:23" />Kusheˈtaˈan ndak sǝk tǝnda tǝ ndat wa, “Nafɗi choh thlǝ nech fǝranmǝn panchǝ yu, nakanya mǝthlan ɓas fǝrkit tǝɗi choh kweˈtǝn ha kǝ timanchi.” <verse eid="GAL 1:23" /><verse number="24" style="v" sid="GAL 1:24" />Maanan kandǝ Farta kǝthlǝm nggǝta.<verse eid="GAL 1:24" /></para>
  <chapter eid="GAL 1" />
  <chapter number="2" style="c" sid="GAL 2" />
  <para style="s1">Thlǝ takǝt tatǝ kǝmsichǝ Bulus</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1" />Kǝrsǝ hurech kum nggǝrsǝ foɗɗa, nggǝrki ngǝrandǝ in kǝ Urshelima, nggaˈan tǝ Barnabas. Paɗ ɗǝf ki Titus kǝ para nenchi. <verse eid="GAL 2:1" /><verse number="2" style="v" sid="GAL 2:2" />Nggǝta ɗichi kafǝr kǝ Urshelima, kǝthlǝm tǝ pǝnichǝ Farta fata kǝɗ sǝnaˈta kǝɗi. Mbuˈani fee tǝrtǝ fee tanda wa, fen nech kǝ paktechi fǝ tǝrmbancha tǝ wuɓtǝ fa. Ɓaas ɗi chiti hur pong nafcha. Kǝthlǝm kǝ sǝni kweˈtǝ ɗi ha nati chita, tǝ thla lati chita, kǝ chok kǝ kohaɗan wa. <verse eid="GAL 2:2" /><verse number="3" style="v" sid="GAL 2:3" />Chǝka Titus tǝɗi nech tǝ nenchi, kweˈ ˈya wu fee kaf kǝ hecha wa, chǝka nakan wa mǝthlan kǝ thlǝ Helenawata.<verse eid="GAL 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 2:4" />Thlaˈchǝ ndiktǝɗiya kǝthlǝm fowun wanmancha kǝ fǝ lekcha, fee yimandǝ fee tandǝs ǝ wuɓtǝ fa. Fee yircha kǝthlǝm kǝ ɓandǝ tawus chokta, yi indiyaˈan, thla nech si yaˈan hur Kǝrǝsti Yesu. Kǝthlǝm kǝ nggǝraˈanchǝ ndǝ kaɗ kǝ mafecha. <verse eid="GAL 2:4" /><verse number="5" style="v" sid="GAL 2:5" />Chǝka kǝɗu, kalawa ǝn fat tandǝ ha wa chǝka ngguɗyeh. Kǝthlǝm kittaˈan i kwastǝ ndikta kǝ chokowunchi fa.<verse eid="GAL 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6" />Fee tǝrtǝ fee choh wa fen nech kǝ Paktechaˈan (Chǝka nechandǝ kǝ micha, nat arta mǝɗinchi, kǝthlǝm taɗwu Farta har wa). Chekawandǝ ǝn kǝ ɗar ǝnɗi ɓasi wa. <verse eid="GAL 2:6" /><verse number="7" style="v" sid="GAL 2:7" />Kǝɗu, nii ndǝ tǝ ndat wa, Farta fǝritǝ heˈta yi ɓassa ndǝ pong nafcha, kǝɗ thla fǝrandǝn Biturus kǝ ɓassan tǝ fee hechecha. <verse eid="GAL 2:7" /><verse number="8" style="v" sid="GAL 2:8" />Kǝthlǝm Farta thla chich tera hur wanɗǝkaɗati Biturus ɗǝftǝn anchi kǝ tatǝ kimshaa, kǝ ɗar fee hechecha, mǝthlan paɗ chǝt ter hur wanɗǝkaɗatinchi ɗǝf kan nenchi kǝ choki kǝ tatǝ kimshaa kǝmɗi fee heche wakcha. <verse eid="GAL 2:8" /><verse number="9" style="v" sid="GAL 2:9" />Kǝ nak Yakubu, tǝ Biturus,<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">Greek </char><char style="fqa" closed="false">Kefas; </char><char style="ft" closed="false">Paɗ hur 2:11, 14.</char></note> tǝ Yohanna fee sǝndǝ fee wa Fen nech kǝ paktecha, fee nech kǝ njin fǝ tǝr mbancha, kǝ nakandǝ kaakǝɗ ɗi chitǝ Farta, thlǝ kandǝ nggaˈan tǝ Barnabas harchǝ chap chap, nggǝman kanda wa kǝ chǝ ǝn ter nat ǝn. Nggaˈan kǝ ɗǝ ǝn kǝmɗi pong nafcha, fen paɗ kǝmɗi fee hechecha. <verse eid="GAL 2:9" /><verse number="10" style="v" sid="GAL 2:10" />Nat ǝnɗi nda ǝn ndǝ ndak wa, kǝ kuɗukta tǝ fǝ ɓahcha, kapa ǝnɗi ɗǝfti kǝfatsi kǝ chi hacha.<verse eid="GAL 2:10" /></para>
  <para style="s1">Yanan Bulus, Biturus ha ǝ Antakiya</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11" />Kǝ ɓak Kefas kǝ Antakiya, yaananki ha kǝ hur chimandiyan, kǝthlǝm ǝnɗi chǝtǝn keˈkeˈ wa. <verse eid="GAL 2:11" /><verse number="12" style="v" sid="GAL 2:12" />Kǝn fowun nafchǝ ɓata thlaˈtǝ mǝɗi Yakubu, thlǝ sǝmchan ɗǝsǝmnda tǝ pong nafcha. Kǝɗu kǝ saˈkanda, nggǝrang kan fat kǝrsǝn mǝɗi pong nafchaˈan, sǝm wa ǝn tǝ tandǝ paɗ wa, kǝthlǝm mǝthlan lekandǝ nafcha fee thlǝ ndech wa, nwaat kǝ hechan fee nafcha. <verse eid="GAL 2:12" /><verse number="13" style="v" sid="GAL 2:13" />Kǝɗu takǝt Yahudawechaˈan fǝ tǝr mbancha, pǝn kandǝ kumi fǝrkit kǝ mǝthlan, chǝka Barnabas hurandǝ indiyan kaɗi tǝ wenikǝt ˈyanda.<verse eid="GAL 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 2:14" />Paɗaa kǝ naki tandǝ para kittaˈan i kwastǝ ndiktaˈan kaan wa, ndang ki Kefas ǝ pangǝn chika wuni nat ndat wa, “Cha thlǝ Yahudawat nako, chǝka kǝɗu, natˈyo ha kǝɗ pong nefa, ngga kǝɗ thlǝ Yahudawata wa, michicha natu kweˈyandǝ pong nafchǝ fa kǝ parandǝ tar raˈati Yahudawecha?<verse eid="GAL 2:14" /></para>
  <para style="s">Hǝraˈan fee Yahudawecha tǝ pong nafcha tǝmɗi fǝr kit</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15" />“Nggǝmǝn tǝɗi nggǝttǝ fǝ kǝ Yahudawecha, ngga pong nafcha fǝ chǝt ɓǝɓifecha wa, <verse eid="GAL 2:15" /><verse number="16" style="v" sid="GAL 2:16" />sǝnmǝn wa, nefa nggǝch mbǝs hǝraˈta tǝmɗi para kusiˈ, maangga tǝmɗi fǝr kit kǝ Yesu Kǝrǝsti ndak wa. Kǝthlǝm ndaˈan nggǝmǝn paɗ, fǝrmǝn kit kǝmɗi Kǝrǝsti Yesu, kǝ chapamǝn chǝ fee kaɗi tǝmɗi fǝr kit kǝ ndi, ngga wa tǝmɗi tarchi kusiˈ wa. Kǝthlǝm tǝmɗi tarchi kusiˈ yowunsi nech mbǝs hǝraˈta wa.<verse eid="GAL 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 2:17" />“Maa ǝ hur kweˈtǝ yamǝn ha kǝ hǝraˈmǝn tǝmɗi Kǝrǝsti, mbǝsamǝn kǝ fee nggǝmǝn Yahudawecha kǝ fǝ ɓǝɓifecha, chokchan wa Kǝrǝsti tǝthl ndiksantǝ ɓǝɓifat hacha wa? Auwa, ngga kǝɗu wa. <verse eid="GAL 2:17" /><verse number="18" style="v" sid="GAL 2:18" />Maa ǝ nggǝrinchi tǝnandǝ ǝnɗi foha ndi ha choh, tǝni wathla ndǝ ha wa nggǝt thlǝ ɓǝɓifata. <verse eid="GAL 2:18" /><verse number="19" style="v" sid="GAL 2:19" />Kǝthlǝm nggǝta tǝmɗi kusiˈ kǝ choki kǝ mǝrta kǝmɗi kusiˈ, kǝthlǝm maˈ ni nat ha tǝ shishingndǝ fa kǝ Farta. <verse eid="GAL 2:19" /><verse number="20" style="v" sid="GAL 2:20" />Kukwichi fee nat tǝ Kǝrǝsti. Nakanya ngga nggǝt peˈchǝ ha wa, kǝɗu Kǝrǝsti nech tǝ shishingnda ǝ hwirinchi. Naɗi ha nati chit nakanya ǝ hur fata, nggǝt chǝta ǝ hur fǝr kit, ǝ hur Waˈi Farta thla yahchǝ nenchi, thla fǝrchǝ shishingndiyan kǝthlǝm nggǝta. <verse eid="GAL 2:20" /><verse number="21" style="v" sid="GAL 2:21" />Ɗǝf wi kaakǝti Farta kǝ kǝlar wa, kǝthlǝm mamwa naa fee mbǝs kakǝti Farta tǝmɗi para kusiˈ, pinchan wa, mǝrti Kǝrǝsti kohaɗan.”<verse eid="GAL 2:21" /></para>
  <chapter eid="GAL 2" />
  <chapter number="3" style="c" sid="GAL 3" />
  <para style="s">Kusiˈ ndu fǝr kit wa</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1" />Kun ɓamchi Galatiyawecha wun tǝranchi hur inchiyowun? Kun tǝɗi pǝnowundǝ fee hayang, mbanɗi kukwandǝ fee Yesu Kǝristi ɓǝra palangda. <verse eid="GAL 3:1" /><verse number="2" style="v" sid="GAL 3:2" />Ən artǝ ndak nati chihowunda. Mbǝschowun shemeti Farta tǝmɗi chit tarchǝɗi mbuˈtǝ kusiˈ wa, ndu paɗ tǝmɗi fǝr kit kǝ ndiktǝɗi sǝktǝ wun wa? <verse eid="GAL 3:2" /><verse number="3" style="v" sid="GAL 3:3" />Awi, ɓamkǝt ˈyowun ǝ sheˈ kǝɗaya wa? Ə tǝrwun kanan har tǝ Shemeta, nechowun tǝɓandǝ ha tǝ saktǝ yi fata wa? <verse eid="GAL 3:3" /><verse number="4" style="v" sid="GAL 3:4" />Awi, pafǝn satwun ɓahtǝ ha samǝn samǝn wa? Nggǝta sǝninchi wa ngga pafǝn wa. <verse eid="GAL 3:4" /><verse number="5" style="v" sid="GAL 3:5" />Awi mǝthlan tǝɗi, fǝrowunchi Shemetˈyan, chǝkan tarcha yi saka incha ǝ hur ɗǝfi tǝ wun. Chichan kǝɗu tǝmɗi tarchi kusiˈ tǝɗi chit wun wa, ndu tǝmɗi fǝr kitˈyowun kǝ ǝnɗi sǝk tǝ wun wa? <verse eid="GAL 3:5" /><verse number="6" style="v" sid="GAL 3:6" />Kǝɗu paɗ Ibrahim fǝrtǝ kit kǝmɗi Farta, “Fǝr kit tǝ ini ˈyan yu, shengan fee kǝ chok kǝ kaakǝta kǝmɗiyan.”<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="ft" closed="false">Gen 15:6.</char></note><verse eid="GAL 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 3:7" />Kǝ sǝnwun wa, fee nech tǝ fǝr kit fa, fen nech kǝ wanchi Ibrahim. <verse eid="GAL 3:7" /><verse number="8" style="v" sid="GAL 3:8" />Mbǝsan fee hur Laulawaɗan, ndat wa, Farta nan nggǝrandǝ fee kaɗ nowakchǝ kǝ Yahudawecha, kǝ chok ndǝ kǝ fǝ kakicha, tǝmɗi fǝrkitǝɗi nessi yanda. Ndaˈan chicha, choh ndandǝ fee Ibrahim hur kusheˈtǝ kwastǝ ndiktǝ mbinchan tǝ ndat wa, “Tǝmɗi yo naa fee fǝran pong nafchǝ mbǝs ǝn har.”<note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="ft" closed="false">Gen 12:3; 18:18; 22:18.</char></note> <verse eid="GAL 3:8" /><verse number="9" style="v" sid="GAL 3:9" />Kǝthlǝm ndaˈan, fee fǝrchǝ kit, fen ɗǝfandǝ fee mbǝs ǝn tandǝ kǝ har, kǝɗ ǝnɗi ɗǝfandǝ fee Ibrahim thlǝ fǝr kit.<verse eid="GAL 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10" />Tǝ kǝɗu fee ɗǝfchǝ kǝfatsi kǝ tarchǝɗi mbuˈtǝ kusiˈ wa kǝ chǝ fee, naa fee chakan mee tanda. Kǝthlǝm ǝ yaran fee ha tǝ ndat wa, “Nat nefa thla para wakchǝ nat ǝnɗi yara fee hur Laulawati kusiˈ, paɗ thlǝnawa wa naa fe chakanda mee.” <verse eid="GAL 3:10" /><verse number="11" style="v" sid="GAL 3:11" />Ə wethl ha wa nefsi nech mbǝs mban hǝraˈta ǝ pangngǝn Farta tǝmɗi para kusiˈ wa. Kǝthlǝm, “Thla naa kaakǝt ˈyansi tǝmɗi fǝr kit mǝthlan nech nat ha.”<note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false">Hab 2:4.</char></note> <verse eid="GAL 3:11" /><verse number="12" style="v" sid="GAL 3:12" />Kusiˈ thlarwa ha kǝ ɗar fǝr kit wa. Kǝthlǝm ndech kusiˈ wa, “Thla thlǝ thlǝnanchǝ ichiɗiya nan nat ha tǝmɗiyanda.”<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">Lev 18:5.</char></note><verse eid="GAL 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 3:13" />Nakanya Kǝrǝsti tapi thlǝt minchi hur chak meˈi kusiˈ tǝ anchi, tǝmɗi chokta kǝ thlǝ thǝt chak mee kǝthlǝm nggǝmǝn. Kǝthlǝm yaranchǝ fee ha ndat wa, “Nat thla kukwandǝ fee kǝ ɓǝra ɗǝfta, thlǝt chak mee.” <verse eid="GAL 3:13" /><verse number="14" style="v" sid="GAL 3:14" />Chich fee ǝnɗiya kǝthlǝm mbǝs ǝnaɗi har chandǝ fee Ibrahim, kǝ ɓǝ kǝ ɗar pong nafcha tǝmɗi Kǝrǝsti Yesu. Nggǝmǝn paɗ tǝmɗi fǝr kit kǝ mbǝsmǝn Shemeɗiya thla ɗǝftǝ fee miyan.<verse eid="GAL 3:14" /></para>
  <para style="s">Kusiˈ tǝ ɗǝf mee</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15" />Wanmanchina, ni fǝrowun saktaˈan hur naaɗi ha ya. Chǝka ɗǝf mee ǝ pǝthlǝr nafcha, nefsi nech mbahǝn mbeɗandǝ ha wa, ma tapi wethl ha. Nefsi nech mbahǝn chekandǝ ǝn kǝ ɗaran paɗ wa. <verse eid="GAL 3:15" /><verse number="16" style="v" sid="GAL 3:16" />Fǝrchǝ Farta ɗǝf michaˈan kǝmɗi Ibrahim tǝ yowun hur nafchiyan.<note caller="*" style="x"><char style="xo" closed="false">3:16: </char><char style="xt" closed="false"><ref loc="GEN 12:7">Far 12:7</ref></char></note> Ndawu fee wa tǝ kwathlˈcha wa, kǝɗ nechandǝ terchan wa, auwa, arta nda fee, “Yowun hur nafchiyo.” Ndat wa, Kǝristi. <verse eid="GAL 3:16" /><verse number="17" style="v" sid="GAL 3:17" />Ənɗiya nati sakta: Kusiˈtǝɗi fǝrtǝ fee hurechǝ kum chit kum foɗɗa tǝ kum chit mahkan ǝ kǝrsa, nech chentǝ ɗǝf miɗi kaɗ thla wathlandǝn Farta ha kǝ choh wa. Nech chokan tǝ ɗǝf miyan kǝ kohaɗan wa. <verse eid="GAL 3:17" /><verse number="18" style="v" sid="GAL 3:18" />Mamwa sǝm kǝrsǝ mǝrtǝɗiya thlǝ mbǝschǝ fee tǝ mban kusiˈ, awi mǝ nech chok kǝ yi ɗǝf me wa. Kǝɗu fǝranchǝ Farta Ibrahim tǝmɗi ɗǝf mee.<verse eid="GAL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19" />Mǝ chicha fǝr tǝ fee kusiˈ? Fǝrchǝ fee kusiˈ taˈan kǝthlǝm nafcha kǝ naa ndǝ ɓǝɓifechˈyandǝ ha. Nech kusiˈtaˈan choktǝ kǝ fartǝɗi naa Wanan thla ɗǝftǝ fee miyan nan ɓat hur kwalth Ibrahim. Fǝrchǝ fee kusiˈtaˈan tǝmɗi fǝ thlincha, tǝ paɗ ɗǝfan kǝ fee thla hurɗǝfi kǝ hera. <verse eid="GAL 3:19" /><verse number="20" style="v" sid="GAL 3:20" />Maa tǝn fee ndik thla thlarchǝ hurɗǝfi, ngga kǝthlǝm nef arta wa. Kǝɗu Farta nechan arta.<verse eid="GAL 3:20" /></para>
  <para style="s">Saktǝ kusiˈ</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21" />Chokcah kusiˈ tǝn chǝt atekrikǝt tǝ ɗǝf meˈi Farta hacha wa?<note caller="*" style="x"><char style="xo" closed="false">3:21: </char><char style="xt" closed="false"><ref loc="ROM 8:2-4">Rom 8:2-4</ref></char></note> Auwa, ngga kǝɗu wa chǝka ngguɗyeh. Mamwa tǝ fǝr fee yowun kusiˈ thla nech fǝr shishingnda, mǝ naa fee mbǝs kaakǝta pangngǝn Farta tǝmɗi kusiˈ. <verse eid="GAL 3:21" /><verse number="22" style="v" sid="GAL 3:22" />Paɗaa Yara ndikti Farta ǝ nggǝlan tǝ chǝka wuni kǝ hur ɓǝɓifata, kǝthlǝm mbǝs ǝnaɗi har ɗǝf tǝn miyan, tǝmɗi fǝr kit kǝ Yesu Kǝrǝsti, kǝ fǝr fee anchi kǝmɗi fee fǝrchǝ kit.<verse eid="GAL 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23" />Kǝn fǝr kit ɓata thla nech hur Kǝrǝsti, kusiˈ ǝ nggǝlaminchi kǝɗ nafchǝɗi nggǝlandǝ fee kǝ hur pursuna, kǝɗu kǝ fartǝɗi che fǝr kit kesh ǝ kǝrsa.<verse eid="GAL 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GAL 3:24" />Awi kusiˈ, ɗǝpech minchi har kǝ fartǝɗi ɓa Kǝristi. Kǝthlǝm kǝ mbǝs mǝn hǝraˈta ǝ pangngǝn Farta tǝmɗi fǝr kit. <verse eid="GAL 3:24" /><verse number="25" style="v" sid="GAL 3:25" />Nakanya kǝ ɓa fǝr kit tǝɗiya, peˈwamǝn hari thla nech ɗǝpaminchi har wa.<verse eid="GAL 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26" />Kǝthlǝm nat wun nechowun kǝ wanchi Farta tǝmɗi fǝr kit kǝ Yesu. <verse eid="GAL 3:26" /><verse number="27" style="v" sid="GAL 3:27" />Nat wun kun tǝɗi chowundǝ fee baptisma ǝ hur Kǝristi, ǝ tǝr wun ǝna chǝti Kǝristi. <verse eid="GAL 3:27" /><verse number="28" style="v" sid="GAL 3:28" />Peˈwu ndatsǝ wa thlǝ Yahudawata, ndu pong nafcha, ndu waa, ndu mafata, ndu hishnefa ndu nunefa wa. Kǝthlǝm nat wun nechowun artǝ hur Kǝristi Yesu. <verse eid="GAL 3:28" /><verse number="29" style="v" sid="GAL 3:29" />Maa paɗ yi Kǝristi nakowun, kun nech kǝ kwathl Ibrahim, fǝ sǝm kǝrsǝ mirchiyan paɗ, kǝ ɗǝf miɗiya.<verse eid="GAL 3:29" /></para>
  <chapter eid="GAL 3" />
  <chapter number="4" style="c" sid="GAL 4" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1" />Tǝn fee sakta wa, thlǝ sǝm kǝrsǝ mǝrta, ma peˈchan kǝ wanwaa, nechan keˈkeˈ tǝ mafata, chǝka mǝnakan wa mǝthlan malandǝ fee chǝka mi ha nat. <verse eid="GAL 4:1" /><verse number="2" style="v" sid="GAL 4:2" />Nechan nat hari thla thlǝ parech tǝ anchi, tǝ fee thlǝ kǝschǝ ichaˈan har kǝ fartǝɗi fǝrtǝ chinan wa kǝ pǝnan fee ichiˈyan. <verse eid="GAL 4:2" /><verse number="3" style="v" sid="GAL 4:3" />Nechan kǝɗu ǝ mǝɗiyamǝn, tǝ ndat wa, peˈtǝmǝn kǝɗ wanwancha, chokmǝn kǝ mafechi tar raˈecha thla ɗǝftǝ nafchi heshi.<verse eid="GAL 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 4:4" />Paɗaa kǝ ndiiɗ kǝ wanminchaˈan ha, thlǝn kǝ Farta Waˈyan, thla nggǝttǝ nunefa, nggǝttǝ fee paɗ ǝ fǝl kusiˈ. <verse eid="GAL 4:4" /><verse number="5" style="v" sid="GAL 4:5" />Kǝthlǝm kǝ hǝraˈan tǝ fee nech kan kusiˈ, kǝ nggǝraminchǝ fee kaɗ kǝ wanchi Farta. <verse eid="GAL 4:5" /><verse number="6" style="v" sid="GAL 4:6" />Kǝthlǝm kun wanchiyan, thlǝn kǝ Farta shemeti Waˈyan kǝ hur wanɗǝkaɗech ˈyamǝn, nakan ˈyat wa, “Abba, Papa”<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="fq" closed="false">Abba </char><char style="ft" closed="false">nechan tǝ mee i Aramiyawecha thla pinchawa “Papa.”</char></note> <verse eid="GAL 4:6" /><verse number="7" style="v" sid="GAL 4:7" />Kǝthlǝm ndaˈan, nakanya ngga mafat nako paɗ wa, chǝ waˈyan. Nakanya chǝ Waˈyan, Farta nggǝruchǝ kaɗ kǝ thlǝ sǝm kǝrsǝ mǝrtaˈan.<verse eid="GAL 4:7" /></para>
  <para style="s">Thlaˈ hur indi Bulus kǝ ɗar Galatiyawecha</para>
  <para style="m">
    <verse number="8" style="v" sid="GAL 4:8" />Choh fartǝɗi sǝn waktǝwun Farta, chok wun kǝ mafecha tǝmɗi manandǝ ɗǝhacha, fee thlǝ mbahǝn wakchǝ chǝt ǝna. <verse eid="GAL 4:8" /><verse number="9" style="v" sid="GAL 4:9" />Paɗaa nakanya kǝ sǝn kowun Farta, ndu kǝ ndǝ fee wa sǝn Farta wunchi, tǝ kǝni nat wun nggǝr nggǝrandǝ in kǝ fǝl kusiˈ tǝ tar raˈechi heshi, fee nggawakchǝ thlee ndǝ ǝn kaɗi. Michicha nggǝrawun in kǝ chok wun kǝ mafechˈyanda hacha? <verse eid="GAL 4:9" /><verse number="10" style="v" sid="GAL 4:10" />Thlǝ parechowun parcha, tǝ ndǝricha, tǝ wanshengngǝncha, tǝ hurecha. Mbǝrowun wandǝ ha wa. <verse eid="GAL 4:10" /><verse number="11" style="v" sid="GAL 4:11" />Ənɗi thlǝ chǝtwun fǝritǝ lekǝt kaan, kǝthlǝm kǝ chok wa ɓahtinchi ha pǝthlǝr wun, kǝn pafǝn wa.<verse eid="GAL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12" />Nggǝt shiyowun nda, wanmanchina, chokam kǝɗ nggǝta, kǝɗ thla chokti kǝɗ kun. Tam wowun chi ǝna thla nech kǝ sǝɓtaˈan wa.<verse eid="GAL 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 4:13" />Sǝn wunsǝ wa, kǝthlǝm hatǝfatinchi ɓassowundi kwastǝ ndiktǝɗisi mbinchan, ǝ ɓatinchi yi tǝrkwathl kanan. <verse eid="GAL 4:13" /><verse number="14" style="v" sid="GAL 4:14" />Chǝka mǝ nakan wa hatǝfatinchi chok kǝ ǝna che wansarta ǝ mǝɗiyon, njir wowun nenchi wa, wuɗek wowun nenchi wa. Kǝɗu thlǝkowun nenchi kǝɗ thlǝ thlǝndi Farta, kǝɗ Yesu kǝristi tǝ indiyan. <verse eid="GAL 4:14" /><verse number="15" style="v" sid="GAL 4:15" />Ai sǝk mbǝnɗi sǝk tǝwun fǝ tǝ nenchi? Kǝthlǝm ni mbahǝn mbuˈta wa, mamwa nan chǝta mǝ ɓǝtawun wenichiyowun kǝ fǝrichi wun. <verse eid="GAL 4:15" /><verse number="16" style="v" sid="GAL 4:16" />Awi, nakanya tǝ choki kǝ atǝkretǝwun, kǝthlǝm mbuˈowunchi kit wa?<verse eid="GAL 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17" />Nafchiɗiya yah kandǝ kweˈtǝ ha, kǝ kahandǝ hur inchiyowun, kǝɗu kaɗat ˈyanda ngga kaɗan wa. Yah channdǝ si kǝ chakaminchi ndǝ ha tǝ wunchi, kǝthlǝm kweˈtǝ yowun ha kǝ nggǝranchǝ in kǝmɗiyanda. <verse eid="GAL 4:17" /><verse number="18" style="v" sid="GAL 4:18" />Ndiˈchan si kǝ ɗǝf nef wandǝkaɗatˈyansi kǝ chǝt ǝna, maa tǝ ka kaɗata. Kǝn chǝta chǝka kǝ kwati, ngga wa ma nggǝt si minni wa.<verse eid="GAL 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 4:19" />Wanchinchi fee nech wechicha fee thlǝ mbǝndi faɗan, nggǝt nggǝr chukuta kǝɗ tǝni nggǝr nggǝt wunchi. Nggi yip wa, kǝ fartǝɗi naa ndikti Kǝrǝsti chokta ǝ hur wun. <verse eid="GAL 4:19" /><verse number="20" style="v" sid="GAL 4:20" />Mamwa kǝ ndǝ fee wa nggǝt tǝ wunchi nakanya, kǝthlǝm kǝ nggǝrani ɓǝra ndiktinchǝ ha kǝmɗi yowun. Kǝthlǝm ndikti yowun ɗaktǝ nenchi.<verse eid="GAL 4:20" /></para>
  <para style="s">Chaˈan Bulus kaɗi kǝ ɗar Hajaratu tǝ Saratu</para>
  <para style="m">
    <verse number="21" style="v" sid="GAL 4:21" />Mbuˈami tǝn, yahwunsǝ kǝ chokwun kan kusiˈ wa, sǝn wowun ǝnɗi mbuˈtǝ kusiˈtaˈan wa? <verse eid="GAL 4:21" /><verse number="22" style="v" sid="GAL 4:22" />Kǝthlǝm nechan kǝ yaraɗan wa Ibrahim wanchiyansǝ chap. Arta tǝ nuɗi nech kǝ mafat yu. Artǝ paɗ tǝ nu thla nggawak chǝ kǝ mafata.<note caller="+" style="f"><char style="fr" closed="false">4:22 </char><char style="ft" closed="false">ɗǝpandǝn Tǝrkwathl kanan 16:15; 21:2-3.</char></note> <verse eid="GAL 4:22" /><verse number="23" style="v" sid="GAL 4:23" />Wannan ˈyan thla nggǝttǝ mafaɗan yu, nggǝt chǝ fee anchi kǝɗ ǝnɗi thlǝ nggǝttǝ nafchǝ wancha. Kǝɗu wananˈyan thla nggǝttǝ fee tǝmɗi nuɗi nggowak chǝ kǝ mafat yu, nggǝt chǝ fee anchi tǝmɗi ɗǝf mee i Farta.<verse eid="GAL 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GAL 4:24" />Ichiɗiya chokchan kǝ ǝna chaˈata. Nǝssǝɗiya nandǝ pǝn saktǝ ɗǝf me chap. Arti ɗǝf miyan thlaˈtǝ ngwal Sinai, thlǝ nechan nggǝt wancha fee nech chokta kǝ mafecha, ndaˈan nech kǝ Hajaratu. <verse eid="GAL 4:24" /><verse number="25" style="v" sid="GAL 4:25" />Nakanya Hajaratu ngwal Sinai hur hahi Larabawecha. Ndaˈan nech kǝ saktǝ Urshelima nakanya, kǝthlǝm mǝthlan tǝ wanchiyan nat nda nechandǝ kǝ mafecha. <verse eid="GAL 4:25" /><verse number="26" style="v" sid="GAL 4:26" />Kǝɗu Urshelima tǝɗi nech hulafǝrta, peˈ wa kǝ mafata wa, mǝthlan nech kǝ man mǝn. <verse eid="GAL 4:26" /><verse number="27" style="v" sid="GAL 4:27" />Kǝthlǝm nechan kǝ yaraɗan, ndat wa,</para>
  <para style="q1" vid="GAL 4:27">“Mbunu fat fa chǝ nunefa kwareya,</para>
  <para style="q2" vid="GAL 4:27">chaɗi tam wakchǝ sǝk hatǝ nggǝtta.</para>
  <para style="q1" vid="GAL 4:27">Shenuˈu yi mbǝnfata tǝ kapa ɓǝrata</para>
  <para style="q2" vid="GAL 4:27">chaɗi tam wakchǝ chukuta.</para>
  <para style="q1" vid="GAL 4:27">Kǝthlǝm wanchi nuɗi nawak tǝ chimaɗan si terchan nda</para>
  <para style="q2" vid="GAL 4:27">mbǝrandǝ wanchi nuɗi ha naa chimaɗan si.”<note caller="+" style="f"><char style="fr" closed="false">4:27 </char><char style="ft" closed="false">Isa 54:1.</char></note><verse eid="GAL 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28" />Kun, wanmanchina, chokmǝn kǝ wanchi Farta tǝmɗi ɗǝf mee kǝɗ Ishaku. <verse eid="GAL 4:28" /><verse number="29" style="v" sid="GAL 4:29" />Kǝɗ ǝnɗi choh waa thla nggǝttǝ fee, kǝɗ ǝnɗi thlǝ nggǝttǝ nafchǝ wancha, ɓahan kan thla nggǝt tǝ fee tǝmɗi alkǝti Shemeti Farta, nechan kǝɗu kǝ nakanya.<note caller="*" style="x"><char style="xo" closed="false">4:29 </char><char style="xt" closed="false"><ref loc="GEN 21:9">Far 21:9</ref></char></note><verse eid="GAL 4:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GAL 4:30" />Paɗaa mǝ mbuˈtǝ kwastǝ ndiktaˈan? “Rǝkandǝn nuɗi kǝ mafat yu tǝ waˈyan, kǝthlǝm wanan i mafaɗan nggech mbǝs chaktǝ hur kǝnawa tǝ wanɗi nuɗi nggowakchǝ kǝ mafat yu wa.”<note caller="*" style="x"><char style="xo" closed="false">4:30 </char><char style="xt" closed="false"><ref loc="GEN 21:10">Far 21:10</ref></char></note> <verse eid="GAL 4:30" /><verse number="31" style="v" sid="GAL 4:31" />Kǝthlǝm ndaˈan wanmanchina, nggǝmǝn ngga nechamǝn kǝ wanchi nuɗi nech kǝ mafata wa, nechamǝn kǝ wanchi nuɗi nggawakchǝ kǝ mafata.<verse eid="GAL 4:31" /></para>
  <chapter eid="GAL 4" />
  <chapter number="5" style="c" sid="GAL 5" />
  <para style="s">Hǝraˈaminchǝ Kǝristi</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1" />Kǝthlǝm chok inɗiya, hǝraˈamǝndǝ Kǝrǝsti. Thlaram changchang, kǝ nggǝr wun fǝr indiyowun, kǝ kǝnowunchi fee tǝ chalala yi chok mafakǝt paɗ wa.<verse eid="GAL 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2" />Kam thlǝmat ha, nggǝta Bulus nech mbuˈowunda, tǝ ndat wa, ma ǝ nggǝm wun fa kǝ hechowunchǝ fee, thleya pǝnchan wa Kǝrǝsti nenǝ tǝ mbǝs ǝnhar kǝɗiyowun wa. <verse eid="GAL 5:2" /><verse number="3" style="v" sid="GAL 5:3" />Nggǝt nggǝr mbuˈowun nda tǝ alkǝtfa kǝmɗi chǝka wuni, thla nggǝmchǝ fa kǝ hechan fee, ndat wa, chokchan nwaat kǝ para nat ǝnɗi mbuˈtǝ kusiˈ wa kǝ chǝ fee. <verse eid="GAL 5:3" /><verse number="4" style="v" sid="GAL 5:4" />Kun tǝɗi nech ka hǝraˈta tǝmɗi para kusiˈ, kǝtawun indiyowun kesh hur Kǝristi, karkowun kaakǝti Farta.<verse eid="GAL 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GAL 5:5" />Kǝthlǝm tǝmɗi alkǝti Shemeta, ɗǝftǝmǝn kǝfatsi kǝ namǝn ndiiti mbǝs kaakǝti Farta, kǝthlǝm fǝr kit. <verse eid="GAL 5:5" /><verse number="6" style="v" sid="GAL 5:6" />Maa nggǝmǝn hur Kǝrǝsti, hecheta ndu kumi hecheta ngga meˈi ǝn natǝn wa. Ənɗi mbǝranchǝ ndǝt ha, ndaˈan nech kǝ fǝr kit, thla thlǝ pǝnchǝ indiyan tǝmɗi mbǝnfata.<verse eid="GAL 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7" />Choh kun rakata kun ɗǝt kǝ pang keˈkeˈ. Wun ˈyatowunchǝ fǝr maanan tǝ kittaˈan? <verse eid="GAL 5:7" /><verse number="8" style="v" sid="GAL 5:8" />Sǝninchi wa lǝmǝnɗiya ngga mǝɗi thla ˈyech wunchi wa. <verse eid="GAL 5:8" /><verse number="9" style="v" sid="GAL 5:9" />Kǝɗ ǝnɗi mbuˈtǝ fee, Yisti ngguɗyeh kǝɗa thlǝ ɗǝfchǝ fuhwa njohǝma kǝ hupa. <verse eid="GAL 5:9" /><verse number="10" style="v" sid="GAL 5:10" />Fǝrinchǝ kit kǝmɗiyowun hur thlǝm Thlǝwira Yesu, tǝ ndat wa, nowun para ndikti yowun samǝn kǝ malawun thla inchi mbuˈowundi wa. Nafɗi thlǝ nech thlaˈandǝ hur inchiyowun, naa fee chakan mee, chǝka wun nakan.<verse eid="GAL 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 5:11" />Wanmanchina, mamwa paˈ kǝ nakanya tǝni ɓassa tǝ ndat wa, nwaat kǝ hechan fee nafcha, kǝthlǝm mii paˈ kǝ nakanya thlǝ naa fee ɓahita? Maa kǝɗuyu natǝn kǝ kittaˈan, ndiktǝɗi nati mbuˈta ndat wa kukwan fee Yesu kǝ ɗar palangnda, mǝ nech kǝ ǝna chǝt wansarta kǝmɗi chǝkawun wa. <verse eid="GAL 5:11" /><verse number="12" style="v" sid="GAL 5:12" />Maa kǝ ndǝ fee wa, nafchǝɗi thlǝ nech thlaˈandǝ hur inchiyowun, kǝ nggǝmndǝ fa, kǝ tasan fee sahtǝ karchiyandǝ kaɗ nat.<verse eid="GAL 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13" />Kun wan manchina, ˈyech fee wunchi ngga kǝthlǝm chok mafakǝta wa. Paɗaa kaɗam har kǝ chok kumi mafakǝtˈyowun kǝ chok kǝ yi ǝnɗi yahtǝ fata. Tǝmɗi mbǝnfata kǝ nowun kǝsandǝ raˈansi. <verse eid="GAL 5:13" /><verse number="14" style="v" sid="GAL 5:14" />Ichiɗi nat naa kusiˈ mbuˈta, ɓi keˈkeˈ tǝ kusiˈ tǝɗi ndech wa, “Yahu wanmu, kǝɗ ǝnɗi yahtu indiyo” <note caller="+" style="f"><char style="fr" closed="false">5:14 </char><char style="ft" closed="false">Lev 19:18.</char></note> <verse eid="GAL 5:14" /><verse number="15" style="v" sid="GAL 5:15" />Kǝɗu maa kun ǝsˈraˈan kǝnowun yandǝ tǝ raˈan, mbǝramsi, kǝthlǝm tǝ minni nat wun tǝkandǝ raˈan ha.<verse eid="GAL 5:15" /></para>
  <para style="s">Tarchi Shemeti Farta tǝ tarchi fata</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16" />Ndiktinchi ndat wa, kǝ chok natˈyowun hur Shemeta. Maa kǝɗu nowun chǝt tarchiɗi yahtǝ fata wa. <verse eid="GAL 5:16" /><verse number="17" style="v" sid="GAL 5:17" />Tarchiɗi thlǝ yahtǝ fata tǝthl nǝ chǝt atǝkrekǝta tǝ Shemeta. Paɗ tarchiɗi thlǝ yahtǝ Shemeta tǝthl nǝ chǝt atǝkrekǝta tǝ ǝnɗi yahtǝ fata. Ichiɗi chap ya tǝthl nandǝ yaan raˈan, kǝthlǝm kǝ mbahan wun chǝt ǝnɗi yahtǝ wun wa. <verse eid="GAL 5:17" /><verse number="18" style="v" sid="GAL 5:18" />Maa Shemeti Farta nech parat tǝ wunchi, ngga nechowun hur kusiˈ wa. <verse eid="GAL 5:18" /><verse number="19" style="v" sid="GAL 5:19" />Tarchi fata nechan hayang, fen nech kǝ, fǝlaukǝta, chǝt tǝkǝmǝn icha, tǝ kaa mban sǝk mbǝndǝ fa yi kumi hartǝ fata, <verse eid="GAL 5:19" /><verse number="20" style="v" sid="GAL 5:20" />tǝ manaandǝ ɗǝhacha, tǝ hurkakta, tǝ kar raˈan, tǝ yaanda, tǝ sǝraˈ raˈan, tǝ sǝɓtǝ wanɗǝkaɗata, tǝ yah inda, tǝ chaktǝ ha, tǝ thlaˈ mbata, <verse eid="GAL 5:20" /><verse number="21" style="v" sid="GAL 5:21" />tǝ ǝna fata, tǝ nggathla tǝ ǝnɗi nech hurandǝ indǝ kaɗi, tǝ nggomnda yi saa ichiɗi nech tǝrandǝ nefa, tǝ takǝt ɓǝɓifecha kǝɗ feya. Nggǝt yanowun nda, kǝɗ ǝnɗi chiti choh, ndat wa fee thlǝ nech chǝt weˈtǝ ichǝ ini, nggandǝ mbǝs maandi hulafǝrta wa.<verse eid="GAL 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22" />Paɗaa mbǝs ǝna thla thlǝ fǝrtǝ Shemeta, fen nech kǝ, mbǝnfata, tǝ chiɗ chiɗ tǝ wanɗǝkaɗata, tǝ kǝɓikaɗi, tǝ kǝrǝs ǝna, tǝ chit kafata, tǝ kaakǝta, tǝ chit ǝnɗi naa nef chǝt ndiˈchan, <verse eid="GAL 5:22" /><verse number="23" style="v" sid="GAL 5:23" />tǝ paˈpaˈ tǝ hur inda, tǝ kǝmmǝ kǝta. Fee thlǝ chich weˈtǝ ichiɗiya nggǝ kusiˈ tǝkan her tandǝ fa wa. <verse eid="GAL 5:23" /><verse number="24" style="v" sid="GAL 5:24" />Paɗ fee nech kǝ yi Yesu Kǝristi, tapi kukwandǝ ǝna chitˈyanda yi fata, tǝ ɓǝɓiˈ icha samǝn samǝn, thla thlǝ yah tǝ fata. <verse eid="GAL 5:24" /><verse number="25" style="v" sid="GAL 5:25" />Maa Shemet thlǝ nech parat tǝ minchi, malaman natˈyamǝn ha kǝn tǝmɗi Shemeta. <verse eid="GAL 5:25" /><verse number="26" style="v" sid="GAL 5:26" />Kǝ chokmǝn kǝ fǝ maan incha wa, ndu fǝ thlaˈandǝ hur inchi raˈan, ndu sǝraˈ raˈan wa.<verse eid="GAL 5:26" /></para>
  <chapter eid="GAL 5" />
  <chapter number="6" style="c" sid="GAL 6" />
  <para style="s">Kǝsaman wan manchǝwun si hur ɓahtǝha</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1" />Kun wanmanchina, maa ǝ nii fee yowuna mǝthlan hur chǝt ɓǝɓifata, kun tǝɗi nech hur Shemeta, nggǝrang kowun kaɗi tǝ kafata. Mbǝramsi inchiyowun, kǝthlǝm kun paɗ kǝ hǝmwun kǝ hur yah icha wa. <verse eid="GAL 6:1" /><verse number="2" style="v" sid="GAL 6:2" />Kǝsaman raˈansi tǝmɗi tǝr heˈti raˈan. Tǝ kǝɗuyu nowun ndiiɗa ndǝ kusiˈ i Kǝristi ha. <verse eid="GAL 6:2" /><verse number="3" style="v" sid="GAL 6:3" />Maa tǝr yowun wa ǝn nakan, paɗaa mǝthlan ngga ǝna wa, tǝn lǝm indiyan.<verse eid="GAL 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 6:4" />Malaman chǝka wuni kǝ kaɗan tǝ tarchiyan kǝ na. Maa ǝ chǝ ndiˈchan, kǝnan mbahǝn thlaˈandǝ indǝ kǝ ɗar ichiɗi chitǝn tǝ indiyan, ngga wa tǝn kaɗa ndǝ indiyan tǝ yowun wa. <verse eid="GAL 6:4" /><verse number="5" style="v" sid="GAL 6:5" />Kǝthlǝm kǝmchan si chǝka wuni kǝ chǝt tarɗi fǝrandǝ fee.<verse eid="GAL 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6" />Nat thla chaˈandǝ fee ndikti Farta har, kǝ chak tǝ ichiyan nat yi kaakǝta tǝ thla chaˈan chǝ har.<verse eid="GAL 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7" />Kǝ lǝm wun inchiyowun wa, pǝnawu fee ɗathlǝ Farta wa. Nat ǝnɗi hǝftǝ nefa ndaˈan natǝn hathlanda. <verse eid="GAL 6:7" /><verse number="8" style="v" sid="GAL 6:8" />Thla chehcha tǝ yahti wanɗǝkaɗat ˈyan, tǝ yah ti wanɗǝkaɗat ˈyan nan hathl mǝthlan. Thla chehcha ǝ Shemeta, tǝmɗi Shemeta nan hathl shishingnda kǝ poriˈ. <verse eid="GAL 6:8" /><verse number="9" style="v" sid="GAL 6:9" />Kǝ hatamǝn ha tǝ chǝt tar kaakǝta wa, kǝthlǝm namǝn hathlǝ tǝ chectaˈan, maangga tǝ wulamǝnchǝ wa. <verse eid="GAL 6:9" /><verse number="10" style="v" sid="GAL 6:10" />Kǝthlǝm ndaˈan, maa mbandǝsi, kǝmchan si kǝ kǝsamǝn nafchǝs nat. Kapaɗan fenchǝmǝn fee fǝrchǝ kit kǝ Kǝristi.<verse eid="GAL 6:10" /></para>
  <para style="s">Kah thlǝmata tǝ ndaˈǝna yi nggǝlmiyan</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11" />Ɗǝpaman paktǝ yerechiɗi thlǝ nati yarowundǝs tǝ herinchi.<verse eid="GAL 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 6:12" />Fee thlǝ pinanchǝ nafcha wa mbǝra ndǝ tandǝ ha tǝ teri fata, fen thlǝ nech kweˈyowundǝ fa, kǝ hechowunchi fee. Ənɗi ɗǝfchǝ kǝ nandǝ chit kǝɗu, kǝthlǝm tǝ nandǝ rakandǝ saa ɓahta ha, kǝthlǝm ndik palangndi Kǝrǝsti. <verse eid="GAL 6:12" /><verse number="13" style="v" sid="GAL 6:13" />Chǝka fee hechandǝ fee tanda, para wandǝ kusiˈ taˈan wa. Kǝɗu yah chandǝ kǝ hechowunchǝ fee, kǝthlǝm kǝ thlaˈandǝ inda, tǝ ndat wa, hechowunchǝ fee.<verse eid="GAL 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 6:14" />Paɗaa ǝ mǝɗinchi, nggi thlaˈan tǝ indi kǝ ɗar ǝna wa, mangga yi palangnda i Chinmǝn Yesu Kǝrǝsti wa. Kǝthlǝm palangǝnɗiya ɗǝfchǝ ichiɗi nech hur heshi, chok wa kǝ ǝn mǝɗinchǝ wa, kǝ nden wa tapi kukwan fee ichiɗiya, kǝ ɓǝra palangngǝnɗi kukwandǝ fee Yesu. Chokchi kǝɗ nafɗi tapech kǝ malan tǝ ichi heshiɗiya. <verse eid="GAL 6:14" /><verse number="15" style="v" sid="GAL 6:15" />Hechata tǝ kumi hechata ngga meˈi ǝna wa. Yuwa chokta ndaˈan nech meˈi ǝna. <verse eid="GAL 6:15" /><verse number="16" style="v" sid="GAL 6:16" />Kǝɓikaɗi i Farta tǝ haɗamǝn ndǝ ˈyan fa, kǝ chok kǝ ɗar fee nech para kusiˈtǝɗi, ndat wa, Israila yi kit i Farta.<verse eid="GAL 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17" />Thlaˈtǝ nakanya, kǝ nggǝr yowun ɗahitǝ in wa, kǝthlǝm nggǝt tǝ kwar mǝrǝngchǝ fa, thla pincha wa nggǝt mafati Chinda Yesu.<verse eid="GAL 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18" />Wanmanchina, kaakǝti Chinda Yesu Kǝrǝsti, kǝ chok tǝ shemetˈyowun. Kǝ chok kǝɗu.<verse eid="GAL 6:18" /></para>
  <chapter eid="GAL 6" />
</usx>