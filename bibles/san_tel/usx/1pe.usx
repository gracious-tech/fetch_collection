<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="1PE" style="id">Sanskrit Bible (NT) in Telugu Script (సత్యవేదః।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">1 Peter</para>
  <para style="toc1">1 పితరస్య పత్రం</para>
  <para style="toc2">1 పితరః</para>
  <para style="toc3">1 పితరః</para>
  <para style="mt1">1 పితరస్య పత్రం</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>పన్త-గాలాతియా-కప్పదకియా-ఆశియా-బిథునియాదేశేషు ప్రవాసినో యే వికీర్ణలోకాః</para>
  <para style="p">
    <verse number="2" style="v"/>పితురీశ్వరస్య పూర్వ్వనిర్ణయాద్ ఆత్మనః పావనేన యీశుఖ్రీష్టస్యాజ్ఞాగ్రహణాయ శోణితప్రోక్షణాయ చాభిరుచితాస్తాన్ ప్రతి యీశుఖ్రీష్టస్య ప్రేరితః పితరః పత్రం లిఖతి| యుష్మాన్ ప్రతి బాహుల్యేన శాన్తిరనుగ్రహశ్చ భూయాస్తాం|</para>
  <para style="p">
    <verse number="3" style="v"/>అస్మాకం ప్రభో ర్యీశుఖ్రీష్టస్య తాత ఈశ్వరో ధన్యః, యతః స స్వకీయబహుకృపాతో మృతగణమధ్యాద్ యీశుఖ్రీష్టస్యోత్థానేన జీవనప్రత్యాశార్థమ్ అర్థతో</para>
  <para style="p">
    <verse number="4" style="v"/>ఽక్షయనిష్కలఙ్కామ్లానసమ్పత్తిప్రాప్త్యర్థమ్ అస్మాన్ పున ర్జనయామాస| సా సమ్పత్తిః స్వర్గే ఽస్మాకం కృతే సఞ్చితా తిష్ఠతి,</para>
  <para style="p">
    <verse number="5" style="v"/>యూయఞ్చేశ్వరస్య శక్తితః శేషకాలే ప్రకాశ్యపరిత్రాణార్థం విశ్వాసేన రక్ష్యధ్వే|</para>
  <para style="p">
    <verse number="6" style="v"/>తస్మాద్ యూయం యద్యప్యానన్దేన ప్రఫుల్లా భవథ తథాపి సామ్ప్రతం ప్రయోజనహేతోః కియత్కాలపర్య్యన్తం నానావిధపరీక్షాభిః క్లిశ్యధ్వే|</para>
  <para style="p">
    <verse number="7" style="v"/>యతో వహ్నినా యస్య పరీక్షా భవతి తస్మాత్ నశ్వరసువర్ణాదపి బహుమూల్యం యుష్మాకం విశ్వాసరూపం యత్ పరీక్షితం స్వర్ణం తేన యీశుఖ్రీష్టస్యాగమనసమయే ప్రశంసాయాః సమాదరస్య గౌరవస్య చ యోగ్యతా ప్రాప్తవ్యా|</para>
  <para style="p">
    <verse number="8" style="v"/>యూయం తం ఖ్రీష్టమ్ అదృష్ట్వాపి తస్మిన్ ప్రీయధ్వే సామ్ప్రతం తం న పశ్యన్తోఽపి తస్మిన్ విశ్వసన్తో ఽనిర్వ్వచనీయేన ప్రభావయుక్తేన చానన్దేన ప్రఫుల్లా భవథ,</para>
  <para style="p">
    <verse number="9" style="v"/>స్వవిశ్వాసస్య పరిణామరూపమ్ ఆత్మనాం పరిత్రాణం లభధ్వే చ|</para>
  <para style="p">
    <verse number="10" style="v"/>యుష్మాసు యో ఽనుగ్రహో వర్త్తతే తద్విషయే య ఈశ్వరీయవాక్యం కథితవన్తస్తే భవిష్యద్వాదినస్తస్య పరిత్రాణస్యాన్వేషణమ్ అనుసన్ధానఞ్చ కృతవన్తః|</para>
  <para style="p">
    <verse number="11" style="v"/>విశేషతస్తేషామన్తర్వ్వాసీ యః ఖ్రీష్టస్యాత్మా ఖ్రీష్టే వర్త్తిష్యమాణాని దుఃఖాని తదనుగామిప్రభావఞ్చ పూర్వ్వం ప్రాకాశయత్ తేన కః కీదృశో వా సమయో నిరదిశ్యతైతస్యానుసన్ధానం కృతవన్తః|</para>
  <para style="p">
    <verse number="12" style="v"/>తతస్తై ర్విషయైస్తే యన్న స్వాన్ కిన్త్వస్మాన్ ఉపకుర్వ్వన్త్యేతత్ తేషాం నికటే ప్రాకాశ్యత| యాంశ్చ తాన్ విషయాన్ దివ్యదూతా అప్యవనతశిరసో నిరీక్షితుమ్ అభిలషన్తి తే విషయాః సామ్ప్రతం స్వర్గాత్ ప్రేషితస్య పవిత్రస్యాత్మనః సహాయ్యాద్ యుష్మత్సమీపే సుసంవాదప్రచారయితృభిః ప్రాకాశ్యన్త|</para>
  <para style="p">
    <verse number="13" style="v"/>అతఏవ యూయం మనఃకటిబన్ధనం కృత్వా ప్రబుద్ధాః సన్తో యీశుఖ్రీష్టస్య ప్రకాశసమయే యుష్మాసు వర్త్తిష్యమానస్యానుగ్రహస్య సమ్పూర్ణాం ప్రత్యాశాం కురుత|</para>
  <para style="p">
    <verse number="14" style="v"/>అపరం పూర్వ్వీయాజ్ఞానతావస్థాయాః కుత్సితాభిలాషాణాం యోగ్యమ్ ఆచారం న కుర్వ్వన్తో యుష్మదాహ్వానకారీ యథా పవిత్రో ఽస్తి</para>
  <para style="p">
    <verse number="15" style="v"/>యూయమప్యాజ్ఞాగ్రాహిసన్తానా ఇవ సర్వ్వస్మిన్ ఆచారే తాదృక్ పవిత్రా భవత|</para>
  <para style="p">
    <verse number="16" style="v"/>యతో లిఖితమ్ ఆస్తే, యూయం పవిత్రాస్తిష్ఠత యస్మాదహం పవిత్రః|</para>
  <para style="p">
    <verse number="17" style="v"/>అపరఞ్చ యో వినాపక్షపాతమ్ ఏకైకమానుషస్య కర్మ్మానుసారాద్ విచారం కరోతి స యది యుష్మాభిస్తాత ఆఖ్యాయతే తర్హి స్వప్రవాసస్య కాలో యుష్మాభి ర్భీత్యా యాప్యతాం|</para>
  <para style="p">
    <verse number="18" style="v"/>యూయం నిరర్థకాత్ పైతృకాచారాత్ క్షయణీయై రూప్యసువర్ణాదిభి ర్ముక్తిం న ప్రాప్య</para>
  <para style="p">
    <verse number="19" style="v"/>నిష్కలఙ్కనిర్మ్మలమేషశావకస్యేవ ఖ్రీష్టస్య బహుమూల్యేన రుధిరేణ ముక్తిం ప్రాప్తవన్త ఇతి జానీథ|</para>
  <para style="p">
    <verse number="20" style="v"/>స జగతో భిత్తిమూలస్థాపనాత్ పూర్వ్వం నియుక్తః కిన్తు చరమదినేషు యుష్మదర్థం ప్రకాశితో ఽభవత్|</para>
  <para style="p">
    <verse number="21" style="v"/>యతస్తేనైవ మృతగణాత్ తస్యోత్థాపయితరి తస్మై గౌరవదాతరి చేశ్వరే విశ్వసిథ తస్మాద్ ఈశ్వరే యుష్మాకం విశ్వాసః ప్రత్యాశా చాస్తే|</para>
  <para style="p">
    <verse number="22" style="v"/>యూయమ్ ఆత్మనా సత్యమతస్యాజ్ఞాగ్రహణద్వారా నిష్కపటాయ భ్రాతృప్రేమ్నే పావితమనసో భూత్వా నిర్మ్మలాన్తఃకరణైః పరస్పరం గాఢం ప్రేమ కురుత|</para>
  <para style="p">
    <verse number="23" style="v"/>యస్మాద్ యూయం క్షయణీయవీర్య్యాత్ నహి కిన్త్వక్షయణీయవీర్య్యాద్ ఈశ్వరస్య జీవనదాయకేన నిత్యస్థాయినా వాక్యేన పునర్జన్మ గృహీతవన్తః|</para>
  <para style="p">
    <verse number="24" style="v"/>సర్వ్వప్రాణీ తృణైస్తుల్యస్తత్తేజస్తృణపుష్పవత్| తృణాని పరిశుష్యతి పుష్పాణి నిపతన్తి చ|</para>
  <para style="p">
    <verse number="25" style="v"/>కిన్తు వాక్యం పరేశస్యానన్తకాలం వితిష్ఠతే| తదేవ చ వాక్యం సుసంవాదేన యుష్మాకమ్ అన్తికే ప్రకాశితం|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>సర్వ్వాన్ ద్వేషాన్ సర్వ్వాంశ్చ ఛలాన్ కాపట్యానీర్ష్యాః సమస్తగ్లానికథాశ్చ దూరీకృత్య</para>
  <para style="p">
    <verse number="2" style="v"/>యుష్మాభిః పరిత్రాణాయ వృద్ధిప్రాప్త్యర్థం నవజాతశిశుభిరివ ప్రకృతం వాగ్దుగ్ధం పిపాస్యతాం|</para>
  <para style="p">
    <verse number="3" style="v"/>యతః ప్రభు ర్మధుర ఏతస్యాస్వాదం యూయం ప్రాప్తవన్తః|</para>
  <para style="p">
    <verse number="4" style="v"/>అపరం మానుషైరవజ్ఞాతస్య కిన్త్వీశ్వరేణాభిరుచితస్య బహుమూల్యస్య జీవత్ప్రస్తరస్యేవ తస్య ప్రభోః సన్నిధిమ్ ఆగతా</para>
  <para style="p">
    <verse number="5" style="v"/>యూయమపి జీవత్ప్రస్తరా ఇవ నిచీయమానా ఆత్మికమన్దిరం ఖ్రీష్టేన యీశునా చేశ్వరతోషకాణామ్ ఆత్మికబలీనాం దానార్థం పవిత్రో యాజకవర్గో భవథ|</para>
  <para style="p">
    <verse number="6" style="v"/>యతః శాస్త్రే లిఖితమాస్తే, యథా, పశ్య పాషాణ ఏకో ఽస్తి సీయోని స్థాపితో మయా| ముఖ్యకోణస్య యోగ్యః స వృతశ్చాతీవ మూల్యవాన్| యో జనో విశ్వసేత్ తస్మిన్ స లజ్జాం న గమిష్యతి|</para>
  <para style="p">
    <verse number="7" style="v"/>విశ్వాసినాం యుష్మాకమేవ సమీపే స మూల్యవాన్ భవతి కిన్త్వవిశ్వాసినాం కృతే నిచేతృభిరవజ్ఞాతః స పాషాణః కోణస్య భిత్తిమూలం భూత్వా బాధాజనకః పాషాణః స్ఖలనకారకశ్చ శైలో జాతః|</para>
  <para style="p">
    <verse number="8" style="v"/>తే చావిశ్వాసాద్ వాక్యేన స్ఖలన్తి స్ఖలనే చ నియుక్తాః సన్తి|</para>
  <para style="p">
    <verse number="9" style="v"/>కిన్తు యూయం యేనాన్ధకారమధ్యాత్ స్వకీయాశ్చర్య్యదీప్తిమధ్యమ్ ఆహూతాస్తస్య గుణాన్ ప్రకాశయితుమ్ అభిరుచితో వంశో రాజకీయో యాజకవర్గః పవిత్రా జాతిరధికర్త్తవ్యాః ప్రజాశ్చ జాతాః|</para>
  <para style="p">
    <verse number="10" style="v"/>పూర్వ్వం యూయం తస్య ప్రజా నాభవత కిన్త్విదానీమ్ ఈశ్వరస్య ప్రజా ఆధ్వే| పూర్వ్వమ్ అననుకమ్పితా అభవత కిన్త్విదానీమ్ అనుకమ్పితా ఆధ్వే|</para>
  <para style="p">
    <verse number="11" style="v"/>హే ప్రియతమాః, యూయం ప్రవాసినో విదేశినశ్చ లోకా ఇవ మనసః ప్రాతికూల్యేన యోధిభ్యః శారీరికసుఖాభిలాషేభ్యో నివర్త్తధ్వమ్ ఇత్యహం వినయే|</para>
  <para style="p">
    <verse number="12" style="v"/>దేవపూజకానాం మధ్యే యుష్మాకమ్ ఆచార ఏవమ్ ఉత్తమో భవతు యథా తే యుష్మాన్ దుష్కర్మ్మకారిలోకానివ పున ర్న నిన్దన్తః కృపాదృష్టిదినే స్వచక్షుర్గోచరీయసత్క్రియాభ్య ఈశ్వరస్య ప్రశంసాం కుర్య్యుః|</para>
  <para style="p">
    <verse number="13" style="v"/>తతో హేతో ర్యూయం ప్రభోరనురోధాత్ మానవసృష్టానాం కర్తృత్వపదానాం వశీభవత విశేషతో భూపాలస్య యతః స శ్రేష్ఠః,</para>
  <para style="p">
    <verse number="14" style="v"/>దేశాధ్యక్షాణాఞ్చ యతస్తే దుష్కర్మ్మకారిణాం దణ్డదానార్థం సత్కర్మ్మకారిణాం ప్రశంసార్థఞ్చ తేన ప్రేరితాః|</para>
  <para style="p">
    <verse number="15" style="v"/>ఇత్థం నిర్బ్బోధమానుషాణామ్ అజ్ఞానత్వం యత్ సదాచారిభి ర్యుష్మాభి ర్నిరుత్తరీక్రియతే తద్ ఈశ్వరస్యాభిమతం|</para>
  <para style="p">
    <verse number="16" style="v"/>యూయం స్వాధీనా ఇవాచరత తథాపి దుష్టతాయా వేషస్వరూపాం స్వాధీనతాం ధారయన్త ఇవ నహి కిన్త్వీశ్వరస్య దాసా ఇవ|</para>
  <para style="p">
    <verse number="17" style="v"/>సర్వ్వాన్ సమాద్రియధ్వం భ్రాతృవర్గే ప్రీయధ్వమ్ ఈశ్వరాద్ బిభీత భూపాలం సమ్మన్యధ్వం|</para>
  <para style="p">
    <verse number="18" style="v"/>హే దాసాః యూయం సమ్పూర్ణాదరేణ ప్రభూనాం వశ్యా భవత కేవలం భద్రాణాం దయాలూనాఞ్చ నహి కిన్త్వనృజూనామపి|</para>
  <para style="p">
    <verse number="19" style="v"/>యతో ఽన్యాయేన దుఃఖభోగకాల ఈశ్వరచిన్తయా యత్ క్లేశసహనం తదేవ ప్రియం|</para>
  <para style="p">
    <verse number="20" style="v"/>పాపం కృత్వా యుష్మాకం చపేటాఘాతసహనేన కా ప్రశంసా? కిన్తు సదాచారం కృత్వా యుష్మాకం యద్ దుఃఖసహనం తదేవేశ్వరస్య ప్రియం|</para>
  <para style="p">
    <verse number="21" style="v"/>తదర్థమేవ యూయమ్ ఆహూతా యతః ఖ్రీష్టోఽపి యుష్మన్నిమిత్తం దుఃఖం భుక్త్వా యూయం యత్ తస్య పదచిహ్నై ర్వ్రజేత తదర్థం దృష్టాన్తమేకం దర్శితవాన్|</para>
  <para style="p">
    <verse number="22" style="v"/>స కిమపి పాపం న కృతవాన్ తస్య వదనే కాపి ఛలస్య కథా నాసీత్|</para>
  <para style="p">
    <verse number="23" style="v"/>నిన్దితో ఽపి సన్ స ప్రతినిన్దాం న కృతవాన్ దుఃఖం సహమానో ఽపి న భర్త్సితవాన్ కిన్తు యథార్థవిచారయితుః సమీపే స్వం సమర్పితవాన్|</para>
  <para style="p">
    <verse number="24" style="v"/>వయం యత్ పాపేభ్యో నివృత్య ధర్మ్మార్థం జీవామస్తదర్థం స స్వశరీరేణాస్మాకం పాపాని క్రుశ ఊఢవాన్ తస్య ప్రహారై ర్యూయం స్వస్థా అభవత|</para>
  <para style="p">
    <verse number="25" style="v"/>యతః పూర్వ్వం యూయం భ్రమణకారిమేషా ఇవాధ్వం కిన్త్వధునా యుష్మాకమ్ ఆత్మనాం పాలకస్యాధ్యక్షస్య చ సమీపం ప్రత్యావర్త్తితాః|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>హే యోషితః, యూయమపి నిజస్వామినాం వశ్యా భవత తథా సతి యది కేచిద్ వాక్యే విశ్వాసినో న సన్తి తర్హి</para>
  <para style="p">
    <verse number="2" style="v"/>తే వినావాక్యం యోషితామ్ ఆచారేణార్థతస్తేషాం ప్రత్యక్షేణ యుష్మాకం సభయసతీత్వాచారేణాక్రష్టుం శక్ష్యన్తే|</para>
  <para style="p">
    <verse number="3" style="v"/>అపరం కేశరచనయా స్వర్ణాలఙ్కారధారణోన పరిచ్ఛదపరిధానేన వా యుష్మాకం వాహ్యభూషా న భవతు,</para>
  <para style="p">
    <verse number="4" style="v"/>కిన్త్వీశ్వరస్య సాక్షాద్ బహుమూల్యక్షమాశాన్తిభావాక్షయరత్నేన యుక్తో గుప్త ఆన్తరికమానవ ఏవ|</para>
  <para style="p">
    <verse number="5" style="v"/>యతః పూర్వ్వకాలే యాః పవిత్రస్త్రియ ఈశ్వరే ప్రత్యాశామకుర్వ్వన్ తా అపి తాదృశీమేవ భూషాం ధారయన్త్యో నిజస్వామినాం వశ్యా అభవన్|</para>
  <para style="p">
    <verse number="6" style="v"/>తథైవ సారా ఇబ్రాహీమో వశ్యా సతీ తం పతిమాఖ్యాతవతీ యూయఞ్చ యది సదాచారిణ్యో భవథ వ్యాకులతయా చ భీతా న భవథ తర్హి తస్యాః కన్యా ఆధ్వే|</para>
  <para style="p">
    <verse number="7" style="v"/>హే పురుషాః, యూయం జ్ఞానతో దుర్బ్బలతరభాజనైరివ యోషిద్భిః సహవాసం కురుత, ఏకస్య జీవనవరస్య సహభాగినీభ్యతాభ్యః సమాదరం వితరత చ న చేద్ యుష్మాకం ప్రార్థనానాం బాధా జనిష్యతే|</para>
  <para style="p">
    <verse number="8" style="v"/>విశేషతో యూయం సర్వ్వ ఏకమనసః పరదుఃఖై ర్దుఃఖితా భ్రాతృప్రమిణః కృపావన్తః ప్రీతిభావాశ్చ భవత|</para>
  <para style="p">
    <verse number="9" style="v"/>అనిష్టస్య పరిశోధేనానిష్టం నిన్దాయా వా పరిశోధేన నిన్దాం న కుర్వ్వన్త ఆశిషం దత్త యతో యూయమ్ ఆశిరధికారిణో భవితుమాహూతా ఇతి జానీథ|</para>
  <para style="p">
    <verse number="10" style="v"/>అపరఞ్చ, జీవనే ప్రీయమాణో యః సుదినాని దిదృక్షతే| పాపాత్ జిహ్వాం మృషావాక్యాత్ స్వాధరౌ స నివర్త్తయేత్|</para>
  <para style="p">
    <verse number="11" style="v"/>స త్యజేద్ దుష్టతామార్గం సత్క్రియాఞ్చ సమాచరేత్| మృగయాణశ్చ శాన్తిం స నిత్యమేవానుధావతు|</para>
  <para style="p">
    <verse number="12" style="v"/>లోచనే పరమేశస్యోన్మీలితే ధార్మ్మికాన్ ప్రతి| ప్రార్థనాయాః కృతే తేషాః తచ్ఛ్రోత్రే సుగమే సదా| క్రోధాస్యఞ్చ పరేశస్య కదాచారిషు వర్త్తతే|</para>
  <para style="p">
    <verse number="13" style="v"/>అపరం యది యూయమ్ ఉత్తమస్యానుగామినో భవథ తర్హి కో యుష్మాన్ హింసిష్యతే?</para>
  <para style="p">
    <verse number="14" style="v"/>యది చ ధర్మ్మార్థం క్లిశ్యధ్వం తర్హి ధన్యా భవిష్యథ| తేషామ్ ఆశఙ్కయా యూయం న బిభీత న విఙ్క్త వా|</para>
  <para style="p">
    <verse number="15" style="v"/>మనోభిః కిన్తు మన్యధ్వం పవిత్రం ప్రభుమీశ్వరం| అపరఞ్చ యుష్మాకమ్ ఆన్తరికప్రత్యాశాయాస్తత్త్వం యః కశ్చిత్ పృచ్ఛతి తస్మై శాన్తిభీతిభ్యామ్ ఉత్తరం దాతుం సదా సుసజ్జా భవత|</para>
  <para style="p">
    <verse number="16" style="v"/>యే చ ఖ్రీష్టధర్మ్మే యుష్మాకం సదాచారం దూషయన్తి తే దుష్కర్మ్మకారిణామివ యుష్మాకమ్ అపవాదేన యత్ లజ్జితా భవేయుస్తదర్థం యుష్మాకమ్ ఉత్తమః సంవేదో భవతు|</para>
  <para style="p">
    <verse number="17" style="v"/>ఈశ్వరస్యాభిమతాద్ యది యుష్మాభిః క్లేశః సోఢవ్యస్తర్హి సదాచారిభిః క్లేశసహనం వరం న చ కదాచారిభిః|</para>
  <para style="p">
    <verse number="18" style="v"/>యస్మాద్ ఈశ్వరస్య సన్నిధిమ్ అస్మాన్ ఆనేతుమ్ అధార్మ్మికాణాం వినిమయేన ధార్మ్మికః ఖ్రీష్టో ఽప్యేకకృత్వః పాపానాం దణ్డం భుక్తవాన్, స చ శరీరసమ్బన్ధే మారితః కిన్త్వాత్మనః సమ్బన్ధే పున ర్జీవితో ఽభవత్|</para>
  <para style="p">
    <verse number="19" style="v"/>తత్సమ్బన్ధే చ స యాత్రాం విధాయ కారాబద్ధానామ్ ఆత్మనాం సమీపే వాక్యం ఘోషితవాన్|</para>
  <para style="p">
    <verse number="20" style="v"/>పురా నోహస్య సమయే యావత్ పోతో నిరమీయత తావద్ ఈశ్వరస్య దీర్ఘసహిష్ణుతా యదా వ్యలమ్బత తదా తేఽనాజ్ఞాగ్రాహిణోఽభవన్| తేన పోతోనాల్పేఽర్థాద్ అష్టావేవ ప్రాణినస్తోయమ్ ఉత్తీర్ణాః|</para>
  <para style="p">
    <verse number="21" style="v"/>తన్నిదర్శనఞ్చావగాహనం (అర్థతః శారీరికమలినతాయా యస్త్యాగః స నహి కిన్త్వీశ్వరాయోత్తమసంవేదస్య యా ప్రతజ్ఞా సైవ) యీశుఖ్రీష్టస్య పునరుత్థానేనేదానీమ్ అస్మాన్ ఉత్తారయతి,</para>
  <para style="p">
    <verse number="22" style="v"/>యతః స స్వర్గం గత్వేశ్వరస్య దక్షిణే విద్యతే స్వర్గీయదూతాః శాసకా బలాని చ తస్య వశీభూతా అభవన్|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అస్మాకం వినిమయేన ఖ్రీష్టః శరీరసమ్బన్ధే దణ్డం భుక్తవాన్ అతో హేతోః శరీరసమ్బన్ధే యో దణ్డం భుక్తవాన్ స పాపాత్ ముక్త</para>
  <para style="p">
    <verse number="2" style="v"/>ఇతిభావేన యూయమపి సుసజ్జీభూయ దేహవాసస్యావశిష్టం సమయం పునర్మానవానామ్ ఇచ్ఛాసాధనార్థం నహి కిన్త్వీశ్వరస్యేచ్ఛాసాధనార్థం యాపయత|</para>
  <para style="p">
    <verse number="3" style="v"/>ఆయుషో యః సమయో వ్యతీతస్తస్మిన్ యుష్మాభి ర్యద్ దేవపూజకానామ్ ఇచ్ఛాసాధనం కామకుత్సితాభిలాషమద్యపానరఙ్గరసమత్తతాఘృణార్హదేవపూజాచరణఞ్చాకారి తేన బాహుల్యం|</para>
  <para style="p">
    <verse number="4" style="v"/>యూయం తైః సహ తస్మిన్ సర్వ్వనాశపఙ్కే మజ్జితుం న ధావథ, ఇత్యనేనాశ్చర్య్యం విజ్ఞాయ తే యుష్మాన్ నిన్దన్తి|</para>
  <para style="p">
    <verse number="5" style="v"/>కిన్తు యో జీవతాం మృతానాఞ్చ విచారం కర్త్తుమ్ ఉద్యతోఽస్తి తస్మై తైరుత్తరం దాయిష్యతే|</para>
  <para style="p">
    <verse number="6" style="v"/>యతో హేతో ర్యే మృతాస్తేషాం యత్ మానవోద్దేశ్యః శారీరికవిచారః కిన్త్వీశ్వరోద్దేశ్యమ్ ఆత్మికజీవనం భవత్ తదర్థం తేషామపి సన్నిధౌ సుసమాచారః ప్రకాశితోఽభవత్|</para>
  <para style="p">
    <verse number="7" style="v"/>సర్వ్వేషామ్ అన్తిమకాల ఉపస్థితస్తస్మాద్ యూయం సుబుద్ధయః ప్రార్థనార్థం జాగ్రతశ్చ భవత|</para>
  <para style="p">
    <verse number="8" style="v"/>విశేషతః పరస్పరం గాఢం ప్రేమ కురుత, యతః, పాపానామపి బాహుల్యం ప్రేమ్నైవాచ్ఛాదయిష్యతే|</para>
  <para style="p">
    <verse number="9" style="v"/>కాతరోక్తిం వినా పరస్పరమ్ ఆతిథ్యం కృరుత|</para>
  <para style="p">
    <verse number="10" style="v"/>యేన యో వరో లబ్ధస్తేనైవ స పరమ్ ఉపకరోతృ, ఇత్థం యూయమ్ ఈశ్వరస్య బహువిధప్రసాదస్యోత్తమా భాణ్డాగారాధిపా భవత|</para>
  <para style="p">
    <verse number="11" style="v"/>యో వాక్యం కథయతి స ఈశ్వరస్య వాక్యమివ కథయతు యశ్చ పరమ్ ఉపకరోతి స ఈశ్వరదత్తసామర్థ్యాదివోపకరోతు| సర్వ్వవిషయే యీశుఖ్రీష్టేనేశ్వరస్య గౌరవం ప్రకాశ్యతాం తస్యైవ గౌరవం పరాక్రమశ్చ సర్వ్వదా భూయాత్| ఆమేన|</para>
  <para style="p">
    <verse number="12" style="v"/>హే ప్రియతమాః, యుష్మాకం పరీక్షార్థం యస్తాపో యుష్మాసు వర్త్తతే తమ్ అసమ్భవఘటితం మత్వా నాశ్చర్య్యం జానీత,</para>
  <para style="p">
    <verse number="13" style="v"/>కిన్తు ఖ్రీష్టేన క్లేశానాం సహభాగిత్వాద్ ఆనన్దత తేన తస్య ప్రతాపప్రకాశేఽప్యాననన్దేన ప్రఫుల్లా భవిష్యథ|</para>
  <para style="p">
    <verse number="14" style="v"/>యది ఖ్రీష్టస్య నామహేతునా యుష్మాకం నిన్దా భవతి తర్హి యూయం ధన్యా యతో గౌరవదాయక ఈశ్వరస్యాత్మా యుష్మాస్వధితిష్ఠతి తేషాం మధ్యే స నిన్ద్యతే కిన్తు యుష్మన్మధ్యే ప్రశంస్యతే|</para>
  <para style="p">
    <verse number="15" style="v"/>కిన్తు యుష్మాకం కోఽపి హన్తా వా చైరో వా దుష్కర్మ్మకృద్ వా పరాధికారచర్చ్చక ఇవ దణ్డం న భుఙ్క్తాం|</para>
  <para style="p">
    <verse number="16" style="v"/>యది చ ఖ్రీష్టీయాన ఇవ దణ్డం భుఙ్క్తే తర్హి స న లజ్జమానస్తత్కారణాద్ ఈశ్వరం ప్రశంసతు|</para>
  <para style="p">
    <verse number="17" style="v"/>యతో విచారస్యారమ్భసమయే ఈశ్వరస్య మన్దిరే యుజ్యతే యది చాస్మత్స్వారభతే తర్హీశ్వరీయసుసంవాదాగ్రాహిణాం శేషదశా కా భవిష్యతి?</para>
  <para style="p">
    <verse number="18" style="v"/>ధార్మ్మికేనాపి చేత్ త్రాణమ్ అతికృచ్ఛ్రేణ గమ్యతే| తర్హ్యధార్మ్మికపాపిభ్యామ్ ఆశ్రయః కుత్ర లప్స్యతే|</para>
  <para style="p">
    <verse number="19" style="v"/>అత ఈశ్వరేచ్ఛాతో యే దుఃఖం భుఞ్జతే తే సదాచారేణ స్వాత్మానో విశ్వాస్యస్రష్టురీశ్వస్య కరాభ్యాం నిదధతాం|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ఖ్రీష్టస్య క్లేశానాం సాక్షీ ప్రకాశిష్యమాణస్య ప్రతాపస్యాంశీ ప్రాచీనశ్చాహం యుష్మాకం ప్రాచీనాన్ వినీయేదం వదామి|</para>
  <para style="p">
    <verse number="2" style="v"/>యుష్మాకం మధ్యవర్త్తీ య ఈశ్వరస్య మేషవృన్దో యూయం తం పాలయత తస్య వీక్షణం కురుత చ, ఆవశ్యకత్వేన నహి కిన్తు స్వేచ్ఛాతో న వ కులోభేన కిన్త్విచ్ఛుకమనసా|</para>
  <para style="p">
    <verse number="3" style="v"/>అపరమ్ అంశానామ్ అధికారిణ ఇవ న ప్రభవత కిన్తు వృన్దస్య దృష్టాన్తస్వరూపా భవత|</para>
  <para style="p">
    <verse number="4" style="v"/>తేన ప్రధానపాలక ఉపస్థితే యూయమ్ అమ్లానం గౌరవకిరీటం లప్స్యధ్వే|</para>
  <para style="p">
    <verse number="5" style="v"/>హే యువానః, యూయమపి ప్రాచీనలోకానాం వశ్యా భవత సర్వ్వే చ సర్వ్వేషాం వశీభూయ నమ్రతాభరణేన భూషితా భవత, యతః,ఆత్మాభిమానిలోకానాం విపక్షో భవతీశ్వరః| కిన్తు తేనైవ నమ్రేభ్యః ప్రసాదాద్ దీయతే వరః|</para>
  <para style="p">
    <verse number="6" style="v"/>అతో యూయమ్ ఈశ్వరస్య బలవత్కరస్యాధో నమ్రీభూయ తిష్ఠత తేన స ఉచితసమయే యుష్మాన్ ఉచ్చీకరిష్యతి|</para>
  <para style="p">
    <verse number="7" style="v"/>యూయం సర్వ్వచిన్తాం తస్మిన్ నిక్షిపత యతః స యుష్మాన్ ప్రతి చిన్తయతి|</para>
  <para style="p">
    <verse number="8" style="v"/>యూయం ప్రబుద్ధా జాగ్రతశ్చ తిష్ఠత యతో యుష్మాకం ప్రతివాదీ యః శయతానః స గర్జ్జనకారీ సింహ ఇవ పర్య్యటన్ కం గ్రసిష్యామీతి మృగయతే,</para>
  <para style="p">
    <verse number="9" style="v"/>అతో విశ్వాసే సుస్థిరాస్తిష్ఠన్తస్తేన సార్ద్ధం యుధ్యత, యుష్మాకం జగన్నివాసిభ్రాతృష్వపి తాదృశాః క్లేశా వర్త్తన్త ఇతి జానీత|</para>
  <para style="p">
    <verse number="10" style="v"/>క్షణికదుఃఖభోగాత్ పరమ్ అస్మభ్యం ఖ్రీష్టేన యీశునా స్వకీయానన్తగౌరవదానార్థం యోఽస్మాన్ ఆహూతవాన్ స సర్వ్వానుగ్రాహీశ్వరః స్వయం యుష్మాన్ సిద్ధాన్ స్థిరాన్ సబలాన్ నిశ్చలాంశ్చ కరోతు|</para>
  <para style="p">
    <verse number="11" style="v"/>తస్య గౌరవం పరాక్రమశ్చానన్తకాలం యావద్ భూయాత్| ఆమేన్|</para>
  <para style="p">
    <verse number="12" style="v"/>యః సిల్వానో (మన్యే) యుష్మాకం విశ్వాస్యో భ్రాతా భవతి తద్వారాహం సంక్షేపేణ లిఖిత్వా యుష్మాన్ వినీతవాన్ యూయఞ్చ యస్మిన్ అధితిష్ఠథ స ఏవేశ్వరస్య సత్యో ఽనుగ్రహ ఇతి ప్రమాణం దత్తవాన్|</para>
  <para style="p">
    <verse number="13" style="v"/>యుష్మాభిః సహాభిరుచితా యా సమితి ర్బాబిలి విద్యతే సా మమ పుత్రో మార్కశ్చ యుష్మాన్ నమస్కారం వేదయతి|</para>
  <para style="p">
    <verse number="14" style="v"/>యూయం ప్రేమచుమ్బనేన పరస్పరం నమస్కురుత| యీశుఖ్రీష్టాశ్రితానాం యుష్మాకం సర్వ్వేషాం శాన్తి ర్భూయాత్| ఆమేన్|</para>
</usx>
