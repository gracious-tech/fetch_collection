<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="1CO" style="id">Sanskrit Bible (NT) in Telugu Script (సత్యవేదః।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">1 Corinthians</para>
  <para style="toc1">1 కరిన్థినః పత్రం</para>
  <para style="toc2">1 కరిన్థినః</para>
  <para style="toc3">1 కరిన్థినః</para>
  <para style="mt1">1 కరిన్థినః పత్రం</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>యావన్తః పవిత్రా లోకాః స్వేషామ్ అస్మాకఞ్చ వసతిస్థానేష్వస్మాకం ప్రభో ర్యీశోః ఖ్రీష్టస్య నామ్నా ప్రార్థయన్తే తైః సహాహూతానాం ఖ్రీష్టేన యీశునా పవిత్రీకృతానాం లోకానాం య ఈశ్వరీయధర్మ్మసమాజః కరిన్థనగరే విద్యతే</para>
  <para style="p">
    <verse number="2" style="v"/>తం ప్రతీశ్వరస్యేచ్ఛయాహూతో యీశుఖ్రీష్టస్య ప్రేరితః పౌలః సోస్థినినామా భ్రాతా చ పత్రం లిఖతి|</para>
  <para style="p">
    <verse number="3" style="v"/>అస్మాకం పిత్రేశ్వరేణ ప్రభునా యీశుఖ్రీష్టేన చ ప్రసాదః శాన్తిశ్చ యుష్మభ్యం దీయతాం|</para>
  <para style="p">
    <verse number="4" style="v"/>ఈశ్వరో యీశుఖ్రీష్టేన యుష్మాన్ ప్రతి ప్రసాదం ప్రకాశితవాన్, తస్మాదహం యుష్మన్నిమిత్తం సర్వ్వదా మదీయేశ్వరం ధన్యం వదామి|</para>
  <para style="p">
    <verse number="5" style="v"/>ఖ్రీష్టసమ్బన్ధీయం సాక్ష్యం యుష్మాకం మధ్యే యేన ప్రకారేణ సప్రమాణమ్ అభవత్</para>
  <para style="p">
    <verse number="6" style="v"/>తేన యూయం ఖ్రీష్టాత్ సర్వ్వవిధవక్తృతాజ్ఞానాదీని సర్వ్వధనాని లబ్ధవన్తః|</para>
  <para style="p">
    <verse number="7" style="v"/>తతోఽస్మత్ప్రభో ర్యీశుఖ్రీష్టస్య పునరాగమనం ప్రతీక్షమాణానాం యుష్మాకం కస్యాపి వరస్యాభావో న భవతి|</para>
  <para style="p">
    <verse number="8" style="v"/>అపరమ్ అస్మాకం ప్రభో ర్యీశుఖ్రీష్టస్య దివసే యూయం యన్నిర్ద్దోషా భవేత తదర్థం సఏవ యావదన్తం యుష్మాన్ సుస్థిరాన్ కరిష్యతి|</para>
  <para style="p">
    <verse number="9" style="v"/>య ఈశ్వరః స్వపుత్రస్యాస్మత్ప్రభో ర్యీశుఖ్రీష్టస్యాంశినః కర్త్తుం యుష్మాన్ ఆహూతవాన్ స విశ్వసనీయః|</para>
  <para style="p">
    <verse number="10" style="v"/>హే భ్రాతరః, అస్మాకం ప్రభుయీశుఖ్రీష్టస్య నామ్నా యుష్మాన్ వినయేఽహం సర్వ్వై ర్యుష్మాభిరేకరూపాణి వాక్యాని కథ్యన్తాం యుష్మన్మధ్యే భిన్నసఙ్ఘాతా న భవన్తు మనోవిచారయోరైక్యేన యుష్మాకం సిద్ధత్వం భవతు|</para>
  <para style="p">
    <verse number="11" style="v"/>హే మమ భ్రాతరో యుష్మన్మధ్యే వివాదా జాతా ఇతి వార్త్తామహం క్లోయ్యాః పరిజనై ర్జ్ఞాపితః|</para>
  <para style="p">
    <verse number="12" style="v"/>మమాభిప్రేతమిదం యుష్మాకం కశ్చిత్ కశ్చిద్ వదతి పౌలస్య శిష్యోఽహమ్ ఆపల్లోః శిష్యోఽహం కైఫాః శిష్యోఽహం ఖ్రీష్టస్య శిష్యోఽహమితి చ|</para>
  <para style="p">
    <verse number="13" style="v"/>ఖ్రీష్టస్య కిం విభేదః కృతః? పౌలః కిం యుష్మత్కృతే క్రుశే హతః? పౌలస్య నామ్నా వా యూయం కిం మజ్జితాః?</para>
  <para style="p">
    <verse number="14" style="v"/>క్రిష్పగాయౌ వినా యుష్మాకం మధ్యేఽన్యః కోఽపి మయా న మజ్జిత ఇతి హేతోరహమ్ ఈశ్వరం ధన్యం వదామి|</para>
  <para style="p">
    <verse number="15" style="v"/>ఏతేన మమ నామ్నా మానవా మయా మజ్జితా ఇతి వక్తుం కేనాపి న శక్యతే|</para>
  <para style="p">
    <verse number="16" style="v"/>అపరం స్తిఫానస్య పరిజనా మయా మజ్జితాస్తదన్యః కశ్చిద్ యన్మయా మజ్జితస్తదహం న వేద్మి|</para>
  <para style="p">
    <verse number="17" style="v"/>ఖ్రీష్టేనాహం మజ్జనార్థం న ప్రేరితః కిన్తు సుసంవాదస్య ప్రచారార్థమేవ; సోఽపి వాక్పటుతయా మయా న ప్రచారితవ్యః, యతస్తథా ప్రచారితే ఖ్రీష్టస్య క్రుశే మృత్యుః ఫలహీనో భవిష్యతి|</para>
  <para style="p">
    <verse number="18" style="v"/>యతో హేతో ర్యే వినశ్యన్తి తే తాం క్రుశస్య వార్త్తాం ప్రలాపమివ మన్యన్తే కిఞ్చ పరిత్రాణం లభమానేష్వస్మాసు సా ఈశ్వరీయశక్తిస్వరూపా|</para>
  <para style="p">
    <verse number="19" style="v"/>తస్మాదిత్థం లిఖితమాస్తే, జ్ఞానవతాన్తు యత్ జ్ఞానం తన్మయా నాశయిష్యతే| విలోపయిష్యతే తద్వద్ బుద్ధి ర్బద్ధిమతాం మయా||</para>
  <para style="p">
    <verse number="20" style="v"/>జ్ఞానీ కుత్ర? శాస్త్రీ వా కుత్ర? ఇహలోకస్య విచారతత్పరో వా కుత్ర? ఇహలోకస్య జ్ఞానం కిమీశ్వరేణ మోహీకృతం నహి?</para>
  <para style="p">
    <verse number="21" style="v"/>ఈశ్వరస్య జ్ఞానాద్ ఇహలోకస్య మానవాః స్వజ్ఞానేనేశ్వరస్య తత్త్వబోధం న ప్రాప్తవన్తస్తస్మాద్ ఈశ్వరః ప్రచారరూపిణా ప్రలాపేన విశ్వాసినః పరిత్రాతుం రోచితవాన్|</para>
  <para style="p">
    <verse number="22" style="v"/>యిహూదీయలోకా లక్షణాని దిదృక్షన్తి భిన్నదేశీయలోకాస్తు విద్యాం మృగయన్తే,</para>
  <para style="p">
    <verse number="23" style="v"/>వయఞ్చ క్రుశే హతం ఖ్రీష్టం ప్రచారయామః| తస్య ప్రచారో యిహూదీయై ర్విఘ్న ఇవ భిన్నదేశీయైశ్చ ప్రలాప ఇవ మన్యతే,</para>
  <para style="p">
    <verse number="24" style="v"/>కిన్తు యిహూదీయానాం భిన్నదేశీయానాఞ్చ మధ్యే యే ఆహూతాస్తేషు స ఖ్రీష్ట ఈశ్వరీయశక్తిరివేశ్వరీయజ్ఞానమివ చ ప్రకాశతే|</para>
  <para style="p">
    <verse number="25" style="v"/>యత ఈశ్వరే యః ప్రలాప ఆరోప్యతే స మానవాతిరిక్తం జ్ఞానమేవ యచ్చ దౌర్బ్బల్యమ్ ఈశ్వర ఆరోప్యతే తత్ మానవాతిరిక్తం బలమేవ|</para>
  <para style="p">
    <verse number="26" style="v"/>హే భ్రాతరః, ఆహూతయుష్మద్గణో యష్మాభిరాలోక్యతాం తన్మధ్యే సాంసారికజ్ఞానేన జ్ఞానవన్తః పరాక్రమిణో వా కులీనా వా బహవో న విద్యన్తే|</para>
  <para style="p">
    <verse number="27" style="v"/>యత ఈశ్వరో జ్ఞానవతస్త్రపయితుం మూర్ఖలోకాన్ రోచితవాన్ బలాని చ త్రపయితుమ్ ఈశ్వరో దుర్బ్బలాన్ రోచితవాన్|</para>
  <para style="p">
    <verse number="28" style="v"/>తథా వర్త్తమానలోకాన్ సంస్థితిభ్రష్టాన్ కర్త్తుమ్ ఈశ్వరో జగతోఽపకృష్టాన్ హేయాన్ అవర్త్తమానాంశ్చాభిరోచితవాన్|</para>
  <para style="p">
    <verse number="29" style="v"/>తత ఈశ్వరస్య సాక్షాత్ కేనాప్యాత్మశ్లాఘా న కర్త్తవ్యా|</para>
  <para style="p">
    <verse number="30" style="v"/>యూయఞ్చ తస్మాత్ ఖ్రీష్టే యీశౌ సంస్థితిం ప్రాప్తవన్తః స ఈశ్వరాద్ యుష్మాకం జ్ఞానం పుణ్యం పవిత్రత్వం ముక్తిశ్చ జాతా|</para>
  <para style="p">
    <verse number="31" style="v"/>అతఏవ యద్వద్ లిఖితమాస్తే తద్వత్, యః కశ్చిత్ శ్లాఘమానః స్యాత్ శ్లాఘతాం ప్రభునా స హి|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>హే భ్రాతరో యుష్మత్సమీపే మమాగమనకాలేఽహం వక్తృతాయా విద్యాయా వా నైపుణ్యేనేశ్వరస్య సాక్ష్యం ప్రచారితవాన్ తన్నహి;</para>
  <para style="p">
    <verse number="2" style="v"/>యతో యీశుఖ్రీష్టం తస్య క్రుశే హతత్వఞ్చ వినా నాన్యత్ కిమపి యుష్మన్మధ్యే జ్ఞాపయితుం విహితం బుద్ధవాన్|</para>
  <para style="p">
    <verse number="3" style="v"/>అపరఞ్చాతీవ దౌర్బ్బల్యభీతికమ్పయుక్తో యుష్మాభిః సార్ద్ధమాసం|</para>
  <para style="p">
    <verse number="4" style="v"/>అపరం యుష్మాకం విశ్వాసో యత్ మానుషికజ్ఞానస్య ఫలం న భవేత్ కిన్త్వీశ్వరీయశక్తేః ఫలం భవేత్,</para>
  <para style="p">
    <verse number="5" style="v"/>తదర్థం మమ వక్తృతా మదీయప్రచారశ్చ మానుషికజ్ఞానస్య మధురవాక్యసమ్బలితౌ నాస్తాం కిన్త్వాత్మనః శక్తేశ్చ ప్రమాణయుక్తావాస్తాం|</para>
  <para style="p">
    <verse number="6" style="v"/>వయం జ్ఞానం భాషామహే తచ్చ సిద్ధలోకై ర్జ్ఞానమివ మన్యతే, తదిహలోకస్య జ్ఞానం నహి, ఇహలోకస్య నశ్వరాణామ్ అధిపతీనాం వా జ్ఞానం నహి;</para>
  <para style="p">
    <verse number="7" style="v"/>కిన్తు కాలావస్థాయాః పూర్వ్వస్మాద్ యత్ జ్ఞానమ్ అస్మాకం విభవార్థమ్ ఈశ్వరేణ నిశ్చిత్య ప్రచ్ఛన్నం తన్నిగూఢమ్ ఈశ్వరీయజ్ఞానం ప్రభాషామహే|</para>
  <para style="p">
    <verse number="8" style="v"/>ఇహలోకస్యాధిపతీనాం కేనాపి తత్ జ్ఞానం న లబ్ధం, లబ్ధే సతి తే ప్రభావవిశిష్టం ప్రభుం క్రుశే నాహనిష్యన్|</para>
  <para style="p">
    <verse number="9" style="v"/>తద్వల్లిఖితమాస్తే, నేత్రేణ క్కాపి నో దృష్టం కర్ణేనాపి చ న శ్రుతం| మనోమధ్యే తు కస్యాపి న ప్రవిష్టం కదాపి యత్| ఈశ్వరే ప్రీయమాణానాం కృతే తత్ తేన సఞ్చితం|</para>
  <para style="p">
    <verse number="10" style="v"/>అపరమీశ్వరః స్వాత్మనా తదస్మాకం సాక్షాత్ ప్రాకాశయత్; యత ఆత్మా సర్వ్వమేవానుసన్ధత్తే తేన చేశ్వరస్య మర్మ్మతత్త్వమపి బుధ్యతే|</para>
  <para style="p">
    <verse number="11" style="v"/>మనుజస్యాన్తఃస్థమాత్మానం వినా కేన మనుజేన తస్య మనుజస్య తత్త్వం బుధ్యతే? తద్వదీశ్వరస్యాత్మానం వినా కేనాపీశ్వరస్య తత్త్వం న బుధ్యతే|</para>
  <para style="p">
    <verse number="12" style="v"/>వయఞ్చేహలోకస్యాత్మానం లబ్ధవన్తస్తన్నహి కిన్త్వీశ్వరస్యైవాత్మానం లబ్ధవన్తః, తతో హేతోరీశ్వరేణ స్వప్రసాదాద్ అస్మభ్యం యద్ యద్ దత్తం తత్సర్వ్వమ్ అస్మాభి ర్జ్ఞాతుం శక్యతే|</para>
  <para style="p">
    <verse number="13" style="v"/>తచ్చాస్మాభి ర్మానుషికజ్ఞానస్య వాక్యాని శిక్షిత్వా కథ్యత ఇతి నహి కిన్త్వాత్మతో వాక్యాని శిక్షిత్వాత్మికై ర్వాక్యైరాత్మికం భావం ప్రకాశయద్భిః కథ్యతే|</para>
  <para style="p">
    <verse number="14" style="v"/>ప్రాణీ మనుష్య ఈశ్వరీయాత్మనః శిక్షాం న గృహ్లాతి యత ఆత్మికవిచారేణ సా విచార్య్యేతి హేతోః స తాం ప్రలాపమివ మన్యతే బోద్ధుఞ్చ న శక్నోతి|</para>
  <para style="p">
    <verse number="15" style="v"/>ఆత్మికో మానవః సర్వ్వాణి విచారయతి కిన్తు స్వయం కేనాపి న విచార్య్యతే|</para>
  <para style="p">
    <verse number="16" style="v"/>యత ఈశ్వరస్య మనో జ్ఞాత్వా తముపదేష్టుం కః శక్నోతి? కిన్తు ఖ్రీష్టస్య మనోఽస్మాభి ర్లబ్ధం|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>హే భ్రాతరః, అహమాత్మికైరివ యుష్మాభిః సమం సమ్భాషితుం నాశక్నవం కిన్తు శారీరికాచారిభిః ఖ్రీష్టధర్మ్మే శిశుతుల్యైశ్చ జనైరివ యుష్మాభిః సహ సమభాషే|</para>
  <para style="p">
    <verse number="2" style="v"/>యుష్మాన్ కఠినభక్ష్యం న భోజయన్ దుగ్ధమ్ అపాయయం యతో యూయం భక్ష్యం గ్రహీతుం తదా నాశక్నుత ఇదానీమపి న శక్నుథ, యతో హేతోరధునాపి శారీరికాచారిణ ఆధ్వే|</para>
  <para style="p">
    <verse number="3" style="v"/>యుష్మన్మధ్యే మాత్సర్య్యవివాదభేదా భవన్తి తతః కిం శారీరికాచారిణో నాధ్వే మానుషికమార్గేణ చ న చరథ?</para>
  <para style="p">
    <verse number="4" style="v"/>పౌలస్యాహమిత్యాపల్లోరహమితి వా యద్వాక్యం యుష్మాకం కైశ్చిత్ కైశ్చిత్ కథ్యతే తస్మాద్ యూయం శారీరికాచారిణ న భవథ?</para>
  <para style="p">
    <verse number="5" style="v"/>పౌలః కః? ఆపల్లో ర్వా కః? తౌ పరిచారకమాత్రౌ తయోరేకైకస్మై చ ప్రభు ర్యాదృక్ ఫలమదదాత్ తద్వత్ తయోర్ద్వారా యూయం విశ్వాసినో జాతాః|</para>
  <para style="p">
    <verse number="6" style="v"/>అహం రోపితవాన్ ఆపల్లోశ్చ నిషిక్తవాన్ ఈశ్వరశ్చావర్ద్ధయత్|</para>
  <para style="p">
    <verse number="7" style="v"/>అతో రోపయితృసేక్తారావసారౌ వర్ద్ధయితేశ్వర ఏవ సారః|</para>
  <para style="p">
    <verse number="8" style="v"/>రోపయితృసేక్తారౌ చ సమౌ తయోరేకైకశ్చ స్వశ్రమయోగ్యం స్వవేతనం లప్స్యతే|</para>
  <para style="p">
    <verse number="9" style="v"/>ఆవామీశ్వరేణ సహ కర్మ్మకారిణౌ, ఈశ్వరస్య యత్ క్షేత్రమ్ ఈశ్వరస్య యా నిర్మ్మితిః సా యూయమేవ|</para>
  <para style="p">
    <verse number="10" style="v"/>ఈశ్వరస్య ప్రసాదాత్ మయా యత్ పదం లబ్ధం తస్మాత్ జ్ఞానినా గృహకారిణేవ మయా భిత్తిమూలం స్థాపితం తదుపరి చాన్యేన నిచీయతే| కిన్తు యేన యన్నిచీయతే తత్ తేన వివిచ్యతాం|</para>
  <para style="p">
    <verse number="11" style="v"/>యతో యీశుఖ్రీష్టరూపం యద్ భిత్తిమూలం స్థాపితం తదన్యత్ కిమపి భిత్తిమూలం స్థాపయితుం కేనాపి న శక్యతే|</para>
  <para style="p">
    <verse number="12" style="v"/>ఏతద్భిత్తిమూలస్యోపరి యది కేచిత్ స్వర్ణరూప్యమణికాష్ఠతృణనలాన్ నిచిన్వన్తి,</para>
  <para style="p">
    <verse number="13" style="v"/>తర్హ్యేకైకస్య కర్మ్మ ప్రకాశిష్యతే యతః స దివసస్తత్ ప్రకాశయిష్యతి| యతో హతోస్తన దివసేన వహ్నిమయేనోదేతవ్యం తత ఏకైకస్య కర్మ్మ కీదృశమేతస్య పరీక్షా బహ్నినా భవిష్యతి|</para>
  <para style="p">
    <verse number="14" style="v"/>యస్య నిచయనరూపం కర్మ్మ స్థాస్ను భవిష్యతి స వేతనం లప్స్యతే|</para>
  <para style="p">
    <verse number="15" style="v"/>యస్య చ కర్మ్మ ధక్ష్యతే తస్య క్షతి ర్భవిష్యతి కిన్తు వహ్నే ర్నిర్గతజన ఇవ స స్వయం పరిత్రాణం ప్రాప్స్యతి|</para>
  <para style="p">
    <verse number="16" style="v"/>యూయమ్ ఈశ్వరస్య మన్దిరం యుష్మన్మధ్యే చేశ్వరస్యాత్మా నివసతీతి కిం న జానీథ?</para>
  <para style="p">
    <verse number="17" style="v"/>ఈశ్వరస్య మన్దిరం యేన వినాశ్యతే సోఽపీశ్వరేణ వినాశయిష్యతే యత ఈశ్వరస్య మన్దిరం పవిత్రమేవ యూయం తు తన్మన్దిరమ్ ఆధ్వే|</para>
  <para style="p">
    <verse number="18" style="v"/>కోపి స్వం న వఞ్చయతాం| యుష్మాకం కశ్చన చేదిహలోకస్య జ్ఞానేన జ్ఞానవానహమితి బుధ్యతే తర్హి స యత్ జ్ఞానీ భవేత్ తదర్థం మూఢో భవతు|</para>
  <para style="p">
    <verse number="19" style="v"/>యస్మాదిహలోకస్య జ్ఞానమ్ ఈశ్వరస్య సాక్షాత్ మూఢత్వమేవ| ఏతస్మిన్ లిఖితమప్యాస్తే, తీక్ష్ణా యా జ్ఞానినాం బుద్ధిస్తయా తాన్ ధరతీశ్వరః|</para>
  <para style="p">
    <verse number="20" style="v"/>పునశ్చ| జ్ఞానినాం కల్పనా వేత్తి పరమేశో నిరర్థకాః|</para>
  <para style="p">
    <verse number="21" style="v"/>అతఏవ కోఽపి మనుజైరాత్మానం న శ్లాఘతాం యతః సర్వ్వాణి యుష్మాకమేవ,</para>
  <para style="p">
    <verse number="22" style="v"/>పౌల వా ఆపల్లో ర్వా కైఫా వా జగద్ వా జీవనం వా మరణం వా వర్త్తమానం వా భవిష్యద్వా సర్వ్వాణ్యేవ యుష్మాకం,</para>
  <para style="p">
    <verse number="23" style="v"/>యూయఞ్చ ఖ్రీష్టస్య, ఖ్రీష్టశ్చేశ్వరస్య|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>లోకా అస్మాన్ ఖ్రీష్టస్య పరిచారకాన్ ఈశ్వరస్య నిగూఠవాక్యధనస్యాధ్యక్షాంశ్చ మన్యన్తాం|</para>
  <para style="p">
    <verse number="2" style="v"/>కిఞ్చ ధనాధ్యక్షేణ విశ్వసనీయేన భవితవ్యమేతదేవ లోకై ర్యాచ్యతే|</para>
  <para style="p">
    <verse number="3" style="v"/>అతో విచారయద్భి ర్యుష్మాభిరన్యైః కైశ్చిన్ మనుజై ర్వా మమ పరీక్షణం మయాతీవ లఘు మన్యతే ఽహమప్యాత్మానం న విచారయామి|</para>
  <para style="p">
    <verse number="4" style="v"/>మయా కిమప్యపరాద్ధమిత్యహం న వేద్మి కిన్త్వేతేన మమ నిరపరాధత్వం న నిశ్చీయతే ప్రభురేవ మమ విచారయితాస్తి|</para>
  <para style="p">
    <verse number="5" style="v"/>అత ఉపయుక్తసమయాత్ పూర్వ్వమ్ అర్థతః ప్రభోరాగమనాత్ పూర్వ్వం యుష్మాభి ర్విచారో న క్రియతాం| ప్రభురాగత్య తిమిరేణ ప్రచ్ఛన్నాని సర్వ్వాణి దీపయిష్యతి మనసాం మన్త్రణాశ్చ ప్రకాశయిష్యతి తస్మిన్ సమయ ఈశ్వరాద్ ఏకైకస్య ప్రశంసా భవిష్యతి|</para>
  <para style="p">
    <verse number="6" style="v"/>హే భ్రాతరః సర్వ్వాణ్యేతాని మయాత్మానమ్ ఆపల్లవఞ్చోద్దిశ్య కథితాని తస్యైతత్ కారణం యుయం యథా శాస్త్రీయవిధిమతిక్రమ్య మానవమ్ అతీవ నాదరిష్యధ్బ ఈత్థఞ్చైకేన వైపరీత్యాద్ అపరేణ న శ్లాఘిష్యధ్బ ఏతాదృశీం శిక్షామావయోర్దృష్టాన్తాత్ లప్స్యధ్వే|</para>
  <para style="p">
    <verse number="7" style="v"/>అపరాత్ కస్త్వాం విశేషయతి? తుభ్యం యన్న దత్త తాదృశం కిం ధారయసి? అదత్తేనేవ దత్తేన వస్తునా కుతః శ్లాఘసే?</para>
  <para style="p">
    <verse number="8" style="v"/>ఇదానీమేవ యూయం కిం తృప్తా లబ్ధధనా వా? అస్మాస్వవిద్యమానేషు యూయం కిం రాజత్వపదం ప్రాప్తాః? యుష్మాకం రాజత్వం మయాభిలషితం యతస్తేన యుష్మాభిః సహ వయమపి రాజ్యాంశినో భవిష్యామః|</para>
  <para style="p">
    <verse number="9" style="v"/>ప్రేరితా వయం శేషా హన్తవ్యాశ్చేవేశ్వరేణ నిదర్శితాః| యతో వయం సర్వ్వలోకానామ్ అర్థతః స్వర్గీయదూతానాం మానవానాఞ్చ కౌతుకాస్పదాని జాతాః|</para>
  <para style="p">
    <verse number="10" style="v"/>ఖ్రీష్టస్య కృతే వయం మూఢాః కిన్తు యూయం ఖ్రీష్టేన జ్ఞానినః, వయం దుర్బ్బలా యూయఞ్చ సబలాః, యూయం సమ్మానితా వయఞ్చాపమానితాః|</para>
  <para style="p">
    <verse number="11" style="v"/>వయమద్యాపి క్షుధార్త్తాస్తృష్ణార్త్తా వస్త్రహీనాస్తాడితా ఆశ్రమరహితాశ్చ సన్తః</para>
  <para style="p">
    <verse number="12" style="v"/>కర్మ్మణి స్వకరాన్ వ్యాపారయన్తశ్చ దుఃఖైః కాలం యాపయామః| గర్హితైరస్మాభిరాశీః కథ్యతే దూరీకృతైః సహ్యతే నిన్దితైః ప్రసాద్యతే|</para>
  <para style="p">
    <verse number="13" style="v"/>వయమద్యాపి జగతః సమ్మార్జనీయోగ్యా అవకరా ఇవ సర్వ్వై ర్మన్యామహే|</para>
  <para style="p">
    <verse number="14" style="v"/>యుష్మాన్ త్రపయితుమహమేతాని లిఖామీతి నహి కిన్తు ప్రియాత్మజానివ యుష్మాన్ ప్రబోధయామి|</para>
  <para style="p">
    <verse number="15" style="v"/>యతః ఖ్రీష్టధర్మ్మే యద్యపి యుష్మాకం దశసహస్రాణి వినేతారో భవన్తి తథాపి బహవో జనకా న భవన్తి యతోఽహమేవ సుసంవాదేన యీశుఖ్రీష్టే యుష్మాన్ అజనయం|</para>
  <para style="p">
    <verse number="16" style="v"/>అతో యుష్మాన్ వినయేఽహం యూయం మదనుగామినో భవత|</para>
  <para style="p">
    <verse number="17" style="v"/>ఇత్యర్థం సర్వ్వేషు ధర్మ్మసమాజేషు సర్వ్వత్ర ఖ్రీష్టధర్మ్మయోగ్యా యే విధయో మయోపదిశ్యన్తే తాన్ యో యుష్మాన్ స్మారయిష్యత్యేవమ్భూతం ప్రభోః కృతే ప్రియం విశ్వాసినఞ్చ మదీయతనయం తీమథియం యుష్మాకం సమీపం ప్రేషితవానహం|</para>
  <para style="p">
    <verse number="18" style="v"/>అపరమహం యుష్మాకం సమీపం న గమిష్యామీతి బుద్ధ్వా యుష్మాకం కియన్తో లోకా గర్వ్వన్తి|</para>
  <para style="p">
    <verse number="19" style="v"/>కిన్తు యది ప్రభేరిచ్ఛా భవతి తర్హ్యహమవిలమ్బం యుష్మత్సమీపముపస్థాయ తేషాం దర్పధ్మాతానాం లోకానాం వాచం జ్ఞాస్యామీతి నహి సామర్థ్యమేవ జ్ఞాస్యామి|</para>
  <para style="p">
    <verse number="20" style="v"/>యస్మాదీశ్వరస్య రాజత్వం వాగ్యుక్తం నహి కిన్తు సామర్థ్యయుక్తం|</para>
  <para style="p">
    <verse number="21" style="v"/>యుష్మాకం కా వాఞ్ఛా? యుష్మత్సమీపే మయా కిం దణ్డపాణినా గన్తవ్యముత ప్రేమనమ్రతాత్మయుక్తేన వా?</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అపరం యుష్మాకం మధ్యే వ్యభిచారో విద్యతే స చ వ్యభిచారస్తాదృశో యద్ దేవపూజకానాం మధ్యేఽపి తత్తుల్యో న విద్యతే ఫలతో యుష్మాకమేకో జనో విమాతృగమనం కృరుత ఇతి వార్త్తా సర్వ్వత్ర వ్యాప్తా|</para>
  <para style="p">
    <verse number="2" style="v"/>తథాచ యూయం దర్పధ్మాతా ఆధ్బే, తత్ కర్మ్మ యేన కృతం స యథా యుష్మన్మధ్యాద్ దూరీక్రియతే తథా శోకో యుష్మాభి ర్న క్రియతే కిమ్ ఏతత్?</para>
  <para style="p">
    <verse number="3" style="v"/>అవిద్యమానే మదీయశరీరే మమాత్మా యుష్మన్మధ్యే విద్యతే అతోఽహం విద్యమాన ఇవ తత్కర్మ్మకారిణో విచారం నిశ్చితవాన్,</para>
  <para style="p">
    <verse number="4" style="v"/>అస్మత్ప్రభో ర్యీశుఖ్రీష్టస్య నామ్నా యుష్మాకం మదీయాత్మనశ్చ మిలనే జాతే ఽస్మత్ప్రభో ర్యీశుఖ్రీష్టస్య శక్తేః సాహాయ్యేన</para>
  <para style="p">
    <verse number="5" style="v"/>స నరః శరీరనాశార్థమస్మాభిః శయతానో హస్తే సమర్పయితవ్యస్తతోఽస్మాకం ప్రభో ర్యీశో ర్దివసే తస్యాత్మా రక్షాం గన్తుం శక్ష్యతి|</para>
  <para style="p">
    <verse number="6" style="v"/>యుష్మాకం దర్పో న భద్రాయ యూయం కిమేతన్న జానీథ, యథా, వికారః కృత్స్నశక్తూనాం స్వల్పకిణ్వేన జాయతే|</para>
  <para style="p">
    <verse number="7" style="v"/>యూయం యత్ నవీనశక్తుస్వరూపా భవేత తదర్థం పురాతనం కిణ్వమ్ అవమార్జ్జత యతో యుష్మాభిః కిణ్వశూన్యై ర్భవితవ్యం| అపరమ్ అస్మాకం నిస్తారోత్సవీయమేషశావకో యః ఖ్రీష్టః సోఽస్మదర్థం బలీకృతో ఽభవత్|</para>
  <para style="p">
    <verse number="8" style="v"/>అతః పురాతనకిణ్వేనార్థతో దుష్టతాజిఘాంసారూపేణ కిణ్వేన తన్నహి కిన్తు సారల్యసత్యత్వరూపయా కిణ్వశూన్యతయాస్మాభిరుత్సవః కర్త్తవ్యః|</para>
  <para style="p">
    <verse number="9" style="v"/>వ్యాభిచారిణాం సంసర్గో యుష్మాభి ర్విహాతవ్య ఇతి మయా పత్రే లిఖితం|</para>
  <para style="p">
    <verse number="10" style="v"/>కిన్త్వైహికలోకానాం మధ్యే యే వ్యభిచారిణో లోభిన ఉపద్రావిణో దేవపూజకా వా తేషాం సంసర్గః సర్వ్వథా విహాతవ్య ఇతి నహి, విహాతవ్యే సతి యుష్మాభి ర్జగతో నిర్గన్తవ్యమేవ|</para>
  <para style="p">
    <verse number="11" style="v"/>కిన్తు భ్రాతృత్వేన విఖ్యాతః కశ్చిజ్జనో యది వ్యభిచారీ లోభీ దేవపూజకో నిన్దకో మద్యప ఉపద్రావీ వా భవేత్ తర్హి తాదృశేన మానవేన సహ భోజనపానేఽపి యుష్మాభి ర్న కర్త్తవ్యే ఇత్యధునా మయా లిఖితం|</para>
  <para style="p">
    <verse number="12" style="v"/>సమాజబహిఃస్థితానాం లోకానాం విచారకరణే మమ కోఽధికారః? కిన్తు తదన్తర్గతానాం విచారణం యుష్మాభిః కిం న కర్త్తవ్యం భవేత్?</para>
  <para style="p">
    <verse number="13" style="v"/>బహిఃస్థానాం తు విచార ఈశ్వరేణ కారిష్యతే| అతో యుష్మాభిః స పాతకీ స్వమధ్యాద్ బహిష్క్రియతాం|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>యుష్మాకమేకస్య జనస్యాపరేణ సహ వివాదే జాతే స పవిత్రలోకై ర్విచారమకారయన్ కిమ్ అధార్మ్మికలోకై ర్విచారయితుం ప్రోత్సహతే?</para>
  <para style="p">
    <verse number="2" style="v"/>జగతోఽపి విచారణం పవిత్రలోకైః కారిష్యత ఏతద్ యూయం కిం న జానీథ? అతో జగద్ యది యుష్మాభి ర్విచారయితవ్యం తర్హి క్షుద్రతమవిచారేషు యూయం కిమసమర్థాః?</para>
  <para style="p">
    <verse number="3" style="v"/>దూతా అప్యస్మాభి ర్విచారయిష్యన్త ఇతి కిం న జానీథ? అత ఐహికవిషయాః కిమ్ అస్మాభి ర్న విచారయితవ్యా భవేయుః?</para>
  <para style="p">
    <verse number="4" style="v"/>ఐహికవిషయస్య విచారే యుష్మాభిః కర్త్తవ్యే యే లోకాః సమితౌ క్షుద్రతమాస్త ఏవ నియుజ్యన్తాం|</para>
  <para style="p">
    <verse number="5" style="v"/>అహం యుష్మాన్ త్రపయితుమిచ్ఛన్ వదామి యృష్మన్మధ్యే కిమేకోఽపి మనుష్యస్తాదృగ్ బుద్ధిమాన్నహి యో భ్రాతృవివాదవిచారణే సమర్థః స్యాత్?</para>
  <para style="p">
    <verse number="6" style="v"/>కిఞ్చైకో భ్రాతా భ్రాత్రాన్యేన కిమవిశ్వాసినాం విచారకాణాం సాక్షాద్ వివదతే? యష్మన్మధ్యే వివాదా విద్యన్త ఏతదపి యుష్మాకం దోషః|</para>
  <para style="p">
    <verse number="7" style="v"/>యూయం కుతోఽన్యాయసహనం క్షతిసహనం వా శ్రేయో న మన్యధ్వే?</para>
  <para style="p">
    <verse number="8" style="v"/>కిన్తు యూయమపి భ్రాతృనేవ ప్రత్యన్యాయం క్షతిఞ్చ కురుథ కిమేతత్?</para>
  <para style="p">
    <verse number="9" style="v"/>ఈశ్వరస్య రాజ్యేఽన్యాయకారిణాం లోకానామధికారో నాస్త్యేతద్ యూయం కిం న జానీథ? మా వఞ్చ్యధ్వం, యే వ్యభిచారిణో దేవార్చ్చినః పారదారికాః స్త్రీవదాచారిణః పుంమైథునకారిణస్తస్కరా</para>
  <para style="p">
    <verse number="10" style="v"/>లోభినో మద్యపా నిన్దకా ఉపద్రావిణో వా త ఈశ్వరస్య రాజ్యభాగినో న భవిష్యన్తి|</para>
  <para style="p">
    <verse number="11" style="v"/>యూయఞ్చైవంవిధా లోకా ఆస్త కిన్తు ప్రభో ర్యీశో ర్నామ్నాస్మదీశ్వరస్యాత్మనా చ యూయం ప్రక్షాలితాః పావితాః సపుణ్యీకృతాశ్చ|</para>
  <para style="p">
    <verse number="12" style="v"/>మదర్థం సర్వ్వం ద్రవ్యమ్ అప్రతిషిద్ధం కిన్తు న సర్వ్వం హితజనకం| మదర్థం సర్వ్వమప్రతిషిద్ధం తథాప్యహం కస్యాపి ద్రవ్యస్య వశీకృతో న భవిష్యామి|</para>
  <para style="p">
    <verse number="13" style="v"/>ఉదరాయ భక్ష్యాణి భక్ష్యేభ్యశ్చోదరం, కిన్తు భక్ష్యోదరే ఈశ్వరేణ నాశయిష్యేతే; అపరం దేహో న వ్యభిచారాయ కిన్తు ప్రభవే ప్రభుశ్చ దేహాయ|</para>
  <para style="p">
    <verse number="14" style="v"/>యశ్చేశ్వరః ప్రభుముత్థాపితవాన్ స స్వశక్త్యాస్మానప్యుత్థాపయిష్యతి|</para>
  <para style="p">
    <verse number="15" style="v"/>యుష్మాకం యాని శరీరాణి తాని ఖ్రీష్టస్యాఙ్గానీతి కిం యూయం న జానీథ? అతః ఖ్రీష్టస్య యాన్యఙ్గాని తాని మయాపహృత్య వేశ్యాయా అఙ్గాని కిం కారిష్యన్తే? తన్న భవతు|</para>
  <para style="p">
    <verse number="16" style="v"/>యః కశ్చిద్ వేశ్యాయామ్ ఆసజ్యతే స తయా సహైకదేహో భవతి కిం యూయమేతన్న జానీథ? యతో లిఖితమాస్తే, యథా, తౌ ద్వౌ జనావేకాఙ్గౌ భవిష్యతః|</para>
  <para style="p">
    <verse number="17" style="v"/>మానవా యాన్యన్యాని కలుషాణి కుర్వ్వతే తాని వపు ర్న సమావిశన్తి కిన్తు వ్యభిచారిణా స్వవిగ్రహస్య విరుద్ధం కల్మషం క్రియతే|</para>
  <para style="p">
    <verse number="18" style="v"/>మానవా యాన్యన్యాని కలుషాణి కుర్వ్వతే తాని వపు ర్న సమావిశన్తి కిన్తు వ్యభిచారిణా స్వవిగ్రహస్య విరుద్ధం కల్మషం క్రియతే|</para>
  <para style="p">
    <verse number="19" style="v"/>యుష్మాకం యాని వపూంసి తాని యుష్మదన్తఃస్థితస్యేశ్వరాల్లబ్ధస్య పవిత్రస్యాత్మనో మన్దిరాణి యూయఞ్చ స్వేషాం స్వామినో నాధ్వే కిమేతద్ యుష్మాభి ర్న జ్ఞాయతే?</para>
  <para style="p">
    <verse number="20" style="v"/>యూయం మూల్యేన క్రీతా అతో వపుర్మనోభ్యామ్ ఈశ్వరో యుష్మాభిః పూజ్యతాం యత ఈశ్వర ఏవ తయోః స్వామీ|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అపరఞ్చ యుష్మాభి ర్మాం ప్రతి యత్ పత్రమలేఖి తస్యోత్తరమేతత్, యోషితోఽస్పర్శనం మనుజస్య వరం;</para>
  <para style="p">
    <verse number="2" style="v"/>కిన్తు వ్యభిచారభయాద్ ఏకైకస్య పుంసః స్వకీయభార్య్యా భవతు తద్వద్ ఏకైకస్యా యోషితో ఽపి స్వకీయభర్త్తా భవతు|</para>
  <para style="p">
    <verse number="3" style="v"/>భార్య్యాయై భర్త్రా యద్యద్ వితరణీయం తద్ వితీర్య్యతాం తద్వద్ భర్త్రేఽపి భార్య్యయా వితరణీయం వితీర్య్యతాం|</para>
  <para style="p">
    <verse number="4" style="v"/>భార్య్యాయాః స్వదేహే స్వత్వం నాస్తి భర్త్తురేవ, తద్వద్ భర్త్తురపి స్వదేహే స్వత్వం నాస్తి భార్య్యాయా ఏవ|</para>
  <para style="p">
    <verse number="5" style="v"/>ఉపోషణప్రార్థనయోః సేవనార్థమ్ ఏకమన్త్రణానాం యుష్మాకం కియత్కాలం యావద్ యా పృథక్స్థితి ర్భవతి తదన్యో విచ్ఛేదో యుష్మన్మధ్యే న భవతు, తతః పరమ్ ఇన్ద్రియాణామ్ అధైర్య్యాత్ శయతాన్ యద్ యుష్మాన్ పరీక్షాం న నయేత్ తదర్థం పునరేకత్ర మిలత|</para>
  <para style="p">
    <verse number="6" style="v"/>ఏతద్ ఆదేశతో నహి కిన్త్వనుజ్ఞాత ఏవ మయా కథ్యతే,</para>
  <para style="p">
    <verse number="7" style="v"/>యతో మమావస్థేవ సర్వ్వమానవానామవస్థా భవత్వితి మమ వాఞ్ఛా కిన్త్వీశ్వరాద్ ఏకేనైకో వరోఽన్యేన చాన్యో వర ఇత్థమేకైకేన స్వకీయవరో లబ్ధః|</para>
  <para style="p">
    <verse number="8" style="v"/>అపరమ్ అకృతవివాహాన్ విధవాశ్చ ప్రతి మమైతన్నివేదనం మమేవ తేషామవస్థితి ర్భద్రా;</para>
  <para style="p">
    <verse number="9" style="v"/>కిఞ్చ యది తైరిన్ద్రియాణి నియన్తుం న శక్యన్తే తర్హి వివాహః క్రియతాం యతః కామదహనాద్ వ్యూఢత్వం భద్రం|</para>
  <para style="p">
    <verse number="10" style="v"/>యే చ కృతవివాహాస్తే మయా నహి ప్రభునైవైతద్ ఆజ్ఞాప్యన్తే|</para>
  <para style="p">
    <verse number="11" style="v"/>భార్య్యా భర్త్తృతః పృథక్ న భవతు| యది వా పృథగ్భూతా స్యాత్ తర్హి నిర్వివాహా తిష్ఠతు స్వీయపతినా వా సన్దధాతు భర్త్తాపి భార్య్యాం న త్యజతు|</para>
  <para style="p">
    <verse number="12" style="v"/>ఇతరాన్ జనాన్ ప్రతి ప్రభు ర్న బ్రవీతి కిన్త్వహం బ్రవీమి; కస్యచిద్ భ్రాతుర్యోషిద్ అవిశ్వాసినీ సత్యపి యది తేన సహవాసే తుష్యతి తర్హి సా తేన న త్యజ్యతాం|</para>
  <para style="p">
    <verse number="13" style="v"/>తద్వత్ కస్యాశ్చిద్ యోషితః పతిరవిశ్వాసీ సన్నపి యది తయా సహవాసే తుష్యతి తర్హి స తయా న త్యజ్యతాం|</para>
  <para style="p">
    <verse number="14" style="v"/>యతోఽవిశ్వాసీ భర్త్తా భార్య్యయా పవిత్రీభూతః, తద్వదవిశ్వాసినీ భార్య్యా భర్త్రా పవిత్రీభూతా; నోచేద్ యుష్మాకమపత్యాన్యశుచీన్యభవిష్యన్ కిన్త్వధునా తాని పవిత్రాణి సన్తి|</para>
  <para style="p">
    <verse number="15" style="v"/>అవిశ్వాసీ జనో యది వా పృథగ్ భవతి తర్హి పృథగ్ భవతు; ఏతేన భ్రాతా భగినీ వా న నిబధ్యతే తథాపి వయమీశ్వరేణ శాన్తయే సమాహూతాః|</para>
  <para style="p">
    <verse number="16" style="v"/>హే నారి తవ భర్త్తుః పరిత్రాణం త్వత్తో భవిష్యతి న వేతి త్వయా కిం జ్ఞాయతే? హే నర తవ జాయాయాః పరిత్రాణం త్వత్తేा భవిష్యతి న వేతి త్వయా కిం జ్ఞాయతే?</para>
  <para style="p">
    <verse number="17" style="v"/>ఏకైకో జనః పరమేశ్వరాల్లబ్ధం యద్ భజతే యస్యాఞ్చావస్థాయామ్ ఈశ్వరేణాహ్వాయి తదనుసారేణైవాచరతు తదహం సర్వ్వసమాజస్థాన్ ఆదిశామి|</para>
  <para style="p">
    <verse number="18" style="v"/>ఛిన్నత్వగ్ భృత్వా య ఆహూతః స ప్రకృష్టత్వక్ న భవతు, తద్వద్ అఛిన్నత్వగ్ భూత్వా య ఆహూతః స ఛిన్నత్వక్ న భవతు|</para>
  <para style="p">
    <verse number="19" style="v"/>త్వక్ఛేదః సారో నహి తద్వదత్వక్ఛేదోఽపి సారో నహి కిన్త్వీశ్వరస్యాజ్ఞానాం పాలనమేవ|</para>
  <para style="p">
    <verse number="20" style="v"/>యో జనో యస్యామవస్థాయామాహ్వాయి స తస్యామేవావతిష్ఠతాం|</para>
  <para style="p">
    <verse number="21" style="v"/>దాసః సన్ త్వం కిమాహూతోఽసి? తన్మా చిన్తయ, తథాచ యది స్వతన్త్రో భవితుం శక్నుయాస్తర్హి తదేవ వృణు|</para>
  <para style="p">
    <verse number="22" style="v"/>యతః ప్రభునాహూతో యో దాసః స ప్రభో ర్మోచితజనః| తద్వద్ తేనాహూతః స్వతన్త్రో జనోఽపి ఖ్రీష్టస్య దాస ఏవ|</para>
  <para style="p">
    <verse number="23" style="v"/>యూయం మూల్యేన క్రీతా అతో హేతో ర్మానవానాం దాసా మా భవత|</para>
  <para style="p">
    <verse number="24" style="v"/>హే భ్రాతరో యస్యామవస్థాయాం యస్యాహ్వానమభవత్ తయా స ఈశ్వరస్య సాక్షాత్ తిష్ఠతు|</para>
  <para style="p">
    <verse number="25" style="v"/>అపరమ్ అకృతవివాహాన్ జనాన్ ప్రతి ప్రభోః కోఽప్యాదేశో మయా న లబ్ధః కిన్తు ప్రభోరనుకమ్పయా విశ్వాస్యో భూతోఽహం యద్ భద్రం మన్యే తద్ వదామి|</para>
  <para style="p">
    <verse number="26" style="v"/>వర్త్తమానాత్ క్లేశసమయాత్ మనుష్యస్యానూఢత్వం భద్రమితి మయా బుధ్యతే|</para>
  <para style="p">
    <verse number="27" style="v"/>త్వం కిం యోషితి నిబద్ధోఽసి తర్హి మోచనం ప్రాప్తుం మా యతస్వ| కిం వా యోషితో ముక్తోఽసి? తర్హి జాయాం మా గవేషయ|</para>
  <para style="p">
    <verse number="28" style="v"/>వివాహం కుర్వ్వతా త్వయా కిమపి నాపారాధ్యతే తద్వద్ వ్యూహ్యమానయా యువత్యాపి కిమపి నాపరాధ్యతే తథాచ తాదృశౌ ద్వౌ జనౌ శారీరికం క్లేశం లప్స్యేతే కిన్తు యుష్మాన్ ప్రతి మమ కరుణా విద్యతే|</para>
  <para style="p">
    <verse number="29" style="v"/>హే భ్రాతరోఽహమిదం బ్రవీమి, ఇతః పరం సమయోఽతీవ సంక్షిప్తః,</para>
  <para style="p">
    <verse number="30" style="v"/>అతః కృతదారైరకృతదారైరివ రుదద్భిశ్చారుదద్భిరివ సానన్దైశ్చ నిరానన్దైరివ క్రేతృభిశ్చాభాగిభిరివాచరితవ్యం</para>
  <para style="p">
    <verse number="31" style="v"/>యే చ సంసారే చరన్తి తై ర్నాతిచరితవ్యం యత ఇహలేाకస్య కౌతుకో విచలతి|</para>
  <para style="p">
    <verse number="32" style="v"/>కిన్తు యూయం యన్నిశ్చిన్తా భవేతేతి మమ వాఞ్ఛా| అకృతవివాహో జనో యథా ప్రభుం పరితోషయేత్ తథా ప్రభుం చిన్తయతి,</para>
  <para style="p">
    <verse number="33" style="v"/>కిన్తు కృతవివాహో జనో యథా భార్య్యాం పరితోషయేత్ తథా సంసారం చిన్తయతి|</para>
  <para style="p">
    <verse number="34" style="v"/>తద్వద్ ఊఢయోషితో ఽనూఢా విశిష్యతే| యానూఢా సా యథా కాయమనసోః పవిత్రా భవేత్ తథా ప్రభుం చిన్తయతి యా చోఢా సా యథా భర్త్తారం పరితోషయేత్ తథా సంసారం చిన్తయతి|</para>
  <para style="p">
    <verse number="35" style="v"/>అహం యద్ యుష్మాన్ మృగబన్ధిన్యా పరిక్షిపేయం తదర్థం నహి కిన్తు యూయం యదనిన్దితా భూత్వా ప్రభోః సేవనేఽబాధమ్ ఆసక్తా భవేత తదర్థమేతాని సర్వ్వాణి యుష్మాకం హితాయ మయా కథ్యన్తే|</para>
  <para style="p">
    <verse number="36" style="v"/>కస్యచిత్ కన్యాయాం యౌవనప్రాప్తాయాం యది స తస్యా అనూఢత్వం నిన్దనీయం వివాహశ్చ సాధయితవ్య ఇతి మన్యతే తర్హి యథాభిలాషం కరోతు, ఏతేన కిమపి నాపరాత్స్యతి వివాహః క్రియతాం|</para>
  <para style="p">
    <verse number="37" style="v"/>కిన్తు దుఃఖేనాక్లిష్టః కశ్చిత్ పితా యది స్థిరమనోగతః స్వమనోఽభిలాషసాధనే సమర్థశ్చ స్యాత్ మమ కన్యా మయా రక్షితవ్యేతి మనసి నిశ్చినోతి చ తర్హి స భద్రం కర్మ్మ కరోతి|</para>
  <para style="p">
    <verse number="38" style="v"/>అతో యో వివాహం కరోతి స భద్రం కర్మ్మ కరోతి యశ్చ వివాహం న కరోతి స భద్రతరం కర్మ్మ కరోతి|</para>
  <para style="p">
    <verse number="39" style="v"/>యావత్కాలం పతి ర్జీవతి తావద్ భార్య్యా వ్యవస్థయా నిబద్ధా తిష్ఠతి కిన్తు పత్యౌ మహానిద్రాం గతే సా ముక్తీభూయ యమభిలషతి తేన సహ తస్యా వివాహో భవితుం శక్నోతి, కిన్త్వేతత్ కేవలం ప్రభుభక్తానాం మధ్యే|</para>
  <para style="p">
    <verse number="40" style="v"/>తథాచ సా యది నిష్పతికా తిష్ఠతి తర్హి తస్యాః క్షేమం భవిష్యతీతి మమ భావః| అపరమ్ ఈశ్వరస్యాత్మా మమాప్యన్త ర్విద్యత ఇతి మయా బుధ్యతే|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>దేవప్రసాదే సర్వ్వేషామ్ అస్మాకం జ్ఞానమాస్తే తద్వయం విద్మః| తథాపి జ్ఞానం గర్వ్వం జనయతి కిన్తు ప్రేమతో నిష్ఠా జాయతే|</para>
  <para style="p">
    <verse number="2" style="v"/>అతః కశ్చన యది మన్యతే మమ జ్ఞానమాస్త ఇతి తర్హి తేన యాదృశం జ్ఞానం చేష్టితవ్యం తాదృశం కిమపి జ్ఞానమద్యాపి న లబ్ధం|</para>
  <para style="p">
    <verse number="3" style="v"/>కిన్తు య ఈశ్వరే ప్రీయతే స ఈశ్వరేణాపి జ్ఞాయతే|</para>
  <para style="p">
    <verse number="4" style="v"/>దేవతాబలిప్రసాదభక్షణే వయమిదం విద్మో యత్ జగన్మధ్యే కోఽపి దేవో న విద్యతే, ఏకశ్చేశ్వరో ద్వితీయో నాస్తీతి|</para>
  <para style="p">
    <verse number="5" style="v"/>స్వర్గే పృథివ్యాం వా యద్యపి కేషుచిద్ ఈశ్వర ఇతి నామారోప్యతే తాదృశాశ్చ బహవ ఈశ్వరా బహవశ్చ ప్రభవో విద్యన్తే</para>
  <para style="p">
    <verse number="6" style="v"/>తథాప్యస్మాకమద్వితీయ ఈశ్వరః స పితా యస్మాత్ సర్వ్వేషాం యదర్థఞ్చాస్మాకం సృష్టి ర్జాతా, అస్మాకఞ్చాద్వితీయః ప్రభుః స యీశుః ఖ్రీష్టో యేన సర్వ్వవస్తూనాం యేనాస్మాకమపి సృష్టిః కృతా|</para>
  <para style="p">
    <verse number="7" style="v"/>అధికన్తు జ్ఞానం సర్వ్వేషాం నాస్తి యతః కేచిదద్యాపి దేవతాం సమ్మన్య దేవప్రసాదమివ తద్ భక్ష్యం భుఞ్జతే తేన దుర్బ్బలతయా తేషాం స్వాన్తాని మలీమసాని భవన్తి|</para>
  <para style="p">
    <verse number="8" style="v"/>కిన్తు భక్ష్యద్రవ్యాద్ వయమ్ ఈశ్వరేణ గ్రాహ్యా భవామస్తన్నహి యతో భుఙ్క్త్వా వయముత్కృష్టా న భవామస్తద్వదభుఙ్క్త్వాప్యపకృష్టా న భవామః|</para>
  <para style="p">
    <verse number="9" style="v"/>అతో యుష్మాకం యా క్షమతా సా దుర్బ్బలానామ్ ఉన్మాథస్వరూపా యన్న భవేత్ తదర్థం సావధానా భవత|</para>
  <para style="p">
    <verse number="10" style="v"/>యతో జ్ఞానవిశిష్టస్త్వం యది దేవాలయే ఉపవిష్టః కేనాపి దృశ్యసే తర్హి తస్య దుర్బ్బలస్య మనసి కిం ప్రసాదభక్షణ ఉత్సాహో న జనిష్యతే?</para>
  <para style="p">
    <verse number="11" style="v"/>తథా సతి యస్య కృతే ఖ్రీష్టో మమార తవ స దుర్బ్బలో భ్రాతా తవ జ్ఞానాత్ కిం న వినంక్ష్యతి?</para>
  <para style="p">
    <verse number="12" style="v"/>ఇత్యనేన ప్రకారేణ భ్రాతృణాం విరుద్ధమ్ అపరాధ్యద్భిస్తేషాం దుర్బ్బలాని మనాంసి వ్యాఘాతయద్భిశ్చ యుష్మాభిః ఖ్రీష్టస్య వైపరీత్యేనాపరాధ్యతే|</para>
  <para style="p">
    <verse number="13" style="v"/>అతో హేతోః పిశితాశనం యది మమ భ్రాతు ర్విఘ్నస్వరూపం భవేత్ తర్హ్యహం యత్ స్వభ్రాతు ర్విఘ్నజనకో న భవేయం తదర్థం యావజ్జీవనం పిశితం న భోక్ష్యే|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అహం కిమ్ ఏకః ప్రేరితో నాస్మి? కిమహం స్వతన్త్రో నాస్మి? అస్మాకం ప్రభు ర్యీశుః ఖ్రీష్టః కిం మయా నాదర్శి? యూయమపి కిం ప్రభునా మదీయశ్రమఫలస్వరూపా న భవథ?</para>
  <para style="p">
    <verse number="2" style="v"/>అన్యలోకానాం కృతే యద్యప్యహం ప్రేరితో న భవేయం తథాచ యుష్మత్కృతే ప్రేరితోఽస్మి యతః ప్రభునా మమ ప్రేరితత్వపదస్య ముద్రాస్వరూపా యూయమేవాధ్వే|</para>
  <para style="p">
    <verse number="3" style="v"/>యే లోకా మయి దోషమారోపయన్తి తాన్ ప్రతి మమ ప్రత్యుత్తరమేతత్|</para>
  <para style="p">
    <verse number="4" style="v"/>భోజనపానయోః కిమస్మాకం క్షమతా నాస్తి?</para>
  <para style="p">
    <verse number="5" style="v"/>అన్యే ప్రేరితాః ప్రభో ర్భ్రాతరౌ కైఫాశ్చ యత్ కుర్వ్వన్తి తద్వత్ కాఞ్చిత్ ధర్మ్మభగినీం వ్యూహ్య తయా సార్ద్ధం పర్య్యటితుం వయం కిం న శక్నుమః?</para>
  <para style="p">
    <verse number="6" style="v"/>సాంసారికశ్రమస్య పరిత్యాగాత్ కిం కేవలమహం బర్ణబ్బాశ్చ నివారితౌ?</para>
  <para style="p">
    <verse number="7" style="v"/>నిజధనవ్యయేన కః సంగ్రామం కరోతి? కో వా ద్రాక్షాక్షేత్రం కృత్వా తత్ఫలాని న భుఙ్క్తే? కో వా పశువ్రజం పాలయన్ తత్పయో న పివతి?</para>
  <para style="p">
    <verse number="8" style="v"/>కిమహం కేవలాం మానుషికాం వాచం వదామి? వ్యవస్థాయాం కిమేతాదృశం వచనం న విద్యతే?</para>
  <para style="p">
    <verse number="9" style="v"/>మూసావ్యవస్థాగ్రన్థే లిఖితమాస్తే, త్వం శస్యమర్ద్దకవృషస్యాస్యం న భంత్స్యసీతి| ఈశ్వరేణ బలీవర్ద్దానామేవ చిన్తా కిం క్రియతే?</para>
  <para style="p">
    <verse number="10" style="v"/>కిం వా సర్వ్వథాస్మాకం కృతే తద్వచనం తేనోక్తం? అస్మాకమేవ కృతే తల్లిఖితం| యః క్షేత్రం కర్షతి తేన ప్రత్యాశాయుక్తేన కర్ష్టవ్యం, యశ్చ శస్యాని మర్ద్దయతి తేన లాభప్రత్యాశాయుక్తేన మర్ద్దితవ్యం|</para>
  <para style="p">
    <verse number="11" style="v"/>యుష్మత్కృతేఽస్మాభిః పారత్రికాణి బీజాని రోపితాని, అతో యుష్మాకమైహికఫలానాం వయమ్ అంశినో భవిష్యామః కిమేతత్ మహత్ కర్మ్మ?</para>
  <para style="p">
    <verse number="12" style="v"/>యుష్మాసు యోఽధికారస్తస్య భాగినో యద్యన్యే భవేయుస్తర్హ్యస్మాభిస్తతోఽధికం కిం తస్య భాగిభి ర్న భవితవ్యం? అధికన్తు వయం తేనాధికారేణ న వ్యవహృతవన్తః కిన్తు ఖ్రీష్టీయసుసంవాదస్య కోఽపి వ్యాఘాతోఽస్మాభిర్యన్న జాయేత తదర్థం సర్వ్వం సహామహే|</para>
  <para style="p">
    <verse number="13" style="v"/>అపరం యే పవిత్రవస్తూనాం పరిచర్య్యాం కుర్వ్వన్తి తే పవిత్రవస్తుతో భక్ష్యాణి లభన్తే, యే చ వేద్యాః పరిచర్య్యాం కుర్వ్వన్తి తే వేదిస్థవస్తూనామ్ అంశినో భవన్త్యేతద్ యూయం కిం న విద?</para>
  <para style="p">
    <verse number="14" style="v"/>తద్వద్ యే సుసంవాదం ఘోషయన్తి తైః సుసంవాదేన జీవితవ్యమితి ప్రభునాదిష్టం|</para>
  <para style="p">
    <verse number="15" style="v"/>అహమేతేషాం సర్వ్వేషాం కిమపి నాశ్రితవాన్ మాం ప్రతి తదనుసారాత్ ఆచరితవ్యమిత్యాశయేనాపి పత్రమిదం మయా న లిఖ్యతే యతః కేనాపి జనేన మమ యశసో ముధాకరణాత్ మమ మరణం వరం|</para>
  <para style="p">
    <verse number="16" style="v"/>సుసంవాదఘేషణాత్ మమ యశో న జాయతే యతస్తద్ఘోషణం మమావశ్యకం యద్యహం సుసంవాదం న ఘోషయేయం తర్హి మాం ధిక్|</para>
  <para style="p">
    <verse number="17" style="v"/>ఇచ్ఛుకేన తత్ కుర్వ్వతా మయా ఫలం లప్స్యతే కిన్త్వనిచ్ఛుకేఽపి మయి తత్కర్మ్మణో భారోఽర్పితోఽస్తి|</para>
  <para style="p">
    <verse number="18" style="v"/>ఏతేన మయా లభ్యం ఫలం కిం? సుసంవాదేన మమ యోఽధికార ఆస్తే తం యదభద్రభావేన నాచరేయం తదర్థం సుసంవాదఘోషణసమయే తస్య ఖ్రీష్టీయసుసంవాదస్య నిర్వ్యయీకరణమేవ మమ ఫలం|</para>
  <para style="p">
    <verse number="19" style="v"/>సర్వ్వేషామ్ అనాయత్తోఽహం యద్ భూరిశో లోకాన్ ప్రతిపద్యే తదర్థం సర్వ్వేషాం దాసత్వమఙ్గీకృతవాన్|</para>
  <para style="p">
    <verse number="20" style="v"/>యిహూదీయాన్ యత్ ప్రతిపద్యే తదర్థం యిహూదీయానాం కృతే యిహూదీయఇవాభవం| యే చ వ్యవస్థాయత్తాస్తాన్ యత్ ప్రతిపద్యే తదర్థం వ్యవస్థానాయత్తో యోఽహం సోఽహం వ్యవస్థాయత్తానాం కృతే వ్యవస్థాయత్తఇవాభవం|</para>
  <para style="p">
    <verse number="21" style="v"/>యే చాలబ్ధవ్యవస్థాస్తాన్ యత్ ప్రతిపద్యే తదర్థమ్ ఈశ్వరస్య సాక్షాద్ అలబ్ధవ్యవస్థో న భూత్వా ఖ్రీష్టేన లబ్ధవ్యవస్థో యోఽహం సోఽహమ్ అలబ్ధవ్యవస్థానాం కృతేఽలబ్ధవ్యవస్థ ఇవాభవం|</para>
  <para style="p">
    <verse number="22" style="v"/>దుర్బ్బలాన్ యత్ ప్రతిపద్యే తదర్థమహం దుర్బ్బలానాం కృతే దుర్బ్బలఇవాభవం| ఇత్థం కేనాపి ప్రకారేణ కతిపయా లోకా యన్మయా పరిత్రాణం ప్రాప్నుయుస్తదర్థం యో యాదృశ ఆసీత్ తస్య కృతే ఽహం తాదృశఇవాభవం|</para>
  <para style="p">
    <verse number="23" style="v"/>ఇదృశ ఆచారః సుసంవాదార్థం మయా క్రియతే యతోఽహం తస్య ఫలానాం సహభాగీ భవితుమిచ్ఛామి|</para>
  <para style="p">
    <verse number="24" style="v"/>పణ్యలాభార్థం యే ధావన్తి ధావతాం తేషాం సర్వ్వేషాం కేవల ఏకః పణ్యం లభతే యుష్మాభిః కిమేతన్న జ్ఞాయతే? అతో యూయం యథా పణ్యం లప్స్యధ్వే తథైవ ధావత|</para>
  <para style="p">
    <verse number="25" style="v"/>మల్లా అపి సర్వ్వభోగే పరిమితభోగినో భవన్తి తే తు మ్లానాం స్రజం లిప్సన్తే కిన్తు వయమ్ అమ్లానాం లిప్సామహే|</para>
  <para style="p">
    <verse number="26" style="v"/>తస్మాద్ అహమపి ధావామి కిన్తు లక్ష్యమనుద్దిశ్య ధావామి తన్నహి| అహం మల్లఇవ యుధ్యామి చ కిన్తు ఛాయామాఘాతయన్నివ యుధ్యామి తన్నహి|</para>
  <para style="p">
    <verse number="27" style="v"/>ఇతరాన్ ప్రతి సుసంవాదం ఘోషయిత్వాహం యత్ స్వయమగ్రాహ్యో న భవామి తదర్థం దేహమ్ ఆహన్మి వశీకుర్వ్వే చ|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>హే భ్రాతరః, అస్మత్పితృపురుషానధి యూయం యదజ్ఞాతా న తిష్ఠతేతి మమ వాఞ్ఛా, తే సర్వ్వే మేఘాధఃస్థితా బభూవుః సర్వ్వే సముద్రమధ్యేన వవ్రజుః,</para>
  <para style="p">
    <verse number="2" style="v"/>సర్వ్వే మూసాముద్దిశ్య మేఘసముద్రయో ర్మజ్జితా బభూవుః</para>
  <para style="p">
    <verse number="3" style="v"/>సర్వ్వ ఏకమ్ ఆత్మికం భక్ష్యం బుభుజిర ఏకమ్ ఆత్మికం పేయం పపుశ్చ</para>
  <para style="p">
    <verse number="4" style="v"/>యతస్తేఽనుచరత ఆత్మికాద్ అచలాత్ లబ్ధం తోయం పపుః సోఽచలః ఖ్రీష్టఏవ|</para>
  <para style="p">
    <verse number="5" style="v"/>తథా సత్యపి తేషాం మధ్యేఽధికేషు లోకేష్వీశ్వరో న సన్తుతోషేతి హేతోస్తే ప్రన్తరే నిపాతితాః|</para>
  <para style="p">
    <verse number="6" style="v"/>ఏతస్మిన్ తే ఽస్మాకం నిదర్శనస్వరూపా బభూవుః; అతస్తే యథా కుత్సితాభిలాషిణో బభూవురస్మాభిస్తథా కుత్సితాభిలాషిభి ర్న భవితవ్యం|</para>
  <para style="p">
    <verse number="7" style="v"/>లిఖితమాస్తే, లోకా భోక్తుం పాతుఞ్చోపవివిశుస్తతః క్రీడితుముత్థితా ఇతయనేన ప్రకారేణ తేషాం కైశ్చిద్ యద్వద్ దేవపూజా కృతా యుష్మాభిస్తద్వత్ న క్రియతాం|</para>
  <para style="p">
    <verse number="8" style="v"/>అపరం తేషాం కైశ్చిద్ యద్వద్ వ్యభిచారః కృతస్తేన చైకస్మిన్ దినే త్రయోవింశతిసహస్రాణి లోకా నిపాతితాస్తద్వద్ అస్మాభి ర్వ్యభిచారో న కర్త్తవ్యః|</para>
  <para style="p">
    <verse number="9" style="v"/>తేషాం కేచిద్ యద్వత్ ఖ్రీష్టం పరీక్షితవన్తస్తస్మాద్ భుజఙ్గై ర్నష్టాశ్చ తద్వద్ అస్మాభిః ఖ్రీష్టో న పరీక్షితవ్యః|</para>
  <para style="p">
    <verse number="10" style="v"/>తేషాం కేచిద్ యథా వాక్కలహం కృతవన్తస్తత్కారణాత్ హన్త్రా వినాశితాశ్చ యుష్మాభిస్తద్వద్ వాక్కలహో న క్రియతాం|</para>
  <para style="p">
    <verse number="11" style="v"/>తాన్ ప్రతి యాన్యేతాని జఘటిరే తాన్యస్మాకం నిదర్శనాని జగతః శేషయుగే వర్త్తమానానామ్ అస్మాకం శిక్షార్థం లిఖితాని చ బభూవుః|</para>
  <para style="p">
    <verse number="12" style="v"/>అతఏవ యః కశ్చిద్ సుస్థిరంమన్యః స యన్న పతేత్ తత్ర సావధానో భవతు|</para>
  <para style="p">
    <verse number="13" style="v"/>మానుషికపరీక్షాతిరిక్తా కాపి పరీక్షా యుష్మాన్ నాక్రామత్, ఈశ్వరశ్చ విశ్వాస్యః సోఽతిశక్త్యాం పరీక్షాయాం పతనాత్ యుష్మాన్ రక్షిష్యతి, పరీక్షా చ యద్ యుష్మాభిః సోఢుం శక్యతే తదర్థం తయా సహ నిస్తారస్య పన్థానం నిరూపయిష్యతి|</para>
  <para style="p">
    <verse number="14" style="v"/>హే ప్రియభ్రాతరః, దేవపూజాతో దూరమ్ అపసరత|</para>
  <para style="p">
    <verse number="15" style="v"/>అహం యుష్మాన్ విజ్ఞాన్ మత్వా ప్రభాషే మయా యత్ కథ్యతే తద్ యుష్మాభి ర్వివిచ్యతాం|</para>
  <para style="p">
    <verse number="16" style="v"/>యద్ ధన్యవాదపాత్రమ్ అస్మాభి ర్ధన్యం గద్యతే తత్ కిం ఖ్రీష్టస్య శోణితస్య సహభాగిత్వం నహి? యశ్చ పూపోఽస్మాభి ర్భజ్యతే స కిం ఖ్రీష్టస్య వపుషః సహభాగిత్వం నహి?</para>
  <para style="p">
    <verse number="17" style="v"/>వయం బహవః సన్తోఽప్యేకపూపస్వరూపా ఏకవపుఃస్వరూపాశ్చ భవామః, యతో వయం సర్వ్వ ఏకపూపస్య సహభాగినః|</para>
  <para style="p">
    <verse number="18" style="v"/>యూయం శారీరికమ్ ఇస్రాయేలీయవంశం నిరీక్షధ్వం| యే బలీనాం మాంసాని భుఞ్జతే తే కిం యజ్ఞవేద్యాః సహభాగినో న భవన్తి?</para>
  <para style="p">
    <verse number="19" style="v"/>ఇత్యనేన మయా కిం కథ్యతే? దేవతా వాస్తవికీ దేవతాయై బలిదానం వా వాస్తవికం కిం భవేత్?</para>
  <para style="p">
    <verse number="20" style="v"/>తన్నహి కిన్తు భిన్నజాతిభి ర్యే బలయో దీయన్తే త ఈశ్వరాయ తన్నహి భూతేభ్యఏవ దీయన్తే తస్మాద్ యూయం యద్ భూతానాం సహభాగినో భవథేత్యహం నాభిలషామి|</para>
  <para style="p">
    <verse number="21" style="v"/>ప్రభోః కంసేన భూతానామపి కంసేన పానం యుష్మాభిరసాధ్యం; యూయం ప్రభో ర్భోజ్యస్య భూతానామపి భోజ్యస్య సహభాగినో భవితుం న శక్నుథ|</para>
  <para style="p">
    <verse number="22" style="v"/>వయం కిం ప్రభుం స్పర్ద్ధిష్యామహే? వయం కిం తస్మాద్ బలవన్తః?</para>
  <para style="p">
    <verse number="23" style="v"/>మాం ప్రతి సర్వ్వం కర్మ్మాప్రతిషిద్ధం కిన్తు న సర్వ్వం హితజనకం సర్వ్వమ్ అప్రతిషిద్ధం కిన్తు న సర్వ్వం నిష్ఠాజనకం|</para>
  <para style="p">
    <verse number="24" style="v"/>ఆత్మహితః కేనాపి న చేష్టితవ్యః కిన్తు సర్వ్వైః పరహితశ్చేష్టితవ్యః|</para>
  <para style="p">
    <verse number="25" style="v"/>ఆపణే యత్ క్రయ్యం తద్ యుష్మాభిః సంవేదస్యార్థం కిమపి న పృష్ట్వా భుజ్యతాం</para>
  <para style="p">
    <verse number="26" style="v"/>యతః పృథివీ తన్మధ్యస్థఞ్చ సర్వ్వం పరమేశ్వరస్య|</para>
  <para style="p">
    <verse number="27" style="v"/>అపరమ్ అవిశ్వాసిలోకానాం కేనచిత్ నిమన్త్రితా యూయం యది తత్ర జిగమిషథ తర్హి తేన యద్ యద్ ఉపస్థాప్యతే తద్ యుష్మాభిః సంవేదస్యార్థం కిమపి న పృష్ట్వా భుజ్యతాం|</para>
  <para style="p">
    <verse number="28" style="v"/>కిన్తు తత్ర యది కశ్చిద్ యుష్మాన్ వదేత్ భక్ష్యమేతద్ దేవతాయాః ప్రసాద ఇతి తర్హి తస్య జ్ఞాపయితురనురోధాత్ సంవేదస్యార్థఞ్చ తద్ యుష్మాభి ర్న భోక్తవ్యం| పృథివీ తన్మధ్యస్థఞ్చ సర్వ్వం పరమేశ్వరస్య,</para>
  <para style="p">
    <verse number="29" style="v"/>సత్యమేతత్, కిన్తు మయా యః సంవేదో నిర్ద్దిశ్యతే స తవ నహి పరస్యైవ|</para>
  <para style="p">
    <verse number="30" style="v"/>అనుగ్రహపాత్రేణ మయా ధన్యవాదం కృత్వా యద్ భుజ్యతే తత్కారణాద్ అహం కుతో నిన్దిష్యే?</para>
  <para style="p">
    <verse number="31" style="v"/>తస్మాద్ భోజనం పానమ్ అన్యద్వా కర్మ్మ కుర్వ్వద్భి ర్యుష్మాభిః సర్వ్వమేవేశ్వరస్య మహిమ్నః ప్రకాశార్థం క్రియతాం|</para>
  <para style="p">
    <verse number="32" style="v"/>యిహూదీయానాం భిన్నజాతీయానామ్ ఈశ్వరస్య సమాజస్య వా విఘ్నజనకై ర్యుష్మాభి ర్న భవితవ్యం|</para>
  <para style="p">
    <verse number="33" style="v"/>అహమప్యాత్మహితమ్ అచేష్టమానో బహూనాం పరిత్రాణార్థం తేషాం హితం చేష్టమానః సర్వ్వవిషయే సర్వ్వేషాం తుష్టికరో భవామీత్యనేనాహం యద్వత్ ఖ్రీష్టస్యానుగామీ తద్వద్ యూయం మమానుగామినో భవత|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>హే భ్రాతరః, యూయం సర్వ్వస్మిన్ కార్య్యే మాం స్మరథ మయా చ యాదృగుపదిష్టాస్తాదృగాచరథైతత్కారణాత్ మయా ప్రశంసనీయా ఆధ్బే|</para>
  <para style="p">
    <verse number="2" style="v"/>తథాపి మమైషా వాఞ్ఛా యద్ యూయమిదమ్ అవగతా భవథ,</para>
  <para style="p">
    <verse number="3" style="v"/>ఏకైకస్య పురుషస్యోత్తమాఙ్గస్వరూపః ఖ్రీష్టః, యోషితశ్చోత్తమాఙ్గస్వరూపః పుమాన్, ఖ్రీష్టస్య చోత్తమాఙ్గస్వరూప ఈశ్వరః|</para>
  <para style="p">
    <verse number="4" style="v"/>అపరమ్ ఆచ్ఛాదితోత్తమాఙ్గేన యేన పుంసా ప్రార్థనా క్రియత ఈశ్వరీయవాణీ కథ్యతే వా తేన స్వీయోత్తమాఙ్గమ్ అవజ్ఞాయతే|</para>
  <para style="p">
    <verse number="5" style="v"/>అనాచ్ఛాదితోత్తమాఙ్గయా యయా యోషితా చ ప్రార్థనా క్రియత ఈశ్వరీయవాణీ కథ్యతే వా తయాపి స్వీయోత్తమాఙ్గమ్ అవజ్ఞాయతే యతః సా ముణ్డితశిరఃసదృశా|</para>
  <para style="p">
    <verse number="6" style="v"/>అనాచ్ఛాదితమస్తకా యా యోషిత్ తస్యాః శిరః ముణ్డనీయమేవ కిన్తు యోషితః కేశచ్ఛేదనం శిరోముణ్డనం వా యది లజ్జాజనకం భవేత్ తర్హి తయా స్వశిర ఆచ్ఛాద్యతాం|</para>
  <para style="p">
    <verse number="7" style="v"/>పుమాన్ ఈశ్వరస్య ప్రతిమూర్త్తిః ప్రతితేజఃస్వరూపశ్చ తస్మాత్ తేన శిరో నాచ్ఛాదనీయం కిన్తు సీమన్తినీ పుంసః ప్రతిబిమ్బస్వరూపా|</para>
  <para style="p">
    <verse number="8" style="v"/>యతో యోషాతః పుమాన్ నోదపాది కిన్తు పుంసో యోషిద్ ఉదపాది|</para>
  <para style="p">
    <verse number="9" style="v"/>అధికన్తు యోషితః కృతే పుంసః సృష్టి ర్న బభూవ కిన్తు పుంసః కృతే యోషితః సృష్టి ర్బభూవ|</para>
  <para style="p">
    <verse number="10" style="v"/>ఇతి హేతో ర్దూతానామ్ ఆదరాద్ యోషితా శిరస్యధీనతాసూచకమ్ ఆవరణం ధర్త్తవ్యం|</para>
  <para style="p">
    <verse number="11" style="v"/>తథాపి ప్రభో ర్విధినా పుమాంసం వినా యోషిన్న జాయతే యోషితఞ్చ వినా పుమాన్ న జాయతే|</para>
  <para style="p">
    <verse number="12" style="v"/>యతో యథా పుంసో యోషిద్ ఉదపాది తథా యోషితః పుమాన్ జాయతే, సర్వ్వవస్తూని చేశ్వరాద్ ఉత్పద్యన్తే|</para>
  <para style="p">
    <verse number="13" style="v"/>యుష్మాభిరేవైతద్ వివిచ్యతాం, అనావృతయా యోషితా ప్రార్థనం కిం సుదృశ్యం భవేత్?</para>
  <para style="p">
    <verse number="14" style="v"/>పురుషస్య దీర్ఘకేశత్వం తస్య లజ్జాజనకం, కిన్తు యోషితో దీర్ఘకేశత్వం తస్యా గౌరవజనకం</para>
  <para style="p">
    <verse number="15" style="v"/>యత ఆచ్ఛాదనాయ తస్యై కేశా దత్తా ఇతి కిం యుష్మాభిః స్వభావతో న శిక్ష్యతే?</para>
  <para style="p">
    <verse number="16" style="v"/>అత్ర యది కశ్చిద్ వివదితుమ్ ఇచ్ఛేత్ తర్హ్యస్మాకమ్ ఈశ్వరీయసమితీనాఞ్చ తాదృశీ రీతి ర్న విద్యతే|</para>
  <para style="p">
    <verse number="17" style="v"/>యుష్మాభి ర్న భద్రాయ కిన్తు కుత్సితాయ సమాగమ్యతే తస్మాద్ ఏతాని భాషమాణేన మయా యూయం న ప్రశంసనీయాః|</para>
  <para style="p">
    <verse number="18" style="v"/>ప్రథమతః సమితౌ సమాగతానాం యుష్మాకం మధ్యే భేదాః సన్తీతి వార్త్తా మయా శ్రూయతే తన్మధ్యే కిఞ్చిత్ సత్యం మన్యతే చ|</para>
  <para style="p">
    <verse number="19" style="v"/>యతో హేతో ర్యుష్మన్మధ్యే యే పరీక్షితాస్తే యత్ ప్రకాశ్యన్తే తదర్థం భేదై ర్భవితవ్యమేవ|</para>
  <para style="p">
    <verse number="20" style="v"/>ఏకత్ర సమాగతై ర్యుష్మాభిః ప్రభావం భేाజ్యం భుజ్యత ఇతి నహి;</para>
  <para style="p">
    <verse number="21" style="v"/>యతో భోజనకాలే యుష్మాకమేకైకేన స్వకీయం భక్ష్యం తూర్ణం గ్రస్యతే తస్మాద్ ఏకో జనో బుభుక్షితస్తిష్ఠతి, అన్యశ్చ పరితృప్తో భవతి|</para>
  <para style="p">
    <verse number="22" style="v"/>భోజనపానార్థం యుష్మాకం కిం వేశ్మాని న సన్తి? యుష్మాభి ర్వా కిమ్ ఈశ్వరస్య సమితిం తుచ్ఛీకృత్య దీనా లోకా అవజ్ఞాయన్తే? ఇత్యనేన మయా కిం వక్తవ్యం? యూయం కిం మయా ప్రశంసనీయాః? ఏతస్మిన్ యూయం న ప్రశంసనీయాః|</para>
  <para style="p">
    <verse number="23" style="v"/>ప్రభుతో య ఉపదేశో మయా లబ్ధో యుష్మాసు సమర్పితశ్చ స ఏషః|</para>
  <para style="p">
    <verse number="24" style="v"/>పరకరసమర్పణక్షపాయాం ప్రభు ర్యీశుః పూపమాదాయేశ్వరం ధన్యం వ్యాహృత్య తం భఙ్క్త్వా భాషితవాన్ యుష్మాభిరేతద్ గృహ్యతాం భుజ్యతాఞ్చ తద్ యుష్మత్కృతే భగ్నం మమ శరీరం; మమ స్మరణార్థం యుష్మాభిరేతత్ క్రియతాం|</para>
  <para style="p">
    <verse number="25" style="v"/>పునశ్చ భేజనాత్ పరం తథైవ కంసమ్ ఆదాయ తేనోక్తం కంసోఽయం మమ శోణితేన స్థాపితో నూతననియమః; యతివారం యుష్మాభిరేతత్ పీయతే తతివారం మమ స్మరణార్థం పీయతాం|</para>
  <para style="p">
    <verse number="26" style="v"/>యతివారం యుష్మాభిరేష పూపో భుజ్యతే భాజనేనానేన పీయతే చ తతివారం ప్రభోరాగమనం యావత్ తస్య మృత్యుః ప్రకాశ్యతే|</para>
  <para style="p">
    <verse number="27" style="v"/>అపరఞ్చ యః కశ్చిద్ అయోగ్యత్వేన ప్రభోరిమం పూపమ్ అశ్నాతి తస్యానేన భాజనేన పివతి చ స ప్రభోః కాయరుధిరయో ర్దణ్డదాయీ భవిష్యతి|</para>
  <para style="p">
    <verse number="28" style="v"/>తస్మాత్ మానవేనాగ్ర ఆత్మాన పరీక్ష్య పశ్చాద్ ఏష పూపో భుజ్యతాం కంసేనానేన చ పీయతాం|</para>
  <para style="p">
    <verse number="29" style="v"/>యేన చానర్హత్వేన భుజ్యతే పీయతే చ ప్రభోః కాయమ్ అవిమృశతా తేన దణ్డప్రాప్తయే భుజ్యతే పీయతే చ|</para>
  <para style="p">
    <verse number="30" style="v"/>ఏతత్కారణాద్ యుష్మాకం భూరిశో లోకా దుర్బ్బలా రోగిణశ్చ సన్తి బహవశ్చ మహానిద్రాం గతాః|</para>
  <para style="p">
    <verse number="31" style="v"/>అస్మాభి ర్యద్యాత్మవిచారోఽకారిష్యత తర్హి దణ్డో నాలప్స్యత;</para>
  <para style="p">
    <verse number="32" style="v"/>కిన్తు యదాస్మాకం విచారో భవతి తదా వయం జగతో జనైః సమం యద్ దణ్డం న లభామహే తదర్థం ప్రభునా శాస్తిం భుంజ్మహే|</para>
  <para style="p">
    <verse number="33" style="v"/>హే మమ భ్రాతరః, భోజనార్థం మిలితానాం యుష్మాకమ్ ఏకేనేతరోఽనుగృహ్యతాం|</para>
  <para style="p">
    <verse number="34" style="v"/>యశ్చ బుభుక్షితః స స్వగృహే భుఙ్క్తాం| దణ్డప్రాప్తయే యుష్మాభి ర్న సమాగమ్యతాం| ఏతద్భిన్నం యద్ ఆదేష్టవ్యం తద్ యుష్మత్సమీపాగమనకాలే మయాదేక్ష్యతే|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>హే భ్రాతరః, యూయం యద్ ఆత్మికాన్ దాయాన్ అనవగతాస్తిష్ఠథ తదహం నాభిలషామి|</para>
  <para style="p">
    <verse number="2" style="v"/>పూర్వ్వం భిన్నజాతీయా యూయం యద్వద్ వినీతాస్తద్వద్ అవాక్ప్రతిమానామ్ అనుగామిన ఆధ్బమ్ ఇతి జానీథ|</para>
  <para style="p">
    <verse number="3" style="v"/>ఇతి హేతోరహం యుష్మభ్యం నివేదయామి, ఈశ్వరస్యాత్మనా భాషమాణః కోఽపి యీశుం శప్త ఇతి న వ్యాహరతి, పునశ్చ పవిత్రేణాత్మనా వినీతం వినాన్యః కోఽపి యీశుం ప్రభురితి వ్యాహర్త్తుం న శక్నోతి|</para>
  <para style="p">
    <verse number="4" style="v"/>దాయా బహువిధాః కిన్త్వేక ఆత్మా</para>
  <para style="p">
    <verse number="5" style="v"/>పరిచర్య్యాశ్చ బహువిధాః కిన్త్వేకః ప్రభుః|</para>
  <para style="p">
    <verse number="6" style="v"/>సాధనాని బహువిధాని కిన్తు సర్వ్వేషు సర్వ్వసాధక ఈశ్వర ఏకః|</para>
  <para style="p">
    <verse number="7" style="v"/>ఏకైకస్మై తస్యాత్మనో దర్శనం పరహితార్థం దీయతే|</para>
  <para style="p">
    <verse number="8" style="v"/>ఏకస్మై తేనాత్మనా జ్ఞానవాక్యం దీయతే, అన్యస్మై తేనైవాత్మనాదిష్టం విద్యావాక్యమ్,</para>
  <para style="p">
    <verse number="9" style="v"/>అన్యస్మై తేనైవాత్మనా విశ్వాసః, అన్యస్మై తేనైవాత్మనా స్వాస్థ్యదానశక్తిః,</para>
  <para style="p">
    <verse number="10" style="v"/>అన్యస్మై దుఃసాధ్యసాధనశక్తిరన్యస్మై చేశ్వరీయాదేశః, అన్యస్మై చాతిమానుషికస్యాదేశస్య విచారసామర్థ్యమ్, అన్యస్మై పరభాషాభాషణశక్తిరన్యస్మై చ భాషార్థభాషణసామర్యం దీయతే|</para>
  <para style="p">
    <verse number="11" style="v"/>ఏకేనాద్వితీయేనాత్మనా యథాభిలాషమ్ ఏకైకస్మై జనాయైకైకం దానం వితరతా తాని సర్వ్వాణి సాధ్యన్తే|</para>
  <para style="p">
    <verse number="12" style="v"/>దేహ ఏకః సన్నపి యద్వద్ బహ్వఙ్గయుక్తో భవతి, తస్యైకస్య వపుషో ఽఙ్గానాం బహుత్వేన యద్వద్ ఏకం వపు ర్భవతి, తద్వత్ ఖ్రీష్టః|</para>
  <para style="p">
    <verse number="13" style="v"/>యతో హేతో ర్యిహూదిభిన్నజాతీయదాసస్వతన్త్రా వయం సర్వ్వే మజ్జనేనైకేనాత్మనైకదేహీకృతాః సర్వ్వే చైకాత్మభుక్తా అభవామ|</para>
  <para style="p">
    <verse number="14" style="v"/>ఏకేనాఙ్గేన వపు ర్న భవతి కిన్తు బహుభిః|</para>
  <para style="p">
    <verse number="15" style="v"/>తత్ర చరణం యది వదేత్ నాహం హస్తస్తస్మాత్ శరీరస్య భాగో నాస్మీతి తర్హ్యనేన శరీరాత్ తస్య వియోగో న భవతి|</para>
  <para style="p">
    <verse number="16" style="v"/>శ్రోత్రం వా యది వదేత్ నాహం నయనం తస్మాత్ శరీరస్యాంశో నాస్మీతి తర్హ్యనేన శరీరాత్ తస్య వియోగో న భవతి|</para>
  <para style="p">
    <verse number="17" style="v"/>కృత్స్నం శరీరం యది దర్శనేన్ద్రియం భవేత్ తర్హి శ్రవణేన్ద్రియం కుత్ర స్థాస్యతి? తత్ కృత్స్నం యది వా శ్రవణేన్ద్రియం భవేత్ తర్హి ఘ్రణేన్ద్రియం కుత్ర స్థాస్యతి?</para>
  <para style="p">
    <verse number="18" style="v"/>కిన్త్విదానీమ్ ఈశ్వరేణ యథాభిలషితం తథైవాఙ్గప్రత్యఙ్గానామ్ ఏకైకం శరీరే స్థాపితం|</para>
  <para style="p">
    <verse number="19" style="v"/>తత్ కృత్స్నం యద్యేకాఙ్గరూపి భవేత్ తర్హి శరీరే కుత్ర స్థాస్యతి?</para>
  <para style="p">
    <verse number="20" style="v"/>తస్మాద్ అఙ్గాని బహూని సన్తి శరీరం త్వేకమేవ|</para>
  <para style="p">
    <verse number="21" style="v"/>అతఏవ త్వయా మమ ప్రయోజనం నాస్తీతి వాచం పాణిం వదితుం నయనం న శక్నోతి, తథా యువాభ్యాం మమ ప్రయోజనం నాస్తీతి మూర్ద్ధా చరణౌ వదితుం న శక్నోతిః;</para>
  <para style="p">
    <verse number="22" style="v"/>వస్తుతస్తు విగ్రహస్య యాన్యఙ్గాన్యస్మాభి ర్దుర్బ్బలాని బుధ్యన్తే తాన్యేవ సప్రయోజనాని సన్తి|</para>
  <para style="p">
    <verse number="23" style="v"/>యాని చ శరీరమధ్యేఽవమన్యాని బుధ్యతే తాన్యస్మాభిరధికం శోభ్యన్తే| యాని చ కుదృశ్యాని తాని సుదృశ్యతరాణి క్రియన్తే</para>
  <para style="p">
    <verse number="24" style="v"/>కిన్తు యాని స్వయం సుదృశ్యాని తేషాం శోభనమ్ నిష్ప్రయోజనం|</para>
  <para style="p">
    <verse number="25" style="v"/>శరీరమధ్యే యద్ భేదో న భవేత్ కిన్తు సర్వ్వాణ్యఙ్గాని యద్ ఐక్యభావేన సర్వ్వేషాం హితం చిన్తయన్తి తదర్థమ్ ఈశ్వరేణాప్రధానమ్ ఆదరణీయం కృత్వా శరీరం విరచితం|</para>
  <para style="p">
    <verse number="26" style="v"/>తస్మాద్ ఏకస్యాఙ్గస్య పీడాయాం జాతాయాం సర్వ్వాణ్యఙ్గాని తేన సహ పీడ్యన్తే, ఏకస్య సమాదరే జాతే చ సర్వ్వాణి తేన సహ సంహృష్యన్తి|</para>
  <para style="p">
    <verse number="27" style="v"/>యూయఞ్చ ఖ్రీష్టస్య శరీరం, యుష్మాకమ్ ఏకైకశ్చ తస్యైకైకమ్ అఙ్గం|</para>
  <para style="p">
    <verse number="28" style="v"/>కేచిత్ కేచిత్ సమితావీశ్వరేణ ప్రథమతః ప్రేరితా ద్వితీయత ఈశ్వరీయాదేశవక్తారస్తృతీయత ఉపదేష్టారో నియుక్తాః, తతః పరం కేభ్యోఽపి చిత్రకార్య్యసాధనసామర్థ్యమ్ అనామయకరణశక్తిరుపకృతౌ లోకశాసనే వా నైపుణ్యం నానాభాషాభాషణసామర్థ్యం వా తేన వ్యతారి|</para>
  <para style="p">
    <verse number="29" style="v"/>సర్వ్వే కిం ప్రేరితాః? సర్వ్వే కిమ్ ఈశ్వరీయాదేశవక్తారః? సర్వ్వే కిమ్ ఉపదేష్టారః? సర్వ్వే కిం చిత్రకార్య్యసాధకాః?</para>
  <para style="p">
    <verse number="30" style="v"/>సర్వ్వే కిమ్ అనామయకరణశక్తియుక్తాః? సర్వ్వే కిం పరభాషావాదినః? సర్వ్వే వా కిం పరభాషార్థప్రకాశకాః?</para>
  <para style="p">
    <verse number="31" style="v"/>యూయం శ్రేష్ఠదాయాన్ లబ్ధుం యతధ్వం| అనేన యూయం మయా సర్వ్వోత్తమమార్గం దర్శయితవ్యాః|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>మర్త్యస్వర్గీయాణాం భాషా భాషమాణోఽహం యది ప్రేమహీనో భవేయం తర్హి వాదకతాలస్వరూపో నినాదకారిభేరీస్వరూపశ్చ భవామి|</para>
  <para style="p">
    <verse number="2" style="v"/>అపరఞ్చ యద్యహమ్ ఈశ్వరీయాదేశాఢ్యః స్యాం సర్వ్వాణి గుప్తవాక్యాని సర్వ్వవిద్యాఞ్చ జానీయాం పూర్ణవిశ్వాసః సన్ శైలాన్ స్థానాన్తరీకర్త్తుం శక్నుయాఞ్చ కిన్తు యది ప్రేమహీనో భవేయం తర్హ్యగణనీయ ఏవ భవామి|</para>
  <para style="p">
    <verse number="3" style="v"/>అపరం యద్యహమ్ అన్నదానేన సర్వ్వస్వం త్యజేయం దాహనాయ స్వశరీరం సమర్పయేయఞ్చ కిన్తు యది ప్రేమహీనో భవేయం తర్హి తత్సర్వ్వం మదర్థం నిష్ఫలం భవతి|</para>
  <para style="p">
    <verse number="4" style="v"/>ప్రేమ చిరసహిష్ణు హితైషి చ, ప్రేమ నిర్ద్వేషమ్ అశఠం నిర్గర్వ్వఞ్చ|</para>
  <para style="p">
    <verse number="5" style="v"/>అపరం తత్ కుత్సితం నాచరతి, ఆత్మచేష్టాం న కురుతే సహసా న క్రుధ్యతి పరానిష్టం న చిన్తయతి,</para>
  <para style="p">
    <verse number="6" style="v"/>అధర్మ్మే న తుష్యతి సత్య ఏవ సన్తుష్యతి|</para>
  <para style="p">
    <verse number="7" style="v"/>తత్ సర్వ్వం తితిక్షతే సర్వ్వత్ర విశ్వసితి సర్వ్వత్ర భద్రం ప్రతీక్షతే సర్వ్వం సహతే చ|</para>
  <para style="p">
    <verse number="8" style="v"/>ప్రేమ్నో లోపః కదాపి న భవిష్యతి, ఈశ్వరీయాదేశకథనం లోప్స్యతే పరభాషాభాషణం నివర్త్తిష్యతే జ్ఞానమపి లోపం యాస్యతి|</para>
  <para style="p">
    <verse number="9" style="v"/>యతోఽస్మాకం జ్ఞానం ఖణ్డమాత్రమ్ ఈశ్వరీయాదేశకథనమపి ఖణ్డమాత్రం|</para>
  <para style="p">
    <verse number="10" style="v"/>కిన్త్వస్మాసు సిద్ధతాం గతేషు తాని ఖణ్డమాత్రాణి లోపం యాస్యన్తే|</para>
  <para style="p">
    <verse number="11" style="v"/>బాల్యకాలేఽహం బాల ఇవాభాషే బాల ఇవాచిన్తయఞ్చ కిన్తు యౌవనే జాతే తత్సర్వ్వం బాల్యాచరణం పరిత్యక్తవాన్|</para>
  <para style="p">
    <verse number="12" style="v"/>ఇదానీమ్ అభ్రమధ్యేనాస్పష్టం దర్శనమ్ అస్మాభి ర్లభ్యతే కిన్తు తదా సాక్షాత్ దర్శనం లప్స్యతే| అధునా మమ జ్ఞానమ్ అల్పిష్ఠం కిన్తు తదాహం యథావగమ్యస్తథైవావగతో భవిష్యామి|</para>
  <para style="p">
    <verse number="13" style="v"/>ఇదానీం ప్రత్యయః ప్రత్యాశా ప్రేమ చ త్రీణ్యేతాని తిష్ఠన్తి తేషాం మధ్యే చ ప్రేమ శ్రేష్ఠం|</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>యూయం ప్రేమాచరణే ప్రయతధ్వమ్ ఆత్మికాన్ దాయానపి విశేషత ఈశ్వరీయాదేశకథనసామర్థ్యం ప్రాప్తుం చేష్టధ్వం|</para>
  <para style="p">
    <verse number="2" style="v"/>యో జనః పరభాషాం భాషతే స మానుషాన్ న సమ్భాషతే కిన్త్వీశ్వరమేవ యతః కేనాపి కిమపి న బుధ్యతే స చాత్మనా నిగూఢవాక్యాని కథయతి;</para>
  <para style="p">
    <verse number="3" style="v"/>కిన్తు యో జన ఈశ్వరీయాదేశం కథయతి స పరేషాం నిష్ఠాయై హితోపదేశాయ సాన్త్వనాయై చ భాషతే|</para>
  <para style="p">
    <verse number="4" style="v"/>పరభాషావాద్యాత్మన ఏవ నిష్ఠాం జనయతి కిన్త్వీశ్వరీయాదేశవాదీ సమితే ర్నిష్ఠాం జనయతి|</para>
  <para style="p">
    <verse number="5" style="v"/>యుష్మాకం సర్వ్వేషాం పరభాషాభాషణమ్ ఇచ్ఛామ్యహం కిన్త్వీశ్వరీయాదేశకథనమ్ అధికమపీచ్ఛామి| యతః సమితే ర్నిష్ఠాయై యేన స్వవాక్యానామ్ అర్థో న క్రియతే తస్మాత్ పరభాషావాదిత ఈశ్వరీయాదేశవాదీ శ్రేయాన్|</para>
  <para style="p">
    <verse number="6" style="v"/>హే భ్రాతరః, ఇదానీం మయా యది యుష్మత్సమీపం గమ్యతే తర్హీశ్వరీయదర్శనస్య జ్ఞానస్య వేశ్వరీయాదేశస్య వా శిక్షాయా వా వాక్యాని న భాషిత్వా పరభాషాం భాషమాణేన మయా యూయం కిముపకారిష్యధ్వే?</para>
  <para style="p">
    <verse number="7" style="v"/>అపరం వంశీవల్లక్యాదిషు నిష్ప్రాణిషు వాద్యయన్త్రేషు వాదితేషు యది క్కణా న విశిష్యన్తే తర్హి కిం వాద్యం కిం వా గానం భవతి తత్ కేన బోద్ధుం శక్యతే?</para>
  <para style="p">
    <verse number="8" style="v"/>అపరం రణతూర్య్యా నిస్వణో యద్యవ్యక్తో భవేత్ తర్హి యుద్ధాయ కః సజ్జిష్యతే?</para>
  <para style="p">
    <verse number="9" style="v"/>తద్వత్ జిహ్వాభి ర్యది సుగమ్యా వాక్ యుష్మాభి ర్న గద్యేత తర్హి యద్ గద్యతే తత్ కేన భోత్స్యతే? వస్తుతో యూయం దిగాలాపిన ఇవ భవిష్యథ|</para>
  <para style="p">
    <verse number="10" style="v"/>జగతి కతిప్రకారా ఉక్తయో విద్యన్తే? తాసామేకాపి నిరర్థికా నహి;</para>
  <para style="p">
    <verse number="11" style="v"/>కిన్తూక్తేరర్థో యది మయా న బుధ్యతే తర్హ్యహం వక్త్రా మ్లేచ్ఛ ఇవ మంస్యే వక్తాపి మయా మ్లేచ్ఛ ఇవ మంస్యతే|</para>
  <para style="p">
    <verse number="12" style="v"/>తస్మాద్ ఆత్మికదాయలిప్సవో యూయం సమితే ర్నిష్ఠార్థం ప్రాప్తబహువరా భవితుం యతధ్వం,</para>
  <para style="p">
    <verse number="13" style="v"/>అతఏవ పరభాషావాదీ యద్ అర్థకరోఽపి భవేత్ తత్ ప్రార్థయతాం|</para>
  <para style="p">
    <verse number="14" style="v"/>యద్యహం పరభాషయా ప్రర్థనాం కుర్య్యాం తర్హి మదీయ ఆత్మా ప్రార్థయతే, కిన్తు మమ బుద్ధి ర్నిష్ఫలా తిష్ఠతి|</para>
  <para style="p">
    <verse number="15" style="v"/>ఇత్యనేన కిం కరణీయం? అహమ్ ఆత్మనా ప్రార్థయిష్యే బుద్ధ్యాపి ప్రార్థయిష్యే; అపరం ఆత్మనా గాస్యామి బుద్ధ్యాపి గాస్యామి|</para>
  <para style="p">
    <verse number="16" style="v"/>త్వం యదాత్మనా ధన్యవాదం కరోషి తదా యద్ వదసి తద్ యది శిష్యేనేవోపస్థితేన జనేన న బుద్ధ్యతే తర్హి తవ ధన్యవాదస్యాన్తే తథాస్త్వితి తేన వక్తం కథం శక్యతే?</para>
  <para style="p">
    <verse number="17" style="v"/>త్వం సమ్యగ్ ఈశ్వరం ధన్యం వదసీతి సత్యం తథాపి తత్ర పరస్య నిష్ఠా న భవతి|</para>
  <para style="p">
    <verse number="18" style="v"/>యుష్మాకం సర్వ్వేభ్యోఽహం పరభాషాభాషణే సమర్థోఽస్మీతి కారణాద్ ఈశ్వరం ధన్యం వదామి;</para>
  <para style="p">
    <verse number="19" style="v"/>తథాపి సమితౌ పరోపదేశార్థం మయా కథితాని పఞ్చ వాక్యాని వరం న చ లక్షం పరభాషీయాని వాక్యాని|</para>
  <para style="p">
    <verse number="20" style="v"/>హే భ్రాతరః,యూయం బుద్ధ్యా బాలకాఇవ మా భూత పరన్తు దుష్టతయా శిశవఇవ భూత్వా బుద్ధ్యా సిద్ధా భవత|</para>
  <para style="p">
    <verse number="21" style="v"/>శాస్త్ర ఇదం లిఖితమాస్తే, యథా, ఇత్యవోచత్ పరేశోఽహమ్ ఆభాషిష్య ఇమాన్ జనాన్| భాషాభిః పరకీయాభి ర్వక్త్రైశ్చ పరదేశిభిః| తథా మయా కృతేఽపీమే న గ్రహీష్యన్తి మద్వచః||</para>
  <para style="p">
    <verse number="22" style="v"/>అతఏవ తత్ పరభాషాభాషణం అవిశ్చాసినః ప్రతి చిహ్నరూపం భవతి న చ విశ్వాసినః ప్రతి; కిన్త్వీశ్వరీయాదేశకథనం నావిశ్వాసినః ప్రతి తద్ విశ్వాసినః ప్రత్యేవ|</para>
  <para style="p">
    <verse number="23" style="v"/>సమితిభుక్తేషు సర్వ్వేషు ఏకస్మిన్ స్థానే మిలిత్వా పరభాషాం భాషమాణేషు యది జ్ఞానాకాఙ్క్షిణోఽవిశ్వాసినో వా తత్రాగచ్ఛేయుస్తర్హి యుష్మాన్ ఉన్మత్తాన్ కిం న వదిష్యన్తి?</para>
  <para style="p">
    <verse number="24" style="v"/>కిన్తు సర్వ్వేష్వీశ్వరీయాదేశం ప్రకాశయత్సు యద్యవిశ్వాసీ జ్ఞానాకాఙ్క్షీ వా కశ్చిత్ తత్రాగచ్ఛతి తర్హి సర్వ్వైరేవ తస్య పాపజ్ఞానం పరీక్షా చ జాయతే,</para>
  <para style="p">
    <verse number="25" style="v"/>తతస్తస్యాన్తఃకరణస్య గుప్తకల్పనాసు వ్యక్తీభూతాసు సోఽధోముఖః పతన్ ఈశ్వరమారాధ్య యుష్మన్మధ్య ఈశ్వరో విద్యతే ఇతి సత్యం కథామేతాం కథయిష్యతి|</para>
  <para style="p">
    <verse number="26" style="v"/>హే భ్రాతరః, సమ్మిలితానాం యుష్మాకమ్ ఏకేన గీతమ్ అన్యేనోపదేశోఽన్యేన పరభాషాన్యేన ఐశ్వరికదర్శనమ్ అన్యేనార్థబోధకం వాక్యం లభ్యతే కిమేతత్? సర్వ్వమేవ పరనిష్ఠార్థం యుష్మాభిః క్రియతాం|</para>
  <para style="p">
    <verse number="27" style="v"/>యది కశ్చిద్ భాషాన్తరం వివక్షతి తర్హ్యేకస్మిన్ దినే ద్విజనేన త్రిజనేన వా పరభాाషా కథ్యతాం తదధికైర్న కథ్యతాం తైరపి పర్య్యాయానుసారాత్ కథ్యతాం, ఏకేన చ తదర్థో బోధ్యతాం|</para>
  <para style="p">
    <verse number="28" style="v"/>కిన్త్వర్థాభిధాయకః కోఽపి యది న విద్యతే తర్హి స సమితౌ వాచంయమః స్థిత్వేశ్వరాయాత్మనే చ కథాం కథయతు|</para>
  <para style="p">
    <verse number="29" style="v"/>అపరం ద్వౌ త్రయో వేశ్వరీయాదేశవక్తారః స్వం స్వమాదేశం కథయన్తు తదన్యే చ తం విచారయన్తు|</para>
  <para style="p">
    <verse number="30" style="v"/>కిన్తు తత్రాపరేణ కేనచిత్ జనేనేశ్వరీయాదేశే లబ్ధే ప్రథమేన కథనాత్ నివర్త్తితవ్యం|</para>
  <para style="p">
    <verse number="31" style="v"/>సర్వ్వే యత్ శిక్షాం సాన్త్వనాఞ్చ లభన్తే తదర్థం యూయం సర్వ్వే పర్య్యాయేణేశ్వరీయాదేశం కథయితుం శక్నుథ|</para>
  <para style="p">
    <verse number="32" style="v"/>ఈశ్వరీయాదేశవక్తృణాం మనాంసి తేషామ్ అధీనాని భవన్తి|</para>
  <para style="p">
    <verse number="33" style="v"/>యత ఈశ్వరః కుశాసనజనకో నహి సుశాసనజనక ఏవేతి పవిత్రలోకానాం సర్వ్వసమితిషు ప్రకాశతే|</para>
  <para style="p">
    <verse number="34" style="v"/>అపరఞ్చ యుష్మాకం వనితాః సమితిషు తూష్ణీమ్భూతాస్తిష్ఠన్తు యతః శాస్త్రలిఖితేన విధినా తాః కథాప్రచారణాత్ నివారితాస్తాభి ర్నిఘ్రాభి ర్భవితవ్యం|</para>
  <para style="p">
    <verse number="35" style="v"/>అతస్తా యది కిమపి జిజ్ఞాసన్తే తర్హి గేహేషు పతీన్ పృచ్ఛన్తు యతః సమితిమధ్యే యోషితాం కథాకథనం నిన్దనీయం|</para>
  <para style="p">
    <verse number="36" style="v"/>ఐశ్వరం వచః కిం యుష్మత్తో నిరగమత? కేవలం యుష్మాన్ వా తత్ కిమ్ ఉపాగతం?</para>
  <para style="p">
    <verse number="37" style="v"/>యః కశ్చిద్ ఆత్మానమ్ ఈశ్వరీయాదేశవక్తారమ్ ఆత్మనావిష్టం వా మన్యతే స యుష్మాన్ ప్రతి మయా యద్ యత్ లిఖ్యతే తత్ప్రభునాజ్ఞాపితమ్ ఈత్యురరీ కరోతు|</para>
  <para style="p">
    <verse number="38" style="v"/>కిన్తు యః కశ్చిత్ అజ్ఞో భవతి సోఽజ్ఞ ఏవ తిష్ఠతు|</para>
  <para style="p">
    <verse number="39" style="v"/>అతఏవ హే భ్రాతరః, యూయమ్ ఈశ్వరీయాదేశకథనసామర్థ్యం లబ్ధుం యతధ్వం పరభాషాభాషణమపి యుష్మాభి ర్న నివార్య్యతాం|</para>
  <para style="p">
    <verse number="40" style="v"/>సర్వ్వకర్మ్మాణి చ విధ్యనుసారతః సుపరిపాట్యా క్రియన్తాం|</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>హే భ్రాతరః, యః సుసంవాదో మయా యుష్మత్సమీపే నివేదితో యూయఞ్చ యం గృహీతవన్త ఆశ్రితవన్తశ్చ తం పున ర్యుష్మాన్ విజ్ఞాపయామి|</para>
  <para style="p">
    <verse number="2" style="v"/>యుష్మాకం విశ్వాసో యది వితథో న భవేత్ తర్హి సుసంవాదయుక్తాని మమ వాక్యాని స్మరతాం యుష్మాకం తేన సుసంవాదేన పరిత్రాణం జాయతే|</para>
  <para style="p">
    <verse number="3" style="v"/>యతోఽహం యద్ యత్ జ్ఞాపితస్తదనుసారాత్ యుష్మాసు ముఖ్యాం యాం శిక్షాం సమార్పయం సేయం, శాస్త్రానుసారాత్ ఖ్రీష్టోఽస్మాకం పాపమోచనార్థం ప్రాణాన్ త్యక్తవాన్,</para>
  <para style="p">
    <verse number="4" style="v"/>శ్మశానే స్థాపితశ్చ తృతీయదినే శాస్త్రానుసారాత్ పునరుత్థాపితః|</para>
  <para style="p">
    <verse number="5" style="v"/>స చాగ్రే కైఫై తతః పరం ద్వాదశశిష్యేభ్యో దర్శనం దత్తవాన్|</para>
  <para style="p">
    <verse number="6" style="v"/>తతః పరం పఞ్చశతాధికసంఖ్యకేభ్యో భ్రాతృభ్యో యుగపద్ దర్శనం దత్తవాన్ తేషాం కేచిత్ మహానిద్రాం గతా బహుతరాశ్చాద్యాపి వర్త్తన్తే|</para>
  <para style="p">
    <verse number="7" style="v"/>తదనన్తరం యాకూబాయ తత్పశ్చాత్ సర్వ్వేభ్యః ప్రేరితేభ్యో దర్శనం దత్తవాన్|</para>
  <para style="p">
    <verse number="8" style="v"/>సర్వ్వశేషేఽకాలజాతతుల్యో యోఽహం, సోఽహమపి తస్య దర్శనం ప్రాప్తవాన్|</para>
  <para style="p">
    <verse number="9" style="v"/>ఈశ్వరస్య సమితిం ప్రతి దౌరాత్మ్యాచరణాద్ అహం ప్రేరితనామ ధర్త్తుమ్ అయోగ్యస్తస్మాత్ ప్రేరితానాం మధ్యే క్షుద్రతమశ్చాస్మి|</para>
  <para style="p">
    <verse number="10" style="v"/>యాదృశోఽస్మి తాదృశ ఈశ్వరస్యానుగ్రహేణైవాస్మి; అపరం మాం ప్రతి తస్యానుగ్రహో నిష్ఫలో నాభవత్, అన్యేభ్యః సర్వ్వేభ్యో మయాధికః శ్రమః కృతః, కిన్తు స మయా కృతస్తన్నహి మత్సహకారిణేశ్వరస్యానుగ్రహేణైవ|</para>
  <para style="p">
    <verse number="11" style="v"/>అతఏవ మయా భవేత్ తై ర్వా భవేత్ అస్మాభిస్తాదృశీ వార్త్తా ఘోష్యతే సైవ చ యుష్మాభి ర్విశ్వాసేన గృహీతా|</para>
  <para style="p">
    <verse number="12" style="v"/>మృత్యుదశాతః ఖ్రీష్ట ఉత్థాపిత ఇతి వార్త్తా యది తమధి ఘోష్యతే తర్హి మృతలోకానామ్ ఉత్థితి ర్నాస్తీతి వాగ్ యుష్మాకం మధ్యే కైశ్చిత్ కుతః కథ్యతే?</para>
  <para style="p">
    <verse number="13" style="v"/>మృతానామ్ ఉత్థితి ర్యది న భవేత్ తర్హి ఖ్రీష్టోఽపి నోత్థాపితః</para>
  <para style="p">
    <verse number="14" style="v"/>ఖ్రీష్టశ్చ యద్యనుత్థాపితః స్యాత్ తర్హ్యస్మాకం ఘోషణం వితథం యుష్మాకం విశ్వాసోఽపి వితథః|</para>
  <para style="p">
    <verse number="15" style="v"/>వయఞ్చేశ్వరస్య మృషాసాక్షిణో భవామః, యతః ఖ్రీష్ట స్తేనోత్థాపితః ఇతి సాక్ష్యమ్ అస్మాభిరీశ్వరమధి దత్తం కిన్తు మృతానాముత్థితి ర్యది న భవేత్ తర్హి స తేన నోత్థాపితః|</para>
  <para style="p">
    <verse number="16" style="v"/>యతో మృతానాముత్థితి ర్యతి న భవేత్ తర్హి ఖ్రీష్టోఽప్యుత్థాపితత్వం న గతః|</para>
  <para style="p">
    <verse number="17" style="v"/>ఖ్రీష్టస్య యద్యనుత్థాపితః స్యాత్ తర్హి యుష్మాకం విశ్వాసో వితథః, యూయమ్ అద్యాపి స్వపాపేషు మగ్నాస్తిష్ఠథ|</para>
  <para style="p">
    <verse number="18" style="v"/>అపరం ఖ్రీష్టాశ్రితా యే మానవా మహానిద్రాం గతాస్తేఽపి నాశం గతాః|</para>
  <para style="p">
    <verse number="19" style="v"/>ఖ్రీష్టో యది కేవలమిహలోకే ఽస్మాకం ప్రత్యాశాభూమిః స్యాత్ తర్హి సర్వ్వమర్త్యేభ్యో వయమేవ దుర్భాగ్యాః|</para>
  <para style="p">
    <verse number="20" style="v"/>ఇదానీం ఖ్రీష్టో మృత్యుదశాత ఉత్థాపితో మహానిద్రాగతానాం మధ్యే ప్రథమఫలస్వరూపో జాతశ్చ|</para>
  <para style="p">
    <verse number="21" style="v"/>యతో యద్వత్ మానుషద్వారా మృత్యుః ప్రాదుర్భూతస్తద్వత్ మానుషద్వారా మృతానాం పునరుత్థితిరపి ప్రదుర్భూతా|</para>
  <para style="p">
    <verse number="22" style="v"/>ఆదమా యథా సర్వ్వే మరణాధీనా జాతాస్తథా ఖ్రీష్టేన సర్వ్వే జీవయిష్యన్తే|</para>
  <para style="p">
    <verse number="23" style="v"/>కిన్త్వేకైకేన జనేన నిజే నిజే పర్య్యాయ ఉత్థాతవ్యం ప్రథమతః ప్రథమజాతఫలస్వరూపేన ఖ్రీష్టేన, ద్వితీయతస్తస్యాగమనసమయే ఖ్రీష్టస్య లోకైః|</para>
  <para style="p">
    <verse number="24" style="v"/>తతః పరమ్ అన్తో భవిష్యతి తదానీం స సర్వ్వం శాసనమ్ అధిపతిత్వం పరాక్రమఞ్చ లుప్త్వా స్వపితరీశ్వరే రాజత్వం సమర్పయిష్యతి|</para>
  <para style="p">
    <verse number="25" style="v"/>యతః ఖ్రీష్టస్య రిపవః సర్వ్వే యావత్ తేన స్వపాదయోరధో న నిపాతయిష్యన్తే తావత్ తేనైవ రాజత్వం కర్త్తవ్యం|</para>
  <para style="p">
    <verse number="26" style="v"/>తేన విజేతవ్యో యః శేషరిపుః స మృత్యురేవ|</para>
  <para style="p">
    <verse number="27" style="v"/>లిఖితమాస్తే సర్వ్వాణి తస్య పాదయో ర్వశీకృతాని| కిన్తు సర్వ్వాణ్యేవ తస్య వశీకృతానీత్యుక్తే సతి సర్వ్వాణి యేన తస్య వశీకృతాని స స్వయం తస్య వశీభూతో న జాత ఇతి వ్యక్తం|</para>
  <para style="p">
    <verse number="28" style="v"/>సర్వ్వేషు తస్య వశీభూతేషు సర్వ్వాణి యేన పుత్రస్య వశీకృతాని స్వయం పుత్రోఽపి తస్య వశీభూతో భవిష్యతి తత ఈశ్వరః సర్వ్వేషు సర్వ్వ ఏవ భవిష్యతి|</para>
  <para style="p">
    <verse number="29" style="v"/>అపరం పరేతలోకానాం వినిమయేన యే మజ్జ్యన్తే తైః కిం లప్స్యతే? యేషాం పరేతలోకానామ్ ఉత్థితిః కేనాపి ప్రకారేణ న భవిష్యతి తేషాం వినిమయేన కుతో మజ్జనమపి తైరఙ్గీక్రియతే?</para>
  <para style="p">
    <verse number="30" style="v"/>వయమపి కుతః ప్రతిదణ్డం ప్రాణభీతిమ్ అఙ్గీకుర్మ్మహే?</para>
  <para style="p">
    <verse number="31" style="v"/>అస్మత్ప్రభునా యీశుఖ్రీష్టేన యుష్మత్తో మమ యా శ్లాఘాస్తే తస్యాః శపథం కృత్వా కథయామి దినే దినేఽహం మృత్యుం గచ్ఛామి|</para>
  <para style="p">
    <verse number="32" style="v"/>ఇఫిషనగరే వన్యపశుభిః సార్ద్ధం యది లౌకికభావాత్ మయా యుద్ధం కృతం తర్హి తేన మమ కో లాభః? మృతానామ్ ఉత్థితి ర్యది న భవేత్ తర్హి, కుర్మ్మో భోజనపానేఽద్య శ్వస్తు మృత్యు ర్భవిష్యతి|</para>
  <para style="p">
    <verse number="33" style="v"/>ఇత్యనేన ధర్మ్మాత్ మా భ్రంశధ్వం| కుసంసర్గేణ లోకానాం సదాచారో వినశ్యతి|</para>
  <para style="p">
    <verse number="34" style="v"/>యూయం యథోచితం సచైతన్యాస్తిష్ఠత, పాపం మా కురుధ్వం, యతో యుష్మాకం మధ్య ఈశ్వరీయజ్ఞానహీనాః కేఽపి విద్యన్తే యుష్మాకం త్రపాయై మయేదం గద్యతే|</para>
  <para style="p">
    <verse number="35" style="v"/>అపరం మృతలోకాః కథమ్ ఉత్థాస్యన్తి? కీదృశం వా శరీరం లబ్ధ్వా పునరేష్యన్తీతి వాక్యం కశ్చిత్ ప్రక్ష్యతి|</para>
  <para style="p">
    <verse number="36" style="v"/>హే అజ్ఞ త్వయా యద్ బీజమ్ ఉప్యతే తద్ యది న మ్రియేత తర్హి న జీవయిష్యతే|</para>
  <para style="p">
    <verse number="37" style="v"/>యయా మూర్త్త్యా నిర్గన్తవ్యం సా త్వయా నోప్యతే కిన్తు శుష్కం బీజమేవ; తచ్చ గోధూమాదీనాం కిమపి బీజం భవితుం శక్నోతి|</para>
  <para style="p">
    <verse number="38" style="v"/>ఈశ్వరేణేవ యథాభిలాషం తస్మై మూర్త్తి ర్దీయతే, ఏకైకస్మై బీజాయ స్వా స్వా మూర్త్తిరేవ దీయతే|</para>
  <para style="p">
    <verse number="39" style="v"/>సర్వ్వాణి పలలాని నైకవిధాని సన్తి, మనుష్యపశుపక్షిమత్స్యాదీనాం భిన్నరూపాణి పలలాని సన్తి|</para>
  <para style="p">
    <verse number="40" style="v"/>అపరం స్వర్గీయా మూర్త్తయః పార్థివా మూర్త్తయశ్చ విద్యన్తే కిన్తు స్వర్గీయానామ్ ఏకరూపం తేజః పార్థివానాఞ్చ తదన్యరూపం తేజోఽస్తి|</para>
  <para style="p">
    <verse number="41" style="v"/>సూర్య్యస్య తేజ ఏకవిధం చన్ద్రస్య తేజస్తదన్యవిధం తారాణాఞ్చ తేజోఽన్యవిధం, తారాణాం మధ్యేఽపి తేజసస్తారతమ్యం విద్యతే|</para>
  <para style="p">
    <verse number="42" style="v"/>తత్ర లిఖితమాస్తే యథా, ‘ఆదిపురుష ఆదమ్ జీవత్ప్రాణీ బభూవ,’ కిన్త్వన్తిమ ఆదమ్ (ఖ్రీష్టో) జీవనదాయక ఆత్మా బభూవ|</para>
  <para style="p">
    <verse number="43" style="v"/>యద్ ఉప్యతే తత్ తుచ్ఛం యచ్చోత్థాస్యతి తద్ గౌరవాన్వితం; యద్ ఉప్యతే తన్నిర్బ్బలం యచ్చోత్థాస్యతి తత్ శక్తియుక్తం|</para>
  <para style="p">
    <verse number="44" style="v"/>యత్ శరీరమ్ ఉప్యతే తత్ ప్రాణానాం సద్మ, యచ్చ శరీరమ్ ఉత్థాస్యతి తద్ ఆత్మనః సద్మ| ప్రాణసద్మస్వరూపం శరీరం విద్యతే, ఆత్మసద్మస్వరూపమపి శరీరం విద్యతే|</para>
  <para style="p">
    <verse number="45" style="v"/>తత్ర లిఖితమాస్తే యథా, ఆదిపురుష ఆదమ్ జీవత్ప్రాణీ బభూవ, కిన్త్వన్తిమ ఆదమ్ (ఖ్రీష్టో) జీవనదాయక ఆత్మా బభూవ|</para>
  <para style="p">
    <verse number="46" style="v"/>ఆత్మసద్మ న ప్రథమం కిన్తు ప్రాణసద్మైవ తత్పశ్చాద్ ఆత్మసద్మ|</para>
  <para style="p">
    <verse number="47" style="v"/>ఆద్యః పురుషే మృద ఉత్పన్నత్వాత్ మృణ్మయో ద్వితీయశ్చ పురుషః స్వర్గాద్ ఆగతః ప్రభుః|</para>
  <para style="p">
    <verse number="48" style="v"/>మృణ్మయో యాదృశ ఆసీత్ మృణ్మయాః సర్వ్వే తాదృశా భవన్తి స్వర్గీయశ్చ యాదృశోఽస్తి స్వర్గీయాః సర్వ్వే తాదృశా భవన్తి|</para>
  <para style="p">
    <verse number="49" style="v"/>మృణ్మయస్య రూపం యద్వద్ అస్మాభి ర్ధారితం తద్వత్ స్వర్గీయస్య రూపమపి ధారయిష్యతే|</para>
  <para style="p">
    <verse number="50" style="v"/>హే భ్రాతరః, యుష్మాన్ ప్రతి వ్యాహరామి, ఈశ్వరస్య రాజ్యే రక్తమాంసయోరధికారో భవితుం న శక్నోతి, అక్షయత్వే చ క్షయస్యాధికారో న భవిష్యతి|</para>
  <para style="p">
    <verse number="51" style="v"/>పశ్యతాహం యుష్మభ్యం నిగూఢాం కథాం నివేదయామి|</para>
  <para style="p">
    <verse number="52" style="v"/>సర్వ్వైరస్మాభి ర్మహానిద్రా న గమిష్యతే కిన్త్వన్తిమదినే తూర్య్యాం వాదితాయామ్ ఏకస్మిన్ విపలే నిమిషైకమధ్యే సర్వ్వై రూపాన్తరం గమిష్యతే, యతస్తూరీ వాదిష్యతే, మృతలోకాశ్చాక్షయీభూతా ఉత్థాస్యన్తి వయఞ్చ రూపాన్తరం గమిష్యామః|</para>
  <para style="p">
    <verse number="53" style="v"/>యతః క్షయణీయేనైతేన శరీరేణాక్షయత్వం పరిహితవ్యం, మరణాధీనేనైతేన దేహేన చామరత్వం పరిహితవ్యం|</para>
  <para style="p">
    <verse number="54" style="v"/>ఏతస్మిన్ క్షయణీయే శరీరే ఽక్షయత్వం గతే, ఏతస్మన్ మరణాధీనే దేహే చామరత్వం గతే శాస్త్రే లిఖితం వచనమిదం సేత్స్యతి, యథా, జయేన గ్రస్యతే మృత్యుః|</para>
  <para style="p">
    <verse number="55" style="v"/>మృత్యో తే కణ్టకం కుత్ర పరలోక జయః క్క తే||</para>
  <para style="p">
    <verse number="56" style="v"/>మృత్యోః కణ్టకం పాపమేవ పాపస్య చ బలం వ్యవస్థా|</para>
  <para style="p">
    <verse number="57" style="v"/>ఈశ్వరశ్చ ధన్యో భవతు యతః సోఽస్మాకం ప్రభునా యీశుఖ్రీష్టేనాస్మాన్ జయయుక్తాన్ విధాపయతి|</para>
  <para style="p">
    <verse number="58" style="v"/>అతో హే మమ ప్రియభ్రాతరః; యూయం సుస్థిరా నిశ్చలాశ్చ భవత ప్రభోః సేవాయాం యుష్మాకం పరిశ్రమో నిష్ఫలో న భవిష్యతీతి జ్ఞాత్వా ప్రభోః కార్య్యే సదా తత్పరా భవత|</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>పవిత్రలోకానాం కృతే యోఽర్థసంగ్రహస్తమధి గాలాతీయదేశస్య సమాజా మయా యద్ ఆదిష్టాస్తద్ యుష్మాభిరపి క్రియతాం|</para>
  <para style="p">
    <verse number="2" style="v"/>మమాగమనకాలే యద్ అర్థసంగ్రహో న భవేత్ తన్నిమిత్తం యుష్మాకమేకైకేన స్వసమ్పదానుసారాత్ సఞ్చయం కృత్వా సప్తాహస్య ప్రథమదివసే స్వసమీపే కిఞ్చిత్ నిక్షిప్యతాం|</para>
  <para style="p">
    <verse number="3" style="v"/>తతో మమాగమనసమయే యూయం యానేవ విశ్వాస్యా ఇతి వేదిష్యథ తేభ్యోఽహం పత్రాణి దత్త్వా యుష్మాకం తద్దానస్య యిరూశాలమం నయనార్థం తాన్ ప్రేషయిష్యామి|</para>
  <para style="p">
    <verse number="4" style="v"/>కిన్తు యది తత్ర మమాపి గమనమ్ ఉచితం భవేత్ తర్హి తే మయా సహ యాస్యన్తి|</para>
  <para style="p">
    <verse number="5" style="v"/>సామ్ప్రతం మాకిదనియాదేశమహం పర్య్యటామి తం పర్య్యట్య యుష్మత్సమీపమ్ ఆగమిష్యామి|</para>
  <para style="p">
    <verse number="6" style="v"/>అనన్తరం కిం జానామి యుష్మత్సన్నిధిమ్ అవస్థాస్యే శీతకాలమపి యాపయిష్యామి చ పశ్చాత్ మమ యత్ స్థానం గన్తవ్యం తత్రైవ యుష్మాభిరహం ప్రేరయితవ్యః|</para>
  <para style="p">
    <verse number="7" style="v"/>యతోఽహం యాత్రాకాలే క్షణమాత్రం యుష్మాన్ ద్రష్టుం నేచ్ఛామి కిన్తు ప్రభు ర్యద్యనుజానీయాత్ తర్హి కిఞ్చిద్ దీర్ఘకాలం యుష్మత్సమీపే ప్రవస్తుమ్ ఇచ్ఛామి|</para>
  <para style="p">
    <verse number="8" style="v"/>తథాపి నిస్తారోత్సవాత్ పరం పఞ్చాశత్తమదినం యావద్ ఇఫిషపుర్య్యాం స్థాస్యామి|</para>
  <para style="p">
    <verse number="9" style="v"/>యస్మాద్ అత్ర కార్య్యసాధనార్థం మమాన్తికే బృహద్ ద్వారం ముక్తం బహవో విపక్షా అపి విద్యన్తే|</para>
  <para style="p">
    <verse number="10" style="v"/>తిమథి ర్యది యుష్మాకం సమీపమ్ ఆగచ్ఛేత్ తర్హి యేన నిర్భయం యుష్మన్మధ్యే వర్త్తేత తత్ర యుష్మాభి ర్మనో నిధీయతాం యస్మాద్ అహం యాదృక్ సోఽపి తాదృక్ ప్రభోః కర్మ్మణే యతతే|</para>
  <para style="p">
    <verse number="11" style="v"/>కోఽపి తం ప్రత్యనాదరం న కరోతు కిన్తు స మమాన్తికం యద్ ఆగన్తుం శక్నుయాత్ తదర్థం యుష్మాభిః సకుశలం ప్రేష్యతాం| భ్రాతృభిః సార్ద్ధమహం తం ప్రతీక్షే|</para>
  <para style="p">
    <verse number="12" style="v"/>ఆపల్లుం భ్రాతరమధ్యహం నివేదయామి భ్రాతృభిః సాకం సోఽపి యద్ యుష్మాకం సమీపం వ్రజేత్ తదర్థం మయా స పునః పునర్యాచితః కిన్త్విదానీం గమనం సర్వ్వథా తస్మై నారోచత, ఇతఃపరం సుసమయం ప్రాప్య స గమిష్యతి|</para>
  <para style="p">
    <verse number="13" style="v"/>యూయం జాగృత విశ్వాసే సుస్థిరా భవత పౌరుషం ప్రకాశయత బలవన్తో భవత|</para>
  <para style="p">
    <verse number="14" style="v"/>యుష్మాభిః సర్వ్వాణి కర్మ్మాణి ప్రేమ్నా నిష్పాద్యన్తాం|</para>
  <para style="p">
    <verse number="15" style="v"/>హే భ్రాతరః, అహం యుష్మాన్ ఇదమ్ అభియాచే స్తిఫానస్య పరిజనా ఆఖాయాదేశస్య ప్రథమజాతఫలస్వరూపాః, పవిత్రలోకానాం పరిచర్య్యాయై చ త ఆత్మనో న్యవేదయన్ ఇతి యుష్మాభి ర్జ్ఞాయతే|</para>
  <para style="p">
    <verse number="16" style="v"/>అతో యూయమపి తాదృశలోకానామ్ అస్మత్సహాయానాం శ్రమకారిణాఞ్చ సర్వ్వేషాం వశ్యా భవత|</para>
  <para style="p">
    <verse number="17" style="v"/>స్తిఫానః ఫర్త్తూనాత ఆఖాయికశ్చ యద్ అత్రాగమన్ తేనాహమ్ ఆనన్దామి యతో యుష్మాభిర్యత్ న్యూనితం తత్ తైః సమ్పూరితం|</para>
  <para style="p">
    <verse number="18" style="v"/>తై ర్యుష్మాకం మమ చ మనాంస్యాప్యాయితాని| తస్మాత్ తాదృశా లోకా యుష్మాభిః సమ్మన్తవ్యాః|</para>
  <para style="p">
    <verse number="19" style="v"/>యుష్మభ్యమ్ ఆశియాదేశస్థసమాజానాం నమస్కృతిమ్ ఆక్కిలప్రిస్కిల్లయోస్తన్మణ్డపస్థసమితేశ్చ బహునమస్కృతిం ప్రజానీత|</para>
  <para style="p">
    <verse number="20" style="v"/>సర్వ్వే భ్రాతరో యుష్మాన్ నమస్కుర్వ్వన్తే| యూయం పవిత్రచుమ్బనేన మిథో నమత|</para>
  <para style="p">
    <verse number="21" style="v"/>పౌలోఽహం స్వకరలిఖితం నమస్కృతిం యుష్మాన్ వేదయే|</para>
  <para style="p">
    <verse number="22" style="v"/>యది కశ్చిద్ యీశుఖ్రీష్టే న ప్రీయతే తర్హి స శాపగ్రస్తో భవేత్ ప్రభురాయాతి|</para>
  <para style="p">
    <verse number="23" style="v"/>అస్మాకం ప్రభో ర్యీశుఖ్రీష్టస్యానుగ్రహో యుష్మాన్ ప్రతి భూయాత్|</para>
  <para style="p">
    <verse number="24" style="v"/>ఖ్రీష్టం యీశుమ్ ఆశ్రితాన్ యుష్మాన్ ప్రతి మమ ప్రేమ తిష్ఠతు| ఇతి||</para>
</usx>
