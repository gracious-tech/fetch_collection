<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="LUK" style="id">Sanskrit Bible (NT) in Telugu Script (సత్యవేదః।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Luke</para>
  <para style="toc1">లూకలిఖితః సుసంవాదః</para>
  <para style="toc2">లూకః</para>
  <para style="toc3">లూకః</para>
  <para style="mt1">లూకలిఖితః సుసంవాదః</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ప్రథమతో యే సాక్షిణో వాక్యప్రచారకాశ్చాసన్ తేఽస్మాకం మధ్యే యద్యత్ సప్రమాణం వాక్యమర్పయన్తి స్మ</para>
  <para style="p">
    <verse number="2" style="v"/>తదనుసారతోఽన్యేపి బహవస్తద్వృత్తాన్తం రచయితుం ప్రవృత్తాః|</para>
  <para style="p">
    <verse number="3" style="v"/>అతఏవ హే మహామహిమథియఫిల్ త్వం యా యాః కథా అశిక్ష్యథాస్తాసాం దృఢప్రమాణాని యథా ప్రాప్నోషి</para>
  <para style="p">
    <verse number="4" style="v"/>తదర్థం ప్రథమమారభ్య తాని సర్వ్వాణి జ్ఞాత్వాహమపి అనుక్రమాత్ సర్వ్వవృత్తాన్తాన్ తుభ్యం లేఖితుం మతిమకార్షమ్|</para>
  <para style="p">
    <verse number="5" style="v"/>యిహూదాదేశీయహేరోద్నామకే రాజత్వం కుర్వ్వతి అబీయయాజకస్య పర్య్యాయాధికారీ సిఖరియనామక ఏకో యాజకో హారోణవంశోద్భవా ఇలీశేవాఖ్యా</para>
  <para style="p">
    <verse number="6" style="v"/>తస్య జాయా ద్వావిమౌ నిర్దోషౌ ప్రభోః సర్వ్వాజ్ఞా వ్యవస్థాశ్చ సంమన్య ఈశ్వరదృష్టౌ ధార్మ్మికావాస్తామ్|</para>
  <para style="p">
    <verse number="7" style="v"/>తయోః సన్తాన ఏకోపి నాసీత్, యత ఇలీశేవా బన్ధ్యా తౌ ద్వావేవ వృద్ధావభవతామ్|</para>
  <para style="p">
    <verse number="8" style="v"/>యదా స్వపర్య్యానుక్రమేణ సిఖరియ ఈశ్వాస్య సమక్షం యాజకీయం కర్మ్మ కరోతి</para>
  <para style="p">
    <verse number="9" style="v"/>తదా యజ్ఞస్య దినపరిపాయ్యా పరమేశ్వరస్య మన్దిరే ప్రవేశకాలే ధూపజ్వాలనం కర్మ్మ తస్య కరణీయమాసీత్|</para>
  <para style="p">
    <verse number="10" style="v"/>తద్ధూపజ్వాలనకాలే లోకనివహే ప్రార్థనాం కర్తుం బహిస్తిష్ఠతి</para>
  <para style="p">
    <verse number="11" style="v"/>సతి సిఖరియో యస్యాం వేద్యాం ధూపం జ్వాలయతి తద్దక్షిణపార్శ్వే పరమేశ్వరస్య దూత ఏక ఉపస్థితో దర్శనం దదౌ|</para>
  <para style="p">
    <verse number="12" style="v"/>తం దృష్ట్వా సిఖరియ ఉద్వివిజే శశఙ్కే చ|</para>
  <para style="p">
    <verse number="13" style="v"/>తదా స దూతస్తం బభాషే హే సిఖరియ మా భైస్తవ ప్రార్థనా గ్రాహ్యా జాతా తవ భార్య్యా ఇలీశేవా పుత్రం ప్రసోష్యతే తస్య నామ యోेహన్ ఇతి కరిష్యసి|</para>
  <para style="p">
    <verse number="14" style="v"/>కిఞ్చ త్వం సానన్దః సహర్షశ్చ భవిష్యసి తస్య జన్మని బహవ ఆనన్దిష్యన్తి చ|</para>
  <para style="p">
    <verse number="15" style="v"/>యతో హేతోః స పరమేశ్వరస్య గోచరే మహాన్ భవిష్యతి తథా ద్రాక్షారసం సురాం వా కిమపి న పాస్యతి, అపరం జన్మారభ్య పవిత్రేణాత్మనా పరిపూర్ణః</para>
  <para style="p">
    <verse number="16" style="v"/>సన్ ఇస్రాయేల్వంశీయాన్ అనేకాన్ ప్రభోః పరమేశ్వరస్య మార్గమానేష్యతి|</para>
  <para style="p">
    <verse number="17" style="v"/>సన్తానాన్ ప్రతి పితృణాం మనాంసి ధర్మ్మజ్ఞానం ప్రత్యనాజ్ఞాగ్రాహిణశ్చ పరావర్త్తయితుం, ప్రభోః పరమేశ్వరస్య సేవార్థమ్ ఏకాం సజ్జితజాతిం విధాతుఞ్చ స ఏలియరూపాత్మశక్తిప్రాప్తస్తస్యాగ్రే గమిష్యతి|</para>
  <para style="p">
    <verse number="18" style="v"/>తదా సిఖరియో దూతమవాదీత్ కథమేతద్ వేత్స్యామి? యతోహం వృద్ధో మమ భార్య్యా చ వృద్ధా|</para>
  <para style="p">
    <verse number="19" style="v"/>తతో దూతః ప్రత్యువాచ పశ్యేశ్వరస్య సాక్షాద్వర్త్తీ జిబ్రాయేల్నామా దూతోహం త్వయా సహ కథాం గదితుం తుభ్యమిమాం శుభవార్త్తాం దాతుఞ్చ ప్రేషితః|</para>
  <para style="p">
    <verse number="20" style="v"/>కిన్తు మదీయం వాక్యం కాలే ఫలిష్యతి తత్ త్వయా న ప్రతీతమ్ అతః కారణాద్ యావదేవ తాని న సేత్స్యన్తి తావత్ త్వం వక్తుంమశక్తో మూకో భవ|</para>
  <para style="p">
    <verse number="21" style="v"/>తదానీం యే యే లోకాః సిఖరియమపైక్షన్త తే మధ్యేమన్దిరం తస్య బహువిలమ్బాద్ ఆశ్చర్య్యం మేనిరే|</para>
  <para style="p">
    <verse number="22" style="v"/>స బహిరాగతో యదా కిమపి వాక్యం వక్తుమశక్తః సఙ్కేతం కృత్వా నిఃశబ్దస్తస్యౌ తదా మధ్యేమన్దిరం కస్యచిద్ దర్శనం తేన ప్రాప్తమ్ ఇతి సర్వ్వే బుబుధిరే|</para>
  <para style="p">
    <verse number="23" style="v"/>అనన్తరం తస్య సేవనపర్య్యాయే సమ్పూర్ణే సతి స నిజగేహం జగామ|</para>
  <para style="p">
    <verse number="24" style="v"/>కతిపయదినేషు గతేషు తస్య భార్య్యా ఇలీశేవా గర్బ్భవతీ బభూవ</para>
  <para style="p">
    <verse number="25" style="v"/>పశ్చాత్ సా పఞ్చమాసాన్ సంగోప్యాకథయత్ లోకానాం సమక్షం మమాపమానం ఖణ్డయితుం పరమేశ్వరో మయి దృష్టిం పాతయిత్వా కర్మ్మేదృశం కృతవాన్|</para>
  <para style="p">
    <verse number="26" style="v"/>అపరఞ్చ తస్యా గర్బ్భస్య షష్ఠే మాసే జాతే గాలీల్ప్రదేశీయనాసరత్పురే</para>
  <para style="p">
    <verse number="27" style="v"/>దాయూదో వంశీయాయ యూషఫ్నామ్నే పురుషాయ యా మరియమ్నామకుమారీ వాగ్దత్తాసీత్ తస్యాః సమీపం జిబ్రాయేల్ దూత ఈశ్వరేణ ప్రహితః|</para>
  <para style="p">
    <verse number="28" style="v"/>స గత్వా జగాద హే ఈశ్వరానుగృహీతకన్యే తవ శుభం భూయాత్ ప్రభుః పరమేశ్వరస్తవ సహాయోస్తి నారీణాం మధ్యే త్వమేవ ధన్యా|</para>
  <para style="p">
    <verse number="29" style="v"/>తదానీం సా తం దృష్ట్వా తస్య వాక్యత ఉద్విజ్య కీదృశం భాషణమిదమ్ ఇతి మనసా చిన్తయామాస|</para>
  <para style="p">
    <verse number="30" style="v"/>తతో దూతోఽవదత్ హే మరియమ్ భయం మాకార్షీః, త్వయి పరమేశ్వరస్యానుగ్రహోస్తి|</para>
  <para style="p">
    <verse number="31" style="v"/>పశ్య త్వం గర్బ్భం ధృత్వా పుత్రం ప్రసోష్యసే తస్య నామ యీశురితి కరిష్యసి|</para>
  <para style="p">
    <verse number="32" style="v"/>స మహాన్ భవిష్యతి తథా సర్వ్వేభ్యః శ్రేష్ఠస్య పుత్ర ఇతి ఖ్యాస్యతి; అపరం ప్రభుః పరమేశ్వరస్తస్య పితుర్దాయూదః సింహాసనం తస్మై దాస్యతి;</para>
  <para style="p">
    <verse number="33" style="v"/>తథా స యాకూబో వంశోపరి సర్వ్వదా రాజత్వం కరిష్యతి, తస్య రాజత్వస్యాన్తో న భవిష్యతి|</para>
  <para style="p">
    <verse number="34" style="v"/>తదా మరియమ్ తం దూతం బభాషే నాహం పురుషసఙ్గం కరోమి తర్హి కథమేతత్ సమ్భవిష్యతి?</para>
  <para style="p">
    <verse number="35" style="v"/>తతో దూతోఽకథయత్ పవిత్ర ఆత్మా త్వామాశ్రాయిష్యతి తథా సర్వ్వశ్రేష్ఠస్య శక్తిస్తవోపరి ఛాయాం కరిష్యతి తతో హేతోస్తవ గర్బ్భాద్ యః పవిత్రబాలకో జనిష్యతే స ఈశ్వరపుత్ర ఇతి ఖ్యాతిం ప్రాప్స్యతి|</para>
  <para style="p">
    <verse number="36" style="v"/>అపరఞ్చ పశ్య తవ జ్ఞాతిరిలీశేవా యాం సర్వ్వే బన్ధ్యామవదన్ ఇదానీం సా వార్ద్ధక్యే సన్తానమేకం గర్బ్భేఽధారయత్ తస్య షష్ఠమాసోభూత్|</para>
  <para style="p">
    <verse number="37" style="v"/>కిమపి కర్మ్మ నాసాధ్యమ్ ఈశ్వరస్య|</para>
  <para style="p">
    <verse number="38" style="v"/>తదా మరియమ్ జగాద, పశ్య ప్రభేరహం దాసీ మహ్యం తవ వాక్యానుసారేణ సర్వ్వమేతద్ ఘటతామ్; అననతరం దూతస్తస్యాః సమీపాత్ ప్రతస్థే|</para>
  <para style="p">
    <verse number="39" style="v"/>అథ కతిపయదినాత్ పరం మరియమ్ తస్మాత్ పర్వ్వతమయప్రదేశీయయిహూదాయా నగరమేకం శీఘ్రం గత్వా</para>
  <para style="p">
    <verse number="40" style="v"/>సిఖరియయాజకస్య గృహం ప్రవిశ్య తస్య జాయామ్ ఇలీశేవాం సమ్బోధ్యావదత్|</para>
  <para style="p">
    <verse number="41" style="v"/>తతో మరియమః సమ్బోధనవాక్యే ఇలీశేవాయాః కర్ణయోః ప్రవిష్టమాత్రే సతి తస్యా గర్బ్భస్థబాలకో ననర్త్త| తత ఇలీశేవా పవిత్రేణాత్మనా పరిపూర్ణా సతీ</para>
  <para style="p">
    <verse number="42" style="v"/>ప్రోచ్చైర్గదితుమారేభే, యోషితాం మధ్యే త్వమేవ ధన్యా, తవ గర్బ్భస్థః శిశుశ్చ ధన్యః|</para>
  <para style="p">
    <verse number="43" style="v"/>త్వం ప్రభోర్మాతా, మమ నివేశనే త్వయా చరణావర్పితౌ, మమాద్య సౌభాగ్యమేతత్|</para>
  <para style="p">
    <verse number="44" style="v"/>పశ్య తవ వాక్యే మమ కర్ణయోః ప్రవిష్టమాత్రే సతి మమోదరస్థః శిశురానన్దాన్ ననర్త్త|</para>
  <para style="p">
    <verse number="45" style="v"/>యా స్త్రీ వ్యశ్వసీత్ సా ధన్యా, యతో హేతోస్తాం ప్రతి పరమేశ్వరోక్తం వాక్యం సర్వ్వం సిద్ధం భవిష్యతి|</para>
  <para style="p">
    <verse number="46" style="v"/>తదానీం మరియమ్ జగాద| ధన్యవాదం పరేశస్య కరోతి మామకం మనః|</para>
  <para style="p">
    <verse number="47" style="v"/>మమాత్మా తారకేశే చ సముల్లాసం ప్రగచ్ఛతి|</para>
  <para style="p">
    <verse number="48" style="v"/>అకరోత్ స ప్రభు ర్దుష్టిం స్వదాస్యా దుర్గతిం ప్రతి| పశ్యాద్యారభ్య మాం ధన్యాం వక్ష్యన్తి పురుషాః సదా|</para>
  <para style="p">
    <verse number="49" style="v"/>యః సర్వ్వశక్తిమాన్ యస్య నామాపి చ పవిత్రకం| స ఏవ సుమహత్కర్మ్మ కృతవాన్ మన్నిమిత్తకం|</para>
  <para style="p">
    <verse number="50" style="v"/>యే బిభ్యతి జనాస్తస్మాత్ తేషాం సన్తానపంక్తిషు| అనుకమ్పా తదీయా చ సర్వ్వదైవ సుతిష్ఠతి|</para>
  <para style="p">
    <verse number="51" style="v"/>స్వబాహుబలతస్తేన ప్రాకాశ్యత పరాక్రమః| మనఃకుమన్త్రణాసార్ద్ధం వికీర్య్యన్తేఽభిమానినః|</para>
  <para style="p">
    <verse number="52" style="v"/>సింహాసనగతాల్లోకాన్ బలినశ్చావరోహ్య సః| పదేషూచ్చేషు లోకాంస్తు క్షుద్రాన్ సంస్థాపయత్యపి|</para>
  <para style="p">
    <verse number="53" style="v"/>క్షుధితాన్ మానవాన్ ద్రవ్యైరుత్తమైః పరితర్ప్య సః| సకలాన్ ధనినో లోకాన్ విసృజేద్ రిక్తహస్తకాన్|</para>
  <para style="p">
    <verse number="54" style="v"/>ఇబ్రాహీమి చ తద్వంశే యా దయాస్తి సదైవ తాం| స్మృత్వా పురా పితృణాం నో యథా సాక్షాత్ ప్రతిశ్రుతం|</para>
  <para style="p">
    <verse number="55" style="v"/>ఇస్రాయేల్సేవకస్తేన తథోపక్రియతే స్వయం||</para>
  <para style="p">
    <verse number="56" style="v"/>అనన్తరం మరియమ్ ప్రాయేణ మాసత్రయమ్ ఇలీశేవయా సహోషిత్వా వ్యాఘుయ్య నిజనివేశనం యయౌ|</para>
  <para style="p">
    <verse number="57" style="v"/>తదనన్తరమ్ ఇలీశేవాయాః ప్రసవకాల ఉపస్థితే సతి సా పుత్రం ప్రాసోష్ట|</para>
  <para style="p">
    <verse number="58" style="v"/>తతః పరమేశ్వరస్తస్యాం మహానుగ్రహం కృతవాన్ ఏతత్ శ్రుత్వా సమీపవాసినః కుటుమ్బాశ్చాగత్య తయా సహ ముముదిరే|</para>
  <para style="p">
    <verse number="59" style="v"/>తథాష్టమే దినే తే బాలకస్య త్వచం ఛేత్తుమ్ ఏత్య తస్య పితృనామానురూపం తన్నామ సిఖరియ ఇతి కర్త్తుమీషుః|</para>
  <para style="p">
    <verse number="60" style="v"/>కిన్తు తస్య మాతాకథయత్ తన్న, నామాస్య యోహన్ ఇతి కర్త్తవ్యమ్|</para>
  <para style="p">
    <verse number="61" style="v"/>తదా తే వ్యాహరన్ తవ వంశమధ్యే నామేదృశం కస్యాపి నాస్తి|</para>
  <para style="p">
    <verse number="62" style="v"/>తతః పరం తస్య పితరం సిఖరియం ప్రతి సఙ్కేత్య పప్రచ్ఛుః శిశోః కిం నామ కారిష్యతే?</para>
  <para style="p">
    <verse number="63" style="v"/>తతః స ఫలకమేకం యాచిత్వా లిలేఖ తస్య నామ యోహన్ భవిష్యతి| తస్మాత్ సర్వ్వే ఆశ్చర్య్యం మేనిరే|</para>
  <para style="p">
    <verse number="64" style="v"/>తత్క్షణం సిఖరియస్య జిహ్వాజాడ్యేఽపగతే స ముఖం వ్యాదాయ స్పష్టవర్ణముచ్చార్య్య ఈశ్వరస్య గుణానువాదం చకార|</para>
  <para style="p">
    <verse number="65" style="v"/>తస్మాచ్చతుర్దిక్స్థాః సమీపవాసిలోకా భీతా ఏవమేతాః సర్వ్వాః కథా యిహూదాయాః పర్వ్వతమయప్రదేశస్య సర్వ్వత్ర ప్రచారితాః|</para>
  <para style="p">
    <verse number="66" style="v"/>తస్మాత్ శ్రోతారో మనఃసు స్థాపయిత్వా కథయామ్బభూవుః కీదృశోయం బాలో భవిష్యతి? అథ పరమేశ్వరస్తస్య సహాయోభూత్|</para>
  <para style="p">
    <verse number="67" style="v"/>తదా యోహనః పితా సిఖరియః పవిత్రేణాత్మనా పరిపూర్ణః సన్ ఏతాదృశం భవిష్యద్వాక్యం కథయామాస|</para>
  <para style="p">
    <verse number="68" style="v"/>ఇస్రాయేలః ప్రభు ర్యస్తు స ధన్యః పరమేశ్వరః| అనుగృహ్య నిజాల్లోకాన్ స ఏవ పరిమోచయేత్|</para>
  <para style="p">
    <verse number="69" style="v"/>విపక్షజనహస్తేభ్యో యథా మోచ్యామహే వయం| యావజ్జీవఞ్చ ధర్మ్మేణ సారల్యేన చ నిర్భయాః|</para>
  <para style="p">
    <verse number="70" style="v"/>సేవామహై తమేవైకమ్ ఏతత్కారణమేవ చ| స్వకీయం సుపవిత్రఞ్చ సంస్మృత్య నియమం సదా|</para>
  <para style="p">
    <verse number="71" style="v"/>కృపయా పురుషాన్ పూర్వ్వాన్ నికషార్థాత్తు నః పితుః| ఇబ్రాహీమః సమీపే యం శపథం కృతవాన్ పురా|</para>
  <para style="p">
    <verse number="72" style="v"/>తమేవ సఫలం కర్త్తం తథా శత్రుగణస్య చ| ఋृతీయాకారిణశ్చైవ కరేభ్యో రక్షణాయ నః|</para>
  <para style="p">
    <verse number="73" style="v"/>సృష్టేః ప్రథమతః స్వీయైః పవిత్రై ర్భావివాదిభిః|</para>
  <para style="p">
    <verse number="74" style="v"/>యథోక్తవాన్ తథా స్వస్య దాయూదః సేవకస్య తు|</para>
  <para style="p">
    <verse number="75" style="v"/>వంశే త్రాతారమేకం స సముత్పాదితవాన్ స్వయమ్|</para>
  <para style="p">
    <verse number="76" style="v"/>అతో హే బాలక త్వన్తు సర్వ్వేభ్యః శ్రేష్ఠ ఏవ యః| తస్యైవ భావివాదీతి ప్రవిఖ్యాతో భవిష్యసి| అస్మాకం చరణాన్ క్షేమే మార్గే చాలయితుం సదా| ఏవం ధ్వాన్తేఽర్థతో మృత్యోశ్ఛాయాయాం యే తు మానవాః|</para>
  <para style="p">
    <verse number="77" style="v"/>ఉపవిష్టాస్తు తానేవ ప్రకాశయితుమేవ హి| కృత్వా మహానుకమ్పాం హి యామేవ పరమేశ్వరః|</para>
  <para style="p">
    <verse number="78" style="v"/>ఊర్ద్వ్వాత్ సూర్య్యముదాయ్యైవాస్మభ్యం ప్రాదాత్తు దర్శనం| తయానుకమ్పయా స్వస్య లోకానాం పాపమోచనే|</para>
  <para style="p">
    <verse number="79" style="v"/>పరిత్రాణస్య తేభ్యో హి జ్ఞానవిశ్రాణనాయ చ| ప్రభో ర్మార్గం పరిష్కర్త్తుం తస్యాగ్రాయీ భవిష్యసి||</para>
  <para style="p">
    <verse number="80" style="v"/>అథ బాలకః శరీరేణ బుద్ధ్యా చ వర్ద్ధితుమారేభే; అపరఞ్చ స ఇస్రాయేలో వంశీయలోకానాం సమీపే యావన్న ప్రకటీభూతస్తాస్తావత్ ప్రాన్తరే న్యవసత్|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అపరఞ్చ తస్మిన్ కాలే రాజ్యస్య సర్వ్వేషాం లోకానాం నామాని లేఖయితుమ్ అగస్తకైసర ఆజ్ఞాపయామాస|</para>
  <para style="p">
    <verse number="2" style="v"/>తదనుసారేణ కురీణియనామని సురియాదేశస్య శాసకే సతి నామలేఖనం ప్రారేభే|</para>
  <para style="p">
    <verse number="3" style="v"/>అతో హేతో ర్నామ లేఖితుం సర్వ్వే జనాః స్వీయం స్వీయం నగరం జగ్ముః|</para>
  <para style="p">
    <verse number="4" style="v"/>తదానీం యూషఫ్ నామ లేఖితుం వాగ్దత్తయా స్వభార్య్యయా గర్బ్భవత్యా మరియమా సహ స్వయం దాయూదః సజాతివంశ ఇతి కారణాద్ గాలీల్ప్రదేశస్య నాసరత్నగరాద్</para>
  <para style="p">
    <verse number="5" style="v"/>యిహూదాప్రదేశస్య బైత్లేహమాఖ్యం దాయూద్నగరం జగామ|</para>
  <para style="p">
    <verse number="6" style="v"/>అన్యచ్చ తత్ర స్థానే తయోస్తిష్ఠతోః సతో ర్మరియమః ప్రసూతికాల ఉపస్థితే</para>
  <para style="p">
    <verse number="7" style="v"/>సా తం ప్రథమసుతం ప్రాసోష్ట కిన్తు తస్మిన్ వాసగృహే స్థానాభావాద్ బాలకం వస్త్రేణ వేష్టయిత్వా గోశాలాయాం స్థాపయామాస|</para>
  <para style="p">
    <verse number="8" style="v"/>అనన్తరం యే కియన్తో మేషపాలకాః స్వమేషవ్రజరక్షాయై తత్ప్రదేశే స్థిత్వా రజన్యాం ప్రాన్తరే ప్రహరిణః కర్మ్మ కుర్వ్వన్తి,</para>
  <para style="p">
    <verse number="9" style="v"/>తేషాం సమీపం పరమేశ్వరస్య దూత ఆగత్యోపతస్థౌ; తదా చతుష్పార్శ్వే పరమేశ్వరస్య తేజసః ప్రకాశితత్వాత్ తేఽతిశశఙ్కిరే|</para>
  <para style="p">
    <verse number="10" style="v"/>తదా స దూత ఉవాచ మా భైష్ట పశ్యతాద్య దాయూదః పురే యుష్మన్నిమిత్తం త్రాతా ప్రభుః ఖ్రీష్టోఽజనిష్ట,</para>
  <para style="p">
    <verse number="11" style="v"/>సర్వ్వేషాం లోకానాం మహానన్దజనకమ్ ఇమం మఙ్గలవృత్తాన్తం యుష్మాన్ జ్ఞాపయామి|</para>
  <para style="p">
    <verse number="12" style="v"/>యూయం (తత్స్థానం గత్వా) వస్త్రవేష్టితం తం బాలకం గోశాలాయాం శయనం ద్రక్ష్యథ యుష్మాన్ ప్రతీదం చిహ్నం భవిష్యతి|</para>
  <para style="p">
    <verse number="13" style="v"/>దూత ఇమాం కథాం కథితవతి తత్రాకస్మాత్ స్వర్గీయాః పృతనా ఆగత్య కథామ్ ఇమాం కథయిత్వేశ్వరస్య గుణానన్వవాదిషుః, యథా,</para>
  <para style="p">
    <verse number="14" style="v"/>సర్వ్వోర్ద్వ్వస్థైరీశ్వరస్య మహిమా సమ్ప్రకాశ్యతాం| శాన్తిర్భూయాత్ పృథివ్యాస్తు సన్తోషశ్చ నరాన్ ప్రతి||</para>
  <para style="p">
    <verse number="15" style="v"/>తతః పరం తేషాం సన్నిధే ర్దూతగణే స్వర్గం గతే మేషపాలకాః పరస్పరమ్ అవేచన్ ఆగచ్ఛత ప్రభుః పరమేశ్వరో యాం ఘటనాం జ్ఞాపితవాన్ తస్యా యాథర్యం జ్ఞాతుం వయమధునా బైత్లేహమ్పురం యామః|</para>
  <para style="p">
    <verse number="16" style="v"/>పశ్చాత్ తే తూర్ణం వ్రజిత్వా మరియమం యూషఫం గోశాలాయాం శయనం బాలకఞ్చ దదృశుః|</para>
  <para style="p">
    <verse number="17" style="v"/>ఇత్థం దృష్ట్వా బాలకస్యార్థే ప్రోక్తాం సర్వ్వకథాం తే ప్రాచారయాఞ్చక్రుః|</para>
  <para style="p">
    <verse number="18" style="v"/>తతో యే లోకా మేషరక్షకాణాం వదనేభ్యస్తాం వార్త్తాం శుశ్రువుస్తే మహాశ్చర్య్యం మేనిరే|</para>
  <para style="p">
    <verse number="19" style="v"/>కిన్తు మరియమ్ ఏతత్సర్వ్వఘటనానాం తాత్పర్య్యం వివిచ్య మనసి స్థాపయామాస|</para>
  <para style="p">
    <verse number="20" style="v"/>తత్పశ్చాద్ దూతవిజ్ఞప్తానురూపం శ్రుత్వా దృష్ట్వా చ మేషపాలకా ఈశ్వరస్య గుణానువాదం ధన్యవాదఞ్చ కుర్వ్వాణాః పరావృత్య యయుః|</para>
  <para style="p">
    <verse number="21" style="v"/>అథ బాలకస్య త్వక్ఛేదనకాలేఽష్టమదివసే సముపస్థితే తస్య గర్బ్భస్థితేః పుర్వ్వం స్వర్గీయదూతో యథాజ్ఞాపయత్ తదనురూపం తే తన్నామధేయం యీశురితి చక్రిరే|</para>
  <para style="p">
    <verse number="22" style="v"/>తతః పరం మూసాలిఖితవ్యవస్థాయా అనుసారేణ మరియమః శుచిత్వకాల ఉపస్థితే,</para>
  <para style="p">
    <verse number="23" style="v"/>"ప్రథమజః సర్వ్వః పురుషసన్తానః పరమేశ్వరే సమర్ప్యతాం," ఇతి పరమేశ్వరస్య వ్యవస్థయా</para>
  <para style="p">
    <verse number="24" style="v"/>యీశుం పరమేశ్వరే సమర్పయితుమ్ శాస్త్రీయవిధ్యుక్తం కపోతద్వయం పారావతశావకద్వయం వా బలిం దాతుం తే తం గృహీత్వా యిరూశాలమమ్ ఆయయుః|</para>
  <para style="p">
    <verse number="25" style="v"/>యిరూశాలమ్పురనివాసీ శిమియోన్నామా ధార్మ్మిక ఏక ఆసీత్ స ఇస్రాయేలః సాన్త్వనామపేక్ష్య తస్థౌ కిఞ్చ పవిత్ర ఆత్మా తస్మిన్నావిర్భూతః|</para>
  <para style="p">
    <verse number="26" style="v"/>అపరం ప్రభుణా పరమేశ్వరేణాభిషిక్తే త్రాతరి త్వయా న దృష్టే త్వం న మరిష్యసీతి వాక్యం పవిత్రేణ ఆత్మనా తస్మ ప్రాకథ్యత|</para>
  <para style="p">
    <verse number="27" style="v"/>అపరఞ్చ యదా యీశోః పితా మాతా చ తదర్థం వ్యవస్థానురూపం కర్మ్మ కర్త్తుం తం మన్దిరమ్ ఆనిన్యతుస్తదా</para>
  <para style="p">
    <verse number="28" style="v"/>శిమియోన్ ఆత్మన ఆకర్షణేన మన్దిరమాగత్య తం క్రోడే నిధాయ ఈశ్వరస్య ధన్యవాదం కృత్వా కథయామాస, యథా,</para>
  <para style="p">
    <verse number="29" style="v"/>హే ప్రభో తవ దాసోయం నిజవాక్యానుసారతః| ఇదానీన్తు సకల్యాణో భవతా సంవిసృజ్యతామ్|</para>
  <para style="p">
    <verse number="30" style="v"/>యతః సకలదేశస్య దీప్తయే దీప్తిరూపకం|</para>
  <para style="p">
    <verse number="31" style="v"/>ఇస్రాయేలీయలోకస్య మహాగౌరవరూపకం|</para>
  <para style="p">
    <verse number="32" style="v"/>యం త్రాయకం జనానాన్తు సమ్ముఖే త్వమజీజనః| సఏవ విద్యతేఽస్మాకం ధ్రవం నయననగోచరే||</para>
  <para style="p">
    <verse number="33" style="v"/>తదానీం తేనోక్తా ఏతాః సకలాః కథాః శ్రుత్వా తస్య మాతా యూషఫ్ చ విస్మయం మేనాతే|</para>
  <para style="p">
    <verse number="34" style="v"/>తతః పరం శిమియోన్ తేభ్య ఆశిషం దత్త్వా తన్మాతరం మరియమమ్ ఉవాచ, పశ్య ఇస్రాయేలో వంశమధ్యే బహూనాం పాతనాయోత్థాపనాయ చ తథా విరోధపాత్రం భవితుం, బహూనాం గుప్తమనోగతానాం ప్రకటీకరణాయ బాలకోయం నియుక్తోస్తి|</para>
  <para style="p">
    <verse number="35" style="v"/>తస్మాత్ తవాపి ప్రాణాః శూలేన వ్యత్స్యన్తే|</para>
  <para style="p">
    <verse number="36" style="v"/>అపరఞ్చ ఆశేరస్య వంశీయఫినూయేలో దుహితా హన్నాఖ్యా అతిజరతీ భవిష్యద్వాదిన్యేకా యా వివాహాత్ పరం సప్త వత్సరాన్ పత్యా సహ న్యవసత్ తతో విధవా భూత్వా చతురశీతివర్షవయఃపర్య్యనతం</para>
  <para style="p">
    <verse number="37" style="v"/>మన్దిరే స్థిత్వా ప్రార్థనోపవాసైర్దివానిశమ్ ఈశ్వరమ్ అసేవత సాపి స్త్రీ తస్మిన్ సమయే మన్దిరమాగత్య</para>
  <para style="p">
    <verse number="38" style="v"/>పరమేశ్వరస్య ధన్యవాదం చకార, యిరూశాలమ్పురవాసినో యావన్తో లోకా ముక్తిమపేక్ష్య స్థితాస్తాన్ యీశోర్వృత్తాన్తం జ్ఞాపయామాస|</para>
  <para style="p">
    <verse number="39" style="v"/>ఇత్థం పరమేశ్వరస్య వ్యవస్థానుసారేణ సర్వ్వేషు కర్మ్మసు కృతేషు తౌ పునశ్చ గాలీలో నాసరత్నామకం నిజనగరం ప్రతస్థాతే|</para>
  <para style="p">
    <verse number="40" style="v"/>తత్పశ్చాద్ బాలకః శరీరేణ వృద్ధిమేత్య జ్ఞానేన పరిపూర్ణ ఆత్మనా శక్తిమాంశ్చ భవితుమారేభే తథా తస్మిన్ ఈశ్వరానుగ్రహో బభూవ|</para>
  <para style="p">
    <verse number="41" style="v"/>తస్య పితా మాతా చ ప్రతివర్షం నిస్తారోత్సవసమయే యిరూశాలమమ్ అగచ్ఛతామ్|</para>
  <para style="p">
    <verse number="42" style="v"/>అపరఞ్చ యీశౌ ద్వాదశవర్షవయస్కే సతి తౌ పర్వ్వసమయస్య రీత్యనుసారేణ యిరూశాలమం గత్వా</para>
  <para style="p">
    <verse number="43" style="v"/>పార్వ్వణం సమ్పాద్య పునరపి వ్యాఘుయ్య యాతః కిన్తు యీశుర్బాలకో యిరూశాలమి తిష్ఠతి| యూషఫ్ తన్మాతా చ తద్ అవిదిత్వా</para>
  <para style="p">
    <verse number="44" style="v"/>స సఙ్గిభిః సహ విద్యత ఏతచ్చ బుద్వ్వా దినైకగమ్యమార్గం జగ్మతుః| కిన్తు శేషే జ్ఞాతిబన్ధూనాం సమీపే మృగయిత్వా తదుద్దేेశమప్రాప్య</para>
  <para style="p">
    <verse number="45" style="v"/>తౌ పునరపి యిరూశాలమమ్ పరావృత్యాగత్య తం మృగయాఞ్చక్రతుః|</para>
  <para style="p">
    <verse number="46" style="v"/>అథ దినత్రయాత్ పరం పణ్డితానాం మధ్యే తేషాం కథాః శృణ్వన్ తత్త్వం పృచ్ఛంశ్చ మన్దిరే సముపవిష్టః స తాభ్యాం దృష్టః|</para>
  <para style="p">
    <verse number="47" style="v"/>తదా తస్య బుద్ధ్యా ప్రత్యుత్తరైశ్చ సర్వ్వే శ్రోతారో విస్మయమాపద్యన్తే|</para>
  <para style="p">
    <verse number="48" style="v"/>తాదృశం దృష్ట్వా తస్య జనకో జననీ చ చమచ్చక్రతుః కిఞ్చ తస్య మాతా తమవదత్, హే పుత్ర, కథమావాం ప్రతీత్థం సమాచరస్త్వమ్? పశ్య తవ పితాహఞ్చ శోకాకులౌ సన్తౌ త్వామన్విచ్ఛావః స్మ|</para>
  <para style="p">
    <verse number="49" style="v"/>తతః సోవదత్ కుతో మామ్ అన్వైచ్ఛతం? పితుర్గృహే మయా స్థాతవ్యమ్ ఏతత్ కిం యువాభ్యాం న జ్ఞాయతే?</para>
  <para style="p">
    <verse number="50" style="v"/>కిన్తు తౌ తస్యైతద్వాక్యస్య తాత్పర్య్యం బోద్ధుం నాశక్నుతాం|</para>
  <para style="p">
    <verse number="51" style="v"/>తతః పరం స తాభ్యాం సహ నాసరతం గత్వా తయోర్వశీభూతస్తస్థౌ కిన్తు సర్వ్వా ఏతాః కథాస్తస్య మాతా మనసి స్థాపయామాస|</para>
  <para style="p">
    <verse number="52" style="v"/>అథ యీశో ర్బుద్ధిః శరీరఞ్చ తథా తస్మిన్ ఈశ్వరస్య మానవానాఞ్చానుగ్రహో వర్ద్ధితుమ్ ఆరేభే|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అనన్తరం తిబిరియకైసరస్య రాజత్వస్య పఞ్చదశే వత్సరే సతి యదా పన్తీయపీలాతో యిహూదాదేశాధిపతి ర్హేరోద్ తు గాలీల్ప్రదేశస్య రాజా ఫిలిపనామా తస్య భ్రాతా తు యితూరియాయాస్త్రాఖోనీతియాప్రదేశస్య చ రాజాసీత్ లుషానీయనామా అవిలీనీదేశస్య రాజాసీత్</para>
  <para style="p">
    <verse number="2" style="v"/>హానన్ కియఫాశ్చేమౌ ప్రధానయాజాకావాస్తాం తదానీం సిఖరియస్య పుత్రాయ యోహనే మధ్యేప్రాన్తరమ్ ఈశ్వరస్య వాక్యే ప్రకాశితే సతి</para>
  <para style="p">
    <verse number="3" style="v"/>స యర్ద్దన ఉభయతటప్రదేశాన్ సమేత్య పాపమోచనార్థం మనఃపరావర్త్తనస్య చిహ్నరూపం యన్మజ్జనం తదీయాః కథాః సర్వ్వత్ర ప్రచారయితుమారేభే|</para>
  <para style="p">
    <verse number="4" style="v"/>యిశయియభవిష్యద్వక్తృగ్రన్థే యాదృశీ లిపిరాస్తే యథా, పరమేశస్య పన్థానం పరిష్కురుత సర్వ్వతః| తస్య రాజపథఞ్చైవ సమానం కురుతాధునా|</para>
  <para style="p">
    <verse number="5" style="v"/>కారిష్యన్తే సముచ్ఛ్రాయాః సకలా నిమ్నభూమయః| కారిష్యన్తే నతాః సర్వ్వే పర్వ్వతాశ్చోపపర్వ్వతాః| కారిష్యన్తే చ యా వక్రాస్తాః సర్వ్వాః సరలా భువః| కారిష్యన్తే సమానాస్తా యా ఉచ్చనీచభూమయః|</para>
  <para style="p">
    <verse number="6" style="v"/>ఈశ్వరేణ కృతం త్రాణం ద్రక్ష్యన్తి సర్వ్వమానవాః| ఇత్యేతత్ ప్రాన్తరే వాక్యం వదతః కస్యచిద్ రవః||</para>
  <para style="p">
    <verse number="7" style="v"/>యే యే లోకా మజ్జనార్థం బహిరాయయుస్తాన్ సోవదత్ రే రే సర్పవంశా ఆగామినః కోపాత్ పలాయితుం యుష్మాన్ కశ్చేతయామాస?</para>
  <para style="p">
    <verse number="8" style="v"/>తస్మాద్ ఇబ్రాహీమ్ అస్మాకం పితా కథామీదృశీం మనోభి ర్న కథయిత్వా యూయం మనఃపరివర్త్తనయోగ్యం ఫలం ఫలత; యుష్మానహం యథార్థం వదామి పాషాణేభ్య ఏతేభ్య ఈశ్వర ఇబ్రాహీమః సన్తానోత్పాదనే సమర్థః|</para>
  <para style="p">
    <verse number="9" style="v"/>అపరఞ్చ తరుమూలేఽధునాపి పరశుః సంలగ్నోస్తి యస్తరురుత్తమం ఫలం న ఫలతి స ఛిద్యతేఽగ్నౌ నిక్షిప్యతే చ|</para>
  <para style="p">
    <verse number="10" style="v"/>తదానీం లోకాస్తం పప్రచ్ఛుస్తర్హి కిం కర్త్తవ్యమస్మాభిః?</para>
  <para style="p">
    <verse number="11" style="v"/>తతః సోవాదీత్ యస్య ద్వే వసనే విద్యేతే స వస్త్రహీనాయైకం వితరతు కింఞ్చ యస్య ఖాద్యద్రవ్యం విద్యతే సోపి తథైవ కరోతు|</para>
  <para style="p">
    <verse number="12" style="v"/>తతః పరం కరసఞ్చాయినో మజ్జనార్థమ్ ఆగత్య పప్రచ్ఛుః హే గురో కిం కర్త్తవ్యమస్మాభిః?</para>
  <para style="p">
    <verse number="13" style="v"/>తతః సోకథయత్ నిరూపితాదధికం న గృహ్లిత|</para>
  <para style="p">
    <verse number="14" style="v"/>అనన్తరం సేనాగణ ఏత్య పప్రచ్ఛ కిమస్మాభి ర్వా కర్త్తవ్యమ్? తతః సోభిదధే కస్య కామపి హానిం మా కార్ష్ట తథా మృషాపవాదం మా కురుత నిజవేతనేన చ సన్తుష్య తిష్ఠత|</para>
  <para style="p">
    <verse number="15" style="v"/>అపరఞ్చ లోకా అపేక్షయా స్థిత్వా సర్వ్వేపీతి మనోభి ర్వితర్కయాఞ్చక్రుః, యోహనయమ్ అభిషిక్తస్త్రాతా న వేతి?</para>
  <para style="p">
    <verse number="16" style="v"/>తదా యోహన్ సర్వ్వాన్ వ్యాజహార, జలేఽహం యుష్మాన్ మజ్జయామి సత్యం కిన్తు యస్య పాదుకాబన్ధనం మోచయితుమపి న యోగ్యోస్మి తాదృశ ఏకో మత్తో గురుతరః పుమాన్ ఏతి, స యుష్మాన్ వహ్నిరూపే పవిత్ర ఆత్మని మజ్జయిష్యతి|</para>
  <para style="p">
    <verse number="17" style="v"/>అపరఞ్చ తస్య హస్తే శూర్ప ఆస్తే స స్వశస్యాని శుద్ధరూపం ప్రస్ఫోట్య గోధూమాన్ సర్వ్వాన్ భాణ్డాగారే సంగ్రహీష్యతి కిన్తు బూషాణి సర్వ్వాణ్యనిర్వ్వాణవహ్నినా దాహయిష్యతి|</para>
  <para style="p">
    <verse number="18" style="v"/>యోహన్ ఉపదేశేనేత్థం నానాకథా లోకానాం సమక్షం ప్రచారయామాస|</para>
  <para style="p">
    <verse number="19" style="v"/>అపరఞ్చ హేరోద్ రాజా ఫిలిప్నామ్నః సహోదరస్య భార్య్యాం హేరోదియామధి తథాన్యాని యాని యాని కుకర్మ్మాణి కృతవాన్ తదధి చ</para>
  <para style="p">
    <verse number="20" style="v"/>యోహనా తిరస్కృతో భూత్వా కారాగారే తస్య బన్ధనాద్ అపరమపి కుకర్మ్మ చకార|</para>
  <para style="p">
    <verse number="21" style="v"/>ఇతః పూర్వ్వం యస్మిన్ సమయే సర్వ్వే యోహనా మజ్జితాస్తదానీం యీశురప్యాగత్య మజ్జితః|</para>
  <para style="p">
    <verse number="22" style="v"/>తదనన్తరం తేన ప్రార్థితే మేఘద్వారం ముక్తం తస్మాచ్చ పవిత్ర ఆత్మా మూర్త్తిమాన్ భూత్వా కపోతవత్ తదుపర్య్యవరురోహ; తదా త్వం మమ ప్రియః పుత్రస్త్వయి మమ పరమః సన్తోష ఇత్యాకాశవాణీ బభూవ|</para>
  <para style="p">
    <verse number="23" style="v"/>తదానీం యీశుః ప్రాయేణ త్రింశద్వర్షవయస్క ఆసీత్| లౌకికజ్ఞానే తు స యూషఫః పుత్రః,</para>
  <para style="p">
    <verse number="24" style="v"/>యూషఫ్ ఏలేః పుత్రః, ఏలిర్మత్తతః పుత్రః, మత్తత్ లేవేః పుత్రః, లేవి ర్మల్కేః పుత్రః, మల్కిర్యాన్నస్య పుత్రః; యాన్నో యూషఫః పుత్రః|</para>
  <para style="p">
    <verse number="25" style="v"/>యూషఫ్ మత్తథియస్య పుత్రః, మత్తథియ ఆమోసః పుత్రః, ఆమోస్ నహూమః పుత్రః, నహూమ్ ఇష్లేః పుత్రః ఇష్లిర్నగేః పుత్రః|</para>
  <para style="p">
    <verse number="26" style="v"/>నగిర్మాటః పుత్రః, మాట్ మత్తథియస్య పుత్రః, మత్తథియః శిమియేః పుత్రః, శిమియిర్యూషఫః పుత్రః, యూషఫ్ యిహూదాః పుత్రః|</para>
  <para style="p">
    <verse number="27" style="v"/>యిహూదా యోహానాః పుత్రః, యోహానా రీషాః పుత్రః, రీషాః సిరుబ్బాబిలః పుత్రః, సిరుబ్బాబిల్ శల్తీయేలః పుత్రః, శల్తీయేల్ నేరేః పుత్రః|</para>
  <para style="p">
    <verse number="28" style="v"/>నేరిర్మల్కేః పుత్రః, మల్కిః అద్యః పుత్రః, అద్దీ కోషమః పుత్రః, కోషమ్ ఇల్మోదదః పుత్రః, ఇల్మోదద్ ఏరః పుత్రః|</para>
  <para style="p">
    <verse number="29" style="v"/>ఏర్ యోశేః పుత్రః, యోశిః ఇలీయేషరః పుత్రః, ఇలీయేషర్ యోరీమః పుత్రః, యోరీమ్ మత్తతః పుత్రః, మత్తత లేవేః పుత్రః|</para>
  <para style="p">
    <verse number="30" style="v"/>లేవిః శిమియోనః పుత్రః, శిమియోన్ యిహూదాః పుత్రః, యిహూదా యూషుఫః పుత్రః, యూషుఫ్ యోననః పుత్రః, యానన్ ఇలీయాకీమః పుత్రః|</para>
  <para style="p">
    <verse number="31" style="v"/>ఇలియాకీమ్ః మిలేయాః పుత్రః, మిలేయా మైననః పుత్రః, మైనన్ మత్తత్తస్య పుత్రః, మత్తత్తో నాథనః పుత్రః, నాథన్ దాయూదః పుత్రః|</para>
  <para style="p">
    <verse number="32" style="v"/>దాయూద్ యిశయః పుత్రః, యిశయ ఓబేదః పుత్ర, ఓబేద్ బోయసః పుత్రః, బోయస్ సల్మోనః పుత్రః, సల్మోన్ నహశోనః పుత్రః|</para>
  <para style="p">
    <verse number="33" style="v"/>నహశోన్ అమ్మీనాదబః పుత్రః, అమ్మీనాదబ్ అరామః పుత్రః, అరామ్ హిష్రోణః పుత్రః, హిష్రోణ్ పేరసః పుత్రః, పేరస్ యిహూదాః పుత్రః|</para>
  <para style="p">
    <verse number="34" style="v"/>యిహూదా యాకూబః పుత్రః, యాకూబ్ ఇస్హాకః పుత్రః, ఇస్హాక్ ఇబ్రాహీమః పుత్రః, ఇబ్రాహీమ్ తేరహః పుత్రః, తేరహ్ నాహోరః పుత్రః|</para>
  <para style="p">
    <verse number="35" style="v"/>నాహోర్ సిరుగః పుత్రః, సిరుగ్ రియ్వః పుత్రః, రియూః పేలగః పుత్రః, పేలగ్ ఏవరః పుత్రః, ఏవర్ శేలహః పుత్రః|</para>
  <para style="p">
    <verse number="36" style="v"/>శేలహ్ కైననః పుత్రః, కైనన్ అర్ఫక్షదః పుత్రః, అర్ఫక్షద్ శామః పుత్రః, శామ్ నోహః పుత్రః, నోహో లేమకః పుత్రః|</para>
  <para style="p">
    <verse number="37" style="v"/>లేమక్ మిథూశేలహః పుత్రః, మిథూశేలహ్ హనోకః పుత్రః, హనోక్ యేరదః పుత్రః, యేరద్ మహలలేలః పుత్రః, మహలలేల్ కైననః పుత్రః|</para>
  <para style="p">
    <verse number="38" style="v"/>కైనన్ ఇనోశః పుత్రః, ఇనోశ్ శేతః పుత్రః, శేత్ ఆదమః పుత్ర, ఆదమ్ ఈశ్వరస్య పుత్రః|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>తతః పరం యీశుః పవిత్రేణాత్మనా పూర్ణః సన్ యర్ద్దననద్యాః పరావృత్యాత్మనా ప్రాన్తరం నీతః సన్ చత్వారింశద్దినాని యావత్ శైతానా పరీక్షితోఽభూత్,</para>
  <para style="p">
    <verse number="2" style="v"/>కిఞ్చ తాని సర్వ్వదినాని భోజనం వినా స్థితత్వాత్ కాలే పూర్ణే స క్షుధితవాన్|</para>
  <para style="p">
    <verse number="3" style="v"/>తతః శైతానాగత్య తమవదత్ త్వం చేదీశ్వరస్య పుత్రస్తర్హి ప్రస్తరానేతాన్ ఆజ్ఞయా పూపాన్ కురు|</para>
  <para style="p">
    <verse number="4" style="v"/>తదా యీశురువాచ, లిపిరీదృశీ విద్యతే మనుజః కేవలేన పూపేన న జీవతి కిన్త్వీశ్వరస్య సర్వ్వాభిరాజ్ఞాభి ర్జీవతి|</para>
  <para style="p">
    <verse number="5" style="v"/>తదా శైతాన్ తముచ్చం పర్వ్వతం నీత్వా నిమిషైకమధ్యే జగతః సర్వ్వరాజ్యాని దర్శితవాన్|</para>
  <para style="p">
    <verse number="6" style="v"/>పశ్చాత్ తమవాదీత్ సర్వ్వమ్ ఏతద్ విభవం ప్రతాపఞ్చ తుభ్యం దాస్యామి తన్ మయి సమర్పితమాస్తే యం ప్రతి మమేచ్ఛా జాయతే తస్మై దాతుం శక్నోమి,</para>
  <para style="p">
    <verse number="7" style="v"/>త్వం చేన్మాం భజసే తర్హి సర్వ్వమేతత్ తవైవ భవిష్యతి|</para>
  <para style="p">
    <verse number="8" style="v"/>తదా యీశుస్తం ప్రత్యుక్తవాన్ దూరీ భవ శైతాన్ లిపిరాస్తే, నిజం ప్రభుం పరమేశ్వరం భజస్వ కేవలం తమేవ సేవస్వ చ|</para>
  <para style="p">
    <verse number="9" style="v"/>అథ శైతాన్ తం యిరూశాలమం నీత్వా మన్దిరస్య చూడాయా ఉపరి సముపవేశ్య జగాద త్వం చేదీశ్వరస్య పుత్రస్తర్హి స్థానాదితో లమ్ఫిత్వాధః</para>
  <para style="p">
    <verse number="10" style="v"/>పత యతో లిపిరాస్తే, ఆజ్ఞాపయిష్యతి స్వీయాన్ దూతాన్ స పరమేశ్వరః|</para>
  <para style="p">
    <verse number="11" style="v"/>రక్షితుం సర్వ్వమార్గే త్వాం తేన త్వచ్చరణే యథా| న లగేత్ ప్రస్తరాఘాతస్త్వాం ధరిష్యన్తి తే తథా|</para>
  <para style="p">
    <verse number="12" style="v"/>తదా యీశునా ప్రత్యుక్తమ్ ఇదమప్యుక్తమస్తి త్వం స్వప్రభుం పరేశం మా పరీక్షస్వ|</para>
  <para style="p">
    <verse number="13" style="v"/>పశ్చాత్ శైతాన్ సర్వ్వపరీక్షాం సమాప్య క్షణాత్తం త్యక్త్వా యయౌ|</para>
  <para style="p">
    <verse number="14" style="v"/>తదా యీశురాత్మప్రభావాత్ పునర్గాలీల్ప్రదేశం గతస్తదా తత్సుఖ్యాతిశ్చతుర్దిశం వ్యానశే|</para>
  <para style="p">
    <verse number="15" style="v"/>స తేషాం భజనగృహేషు ఉపదిశ్య సర్వ్వైః ప్రశంసితో బభూవ|</para>
  <para style="p">
    <verse number="16" style="v"/>అథ స స్వపాలనస్థానం నాసరత్పురమేత్య విశ్రామవారే స్వాచారాద్ భజనగేహం ప్రవిశ్య పఠితుముత్తస్థౌ|</para>
  <para style="p">
    <verse number="17" style="v"/>తతో యిశయియభవిష్యద్వాదినః పుస్తకే తస్య కరదత్తే సతి స తత్ పుస్తకం విస్తార్య్య యత్ర వక్ష్యమాణాని వచనాని సన్తి తత్ స్థానం ప్రాప్య పపాఠ|</para>
  <para style="p">
    <verse number="18" style="v"/>ఆత్మా తు పరమేశస్య మదీయోపరి విద్యతే| దరిద్రేషు సుసంవాదం వక్తుం మాం సోభిషిక్తవాన్| భగ్నాన్తః కరణాల్లోకాన్ సుస్వస్థాన్ కర్త్తుమేవ చ| బన్దీకృతేషు లోకేషు ముక్తే ర్ఘోషయితుం వచః| నేత్రాణి దాతుమన్ధేభ్యస్త్రాతుం బద్ధజనానపి|</para>
  <para style="p">
    <verse number="19" style="v"/>పరేశానుగ్రహే కాలం ప్రచారయితుమేవ చ| సర్వ్వైతత్కరణార్థాయ మామేవ ప్రహిణోతి సః||</para>
  <para style="p">
    <verse number="20" style="v"/>తతః పుస్తకం బద్వ్వా పరిచారకస్య హస్తే సమర్ప్య చాసనే సముపవిష్టః, తతో భజనగృహే యావన్తో లోకా ఆసన్ తే సర్వ్వేఽనన్యదృష్ట్యా తం విలులోకిరే|</para>
  <para style="p">
    <verse number="21" style="v"/>అనన్తరమ్ అద్యైతాని సర్వ్వాణి లిఖితవచనాని యుష్మాకం మధ్యే సిద్ధాని స ఇమాం కథాం తేభ్యః కథయితుమారేభే|</para>
  <para style="p">
    <verse number="22" style="v"/>తతః సర్వ్వే తస్మిన్ అన్వరజ్యన్త, కిఞ్చ తస్య ముఖాన్నిర్గతాభిరనుగ్రహస్య కథాభిశ్చమత్కృత్య కథయామాసుః కిమయం యూషఫః పుత్రో న?</para>
  <para style="p">
    <verse number="23" style="v"/>తదా సోఽవాదీద్ హే చికిత్సక స్వమేవ స్వస్థం కురు కఫర్నాహూమి యద్యత్ కృతవాన్ తదశ్రౌష్మ తాః సర్వాః క్రియా అత్ర స్వదేశే కురు కథామేతాం యూయమేవావశ్యం మాం వదిష్యథ|</para>
  <para style="p">
    <verse number="24" style="v"/>పునః సోవాదీద్ యుష్మానహం యథార్థం వదామి, కోపి భవిష్యద్వాదీ స్వదేశే సత్కారం న ప్రాప్నోతి|</para>
  <para style="p">
    <verse number="25" style="v"/>అపరఞ్చ యథార్థం వచ్మి, ఏలియస్య జీవనకాలే యదా సార్ద్ధత్రితయవర్షాణి యావత్ జలదప్రతిబన్ధాత్ సర్వ్వస్మిన్ దేశే మహాదుర్భిక్షమ్ అజనిష్ట తదానీమ్ ఇస్రాయేలో దేశస్య మధ్యే బహ్వ్యో విధవా ఆసన్,</para>
  <para style="p">
    <verse number="26" style="v"/>కిన్తు సీదోన్ప్రదేశీయసారిఫత్పురనివాసినీమ్ ఏకాం విధవాం వినా కస్యాశ్చిదపి సమీపే ఏలియః ప్రేరితో నాభూత్|</para>
  <para style="p">
    <verse number="27" style="v"/>అపరఞ్చ ఇలీశాయభవిష్యద్వాదివిద్యమానతాకాలే ఇస్రాయేల్దేశే బహవః కుష్ఠిన ఆసన్ కిన్తు సురీయదేశీయం నామాన్కుష్ఠినం వినా కోప్యన్యః పరిష్కృతో నాభూత్|</para>
  <para style="p">
    <verse number="28" style="v"/>ఇమాం కథాం శ్రుత్వా భజనగేహస్థితా లోకాః సక్రోధమ్ ఉత్థాయ</para>
  <para style="p">
    <verse number="29" style="v"/>నగరాత్తం బహిష్కృత్య యస్య శిఖరిణ ఉపరి తేషాం నగరం స్థాపితమాస్తే తస్మాన్నిక్షేప్తుం తస్య శిఖరం తం నిన్యుః</para>
  <para style="p">
    <verse number="30" style="v"/>కిన్తు స తేషాం మధ్యాదపసృత్య స్థానాన్తరం జగామ|</para>
  <para style="p">
    <verse number="31" style="v"/>తతః పరం యీశుర్గాలీల్ప్రదేశీయకఫర్నాహూమ్నగర ఉపస్థాయ విశ్రామవారే లోకానుపదేష్టుమ్ ఆరబ్ధవాన్|</para>
  <para style="p">
    <verse number="32" style="v"/>తదుపదేశాత్ సర్వ్వే చమచ్చక్రు ర్యతస్తస్య కథా గురుతరా ఆసన్|</para>
  <para style="p">
    <verse number="33" style="v"/>తదానీం తద్భజనగేహస్థితోఽమేధ్యభూతగ్రస్త ఏకో జన ఉచ్చైః కథయామాస,</para>
  <para style="p">
    <verse number="34" style="v"/>హే నాసరతీయయీశోఽస్మాన్ త్యజ, త్వయా సహాస్మాకం కః సమ్బన్ధః? కిమస్మాన్ వినాశయితుమాయాసి? త్వమీశ్వరస్య పవిత్రో జన ఏతదహం జానామి|</para>
  <para style="p">
    <verse number="35" style="v"/>తదా యీశుస్తం తర్జయిత్వావదత్ మౌనీ భవ ఇతో బహిర్భవ; తతః సోమేధ్యభూతస్తం మధ్యస్థానే పాతయిత్వా కిఞ్చిదప్యహింసిత్వా తస్మాద్ బహిర్గతవాన్|</para>
  <para style="p">
    <verse number="36" style="v"/>తతః సర్వ్వే లోకాశ్చమత్కృత్య పరస్పరం వక్తుమారేభిరే కోయం చమత్కారః| ఏష ప్రభావేణ పరాక్రమేణ చామేధ్యభూతాన్ ఆజ్ఞాపయతి తేనైవ తే బహిర్గచ్ఛన్తి|</para>
  <para style="p">
    <verse number="37" style="v"/>అనన్తరం చతుర్దిక్స్థదేశాన్ తస్య సుఖ్యాతిర్వ్యాప్నోత్|</para>
  <para style="p">
    <verse number="38" style="v"/>తదనన్తరం స భజనగేహాద్ బహిరాగత్య శిమోనో నివేశనం ప్రవివేశ తదా తస్య శ్వశ్రూర్జ్వరేణాత్యన్తం పీడితాసీత్ శిష్యాస్తదర్థం తస్మిన్ వినయం చక్రుః|</para>
  <para style="p">
    <verse number="39" style="v"/>తతః స తస్యాః సమీపే స్థిత్వా జ్వరం తర్జయామాస తేనైవ తాం జ్వరోఽత్యాక్షీత్ తతః సా తత్క్షణమ్ ఉత్థాయ తాన్ సిషేవే|</para>
  <para style="p">
    <verse number="40" style="v"/>అథ సూర్య్యాస్తకాలే స్వేషాం యే యే జనా నానారోగైః పీడితా ఆసన్ లోకాస్తాన్ యీశోః సమీపమ్ ఆనిన్యుః, తదా స ఏకైకస్య గాత్రే కరమర్పయిత్వా తానరోగాన్ చకార|</para>
  <para style="p">
    <verse number="41" style="v"/>తతో భూతా బహుభ్యో నిర్గత్య చీత్శబ్దం కృత్వా చ బభాషిరే త్వమీశ్వరస్య పుత్రోఽభిషిక్తత్రాతా; కిన్తు సోభిషిక్తత్రాతేతి తే వివిదురేతస్మాత్ కారణాత్ తాన్ తర్జయిత్వా తద్వక్తుం నిషిషేధ|</para>
  <para style="p">
    <verse number="42" style="v"/>అపరఞ్చ ప్రభాతే సతి స విజనస్థానం ప్రతస్థే పశ్చాత్ జనాస్తమన్విచ్ఛన్తస్తన్నికటం గత్వా స్థానాన్తరగమనార్థం తమన్వరున్ధన్|</para>
  <para style="p">
    <verse number="43" style="v"/>కిన్తు స తాన్ జగాద, ఈశ్వరీయరాజ్యస్య సుసంవాదం ప్రచారయితుమ్ అన్యాని పురాణ్యపి మయా యాతవ్యాని యతస్తదర్థమేవ ప్రేరితోహం|</para>
  <para style="p">
    <verse number="44" style="v"/>అథ గాలీలో భజనగేహేషు స ఉపదిదేశ|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అనన్తరం యీశురేకదా గినేషరథ్దస్య తీర ఉత్తిష్ఠతి, తదా లోకా ఈశ్వరీయకథాం శ్రోతుం తదుపరి ప్రపతితాః|</para>
  <para style="p">
    <verse number="2" style="v"/>తదానీం స హ్దస్య తీరసమీపే నౌద్వయం దదర్శ కిఞ్చ మత్స్యోపజీవినో నావం విహాయ జాలం ప్రక్షాలయన్తి|</para>
  <para style="p">
    <verse number="3" style="v"/>తతస్తయోర్ద్వయో ర్మధ్యే శిమోనో నావమారుహ్య తీరాత్ కిఞ్చిద్దూరం యాతుం తస్మిన్ వినయం కృత్వా నౌకాయాముపవిశ్య లోకాన్ ప్రోపదిష్టవాన్|</para>
  <para style="p">
    <verse number="4" style="v"/>పశ్చాత్ తం ప్రస్తావం సమాప్య స శిమోనం వ్యాజహార, గభీరం జలం గత్వా మత్స్యాన్ ధర్త్తుం జాలం నిక్షిప|</para>
  <para style="p">
    <verse number="5" style="v"/>తతః శిమోన బభాషే, హే గురో యద్యపి వయం కృత్స్నాం యామినీం పరిశ్రమ్య మత్స్యైకమపి న ప్రాప్తాస్తథాపి భవతో నిదేశతో జాలం క్షిపామః|</para>
  <para style="p">
    <verse number="6" style="v"/>అథ జాలే క్షిప్తే బహుమత్స్యపతనాద్ ఆనాయః ప్రచ్ఛిన్నః|</para>
  <para style="p">
    <verse number="7" style="v"/>తస్మాద్ ఉపకర్త్తుమ్ అన్యనౌస్థాన్ సఙ్గిన ఆయాతుమ్ ఇఙ్గితేన సమాహ్వయన్ తతస్త ఆగత్య మత్స్యై ర్నౌద్వయం ప్రపూరయామాసు ర్యై ర్నౌద్వయం ప్రమగ్నమ్|</para>
  <para style="p">
    <verse number="8" style="v"/>తదా శిమోన్పితరస్తద్ విలోక్య యీశోశ్చరణయోః పతిత్వా, హే ప్రభోహం పాపీ నరో మమ నికటాద్ భవాన్ యాతు, ఇతి కథితవాన్|</para>
  <para style="p">
    <verse number="9" style="v"/>యతో జాలే పతితానాం మత్స్యానాం యూథాత్ శిమోన్ తత్సఙ్గినశ్చ చమత్కృతవన్తః; శిమోనః సహకారిణౌ సివదేః పుత్రౌ యాకూబ్ యోహన్ చేమౌ తాదృశౌ బభూవతుః|</para>
  <para style="p">
    <verse number="10" style="v"/>తదా యీశుః శిమోనం జగాద మా భైషీరద్యారభ్య త్వం మనుష్యధరో భవిష్యసి|</para>
  <para style="p">
    <verse number="11" style="v"/>అనన్తరం సర్వ్వాసు నౌసు తీరమ్ ఆనీతాసు తే సర్వ్వాన్ పరిత్యజ్య తస్య పశ్చాద్గామినో బభూవుః|</para>
  <para style="p">
    <verse number="12" style="v"/>తతః పరం యీశౌ కస్మింశ్చిత్ పురే తిష్ఠతి జన ఏకః సర్వ్వాఙ్గకుష్ఠస్తం విలోక్య తస్య సమీపే న్యుబ్జః పతిత్వా సవినయం వక్తుమారేభే, హే ప్రభో యది భవానిచ్ఛతి తర్హి మాం పరిష్కర్త్తుం శక్నోతి|</para>
  <para style="p">
    <verse number="13" style="v"/>తదానీం స పాణిం ప్రసార్య్య తదఙ్గం స్పృశన్ బభాషే త్వం పరిష్క్రియస్వేతి మమేచ్ఛాస్తి తతస్తత్క్షణం స కుష్ఠాత్ ముక్తః|</para>
  <para style="p">
    <verse number="14" style="v"/>పశ్చాత్ స తమాజ్ఞాపయామాస కథామిమాం కస్మైచిద్ అకథయిత్వా యాజకస్య సమీపఞ్చ గత్వా స్వం దర్శయ, లోకేభ్యో నిజపరిష్కృతత్వస్య ప్రమాణదానాయ మూసాజ్ఞానుసారేణ ద్రవ్యముత్మృజస్వ చ|</para>
  <para style="p">
    <verse number="15" style="v"/>తథాపి యీశోః సుఖ్యాతి ర్బహు వ్యాప్తుమారేభే కిఞ్చ తస్య కథాం శ్రోతుం స్వీయరోగేభ్యో మోక్తుఞ్చ లోకా ఆజగ్ముః|</para>
  <para style="p">
    <verse number="16" style="v"/>అథ స ప్రాన్తరం గత్వా ప్రార్థయాఞ్చక్రే|</para>
  <para style="p">
    <verse number="17" style="v"/>అపరఞ్చ ఏకదా యీశురుపదిశతి, ఏతర్హి గాలీల్యిహూదాప్రదేశయోః సర్వ్వనగరేభ్యో యిరూశాలమశ్చ కియన్తః ఫిరూశిలోకా వ్యవస్థాపకాశ్చ సమాగత్య తదన్తికే సముపవివిశుః, తస్మిన్ కాలే లోకానామారోగ్యకారణాత్ ప్రభోః ప్రభావః ప్రచకాశే|</para>
  <para style="p">
    <verse number="18" style="v"/>పశ్చాత్ కియన్తో లోకా ఏకం పక్షాఘాతినం ఖట్వాయాం నిధాయ యీశోః సమీపమానేతుం సమ్ముఖే స్థాపయితుఞ్చ వ్యాప్రియన్త|</para>
  <para style="p">
    <verse number="19" style="v"/>కిన్తు బహుజననివహసమ్వాధాత్ న శక్నువన్తో గృహోపరి గత్వా గృహపృష్ఠం ఖనిత్వా తం పక్షాఘాతినం సఖట్వం గృహమధ్యే యీశోః సమ్ముఖే ఽవరోహయామాసుః|</para>
  <para style="p">
    <verse number="20" style="v"/>తదా యీశుస్తేషామ్ ఈదృశం విశ్వాసం విలోక్య తం పక్షాఘాతినం వ్యాజహార, హే మానవ తవ పాపమక్షమ్యత|</para>
  <para style="p">
    <verse number="21" style="v"/>తస్మాద్ అధ్యాపకాః ఫిరూశినశ్చ చిత్తైరిత్థం ప్రచిన్తితవన్తః, ఏష జన ఈశ్వరం నిన్దతి కోయం? కేవలమీశ్వరం వినా పాపం క్షన్తుం కః శక్నోతి?</para>
  <para style="p">
    <verse number="22" style="v"/>తదా యీశుస్తేషామ్ ఇత్థం చిన్తనం విదిత్వా తేభ్యోకథయద్ యూయం మనోభిః కుతో వితర్కయథ?</para>
  <para style="p">
    <verse number="23" style="v"/>తవ పాపక్షమా జాతా యద్వా త్వముత్థాయ వ్రజ ఏతయో ర్మధ్యే కా కథా సుకథ్యా?</para>
  <para style="p">
    <verse number="24" style="v"/>కిన్తు పృథివ్యాం పాపం క్షన్తుం మానవసుతస్య సామర్థ్యమస్తీతి యథా యూయం జ్ఞాతుం శక్నుథ తదర్థం (స తం పక్షాఘాతినం జగాద) ఉత్తిష్ఠ స్వశయ్యాం గృహీత్వా గృహం యాహీతి త్వామాదిశామి|</para>
  <para style="p">
    <verse number="25" style="v"/>తస్మాత్ స తత్క్షణమ్ ఉత్థాయ సర్వ్వేషాం సాక్షాత్ నిజశయనీయం గృహీత్వా ఈశ్వరం ధన్యం వదన్ నిజనివేశనం యయౌ|</para>
  <para style="p">
    <verse number="26" style="v"/>తస్మాత్ సర్వ్వే విస్మయ ప్రాప్తా మనఃసు భీతాశ్చ వయమద్యాసమ్భవకార్య్యాణ్యదర్శామ ఇత్యుక్త్వా పరమేశ్వరం ధన్యం ప్రోదితాః|</para>
  <para style="p">
    <verse number="27" style="v"/>తతః పరం బహిర్గచ్ఛన్ కరసఞ్చయస్థానే లేవినామానం కరసఞ్చాయకం దృష్ట్వా యీశుస్తమభిదధే మమ పశ్చాదేహి|</para>
  <para style="p">
    <verse number="28" style="v"/>తస్మాత్ స తత్క్షణాత్ సర్వ్వం పరిత్యజ్య తస్య పశ్చాదియాయ|</para>
  <para style="p">
    <verse number="29" style="v"/>అనన్తరం లేవి ర్నిజగృహే తదర్థం మహాభోజ్యం చకార, తదా తైః సహానేకే కరసఞ్చాయినస్తదన్యలోకాశ్చ భోక్తుముపవివిశుః|</para>
  <para style="p">
    <verse number="30" style="v"/>తస్మాత్ కారణాత్ చణ్డాలానాం పాపిలోకానాఞ్చ సఙ్గే యూయం కుతో భంగ్ధ్వే పివథ చేతి కథాం కథయిత్వా ఫిరూశినోఽధ్యాపకాశ్చ తస్య శిష్యైః సహ వాగ్యుద్ధం కర్త్తుమారేభిరే|</para>
  <para style="p">
    <verse number="31" style="v"/>తస్మాద్ యీశుస్తాన్ ప్రత్యవోచద్ అరోగలోకానాం చికిత్సకేన ప్రయోజనం నాస్తి కిన్తు సరోగాణామేవ|</para>
  <para style="p">
    <verse number="32" style="v"/>అహం ధార్మ్మికాన్ ఆహ్వాతుం నాగతోస్మి కిన్తు మనః పరావర్త్తయితుం పాపిన ఏవ|</para>
  <para style="p">
    <verse number="33" style="v"/>తతస్తే ప్రోచుః, యోహనః ఫిరూశినాఞ్చ శిష్యా వారంవారమ్ ఉపవసన్తి ప్రార్థయన్తే చ కిన్తు తవ శిష్యాః కుతో భుఞ్జతే పివన్తి చ?</para>
  <para style="p">
    <verse number="34" style="v"/>తదా స తానాచఖ్యౌ వరే సఙ్గే తిష్ఠతి వరస్య సఖిగణం కిముపవాసయితుం శక్నుథ?</para>
  <para style="p">
    <verse number="35" style="v"/>కిన్తు యదా తేషాం నికటాద్ వరో నేష్యతే తదా తే సముపవత్స్యన్తి|</para>
  <para style="p">
    <verse number="36" style="v"/>సోపరమపి దృష్టాన్తం కథయామ్బభూవ పురాతనవస్త్రే కోపి నుతనవస్త్రం న సీవ్యతి యతస్తేన సేవనేన జీర్ణవస్త్రం ఛిద్యతే, నూతనపురాతనవస్త్రయో ర్మేలఞ్చ న భవతి|</para>
  <para style="p">
    <verse number="37" style="v"/>పురాతన్యాం కుత్వాం కోపి నుతనం ద్రాక్షారసం న నిదధాతి, యతో నవీనద్రాక్షారసస్య తేజసా పురాతనీ కుతూ ర్విదీర్య్యతే తతో ద్రాక్షారసః పతతి కుతూశ్చ నశ్యతి|</para>
  <para style="p">
    <verse number="38" style="v"/>తతో హేతో ర్నూతన్యాం కుత్వాం నవీనద్రాక్షారసః నిధాతవ్యస్తేనోభయస్య రక్షా భవతి|</para>
  <para style="p">
    <verse number="39" style="v"/>అపరఞ్చ పురాతనం ద్రాక్షారసం పీత్వా కోపి నూతనం న వాఞ్ఛతి, యతః స వక్తి నూతనాత్ పురాతనమ్ ప్రశస్తమ్|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అచరఞ్చ పర్వ్వణో ద్వితీయదినాత్ పరం ప్రథమవిశ్రామవారే శస్యక్షేత్రేణ యీశోర్గమనకాలే తస్య శిష్యాః కణిశం ఛిత్త్వా కరేషు మర్ద్దయిత్వా ఖాదితుమారేభిరే|</para>
  <para style="p">
    <verse number="2" style="v"/>తస్మాత్ కియన్తః ఫిరూశినస్తానవదన్ విశ్రామవారే యత్ కర్మ్మ న కర్త్తవ్యం తత్ కుతః కురుథ?</para>
  <para style="p">
    <verse number="3" style="v"/>యీశుః ప్రత్యువాచ దాయూద్ తస్య సఙ్గినశ్చ క్షుధార్త్తాః కిం చక్రుః స కథమ్ ఈశ్వరస్య మన్దిరం ప్రవిశ్య</para>
  <para style="p">
    <verse number="4" style="v"/>యే దర్శనీయాః పూపా యాజకాన్ వినాన్యస్య కస్యాప్యభోజనీయాస్తానానీయ స్వయం బుభజే సఙ్గిభ్యోపి దదౌ తత్ కిం యుష్మాభిః కదాపి నాపాఠి?</para>
  <para style="p">
    <verse number="5" style="v"/>పశ్చాత్ స తానవదత్ మనుజసుతో విశ్రామవారస్యాపి ప్రభు ర్భవతి|</para>
  <para style="p">
    <verse number="6" style="v"/>అనన్తరమ్ అన్యవిశ్రామవారే స భజనగేహం ప్రవిశ్య సముపదిశతి| తదా తత్స్థానే శుష్కదక్షిణకర ఏకః పుమాన్ ఉపతస్థివాన్|</para>
  <para style="p">
    <verse number="7" style="v"/>తస్మాద్ అధ్యాపకాః ఫిరూశినశ్చ తస్మిన్ దోషమారోపయితుం స విశ్రామవారే తస్య స్వాస్థ్యం కరోతి నవేతి ప్రతీక్షితుమారేభిరే|</para>
  <para style="p">
    <verse number="8" style="v"/>తదా యీశుస్తేషాం చిన్తాం విదిత్వా తం శుష్కకరం పుమాంసం ప్రోవాచ, త్వముత్థాయ మధ్యస్థానే తిష్ఠ|</para>
  <para style="p">
    <verse number="9" style="v"/>తస్మాత్ తస్మిన్ ఉత్థితవతి యీశుస్తాన్ వ్యాజహార, యుష్మాన్ ఇమాం కథాం పృచ్ఛామి, విశ్రామవారే హితమ్ అహితం వా, ప్రాణరక్షణం ప్రాణనాశనం వా, ఏతేషాం కిం కర్మ్మకరణీయమ్?</para>
  <para style="p">
    <verse number="10" style="v"/>పశ్చాత్ చతుర్దిక్షు సర్వ్వాన్ విలోక్య తం మానవం బభాషే, నిజకరం ప్రసారయ; తతస్తేన తథా కృత ఇతరకరవత్ తస్య హస్తః స్వస్థోభవత్|</para>
  <para style="p">
    <verse number="11" style="v"/>తస్మాత్ తే ప్రచణ్డకోపాన్వితా యీశుం కిం కరిష్యన్తీతి పరస్పరం ప్రమన్త్రితాః|</para>
  <para style="p">
    <verse number="12" style="v"/>తతః పరం స పర్వ్వతమారుహ్యేశ్వరముద్దిశ్య ప్రార్థయమానః కృత్స్నాం రాత్రిం యాపితవాన్|</para>
  <para style="p">
    <verse number="13" style="v"/>అథ దినే సతి స సర్వ్వాన్ శిష్యాన్ ఆహూతవాన్ తేషాం మధ్యే</para>
  <para style="p">
    <verse number="14" style="v"/>పితరనామ్నా ఖ్యాతః శిమోన్ తస్య భ్రాతా ఆన్ద్రియశ్చ యాకూబ్ యోహన్ చ ఫిలిప్ బర్థలమయశ్చ</para>
  <para style="p">
    <verse number="15" style="v"/>మథిః థోమా ఆల్ఫీయస్య పుత్రో యాకూబ్ జ్వలన్తనామ్నా ఖ్యాతః శిమోన్</para>
  <para style="p">
    <verse number="16" style="v"/>చ యాకూబో భ్రాతా యిహూదాశ్చ తం యః పరకరేషు సమర్పయిష్యతి స ఈష్కరీయోతీయయిహూదాశ్చైతాన్ ద్వాదశ జనాన్ మనోనీతాన్ కృత్వా స జగ్రాహ తథా ప్రేరిత ఇతి తేషాం నామ చకార|</para>
  <para style="p">
    <verse number="17" style="v"/>తతః పరం స తైః సహ పర్వ్వతాదవరుహ్య ఉపత్యకాయాం తస్థౌ తతస్తస్య శిష్యసఙ్ఘో యిహూదాదేశాద్ యిరూశాలమశ్చ సోరః సీదోనశ్చ జలధే రోధసో జననిహాశ్చ ఏత్య తస్య కథాశ్రవణార్థం రోగముక్త్యర్థఞ్చ తస్య సమీపే తస్థుః|</para>
  <para style="p">
    <verse number="18" style="v"/>అమేధ్యభూతగ్రస్తాశ్చ తన్నికటమాగత్య స్వాస్థ్యం ప్రాపుః|</para>
  <para style="p">
    <verse number="19" style="v"/>సర్వ్వేషాం స్వాస్థ్యకరణప్రభావస్య ప్రకాశితత్వాత్ సర్వ్వే లోకా ఏత్య తం స్ప్రష్టుం యేతిరే|</para>
  <para style="p">
    <verse number="20" style="v"/>పశ్చాత్ స శిష్యాన్ ప్రతి దృష్టిం కుత్వా జగాద, హే దరిద్రా యూయం ధన్యా యత ఈశ్వరీయే రాజ్యే వోఽధికారోస్తి|</para>
  <para style="p">
    <verse number="21" style="v"/>హే అధునా క్షుధితలోకా యూయం ధన్యా యతో యూయం తర్ప్స్యథ; హే ఇహ రోదినో జనా యూయం ధన్యా యతో యూయం హసిష్యథ|</para>
  <para style="p">
    <verse number="22" style="v"/>యదా లోకా మనుష్యసూనో ర్నామహేతో ర్యుష్మాన్ ఋृతీయిష్యన్తే పృథక్ కృత్వా నిన్దిష్యన్తి, అధమానివ యుష్మాన్ స్వసమీపాద్ దూరీకరిష్యన్తి చ తదా యూయం ధన్యాః|</para>
  <para style="p">
    <verse number="23" style="v"/>స్వర్గే యుష్మాకం యథేష్టం ఫలం భవిష్యతి, ఏతదర్థం తస్మిన్ దినే ప్రోల్లసత ఆనన్దేన నృత్యత చ, తేషాం పూర్వ్వపురుషాశ్చ భవిష్యద్వాదినః ప్రతి తథైవ వ్యవాహరన్|</para>
  <para style="p">
    <verse number="24" style="v"/>కిన్తు హా హా ధనవన్తో యూయం సుఖం ప్రాప్నుత| హన్త పరితృప్తా యూయం క్షుధితా భవిష్యథ;</para>
  <para style="p">
    <verse number="25" style="v"/>ఇహ హసన్తో యూయం వత యుష్మాభిః శోచితవ్యం రోదితవ్యఞ్చ|</para>
  <para style="p">
    <verse number="26" style="v"/>సర్వ్వైలాకై ర్యుష్మాకం సుఖ్యాతౌ కృతాయాం యుష్మాకం దుర్గతి ర్భవిష్యతి యుష్మాకం పూర్వ్వపురుషా మృషాభవిష్యద్వాదినః ప్రతి తద్వత్ కృతవన్తః|</para>
  <para style="p">
    <verse number="27" style="v"/>హే శ్రోతారో యుష్మభ్యమహం కథయామి, యూయం శత్రుషు ప్రీయధ్వం యే చ యుష్మాన్ ద్విషన్తి తేషామపి హితం కురుత|</para>
  <para style="p">
    <verse number="28" style="v"/>యే చ యుష్మాన్ శపన్తి తేభ్య ఆశిషం దత్త యే చ యుష్మాన్ అవమన్యన్తే తేషాం మఙ్గలం ప్రార్థయధ్వం|</para>
  <para style="p">
    <verse number="29" style="v"/>యది కశ్చిత్ తవ కపోలే చపేటాఘాతం కరోతి తర్హి తం ప్రతి కపోలమ్ అన్యం పరావర్త్త్య సమ్ముఖీకురు పునశ్చ యది కశ్చిత్ తవ గాత్రీయవస్త్రం హరతి తర్హి తం పరిధేయవస్త్రమ్ అపి గ్రహీతుం మా వారయ|</para>
  <para style="p">
    <verse number="30" style="v"/>యస్త్వాం యాచతే తస్మై దేహి, యశ్చ తవ సమ్పత్తిం హరతి తం మా యాచస్వ|</para>
  <para style="p">
    <verse number="31" style="v"/>పరేభ్యః స్వాన్ ప్రతి యథాచరణమ్ అపేక్షధ్వే పరాన్ ప్రతి యూయమపి తథాచరత|</para>
  <para style="p">
    <verse number="32" style="v"/>యే జనా యుష్మాసు ప్రీయన్తే కేవలం తేషు ప్రీయమాణేషు యుష్మాకం కిం ఫలం? పాపిలోకా అపి స్వేషు ప్రీయమాణేషు ప్రీయన్తే|</para>
  <para style="p">
    <verse number="33" style="v"/>యది హితకారిణ ఏవ హితం కురుథ తర్హి యుష్మాకం కిం ఫలం? పాపిలోకా అపి తథా కుర్వ్వన్తి|</para>
  <para style="p">
    <verse number="34" style="v"/>యేభ్య ఋణపరిశోధస్య ప్రాప్తిప్రత్యాశాస్తే కేవలం తేషు ఋణే సమర్పితే యుష్మాకం కిం ఫలం? పునః ప్రాప్త్యాశయా పాపీలోకా అపి పాపిజనేషు ఋణమ్ అర్పయన్తి|</para>
  <para style="p">
    <verse number="35" style="v"/>అతో యూయం రిపుష్వపి ప్రీయధ్వం, పరహితం కురుత చ; పునః ప్రాప్త్యాశాం త్యక్త్వా ఋణమర్పయత, తథా కృతే యుష్మాకం మహాఫలం భవిష్యతి, యూయఞ్చ సర్వ్వప్రధానస్య సన్తానా ఇతి ఖ్యాతిం ప్రాప్స్యథ, యతో యుష్మాకం పితా కృతఘ్నానాం దుర్వ్టత్తానాఞ్చ హితమాచరతి|</para>
  <para style="p">
    <verse number="36" style="v"/>అత ఏవ స యథా దయాలు ర్యూయమపి తాదృశా దయాలవో భవత|</para>
  <para style="p">
    <verse number="37" style="v"/>అపరఞ్చ పరాన్ దోషిణో మా కురుత తస్మాద్ యూయం దోషీకృతా న భవిష్యథ; అదణ్డ్యాన్ మా దణ్డయత తస్మాద్ యూయమపి దణ్డం న ప్రాప్స్యథ; పరేషాం దోషాన్ క్షమధ్వం తస్మాద్ యుష్మాకమపి దోషాః క్షమిష్యన్తే|</para>
  <para style="p">
    <verse number="38" style="v"/>దానానిదత్త తస్మాద్ యూయం దానాని ప్రాప్స్యథ, వరఞ్చ లోకాః పరిమాణపాత్రం ప్రదలయ్య సఞ్చాల్య ప్రోఞ్చాల్య పరిపూర్య్య యుష్మాకం క్రోడేషు సమర్పయిష్యన్తి; యూయం యేన పరిమాణేన పరిమాథ తేనైవ పరిమాణేన యుష్మత్కృతే పరిమాస్యతే|</para>
  <para style="p">
    <verse number="39" style="v"/>అథ స తేభ్యో దృష్టాన్తకథామకథయత్, అన్ధో జనః కిమన్ధం పన్థానం దర్శయితుం శక్నోతి? తస్మాద్ ఉభావపి కిం గర్త్తే న పతిష్యతః?</para>
  <para style="p">
    <verse number="40" style="v"/>గురోః శిష్యో న శ్రేష్ఠః కిన్తు శిష్యే సిద్ధే సతి స గురుతుల్యో భవితుం శక్నోతి|</para>
  <para style="p">
    <verse number="41" style="v"/>అపరఞ్చ త్వం స్వచక్షుुషి నాసామ్ అదృష్ట్వా తవ భ్రాతుశ్చక్షుషి యత్తృణమస్తి తదేవ కుతః పశ్యమి?</para>
  <para style="p">
    <verse number="42" style="v"/>స్వచక్షుషి యా నాసా విద్యతే తామ్ అజ్ఞాత్వా, భ్రాతస్తవ నేత్రాత్ తృణం బహిః కరోమీతి వాక్యం భ్రాతరం కథం వక్తుం శక్నోషి? హే కపటిన్ పూర్వ్వం స్వనయనాత్ నాసాం బహిః కురు తతో భ్రాతుశ్చక్షుషస్తృణం బహిః కర్త్తుం సుదృష్టిం ప్రాప్స్యసి|</para>
  <para style="p">
    <verse number="43" style="v"/>అన్యఞ్చ ఉత్తమస్తరుః కదాపి ఫలమనుత్తమం న ఫలతి, అనుత్తమతరుశ్చ ఫలముత్తమం న ఫలతి కారణాదతః ఫలైస్తరవో జ్ఞాయన్తే|</para>
  <para style="p">
    <verse number="44" style="v"/>కణ్టకిపాదపాత్ కోపి ఉడుమ్బరఫలాని న పాతయతి తథా శృగాలకోలివృక్షాదపి కోపి ద్రాక్షాఫలం న పాతయతి|</para>
  <para style="p">
    <verse number="45" style="v"/>తద్వత్ సాధులోకోఽన్తఃకరణరూపాత్ సుభాణ్డాగారాద్ ఉత్తమాని ద్రవ్యాణి బహిః కరోతి, దుష్టో లోకశ్చాన్తఃకరణరూపాత్ కుభాణ్డాగారాత్ కుత్సితాని ద్రవ్యాణి నిర్గమయతి యతోఽన్తఃకరణానాం పూర్ణభావానురూపాణి వచాంసి ముఖాన్నిర్గచ్ఛన్తి|</para>
  <para style="p">
    <verse number="46" style="v"/>అపరఞ్చ మమాజ్ఞానురూపం నాచరిత్వా కుతో మాం ప్రభో ప్రభో ఇతి వదథ?</para>
  <para style="p">
    <verse number="47" style="v"/>యః కశ్చిన్ మమ నికటమ్ ఆగత్య మమ కథా నిశమ్య తదనురూపం కర్మ్మ కరోతి స కస్య సదృశో భవతి తదహం యుష్మాన్ జ్ఞాाపయామి|</para>
  <para style="p">
    <verse number="48" style="v"/>యో జనో గభీరం ఖనిత్వా పాషాణస్థలే భిత్తిం నిర్మ్మాయ స్వగృహం రచయతి తేన సహ తస్యోపమా భవతి; యత ఆప్లావిజలమేత్య తస్య మూలే వేగేన వహదపి తద్గేహం లాడయితుం న శక్నోతి యతస్తస్య భిత్తిః పాషాణోపరి తిష్ఠతి|</para>
  <para style="p">
    <verse number="49" style="v"/>కిన్తు యః కశ్చిన్ మమ కథాః శ్రుత్వా తదనురూపం నాచరతి స భిత్తిం వినా మృृదుపరి గృహనిర్మ్మాత్రా సమానో భవతి; యత ఆప్లావిజలమాగత్య వేగేన యదా వహతి తదా తద్గృహం పతతి తస్య మహత్ పతనం జాయతే|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>తతః పరం స లోకానాం కర్ణగోచరే తాన్ సర్వ్వాన్ ఉపదేశాన్ సమాప్య యదా కఫర్నాహూమ్పురం ప్రవిశతి</para>
  <para style="p">
    <verse number="2" style="v"/>తదా శతసేనాపతేః ప్రియదాస ఏకో మృతకల్పః పీడిత ఆసీత్|</para>
  <para style="p">
    <verse number="3" style="v"/>అతః సేనాపతి ర్యీశో ర్వార్త్తాం నిశమ్య దాసస్యారోగ్యకరణాయ తస్యాగమనార్థం వినయకరణాయ యిహూదీయాన్ కియతః ప్రాచః ప్రేషయామాస|</para>
  <para style="p">
    <verse number="4" style="v"/>తే యీశోరన్తికం గత్వా వినయాతిశయం వక్తుమారేభిరే, స సేనాపతి ర్భవతోనుగ్రహం ప్రాప్తుమ్ అర్హతి|</para>
  <para style="p">
    <verse number="5" style="v"/>యతః సోస్మజ్జాతీయేషు లోకేషు ప్రీయతే తథాస్మత్కృతే భజనగేహం నిర్మ్మితవాన్|</para>
  <para style="p">
    <verse number="6" style="v"/>తస్మాద్ యీశుస్తైః సహ గత్వా నివేశనస్య సమీపం ప్రాప, తదా స శతసేనాపతి ర్వక్ష్యమాణవాక్యం తం వక్తుం బన్ధూన్ ప్రాహిణోత్| హే ప్రభో స్వయం శ్రమో న కర్త్తవ్యో యద్ భవతా మద్గేహమధ్యే పాదార్పణం క్రియేత తదప్యహం నార్హామి,</para>
  <para style="p">
    <verse number="7" style="v"/>కిఞ్చాహం భవత్సమీపం యాతుమపి నాత్మానం యోగ్యం బుద్ధవాన్, తతో భవాన్ వాక్యమాత్రం వదతు తేనైవ మమ దాసః స్వస్థో భవిష్యతి|</para>
  <para style="p">
    <verse number="8" style="v"/>యస్మాద్ అహం పరాధీనోపి మమాధీనా యాః సేనాః సన్తి తాసామ్ ఏకజనం ప్రతి యాహీతి మయా ప్రోక్తే స యాతి; తదన్యం ప్రతి ఆయాహీతి ప్రోక్తే స ఆయాతి; తథా నిజదాసం ప్రతి ఏతత్ కుర్వ్వితి ప్రోక్తే స తదేవ కరోతి|</para>
  <para style="p">
    <verse number="9" style="v"/>యీశురిదం వాక్యం శ్రుత్వా విస్మయం యయౌ, ముఖం పరావర్త్య పశ్చాద్వర్త్తినో లోకాన్ బభాషే చ, యుష్మానహం వదామి ఇస్రాయేలో వంశమధ్యేపి విశ్వాసమీదృశం న ప్రాప్నవం|</para>
  <para style="p">
    <verse number="10" style="v"/>తతస్తే ప్రేషితా గృహం గత్వా తం పీడితం దాసం స్వస్థం దదృశుః|</para>
  <para style="p">
    <verse number="11" style="v"/>పరేఽహని స నాయీనాఖ్యం నగరం జగామ తస్యానేకే శిష్యా అన్యే చ లోకాస్తేన సార్ద్ధం యయుః|</para>
  <para style="p">
    <verse number="12" style="v"/>తేషు తన్నగరస్య ద్వారసన్నిధిం ప్రాప్తేషు కియన్తో లోకా ఏకం మృతమనుజం వహన్తో నగరస్య బహిర్యాన్తి, స తన్మాతురేకపుత్రస్తన్మాతా చ విధవా; తయా సార్ద్ధం తన్నగరీయా బహవో లోకా ఆసన్|</para>
  <para style="p">
    <verse number="13" style="v"/>ప్రభుస్తాం విలోక్య సానుకమ్పః కథయామాస, మా రోదీః| స సమీపమిత్వా ఖట్వాం పస్పర్శ తస్మాద్ వాహకాః స్థగితాస్తమ్యుః;</para>
  <para style="p">
    <verse number="14" style="v"/>తదా స ఉవాచ హే యువమనుష్య త్వముత్తిష్ఠ, త్వామహమ్ ఆజ్ఞాపయామి|</para>
  <para style="p">
    <verse number="15" style="v"/>తస్మాత్ స మృతో జనస్తత్క్షణముత్థాయ కథాం ప్రకథితః; తతో యీశుస్తస్య మాతరి తం సమర్పయామాస|</para>
  <para style="p">
    <verse number="16" style="v"/>తస్మాత్ సర్వ్వే లోకాః శశఙ్కిరే; ఏకో మహాభవిష్యద్వాదీ మధ్యేఽస్మాకమ్ సముదైత్, ఈశ్వరశ్చ స్వలోకానన్వగృహ్లాత్ కథామిమాం కథయిత్వా ఈశ్వరం ధన్యం జగదుః|</para>
  <para style="p">
    <verse number="17" style="v"/>తతః పరం సమస్తం యిహూదాదేశం తస్య చతుర్దిక్స్థదేశఞ్చ తస్యైతత్కీర్త్తి ర్వ్యానశే|</para>
  <para style="p">
    <verse number="18" style="v"/>తతః పరం యోహనః శిష్యేషు తం తద్వృత్తాన్తం జ్ఞాపితవత్సు</para>
  <para style="p">
    <verse number="19" style="v"/>స స్వశిష్యాణాం ద్వౌ జనావాహూయ యీశుం ప్రతి వక్ష్యమాణం వాక్యం వక్తుం ప్రేషయామాస, యస్యాగమనమ్ అపేక్ష్య తిష్ఠామో వయం కిం స ఏవ జనస్త్వం? కిం వయమన్యమపేక్ష్య స్థాస్యామః?</para>
  <para style="p">
    <verse number="20" style="v"/>పశ్చాత్తౌ మానవౌ గత్వా కథయామాసతుః, యస్యాగమనమ్ అపేక్ష్య తిష్ఠామో వయం, కిం సఏవ జనస్త్వం? కిం వయమన్యమపేక్ష్య స్థాస్యామః? కథామిమాం తుభ్యం కథయితుం యోహన్ మజ్జక ఆవాం ప్రేషితవాన్|</para>
  <para style="p">
    <verse number="21" style="v"/>తస్మిన్ దణ్డే యీశూరోగిణో మహావ్యాధిమతో దుష్టభూతగ్రస్తాంశ్చ బహూన్ స్వస్థాన్ కృత్వా, అనేకాన్ధేభ్యశ్చక్షుంషి దత్త్వా ప్రత్యువాచ,</para>
  <para style="p">
    <verse number="22" style="v"/>యువాం వ్రజతమ్ అన్ధా నేత్రాణి ఖఞ్జాశ్చరణాని చ ప్రాప్నువన్తి, కుష్ఠినః పరిష్క్రియన్తే, బధిరాః శ్రవణాని మృతాశ్చ జీవనాని ప్రాప్నువన్తి, దరిద్రాణాం సమీపేషు సుసంవాదః ప్రచార్య్యతే, యం ప్రతి విఘ్నస్వరూపోహం న భవామి స ధన్యః,</para>
  <para style="p">
    <verse number="23" style="v"/>ఏతాని యాని పశ్యథః శృణుథశ్చ తాని యోహనం జ్ఞాపయతమ్|</para>
  <para style="p">
    <verse number="24" style="v"/>తయో ర్దూతయో ర్గతయోః సతో ర్యోహని స లోకాన్ వక్తుముపచక్రమే, యూయం మధ్యేప్రాన్తరం కిం ద్రష్టుం నిరగమత? కిం వాయునా కమ్పితం నడం?</para>
  <para style="p">
    <verse number="25" style="v"/>యూయం కిం ద్రష్టుం నిరగమత? కిం సూక్ష్మవస్త్రపరిధాయినం కమపి నరం? కిన్తు యే సూక్ష్మమృదువస్త్రాణి పరిదధతి సూత్తమాని ద్రవ్యాణి భుఞ్జతే చ తే రాజధానీషు తిష్ఠన్తి|</para>
  <para style="p">
    <verse number="26" style="v"/>తర్హి యూయం కిం ద్రష్టుం నిరగమత? కిమేకం భవిష్యద్వాదినం? తదేవ సత్యం కిన్తు స పుమాన్ భవిష్యద్వాదినోపి శ్రేష్ఠ ఇత్యహం యుష్మాన్ వదామి;</para>
  <para style="p">
    <verse number="27" style="v"/>పశ్య స్వకీయదూతన్తు తవాగ్ర ప్రేషయామ్యహం| గత్వా త్వదీయమార్గన్తు స హి పరిష్కరిష్యతి| యదర్థే లిపిరియమ్ ఆస్తే స ఏవ యోహన్|</para>
  <para style="p">
    <verse number="28" style="v"/>అతో యుష్మానహం వదామి స్త్రియా గర్బ్భజాతానాం భవిష్యద్వాదినాం మధ్యే యోహనో మజ్జకాత్ శ్రేష్ఠః కోపి నాస్తి, తత్రాపి ఈశ్వరస్య రాజ్యే యః సర్వ్వస్మాత్ క్షుద్రః స యోహనోపి శ్రేష్ఠః|</para>
  <para style="p">
    <verse number="29" style="v"/>అపరఞ్చ సర్వ్వే లోకాః కరమఞ్చాయినశ్చ తస్య వాక్యాని శ్రుత్వా యోహనా మజ్జనేన మజ్జితాః పరమేశ్వరం నిర్దోషం మేనిరే|</para>
  <para style="p">
    <verse number="30" style="v"/>కిన్తు ఫిరూశినో వ్యవస్థాపకాశ్చ తేన న మజ్జితాః స్వాన్ ప్రతీశ్వరస్యోపదేశం నిష్ఫలమ్ అకుర్వ్వన్|</para>
  <para style="p">
    <verse number="31" style="v"/>అథ ప్రభుః కథయామాస, ఇదానీన్తనజనాన్ కేనోపమామి? తే కస్య సదృశాః?</para>
  <para style="p">
    <verse number="32" style="v"/>యే బాలకా విపణ్యామ్ ఉపవిశ్య పరస్పరమ్ ఆహూయ వాక్యమిదం వదన్తి, వయం యుష్మాకం నికటే వంశీరవాదిష్మ, కిన్తు యూయం నానర్త్తిష్ట, వయం యుష్మాకం నికట అరోదిష్మ, కిన్తు యుయం న వ్యలపిష్ట, బాలకైరేతాదృశైస్తేషామ్ ఉపమా భవతి|</para>
  <para style="p">
    <verse number="33" style="v"/>యతో యోహన్ మజ్జక ఆగత్య పూపం నాఖాదత్ ద్రాక్షారసఞ్చ నాపివత్ తస్మాద్ యూయం వదథ, భూతగ్రస్తోయమ్|</para>
  <para style="p">
    <verse number="34" style="v"/>తతః పరం మానవసుత ఆగత్యాఖాదదపివఞ్చ తస్మాద్ యూయం వదథ, ఖాదకః సురాపశ్చాణ్డాలపాపినాం బన్ధురేకో జనో దృశ్యతామ్|</para>
  <para style="p">
    <verse number="35" style="v"/>కిన్తు జ్ఞానినో జ్ఞానం నిర్దోషం విదుః|</para>
  <para style="p">
    <verse number="36" style="v"/>పశ్చాదేకః ఫిరూశీ యీశుం భోజనాయ న్యమన్త్రయత్ తతః స తస్య గృహం గత్వా భోక్తుముపవిష్టః|</para>
  <para style="p">
    <verse number="37" style="v"/>ఏతర్హి తత్ఫిరూశినో గృహే యీశు ర్భేక్తుమ్ ఉపావేక్షీత్ తచ్ఛ్రుత్వా తన్నగరవాసినీ కాపి దుష్టా నారీ పాణ్డరప్రస్తరస్య సమ్పుటకే సుగన్ధితైలమ్ ఆనీయ</para>
  <para style="p">
    <verse number="38" style="v"/>తస్య పశ్చాత్ పాదయోః సన్నిధౌ తస్యౌ రుదతీ చ నేత్రామ్బుభిస్తస్య చరణౌ ప్రక్షాల్య నిజకచైరమార్క్షీత్, తతస్తస్య చరణౌ చుమ్బిత్వా తేన సుగన్ధితైలేన మమర్ద|</para>
  <para style="p">
    <verse number="39" style="v"/>తస్మాత్ స నిమన్త్రయితా ఫిరూశీ మనసా చిన్తయామాస, యద్యయం భవిష్యద్వాదీ భవేత్ తర్హి ఏనం స్పృశతి యా స్త్రీ సా కా కీదృశీ చేతి జ్ఞాతుం శక్నుయాత్ యతః సా దుష్టా|</para>
  <para style="p">
    <verse number="40" style="v"/>తదా యాశుస్తం జగాద, హే శిమోన్ త్వాం ప్రతి మమ కిఞ్చిద్ వక్తవ్యమస్తి; తస్మాత్ స బభాషే, హే గురో తద్ వదతు|</para>
  <para style="p">
    <verse number="41" style="v"/>ఏకోత్తమర్ణస్య ద్వావధమర్ణావాస్తాం, తయోరేకః పఞ్చశతాని ముద్రాపాదాన్ అపరశ్చ పఞ్చాశత్ ముద్రాపాదాన్ ధారయామాస|</para>
  <para style="p">
    <verse number="42" style="v"/>తదనన్తరం తయోః శోధ్యాభావాత్ స ఉత్తమర్ణస్తయో రృణే చక్షమే; తస్మాత్ తయోర్ద్వయోః కస్తస్మిన్ ప్రేష్యతే బహు? తద్ బ్రూహి|</para>
  <para style="p">
    <verse number="43" style="v"/>శిమోన్ ప్రత్యువాచ, మయా బుధ్యతే యస్యాధికమ్ ఋణం చక్షమే స ఇతి; తతో యీశుస్తం వ్యాజహార, త్వం యథార్థం వ్యచారయః|</para>
  <para style="p">
    <verse number="44" style="v"/>అథ తాం నారీం ప్రతి వ్యాఘుఠ్య శిమోనమవోచత్, స్త్రీమిమాం పశ్యసి? తవ గృహే మయ్యాగతే త్వం పాదప్రక్షాలనార్థం జలం నాదాః కిన్తు యోషిదేషా నయనజలై ర్మమ పాదౌ ప్రక్షాల్య కేశైరమార్క్షీత్|</para>
  <para style="p">
    <verse number="45" style="v"/>త్వం మాం నాచుమ్బీః కిన్తు యోషిదేషా స్వీయాగమనాదారభ్య మదీయపాదౌ చుమ్బితుం న వ్యరంస్త|</para>
  <para style="p">
    <verse number="46" style="v"/>త్వఞ్చ మదీయోత్తమాఙ్గే కిఞ్చిదపి తైలం నామర్దీః కిన్తు యోషిదేషా మమ చరణౌ సుగన్ధితైలేనామర్ద్దీత్|</para>
  <para style="p">
    <verse number="47" style="v"/>అతస్త్వాం వ్యాహరామి, ఏతస్యా బహు పాపమక్షమ్యత తతో బహు ప్రీయతే కిన్తు యస్యాల్పపాపం క్షమ్యతే సోల్పం ప్రీయతే|</para>
  <para style="p">
    <verse number="48" style="v"/>తతః పరం స తాం బభాషే, త్వదీయం పాపమక్షమ్యత|</para>
  <para style="p">
    <verse number="49" style="v"/>తదా తేన సార్ద్ధం యే భోక్తుమ్ ఉపవివిశుస్తే పరస్పరం వక్తుమారేభిరే, అయం పాపం క్షమతే క ఏషః?</para>
  <para style="p">
    <verse number="50" style="v"/>కిన్తు స తాం నారీం జగాద, తవ విశ్వాసస్త్వాం పర్య్యత్రాస్త త్వం క్షేమేణ వ్రజ|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అపరఞ్చ యీశు ర్ద్వాదశభిః శిష్యైః సార్ద్ధం నానానగరేషు నానాగ్రామేషు చ గచ్ఛన్ ఇశ్వరీయరాజత్వస్య సుసంవాదం ప్రచారయితుం ప్రారేభే|</para>
  <para style="p">
    <verse number="2" style="v"/>తదా యస్యాః సప్త భూతా నిరగచ్ఛన్ సా మగ్దలీనీతి విఖ్యాతా మరియమ్ హేరోద్రాజస్య గృహాధిపతేః హోషే ర్భార్య్యా యోహనా శూశానా</para>
  <para style="p">
    <verse number="3" style="v"/>ప్రభృతయో యా బహ్వ్యః స్త్రియః దుష్టభూతేభ్యో రోగేభ్యశ్చ ముక్తాః సత్యో నిజవిభూతీ ర్వ్యయిత్వా తమసేవన్త, తాః సర్వ్వాస్తేన సార్ద్ధమ్ ఆసన్|</para>
  <para style="p">
    <verse number="4" style="v"/>అనన్తరం నానానగరేభ్యో బహవో లోకా ఆగత్య తస్య సమీపేఽమిలన్, తదా స తేభ్య ఏకాం దృష్టాన్తకథాం కథయామాస| ఏకః కృషీబలో బీజాని వప్తుం బహిర్జగామ,</para>
  <para style="p">
    <verse number="5" style="v"/>తతో వపనకాలే కతిపయాని బీజాని మార్గపార్శ్వే పేతుః, తతస్తాని పదతలై ర్దలితాని పక్షిభి ర్భక్షితాని చ|</para>
  <para style="p">
    <verse number="6" style="v"/>కతిపయాని బీజాని పాషాణస్థలే పతితాని యద్యపి తాన్యఙ్కురితాని తథాపి రసాభావాత్ శుశుషుః|</para>
  <para style="p">
    <verse number="7" style="v"/>కతిపయాని బీజాని కణ్టకివనమధ్యే పతితాని తతః కణ్టకివనాని సంవృద్ధ్య తాని జగ్రసుః|</para>
  <para style="p">
    <verse number="8" style="v"/>తదన్యాని కతిపయబీజాని చ భూమ్యాముత్తమాయాం పేతుస్తతస్తాన్యఙ్కురయిత్వా శతగుణాని ఫలాని ఫేలుః| స ఇమా కథాం కథయిత్వా ప్రోచ్చైః ప్రోవాచ, యస్య శ్రోతుం శ్రోత్రే స్తః స శృణోతు|</para>
  <para style="p">
    <verse number="9" style="v"/>తతః పరం శిష్యాస్తం పప్రచ్ఛురస్య దృష్టాన్తస్య కిం తాత్పర్య్యం?</para>
  <para style="p">
    <verse number="10" style="v"/>తతః స వ్యాజహార, ఈశ్వరీయరాజ్యస్య గుహ్యాని జ్ఞాతుం యుష్మభ్యమధికారో దీయతే కిన్త్వన్యే యథా దృష్ట్వాపి న పశ్యన్తి శ్రుత్వాపి మ బుధ్యన్తే చ తదర్థం తేషాం పురస్తాత్ తాః సర్వ్వాః కథా దృష్టాన్తేన కథ్యన్తే|</para>
  <para style="p">
    <verse number="11" style="v"/>దృష్టాన్తస్యాస్యాభిప్రాయః, ఈశ్వరీయకథా బీజస్వరూపా|</para>
  <para style="p">
    <verse number="12" style="v"/>యే కథామాత్రం శృణ్వన్తి కిన్తు పశ్చాద్ విశ్వస్య యథా పరిత్రాణం న ప్రాప్నువన్తి తదాశయేన శైతానేత్య హృదయాతృ తాం కథామ్ అపహరతి త ఏవ మార్గపార్శ్వస్థభూమిస్వరూపాః|</para>
  <para style="p">
    <verse number="13" style="v"/>యే కథం శ్రుత్వా సానన్దం గృహ్లన్తి కిన్త్వబద్ధమూలత్వాత్ స్వల్పకాలమాత్రం ప్రతీత్య పరీక్షాకాలే భ్రశ్యన్తి తఏవ పాషాణభూమిస్వరూపాః|</para>
  <para style="p">
    <verse number="14" style="v"/>యే కథాం శ్రుత్వా యాన్తి విషయచిన్తాయాం ధనలోభేన ఏेహికసుఖే చ మజ్జన్త ఉపయుక్తఫలాని న ఫలన్తి త ఏవోప్తబీజకణ్టకిభూస్వరూపాః|</para>
  <para style="p">
    <verse number="15" style="v"/>కిన్తు యే శ్రుత్వా సరలైః శుద్ధైశ్చాన్తఃకరణైః కథాం గృహ్లన్తి ధైర్య్యమ్ అవలమ్బ్య ఫలాన్యుత్పాదయన్తి చ త ఏవోత్తమమృత్స్వరూపాః|</para>
  <para style="p">
    <verse number="16" style="v"/>అపరఞ్చ ప్రదీపం ప్రజ్వాల్య కోపి పాత్రేణ నాచ్ఛాదయతి తథా ఖట్వాధోపి న స్థాపయతి, కిన్తు దీపాధారోపర్య్యేవ స్థాపయతి, తస్మాత్ ప్రవేశకా దీప్తిం పశ్యన్తి|</para>
  <para style="p">
    <verse number="17" style="v"/>యన్న ప్రకాశయిష్యతే తాదృగ్ అప్రకాశితం వస్తు కిమపి నాస్తి యచ్చ న సువ్యక్తం ప్రచారయిష్యతే తాదృగ్ గృప్తం వస్తు కిమపి నాస్తి|</para>
  <para style="p">
    <verse number="18" style="v"/>అతో యూయం కేన ప్రకారేణ శృణుథ తత్ర సావధానా భవత, యస్య సమీపే బర్ద్ధతే తస్మై పునర్దాస్యతే కిన్తు యస్యాశ్రయే న బర్ద్ధతే తస్య యద్యదస్తి తదపి తస్మాత్ నేష్యతే|</para>
  <para style="p">
    <verse number="19" style="v"/>అపరఞ్చ యీశో ర్మాతా భ్రాతరశ్చ తస్య సమీపం జిగమిషవః</para>
  <para style="p">
    <verse number="20" style="v"/>కిన్తు జనతాసమ్బాధాత్ తత్సన్నిధిం ప్రాప్తుం న శేకుః| తత్పశ్చాత్ తవ మాతా భ్రాతరశ్చ త్వాం సాక్షాత్ చికీర్షన్తో బహిస్తిష్ఠనతీతి వార్త్తాయాం తస్మై కథితాయాం</para>
  <para style="p">
    <verse number="21" style="v"/>స ప్రత్యువాచ; యే జనా ఈశ్వరస్య కథాం శ్రుత్వా తదనురూపమాచరన్తి తఏవ మమ మాతా భ్రాతరశ్చ|</para>
  <para style="p">
    <verse number="22" style="v"/>అనన్తరం ఏకదా యీశుః శిష్యైః సార్ద్ధం నావమారుహ్య జగాద, ఆయాత వయం హ్రదస్య పారం యామః, తతస్తే జగ్ముః|</para>
  <para style="p">
    <verse number="23" style="v"/>తేషు నౌకాం వాహయత్సు స నిదద్రౌ;</para>
  <para style="p">
    <verse number="24" style="v"/>అథాకస్మాత్ ప్రబలఝఞ్భ్శగమాద్ హ్రదే నౌకాయాం తరఙ్గైరాచ్ఛన్నాయాం విపత్ తాన్ జగ్రాస| తస్మాద్ యీశోరన్తికం గత్వా హే గురో హే గురో ప్రాణా నో యాన్తీతి గదిత్వా తం జాగరయామ్బభూవుః| తదా స ఉత్థాయ వాయుం తరఙ్గాంశ్చ తర్జయామాస తస్మాదుభౌ నివృత్య స్థిరౌ బభూవతుః|</para>
  <para style="p">
    <verse number="25" style="v"/>స తాన్ బభాషే యుష్మాకం విశ్వాసః క? తస్మాత్తే భీతా విస్మితాశ్చ పరస్పరం జగదుః, అహో కీదృగయం మనుజః పవనం పానీయఞ్చాదిశతి తదుభయం తదాదేశం వహతి|</para>
  <para style="p">
    <verse number="26" style="v"/>తతః పరం గాలీల్ప్రదేశస్య సమ్ముఖస్థగిదేరీయప్రదేశే నౌకాయాం లగన్త్యాం తటేఽవరోహమావాద్</para>
  <para style="p">
    <verse number="27" style="v"/>బహుతిథకాలం భూతగ్రస్త ఏకో మానుషః పురాదాగత్య తం సాక్షాచ్చకార| స మనుషో వాసో న పరిదధత్ గృహే చ న వసన్ కేవలం శ్మశానమ్ అధ్యువాస|</para>
  <para style="p">
    <verse number="28" style="v"/>స యీశుం దృష్ట్వైవ చీచ్ఛబ్దం చకార తస్య సమ్ముఖే పతిత్వా ప్రోచ్చైర్జగాద చ, హే సర్వ్వప్రధానేశ్వరస్య పుత్ర, మయా సహ తవ కః సమ్బన్ధః? త్వయి వినయం కరోమి మాం మా యాతయ|</para>
  <para style="p">
    <verse number="29" style="v"/>యతః స తం మానుషం త్యక్త్వా యాతుమ్ అమేధ్యభూతమ్ ఆదిదేశ; స భూతస్తం మానుషమ్ అసకృద్ దధార తస్మాల్లోకాః శృఙ్ఖలేన నిగడేన చ బబన్ధుః; స తద్ భంక్త్వా భూతవశత్వాత్ మధ్యేప్రాన్తరం యయౌ|</para>
  <para style="p">
    <verse number="30" style="v"/>అనన్తరం యీశుస్తం పప్రచ్ఛ తవ కిన్నామ? స ఉవాచ, మమ నామ బాహినో యతో బహవో భూతాస్తమాశిశ్రియుః|</para>
  <para style="p">
    <verse number="31" style="v"/>అథ భూతా వినయేన జగదుః, గభీరం గర్త్తం గన్తుం మాజ్ఞాపయాస్మాన్|</para>
  <para style="p">
    <verse number="32" style="v"/>తదా పర్వ్వతోపరి వరాహవ్రజశ్చరతి తస్మాద్ భూతా వినయేన ప్రోచుః, అముం వరాహవ్రజమ్ ఆశ్రయితుమ్ అస్మాన్ అనుజానీహి; తతః సోనుజజ్ఞౌ|</para>
  <para style="p">
    <verse number="33" style="v"/>తతః పరం భూతాస్తం మానుషం విహాయ వరాహవ్రజమ్ ఆశిశ్రియుః వరాహవ్రజాశ్చ తత్క్షణాత్ కటకేన ధావన్తో హ్రదే ప్రాణాన్ విజృహుః|</para>
  <para style="p">
    <verse number="34" style="v"/>తద్ దృష్ట్వా శూకరరక్షకాః పలాయమానా నగరం గ్రామఞ్చ గత్వా తత్సర్వ్వవృత్తాన్తం కథయామాసుః|</para>
  <para style="p">
    <verse number="35" style="v"/>తతః కిం వృత్తమ్ ఏతద్దర్శనార్థం లోకా నిర్గత్య యీశోః సమీపం యయుః, తం మానుషం త్యక్తభూతం పరిహితవస్త్రం స్వస్థమానుషవద్ యీశోశ్చరణసన్నిధౌ సూపవిశన్తం విలోక్య బిభ్యుః|</para>
  <para style="p">
    <verse number="36" style="v"/>యే లోకాస్తస్య భూతగ్రస్తస్య స్వాస్థ్యకరణం దదృశుస్తే తేభ్యః సర్వ్వవృత్తాన్తం కథయామాసుః|</para>
  <para style="p">
    <verse number="37" style="v"/>తదనన్తరం తస్య గిదేరీయప్రదేశస్య చతుర్దిక్స్థా బహవో జనా అతిత్రస్తా వినయేన తం జగదుః, భవాన్ అస్మాకం నికటాద్ వ్రజతు తస్మాత్ స నావమారుహ్య తతో వ్యాఘుట్య జగామ|</para>
  <para style="p">
    <verse number="38" style="v"/>తదానీం త్యక్తభూతమనుజస్తేన సహ స్థాతుం ప్రార్థయాఞ్చక్రే</para>
  <para style="p">
    <verse number="39" style="v"/>కిన్తు తదర్థమ్ ఈశ్వరః కీదృఙ్మహాకర్మ్మ కృతవాన్ ఇతి నివేశనం గత్వా విజ్ఞాపయ, యీశుః కథామేతాం కథయిత్వా తం విససర్జ| తతః స వ్రజిత్వా యీశుస్తదర్థం యన్మహాకర్మ్మ చకార తత్ పురస్య సర్వ్వత్ర ప్రకాశయితుం ప్రారేభే|</para>
  <para style="p">
    <verse number="40" style="v"/>అథ యీశౌ పరావృత్యాగతే లోకాస్తం ఆదరేణ జగృహు ర్యస్మాత్తే సర్వ్వే తమపేక్షాఞ్చక్రిరే|</para>
  <para style="p">
    <verse number="41" style="v"/>తదనన్తరం యాయీర్నామ్నో భజనగేహస్యైకోధిప ఆగత్య యీశోశ్చరణయోః పతిత్వా స్వనివేశనాగమనార్థం తస్మిన్ వినయం చకార,</para>
  <para style="p">
    <verse number="42" style="v"/>యతస్తస్య ద్వాదశవర్షవయస్కా కన్యైకాసీత్ సా మృతకల్పాభవత్| తతస్తస్య గమనకాలే మార్గే లోకానాం మహాన్ సమాగమో బభూవ|</para>
  <para style="p">
    <verse number="43" style="v"/>ద్వాదశవర్షాణి ప్రదరరోగగ్రస్తా నానా వైద్యైశ్చికిత్సితా సర్వ్వస్వం వ్యయిత్వాపి స్వాస్థ్యం న ప్రాప్తా యా యోషిత్ సా యీశోః పశ్చాదాగత్య తస్య వస్త్రగ్రన్థిం పస్పర్శ|</para>
  <para style="p">
    <verse number="44" style="v"/>తస్మాత్ తత్క్షణాత్ తస్యా రక్తస్రావో రుద్ధః|</para>
  <para style="p">
    <verse number="45" style="v"/>తదానీం యీశురవదత్ కేనాహం స్పృష్టః? తతోఽనేకైరనఙ్గీకృతే పితరస్తస్య సఙ్గినశ్చావదన్, హే గురో లోకా నికటస్థాః సన్తస్తవ దేహే ఘర్షయన్తి, తథాపి కేనాహం స్పృష్టఇతి భవాన్ కుతః పృచ్ఛతి?</para>
  <para style="p">
    <verse number="46" style="v"/>యీశుః కథయామాస, కేనాప్యహం స్పృష్టో, యతో మత్తః శక్తి ర్నిర్గతేతి మయా నిశ్చితమజ్ఞాయి|</para>
  <para style="p">
    <verse number="47" style="v"/>తదా సా నారీ స్వయం న గుప్తేతి విదిత్వా కమ్పమానా సతీ తస్య సమ్ముఖే పపాత; యేన నిమిత్తేన తం పస్పర్శ స్పర్శమాత్రాచ్చ యేన ప్రకారేణ స్వస్థాభవత్ తత్ సర్వ్వం తస్య సాక్షాదాచఖ్యౌ|</para>
  <para style="p">
    <verse number="48" style="v"/>తతః స తాం జగాద హే కన్యే సుస్థిరా భవ, తవ విశ్వాసస్త్వాం స్వస్థామ్ అకార్షీత్ త్వం క్షేమేణ యాహి|</para>
  <para style="p">
    <verse number="49" style="v"/>యీశోరేతద్వాక్యవదనకాలే తస్యాధిపతే ర్నివేశనాత్ కశ్చిల్లోక ఆగత్య తం బభాషే, తవ కన్యా మృతా గురుం మా క్లిశాన|</para>
  <para style="p">
    <verse number="50" style="v"/>కిన్తు యీశుస్తదాకర్ణ్యాధిపతిం వ్యాజహార, మా భైషీః కేవలం విశ్వసిహి తస్మాత్ సా జీవిష్యతి|</para>
  <para style="p">
    <verse number="51" style="v"/>అథ తస్య నివేశనే ప్రాప్తే స పితరం యోహనం యాకూబఞ్చ కన్యాయా మాతరం పితరఞ్చ వినా, అన్యం కఞ్చన ప్రవేష్టుం వారయామాస|</para>
  <para style="p">
    <verse number="52" style="v"/>అపరఞ్చ యే రుదన్తి విలపన్తి చ తాన్ సర్వ్వాన్ జనాన్ ఉవాచ, యూయం మా రోదిష్ట కన్యా న మృతా నిద్రాతి|</para>
  <para style="p">
    <verse number="53" style="v"/>కిన్తు సా నిశ్చితం మృతేతి జ్ఞాత్వా తే తముపజహసుః|</para>
  <para style="p">
    <verse number="54" style="v"/>పశ్చాత్ స సర్వ్వాన్ బహిః కృత్వా కన్యాయాః కరౌ ధృత్వాజుహువే, హే కన్యే త్వముత్తిష్ఠ,</para>
  <para style="p">
    <verse number="55" style="v"/>తస్మాత్ తస్యాః ప్రాణేషు పునరాగతేషు సా తత్క్షణాద్ ఉత్తస్యౌ| తదానీం తస్యై కిఞ్చిద్ భక్ష్యం దాతుమ్ ఆదిదేశ|</para>
  <para style="p">
    <verse number="56" style="v"/>తతస్తస్యాః పితరౌ విస్మయం గతౌ కిన్తు స తావాదిదేశ ఘటనాయా ఏతస్యాః కథాం కస్మైచిదపి మా కథయతం|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>తతః పరం స ద్వాదశశిష్యానాహూయ భూతాన్ త్యాజయితుం రోగాన్ ప్రతికర్త్తుఞ్చ తేభ్యః శక్తిమాధిపత్యఞ్చ దదౌ|</para>
  <para style="p">
    <verse number="2" style="v"/>అపరఞ్చ ఈశ్వరీయరాజ్యస్య సుసంవాదం ప్రకాశయితుమ్ రోగిణామారోగ్యం కర్త్తుఞ్చ ప్రేరణకాలే తాన్ జగాద|</para>
  <para style="p">
    <verse number="3" style="v"/>యాత్రార్థం యష్టి ర్వస్త్రపుటకం భక్ష్యం ముద్రా ద్వితీయవస్త్రమ్, ఏషాం కిమపి మా గృహ్లీత|</para>
  <para style="p">
    <verse number="4" style="v"/>యూయఞ్చ యన్నివేశనం ప్రవిశథ నగరత్యాగపర్య్యనతం తన్నివేశనే తిష్ఠత|</para>
  <para style="p">
    <verse number="5" style="v"/>తత్ర యది కస్యచిత్ పురస్య లోకా యుష్మాకమాతిథ్యం న కుర్వ్వన్తి తర్హి తస్మాన్నగరాద్ గమనకాలే తేషాం విరుద్ధం సాక్ష్యార్థం యుష్మాకం పదధూలీః సమ్పాతయత|</para>
  <para style="p">
    <verse number="6" style="v"/>అథ తే ప్రస్థాయ సర్వ్వత్ర సుసంవాదం ప్రచారయితుం పీడితాన్ స్వస్థాన్ కర్త్తుఞ్చ గ్రామేషు భ్రమితుం ప్రారేభిరే|</para>
  <para style="p">
    <verse number="7" style="v"/>ఏతర్హి హేరోద్ రాజా యీశోః సర్వ్వకర్మ్మణాం వార్త్తాం శ్రుత్వా భృశముద్వివిజే</para>
  <para style="p">
    <verse number="8" style="v"/>యతః కేచిదూచుర్యోహన్ శ్మశానాదుదతిష్ఠత్| కేచిదూచుః, ఏలియో దర్శనం దత్తవాన్; ఏవమన్యలోకా ఊచుః పూర్వ్వీయః కశ్చిద్ భవిష్యద్వాదీ సముత్థితః|</para>
  <para style="p">
    <verse number="9" style="v"/>కిన్తు హేరోదువాచ యోహనః శిరోఽహమఛినదమ్ ఇదానీం యస్యేదృక్కర్మ్మణాం వార్త్తాం ప్రాప్నోమి స కః? అథ స తం ద్రష్టుమ్ ఐచ్ఛత్|</para>
  <para style="p">
    <verse number="10" style="v"/>అనన్తరం ప్రేరితాః ప్రత్యాగత్య యాని యాని కర్మ్మాణి చక్రుస్తాని యీశవే కథయామాసుః తతః స తాన్ బైత్సైదానామకనగరస్య విజనం స్థానం నీత్వా గుప్తం జగామ|</para>
  <para style="p">
    <verse number="11" style="v"/>పశ్చాల్ లోకాస్తద్ విదిత్వా తస్య పశ్చాద్ యయుః; తతః స తాన్ నయన్ ఈశ్వరీయరాజ్యస్య ప్రసఙ్గముక్తవాన్, యేషాం చికిత్సయా ప్రయోజనమ్ ఆసీత్ తాన్ స్వస్థాన్ చకార చ|</para>
  <para style="p">
    <verse number="12" style="v"/>అపరఞ్చ దివావసన్నే సతి ద్వాదశశిష్యా యీశోరన్తికమ్ ఏత్య కథయామాసుః, వయమత్ర ప్రాన్తరస్థానే తిష్ఠామః, తతో నగరాణి గ్రామాణి గత్వా వాసస్థానాని ప్రాప్య భక్ష్యద్రవ్యాణి క్రేతుం జననివహం భవాన్ విసృజతు|</para>
  <para style="p">
    <verse number="13" style="v"/>తదా స ఉవాచ, యూయమేవ తాన్ భేజయధ్వం; తతస్తే ప్రోచురస్మాకం నికటే కేవలం పఞ్చ పూపా ద్వౌ మత్స్యౌ చ విద్యన్తే, అతఏవ స్థానాన్తరమ్ ఇత్వా నిమిత్తమేతేషాం భక్ష్యద్రవ్యేషు న క్రీతేషు న భవతి|</para>
  <para style="p">
    <verse number="14" style="v"/>తత్ర ప్రాయేణ పఞ్చసహస్రాణి పురుషా ఆసన్|</para>
  <para style="p">
    <verse number="15" style="v"/>తదా స శిష్యాన్ జగాద పఞ్చాశత్ పఞ్చాశజ్జనైః పంక్తీకృత్య తానుపవేశయత, తస్మాత్ తే తదనుసారేణ సర్వ్వలోకానుపవేశయాపాసుః|</para>
  <para style="p">
    <verse number="16" style="v"/>తతః స తాన్ పఞ్చ పూపాన్ మీనద్వయఞ్చ గృహీత్వా స్వర్గం విలోక్యేశ్వరగుణాన్ కీర్త్తయాఞ్చక్రే భఙ్క్తా చ లోకేభ్యః పరివేషణార్థం శిష్యేషు సమర్పయామ్బభూవ|</para>
  <para style="p">
    <verse number="17" style="v"/>తతః సర్వ్వే భుక్త్వా తృప్తిం గతా అవశిష్టానాఞ్చ ద్వాదశ డల్లకాన్ సంజగృహుః|</para>
  <para style="p">
    <verse number="18" style="v"/>అథైకదా నిర్జనే శిష్యైః సహ ప్రార్థనాకాలే తాన్ పప్రచ్ఛ, లోకా మాం కం వదన్తి?</para>
  <para style="p">
    <verse number="19" style="v"/>తతస్తే ప్రాచుః, త్వాం యోహన్మజ్జకం వదన్తి; కేచిత్ త్వామ్ ఏలియం వదన్తి, పూర్వ్వకాలికః కశ్చిద్ భవిష్యద్వాదీ శ్మశానాద్ ఉదతిష్ఠద్ ఇత్యపి కేచిద్ వదన్తి|</para>
  <para style="p">
    <verse number="20" style="v"/>తదా స ఉవాచ, యూయం మాం కం వదథ? తతః పితర ఉక్తవాన్ త్వమ్ ఈశ్వరాభిషిక్తః పురుషః|</para>
  <para style="p">
    <verse number="21" style="v"/>తదా స తాన్ దృఢమాదిదేశ, కథామేతాం కస్మైచిదపి మా కథయత|</para>
  <para style="p">
    <verse number="22" style="v"/>స పునరువాచ, మనుష్యపుత్రేణ వహుయాతనా భోక్తవ్యాః ప్రాచీనలోకైః ప్రధానయాజకైరధ్యాపకైశ్చ సోవజ్ఞాయ హన్తవ్యః కిన్తు తృతీయదివసే శ్మశానాత్ తేనోత్థాతవ్యమ్|</para>
  <para style="p">
    <verse number="23" style="v"/>అపరం స సర్వ్వానువాచ, కశ్చిద్ యది మమ పశ్చాద్ గన్తుం వాఞ్ఛతి తర్హి స స్వం దామ్యతు, దినే దినే క్రుశం గృహీత్వా చ మమ పశ్చాదాగచ్ఛతు|</para>
  <para style="p">
    <verse number="24" style="v"/>యతో యః కశ్చిత్ స్వప్రాణాన్ రిరక్షిషతి స తాన్ హారయిష్యతి, యః కశ్చిన్ మదర్థం ప్రాణాన్ హారయిష్యతి స తాన్ రక్షిష్యతి|</para>
  <para style="p">
    <verse number="25" style="v"/>కశ్చిద్ యది సర్వ్వం జగత్ ప్రాప్నోతి కిన్తు స్వప్రాణాన్ హారయతి స్వయం వినశ్యతి చ తర్హి తస్య కో లాభః?</para>
  <para style="p">
    <verse number="26" style="v"/>పున ర్యః కశ్చిన్ మాం మమ వాక్యం వా లజ్జాస్పదం జానాతి మనుష్యపుత్రో యదా స్వస్య పితుశ్చ పవిత్రాణాం దూతానాఞ్చ తేజోభిః పరివేష్టిత ఆగమిష్యతి తదా సోపి తం లజ్జాస్పదం జ్ఞాస్యతి|</para>
  <para style="p">
    <verse number="27" style="v"/>కిన్తు యుష్మానహం యథార్థం వదామి, ఈశ్వరీయరాజత్వం న దృష్టవా మృత్యుం నాస్వాదిష్యన్తే, ఏతాదృశాః కియన్తో లోకా అత్ర స్థనేఽపి దణ్డాయమానాః సన్తి|</para>
  <para style="p">
    <verse number="28" style="v"/>ఏతదాఖ్యానకథనాత్ పరం ప్రాయేణాష్టసు దినేషు గతేషు స పితరం యోహనం యాకూబఞ్చ గృహీత్వా ప్రార్థయితుం పర్వ్వతమేకం సమారురోహ|</para>
  <para style="p">
    <verse number="29" style="v"/>అథ తస్య ప్రార్థనకాలే తస్య ముఖాకృతిరన్యరూపా జాతా, తదీయం వస్త్రముజ్జ్వలశుక్లం జాతం|</para>
  <para style="p">
    <verse number="30" style="v"/>అపరఞ్చ మూసా ఏలియశ్చోభౌ తేజస్వినౌ దృష్టౌ</para>
  <para style="p">
    <verse number="31" style="v"/>తౌ తేన యిరూశాలమ్పురే యో మృత్యుః సాధిష్యతే తదీయాం కథాం తేన సార్ద్ధం కథయితుమ్ ఆరేభాతే|</para>
  <para style="p">
    <verse number="32" style="v"/>తదా పితరాదయః స్వస్య సఙ్గినో నిద్రయాకృష్టా ఆసన్ కిన్తు జాగరిత్వా తస్య తేజస్తేన సార్ద్ధమ్ ఉత్తిష్ఠన్తౌ జనౌ చ దదృశుః|</para>
  <para style="p">
    <verse number="33" style="v"/>అథ తయోరుభయో ర్గమనకాలే పితరో యీశుం బభాషే, హే గురోఽస్మాకం స్థానేఽస్మిన్ స్థితిః శుభా, తత ఏకా త్వదర్థా, ఏకా మూసార్థా, ఏకా ఏలియార్థా, ఇతి తిస్రః కుట్యోస్మాభి ర్నిర్మ్మీయన్తాం, ఇమాం కథాం స న వివిచ్య కథయామాస|</para>
  <para style="p">
    <verse number="34" style="v"/>అపరఞ్చ తద్వాక్యవదనకాలే పయోద ఏక ఆగత్య తేషాముపరి ఛాయాం చకార, తతస్తన్మధ్యే తయోః ప్రవేశాత్ తే శశఙ్కిరే|</para>
  <para style="p">
    <verse number="35" style="v"/>తదా తస్మాత్ పయోదాద్ ఇయమాకాశీయా వాణీ నిర్జగామ, మమాయం ప్రియః పుత్ర ఏతస్య కథాయాం మనో నిధత్త|</para>
  <para style="p">
    <verse number="36" style="v"/>ఇతి శబ్దే జాతే తే యీశుమేకాకినం దదృశుః కిన్తు తే తదానీం తస్య దర్శనస్య వాచమేకామపి నోక్త్వా మనఃసు స్థాపయామాసుః|</para>
  <para style="p">
    <verse number="37" style="v"/>పరేఽహని తేషు తస్మాచ్ఛైలాద్ అవరూఢేషు తం సాక్షాత్ కర్త్తుం బహవో లోకా ఆజగ్ముః|</para>
  <para style="p">
    <verse number="38" style="v"/>తేషాం మధ్యాద్ ఏకో జన ఉచ్చైరువాచ, హే గురో అహం వినయం కరోమి మమ పుత్రం ప్రతి కృపాదృష్టిం కరోతు, మమ స ఏవైకః పుత్రః|</para>
  <para style="p">
    <verse number="39" style="v"/>భూతేన ధృతః సన్ సం ప్రసభం చీచ్ఛబ్దం కరోతి తన్ముఖాత్ ఫేణా నిర్గచ్ఛన్తి చ, భూత ఇత్థం విదార్య్య క్లిష్ట్వా ప్రాయశస్తం న త్యజతి|</para>
  <para style="p">
    <verse number="40" style="v"/>తస్మాత్ తం భూతం త్యాజయితుం తవ శిష్యసమీపే న్యవేదయం కిన్తు తే న శేకుః|</para>
  <para style="p">
    <verse number="41" style="v"/>తదా యీశురవాదీత్, రే ఆవిశ్వాసిన్ విపథగామిన్ వంశ కతికాలాన్ యుష్మాభిః సహ స్థాస్యామ్యహం యుష్మాకమ్ ఆచరణాని చ సహిష్యే? తవ పుత్రమిహానయ|</para>
  <para style="p">
    <verse number="42" style="v"/>తతస్తస్మిన్నాగతమాత్రే భూతస్తం భూమౌ పాతయిత్వా విదదార; తదా యీశుస్తమమేధ్యం భూతం తర్జయిత్వా బాలకం స్వస్థం కృత్వా తస్య పితరి సమర్పయామాస|</para>
  <para style="p">
    <verse number="43" style="v"/>ఈశ్వరస్య మహాశక్తిమ్ ఇమాం విలోక్య సర్వ్వే చమచ్చక్రుః; ఇత్థం యీశోః సర్వ్వాభిః క్రియాభిః సర్వ్వైర్లోకైరాశ్చర్య్యే మన్యమానే సతి స శిష్యాన్ బభాషే,</para>
  <para style="p">
    <verse number="44" style="v"/>కథేయం యుష్మాకం కర్ణేషు ప్రవిశతు, మనుష్యపుత్రో మనుష్యాణాం కరేషు సమర్పయిష్యతే|</para>
  <para style="p">
    <verse number="45" style="v"/>కిన్తు తే తాం కథాం న బుబుధిరే, స్పష్టత్వాభావాత్ తస్యా అభిప్రాయస్తేషాం బోధగమ్యో న బభూవ; తస్యా ఆశయః క ఇత్యపి తే భయాత్ ప్రష్టుం న శేకుః|</para>
  <para style="p">
    <verse number="46" style="v"/>తదనన్తరం తేషాం మధ్యే కః శ్రేష్ఠః కథామేతాం గృహీత్వా తే మిథో వివాదం చక్రుః|</para>
  <para style="p">
    <verse number="47" style="v"/>తతో యీశుస్తేషాం మనోభిప్రాయం విదిత్వా బాలకమేకం గృహీత్వా స్వస్య నికటే స్థాపయిత్వా తాన్ జగాద,</para>
  <para style="p">
    <verse number="48" style="v"/>యో జనో మమ నామ్నాస్య బాలాస్యాతిథ్యం విదధాతి స మమాతిథ్యం విదధాతి, యశ్చ మమాతిథ్యం విదధాతి స మమ ప్రేరకస్యాతిథ్యం విదధాతి, యుష్మాకం మధ్యేయః స్వం సర్వ్వస్మాత్ క్షుద్రం జానీతే స ఏవ శ్రేష్ఠో భవిష్యతి|</para>
  <para style="p">
    <verse number="49" style="v"/>అపరఞ్చ యోహన్ వ్యాజహార హే ప్రభేा తవ నామ్నా భూతాన్ త్యాజయన్తం మానుషమ్ ఏకం దృష్టవన్తో వయం, కిన్త్వస్మాకమ్ అపశ్చాద్ గామిత్వాత్ తం న్యషేధామ్| తదానీం యీశురువాచ,</para>
  <para style="p">
    <verse number="50" style="v"/>తం మా నిషేధత, యతో యో జనోస్మాకం న విపక్షః స ఏవాస్మాకం సపక్షో భవతి|</para>
  <para style="p">
    <verse number="51" style="v"/>అనన్తరం తస్యారోహణసమయ ఉపస్థితే స స్థిరచేతా యిరూశాలమం ప్రతి యాత్రాం కర్త్తుం నిశ్చిత్యాగ్రే దూతాన్ ప్రేషయామాస|</para>
  <para style="p">
    <verse number="52" style="v"/>తస్మాత్ తే గత్వా తస్య ప్రయోజనీయద్రవ్యాణి సంగ్రహీతుం శోమిరోణీయానాం గ్రామం ప్రవివిశుః|</para>
  <para style="p">
    <verse number="53" style="v"/>కిన్తు స యిరూశాలమం నగరం యాతి తతో హేతో ర్లోకాస్తస్యాతిథ్యం న చక్రుః|</para>
  <para style="p">
    <verse number="54" style="v"/>అతఏవ యాకూబ్యోహనౌ తస్య శిష్యౌ తద్ దృష్ట్వా జగదతుః, హే ప్రభో ఏలియో యథా చకార తథా వయమపి కిం గగణాద్ ఆగన్తుమ్ ఏతాన్ భస్మీకర్త్తుఞ్చ వహ్నిమాజ్ఞాపయామః? భవాన్ కిమిచ్ఛతి?</para>
  <para style="p">
    <verse number="55" style="v"/>కిన్తు స ముఖం పరావర్త్య తాన్ తర్జయిత్వా గదితవాన్ యుష్మాకం మనోభావః కః, ఇతి యూయం న జానీథ|</para>
  <para style="p">
    <verse number="56" style="v"/>మనుజసుతో మనుజానాం ప్రాణాన్ నాశయితుం నాగచ్ఛత్, కిన్తు రక్షితుమ్ ఆగచ్ఛత్| పశ్చాద్ ఇతరగ్రామం తే యయుః|</para>
  <para style="p">
    <verse number="57" style="v"/>తదనన్తరం పథి గమనకాలే జన ఏకస్తం బభాషే, హే ప్రభో భవాన్ యత్ర యాతి భవతా సహాహమపి తత్ర యాస్యామి|</para>
  <para style="p">
    <verse number="58" style="v"/>తదానీం యీశుస్తమువాచ, గోమాయూనాం గర్త్తా ఆసతే, విహాయసీయవిహగాाనాం నీడాని చ సన్తి, కిన్తు మానవతనయస్య శిరః స్థాపయితుం స్థానం నాస్తి|</para>
  <para style="p">
    <verse number="59" style="v"/>తతః పరం స ఇతరజనం జగాద, త్వం మమ పశ్చాద్ ఏహి; తతః స ఉవాచ, హే ప్రభో పూర్వ్వం పితరం శ్మశానే స్థాపయితుం మామాదిశతు|</para>
  <para style="p">
    <verse number="60" style="v"/>తదా యీశురువాచ, మృతా మృతాన్ శ్మశానే స్థాపయన్తు కిన్తు త్వం గత్వేశ్వరీయరాజ్యస్య కథాం ప్రచారయ|</para>
  <para style="p">
    <verse number="61" style="v"/>తతోన్యః కథయామాస, హే ప్రభో మయాపి భవతః పశ్చాద్ గంస్యతే, కిన్తు పూర్వ్వం మమ నివేశనస్య పరిజనానామ్ అనుమతిం గ్రహీతుమ్ అహమాదిశ్యై భవతా|</para>
  <para style="p">
    <verse number="62" style="v"/>తదానీం యీశుస్తం ప్రోక్తవాన్, యో జనో లాఙ్గలే కరమర్పయిత్వా పశ్చాత్ పశ్యతి స ఈశ్వరీయరాజ్యం నార్హతి|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>తతః పరం ప్రభురపరాన్ సప్తతిశిష్యాన్ నియుజ్య స్వయం యాని నగరాణి యాని స్థానాని చ గమిష్యతి తాని నగరాణి తాని స్థానాని చ ప్రతి ద్వౌ ద్వౌ జనౌ ప్రహితవాన్|</para>
  <para style="p">
    <verse number="2" style="v"/>తేభ్యః కథయామాస చ శస్యాని బహూనీతి సత్యం కిన్తు ఛేదకా అల్పే; తస్మాద్ధేతోః శస్యక్షేత్రే ఛేదకాన్ అపరానపి ప్రేషయితుం క్షేత్రస్వామినం ప్రార్థయధ్వం|</para>
  <para style="p">
    <verse number="3" style="v"/>యూయం యాత, పశ్యత, వృకాణాం మధ్యే మేషశావకానివ యుష్మాన్ ప్రహిణోమి|</para>
  <para style="p">
    <verse number="4" style="v"/>యూయం క్షుద్రం మహద్ వా వసనసమ్పుటకం పాదుకాశ్చ మా గృహ్లీత, మార్గమధ్యే కమపి మా నమత చ|</para>
  <para style="p">
    <verse number="5" style="v"/>అపరఞ్చ యూయం యద్ యత్ నివేశనం ప్రవిశథ తత్ర నివేశనస్యాస్య మఙ్గలం భూయాదితి వాక్యం ప్రథమం వదత|</para>
  <para style="p">
    <verse number="6" style="v"/>తస్మాత్ తస్మిన్ నివేశనే యది మఙ్గలపాత్రం స్థాస్యతి తర్హి తన్మఙ్గలం తస్య భవిష్యతి, నోచేత్ యుష్మాన్ ప్రతి పరావర్త్తిష్యతే|</para>
  <para style="p">
    <verse number="7" style="v"/>అపరఞ్చ తే యత్కిఞ్చిద్ దాస్యన్తి తదేవ భుక్త్వా పీత్వా తస్మిన్నివేశనే స్థాస్యథ; యతః కర్మ్మకారీ జనో భృతిమ్ అర్హతి; గృహాద్ గృహం మా యాస్యథ|</para>
  <para style="p">
    <verse number="8" style="v"/>అన్యచ్చ యుష్మాసు కిమపి నగరం ప్రవిష్టేషు లోకా యది యుష్మాకమ్ ఆతిథ్యం కరిష్యన్తి, తర్హి యత్ ఖాద్యమ్ ఉపస్థాస్యన్తి తదేవ ఖాదిష్యథ|</para>
  <para style="p">
    <verse number="9" style="v"/>తన్నగరస్థాన్ రోగిణః స్వస్థాన్ కరిష్యథ, ఈశ్వరీయం రాజ్యం యుష్మాకమ్ అన్తికమ్ ఆగమత్ కథామేతాఞ్చ ప్రచారయిష్యథ|</para>
  <para style="p">
    <verse number="10" style="v"/>కిన్తు కిమపి పురం యుష్మాసు ప్రవిష్టేషు లోకా యది యుష్మాకమ్ ఆతిథ్యం న కరిష్యన్తి, తర్హి తస్య నగరస్య పన్థానం గత్వా కథామేతాం వదిష్యథ,</para>
  <para style="p">
    <verse number="11" style="v"/>యుష్మాకం నగరీయా యా ధూల్యోఽస్మాసు సమలగన్ తా అపి యుష్మాకం ప్రాతికూల్యేన సాక్ష్యార్థం సమ్పాతయామః; తథాపీశ్వరరాజ్యం యుష్మాకం సమీపమ్ ఆగతమ్ ఇతి నిశ్చితం జానీత|</para>
  <para style="p">
    <verse number="12" style="v"/>అహం యుష్మభ్యం యథార్థం కథయామి, విచారదినే తస్య నగరస్య దశాతః సిదోమో దశా సహ్యా భవిష్యతి|</para>
  <para style="p">
    <verse number="13" style="v"/>హా హా కోరాసీన్ నగర, హా హా బైత్సైదానగర యువయోర్మధ్యే యాదృశాని ఆశ్చర్య్యాణి కర్మ్మాణ్యక్రియన్త, తాని కర్మ్మాణి యది సోరసీదోనో ర్నగరయోరకారిష్యన్త, తదా ఇతో బహుదినపూర్వ్వం తన్నివాసినః శణవస్త్రాణి పరిధాయ గాత్రేషు భస్మ విలిప్య సముపవిశ్య సమఖేత్స్యన్త|</para>
  <para style="p">
    <verse number="14" style="v"/>అతో విచారదివసే యుష్మాకం దశాతః సోరసీదోన్నివాసినాం దశా సహ్యా భవిష్యతి|</para>
  <para style="p">
    <verse number="15" style="v"/>హే కఫర్నాహూమ్, త్వం స్వర్గం యావద్ ఉన్నతా కిన్తు నరకం యావత్ న్యగ్భవిష్యసి|</para>
  <para style="p">
    <verse number="16" style="v"/>యో జనో యుష్మాకం వాక్యం గృహ్లాతి స మమైవ వాక్యం గృహ్లాతి; కిఞ్చ యో జనో యుష్మాకమ్ అవజ్ఞాం కరోతి స మమైవావజ్ఞాం కరోతి; యో జనో మమావజ్ఞాం కరోతి చ స మత్ప్రేరకస్యైవావజ్ఞాం కరోతి|</para>
  <para style="p">
    <verse number="17" style="v"/>అథ తే సప్తతిశిష్యా ఆనన్దేన ప్రత్యాగత్య కథయామాసుః, హే ప్రభో భవతో నామ్నా భూతా అప్యస్మాకం వశీభవన్తి|</para>
  <para style="p">
    <verse number="18" style="v"/>తదానీం స తాన్ జగాద, విద్యుతమివ స్వర్గాత్ పతన్తం శైతానమ్ అదర్శమ్|</para>
  <para style="p">
    <verse number="19" style="v"/>పశ్యత సర్పాన్ వృశ్చికాన్ రిపోః సర్వ్వపరాక్రమాంశ్చ పదతలై ర్దలయితుం యుష్మభ్యం శక్తిం దదామి తస్మాద్ యుష్మాకం కాపి హాని ర్న భవిష్యతి|</para>
  <para style="p">
    <verse number="20" style="v"/>భూతా యుష్మాకం వశీభవన్తి, ఏతన్నిమిత్తత్ మా సముల్లసత, స్వర్గే యుష్మాకం నామాని లిఖితాని సన్తీతి నిమిత్తం సముల్లసత|</para>
  <para style="p">
    <verse number="21" style="v"/>తద్ఘటికాయాం యీశు ర్మనసి జాతాహ్లాదః కథయామాస హే స్వర్గపృథివ్యోరేకాధిపతే పితస్త్వం జ్ఞానవతాం విదుషాఞ్చ లోకానాం పురస్తాత్ సర్వ్వమేతద్ అప్రకాశ్య బాలకానాం పురస్తాత్ ప్రాకాశయ ఏతస్మాద్ధేతోస్త్వాం ధన్యం వదామి, హే పితరిత్థం భవతు యద్ ఏతదేవ తవ గోచర ఉత్తమమ్|</para>
  <para style="p">
    <verse number="22" style="v"/>పిత్రా సర్వ్వాణి మయి సమర్పితాని పితరం వినా కోపి పుత్రం న జానాతి కిఞ్చ పుత్రం వినా యస్మై జనాయ పుత్రస్తం ప్రకాశితవాన్ తఞ్చ వినా కోపి పితరం న జానాతి|</para>
  <para style="p">
    <verse number="23" style="v"/>తపః పరం స శిష్యాన్ ప్రతి పరావృత్య గుప్తం జగాద, యూయమేతాని సర్వ్వాణి పశ్యథ తతో యుష్మాకం చక్షూంషి ధన్యాని|</para>
  <para style="p">
    <verse number="24" style="v"/>యుష్మానహం వదామి, యూయం యాని సర్వ్వాణి పశ్యథ తాని బహవో భవిష్యద్వాదినో భూపతయశ్చ ద్రష్టుమిచ్ఛన్తోపి ద్రష్టుం న ప్రాప్నువన్, యుష్మాభి ర్యా యాః కథాశ్చ శ్రూయన్తే తాః శ్రోతుమిచ్ఛన్తోపి శ్రోతుం నాలభన్త|</para>
  <para style="p">
    <verse number="25" style="v"/>అనన్తరమ్ ఏకో వ్యవస్థాపక ఉత్థాయ తం పరీక్షితుం పప్రచ్ఛ, హే ఉపదేశక అనన్తాయుషః ప్రాప్తయే మయా కిం కరణీయం?</para>
  <para style="p">
    <verse number="26" style="v"/>యీశుః ప్రత్యువాచ, అత్రార్థే వ్యవస్థాయాం కిం లిఖితమస్తి? త్వం కీదృక్ పఠసి?</para>
  <para style="p">
    <verse number="27" style="v"/>తతః సోవదత్, త్వం సర్వ్వాన్తఃకరణైః సర్వ్వప్రాణైః సర్వ్వశక్తిభిః సర్వ్వచిత్తైశ్చ ప్రభౌ పరమేశ్వరే ప్రేమ కురు, సమీపవాసిని స్వవత్ ప్రేమ కురు చ|</para>
  <para style="p">
    <verse number="28" style="v"/>తదా స కథయామాస, త్వం యథార్థం ప్రత్యవోచః, ఇత్థమ్ ఆచర తేనైవ జీవిష్యసి|</para>
  <para style="p">
    <verse number="29" style="v"/>కిన్తు స జనః స్వం నిర్ద్దోషం జ్ఞాపయితుం యీశుం పప్రచ్ఛ, మమ సమీపవాసీ కః? తతో యీశుః ప్రత్యువాచ,</para>
  <para style="p">
    <verse number="30" style="v"/>ఏకో జనో యిరూశాలమ్పురాద్ యిరీహోపురం యాతి, ఏతర్హి దస్యూనాం కరేషు పతితే తే తస్య వస్త్రాదికం హృతవన్తః తమాహత్య మృతప్రాయం కృత్వా త్యక్త్వా యయుః|</para>
  <para style="p">
    <verse number="31" style="v"/>అకస్మాద్ ఏకో యాజకస్తేన మార్గేణ గచ్ఛన్ తం దృష్ట్వా మార్గాన్యపార్శ్వేన జగామ|</para>
  <para style="p">
    <verse number="32" style="v"/>ఇత్థమ్ ఏకో లేవీయస్తత్స్థానం ప్రాప్య తస్యాన్తికం గత్వా తం విలోక్యాన్యేన పార్శ్వేన జగామ|</para>
  <para style="p">
    <verse number="33" style="v"/>కిన్త్వేకః శోమిరోణీయో గచ్ఛన్ తత్స్థానం ప్రాప్య తం దృష్ట్వాదయత|</para>
  <para style="p">
    <verse number="34" style="v"/>తస్యాన్తికం గత్వా తస్య క్షతేషు తైలం ద్రాక్షారసఞ్చ ప్రక్షిప్య క్షతాని బద్ధ్వా నిజవాహనోపరి తముపవేశ్య ప్రవాసీయగృహమ్ ఆనీయ తం సిషేవే|</para>
  <para style="p">
    <verse number="35" style="v"/>పరస్మిన్ దివసే నిజగమనకాలే ద్వౌ ముద్రాపాదౌ తద్గృహస్వామినే దత్త్వావదత్ జనమేనం సేవస్వ తత్ర యోఽధికో వ్యయో భవిష్యతి తమహం పునరాగమనకాలే పరిశోత్స్యామి|</para>
  <para style="p">
    <verse number="36" style="v"/>ఏషాం త్రయాణాం మధ్యే తస్య దస్యుహస్తపతితస్య జనస్య సమీపవాసీ కః? త్వయా కిం బుధ్యతే?</para>
  <para style="p">
    <verse number="37" style="v"/>తతః స వ్యవస్థాపకః కథయామాస యస్తస్మిన్ దయాం చకార| తదా యీశుః కథయామాస త్వమపి గత్వా తథాచర|</para>
  <para style="p">
    <verse number="38" style="v"/>తతః పరం తే గచ్ఛన్త ఏకం గ్రామం ప్రవివిశుః; తదా మర్థానామా స్త్రీ స్వగృహే తస్యాతిథ్యం చకార|</para>
  <para style="p">
    <verse number="39" style="v"/>తస్మాత్ మరియమ్ నామధేయా తస్యా భగినీ యీశోః పదసమీప ఉవవిశ్య తస్యోపదేశకథాం శ్రోతుమారేభే|</para>
  <para style="p">
    <verse number="40" style="v"/>కిన్తు మర్థా నానాపరిచర్య్యాయాం వ్యగ్రా బభూవ తస్మాద్ధేతోస్తస్య సమీపమాగత్య బభాషే; హే ప్రభో మమ భగినీ కేవలం మమోపరి సర్వ్వకర్మ్మణాం భారమ్ అర్పితవతీ తత్ర భవతా కిఞ్చిదపి న మనో నిధీయతే కిమ్? మమ సాహాయ్యం కర్త్తుం భవాన్ తామాదిశతు|</para>
  <para style="p">
    <verse number="41" style="v"/>తతో యీశుః ప్రత్యువాచ హే మర్థే హే మర్థే, త్వం నానాకార్య్యేషు చిన్తితవతీ వ్యగ్రా చాసి,</para>
  <para style="p">
    <verse number="42" style="v"/>కిన్తు ప్రయోజనీయమ్ ఏకమాత్రమ్ ఆస్తే| అపరఞ్చ యముత్తమం భాగం కోపి హర్త్తుం న శక్నోతి సఏవ మరియమా వృతః|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అనన్తరం స కస్మింశ్చిత్ స్థానే ప్రార్థయత తత్సమాప్తౌ సత్యాం తస్యైకః శిష్యస్తం జగాద హే ప్రభో యోహన్ యథా స్వశిష్యాన్ ప్రార్థయితుమ్ ఉపదిష్టవాన్ తథా భవానప్యస్మాన్ ఉపదిశతు|</para>
  <para style="p">
    <verse number="2" style="v"/>తస్మాత్ స కథయామాస, ప్రార్థనకాలే యూయమ్ ఇత్థం కథయధ్వం, హే అస్మాకం స్వర్గస్థపితస్తవ నామ పూజ్యం భవతు; తవ రాజత్వం భవతు; స్వర్గే యథా తథా పృథివ్యామపి తవేచ్ఛయా సర్వ్వం భవతు|</para>
  <para style="p">
    <verse number="3" style="v"/>ప్రత్యహమ్ అస్మాకం ప్రయోజనీయం భోజ్యం దేహి|</para>
  <para style="p">
    <verse number="4" style="v"/>యథా వయం సర్వ్వాన్ అపరాధినః క్షమామహే తథా త్వమపి పాపాన్యస్మాకం క్షమస్వ| అస్మాన్ పరీక్షాం మానయ కిన్తు పాపాత్మనో రక్ష|</para>
  <para style="p">
    <verse number="5" style="v"/>పశ్చాత్ సోపరమపి కథితవాన్ యది యుష్మాకం కస్యచిద్ బన్ధుస్తిష్ఠతి నిశీథే చ తస్య సమీపం స గత్వా వదతి,</para>
  <para style="p">
    <verse number="6" style="v"/>హే బన్ధో పథిక ఏకో బన్ధు ర్మమ నివేశనమ్ ఆయాతః కిన్తు తస్యాతిథ్యం కర్త్తుం మమాన్తికే కిమపి నాస్తి, అతఏవ పూపత్రయం మహ్యమ్ ఋణం దేహి;</para>
  <para style="p">
    <verse number="7" style="v"/>తదా స యది గృహమధ్యాత్ ప్రతివదతి మాం మా క్లిశాన, ఇదానీం ద్వారం రుద్ధం శయనే మయా సహ బాలకాశ్చ తిష్ఠన్తి తుభ్యం దాతుమ్ ఉత్థాతుం న శక్నోమి,</para>
  <para style="p">
    <verse number="8" style="v"/>తర్హి యుష్మానహం వదామి, స యది మిత్రతయా తస్మై కిమపి దాతుం నోత్తిష్ఠతి తథాపి వారం వారం ప్రార్థనాత ఉత్థాపితః సన్ యస్మిన్ తస్య ప్రయోజనం తదేవ దాస్యతి|</para>
  <para style="p">
    <verse number="9" style="v"/>అతః కారణాత్ కథయామి, యాచధ్వం తతో యుష్మభ్యం దాస్యతే, మృగయధ్వం తత ఉద్దేశం ప్రాప్స్యథ, ద్వారమ్ ఆహత తతో యుష్మభ్యం ద్వారం మోక్ష్యతే|</para>
  <para style="p">
    <verse number="10" style="v"/>యో యాచతే స ప్రాప్నోతి, యో మృగయతే స ఏవోద్దేశం ప్రాప్నోతి, యో ద్వారమ్ ఆహన్తి తదర్థం ద్వారం మోచ్యతే|</para>
  <para style="p">
    <verse number="11" style="v"/>పుత్రేణ పూపే యాచితే తస్మై పాషాణం దదాతి వా మత్స్యే యాచితే తస్మై సర్పం దదాతి</para>
  <para style="p">
    <verse number="12" style="v"/>వా అణ్డే యాచితే తస్మై వృశ్చికం దదాతి యుష్మాకం మధ్యే క ఏతాదృశః పితాస్తే?</para>
  <para style="p">
    <verse number="13" style="v"/>తస్మాదేవ యూయమభద్రా అపి యది స్వస్వబాలకేభ్య ఉత్తమాని ద్రవ్యాణి దాతుం జానీథ తర్హ్యస్మాకం స్వర్గస్థః పితా నిజయాచకేభ్యః కిం పవిత్రమ్ ఆత్మానం న దాస్యతి?</para>
  <para style="p">
    <verse number="14" style="v"/>అనన్తరం యీశునా కస్మాచ్చిద్ ఏకస్మిన్ మూకభూతే త్యాజితే సతి స భూతత్యక్తో మానుషో వాక్యం వక్తుమ్ ఆరేభే; తతో లోకాః సకలా ఆశ్చర్య్యం మేనిరే|</para>
  <para style="p">
    <verse number="15" style="v"/>కిన్తు తేషాం కేచిదూచు ర్జనోయం బాలసిబూబా అర్థాద్ భూతరాజేన భూతాన్ త్యాజయతి|</para>
  <para style="p">
    <verse number="16" style="v"/>తం పరీక్షితుం కేచిద్ ఆకాశీయమ్ ఏకం చిహ్నం దర్శయితుం తం ప్రార్థయాఞ్చక్రిరే|</para>
  <para style="p">
    <verse number="17" style="v"/>తదా స తేషాం మనఃకల్పనాం జ్ఞాత్వా కథయామాస, కస్యచిద్ రాజ్యస్య లోకా యది పరస్పరం విరున్ధన్తి తర్హి తద్ రాజ్యమ్ నశ్యతి; కేచిద్ గృహస్థా యది పరస్పరం విరున్ధన్తి తర్హి తేపి నశ్యన్తి|</para>
  <para style="p">
    <verse number="18" style="v"/>తథైవ శైతానపి స్వలోకాన్ యది విరుణద్ధి తదా తస్య రాజ్యం కథం స్థాస్యతి? బాలసిబూబాహం భూతాన్ త్యాజయామి యూయమితి వదథ|</para>
  <para style="p">
    <verse number="19" style="v"/>యద్యహం బాలసిబూబా భూతాన్ త్యాజయామి తర్హి యుష్మాకం సన్తానాః కేన త్యాజయన్తి? తస్మాత్ తఏవ కథాయా ఏతస్యా విచారయితారో భవిష్యన్తి|</para>
  <para style="p">
    <verse number="20" style="v"/>కిన్తు యద్యహమ్ ఈశ్వరస్య పరాక్రమేణ భూతాన్ త్యాజయామి తర్హి యుష్మాకం నికటమ్ ఈశ్వరస్య రాజ్యమవశ్యమ్ ఉపతిష్ఠతి|</para>
  <para style="p">
    <verse number="21" style="v"/>బలవాన్ పుమాన్ సుసజ్జమానో యతికాలం నిజాట్టాలికాం రక్షతి తతికాలం తస్య ద్రవ్యం నిరుపద్రవం తిష్ఠతి|</para>
  <para style="p">
    <verse number="22" style="v"/>కిన్తు తస్మాద్ అధికబలః కశ్చిదాగత్య యది తం జయతి తర్హి యేషు శస్త్రాస్త్రేషు తస్య విశ్వాస ఆసీత్ తాని సర్వ్వాణి హృత్వా తస్య ద్రవ్యాణి గృహ్లాతి|</para>
  <para style="p">
    <verse number="23" style="v"/>అతః కారణాద్ యో మమ సపక్షో న స విపక్షః, యో మయా సహ న సంగృహ్లాతి స వికిరతి|</para>
  <para style="p">
    <verse number="24" style="v"/>అపరఞ్చ అమేధ్యభూతో మానుషస్యాన్తర్నిర్గత్య శుష్కస్థానే భ్రాన్త్వా విశ్రామం మృగయతే కిన్తు న ప్రాప్య వదతి మమ యస్మాద్ గృహాద్ ఆగతోహం పునస్తద్ గృహం పరావృత్య యామి|</para>
  <para style="p">
    <verse number="25" style="v"/>తతో గత్వా తద్ గృహం మార్జితం శోభితఞ్చ దృష్ట్వా</para>
  <para style="p">
    <verse number="26" style="v"/>తత్క్షణమ్ అపగత్య స్వస్మాదపి దుర్మ్మతీన్ అపరాన్ సప్తభూతాన్ సహానయతి తే చ తద్గృహం పవిశ్య నివసన్తి| తస్మాత్ తస్య మనుష్యస్య ప్రథమదశాతః శేషదశా దుఃఖతరా భవతి|</para>
  <para style="p">
    <verse number="27" style="v"/>అస్యాః కథాయాః కథనకాలే జనతామధ్యస్థా కాచిన్నారీ తముచ్చైఃస్వరం ప్రోవాచ, యా యోషిత్ త్వాం గర్బ్భేఽధారయత్ స్తన్యమపాయయచ్చ సైవ ధన్యా|</para>
  <para style="p">
    <verse number="28" style="v"/>కిన్తు సోకథయత్ యే పరమేశ్వరస్య కథాం శ్రుత్వా తదనురూపమ్ ఆచరన్తి తఏవ ధన్యాః|</para>
  <para style="p">
    <verse number="29" style="v"/>తతః పరం తస్యాన్తికే బహులోకానాం సమాగమే జాతే స వక్తుమారేభే, ఆధునికా దుష్టలోకాశ్చిహ్నం ద్రష్టుమిచ్ఛన్తి కిన్తు యూనస్భవిష్యద్వాదినశ్చిహ్నం వినాన్యత్ కిఞ్చిచ్చిహ్నం తాన్ న దర్శయిష్యతే|</para>
  <para style="p">
    <verse number="30" style="v"/>యూనస్ తు యథా నీనివీయలోకానాం సమీపే చిహ్నరూపోభవత్ తథా విద్యమానలోకానామ్ ఏషాం సమీపే మనుష్యపుత్రోపి చిహ్నరూపో భవిష్యతి|</para>
  <para style="p">
    <verse number="31" style="v"/>విచారసమయే ఇదానీన్తనలోకానాం ప్రాతికూల్యేన దక్షిణదేశీయా రాజ్ఞీ ప్రోత్థాయ తాన్ దోషిణః కరిష్యతి, యతః సా రాజ్ఞీ సులేమాన ఉపదేశకథాం శ్రోతుం పృథివ్యాః సీమాత ఆగచ్ఛత్ కిన్తు పశ్యత సులేమానోపి గురుతర ఏకో జనోఽస్మిన్ స్థానే విద్యతే|</para>
  <para style="p">
    <verse number="32" style="v"/>అపరఞ్చ విచారసమయే నీనివీయలోకా అపి వర్త్తమానకాలికానాం లోకానాం వైపరీత్యేన ప్రోత్థాయ తాన్ దోషిణః కరిష్యన్తి, యతో హేతోస్తే యూనసో వాక్యాత్ చిత్తాని పరివర్త్తయామాసుః కిన్తు పశ్యత యూనసోతిగురుతర ఏకో జనోఽస్మిన్ స్థానే విద్యతే|</para>
  <para style="p">
    <verse number="33" style="v"/>ప్రదీపం ప్రజ్వాల్య ద్రోణస్యాధః కుత్రాపి గుప్తస్థానే వా కోపి న స్థాపయతి కిన్తు గృహప్రవేశిభ్యో దీప్తిం దాతం దీపాధారోపర్య్యేవ స్థాపయతి|</para>
  <para style="p">
    <verse number="34" style="v"/>దేహస్య ప్రదీపశ్చక్షుస్తస్మాదేవ చక్షు ర్యది ప్రసన్నం భవతి తర్హి తవ సర్వ్వశరీరం దీప్తిమద్ భవిష్యతి కిన్తు చక్షు ర్యది మలీమసం తిష్ఠతి తర్హి సర్వ్వశరీరం సాన్ధకారం స్థాస్యతి|</para>
  <para style="p">
    <verse number="35" style="v"/>అస్మాత్ కారణాత్ తవాన్తఃస్థం జ్యోతి ర్యథాన్ధకారమయం న భవతి తదర్థే సావధానో భవ|</para>
  <para style="p">
    <verse number="36" style="v"/>యతః శరీరస్య కుత్రాప్యంశే సాన్ధకారే న జాతే సర్వ్వం యది దీప్తిమత్ తిష్ఠతి తర్హి తుభ్యం దీప్తిదాయిప్రోజ్జ్వలన్ ప్రదీప ఇవ తవ సవర్వశరీరం దీప్తిమద్ భవిష్యతి|</para>
  <para style="p">
    <verse number="37" style="v"/>ఏతత్కథాయాః కథనకాలే ఫిరుశ్యేకో భేజనాయ తం నిమన్త్రయామాస, తతః స గత్వా భోక్తుమ్ ఉపవివేశ|</para>
  <para style="p">
    <verse number="38" style="v"/>కిన్తు భోజనాత్ పూర్వ్వం నామాఙ్క్షీత్ ఏతద్ దృష్ట్వా స ఫిరుశ్యాశ్చర్య్యం మేనే|</para>
  <para style="p">
    <verse number="39" style="v"/>తదా ప్రభుస్తం ప్రోవాచ యూయం ఫిరూశిలోకాః పానపాత్రాణాం భోజనపాత్రాణాఞ్చ బహిః పరిష్కురుథ కిన్తు యుష్మాకమన్త ర్దౌరాత్మ్యై ర్దుష్క్రియాభిశ్చ పరిపూర్ణం తిష్ఠతి|</para>
  <para style="p">
    <verse number="40" style="v"/>హే సర్వ్వే నిర్బోధా యో బహిః ససర్జ స ఏవ కిమన్త ర్న ససర్జ?</para>
  <para style="p">
    <verse number="41" style="v"/>తత ఏవ యుష్మాభిరన్తఃకరణం (ఈశ్వరాయ) నివేద్యతాం తస్మిన్ కృతే యుష్మాకం సర్వ్వాణి శుచితాం యాస్యన్తి|</para>
  <para style="p">
    <verse number="42" style="v"/>కిన్తు హన్త ఫిరూశిగణా యూయం న్యాయమ్ ఈశ్వరే ప్రేమ చ పరిత్యజ్య పోదినాయా అరుదాదీనాం సర్వ్వేషాం శాకానాఞ్చ దశమాంశాన్ దత్థ కిన్తు ప్రథమం పాలయిత్వా శేషస్యాలఙ్ఘనం యుష్మాకమ్ ఉచితమాసీత్|</para>
  <para style="p">
    <verse number="43" style="v"/>హా హా ఫిరూశినో యూయం భజనగేహే ప్రోచ్చాసనే ఆపణేషు చ నమస్కారేషు ప్రీయధ్వే|</para>
  <para style="p">
    <verse number="44" style="v"/>వత కపటినోఽధ్యాపకాః ఫిరూశినశ్చ లోకాయత్ శ్మశానమ్ అనుపలభ్య తదుపరి గచ్ఛన్తి యూయమ్ తాదృగప్రకాశితశ్మశానవాద్ భవథ|</para>
  <para style="p">
    <verse number="45" style="v"/>తదానీం వ్యవస్థాపకానామ్ ఏకా యీశుమవదత్, హే ఉపదేశక వాక్యేనేదృశేనాస్మాస్వపి దోషమ్ ఆరోపయసి|</para>
  <para style="p">
    <verse number="46" style="v"/>తతః స ఉవాచ, హా హా వ్యవస్థాపకా యూయమ్ మానుషాణామ్ ఉపరి దుఃసహ్యాన్ భారాన్ న్యస్యథ కిన్తు స్వయమ్ ఏకాఙ్గుुల్యాపి తాన్ భారాన్ న స్పృశథ|</para>
  <para style="p">
    <verse number="47" style="v"/>హన్త యుష్మాకం పూర్వ్వపురుషా యాన్ భవిష్యద్వాదినోఽవధిషుస్తేషాం శ్మశానాని యూయం నిర్మ్మాథ|</para>
  <para style="p">
    <verse number="48" style="v"/>తేనైవ యూయం స్వపూర్వ్వపురుషాణాం కర్మ్మాణి సంమన్యధ్వే తదేవ సప్రమాణం కురుథ చ, యతస్తే తానవధిషుః యూయం తేషాం శ్మశానాని నిర్మ్మాథ|</para>
  <para style="p">
    <verse number="49" style="v"/>అతఏవ ఈశ్వరస్య శాస్త్రే ప్రోక్తమస్తి తేషామన్తికే భవిష్యద్వాదినః ప్రేరితాంశ్చ ప్రేషయిష్యామి తతస్తే తేషాం కాంశ్చన హనిష్యన్తి కాంశ్చన తాడశ్ష్యిన్తి|</para>
  <para style="p">
    <verse number="50" style="v"/>ఏతస్మాత్ కారణాత్ హాబిలః శోణితపాతమారభ్య మన్దిరయజ్ఞవేద్యో ర్మధ్యే హతస్య సిఖరియస్య రక్తపాతపర్య్యన్తం</para>
  <para style="p">
    <verse number="51" style="v"/>జగతః సృష్టిమారభ్య పృథివ్యాం భవిష్యద్వాదినాం యతిరక్తపాతా జాతాస్తతీనామ్ అపరాధదణ్డా ఏషాం వర్త్తమానలోకానాం భవిష్యన్తి, యుష్మానహం నిశ్చితం వదామి సర్వ్వే దణ్డా వంశస్యాస్య భవిష్యన్తి|</para>
  <para style="p">
    <verse number="52" style="v"/>హా హా వ్యవస్థపకా యూయం జ్ఞానస్య కుఞ్చికాం హృత్వా స్వయం న ప్రవిష్టా యే ప్రవేష్టుఞ్చ ప్రయాసినస్తానపి ప్రవేష్టుం వారితవన్తః|</para>
  <para style="p">
    <verse number="53" style="v"/>ఇత్థం కథాకథనాద్ అధ్యాపకాః ఫిరూశినశ్చ సతర్కాః</para>
  <para style="p">
    <verse number="54" style="v"/>సన్తస్తమపవదితుం తస్య కథాయా దోషం ధర్త్తమిచ్ఛన్తో నానాఖ్యానకథనాయ తం ప్రవర్త్తయితుం కోపయితుఞ్చ ప్రారేభిరే|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>తదానీం లోకాః సహస్రం సహస్రమ్ ఆగత్య సముపస్థితాస్తత ఏకైకో ఽన్యేషాముపరి పతితుమ్ ఉపచక్రమే; తదా యీశుః శిష్యాన్ బభాషే, యూయం ఫిరూశినాం కిణ్వరూపకాపట్యే విశేషేణ సావధానాస్తిష్ఠత|</para>
  <para style="p">
    <verse number="2" style="v"/>యతో యన్న ప్రకాశయిష్యతే తదాచ్ఛన్నం వస్తు కిమపి నాస్తి; తథా యన్న జ్ఞాస్యతే తద్ గుప్తం వస్తు కిమపి నాస్తి|</para>
  <para style="p">
    <verse number="3" style="v"/>అన్ధకారే తిష్ఠనతో యాః కథా అకథయత తాః సర్వ్వాః కథా దీప్తౌ శ్రోష్యన్తే నిర్జనే కర్ణే చ యదకథయత గృహపృష్ఠాత్ తత్ ప్రచారయిష్యతే|</para>
  <para style="p">
    <verse number="4" style="v"/>హే బన్ధవో యుష్మానహం వదామి, యే శరీరస్య నాశం వినా కిమప్యపరం కర్త్తుం న శక్రువన్తి తేభ్యో మా భైష్ట|</para>
  <para style="p">
    <verse number="5" style="v"/>తర్హి కస్మాద్ భేతవ్యమ్ ఇత్యహం వదామి, యః శరీరం నాశయిత్వా నరకం నిక్షేప్తుం శక్నోతి తస్మాదేవ భయం కురుత, పునరపి వదామి తస్మాదేవ భయం కురుత|</para>
  <para style="p">
    <verse number="6" style="v"/>పఞ్చ చటకపక్షిణః కిం ద్వాభ్యాం తామ్రఖణ్డాభ్యాం న విక్రీయన్తే? తథాపీశ్వరస్తేషామ్ ఏకమపి న విస్మరతి|</para>
  <para style="p">
    <verse number="7" style="v"/>యుష్మాకం శిరఃకేశా అపి గణితాః సన్తి తస్మాత్ మా విభీత బహుచటకపక్షిభ్యోపి యూయం బహుమూల్యాః|</para>
  <para style="p">
    <verse number="8" style="v"/>అపరం యుష్మభ్యం కథయామి యః కశ్చిన్ మానుషాణాం సాక్షాన్ మాం స్వీకరోతి మనుష్యపుత్ర ఈశ్వరదూతానాం సాక్షాత్ తం స్వీకరిష్యతి|</para>
  <para style="p">
    <verse number="9" style="v"/>కిన్తు యః కశ్చిన్మానుషాణాం సాక్షాన్మామ్ అస్వీకరోతి తమ్ ఈశ్వరస్య దూతానాం సాక్షాద్ అహమ్ అస్వీకరిష్యామి|</para>
  <para style="p">
    <verse number="10" style="v"/>అన్యచ్చ యః కశ్చిన్ మనుజసుతస్య నిన్దాభావేన కాఞ్చిత్ కథాం కథయతి తస్య తత్పాపస్య మోచనం భవిష్యతి కిన్తు యది కశ్చిత్ పవిత్రమ్ ఆత్మానం నిన్దతి తర్హి తస్య తత్పాపస్య మోచనం న భవిష్యతి|</para>
  <para style="p">
    <verse number="11" style="v"/>యదా లోకా యుష్మాన్ భజనగేహం విచారకర్తృరాజ్యకర్తృణాం సమ్ముఖఞ్చ నేష్యన్తి తదా కేన ప్రకారేణ కిముత్తరం వదిష్యథ కిం కథయిష్యథ చేత్యత్ర మా చిన్తయత;</para>
  <para style="p">
    <verse number="12" style="v"/>యతో యుష్మాభిర్యద్ యద్ వక్తవ్యం తత్ తస్మిన్ సమయఏవ పవిత్ర ఆత్మా యుష్మాన్ శిక్షయిష్యతి|</para>
  <para style="p">
    <verse number="13" style="v"/>తతః పరం జనతామధ్యస్థః కశ్చిజ్జనస్తం జగాద హే గురో మయా సహ పైతృకం ధనం విభక్తుం మమ భ్రాతరమాజ్ఞాపయతు భవాన్|</para>
  <para style="p">
    <verse number="14" style="v"/>కిన్తు స తమవదత్ హే మనుష్య యువయో ర్విచారం విభాగఞ్చ కర్త్తుం మాం కో నియుక్తవాన్?</para>
  <para style="p">
    <verse number="15" style="v"/>అనన్తరం స లోకానవదత్ లోభే సావధానాః సతర్కాశ్చ తిష్ఠత, యతో బహుసమ్పత్తిప్రాప్త్యా మనుష్యస్యాయు ర్న భవతి|</para>
  <para style="p">
    <verse number="16" style="v"/>పశ్చాద్ దృష్టాన్తకథాముత్థాప్య కథయామాస, ఏకస్య ధనినో భూమౌ బహూని శస్యాని జాతాని|</para>
  <para style="p">
    <verse number="17" style="v"/>తతః స మనసా చిన్తయిత్వా కథయామ్బభూవ మమైతాని సముత్పన్నాని ద్రవ్యాణి స్థాపయితుం స్థానం నాస్తి కిం కరిష్యామి?</para>
  <para style="p">
    <verse number="18" style="v"/>తతోవదద్ ఇత్థం కరిష్యామి, మమ సర్వ్వభాణ్డాగారాణి భఙ్క్త్వా బృహద్భాణ్డాగారాణి నిర్మ్మాయ తన్మధ్యే సర్వ్వఫలాని ద్రవ్యాణి చ స్థాపయిష్యామి|</para>
  <para style="p">
    <verse number="19" style="v"/>అపరం నిజమనో వదిష్యామి, హే మనో బహువత్సరార్థం నానాద్రవ్యాణి సఞ్చితాని సన్తి విశ్రామం కురు భుక్త్వా పీత్వా కౌతుకఞ్చ కురు| కిన్త్వీశ్వరస్తమ్ అవదత్,</para>
  <para style="p">
    <verse number="20" style="v"/>రే నిర్బోధ అద్య రాత్రౌ తవ ప్రాణాస్త్వత్తో నేష్యన్తే తత ఏతాని యాని ద్రవ్యాణి త్వయాసాదితాని తాని కస్య భవిష్యన్తి?</para>
  <para style="p">
    <verse number="21" style="v"/>అతఏవ యః కశ్చిద్ ఈశ్వరస్య సమీపే ధనసఞ్చయమకృత్వా కేవలం స్వనికటే సఞ్చయం కరోతి సోపి తాదృశః|</para>
  <para style="p">
    <verse number="22" style="v"/>అథ స శిష్యేభ్యః కథయామాస, యుష్మానహం వదామి, కిం ఖాదిష్యామః? కిం పరిధాస్యామః? ఇత్యుక్త్వా జీవనస్య శరీరస్య చార్థం చిన్తాం మా కార్ష్ట|</para>
  <para style="p">
    <verse number="23" style="v"/>భక్ష్యాజ్జీవనం భూషణాచ్ఛరీరఞ్చ శ్రేష్ఠం భవతి|</para>
  <para style="p">
    <verse number="24" style="v"/>కాకపక్షిణాం కార్య్యం విచారయత, తే న వపన్తి శస్యాని చ న ఛిన్దన్తి, తేషాం భాణ్డాగారాణి న సన్తి కోషాశ్చ న సన్తి, తథాపీశ్వరస్తేభ్యో భక్ష్యాణి దదాతి, యూయం పక్షిభ్యః శ్రేష్ఠతరా న కిం?</para>
  <para style="p">
    <verse number="25" style="v"/>అపరఞ్చ భావయిత్వా నిజాయుషః క్షణమాత్రం వర్ద్ధయితుం శక్నోతి, ఏతాదృశో లాకో యుష్మాకం మధ్యే కోస్తి?</para>
  <para style="p">
    <verse number="26" style="v"/>అతఏవ క్షుద్రం కార్య్యం సాధయితుమ్ అసమర్థా యూయమ్ అన్యస్మిన్ కార్య్యే కుతో భావయథ?</para>
  <para style="p">
    <verse number="27" style="v"/>అన్యచ్చ కామ్పిలపుష్పం కథం వర్ద్ధతే తదాపి విచారయత, తత్ కఞ్చన శ్రమం న కరోతి తన్తూంశ్చ న జనయతి కిన్తు యుష్మభ్యం యథార్థం కథయామి సులేమాన్ బహ్వైశ్వర్య్యాన్వితోపి పుష్పస్యాస్య సదృశో విభూషితో నాసీత్|</para>
  <para style="p">
    <verse number="28" style="v"/>అద్య క్షేత్రే వర్త్తమానం శ్వశ్చూల్ల్యాం క్షేప్స్యమానం యత్ తృణం, తస్మై యదీశ్వర ఇత్థం భూషయతి తర్హి హే అల్పప్రత్యయినో యుష్మాన కిం న పరిధాపయిష్యతి?</para>
  <para style="p">
    <verse number="29" style="v"/>అతఏవ కిం ఖాదిష్యామః? కిం పరిధాస్యామః? ఏతదర్థం మా చేష్టధ్వం మా సందిగ్ధ్వఞ్చ|</para>
  <para style="p">
    <verse number="30" style="v"/>జగతో దేవార్చ్చకా ఏతాని సర్వ్వాణి చేష్టనతే; ఏషు వస్తుషు యుష్మాకం ప్రయోజనమాస్తే ఇతి యుష్మాకం పితా జానాతి|</para>
  <para style="p">
    <verse number="31" style="v"/>అతఏవేశ్వరస్య రాజ్యార్థం సచేష్టా భవత తథా కృతే సర్వ్వాణ్యేతాని ద్రవ్యాణి యుష్మభ్యం ప్రదాయిష్యన్తే|</para>
  <para style="p">
    <verse number="32" style="v"/>హే క్షుద్రమేషవ్రజ యూయం మా భైష్ట యుష్మభ్యం రాజ్యం దాతుం యుష్మాకం పితుః సమ్మతిరస్తి|</para>
  <para style="p">
    <verse number="33" style="v"/>అతఏవ యుష్మాకం యా యా సమ్పత్తిరస్తి తాం తాం విక్రీయ వితరత, యత్ స్థానం చౌరా నాగచ్ఛన్తి, కీటాశ్చ న క్షాయయన్తి తాదృశే స్వర్గే నిజార్థమ్ అజరే సమ్పుటకే ఽక్షయం ధనం సఞ్చినుత చ;</para>
  <para style="p">
    <verse number="34" style="v"/>యతో యత్ర యుష్మాకం ధనం వర్త్తతే తత్రేవ యుష్మాకం మనః|</para>
  <para style="p">
    <verse number="35" style="v"/>అపరఞ్చ యూయం ప్రదీపం జ్వాలయిత్వా బద్ధకటయస్తిష్ఠత;</para>
  <para style="p">
    <verse number="36" style="v"/>ప్రభు ర్వివాహాదాగత్య యదైవ ద్వారమాహన్తి తదైవ ద్వారం మోచయితుం యథా భృత్యా అపేక్ష్య తిష్ఠన్తి తథా యూయమపి తిష్ఠత|</para>
  <para style="p">
    <verse number="37" style="v"/>యతః ప్రభురాగత్య యాన్ దాసాన్ సచేతనాన్ తిష్ఠతో ద్రక్ష్యతి తఏవ ధన్యాః; అహం యుష్మాన్ యథార్థం వదామి ప్రభుస్తాన్ భోజనార్థమ్ ఉపవేశ్య స్వయం బద్ధకటిః సమీపమేత్య పరివేషయిష్యతి|</para>
  <para style="p">
    <verse number="38" style="v"/>యది ద్వితీయే తృతీయే వా ప్రహరే సమాగత్య తథైవ పశ్యతి, తర్హి తఏవ దాసా ధన్యాః|</para>
  <para style="p">
    <verse number="39" style="v"/>అపరఞ్చ కస్మిన్ క్షణే చౌరా ఆగమిష్యన్తి ఇతి యది గృహపతి ర్జ్ఞాతుం శక్నోతి తదావశ్యం జాగ్రన్ నిజగృహే సన్ధిం కర్త్తయితుం వారయతి యూయమేతద్ విత్త|</para>
  <para style="p">
    <verse number="40" style="v"/>అతఏవ యూయమపి సజ్జమానాస్తిష్ఠత యతో యస్మిన్ క్షణే తం నాప్రేక్షధ్వే తస్మిన్నేవ క్షణే మనుష్యపుత్ర ఆగమిష్యతి|</para>
  <para style="p">
    <verse number="41" style="v"/>తదా పితరః పప్రచ్ఛ, హే ప్రభో భవాన్ కిమస్మాన్ ఉద్దిశ్య కిం సర్వ్వాన్ ఉద్దిశ్య దృష్టాన్తకథామిమాం వదతి?</para>
  <para style="p">
    <verse number="42" style="v"/>తతః ప్రభుః ప్రోవాచ, ప్రభుః సముచితకాలే నిజపరివారార్థం భోజ్యపరివేషణాయ యం తత్పదే నియోక్ష్యతి తాదృశో విశ్వాస్యో బోద్ధా కర్మ్మాధీశః కోస్తి?</para>
  <para style="p">
    <verse number="43" style="v"/>ప్రభురాగత్య యమ్ ఏతాదృశే కర్మ్మణి ప్రవృత్తం ద్రక్ష్యతి సఏవ దాసో ధన్యః|</para>
  <para style="p">
    <verse number="44" style="v"/>అహం యుష్మాన్ యథార్థం వదామి స తం నిజసర్వ్వస్వస్యాధిపతిం కరిష్యతి|</para>
  <para style="p">
    <verse number="45" style="v"/>కిన్తు ప్రభుర్విలమ్బేనాగమిష్యతి, ఇతి విచిన్త్య స దాసో యది తదన్యదాసీదాసాన్ ప్రహర్త్తుమ్ భోక్తుం పాతుం మదితుఞ్చ ప్రారభతే,</para>
  <para style="p">
    <verse number="46" style="v"/>తర్హి యదా ప్రభుం నాపేక్షిష్యతే యస్మిన్ క్షణే సోఽచేతనశ్చ స్థాస్యతి తస్మిన్నేవ క్షణే తస్య ప్రభురాగత్య తం పదభ్రష్టం కృత్వా విశ్వాసహీనైః సహ తస్య అంశం నిరూపయిష్యతి|</para>
  <para style="p">
    <verse number="47" style="v"/>యో దాసః ప్రభేाరాజ్ఞాం జ్ఞాత్వాపి సజ్జితో న తిష్ఠతి తదాజ్ఞానుసారేణ చ కార్య్యం న కరోతి సోనేకాన్ ప్రహారాన్ ప్రాప్స్యతి;</para>
  <para style="p">
    <verse number="48" style="v"/>కిన్తు యో జనోఽజ్ఞాత్వా ప్రహారార్హం కర్మ్మ కరోతి సోల్పప్రహారాన్ ప్రాప్స్యతి| యతో యస్మై బాహుల్యేన దత్తం తస్మాదేవ బాహుల్యేన గ్రహీష్యతే, మానుషా యస్య నికటే బహు సమర్పయన్తి తస్మాద్ బహు యాచన్తే|</para>
  <para style="p">
    <verse number="49" style="v"/>అహం పృథివ్యామ్ అనైక్యరూపం వహ్ని నిక్షేప్తుమ్ ఆగతోస్మి, స చేద్ ఇదానీమేవ ప్రజ్వలతి తత్ర మమ కా చిన్తా?</para>
  <para style="p">
    <verse number="50" style="v"/>కిన్తు యేన మజ్జనేనాహం మగ్నో భవిష్యామి యావత్కాలం తస్య సిద్ధి ర్న భవిష్యతి తావదహం కతికష్టం ప్రాప్స్యామి|</para>
  <para style="p">
    <verse number="51" style="v"/>మేలనం కర్త్తుం జగద్ ఆగతోస్మి యూయం కిమిత్థం బోధధ్వే? యుష్మాన్ వదామి న తథా, కిన్త్వహం మేలనాభావం కర్త్తుంమ్ ఆగతోస్మి|</para>
  <para style="p">
    <verse number="52" style="v"/>యస్మాదేతత్కాలమారభ్య ఏకత్రస్థపరిజనానాం మధ్యే పఞ్చజనాః పృథగ్ భూత్వా త్రయో జనా ద్వయోర్జనయోః ప్రతికూలా ద్వౌ జనౌ చ త్రయాణాం జనానాం ప్రతికూలౌ భవిష్యన్తి|</para>
  <para style="p">
    <verse number="53" style="v"/>పితా పుత్రస్య విపక్షః పుత్రశ్చ పితు ర్విపక్షో భవిష్యతి మాతా కన్యాయా విపక్షా కన్యా చ మాతు ర్విపక్షా భవిష్యతి, తథా శ్వశ్రూర్బధ్వా విపక్షా బధూశ్చ శ్వశ్ర్వా విపక్షా భవిష్యతి|</para>
  <para style="p">
    <verse number="54" style="v"/>స లోకేభ్యోపరమపి కథయామాస, పశ్చిమదిశి మేఘోద్గమం దృష్ట్వా యూయం హఠాద్ వదథ వృష్టి ర్భవిష్యతి తతస్తథైవ జాయతే|</para>
  <para style="p">
    <verse number="55" style="v"/>అపరం దక్షిణతో వాయౌ వాతి సతి వదథ నిదాఘో భవిష్యతి తతః సోపి జాయతే|</para>
  <para style="p">
    <verse number="56" style="v"/>రే రే కపటిన ఆకాశస్య భూమ్యాశ్చ లక్షణం బోద్ధుం శక్నుథ,</para>
  <para style="p">
    <verse number="57" style="v"/>కిన్తు కాలస్యాస్య లక్షణం కుతో బోద్ధుం న శక్నుథ? యూయఞ్చ స్వయం కుతో న న్యాష్యం విచారయథ?</para>
  <para style="p">
    <verse number="58" style="v"/>అపరఞ్చ వివాదినా సార్ద్ధం విచారయితుః సమీపం గచ్ఛన్ పథి తస్మాదుద్ధారం ప్రాప్తుం యతస్వ నోచేత్ స త్వాం ధృత్వా విచారయితుః సమీపం నయతి| విచారయితా యది త్వాం ప్రహర్త్తుః సమీపం సమర్పయతి ప్రహర్త్తా త్వాం కారాయాం బధ్నాతి</para>
  <para style="p">
    <verse number="59" style="v"/>తర్హి త్వామహం వదామి త్వయా నిఃశేషం కపర్దకేషు న పరిశోధితేషు త్వం తతో ముక్తిం ప్రాప్తుం న శక్ష్యసి|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అపరఞ్చ పీలాతో యేషాం గాలీలీయానాం రక్తాని బలీనాం రక్తైః సహామిశ్రయత్ తేషాం గాలీలీయానాం వృత్తాన్తం కతిపయజనా ఉపస్థాప్య యీశవే కథయామాసుః|</para>
  <para style="p">
    <verse number="2" style="v"/>తతః స ప్రత్యువాచ తేషాం లోకానామ్ ఏతాదృశీ దుర్గతి ర్ఘటితా తత్కారణాద్ యూయం కిమన్యేభ్యో గాలీలీయేభ్యోప్యధికపాపినస్తాన్ బోధధ్వే?</para>
  <para style="p">
    <verse number="3" style="v"/>యుష్మానహం వదామి తథా న కిన్తు మనఃసు న పరావర్త్తితేషు యూయమపి తథా నంక్ష్యథ|</para>
  <para style="p">
    <verse number="4" style="v"/>అపరఞ్చ శీలోహనామ్న ఉచ్చగృహస్య పతనాద్ యేఽష్టాదశజనా మృతాస్తే యిరూశాలమి నివాసిసర్వ్వలోకేభ్యోఽధికాపరాధినః కిం యూయమిత్యం బోధధ్వే?</para>
  <para style="p">
    <verse number="5" style="v"/>యుష్మానహం వదామి తథా న కిన్తు మనఃసు న పరివర్త్తితేషు యూయమపి తథా నంక్ష్యథ|</para>
  <para style="p">
    <verse number="6" style="v"/>అనన్తరం స ఇమాం దృష్టాన్తకథామకథయద్ ఏకో జనో ద్రాక్షాక్షేత్రమధ్య ఏకముడుమ్బరవృక్షం రోపితవాన్| పశ్చాత్ స ఆగత్య తస్మిన్ ఫలాని గవేషయామాస,</para>
  <para style="p">
    <verse number="7" style="v"/>కిన్తు ఫలాప్రాప్తేః కారణాద్ ఉద్యానకారం భృత్యం జగాద, పశ్య వత్సరత్రయం యావదాగత్య ఏతస్మిన్నుడుమ్బరతరౌ క్షలాన్యన్విచ్ఛామి, కిన్తు నైకమపి ప్రప్నోమి తరురయం కుతో వృథా స్థానం వ్యాప్య తిష్ఠతి? ఏనం ఛిన్ధి|</para>
  <para style="p">
    <verse number="8" style="v"/>తతో భృత్యః ప్రత్యువాచ, హే ప్రభో పునర్వర్షమేకం స్థాతుమ్ ఆదిశ; ఏతస్య మూలస్య చతుర్దిక్షు ఖనిత్వాహమ్ ఆలవాలం స్థాపయామి|</para>
  <para style="p">
    <verse number="9" style="v"/>తతః ఫలితుం శక్నోతి యది న ఫలతి తర్హి పశ్చాత్ ఛేత్స్యసి|</para>
  <para style="p">
    <verse number="10" style="v"/>అథ విశ్రామవారే భజనగేహే యీశురుపదిశతి</para>
  <para style="p">
    <verse number="11" style="v"/>తస్మిత్ సమయే భూతగ్రస్తత్వాత్ కుబ్జీభూయాష్టాదశవర్షాణి యావత్ కేనాప్యుపాయేన ఋజు ర్భవితుం న శక్నోతి యా దుర్బ్బలా స్త్రీ,</para>
  <para style="p">
    <verse number="12" style="v"/>తాం తత్రోపస్థితాం విలోక్య యీశుస్తామాహూయ కథితవాన్ హే నారి తవ దౌర్బ్బల్యాత్ త్వం ముక్తా భవ|</para>
  <para style="p">
    <verse number="13" style="v"/>తతః పరం తస్యా గాత్రే హస్తార్పణమాత్రాత్ సా ఋజుర్భూత్వేశ్వరస్య ధన్యవాదం కర్త్తుమారేభే|</para>
  <para style="p">
    <verse number="14" style="v"/>కిన్తు విశ్రామవారే యీశునా తస్యాః స్వాస్థ్యకరణాద్ భజనగేహస్యాధిపతిః ప్రకుప్య లోకాన్ ఉవాచ, షట్సు దినేషు లోకైః కర్మ్మ కర్త్తవ్యం తస్మాద్ధేతోః స్వాస్థ్యార్థం తేషు దినేషు ఆగచ్ఛత, విశ్రామవారే మాగచ్ఛత|</para>
  <para style="p">
    <verse number="15" style="v"/>తదా పభుః ప్రత్యువాచ రే కపటినో యుష్మాకమ్ ఏకైకో జనో విశ్రామవారే స్వీయం స్వీయం వృషభం గర్దభం వా బన్ధనాన్మోచయిత్వా జలం పాయయితుం కిం న నయతి?</para>
  <para style="p">
    <verse number="16" style="v"/>తర్హ్యాష్టాదశవత్సరాన్ యావత్ శైతానా బద్ధా ఇబ్రాహీమః సన్తతిరియం నారీ కిం విశ్రామవారే న మోచయితవ్యా?</para>
  <para style="p">
    <verse number="17" style="v"/>ఏషు వాక్యేషు కథితేషు తస్య విపక్షాః సలజ్జా జాతాః కిన్తు తేన కృతసర్వ్వమహాకర్మ్మకారణాత్ లోకనివహః సానన్దోఽభవత్|</para>
  <para style="p">
    <verse number="18" style="v"/>అనన్తరం సోవదద్ ఈశ్వరస్య రాజ్యం కస్య సదృశం? కేన తదుపమాస్యామి?</para>
  <para style="p">
    <verse number="19" style="v"/>యత్ సర్షపబీజం గృహీత్వా కశ్చిజ్జన ఉద్యాన ఉప్తవాన్ తద్ బీజమఙ్కురితం సత్ మహావృక్షోఽజాయత, తతస్తస్య శాఖాసు విహాయసీయవిహగా ఆగత్య న్యూషుః, తద్రాజ్యం తాదృశేన సర్షపబీజేన తుల్యం|</para>
  <para style="p">
    <verse number="20" style="v"/>పునః కథయామాస, ఈశ్వరస్య రాజ్యం కస్య సదృశం వదిష్యామి? యత్ కిణ్వం కాచిత్ స్త్రీ గృహీత్వా ద్రోణత్రయపరిమితగోధూమచూర్ణేషు స్థాపయామాస,</para>
  <para style="p">
    <verse number="21" style="v"/>తతః క్రమేణ తత్ సర్వ్వగోధూమచూర్ణం వ్యాప్నోతి, తస్య కిణ్వస్య తుల్యమ్ ఈశ్వరస్య రాజ్యం|</para>
  <para style="p">
    <verse number="22" style="v"/>తతః స యిరూశాలమ్నగరం ప్రతి యాత్రాం కృత్వా నగరే నగరే గ్రామే గ్రామే సముపదిశన్ జగామ|</para>
  <para style="p">
    <verse number="23" style="v"/>తదా కశ్చిజ్జనస్తం పప్రచ్ఛ, హే ప్రభో కిం కేవలమ్ అల్పే లోకాః పరిత్రాస్యన్తే?</para>
  <para style="p">
    <verse number="24" style="v"/>తతః స లోకాన్ ఉవాచ, సంకీర్ణద్వారేణ ప్రవేష్టుం యతఘ్వం, యతోహం యుష్మాన్ వదామి, బహవః ప్రవేష్టుం చేష్టిష్యన్తే కిన్తు న శక్ష్యన్తి|</para>
  <para style="p">
    <verse number="25" style="v"/>గృహపతినోత్థాయ ద్వారే రుద్ధే సతి యది యూయం బహిః స్థిత్వా ద్వారమాహత్య వదథ, హే ప్రభో హే ప్రభో అస్మత్కారణాద్ ద్వారం మోచయతు, తతః స ఇతి ప్రతివక్ష్యతి, యూయం కుత్రత్యా లోకా ఇత్యహం న జానామి|</para>
  <para style="p">
    <verse number="26" style="v"/>తదా యూయం వదిష్యథ, తవ సాక్షాద్ వయం భేाజనం పానఞ్చ కృతవన్తః, త్వఞ్చాస్మాకం నగరస్య పథి సముపదిష్టవాన్|</para>
  <para style="p">
    <verse number="27" style="v"/>కిన్తు స వక్ష్యతి, యుష్మానహం వదామి, యూయం కుత్రత్యా లోకా ఇత్యహం న జానామి; హే దురాచారిణో యూయం మత్తో దూరీభవత|</para>
  <para style="p">
    <verse number="28" style="v"/>తదా ఇబ్రాహీమం ఇస్హాకం యాకూబఞ్చ సర్వ్వభవిష్యద్వాదినశ్చ ఈశ్వరస్య రాజ్యం ప్రాప్తాన్ స్వాంశ్చ బహిష్కృతాన్ దృష్ట్వా యూయం రోదనం దన్తైర్దన్తఘర్షణఞ్చ కరిష్యథ|</para>
  <para style="p">
    <verse number="29" style="v"/>అపరఞ్చ పూర్వ్వపశ్చిమదక్షిణోత్తరదిగ్భ్యో లోకా ఆగత్య ఈశ్వరస్య రాజ్యే నివత్స్యన్తి|</para>
  <para style="p">
    <verse number="30" style="v"/>పశ్యతేత్థం శేషీయా లోకా అగ్రా భవిష్యన్తి, అగ్రీయా లోకాశ్చ శేషా భవిష్యన్తి|</para>
  <para style="p">
    <verse number="31" style="v"/>అపరఞ్చ తస్మిన్ దినే కియన్తః ఫిరూశిన ఆగత్య యీశుం ప్రోచుః, బహిర్గచ్ఛ, స్థానాదస్మాత్ ప్రస్థానం కురు, హేరోద్ త్వాం జిఘాంసతి|</para>
  <para style="p">
    <verse number="32" style="v"/>తతః స ప్రత్యవోచత్ పశ్యతాద్య శ్వశ్చ భూతాన్ విహాప్య రోగిణోఽరోగిణః కృత్వా తృతీయేహ్ని సేత్స్యామి, కథామేతాం యూయమిత్వా తం భూరిమాయం వదత|</para>
  <para style="p">
    <verse number="33" style="v"/>తత్రాప్యద్య శ్వః పరశ్వశ్చ మయా గమనాగమనే కర్త్తవ్యే, యతో హేతో ర్యిరూశాలమో బహిః కుత్రాపి కోపి భవిష్యద్వాదీ న ఘానిష్యతే|</para>
  <para style="p">
    <verse number="34" style="v"/>హే యిరూశాలమ్ హే యిరూశాలమ్ త్వం భవిష్యద్వాదినో హంసి తవాన్తికే ప్రేరితాన్ ప్రస్తరైర్మారయసి చ, యథా కుక్కుటీ నిజపక్షాధః స్వశావకాన్ సంగృహ్లాతి, తథాహమపి తవ శిశూన్ సంగ్రహీతుం కతివారాన్ ఐచ్ఛం కిన్తు త్వం నైచ్ఛః|</para>
  <para style="p">
    <verse number="35" style="v"/>పశ్యత యుష్మాకం వాసస్థానాని ప్రోచ్ఛిద్యమానాని పరిత్యక్తాని చ భవిష్యన్తి; యుష్మానహం యథార్థం వదామి, యః ప్రభో ర్నామ్నాగచ్ఛతి స ధన్య ఇతి వాచం యావత్కాలం న వదిష్యథ, తావత్కాలం యూయం మాం న ద్రక్ష్యథ|</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అనన్తరం విశ్రామవారే యీశౌ ప్రధానస్య ఫిరూశినో గృహే భోక్తుం గతవతి తే తం వీక్షితుమ్ ఆరేభిరే|</para>
  <para style="p">
    <verse number="2" style="v"/>తదా జలోదరీ తస్య సమ్ముఖే స్థితః|</para>
  <para style="p">
    <verse number="3" style="v"/>తతః స వ్యవస్థాపకాన్ ఫిరూశినశ్చ పప్రచ్ఛ, విశ్రామవారే స్వాస్థ్యం కర్త్తవ్యం న వా? తతస్తే కిమపి న ప్రత్యూచుః|</para>
  <para style="p">
    <verse number="4" style="v"/>తదా స తం రోగిణం స్వస్థం కృత్వా విససర్జ;</para>
  <para style="p">
    <verse number="5" style="v"/>తానువాచ చ యుష్మాకం కస్యచిద్ గర్ద్దభో వృషభో వా చేద్ గర్త్తే పతతి తర్హి విశ్రామవారే తత్క్షణం స కిం తం నోత్థాపయిష్యతి?</para>
  <para style="p">
    <verse number="6" style="v"/>తతస్తే కథాయా ఏతస్యాః కిమపి ప్రతివక్తుం న శేకుః|</para>
  <para style="p">
    <verse number="7" style="v"/>అపరఞ్చ ప్రధానస్థానమనోనీతత్వకరణం విలోక్య స నిమన్త్రితాన్ ఏతదుపదేశకథాం జగాద,</para>
  <para style="p">
    <verse number="8" style="v"/>త్వం వివాహాదిభోజ్యేషు నిమన్త్రితః సన్ ప్రధానస్థానే మోపావేక్షీః| త్వత్తో గౌరవాన్వితనిమన్త్రితజన ఆయాతే</para>
  <para style="p">
    <verse number="9" style="v"/>నిమన్త్రయితాగత్య మనుష్యాయైతస్మై స్థానం దేహీతి వాక్యం చేద్ వక్ష్యతి తర్హి త్వం సఙ్కుచితో భూత్వా స్థాన ఇతరస్మిన్ ఉపవేష్టుమ్ ఉద్యంస్యసి|</para>
  <para style="p">
    <verse number="10" style="v"/>అస్మాత్ కారణాదేవ త్వం నిమన్త్రితో గత్వాఽప్రధానస్థాన ఉపవిశ, తతో నిమన్త్రయితాగత్య వదిష్యతి, హే బన్ధో ప్రోచ్చస్థానం గత్వోపవిశ, తథా సతి భోజనోపవిష్టానాం సకలానాం సాక్షాత్ త్వం మాన్యో భవిష్యసి|</para>
  <para style="p">
    <verse number="11" style="v"/>యః కశ్చిత్ స్వమున్నమయతి స నమయిష్యతే, కిన్తు యః కశ్చిత్ స్వం నమయతి స ఉన్నమయిష్యతే|</para>
  <para style="p">
    <verse number="12" style="v"/>తదా స నిమన్త్రయితారం జనమపి జగాద, మధ్యాహ్నే రాత్రౌ వా భోజ్యే కృతే నిజబన్ధుగణో వా భ్రాతృृగణో వా జ్ఞాతిగణో వా ధనిగణో వా సమీపవాసిగణో వా ఏతాన్ న నిమన్త్రయ, తథా కృతే చేత్ తే త్వాం నిమన్త్రయిష్యన్తి, తర్హి పరిశోధో భవిష్యతి|</para>
  <para style="p">
    <verse number="13" style="v"/>కిన్తు యదా భేజ్యం కరోషి తదా దరిద్రశుష్కకరఖఞ్జాన్ధాన్ నిమన్త్రయ,</para>
  <para style="p">
    <verse number="14" style="v"/>తత ఆశిషం లప్స్యసే, తేషు పరిశోధం కర్త్తుమశక్నువత్సు శ్మశానాద్ధార్మ్మికానాముత్థానకాలే త్వం ఫలాం లప్స్యసే|</para>
  <para style="p">
    <verse number="15" style="v"/>అనన్తరం తాం కథాం నిశమ్య భోజనోపవిష్టః కశ్చిత్ కథయామాస, యో జన ఈశ్వరస్య రాజ్యే భోక్తుం లప్స్యతే సఏవ ధన్యః|</para>
  <para style="p">
    <verse number="16" style="v"/>తతః స ఉవాచ, కశ్చిత్ జనో రాత్రౌ భేाజ్యం కృత్వా బహూన్ నిమన్త్రయామాస|</para>
  <para style="p">
    <verse number="17" style="v"/>తతో భోజనసమయే నిమన్త్రితలోకాన్ ఆహ్వాతుం దాసద్వారా కథయామాస, ఖద్యద్రవ్యాణి సర్వ్వాణి సమాసాదితాని సన్తి, యూయమాగచ్ఛత|</para>
  <para style="p">
    <verse number="18" style="v"/>కిన్తు తే సర్వ్వ ఏకైకం ఛలం కృత్వా క్షమాం ప్రార్థయాఞ్చక్రిరే| ప్రథమో జనః కథయామాస, క్షేత్రమేకం క్రీతవానహం తదేవ ద్రష్టుం మయా గన్తవ్యమ్, అతఏవ మాం క్షన్తుం తం నివేదయ|</para>
  <para style="p">
    <verse number="19" style="v"/>అన్యో జనః కథయామాస, దశవృషానహం క్రీతవాన్ తాన్ పరీక్షితుం యామి తస్మాదేవ మాం క్షన్తుం తం నివేదయ|</para>
  <para style="p">
    <verse number="20" style="v"/>అపరః కథయామాస, వ్యూఢవానహం తస్మాత్ కారణాద్ యాతుం న శక్నోమి|</para>
  <para style="p">
    <verse number="21" style="v"/>పశ్చాత్ స దాసో గత్వా నిజప్రభోః సాక్షాత్ సర్వ్వవృత్తాన్తం నివేదయామాస, తతోసౌ గృహపతిః కుపిత్వా స్వదాసం వ్యాజహార, త్వం సత్వరం నగరస్య సన్నివేశాన్ మార్గాంశ్చ గత్వా దరిద్రశుష్కకరఖఞ్జాన్ధాన్ అత్రానయ|</para>
  <para style="p">
    <verse number="22" style="v"/>తతో దాసోఽవదత్, హే ప్రభో భవత ఆజ్ఞానుసారేణాక్రియత తథాపి స్థానమస్తి|</para>
  <para style="p">
    <verse number="23" style="v"/>తదా ప్రభుః పున ర్దాసాయాకథయత్, రాజపథాన్ వృక్షమూలాని చ యాత్వా మదీయగృహపూరణార్థం లోకానాగన్తుం ప్రవర్త్తయ|</para>
  <para style="p">
    <verse number="24" style="v"/>అహం యుష్మభ్యం కథయామి, పూర్వ్వనిమన్త్రితానమేకోపి మమాస్య రాత్రిభోజ్యస్యాస్వాదం న ప్రాప్స్యతి|</para>
  <para style="p">
    <verse number="25" style="v"/>అనన్తరం బహుషు లోకేషు యీశోః పశ్చాద్ వ్రజితేషు సత్సు స వ్యాఘుట్య తేభ్యః కథయామాస,</para>
  <para style="p">
    <verse number="26" style="v"/>యః కశ్చిన్ మమ సమీపమ్ ఆగత్య స్వస్య మాతా పితా పత్నీ సన్తానా భ్రాతరో భగిమ్యో నిజప్రాణాశ్చ, ఏతేభ్యః సర్వ్వేభ్యో మయ్యధికం ప్రేమ న కరోతి, స మమ శిష్యో భవితుం న శక్ష్యతి|</para>
  <para style="p">
    <verse number="27" style="v"/>యః కశ్చిత్ స్వీయం క్రుశం వహన్ మమ పశ్చాన్న గచ్ఛతి, సోపి మమ శిష్యో భవితుం న శక్ష్యతి|</para>
  <para style="p">
    <verse number="28" style="v"/>దుర్గనిర్మ్మాణే కతివ్యయో భవిష్యతి, తథా తస్య సమాప్తికరణార్థం సమ్పత్తిరస్తి న వా, ప్రథమముపవిశ్య ఏతన్న గణయతి, యుష్మాకం మధ్య ఏతాదృశః కోస్తి?</para>
  <para style="p">
    <verse number="29" style="v"/>నోచేద్ భిత్తిం కృత్వా శేషే యది సమాపయితుం న శక్ష్యతి,</para>
  <para style="p">
    <verse number="30" style="v"/>తర్హి మానుషోయం నిచేతుమ్ ఆరభత సమాపయితుం నాశక్నోత్, ఇతి వ్యాహృత్య సర్వ్వే తముపహసిష్యన్తి|</para>
  <para style="p">
    <verse number="31" style="v"/>అపరఞ్చ భిన్నభూపతినా సహ యుద్ధం కర్త్తుమ్ ఉద్యమ్య దశసహస్రాణి సైన్యాని గృహీత్వా వింశతిసహస్రేః సైన్యైః సహితస్య సమీపవాసినః సమ్ముఖం యాతుం శక్ష్యామి న వేతి ప్రథమం ఉపవిశ్య న విచారయతి ఏతాదృశో భూమిపతిః కః?</para>
  <para style="p">
    <verse number="32" style="v"/>యది న శక్నోతి తర్హి రిపావతిదూరే తిష్ఠతి సతి నిజదూతం ప్రేష్య సన్ధిం కర్త్తుం ప్రార్థయేత|</para>
  <para style="p">
    <verse number="33" style="v"/>తద్వద్ యుష్మాకం మధ్యే యః కశ్చిన్ మదర్థం సర్వ్వస్వం హాతుం న శక్నోతి స మమ శిష్యో భవితుం న శక్ష్యతి|</para>
  <para style="p">
    <verse number="34" style="v"/>లవణమ్ ఉత్తమమ్ ఇతి సత్యం, కిన్తు యది లవణస్య లవణత్వమ్ అపగచ్ఛతి తర్హి తత్ కథం స్వాదుయుక్తం భవిష్యతి?</para>
  <para style="p">
    <verse number="35" style="v"/>తద భూమ్యర్థమ్ ఆలవాలరాశ్యర్థమపి భద్రం న భవతి; లోకాస్తద్ బహిః క్షిపన్తి| యస్య శ్రోతుం శ్రోత్రే స్తః స శృణోతు|</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>తదా కరసఞ్చాయినః పాపినశ్చ లోకా ఉపదేశ్కథాం శ్రోతుం యీశోః సమీపమ్ ఆగచ్ఛన్|</para>
  <para style="p">
    <verse number="2" style="v"/>తతః ఫిరూశిన ఉపాధ్యాయాశ్చ వివదమానాః కథయామాసుః ఏష మానుషః పాపిభిః సహ ప్రణయం కృత్వా తైః సార్ద్ధం భుంక్తే|</para>
  <para style="p">
    <verse number="3" style="v"/>తదా స తేభ్య ఇమాం దృష్టాన్తకథాం కథితవాన్,</para>
  <para style="p">
    <verse number="4" style="v"/>కస్యచిత్ శతమేషేషు తిష్ఠత్ము తేషామేకం స యది హారయతి తర్హి మధ్యేప్రాన్తరమ్ ఏకోనశతమేషాన్ విహాయ హారితమేషస్య ఉద్దేశప్రాప్తిపర్య్యనతం న గవేషయతి, ఏతాదృశో లోకో యుష్మాకం మధ్యే క ఆస్తే?</para>
  <para style="p">
    <verse number="5" style="v"/>తస్యోద్దేశం ప్రాప్య హృష్టమనాస్తం స్కన్ధే నిధాయ స్వస్థానమ్ ఆనీయ బన్ధుబాన్ధవసమీపవాసిన ఆహూయ వక్తి,</para>
  <para style="p">
    <verse number="6" style="v"/>హారితం మేషం ప్రాప్తోహమ్ అతో హేతో ర్మయా సార్ద్ధమ్ ఆనన్దత|</para>
  <para style="p">
    <verse number="7" style="v"/>తద్వదహం యుష్మాన్ వదామి, యేషాం మనఃపరావర్త్తనస్య ప్రయోజనం నాస్తి, తాదృశైకోనశతధార్మ్మికకారణాద్ య ఆనన్దస్తస్మాద్ ఏకస్య మనఃపరివర్త్తినః పాపినః కారణాత్ స్వర్గే ఽధికానన్దో జాయతే|</para>
  <para style="p">
    <verse number="8" style="v"/>అపరఞ్చ దశానాం రూప్యఖణ్డానామ్ ఏకఖణ్డే హారితే ప్రదీపం ప్రజ్వాల్య గృహం సమ్మార్జ్య తస్య ప్రాప్తిం యావద్ యత్నేన న గవేషయతి, ఏతాదృశీ యోషిత్ కాస్తే?</para>
  <para style="p">
    <verse number="9" style="v"/>ప్రాప్తే సతి బన్ధుబాన్ధవసమీపవాసినీరాహూయ కథయతి, హారితం రూప్యఖణ్డం ప్రాప్తాహం తస్మాదేవ మయా సార్ద్ధమ్ ఆనన్దత|</para>
  <para style="p">
    <verse number="10" style="v"/>తద్వదహం యుష్మాన్ వ్యాహరామి, ఏకేన పాపినా మనసి పరివర్త్తితే, ఈశ్వరస్య దూతానాం మధ్యేప్యానన్దో జాయతే|</para>
  <para style="p">
    <verse number="11" style="v"/>అపరఞ్చ స కథయామాస, కస్యచిద్ ద్వౌ పుత్రావాస్తాం,</para>
  <para style="p">
    <verse number="12" style="v"/>తయోః కనిష్ఠః పుత్రః పిత్రే కథయామాస, హే పితస్తవ సమ్పత్త్యా యమంశం ప్రాప్స్యామ్యహం విభజ్య తం దేహి, తతః పితా నిజాం సమ్పత్తిం విభజ్య తాభ్యాం దదౌ|</para>
  <para style="p">
    <verse number="13" style="v"/>కతిపయాత్ కాలాత్ పరం స కనిష్ఠపుత్రః సమస్తం ధనం సంగృహ్య దూరదేశం గత్వా దుష్టాచరణేన సర్వ్వాం సమ్పత్తిం నాశయామాస|</para>
  <para style="p">
    <verse number="14" style="v"/>తస్య సర్వ్వధనే వ్యయం గతే తద్దేశే మహాదుర్భిక్షం బభూవ, తతస్తస్య దైన్యదశా భవితుమ్ ఆరేభే|</para>
  <para style="p">
    <verse number="15" style="v"/>తతః పరం స గత్వా తద్దేశీయం గృహస్థమేకమ్ ఆశ్రయత; తతః సతం శూకరవ్రజం చారయితుం ప్రాన్తరం ప్రేషయామాస|</para>
  <para style="p">
    <verse number="16" style="v"/>కేనాపి తస్మై భక్ష్యాదానాత్ స శూకరఫలవల్కలేన పిచిణ్డపూరణాం వవాఞ్ఛ|</para>
  <para style="p">
    <verse number="17" style="v"/>శేషే స మనసి చేతనాం ప్రాప్య కథయామాస, హా మమ పితుః సమీపే కతి కతి వేతనభుజో దాసా యథేష్టం తతోధికఞ్చ భక్ష్యం ప్రాప్నువన్తి కిన్త్వహం క్షుధా ముమూర్షుః|</para>
  <para style="p">
    <verse number="18" style="v"/>అహముత్థాయ పితుః సమీపం గత్వా కథామేతాం వదిష్యామి, హే పితర్ ఈశ్వరస్య తవ చ విరుద్ధం పాపమకరవమ్</para>
  <para style="p">
    <verse number="19" style="v"/>తవ పుత్రఇతి విఖ్యాతో భవితుం న యోగ్యోస్మి చ, మాం తవ వైతనికం దాసం కృత్వా స్థాపయ|</para>
  <para style="p">
    <verse number="20" style="v"/>పశ్చాత్ స ఉత్థాయ పితుః సమీపం జగామ; తతస్తస్య పితాతిదూరే తం నిరీక్ష్య దయాఞ్చక్రే, ధావిత్వా తస్య కణ్ఠం గృహీత్వా తం చుచుమ్బ చ|</para>
  <para style="p">
    <verse number="21" style="v"/>తదా పుత్ర ఉవాచ, హే పితర్ ఈశ్వరస్య తవ చ విరుద్ధం పాపమకరవం, తవ పుత్రఇతి విఖ్యాతో భవితుం న యోగ్యోస్మి చ|</para>
  <para style="p">
    <verse number="22" style="v"/>కిన్తు తస్య పితా నిజదాసాన్ ఆదిదేశ, సర్వ్వోత్తమవస్త్రాణ్యానీయ పరిధాపయతైనం హస్తే చాఙ్గురీయకమ్ అర్పయత పాదయోశ్చోపానహౌ సమర్పయత;</para>
  <para style="p">
    <verse number="23" style="v"/>పుష్టం గోవత్సమ్ ఆనీయ మారయత చ తం భుక్త్వా వయమ్ ఆనన్దామ|</para>
  <para style="p">
    <verse number="24" style="v"/>యతో మమ పుత్రోయమ్ అమ్రియత పునరజీవీద్ హారితశ్చ లబ్ధోభూత్ తతస్త ఆనన్దితుమ్ ఆరేభిరే|</para>
  <para style="p">
    <verse number="25" style="v"/>తత్కాలే తస్య జ్యేష్ఠః పుత్రః క్షేత్ర ఆసీత్| అథ స నివేశనస్య నికటం ఆగచ్ఛన్ నృత్యానాం వాద్యానాఞ్చ శబ్దం శ్రుత్వా</para>
  <para style="p">
    <verse number="26" style="v"/>దాసానామ్ ఏకమ్ ఆహూయ పప్రచ్ఛ, కిం కారణమస్య?</para>
  <para style="p">
    <verse number="27" style="v"/>తతః సోవాదీత్, తవ భ్రాతాగమత్, తవ తాతశ్చ తం సుశరీరం ప్రాప్య పుష్టం గోవత్సం మారితవాన్|</para>
  <para style="p">
    <verse number="28" style="v"/>తతః స ప్రకుప్య నివేశనాన్తః ప్రవేష్టుం న సమ్మేనే; తతస్తస్య పితా బహిరాగత్య తం సాధయామాస|</para>
  <para style="p">
    <verse number="29" style="v"/>తతః స పితరం ప్రత్యువాచ, పశ్య తవ కాఞ్చిదప్యాజ్ఞాం న విలంఘ్య బహూన్ వత్సరాన్ అహం త్వాం సేవే తథాపి మిత్రైః సార్ద్ధమ్ ఉత్సవం కర్త్తుం కదాపి ఛాగమేకమపి మహ్యం నాదదాః;</para>
  <para style="p">
    <verse number="30" style="v"/>కిన్తు తవ యః పుత్రో వేశ్యాగమనాదిభిస్తవ సమ్పత్తిమ్ అపవ్యయితవాన్ తస్మిన్నాగతమాత్రే తస్యైవ నిమిత్తం పుష్టం గోవత్సం మారితవాన్|</para>
  <para style="p">
    <verse number="31" style="v"/>తదా తస్య పితావోచత్, హే పుత్ర త్వం సర్వ్వదా మయా సహాసి తస్మాన్ మమ యద్యదాస్తే తత్సర్వ్వం తవ|</para>
  <para style="p">
    <verse number="32" style="v"/>కిన్తు తవాయం భ్రాతా మృతః పునరజీవీద్ హారితశ్చ భూత్వా ప్రాప్తోభూత్, ఏతస్మాత్ కారణాద్ ఉత్సవానన్దౌ కర్త్తుమ్ ఉచితమస్మాకమ్|</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అపరఞ్చ యీశుః శిష్యేభ్యోన్యామేకాం కథాం కథయామాస కస్యచిద్ ధనవతో మనుష్యస్య గృహకార్య్యాధీశే సమ్పత్తేరపవ్యయేఽపవాదితే సతి</para>
  <para style="p">
    <verse number="2" style="v"/>తస్య ప్రభుస్తమ్ ఆహూయ జగాద, త్వయి యామిమాం కథాం శృణోమి సా కీదృశీ? త్వం గృహకార్య్యాధీశకర్మ్మణో గణనాం దర్శయ గృహకార్య్యాధీశపదే త్వం న స్థాస్యసి|</para>
  <para style="p">
    <verse number="3" style="v"/>తదా స గృహకార్య్యాధీశో మనసా చిన్తయామాస, ప్రభు ర్యది మాం గృహకార్య్యాధీశపదాద్ భ్రంశయతి తర్హి కిం కరిష్యేఽహం? మృదం ఖనితుం మమ శక్తి ర్నాస్తి భిక్షితుఞ్చ లజ్జిష్యేఽహం|</para>
  <para style="p">
    <verse number="4" style="v"/>అతఏవ మయి గృహకార్య్యాధీశపదాత్ చ్యుతే సతి యథా లోకా మహ్యమ్ ఆశ్రయం దాస్యన్తి తదర్థం యత్కర్మ్మ మయా కరణీయం తన్ నిర్ణీయతే|</para>
  <para style="p">
    <verse number="5" style="v"/>పశ్చాత్ స స్వప్రభోరేకైకమ్ అధమర్ణమ్ ఆహూయ ప్రథమం పప్రచ్ఛ, త్వత్తో మే ప్రభుణా కతి ప్రాప్యమ్?</para>
  <para style="p">
    <verse number="6" style="v"/>తతః స ఉవాచ, ఏకశతాఢకతైలాని; తదా గృహకార్య్యాధీశః ప్రోవాచ, తవ పత్రమానీయ శీఘ్రముపవిశ్య తత్ర పఞ్చాశతం లిఖ|</para>
  <para style="p">
    <verse number="7" style="v"/>పశ్చాదన్యమేకం పప్రచ్ఛ, త్వత్తో మే ప్రభుణా కతి ప్రాప్యమ్? తతః సోవాదీద్ ఏకశతాఢకగోధూమాః; తదా స కథయామాస, తవ పత్రమానీయ అశీతిం లిఖ|</para>
  <para style="p">
    <verse number="8" style="v"/>తేనైవ ప్రభుస్తమయథార్థకృతమ్ అధీశం తద్బుద్ధినైపుణ్యాత్ ప్రశశంస; ఇత్థం దీప్తిరూపసన్తానేభ్య ఏతత్సంసారస్య సన్తానా వర్త్తమానకాలేఽధికబుద్ధిమన్తో భవన్తి|</para>
  <para style="p">
    <verse number="9" style="v"/>అతో వదామి యూయమప్యయథార్థేన ధనేన మిత్రాణి లభధ్వం తతో యుష్మాసు పదభ్రష్టేష్వపి తాని చిరకాలమ్ ఆశ్రయం దాస్యన్తి|</para>
  <para style="p">
    <verse number="10" style="v"/>యః కశ్చిత్ క్షుద్రే కార్య్యే విశ్వాస్యో భవతి స మహతి కార్య్యేపి విశ్వాస్యో భవతి, కిన్తు యః కశ్చిత్ క్షుద్రే కార్య్యేఽవిశ్వాస్యో భవతి స మహతి కార్య్యేప్యవిశ్వాస్యో భవతి|</para>
  <para style="p">
    <verse number="11" style="v"/>అతఏవ అయథార్థేన ధనేన యది యూయమవిశ్వాస్యా జాతాస్తర్హి సత్యం ధనం యుష్మాకం కరేషు కః సమర్పయిష్యతి?</para>
  <para style="p">
    <verse number="12" style="v"/>యది చ పరధనేన యూయమ్ అవిశ్వాస్యా భవథ తర్హి యుష్మాకం స్వకీయధనం యుష్మభ్యం కో దాస్యతి?</para>
  <para style="p">
    <verse number="13" style="v"/>కోపి దాస ఉభౌ ప్రభూ సేవితుం న శక్నోతి, యత ఏకస్మిన్ ప్రీయమాణోఽన్యస్మిన్నప్రీయతే యద్వా ఏకం జనం సమాదృత్య తదన్యం తుచ్ఛీకరోతి తద్వద్ యూయమపి ధనేశ్వరౌ సేవితుం న శక్నుథ|</para>
  <para style="p">
    <verse number="14" style="v"/>తదైతాః సర్వ్వాః కథాః శ్రుత్వా లోభిఫిరూశినస్తముపజహసుః|</para>
  <para style="p">
    <verse number="15" style="v"/>తతః స ఉవాచ, యూయం మనుష్యాణాం నికటే స్వాన్ నిర్దోషాన్ దర్శయథ కిన్తు యుష్మాకమ్ అన్తఃకరణానీశ్వరో జానాతి, యత్ మనుష్యాణామ్ అతి ప్రశంస్యం తద్ ఈశ్వరస్య ఘృణ్యం|</para>
  <para style="p">
    <verse number="16" style="v"/>యోహన ఆగమనపర్య్యనతం యుష్మాకం సమీపే వ్యవస్థాభవిష్యద్వాదినాం లేఖనాని చాసన్ తతః ప్రభృతి ఈశ్వరరాజ్యస్య సుసంవాదః ప్రచరతి, ఏకైకో లోకస్తన్మధ్యం యత్నేన ప్రవిశతి చ|</para>
  <para style="p">
    <verse number="17" style="v"/>వరం నభసః పృథివ్యాశ్చ లోపో భవిష్యతి తథాపి వ్యవస్థాయా ఏకబిన్దోరపి లోపో న భవిష్యతి|</para>
  <para style="p">
    <verse number="18" style="v"/>యః కశ్చిత్ స్వీయాం భార్య్యాం విహాయ స్త్రియమన్యాం వివహతి స పరదారాన్ గచ్ఛతి, యశ్చ తా త్యక్తాం నారీం వివహతి సోపి పరదారాన గచ్ఛతి|</para>
  <para style="p">
    <verse number="19" style="v"/>ఏకో ధనీ మనుష్యః శుక్లాని సూక్ష్మాణి వస్త్రాణి పర్య్యదధాత్ ప్రతిదినం పరితోషరూపేణాభుంక్తాపివచ్చ|</para>
  <para style="p">
    <verse number="20" style="v"/>సర్వ్వాఙ్గే క్షతయుక్త ఇలియాసరనామా కశ్చిద్ దరిద్రస్తస్య ధనవతో భోజనపాత్రాత్ పతితమ్ ఉచ్ఛిష్టం భోక్తుం వాఞ్ఛన్ తస్య ద్వారే పతిత్వాతిష్ఠత్;</para>
  <para style="p">
    <verse number="21" style="v"/>అథ శ్వాన ఆగత్య తస్య క్షతాన్యలిహన్|</para>
  <para style="p">
    <verse number="22" style="v"/>కియత్కాలాత్పరం స దరిద్రః ప్రాణాన్ జహౌ; తతః స్వర్గీయదూతాస్తం నీత్వా ఇబ్రాహీమః క్రోడ ఉపవేశయామాసుః|</para>
  <para style="p">
    <verse number="23" style="v"/>పశ్చాత్ స ధనవానపి మమార, తం శ్మశానే స్థాపయామాసుశ్చ; కిన్తు పరలోకే స వేదనాకులః సన్ ఊర్ద్ధ్వాం నిరీక్ష్య బహుదూరాద్ ఇబ్రాహీమం తత్క్రోడ ఇలియాసరఞ్చ విలోక్య రువన్నువాచ;</para>
  <para style="p">
    <verse number="24" style="v"/>హే పితర్ ఇబ్రాహీమ్ అనుగృహ్య అఙ్గుల్యగ్రభాగం జలే మజ్జయిత్వా మమ జిహ్వాం శీతలాం కర్త్తుమ్ ఇలియాసరం ప్రేరయ, యతో వహ్నిశిఖాతోహం వ్యథితోస్మి|</para>
  <para style="p">
    <verse number="25" style="v"/>తదా ఇబ్రాహీమ్ బభాషే, హే పుత్ర త్వం జీవన్ సమ్పదం ప్రాప్తవాన్ ఇలియాసరస్తు విపదం ప్రాప్తవాన్ ఏతత్ స్మర, కిన్తు సమ్ప్రతి తస్య సుఖం తవ చ దుఃఖం భవతి|</para>
  <para style="p">
    <verse number="26" style="v"/>అపరమపి యుష్మాకమ్ అస్మాకఞ్చ స్థానయో ర్మధ్యే మహద్విచ్ఛేదోఽస్తి తత ఏతత్స్థానస్య లోకాస్తత్ స్థానం యాతుం యద్వా తత్స్థానస్య లోకా ఏతత్ స్థానమాయాతుం న శక్నువన్తి|</para>
  <para style="p">
    <verse number="27" style="v"/>తదా స ఉక్తవాన్, హే పితస్తర్హి త్వాం నివేదయామి మమ పితు ర్గేహే యే మమ పఞ్చ భ్రాతరః సన్తి</para>
  <para style="p">
    <verse number="28" style="v"/>తే యథైతద్ యాతనాస్థానం నాయాస్యన్తి తథా మన్త్రణాం దాతుం తేషాం సమీపమ్ ఇలియాసరం ప్రేరయ|</para>
  <para style="p">
    <verse number="29" style="v"/>తత ఇబ్రాహీమ్ ఉవాచ, మూసాభవిష్యద్వాదినాఞ్చ పుస్తకాని తేషాం నికటే సన్తి తే తద్వచనాని మన్యన్తాం|</para>
  <para style="p">
    <verse number="30" style="v"/>తదా స నివేదయామాస, హే పితర్ ఇబ్రాహీమ్ న తథా, కిన్తు యది మృతలోకానాం కశ్చిత్ తేషాం సమీపం యాతి తర్హి తే మనాంసి వ్యాఘోటయిష్యన్తి|</para>
  <para style="p">
    <verse number="31" style="v"/>తత ఇబ్రాహీమ్ జగాద, తే యది మూసాభవిష్యద్వాదినాఞ్చ వచనాని న మన్యన్తే తర్హి మృతలోకానాం కస్మింశ్చిద్ ఉత్థితేపి తే తస్య మన్త్రణాం న మంస్యన్తే|</para>
  <chapter number="17" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ఇతః పరం యీశుః శిష్యాన్ ఉవాచ, విఘ్నైరవశ్యమ్ ఆగన్తవ్యం కిన్తు విఘ్నా యేన ఘటిష్యన్తే తస్య దుర్గతి ర్భవిష్యతి|</para>
  <para style="p">
    <verse number="2" style="v"/>ఏతేషాం క్షుద్రప్రాణినామ్ ఏకస్యాపి విఘ్నజననాత్ కణ్ఠబద్ధపేషణీకస్య తస్య సాగరాగాధజలే మజ్జనం భద్రం|</para>
  <para style="p">
    <verse number="3" style="v"/>యూయం స్వేషు సావధానాస్తిష్ఠత; తవ భ్రాతా యది తవ కిఞ్చిద్ అపరాధ్యతి తర్హి తం తర్జయ, తేన యది మనః పరివర్త్తయతి తర్హి తం క్షమస్వ|</para>
  <para style="p">
    <verse number="4" style="v"/>పునరేకదినమధ్యే యది స తవ సప్తకృత్వోఽపరాధ్యతి కిన్తు సప్తకృత్వ ఆగత్య మనః పరివర్త్య మయాపరాద్ధమ్ ఇతి వదతి తర్హి తం క్షమస్వ|</para>
  <para style="p">
    <verse number="5" style="v"/>తదా ప్రేరితాః ప్రభుమ్ అవదన్ అస్మాకం విశ్వాసం వర్ద్ధయ|</para>
  <para style="p">
    <verse number="6" style="v"/>ప్రభురువాచ, యది యుష్మాకం సర్షపైకప్రమాణో విశ్వాసోస్తి తర్హి త్వం సమూలముత్పాటితో భూత్వా సముద్రే రోపితో భవ కథాయామ్ ఏతస్యామ్ ఏతదుడుమ్బరాయ కథితాయాం స యుష్మాకమాజ్ఞావహో భవిష్యతి|</para>
  <para style="p">
    <verse number="7" style="v"/>అపరం స్వదాసే హలం వాహయిత్వా వా పశూన్ చారయిత్వా క్షేత్రాద్ ఆగతే సతి తం వదతి, ఏహి భోక్తుముపవిశ, యుష్మాకమ్ ఏతాదృశః కోస్తి?</para>
  <para style="p">
    <verse number="8" style="v"/>వరఞ్చ పూర్వ్వం మమ ఖాద్యమాసాద్య యావద్ భుఞ్జే పివామి చ తావద్ బద్ధకటిః పరిచర పశ్చాత్ త్వమపి భోక్ష్యసే పాస్యసి చ కథామీదృశీం కిం న వక్ష్యతి?</para>
  <para style="p">
    <verse number="9" style="v"/>తేన దాసేన ప్రభోరాజ్ఞానురూపే కర్మ్మణి కృతే ప్రభుః కిం తస్మిన్ బాధితో జాతః? నేత్థం బుధ్యతే మయా|</para>
  <para style="p">
    <verse number="10" style="v"/>ఇత్థం నిరూపితేషు సర్వ్వకర్మ్మసు కృతేషు సత్ము యూయమపీదం వాక్యం వదథ, వయమ్ అనుపకారిణో దాసా అస్మాభిర్యద్యత్కర్త్తవ్యం తన్మాత్రమేవ కృతం|</para>
  <para style="p">
    <verse number="11" style="v"/>స యిరూశాలమి యాత్రాం కుర్వ్వన్ శోమిరోణ్గాలీల్ప్రదేశమధ్యేన గచ్ఛతి,</para>
  <para style="p">
    <verse number="12" style="v"/>ఏతర్హి కుత్రచిద్ గ్రామే ప్రవేశమాత్రే దశకుష్ఠినస్తం సాక్షాత్ కృత్వా</para>
  <para style="p">
    <verse number="13" style="v"/>దూరే తిష్ఠనత ఉచ్చై ర్వక్తుమారేభిరే, హే ప్రభో యీశో దయస్వాస్మాన్|</para>
  <para style="p">
    <verse number="14" style="v"/>తతః స తాన్ దృష్ట్వా జగాద, యూయం యాజకానాం సమీపే స్వాన్ దర్శయత, తతస్తే గచ్ఛన్తో రోగాత్ పరిష్కృతాః|</para>
  <para style="p">
    <verse number="15" style="v"/>తదా తేషామేకః స్వం స్వస్థం దృష్ట్వా ప్రోచ్చైరీశ్వరం ధన్యం వదన్ వ్యాఘుట్యాయాతో యీశో ర్గుణాననువదన్ తచ్చరణాధోభూమౌ పపాత;</para>
  <para style="p">
    <verse number="16" style="v"/>స చాసీత్ శోమిరోణీ|</para>
  <para style="p">
    <verse number="17" style="v"/>తదా యీశురవదత్, దశజనాః కిం న పరిష్కృతాః? తహ్యన్యే నవజనాః కుత్ర?</para>
  <para style="p">
    <verse number="18" style="v"/>ఈశ్వరం ధన్యం వదన్తమ్ ఏనం విదేశినం వినా కోప్యన్యో న ప్రాప్యత|</para>
  <para style="p">
    <verse number="19" style="v"/>తదా స తమువాచ, త్వముత్థాయ యాహి విశ్వాసస్తే త్వాం స్వస్థం కృతవాన్|</para>
  <para style="p">
    <verse number="20" style="v"/>అథ కదేశ్వరస్య రాజత్వం భవిష్యతీతి ఫిరూశిభిః పృష్టే స ప్రత్యువాచ, ఈశ్వరస్య రాజత్వమ్ ఐశ్వర్య్యదర్శనేన న భవిష్యతి|</para>
  <para style="p">
    <verse number="21" style="v"/>అత ఏతస్మిన్ పశ్య తస్మిన్ వా పశ్య, ఇతి వాక్యం లోకా వక్తుం న శక్ష్యన్తి, ఈశ్వరస్య రాజత్వం యుష్మాకమ్ అన్తరేవాస్తే|</para>
  <para style="p">
    <verse number="22" style="v"/>తతః స శిష్యాన్ జగాద, యదా యుష్మాభి ర్మనుజసుతస్య దినమేకం ద్రష్టుమ్ వాఞ్ఛిష్యతే కిన్తు న దర్శిష్యతే, ఈదృక్కాల ఆయాతి|</para>
  <para style="p">
    <verse number="23" style="v"/>తదాత్ర పశ్య వా తత్ర పశ్యేతి వాక్యం లోకా వక్ష్యన్తి, కిన్తు తేషాం పశ్చాత్ మా యాత, మానుగచ్ఛత చ|</para>
  <para style="p">
    <verse number="24" style="v"/>యతస్తడిద్ యథాకాశైకదిశ్యుదియ తదన్యామపి దిశం వ్యాప్య ప్రకాశతే తద్వత్ నిజదినే మనుజసూనుః ప్రకాశిష్యతే|</para>
  <para style="p">
    <verse number="25" style="v"/>కిన్తు తత్పూర్వ్వం తేనానేకాని దుఃఖాని భోక్తవ్యాన్యేతద్వర్త్తమానలోకైశ్చ సోఽవజ్ఞాతవ్యః|</para>
  <para style="p">
    <verse number="26" style="v"/>నోహస్య విద్యమానకాలే యథాభవత్ మనుష్యసూనోః కాలేపి తథా భవిష్యతి|</para>
  <para style="p">
    <verse number="27" style="v"/>యావత్కాలం నోహో మహాపోతం నారోహద్ ఆప్లావివార్య్యేత్య సర్వ్వం నానాశయచ్చ తావత్కాలం యథా లోకా అభుఞ్జతాపివన్ వ్యవహన్ వ్యవాహయంశ్చ;</para>
  <para style="p">
    <verse number="28" style="v"/>ఇత్థం లోటో వర్త్తమానకాలేపి యథా లోకా భోజనపానక్రయవిక్రయరోపణగృహనిర్మ్మాణకర్మ్మసు ప్రావర్త్తన్త,</para>
  <para style="p">
    <verse number="29" style="v"/>కిన్తు యదా లోట్ సిదోమో నిర్జగామ తదా నభసః సగన్ధకాగ్నివృష్టి ర్భూత్వా సర్వ్వం వ్యనాశయత్</para>
  <para style="p">
    <verse number="30" style="v"/>తద్వన్ మానవపుత్రప్రకాశదినేపి భవిష్యతి|</para>
  <para style="p">
    <verse number="31" style="v"/>తదా యది కశ్చిద్ గృహోపరి తిష్ఠతి తర్హి స గృహమధ్యాత్ కిమపి ద్రవ్యమానేతుమ్ అవరుహ్య నైతు; యశ్చ క్షేత్రే తిష్ఠతి సోపి వ్యాఘుట్య నాయాతు|</para>
  <para style="p">
    <verse number="32" style="v"/>లోటః పత్నీం స్మరత|</para>
  <para style="p">
    <verse number="33" style="v"/>యః ప్రాణాన్ రక్షితుం చేష్టిష్యతే స ప్రాణాన్ హారయిష్యతి యస్తు ప్రాణాన్ హారయిష్యతి సఏవ ప్రాణాన్ రక్షిష్యతి|</para>
  <para style="p">
    <verse number="34" style="v"/>యుష్మానహం వచ్మి తస్యాం రాత్రౌ శయ్యైకగతయో ర్లోకయోరేకో ధారిష్యతే పరస్త్యక్ష్యతే|</para>
  <para style="p">
    <verse number="35" style="v"/>స్త్రియౌ యుగపత్ పేషణీం వ్యావర్త్తయిష్యతస్తయోరేకా ధారిష్యతే పరాత్యక్ష్యతే|</para>
  <para style="p">
    <verse number="36" style="v"/>పురుషౌ క్షేత్రే స్థాస్యతస్తయోరేకో ధారిష్యతే పరస్త్యక్ష్యతే|</para>
  <para style="p">
    <verse number="37" style="v"/>తదా తే పప్రచ్ఛుః, హే ప్రభో కుత్రేత్థం భవిష్యతి? తతః స ఉవాచ, యత్ర శవస్తిష్ఠతి తత్ర గృధ్రా మిలన్తి|</para>
  <chapter number="18" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అపరఞ్చ లోకైరక్లాన్తై ర్నిరన్తరం ప్రార్థయితవ్యమ్ ఇత్యాశయేన యీశునా దృష్టాన్త ఏకః కథితః|</para>
  <para style="p">
    <verse number="2" style="v"/>కుత్రచిన్నగరే కశ్చిత్ ప్రాడ్వివాక ఆసీత్ స ఈశ్వరాన్నాబిభేత్ మానుషాంశ్చ నామన్యత|</para>
  <para style="p">
    <verse number="3" style="v"/>అథ తత్పురవాసినీ కాచిద్విధవా తత్సమీపమేత్య వివాదినా సహ మమ వివాదం పరిష్కుర్వ్వితి నివేదయామాస|</para>
  <para style="p">
    <verse number="4" style="v"/>తతః స ప్రాడ్వివాకః కియద్దినాని న తదఙ్గీకృతవాన్ పశ్చాచ్చిత్తే చిన్తయామాస, యద్యపీశ్వరాన్న బిభేమి మనుష్యానపి న మన్యే</para>
  <para style="p">
    <verse number="5" style="v"/>తథాప్యేషా విధవా మాం క్లిశ్నాతి తస్మాదస్యా వివాదం పరిష్కరిష్యామి నోచేత్ సా సదాగత్య మాం వ్యగ్రం కరిష్యతి|</para>
  <para style="p">
    <verse number="6" style="v"/>పశ్చాత్ ప్రభురవదద్ అసావన్యాయప్రాడ్వివాకో యదాహ తత్ర మనో నిధధ్వం|</para>
  <para style="p">
    <verse number="7" style="v"/>ఈశ్వరస్య యే ఽభిరుచితలోకా దివానిశం ప్రార్థయన్తే స బహుదినాని విలమ్బ్యాపి తేషాం వివాదాన్ కిం న పరిష్కరిష్యతి?</para>
  <para style="p">
    <verse number="8" style="v"/>యుష్మానహం వదామి త్వరయా పరిష్కరిష్యతి, కిన్తు యదా మనుష్యపుత్ర ఆగమిష్యతి తదా పృథివ్యాం కిమీదృశం విశ్వాసం ప్రాప్స్యతి?</para>
  <para style="p">
    <verse number="9" style="v"/>యే స్వాన్ ధార్మ్మికాన్ జ్ఞాత్వా పరాన్ తుచ్ఛీకుర్వ్వన్తి ఏతాదృగ్భ్యః, కియద్భ్య ఇమం దృష్టాన్తం కథయామాస|</para>
  <para style="p">
    <verse number="10" style="v"/>ఏకః ఫిరూశ్యపరః కరసఞ్చాయీ ద్వావిమౌ ప్రార్థయితుం మన్దిరం గతౌ|</para>
  <para style="p">
    <verse number="11" style="v"/>తతోఽసౌ ఫిరూశ్యేకపార్శ్వే తిష్ఠన్ హే ఈశ్వర అహమన్యలోకవత్ లోఠయితాన్యాయీ పారదారికశ్చ న భవామి అస్య కరసఞ్చాయినస్తుల్యశ్చ న, తస్మాత్త్వాం ధన్యం వదామి|</para>
  <para style="p">
    <verse number="12" style="v"/>సప్తసు దినేషు దినద్వయముపవసామి సర్వ్వసమ్పత్తే ర్దశమాంశం దదామి చ, ఏతత్కథాం కథయన్ ప్రార్థయామాస|</para>
  <para style="p">
    <verse number="13" style="v"/>కిన్తు స కరసఞ్చాయి దూరే తిష్ఠన్ స్వర్గం ద్రష్టుం నేచ్ఛన్ వక్షసి కరాఘాతం కుర్వ్వన్ హే ఈశ్వర పాపిష్ఠం మాం దయస్వ, ఇత్థం ప్రార్థయామాస|</para>
  <para style="p">
    <verse number="14" style="v"/>యుష్మానహం వదామి, తయోర్ద్వయో ర్మధ్యే కేవలః కరసఞ్చాయీ పుణ్యవత్త్వేన గణితో నిజగృహం జగామ, యతో యః కశ్చిత్ స్వమున్నమయతి స నామయిష్యతే కిన్తు యః కశ్చిత్ స్వం నమయతి స ఉన్నమయిష్యతే|</para>
  <para style="p">
    <verse number="15" style="v"/>అథ శిశూనాం గాత్రస్పర్శార్థం లోకాస్తాన్ తస్య సమీపమానిన్యుః శిష్యాస్తద్ దృష్ట్వానేతృన్ తర్జయామాసుః,</para>
  <para style="p">
    <verse number="16" style="v"/>కిన్తు యీశుస్తానాహూయ జగాద, మన్నికటమ్ ఆగన్తుం శిశూన్ అనుజానీధ్వం తాంశ్చ మా వారయత; యత ఈశ్వరరాజ్యాధికారిణ ఏషాం సదృశాః|</para>
  <para style="p">
    <verse number="17" style="v"/>అహం యుష్మాన్ యథార్థం వదామి, యో జనః శిశోః సదృశో భూత్వా ఈశ్వరరాజ్యం న గృహ్లాతి స కేనాపి ప్రకారేణ తత్ ప్రవేష్టుం న శక్నోతి|</para>
  <para style="p">
    <verse number="18" style="v"/>అపరమ్ ఏకోధిపతిస్తం పప్రచ్ఛ, హే పరమగురో, అనన్తాయుషః ప్రాప్తయే మయా కిం కర్త్తవ్యం?</para>
  <para style="p">
    <verse number="19" style="v"/>యీశురువాచ, మాం కుతః పరమం వదసి? ఈశ్వరం వినా కోపి పరమో న భవతి|</para>
  <para style="p">
    <verse number="20" style="v"/>పరదారాన్ మా గచ్ఛ, నరం మా జహి, మా చోరయ, మిథ్యాసాక్ష్యం మా దేహి, మాతరం పితరఞ్చ సంమన్యస్వ, ఏతా యా ఆజ్ఞాః సన్తి తాస్త్వం జానాసి|</para>
  <para style="p">
    <verse number="21" style="v"/>తదా స ఉవాచ, బాల్యకాలాత్ సర్వ్వా ఏతా ఆచరామి|</para>
  <para style="p">
    <verse number="22" style="v"/>ఇతి కథాం శ్రుత్వా యీశుస్తమవదత్, తథాపి తవైకం కర్మ్మ న్యూనమాస్తే, నిజం సర్వ్వస్వం విక్రీయ దరిద్రేభ్యో వితర, తస్మాత్ స్వర్గే ధనం ప్రాప్స్యసి; తత ఆగత్య మమానుగామీ భవ|</para>
  <para style="p">
    <verse number="23" style="v"/>కిన్త్వేతాం కథాం శ్రుత్వా సోధిపతిః శుశోచ, యతస్తస్య బహుధనమాసీత్|</para>
  <para style="p">
    <verse number="24" style="v"/>తదా యీశుస్తమతిశోకాన్వితం దృష్ట్వా జగాద, ధనవతామ్ ఈశ్వరరాజ్యప్రవేశః కీదృగ్ దుష్కరః|</para>
  <para style="p">
    <verse number="25" style="v"/>ఈశ్వరరాజ్యే ధనినః ప్రవేశాత్ సూచేశ్ఛిద్రేణ మహాఙ్గస్య గమనాగమనే సుకరే|</para>
  <para style="p">
    <verse number="26" style="v"/>శ్రోతారః పప్రచ్ఛుస్తర్హి కేన పరిత్రాణం ప్రాప్స్యతే?</para>
  <para style="p">
    <verse number="27" style="v"/>స ఉక్తవాన్, యన్ మానుషేణాశక్యం తద్ ఈశ్వరేణ శక్యం|</para>
  <para style="p">
    <verse number="28" style="v"/>తదా పితర ఉవాచ, పశ్య వయం సర్వ్వస్వం పరిత్యజ్య తవ పశ్చాద్గామినోఽభవామ|</para>
  <para style="p">
    <verse number="29" style="v"/>తతః స ఉవాచ, యుష్మానహం యథార్థం వదామి, ఈశ్వరరాజ్యార్థం గృహం పితరౌ భ్రాతృగణం జాయాం సన్తానాంశ్చ త్యక్తవా</para>
  <para style="p">
    <verse number="30" style="v"/>ఇహ కాలే తతోఽధికం పరకాలే ఽనన్తాయుశ్చ న ప్రాప్స్యతి లోక ఈదృశః కోపి నాస్తి|</para>
  <para style="p">
    <verse number="31" style="v"/>అనన్తరం స ద్వాదశశిష్యానాహూయ బభాషే, పశ్యత వయం యిరూశాలమ్నగరం యామః, తస్మాత్ మనుష్యపుత్రే భవిష్యద్వాదిభిరుక్తం యదస్తి తదనురూపం తం ప్రతి ఘటిష్యతే;</para>
  <para style="p">
    <verse number="32" style="v"/>వస్తుతస్తు సోఽన్యదేశీయానాం హస్తేషు సమర్పయిష్యతే, తే తముపహసిష్యన్తి, అన్యాయమాచరిష్యన్తి తద్వపుషి నిష్ఠీవం నిక్షేప్స్యన్తి, కశాభిః ప్రహృత్య తం హనిష్యన్తి చ,</para>
  <para style="p">
    <verse number="33" style="v"/>కిన్తు తృతీయదినే స శ్మశానాద్ ఉత్థాస్యతి|</para>
  <para style="p">
    <verse number="34" style="v"/>ఏతస్యాః కథాయా అభిప్రాయం కిఞ్చిదపి తే బోద్ధుం న శేకుః తేషాం నికటేఽస్పష్టతవాత్ తస్యైతాసాం కథానామ్ ఆశయం తే జ్ఞాతుం న శేకుశ్చ|</para>
  <para style="p">
    <verse number="35" style="v"/>అథ తస్మిన్ యిరీహోః పురస్యాన్తికం ప్రాప్తే కశ్చిదన్ధః పథః పార్శ్వ ఉపవిశ్య భిక్షామ్ అకరోత్</para>
  <para style="p">
    <verse number="36" style="v"/>స లోకసమూహస్య గమనశబ్దం శ్రుత్వా తత్కారణం పృష్టవాన్|</para>
  <para style="p">
    <verse number="37" style="v"/>నాసరతీయయీశుర్యాతీతి లోకైరుక్తే స ఉచ్చైర్వక్తుమారేభే,</para>
  <para style="p">
    <verse number="38" style="v"/>హే దాయూదః సన్తాన యీశో మాం దయస్వ|</para>
  <para style="p">
    <verse number="39" style="v"/>తతోగ్రగామినస్తం మౌనీ తిష్ఠేతి తర్జయామాసుః కిన్తు స పునారువన్ ఉవాచ, హే దాయూదః సన్తాన మాం దయస్వ|</para>
  <para style="p">
    <verse number="40" style="v"/>తదా యీశుః స్థగితో భూత్వా స్వాన్తికే తమానేతుమ్ ఆదిదేశ|</para>
  <para style="p">
    <verse number="41" style="v"/>తతః స తస్యాన్తికమ్ ఆగమత్, తదా స తం పప్రచ్ఛ, త్వం కిమిచ్ఛసి? త్వదర్థమహం కిం కరిష్యామి? స ఉక్తవాన్, హే ప్రభోఽహం ద్రష్టుం లభై|</para>
  <para style="p">
    <verse number="42" style="v"/>తదా యీశురువాచ, దృష్టిశక్తిం గృహాణ తవ ప్రత్యయస్త్వాం స్వస్థం కృతవాన్|</para>
  <para style="p">
    <verse number="43" style="v"/>తతస్తత్క్షణాత్ తస్య చక్షుషీ ప్రసన్నే; తస్మాత్ స ఈశ్వరం ధన్యం వదన్ తత్పశ్చాద్ యయౌ, తదాలోక్య సర్వ్వే లోకా ఈశ్వరం ప్రశంసితుమ్ ఆరేభిరే|</para>
  <chapter number="19" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>యదా యీశు ర్యిరీహోపురం ప్రవిశ్య తన్మధ్యేన గచ్ఛంస్తదా</para>
  <para style="p">
    <verse number="2" style="v"/>సక్కేయనామా కరసఞ్చాయినాం ప్రధానో ధనవానేకో</para>
  <para style="p">
    <verse number="3" style="v"/>యీశుః కీదృగితి ద్రష్టుం చేష్టితవాన్ కిన్తు ఖర్వ్వత్వాల్లోకసంఘమధ్యే తద్దర్శనమప్రాప్య</para>
  <para style="p">
    <verse number="4" style="v"/>యేన పథా స యాస్యతి తత్పథేఽగ్రే ధావిత్వా తం ద్రష్టుమ్ ఉడుమ్బరతరుమారురోహ|</para>
  <para style="p">
    <verse number="5" style="v"/>పశ్చాద్ యీశుస్తత్స్థానమ్ ఇత్వా ఊర్ద్ధ్వం విలోక్య తం దృష్ట్వావాదీత్, హే సక్కేయ త్వం శీఘ్రమవరోహ మయాద్య త్వద్గేహే వస్తవ్యం|</para>
  <para style="p">
    <verse number="6" style="v"/>తతః స శీఘ్రమవరుహ్య సాహ్లాదం తం జగ్రాహ|</para>
  <para style="p">
    <verse number="7" style="v"/>తద్ దృష్ట్వా సర్వ్వే వివదమానా వక్తుమారేభిరే, సోతిథిత్వేన దుష్టలోకగృహం గచ్ఛతి|</para>
  <para style="p">
    <verse number="8" style="v"/>కిన్తు సక్కేయో దణ్డాయమానో వక్తుమారేభే, హే ప్రభో పశ్య మమ యా సమ్పత్తిరస్తి తదర్ద్ధం దరిద్రేభ్యో దదే, అపరమ్ అన్యాయం కృత్వా కస్మాదపి యది కదాపి కిఞ్చిత్ మయా గృహీతం తర్హి తచ్చతుర్గుణం దదామి|</para>
  <para style="p">
    <verse number="9" style="v"/>తదా యీశుస్తముక్తవాన్ అయమపి ఇబ్రాహీమః సన్తానోఽతః కారణాద్ అద్యాస్య గృహే త్రాణముపస్థితం|</para>
  <para style="p">
    <verse number="10" style="v"/>యద్ హారితం తత్ మృగయితుం రక్షితుఞ్చ మనుష్యపుత్ర ఆగతవాన్|</para>
  <para style="p">
    <verse number="11" style="v"/>అథ స యిరూశాలమః సమీప ఉపాతిష్ఠద్ ఈశ్వరరాజత్వస్యానుష్ఠానం తదైవ భవిష్యతీతి లోకైరన్వభూయత, తస్మాత్ స శ్రోతృభ్యః పునర్దృష్టాన్తకథామ్ ఉత్థాప్య కథయామాస|</para>
  <para style="p">
    <verse number="12" style="v"/>కోపి మహాల్లోకో నిజార్థం రాజత్వపదం గృహీత్వా పునరాగన్తుం దూరదేశం జగామ|</para>
  <para style="p">
    <verse number="13" style="v"/>యాత్రాకాలే నిజాన్ దశదాసాన్ ఆహూయ దశస్వర్ణముద్రా దత్త్వా మమాగమనపర్య్యన్తం వాణిజ్యం కురుతేత్యాదిదేశ|</para>
  <para style="p">
    <verse number="14" style="v"/>కిన్తు తస్య ప్రజాస్తమవజ్ఞాయ మనుష్యమేనమ్ అస్మాకముపరి రాజత్వం న కారయివ్యామ ఇమాం వార్త్తాం తన్నికటే ప్రేరయామాసుః|</para>
  <para style="p">
    <verse number="15" style="v"/>అథ స రాజత్వపదం ప్రాప్యాగతవాన్ ఏకైకో జనో బాణిజ్యేన కిం లబ్ధవాన్ ఇతి జ్ఞాతుం యేషు దాసేషు ముద్రా అర్పయత్ తాన్ ఆహూయానేతుమ్ ఆదిదేశ|</para>
  <para style="p">
    <verse number="16" style="v"/>తదా ప్రథమ ఆగత్య కథితవాన్, హే ప్రభో తవ తయైకయా ముద్రయా దశముద్రా లబ్ధాః|</para>
  <para style="p">
    <verse number="17" style="v"/>తతః స ఉవాచ త్వముత్తమో దాసః స్వల్పేన విశ్వాస్యో జాత ఇతః కారణాత్ త్వం దశనగరాణామ్ అధిపో భవ|</para>
  <para style="p">
    <verse number="18" style="v"/>ద్వితీయ ఆగత్య కథితవాన్, హే ప్రభో తవైకయా ముద్రయా పఞ్చముద్రా లబ్ధాః|</para>
  <para style="p">
    <verse number="19" style="v"/>తతః స ఉవాచ, త్వం పఞ్చానాం నగరాణామధిపతి ర్భవ|</para>
  <para style="p">
    <verse number="20" style="v"/>తతోన్య ఆగత్య కథయామాస, హే ప్రభో పశ్య తవ యా ముద్రా అహం వస్త్రే బద్ధ్వాస్థాపయం సేయం|</para>
  <para style="p">
    <verse number="21" style="v"/>త్వం కృపణో యన్నాస్థాపయస్తదపి గృహ్లాసి, యన్నావపస్తదేవ చ ఛినత్సి తతోహం త్వత్తో భీతః|</para>
  <para style="p">
    <verse number="22" style="v"/>తదా స జగాద, రే దుష్టదాస తవ వాక్యేన త్వాం దోషిణం కరిష్యామి, యదహం నాస్థాపయం తదేవ గృహ్లామి, యదహం నావపఞ్చ తదేవ ఛినద్మి, ఏతాదృశః కృపణోహమితి యది త్వం జానాసి,</para>
  <para style="p">
    <verse number="23" style="v"/>తర్హి మమ ముద్రా బణిజాం నికటే కుతో నాస్థాపయః? తయా కృతేఽహమ్ ఆగత్య కుసీదేన సార్ద్ధం నిజముద్రా అప్రాప్స్యమ్|</para>
  <para style="p">
    <verse number="24" style="v"/>పశ్చాత్ స సమీపస్థాన్ జనాన్ ఆజ్ఞాపయత్ అస్మాత్ ముద్రా ఆనీయ యస్య దశముద్రాః సన్తి తస్మై దత్త|</para>
  <para style="p">
    <verse number="25" style="v"/>తే ప్రోచుః ప్రభోఽస్య దశముద్రాః సన్తి|</para>
  <para style="p">
    <verse number="26" style="v"/>యుష్మానహం వదామి యస్యాశ్రయే వద్ధతే ఽధికం తస్మై దాయిష్యతే, కిన్తు యస్యాశ్రయే న వర్ద్ధతే తస్య యద్యదస్తి తదపి తస్మాన్ నాయిష్యతే|</para>
  <para style="p">
    <verse number="27" style="v"/>కిన్తు మమాధిపతిత్వస్య వశత్వే స్థాతుమ్ అసమ్మన్యమానా యే మమ రిపవస్తానానీయ మమ సమక్షం సంహరత|</para>
  <para style="p">
    <verse number="28" style="v"/>ఇత్యుపదేశకథాం కథయిత్వా సోగ్రగః సన్ యిరూశాలమపురం యయౌ|</para>
  <para style="p">
    <verse number="29" style="v"/>తతో బైత్ఫగీబైథనీయాగ్రామయోః సమీపే జైతునాద్రేరన్తికమ్ ఇత్వా శిష్యద్వయమ్ ఇత్యుక్త్వా ప్రేషయామాస,</para>
  <para style="p">
    <verse number="30" style="v"/>యువామముం సమ్ముఖస్థగ్రామం ప్రవిశ్యైవ యం కోపి మానుషః కదాపి నారోహత్ తం గర్ద్దభశావకం బద్ధం ద్రక్ష్యథస్తం మోచయిత్వానయతం|</para>
  <para style="p">
    <verse number="31" style="v"/>తత్ర కుతో మోచయథః? ఇతి చేత్ కోపి వక్ష్యతి తర్హి వక్ష్యథః ప్రభేाరత్ర ప్రయోజనమ్ ఆస్తే|</para>
  <para style="p">
    <verse number="32" style="v"/>తదా తౌ ప్రరితౌ గత్వా తత్కథాाనుసారేణ సర్వ్వం ప్రాప్తౌ|</para>
  <para style="p">
    <verse number="33" style="v"/>గర్దభశావకమోచనకాలే తత్వామిన ఊచుః, గర్దభశావకం కుతో మోచయథః?</para>
  <para style="p">
    <verse number="34" style="v"/>తావూచతుః ప్రభోరత్ర ప్రయోజనమ్ ఆస్తే|</para>
  <para style="p">
    <verse number="35" style="v"/>పశ్చాత్ తౌ తం గర్దభశావకం యీశోరన్తికమానీయ తత్పృష్ఠే నిజవసనాని పాతయిత్వా తదుపరి యీశుమారోహయామాసతుః|</para>
  <para style="p">
    <verse number="36" style="v"/>అథ యాత్రాకాలే లోకాః పథి స్వవస్త్రాణి పాతయితుమ్ ఆరేభిరే|</para>
  <para style="p">
    <verse number="37" style="v"/>అపరం జైతునాద్రేరుపత్యకామ్ ఇత్వా శిష్యసంఘః పూర్వ్వదృష్టాని మహాకర్మ్మాణి స్మృత్వా,</para>
  <para style="p">
    <verse number="38" style="v"/>యో రాజా ప్రభో ర్నామ్నాయాతి స ధన్యః స్వర్గే కుశలం సర్వ్వోచ్చే జయధ్వని ర్భవతు, కథామేతాం కథయిత్వా సానన్దమ్ ఉచైరీశ్వరం ధన్యం వక్తుమారేభే|</para>
  <para style="p">
    <verse number="39" style="v"/>తదా లోకారణ్యమధ్యస్థాః కియన్తః ఫిరూశినస్తత్ శ్రుత్వా యీశుం ప్రోచుః, హే ఉపదేశక స్వశిష్యాన్ తర్జయ|</para>
  <para style="p">
    <verse number="40" style="v"/>స ఉవాచ, యుష్మానహం వదామి యద్యమీ నీరవాస్తిష్ఠన్తి తర్హి పాషాణా ఉచైః కథాః కథయిష్యన్తి|</para>
  <para style="p">
    <verse number="41" style="v"/>పశ్చాత్ తత్పురాన్తికమేత్య తదవలోక్య సాశ్రుపాతం జగాద,</para>
  <para style="p">
    <verse number="42" style="v"/>హా హా చేత్ త్వమగ్రేఽజ్ఞాస్యథాః, తవాస్మిన్నేవ దినే వా యది స్వమఙ్గలమ్ ఉపాలప్స్యథాః, తర్హ్యుత్తమమ్ అభవిష్యత్, కిన్తు క్షణేస్మిన్ తత్తవ దృష్టేరగోచరమ్ భవతి|</para>
  <para style="p">
    <verse number="43" style="v"/>త్వం స్వత్రాణకాలే న మనో న్యధత్థా ఇతి హేతో ర్యత్కాలే తవ రిపవస్త్వాం చతుర్దిక్షు ప్రాచీరేణ వేష్టయిత్వా రోత్స్యన్తి</para>
  <para style="p">
    <verse number="44" style="v"/>బాలకైః సార్ద్ధం భూమిసాత్ కరిష్యన్తి చ త్వన్మధ్యే పాషాణైకోపి పాషాణోపరి న స్థాస్యతి చ, కాల ఈదృశ ఉపస్థాస్యతి|</para>
  <para style="p">
    <verse number="45" style="v"/>అథ మధ్యేమన్దిరం ప్రవిశ్య తత్రత్యాన్ క్రయివిక్రయిణో బహిష్కుర్వ్వన్</para>
  <para style="p">
    <verse number="46" style="v"/>అవదత్ మద్గృహం ప్రార్థనాగృహమితి లిపిరాస్తే కిన్తు యూయం తదేవ చైరాణాం గహ్వరం కురుథ|</para>
  <para style="p">
    <verse number="47" style="v"/>పశ్చాత్ స ప్రత్యహం మధ్యేమన్దిరమ్ ఉపదిదేశ; తతః ప్రధానయాజకా అధ్యాపకాః ప్రాచీనాశ్చ తం నాశయితుం చిచేష్టిరే;</para>
  <para style="p">
    <verse number="48" style="v"/>కిన్తు తదుపదేశే సర్వ్వే లోకా నివిష్టచిత్తాః స్థితాస్తస్మాత్ తే తత్కర్త్తుం నావకాశం ప్రాపుః|</para>
  <chapter number="20" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అథైకదా యీశు ర్మనిదరే సుసంవాదం ప్రచారయన్ లోకానుపదిశతి, ఏతర్హి ప్రధానయాజకా అధ్యాపకాః ప్రాఞ్చశ్చ తన్నికటమాగత్య పప్రచ్ఛుః</para>
  <para style="p">
    <verse number="2" style="v"/>కయాజ్ఞయా త్వం కర్మ్మాణ్యేతాని కరోషి? కో వా త్వామాజ్ఞాపయత్? తదస్మాన్ వద|</para>
  <para style="p">
    <verse number="3" style="v"/>స ప్రత్యువాచ, తర్హి యుష్మానపి కథామేకాం పృచ్ఛామి తస్యోత్తరం వదత|</para>
  <para style="p">
    <verse number="4" style="v"/>యోహనో మజ్జనమ్ ఈశ్వరస్య మానుషాణాం వాజ్ఞాతో జాతం?</para>
  <para style="p">
    <verse number="5" style="v"/>తతస్తే మిథో వివిచ్య జగదుః, యదీశ్వరస్య వదామస్తర్హి తం కుతో న ప్రత్యైత స ఇతి వక్ష్యతి|</para>
  <para style="p">
    <verse number="6" style="v"/>యది మనుష్యస్యేతి వదామస్తర్హి సర్వ్వే లోకా అస్మాన్ పాషాణై ర్హనిష్యన్తి యతో యోహన్ భవిష్యద్వాదీతి సర్వ్వే దృఢం జానన్తి|</para>
  <para style="p">
    <verse number="7" style="v"/>అతఏవ తే ప్రత్యూచుః కస్యాజ్ఞయా జాతమ్ ఇతి వక్తుం న శక్నుమః|</para>
  <para style="p">
    <verse number="8" style="v"/>తదా యీశురవదత్ తర్హి కయాజ్ఞయా కర్మ్మాణ్యేతాతి కరోమీతి చ యుష్మాన్ న వక్ష్యామి|</para>
  <para style="p">
    <verse number="9" style="v"/>అథ లోకానాం సాక్షాత్ స ఇమాం దృష్టాన్తకథాం వక్తుమారేభే, కశ్చిద్ ద్రాక్షాక్షేత్రం కృత్వా తత్ క్షేత్రం కృషీవలానాం హస్తేషు సమర్ప్య బహుకాలార్థం దూరదేశం జగామ|</para>
  <para style="p">
    <verse number="10" style="v"/>అథ ఫలకాలే ఫలాని గ్రహీతు కృషీవలానాం సమీపే దాసం ప్రాహిణోత్ కిన్తు కృషీవలాస్తం ప్రహృత్య రిక్తహస్తం విససర్జుః|</para>
  <para style="p">
    <verse number="11" style="v"/>తతః సోధిపతిః పునరన్యం దాసం ప్రేషయామాస, తే తమపి ప్రహృత్య కువ్యవహృత్య రిక్తహస్తం విససృజుః|</para>
  <para style="p">
    <verse number="12" style="v"/>తతః స తృతీయవారమ్ అన్యం ప్రాహిణోత్ తే తమపి క్షతాఙ్గం కృత్వా బహి ర్నిచిక్షిపుః|</para>
  <para style="p">
    <verse number="13" style="v"/>తదా క్షేత్రపతి ర్విచారయామాస, మమేదానీం కిం కర్త్తవ్యం? మమ ప్రియే పుత్రే ప్రహితే తే తమవశ్యం దృష్ట్వా సమాదరిష్యన్తే|</para>
  <para style="p">
    <verse number="14" style="v"/>కిన్తు కృషీవలాస్తం నిరీక్ష్య పరస్పరం వివిచ్య ప్రోచుః, అయముత్తరాధికారీ ఆగచ్ఛతైనం హన్మస్తతోధికారోస్మాకం భవిష్యతి|</para>
  <para style="p">
    <verse number="15" style="v"/>తతస్తే తం క్షేత్రాద్ బహి ర్నిపాత్య జఘ్నుస్తస్మాత్ స క్షేత్రపతిస్తాన్ ప్రతి కిం కరిష్యతి?</para>
  <para style="p">
    <verse number="16" style="v"/>స ఆగత్య తాన్ కృషీవలాన్ హత్వా పరేషాం హస్తేషు తత్క్షేత్రం సమర్పయిష్యతి; ఇతి కథాం శ్రుత్వా తే ఽవదన్ ఏతాదృశీ ఘటనా న భవతు|</para>
  <para style="p">
    <verse number="17" style="v"/>కిన్తు యీశుస్తానవలోక్య జగాద, తర్హి, స్థపతయః కరిష్యన్తి గ్రావాణం యన్తు తుచ్ఛకం| ప్రధానప్రస్తరః కోణే స ఏవ హి భవిష్యతి| ఏతస్య శాస్త్రీయవచనస్య కిం తాత్పర్య్యం?</para>
  <para style="p">
    <verse number="18" style="v"/>అపరం తత్పాషాణోపరి యః పతిష్యతి స భంక్ష్యతే కిన్తు యస్యోపరి స పాషాణః పతిష్యతి స తేన ధూలివచ్ చూర్ణీభవిష్యతి|</para>
  <para style="p">
    <verse number="19" style="v"/>సోస్మాకం విరుద్ధం దృష్టాన్తమిమం కథితవాన్ ఇతి జ్ఞాత్వా ప్రధానయాజకా అధ్యాపకాశ్చ తదైవ తం ధర్తుం వవాఞ్ఛుః కిన్తు లోకేభ్యో బిభ్యుః|</para>
  <para style="p">
    <verse number="20" style="v"/>అతఏవ తం ప్రతి సతర్కాః సన్తః కథం తద్వాక్యదోషం ధృత్వా తం దేశాధిపస్య సాధువేశధారిణశ్చరాన్ తస్య సమీపే ప్రేషయామాసుః|</para>
  <para style="p">
    <verse number="21" style="v"/>తదా తే తం పప్రచ్ఛుః, హే ఉపదేశక భవాన్ యథార్థం కథయన్ ఉపదిశతి, కమప్యనపేక్ష్య సత్యత్వేనైశ్వరం మార్గముపదిశతి, వయమేతజ్జానీమః|</para>
  <para style="p">
    <verse number="22" style="v"/>కైసరరాజాయ కరోస్మాభి ర్దేయో న వా?</para>
  <para style="p">
    <verse number="23" style="v"/>స తేషాం వఞ్చనం జ్ఞాత్వావదత్ కుతో మాం పరీక్షధ్వే? మాం ముద్రామేకం దర్శయత|</para>
  <para style="p">
    <verse number="24" style="v"/>ఇహ లిఖితా మూర్తిరియం నామ చ కస్య? తేఽవదన్ కైసరస్య|</para>
  <para style="p">
    <verse number="25" style="v"/>తదా స ఉవాచ, తర్హి కైసరస్య ద్రవ్యం కైసరాయ దత్త; ఈశ్వరస్య తు ద్రవ్యమీశ్వరాయ దత్త|</para>
  <para style="p">
    <verse number="26" style="v"/>తస్మాల్లోకానాం సాక్షాత్ తత్కథాయాః కమపి దోషం ధర్తుమప్రాప్య తే తస్యోత్తరాద్ ఆశ్చర్య్యం మన్యమానా మౌనినస్తస్థుః|</para>
  <para style="p">
    <verse number="27" style="v"/>అపరఞ్చ శ్మశానాదుత్థానానఙ్గీకారిణాం సిదూకినాం కియన్తో జనా ఆగత్య తం పప్రచ్ఛుః,</para>
  <para style="p">
    <verse number="28" style="v"/>హే ఉపదేశక శాస్త్రే మూసా అస్మాన్ ప్రతీతి లిలేఖ యస్య భ్రాతా భార్య్యాయాం సత్యాం నిఃసన్తానో మ్రియతే స తజ్జాయాం వివహ్య తద్వంశమ్ ఉత్పాదయిష్యతి|</para>
  <para style="p">
    <verse number="29" style="v"/>తథాచ కేచిత్ సప్త భ్రాతర ఆసన్ తేషాం జ్యేష్ఠో భ్రాతా వివహ్య నిరపత్యః ప్రాణాన్ జహౌ|</para>
  <para style="p">
    <verse number="30" style="v"/>అథ ద్వితీయస్తస్య జాయాం వివహ్య నిరపత్యః సన్ మమార| తృతీయశ్చ తామేవ వ్యువాహ;</para>
  <para style="p">
    <verse number="31" style="v"/>ఇత్థం సప్త భ్రాతరస్తామేవ వివహ్య నిరపత్యాః సన్తో మమ్రుః|</para>
  <para style="p">
    <verse number="32" style="v"/>శేషే సా స్త్రీ చ మమార|</para>
  <para style="p">
    <verse number="33" style="v"/>అతఏవ శ్మశానాదుత్థానకాలే తేషాం సప్తజనానాం కస్య సా భార్య్యా భవిష్యతి? యతః సా తేషాం సప్తానామేవ భార్య్యాసీత్|</para>
  <para style="p">
    <verse number="34" style="v"/>తదా యీశుః ప్రత్యువాచ, ఏతస్య జగతో లోకా వివహన్తి వాగ్దత్తాశ్చ భవన్తి</para>
  <para style="p">
    <verse number="35" style="v"/>కిన్తు యే తజ్జగత్ప్రాప్తియోగ్యత్వేన గణితాం భవిష్యన్తి శ్మశానాచ్చోత్థాస్యన్తి తే న వివహన్తి వాగ్దత్తాశ్చ న భవన్తి,</para>
  <para style="p">
    <verse number="36" style="v"/>తే పున ర్న మ్రియన్తే కిన్తు శ్మశానాదుత్థాపితాః సన్త ఈశ్వరస్య సన్తానాః స్వర్గీయదూతానాం సదృశాశ్చ భవన్తి|</para>
  <para style="p">
    <verse number="37" style="v"/>అధికన్తు మూసాః స్తమ్బోపాఖ్యానే పరమేశ్వర ఈబ్రాహీమ ఈశ్వర ఇస్హాక ఈశ్వరో యాకూబశ్చేశ్వర ఇత్యుక్త్వా మృతానాం శ్మశానాద్ ఉత్థానస్య ప్రమాణం లిలేఖ|</para>
  <para style="p">
    <verse number="38" style="v"/>అతఏవ య ఈశ్వరః స మృతానాం ప్రభు ర్న కిన్తు జీవతామేవ ప్రభుః, తన్నికటే సర్వ్వే జీవన్తః సన్తి|</para>
  <para style="p">
    <verse number="39" style="v"/>ఇతి శ్రుత్వా కియన్తోధ్యాపకా ఊచుః, హే ఉపదేశక భవాన్ భద్రం ప్రత్యుక్తవాన్|</para>
  <para style="p">
    <verse number="40" style="v"/>ఇతః పరం తం కిమపి ప్రష్టం తేషాం ప్రగల్భతా నాభూత్|</para>
  <para style="p">
    <verse number="41" style="v"/>పశ్చాత్ స తాన్ ఉవాచ, యః ఖ్రీష్టః స దాయూదః సన్తాన ఏతాం కథాం లోకాః కథం కథయన్తి?</para>
  <para style="p">
    <verse number="42" style="v"/>యతః మమ ప్రభుమిదం వాక్యమవదత్ పరమేశ్వరః| తవ శత్రూనహం యావత్ పాదపీఠం కరోమి న| తావత్ కాలం మదీయే త్వం దక్షపార్శ్వ ఉపావిశ|</para>
  <para style="p">
    <verse number="43" style="v"/>ఇతి కథాం దాయూద్ స్వయం గీతగ్రన్థేఽవదత్|</para>
  <para style="p">
    <verse number="44" style="v"/>అతఏవ యది దాయూద్ తం ప్రభుం వదతి, తర్హి స కథం తస్య సన్తానో భవతి?</para>
  <para style="p">
    <verse number="45" style="v"/>పశ్చాద్ యీశుః సర్వ్వజనానాం కర్ణగోచరే శిష్యానువాచ,</para>
  <para style="p">
    <verse number="46" style="v"/>యేఽధ్యాపకా దీర్ఘపరిచ్ఛదం పరిధాయ భ్రమన్తి, హట్టాపణయో ర్నమస్కారే భజనగేహస్య ప్రోచ్చాసనే భోజనగృహస్య ప్రధానస్థానే చ ప్రీయన్తే</para>
  <para style="p">
    <verse number="47" style="v"/>విధవానాం సర్వ్వస్వం గ్రసిత్వా ఛలేన దీర్ఘకాలం ప్రార్థయన్తే చ తేషు సావధానా భవత, తేషాముగ్రదణ్డో భవిష్యతి|</para>
  <chapter number="21" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అథ ధనిలోకా భాణ్డాగారే ధనం నిక్షిపన్తి స తదేవ పశ్యతి,</para>
  <para style="p">
    <verse number="2" style="v"/>ఏతర్హి కాచిద్దీనా విధవా పణద్వయం నిక్షిపతి తద్ దదర్శ|</para>
  <para style="p">
    <verse number="3" style="v"/>తతో యీశురువాచ యుష్మానహం యథార్థం వదామి, దరిద్రేయం విధవా సర్వ్వేభ్యోధికం న్యక్షేప్సీత్,</para>
  <para style="p">
    <verse number="4" style="v"/>యతోన్యే స్వప్రాజ్యధనేభ్య ఈశ్వరాయ కిఞ్చిత్ న్యక్షేప్సుః, కిన్తు దరిద్రేయం విధవా దినయాపనార్థం స్వస్య యత్ కిఞ్చిత్ స్థితం తత్ సర్వ్వం న్యక్షేప్సీత్|</para>
  <para style="p">
    <verse number="5" style="v"/>అపరఞ్చ ఉత్తమప్రస్తరైరుత్సృష్టవ్యైశ్చ మన్దిరం సుశోభతేతరాం కైశ్చిదిత్యుక్తే స ప్రత్యువాచ</para>
  <para style="p">
    <verse number="6" style="v"/>యూయం యదిదం నిచయనం పశ్యథ, అస్య పాషాణైకోప్యన్యపాషాణోపరి న స్థాస్యతి, సర్వ్వే భూసాద్భవిష్యన్తి కాలోయమాయాతి|</para>
  <para style="p">
    <verse number="7" style="v"/>తదా తే పప్రచ్ఛుః, హే గురో ఘటనేదృశీ కదా భవిష్యతి? ఘటనాయా ఏతస్యసశ్చిహ్నం వా కిం భవిష్యతి?</para>
  <para style="p">
    <verse number="8" style="v"/>తదా స జగాద, సావధానా భవత యథా యుష్మాకం భ్రమం కోపి న జనయతి, ఖీష్టోహమిత్యుక్త్వా మమ నామ్రా బహవ ఉపస్థాస్యన్తి స కాలః ప్రాయేణోపస్థితః, తేషాం పశ్చాన్మా గచ్ఛత|</para>
  <para style="p">
    <verse number="9" style="v"/>యుద్ధస్యోపప్లవస్య చ వార్త్తాం శ్రుత్వా మా శఙ్కధ్వం, యతః ప్రథమమ్ ఏతా ఘటనా అవశ్యం భవిష్యన్తి కిన్తు నాపాతే యుగాన్తో భవిష్యతి|</para>
  <para style="p">
    <verse number="10" style="v"/>అపరఞ్చ కథయామాస, తదా దేశస్య విపక్షత్వేన దేశో రాజ్యస్య విపక్షత్వేన రాజ్యమ్ ఉత్థాస్యతి,</para>
  <para style="p">
    <verse number="11" style="v"/>నానాస్థానేషు మహాభూకమ్పో దుర్భిక్షం మారీ చ భవిష్యన్తి, తథా వ్యోమమణ్డలస్య భయఙ్కరదర్శనాన్యశ్చర్య్యలక్షణాని చ ప్రకాశయిష్యన్తే|</para>
  <para style="p">
    <verse number="12" style="v"/>కిన్తు సర్వ్వాసామేతాసాం ఘటనానాం పూర్వ్వం లోకా యుష్మాన్ ధృత్వా తాడయిష్యన్తి, భజనాలయే కారాయాఞ్చ సమర్పయిష్యన్తి మమ నామకారణాద్ యుష్మాన్ భూపానాం శాసకానాఞ్చ సమ్ముఖం నేష్యన్తి చ|</para>
  <para style="p">
    <verse number="13" style="v"/>సాక్ష్యార్థమ్ ఏతాని యుష్మాన్ ప్రతి ఘటిష్యన్తే|</para>
  <para style="p">
    <verse number="14" style="v"/>తదా కిముత్తరం వక్తవ్యమ్ ఏతత్ న చిన్తయిష్యామ ఇతి మనఃసు నిశ్చితనుత|</para>
  <para style="p">
    <verse number="15" style="v"/>విపక్షా యస్మాత్ కిమప్యుత్తరమ్ ఆపత్తిఞ్చ కర్త్తుం న శక్ష్యన్తి తాదృశం వాక్పటుత్వం జ్ఞానఞ్చ యుష్మభ్యం దాస్యామి|</para>
  <para style="p">
    <verse number="16" style="v"/>కిఞ్చ యూయం పిత్రా మాత్రా భ్రాత్రా బన్ధునా జ్ఞాత్యా కుటుమ్బేన చ పరకరేషు సమర్పయిష్యధ్వే; తతస్తే యుష్మాకం కఞ్చన కఞ్చన ఘాతయిష్యన్తి|</para>
  <para style="p">
    <verse number="17" style="v"/>మమ నామ్నః కారణాత్ సర్వ్వై ర్మనుష్యై ర్యూయమ్ ఋతీయిష్యధ్వే|</para>
  <para style="p">
    <verse number="18" style="v"/>కిన్తు యుష్మాకం శిరఃకేశైకోపి న వినంక్ష్యతి,</para>
  <para style="p">
    <verse number="19" style="v"/>తస్మాదేవ ధైర్య్యమవలమ్బ్య స్వస్వప్రాణాన్ రక్షత|</para>
  <para style="p">
    <verse number="20" style="v"/>అపరఞ్చ యిరూశాలమ్పురం సైన్యవేష్టితం విలోక్య తస్యోచ్ఛిన్నతాయాః సమయః సమీప ఇత్యవగమిష్యథ|</para>
  <para style="p">
    <verse number="21" style="v"/>తదా యిహూదాదేశస్థా లోకాః పర్వ్వతం పలాయన్తాం, యే చ నగరే తిష్ఠన్తి తే దేశాన్తరం పలాయన్తా, యే చ గ్రామే తిష్ఠన్తి తే నగరం న ప్రవిశన్తు,</para>
  <para style="p">
    <verse number="22" style="v"/>యతస్తదా సముచితదణ్డనాయ ధర్మ్మపుస్తకే యాని సర్వ్వాణి లిఖితాని తాని సఫలాని భవిష్యన్తి|</para>
  <para style="p">
    <verse number="23" style="v"/>కిన్తు యా యాస్తదా గర్భవత్యః స్తన్యదావ్యశ్చ తామాం దుర్గతి ర్భవిష్యతి, యత ఏతాల్లోకాన్ ప్రతి కోపో దేశే చ విషమదుర్గతి ర్ఘటిష్యతే|</para>
  <para style="p">
    <verse number="24" style="v"/>వస్తుతస్తు తే ఖఙ్గధారపరివ్వఙ్గం లప్స్యన్తే బద్ధాః సన్తః సర్వ్వదేశేషు నాయిష్యన్తే చ కిఞ్చాన్యదేశీయానాం సమయోపస్థితిపర్య్యన్తం యిరూశాలమ్పురం తైః పదతలై ర్దలయిష్యతే|</para>
  <para style="p">
    <verse number="25" style="v"/>సూర్య్యచన్ద్రనక్షత్రేషు లక్షణాది భవిష్యన్తి, భువి సర్వ్వదేశీయానాం దుఃఖం చిన్తా చ సిన్ధౌ వీచీనాం తర్జనం గర్జనఞ్చ భవిష్యన్తి|</para>
  <para style="p">
    <verse number="26" style="v"/>భూభౌ భావిఘటనాం చిన్తయిత్వా మనుజా భియామృతకల్పా భవిష్యన్తి, యతో వ్యోమమణ్డలే తేజస్వినో దోలాయమానా భవిష్యన్తి|</para>
  <para style="p">
    <verse number="27" style="v"/>తదా పరాక్రమేణా మహాతేజసా చ మేఘారూఢం మనుష్యపుత్రమ్ ఆయాన్తం ద్రక్ష్యన్తి|</para>
  <para style="p">
    <verse number="28" style="v"/>కిన్త్వేతాసాం ఘటనానామారమ్భే సతి యూయం మస్తకాన్యుత్తోల్య ఊర్దధ్వం ద్రక్ష్యథ, యతో యుష్మాకం ముక్తేః కాలః సవిధో భవిష్యతి|</para>
  <para style="p">
    <verse number="29" style="v"/>తతస్తేనైతదృష్టాన్తకథా కథితా, పశ్యత ఉడుమ్బరాదివృక్షాణాం</para>
  <para style="p">
    <verse number="30" style="v"/>నవీనపత్రాణి జాతానీతి దృష్ట్వా నిదావకాల ఉపస్థిత ఇతి యథా యూయం జ్ఞాతుం శక్నుథ,</para>
  <para style="p">
    <verse number="31" style="v"/>తథా సర్వ్వాసామాసాం ఘటనానామ్ ఆరమ్భే దృష్టే సతీశ్వరస్య రాజత్వం నికటమ్ ఇత్యపి జ్ఞాస్యథ|</para>
  <para style="p">
    <verse number="32" style="v"/>యుష్మానహం యథార్థం వదామి, విద్యమానలోకానామేషాం గమనాత్ పూర్వ్వమ్ ఏతాని ఘటిష్యన్తే|</para>
  <para style="p">
    <verse number="33" style="v"/>నభోభువోర్లోపో భవిష్యతి మమ వాక్ తు కదాపి లుప్తా న భవిష్యతి|</para>
  <para style="p">
    <verse number="34" style="v"/>అతఏవ విషమాశనేన పానేన చ సాంమారికచిన్తాభిశ్చ యుష్మాకం చిత్తేషు మత్తేషు తద్దినమ్ అకస్మాద్ యుష్మాన్ ప్రతి యథా నోపతిష్ఠతి తదర్థం స్వేషు సావధానాస్తిష్ఠత|</para>
  <para style="p">
    <verse number="35" style="v"/>పృథివీస్థసర్వ్వలోకాన్ ప్రతి తద్దినమ్ ఉన్మాథ ఇవ ఉపస్థాస్యతి|</para>
  <para style="p">
    <verse number="36" style="v"/>యథా యూయమ్ ఏతద్భావిఘటనా ఉత్తర్త్తుం మనుజసుతస్య సమ్ముఖే సంస్థాతుఞ్చ యోగ్యా భవథ కారణాదస్మాత్ సావధానాః సన్తో నిరన్తరం ప్రార్థయధ్వం|</para>
  <para style="p">
    <verse number="37" style="v"/>అపరఞ్చ స దివా మన్దిర ఉపదిశ్య రాచై జైతునాద్రిం గత్వాతిష్ఠత్|</para>
  <para style="p">
    <verse number="38" style="v"/>తతః ప్రత్యూషే లాకాస్తత్కథాం శ్రోతుం మన్దిరే తదన్తికమ్ ఆగచ్ఛన్|</para>
  <chapter number="22" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అపరఞ్చ కిణ్వశూన్యపూపోత్సవస్య కాల ఉపస్థితే</para>
  <para style="p">
    <verse number="2" style="v"/>ప్రధానయాజకా అధ్యాయకాశ్చ యథా తం హన్తుం శక్నువన్తి తథోపాయామ్ అచేష్టన్త కిన్తు లోకేభ్యో బిభ్యుః|</para>
  <para style="p">
    <verse number="3" style="v"/>ఏతస్తిన్ సమయే ద్వాదశశిష్యేషు గణిత ఈష్కరియోతీయరూఢిమాన్ యో యిహూదాస్తస్యాన్తఃకరణం శైతానాశ్రితత్వాత్</para>
  <para style="p">
    <verse number="4" style="v"/>స గత్వా యథా యీశుం తేషాం కరేషు సమర్పయితుం శక్నోతి తథా మన్త్రణాం ప్రధానయాజకైః సేనాపతిభిశ్చ సహ చకార|</para>
  <para style="p">
    <verse number="5" style="v"/>తేన తే తుష్టాస్తస్మై ముద్రాం దాతుం పణం చక్రుః|</para>
  <para style="p">
    <verse number="6" style="v"/>తతః సోఙ్గీకృత్య యథా లోకానామగోచరే తం పరకరేషు సమర్పయితుం శక్నోతి తథావకాశం చేష్టితుమారేభే|</para>
  <para style="p">
    <verse number="7" style="v"/>అథ కిణ్వశూన్యపూపోత్మవదినే, అర్థాత్ యస్మిన్ దినే నిస్తారోత్సవస్య మేషో హన్తవ్యస్తస్మిన్ దినే</para>
  <para style="p">
    <verse number="8" style="v"/>యీశుః పితరం యోహనఞ్చాహూయ జగాద, యువాం గత్వాస్మాకం భోజనార్థం నిస్తారోత్సవస్య ద్రవ్యాణ్యాసాదయతం|</para>
  <para style="p">
    <verse number="9" style="v"/>తదా తౌ పప్రచ్ఛతుః కుచాసాదయావో భవతః కేచ్ఛా?</para>
  <para style="p">
    <verse number="10" style="v"/>తదా సోవాదీత్, నగరే ప్రవిష్టే కశ్చిజ్జలకుమ్భమాదాయ యువాం సాక్షాత్ కరిష్యతి స యన్నివేశనం ప్రవిశతి యువామపి తన్నివేశనం తత్పశ్చాదిత్వా నివేశనపతిమ్ ఇతి వాక్యం వదతం,</para>
  <para style="p">
    <verse number="11" style="v"/>యత్రాహం నిస్తారోత్సవస్య భోజ్యం శిష్యైః సార్ద్ధం భోక్తుం శక్నోమి సాతిథిశాలాा కుత్ర? కథామిమాం ప్రభుస్త్వాం పృచ్ఛతి|</para>
  <para style="p">
    <verse number="12" style="v"/>తతః స జనో ద్వితీయప్రకోష్ఠీయమ్ ఏకం శస్తం కోష్ఠం దర్శయిష్యతి తత్ర భోజ్యమాసాదయతం|</para>
  <para style="p">
    <verse number="13" style="v"/>తతస్తౌ గత్వా తద్వాక్యానుసారేణ సర్వ్వం దృష్ద్వా తత్ర నిస్తారోత్సవీయం భోజ్యమాసాదయామాసతుః|</para>
  <para style="p">
    <verse number="14" style="v"/>అథ కాల ఉపస్థితే యీశు ర్ద్వాదశభిః ప్రేరితైః సహ భోక్తుముపవిశ్య కథితవాన్</para>
  <para style="p">
    <verse number="15" style="v"/>మమ దుఃఖభోగాత్ పూర్వ్వం యుభాభిః సహ నిస్తారోత్సవస్యైతస్య భోజ్యం భోక్తుం మయాతివాఞ్ఛా కృతా|</para>
  <para style="p">
    <verse number="16" style="v"/>యుష్మాన్ వదామి, యావత్కాలమ్ ఈశ్వరరాజ్యే భోజనం న కరిష్యే తావత్కాలమ్ ఇదం న భోక్ష్యే|</para>
  <para style="p">
    <verse number="17" style="v"/>తదా స పానపాత్రమాదాయ ఈశ్వరస్య గుణాన్ కీర్త్తయిత్వా తేభ్యో దత్వావదత్, ఇదం గృహ్లీత యూయం విభజ్య పివత|</para>
  <para style="p">
    <verse number="18" style="v"/>యుష్మాన్ వదామి యావత్కాలమ్ ఈశ్వరరాజత్వస్య సంస్థాపనం న భవతి తావద్ ద్రాక్షాఫలరసం న పాస్యామి|</para>
  <para style="p">
    <verse number="19" style="v"/>తతః పూపం గృహీత్వా ఈశ్వరగుణాన్ కీర్త్తయిత్వా భఙ్క్తా తేభ్యో దత్వావదత్, యుష్మదర్థం సమర్పితం యన్మమ వపుస్తదిదం, ఏతత్ కర్మ్మ మమ స్మరణార్థం కురుధ్వం|</para>
  <para style="p">
    <verse number="20" style="v"/>అథ భోజనాన్తే తాదృశం పాత్రం గృహీత్వావదత్, యుష్మత్కృతే పాతితం యన్మమ రక్తం తేన నిర్ణీతనవనియమరూపం పానపాత్రమిదం|</para>
  <para style="p">
    <verse number="21" style="v"/>పశ్యత యో మాం పరకరేషు సమర్పయిష్యతి స మయా సహ భోజనాసన ఉపవిశతి|</para>
  <para style="p">
    <verse number="22" style="v"/>యథా నిరూపితమాస్తే తదనుసారేణా మనుష్యపుुత్రస్య గతి ర్భవిష్యతి కిన్తు యస్తం పరకరేషు సమర్పయిష్యతి తస్య సన్తాపో భవిష్యతి|</para>
  <para style="p">
    <verse number="23" style="v"/>తదా తేషాం కో జన ఏతత్ కర్మ్మ కరిష్యతి తత్ తే పరస్పరం ప్రష్టుమారేభిరే|</para>
  <para style="p">
    <verse number="24" style="v"/>అపరం తేషాం కో జనః శ్రేష్ఠత్వేన గణయిష్యతే, అత్రార్థే తేషాం వివాదోభవత్|</para>
  <para style="p">
    <verse number="25" style="v"/>అస్మాత్ కారణాత్ సోవదత్, అన్యదేశీయానాం రాజానః ప్రజానాముపరి ప్రభుత్వం కుర్వ్వన్తి దారుణశాసనం కృత్వాపి తే భూపతిత్వేన విఖ్యాతా భవన్తి చ|</para>
  <para style="p">
    <verse number="26" style="v"/>కిన్తు యుష్మాకం తథా న భవిష్యతి, యో యుష్మాకం శ్రేష్ఠో భవిష్యతి స కనిష్ఠవద్ భవతు, యశ్చ ముఖ్యో భవిష్యతి స సేవకవద్భవతు|</para>
  <para style="p">
    <verse number="27" style="v"/>భోజనోపవిష్టపరిచారకయోః కః శ్రేష్ఠః? యో భోజనాయోపవిశతి స కిం శ్రేష్ఠో న భవతి? కిన్తు యుష్మాకం మధ్యేఽహం పరిచారకఇవాస్మి|</para>
  <para style="p">
    <verse number="28" style="v"/>అపరఞ్చ యుయం మమ పరీక్షాకాలే ప్రథమమారభ్య మయా సహ స్థితా</para>
  <para style="p">
    <verse number="29" style="v"/>ఏతత్కారణాత్ పిత్రా యథా మదర్థం రాజ్యమేకం నిరూపితం తథాహమపి యుష్మదర్థం రాజ్యం నిరూపయామి|</para>
  <para style="p">
    <verse number="30" style="v"/>తస్మాన్ మమ రాజ్యే భోజనాసనే చ భోజనపానే కరిష్యధ్వే సింహాసనేషూపవిశ్య చేస్రాయేలీయానాం ద్వాదశవంశానాం విచారం కరిష్యధ్వే|</para>
  <para style="p">
    <verse number="31" style="v"/>అపరం ప్రభురువాచ, హే శిమోన్ పశ్య తితఉనా ధాన్యానీవ యుష్మాన్ శైతాన్ చాలయితుమ్ ఐచ్ఛత్,</para>
  <para style="p">
    <verse number="32" style="v"/>కిన్తు తవ విశ్వాసస్య లోపో యథా న భవతి ఏతత్ త్వదర్థం ప్రార్థితం మయా, త్వన్మనసి పరివర్త్తితే చ భ్రాతృణాం మనాంసి స్థిరీకురు|</para>
  <para style="p">
    <verse number="33" style="v"/>తదా సోవదత్, హే ప్రభోహం త్వయా సార్ద్ధం కారాం మృతిఞ్చ యాతుం మజ్జితోస్మి|</para>
  <para style="p">
    <verse number="34" style="v"/>తతః స ఉవాచ, హే పితర త్వాం వదామి, అద్య కుక్కుటరవాత్ పూర్వ్వం త్వం మత్పరిచయం వారత్రయమ్ అపహ్వోష్యసే|</para>
  <para style="p">
    <verse number="35" style="v"/>అపరం స పప్రచ్ఛ, యదా ముద్రాసమ్పుటం ఖాద్యపాత్రం పాదుకాఞ్చ వినా యుష్మాన్ ప్రాహిణవం తదా యుష్మాకం కస్యాపి న్యూనతాసీత్? తే ప్రోచుః కస్యాపి న|</para>
  <para style="p">
    <verse number="36" style="v"/>తదా సోవదత్ కిన్త్విదానీం ముద్రాసమ్పుటం ఖాద్యపాత్రం వా యస్యాస్తి తేన తద్గ్రహీతవ్యం, యస్య చ కృపాణోे నాస్తి తేన స్వవస్త్రం విక్రీయ స క్రేతవ్యః|</para>
  <para style="p">
    <verse number="37" style="v"/>యతో యుష్మానహం వదామి, అపరాధిజనైః సార్ద్ధం గణితః స భవిష్యతి| ఇదం యచ్ఛాస్త్రీయం వచనం లిఖితమస్తి తన్మయి ఫలిష్యతి యతో మమ సమ్బన్ధీయం సర్వ్వం సేత్స్యతి|</para>
  <para style="p">
    <verse number="38" style="v"/>తదా తే ప్రోచుః ప్రభో పశ్య ఇమౌ కృపాణౌ| తతః సోవదద్ ఏతౌ యథేష్టౌ|</para>
  <para style="p">
    <verse number="39" style="v"/>అథ స తస్మాద్వహి ర్గత్వా స్వాచారానుసారేణ జైతుననామాద్రిం జగామ శిష్యాశ్చ తత్పశ్చాద్ యయుః|</para>
  <para style="p">
    <verse number="40" style="v"/>తత్రోపస్థాయ స తానువాచ, యథా పరీక్షాయాం న పతథ తదర్థం ప్రార్థయధ్వం|</para>
  <para style="p">
    <verse number="41" style="v"/>పశ్చాత్ స తస్మాద్ ఏకశరక్షేపాద్ బహి ర్గత్వా జానునీ పాతయిత్వా ఏతత్ ప్రార్థయాఞ్చక్రే,</para>
  <para style="p">
    <verse number="42" style="v"/>హే పిత ర్యది భవాన్ సమ్మన్యతే తర్హి కంసమేనం మమాన్తికాద్ దూరయ కిన్తు మదిచ్ఛానురూపం న త్వదిచ్ఛానురూపం భవతు|</para>
  <para style="p">
    <verse number="43" style="v"/>తదా తస్మై శక్తిం దాతుం స్వర్గీయదూతో దర్శనం దదౌ|</para>
  <para style="p">
    <verse number="44" style="v"/>పశ్చాత్ సోత్యన్తం యాతనయా వ్యాకులో భూత్వా పునర్దృఢం ప్రార్థయాఞ్చక్రే, తస్మాద్ బృహచ్ఛోణితబిన్దవ ఇవ తస్య స్వేదబిన్దవః పృథివ్యాం పతితుమారేభిరే|</para>
  <para style="p">
    <verse number="45" style="v"/>అథ ప్రార్థనాత ఉత్థాయ శిష్యాణాం సమీపమేత్య తాన్ మనోదుఃఖినో నిద్రితాన్ దృష్ట్వావదత్</para>
  <para style="p">
    <verse number="46" style="v"/>కుతో నిద్రాథ? పరీక్షాయామ్ అపతనార్థం ప్రర్థయధ్వం|</para>
  <para style="p">
    <verse number="47" style="v"/>ఏతత్కథాయాః కథనకాలే ద్వాదశశిష్యాణాం మధ్యే గణితో యిహూదానామా జనతాసహితస్తేషామ్ అగ్రే చలిత్వా యీశోశ్చుమ్బనార్థం తదన్తికమ్ ఆయయౌ|</para>
  <para style="p">
    <verse number="48" style="v"/>తదా యీశురువాచ, హే యిహూదా కిం చుమ్బనేన మనుష్యపుత్రం పరకరేషు సమర్పయసి?</para>
  <para style="p">
    <verse number="49" style="v"/>తదా యద్యద్ ఘటిష్యతే తదనుమాయ సఙ్గిభిరుక్తం, హే ప్రభో వయం కి ఖఙ్గేన ఘాతయిష్యామః?</para>
  <para style="p">
    <verse number="50" style="v"/>తత ఏకః కరవాలేనాహత్య ప్రధానయాజకస్య దాసస్య దక్షిణం కర్ణం చిచ్ఛేద|</para>
  <para style="p">
    <verse number="51" style="v"/>అధూనా నివర్త్తస్వ ఇత్యుక్త్వా యీశుస్తస్య శ్రుతిం స్పృష్ట్వా స్వస్యం చకార|</para>
  <para style="p">
    <verse number="52" style="v"/>పశ్చాద్ యీశుః సమీపస్థాన్ ప్రధానయాజకాన్ మన్దిరస్య సేనాపతీన్ ప్రాచీనాంశ్చ జగాద, యూయం కృపాణాన్ యష్టీంశ్చ గృహీత్వా మాం కిం చోరం ధర్త్తుమాయాతాః?</para>
  <para style="p">
    <verse number="53" style="v"/>యదాహం యుష్మాభిః సహ ప్రతిదినం మన్దిరేఽతిష్ఠం తదా మాం ధర్త్తం న ప్రవృత్తాః, కిన్త్విదానీం యుష్మాకం సమయోన్ధకారస్య చాధిపత్యమస్తి|</para>
  <para style="p">
    <verse number="54" style="v"/>అథ తే తం ధృత్వా మహాయాజకస్య నివేశనం నిన్యుః| తతః పితరో దూరే దూరే పశ్చాదిత్వా</para>
  <para style="p">
    <verse number="55" style="v"/>బృహత్కోష్ఠస్య మధ్యే యత్రాగ్నిం జ్వాలయిత్వా లోకాః సమేత్యోపవిష్టాస్తత్ర తైః సార్ద్ధమ్ ఉపవివేశ|</para>
  <para style="p">
    <verse number="56" style="v"/>అథ వహ్నిసన్నిధౌ సముపవేశకాలే కాచిద్దాసీ మనో నివిశ్య తం నిరీక్ష్యావదత్ పుమానయం తస్య సఙ్గేఽస్థాత్|</para>
  <para style="p">
    <verse number="57" style="v"/>కిన్తు స తద్ అపహ్నుత్యావాదీత్ హే నారి తమహం న పరిచినోమి|</para>
  <para style="p">
    <verse number="58" style="v"/>క్షణాన్తరేఽన్యజనస్తం దృష్ట్వాబ్రవీత్ త్వమపి తేషాం నికరస్యైకజనోసి| పితరః ప్రత్యువాచ హే నర నాహమస్మి|</para>
  <para style="p">
    <verse number="59" style="v"/>తతః సార్ద్ధదణ్డద్వయాత్ పరం పునరన్యో జనో నిశ్చిత్య బభాషే, ఏష తస్య సఙ్గీతి సత్యం యతోయం గాలీలీయో లోకః|</para>
  <para style="p">
    <verse number="60" style="v"/>తదా పితర ఉవాచ హే నర త్వం యద్ వదమి తదహం బోద్ధుం న శక్నోమి, ఇతి వాక్యే కథితమాత్రే కుక్కుటో రురావ|</para>
  <para style="p">
    <verse number="61" style="v"/>తదా ప్రభుణా వ్యాధుట్య పితరే నిరీక్షితే కృకవాకురవాత్ పూర్వ్వం మాం త్రిరపహ్నోష్యసే ఇతి పూర్వ్వోక్తం తస్య వాక్యం పితరః స్మృత్వా</para>
  <para style="p">
    <verse number="62" style="v"/>బహిర్గత్వా మహాఖేదేన చక్రన్ద|</para>
  <para style="p">
    <verse number="63" style="v"/>తదా యై ర్యీశుర్ధృతస్తే తముపహస్య ప్రహర్త్తుమారేభిరే|</para>
  <para style="p">
    <verse number="64" style="v"/>వస్త్రేణ తస్య దృశౌ బద్ధ్వా కపోలే చపేటాఘాతం కృత్వా పప్రచ్ఛుః, కస్తే కపోలే చపేటాఘాతం కృతవాన? గణయిత్వా తద్ వద|</para>
  <para style="p">
    <verse number="65" style="v"/>తదన్యత్ తద్విరుద్ధం బహునిన్దావాక్యం వక్తుమారేభిరే|</para>
  <para style="p">
    <verse number="66" style="v"/>అథ ప్రభాతే సతి లోకప్రాఞ్చః ప్రధానయాజకా అధ్యాపకాశ్చ సభాం కృత్వా మధ్యేసభం యీశుమానీయ పప్రచ్ఛుః, త్వమ్ అభిషికతోసి న వాస్మాన్ వద|</para>
  <para style="p">
    <verse number="67" style="v"/>స ప్రత్యువాచ, మయా తస్మిన్నుక్తేఽపి యూయం న విశ్వసిష్యథ|</para>
  <para style="p">
    <verse number="68" style="v"/>కస్మింశ్చిద్వాక్యే యుష్మాన్ పృష్టేఽపి మాం న తదుత్తరం వక్ష్యథ న మాం త్యక్ష్యథ చ|</para>
  <para style="p">
    <verse number="69" style="v"/>కిన్త్వితః పరం మనుజసుతః సర్వ్వశక్తిమత ఈశ్వరస్య దక్షిణే పార్శ్వే సముపవేక్ష్యతి|</para>
  <para style="p">
    <verse number="70" style="v"/>తతస్తే పప్రచ్ఛుః, ర్తిహ త్వమీశ్వరస్య పుత్రః? స కథయామాస, యూయం యథార్థం వదథ స ఏవాహం|</para>
  <para style="p">
    <verse number="71" style="v"/>తదా తే సర్వ్వే కథయామాసుః, ర్తిహ సాక్ష్యేఽన్సస్మిన్ అస్మాకం కిం ప్రయోజనం? అస్య స్వముఖాదేవ సాక్ష్యం ప్రాప్తమ్|</para>
  <chapter number="23" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>తతః సభాస్థాః సర్వ్వలోకా ఉత్థాయ తం పీలాతసమ్ముఖం నీత్వాప్రోద్య వక్తుమారేభిరే,</para>
  <para style="p">
    <verse number="2" style="v"/>స్వమభిషిక్తం రాజానం వదన్తం కైమరరాజాయ కరదానం నిషేధన్తం రాజ్యవిపర్య్యయం కుర్త్తుం ప్రవర్త్తమానమ్ ఏన ప్రాప్తా వయం|</para>
  <para style="p">
    <verse number="3" style="v"/>తదా పీలాతస్తం పృష్టవాన్ త్వం కిం యిహూదీయానాం రాజా? స ప్రత్యువాచ త్వం సత్యముక్తవాన్|</para>
  <para style="p">
    <verse number="4" style="v"/>తదా పీలాతః ప్రధానయాజకాదిలోకాన్ జగాద్, అహమేతస్య కమప్యపరాధం నాప్తవాన్|</para>
  <para style="p">
    <verse number="5" style="v"/>తతస్తే పునః సాహమినో భూత్వావదన్, ఏష గాలీల ఏతత్స్థానపర్య్యన్తే సర్వ్వస్మిన్ యిహూదాదేశే సర్వ్వాల్లోకానుపదిశ్య కుప్రవృత్తిం గ్రాహీతవాన్|</para>
  <para style="p">
    <verse number="6" style="v"/>తదా పీలాతో గాలీలప్రదేశస్య నామ శ్రుత్వా పప్రచ్ఛ, కిమయం గాలీలీయో లోకః?</para>
  <para style="p">
    <verse number="7" style="v"/>తతః స గాలీల్ప్రదేశీయహేరోద్రాజస్య తదా స్థితేస్తస్య సమీపే యీశుం ప్రేషయామాస|</para>
  <para style="p">
    <verse number="8" style="v"/>తదా హేరోద్ యీశుం విలోక్య సన్తుతోష, యతః స తస్య బహువృత్తాన్తశ్రవణాత్ తస్య కిఞి्చదాశ్చర్య్యకర్మ్మ పశ్యతి ఇత్యాశాం కృత్వా బహుకాలమారభ్య తం ద్రష్టుం ప్రయాసం కృతవాన్|</para>
  <para style="p">
    <verse number="9" style="v"/>తస్మాత్ తం బహుకథాః పప్రచ్ఛ కిన్తు స తస్య కస్యాపి వాక్యస్య ప్రత్యుత్తరం నోవాచ|</para>
  <para style="p">
    <verse number="10" style="v"/>అథ ప్రధానయాజకా అధ్యాపకాశ్చ ప్రోత్తిష్ఠన్తః సాహసేన తమపవదితుం ప్రారేభిరే|</para>
  <para style="p">
    <verse number="11" style="v"/>హేరోద్ తస్య సేనాగణశ్చ తమవజ్ఞాయ ఉపహాసత్వేన రాజవస్త్రం పరిధాప్య పునః పీలాతం ప్రతి తం ప్రాహిణోత్|</para>
  <para style="p">
    <verse number="12" style="v"/>పూర్వ్వం హేరోద్పీలాతయోః పరస్పరం వైరభావ ఆసీత్ కిన్తు తద్దినే ద్వయో ర్మేలనం జాతమ్|</para>
  <para style="p">
    <verse number="13" style="v"/>పశ్చాత్ పీలాతః ప్రధానయాజకాన్ శాసకాన్ లోకాంశ్చ యుగపదాహూయ బభాషే,</para>
  <para style="p">
    <verse number="14" style="v"/>రాజ్యవిపర్య్యయకారకోయమ్ ఇత్యుక్త్వా మనుష్యమేనం మమ నికటమానైష్ట కిన్తు పశ్యత యుష్మాకం సమక్షమ్ అస్య విచారం కృత్వాపి ప్రోక్తాపవాదానురూపేణాస్య కోప్యపరాధః సప్రమాణో న జాతః,</para>
  <para style="p">
    <verse number="15" style="v"/>యూయఞ్చ హేరోదః సన్నిధౌ ప్రేషితా మయా తత్రాస్య కోప్యపరాధస్తేనాపి న ప్రాప్తః| పశ్యతానేన వధహేेతుకం కిమపి నాపరాద్ధం|</para>
  <para style="p">
    <verse number="16" style="v"/>తస్మాదేనం తాడయిత్వా విహాస్యామి|</para>
  <para style="p">
    <verse number="17" style="v"/>తత్రోత్సవే తేషామేకో మోచయితవ్యః|</para>
  <para style="p">
    <verse number="18" style="v"/>ఇతి హేతోస్తే ప్రోచ్చైరేకదా ప్రోచుః, ఏనం దూరీకృత్య బరబ్బానామానం మోచయ|</para>
  <para style="p">
    <verse number="19" style="v"/>స బరబ్బా నగర ఉపప్లవవధాపరాధాభ్యాం కారాయాం బద్ధ ఆసీత్|</para>
  <para style="p">
    <verse number="20" style="v"/>కిన్తు పీలాతో యీశుం మోచయితుం వాఞ్ఛన్ పునస్తానువాచ|</para>
  <para style="p">
    <verse number="21" style="v"/>తథాప్యేనం క్రుశే వ్యధ క్రుశే వ్యధేతి వదన్తస్తే రురువుః|</para>
  <para style="p">
    <verse number="22" style="v"/>తతః స తృతీయవారం జగాద కుతః? స కిం కర్మ్మ కృతవాన్? నాహమస్య కమపి వధాపరాధం ప్రాప్తః కేవలం తాడయిత్వాముం త్యజామి|</para>
  <para style="p">
    <verse number="23" style="v"/>తథాపి తే పునరేనం క్రుశే వ్యధ ఇత్యుక్త్వా ప్రోచ్చైర్దృఢం ప్రార్థయాఞ్చక్రిరే;</para>
  <para style="p">
    <verse number="24" style="v"/>తతః ప్రధానయాజకాదీనాం కలరవే ప్రబలే సతి తేషాం ప్రార్థనారూపం కర్త్తుం పీలాత ఆదిదేశ|</para>
  <para style="p">
    <verse number="25" style="v"/>రాజద్రోహవధయోరపరాధేన కారాస్థం యం జనం తే యయాచిరే తం మోచయిత్వా యీశుం తేషామిచ్ఛాయాం సమార్పయత్|</para>
  <para style="p">
    <verse number="26" style="v"/>అథ తే యీశుం గృహీత్వా యాన్తి, ఏతర్హి గ్రామాదాగతం శిమోననామానం కురీణీయం జనం ధృత్వా యీశోః పశ్చాన్నేతుం తస్య స్కన్ధే క్రుశమర్పయామాసుః|</para>
  <para style="p">
    <verse number="27" style="v"/>తతో లోाకారణ్యమధ్యే బహుస్త్రియో రుదత్యో విలపన్త్యశ్చ యీశోః పశ్చాద్ యయుః|</para>
  <para style="p">
    <verse number="28" style="v"/>కిన్తు స వ్యాఘుట్య తా ఉవాచ, హే యిరూశాలమో నార్య్యో యుయం మదర్థం న రుదిత్వా స్వార్థం స్వాపత్యార్థఞ్చ రుదితి;</para>
  <para style="p">
    <verse number="29" style="v"/>పశ్యత యః కదాపి గర్భవత్యో నాభవన్ స్తన్యఞ్చ నాపాయయన్ తాదృశీ ర్వన్ధ్యా యదా ధన్యా వక్ష్యన్తి స కాల ఆయాతి|</para>
  <para style="p">
    <verse number="30" style="v"/>తదా హే శైలా అస్మాకముపరి పతత, హే ఉపశైలా అస్మానాచ్ఛాదయత కథామీదృశీం లోకా వక్ష్యన్తి|</para>
  <para style="p">
    <verse number="31" style="v"/>యతః సతేజసి శాఖిని చేదేతద్ ఘటతే తర్హి శుష్కశాఖిని కిం న ఘటిష్యతే?</para>
  <para style="p">
    <verse number="32" style="v"/>తదా తే హన్తుం ద్వావపరాధినౌ తేన సార్ద్ధం నిన్యుః|</para>
  <para style="p">
    <verse number="33" style="v"/>అపరం శిరఃకపాలనామకస్థానం ప్రాప్య తం క్రుశే వివిధుః; తద్ద్వయోరపరాధినోరేకం తస్య దక్షిణో తదన్యం వామే క్రుశే వివిధుః|</para>
  <para style="p">
    <verse number="34" style="v"/>తదా యీశురకథయత్, హే పితరేతాన్ క్షమస్వ యత ఏతే యత్ కర్మ్మ కుర్వ్వన్తి తన్ న విదుః; పశ్చాత్తే గుటికాపాతం కృత్వా తస్య వస్త్రాణి విభజ్య జగృహుః|</para>
  <para style="p">
    <verse number="35" style="v"/>తత్ర లోకసంఘస్తిష్ఠన్ దదర్శ; తే తేషాం శాసకాశ్చ తముపహస్య జగదుః, ఏష ఇతరాన్ రక్షితవాన్ యదీశ్వరేణాభిరుచితో ఽభిషిక్తస్త్రాతా భవతి తర్హి స్వమధునా రక్షతు|</para>
  <para style="p">
    <verse number="36" style="v"/>తదన్యః సేనాగణా ఏత్య తస్మై అమ్లరసం దత్వా పరిహస్య ప్రోవాచ,</para>
  <para style="p">
    <verse number="37" style="v"/>చేత్త్వం యిహూదీయానాం రాజాసి తర్హి స్వం రక్ష|</para>
  <para style="p">
    <verse number="38" style="v"/>యిహూదీయానాం రాజేతి వాక్యం యూనానీయరోమీయేబ్రీయాక్షరై ర్లిఖితం తచ్ఛిరస ఊర్ద్ధ్వేఽస్థాప్యత|</para>
  <para style="p">
    <verse number="39" style="v"/>తదోభయపార్శ్వయో ర్విద్ధౌ యావపరాధినౌ తయోరేకస్తం వినిన్ద్య బభాషే, చేత్త్వమ్ అభిషిక్తోసి తర్హి స్వమావాఞ్చ రక్ష|</para>
  <para style="p">
    <verse number="40" style="v"/>కిన్త్వన్యస్తం తర్జయిత్వావదత్, ఈశ్వరాత్తవ కిఞ్చిదపి భయం నాస్తి కిం? త్వమపి సమానదణ్డోసి,</para>
  <para style="p">
    <verse number="41" style="v"/>యోగ్యపాత్రే ఆవాం స్వస్వకర్మ్మణాం సముచితఫలం ప్రాప్నువః కిన్త్వనేన కిమపి నాపరాద్ధం|</para>
  <para style="p">
    <verse number="42" style="v"/>అథ స యీశుం జగాద హే ప్రభే భవాన్ స్వరాజ్యప్రవేశకాలే మాం స్మరతు|</para>
  <para style="p">
    <verse number="43" style="v"/>తదా యీశుః కథితవాన్ త్వాం యథార్థం వదామి త్వమద్యైవ మయా సార్ద్ధం పరలోకస్య సుఖస్థానం ప్రాప్స్యసి|</para>
  <para style="p">
    <verse number="44" style="v"/>అపరఞ్చ ద్వితీయయామాత్ తృతీయయామపర్య్యన్తం రవేస్తేజసోన్తర్హితత్వాత్ సర్వ్వదేశోఽన్ధకారేణావృతో</para>
  <para style="p">
    <verse number="45" style="v"/>మన్దిరస్య యవనికా చ ఛిద్యమానా ద్విధా బభూవ|</para>
  <para style="p">
    <verse number="46" style="v"/>తతో యీశురుచ్చైరువాచ, హే పిత ర్మమాత్మానం తవ కరే సమర్పయే, ఇత్యుక్త్వా స ప్రాణాన్ జహౌ|</para>
  <para style="p">
    <verse number="47" style="v"/>తదైతా ఘటనా దృష్ట్వా శతసేనాపతిరీశ్వరం ధన్యముక్త్వా కథితవాన్ అయం నితాన్తం సాధుమనుష్య ఆసీత్|</para>
  <para style="p">
    <verse number="48" style="v"/>అథ యావన్తో లోకా ద్రష్టుమ్ ఆగతాస్తే తా ఘటనా దృష్ట్వా వక్షఃసు కరాఘాతం కృత్వా వ్యాచుట్య గతాః|</para>
  <para style="p">
    <verse number="49" style="v"/>యీశో ర్జ్ఞాతయో యా యా యోషితశ్చ గాలీలస్తేన సార్ద్ధమాయాతాస్తా అపి దూరే స్థిత్వా తత్ సర్వ్వం దదృశుః|</para>
  <para style="p">
    <verse number="50" style="v"/>తదా యిహూదీయానాం మన్త్రణాం క్రియాఞ్చాసమ్మన్యమాన ఈశ్వరస్య రాజత్వమ్ అపేక్షమాణో</para>
  <para style="p">
    <verse number="51" style="v"/>యిహూదిదేశీయో ఽరిమథీయనగరీయో యూషఫ్నామా మన్త్రీ భద్రో ధార్మ్మికశ్చ పుమాన్</para>
  <para style="p">
    <verse number="52" style="v"/>పీలాతాన్తికం గత్వా యీశో ర్దేహం యయాచే|</para>
  <para style="p">
    <verse number="53" style="v"/>పశ్చాద్ వపురవరోహ్య వాససా సంవేష్ట్య యత్ర కోపి మానుషో నాస్థాప్యత తస్మిన్ శైలే స్వాతే శ్మశానే తదస్థాపయత్|</para>
  <para style="p">
    <verse number="54" style="v"/>తద్దినమాయోజనీయం దినం విశ్రామవారశ్చ సమీపః|</para>
  <para style="p">
    <verse number="55" style="v"/>అపరం యీశునా సార్ద్ధం గాలీల ఆగతా యోషితః పశ్చాదిత్వా శ్మశానే తత్ర యథా వపుః స్థాపితం తచ్చ దృష్ట్వా</para>
  <para style="p">
    <verse number="56" style="v"/>వ్యాఘుట్య సుగన్ధిద్రవ్యతైలాని కృత్వా విధివద్ విశ్రామవారే విశ్రామం చక్రుః|</para>
  <chapter number="24" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అథ సప్తాహప్రథమదినేఽతిప్రత్యూషే తా యోషితః సమ్పాదితం సుగన్ధిద్రవ్యం గృహీత్వా తదన్యాభిః కియతీభిః స్త్రీభిః సహ శ్మశానం యయుః|</para>
  <para style="p">
    <verse number="2" style="v"/>కిన్తు శ్మశానద్వారాత్ పాషాణమపసారితం దృష్ట్వా</para>
  <para style="p">
    <verse number="3" style="v"/>తాః ప్రవిశ్య ప్రభో ర్దేహమప్రాప్య</para>
  <para style="p">
    <verse number="4" style="v"/>వ్యాకులా భవన్తి ఏతర్హి తేజోమయవస్త్రాన్వితౌ ద్వౌ పురుషౌ తాసాం సమీపే సముపస్థితౌ</para>
  <para style="p">
    <verse number="5" style="v"/>తస్మాత్తాః శఙ్కాయుక్తా భూమావధోముఖ్యస్యస్థుః| తదా తౌ తా ఊచతు ర్మృతానాం మధ్యే జీవన్తం కుతో మృగయథ?</para>
  <para style="p">
    <verse number="6" style="v"/>సోత్ర నాస్తి స ఉదస్థాత్|</para>
  <para style="p">
    <verse number="7" style="v"/>పాపినాం కరేషు సమర్పితేన క్రుశే హతేన చ మనుష్యపుత్రేణ తృతీయదివసే శ్మశానాదుత్థాతవ్యమ్ ఇతి కథాం స గలీలి తిష్ఠన్ యుష్మభ్యం కథితవాన్ తాం స్మరత|</para>
  <para style="p">
    <verse number="8" style="v"/>తదా తస్య సా కథా తాసాం మనఃసు జాతా|</para>
  <para style="p">
    <verse number="9" style="v"/>అనన్తరం శ్మశానాద్ గత్వా తా ఏకాదశశిష్యాదిభ్యః సర్వ్వేభ్యస్తాం వార్త్తాం కథయామాసుః|</para>
  <para style="p">
    <verse number="10" style="v"/>మగ్దలీనీమరియమ్, యోహనా, యాకూబో మాతా మరియమ్ తదన్యాః సఙ్గిన్యో యోషితశ్చ ప్రేరితేభ్య ఏతాః సర్వ్వా వార్త్తాః కథయామాసుః</para>
  <para style="p">
    <verse number="11" style="v"/>కిన్తు తాసాం కథామ్ అనర్థకాఖ్యానమాత్రం బుద్ధ్వా కోపి న ప్రత్యైత్|</para>
  <para style="p">
    <verse number="12" style="v"/>తదా పితర ఉత్థాయ శ్మశానాన్తికం దధావ, తత్ర చ ప్రహ్వో భూత్వా పార్శ్వైకస్థాపితం కేవలం వస్త్రం దదర్శ; తస్మాదాశ్చర్య్యం మన్యమానో యదఘటత తన్మనసి విచారయన్ ప్రతస్థే|</para>
  <para style="p">
    <verse number="13" style="v"/>తస్మిన్నేవ దినే ద్వౌ శియ్యౌ యిరూశాలమశ్చతుష్క్రోశాన్తరితమ్ ఇమ్మాయుగ్రామం గచ్ఛన్తౌ</para>
  <para style="p">
    <verse number="14" style="v"/>తాసాం ఘటనానాం కథామకథయతాం</para>
  <para style="p">
    <verse number="15" style="v"/>తయోరాలాపవిచారయోః కాలే యీశురాగత్య తాభ్యాం సహ జగామ</para>
  <para style="p">
    <verse number="16" style="v"/>కిన్తు యథా తౌ తం న పరిచినుతస్తదర్థం తయో ర్దృష్టిః సంరుద్ధా|</para>
  <para style="p">
    <verse number="17" style="v"/>స తౌ పృష్టవాన్ యువాం విషణ్ణౌ కిం విచారయన్తౌ గచ్ఛథః?</para>
  <para style="p">
    <verse number="18" style="v"/>తతస్తయోః క్లియపానామా ప్రత్యువాచ యిరూశాలమపురేఽధునా యాన్యఘటన్త త్వం కేవలవిదేశీ కిం తద్వృత్తాన్తం న జానాసి?</para>
  <para style="p">
    <verse number="19" style="v"/>స పప్రచ్ఛ కా ఘటనాః? తదా తౌ వక్తుమారేభాతే యీశునామా యో నాసరతీయో భవిష్యద్వాదీ ఈశ్వరస్య మానుషాణాఞ్చ సాక్షాత్ వాక్యే కర్మ్మణి చ శక్తిమానాసీత్</para>
  <para style="p">
    <verse number="20" style="v"/>తమ్ అస్మాకం ప్రధానయాజకా విచారకాశ్చ కేనాపి ప్రకారేణ క్రుశే విద్ధ్వా తస్య ప్రాణాననాశయన్ తదీయా ఘటనాః;</para>
  <para style="p">
    <verse number="21" style="v"/>కిన్తు య ఇస్రాయేలీయలోకాన్ ఉద్ధారయిష్యతి స ఏవాయమ్ ఇత్యాశాస్మాభిః కృతా| తద్యథా తథాస్తు తస్యా ఘటనాయా అద్య దినత్రయం గతం|</para>
  <para style="p">
    <verse number="22" style="v"/>అధికన్త్వస్మాకం సఙ్గినీనాం కియత్స్త్రీణాం ముఖేభ్యోఽసమ్భవవాక్యమిదం శ్రుతం;</para>
  <para style="p">
    <verse number="23" style="v"/>తాః ప్రత్యూషే శ్మశానం గత్వా తత్ర తస్య దేహమ్ అప్రాప్య వ్యాఘుట్యేత్వా ప్రోక్తవత్యః స్వర్గీసదూతౌ దృష్టావస్మాభిస్తౌ చావాదిష్టాం స జీవితవాన్|</para>
  <para style="p">
    <verse number="24" style="v"/>తతోస్మాకం కైశ్చిత్ శ్మశానమగమ్యత తేఽపి స్త్రీణాం వాక్యానురూపం దృష్టవన్తః కిన్తు తం నాపశ్యన్|</para>
  <para style="p">
    <verse number="25" style="v"/>తదా స తావువాచ, హే అబోధౌ హే భవిష్యద్వాదిభిరుక్తవాక్యం ప్రత్యేతుం విలమ్బమానౌ;</para>
  <para style="p">
    <verse number="26" style="v"/>ఏతత్సర్వ్వదుఃఖం భుక్త్వా స్వభూతిప్రాప్తిః కిం ఖ్రీష్టస్య న న్యాయ్యా?</para>
  <para style="p">
    <verse number="27" style="v"/>తతః స మూసాగ్రన్థమారభ్య సర్వ్వభవిష్యద్వాదినాం సర్వ్వశాస్త్రే స్వస్మిన్ లిఖితాఖ్యానాభిప్రాయం బోధయామాస|</para>
  <para style="p">
    <verse number="28" style="v"/>అథ గమ్యగ్రామాభ్యర్ణం ప్రాప్య తేనాగ్రే గమనలక్షణే దర్శితే</para>
  <para style="p">
    <verse number="29" style="v"/>తౌ సాధయిత్వావదతాం సహావాభ్యాం తిష్ఠ దినే గతే సతి రాత్రిరభూత్; తతః స తాభ్యాం సార్ద్ధం స్థాతుం గృహం యయౌ|</para>
  <para style="p">
    <verse number="30" style="v"/>పశ్చాద్భోజనోపవేశకాలే స పూపం గృహీత్వా ఈశ్వరగుణాన్ జగాద తఞ్చ భంక్త్వా తాభ్యాం దదౌ|</para>
  <para style="p">
    <verse number="31" style="v"/>తదా తయో ర్దృష్టౌ ప్రసన్నాయాం తం ప్రత్యభిజ్ఞతుః కిన్తు స తయోః సాక్షాదన్తర్దధే|</para>
  <para style="p">
    <verse number="32" style="v"/>తతస్తౌ మిథోభిధాతుమ్ ఆరబ్ధవన్తౌ గమనకాలే యదా కథామకథయత్ శాస్త్రార్థఞ్చబోధయత్ తదావయో ర్బుద్ధిః కిం న ప్రాజ్వలత్?</para>
  <para style="p">
    <verse number="33" style="v"/>తౌ తత్క్షణాదుత్థాయ యిరూశాలమపురం ప్రత్యాయయతుః, తత్స్థానే శిష్యాణామ్ ఏకాదశానాం సఙ్గినాఞ్చ దర్శనం జాతం|</para>
  <para style="p">
    <verse number="34" style="v"/>తే ప్రోచుః ప్రభురుదతిష్ఠద్ ఇతి సత్యం శిమోనే దర్శనమదాచ్చ|</para>
  <para style="p">
    <verse number="35" style="v"/>తతః పథః సర్వ్వఘటనాయాః పూపభఞ్జనేన తత్పరిచయస్య చ సర్వ్వవృత్తాన్తం తౌ వక్తుమారేభాతే|</para>
  <para style="p">
    <verse number="36" style="v"/>ఇత్థం తే పరస్పరం వదన్తి తత్కాలే యీశుః స్వయం తేషాం మధ్య ప్రోత్థయ యుష్మాకం కల్యాణం భూయాద్ ఇత్యువాచ,</para>
  <para style="p">
    <verse number="37" style="v"/>కిన్తు భూతం పశ్యామ ఇత్యనుమాయ తే సముద్వివిజిరే త్రేషుశ్చ|</para>
  <para style="p">
    <verse number="38" style="v"/>స ఉవాచ, కుతో దుఃఖితా భవథ? యుష్మాకం మనఃసు సన్దేహ ఉదేతి చ కుతః?</para>
  <para style="p">
    <verse number="39" style="v"/>ఏషోహం, మమ కరౌ పశ్యత వరం స్పృష్ట్వా పశ్యత, మమ యాదృశాని పశ్యథ తాదృశాని భూతస్య మాంసాస్థీని న సన్తి|</para>
  <para style="p">
    <verse number="40" style="v"/>ఇత్యుక్త్వా స హస్తపాదాన్ దర్శయామాస|</para>
  <para style="p">
    <verse number="41" style="v"/>తేఽసమ్భవం జ్ఞాత్వా సానన్దా న ప్రత్యయన్| తతః స తాన్ పప్రచ్ఛ, అత్ర యుష్మాకం సమీపే ఖాద్యం కిఞ్చిదస్తి?</para>
  <para style="p">
    <verse number="42" style="v"/>తతస్తే కియద్దగ్ధమత్స్యం మధు చ దదుః</para>
  <para style="p">
    <verse number="43" style="v"/>స తదాదాయ తేషాం సాక్షాద్ బుభుజే</para>
  <para style="p">
    <verse number="44" style="v"/>కథయామాస చ మూసావ్యవస్థాయాం భవిష్యద్వాదినాం గ్రన్థేషు గీతపుస్తకే చ మయి యాని సర్వ్వాణి వచనాని లిఖితాని తదనురూపాణి ఘటిష్యన్తే యుష్మాభిః సార్ద్ధం స్థిత్వాహం యదేతద్వాక్యమ్ అవదం తదిదానీం ప్రత్యక్షమభూత్|</para>
  <para style="p">
    <verse number="45" style="v"/>అథ తేభ్యః శాస్త్రబోధాధికారం దత్వావదత్,</para>
  <para style="p">
    <verse number="46" style="v"/>ఖ్రీష్టేనేత్థం మృతియాతనా భోక్తవ్యా తృతీయదినే చ శ్మశానాదుత్థాతవ్యఞ్చేతి లిపిరస్తి;</para>
  <para style="p">
    <verse number="47" style="v"/>తన్నామ్నా యిరూశాలమమారభ్య సర్వ్వదేశే మనఃపరావర్త్తనస్య పాపమోచనస్య చ సుసంవాదః ప్రచారయితవ్యః,</para>
  <para style="p">
    <verse number="48" style="v"/>ఏషు సర్వ్వేషు యూయం సాక్షిణః|</para>
  <para style="p">
    <verse number="49" style="v"/>అపరఞ్చ పశ్యత పిత్రా యత్ ప్రతిజ్ఞాతం తత్ ప్రేషయిష్యామి, అతఏవ యావత్కాలం యూయం స్వర్గీయాం శక్తిం న ప్రాప్స్యథ తావత్కాలం యిరూశాలమ్నగరే తిష్ఠత|</para>
  <para style="p">
    <verse number="50" style="v"/>అథ స తాన్ బైథనీయాపర్య్యన్తం నీత్వా హస్తావుత్తోల్య ఆశిష వక్తుమారేభే</para>
  <para style="p">
    <verse number="51" style="v"/>ఆశిషం వదన్నేవ చ తేభ్యః పృథగ్ భూత్వా స్వర్గాయ నీతోఽభవత్|</para>
  <para style="p">
    <verse number="52" style="v"/>తదా తే తం భజమానా మహానన్దేన యిరూశాలమం ప్రత్యాజగ్ముః|</para>
  <para style="p">
    <verse number="53" style="v"/>తతో నిరన్తరం మన్దిరే తిష్ఠన్త ఈశ్వరస్య ప్రశంసాం ధన్యవాదఞ్చ కర్త్తమ్ ఆరేభిరే| ఇతి||</para>
</usx>
