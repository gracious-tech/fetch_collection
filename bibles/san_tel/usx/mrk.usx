<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="MRK" style="id">Sanskrit Bible (NT) in Telugu Script (సత్యవేదః।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Mark</para>
  <para style="toc1">మార్కలిఖితః సుసంవాదః</para>
  <para style="toc2">మార్కః</para>
  <para style="toc3">మార్కః</para>
  <para style="mt1">మార్కలిఖితః సుసంవాదః</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ఈశ్వరపుత్రస్య యీశుఖ్రీష్టస్య సుసంవాదారమ్భః|</para>
  <para style="p">
    <verse number="2" style="v"/>భవిష్యద్వాదినాం గ్రన్థేషు లిపిరిత్థమాస్తే, పశ్య స్వకీయదూతన్తు తవాగ్రే ప్రేషయామ్యహమ్| గత్వా త్వదీయపన్థానం స హి పరిష్కరిష్యతి|</para>
  <para style="p">
    <verse number="3" style="v"/>"పరమేశస్య పన్థానం పరిష్కురుత సర్వ్వతః| తస్య రాజపథఞ్చైవ సమానం కురుతాధునా| " ఇత్యేతత్ ప్రాన్తరే వాక్యం వదతః కస్యచిద్రవః||</para>
  <para style="p">
    <verse number="4" style="v"/>సఏవ యోహన్ ప్రాన్తరే మజ్జితవాన్ తథా పాపమార్జననిమిత్తం మనోవ్యావర్త్తకమజ్జనస్య కథాఞ్చ ప్రచారితవాన్|</para>
  <para style="p">
    <verse number="5" style="v"/>తతో యిహూదాదేశయిరూశాలమ్నగరనివాసినః సర్వ్వే లోకా బహి ర్భూత్వా తస్య సమీపమాగత్య స్వాని స్వాని పాపాన్యఙ్గీకృత్య యర్ద్దననద్యాం తేన మజ్జితా బభూవుః|</para>
  <para style="p">
    <verse number="6" style="v"/>అస్య యోహనః పరిధేయాని క్రమేలకలోమజాని, తస్య కటిబన్ధనం చర్మ్మజాతమ్, తస్య భక్ష్యాణి చ శూకకీటా వన్యమధూని చాసన్|</para>
  <para style="p">
    <verse number="7" style="v"/>స ప్రచారయన్ కథయాఞ్చక్రే, అహం నమ్రీభూయ యస్య పాదుకాబన్ధనం మోచయితుమపి న యోగ్యోస్మి, తాదృశో మత్తో గురుతర ఏకః పురుషో మత్పశ్చాదాగచ్ఛతి|</para>
  <para style="p">
    <verse number="8" style="v"/>అహం యుష్మాన్ జలే మజ్జితవాన్ కిన్తు స పవిత్ర ఆత్మాని సంమజ్జయిష్యతి|</para>
  <para style="p">
    <verse number="9" style="v"/>అపరఞ్చ తస్మిన్నేవ కాలే గాలీల్ప్రదేశస్య నాసరద్గ్రామాద్ యీశురాగత్య యోహనా యర్ద్దననద్యాం మజ్జితోఽభూత్|</para>
  <para style="p">
    <verse number="10" style="v"/>స జలాదుత్థితమాత్రో మేఘద్వారం ముక్తం కపోతవత్ స్వస్యోపరి అవరోహన్తమాత్మానఞ్చ దృష్టవాన్|</para>
  <para style="p">
    <verse number="11" style="v"/>త్వం మమ ప్రియః పుత్రస్త్వయ్యేవ మమమహాసన్తోష ఇయమాకాశీయా వాణీ బభూవ|</para>
  <para style="p">
    <verse number="12" style="v"/>తస్మిన్ కాలే ఆత్మా తం ప్రాన్తరమధ్యం నినాయ|</para>
  <para style="p">
    <verse number="13" style="v"/>అథ స చత్వారింశద్దినాని తస్మిన్ స్థానే వన్యపశుభిః సహ తిష్ఠన్ శైతానా పరీక్షితః; పశ్చాత్ స్వర్గీయదూతాస్తం సిషేవిరే|</para>
  <para style="p">
    <verse number="14" style="v"/>అనన్తరం యోహని బన్ధనాలయే బద్ధే సతి యీశు ర్గాలీల్ప్రదేశమాగత్య ఈశ్వరరాజ్యస్య సుసంవాదం ప్రచారయన్ కథయామాస,</para>
  <para style="p">
    <verse number="15" style="v"/>కాలః సమ్పూర్ణ ఈశ్వరరాజ్యఞ్చ సమీపమాగతం; అతోహేతో ర్యూయం మనాంసి వ్యావర్త్తయధ్వం సుసంవాదే చ విశ్వాసిత|</para>
  <para style="p">
    <verse number="16" style="v"/>తదనన్తరం స గాలీలీయసముద్రస్య తీరే గచ్ఛన్ శిమోన్ తస్య భ్రాతా అన్ద్రియనామా చ ఇమౌ ద్వౌ జనౌ మత్స్యధారిణౌ సాగరమధ్యే జాలం ప్రక్షిపన్తౌ దృష్ట్వా తావవదత్,</para>
  <para style="p">
    <verse number="17" style="v"/>యువాం మమ పశ్చాదాగచ్ఛతం, యువామహం మనుష్యధారిణౌ కరిష్యామి|</para>
  <para style="p">
    <verse number="18" style="v"/>తతస్తౌ తత్క్షణమేవ జాలాని పరిత్యజ్య తస్య పశ్చాత్ జగ్మతుః|</para>
  <para style="p">
    <verse number="19" style="v"/>తతః పరం తత్స్థానాత్ కిఞ్చిద్ దూరం గత్వా స సివదీపుత్రయాకూబ్ తద్భ్రాతృయోహన్ చ ఇమౌ నౌకాయాం జాలానాం జీర్ణముద్ధారయన్తౌ దృష్ట్వా తావాహూయత్|</para>
  <para style="p">
    <verse number="20" style="v"/>తతస్తౌ నౌకాయాం వేతనభుగ్భిః సహితం స్వపితరం విహాయ తత్పశ్చాదీయతుః|</para>
  <para style="p">
    <verse number="21" style="v"/>తతః పరం కఫర్నాహూమ్నామకం నగరముపస్థాయ స విశ్రామదివసే భజనగ్రహం ప్రవిశ్య సముపదిదేశ|</para>
  <para style="p">
    <verse number="22" style="v"/>తస్యోపదేశాల్లోకా ఆశ్చర్య్యం మేనిరే యతః సోధ్యాపకాఇవ నోపదిశన్ ప్రభావవానివ ప్రోపదిదేశ|</para>
  <para style="p">
    <verse number="23" style="v"/>అపరఞ్చ తస్మిన్ భజనగృహే అపవిత్రభూతేన గ్రస్త ఏకో మానుష ఆసీత్| స చీత్శబ్దం కృత్వా కథయాఞ్చకే</para>
  <para style="p">
    <verse number="24" style="v"/>భో నాసరతీయ యీశో త్వమస్మాన్ త్యజ, త్వయా సహాస్మాకం కః సమ్బన్ధః? త్వం కిమస్మాన్ నాశయితుం సమాగతః? త్వమీశ్వరస్య పవిత్రలోక ఇత్యహం జానామి|</para>
  <para style="p">
    <verse number="25" style="v"/>తదా యీశుస్తం తర్జయిత్వా జగాద తూష్ణీం భవ ఇతో బహిర్భవ చ|</para>
  <para style="p">
    <verse number="26" style="v"/>తతః సోఽపవిత్రభూతస్తం సమ్పీడ్య అత్యుచైశ్చీత్కృత్య నిర్జగామ|</para>
  <para style="p">
    <verse number="27" style="v"/>తేనైవ సర్వ్వే చమత్కృత్య పరస్పరం కథయాఞ్చక్రిరే, అహో కిమిదం? కీదృశోఽయం నవ్య ఉపదేశః? అనేన ప్రభావేనాపవిత్రభూతేష్వాజ్ఞాపితేషు తే తదాజ్ఞానువర్త్తినో భవన్తి|</para>
  <para style="p">
    <verse number="28" style="v"/>తదా తస్య యశో గాలీలశ్చతుర్దిక్స్థసర్వ్వదేశాన్ వ్యాప్నోత్|</para>
  <para style="p">
    <verse number="29" style="v"/>అపరఞ్చ తే భజనగృహాద్ బహి ర్భూత్వా యాకూబ్యోహన్భ్యాం సహ శిమోన ఆన్ద్రియస్య చ నివేశనం ప్రవివిశుః|</para>
  <para style="p">
    <verse number="30" style="v"/>తదా పితరస్య శ్వశ్రూర్జ్వరపీడితా శయ్యాయామాస్త ఇతి తే తం ఝటితి విజ్ఞాపయాఞ్చక్రుః|</para>
  <para style="p">
    <verse number="31" style="v"/>తతః స ఆగత్య తస్యా హస్తం ధృత్వా తాముదస్థాపయత్; తదైవ తాం జ్వరోఽత్యాక్షీత్ తతః పరం సా తాన్ సిషేవే|</para>
  <para style="p">
    <verse number="32" style="v"/>అథాస్తం గతే రవౌ సన్ధ్యాకాలే సతి లోకాస్తత్సమీపం సర్వ్వాన్ రోగిణో భూతధృతాంశ్చ సమానిన్యుః|</para>
  <para style="p">
    <verse number="33" style="v"/>సర్వ్వే నాగరికా లోకా ద్వారి సంమిలితాశ్చ|</para>
  <para style="p">
    <verse number="34" style="v"/>తతః స నానావిధరోగిణో బహూన్ మనుజానరోగిణశ్చకార తథా బహూన్ భూతాన్ త్యాజయాఞ్చకార తాన్ భూతాన్ కిమపి వాక్యం వక్తుం నిషిషేధ చ యతోహేతోస్తే తమజానన్|</para>
  <para style="p">
    <verse number="35" style="v"/>అపరఞ్చ సోఽతిప్రత్యూషే వస్తుతస్తు రాత్రిశేషే సముత్థాయ బహిర్భూయ నిర్జనం స్థానం గత్వా తత్ర ప్రార్థయాఞ్చక్రే|</para>
  <para style="p">
    <verse number="36" style="v"/>అనన్తరం శిమోన్ తత్సఙ్గినశ్చ తస్య పశ్చాద్ గతవన్తః|</para>
  <para style="p">
    <verse number="37" style="v"/>తదుద్దేశం ప్రాప్య తమవదన్ సర్వ్వే లోకాస్త్వాం మృగయన్తే|</para>
  <para style="p">
    <verse number="38" style="v"/>తదా సోఽకథయత్ ఆగచ్ఛత వయం సమీపస్థాని నగరాణి యామః, యతోఽహం తత్ర కథాం ప్రచారయితుం బహిరాగమమ్|</para>
  <para style="p">
    <verse number="39" style="v"/>అథ స తేషాం గాలీల్ప్రదేశస్య సర్వ్వేషు భజనగృహేషు కథాః ప్రచారయాఞ్చక్రే భూతానత్యాజయఞ్చ|</para>
  <para style="p">
    <verse number="40" style="v"/>అనన్తరమేకః కుష్ఠీ సమాగత్య తత్సమ్ముఖే జానుపాతం వినయఞ్చ కృత్వా కథితవాన్ యది భవాన్ ఇచ్ఛతి తర్హి మాం పరిష్కర్త్తుం శక్నోతి|</para>
  <para style="p">
    <verse number="41" style="v"/>తతః కృపాలు ర్యీశుః కరౌ ప్రసార్య్య తం స్పష్ట్వా కథయామాస</para>
  <para style="p">
    <verse number="42" style="v"/>మమేచ్ఛా విద్యతే త్వం పరిష్కృతో భవ| ఏతత్కథాయాః కథనమాత్రాత్ స కుష్ఠీ రోగాన్ముక్తః పరిష్కృతోఽభవత్|</para>
  <para style="p">
    <verse number="43" style="v"/>తదా స తం విసృజన్ గాఢమాదిశ్య జగాద</para>
  <para style="p">
    <verse number="44" style="v"/>సావధానో భవ కథామిమాం కమపి మా వద; స్వాత్మానం యాజకం దర్శయ, లోకేభ్యః స్వపరిష్కృతేః ప్రమాణదానాయ మూసానిర్ణీతం యద్దానం తదుత్సృజస్వ చ|</para>
  <para style="p">
    <verse number="45" style="v"/>కిన్తు స గత్వా తత్ కర్మ్మ ఇత్థం విస్తార్య్య ప్రచారయితుం ప్రారేభే తేనైవ యీశుః పునః సప్రకాశం నగరం ప్రవేష్టుం నాశక్నోత్ తతోహేతోర్బహిః కాననస్థానే తస్యౌ; తథాపి చతుర్ద్దిగ్భ్యో లోకాస్తస్య సమీపమాయయుః|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>తదనన్తరం యీశై కతిపయదినాని విలమ్బ్య పునః కఫర్నాహూమ్నగరం ప్రవిష్టే స గృహ ఆస్త ఇతి కింవదన్త్యా తత్క్షణం తత్సమీపం బహవో లోకా ఆగత్య సముపతస్థుః,</para>
  <para style="p">
    <verse number="2" style="v"/>తస్మాద్ గృహమధ్యే సర్వ్వేషాం కృతే స్థానం నాభవద్ ద్వారస్య చతుర్దిక్ష్వపి నాభవత్, తత్కాలే స తాన్ ప్రతి కథాం ప్రచారయాఞ్చక్రే|</para>
  <para style="p">
    <verse number="3" style="v"/>తతః పరం లోకాశ్చతుర్భి ర్మానవైరేకం పక్షాఘాతినం వాహయిత్వా తత్సమీపమ్ ఆనిన్యుః|</para>
  <para style="p">
    <verse number="4" style="v"/>కిన్తు జనానాం బహుత్వాత్ తం యీశోః సమ్ముఖమానేతుం న శక్నువన్తో యస్మిన్ స్థానే స ఆస్తే తదుపరిగృహపృష్ఠం ఖనిత్వా ఛిద్రం కృత్వా తేన మార్గేణ సశయ్యం పక్షాఘాతినమ్ అవరోహయామాసుః|</para>
  <para style="p">
    <verse number="5" style="v"/>తతో యీశుస్తేషాం విశ్వాసం దృష్ట్వా తం పక్షాఘాతినం బభాషే హే వత్స తవ పాపానాం మార్జనం భవతు|</para>
  <para style="p">
    <verse number="6" style="v"/>తదా కియన్తోఽధ్యాపకాస్తత్రోపవిశన్తో మనోభి ర్వితర్కయాఞ్చక్రుః, ఏష మనుష్య ఏతాదృశీమీశ్వరనిన్దాం కథాం కుతః కథయతి?</para>
  <para style="p">
    <verse number="7" style="v"/>ఈశ్వరం వినా పాపాని మార్ష్టుం కస్య సామర్థ్యమ్ ఆస్తే?</para>
  <para style="p">
    <verse number="8" style="v"/>ఇత్థం తే వితర్కయన్తి యీశుస్తత్క్షణం మనసా తద్ బుద్వ్వా తానవదద్ యూయమన్తఃకరణైః కుత ఏతాని వితర్కయథ?</para>
  <para style="p">
    <verse number="9" style="v"/>తదనన్తరం యీశుస్తత్స్థానాత్ పునః సముద్రతటం యయౌ; లోకనివహే తత్సమీపమాగతే స తాన్ సముపదిదేశ|</para>
  <para style="p">
    <verse number="10" style="v"/>కిన్తు పృథివ్యాం పాపాని మార్ష్టుం మనుష్యపుత్రస్య సామర్థ్యమస్తి, ఏతద్ యుష్మాన్ జ్ఞాపయితుం (స తస్మై పక్షాఘాతినే కథయామాస)</para>
  <para style="p">
    <verse number="11" style="v"/>ఉత్తిష్ఠ తవ శయ్యాం గృహీత్వా స్వగృహం యాహి, అహం త్వామిదమ్ ఆజ్ఞాపయామి|</para>
  <para style="p">
    <verse number="12" style="v"/>తతః స తత్క్షణమ్ ఉత్థాయ శయ్యాం గృహీత్వా సర్వ్వేషాం సాక్షాత్ జగామ; సర్వ్వే విస్మితా ఏతాదృశం కర్మ్మ వయమ్ కదాపి నాపశ్యామ, ఇమాం కథాం కథయిత్వేశ్వరం ధన్యమబ్రువన్|</para>
  <para style="p">
    <verse number="13" style="v"/>తదనన్తరం యీశుస్తత్స్థానాత్ పునః సముద్రతటం యయౌ; లోకనివహే తత్సమీపమాగతే స తాన్ సముపదిదేశ|</para>
  <para style="p">
    <verse number="14" style="v"/>అథ గచ్ఛన్ కరసఞ్చయగృహ ఉపవిష్టమ్ ఆల్ఫీయపుత్రం లేవిం దృష్ట్వా తమాహూయ కథితవాన్ మత్పశ్చాత్ త్వామామచ్ఛ తతః స ఉత్థాయ తత్పశ్చాద్ యయౌ|</para>
  <para style="p">
    <verse number="15" style="v"/>అనన్తరం యీశౌ తస్య గృహే భోక్తుమ్ ఉపవిష్టే బహవః కరమఞ్చాయినః పాపినశ్చ తేన తచ్ఛిష్యైశ్చ సహోపవివిశుః, యతో బహవస్తత్పశ్చాదాజగ్ముః|</para>
  <para style="p">
    <verse number="16" style="v"/>తదా స కరమఞ్చాయిభిః పాపిభిశ్చ సహ ఖాదతి, తద్ దృష్ట్వాధ్యాపకాః ఫిరూశినశ్చ తస్య శిష్యానూచుః కరమఞ్చాయిభిః పాపిభిశ్చ సహాయం కుతో భుంక్తే పివతి చ?</para>
  <para style="p">
    <verse number="17" style="v"/>తద్వాక్యం శ్రుత్వా యీశుః ప్రత్యువాచ,అరోగిలోకానాం చికిత్సకేన ప్రయోజనం నాస్తి, కిన్తు రోగిణామేవ; అహం ధార్మ్మికానాహ్వాతుం నాగతః కిన్తు మనో వ్యావర్త్తయితుం పాపిన ఏవ|</para>
  <para style="p">
    <verse number="18" style="v"/>తతః పరం యోహనః ఫిరూశినాఞ్చోపవాసాచారిశిష్యా యీశోః సమీపమ్ ఆగత్య కథయామాసుః, యోహనః ఫిరూశినాఞ్చ శిష్యా ఉపవసన్తి కిన్తు భవతః శిష్యా నోపవసన్తి కిం కారణమస్య?</para>
  <para style="p">
    <verse number="19" style="v"/>తదా యీశుస్తాన్ బభాషే యావత్ కాలం సఖిభిః సహ కన్యాయా వరస్తిష్ఠతి తావత్కాలం తే కిముపవస్తుం శక్నువన్తి? యావత్కాలం వరస్తైః సహ తిష్ఠతి తావత్కాలం త ఉపవస్తుం న శక్నువన్తి|</para>
  <para style="p">
    <verse number="20" style="v"/>యస్మిన్ కాలే తేభ్యః సకాశాద్ వరో నేష్యతే స కాల ఆగచ్ఛతి, తస్మిన్ కాలే తే జనా ఉపవత్స్యన్తి|</para>
  <para style="p">
    <verse number="21" style="v"/>కోపి జనః పురాతనవస్త్రే నూతనవస్త్రం న సీవ్యతి, యతో నూతనవస్త్రేణ సహ సేవనే కృతే జీర్ణం వస్త్రం ఛిద్యతే తస్మాత్ పున ర్మహత్ ఛిద్రం జాయతే|</para>
  <para style="p">
    <verse number="22" style="v"/>కోపి జనః పురాతనకుతూషు నూతనం ద్రాక్షారసం న స్థాపయతి, యతో నూతనద్రాక్షారసస్య తేజసా తాః కుత్వో విదీర్య్యన్తే తతో ద్రాక్షారసశ్చ పతతి కుత్వశ్చ నశ్యన్తి, అతఏవ నూతనద్రాక్షారసో నూతనకుతూషు స్థాపనీయః|</para>
  <para style="p">
    <verse number="23" style="v"/>తదనన్తరం యీశు ర్యదా విశ్రామవారే శస్యక్షేత్రేణ గచ్ఛతి తదా తస్య శిష్యా గచ్ఛన్తః శస్యమఞ్జరీశ్ఛేత్తుం ప్రవృత్తాః|</para>
  <para style="p">
    <verse number="24" style="v"/>అతః ఫిరూశినో యీశవే కథయామాసుః పశ్యతు విశ్రామవాసరే యత్ కర్మ్మ న కర్త్తవ్యం తద్ ఇమే కుతః కుర్వ్వన్తి?</para>
  <para style="p">
    <verse number="25" style="v"/>తదా స తేభ్యోఽకథయత్ దాయూద్ తత్సంఙ్గినశ్చ భక్ష్యాభావాత్ క్షుధితాః సన్తో యత్ కర్మ్మ కృతవన్తస్తత్ కిం యుష్మాభి ర్న పఠితమ్?</para>
  <para style="p">
    <verse number="26" style="v"/>అబియాథర్నామకే మహాయాజకతాం కుర్వ్వతి స కథమీశ్వరస్యావాసం ప్రవిశ్య యే దర్శనీయపూపా యాజకాన్ వినాన్యస్య కస్యాపి న భక్ష్యాస్తానేవ బుభుజే సఙ్గిలోకేభ్యోఽపి దదౌ|</para>
  <para style="p">
    <verse number="27" style="v"/>సోఽపరమపి జగాద, విశ్రామవారో మనుష్యార్థమేవ నిరూపితోఽస్తి కిన్తు మనుష్యో విశ్రామవారార్థం నైవ|</para>
  <para style="p">
    <verse number="28" style="v"/>మనుష్యపుత్రో విశ్రామవారస్యాపి ప్రభురాస్తే|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అనన్తరం యీశుః పున ర్భజనగృహం ప్రవిష్టస్తస్మిన్ స్థానే శుష్కహస్త ఏకో మానవ ఆసీత్|</para>
  <para style="p">
    <verse number="2" style="v"/>స విశ్రామవారే తమరోగిణం కరిష్యతి నవేత్యత్ర బహవస్తమ్ అపవదితుం ఛిద్రమపేక్షితవన్తః|</para>
  <para style="p">
    <verse number="3" style="v"/>తదా స తం శుష్కహస్తం మనుష్యం జగాద మధ్యస్థానే త్వముత్తిష్ఠ|</para>
  <para style="p">
    <verse number="4" style="v"/>తతః పరం స తాన్ పప్రచ్ఛ విశ్రామవారే హితమహితం తథా హి ప్రాణరక్షా వా ప్రాణనాశ ఏషాం మధ్యే కిం కరణీయం ? కిన్తు తే నిఃశబ్దాస్తస్థుః|</para>
  <para style="p">
    <verse number="5" style="v"/>తదా స తేషామన్తఃకరణానాం కాఠిన్యాద్ధేతో ర్దుఃఖితః క్రోధాత్ చర్తుिదశో దృష్టవాన్ తం మానుషం గదితవాన్ తం హస్తం విస్తారయ, తతస్తేన హస్తే విస్తృతే తద్ధస్తోఽన్యహస్తవద్ అరోగో జాతః|</para>
  <para style="p">
    <verse number="6" style="v"/>అథ ఫిరూశినః ప్రస్థాయ తం నాశయితుం హేరోదీయైః సహ మన్త్రయితుమారేభిరే|</para>
  <para style="p">
    <verse number="7" style="v"/>అతఏవ యీశుస్తత్స్థానం పరిత్యజ్య శిష్యైః సహ పునః సాగరసమీపం గతః;</para>
  <para style="p">
    <verse number="8" style="v"/>తతో గాలీల్యిహూదా-యిరూశాలమ్-ఇదోమ్-యర్దన్నదీపారస్థానేభ్యో లోకసమూహస్తస్య పశ్చాద్ గతః; తదన్యః సోరసీదనోః సమీపవాసిలోకసమూహశ్చ తస్య మహాకర్మ్మణాం వార్త్తం శ్రుత్వా తస్య సన్నిధిమాగతః|</para>
  <para style="p">
    <verse number="9" style="v"/>తదా లోకసమూహశ్చేత్ తస్యోపరి పతతి ఇత్యాశఙ్క్య స నావమేకాం నికటే స్థాపయితుం శిష్యానాదిష్టవాన్|</para>
  <para style="p">
    <verse number="10" style="v"/>యతోఽనేకమనుష్యాణామారోగ్యకరణాద్ వ్యాధిగ్రస్తాః సర్వ్వే తం స్ప్రష్టుం పరస్పరం బలేన యత్నవన్తః|</para>
  <para style="p">
    <verse number="11" style="v"/>అపరఞ్చ అపవిత్రభూతాస్తం దృష్ట్వా తచ్చరణయోః పతిత్వా ప్రోచైః ప్రోచుః, త్వమీశ్వరస్య పుత్రః|</para>
  <para style="p">
    <verse number="12" style="v"/>కిన్తు స తాన్ దృఢమ్ ఆజ్ఞాప్య స్వం పరిచాయితుం నిషిద్ధవాన్|</para>
  <para style="p">
    <verse number="13" style="v"/>అనన్తరం స పర్వ్వతమారుహ్య యం యం ప్రతిచ్ఛా తం తమాహూతవాన్ తతస్తే తత్సమీపమాగతాః|</para>
  <para style="p">
    <verse number="14" style="v"/>తదా స ద్వాదశజనాన్ స్వేన సహ స్థాతుం సుసంవాదప్రచారాయ ప్రేరితా భవితుం</para>
  <para style="p">
    <verse number="15" style="v"/>సర్వ్వప్రకారవ్యాధీనాం శమనకరణాయ ప్రభావం ప్రాప్తుం భూతాన్ త్యాజయితుఞ్చ నియుక్తవాన్|</para>
  <para style="p">
    <verse number="16" style="v"/>తేషాం నామానీమాని, శిమోన్ సివదిపుత్రో</para>
  <para style="p">
    <verse number="17" style="v"/>యాకూబ్ తస్య భ్రాతా యోహన్ చ ఆన్ద్రియః ఫిలిపో బర్థలమయః,</para>
  <para style="p">
    <verse number="18" style="v"/>మథీ థోమా చ ఆల్ఫీయపుత్రో యాకూబ్ థద్దీయః కినానీయః శిమోన్ యస్తం పరహస్తేష్వర్పయిష్యతి స ఈష్కరియోతీయయిహూదాశ్చ|</para>
  <para style="p">
    <verse number="19" style="v"/>స శిమోనే పితర ఇత్యుపనామ దదౌ యాకూబ్యోహన్భ్యాం చ బినేరిగిశ్ అర్థతో మేఘనాదపుత్రావిత్యుపనామ దదౌ|</para>
  <para style="p">
    <verse number="20" style="v"/>అనన్తరం తే నివేశనం గతాః, కిన్తు తత్రాపి పునర్మహాన్ జనసమాగమో ఽభవత్ తస్మాత్తే భోక్తుమప్యవకాశం న ప్రాప్తాః|</para>
  <para style="p">
    <verse number="21" style="v"/>తతస్తస్య సుహృల్లోకా ఇమాం వార్త్తాం ప్రాప్య స హతజ్ఞానోభూద్ ఇతి కథాం కథయిత్వా తం ధృత్వానేతుం గతాః|</para>
  <para style="p">
    <verse number="22" style="v"/>అపరఞ్చ యిరూశాలమ ఆగతా యే యేఽధ్యాపకాస్తే జగదురయం పురుషో భూతపత్యాబిష్టస్తేన భూతపతినా భూతాన్ త్యాజయతి|</para>
  <para style="p">
    <verse number="23" style="v"/>తతస్తానాహూయ యీశు ర్దృష్టాన్తైః కథాం కథితవాన్ శైతాన్ కథం శైతానం త్యాజయితుం శక్నోతి?</para>
  <para style="p">
    <verse number="24" style="v"/>కిఞ్చన రాజ్యం యది స్వవిరోధేన పృథగ్ భవతి తర్హి తద్ రాజ్యం స్థిరం స్థాతుం న శక్నోతి|</para>
  <para style="p">
    <verse number="25" style="v"/>తథా కస్యాపి పరివారో యది పరస్పరం విరోధీ భవతి తర్హి సోపి పరివారః స్థిరం స్థాతుం న శక్నోతి|</para>
  <para style="p">
    <verse number="26" style="v"/>తద్వత్ శైతాన్ యది స్వవిపక్షతయా ఉత్తిష్ఠన్ భిన్నో భవతి తర్హి సోపి స్థిరం స్థాతుం న శక్నోతి కిన్తూచ్ఛిన్నో భవతి|</para>
  <para style="p">
    <verse number="27" style="v"/>అపరఞ్చ ప్రబలం జనం ప్రథమం న బద్ధా కోపి తస్య గృహం ప్రవిశ్య ద్రవ్యాణి లుణ్ఠయితుం న శక్నోతి, తం బద్వ్వైవ తస్య గృహస్య ద్రవ్యాణి లుణ్ఠయితుం శక్నోతి|</para>
  <para style="p">
    <verse number="28" style="v"/>అతోహేతో ర్యుష్మభ్యమహం సత్యం కథయామి మనుష్యాణాం సన్తానా యాని యాని పాపానీశ్వరనిన్దాఞ్చ కుర్వ్వన్తి తేషాం తత్సర్వ్వేషామపరాధానాం క్షమా భవితుం శక్నోతి,</para>
  <para style="p">
    <verse number="29" style="v"/>కిన్తు యః కశ్చిత్ పవిత్రమాత్మానం నిన్దతి తస్యాపరాధస్య క్షమా కదాపి న భవిష్యతి సోనన్తదణ్డస్యార్హో భవిష్యతి|</para>
  <para style="p">
    <verse number="30" style="v"/>తస్యాపవిత్రభూతోఽస్తి తేషామేతత్కథాహేతోః స ఇత్థం కథితవాన్|</para>
  <para style="p">
    <verse number="31" style="v"/>అథ తస్య మాతా భ్రాతృగణశ్చాగత్య బహిస్తిష్ఠనతో లోకాన్ ప్రేష్య తమాహూతవన్తః|</para>
  <para style="p">
    <verse number="32" style="v"/>తతస్తత్సన్నిధౌ సముపవిష్టా లోకాస్తం బభాషిరే పశ్య బహిస్తవ మాతా భ్రాతరశ్చ త్వామ్ అన్విచ్ఛన్తి|</para>
  <para style="p">
    <verse number="33" style="v"/>తదా స తాన్ ప్రత్యువాచ మమ మాతా కా భ్రాతరో వా కే? తతః పరం స స్వమీపోపవిష్టాన్ శిష్యాన్ ప్రతి అవలోకనం కృత్వా కథయామాస</para>
  <para style="p">
    <verse number="34" style="v"/>పశ్యతైతే మమ మాతా భ్రాతరశ్చ|</para>
  <para style="p">
    <verse number="35" style="v"/>యః కశ్చిద్ ఈశ్వరస్యేష్టాం క్రియాం కరోతి స ఏవ మమ భ్రాతా భగినీ మాతా చ|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అనన్తరం స సముద్రతటే పునరుపదేష్టుం ప్రారేభే, తతస్తత్ర బహుజనానాం సమాగమాత్ స సాగరోపరి నౌకామారుహ్య సముపవిష్టః; సర్వ్వే లోకాః సముద్రకూలే తస్థుః|</para>
  <para style="p">
    <verse number="2" style="v"/>తదా స దృష్టాన్తకథాభి ర్బహూపదిష్టవాన్ ఉపదిశంశ్చ కథితవాన్,</para>
  <para style="p">
    <verse number="3" style="v"/>అవధానం కురుత, ఏకో బీజవప్తా బీజాని వప్తుం గతః;</para>
  <para style="p">
    <verse number="4" style="v"/>వపనకాలే కియన్తి బీజాని మార్గపాశ్వే పతితాని, తత ఆకాశీయపక్షిణ ఏత్య తాని చఖాదుః|</para>
  <para style="p">
    <verse number="5" style="v"/>కియన్తి బీజాని స్వల్పమృత్తికావత్పాషాణభూమౌ పతితాని తాని మృదోల్పత్వాత్ శీఘ్రమఙ్కురితాని;</para>
  <para style="p">
    <verse number="6" style="v"/>కిన్తూదితే సూర్య్యే దగ్ధాని తథా మూలానో నాధోగతత్వాత్ శుష్కాణి చ|</para>
  <para style="p">
    <verse number="7" style="v"/>కియన్తి బీజాని కణ్టకివనమధ్యే పతితాని తతః కణ్టకాని సంవృద్వ్య తాని జగ్రసుస్తాని న చ ఫలితాని|</para>
  <para style="p">
    <verse number="8" style="v"/>తథా కియన్తి బీజాన్యుత్తమభూమౌ పతితాని తాని సంవృద్వ్య ఫలాన్యుత్పాదితాని కియన్తి బీజాని త్రింశద్గుణాని కియన్తి షష్టిగుణాని కియన్తి శతగుణాని ఫలాని ఫలితవన్తి|</para>
  <para style="p">
    <verse number="9" style="v"/>అథ స తానవదత్ యస్య శ్రోతుం కర్ణౌ స్తః స శృణోతు|</para>
  <para style="p">
    <verse number="10" style="v"/>తదనన్తరం నిర్జనసమయే తత్సఙ్గినో ద్వాదశశిష్యాశ్చ తం తద్దృష్టాన్తవాక్యస్యార్థం పప్రచ్ఛుః|</para>
  <para style="p">
    <verse number="11" style="v"/>తదా స తానుదితవాన్ ఈశ్వరరాజ్యస్య నిగూఢవాక్యం బోద్ధుం యుష్మాకమధికారోఽస్తి;</para>
  <para style="p">
    <verse number="12" style="v"/>కిన్తు యే వహిర్భూతాః "తే పశ్యన్తః పశ్యన్తి కిన్తు న జానన్తి, శృణ్వన్తః శృణ్వన్తి కిన్తు న బుధ్యన్తే, చేత్తై ర్మనఃసు కదాపి పరివర్త్తితేషు తేషాం పాపాన్యమోచయిష్యన్త," అతోహేతోస్తాన్ ప్రతి దృష్టాన్తైరేవ తాని మయా కథితాని|</para>
  <para style="p">
    <verse number="13" style="v"/>అథ స కథితవాన్ యూయం కిమేతద్ దృష్టాన్తవాక్యం న బుధ్యధ్వే? తర్హి కథం సర్వ్వాన్ దృష్టాన్తాన భోత్స్యధ్వే?</para>
  <para style="p">
    <verse number="14" style="v"/>బీజవప్తా వాక్యరూపాణి బీజాని వపతి;</para>
  <para style="p">
    <verse number="15" style="v"/>తత్ర యే యే లోకా వాక్యం శృణ్వన్తి, కిన్తు శ్రుతమాత్రాత్ శైతాన్ శీఘ్రమాగత్య తేషాం మనఃసూప్తాని తాని వాక్యరూపాణి బీజాన్యపనయతి తఏవ ఉప్తబీజమార్గపార్శ్వేస్వరూపాః|</para>
  <para style="p">
    <verse number="16" style="v"/>యే జనా వాక్యం శ్రుత్వా సహసా పరమానన్దేన గృహ్లన్తి, కిన్తు హృది స్థైర్య్యాభావాత్ కిఞ్చిత్ కాలమాత్రం తిష్ఠన్తి తత్పశ్చాత్ తద్వాక్యహేతోః</para>
  <para style="p">
    <verse number="17" style="v"/>కుత్రచిత్ క్లేశే ఉపద్రవే వా సముపస్థితే తదైవ విఘ్నం ప్రాప్నువన్తి తఏవ ఉప్తబీజపాషాణభూమిస్వరూపాః|</para>
  <para style="p">
    <verse number="18" style="v"/>యే జనాః కథాం శృణ్వన్తి కిన్తు సాంసారికీ చిన్తా ధనభ్రాన్తి ర్విషయలోభశ్చ ఏతే సర్వ్వే ఉపస్థాయ తాం కథాం గ్రసన్తి తతః మా విఫలా భవతి</para>
  <para style="p">
    <verse number="19" style="v"/>తఏవ ఉప్తబీజసకణ్టకభూమిస్వరూపాః|</para>
  <para style="p">
    <verse number="20" style="v"/>యే జనా వాక్యం శ్రుత్వా గృహ్లన్తి తేషాం కస్య వా త్రింశద్గుణాని కస్య వా షష్టిగుణాని కస్య వా శతగుణాని ఫలాని భవన్తి తఏవ ఉప్తబీజోర్వ్వరభూమిస్వరూపాః|</para>
  <para style="p">
    <verse number="21" style="v"/>తదా సోఽపరమపి కథితవాన్ కోపి జనో దీపాధారం పరిత్యజ్య ద్రోణస్యాధః ఖట్వాయా అధే వా స్థాపయితుం దీపమానయతి కిం?</para>
  <para style="p">
    <verse number="22" style="v"/>అతోహేతో ర్యన్న ప్రకాశయిష్యతే తాదృగ్ లుక్కాయితం కిమపి వస్తు నాస్తి; యద్ వ్యక్తం న భవిష్యతి తాదృశం గుప్తం కిమపి వస్తు నాస్తి|</para>
  <para style="p">
    <verse number="23" style="v"/>యస్య శ్రోతుం కర్ణౌ స్తః స శృణోతు|</para>
  <para style="p">
    <verse number="24" style="v"/>అపరమపి కథితవాన్ యూయం యద్ యద్ వాక్యం శృణుథ తత్ర సావధానా భవత, యతో యూయం యేన పరిమాణేన పరిమాథ తేనైవ పరిమాణేన యుష్మదర్థమపి పరిమాస్యతే; శ్రోతారో యూయం యుష్మభ్యమధికం దాస్యతే|</para>
  <para style="p">
    <verse number="25" style="v"/>యస్యాశ్రయే వర్ద్ధతే తస్మై అపరమపి దాస్యతే, కిన్తు యస్యాశ్రయే న వర్ద్ధతే తస్య యత్ కిఞ్చిదస్తి తదపి తస్మాన్ నేష్యతే|</para>
  <para style="p">
    <verse number="26" style="v"/>అనన్తరం స కథితవాన్ ఏకో లోకః క్షేత్రే బీజాన్యుప్త్వా</para>
  <para style="p">
    <verse number="27" style="v"/>జాగరణనిద్రాభ్యాం దివానిశం గమయతి, పరన్తు తద్వీజం తస్యాజ్ఞాతరూపేణాఙ్కురయతి వర్ద్ధతే చ;</para>
  <para style="p">
    <verse number="28" style="v"/>యతోహేతోః ప్రథమతః పత్రాణి తతః పరం కణిశాని తత్పశ్చాత్ కణిశపూర్ణాని శస్యాని భూమిః స్వయముత్పాదయతి;</para>
  <para style="p">
    <verse number="29" style="v"/>కిన్తు ఫలేషు పక్కేషు శస్యచ్ఛేదనకాలం జ్ఞాత్వా స తత్క్షణం శస్యాని ఛినత్తి, అనేన తుల్యమీశ్వరరాజ్యం|</para>
  <para style="p">
    <verse number="30" style="v"/>పునః సోఽకథయద్ ఈశ్వరరాజ్యం కేన సమం? కేన వస్తునా సహ వా తదుపమాస్యామి?</para>
  <para style="p">
    <verse number="31" style="v"/>తత్ సర్షపైకేన తుల్యం యతో మృది వపనకాలే సర్షపబీజం సర్వ్వపృథివీస్థబీజాత్ క్షుద్రం</para>
  <para style="p">
    <verse number="32" style="v"/>కిన్తు వపనాత్ పరమ్ అఙ్కురయిత్వా సర్వ్వశాకాద్ బృహద్ భవతి, తస్య బృహత్యః శాఖాశ్చ జాయన్తే తతస్తచ్ఛాయాం పక్షిణ ఆశ్రయన్తే|</para>
  <para style="p">
    <verse number="33" style="v"/>ఇత్థం తేషాం బోధానురూపం సోఽనేకదృష్టాన్తైస్తానుపదిష్టవాన్,</para>
  <para style="p">
    <verse number="34" style="v"/>దృష్టాన్తం వినా కామపి కథాం తేభ్యో న కథితవాన్ పశ్చాన్ నిర్జనే స శిష్యాన్ సర్వ్వదృష్టాన్తార్థం బోధితవాన్|</para>
  <para style="p">
    <verse number="35" style="v"/>తద్దినస్య సన్ధ్యాయాం స తేభ్యోఽకథయద్ ఆగచ్ఛత వయం పారం యామ|</para>
  <para style="p">
    <verse number="36" style="v"/>తదా తే లోకాన్ విసృజ్య తమవిలమ్బం గృహీత్వా నౌకయా ప్రతస్థిరే; అపరా అపి నావస్తయా సహ స్థితాః|</para>
  <para style="p">
    <verse number="37" style="v"/>తతః పరం మహాఝఞ్భ్శగమాత్ నౌ ర్దోలాయమానా తరఙ్గేణ జలైః పూర్ణాభవచ్చ|</para>
  <para style="p">
    <verse number="38" style="v"/>తదా స నౌకాచశ్చాద్భాగే ఉపధానే శిరో నిధాయ నిద్రిత ఆసీత్ తతస్తే తం జాగరయిత్వా జగదుః, హే ప్రభో, అస్మాకం ప్రాణా యాన్తి కిమత్ర భవతశ్చిన్తా నాస్తి?</para>
  <para style="p">
    <verse number="39" style="v"/>తదా స ఉత్థాయ వాయుం తర్జితవాన్ సముద్రఞ్చోక్తవాన్ శాన్తః సుస్థిరశ్చ భవ; తతో వాయౌ నివృత్తేఽబ్ధిర్నిస్తరఙ్గోభూత్|</para>
  <para style="p">
    <verse number="40" style="v"/>తదా స తానువాచ యూయం కుత ఏతాదృక్శఙ్కాకులా భవత? కిం వో విశ్వాసో నాస్తి?</para>
  <para style="p">
    <verse number="41" style="v"/>తస్మాత్తేఽతీవభీతాః పరస్పరం వక్తుమారేభిరే, అహో వాయుః సిన్ధుశ్చాస్య నిదేశగ్రాహిణౌ కీదృగయం మనుజః|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అథ తూ సిన్ధుపారం గత్వా గిదేరీయప్రదేశ ఉపతస్థుః|</para>
  <para style="p">
    <verse number="2" style="v"/>నౌకాతో నిర్గతమాత్రాద్ అపవిత్రభూతగ్రస్త ఏకః శ్మశానాదేత్య తం సాక్షాచ్ చకార|</para>
  <para style="p">
    <verse number="3" style="v"/>స శ్మశానేఽవాత్సీత్ కోపి తం శృఙ్ఖలేన బద్వ్వా స్థాపయితుం నాశక్నోత్|</para>
  <para style="p">
    <verse number="4" style="v"/>జనైర్వారం నిగడైః శృఙ్ఖలైశ్చ స బద్ధోపి శృఙ్ఖలాన్యాకృష్య మోచితవాన్ నిగడాని చ భంక్త్వా ఖణ్డం ఖణ్డం కృతవాన్ కోపి తం వశీకర్త్తుం న శశక|</para>
  <para style="p">
    <verse number="5" style="v"/>దివానిశం సదా పర్వ్వతం శ్మశానఞ్చ భ్రమిత్వా చీత్శబ్దం కృతవాన్ గ్రావభిశ్చ స్వయం స్వం కృతవాన్|</para>
  <para style="p">
    <verse number="6" style="v"/>స యీశుం దూరాత్ పశ్యన్నేవ ధావన్ తం ప్రణనామ ఉచైరువంశ్చోవాచ,</para>
  <para style="p">
    <verse number="7" style="v"/>హే సర్వ్వోపరిస్థేశ్వరపుత్ర యీశో భవతా సహ మే కః సమ్బన్ధః? అహం త్వామీశ్వరేణ శాపయే మాం మా యాతయ|</para>
  <para style="p">
    <verse number="8" style="v"/>యతో యీశుస్తం కథితవాన్ రే అపవిత్రభూత, అస్మాన్నరాద్ బహిర్నిర్గచ్ఛ|</para>
  <para style="p">
    <verse number="9" style="v"/>అథ స తం పృష్టవాన్ కిన్తే నామ? తేన ప్రత్యుక్తం వయమనేకే ఽస్మస్తతోఽస్మన్నామ బాహినీ|</para>
  <para style="p">
    <verse number="10" style="v"/>తతోస్మాన్ దేశాన్న ప్రేషయేతి తే తం ప్రార్థయన్త|</para>
  <para style="p">
    <verse number="11" style="v"/>తదానీం పర్వ్వతం నికషా బృహన్ వరాహవ్రజశ్చరన్నాసీత్|</para>
  <para style="p">
    <verse number="12" style="v"/>తస్మాద్ భూతా వినయేన జగదుః, అముం వరాహవ్రజమ్ ఆశ్రయితుమ్ అస్మాన్ ప్రహిణు|</para>
  <para style="p">
    <verse number="13" style="v"/>యీశునానుజ్ఞాతాస్తేఽపవిత్రభూతా బహిర్నిర్యాయ వరాహవ్రజం ప్రావిశన్ తతః సర్వ్వే వరాహా వస్తుతస్తు ప్రాయోద్విసహస్రసంఙ్ఖ్యకాః కటకేన మహాజవాద్ ధావన్తః సిన్ధౌ ప్రాణాన్ జహుః|</para>
  <para style="p">
    <verse number="14" style="v"/>తస్మాద్ వరాహపాలకాః పలాయమానాః పురే గ్రామే చ తద్వార్త్తం కథయాఞ్చక్రుః| తదా లోకా ఘటితం తత్కార్య్యం ద్రష్టుం బహిర్జగ్ముః</para>
  <para style="p">
    <verse number="15" style="v"/>యీశోః సన్నిధిం గత్వా తం భూతగ్రస్తమ్ అర్థాద్ బాహినీభూతగ్రస్తం నరం సవస్త్రం సచేతనం సముపవిష్టఞ్చ దృृష్ట్వా బిభ్యుః|</para>
  <para style="p">
    <verse number="16" style="v"/>తతో దృష్టతత్కార్య్యలోకాస్తస్య భూతగ్రస్తనరస్య వరాహవ్రజస్యాపి తాం ధటనాం వర్ణయామాసుః|</para>
  <para style="p">
    <verse number="17" style="v"/>తతస్తే స్వసీమాతో బహిర్గన్తుం యీశుం వినేతుమారేభిరే|</para>
  <para style="p">
    <verse number="18" style="v"/>అథ తస్య నౌకారోహణకాలే స భూతముక్తో నా యీశునా సహ స్థాతుం ప్రార్థయతే;</para>
  <para style="p">
    <verse number="19" style="v"/>కిన్తు స తమననుమత్య కథితవాన్ త్వం నిజాత్మీయానాం సమీపం గృహఞ్చ గచ్ఛ ప్రభుస్త్వయి కృపాం కృత్వా యాని కర్మ్మాణి కృతవాన్ తాని తాన్ జ్ఞాపయ|</para>
  <para style="p">
    <verse number="20" style="v"/>అతః స ప్రస్థాయ యీశునా కృతం తత్సర్వ్వాశ్చర్య్యం కర్మ్మ దికాపలిదేశే ప్రచారయితుం ప్రారబ్ధవాన్ తతః సర్వ్వే లోకా ఆశ్చర్య్యం మేనిరే|</para>
  <para style="p">
    <verse number="21" style="v"/>అనన్తరం యీశౌ నావా పునరన్యపార ఉత్తీర్ణే సిన్ధుతటే చ తిష్ఠతి సతి తత్సమీపే బహులోకానాం సమాగమోఽభూత్|</para>
  <para style="p">
    <verse number="22" style="v"/>అపరం యాయీర్ నామ్నా కశ్చిద్ భజనగృహస్యాధిప ఆగత్య తం దృష్ట్వైవ చరణయోః పతిత్వా బహు నివేద్య కథితవాన్;</para>
  <para style="p">
    <verse number="23" style="v"/>మమ కన్యా మృతప్రాయాభూద్ అతో భవానేత్య తదారోగ్యాయ తస్యా గాత్రే హస్తమ్ అర్పయతు తేనైవ సా జీవిష్యతి|</para>
  <para style="p">
    <verse number="24" style="v"/>తదా యీశుస్తేన సహ చలితః కిన్తు తత్పశ్చాద్ బహులోకాశ్చలిత్వా తాద్గాత్రే పతితాః|</para>
  <para style="p">
    <verse number="25" style="v"/>అథ ద్వాదశవర్షాణి ప్రదరరోగేణ</para>
  <para style="p">
    <verse number="26" style="v"/>శీర్ణా చికిత్సకానాం నానాచికిత్సాభిశ్చ దుఃఖం భుక్తవతీ చ సర్వ్వస్వం వ్యయిత్వాపి నారోగ్యం ప్రాప్తా చ పునరపి పీడితాసీచ్చ</para>
  <para style="p">
    <verse number="27" style="v"/>యా స్త్రీ సా యీశో ర్వార్త్తాం ప్రాప్య మనసాకథయత్ యద్యహం తస్య వస్త్రమాత్ర స్ప్రష్టుం లభేయం తదా రోగహీనా భవిష్యామి|</para>
  <para style="p">
    <verse number="28" style="v"/>అతోహేతోః సా లోకారణ్యమధ్యే తత్పశ్చాదాగత్య తస్య వస్త్రం పస్పర్శ|</para>
  <para style="p">
    <verse number="29" style="v"/>తేనైవ తత్క్షణం తస్యా రక్తస్రోతః శుష్కం స్వయం తస్మాద్ రోగాన్ముక్తా ఇత్యపి దేహేఽనుభూతా|</para>
  <para style="p">
    <verse number="30" style="v"/>అథ స్వస్మాత్ శక్తి ర్నిర్గతా యీశురేతన్మనసా జ్ఞాత్వా లోకనివహం ప్రతి ముఖం వ్యావృత్య పృష్టవాన్ కేన మద్వస్త్రం స్పృష్టం?</para>
  <para style="p">
    <verse number="31" style="v"/>తతస్తస్య శిష్యా ఊచుః భవతో వపుషి లోకాః సంఘర్షన్తి తద్ దృష్ట్వా కేన మద్వస్త్రం స్పృష్టమితి కుతః కథయతి?</para>
  <para style="p">
    <verse number="32" style="v"/>కిన్తు కేన తత్ కర్మ్మ కృతం తద్ ద్రష్టుం యీశుశ్చతుర్దిశో దృష్టవాన్|</para>
  <para style="p">
    <verse number="33" style="v"/>తతః సా స్త్రీ భీతా కమ్పితా చ సతీ స్వస్యా రుక్ప్రతిక్రియా జాతేతి జ్ఞాత్వాగత్య తత్సమ్ముఖే పతిత్వా సర్వ్వవృత్తాన్తం సత్యం తస్మై కథయామాస|</para>
  <para style="p">
    <verse number="34" style="v"/>తదానీం యీశుస్తాం గదితవాన్, హే కన్యే తవ ప్రతీతిస్త్వామ్ అరోగామకరోత్ త్వం క్షేమేణ వ్రజ స్వరోగాన్ముక్తా చ తిష్ఠ|</para>
  <para style="p">
    <verse number="35" style="v"/>ఇతివాక్యవదనకాలే భజనగృహాధిపస్య నివేశనాల్ లోకా ఏత్యాధిపం బభాషిరే తవ కన్యా మృతా తస్మాద్ గురుం పునః కుతః క్లిశ్నాసి?</para>
  <para style="p">
    <verse number="36" style="v"/>కిన్తు యీశుస్తద్ వాక్యం శ్రుత్వైవ భజనగృహాధిపం గదితవాన్ మా భైషీః కేవలం విశ్వాసిహి|</para>
  <para style="p">
    <verse number="37" style="v"/>అథ పితరో యాకూబ్ తద్భ్రాతా యోహన్ చ ఏతాన్ వినా కమపి స్వపశ్చాద్ యాతుం నాన్వమన్యత|</para>
  <para style="p">
    <verse number="38" style="v"/>తస్య భజనగృహాధిపస్య నివేశనసమీపమ్ ఆగత్య కలహం బహురోదనం విలాపఞ్చ కుర్వ్వతో లోకాన్ దదర్శ|</para>
  <para style="p">
    <verse number="39" style="v"/>తస్మాన్ నివేశనం ప్రవిశ్య ప్రోక్తవాన్ యూయం కుత ఇత్థం కలహం రోదనఞ్చ కురుథ? కన్యా న మృతా నిద్రాతి|</para>
  <para style="p">
    <verse number="40" style="v"/>తస్మాత్తే తముపజహసుః కిన్తు యీశుః సర్వ్వాన బహిష్కృత్య కన్యాయాః పితరౌ స్వసఙ్గినశ్చ గృహీత్వా యత్ర కన్యాసీత్ తత్ స్థానం ప్రవిష్టవాన్|</para>
  <para style="p">
    <verse number="41" style="v"/>అథ స తస్యాః కన్యాయా హస్తౌ ధృత్వా తాం బభాషే టాలీథా కూమీ, అర్థతో హే కన్యే త్వముత్తిష్ఠ ఇత్యాజ్ఞాపయామి|</para>
  <para style="p">
    <verse number="42" style="v"/>తునైవ తత్క్షణం సా ద్వాదశవర్షవయస్కా కన్యా పోత్థాయ చలితుమారేభే, ఇతః సర్వ్వే మహావిస్మయం గతాః|</para>
  <para style="p">
    <verse number="43" style="v"/>తత ఏతస్యై కిఞ్చిత్ ఖాద్యం దత్తేతి కథయిత్వా ఏతత్కర్మ్మ కమపి న జ్ఞాపయతేతి దృఢమాదిష్టవాన్|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అనన్తరం స తత్స్థానాత్ ప్రస్థాయ స్వప్రదేశమాగతః శిష్యాశ్చ తత్పశ్చాద్ గతాః|</para>
  <para style="p">
    <verse number="2" style="v"/>అథ విశ్రామవారే సతి స భజనగృహే ఉపదేష్టుమారబ్ధవాన్ తతోఽనేకే లోకాస్తత్కథాం శ్రుత్వా విస్మిత్య జగదుః, అస్య మనుజస్య ఈదృశీ ఆశ్చర్య్యక్రియా కస్మాజ్ జాతా? తథా స్వకరాభ్యామ్ ఇత్థమద్భుతం కర్మ్మ కర్త్తాुమ్ ఏతస్మై కథం జ్ఞానం దత్తమ్?</para>
  <para style="p">
    <verse number="3" style="v"/>కిమయం మరియమః పుత్రస్తజ్ఞా నో? కిమయం యాకూబ్-యోసి-యిహుదా-శిమోనాం భ్రాతా నో? అస్య భగిన్యః కిమిహాస్మాభిః సహ నో? ఇత్థం తే తదర్థే ప్రత్యూహం గతాః|</para>
  <para style="p">
    <verse number="4" style="v"/>తదా యీశుస్తేభ్యోఽకథయత్ స్వదేశం స్వకుటుమ్బాన్ స్వపరిజనాంశ్చ వినా కుత్రాపి భవిష్యద్వాదీ అసత్కృతో న భవతి|</para>
  <para style="p">
    <verse number="5" style="v"/>అపరఞ్చ తేషామప్రత్యయాత్ స విస్మితః కియతాం రోగిణాం వపుఃషు హస్తమ్ అర్పయిత్వా కేవలం తేషామారోగ్యకరణాద్ అన్యత్ కిమపి చిత్రకార్య్యం కర్త్తాం న శక్తః|</para>
  <para style="p">
    <verse number="6" style="v"/>అథ స చతుర్దిక్స్థ గ్రామాన్ భ్రమిత్వా ఉపదిష్టవాన్</para>
  <para style="p">
    <verse number="7" style="v"/>ద్వాదశశిష్యాన్ ఆహూయ అమేధ్యభూతాన్ వశీకర్త్తాం శక్తిం దత్త్వా తేషాం ద్వౌ ద్వౌ జనో ప్రేషితవాన్|</para>
  <para style="p">
    <verse number="8" style="v"/>పునరిత్యాదిశద్ యూయమ్ ఏకైకాం యష్టిం వినా వస్త్రసంపుటః పూపః కటిబన్ధే తామ్రఖణ్డఞ్చ ఏషాం కిమపి మా గ్రహ్లీత,</para>
  <para style="p">
    <verse number="9" style="v"/>మార్గయాత్రాయై పాదేషూపానహౌ దత్త్వా ద్వే ఉత్తరీయే మా పరిధద్వ్వం|</para>
  <para style="p">
    <verse number="10" style="v"/>అపరమప్యుక్తం తేన యూయం యస్యాం పుర్య్యాం యస్య నివేశనం ప్రవేక్ష్యథ తాం పురీం యావన్న త్యక్ష్యథ తావత్ తన్నివేశనే స్థాస్యథ|</para>
  <para style="p">
    <verse number="11" style="v"/>తత్ర యది కేపి యుష్మాకమాతిథ్యం న విదధతి యుష్మాకం కథాశ్చ న శృణ్వన్తి తర్హి తత్స్థానాత్ ప్రస్థానసమయే తేషాం విరుద్ధం సాక్ష్యం దాతుం స్వపాదానాస్ఫాల్య రజః సమ్పాతయత; అహం యుష్మాన్ యథార్థం వచ్మి విచారదినే తన్నగరస్యావస్థాతః సిదోమామోరయో ర్నగరయోరవస్థా సహ్యతరా భవిష్యతి|</para>
  <para style="p">
    <verse number="12" style="v"/>అథ తే గత్వా లోకానాం మనఃపరావర్త్తనీః కథా ప్రచారితవన్తః|</para>
  <para style="p">
    <verse number="13" style="v"/>ఏవమనేకాన్ భూతాంశ్చ త్యాజితవన్తస్తథా తైలేన మర్ద్దయిత్వా బహూన్ జనానరోగానకార్షుః|</para>
  <para style="p">
    <verse number="14" style="v"/>ఇత్థం తస్య సుఖ్యాతిశ్చతుర్దిశో వ్యాప్తా తదా హేరోద్ రాజా తన్నిశమ్య కథితవాన్, యోహన్ మజ్జకః శ్మశానాద్ ఉత్థిత అతోహేతోస్తేన సర్వ్వా ఏతా అద్భుతక్రియాః ప్రకాశన్తే|</para>
  <para style="p">
    <verse number="15" style="v"/>అన్యేఽకథయన్ అయమ్ ఏలియః, కేపి కథితవన్త ఏష భవిష్యద్వాదీ యద్వా భవిష్యద్వాదినాం సదృశ ఏకోయమ్|</para>
  <para style="p">
    <verse number="16" style="v"/>కిన్తు హేరోద్ ఇత్యాకర్ణ్య భాషితవాన్ యస్యాహం శిరశ్ఛిన్నవాన్ స ఏవ యోహనయం స శ్మశానాదుదతిష్ఠత్|</para>
  <para style="p">
    <verse number="17" style="v"/>పూర్వ్వం స్వభ్రాతుః ఫిలిపస్య పత్న్యా ఉద్వాహం కృతవన్తం హేరోదం యోహనవాదీత్ స్వభాతృవధూ ర్న వివాహ్యా|</para>
  <para style="p">
    <verse number="18" style="v"/>అతః కారణాత్ హేరోద్ లోకం ప్రహిత్య యోహనం ధృత్వా బన్ధనాలయే బద్ధవాన్|</para>
  <para style="p">
    <verse number="19" style="v"/>హేరోదియా తస్మై యోహనే ప్రకుప్య తం హన్తుమ్ ఐచ్ఛత్ కిన్తు న శక్తా,</para>
  <para style="p">
    <verse number="20" style="v"/>యస్మాద్ హేరోద్ తం ధార్మ్మికం సత్పురుషఞ్చ జ్ఞాత్వా సమ్మన్య రక్షితవాన్; తత్కథాం శ్రుత్వా తదనుసారేణ బహూని కర్మ్మాణి కృతవాన్ హృష్టమనాస్తదుపదేశం శ్రుతవాంశ్చ|</para>
  <para style="p">
    <verse number="21" style="v"/>కిన్తు హేరోద్ యదా స్వజన్మదినే ప్రధానలోకేభ్యః సేనానీభ్యశ్చ గాలీల్ప్రదేశీయశ్రేష్ఠలోకేభ్యశ్చ రాత్రౌ భోజ్యమేకం కృతవాన్</para>
  <para style="p">
    <verse number="22" style="v"/>తస్మిన్ శుభదినే హేరోదియాయాః కన్యా సమేత్య తేషాం సమక్షం సంనృత్య హేరోదస్తేన సహోపవిష్టానాఞ్చ తోషమజీజనత్ తతా నృపః కన్యామాహ స్మ మత్తో యద్ యాచసే తదేవ తుభ్యం దాస్యే|</para>
  <para style="p">
    <verse number="23" style="v"/>శపథం కృత్వాకథయత్ చేద్ రాజ్యార్ద్ధమపి యాచసే తదపి తుభ్యం దాస్యే|</para>
  <para style="p">
    <verse number="24" style="v"/>తతః సా బహి ర్గత్వా స్వమాతరం పప్రచ్ఛ కిమహం యాచిష్యే? తదా సాకథయత్ యోహనో మజ్జకస్య శిరః|</para>
  <para style="p">
    <verse number="25" style="v"/>అథ తూర్ణం భూపసమీపమ్ ఏత్య యాచమానావదత్ క్షణేస్మిన్ యోహనో మజ్జకస్య శిరః పాత్రే నిధాయ దేహి, ఏతద్ యాచేఽహం|</para>
  <para style="p">
    <verse number="26" style="v"/>తస్మాత్ భూపోఽతిదుఃఖితః, తథాపి స్వశపథస్య సహభోజినాఞ్చానురోధాత్ తదనఙ్గీకర్త్తుం న శక్తః|</para>
  <para style="p">
    <verse number="27" style="v"/>తత్క్షణం రాజా ఘాతకం ప్రేష్య తస్య శిర ఆనేతుమాదిష్టవాన్|</para>
  <para style="p">
    <verse number="28" style="v"/>తతః స కారాగారం గత్వా తచ్ఛిరశ్ఛిత్వా పాత్రే నిధాయానీయ తస్యై కన్యాయై దత్తవాన్ కన్యా చ స్వమాత్రే దదౌ|</para>
  <para style="p">
    <verse number="29" style="v"/>అననతరం యోహనః శిష్యాస్తద్వార్త్తాం ప్రాప్యాగత్య తస్య కుణపం శ్మశానేఽస్థాపయన్|</para>
  <para style="p">
    <verse number="30" style="v"/>అథ ప్రేషితా యీశోః సన్నిధౌ మిలితా యద్ యచ్ చక్రుః శిక్షయామాసుశ్చ తత్సర్వ్వవార్త్తాస్తస్మై కథితవన్తః|</para>
  <para style="p">
    <verse number="31" style="v"/>స తానువాచ యూయం విజనస్థానం గత్వా విశ్రామ్యత యతస్తత్సన్నిధౌ బహులోకానాం సమాగమాత్ తే భోక్తుం నావకాశం ప్రాప్తాః|</para>
  <para style="p">
    <verse number="32" style="v"/>తతస్తే నావా విజనస్థానం గుప్తం గగ్ముః|</para>
  <para style="p">
    <verse number="33" style="v"/>తతో లోకనివహస్తేషాం స్థానాన్తరయానం దదర్శ, అనేకే తం పరిచిత్య నానాపురేభ్యః పదైర్వ్రజిత్వా జవేన తైషామగ్రే యీశోః సమీప ఉపతస్థుః|</para>
  <para style="p">
    <verse number="34" style="v"/>తదా యీశు ర్నావో బహిర్గత్య లోకారణ్యానీం దృష్ట్వా తేషు కరుణాం కృతవాన్ యతస్తేఽరక్షకమేషా ఇవాసన్ తదా స తాన నానాప్రసఙ్గాన్ ఉపదిష్టవాన్|</para>
  <para style="p">
    <verse number="35" style="v"/>అథ దివాన్తే సతి శిష్యా ఏత్య యీశుమూచిరే, ఇదం విజనస్థానం దినఞ్చావసన్నం|</para>
  <para style="p">
    <verse number="36" style="v"/>లోకానాం కిమపి ఖాద్యం నాస్తి, అతశ్చతుర్దిక్షు గ్రామాన్ గన్తుం భోజ్యద్రవ్యాణి క్రేతుఞ్చ భవాన్ తాన్ విసృజతు|</para>
  <para style="p">
    <verse number="37" style="v"/>తదా స తానువాచ యూయమేవ తాన్ భోజయత; తతస్తే జగదు ర్వయం గత్వా ద్విశతసంఖ్యకై ర్ముద్రాపాదైః పూపాన్ క్రీత్వా కిం తాన్ భోజయిష్యామః?</para>
  <para style="p">
    <verse number="38" style="v"/>తదా స తాన్ పృష్ఠవాన్ యుష్మాకం సన్నిధౌ కతి పూపా ఆసతే? గత్వా పశ్యత; తతస్తే దృష్ట్వా తమవదన్ పఞ్చ పూపా ద్వౌ మత్స్యౌ చ సన్తి|</para>
  <para style="p">
    <verse number="39" style="v"/>తదా స లోకాన్ శస్పోపరి పంక్తిభిరుపవేశయితుమ్ ఆదిష్టవాన్,</para>
  <para style="p">
    <verse number="40" style="v"/>తతస్తే శతం శతం జనాః పఞ్చాశత్ పఞ్చాశజ్జనాశ్చ పంక్తిభి ర్భువి సముపవివిశుః|</para>
  <para style="p">
    <verse number="41" style="v"/>అథ స తాన్ పఞ్చపూపాన్ మత్స్యద్వయఞ్చ ధృత్వా స్వర్గం పశ్యన్ ఈశ్వరగుణాన్ అన్వకీర్త్తయత్ తాన్ పూపాన్ భంక్త్వా లోకేభ్యః పరివేషయితుం శిష్యేభ్యో దత్తవాన్ ద్వా మత్స్యౌ చ విభజ్య సర్వ్వేభ్యో దత్తవాన్|</para>
  <para style="p">
    <verse number="42" style="v"/>తతః సర్వ్వే భుక్త్వాతృప్యన్|</para>
  <para style="p">
    <verse number="43" style="v"/>అనన్తరం శిష్యా అవశిష్టైః పూపై ర్మత్స్యైశ్చ పూర్ణాన్ ద్వదశ డల్లకాన్ జగృహుః|</para>
  <para style="p">
    <verse number="44" style="v"/>తే భోక్తారః ప్రాయః పఞ్చ సహస్రాణి పురుషా ఆసన్|</para>
  <para style="p">
    <verse number="45" style="v"/>అథ స లోకాన్ విసృజన్నేవ నావమారోఢుం స్వస్మాదగ్రే పారే బైత్సైదాపురం యాతుఞ్చ శ్ష్యిाన్ వాఢమాదిష్టవాన్|</para>
  <para style="p">
    <verse number="46" style="v"/>తదా స సర్వ్వాన్ విసృజ్య ప్రార్థయితుం పర్వ్వతం గతః|</para>
  <para style="p">
    <verse number="47" style="v"/>తతః సన్ధ్యాయాం సత్యాం నౌః సిన్ధుమధ్య ఉపస్థితా కిన్తు స ఏకాకీ స్థలే స్థితః|</para>
  <para style="p">
    <verse number="48" style="v"/>అథ సమ్ముఖవాతవహనాత్ శిష్యా నావం వాహయిత్వా పరిశ్రాన్తా ఇతి జ్ఞాత్వా స నిశాచతుర్థయామే సిన్ధూపరి పద్భ్యాం వ్రజన్ తేషాం సమీపమేత్య తేషామగ్రే యాతుమ్ ఉద్యతః|</para>
  <para style="p">
    <verse number="49" style="v"/>కిన్తు శిష్యాః సిన్ధూపరి తం వ్రజన్తం దృష్ట్వా భూతమనుమాయ రురువుః,</para>
  <para style="p">
    <verse number="50" style="v"/>యతః సర్వ్వే తం దృష్ట్వా వ్యాకులితాః| అతఏవ యీశుస్తత్క్షణం తైః సహాలప్య కథితవాన్, సుస్థిరా భూత, అయమహం మా భైష్ట|</para>
  <para style="p">
    <verse number="51" style="v"/>అథ నౌకామారుహ్య తస్మిన్ తేషాం సన్నిధిం గతే వాతో నివృత్తః; తస్మాత్తే మనఃసు విస్మితా ఆశ్చర్య్యం మేనిరే|</para>
  <para style="p">
    <verse number="52" style="v"/>యతస్తే మనసాం కాఠిన్యాత్ తత్ పూపీయమ్ ఆశ్చర్య్యం కర్మ్మ న వివిక్తవన్తః|</para>
  <para style="p">
    <verse number="53" style="v"/>అథ తే పారం గత్వా గినేషరత్ప్రదేశమేత్య తట ఉపస్థితాః|</para>
  <para style="p">
    <verse number="54" style="v"/>తేషు నౌకాతో బహిర్గతేషు తత్ప్రదేశీయా లోకాస్తం పరిచిత్య</para>
  <para style="p">
    <verse number="55" style="v"/>చతుర్దిక్షు ధావన్తో యత్ర యత్ర రోగిణో నరా ఆసన్ తాన్ సర్వ్వాన ఖట్వోపరి నిధాయ యత్ర కుత్రచిత్ తద్వార్త్తాం ప్రాపుః తత్ స్థానమ్ ఆనేతుమ్ ఆరేభిరే|</para>
  <para style="p">
    <verse number="56" style="v"/>తథా యత్ర యత్ర గ్రామే యత్ర యత్ర పురే యత్ర యత్ర పల్ల్యాఞ్చ తేన ప్రవేశః కృతస్తద్వర్త్మమధ్యే లోకాః పీడితాన్ స్థాపయిత్వా తస్య చేలగ్రన్థిమాత్రం స్ప్రష్టుమ్ తేషామర్థే తదనుజ్ఞాం ప్రార్థయన్తః యావన్తో లోకాః పస్పృశుస్తావన్త ఏవ గదాన్ముక్తాః|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అనన్తరం యిరూశాలమ ఆగతాః ఫిరూశినోఽధ్యాపకాశ్చ యీశోః సమీపమ్ ఆగతాః|</para>
  <para style="p">
    <verse number="2" style="v"/>తే తస్య కియతః శిష్యాన్ అశుచికరైరర్థాద అప్రక్షాలితహస్తై ర్భుఞ్జతో దృష్ట్వా తానదూషయన్|</para>
  <para style="p">
    <verse number="3" style="v"/>యతః ఫిరూశినః సర్వ్వయిహూదీయాశ్చ ప్రాచాం పరమ్పరాగతవాక్యం సమ్మన్య ప్రతలేన హస్తాన్ అప్రక్షాల్య న భుఞ్జతే|</para>
  <para style="p">
    <verse number="4" style="v"/>ఆపనాదాగత్య మజ్జనం వినా న ఖాదన్తి; తథా పానపాత్రాణాం జలపాత్రాణాం పిత్తలపాత్రాణామ్ ఆసనానాఞ్చ జలే మజ్జనమ్ ఇత్యాదయోన్యేపి బహవస్తేషామాచారాః సన్తి|</para>
  <para style="p">
    <verse number="5" style="v"/>తే ఫిరూశినోఽధ్యాపకాశ్చ యీశుం పప్రచ్ఛుః, తవ శిష్యాః ప్రాచాం పరమ్పరాగతవాక్యానుసారేణ నాచరన్తోఽప్రక్షాలితకరైః కుతో భుజంతే?</para>
  <para style="p">
    <verse number="6" style="v"/>తతః స ప్రత్యువాచ కపటినో యుష్మాన్ ఉద్దిశ్య యిశయియభవిష్యద్వాదీ యుక్తమవాదీత్| యథా స్వకీయైరధరైరేతే సమ్మన్యనతే సదైవ మాం| కిన్తు మత్తో విప్రకర్షే సన్తి తేషాం మనాంసి చ|</para>
  <para style="p">
    <verse number="7" style="v"/>శిక్షయన్తో బిధీన్ న్నాజ్ఞా భజన్తే మాం ముధైవ తే|</para>
  <para style="p">
    <verse number="8" style="v"/>యూయం జలపాత్రపానపాత్రాదీని మజ్జయన్తో మనుజపరమ్పరాగతవాక్యం రక్షథ కిన్తు ఈశ్వరాజ్ఞాం లంఘధ్వే; అపరా ఈదృశ్యోనేకాః క్రియా అపి కురుధ్వే|</para>
  <para style="p">
    <verse number="9" style="v"/>అన్యఞ్చాకథయత్ యూయం స్వపరమ్పరాగతవాక్యస్య రక్షార్థం స్పష్టరూపేణ ఈశ్వరాజ్ఞాం లోపయథ|</para>
  <para style="p">
    <verse number="10" style="v"/>యతో మూసాద్వారా ప్రోక్తమస్తి స్వపితరౌ సమ్మన్యధ్వం యస్తు మాతరం పితరం వా దుర్వ్వాక్యం వక్తి స నితాన్తం హన్యతాం|</para>
  <para style="p">
    <verse number="11" style="v"/>కిన్తు మదీయేన యేన ద్రవ్యేణ తవోపకారోభవత్ తత్ కర్బ్బాణమర్థాద్ ఈశ్వరాయ నివేదితమ్ ఇదం వాక్యం యది కోపి పితరం మాతరం వా వక్తి</para>
  <para style="p">
    <verse number="12" style="v"/>తర్హి యూయం మాతుః పితు ర్వోపకారం కర్త్తాం తం వారయథ|</para>
  <para style="p">
    <verse number="13" style="v"/>ఇత్థం స్వప్రచారితపరమ్పరాగతవాక్యేన యూయమ్ ఈశ్వరాజ్ఞాం ముధా విధద్వ్వే, ఈదృశాన్యన్యాన్యనేకాని కర్మ్మాణి కురుధ్వే|</para>
  <para style="p">
    <verse number="14" style="v"/>అథ స లోకానాహూయ బభాషే యూయం సర్వ్వే మద్వాక్యం శృణుత బుధ్యధ్వఞ్చ|</para>
  <para style="p">
    <verse number="15" style="v"/>బాహ్యాదన్తరం ప్రవిశ్య నరమమేధ్యం కర్త్తాం శక్నోతి ఈదృశం కిమపి వస్తు నాస్తి, వరమ్ అన్తరాద్ బహిర్గతం యద్వస్తు తన్మనుజమ్ అమేధ్యం కరోతి|</para>
  <para style="p">
    <verse number="16" style="v"/>యస్య శ్రోతుం శ్రోత్రే స్తః స శృణోతు|</para>
  <para style="p">
    <verse number="17" style="v"/>తతః స లోకాన్ హిత్వా గృహమధ్యం ప్రవిష్టస్తదా శిష్యాస్తదృష్టాన్తవాక్యార్థం పప్రచ్ఛుః|</para>
  <para style="p">
    <verse number="18" style="v"/>తస్మాత్ స తాన్ జగాద యూయమపి కిమేతాదృగబోధాః? కిమపి ద్రవ్యం బాహ్యాదన్తరం ప్రవిశ్య నరమమేధ్యం కర్త్తాం న శక్నోతి కథామిమాం కిం న బుధ్యధ్వే?</para>
  <para style="p">
    <verse number="19" style="v"/>తత్ తదన్తర్న ప్రవిశతి కిన్తు కుక్షిమధ్యం ప్రవిశతి శేషే సర్వ్వభుక్తవస్తుగ్రాహిణి బహిర్దేశే నిర్యాతి|</para>
  <para style="p">
    <verse number="20" style="v"/>అపరమప్యవాదీద్ యన్నరాన్నిరేతి తదేవ నరమమేధ్యం కరోతి|</para>
  <para style="p">
    <verse number="21" style="v"/>యతోఽన్తరాద్ అర్థాన్ మానవానాం మనోభ్యః కుచిన్తా పరస్త్రీవేశ్యాగమనం</para>
  <para style="p">
    <verse number="22" style="v"/>నరవధశ్చౌర్య్యం లోభో దుష్టతా ప్రవఞ్చనా కాముకతా కుదృష్టిరీశ్వరనిన్దా గర్వ్వస్తమ ఇత్యాదీని నిర్గచ్ఛన్తి|</para>
  <para style="p">
    <verse number="23" style="v"/>ఏతాని సర్వ్వాణి దురితాన్యన్తరాదేత్య నరమమేధ్యం కుర్వ్వన్తి|</para>
  <para style="p">
    <verse number="24" style="v"/>అథ స ఉత్థాయ తత్స్థానాత్ సోరసీదోన్పురప్రదేశం జగామ తత్ర కిమపి నివేశనం ప్రవిశ్య సర్వ్వైరజ్ఞాతః స్థాతుం మతిఞ్చక్రే కిన్తు గుప్తః స్థాతుం న శశాక|</para>
  <para style="p">
    <verse number="25" style="v"/>యతః సురఫైనికీదేశీయయూనానీవంశోద్భవస్త్రియాః కన్యా భూతగ్రస్తాసీత్| సా స్త్రీ తద్వార్త్తాం ప్రాప్య తత్సమీపమాగత్య తచ్చరణయోః పతిత్వా</para>
  <para style="p">
    <verse number="26" style="v"/>స్వకన్యాతో భూతం నిరాకర్త్తాం తస్మిన్ వినయం కృతవతీ|</para>
  <para style="p">
    <verse number="27" style="v"/>కిన్తు యీశుస్తామవదత్ ప్రథమం బాలకాస్తృప్యన్తు యతో బాలకానాం ఖాద్యం గృహీత్వా కుక్కురేభ్యో నిక్షేపోఽనుచితః|</para>
  <para style="p">
    <verse number="28" style="v"/>తదా సా స్త్రీ తమవాదీత్ భోః ప్రభో తత్ సత్యం తథాపి మఞ్చాధఃస్థాః కుక్కురా బాలానాం కరపతితాని ఖాద్యఖణ్డాని ఖాదన్తి|</para>
  <para style="p">
    <verse number="29" style="v"/>తతః సోఽకథయద్ ఏతత్కథాహేతోః సకుశలా యాహి తవ కన్యాం త్యక్త్వా భూతో గతః|</para>
  <para style="p">
    <verse number="30" style="v"/>అథ సా స్త్రీ గృహం గత్వా కన్యాం భూతత్యక్తాం శయ్యాస్థితాం దదర్శ|</para>
  <para style="p">
    <verse number="31" style="v"/>పునశ్చ స సోరసీదోన్పురప్రదేశాత్ ప్రస్థాయ దికాపలిదేశస్య ప్రాన్తరభాగేన గాలీల్జలధేః సమీపం గతవాన్|</para>
  <para style="p">
    <verse number="32" style="v"/>తదా లోకైరేకం బధిరం కద్వదఞ్చ నరం తన్నికటమానీయ తస్య గాత్రే హస్తమర్పయితుం వినయః కృతః|</para>
  <para style="p">
    <verse number="33" style="v"/>తతో యీశు ర్లోకారణ్యాత్ తం నిర్జనమానీయ తస్య కర్ణయోఙ్గులీ ర్దదౌ నిష్ఠీవం దత్త్వా చ తజ్జిహ్వాం పస్పర్శ|</para>
  <para style="p">
    <verse number="34" style="v"/>అనన్తరం స్వర్గం నిరీక్ష్య దీర్ఘం నిశ్వస్య తమవదత్ ఇతఫతః అర్థాన్ ముక్తో భూయాత్|</para>
  <para style="p">
    <verse number="35" style="v"/>తతస్తత్క్షణం తస్య కర్ణౌ ముక్తౌ జిహ్వాయాశ్చ జాడ్యాపగమాత్ స సుస్పష్టవాక్యమకథయత్|</para>
  <para style="p">
    <verse number="36" style="v"/>అథ స తాన్ వాఢమిత్యాదిదేశ యూయమిమాం కథాం కస్మైచిదపి మా కథయత, కిన్తు స యతి న్యషేధత్ తే తతి బాహుల్యేన ప్రాచారయన్;</para>
  <para style="p">
    <verse number="37" style="v"/>తేఽతిచమత్కృత్య పరస్పరం కథయామాసుః స బధిరాయ శ్రవణశక్తిం మూకాయ చ కథనశక్తిం దత్త్వా సర్వ్వం కర్మ్మోత్తమరూపేణ చకార|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>తదా తత్సమీపం బహవో లోకా ఆయాతా అతస్తేషాం భోజ్యద్రవ్యాభావాద్ యీశుః శిష్యానాహూయ జగాద,|</para>
  <para style="p">
    <verse number="2" style="v"/>లోకనివహే మమ కృపా జాయతే తే దినత్రయం మయా సార్ద్ధం సన్తి తేషాం భోజ్యం కిమపి నాస్తి|</para>
  <para style="p">
    <verse number="3" style="v"/>తేషాం మధ్యేఽనేకే దూరాద్ ఆగతాః, అభుక్తేషు తేషు మయా స్వగృహమభిప్రహితేషు తే పథి క్లమిష్యన్తి|</para>
  <para style="p">
    <verse number="4" style="v"/>శిష్యా అవాదిషుః, ఏతావతో లోకాన్ తర్పయితుమ్ అత్ర ప్రన్తరే పూపాన్ ప్రాప్తుం కేన శక్యతే?</para>
  <para style="p">
    <verse number="5" style="v"/>తతః స తాన్ పప్రచ్ఛ యుష్మాకం కతి పూపాః సన్తి? తేఽకథయన్ సప్త|</para>
  <para style="p">
    <verse number="6" style="v"/>తతః స తాల్లోకాన్ భువి సముపవేష్టుమ్ ఆదిశ్య తాన్ సప్త పూపాన్ ధృత్వా ఈశ్వరగుణాన్ అనుకీర్త్తయామాస, భంక్త్వా పరివేషయితుం శిష్యాన్ ప్రతి దదౌ, తతస్తే లోకేభ్యః పరివేషయామాసుః|</para>
  <para style="p">
    <verse number="7" style="v"/>తథా తేషాం సమీపే యే క్షుద్రమత్స్యా ఆసన్ తానప్యాదాయ ఈశ్వరగుణాన్ సంకీర్త్య పరివేషయితుమ్ ఆదిష్టవాన్|</para>
  <para style="p">
    <verse number="8" style="v"/>తతో లోకా భుక్త్వా తృప్తిం గతా అవశిష్టఖాద్యైః పూర్ణాః సప్తడల్లకా గృహీతాశ్చ|</para>
  <para style="p">
    <verse number="9" style="v"/>ఏతే భోక్తారః ప్రాయశ్చతుః సహస్రపురుషా ఆసన్ తతః స తాన్ విససర్జ|</para>
  <para style="p">
    <verse number="10" style="v"/>అథ స శిష్యః సహ నావమారుహ్య దల్మానూథాసీమామాగతః|</para>
  <para style="p">
    <verse number="11" style="v"/>తతః పరం ఫిరూశిన ఆగత్య తేన సహ వివదమానాస్తస్య పరీక్షార్థమ్ ఆకాశీయచిహ్నం ద్రష్టుం యాచితవన్తః|</para>
  <para style="p">
    <verse number="12" style="v"/>తదా సోఽన్తర్దీర్ఘం నిశ్వస్యాకథయత్, ఏతే విద్యమాననరాః కుతశ్చిన్హం మృగయన్తే? యుష్మానహం యథార్థం బ్రవీమి లోకానేతాన్ కిమపి చిహ్నం న దర్శయిష్యతే|</para>
  <para style="p">
    <verse number="13" style="v"/>అథ తాన్ హిత్వా పున ర్నావమ్ ఆరుహ్య పారమగాత్|</para>
  <para style="p">
    <verse number="14" style="v"/>ఏతర్హి శిష్యైః పూపేషు విస్మృతేషు నావి తేషాం సన్నిధౌ పూప ఏకఏవ స్థితః|</para>
  <para style="p">
    <verse number="15" style="v"/>తదానీం యీశుస్తాన్ ఆదిష్టవాన్ ఫిరూశినాం హేరోదశ్చ కిణ్వం ప్రతి సతర్కాః సావధానాశ్చ భవత|</para>
  <para style="p">
    <verse number="16" style="v"/>తతస్తేఽన్యోన్యం వివేచనం కర్తుమ్ ఆరేభిరే, అస్మాకం సన్నిధౌ పూపో నాస్తీతి హేతోరిదం కథయతి|</para>
  <para style="p">
    <verse number="17" style="v"/>తద్ బుద్వ్వా యీశుస్తేభ్యోఽకథయత్ యుష్మాకం స్థానే పూపాభావాత్ కుత ఇత్థం వితర్కయథ? యూయం కిమద్యాపి కిమపి న జానీథ? బోద్ధుఞ్చ న శక్నుథ? యావదద్య కిం యుష్మాకం మనాంసి కఠినాని సన్తి?</para>
  <para style="p">
    <verse number="18" style="v"/>సత్సు నేత్రేషు కిం న పశ్యథ? సత్సు కర్ణేషు కిం న శృణుథ? న స్మరథ చ?</para>
  <para style="p">
    <verse number="19" style="v"/>యదాహం పఞ్చపూపాన్ పఞ్చసహస్రాణాం పురుషాణాం మధ్యే భంక్త్వా దత్తవాన్ తదానీం యూయమ్ అవశిష్టపూపైః పూర్ణాన్ కతి డల్లకాన్ గృహీతవన్తః? తేఽకథయన్ ద్వాదశడల్లకాన్|</para>
  <para style="p">
    <verse number="20" style="v"/>అపరఞ్చ యదా చతుఃసహస్రాణాం పురుషాణాం మధ్యే పూపాన్ భంక్త్వాదదాం తదా యూయమ్ అతిరిక్తపూపానాం కతి డల్లకాన్ గృహీతవన్తః? తే కథయామాసుః సప్తడల్లకాన్|</para>
  <para style="p">
    <verse number="21" style="v"/>తదా స కథితవాన్ తర్హి యూయమ్ అధునాపి కుతో బోద్వ్వుం న శక్నుథ?</para>
  <para style="p">
    <verse number="22" style="v"/>అనన్తరం తస్మిన్ బైత్సైదానగరే ప్రాప్తే లోకా అన్ధమేకం నరం తత్సమీపమానీయ తం స్ప్రష్టుం తం ప్రార్థయాఞ్చక్రిరే|</para>
  <para style="p">
    <verse number="23" style="v"/>తదా తస్యాన్ధస్య కరౌ గృహీత్వా నగరాద్ బహిర్దేశం తం నీతవాన్; తన్నేత్రే నిష్ఠీవం దత్త్వా తద్గాత్రే హస్తావర్పయిత్వా తం పప్రచ్ఛ, కిమపి పశ్యసి?</para>
  <para style="p">
    <verse number="24" style="v"/>స నేత్రే ఉన్మీల్య జగాద, వృక్షవత్ మనుజాన్ గచ్ఛతో నిరీక్షే|</para>
  <para style="p">
    <verse number="25" style="v"/>తతో యీశుః పునస్తస్య నయనయో ర్హస్తావర్పయిత్వా తస్య నేత్రే ఉన్మీలయామాస; తస్మాత్ స స్వస్థో భూత్వా స్పష్టరూపం సర్వ్వలోకాన్ దదర్శ|</para>
  <para style="p">
    <verse number="26" style="v"/>తతః పరం త్వం గ్రామం మా గచ్ఛ గ్రామస్థం కమపి చ కిమప్యనుక్త్వా నిజగృహం యాహీత్యాదిశ్య యీశుస్తం నిజగృహం ప్రహితవాన్|</para>
  <para style="p">
    <verse number="27" style="v"/>అనన్తరం శిష్యైః సహితో యీశుః కైసరీయాఫిలిపిపురం జగామ, పథి గచ్ఛన్ తానపృచ్ఛత్ కోఽహమ్ అత్ర లోకాః కిం వదన్తి?</para>
  <para style="p">
    <verse number="28" style="v"/>తే ప్రత్యూచుః త్వాం యోహనం మజ్జకం వదన్తి కిన్తు కేపి కేపి ఏలియం వదన్తి; అపరే కేపి కేపి భవిష్యద్వాదినామ్ ఏకో జన ఇతి వదన్తి|</para>
  <para style="p">
    <verse number="29" style="v"/>అథ స తానపృచ్ఛత్ కిన్తు కోహమ్? ఇత్యత్ర యూయం కిం వదథ? తదా పితరః ప్రత్యవదత్ భవాన్ అభిషిక్తస్త్రాతా|</para>
  <para style="p">
    <verse number="30" style="v"/>తతః స తాన్ గాఢమాదిశద్ యూయం మమ కథా కస్మైచిదపి మా కథయత|</para>
  <para style="p">
    <verse number="31" style="v"/>మనుష్యపుత్రేణావశ్యం బహవో యాతనా భోక్తవ్యాః ప్రాచీనలోకైః ప్రధానయాజకైరధ్యాపకైశ్చ స నిన్దితః సన్ ఘాతయిష్యతే తృతీయదినే ఉత్థాస్యతి చ, యీశుః శిష్యానుపదేష్టుమారభ్య కథామిమాం స్పష్టమాచష్ట|</para>
  <para style="p">
    <verse number="32" style="v"/>తస్మాత్ పితరస్తస్య హస్తౌ ధృత్వా తం తర్జ్జితవాన్|</para>
  <para style="p">
    <verse number="33" style="v"/>కిన్తు స ముఖం పరావర్త్య శిష్యగణం నిరీక్ష్య పితరం తర్జయిత్వావాదీద్ దూరీభవ విఘ్నకారిన్ ఈశ్వరీయకార్య్యాదపి మనుష్యకార్య్యం తుభ్యం రోచతతరాం|</para>
  <para style="p">
    <verse number="34" style="v"/>అథ స లోకాన్ శిష్యాంశ్చాహూయ జగాద యః కశ్చిన్ మామనుగన్తుమ్ ఇచ్ఛతి స ఆత్మానం దామ్యతు, స్వక్రుశం గృహీత్వా మత్పశ్చాద్ ఆయాతు|</para>
  <para style="p">
    <verse number="35" style="v"/>యతో యః కశ్చిత్ స్వప్రాణం రక్షితుమిచ్ఛతి స తం హారయిష్యతి, కిన్తు యః కశ్చిన్ మదర్థం సుసంవాదార్థఞ్చ ప్రాణం హారయతి స తం రక్షిష్యతి|</para>
  <para style="p">
    <verse number="36" style="v"/>అపరఞ్చ మనుజః సర్వ్వం జగత్ ప్రాప్య యది స్వప్రాణం హారయతి తర్హి తస్య కో లాభః?</para>
  <para style="p">
    <verse number="37" style="v"/>నరః స్వప్రాణవినిమయేన కిం దాతుం శక్నోతి?</para>
  <para style="p">
    <verse number="38" style="v"/>ఏతేషాం వ్యభిచారిణాం పాపినాఞ్చ లోకానాం సాక్షాద్ యది కోపి మాం మత్కథాఞ్చ లజ్జాస్పదం జానాతి తర్హి మనుజపుత్రో యదా ధర్మ్మదూతైః సహ పితుః ప్రభావేణాగమిష్యతి తదా సోపి తం లజ్జాస్పదం జ్ఞాస్యతి|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అథ స తానవాదీత్ యుష్మభ్యమహం యథార్థం కథయామి, ఈశ్వరరాజ్యం పరాక్రమేణోపస్థితం న దృష్ట్వా మృత్యుం నాస్వాదిష్యన్తే, అత్ర దణ్డాయమానానాం మధ్యేపి తాదృశా లోకాః సన్తి|</para>
  <para style="p">
    <verse number="2" style="v"/>అథ షడ్దినేభ్యః పరం యీశుః పితరం యాకూబం యోహనఞ్చ గృహీత్వా గిరేరుచ్చస్య నిర్జనస్థానం గత్వా తేషాం ప్రత్యక్షే మూర్త్యన్తరం దధార|</para>
  <para style="p">
    <verse number="3" style="v"/>తతస్తస్య పరిధేయమ్ ఈదృశమ్ ఉజ్జ్వలహిమపాణడరం జాతం యద్ జగతి కోపి రజకో న తాదృక్ పాణడరం కర్త్తాం శక్నోతి|</para>
  <para style="p">
    <verse number="4" style="v"/>అపరఞ్చ ఏలియో మూసాశ్చ తేభ్యో దర్శనం దత్త్వా యీశునా సహ కథనం కర్త్తుమారేభాతే|</para>
  <para style="p">
    <verse number="5" style="v"/>తదా పితరో యీశుమవాదీత్ హే గురోఽస్మాకమత్ర స్థితిరుత్తమా, తతఏవ వయం త్వత్కృతే ఏకాం మూసాకృతే ఏకామ్ ఏలియకృతే చైకాం, ఏతాస్తిస్రః కుటీ ర్నిర్మ్మామ|</para>
  <para style="p">
    <verse number="6" style="v"/>కిన్తు స యదుక్తవాన్ తత్ స్వయం న బుబుధే తతః సర్వ్వే బిభయాఞ్చక్రుః|</para>
  <para style="p">
    <verse number="7" style="v"/>ఏతర్హి పయోదస్తాన్ ఛాదయామాస, మమయాం ప్రియః పుత్రః కథాసు తస్య మనాంసి నివేశయతేతి నభోవాణీ తన్మేద్యాన్నిర్యయౌ|</para>
  <para style="p">
    <verse number="8" style="v"/>అథ హఠాత్తే చతుర్దిశో దృష్ట్వా యీశుం వినా స్వైః సహితం కమపి న దదృశుః|</para>
  <para style="p">
    <verse number="9" style="v"/>తతః పరం గిరేరవరోహణకాలే స తాన్ గాఢమ్ దూత్యాదిదేశ యావన్నరసూనోః శ్మశానాదుత్థానం న భవతి, తావత్ దర్శనస్యాస్య వార్త్తా యుష్మాభిః కస్మైచిదపి న వక్తవ్యా|</para>
  <para style="p">
    <verse number="10" style="v"/>తదా శ్మశానాదుత్థానస్య కోభిప్రాయ ఇతి విచార్య్య తే తద్వాక్యం స్వేషు గోపాయాఞ్చక్రిరే|</para>
  <para style="p">
    <verse number="11" style="v"/>అథ తే యీశుం పప్రచ్ఛుః ప్రథమత ఏలియేనాగన్తవ్యమ్ ఇతి వాక్యం కుత ఉపాధ్యాయా ఆహుః?</para>
  <para style="p">
    <verse number="12" style="v"/>తదా స ప్రత్యువాచ , ఏలియః ప్రథమమేత్య సర్వ్వకార్య్యాణి సాధయిష్యతి; నరపుత్రే చ లిపి ర్యథాస్తే తథైవ సోపి బహుదుఃఖం ప్రాప్యావజ్ఞాస్యతే|</para>
  <para style="p">
    <verse number="13" style="v"/>కిన్త్వహం యుష్మాన్ వదామి , ఏలియార్థే లిపి ర్యథాస్తే తథైవ స ఏత్య యయౌ, లోకా: స్వేచ్ఛానురూపం తమభివ్యవహరన్తి స్మ|</para>
  <para style="p">
    <verse number="14" style="v"/>అనన్తరం స శిష్యసమీపమేత్య తేషాం చతుఃపార్శ్వే తైః సహ బహుజనాన్ వివదమానాన్ అధ్యాపకాంశ్చ దృష్టవాన్;</para>
  <para style="p">
    <verse number="15" style="v"/>కిన్తు సర్వ్వలోకాస్తం దృష్ట్వైవ చమత్కృత్య తదాసన్నం ధావన్తస్తం ప్రణేముః|</para>
  <para style="p">
    <verse number="16" style="v"/>తదా యీశురధ్యాపకానప్రాక్షీద్ ఏతైః సహ యూయం కిం వివదధ్వే?</para>
  <para style="p">
    <verse number="17" style="v"/>తతో లోకానాం కశ్చిదేకః ప్రత్యవాదీత్ హే గురో మమ సూనుం మూకం భూతధృతఞ్చ భవదాసన్నమ్ ఆనయం|</para>
  <para style="p">
    <verse number="18" style="v"/>యదాసౌ భూతస్తమాక్రమతే తదైవ పాతసతి తథా స ఫేణాయతే, దన్తైర్దన్తాన్ ఘర్షతి క్షీణో భవతి చ; తతో హేతోస్తం భూతం త్యాజయితుం భవచ్ఛిష్యాన్ నివేదితవాన్ కిన్తు తే న శేకుః|</para>
  <para style="p">
    <verse number="19" style="v"/>తదా స తమవాదీత్, రే అవిశ్వాసినః సన్తానా యుష్మాభిః సహ కతి కాలానహం స్థాస్యామి? అపరాన్ కతి కాలాన్ వా వ ఆచారాన్ సహిష్యే? తం మదాసన్నమానయత|</para>
  <para style="p">
    <verse number="20" style="v"/>తతస్తత్సన్నిధిం స ఆనీయత కిన్తు తం దృష్ట్వైవ భూతో బాలకం ధృతవాన్; స చ భూమౌ పతిత్వా ఫేణాయమానో లులోఠ|</para>
  <para style="p">
    <verse number="21" style="v"/>తదా స తత్పితరం పప్రచ్ఛ, అస్యేదృశీ దశా కతి దినాని భూతా? తతః సోవాదీత్ బాల్యకాలాత్|</para>
  <para style="p">
    <verse number="22" style="v"/>భూతోయం తం నాశయితుం బహువారాన్ వహ్నౌ జలే చ న్యక్షిపత్ కిన్తు యది భవాన కిమపి కర్త్తాం శక్నోతి తర్హి దయాం కృత్వాస్మాన్ ఉపకరోతు|</para>
  <para style="p">
    <verse number="23" style="v"/>తదా యీశుస్తమవదత్ యది ప్రత్యేతుం శక్నోషి తర్హి ప్రత్యయినే జనాయ సర్వ్వం సాధ్యమ్|</para>
  <para style="p">
    <verse number="24" style="v"/>తతస్తత్క్షణం తద్బాలకస్య పితా ప్రోచ్చై రూవన్ సాశ్రునేత్రః ప్రోవాచ, ప్రభో ప్రత్యేమి మమాప్రత్యయం ప్రతికురు|</para>
  <para style="p">
    <verse number="25" style="v"/>అథ యీశు ర్లోకసఙ్ఘం ధావిత్వాయాన్తం దృష్ట్వా తమపూతభూతం తర్జయిత్వా జగాద, రే బధిర మూక భూత త్వమేతస్మాద్ బహిర్భవ పునః కదాపి మాశ్రయైనం త్వామహమ్ ఇత్యాదిశామి|</para>
  <para style="p">
    <verse number="26" style="v"/>తదా స భూతశ్చీత్శబ్దం కృత్వా తమాపీడ్య బహిర్జజామ, తతో బాలకో మృతకల్పో బభూవ తస్మాదయం మృతఇత్యనేకే కథయామాసుః|</para>
  <para style="p">
    <verse number="27" style="v"/>కిన్తు కరం ధృత్వా యీశునోత్థాపితః స ఉత్తస్థౌ|</para>
  <para style="p">
    <verse number="28" style="v"/>అథ యీశౌ గృహం ప్రవిష్టే శిష్యా గుప్తం తం పప్రచ్ఛుః, వయమేనం భూతం త్యాజయితుం కుతో న శక్తాః?</para>
  <para style="p">
    <verse number="29" style="v"/>స ఉవాచ, ప్రార్థనోపవాసౌ వినా కేనాప్యన్యేన కర్మ్మణా భూతమీదృశం త్యాజయితుం న శక్యం|</para>
  <para style="p">
    <verse number="30" style="v"/>అనన్తరం స తత్స్థానాదిత్వా గాలీల్మధ్యేన యయౌ, కిన్తు తత్ కోపి జానీయాదితి స నైచ్ఛత్|</para>
  <para style="p">
    <verse number="31" style="v"/>అపరఞ్చ స శిష్యానుపదిశన్ బభాషే, నరపుత్రో నరహస్తేషు సమర్పయిష్యతే తే చ తం హనిష్యన్తి తైస్తస్మిన్ హతే తృతీయదినే స ఉత్థాస్యతీతి|</para>
  <para style="p">
    <verse number="32" style="v"/>కిన్తు తత్కథాం తే నాబుధ్యన్త ప్రష్టుఞ్చ బిభ్యః|</para>
  <para style="p">
    <verse number="33" style="v"/>అథ యీశుః కఫర్నాహూమ్పురమాగత్య మధ్యేగృహఞ్చేత్య తానపృచ్ఛద్ వర్త్మమధ్యే యూయమన్యోన్యం కిం వివదధ్వే స్మ?</para>
  <para style="p">
    <verse number="34" style="v"/>కిన్తు తే నిరుత్తరాస్తస్థు ర్యస్మాత్తేషాం కో ముఖ్య ఇతి వర్త్మాని తేఽన్యోన్యం వ్యవదన్త|</para>
  <para style="p">
    <verse number="35" style="v"/>తతః స ఉపవిశ్య ద్వాదశశిష్యాన్ ఆహూయ బభాషే యః కశ్చిత్ ముఖ్యో భవితుమిచ్ఛతి స సర్వ్వేభ్యో గౌణః సర్వ్వేషాం సేవకశ్చ భవతు|</para>
  <para style="p">
    <verse number="36" style="v"/>తదా స బాలకమేకం గృహీత్వా మధ్యే సముపావేశయత్ తతస్తం క్రోడే కృత్వా తానవాదాత్</para>
  <para style="p">
    <verse number="37" style="v"/>యః కశ్చిదీదృశస్య కస్యాపి బాలస్యాతిథ్యం కరోతి స మమాతిథ్యం కరోతి; యః కశ్చిన్మమాతిథ్యం కరోతి స కేవలమ్ మమాతిథ్యం కరోతి తన్న మత్ప్రేరకస్యాప్యాతిథ్యం కరోతి|</para>
  <para style="p">
    <verse number="38" style="v"/>అథ యోహన్ తమబ్రవీత్ హే గురో, అస్మాకమననుగామినమ్ ఏకం త్వాన్నామ్నా భూతాన్ త్యాజయన్తం వయం దృష్టవన్తః, అస్మాకమపశ్చాద్గామిత్వాచ్చ తం న్యషేధామ|</para>
  <para style="p">
    <verse number="39" style="v"/>కిన్తు యీశురవదత్ తం మా నిషేధత్, యతో యః కశ్చిన్ మన్నామ్నా చిత్రం కర్మ్మ కరోతి స సహసా మాం నిన్దితుం న శక్నోతి|</para>
  <para style="p">
    <verse number="40" style="v"/>తథా యః కశ్చిద్ యుష్మాకం విపక్షతాం న కరోతి స యుష్మాకమేవ సపక్షః|</para>
  <para style="p">
    <verse number="41" style="v"/>యః కశ్చిద్ యుష్మాన్ ఖ్రీష్టశిష్యాన్ జ్ఞాత్వా మన్నామ్నా కంసైకేన పానీయం పాతుం దదాతి, యుష్మానహం యథార్థం వచ్మి, స ఫలేన వఞ్చితో న భవిష్యతి|</para>
  <para style="p">
    <verse number="42" style="v"/>కిన్తు యది కశ్చిన్ మయి విశ్వాసినామేషాం క్షుద్రప్రాణినామ్ ఏకస్యాపి విఘ్నం జనయతి, తర్హి తస్యైతత్కర్మ్మ కరణాత్ కణ్ఠబద్ధపేషణీకస్య తస్య సాగరాగాధజల మజ్జనం భద్రం|</para>
  <para style="p">
    <verse number="43" style="v"/>అతః స్వకరో యది త్వాం బాధతే తర్హి తం ఛిన్ధి;</para>
  <para style="p">
    <verse number="44" style="v"/>యస్మాత్ యత్ర కీటా న మ్రియన్తే వహ్నిశ్చ న నిర్వ్వాతి, తస్మిన్ అనిర్వ్వాణానలనరకే కరద్వయవస్తవ గమనాత్ కరహీనస్య స్వర్గప్రవేశస్తవ క్షేమం|</para>
  <para style="p">
    <verse number="45" style="v"/>యది తవ పాదో విఘ్నం జనయతి తర్హి తం ఛిన్ధి,</para>
  <para style="p">
    <verse number="46" style="v"/>యతో యత్ర కీటా న మ్రియన్తే వహ్నిశ్చ న నిర్వ్వాతి, తస్మిన్ ఽనిర్వ్వాణవహ్నౌ నరకే ద్విపాదవతస్తవ నిక్షేపాత్ పాదహీనస్య స్వర్గప్రవేశస్తవ క్షేమం|</para>
  <para style="p">
    <verse number="47" style="v"/>స్వనేత్రం యది త్వాం బాధతే తర్హి తదప్యుత్పాటయ, యతో యత్ర కీటా న మ్రియన్తే వహ్నిశ్చ న నిర్వ్వాతి,</para>
  <para style="p">
    <verse number="48" style="v"/>తస్మిన ఽనిర్వ్వాణవహ్నౌ నరకే ద్వినేత్రస్య తవ నిక్షేపాద్ ఏకనేత్రవత ఈశ్వరరాజ్యే ప్రవేశస్తవ క్షేమం|</para>
  <para style="p">
    <verse number="49" style="v"/>యథా సర్వ్వో బలి ర్లవణాక్తః క్రియతే తథా సర్వ్వో జనో వహ్నిరూపేణ లవణాక్తః కారిష్యతే|</para>
  <para style="p">
    <verse number="50" style="v"/>లవణం భద్రం కిన్తు యది లవణే స్వాదుతా న తిష్ఠతి, తర్హి కథమ్ ఆస్వాద్యుక్తం కరిష్యథ? యూయం లవణయుక్తా భవత పరస్పరం ప్రేమ కురుత|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అనన్తరం స తత్స్థానాత్ ప్రస్థాయ యర్ద్దననద్యాః పారే యిహూదాప్రదేశ ఉపస్థితవాన్, తత్ర తదన్తికే లోకానాం సమాగమే జాతే స నిజరీత్యనుసారేణ పునస్తాన్ ఉపదిదేశ|</para>
  <para style="p">
    <verse number="2" style="v"/>తదా ఫిరూశినస్తత్సమీపమ్ ఏత్య తం పరీక్షితుం పప్రచ్ఛః స్వజాయా మనుజానాం త్యజ్యా న వేతి?</para>
  <para style="p">
    <verse number="3" style="v"/>తతః స ప్రత్యవాదీత్, అత్ర కార్య్యే మూసా యుష్మాన్ ప్రతి కిమాజ్ఞాపయత్?</para>
  <para style="p">
    <verse number="4" style="v"/>త ఊచుః త్యాగపత్రం లేఖితుం స్వపత్నీం త్యక్తుఞ్చ మూసాఽనుమన్యతే|</para>
  <para style="p">
    <verse number="5" style="v"/>తదా యీశుః ప్రత్యువాచ, యుష్మాకం మనసాం కాఠిన్యాద్ధేతో ర్మూసా నిదేశమిమమ్ అలిఖత్|</para>
  <para style="p">
    <verse number="6" style="v"/>కిన్తు సృష్టేరాదౌ ఈశ్వరో నరాన్ పుంరూపేణ స్త్రీరూపేణ చ ససర్జ|</para>
  <para style="p">
    <verse number="7" style="v"/>"తతః కారణాత్ పుమాన్ పితరం మాతరఞ్చ త్యక్త్వా స్వజాయాయామ్ ఆసక్తో భవిష్యతి,</para>
  <para style="p">
    <verse number="8" style="v"/>తౌ ద్వావ్ ఏకాఙ్గౌ భవిష్యతః| " తస్మాత్ తత్కాలమారభ్య తౌ న ద్వావ్ ఏకాఙ్గౌ|</para>
  <para style="p">
    <verse number="9" style="v"/>అతః కారణాద్ ఈశ్వరో యదయోజయత్ కోపి నరస్తన్న వియేజయేత్|</para>
  <para style="p">
    <verse number="10" style="v"/>అథ యీశు ర్గృహం ప్రవిష్టస్తదా శిష్యాః పునస్తత్కథాం తం పప్రచ్ఛుః|</para>
  <para style="p">
    <verse number="11" style="v"/>తతః సోవదత్ కశ్చిద్ యది స్వభార్య్యాం త్యక్తవాన్యామ్ ఉద్వహతి తర్హి స స్వభార్య్యాయాః ప్రాతికూల్యేన వ్యభిచారీ భవతి|</para>
  <para style="p">
    <verse number="12" style="v"/>కాచిన్నారీ యది స్వపతిం హిత్వాన్యపుంసా వివాహితా భవతి తర్హి సాపి వ్యభిచారిణీ భవతి|</para>
  <para style="p">
    <verse number="13" style="v"/>అథ స యథా శిశూన్ స్పృశేత్, తదర్థం లోకైస్తదన్తికం శిశవ ఆనీయన్త, కిన్తు శిష్యాస్తానానీతవతస్తర్జయామాసుః|</para>
  <para style="p">
    <verse number="14" style="v"/>యీశుస్తద్ దృష్ట్వా క్రుధ్యన్ జగాద, మన్నికటమ్ ఆగన్తుం శిశూన్ మా వారయత, యత ఏతాదృశా ఈశ్వరరాజ్యాధికారిణః|</para>
  <para style="p">
    <verse number="15" style="v"/>యుష్మానహం యథార్థం వచ్మి, యః కశ్చిత్ శిశువద్ భూత్వా రాజ్యమీశ్వరస్య న గృహ్లీయాత్ స కదాపి తద్రాజ్యం ప్రవేష్టుం న శక్నోతి|</para>
  <para style="p">
    <verse number="16" style="v"/>అననతరం స శిశూనఙ్కే నిధాయ తేషాం గాత్రేషు హస్తౌ దత్త్వాశిషం బభాషే|</para>
  <para style="p">
    <verse number="17" style="v"/>అథ స వర్త్మనా యాతి, ఏతర్హి జన ఏకో ధావన్ ఆగత్య తత్సమ్ముఖే జానునీ పాతయిత్వా పృష్టవాన్, భోః పరమగురో, అనన్తాయుః ప్రాప్తయే మయా కిం కర్త్తవ్యం?</para>
  <para style="p">
    <verse number="18" style="v"/>తదా యీశురువాచ, మాం పరమం కుతో వదసి? వినేశ్వరం కోపి పరమో న భవతి|</para>
  <para style="p">
    <verse number="19" style="v"/>పరస్త్రీం నాభిగచ్ఛ; నరం మా ఘాతయ; స్తేయం మా కురు; మృషాసాక్ష్యం మా దేహి; హింసాఞ్చ మా కురు; పితరౌ సమ్మన్యస్వ; నిదేశా ఏతే త్వయా జ్ఞాతాః|</para>
  <para style="p">
    <verse number="20" style="v"/>తతస్తన ప్రత్యుక్తం, హే గురో బాల్యకాలాదహం సర్వ్వానేతాన్ ఆచరామి|</para>
  <para style="p">
    <verse number="21" style="v"/>తదా యీశుస్తం విలోక్య స్నేహేన బభాషే, తవైకస్యాభావ ఆస్తే; త్వం గత్వా సర్వ్వస్వం విక్రీయ దరిద్రేభ్యో విశ్రాణయ, తతః స్వర్గే ధనం ప్రాప్స్యసి; తతః పరమ్ ఏత్య క్రుశం వహన్ మదనువర్త్తీ భవ|</para>
  <para style="p">
    <verse number="22" style="v"/>కిన్తు తస్య బహుసమ్పద్విద్యమానత్వాత్ స ఇమాం కథామాకర్ణ్య విషణో దుఃఖితశ్చ సన్ జగామ|</para>
  <para style="p">
    <verse number="23" style="v"/>అథ యీశుశ్చతుర్దిశో నిరీక్ష్య శిష్యాన్ అవాదీత్, ధనిలోకానామ్ ఈశ్వరరాజ్యప్రవేశః కీదృగ్ దుష్కరః|</para>
  <para style="p">
    <verse number="24" style="v"/>తస్య కథాతః శిష్యాశ్చమచ్చక్రుః, కిన్తు స పునరవదత్, హే బాలకా యే ధనే విశ్వసన్తి తేషామ్ ఈశ్వరరాజ్యప్రవేశః కీదృగ్ దుష్కరః|</para>
  <para style="p">
    <verse number="25" style="v"/>ఈశ్వరరాజ్యే ధనినాం ప్రవేశాత్ సూచిరన్ధ్రేణ మహాఙ్గస్య గమనాగమనం సుకరం|</para>
  <para style="p">
    <verse number="26" style="v"/>తదా శిష్యా అతీవ విస్మితాః పరస్పరం ప్రోచుః, తర్హి కః పరిత్రాణం ప్రాప్తుం శక్నోతి?</para>
  <para style="p">
    <verse number="27" style="v"/>తతో యీశుస్తాన్ విలోక్య బభాషే, తన్ నరస్యాసాధ్యం కిన్తు నేశ్వరస్య, యతో హేతోరీశ్వరస్య సర్వ్వం సాధ్యమ్|</para>
  <para style="p">
    <verse number="28" style="v"/>తదా పితర ఉవాచ, పశ్య వయం సర్వ్వం పరిత్యజ్య భవతోనుగామినో జాతాః|</para>
  <para style="p">
    <verse number="29" style="v"/>తతో యీశుః ప్రత్యవదత్, యుష్మానహం యథార్థం వదామి, మదర్థం సుసంవాదార్థం వా యో జనః సదనం భ్రాతరం భగినీం పితరం మాతరం జాయాం సన్తానాన్ భూమి వా త్యక్త్వా</para>
  <para style="p">
    <verse number="30" style="v"/>గృహభ్రాతృభగినీపితృమాతృపత్నీసన్తానభూమీనామిహ శతగుణాన్ ప్రేత్యానన్తాయుశ్చ న ప్రాప్నోతి తాదృశః కోపి నాస్తి|</para>
  <para style="p">
    <verse number="31" style="v"/>కిన్త్వగ్రీయా అనేకే లోకాః శేషాః, శేషీయా అనేకే లోకాశ్చాగ్రా భవిష్యన్తి|</para>
  <para style="p">
    <verse number="32" style="v"/>అథ యిరూశాలమ్యానకాలే యీశుస్తేషామ్ అగ్రగామీ బభూవ, తస్మాత్తే చిత్రం జ్ఞాత్వా పశ్చాద్గామినో భూత్వా బిభ్యుః| తదా స పున ర్ద్వాదశశిష్యాన్ గృహీత్వా స్వీయం యద్యద్ ఘటిష్యతే తత్తత్ తేభ్యః కథయితుం ప్రారేభే;</para>
  <para style="p">
    <verse number="33" style="v"/>పశ్యత వయం యిరూశాలమ్పురం యామః, తత్ర మనుష్యపుత్రః ప్రధానయాజకానామ్ ఉపాధ్యాయానాఞ్చ కరేషు సమర్పయిష్యతే; తే చ వధదణ్డాజ్ఞాం దాపయిత్వా పరదేశీయానాం కరేషు తం సమర్పయిష్యన్తి|</para>
  <para style="p">
    <verse number="34" style="v"/>తే తముపహస్య కశయా ప్రహృత్య తద్వపుషి నిష్ఠీవం నిక్షిప్య తం హనిష్యన్తి, తతః స తృతీయదినే ప్రోత్థాస్యతి|</para>
  <para style="p">
    <verse number="35" style="v"/>తతః సివదేః పుత్రౌ యాకూబ్యోహనౌ తదన్తికమ్ ఏత్య ప్రోచతుః, హే గురో యద్ ఆవాభ్యాం యాచిష్యతే తదస్మదర్థం భవాన్ కరోతు నివేదనమిదమావయోః|</para>
  <para style="p">
    <verse number="36" style="v"/>తతః స కథితవాన్, యువాం కిమిచ్ఛథః? కిం మయా యుష్మదర్థం కరణీయం?</para>
  <para style="p">
    <verse number="37" style="v"/>తదా తౌ ప్రోచతుః, ఆవయోరేకం దక్షిణపార్శ్వే వామపార్శ్వే చైకం తవైశ్వర్య్యపదే సముపవేష్టుమ్ ఆజ్ఞాపయ|</para>
  <para style="p">
    <verse number="38" style="v"/>కిన్తు యీశుః ప్రత్యువాచ యువామజ్ఞాత్వేదం ప్రార్థయేథే, యేన కంసేనాహం పాస్యామి తేన యువాభ్యాం కిం పాతుం శక్ష్యతే? యస్మిన్ మజ్జనేనాహం మజ్జిష్యే తన్మజ్జనే మజ్జయితుం కిం యువాభ్యాం శక్ష్యతే? తౌ ప్రత్యూచతుః శక్ష్యతే|</para>
  <para style="p">
    <verse number="39" style="v"/>తదా యీశురవదత్ యేన కంసేనాహం పాస్యామి తేనావశ్యం యువామపి పాస్యథః, యేన మజ్జనేన చాహం మజ్జియ్యే తత్ర యువామపి మజ్జిష్యేథే|</para>
  <para style="p">
    <verse number="40" style="v"/>కిన్తు యేషామర్థమ్ ఇదం నిరూపితం, తాన్ విహాయాన్యం కమపి మమ దక్షిణపార్శ్వే వామపార్శ్వే వా సముపవేశయితుం మమాధికారో నాస్తి|</para>
  <para style="p">
    <verse number="41" style="v"/>అథాన్యదశశిష్యా ఇమాం కథాం శ్రుత్వా యాకూబ్యోహన్భ్యాం చుకుపుః|</para>
  <para style="p">
    <verse number="42" style="v"/>కిన్తు యీశుస్తాన్ సమాహూయ బభాషే, అన్యదేశీయానాం రాజత్వం యే కుర్వ్వన్తి తే తేషామేవ ప్రభుత్వం కుర్వ్వన్తి, తథా యే మహాలోకాస్తే తేషామ్ అధిపతిత్వం కుర్వ్వన్తీతి యూయం జానీథ|</para>
  <para style="p">
    <verse number="43" style="v"/>కిన్తు యుష్మాకం మధ్యే న తథా భవిష్యతి, యుష్మాకం మధ్యే యః ప్రాధాన్యం వాఞ్ఛతి స యుష్మాకం సేవకో భవిష్యతి,</para>
  <para style="p">
    <verse number="44" style="v"/>యుష్మాకం యో మహాన్ భవితుమిచ్ఛతి స సర్వ్వేషాం కిఙ్కరో భవిష్యతి|</para>
  <para style="p">
    <verse number="45" style="v"/>యతో మనుష్యపుత్రః సేవ్యో భవితుం నాగతః సేవాం కర్త్తాం తథానేకేషాం పరిత్రాణస్య మూల్యరూపస్వప్రాణం దాతుఞ్చాగతః|</para>
  <para style="p">
    <verse number="46" style="v"/>అథ తే యిరీహోనగరం ప్రాప్తాస్తస్మాత్ శిష్యై ర్లోకైశ్చ సహ యీశో ర్గమనకాలే టీమయస్య పుత్రో బర్టీమయనామా అన్ధస్తన్మార్గపార్శ్వే భిక్షార్థమ్ ఉపవిష్టః|</para>
  <para style="p">
    <verse number="47" style="v"/>స నాసరతీయస్య యీశోరాగమనవార్త్తాం ప్రాప్య ప్రోచై ర్వక్తుమారేభే, హే యీశో దాయూదః సన్తాన మాం దయస్వ|</para>
  <para style="p">
    <verse number="48" style="v"/>తతోనేకే లోకా మౌనీభవేతి తం తర్జయామాసుః, కిన్తు స పునరధికముచ్చై ర్జగాద, హే యీశో దాయూదః సన్తాన మాం దయస్వ|</para>
  <para style="p">
    <verse number="49" style="v"/>తదా యీశుః స్థిత్వా తమాహ్వాతుం సమాదిదేశ, తతో లోకాస్తమన్ధమాహూయ బభాషిరే, హే నర, స్థిరో భవ, ఉత్తిష్ఠ, స త్వామాహ్వయతి|</para>
  <para style="p">
    <verse number="50" style="v"/>తదా స ఉత్తరీయవస్త్రం నిక్షిప్య ప్రోత్థాయ యీశోః సమీపం గతః|</para>
  <para style="p">
    <verse number="51" style="v"/>తతో యీశుస్తమవదత్ త్వయా కిం ప్రార్థ్యతే? తుభ్యమహం కిం కరిష్యామీ? తదా సోన్ధస్తమువాచ, హే గురో మదీయా దృష్టిర్భవేత్|</para>
  <para style="p">
    <verse number="52" style="v"/>తతో యీశుస్తమువాచ యాహి తవ విశ్వాసస్త్వాం స్వస్థమకార్షీత్, తస్మాత్ తత్క్షణం స దృష్టిం ప్రాప్య పథా యీశోః పశ్చాద్ యయౌ|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అనన్తరం తేషు యిరూశాలమః సమీపస్థయో ర్బైత్ఫగీబైథనీయపురయోరన్తికస్థం జైతుననామాద్రిమాగతేషు యీశుః ప్రేషణకాలే ద్వౌ శిష్యావిదం వాక్యం జగాద,</para>
  <para style="p">
    <verse number="2" style="v"/>యువామముం సమ్ముఖస్థం గ్రామం యాతం, తత్ర ప్రవిశ్య యో నరం నావహత్ తం గర్ద్దభశావకం ద్రక్ష్యథస్తం మోచయిత్వానయతం|</para>
  <para style="p">
    <verse number="3" style="v"/>కిన్తు యువాం కర్మ్మేదం కుతః కురుథః? కథామిమాం యది కోపి పృచ్ఛతి తర్హి ప్రభోరత్ర ప్రయోజనమస్తీతి కథితే స శీఘ్రం తమత్ర ప్రేషయిష్యతి|</para>
  <para style="p">
    <verse number="4" style="v"/>తతస్తౌ గత్వా ద్విమార్గమేలనే కస్యచిద్ ద్వారస్య పార్శ్వే తం గర్ద్దభశావకం ప్రాప్య మోచయతః,</para>
  <para style="p">
    <verse number="5" style="v"/>ఏతర్హి తత్రోపస్థితలోకానాం కశ్చిద్ అపృచ్ఛత్, గర్ద్దభశిశుం కుతో మోచయథః?</para>
  <para style="p">
    <verse number="6" style="v"/>తదా యీశోరాజ్ఞానుసారేణ తేభ్యః ప్రత్యుదితే తత్క్షణం తమాదాతుం తేఽనుజజ్ఞుః|</para>
  <para style="p">
    <verse number="7" style="v"/>అథ తౌ యీశోః సన్నిధిం గర్ద్దభశిశుమ్ ఆనీయ తదుపరి స్వవస్త్రాణి పాతయామాసతుః; తతః స తదుపరి సముపవిష్టః|</para>
  <para style="p">
    <verse number="8" style="v"/>తదానేకే పథి స్వవాసాంసి పాతయామాసుః, పరైశ్చ తరుశాఖాశ్ఛితవా మార్గే వికీర్ణాః|</para>
  <para style="p">
    <verse number="9" style="v"/>అపరఞ్చ పశ్చాద్గామినోఽగ్రగామినశ్చ సర్వ్వే జనా ఉచైఃస్వరేణ వక్తుమారేభిరే, జయ జయ యః పరమేశ్వరస్య నామ్నాగచ్ఛతి స ధన్య ఇతి|</para>
  <para style="p">
    <verse number="10" style="v"/>తథాస్మాకమం పూర్వ్వపురుషస్య దాయూదో యద్రాజ్యం పరమేశ్వరనామ్నాయాతి తదపి ధన్యం, సర్వ్వస్మాదుచ్ఛ్రాయే స్వర్గే ఈశ్వరస్య జయో భవేత్|</para>
  <para style="p">
    <verse number="11" style="v"/>ఇత్థం యీశు ర్యిరూశాలమి మన్దిరం ప్రవిశ్య చతుర్దిక్స్థాని సర్వ్వాణి వస్తూని దృష్టవాన్; అథ సాయంకాల ఉపస్థితే ద్వాదశశిష్యసహితో బైథనియం జగామ|</para>
  <para style="p">
    <verse number="12" style="v"/>అపరేహని బైథనియాద్ ఆగమనసమయే క్షుధార్త్తో బభూవ|</para>
  <para style="p">
    <verse number="13" style="v"/>తతో దూరే సపత్రముడుమ్బరపాదపం విలోక్య తత్ర కిఞ్చిత్ ఫలం ప్రాప్తుం తస్య సన్నికృష్టం యయౌ, తదానీం ఫలపాతనస్య సమయో నాగచ్ఛతి| తతస్తత్రోపస్థితః పత్రాణి వినా కిమప్యపరం న ప్రాప్య స కథితవాన్,</para>
  <para style="p">
    <verse number="14" style="v"/>అద్యారభ్య కోపి మానవస్త్వత్తః ఫలం న భుఞ్జీత; ఇమాం కథాం తస్య శిష్యాః శుశ్రువుః|</para>
  <para style="p">
    <verse number="15" style="v"/>తదనన్తరం తేషు యిరూశాలమమాయాతేషు యీశు ర్మన్దిరం గత్వా తత్రస్థానాం బణిజాం ముద్రాసనాని పారావతవిక్రేతృణామ్ ఆసనాని చ న్యుబ్జయాఞ్చకార సర్వ్వాన్ క్రేతృన్ విక్రేతృంశ్చ బహిశ్చకార|</para>
  <para style="p">
    <verse number="16" style="v"/>అపరం మన్దిరమధ్యేన కిమపి పాత్రం వోఢుం సర్వ్వజనం నివారయామాస|</para>
  <para style="p">
    <verse number="17" style="v"/>లోకానుపదిశన్ జగాద, మమ గృహం సర్వ్వజాతీయానాం ప్రార్థనాగృహమ్ ఇతి నామ్నా ప్రథితం భవిష్యతి ఏతత్ కిం శాస్త్రే లిఖితం నాస్తి? కిన్తు యూయం తదేవ చోరాణాం గహ్వరం కురుథ|</para>
  <para style="p">
    <verse number="18" style="v"/>ఇమాం వాణీం శ్రుత్వాధ్యాపకాః ప్రధానయాజకాశ్చ తం యథా నాశయితుం శక్నువన్తి తథోेపాయం మృగయామాసుః, కిన్తు తస్యోపదేశాత్ సర్వ్వే లోకా విస్మయం గతా అతస్తే తస్మాద్ బిభ్యుః|</para>
  <para style="p">
    <verse number="19" style="v"/>అథ సాయంసమయ ఉపస్థితే యీశుర్నగరాద్ బహిర్వవ్రాజ|</para>
  <para style="p">
    <verse number="20" style="v"/>అనన్తరం ప్రాతఃకాలే తే తేన మార్గేణ గచ్ఛన్తస్తముడుమ్బరమహీరుహం సమూలం శుష్కం దదృశుః|</para>
  <para style="p">
    <verse number="21" style="v"/>తతః పితరః పూర్వ్వవాక్యం స్మరన్ యీశుం బభాషం, హే గురో పశ్యతు య ఉడుమ్బరవిటపీ భవతా శప్తః స శుష్కో బభూవ|</para>
  <para style="p">
    <verse number="22" style="v"/>తతో యీశుః ప్రత్యవాదీత్, యూయమీశ్వరే విశ్వసిత|</para>
  <para style="p">
    <verse number="23" style="v"/>యుష్మానహం యథార్థం వదామి కోపి యద్యేతద్గిరిం వదతి, త్వముత్థాయ గత్వా జలధౌ పత, ప్రోక్తమిదం వాక్యమవశ్యం ఘటిష్యతే, మనసా కిమపి న సన్దిహ్య చేదిదం విశ్వసేత్ తర్హి తస్య వాక్యానుసారేణ తద్ ఘటిష్యతే|</para>
  <para style="p">
    <verse number="24" style="v"/>అతో హేతోరహం యుష్మాన్ వచ్మి, ప్రార్థనాకాలే యద్యదాకాంక్షిష్యధ్వే తత్తదవశ్యం ప్రాప్స్యథ, ఇత్థం విశ్వసిత, తతః ప్రాప్స్యథ|</para>
  <para style="p">
    <verse number="25" style="v"/>అపరఞ్చ యుష్మాసు ప్రార్థయితుం సముత్థితేషు యది కోపి యుష్మాకమ్ అపరాధీ తిష్ఠతి, తర్హి తం క్షమధ్వం, తథా కృతే యుష్మాకం స్వర్గస్థః పితాపి యుష్మాకమాగాంమి క్షమిష్యతే|</para>
  <para style="p">
    <verse number="26" style="v"/>కిన్తు యది న క్షమధ్వే తర్హి వః స్వర్గస్థః పితాపి యుష్మాకమాగాంసి న క్షమిష్యతే|</para>
  <para style="p">
    <verse number="27" style="v"/>అనన్తరం తే పున ర్యిరూశాలమం ప్రవివిశుః, యీశు ర్యదా మధ్యేమన్దిరమ్ ఇతస్తతో గచ్ఛతి, తదానీం ప్రధానయాజకా ఉపాధ్యాయాః ప్రాఞ్చశ్చ తదన్తికమేత్య కథామిమాం పప్రచ్ఛుః,</para>
  <para style="p">
    <verse number="28" style="v"/>త్వం కేనాదేశేన కర్మ్మాణ్యేతాని కరోషి? తథైతాని కర్మ్మాణి కర్త్తాం కేనాదిష్టోసి?</para>
  <para style="p">
    <verse number="29" style="v"/>తతో యీశుః ప్రతిగదితవాన్ అహమపి యుష్మాన్ ఏకకథాం పృచ్ఛామి, యది యూయం తస్యా ఉత్తరం కురుథ, తర్హి కయాజ్ఞయాహం కర్మ్మాణ్యేతాని కరోమి తద్ యుష్మభ్యం కథయిష్యామి|</para>
  <para style="p">
    <verse number="30" style="v"/>యోహనో మజ్జనమ్ ఈశ్వరాత్ జాతం కిం మానవాత్? తన్మహ్యం కథయత|</para>
  <para style="p">
    <verse number="31" style="v"/>తే పరస్పరం వివేక్తుం ప్రారేభిరే, తద్ ఈశ్వరాద్ బభూవేతి చేద్ వదామస్తర్హి కుతస్తం న ప్రత్యైత? కథమేతాం కథయిష్యతి|</para>
  <para style="p">
    <verse number="32" style="v"/>మానవాద్ అభవదితి చేద్ వదామస్తర్హి లోకేభ్యో భయమస్తి యతో హేతోః సర్వ్వే యోహనం సత్యం భవిష్యద్వాదినం మన్యన్తే|</para>
  <para style="p">
    <verse number="33" style="v"/>అతఏవ తే యీశుం ప్రత్యవాదిషు ర్వయం తద్ వక్తుం న శక్నుమః| యీశురువాచ, తర్హి యేనాదేశేన కర్మ్మాణ్యేతాని కరోమి, అహమపి యుష్మభ్యం తన్న కథయిష్యామి|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అనన్తరం యీశు ర్దృష్టాన్తేన తేభ్యః కథయితుమారేభే, కశ్చిదేకో ద్రాక్షాక్షేత్రం విధాయ తచ్చతుర్దిక్షు వారణీం కృత్వా తన్మధ్యే ద్రాక్షాపేషణకుణ్డమ్ అఖనత్, తథా తస్య గడమపి నిర్మ్మితవాన్ తతస్తత్క్షేత్రం కృషీవలేషు సమర్ప్య దూరదేశం జగామ|</para>
  <para style="p">
    <verse number="2" style="v"/>తదనన్తరం ఫలకాలే కృషీవలేభ్యో ద్రాక్షాక్షేత్రఫలాని ప్రాప్తుం తేషాం సవిధే భృత్యమ్ ఏకం ప్రాహిణోత్|</para>
  <para style="p">
    <verse number="3" style="v"/>కిన్తు కృషీవలాస్తం ధృత్వా ప్రహృత్య రిక్తహస్తం విససృజుః|</para>
  <para style="p">
    <verse number="4" style="v"/>తతః స పునరన్యమేకం భృత్యం ప్రషయామాస, కిన్తు తే కృషీవలాః పాషాణాఘాతైస్తస్య శిరో భఙ్క్త్వా సాపమానం తం వ్యసర్జన్|</para>
  <para style="p">
    <verse number="5" style="v"/>తతః పరం సోపరం దాసం ప్రాహిణోత్ తదా తే తం జఘ్నుః, ఏవమ్ అనేకేషాం కస్యచిత్ ప్రహారః కస్యచిద్ వధశ్చ తైః కృతః|</para>
  <para style="p">
    <verse number="6" style="v"/>తతః పరం మయా స్వపుత్రే ప్రహితే తే తమవశ్యం సమ్మంస్యన్తే, ఇత్యుక్త్వావశేషే తేషాం సన్నిధౌ నిజప్రియమ్ అద్వితీయం పుత్రం ప్రేషయామాస|</para>
  <para style="p">
    <verse number="7" style="v"/>కిన్తు కృషీవలాః పరస్పరం జగదుః, ఏష ఉత్తరాధికారీ, ఆగచ్ఛత వయమేనం హన్మస్తథా కృతే ఽధికారోయమ్ అస్మాకం భవిష్యతి|</para>
  <para style="p">
    <verse number="8" style="v"/>తతస్తం ధృత్వా హత్వా ద్రాక్షాక్షేత్రాద్ బహిః ప్రాక్షిపన్|</para>
  <para style="p">
    <verse number="9" style="v"/>అనేనాసౌ ద్రాక్షాక్షేత్రపతిః కిం కరిష్యతి? స ఏత్య తాన్ కృషీవలాన్ సంహత్య తత్క్షేత్రమ్ అన్యేషు కృషీవలేషు సమర్పయిష్యతి|</para>
  <para style="p">
    <verse number="10" style="v"/>అపరఞ్చ, "స్థపతయః కరిష్యన్తి గ్రావాణం యన్తు తుచ్ఛకం| ప్రాధానప్రస్తరః కోణే స ఏవ సంభవిష్యతి|</para>
  <para style="p">
    <verse number="11" style="v"/>ఏతత్ కర్మ్మ పరేశస్యాంద్భుతం నో దృష్టితో భవేత్|| " ఇమాం శాస్త్రీయాం లిపిం యూయం కిం నాపాఠిష్ట?</para>
  <para style="p">
    <verse number="12" style="v"/>తదానీం స తానుద్దిశ్య తాం దృష్టాన్తకథాం కథితవాన్, త ఇత్థం బుద్వ్వా తం ధర్త్తాముద్యతాః, కిన్తు లోకేభ్యో బిభ్యుః, తదనన్తరం తే తం విహాయ వవ్రజుః|</para>
  <para style="p">
    <verse number="13" style="v"/>అపరఞ్చ తే తస్య వాక్యదోషం ధర్త్తాం కతిపయాన్ ఫిరూశినో హేరోదీయాంశ్చ లోకాన్ తదన్తికం ప్రేషయామాసుః|</para>
  <para style="p">
    <verse number="14" style="v"/>త ఆగత్య తమవదన్, హే గురో భవాన్ తథ్యభాషీ కస్యాప్యనురోధం న మన్యతే, పక్షపాతఞ్చ న కరోతి, యథార్థత ఈశ్వరీయం మార్గం దర్శయతి వయమేతత్ ప్రజానీమః, కైసరాయ కరో దేయో న వాం? వయం దాస్యామో న వా?</para>
  <para style="p">
    <verse number="15" style="v"/>కిన్తు స తేషాం కపటం జ్ఞాత్వా జగాద, కుతో మాం పరీక్షధ్వే? ఏకం ముద్రాపాదం సమానీయ మాం దర్శయత|</para>
  <para style="p">
    <verse number="16" style="v"/>తదా తైరేకస్మిన్ ముద్రాపాదే సమానీతే స తాన్ పప్రచ్ఛ, అత్ర లిఖితం నామ మూర్త్తి ర్వా కస్య? తే ప్రత్యూచుః, కైసరస్య|</para>
  <para style="p">
    <verse number="17" style="v"/>తదా యీశురవదత్ తర్హి కైసరస్య ద్రవ్యాణి కైసరాయ దత్త, ఈశ్వరస్య ద్రవ్యాణి తు ఈశ్వరాయ దత్త; తతస్తే విస్మయం మేనిరే|</para>
  <para style="p">
    <verse number="18" style="v"/>అథ మృతానాముత్థానం యే న మన్యన్తే తే సిదూకినో యీశోః సమీపమాగత్య తం పప్రచ్ఛుః;</para>
  <para style="p">
    <verse number="19" style="v"/>హే గురో కశ్చిజ్జనో యది నిఃసన్తతిః సన్ భార్య్యాయాం సత్యాం మ్రియతే తర్హి తస్య భ్రాతా తస్య భార్య్యాం గృహీత్వా భ్రాతు ర్వంశోత్పత్తిం కరిష్యతి, వ్యవస్థామిమాం మూసా అస్మాన్ ప్రతి వ్యలిఖత్|</para>
  <para style="p">
    <verse number="20" style="v"/>కిన్తు కేచిత్ సప్త భ్రాతర ఆసన్, తతస్తేషాం జ్యేష్ఠభ్రాతా వివహ్య నిఃసన్తతిః సన్ అమ్రియత|</para>
  <para style="p">
    <verse number="21" style="v"/>తతో ద్వితీయో భ్రాతా తాం స్త్రియమగృహణత్ కిన్తు సోపి నిఃసన్తతిః సన్ అమ్రియత; అథ తృతీయోపి భ్రాతా తాదృశోభవత్|</para>
  <para style="p">
    <verse number="22" style="v"/>ఇత్థం సప్తైవ భ్రాతరస్తాం స్త్రియం గృహీత్వా నిఃసన్తానాః సన్తోఽమ్రియన్త, సర్వ్వశేషే సాపి స్త్రీ మ్రియతే స్మ|</para>
  <para style="p">
    <verse number="23" style="v"/>అథ మృతానాముత్థానకాలే యదా త ఉత్థాస్యన్తి తదా తేషాం కస్య భార్య్యా సా భవిష్యతి? యతస్తే సప్తైవ తాం వ్యవహన్|</para>
  <para style="p">
    <verse number="24" style="v"/>తతో యీశుః ప్రత్యువాచ శాస్త్రమ్ ఈశ్వరశక్తిఞ్చ యూయమజ్ఞాత్వా కిమభ్రామ్యత న?</para>
  <para style="p">
    <verse number="25" style="v"/>మృతలోకానాముత్థానం సతి తే న వివహన్తి వాగ్దత్తా అపి న భవన్తి, కిన్తు స్వర్గీయదూతానాం సదృశా భవన్తి|</para>
  <para style="p">
    <verse number="26" style="v"/>పునశ్చ "అహమ్ ఇబ్రాహీమ ఈశ్వర ఇస్హాక ఈశ్వరో యాకూబశ్చేశ్వరః" యామిమాం కథాం స్తమ్బమధ్యే తిష్ఠన్ ఈశ్వరో మూసామవాదీత్ మృతానాముత్థానార్థే సా కథా మూసాలిఖితే పుస్తకే కిం యుష్మాభి ర్నాపాఠి?</para>
  <para style="p">
    <verse number="27" style="v"/>ఈశ్వరో జీవతాం ప్రభుః కిన్తు మృతానాం ప్రభు ర్న భవతి, తస్మాద్ధేతో ర్యూయం మహాభ్రమేణ తిష్ఠథ|</para>
  <para style="p">
    <verse number="28" style="v"/>ఏతర్హి ఏకోధ్యాపక ఏత్య తేషామిత్థం విచారం శుశ్రావ; యీశుస్తేషాం వాక్యస్య సదుత్తరం దత్తవాన్ ఇతి బుద్వ్వా తం పృష్టవాన్ సర్వ్వాసామ్ ఆజ్ఞానాం కా శ్రేష్ఠా? తతో యీశుః ప్రత్యువాచ,</para>
  <para style="p">
    <verse number="29" style="v"/>"హే ఇస్రాయేల్లోకా అవధత్త, అస్మాకం ప్రభుః పరమేశ్వర ఏక ఏవ,</para>
  <para style="p">
    <verse number="30" style="v"/>యూయం సర్వ్వన్తఃకరణైః సర్వ్వప్రాణైః సర్వ్వచిత్తైః సర్వ్వశక్తిభిశ్చ తస్మిన్ ప్రభౌ పరమేశ్వరే ప్రీయధ్వం," ఇత్యాజ్ఞా శ్రేష్ఠా|</para>
  <para style="p">
    <verse number="31" style="v"/>తథా "స్వప్రతివాసిని స్వవత్ ప్రేమ కురుధ్వం," ఏషా యా ద్వితీయాజ్ఞా సా తాదృశీ; ఏతాభ్యాం ద్వాభ్యామ్ ఆజ్ఞాభ్యామ్ అన్యా కాప్యాజ్ఞా శ్రేష్ఠా నాస్తి|</para>
  <para style="p">
    <verse number="32" style="v"/>తదా సోధ్యాపకస్తమవదత్, హే గురో సత్యం భవాన్ యథార్థం ప్రోక్తవాన్ యత ఏకస్మాద్ ఈశ్వరాద్ అన్యో ద్వితీయ ఈశ్వరో నాస్తి;</para>
  <para style="p">
    <verse number="33" style="v"/>అపరం సర్వ్వాన్తఃకరణైః సర్వ్వప్రాణైః సర్వ్వచిత్తైః సర్వ్వశక్తిభిశ్చ ఈశ్వరే ప్రేమకరణం తథా స్వమీపవాసిని స్వవత్ ప్రేమకరణఞ్చ సర్వ్వేభ్యో హోమబలిదానాదిభ్యః శ్రష్ఠం భవతి|</para>
  <para style="p">
    <verse number="34" style="v"/>తతో యీశుః సుబుద్ధేరివ తస్యేదమ్ ఉత్తరం శ్రుత్వా తం భాషితవాన్ త్వమీశ్వరస్య రాజ్యాన్న దూరోసి| ఇతః పరం తేన సహ కస్యాపి వాక్యస్య విచారం కర్త్తాం కస్యాపి ప్రగల్భతా న జాతా|</para>
  <para style="p">
    <verse number="35" style="v"/>అనన్తరం మధ్యేమన్దిరమ్ ఉపదిశన్ యీశురిమం ప్రశ్నం చకార, అధ్యాపకా అభిషిక్తం (తారకం) కుతో దాయూదః సన్తానం వదన్తి?</para>
  <para style="p">
    <verse number="36" style="v"/>స్వయం దాయూద్ పవిత్రస్యాత్మన ఆవేశేనేదం కథయామాస| యథా| "మమ ప్రభుమిదం వాక్యవదత్ పరమేశ్వరః| తవ శత్రూనహం యావత్ పాదపీఠం కరోమి న| తావత్ కాలం మదీయే త్వం దక్షపార్శ్వ్ ఉపావిశ| "</para>
  <para style="p">
    <verse number="37" style="v"/>యది దాయూద్ తం ప్రభూం వదతి తర్హి కథం స తస్య సన్తానో భవితుమర్హతి? ఇతరే లోకాస్తత్కథాం శ్రుత్వాననన్దుః|</para>
  <para style="p">
    <verse number="38" style="v"/>తదానీం స తానుపదిశ్య కథితవాన్ యే నరా దీర్ఘపరిధేయాని హట్టే విపనౌ చ</para>
  <para style="p">
    <verse number="39" style="v"/>లోకకృతనమస్కారాన్ భజనగృహే ప్రధానాసనాని భోజనకాలే ప్రధానస్థానాని చ కాఙ్క్షన్తే;</para>
  <para style="p">
    <verse number="40" style="v"/>విధవానాం సర్వ్వస్వం గ్రసిత్వా ఛలాద్ దీర్ఘకాలం ప్రార్థయన్తే తేభ్య ఉపాధ్యాయేభ్యః సావధానా భవత; తేఽధికతరాన్ దణ్డాన్ ప్రాప్స్యన్తి|</para>
  <para style="p">
    <verse number="41" style="v"/>తదనన్తరం లోకా భాణ్డాగారే ముద్రా యథా నిక్షిపన్తి భాణ్డాగారస్య సమ్ముఖే సముపవిశ్య యీశుస్తదవలులోక; తదానీం బహవో ధనినస్తస్య మధ్యే బహూని ధనాని నిరక్షిపన్|</para>
  <para style="p">
    <verse number="42" style="v"/>పశ్చాద్ ఏకా దరిద్రా విధవా సమాగత్య ద్విపణమూల్యాం ముద్రైకాం తత్ర నిరక్షిపత్|</para>
  <para style="p">
    <verse number="43" style="v"/>తదా యీశుః శిష్యాన్ ఆహూయ కథితవాన్ యుష్మానహం యథార్థం వదామి యే యే భాణ్డాగారేఽస్మిన ధనాని నిఃక్షిపన్తి స్మ తేభ్యః సర్వ్వేభ్య ఇయం విధవా దరిద్రాధికమ్ నిఃక్షిపతి స్మ|</para>
  <para style="p">
    <verse number="44" style="v"/>యతస్తే ప్రభూతధనస్య కిఞ్చిత్ నిరక్షిపన్ కిన్తు దీనేయం స్వదినయాపనయోగ్యం కిఞ్చిదపి న స్థాపయిత్వా సర్వ్వస్వం నిరక్షిపత్|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అనన్తరం మన్దిరాద్ బహిర్గమనకాలే తస్య శిష్యాణామేకస్తం వ్యాహృతవాన్ హే గురో పశ్యతు కీదృశాః పాషాణాః కీదృక్ చ నిచయనం|</para>
  <para style="p">
    <verse number="2" style="v"/>తదా యీశుస్తమ్ అవదత్ త్వం కిమేతద్ బృహన్నిచయనం పశ్యసి? అస్యైకపాషాణోపి ద్వితీయపాషాణోపరి న స్థాస్యతి సర్వ్వే ఽధఃక్షేప్స్యన్తే|</para>
  <para style="p">
    <verse number="3" style="v"/>అథ యస్మిన్ కాలే జైతున్గిరౌ మన్దిరస్య సమ్ముఖే స సముపవిష్టస్తస్మిన్ కాలే పితరో యాకూబ్ యోహన్ ఆన్ద్రియశ్చైతే తం రహసి పప్రచ్ఛుః,</para>
  <para style="p">
    <verse number="4" style="v"/>ఏతా ఘటనాః కదా భవిష్యన్తి? తథైతత్సర్వ్వాసాం సిద్ధ్యుపక్రమస్య వా కిం చిహ్నం? తదస్మభ్యం కథయతు భవాన్|</para>
  <para style="p">
    <verse number="5" style="v"/>తతో యాశుస్తాన్ వక్తుమారేభే, కోపి యథా యుష్మాన్ న భ్రామయతి తథాత్ర యూయం సావధానా భవత|</para>
  <para style="p">
    <verse number="6" style="v"/>యతః ఖ్రీష్టోహమితి కథయిత్వా మమ నామ్నానేకే సమాగత్య లోకానాం భ్రమం జనయిష్యన్తి;</para>
  <para style="p">
    <verse number="7" style="v"/>కిన్తు యూయం రణస్య వార్త్తాం రణాడమ్బరఞ్చ శ్రుత్వా మా వ్యాకులా భవత, ఘటనా ఏతా అవశ్యమ్మావిన్యః; కిన్త్వాపాతతో న యుగాన్తో భవిష్యతి|</para>
  <para style="p">
    <verse number="8" style="v"/>దేశస్య విపక్షతయా దేశో రాజ్యస్య విపక్షతయా చ రాజ్యముత్థాస్యతి, తథా స్థానే స్థానే భూమికమ్పో దుర్భిక్షం మహాక్లేశాశ్చ సముపస్థాస్యన్తి, సర్వ్వ ఏతే దుఃఖస్యారమ్భాః|</para>
  <para style="p">
    <verse number="9" style="v"/>కిన్తు యూయమ్ ఆత్మార్థే సావధానాస్తిష్ఠత, యతో లోకా రాజసభాయాం యుష్మాన్ సమర్పయిష్యన్తి, తథా భజనగృహే ప్రహరిష్యన్తి; యూయం మదర్థే దేశాధిపాన్ భూపాంశ్చ ప్రతి సాక్ష్యదానాయ తేషాం సమ్ముఖే ఉపస్థాపయిష్యధ్వే|</para>
  <para style="p">
    <verse number="10" style="v"/>శేషీభవనాత్ పూర్వ్వం సర్వ్వాన్ దేశీయాన్ ప్రతి సుసంవాదః ప్రచారయిష్యతే|</para>
  <para style="p">
    <verse number="11" style="v"/>కిన్తు యదా తే యుష్మాన్ ధృత్వా సమర్పయిష్యన్తి తదా యూయం యద్యద్ ఉత్తరం దాస్యథ, తదగ్ర తస్య వివేచనం మా కురుత తదర్థం కిఞ్చిదపి మా చిన్తయత చ, తదానీం యుష్మాకం మనఃసు యద్యద్ వాక్యమ్ ఉపస్థాపయిష్యతే తదేవ వదిష్యథ, యతో యూయం న తద్వక్తారః కిన్తు పవిత్ర ఆత్మా తస్య వక్తా|</para>
  <para style="p">
    <verse number="12" style="v"/>తదా భ్రాతా భ్రాతరం పితా పుత్రం ఘాతనార్థం పరహస్తేషు సమర్పయిష్యతే, తథా పత్యాని మాతాపిత్రో ర్విపక్షతయా తౌ ఘాతయిష్యన్తి|</para>
  <para style="p">
    <verse number="13" style="v"/>మమ నామహేతోః సర్వ్వేషాం సవిధే యూయం జుగుప్సితా భవిష్యథ, కిన్తు యః కశ్చిత్ శేషపర్య్యన్తం ధైర్య్యమ్ ఆలమ్బిష్యతే సఏవ పరిత్రాస్యతే|</para>
  <para style="p">
    <verse number="14" style="v"/>దానియేల్భవిష్యద్వాదినా ప్రోక్తం సర్వ్వనాశి జుగుప్సితఞ్చ వస్తు యదా త్వయోగ్యస్థానే విద్యమానం ద్రక్షథ (యో జనః పఠతి స బుధ్యతాం) తదా యే యిహూదీయదేశే తిష్ఠన్తి తే మహీధ్రం ప్రతి పలాయన్తాం;</para>
  <para style="p">
    <verse number="15" style="v"/>తథా యో నరో గృహోపరి తిష్ఠతి స గృహమధ్యం నావరోహతు, తథా కిమపి వస్తు గ్రహీతుం మధ్యేగృహం న ప్రవిశతు;</para>
  <para style="p">
    <verse number="16" style="v"/>తథా చ యో నరః క్షేత్రే తిష్ఠతి సోపి స్వవస్త్రం గ్రహీతుం పరావృత్య న వ్రజతు|</para>
  <para style="p">
    <verse number="17" style="v"/>తదానీం గర్బ్భవతీనాం స్తన్యదాత్రీణాఞ్చ యోషితాం దుర్గతి ర్భవిష్యతి|</para>
  <para style="p">
    <verse number="18" style="v"/>యుష్మాకం పలాయనం శీతకాలే యథా న భవతి తదర్థం ప్రార్థయధ్వం|</para>
  <para style="p">
    <verse number="19" style="v"/>యతస్తదా యాదృశీ దుర్ఘటనా ఘటిష్యతే తాదృశీ దుర్ఘటనా ఈశ్వరసృష్టేః ప్రథమమారభ్యాద్య యావత్ కదాపి న జాతా న జనిష్యతే చ|</para>
  <para style="p">
    <verse number="20" style="v"/>అపరఞ్చ పరమేశ్వరో యది తస్య సమయస్య సంక్షేపం న కరోతి తర్హి కస్యాపి ప్రాణభృతో రక్షా భవితుం న శక్ష్యతి, కిన్తు యాన్ జనాన్ మనోనీతాన్ అకరోత్ తేషాం స్వమనోనీతానాం హేతోః స తదనేహసం సంక్షేప్స్యతి|</para>
  <para style="p">
    <verse number="21" style="v"/>అన్యచ్చ పశ్యత ఖ్రీష్టోత్ర స్థానే వా తత్ర స్థానే విద్యతే, తస్మిన్కాలే యది కశ్చిద్ యుష్మాన్ ఏతాదృశం వాక్యం వ్యాహరతి, తర్హి తస్మిన్ వాక్యే భైవ విశ్వసిత|</para>
  <para style="p">
    <verse number="22" style="v"/>యతోనేకే మిథ్యాఖ్రీష్టా మిథ్యాభవిష్యద్వాదినశ్చ సముపస్థాయ బహూని చిహ్నాన్యద్భుతాని కర్మ్మాణి చ దర్శయిష్యన్తి; తథా యది సమ్భవతి తర్హి మనోనీతలోకానామపి మిథ్యామతిం జనయిష్యన్తి|</para>
  <para style="p">
    <verse number="23" style="v"/>పశ్యత ఘటనాతః పూర్వ్వం సర్వ్వకార్య్యస్య వార్త్తాం యుష్మభ్యమదామ్, యూయం సావధానాస్తిష్ఠత|</para>
  <para style="p">
    <verse number="24" style="v"/>అపరఞ్చ తస్య క్లేశకాలస్యావ్యవహితే పరకాలే భాస్కరః సాన్ధకారో భవిష్యతి తథైవ చన్ద్రశ్చన్ద్రికాం న దాస్యతి|</para>
  <para style="p">
    <verse number="25" style="v"/>నభఃస్థాని నక్షత్రాణి పతిష్యన్తి, వ్యోమమణ్డలస్థా గ్రహాశ్చ విచలిష్యన్తి|</para>
  <para style="p">
    <verse number="26" style="v"/>తదానీం మహాపరాక్రమేణ మహైశ్వర్య్యేణ చ మేఘమారుహ్య సమాయాన్తం మానవసుతం మానవాః సమీక్షిష్యన్తే|</para>
  <para style="p">
    <verse number="27" style="v"/>అన్యచ్చ స నిజదూతాన్ ప్రహిత్య నభోభూమ్యోః సీమాం యావద్ జగతశ్చతుర్దిగ్భ్యః స్వమనోనీతలోకాన్ సంగ్రహీష్యతి|</para>
  <para style="p">
    <verse number="28" style="v"/>ఉడుమ్బరతరో ర్దృష్టాన్తం శిక్షధ్వం యదోడుమ్బరస్య తరో ర్నవీనాః శాఖా జాయన్తే పల్లవాదీని చ ర్నిగచ్ఛన్తి, తదా నిదాఘకాలః సవిధో భవతీతి యూయం జ్ఞాతుం శక్నుథ|</para>
  <para style="p">
    <verse number="29" style="v"/>తద్వద్ ఏతా ఘటనా దృష్ట్వా స కాలో ద్వార్య్యుపస్థిత ఇతి జానీత|</para>
  <para style="p">
    <verse number="30" style="v"/>యుష్మానహం యథార్థం వదామి, ఆధునికలోకానాం గమనాత్ పూర్వ్వం తాని సర్వ్వాణి ఘటిష్యన్తే|</para>
  <para style="p">
    <verse number="31" style="v"/>ద్యావాపృథివ్యో ర్విచలితయోః సత్యో ర్మదీయా వాణీ న విచలిష్యతి|</para>
  <para style="p">
    <verse number="32" style="v"/>అపరఞ్చ స్వర్గస్థదూతగణో వా పుత్రో వా తాతాదన్యః కోపి తం దివసం తం దణ్డం వా న జ్ఞాపయతి|</para>
  <para style="p">
    <verse number="33" style="v"/>అతః స సమయః కదా భవిష్యతి, ఏతజ్జ్ఞానాభావాద్ యూయం సావధానాస్తిష్ఠత, సతర్కాశ్చ భూత్వా ప్రార్థయధ్వం;</para>
  <para style="p">
    <verse number="34" style="v"/>యద్వత్ కశ్చిత్ పుమాన్ స్వనివేశనాద్ దూరదేశం ప్రతి యాత్రాకరణకాలే దాసేషు స్వకార్య్యస్య భారమర్పయిత్వా సర్వ్వాన్ స్వే స్వే కర్మ్మణి నియోజయతి; అపరం దౌవారికం జాగరితుం సమాదిశ్య యాతి, తద్వన్ నరపుత్రః|</para>
  <para style="p">
    <verse number="35" style="v"/>గృహపతిః సాయంకాలే నిశీథే వా తృతీయయామే వా ప్రాతఃకాలే వా కదాగమిష్యతి తద్ యూయం న జానీథ;</para>
  <para style="p">
    <verse number="36" style="v"/>స హఠాదాగత్య యథా యుష్మాన్ నిద్రితాన్ న పశ్యతి, తదర్థం జాగరితాస్తిష్ఠత|</para>
  <para style="p">
    <verse number="37" style="v"/>యుష్మానహం యద్ వదామి తదేవ సర్వ్వాన్ వదామి, జాగరితాస్తిష్ఠతేతి|</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>తదా నిస్తారోత్సవకిణ్వహీనపూపోత్సవయోరారమ్భస్య దినద్వయే ఽవశిష్టే ప్రధానయాజకా అధ్యాపకాశ్చ కేనాపి ఛలేన యీశుం ధర్త్తాం హన్తుఞ్చ మృగయాఞ్చక్రిరే;</para>
  <para style="p">
    <verse number="2" style="v"/>కిన్తు లోకానాం కలహభయాదూచిరే, నచోత్సవకాల ఉచితమేతదితి|</para>
  <para style="p">
    <verse number="3" style="v"/>అనన్తరం బైథనియాపుुరే శిమోనకుష్ఠినో గృహే యోశౌ భోత్కుముపవిష్టే సతి కాచిద్ యోషిత్ పాణ్డరపాషాణస్య సమ్పుటకేన మహార్ఘ్యోత్తమతైలమ్ ఆనీయ సమ్పుటకం భంక్త్వా తస్యోత్తమాఙ్గే తైలధారాం పాతయాఞ్చక్రే|</para>
  <para style="p">
    <verse number="4" style="v"/>తస్మాత్ కేచిత్ స్వాన్తే కుప్యన్తః కథితవంన్తః కుతోయం తైలాపవ్యయః?</para>
  <para style="p">
    <verse number="5" style="v"/>యద్యేతత్ తైల వ్యక్రేష్యత తర్హి ముద్రాపాదశతత్రయాదప్యధికం తస్య ప్రాప్తమూల్యం దరిద్రలోకేభ్యో దాతుమశక్ష్యత, కథామేతాం కథయిత్వా తయా యోషితా సాకం వాచాయుహ్యన్|</para>
  <para style="p">
    <verse number="6" style="v"/>కిన్తు యీశురువాచ, కుత ఏతస్యై కృచ్ఛ్రం దదాసి? మహ్యమియం కర్మ్మోత్తమం కృతవతీ|</para>
  <para style="p">
    <verse number="7" style="v"/>దరిద్రాః సర్వ్వదా యుష్మాభిః సహ తిష్ఠన్తి, తస్మాద్ యూయం యదేచ్ఛథ తదైవ తానుపకర్త్తాం శక్నుథ, కిన్త్వహం యుభాభిః సహ నిరన్తరం న తిష్ఠామి|</para>
  <para style="p">
    <verse number="8" style="v"/>అస్యా యథాసాధ్యం తథైవాకరోదియం, శ్మశానయాపనాత్ పూర్వ్వం సమేత్య మద్వపుషి తైలమ్ అమర్ద్దయత్|</para>
  <para style="p">
    <verse number="9" style="v"/>అహం యుష్మభ్యం యథార్థం కథయామి, జగతాం మధ్యే యత్ర యత్ర సుసంవాదోయం ప్రచారయిష్యతే తత్ర తత్ర యోషిత ఏతస్యాః స్మరణార్థం తత్కృతకర్మ్మైతత్ ప్రచారయిష్యతే|</para>
  <para style="p">
    <verse number="10" style="v"/>తతః పరం ద్వాదశానాం శిష్యాణామేక ఈష్కరియోతీయయిహూదాఖ్యో యీశుం పరకరేషు సమర్పయితుం ప్రధానయాజకానాం సమీపమియాయ|</para>
  <para style="p">
    <verse number="11" style="v"/>తే తస్య వాక్యం సమాకర్ణ్య సన్తుష్టాః సన్తస్తస్మై ముద్రా దాతుం ప్రత్యజానత; తస్మాత్ స తం తేషాం కరేషు సమర్పణాయోపాయం మృగయామాస|</para>
  <para style="p">
    <verse number="12" style="v"/>అనన్తరం కిణ్వశూన్యపూపోత్సవస్య ప్రథమేఽహని నిస్తారోత్మవార్థం మేషమారణాసమయే శిష్యాస్తం పప్రచ్ఛః కుత్ర గత్వా వయం నిస్తారోత్సవస్య భోజ్యమాసాదయిష్యామః? కిమిచ్ఛతి భవాన్?</para>
  <para style="p">
    <verse number="13" style="v"/>తదానీం స తేషాం ద్వయం ప్రేరయన్ బభాషే యువయోః పురమధ్యం గతయోః సతో ర్యో జనః సజలకుమ్భం వహన్ యువాం సాక్షాత్ కరిష్యతి తస్యైవ పశ్చాద్ యాతం;</para>
  <para style="p">
    <verse number="14" style="v"/>స యత్ సదనం ప్రవేక్ష్యతి తద్భవనపతిం వదతం, గురురాహ యత్ర సశిష్యోహం నిస్తారోత్సవీయం భోజనం కరిష్యామి, సా భోజనశాలా కుత్రాస్తి?</para>
  <para style="p">
    <verse number="15" style="v"/>తతః స పరిష్కృతాం సుసజ్జితాం బృహతీచఞ్చ యాం శాలాం దర్శయిష్యతి తస్యామస్మదర్థం భోజ్యద్రవ్యాణ్యాసాదయతం|</para>
  <para style="p">
    <verse number="16" style="v"/>తతః శిష్యౌ ప్రస్థాయ పురం ప్రవిశ్య స యథోక్తవాన్ తథైవ ప్రాప్య నిస్తారోత్సవస్య భోజ్యద్రవ్యాణి సమాసాదయేతామ్|</para>
  <para style="p">
    <verse number="17" style="v"/>అనన్తరం యీశుః సాయంకాలే ద్వాదశభిః శిష్యైః సార్ద్ధం జగామ;</para>
  <para style="p">
    <verse number="18" style="v"/>సర్వ్వేషు భోజనాయ ప్రోపవిష్టేషు స తానుదితవాన్ యుష్మానహం యథార్థం వ్యాహరామి, అత్ర యుష్మాకమేకో జనో యో మయా సహ భుంక్తే మాం పరకేరేషు సమర్పయిష్యతే|</para>
  <para style="p">
    <verse number="19" style="v"/>తదానీం తే దుఃఖితాః సన్త ఏకైకశస్తం ప్రష్టుమారబ్ధవన్తః స కిమహం? పశ్చాద్ అన్య ఏకోభిదధే స కిమహం?</para>
  <para style="p">
    <verse number="20" style="v"/>తతః స ప్రత్యవదద్ ఏతేషాం ద్వాదశానాం యో జనో మయా సమం భోజనాపాత్రే పాణిం మజ్జయిష్యతి స ఏవ|</para>
  <para style="p">
    <verse number="21" style="v"/>మనుజతనయమధి యాదృశం లిఖితమాస్తే తదనురూపా గతిస్తస్య భవిష్యతి, కిన్తు యో జనో మానవసుతం సమర్పయిష్యతే హన్త తస్య జన్మాభావే సతి భద్రమభవిష్యత్|</para>
  <para style="p">
    <verse number="22" style="v"/>అపరఞ్చ తేషాం భోజనసమయే యీశుః పూపం గృహీత్వేశ్వరగుణాన్ అనుకీర్త్య భఙ్క్త్వా తేభ్యో దత్త్వా బభాషే, ఏతద్ గృహీత్వా భుఞ్జీధ్వమ్ ఏతన్మమ విగ్రహరూపం|</para>
  <para style="p">
    <verse number="23" style="v"/>అనన్తరం స కంసం గృహీత్వేశ్వరస్య గుణాన్ కీర్త్తయిత్వా తేభ్యో దదౌ, తతస్తే సర్వ్వే పపుః|</para>
  <para style="p">
    <verse number="24" style="v"/>అపరం స తానవాదీద్ బహూనాం నిమిత్తం పాతితం మమ నవీననియమరూపం శోణితమేతత్|</para>
  <para style="p">
    <verse number="25" style="v"/>యుష్మానహం యథార్థం వదామి, ఈశ్వరస్య రాజ్యే యావత్ సద్యోజాతం ద్రాక్షారసం న పాస్యామి,తావదహం ద్రాక్షాఫలరసం పున ర్న పాస్యామి|</para>
  <para style="p">
    <verse number="26" style="v"/>తదనన్తరం తే గీతమేకం సంగీయ బహి ర్జైతునం శిఖరిణం యయుః</para>
  <para style="p">
    <verse number="27" style="v"/>అథ యీశుస్తానువాచ నిశాయామస్యాం మయి యుష్మాకం సర్వ్వేషాం ప్రత్యూహో భవిష్యతి యతో లిఖితమాస్తే యథా, మేషాణాం రక్షకఞ్చాహం ప్రహరిష్యామి వై తతః| మేషాణాం నివహో నూనం ప్రవికీర్ణో భవిష్యతి|</para>
  <para style="p">
    <verse number="28" style="v"/>కన్తు మదుత్థానే జాతే యుష్మాకమగ్రేఽహం గాలీలం వ్రజిష్యామి|</para>
  <para style="p">
    <verse number="29" style="v"/>తదా పితరః ప్రతిబభాషే, యద్యపి సర్వ్వేషాం ప్రత్యూహో భవతి తథాపి మమ నైవ భవిష్యతి|</para>
  <para style="p">
    <verse number="30" style="v"/>తతో యీశురుక్తావాన్ అహం తుభ్యం తథ్యం కథయామి, క్షణాదాయామద్య కుక్కుటస్య ద్వితీయవారరవణాత్ పూర్వ్వం త్వం వారత్రయం మామపహ్నోష్యసే|</para>
  <para style="p">
    <verse number="31" style="v"/>కిన్తు స గాఢం వ్యాహరద్ యద్యపి త్వయా సార్ద్ధం మమ ప్రాణో యాతి తథాపి కథమపి త్వాం నాపహ్నోష్యే; సర్వ్వేఽపీతరే తథైవ బభాషిరే|</para>
  <para style="p">
    <verse number="32" style="v"/>అపరఞ్చ తేషు గేత్శిమానీనామకం స్థాన గతేషు స శిష్యాన్ జగాద, యావదహం ప్రార్థయే తావదత్ర స్థానే యూయం సముపవిశత|</para>
  <para style="p">
    <verse number="33" style="v"/>అథ స పితరం యాకూబం యోహనఞ్చ గృహీత్వా వవ్రాజ; అత్యన్తం త్రాసితో వ్యాకులితశ్చ తేభ్యః కథయామాస,</para>
  <para style="p">
    <verse number="34" style="v"/>నిధనకాలవత్ ప్రాణో మేఽతీవ దఃఖమేతి, యూయం జాగ్రతోత్ర స్థానే తిష్ఠత|</para>
  <para style="p">
    <verse number="35" style="v"/>తతః స కిఞ్చిద్దూరం గత్వా భూమావధోముఖః పతిత్వా ప్రార్థితవానేతత్, యది భవితుం శక్యం తర్హి దుఃఖసమయోయం మత్తో దూరీభవతు|</para>
  <para style="p">
    <verse number="36" style="v"/>అపరముదితవాన్ హే పిత ర్హే పితః సర్వ్వేం త్వయా సాధ్యం, తతో హేతోరిమం కంసం మత్తో దూరీకురు, కిన్తు తన్ మమేచ్ఛాతో న తవేచ్ఛాతో భవతు|</para>
  <para style="p">
    <verse number="37" style="v"/>తతః పరం స ఏత్య తాన్ నిద్రితాన్ నిరీక్ష్య పితరం ప్రోవాచ, శిమోన్ త్వం కిం నిద్రాసి? ఘటికామేకామ్ అపి జాగరితుం న శక్నోషి?</para>
  <para style="p">
    <verse number="38" style="v"/>పరీక్షాయాం యథా న పతథ తదర్థం సచేతనాః సన్తః ప్రార్థయధ్వం; మన ఉద్యుక్తమితి సత్యం కిన్తు వపురశక్తికం|</para>
  <para style="p">
    <verse number="39" style="v"/>అథ స పునర్వ్రజిత్వా పూర్వ్వవత్ ప్రార్థయాఞ్చక్రే|</para>
  <para style="p">
    <verse number="40" style="v"/>పరావృత్యాగత్య పునరపి తాన్ నిద్రితాన్ దదర్శ తదా తేషాం లోచనాని నిద్రయా పూర్ణాని, తస్మాత్తస్మై కా కథా కథయితవ్యా త ఏతద్ బోద్ధుం న శేకుః|</para>
  <para style="p">
    <verse number="41" style="v"/>తతఃపరం తృతీయవారం ఆగత్య తేభ్యో ఽకథయద్ ఇదానీమపి శయిత్వా విశ్రామ్యథ? యథేష్టం జాతం, సమయశ్చోపస్థితః పశ్యత మానవతనయః పాపిలోకానాం పాణిషు సమర్ప్యతే|</para>
  <para style="p">
    <verse number="42" style="v"/>ఉత్తిష్ఠత, వయం వ్రజామో యో జనో మాం పరపాణిషు సమర్పయిష్యతే పశ్యత స సమీపమాయాతః|</para>
  <para style="p">
    <verse number="43" style="v"/>ఇమాం కథాం కథయతి స, ఏతర్హిద్వాదశానామేకో యిహూదా నామా శిష్యః ప్రధానయాజకానామ్ ఉపాధ్యాయానాం ప్రాచీనలోకానాఞ్చ సన్నిధేః ఖఙ్గలగుడధారిణో బహులోకాన్ గృహీత్వా తస్య సమీప ఉపస్థితవాన్|</para>
  <para style="p">
    <verse number="44" style="v"/>అపరఞ్చాసౌ పరపాణిషు సమర్పయితా పూర్వ్వమితి సఙ్కేతం కృతవాన్ యమహం చుమ్బిష్యామి స ఏవాసౌ తమేవ ధృత్వా సావధానం నయత|</para>
  <para style="p">
    <verse number="45" style="v"/>అతో హేతోః స ఆగత్యైవ యోశోః సవిధం గత్వా హే గురో హే గురో, ఇత్యుక్త్వా తం చుచుమ్బ|</para>
  <para style="p">
    <verse number="46" style="v"/>తదా తే తదుపరి పాణీనర్పయిత్వా తం దధ్నుః|</para>
  <para style="p">
    <verse number="47" style="v"/>తతస్తస్య పార్శ్వస్థానాం లోకానామేకః ఖఙ్గం నిష్కోషయన్ మహాయాజకస్య దాసమేకం ప్రహృత్య తస్య కర్ణం చిచ్ఛేద|</para>
  <para style="p">
    <verse number="48" style="v"/>పశ్చాద్ యీశుస్తాన్ వ్యాజహార ఖఙ్గాన్ లగుడాంశ్చ గృహీత్వా మాం కిం చౌరం ధర్త్తాం సమాయాతాః?</para>
  <para style="p">
    <verse number="49" style="v"/>మధ్యేమన్దిరం సముపదిశన్ ప్రత్యహం యుష్మాభిః సహ స్థితవానతహం, తస్మిన్ కాలే యూయం మాం నాదీధరత, కిన్త్వనేన శాస్త్రీయం వచనం సేధనీయం|</para>
  <para style="p">
    <verse number="50" style="v"/>తదా సర్వ్వే శిష్యాస్తం పరిత్యజ్య పలాయాఞ్చక్రిరే|</para>
  <para style="p">
    <verse number="51" style="v"/>అథైకో యువా మానవో నగ్నకాయే వస్త్రమేకం నిధాయ తస్య పశ్చాద్ వ్రజన్ యువలోకై ర్ధృతో</para>
  <para style="p">
    <verse number="52" style="v"/>వస్త్రం విహాయ నగ్నః పలాయాఞ్చక్రే|</para>
  <para style="p">
    <verse number="53" style="v"/>అపరఞ్చ యస్మిన్ స్థానే ప్రధానయాజకా ఉపాధ్యాయాః ప్రాచీనలోకాశ్చ మహాయాజకేన సహ సదసి స్థితాస్తస్మిన్ స్థానే మహాయాజకస్య సమీపం యీశుం నిన్యుః|</para>
  <para style="p">
    <verse number="54" style="v"/>పితరో దూరే తత్పశ్చాద్ ఇత్వా మహాయాజకస్యాట్టాలికాం ప్రవిశ్య కిఙ్కరైః సహోపవిశ్య వహ్నితాపం జగ్రాహ|</para>
  <para style="p">
    <verse number="55" style="v"/>తదానీం ప్రధానయాజకా మన్త్రిణశ్చ యీశుం ఘాతయితుం తత్ప్రాతికూల్యేన సాక్షిణో మృగయాఞ్చక్రిరే, కిన్తు న ప్రాప్తాః|</para>
  <para style="p">
    <verse number="56" style="v"/>అనేకైస్తద్విరుద్ధం మృషాసాక్ష్యే దత్తేపి తేషాం వాక్యాని న సమగచ్ఛన్త|</para>
  <para style="p">
    <verse number="57" style="v"/>సర్వ్వశేషే కియన్త ఉత్థాయ తస్య ప్రాతికూల్యేన మృషాసాక్ష్యం దత్త్వా కథయామాసుః,</para>
  <para style="p">
    <verse number="58" style="v"/>ఇదం కరకృతమన్దిరం వినాశ్య దినత్రయమధ్యే పునరపరమ్ అకరకృతం మన్దిరం నిర్మ్మాస్యామి, ఇతి వాక్యమ్ అస్య ముఖాత్ శ్రుతమస్మాభిరితి|</para>
  <para style="p">
    <verse number="59" style="v"/>కిన్తు తత్రాపి తేషాం సాక్ష్యకథా న సఙ్గాతాః|</para>
  <para style="p">
    <verse number="60" style="v"/>అథ మహాయాజకో మధ్యేసభమ్ ఉత్థాయ యీశుం వ్యాజహార, ఏతే జనాస్త్వయి యత్ సాక్ష్యమదుః త్వమేతస్య కిమప్యుత్తరం కిం న దాస్యసి?</para>
  <para style="p">
    <verse number="61" style="v"/>కిన్తు స కిమప్యుత్తరం న దత్వా మౌనీభూయ తస్యౌ; తతో మహాయాజకః పునరపి తం పృష్టావాన్ త్వం సచ్చిదానన్దస్య తనయో ఽభిషిక్తస్త్రతా?</para>
  <para style="p">
    <verse number="62" style="v"/>తదా యీశుస్తం ప్రోవాచ భవామ్యహమ్ యూయఞ్చ సర్వ్వశక్తిమతో దక్షీణపార్శ్వే సముపవిశన్తం మేఘ మారుహ్య సమాయాన్తఞ్చ మనుష్యపుత్రం సన్ద్రక్ష్యథ|</para>
  <para style="p">
    <verse number="63" style="v"/>తదా మహాయాజకః స్వం వమనం ఛిత్వా వ్యావహరత్</para>
  <para style="p">
    <verse number="64" style="v"/>కిమస్మాకం సాక్షిభిః ప్రయోజనమ్? ఈశ్వరనిన్దావాక్యం యుష్మాభిరశ్రావి కిం విచారయథ? తదానీం సర్వ్వే జగదురయం నిధనదణ్డమర్హతి|</para>
  <para style="p">
    <verse number="65" style="v"/>తతః కశ్చిత్ కశ్చిత్ తద్వపుషి నిష్ఠీవం నిచిక్షేప తథా తన్ముఖమాచ్ఛాద్య చపేటేన హత్వా గదితవాన్ గణయిత్వా వద, అనుచరాశ్చ చపేటైస్తమాజఘ్నుః</para>
  <para style="p">
    <verse number="66" style="v"/>తతః పరం పితరేఽట్టాలికాధఃకోష్ఠే తిష్ఠతి మహాయాజకస్యైకా దాసీ సమేత్య</para>
  <para style="p">
    <verse number="67" style="v"/>తం విహ్నితాపం గృహ్లన్తం విలోక్య తం సునిరీక్ష్య బభాషే త్వమపి నాసరతీయయీశోః సఙ్గినామ్ ఏకో జన ఆసీః|</para>
  <para style="p">
    <verse number="68" style="v"/>కిన్తు సోపహ్నుత్య జగాద తమహం న వద్మి త్వం యత్ కథయమి తదప్యహం న బుద్ధ్యే| తదానీం పితరే చత్వరం గతవతి కుेక్కుటో రురావ|</para>
  <para style="p">
    <verse number="69" style="v"/>అథాన్యా దాసీ పితరం దృష్ట్వా సమీపస్థాన్ జనాన్ జగాద అయం తేషామేకో జనః|</para>
  <para style="p">
    <verse number="70" style="v"/>తతః స ద్వితీయవారమ్ అపహ్నుతవాన్ పశ్చాత్ తత్రస్థా లోకాః పితరం ప్రోచుస్త్వమవశ్యం తేషామేకో జనః యతస్త్వం గాలీలీయో నర ఇతి తవోచ్చారణం ప్రకాశయతి|</para>
  <para style="p">
    <verse number="71" style="v"/>తదా స శపథాభిశాపౌ కృత్వా ప్రోవాచ యూయం కథాం కథయథ తం నరం న జానేఽహం|</para>
  <para style="p">
    <verse number="72" style="v"/>తదానీం ద్వితీయవారం కుక్కుటో ఽరావీత్| కుక్కుటస్య ద్వితీయరవాత్ పూర్వ్వం త్వం మాం వారత్రయమ్ అపహ్నోష్యసి, ఇతి యద్వాక్యం యీశునా సముదితం తత్ తదా సంస్మృత్య పితరో రోదితుమ్ ఆరభత|</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అథ ప్రభాతే సతి ప్రధానయాజకాః ప్రాఞ్చ ఉపాధ్యాయాః సర్వ్వే మన్త్రిణశ్చ సభాం కృత్వా యీశుृం బన్ధయిత్వ పీలాతాఖ్యస్య దేశాధిపతేః సవిధం నీత్వా సమర్పయామాసుః|</para>
  <para style="p">
    <verse number="2" style="v"/>తదా పీలాతస్తం పృష్టవాన్ త్వం కిం యిహూదీయలోకానాం రాజా? తతః స ప్రత్యుక్తవాన్ సత్యం వదసి|</para>
  <para style="p">
    <verse number="3" style="v"/>అపరం ప్రధానయాజకాస్తస్య బహుషు వాక్యేషు దోషమారోపయాఞ్చక్రుః కిన్తు స కిమపి న ప్రత్యువాచ|</para>
  <para style="p">
    <verse number="4" style="v"/>తదానీం పీలాతస్తం పునః పప్రచ్ఛ త్వం కిం నోత్తరయసి? పశ్యైతే త్వద్విరుద్ధం కతిషు సాధ్యేషు సాక్షం దదతి|</para>
  <para style="p">
    <verse number="5" style="v"/>కన్తు యీశుస్తదాపి నోత్తరం దదౌ తతః పీలాత ఆశ్చర్య్యం జగామ|</para>
  <para style="p">
    <verse number="6" style="v"/>అపరఞ్చ కారాబద్ధే కస్తింశ్చిత్ జనే తన్మహోత్సవకాలే లోకై ర్యాచితే దేశాధిపతిస్తం మోచయతి|</para>
  <para style="p">
    <verse number="7" style="v"/>యే చ పూర్వ్వముపప్లవమకార్షురుపప్లవే వధమపి కృతవన్తస్తేషాం మధ్యే తదానోం బరబ్బానామక ఏకో బద్ధ ఆసీత్|</para>
  <para style="p">
    <verse number="8" style="v"/>అతో హేతోః పూర్వ్వాపరీయాం రీతికథాం కథయిత్వా లోకా ఉచ్చైరువన్తః పీలాతస్య సమక్షం నివేదయామాసుః|</para>
  <para style="p">
    <verse number="9" style="v"/>తదా పీలాతస్తానాచఖ్యౌ తర్హి కిం యిహూదీయానాం రాజానం మోచయిష్యామి? యుష్మాభిః కిమిష్యతే?</para>
  <para style="p">
    <verse number="10" style="v"/>యతః ప్రధానయాజకా ఈర్ష్యాత ఏవ యీశుం సమార్పయన్నితి స వివేద|</para>
  <para style="p">
    <verse number="11" style="v"/>కిన్తు యథా బరబ్బాం మోచయతి తథా ప్రార్థయితుం ప్రధానయాజకా లోకాన్ ప్రవర్త్తయామాసుః|</para>
  <para style="p">
    <verse number="12" style="v"/>అథ పీలాతః పునః పృష్టవాన్ తర్హి యం యిహూదీయానాం రాజేతి వదథ తస్య కిం కరిష్యామి యుష్మాభిః కిమిష్యతే?</para>
  <para style="p">
    <verse number="13" style="v"/>తదా తే పునరపి ప్రోచ్చైః ప్రోచుస్తం క్రుశే వేధయ|</para>
  <para style="p">
    <verse number="14" style="v"/>తస్మాత్ పీలాతః కథితవాన్ కుతః? స కిం కుకర్మ్మ కృతవాన్? కిన్తు తే పునశ్చ రువన్తో వ్యాజహ్రుస్తం క్రుశే వేధయ|</para>
  <para style="p">
    <verse number="15" style="v"/>తదా పీలాతః సర్వ్వాల్లోకాన్ తోషయితుమిచ్ఛన్ బరబ్బాం మోచయిత్వా యీశుం కశాభిః ప్రహృత్య క్రుశే వేద్ధుం తం సమర్పయామ్బభూవ|</para>
  <para style="p">
    <verse number="16" style="v"/>అనన్తరం సైన్యగణోఽట్టాలికామ్ అర్థాద్ అధిపతే ర్గృహం యీశుం నీత్వా సేనానివహం సమాహుయత్|</para>
  <para style="p">
    <verse number="17" style="v"/>పశ్చాత్ తే తం ధూమలవర్ణవస్త్రం పరిధాప్య కణ్టకముకుటం రచయిత్వా శిరసి సమారోప్య</para>
  <para style="p">
    <verse number="18" style="v"/>హే యిహూదీయానాం రాజన్ నమస్కార ఇత్యుక్త్వా తం నమస్కర్త్తామారేభిరే|</para>
  <para style="p">
    <verse number="19" style="v"/>తస్యోత్తమాఙ్గే వేత్రాఘాతం చక్రుస్తద్గాత్రే నిష్ఠీవఞ్చ నిచిక్షిపుః, తథా తస్య సమ్ముఖే జానుపాతం ప్రణోముః</para>
  <para style="p">
    <verse number="20" style="v"/>ఇత్థముపహస్య ధూమ్రవర్ణవస్త్రమ్ ఉత్తార్య్య తస్య వస్త్రం తం పర్య్యధాపయన్ క్రుశే వేద్ధుం బహిర్నిన్యుశ్చ|</para>
  <para style="p">
    <verse number="21" style="v"/>తతః పరం సేకన్దరస్య రుఫస్య చ పితా శిమోన్నామా కురీణీయలోక ఏకః కుతశ్చిద్ గ్రామాదేత్య పథి యాతి తం తే యీశోః క్రుశం వోఢుం బలాద్ దధ్నుః|</para>
  <para style="p">
    <verse number="22" style="v"/>అథ గుల్గల్తా అర్థాత్ శిరఃకపాలనామకం స్థానం యీశుమానీయ</para>
  <para style="p">
    <verse number="23" style="v"/>తే గన్ధరసమిశ్రితం ద్రాక్షారసం పాతుం తస్మై దదుః కిన్తు స న జగ్రాహ|</para>
  <para style="p">
    <verse number="24" style="v"/>తస్మిన్ క్రుశే విద్ధే సతి తేషామేకైకశః కిం ప్రాప్స్యతీతి నిర్ణయాయ</para>
  <para style="p">
    <verse number="25" style="v"/>తస్య పరిధేయానాం విభాగార్థం గుటికాపాతం చక్రుః|</para>
  <para style="p">
    <verse number="26" style="v"/>అపరమ్ ఏష యిహూదీయానాం రాజేతి లిఖితం దోషపత్రం తస్య శిరఊర్ద్వ్వమ్ ఆరోపయాఞ్చక్రుః|</para>
  <para style="p">
    <verse number="27" style="v"/>తస్య వామదక్షిణయో ర్ద్వౌ చౌరౌ క్రుశయో ర్వివిధాతే|</para>
  <para style="p">
    <verse number="28" style="v"/>తేనైవ "అపరాధిజనైః సార్ద్ధం స గణితో భవిష్యతి," ఇతి శాస్త్రోక్తం వచనం సిద్ధమభూత|</para>
  <para style="p">
    <verse number="29" style="v"/>అనన్తరం మార్గే యే యే లోకా గమనాగమనే చక్రుస్తే సర్వ్వ ఏవ శిరాంస్యాన్దోల్య నిన్దన్తో జగదుః, రే మన్దిరనాశక రే దినత్రయమధ్యే తన్నిర్మ్మాయక,</para>
  <para style="p">
    <verse number="30" style="v"/>అధునాత్మానమ్ అవిత్వా క్రుశాదవరోహ|</para>
  <para style="p">
    <verse number="31" style="v"/>కిఞ్చ ప్రధానయాజకా అధ్యాపకాశ్చ తద్వత్ తిరస్కృత్య పరస్పరం చచక్షిరే ఏష పరానావత్ కిన్తు స్వమవితుం న శక్నోతి|</para>
  <para style="p">
    <verse number="32" style="v"/>యదీస్రాయేలో రాజాభిషిక్తస్త్రాతా భవతి తర్హ్యధునైన క్రుశాదవరోహతు వయం తద్ దృష్ట్వా విశ్వసిష్యామః; కిఞ్చ యౌ లోకౌ తేన సార్ద్ధం క్రుశే ఽవిధ్యేతాం తావపి తం నిర్భర్త్సయామాసతుః|</para>
  <para style="p">
    <verse number="33" style="v"/>అథ ద్వితీయయామాత్ తృతీయయామం యావత్ సర్వ్వో దేశః సాన్ధకారోభూత్|</para>
  <para style="p">
    <verse number="34" style="v"/>తతస్తృతీయప్రహరే యీశురుచ్చైరవదత్ ఏలీ ఏలీ లామా శివక్తనీ అర్థాద్ "హే మదీశ మదీశ త్వం పర్య్యత్యాక్షీః కుతో హి మాం?"</para>
  <para style="p">
    <verse number="35" style="v"/>తదా సమీపస్థలోకానాం కేచిత్ తద్వాక్యం నిశమ్యాచఖ్యుః పశ్యైష ఏలియమ్ ఆహూయతి|</para>
  <para style="p">
    <verse number="36" style="v"/>తత ఏకో జనో ధావిత్వాగత్య స్పఞ్జే ఽమ్లరసం పూరయిత్వా తం నడాగ్రే నిధాయ పాతుం తస్మై దత్త్వావదత్ తిష్ఠ ఏలియ ఏనమవరోహయితుమ్ ఏతి న వేతి పశ్యామి|</para>
  <para style="p">
    <verse number="37" style="v"/>అథ యీశురుచ్చైః సమాహూయ ప్రాణాన్ జహౌ|</para>
  <para style="p">
    <verse number="38" style="v"/>తదా మన్దిరస్య జవనికోర్ద్వ్వాదధఃర్య్యన్తా విదీర్ణా ద్విఖణ్డాభూత్|</para>
  <para style="p">
    <verse number="39" style="v"/>కిఞ్చ ఇత్థముచ్చైరాహూయ ప్రాణాన్ త్యజన్తం తం దృష్ద్వా తద్రక్షణాయ నియుక్తో యః సేనాపతిరాసీత్ సోవదత్ నరోయమ్ ఈశ్వరపుత్ర ఇతి సత్యమ్|</para>
  <para style="p">
    <verse number="40" style="v"/>తదానీం మగ్దలీనీ మరిసమ్ కనిష్ఠయాకూబో యోసేశ్చ మాతాన్యమరియమ్ శాలోమీ చ యాః స్త్రియో</para>
  <para style="p">
    <verse number="41" style="v"/>గాలీల్ప్రదేశే యీశుం సేవిత్వా తదనుగామిన్యో జాతా ఇమాస్తదన్యాశ్చ యా అనేకా నార్యో యీశునా సార్ద్ధం యిరూశాలమమాయాతాస్తాశ్చ దూరాత్ తాని దదృశుః|</para>
  <para style="p">
    <verse number="42" style="v"/>అథాసాదనదినస్యార్థాద్ విశ్రామవారాత్ పూర్వ్వదినస్య సాయంకాల ఆగత</para>
  <para style="p">
    <verse number="43" style="v"/>ఈశ్వరరాజ్యాపేక్ష్యరిమథీయయూషఫనామా మాన్యమన్త్రీ సమేత్య పీలాతసవిధం నిర్భయో గత్వా యీశోర్దేహం యయాచే|</para>
  <para style="p">
    <verse number="44" style="v"/>కిన్తు స ఇదానీం మృతః పీలాత ఇత్యసమ్భవం మత్వా శతసేనాపతిమాహూయ స కదా మృత ఇతి పప్రచ్ఛ|</para>
  <para style="p">
    <verse number="45" style="v"/>శతసేమనాపతిముఖాత్ తజ్జ్ఞాత్వా యూషఫే యీశోర్దేహం దదౌ|</para>
  <para style="p">
    <verse number="46" style="v"/>పశ్చాత్ స సూక్ష్మం వాసః క్రీత్వా యీశోః కాయమవరోహ్య తేన వాససా వేష్టాయిత్వా గిరౌ ఖాతశ్మశానే స్థాపితవాన్ పాషాణం లోఠయిత్వా ద్వారి నిదధే|</para>
  <para style="p">
    <verse number="47" style="v"/>కిన్తు యత్ర సోస్థాప్యత తత మగ్దలీనీ మరియమ్ యోసిమాతృమరియమ్ చ దదృశతృః|</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అథ విశ్రామవారే గతే మగ్దలీనీ మరియమ్ యాకూబమాతా మరియమ్ శాలోమీ చేమాస్తం మర్ద్దయితుం సుగన్ధిద్రవ్యాణి క్రీత్వా</para>
  <para style="p">
    <verse number="2" style="v"/>సప్తాహప్రథమదినేఽతిప్రత్యూషే సూర్య్యోదయకాలే శ్మశానముపగతాః|</para>
  <para style="p">
    <verse number="3" style="v"/>కిన్తు శ్మశానద్వారపాషాణోఽతిబృహన్ తం కోఽపసారయిష్యతీతి తాః పరస్పరం గదన్తి!</para>
  <para style="p">
    <verse number="4" style="v"/>ఏతర్హి నిరీక్ష్య పాషాణో ద్వారో ఽపసారిత ఇతి దదృశుః|</para>
  <para style="p">
    <verse number="5" style="v"/>పశ్చాత్తాః శ్మశానం ప్రవిశ్య శుక్లవర్ణదీర్ఘపరిచ్ఛదావృతమేకం యువానం శ్మశానదక్షిణపార్శ్వ ఉపవిష్టం దృష్ట్వా చమచ్చక్రుః|</para>
  <para style="p">
    <verse number="6" style="v"/>సోఽవదత్, మాభైష్ట యూయం క్రుశే హతం నాసరతీయయీశుం గవేషయథ సోత్ర నాస్తి శ్మశానాదుదస్థాత్; తై ర్యత్ర స స్థాపితః స్థానం తదిదం పశ్యత|</para>
  <para style="p">
    <verse number="7" style="v"/>కిన్తు తేన యథోక్తం తథా యుష్మాకమగ్రే గాలీలం యాస్యతే తత్ర స యుష్మాన్ సాక్షాత్ కరిష్యతే యూయం గత్వా తస్య శిష్యేభ్యః పితరాయ చ వార్త్తామిమాం కథయత|</para>
  <para style="p">
    <verse number="8" style="v"/>తాః కమ్పితా విస్తితాశ్చ తూర్ణం శ్మశానాద్ బహిర్గత్వా పలాయన్త భయాత్ కమపి కిమపి నావదంశ్చ|</para>
  <para style="p">
    <verse number="9" style="v"/>అపరం యీశుః సప్తాహప్రథమదినే ప్రత్యూషే శ్మశానాదుత్థాయ యస్యాః సప్తభూతాస్త్యాజితాస్తస్యై మగ్దలీనీమరియమే ప్రథమం దర్శనం దదౌ|</para>
  <para style="p">
    <verse number="10" style="v"/>తతః సా గత్వా శోకరోదనకృద్భ్యోఽనుగతలోకేభ్యస్తాం వార్త్తాం కథయామాస|</para>
  <para style="p">
    <verse number="11" style="v"/>కిన్తు యీశుః పునర్జీవన్ తస్యై దర్శనం దత్తవానితి శ్రుత్వా తే న ప్రత్యయన్|</para>
  <para style="p">
    <verse number="12" style="v"/>పశ్చాత్ తేషాం ద్వాయో ర్గ్రామయానకాలే యీశురన్యవేశం ధృత్వా తాభ్యాం దర్శన దదౌ!</para>
  <para style="p">
    <verse number="13" style="v"/>తావపి గత్వాన్యశిష్యేభ్యస్తాం కథాం కథయాఞ్చక్రతుః కిన్తు తయోః కథామపి తే న ప్రత్యయన్|</para>
  <para style="p">
    <verse number="14" style="v"/>శేషత ఏకాదశశిష్యేషు భోజనోపవిష్టేషు యీశుస్తేభ్యో దర్శనం దదౌ తథోత్థానాత్ పరం తద్దర్శనప్రాప్తలోకానాం కథాయామవిశ్వాసకరణాత్ తేషామవిశ్వాసమనఃకాఠిన్యాభ్యాం హేతుభ్యాం స తాంస్తర్జితవాన్|</para>
  <para style="p">
    <verse number="15" style="v"/>అథ తానాచఖ్యౌ యూయం సర్వ్వజగద్ గత్వా సర్వ్వజనాన్ ప్రతి సుసంవాదం ప్రచారయత|</para>
  <para style="p">
    <verse number="16" style="v"/>తత్ర యః కశ్చిద్ విశ్వస్య మజ్జితో భవేత్ స పరిత్రాస్యతే కిన్తు యో న విశ్వసిష్యతి స దణ్డయిష్యతే|</para>
  <para style="p">
    <verse number="17" style="v"/>కిఞ్చ యే ప్రత్యేష్యన్తి తైరీదృగ్ ఆశ్చర్య్యం కర్మ్మ ప్రకాశయిష్యతే తే మన్నామ్నా భూతాన్ త్యాజయిష్యన్తి భాషా అన్యాశ్చ వదిష్యన్తి|</para>
  <para style="p">
    <verse number="18" style="v"/>అపరం తైః సర్పేషు ధృతేషు ప్రాణనాశకవస్తుని పీతే చ తేషాం కాపి క్షతి ర్న భవిష్యతి; రోగిణాం గాత్రేషు కరార్పితే తేఽరోగా భవిష్యన్తి చ|</para>
  <para style="p">
    <verse number="19" style="v"/>అథ ప్రభుస్తానిత్యాదిశ్య స్వర్గం నీతః సన్ పరమేశ్వరస్య దక్షిణ ఉపవివేశ|</para>
  <para style="p">
    <verse number="20" style="v"/>తతస్తే ప్రస్థాయ సర్వ్వత్ర సుసంవాదీయకథాం ప్రచారయితుమారేభిరే ప్రభుస్తు తేషాం సహాయః సన్ ప్రకాశితాశ్చర్య్యక్రియాభిస్తాం కథాం ప్రమాణవతీం చకార| ఇతి|</para>
</usx>
