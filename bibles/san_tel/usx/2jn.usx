<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="2JN" style="id">Sanskrit Bible (NT) in Telugu Script (సత్యవేదః।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">2 John</para>
  <para style="toc1">2 యోహనః పత్రం</para>
  <para style="toc2">2 యోహనః</para>
  <para style="toc3">2 యోహనః</para>
  <para style="mt1">2 యోహనః పత్రం</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>హే అభిరుచితే కురియే, త్వాం తవ పుత్రాంశ్చ ప్రతి ప్రాచీనోఽహం పత్రం లిఖామి|</para>
  <para style="p">
    <verse number="2" style="v"/>సత్యమతాద్ యుష్మాసు మమ ప్రేమాస్తి కేవలం మమ నహి కిన్తు సత్యమతజ్ఞానాం సర్వ్వేషామేవ| యతః సత్యమతమ్ అస్మాసు తిష్ఠత్యనన్తకాలం యావచ్చాస్మాసు స్థాస్యతి|</para>
  <para style="p">
    <verse number="3" style="v"/>పితురీశ్వరాత్ తత్పితుః పుత్రాత్ ప్రభో ర్యీశుఖ్రీష్టాచ్చ ప్రాప్యో ఽనుగ్రహః కృపా శాన్తిశ్చ సత్యతాప్రేమభ్యాం సార్ద్ధం యుష్మాన్ అధితిష్ఠతు|</para>
  <para style="p">
    <verse number="4" style="v"/>వయం పితృతో యామ్ ఆజ్ఞాం ప్రాప్తవన్తస్తదనుసారేణ తవ కేచిద్ ఆత్మజాః సత్యమతమ్ ఆచరన్త్యేతస్య ప్రమాణం ప్రాప్యాహం భృశమ్ ఆనన్దితవాన్|</para>
  <para style="p">
    <verse number="5" style="v"/>సామ్ప్రతఞ్చ హే కురియే, నవీనాం కాఞ్చిద్ ఆజ్ఞాం న లిఖన్నహమ్ ఆదితో లబ్ధామ్ ఆజ్ఞాం లిఖన్ త్వామ్ ఇదం వినయే యద్ అస్మాభిః పరస్పరం ప్రేమ కర్త్తవ్యం|</para>
  <para style="p">
    <verse number="6" style="v"/>అపరం ప్రేమైతేన ప్రకాశతే యద్ వయం తస్యాజ్ఞా ఆచరేమ| ఆదితో యుష్మాభి ర్యా శ్రుతా సేయమ్ ఆజ్ఞా సా చ యుష్మాభిరాచరితవ్యా|</para>
  <para style="p">
    <verse number="7" style="v"/>యతో బహవః ప్రవఞ్చకా జగత్ ప్రవిశ్య యీశుఖ్రీష్టో నరావతారో భూత్వాగత ఏతత్ నాఙ్గీకుర్వ్వన్తి స ఏవ ప్రవఞ్చకః ఖ్రీష్టారిశ్చాస్తి|</para>
  <para style="p">
    <verse number="8" style="v"/>అస్మాకం శ్రమో యత్ పణ్డశ్రమో న భవేత్ కిన్తు సమ్పూర్ణం వేతనమస్మాభి ర్లభ్యేత తదర్థం స్వానధి సావధానా భవతః|</para>
  <para style="p">
    <verse number="9" style="v"/>యః కశ్చిద్ విపథగామీ భూత్వా ఖ్రీష్టస్య శిక్షాయాం న తిష్ఠతి స ఈశ్వరం న ధారయతి ఖ్రీష్టస్య శిజ్ఞాయాం యస్తిష్ఠతి స పితరం పుత్రఞ్చ ధారయతి|</para>
  <para style="p">
    <verse number="10" style="v"/>యః కశ్చిద్ యుష్మత్సన్నిధిమాగచ్ఛన్ శిక్షామేనాం నానయతి స యుష్మాభిః స్వవేశ్మని న గృహ్యతాం తవ మఙ్గలం భూయాదితి వాగపి తస్మై న కథ్యతాం|</para>
  <para style="p">
    <verse number="11" style="v"/>యతస్తవ మఙ్గలం భూయాదితి వాచం యః కశ్చిత్ తస్మై కథయతి స తస్య దుష్కర్మ్మణామ్ అంశీ భవతి|</para>
  <para style="p">
    <verse number="12" style="v"/>యుష్మాన్ ప్రతి మయా బహూని లేఖితవ్యాని కిన్తు పత్రమసీభ్యాం తత్ కర్త్తుం నేచ్ఛామి, యతో ఽస్మాకమ్ ఆనన్దో యథా సమ్పూర్ణో భవిష్యతి తథా యుష్మత్సమీపముపస్థాయాహం సమ్ముఖీభూయ యుష్మాభిః సమ్భాషిష్య ఇతి ప్రత్యాశా మమాస్తే|</para>
  <para style="p">
    <verse number="13" style="v"/>తవాభిరుచితాయా భగిన్యా బాలకాస్త్వాం నమస్కారం జ్ఞాపయన్తి| ఆమేన్|</para>
</usx>
