<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="2TI" style="id">Sanskrit Bible (NT) in Telugu Script (సత్యవేదః।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">2 Timothy</para>
  <para style="toc1">2 తీమథియం పత్రం</para>
  <para style="toc2">2 తీమథియః</para>
  <para style="toc3">2 తీమథియః</para>
  <para style="mt1">2 తీమథియం పత్రం</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ఖ్రీష్టేన యీశునా యా జీవనస్య ప్రతిజ్ఞా తామధీశ్వరస్యేచ్ఛయా యీశోః ఖ్రీష్టస్యైకః ప్రేరితః పౌలోఽహం స్వకీయం ప్రియం ధర్మ్మపుత్రం తీమథియం ప్రతి పత్రం లిఖామి|</para>
  <para style="p">
    <verse number="2" style="v"/>తాత ఈశ్వరోఽస్మాకం ప్రభు ర్యీశుఖ్రీష్టశ్చ త్వయి ప్రసాదం దయాం శాన్తిఞ్చ క్రియాస్తాం|</para>
  <para style="p">
    <verse number="3" style="v"/>అహమ్ ఆ పూర్వ్వపురుషాత్ యమ్ ఈశ్వరం పవిత్రమనసా సేవే తం ధన్యం వదనం కథయామి, అహమ్ అహోరాత్రం ప్రార్థనాసమయే త్వాం నిరన్తరం స్మరామి|</para>
  <para style="p">
    <verse number="4" style="v"/>యశ్చ విశ్వాసః ప్రథమే లోయీనామికాయాం తవ మాతామహ్యామ్ ఉనీకీనామికాయాం మాతరి చాతిష్ఠత్ తవాన్తరేఽపి తిష్ఠతీతి మన్యే</para>
  <para style="p">
    <verse number="5" style="v"/>తవ తం నిష్కపటం విశ్వాసం మనసి కుర్వ్వన్ తవాశ్రుపాతం స్మరన్ యథానన్దేన ప్రఫల్లో భవేయం తదర్థం తవ దర్శనమ్ ఆకాఙ్క్షే|</para>
  <para style="p">
    <verse number="6" style="v"/>అతో హేతో ర్మమ హస్తార్పణేన లబ్ధో య ఈశ్వరస్య వరస్త్వయి విద్యతే తమ్ ఉజ్జ్వాలయితుం త్వాం స్మారయామి|</para>
  <para style="p">
    <verse number="7" style="v"/>యత ఈశ్వరోఽస్మభ్యం భయజనకమ్ ఆత్మానమ్ అదత్త్వా శక్తిప్రేమసతర్కతానామ్ ఆకరమ్ ఆత్మానం దత్తవాన్|</para>
  <para style="p">
    <verse number="8" style="v"/>అతఏవాస్మాకం ప్రభుమధి తస్య వన్దిదాసం మామధి చ ప్రమాణం దాతుం న త్రపస్వ కిన్త్వీశ్వరీయశక్త్యా సుసంవాదస్య కృతే దుఃఖస్య సహభాగీ భవ|</para>
  <para style="p">
    <verse number="9" style="v"/>సోఽస్మాన్ పరిత్రాణపాత్రాణి కృతవాన్ పవిత్రేణాహ్వానేనాహూతవాంశ్చ; అస్మత్కర్మ్మహేతునేతి నహి స్వీయనిరూపాణస్య ప్రసాదస్య చ కృతే తత్ కృతవాన్| స ప్రసాదః సృష్టేః పూర్వ్వకాలే ఖ్రీష్టేన యీశునాస్మభ్యమ్ అదాయి,</para>
  <para style="p">
    <verse number="10" style="v"/>కిన్త్వధునాస్మాకం పరిత్రాతు ర్యీశోః ఖ్రీష్టస్యాగమనేన ప్రాకాశత| ఖ్రీష్టో మృత్యుం పరాజితవాన్ సుసంవాదేన చ జీవనమ్ అమరతాఞ్చ ప్రకాశితవాన్|</para>
  <para style="p">
    <verse number="11" style="v"/>తస్య ఘోషయితా దూతశ్చాన్యజాతీయానాం శిక్షకశ్చాహం నియుక్తోఽస్మి|</para>
  <para style="p">
    <verse number="12" style="v"/>తస్మాత్ కారణాత్ మమాయం క్లేశో భవతి తేన మమ లజ్జా న జాయతే యతోఽహం యస్మిన్ విశ్వసితవాన్ తమవగతోఽస్మి మహాదినం యావత్ మమోపనిధే ర్గోపనస్య శక్తిస్తస్య విద్యత ఇతి నిశ్చితం జానామి|</para>
  <para style="p">
    <verse number="13" style="v"/>హితదాయకానాం వాక్యానామ్ ఆదర్శరూపేణ మత్తః శ్రుతాః ఖ్రీష్టే యీశౌ విశ్వాసప్రేమ్నోః కథా ధారయ|</para>
  <para style="p">
    <verse number="14" style="v"/>అపరమ్ అస్మదన్తర్వాసినా పవిత్రేణాత్మనా తాముత్తమామ్ ఉపనిధిం గోపయ|</para>
  <para style="p">
    <verse number="15" style="v"/>ఆశియాదేశీయాః సర్వ్వే మాం త్యక్తవన్త ఇతి త్వం జానాసి తేషాం మధ్యే ఫూగిల్లో హర్మ్మగినిశ్చ విద్యేతే|</para>
  <para style="p">
    <verse number="16" style="v"/>ప్రభురనీషిఫరస్య పరివారాన్ ప్రతి కృపాం విదధాతు యతః స పునః పున ర్మామ్ ఆప్యాయితవాన్</para>
  <para style="p">
    <verse number="17" style="v"/>మమ శృఙ్ఖలేన న త్రపిత్వా రోమానగరే ఉపస్థితిసమయే యత్నేన మాం మృగయిత్వా మమోద్దేశం ప్రాప్తవాన్|</para>
  <para style="p">
    <verse number="18" style="v"/>అతో విచారదినే స యథా ప్రభోః కృపాభాజనం భవేత్ తాదృశం వరం ప్రభుస్తస్మై దేయాత్| ఇఫిషనగరేఽపి స కతి ప్రకారై ర్మామ్ ఉపకృతవాన్ తత్ త్వం సమ్యగ్ వేత్సి|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>హే మమ పుత్ర, ఖ్రీష్టయీశుతో యోఽనుగ్రహస్తస్య బలేన త్వం బలవాన్ భవ|</para>
  <para style="p">
    <verse number="2" style="v"/>అపరం బహుభిః సాక్షిభిః ప్రమాణీకృతాం యాం శిక్షాం శ్రుతవానసి తాం విశ్వాస్యేషు పరస్మై శిక్షాదానే నిపుణేషు చ లోకేషు సమర్పయ|</para>
  <para style="p">
    <verse number="3" style="v"/>త్వం యీశుఖ్రీష్టస్యోత్తమో యోద్ధేవ క్లేశం సహస్వ|</para>
  <para style="p">
    <verse number="4" style="v"/>యో యుద్ధం కరోతి స సాంసారికే వ్యాపారే మగ్నో న భవతి కిన్తు స్వనియోజయిత్రే రోచితుం చేష్టతే|</para>
  <para style="p">
    <verse number="5" style="v"/>అపరం యో మల్లై ర్యుధ్యతి స యది నియమానుసారేణ న యుద్ధ్యతి తర్హి కిరీటం న లప్స్యతే|</para>
  <para style="p">
    <verse number="6" style="v"/>అపరం యః కృషీవలః కర్మ్మ కరోతి తేన ప్రథమేన ఫలభాగినా భవితవ్యం|</para>
  <para style="p">
    <verse number="7" style="v"/>మయా యదుచ్యతే తత్ త్వయా బుధ్యతాం యతః ప్రభుస్తుభ్యం సర్వ్వత్ర బుద్ధిం దాస్యతి|</para>
  <para style="p">
    <verse number="8" style="v"/>మమ సుసంవాదస్య వచనానుసారాద్ దాయూద్వంశీయం మృతగణమధ్యాద్ ఉత్థాపితఞ్చ యీశుం ఖ్రీష్టం స్మర|</para>
  <para style="p">
    <verse number="9" style="v"/>తత్సుసంవాదకారణాద్ అహం దుష్కర్మ్మేవ బన్ధనదశాపర్య్యన్తం క్లేశం భుఞ్జే కిన్త్వీశ్వరస్య వాక్యమ్ అబద్ధం తిష్ఠతి|</para>
  <para style="p">
    <verse number="10" style="v"/>ఖ్రీష్టేన యీశునా యద్ అనన్తగౌరవసహితం పరిత్రాణం జాయతే తదభిరుచితై ర్లోకైరపి యత్ లభ్యేత తదర్థమహం తేషాం నిమిత్తం సర్వ్వాణ్యేతాని సహే|</para>
  <para style="p">
    <verse number="11" style="v"/>అపరమ్ ఏషా భారతీ సత్యా యది వయం తేన సార్ద్ధం మ్రియామహే తర్హి తేన సార్ద్ధం జీవివ్యామః, యది చ క్లేశం సహామహే తర్హి తేన సార్ద్ధం రాజత్వమపి కరిష్యామహే|</para>
  <para style="p">
    <verse number="12" style="v"/>యది వయం తమ్ అనఙ్గీకుర్మ్మస్తర్హి సో ఽస్మానప్యనఙ్గీకరిష్యతి|</para>
  <para style="p">
    <verse number="13" style="v"/>యది వయం న విశ్వాసామస్తర్హి స విశ్వాస్యస్తిష్ఠతి యతః స్వమ్ అపహ్నోతుం న శక్నోతి|</para>
  <para style="p">
    <verse number="14" style="v"/>త్వమేతాని స్మారయన్ తే యథా నిష్ఫలం శ్రోతృణాం భ్రంశజనకం వాగ్యుద్ధం న కుర్య్యస్తథా ప్రభోః సమక్షం దృఢం వినీయాదిశ|</para>
  <para style="p">
    <verse number="15" style="v"/>అపరం త్వమ్ ఈశ్వరస్య సాక్షాత్ స్వం పరీక్షితమ్ అనిన్దనీయకర్మ్మకారిణఞ్చ సత్యమతస్య వాక్యానాం సద్విభజనే నిపుణఞ్చ దర్శయితుం యతస్వ|</para>
  <para style="p">
    <verse number="16" style="v"/>కిన్త్వపవిత్రా అనర్థకకథా దూరీకురు యతస్తదాలమ్బిన ఉత్తరోత్తరమ్ అధర్మ్మే వర్ద్ధిష్యన్తే,</para>
  <para style="p">
    <verse number="17" style="v"/>తేషాఞ్చ వాక్యం గలితక్షతవత్ క్షయవర్ద్ధకో భవిష్యతి తేషాం మధ్యే హుమినాయః ఫిలీతశ్చేతినామానౌ ద్వౌ జనౌ సత్యమతాద్ భ్రష్టౌ జాతౌ,</para>
  <para style="p">
    <verse number="18" style="v"/>మృతానాం పునరుత్థితి ర్వ్యతీతేతి వదన్తౌ కేషాఞ్చిద్ విశ్వాసమ్ ఉత్పాటయతశ్చ|</para>
  <para style="p">
    <verse number="19" style="v"/>తథాపీశ్వరస్య భిత్తిమూలమ్ అచలం తిష్ఠతి తస్మింశ్చేయం లిపి ర్ముద్రాఙ్కితా విద్యతే| యథా, జానాతి పరమేశస్తు స్వకీయాన్ సర్వ్వమానవాన్| అపగచ్ఛేద్ అధర్మ్మాచ్చ యః కశ్చిత్ ఖ్రీష్టనామకృత్||</para>
  <para style="p">
    <verse number="20" style="v"/>కిన్తు బృహన్నికేతనే కేవల సువర్ణమయాని రౌప్యమయాణి చ భాజనాని విద్యన్త ఇతి తర్హి కాష్ఠమయాని మృణ్మయాన్యపి విద్యన్తే తేషాఞ్చ కియన్తి సమ్మానాయ కియన్తపమానాయ చ భవన్తి|</para>
  <para style="p">
    <verse number="21" style="v"/>అతో యది కశ్చిద్ ఏతాదృశేభ్యః స్వం పరిష్కరోతి తర్హి స పావితం ప్రభోః కార్య్యయోగ్యం సర్వ్వసత్కార్య్యాయోపయుక్తం సమ్మానార్థకఞ్చ భాజనం భవిష్యతి|</para>
  <para style="p">
    <verse number="22" style="v"/>యౌవనావస్థాయా అభిలాషాస్త్వయా పరిత్యజ్యన్తాం ధర్మ్మో విశ్వాసః ప్రేమ యే చ శుచిమనోభిః ప్రభుమ్ ఉద్దిశ్య ప్రార్థనాం కుర్వ్వతే తైః సార్ద్ధమ్ ఐక్యభావశ్చైతేషు త్వయా యత్నో విధీయతాం|</para>
  <para style="p">
    <verse number="23" style="v"/>అపరం త్వమ్ అనర్థకాన్ అజ్ఞానాంశ్చ ప్రశ్నాన్ వాగ్యుద్ధోత్పాదకాన్ జ్ఞాత్వా దూరీకురు|</para>
  <para style="p">
    <verse number="24" style="v"/>యతః ప్రభో ర్దాసేన యుద్ధమ్ అకర్త్తవ్యం కిన్తు సర్వ్వాన్ ప్రతి శాన్తేన శిక్షాదానేచ్ఛుకేన సహిష్ణునా చ భవితవ్యం, విపక్షాశ్చ తేన నమ్రత్వేన చేతితవ్యాః|</para>
  <para style="p">
    <verse number="25" style="v"/>తథా కృతే యదీశ్వరః సత్యమతస్య జ్ఞానార్థం తేభ్యో మనఃపరివర్త్తనరూపం వరం దద్యాత్,</para>
  <para style="p">
    <verse number="26" style="v"/>తర్హి తే యేన శయతానేన నిజాభిలాషసాధనాయ ధృతాస్తస్య జాలాత్ చేతనాం ప్రాప్యోద్ధారం లబ్ధుం శక్ష్యన్తి|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>చరమదినేషు క్లేశజనకాః సమయా ఉపస్థాస్యన్తీతి జానీహి|</para>
  <para style="p">
    <verse number="2" style="v"/>యతస్తాత్కాలికా లోకా ఆత్మప్రేమిణో ఽర్థప్రేమిణ ఆత్మశ్లాఘినో ఽభిమానినో నిన్దకాః పిత్రోరనాజ్ఞాగ్రాహిణః కృతఘ్నా అపవిత్రాః</para>
  <para style="p">
    <verse number="3" style="v"/>ప్రీతివర్జితా అసన్ధేయా మృషాపవాదినో ఽజితేన్ద్రియాః ప్రచణ్డా భద్రద్వేషిణో</para>
  <para style="p">
    <verse number="4" style="v"/>విశ్వాసఘాతకా దుఃసాహసినో దర్పధ్మాతా ఈశ్వరాప్రేమిణః కిన్తు సుఖప్రేమిణో</para>
  <para style="p">
    <verse number="5" style="v"/>భక్తవేశాః కిన్త్వస్వీకృతభక్తిగుణా భవిష్యన్తి; ఏతాదృశానాం లోకానాం సంమర్గం పరిత్యజ|</para>
  <para style="p">
    <verse number="6" style="v"/>యతో యే జనాః ప్రచ్ఛన్నం గేహాన్ ప్రవిశన్తి పాపై ర్భారగ్రస్తా నానావిధాభిలాషైశ్చాలితా యాః కామిన్యో</para>
  <para style="p">
    <verse number="7" style="v"/>నిత్యం శిక్షన్తే కిన్తు సత్యమతస్య తత్త్వజ్ఞానం ప్రాప్తుం కదాచిత్ న శక్నువన్తి తా దాసీవద్ వశీకుర్వ్వతే చ తే తాదృశా లోకాః|</para>
  <para style="p">
    <verse number="8" style="v"/>యాన్ని ర్యామ్బ్రిశ్చ యథా మూసమం ప్రతి విపక్షత్వమ్ అకురుతాం తథైవ భ్రష్టమనసో విశ్వాసవిషయే ఽగ్రాహ్యాశ్చైతే లోకా అపి సత్యమతం ప్రతి విపక్షతాం కుర్వ్వన్తి|</para>
  <para style="p">
    <verse number="9" style="v"/>కిన్తు తే బహుదూరమ్ అగ్రసరా న భవిష్యన్తి యతస్తయో ర్మూఢతా యద్వత్ తద్వద్ ఏతేషామపి మూఢతా సర్వ్వదృశ్యా భవిష్యతి|</para>
  <para style="p">
    <verse number="10" style="v"/>మమోపదేశః శిష్టతాభిప్రాయో విశ్వాసో ర్ధర్య్యం ప్రేమ సహిష్ణుతోపద్రవః క్లేశా</para>
  <para style="p">
    <verse number="11" style="v"/>ఆన్తియఖియాయామ్ ఇకనియే లూస్త్రాయాఞ్చ మాం ప్రతి యద్యద్ అఘటత యాంశ్చోపద్రవాన్ అహమ్ అసహే సర్వ్వమేతత్ త్వమ్ అవగతోఽసి కిన్తు తత్సర్వ్వతః ప్రభు ర్మామ్ ఉద్ధృతవాన్|</para>
  <para style="p">
    <verse number="12" style="v"/>పరన్తు యావన్తో లోకాః ఖ్రీష్టేన యీశునేశ్వరభక్తిమ్ ఆచరితుమ్ ఇచ్ఛన్తి తేషాం సర్వ్వేషామ్ ఉపద్రవో భవిష్యతి|</para>
  <para style="p">
    <verse number="13" style="v"/>అపరం పాపిష్ఠాః ఖలాశ్చ లోకా భ్రామ్యన్తో భ్రమయన్తశ్చోత్తరోత్తరం దుష్టత్వేన వర్ద్ధిష్యన్తే|</para>
  <para style="p">
    <verse number="14" style="v"/>కిన్తు త్వం యద్ యద్ అశిక్షథాః, యచ్చ త్వయి సమర్పితమ్ అభూత్ తస్మిన్ అవతిష్ఠ, యతః కస్మాత్ శిక్షాం ప్రాప్తోఽసి తద్ వేత్సి;</para>
  <para style="p">
    <verse number="15" style="v"/>యాని చ ధర్మ్మశాస్త్రాణి ఖ్రీష్టే యీశౌ విశ్వాసేన పరిత్రాణప్రాప్తయే త్వాం జ్ఞానినం కర్త్తుం శక్నువన్తి తాని త్వం శైశవకాలాద్ అవగతోఽసి|</para>
  <para style="p">
    <verse number="16" style="v"/>తత్ సర్వ్వం శాస్త్రమ్ ఈశ్వరస్యాత్మనా దత్తం శిక్షాయై దోషబోధాయ శోధనాయ ధర్మ్మవినయాయ చ ఫలయూక్తం భవతి</para>
  <para style="p">
    <verse number="17" style="v"/>తేన చేశ్వరస్య లోకో నిపుణః సర్వ్వస్మై సత్కర్మ్మణే సుసజ్జశ్చ భవతి|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ఈశ్వరస్య గోచరే యశ్చ యీశుః ఖ్రీష్టః స్వీయాగమనకాలే స్వరాజత్వేన జీవతాం మృతానాఞ్చ లోకానాం విచారం కరిష్యతి తస్య గోచరే ఽహం త్వామ్ ఇదం దృఢమ్ ఆజ్ఞాపయామి|</para>
  <para style="p">
    <verse number="2" style="v"/>త్వం వాక్యం ఘోషయ కాలేఽకాలే చోత్సుకో భవ పూర్ణయా సహిష్ణుతయా శిక్షయా చ లోకాన్ ప్రబోధయ భర్త్సయ వినయస్వ చ|</para>
  <para style="p">
    <verse number="3" style="v"/>యత ఏతాదృశః సమయ ఆయాతి యస్మిన్ లోకా యథార్థమ్ ఉపదేశమ్ అసహ్యమానాః కర్ణకణ్డూయనవిశిష్టా భూత్వా నిజాభిలాషాత్ శిక్షకాన్ సంగ్రహీష్యన్తి</para>
  <para style="p">
    <verse number="4" style="v"/>సత్యమతాచ్చ శ్రోత్రాణి నివర్త్త్య విపథగామినో భూత్వోపాఖ్యానేషు ప్రవర్త్తిష్యన్తే;</para>
  <para style="p">
    <verse number="5" style="v"/>కిన్తు త్వం సర్వ్వవిషయే ప్రబుద్ధో భవ దుఃఖభోగం స్వీకురు సుసంవాదప్రచారకస్య కర్మ్మ సాధయ నిజపరిచర్య్యాం పూర్ణత్వేన కురు చ|</para>
  <para style="p">
    <verse number="6" style="v"/>మమ ప్రాణానామ్ ఉత్సర్గో భవతి మమ ప్రస్థానకాలశ్చోపాతిష్ఠత్|</para>
  <para style="p">
    <verse number="7" style="v"/>అహమ్ ఉత్తమయుద్ధం కృతవాన్ గన్తవ్యమార్గస్యాన్తం యావద్ ధావితవాన్ విశ్వాసఞ్చ రక్షితవాన్|</para>
  <para style="p">
    <verse number="8" style="v"/>శేషం పుణ్యముకుటం మదర్థం రక్షితం విద్యతే తచ్చ తస్మిన్ మహాదినే యథార్థవిచారకేణ ప్రభునా మహ్యం దాయిష్యతే కేవలం మహ్యమ్ ఇతి నహి కిన్తు యావన్తో లోకాస్తస్యాగమనమ్ ఆకాఙ్క్షన్తే తేభ్యః సర్వ్వేభ్యో ఽపి దాయిష్యతే|</para>
  <para style="p">
    <verse number="9" style="v"/>త్వం త్వరయా మత్సమీపమ్ ఆగన్తుం యతస్వ,</para>
  <para style="p">
    <verse number="10" style="v"/>యతో దీమా ఐహికసంసారమ్ ఈహమానో మాం పరిత్యజ్య థిషలనీకీం గతవాన్ తథా క్రీష్కి ర్గాలాతియాం గతవాన్ తీతశ్చ దాల్మాతియాం గతవాన్|</para>
  <para style="p">
    <verse number="11" style="v"/>కేవలో లూకో మయా సార్ద్ధం విద్యతే| త్వం మార్కం సఙ్గినం కృత్వాగచ్ఛ యతః స పరిచర్య్యయా మమోపకారీ భవిష్యతి,</para>
  <para style="p">
    <verse number="12" style="v"/>తుఖికఞ్చాహమ్ ఇఫిషనగరం ప్రేషితవాన్|</para>
  <para style="p">
    <verse number="13" style="v"/>యద్ ఆచ్ఛాదనవస్త్రం త్రోయానగరే కార్పస్య సన్నిధౌ మయా నిక్షిప్తం త్వమాగమనసమయే తత్ పుస్తకాని చ విశేషతశ్చర్మ్మగ్రన్థాన్ ఆనయ|</para>
  <para style="p">
    <verse number="14" style="v"/>కాంస్యకారః సికన్దరో మమ బహ్వనిష్టం కృతవాన్ ప్రభుస్తస్య కర్మ్మణాం సముచితఫలం దదాతు|</para>
  <para style="p">
    <verse number="15" style="v"/>త్వమపి తస్మాత్ సావధానాస్తిష్ఠ యతః సోఽస్మాకం వాక్యానామ్ అతీవ విపక్షో జాతః|</para>
  <para style="p">
    <verse number="16" style="v"/>మమ ప్రథమప్రత్యుత్తరసమయే కోఽపి మమ సహాయో నాభవత్ సర్వ్వే మాం పర్య్యత్యజన్ తాన్ ప్రతి తస్య దోషస్య గణనా న భూయాత్;</para>
  <para style="p">
    <verse number="17" style="v"/>కిన్తు ప్రభు ర్మమ సహాయో ఽభవత్ యథా చ మయా ఘోషణా సాధ్యేత భిన్నజాతీయాశ్చ సర్వ్వే సుసంవాదం శృణుయుస్తథా మహ్యం శక్తిమ్ అదదాత్ తతో ఽహం సింహస్య ముఖాద్ ఉద్ధృతః|</para>
  <para style="p">
    <verse number="18" style="v"/>అపరం సర్వ్వస్మాద్ దుష్కర్మ్మతః ప్రభు ర్మామ్ ఉద్ధరిష్యతి నిజస్వర్గీయరాజ్యం నేతుం మాం తారయిష్యతి చ| తస్య ధన్యవాదః సదాకాలం భూయాత్| ఆమేన్|</para>
  <para style="p">
    <verse number="19" style="v"/>త్వం ప్రిష్కామ్ ఆక్కిలమ్ అనీషిఫరస్య పరిజనాంశ్చ నమస్కురు|</para>
  <para style="p">
    <verse number="20" style="v"/>ఇరాస్తః కరిన్థనగరే ఽతిష్ఠత్ త్రఫిమశ్చ పీడితత్వాత్ మిలీతనగరే మయా వ్యహీయత|</para>
  <para style="p">
    <verse number="21" style="v"/>త్వం హేమన్తకాలాత్ పూర్వ్వమ్ ఆగన్తుం యతస్వ| ఉబూలః పూది ర్లీనః క్లౌదియా సర్వ్వే భ్రాతరశ్చ త్వాం నమస్కుర్వ్వతే|</para>
  <para style="p">
    <verse number="22" style="v"/>ప్రభు ర్యీశుః ఖ్రీష్టస్తవాత్మనా సహ భూయాత్| యుష్మాస్వనుగ్రహో భూయాత్| ఆమేన్|</para>
</usx>
