<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="1TI" style="id">Sanskrit Bible (NT) in Telugu Script (సత్యవేదః।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">1 Timothy</para>
  <para style="toc1">1 తీమథియం పత్రం</para>
  <para style="toc2">1 తీమథియః</para>
  <para style="toc3">1 తీమథియః</para>
  <para style="mt1">1 తీమథియం పత్రం</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అస్మాకం త్రాణకర్త్తురీశ్వరస్యాస్మాకం ప్రత్యాశాభూమేః ప్రభో ర్యీశుఖ్రీష్టస్య చాజ్ఞానుసారతో యీశుఖ్రీష్టస్య ప్రేరితః పౌలః స్వకీయం సత్యం ధర్మ్మపుత్రం తీమథియం ప్రతి పత్రం లిఖతి|</para>
  <para style="p">
    <verse number="2" style="v"/>అస్మాకం తాత ఈశ్వరోఽస్మాకం ప్రభు ర్యీశుఖ్రీష్టశ్చ త్వయి అనుగ్రహం దయాం శాన్తిఞ్చ కుర్య్యాస్తాం|</para>
  <para style="p">
    <verse number="3" style="v"/>మాకిదనియాదేశే మమ గమనకాలే త్వమ్ ఇఫిషనగరే తిష్ఠన్ ఇతరశిక్షా న గ్రహీతవ్యా, అనన్తేషూపాఖ్యానేషు వంశావలిషు చ యుష్మాభి ర్మనో న నివేశితవ్యమ్</para>
  <para style="p">
    <verse number="4" style="v"/>ఇతి కాంశ్చిత్ లోకాన్ యద్ ఉపదిశేరేతత్ మయాదిష్టోఽభవః, యతః సర్వ్వైరేతై ర్విశ్వాసయుక్తేశ్వరీయనిష్ఠా న జాయతే కిన్తు వివాదో జాయతే|</para>
  <para style="p">
    <verse number="5" style="v"/>ఉపదేశస్య త్వభిప్రేతం ఫలం నిర్మ్మలాన్తఃకరణేన సత్సంవేదేన నిష్కపటవిశ్వాసేన చ యుక్తం ప్రేమ|</para>
  <para style="p">
    <verse number="6" style="v"/>కేచిత్ జనాశ్చ సర్వ్వాణ్యేతాని విహాయ నిరర్థకకథానామ్ అనుగమనేన విపథగామినోఽభవన్,</para>
  <para style="p">
    <verse number="7" style="v"/>యద్ భాషన్తే యచ్చ నిశ్చిన్వన్తి తన్న బుధ్యమానా వ్యవస్థోపదేష్టారో భవితుమ్ ఇచ్ఛన్తి|</para>
  <para style="p">
    <verse number="8" style="v"/>సా వ్యవస్థా యది యోగ్యరూపేణ గృహ్యతే తర్హ్యుత్తమా భవతీతి వయం జానీమః|</para>
  <para style="p">
    <verse number="9" style="v"/>అపరం సా వ్యవస్థా ధార్మ్మికస్య విరుద్ధా న భవతి కిన్త్వధార్మ్మికో ఽవాధ్యో దుష్టః పాపిష్ఠో ఽపవిత్రో ఽశుచిః పితృహన్తా మాతృహన్తా నరహన్తా</para>
  <para style="p">
    <verse number="10" style="v"/>వేశ్యాగామీ పుంమైథునీ మనుష్యవిక్రేతా మిథ్యావాదీ మిథ్యాశపథకారీ చ సర్వ్వేషామేతేషాం విరుద్ధా,</para>
  <para style="p">
    <verse number="11" style="v"/>తథా సచ్చిదానన్దేశ్వరస్య యో విభవయుక్తః సుసంవాదో మయి సమర్పితస్తదనుయాయిహితోపదేశస్య విపరీతం యత్ కిఞ్చిద్ భవతి తద్విరుద్ధా సా వ్యవస్థేతి తద్గ్రాహిణా జ్ఞాతవ్యం|</para>
  <para style="p">
    <verse number="12" style="v"/>మహ్యం శక్తిదాతా యోఽస్మాకం ప్రభుః ఖ్రీష్టయీశుస్తమహం ధన్యం వదామి|</para>
  <para style="p">
    <verse number="13" style="v"/>యతః పురా నిన్దక ఉపద్రావీ హింసకశ్చ భూత్వాప్యహం తేన విశ్వాస్యో ఽమన్యే పరిచారకత్వే న్యయుజ్యే చ| తద్ అవిశ్వాసాచరణమ్ అజ్ఞానేన మయా కృతమితి హేతోరహం తేనానుకమ్పితోఽభవం|</para>
  <para style="p">
    <verse number="14" style="v"/>అపరం ఖ్రీష్టే యీశౌ విశ్వాసప్రేమభ్యాం సహితోఽస్మత్ప్రభోరనుగ్రహో ఽతీవ ప్రచురోఽభత్|</para>
  <para style="p">
    <verse number="15" style="v"/>పాపినః పరిత్రాతుం ఖ్రీష్టో యీశు ర్జగతి సమవతీర్ణోఽభవత్, ఏషా కథా విశ్వాసనీయా సర్వ్వై గ్రహణీయా చ|</para>
  <para style="p">
    <verse number="16" style="v"/>తేషాం పాపినాం మధ్యేఽహం ప్రథమ ఆసం కిన్తు యే మానవా అనన్తజీవనప్రాప్త్యర్థం తస్మిన్ విశ్వసిష్యన్తి తేషాం దృష్టాన్తే మయి ప్రథమే యీశునా ఖ్రీష్టేన స్వకీయా కృత్స్నా చిరసహిష్ణుతా యత్ ప్రకాశ్యతే తదర్థమేవాహమ్ అనుకమ్పాం ప్రాప్తవాన్|</para>
  <para style="p">
    <verse number="17" style="v"/>అనాదిరక్షయోఽదృశ్యో రాజా యోఽద్వితీయః సర్వ్వజ్ఞ ఈశ్వరస్తస్య గౌరవం మహిమా చానన్తకాలం యావద్ భూయాత్| ఆమేన్|</para>
  <para style="p">
    <verse number="18" style="v"/>హే పుత్ర తీమథియ త్వయి యాని భవిష్యద్వాక్యాని పురా కథితాని తదనుసారాద్ అహమ్ ఏనమాదేశం త్వయి సమర్పయామి, తస్యాభిప్రాయోఽయం యత్త్వం తై ర్వాక్యైరుత్తమయుద్ధం కరోషి</para>
  <para style="p">
    <verse number="19" style="v"/>విశ్వాసం సత్సంవేదఞ్చ ధారయసి చ| అనయోః పరిత్యాగాత్ కేషాఞ్చిద్ విశ్వాసతరీ భగ్నాభవత్|</para>
  <para style="p">
    <verse number="20" style="v"/>హుమినాయసికన్దరౌ తేషాం యౌ ద్వౌ జనౌ, తౌ యద్ ధర్మ్మనిన్దాం పున ర్న కర్త్తుం శిక్షేతే తదర్థం మయా శయతానస్య కరే సమర్పితౌ|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>మమ ప్రథమ ఆదేశోఽయం, ప్రార్థనావినయనివేదనధన్యవాదాః కర్త్తవ్యాః,</para>
  <para style="p">
    <verse number="2" style="v"/>సర్వ్వేషాం మానవానాం కృతే విశేషతో వయం యత్ శాన్తత్వేన నిర్వ్విరోధత్వేన చేశ్చరభక్తిం వినీతత్వఞ్చాచరన్తః కాలం యాపయామస్తదర్థం నృపతీనామ్ ఉచ్చపదస్థానాఞ్చ కృతే తే కర్త్తవ్యాః|</para>
  <para style="p">
    <verse number="3" style="v"/>యతోఽస్మాకం తారకస్యేశ్వరస్య సాక్షాత్ తదేవోత్తమం గ్రాహ్యఞ్చ భవతి,</para>
  <para style="p">
    <verse number="4" style="v"/>స సర్వ్వేషాం మానవానాం పరిత్రాణం సత్యజ్ఞానప్రాప్తిఞ్చేచ్ఛతి|</para>
  <para style="p">
    <verse number="5" style="v"/>యత ఏకోఽద్వితీయ ఈశ్వరో విద్యతే కిఞ్చేశ్వరే మానవేషు చైకో ఽద్వితీయో మధ్యస్థః</para>
  <para style="p">
    <verse number="6" style="v"/>స నరావతారః ఖ్రీష్టో యీశు ర్విద్యతే యః సర్వ్వేషాం ముక్తే ర్మూల్యమ్ ఆత్మదానం కృతవాన్| ఏతేన యేన ప్రమాణేనోపయుక్తే సమయే ప్రకాశితవ్యం,</para>
  <para style="p">
    <verse number="7" style="v"/>తద్ఘోషయితా దూతో విశ్వాసే సత్యధర్మ్మే చ భిన్నజాతీయానామ్ ఉపదేశకశ్చాహం న్యయూజ్యే, ఏతదహం ఖ్రీష్టస్య నామ్నా యథాతథ్యం వదామి నానృతం కథయామి|</para>
  <para style="p">
    <verse number="8" style="v"/>అతో మమాభిమతమిదం పురుషైః క్రోధసన్దేహౌ వినా పవిత్రకరాన్ ఉత్తోల్య సర్వ్వస్మిన్ స్థానే ప్రార్థనా క్రియతాం|</para>
  <para style="p">
    <verse number="9" style="v"/>తద్వత్ నార్య్యోఽపి సలజ్జాః సంయతమనసశ్చ సత్యో యోగ్యమాచ్ఛాదనం పరిదధతు కిఞ్చ కేశసంస్కారైః కణకముక్తాభి ర్మహార్ఘ్యపరిచ్ఛదైశ్చాత్మభూషణం న కుర్వ్వత్యః</para>
  <para style="p">
    <verse number="10" style="v"/>స్వీకృతేశ్వరభక్తీనాం యోషితాం యోగ్యైః సత్యర్మ్మభిః స్వభూషణం కుర్వ్వతాం|</para>
  <para style="p">
    <verse number="11" style="v"/>నారీ సమ్పూర్ణవినీతత్వేన నిర్విరోధం శిక్షతాం|</para>
  <para style="p">
    <verse number="12" style="v"/>నార్య్యాః శిక్షాదానం పురుషాయాజ్ఞాదానం వాహం నానుజానామి తయా నిర్వ్విరోेధత్వమ్ ఆచరితవ్యం|</para>
  <para style="p">
    <verse number="13" style="v"/>యతః ప్రథమమ్ ఆదమస్తతః పరం హవాయాః సృష్టి ర్బభూవ|</para>
  <para style="p">
    <verse number="14" style="v"/>కిఞ్చాదమ్ భ్రాన్తియుక్తో నాభవత్ యోషిదేవ భ్రాన్తియుక్తా భూత్వాత్యాచారిణీ బభూవ|</para>
  <para style="p">
    <verse number="15" style="v"/>తథాపి నారీగణో యది విశ్వాసే ప్రేమ్ని పవిత్రతాయాం సంయతమనసి చ తిష్ఠతి తర్హ్యపత్యప్రసవవర్త్మనా పరిత్రాణం ప్రాప్స్యతి|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>యది కశ్చిద్ అధ్యక్షపదమ్ ఆకాఙ్క్షతే తర్హి స ఉత్తమం కర్మ్మ లిప్సత ఇతి సత్యం|</para>
  <para style="p">
    <verse number="2" style="v"/>అతోఽధ్యక్షేణానిన్దితేనైకస్యా యోషితో భర్త్రా పరిమితభోగేన సంయతమనసా సభ్యేనాతిథిసేవకేన శిక్షణే నిపుణేన</para>
  <para style="p">
    <verse number="3" style="v"/>న మద్యపేన న ప్రహారకేణ కిన్తు మృదుభావేన నిర్వ్వివాదేన నిర్లోభేన</para>
  <para style="p">
    <verse number="4" style="v"/>స్వపరివారాణామ్ ఉత్తమశాసకేన పూర్ణవినీతత్వాద్ వశ్యానాం సన్తానానాం నియన్త్రా చ భవితవ్యం|</para>
  <para style="p">
    <verse number="5" style="v"/>యత ఆత్మపరివారాన్ శాసితుం యో న శక్నోతి తేనేశ్వరస్య సమితేస్తత్త్వావధారణం కథం కారిష్యతే?</para>
  <para style="p">
    <verse number="6" style="v"/>అపరం స గర్వ్వితో భూత్వా యత్ శయతాన ఇవ దణ్డయోగ్యో న భవేత్ తదర్థం తేన నవశిష్యేణ న భవితవ్యం|</para>
  <para style="p">
    <verse number="7" style="v"/>యచ్చ నిన్దాయాం శయతానస్య జాలే చ న పతేత్ తదర్థం తేన బహిఃస్థలోకానామపి మధ్యే సుఖ్యాతియుక్తేన భవితవ్యం|</para>
  <para style="p">
    <verse number="8" style="v"/>తద్వత్ పరిచారకైరపి వినీతై ర్ద్వివిధవాక్యరహితై ర్బహుమద్యపానే ఽనాసక్తై ర్నిర్లోభైశ్చ భవితవ్యం,</para>
  <para style="p">
    <verse number="9" style="v"/>నిర్మ్మలసంవేదేన చ విశ్వాసస్య నిగూఢవాక్యం ధాతివ్యఞ్చ|</para>
  <para style="p">
    <verse number="10" style="v"/>అగ్రే తేషాం పరీక్షా క్రియతాం తతః పరమ్ అనిన్దితా భూత్వా తే పరిచర్య్యాం కుర్వ్వన్తు|</para>
  <para style="p">
    <verse number="11" style="v"/>అపరం యోషిద్భిరపి వినీతాభిరనపవాదికాభిః సతర్కాభిః సర్వ్వత్ర విశ్వాస్యాభిశ్చ భవితవ్యం|</para>
  <para style="p">
    <verse number="12" style="v"/>పరిచారకా ఏకైకయోషితో భర్త్తారో భవేయుః, నిజసన్తానానాం పరిజనానాఞ్చ సుశాసనం కుర్య్యుశ్చ|</para>
  <para style="p">
    <verse number="13" style="v"/>యతః సా పరిచర్య్యా యై ర్భద్రరూపేణ సాధ్యతే తే శ్రేష్ఠపదం ప్రాప్నువన్తి ఖ్రీష్టే యీశౌ విశ్వాసేన మహోత్సుకా భవన్తి చ|</para>
  <para style="p">
    <verse number="14" style="v"/>త్వాం ప్రత్యేతత్పత్రలేఖనసమయే శీఘ్రం త్వత్సమీపగమనస్య ప్రత్యాశా మమ విద్యతే|</para>
  <para style="p">
    <verse number="15" style="v"/>యది వా విలమ్బేయ తర్హీశ్వరస్య గృహే ఽర్థతః సత్యధర్మ్మస్య స్తమ్భభిత్తిమూలస్వరూపాయామ్ అమరేశ్వరస్య సమితౌ త్వయా కీదృశ ఆచారః కర్త్తవ్యస్తత్ జ్ఞాతుం శక్ష్యతే|</para>
  <para style="p">
    <verse number="16" style="v"/>అపరం యస్య మహత్త్వం సర్వ్వస్వీకృతమ్ ఈశ్వరభక్తేస్తత్ నిగూఢవాక్యమిదమ్ ఈశ్వరో మానవదేహే ప్రకాశిత ఆత్మనా సపుణ్యీకృతో దూతైః సన్దృష్టః సర్వ్వజాతీయానాం నికటే ఘోషితో జగతో విశ్వాసపాత్రీభూతస్తేజఃప్రాప్తయే స్వర్గం నీతశ్చేతి|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>పవిత్ర ఆత్మా స్పష్టమ్ ఇదం వాక్యం వదతి చరమకాలే కతిపయలోకా వహ్నినాఙ్కితత్వాత్</para>
  <para style="p">
    <verse number="2" style="v"/>కఠోరమనసాం కాపట్యాద్ అనృతవాదినాం వివాహనిషేధకానాం భక్ష్యవిశేషనిషేధకానాఞ్చ</para>
  <para style="p">
    <verse number="3" style="v"/>భూతస్వరూపాణాం శిక్షాయాం భ్రమకాత్మనాం వాక్యేషు చ మనాంసి నివేశ్య ధర్మ్మాద్ భ్రంశిష్యన్తే| తాని తు భక్ష్యాణి విశ్వాసినాం స్వీకృతసత్యధర్మ్మాణాఞ్చ ధన్యవాదసహితాయ భోగాయేశ్వరేణ ససృజిరే|</para>
  <para style="p">
    <verse number="4" style="v"/>యత ఈశ్వరేణ యద్యత్ సృష్టం తత్ సర్వ్వమ్ ఉత్తమం యది చ ధన్యవాదేన భుజ్యతే తర్హి తస్య కిమపి నాగ్రాహ్యం భవతి,</para>
  <para style="p">
    <verse number="5" style="v"/>యత ఈశ్వరస్య వాక్యేన ప్రార్థనయా చ తత్ పవిత్రీభవతి|</para>
  <para style="p">
    <verse number="6" style="v"/>ఏతాని వాక్యాని యది త్వం భ్రాతృన్ జ్ఞాపయేస్తర్హి యీశుఖ్రీష్టస్యోత్తమ్ః పరిచారకో భవిష్యసి యో విశ్వాసో హితోపదేశశ్చ త్వయా గృహీతస్తదీయవాక్యైరాప్యాయిష్యసే చ|</para>
  <para style="p">
    <verse number="7" style="v"/>యాన్యుపాఖ్యానాని దుర్భావాని వృద్ధయోషితామేవ యోగ్యాని చ తాని త్వయా విసృజ్యన్తామ్ ఈశ్వరభక్తయే యత్నః క్రియతాఞ్చ|</para>
  <para style="p">
    <verse number="8" style="v"/>యతః శారీరికో యత్నః స్వల్పఫలదో భవతి కిన్త్వీశ్వరభక్తిరైహికపారత్రికజీవనయోః ప్రతిజ్ఞాయుక్తా సతీ సర్వ్వత్ర ఫలదా భవతి|</para>
  <para style="p">
    <verse number="9" style="v"/>వాక్యమేతద్ విశ్వసనీయం సర్వ్వై ర్గ్రహణీయఞ్చ వయఞ్చ తదర్థమేవ శ్రామ్యామో నిన్దాం భుంజ్మహే చ|</para>
  <para style="p">
    <verse number="10" style="v"/>యతో హేతోః సర్వ్వమానవానాం విశేషతో విశ్వాసినాం త్రాతా యోఽమర ఈశ్వరస్తస్మిన్ వయం విశ్వసామః|</para>
  <para style="p">
    <verse number="11" style="v"/>త్వమ్ ఏతాని వాక్యాని ప్రచారయ సముపదిశ చ|</para>
  <para style="p">
    <verse number="12" style="v"/>అల్పవయష్కత్వాత్ కేనాప్యవజ్ఞేయో న భవ కిన్త్వాలాపేనాచరణేన ప్రేమ్నా సదాత్మత్వేన విశ్వాసేన శుచిత్వేన చ విశ్వాసినామ్ ఆదర్శో భవ|</para>
  <para style="p">
    <verse number="13" style="v"/>యావన్నాహమ్ ఆగమిష్యామి తావత్ త్వ పాఠే చేతయనే ఉపదేశే చ మనో నిధత్స్వ|</para>
  <para style="p">
    <verse number="14" style="v"/>ప్రాచీనగణహస్తార్పణసహితేన భవిష్యద్వాక్యేన యద్దానం తుభ్యం విశ్రాణితం తవాన్తఃస్థే తస్మిన్ దానే శిథిలమనా మా భవ|</para>
  <para style="p">
    <verse number="15" style="v"/>ఏతేషు మనో నివేశయ, ఏతేషు వర్త్తస్వ, ఇత్థఞ్చ సర్వ్వవిషయే తవ గుణవృద్ధిః ప్రకాశతాం|</para>
  <para style="p">
    <verse number="16" style="v"/>స్వస్మిన్ ఉపదేశే చ సావధానో భూత్వావతిష్ఠస్వ తత్ కృత్వా త్వయాత్మపరిత్రాణం శ్రోతృణాఞ్చ పరిత్రాణం సాధయిష్యతే|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>త్వం ప్రాచీనం న భర్త్సయ కిన్తు తం పితరమివ యూనశ్చ భ్రాతృనివ</para>
  <para style="p">
    <verse number="2" style="v"/>వృద్ధాః స్త్రియశ్చ మాతృనివ యువతీశ్చ పూర్ణశుచిత్వేన భగినీరివ వినయస్వ|</para>
  <para style="p">
    <verse number="3" style="v"/>అపరం సత్యవిధవాః సమ్మన్యస్వ|</para>
  <para style="p">
    <verse number="4" style="v"/>కస్యాశ్చిద్ విధవాయా యది పుత్రాః పౌత్రా వా విద్యన్తే తర్హి తే ప్రథమతః స్వీయపరిజనాన్ సేవితుం పిత్రోః ప్రత్యుపకర్త్తుఞ్చ శిక్షన్తాం యతస్తదేవేశ్వరస్య సాక్షాద్ ఉత్తమం గ్రాహ్యఞ్చ కర్మ్మ|</para>
  <para style="p">
    <verse number="5" style="v"/>అపరం యా నారీ సత్యవిధవా నాథహీనా చాస్తి సా ఈశ్వరస్యాశ్రయే తిష్ఠన్తీ దివానిశం నివేదనప్రార్థనాభ్యాం కాలం యాపయతి|</para>
  <para style="p">
    <verse number="6" style="v"/>కిన్తు యా విధవా సుఖభోగాసక్తా సా జీవత్యపి మృతా భవతి|</para>
  <para style="p">
    <verse number="7" style="v"/>అతఏవ తా యద్ అనిన్దితా భవేయూస్తదర్థమ్ ఏతాని త్వయా నిదిశ్యన్తాం|</para>
  <para style="p">
    <verse number="8" style="v"/>యది కశ్చిత్ స్వజాతీయాన్ లోకాన్ విశేషతః స్వీయపరిజనాన్ న పాలయతి తర్హి స విశ్వాసాద్ భ్రష్టో ఽప్యధమశ్చ భవతి|</para>
  <para style="p">
    <verse number="9" style="v"/>విధవావర్గే యస్యా గణనా భవతి తయా షష్టివత్సరేభ్యో న్యూనవయస్కయా న భవితవ్యం; అపరం పూర్వ్వమ్ ఏకస్వామికా భూత్వా</para>
  <para style="p">
    <verse number="10" style="v"/>సా యత్ శిశుపోషణేనాతిథిసేవనేన పవిత్రలోకానాం చరణప్రక్షాలనేన క్లిష్టానామ్ ఉపకారేణ సర్వ్వవిధసత్కర్మ్మాచరణేన చ సత్కర్మ్మకరణాత్ సుఖ్యాతిప్రాప్తా భవేత్ తదప్యావశ్యకం|</para>
  <para style="p">
    <verse number="11" style="v"/>కిన్తు యువతీ ర్విధవా న గృహాణ యతః ఖ్రీష్టస్య వైపరీత్యేన తాసాం దర్పే జాతే తా వివాహమ్ ఇచ్ఛన్తి|</para>
  <para style="p">
    <verse number="12" style="v"/>తస్మాచ్చ పూర్వ్వధర్మ్మం పరిత్యజ్య దణ్డనీయా భవన్తి|</para>
  <para style="p">
    <verse number="13" style="v"/>అనన్తరం తా గృహాద్ గృహం పర్య్యటన్త్య ఆలస్యం శిక్షన్తే కేవలమాలస్యం నహి కిన్త్వనర్థకాలాపం పరాధికారచర్చ్చాఞ్చాపి శిక్షమాణా అనుచితాని వాక్యాని భాషన్తే|</para>
  <para style="p">
    <verse number="14" style="v"/>అతో మమేచ్ఛేయం యువత్యో విధవా వివాహం కుర్వ్వతామ్ అపత్యవత్యో భవన్తు గృహకర్మ్మ కుర్వ్వతాఞ్చేత్థం విపక్షాయ కిమపి నిన్దాద్వారం న దదతు|</para>
  <para style="p">
    <verse number="15" style="v"/>యత ఇతః పూర్వ్వమ్ అపి కాశ్చిత్ శయతానస్య పశ్చాద్గామిన్యో జాతాః|</para>
  <para style="p">
    <verse number="16" style="v"/>అపరం విశ్వాసిన్యా విశ్వాసినో వా కస్యాపి పరివారాణాం మధ్యే యది విధవా విద్యన్తే తర్హి స తాః ప్రతిపాలయతు తస్మాత్ సమితౌ భారే ఽనారోపితే సత్యవిధవానాం ప్రతిపాలనం కర్త్తుం తయా శక్యతే|</para>
  <para style="p">
    <verse number="17" style="v"/>యే ప్రాఞ్చః సమితిం సమ్యగ్ అధితిష్ఠన్తి విశేషత ఈశ్వరవాక్యేనోపదేశేన చ యే యత్నం విదధతే తే ద్విగుణస్యాదరస్య యోగ్యా మాన్యన్తాం|</para>
  <para style="p">
    <verse number="18" style="v"/>యస్మాత్ శాస్త్రే లిఖితమిదమాస్తే, త్వం శస్యమర్ద్దకవృషస్యాస్యం మా బధానేతి, అపరమపి కార్య్యకృద్ వేతనస్య యోగ్యో భవతీతి|</para>
  <para style="p">
    <verse number="19" style="v"/>ద్వౌ త్రీన్ వా సాక్షిణో వినా కస్యాచిత్ ప్రాచీనస్య విరుద్ధమ్ అభియోగస్త్వయా న గృహ్యతాం|</para>
  <para style="p">
    <verse number="20" style="v"/>అపరం యే పాపమాచరన్తి తాన్ సర్వ్వేషాం సమక్షం భర్త్సయస్వ తేనాపరేషామపి భీతి ర్జనిష్యతే|</para>
  <para style="p">
    <verse number="21" style="v"/>అహమ్ ఈశ్వరస్య ప్రభో ర్యీశుఖ్రీష్టస్య మనోనీతదివ్యదూతానాఞ్చ గోచరే త్వామ్ ఇదమ్ ఆజ్ఞాపయామి త్వం కస్యాప్యనురోధేన కిమపి న కుర్వ్వన వినాపక్షపాతమ్ ఏతాన విధీన్ పాలయ|</para>
  <para style="p">
    <verse number="22" style="v"/>కస్యాపి మూర్ద్ధి హస్తాపర్ణం త్వరయా మాకార్షీః| పరపాపానాఞ్చాంశీ మా భవ| స్వం శుచిం రక్ష|</para>
  <para style="p">
    <verse number="23" style="v"/>అపరం తవోదరపీడాయాః పునః పున దుర్బ్బలతాయాశ్చ నిమిత్తం కేవలం తోయం న పివన్ కిఞ్చిన్ మద్యం పివ|</para>
  <para style="p">
    <verse number="24" style="v"/>కేషాఞ్చిత్ మానవానాం పాపాని విచారాత్ పూర్వ్వం కేషాఞ్చిత్ పశ్చాత్ ప్రకాశన్తే|</para>
  <para style="p">
    <verse number="25" style="v"/>తథైవ సత్కర్మ్మాణ్యపి ప్రకాశన్తే తదన్యథా సతి ప్రచ్ఛన్నాని స్థాతుం న శక్నువన్తి|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>యావన్తో లోకా యుగధారిణో దాసాః సన్తి తే స్వస్వస్వామినం పూర్ణసమాదరయోగ్యం మన్యన్తాం నో చేద్ ఈశ్వరస్య నామ్న ఉపదేశస్య చ నిన్దా సమ్భవిష్యతి|</para>
  <para style="p">
    <verse number="2" style="v"/>యేషాఞ్చ స్వామినో విశ్వాసినః భవన్తి తైస్తే భ్రాతృత్వాత్ నావజ్ఞేయాః కిన్తు తే కర్మ్మఫలభోగినో విశ్వాసినః ప్రియాశ్చ భవన్తీతి హేతోః సేవనీయా ఏవ, త్వమ్ ఏతాని శిక్షయ సముపదిశ చ|</para>
  <para style="p">
    <verse number="3" style="v"/>యః కశ్చిద్ ఇతరశిక్షాం కరోతి, అస్మాకం ప్రభో ర్యీశుఖ్రీష్టస్య హితవాక్యానీశ్వరభక్తే ర్యోగ్యాం శిక్షాఞ్చ న స్వీకరోతి</para>
  <para style="p">
    <verse number="4" style="v"/>స దర్పధ్మాతః సర్వ్వథా జ్ఞానహీనశ్చ వివాదై ర్వాగ్యుద్ధైశ్చ రోగయుక్తశ్చ భవతి|</para>
  <para style="p">
    <verse number="5" style="v"/>తాదృశాద్ భావాద్ ఈర్ష్యావిరోధాపవాదదుష్టాసూయా భ్రష్టమనసాం సత్యజ్ఞానహీనానామ్ ఈశ్వరభక్తిం లాభోపాయమ్ ఇవ మన్యమానానాం లోకానాం వివాదాశ్చ జాయన్తే తాదృశేభ్యో లోకేభ్యస్త్వం పృథక్ తిష్ఠ|</para>
  <para style="p">
    <verse number="6" style="v"/>సంయతేచ్ఛయా యుక్తా యేశ్వరభక్తిః సా మహాలాభోపాయో భవతీతి సత్యం|</para>
  <para style="p">
    <verse number="7" style="v"/>ఏతజ్జగత్ప్రవేశనకాలేఽస్మాభిః కిమపి నానాయి తత్తయజనకాలేఽపి కిమపి నేతుం న శక్ష్యత ఇతి నిశ్చితం|</para>
  <para style="p">
    <verse number="8" style="v"/>అతఏవ ఖాద్యాన్యాచ్ఛాదనాని చ ప్రాప్యాస్మాభిః సన్తుష్టై ర్భవితవ్యం|</para>
  <para style="p">
    <verse number="9" style="v"/>యే తు ధనినో భవితుం చేష్టన్తే తే పరీక్షాయామ్ ఉన్మాథే పతన్తి యే చాభిలాషా మానవాన్ వినాశే నరకే చ మజ్జయన్తి తాదృశేష్వజ్ఞానాహితాభిలాషేష్వపి పతన్తి|</para>
  <para style="p">
    <verse number="10" style="v"/>యతోఽర్థస్పృహా సర్వ్వేషాం దురితానాం మూలం భవతి తామవలమ్బ్య కేచిద్ విశ్వాసాద్ అభ్రంశన్త నానాక్లేశైశ్చ స్వాన్ అవిధ్యన్|</para>
  <para style="p">
    <verse number="11" style="v"/>హే ఈశ్వరస్య లోక త్వమ్ ఏతేభ్యః పలాయ్య ధర్మ్మ ఈశ్వరభక్తి ర్విశ్వాసః ప్రేమ సహిష్ణుతా క్షాన్తిశ్చైతాన్యాచర|</para>
  <para style="p">
    <verse number="12" style="v"/>విశ్వాసరూపమ్ ఉత్తమయుద్ధం కురు, అనన్తజీవనమ్ ఆలమ్బస్వ యతస్తదర్థం త్వమ్ ఆహూతో ఽభవః, బహుసాక్షిణాం సమక్షఞ్చోత్తమాం ప్రతిజ్ఞాం స్వీకృతవాన్|</para>
  <para style="p">
    <verse number="13" style="v"/>అపరం సర్వ్వేషాం జీవయితురీశ్వరస్య సాక్షాద్ యశ్చ ఖ్రీష్టో యీశుః పన్తీయపీలాతస్య సమక్షమ్ ఉత్తమాం ప్రతిజ్ఞాం స్వీకృతవాన్ తస్య సాక్షాద్ అహం త్వామ్ ఇదమ్ ఆజ్ఞాపయామి|</para>
  <para style="p">
    <verse number="14" style="v"/>ఈశ్వరేణ స్వసమయే ప్రకాశితవ్యమ్ అస్మాకం ప్రభో ర్యీశుఖ్రీష్టస్యాగమనం యావత్ త్వయా నిష్కలఙ్కత్వేన నిర్ద్దోషత్వేన చ విధీ రక్ష్యతాం|</para>
  <para style="p">
    <verse number="15" style="v"/>స ఈశ్వరః సచ్చిదానన్దః, అద్వితీయసమ్రాట్, రాజ్ఞాం రాజా, ప్రభూనాం ప్రభుః,</para>
  <para style="p">
    <verse number="16" style="v"/>అమరతాయా అద్వితీయ ఆకరః, అగమ్యతేజోనివాసీ, మర్త్త్యానాం కేనాపి న దృష్టః కేనాపి న దృశ్యశ్చ| తస్య గౌరవపరాక్రమౌ సదాతనౌ భూయాస్తాం| ఆమేన్|</para>
  <para style="p">
    <verse number="17" style="v"/>ఇహలోకే యే ధనినస్తే చిత్తసమున్నతిం చపలే ధనే విశ్వాసఞ్చ న కుర్వ్వతాం కిన్తు భోగార్థమ్ అస్మభ్యం ప్రచురత్వేన సర్వ్వదాతా</para>
  <para style="p">
    <verse number="18" style="v"/>యోఽమర ఈశ్వరస్తస్మిన్ విశ్వసన్తు సదాచారం కుర్వ్వన్తు సత్కర్మ్మధనేన ధనినో సుకలా దాతారశ్చ భవన్తు,</para>
  <para style="p">
    <verse number="19" style="v"/>యథా చ సత్యం జీవనం పాప్నుయుస్తథా పారత్రికామ్ ఉత్తమసమ్పదం సఞ్చిన్వన్త్వేతి త్వయాదిశ్యన్తాం|</para>
  <para style="p">
    <verse number="20" style="v"/>హే తీమథియ, త్వమ్ ఉపనిధిం గోపయ కాల్పనికవిద్యాయా అపవిత్రం ప్రలాపం విరోధోక్తిఞ్చ త్యజ చ,</para>
  <para style="p">
    <verse number="21" style="v"/>యతః కతిపయా లోకాస్తాం విద్యామవలమ్బ్య విశ్వాసాద్ భ్రష్టా అభవన| ప్రసాదస్తవ సహాయో భూయాత్| ఆమేన్|</para>
</usx>
