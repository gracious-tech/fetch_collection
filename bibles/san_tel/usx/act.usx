<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="ACT" style="id">Sanskrit Bible (NT) in Telugu Script (సత్యవేదః।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Acts</para>
  <para style="toc1">ప్రేరితానాం కర్మ్మణామాఖ్యానం</para>
  <para style="toc2">ప్రేరితాః</para>
  <para style="toc3">ప్రేరితాః</para>
  <para style="mt1">ప్రేరితానాం కర్మ్మణామాఖ్యానం</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>హే థియఫిల, యీశుః స్వమనోనీతాన్ ప్రేరితాన్ పవిత్రేణాత్మనా సమాదిశ్య యస్మిన్ దినే స్వర్గమారోహత్ యాం యాం క్రియామకరోత్ యద్యద్ ఉపాదిశచ్చ తాని సర్వ్వాణి పూర్వ్వం మయా లిఖితాని|</para>
  <para style="p">
    <verse number="2" style="v"/>స స్వనిధనదుఃఖభోగాత్ పరమ్ అనేకప్రత్యయక్షప్రమాణౌః స్వం సజీవం దర్శయిత్వా</para>
  <para style="p">
    <verse number="3" style="v"/>చత్వారింశద్దినాని యావత్ తేభ్యః ప్రేరితేభ్యో దర్శనం దత్త్వేశ్వరీయరాజ్యస్య వర్ణనమ అకరోత్|</para>
  <para style="p">
    <verse number="4" style="v"/>అనన్తరం తేషాం సభాం కృత్వా ఇత్యాజ్ఞాపయత్, యూయం యిరూశాలమోఽన్యత్ర గమనమకృత్వా యస్తిన్ పిత్రాఙ్గీకృతే మమ వదనాత్ కథా అశృణుత తత్ప్రాప్తిమ్ అపేక్ష్య తిష్ఠత|</para>
  <para style="p">
    <verse number="5" style="v"/>యోహన్ జలే మజ్జితావాన్ కిన్త్వల్పదినమధ్యే యూయం పవిత్ర ఆత్మని మజ్జితా భవిష్యథ|</para>
  <para style="p">
    <verse number="6" style="v"/>పశ్చాత్ తే సర్వ్వే మిలిత్వా తమ్ అపృచ్ఛన్ హే ప్రభో భవాన్ కిమిదానీం పునరపి రాజ్యమ్ ఇస్రాయేలీయలోకానాం కరేషు సమర్పయిష్యతి?</para>
  <para style="p">
    <verse number="7" style="v"/>తతః సోవదత్ యాన్ సర్వ్వాన్ కాలాన్ సమయాంశ్చ పితా స్వవశేఽస్థాపయత్ తాన్ జ్ఞాతృం యుష్మాకమ్ అధికారో న జాయతే|</para>
  <para style="p">
    <verse number="8" style="v"/>కిన్తు యుష్మాసు పవిత్రస్యాత్మన ఆవిర్భావే సతి యూయం శక్తిం ప్రాప్య యిరూశాలమి సమస్తయిహూదాశోమిరోణదేశయోః పృథివ్యాః సీమాం యావద్ యావన్తో దేశాస్తేషు యర్వ్వేషు చ మయి సాక్ష్యం దాస్యథ|</para>
  <para style="p">
    <verse number="9" style="v"/>ఇతి వాక్యముక్త్వా స తేషాం సమక్షం స్వర్గం నీతోఽభవత్, తతో మేఘమారుహ్య తేషాం దృష్టేరగోచరోఽభవత్|</para>
  <para style="p">
    <verse number="10" style="v"/>యస్మిన్ సమయే తే విహాయసం ప్రత్యనన్యదృష్ట్యా తస్య తాదృశమ్ ఊర్ద్వ్వగమనమ్ అపశ్యన్ తస్మిన్నేవ సమయే శుక్లవస్త్రౌ ద్వౌ జనౌ తేషాం సన్నిధౌ దణ్డాయమానౌ కథితవన్తౌ,</para>
  <para style="p">
    <verse number="11" style="v"/>హే గాలీలీయలోకా యూయం కిమర్థం గగణం ప్రతి నిరీక్ష్య దణ్డాయమానాస్తిష్ఠథ? యుష్మాకం సమీపాత్ స్వర్గం నీతో యో యీశుస్తం యూయం యథా స్వర్గమ్ ఆరోహన్తమ్ అదర్శమ్ తథా స పునశ్చాగమిష్యతి|</para>
  <para style="p">
    <verse number="12" style="v"/>తతః పరం తే జైతుననామ్నః పర్వ్వతాద్ విశ్రామవారస్య పథః పరిమాణమ్ అర్థాత్ ప్రాయేణార్ద్ధక్రోశం దురస్థం యిరూశాలమ్నగరం పరావృత్యాగచ్ఛన్|</para>
  <para style="p">
    <verse number="13" style="v"/>నగరం ప్రవిశ్య పితరో యాకూబ్ యోహన్ ఆన్ద్రియః ఫిలిపః థోమా బర్థజమయో మథిరాల్ఫీయపుత్రో యాకూబ్ ఉద్యోగాी శిమోన్ యాకూబో భ్రాతా యిహూదా ఏతే సర్వ్వే యత్ర స్థానే ప్రవసన్తి తస్మిన్ ఉపరితనప్రకోష్ఠే ప్రావిశన్|</para>
  <para style="p">
    <verse number="14" style="v"/>పశ్చాద్ ఇమే కియత్యః స్త్రియశ్చ యీశో ర్మాతా మరియమ్ తస్య భ్రాతరశ్చైతే సర్వ్వ ఏకచిత్తీభూత సతతం వినయేన వినయేన ప్రార్థయన్త|</para>
  <para style="p">
    <verse number="15" style="v"/>తస్మిన్ సమయే తత్ర స్థానే సాకల్యేన వింశత్యధికశతం శిష్యా ఆసన్| తతః పితరస్తేషాం మధ్యే తిష్ఠన్ ఉక్తవాన్</para>
  <para style="p">
    <verse number="16" style="v"/>హే భ్రాతృగణ యీశుధారిణాం లోకానాం పథదర్శకో యో యిహూదాస్తస్మిన్ దాయూదా పవిత్ర ఆత్మా యాం కథాం కథయామాస తస్యాః ప్రత్యక్షీభవనస్యావశ్యకత్వమ్ ఆసీత్|</para>
  <para style="p">
    <verse number="17" style="v"/>స జనోఽస్మాకం మధ్యవర్త్తీ సన్ అస్యాః సేవాయా అంశమ్ అలభత|</para>
  <para style="p">
    <verse number="18" style="v"/>తదనన్తరం కుకర్మ్మణా లబ్ధం యన్మూల్యం తేన క్షేత్రమేకం క్రీతమ్ అపరం తస్మిన్ అధోముఖే భృమౌ పతితే సతి తస్యోదరస్య విదీర్ణత్వాత్ సర్వ్వా నాడ్యో నిరగచ్ఛన్|</para>
  <para style="p">
    <verse number="19" style="v"/>ఏతాం కథాం యిరూశాలమ్నివాసినః సర్వ్వే లోకా విదాన్తి; తేషాం నిజభాషయా తత్క్షేత్రఞ్చ హకల్దామా, అర్థాత్ రక్తక్షేత్రమితి విఖ్యాతమాస్తే|</para>
  <para style="p">
    <verse number="20" style="v"/>అన్యచ్చ, నికేతనం తదీయన్తు శున్యమేవ భవిష్యతి| తస్య దూష్యే నివాసార్థం కోపి స్థాస్యతి నైవ హి| అన్య ఏవ జనస్తస్య పదం సంప్రాప్స్యతి ధ్రువం| ఇత్థం గీతపుస్తకే లిఖితమాస్తే|</para>
  <para style="p">
    <verse number="21" style="v"/>అతో యోహనో మజ్జనమ్ ఆరభ్యాస్మాకం సమీపాత్ ప్రభో ర్యీశోః స్వర్గారోహణదినం యావత్ సోస్మాకం మధ్యే యావన్తి దినాని యాపితవాన్</para>
  <para style="p">
    <verse number="22" style="v"/>తావన్తి దినాని యే మానవా అస్మాభిః సార్ద్ధం తిష్ఠన్తి తేషామ్ ఏకేన జనేనాస్మాభిః సార్ద్ధం యీశోరుత్థానే సాక్షిణా భవితవ్యం|</para>
  <para style="p">
    <verse number="23" style="v"/>అతో యస్య రూఢి ర్యుష్టో యం బర్శబ్బేత్యుక్త్వాహూయన్తి స యూషఫ్ మతథిశ్చ ద్వావేతౌ పృథక్ కృత్వా త ఈశ్వరస్య సన్నిధౌ ప్రార్య్య కథితవన్తః,</para>
  <para style="p">
    <verse number="24" style="v"/>హే సర్వ్వాన్తర్య్యామిన్ పరమేశ్వర, యిహూదాః సేవనప్రేరితత్వపదచ్యుతః</para>
  <para style="p">
    <verse number="25" style="v"/>సన్ నిజస్థానమ్ అగచ్ఛత్, తత్పదం లబ్ధుమ్ ఏనయో ర్జనయో ర్మధ్యే భవతా కోఽభిరుచితస్తదస్మాన్ దర్శ్యతాం|</para>
  <para style="p">
    <verse number="26" style="v"/>తతో గుటికాపాటే కృతే మతథిర్నిరచీయత తస్మాత్ సోన్యేషామ్ ఏకాదశానాం ప్రరితానాం మధ్యే గణితోభవత్|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అపరఞ్చ నిస్తారోత్సవాత్ పరం పఞ్చాశత్తమే దినే సముపస్థితే సతి తే సర్వ్వే ఏకాచిత్తీభూయ స్థాన ఏకస్మిన్ మిలితా ఆసన్|</para>
  <para style="p">
    <verse number="2" style="v"/>ఏతస్మిన్నేవ సమయేఽకస్మాద్ ఆకాశాత్ ప్రచణ్డాత్యుగ్రవాయోః శబ్దవద్ ఏకః శబ్ద ఆగత్య యస్మిన్ గృహే త ఉపావిశన్ తద్ గృహం సమస్తం వ్యాప్నోత్|</para>
  <para style="p">
    <verse number="3" style="v"/>తతః పరం వహ్నిశిఖాస్వరూపా జిహ్వాః ప్రత్యక్షీభూయ విభక్తాః సత్యః ప్రతిజనోర్ద్ధ్వే స్థగితా అభూవన్|</para>
  <para style="p">
    <verse number="4" style="v"/>తస్మాత్ సర్వ్వే పవిత్రేణాత్మనా పరిపూర్ణాః సన్త ఆత్మా యథా వాచితవాన్ తదనుసారేణాన్యదేశీయానాం భాషా ఉక్తవన్తః|</para>
  <para style="p">
    <verse number="5" style="v"/>తస్మిన్ సమయే పృథివీస్థసర్వ్వదేశేభ్యో యిహూదీయమతావలమ్బినో భక్తలోకా యిరూశాలమి ప్రావసన్;</para>
  <para style="p">
    <verse number="6" style="v"/>తస్యాః కథాయాః కింవదన్త్యా జాతత్వాత్ సర్వ్వే లోకా మిలిత్వా నిజనిజభాషయా శిష్యాణాం కథాకథనం శ్రుత్వా సముద్విగ్నా అభవన్|</para>
  <para style="p">
    <verse number="7" style="v"/>సర్వ్వఏవ విస్మయాపన్నా ఆశ్చర్య్యాన్వితాశ్చ సన్తః పరస్పరం ఉక్తవన్తః పశ్యత యే కథాం కథయన్తి తే సర్వ్వే గాలీలీయలోకాః కిం న భవన్తి?</para>
  <para style="p">
    <verse number="8" style="v"/>తర్హి వయం ప్రత్యేకశః స్వస్వజన్మదేశీయభాషాభిః కథా ఏతేషాం శృణుమః కిమిదం?</para>
  <para style="p">
    <verse number="9" style="v"/>పార్థీ-మాదీ-అరామ్నహరయిమ్దేశనివాసిమనో యిహూదా-కప్పదకియా-పన్త-ఆశియా-</para>
  <para style="p">
    <verse number="10" style="v"/>ఫ్రుగియా-పమ్ఫులియా-మిసరనివాసినః కురీణీనికటవర్త్తిలూబీయప్రదేశనివాసినో రోమనగరాద్ ఆగతా యిహూదీయలోకా యిహూదీయమతగ్రాహిణః క్రీతీయా అరాబీయాదయో లోకాశ్చ యే వయమ్</para>
  <para style="p">
    <verse number="11" style="v"/>అస్మాకం నిజనిజభాషాభిరేతేషామ్ ఈశ్వరీయమహాకర్మ్మవ్యాఖ్యానం శృణుమః|</para>
  <para style="p">
    <verse number="12" style="v"/>ఇత్థం తే సర్వ్వఏవ విస్మయాపన్నాః సన్దిగ్ధచిత్తాః సన్తః పరస్పరమూచుః, అస్య కో భావః?</para>
  <para style="p">
    <verse number="13" style="v"/>అపరే కేచిత్ పరిహస్య కథితవన్త ఏతే నవీనద్రాక్షారసేన మత్తా అభవన్|</para>
  <para style="p">
    <verse number="14" style="v"/>తదా పితర ఏకాదశభి ర్జనైః సాకం తిష్ఠన్ తాల్లోకాన్ ఉచ్చైఃకారమ్ అవదత్, హే యిహూదీయా హే యిరూశాలమ్నివాసినః సర్వ్వే, అవధానం కృత్వా మదీయవాక్యం బుధ్యధ్వం|</para>
  <para style="p">
    <verse number="15" style="v"/>ఇదానీమ్ ఏకయామాద్ అధికా వేలా నాస్తి తస్మాద్ యూయం యద్ అనుమాథ మానవా ఇమే మద్యపానేన మత్తాస్తన్న|</para>
  <para style="p">
    <verse number="16" style="v"/>కిన్తు యోయేల్భవిష్యద్వక్త్రైతద్వాక్యముక్తం యథా,</para>
  <para style="p">
    <verse number="17" style="v"/>ఈశ్వరః కథయామాస యుగాన్తసమయే త్వహమ్| వర్షిష్యామి స్వమాత్మానం సర్వ్వప్రాణ్యుపరి ధ్రువమ్| భావివాక్యం వదిష్యన్తి కన్యాః పుత్రాశ్చ వస్తుతః| ప్రత్యాదేశఞ్చ ప్రాప్స్యన్తి యుష్మాకం యువమానవాః| తథా ప్రాచీనలోకాస్తు స్వప్నాన్ ద్రక్ష్యన్తి నిశ్చితం|</para>
  <para style="p">
    <verse number="18" style="v"/>వర్షిష్యామి తదాత్మానం దాసదాసీజనోపిరి| తేనైవ భావివాక్యం తే వదిష్యన్తి హి సర్వ్వశః|</para>
  <para style="p">
    <verse number="19" style="v"/>ఊర్ద్ధ్వస్థే గగణే చైవ నీచస్థే పృథివీతలే| శోణితాని బృహద్భానూన్ ఘనధూమాదికాని చ| చిహ్నాని దర్శయిష్యామి మహాశ్చర్య్యక్రియాస్తథా|</para>
  <para style="p">
    <verse number="20" style="v"/>మహాభయానకస్యైవ తద్దినస్య పరేశితుః| పురాగమాద్ రవిః కృష్ణో రక్తశ్చన్ద్రో భవిష్యతః|</para>
  <para style="p">
    <verse number="21" style="v"/>కిన్తు యః పరమేశస్య నామ్ని సమ్ప్రార్థయిష్యతే| సఏవ మనుజో నూనం పరిత్రాతో భవిష్యతి||</para>
  <para style="p">
    <verse number="22" style="v"/>అతో హే ఇస్రాయేల్వంశీయలోకాః సర్వ్వే కథాయామేతస్యామ్ మనో నిధద్ధ్వం నాసరతీయో యీశురీశ్వరస్య మనోనీతః పుమాన్ ఏతద్ ఈశ్వరస్తత్కృతైరాశ్చర్య్యాద్భుతకర్మ్మభి ర్లక్షణైశ్చ యుష్మాకం సాక్షాదేవ ప్రతిపాదితవాన్ ఇతి యూయం జానీథ|</para>
  <para style="p">
    <verse number="23" style="v"/>తస్మిన్ యీశౌ ఈశ్వరస్య పూర్వ్వనిశ్చితమన్త్రణానిరూపణానుసారేణ మృత్యౌ సమర్పితే సతి యూయం తం ధృత్వా దుష్టలోకానాం హస్తైః క్రుశే విధిత్వాహత|</para>
  <para style="p">
    <verse number="24" style="v"/>కిన్త్వీశ్వరస్తం నిధనస్య బన్ధనాన్మోచయిత్వా ఉదస్థాపయత్ యతః స మృత్యునా బద్ధస్తిష్ఠతీతి న సమ్భవతి|</para>
  <para style="p">
    <verse number="25" style="v"/>ఏతస్తిన్ దాయూదపి కథితవాన్ యథా, సర్వ్వదా మమ సాక్షాత్తం స్థాపయ పరమేశ్వరం| స్థితే మద్దక్షిణే తస్మిన్ స్ఖలిష్యామి త్వహం నహి|</para>
  <para style="p">
    <verse number="26" style="v"/>ఆనన్దిష్యతి తద్ధేతో ర్మామకీనం మనస్తు వై| ఆహ్లాదిష్యతి జిహ్వాపి మదీయా తు తథైవ చ| ప్రత్యాశయా శరీరన్తు మదీయం వైశయిష్యతే|</para>
  <para style="p">
    <verse number="27" style="v"/>పరలోకే యతో హేతోస్త్వం మాం నైవ హి త్యక్ష్యసి| స్వకీయం పుణ్యవన్తం త్వం క్షయితుం నైవ దాస్యసి| ఏవం జీవనమార్గం త్వం మామేవ దర్శయిష్యసి|</para>
  <para style="p">
    <verse number="28" style="v"/>స్వసమ్ముఖే య ఆనన్దో దక్షిణే స్వస్య యత్ సుఖం| అనన్తం తేన మాం పూర్ణం కరిష్యసి న సంశయః||</para>
  <para style="p">
    <verse number="29" style="v"/>హే భ్రాతరోఽస్మాకం తస్య పూర్వ్వపురుషస్య దాయూదః కథాం స్పష్టం కథయితుం మామ్ అనుమన్యధ్వం, స ప్రాణాన్ త్యక్త్వా శ్మశానే స్థాపితోభవద్ అద్యాపి తత్ శ్మశానమ్ అస్మాకం సన్నిధౌ విద్యతే|</para>
  <para style="p">
    <verse number="30" style="v"/>ఫలతో లౌకికభావేన దాయూదో వంశే ఖ్రీష్టం జన్మ గ్రాహయిత్వా తస్యైవ సింహాసనే సమువేష్టుం తముత్థాపయిష్యతి పరమేశ్వరః శపథం కుత్వా దాయూదః సమీప ఇమమ్ అఙ్గీకారం కృతవాన్,</para>
  <para style="p">
    <verse number="31" style="v"/>ఇతి జ్ఞాత్వా దాయూద్ భవిష్యద్వాదీ సన్ భవిష్యత్కాలీయజ్ఞానేన ఖ్రీష్టోత్థానే కథామిమాం కథయామాస యథా తస్యాత్మా పరలోకే న త్యక్ష్యతే తస్య శరీరఞ్చ న క్షేష్యతి;</para>
  <para style="p">
    <verse number="32" style="v"/>అతః పరమేశ్వర ఏనం యీశుం శ్మశానాద్ ఉదస్థాపయత్ తత్ర వయం సర్వ్వే సాక్షిణ ఆస్మహే|</para>
  <para style="p">
    <verse number="33" style="v"/>స ఈశ్వరస్య దక్షిణకరేణోన్నతిం ప్రాప్య పవిత్ర ఆత్మిన పితా యమఙ్గీకారం కృతవాన్ తస్య ఫలం ప్రాప్య యత్ పశ్యథ శృణుథ చ తదవర్షత్|</para>
  <para style="p">
    <verse number="34" style="v"/>యతో దాయూద్ స్వర్గం నారురోహ కిన్తు స్వయమ్ ఇమాం కథామ్ అకథయద్ యథా, మమ ప్రభుమిదం వాక్యమవదత్ పరమేశ్వరః|</para>
  <para style="p">
    <verse number="35" style="v"/>తవ శత్రూనహం యావత్ పాదపీఠం కరోమి న| తావత్ కాలం మదీయే త్వం దక్షవార్శ్వ ఉపావిశ|</para>
  <para style="p">
    <verse number="36" style="v"/>అతో యం యీశుం యూయం క్రుశేఽహత పరమేశ్వరస్తం ప్రభుత్వాభిషిక్తత్వపదే న్యయుంక్తేతి ఇస్రాయేలీయా లోకా నిశ్చితం జానన్తు|</para>
  <para style="p">
    <verse number="37" style="v"/>ఏతాదృశీం కథాం శ్రుత్వా తేషాం హృదయానాం విదీర్ణత్వాత్ తే పితరాయ తదన్యప్రేరితేభ్యశ్చ కథితవన్తః, హే భ్రాతృగణ వయం కిం కరిష్యామః?</para>
  <para style="p">
    <verse number="38" style="v"/>తతః పితరః ప్రత్యవదద్ యూయం సర్వ్వే స్వం స్వం మనః పరివర్త్తయధ్వం తథా పాపమోచనార్థం యీశుఖ్రీష్టస్య నామ్నా మజ్జితాశ్చ భవత, తస్మాద్ దానరూపం పరిత్రమ్ ఆత్మానం లప్స్యథ|</para>
  <para style="p">
    <verse number="39" style="v"/>యతో యుష్మాకం యుష్మత్సన్తానానాఞ్చ దూరస్థసర్వ్వలోకానాఞ్చ నిమిత్తమ్ అర్థాద్ అస్మాకం ప్రభుః పరమేశ్వరో యావతో లాకాన్ ఆహ్వాస్యతి తేషాం సర్వ్వేషాం నిమిత్తమ్ అయమఙ్గీకార ఆస్తే|</para>
  <para style="p">
    <verse number="40" style="v"/>ఏతదన్యాభి ర్బహుకథాభిః ప్రమాణం దత్వాకథయత్ ఏతేభ్యో విపథగామిభ్యో వర్త్తమానలోకేభ్యః స్వాన్ రక్షత|</para>
  <para style="p">
    <verse number="41" style="v"/>తతః పరం యే సానన్దాస్తాం కథామ్ అగృహ్లన్ తే మజ్జితా అభవన్| తస్మిన్ దివసే ప్రాయేణ త్రీణి సహస్రాణి లోకాస్తేషాం సపక్షాః సన్తః</para>
  <para style="p">
    <verse number="42" style="v"/>ప్రేరితానామ్ ఉపదేశే సఙ్గతౌ పూపభఞ్జనే ప్రార్థనాసు చ మనఃసంయోగం కృత్వాతిష్ఠన్|</para>
  <para style="p">
    <verse number="43" style="v"/>ప్రేరితై ర్నానాప్రకారలక్షణేషు మహాశ్చర్య్యకర్మమసు చ దర్శితేషు సర్వ్వలోకానాం భయముపస్థితం|</para>
  <para style="p">
    <verse number="44" style="v"/>విశ్వాసకారిణః సర్వ్వ చ సహ తిష్ఠనతః| స్వేషాం సర్వ్వాః సమ్పత్తీః సాధారణ్యేన స్థాపయిత్వాభుఞ్జత|</para>
  <para style="p">
    <verse number="45" style="v"/>ఫలతో గృహాణి ద్రవ్యాణి చ సర్వ్వాణి విక్రీయ సర్వ్వేషాం స్వస్వప్రయోజనానుసారేణ విభజ్య సర్వ్వేభ్యోఽదదన్|</para>
  <para style="p">
    <verse number="46" style="v"/>సర్వ్వ ఏకచిత్తీభూయ దినే దినే మన్దిరే సన్తిష్ఠమానా గృహే గృహే చ పూపానభఞ్జన్త ఈశ్వరస్య ధన్యవాదం కుర్వ్వన్తో లోకైః సమాదృతాః పరమానన్దేన సరలాన్తఃకరణేన భోజనం పానఞ్చకుర్వ్వన్|</para>
  <para style="p">
    <verse number="47" style="v"/>పరమేశ్వరో దినే దినే పరిత్రాణభాజనై ర్మణ్డలీమ్ అవర్ద్ధయత్|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>తృతీయయామవేలాయాం సత్యాం ప్రార్థనాయాః సమయే పితరయోహనౌ సమ్భూయ మన్దిరం గచ్ఛతః|</para>
  <para style="p">
    <verse number="2" style="v"/>తస్మిన్నేవ సమయే మన్దిరప్రవేశకానాం సమీపే భిక్షారణార్థం యం జన్మఖఞ్జమానుషం లోకా మన్దిరస్య సున్దరనామ్ని ద్వారే ప్రతిదినమ్ అస్థాపయన్ తం వహన్తస్తద్వారం ఆనయన్|</para>
  <para style="p">
    <verse number="3" style="v"/>తదా పితరయోహనౌ మన్తిరం ప్రవేష్టుమ్ ఉద్యతౌ విలోక్య స ఖఞ్జస్తౌ కిఞ్చిద్ భిక్షితవాన్|</para>
  <para style="p">
    <verse number="4" style="v"/>తస్మాద్ యోహనా సహితః పితరస్తమ్ అనన్యదృష్ట్యా నిరీక్ష్య ప్రోక్తవాన్ ఆవాం ప్రతి దృష్టిం కురు|</para>
  <para style="p">
    <verse number="5" style="v"/>తతః స కిఞ్చిత్ ప్రాప్త్యాశయా తౌ ప్రతి దృష్టిం కృతవాన్|</para>
  <para style="p">
    <verse number="6" style="v"/>తదా పితరో గదితవాన్ మమ నికటే స్వర్ణరూప్యాది కిమపి నాస్తి కిన్తు యదాస్తే తద్ దదామి నాసరతీయస్య యీశుఖ్రీష్టస్య నామ్నా త్వముత్థాయ గమనాగమనే కురు|</para>
  <para style="p">
    <verse number="7" style="v"/>తతః పరం స తస్య దక్షిణకరం ధృత్వా తమ్ ఉదతోలయత్; తేన తత్క్షణాత్ తస్య జనస్య పాదగుల్ఫయోః సబలత్వాత్ స ఉల్లమ్ఫ్య ప్రోత్థాయ గమనాగమనే ఽకరోత్|</para>
  <para style="p">
    <verse number="8" style="v"/>తతో గమనాగమనే కుర్వ్వన్ ఉల్లమ్ఫన్ ఈశ్వరం ధన్యం వదన్ తాభ్యాం సార్ద్ధం మన్దిరం ప్రావిశత్|</para>
  <para style="p">
    <verse number="9" style="v"/>తతః సర్వ్వే లోకాస్తం గమనాగమనే కుర్వ్వన్తమ్ ఈశ్వరం ధన్యం వదన్తఞ్చ విలోక్య</para>
  <para style="p">
    <verse number="10" style="v"/>మన్దిరస్య సున్దరే ద్వారే య ఉపవిశ్య భిక్షితవాన్ సఏవాయమ్ ఇతి జ్ఞాత్వా తం ప్రతి తయా ఘటనయా చమత్కృతా విస్మయాపన్నాశ్చాభవన్|</para>
  <para style="p">
    <verse number="11" style="v"/>యః ఖఞ్జః స్వస్థోభవత్ తేన పితరయోహనోః కరయోర్ధ్టతయోః సతోః సర్వ్వే లోకా సన్నిధిమ్ ఆగచ్ఛన్|</para>
  <para style="p">
    <verse number="12" style="v"/>తద్ దృష్ట్వా పితరస్తేభ్యోఽకథయత్, హే ఇస్రాయేలీయలోకా యూయం కుతో ఽనేనాశ్చర్య్యం మన్యధ్వే? ఆవాం నిజశక్త్యా యద్వా నిజపుణ్యేన ఖఞ్జమనుష్యమేనం గమితవన్తావితి చిన్తయిత్వా ఆవాం ప్రతి కుతోఽనన్యదృష్టిం కురుథ?</para>
  <para style="p">
    <verse number="13" style="v"/>యం యీశుం యూయం పరకరేషు సమార్పయత తతో యం పీలాతో మోచయితుమ్ ఏैచ్ఛత్ తథాపి యూయం తస్య సాక్షాన్ నాఙ్గీకృతవన్త ఇబ్రాహీమ ఇస్హాకో యాకూబశ్చేశ్వరోఽర్థాద్ అస్మాకం పూర్వ్వపురుషాణామ్ ఈశ్వరః స్వపుత్రస్య తస్య యీశో ర్మహిమానం ప్రాకాశయత్|</para>
  <para style="p">
    <verse number="14" style="v"/>కిన్తు యూయం తం పవిత్రం ధార్మ్మికం పుమాంసం నాఙ్గీకృత్య హత్యాకారిణమేకం స్వేభ్యో దాతుమ్ అయాచధ్వం|</para>
  <para style="p">
    <verse number="15" style="v"/>పశ్చాత్ తం జీవనస్యాధిపతిమ్ అహత కిన్త్వీశ్వరః శ్మశానాత్ తమ్ ఉదస్థాపయత తత్ర వయం సాక్షిణ ఆస్మహే|</para>
  <para style="p">
    <verse number="16" style="v"/>ఇమం యం మానుషం యూయం పశ్యథ పరిచినుథ చ స తస్య నామ్ని విశ్వాసకరణాత్ చలనశక్తిం లబ్ధవాన్ తస్మిన్ తస్య యో విశ్వాసః స తం యుష్మాకం సర్వ్వేషాం సాక్షాత్ సమ్పూర్ణరూపేణ స్వస్థమ్ అకార్షీత్|</para>
  <para style="p">
    <verse number="17" style="v"/>హే భ్రాతరో యూయం యుష్మాకమ్ అధిపతయశ్చ అజ్ఞాత్వా కర్మ్మాణ్యేతాని కృతవన్త ఇదానీం మమైష బోధో జాయతే|</para>
  <para style="p">
    <verse number="18" style="v"/>కిన్త్వీశ్వరః ఖ్రీష్టస్య దుఃఖభోగే భవిష్యద్వాదినాం ముఖేభ్యో యాం యాం కథాం పూర్వ్వమకథయత్ తాః కథా ఇత్థం సిద్ధా అకరోత్|</para>
  <para style="p">
    <verse number="19" style="v"/>అతః స్వేషాం పాపమోచనార్థం ఖేదం కృత్వా మనాంసి పరివర్త్తయధ్వం, తస్మాద్ ఈశ్వరాత్ సాన్త్వనాప్రాప్తేః సమయ ఉపస్థాస్యతి;</para>
  <para style="p">
    <verse number="20" style="v"/>పునశ్చ పూర్వ్వకాలమ్ ఆరభ్య ప్రచారితో యో యీశుఖ్రీష్టస్తమ్ ఈశ్వరో యుష్మాన్ ప్రతి ప్రేషయిష్యతి|</para>
  <para style="p">
    <verse number="21" style="v"/>కిన్తు జగతః సృష్టిమారభ్య ఈశ్వరో నిజపవిత్రభవిష్యద్వాదిగణోన యథా కథితవాన్ తదనుసారేణ సర్వ్వేషాం కార్య్యాణాం సిద్ధిపర్య్యన్తం తేన స్వర్గే వాసః కర్త్తవ్యః|</para>
  <para style="p">
    <verse number="22" style="v"/>యుష్మాకం ప్రభుః పరమేశ్వరో యుష్మాకం భ్రాతృగణమధ్యాత్ మత్సదృశం భవిష్యద్వక్తారమ్ ఉత్పాదయిష్యతి, తతః స యత్ కిఞ్చిత్ కథయిష్యతి తత్ర యూయం మనాంసి నిధద్ధ్వం|</para>
  <para style="p">
    <verse number="23" style="v"/>కిన్తు యః కశ్చిత్ ప్రాణీ తస్య భవిష్యద్వాదినః కథాం న గ్రహీష్యతి స నిజలోకానాం మధ్యాద్ ఉచ్ఛేత్స్యతే," ఇమాం కథామ్ అస్మాకం పూర్వ్వపురుషేభ్యః కేవలో మూసాః కథయామాస ఇతి నహి,</para>
  <para style="p">
    <verse number="24" style="v"/>శిమూయేల్భవిష్యద్వాదినమ్ ఆరభ్య యావన్తో భవిష్యద్వాక్యమ్ అకథయన్ తే సర్వ్వఏవ సమయస్యైతస్య కథామ్ అకథయన్|</para>
  <para style="p">
    <verse number="25" style="v"/>యూయమపి తేషాం భవిష్యద్వాదినాం సన్తానాః, "తవ వంశోద్భవపుంసా సర్వ్వదేశీయా లోకా ఆశిషం ప్రాప్తా భవిష్యన్తి", ఇబ్రాహీమే కథామేతాం కథయిత్వా ఈశ్వరోస్మాకం పూర్వ్వపురుషైః సార్ద్ధం యం నియమం స్థిరీకృతవాన్ తస్య నియమస్యాధికారిణోపి యూయం భవథ|</para>
  <para style="p">
    <verse number="26" style="v"/>అత ఈశ్వరో నిజపుత్రం యీశుమ్ ఉత్థాప్య యుష్మాకం సర్వ్వేషాం స్వస్వపాపాత్ పరావర్త్త్య యుష్మభ్యమ్ ఆశిషం దాతుం ప్రథమతస్తం యుష్మాకం నికటం ప్రేషితవాన్|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>యస్మిన్ సమయే పితరయోహనౌ లోకాన్ ఉపదిశతస్తస్మిన్ సమయే యాజకా మన్దిరస్య సేనాపతయః సిదూకీగణశ్చ</para>
  <para style="p">
    <verse number="2" style="v"/>తయోర్ ఉపదేశకరణే ఖ్రీష్టస్యోత్థానమ్ ఉపలక్ష్య సర్వ్వేషాం మృతానామ్ ఉత్థానప్రస్తావే చ వ్యగ్రాః సన్తస్తావుపాగమన్|</para>
  <para style="p">
    <verse number="3" style="v"/>తౌ ధృత్వా దినావసానకారణాత్ పరదినపర్య్యనన్తం రుద్ధ్వా స్థాపితవన్తః|</para>
  <para style="p">
    <verse number="4" style="v"/>తథాపి యే లోకాస్తయోరుపదేశమ్ అశృణ్వన్ తేషాం ప్రాయేణ పఞ్చసహస్రాణి జనా వ్యశ్వసన్|</para>
  <para style="p">
    <verse number="5" style="v"/>పరేఽహని అధిపతయః ప్రాచీనా అధ్యాపకాశ్చ హానననామా మహాయాజకః</para>
  <para style="p">
    <verse number="6" style="v"/>కియఫా యోహన్ సికన్దర ఇత్యాదయో మహాయాజకస్య జ్ఞాతయః సర్వ్వే యిరూశాలమ్నగరే మిలితాః|</para>
  <para style="p">
    <verse number="7" style="v"/>అనన్తరం ప్రేరితౌ మధ్యే స్థాపయిత్వాపృచ్ఛన్ యువాం కయా శక్తయా వా కేన నామ్నా కర్మ్మాణ్యేతాని కురుథః?</para>
  <para style="p">
    <verse number="8" style="v"/>తదా పితరః పవిత్రేణాత్మనా పరిపూర్ణః సన్ ప్రత్యవాదీత్, హే లోకానామ్ అధిపతిగణ హే ఇస్రాయేలీయప్రాచీనాః,</para>
  <para style="p">
    <verse number="9" style="v"/>ఏతస్య దుర్బ్బలమానుషస్య హితం యత్ కర్మ్మాక్రియత, అర్థాత్, స యేన ప్రకారేణ స్వస్థోభవత్ తచ్చేద్ అద్యావాం పృచ్ఛథ,</para>
  <para style="p">
    <verse number="10" style="v"/>తర్హి సర్వ్వ ఇస్రాయేेలీయలోకా యూయం జానీత నాసరతీయో యో యీశుఖ్రీష్టః క్రుశే యుష్మాభిరవిధ్యత యశ్చేశ్వరేణ శ్మశానాద్ ఉత్థాపితః, తస్య నామ్నా జనోయం స్వస్థః సన్ యుష్మాకం సమ్ముఖే ప్రోత్తిష్ఠతి|</para>
  <para style="p">
    <verse number="11" style="v"/>నిచేతృభి ర్యుష్మాభిరయం యః ప్రస్తరోఽవజ్ఞాతోఽభవత్ స ప్రధానకోణస్య ప్రస్తరోఽభవత్|</para>
  <para style="p">
    <verse number="12" style="v"/>తద్భిన్నాదపరాత్ కస్మాదపి పరిత్రాణం భవితుం న శక్నోతి, యేన త్రాణం ప్రాప్యేత భూమణ్డలస్యలోకానాం మధ్యే తాదృశం కిమపి నామ నాస్తి|</para>
  <para style="p">
    <verse number="13" style="v"/>తదా పితరయోహనోరేతాదృశీమ్ అక్షేభతాం దృష్ట్వా తావవిద్వాంసౌ నీచలోకావితి బుద్ధ్వా ఆశ్చర్య్యమ్ అమన్యన్త తౌ చ యీశోః సఙ్గినౌ జాతావితి జ్ఞాతుమ్ అశక్నువన్|</para>
  <para style="p">
    <verse number="14" style="v"/>కిన్తు తాభ్యాం సార్ద్ధం తం స్వస్థమానుషం తిష్ఠన్తం దృష్ట్వా తే కామప్యపరామ్ ఆపత్తిం కర్త్తం నాశక్నున్|</para>
  <para style="p">
    <verse number="15" style="v"/>తదా తే సభాతః స్థానాన్తరం గన్తుం తాన్ ఆజ్ఞాప్య స్వయం పరస్పరమ్ ఇతి మన్త్రణామకుర్వ్వన్</para>
  <para style="p">
    <verse number="16" style="v"/>తౌ మానవౌ ప్రతి కిం కర్త్తవ్యం? తావేకం ప్రసిద్ధమ్ ఆశ్చర్య్యం కర్మ్మ కృతవన్తౌ తద్ యిరూశాలమ్నివాసినాం సర్వ్వేషాం లోకానాం సమీపే ప్రాకాశత తచ్చ వయమపహ్నోతుం న శక్నుమః|</para>
  <para style="p">
    <verse number="17" style="v"/>కిన్తు లోకానాం మధ్యమ్ ఏతద్ యథా న వ్యాప్నోతి తదర్థం తౌ భయం ప్రదర్శ్య తేన నామ్నా కమపి మనుష్యం నోపదిశతమ్ ఇతి దృఢం నిషేధామః|</para>
  <para style="p">
    <verse number="18" style="v"/>తతస్తే ప్రేరితావాహూయ ఏతదాజ్ఞాపయన్ ఇతః పరం యీశో ర్నామ్నా కదాపి కామపి కథాం మా కథయతం కిమపి నోపదిశఞ్చ|</para>
  <para style="p">
    <verse number="19" style="v"/>తతః పితరయోహనౌ ప్రత్యవదతామ్ ఈశ్వరస్యాజ్ఞాగ్రహణం వా యుష్మాకమ్ ఆజ్ఞాగ్రహణమ్ ఏతయో ర్మధ్యే ఈశ్వరస్య గోచరే కిం విహితం? యూయం తస్య వివేచనాం కురుత|</para>
  <para style="p">
    <verse number="20" style="v"/>వయం యద్ అపశ్యామ యదశృణుమ చ తన్న ప్రచారయిష్యామ ఏతత్ కదాపి భవితుం న శక్నోతి|</para>
  <para style="p">
    <verse number="21" style="v"/>యదఘటత తద్ దృష్టా సర్వ్వే లోకా ఈశ్వరస్య గుణాన్ అన్వవదన్ తస్మాత్ లోకభయాత్ తౌ దణ్డయితుం కమప్యుపాయం న ప్రాప్య తే పునరపి తర్జయిత్వా తావత్యజన్|</para>
  <para style="p">
    <verse number="22" style="v"/>యస్య మానుషస్యైతత్ స్వాస్థ్యకరణమ్ ఆశ్చర్య్యం కర్మ్మాక్రియత తస్య వయశ్చత్వారింశద్వత్సరా వ్యతీతాః|</para>
  <para style="p">
    <verse number="23" style="v"/>తతః పరం తౌ విసృష్టౌ సన్తౌ స్వసఙ్గినాం సన్నిధిం గత్వా ప్రధానయాజకైః ప్రాచీనలోకైశ్చ ప్రోక్తాః సర్వ్వాః కథా జ్ఞాపితవన్తౌ|</para>
  <para style="p">
    <verse number="24" style="v"/>తచ్ఛ్రుత్వా సర్వ్వ ఏకచిత్తీభూయ ఈశ్వరముద్దిశ్య ప్రోచ్చైరేతత్ ప్రార్థయన్త, హే ప్రభో గగణపృథివీపయోధీనాం తేషు చ యద్యద్ ఆస్తే తేషాం స్రష్టేశ్వరస్త్వం|</para>
  <para style="p">
    <verse number="25" style="v"/>త్వం నిజసేవకేన దాయూదా వాక్యమిదమ్ ఉవచిథ, మనుష్యా అన్యదేశీయాః కుర్వ్వన్తి కలహం కుతః| లోకాః సర్వ్వే కిమర్థం వా చిన్తాం కుర్వ్వన్తి నిష్ఫలాం|</para>
  <para style="p">
    <verse number="26" style="v"/>పరమేశస్య తేనైవాభిషిక్తస్య జనస్య చ| విరుద్ధమభితిష్ఠన్తి పృథివ్యాః పతయః కుతః||</para>
  <para style="p">
    <verse number="27" style="v"/>ఫలతస్తవ హస్తేన మన్త్రణయా చ పూర్వ్వ యద్యత్ స్థిరీకృతం తద్ యథా సిద్ధం భవతి తదర్థం త్వం యమ్ అథిషిక్తవాన్ స ఏవ పవిత్రో యీశుస్తస్య ప్రాతికూల్యేన హేరోద్ పన్తీయపీలాతో</para>
  <para style="p">
    <verse number="28" style="v"/>ఽన్యదేశీయలోకా ఇస్రాయేల్లోకాశ్చ సర్వ్వ ఏతే సభాయామ్ అతిష్ఠన్|</para>
  <para style="p">
    <verse number="29" style="v"/>హే పరమేశ్వర అధునా తేషాం తర్జనం గర్జనఞ్చ శృణు;</para>
  <para style="p">
    <verse number="30" style="v"/>తథా స్వాస్థ్యకరణకర్మ్మణా తవ బాహుబలప్రకాశపూర్వ్వకం తవ సేవకాన్ నిర్భయేన తవ వాక్యం ప్రచారయితుం తవ పవిత్రపుత్రస్య యీశో ర్నామ్నా ఆశ్చర్య్యాణ్యసమ్భవాని చ కర్మ్మాణి కర్త్తుఞ్చాజ్ఞాపయ|</para>
  <para style="p">
    <verse number="31" style="v"/>ఇత్థం ప్రార్థనయా యత్ర స్థానే తే సభాయామ్ ఆసన్ తత్ స్థానం ప్రాకమ్పత; తతః సర్వ్వే పవిత్రేణాత్మనా పరిపూర్ణాః సన్త ఈశ్వరస్య కథామ్ అక్షోభేణ ప్రాచారయన్|</para>
  <para style="p">
    <verse number="32" style="v"/>అపరఞ్చ ప్రత్యయకారిలోకసమూహా ఏకమనస ఏకచిత్తీభూయ స్థితాః| తేషాం కేపి నిజసమ్పత్తిం స్వీయాం నాజానన్ కిన్తు తేషాం సర్వ్వాః సమ్పత్త్యః సాధారణ్యేన స్థితాః|</para>
  <para style="p">
    <verse number="33" style="v"/>అన్యచ్చ ప్రేరితా మహాశక్తిప్రకాశపూర్వ్వకం ప్రభో ర్యీశోరుత్థానే సాక్ష్యమ్ అదదుః, తేషు సర్వ్వేషు మహానుగ్రహోఽభవచ్చ|</para>
  <para style="p">
    <verse number="34" style="v"/>తేషాం మధ్యే కస్యాపి ద్రవ్యన్యూనతా నాభవద్ యతస్తేషాం గృహభూమ్యాద్యా యాః సమ్పత్తయ ఆసన్ తా విక్రీయ</para>
  <para style="p">
    <verse number="35" style="v"/>తన్మూల్యమానీయ ప్రేరితానాం చరణేషు తైః స్థాపితం; తతః ప్రత్యేకశః ప్రయోజనానుసారేణ దత్తమభవత్|</para>
  <para style="p">
    <verse number="36" style="v"/>విశేషతః కుప్రోపద్వీపీయో యోసినామకో లేవివంశజాత ఏకో జనో భూమ్యధికారీ, యం ప్రేరితా బర్ణబ్బా అర్థాత్ సాన్త్వనాదాయక ఇత్యుక్త్వా సమాహూయన్,</para>
  <para style="p">
    <verse number="37" style="v"/>స జనో నిజభూమిం విక్రీయ తన్మూల్యమానీయ ప్రేరితానాం చరణేషు స్థాపితవాన్|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>తదా అనానియనామక ఏకో జనో యస్య భార్య్యాయా నామ సఫీరా స స్వాధికారం విక్రీయ</para>
  <para style="p">
    <verse number="2" style="v"/>స్వభార్య్యాం జ్ఞాపయిత్వా తన్మూల్యస్యైకాంశం సఙ్గోప్య స్థాపయిత్వా తదన్యాంశమాత్రమానీయ ప్రేరితానాం చరణేషు సమర్పితవాన్|</para>
  <para style="p">
    <verse number="3" style="v"/>తస్మాత్ పితరోకథయత్ హే అనానియ భూమే ర్మూల్యం కిఞ్చిత్ సఙ్గోప్య స్థాపయితుం పవిత్రస్యాత్మనః సన్నిధౌ మృషావాక్యం కథయితుఞ్చ శైతాన్ కుతస్తవాన్తఃకరణే ప్రవృత్తిమజనయత్?</para>
  <para style="p">
    <verse number="4" style="v"/>సా భూమి ర్యదా తవ హస్తగతా తదా కిం తవ స్వీయా నాసీత్? తర్హి స్వాన్తఃకరణే కుత ఏతాదృశీ కుకల్పనా త్వయా కృతా? త్వం కేవలమనుష్యస్య నికటే మృషావాక్యం నావాదీః కిన్త్వీశ్వరస్య నికటేఽపి|</para>
  <para style="p">
    <verse number="5" style="v"/>ఏతాం కథాం శ్రుత్వైవ సోఽనానియో భూమౌ పతన్ ప్రాణాన్ అత్యజత్, తద్వృత్తాన్తం యావన్తో లోకా అశృణ్వన్ తేషాం సర్వ్వేషాం మహాభయమ్ అజాయత్|</para>
  <para style="p">
    <verse number="6" style="v"/>తదా యువలోకాస్తం వస్త్రేణాచ్ఛాద్య బహి ర్నీత్వా శ్మశానేఽస్థాపయన్|</para>
  <para style="p">
    <verse number="7" style="v"/>తతః ప్రహరైకానన్తరం కిం వృత్తం తన్నావగత్య తస్య భార్య్యాపి తత్ర సముపస్థితా|</para>
  <para style="p">
    <verse number="8" style="v"/>తతః పితరస్తామ్ అపృచ్ఛత్, యువాభ్యామ్ ఏతావన్ముద్రాభ్యో భూమి ర్విక్రీతా న వా? ఏతత్వం వద; తదా సా ప్రత్యవాదీత్ సత్యమ్ ఏతావద్భ్యో ముద్రాభ్య ఏవ|</para>
  <para style="p">
    <verse number="9" style="v"/>తతః పితరోకథయత్ యువాం కథం పరమేశ్వరస్యాత్మానం పరీక్షితుమ్ ఏకమన్త్రణావభవతాం? పశ్య యే తవ పతిం శ్మశానే స్థాపితవన్తస్తే ద్వారస్య సమీపే సముపతిష్ఠన్తి త్వామపి బహిర్నేష్యన్తి|</para>
  <para style="p">
    <verse number="10" style="v"/>తతః సాపి తస్య చరణసన్నిధౌ పతిత్వా ప్రాణాన్ అత్యాక్షీత్| పశ్చాత్ తే యువానోఽభ్యన్తరమ్ ఆగత్య తామపి మృతాం దృష్ట్వా బహి ర్నీత్వా తస్యాః పత్యుః పార్శ్వే శ్మశానే స్థాపితవన్తః|</para>
  <para style="p">
    <verse number="11" style="v"/>తస్మాత్ మణ్డల్యాః సర్వ్వే లోకా అన్యలోకాశ్చ తాం వార్త్తాం శ్రుత్వా సాధ్వసం గతాః|</para>
  <para style="p">
    <verse number="12" style="v"/>తతః పరం ప్రేరితానాం హస్తై ర్లోకానాం మధ్యే బహ్వాశ్చర్య్యాణ్యద్భుతాని కర్మ్మాణ్యక్రియన్త; తదా శిష్యాః సర్వ్వ ఏకచిత్తీభూయ సులేమానో ఽలిన్దే సమ్భూయాసన్|</para>
  <para style="p">
    <verse number="13" style="v"/>తేషాం సఙ్ఘాన్తర్గో భవితుం కోపి ప్రగల్భతాం నాగమత్ కిన్తు లోకాస్తాన్ సమాద్రియన్త|</para>
  <para style="p">
    <verse number="14" style="v"/>స్త్రియః పురుషాశ్చ బహవో లోకా విశ్వాస్య ప్రభుం శరణమాపన్నాః|</para>
  <para style="p">
    <verse number="15" style="v"/>పితరస్య గమనాగమనాభ్యాం కేనాపి ప్రకారేణ తస్య ఛాయా కస్మింశ్చిజ్జనే లగిష్యతీత్యాశయా లోకా రోగిణః శివికయా ఖట్వయా చానీయ పథి పథి స్థాపితవన్తః|</para>
  <para style="p">
    <verse number="16" style="v"/>చతుర్దిక్స్థనగరేభ్యో బహవో లోకాః సమ్భూయ రోగిణోఽపవిత్రభుతగ్రస్తాంశ్చ యిరూశాలమమ్ ఆనయన్ తతః సర్వ్వే స్వస్థా అక్రియన్త|</para>
  <para style="p">
    <verse number="17" style="v"/>అనన్తరం మహాయాజకః సిదూకినాం మతగ్రాహిణస్తేషాం సహచరాశ్చ</para>
  <para style="p">
    <verse number="18" style="v"/>మహాక్రోధాన్త్వితాః సన్తః ప్రేరితాన్ ధృత్వా నీచలోకానాం కారాయాం బద్ధ్వా స్థాపితవన్తః|</para>
  <para style="p">
    <verse number="19" style="v"/>కిన్తు రాత్రౌ పరమేశ్వరస్య దూతః కారాయా ద్వారం మోచయిత్వా తాన్ బహిరానీయాకథయత్,</para>
  <para style="p">
    <verse number="20" style="v"/>యూయం గత్వా మన్దిరే దణ్డాయమానాః సన్తో లోకాన్ ప్రతీమాం జీవనదాయికాం సర్వ్వాం కథాం ప్రచారయత|</para>
  <para style="p">
    <verse number="21" style="v"/>ఇతి శ్రుత్వా తే ప్రత్యూషే మన్దిర ఉపస్థాయ ఉపదిష్టవన్తః| తదా సహచరగణేన సహితో మహాయాజక ఆగత్య మన్త్రిగణమ్ ఇస్రాయేల్వంశస్య సర్వ్వాన్ రాజసభాసదః సభాస్థాన్ కృత్వా కారాయాస్తాన్ ఆపయితుం పదాతిగణం ప్రేరితవాన్|</para>
  <para style="p">
    <verse number="22" style="v"/>తతస్తే గత్వా కారాయాం తాన్ అప్రాప్య ప్రత్యాగత్య ఇతి వార్త్తామ్ అవాదిషుః,</para>
  <para style="p">
    <verse number="23" style="v"/>వయం తత్ర గత్వా నిర్వ్విఘ్నం కారాయా ద్వారం రుద్ధం రక్షకాంశ్చ ద్వారస్య బహిర్దణ్డాయమానాన్ అదర్శామ ఏవ కిన్తు ద్వారం మోచయిత్వా తన్మధ్యే కమపి ద్రష్టుం న ప్రాప్తాః|</para>
  <para style="p">
    <verse number="24" style="v"/>ఏతాం కథాం శ్రుత్వా మహాయాజకో మన్దిరస్య సేనాపతిః ప్రధానయాజకాశ్చ, ఇత పరం కిమపరం భవిష్యతీతి చిన్తయిత్వా సన్దిగ్ధచిత్తా అభవన్|</para>
  <para style="p">
    <verse number="25" style="v"/>ఏతస్మిన్నేవ సమయే కశ్చిత్ జన ఆగత్య వార్త్తామేతామ్ అవదత్ పశ్యత యూయం యాన్ మానవాన్ కారాయామ్ అస్థాపయత తే మన్దిరే తిష్ఠన్తో లోకాన్ ఉపదిశన్తి|</para>
  <para style="p">
    <verse number="26" style="v"/>తదా మన్దిరస్య సేనాపతిః పదాతయశ్చ తత్ర గత్వా చేల్లోకాః పాషాణాన్ నిక్షిప్యాస్మాన్ మారయన్తీతి భియా వినత్యాచారం తాన్ ఆనయన్|</para>
  <para style="p">
    <verse number="27" style="v"/>తే మహాసభాయా మధ్యే తాన్ అస్థాపయన్ తతః పరం మహాయాజకస్తాన్ అపృచ్ఛత్,</para>
  <para style="p">
    <verse number="28" style="v"/>అనేన నామ్నా సముపదేష్టుం వయం కిం దృఢం న న్యషేధామ? తథాపి పశ్యత యూయం స్వేషాం తేనోపదేశేనే యిరూశాలమం పరిపూర్ణం కృత్వా తస్య జనస్య రక్తపాతజనితాపరాధమ్ అస్మాన్ ప్రత్యానేతుం చేష్టధ్వే|</para>
  <para style="p">
    <verse number="29" style="v"/>తతః పితరోన్యప్రేరితాశ్చ ప్రత్యవదన్ మానుషస్యాజ్ఞాగ్రహణాద్ ఈశ్వరస్యాజ్ఞాగ్రహణమ్ అస్మాకముచితమ్|</para>
  <para style="p">
    <verse number="30" style="v"/>యం యీశుం యూయం క్రుశే వేధిత్వాహత తమ్ అస్మాకం పైతృక ఈశ్వర ఉత్థాప్య</para>
  <para style="p">
    <verse number="31" style="v"/>ఇస్రాయేల్వంశానాం మనఃపరివర్త్తనం పాపక్షమాఞ్చ కర్త్తుం రాజానం పరిత్రాతారఞ్చ కృత్వా స్వదక్షిణపార్శ్వే తస్యాన్నతిమ్ అకరోత్|</para>
  <para style="p">
    <verse number="32" style="v"/>ఏతస్మిన్ వయమపి సాక్షిణ ఆస్మహే, తత్ కేవలం నహి, ఈశ్వర ఆజ్ఞాగ్రాహిభ్యో యం పవిత్రమ్ ఆత్మనం దత్తవాన్ సోపి సాక్ష్యస్తి|</para>
  <para style="p">
    <verse number="33" style="v"/>ఏతద్వాక్యే శ్రుతే తేషాం హృదయాని విద్ధాన్యభవన్ తతస్తే తాన్ హన్తుం మన్త్రితవన్తః|</para>
  <para style="p">
    <verse number="34" style="v"/>ఏతస్మిన్నేవ సమయే తత్సభాస్థానాం సర్వ్వలోకానాం మధ్యే సుఖ్యాతో గమిలీయేల్నామక ఏకో జనో వ్యవస్థాపకః ఫిరూశిలోక ఉత్థాయ ప్రేరితాన్ క్షణార్థం స్థానాన్తరం గన్తుమ్ ఆదిశ్య కథితవాన్,</para>
  <para style="p">
    <verse number="35" style="v"/>హే ఇస్రాయేల్వంశీయాః సర్వ్వే యూయమ్ ఏతాన్ మానుషాన్ ప్రతి యత్ కర్త్తుమ్ ఉద్యతాస్తస్మిన్ సావధానా భవత|</para>
  <para style="p">
    <verse number="36" style="v"/>ఇతః పూర్వ్వం థూదానామైకో జన ఉపస్థాయ స్వం కమపి మహాపురుషమ్ అవదత్, తతః ప్రాయేణ చతుఃశతలోకాస్తస్య మతగ్రాహిణోభవన్ పశ్చాత్ స హతోభవత్ తస్యాజ్ఞాగ్రాహిణో యావన్తో లోకాస్తే సర్వ్వే విర్కీర్ణాః సన్తో ఽకృతకార్య్యా అభవన్|</para>
  <para style="p">
    <verse number="37" style="v"/>తస్మాజ్జనాత్ పరం నామలేఖనసమయే గాలీలీయయిహూదానామైకో జన ఉపస్థాయ బహూల్లోకాన్ స్వమతం గ్రాహీతవాన్ తతః సోపి వ్యనశ్యత్ తస్యాజ్ఞాగ్రాహిణో యావన్తో లోకా ఆసన్ తే సర్వ్వే వికీర్ణా అభవన్|</para>
  <para style="p">
    <verse number="38" style="v"/>అధునా వదామి, యూయమ్ ఏతాన్ మనుష్యాన్ ప్రతి కిమపి న కృత్వా క్షాన్తా భవత, యత ఏష సఙ్కల్ప ఏతత్ కర్మ్మ చ యది మనుష్యాదభవత్ తర్హి విఫలం భవిష్యతి|</para>
  <para style="p">
    <verse number="39" style="v"/>యదీశ్వరాదభవత్ తర్హి యూయం తస్యాన్యథా కర్త్తుం న శక్ష్యథ, వరమ్ ఈశ్వరరోధకా భవిష్యథ|</para>
  <para style="p">
    <verse number="40" style="v"/>తదా తస్య మన్త్రణాం స్వీకృత్య తే ప్రేరితాన్ ఆహూయ ప్రహృత్య యీశో ర్నామ్నా కామపి కథాం కథయితుం నిషిధ్య వ్యసర్జన్|</para>
  <para style="p">
    <verse number="41" style="v"/>కిన్తు తస్య నామార్థం వయం లజ్జాభోగస్య యోగ్యత్వేన గణితా ఇత్యత్ర తే సానన్దాః సన్తః సభాస్థానాం సాక్షాద్ అగచ్ఛన్|</para>
  <para style="p">
    <verse number="42" style="v"/>తతః పరం ప్రతిదినం మన్దిరే గృహే గృహే చావిశ్రామమ్ ఉపదిశ్య యీశుఖ్రీష్టస్య సుసంవాదం ప్రచారితవన్తః|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>తస్మిన్ సమయే శిష్యాణాం బాహుల్యాత్ ప్రాత్యహికదానస్య విశ్రాణనై ర్భిన్నదేశీయానాం విధవాస్త్రీగణ ఉపేక్షితే సతి ఇబ్రీయలోకైః సహాన్యదేశీయానాం వివాద ఉపాతిష్ఠత్|</para>
  <para style="p">
    <verse number="2" style="v"/>తదా ద్వాదశప్రేరితాః సర్వ్వాన్ శిష్యాన్ సంగృహ్యాకథయన్ ఈశ్వరస్య కథాప్రచారం పరిత్యజ్య భోజనగవేషణమ్ అస్మాకమ్ ఉచితం నహి|</para>
  <para style="p">
    <verse number="3" style="v"/>అతో హే భ్రాతృగణ వయమ్ ఏతత్కర్మ్మణో భారం యేభ్యో దాతుం శక్నుమ ఏతాదృశాన్ సుఖ్యాత్యాపన్నాన్ పవిత్రేణాత్మనా జ్ఞానేన చ పూర్ణాన్ సప్ప్రజనాన్ యూయం స్వేషాం మధ్యే మనోనీతాన్ కురుత,</para>
  <para style="p">
    <verse number="4" style="v"/>కిన్తు వయం ప్రార్థనాయాం కథాప్రచారకర్మ్మణి చ నిత్యప్రవృత్తాః స్థాస్యామః|</para>
  <para style="p">
    <verse number="5" style="v"/>ఏతస్యాం కథాయాం సర్వ్వే లోకాః సన్తుష్టాః సన్తః స్వేషాం మధ్యాత్ స్తిఫానః ఫిలిపః ప్రఖరో నికానోర్ తీమన్ పర్మ్మిణా యిహూదిమతగ్రాహీ-ఆన్తియఖియానగరీయో నికలా ఏతాన్ పరమభక్తాన్ పవిత్రేణాత్మనా పరిపూర్ణాన్ సప్త జనాన్</para>
  <para style="p">
    <verse number="6" style="v"/>ప్రేరితానాం సమక్షమ్ ఆనయన్, తతస్తే ప్రార్థనాం కృత్వా తేషాం శిరఃసు హస్తాన్ ఆర్పయన్|</para>
  <para style="p">
    <verse number="7" style="v"/>అపరఞ్చ ఈశ్వరస్య కథా దేశం వ్యాప్నోత్ విశేషతో యిరూశాలమి నగరే శిష్యాణాం సంఖ్యా ప్రభూతరూపేణావర్ద్ధత యాజకానాం మధ్యేపి బహవః ఖ్రీష్టమతగ్రాహిణోఽభవన్|</para>
  <para style="p">
    <verse number="8" style="v"/>స్తిఫానోे విశ్వాసేన పరాక్రమేణ చ పరిపూర్ణః సన్ లోకానాం మధ్యే బహువిధమ్ అద్భుతమ్ ఆశ్చర్య్యం కర్మ్మాకరోత్|</para>
  <para style="p">
    <verse number="9" style="v"/>తేన లిబర్త్తినీయనామ్నా విఖ్యాతసఙ్ఘస్య కతిపయజనాః కురీణీయసికన్దరీయ-కిలికీయాశీయాదేశీయాః కియన్తో జనాశ్చోత్థాయ స్తిఫానేన సార్ద్ధం వ్యవదన్త|</para>
  <para style="p">
    <verse number="10" style="v"/>కిన్తు స్తిఫానో జ్ఞానేన పవిత్రేణాత్మనా చ ఈదృశీం కథాం కథితవాన్ యస్యాస్తే ఆపత్తిం కర్త్తుం నాశక్నువన్|</para>
  <para style="p">
    <verse number="11" style="v"/>పశ్చాత్ తై ర్లోభితాః కతిపయజనాః కథామేనామ్ అకథయన్, వయం తస్య ముఖతో మూసా ఈశ్వరస్య చ నిన్దావాక్యమ్ అశ్రౌష్మ|</para>
  <para style="p">
    <verse number="12" style="v"/>తే లోకానాం లోకప్రాచీనానామ్ అధ్యాపకానాఞ్చ ప్రవృత్తిం జనయిత్వా స్తిఫానస్య సన్నిధిమ్ ఆగత్య తం ధృత్వా మహాసభామధ్యమ్ ఆనయన్|</para>
  <para style="p">
    <verse number="13" style="v"/>తదనన్తరం కతిపయజనేషు మిథ్యాసాక్షిషు సమానీతేషు తేఽకథయన్ ఏష జన ఏతత్పుణ్యస్థానవ్యవస్థయో ర్నిన్దాతః కదాపి న నివర్త్తతే|</para>
  <para style="p">
    <verse number="14" style="v"/>ఫలతో నాసరతీయయీశుః స్థానమేతద్ ఉచ్ఛిన్నం కరిష్యతి మూసాసమర్పితమ్ అస్మాకం వ్యవహరణమ్ అన్యరూపం కరిష్యతి తస్యైతాదృశీం కథాం వయమ్ అశృణుమ|</para>
  <para style="p">
    <verse number="15" style="v"/>తదా మహాసభాస్థాః సర్వ్వే తం ప్రతి స్థిరాం దృష్టిం కృత్వా స్వర్గదూతముఖసదృశం తస్య ముఖమ్ అపశ్యన్|</para>
  <chapter number="7" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>తతః పరం మహాయాజకః పృష్టవాన్, ఏషా కథాం కిం సత్యా?</para>
  <para style="p">
    <verse number="2" style="v"/>తతః స ప్రత్యవదత్, హే పితరో హే భ్రాతరః సర్వ్వే లాకా మనాంసి నిధద్ధ్వం| అస్మాకం పూర్వ్వపురుష ఇబ్రాహీమ్ హారణ్నగరే వాసకరణాత్ పూర్వ్వం యదా అరామ్-నహరయిమదేశే ఆసీత్ తదా తేజోమయ ఈశ్వరో దర్శనం దత్వా</para>
  <para style="p">
    <verse number="3" style="v"/>తమవదత్ త్వం స్వదేశజ్ఞాతిమిత్రాణి పరిత్యజ్య యం దేశమహం దర్శయిష్యామి తం దేశం వ్రజ|</para>
  <para style="p">
    <verse number="4" style="v"/>అతః స కస్దీయదేశం విహాయ హారణ్నగరే న్యవసత్, తదనన్తరం తస్య పితరి మృతే యత్ర దేశే యూయం నివసథ స ఏనం దేశమాగచ్ఛత్|</para>
  <para style="p">
    <verse number="5" style="v"/>కిన్త్వీశ్వరస్తస్మై కమప్యధికారమ్ అర్థాద్ ఏకపదపరిమితాం భూమిమపి నాదదాత్; తదా తస్య కోపి సన్తానో నాసీత్ తథాపి సన్తానైః సార్ద్ధమ్ ఏతస్య దేశస్యాధికారీ త్వం భవిష్యసీతి తమ్ప్రత్యఙ్గీకృతవాన్|</para>
  <para style="p">
    <verse number="6" style="v"/>ఈశ్వర ఇత్థమ్ అపరమపి కథితవాన్ తవ సన్తానాః పరదేశే నివత్స్యన్తి తతస్తద్దేశీయలోకాశ్చతుఃశతవత్సరాన్ యావత్ తాన్ దాసత్వే స్థాపయిత్వా తాన్ ప్రతి కువ్యవహారం కరిష్యన్తి|</para>
  <para style="p">
    <verse number="7" style="v"/>అపరమ్ ఈశ్వర ఏనాం కథామపి కథితవాన్, యే లోకాస్తాన్ దాసత్వే స్థాపయిష్యన్తి తాల్లోకాన్ అహం దణ్డయిష్యామి, తతః పరం తే బహిర్గతాః సన్తో మామ్ అత్ర స్థానే సేవిష్యన్తే|</para>
  <para style="p">
    <verse number="8" style="v"/>పశ్చాత్ స తస్మై త్వక్ఛేదస్య నియమం దత్తవాన్, అత ఇస్హాకనామ్ని ఇబ్రాహీమ ఏకపుత్రే జాతే, అష్టమదినే తస్య త్వక్ఛేదమ్ అకరోత్| తస్య ఇస్హాకః పుత్రో యాకూబ్, తతస్తస్య యాకూబోఽస్మాకం ద్వాదశ పూర్వ్వపురుషా అజాయన్త|</para>
  <para style="p">
    <verse number="9" style="v"/>తే పూర్వ్వపురుషా ఈర్ష్యయా పరిపూర్ణా మిసరదేశం ప్రేషయితుం యూషఫం వ్యక్రీణన్|</para>
  <para style="p">
    <verse number="10" style="v"/>కిన్త్వీశ్వరస్తస్య సహాయో భూత్వా సర్వ్వస్యా దుర్గతే రక్షిత్వా తస్మై బుద్ధిం దత్త్వా మిసరదేశస్య రాజ్ఞః ఫిరౌణః ప్రియపాత్రం కృతవాన్ తతో రాజా మిసరదేశస్య స్వీయసర్వ్వపరివారస్య చ శాసనపదం తస్మై దత్తవాన్|</para>
  <para style="p">
    <verse number="11" style="v"/>తస్మిన్ సమయే మిసర-కినానదేశయో ర్దుర్భిక్షహేతోరతిక్లిష్టత్వాత్ నః పూర్వ్వపురుషా భక్ష్యద్రవ్యం నాలభన్త|</para>
  <para style="p">
    <verse number="12" style="v"/>కిన్తు మిసరదేశే శస్యాని సన్తి, యాకూబ్ ఇమాం వార్త్తాం శ్రుత్వా ప్రథమమ్ అస్మాకం పూర్వ్వపురుషాన్ మిసరం ప్రేషితవాన్|</para>
  <para style="p">
    <verse number="13" style="v"/>తతో ద్వితీయవారగమనే యూషఫ్ స్వభ్రాతృభిః పరిచితోఽభవత్; యూషఫో భ్రాతరః ఫిరౌణ్ రాజేన పరిచితా అభవన్|</para>
  <para style="p">
    <verse number="14" style="v"/>అనన్తరం యూషఫ్ భ్రాతృగణం ప్రేష్య నిజపితరం యాకూబం నిజాన్ పఞ్చాధికసప్తతిసంఖ్యకాన్ జ్ఞాతిజనాంశ్చ సమాహూతవాన్|</para>
  <para style="p">
    <verse number="15" style="v"/>తస్మాద్ యాకూబ్ మిసరదేశం గత్వా స్వయమ్ అస్మాకం పూర్వ్వపురుషాశ్చ తస్మిన్ స్థానేఽమ్రియన్త|</para>
  <para style="p">
    <verse number="16" style="v"/>తతస్తే శిఖిమం నీతా యత్ శ్మశానమ్ ఇబ్రాహీమ్ ముద్రాదత్వా శిఖిమః పితు ర్హమోరః పుత్రేభ్యః క్రీతవాన్ తత్శ్మశానే స్థాపయాఞ్చక్రిరే|</para>
  <para style="p">
    <verse number="17" style="v"/>తతః పరమ్ ఈశ్వర ఇబ్రాహీమః సన్నిధౌ శపథం కృత్వా యాం ప్రతిజ్ఞాం కృతవాన్ తస్యాః ప్రతిజ్ఞాయాః ఫలనసమయే నికటే సతి ఇస్రాయేల్లోకా సిమరదేశే వర్ద్ధమానా బహుసంఖ్యా అభవన్|</para>
  <para style="p">
    <verse number="18" style="v"/>శేషే యూషఫం యో న పరిచినోతి తాదృశ ఏకో నరపతిరుపస్థాయ</para>
  <para style="p">
    <verse number="19" style="v"/>అస్మాకం జ్ఞాతిభిః సార్ద్ధం ధూర్త్తతాం విధాయ పూర్వ్వపురుషాన్ ప్రతి కువ్యవహరణపూర్వ్వకం తేషాం వంశనాశనాయ తేషాం నవజాతాన్ శిశూన్ బహి ర్నిరక్షేపయత్|</para>
  <para style="p">
    <verse number="20" style="v"/>ఏతస్మిన్ సమయే మూసా జజ్ఞే, స తు పరమసున్దరోఽభవత్ తథా పితృగృహే మాసత్రయపర్య్యన్తం పాలితోఽభవత్|</para>
  <para style="p">
    <verse number="21" style="v"/>కిన్తు తస్మిన్ బహిర్నిక్షిప్తే సతి ఫిరౌణరాజస్య కన్యా తమ్ ఉత్తోల్య నీత్వా దత్తకపుత్రం కృత్వా పాలితవతీ|</para>
  <para style="p">
    <verse number="22" style="v"/>తస్మాత్ స మూసా మిసరదేశీయాయాః సర్వ్వవిద్యాయాః పారదృష్వా సన్ వాక్యే క్రియాయాఞ్చ శక్తిమాన్ అభవత్|</para>
  <para style="p">
    <verse number="23" style="v"/>స సమ్పూర్ణచత్వారింశద్వత్సరవయస్కో భూత్వా ఇస్రాయేలీయవంశనిజభ్రాతృన్ సాక్షాత్ కర్తుం మతిం చక్రే|</para>
  <para style="p">
    <verse number="24" style="v"/>తేషాం జనమేకం హింసితం దృష్ట్వా తస్య సపక్షః సన్ హింసితజనమ్ ఉపకృత్య మిసరీయజనం జఘాన|</para>
  <para style="p">
    <verse number="25" style="v"/>తస్య హస్తేనేశ్వరస్తాన్ ఉద్ధరిష్యతి తస్య భ్రాతృగణ ఇతి జ్ఞాస్యతి స ఇత్యనుమానం చకార, కిన్తు తే న బుబుధిరే|</para>
  <para style="p">
    <verse number="26" style="v"/>తత్పరే ఽహని తేషామ్ ఉభయో ర్జనయో ర్వాక్కలహ ఉపస్థితే సతి మూసాః సమీపం గత్వా తయో ర్మేలనం కర్త్తుం మతిం కృత్వా కథయామాస, హే మహాశయౌ యువాం భ్రాతరౌ పరస్పరమ్ అన్యాయం కుతః కురుథః?</para>
  <para style="p">
    <verse number="27" style="v"/>తతః సమీపవాసినం ప్రతి యో జనోఽన్యాయం చకార స తం దూరీకృత్య కథయామాస, అస్మాకముపరి శాస్తృత్వవిచారయితృత్వపదయోః కస్త్వాం నియుక్తవాన్?</para>
  <para style="p">
    <verse number="28" style="v"/>హ్యో యథా మిసరీయం హతవాన్ తథా కిం మామపి హనిష్యసి?</para>
  <para style="p">
    <verse number="29" style="v"/>తదా మూసా ఏతాదృశీం కథాం శ్రుత్వా పలాయనం చక్రే, తతో మిదియనదేశం గత్వా ప్రవాసీ సన్ తస్థౌ, తతస్తత్ర ద్వౌ పుత్రౌ జజ్ఞాతే|</para>
  <para style="p">
    <verse number="30" style="v"/>అనన్తరం చత్వారింశద్వత్సరేషు గతేషు సీనయపర్వ్వతస్య ప్రాన్తరే ప్రజ్వలితస్తమ్బస్య వహ్నిశిఖాయాం పరమేశ్వరదూతస్తస్మై దర్శనం దదౌ|</para>
  <para style="p">
    <verse number="31" style="v"/>మూసాస్తస్మిన్ దర్శనే విస్మయం మత్వా విశేషం జ్ఞాతుం నికటం గచ్ఛతి,</para>
  <para style="p">
    <verse number="32" style="v"/>ఏతస్మిన్ సమయే, అహం తవ పూర్వ్వపురుషాణామ్ ఈశ్వరోఽర్థాద్ ఇబ్రాహీమ ఈశ్వర ఇస్హాక ఈశ్వరో యాకూబ ఈశ్వరశ్చ, మూసాముద్దిశ్య పరమేశ్వరస్యైతాదృశీ విహాయసీయా వాణీ బభూవ, తతః స కమ్పాన్వితః సన్ పున ర్నిరీక్షితుం ప్రగల్భో న బభూవ|</para>
  <para style="p">
    <verse number="33" style="v"/>పరమేశ్వరస్తం జగాద, తవ పాదయోః పాదుకే మోచయ యత్ర తిష్ఠసి సా పవిత్రభూమిః|</para>
  <para style="p">
    <verse number="34" style="v"/>అహం మిసరదేశస్థానాం నిజలోకానాం దుర్ద్దశాం నితాన్తమ్ అపశ్యం, తేషాం కాతర్య్యోక్తిఞ్చ శ్రుతవాన్ తస్మాత్ తాన్ ఉద్ధర్త్తుమ్ అవరుహ్యాగమమ్; ఇదానీమ్ ఆగచ్ఛ మిసరదేశం త్వాం ప్రేషయామి|</para>
  <para style="p">
    <verse number="35" style="v"/>కస్త్వాం శాస్తృత్వవిచారయితృత్వపదయో ర్నియుక్తవాన్, ఇతి వాక్యముక్త్వా తై ర్యో మూసా అవజ్ఞాతస్తమేవ ఈశ్వరః స్తమ్బమధ్యే దర్శనదాత్రా తేన దూతేన శాస్తారం ముక్తిదాతారఞ్చ కృత్వా ప్రేషయామాస|</para>
  <para style="p">
    <verse number="36" style="v"/>స చ మిసరదేశే సూఫ్నామ్ని సముద్రే చ పశ్చాత్ చత్వారింశద్వత్సరాన్ యావత్ మహాప్రాన్తరే నానాప్రకారాణ్యద్భుతాని కర్మ్మాణి లక్షణాని చ దర్శయిత్వా తాన్ బహిః కృత్వా సమానినాయ|</para>
  <para style="p">
    <verse number="37" style="v"/>ప్రభుః పరమేశ్వరో యుష్మాకం భ్రాతృగణస్య మధ్యే మాదృశమ్ ఏకం భవిష్యద్వక్తారమ్ ఉత్పాదయిష్యతి తస్య కథాయాం యూయం మనో నిధాస్యథ, యో జన ఇస్రాయేలః సన్తానేభ్య ఏనాం కథాం కథయామాస స ఏష మూసాః|</para>
  <para style="p">
    <verse number="38" style="v"/>మహాప్రాన్తరస్థమణ్డలీమధ్యేఽపి స ఏవ సీనయపర్వ్వతోపరి తేన సార్ద్ధం సంలాపినో దూతస్య చాస్మత్పితృగణస్య మధ్యస్థః సన్ అస్మభ్యం దాతవ్యని జీవనదాయకాని వాక్యాని లేభే|</para>
  <para style="p">
    <verse number="39" style="v"/>అస్మాకం పూర్వ్వపురుషాస్తమ్ అమాన్యం కత్వా స్వేభ్యో దూరీకృత్య మిసరదేశం పరావృత్య గన్తుం మనోభిరభిలష్య హారోణం జగదుః,</para>
  <para style="p">
    <verse number="40" style="v"/>అస్మాకమ్ అగ్రేఽగ్రే గన్తుुమ్ అస్మదర్థం దేవగణం నిర్మ్మాహి యతో యో మూసా అస్మాన్ మిసరదేశాద్ బహిః కృత్వానీతవాన్ తస్య కిం జాతం తదస్మాభి ర్న జ్ఞాయతే|</para>
  <para style="p">
    <verse number="41" style="v"/>తస్మిన్ సమయే తే గోవత్సాకృతిం ప్రతిమాం నిర్మ్మాయ తాముద్దిశ్య నైవేద్యముత్మృజ్య స్వహస్తకృతవస్తునా ఆనన్దితవన్తః|</para>
  <para style="p">
    <verse number="42" style="v"/>తస్మాద్ ఈశ్వరస్తేషాం ప్రతి విముఖః సన్ ఆకాశస్థం జ్యోతిర్గణం పూజయితుం తేభ్యోఽనుమతిం దదౌ, యాదృశం భవిష్యద్వాదినాం గ్రన్థేషు లిఖితమాస్తే, యథా, ఇస్రాయేలీయవంశా రే చత్వారింశత్సమాన్ పురా| మహతి ప్రాన్తరే సంస్థా యూయన్తు యాని చ| బలిహోమాదికర్మ్మాణి కృతవన్తస్తు తాని కిం| మాం సముద్దిశ్య యుష్మాభిః ప్రకృతానీతి నైవ చ|</para>
  <para style="p">
    <verse number="43" style="v"/>కిన్తు వో మోలకాఖ్యస్య దేవస్య దూష్యమేవ చ| యుష్మాకం రిమ్ఫనాఖ్యాయా దేవతాయాశ్చ తారకా| ఏతయోరుభయో ర్మూర్తీ యుష్మాభిః పరిపూజితే| అతో యుష్మాంస్తు బాబేలః పారం నేష్యామి నిశ్చితం|</para>
  <para style="p">
    <verse number="44" style="v"/>అపరఞ్చ యన్నిదర్శనమ్ అపశ్యస్తదనుసారేణ దూష్యం నిర్మ్మాహి యస్మిన్ ఈశ్వరో మూసామ్ ఏతద్వాక్యం బభాషే తత్ తస్య నిరూపితం సాక్ష్యస్వరూపం దూష్యమ్ అస్మాకం పూర్వ్వపురుషైః సహ ప్రాన్తరే తస్థౌ|</para>
  <para style="p">
    <verse number="45" style="v"/>పశ్చాత్ యిహోశూయేన సహితైస్తేషాం వంశజాతైరస్మత్పూర్వ్వపురుషైః స్వేషాం సమ్ముఖాద్ ఈశ్వరేణ దూరీకృతానామ్ అన్యదేశీయానాం దేశాధికృతికాలే సమానీతం తద్ దూష్యం దాయూదోధికారం యావత్ తత్ర స్థాన ఆసీత్|</para>
  <para style="p">
    <verse number="46" style="v"/>స దాయూద్ పరమేశ్వరస్యానుగ్రహం ప్రాప్య యాకూబ్ ఈశ్వరార్థమ్ ఏకం దూష్యం నిర్మ్మాతుం వవాఞ్ఛ;</para>
  <para style="p">
    <verse number="47" style="v"/>కిన్తు సులేమాన్ తదర్థం మన్దిరమ్ ఏకం నిర్మ్మితవాన్|</para>
  <para style="p">
    <verse number="48" style="v"/>తథాపి యః సర్వ్వోపరిస్థః స కస్మింశ్చిద్ హస్తకృతే మన్దిరే నివసతీతి నహి, భవిష్యద్వాదీ కథామేతాం కథయతి, యథా,</para>
  <para style="p">
    <verse number="49" style="v"/>పరేశో వదతి స్వర్గో రాజసింహాసనం మమ| మదీయం పాదపీఠఞ్చ పృథివీ భవతి ధ్రువం| తర్హి యూయం కృతే మే కిం ప్రనిర్మ్మాస్యథ మన్దిరం| విశ్రామాయ మదీయం వా స్థానం కిం విద్యతే త్విహ|</para>
  <para style="p">
    <verse number="50" style="v"/>సర్వ్వాణ్యేతాని వస్తూని కిం మే హస్తకృతాని న||</para>
  <para style="p">
    <verse number="51" style="v"/>హే అనాజ్ఞాగ్రాహకా అన్తఃకరణే శ్రవణే చాపవిత్రలోకాః యూయమ్ అనవరతం పవిత్రస్యాత్మనః ప్రాతికూల్యమ్ ఆచరథ, యుష్మాకం పూర్వ్వపురుషా యాదృశా యూయమపి తాదృశాః|</para>
  <para style="p">
    <verse number="52" style="v"/>యుష్మాకం పూర్వ్వపురుషాః కం భవిష్యద్వాదినం నాతాడయన్? యే తస్య ధార్మ్మికస్య జనస్యాగమనకథాం కథితవన్తస్తాన్ అఘ్నన్ యూయమ్ అధూనా విశ్వాసఘాతినో భూత్వా తం ధార్మ్మికం జనమ్ అహత|</para>
  <para style="p">
    <verse number="53" style="v"/>యూయం స్వర్గీయదూతగణేన వ్యవస్థాం ప్రాప్యాపి తాం నాచరథ|</para>
  <para style="p">
    <verse number="54" style="v"/>ఇమాం కథాం శ్రుత్వా తే మనఃసు బిద్ధాః సన్తస్తం ప్రతి దన్తఘర్షణమ్ అకుర్వ్వన్|</para>
  <para style="p">
    <verse number="55" style="v"/>కిన్తు స్తిఫానః పవిత్రేణాత్మనా పూర్ణో భూత్వా గగణం ప్రతి స్థిరదృష్టిం కృత్వా ఈశ్వరస్య దక్షిణే దణ్డాయమానం యీశుఞ్చ విలోక్య కథితవాన్;</para>
  <para style="p">
    <verse number="56" style="v"/>పశ్య,మేఘద్వారం ముక్తమ్ ఈశ్వరస్య దక్షిణే స్థితం మానవసుతఞ్చ పశ్యామి|</para>
  <para style="p">
    <verse number="57" style="v"/>తదా తే ప్రోచ్చైః శబ్దం కృత్వా కర్ణేష్వఙ్గులీ ర్నిధాయ ఏకచిత్తీభూయ తమ్ ఆక్రమన్|</para>
  <para style="p">
    <verse number="58" style="v"/>పశ్చాత్ తం నగరాద్ బహిః కృత్వా ప్రస్తరైరాఘ్నన్ సాక్షిణో లాకాః శౌలనామ్నో యూనశ్చరణసన్నిధౌ నిజవస్త్రాణి స్థాపితవన్తః|</para>
  <para style="p">
    <verse number="59" style="v"/>అనన్తరం హే ప్రభో యీశే మదీయమాత్మానం గృహాణ స్తిఫానస్యేతి ప్రార్థనవాక్యవదనసమయే తే తం ప్రస్తరైరాఘ్నన్|</para>
  <para style="p">
    <verse number="60" style="v"/>తస్మాత్ స జానునీ పాతయిత్వా ప్రోచ్చైః శబ్దం కృత్వా, హే ప్రభే పాపమేతద్ ఏతేషు మా స్థాపయ, ఇత్యుక్త్వా మహానిద్రాం ప్రాప్నోత్|</para>
  <chapter number="8" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>తస్య హత్యాకరణం శౌలోపి సమమన్యత| తస్మిన్ సమయే యిరూశాలమ్నగరస్థాం మణ్డలీం ప్రతి మహాతాడనాయాం జాతాయాం ప్రేరితలోకాన్ హిత్వా సర్వ్వేఽపరే యిహూదాశోమిరోణదేశయో ర్నానాస్థానే వికీర్ణాః సన్తో గతాః|</para>
  <para style="p">
    <verse number="2" style="v"/>అన్యచ్చ భక్తలోకాస్తం స్తిఫానం శ్మశానే స్థాపయిత్వా బహు వ్యలపన్|</para>
  <para style="p">
    <verse number="3" style="v"/>కిన్తు శౌలో గృహే గృహే భ్రమిత్వా స్త్రియః పురుషాంశ్చ ధృత్వా కారాయాం బద్ధ్వా మణ్డల్యా మహోత్పాతం కృతవాన్|</para>
  <para style="p">
    <verse number="4" style="v"/>అన్యచ్చ యే వికీర్ణా అభవన్ తే సర్వ్వత్ర భ్రమిత్వా సుసంవాదం ప్రాచారయన్|</para>
  <para style="p">
    <verse number="5" style="v"/>తదా ఫిలిపః శోమిరోణ్నగరం గత్వా ఖ్రీష్టాఖ్యానం ప్రాచారయత్;</para>
  <para style="p">
    <verse number="6" style="v"/>తతోఽశుచి-భృతగ్రస్తలోకేభ్యో భూతాశ్చీత్కృత్యాగచ్ఛన్ తథా బహవః పక్షాఘాతినః ఖఞ్జా లోకాశ్చ స్వస్థా అభవన్|</para>
  <para style="p">
    <verse number="7" style="v"/>తస్మాత్ లాకా ఈదృశం తస్యాశ్చర్య్యం కర్మ్మ విలోక్య నిశమ్య చ సర్వ్వ ఏకచిత్తీభూయ తేనోక్తాఖ్యానే మనాంసి న్యదధుః|</para>
  <para style="p">
    <verse number="8" style="v"/>తస్మిన్నగరే మహానన్దశ్చాభవత్|</para>
  <para style="p">
    <verse number="9" style="v"/>తతః పూర్వ్వం తస్మిన్నగరే శిమోన్నామా కశ్చిజ్జనో బహ్వీ ర్మాయాక్రియాః కృత్వా స్వం కఞ్చన మహాపురుషం ప్రోచ్య శోమిరోణీయానాం మోహం జనయామాస|</para>
  <para style="p">
    <verse number="10" style="v"/>తస్మాత్ స మానుష ఈశ్వరస్య మహాశక్తిస్వరూప ఇత్యుక్త్వా బాలవృద్ధవనితాః సర్వ్వే లాకాస్తస్మిన్ మనాంసి న్యదధుః|</para>
  <para style="p">
    <verse number="11" style="v"/>స బహుకాలాన్ మాయావిక్రియయా సర్వ్వాన్ అతీవ మోహయాఞ్చకార, తస్మాత్ తే తం మేనిరే|</para>
  <para style="p">
    <verse number="12" style="v"/>కిన్త్వీశ్వరస్య రాజ్యస్య యీశుఖ్రీష్టస్య నామ్నశ్చాఖ్యానప్రచారిణః ఫిలిపస్య కథాయాం విశ్వస్య తేషాం స్త్రీపురుషోభయలోకా మజ్జితా అభవన్|</para>
  <para style="p">
    <verse number="13" style="v"/>శేషే స శిమోనపి స్వయం ప్రత్యైత్ తతో మజ్జితః సన్ ఫిలిపేన కృతామ్ ఆశ్చర్య్యక్రియాం లక్షణఞ్చ విలోక్యాసమ్భవం మన్యమానస్తేన సహ స్థితవాన్|</para>
  <para style="p">
    <verse number="14" style="v"/>ఇత్థం శోమిరోణ్దేశీయలోకా ఈశ్వరస్య కథామ్ అగృహ్లన్ ఇతి వార్త్తాం యిరూశాలమ్నగరస్థప్రేరితాః ప్రాప్య పితరం యోహనఞ్చ తేషాం నికటే ప్రేషితవన్తః|</para>
  <para style="p">
    <verse number="15" style="v"/>తతస్తౌ తత్ స్థానమ్ ఉపస్థాయ లోకా యథా పవిత్రమ్ ఆత్మానం ప్రాప్నువన్తి తదర్థం ప్రార్థయేతాం|</para>
  <para style="p">
    <verse number="16" style="v"/>యతస్తే పురా కేవలప్రభుయీశో ర్నామ్నా మజ్జితమాత్రా అభవన్, న తు తేషాం మధ్యే కమపి ప్రతి పవిత్రస్యాత్మన ఆవిర్భావో జాతః|</para>
  <para style="p">
    <verse number="17" style="v"/>కిన్తు ప్రేరితాభ్యాం తేషాం గాత్రేషు కరేష్వర్పితేషు సత్సు తే పవిత్రమ్ ఆత్మానమ్ ప్రాప్నువన్|</para>
  <para style="p">
    <verse number="18" style="v"/>ఇత్థం లోకానాం గాత్రేషు ప్రేరితయోః కరార్పణేన తాన్ పవిత్రమ్ ఆత్మానం ప్రాప్తాన్ దృష్ట్వా స శిమోన్ తయోః సమీపే ముద్రా ఆనీయ కథితవాన్;</para>
  <para style="p">
    <verse number="19" style="v"/>అహం యస్య గాత్రే హస్తమ్ అర్పయిష్యామి తస్యాపి యథేత్థం పవిత్రాత్మప్రాప్తి ర్భవతి తాదృశీం శక్తిం మహ్యం దత్తం|</para>
  <para style="p">
    <verse number="20" style="v"/>కిన్తు పితరస్తం ప్రత్యవదత్ తవ ముద్రాస్త్వయా వినశ్యన్తు యత ఈశ్వరస్య దానం ముద్రాభిః క్రీయతే త్వమిత్థం బుద్ధవాన్;</para>
  <para style="p">
    <verse number="21" style="v"/>ఈశ్వరాయ తావన్తఃకరణం సరలం నహి, తస్మాద్ అత్ర తవాంశోఽధికారశ్చ కోపి నాస్తి|</para>
  <para style="p">
    <verse number="22" style="v"/>అత ఏతత్పాపహేతోః ఖేదాన్వితః సన్ కేనాపి ప్రకారేణ తవ మనస ఏతస్యాః కుకల్పనాయాః క్షమా భవతి, ఏతదర్థమ్ ఈశ్వరే ప్రార్థనాం కురు;</para>
  <para style="p">
    <verse number="23" style="v"/>యతస్త్వం తిక్తపిత్తే పాపస్య బన్ధనే చ యదసి తన్మయా బుద్ధమ్|</para>
  <para style="p">
    <verse number="24" style="v"/>తదా శిమోన్ అకథయత్ తర్హి యువాభ్యాముదితా కథా మయి యథా న ఫలతి తదర్థం యువాం మన్నిమిత్తం ప్రభౌ ప్రార్థనాం కురుతం|</para>
  <para style="p">
    <verse number="25" style="v"/>అనేన ప్రకారేణ తౌ సాక్ష్యం దత్త్వా ప్రభోః కథాం ప్రచారయన్తౌ శోమిరోణీయానామ్ అనేకగ్రామేషు సుసంవాదఞ్చ ప్రచారయన్తౌ యిరూశాలమ్నగరం పరావృత్య గతౌ|</para>
  <para style="p">
    <verse number="26" style="v"/>తతః పరమ్ ఈశ్వరస్య దూతః ఫిలిపమ్ ఇత్యాదిశత్, త్వముత్థాయ దక్షిణస్యాం దిశి యో మార్గో ప్రాన్తరస్య మధ్యేన యిరూశాలమో ఽసానగరం యాతి తం మార్గం గచ్ఛ|</para>
  <para style="p">
    <verse number="27" style="v"/>తతః స ఉత్థాయ గతవాన్; తదా కన్దాకీనామ్నః కూశ్లోకానాం రాజ్ఞ్యాః సర్వ్వసమ్పత్తేరధీశః కూశదేశీయ ఏకః షణ్డో భజనార్థం యిరూశాలమ్నగరమ్ ఆగత్య</para>
  <para style="p">
    <verse number="28" style="v"/>పునరపి రథమారుహ్య యిశయియనామ్నో భవిష్యద్వాదినో గ్రన్థం పఠన్ ప్రత్యాగచ్ఛతి|</para>
  <para style="p">
    <verse number="29" style="v"/>ఏతస్మిన్ సమయే ఆత్మా ఫిలిపమ్ అవదత్, త్వమ్ రథస్య సమీపం గత్వా తేన సార్ద్ధం మిల|</para>
  <para style="p">
    <verse number="30" style="v"/>తస్మాత్ స ధావన్ తస్య సన్నిధావుపస్థాయ తేన పఠ్యమానం యిశయియథవిష్యద్వాదినో వాక్యం శ్రుత్వా పృష్టవాన్ యత్ పఠసి తత్ కిం బుధ్యసే?</para>
  <para style="p">
    <verse number="31" style="v"/>తతః స కథితవాన్ కేనచిన్న బోధితోహం కథం బుధ్యేయ? తతః స ఫిలిపం రథమారోఢుం స్వేన సార్ద్ధమ్ ఉపవేష్టుఞ్చ న్యవేదయత్|</para>
  <para style="p">
    <verse number="32" style="v"/>స శాస్త్రస్యేతద్వాక్యం పఠితవాన్ యథా, సమానీయత ఘాతాయ స యథా మేషశావకః| లోమచ్ఛేదకసాక్షాచ్చ మేషశ్చ నీరవో యథా| ఆబధ్య వదనం స్వీయం తథా స సమతిష్ఠత|</para>
  <para style="p">
    <verse number="33" style="v"/>అన్యాయేన విచారేణ స ఉచ్ఛిన్నో ఽభవత్ తదా| తత్కాలీనమనుష్యాన్ కో జనో వర్ణయితుం క్షమః| యతో జీవన్నృణాం దేశాత్ స ఉచ్ఛిన్నో ఽభవత్ ధ్రువం|</para>
  <para style="p">
    <verse number="34" style="v"/>అనన్తరం స ఫిలిపమ్ అవదత్ నివేదయామి, భవిష్యద్వాదీ యామిమాం కథాం కథయామాస స కిం స్వస్మిన్ వా కస్మింశ్చిద్ అన్యస్మిన్?</para>
  <para style="p">
    <verse number="35" style="v"/>తతః ఫిలిపస్తత్ప్రకరణమ్ ఆరభ్య యీశోరుపాఖ్యానం తస్యాగ్రే ప్రాస్తౌత్|</para>
  <para style="p">
    <verse number="36" style="v"/>ఇత్థం మార్గేణ గచ్ఛన్తౌ జలాశయస్య సమీప ఉపస్థితౌ; తదా క్లీబోఽవాదీత్ పశ్యాత్ర స్థానే జలమాస్తే మమ మజ్జనే కా బాధా?</para>
  <para style="p">
    <verse number="37" style="v"/>తతః ఫిలిప ఉత్తరం వ్యాహరత్ స్వాన్తఃకరణేన సాకం యది ప్రత్యేషి తర్హి బాధా నాస్తి| తతః స కథితవాన్ యీశుఖ్రీష్ట ఈశ్వరస్య పుత్ర ఇత్యహం ప్రత్యేమి|</para>
  <para style="p">
    <verse number="38" style="v"/>తదా రథం స్థగితం కర్త్తుమ్ ఆదిష్టే ఫిలిపక్లీబౌ ద్వౌ జలమ్ అవారుహతాం; తదా ఫిలిపస్తమ్ మజ్జయామాస|</para>
  <para style="p">
    <verse number="39" style="v"/>తత్పశ్చాత్ జలమధ్యాద్ ఉత్థితయోః సతోః పరమేశ్వరస్యాత్మా ఫిలిపం హృత్వా నీతవాన్, తస్మాత్ క్లీబః పునస్తం న దృష్టవాన్ తథాపి హృష్టచిత్తః సన్ స్వమార్గేణ గతవాన్|</para>
  <para style="p">
    <verse number="40" style="v"/>ఫిలిపశ్చాస్దోద్నగరమ్ ఉపస్థాయ తస్మాత్ కైసరియానగర ఉపస్థితికాలపర్య్యనతం సర్వ్వస్మిన్నగరే సుసంవాదం ప్రచారయన్ గతవాన్|</para>
  <chapter number="9" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>తత్కాలపర్య్యనతం శౌలః ప్రభోః శిష్యాణాం ప్రాతికూల్యేన తాడనాబధయోః కథాం నిఃసారయన్ మహాయాజకస్య సన్నిధిం గత్వా</para>
  <para style="p">
    <verse number="2" style="v"/>స్త్రియం పురుషఞ్చ తన్మతగ్రాహిణం యం కఞ్చిత్ పశ్యతి తాన్ ధృత్వా బద్ధ్వా యిరూశాలమమ్ ఆనయతీత్యాశయేన దమ్మేషక్నగరీయం ధర్మ్మసమాజాన్ ప్రతి పత్రం యాచితవాన్|</para>
  <para style="p">
    <verse number="3" style="v"/>గచ్ఛన్ తు దమ్మేషక్నగరనికట ఉపస్థితవాన్; తతోఽకస్మాద్ ఆకాశాత్ తస్య చతుర్దిక్షు తేజసః ప్రకాశనాత్ స భూమావపతత్|</para>
  <para style="p">
    <verse number="4" style="v"/>పశ్చాత్ హే శౌల హే శౌల కుతో మాం తాడయసి? స్వం ప్రతి ప్రోక్తమ్ ఏతం శబ్దం శ్రుత్వా</para>
  <para style="p">
    <verse number="5" style="v"/>స పృష్టవాన్, హే ప్రభో భవాన్ కః? తదా ప్రభురకథయత్ యం యీశుం త్వం తాడయసి స ఏవాహం; కణ్టకస్య ముఖే పదాఘాతకరణం తవ కష్టమ్|</para>
  <para style="p">
    <verse number="6" style="v"/>తదా కమ్పమానో విస్మయాపన్నశ్చ సోవదత్ హే ప్రభో మయా కిం కర్త్తవ్యం? భవత ఇచ్ఛా కా? తతః ప్రభురాజ్ఞాపయద్ ఉత్థాయ నగరం గచ్ఛ తత్ర త్వయా యత్ కర్త్తవ్యం తద్ వదిష్యతే|</para>
  <para style="p">
    <verse number="7" style="v"/>తస్య సఙ్గినో లోకా అపి తం శబ్దం శ్రుతవన్తః కిన్తు కమపి న దృష్ట్వా స్తబ్ధాః సన్తః స్థితవన్తః|</para>
  <para style="p">
    <verse number="8" style="v"/>అనన్తరం శౌలో భూమిత ఉత్థాయ చక్షుషీ ఉన్మీల్య కమపి న దృష్టవాన్| తదా లోకాస్తస్య హస్తౌ ధృత్వా దమ్మేషక్నగరమ్ ఆనయన్|</para>
  <para style="p">
    <verse number="9" style="v"/>తతః స దినత్రయం యావద్ అన్ధో భూత్వా న భుక్తవాన్ పీతవాంశ్చ|</para>
  <para style="p">
    <verse number="10" style="v"/>తదనన్తరం ప్రభుస్తద్దమ్మేషక్నగరవాసిన ఏకస్మై శిష్యాయ దర్శనం దత్వా ఆహూతవాన్ హే అననియ| తతః స ప్రత్యవాదీత్, హే ప్రభో పశ్య శృణోమి|</para>
  <para style="p">
    <verse number="11" style="v"/>తదా ప్రభుస్తమాజ్ఞాపయత్ త్వముత్థాయ సరలనామానం మార్గం గత్వా యిహూదానివేశనే తార్షనగరీయం శౌలనామానం జనం గవేషయన్ పృచ్ఛ;</para>
  <para style="p">
    <verse number="12" style="v"/>పశ్య స ప్రార్థయతే, తథా అననియనామక ఏకో జనస్తస్య సమీపమ్ ఆగత్య తస్య గాత్రే హస్తార్పణం కృత్వా దృష్టిం దదాతీత్థం స్వప్నే దృష్టవాన్|</para>
  <para style="p">
    <verse number="13" style="v"/>తస్మాద్ అననియః ప్రత్యవదత్ హే ప్రభో యిరూశాలమి పవిత్రలోకాన్ ప్రతి సోఽనేకహింసాం కృతవాన్;</para>
  <para style="p">
    <verse number="14" style="v"/>అత్ర స్థానే చ యే లోకాస్తవ నామ్ని ప్రార్థయన్తి తానపి బద్ధుం స ప్రధానయాజకేభ్యః శక్తిం ప్రాప్తవాన్, ఇమాం కథామ్ అహమ్ అనేకేషాం ముఖేభ్యః శ్రుతవాన్|</para>
  <para style="p">
    <verse number="15" style="v"/>కిన్తు ప్రభురకథయత్, యాహి భిన్నదేశీయలోకానాం భూపతీనామ్ ఇస్రాయేల్లోకానాఞ్చ నికటే మమ నామ ప్రచారయితుం స జనో మమ మనోనీతపాత్రమాస్తే|</para>
  <para style="p">
    <verse number="16" style="v"/>మమ నామనిమిత్తఞ్చ తేన కియాన్ మహాన్ క్లేశో భోక్తవ్య ఏతత్ తం దర్శయిష్యామి|</para>
  <para style="p">
    <verse number="17" style="v"/>తతో ఽననియో గత్వా గృహం ప్రవిశ్య తస్య గాత్రే హస్తార్ప్రణం కృత్వా కథితవాన్, హే భ్రాతః శౌల త్వం యథా దృష్టిం ప్రాప్నోషి పవిత్రేణాత్మనా పరిపూర్ణో భవసి చ, తదర్థం తవాగమనకాలే యః ప్రభుయీశుస్తుభ్యం దర్శనమ్ అదదాత్ స మాం ప్రేషితవాన్|</para>
  <para style="p">
    <verse number="18" style="v"/>ఇత్యుక్తమాత్రే తస్య చక్షుర్భ్యామ్ మీనశల్కవద్ వస్తుని నిర్గతే తత్క్షణాత్ స ప్రసన్నచక్షు ర్భూత్వా ప్రోత్థాయ మజ్జితోఽభవత్ భుక్త్వా పీత్వా సబలోభవచ్చ|</para>
  <para style="p">
    <verse number="19" style="v"/>తతః పరం శౌలః శిష్యైః సహ కతిపయదివసాన్ తస్మిన్ దమ్మేషకనగరే స్థిత్వాఽవిలమ్బం</para>
  <para style="p">
    <verse number="20" style="v"/>సర్వ్వభజనభవనాని గత్వా యీశురీశ్వరస్య పుత్ర ఇమాం కథాం ప్రాచారయత్|</para>
  <para style="p">
    <verse number="21" style="v"/>తస్మాత్ సర్వ్వే శ్రోతారశ్చమత్కృత్య కథితవన్తో యో యిరూశాలమ్నగర ఏతన్నామ్నా ప్రార్థయితృలోకాన్ వినాశితవాన్ ఏవమ్ ఏతాదృశలోకాన్ బద్ధ్వా ప్రధానయాజకనికటం నయతీత్యాశయా ఏతత్స్థానమప్యాగచ్ఛత్ సఏవ కిమయం న భవతి?</para>
  <para style="p">
    <verse number="22" style="v"/>కిన్తు శౌలః క్రమశ ఉత్సాహవాన్ భూత్వా యీశురీశ్వరేణాభిషిక్తో జన ఏతస్మిన్ ప్రమాణం దత్వా దమ్మేషక్-నివాసియిహూదీయలోకాన్ నిరుత్తరాన్ అకరోత్|</para>
  <para style="p">
    <verse number="23" style="v"/>ఇత్థం బహుతిథే కాలే గతే యిహూదీయలోకాస్తం హన్తుం మన్త్రయామాసుః</para>
  <para style="p">
    <verse number="24" style="v"/>కిన్తు శౌలస్తేషామేతస్యా మన్త్రణాయా వార్త్తాం ప్రాప్తవాన్| తే తం హన్తుం తు దివానిశం గుప్తాః సన్తో నగరస్య ద్వారేఽతిష్ఠన్;</para>
  <para style="p">
    <verse number="25" style="v"/>తస్మాత్ శిష్యాస్తం నీత్వా రాత్రౌ పిటకే నిధాయ ప్రాచీరేణావారోహయన్|</para>
  <para style="p">
    <verse number="26" style="v"/>తతః పరం శౌలో యిరూశాలమం గత్వా శిష్యగణేన సార్ద్ధం స్థాతుమ్ ఐహత్, కిన్తు సర్వ్వే తస్మాదబిభయుః స శిష్య ఇతి చ న ప్రత్యయన్|</para>
  <para style="p">
    <verse number="27" style="v"/>ఏతస్మాద్ బర్ణబ్బాస్తం గృహీత్వా ప్రేరితానాం సమీపమానీయ మార్గమధ్యే ప్రభుః కథం తస్మై దర్శనం దత్తవాన్ యాః కథాశ్చ కథితవాన్ స చ యథాక్షోభః సన్ దమ్మేషక్నగరే యీశో ర్నామ ప్రాచారయత్ ఏతాన్ సర్వ్వవృత్తాన్తాన్ తాన్ జ్ఞాపితవాన్|</para>
  <para style="p">
    <verse number="28" style="v"/>తతః శౌలస్తైః సహ యిరూశాలమి కాలం యాపయన్ నిర్భయం ప్రభో ర్యీశో ర్నామ ప్రాచారయత్|</para>
  <para style="p">
    <verse number="29" style="v"/>తస్మాద్ అన్యదేశీయలోకైః సార్ద్ధం వివాదస్యోపస్థితత్వాత్ తే తం హన్తుమ్ అచేష్టన్త|</para>
  <para style="p">
    <verse number="30" style="v"/>కిన్తు భ్రాతృగణస్తజ్జ్ఞాత్వా తం కైసరియానగరం నీత్వా తార్షనగరం ప్రేషితవాన్|</para>
  <para style="p">
    <verse number="31" style="v"/>ఇత్థం సతి యిహూదియాగాలీల్శోమిరోణదేశీయాః సర్వ్వా మణ్డల్యో విశ్రామం ప్రాప్తాస్తతస్తాసాం నిష్ఠాభవత్ ప్రభో ర్భియా పవిత్రస్యాత్మనః సాన్త్వనయా చ కాలం క్షేపయిత్వా బహుసంఖ్యా అభవన్|</para>
  <para style="p">
    <verse number="32" style="v"/>తతః పరం పితరః స్థానే స్థానే భ్రమిత్వా శేషే లోద్నగరనివాసిపవిత్రలోకానాం సమీపే స్థితవాన్|</para>
  <para style="p">
    <verse number="33" style="v"/>తదా తత్ర పక్షాఘాతవ్యాధినాష్టౌ వత్సరాన్ శయ్యాగతమ్ ఐనేయనామానం మనుష్యం సాక్షత్ ప్రాప్య తమవదత్,</para>
  <para style="p">
    <verse number="34" style="v"/>హే ఐనేయ యీశుఖ్రీష్టస్త్వాం స్వస్థమ్ అకార్షీత్, త్వముత్థాయ స్వశయ్యాం నిక్షిప, ఇత్యుక్తమాత్రే స ఉదతిష్ఠత్|</para>
  <para style="p">
    <verse number="35" style="v"/>ఏతాదృశం దృష్ట్వా లోద్శారోణనివాసినో లోకాః ప్రభుం ప్రతి పరావర్త్తన్త|</para>
  <para style="p">
    <verse number="36" style="v"/>అపరఞ్చ భిక్షాదానాదిషు నానక్రియాసు నిత్యం ప్రవృత్తా యా యాఫోనగరనివాసినీ టాబిథానామా శిష్యా యాం దర్క్కాం అర్థాద్ హరిణీమయుక్త్వా ఆహ్వయన్ సా నారీ</para>
  <para style="p">
    <verse number="37" style="v"/>తస్మిన్ సమయే రుగ్నా సతీ ప్రాణాన్ అత్యజత్, తతో లోకాస్తాం ప్రక్షాల్యోపరిస్థప్రకోష్ఠే శాయయిత్వాస్థాపయన్|</para>
  <para style="p">
    <verse number="38" style="v"/>లోద్నగరం యాఫోనగరస్య సమీపస్థం తస్మాత్తత్ర పితర ఆస్తే, ఇతి వార్త్తాం శ్రుత్వా తూర్ణం తస్యాగమనార్థం తస్మిన్ వినయముక్త్వా శిష్యగణో ద్వౌ మనుజౌ ప్రేషితవాన్|</para>
  <para style="p">
    <verse number="39" style="v"/>తస్మాత్ పితర ఉత్థాయ తాభ్యాం సార్ద్ధమ్ ఆగచ్ఛత్, తత్ర తస్మిన్ ఉపస్థిత ఉపరిస్థప్రకోష్ఠం సమానీతే చ విధవాః స్వాభిః సహ స్థితికాలే దర్క్కయా కృతాని యాన్యుత్తరీయాణి పరిధేయాని చ తాని సర్వ్వాణి తం దర్శయిత్వా రుదత్యశ్చతసృషు దిక్ష్వతిష్ఠన్|</para>
  <para style="p">
    <verse number="40" style="v"/>కిన్తు పితరస్తాః సర్వ్వా బహిః కృత్వా జానునీ పాతయిత్వా ప్రార్థితవాన్; పశ్చాత్ శవం ప్రతి దృష్టిం కృత్వా కథితవాన్, హే టాబీథే త్వముత్తిష్ఠ, ఇతి వాక్య ఉక్తే సా స్త్రీ చక్షుషీ ప్రోన్మీల్య పితరమ్ అవలోక్యోత్థాయోపావిశత్|</para>
  <para style="p">
    <verse number="41" style="v"/>తతః పితరస్తస్యాః కరౌ ధృత్వా ఉత్తోల్య పవిత్రలోకాన్ విధవాశ్చాహూయ తేషాం నికటే సజీవాం తాం సమార్పయత్|</para>
  <para style="p">
    <verse number="42" style="v"/>ఏషా కథా సమస్తయాఫోనగరం వ్యాప్తా తస్మాద్ అనేకే లోకాః ప్రభౌ వ్యశ్వసన్|</para>
  <para style="p">
    <verse number="43" style="v"/>అపరఞ్చ పితరస్తద్యాఫోనగరీయస్య కస్యచిత్ శిమోన్నామ్నశ్చర్మ్మకారస్య గృహే బహుదినాని న్యవసత్|</para>
  <chapter number="10" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>కైసరియానగర ఇతాలియాఖ్యసైన్యాన్తర్గతః కర్ణీలియనామా సేనాపతిరాసీత్</para>
  <para style="p">
    <verse number="2" style="v"/>స సపరివారో భక్త ఈశ్వరపరాయణశ్చాసీత్; లోకేభ్యో బహూని దానాదీని దత్వా నిరన్తరమ్ ఈశ్వరే ప్రార్థయాఞ్చక్రే|</para>
  <para style="p">
    <verse number="3" style="v"/>ఏకదా తృతీయప్రహరవేలాయాం స దృష్టవాన్ ఈశ్వరస్యైకో దూతః సప్రకాశం తత్సమీపమ్ ఆగత్య కథితవాన్, హే కర్ణీలియ|</para>
  <para style="p">
    <verse number="4" style="v"/>కిన్తు స తం దృష్ట్వా భీతోఽకథయత్, హే ప్రభో కిం? తదా తమవదత్ తవ ప్రార్థనా దానాది చ సాక్షిస్వరూపం భూత్వేశ్వరస్య గోచరమభవత్|</para>
  <para style="p">
    <verse number="5" style="v"/>ఇదానీం యాఫోనగరం ప్రతి లోకాన్ ప్రేష్య సముద్రతీరే శిమోన్నామ్నశ్చర్మ్మకారస్య గృహే ప్రవాసకారీ పితరనామ్నా విఖ్యాతో యః శిమోన్ తమ్ ఆహ్వాయయ;</para>
  <para style="p">
    <verse number="6" style="v"/>తస్మాత్ త్వయా యద్యత్ కర్త్తవ్యం తత్తత్ స వదిష్యతి|</para>
  <para style="p">
    <verse number="7" style="v"/>ఇత్యుపదిశ్య దూతే ప్రస్థితే సతి కర్ణీలియః స్వగృహస్థానాం దాసానాం ద్వౌ జనౌ నిత్యం స్వసఙ్గినాం సైన్యానామ్ ఏకాం భక్తసేనాఞ్చాహూయ</para>
  <para style="p">
    <verse number="8" style="v"/>సకలమేతం వృత్తాన్తం విజ్ఞాప్య యాఫోనగరం తాన్ ప్రాహిణోత్|</para>
  <para style="p">
    <verse number="9" style="v"/>పరస్మిన్ దినే తే యాత్రాం కృత్వా యదా నగరస్య సమీప ఉపాతిష్ఠన్, తదా పితరో ద్వితీయప్రహరవేలాయాం ప్రార్థయితుం గృహపృష్ఠమ్ ఆరోహత్|</para>
  <para style="p">
    <verse number="10" style="v"/>ఏతస్మిన్ సమయే క్షుధార్త్తః సన్ కిఞ్చిద్ భోక్తుమ్ ఐచ్ఛత్ కిన్తు తేషామ్ అన్నాసాదనసమయే స మూర్చ్ఛితః సన్నపతత్|</para>
  <para style="p">
    <verse number="11" style="v"/>తతో మేఘద్వారం ముక్తం చతుర్భిః కోణై ర్లమ్బితం బృహద్వస్త్రమివ కిఞ్చన భాజనమ్ ఆకాశాత్ పృథివీమ్ అవారోహతీతి దృష్టవాన్|</para>
  <para style="p">
    <verse number="12" style="v"/>తన్మధ్యే నానప్రకారా గ్రామ్యవన్యపశవః ఖేచరోరోగామిప్రభృతయో జన్తవశ్చాసన్|</para>
  <para style="p">
    <verse number="13" style="v"/>అనన్తరం హే పితర ఉత్థాయ హత్వా భుంక్ష్వ తమ్ప్రతీయం గగణీయా వాణీ జాతా|</para>
  <para style="p">
    <verse number="14" style="v"/>తదా పితరః ప్రత్యవదత్, హే ప్రభో ఈదృశం మా భవతు, అహమ్ ఏతత్ కాలం యావత్ నిషిద్ధమ్ అశుచి వా ద్రవ్యం కిఞ్చిదపి న భుక్తవాన్|</para>
  <para style="p">
    <verse number="15" style="v"/>తతః పునరపి తాదృశీ విహయసీయా వాణీ జాతా యద్ ఈశ్వరః శుచి కృతవాన్ తత్ త్వం నిషిద్ధం న జానీహి|</para>
  <para style="p">
    <verse number="16" style="v"/>ఇత్థం త్రిః సతి తత్ పాత్రం పునరాకృష్టం ఆకాశమ్ అగచ్ఛత్|</para>
  <para style="p">
    <verse number="17" style="v"/>తతః పరం యద్ దర్శనం ప్రాప్తవాన్ తస్య కో భావ ఇత్యత్ర పితరో మనసా సన్దేగ్ధి, ఏతస్మిన్ సమయే కర్ణీలియస్య తే ప్రేషితా మనుష్యా ద్వారస్య సన్నిధావుపస్థాయ,</para>
  <para style="p">
    <verse number="18" style="v"/>శిమోనో గృహమన్విచ్ఛన్తః సమ్పృఛ్యాహూయ కథితవన్తః పితరనామ్నా విఖ్యాతో యః శిమోన్ స కిమత్ర ప్రవసతి?</para>
  <para style="p">
    <verse number="19" style="v"/>యదా పితరస్తద్దర్శనస్య భావం మనసాన్దోలయతి తదాత్మా తమవదత్, పశ్య త్రయో జనాస్త్వాం మృగయన్తే|</para>
  <para style="p">
    <verse number="20" style="v"/>త్వమ్ ఉత్థాయావరుహ్య నిఃసన్దేహం తైః సహ గచ్ఛ మయైవ తే ప్రేషితాః|</para>
  <para style="p">
    <verse number="21" style="v"/>తస్మాత్ పితరోఽవరుహ్య కర్ణీలియప్రేరితలోకానాం నికటమాగత్య కథితవాన్ పశ్యత యూయం యం మృగయధ్వే స జనోహం, యూయం కిన్నిమిత్తమ్ ఆగతాః?</para>
  <para style="p">
    <verse number="22" style="v"/>తతస్తే ప్రత్యవదన్ కర్ణీలియనామా శుద్ధసత్త్వ ఈశ్వరపరాయణో యిహూదీయదేశస్థానాం సర్వ్వేషాం సన్నిధౌ సుఖ్యాత్యాపన్న ఏకః సేనాపతి ర్నిజగృహం త్వామాహూయ నేతుం త్వత్తః కథా శ్రోతుఞ్చ పవిత్రదూతేన సమాదిష్టః|</para>
  <para style="p">
    <verse number="23" style="v"/>తదా పితరస్తానభ్యన్తరం నీత్వా తేషామాతిథ్యం కృతవాన్, పరేఽహని తైః సార్ద్ధం యాత్రామకరోత్, యాఫోనివాసినాం భ్రాతృణాం కియన్తో జనాశ్చ తేన సహ గతాః|</para>
  <para style="p">
    <verse number="24" style="v"/>పరస్మిన్ దివసే కైసరియానగరమధ్యప్రవేశసమయే కర్ణీలియో జ్ఞాతిబన్ధూన్ ఆహూయానీయ తాన్ అపేక్ష్య స్థితః|</para>
  <para style="p">
    <verse number="25" style="v"/>పితరే గృహ ఉపస్థితే కర్ణీలియస్తం సాక్షాత్కృత్య చరణయోః పతిత్వా ప్రాణమత్|</para>
  <para style="p">
    <verse number="26" style="v"/>పితరస్తముత్థాప్య కథితవాన్, ఉత్తిష్ఠాహమపి మానుషః|</para>
  <para style="p">
    <verse number="27" style="v"/>తదా కర్ణీలియేన సాకమ్ ఆలపన్ గృహం ప్రావిశత్ తన్మధ్యే చ బహులోకానాం సమాగమం దృష్ట్వా తాన్ అవదత్,</para>
  <para style="p">
    <verse number="28" style="v"/>అన్యజాతీయలోకైః మహాలపనం వా తేషాం గృహమధ్యే ప్రవేశనం యిహూదీయానాం నిషిద్ధమ్ అస్తీతి యూయమ్ అవగచ్ఛథ; కిన్తు కమపి మానుషమ్ అవ్యవహార్య్యమ్ అశుచిం వా జ్ఞాతుం మమ నోచితమ్ ఇతి పరమేశ్వరో మాం జ్ఞాపితవాన్|</para>
  <para style="p">
    <verse number="29" style="v"/>ఇతి హేతోరాహ్వానశ్రవణమాత్రాత్ కాఞ్చనాపత్తిమ్ అకృత్వా యుష్మాకం సమీపమ్ ఆగతోస్మి; పృచ్ఛామి యూయం కిన్నిమిత్తం మామ్ ఆహూయత?</para>
  <para style="p">
    <verse number="30" style="v"/>తదా కర్ణీలియః కథితవాన్, అద్య చత్వారి దినాని జాతాని ఏతావద్వేలాం యావద్ అహమ్ అనాహార ఆసన్ తతస్తృతీయప్రహరే సతి గృహే ప్రార్థనసమయే తేజోమయవస్త్రభృద్ ఏకో జనో మమ సమక్షం తిష్ఠన్ ఏతాం కథామ్ అకథయత్,</para>
  <para style="p">
    <verse number="31" style="v"/>హే కర్ణీలియ త్వదీయా ప్రార్థనా ఈశ్వరస్య కర్ణగోచరీభూతా తవ దానాది చ సాక్షిస్వరూపం భూత్వా తస్య దృష్టిగోచరమభవత్|</para>
  <para style="p">
    <verse number="32" style="v"/>అతో యాఫోనగరం ప్రతి లోకాన్ ప్రహిత్య తత్ర సముద్రతీరే శిమోన్నామ్నః కస్యచిచ్చర్మ్మకారస్య గృహే ప్రవాసకారీ పితరనామ్నా విఖ్యాతో యః శిమోన్ తమాహూाయయ; తతః స ఆగత్య త్వామ్ ఉపదేక్ష్యతి|</para>
  <para style="p">
    <verse number="33" style="v"/>ఇతి కారణాత్ తత్క్షణాత్ తవ నికటే లోకాన్ ప్రేషితవాన్, త్వమాగతవాన్ ఇతి భద్రం కృతవాన్| ఈశ్వరో యాన్యాఖ్యానాని కథయితుమ్ ఆదిశత్ తాని శ్రోతుం వయం సర్వ్వే సామ్ప్రతమ్ ఈశ్వరస్య సాక్షాద్ ఉపస్థితాః స్మః|</para>
  <para style="p">
    <verse number="34" style="v"/>తదా పితర ఇమాం కథాం కథయితుమ్ ఆరబ్ధవాన్, ఈశ్వరో మనుష్యాణామ్ అపక్షపాతీ సన్</para>
  <para style="p">
    <verse number="35" style="v"/>యస్య కస్యచిద్ దేశస్య యో లోకాస్తస్మాద్భీత్వా సత్కర్మ్మ కరోతి స తస్య గ్రాహ్యో భవతి, ఏతస్య నిశ్చయమ్ ఉపలబ్ధవానహమ్|</para>
  <para style="p">
    <verse number="36" style="v"/>సర్వ్వేషాం ప్రభు ర్యో యీశుఖ్రీష్టస్తేన ఈశ్వర ఇస్రాయేల్వంశానాం నికటే సుసంవాదం ప్రేష్య సమ్మేలనస్య యం సంవాదం ప్రాచారయత్ తం సంవాదం యూయం శ్రుతవన్తః|</para>
  <para style="p">
    <verse number="37" style="v"/>యతో యోహనా మజ్జనే ప్రచారితే సతి స గాలీలదేశమారభ్య సమస్తయిహూదీయదేశం వ్యాప్నోత్;</para>
  <para style="p">
    <verse number="38" style="v"/>ఫలత ఈశ్వరేణ పవిత్రేణాత్మనా శక్త్యా చాభిషిక్తో నాసరతీయయీశుః స్థానే స్థానే భ్రమన్ సుక్రియాం కుర్వ్వన్ శైతానా క్లిష్టాన్ సర్వ్వలోకాన్ స్వస్థాన్ అకరోత్, యత ఈశ్వరస్తస్య సహాయ ఆసీత్;</para>
  <para style="p">
    <verse number="39" style="v"/>వయఞ్చ యిహూదీయదేశే యిరూశాలమ్నగరే చ తేన కృతానాం సర్వ్వేషాం కర్మ్మణాం సాక్షిణో భవామః| లోకాస్తం క్రుశే విద్ధ్వా హతవన్తః,</para>
  <para style="p">
    <verse number="40" style="v"/>కిన్తు తృతీయదివసే ఈశ్వరస్తముత్థాప్య సప్రకాశమ్ అదర్శయత్|</para>
  <para style="p">
    <verse number="41" style="v"/>సర్వ్వలోకానాం నికట ఇతి న హి, కిన్తు తస్మిన్ శ్మశానాదుత్థితే సతి తేన సార్ద్ధం భోజనం పానఞ్చ కృతవన్త ఏతాదృశా ఈశ్వరస్య మనోనీతాః సాక్షిణో యే వయమ్ అస్మాకం నికటే తమదర్శయత్|</para>
  <para style="p">
    <verse number="42" style="v"/>జీవితమృతోభయలోకానాం విచారం కర్త్తుమ్ ఈశ్వరో యం నియుక్తవాన్ స ఏవ స జనః, ఇమాం కథాం ప్రచారయితుం తస్మిన్ ప్రమాణం దాతుఞ్చ సోఽస్మాన్ ఆజ్ఞాపయత్|</para>
  <para style="p">
    <verse number="43" style="v"/>యస్తస్మిన్ విశ్వసితి స తస్య నామ్నా పాపాన్ముక్తో భవిష్యతి తస్మిన్ సర్వ్వే భవిష్యద్వాదినోపి ఏతాదృశం సాక్ష్యం దదతి|</para>
  <para style="p">
    <verse number="44" style="v"/>పితరస్యైతత్కథాకథనకాలే సర్వ్వేషాం శ్రోతృణాముపరి పవిత్ర ఆత్మావారోహత్|</para>
  <para style="p">
    <verse number="45" style="v"/>తతః పితరేణ సార్ద్ధమ్ ఆగతాస్త్వక్ఛేదినో విశ్వాసినో లోకా అన్యదేశీయేభ్యః పవిత్ర ఆత్మని దత్తే సతి</para>
  <para style="p">
    <verse number="46" style="v"/>తే నానాజాతీయభాషాభిః కథాం కథయన్త ఈశ్వరం ప్రశంసన్తి, ఇతి దృష్ట్వా శ్రుత్వా చ విస్మయమ్ ఆపద్యన్త|</para>
  <para style="p">
    <verse number="47" style="v"/>తదా పితరః కథితవాన్, వయమివ యే పవిత్రమ్ ఆత్మానం ప్రాప్తాస్తేషాం జలమజ్జనం కిం కోపి నిషేద్ధుం శక్నోతి?</para>
  <para style="p">
    <verse number="48" style="v"/>తతః ప్రభో ర్నామ్నా మజ్జితా భవతేతి తానాజ్ఞాపయత్| అనన్తరం తే స్వైః సార్ద్ధం కతిపయదినాని స్థాతుం ప్రార్థయన్త|</para>
  <chapter number="11" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ఇత్థం భిన్నదేశీయలోకా అపీశ్వరస్య వాక్యమ్ అగృహ్లన్ ఇమాం వార్త్తాం యిహూదీయదేశస్థప్రేరితా భ్రాతృగణశ్చ శ్రుతవన్తః|</para>
  <para style="p">
    <verse number="2" style="v"/>తతః పితరే యిరూశాలమ్నగరం గతవతి త్వక్ఛేదినో లోకాస్తేన సహ వివదమానా అవదన్,</para>
  <para style="p">
    <verse number="3" style="v"/>త్వమ్ అత్వక్ఛేదిలోకానాం గృహం గత్వా తైః సార్ద్ధం భుక్తవాన్|</para>
  <para style="p">
    <verse number="4" style="v"/>తతః పితర ఆదితః క్రమశస్తత్కార్య్యస్య సర్వ్వవృత్తాన్తమాఖ్యాతుమ్ ఆరబ్ధవాన్|</para>
  <para style="p">
    <verse number="5" style="v"/>యాఫోనగర ఏకదాహం ప్రార్థయమానో మూర్చ్ఛితః సన్ దర్శనేన చతుర్షు కోణేషు లమ్బనమానం వృహద్వస్త్రమివ పాత్రమేకమ్ ఆకాశదవరుహ్య మన్నికటమ్ ఆగచ్ఛద్ అపశ్యమ్|</para>
  <para style="p">
    <verse number="6" style="v"/>పశ్చాత్ తద్ అనన్యదృష్ట్యా దృష్ట్వా వివిచ్య తస్య మధ్యే నానాప్రకారాన్ గ్రామ్యవన్యపశూన్ ఉరోగామిఖేచరాంశ్చ దృష్టవాన్;</para>
  <para style="p">
    <verse number="7" style="v"/>హే పితర త్వముత్థాయ గత్వా భుంక్ష్వ మాం సమ్బోధ్య కథయన్తం శబ్దమేకం శ్రుతవాంశ్చ|</para>
  <para style="p">
    <verse number="8" style="v"/>తతోహం ప్రత్యవదం, హే ప్రభో నేత్థం భవతు, యతః కిఞ్చన నిషిద్ధమ్ అశుచి ద్రవ్యం వా మమ ముఖమధ్యం కదాపి న ప్రావిశత్|</para>
  <para style="p">
    <verse number="9" style="v"/>అపరమ్ ఈశ్వరో యత్ శుచి కృతవాన్ తన్నిషిద్ధం న జానీహి ద్వి ర్మామ్ప్రతీదృశీ విహాయసీయా వాణీ జాతా|</para>
  <para style="p">
    <verse number="10" style="v"/>త్రిరిత్థం సతి తత్ సర్వ్వం పునరాకాశమ్ ఆకృష్టం|</para>
  <para style="p">
    <verse number="11" style="v"/>పశ్చాత్ కైసరియానగరాత్ త్రయో జనా మన్నికటం ప్రేషితా యత్ర నివేశనే స్థితోహం తస్మిన్ సమయే తత్రోపాతిష్ఠన్|</para>
  <para style="p">
    <verse number="12" style="v"/>తదా నిఃసన్దేహం తైః సార్ద్ధం యాతుమ్ ఆత్మా మామాదిష్టవాన్; తతః పరం మయా సహైతేషు షడ్భ్రాతృషు గతేషు వయం తస్య మనుజస్య గృహం ప్రావిశామ|</para>
  <para style="p">
    <verse number="13" style="v"/>సోస్మాకం నికటే కథామేతామ్ అకథయత్ ఏకదా దూత ఏకః ప్రత్యక్షీభూయ మమ గృహమధ్యే తిష్టన్ మామిత్యాజ్ఞాపితవాన్, యాఫోనగరం ప్రతి లోకాన్ ప్రహిత్య పితరనామ్నా విఖ్యాతం శిమోనమ్ ఆహూయయ;</para>
  <para style="p">
    <verse number="14" style="v"/>తతస్తవ త్వదీయపరివారాణాఞ్చ యేన పరిత్రాణం భవిష్యతి తత్ స ఉపదేక్ష్యతి|</para>
  <para style="p">
    <verse number="15" style="v"/>అహం తాం కథాముత్థాప్య కథితవాన్ తేన ప్రథమమ్ అస్మాకమ్ ఉపరి యథా పవిత్ర ఆత్మావరూఢవాన్ తథా తేషామప్యుపరి సమవరూఢవాన్|</para>
  <para style="p">
    <verse number="16" style="v"/>తేన యోహన్ జలే మజ్జితవాన్ ఇతి సత్యం కిన్తు యూయం పవిత్ర ఆత్మని మజ్జితా భవిష్యథ, ఇతి యద్వాక్యం ప్రభురుదితవాన్ తత్ తదా మయా స్మృతమ్|</para>
  <para style="p">
    <verse number="17" style="v"/>అతః ప్రభా యీశుఖ్రీష్టే ప్రత్యయకారిణో యే వయమ్ అస్మభ్యమ్ ఈశ్వరో యద్ దత్తవాన్ తత్ తేభ్యో లోకేభ్యోపి దత్తవాన్ తతః కోహం? కిమహమ్ ఈశ్వరం వారయితుం శక్నోమి?</para>
  <para style="p">
    <verse number="18" style="v"/>కథామేతాం శ్రువా తే క్షాన్తా ఈశ్వరస్య గుణాన్ అనుకీర్త్త్య కథితవన్తః, తర్హి పరమాయుఃప్రాప్తినిమిత్తమ్ ఈశ్వరోన్యదేశీయలోకేభ్యోపి మనఃపరివర్త్తనరూపం దానమ్ అదాత్|</para>
  <para style="p">
    <verse number="19" style="v"/>స్తిఫానం ప్రతి ఉపద్రవే ఘటితే యే వికీర్ణా అభవన్ తై ఫైనీకీకుప్రాన్తియఖియాసు భ్రమిత్వా కేవలయిహూదీయలోకాన్ వినా కస్యాప్యన్యస్య సమీప ఈశ్వరస్య కథాం న ప్రాచారయన్|</para>
  <para style="p">
    <verse number="20" style="v"/>అపరం తేషాం కుప్రీయాః కురీనీయాశ్చ కియన్తో జనా ఆన్తియఖియానగరం గత్వా యూనానీయలోకానాం సమీపేపి ప్రభోర్యీశోః కథాం ప్రాచారయన్|</para>
  <para style="p">
    <verse number="21" style="v"/>ప్రభోః కరస్తేషాం సహాయ ఆసీత్ తస్మాద్ అనేకే లోకా విశ్వస్య ప్రభుం ప్రతి పరావర్త్తన్త|</para>
  <para style="p">
    <verse number="22" style="v"/>ఇతి వార్త్తాయాం యిరూశాలమస్థమణ్డలీయలోకానాం కర్ణగోచరీభూతాయామ్ ఆన్తియఖియానగరం గన్తు తే బర్ణబ్బాం ప్రైరయన్|</para>
  <para style="p">
    <verse number="23" style="v"/>తతో బర్ణబ్బాస్తత్ర ఉపస్థితః సన్ ఈశ్వరస్యానుగ్రహస్య ఫలం దృష్ట్వా సానన్దో జాతః,</para>
  <para style="p">
    <verse number="24" style="v"/>స స్వయం సాధు ర్విశ్వాసేన పవిత్రేణాత్మనా చ పరిపూర్ణః సన్ గనోనిష్టయా ప్రభావాస్థాం కర్త్తుం సర్వ్వాన్ ఉపదిష్టవాన్ తేన ప్రభోః శిష్యా అనేకే బభూవుః|</para>
  <para style="p">
    <verse number="25" style="v"/>శేషే శౌలం మృగయితుం బర్ణబ్బాస్తార్షనగరం ప్రస్థితవాన్| తత్ర తస్యోద్దేశం ప్రాప్య తమ్ ఆన్తియఖియానగరమ్ ఆనయత్;</para>
  <para style="p">
    <verse number="26" style="v"/>తతస్తౌ మణ్డలీస్థలోకైః సభాం కృత్వా సంవత్సరమేకం యావద్ బహులోకాన్ ఉపాదిశతాం; తస్మిన్ ఆన్తియఖియానగరే శిష్యాః ప్రథమం ఖ్రీష్టీయనామ్నా విఖ్యాతా అభవన్|</para>
  <para style="p">
    <verse number="27" style="v"/>తతః పరం భవిష్యద్వాదిగణే యిరూశాలమ ఆన్తియఖియానగరమ్ ఆగతే సతి</para>
  <para style="p">
    <verse number="28" style="v"/>ఆగాబనామా తేషామేక ఉత్థాయ ఆత్మనః శిక్షయా సర్వ్వదేశే దుర్భిక్షం భవిష్యతీతి జ్ఞాపితవాన్; తతః క్లౌదియకైసరస్యాధికారే సతి తత్ ప్రత్యక్షమ్ అభవత్|</para>
  <para style="p">
    <verse number="29" style="v"/>తస్మాత్ శిష్యా ఏకైకశః స్వస్వశక్త్యనుసారతో యిహూదీయదేశనివాసినాం భ్రతృణాం దినయాపనార్థం ధనం ప్రేషయితుం నిశ్చిత్య</para>
  <para style="p">
    <verse number="30" style="v"/>బర్ణబ్బాశౌలయో ర్ద్వారా ప్రాచీనలోకానాం సమీపం తత్ ప్రేషితవన్తః|</para>
  <chapter number="12" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>తస్మిన్ సమయే హేరోద్‌రాజో మణ్డల్యాః కియజ్జనేభ్యో దుఃఖం దాతుం ప్రారభత్|</para>
  <para style="p">
    <verse number="2" style="v"/>విశేషతో యోహనః సోదరం యాకూబం కరవాలాఘాతేన్ హతవాన్|</para>
  <para style="p">
    <verse number="3" style="v"/>తస్మాద్ యిహూదీయాః సన్తుష్టా అభవన్ ఇతి విజ్ఞాయ స పితరమపి ధర్త్తుం గతవాన్|</para>
  <para style="p">
    <verse number="4" style="v"/>తదా కిణ్వశూన్యపూపోత్సవసమయ ఉపాతిష్టత్; అత ఉత్సవే గతే సతి లోకానాం సమక్షం తం బహిరానేయ్యామీతి మనసి స్థిరీకృత్య స తం ధారయిత్వా రక్ష్ణార్థమ్ యేషామ్ ఏకైకసంఘే చత్వారో జనాః సన్తి తేషాం చతుర్ణాం రక్షకసంఘానాం సమీపే తం సమర్ప్య కారాయాం స్థాపితవాన్|</para>
  <para style="p">
    <verse number="5" style="v"/>కిన్తుం పితరస్య కారాస్థితికారణాత్ మణ్డల్యా లోకా అవిశ్రామమ్ ఈశ్వరస్య సమీపే ప్రార్థయన్త|</para>
  <para style="p">
    <verse number="6" style="v"/>అనన్తరం హేరోది తం బహిరానాయితుం ఉద్యతే సతి తస్యాం రాత్రౌ పితరో రక్షకద్వయమధ్యస్థానే శృఙ్ఖలద్వయేన బద్ధ్వః సన్ నిద్రిత ఆసీత్, దౌవారికాశ్చ కారాయాః సమ్ముఖే తిష్ఠనతో ద్వారమ్ అరక్షిషుః|</para>
  <para style="p">
    <verse number="7" style="v"/>ఏతస్మిన్ సమయే పరమేశ్వరస్య దూతే సముపస్థితే కారా దీప్తిమతీ జాతా; తతః స దూతః పితరస్య కుక్షావావాతం కృత్వా తం జాగరయిత్వా భాషితవాన్ తూర్ణముత్తిష్ఠ; తతస్తస్య హస్తస్థశృఙ్ఖలద్వయం గలత్ పతితం|</para>
  <para style="p">
    <verse number="8" style="v"/>స దూతస్తమవదత్, బద్ధకటిః సన్ పాదయోః పాదుకే అర్పయ; తేన తథా కృతే సతి దూతస్తమ్ ఉక్తవాన్ గాత్రీయవస్త్రం గాత్రే నిధాయ మమ పశ్చాద్ ఏహి|</para>
  <para style="p">
    <verse number="9" style="v"/>తతః పితరస్తస్య పశ్చాద్ వ్రజన బహిరగచ్ఛత్, కిన్తు దూతేన కర్మ్మైతత్ కృతమితి సత్యమజ్ఞాత్వా స్వప్నదర్శనం జ్ఞాతవాన్|</para>
  <para style="p">
    <verse number="10" style="v"/>ఇత్థం తౌ ప్రథమాం ద్వితీయాఞ్చ కారాం లఙ్ఘిత్వా యేన లౌహనిర్మ్మితద్వారేణ నగరం గమ్యతే తత్సమీపం ప్రాప్నుతాం; తతస్తస్య కవాటం స్వయం ముక్తమభవత్ తతస్తౌ తత్స్థానాద్ బహి ర్భూత్వా మార్గైకస్య సీమాం యావద్ గతౌ; తతోఽకస్మాత్ స దూతః పితరం త్యక్తవాన్|</para>
  <para style="p">
    <verse number="11" style="v"/>తదా స చేతనాం ప్రాప్య కథితవాన్ నిజదూతం ప్రహిత్య పరమేశ్వరో హేరోదో హస్తాద్ యిహూదీయలోకానాం సర్వ్వాశాయాశ్చ మాం సముద్ధృతవాన్ ఇత్యహం నిశ్చయం జ్ఞాతవాన్|</para>
  <para style="p">
    <verse number="12" style="v"/>స వివిచ్య మార్కనామ్రా విఖ్యాతస్య యోహనో మాతు ర్మరియమో యస్మిన్ గృహే బహవః సమ్భూయ ప్రార్థయన్త తన్నివేశనం గతః|</para>
  <para style="p">
    <verse number="13" style="v"/>పితరేణ బహిర్ద్వార ఆహతే సతి రోదానామా బాలికా ద్రష్టుం గతా|</para>
  <para style="p">
    <verse number="14" style="v"/>తతః పితరస్య స్వరం శ్రువా సా హర్షయుక్తా సతీ ద్వారం న మోచయిత్వా పితరో ద్వారే తిష్ఠతీతి వార్త్తాం వక్తుమ్ అభ్యన్తరం ధావిత్వా గతవతీ|</para>
  <para style="p">
    <verse number="15" style="v"/>తే ప్రావోచన్ త్వమున్మత్తా జాతాసి కిన్తు సా ముహుర్ముహురుక్తవతీ సత్యమేవైతత్|</para>
  <para style="p">
    <verse number="16" style="v"/>తదా తే కథితవన్తస్తర్హి తస్య దూతో భవేత్|</para>
  <para style="p">
    <verse number="17" style="v"/>పితరో ద్వారమాహతవాన్ ఏతస్మిన్నన్తరే ద్వారం మోచయిత్వా పితరం దృష్ట్వా విస్మయం ప్రాప్తాః|</para>
  <para style="p">
    <verse number="18" style="v"/>తతః పితరో నిఃశబ్దం స్థాతుం తాన్ ప్రతి హస్తేన సఙ్కేతం కృత్వా పరమేశ్వరో యేన ప్రకారేణ తం కారాయా ఉద్ధృత్యానీతవాన్ తస్య వృత్తాన్తం తానజ్ఞాపయత్, యూయం గత్వా యాకుబం భ్రాతృగణఞ్చ వార్త్తామేతాం వదతేత్యుక్తా స్థానాన్తరం ప్రస్థితవాన్|</para>
  <para style="p">
    <verse number="19" style="v"/>ప్రభాతే సతి పితరః క్వ గత ఇత్యత్ర రక్షకాణాం మధ్యే మహాన్ కలహో జాతః|</para>
  <para style="p">
    <verse number="20" style="v"/>హేరోద్ బహు మృగయిత్వా తస్యోద్దేశే న ప్రాప్తే సతి రక్షకాన్ సంపృచ్ఛ్య తేషాం ప్రాణాన్ హన్తుమ్ ఆదిష్టవాన్|</para>
  <para style="p">
    <verse number="21" style="v"/>పశ్చాత్ స యిహూదీయప్రదేశాత్ కైసరియానగరం గత్వా తత్రావాతిష్ఠత్|</para>
  <para style="p">
    <verse number="22" style="v"/>సోరసీదోనదేశయో ర్లోకేభ్యో హేరోది యుయుత్సౌ సతి తే సర్వ్వ ఏకమన్త్రణాః సన్తస్తస్య సమీప ఉపస్థాయ ల్వాస్తనామానం తస్య వస్త్రగృహాధీశం సహాయం కృత్వా హేరోదా సార్ద్ధం సన్ధిం ప్రార్థయన్త యతస్తస్య రాజ్ఞో దేశేన తేషాం దేశీయానాం భరణమ్ అభవత్ం</para>
  <para style="p">
    <verse number="23" style="v"/>అతః కుత్రచిన్ నిరుపితదినే హేరోద్ రాజకీయం పరిచ్ఛదం పరిధాయ సింహాసనే సముపవిశ్య తాన్ ప్రతి కథామ్ ఉక్తవాన్|</para>
  <para style="p">
    <verse number="24" style="v"/>తతో లోకా ఉచ్చైఃకారం ప్రత్యవదన్, ఏష మనుజరవో న హి, ఈశ్వరీయరవః|</para>
  <para style="p">
    <verse number="25" style="v"/>తదా హేరోద్ ఈశ్వరస్య సమ్మానం నాకరోత్; తస్మాద్ధేతోః పరమేశ్వరస్య దూతో హఠాత్ తం ప్రాహరత్ తేనైవ స కీటైః క్షీణః సన్ ప్రాణాన్ అజహాత్| కిన్త్వీశ్వరస్య కథా దేశం వ్యాప్య ప్రబలాభవత్| తతః పరం బర్ణబ్బాశౌలౌ యస్య కర్మ్మణో భారం ప్రాప్నుతాం తాభ్యాం తస్మిన్ సమ్పాదితే సతి మార్కనామ్నా విఖ్యాతో యో యోహన్ తం సఙ్గినం కృత్వా యిరూశాలమ్నగరాత్ ప్రత్యాగతౌ|</para>
  <chapter number="13" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అపరఞ్చ బర్ణబ్బాః, శిమోన్ యం నిగ్రం వదన్తి, కురీనీయలూకియో హేరోదా రాజ్ఞా సహ కృతవిద్యాाభ్యాసో మినహేమ్, శౌలశ్చైతే యే కియన్తో జనా భవిష్యద్వాదిన ఉపదేష్టారశ్చాన్తియఖియానగరస్థమణ్డల్యామ్ ఆసన్,</para>
  <para style="p">
    <verse number="2" style="v"/>తే యదోపవాసం కృత్వేశ్వరమ్ అసేవన్త తస్మిన్ సమయే పవిత్ర ఆత్మా కథితవాన్ అహం యస్మిన్ కర్మ్మణి బర్ణబ్బాశైలౌ నియుక్తవాన్ తత్కర్మ్మ కర్త్తుం తౌ పృథక్ కురుత|</para>
  <para style="p">
    <verse number="3" style="v"/>తతస్తైరుపవాసప్రార్థనయోః కృతయోః సతోస్తే తయో ర్గాత్రయో ర్హస్తార్పణం కృత్వా తౌ వ్యసృజన్|</para>
  <para style="p">
    <verse number="4" style="v"/>తతః పరం తౌ పవిత్రేణాత్మనా ప్రేరితౌ సన్తౌ సిలూకియానగరమ్ ఉపస్థాయ సముద్రపథేన కుప్రోపద్వీపమ్ అగచ్ఛతాం|</para>
  <para style="p">
    <verse number="5" style="v"/>తతః సాలామీనగరమ్ ఉపస్థాయ తత్ర యిహూదీయానాం భజనభవనాని గత్వేశ్వరస్య కథాం ప్రాచారయతాం; యోహనపి తత్సహచరోఽభవత్|</para>
  <para style="p">
    <verse number="6" style="v"/>ఇత్థం తే తస్యోపద్వీపస్య సర్వ్వత్ర భ్రమన్తః పాఫనగరమ్ ఉపస్థితాః; తత్ర సువివేచకేన సర్జియపౌలనామ్నా తద్దేశాధిపతినా సహ భవిష్యద్వాదినో వేశధారీ బర్యీశునామా యో మాయావీ యిహూదీ ఆసీత్ తం సాక్షాత్ ప్రాప్తవతః|</para>
  <para style="p">
    <verse number="7" style="v"/>తద్దేశాధిప ఈశ్వరస్య కథాం శ్రోతుం వాఞ్ఛన్ పౌలబర్ణబ్బౌ న్యమన్త్రయత్|</para>
  <para style="p">
    <verse number="8" style="v"/>కిన్త్విలుమా యం మాయావినం వదన్తి స దేశాధిపతిం ధర్మ్మమార్గాద్ బహిర్భూతం కర్త్తుమ్ అయతత|</para>
  <para style="p">
    <verse number="9" style="v"/>తస్మాత్ శోలోఽర్థాత్ పౌలః పవిత్రేణాత్మనా పరిపూర్ణః సన్ తం మాయావినం ప్రత్యనన్యదృష్టిం కృత్వాకథయత్,</para>
  <para style="p">
    <verse number="10" style="v"/>హే నరకిన్ ధర్మ్మద్వేషిన్ కౌటిల్యదుష్కర్మ్మపరిపూర్ణ, త్వం కిం ప్రభోః సత్యపథస్య విపర్య్యయకరణాత్ కదాపి న నివర్త్తిష్యసే?</para>
  <para style="p">
    <verse number="11" style="v"/>అధునా పరమేశ్వరస్తవ సముచితం కరిష్యతి తేన కతిపయదినాని త్వమ్ అన్ధః సన్ సూర్య్యమపి న ద్రక్ష్యసి| తత్క్షణాద్ రాత్రివద్ అన్ధకారస్తస్య దృష్టిమ్ ఆచ్ఛాదితవాన్; తస్మాత్ తస్య హస్తం ధర్త్తుం స లోకమన్విచ్ఛన్ ఇతస్తతో భ్రమణం కృతవాన్|</para>
  <para style="p">
    <verse number="12" style="v"/>ఏనాం ఘటనాం దృష్ట్వా స దేశాధిపతిః ప్రభూపదేశాద్ విస్మిత్య విశ్వాసం కృతవాన్|</para>
  <para style="p">
    <verse number="13" style="v"/>తదనన్తరం పౌలస్తత్సఙ్గినౌ చ పాఫనగరాత్ ప్రోతం చాలయిత్వా పమ్ఫులియాదేశస్య పర్గీనగరమ్ అగచ్ఛన్ కిన్తు యోహన్ తయోః సమీపాద్ ఏత్య యిరూశాలమం ప్రత్యాగచ్ఛత్|</para>
  <para style="p">
    <verse number="14" style="v"/>పశ్చాత్ తౌ పర్గీతో యాత్రాం కృత్వా పిసిదియాదేశస్య ఆన్తియఖియానగరమ్ ఉపస్థాయ విశ్రామవారే భజనభవనం ప్రవిశ్య సముపావిశతాం|</para>
  <para style="p">
    <verse number="15" style="v"/>వ్యవస్థాభవిష్యద్వాక్యయోః పఠితయోః సతో ర్హే భ్రాతరౌ లోకాన్ ప్రతి యువయోః కాచిద్ ఉపదేశకథా యద్యస్తి తర్హి తాం వదతం తౌ ప్రతి తస్య భజనభవనస్యాధిపతయః కథామ్ ఏతాం కథయిత్వా ప్రైషయన్|</para>
  <para style="p">
    <verse number="16" style="v"/>అతః పౌల ఉత్తిష్ఠన్ హస్తేన సఙ్కేతం కుర్వ్వన్ కథితవాన్ హే ఇస్రాయేలీయమనుష్యా ఈశ్వరపరాయణాః సర్వ్వే లోకా యూయమ్ అవధద్ధం|</para>
  <para style="p">
    <verse number="17" style="v"/>ఏతేషామిస్రాయేల్లోకానామ్ ఈశ్వరోఽస్మాకం పూర్వ్వపరుషాన్ మనోనీతాన్ కత్వా గృహీతవాన్ తతో మిసరి దేశే ప్రవసనకాలే తేషామున్నతిం కృత్వా తస్మాత్ స్వీయబాహుబలేన తాన్ బహిః కృత్వా సమానయత్|</para>
  <para style="p">
    <verse number="18" style="v"/>చత్వారింశద్వత్సరాన్ యావచ్చ మహాప్రాన్తరే తేషాం భరణం కృత్వా</para>
  <para style="p">
    <verse number="19" style="v"/>కినాన్దేశాన్తర్వ్వర్త్తీణి సప్తరాజ్యాని నాశయిత్వా గుటికాపాతేన తేషు సర్వ్వదేశేషు తేభ్యోఽధికారం దత్తవాన్|</para>
  <para style="p">
    <verse number="20" style="v"/>పఞ్చాశదధికచతుఃశతేషు వత్సరేషు గతేషు చ శిమూయేల్భవిష్యద్వాదిపర్య్యన్తం తేషాముపరి విచారయితృన్ నియుక్తవాన్|</para>
  <para style="p">
    <verse number="21" style="v"/>తైశ్చ రాజ్ఞి ప్రార్థితే, ఈశ్వరో బిన్యామీనో వంశజాతస్య కీశః పుత్రం శౌలం చత్వారింశద్వర్షపర్య్యన్తం తేషాముపరి రాజానం కృతవాన్|</para>
  <para style="p">
    <verse number="22" style="v"/>పశ్చాత్ తం పదచ్యుతం కృత్వా యో మదిష్టక్రియాః సర్వ్వాః కరిష్యతి తాదృశం మమ మనోభిమతమ్ ఏకం జనం యిశయః పుత్రం దాయూదం ప్రాప్తవాన్ ఇదం ప్రమాణం యస్మిన్ దాయూది స దత్తవాన్ తం దాయూదం తేషాముపరి రాజత్వం కర్త్తుమ్ ఉత్పాదితవాన|</para>
  <para style="p">
    <verse number="23" style="v"/>తస్య స్వప్రతిశ్రుతస్య వాక్యస్యానుసారేణ ఇస్రాయేల్లోకానాం నిమిత్తం తేషాం మనుష్యాణాం వంశాద్ ఈశ్వర ఏకం యీశుం (త్రాతారమ్) ఉదపాదయత్|</para>
  <para style="p">
    <verse number="24" style="v"/>తస్య ప్రకాశనాత్ పూర్వ్వం యోహన్ ఇస్రాయేల్లోకానాం సన్నిధౌ మనఃపరావర్త్తనరూపం మజ్జనం ప్రాచారయత్|</para>
  <para style="p">
    <verse number="25" style="v"/>యస్య చ కర్మ్మణోे భారం ప్రప్తవాన్ యోహన్ తన్ నిష్పాదయన్ ఏతాం కథాం కథితవాన్, యూయం మాం కం జనం జానీథ? అహమ్ అభిషిక్తత్రాతా నహి, కిన్తు పశ్యత యస్య పాదయోః పాదుకయో ర్బన్ధనే మోచయితుమపి యోగ్యో న భవామి తాదృశ ఏకో జనో మమ పశ్చాద్ ఉపతిష్ఠతి|</para>
  <para style="p">
    <verse number="26" style="v"/>హే ఇబ్రాహీమో వంశజాతా భ్రాతరో హే ఈశ్వరభీతాః సర్వ్వలోకా యుష్మాన్ ప్రతి పరిత్రాణస్య కథైషా ప్రేరితా|</para>
  <para style="p">
    <verse number="27" style="v"/>యిరూశాలమ్నివాసినస్తేషామ్ అధిపతయశ్చ తస్య యీశోః పరిచయం న ప్రాప్య ప్రతివిశ్రామవారం పఠ్యమానానాం భవిష్యద్వాదికథానామ్ అభిప్రాయమ్ అబుద్ధ్వా చ తస్య వధేన తాః కథాః సఫలా అకుర్వ్వన్|</para>
  <para style="p">
    <verse number="28" style="v"/>ప్రాణహననస్య కమపి హేతుమ్ అప్రాప్యాపి పీలాతస్య నికటే తస్య వధం ప్రార్థయన్త|</para>
  <para style="p">
    <verse number="29" style="v"/>తస్మిన్ యాః కథా లిఖితాః సన్తి తదనుసారేణ కర్మ్మ సమ్పాద్య తం క్రుశాద్ అవతార్య్య శ్మశానే శాయితవన్తః|</para>
  <para style="p">
    <verse number="30" style="v"/>కిన్త్వీశ్వరః శ్మశానాత్ తముదస్థాపయత్,</para>
  <para style="p">
    <verse number="31" style="v"/>పునశ్చ గాలీలప్రదేశాద్ యిరూశాలమనగరం తేన సార్ద్ధం యే లోకా ఆగచ్ఛన్ స బహుదినాని తేభ్యో దర్శనం దత్తవాన్, అతస్త ఇదానీం లోకాన్ ప్రతి తస్య సాక్షిణః సన్తి|</para>
  <para style="p">
    <verse number="32" style="v"/>అస్మాకం పూర్వ్వపురుషాణాం సమక్షమ్ ఈశ్వరో యస్మిన్ ప్రతిజ్ఞాతవాన్ యథా, త్వం మే పుత్రోసి చాద్య త్వాం సముత్థాపితవానహమ్|</para>
  <para style="p">
    <verse number="33" style="v"/>ఇదం యద్వచనం ద్వితీయగీతే లిఖితమాస్తే తద్ యీశోరుత్థానేన తేషాం సన్తానా యే వయమ్ అస్మాకం సన్నిధౌ తేన ప్రత్యక్షీ కృతం, యుష్మాన్ ఇమం సుసంవాదం జ్ఞాపయామి|</para>
  <para style="p">
    <verse number="34" style="v"/>పరమేశ్వరేణ శ్మశానాద్ ఉత్థాపితం తదీయం శరీరం కదాపి న క్షేష్యతే, ఏతస్మిన్ స స్వయం కథితవాన్ యథా దాయూదం ప్రతి ప్రతిజ్ఞాతో యో వరస్తమహం తుభ్యం దాస్యామి|</para>
  <para style="p">
    <verse number="35" style="v"/>ఏతదన్యస్మిన్ గీతేఽపి కథితవాన్| స్వకీయం పుణ్యవన్తం త్వం క్షయితుం న చ దాస్యసి|</para>
  <para style="p">
    <verse number="36" style="v"/>దాయూదా ఈశ్వరాభిమతసేవాయై నిజాయుషి వ్యయితే సతి స మహానిద్రాం ప్రాప్య నిజైః పూర్వ్వపురుషైః సహ మిలితః సన్ అక్షీయత;</para>
  <para style="p">
    <verse number="37" style="v"/>కిన్తు యమీశ్వరః శ్మశానాద్ ఉదస్థాపయత్ స నాక్షీయత|</para>
  <para style="p">
    <verse number="38" style="v"/>అతో హే భ్రాతరః, అనేన జనేన పాపమోచనం భవతీతి యుష్మాన్ ప్రతి ప్రచారితమ్ ఆస్తే|</para>
  <para style="p">
    <verse number="39" style="v"/>ఫలతో మూసావ్యవస్థయా యూయం యేభ్యో దోషేభ్యో ముక్తా భవితుం న శక్ష్యథ తేభ్యః సర్వ్వదోషేభ్య ఏతస్మిన్ జనే విశ్వాసినః సర్వ్వే ముక్తా భవిష్యన్తీతి యుష్మాభి ర్జ్ఞాయతాం|</para>
  <para style="p">
    <verse number="40" style="v"/>అపరఞ్చ| అవజ్ఞాకారిణో లోకాశ్చక్షురున్మీల్య పశ్యత| తథైవాసమ్భవం జ్ఞాత్వా స్యాత యూయం విలజ్జితాః| యతో యుష్మాసు తిష్ఠత్సు కరిష్యే కర్మ్మ తాదృశం| యేనైవ తస్య వృత్తాన్తే యుష్మభ్యం కథితేఽపి హి| యూయం న తన్తు వృత్తాన్తం ప్రత్యేష్యథ కదాచన||</para>
  <para style="p">
    <verse number="41" style="v"/>యేయం కథా భవిష్యద్వాదినాం గ్రన్థేషు లిఖితాస్తే సావధానా భవత స కథా యథా యుష్మాన్ ప్రతి న ఘటతే|</para>
  <para style="p">
    <verse number="42" style="v"/>యిహూదీయభజనభవనాన్ నిర్గతయోస్తయో ర్భిన్నదేశీయై ర్వక్ష్యమాణా ప్రార్థనా కృతా, ఆగామిని విశ్రామవారేఽపి కథేయమ్ అస్మాన్ ప్రతి ప్రచారితా భవత్వితి|</para>
  <para style="p">
    <verse number="43" style="v"/>సభాయా భఙ్గే సతి బహవో యిహూదీయలోకా యిహూదీయమతగ్రాహిణో భక్తలోకాశ్చ బర్ణబ్బాపౌలయోః పశ్చాద్ ఆగచ్ఛన్, తేన తౌ తైః సహ నానాకథాః కథయిత్వేశ్వరానుగ్రహాశ్రయే స్థాతుం తాన్ ప్రావర్త్తయతాం|</para>
  <para style="p">
    <verse number="44" style="v"/>పరవిశ్రామవారే నగరస్య ప్రాయేణ సర్వ్వే లాకా ఈశ్వరీయాం కథాం శ్రోతుం మిలితాః,</para>
  <para style="p">
    <verse number="45" style="v"/>కిన్తు యిహూదీయలోకా జననివహం విలోక్య ఈర్ష్యయా పరిపూర్ణాః సన్తో విపరీతకథాకథనేనేశ్వరనిన్దయా చ పౌలేనోక్తాం కథాం ఖణ్డయితుం చేష్టితవన్తః|</para>
  <para style="p">
    <verse number="46" style="v"/>తతః పౌैలబర్ణబ్బావక్షోభౌ కథితవన్తౌ ప్రథమం యుష్మాకం సన్నిధావీశ్వరీయకథాయాః ప్రచారణమ్ ఉచితమాసీత్ కిన్తుం తదగ్రాహ్యత్వకరణేన యూయం స్వాన్ అనన్తాయుషోఽయోగ్యాన్ దర్శయథ, ఏతత్కారణాద్ వయమ్ అన్యదేశీయలోకానాం సమీపం గచ్ఛామః|</para>
  <para style="p">
    <verse number="47" style="v"/>ప్రభురస్మాన్ ఇత్థమ్ ఆదిష్టవాన్ యథా, యావచ్చ జగతః సీమాం లోకానాం త్రాణకారణాత్| మయాన్యదేశమధ్యే త్వం స్థాపితో భూః ప్రదీపవత్||</para>
  <para style="p">
    <verse number="48" style="v"/>తదా కథామీదృశీం శ్రుత్వా భిన్నదేశీయా ఆహ్లాదితాః సన్తః ప్రభోః కథాం ధన్యాం ధన్యామ్ అవదన్, యావన్తో లోకాశ్చ పరమాయుః ప్రాప్తినిమిత్తం నిరూపితా ఆసన్ తేे వ్యశ్వసన్|</para>
  <para style="p">
    <verse number="49" style="v"/>ఇత్థం ప్రభోః కథా సర్వ్వేదేశం వ్యాప్నోత్|</para>
  <para style="p">
    <verse number="50" style="v"/>కిన్తు యిహూదీయా నగరస్య ప్రధానపురుషాన్ సమ్మాన్యాః కథిపయా భక్తా యోషితశ్చ కుప్రవృత్తిం గ్రాహయిత్వా పౌలబర్ణబ్బౌ తాడయిత్వా తస్మాత్ ప్రదేశాద్ దూరీకృతవన్తః|</para>
  <para style="p">
    <verse number="51" style="v"/>అతః కారణాత్ తౌ నిజపదధూలీస్తేషాం ప్రాతికూల్యేన పాతయిత్వేेకనియం నగరం గతౌ|</para>
  <para style="p">
    <verse number="52" style="v"/>తతః శిష్యగణ ఆనన్దేన పవిత్రేణాత్మనా చ పరిపూర్ణోభవత్|</para>
  <chapter number="14" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>తౌ ద్వౌ జనౌ యుగపద్ ఇకనియనగరస్థయిహూదీయానాం భజనభవనం గత్వా యథా బహవో యిహూదీయా అన్యదేेశీయలోకాశ్చ వ్యశ్వసన్ తాదృశీం కథాం కథితవన్తౌ|</para>
  <para style="p">
    <verse number="2" style="v"/>కిన్తు విశ్వాసహీనా యిహూదీయా అన్యదేశీయలోకాన్ కుప్రవృత్తిం గ్రాహయిత్వా భ్రాతృగణం ప్రతి తేషాం వైరం జనితవన్తః|</para>
  <para style="p">
    <verse number="3" style="v"/>అతః స్వానుగ్రహకథాయాః ప్రమాణం దత్వా తయో ర్హస్తై ర్బహులక్షణమ్ అద్భుతకర్మ్మ చ ప్రాకాశయద్ యః ప్రభుస్తస్య కథా అక్షోభేన ప్రచార్య్య తౌ తత్ర బహుదినాని సమవాతిష్ఠేతాం|</para>
  <para style="p">
    <verse number="4" style="v"/>కిన్తు కియన్తో లోకా యిహూదీయానాం సపక్షాః కియన్తో లోకాః ప్రేరితానాం సపక్షా జాతాః, అతో నాగరికజననివహమధ్యే భిన్నవాక్యత్వమ్ అభవత్|</para>
  <para style="p">
    <verse number="5" style="v"/>అన్యదేశీయా యిహూదీయాస్తేషామ్ అధిపతయశ్చ దౌరాత్మ్యం కుత్వా తౌ ప్రస్తరైరాహన్తుమ్ ఉద్యతాః|</para>
  <para style="p">
    <verse number="6" style="v"/>తౌ తద్వార్త్తాం ప్రాప్య పలాయిత్వా లుకాయనియాదేశస్యాన్తర్వ్వర్త్తిలుస్త్రాదర్బ్బో</para>
  <para style="p">
    <verse number="7" style="v"/>తత్సమీపస్థదేశఞ్చ గత్వా తత్ర సుసంవాదం ప్రచారయతాం|</para>
  <para style="p">
    <verse number="8" style="v"/>తత్రోభయపాదయోశ్చలనశక్తిహీనో జన్మారభ్య ఖఞ్జః కదాపి గమనం నాకరోత్ ఏతాదృశ ఏకో మానుషో లుస్త్రానగర ఉపవిశ్య పౌలస్య కథాం శ్రుతవాన్|</para>
  <para style="p">
    <verse number="9" style="v"/>ఏతస్మిన్ సమయే పౌలస్తమ్ప్రతి దృష్టిం కృత్వా తస్య స్వాస్థ్యే విశ్వాసం విదిత్వా ప్రోచ్చైః కథితవాన్</para>
  <para style="p">
    <verse number="10" style="v"/>పద్భ్యాముత్తిష్ఠన్ ఋజు ర్భవ| తతః స ఉల్లమ్ఫం కృత్వా గమనాగమనే కుతవాన్|</para>
  <para style="p">
    <verse number="11" style="v"/>తదా లోకాః పౌలస్య తత్ కార్య్యం విలోక్య లుకాయనీయభాషయా ప్రోచ్చైః కథామేతాం కథితవన్తః, దేవా మనుష్యరూపం ధృత్వాస్మాకం సమీపమ్ అవారోహన్|</para>
  <para style="p">
    <verse number="12" style="v"/>తే బర్ణబ్బాం యూపితరమ్ అవదన్ పౌలశ్చ ముఖ్యో వక్తా తస్మాత్ తం మర్కురియమ్ అవదన్|</para>
  <para style="p">
    <verse number="13" style="v"/>తస్య నగరస్య సమ్ముఖే స్థాపితస్య యూపితరవిగ్రహస్య యాజకో వృషాన్ పుష్పమాలాశ్చ ద్వారసమీపమ్ ఆనీయ లోకైః సర్ద్ధం తావుద్దిశ్య సముత్సృజ్య దాతుమ్ ఉద్యతః|</para>
  <para style="p">
    <verse number="14" style="v"/>తద్వార్త్తాం శ్రుత్వా బర్ణబ్బాపౌలౌ స్వీయవస్త్రాణి ఛిత్వా లోకానాం మధ్యం వేగేన ప్రవిశ్య ప్రోచ్చైః కథితవన్తౌ,</para>
  <para style="p">
    <verse number="15" style="v"/>హే మహేచ్ఛాః కుత ఏతాదృశం కర్మ్మ కురుథ? ఆవామపి యుష్మాదృశౌ సుఖదుఃఖభోగినౌ మనుష్యౌ, యుయమ్ ఏతాః సర్వ్వా వృథాకల్పనాః పరిత్యజ్య యథా గగణవసున్ధరాజలనిధీనాం తన్మధ్యస్థానాం సర్వ్వేషాఞ్చ స్రష్టారమమరమ్ ఈశ్వరం ప్రతి పరావర్త్తధ్వే తదర్థమ్ ఆవాం యుష్మాకం సన్నిధౌ సుసంవాదం ప్రచారయావః|</para>
  <para style="p">
    <verse number="16" style="v"/>స ఈశ్వరః పూర్వ్వకాలే సర్వ్వదేశీయలోకాన్ స్వస్వమార్గే చలితుమనుమతిం దత్తవాన్,</para>
  <para style="p">
    <verse number="17" style="v"/>తథాపి ఆకాశాత్ తోయవర్షణేన నానాప్రకారశస్యోత్పత్యా చ యుష్మాకం హితైషీ సన్ భక్ష్యైరాననదేన చ యుష్మాకమ్ అన్తఃకరణాని తర్పయన్ తాని దానాని నిజసాక్షిస్వరూపాణి స్థపితవాన్|</para>
  <para style="p">
    <verse number="18" style="v"/>కిన్తు తాదృశాయాం కథాయాం కథితాయామపి తయోః సమీప ఉత్సర్జనాత్ లోకనివహం ప్రాయేణ నివర్త్తయితుం నాశక్నుతామ్|</para>
  <para style="p">
    <verse number="19" style="v"/>ఆన్తియఖియా-ఇకనియనగరాభ్యాం కతిపయయిహూదీయలోకా ఆగత్య లోకాన్ ప్రావర్త్తయన్త తస్మాత్ తై పౌలం ప్రస్తరైరాఘ్నన్ తేన స మృత ఇతి విజ్ఞాయ నగరస్య బహిస్తమ్ ఆకృష్య నీతవన్తః|</para>
  <para style="p">
    <verse number="20" style="v"/>కిన్తు శిష్యగణే తస్య చతుర్దిశి తిష్ఠతి సతి స స్వయమ్ ఉత్థాయ పునరపి నగరమధ్యం ప్రావిశత్ తత్పరేఽహని బర్ణబ్బాసహితో దర్బ్బీనగరం గతవాన్|</para>
  <para style="p">
    <verse number="21" style="v"/>తత్ర సుసంవాదం ప్రచార్య్య బహులోకాన్ శిష్యాన్ కృత్వా తౌ లుస్త్రామ్ ఇకనియమ్ ఆన్తియఖియాఞ్చ పరావృత్య గతౌ|</para>
  <para style="p">
    <verse number="22" style="v"/>బహుదుఃఖాని భుక్త్వాపీశ్వరరాజ్యం ప్రవేష్టవ్యమ్ ఇతి కారణాద్ ధర్మ్మమార్గే స్థాతుం వినయం కృత్వా శిష్యగణస్య మనఃస్థైర్య్యమ్ అకురుతాం|</para>
  <para style="p">
    <verse number="23" style="v"/>మణ్డలీనాం ప్రాచీనవర్గాన్ నియుజ్య ప్రార్థనోపవాసౌ కృత్వా యత్ప్రభౌ తే వ్యశ్వసన్ తస్య హస్తే తాన్ సమర్ప్య</para>
  <para style="p">
    <verse number="24" style="v"/>పిసిదియామధ్యేన పామ్ఫులియాదేశం గతవన్తౌ|</para>
  <para style="p">
    <verse number="25" style="v"/>పశ్చాత్ పర్గానగరం గత్వా సుసంవాదం ప్రచార్య్య అత్తాలియానగరం ప్రస్థితవన్తౌ|</para>
  <para style="p">
    <verse number="26" style="v"/>తస్మాత్ సముద్రపథేన గత్వా తాభ్యాం యత్ కర్మ్మ సమ్పన్నం తత్కర్మ్మ సాధయితుం యన్నగరే దయాలోరీశ్వరస్య హస్తే సమర్పితౌ జాతౌ తద్ ఆన్తియఖియానగరం గతవన్తా|</para>
  <para style="p">
    <verse number="27" style="v"/>తత్రోపస్థాయ తన్నగరస్థమణ్డలీం సంగృహ్య స్వాభ్యామ ఈశ్వరో యద్యత్ కర్మ్మకరోత్ తథా యేన ప్రకారేణ భిన్నదేశీయలోకాన్ ప్రతి విశ్వాసరూపద్వారమ్ అమోచయద్ ఏతాన్ సర్వ్వవృత్తాన్తాన్ తాన్ జ్ఞాపితవన్తౌ|</para>
  <para style="p">
    <verse number="28" style="v"/>తతస్తౌ శిర్య్యైః సార్ద్ధం తత్ర బహుదినాని న్యవసతామ్|</para>
  <chapter number="15" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>యిహూదాదేశాత్ కియన్తో జనా ఆగత్య భ్రాతృగణమిత్థం శిక్షితవన్తో మూసావ్యవస్థయా యది యుష్మాకం త్వక్ఛేదో న భవతి తర్హి యూయం పరిత్రాణం ప్రాప్తుం న శక్ష్యథ|</para>
  <para style="p">
    <verse number="2" style="v"/>పౌలబర్ణబ్బౌ తైః సహ బహూన్ విచారాన్ వివాదాంశ్చ కృతవన్తౌ, తతో మణ్డలీయనోకా ఏతస్యాః కథాయాస్తత్త్వం జ్ఞాతుం యిరూశాలమ్నగరస్థాన్ ప్రేరితాన్ ప్రాచీనాంశ్చ ప్రతి పౌలబర్ణబ్బాప్రభృతీన్ కతిపయజనాన్ ప్రేషయితుం నిశ్చయం కృతవన్తః|</para>
  <para style="p">
    <verse number="3" style="v"/>తే మణ్డల్యా ప్రేరితాః సన్తః ఫైణీకీశోమిరోన్దేశాభ్యాం గత్వా భిన్నదేశీయానాం మనఃపరివర్త్తనస్య వార్త్తయా భ్రాతృణాం పరమాహ్లాదమ్ అజనయన్|</para>
  <para style="p">
    <verse number="4" style="v"/>యిరూశాలమ్యుపస్థాయ ప్రేరితగణేన లోకప్రాచీనగణేన సమాజేన చ సముపగృహీతాః సన్తః స్వైరీశ్వరో యాని కర్మ్మాణి కృతవాన్ తేషాం సర్వ్వవృత్తాన్తాన్ తేషాం సమక్షమ్ అకథయన్|</para>
  <para style="p">
    <verse number="5" style="v"/>కిన్తు విశ్వాసినః కియన్తః ఫిరూశిమతగ్రాహిణో లోకా ఉత్థాయ కథామేతాం కథితవన్తో భిన్నదేశీయానాం త్వక్ఛేదం కర్త్తుం మూసావ్యవస్థాం పాలయితుఞ్చ సమాదేష్టవ్యమ్|</para>
  <para style="p">
    <verse number="6" style="v"/>తతః ప్రేరితా లోకప్రాచీనాశ్చ తస్య వివేచనాం కర్త్తుం సభాయాం స్థితవన్తః|</para>
  <para style="p">
    <verse number="7" style="v"/>బహువిచారేషు జాతషు పితర ఉత్థాయ కథితవాన్, హే భ్రాతరో యథా భిన్నదేశీయలోకా మమ ముఖాత్ సుసంవాదం శ్రుత్వా విశ్వసన్తి తదర్థం బహుదినాత్ పూర్వ్వమ్ ఈశ్వరోస్మాకం మధ్యే మాం వృత్వా నియుక్తవాన్|</para>
  <para style="p">
    <verse number="8" style="v"/>అన్తర్య్యామీశ్వరో యథాస్మభ్యం తథా భిన్నదేశీయేభ్యః పవిత్రమాత్మానం ప్రదాయ విశ్వాసేన తేషామ్ అన్తఃకరణాని పవిత్రాణి కృత్వా</para>
  <para style="p">
    <verse number="9" style="v"/>తేషామ్ అస్మాకఞ్చ మధ్యే కిమపి విశేషం న స్థాపయిత్వా తానధి స్వయం ప్రమాణం దత్తవాన్ ఇతి యూయం జానీథ|</para>
  <para style="p">
    <verse number="10" style="v"/>అతఏవాస్మాకం పూర్వ్వపురుషా వయఞ్చ స్వయం యద్యుగస్య భారం సోఢుం న శక్తాః సమ్ప్రతి తం శిష్యగణస్య స్కన్ధేషు న్యసితుం కుత ఈశ్వరస్య పరీక్షాం కరిష్యథ?</para>
  <para style="p">
    <verse number="11" style="v"/>ప్రభో ర్యీశుఖ్రీష్టస్యానుగ్రహేణ తే యథా వయమపి తథా పరిత్రాణం ప్రాప్తుమ్ ఆశాం కుర్మ్మః|</para>
  <para style="p">
    <verse number="12" style="v"/>అనన్తరం బర్ణబ్బాపౌలాభ్యామ్ ఈశ్వరో భిన్నదేశీయానాం మధ్యే యద్యద్ ఆశ్చర్య్యమ్ అద్భుతఞ్చ కర్మ్మ కృతవాన్ తద్వృత్తాన్తం తౌ స్వముఖాభ్యామ్ అవర్ణయతాం సభాస్థాః సర్వ్వే నీరవాః సన్తః శ్రుతవన్తః|</para>
  <para style="p">
    <verse number="13" style="v"/>తయోః కథాయాం సమాప్తాయాం సత్యాం యాకూబ్ కథయితుమ్ ఆరబ్ధవాన్</para>
  <para style="p">
    <verse number="14" style="v"/>హే భ్రాతరో మమ కథాయామ్ మనో నిధత్త| ఈశ్వరః స్వనామార్థం భిన్నదేశీయలోకానామ్ మధ్యాద్ ఏకం లోకసంఘం గ్రహీతుం మతిం కృత్వా యేన ప్రకారేణ ప్రథమం తాన్ ప్రతి కృపావలేకనం కృతవాన్ తం శిమోన్ వర్ణితవాన్|</para>
  <para style="p">
    <verse number="15" style="v"/>భవిష్యద్వాదిభిరుక్తాని యాని వాక్యాని తైః సార్ద్ధమ్ ఏతస్యైక్యం భవతి యథా లిఖితమాస్తే|</para>
  <para style="p">
    <verse number="16" style="v"/>సర్వ్వేషాం కర్మ్మణాం యస్తు సాధకః పరమేశ్వరః| స ఏవేదం వదేద్వాక్యం శేషాః సకలమానవాః| భిన్నదేశీయలోకాశ్చ యావన్తో మమ నామతః| భవన్తి హి సువిఖ్యాతాస్తే యథా పరమేశితుః|</para>
  <para style="p">
    <verse number="17" style="v"/>తత్వం సమ్యక్ సమీహన్తే తన్నిమిత్తమహం కిల| పరావృత్య సమాగత్య దాయూదః పతితం పునః| దూష్యముత్థాపయిష్యామి తదీయం సర్వ్వవస్తు చ| పతితం పునరుథాప్య సజ్జయిష్యామి సర్వ్వథా||</para>
  <para style="p">
    <verse number="18" style="v"/>ఆ ప్రథమాద్ ఈశ్వరః స్వీయాని సర్వ్వకర్మ్మాణి జానాతి|</para>
  <para style="p">
    <verse number="19" style="v"/>అతఏవ మమ నివేదనమిదం భిన్నదేశీయలోకానాం మధ్యే యే జనా ఈశ్వరం ప్రతి పరావర్త్తన్త తేషాముపరి అన్యం కమపి భారం న న్యస్య</para>
  <para style="p">
    <verse number="20" style="v"/>దేవతాప్రసాదాశుచిభక్ష్యం వ్యభిచారకర్మ్మ కణ్ఠసమ్పీడనమారితప్రాణిభక్ష్యం రక్తభక్ష్యఞ్చ ఏతాని పరిత్యక్తుం లిఖామః|</para>
  <para style="p">
    <verse number="21" style="v"/>యతః పూర్వ్వకాలతో మూసావ్యవస్థాప్రచారిణో లోకా నగరే నగరే సన్తి ప్రతివిశ్రామవారఞ్చ భజనభవనే తస్యాః పాఠో భవతి|</para>
  <para style="p">
    <verse number="22" style="v"/>తతః పరం ప్రేరితగణో లోకప్రాచీనగణః సర్వ్వా మణ్డలీ చ స్వేషాం మధ్యే బర్శబ్బా నామ్నా విఖ్యాతో మనోనీతౌ కృత్వా పౌలబర్ణబ్బాభ్యాం సార్ద్ధమ్ ఆన్తియఖియానగరం ప్రతి ప్రేషణమ్ ఉచితం బుద్ధ్వా తాభ్యాం పత్రం ప్రైషయన్|</para>
  <para style="p">
    <verse number="23" style="v"/>తస్మిన్ పత్రే లిఖితమింద, ఆన్తియఖియా-సురియా-కిలికియాదేశస్థభిన్నదేశీయభ్రాతృగణాయ ప్రేరితగణస్య లోకప్రాచీనగణస్య భ్రాతృగణస్య చ నమస్కారః|</para>
  <para style="p">
    <verse number="24" style="v"/>విశేషతోఽస్మాకమ్ ఆజ్ఞామ్ అప్రాప్యాపి కియన్తో జనా అస్మాకం మధ్యాద్ గత్వా త్వక్ఛేదో మూసావ్యవస్థా చ పాలయితవ్యావితి యుష్మాన్ శిక్షయిత్వా యుష్మాకం మనసామస్థైర్య్యం కృత్వా యుష్మాన్ ససన్దేహాన్ అకుర్వ్వన్ ఏతాం కథాం వయమ్ అశృన్మ|</para>
  <para style="p">
    <verse number="25" style="v"/>తత్కారణాద్ వయమ్ ఏకమన్త్రణాః సన్తః సభాయాం స్థిత్వా ప్రభో ర్యీశుఖ్రీష్టస్య నామనిమిత్తం మృత్యుముఖగతాభ్యామస్మాకం</para>
  <para style="p">
    <verse number="26" style="v"/>ప్రియబర్ణబ్బాపౌలాభ్యాం సార్ద్ధం మనోనీతలోకానాం కేషాఞ్చిద్ యుష్మాకం సన్నిధౌ ప్రేషణమ్ ఉచితం బుద్ధవన్తః|</para>
  <para style="p">
    <verse number="27" style="v"/>అతో యిహూదాసీలౌ యుష్మాన్ ప్రతి ప్రేషితవన్తః, ఏతయో ర్ముఖాభ్యాం సర్వ్వాం కథాం జ్ఞాస్యథ|</para>
  <para style="p">
    <verse number="28" style="v"/>దేవతాప్రసాదభక్ష్యం రక్తభక్ష్యం గలపీడనమారితప్రాణిభక్ష్యం వ్యభిచారకర్మ్మ చేమాని సర్వ్వాణి యుష్మాభిస్త్యాజ్యాని; ఏతత్ప్రయోజనీయాజ్ఞావ్యతిరేకేన యుష్మాకమ్ ఉపరి భారమన్యం న న్యసితుం పవిత్రస్యాత్మనోఽస్మాకఞ్చ ఉచితజ్ఞానమ్ అభవత్|</para>
  <para style="p">
    <verse number="29" style="v"/>అతఏవ తేభ్యః సర్వ్వేభ్యః స్వేషు రక్షితేషు యూయం భద్రం కర్మ్మ కరిష్యథ| యుష్మాకం మఙ్గలం భూయాత్|</para>
  <para style="p">
    <verse number="30" style="v"/>తేे విసృష్టాః సన్త ఆన్తియఖియానగర ఉపస్థాయ లోకనివహం సంగృహ్య పత్రమ్ అదదన్|</para>
  <para style="p">
    <verse number="31" style="v"/>తతస్తే తత్పత్రం పఠిత్వా సాన్త్వనాం ప్రాప్య సానన్దా అభవన్|</para>
  <para style="p">
    <verse number="32" style="v"/>యిహూదాసీలౌ చ స్వయం ప్రచారకౌ భూత్వా భ్రాతృగణం నానోపదిశ్య తాన్ సుస్థిరాన్ అకురుతామ్|</para>
  <para style="p">
    <verse number="33" style="v"/>ఇత్థం తౌ తత్ర తైః సాకం కతిపయదినాని యాపయిత్వా పశ్చాత్ ప్రేరితానాం సమీపే ప్రత్యాగమనార్థం తేషాం సన్నిధేః కల్యాణేన విసృష్టావభవతాం|</para>
  <para style="p">
    <verse number="34" style="v"/>కిన్తు సీలస్తత్ర స్థాతుం వాఞ్ఛితవాన్|</para>
  <para style="p">
    <verse number="35" style="v"/>అపరం పౌలబర్ణబ్బౌ బహవః శిష్యాశ్చ లోకాన్ ఉపదిశ్య ప్రభోః సుసంవాదం ప్రచారయన్త ఆన్తియఖియాయాం కాలం యాపితవన్తః|</para>
  <para style="p">
    <verse number="36" style="v"/>కతిపయదినేషు గతేషు పౌలో బర్ణబ్బామ్ అవదత్ ఆగచ్ఛావాం యేషు నగరేష్వీశ్వరస్య సుసంవాదం ప్రచారితవన్తౌ తాని సర్వ్వనగరాణి పునర్గత్వా భ్రాతరః కీదృశాః సన్తీతి ద్రష్టుం తాన్ సాక్షాత్ కుర్వ్వః|</para>
  <para style="p">
    <verse number="37" style="v"/>తేన మార్కనామ్నా విఖ్యాతం యోహనం సఙ్గినం కర్త్తుం బర్ణబ్బా మతిమకరోత్,</para>
  <para style="p">
    <verse number="38" style="v"/>కిన్తు స పూర్వ్వం తాభ్యాం సహ కార్య్యార్థం న గత్వా పామ్ఫూలియాదేశే తౌ త్యక్తవాన్ తత్కారణాత్ పౌలస్తం సఙ్గినం కర్త్తుమ్ అనుచితం జ్ఞాతవాన్|</para>
  <para style="p">
    <verse number="39" style="v"/>ఇత్థం తయోరతిశయవిరోధస్యోపస్థితత్వాత్ తౌ పరస్పరం పృథగభవతాం తతో బర్ణబ్బా మార్కం గృహీత్వా పోతేన కుప్రోపద్వీపం గతవాన్;</para>
  <para style="p">
    <verse number="40" style="v"/>కిన్తు పౌలః సీలం మనోనీతం కృత్వా భ్రాతృభిరీశ్వరానుగ్రహే సమర్పితః సన్ ప్రస్థాయ</para>
  <para style="p">
    <verse number="41" style="v"/>సురియాకిలికియాదేశాభ్యాం మణ్డలీః స్థిరీకుర్వ్వన్ అగచ్ఛత్|</para>
  <chapter number="16" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>పౌలో దర్బ్బీలుస్త్రానగరయోరుపస్థితోభవత్ తత్ర తీమథియనామా శిష్య ఏక ఆసీత్; స విశ్వాసిన్యా యిహూదీయాయా యోషితో గర్బ్భజాతః కిన్తు తస్య పితాన్యదేశీయలోకః|</para>
  <para style="p">
    <verse number="2" style="v"/>స జనో లుస్త్రా-ఇకనియనగరస్థానాం భ్రాతృణాం సమీపేపి సుఖ్యాతిమాన్ ఆసీత్|</para>
  <para style="p">
    <verse number="3" style="v"/>పౌలస్తం స్వసఙ్గినం కర్త్తుం మతిం కృత్వా తం గృహీత్వా తద్దేశనివాసినాం యిహూదీయానామ్ అనురోధాత్ తస్య త్వక్ఛేదం కృతవాన్ యతస్తస్య పితా భిన్నదేశీయలోక ఇతి సర్వ్వైరజ్ఞాయత|</para>
  <para style="p">
    <verse number="4" style="v"/>తతః పరం తే నగరే నగరే భ్రమిత్వా యిరూశాలమస్థైః ప్రేరితై ర్లోకప్రాచీనైశ్చ నిరూపితం యద్ వ్యవస్థాపత్రం తదనుసారేణాచరితుం లోకేభ్యస్తద్ దత్తవన్తః|</para>
  <para style="p">
    <verse number="5" style="v"/>తేనైవ సర్వ్వే ధర్మ్మసమాజాః ఖ్రీష్టధర్మ్మే సుస్థిరాః సన్తః ప్రతిదినం వర్ద్ధితా అభవన్|</para>
  <para style="p">
    <verse number="6" style="v"/>తేషు ఫ్రుగియాగాలాతియాదేశమధ్యేన గతేషు సత్సు పవిత్ర ఆత్మా తాన్ ఆశియాదేశే కథాం ప్రకాశయితుం ప్రతిషిద్ధవాన్|</para>
  <para style="p">
    <verse number="7" style="v"/>తథా ముసియాదేశ ఉపస్థాయ బిథునియాం గన్తుం తైరుద్యోగే కృతే ఆత్మా తాన్ నాన్వమన్యత|</para>
  <para style="p">
    <verse number="8" style="v"/>తస్మాత్ తే ముసియాదేశం పరిత్యజ్య త్రోయానగరం గత్వా సముపస్థితాః|</para>
  <para style="p">
    <verse number="9" style="v"/>రాత్రౌ పౌలః స్వప్నే దృష్టవాన్ ఏకో మాకిదనియలోకస్తిష్ఠన్ వినయం కృత్వా తస్మై కథయతి, మాకిదనియాదేశమ్ ఆగత్యాస్మాన్ ఉపకుర్వ్వితి|</para>
  <para style="p">
    <verse number="10" style="v"/>తస్యేత్థం స్వప్నదర్శనాత్ ప్రభుస్తద్దేశీయలోకాన్ ప్రతి సుసంవాదం ప్రచారయితుమ్ అస్మాన్ ఆహూయతీతి నిశ్చితం బుద్ధ్వా వయం తూర్ణం మాకిదనియాదేశం గన్తుమ్ ఉద్యోగమ్ అకుర్మ్మ|</para>
  <para style="p">
    <verse number="11" style="v"/>తతః పరం వయం త్రోయానగరాద్ ప్రస్థాయ ఋజుమార్గేణ సామథ్రాకియోపద్వీపేన గత్వా పరేఽహని నియాపలినగర ఉపస్థితాః|</para>
  <para style="p">
    <verse number="12" style="v"/>తస్మాద్ గత్వా మాకిదనియాన్తర్వ్వర్త్తి రోమీయవసతిస్థానం యత్ ఫిలిపీనామప్రధాననగరం తత్రోపస్థాయ కతిపయదినాని తత్ర స్థితవన్తః|</para>
  <para style="p">
    <verse number="13" style="v"/>విశ్రామవారే నగరాద్ బహి ర్గత్వా నదీతటే యత్ర ప్రార్థనాచార ఆసీత్ తత్రోపవిశ్య సమాగతా నారీః ప్రతి కథాం ప్రాచారయామ|</para>
  <para style="p">
    <verse number="14" style="v"/>తతః థుయాతీరానగరీయా ధూషరామ్బరవిక్రాయిణీ లుదియానామికా యా ఈశ్వరసేవికా యోషిత్ శ్రోత్రీణాం మధ్య ఆసీత్ తయా పౌలోక్తవాక్యాని యద్ గృహ్యన్తే తదర్థం ప్రభుస్తస్యా మనోద్వారం ముక్తవాన్|</para>
  <para style="p">
    <verse number="15" style="v"/>అతః సా యోషిత్ సపరివారా మజ్జితా సతీ వినయం కృత్వా కథితవతీ, యుష్మాకం విచారాద్ యది ప్రభౌ విశ్వాసినీ జాతాహం తర్హి మమ గృహమ్ ఆగత్య తిష్ఠత| ఇత్థం సా యత్నేనాస్మాన్ అస్థాపయత్|</para>
  <para style="p">
    <verse number="16" style="v"/>యస్యా గణనయా తదధిపతీనాం బహుధనోపార్జనం జాతం తాదృశీ గణకభూతగ్రస్తా కాచన దాసీ ప్రార్థనాస్థానగమనకాల ఆగత్యాస్మాన్ సాక్షాత్ కృతవతీ|</para>
  <para style="p">
    <verse number="17" style="v"/>సాస్మాకం పౌలస్య చ పశ్చాద్ ఏత్య ప్రోచ్చైః కథామిమాం కథితవతీ, మనుష్యా ఏతే సర్వ్వోపరిస్థస్యేశ్వరస్య సేవకాః సన్తోఽస్మాన్ ప్రతి పరిత్రాణస్య మార్గం ప్రకాశయన్తి|</para>
  <para style="p">
    <verse number="18" style="v"/>సా కన్యా బహుదినాని తాదృశమ్ అకరోత్ తస్మాత్ పౌలో దుఃఖితః సన్ ముఖం పరావర్త్య తం భూతమవదద్, అహం యీశుఖ్రీష్టస్య నామ్నా త్వామాజ్ఞాపయామి త్వమస్యా బహిర్గచ్ఛ; తేనైవ తత్క్షణాత్ స భూతస్తస్యా బహిర్గతః|</para>
  <para style="p">
    <verse number="19" style="v"/>తతః స్వేషాం లాభస్య ప్రత్యాశా విఫలా జాతేతి విలోక్య తస్యాః ప్రభవః పౌలం సీలఞ్చ ధృత్వాకృష్య విచారస్థానేఽధిపతీనాం సమీపమ్ ఆనయన్|</para>
  <para style="p">
    <verse number="20" style="v"/>తతః శాసకానాం నికటం నీత్వా రోమిలోకా వయమ్ అస్మాకం యద్ వ్యవహరణం గ్రహీతుమ్ ఆచరితుఞ్చ నిషిద్ధం,</para>
  <para style="p">
    <verse number="21" style="v"/>ఇమే యిహూదీయలోకాః సన్తోపి తదేవ శిక్షయిత్వా నగరేఽస్మాకమ్ అతీవ కలహం కుర్వ్వన్తి,</para>
  <para style="p">
    <verse number="22" style="v"/>ఇతి కథితే సతి లోకనివహస్తయోః ప్రాతికూల్యేనోదతిష్ఠత్ తథా శాసకాస్తయో ర్వస్త్రాణి ఛిత్వా వేత్రాఘాతం కర్త్తుమ్ ఆజ్ఞాపయన్|</para>
  <para style="p">
    <verse number="23" style="v"/>అపరం తే తౌ బహు ప్రహార్య్య త్వమేతౌ కారాం నీత్వా సావధానం రక్షయేతి కారారక్షకమ్ ఆదిశన్|</para>
  <para style="p">
    <verse number="24" style="v"/>ఇత్థమ్ ఆజ్ఞాం ప్రాప్య స తావభ్యన్తరస్థకారాం నీత్వా పాదేషు పాదపాశీభి ర్బద్ధ్వా స్థాపితావాన్|</para>
  <para style="p">
    <verse number="25" style="v"/>అథ నిశీథసమయే పౌలసీలావీశ్వరముద్దిశ్య ప్రాథనాం గానఞ్చ కృతవన్తౌ, కారాస్థితా లోకాశ్చ తదశృణ్వన్</para>
  <para style="p">
    <verse number="26" style="v"/>తదాకస్మాత్ మహాన్ భూమికమ్పోఽభవత్ తేన భిత్తిమూలేన సహ కారా కమ్పితాభూత్ తత్క్షణాత్ సర్వ్వాణి ద్వారాణి ముక్తాని జాతాని సర్వ్వేషాం బన్ధనాని చ ముక్తాని|</para>
  <para style="p">
    <verse number="27" style="v"/>అతఏవ కారారక్షకో నిద్రాతో జాగరిత్వా కారాయా ద్వారాణి ముక్తాని దృష్ట్వా బన్దిలోకాః పలాయితా ఇత్యనుమాయ కోషాత్ ఖఙ్గం బహిః కృత్వాత్మఘాతం కర్త్తుమ్ ఉద్యతః|</para>
  <para style="p">
    <verse number="28" style="v"/>కిన్తు పౌలః ప్రోచ్చైస్తమాహూయ కథితవాన్ పశ్య వయం సర్వ్వేఽత్రాస్మహే, త్వం నిజప్రాణహింసాం మాకార్షీః|</para>
  <para style="p">
    <verse number="29" style="v"/>తదా ప్రదీపమ్ ఆనేతుమ్ ఉక్త్వా స కమ్పమానః సన్ ఉల్లమ్ప్యాభ్యన్తరమ్ ఆగత్య పౌలసీలయోః పాదేషు పతితవాన్|</para>
  <para style="p">
    <verse number="30" style="v"/>పశ్చాత్ స తౌ బహిరానీయ పృష్టవాన్ హే మహేచ్ఛౌ పరిత్రాణం ప్రాప్తుం మయా కిం కర్త్తవ్యం?</para>
  <para style="p">
    <verse number="31" style="v"/>పశ్చాత్ తౌ స్వగృహమానీయ తయోః సమ్ముఖే ఖాద్యద్రవ్యాణి స్థాపితవాన్ తథా స స్వయం తదీయాః సర్వ్వే పరివారాశ్చేశ్వరే విశ్వసన్తః సానన్దితా అభవన్|</para>
  <para style="p">
    <verse number="32" style="v"/>తస్మై తస్య గృహస్థితసర్వ్వలోకేభ్యశ్చ ప్రభోః కథాం కథితవన్తౌ|</para>
  <para style="p">
    <verse number="33" style="v"/>తథా రాత్రేస్తస్మిన్నేవ దణ్డే స తౌ గృహీత్వా తయోః ప్రహారాణాం క్షతాని ప్రక్షాలితవాన్ తతః స స్వయం తస్య సర్వ్వే పరిజనాశ్చ మజ్జితా అభవన్|</para>
  <para style="p">
    <verse number="34" style="v"/>పశ్చాత్ తౌ స్వగృహమానీయ తయోః సమ్ముఖే ఖాద్యద్రవ్యాణి స్థాపితవాన్ తథా స స్వయం తదీయాః సర్వ్వే పరివారాశ్చేశ్వరే విశ్వసన్తః సానన్దితా అభవన్|</para>
  <para style="p">
    <verse number="35" style="v"/>దిన ఉపస్థితే తౌ లోకౌ మోచయేతి కథాం కథయితుం శాసకాః పదాతిగణం ప్రేషితవన్తః|</para>
  <para style="p">
    <verse number="36" style="v"/>తతః కారారక్షకః పౌలాయ తాం వార్త్తాం కథితవాన్ యువాం త్యాజయితుం శాసకా లోకాన ప్రేషితవన్త ఇదానీం యువాం బహి ర్భూత్వా కుశలేన ప్రతిష్ఠేతాం|</para>
  <para style="p">
    <verse number="37" style="v"/>కిన్తు పౌలస్తాన్ అవదత్ రోమిలోకయోరావయోః కమపి దోషమ్ న నిశ్చిత్య సర్వ్వేషాం సమక్షమ్ ఆవాం కశయా తాడయిత్వా కారాయాం బద్ధవన్త ఇదానీం కిమావాం గుప్తం విస్త్రక్ష్యన్తి? తన్న భవిష్యతి, స్వయమాగత్యావాం బహిః కృత్వా నయన్తు|</para>
  <para style="p">
    <verse number="38" style="v"/>తదా పదాతిభిః శాసకేభ్య ఏతద్వార్త్తాయాం కథితాయాం తౌ రోమిలోకావితి కథాం శ్రుత్వా తే భీతాః</para>
  <para style="p">
    <verse number="39" style="v"/>సన్తస్తయోః సన్నిధిమాగత్య వినయమ్ అకుర్వ్వన్ అపరం బహిః కృత్వా నగరాత్ ప్రస్థాతుం ప్రార్థితవన్తః|</para>
  <para style="p">
    <verse number="40" style="v"/>తతస్తౌ కారాయా నిర్గత్య లుదియాయా గృహం గతవన్తౌ తత్ర భ్రాతృగణం సాక్షాత్కృత్య తాన్ సాన్త్వయిత్వా తస్మాత్ స్థానాత్ ప్రస్థితౌ|</para>
  <chapter number="17" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>పౌలసీలౌ ఆమ్ఫిపల్యాపల్లోనియానగరాభ్యాం గత్వా యత్ర యిహూదీయానాం భజనభవనమేకమ్ ఆస్తే తత్ర థిషలనీకీనగర ఉపస్థితౌ|</para>
  <para style="p">
    <verse number="2" style="v"/>తదా పౌలః స్వాచారానుసారేణ తేషాం సమీపం గత్వా విశ్రామవారత్రయే తైః సార్ద్ధం ధర్మ్మపుస్తకీయకథాయా విచారం కృతవాన్|</para>
  <para style="p">
    <verse number="3" style="v"/>ఫలతః ఖ్రీష్టేన దుఃఖభోగః కర్త్తవ్యః శ్మశానదుత్థానఞ్చ కర్త్తవ్యం యుష్మాకం సన్నిధౌ యస్య యీశోః ప్రస్తావం కరోమి స ఈశ్వరేణాభిషిక్తః స ఏతాః కథాః ప్రకాశ్య ప్రమాణం దత్వా స్థిరీకృతవాన్|</para>
  <para style="p">
    <verse number="4" style="v"/>తస్మాత్ తేషాం కతిపయజనా అన్యదేశీయా బహవో భక్తలోకా బహ్యః ప్రధాననార్య్యశ్చ విశ్వస్య పౌలసీలయోః పశ్చాద్గామినో జాతాః|</para>
  <para style="p">
    <verse number="5" style="v"/>కిన్తు విశ్వాసహీనా యిహూదీయలోకా ఈర్ష్యయా పరిపూర్ణాః సన్తో హటట్స్య కతినయలమ్పటలోకాన్ సఙ్గినః కృత్వా జనతయా నగరమధ్యే మహాకలహం కృత్వా యాసోనో గృహమ్ ఆక్రమ్య ప్రేరితాన్ ధృత్వా లోకనివహస్య సమీపమ్ ఆనేతుం చేష్టితవన్తః|</para>
  <para style="p">
    <verse number="6" style="v"/>తేషాముద్దేశమ్ అప్రాప్య చ యాసోనం కతిపయాన్ భ్రాతృంశ్చ ధృత్వా నగరాధిపతీనాం నికటమానీయ ప్రోచ్చైః కథితవన్తో యే మనుష్యా జగదుద్వాటితవన్తస్తే ఽత్రాప్యుపస్థితాః సన్తి,</para>
  <para style="p">
    <verse number="7" style="v"/>ఏష యాసోన్ ఆతిథ్యం కృత్వా తాన్ గృహీతవాన్| యీశునామక ఏకో రాజస్తీతి కథయన్తస్తే కైసరస్యాజ్ఞావిరుద్ధం కర్మ్మ కుర్వ్వతి|</para>
  <para style="p">
    <verse number="8" style="v"/>తేషాం కథామిమాం శ్రుత్వా లోకనివహో నగరాధిపతయశ్చ సముద్విగ్నా అభవన్|</para>
  <para style="p">
    <verse number="9" style="v"/>తదా యాసోనస్తదన్యేషాఞ్చ ధనదణ్డం గృహీత్వా తాన్ పరిత్యక్తవన్తః|</para>
  <para style="p">
    <verse number="10" style="v"/>తతః పరం భ్రాతృగణో రజన్యాం పౌలసీలౌ శీఘ్రం బిరయానగరం ప్రేషితవాన్ తౌ తత్రోపస్థాయ యిహూదీయానాం భజనభవనం గతవన్తౌ|</para>
  <para style="p">
    <verse number="11" style="v"/>తత్రస్థా లోకాః థిషలనీకీస్థలోకేభ్యో మహాత్మాన ఆసన్ యత ఇత్థం భవతి న వేతి జ్ఞాతుం దినే దినే ధర్మ్మగ్రన్థస్యాలోచనాం కృత్వా స్వైరం కథామ్ అగృహ్లన్|</para>
  <para style="p">
    <verse number="12" style="v"/>తస్మాద్ అనేకే యిహూదీయా అన్యదేశీయానాం మాన్యా స్త్రియః పురుషాశ్చానేకే వ్యశ్వసన్|</para>
  <para style="p">
    <verse number="13" style="v"/>కిన్తు బిరయానగరే పౌలేనేశ్వరీయా కథా ప్రచార్య్యత ఇతి థిషలనీకీస్థా యిహూదీయా జ్ఞాత్వా తత్స్థానమప్యాగత్య లోకానాం కుప్రవృత్తిమ్ అజనయన్|</para>
  <para style="p">
    <verse number="14" style="v"/>అతఏవ తస్మాత్ స్థానాత్ సముద్రేణ యాన్తీతి దర్శయిత్వా భ్రాతరః క్షిప్రం పౌలం ప్రాహిణ్వన్ కిన్తు సీలతీమథియౌ తత్ర స్థితవన్తౌ|</para>
  <para style="p">
    <verse number="15" style="v"/>తతః పరం పౌలస్య మార్గదర్శకాస్తమ్ ఆథీనీనగర ఉపస్థాపయన్ పశ్చాద్ యువాం తూర్ణమ్ ఏతత్ స్థానం ఆగమిష్యథః సీలతీమథియౌ ప్రతీమామ్ ఆజ్ఞాం ప్రాప్య తే ప్రత్యాగతాః|</para>
  <para style="p">
    <verse number="16" style="v"/>పౌల ఆథీనీనగరే తావపేక్ష్య తిష్ఠన్ తన్నగరం ప్రతిమాభిః పరిపూర్ణం దృష్ట్వా సన్తప్తహృదయో ఽభవత్|</para>
  <para style="p">
    <verse number="17" style="v"/>తతః స భజనభవనే యాన్ యిహూదీయాన్ భక్తలోకాంశ్చ హట్టే చ యాన్ అపశ్యత్ తైః సహ ప్రతిదినం విచారితవాన్|</para>
  <para style="p">
    <verse number="18" style="v"/>కిన్త్విపికూరీయమతగ్రహిణః స్తోయికీయమతగ్రాహిణశ్చ కియన్తో జనాస్తేన సార్ద్ధం వ్యవదన్త| తత్ర కేచిద్ అకథయన్ ఏష వాచాలః కిం వక్తుమ్ ఇచ్ఛతి? అపరే కేచిద్ ఏష జనః కేషాఞ్చిద్ విదేశీయదేవానాం ప్రచారక ఇత్యనుమీయతే యతః స యీశుమ్ ఉత్థితిఞ్చ ప్రచారయత్|</para>
  <para style="p">
    <verse number="19" style="v"/>తే తమ్ అరేయపాగనామ విచారస్థానమ్ ఆనీయ ప్రావోచన్ ఇదం యన్నవీనం మతం త్వం ప్రాచీకశ ఇదం కీదృశం ఏతద్ అస్మాన్ శ్రావయ;</para>
  <para style="p">
    <verse number="20" style="v"/>యామిమామ్ అసమ్భవకథామ్ అస్మాకం కర్ణగోచరీకృతవాన్ అస్యా భావార్థః క ఇతి వయం జ్ఞాతుమ్ ఇచ్ఛామః|</para>
  <para style="p">
    <verse number="21" style="v"/>తదాథీనీనివాసినస్తన్నగరప్రవాసినశ్చ కేవలం కస్యాశ్చన నవీనకథాయాః శ్రవణేన ప్రచారణేన చ కాలమ్ అయాపయన్|</para>
  <para style="p">
    <verse number="22" style="v"/>పౌలోఽరేయపాగస్య మధ్యే తిష్ఠన్ ఏతాం కథాం ప్రచారితవాన్, హే ఆథీనీయలోకా యూయం సర్వ్వథా దేవపూజాయామ్ ఆసక్తా ఇత్యహ ప్రత్యక్షం పశ్యామి|</para>
  <para style="p">
    <verse number="23" style="v"/>యతః పర్య్యటనకాలే యుష్మాకం పూజనీయాని పశ్యన్ ‘అవిజ్ఞాతేశ్వరాయ’ ఏతల్లిపియుక్తాం యజ్ఞవేదీమేకాం దృష్టవాన్; అతో న విదిత్వా యం పూజయధ్వే తస్యైవ తత్వం యుష్మాన్ ప్రతి ప్రచారయామి|</para>
  <para style="p">
    <verse number="24" style="v"/>జగతో జగత్స్థానాం సర్వ్వవస్తూనాఞ్చ స్రష్టా య ఈశ్వరః స స్వర్గపృథివ్యోరేకాధిపతిః సన్ కరనిర్మ్మితమన్దిరేషు న నివసతి;</para>
  <para style="p">
    <verse number="25" style="v"/>స ఏవ సర్వ్వేభ్యో జీవనం ప్రాణాన్ సర్వ్వసామగ్రీశ్చ ప్రదదాతి; అతఏవ స కస్యాశ్చిత్ సామగ్య్రా అభావహేతో ర్మనుష్యాణాం హస్తైః సేవితో భవతీతి న|</para>
  <para style="p">
    <verse number="26" style="v"/>స భూమణ్డలే నివాసార్థమ్ ఏకస్మాత్ శోణితాత్ సర్వ్వాన్ మనుష్యాన్ సృష్ట్వా తేషాం పూర్వ్వనిరూపితసమయం వసతిసీమాఞ్చ నిరచినోత్;</para>
  <para style="p">
    <verse number="27" style="v"/>తస్మాత్ లోకైః కేనాపి ప్రకారేణ మృగయిత్వా పరమేశ్వరస్య తత్వం ప్రాప్తుం తస్య గవేషణం కరణీయమ్|</para>
  <para style="p">
    <verse number="28" style="v"/>కిన్తు సోఽస్మాకం కస్మాచ్చిదపి దూరే తిష్ఠతీతి నహి, వయం తేన నిశ్వసనప్రశ్వసనగమనాగమనప్రాణధారణాని కుర్మ్మః, పుुనశ్చ యుష్మాకమేవ కతిపయాః కవయః కథయన్తి ‘తస్య వంశా వయం స్మో హి’ ఇతి|</para>
  <para style="p">
    <verse number="29" style="v"/>అతఏవ యది వయమ్ ఈశ్వరస్య వంశా భవామస్తర్హి మనుష్యై ర్విద్యయా కౌశలేన చ తక్షితం స్వర్ణం రూప్యం దృషద్ వైతేషామీశ్వరత్వమ్ అస్మాభి ర్న జ్ఞాతవ్యం|</para>
  <para style="p">
    <verse number="30" style="v"/>తేషాం పూర్వ్వీయలోకానామ్ అజ్ఞానతాం ప్రతీశ్వరో యద్యపి నావాధత్త తథాపీదానీం సర్వ్వత్ర సర్వ్వాన్ మనః పరివర్త్తయితుమ్ ఆజ్ఞాపయతి,</para>
  <para style="p">
    <verse number="31" style="v"/>యతః స్వనియుక్తేన పురుషేణ యదా స పృథివీస్థానాం సర్వ్వలోకానాం విచారం కరిష్యతి తద్దినం న్యరూపయత్; తస్య శ్మశానోత్థాపనేన తస్మిన్ సర్వ్వేభ్యః ప్రమాణం ప్రాదాత్|</para>
  <para style="p">
    <verse number="32" style="v"/>తదా శ్మశానాద్ ఉత్థానస్య కథాం శ్రుత్వా కేచిద్ ఉపాహమన్, కేచిదవదన్ ఏనాం కథాం పునరపి త్వత్తః శ్రోష్యామః|</para>
  <para style="p">
    <verse number="33" style="v"/>తతః పౌలస్తేషాం సమీపాత్ ప్రస్థిाతవాన్|</para>
  <para style="p">
    <verse number="34" style="v"/>తథాపి కేచిల్లోకాస్తేన సార్ద్ధం మిలిత్వా వ్యశ్వసన్ తేషాం మధ్యే ఽరేయపాగీయదియనుసియో దామారీనామా కాచిన్నారీ కియన్తో నరాశ్చాసన్|</para>
  <chapter number="18" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>తద్ఘటనాతః పరం పౌల ఆథీనీనగరాద్ యాత్రాం కృత్వా కరిన్థనగరమ్ ఆగచ్ఛత్|</para>
  <para style="p">
    <verse number="2" style="v"/>తస్మిన్ సమయే క్లౌదియః సర్వ్వాన్ యిహూదీయాన్ రోమానగరం విహాయ గన్తుమ్ ఆజ్ఞాపయత్, తస్మాత్ ప్రిస్కిల్లానామ్నా జాయయా సార్ద్ధమ్ ఇతాలియాదేశాత్ కిఞ్చిత్పూర్వ్వమ్ ఆగమత్ యః పన్తదేశే జాత ఆక్కిలనామా యిహూదీయలోకః పౌలస్తం సాక్షాత్ ప్రాప్య తయోః సమీపమితవాన్|</para>
  <para style="p">
    <verse number="3" style="v"/>తౌ దూష్యనిర్మ్మాణజీవినౌ, తస్మాత్ పరస్పరమ్ ఏకవృత్తికత్వాత్ స తాభ్యాం సహ ఉషిత్వా తత్ కర్మ్మాకరోత్|</para>
  <para style="p">
    <verse number="4" style="v"/>పౌలః ప్రతివిశ్రామవారం భజనభవనం గత్వా విచారం కృత్వా యిహూదీయాన్ అన్యదేశీయాంశ్చ ప్రవృత్తిం గ్రాహితవాన్|</para>
  <para style="p">
    <verse number="5" style="v"/>సీలతీమథియయో ర్మాకిదనియాదేశాత్ సమేతయోః సతోః పౌల ఉత్తప్తమనా భూత్వా యీశురీశ్వరేణాభిషిక్తో భవతీతి ప్రమాణం యిహూదీయానాం సమీపే ప్రాదాత్|</para>
  <para style="p">
    <verse number="6" style="v"/>కిన్తు తే ఽతీవ విరోధం విధాయ పాషణ్డీయకథాం కథితవన్తస్తతః పౌలో వస్త్రం ధున్వన్ ఏతాం కథాం కథితవాన్, యుష్మాకం శోణితపాతాపరాధో యుష్మాన్ ప్రత్యేవ భవతు, తేనాహం నిరపరాధో ఽద్యారభ్య భిన్నదేశీయానాం సమీపం యామి|</para>
  <para style="p">
    <verse number="7" style="v"/>స తస్మాత్ ప్రస్థాయ భజనభవనసమీపస్థస్య యుస్తనామ్న ఈశ్వరభక్తస్య భిన్నదేశీయస్య నివేశనం ప్రావిశత్|</para>
  <para style="p">
    <verse number="8" style="v"/>తతః క్రీష్పనామా భజనభవనాధిపతిః సపరివారః ప్రభౌ వ్యశ్వసీత్, కరిన్థనగరీయా బహవో లోకాశ్చ సమాకర్ణ్య విశ్వస్య మజ్జితా అభవన్|</para>
  <para style="p">
    <verse number="9" style="v"/>క్షణదాయాం ప్రభుః పౌలం దర్శనం దత్వా భాషితవాన్, మా భైషీః, మా నిరసీః కథాం ప్రచారయ|</para>
  <para style="p">
    <verse number="10" style="v"/>అహం త్వయా సార్ద్ధమ్ ఆస హింసార్థం కోపి త్వాం స్ప్రష్టుం న శక్ష్యతి నగరేఽస్మిన్ మదీయా లోకా బహవ ఆసతే|</para>
  <para style="p">
    <verse number="11" style="v"/>తస్మాత్ పౌలస్తన్నగరే ప్రాయేణ సార్ద్ధవత్సరపర్య్యన్తం సంస్థాయేశ్వరస్య కథామ్ ఉపాదిశత్|</para>
  <para style="p">
    <verse number="12" style="v"/>గాల్లియనామా కశ్చిద్ ఆఖాయాదేశస్య ప్రాడ్వివాకః సమభవత్, తతో యిహూదీయా ఏకవాక్యాః సన్తః పౌలమ్ ఆక్రమ్య విచారస్థానం నీత్వా</para>
  <para style="p">
    <verse number="13" style="v"/>మానుష ఏష వ్యవస్థాయ విరుద్ధమ్ ఈశ్వరభజనం కర్త్తుం లోకాన్ కుప్రవృత్తిం గ్రాహయతీతి నివేదితవన్తః|</para>
  <para style="p">
    <verse number="14" style="v"/>తతః పౌలే ప్రత్యుత్తరం దాతుమ్ ఉద్యతే సతి గాల్లియా యిహూదీయాన్ వ్యాహరత్, యది కస్యచిద్ అన్యాయస్య వాతిశయదుష్టతాచరణస్య విచారోఽభవిష్యత్ తర్హి యుష్మాకం కథా మయా సహనీయాభవిష్యత్|</para>
  <para style="p">
    <verse number="15" style="v"/>కిన్తు యది కేవలం కథాయా వా నామ్నో వా యుష్మాకం వ్యవస్థాయా వివాదో భవతి తర్హి తస్య విచారమహం న కరిష్యామి, యూయం తస్య మీమాంసాం కురుత|</para>
  <para style="p">
    <verse number="16" style="v"/>తతః స తాన్ విచారస్థానాద్ దూరీకృతవాన్|</para>
  <para style="p">
    <verse number="17" style="v"/>తదా భిన్నదేశీయాః సోస్థినినామానం భజనభవనస్య ప్రధానాధిపతిం ధృత్వా విచారస్థానస్య సమ్ముఖే ప్రాహరన్ తథాపి గాల్లియా తేషు సర్వ్వకర్మ్మసు న మనో న్యదధాత్|</para>
  <para style="p">
    <verse number="18" style="v"/>పౌలస్తత్ర పునర్బహుదినాని న్యవసత్, తతో భ్రాతృగణాద్ విసర్జనం ప్రాప్య కిఞ్చనవ్రతనిమిత్తం కింక్రియానగరే శిరో ముణ్డయిత్వా ప్రిస్కిల్లాక్కిలాభ్యాం సహితో జలపథేన సురియాదేశం గతవాన్|</para>
  <para style="p">
    <verse number="19" style="v"/>తత ఇఫిషనగర ఉపస్థాయ తత్ర తౌ విసృజ్య స్వయం భజనభ్వనం ప్రవిశ్య యిహూదీయైః సహ విచారితవాన్|</para>
  <para style="p">
    <verse number="20" style="v"/>తే స్వైః సార్ద్ధం పునః కతిపయదినాని స్థాతుం తం వ్యనయన్, స తదనురరీకృత్య కథామేతాం కథితవాన్,</para>
  <para style="p">
    <verse number="21" style="v"/>యిరూశాలమి ఆగామ్యుత్సవపాలనార్థం మయా గమనీయం; పశ్చాద్ ఈశ్వరేచ్ఛాయాం జాతాయాం యుష్మాకం సమీపం ప్రత్యాగమిష్యామి| తతః పరం స తై ర్విసృష్టః సన్ జలపథేన ఇఫిషనగరాత్ ప్రస్థితవాన్|</para>
  <para style="p">
    <verse number="22" style="v"/>తతః కైసరియామ్ ఉపస్థితః సన్ నగరం గత్వా సమాజం నమస్కృత్య తస్మాద్ ఆన్తియఖియానగరం ప్రస్థితవాన్|</para>
  <para style="p">
    <verse number="23" style="v"/>తత్ర కియత్కాలం యాపయిత్వా తస్మాత్ ప్రస్థాయ సర్వ్వేషాం శిష్యాణాం మనాంసి సుస్థిరాణి కృత్వా క్రమశో గలాతియాఫ్రుగియాదేశయో ర్భ్రమిత్వా గతవాన్|</para>
  <para style="p">
    <verse number="24" style="v"/>తస్మిన్నేవ సమయే సికన్దరియానగరే జాత ఆపల్లోనామా శాస్త్రవిత్ సువక్తా యిహూదీయ ఏకో జన ఇఫిషనగరమ్ ఆగతవాన్|</para>
  <para style="p">
    <verse number="25" style="v"/>స శిక్షితప్రభుమార్గో మనసోద్యోగీ చ సన్ యోహనో మజ్జనమాత్రం జ్ఞాత్వా యథార్థతయా ప్రభోః కథాం కథయన్ సముపాదిశత్|</para>
  <para style="p">
    <verse number="26" style="v"/>ఏష జనో నిర్భయత్వేన భజనభవనే కథయితుమ్ ఆరబ్ధవాన్, తతః ప్రిస్కిల్లాక్కిలౌ తస్యోపదేశకథాం నిశమ్య తం స్వయోః సమీపమ్ ఆనీయ శుద్ధరూపేణేశ్వరస్య కథామ్ అబోధయతామ్|</para>
  <para style="p">
    <verse number="27" style="v"/>పశ్చాత్ స ఆఖాయాదేశం గన్తుం మతిం కృతవాన్, తదా తత్రత్యః శిష్యగణో యథా తం గృహ్లాతి తదర్థం భ్రాతృగణేన సమాశ్వస్య పత్రే లిఖితే సతి, ఆపల్లాస్తత్రోపస్థితః సన్ అనుగ్రహేణ ప్రత్యయినాం బహూపకారాన్ అకరోత్,</para>
  <para style="p">
    <verse number="28" style="v"/>ఫలతో యీశురభిషిక్తస్త్రాతేతి శాస్త్రప్రమాణం దత్వా ప్రకాశరూపేణ ప్రతిపన్నం కృత్వా యిహూదీయాన్ నిరుత్తరాన్ కృతవాన్|</para>
  <chapter number="19" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>కరిన్థనగర ఆపల్లసః స్థితికాలే పౌల ఉత్తరప్రదేశైరాగచ్ఛన్ ఇఫిషనగరమ్ ఉపస్థితవాన్| తత్ర కతిపయశిష్యాన్ సాక్షత్ ప్రాప్య తాన్ అపృచ్ఛత్,</para>
  <para style="p">
    <verse number="2" style="v"/>యూయం విశ్వస్య పవిత్రమాత్మానం ప్రాప్తా న వా? తతస్తే ప్రత్యవదన్ పవిత్ర ఆత్మా దీయతే ఇత్యస్మాభిః శ్రుతమపి నహి|</para>
  <para style="p">
    <verse number="3" style="v"/>తదా సాఽవదత్ తర్హి యూయం కేన మజ్జితా అభవత? తేఽకథయన్ యోహనో మజ్జనేన|</para>
  <para style="p">
    <verse number="4" style="v"/>తదా పౌల ఉక్తవాన్ ఇతః పరం య ఉపస్థాస్యతి తస్మిన్ అర్థత యీశుఖ్రీష్టే విశ్వసితవ్యమిత్యుక్త్వా యోహన్ మనఃపరివర్త్తనసూచకేన మజ్జనేన జలే లోకాన్ అమజ్జయత్|</para>
  <para style="p">
    <verse number="5" style="v"/>తాదృశీం కథాం శ్రుత్వా తే ప్రభో ర్యీశుఖ్రీష్టస్య నామ్నా మజ్జితా అభవన్|</para>
  <para style="p">
    <verse number="6" style="v"/>తతః పౌలేన తేషాం గాత్రేషు కరేఽర్పితే తేషాముపరి పవిత్ర ఆత్మావరూఢవాన్, తస్మాత్ తే నానాదేశీయా భాషా భవిష్యత్కథాశ్చ కథితవన్తః|</para>
  <para style="p">
    <verse number="7" style="v"/>తే ప్రాయేణ ద్వాదశజనా ఆసన్|</para>
  <para style="p">
    <verse number="8" style="v"/>పౌలో భజనభవనం గత్వా ప్రాయేణ మాసత్రయమ్ ఈశ్వరస్య రాజ్యస్య విచారం కృత్వా లోకాన్ ప్రవర్త్య సాహసేన కథామకథయత్|</para>
  <para style="p">
    <verse number="9" style="v"/>కిన్తు కఠినాన్తఃకరణత్వాత్ కియన్తో జనా న విశ్వస్య సర్వ్వేషాం సమక్షమ్ ఏతత్పథస్య నిన్దాం కర్త్తుం ప్రవృత్తాః, అతః పౌలస్తేషాం సమీపాత్ ప్రస్థాయ శిష్యగణం పృథక్కృత్వా ప్రత్యహం తురాన్ననామ్నః కస్యచిత్ జనస్య పాఠశాలాయాం విచారం కృతవాన్|</para>
  <para style="p">
    <verse number="10" style="v"/>ఇత్థం వత్సరద్వయం గతం తస్మాద్ ఆశియాదేశనివాసినః సర్వ్వే యిహూదీయా అన్యదేశీయలోకాశ్చ ప్రభో ర్యీశోః కథామ్ అశ్రౌషన్|</para>
  <para style="p">
    <verse number="11" style="v"/>పౌలేన చ ఈశ్వర ఏతాదృశాన్యద్భుతాని కర్మ్మాణి కృతవాన్</para>
  <para style="p">
    <verse number="12" style="v"/>యత్ పరిధేయే గాత్రమార్జనవస్త్రే వా తస్య దేహాత్ పీడితలోకానామ్ సమీపమ్ ఆనీతే తే నిరామయా జాతా అపవిత్రా భూతాశ్చ తేభ్యో బహిర్గతవన్తః|</para>
  <para style="p">
    <verse number="13" style="v"/>తదా దేశాటనకారిణః కియన్తో యిహూదీయా భూతాపసారిణో భూతగ్రస్తనోకానాం సన్నిధౌ ప్రభే ర్యీశో ర్నామ జప్త్వా వాక్యమిదమ్ అవదన్, యస్య కథాం పౌలః ప్రచారయతి తస్య యీశో ర్నామ్నా యుష్మాన్ ఆజ్ఞాపయామః|</para>
  <para style="p">
    <verse number="14" style="v"/>స్కివనామ్నో యిహూదీయానాం ప్రధానయాజకస్య సప్తభిః పుత్తైస్తథా కృతే సతి</para>
  <para style="p">
    <verse number="15" style="v"/>కశ్చిద్ అపవిత్రో భూతః ప్రత్యుదితవాన్, యీశుం జానామి పౌలఞ్చ పరిచినోమి కిన్తు కే యూయం?</para>
  <para style="p">
    <verse number="16" style="v"/>ఇత్యుక్త్వా సోపవిత్రభూతగ్రస్తో మనుష్యో లమ్ఫం కృత్వా తేషాముపరి పతిత్వా బలేన తాన్ జితవాన్, తస్మాత్తే నగ్నాః క్షతాఙ్గాశ్చ సన్తస్తస్మాద్ గేహాత్ పలాయన్త|</para>
  <para style="p">
    <verse number="17" style="v"/>సా వాగ్ ఇఫిషనగరనివాసినసం సర్వ్వేషాం యిహూదీయానాం భిన్నదేశీయానాం లోకానాఞ్చ శ్రవోగోచరీభూతా; తతః సర్వ్వే భయం గతాః ప్రభో ర్యీశో ర్నామ్నో యశో ఽవర్ద్ధత|</para>
  <para style="p">
    <verse number="18" style="v"/>యేషామనేకేషాం లోకానాం ప్రతీతిరజాయత త ఆగత్య స్వైః కృతాః క్రియాః ప్రకాశరూపేణాఙ్గీకృతవన్తః|</para>
  <para style="p">
    <verse number="19" style="v"/>బహవో మాయాకర్మ్మకారిణః స్వస్వగ్రన్థాన్ ఆనీయ రాశీకృత్య సర్వ్వేషాం సమక్షమ్ అదాహయన్, తతో గణనాం కృత్వాబుధ్యన్త పఞ్చాయుతరూప్యముద్రామూల్యపుస్తకాని దగ్ధాని|</para>
  <para style="p">
    <verse number="20" style="v"/>ఇత్థం ప్రభోః కథా సర్వ్వదేశం వ్యాప్య ప్రబలా జాతా|</para>
  <para style="p">
    <verse number="21" style="v"/>సర్వ్వేష్వేతేషు కర్మ్మసు సమ్పన్నేషు సత్సు పౌలో మాకిదనియాఖాయాదేశాభ్యాం యిరూశాలమం గన్తుం మతిం కృత్వా కథితవాన్ తత్స్థానం యాత్రాయాం కృతాయాం సత్యాం మయా రోమానగరం ద్రష్టవ్యం|</para>
  <para style="p">
    <verse number="22" style="v"/>స్వానుగతలోకానాం తీమథియేరాస్తౌ ద్వౌ జనౌ మాకిదనియాదేశం ప్రతి ప్రహిత్య స్వయమ్ ఆశియాదేశే కతిపయదినాని స్థితవాన్|</para>
  <para style="p">
    <verse number="23" style="v"/>కిన్తు తస్మిన్ సమయే మతేఽస్మిన్ కలహో జాతః|</para>
  <para style="p">
    <verse number="24" style="v"/>తత్కారణమిదం, అర్త్తిమీదేవ్యా రూప్యమన్దిరనిర్మ్మాణేన సర్వ్వేషాం శిల్పినాం యథేష్టలాభమ్ అజనయత్ యో దీమీత్రియనామా నాడీన్ధమః</para>
  <para style="p">
    <verse number="25" style="v"/>స తాన్ తత్కర్మ్మజీవినః సర్వ్వలోకాంశ్చ సమాహూయ భాషితవాన్ హే మహేచ్ఛా ఏతేన మన్దిరనిర్మ్మాణేనాస్మాకం జీవికా భవతి, ఏతద్ యూయం విత్థ;</para>
  <para style="p">
    <verse number="26" style="v"/>కిన్తు హస్తనిర్మ్మితేశ్వరా ఈశ్వరా నహి పౌలనామ్నా కేనచిజ్జనేన కథామిమాం వ్యాహృత్య కేవలేఫిషనగరే నహి ప్రాయేణ సర్వ్వస్మిన్ ఆశియాదేశే ప్రవృత్తిం గ్రాహయిత్వా బహులోకానాం శేముషీ పరావర్త్తితా, ఏతద్ యుష్మాభి ర్దృశ్యతే శ్రూయతే చ|</para>
  <para style="p">
    <verse number="27" style="v"/>తేనాస్మాకం వాణిజ్యస్య సర్వ్వథా హానేః సమ్భవనం కేవలమితి నహి, ఆశియాదేశస్థై ర్వా సర్వ్వజగత్స్థై ర్లోకైః పూజ్యా యార్తిమీ మహాదేవీ తస్యా మన్దిరస్యావజ్ఞానస్య తస్యా ఐశ్వర్య్యస్య నాశస్య చ సమ్భావనా విద్యతేे|</para>
  <para style="p">
    <verse number="28" style="v"/>ఏతాదృశీం కథాం శ్రుత్వా తే మహాక్రోధాన్వితాః సన్త ఉచ్చైఃకారం కథితవన్త ఇఫిషీయానామ్ అర్త్తిమీ దేవీ మహతీ భవతి|</para>
  <para style="p">
    <verse number="29" style="v"/>తతః సర్వ్వనగరం కలహేన పరిపూర్ణమభవత్, తతః పరం తే మాకిదనీయగాయారిస్తార్ఖనామానౌ పౌలస్య ద్వౌ సహచరౌ ధృత్వైకచిత్తా రఙ్గభూమిం జవేన ధావితవన్తః|</para>
  <para style="p">
    <verse number="30" style="v"/>తతః పౌలో లోకానాం సన్నిధిం యాతుమ్ ఉద్యతవాన్ కిన్తు శిష్యగణస్తం వారితవాన్|</para>
  <para style="p">
    <verse number="31" style="v"/>పౌలస్యత్మీయా ఆశియాదేశస్థాః కతిపయాః ప్రధానలోకాస్తస్య సమీపం నరమేకం ప్రేష్య త్వం రఙ్గభూమిం మాగా ఇతి న్యవేదయన్|</para>
  <para style="p">
    <verse number="32" style="v"/>తతో నానాలోకానాం నానాకథాకథనాత్ సభా వ్యాకులా జాతా కిం కారణాద్ ఏతావతీ జనతాభవత్ ఏతద్ అధికై ర్లోకై ర్నాజ్ఞాయి|</para>
  <para style="p">
    <verse number="33" style="v"/>తతః పరం జనతామధ్యాద్ యిహూదీయైర్బహిష్కృతః సికన్దరో హస్తేన సఙ్కేతం కృత్వా లోకేభ్య ఉత్తరం దాతుముద్యతవాన్,</para>
  <para style="p">
    <verse number="34" style="v"/>కిన్తు స యిహూదీయలోక ఇతి నిశ్చితే సతి ఇఫిషీయానామ్ అర్త్తిమీ దేవీ మహతీతి వాక్యం ప్రాయేణ పఞ్చ దణ్డాన్ యావద్ ఏకస్వరేణ లోకనివహైః ప్రోక్తం|</para>
  <para style="p">
    <verse number="35" style="v"/>తతో నగరాధిపతిస్తాన్ స్థిరాన్ కృత్వా కథితవాన్ హే ఇఫిషాయాః సర్వ్వే లోకా ఆకర్ణయత, అర్తిమీమహాదేవ్యా మహాదేవాత్ పతితాయాస్తత్ప్రతిమాయాశ్చ పూజనమ ఇఫిషనగరస్థాః సర్వ్వే లోకాః కుర్వ్వన్తి, ఏతత్ కే న జానన్తి?</para>
  <para style="p">
    <verse number="36" style="v"/>తస్మాద్ ఏతత్ప్రతికూలం కేపి కథయితుం న శక్నువన్తి, ఇతి జ్ఞాత్వా యుష్మాభిః సుస్థిరత్వేన స్థాతవ్యమ్ అవివిచ్య కిమపి కర్మ్మ న కర్త్తవ్యఞ్చ|</para>
  <para style="p">
    <verse number="37" style="v"/>యాన్ ఏతాన్ మనుష్యాన్ యూయమత్ర సమానయత తే మన్దిరద్రవ్యాపహారకా యుష్మాకం దేవ్యా నిన్దకాశ్చ న భవన్తి|</para>
  <para style="p">
    <verse number="38" style="v"/>యది కఞ్చన ప్రతి దీమీత్రియస్య తస్య సహాయానాఞ్చ కాచిద్ ఆపత్తి ర్విద్యతే తర్హి ప్రతినిధిలోకా విచారస్థానఞ్చ సన్తి, తే తత్ స్థానం గత్వా ఉత్తరప్రత్యుత్తరే కుర్వ్వన్తు|</para>
  <para style="p">
    <verse number="39" style="v"/>కిన్తు యుష్మాకం కాచిదపరా కథా యది తిష్ఠతి తర్హి నియమితాయాం సభాయాం తస్యా నిష్పత్తి ర్భవిష్యతి|</para>
  <para style="p">
    <verse number="40" style="v"/>కిన్త్వేతస్య విరోధస్యోత్తరం యేన దాతుం శక్నుమ్ ఏతాదృశస్య కస్యచిత్ కారణస్యాభావాద్ అద్యతనఘటనాహేతో రాజద్రోహిణామివాస్మాకమ్ అభియోగో భవిష్యతీతి శఙ్కా విద్యతే|</para>
  <para style="p">
    <verse number="41" style="v"/>ఇతి కథయిత్వా స సభాస్థలోకాన్ విసృష్టవాన్|</para>
  <chapter number="20" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ఇత్థం కలహే నివృత్తే సతి పౌలః శిష్యగణమ్ ఆహూయ విసర్జనం ప్రాప్య మాకిదనియాదేశం ప్రస్థితవాన్|</para>
  <para style="p">
    <verse number="2" style="v"/>తేన స్థానేన గచ్ఛన్ తద్దేశీయాన్ శిష్యాన్ బహూపదిశ్య యూనానీయదేశమ్ ఉపస్థితవాన్|</para>
  <para style="p">
    <verse number="3" style="v"/>తత్ర మాసత్రయం స్థిత్వా తస్మాత్ సురియాదేశం యాతుమ్ ఉద్యతః, కిన్తు యిహూదీయాస్తం హన్తుం గుప్తా అతిష్ఠన్ తస్మాత్ స పునరపి మాకిదనియామార్గేణ ప్రత్యాగన్తుం మతిం కృతవాన్|</para>
  <para style="p">
    <verse number="4" style="v"/>బిరయానగరీయసోపాత్రః థిషలనీకీయారిస్తార్ఖసికున్దౌ దర్బ్బోనగరీయగాయతీమథియౌ ఆశియాదేశీయతుఖికత్రఫిమౌ చ తేన సార్ద్ధం ఆశియాదేశం యావద్ గతవన్తః|</para>
  <para style="p">
    <verse number="5" style="v"/>ఏతే సర్వ్వే ఽగ్రసరాః సన్తో ఽస్మాన్ అపేక్ష్య త్రోయానగరే స్థితవన్తః|</para>
  <para style="p">
    <verse number="6" style="v"/>కిణ్వశూన్యపూపోత్సవదినే చ గతే సతి వయం ఫిలిపీనగరాత్ తోయపథేన గత్వా పఞ్చభి ర్దినైస్త్రోయానగరమ్ ఉపస్థాయ తత్ర సప్తదినాన్యవాతిష్ఠామ|</para>
  <para style="p">
    <verse number="7" style="v"/>సప్తాహస్య ప్రథమదినే పూపాన్ భంక్తు శిష్యేషు మిలితేషు పౌలః పరదినే తస్మాత్ ప్రస్థాతుమ్ ఉద్యతః సన్ తదహ్ని ప్రాయేణ క్షపాయా యామద్వయం యావత్ శిష్యేభ్యో ధర్మ్మకథామ్ అకథయత్|</para>
  <para style="p">
    <verse number="8" style="v"/>ఉపరిస్థే యస్మిన్ ప్రకోష్ఠే సభాం కృత్వాసన్ తత్ర బహవః ప్రదీపాః ప్రాజ్వలన్|</para>
  <para style="p">
    <verse number="9" style="v"/>ఉతుఖనామా కశ్చన యువా చ వాతాయన ఉపవిశన్ ఘోరతరనిద్రాగ్రస్తో ఽభూత్ తదా పౌలేన బహుక్షణం కథాయాం ప్రచారితాయాం నిద్రామగ్నః స తస్మాద్ ఉపరిస్థతృతీయప్రకోష్ఠాద్ అపతత్, తతో లోకాస్తం మృతకల్పం ధృత్వోదతోలయన్|</para>
  <para style="p">
    <verse number="10" style="v"/>తతః పౌలోఽవరుహ్య తస్య గాత్రే పతిత్వా తం క్రోడే నిధాయ కథితవాన్, యూయం వ్యాకులా మా భూత నాయం ప్రాణై ర్వియుక్తః|</para>
  <para style="p">
    <verse number="11" style="v"/>పశ్చాత్ స పునశ్చోపరి గత్వా పూపాన్ భంక్త్వా ప్రభాతం యావత్ కథోపకథనే కృత్వా ప్రస్థితవాన్|</para>
  <para style="p">
    <verse number="12" style="v"/>తే చ తం జీవన్తం యువానం గృహీత్వా గత్వా పరమాప్యాయితా జాతాః|</para>
  <para style="p">
    <verse number="13" style="v"/>అనన్తరం వయం పోతేనాగ్రసరా భూత్వాస్మనగరమ్ ఉత్తీర్య్య పౌలం గ్రహీతుం మతిమ్ అకుర్మ్మ యతః స తత్ర పద్భ్యాం వ్రజితుం మతిం కృత్వేతి నిరూపితవాన్|</para>
  <para style="p">
    <verse number="14" style="v"/>తస్మాత్ తత్రాస్మాభిః సార్ద్ధం తస్మిన్ మిలితే సతి వయం తం నీత్వా మితులీన్యుపద్వీపం ప్రాప్తవన్తః|</para>
  <para style="p">
    <verse number="15" style="v"/>తస్మాత్ పోతం మోచయిత్వా పరేఽహని ఖీయోపద్వీపస్య సమ్ముఖం లబ్ధవన్తస్తస్మాద్ ఏకేనాహ్నా సామోపద్వీపం గత్వా పోతం లాగయిత్వా త్రోగుల్లియే స్థిత్వా పరస్మిన్ దివసేे మిలీతనగరమ్ ఉపాతిష్ఠామ|</para>
  <para style="p">
    <verse number="16" style="v"/>యతః పౌల ఆశియాదేశే కాలం యాపయితుమ్ నాభిలషన్ ఇఫిషనగరం త్యక్త్వా యాతుం మన్త్రణాం స్థిరీకృతవాన్; యస్మాద్ యది సాధ్యం భవతి తర్హి నిస్తారోత్సవస్య పఞ్చాశత్తమదినే స యిరూశాలమ్యుపస్థాతుం మతిం కృతవాన్|</para>
  <para style="p">
    <verse number="17" style="v"/>పౌలో మిలీతాద్ ఇఫిషం ప్రతి లోకం ప్రహిత్య సమాజస్య ప్రాచీనాన్ ఆహూయానీతవాన్|</para>
  <para style="p">
    <verse number="18" style="v"/>తేషు తస్య సమీపమ్ ఉపస్థితేషు స తేభ్య ఇమాం కథాం కథితవాన్, అహమ్ ఆశియాదేశే ప్రథమాగమనమ్ ఆరభ్యాద్య యావద్ యుష్మాకం సన్నిధౌ స్థిత్వా సర్వ్వసమయే యథాచరితవాన్ తద్ యూయం జానీథ;</para>
  <para style="p">
    <verse number="19" style="v"/>ఫలతః సర్వ్వథా నమ్రమనాః సన్ బహుశ్రుపాతేన యిహుదీయానామ్ కుమన్త్రణాజాతనానాపరీక్షాభిః ప్రభోః సేవామకరవం|</para>
  <para style="p">
    <verse number="20" style="v"/>కామపి హితకథాाం న గోపాయితవాన్ తాం ప్రచార్య్య సప్రకాశం గృహే గృహే సముపదిశ్యేశ్వరం ప్రతి మనః పరావర్త్తనీయం ప్రభౌ యీశుఖ్రీష్టే విశ్వసనీయం</para>
  <para style="p">
    <verse number="21" style="v"/>యిహూదీయానామ్ అన్యదేశీయలోకానాఞ్చ సమీప ఏతాదృశం సాక్ష్యం దదామి|</para>
  <para style="p">
    <verse number="22" style="v"/>పశ్యత సామ్ప్రతమ్ ఆత్మనాకృష్టః సన్ యిరూశాలమ్నగరే యాత్రాం కరోమి, తత్ర మామ్ప్రతి యద్యద్ ఘటిష్యతే తాన్యహం న జానామి;</para>
  <para style="p">
    <verse number="23" style="v"/>కిన్తు మయా బన్ధనం క్లేశశ్చ భోక్తవ్య ఇతి పవిత్ర ఆత్మా నగరే నగరే ప్రమాణం దదాతి|</para>
  <para style="p">
    <verse number="24" style="v"/>తథాపి తం క్లేశమహం తృణాయ న మన్యే; ఈశ్వరస్యానుగ్రహవిషయకస్య సుసంవాదస్య ప్రమాణం దాతుం, ప్రభో ర్యీశోః సకాశాద యస్యాః సేవాయాః భారం ప్రాప్నవం తాం సేవాం సాధయితుం సానన్దం స్వమార్గం సమాపయితుुఞ్చ నిజప్రాణానపి ప్రియాన్ న మన్యే|</para>
  <para style="p">
    <verse number="25" style="v"/>అధునా పశ్యత యేషాం సమీపేఽహమ్ ఈశ్వరీయరాజ్యస్య సుసంవాదం ప్రచార్య్య భ్రమణం కృతవాన్ ఏతాదృశా యూయం మమ వదనం పున ర్ద్రష్టుం న ప్రాప్స్యథ ఏతదప్యహం జానామి|</para>
  <para style="p">
    <verse number="26" style="v"/>యుష్మభ్యమ్ అహమ్ ఈశ్వరస్య సర్వ్వాన్ ఆదేశాన్ ప్రకాశయితుం న న్యవర్త్తే|</para>
  <para style="p">
    <verse number="27" style="v"/>అహం సర్వ్వేషాం లోకానాం రక్తపాతదోషాద్ యన్నిర్దోష ఆసే తస్యాద్య యుష్మాన్ సాక్షిణః కరోమి|</para>
  <para style="p">
    <verse number="28" style="v"/>యూయం స్వేషు తథా యస్య వ్రజస్యాధ్యక్షన్ ఆత్మా యుష్మాన్ విధాయ న్యయుఙ్క్త తత్సర్వ్వస్మిన్ సావధానా భవత, య సమాజఞ్చ ప్రభు ర్నిజరక్తమూల్యేన క్రీతవాన తమ్ అవత,</para>
  <para style="p">
    <verse number="29" style="v"/>యతో మయా గమనే కృతఏవ దుర్జయా వృకా యుష్మాకం మధ్యం ప్రవిశ్య వ్రజం ప్రతి నిర్దయతామ్ ఆచరిష్యన్తి,</para>
  <para style="p">
    <verse number="30" style="v"/>యుష్మాకమేవ మధ్యాదపి లోకా ఉత్థాయ శిష్యగణమ్ అపహన్తుం విపరీతమ్ ఉపదేక్ష్యన్తీత్యహం జానామి|</para>
  <para style="p">
    <verse number="31" style="v"/>ఇతి హేతో ర్యూయం సచైతన్యాః సన్తస్తిష్టత, అహఞ్చ సాశ్రుపాతః సన్ వత్సరత్రయం యావద్ దివానిశం ప్రతిజనం బోధయితుం న న్యవర్త్తే తదపి స్మరత|</para>
  <para style="p">
    <verse number="32" style="v"/>ఇదానీం హే భ్రాతరో యుష్మాకం నిష్ఠాం జనయితుం పవిత్రీకృతలోకానాం మధ్యేఽధికారఞ్చ దాతుం సమర్థో య ఈశ్వరస్తస్యానుగ్రహస్య యో వాదశ్చ తయోరుభయో ర్యుష్మాన్ సమార్పయమ్|</para>
  <para style="p">
    <verse number="33" style="v"/>కస్యాపి స్వర్ణం రూప్యం వస్త్రం వా ప్రతి మయా లోభో న కృతః|</para>
  <para style="p">
    <verse number="34" style="v"/>కిన్తు మమ మత్సహచరలోకానాఞ్చావశ్యకవ్యయాయ మదీయమిదం కరద్వయమ్ అశ్రామ్యద్ ఏతద్ యూయం జానీథ|</para>
  <para style="p">
    <verse number="35" style="v"/>అనేన ప్రకారేణ గ్రహణద్ దానం భద్రమితి యద్వాక్యం ప్రభు ర్యీశుః కథితవాన్ తత్ స్మర్త్తుం దరిద్రలోకానాముపకారార్థం శ్రమం కర్త్తుఞ్చ యుష్మాకమ్ ఉచితమ్ ఏతత్సర్వ్వం యుష్మానహమ్ ఉపదిష్టవాన్|</para>
  <para style="p">
    <verse number="36" style="v"/>ఏతాం కథాం కథయిత్వా స జానునీ పాతయిత్వా సర్వైః సహ ప్రార్థయత|</para>
  <para style="p">
    <verse number="37" style="v"/>తేన తే క్రన్ద్రన్తః</para>
  <para style="p">
    <verse number="38" style="v"/>పున ర్మమ ముఖం న ద్రక్ష్యథ విశేషత ఏషా యా కథా తేనాకథి తత్కారణాత్ శోకం విలాపఞ్చ కృత్వా కణ్ఠం ధృత్వా చుమ్బితవన్తః| పశ్చాత్ తే తం పోతం నీతవన్తః|</para>
  <chapter number="21" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>తై ర్విసృష్టాః సన్తో వయం పోతం బాహయిత్వా ఋజుమార్గేణ కోషమ్ ఉపద్వీపమ్ ఆగత్య పరేఽహని రోదియోపద్వీపమ్ ఆగచ్ఛామ తతస్తస్మాత్ పాతారాయామ్ ఉపాతిష్ఠామ|</para>
  <para style="p">
    <verse number="2" style="v"/>తత్ర ఫైనీకియాదేశగామినమ్ పోతమేకం ప్రాప్య తమారుహ్య గతవన్తః|</para>
  <para style="p">
    <verse number="3" style="v"/>కుప్రోపద్వీపం దృష్ట్వా తం సవ్యదిశి స్థాపయిత్వా సురియాదేశం గత్వా పోతస్థద్రవ్యాణ్యవరోహయితుం సోరనగరే లాగితవన్తః|</para>
  <para style="p">
    <verse number="4" style="v"/>తత్ర శిష్యగణస్య సాక్షాత్కరణాయ వయం తత్ర సప్తదినాని స్థితవన్తః పశ్చాత్తే పవిత్రేణాత్మనా పౌలం వ్యాహరన్ త్వం యిరూశాలమ్నగరం మా గమః|</para>
  <para style="p">
    <verse number="5" style="v"/>తతస్తేషు సప్తసు దినేషు యాపితేషు సత్సు వయం తస్మాత్ స్థానాత్ నిజవర్త్మనా గతవన్తః, తస్మాత్ తే సబాలవృద్ధవనితా అస్మాభిః సహ నగరస్య పరిసరపర్య్యన్తమ్ ఆగతాః పశ్చాద్వయం జలధితటే జానుపాతం ప్రార్థయామహి|</para>
  <para style="p">
    <verse number="6" style="v"/>తతః పరస్పరం విసృష్టాః సన్తో వయం పోతం గతాస్తే తు స్వస్వగృహం ప్రత్యాగతవన్తః|</para>
  <para style="p">
    <verse number="7" style="v"/>వయం సోరనగరాత్ నావా ప్రస్థాయ తలిమాయినగరమ్ ఉపాతిష్ఠామ తత్రాస్మాకం సముద్రీయమార్గస్యాన్తోఽభవత్ తత్ర భ్రాతృగణం నమస్కృత్య దినమేకం తైః సార్ద్ధమ్ ఉషతవన్తః|</para>
  <para style="p">
    <verse number="8" style="v"/>పరే ఽహని పౌలస్తస్య సఙ్గినో వయఞ్చ ప్రతిష్ఠమానాః కైసరియానగరమ్ ఆగత్య సుసంవాదప్రచారకానాం సప్తజనానాం ఫిలిపనామ్న ఏకస్య గృహం ప్రవిశ్యావతిష్ఠామ|</para>
  <para style="p">
    <verse number="9" style="v"/>తస్య చతస్రో దుహితరోఽనూఢా భవిష్యద్వాదిన్య ఆసన్|</para>
  <para style="p">
    <verse number="10" style="v"/>తత్రాస్మాసు బహుదినాని ప్రోషితేషు యిహూదీయదేశాద్ ఆగత్యాగాబనామా భవిష్యద్వాదీ సముపస్థితవాన్|</para>
  <para style="p">
    <verse number="11" style="v"/>సోస్మాకం సమీపమేత్య పౌలస్య కటిబన్ధనం గృహీత్వా నిజహస్తాపాదాన్ బద్ధ్వా భాషితవాన్ యస్యేదం కటిబన్ధనం తం యిహూదీయలోకా యిరూశాలమనగర ఇత్థం బద్ధ్వా భిన్నదేశీయానాం కరేషు సమర్పయిష్యన్తీతి వాక్యం పవిత్ర ఆత్మా కథయతి|</para>
  <para style="p">
    <verse number="12" style="v"/>ఏతాదృశీం కథాం శ్రుత్వా వయం తన్నగరవాసినో భ్రాతరశ్చ యిరూశాలమం న యాతుం పౌలం వ్యనయామహి;</para>
  <para style="p">
    <verse number="13" style="v"/>కిన్తు స ప్రత్యావాదీత్, యూయం కిం కురుథ? కిం క్రన్దనేన మమాన్తఃకరణం విదీర్ణం కరిష్యథ? ప్రభో ర్యీశో ర్నామ్నో నిమిత్తం యిరూశాలమి బద్ధో భవితుం కేవల తన్న ప్రాణాన్ దాతుమపి ససజ్జోస్మి|</para>
  <para style="p">
    <verse number="14" style="v"/>తేనాస్మాకం కథాయామ్ అగృహీతాయామ్ ఈశ్వరస్య యథేచ్ఛా తథైవ భవత్విత్యుక్త్వా వయం నిరస్యామ|</para>
  <para style="p">
    <verse number="15" style="v"/>పరేఽహని పాథేయద్రవ్యాణి గృహీత్వా యిరూశాలమం ప్రతి యాత్రామ్ అకుర్మ్మ|</para>
  <para style="p">
    <verse number="16" style="v"/>తతః కైసరియానగరనివాసినః కతిపయాః శిష్యా అస్మాభిః సార్ద్ధమ్ ఇత్వా కృప్రీయేన మ్నాసన్నామ్నా యేన ప్రాచీనశిష్యేన సార్ద్ధమ్ అస్మాభి ర్వస్తవ్యం తస్య సమీపమ్ అస్మాన్ నీతవన్తః|</para>
  <para style="p">
    <verse number="17" style="v"/>అస్మాసు యిరూశాలమ్యుపస్థితేషు తత్రస్థభ్రాతృగణోఽస్మాన్ ఆహ్లాదేన గృహీతవాన్|</para>
  <para style="p">
    <verse number="18" style="v"/>పరస్మిన్ దివసే పౌలేఽస్మాభిః సహ యాకూబో గృహం ప్రవిష్టే లోకప్రాచీనాః సర్వ్వే తత్ర పరిషది సంస్థితాః|</para>
  <para style="p">
    <verse number="19" style="v"/>అనన్తరం స తాన్ నత్వా స్వీయప్రచారణేన భిన్నదేశీయాన్ ప్రతీశ్వరో యాని కర్మ్మాణి సాధితవాన్ తదీయాం కథామ్ అనుక్రమాత్ కథితవాన్|</para>
  <para style="p">
    <verse number="20" style="v"/>ఇతి శ్రుత్వా తే ప్రభుం ధన్యం ప్రోచ్య వాక్యమిదమ్ అభాషన్త, హే భ్రాత ర్యిహూదీయానాం మధ్యే బహుసహస్రాణి లోకా విశ్వాసిన ఆసతే కిన్తు తే సర్వ్వే వ్యవస్థామతాచారిణ ఏతత్ ప్రత్యక్షం పశ్యసి|</para>
  <para style="p">
    <verse number="21" style="v"/>శిశూనాం త్వక్ఛేదనాద్యాచరణం ప్రతిషిధ్య త్వం భిన్నదేశనివాసినో యిహూదీయలోకాన్ మూసావాక్యమ్ అశ్రద్ధాతుమ్ ఉపదిశసీతి తైః శ్రుతమస్తి|</para>
  <para style="p">
    <verse number="22" style="v"/>త్వమత్రాగతోసీతి వార్త్తాం సమాకర్ణ్య జననివహో మిలిత్వావశ్యమేవాగమిష్యతి; అతఏవ కిం కరణీయమ్? అత్ర వయం మన్త్రయిత్వా సముపాయం త్వాం వదామస్తం త్వమాచర|</para>
  <para style="p">
    <verse number="23" style="v"/>వ్రతం కర్త్తుం కృతసఙ్కల్పా యేఽస్మాంక చత్వారో మానవాః సన్తి</para>
  <para style="p">
    <verse number="24" style="v"/>తాన్ గృహీత్వా తైః సహితః స్వం శుచిం కురు తథా తేషాం శిరోముణ్డనే యో వ్యయో భవతి తం త్వం దేహి| తథా కృతే త్వదీయాచారే యా జనశ్రుతి ర్జాయతే సాలీకా కిన్తు త్వం విధిం పాలయన్ వ్యవస్థానుసారేణేవాచరసీతి తే భోత్సన్తే|</para>
  <para style="p">
    <verse number="25" style="v"/>భిన్నదేశీయానాం విశ్వాసిలోకానాం నికటే వయం పత్రం లిఖిత్వేత్థం స్థిరీకృతవన్తః, దేవప్రసాదభోజనం రక్తం గలపీడనమారితప్రాణిభోజనం వ్యభిచారశ్చైతేభ్యః స్వరక్షణవ్యతిరేకేణ తేషామన్యవిధిపాలనం కరణీయం న|</para>
  <para style="p">
    <verse number="26" style="v"/>తతః పౌలస్తాన్ మానుషానాదాయ పరస్మిన్ దివసే తైః సహ శుచి ర్భూత్వా మన్దిరం గత్వా శౌచకర్మ్మణో దినేషు సమ్పూర్ణేషు తేషామ్ ఏకైకార్థం నైవేద్యాద్యుత్సర్గో భవిష్యతీతి జ్ఞాపితవాన్|</para>
  <para style="p">
    <verse number="27" style="v"/>తేషు సప్తసు దినేషు సమాప్తకల్పేషు ఆశియాదేశనివాసినో యిహూదీయాస్తం మధ్యేమన్దిరం విలోక్య జననివహస్య మనఃసు కుప్రవృత్తిం జనయిత్వా తం ధృత్వా</para>
  <para style="p">
    <verse number="28" style="v"/>ప్రోచ్చైః ప్రావోచన్, హే ఇస్రాయేల్లోకాః సర్వ్వే సాహాయ్యం కురుత| యో మనుజ ఏతేషాం లోకానాం మూసావ్యవస్థాయా ఏతస్య స్థానస్యాపి విపరీతం సర్వ్వత్ర సర్వ్వాన్ శిక్షయతి స ఏషః; విశేషతః స భిన్నదేశీయలోకాన్ మన్దిరమ్ ఆనీయ పవిత్రస్థానమేతద్ అపవిత్రమకరోత్|</para>
  <para style="p">
    <verse number="29" style="v"/>పూర్వ్వం తే మధ్యేనగరమ్ ఇఫిషనగరీయం త్రఫిమం పౌలేన సహితం దృష్టవన్త ఏతస్మాత్ పౌలస్తం మన్దిరమధ్యమ్ ఆనయద్ ఇత్యన్వమిమత|</para>
  <para style="p">
    <verse number="30" style="v"/>అతఏవ సర్వ్వస్మిన్ నగరే కలహోత్పన్నత్వాత్ ధావన్తో లోకా ఆగత్య పౌలం ధృత్వా మన్దిరస్య బహిరాకృష్యానయన్ తత్క్షణాద్ ద్వారాణి సర్వ్వాణి చ రుద్ధాని|</para>
  <para style="p">
    <verse number="31" style="v"/>తేషు తం హన్తుముద్యతేेషు యిరూశాలమ్నగరే మహానుపద్రవో జాత ఇతి వార్త్తాయాం సహస్రసేనాపతేః కర్ణగోచరీభూతాయాం సత్యాం స తత్క్షణాత్ సైన్యాని సేనాపతిగణఞ్చ గృహీత్వా జవేనాగతవాన్|</para>
  <para style="p">
    <verse number="32" style="v"/>తతో లోకాః సేనాగణేన సహ సహస్రసేనాపతిమ్ ఆగచ్ఛన్తం దృష్ట్వా పౌలతాడనాతో న్యవర్త్తన్త|</para>
  <para style="p">
    <verse number="33" style="v"/>స సహస్రసేనాపతిః సన్నిధావాగమ్య పౌలం ధృత్వా శృఙ్ఖలద్వయేన బద్ధమ్ ఆదిశ్య తాన్ పృష్టవాన్ ఏష కః? కిం కర్మ్మ చాయం కృతవాన్?</para>
  <para style="p">
    <verse number="34" style="v"/>తతో జనసమూహస్య కశ్చిద్ ఏకప్రకారం కశ్చిద్ అన్యప్రకారం వాక్యమ్ అరౌత్ స తత్ర సత్యం జ్ఞాతుమ్ కలహకారణాద్ అశక్తః సన్ తం దుర్గం నేతుమ్ ఆజ్ఞాపయత్|</para>
  <para style="p">
    <verse number="35" style="v"/>తేషు సోపానస్యోపరి ప్రాప్తేషు లోకానాం సాహసకారణాత్ సేనాగణః పౌలముత్తోల్య నీతవాన్|</para>
  <para style="p">
    <verse number="36" style="v"/>తతః సర్వ్వే లోకాః పశ్చాద్గామినః సన్త ఏనం దురీకురుతేతి వాక్యమ్ ఉచ్చైరవదన్|</para>
  <para style="p">
    <verse number="37" style="v"/>పౌలస్య దుర్గానయనసమయే స తస్మై సహస్రసేనాపతయే కథితవాన్, భవతః పురస్తాత్ కథాం కథయితుం కిమ్ అనుమన్యతే? స తమపృచ్ఛత్ త్వం కిం యూనానీయాం భాషాం జానాసి?</para>
  <para style="p">
    <verse number="38" style="v"/>యో మిసరీయో జనః పూర్వ్వం విరోధం కృత్వా చత్వారి సహస్రాణి ఘాతకాన్ సఙ్గినః కృత్వా విపినం గతవాన్ త్వం కిం సఏవ న భవసి?</para>
  <para style="p">
    <verse number="39" style="v"/>తదా పౌలోఽకథయత్ అహం కిలికియాదేశస్య తార్షనగరీయో యిహూదీయో, నాహం సామాన్యనగరీయో మానవః; అతఏవ వినయేఽహం లాకానాం సమక్షం కథాం కథయితుం మామనుజానీష్వ|</para>
  <para style="p">
    <verse number="40" style="v"/>తేనానుజ్ఞాతః పౌలః సోపానోపరి తిష్ఠన్ హస్తేనేఙ్గితం కృతవాన్, తస్మాత్ సర్వ్వే సుస్థిరా అభవన్| తదా పౌల ఇబ్రీయభాషయా కథయితుమ్ ఆరభత,</para>
  <chapter number="22" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>హే పితృగణా హే భ్రాతృగణాః, ఇదానీం మమ నివేదనే సమవధత్త|</para>
  <para style="p">
    <verse number="2" style="v"/>తదా స ఇబ్రీయభాషయా కథాం కథయతీతి శ్రుత్వా సర్వ్వే లోకా అతీవ నిఃశబ్దా సన్తోఽతిష్ఠన్|</para>
  <para style="p">
    <verse number="3" style="v"/>పశ్చాత్ సోఽకథయద్ అహం యిహూదీయ ఇతి నిశ్చయః కిలికియాదేశస్య తార్షనగరం మమ జన్మభూమిః,ఏతన్నగరీయస్య గమిలీయేలనామ్నోఽధ్యాపకస్య శిష్యో భూత్వా పూర్వ్వపురుషాణాం విధివ్యవస్థానుసారేణ సమ్పూర్ణరూపేణ శిక్షితోఽభవమ్ ఇదానీన్తనా యూయం యాదృశా భవథ తాదృశోఽహమపీశ్వరసేవాయామ్ ఉద్యోగీ జాతః|</para>
  <para style="p">
    <verse number="4" style="v"/>మతమేతద్ ద్విష్ట్వా తద్గ్రాహినారీపురుషాన్ కారాయాం బద్ధ్వా తేషాం ప్రాణనాశపర్య్యన్తాం విపక్షతామ్ అకరవమ్|</para>
  <para style="p">
    <verse number="5" style="v"/>మహాయాజకః సభాసదః ప్రాచీనలోకాశ్చ మమైతస్యాః కథాయాః ప్రమాణం దాతుం శక్నువన్తి, యస్మాత్ తేషాం సమీపాద్ దమ్మేషకనగరనివాసిభ్రాతృగణార్థమ్ ఆజ్ఞాపత్రాణి గృహీత్వా యే తత్ర స్థితాస్తాన్ దణ్డయితుం యిరూశాలమమ్ ఆనయనార్థం దమ్మేషకనగరం గతోస్మి|</para>
  <para style="p">
    <verse number="6" style="v"/>కిన్తు గచ్ఛన్ తన్నగరస్య సమీపం ప్రాప్తవాన్ తదా ద్వితీయప్రహరవేలాయాం సత్యామ్ అకస్మాద్ గగణాన్నిర్గత్య మహతీ దీప్తి ర్మమ చతుర్దిశి ప్రకాశితవతీ|</para>
  <para style="p">
    <verse number="7" style="v"/>తతో మయి భూమౌै పతితే సతి, హే శౌల హే శౌల కుతో మాం తాడయసి? మామ్ప్రతి భాషిత ఏతాదృశ ఏకో రవోపి మయా శ్రుతః|</para>
  <para style="p">
    <verse number="8" style="v"/>తదాహం ప్రత్యవదం, హే ప్రభే కో భవాన్? తతః సోఽవాదీత్ యం త్వం తాడయసి స నాసరతీయో యీశురహం|</para>
  <para style="p">
    <verse number="9" style="v"/>మమ సఙ్గినో లోకాస్తాం దీప్తిం దృష్ట్వా భియం ప్రాప్తాః, కిన్తు మామ్ప్రత్యుదితం తద్వాక్యం తేे నాబుధ్యన్త|</para>
  <para style="p">
    <verse number="10" style="v"/>తతః పరం పృష్టవానహం, హే ప్రభో మయా కిం కర్త్తవ్యం? తతః ప్రభురకథయత్, ఉత్థాయ దమ్మేషకనగరం యాహి త్వయా యద్యత్ కర్త్తవ్యం నిరూపితమాస్తే తత్ తత్ర త్వం జ్ఞాపయిష్యసే|</para>
  <para style="p">
    <verse number="11" style="v"/>అనన్తరం తస్యాః ఖరతరదీప్తేః కారణాత్ కిమపి న దృష్ట్వా సఙ్గిగణేన ధృతహస్తః సన్ దమ్మేషకనగరం వ్రజితవాన్|</para>
  <para style="p">
    <verse number="12" style="v"/>తన్నగరనివాసినాం సర్వ్వేషాం యిహూదీయానాం మాన్యో వ్యవస్థానుసారేణ భక్తశ్చ హనానీయనామా మానవ ఏకో</para>
  <para style="p">
    <verse number="13" style="v"/>మమ సన్నిధిమ్ ఏత్య తిష్ఠన్ అకథయత్, హే భ్రాతః శౌల సుదృష్టి ర్భవ తస్మిన్ దణ్డేఽహం సమ్యక్ తం దృష్టవాన్|</para>
  <para style="p">
    <verse number="14" style="v"/>తతః స మహ్యం కథితవాన్ యథా త్వమ్ ఈశ్వరస్యాభిప్రాయం వేత్సి తస్య శుద్ధసత్త్వజనస్య దర్శనం ప్రాప్య తస్య శ్రీముఖస్య వాక్యం శృణోషి తన్నిమిత్తమ్ అస్మాకం పూర్వ్వపురుషాణామ్ ఈశ్వరస్త్వాం మనోనీతం కృతవానం|</para>
  <para style="p">
    <verse number="15" style="v"/>యతో యద్యద్ అద్రాక్షీరశ్రౌషీశ్చ సర్వ్వేషాం మానవానాం సమీపే త్వం తేషాం సాక్షీ భవిష్యసి|</para>
  <para style="p">
    <verse number="16" style="v"/>అతఏవ కుతో విలమ్బసే? ప్రభో ర్నామ్నా ప్రార్థ్య నిజపాపప్రక్షాలనార్థం మజ్జనాయ సముత్తిష్ఠ|</para>
  <para style="p">
    <verse number="17" style="v"/>తతః పరం యిరూశాలమ్నగరం ప్రత్యాగత్య మన్దిరేఽహమ్ ఏకదా ప్రార్థయే, తస్మిన్ సమయేఽహమ్ అభిభూతః సన్ ప్రభూం సాక్షాత్ పశ్యన్,</para>
  <para style="p">
    <verse number="18" style="v"/>త్వం త్వరయా యిరూశాలమః ప్రతిష్ఠస్వ యతో లోకామయి తవ సాక్ష్యం న గ్రహీష్యన్తి, మామ్ప్రత్యుదితం తస్యేదం వాక్యమ్ అశ్రౌషమ్|</para>
  <para style="p">
    <verse number="19" style="v"/>తతోహం ప్రత్యవాదిషమ్ హే ప్రభో ప్రతిభజనభవనం త్వయి విశ్వాసినో లోకాన్ బద్ధ్వా ప్రహృతవాన్,</para>
  <para style="p">
    <verse number="20" style="v"/>తథా తవ సాక్షిణః స్తిఫానస్య రక్తపాతనసమయే తస్య వినాశం సమ్మన్య సన్నిధౌ తిష్ఠన్ హన్తృలోకానాం వాసాంసి రక్షితవాన్, ఏతత్ తే విదుః|</para>
  <para style="p">
    <verse number="21" style="v"/>తతః సోఽకథయత్ ప్రతిష్ఠస్వ త్వాం దూరస్థభిన్నదేశీయానాం సమీపం ప్రేషయిష్యే|</para>
  <para style="p">
    <verse number="22" style="v"/>తదా లోకా ఏతావత్పర్య్యన్తాం తదీయాం కథాం శ్రుత్వా ప్రోచ్చైరకథయన్, ఏనం భూమణ్డలాద్ దూరీకురుత, ఏతాదృశజనస్య జీవనం నోచితమ్|</para>
  <para style="p">
    <verse number="23" style="v"/>ఇత్యుచ్చైః కథయిత్వా వసనాని పరిత్యజ్య గగణం ప్రతి ధూలీరక్షిపన్</para>
  <para style="p">
    <verse number="24" style="v"/>తతః సహస్రసేనాపతిః పౌలం దుర్గాభ్యన్తర నేతుం సమాదిశత్| ఏతస్య ప్రతికూలాః సన్తో లోకాః కిన్నిమిత్తమ్ ఏతావదుచ్చైఃస్వరమ్ అకుర్వ్వన్, ఏతద్ వేత్తుం తం కశయా ప్రహృత్య తస్య పరీక్షాం కర్త్తుమాదిశత్|</para>
  <para style="p">
    <verse number="25" style="v"/>పదాతయశ్చర్మ్మనిర్మ్మితరజ్జుభిస్తస్య బన్ధనం కర్త్తుముద్యతాస్తాస్తదానీం పౌలః సమ్ముఖస్థితం శతసేనాపతిమ్ ఉక్తవాన్ దణ్డాజ్ఞాయామ్ అప్రాప్తాయాం కిం రోమిలోకం ప్రహర్త్తుం యుష్మాకమ్ అధికారోస్తి?</para>
  <para style="p">
    <verse number="26" style="v"/>ఏనాం కథాం శ్రుత్వా స సహస్రసేనాపతేః సన్నిధిం గత్వా తాం వార్త్తామవదత్ స రోమిలోక ఏతస్మాత్ సావధానః సన్ కర్మ్మ కురు|</para>
  <para style="p">
    <verse number="27" style="v"/>తస్మాత్ సహస్రసేనాపతి ర్గత్వా తమప్రాక్షీత్ త్వం కిం రోమిలోకః? ఇతి మాం బ్రూహి| సోఽకథయత్ సత్యమ్|</para>
  <para style="p">
    <verse number="28" style="v"/>తతః సహస్రసేనాపతిః కథితవాన్ బహుద్రవిణం దత్త్వాహం తత్ పౌరసఖ్యం ప్రాప్తవాన్; కిన్తు పౌలః కథితవాన్ అహం జనునా తత్ ప్రాప్తోఽస్మి|</para>
  <para style="p">
    <verse number="29" style="v"/>ఇత్థం సతి యే ప్రహారేణ తం పరీక్షితుం సముద్యతా ఆసన్ తే తస్య సమీపాత్ ప్రాతిష్ఠన్త; సహస్రసేనాపతిస్తం రోమిలోకం విజ్ఞాయ స్వయం యత్ తస్య బన్ధనమ్ అకార్షీత్ తత్కారణాద్ అబిభేత్|</para>
  <para style="p">
    <verse number="30" style="v"/>యిహూదీయలోకాః పౌలం కుతోఽపవదన్తే తస్య వృత్తాన్తం జ్ఞాతుం వాఞ్ఛన్ సహస్రసేనాపతిః పరేఽహని పౌలం బన్ధనాత్ మోచయిత్వా ప్రధానయాజకాన్ మహాసభాయాః సర్వ్వలోకాశ్చ సముపస్థాతుమ్ ఆదిశ్య తేషాం సన్నిధౌ పౌలమ్ అవరోహ్య స్థాపితవాన్|</para>
  <chapter number="23" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>సభాసద్లోకాన్ ప్రతి పౌలోఽనన్యదృష్ట్యా పశ్యన్ అకథయత్, హే భ్రాతృగణా అద్య యావత్ సరలేన సర్వ్వాన్తఃకరణేనేశ్వరస్య సాక్షాద్ ఆచరామి|</para>
  <para style="p">
    <verse number="2" style="v"/>అనేన హనానీయనామా మహాయాజకస్తం కపోలే చపేటేనాహన్తుం సమీపస్థలోకాన్ ఆదిష్టవాన్|</para>
  <para style="p">
    <verse number="3" style="v"/>తదా పౌలస్తమవదత్, హే బహిష్పరిష్కృత, ఈశ్వరస్త్వాం ప్రహర్త్తుమ్ ఉద్యతోస్తి, యతో వ్యవస్థానుసారేణ విచారయితుమ్ ఉపవిశ్య వ్యవస్థాం లఙ్ఘిత్వా మాం ప్రహర్త్తుమ్ ఆజ్ఞాపయసి|</para>
  <para style="p">
    <verse number="4" style="v"/>తతో నికటస్థా లోకా అకథయన్, త్వం కిమ్ ఈశ్వరస్య మహాయాజకం నిన్దసి?</para>
  <para style="p">
    <verse number="5" style="v"/>తతః పౌలః ప్రతిభాషితవాన్ హే భ్రాతృగణ మహాయాజక ఏష ఇతి న బుద్ధం మయా తదన్యచ్చ స్వలోకానామ్ అధిపతిం ప్రతి దుర్వ్వాక్యం మా కథయ, ఏతాదృశీ లిపిరస్తి|</para>
  <para style="p">
    <verse number="6" style="v"/>అనన్తరం పౌలస్తేషామ్ అర్ద్ధం సిదూకిలోకా అర్ద్ధం ఫిరూశిలోకా ఇతి దృష్ట్వా ప్రోచ్చైః సభాస్థలోకాన్ అవదత్ హే భ్రాతృగణ అహం ఫిరూశిమతావలమ్బీ ఫిరూశినః సత్నానశ్చ, మృతలోకానామ్ ఉత్థానే ప్రత్యాశాకరణాద్ అహమపవాదితోస్మి|</para>
  <para style="p">
    <verse number="7" style="v"/>ఇతి కథాయాం కథితాయాం ఫిరూశిసిదూకినోః పరస్పరం భిన్నవాక్యత్వాత్ సభాయా మధ్యే ద్వౌ సంఘౌ జాతౌ|</para>
  <para style="p">
    <verse number="8" style="v"/>యతః సిదూకిలోకా ఉత్థానం స్వర్గీయదూతా ఆత్మానశ్చ సర్వ్వేషామ్ ఏతేషాం కమపి న మన్యన్తే, కిన్తు ఫిరూశినః సర్వ్వమ్ అఙ్గీకుర్వ్వన్తి|</para>
  <para style="p">
    <verse number="9" style="v"/>తతః పరస్పరమ్ అతిశయకోలాహలే సముపస్థితే ఫిరూశినాం పక్షీయాః సభాస్థా అధ్యాపకాః ప్రతిపక్షా ఉత్తిష్ఠన్తో ఽకథయన్, ఏతస్య మానవస్య కమపి దోషం న పశ్యామః; యది కశ్చిద్ ఆత్మా వా కశ్చిద్ దూత ఏనం ప్రత్యాదిశత్ తర్హి వయమ్ ఈశ్వరస్య ప్రాతికూల్యేన న యోత్స్యామః|</para>
  <para style="p">
    <verse number="10" style="v"/>తస్మాద్ అతీవ భిన్నవాక్యత్వే సతి తే పౌలం ఖణ్డం ఖణ్డం కరిష్యన్తీత్యాశఙ్కయా సహస్రసేనాపతిః సేనాగణం తత్స్థానం యాతుం సభాతో బలాత్ పౌలం ధృత్వా దుర్గం నేతఞ్చాజ్ఞాపయత్|</para>
  <para style="p">
    <verse number="11" style="v"/>రాత్రో ప్రభుస్తస్య సమీపే తిష్ఠన్ కథితవాన్ హే పౌల నిర్భయో భవ యథా యిరూశాలమ్నగరే మయి సాక్ష్యం దత్తవాన్ తథా రోమానగరేపి త్వయా దాతవ్యమ్|</para>
  <para style="p">
    <verse number="12" style="v"/>దినే సముపస్థితే సతి కియన్తో యిహూదీయలోకా ఏకమన్త్రణాః సన్తః పౌలం న హత్వా భోజనపానే కరిష్యామ ఇతి శపథేన స్వాన్ అబధ్నన్|</para>
  <para style="p">
    <verse number="13" style="v"/>చత్వారింశజ్జనేభ్యోఽధికా లోకా ఇతి పణమ్ అకుర్వ్వన్|</para>
  <para style="p">
    <verse number="14" style="v"/>తే మహాయాజకానాం ప్రాచీనలోకానాఞ్చ సమీపం గత్వా కథయన్, వయం పౌలం న హత్వా కిమపి న భోక్ష్యామహే దృఢేనానేన శపథేన బద్ధ్వా అభవామ|</para>
  <para style="p">
    <verse number="15" style="v"/>అతఏవ సామ్ప్రతం సభాసద్లోకైః సహ వయం తస్మిన్ కఞ్చిద్ విశేషవిచారం కరిష్యామస్తదర్థం భవాన్ శ్వో ఽస్మాకం సమీపం తమ్ ఆనయత్వితి సహస్రసేనాపతయే నివేదనం కురుత తేన యుష్మాకం సమీపం ఉపస్థితేః పూర్వ్వం వయం తం హన్తు సజ్జిష్యామ|</para>
  <para style="p">
    <verse number="16" style="v"/>తదా పౌలస్య భాగినేయస్తేషామితి మన్త్రణాం విజ్ఞాయ దుర్గం గత్వా తాం వార్త్తాం పౌలమ్ ఉక్తవాన్|</para>
  <para style="p">
    <verse number="17" style="v"/>తస్మాత్ పౌల ఏకం శతసేనాపతిమ్ ఆహూయ వాక్యమిదమ్ భాషితవాన్ సహస్రసేనాపతేః సమీపేఽస్య యువమనుష్యస్య కిఞ్చిన్నివేదనమ్ ఆస్తే, తస్మాత్ తత్సవిధమ్ ఏనం నయ|</para>
  <para style="p">
    <verse number="18" style="v"/>తతః స తమాదాయ సహస్రసేనాపతేః సమీపమ్ ఉపస్థాయ కథితవాన్, భవతః సమీపేఽస్య కిమపి నివేదనమాస్తే తస్మాత్ బన్దిః పౌలో మామాహూయ భవతః సమీపమ్ ఏనమ్ ఆనేతుం ప్రార్థితవాన్|</para>
  <para style="p">
    <verse number="19" style="v"/>తదా సహస్రసేనాపతిస్తస్య హస్తం ధృత్వా నిర్జనస్థానం నీత్వా పృష్ఠవాన్ తవ కిం నివేదనం? తత్ కథయ|</para>
  <para style="p">
    <verse number="20" style="v"/>తతః సోకథయత్, యిహూదీయలాకాః పౌలే కమపి విశేషవిచారం ఛలం కృత్వా తం సభాం నేతుం భవతః సమీపే నివేదయితుం అమన్త్రయన్|</para>
  <para style="p">
    <verse number="21" style="v"/>కిన్తు మవతా తన్న స్వీకర్త్తవ్యం యతస్తేషాం మధ్యేవర్త్తినశ్చత్వారింశజ్జనేభ్యో ఽధికలోకా ఏకమన్త్రణా భూత్వా పౌలం న హత్వా భోజనం పానఞ్చ న కరిష్యామ ఇతి శపథేన బద్ధాః సన్తో ఘాతకా ఇవ సజ్జితా ఇదానీం కేవలం భవతో ఽనుమతిమ్ అపేక్షన్తే|</para>
  <para style="p">
    <verse number="22" style="v"/>యామిమాం కథాం త్వం నివేదితవాన్ తాం కస్మైచిదపి మా కథయేత్యుక్త్వా సహస్రసేనాపతిస్తం యువానం విసృష్టవాన్|</para>
  <para style="p">
    <verse number="23" style="v"/>అనన్తరం సహస్రసేనాపతి ర్ద్వౌ శతసేనాపతీ ఆహూయేదమ్ ఆదిశత్, యువాం రాత్రౌ ప్రహరైకావశిష్టాయాం సత్యాం కైసరియానగరం యాతుం పదాతిసైన్యానాం ద్వే శతే ఘోటకారోహిసైన్యానాం సప్తతిం శక్తిధారిసైన్యానాం ద్వే శతే చ జనాన్ సజ్జితాన్ కురుతం|</para>
  <para style="p">
    <verse number="24" style="v"/>పౌలమ్ ఆరోహయితుం ఫీలిక్షాధిపతేః సమీపం నిర్వ్విఘ్నం నేతుఞ్చ వాహనాని సముపస్థాపయతం|</para>
  <para style="p">
    <verse number="25" style="v"/>అపరం స పత్రం లిఖిత్వా దత్తవాన్ తల్లిఖితమేతత్,</para>
  <para style="p">
    <verse number="26" style="v"/>మహామహిమశ్రీయుక్తఫీలిక్షాధిపతయే క్లౌదియలుషియస్య నమస్కారః|</para>
  <para style="p">
    <verse number="27" style="v"/>యిహూదీయలోకాః పూర్వ్వమ్ ఏనం మానవం ధృత్వా స్వహస్తై ర్హన్తుమ్ ఉద్యతా ఏతస్మిన్నన్తరే ససైన్యోహం తత్రోపస్థాయ ఏష జనో రోమీయ ఇతి విజ్ఞాయ తం రక్షితవాన్|</para>
  <para style="p">
    <verse number="28" style="v"/>కిన్నిమిత్తం తే తమపవదన్తే తజ్జ్ఞాతుం తేషా సభాం తమానాయితవాన్|</para>
  <para style="p">
    <verse number="29" style="v"/>తతస్తేషాం వ్యవస్థాయా విరుద్ధయా కయాచన కథయా సోఽపవాదితోఽభవత్, కిన్తు స శృఙ్ఖలబన్ధనార్హో వా ప్రాణనాశార్హో భవతీదృశః కోప్యపరాధో మయాస్య న దృష్టః|</para>
  <para style="p">
    <verse number="30" style="v"/>తథాపి మనుష్యస్యాస్య వధార్థం యిహూదీయా ఘాతకాఇవ సజ్జితా ఏతాం వార్త్తాం శ్రుత్వా తత్క్షణాత్ తవ సమీపమేనం ప్రేషితవాన్ అస్యాపవాదకాంశ్చ తవ సమీపం గత్వాపవదితుమ్ ఆజ్ఞాపయమ్| భవతః కుశలం భూయాత్|</para>
  <para style="p">
    <verse number="31" style="v"/>సైన్యగణ ఆజ్ఞానుసారేణ పౌలం గృహీత్వా తస్యాం రజన్యామ్ ఆన్తిపాత్రినగరమ్ ఆనయత్|</para>
  <para style="p">
    <verse number="32" style="v"/>పరేఽహని తేన సహ యాతుం ఘోటకారూఢసైన్యగణం స్థాపయిత్వా పరావృత్య దుర్గం గతవాన్|</para>
  <para style="p">
    <verse number="33" style="v"/>తతః పరే ఘోటకారోహిసైన్యగణః కైసరియానగరమ్ ఉపస్థాయ తత్పత్రమ్ అధిపతేః కరే సమర్ప్య తస్య సమీపే పౌలమ్ ఉపస్థాపితవాన్|</para>
  <para style="p">
    <verse number="34" style="v"/>తదాధిపతిస్తత్పత్రం పఠిత్వా పృష్ఠవాన్ ఏష కిమ్ప్రదేశీయో జనః? స కిలికియాప్రదేశీయ ఏకో జన ఇతి జ్ఞాత్వా కథితవాన్,</para>
  <para style="p">
    <verse number="35" style="v"/>తవాపవాదకగణ ఆగతే తవ కథాం శ్రోష్యామి| హేరోద్రాజగృహే తం స్థాపయితుమ్ ఆదిష్టవాన్|</para>
  <chapter number="24" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>పఞ్చభ్యో దినేభ్యః పరం హనానీయనామా మహాయాజకోఽధిపతేః సమక్షం పౌలస్య ప్రాతికూల్యేన నివేదయితుం తర్తుల్లనామానం కఞ్చన వక్తారం ప్రాచీనజనాంశ్చ సఙ్గినః కృత్వా కైసరియానగరమ్ ఆగచ్ఛత్|</para>
  <para style="p">
    <verse number="2" style="v"/>తతః పౌలే సమానీతే సతి తర్తుల్లస్తస్యాపవాదకథాం కథయితుమ్ ఆరభత హే మహామహిమఫీలిక్ష భవతో వయమ్ అతినిర్వ్విఘ్నం కాలం యాపయామో భవతః పరిణామదర్శితయా ఏతద్దేశీయానాం బహూని మఙ్గలాని ఘటితాని,</para>
  <para style="p">
    <verse number="3" style="v"/>ఇతి హేతో ర్వయమతికృతజ్ఞాః సన్తః సర్వ్వత్ర సర్వ్వదా భవతో గుణాన్ గాయమః|</para>
  <para style="p">
    <verse number="4" style="v"/>కిన్తు బహుభిః కథాభి ర్భవన్తం యేన న విరఞ్జయామి తస్మాద్ వినయే భవాన్ బనుకమ్ప్య మదల్పకథాం శృణోతు|</para>
  <para style="p">
    <verse number="5" style="v"/>ఏష మహామారీస్వరూపో నాసరతీయమతగ్రాహిసంఘాతస్య ముఖ్యో భూత్వా సర్వ్వదేశేషు సర్వ్వేషాం యిహూదీయానాం రాజద్రోహాచరణప్రవృత్తిం జనయతీత్యస్మాభి ర్నిశ్చితం|</para>
  <para style="p">
    <verse number="6" style="v"/>స మన్దిరమపి అశుచి కర్త్తుం చేష్టితవాన్; ఇతి కారణాద్ వయమ్ ఏనం ధృత్వా స్వవ్యవస్థానుసారేణ విచారయితుం ప్రావర్త్తామహి;</para>
  <para style="p">
    <verse number="7" style="v"/>కిన్తు లుషియః సహస్రసేనాపతిరాగత్య బలాద్ అస్మాకం కరేభ్య ఏనం గృహీత్వా</para>
  <para style="p">
    <verse number="8" style="v"/>ఏతస్యాపవాదకాన్ భవతః సమీపమ్ ఆగన్తుమ్ ఆజ్ఞాపయత్| వయం యస్మిన్ తమపవాదామో భవతా పదపవాదకథాయాం విచారితాయాం సత్యాం సర్వ్వం వృత్తాన్తం వేదితుం శక్ష్యతే|</para>
  <para style="p">
    <verse number="9" style="v"/>తతో యిహూదీయా అపి స్వీకృత్య కథితవన్త ఏషా కథా ప్రమాణమ్|</para>
  <para style="p">
    <verse number="10" style="v"/>అధిపతౌ కథాం కథయితుం పౌలం ప్రతీఙ్గితం కృతవతి స కథితవాన్ భవాన్ బహూన్ వత్సరాన్ యావద్ ఏతద్దేశస్య శాసనం కరోతీతి విజ్ఞాయ ప్రత్యుత్తరం దాతుమ్ అక్షోభోఽభవమ్|</para>
  <para style="p">
    <verse number="11" style="v"/>అద్య కేవలం ద్వాదశ దినాని యాతాని, అహమ్ ఆరాధనాం కర్త్తుం యిరూశాలమనగరం గతవాన్ ఏషా కథా భవతా జ్ఞాతుం శక్యతే;</para>
  <para style="p">
    <verse number="12" style="v"/>కిన్త్విభే మాం మధ్యేమన్దిరం కేనాపి సహ వితణ్డాం కుర్వ్వన్తం కుత్రాపి భజనభవనే నగరే వా లోకాన్ కుప్రవృత్తిం జనయన్తుం న దృష్టవన్తః|</para>
  <para style="p">
    <verse number="13" style="v"/>ఇదానీం యస్మిన్ యస్మిన్ మామ్ అపవదన్తే తస్య కిమపి ప్రమాణం దాతుం న శక్నువన్తి|</para>
  <para style="p">
    <verse number="14" style="v"/>కిన్తు భవిష్యద్వాక్యగ్రన్థే వ్యవస్థాగ్రన్థే చ యా యా కథా లిఖితాస్తే తాసు సర్వ్వాసు విశ్వస్య యన్మతమ్ ఇమే విధర్మ్మం జానన్తి తన్మతానుసారేణాహం నిజపితృపురుషాణామ్ ఈశ్వరమ్ ఆరాధయామీత్యహం భవతః సమక్షమ్ అఙ్గీకరోమి|</para>
  <para style="p">
    <verse number="15" style="v"/>ధార్మ్మికాణామ్ అధార్మ్మికాణాఞ్చ ప్రమీతలోకానామేవోత్థానం భవిష్యతీతి కథామిమే స్వీకుర్వ్వన్తి తథాహమపి తస్మిన్ ఈశ్వరే ప్రత్యాశాం కరోమి;</para>
  <para style="p">
    <verse number="16" style="v"/>ఈశ్వరస్య మానవానాఞ్చ సమీపే యథా నిర్దోషో భవామి తదర్థం సతతం యత్నవాన్ అస్మి|</para>
  <para style="p">
    <verse number="17" style="v"/>బహుషు వత్సరేషు గతేషు స్వదేశీయలోకానాం నిమిత్తం దానీయద్రవ్యాణి నైవేద్యాని చ సమాదాయ పునరాగమనం కృతవాన్|</para>
  <para style="p">
    <verse number="18" style="v"/>తతోహం శుచి ర్భూత్వా లోకానాం సమాగమం కలహం వా న కారితవాన్ తథాప్యాశియాదేశీయాః కియన్తో యిహుదీయలోకా మధ్యేమన్దిరం మాం ధృతవన్తః|</para>
  <para style="p">
    <verse number="19" style="v"/>మమోపరి యది కాచిదపవాదకథాస్తి తర్హి భవతః సమీపమ్ ఉపస్థాయ తేషామేవ సాక్ష్యదానమ్ ఉచితమ్|</para>
  <para style="p">
    <verse number="20" style="v"/>నోచేత్ పూర్వ్వే మహాసభాస్థానాం లోకానాం సన్నిధౌ మమ దణ్డాయమానత్వసమయే, అహమద్య మృతానాముత్థానే యుష్మాభి ర్విచారితోస్మి,</para>
  <para style="p">
    <verse number="21" style="v"/>తేషాం మధ్యే తిష్ఠన్నహం యామిమాం కథాముచ్చైః స్వరేణ కథితవాన్ తదన్యో మమ కోపి దోషోఽలభ్యత న వేతి వరమ్ ఏతే సముపస్థితలోకా వదన్తు|</para>
  <para style="p">
    <verse number="22" style="v"/>తదా ఫీలిక్ష ఏతాం కథాం శ్రుత్వా తన్మతస్య విశేషవృత్తాన్తం విజ్ఞాతుం విచారం స్థగితం కృత్వా కథితవాన్ లుషియే సహస్రసేనాపతౌ సమాయాతే సతి యుష్మాకం విచారమ్ అహం నిష్పాదయిష్యామి|</para>
  <para style="p">
    <verse number="23" style="v"/>అనన్తరం బన్ధనం వినా పౌలం రక్షితుం తస్య సేవనాయ సాక్షాత్కరణాయ వా తదీయాత్మీయబన్ధుజనాన్ న వారయితుఞ్చ శమసేనాపతిమ్ ఆదిష్టవాన్|</para>
  <para style="p">
    <verse number="24" style="v"/>అల్పదినాత్ పరం ఫీలిక్షోఽధిపతి ర్ద్రుషిల్లానామ్నా యిహూదీయయా స్వభార్య్యయా సహాగత్య పౌలమాహూయ తస్య ముఖాత్ ఖ్రీష్టధర్మ్మస్య వృత్తాన్తమ్ అశ్రౌషీత్|</para>
  <para style="p">
    <verse number="25" style="v"/>పౌలేన న్యాయస్య పరిమితభోగస్య చరమవిచారస్య చ కథాయాం కథితాయాం సత్యాం ఫీలిక్షః కమ్పమానః సన్ వ్యాహరద్ ఇదానీం యాహి, అహమ్ అవకాశం ప్రాప్య త్వామ్ ఆహూస్యామి|</para>
  <para style="p">
    <verse number="26" style="v"/>ముక్తిప్రప్త్యర్థం పౌలేన మహ్యం ముద్రాదాస్యన్తే ఇతి పత్యాశాం కృత్వా స పునః పునస్తమాహూయ తేన సాకం కథోపకథనం కృతవాన్|</para>
  <para style="p">
    <verse number="27" style="v"/>కిన్తు వత్సరద్వయాత్ పరం పర్కియఫీష్ట ఫాలిక్షస్య పదం ప్రాప్తే సతి ఫీలిక్షో యిహూదీయాన్ సన్తుష్టాన్ చికీర్షన్ పౌలం బద్ధం సంస్థాప్య గతవాన్|</para>
  <chapter number="25" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అనన్తరం ఫీష్టో నిజరాజ్యమ్ ఆగత్య దినత్రయాత్ పరం కైసరియాతో యిరూశాలమ్నగరమ్ ఆగమత్|</para>
  <para style="p">
    <verse number="2" style="v"/>తదా మహాయాజకో యిహూదీయానాం ప్రధానలోకాశ్చ తస్య సమక్షం పౌలమ్ అపావదన్త|</para>
  <para style="p">
    <verse number="3" style="v"/>భవాన్ తం యిరూశాలమమ్ ఆనేతుమ్ ఆజ్ఞాపయత్వితి వినీయ తే తస్మాద్ అనుగ్రహం వాఞ్ఛితవన్తః|</para>
  <para style="p">
    <verse number="4" style="v"/>యతః పథిమధ్యే గోపనేన పౌలం హన్తుం తై ర్ఘాతకా నియుక్తాః| ఫీష్ట ఉత్తరం దత్తవాన్ పౌలః కైసరియాయాం స్థాస్యతి పునరల్పదినాత్ పరమ్ అహం తత్ర యాస్యామి|</para>
  <para style="p">
    <verse number="5" style="v"/>తతస్తస్య మానుషస్య యది కశ్చిద్ అపరాధస్తిష్ఠతి తర్హి యుష్మాకం యే శక్నువన్తి తే మయా సహ తత్ర గత్వా తమపవదన్తు స ఏతాం కథాం కథితవాన్|</para>
  <para style="p">
    <verse number="6" style="v"/>దశదివసేభ్యోఽధికం విలమ్బ్య ఫీష్టస్తస్మాత్ కైసరియానగరం గత్వా పరస్మిన్ దివసే విచారాసన ఉపదిశ్య పౌలమ్ ఆనేతుమ్ ఆజ్ఞాపయత్|</para>
  <para style="p">
    <verse number="7" style="v"/>పౌలే సముపస్థితే సతి యిరూశాలమ్నగరాద్ ఆగతా యిహూదీయలోకాస్తం చతుర్దిశి సంవేష్ట్య తస్య విరుద్ధం బహూన్ మహాదోషాన్ ఉత్థాపితవన్తః కిన్తు తేషాం కిమపి ప్రమాణం దాతుం న శక్నువన్తః|</para>
  <para style="p">
    <verse number="8" style="v"/>తతః పౌలః స్వస్మిన్ ఉత్తరమిదమ్ ఉదితవాన్, యిహూదీయానాం వ్యవస్థాయా మన్దిరస్య కైసరస్య వా ప్రతికూలం కిమపి కర్మ్మ నాహం కృతవాన్|</para>
  <para style="p">
    <verse number="9" style="v"/>కిన్తు ఫీష్టో యిహూదీయాన్ సన్తుష్టాన్ కర్త్తుమ్ అభిలషన్ పౌలమ్ అభాషత త్వం కిం యిరూశాలమం గత్వాస్మిన్ అభియోగే మమ సాక్షాద్ విచారితో భవిష్యసి?</para>
  <para style="p">
    <verse number="10" style="v"/>తతః పౌల ఉత్తరం ప్రోక్తవాన్, యత్ర మమ విచారో భవితుం యోగ్యః కైసరస్య తత్ర విచారాసన ఏవ సముపస్థితోస్మి; అహం యిహూదీయానాం కామపి హానిం నాకార్షమ్ ఇతి భవాన్ యథార్థతో విజానాతి|</para>
  <para style="p">
    <verse number="11" style="v"/>కఞ్చిదపరాధం కిఞ్చన వధార్హం కర్మ్మ వా యద్యహమ్ అకరిష్యం తర్హి ప్రాణహననదణ్డమపి భోక్తుమ్ ఉద్యతోఽభవిష్యం, కిన్తు తే మమ సమపవాదం కుర్వ్వన్తి స యది కల్పితమాత్రో భవతి తర్హి తేషాం కరేషు మాం సమర్పయితుం కస్యాప్యధికారో నాస్తి, కైసరస్య నికటే మమ విచారో భవతు|</para>
  <para style="p">
    <verse number="12" style="v"/>తదా ఫీష్టో మన్త్రిభిః సార్ద్ధం సంమన్త్ర్య పౌలాయ కథితవాన్, కైసరస్య నికటే కిం తవ విచారో భవిష్యతి? కైసరస్య సమీపం గమిష్యసి|</para>
  <para style="p">
    <verse number="13" style="v"/>కియద్దినేభ్యః పరమ్ ఆగ్రిప్పరాజా బర్ణీకీ చ ఫీష్టం సాక్షాత్ కర్త్తుం కైసరియానగరమ్ ఆగతవన్తౌ|</para>
  <para style="p">
    <verse number="14" style="v"/>తదా తౌ బహుదినాని తత్ర స్థితౌ తతః ఫీష్టస్తం రాజానం పౌలస్య కథాం విజ్ఞాప్య కథయితుమ్ ఆరభత పౌలనామానమ్ ఏకం బన్ది ఫీలిక్షో బద్ధం సంస్థాప్య గతవాన్|</para>
  <para style="p">
    <verse number="15" style="v"/>యిరూశాలమి మమ స్థితికాలే మహాయాజకో యిహూదీయానాం ప్రాచీనలోకాశ్చ తమ్ అపోద్య తమ్ప్రతి దణ్డాజ్ఞాం ప్రార్థయన్త|</para>
  <para style="p">
    <verse number="16" style="v"/>తతోహమ్ ఇత్యుత్తరమ్ అవదం యావద్ అపోదితో జనః స్వాపవాదకాన్ సాక్షాత్ కృత్వా స్వస్మిన్ యోఽపరాధ ఆరోపితస్తస్య ప్రత్యుత్తరం దాతుం సుయోగం న ప్రాప్నోతి, తావత్కాలం కస్యాపి మానుషస్య ప్రాణనాశాజ్ఞాపనం రోమిలోకానాం రీతి ర్నహి|</para>
  <para style="p">
    <verse number="17" style="v"/>తతస్తేష్వత్రాగతేషు పరస్మిన్ దివసేఽహమ్ అవిలమ్బం విచారాసన ఉపవిశ్య తం మానుషమ్ ఆనేతుమ్ ఆజ్ఞాపయమ్|</para>
  <para style="p">
    <verse number="18" style="v"/>తదనన్తరం తస్యాపవాదకా ఉపస్థాయ యాదృశమ్ అహం చిన్తితవాన్ తాదృశం కఞ్చన మహాపవాదం నోత్థాప్య</para>
  <para style="p">
    <verse number="19" style="v"/>స్వేషాం మతే తథా పౌలో యం సజీవం వదతి తస్మిన్ యీశునామని మృతజనే చ తస్య విరుద్ధం కథితవన్తః|</para>
  <para style="p">
    <verse number="20" style="v"/>తతోహం తాదృగ్విచారే సంశయానః సన్ కథితవాన్ త్వం యిరూశాలమం గత్వా కిం తత్ర విచారితో భవితుమ్ ఇచ్ఛసి?</para>
  <para style="p">
    <verse number="21" style="v"/>తదా పౌలో మహారాజస్య నికటే విచారితో భవితుం ప్రార్థయత, తస్మాద్ యావత్కాలం తం కైసరస్య సమీపం ప్రేషయితుం న శక్నోమి తావత్కాలం తమత్ర స్థాపయితుమ్ ఆదిష్టవాన్|</para>
  <para style="p">
    <verse number="22" style="v"/>తత ఆగ్రిప్పః ఫీష్టమ్ ఉక్తవాన్, అహమపి తస్య మానుషస్య కథాం శ్రోతుమ్ అభిలషామి| తదా ఫీష్టో వ్యాహరత్ శ్వస్తదీయాం కథాం త్వం శ్రోష్యసి|</para>
  <para style="p">
    <verse number="23" style="v"/>పరస్మిన్ దివసే ఆగ్రిప్పో బర్ణీకీ చ మహాసమాగమం కృత్వా ప్రధానవాహినీపతిభి ర్నగరస్థప్రధానలోకైశ్చ సహ మిలిత్వా రాజగృహమాగత్య సముపస్థితౌ తదా ఫీష్టస్యాజ్ఞయా పౌల ఆనీతోఽభవత్|</para>
  <para style="p">
    <verse number="24" style="v"/>తదా ఫీష్టః కథితవాన్ హే రాజన్ ఆగ్రిప్ప హే ఉపస్థితాః సర్వ్వే లోకా యిరూశాలమ్నగరే యిహూదీయలోకసమూహో యస్మిన్ మానుషే మమ సమీపే నివేదనం కృత్వా ప్రోచ్చైః కథామిమాం కథితవాన్ పునరల్పకాలమపి తస్య జీవనం నోచితం తమేతం మానుషం పశ్యత|</para>
  <para style="p">
    <verse number="25" style="v"/>కిన్త్వేష జనః ప్రాణనాశర్హం కిమపి కర్మ్మ న కృతవాన్ ఇత్యజానాం తథాపి స మహారాజస్య సన్నిధౌ విచారితో భవితుం ప్రార్థయత తస్మాత్ తస్య సమీపం తం ప్రేషయితుం మతిమకరవమ్|</para>
  <para style="p">
    <verse number="26" style="v"/>కిన్తు శ్రీయుక్తస్య సమీపమ్ ఏతస్మిన్ కిం లేఖనీయమ్ ఇత్యస్య కస్యచిన్ నిర్ణయస్య న జాతత్వాద్ ఏతస్య విచారే సతి యథాహం లేఖితుం కిఞ్చన నిశ్చితం ప్రాప్నోమి తదర్థం యుష్మాకం సమక్షం విశేషతో హే ఆగ్రిప్పరాజ భవతః సమక్షమ్ ఏతమ్ ఆనయే|</para>
  <para style="p">
    <verse number="27" style="v"/>యతో బన్దిప్రేషణసమయే తస్యాభియోగస్య కిఞ్చిదలేఖనమ్ అహమ్ అయుక్తం జానామి|</para>
  <chapter number="26" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>తత ఆగ్రిప్పః పౌలమ్ అవాదీత్, నిజాం కథాం కథయితుం తుభ్యమ్ అనుమతి ర్దీయతే| తస్మాత్ పౌలః కరం ప్రసార్య్య స్వస్మిన్ ఉత్తరమ్ అవాదీత్|</para>
  <para style="p">
    <verse number="2" style="v"/>హే ఆగ్రిప్పరాజ యత్కారణాదహం యిహూదీయైరపవాదితో ఽభవం తస్య వృత్తాన్తమ్ అద్య భవతః సాక్షాన్ నివేదయితుమనుమతోహమ్ ఇదం స్వీయం పరమం భాగ్యం మన్యే;</para>
  <para style="p">
    <verse number="3" style="v"/>యతో యిహూదీయలోకానాం మధ్యే యా యా రీతిః సూక్ష్మవిచారాశ్చ సన్తి తేషు భవాన్ విజ్ఞతమః; అతఏవ ప్రార్థయే ధైర్య్యమవలమ్బ్య మమ నివేదనం శృణోతు|</para>
  <para style="p">
    <verse number="4" style="v"/>అహం యిరూశాలమ్నగరే స్వదేశీయలోకానాం మధ్యే తిష్ఠన్ ఆ యౌవనకాలాద్ యద్రూపమ్ ఆచరితవాన్ తద్ యిహూదీయలోకాః సర్వ్వే విదన్తి|</para>
  <para style="p">
    <verse number="5" style="v"/>అస్మాకం సర్వ్వేభ్యః శుద్ధతమం యత్ ఫిరూశీయమతం తదవలమ్బీ భూత్వాహం కాలం యాపితవాన్ యే జనా ఆ బాల్యకాలాన్ మాం జానాన్తి తే ఏతాదృశం సాక్ష్యం యది దదాతి తర్హి దాతుం శక్నువన్తి|</para>
  <para style="p">
    <verse number="6" style="v"/>కిన్తు హే ఆగ్రిప్పరాజ ఈశ్వరోఽస్మాకం పూర్వ్వపురుషాణాం నికటే యద్ అఙ్గీకృతవాన్ తస్య ప్రత్యాశాహేతోరహమ్ ఇదానీం విచారస్థానే దణ్డాయమానోస్మి|</para>
  <para style="p">
    <verse number="7" style="v"/>తస్యాఙ్గీకారస్య ఫలం ప్రాప్తుమ్ అస్మాకం ద్వాదశవంశా దివానిశం మహాయత్నాద్ ఈశ్వరసేవనం కృత్వా యాం ప్రత్యాశాం కుర్వ్వన్తి తస్యాః ప్రత్యాశాయా హేతోరహం యిహూదీయైరపవాదితోఽభవమ్|</para>
  <para style="p">
    <verse number="8" style="v"/>ఈశ్వరో మృతాన్ ఉత్థాపయిష్యతీతి వాక్యం యుష్మాకం నికటేఽసమ్భవం కుతో భవేత్?</para>
  <para style="p">
    <verse number="9" style="v"/>నాసరతీయయీశో ర్నామ్నో విరుద్ధం నానాప్రకారప్రతికూలాచరణమ్ ఉచితమ్ ఇత్యహం మనసి యథార్థం విజ్ఞాయ</para>
  <para style="p">
    <verse number="10" style="v"/>యిరూశాలమనగరే తదకరవం ఫలతః ప్రధానయాజకస్య నికటాత్ క్షమతాం ప్రాప్య బహూన్ పవిత్రలోకాన్ కారాయాం బద్ధవాన్ విశేషతస్తేషాం హననసమయే తేషాం విరుద్ధాం నిజాం సమ్మతిం ప్రకాశితవాన్|</para>
  <para style="p">
    <verse number="11" style="v"/>వారం వారం భజనభవనేషు తేభ్యో దణ్డం ప్రదత్తవాన్ బలాత్ తం ధర్మ్మం నిన్దయితవాంశ్చ పునశ్చ తాన్ ప్రతి మహాక్రోధాద్ ఉన్మత్తః సన్ విదేశీయనగరాణి యావత్ తాన్ తాడితవాన్|</para>
  <para style="p">
    <verse number="12" style="v"/>ఇత్థం ప్రధానయాజకస్య సమీపాత్ శక్తిమ్ ఆజ్ఞాపత్రఞ్చ లబ్ధ్వా దమ్మేషక్నగరం గతవాన్|</para>
  <para style="p">
    <verse number="13" style="v"/>తదాహం హే రాజన్ మార్గమధ్యే మధ్యాహ్నకాలే మమ మదీయసఙ్గినాం లోకానాఞ్చ చతసృషు దిక్షు గగణాత్ ప్రకాశమానాం భాస్కరతోపి తేజస్వతీం దీప్తిం దృష్టవాన్|</para>
  <para style="p">
    <verse number="14" style="v"/>తస్మాద్ అస్మాసు సర్వ్వేషు భూమౌ పతితేషు సత్సు హే శౌల హై శౌల కుతో మాం తాడయసి? కణ్టకానాం ముఖే పాదాహననం తవ దుఃసాధ్యమ్ ఇబ్రీయభాషయా గదిత ఏతాదృశ ఏకః శబ్దో మయా శ్రుతః|</para>
  <para style="p">
    <verse number="15" style="v"/>తదాహం పృష్టవాన్ హే ప్రభో కో భవాన్? తతః స కథితవాన్ యం యీశుం త్వం తాడయసి సోహం,</para>
  <para style="p">
    <verse number="16" style="v"/>కిన్తు సముత్తిష్ఠ త్వం యద్ దృష్టవాన్ ఇతః పునఞ్చ యద్యత్ త్వాం దర్శయిష్యామి తేషాం సర్వ్వేషాం కార్య్యాణాం త్వాం సాక్షిణం మమ సేవకఞ్చ కర్త్తుమ్ దర్శనమ్ అదామ్|</para>
  <para style="p">
    <verse number="17" style="v"/>విశేషతో యిహూదీయలోకేభ్యో భిన్నజాతీయేభ్యశ్చ త్వాం మనోనీతం కృత్వా తేషాం యథా పాపమోచనం భవతి</para>
  <para style="p">
    <verse number="18" style="v"/>యథా తే మయి విశ్వస్య పవిత్రీకృతానాం మధ్యే భాగం ప్రాప్నువన్తి తదభిప్రాయేణ తేషాం జ్ఞానచక్షూంషి ప్రసన్నాని కర్త్తుం తథాన్ధకారాద్ దీప్తిం ప్రతి శైతానాధికారాచ్చ ఈశ్వరం ప్రతి మతీః పరావర్త్తయితుం తేషాం సమీపం త్వాం ప్రేష్యామి|</para>
  <para style="p">
    <verse number="19" style="v"/>హే ఆగ్రిప్పరాజ ఏతాదృశం స్వర్గీయప్రత్యాదేశం అగ్రాహ్యమ్ అకృత్వాహం</para>
  <para style="p">
    <verse number="20" style="v"/>ప్రథమతో దమ్మేషక్నగరే తతో యిరూశాలమి సర్వ్వస్మిన్ యిహూదీయదేశే అన్యేషు దేశేషు చ యేेన లోకా మతిం పరావర్త్త్య ఈశ్వరం ప్రతి పరావర్త్తయన్తే, మనఃపరావర్త్తనయోగ్యాని కర్మ్మాణి చ కుర్వ్వన్తి తాదృశమ్ ఉపదేశం ప్రచారితవాన్|</para>
  <para style="p">
    <verse number="21" style="v"/>ఏతత్కారణాద్ యిహూదీయా మధ్యేమన్దిరం మాం ధృత్వా హన్తుమ్ ఉద్యతాః|</para>
  <para style="p">
    <verse number="22" style="v"/>తథాపి ఖ్రీష్టో దుఃఖం భుక్త్వా సర్వ్వేషాం పూర్వ్వం శ్మశానాద్ ఉత్థాయ నిజదేశీయానాం భిన్నదేశీయానాఞ్చ సమీపే దీప్తిం ప్రకాశయిష్యతి</para>
  <para style="p">
    <verse number="23" style="v"/>భవిష్యద్వాదిగణో మూసాశ్చ భావికార్య్యస్య యదిదం ప్రమాణమ్ అదదురేతద్ వినాన్యాం కథాం న కథయిత్వా ఈశ్వరాద్ అనుగ్రహం లబ్ధ్వా మహతాం క్షుద్రాణాఞ్చ సర్వ్వేషాం సమీపే ప్రమాణం దత్త్వాద్య యావత్ తిష్ఠామి|</para>
  <para style="p">
    <verse number="24" style="v"/>తస్యమాం కథాం నిశమ్య ఫీష్ట ఉచ్చైః స్వరేణ కథితవాన్ హే పౌల త్వమ్ ఉన్మత్తోసి బహువిద్యాభ్యాసేన త్వం హతజ్ఞానో జాతః|</para>
  <para style="p">
    <verse number="25" style="v"/>స ఉక్తవాన్ హే మహామహిమ ఫీష్ట నాహమ్ ఉన్మత్తః కిన్తు సత్యం వివేచనీయఞ్చ వాక్యం ప్రస్తౌమి|</para>
  <para style="p">
    <verse number="26" style="v"/>యస్య సాక్షాద్ అక్షోభః సన్ కథాం కథయామి స రాజా తద్వృత్తాన్తం జానాతి తస్య సమీపే కిమపి గుప్తం నేతి మయా నిశ్చితం బుధ్యతే యతస్తద్ విజనే న కృతం|</para>
  <para style="p">
    <verse number="27" style="v"/>హే ఆగ్రిప్పరాజ భవాన్ కిం భవిష్యద్వాదిగణోక్తాని వాక్యాని ప్రత్యేతి? భవాన్ ప్రత్యేతి తదహం జానామి|</para>
  <para style="p">
    <verse number="28" style="v"/>తత ఆగ్రిప్పః పౌలమ్ అభిహితవాన్ త్వం ప్రవృత్తిం జనయిత్వా ప్రాయేణ మామపి ఖ్రీష్టీయం కరోషి|</para>
  <para style="p">
    <verse number="29" style="v"/>తతః సోఽవాదీత్ భవాన్ యే యే లోకాశ్చ మమ కథామ్ అద్య శృణ్వన్తి ప్రాయేణ ఇతి నహి కిన్త్వేతత్ శృఙ్ఖలబన్ధనం వినా సర్వ్వథా తే సర్వ్వే మాదృశా భవన్త్వితీశ్వస్య సమీపే ప్రార్థయేఽహమ్|</para>
  <para style="p">
    <verse number="30" style="v"/>ఏతస్యాం కథాయాం కథితాయాం స రాజా సోఽధిపతి ర్బర్ణీకీ సభాస్థా లోకాశ్చ తస్మాద్ ఉత్థాయ</para>
  <para style="p">
    <verse number="31" style="v"/>గోపనే పరస్పరం వివిచ్య కథితవన్త ఏష జనో బన్ధనార్హం ప్రాణహననార్హం వా కిమపి కర్మ్మ నాకరోత్|</para>
  <para style="p">
    <verse number="32" style="v"/>తత ఆగ్రిప్పః ఫీష్టమ్ అవదత్, యద్యేష మానుషః కైసరస్య నికటే విచారితో భవితుం న ప్రార్థయిష్యత్ తర్హి ముక్తో భవితుమ్ అశక్ష్యత్|</para>
  <chapter number="27" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>జలపథేనాస్మాకమ్ ఇతోలియాదేశం ప్రతి యాత్రాయాం నిశ్చితాయాం సత్యాం తే యూలియనామ్నో మహారాజస్య సంఘాతాన్తర్గతస్య సేనాపతేః సమీపే పౌలం తదన్యాన్ కతినయజనాంశ్చ సమార్పయన్|</para>
  <para style="p">
    <verse number="2" style="v"/>వయమ్ ఆద్రాముత్తీయం పోతమేకమ్ ఆరుహ్య ఆశియాదేశస్య తటసమీపేన యాతుం మతిం కృత్వా లఙ్గరమ్ ఉత్థాప్య పోతమ్ అమోచయామ; మాకిదనియాదేశస్థథిషలనీకీనివాస్యారిస్తార్ఖనామా కశ్చిద్ జనోఽస్మాభిః సార్ద్ధమ్ ఆసీత్|</para>
  <para style="p">
    <verse number="3" style="v"/>పరస్మిన్ దివసే ఽస్మాభిః సీదోన్నగరే పోతే లాగితే తత్ర యూలియః సేనాపతిః పౌలం ప్రతి సౌజన్యం ప్రదర్థ్య సాన్త్వనార్థం బన్ధుబాన్ధవాన్ ఉపయాతుమ్ అనుజజ్ఞౌ|</para>
  <para style="p">
    <verse number="4" style="v"/>తస్మాత్ పోతే మోచితే సతి సమ్ముఖవాయోః సమ్భవాద్ వయం కుప్రోపద్వీపస్య తీరసమీపేన గతవన్తః|</para>
  <para style="p">
    <verse number="5" style="v"/>కిలికియాయాః పామ్ఫూలియాయాశ్చ సముద్రస్య పారం గత్వా లూకియాదేశాన్తర్గతం మురానగరమ్ ఉపాతిష్ఠామ|</para>
  <para style="p">
    <verse number="6" style="v"/>తత్స్థానాద్ ఇతాలియాదేశం గచ్ఛతి యః సికన్దరియానగరస్య పోతస్తం తత్ర ప్రాప్య శతసేనాపతిస్తం పోతమ్ అస్మాన్ ఆరోహయత్|</para>
  <para style="p">
    <verse number="7" style="v"/>తతః పరం బహూని దినాని శనైః శనైః ర్గత్వా క్నీదపార్శ్వోపస్థ్తిेః పూర్వ్వం ప్రతికూలేన పవనేన వయం సల్మోన్యాః సమ్ముఖమ్ ఉపస్థాయ క్రీత్యుపద్వీపస్య తీరసమీపేన గతవన్తః|</para>
  <para style="p">
    <verse number="8" style="v"/>కష్టేన తముత్తీర్య్య లాసేయానగరస్యాధః సున్దరనామకం ఖాతమ్ ఉపాతిష్ఠామ|</para>
  <para style="p">
    <verse number="9" style="v"/>ఇత్థం బహుతిథః కాలో యాపిత ఉపవాసదినఞ్చాతీతం, తత్కారణాత్ నౌవర్త్మని భయఙ్కరే సతి పౌలో వినయేన కథితవాన్,</para>
  <para style="p">
    <verse number="10" style="v"/>హే మహేచ్ఛా అహం నిశ్చయం జానామి యాత్రాయామస్యామ్ అస్మాకం క్లేశా బహూనామపచయాశ్చ భవిష్యన్తి, తే కేవలం పోతసామగ్ర్యోరితి నహి, కిన్త్వస్మాకం ప్రాణానామపి|</para>
  <para style="p">
    <verse number="11" style="v"/>తదా శతసేనాపతిః పౌैेలోక్తవాక్యతోపి కర్ణధారస్య పోతవణిజశ్చ వాక్యం బహుమంస్త|</para>
  <para style="p">
    <verse number="12" style="v"/>తత్ ఖాతం శీతకాలే వాసార్హస్థానం న తస్మాద్ అవాచీప్రతీచోర్దిశోః క్రీత్యాః ఫైనీకియఖాతం యాతుం యది శక్నువన్తస్తర్హి తత్ర శీతకాలం యాపయితుం ప్రాయేణ సర్వ్వే మన్త్రయామాసుః|</para>
  <para style="p">
    <verse number="13" style="v"/>తతః పరం దక్షిణవాయు ర్మన్దం వహతీతి విలోక్య నిజాభిప్రాయస్య సిద్ధేః సుయోగో భవతీతి బుద్ధ్వా పోతం మోచయిత్వా క్రీత్యుపద్వీపస్య తీరసమీపేన చలితవన్తః|</para>
  <para style="p">
    <verse number="14" style="v"/>కిన్త్వల్పక్షణాత్ పరమేవ ఉరక్లుదోన్నామా ప్రతికూలః ప్రచణ్డో వాయు ర్వహన్ పోతేఽలగీత్</para>
  <para style="p">
    <verse number="15" style="v"/>తస్యాభిముఖం గన్తుమ్ పోతస్యాశక్తత్వాద్ వయం వాయునా స్వయం నీతాః|</para>
  <para style="p">
    <verse number="16" style="v"/>అనన్తరం క్లౌదీనామ్న ఉపద్వీపస్య కూలసమీపేన పోతం గమయిత్వా బహునా కష్టేన క్షుద్రనావమ్ అరక్షామ|</para>
  <para style="p">
    <verse number="17" style="v"/>తే తామారుహ్య రజ్జ్చా పోతస్యాధోభాగమ్ అబధ్నన్ తదనన్తరం చేత్ పోతో సైకతే లగతీతి భయాద్ వాతవసనాన్యమోచయన్ తతః పోతో వాయునా చాలితః|</para>
  <para style="p">
    <verse number="18" style="v"/>కిన్తు క్రమశో వాయోః ప్రబలత్వాత్ పోతో దోలాయమానోఽభవత్ పరస్మిన్ దివసే పోతస్థాని కతిపయాని ద్రవ్యాణి తోయే నిక్షిప్తాని|</para>
  <para style="p">
    <verse number="19" style="v"/>తృతీయదివసే వయం స్వహస్తైః పోతసజ్జనద్రవ్యాణి నిక్షిప్తవన్తః|</para>
  <para style="p">
    <verse number="20" style="v"/>తతో బహుదినాని యావత్ సూర్య్యనక్షత్రాదీని సమాచ్ఛన్నాని తతో ఽతీవ వాత్యాగమాద్ అస్మాకం ప్రాణరక్షాయాః కాపి ప్రత్యాశా నాతిష్ఠత్|</para>
  <para style="p">
    <verse number="21" style="v"/>బహుదినేషు లోకైరనాహారేణ యాపితేషు సర్వ్వేషాం సాక్షత్ పౌలస్తిష్ఠన్ అకథయత్, హే మహేచ్ఛాః క్రీత్యుపద్వీపాత్ పోతం న మోచయితుమ్ అహం పూర్వ్వం యద్ అవదం తద్గ్రహణం యుష్మాకమ్ ఉచితమ్ ఆసీత్ తథా కృతే యుష్మాకమ్ ఏషా విపద్ ఏషోఽపచయశ్చ నాఘటిష్యేతామ్|</para>
  <para style="p">
    <verse number="22" style="v"/>కిన్తు సామ్ప్రతం యుష్మాన్ వినీయ బ్రవీమ్యహం, యూయం న క్షుభ్యత యుష్మాకమ్ ఏకస్యాపి ప్రాణినో హాని ర్న భవిష్యతి, కేవలస్య పోతస్య హాని ర్భవిష్యతి|</para>
  <para style="p">
    <verse number="23" style="v"/>యతో యస్యేశ్వరస్య లోకోఽహం యఞ్చాహం పరిచరామి తదీయ ఏకో దూతో హ్యో రాత్రౌ మమాన్తికే తిష్ఠన్ కథితవాన్,</para>
  <para style="p">
    <verse number="24" style="v"/>హే పౌల మా భైషీః కైసరస్య సమ్ముఖే త్వయోపస్థాతవ్యం; తవైతాన్ సఙ్గినో లోకాన్ ఈశ్వరస్తుభ్యం దత్తవాన్|</para>
  <para style="p">
    <verse number="25" style="v"/>అతఏవ హే మహేచ్ఛా యూయం స్థిరమనసో భవత మహ్యం యా కథాకథి సావశ్యం ఘటిష్యతే మమైతాదృశీ విశ్వాస ఈశ్వరే విద్యతే,</para>
  <para style="p">
    <verse number="26" style="v"/>కిన్తు కస్యచిద్ ఉపద్వీపస్యోపరి పతితవ్యమ్ అస్మాభిః|</para>
  <para style="p">
    <verse number="27" style="v"/>తతః పరమ్ ఆద్రియాసముద్రే పోతస్తథైవ దోలాయమానః సన్ ఇతస్తతో గచ్ఛన్ చతుర్దశదివసస్య రాత్రే ర్ద్వితీయప్రహరసమయే కస్యచిత్ స్థలస్య సమీపముపతిష్ఠతీతి పోతీయలోకా అన్వమన్యన్త|</para>
  <para style="p">
    <verse number="28" style="v"/>తతస్తే జలం పరిమాయ తత్ర వింశతి ర్వ్యామా జలానీతి జ్ఞాతవన్తః| కిఞ్చిద్దూరం గత్వా పునరపి జలం పరిమితవన్తః| తత్ర పఞ్చదశ వ్యామా జలాని దృష్ట్వా</para>
  <para style="p">
    <verse number="29" style="v"/>చేత్ పాషాణే లగతీతి భయాత్ పోతస్య పశ్చాద్భాగతశ్చతురో లఙ్గరాన్ నిక్షిప్య దివాకరమ్ అపేక్ష్య సర్వ్వే స్థితవన్తః|</para>
  <para style="p">
    <verse number="30" style="v"/>కిన్తు పోతీయలోకాః పోతాగ్రభాగే లఙ్గరనిక్షేపం ఛలం కృత్వా జలధౌ క్షుద్రనావమ్ అవరోహ్య పలాయితుమ్ అచేష్టన్త|</para>
  <para style="p">
    <verse number="31" style="v"/>తతః పౌలః సేనాపతయే సైన్యగణాయ చ కథితవాన్, ఏతే యది పోతమధ్యే న తిష్ఠన్తి తర్హి యుష్మాకం రక్షణం న శక్యం|</para>
  <para style="p">
    <verse number="32" style="v"/>తదా సేనాగణో రజ్జూన్ ఛిత్వా నావం జలే పతితుమ్ అదదాత్|</para>
  <para style="p">
    <verse number="33" style="v"/>ప్రభాతసమయే పౌలః సర్వ్వాన్ జనాన్ భోజనార్థం ప్రార్థ్య వ్యాహరత్, అద్య చతుర్దశదినాని యావద్ యూయమ్ అపేక్షమానా అనాహారాః కాలమ్ అయాపయత కిమపి నాభుంగ్ధం|</para>
  <para style="p">
    <verse number="34" style="v"/>అతో వినయేेఽహం భక్ష్యం భుజ్యతాం తతో యుష్మాకం మఙ్గలం భవిష్యతి, యుష్మాకం కస్యచిజ్జనస్య శిరసః కేశైకోపి న నంక్ష్యతి|</para>
  <para style="p">
    <verse number="35" style="v"/>ఇతి వ్యాహృత్య పౌలం పూపం గృహీత్వేశ్వరం ధన్యం భాషమాణస్తం భంక్త్వా భోక్తుమ్ ఆరబ్ధవాన్|</para>
  <para style="p">
    <verse number="36" style="v"/>అనన్తరం సర్వ్వే చ సుస్థిరాః సన్తః ఖాద్యాని పర్ప్యగృహ్లన్|</para>
  <para style="p">
    <verse number="37" style="v"/>అస్మాకం పోతే షట్సప్తత్యధికశతద్వయలోకా ఆసన్|</para>
  <para style="p">
    <verse number="38" style="v"/>సర్వ్వేషు లోకేషు యథేష్టం భుక్తవత్సు పోతస్థన్ గోధూమాన్ జలధౌ నిక్షిప్య తైః పోతస్య భారో లఘూకృతః|</para>
  <para style="p">
    <verse number="39" style="v"/>దినే జాతేఽపి స కో దేశ ఇతి తదా న పర్య్యచీయత; కిన్తు తత్ర సమతటమ్ ఏకం ఖాతం దృష్ట్వా యది శక్నుమస్తర్హి వయం తస్యాభ్యన్తరం పోతం గమయామ ఇతి మతిం కృత్వా తే లఙ్గరాన్ ఛిత్త్వా జలధౌ త్యక్తవన్తః|</para>
  <para style="p">
    <verse number="40" style="v"/>తథా కర్ణబన్ధనం మోచయిత్వా ప్రధానం వాతవసనమ్ ఉత్తోల్య తీరసమీపం గతవన్తః|</para>
  <para style="p">
    <verse number="41" style="v"/>కిన్తు ద్వయోః సముద్రయోః సఙ్గమస్థానే సైకతోపరి పోతే నిక్షిప్తే ఽగ్రభాగే బాధితే పశ్చాద్భాగే ప్రబలతరఙ్గోఽలగత్ తేన పోతో భగ్నః|</para>
  <para style="p">
    <verse number="42" style="v"/>తస్మాద్ బన్దయశ్చేద్ బాహుభిస్తరన్తః పలాయన్తే ఇత్యాశఙ్కయా సేనాగణస్తాన్ హన్తుమ్ అమన్త్రయత్;</para>
  <para style="p">
    <verse number="43" style="v"/>కిన్తు శతసేనాపతిః పౌలం రక్షితుం ప్రయత్నం కృత్వా తాన్ తచ్చేష్టాయా నివర్త్య ఇత్యాదిష్టవాన్, యే బాహుతరణం జానన్తి తేఽగ్రే ప్రోల్లమ్ప్య సముద్రే పతిత్వా బాహుభిస్తీర్త్త్వా కూలం యాన్తు|</para>
  <para style="p">
    <verse number="44" style="v"/>అపరమ్ అవశిష్టా జనాః కాష్ఠం పోతీయం ద్రవ్యం వా యేన యత్ ప్రాప్యతే తదవలమ్బ్య యాన్తు; ఇత్థం సర్వ్వే భూమిం ప్రాప్య ప్రాణై ర్జీవితాః|</para>
  <chapter number="28" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ఇత్థం సర్వ్వేషు రక్షాం ప్రాప్తేషు తత్రత్యోపద్వీపస్య నామ మిలీతేతి తే జ్ఞాతవన్తః|</para>
  <para style="p">
    <verse number="2" style="v"/>అసభ్యలోకా యథేష్టమ్ అనుకమ్పాం కృత్వా వర్త్తమానవృష్టేః శీతాచ్చ వహ్నిం ప్రజ్జ్వాల్యాస్మాకమ్ ఆతిథ్యమ్ అకుర్వ్వన్|</para>
  <para style="p">
    <verse number="3" style="v"/>కిన్తు పౌల ఇన్ధనాని సంగృహ్య యదా తస్మిన్ అగ్రౌ నిరక్షిపత్, తదా వహ్నేః ప్రతాపాత్ ఏకః కృష్ణసర్పో నిర్గత్య తస్య హస్తే ద్రష్టవాన్|</para>
  <para style="p">
    <verse number="4" style="v"/>తేఽసభ్యలోకాస్తస్య హస్తే సర్పమ్ అవలమ్బమానం దృష్ట్వా పరస్పరమ్ ఉక్తవన్త ఏష జనోఽవశ్యం నరహా భవిష్యతి, యతో యద్యపి జలధే రక్షాం ప్రాప్తవాన్ తథాపి ప్రతిఫలదాయక ఏనం జీవితుం న దదాతి|</para>
  <para style="p">
    <verse number="5" style="v"/>కిన్తు స హస్తం విధున్వన్ తం సర్పమ్ అగ్నిమధ్యే నిక్షిప్య కామపి పీడాం నాప్తవాన్|</para>
  <para style="p">
    <verse number="6" style="v"/>తతో విషజ్వాలయా ఏతస్య శరీరం స్ఫీతం భవిష్యతి యద్వా హఠాదయం ప్రాణాన్ త్యక్ష్యతీతి నిశ్చిత్య లోకా బహుక్షణాని యావత్ తద్ ద్రష్టుం స్థితవన్తః కిన్తు తస్య కస్యాశ్చిద్ విపదోఽఘటనాత్ తే తద్విపరీతం విజ్ఞాయ భాషితవన్త ఏష కశ్చిద్ దేవో భవేత్|</para>
  <para style="p">
    <verse number="7" style="v"/>పుబ్లియనామా జన ఏకస్తస్యోపద్వీపస్యాధిపతిరాసీత్ తత్ర తస్య భూమ్యాది చ స్థితం| స జనోఽస్మాన్ నిజగృహం నీత్వా సౌజన్యం ప్రకాశ్య దినత్రయం యావద్ అస్మాకం ఆతిథ్యమ్ అకరోత్|</para>
  <para style="p">
    <verse number="8" style="v"/>తదా తస్య పుబ్లియస్య పితా జ్వరాతిసారేణ పీడ్యమానః సన్ శయ్యాయామ్ ఆసీత్; తతః పౌలస్తస్య సమీపం గత్వా ప్రార్థనాం కృత్వా తస్య గాత్రే హస్తం సమర్ప్య తం స్వస్థం కృతవాన్|</para>
  <para style="p">
    <verse number="9" style="v"/>ఇత్థం భూతే తద్వీపనివాసిన ఇతరేపి రోగిలోకా ఆగత్య నిరామయా అభవన్|</para>
  <para style="p">
    <verse number="10" style="v"/>తస్మాత్తేఽస్మాకమ్ అతీవ సత్కారం కృతవన్తః, విశేషతః ప్రస్థానసమయే ప్రయోజనీయాని నానద్రవ్యాణి దత్తవన్తః|</para>
  <para style="p">
    <verse number="11" style="v"/>ఇత్థం తత్ర త్రిషు మాసేషు గతేషు యస్య చిహ్నం దియస్కూరీ తాదృశ ఏకః సికన్దరీయనగరస్య పోతః శీతకాలం యాపయన్ తస్మిన్ ఉపద్వీపే ఽతిష్ఠత్ తమేవ పోతం వయమ్ ఆరుహ్య యాత్రామ్ అకుర్మ్మ|</para>
  <para style="p">
    <verse number="12" style="v"/>తతః ప్రథమతః సురాకూసనగరమ్ ఉపస్థాయ తత్ర త్రీణి దినాని స్థితవన్తః|</para>
  <para style="p">
    <verse number="13" style="v"/>తస్మాద్ ఆవృత్య రీగియనగరమ్ ఉపస్థితాః దినైకస్మాత్ పరం దక్షిణవయౌ సానుకూల్యే సతి పరస్మిన్ దివసే పతియలీనగరమ్ ఉపాతిష్ఠామ|</para>
  <para style="p">
    <verse number="14" style="v"/>తతోఽస్మాసు తత్రత్యం భ్రాతృగణం ప్రాప్తేషు తే స్వైః సార్ద్ధమ్ అస్మాన్ సప్త దినాని స్థాపయితుమ్ అయతన్త, ఇత్థం వయం రోమానగరమ్ ప్రత్యగచ్ఛామ|</para>
  <para style="p">
    <verse number="15" style="v"/>తస్మాత్ తత్రత్యాః భ్రాతరోఽస్మాకమ్ ఆగమనవార్త్తాం శ్రుత్వా ఆప్పియఫరం త్రిష్టావర్ణీఞ్చ యావద్ అగ్రేసరాః సన్తోస్మాన్ సాక్షాత్ కర్త్తుమ్ ఆగమన్; తేషాం దర్శనాత్ పౌల ఈశ్వరం ధన్యం వదన్ ఆశ్వాసమ్ ఆప్తవాన్|</para>
  <para style="p">
    <verse number="16" style="v"/>అస్మాసు రోమానగరం గతేషు శతసేనాపతిః సర్వ్వాన్ బన్దీన్ ప్రధానసేనాపతేః సమీపే సమార్పయత్ కిన్తు పౌలాయ స్వరక్షకపదాతినా సహ పృథగ్ వస్తుమ్ అనుమతిం దత్తవాన్|</para>
  <para style="p">
    <verse number="17" style="v"/>దినత్రయాత్ పరం పౌలస్తద్దేశస్థాన్ ప్రధానయిహూదిన ఆహూతవాన్ తతస్తేషు సముపస్థితేషు స కథితవాన్, హే భ్రాతృగణ నిజలోకానాం పూర్వ్వపురుషాణాం వా రీతే ర్విపరీతం కిఞ్చన కర్మ్మాహం నాకరవం తథాపి యిరూశాలమనివాసినో లోకా మాం బన్దిం కృత్వా రోమిలోకానాం హస్తేషు సమర్పితవన్తః|</para>
  <para style="p">
    <verse number="18" style="v"/>రోమిలోకా విచార్య్య మమ ప్రాణహననార్హం కిమపి కారణం న ప్రాప్య మాం మోచయితుమ్ ఐచ్ఛన్;</para>
  <para style="p">
    <verse number="19" style="v"/>కిన్తు యిహూదిలోకానామ్ ఆపత్త్యా మయా కైసరరాజస్య సమీపే విచారస్య ప్రార్థనా కర్త్తవ్యా జాతా నోచేత్ నిజదేశీయలోకాన్ ప్రతి మమ కోప్యభియోగో నాస్తి|</para>
  <para style="p">
    <verse number="20" style="v"/>ఏతత్కారణాద్ అహం యుష్మాన్ ద్రష్టుం సంలపితుఞ్చాహూయమ్ ఇస్రాయేల్వశీయానాం ప్రత్యాశాహేతోహమ్ ఏతేన శుఙ్ఖలేన బద్ధోఽభవమ్|</para>
  <para style="p">
    <verse number="21" style="v"/>తదా తే తమ్ అవాదిషుః, యిహూదీయదేశాద్ వయం త్వామధి కిమపి పత్రం న ప్రాప్తా యే భ్రాతరః సమాయాతాస్తేషాం కోపి తవ కామపి వార్త్తాం నావదత్ అభద్రమపి నాకథయచ్చ|</para>
  <para style="p">
    <verse number="22" style="v"/>తవ మతం కిమితి వయం త్వత్తః శ్రోతుమిచ్ఛామః| యద్ ఇదం నవీనం మతముత్థితం తత్ సర్వ్వత్ర సర్వ్వేషాం నికటే నిన్దితం జాతమ ఇతి వయం జానీమః|</para>
  <para style="p">
    <verse number="23" style="v"/>తైస్తదర్థమ్ ఏకస్మిన్ దినే నిరూపితే తస్మిన్ దినే బహవ ఏకత్ర మిలిత్వా పౌలస్య వాసగృహమ్ ఆగచ్ఛన్ తస్మాత్ పౌల ఆ ప్రాతఃకాలాత్ సన్ధ్యాకాలం యావన్ మూసావ్యవస్థాగ్రన్థాద్ భవిష్యద్వాదినాం గ్రన్థేభ్యశ్చ యీశోః కథామ్ ఉత్థాప్య ఈశ్వరస్య రాజ్యే ప్రమాణం దత్వా తేషాం ప్రవృత్తిం జనయితుం చేష్టితవాన్|</para>
  <para style="p">
    <verse number="24" style="v"/>కేచిత్తు తస్య కథాం ప్రత్యాయన్ కేచిత్తు న ప్రత్యాయన్;</para>
  <para style="p">
    <verse number="25" style="v"/>ఏతత్కారణాత్ తేషాం పరస్పరమ్ అనైక్యాత్ సర్వ్వే చలితవన్తః; తథాపి పౌల ఏతాం కథామేకాం కథితవాన్ పవిత్ర ఆత్మా యిశయియస్య భవిష్యద్వక్తు ర్వదనాద్ అస్మాకం పితృపురుషేభ్య ఏతాం కథాం భద్రం కథయామాస, యథా,</para>
  <para style="p">
    <verse number="26" style="v"/>"ఉపగత్య జనానేతాన్ త్వం భాషస్వ వచస్త్విదం| కర్ణైః శ్రోష్యథ యూయం హి కిన్తు యూయం న భోత్స్యథ| నేత్రై ర్ద్రక్ష్యథ యూయఞ్చ జ్ఞాతుం యూయం న శక్ష్యథ|</para>
  <para style="p">
    <verse number="27" style="v"/>తే మానుషా యథా నేత్రైః పరిపశ్యన్తి నైవ హి| కర్ణైః ర్యథా న శృణ్వన్తి బుధ్యన్తే న చ మానసైః| వ్యావర్త్తయత్సు చిత్తాని కాలే కుత్రాపి తేషు వై| మత్తస్తే మనుజాః స్వస్థా యథా నైవ భవన్తి చ| తథా తేషాం మనుష్యాణాం సన్తి స్థూలా హి బుద్ధయః| బధిరీభూతకర్ణాశ్చ జాతాశ్చ ముద్రితా దృశః||</para>
  <para style="p">
    <verse number="28" style="v"/>అత ఈశ్వరాద్ యత్ పరిత్రాణం తస్య వార్త్తా భిన్నదేశీయానాం సమీపం ప్రేషితా తఏవ తాం గ్రహీష్యన్తీతి యూయం జానీత|</para>
  <para style="p">
    <verse number="29" style="v"/>ఏతాదృశ్యాం కథాయాం కథితాయాం సత్యాం యిహూదినః పరస్పరం బహువిచారం కుర్వ్వన్తో గతవన్తః|</para>
  <para style="p">
    <verse number="30" style="v"/>ఇత్థం పౌలః సమ్పూర్ణం వత్సరద్వయం యావద్ భాటకీయే వాసగృహే వసన్ యే లోకాస్తస్య సన్నిధిమ్ ఆగచ్ఛన్తి తాన్ సర్వ్వానేవ పరిగృహ్లన్,</para>
  <para style="p">
    <verse number="31" style="v"/>నిర్విఘ్నమ్ అతిశయనిఃక్షోభమ్ ఈశ్వరీయరాజత్వస్య కథాం ప్రచారయన్ ప్రభౌ యీశౌ ఖ్రీష్టే కథాః సముపాదిశత్| ఇతి||</para>
</usx>
