<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="GAL" style="id">Sanskrit Bible (NT) in Telugu Script (సత్యవేదః।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Galatians</para>
  <para style="toc1">గాలాతినః పత్రం</para>
  <para style="toc2">గాలాతినః</para>
  <para style="toc3">గాలాతినః</para>
  <para style="mt1">గాలాతినః పత్రం</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>మనుష్యేభ్యో నహి మనుష్యైరపి నహి కిన్తు యీశుఖ్రీష్టేన మృతగణమధ్యాత్ తస్యోత్థాపయిత్రా పిత్రేశ్వరేణ చ ప్రేరితో యోఽహం పౌలః సోఽహం</para>
  <para style="p">
    <verse number="2" style="v"/>మత్సహవర్త్తినో భ్రాతరశ్చ వయం గాలాతీయదేశస్థాః సమితీః ప్రతి పత్రం లిఖామః|</para>
  <para style="p">
    <verse number="3" style="v"/>పిత్రేశ్వరేణాస్మాంక ప్రభునా యీశునా ఖ్రీష్టేన చ యుష్మభ్యమ్ అనుగ్రహః శాన్తిశ్చ దీయతాం|</para>
  <para style="p">
    <verse number="4" style="v"/>అస్మాకం తాతేశ్వరేస్యేచ్ఛానుసారేణ వర్త్తమానాత్ కుత్సితసంసారాద్ అస్మాన్ నిస్తారయితుం యో</para>
  <para style="p">
    <verse number="5" style="v"/>యీశురస్మాకం పాపహేతోరాత్మోత్సర్గం కృతవాన్ స సర్వ్వదా ధన్యో భూయాత్| తథాస్తు|</para>
  <para style="p">
    <verse number="6" style="v"/>ఖ్రీష్టస్యానుగ్రహేణ యో యుష్మాన్ ఆహూతవాన్ తస్మాన్నివృత్య యూయమ్ అతితూర్ణమ్ అన్యం సుసంవాదమ్ అన్వవర్త్తత తత్రాహం విస్మయం మన్యే|</para>
  <para style="p">
    <verse number="7" style="v"/>సోఽన్యసుసంవాదః సుసంవాదో నహి కిన్తు కేచిత్ మానవా యుష్మాన్ చఞ్చలీకుర్వ్వన్తి ఖ్రీష్టీయసుసంవాదస్య విపర్య్యయం కర్త్తుం చేష్టన్తే చ|</para>
  <para style="p">
    <verse number="8" style="v"/>యుష్మాకం సన్నిధౌ యః సుసంవాదోఽస్మాభి ర్ఘోషితస్తస్మాద్ అన్యః సుసంవాదోఽస్మాకం స్వర్గీయదూతానాం వా మధ్యే కేనచిద్ యది ఘోష్యతే తర్హి స శప్తో భవతు|</para>
  <para style="p">
    <verse number="9" style="v"/>పూర్వ్వం యద్వద్ అకథయామ, ఇదానీమహం పునస్తద్వత్ కథయామి యూయం యం సుసంవాదం గృహీతవన్తస్తస్మాద్ అన్యో యేన కేనచిద్ యుష్మత్సన్నిధౌ ఘోష్యతే స శప్తో భవతు|</para>
  <para style="p">
    <verse number="10" style="v"/>సామ్ప్రతం కమహమ్ అనునయామి? ఈశ్వరం కింవా మానవాన్? అహం కిం మానుషేభ్యో రోచితుం యతే? యద్యహమ్ ఇదానీమపి మానుషేభ్యో రురుచిషేయ తర్హి ఖ్రీష్టస్య పరిచారకో న భవామి|</para>
  <para style="p">
    <verse number="11" style="v"/>హే భ్రాతరః, మయా యః సుసంవాదో ఘోషితః స మానుషాన్న లబ్ధస్తదహం యుష్మాన్ జ్ఞాపయామి|</para>
  <para style="p">
    <verse number="12" style="v"/>అహం కస్మాచ్చిత్ మనుష్యాత్ తం న గృహీతవాన్ న వా శిక్షితవాన్ కేవలం యీశోః ఖ్రీష్టస్య ప్రకాశనాదేవ|</para>
  <para style="p">
    <verse number="13" style="v"/>పురా యిహూదిమతాచారీ యదాహమ్ ఆసం తదా యాదృశమ్ ఆచరణమ్ అకరవమ్ ఈశ్వరస్య సమితిం ప్రత్యతీవోపద్రవం కుర్వ్వన్ యాదృక్ తాం వ్యనాశయం తదవశ్యం శ్రుతం యుష్మాభిః|</para>
  <para style="p">
    <verse number="14" style="v"/>అపరఞ్చ పూర్వ్వపురుషపరమ్పరాగతేషు వాక్యేష్వన్యాపేక్షాతీవాసక్తః సన్ అహం యిహూదిధర్మ్మతే మమ సమవయస్కాన్ బహూన్ స్వజాతీయాన్ అత్యశయి|</para>
  <para style="p">
    <verse number="15" style="v"/>కిఞ్చ య ఈశ్వరో మాతృగర్భస్థం మాం పృథక్ కృత్వా స్వీయానుగ్రహేణాహూతవాన్</para>
  <para style="p">
    <verse number="16" style="v"/>స యదా మయి స్వపుత్రం ప్రకాశితుం భిన్నదేశీయానాం సమీపే భయా తం ఘోషయితుఞ్చాభ్యలషత్ తదాహం క్రవ్యశోణితాభ్యాం సహ న మన్త్రయిత్వా</para>
  <para style="p">
    <verse number="17" style="v"/>పూర్వ్వనియుక్తానాం ప్రేరితానాం సమీపం యిరూశాలమం న గత్వారవదేశం గతవాన్ పశ్చాత్ తత్స్థానాద్ దమ్మేషకనగరం పరావృత్యాగతవాన్|</para>
  <para style="p">
    <verse number="18" style="v"/>తతః పరం వర్షత్రయే వ్యతీతేఽహం పితరం సమ్భాషితుం యిరూశాలమం గత్వా పఞ్చదశదినాని తేన సార్ద్ధమ్ అతిష్ఠం|</para>
  <para style="p">
    <verse number="19" style="v"/>కిన్తు తం ప్రభో ర్భ్రాతరం యాకూబఞ్చ వినా ప్రేరితానాం నాన్యం కమప్యపశ్యం|</para>
  <para style="p">
    <verse number="20" style="v"/>యాన్యేతాని వాక్యాని మయా లిఖ్యన్తే తాన్యనృతాని న సన్తి తద్ ఈశ్వరో జానాతి|</para>
  <para style="p">
    <verse number="21" style="v"/>తతః పరమ్ అహం సురియాం కిలికియాఞ్చ దేశౌ గతవాన్|</para>
  <para style="p">
    <verse number="22" style="v"/>తదానీం యిహూదాదేశస్థానాం ఖ్రీష్టస్య సమితీనాం లోకాః సాక్షాత్ మమ పరిచయమప్రాప్య కేవలం జనశ్రుతిమిమాం లబ్ధవన్తః,</para>
  <para style="p">
    <verse number="23" style="v"/>యో జనః పూర్వ్వమ్ అస్మాన్ ప్రత్యుపద్రవమకరోత్ స తదా యం ధర్మ్మమనాశయత్ తమేవేదానీం ప్రచారయతీతి|</para>
  <para style="p">
    <verse number="24" style="v"/>తస్మాత్ తే మామధీశ్వరం ధన్యమవదన్|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అనన్తరం చతుర్దశసు వత్సరేషు గతేష్వహం బర్ణబ్బా సహ యిరూశాలమనగరం పునరగచ్ఛం, తదానోం తీతమపి స్వసఙ్గినమ్ అకరవం|</para>
  <para style="p">
    <verse number="2" style="v"/>తత్కాలేఽహమ్ ఈశ్వరదర్శనాద్ యాత్రామ్ అకరవం మయా యః పరిశ్రమోఽకారి కారిష్యతే వా స యన్నిష్ఫలో న భవేత్ తదర్థం భిన్నజాతీయానాం మధ్యే మయా ఘోష్యమాణః సుసంవాదస్తత్రత్యేభ్యో లోకేభ్యో విశేషతో మాన్యేభ్యో నరేభ్యో మయా న్యవేద్యత|</para>
  <para style="p">
    <verse number="3" style="v"/>తతో మమ సహచరస్తీతో యద్యపి యూనానీయ ఆసీత్ తథాపి తస్య త్వక్ఛేదోఽప్యావశ్యకో న బభూవ|</para>
  <para style="p">
    <verse number="4" style="v"/>యతశ్ఛలేనాగతా అస్మాన్ దాసాన్ కర్త్తుమ్ ఇచ్ఛవః కతిపయా భాక్తభ్రాతరః ఖ్రీష్టేన యీశునాస్మభ్యం దత్తం స్వాతన్త్ర్యమ్ అనుసన్ధాతుం చారా ఇవ సమాజం ప్రావిశన్|</para>
  <para style="p">
    <verse number="5" style="v"/>అతః ప్రకృతే సుసంవాదే యుష్మాకమ్ అధికారో యత్ తిష్ఠేత్ తదర్థం వయం దణ్డైకమపి యావద్ ఆజ్ఞాగ్రహణేన తేషాం వశ్యా నాభవామ|</para>
  <para style="p">
    <verse number="6" style="v"/>పరన్తు యే లోకా మాన్యాస్తే యే కేచిద్ భవేయుస్తానహం న గణయామి యత ఈశ్వరః కస్యాపి మానవస్య పక్షపాతం న కరోతి, యే చ మాన్యాస్తే మాం కిమపి నవీనం నాజ్ఞాపయన్|</para>
  <para style="p">
    <verse number="7" style="v"/>కిన్తు ఛిన్నత్వచాం మధ్యే సుసంవాదప్రచారణస్య భారః పితరి యథా సమర్పితస్తథైవాచ్ఛిన్నత్వచాం మధ్యే సుసంవాదప్రచారణస్య భారో మయి సమర్పిత ఇతి తై ర్బుబుధే|</para>
  <para style="p">
    <verse number="8" style="v"/>యతశ్ఛిన్నత్వచాం మధ్యే ప్రేరితత్వకర్మ్మణే యస్య యా శక్తిః పితరమాశ్రితవతీ తస్యైవ సా శక్తి ర్భిన్నజాతీయానాం మధ్యే తస్మై కర్మ్మణే మామప్యాశ్రితవతీ|</para>
  <para style="p">
    <verse number="9" style="v"/>అతో మహ్యం దత్తమ్ అనుగ్రహం ప్రతిజ్ఞాయ స్తమ్భా ఇవ గణితా యే యాకూబ్ కైఫా యోహన్ చైతే సహాయతాసూచకం దక్షిణహస్తగ్రహంణ విధాయ మాం బర్ణబ్బాఞ్చ జగదుః, యువాం భిన్నజాతీయానాం సన్నిధిం గచ్ఛతం వయం ఛిన్నత్వచా సన్నిధిం గచ్ఛామః,</para>
  <para style="p">
    <verse number="10" style="v"/>కేవలం దరిద్రా యువాభ్యాం స్మరణీయా ఇతి| అతస్తదేవ కర్త్తుమ్ అహం యతే స్మ|</para>
  <para style="p">
    <verse number="11" style="v"/>అపరమ్ ఆన్తియఖియానగరం పితర ఆగతేఽహం తస్య దోషిత్వాత్ సమక్షం తమ్ అభర్త్సయం|</para>
  <para style="p">
    <verse number="12" style="v"/>యతః స పూర్వ్వమ్ అన్యజాతీయైః సార్ద్ధమ్ ఆహారమకరోత్ తతః పరం యాకూబః సమీపాత్ కతిపయజనేష్వాగతేషు స ఛిన్నత్వఙ్మనుష్యేభ్యో భయేన నివృత్య పృథగ్ అభవత్|</para>
  <para style="p">
    <verse number="13" style="v"/>తతోఽపరే సర్వ్వే యిహూదినోఽపి తేన సార్ద్ధం కపటాచారమ్ అకుర్వ్వన్ బర్ణబ్బా అపి తేషాం కాపట్యేన విపథగామ్యభవత్|</para>
  <para style="p">
    <verse number="14" style="v"/>తతస్తే ప్రకృతసుసంవాదరూపే సరలపథే న చరన్తీతి దృష్ట్వాహం సర్వ్వేషాం సాక్షాత్ పితరమ్ ఉక్తవాన్ త్వం యిహూదీ సన్ యది యిహూదిమతం విహాయ భిన్నజాతీయ ఇవాచరసి తర్హి యిహూదిమతాచరణాయ భిన్నజాతీయాన్ కుతః ప్రవర్త్తయసి?</para>
  <para style="p">
    <verse number="15" style="v"/>ఆవాం జన్మనా యిహూదినౌ భవావో భిన్నజాతీయౌ పాపినౌ న భవావః</para>
  <para style="p">
    <verse number="16" style="v"/>కిన్తు వ్యవస్థాపాలనేన మనుష్యః సపుణ్యో న భవతి కేవలం యీశౌ ఖ్రీష్టే యో విశ్వాసస్తేనైవ సపుణ్యో భవతీతి బుద్ధ్వావామపి వ్యవస్థాపాలనం వినా కేవలం ఖ్రీష్టే విశ్వాసేన పుణ్యప్రాప్తయే ఖ్రీష్టే యీశౌ వ్యశ్వసివ యతో వ్యవస్థాపాలనేన కోఽపి మానవః పుణ్యం ప్రాప్తుం న శక్నోతి|</para>
  <para style="p">
    <verse number="17" style="v"/>పరన్తు యీశునా పుణ్యప్రాప్తయే యతమానావప్యావాం యది పాపినౌ భవావస్తర్హి కిం వక్తవ్యం? ఖ్రీష్టః పాపస్య పరిచారక ఇతి? తన్న భవతు|</para>
  <para style="p">
    <verse number="18" style="v"/>మయా యద్ భగ్నం తద్ యది మయా పునర్నిర్మ్మీయతే తర్హి మయైవాత్మదోషః ప్రకాశ్యతే|</para>
  <para style="p">
    <verse number="19" style="v"/>అహం యద్ ఈశ్వరాయ జీవామి తదర్థం వ్యవస్థయా వ్యవస్థాయై అమ్రియే|</para>
  <para style="p">
    <verse number="20" style="v"/>ఖ్రీష్టేన సార్ద్ధం క్రుశే హతోఽస్మి తథాపి జీవామి కిన్త్వహం జీవామీతి నహి ఖ్రీష్ట ఏవ మదన్త ర్జీవతి| సామ్ప్రతం సశరీరేణ మయా యజ్జీవితం ధార్య్యతే తత్ మమ దయాకారిణి మదర్థం స్వీయప్రాణత్యాగిని చేశ్వరపుత్రే విశ్వసతా మయా ధార్య్యతే|</para>
  <para style="p">
    <verse number="21" style="v"/>అహమీశ్వరస్యానుగ్రహం నావజానామి యస్మాద్ వ్యవస్థయా యది పుణ్యం భవతి తర్హి ఖ్రీష్టో నిరర్థకమమ్రియత|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>హే నిర్బ్బోధా గాలాతిలోకాః, యుష్మాకం మధ్యే క్రుశే హత ఇవ యీశుః ఖ్రీష్టో యుష్మాకం సమక్షం ప్రకాశిత ఆసీత్ అతో యూయం యథా సత్యం వాక్యం న గృహ్లీథ తథా కేనాముహ్యత?</para>
  <para style="p">
    <verse number="2" style="v"/>అహం యుష్మత్తః కథామేకాం జిజ్ఞాసే యూయమ్ ఆత్మానం కేనాలభధ్వం? వ్యవస్థాపాలనేన కిం వా విశ్వాసవాక్యస్య శ్రవణేన?</para>
  <para style="p">
    <verse number="3" style="v"/>యూయం కిమ్ ఈదృగ్ అబోధా యద్ ఆత్మనా కర్మ్మారభ్య శరీరేణ తత్ సాధయితుం యతధ్వే?</para>
  <para style="p">
    <verse number="4" style="v"/>తర్హి యుష్మాకం గురుతరో దుఃఖభోగః కిం నిష్ఫలో భవిష్యతి? కుఫలయుక్తో వా కిం భవిష్యతి?</para>
  <para style="p">
    <verse number="5" style="v"/>యో యుష్మభ్యమ్ ఆత్మానం దత్తవాన్ యుష్మన్మధ్య ఆశ్చర్య్యాణి కర్మ్మాణి చ సాధితవాన్ స కిం వ్యవస్థాపాలనేన విశ్వాసవాక్యస్య శ్రవణేన వా తత్ కృతవాన్?</para>
  <para style="p">
    <verse number="6" style="v"/>లిఖితమాస్తే, ఇబ్రాహీమ ఈశ్వరే వ్యశ్వసీత్ స చ విశ్వాసస్తస్మై పుణ్యార్థం గణితో బభూవ,</para>
  <para style="p">
    <verse number="7" style="v"/>అతో యే విశ్వాసాశ్రితాస్త ఏవేబ్రాహీమః సన్తానా ఇతి యుష్మాభి ర్జ్ఞాయతాం|</para>
  <para style="p">
    <verse number="8" style="v"/>ఈశ్వరో భిన్నజాతీయాన్ విశ్వాసేన సపుణ్యీకరిష్యతీతి పూర్వ్వం జ్ఞాత్వా శాస్త్రదాతా పూర్వ్వమ్ ఇబ్రాహీమం సుసంవాదం శ్రావయన జగాద, త్వత్తో భిన్నజాతీయాః సర్వ్వ ఆశిషం ప్రాప్స్యన్తీతి|</para>
  <para style="p">
    <verse number="9" style="v"/>అతో యే విశ్వాసాశ్రితాస్తే విశ్వాసినేబ్రాహీమా సార్ద్ధమ్ ఆశిషం లభన్తే|</para>
  <para style="p">
    <verse number="10" style="v"/>యావన్తో లోకా వ్యవస్థాయాః కర్మ్మణ్యాశ్రయన్తి తే సర్వ్వే శాపాధీనా భవన్తి యతో లిఖితమాస్తే, యథా, "యః కశ్చిద్ ఏతస్య వ్యవస్థాగ్రన్థస్య సర్వ్వవాక్యాని నిశ్చిద్రం న పాలయతి స శప్త ఇతి| "</para>
  <para style="p">
    <verse number="11" style="v"/>ఈశ్వరస్య సాక్షాత్ కోఽపి వ్యవస్థయా సపుణ్యో న భవతి తద వ్యక్తం యతః "పుణ్యవాన్ మానవో విశ్వాసేన జీవిష్యతీతి" శాస్త్రీయం వచః|</para>
  <para style="p">
    <verse number="12" style="v"/>వ్యవస్థా తు విశ్వాససమ్బన్ధినీ న భవతి కిన్త్వేతాని యః పాలయిష్యతి స ఏవ తై ర్జీవిష్యతీతినియమసమ్బన్ధినీ|</para>
  <para style="p">
    <verse number="13" style="v"/>ఖ్రీష్టోఽస్మాన్ పరిక్రీయ వ్యవస్థాయాః శాపాత్ మోచితవాన్ యతోఽస్మాకం వినిమయేన స స్వయం శాపాస్పదమభవత్ తదధి లిఖితమాస్తే, యథా, "యః కశ్చిత్ తరావుల్లమ్బ్యతే సోఽభిశప్త ఇతి| "</para>
  <para style="p">
    <verse number="14" style="v"/>తస్మాద్ ఖ్రీష్టేన యీశునేవ్రాహీమ ఆశీ ర్భిన్నజాతీయలోకేషు వర్త్తతే తేన వయం ప్రతిజ్ఞాతమ్ ఆత్మానం విశ్వాసేన లబ్ధుం శక్నుమః|</para>
  <para style="p">
    <verse number="15" style="v"/>హే భ్రాతృగణ మానుషాణాం రీత్యనుసారేణాహం కథయామి కేనచిత్ మానవేన యో నియమో నిరచాయి తస్య వికృతి ర్వృద్ధి ర్వా కేనాపి న క్రియతే|</para>
  <para style="p">
    <verse number="16" style="v"/>పరన్త్విబ్రాహీమే తస్య సన్తానాయ చ ప్రతిజ్ఞాః ప్రతి శుశ్రువిరే తత్ర సన్తానశబ్దం బహువచనాన్తమ్ అభూత్వా తవ సన్తానాయేత్యేకవచనాన్తం బభూవ స చ సన్తానః ఖ్రీష్ట ఏవ|</para>
  <para style="p">
    <verse number="17" style="v"/>అతఏవాహం వదామి, ఈశ్వరేణ యో నియమః పురా ఖ్రీష్టమధి నిరచాయి తతః పరం త్రింశదధికచతుఃశతవత్సరేషు గతేషు స్థాపితా వ్యవస్థా తం నియమం నిరర్థకీకృత్య తదీయప్రతిజ్ఞా లోప్తుం న శక్నోతి|</para>
  <para style="p">
    <verse number="18" style="v"/>యస్మాత్ సమ్పదధికారో యది వ్యవస్థయా భవతి తర్హి ప్రతిజ్ఞయా న భవతి కిన్త్వీశ్వరః ప్రతిజ్ఞయా తదధికారిత్వమ్ ఇబ్రాహీమే ఽదదాత్|</para>
  <para style="p">
    <verse number="19" style="v"/>తర్హి వ్యవస్థా కిమ్భూతా? ప్రతిజ్ఞా యస్మై ప్రతిశ్రుతా తస్య సన్తానస్యాగమనం యావద్ వ్యభిచారనివారణార్థం వ్యవస్థాపి దత్తా, సా చ దూతైరాజ్ఞాపితా మధ్యస్థస్య కరే సమర్పితా చ|</para>
  <para style="p">
    <verse number="20" style="v"/>నైకస్య మధ్యస్థో విద్యతే కిన్త్వీశ్వర ఏక ఏవ|</para>
  <para style="p">
    <verse number="21" style="v"/>తర్హి వ్యవస్థా కిమ్ ఈశ్వరస్య ప్రతిజ్ఞానాం విరుద్ధా? తన్న భవతు| యస్మాద్ యది సా వ్యవస్థా జీవనదానేసమర్థాభవిష్యత్ తర్హి వ్యవస్థయైవ పుణ్యలాభోఽభవిష్యత్|</para>
  <para style="p">
    <verse number="22" style="v"/>కిన్తు యీశుఖ్రీష్టే యో విశ్వాసస్తత్సమ్బన్ధియాః ప్రతిజ్ఞాయాః ఫలం యద్ విశ్వాసిలోకేభ్యో దీయతే తదర్థం శాస్త్రదాతా సర్వ్వాన్ పాపాధీనాన్ గణయతి|</para>
  <para style="p">
    <verse number="23" style="v"/>అతఏవ విశ్వాసస్యానాగతసమయే వయం వ్యవస్థాధీనాః సన్తో విశ్వాసస్యోదయం యావద్ రుద్ధా ఇవారక్ష్యామహే|</para>
  <para style="p">
    <verse number="24" style="v"/>ఇత్థం వయం యద్ విశ్వాసేన సపుణ్యీభవామస్తదర్థం ఖ్రీష్టస్య సమీపమ్ అస్మాన్ నేతుం వ్యవస్థాగ్రథోఽస్మాకం వినేతా బభూవ|</para>
  <para style="p">
    <verse number="25" style="v"/>కిన్త్వధునాగతే విశ్వాసే వయం తస్య వినేతురనధీనా అభవామ|</para>
  <para style="p">
    <verse number="26" style="v"/>ఖ్రీష్టే యీశౌ విశ్వసనాత్ సర్వ్వే యూయమ్ ఈశ్వరస్య సన్తానా జాతాః|</para>
  <para style="p">
    <verse number="27" style="v"/>యూయం యావన్తో లోకాః ఖ్రీష్టే మజ్జితా అభవత సర్వ్వే ఖ్రీష్టం పరిహితవన్తః|</para>
  <para style="p">
    <verse number="28" style="v"/>అతో యుష్మన్మధ్యే యిహూదియూనానినో ర్దాసస్వతన్త్రయో ర్యోషాపురుషయోశ్చ కోఽపి విశేషో నాస్తి; సర్వ్వే యూయం ఖ్రీష్టే యీశావేక ఏవ|</para>
  <para style="p">
    <verse number="29" style="v"/>కిఞ్చ యూయం యది ఖ్రీష్టస్య భవథ తర్హి సుతరామ్ ఇబ్రాహీమః సన్తానాః ప్రతిజ్ఞయా సమ్పదధికారిణశ్చాధ్వే|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అహం వదామి సమ్పదధికారీ యావద్ బాలస్తిష్ఠతి తావత్ సర్వ్వస్వస్యాధిపతిః సన్నపి స దాసాత్ కేనాపి విషయేణ న విశిష్యతే</para>
  <para style="p">
    <verse number="2" style="v"/>కిన్తు పిత్రా నిరూపితం సమయం యావత్ పాలకానాం ధనాధ్యక్షాణాఞ్చ నిఘ్నస్తిష్ఠతి|</para>
  <para style="p">
    <verse number="3" style="v"/>తద్వద్ వయమపి బాల్యకాలే దాసా ఇవ సంసారస్యాక్షరమాలాయా అధీనా ఆస్మహే|</para>
  <para style="p">
    <verse number="4" style="v"/>అనన్తరం సమయే సమ్పూర్ణతాం గతవతి వ్యవస్థాధీనానాం మోచనార్థమ్</para>
  <para style="p">
    <verse number="5" style="v"/>అస్మాకం పుత్రత్వప్రాప్త్యర్థఞ్చేశ్వరః స్త్రియా జాతం వ్యవస్థాయా అధినీభూతఞ్చ స్వపుత్రం ప్రేషితవాన్|</para>
  <para style="p">
    <verse number="6" style="v"/>యూయం సన్తానా అభవత తత్కారణాద్ ఈశ్వరః స్వపుత్రస్యాత్మానాం యుష్మాకమ్ అన్తఃకరణాని ప్రహితవాన్ స చాత్మా పితః పితరిత్యాహ్వానం కారయతి|</para>
  <para style="p">
    <verse number="7" style="v"/>అత ఇదానీం యూయం న దాసాః కిన్తుః సన్తానా ఏవ తస్మాత్ సన్తానత్వాచ్చ ఖ్రీష్టేనేశ్వరీయసమ్పదధికారిణోఽప్యాధ్వే|</para>
  <para style="p">
    <verse number="8" style="v"/>అపరఞ్చ పూర్వ్వం యూయమ్ ఈశ్వరం న జ్ఞాత్వా యే స్వభావతోఽనీశ్వరాస్తేషాం దాసత్వేఽతిష్ఠత|</para>
  <para style="p">
    <verse number="9" style="v"/>ఇదానీమ్ ఈశ్వరం జ్ఞాత్వా యది వేశ్వరేణ జ్ఞాతా యూయం కథం పునస్తాని విఫలాని తుచ్ఛాని చాక్షరాణి ప్రతి పరావర్త్తితుం శక్నుథ? యూయం కిం పునస్తేషాం దాసా భవితుమిచ్ఛథ?</para>
  <para style="p">
    <verse number="10" style="v"/>యూయం దివసాన్ మాసాన్ తిథీన్ సంవత్సరాంశ్చ సమ్మన్యధ్వే|</para>
  <para style="p">
    <verse number="11" style="v"/>యుష్మదర్థం మయా యః పరిశ్రమోఽకారి స విఫలో జాత ఇతి యుష్మానధ్యహం బిభేమి|</para>
  <para style="p">
    <verse number="12" style="v"/>హే భ్రాతరః, అహం యాదృశోఽస్మి యూయమపి తాదృశా భవతేతి ప్రార్థయే యతోఽహమపి యుష్మత్తుల్యోఽభవం యుష్మాభి ర్మమ కిమపి నాపరాద్ధం|</para>
  <para style="p">
    <verse number="13" style="v"/>పూర్వ్వమహం కలేవరస్య దౌర్బ్బల్యేన యుష్మాన్ సుసంవాదమ్ అజ్ఞాపయమితి యూయం జానీథ|</para>
  <para style="p">
    <verse number="14" style="v"/>తదానీం మమ పరీక్షకం శారీరక్లేశం దృష్ట్వా యూయం మామ్ అవజ్ఞాయ ఋతీయితవన్తస్తన్నహి కిన్త్వీశ్వరస్య దూతమివ సాక్షాత్ ఖ్రీష్ట యీశుమివ వా మాం గృహీతవన్తః|</para>
  <para style="p">
    <verse number="15" style="v"/>అతస్తదానీం యుష్మాకం యా ధన్యతాభవత్ సా క్క గతా? తదానీం యూయం యది స్వేషాం నయనాన్యుత్పాట్య మహ్యం దాతుమ్ అశక్ష్యత తర్హి తదప్యకరిష్యతేతి ప్రమాణమ్ అహం దదామి|</para>
  <para style="p">
    <verse number="16" style="v"/>సామ్ప్రతమహం సత్యవాదిత్వాత్ కిం యుష్మాకం రిపు ర్జాతోఽస్మి?</para>
  <para style="p">
    <verse number="17" style="v"/>తే యుష్మత్కృతే స్పర్ద్ధన్తే కిన్తు సా స్పర్ద్ధా కుత్సితా యతో యూయం తానధి యత్ స్పర్ద్ధధ్వం తదర్థం తే యుష్మాన్ పృథక్ కర్త్తుమ్ ఇచ్ఛన్తి|</para>
  <para style="p">
    <verse number="18" style="v"/>కేవలం యుష్మత్సమీపే మమోపస్థితిసమయే తన్నహి, కిన్తు సర్వ్వదైవ భద్రమధి స్పర్ద్ధనం భద్రం|</para>
  <para style="p">
    <verse number="19" style="v"/>హే మమ బాలకాః, యుష్మదన్త ర్యావత్ ఖ్రీష్టో మూర్తిమాన్ న భవతి తావద్ యుష్మత్కారణాత్ పునః ప్రసవవేదనేవ మమ వేదనా జాయతే|</para>
  <para style="p">
    <verse number="20" style="v"/>అహమిదానీం యుష్మాకం సన్నిధిం గత్వా స్వరాన్తరేణ యుష్మాన్ సమ్భాషితుం కామయే యతో యుష్మానధి వ్యాకులోఽస్మి|</para>
  <para style="p">
    <verse number="21" style="v"/>హే వ్యవస్థాధీనతాకాఙ్క్షిణః యూయం కిం వ్యవస్థాయా వచనం న గృహ్లీథ?</para>
  <para style="p">
    <verse number="22" style="v"/>తన్మాం వదత| లిఖితమాస్తే, ఇబ్రాహీమో ద్వౌ పుత్రావాసాతే తయోరేకో దాస్యాం ద్వితీయశ్చ పత్న్యాం జాతః|</para>
  <para style="p">
    <verse number="23" style="v"/>తయో ర్యో దాస్యాం జాతః స శారీరికనియమేన జజ్ఞే యశ్చ పత్న్యాం జాతః స ప్రతిజ్ఞయా జజ్ఞే|</para>
  <para style="p">
    <verse number="24" style="v"/>ఇదమాఖ్యానం దృష్టన్తస్వరూపం| తే ద్వే యోషితావీశ్వరీయసన్ధీ తయోరేకా సీనయపర్వ్వతాద్ ఉత్పన్నా దాసజనయిత్రీ చ సా తు హాజిరా|</para>
  <para style="p">
    <verse number="25" style="v"/>యస్మాద్ హాజిరాశబ్దేనారవదేశస్థసీనయపర్వ్వతో బోధ్యతే, సా చ వర్త్తమానాయా యిరూశాలమ్పుర్య్యాః సదృశీ| యతః స్వబాలైః సహితా సా దాసత్వ ఆస్తే|</para>
  <para style="p">
    <verse number="26" style="v"/>కిన్తు స్వర్గీయా యిరూశాలమ్పురీ పత్నీ సర్వ్వేషామ్ అస్మాకం మాతా చాస్తే|</para>
  <para style="p">
    <verse number="27" style="v"/>యాదృశం లిఖితమ్ ఆస్తే, "వన్ధ్యే సన్తానహీనే త్వం స్వరం జయజయం కురు| అప్రసూతే త్వయోల్లాసో జయాశబ్దశ్చ గీయతాం| యత ఏవ సనాథాయా యోషితః సన్తతే ర్గణాత్| అనాథా యా భవేన్నారీ తదపత్యాని భూరిశః|| "</para>
  <para style="p">
    <verse number="28" style="v"/>హే భ్రాతృగణ, ఇమ్హాక్ ఇవ వయం ప్రతిజ్ఞయా జాతాః సన్తానాః|</para>
  <para style="p">
    <verse number="29" style="v"/>కిన్తు తదానీం శారీరికనియమేన జాతః పుత్రో యద్వద్ ఆత్మికనియమేన జాతం పుత్రమ్ ఉపాద్రవత్ తథాధునాపి|</para>
  <para style="p">
    <verse number="30" style="v"/>కిన్తు శాస్త్రే కిం లిఖితం? "త్వమ్ ఇమాం దాసీం తస్యాః పుత్రఞ్చాపసారయ యత ఏష దాసీపుత్రః పత్నీపుత్రేణ సమం నోత్తరాధికారీ భవియ్యతీతి| "</para>
  <para style="p">
    <verse number="31" style="v"/>అతఏవ హే భ్రాతరః, వయం దాస్యాః సన్తానా న భూత్వా పాత్న్యాః సన్తానా భవామః|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ఖ్రీష్టోఽస్మభ్యం యత్ స్వాతన్త్ర్యం దత్తవాన్ యూయం తత్ర స్థిరాస్తిష్ఠత దాసత్వయుగేన పున ర్న నిబధ్యధ్వం|</para>
  <para style="p">
    <verse number="2" style="v"/>పశ్యతాహం పౌలో యుష్మాన్ వదామి యది ఛిన్నత్వచో భవథ తర్హి ఖ్రీష్టేన కిమపి నోపకారిష్యధ్వే|</para>
  <para style="p">
    <verse number="3" style="v"/>అపరం యః కశ్చిత్ ఛిన్నత్వగ్ భవతి స కృత్స్నవ్యవస్థాయాః పాలనమ్ ఈశ్వరాయ ధారయతీతి ప్రమాణం దదామి|</para>
  <para style="p">
    <verse number="4" style="v"/>యుష్మాకం యావన్తో లోకా వ్యవస్థయా సపుణ్యీభవితుం చేష్టన్తే తే సర్వ్వే ఖ్రీష్టాద్ భ్రష్టా అనుగ్రహాత్ పతితాశ్చ|</para>
  <para style="p">
    <verse number="5" style="v"/>యతో వయమ్ ఆత్మనా విశ్వాసాత్ పుణ్యలాభాశాసిద్ధం ప్రతీక్షామహే|</para>
  <para style="p">
    <verse number="6" style="v"/>ఖ్రీష్టే యీశౌ త్వక్ఛేదాత్వక్ఛేదయోః కిమపి గుణం నాస్తి కిన్తు ప్రేమ్నా సఫలో విశ్వాస ఏవ గుణయుక్తః|</para>
  <para style="p">
    <verse number="7" style="v"/>పూర్వ్వం యూయం సున్దరమ్ అధావత కిన్త్విదానీం కేన బాధాం ప్రాప్య సత్యతాం న గృహ్లీథ?</para>
  <para style="p">
    <verse number="8" style="v"/>యుష్మాకం సా మతి ర్యుష్మదాహ్వానకారిణ ఈశ్వరాన్న జాతా|</para>
  <para style="p">
    <verse number="9" style="v"/>వికారః కృత్స్నశక్తూనాం స్వల్పకిణ్వేన జసయతే|</para>
  <para style="p">
    <verse number="10" style="v"/>యుష్మాకం మతి ర్వికారం న గమిష్యతీత్యహం యుష్మానధి ప్రభునాశంసే; కిన్తు యో యుష్మాన్ విచారలయతి స యః కశ్చిద్ భవేత్ సముచితం దణ్డం ప్రాప్స్యతి|</para>
  <para style="p">
    <verse number="11" style="v"/>పరన్తు హే భ్రాతరః, యద్యహమ్ ఇదానీమ్ అపి త్వక్ఛేదం ప్రచారయేయం తర్హి కుత ఉపద్రవం భుఞ్జియ? తత్కృతే క్రుశం నిర్బ్బాధమ్ అభవిష్యత్|</para>
  <para style="p">
    <verse number="12" style="v"/>యే జనా యుష్మాకం చాఞ్చల్యం జనయన్తి తేషాం ఛేదనమేవ మయాభిలష్యతే|</para>
  <para style="p">
    <verse number="13" style="v"/>హే భ్రాతరః, యూయం స్వాతన్త్ర్యార్థమ్ ఆహూతా ఆధ్వే కిన్తు తత్స్వాతన్త్ర్యద్వారేణ శారీరికభావో యుష్మాన్ న ప్రవిశతు| యూయం ప్రేమ్నా పరస్పరం పరిచర్య్యాం కురుధ్వం|</para>
  <para style="p">
    <verse number="14" style="v"/>యస్మాత్ త్వం సమీపవాసిని స్వవత్ ప్రేమ కుర్య్యా ఇత్యేకాజ్ఞా కృత్స్నాయా వ్యవస్థాయాః సారసంగ్రహః|</para>
  <para style="p">
    <verse number="15" style="v"/>కిన్తు యూయం యది పరస్పరం దందశ్యధ్వే ఽశాశ్యధ్వే చ తర్హి యుష్మాకమ్ ఏకోఽన్యేన యన్న గ్రస్యతే తత్ర యుష్మాభిః సావధానై ర్భవితవ్యం|</para>
  <para style="p">
    <verse number="16" style="v"/>అహం బ్రవీమి యూయమ్ ఆత్మికాచారం కురుత శారీరికాభిలాషం మా పూరయత|</para>
  <para style="p">
    <verse number="17" style="v"/>యతః శారీరికాభిలాష ఆత్మనో విపరీతః, ఆత్మికాభిలాషశ్చ శరీరస్య విపరీతః, అనయోరుభయోః పరస్పరం విరోధో విద్యతే తేన యుష్మాభి ర్యద్ అభిలష్యతే తన్న కర్త్తవ్యం|</para>
  <para style="p">
    <verse number="18" style="v"/>యూయం యద్యాత్మనా వినీయధ్వే తర్హి వ్యవస్థాయా అధీనా న భవథ|</para>
  <para style="p">
    <verse number="19" style="v"/>అపరం పరదారగమనం వేశ్యాగమనమ్ అశుచితా కాముకతా ప్రతిమాపూజనమ్</para>
  <para style="p">
    <verse number="20" style="v"/>ఇన్ద్రజాలం శత్రుత్వం వివాదోఽన్తర్జ్వలనం క్రోధః కలహోఽనైక్యం</para>
  <para style="p">
    <verse number="21" style="v"/>పార్థక్యమ్ ఈర్ష్యా వధో మత్తత్వం లమ్పటత్వమిత్యాదీని స్పష్టత్వేన శారీరికభావస్య కర్మ్మాణి సన్తి| పూర్వ్వం యద్వత్ మయా కథితం తద్వత్ పునరపి కథ్యతే యే జనా ఏతాదృశాని కర్మ్మాణ్యాచరన్తి తైరీశ్వరస్య రాజ్యేఽధికారః కదాచ న లప్స్యతే|</para>
  <para style="p">
    <verse number="22" style="v"/>కిఞ్చ ప్రేమానన్దః శాన్తిశ్చిరసహిష్ణుతా హితైషితా భద్రత్వం విశ్వాస్యతా తితిక్షా</para>
  <para style="p">
    <verse number="23" style="v"/>పరిమితభోజిత్వమిత్యాదీన్యాత్మనః ఫలాని సన్తి తేషాం విరుద్ధా కాపి వ్యవస్థా నహి|</para>
  <para style="p">
    <verse number="24" style="v"/>యే తు ఖ్రీష్టస్య లోకాస్తే రిపుభిరభిలాషైశ్చ సహితం శారీరికభావం క్రుశే నిహతవన్తః|</para>
  <para style="p">
    <verse number="25" style="v"/>యది వయమ్ ఆత్మనా జీవామస్తర్హ్యాత్మికాచారోఽస్మాభిః కర్త్తవ్యః,</para>
  <para style="p">
    <verse number="26" style="v"/>దర్పః పరస్పరం నిర్భర్త్సనం ద్వేషశ్చాస్మాభి ర్న కర్త్తవ్యాని|</para>
  <chapter number="6" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>హే భ్రాతరః, యుష్మాకం కశ్చిద్ యది కస్మింశ్చిత్ పాపే పతతి తర్హ్యాత్మికభావయుక్తై ర్యుష్మాభిస్తితిక్షాభావం విధాయ స పునరుత్థాప్యతాం యూయమపి యథా తాదృక్పరీక్షాయాం న పతథ తథా సావధానా భవత|</para>
  <para style="p">
    <verse number="2" style="v"/>యుష్మాకమ్ ఏకైకో జనః పరస్య భారం వహత్వనేన ప్రకారేణ ఖ్రీష్టస్య విధిం పాలయత|</para>
  <para style="p">
    <verse number="3" style="v"/>యది కశ్చన క్షుద్రః సన్ స్వం మహాన్తం మన్యతే తర్హి తస్యాత్మవఞ్చనా జాయతే|</para>
  <para style="p">
    <verse number="4" style="v"/>అత ఏకైకేన జనేన స్వకీయకర్మ్మణః పరీక్షా క్రియతాం తేన పరం నాలోక్య కేవలమ్ ఆత్మాలోకనాత్ తస్య శ్లఘా సమ్భవిష్యతి|</para>
  <para style="p">
    <verse number="5" style="v"/>యత ఏకైకోे జనః స్వకీయం భారం వక్ష్యతి|</para>
  <para style="p">
    <verse number="6" style="v"/>యో జనో ధర్మ్మోపదేశం లభతే స ఉపదేష్టారం స్వీయసర్వ్వసమ్పత్తే ర్భాగినం కరోతు|</para>
  <para style="p">
    <verse number="7" style="v"/>యుష్మాకం భ్రాన్తి ర్న భవతు, ఈశ్వరో నోపహసితవ్యః, యేన యద్ బీజమ్ ఉప్యతే తేన తజ్జాతం శస్యం కర్త్తిష్యతే|</para>
  <para style="p">
    <verse number="8" style="v"/>స్వశరీరార్థం యేన బీజమ్ ఉప్యతే తేన శరీరాద్ వినాశరూపం శస్యం లప్స్యతే కిన్త్వాత్మనః కృతే యేన బీజమ్ ఉప్యతే తేనాత్మతోఽనన్తజీవితరూపం శస్యం లప్స్యతే|</para>
  <para style="p">
    <verse number="9" style="v"/>సత్కర్మ్మకరణేఽస్మాభిరశ్రాన్తై ర్భవితవ్యం యతోఽక్లాన్తౌస్తిష్ఠద్భిరస్మాభిరుపయుక్తసమయే తత్ ఫలాని లప్స్యన్తే|</para>
  <para style="p">
    <verse number="10" style="v"/>అతో యావత్ సమయస్తిష్ఠతి తావత్ సర్వ్వాన్ ప్రతి విశేషతో విశ్వాసవేశ్మవాసినః ప్రత్యస్మాభి ర్హితాచారః కర్త్తవ్యః|</para>
  <para style="p">
    <verse number="11" style="v"/>హే భ్రాతరః, అహం స్వహస్తేన యుష్మాన్ ప్రతి కియద్వృహత్ పత్రం లిఖితవాన్ తద్ యుష్మాభి ర్దృశ్యతాం|</para>
  <para style="p">
    <verse number="12" style="v"/>యే శారీరికవిషయే సుదృశ్యా భవితుమిచ్ఛన్తి తే యత్ ఖ్రీష్టస్య క్రుశస్య కారణాదుపద్రవస్య భాగినో న భవన్తి కేవలం తదర్థం త్వక్ఛేదే యుష్మాన్ ప్రవర్త్తయన్తి|</para>
  <para style="p">
    <verse number="13" style="v"/>తే త్వక్ఛేదగ్రాహిణోఽపి వ్యవస్థాం న పాలయన్తి కిన్తు యుష్మచ్ఛరీరాత్ శ్లాఘాలాభార్థం యుష్మాకం త్వక్ఛేదమ్ ఇచ్ఛన్తి|</para>
  <para style="p">
    <verse number="14" style="v"/>కిన్తు యేనాహం సంసారాయ హతః సంసారోఽపి మహ్యం హతస్తదస్మత్ప్రభో ర్యీశుఖ్రీష్టస్య క్రుశం వినాన్యత్ర కుత్రాపి మమ శ్లాఘనం కదాపి న భవతు|</para>
  <para style="p">
    <verse number="15" style="v"/>ఖ్రీష్టే యీశౌ త్వక్ఛేదాత్వక్ఛేదయోః కిమపి గుణం నాస్తి కిన్తు నవీనా సృష్టిరేవ గుణయుక్తా|</para>
  <para style="p">
    <verse number="16" style="v"/>అపరం యావన్తో లోకా ఏతస్మిన్ మార్గే చరన్తి తేషామ్ ఈశ్వరీయస్య కృత్స్నస్యేస్రాయేలశ్చ శాన్తి ర్దయాలాభశ్చ భూయాత్|</para>
  <para style="p">
    <verse number="17" style="v"/>ఇతః పరం కోఽపి మాం న క్లిశ్నాతు యస్మాద్ అహం స్వగాత్రే ప్రభో ర్యీశుఖ్రీష్టస్య చిహ్నాని ధారయే|</para>
  <para style="p">
    <verse number="18" style="v"/>హే భ్రాతరః అస్మాకం ప్రభో ర్యీశుఖ్రీష్టస్య ప్రసాదో యుష్మాకమ్ ఆత్మని స్థేయాత్| తథాస్తు|</para>
</usx>
