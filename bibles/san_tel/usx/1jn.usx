<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="1JN" style="id">Sanskrit Bible (NT) in Telugu Script (సత్యవేదః।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">1 John</para>
  <para style="toc1">1 యోహనః పత్రం</para>
  <para style="toc2">1 యోహనః</para>
  <para style="toc3">1 యోహనః</para>
  <para style="mt1">1 యోహనః పత్రం</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ఆదితో య ఆసీద్ యస్య వాగ్ అస్మాభిరశ్రావి యఞ్చ వయం స్వనేత్రై ర్దృష్టవన్తో యఞ్చ వీక్షితవన్తః స్వకరైః స్పృష్టవన్తశ్చ తం జీవనవాదం వయం జ్ఞాపయామః|</para>
  <para style="p">
    <verse number="2" style="v"/>స జీవనస్వరూపః ప్రకాశత వయఞ్చ తం దృష్టవన్తస్తమధి సాక్ష్యం దద్మశ్చ, యశ్చ పితుః సన్నిధావవర్త్తతాస్మాకం సమీపే ప్రకాశత చ తమ్ అనన్తజీవనస్వరూపం వయం యుష్మాన్ జ్ఞాపయామః|</para>
  <para style="p">
    <verse number="3" style="v"/>అస్మాభి ర్యద్ దృష్టం శ్రుతఞ్చ తదేవ యుష్మాన్ జ్ఞాప్యతే తేనాస్మాభిః సహాంశిత్వం యుష్మాకం భవిష్యతి| అస్మాకఞ్చ సహాంశిత్వం పిత్రా తత్పుత్రేణ యీశుఖ్రీష్టేన చ సార్ద్ధం భవతి|</para>
  <para style="p">
    <verse number="4" style="v"/>అపరఞ్చ యుష్మాకమ్ ఆనన్దో యత్ సమ్పూర్ణో భవేద్ తదర్థం వయమ్ ఏతాని లిఖామః|</para>
  <para style="p">
    <verse number="5" style="v"/>వయం యాం వార్త్తాం తస్మాత్ శ్రుత్వా యుష్మాన్ జ్ఞాపయామః సేయమ్| ఈశ్వరో జ్యోతిస్తస్మిన్ అన్ధకారస్య లేశోఽపి నాస్తి|</para>
  <para style="p">
    <verse number="6" style="v"/>వయం తేన సహాంశిన ఇతి గదిత్వా యద్యన్ధాకారే చరామస్తర్హి సత్యాచారిణో న సన్తో ఽనృతవాదినో భవామః|</para>
  <para style="p">
    <verse number="7" style="v"/>కిన్తు స యథా జ్యోతిషి వర్త్తతే తథా వయమపి యది జ్యోతిషి చరామస్తర్హి పరస్పరం సహభాగినో భవామస్తస్య పుత్రస్య యీశుఖ్రీష్టస్య రుధిరఞ్చాస్మాన్ సర్వ్వస్మాత్ పాపాత్ శుద్ధయతి|</para>
  <para style="p">
    <verse number="8" style="v"/>వయం నిష్పాపా ఇతి యది వదామస్తర్హి స్వయమేవ స్వాన్ వఞ్చయామః సత్యమతఞ్చాస్మాకమ్ అన్తరే న విద్యతే|</para>
  <para style="p">
    <verse number="9" style="v"/>యది స్వపాపాని స్వీకుర్మ్మహే తర్హి స విశ్వాస్యో యాథార్థికశ్చాస్తి తస్మాద్ అస్మాకం పాపాని క్షమిష్యతే సర్వ్వస్మాద్ అధర్మ్మాచ్చాస్మాన్ శుద్ధయిష్యతి|</para>
  <para style="p">
    <verse number="10" style="v"/>వయమ్ అకృతపాపా ఇతి యది వదామస్తర్హి తమ్ అనృతవాదినం కుర్మ్మస్తస్య వాక్యఞ్చాస్మాకమ్ అన్తరే న విద్యతే|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>హే ప్రియబాలకాః, యుష్మాభి ర్యత్ పాపం న క్రియేత తదర్థం యుష్మాన్ ప్రత్యేతాని మయా లిఖ్యన్తే| యది తు కేనాపి పాపం క్రియతే తర్హి పితుః సమీపే ఽస్మాకం ఏకః సహాయో ఽర్థతో ధార్మ్మికో యీశుః ఖ్రీష్టో విద్యతే|</para>
  <para style="p">
    <verse number="2" style="v"/>స చాస్మాకం పాపానాం ప్రాయశ్చిత్తం కేవలమస్మాకం నహి కిన్తు లిఖిలసంసారస్య పాపానాం ప్రాయశ్చిత్తం|</para>
  <para style="p">
    <verse number="3" style="v"/>వయం తం జానీమ ఇతి తదీయాజ్ఞాపాలనేనావగచ్ఛామః|</para>
  <para style="p">
    <verse number="4" style="v"/>అహం తం జానామీతి వదిత్వా యస్తస్యాజ్ఞా న పాలయతి సో ఽనృతవాదీ సత్యమతఞ్చ తస్యాన్తరే న విద్యతే|</para>
  <para style="p">
    <verse number="5" style="v"/>యః కశ్చిత్ తస్య వాక్యం పాలయతి తస్మిన్ ఈశ్వరస్య ప్రేమ సత్యరూపేణ సిధ్యతి వయం తస్మిన్ వర్త్తామహే తద్ ఏతేనావగచ్ఛామః|</para>
  <para style="p">
    <verse number="6" style="v"/>అహం తస్మిన్ తిష్ఠామీతి యో గదతి తస్యేదమ్ ఉచితం యత్ ఖ్రీష్టో యాదృగ్ ఆచరితవాన్ సో ఽపి తాదృగ్ ఆచరేత్|</para>
  <para style="p">
    <verse number="7" style="v"/>హే ప్రియతమాః, యుష్మాన్ ప్రత్యహం నూతనామాజ్ఞాం లిఖామీతి నహి కిన్త్వాదితో యుష్మాభి ర్లబ్ధాం పురాతనామాజ్ఞాం లిఖామి| ఆదితో యుష్మాభి ర్యద్ వాక్యం శ్రుతం సా పురాతనాజ్ఞా|</para>
  <para style="p">
    <verse number="8" style="v"/>పునరపి యుష్మాన్ ప్రతి నూతనాజ్ఞా మయా లిఖ్యత ఏతదపి తస్మిన్ యుష్మాసు చ సత్యం, యతో ఽన్ధకారో వ్యత్యేతి సత్యా జ్యోతిశ్చేదానీం ప్రకాశతే;</para>
  <para style="p">
    <verse number="9" style="v"/>అహం జ్యోతిషి వర్త్త ఇతి గదిత్వా యః స్వభ్రాతరం ద్వేష్టి సో ఽద్యాపి తమిస్రే వర్త్తతే|</para>
  <para style="p">
    <verse number="10" style="v"/>స్వభ్రాతరి యః ప్రీయతే స ఏవ జ్యోతిషి వర్త్తతే విఘ్నజనకం కిమపి తస్మిన్ న విద్యతే|</para>
  <para style="p">
    <verse number="11" style="v"/>కిన్తు స్వభ్రాతరం యో ద్వేష్టి స తిమిరే వర్త్తతే తిమిరే చరతి చ తిమిరేణ చ తస్య నయనే ఽన్ధీక్రియేతే తస్మాత్ క్క యామీతి స జ్ఞాతుం న శక్నోతి|</para>
  <para style="p">
    <verse number="12" style="v"/>హే శిశవః, యూయం తస్య నామ్నా పాపక్షమాం ప్రాప్తవన్తస్తస్మాద్ అహం యుష్మాన్ ప్రతి లిఖామి|</para>
  <para style="p">
    <verse number="13" style="v"/>హే పితరః, య ఆదితో వర్త్తమానస్తం యూయం జానీథ తస్మాద్ యుష్మాన్ ప్రతి లిఖామి| హే యువానః యూయం పాపత్మానం జితవన్తస్తస్మాద్ యుష్మాన్ ప్రతి లిఖామి| హే బాలకాః, యూయం పితరం జానీథ తస్మాదహం యుష్మాన్ ప్రతి లిఖితవాన్|</para>
  <para style="p">
    <verse number="14" style="v"/>హే పితరః, ఆదితో యో వర్త్తమానస్తం యూయం జానీథ తస్మాద్ యుష్మాన్ ప్రతి లిఖితవాన్| హే యువానః, యూయం బలవన్త ఆధ్వే, ఈశ్వరస్య వాక్యఞ్చ యుష్మదన్తరే వర్తతే పాపాత్మా చ యుష్మాభిః పరాజిగ్యే తస్మాద్ యుష్మాన్ ప్రతి లిఖితవాన్|</para>
  <para style="p">
    <verse number="15" style="v"/>యూయం సంసారే సంసారస్థవిషయేషు చ మా ప్రీయధ్వం యః సంసారే ప్రీయతే తస్యాన్తరే పితుః ప్రేమ న తిష్ఠతి|</para>
  <para style="p">
    <verse number="16" style="v"/>యతః సంసారే యద్యత్ స్థితమ్ అర్థతః శారీరికభావస్యాభిలాషో దర్శనేన్ద్రియస్యాభిలాషో జీవనస్య గర్వ్వశ్చ సర్వ్వమేతత్ పితృతో న జాయతే కిన్తు సంసారదేవ|</para>
  <para style="p">
    <verse number="17" style="v"/>సంసారస్తదీయాభిలాషశ్చ వ్యత్యేతి కిన్తు య ఈశ్వరస్యేష్టం కరోతి సో ఽనన్తకాలం యావత్ తిష్ఠతి|</para>
  <para style="p">
    <verse number="18" style="v"/>హే బాలకాః, శేషకాలోఽయం, అపరం ఖ్రీష్టారిణోపస్థావ్యమితి యుష్మాభి ర్యథా శ్రుతం తథా బహవః ఖ్రీష్టారయ ఉపస్థితాస్తస్మాదయం శేషకాలోఽస్తీతి వయం జానీమః|</para>
  <para style="p">
    <verse number="19" style="v"/>తే ఽస్మన్మధ్యాన్ నిర్గతవన్తః కిన్త్వస్మదీయా నాసన్ యద్యస్మదీయా అభవిష్యన్ తర్హ్యస్మత్సఙ్గే ఽస్థాస్యన్, కిన్తు సర్వ్వే ఽస్మదీయా న సన్త్యేతస్య ప్రకాశ ఆవశ్యక ఆసీత్|</para>
  <para style="p">
    <verse number="20" style="v"/>యః పవిత్రస్తస్మాద్ యూయమ్ అభిషేకం ప్రాప్తవన్తస్తేన సర్వ్వాణి జానీథ|</para>
  <para style="p">
    <verse number="21" style="v"/>యూయం సత్యమతం న జానీథ తత్కారణాద్ అహం యుష్మాన్ ప్రతి లిఖితవాన్ తన్నహి కిన్తు యూయం తత్ జానీథ సత్యమతాచ్చ కిమప్యనృతవాక్యం నోత్పద్యతే తత్కారణాదేవ|</para>
  <para style="p">
    <verse number="22" style="v"/>యీశురభిషిక్తస్త్రాతేతి యో నాఙ్గీకరోతి తం వినా కో ఽపరో ఽనృతవాదీ భవేత్? స ఏవ ఖ్రీష్టారి ర్యః పితరం పుత్రఞ్చ నాఙ్గీకరోతి|</para>
  <para style="p">
    <verse number="23" style="v"/>యః కశ్చిత్ పుత్రం నాఙ్గీకరోతి స పితరమపి న ధారయతి యశ్చ పుత్రమఙ్గీకరోతి స పితరమపి ధారయతి|</para>
  <para style="p">
    <verse number="24" style="v"/>ఆదితో యుష్మాభి ర్యత్ శ్రుతం తద్ యుష్మాసు తిష్ఠతు, ఆదితః శ్రుతం వాక్యం యది యుష్మాసు తిష్ఠతి, తర్హి యూయమపి పుత్రే పితరి చ స్థాస్యథ|</para>
  <para style="p">
    <verse number="25" style="v"/>స చ ప్రతిజ్ఞయాస్మభ్యం యత్ ప్రతిజ్ఞాతవాన్ తద్ అనన్తజీవనం|</para>
  <para style="p">
    <verse number="26" style="v"/>యే జనా యుష్మాన్ భ్రామయన్తి తానధ్యహమ్ ఇదం లిఖితవాన్|</para>
  <para style="p">
    <verse number="27" style="v"/>అపరం యూయం తస్మాద్ యమ్ అభిషేకం ప్రాప్తవన్తః స యుష్మాసు తిష్ఠతి తతః కోఽపి యద్ యుష్మాన్ శిక్షయేత్ తద్ అనావశ్యకం, స చాభిషేకో యుష్మాన్ సర్వ్వాణి శిక్షయతి సత్యశ్చ భవతి న చాతథ్యః, అతః స యుష్మాన్ యద్వద్ అశిక్షయత్ తద్వత్ తత్ర స్థాస్యథ|</para>
  <para style="p">
    <verse number="28" style="v"/>అతఏవ హే ప్రియబాలకా యూయం తత్ర తిష్ఠత, తథా సతి స యదా ప్రకాశిష్యతే తదా వయం ప్రతిభాన్వితా భవిష్యామః, తస్యాగమనసమయే చ తస్య సాక్షాన్న త్రపిష్యామహే|</para>
  <para style="p">
    <verse number="29" style="v"/>స ధార్మ్మికో ఽస్తీతి యది యూయం జానీథ తర్హి యః కశ్చిద్ ధర్మ్మాచారం కరోతి స తస్మాత్ జాత ఇత్యపి జానీత|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>పశ్యత వయమ్ ఈశ్వరస్య సన్తానా ఇతి నామ్నాఖ్యామహే, ఏతేన పితాస్మభ్యం కీదృక్ మహాప్రేమ ప్రదత్తవాన్, కిన్తు సంసారస్తం నాజానాత్ తత్కారణాదస్మాన్ అపి న జానాతి|</para>
  <para style="p">
    <verse number="2" style="v"/>హే ప్రియతమాః, ఇదానీం వయమ్ ఈశ్వరస్య సన్తానా ఆస్మహే పశ్చాత్ కిం భవిష్యామస్తద్ అద్యాప్యప్రకాశితం కిన్తు ప్రకాశం గతే వయం తస్య సదృశా భవిష్యామి ఇతి జానీమః, యతః స యాదృశో ఽస్తి తాదృశో ఽస్మాభిర్దర్శిష్యతే|</para>
  <para style="p">
    <verse number="3" style="v"/>తస్మిన్ ఏషా ప్రత్యాశా యస్య కస్యచిద్ భవతి స స్వం తథా పవిత్రం కరోతి యథా స పవిత్రో ఽస్తి|</para>
  <para style="p">
    <verse number="4" style="v"/>యః కశ్చిత్ పాపమ్ ఆచరతి స వ్యవస్థాలఙ్ఘనం కరోతి యతః పాపమేవ వ్యవస్థాలఙ్ఘనం|</para>
  <para style="p">
    <verse number="5" style="v"/>అపరం సో ఽస్మాకం పాపాన్యపహర్త్తుం ప్రాకాశతైతద్ యూయం జానీథ, పాపఞ్చ తస్మిన్ న విద్యతే|</para>
  <para style="p">
    <verse number="6" style="v"/>యః కశ్చిత్ తస్మిన్ తిష్ఠతి స పాపాచారం న కరోతి యః కశ్చిత్ పాపాచారం కరోతి స తం న దృష్టవాన్ న వావగతవాన్|</para>
  <para style="p">
    <verse number="7" style="v"/>హే ప్రియబాలకాః, కశ్చిద్ యుష్మాకం భ్రమం న జనయేత్, యః కశ్చిద్ ధర్మ్మాచారం కరోతి స తాదృగ్ ధార్మ్మికో భవతి యాదృక్ స ధామ్మికో ఽస్తి|</para>
  <para style="p">
    <verse number="8" style="v"/>యః పాపాచారం కరోతి స శయతానాత్ జాతో యతః శయతాన ఆదితః పాపాచారీ శయతానస్య కర్మ్మణాం లోపార్థమేవేశ్వరస్య పుత్రః ప్రాకాశత|</para>
  <para style="p">
    <verse number="9" style="v"/>యః కశ్చిద్ ఈశ్వరాత్ జాతః స పాపాచారం న కరోతి యతస్తస్య వీర్య్యం తస్మిన్ తిష్ఠతి పాపాచారం కర్త్తుఞ్చ న శక్నోతి యతః స ఈశ్వరాత్ జాతః|</para>
  <para style="p">
    <verse number="10" style="v"/>ఇత్యనేనేశ్వరస్య సన్తానాః శయతానస్య చ సన్తానా వ్యక్తా భవన్తి| యః కశ్చిద్ ధర్మ్మాచారం న కరోతి స ఈశ్వరాత్ జాతో నహి యశ్చ స్వభ్రాతరి న ప్రీయతే సో ఽపీశ్వరాత్ జాతో నహి|</para>
  <para style="p">
    <verse number="11" style="v"/>యతస్తస్య య ఆదేశ ఆదితో యుష్మాభిః శ్రుతః స ఏష ఏవ యద్ అస్మాభిః పరస్పరం ప్రేమ కర్త్తవ్యం|</para>
  <para style="p">
    <verse number="12" style="v"/>పాపాత్మతో జాతో యః కాబిల్ స్వభ్రాతరం హతవాన్ తత్సదృశైరస్మాభి ర్న భవితవ్యం| స కస్మాత్ కారణాత్ తం హతవాన్? తస్య కర్మ్మాణి దుష్టాని తద్భ్రాతుశ్చ కర్మ్మాణి ధర్మ్మాణ్యాసన్ ఇతి కారణాత్|</para>
  <para style="p">
    <verse number="13" style="v"/>హే మమ భ్రాతరః, సంసారో యది యుష్మాన్ ద్వేష్టి తర్హి తద్ ఆశ్చర్య్యం న మన్యధ్వం|</para>
  <para style="p">
    <verse number="14" style="v"/>వయం మృత్యుమ్ ఉత్తీర్య్య జీవనం ప్రాప్తవన్తస్తద్ భ్రాతృషు ప్రేమకరణాత్ జానీమః| భ్రాతరి యో న ప్రీయతే స మృత్యౌ తిష్ఠతి|</para>
  <para style="p">
    <verse number="15" style="v"/>యః కశ్చిత్ స్వభ్రాతరం ద్వేష్టి సం నరఘాతీ కిఞ్చానన్తజీవనం నరఘాతినః కస్యాప్యన్తరే నావతిష్ఠతే తద్ యూయం జానీథ|</para>
  <para style="p">
    <verse number="16" style="v"/>అస్మాకం కృతే స స్వప్రాణాంస్త్యక్తవాన్ ఇత్యనేన వయం ప్రేమ్నస్తత్త్వమ్ అవగతాః, అపరం భ్రాతృణాం కృతే ఽస్మాభిరపి ప్రాణాస్త్యక్తవ్యాః|</para>
  <para style="p">
    <verse number="17" style="v"/>సాంసారికజీవికాప్రాప్తో యో జనః స్వభ్రాతరం దీనం దృష్ట్వా తస్మాత్ స్వీయదయాం రుణద్ధి తస్యాన్తర ఈశ్వరస్య ప్రేమ కథం తిష్ఠేత్?</para>
  <para style="p">
    <verse number="18" style="v"/>హే మమ ప్రియబాలకాః, వాక్యేన జిహ్వయా వాస్మాభిః ప్రేమ న కర్త్తవ్యం కిన్తు కార్య్యేణ సత్యతయా చైవ|</para>
  <para style="p">
    <verse number="19" style="v"/>ఏతేన వయం యత్ సత్యమతసమ్బన్ధీయాస్తత్ జానీమస్తస్య సాక్షాత్ స్వాన్తఃకరణాని సాన్త్వయితుం శక్ష్యామశ్చ|</para>
  <para style="p">
    <verse number="20" style="v"/>యతో ఽస్మదన్తఃకరణం యద్యస్మాన్ దూషయతి తర్హ్యస్మదన్తః కరణాద్ ఈశ్వరో మహాన్ సర్వ్వజ్ఞశ్చ|</para>
  <para style="p">
    <verse number="21" style="v"/>హే ప్రియతమాః, అస్మదన్తఃకరణం యద్యస్మాన్ న దూషయతి తర్హి వయమ్ ఈశ్వరస్య సాక్షాత్ ప్రతిభాన్వితా భవామః|</para>
  <para style="p">
    <verse number="22" style="v"/>యచ్చ ప్రార్థయామహే తత్ తస్మాత్ ప్రాప్నుమః, యతో వయం తస్యాజ్ఞాః పాలయామస్తస్య సాక్షాత్ తుష్టిజనకమ్ ఆచారం కుర్మ్మశ్చ|</para>
  <para style="p">
    <verse number="23" style="v"/>అపరం తస్యేయమాజ్ఞా యద్ వయం పుత్రస్య యీశుఖ్రీష్టస్య నామ్ని విశ్వసిమస్తస్యాజ్ఞానుసారేణ చ పరస్పరం ప్రేమ కుర్మ్మః|</para>
  <para style="p">
    <verse number="24" style="v"/>యశ్చ తస్యాజ్ఞాః పాలయతి స తస్మిన్ తిష్ఠతి తస్మిన్ సోఽపి తిష్ఠతి; స చాస్మాన్ యమ్ ఆత్మానం దత్తవాన్ తస్మాత్ సో ఽస్మాసు తిష్ఠతీతి జానీమః|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>హే ప్రియతమాః, యూయం సర్వ్వేష్వాత్మసు న విశ్వసిత కిన్తు తే ఈశ్వరాత్ జాతా న వేత్యాత్మనః పరీక్షధ్వం యతో బహవో మృషాభవిష్యద్వాదినో జగన్మధ్యమ్ ఆగతవన్తః|</para>
  <para style="p">
    <verse number="2" style="v"/>ఈశ్వరీయో య ఆత్మా స యుష్మాభిరనేన పరిచీయతాం, యీశుః ఖ్రీష్టో నరావతారో భూత్వాగత ఏతద్ యేన కేనచిద్ ఆత్మనా స్వీక్రియతే స ఈశ్వరీయః|</para>
  <para style="p">
    <verse number="3" style="v"/>కిన్తు యీశుః ఖ్రీష్టో నరావతారో భూత్వాగత ఏతద్ యేన కేనచిద్ ఆత్మనా నాఙ్గీక్రియతే స ఈశ్వరీయో నహి కిన్తు ఖ్రీష్టారేరాత్మా, తేన చాగన్తవ్యమితి యుష్మాభిః శ్రుతం, స చేదానీమపి జగతి వర్త్తతే|</para>
  <para style="p">
    <verse number="4" style="v"/>హే బాలకాః, యూయమ్ ఈశ్వరాత్ జాతాస్తాన్ జితవన్తశ్చ యతః సంసారాధిష్ఠానకారిణో ఽపి యుష్మదధిష్ఠానకారీ మహాన్|</para>
  <para style="p">
    <verse number="5" style="v"/>తే సంసారాత్ జాతాస్తతో హేతోః సంసారాద్ భాషన్తే సంసారశ్చ తేషాం వాక్యాని గృహ్లాతి|</para>
  <para style="p">
    <verse number="6" style="v"/>వయమ్ ఈశ్వరాత్ జాతాః, ఈశ్వరం యో జానాతి సోఽస్మద్వాక్యాని గృహ్లాతి యశ్చేశ్వరాత్ జాతో నహి సోఽస్మద్వాక్యాని న గృహ్లాతి; అనేన వయం సత్యాత్మానం భ్రామకాత్మానఞ్చ పరిచినుమః|</para>
  <para style="p">
    <verse number="7" style="v"/>హే ప్రియతమాః, వయం పరస్పరం ప్రేమ కరవామ, యతః ప్రేమ ఈశ్వరాత్ జాయతే, అపరం యః కశ్చిత్ ప్రేమ కరోతి స ఈశ్వరాత్ జాత ఈశ్వరం వేత్తి చ|</para>
  <para style="p">
    <verse number="8" style="v"/>యః ప్రేమ న కరోతి స ఈశ్వరం న జానాతి యత ఈశ్వరః ప్రేమస్వరూపః|</para>
  <para style="p">
    <verse number="9" style="v"/>అస్మాస్వీశ్వరస్య ప్రేమైతేన ప్రాకాశత యత్ స్వపుత్రేణాస్మభ్యం జీవనదానార్థమ్ ఈశ్వరః స్వీయమ్ అద్వితీయం పుత్రం జగన్మధ్యం ప్రేషితవాన్|</para>
  <para style="p">
    <verse number="10" style="v"/>వయం యద్ ఈశ్వరే ప్రీతవన్త ఇత్యత్ర నహి కిన్తు స యదస్మాసు ప్రీతవాన్ అస్మత్పాపానాం ప్రాయశ్చిర్త్తార్థం స్వపుత్రం ప్రేషితవాంశ్చేత్యత్ర ప్రేమ సన్తిష్ఠతే|</para>
  <para style="p">
    <verse number="11" style="v"/>హే ప్రియతమాః, అస్మాసు యదీశ్వరేణైతాదృశం ప్రేమ కృతం తర్హి పరస్పరం ప్రేమ కర్త్తుమ్ అస్మాకమప్యుచితం|</para>
  <para style="p">
    <verse number="12" style="v"/>ఈశ్వరః కదాచ కేనాపి న దృష్టః యద్యస్మాభిః పరస్పరం ప్రేమ క్రియతే తర్హీశ్వరో ఽస్మన్మధ్యే తిష్ఠతి తస్య ప్రేమ చాస్మాసు సేత్స్యతే|</para>
  <para style="p">
    <verse number="13" style="v"/>అస్మభ్యం తేన స్వకీయాత్మనోంఽశో దత్త ఇత్యనేన వయం యత్ తస్మిన్ తిష్ఠామః స చ యద్ అస్మాసు తిష్ఠతీతి జానీమః|</para>
  <para style="p">
    <verse number="14" style="v"/>పితా జగత్రాతారం పుత్రం ప్రేషితవాన్ ఏతద్ వయం దృష్ట్వా ప్రమాణయామః|</para>
  <para style="p">
    <verse number="15" style="v"/>యీశురీశ్వరస్య పుత్ర ఏతద్ యేనాఙ్గీక్రియతే తస్మిన్ ఈశ్వరస్తిష్ఠతి స చేశ్వరే తిష్ఠతి|</para>
  <para style="p">
    <verse number="16" style="v"/>అస్మాస్వీశ్వరస్య యత్ ప్రేమ వర్త్తతే తద్ వయం జ్ఞాతవన్తస్తస్మిన్ విశ్వాసితవన్తశ్చ| ఈశ్వరః ప్రేమస్వరూపః ప్రేమ్నీ యస్తిష్ఠతి స ఈశ్వరే తిష్ఠతి తస్మింశ్చేశ్వరస్తిష్ఠతి|</para>
  <para style="p">
    <verse number="17" style="v"/>స యాదృశో ఽస్తి వయమప్యేతస్మిన్ జగతి తాదృశా భవామ ఏతస్మాద్ విచారదినే ఽస్మాభి ర్యా ప్రతిభా లభ్యతే సాస్మత్సమ్బన్ధీయస్య ప్రేమ్నః సిద్ధిః|</para>
  <para style="p">
    <verse number="18" style="v"/>ప్రేమ్ని భీతి ర్న వర్త్తతే కిన్తు సిద్ధం ప్రేమ భీతిం నిరాకరోతి యతో భీతిః సయాతనాస్తి భీతో మానవః ప్రేమ్ని సిద్ధో న జాతః|</para>
  <para style="p">
    <verse number="19" style="v"/>అస్మాసు స ప్రథమం ప్రీతవాన్ ఇతి కారణాద్ వయం తస్మిన్ ప్రీయామహే|</para>
  <para style="p">
    <verse number="20" style="v"/>ఈశ్వరే ఽహం ప్రీయ ఇత్యుక్త్వా యః కశ్చిత్ స్వభ్రాతరం ద్వేష్టి సో ఽనృతవాదీ| స యం దృష్టవాన్ తస్మిన్ స్వభ్రాతరి యది న ప్రీయతే తర్హి యమ్ ఈశ్వరం న దృష్టవాన్ కథం తస్మిన్ ప్రేమ కర్త్తుం శక్నుయాత్?</para>
  <para style="p">
    <verse number="21" style="v"/>అత ఈశ్వరే యః ప్రీయతే స స్వీయభ్రాతర్య్యపి ప్రీయతామ్ ఇయమ్ ఆజ్ఞా తస్మాద్ అస్మాభి ర్లబ్ధా|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>యీశురభిషిక్తస్త్రాతేతి యః కశ్చిద్ విశ్వాసితి స ఈశ్వరాత్ జాతః; అపరం యః కశ్చిత్ జనయితరి ప్రీయతే స తస్మాత్ జాతే జనే ఽపి ప్రీయతే|</para>
  <para style="p">
    <verse number="2" style="v"/>వయమ్ ఈశ్వరస్య సన్తానేషు ప్రీయామహే తద్ అనేన జానీమో యద్ ఈశ్వరే ప్రీయామహే తస్యాజ్ఞాః పాలయామశ్చ|</para>
  <para style="p">
    <verse number="3" style="v"/>యత ఈశ్వరే యత్ ప్రేమ తత్ తదీయాజ్ఞాపాలనేనాస్మాభిః ప్రకాశయితవ్యం, తస్యాజ్ఞాశ్చ కఠోరా న భవన్తి|</para>
  <para style="p">
    <verse number="4" style="v"/>యతో యః కశ్చిద్ ఈశ్వరాత్ జాతః స సంసారం జయతి కిఞ్చాస్మాకం యో విశ్వాసః స ఏవాస్మాకం సంసారజయిజయః|</para>
  <para style="p">
    <verse number="5" style="v"/>యీశురీశ్వరస్య పుత్ర ఇతి యో విశ్వసితి తం వినా కోఽపరః సంసారం జయతి?</para>
  <para style="p">
    <verse number="6" style="v"/>సోఽభిషిక్తస్త్రాతా యీశుస్తోయరుధిరాభ్యామ్ ఆగతః కేవలం తోయేన నహి కిన్తు తోయరుధిరాభ్యామ్, ఆత్మా చ సాక్షీ భవతి యత ఆత్మా సత్యతాస్వరూపః|</para>
  <para style="p">
    <verse number="7" style="v"/>యతో హేతోః స్వర్గే పితా వాదః పవిత్ర ఆత్మా చ త్రయ ఇమే సాక్షిణః సన్తి, త్రయ ఇమే చైకో భవన్తి|</para>
  <para style="p">
    <verse number="8" style="v"/>తథా పృథివ్యామ్ ఆత్మా తోయం రుధిరఞ్చ త్రీణ్యేతాని సాక్ష్యం దదాతి తేషాం త్రయాణామ్ ఏకత్వం భవతి చ|</para>
  <para style="p">
    <verse number="9" style="v"/>మానవానాం సాక్ష్యం యద్యస్మాభి ర్గృహ్యతే తర్హీశ్వరస్య సాక్ష్యం తస్మాదపి శ్రేష్ఠం యతః స్వపుత్రమధీశ్వరేణ దత్తం సాక్ష్యమిదం|</para>
  <para style="p">
    <verse number="10" style="v"/>ఈశ్వరస్య పుత్రే యో విశ్వాసితి స నిజాన్తరే తత్ సాక్ష్యం ధారయతి; ఈశ్వరే యో న విశ్వసితి స తమ్ అనృతవాదినం కరోతి యత ఈశ్వరః స్వపుత్రమధి యత్ సాక్ష్యం దత్తవాన్ తస్మిన్ స న విశ్వసితి|</para>
  <para style="p">
    <verse number="11" style="v"/>తచ్చ సాక్ష్యమిదం యద్ ఈశ్వరో ఽస్మభ్యమ్ అనన్తజీవనం దత్తవాన్ తచ్చ జీవనం తస్య పుత్రే విద్యతే|</para>
  <para style="p">
    <verse number="12" style="v"/>యః పుత్రం ధారయతి స జీవనం ధారియతి, ఈశ్వరస్య పుత్రం యో న ధారయతి స జీవనం న ధారయతి|</para>
  <para style="p">
    <verse number="13" style="v"/>ఈశ్వరపుత్రస్య నామ్ని యుష్మాన్ ప్రత్యేతాని మయా లిఖితాని తస్యాభిప్రాయో ఽయం యద్ యూయమ్ అనన్తజీవనప్రాప్తా ఇతి జానీయాత తస్యేశ్వరపుత్రస్య నామ్ని విశ్వసేత చ|</para>
  <para style="p">
    <verse number="14" style="v"/>తస్యాన్తికే ఽస్మాకం యా ప్రతిభా భవతి తస్యాః కారణమిదం యద్ వయం యది తస్యాభిమతం కిమపి తం యాచామహే తర్హి సో ఽస్మాకం వాక్యం శృణోతి|</para>
  <para style="p">
    <verse number="15" style="v"/>స చాస్మాకం యత్ కిఞ్చన యాచనం శృణోతీతి యది జానీమస్తర్హి తస్మాద్ యాచితా వరా అస్మాభిః ప్రాప్యన్తే తదపి జానీమః|</para>
  <para style="p">
    <verse number="16" style="v"/>కశ్చిద్ యది స్వభ్రాతరమ్ అమృత్యుజనకం పాపం కుర్వ్వన్తం పశ్యతి తర్హి స ప్రార్థనాం కరోతు తేనేశ్వరస్తస్మై జీవనం దాస్యతి, అర్థతో మృత్యుజనకం పాపం యేన నాకారితస్మై| కిన్తు మృత్యుజనకమ్ ఏకం పాపమ్ ఆస్తే తదధి తేన ప్రార్థనా క్రియతామిత్యహం న వదామి|</para>
  <para style="p">
    <verse number="17" style="v"/>సర్వ్వ ఏవాధర్మ్మః పాపం కిన్తు సర్వ్వపాంప మృత్యుజనకం నహి|</para>
  <para style="p">
    <verse number="18" style="v"/>య ఈశ్వరాత్ జాతః స పాపాచారం న కరోతి కిన్త్వీశ్వరాత్ జాతో జనః స్వం రక్షతి తస్మాత్ స పాపాత్మా తం న స్పృశతీతి వయం జానీమః|</para>
  <para style="p">
    <verse number="19" style="v"/>వయమ్ ఈశ్వరాత్ జాతాః కిన్తు కృత్స్నః సంసారః పాపాత్మనో వశం గతో ఽస్తీతి జానీమః|</para>
  <para style="p">
    <verse number="20" style="v"/>అపరమ్ ఈశ్వరస్య పుత్ర ఆగతవాన్ వయఞ్చ యయా తస్య సత్యమయస్య జ్ఞానం ప్రాప్నుయామస్తాదృశీం ధియమ్ అస్మభ్యం దత్తవాన్ ఇతి జానీమస్తస్మిన్ సత్యమయే ఽర్థతస్తస్య పుత్రే యీశుఖ్రీష్టే తిష్ఠామశ్చ; స ఏవ సత్యమయ ఈశ్వరో ఽనన్తజీవనస్వరూపశ్చాస్తి|</para>
  <para style="p">
    <verse number="21" style="v"/>హే ప్రియబాలకాః, యూయం దేవమూర్త్తిభ్యః స్వాన్ రక్షత| ఆమేన్|</para>
</usx>
