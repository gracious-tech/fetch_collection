<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="2TH" style="id">Sanskrit Bible (NT) in Telugu Script (సత్యవేదః।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">2 Thessalonians</para>
  <para style="toc1">2 థిషలనీకినః పత్రం</para>
  <para style="toc2">2 థిషలనీకినః</para>
  <para style="toc3">2 థిషలనీకినః</para>
  <para style="mt1">2 థిషలనీకినః పత్రం</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>పౌలః సిల్వానస్తీమథియశ్చేతినామానో వయమ్ అస్మదీయతాతమ్ ఈశ్వరం ప్రభుం యీశుఖ్రీష్టఞ్చాశ్రితాం థిషలనీకినాం సమితిం ప్రతి పత్రం లిఖామః|</para>
  <para style="p">
    <verse number="2" style="v"/>అస్మాకం తాత ఈశ్వరః ప్రభు ర్యీశుఖ్రీష్టశ్చ యుష్మాస్వనుగ్రహం శాన్తిఞ్చ క్రియాస్తాం|</para>
  <para style="p">
    <verse number="3" style="v"/>హే భ్రాతరః, యుష్మాకం కృతే సర్వ్వదా యథాయోగ్యమ్ ఈశ్వరస్య ధన్యవాదో ఽస్మాభిః కర్త్తవ్యః, యతో హేతో ర్యుష్మాకం విశ్వాస ఉత్తరోత్తరం వర్ద్ధతే పరస్పరమ్ ఏకైకస్య ప్రేమ చ బహుఫలం భవతి|</para>
  <para style="p">
    <verse number="4" style="v"/>తస్మాద్ యుష్మాభి ర్యావన్త ఉపద్రవక్లేశాః సహ్యన్తే తేషు యద్ ధేैర్య్యం యశ్చ విశ్వాసః ప్రకాశ్యతే తత్కారణాద్ వయమ్ ఈశ్వరీయసమితిషు యుష్మాభిః శ్లాఘామహే|</para>
  <para style="p">
    <verse number="5" style="v"/>తచ్చేశ్వరస్య న్యాయవిచారస్య ప్రమాణం భవతి యతో యూయం యస్య కృతే దుఃఖం సహధ్వం తస్యేశ్వరీయరాజ్యస్య యోగ్యా భవథ|</para>
  <para style="p">
    <verse number="6" style="v"/>యతః స్వకీయస్వర్గదూతానాం బలైః సహితస్య ప్రభో ర్యీశోః స్వర్గాద్ ఆగమనకాలే యుష్మాకం క్లేశకేభ్యః క్లేశేన ఫలదానం సార్ద్ధమస్మాభిశ్చ</para>
  <para style="p">
    <verse number="7" style="v"/>క్లిశ్యమానేభ్యో యుష్మభ్యం శాన్తిదానమ్ ఈశ్వరేణ న్యాయ్యం భోత్స్యతే;</para>
  <para style="p">
    <verse number="8" style="v"/>తదానీమ్ ఈశ్వరానభిజ్ఞేభ్యో ఽస్మత్ప్రభో ర్యీశుఖ్రీష్టస్య సుసంవాదాగ్రాహకేభ్యశ్చ లోకేభ్యో జాజ్వల్యమానేన వహ్నినా సముచితం ఫలం యీశునా దాస్యతే;</para>
  <para style="p">
    <verse number="9" style="v"/>తే చ ప్రభో ర్వదనాత్ పరాక్రమయుక్తవిభవాచ్చ సదాతనవినాశరూపం దణ్డం లప్స్యన్తే,</para>
  <para style="p">
    <verse number="10" style="v"/>కిన్తు తస్మిన్ దినే స్వకీయపవిత్రలోకేషు విరాజితుం యుష్మాన్ అపరాంశ్చ సర్వ్వాన్ విశ్వాసిలోకాన్ విస్మాపయితుఞ్చ స ఆగమిష్యతి యతో ఽస్మాకం ప్రమాణే యుష్మాభి ర్విశ్వాసోఽకారి|</para>
  <para style="p">
    <verse number="11" style="v"/>అతోఽస్మాకమ్ ఈశ్వరో యుష్మాన్ తస్యాహ్వానస్య యోగ్యాన్ కరోతు సౌజన్యస్య శుభఫలం విశ్వాసస్య గుణఞ్చ పరాక్రమేణ సాధయత్వితి ప్రార్థనాస్మాభిః సర్వ్వదా యుష్మన్నిమిత్తం క్రియతే,</para>
  <para style="p">
    <verse number="12" style="v"/>యతస్తథా సత్యస్మాకమ్ ఈశ్వరస్య ప్రభో ర్యీశుఖ్రీష్టస్య చానుగ్రహాద్ అస్మత్ప్రభో ర్యీశుఖ్రీష్టస్య నామ్నో గౌరవం యుష్మాసు యుష్మాకమపి గౌరవం తస్మిన్ ప్రకాశిష్యతే|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>హే భ్రాతరః, అస్మాకం ప్రభో ర్యీశుఖ్రీష్టస్యాగమనం తస్య సమీపే ఽస్మాకం సంస్థితిఞ్చాధి వయం యుష్మాన్ ఇదం ప్రార్థయామహేे,</para>
  <para style="p">
    <verse number="2" style="v"/>ప్రభేస్తద్ దినం ప్రాయేణోపస్థితమ్ ఇతి యది కశ్చిద్ ఆత్మనా వాచా వా పత్రేణ వాస్మాకమ్ ఆదేశం కల్పయన్ యుష్మాన్ గదతి తర్హి యూయం తేన చఞ్చలమనస ఉద్విగ్నాశ్చ న భవత|</para>
  <para style="p">
    <verse number="3" style="v"/>కేనాపి ప్రకారేణ కోఽపి యుష్మాన్ న వఞ్చయతు యతస్తస్మాద్ దినాత్ పూర్వ్వం ధర్మ్మలోపేనోపస్యాతవ్యం,</para>
  <para style="p">
    <verse number="4" style="v"/>యశ్చ జనో విపక్షతాం కుర్వ్వన్ సర్వ్వస్మాద్ దేవాత్ పూజనీయవస్తుశ్చోన్నంస్యతే స్వమ్ ఈశ్వరమివ దర్శయన్ ఈశ్వరవద్ ఈశ్వరస్య మన్దిర ఉపవేక్ష్యతి చ తేన వినాశపాత్రేణ పాపపురుషేణోదేతవ్యం|</para>
  <para style="p">
    <verse number="5" style="v"/>యదాహం యుష్మాకం సన్నిధావాసం తదానీమ్ ఏతద్ అకథయమితి యూయం కిం న స్మరథ?</para>
  <para style="p">
    <verse number="6" style="v"/>సామ్ప్రతం స యేన నివార్య్యతే తద్ యూయం జానీథ, కిన్తు స్వసమయే తేనోదేతవ్యం|</para>
  <para style="p">
    <verse number="7" style="v"/>విధర్మ్మస్య నిగూఢో గుణ ఇదానీమపి ఫలతి కిన్తు యస్తం నివారయతి సోఽద్యాపి దూరీకృతో నాభవత్|</para>
  <para style="p">
    <verse number="8" style="v"/>తస్మిన్ దూరీకృతే స విధర్మ్మ్యుదేష్యతి కిన్తు ప్రభు ర్యీశుః స్వముఖపవనేన తం విధ్వంసయిష్యతి నిజోపస్థితేస్తేజసా వినాశయిష్యతి చ|</para>
  <para style="p">
    <verse number="9" style="v"/>శయతానస్య శక్తిప్రకాశనాద్ వినాశ్యమానానాం మధ్యే సర్వ్వవిధాః పరాక్రమా భ్రమికా ఆశ్చర్య్యక్రియా లక్షణాన్యధర్మ్మజాతా సర్వ్వవిధప్రతారణా చ తస్యోపస్థితేః ఫలం భవిష్యతి;</para>
  <para style="p">
    <verse number="10" style="v"/>యతో హేతోస్తే పరిత్రాణప్రాప్తయే సత్యధర్మ్మస్యానురాగం న గృహీతవన్తస్తస్మాత్ కారణాద్</para>
  <para style="p">
    <verse number="11" style="v"/>ఈశ్వరేణ తాన్ ప్రతి భ్రాన్తికరమాయాయాం ప్రేషితాయాం తే మృషావాక్యే విశ్వసిష్యన్తి|</para>
  <para style="p">
    <verse number="12" style="v"/>యతో యావన్తో మానవాః సత్యధర్మ్మే న విశ్వస్యాధర్మ్మేణ తుష్యన్తి తైః సర్వ్వై ర్దణ్డభాజనై ర్భవితవ్యం|</para>
  <para style="p">
    <verse number="13" style="v"/>హే ప్రభోః ప్రియా భ్రాతరః, యుష్మాకం కృత ఈశ్వరస్య ధన్యవాదోఽస్మాభిః సర్వ్వదా కర్త్తవ్యో యత ఈశ్వర ఆ ప్రథమాద్ ఆత్మనః పావనేన సత్యధర్మ్మే విశ్వాసేన చ పరిత్రాణార్థం యుష్మాన్ వరీతవాన్</para>
  <para style="p">
    <verse number="14" style="v"/>తదర్థఞ్చాస్మాభి ర్ఘోషితేన సుసంవాదేన యుష్మాన్ ఆహూయాస్మాకం ప్రభో ర్యీశుఖ్రీష్టస్య తేజసోఽధికారిణః కరిష్యతి|</para>
  <para style="p">
    <verse number="15" style="v"/>అతో హే భ్రాతరః యూయమ్ అస్మాకం వాక్యైః పత్రైశ్చ యాం శిక్షాం లబ్ధవన్తస్తాం కృత్స్నాం శిక్షాం ధారయన్తః సుస్థిరా భవత|</para>
  <para style="p">
    <verse number="16" style="v"/>అస్మాకం ప్రభు ర్యీశుఖ్రీష్టస్తాత ఈశ్వరశ్చార్థతో యో యుష్మాసు ప్రేమ కృతవాన్ నిత్యాఞ్చ సాన్త్వనామ్ అనుగ్రహేణోత్తమప్రత్యాశాఞ్చ యుష్మభ్యం దత్తవాన్</para>
  <para style="p">
    <verse number="17" style="v"/>స స్వయం యుష్మాకమ్ అన్తఃకరణాని సాన్త్వయతు సర్వ్వస్మిన్ సద్వాక్యే సత్కర్మ్మణి చ సుస్థిరీకరోతు చ|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>హే భ్రాతరః, శేషే వదామి, యూయమ్ అస్మభ్యమిదం ప్రార్థయధ్వం యత్ ప్రభో ర్వాక్యం యుష్మాకం మధ్యే యథా తథైవాన్యత్రాపి ప్రచరేత్ మాన్యఞ్చ భవేత్;</para>
  <para style="p">
    <verse number="2" style="v"/>యచ్చ వయమ్ అవివేచకేభ్యో దుష్టేభ్యశ్చ లోకేభ్యో రక్షాం ప్రాప్నుయామ యతః సర్వ్వేషాం విశ్వాసో న భవతి|</para>
  <para style="p">
    <verse number="3" style="v"/>కిన్తు ప్రభు ర్విశ్వాస్యః స ఏవ యుష్మాన్ స్థిరీకరిష్యతి దుష్టస్య కరాద్ ఉద్ధరిష్యతి చ|</para>
  <para style="p">
    <verse number="4" style="v"/>యూయమ్ అస్మాభి ర్యద్ ఆదిశ్యధ్వే తత్ కురుథ కరిష్యథ చేతి విశ్వాసో యుష్మానధి ప్రభునాస్మాకం జాయతే|</para>
  <para style="p">
    <verse number="5" style="v"/>ఈశ్వరస్య ప్రేమ్ని ఖ్రీష్టస్య సహిష్ణుతాయాఞ్చ ప్రభుః స్వయం యుష్మాకమ్ అన్తఃకరణాని వినయతు|</para>
  <para style="p">
    <verse number="6" style="v"/>హే భ్రాతరః, అస్మత్ప్రభో ర్యీశుఖ్రీష్టస్య నామ్నా వయం యుష్మాన్ ఇదమ్ ఆదిశామః, అస్మత్తో యుష్మాభి ర్యా శిక్షలమ్భి తాం విహాయ కశ్చిద్ భ్రాతా యద్యవిహితాచారం కరోతి తర్హి యూయం తస్మాత్ పృథగ్ భవత|</para>
  <para style="p">
    <verse number="7" style="v"/>యతో వయం యుష్మాభిః కథమ్ అనుకర్త్తవ్యాస్తద్ యూయం స్వయం జానీథ| యుష్మాకం మధ్యే వయమ్ అవిహితాచారిణో నాభవామ,</para>
  <para style="p">
    <verse number="8" style="v"/>వినామూల్యం కస్యాప్యన్నం నాభుంజ్మహి కిన్తు కోఽపి యద్ అస్మాభి ర్భారగ్రస్తో న భవేత్ తదర్థం శ్రమేణ క్లేశేన చ దివానిశం కార్య్యమ్ అకుర్మ్మ|</para>
  <para style="p">
    <verse number="9" style="v"/>అత్రాస్మాకమ్ అధికారో నాస్తీత్థం నహి కిన్త్వస్మాకమ్ అనుకరణాయ యుష్మాన్ దృష్టాన్తం దర్శయితుమ్ ఇచ్ఛన్తస్తద్ అకుర్మ్మ|</para>
  <para style="p">
    <verse number="10" style="v"/>యతో యేన కార్య్యం న క్రియతే తేనాహారోఽపి న క్రియతామితి వయం యుష్మత్సమీప ఉపస్థితికాలేఽపి యుష్మాన్ ఆదిశామ|</para>
  <para style="p">
    <verse number="11" style="v"/>యుష్మన్మధ్యే ఽవిహితాచారిణః కేఽపి జనా విద్యన్తే తే చ కార్య్యమ్ అకుర్వ్వన్త ఆలస్యమ్ ఆచరన్తీత్యస్మాభిః శ్రూయతే|</para>
  <para style="p">
    <verse number="12" style="v"/>తాదృశాన్ లోకాన్ అస్మతప్రభో ర్యీశుఖ్రీష్టస్య నామ్నా వయమ్ ఇదమ్ ఆదిశామ ఆజ్ఞాపయామశ్చ, తే శాన్తభావేన కార్య్యం కుర్వ్వన్తః స్వకీయమన్నం భుఞ్జతాం|</para>
  <para style="p">
    <verse number="13" style="v"/>అపరం హే భ్రాతరః, యూయం సదాచరణే న క్లామ్యత|</para>
  <para style="p">
    <verse number="14" style="v"/>యది చ కశ్చిదేతత్పత్రే లిఖితామ్ అస్మాకమ్ ఆజ్ఞాం న గృహ్లాతి తర్హి యూయం తం మానుషం లక్షయత తస్య సంసర్గం త్యజత చ తేన స త్రపిష్యతే|</para>
  <para style="p">
    <verse number="15" style="v"/>కిన్తు తం న శత్రుం మన్యమానా భ్రాతరమివ చేతయత|</para>
  <para style="p">
    <verse number="16" style="v"/>శాన్తిదాతా ప్రభుః సర్వ్వత్ర సర్వ్వథా యుష్మభ్యం శాన్తిం దేయాత్| ప్రభు ర్యుష్మాకం సర్వ్వేషాం సఙ్గీ భూయాత్|</para>
  <para style="p">
    <verse number="17" style="v"/>నమస్కార ఏష పౌలస్య మమ కరేణ లిఖితోఽభూత్ సర్వ్వస్మిన్ పత్ర ఏతన్మమ చిహ్నమ్ ఏతాదృశైరక్షరై ర్మయా లిఖ్యతే|</para>
  <para style="p">
    <verse number="18" style="v"/>అస్మాకం ప్రభో ర్యీశుఖ్రీష్టస్యానుुగ్రహః సర్వ్వేషు యుష్మాసు భూయాత్| ఆమేన్|</para>
</usx>
