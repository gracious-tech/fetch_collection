<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="COL" style="id">Sanskrit Bible (NT) in Telugu Script (సత్యవేదః।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Colossians</para>
  <para style="toc1">కలసినః పత్రం</para>
  <para style="toc2">కలసినః</para>
  <para style="toc3">కలసినః</para>
  <para style="mt1">కలసినః పత్రం</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ఈశ్వరస్యేచ్ఛయా యీశుఖ్రీష్టస్య ప్రేరితః పౌలస్తీమథియో భ్రాతా చ కలసీనగరస్థాన్ పవిత్రాన్ విశ్వస్తాన్ ఖ్రీష్టాశ్రితభ్రాతృన్ ప్రతి పత్రం లిఖతః|</para>
  <para style="p">
    <verse number="2" style="v"/>అస్మాకం తాత ఈశ్వరః ప్రభు ర్యీశుఖ్రీష్టశ్చ యుష్మాన్ ప్రతి ప్రసాదం శాన్తిఞ్చ క్రియాస్తాం|</para>
  <para style="p">
    <verse number="3" style="v"/>ఖ్రీష్టే యీశౌ యుష్మాకం విశ్వాసస్య సర్వ్వాన్ పవిత్రలోకాన్ ప్రతి ప్రేమ్నశ్చ వార్త్తాం శ్రుత్వా</para>
  <para style="p">
    <verse number="4" style="v"/>వయం సదా యుష్మదర్థం ప్రార్థనాం కుర్వ్వన్తః స్వర్గే నిహితాయా యుష్మాకం భావిసమ్పదః కారణాత్ స్వకీయప్రభో ర్యీశుఖ్రీష్టస్య తాతమ్ ఈశ్వరం ధన్యం వదామః|</para>
  <para style="p">
    <verse number="5" style="v"/>యూయం తస్యా భావిసమ్పదో వార్త్తాం యయా సుసంవాదరూపిణ్యా సత్యవాణ్యా జ్ఞాపితాః</para>
  <para style="p">
    <verse number="6" style="v"/>సా యద్వత్ కృస్నం జగద్ అభిగచ్ఛతి తద్వద్ యుష్మాన్ అప్యభ్యగమత్, యూయఞ్చ యద్ దినమ్ ఆరభ్యేశ్వరస్యానుగ్రహస్య వార్త్తాం శ్రుత్వా సత్యరూపేణ జ్ఞాతవన్తస్తదారభ్య యుష్మాకం మధ్యేఽపి ఫలతి వర్ద్ధతే చ|</para>
  <para style="p">
    <verse number="7" style="v"/>అస్మాకం ప్రియః సహదాసో యుష్మాకం కృతే చ ఖ్రీష్టస్య విశ్వస్తపరిచారకో య ఇపఫ్రాస్తద్ వాక్యం</para>
  <para style="p">
    <verse number="8" style="v"/>యుష్మాన్ ఆదిష్టవాన్ స ఏవాస్మాన్ ఆత్మనా జనితం యుష్మాకం ప్రేమ జ్ఞాపితవాన్|</para>
  <para style="p">
    <verse number="9" style="v"/>వయం యద్ దినమ్ ఆరభ్య తాం వార్త్తాం శ్రుతవన్తస్తదారభ్య నిరన్తరం యుష్మాకం కృతే ప్రార్థనాం కుర్మ్మః ఫలతో యూయం యత్ పూర్ణాభ్యామ్ ఆత్మికజ్ఞానవుద్ధిభ్యామ్ ఈశ్వరస్యాభితమం సమ్పూర్ణరూపేణావగచ్ఛేత,</para>
  <para style="p">
    <verse number="10" style="v"/>ప్రభో ర్యోగ్యం సర్వ్వథా సన్తోషజనకఞ్చాచారం కుర్య్యాతార్థత ఈశ్వరజ్ఞానే వర్ద్ధమానాః సర్వ్వసత్కర్మ్మరూపం ఫలం ఫలేత,</para>
  <para style="p">
    <verse number="11" style="v"/>యథా చేశ్వరస్య మహిమయుక్తయా శక్త్యా సానన్దేన పూర్ణాం సహిష్ణుతాం తితిక్షాఞ్చాచరితుం శక్ష్యథ తాదృశేన పూర్ణబలేన యద్ బలవన్తో భవేత,</para>
  <para style="p">
    <verse number="12" style="v"/>యశ్చ పితా తేజోవాసినాం పవిత్రలోకానామ్ అధికారస్యాంశిత్వాయాస్మాన్ యోగ్యాన్ కృతవాన్ తం యద్ ధన్యం వదేత వరమ్ ఏనం యాచామహే|</para>
  <para style="p">
    <verse number="13" style="v"/>యతః సోఽస్మాన్ తిమిరస్య కర్త్తృత్వాద్ ఉద్ధృత్య స్వకీయస్య ప్రియపుత్రస్య రాజ్యే స్థాపితవాన్|</para>
  <para style="p">
    <verse number="14" style="v"/>తస్మాత్ పుత్రాద్ వయం పరిత్రాణమ్ అర్థతః పాపమోచనం ప్రాప్తవన్తః|</para>
  <para style="p">
    <verse number="15" style="v"/>స చాదృశ్యస్యేశ్వరస్య ప్రతిమూర్తిః కృత్స్నాయాః సృష్టేరాదికర్త్తా చ|</para>
  <para style="p">
    <verse number="16" style="v"/>యతః సర్వ్వమేవ తేన ససృజే సింహాసనరాజత్వపరాక్రమాదీని స్వర్గమర్త్త్యస్థితాని దృశ్యాదృశ్యాని వస్తూని సర్వ్వాణి తేనైవ తస్మై చ ససృజిరే|</para>
  <para style="p">
    <verse number="17" style="v"/>స సర్వ్వేషామ్ ఆదిః సర్వ్వేషాం స్థితికారకశ్చ|</para>
  <para style="p">
    <verse number="18" style="v"/>స ఏవ సమితిరూపాయాస్తనో ర్మూర్ద్ధా కిఞ్చ సర్వ్వవిషయే స యద్ అగ్రియో భవేత్ తదర్థం స ఏవ మృతానాం మధ్యాత్ ప్రథమత ఉత్థితోఽగ్రశ్చ|</para>
  <para style="p">
    <verse number="19" style="v"/>యత ఈశ్వరస్య కృత్స్నం పూర్ణత్వం తమేవావాసయితుం</para>
  <para style="p">
    <verse number="20" style="v"/>క్రుశే పాతితేన తస్య రక్తేన సన్ధిం విధాయ తేనైవ స్వర్గమర్త్త్యస్థితాని సర్వ్వాణి స్వేన సహ సన్ధాపయితుఞ్చేశ్వరేణాభిలేషే|</para>
  <para style="p">
    <verse number="21" style="v"/>పూర్వ్వం దూరస్థా దుష్క్రియారతమనస్కత్వాత్ తస్య రిపవశ్చాస్త యే యూయం తాన్ యుష్మాన్ అపి స ఇదానీం తస్య మాంసలశరీరే మరణేన స్వేన సహ సన్ధాపితవాన్|</para>
  <para style="p">
    <verse number="22" style="v"/>యతః స స్వసమ్ముఖే పవిత్రాన్ నిష్కలఙ్కాన్ అనిన్దనీయాంశ్చ యుష్మాన్ స్థాపయితుమ్ ఇచ్ఛతి|</para>
  <para style="p">
    <verse number="23" style="v"/>కిన్త్వేతదర్థం యుష్మాభి ర్బద్ధమూలైః సుస్థిరైశ్చ భవితవ్యమ్, ఆకాశమణ్డలస్యాధఃస్థితానాం సర్వ్వలోకానాం మధ్యే చ ఘుష్యమాణో యః సుసంవాదో యుష్మాభిరశ్రావి తజ్జాతాయాం ప్రత్యాశాయాం యుష్మాభిరచలై ర్భవితవ్యం|</para>
  <para style="p">
    <verse number="24" style="v"/>తస్య సుసంవాదస్యైకః పరిచారకో యోఽహం పౌలః సోఽహమ్ ఇదానీమ్ ఆనన్దేన యుష్మదర్థం దుఃఖాని సహే ఖ్రీష్టస్య క్లేశభోగస్య యోంశోఽపూర్ణస్తమేవ తస్య తనోః సమితేః కృతే స్వశరీరే పూరయామి చ|</para>
  <para style="p">
    <verse number="25" style="v"/>యత ఈశ్వరస్య మన్త్రణయా యుష్మదర్థమ్ ఈశ్వరీయవాక్యస్య ప్రచారస్య భారో మయి సమపితస్తస్మాద్ అహం తస్యాః సమితేః పరిచారకోఽభవం|</para>
  <para style="p">
    <verse number="26" style="v"/>తత్ నిగూఢం వాక్యం పూర్వ్వయుగేషు పూర్వ్వపురుషేభ్యః ప్రచ్ఛన్నమ్ ఆసీత్ కిన్త్విదానీం తస్య పవిత్రలోకానాం సన్నిధౌ తేన ప్రాకాశ్యత|</para>
  <para style="p">
    <verse number="27" style="v"/>యతో భిన్నజాతీయానాం మధ్యే తత్ నిగూఢవాక్యం కీదృగ్గౌరవనిధిసమ్బలితం తత్ పవిత్రలోకాన్ జ్ఞాపయితుమ్ ఈశ్వరోఽభ్యలషత్| యుష్మన్మధ్యవర్త్తీ ఖ్రీష్ట ఏవ స నిధి ర్గైరవాశాభూమిశ్చ|</para>
  <para style="p">
    <verse number="28" style="v"/>తస్మాద్ వయం తమేవ ఘోషయన్తో యద్ ఏకైకం మానవం సిద్ధీభూతం ఖ్రీష్టే స్థాపయేమ తదర్థమేకైకం మానవం ప్రబోధయామః పూర్ణజ్ఞానేన చైకైకం మానవం ఉపదిశామః|</para>
  <para style="p">
    <verse number="29" style="v"/>ఏతదర్థం తస్య యా శక్తిః ప్రబలరూపేణ మమ మధ్యే ప్రకాశతే తయాహం యతమానః శ్రాభ్యామి|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>యుష్మాకం లాయదికేయాస్థభ్రాతృణాఞ్చ కృతే యావన్తో భ్రాతరశ్చ మమ శారీరికముఖం న దృష్టవన్తస్తేషాం కృతే మమ కియాన్ యత్నో భవతి తద్ యుష్మాన్ జ్ఞాపయితుమ్ ఇచ్ఛామి|</para>
  <para style="p">
    <verse number="2" style="v"/>ఫలతః పూర్ణబుద్ధిరూపధనభోగాయ ప్రేమ్నా సంయుక్తానాం తేషాం మనాంసి యత్ పితురీశ్వరస్య ఖ్రీష్టస్య చ నిగూఢవాక్యస్య జ్ఞానార్థం సాన్త్వనాం ప్రాప్నుయురిత్యర్థమహం యతే|</para>
  <para style="p">
    <verse number="3" style="v"/>యతో విద్యాజ్ఞానయోః సర్వ్వే నిధయః ఖ్రీష్టే గుప్తాః సన్తి|</para>
  <para style="p">
    <verse number="4" style="v"/>కోఽపి యుష్మాన్ వినయవాక్యేన యన్న వఞ్చయేత్ తదర్థమ్ ఏతాని మయా కథ్యన్తే|</para>
  <para style="p">
    <verse number="5" style="v"/>యుష్మత్సన్నిధౌ మమ శరీరేఽవర్త్తమానేఽపి మమాత్మా వర్త్తతే తేన యుష్మాకం సురీతిం ఖ్రీష్టవిశ్వాసే స్థిరత్వఞ్చ దృష్ట్వాహమ్ ఆనన్దామి|</para>
  <para style="p">
    <verse number="6" style="v"/>అతో యూయం ప్రభుం యీశుఖ్రీష్టం యాదృగ్ గృహీతవన్తస్తాదృక్ తమ్ అనుచరత|</para>
  <para style="p">
    <verse number="7" style="v"/>తస్మిన్ బద్ధమూలాః స్థాపితాశ్చ భవత యా చ శిక్షా యుష్మాభి ర్లబ్ధా తదనుసారాద్ విశ్వాసే సుస్థిరాః సన్తస్తేనైవ నిత్యం ధన్యవాదం కురుత|</para>
  <para style="p">
    <verse number="8" style="v"/>సావధానా భవత మానుషికశిక్షాత ఇహలోకస్య వర్ణమాలాతశ్చోత్పన్నా ఖ్రీష్టస్య విపక్షా యా దర్శనవిద్యా మిథ్యాప్రతారణా చ తయా కోఽపి యుష్మాకం క్షతిం న జనయతు|</para>
  <para style="p">
    <verse number="9" style="v"/>యత ఈశ్వరస్య కృత్స్నా పూర్ణతా మూర్త్తిమతీ ఖ్రీష్టే వసతి|</para>
  <para style="p">
    <verse number="10" style="v"/>యూయఞ్చ తేన పూర్ణా భవథ యతః స సర్వ్వేషాం రాజత్వకర్త్తృత్వపదానాం మూర్ద్ధాస్తి,</para>
  <para style="p">
    <verse number="11" style="v"/>తేన చ యూయమ్ అహస్తకృతత్వక్ఛేదేనార్థతో యేన శారీరపాపానాం విగ్రసత్యజ్యతే తేన ఖ్రీష్టస్య త్వక్ఛేదేన ఛిన్నత్వచో జాతా</para>
  <para style="p">
    <verse number="12" style="v"/>మజ్జనే చ తేన సార్ద్ధం శ్మశానం ప్రాప్తాః పున ర్మృతానాం మధ్యాత్ తస్యోత్థాపయితురీశ్వరస్య శక్తేః ఫలం యో విశ్వాసస్తద్వారా తస్మిన్నేవ మజ్జనే తేన సార్ద్ధమ్ ఉత్థాపితా అభవత|</para>
  <para style="p">
    <verse number="13" style="v"/>స చ యుష్మాన్ అపరాధైః శారీరికాత్వక్ఛేదేన చ మృతాన్ దృష్ట్వా తేన సార్ద్ధం జీవితవాన్ యుష్మాకం సర్వ్వాన్ అపరాధాన్ క్షమితవాన్,</para>
  <para style="p">
    <verse number="14" style="v"/>యచ్చ దణ్డాజ్ఞారూపం ఋణపత్రమ్ అస్మాకం విరుద్ధమ్ ఆసీత్ తత్ ప్రమార్జ్జితవాన్ శలాకాభిః క్రుశే బద్ధ్వా దూరీకృతవాంశ్చ|</para>
  <para style="p">
    <verse number="15" style="v"/>కిఞ్చ తేన రాజత్వకర్త్తృత్వపదాని నిస్తేజాంసి కృత్వా పరాజితాన్ రిపూనివ ప్రగల్భతయా సర్వ్వేషాం దృష్టిగోచరే హ్రేపితవాన్|</para>
  <para style="p">
    <verse number="16" style="v"/>అతో హేతోః ఖాద్యాఖాద్యే పేయాపేయే ఉత్సవః ప్రతిపద్ విశ్రామవారశ్చైతేషు సర్వ్వేషు యుష్మాకం న్యాయాధిపతిరూపం కమపి మా గృహ్లీత|</para>
  <para style="p">
    <verse number="17" style="v"/>యత ఏతాని ఛాయాస్వరూపాణి కిన్తు సత్యా మూర్త్తిః ఖ్రీష్టః|</para>
  <para style="p">
    <verse number="18" style="v"/>అపరఞ్చ నమ్రతా స్వర్గదూతానాం సేవా చైతాదృశమ్ ఇష్టకర్మ్మాచరన్ యః కశ్చిత్ పరోక్షవిషయాన్ ప్రవిశతి స్వకీయశారీరికభావేన చ ముధా గర్వ్వితః సన్</para>
  <para style="p">
    <verse number="19" style="v"/>సన్ధిభిః శిరాభిశ్చోపకృతం సంయుక్తఞ్చ కృత్స్నం శరీరం యస్మాత్ మూర్ద్ధత ఈశ్వరీయవృద్ధిం ప్రాప్నోతి తం మూర్ద్ధానం న ధారయతి తేన మానవేన యుష్మత్తః ఫలాపహరణం నానుజానీత|</para>
  <para style="p">
    <verse number="20" style="v"/>యది యూయం ఖ్రీష్టేన సార్ద్ధం సంసారస్య వర్ణమాలాయై మృతా అభవత తర్హి యైै ర్ద్రవ్యై ర్భోగేన క్షయం గన్తవ్యం</para>
  <para style="p">
    <verse number="21" style="v"/>తాని మా స్పృశ మా భుంక్ష్వ మా గృహాణేతి మానవైరాదిష్టాన్ శిక్షితాంశ్చ విధీన్</para>
  <para style="p">
    <verse number="22" style="v"/>ఆచరన్తో యూయం కుతః సంసారే జీవన్త ఇవ భవథ?</para>
  <para style="p">
    <verse number="23" style="v"/>తే విధయః స్వేచ్ఛాభక్త్యా నమ్రతయా శరీరక్లేశనేన చ జ్ఞానవిధివత్ ప్రకాశన్తే తథాపి తేఽగణ్యాః శారీరికభావవర్ద్ధకాశ్చ సన్తి|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>యది యూయం ఖ్రీష్టేన సార్ద్ధమ్ ఉత్థాపితా అభవత తర్హి యస్మిన్ స్థానే ఖ్రీష్ట ఈశ్వరస్య దక్షిణపార్శ్వే ఉపవిష్ట ఆస్తే తస్యోర్ద్ధ్వస్థానస్య విషయాన్ చేష్టధ్వం|</para>
  <para style="p">
    <verse number="2" style="v"/>పార్థివవిషయేషు న యతమానా ఊర్ద్ధ్వస్థవిషయేషు యతధ్వం|</para>
  <para style="p">
    <verse number="3" style="v"/>యతో యూయం మృతవన్తో యుష్మాకం జీవితఞ్చ ఖ్రీష్టేన సార్ద్ధమ్ ఈశ్వరే గుప్తమ్ అస్తి|</para>
  <para style="p">
    <verse number="4" style="v"/>అస్మాకం జీవనస్వరూపః ఖ్రీష్టో యదా ప్రకాశిష్యతే తదా తేన సార్ద్ధం యూయమపి విభవేన ప్రకాశిష్యధ్వే|</para>
  <para style="p">
    <verse number="5" style="v"/>అతో వేశ్యాగమనమ్ అశుచిక్రియా రాగః కుత్సితాభిలాషో దేవపూజాతుల్యో లోభశ్చైతాని ర్పాिథవపురుషస్యాఙ్గాని యుష్మాభి ర్నిహన్యన్తాం|</para>
  <para style="p">
    <verse number="6" style="v"/>యత ఏతేభ్యః కర్మ్మభ్య ఆజ్ఞాలఙ్ఘినో లోకాన్ ప్రతీశ్వరస్య క్రోధో వర్త్తతే|</para>
  <para style="p">
    <verse number="7" style="v"/>పూర్వ్వం యదా యూయం తాన్యుపాజీవత తదా యూయమపి తాన్యేవాచరత;</para>
  <para style="p">
    <verse number="8" style="v"/>కిన్త్విదానీం క్రోధో రోషో జిహింసిషా దుర్ముఖతా వదననిర్గతకదాలపశ్చైతాని సర్వ్వాణి దూరీకురుధ్వం|</para>
  <para style="p">
    <verse number="9" style="v"/>యూయం పరస్పరం మృషాకథాం న వదత యతో యూయం స్వకర్మ్మసహితం పురాతనపురుషం త్యక్తవన్తః</para>
  <para style="p">
    <verse number="10" style="v"/>స్వస్రష్టుః ప్రతిమూర్త్యా తత్త్వజ్ఞానాయ నూతనీకృతం నవీనపురుషం పరిహితవన్తశ్చ|</para>
  <para style="p">
    <verse number="11" style="v"/>తేన చ యిహూదిభిన్నజాతీయయోశ్ఛిన్నత్వగచ్ఛిన్నత్వచో ర్మ్లేచ్ఛస్కుథీయయో ర్దాసముక్తయోశ్చ కోఽపి విశేషో నాస్తి కిన్తు సర్వ్వేషు సర్వ్వః ఖ్రీష్ట ఏవాస్తే|</para>
  <para style="p">
    <verse number="12" style="v"/>అతఏవ యూయమ్ ఈశ్వరస్య మనోభిలషితాః పవిత్రాః ప్రియాశ్చ లోకా ఇవ స్నేహయుక్తామ్ అనుకమ్పాం హితైషితాం నమ్రతాం తితిక్షాం సహిష్ణుతాఞ్చ పరిధద్ధ్వం|</para>
  <para style="p">
    <verse number="13" style="v"/>యూయమ్ ఏకైకస్యాచరణం సహధ్వం యేన చ యస్య కిమప్యపరాధ్యతే తస్య తం దోషం స క్షమతాం, ఖ్రీష్టో యుష్మాకం దోషాన్ యద్వద్ క్షమితవాన్ యూయమపి తద్వత్ కురుధ్వం|</para>
  <para style="p">
    <verse number="14" style="v"/>విశేషతః సిద్ధిజనకేన ప్రేమబన్ధనేన బద్ధా భవత|</para>
  <para style="p">
    <verse number="15" style="v"/>యస్యాః ప్రాప్తయే యూయమ్ ఏకస్మిన్ శరీరే సమాహూతా అభవత సేశ్వరీయా శాన్తి ర్యుష్మాకం మనాంస్యధితిష్ఠతు యూయఞ్చ కృతజ్ఞా భవత|</para>
  <para style="p">
    <verse number="16" style="v"/>ఖ్రీష్టస్య వాక్యం సర్వ్వవిధజ్ఞానాయ సమ్పూర్ణరూపేణ యుష్మదన్తరే నివమతు, యూయఞ్చ గీతై ర్గానైః పారమార్థికసఙ్కీర్త్తనైశ్చ పరస్పరమ్ ఆదిశత ప్రబోధయత చ, అనుగృహీతత్వాత్ ప్రభుమ్ ఉద్దిశ్య స్వమనోభి ర్గాయత చ|</para>
  <para style="p">
    <verse number="17" style="v"/>వాచా కర్మ్మణా వా యద్ యత్ కురుత తత్ సర్వ్వం ప్రభో ర్యీశో ర్నామ్నా కురుత తేన పితరమ్ ఈశ్వరం ధన్యం వదత చ|</para>
  <para style="p">
    <verse number="18" style="v"/>హే యోషితః, యూయం స్వామినాం వశ్యా భవత యతస్తదేవ ప్రభవే రోచతే|</para>
  <para style="p">
    <verse number="19" style="v"/>హే స్వామినః, యూయం భార్య్యాసు ప్రీయధ్వం తాః ప్రతి పరుషాలాపం మా కురుధ్వం|</para>
  <para style="p">
    <verse number="20" style="v"/>హే బాలాః, యూయం సర్వ్వవిషయే పిత్రోరాజ్ఞాగ్రాహిణో భవత యతస్తదేవ ప్రభోః సన్తోషజనకం|</para>
  <para style="p">
    <verse number="21" style="v"/>హే పితరః, యుష్మాకం సన్తానా యత్ కాతరా న భవేయుస్తదర్థం తాన్ ప్రతి మా రోషయత|</para>
  <para style="p">
    <verse number="22" style="v"/>హే దాసాః, యూయం సర్వ్వవిషయ ఐహికప్రభూనామ్ ఆజ్ఞాగ్రాహిణో భవత దృష్టిగోచరీయసేవయా మానవేభ్యో రోచితుం మా యతధ్వం కిన్తు సరలాన్తఃకరణైః ప్రభో ర్భాीత్యా కార్య్యం కురుధ్వం|</para>
  <para style="p">
    <verse number="23" style="v"/>యచ్చ కురుధ్వే తత్ మానుషమనుద్దిశ్య ప్రభుమ్ ఉద్దిశ్య ప్రఫుల్లమనసా కురుధ్వం,</para>
  <para style="p">
    <verse number="24" style="v"/>యతో వయం ప్రభుతః స్వర్గాధికారరూపం ఫలం లప్స్యామహ ఇతి యూయం జానీథ యస్మాద్ యూయం ప్రభోః ఖ్రీష్టస్య దాసా భవథ|</para>
  <para style="p">
    <verse number="25" style="v"/>కిన్తు యః కశ్చిద్ అనుచితం కర్మ్మ కరోతి స తస్యానుచితకర్మ్మణః ఫలం లప్స్యతే తత్ర కోఽపి పక్షపాతో న భవిష్యతి|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అపరఞ్చ హే అధిపతయః, యూయం దాసాన్ ప్రతి న్యాయ్యం యథార్థఞ్చాచరణం కురుధ్వం యుష్మాకమప్యేకోఽధిపతిః స్వర్గే విద్యత ఇతి జానీత|</para>
  <para style="p">
    <verse number="2" style="v"/>యూయం ప్రార్థనాయాం నిత్యం ప్రవర్త్తధ్వం ధన్యవాదం కుర్వ్వన్తస్తత్ర ప్రబుద్ధాస్తిష్ఠత చ|</para>
  <para style="p">
    <verse number="3" style="v"/>ప్రార్థనాకాలే మమాపి కృతే ప్రార్థనాం కురుధ్వం,</para>
  <para style="p">
    <verse number="4" style="v"/>ఫలతః ఖ్రీష్టస్య యన్నిగూఢవాక్యకారణాద్ అహం బద్ధోఽభవం తత్ప్రకాశాయేశ్వరో యత్ మదర్థం వాగ్ద్వారం కుర్య్యాత్, అహఞ్చ యథోచితం తత్ ప్రకాశయితుం శక్నుయామ్ ఏతత్ ప్రార్థయధ్వం|</para>
  <para style="p">
    <verse number="5" style="v"/>యూయం సమయం బహుమూల్యం జ్ఞాత్వా బహిఃస్థాన్ లోకాన్ ప్రతి జ్ఞానాచారం కురుధ్వం|</para>
  <para style="p">
    <verse number="6" style="v"/>యుష్మాకమ్ ఆలాపః సర్వ్వదానుగ్రహసూచకో లవణేన సుస్వాదుశ్చ భవతు యస్మై యదుత్తరం దాతవ్యం తద్ యుష్మాభిరవగమ్యతాం|</para>
  <para style="p">
    <verse number="7" style="v"/>మమ యా దశాక్తి తాం తుఖికనామా ప్రభౌ ప్రియో మమ భ్రాతా విశ్వసనీయః పరిచారకః సహదాసశ్చ యుష్మాన్ జ్ఞాపయిష్యతి|</para>
  <para style="p">
    <verse number="8" style="v"/>స యద్ యుష్మాకం దశాం జానీయాత్ యుష్మాకం మనాంసి సాన్త్వయేచ్చ తదర్థమేవాహం</para>
  <para style="p">
    <verse number="9" style="v"/>తమ్ ఓనీషిమనామానఞ్చ యుష్మద్దేశీయం విశ్వస్తం ప్రియఞ్చ భ్రాతరం ప్రేషితవాన్ తౌ యుష్మాన్ అత్రత్యాం సర్వ్వవార్త్తాం జ్ఞాపయిష్యతః|</para>
  <para style="p">
    <verse number="10" style="v"/>ఆరిష్టార్ఖనామా మమ సహబన్దీ బర్ణబ్బా భాగినేయో మార్కో యుష్టనామ్నా విఖ్యాతో యీశుశ్చైతే ఛిన్నత్వచో భ్రాతరో యుష్మాన్ నమస్కారం జ్ఞాపయన్తి, తేషాం మధ్యే మార్కమధి యూయం పూర్వ్వమ్ ఆజ్ఞాపితాః స యది యుష్మత్సమీపమ్ ఉపతిష్ఠేత్ తర్హి యుష్మాభి ర్గృహ్యతాం|</para>
  <para style="p">
    <verse number="11" style="v"/>కేవలమేత ఈశ్వరరాజ్యే మమ సాన్త్వనాజనకాః సహకారిణోఽభవన్|</para>
  <para style="p">
    <verse number="12" style="v"/>ఖ్రీష్టస్య దాసో యో యుష్మద్దేశీయ ఇపఫ్రాః స యుష్మాన్ నమస్కారం జ్ఞాపయతి యూయఞ్చేశ్వరస్య సర్వ్వస్మిన్ మనోఽభిలాషే యత్ సిద్ధాః పూర్ణాశ్చ భవేత తదర్థం స నిత్యం ప్రార్థనయా యుష్మాకం కృతే యతతే|</para>
  <para style="p">
    <verse number="13" style="v"/>యుష్మాకం లాయదికేయాస్థితానాం హియరాపలిస్థితానాఞ్చ భ్రాతృణాం హితాయ సోఽతీవ చేష్టత ఇత్యస్మిన్ అహం తస్య సాక్షీ భవామి|</para>
  <para style="p">
    <verse number="14" style="v"/>లూకనామా ప్రియశ్చికిత్సకో దీమాశ్చ యుష్మభ్యం నమస్కుర్వ్వాతే|</para>
  <para style="p">
    <verse number="15" style="v"/>యూయం లాయదికేయాస్థాన్ భ్రాతృన్ నుమ్ఫాం తద్గృహస్థితాం సమితిఞ్చ మమ నమస్కారం జ్ఞాపయత|</para>
  <para style="p">
    <verse number="16" style="v"/>అపరం యుష్మత్సన్నిధౌ పత్రస్యాస్య పాఠే కృతే లాయదికేయాస్థసమితావపి తస్య పాఠో యథా భవేత్ లాయదికేయాఞ్చ యత్ పత్రం మయా ప్రహితం తద్ యథా యుష్మాభిరపి పఠ్యేత తథా చేష్టధ్వం|</para>
  <para style="p">
    <verse number="17" style="v"/>అపరమ్ ఆర్ఖిప్పం వదత ప్రభో ర్యత్ పరిచర్య్యాపదం త్వయాప్రాపి తత్సాధనాయ సావధానో భవ|</para>
  <para style="p">
    <verse number="18" style="v"/>అహం పౌలః స్వహస్తాక్షరేణ యుష్మాన్ నమస్కారం జ్ఞాపయామి యూయం మమ బన్ధనం స్మరత| యుష్మాన్ ప్రత్యనుగ్రహో భూయాత్| ఆమేన|</para>
</usx>
