<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="3JN" style="id">Sanskrit Bible (NT) in Telugu Script (సత్యవేదః।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">3 John</para>
  <para style="toc1">3 యోహనః పత్రం</para>
  <para style="toc2">3 యోహనః</para>
  <para style="toc3">3 యోహనః</para>
  <para style="mt1">3 యోహనః పత్రం</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>ప్రాచీనో ఽహం సత్యమతాద్ యస్మిన్ ప్రీయే తం ప్రియతమం గాయం ప్రతి పత్రం లిఖామి|</para>
  <para style="p">
    <verse number="2" style="v"/>హే ప్రియ, తవాత్మా యాదృక్ శుభాన్వితస్తాదృక్ సర్వ్వవిషయే తవ శుభం స్వాస్థ్యఞ్చ భూయాత్|</para>
  <para style="p">
    <verse number="3" style="v"/>భ్రాతృభిరాగత్య తవ సత్యమతస్యార్థతస్త్వం కీదృక్ సత్యమతమాచరస్యేతస్య సాక్ష్యే దత్తే మమ మహానన్దో జాతః|</para>
  <para style="p">
    <verse number="4" style="v"/>మమ సన్తానాః సత్యమతమాచరన్తీతివార్త్తాతో మమ య ఆనన్దో జాయతే తతో మహత్తరో నాస్తి|</para>
  <para style="p">
    <verse number="5" style="v"/>హే ప్రియ, భ్రాతృన్ ప్రతి విశేషతస్తాన్ విదేశినో భృाతృన్ ప్రతి త్వయా యద్యత్ కృతం తత్ సర్వ్వం విశ్వాసినో యోగ్యం|</para>
  <para style="p">
    <verse number="6" style="v"/>తే చ సమితేః సాక్షాత్ తవ ప్రమ్నః ప్రమాణం దత్తవన్తః, అపరమ్ ఈశ్వరయోగ్యరూపేణ తాన్ ప్రస్థాపయతా త్వయా సత్కర్మ్మ కారిష్యతే|</para>
  <para style="p">
    <verse number="7" style="v"/>యతస్తే తస్య నామ్నా యాత్రాం విధాయ భిన్నజాతీయేభ్యః కిమపి న గృహీతవన్తః|</para>
  <para style="p">
    <verse number="8" style="v"/>తస్మాద్ వయం యత్ సత్యమతస్య సహాయా భవేమ తదర్థమేతాదృశా లోకా అస్మాభిరనుగ్రహీతవ్యాః|</para>
  <para style="p">
    <verse number="9" style="v"/>సమితిం ప్రత్యహం పత్రం లిఖితవాన్ కిన్తు తేషాం మధ్యే యో దియత్రిఫిః ప్రధానాయతే సో ఽస్మాన్ న గృహ్లాతి|</para>
  <para style="p">
    <verse number="10" style="v"/>అతో ఽహం యదోపస్థాస్యామి తదా తేన యద్యత్ క్రియతే తత్ సర్వ్వం తం స్మారయిష్యామి, యతః స దుర్వ్వాక్యైరస్మాన్ అపవదతి, తేనాపి తృప్తిం న గత్వా స్వయమపి భ్రాతృన్ నానుగృహ్లాతి యే చానుగ్రహీతుమిచ్ఛన్తి తాన్ సమితితో ఽపి బహిష్కరోతి|</para>
  <para style="p">
    <verse number="11" style="v"/>హే ప్రియ, త్వయా దుష్కర్మ్మ నానుక్రియతాం కిన్తు సత్కర్మ్మైవ| యః సత్కర్మ్మాచారీ స ఈశ్వరాత్ జాతః, యో దుష్కర్మ్మాచారీ స ఈశ్వరం న దృష్టవాన్|</para>
  <para style="p">
    <verse number="12" style="v"/>దీమీత్రియస్య పక్షే సర్వ్వైః సాక్ష్యమ్ అదాయి విశేషతః సత్యమతేనాపి, వయమపి తత్పక్షే సాక్ష్యం దద్మః, అస్మాకఞ్చ సాక్ష్యం సత్యమేవేతి యూయం జానీథ|</para>
  <para style="p">
    <verse number="13" style="v"/>త్వాం ప్రతి మయా బహూని లేఖితవ్యాని కిన్తు మసీలేఖనీభ్యాం లేఖితుం నేచ్ఛామి|</para>
  <para style="p">
    <verse number="14" style="v"/>అచిరేణ త్వాం ద్రక్ష్యామీతి మమ ప్రత్యాశాస్తే తదావాం సమ్ముఖీభూయ పరస్పరం సమ్భాషిష్యావహే|</para>
  <para style="p">
    <verse number="15" style="v"/>తవ శాన్తి ర్భూయాత్| అస్మాకం మిత్రాణి త్వాం నమస్కారం జ్ఞాపయన్తి త్వమప్యేకైకస్య నామ ప్రోచ్య మిత్రేభ్యో నమస్కురు| ఇతి|</para>
</usx>
