<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="JUD" style="id">Sanskrit Bible (NT) in Telugu Script (సత్యవేదః।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">Jude</para>
  <para style="toc1">యిహూదాః పత్రం</para>
  <para style="toc2">యిహూదాః</para>
  <para style="toc3">యిహూదాః</para>
  <para style="mt1">యిహూదాః పత్రం</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>యీశుఖ్రీష్టస్య దాసో యాకూబో భ్రాతా యిహూదాస్తాతేనేశ్వరేణ పవిత్రీకృతాన్ యీశుఖ్రీష్టేన రక్షితాంశ్చాహూతాన్ లోకాన్ ప్రతి పత్రం లిఖతి|</para>
  <para style="p">
    <verse number="2" style="v"/>కృపా శాన్తిః ప్రేమ చ బాహుల్యరూపేణ యుష్మాస్వధితిష్ఠతు|</para>
  <para style="p">
    <verse number="3" style="v"/>హే ప్రియాః, సాధారణపరిత్రాణమధి యుష్మాన్ ప్రతి లేఖితుం మమ బహుయత్నే జాతే పూర్వ్వకాలే పవిత్రలోకేషు సమర్పితో యో ధర్మ్మస్తదర్థం యూయం ప్రాణవ్యయేనాపి సచేష్టా భవతేతి వినయార్థం యుష్మాన్ ప్రతి పత్రలేఖనమావశ్యకమ్ అమన్యే|</para>
  <para style="p">
    <verse number="4" style="v"/>యస్మాద్ ఏతద్రూపదణ్డప్రాప్తయే పూర్వ్వం లిఖితాః కేచిజ్జనా అస్మాన్ ఉపసృప్తవన్తః, తే ఽధార్మ్మికలోకా అస్మాకమ్ ఈశ్వరస్యానుగ్రహం ధ్వజీకృత్య లమ్పటతామ్ ఆచరన్తి, అద్వితీయో ఽధిపతి ర్యో ఽస్మాకం ప్రభు ర్యీశుఖ్రీష్టస్తం నాఙ్గీకుర్వ్వన్తి|</para>
  <para style="p">
    <verse number="5" style="v"/>తస్మాద్ యూయం పురా యద్ అవగతాస్తత్ పున ర్యుష్మాన్ స్మారయితుమ్ ఇచ్ఛామి, ఫలతః ప్రభురేకకృత్వః స్వప్రజా మిసరదేశాద్ ఉదధార యత్ తతః పరమ్ అవిశ్వాసినో వ్యనాశయత్|</para>
  <para style="p">
    <verse number="6" style="v"/>యే చ స్వర్గదూతాః స్వీయకర్తృత్వపదే న స్థిత్వా స్వవాసస్థానం పరిత్యక్తవన్తస్తాన్ స మహాదినస్య విచారార్థమ్ అన్ధకారమయే ఽధఃస్థానే సదాస్థాయిభి ర్బన్ధనైరబధ్నాత్|</para>
  <para style="p">
    <verse number="7" style="v"/>అపరం సిదోమమ్ అమోరా తన్నికటస్థనగరాణి చైతేషాం నివాసినస్తత్సమరూపం వ్యభిచారం కృతవన్తో విషమమైథునస్య చేష్టయా విపథం గతవన్తశ్చ తస్మాత్ తాన్యపి దృష్టాన్తస్వరూపాణి భూత్వా సదాతనవహ్నినా దణ్డం భుఞ్జతే|</para>
  <para style="p">
    <verse number="8" style="v"/>తథైవేమే స్వప్నాచారిణోఽపి స్వశరీరాణి కలఙ్కయన్తి రాజాధీనతాం న స్వీకుర్వ్వన్త్యుచ్చపదస్థాన్ నిన్దన్తి చ|</para>
  <para style="p">
    <verse number="9" style="v"/>కిన్తు ప్రధానదివ్యదూతో మీఖాయేలో యదా మూససో దేహే శయతానేన వివదమానః సమభాషత తదా తిస్మన్ నిన్దారూపం దణ్డం సమర్పయితుం సాహసం న కృత్వాకథయత్ ప్రభుస్త్వాం భర్త్సయతాం|</para>
  <para style="p">
    <verse number="10" style="v"/>కిన్త్విమే యన్న బుధ్యన్తే తన్నిన్దన్తి యచ్చ నిర్బ్బోధపశవ ఇవేన్ద్రియైరవగచ్ఛన్తి తేన నశ్యన్తి|</para>
  <para style="p">
    <verse number="11" style="v"/>తాన్ ధిక్, తే కాబిలో మార్గే చరన్తి పారితోషికస్యాశాతో బిలియమో భ్రాన్తిమనుధావన్తి కోరహస్య దుర్మ్ముఖత్వేన వినశ్యన్తి చ|</para>
  <para style="p">
    <verse number="12" style="v"/>యుష్మాకం ప్రేమభోజ్యేషు తే విఘ్నజనకా భవన్తి, ఆత్మమ్భరయశ్చ భూత్వా నిర్లజ్జయా యుష్మాభిః సార్ద్ధం భుఞ్జతే| తే వాయుభిశ్చాలితా నిస్తోయమేఘా హేమన్తకాలికా నిష్ఫలా ద్వి ర్మృతా ఉన్మూలితా వృక్షాః,</para>
  <para style="p">
    <verse number="13" style="v"/>స్వకీయలజ్జాఫేణోద్వమకాః ప్రచణ్డాః సాముద్రతరఙ్గాః సదాకాలం యావత్ ఘోరతిమిరభాగీని భ్రమణకారీణి నక్షత్రాణి చ భవన్తి|</para>
  <para style="p">
    <verse number="14" style="v"/>ఆదమతః సప్తమః పురుషో యో హనోకః స తానుద్దిశ్య భవిష్యద్వాక్యమిదం కథితవాన్, యథా, పశ్య స్వకీయపుణ్యానామ్ అయుతై ర్వేష్టితః ప్రభుః|</para>
  <para style="p">
    <verse number="15" style="v"/>సర్వ్వాన్ ప్రతి విచారాజ్ఞాసాధనాయాగమిష్యతి| తదా చాధార్మ్మికాః సర్వ్వే జాతా యైరపరాధినః| విధర్మ్మకర్మ్మణాం తేషాం సర్వ్వేషామేవ కారణాత్| తథా తద్వైపరీత్యేనాప్యధర్మ్మాచారిపాపినాం| ఉక్తకఠోరవాక్యానాం సర్వ్వేషామపి కారణాత్| పరమేశేన దోషిత్వం తేషాం ప్రకాశయిష్యతే||</para>
  <para style="p">
    <verse number="16" style="v"/>తే వాక్కలహకారిణః స్వభాగ్యనిన్దకాః స్వేచ్ఛాచారిణో దర్పవాదిముఖవిశిష్టా లాభార్థం మనుష్యస్తావకాశ్చ సన్తి|</para>
  <para style="p">
    <verse number="17" style="v"/>కిన్తు హే ప్రియతమాః, అస్మాకం ప్రభో ర్యీశుఖ్రీష్టస్య ప్రేరితై ర్యద్ వాక్యం పూర్వ్వం యుష్మభ్యం కథితం తత్ స్మరత,</para>
  <para style="p">
    <verse number="18" style="v"/>ఫలతః శేషసమయే స్వేచ్ఛాతో ఽధర్మ్మాచారిణో నిన్దకా ఉపస్థాస్యన్తీతి|</para>
  <para style="p">
    <verse number="19" style="v"/>ఏతే లోకాః స్వాన్ పృథక్ కుర్వ్వన్తః సాంసారికా ఆత్మహీనాశ్చ సన్తి|</para>
  <para style="p">
    <verse number="20" style="v"/>కిన్తు హే ప్రియతమాః, యూయం స్వేషామ్ అతిపవిత్రవిశ్వాసే నిచీయమానాః పవిత్రేణాత్మనా ప్రార్థనాం కుర్వ్వన్త</para>
  <para style="p">
    <verse number="21" style="v"/>ఈశ్వరస్య ప్రేమ్నా స్వాన్ రక్షత, అనన్తజీవనాయ చాస్మాకం ప్రభో ర్యీశుఖ్రీష్టస్య కృపాం ప్రతీక్షధ్వం|</para>
  <para style="p">
    <verse number="22" style="v"/>అపరం యూయం వివిచ్య కాంశ్చిద్ అనుకమ్పధ్వం</para>
  <para style="p">
    <verse number="23" style="v"/>కాంశ్చిద్ అగ్నిత ఉద్ధృత్య భయం ప్రదర్శ్య రక్షత, శారీరికభావేన కలఙ్కితం వస్త్రమపి ఋతీయధ్వం|</para>
  <para style="p">
    <verse number="24" style="v"/>అపరఞ్చ యుష్మాన్ స్ఖలనాద్ రక్షితుమ్ ఉల్లాసేన స్వీయతేజసః సాక్షాత్ నిర్ద్దోషాన్ స్థాపయితుఞ్చ సమర్థో</para>
  <para style="p">
    <verse number="25" style="v"/>యో ఽస్మాకమ్ అద్వితీయస్త్రాణకర్త్తా సర్వ్వజ్ఞ ఈశ్వరస్తస్య గౌరవం మహిమా పరాక్రమః కర్తృత్వఞ్చేదానీమ్ అనన్తకాలం యావద్ భూయాత్| ఆమేన్|</para>
</usx>
