<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="1TH" style="id">Sanskrit Bible (NT) in Telugu Script (సత్యవేదః।)</book>
  <para style="rem">© SanskritBible.in । Licensed under CC BY-SA 4.0</para>
  <para style="h">1 Thessalonians</para>
  <para style="toc1">1 థిషలనీకినః పత్రం</para>
  <para style="toc2">1 థిషలనీకినః</para>
  <para style="toc3">1 థిషలనీకినః</para>
  <para style="mt1">1 థిషలనీకినః పత్రం</para>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>పౌలః సిల్వానస్తీమథియశ్చ పితురీశ్వరస్య ప్రభో ర్యీశుఖ్రీష్టస్య చాశ్రయం ప్రాప్తా థిషలనీకీయసమితిం ప్రతి పత్రం లిఖన్తి| అస్మాకం తాత ఈశ్వరః ప్రభు ర్యీశుఖ్రీష్టశ్చ యుష్మాన్ ప్రత్యనుగ్రహం శాన్తిఞ్చ క్రియాస్తాం|</para>
  <para style="p">
    <verse number="2" style="v"/>వయం సర్వ్వేషాం యుష్మాకం కృతే ఈశ్వరం ధన్యం వదామః ప్రార్థనాసమయే యుష్మాకం నామోచ్చారయామః,</para>
  <para style="p">
    <verse number="3" style="v"/>అస్మాకం తాతస్యేశ్వరస్య సాక్షాత్ ప్రభౌ యీశుఖ్రీష్టే యుష్మాకం విశ్వాసేన యత్ కార్య్యం ప్రేమ్నా యః పరిశ్రమః ప్రత్యాశయా చ యా తితిక్షా జాయతే</para>
  <para style="p">
    <verse number="4" style="v"/>తత్ సర్వ్వం నిరన్తరం స్మరామశ్చ| హే పియభ్రాతరః, యూయమ్ ఈశ్వరేణాభిరుచితా లోకా ఇతి వయం జానీమః|</para>
  <para style="p">
    <verse number="5" style="v"/>యతోఽస్మాకం సుసంవాదః కేవలశబ్దేన యుష్మాన్ న ప్రవిశ్య శక్త్యా పవిత్రేణాత్మనా మహోత్సాహేన చ యుష్మాన్ ప్రావిశత్| వయన్తు యుష్మాకం కృతే యుష్మన్మధ్యే కీదృశా అభవామ తద్ యుష్మాభి ర్జ్ఞాయతే|</para>
  <para style="p">
    <verse number="6" style="v"/>యూయమపి బహుక్లేశభోగేన పవిత్రేణాత్మనా దత్తేనానన్దేన చ వాక్యం గృహీత్వాస్మాకం ప్రభోశ్చానుగామినోఽభవత|</para>
  <para style="p">
    <verse number="7" style="v"/>తేన మాకిదనియాఖాయాదేశయో ర్యావన్తో విశ్వాసినో లోకాః సన్తి యూయం తేషాం సర్వ్వేషాం నిదర్శనస్వరూపా జాతాః|</para>
  <para style="p">
    <verse number="8" style="v"/>యతో యుష్మత్తః ప్రతినాదితయా ప్రభో ర్వాణ్యా మాకిదనియాఖాయాదేశౌ వ్యాప్తౌ కేవలమేతన్నహి కిన్త్వీశ్వరే యుష్మాకం యో విశ్వాసస్తస్య వార్త్తా సర్వ్వత్రాశ్రావి, తస్మాత్ తత్ర వాక్యకథనమ్ అస్మాకం నిష్ప్రయోజనం|</para>
  <para style="p">
    <verse number="9" style="v"/>యతో యుష్మన్మధ్యే వయం కీదృశం ప్రవేశం ప్రాప్తా యూయఞ్చ కథం ప్రతిమా విహాయేశ్వరం ప్రత్యావర్త్తధ్వమ్ అమరం సత్యమీశ్వరం సేవితుం</para>
  <para style="p">
    <verse number="10" style="v"/>మృతగణమధ్యాచ్చ తేనోత్థాపితస్య పుత్రస్యార్థత ఆగామిక్రోధాద్ అస్మాకం నిస్తారయితు ర్యీశోః స్వర్గాద్ ఆగమనం ప్రతీక్షితుమ్ ఆరభధ్వమ్ ఏతత్ సర్వ్వం తే లోకాః స్వయమ్ అస్మాన్ జ్ఞాపయన్తి|</para>
  <chapter number="2" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>హే భ్రాతరః, యుష్మన్మధ్యే ఽస్మాకం ప్రవేశో నిష్ఫలో న జాత ఇతి యూయం స్వయం జానీథ|</para>
  <para style="p">
    <verse number="2" style="v"/>అపరం యుష్మాభి ర్యథాశ్రావి తథా పూర్వ్వం ఫిలిపీనగరే క్లిష్టా నిన్దితాశ్చ సన్తోఽపి వయమ్ ఈశ్వరాద్ ఉత్సాహం లబ్ధ్వా బహుయత్నేన యుష్మాన్ ఈశ్వరస్య సుసంవాదమ్ అబోధయామ|</para>
  <para style="p">
    <verse number="3" style="v"/>యతోఽస్మాకమ్ ఆదేశో భ్రాన్తేరశుచిభావాద్ వోత్పన్నః ప్రవఞ్చనాయుక్తో వా న భవతి|</para>
  <para style="p">
    <verse number="4" style="v"/>కిన్త్వీశ్వరేణాస్మాన్ పరీక్ష్య విశ్వసనీయాన్ మత్త్వా చ యద్వత్ సుసంవాదోఽస్మాసు సమార్ప్యత తద్వద్ వయం మానవేభ్యో న రురోచిషమాణాః కిన్త్వస్మదన్తఃకరణానాం పరీక్షకాయేశ్వరాయ రురోచిషమాణా భాషామహే|</para>
  <para style="p">
    <verse number="5" style="v"/>వయం కదాపి స్తుతివాదినో నాభవామేతి యూయం జానీథ కదాపి ఛలవస్త్రేణ లోభం నాచ్ఛాదయామేత్యస్మిన్ ఈశ్వరః సాక్షీ విద్యతే|</para>
  <para style="p">
    <verse number="6" style="v"/>వయం ఖ్రీష్టస్య ప్రేరితా ఇవ గౌరవాన్వితా భవితుమ్ అశక్ష్యామ కిన్తు యుష్మత్తః పరస్మాద్ వా కస్మాదపి మానవాద్ గౌరవం న లిప్సమానా యుష్మన్మధ్యే మృదుభావా భూత్వావర్త్తామహి|</para>
  <para style="p">
    <verse number="7" style="v"/>యథా కాచిన్మాతా స్వకీయశిశూన్ పాలయతి తథా వయమపి యుష్మాన్ కాఙ్క్షమాణా</para>
  <para style="p">
    <verse number="8" style="v"/>యుష్మభ్యం కేవలమ్ ఈశ్వరస్య సుసంవాదం తన్నహి కిన్తు స్వకీయప్రాణాన్ అపి దాతుం మనోభిరభ్యలషామ, యతో యూయమ్ అస్మాకం స్నేహపాత్రాణ్యభవత|</para>
  <para style="p">
    <verse number="9" style="v"/>హే భ్రాతరః, అస్మాకం శ్రమః క్లేेశశ్చ యుష్మాభిః స్మర్య్యతే యుష్మాకం కోఽపి యద్ భారగ్రస్తో న భవేత్ తదర్థం వయం దివానిశం పరిశ్రామ్యన్తో యుష్మన్మధ్య ఈశ్వరస్య సుసంవాదమఘోషయామ|</para>
  <para style="p">
    <verse number="10" style="v"/>అపరఞ్చ విశ్వాసినో యుష్మాన్ ప్రతి వయం కీదృక్ పవిత్రత్వయథార్థత్వనిర్దోషత్వాచారిణోఽభవామేత్యస్మిన్ ఈశ్వరో యూయఞ్చ సాక్షిణ ఆధ్వే|</para>
  <para style="p">
    <verse number="11" style="v"/>అపరఞ్చ యద్వత్ పితా స్వబాలకాన్ తద్వద్ వయం యుష్మాకమ్ ఏకైకం జనమ్ ఉపదిష్టవన్తః సాన్త్వితవన్తశ్చ,</para>
  <para style="p">
    <verse number="12" style="v"/>య ఈశ్వరః స్వీయరాజ్యాయ విభవాయ చ యుష్మాన్ ఆహూతవాన్ తదుపయుక్తాచరణాయ యుష్మాన్ ప్రవర్త్తితవన్తశ్చేతి యూయం జానీథ|</para>
  <para style="p">
    <verse number="13" style="v"/>యస్మిన్ సమయే యూయమ్ అస్మాకం ముఖాద్ ఈశ్వరేణ ప్రతిశ్రుతం వాక్యమ్ అలభధ్వం తస్మిన్ సమయే తత్ మానుషాణాం వాక్యం న మత్త్వేశ్వరస్య వాక్యం మత్త్వా గృహీతవన్త ఇతి కారణాద్ వయం నిరన్తరమ్ ఈశ్వరం ధన్యం వదామః, యతస్తద్ ఈశ్వరస్య వాక్యమ్ ఇతి సత్యం విశ్వాసినాం యుష్మాకం మధ్యే తస్య గుణః ప్రకాశతే చ|</para>
  <para style="p">
    <verse number="14" style="v"/>హే భ్రాతరః, ఖ్రీష్టాశ్రితవత్య ఈశ్వరస్య యాః సమిత్యో యిహూదాదేశే సన్తి యూయం తాసామ్ అనుకారిణోఽభవత, తద్భుక్తా లోకాశ్చ యద్వద్ యిహూదిలోకేభ్యస్తద్వద్ యూయమపి స్వజాతీయలోకేభ్యో దుఃఖమ్ అలభధ్వం|</para>
  <para style="p">
    <verse number="15" style="v"/>తే యిహూదీయాః ప్రభుం యీశుం భవిష్యద్వాదినశ్చ హతవన్తో ఽస్మాన్ దూరీకృతవన్తశ్చ, త ఈశ్వరాయ న రోచన్తే సర్వ్వేషాం మానవానాం విపక్షా భవన్తి చ;</para>
  <para style="p">
    <verse number="16" style="v"/>అపరం భిన్నజాతీయలోకానాం పరిత్రాణార్థం తేషాం మధ్యే సుసంవాదఘోషణాద్ అస్మాన్ ప్రతిషేధన్తి చేత్థం స్వీయపాపానాం పరిమాణమ్ ఉత్తరోత్తరం పూరయన్తి, కిన్తు తేషామ్ అన్తకారీ క్రోధస్తాన్ ఉపక్రమతే|</para>
  <para style="p">
    <verse number="17" style="v"/>హే భ్రాతరః మనసా నహి కిన్తు వదనేన కియత్కాలం యుష్మత్తో ఽస్మాకం విచ్ఛేదే జాతే వయం యుష్మాకం ముఖాని ద్రష్టుమ్ అత్యాకాఙ్క్షయా బహు యతితవన్తః|</para>
  <para style="p">
    <verse number="18" style="v"/>ద్విరేకకృత్వో వా యుష్మత్సమీపగమనాయాస్మాకం విశేషతః పౌలస్య మమాభిలాషోఽభవత్ కిన్తు శయతానో ఽస్మాన్ నివారితవాన్|</para>
  <para style="p">
    <verse number="19" style="v"/>యతోఽస్మాకం కా ప్రత్యాశా కో వానన్దః కిం వా శ్లాఘ్యకిరీటం? అస్మాకం ప్రభో ర్యీశుఖ్రీష్టస్యాగమనకాలే తత్సమ్ముఖస్థా యూయం కిం తన్న భవిష్యథ?</para>
  <para style="p">
    <verse number="20" style="v"/>యూయమ్ ఏవాస్మాకం గౌరవానన్దస్వరూపా భవథ|</para>
  <chapter number="3" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>అతోఽహం యదా సన్దేహం పునః సోఢుం నాశక్నువం తదానీమ్ ఆథీనీనగర ఏకాకీ స్థాతుం నిశ్చిత్య</para>
  <para style="p">
    <verse number="2" style="v"/>స్వభ్రాతరం ఖ్రీష్టస్య సుసంవాదే సహకారిణఞ్చేశ్వరస్య పరిచారకం తీమథియం యుష్మత్సమీపమ్ అప్రేషయం|</para>
  <para style="p">
    <verse number="3" style="v"/>వర్త్తమానైః క్లేశైః కస్యాపి చాఞ్చల్యం యథా న జాయతే తథా తే త్వయా స్థిరీక్రియన్తాం స్వకీయధర్మ్మమధి సమాశ్వాస్యన్తాఞ్చేతి తమ్ ఆదిశం|</para>
  <para style="p">
    <verse number="4" style="v"/>వయమేతాదృశే క్లేेశే నియుక్తా ఆస్మహ ఇతి యూయం స్వయం జానీథ, యతోఽస్మాకం దుర్గతి ర్భవిష్యతీతి వయం యుష్మాకం సమీపే స్థితికాలేఽపి యుష్మాన్ అబోధయామ, తాదృశమేవ చాభవత్ తదపి జానీథ|</para>
  <para style="p">
    <verse number="5" style="v"/>తస్మాత్ పరీక్షకేణ యుష్మాసు పరీక్షితేష్వస్మాకం పరిశ్రమో విఫలో భవిష్యతీతి భయం సోఢుం యదాహం నాశక్నువం తదా యుష్మాకం విశ్వాసస్య తత్త్వావధారణాయ తమ్ అప్రేషయం|</para>
  <para style="p">
    <verse number="6" style="v"/>కిన్త్వధునా తీమథియో యుష్మత్సమీపాద్ అస్మత్సన్నిధిమ్ ఆగత్య యుష్మాకం విశ్వాసప్రేమణీ అధ్యస్మాన్ సువార్త్తాం జ్ఞాపితవాన్ వయఞ్చ యథా యుష్మాన్ స్మరామస్తథా యూయమప్యస్మాన్ సర్వ్వదా ప్రణయేన స్మరథ ద్రష్టుమ్ ఆకాఙ్క్షధ్వే చేతి కథితవాన్|</para>
  <para style="p">
    <verse number="7" style="v"/>హే భ్రాతరః, వార్త్తామిమాం ప్రాప్య యుష్మానధి విశేషతో యుష్మాకం క్లేశదుఃఖాన్యధి యుష్మాకం విశ్వాసాద్ అస్మాకం సాన్త్వనాజాయత;</para>
  <para style="p">
    <verse number="8" style="v"/>యతో యూయం యది ప్రభావవతిష్ఠథ తర్హ్యనేన వయమ్ అధునా జీవామః|</para>
  <para style="p">
    <verse number="9" style="v"/>వయఞ్చాస్మదీయేశ్వరస్య సాక్షాద్ యుష్మత్తో జాతేన యేనానన్దేన ప్రఫుల్లా భవామస్తస్య కృత్స్నస్యానన్దస్య యోగ్యరూపేణేశ్వరం ధన్యం వదితుం కథం శక్ష్యామః?</para>
  <para style="p">
    <verse number="10" style="v"/>వయం యేన యుష్మాకం వదనాని ద్రష్టుం యుష్మాకం విశ్వాసే యద్ అసిద్ధం విద్యతే తత్ సిద్ధీకర్త్తుఞ్చ శక్ష్యామస్తాదృశం వరం దివానిశం ప్రార్థయామహే|</para>
  <para style="p">
    <verse number="11" style="v"/>అస్మాకం తాతేనేశ్వరేణ ప్రభునా యీశుఖ్రీష్టేన చ యుష్మత్సమీపగమనాయాస్మాకం పన్థా సుగమః క్రియతాం|</para>
  <para style="p">
    <verse number="12" style="v"/>పరస్పరం సర్వ్వాంశ్చ ప్రతి యుష్మాకం ప్రేమ యుష్మాన్ ప్రతి చాస్మాకం ప్రేమ ప్రభునా వర్ద్ధ్యతాం బహుఫలం క్రియతాఞ్చ|</para>
  <para style="p">
    <verse number="13" style="v"/>అపరమస్మాకం ప్రభు ర్యీశుఖ్రీష్టః స్వకీయైః సర్వ్వైః పవిత్రలోకైః సార్ద్ధం యదాగమిష్యతి తదా యూయం యథాస్మాకం తాతస్యేశ్వరస్య సమ్ముఖే పవిత్రతయా నిర్దోషా భవిష్యథ తథా యుష్మాకం మనాంసి స్థిరీక్రియన్తాం|</para>
  <chapter number="4" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>హే భ్రాతరః, యుష్మాభిః కీదృగ్ ఆచరితవ్యం ఈశ్వరాయ రోచితవ్యఞ్చ తదధ్యస్మత్తో యా శిక్షా లబ్ధా తదనుసారాత్ పునరతిశయం యత్నః క్రియతామితి వయం ప్రభుయీశునా యుష్మాన్ వినీయాదిశామః|</para>
  <para style="p">
    <verse number="2" style="v"/>యతో వయం ప్రభుయీశునా కీదృశీరాజ్ఞా యుష్మాసు సమర్పితవన్తస్తద్ యూయం జానీథ|</para>
  <para style="p">
    <verse number="3" style="v"/>ఈశ్వరస్యాయమ్ అభిలాషో యద్ యుష్మాకం పవిత్రతా భవేత్, యూయం వ్యభిచారాద్ దూరే తిష్ఠత|</para>
  <para style="p">
    <verse number="4" style="v"/>యుష్మాకమ్ ఏకైకో జనః స్వకీయం ప్రాణాధారం పవిత్రం మాన్యఞ్చ రక్షతు,</para>
  <para style="p">
    <verse number="5" style="v"/>యే చ భిన్నజాతీయా లోకా ఈశ్వరం న జానన్తి త ఇవ తత్ కామాభిలాషస్యాధీనం న కరోతు|</para>
  <para style="p">
    <verse number="6" style="v"/>ఏతస్మిన్ విషయే కోఽప్యత్యాచారీ భూత్వా స్వభ్రాతరం న వఞ్చయతు యతోఽస్మాభిః పూర్వ్వం యథోక్తం ప్రమాణీకృతఞ్చ తథైవ ప్రభురేతాదృశానాం కర్మ్మణాం సముచితం ఫలం దాస్యతి|</para>
  <para style="p">
    <verse number="7" style="v"/>యస్మాద్ ఈశ్వరోఽస్మాన్ అశుచితాయై నాహూతవాన్ కిన్తు పవిత్రత్వాయైవాహూతవాన్|</para>
  <para style="p">
    <verse number="8" style="v"/>అతో హేతో ర్యః కశ్చిద్ వాక్యమేతన్న గృహ్లాతి స మనుష్యమ్ అవజానాతీతి నహి యేన స్వకీయాత్మా యుష్మదన్తరే సమర్పితస్తమ్ ఈశ్వరమ్ ఏవావజానాతి|</para>
  <para style="p">
    <verse number="9" style="v"/>భ్రాతృషు ప్రేమకరణమధి యుష్మాన్ ప్రతి మమ లిఖనం నిష్ప్రయోజనం యతో యూయం పరస్పరం ప్రేమకరణాయేశ్వరశిక్షితా లోకా ఆధ్వే|</para>
  <para style="p">
    <verse number="10" style="v"/>కృత్స్నే మాకిదనియాదేశే చ యావన్తో భ్రాతరః సన్తి తాన్ సర్వ్వాన్ ప్రతి యుష్మాభిస్తత్ ప్రేమ ప్రకాశ్యతే తథాపి హే భ్రాతరః, వయం యుష్మాన్ వినయామహే యూయం పున ర్బహుతరం ప్రేమ ప్రకాశయత|</para>
  <para style="p">
    <verse number="11" style="v"/>అపరం యే బహిఃస్థితాస్తేషాం దృష్టిగోచరే యుష్మాకమ్ ఆచరణం యత్ మనోరమ్యం భవేత్ కస్యాపి వస్తునశ్చాభావో యుష్మాకం యన్న భవేత్,</para>
  <para style="p">
    <verse number="12" style="v"/>ఏతదర్థం యూయమ్ అస్మత్తో యాదృశమ్ ఆదేశం ప్రాప్తవన్తస్తాదృశం నిర్విరోధాచారం కర్త్తుం స్వస్వకర్మ్మణి మనాంమి నిధాతుం నిజకరైశ్చ కార్య్యం సాధయితుం యతధ్వం|</para>
  <para style="p">
    <verse number="13" style="v"/>హే భ్రాతరః నిరాశా అన్యే లోకా ఇవ యూయం యన్న శోచేధ్వం తదర్థం మహానిద్రాగతాన్ లోకానధి యుష్మాకమ్ అజ్ఞానతా మయా నాభిలష్యతే|</para>
  <para style="p">
    <verse number="14" style="v"/>యీశు ర్మృతవాన్ పునరుథితవాంశ్చేతి యది వయం విశ్వాసమస్తర్హి యీశుమ్ ఆశ్రితాన్ మహానిద్రాప్రాప్తాన్ లోకానపీశ్వరోఽవశ్యం తేన సార్ద్ధమ్ ఆనేష్యతి|</para>
  <para style="p">
    <verse number="15" style="v"/>యతోఽహం ప్రభో ర్వాక్యేన యుష్మాన్ ఇదం జ్ఞాపయామి; అస్మాకం మధ్యే యే జనాః ప్రభోరాగమనం యావత్ జీవన్తోఽవశేక్ష్యన్తే తే మహానిద్రితానామ్ అగ్రగామినోన న భవిష్యన్తి;</para>
  <para style="p">
    <verse number="16" style="v"/>యతః ప్రభుః సింహనాదేన ప్రధానస్వర్గదూతస్యోచ్చైః శబ్దేనేశ్వరీయతూరీవాద్యేన చ స్వయం స్వర్గాద్ అవరోక్ష్యతి తేన ఖ్రీష్టాశ్రితా మృతలోకాః ప్రథమమ్ ఉత్థాస్యాన్తి|</para>
  <para style="p">
    <verse number="17" style="v"/>అపరమ్ అస్మాకం మధ్యే యే జీవన్తోఽవశేక్ష్యన్తే త ఆకాశే ప్రభోః సాక్షాత్కరణార్థం తైః సార్ద్ధం మేఘవాహనేన హరిష్యన్తే; ఇత్థఞ్చ వయం సర్వ్వదా ప్రభునా సార్ద్ధం స్థాస్యామః|</para>
  <para style="p">
    <verse number="18" style="v"/>అతో యూయమ్ ఏతాభిః కథాభిః పరస్పరం సాన్త్వయత|</para>
  <chapter number="5" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>హే భ్రాతరః, కాలాన్ సమయాంశ్చాధి యుష్మాన్ ప్రతి మమ లిఖనం నిష్ప్రయోజనం,</para>
  <para style="p">
    <verse number="2" style="v"/>యతో రాత్రౌ యాదృక్ తస్కరస్తాదృక్ ప్రభో ర్దినమ్ ఉపస్థాస్యతీతి యూయం స్వయమేవ సమ్యగ్ జానీథ|</para>
  <para style="p">
    <verse number="3" style="v"/>శాన్తి ర్నిర్వ్విన్ఘత్వఞ్చ విద్యత ఇతి యదా మానవా వదిష్యన్తి తదా ప్రసవవేదనా యద్వద్ గర్బ్భినీమ్ ఉపతిష్ఠతి తద్వద్ అకస్మాద్ వినాశస్తాన్ ఉపస్థాస్యతి తైరుద్ధారో న లప్స్యతే|</para>
  <para style="p">
    <verse number="4" style="v"/>కిన్తు హే భ్రాతరః, యూయమ్ అన్ధకారేణావృతా న భవథ తస్మాత్ తద్దినం తస్కర ఇవ యుష్మాన్ న ప్రాప్స్యతి|</para>
  <para style="p">
    <verse number="5" style="v"/>సర్వ్వే యూయం దీప్తేః సన్తానా దివాయాశ్చ సన్తానా భవథ వయం నిశావంశాస్తిమిరవంశా వా న భవామః|</para>
  <para style="p">
    <verse number="6" style="v"/>అతో ఽపరే యథా నిద్రాగతాః సన్తి తద్వద్ అస్మాభి ర్న భవితవ్యం కిన్తు జాగరితవ్యం సచేతనైశ్చ భవితవ్యం|</para>
  <para style="p">
    <verse number="7" style="v"/>యే నిద్రాన్తి తే నిశాయామేవ నిద్రాన్తి తే చ మత్తా భవన్తి తే రజన్యామేవ మత్తా భవన్తి|</para>
  <para style="p">
    <verse number="8" style="v"/>కిన్తు వయం దివసస్య వంశా భవామః; అతో ఽస్మాభి ర్వక్షసి ప్రత్యయప్రేమరూపం కవచం శిరసి చ పరిత్రాణాశారూపం శిరస్త్రం పరిధాయ సచేతనై ర్భవితవ్యం|</para>
  <para style="p">
    <verse number="9" style="v"/>యత ఈశ్వరోఽస్మాన్ క్రోధే న నియుజ్యాస్మాకం ప్రభునా యీశుఖ్రీష్టేన పరిత్రాణస్యాధికారే నియుुక్తవాన్,</para>
  <para style="p">
    <verse number="10" style="v"/>జాగ్రతో నిద్రాగతా వా వయం యత్ తేన ప్రభునా సహ జీవామస్తదర్థం సోఽస్మాకం కృతే ప్రాణాన్ త్యక్తవాన్|</para>
  <para style="p">
    <verse number="11" style="v"/>అతఏవ యూయం యద్వత్ కురుథ తద్వత్ పరస్పరం సాన్త్వయత సుస్థిరీకురుధ్వఞ్చ|</para>
  <para style="p">
    <verse number="12" style="v"/>హే భ్రాతరః, యుష్మాకం మధ్యే యే జనాః పరిశ్రమం కుర్వ్వన్తి ప్రభో ర్నామ్నా యుష్మాన్ అధితిష్ఠన్త్యుపదిశన్తి చ తాన్ యూయం సమ్మన్యధ్వం|</para>
  <para style="p">
    <verse number="13" style="v"/>స్వకర్మ్మహేతునా చ ప్రేమ్నా తాన్ అతీవాదృయధ్వమితి మమ ప్రార్థనా, యూయం పరస్పరం నిర్వ్విరోధా భవత|</para>
  <para style="p">
    <verse number="14" style="v"/>హే భ్రాతరః, యుష్మాన్ వినయామహే యూయమ్ అవిహితాచారిణో లోకాన్ భర్త్సయధ్వం, క్షుద్రమనసః సాన్త్వయత, దుర్బ్బలాన్ ఉపకురుత, సర్వ్వాన్ ప్రతి సహిష్ణవో భవత చ|</para>
  <para style="p">
    <verse number="15" style="v"/>అపరం కమపి ప్రత్యనిష్టస్య ఫలమ్ అనిష్టం కేనాపి యన్న క్రియేత తదర్థం సావధానా భవత, కిన్తు పరస్పరం సర్వ్వాన్ మానవాంశ్చ ప్రతి నిత్యం హితాచారిణో భవత|</para>
  <para style="p">
    <verse number="16" style="v"/>సర్వ్వదానన్దత|</para>
  <para style="p">
    <verse number="17" style="v"/>నిరన్తరం ప్రార్థనాం కురుధ్వం|</para>
  <para style="p">
    <verse number="18" style="v"/>సర్వ్వవిషయే కృతజ్ఞతాం స్వీకురుధ్వం యత ఏతదేవ ఖ్రీష్టయీశునా యుష్మాన్ ప్రతి ప్రకాశితమ్ ఈశ్వరాభిమతం|</para>
  <para style="p">
    <verse number="19" style="v"/>పవిత్రమ్ ఆత్మానం న నిర్వ్వాపయత|</para>
  <para style="p">
    <verse number="20" style="v"/>ఈశ్వరీయాదేశం నావజానీత|</para>
  <para style="p">
    <verse number="21" style="v"/>సర్వ్వాణి పరీక్ష్య యద్ భద్రం తదేవ ధారయత|</para>
  <para style="p">
    <verse number="22" style="v"/>యత్ కిమపి పాపరూపం భవతి తస్మాద్ దూరం తిష్ఠత|</para>
  <para style="p">
    <verse number="23" style="v"/>శాన్తిదాయక ఈశ్వరః స్వయం యుష్మాన్ సమ్పూర్ణత్వేన పవిత్రాన్ కరోతు, అపరమ్ అస్మత్ప్రభో ర్యీశుఖ్రీష్టస్యాగమనం యావద్ యుష్మాకమ్ ఆత్మానః ప్రాణాః శరీరాణి చ నిఖిలాని నిర్ద్దోషత్వేన రక్ష్యన్తాం|</para>
  <para style="p">
    <verse number="24" style="v"/>యో యుష్మాన్ ఆహ్వయతి స విశ్వసనీయోఽతః స తత్ సాధయిష్యతి|</para>
  <para style="p">
    <verse number="25" style="v"/>హే భ్రాతరః, అస్మాకం కృతే ప్రార్థనాం కురుధ్వం|</para>
  <para style="p">
    <verse number="26" style="v"/>పవిత్రచుమ్బనేన సర్వ్వాన్ భ్రాతృన్ ప్రతి సత్కురుధ్వం|</para>
  <para style="p">
    <verse number="27" style="v"/>పత్రమిదం సర్వ్వేషాం పవిత్రాణాం భ్రాతృణాం శ్రుతిగోచరే యుష్మాభిః పఠ్యతామితి ప్రభో ర్నామ్నా యుష్మాన్ శపయామి|</para>
  <para style="p">
    <verse number="28" style="v"/>అస్మాకం ప్రభో ర్యీశుఖ్రీష్టస్యానుగ్రతే యుష్మాసు భూయాత్| ఆమేన్|</para>
</usx>
