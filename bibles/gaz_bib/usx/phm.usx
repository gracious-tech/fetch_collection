<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">ፊልሞና</para>
  <para style="toc1">ፊልሞና</para>
  <para style="toc2">ፊልሞና</para>
  <para style="toc3">ፊሞ</para>
  <para style="mt1">ፊልሞና</para>
  <chapter number="1" style="c" sid="PHM 1"/>
  <para style="s1">ነጋ ጋፈቹ</para>
  <para style="po">
    <verse number="1" style="v" sid="PHM 1:1"/>ጳዉሎስ እሰ ክርስቶስ ዬሱሲፍ ጄዼ ህዸሜፊ ኦቦሌሰኬኘ ጢሞቴዎስራ።</para>
  <para style="po" vid="PHM 1:1">ገረ ፊልሞና እሰ ጃለተማፊ ሆጄታ ህዸተኬኘ ተኤ ሰናት፤ <verse eid="PHM 1:1"/><verse number="2" style="v" sid="PHM 1:2"/>አከኑመስ ገረ ኦቦሌቲኬኘ አጵፍያት፣ ገረ አርክጳ እሰ ኑ ወጅን ሎልቱ ተኤት፣ ገረ ወልዳ ክርስታና እሼ መነኬት ወልት ቀበምቱትስ።<verse eid="PHM 1:2"/></para>
  <para style="po">
    <verse number="3" style="v" sid="PHM 1:3"/>አባኬኘ ዋቃፊ ዬሱስ ክርስቶስ ጎፍታራ አያኒፊ ነጋን እስኒፍ ሃተኡ።<verse eid="PHM 1:3"/></para>
  <para style="s1">ገለተ ገልቹፊ ከዸትና</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4"/>አን ዬሮ ከዸትናኮ ኬሰት ስ ያደዹ ሁንደ ዋቀኮ ነንገለቴፈዸ፤ <verse eid="PHM 1:4"/><verse number="5" style="v" sid="PHM 1:5"/>አን ዋኤ አመንቲኬ ከን አት ጎፍታ ዬሱስት ቀብዱፊ ዋኤ ጃለለኬ ከን አት ቁልቁሎተሳ ሁንዳፍ ቀብዱ ነንዸገኣቲ። <verse eid="PHM 1:5"/><verse number="6" style="v" sid="PHM 1:6"/>አን አከ አት ዋኤ ዋን ጋሪ ኑ ክርስቶሲን ቀብኑ ሁንዱማ ሁበትና ጉቱ ቀባቴ አመንቲኬ ነማን ገኡፍ ጀባቱ ነንከዸዸ። <verse eid="PHM 1:6"/><verse number="7" style="v" sid="PHM 1:7"/>ያ ኦቦሌሰ፣ ዋን አት ገራ ቁልቁሎታ ቀበኔስቴፍ ጃለልኬ ገመቹፊ ጀጀብነ ጉዳ ና ኬኔረ።<verse eid="PHM 1:7"/></para>
  <para style="s1">ጳዉሎስ አናሲሞሲፍ ከዸቹሳ</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8"/>ከናፉ አን አከ አት ዋን ሆጄቹ ቀብዱ ሆጄቱ ስ አጀጁፍ ዮ ክርስቶሲን እጀ ጀብነ ቀባዼሌ፣ <verse eid="PHM 1:8"/><verse number="9" style="v" sid="PHM 1:9"/>ሰበቢ ጃለላቲፍ ጭምሴን ስ ከዸዸ። ኤጋ አን ጳዉሎስ ጃርስቺፊ አመስ ክርስቶስ ዬሱሲፍ ከነን ህዸሜ፣ <verse eid="PHM 1:9"/><verse number="10" style="v" sid="PHM 1:10"/>እልመኮ አናሲሞስ እሰ አን ህዸሙኮቲን ዸልቼ ሰናፍ ስን ከዸዸ። <verse eid="PHM 1:10"/><verse number="11" style="v" sid="PHM 1:11"/>እን ከናን ዱረ ነመ ሆማ ስ ህንፈየድኔ ቱሬ፤ አመ ገሩ ሲፍስ አናፍስ ነመ ፋይዳ ቀቡ ተኤረ።<verse eid="PHM 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12"/>አን እሰ፣ ነመ አከ ገራኮቲ ሰነ ዴብሴ ገረኬት ነንኤርገ። <verse eid="PHM 1:12"/><verse number="13" style="v" sid="PHM 1:13"/>አን ዬሮን ወንጌላፍ ህዸሜት እን እዶኬ ቡኤ አከ ነ ተጃጅሉፍ ኦፍ ብረት እሰ ሀምብፈቹ በርባዴን ቱሬ። <verse eid="PHM 1:13"/><verse number="14" style="v" sid="PHM 1:14"/>አን ገሩ ጋሩማንኬ ኡቱ ድርቀማን ህንተእን ፌዺዻን አከ ተኡፍ ዋኑመ ቶኮሌ ኤየመኬ መሌ ጎቹ ህንበርባድኔ። <verse eid="PHM 1:14"/><verse number="15" style="v" sid="PHM 1:15"/>ተሪ እን ዬሮ ገባባፍ ሲን ገርገር በኡንሳ አከ አት ዴብፍቴ እሰ ስመቴ ሀመ ዹማት ኦፍ ብረ ቱርስቱፍ ተአ፤ <verse eid="PHM 1:15"/><verse number="16" style="v" sid="PHM 1:16"/>አትስ ስአች አከ ገርብቻት ኡቱ ህንተእን፣ አከ ኦቦሌሰ ጃለተማ ገርብቸ ጫሉ ቶኮት እሰ ስመዹ። እን ኬሱመቱ ኤርገ አናፍ አከስ ጃለተማ ተኤ ሲፍሞ ፎኒንስ ጎፍታዻንስ ሀመም ጫላ ጃለተማ ሃተኡሬ?<verse eid="PHM 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17"/>ኤጋ አት ዮ አከ ምቹኬቲት ነ እላልቴ አኩመ ነ ስመቱት እሰስ ስመዹ። <verse eid="PHM 1:17"/><verse number="18" style="v" sid="PHM 1:18"/>ዮ እን ዋኑመ ቶኮንሌ ስ የኬ ጅራቴ ዮካን አት ዮ ዋኑመ ቶኮሌ እሰራ ቀባቴ ነት ለካእ። <verse eid="PHM 1:18"/><verse number="19" style="v" sid="PHM 1:19"/>አን ጳዉሎስ ሲፈን ከፈለ ጄዼ ሀርኩመኮቲን በሬሴረ። አከ አት መታንኬዩ ከንኮ ታቴ አን ሆማ ስት ህንህሙ። <verse eid="PHM 1:19"/><verse number="20" style="v" sid="PHM 1:20"/>ኤጋ ያ ኦቦሌሰ፣ አን ጎፍታዻን ፋይዳ ከነ ስራ አርገቹ ነንበርባደ፤ ክርስቶስት ገራኮ ና ቀበኔስ። <verse eid="PHM 1:20"/><verse number="21" style="v" sid="PHM 1:21"/>አከ አት ዋን አን ስ ከዸዹ ጫላ ና ጎቱ ቤኩዻን አጀጀሙኬ አመነዼ ሲፈን በሬሰ።<verse eid="PHM 1:21"/></para>
  <para style="b"/>
  <para style="s1">ነጋ ዻሙፊ ኤብሱ</para>
  <para style="p">
    <verse number="22" style="v" sid="PHM 1:22"/>ከነ መሌስ አን ከዸትናኬሰኒን አከን እስኒፍ ኬነሙ ዋነን አብደዹፍ መነ ቦቆና ና ቆጴስ።<verse eid="PHM 1:22"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23"/>ኤጳፍራን እን ክርስቶስ ዬሱሲፍ ጄዼ ነ ወጅን ህዸሜ ነጋ ሲፍ ዻመ።<verse eid="PHM 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="PHM 1:24"/>አከሱመስ ወር ነ ወጅን ሆጄተን ማርቆስ፣ አርስጥሮኮስ፣ ዴማሲፊ ሉቃስ ነጋ ሲፍ ዻሙ።<verse eid="PHM 1:24"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25"/>አያን ጎፍታኬኘ ዬሱስ ክርስቶስ ሀፉረኬሰን ወጅን ሃተኡ።<verse eid="PHM 1:25"/></para>
  <chapter eid="PHM 1"/>
</usx>
