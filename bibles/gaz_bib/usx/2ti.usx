<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">2 ጢሞቴዎስ</para>
  <para style="toc1">ጢሞቴዎስ ለመፋ</para>
  <para style="toc2">2 ጢሞቴዎስ</para>
  <para style="toc3">2ጢሞ</para>
  <para style="mt1">ጢሞቴዎስ</para>
  <para style="mt2">ለመፋ</para>
  <chapter number="1" style="c" sid="2TI 1"/>
  <para style="po">
    <verse number="1" style="v" sid="2TI 1:1"/>ጳዉሎስ እሰ አኩመ ዋዳ ጅሬኘ ከራ ክርስቶስ ዬሱሲን ገለሜ ሰናት ፌዺ ዋቃቲን ኤርገማ ክርስቶስ ዬሱስ ተኤራ።<verse eid="2TI 1:1"/></para>
  <para style="po">
    <verse number="2" style="v" sid="2TI 1:2"/>ገረ ጢሞቴዎስ፣ እልመኮ ጃለተማት።</para>
  <para style="po" vid="2TI 1:2">አባኬኘ ዋቃፊ ጎፍታኬኘ ክርስቶስ ዬሱስራ አያን፣ አራሪፊ ነጋን ሲፍ ሃተኡ።<verse eid="2TI 1:2"/></para>
  <para style="s1">ገለቴፈቹ</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3"/>አን ዮሙ ኡቱ ገርገር ህንኩትን ሀልከኒ ጉያ ከዸትናኮ ኬሰት ስ ያደዹት ዋቀ አኩመ አቦቲኮቲ አንስ ያደ ቁልቁሉን እሰ ዋቄፈዹ ሰነ ነንገለቴፈዸ። <verse eid="2TI 1:3"/><verse number="4" style="v" sid="2TI 1:4"/>አን ዮሙን እምማንኬ ያደዹት አከን ገመቹዻን ጉተሙፍ ጉድሴ ስ አርጉ ነንሀወ። <verse eid="2TI 1:4"/><verse number="5" style="v" sid="2TI 1:5"/>አን አመንቲኬ እሰ ዹጋ ሰነ ነንያደዸ፤ አመንቲን ኩንስ ጀልቀበት አኮኬ ሎእሲፊ ሃዸኬ ኤዉንቄ ኬሰ ቱሬ፤ አመሞ አከ ስ ኬሰ ጅሩ ነንአመነ።<verse eid="2TI 1:5"/></para>
  <para style="s1">አከ ጳዉሎሲፊ ወንጌላፍ ኦፍ ኬነኒፍ ሶሶበቹ</para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 1:6"/>ሰበቢ ከናፍ አን አከ አት ኬና ዋቃ ከን ዬሮ አን ሀርከኮ ስረ ካኤት ሲፍ ኬነሜ ሰነ አከ እብዳት አከ ቀብሲፍቱፍ ስን ያደቺሰ። <verse eid="2TI 1:6"/><verse number="7" style="v" sid="2TI 1:7"/>ዋቅን ሀፉረ ሁምና፣ ከን ጃለላቲፊ ከን ኦፍ ዾዉ ኑ ኬኔ መሌ ሀፉረ ሶዳ ኑፍ ህንኬንኔቲ። <verse eid="2TI 1:7"/><verse number="8" style="v" sid="2TI 1:8"/>ከናፉ ዋኤ ጎፍታኬኛ ዹጋ በኡት ዮካን አነ ነመ እሳፍ ጄዼ ህዸሜት ህንቃነእን። ወንጌላፍ ዽጰቹ ኬሰት ገሩ ሁምነ ዋቃቲን ነ ወጅን ህርማዹ፤ <verse eid="2TI 1:8"/><verse number="9" style="v" sid="2TI 1:9"/>ዋቅን ሰበቢ ካዮሳቲፊ ሰበቢ አያነሳቲፍ ኑ ፈይሴ ገረ ጅሬኘ ቁልቁሉት ኑ ዋሜ መሌ ሰበቢ ሆጂ ኑ ሆጄትኔ ከሚፍዩ ምት። አያን ኩንስ ኡመመ አዱኛቲን ዱረ ከራ ክርስቶስ ዬሱሲን ኑ ኬነሜ፤ <verse eid="2TI 1:9"/><verse number="10" style="v" sid="2TI 1:10"/>አመ ገሩ አያን ሱን ዹፋቲ ፈይሳኬኘ ክርስቶስ ዬሱስ እሰ ከራ ወንጌላቲን ዱአ በሌሴ ጅሬኛፊ በዲሰ ኦሉ እፈት ባሴ ሰናቲን ሙልእፈሜረ። <verse eid="2TI 1:10"/><verse number="11" style="v" sid="2TI 1:11"/>አንስ ወንጌለ ከናፍ ለለባ፣ ኤርገማፊ በርሲሳ ተኤ ሙደሜረ። <verse eid="2TI 1:11"/><verse number="12" style="v" sid="2TI 1:12"/>አንስ አከ አመ ጅሩ ከነት ዽጰቹንኮ ከኑማፍ። አን ገሩ ኤኙን አከ አመኔ ዋን ቤኩፍ ህንቃነኡ፤ አከ እን ዋን አን እማና እት ኬነዼ ሀመ ጉያ ሰናት ኤጉ ደንደኡስ ነንአመነ።<verse eid="2TI 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2TI 1:13"/>ዋን ነራ ዸጌሴ ሰነ አከ ፈኬኘ በርሲሰ ዹጋት አመንቲፊ ጃለለ ክርስቶስ ዬሱሲን ቀብዱ ጀቤሲ ቀበዹ። <verse eid="2TI 1:13"/><verse number="14" style="v" sid="2TI 1:14"/>ዋን ጋሪ እማና ስት ኬነሜ ሰነ ገርጋርሰ ሀፉረ ቁልቁሉ ኑ ኬሰ ጅራቱ ሰናቲን ኤግ።<verse eid="2TI 1:14"/></para>
  <para style="s1">ፈኬኘ ኦፍ ኬኑ ዸቡፊ ኦፍ ኬኑ</para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15"/>ነሞትን ብየ አስያ ኬሰ ጅራተን ሁንድኑ አከ ነራ ገረገለን ንቤክተ፤ ፊሎጎሲፊ ሄርሞጌኔስ እሳን ኬሰ ጅሩ።<verse eid="2TI 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 1:16"/>ሄኔሲፎሩን ዬሮ ባይኤ ዋን ነ ቦቆቺሴፍ ጎፍታን ወረ መነሳ ጅራተኒፍ አራረ ሃቡሱ፤ እን ህዸሙኮትሌ ህንቃኖፍኔቲ። <verse eid="2TI 1:16"/><verse number="17" style="v" sid="2TI 1:17"/>አከሱመስ እን ዬሮ ሮማ ዹፌት ሀመ ነ አርጉት ዽሜ ነ በርባዳ ቱሬ። <verse eid="2TI 1:17"/><verse number="18" style="v" sid="2TI 1:18"/>አከ እን ጉያ ሰነት ጎፍታራ አራረ አርገቱፍ ፌዺ ጎፍታ ሃተኡ! እን ኤፌሶን ኬሰት ከራ ባይኤን አከ ነ ተጃጅሌ አትዩ ስሪት ቤክተ።<verse eid="2TI 1:18"/></para>
  <chapter eid="2TI 1"/>
  <chapter number="2" style="c" sid="2TI 2"/>
  <para style="s1">ሶሶበቹን ሃሮምፈሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1"/>ከናፉ ያ እልመኮ፣ አያነ ክርስቶስ ዬሱሲን ጀባዹ። <verse eid="2TI 2:1"/><verse number="2" style="v" sid="2TI 2:2"/>ዋን ፉለ ዹገ ባቶተ ባይኤ ዱረት ነራ ዸጌሴ ሰነ ነሞተ አመነሞ ከኔን ወረ ካን በርሲሱ ደንደአንት እማና ኬን። <verse eid="2TI 2:2"/><verse number="3" style="v" sid="2TI 2:3"/>አትስ አኩመ ሎልቱ ጀባ ከን ክርስቶስ ዬሱሲት ኑ ወጅን ዽጰዹ። <verse eid="2TI 2:3"/><verse number="4" style="v" sid="2TI 2:4"/>ነምን ሎልቱማን ተጃጅሉ ከምዩ አጀጃሳ ገመቺሱ ያለ መሌ ዽመ ጅሬኛቲን ኦፍ ህንጠጡ። <verse eid="2TI 2:4"/><verse number="5" style="v" sid="2TI 2:5"/>አከሱመስ ዶርጎማን ቶኮ ዮ አከ መሉት ዶርጎሜ መሌ ጎንፎ ህንአርገቱ። <verse eid="2TI 2:5"/><verse number="6" style="v" sid="2TI 2:6"/>ቆናን ቡላን ጀባቴ ሆጄቱስ እጀ ቆደቹት ነመ ጀልቀባ ተኡ ቀበ። <verse eid="2TI 2:6"/><verse number="7" style="v" sid="2TI 2:7"/>ዋን አን ስት ህሙ ከነ ቀልቤፈዹ፤ ጎፍታን ዋን ሁንደ ኬሰት ሁበትና ሲፍ ኬናቲ።<verse eid="2TI 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8"/>ዬሱስ ክርስቶስ እሰ ወረ ዱአን ኬሳ ካፈሜ፣ እሰ ሰኚ ዳዊትራ ዸለቴ ያደዹ። ኩን ወንጌለኮ <verse eid="2TI 2:8"/><verse number="9" style="v" sid="2TI 2:9"/>ከን አን እሳፍ ጄዼ አከ ነመ የከ ሆጄቴ ቶኮት ሀመ ፎንጫን ህዸሙት ዽጰቻፊ ጅሩዸ። ዱቢን ዋቃ ገሩ ህንህዸሙ። <verse eid="2TI 2:9"/><verse number="10" style="v" sid="2TI 2:10"/>ከናፉ አከ ወር ፍለተመን ፈይነ ክርስቶስ ዬሱሲን ተኤ ሰነ ኡልፍነ በረ በራ ወጅን አርገተኒፍ አን እሳኒፍ ጄዼ ዋን ሁንዱማ ነንኦብሰ።<verse eid="2TI 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 2:11"/>ዱብች አመነማን አከነ ጄዸ፦</para>
  <para style="q1" vid="2TI 2:11">ኑ እሰ ወጅን ዮ ዱኔ፣</para>
  <para style="q2" vid="2TI 2:11">እሰ ወጅን ንጅራትነ፤<verse eid="2TI 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12"/>ኑ ዮ ኦብስኔ፣</para>
  <para style="q2" vid="2TI 2:12">እሰ ወጅን ንሞነ።</para>
  <para style="q1" vid="2TI 2:12">ኑ ዮ እሰ ገኔ፣</para>
  <para style="q2" vid="2TI 2:12">እንስ ኑ ገነ።<verse eid="2TI 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13"/>ኑ ዮ አመነሞ ተኡ ባትኔ፣</para>
  <para style="q2" vid="2TI 2:13">እን አመነማ ተኤ ጅራተ፤</para>
  <para style="q2" vid="2TI 2:13">እን ኦፍ ገኑ ህንደንደኡቲ።<verse eid="2TI 2:13"/></para>
  <para style="s1">ዋኤ በርሲስቶተ ሶብዱ</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14"/>ወንቶተ ከኔን እሳን ያደቺስ፤ ዋኤ ጄቾታቲንስ አከ ወል ህንሎሌፍ ፉለ ዋቃ ዱረት እሳን አኬከቺስ፤ ወን አከሲ ወረ ዸገአን ንዲገ መሌ ዋ ቶኮሌ ህንፈየዱቲ። <verse eid="2TI 2:14"/><verse number="15" style="v" sid="2TI 2:15"/>አትስ ዱቢ ዹጋ ሰነ ስሪት ቀበቹዻን ሆጄታ ቆረተሜ ፉዸተሜ ከን እት ህንቃኖፍኔ ተኢቲ ፉለ ዋቃ ዱረት ኦፍ ዽኤሱፍ ተታፈዹ። <verse eid="2TI 2:15"/><verse number="16" style="v" sid="2TI 2:16"/>ገሩ ዱቢ ፋይዳ ህንቀብኔራ ፈጋዹ፤ ዱቢን አከሲ እቱመ ጫልችሴ ነመ ዋቃ ተኡራ ነመ ፈጌሳቲ። <verse eid="2TI 2:16"/><verse number="17" style="v" sid="2TI 2:17"/>በርሲስንሳኒስ አከ ዹኩበ ጋንግሪኒ<note caller="+" style="f"><char style="fr" closed="false">2፥17 </char><char style="ft" closed="false">ዹኩበ መዳንሳ ህንፈይኔ።</char></note> በበልአቻ ዴመ። ህሜኔዎሲፊ ፊሊጦስስ እሳን ኬሰት አርገሙ፤ <verse eid="2TI 2:17"/><verse number="18" style="v" sid="2TI 2:18"/>እሳንስ ዱኣ ከኡን ተኤ ደርቤረ ጄቹዻን ዹጋራ ፈጋተኒሩ። አመንቲ ነሞተ ቶኮ ቶኮስ ንበሌሱ። <verse eid="2TI 2:18"/><verse number="19" style="v" sid="2TI 2:19"/>ገሩ ሁንዴን ዋቃ ህንሶቾፈምኔ ከን ቻፓ፣ “ጎፍታን ወረ ከንሳ ተአን ንቤከ፣”<note caller="+" style="f"><char style="fr" closed="false">2፥19 </char><char style="ft" closed="false"><char style="xt"><ref loc="NUM 16:5">ለኮ 16፥5</ref></char></char></note> አከኑመስ “ነምን መቃ ጎፍታ ዋመቱ ሁንድ ሀምነራ ሃዴብኡ” ጄዹን ቻፔፈሜ ጀባቴ ዻበቴረ።<verse eid="2TI 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20"/>መነ ጉዳ ቶኮ ኬሰ ምአ ወርቄቲፊ ሜቲ ቆፈ ኡቱ ህንተእን፣ ምእ ሙካቲፊ ሱጴስ ጅረ፤ ከነ ኬሳስ ቶኮ ቶኮ ኡልፍናፍ፣ ካንሞ ሰልጵናፍ ኦለ። <verse eid="2TI 2:20"/><verse number="21" style="v" sid="2TI 2:21"/>ነምን ቶኮ ዮ ሰልጵነ ከነራ ኦፍ ቁልቁሌሴ፣ እን ምአ ኡልፍና ከን ቁልቁሌፈሜ፣ ከን ጎፍታሳ ፈየዱፊ ከን ሆጂ ጋሪ ከምዩ ሆጄቹፍ ቆጴፈሜ ተአ።<verse eid="2TI 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22"/>አትስ ሀዊ ሀማ ዬሮ ደርገጉማራ በቀዹ፤ ወረ ገራ ቁልቁሉን ጎፍታ ዋመተን ወጅን ቀጄሉማ፣ አመንቲ፣ ጃለላፊ ነጋ ዱካ ቡእ። <verse eid="2TI 2:22"/><verse number="23" style="v" sid="2TI 2:23"/>ፈልሚ ፋይዳ ህንቀብኔፊ ጎዉማ ኬሰ ህንሴንን፤ ኩን አከ ሎለ ፍዱ አቱ ንቤክታቲ። <verse eid="2TI 2:23"/><verse number="24" style="v" sid="2TI 2:24"/>ገርብች ጎፍታ ከን ነመ ሁንዱማፍ ገራ ላፉ፣ ከን በርሲሱ ደንደኡፊ ኦብሰ ቀቤሰ ተኡ ቀበ መሌ ከን ነማን ወል ሎሉ ተኡ ህንቀቡ። <verse eid="2TI 2:24"/><verse number="25" style="v" sid="2TI 2:25"/>እንስ አከ ዋቅን ቀልቢ ጅጂረትና ገረ ዹጋ ቤኩት እሳን ጌሱ እሳኒፍ ኬኑ አብደቻ ወረ እሳን ሞርመን ገራሙማን ስሬሱ ቀበ፤ <verse eid="2TI 2:25"/><verse number="26" style="v" sid="2TI 2:26"/>አከሲንስ እሳን ቀልቢ ሆረተኒ ክዮ ዲያብሎስ ከን አከ እሳን ፌዺሳ ጉተኒፍ እሳን ቦጅኤ ሰነ ጀላ በኡ።<verse eid="2TI 2:26"/></para>
  <chapter eid="2TI 2"/>
  <chapter number="3" style="c" sid="2TI 3"/>
  <para style="s1">ዋን ጉዮተ ዹማ ኬሰ ተኡ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1"/>ገሩ ጉዮተ ዹማ ኬሰ አከ ዬሮን ረክና ዹፉ ሁበዹ። <verse eid="2TI 3:1"/><verse number="2" style="v" sid="2TI 3:2"/>ነሞትን ኦፍ ጃለቶተ፣ ጃለቶተ ማለቃ፣ ኦፍ ጀጆተ፣ ኦፍ ቱልቶተ፣ ወረ ዋቀ አረብሰን፣ ወረ አባፊ ሃዸሳኒቲፍ ህንአጀጀምኔ፣ ወረ ህንገለቴፈትኔ፣ ወረ ቁልቁሉማ ህንቀብኔ፣ <verse eid="2TI 3:2"/><verse number="3" style="v" sid="2TI 3:3"/>ወረ ጃለለ ህንቀብኔ፣ ወረ ዺፈመ ህንጎኔ፣ ወረ መቃ ነማ በሌሰን፣ ወረ ኦፍ ህንቀብኔ፣ ገረ ጀቤዪ፣ ወረ ዋን ጋሪ ህንጃለትኔ፣ <verse eid="2TI 3:3"/><verse number="4" style="v" sid="2TI 3:4"/>ገንቶተ፣ ወረ አከ መሌ ጀርጀረን፣ ወረ ኦፍ ቦኮክሰን፣ ወረ ዋቀ ጃለቹረ ዋን እሳን ገመቺሱ ጃለተን ንተኡ፤ <verse eid="2TI 3:4"/><verse number="5" style="v" sid="2TI 3:5"/>ወረ ዋቃፍ ቡለን ንፈካቱ፤ ገሩ ሁምነሳ ንገኑ። አት ወረ አከሲራ ፈጋዹ።<verse eid="2TI 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 3:6"/>እሳን ወረ መኔን ሴኑዻን ዱበርቶተ ደዸቦ ወረ ጩቡን እሳንረ ቱለሜፊ ወረ ሀዊ ጎሰ ሁንዳቲን አሲፊ አች ራፈመን ቦጅአኒዸ፤ <verse eid="2TI 3:6"/><verse number="7" style="v" sid="2TI 3:7"/>ዱበርቶትን ኩኔን ዬሮ ሁንደ ንበረቱ፤ ገሩ ጎንኩማ ዹጋ ቤኩት ዹፉ ህንደንደአን። <verse eid="2TI 3:7"/><verse number="8" style="v" sid="2TI 3:8"/>አኩመ ያኔሲፊ ያምብሬስ ሙሴን ሞርመን ሰነ ነሞትን ቀልቢንሳኒ በዴ ዋኤ አመንቲት ፉዸተመ ዸበን ኩኔንስ ዹጋዻን ንሞርሙ። <verse eid="2TI 3:8"/><verse number="9" style="v" sid="2TI 3:9"/>ተኡስ ጎዉማንሳኒ ዋን አኩመ ነሞተ ሰና ነመ ሁንደ ብረት እፈት በኡፍ እሳን ፈጎ ህንዴመን።<verse eid="2TI 3:9"/></para>
  <para style="s1">ጎርሰ ጢሞቴዎሲፍ ኬነሜ ከን ዹማ</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10"/>አት ገሩ በርሲሰኮ፣ ሃለ ጅሬኘኮ፣ ካዮኮ፣ አመንቲኮ፣ ኦብሰኮ፣ ጃለለኮ፣ ጀባዼ ዻበቹኮ ሁንዱማ ዱካ ቡቴርተ፤ <verse eid="2TI 3:10"/><verse number="11" style="v" sid="2TI 3:11"/>አርአተሙኮ፣ ረክነኮቲፊ ዋን አንጦኪያት፣ እቆንዮኒፊ ልስጥራንት ነረ ገኤ፣ አርአተመ ገራ ገራ ከን አን ኦብሳን ኬሰ ደርቤስ ዱካ ቡቴርተ። ጎፍታን ገሩ ዋን ከነ ሁንደ ጀላ ነ ባሴ። <verse eid="2TI 3:11"/><verse number="12" style="v" sid="2TI 3:12"/>ዹጉማኑ ነምን ክርስቶስ ዬሱሲን ነመ ዋቃ ተኤ ጅራቹ በርባዱ ከምዩ ንአርአተመ፤ <verse eid="2TI 3:12"/><verse number="13" style="v" sid="2TI 3:13"/>ነሞትን ሀሞኒፊ ጎዎምስቶትን ገሩ ነመ ጎዎምሳ፣ ኦፍሌ ጎዎምፈማ ሀምናን እቱመ ጫላ ዴሙ። <verse eid="2TI 3:13"/><verse number="14" style="v" sid="2TI 3:14"/>አት ገሩ ዋን በረቴፊ ዋን ሁበቴ ሰነት ጀባዹ፤ ኤኙራ አከ በረቴ ቤክታቲ፤ <verse eid="2TI 3:14"/><verse number="15" style="v" sid="2TI 3:15"/>አከሱመስ አት እጆሉማኬቲ ጀልቀብዴ ከተቢወን ቁልቁሉ ከኔን ዋኤ ፈይነ ከራ ክርስቶስ ዬሱስት አመኑቲን አርገሙ ሰናፍ ኦጌሰ ስ ታስሱ ደንደአን አከምት አከ በረቴ ንቤክተ። <verse eid="2TI 3:15"/><verse number="16" style="v" sid="2TI 3:16"/>ከተቢን ቁልቁሉን ሁንድ ሀፉረ አፋን ዋቃቲ በኤን ኬነመን፤ እሳንስ በርሲሱፍ፣ አኬከቺሱፍ፣ ስሬሱፊ ቀጄሉማን ሌንጅሱፍ ንፈየዱ፤ <verse eid="2TI 3:16"/><verse number="17" style="v" sid="2TI 3:17"/>ኩንስ አከ ነምን ዋቃ ሆጂ ጋሪ ሁንዱማፍ ጉቱማት ህዸቴ ቆጳኡፍ።<verse eid="2TI 3:17"/></para>
  <chapter eid="2TI 3"/>
  <chapter number="4" style="c" sid="2TI 4"/>
  <para style="s1">ዱብቸ አከ ለለቡ አጀጁሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1"/>አን ፉለ ዋቃ ዱረት፣ ፉለ ክርስቶስ ዬሱስ እሰ ወረ ጅራተኒፊ ወረ ዱአንት ሙሩፍ ጅሩ ዱረትስ ሙልአቹሳቲፊ ሞቱማሳቲን ስን ጎርሰ። <verse eid="2TI 4:1"/><verse number="2" style="v" sid="2TI 4:2"/>ዱብቸ ለለብ፤ ዬሮ ምጃኣትስ ተኡ ዬሮ ህንምጆፍኔት ቆጳእ፤ ኦብሰ ጉዳፊ በርሲሰ ኦፍ ኤገትናቲን ስሬስ፤ እፈዹ፤ ጀጀቤስስ። <verse eid="2TI 4:2"/><verse number="3" style="v" sid="2TI 4:3"/>ዬሮን እት ነሞትን በርሲሰ ዹጋ ዸገኡፍ ኦብሰ ህንቀባትኔ ንዹፋቲ። ቆደ ከና አከ ዋን ጉርሳኒ እን ሆቅስሱ ሱን ዸገኡ በርባዱ እት ህመኒፍ ሀዊሳኒ ጉተቹፍ በርሲስቶተ ባይኤ ኦፊሳኒቲፍ ወልት ቀበቱ። <verse eid="2TI 4:3"/><verse number="4" style="v" sid="2TI 4:4"/>ጉረሳኒስ ዹጋ ዸገኡራ ገረ ገልቸኒ ገረ ኦዱ ሁንዴ ህንቀብኔት ዴብሱ። <verse eid="2TI 4:4"/><verse number="5" style="v" sid="2TI 4:5"/>አት ገሩ ዋን ሁንደ ኬሰት እላለቻ ዴም፤ ረክነ ኦብስ፤ ሆጂ ተጃጅላን ወንጌላ ቶኮ ሆጄቱ ሆጄዹ፤ ተጃጅለኬስ ፊጣን ባስ።<verse eid="2TI 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6"/>አን አሙመዩ አከ ዽባዩት ዸንገላፈሙፍ ቆጳኤረ፤ ዬሮን ዴምሰኮስ ገኤረ። <verse eid="2TI 4:6"/><verse number="7" style="v" sid="2TI 4:7"/>አን ሎለ ጋሪ ሎሌረ፤ ዶርጎሚ ጡሙሬረ፤ አመንቲስ ኤጌረ። <verse eid="2TI 4:7"/><verse number="8" style="v" sid="2TI 4:8"/>አመ ጎንፎን ቀጄሉማ ነ ኤገተ፤ እሰስ አባ ሙርቲ ቀጄላ፣ ጎፍትቸቱ ጉያ ሰነ ናፍ ኬነ፤ ከነስ ወረ ሙልአቹሳ ጃለተን ሁንዳፍ ኬነ መሌ አነ ቆፋፍ ምት።<verse eid="2TI 4:8"/></para>
  <para style="s1">ያደቺሰ ዹማ</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9"/>ደፊ ገረኮ ኮቱ፤ <verse eid="2TI 4:9"/><verse number="10" style="v" sid="2TI 4:10"/>ዴማስ አዱኛ ከነ ጃለቴ ነ ዺሴ ገረ ተሰሎኒቄ ዴሜራቲ። ቄርቅስ ገረ ገላትያ፣ ቲቶንሞ ገረ ድልማጥያ ዴመኒሩ። <verse eid="2TI 4:10"/><verse number="11" style="v" sid="2TI 4:11"/>ሉቃስ ቆፈቱ ነ ብረ ጅረ። ማርቆስ ዋን ተጃጅለኮ ኬሰት ነ ገርጋሩፍ እሰ ኦፍ ዱካ ፍዲ ኮቱ። <verse eid="2TI 4:11"/><verse number="12" style="v" sid="2TI 4:12"/>አን ቲኪቆስን ኤፌሶንት ኤርጌረ። <verse eid="2TI 4:12"/><verse number="13" style="v" sid="2TI 4:13"/>አት ዮሙ ዹፍቱት ዋሮ አን ጢሮአዳት ካርጶስ ብረት ዺሴፊ ክታቦተ መረሞ፣ ኬሱመቱ ክታቦተ ጎጋ ዱገማ ሰነ ናፍ ፍድ።<verse eid="2TI 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14"/>እስክንድሮስ ቱምቱን ናሲ ሱን አከ መሌ ነት ሀማቴ። ጎፍታን አከ ሆጂሳት ንዴብሳፍ። <verse eid="2TI 4:14"/><verse number="15" style="v" sid="2TI 4:15"/>ነምች ኩን ዋን አከ መሌ ኤርጋኬኘ ሞርሜፍ አትስ እሰራ ኦፍ ኤገቹ ቀብደ።<verse eid="2TI 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16"/>ዬሮ አን ፈልመተኮ ከን ጀልቀባ ዽኤፈዼት ሁንድሳኒዩ ነ ዺሰኒ ዴመን መሌ ነምን ቶኮዩ ነ ህንገርጋሬ። አንስ አከ ወን ኩን እሳንት ህንለካአምኔፍ ዋቀ ነንከዸዸ። <verse eid="2TI 4:16"/><verse number="17" style="v" sid="2TI 4:17"/>ገሩ አከ ከራኮቲን ኤርጋን ጉቱማት ለለበሙፊ አከ ነሞትን ኦርማ ሁንድ ዸገአኒፍ ጎፍታን ነ ብረ ዻበቴ ነ ጀጀቤሴ። አንስ አፋን ሌንጫ ጀላ ነንባፈሜ። <verse eid="2TI 4:17"/><verse number="18" style="v" sid="2TI 4:18"/>ጎፍታን ዋን ሀማ ሁንደ ጀላ ነ ባሴ ሞቱማሳ ከን ሰሚት ነጉማን ነ ገልቸ። በረ በራ ሀመ በረ በራት ኡልፍን እሳፍ ሃተኡ። አሜን።<verse eid="2TI 4:18"/></para>
  <para style="b"/>
  <para style="s1">ዻምሰ ነጋ ጡሙራ</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19"/>ጵርስቅላፊ አቂላት፣ ወረ መነ ሄኔሲፎሩ ጅራተንትስ ነጋ ናፍ ህም።<verse eid="2TI 4:19"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="20" style="v" sid="2TI 4:20"/>ኤርስጦስ ቆሮንቶስት ሀፌ፤ ጥሮፊሞስሞ ዹኩብሰትናን አን ሚሊጢንት እሰ ዺሴ። <verse eid="2TI 4:20"/><verse number="21" style="v" sid="2TI 4:21"/>ገናን ዱረ ደፊ ኮቱ።</para>
  <para style="b" vid="2TI 4:21"/>
  <para style="p" vid="2TI 4:21">ኤዉግሎስ ነጋ ሲፍ ዻመ፤ ጱዴስ፣ ሊኖስ፣ ቅላዉድያፊ ኦቦሎትን ሁንድኑስ አከሱመ ነጋ ሲፍ ዻሙ።<verse eid="2TI 4:21"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22"/>ጎፍታን ሀፉረኬ ወጅን ሃተኡ። አያን ስ ወጅን ሃተኡ።<verse eid="2TI 4:22"/></para>
  <chapter eid="2TI 4"/>
</usx>
