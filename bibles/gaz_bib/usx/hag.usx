<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HAG" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">ሃጌ</para>
  <para style="toc1">ራጂ ሃጌ</para>
  <para style="toc2">ሃጌ</para>
  <para style="toc3">ሃጌ</para>
  <para style="mt2">ራጂ</para>
  <para style="mt1">ሃጌ</para>
  <chapter number="1" style="c" sid="HAG 1"/>
  <para style="s1">ዋምቸ መነ <char style="nd">ዋቀዮ</char> እጃሩፍ ጎዸሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="HAG 1:1"/>በረ ቡልቺንሰ ዳርዮስ ሞትቻ ኬሳ ወጋ ለመፋት፣ ጉያ ቶኮፋ ጅአ ጀአፋት፣ ዱቢን <char style="nd">ዋቀዮ</char> ከራ ሃጌ ራጅቻቲን ገረ እልመ ሼአልቲኤል ገረ ዘሩባቤል ቡልቻ ይሁዳቲፊ ገረ እያሱ እልመ ዬሆዛዳቅ ሉብቸ ኦል ኣና አከነ ጄዼ ዹፌ፦<verse eid="HAG 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="HAG 1:2"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፦ “ሰብን ኩን፣ ‘ዬሮን እት መን <char style="nd">ዋቀዮ</char> እጃረሙ አመሌ ህንጌኜ’ ጄዸ።”<verse eid="HAG 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="HAG 1:3"/>ኤርገሲ ዱቢን <char style="nd">ዋቀዮ</char> ከራ ሃጌ ራጅቻቲን አከነ ጄዼ ዹፌ፦ <verse eid="HAG 1:3"/><verse number="4" style="v" sid="HAG 1:4"/>“ዬሮን ኩን ዬሮ እስን ኡቱ መን ኩን ዲገሜ ጅሩ መኔንኬሰን ከኔን ሚዸግፈመን ኬሰ ጅራተኒዻ?”<verse eid="HAG 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="HAG 1:5"/>አመስ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፦ “ያደኬሰን ከራኬሰንረ ካአዻ። <verse eid="HAG 1:5"/><verse number="6" style="v" sid="HAG 1:6"/>እስን ሰኚ ባይኤ ፈጫፈተኒ ዋን ጥኖ ሃመተኒርቱ። እስን ንኛቱ፤ ገሩ ህንቁፍተን። ንዹግዱ፤ ገሩ ዼቡ ህንባተን። ወያ ንኡፈቱ፤ ገሩ እስንት ህንሆኡ። ነምን ምንዳ ፉዸቱ አኩመ ነመ ምንዳሳ ኮሮጆ ተርሰኣ ኬሰ ካአቱት።”<verse eid="HAG 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="HAG 1:7"/>
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፦ “ከራኬሰን ሁበዻ። <verse eid="HAG 1:7"/><verse number="8" style="v" sid="HAG 1:8"/>ቱሉት ኦል በኣ፤ ሙከ ፍዳ፤ መንቸ እጃራ፤ አንስ እሰት ነንገመደ፤ ነንከበጀመስ” ጄዸ <char style="nd">ዋቀዮ</char>። <verse eid="HAG 1:8"/><verse number="9" style="v" sid="HAG 1:9"/>“እስን ዋን ባይኤ አብደተን፤ ገሩ ንጥናቴ። እስን መነት ገልፈተን አንሞ ነንአፉፌ። ኩን ማሊፍ ተኤ?” ጄዸ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ። “ኩን ሰበቢ ኡቱ መንኮ ዲገሜ ጅሩ ቶኮን ቶኮንኬሰን ገረ መነኬሰኒት ፊግደኒፍ። <verse eid="HAG 1:9"/><verse number="10" style="v" sid="HAG 1:10"/>ከናፉ ሰበቢኬሰኒፍ ሰሚወን ፍጤንሰሳኒ ዾወተን፤ ለፍትስ ምዻንሼ ዾወቴ። <verse eid="HAG 1:10"/><verse number="11" style="v" sid="HAG 1:11"/>አንስ ለፈ ቆቲሳፊ ቱሉወኒት፣ ምዻኒፊ ዳዺ ወይኒ ሃራት፣ ዘይቲፊ ዋን ለፍት ኬንቱ ሁንደት፣ ነማፊ ሎንት፣ ሆጂ ደዸቢ ሀርከኬሰኒትስ ሆንጌ ዋሜረ።”<verse eid="HAG 1:11"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="12" style="v" sid="HAG 1:12"/>ዘሩባቤል እልም ሼአልቲኤል፣ እያሱን እልም ዬሆዛዳቅ ሉብች ኦል ኣናኒፊ ሀምባወን ኡመታ ሁንድ ሰገሌ <char style="nd">ዋቀዮ</char> ዋቀሳኒቲፊ ኤርጋ ሃጌ ራጅቻቲፍ አጀጀመን፤ <char style="nd">ዋቀዮ</char> ዋቅንሳኒ እሰ ኤርጌራቲ። ኡመትንስ <char style="nd">ዋቀዮን</char> ሶዳቴ።<verse eid="HAG 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HAG 1:13"/>ኤርገሲ ሃጌን ኤርገማን <char style="nd">ዋቀዮ</char> ሱን አከነ ጄዼ ኤርጋ <char style="nd">ዋቀዮ</char> ከነ ሰበት ህሜ፦ “አን እስን ወጅነን ጅረ” ጄዸ <char style="nd">ዋቀዮ</char>። <verse eid="HAG 1:13"/><verse number="14" style="v" sid="HAG 1:14"/>አከሲን <char style="nd">ዋቀዮ</char> ሀፉረ ዘሩባቤል እልመ ሼአልቲኤል ቡልቻ ይሁዳ፣ ሀፉረ እያሱ እልመ ዬሆዛዳቅ ሉብቸ ኦል ኣናቲፊ ሀፉረ ሀምባ ኡመተ ሁንዳ ከካሴ። እሳንስ ዹፈኒ መነ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፣ መነ ዋቀሳኒ እጃሩ ጀልቀበን፤ <verse eid="HAG 1:14"/><verse number="15" style="v" sid="HAG 1:15"/>ኩንስ በረ ዳርዮስ ሞትቻ ኬሳ ወጋ ለመፋት፣ ቡልቲ ድግደሚ አፉረፋ ጅአ ጀአፋት ተኤ።<verse eid="HAG 1:15"/></para>
  <chapter eid="HAG 1"/>
  <chapter number="2" style="c" sid="HAG 2"/>
  <para style="s1">ኡልፍነ መንቸ ሃራ</para>
  <para style="p">
    <verse number="1" style="v" sid="HAG 2:1"/>ጅአ ቶርበፋ ኬሳ፣ ቡልቲ ድግደሚ ቶኮፋት ዱቢን <char style="nd">ዋቀዮ</char> አከነ ጄዼ ከራ ሃጌ ራጅቻቲን ዹፌ፤ <verse eid="HAG 2:1"/><verse number="2" style="v" sid="HAG 2:2"/>“ዘሩባቤል እልመ ሼአልቲኤል ቡልቻ ይሁዳት፣ እያሱ እልመ ዬሆዛዳቅ ሉብቸ ኦል ኣናቲፊ ሀምባ ኡመታት ዱበዹ። አከነስ ጄዺ እሳን ጋፈዹ፤ <verse eid="HAG 2:2"/><verse number="3" style="v" sid="HAG 2:3"/>‘እስን ኬሳ ነምን መነ ከነ ኡልፍነሳ ከን ዱራ ሰነ አርጌ አመዩ ጅሩ ኤኙ? እን አመ ማል እስንት ፈካተ? ዋኑመ ፋይዳ ህንቀብኔ ቶኮ እስንት ህንፈካቱ? <verse eid="HAG 2:3"/><verse number="4" style="v" sid="HAG 2:4"/>ያ ዘሩባቤል፣ ኤጋ አመ ጀባዹ’ ጄዸ <char style="nd">ዋቀዮ</char>። ‘ያ እያሱ እልመ ዬሆዛዳቅ ሉብቸ ኦል ኣና አትስ ጀባዹ። እስንስ ሰብን ብየ ከና ሁንድኑ ጀባዻቲ ሆጄዻ’ ጄዸ <char style="nd">ዋቀዮ</char>። ‘አን እስን ወጅነን ጅራቲ’ ጄዸ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ። <verse eid="HAG 2:4"/><verse number="5" style="v" sid="HAG 2:5"/>‘ዬሮ እስን ብየ ግብጢ ባተን ሰነት፣ ከኩን አን እስን ወጅን ገሌ ከናዸ። ሀፉርኮ እስን ግዱ ጅረ። እስን ህንሶዳትና።’<verse eid="HAG 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HAG 2:6"/>“<char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፦ ‘አን አመስ ዬሮ ገባባ ኬሰት ዴብኤ ሰሚወኒፊ ለፈ፣ ገላናፊ ለፈ ጎጎጋ ነንራሰ። <verse eid="HAG 2:6"/><verse number="7" style="v" sid="HAG 2:7"/>አን ሰቦተ ሁንደ ነንራሰ፤ ቀቤኝ ሰቦታ ሁንድ ንዹፈ፤ አንስ መነ ከነ ኡልፍናን ነንጉተ’ ጄዸ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ። <verse eid="HAG 2:7"/><verse number="8" style="v" sid="HAG 2:8"/>‘ሜቲን ከንኮት፤ ወርቄንስ ከንኮት’ ጄዸ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ። <verse eid="HAG 2:8"/><verse number="9" style="v" sid="HAG 2:9"/>‘ኡልፍን መነ አማ ኩን ኡልፍነ መነ ዱራ ሰና ንጫለ’ ጄዸ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ። ‘አንስ እዶ ከነት ነጋ ነንኬነ’ ጄዸ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ።”<verse eid="HAG 2:9"/></para>
  <para style="s1">ቁልቁሉማፊ ጡራኡማ</para>
  <para style="p">
    <verse number="10" style="v" sid="HAG 2:10"/>ወጋ ለመፋ ቡልቺንሰ ዳርዮስ ኬሰ፣ ቡልቲ ድግደሚ አፉረፋ ጅአ ሰግለፋት፣ ዱቢን <char style="nd">ዋቀዮ</char> አከነ ጄዼ ገረ ሃጌ ራጅቻ ዹፌ፤ <verse eid="HAG 2:10"/><verse number="11" style="v" sid="HAG 2:11"/>“<char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፤ ‘ዋን ሴር ጄዹ ሉቦተ ጋፈዹ፤ <verse eid="HAG 2:11"/><verse number="12" style="v" sid="HAG 2:12"/>ዮ ነምን ቶኮ ፎን ቁልቁሌፈሜ ዋቃፍ ኬነሜ ፉዼ ደቻ ወያሳ ኬሰት ባቴ ወያን ሱን ቡዴነ ዮካን እቶ፣ ዳዺ ወይኒ፣ ዘይቲ ዮካን ኛተ ጎሰ ብራ ቱቄ፣ ኛትን ሱን ንቁልቁሌፈማ?’ ”</para>
  <para style="p" vid="HAG 2:12">ሉቦንስ፣ “ዋዉ” ጄዸኒ ዴብሰኒፍ።<verse eid="HAG 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="HAG 2:13"/>ኤርገሲ ሃጌን አከነ ጄዼ፤ “ነምን ሬፈ ቱቄ ጡራኤ ቶኮ ዮ ወንቶተ ከኔን ኬሳ ቶኮ ቱቄ ወን ሱን ንጡራኣ?”</para>
  <para style="p" vid="HAG 2:13">ሉቦትን ሱንስ፣ “ኤዬ፣ ወን ሱን ንጡራአ” ጄዸኒ ዴብሰኒፍ።<verse eid="HAG 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="HAG 2:14"/>ሃጌን አከነ ጄዼ፤ “ ‘ኡመን ኩኒፊ ሰብን ኩን ፉለኮ ዱረት አከሱመ’ ጄዸ <char style="nd">ዋቀዮ</char>። ‘ወን እሳን ሆጄተን ሁንዲፊ ወን እሳን አችት ዽኤሰን ሁንድ ጡራኣዸ።<verse eid="HAG 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="HAG 2:15"/>“ ‘ኤጋ ጉያ ከና ጀልቀባቲ ኦፍ ኤገናዻን ቀልቤፈዻ፤ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ኬሰት ሃለ ኡቱ ዸጋን ቶኮ ዸጋ ካንረ ህንካአምን ዱረ ቱሬ ሁበዻ። <verse eid="HAG 2:15"/><verse number="16" style="v" sid="HAG 2:16"/>ነምን ከምዩ ዬሮ ገረ ቱላ ሰፈርቱ ድግደማ ዹፌት ሰፈርቱ ኩዸን ቆፈ አርገቴ። ነምን ከምዩ ዬሮ ዳዺ ወይኒ ሰፈርቱ ሸንተመ ወራበቹፍ ገረ ቦለ እት ወይኒ ጩንፈኒ ዸቄት ሰፈርቱ ድግደመ ቆፈ አርገቴ። <verse eid="HAG 2:16"/><verse number="17" style="v" sid="HAG 2:17"/>አን ሆጂ ሀርከኬሰኒ ሁንደ ዋጊዻን፣ አዋሮፊ ጨቢዻን ነንሩኩቴ፤ እስን ገሩ ገረኮት ህንዴብኔ’ ጄዸ <char style="nd">ዋቀዮ</char>። <verse eid="HAG 2:17"/><verse number="18" style="v" sid="HAG 2:18"/>ጉያ ከና ጀልቀባቲ ጄቹንስ ጉያ ድግደሚ አፉረፋ ጅአ ሰግለፋ ከና ጀልቀባቲ ሀመ ጉያ ሁንዴን መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ቡፈሜት ኦፍ ኤገናዻን ቀልቤፈዻ። <verse eid="HAG 2:18"/><verse number="19" style="v" sid="HAG 2:19"/>አመዩ ሰኚን ጎምብሳ ኬሰት ሀፌ ቶኮዩ ጅራ? ሀመ አማት ሙክን ወይኒቲፊ ሙክን ሀርቡ፣ ሮማኒፊ ሙክን ኤጄርሳ እጀ ህንነቀትኔ።</para>
  <para style="p" vid="HAG 2:19">“ ‘አን ጉያ ከና ጀልቀቤ እስን ነንኤብሰ።’ ”<verse eid="HAG 2:19"/></para>
  <para style="s1">ዘሩባቤል ቁቤላ ቻፓ <char style="nd">ዋቀዮ</char></para>
  <para style="p">
    <verse number="20" style="v" sid="HAG 2:20"/>ዱቢን <char style="nd">ዋቀዮ</char> ቡልቲ ድግደሚ አፉረፋ ጅአ ሰናት ዬሮ ለመፋ አከነ ጄዼ ገረ ሃጌ ዹፌ፤ <verse eid="HAG 2:20"/><verse number="21" style="v" sid="HAG 2:21"/>“አከ አን ሰሚወኒፊ ለፈ ራሱፍ ጅሩ ዘሩባቤል ቡልቻ ይሁዳት ህም። <verse eid="HAG 2:21"/><verse number="22" style="v" sid="HAG 2:22"/>አን ቴሶ ሞቶታ ነንገረገልቸ፤ ሁምነ ሞቱሞተ ብየ አላስ ነንበርበዴሰ። አን ጋሪወኒፊ ኦፍቶተሳኒ ነንገረገልቸ፤ ፈርዴኒፊ ወረ ፈርዴን ያበተን ንኩፉ፤ ቶኮን ቶኮንሳኒ ጎራዴ ኦቦሌሰሳኒቲን ንኩፉ።<verse eid="HAG 2:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="HAG 2:23"/>“ ‘ጉያ ሰነ’ ጄዸ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ፤ ‘ያ ተጃጅላኮ ዘሩባቤል እልመ ሼአልቲኤል፣ አን ስን ፉዸዸ’ ጄዸ <char style="nd">ዋቀዮ</char>፤ ‘አን ዋነን ስፍለዼፍ አከ ቁቤላ ቻፓኮ ስን ጎዸዸ’ ጄዸ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ።”<verse eid="HAG 2:23"/></para>
  <chapter eid="HAG 2"/>
</usx>
