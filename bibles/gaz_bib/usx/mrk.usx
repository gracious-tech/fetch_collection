<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">ማርቆስ</para>
  <para style="toc1">ወንጌለ ማርቆስ</para>
  <para style="toc2">ማርቆስ</para>
  <para style="toc3">ማር</para>
  <para style="mt2">ወንጌለ</para>
  <para style="mt1">ማርቆስ</para>
  <chapter number="1" style="c" sid="MRK 1"/>
  <para style="s1">ዮሀንስ ጩጳን ከራ ቆጴሱሳ</para>
  <para style="r">
    <ref loc="MRK 1:2-8">1፥2‑8</ref> ኩወፈ – <char style="xt"><ref loc="MAT 3:1-11">ማቴ 3፥1‑11</ref>፤ <ref loc="LUK 3:2-16">ሉቃ 3፥2‑16</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1"/>ጀልቀበ ወንጌለ ዬሱስ ክርስቶስ እልመ ዋቃ። <verse eid="MRK 1:1"/><verse number="2" style="v" sid="MRK 1:2"/>ክታበ እሳያስ ራጅቻ ኬሰት አከነ ጄዸሜ በሬፈሜረ፦</para>
  <para style="q1" vid="MRK 1:2">“ኩኖ፣ አን ኤርገማኮ እሰ ከራኬ ቆጴሱ፣<note caller="+" style="f"><char style="fr" closed="false">1፥2 </char><char style="ft" closed="false"><char style="xt"><ref loc="MAL 3:1">ሚል 3፥1</ref></char></char></note></para>
  <para style="q2" vid="MRK 1:2">ስ ዱረ ነንኤርገ፤”<verse eid="MRK 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3"/>“ሰገሌ ነመ፣ ‘ጎፍታፍ ከራ ቆጴሳ፤</para>
  <para style="q1" vid="MRK 1:3">ዳንዲ ቀጄላስ እሳፍ ሆጄዻ’ ጄዼ</para>
  <para style="q2" vid="MRK 1:3">ገሞጂ ኬሳ እዩ ቶኮ።”<note caller="+" style="f"><char style="fr" closed="false">1፥3 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 40:3">እሳ 40፥3</ref></char></char></note><verse eid="MRK 1:3"/></para>
  <para style="m">
    <verse number="4" style="v" sid="MRK 1:4"/>ከናፉ ዮሀንስ ገሞጂ ኬሰት ነመ ጩጳ፣ ዺፈመ ጩቡቲፍሞ ጩጳ ቀልቢ ጅጂረትና ለለባ ዹፌ። <verse eid="MRK 1:4"/><verse number="5" style="v" sid="MRK 1:5"/>ብይ ይሁዳ ጉቱኒፊ ነሞትን ዬሩሳሌም ሁንድኑስ ገረሳ ዸቀኒ ጩቡሳኒ ህመቻ፣ ለገ ዮርዳኖስ ኬሰት እሳን ጩጰማ ቱረን። <verse eid="MRK 1:5"/><verse number="6" style="v" sid="MRK 1:6"/>ዮሀንስ ኡፈተ ርፌንሰ ጋላራ ሆጄተሜ ኡፈቴ፣ ሙዺሳስ ሰበተ ቴጳቲን ህዸተ ቱሬ፤ እን ሀዋንሳፊ ደመ ቦሶና ኛተ ቱሬ። <verse eid="MRK 1:6"/><verse number="7" style="v" sid="MRK 1:7"/>እንስ አከነ ጄዼ ለለባ ቱሬ፤ “ከን ነ ጫላ ጀባ ተኤ፣ ህዻ ኮጴሳሌ ገድ ጄዼ ሂኩን ከን ናፍ ህንመሌ ቶኮ ነ ዱባን ንዹፈ። <verse eid="MRK 1:7"/><verse number="8" style="v" sid="MRK 1:8"/>አን ብሻኒን እስን ጩጰ፤ እን ገሩ ሀፉረ ቁልቁሉዻን እስን ጩጰ።”<verse eid="MRK 1:8"/></para>
  <para style="s1">ጩጰሙፊ ቆረሙ ዬሱስ</para>
  <para style="r">
    <ref loc="MRK 1:9-11">1፥9‑11</ref> ኩወፈ – <char style="xt"><ref loc="MAT 3:13-17">ማቴ 3፥13‑17</ref>፤ <ref loc="LUK 3:21">ሉቃ 3፥21</ref>፣<ref loc="LUK 3:22">22</ref></char></para>
  <para style="r">
    <ref loc="MRK 1:12">1፥12</ref>፣<ref loc="MRK 1:13">13</ref> ኩወፈ – <char style="xt"><ref loc="MAT 4:1-11">ማቴ 4፥1‑11</ref>፤ <ref loc="LUK 4:1-13">ሉቃ 4፥1‑13</ref></char></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9"/>ዬሮ ሰነ ዬሱስ ናዝሬት እሼ ገሊላቲ ዹፌ ለገ ዮርዳኖስ ኬሰት ዮሀንሲን ጩጰሜ። <verse eid="MRK 1:9"/><verse number="10" style="v" sid="MRK 1:10"/>ዬሱስ ኡቱመ ብሻን ኬሳ ኦል በኣ ጅሩ፣ ሰሚን በነሜ ኡቱ ሀፉር አኩመ ጉጌት እሰረት ገድ ቡኡ አርጌ። <verse eid="MRK 1:10"/><verse number="11" style="v" sid="MRK 1:11"/>ሰገሌን፣ “አት እልመኮ እሰ አን ጃለዹዸ፤ አን ባይኤ ስት ነንገመደ” ጄዹ ቶኮስ ሰሚራ ዹፌ።<verse eid="MRK 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12"/>ዬሩመ ሰነ ሀፉር ገሞጂት እሰ ባሴ፤ <verse eid="MRK 1:12"/><verse number="13" style="v" sid="MRK 1:13"/>እን ጉያ አፉርተመ ሴጠናን ቆረማ ገሞጂ ኬሰ ቱሬ። እን ብኔንሶተ ወጅን ቱሬ፤ ኤርገሞትንስ እሰ ተጃጅለን።<verse eid="MRK 1:13"/></para>
  <para style="s1">በረቶትን ጀልቀባ ዋመሙሳኒ</para>
  <para style="r">
    <ref loc="MRK 1:16-20">1፥16‑20</ref> ኩወፈ – <char style="xt"><ref loc="MAT 4:18-22">ማቴ 4፥18‑22</ref>፤ <ref loc="LUK 5:2-11">ሉቃ 5፥2‑11</ref>፤ <ref loc="JHN 1:35-42">ዮሀ 1፥35‑42</ref></char></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14"/>ኤርገ ዮሀንስ መነ ህዻት ገልፈሜ ቦዴ፣ ዬሱስ ወንጌለ ዋቃ ለለባ ገሊላ ሴኔ። <verse eid="MRK 1:14"/><verse number="15" style="v" sid="MRK 1:15"/>እንስ፣ <char style="wj">“በር ሱን ገኤረ፤ ሞቱማን ዋቃስ ዽኣቴረ፤ ቀልቢ ጅጂረዻቲ ወንጌለት አመና!”</char> ጄዼ።<verse eid="MRK 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16"/>ዬሱስ ኡቱ ቀርቀረ ገላነ ገሊላረ ዴማ ጅሩ ስሞኒፊ ኦቦሌሰሳ እንድሪያስ ኡቱ እሳን ክዮ ገላነት ደርበቻ ጅረኑ አርጌ፤ እሳን ቁርጡሚ ቀብዶተ ቱረኒቲ። <verse eid="MRK 1:16"/><verse number="17" style="v" sid="MRK 1:17"/>ዬሱስስ፣ <char style="wj">“ኮታ፣ ነ ዱካ ቡኣ፤ አንስ አከ እስን ቀብዱ ነሞታ ታተኒፍ እስን ነንኤርገ”</char> ጄዼን። <verse eid="MRK 1:17"/><verse number="18" style="v" sid="MRK 1:18"/>እሳንስ ዮሙሱመ ክዮሳኒ ዺሰኒ እሰ ዱካ ቡአን።<verse eid="MRK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19"/>እንስ ዮሙ ጥኖ አች ሂቄት ያቆብ እልመ ዘብዴዎሲፊ ኦቦሌሰሳ ዮሀንስ ኡቱ እሳን ብድሩ ኬሰት ክዮወንሳኒ ቆጴፈተኑ አርጌ። <verse eid="MRK 1:19"/><verse number="20" style="v" sid="MRK 1:20"/>እንስ ዮሙሱመ እሳን ዋሜ፤ እሳንስ አባሳኒ ዘብዴዎስን ሆጄቶተ ቀጨረመን ወጅን ብድሩ ሰነ ኬሰት ዺሰኒ እሰ ዱካ ቡአን።<verse eid="MRK 1:20"/></para>
  <para style="s1">ዬሱስ ሀፉረ ጡራኣ ባሱሳ</para>
  <para style="r">
    <ref loc="MRK 1:21-28">1፥21‑28</ref> ኩወፈ – <char style="xt"><ref loc="LUK 4:31-37">ሉቃ 4፥31‑37</ref></char></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21"/>እሳን ገረ ቅፍርናሆም ዸቀን፤ እንስ ዮሙሱመ ጉያ ሰንበታቲን መነ ሰገዳ ሴኔ በርሲሴ። <verse eid="MRK 1:21"/><verse number="22" style="v" sid="MRK 1:22"/>እን አከ በርሲስቶተ ሴራት ኡቱ ህንተእን አከ ነመ ታይታ ቀቡ ቶኮት ዋን በርሲሳ ቱሬፍ ነሞትን በርሲሰሳ ንድንቅሲፈተን። <verse eid="MRK 1:22"/><verse number="23" style="v" sid="MRK 1:23"/>ዬሩመ ሰነ ነምች መነ ሰገዳሳኒ ኬሳ ከን ሀፉረ ጡራኣን ቀበሜ ቶኮ እዬ <verse eid="MRK 1:23"/><verse number="24" style="v" sid="MRK 1:24"/>አከነ ጄዼ፤ “ያ ዬሱስ ነመ ናዝሬት፣ አት ማል ኑራ ቀብደ? ኑ በሌሱ ዹፍቴሞ? አት ኤኙ አከ ታቴ አን ነንቤከ፣ ያ ቁልቁልቸ ዋቃ!”<verse eid="MRK 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25"/>ዬሱስሞ፣ <char style="wj">“ጨልእሲ እሰ ኬሳ በእ!”</char> ጄዼ እፈቴ። <verse eid="MRK 1:25"/><verse number="26" style="v" sid="MRK 1:26"/>ሀፉር ጡራኣን ሱንስ ነምቸ ዽዺተቺሴ፣ ሰገሌ ጉዳዻን እዬ ኬሳ በኤ።<verse eid="MRK 1:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 1:27"/>ነሞትን ሁንድኑ ባይኤ ድንቅፈተኒ፣ “ኩን ማሊ? እን ታይታዻን በርሲሰ ሃራ በርሲሰ! ሀፉሮተ ጡራኦሌ ንአጀጀ፤ እሳንስ ንአጀጀሙፍ” ወሊን ጄዸን። <verse eid="MRK 1:27"/><verse number="28" style="v" sid="MRK 1:28"/>ኦዱን ዋኤሳስ ደፌ ብየ ገሊላ ጉቱ ኬሰ ፈፈጨኤ።<verse eid="MRK 1:28"/></para>
  <para style="s1">ዬሱስ ነመ ሄዱ ፈይሱሳ</para>
  <para style="r">
    <ref loc="MRK 1:29-31">1፥29‑31</ref> ኩወፈ – <char style="xt"><ref loc="MAT 8:14">ማቴ 8፥14</ref>፣<ref loc="MAT 8:15">15</ref>፤ <ref loc="LUK 4:38">ሉቃ 4፥38</ref>፣<ref loc="LUK 4:39">39</ref></char></para>
  <para style="r">
    <ref loc="MRK 1:32-34">1፥32‑34</ref> ኩወፈ – <char style="xt"><ref loc="MAT 8:16">ማቴ 8፥16</ref>፣<ref loc="MAT 8:17">17</ref>፤ <ref loc="LUK 4:40">ሉቃ 4፥40</ref>፣<ref loc="LUK 4:41">41</ref></char></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29"/>እሳንስ አኩመ መነ ሰገዳቲ በአኒን ያቆቢፊ ዮሀንስ ወጅን መነ ስምኦኒፊ እንድሪያስ ዸቀን። <verse eid="MRK 1:29"/><verse number="30" style="v" sid="MRK 1:30"/>ሃት ኒቲ ስሞንስ ዹኩበ ዸግነ ጉባዻን ቀበምቴ ጪፍት ቱርቴ፤ እሳንስ ዮሙሱመ ዋኤሼ ዬሱስት ህመን። <verse eid="MRK 1:30"/><verse number="31" style="v" sid="MRK 1:31"/>እንስ ዸቄ ሀርከ ቀቤ እሼ ካሴ። ዸግነ ጉባን ሱንስ እሼ ዺሴ፤ እሼንስ እሳን ተጃጅሉ ጀልቀብዴ።<verse eid="MRK 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32"/>ነሞትንስ ገልገለ ሰነ ኤርገ ቢፍቱን ልጤ ቦዴ፣ ዹኩብሰቶታፊ ወረ ሀፉሮተ ሀሞን ቀበመን ሁንደ ዬሱስት ፍደን። <verse eid="MRK 1:32"/><verse number="33" style="v" sid="MRK 1:33"/>መጋላን ሱን ጉቱንስ በልበለ ዱረት ወልት ቀበሜ። <verse eid="MRK 1:33"/><verse number="34" style="v" sid="MRK 1:34"/>ዬሱስስ ነሞተ ዽቤ ገራ ገራ ቀበን ሄዱ ፈይሴ፤ ሀፉሮተ ሀሞ ባይኤስ ንባሴ፤ ገሩ እን ሰበቢ ሀፉሮትን ሀሞን ሱን ኤኙማሳ ቤከኒፍ አከ እሳን ዱበተን ህንኤየምኔፍ።<verse eid="MRK 1:34"/></para>
  <para style="s1">ዬሱስ እዶ ነምን ህንጅሬት ከዸቹሳ</para>
  <para style="r">
    <ref loc="MRK 1:35-38">1፥35‑38</ref> ኩወፈ – <char style="xt"><ref loc="LUK 4:42">ሉቃ 4፥42</ref>፣<ref loc="LUK 4:43">43</ref></char></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35"/>ዬሱስ ገነመ በሪ ድምምሳን ከኤ መና በኤ እዶ ነምን ህንጅሬ ቶኮ ዸቄ አችት ከዸቴ። <verse eid="MRK 1:35"/><verse number="36" style="v" sid="MRK 1:36"/>ስምኦኒፊ ወር እሰ ወጅን ቱረን እሰ በርባዱ ዴመን፤ <verse eid="MRK 1:36"/><verse number="37" style="v" sid="MRK 1:37"/>እሳንስ ዮሙ እሰ አርገተንት፣ “ነምን ሁንድኑ ስበርባዳ ጅረ!” ጄዸኒን።<verse eid="MRK 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38"/>ዬሱስሞ ዴብሴ፣ <char style="wj">“አከ አን አችትስ ለለቡፍ ኮታ ገረ መጋላወን ዽኦ ጅረን ካኒ ዸቅና። ሰበቢን አን ዹፌፍስ ከኑመ”</char> ጄዼ። <verse eid="MRK 1:38"/><verse number="39" style="v" sid="MRK 1:39"/>ከናፉ እን መኔን ሰገዳሳኒ ኬሰት ለለባ፣ ሀፉሮተ ሀሞስ ባሳ፣ ገሊላ ጉቱ ኬሰ ዴሜ።<verse eid="MRK 1:39"/></para>
  <para style="s1">ነምቸ ለምጣኣ ቶኮ</para>
  <para style="r">
    <ref loc="MRK 1:40-44">1፥40‑44</ref> ኩወፈ – <char style="xt"><ref loc="MAT 8:2-4">ማቴ 8፥2‑4</ref>፤ <ref loc="LUK 5:12-14">ሉቃ 5፥12‑14</ref></char></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40"/>ነምች ለምጣኣን ቶኮ ገረሳ ዹፌ ጅልቤንፈቴ፣ “ዮ ፌዺኬ ተኤ፣ አት ነ ቁልቁሌሱ ንደንዴሰ” ጄዼ እሰ ከዸቴ።<verse eid="MRK 1:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41"/>ዬሱስስ ገራ ላፌፊ፣ ሀርከሳ ሂጠቴ ነምቸ ቀቀቤ፣ <char style="wj">“ፌዺኮት፤ ቁልቁላእ!”</char> ጄዼን። <verse eid="MRK 1:41"/><verse number="42" style="v" sid="MRK 1:42"/>ዬሩመ ሰነ ለምጢን ሱን ነምቸራ በዴ፤ ነምችስ ንቁልቁላኤ።<verse eid="MRK 1:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 1:43"/>ዬሱስስ ኦፍ ኤገኖ ጀባ ኬኔፊ ዮሙሱመ ገድ እሰ ዺሴ። <verse eid="MRK 1:43"/><verse number="44" style="v" sid="MRK 1:44"/>አከነስ ጄዼን፤ <char style="wj">“አት ዋን ከነ ነመ ቶኮትሌ አከ ህንህምኔ ቤከዹ፤ ገሩ ዸቂቲ አከ እሳኒፍ ረጋ ተኡፍ ሉበት ኦፍ አርግሲስ፤ ቁልቁላኡኬቲፍስ ኣርሳወን ሙሴን አጀጄ ሰነ ዽኤስ።”</char> <verse eid="MRK 1:44"/><verse number="45" style="v" sid="MRK 1:45"/>ነምች ገሩ አቺ በኤ ባይእሴ ኦዴሱ ጀልቀቤ። ከናፍስ ዬሱስ ኤርገሲ መጋላን አለ፣ ለፈ ነምን ህንጅሬ ቱሬ መሌ እፋን እፈት መጋለቲ ሴኑ ህንደንዴኜ። ነሞትን ገሩ እዶ ሁንደት እሰ ብረ ዹፋ ቱረን።<verse eid="MRK 1:45"/></para>
  <chapter eid="MRK 1"/>
  <chapter number="2" style="c" sid="MRK 2"/>
  <para style="s1">ዬሱስ ነመ ዸግን እረት ዱኤ ቶኮ ፈይሱሳ</para>
  <para style="r">
    <ref loc="MRK 2:3-12">2፥3‑12</ref> ኩወፈ – <char style="xt"><ref loc="MAT 9:2-8">ማቴ 9፥2‑8</ref>፤ <ref loc="LUK 5:18-26">ሉቃ 5፥18‑26</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1"/>ዬሱስ ጉያ ሙራሰ ቦዴ ቅፍርናሆምት ዴብኤ፤ ነሞትንስ አከ እን መነ ጅሩ ዸገአን። <verse eid="MRK 2:1"/><verse number="2" style="v" sid="MRK 2:2"/>ነሞትን አከ መሌ ባይአተን ወልት ቀበምናን እዶን ዸበሜ በልበል ዱርስ ዽጰቴ፤ እንስ ዱብቸ እሳንት ለለባ ቱሬ። <verse eid="MRK 2:2"/><verse number="3" style="v" sid="MRK 2:3"/>ጀር ቶኮ ነመ ዸግን እረት ዱኤ ከን ነሞተ አፉሪን ባተሜ ቶኮ ገረሳ ፍደን። <verse eid="MRK 2:3"/><verse number="4" style="v" sid="MRK 2:4"/>እሳንስ ሰበቢ ባይእነ ነማቲፍ ነምቸ ሰነ ዬሱስት ዽኤሱ ደዸበኒ ቅጠ ዬሱስ ቱሬን በንቲ መና ሳቀኒ ስሬ ነምች ዸግን እረት ዱኤ እረ ጪሴ ሰነ ገድ ቡሰን። <verse eid="MRK 2:4"/><verse number="5" style="v" sid="MRK 2:5"/>ዬሱስስ ዮሙ አመንቲሳኒ አርጌት ነምቸ ዸግን እረት ዱኤ ሰናን፣ <char style="wj">“ጉርባ፣ ጩቡንኬ ሲፍ ዺፈሜረ”</char> ጄዼ።<verse eid="MRK 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6"/>በርሲስቶተ ሴራ ኬሳ ቶኮ ቶኮ አች ተታአኒ ገራሳኒ ኬሰት፣ <verse eid="MRK 2:6"/><verse number="7" style="v" sid="MRK 2:7"/>“ነምች ኩን ማሊፍ አከነ ዱበተ? እን ዋቀ አረብሰ! ዋቀ ቶክቸ መሌ ኤኙቱ ጩቡ ነማፍ ዺሱ ደንደአ?” ጄዸኒ ያደን።<verse eid="MRK 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8"/>ዬሱስስ ዬሩመ ሰነ አከ ወን እሳን ገራሳኒ ኬሰት ያዳ ቱረን ከነ ተኤ ሀፉራን ቤኬ አከነ ጄዼን፤ <char style="wj">“እስን ማሊፍ ዋን ከነ ያዱ?</char> <verse eid="MRK 2:8"/><verse number="9" style="v" sid="MRK 2:9"/><char style="wj">ነምቸ ዸግን እረት ዱኤ ከናን፣ ‘ጩቡንኬ ሲፍ ዺፈሜረ’ ጄቹሞ ‘ከኢ ስሬኬ ፉዸዹ ዴም’ ጄቹቱ ሰልጳዸ?</char> <verse eid="MRK 2:9"/><verse number="10" style="v" sid="MRK 2:10"/><char style="wj">አን ገሩ አከ እልም ነማ ጩቡ ነማፍ ዺሱዻፍ ለፈረት ታይታ ቀቡ አከ ቤክተን ነንበርባደ።”</char> ከናፉ እን ነምቸ ሰናን፣ <verse eid="MRK 2:10"/><verse number="11" style="v" sid="MRK 2:11"/><char style="wj">“አን ስት ነንህመ፤ ከእ፤ ስሬኬ ፉዸዹቲ መነኬት ገል”</char> ጄዼ። <verse eid="MRK 2:11"/><verse number="12" style="v" sid="MRK 2:12"/>እንስ ከኤ፣ ዮሙሱመ ስሬሳ ፉዸቴ ኡቱመ እሳን ሁንድኑ አርገኑ በኤ ዴሜ። ኩንስ ሁንደሳኒ ድንቅሲሴ፤ እሳንስ፣ “ኑ ተኩማ ዋን አከና አርግኔ ህንቤክኑ!” ጄዸኒ ዋቀ ጀጀን።<verse eid="MRK 2:12"/></para>
  <para style="s1">ዋመሙ ሌዊ</para>
  <para style="r">
    <ref loc="MRK 2:14-17">2፥14‑17</ref> ኩወፈ – <char style="xt"><ref loc="MAT 9:9-13">ማቴ 9፥9‑13</ref>፤ <ref loc="LUK 5:27-32">ሉቃ 5፥27‑32</ref></char></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13"/>ዬሱስ አመሌ ገረ ቀርቀረ ገላንቻት ገድ በኤ። ነሞትን ባይኤንስ እሰ ብረት ወልት ቀበመን፤ እንስ እሳን በርሲሱ ጀልቀቤ። <verse eid="MRK 2:13"/><verse number="14" style="v" sid="MRK 2:14"/>እንስ ኡቱ አቺን ደርባ ጅሩ፣ ሌዊ እልመ እልፍዮስ ኡቱ እን እዶ እት ቀረጠ ወልት ቀበን ታኡ አርጌ፣ <char style="wj">“ነ ዱካ ቡእ”</char> ጄዼን። ሌዊንስ ከኤ እሰ ዱካ ቡኤ።<verse eid="MRK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15"/>ዬሮ ዬሱስ መነ ሌዊት እርባተ ኛቻ ቱሬት፣ ቀረጦትኒፊ ጩበሞትን ባይኤንሳፊ በረቶተሳ ወጅን ኛቻ ቱረን፤ ነሞትን እሰ ዱካ ቡአን ባይኤ ቱረኒቲ። <verse eid="MRK 2:15"/><verse number="16" style="v" sid="MRK 2:16"/>በርሲስቶትን ሴራ ወር ፈሪሶተ ቱረን ዮሙ እሳ ጩበሞታፊ ቀረጦተ ወጅን ኛቱ አርገንት፣ “እን ማሊፍ ቀረጦታፊ ጩበሞተ ወጅን ኛተ?” ጄዸኒ በረቶተሳ ጋፈተን።<verse eid="MRK 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17"/>ዬሱስሞ ዋን ከነ ዸጌኛን፣ <char style="wj">“ኦጌስ ፈያ ቶኮ ወረ ዹኩብሰተኒፍ መሌ ወረ ፈያ ቀበኒፍ ህንበርባችሱ። አን ጩበሞተ ዋሙፍን ዹፌ መሌ ቀጄልቶተ ዋሙፍ ህንዹፍኔ”</char> ጄዼን።<verse eid="MRK 2:17"/></para>
  <para style="s1">ዬሱስ ዋኤ ሶማ ጋፈተሜ</para>
  <para style="r">
    <ref loc="MRK 2:18-22">2፥18‑22</ref> ኩወፈ – <char style="xt"><ref loc="MAT 9:14-17">ማቴ 9፥14‑17</ref>፤ <ref loc="LUK 5:33-38">ሉቃ 5፥33‑38</ref></char></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18"/>በረቶትን ዮሀንሲፊ ፈሪሶትን ንሶሙ ቱረን። ነሞትን ቶኮ ቶኮ ዹፈኒ፣ “በረቶትን ዮሀንሲፊ በረቶትን ፈሪሶታ ንሶሙ፤ በረቶትንኬ ገሩ ማሊፍ ህንሶምኔ?” ጄዸኒ ዬሱስን ጋፈተን።<verse eid="MRK 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19"/>ዬሱስሞ አከነ ጄዼ ዴብሴ፤ <char style="wj">“ኬሱሞትን ምስርቻ አከሚን ኡቱ እን እሳን ወጅን ጅሩ ሶሙ ደንደኡ? እሳን ሀመ እሰ ኦፍ ብራ ቀበንት ሶሙ ህንደንደአን።</char> <verse eid="MRK 2:19"/><verse number="20" style="v" sid="MRK 2:20"/><char style="wj">ገሩ ዬሮን እት ምስርች እሳን ብራ ፉዸተሙ ንዹፈ፤ እሳንስ ጋፈስ ንሶሙ።</char><verse eid="MRK 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21"/>
    <char style="wj">“ነምን ኡፈተ ሞፋረት ኤርቤ ሃራ ኤርቡ ቶኮዩ ህንጅሩ። ዮ ኩን ጎዸሜ፣ ኤርቤን ሃራን ሱን ኡፈተ ሰነ እራ ተርሳሰ፤ ተርሰኣን ሱንስ እሰ ዱራ ንጫለ።</char> <verse eid="MRK 2:21"/><verse number="22" style="v" sid="MRK 2:22"/><char style="wj">ነምን ዳዺ ወይኒ ሃራ ቀልቀሎ ሞፋት ነቁ ቶኮዩ ህንጅሩ። ዮ እት ነቄሞ ዳዺን ሱን ቀልቀሎ ሰነ ዾሰ፤ ዳዽቺፊ ቀልቀልች ሆሮማ በኡ። ቆደ ከና ዳዺን ወይኒ ሃራን ቀልቀሎ ሃራት ነቀሙ ቀበ።”</char><verse eid="MRK 2:22"/></para>
  <para style="s1">ዬሱስ ጎፍታ ሰንበታ ተኡሳ</para>
  <para style="r">
    <ref loc="MRK 2:23-28">2፥23‑28</ref> ኩወፈ – <char style="xt"><ref loc="MAT 12:1-8">ማቴ 12፥1‑8</ref>፤ <ref loc="LUK 6:1-5">ሉቃ 6፥1‑5</ref></char></para>
  <para style="r">
    <ref loc="MRK 3:1-6">3፥1‑6</ref> ኩወፈ – <char style="xt"><ref loc="MAT 12:9-14">ማቴ 12፥9‑14</ref>፤ <ref loc="LUK 6:6-11">ሉቃ 6፥6‑11</ref></char></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23"/>ጉያ ሰንበታ ቶኮ ዬሱስ ለፈ ቆቲሳ ምዻኒ ኬሰ ደርባ ቱሬ፤ በረቶትንሳስ ኡቱ እሰ ወጅን ዴማ ጅረኑ አሼቲ ምዻኒ ጭረቹ ጀልቀበን። <verse eid="MRK 2:23"/><verse number="24" style="v" sid="MRK 2:24"/>ፈሪሶትንስ፣ “እላ፣ እሳን ማሊፍ ዋን ሰንበታን ሆጄቹን ህንኤየመምኔ ሆጄቱ?” ጄዸኒን።<verse eid="MRK 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25"/>እንስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“እስን ዋን ዳዊት ዬሮ እኒፊ ሚልቶትንሳ ቤለአኒፊ ረከተንት ጎዼ ሰነ ተኩማ ህንዱብፍኔ?</char> <verse eid="MRK 2:25"/><verse number="26" style="v" sid="MRK 2:26"/><char style="wj">በረ አብያታር ሉበ ኦል ኣና ቱሬ ኬሰ፣ እን መነ ዋቃ ሴኔ ቡዴነ ቁልቁሌፈሜ ከን አከ ሉቦትን ቆፍት ኛተኒፍ ኤየመሜ ሰነ ኛቴ። ወረ እሰ ወጅን ጅረኒፍስ ንኬኔ።”</char><verse eid="MRK 2:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27"/>ዬሱስስ አከነ ጄዼን፤ <char style="wj">“ሰንበተቱ ነማፍ ኡመሜ መሌ ነምን ሰንበታፍ ህንኡመምኔ።</char> <verse eid="MRK 2:27"/><verse number="28" style="v" sid="MRK 2:28"/><char style="wj">ከናፉ እልም ነማ ሰንበታፍሌ ጎፍታዸ።”</char><verse eid="MRK 2:28"/></para>
  <chapter eid="MRK 2"/>
  <chapter number="3" style="c" sid="MRK 3"/>
  <para style="s1">ዬሱስ ጉያ ሰንበታቲን ፈይሱሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1"/>አመስ ዬሱስ መነ ሰገዳ ሴኔ፤ ነምች ሀርክ እረት ጎጌ ቶኮስ አች ቱሬ። <verse eid="MRK 3:1"/><verse number="2" style="v" sid="MRK 3:2"/>እሳን ኬሳስ ነሞትን ቶኮ ቶኮ ዬሱስን ህመቹፍ ጄዸኒ ሰበበ በርባዳ ቱረን፤ ከናፉ አከ እን ሰንበታን ነምቸ ፈይሱ እላሉፍ እሰ ጋደን። <verse eid="MRK 3:2"/><verse number="3" style="v" sid="MRK 3:3"/>ዬሱስስ ነምቸ ሀርክ እረት ጎጌ ሰናን፣ <char style="wj">“ከኢ ፉለ ነመ ሁንዳ ዱረ ዻበዹ”</char> ጄዼ።<verse eid="MRK 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 3:4"/>ዬሱስስ፣ <char style="wj">“ሰንበታን እሰ ከምቱ ኤየመማዸ? ዋን ጋሪ ሆጄቹሞ ዋን ሀማ ሆጄቹ? ሉቡ ኦልቹሞ አጄሱ?”</char> ጄዼ እሳን ጋፈቴ። እሳን ገሩ ንጨልእሰን።<verse eid="MRK 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 3:5"/>እንስ መተ ጀብነሳኒት አከ መሌ ገዴ፣ ኣሪዻን ገረገሌ እሳን እላሌ፤ ነምቸ ሰናንስ፣ <char style="wj">“ሀርከኬ ድሪርፈዹ!”</char> ጄዼ። ነምችስ ሀርከ ድሪርፈቴ፤ ሀርክሳስ ጉቱማን ጉቱት ፈዬ። <verse eid="MRK 3:5"/><verse number="6" style="v" sid="MRK 3:6"/>ፈሪሶትንስ ገድ በአኒ አከ እቲን ዬሱስን አጄሱ ደንደአን ገሬ ሄሮድስ ወጅን መርአቹ ጀልቀበን።<verse eid="MRK 3:6"/></para>
  <para style="s1">ነሞትን ዬሱስ ዱካ ቡአን</para>
  <para style="r">
    <ref loc="MRK 3:7-12">3፥7‑12</ref> ኩወፈ – <char style="xt"><ref loc="MAT 12:15">ማቴ 12፥15</ref>፣<ref loc="MAT 12:16">16</ref>፤ <ref loc="LUK 6:17-19">ሉቃ 6፥17‑19</ref></char></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7"/>ዬሱስ በረቶተሳ ወጅን አቺ ከኤ ገረ ገላንቻት ቀጄሌ፤ ቱትን ነሞተ ባይኤስ ገሊላዻ እሰ ዱካ ቡኤ። <verse eid="MRK 3:7"/><verse number="8" style="v" sid="MRK 3:8"/>ነሞትን ባይኤንስ ዮሙ ዋን እን ሆጄቻ ቱሬ ሁንደ ዸገአንት ይሁዳዻ፣ ዬሩሳሌሚ፣ ኤዶምያሲ፣ ብየ ዮርዳኖስ ገማቲ፣ ናኖ ጢሮሲቲፊ ስዶናቲ ገረሳ ዹፈን። <verse eid="MRK 3:8"/><verse number="9" style="v" sid="MRK 3:9"/>እንስ አከ ባይእነ ነማቲን ህንዺበምኔፍ አከ እሳን ብድሩ ጥኖ ቶኮ እሳፍ ቆጴሰን በረቶተሳት ህሜ። <verse eid="MRK 3:9"/><verse number="10" style="v" sid="MRK 3:10"/>ሰበቢ እን ነመ ባይኤ ፈይሴ ቱሬፍ፣ ወር ዹኩብሰተን ሁንድኑ እሰ ቱቁፍ ጄዸኒ እረት ወል ጨብሳ ቱረን። <verse eid="MRK 3:10"/><verse number="11" style="v" sid="MRK 3:11"/>ሀፉሮትን ጡራኦንስ ዬሮ እሰ አርገን ፉለሳ ዱረት ኩፈኒ፣ “አት እልመ ዋቃት!” ጄዸኒ እዩ ቱረን። <verse eid="MRK 3:11"/><verse number="12" style="v" sid="MRK 3:12"/>እን ገሩ አከ እሳን አከ እን ቤከሙ ህንጎኔ ጀቤሴ እሳን አጀጄ።<verse eid="MRK 3:12"/></para>
  <para style="s1">ፍለተሙ ኤርገሞተ ኩዸ ለማኒ</para>
  <para style="r">
    <ref loc="MRK 3:16-19">3፥16‑19</ref> ኩወፈ – <char style="xt"><ref loc="MAT 10:2-4">ማቴ 10፥2‑4</ref>፤ <ref loc="LUK 6:14-16">ሉቃ 6፥14‑16</ref>፤ <ref loc="ACT 1:13">ሆጂ 1፥13</ref></char></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13"/>ዬሱስስ ቱሉት ኦል በኤ ወረ ኦፊሳቲ በርባዴ ኦፍት ዋሜ፤ እሳንስ ገረሳ ዹፈን። <verse eid="MRK 3:13"/><verse number="14" style="v" sid="MRK 3:14"/>እንስ አከ እሳን እሰ ወጅን ጅራተኒፊ አከ ለለባፍ እሳን ኤርጉፍ ነሞተ ኩዸ ለመ ሙዴ በረቶተ ጄዼ ሞጋሴ፤ <verse eid="MRK 3:14"/><verse number="15" style="v" sid="MRK 3:15"/>አከ እሳን ሀፉሮተ ሀሞ ባሰኒፍስ ታይታ ኬኔፍ።<verse eid="MRK 3:15"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="16" style="v" sid="MRK 3:16"/>ወር ኩዸ ለማን እን ሙዴስ እሳን ከነ፦</para>
  <para style="b" vid="MRK 3:16"/>
  <para style="li1" vid="MRK 3:16">ስሞን እሰ እን “ጴጥሮስ” ጄዼ ሞጋሴ፣<verse eid="MRK 3:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="MRK 3:17"/>ያቆብ እልመ ዘብዴዎሲፊ ኦቦሌሰሳ ዮሀንስ ወረ እን “ቦአኔርጌስ” ጄዼ ሞጋሴ፤ ቦአኔርጌስ ጄቹን እልማን “ከከዌ” ጄቹዸ፤<verse eid="MRK 3:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="MRK 3:18"/>እንድሪያስ፣</para>
  <para style="li1" vid="MRK 3:18">ፊልጶስ፣</para>
  <para style="li1" vid="MRK 3:18">በርተሎሜዎስ፣</para>
  <para style="li1" vid="MRK 3:18">ማቴዎስ፣</para>
  <para style="li1" vid="MRK 3:18">ቶማስ፣</para>
  <para style="li1" vid="MRK 3:18">ያቆብ እልመ እልፍዮስ፣</para>
  <para style="li1" vid="MRK 3:18">ታዴዎስ፣</para>
  <para style="li1" vid="MRK 3:18">ስሞን ህናፍትቸ፣<verse eid="MRK 3:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="MRK 3:19"/>ይሁዳ አስቆሮትቸ እሰ ዬሱስን ደበርሴ ኬኔ።<verse eid="MRK 3:19"/></para>
  <para style="s1">ዬሱሲፊ ብኤልዜቡል</para>
  <para style="r">
    <ref loc="MRK 3:23-27">3፥23‑27</ref> ኩወፈ – <char style="xt"><ref loc="MAT 12:25-29">ማቴ 12፥25‑29</ref>፤ <ref loc="LUK 11:17-22">ሉቃ 11፥17‑22</ref></char></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20"/>ዬሱስስ መነ ቶኮ ሴኔ፤ ሰበቢ ነሞትን አከ መሌ ባይአተን አመስ ወልት ቀበመኒፍ እኒፊ በረቶትንሳ ዋ ኛቹሌ ህንደንዴኜ። <verse eid="MRK 3:20"/><verse number="21" style="v" sid="MRK 3:21"/>ፍሮትንሳስ ዮሙ ዋን ከነ ዸገአንት እሰ ቀቡ ዸቀን፤ ነሞትን፣ “እን ቀልቢ ደበርሴረ” ጄቻ ቱረኒቲ።<verse eid="MRK 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22"/>በርሲስቶትን ሴራ ወር ዬሩሳሌሚ ገድ ቡአን፣ “እን ብኤልዜቡሊን ቀበሜረ! ሀንገፈ ሀፉሮተ ሀሞቲን ሀፉሮተ ሀሞ ባሳ ጅረ” ጄዸን።<verse eid="MRK 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23"/>ዬሱስሞ ኦፍት እሳን ዋሜ አከነ ጄዼ ፈኬኛን እሳንት ዱበቴ፦ <char style="wj">“ሴጠን አከምት ሴጠነ ባሱ ደንደአ?</char> <verse eid="MRK 3:23"/><verse number="24" style="v" sid="MRK 3:24"/><char style="wj">ሞቱማን ቶኮ ዮ ገርገር ኦፍ ቆዴ፣ ሞቱማን ሱን ዻበቹ ህንደንደኡ።</char> <verse eid="MRK 3:24"/><verse number="25" style="v" sid="MRK 3:25"/><char style="wj">መን ቶኮ ዮ ገርገር ኦፍ ቆዴ፣ መን ሱን ዻበቹ ህንደንደኡ።</char> <verse eid="MRK 3:25"/><verse number="26" style="v" sid="MRK 3:26"/><char style="wj">ሴጠንስ ዮ ገርገር ኦፍ ቆዴ፣ እን ዻበቹ ህንደንደኡ፤ ዹምንሳ ገኤራቲ።</char> <verse eid="MRK 3:26"/><verse number="27" style="v" sid="MRK 3:27"/><char style="wj">ዹጉማን ነምን ከምዩ ኡቱ ዱራን ዱርሴ ነመ ጀባ ቶኮ ህንህዽን፣ መነ ነመ ጀባ ሰና ሴኔ ቀቤኘሳ ሳሙ ህንደንደኡ። ኤርገሲ እን መነ ነምቸ ጀባ ሰና ሳሙ ደንደአ።</char> <verse eid="MRK 3:27"/><verse number="28" style="v" sid="MRK 3:28"/><char style="wj">አን ዹጉመ እስንትን ህመ፤ ጩቡንሳኒ ሁንዲፊ አረብሶን እሳን ዱበተን ሁንድ ነሞታፍ ዺፈሙ ንደንደአ፤</char> <verse eid="MRK 3:28"/><verse number="29" style="v" sid="MRK 3:29"/><char style="wj">ነምን ሀፉረ ቁልቁሉ አረብሱ ከምዩ ገሩ ጎንኩማ ዺፈመ ህንአርገቱ፤ እን እት ጋፈተማ ጩቡ በረ በራት።”</char><verse eid="MRK 3:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 3:30"/>ዬሱስስ ሰበቢ እሳን፣ “እን ሀፉረ ጡራኣ ቀበ” ጄቻ ቱረኒፍ ዋን ከነ ዱበቴ።<verse eid="MRK 3:30"/></para>
  <para style="s1">ሃዸ ዬሱሲፊ ኦቦሎተሳ</para>
  <para style="r">
    <ref loc="MRK 3:31-35">3፥31‑35</ref> ኩወፈ – <char style="xt"><ref loc="MAT 12:46-50">ማቴ 12፥46‑50</ref>፤ <ref loc="LUK 8:19-21">ሉቃ 8፥19‑21</ref></char></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31"/>ሃቲፊ ኦቦሎትንሳ ዹፈኒ፣ አለ ዻበተኒ ነመ እት ኤርገኒ እሰ ዋምስሰን። <verse eid="MRK 3:31"/><verse number="32" style="v" sid="MRK 3:32"/>ነሞትን ባይኤንስ እሰት ናነአኒ ታኣ ቱረን፤ እሳንስ፣ “ሃትኬቲፊ ኦቦሎትንኬ አለ ዸዻበተኒ ስ እያፈቻ ጅሩ” ጄዸኒ እሰት ህመን።<verse eid="MRK 3:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33"/>እንሞ፣ <char style="wj">“ሃትኮፊ ኦቦሎትንኮ ኤኙ?”</char> ጄዼ ጋፈቴ።<verse eid="MRK 3:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 3:34"/>እንስ ወረ ናኖሳ መርሰኒ ተታአን እላሌ አከነ ጄዼ፤ <char style="wj">“ሃትኮፊ ኦቦሎትንኮ ኩኖት!</char> <verse eid="MRK 3:34"/><verse number="35" style="v" sid="MRK 3:35"/><char style="wj">ነምን ፌዺ ዋቃ ራወቱ ከምዩ ኦቦሌሰኮት፤ ኦቦሌቲኮት፤ ሃዸኮትስ።”</char><verse eid="MRK 3:35"/></para>
  <chapter eid="MRK 3"/>
  <chapter number="4" style="c" sid="MRK 4"/>
  <para style="s1">ፈኬኘ ነመ ሰኚ ፈጫሱ</para>
  <para style="r">
    <ref loc="MRK 4:1-12">4፥1‑12</ref> ኩወፈ – <char style="xt"><ref loc="MAT 13:1-15">ማቴ 13፥1‑15</ref>፤ <ref loc="LUK 8:4-10">ሉቃ 8፥4‑10</ref></char></para>
  <para style="r">
    <ref loc="MRK 4:13-20">4፥13‑20</ref> ኩወፈ – <char style="xt"><ref loc="MAT 13:18-23">ማቴ 13፥18‑23</ref>፤ <ref loc="LUK 8:11-15">ሉቃ 8፥11‑15</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1"/>ዬሱስ አመስ ቀርቀረ ገላንቻት በርሲሱ ጀልቀቤ። ቱትን ናኖሳት ወልት ቀበሜ አከ መሌ ጉዳ ቱሬ፤ ኡቱ ነሞትን ሁንድ ቀርቀረ ገላንቻረ አፋን ብሻኒ ጅረኑ፣ እን ብድሩ ያበቴ ገላንቸረ አች ሂቄ ታኤ። <verse eid="MRK 4:1"/><verse number="2" style="v" sid="MRK 4:2"/>ፈኬኛንስ ዋን ባይኤ እሳን በርሲሴ፤ በርሲሰሳ ኬሰትስ አከነ ጄዼ፦ <verse eid="MRK 4:2"/><verse number="3" style="v" sid="MRK 4:3"/><char style="wj">“ሜ ዸገኣ! ኩኖ፣ ነምች ሰኚ ፈጫሱ ቶኮ ሰኚ ፈጫፈቹ በኤ።</char> <verse eid="MRK 4:3"/><verse number="4" style="v" sid="MRK 4:4"/><char style="wj">ኡቱ እን ፈጫሳ ጅሩስ ሰኚን ቶኮ ቶኮ ከራረ ቡኤ፤ ስምብሮትንስ ዹፈኒ ኛተኒ ፍጠን።</char> <verse eid="MRK 4:4"/><verse number="5" style="v" sid="MRK 4:5"/><char style="wj">ካንሞ ለፈ ከታ፣ እዶ ብዮ ባይኤ ህንቀብኔረ ቡኤ። ሰኚን ሱንስ ሰበቢ ብዮን ሱን ገድ ፈጌኘ ህንቀባትኒፍ ደፌ ብቅሌ።</char> <verse eid="MRK 4:5"/><verse number="6" style="v" sid="MRK 4:6"/><char style="wj">ዮሙ አዱን ባቴት ገሩ ብቅልቱን ሱን ንጮለጌ፤ ዋን ህደ ህንቀባትኒፍስ ንጎጌ።</char> <verse eid="MRK 4:6"/><verse number="7" style="v" sid="MRK 4:7"/><char style="wj">ሰኚን ብራስ ቆራቲ ኬሰ ቡኤ፤ ቆራቲን ሱንስ ጉደቴ ብቅልቱ ሰነ ሁዼ፤ ብቅልቱን ሱንስ እጀ ህንነቀትኔ።</char> <verse eid="MRK 4:7"/><verse number="8" style="v" sid="MRK 4:8"/><char style="wj">አመስ ሰኚን ካን ብዮ ጋሪረ ቡኤ። ንብቅሌ፤ ንጉደቴ፤ እጀስ ንነቀቴ። እን ቶኮ ሶዶመ፣ ካን ጃተመ፣ ካንሞ ዽበ ነቀቴ።”</char><verse eid="MRK 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9"/>ዬሱስስ፣ <char style="wj">“ነምን ጉረ ዸገኡ ቀቡ ከምዩ ሃዸገኡ”</char> ጄዼ።<verse eid="MRK 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10"/>ዬሮ እን ኮጳ ቱሬትስ ወር ኩዸ ለማኒፊ ነሞትን ናኖሳ ቱረን ብራ ዋኤ ፈኬኘ ሰና እሰ ጋፈተን። <verse eid="MRK 4:10"/><verse number="11" style="v" sid="MRK 4:11"/>እንስ አከነ ጄዼን፤ <char style="wj">“እጪቲን ሞቱማ ዋቃ እስኒፍ ኬነሜረ። ወረ አለ ጅረንት ገሩ ወን ሁንድኑ ፈኬኛን ህመመ፤</char> <verse eid="MRK 4:11"/><verse number="12" style="v" sid="MRK 4:12"/><char style="wj">ኩንስ፣</char></para>
  <para style="q1" vid="MRK 4:12">
    <char style="wj">“ ‘እሳን አከ ህንዴብኔፊ አከ ዺፈመ ህንአርገትኔፍ፣</char></para>
  <para style="q2" vid="MRK 4:12">
    <char style="wj">አርጉ እኑመ አርጉ፣ ገሩ ህንቀልቤፈተን፤</char></para>
  <para style="q1" vid="MRK 4:12">
    <char style="wj">ዸገኡስ እኑመ ዸገኡ፣ ገሩ ህንሁበተን።’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">4፥12 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="ISA 6:9">እሳ 6፥9</ref>፣<ref loc="ISA 6:10">10</ref></char>
      </char>
    </note>
    <char style="wj">”</char><verse eid="MRK 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13"/>ዬሱስስ አከነ እሳኒን ጄዼ፤ <char style="wj">“እስን ፈኬኘ ከነ ህንሁበተኒ? ዮስ እስን አከምት ፈኬኘ ሁንደ ሁበቱሬ?</char> <verse eid="MRK 4:13"/><verse number="14" style="v" sid="MRK 4:14"/><char style="wj">ነምች ሰኚ ፈጫሱ ሱን ዱብቸ ፈጫሰ።</char> <verse eid="MRK 4:14"/><verse number="15" style="v" sid="MRK 4:15"/><char style="wj">ነሞትን ቶኮ ቶኮ ሰኚ ከራራ፣ ለፈ ዱብች እት ፈጫፈሜ ሰነ ፈካቱ። አኩመ እሳን ዱብቸ ዸገአኒን ሴጠን ዹፌ ዱብቸ እሳን ኬሰት ፈጫፈሜ ሰነ ፉዸተ።</char> <verse eid="MRK 4:15"/><verse number="16" style="v" sid="MRK 4:16"/><char style="wj">ወር ካን አኩመ ሰኚ ከታረት ፈጫፈሜት፤ እሳን ዮሙ ዱብቸ ዸገአንት ዮሙሱመ ገመቹን ፉዸቱ።</char> <verse eid="MRK 4:16"/><verse number="17" style="v" sid="MRK 4:17"/><char style="wj">ገሩ እሳን ዋን ሁንዴ ህንቀብኔፍ ዬሮ ገባባ ቆፈ ቱሩ። ዬሮ ረክን ዮካን አርአተምን ሰበቢ ዱብቻቲፍ ዹፉት እሳን ደፈኒ ጉፈቱ።</char> <verse eid="MRK 4:17"/><verse number="18" style="v" sid="MRK 4:18"/><char style="wj">አመስ ወር ካን ሰኚ ቆራቲ ኬሰት ፈጫፈሜ ፈካቱ፤ እሳንስ ወረ ዱብቸ ዸገአኒዸ፤</char> <verse eid="MRK 4:18"/><verse number="19" style="v" sid="MRK 4:19"/><char style="wj">ገሩ ያዶን አዱኛ ከና፣ ጎዎምሳን ቀቤኛቲፊ ሀዊን ዋን ገራ ገራ እሳን ሴኔ ዱብቸ ሁዼ እጀ ነቀቹ ዾወ።</char> <verse eid="MRK 4:19"/><verse number="20" style="v" sid="MRK 4:20"/><char style="wj">ወር ካንስ ሰኚ ብዮ ጋሪረት ፈጫፈሜ ፈካቱ፤ እሳንስ ዱብቸ ንዸገኡ፤ ንፉዸቱ፤ እጀስ ንነቀቱ፤ እን ቶኮ ሶዶመ፣ ካን ጃተመ፣ ካንሞ ዽበ ነቀተ።”</char><verse eid="MRK 4:20"/></para>
  <para style="s1">እብሳ ጎምብሳ ጀላ</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21"/>እንስ አከነ እሳኒን ጄዼ፤ <char style="wj">“እስን እብሳ ጎምብሳ ጀለ ዮካን ስሬ ጀለ ካኡፍ ፍዱ? ቆደ ከና ባቱሳረ ኬሱ ምቲ?</char> <verse eid="MRK 4:21"/><verse number="22" style="v" sid="MRK 4:22"/><char style="wj">ወን ዾክፈሜ ከምዩ ሙልእፈሙፍ ጅራቲ፤ ወን ሀጉገሜ ከምዩስ እፈት ባፈሙፍ ጅራቲ።</char> <verse eid="MRK 4:22"/><verse number="23" style="v" sid="MRK 4:23"/><char style="wj">ነምን ከምዩ ዮ ጉረ ዸገኡ ቀባቴ ሃዸገኡ።”</char><verse eid="MRK 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24"/>እንስ እት ፉፌ አከነ ጄዼን፤ <char style="wj">“ዋን ዸጌሰን ቀልቤፈዻ። ሰፈርቱ እቲን ሰፈርተኒንስ፣ ሀመስ ጫላዩ እስኒፍ ሰፈረመ።</char> <verse eid="MRK 4:24"/><verse number="25" style="v" sid="MRK 4:25"/><char style="wj">ከን ቀቡ ከሚፍዩ እት ደበለሜ ንኬነመ፤ ከን ህንቀብኔ ገሩ ወን እን ቀቡዩ እራ ፉዸተመ።”</char><verse eid="MRK 4:25"/></para>
  <para style="s1">ፈኬኘ ሰኚ ጉደቱ</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26"/>አመስ አከነ ጄዼ፤ <char style="wj">“ሞቱማን ዋቃ ነመ ለፈሳረት ሰኚ ፈጫሱ ቶኮ ፈካተ።</char> <verse eid="MRK 4:26"/><verse number="27" style="v" sid="MRK 4:27"/><char style="wj">አከምት አከ ተኤ ነምች ቤኩ ባቱሌ፣ እን ረፉስ ዮካን ደመቁስ፣ ሰኚን ሱን ሀልከኒ ጉያ ንብቅለ፤ ንጉደተስ።</char> <verse eid="MRK 4:27"/><verse number="28" style="v" sid="MRK 4:28"/><char style="wj">ለፍት ኦፉመሼቲን ምዻን ባፍት፤ ጀልቀበት ብቅለ፣ እት ኣንሴ ሁዻ ምዻኒ፣ ኤርገሲሞ ምዻን ጉቱ ባፍት።</char> <verse eid="MRK 4:28"/><verse number="29" style="v" sid="MRK 4:29"/><char style="wj">ነምችስ አኩመ ምዻንች ብልቻቴን ሃሙ ጀልቀበ፤ ዬሮን ሃማ ገኤራቲ።”</char><verse eid="MRK 4:29"/></para>
  <para style="s1">ፈኬኘ ሰኚ ሰናፍጫ</para>
  <para style="r">
    <ref loc="MRK 4:30-32">4፥30‑32</ref> ኩወፈ – <char style="xt"><ref loc="MAT 13:31">ማቴ 13፥31</ref>፣<ref loc="MAT 13:32">32</ref>፤ <ref loc="LUK 13:18">ሉቃ 13፥18</ref>፣<ref loc="LUK 13:19">19</ref></char></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30"/>አመስ እን አከነ ጄዼ፤ <char style="wj">“ሞቱማን ዋቃ ማል ፈካተ ጄቹ ደንዴኘ? ዮካን ፈኬኘ ማሊቲን እሰ እብስነ?</char> <verse eid="MRK 4:30"/><verse number="31" style="v" sid="MRK 4:31"/><char style="wj">እን ሰኚ ሰናፍጫ ከን ሰኚወን ለፈረ ጅረን ሁንደረ ጥና ተኤ ፈካተ።</char> <verse eid="MRK 4:31"/><verse number="32" style="v" sid="MRK 4:32"/><char style="wj">ኤርገ ፈጫፈሜ ቦዴ ገሩ ጉደቴ ብቅልቱ ሁንደ ጫለ፤ ደሜወን ጉርጉዳ ስምብሮትንስ ጋድሰሳ ጀለ ጅራቹ ደንደአንስ ቀባተ።”</char><verse eid="MRK 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33"/>ዬሱስስ ፈኬኘወን አከና ባይኤዻን ሀመ እሳን ዸገኡ ደንደአን ዱብቸ እሳንት ዱበቴ። <verse eid="MRK 4:33"/><verse number="34" style="v" sid="MRK 4:34"/>እንስ ፈኬኛን መሌ ዋን ቶኮሌ እሳንት ህንዱበትኔ። ዬሮ ኮጳ ቱረንት ገሩ ዋን ሁንደ በረቶተሳቲፍ ንእብሴ።<verse eid="MRK 4:34"/></para>
  <para style="s1">ዬሱስ ቡቤ ገብ ጎቹሳ</para>
  <para style="r">
    <ref loc="MRK 4:35-41">4፥35‑41</ref> ኩወፈ – <char style="xt"><ref loc="MAT 8:18">ማቴ 8፥18</ref>፣<ref loc="MAT 8:23-27">23‑27</ref>፤ <ref loc="LUK 8:22-25">ሉቃ 8፥22‑25</ref></char></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35"/>እን ጋፈስ፣ ዬሮ ገልገላኤት፣ <char style="wj">“ኮታ ገመ ጬና”</char> እሳኒን ጄዼ። <verse eid="MRK 4:35"/><verse number="36" style="v" sid="MRK 4:36"/>እሳንስ ቱተ ነሞታ ሰነ አችት ዺሰኒ ዬሱስን አኩመ እን ብድሩ ኬሰ ጅሩት ፉዸኒ ዴመን። ብድሩወን ብራስ እሰ ወጅን ቱረን። <verse eid="MRK 4:36"/><verse number="37" style="v" sid="MRK 4:37"/>ቡቤን ሀማን ቶኮ ንከኤ፤ ደምበሊንስ ብድሩ ሰነ ዸኤ ብድሩን ሱን ብሻኒን ጉተሙ ገኤ። <verse eid="MRK 4:37"/><verse number="38" style="v" sid="MRK 4:38"/>ዬሱስስ ብድሩ ሰነ ኬሰ ከራ ዱባ ቦራቲ ቶኮረ ረፋ ቱሬ። በረቶትንስ እሰ ደመቅሰኒ፣ “ያ በርሲሳ፣ ዹሙንኬኘ ሆማ ስ ህንዽቡ?” ጄዸኒን።<verse eid="MRK 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39"/>እንስ ከኤ ቡቤ ሰነ እፈቴ፤ ደምበሊ ሰናንስ፣ <char style="wj">“ጨልእስ! ገብ ጄዽስ!”</char> ጄዼ። ቡቤን ሱንስ ንጨልእሴ፤ ተስገቢን ጉዳንስ ንተኤ።<verse eid="MRK 4:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 4:40"/>እንስ በረቶተሳቲን፣ <char style="wj">“እስን ማሊፍ አከነ ሶዳቱ? እስን አመዩ አመንቲ ህንቀብደኒ?”</char> ጄዼ።<verse eid="MRK 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41"/>እሳንስ አከ መሌ ሶዳተኒ፣ “ነምች ቡቤፊ ደምበሊንዩ አጀጀመኒፍ ኩን ኤኙ?” ጄዸኒ ወል ጋፈተን።<verse eid="MRK 4:41"/></para>
  <chapter eid="MRK 4"/>
  <chapter number="5" style="c" sid="MRK 5"/>
  <para style="s1">ዬሱስ ነመ ሀፉረ ሀማን ቀበሜ ቶኮ ፈይሴ</para>
  <para style="r">
    <ref loc="MRK 5:1-17">5፥1‑17</ref> ኩወፈ – <char style="xt"><ref loc="MAT 8:28-34">ማቴ 8፥28‑34</ref>፤ <ref loc="LUK 8:26-37">ሉቃ 8፥26‑37</ref></char></para>
  <para style="r">
    <ref loc="MRK 5:18-20">5፥18‑20</ref> ኩወፈ – <char style="xt"><ref loc="LUK 8:38">ሉቃ 8፥38</ref>፣<ref loc="LUK 8:39">39</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1"/>እሳንስ ገላንቸ ጬአኒ ብየ ጌርጌሴኖን ዸቀን። <verse eid="MRK 5:1"/><verse number="2" style="v" sid="MRK 5:2"/>ዮሙ ዬሱስ ብድሩራ ቡኤት፣ ዮሙሱመ ነምች ሀፉረ ጡራኣዻን ቀበሜ ቶኮ እዶ አዋላቲ በኤ እሰት ዹፌ። <verse eid="MRK 5:2"/><verse number="3" style="v" sid="MRK 5:3"/>ነምች ኩን እዶ አዋላ ጅራተ ቱሬ፤ ነምን ቶኮዩ ፎንጫንሌ ለመተ እሰ ህዹ ህንደንዴኜ። <verse eid="MRK 5:3"/><verse number="4" style="v" sid="MRK 5:4"/>እን ዬሮ ባይኤ ፉኞ ስቢላቲፊ ፎንጫዻን ህዸመ ቱሬ፤ ገሩ ፎንጫ ሰነ ኩኩቴ ፉኞ ስቢላ ሰነስ ጨጨብሰ ቱሬቲ። ነምን ገድ እሰ ቀቡ ደንደኡ ቶኮዩ ህንቱሬ። <verse eid="MRK 5:4"/><verse number="5" style="v" sid="MRK 5:5"/>እንስ ዬሮ ሁንዱማ፣ ሀልከኒ ጉያ እዶ አዋላ ኬሰቲፊ ጋረን ጉባት እያ፣ ዸግነሳስ ዸጋዻን ሙርሙራ ቱሬ።<verse eid="MRK 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6"/>እንስ ዮሙ ዬሱስን ፈጎት አርጌት እት ፊጌ፣ ፉለሳ ዱረት ጅልቤንፈቴ። <verse eid="MRK 5:6"/><verse number="7" style="v" sid="MRK 5:7"/>ሰገሌ ኦል ፉዸቴ እዬስ፣ “ያ ዬሱስ እልመ ዋቀ ዋን ሁንዳ ኦሊ፣ አት ማል ነራ በርባደ? መቃ ዋቃቲን ስን ከዸዻቲ ማሎ ነ ህንዽጵስን!” ጄዼን። <verse eid="MRK 5:7"/><verse number="8" style="v" sid="MRK 5:8"/>ዬሱስስ፣ <char style="wj">“ያ ሀፉረ ጡራኣ፣ ነምቸ ከነ ኬሳ በእ!”</char> ጄዼኒ ቱሬቲ።<verse eid="MRK 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9"/>ዬሱስስ፣ <char style="wj">“መቃንኬ ኤኙ?”</char> ጄዼ እሰ ጋፈቴ።</para>
  <para style="p" vid="MRK 5:9">እንስ፣ “ኑ ዋን ባይኤ ታኔፍ፣ መቃንኮ ‘ሌጌዎን’<note caller="+" style="f"><char style="fr" closed="false">5፥9 </char><char style="fq" closed="false">ሌጌዎን </char><char style="ft" closed="false">– ሌጌዎኒን ሮማ ቶክች ሎልቶተ 6,000 ቀበተ።</char></note>” ጄዼ ዴብሴ። <verse eid="MRK 5:9"/><verse number="10" style="v" sid="MRK 5:10"/>አከ እን ብየ ሰነ ኬሳ እሳን ህንአሪኔፍስ ጉድሴ ዬሱስን ከዸቴ።<verse eid="MRK 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11"/>ሆማን ቦዬ ጉዳንሳስ ጋረ ብረ ዼዳ ቱሬ። <verse eid="MRK 5:11"/><verse number="12" style="v" sid="MRK 5:12"/>ሀፉሮትን ሀሞን ሱንስ፣ “ገረ ሆማ ቦዬ ሰናት ኑ ኤርግ፤ አከ እት ገሉፍስ ኑ ኤየም” ጄዸኒ ዬሱስን ከዸተን። <verse eid="MRK 5:12"/><verse number="13" style="v" sid="MRK 5:13"/>እንስ ንኤየሜፍ፤ ሀፉሮትን ጡራኦን ሱን በአኒ ቦዬ ሰነት ገለን። ሆማን ገረ ቦዬ ኩመ ለማ ኦፍ ኬሳ ቀቡ ሱንስ ኤዴደ ሀለያራ ገድ ፉርጉግፈሜ ገላነት ነምኤ ልቅምፈሜ።<verse eid="MRK 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14"/>ወር ቦዬወን ትክሰን ሱንስ በቀተኒ መጋላፊ ባድያት ዋን ከነ ኦዴሰን፤ ነሞትንስ ዋን ተኤ ሰነ እላሉ ያአን። <verse eid="MRK 5:14"/><verse number="15" style="v" sid="MRK 5:15"/>እሳንስ ዮሙ ገረ ዬሱስ ዹፈንት ነምቸ ሌጌዎኒ ሀፉሮተ ሀሞቲን ቀበሜ ቱሬ ሰነ ወያ ኡፈቴ፣ ቀልቢሳትስ ዴብኤ አች ታኤ አርገን፤ ንሶዳተንስ። <verse eid="MRK 5:15"/><verse number="16" style="v" sid="MRK 5:16"/>ወር ዋን ከነ አርገኒ ቱረንስ ዋን ነምቸ ሀፉሮተ ሀሞን ቀበሜ ቱሬ ሰናፍ ተኤፊ ዋኤ ሆማ ቦዬስ ነሞተት ኦዴሰን። <verse eid="MRK 5:16"/><verse number="17" style="v" sid="MRK 5:17"/>ከነረት ጀር አከ ዬሱስ ብየሳኒ ኬሳ በኡፍ እሰ ከዸቹ ጀልቀበን።<verse eid="MRK 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18"/>ኡቱ ዬሱስ ብድሩ ያበቻ ጅሩ ነምች ሀፉረ ሀማን ቀበሜ ቱሬ ሱን እሰ ወጅን ዴሙፍ እሰ ከዸቴ። <verse eid="MRK 5:18"/><verse number="19" style="v" sid="MRK 5:19"/>ዬሱስ ገሩ፣ <char style="wj">“ገረ መነኬቲ፣ ወረኬት ገሊቲ ዋን ጉዳ ጎፍታን ሲፍ ጎዼፊ አከምት አከ እን ስ ማሬስ እሳንት ኦዴስ!”</char> ጄዼን መሌ ህንኤየምኔፍ። <verse eid="MRK 5:19"/><verse number="20" style="v" sid="MRK 5:20"/>ከናፉ ነምች ሱን ዸቄ ዋን ዬሱስ እሳፍ ጎዼ መጋላ ኩርነን ኬሰት ኦዴሱ ጀልቀቤ። ነሞትን ሁንድኑስ ንድንቅፈተን።<verse eid="MRK 5:20"/></para>
  <para style="s1">ዱርበ ዱቴፊ ዱበርቲ ዹኩብሰቴ ቶኮ</para>
  <para style="r">
    <ref loc="MRK 5:22-43">5፥22‑43</ref> ኩወፈ – <char style="xt"><ref loc="MAT 9:18-26">ማቴ 9፥18‑26</ref>፤ <ref loc="LUK 8:41-56">ሉቃ 8፥41‑56</ref></char></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21"/>ዮሙ ዬሱስ ብድሩዻን አመስ ገረ ገመ ገላናት ጬኤት ነሞትን ሄዱን እሰ ብረት ወልት ቀበመን፤ እንስ ቀርቀረ ገላና ቱሬ። <verse eid="MRK 5:21"/><verse number="22" style="v" sid="MRK 5:22"/>ሆገንቶተ መነ ሰገዳ ኬሳስ ነምች ያኢሮስ ጄዸሙ ቶኮ ዹፌ፤ እንስ ዮሙ ዬሱስን አርጌት፣ ሚለሳረት ኩፌ፣ <verse eid="MRK 5:22"/><verse number="23" style="v" sid="MRK 5:23"/>“እንተልኮ ጥኖን ዱኡ ጌሴርት። አከ እሼን ፈይቴ ጅራቱፍ፣ ማሎ ኮቱቲ ሀርከኬ እሼረ ከእ” ጄዼ ጀቤሴ እሰ ከዸቴ። <verse eid="MRK 5:23"/><verse number="24" style="v" sid="MRK 5:24"/>ከናፉ ዬሱስ እሰ ወጅን ዸቄ።</para>
  <para style="p" vid="MRK 5:24">ነሞትን ባይኤንስ እሰ ዱካ ቡአን፤ ገረሳትስ ወል ዺባ ቱረን። <verse eid="MRK 5:24"/><verse number="25" style="v" sid="MRK 5:25"/>ዱበርቲን ዺግንሼ ወጋ ኩዸ ለመ ዸንገለኣ ቱሬ ቶኮስ አች ቱርቴ። <verse eid="MRK 5:25"/><verse number="26" style="v" sid="MRK 5:26"/>እሼንስ ኦጌዪ ፈያ ባይኤ ብረት አከ መሌ ዽጰቴ፤ ዋን ቀብዱ ሁንዱመስ ኦፍ ሀርካ ፍጤ፤ ገሩ እቱመ ሀማቻ ዴሜ መሌ እት ህንወዮፍኔ። <verse eid="MRK 5:26"/><verse number="27" style="v" sid="MRK 5:27"/>እሼንስ ዮሙ ዋኤ ዬሱስ ዸጌሴት ዱግደሳ ዱባን ነሞተ ግዱዻን ዹፍቴ ኡፈተሳ ቱቅጤ። <verse eid="MRK 5:27"/><verse number="28" style="v" sid="MRK 5:28"/>እሼን፣ “አን ዮን ኡፈቱመሳሌ ቱቄ ነንፈየ” ጄቴ ያዴ ቱርቴቲ። <verse eid="MRK 5:28"/><verse number="29" style="v" sid="MRK 5:29"/>ዺግንሼስ ዮሙሱመ ጭቴ፤ እሼንስ አከ ዽጵነሼራ ፈይቴ ዸግነሼ ኬሰት ሁበቴ።<verse eid="MRK 5:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 5:30"/>ዬሱስስ ዮሙሱመ አከ ሁምን እሰ ኬሳ በኤ ሁበቴ። እንስ ነሞተ ኬሰ ገረ ገሌ፣ <char style="wj">“ኤኙቱ ኡፈተኮ ቱቄ?”</char> ጄዼ ጋፈቴ።<verse eid="MRK 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31"/>በረቶትንሳስ ዴብሰኒ፣ “አከ ነሞትን ስዺባ ጅረን ኡቱመ አርግቱ፣ <char style="wj">‘ኤኙቱ ነ ቱቄ?’</char> ጄቴ ጋፈታ?” ጄዸን።<verse eid="MRK 5:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32"/>ዬሱስ ገሩ ነምን ዋን ከነ ጎዼ ኤኙ አከ ተኤ አርጉፍ ጄዼ ገረገሌ እላሌ። <verse eid="MRK 5:32"/><verse number="33" style="v" sid="MRK 5:33"/>ዱበርትቲንስ ዋን እሼፍ ጎዸሜ ሁበቴ ሶዳዻን ሆለቻ ዹፍቴ ሚለሳረት ኩፍቴ፤ ዹጋ ሁንዱመስ እሰት ህምቴ። <verse eid="MRK 5:33"/><verse number="34" style="v" sid="MRK 5:34"/>እንስ፣ <char style="wj">“ያ እንተላ፣ አመንቲንኬ ስፈይሴረ። ነጋን ዴም፤ ዽጵነ ኬራስ ፈይ”</char> ጄዼን።<verse eid="MRK 5:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35"/>ኡቱ ዬሱስ ዱበቻ ጅሩስ ነሞትን ቶኮ ቶኮ መነ ያኢሮስ ቡልቻ መነ ሰገዳቲ ዹፈኒ፣ “እንተልኬ ዱቴርት፤ አት ስአች ማሊፍ በርሲስቸ ረክፍተ?” ጄዸን።<verse eid="MRK 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36"/>ዬሱስ ገሩ ዋን እሳን ጄዸን ጀላ ቀቡ ድዴ ቡልቻ መነ ሰገዳ ሰናን፣ <char style="wj">“አመን መሌ ህንሶዳትን!”</char> ጄዼ።<verse eid="MRK 5:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 5:37"/>እንስ ጴጥሮስ፣ ያቆቢፊ ዮሀንስ ኦቦሌሰ ያቆብ መሌ አከ ነምን ቶኮዩ እሰ ፋነ ዴሙ ህንኤየምኔ። <verse eid="MRK 5:37"/><verse number="38" style="v" sid="MRK 5:38"/>ዮሙ መነ ሆገና መነ ሰገዳ ሰና ብረ ገአንትስ ዬሱስ ኡመተ ወጩ፣ ነሞተ ቦአኒፊ ወዋተን አርጌ። <verse eid="MRK 5:38"/><verse number="39" style="v" sid="MRK 5:39"/>እንስ ኦል ሴኔ፣ <char style="wj">“ወጭኒፊ ቦእች ኩን ሁንድ ማል? እንተለቲን ንረፍት መሌ ህንዱኔ”</char> ጄዼን። <verse eid="MRK 5:39"/><verse number="40" style="v" sid="MRK 5:40"/>እሳን ገሩ እሰት ኮልፈን።</para>
  <para style="p" vid="MRK 5:40">እንስ ኤርገ ሁንደሳኒ ገድ ባሴ ቦዴ፣ አባፊ ሃዸ እንተለቲ፣ በረቶተ እሰ ወጅን ቱረንስ ፉዸቴ እዶ እንተለቲን ጅርቱ ሴኔ። <verse eid="MRK 5:40"/><verse number="41" style="v" sid="MRK 5:41"/>እንስ ሀርከሼ ቀቤ፣ <char style="tl"><char style="wj">“ጣሊታ ቁሚ!”</char></char> ጄዼን፤ ኩንስ፣ <char style="wj">“ያ ሙጨቲ ጥኖ፣ አን ሲን ነንጄዸ፣ ከእ!”</char> ጄቹዸ። <verse eid="MRK 5:41"/><verse number="42" style="v" sid="MRK 5:42"/>ሙጨቲንስ ዮሙሱመ ካቴ ዻበቴ፤ አሲፊ አችስ ዴሙ ጀልቀብዴ። ኡሙሪንሼ ወጋ ኩዸ ለመ ቱሬ። እሳንስ ዮሙሱመ አከ መሌ ድንቅፈተን። <verse eid="MRK 5:42"/><verse number="43" style="v" sid="MRK 5:43"/>እንስ አከ ነምን ቶኮዩ ዋን ከነ ህንቤክኔፍ አጀጀ ጭማ ኬኔ፤ አከ እሳን ዋን እሼን ኛቱ እሼፍ ኬነን እሳንት ህሜ።<verse eid="MRK 5:43"/></para>
  <chapter eid="MRK 5"/>
  <chapter number="6" style="c" sid="MRK 6"/>
  <para style="s1">ራጂ ከበጀ ዸቤ</para>
  <para style="r">
    <ref loc="MRK 6:1-6">6፥1‑6</ref> ኩወፈ – <char style="xt"><ref loc="MAT 13:54-58">ማቴ 13፥54‑58</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1"/>ዬሱስ አቺ በኤ ገረ መጋላ እት ዸለቴ ዸቄ፤ በረቶትንሳስ እሰ ወጅን ዸቀን። <verse eid="MRK 6:1"/><verse number="2" style="v" sid="MRK 6:2"/>እንስ ጉያን ሰንበታ ጌኛን መነ ሰገዳት በርሲሱ ጀልቀቤ፤ ወር እሰ ዸገአን ባይኤንስ ንድንቅሲፈተን።</para>
  <para style="p" vid="MRK 6:2">እሳንስ አከነ ጄዸኒ ጋፈተን፤ “ነምች ኩን ወንቶተ ከኔን ኤሳ አርገቴ? ኦጉማን እሳፍ ኬነሜ ኩን ማል? ሆጂወን ድንቅሲሶን ሀርከሳቲን ሆጄተመን ከኔን አከና ማል? <verse eid="MRK 6:2"/><verse number="3" style="v" sid="MRK 6:3"/>ነምች ኩን ሶፍቱ ሙካ ምቲ? እን እልመ ማርያም፣ ኦቦሌሰ ያቆብ፣ ከን ዮሳ፣ ከን ይሁዳፊ ከን ስሞን ምቲ? ኦቦሌቶትንሳ አስ ኑ ብረ ጅሩ ምቲ?” እሳንስ እሰት ጉፈተን።<verse eid="MRK 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4"/>ዬሱስሞ፣ <char style="wj">“ራጂን መጋላ እት ዸለቴፊ ፍሮተሳ ኬሰቲፊ መነሳት መሌ ከበጀ ህንዸቡ”</char> ጄዼን። <verse eid="MRK 6:4"/><verse number="5" style="v" sid="MRK 6:5"/>እንስ ዹኩብሰቶተ ሙራሰረ ሀርከሳ ካኤ ፈይሱ መሌ ሆጂ ድንቅሲሳ ቶኮሌ አችት ሆጄቹ ህንደንዴኜ። <verse eid="MRK 6:5"/><verse number="6" style="v" sid="MRK 6:6"/>እንስ አመንቲ ዸቡሳኒቲፍ ድንቅፈቴ።</para>
  <para style="s1" vid="MRK 6:6">ዬሱስ ጀረ ኩዸ ለማን ኤርጉሳ</para>
  <para style="r" vid="MRK 6:6">
    <ref loc="MRK 6:7-11">6፥7‑11</ref> ኩወፈ – <char style="xt"><ref loc="MAT 10:1">ማቴ 10፥1</ref>፣<ref loc="MAT 10:9-14">9‑14</ref>፤ <ref loc="LUK 9:1">ሉቃ 9፥1</ref>፣<ref loc="LUK 9:3-5">3‑5</ref></char></para>
  <para style="p" vid="MRK 6:6">ዬሱስስ ነሞተ በርሲሳ ገንደ ቶኮራ ገረ ገንደ ብራ ናነኣ ቱሬ። <verse eid="MRK 6:6"/><verse number="7" style="v" sid="MRK 6:7"/>ወረ ኩዸ ለማን ኦፍት ዋሜ ለመ ለማን እሳን ኤርጉ ጀልቀቤ፤ ሀፉሮተ ጡራኦረትስ ታይታ ኬኔፍ።<verse eid="MRK 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 6:8"/>አከነ ጄዼስ እሳን አጀጄ፦ <char style="wj">“አዴምሰኬሰኒፍ ኡሌ መሌ ዋን ቶኮሌ ጄቹንስ ቡዴናፊ ኮሮጆ ህንቀበትና፤ ሰበተኬሰንትሞ ማለቀ ህንጉዱንፈትና።</char> <verse eid="MRK 6:8"/><verse number="9" style="v" sid="MRK 6:9"/><char style="wj">ኮጴ ካአዻ፤ ገሩ ክታ ለመ ህንኡፈትና።</char> <verse eid="MRK 6:9"/><verse number="10" style="v" sid="MRK 6:10"/><char style="wj">ዬሮ መነ ቶኮ ሴንተን ከምዩ፣ ሀመ መጋላ ሰና ባተንት መኑመ ሰነ ቱራ።</char> <verse eid="MRK 6:10"/><verse number="11" style="v" sid="MRK 6:11"/><char style="wj">ዮ እዶን ከምዩ እስን ስመቹ ባቴ ዮካን እስን ዸገኡ ባቴ፣ እዶ ሰና በኣቲ አከ ረጋ እሳንት ተኡፍ አዋረ ሚለኬሰኒ ዸዸአዻ።”</char><verse eid="MRK 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12"/>እሳንስ አቺ በአኒ አከ ነሞትን ቀልቢ ጅጂረተኒፍ ለለበን። <verse eid="MRK 6:12"/><verse number="13" style="v" sid="MRK 6:13"/>ሀፉሮተ ሀሞ ባይኤ ባሰን፤ ዹኩብሰቶተ ባይኤስ ዘይቲ ድበኒ ፈይሰን።<verse eid="MRK 6:13"/></para>
  <para style="s1">አጄፈሙ ዮሀንስ ጩጳ</para>
  <para style="r">
    <ref loc="MRK 6:14-29">6፥14‑29</ref> ኩወፈ – <char style="xt"><ref loc="MAT 14:1-12">ማቴ 14፥1‑12</ref></char></para>
  <para style="r">
    <ref loc="MRK 6:14-16">6፥14‑16</ref> ኩወፈ – <char style="xt"><ref loc="LUK 9:7-9">ሉቃ 9፥7‑9</ref></char></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14"/>ሄሮድስ ሞትች ዋኤ ዋን ከና ዸገኤ፤ መቃን ዬሱስ ስሪት ቤከሜ ቱሬቲ። ነሞትን ቶኮ ቶኮ፣ “ዮሀንስ ጩጳን ወረ ዱአን ኬሳ ካፈሜረ፤ ሰበቢን ሆጂን ድንቂ እሳን ሆጄተሙፍስ ከኑመ” ጄዸን።<verse eid="MRK 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15"/>ወር ካን፣ “እን ኤልያስ” ጄዸን።</para>
  <para style="p" vid="MRK 6:15">ካንሞ፣ “እን ራጆተ ዱሪ ኬሳ አከ እሰ ቶኮት” ጄዸን።<verse eid="MRK 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16"/>ሄሮድስ ገሩ ዮሙ ዋን ከነ ዸገኤት፣ “ዮሀንስ እሰ አን መታሳራ ኩቴቱ ወረ ዱአን ኬሳ ካፈሜ!” ጄዼ።<verse eid="MRK 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 6:17"/>ሄሮድስ መታንሳ አከ ዮሀንስ ቀበሜ፣ ህዸሜ መነ ህዻት ገልፈሙ አጀጄ ቱሬቲ። እንስ ሰበቢ ኒቲ ኦቦሌሰ ኦፊሳ ፊልጶስ፣ ሰበቢ ሄሮድያዳ እሼ ኦፊ ፉዼ ቱሬ ሰናቲፍ ጄዼ ዋን ከነ ጎዼ። <verse eid="MRK 6:17"/><verse number="18" style="v" sid="MRK 6:18"/>ዮሀንስስ ሄሮድሲን፣ “አት ኒቲ ኦቦሌሰኬቲ ፉዹንኬ ሴረ ምት” ጄዻኒ ቱሬቲ። <verse eid="MRK 6:18"/><verse number="19" style="v" sid="MRK 6:19"/>ከናፉ ሄሮድያዳን ዮሀንስት ሃሎ ቀበቴ እሰ አጄሱ በርባዴ። ገሩ እሼን ህንደንዴኜ፤ <verse eid="MRK 6:19"/><verse number="20" style="v" sid="MRK 6:20"/>ሄሮድስ አከ ዮሀንስ ነመ ቀጄላፊ ነመ ቁልቁሉ ተኤ ቤኬ፣ እሰ ሶዳቴ፣ ኤጉምሰ እሳፍ ጎቻ ቱሬቲ። ሄሮድስ ዮሙ ዋን ዮሀንስ ዱበቱ ዸገኤት አከ መሌ ርፈቴ፤ ተኡስ ገመቹዻን እሰ ዸጌፈቹ በርባዴ።<verse eid="MRK 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21"/>ዹመረትስ ዬሮን ምጃኣን አርገሜ። ሄሮድስ ጉያ ዸሎተሳት ቆንዳልቶተ ጉርጉዶታፍ፣ አጀጆተ ሎልቶታቲፊ ነሞተ ገሊላ ኬሰት ቤከመኒፍ እርባተ ቆጴሴ። <verse eid="MRK 6:21"/><verse number="22" style="v" sid="MRK 6:22"/>እንተል ሄሮድያዳስ ዮሙ ኦል ሴንቴ ስርብቴት ሄሮድሲፊ ኬሱሞተሳ ወረ እርባተ አፌረመን ገመቺፍቴ።</para>
  <para style="p" vid="MRK 6:22">ሞትችስ እንተለቲዻን፣ “ዋኑመ በርባዴ ነ ከዸዹ፤ አን ሲፍ ነንኬነ!” ጄዼ። <verse eid="MRK 6:22"/><verse number="23" style="v" sid="MRK 6:23"/>እንስ፣ “ሀመ ወለካ ሞቱማኮትሌ ዋን አት ነ ከዸቱ ከምዩ ሲፍ ነንኬነ!” ጄዼ ከኩዻን ዋዳ ገሌፍ።<verse eid="MRK 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24"/>እሼንስ ገድ ባቴ ሃዸሼቲን፣ “ማል ከዸዹ?” ጄቴ።</para>
  <para style="p" vid="MRK 6:24">ሃትሞ፣ “መታ ዮሀንስ ጩጳ” ጄቴ ዴብፍቴፍ።<verse eid="MRK 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25"/>እንተለቲንስ ዮሙሱመ አሪቲዻን ገረ ሞትቻት ኦል ሴንቴ፣ “አከ አት አሙመ መታ ዮሀንስ ጩጳ ገበቴረ ኬሴ ናፍ ኬንቱ ነንበርባደ” ጄቴን።<verse eid="MRK 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26"/>ሞትችስ አከ መሌ ገዴ፤ ገሩ ሰበቢ ከኩሳቲፊ ሰበቢ ወረ እሰ ወጅን ማዲት ዽኣተኒቲፍ ጄዼ እሼ ድዱ ህንበርባድኔ። <verse eid="MRK 6:26"/><verse number="27" style="v" sid="MRK 6:27"/>እንስ ዮሙሱመ ሎልቱ ቶኮ አከ እን መታ ዮሀንስ ፍዱፍ አጀጄ ኤርጌ። ሎልቱን ሱንስ ዸቄ መነ ህዻ ኬሰት መታ ዮሀንስ እሰራ ኩቴ፤ <verse eid="MRK 6:27"/><verse number="28" style="v" sid="MRK 6:28"/>መታሳስ ገበቴረ ካኤ ፍዴ እንተለቲት ኬኔ። እሼንስ ሃዸሼት ኬንቴ። <verse eid="MRK 6:28"/><verse number="29" style="v" sid="MRK 6:29"/>በረቶትን ዮሀንስስ ዋን ከነ ዸጌኛን ዹፈኒ ሬፈሳ ፉዸኒ አዋለ ኬሰ ካአን።<verse eid="MRK 6:29"/></para>
  <para style="s1">ዬሱስ ነሞተ ኩመ ሸን ሶሩሳ</para>
  <para style="r">
    <ref loc="MRK 6:32-44">6፥32‑44</ref> ኩወፈ – <char style="xt"><ref loc="MAT 14:13-21">ማቴ 14፥13‑21</ref>፤ <ref loc="LUK 9:10-17">ሉቃ 9፥10‑17</ref>፤ <ref loc="JHN 6:5-13">ዮሀ 6፥5‑13</ref></char></para>
  <para style="r">
    <ref loc="MRK 6:32-44">6፥32‑44</ref> ኩወእ – <char style="xt"><ref loc="MRK 8:2-9">ማር 8፥2‑9</ref></char></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30"/>ኤርገሞትንስ ዬሱስ ብረት ወልት ቀበመኒ ዋን ሆጄተኒ ቱረኒፊ ዋን በርሲሰኒ ቱረን ሁንደ እሰት ህመን። <verse eid="MRK 6:30"/><verse number="31" style="v" sid="MRK 6:31"/>እንስ፣ <char style="wj">“ኮጳኬሰን ገረ እዶ ነምን ህንጅሬ ቶኮ ኮታቲ ተከ ቦቆዻ”</char> ጄዼን፤ እሳን ሰበቢ ነሞትን ባይኤን ዹፋ፣ ዴማስ ቱረኒፍ ጨራ እት ዋ ኛተንሌ ህንቀበን ቱሬቲ።<verse eid="MRK 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 6:32"/>እሳንስ ኮጳሳኒ ብድሩዻን እዶ ነምን ህንጅሬ ቶኮ ዸቀን። <verse eid="MRK 6:32"/><verse number="33" style="v" sid="MRK 6:33"/>ነሞትን ዴሙሳኒ አርገን ባይኤን ገሩ እሳን ቤከን፤ መጋላወን ሁንደ ኬሳ በአኒ ሚላን ፊገኒ እሳን ዱርሰኒ እዶ ሰነ ገአን። <verse eid="MRK 6:33"/><verse number="34" style="v" sid="MRK 6:34"/>ዬሱስ ዮሙ ብድሩራ ቡኤት ቱተ ጉዳ ቶኮ አርጌ፤ እንስ ሰበቢ እሳን አኩመ ሆሎተ ትክሴ ህንቀብኔ ቱረኒፍ ገራ ላፌፍ። ከናፉ እን ዋን ባይኤ እሳን በርሲሱ ጀልቀቤ።<verse eid="MRK 6:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35"/>ዬሮ ከነት ገልገላኤ ቱሬ፤ ከናፉ በረቶትንሳ ገረሳ ዹፈኒ አከነ ጄዸኒን፤ “እዶን ኩን ገሞጂዸ፤ አዱንስ ዺቴርት። <verse eid="MRK 6:35"/><verse number="36" style="v" sid="MRK 6:36"/>አከ እሳን ገረ ባድያቲፊ ገንዶተ ናኖ ከነ ጅረኒ ዸቀኒ ዋን ኛተን ብተተኒፍ ነሞተ ከኔን ገድ ዺስ።”<verse eid="MRK 6:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37"/>እን ገሩ፣ <char style="wj">“እስኑ ዋን እሳን ኛተን ኬናፊ”</char> ጄዼ ዴብሴ።</para>
  <para style="p" vid="MRK 6:37">እሳንስ፣ “ዸቅኔ ቡዴነ ዲናሪ ዽበ ለማ ብትኔ አከ ኛተኒፍ እሳኒፍ ኬንኑሬ?” ጄዸኒን።<verse eid="MRK 6:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38"/>እንስ፣ <char style="wj">“ቡዴነ ሜቀ ቀብዱ? ሜ ዸቃ እላላ!”</char> ጄዼን።</para>
  <para style="p" vid="MRK 6:38">እሳንስ ዮሙ አርገንት፣ “ቡዴነ ሸኒፊ ቁርጡሚ ለመ” ጄዸን።<verse eid="MRK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39"/>ዬሱስስ አከ እሳን ነሞተ ሁንዱማ ገሬ ገሬዻን መርገ ለልሳረ ቴቴስሰን እሳን አጀጄ። <verse eid="MRK 6:39"/><verse number="40" style="v" sid="MRK 6:40"/>ከናፉ ነሞትን ዽበ ዽባፊ ሸንተመ ሸንተማን ገሬ ገሬዻን ተታአን። <verse eid="MRK 6:40"/><verse number="41" style="v" sid="MRK 6:41"/>እንስ ቡዴነ ሸነኒፊ ቁርጡሚ ለማን ሰነ ፉዼ፣ ገረ ሰሚ ኦል እላሌ ገለተ ገልቼ ቡዴነ ሰነ ጨጨብሴ። አከ እሳን ነሞታፍ ዽኤሰኒፍስ በረቶተሳት ኬኔ። ቁርጡሚ ለማንስ ሁንዱመሳኒቲፍ ቆቆዴ። <verse eid="MRK 6:41"/><verse number="42" style="v" sid="MRK 6:42"/>እሳን ሁንድ ኛተኒ ቁፈን፤ <verse eid="MRK 6:42"/><verse number="43" style="v" sid="MRK 6:43"/>በረቶትንስ ሁራኣ ቡዴናቲፊ ቁርጡሚ ጉንዶ ኩዸ ለመ ጉቱ ወልት ቀበን። <verse eid="MRK 6:43"/><verse number="44" style="v" sid="MRK 6:44"/>ወር ኛተንስ ዺረ ኩመ ሸን ቱረን።<verse eid="MRK 6:44"/></para>
  <para style="s1">ዬሱስ ገላነረ ዴሙሳ</para>
  <para style="r">
    <ref loc="MRK 6:45-51">6፥45‑51</ref> ኩወፈ – <char style="xt"><ref loc="MAT 14:22-32">ማቴ 14፥22‑32</ref>፤ <ref loc="JHN 6:15-21">ዮሀ 6፥15‑21</ref></char></para>
  <para style="r">
    <ref loc="MRK 6:53-56">6፥53‑56</ref> ኩወፈ – <char style="xt"><ref loc="MAT 14:34-36">ማቴ 14፥34‑36</ref></char></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45"/>ዬሱስ ዮሙሱመ አከ በረቶትንሳ ብድሩ ያበተኒ ሀመ እን ቱተ ሰነ ኦፍራ ጌጌሱት እሰ ዱረ ገረ ቤተ ሳይዳት ደርበኒፍ እሳን ድርቅሲሴ። <verse eid="MRK 6:45"/><verse number="46" style="v" sid="MRK 6:46"/>እንስ ኤርገ ነሞተ ኦፍራ ጌጌሴ ቦዴ ከዸቹፍ ጋረት ኦል በኤ።<verse eid="MRK 6:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 6:47"/>ዮሙ ገልገላኤትስ ብድሩን ሱን ገላነ ወለካ ቱሬ፤ ዬሱስሞ ኮጳሳ ለፈረ ቱሬ። <verse eid="MRK 6:47"/><verse number="48" style="v" sid="MRK 6:48"/>እንስ ኡቱ በረቶትን ሰበቢ ቡቤን ፉለሳኒ ዱራን እት ዹፌፍ ብሻን ሞቁዻን ዽጰተኑ አርጌ። እንስ ሀልከን ኬሳ ኩታ አፉረፋት ገላነረ ዴማ ገረሳኒ ዹፌ። እንስ ዋን እሳን ብረ ደርቡ ፈካቴ፤ <verse eid="MRK 6:48"/><verse number="49" style="v" sid="MRK 6:49"/>እሳን ገሩ ዮሙ ገላነረ ዴሙሳ አርገንት ኤኬራ ሴአኒ እየን፤ <verse eid="MRK 6:49"/><verse number="50" style="v" sid="MRK 6:50"/>እሳን ሁንድ እሰ አርገኒ አከ መሌ ነአኒቲ።</para>
  <para style="p" vid="MRK 6:50">እንሞ፣ <char style="wj">“ጀባዻ! አኑማቲ ህንሶዳትና”</char> ጄዼ ዮሙሱመ እሳንት ዱበቴ። <verse eid="MRK 6:50"/><verse number="51" style="v" sid="MRK 6:51"/>እንስ እሳን ወጅን ብድሩ ያበቴ፤ ቡቤን ሱንስ ገብ ጄዼ። እሳንስ አከ መሌ ድንቅሲፈተን፤ <verse eid="MRK 6:51"/><verse number="52" style="v" sid="MRK 6:52"/>እሳን ዋኤ ቡዴነን ሰና ህንሁበትኔቲ፤ መተ ጀቤዪስ ቱረን።<verse eid="MRK 6:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53"/>እሳንስ ዮሙ ገመ ጬአንት ጌንሴሬጥት ብድሩራ ቡአን፤ ብድሩ ሰነስ አችት ህዸን። <verse eid="MRK 6:53"/><verse number="54" style="v" sid="MRK 6:54"/>አኩመ እሳን ብድሩራ ቡአኒንስ ነሞትን ዬሱስን ቤከን። <verse eid="MRK 6:54"/><verse number="55" style="v" sid="MRK 6:55"/>ነሞትን ሱንስ ብየ ሰነ ጉቱ ኬሰ አሲፊ አች ፊገኒ እዶ ዬሱስ አች ጅረ ጄቹ ዸገአን ሁንዱመት ዹኩብሰቶተ ስሬዻን ባተኒ ፍዱ ጀልቀበን። <verse eid="MRK 6:55"/><verse number="56" style="v" sid="MRK 6:56"/>እዶ እን ዸቄ ከምሌ ጄቹንስ ገንዶተ፣ መጋላወን ዮካን ባድያ ሁንደት ወረ ዹኩብሰተን ፍደኒ ለፈ ገባ ካአን። እሳንስ አከ ዹኩብሰቶትን ሱን ሀንዳረ ወያሳሌ ቱቀኒፍ እሰ ከዸተን፤ ወር ሀንዳሩመ ወያሳ ቱቀን ሁንድኑስ ንፈየን።<verse eid="MRK 6:56"/></para>
  <chapter eid="MRK 6"/>
  <chapter number="7" style="c" sid="MRK 7"/>
  <para style="s1">ዋን ቁልቁሉፊ ዋን ጡራኣ</para>
  <para style="r">
    <ref loc="MRK 7:1-23">7፥1‑23</ref> ኩወፈ – <char style="xt"><ref loc="MAT 15:1-20">ማቴ 15፥1‑20</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1"/>ፈሪሶታፊ በርሲስቶተ ሴራ ኬሳ ወር ዬሩሳሌሚ ዹፈን ቶኮ ቶኮ ዬሱስ ብረት ወልት ቀበመኒ <verse eid="MRK 7:1"/><verse number="2" style="v" sid="MRK 7:2"/>በረቶተሳ ኬሳ ቶኮ ቶኮ ሀርከ፣ “ህንቁልቁሌፈምኒን” ጄቹንስ ኡቱ ሀርከ ህንዽቀትን ቡዴነ ኛቹሳኒ አርገን። <verse eid="MRK 7:2"/><verse number="3" style="v" sid="MRK 7:3"/>ሰበቢንሳስ ፈሪሶትን፣ ይሁዶትን ሁንድኑስ ዱዻ ማንጉዶታ ኤጉፍ ጄዸኒ ኡቱ ሀርከ ህንዽቀትን ህንኛተኒቲ። <verse eid="MRK 7:3"/><verse number="4" style="v" sid="MRK 7:4"/>ዮሙ ገባዻ ገለንትስ ኡቱ ኦፍ ህንቁልቁሌስን ህንኛተን። ዱዻ ብራ ባይኤስ ከን አከ ጦፎ ዽቁ፣ ኦኮቴፊ ሁሮ ዽቁ ንኤጉ።<verse eid="MRK 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5"/>ከናፉ ፈሪሶትኒፊ በርሲስቶትን ሴራ፣ “በረቶትንኬ ቆደ ሀርከ ‘ህንቁልቁሌፈምኒን’ ኛተን ማሊፍ አኩመ ዱዻ ማንጉዶታት ህንጅራትኔ?” ጄዸኒ ዬሱስን ጋፈተን።<verse eid="MRK 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6"/>እንስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“ያ ፈኬስቶተ፣ እሳያስ ዮሙ ዋኤኬሰን ራጂ ዱበቴት ስሪ ቱሬ፤ ኩንስ አኩመ አከነ ጄዸሜ በሬፈሜዸ፦</char></para>
  <para style="q1" vid="MRK 7:6">
    <char style="wj">“ ‘ኡመትን ኩን ህዺሳቲን ነ ከበጀ፤</char></para>
  <para style="q2" vid="MRK 7:6">
    <char style="wj">ገራንሳ ገሩ ነራ ፈጎ ጅረ።</char><verse eid="MRK 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7"/>
    <char style="wj">እሳን አከኑማን ነ ዋቄፈቱ፤</char></para>
  <para style="q2" vid="MRK 7:7">
    <char style="wj">በርሲስንሳኒስ ስርኑመ ነማት።’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">7፥7 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="ISA 29:13">እሳ 29፥13</ref>
        </char>
      </char>
    </note><verse eid="MRK 7:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="MRK 7:8"/>
    <char style="wj">እስን አጀጀ ዋቃ ዺፍተኒ፣ ዱዻ ነሞታ ጀቤስተኒ ኤግዱ።”</char><verse eid="MRK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9"/>እንስ እቱመ ፉፌ አከነ ጄዼን፤ <char style="wj">“እስን ዱዻ ኦፊኬሰኒ ኤጉፍ ጄተኒ አጀጀ ዋቃ ቱፈቹፍ መለ ጋሪ ቀብዱ!</char> <verse eid="MRK 7:9"/><verse number="10" style="v" sid="MRK 7:10"/><char style="wj">ሙሴን፣ ‘አባኬቲፊ ሃዸኬቲፍ ኡልፍነ ኬን፤</char><note caller="+" style="f"><char style="fr" closed="false">7፥10 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:12">በኡ 20፥12</ref>፤ <ref loc="DEU 5:16">ኬዴ 5፥16</ref></char></char></note> <char style="wj">ነምን አባሳ ዮካን ሃዸሳ አረብሱ ከምዩ ሃአጄፈሙ’</char><note caller="+" style="f"><char style="fr" closed="false">7፥10 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 21:17">በኡ 21፥17</ref>፤ <ref loc="LEV 20:9">ሌዎ 20፥9</ref></char></char></note> <char style="wj">ጄዼራቲ።</char> <verse eid="MRK 7:10"/><verse number="11" style="v" sid="MRK 7:11"/><char style="wj">እስን ገሩ ዮ ነምን ከምዩ አከ ወን ስላ አባሳ ዮካን ሃዸሳ ገርጋሩፍ ኦሉ ቁርባነ ጄቹንስ ዋቃፍ ኬነሜረ ጄዼ ዱበቴ፣</char> <verse eid="MRK 7:11"/><verse number="12" style="v" sid="MRK 7:12"/><char style="wj">እስን አከ እን አባሳቲፍ ዮካን ሃዸሳቲፍ ዋን ቶኮሌ ጎዹ ስአች ህንኤየምተኒፍ።</char> <verse eid="MRK 7:12"/><verse number="13" style="v" sid="MRK 7:13"/><char style="wj">አከናንስ ዱዻኬሰን እሰ ወልት ደበርስተን ሰናን ዱቢ ዋቃ ቡሼስቱ። ዋን አከና ባይኤስ ንሆጄቱ።”</char><verse eid="MRK 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14"/>ዬሱስ አመስ ነሞተ ሰነ ኦፍት ዋሜ አከነ ጄዼን፤ <char style="wj">“እስን ሁንድ ነ ዸገኣ፤ ከነስ ሁበዻ።</char> <verse eid="MRK 7:14"/><verse number="15" style="v" sid="MRK 7:15"/><char style="wj">ዋን ነመ ኬሳ በኡቱ ነመ ‘ጡሬሰ’ መሌ ወን አላ ነመት ሴኔ ነመ ‘ጡሬሱ’ ደንደኡ ቶኮሌ ህንጅሩ።</char> [ <verse eid="MRK 7:15"/><verse number="16" style="v" sid="MRK 7:16"/><char style="wj">ነምን ከምዩ ዮ ጉረ ዸገኡ ቀባቴ ሃዸገኡ።”</char>]<note caller="+" style="f"><char style="fr" closed="false">7፥16 </char><char style="ft" closed="false">ወራብሌን ዱሪ ቶኮ ቶኮ ሉቅሳ ከነ ህንቀበን።</char></note><verse eid="MRK 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17"/>ኤርገ እን ነሞተ ብራ መነ ኦል ሴኔ ቦዴ በረቶትንሳ ዋኤ ፈኬኘ ሰና እሰ ጋፈተን። <verse eid="MRK 7:17"/><verse number="18" style="v" sid="MRK 7:18"/>እንስ አከነ ጄዼ ጋፈቴ፤ <char style="wj">“እስን ህንሁበተኒ? አከ ወን አላ ነመት ሴኑ ቶኮዩ ነመ ‘ጡሬሱ’ ህንደንዴኜ ህንቀልቤፈተኒ?</char> <verse eid="MRK 7:18"/><verse number="19" style="v" sid="MRK 7:19"/><char style="wj">ወን ሱን ገራሳ ሴኔ ኤርገሲ ዸግነሳ ኬሳ ገድ በአ መሌ ያደ ገራ</char><note caller="+" style="f"><char style="fr" closed="false">7፥19 </char><char style="fq" closed="false">ያደ ገራ </char><char style="ft" closed="false">– አከ ሁበትና ይሁዶታት ያድን ገራ ኤኙማ ነመ ቶኮ ጉቱማት አርግሲሰ።</char></note> <char style="wj">እሳ ህንሴኑቲ።”</char> ዬሱስስ ከነ ጄቹዻን አከ ኛትን ሁንድኑ ቁልቁሉ ተኤ ለብሴ።<verse eid="MRK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20"/>እንስ እት ፉፌ አከነ ጄዼ፦ <char style="wj">“ወን ነመ ‘ጡሬሱ’ ዋን ነመ ኬሳ በኡዸ።</char> <verse eid="MRK 7:20"/><verse number="21" style="v" sid="MRK 7:21"/><char style="wj">ያድን ሀማን ኬሰ ነማቲ፣ ገራ ነማ ኬሳ በኣቲ፤ እንስ ሀለሉማ፣ ሀትነ፣ ነመ አጄሱ፣ ኤጀ፣</char> <verse eid="MRK 7:21"/><verse number="22" style="v" sid="MRK 7:22"/><char style="wj">ዶቅኑማ፣ ሀምነ፣ ጎዎምሳ፣ ጅሬኘ ገድ ዺሲ፣ ህናፋ፣ መቃ ነማ በሌሱ፣ ኦፍ ቱሉማፊ ጎዉማ።</char> <verse eid="MRK 7:22"/><verse number="23" style="v" sid="MRK 7:23"/><char style="wj">ወንቶትን ሀሞን ኩኔን ሁንድኑ ነመ ኬሳ በኡ፤ ነመስ ‘ንጡሬሱ’።”</char><verse eid="MRK 7:23"/></para>
  <para style="s1">አመንቲ ዱበርቲ ቶኮ</para>
  <para style="r">
    <ref loc="MRK 7:24-30">7፥24‑30</ref> ኩወፈ – <char style="xt"><ref loc="MAT 15:21-28">ማቴ 15፥21‑28</ref></char></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24"/>ዬሱስ እዶ ሰና ከኤ ገረ ኣና ጢሮስት ቀጄሌ። መነ ቶኮስ ኦል ሴኔ፤ እንስ አከ ነምን ቶኮዩ አች ጅራቹሳ ቤኩ ህንበርባድኔ፤ ገሩ ዾከቹ ህንደንዴኜ። <verse eid="MRK 7:24"/><verse number="25" style="v" sid="MRK 7:25"/>ዱበርቲን እንተልሼ ሀፉረ ጡራኣን ቀበምቴ ቶኮ አኩመ ዋኤሳ ዸጌሴን ዹፍቴ ሚለሳረት ኩፍቴ። <verse eid="MRK 7:25"/><verse number="26" style="v" sid="MRK 7:26"/>ዱበርትቲንስ ነመ ግሪክ፣ ከን ብየ ሶርያ ኬሰት ፍኒቄት ዸለቴዸ። እሼን አከ እን እንተለሼ ኬሳ ሀፉረ ሀማ ሰነ ባሱፍ ዬሱስን ከዸቴ።<verse eid="MRK 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 7:27"/>እንስ፣ <char style="wj">“ዱረ እጆሌን ሃቁፍቱ፤ ቡዴነ እጆሌ ፉዸኒ ሰሮተ ዱረ ቡሱን ስሪ ምት”</char> ጄዼን።<verse eid="MRK 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28"/>እሼን ገሩ፣ “ኤዬ ያ ጎፍታ፣ ሰሮትንዩ ማዲ ጀላ ሀምባ እጆሌን ሀርጫፍቱ ኛቱ” ጄቴ ዴብፍቴፍ።<verse eid="MRK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29"/>ዬሱስስ፣ <char style="wj">“ጄቸኬ ከናፍ ገል፤ ሀፉር ሀማን ሱን እንተለኬ ኬሳ በኤረ”</char> ጄዼን።<verse eid="MRK 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30"/>እሼንስ ዮሙ መነት ገልቴት እንተልሼ ስሬረ ጪፍቴ፣ ሀፉር ሀማን ሱንስ ኬሳ በኤ አርገቴ።<verse eid="MRK 7:30"/></para>
  <para style="s1">ነምች ዱዳፊ አረብ-ድዳን ቶኮ ፈዩሳ</para>
  <para style="r">
    <ref loc="MRK 7:31-37">7፥31‑37</ref> ኩወፈ – <char style="xt"><ref loc="MAT 15:29-31">ማቴ 15፥29‑31</ref></char></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31"/>ኤርገሲስ ዬሱስ ብየ ጢሮሲቲ ከኤ ሲዶና ኬሰ ደርቤ፣ ኩታ መጋላ ኩርነኒ ኬሰ በኤ ገረ ገላነ ገሊላ ዹፌ። <verse eid="MRK 7:31"/><verse number="32" style="v" sid="MRK 7:32"/>ጀር ቶኮስ ነምቸ ጉረ ዱዳፊ አረብ-ድዳ ቶኮ እሰት ፍደኒ አከ እን ሀርከ እሰረ ካኡፍ ከዸተን።<verse eid="MRK 7:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 7:33"/>ዬሱስስ ነምቸ ሰነ ቱተ ኬሳ ኮጳት ባሴ ቁበሳ ጉረ ነምቻ ኬሰ ካኤ። ሀንጩፈ ቱፌስ አረበ ነምቻ ቱቄ። <verse eid="MRK 7:33"/><verse number="34" style="v" sid="MRK 7:34"/>ገረ ሰሚስ ኦል እላሌ፣ ሀፉረ ጉዳ ባፈቴ፣ <char style="tl"><char style="wj">“ኤፍታህ!”</char></char> ጄዼን፤ ከነ ጄቹንስ <char style="wj">“በነም!”</char> ጄቹዸ። <verse eid="MRK 7:34"/><verse number="35" style="v" sid="MRK 7:35"/>ጉር ነምቻስ ዮሙሱመ በነሜ፤ አረብንሳስ ሂከሜ ረክነ ቶኮ መሌ ዱበቹ ጀልቀቤ።<verse eid="MRK 7:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 7:36"/>ዬሱስስ አከ እሳን ነመ ቶኮትሌ ህንህምኔፍ ነሞተ ሰነ አጀጄ። ሀሙመ እን ጭምሴ እሳን አጀጄ ሰነ፣ እሳንስ እቱመ ጫልችሰኒ ኦዴሰን። <verse eid="MRK 7:36"/><verse number="37" style="v" sid="MRK 7:37"/>ወር ኦዱ ሰነ ዸገአንስ አከ መሌ ድንቅፈተኒ፣ “እን ዋን ሁንደ ጋሪ ጎዼረ፤ ወር ዱዳንስ አከ ዸገአን፣ ወር አረብንሳኒ ዱበቹ ድዴስ አከ ዱበተን ንጎዸ” ጄዸን።<verse eid="MRK 7:37"/></para>
  <chapter eid="MRK 7"/>
  <chapter number="8" style="c" sid="MRK 8"/>
  <para style="s1">ዬሱስ ነመ ኩመ አፉር ሶሩሳ</para>
  <para style="r">
    <ref loc="MRK 8:1-9">8፥1‑9</ref> ኩወፈ – <char style="xt"><ref loc="MAT 15:32-39">ማቴ 15፥32‑39</ref></char></para>
  <para style="r">
    <ref loc="MRK 8:1-9">8፥1‑9</ref> ኩወእ – <char style="xt"><ref loc="MRK 6:32-44">ማር 6፥32‑44</ref></char></para>
  <para style="r">
    <ref loc="MRK 8:11-21">8፥11‑21</ref> ኩወፈ – <char style="xt"><ref loc="MAT 16:1-12">ማቴ 16፥1‑12</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1"/>ግዱ ሰነ ቱትን ብራ ጉዳንሳ አመስ ወልት ቀበሜ። ዬሱስስ ሰበቢ ቱትን ሱን ዋን ኛቱ ህንቀባትኒፍ በረቶተሳ ኦፍት ዋሜ አከነ ጄዼ፤ <verse eid="MRK 8:1"/><verse number="2" style="v" sid="MRK 8:2"/><char style="wj">“ሰበቢ እሳን ጉያ ሰዲ ነ ብረ ቱረኒ ዋን ኛተን ቶኮሌ ህንቀብኔፍ፣ አን ነሞተ ከኔኒፍ ገራ ነንላፈ።</char> <verse eid="MRK 8:2"/><verse number="3" style="v" sid="MRK 8:3"/><char style="wj">ዮ አን አገቡሳኒ ገድ እሳን ዺሴ፣ እሳን ከራረት ንገገቡ፤ እሳን ኬሳ ቶኮ ቶኮ ፈጎዻ ዹፈኒቲ።”</char><verse eid="MRK 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4"/>በረቶትንሳስ ዴብሰኒ፣ “ነምን ከምዩ ገሞጂ ከነ ኬሰት ቡዴነ እሳን ገኡ ኤሳ አርገቹ ደንደአ?” ጄዸን።<verse eid="MRK 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5"/>ዬሱስሞ፣ <char style="wj">“እስን ቡዴነ ሜቀ ቀብዱ?”</char> ጄዼ ጋፈቴ።</para>
  <para style="p" vid="MRK 8:5">እሳንስ፣ “ቶርበ” ጄዸን።<verse eid="MRK 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6"/>እንስ አከ ነሞትን ሱን ለፈ ተታአን እት ህሜ። ቡዴነ ቶርበን ፉዼ ኤርገ ገለቴፈቴ ቦዴ ጨጨብሴ አከ እሳን ነሞታፍ ዽኤሰኒፍ በረቶተሳት ኬኔ፤ እሳንስ ነሞታፍ ዽኤሰን። <verse eid="MRK 8:6"/><verse number="7" style="v" sid="MRK 8:7"/>አከሱመስ ቁርጡሚ ጥጥኖ ሙራሰ ቀቡ ቱረን፤ ቁርጡሚ ሰነስ ኤብሴ አከ እሳን ነሞታፍ ህረኒፍ በረቶተሳት ህሜ። <verse eid="MRK 8:7"/><verse number="8" style="v" sid="MRK 8:8"/>ነሞትንስ ኛተኒ ቁፈን። ኤርገሲስ በረቶትን ሀምባ ጉንዶ ቶርበ ጉቱ ወልት ቀበን። <verse eid="MRK 8:8"/><verse number="9" style="v" sid="MRK 8:9"/>እሳንስ ገረ ነመ ኩመ አፉሪ ቱረን። እንስ ኤርገ ኦፍራ እሳን ጌጌሴ ቦዴ፣ <verse eid="MRK 8:9"/><verse number="10" style="v" sid="MRK 8:10"/>በረቶተሳ ወጅን ዮሙሱመ ብድሩ ያበቴ ብየ ዳልማኑታ ዸቄ።<verse eid="MRK 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11"/>ፈሪሶትንስ ዹፈኒ ዬሱስት ፈልሙ ጀልቀበን፤ እሰ ቆሩፍ ጄዸኒስ መለቶ ሰሚራ እሰራ በርባደን። <verse eid="MRK 8:11"/><verse number="12" style="v" sid="MRK 8:12"/>እንስ ሀፉረ ዼራ ባፈቴ፣ <char style="wj">“ዸሎትን ኩን ማሊፍ መለቶ በርባደ? አን ዹጉመ እስንትን ህመ፤ መለቶን ቶኮዩ ዸሎተ ከናፍ ህንኬነሙ”</char> ጄዼን። <verse eid="MRK 8:12"/><verse number="13" style="v" sid="MRK 8:13"/>እንስ እሳን ዺሴ ብድሩት ዴብኤ ገመ ጬኤ።<verse eid="MRK 8:13"/></para>
  <para style="s1">ራጭቲ ፈሪሶታ</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14"/>በረቶትንስ ቡዴነ ቶክቸ ብድሩ ኬሳ ኦፍ ብራ ቀበን ሰነ መሌ ቡዴነ ፉዸቹ እራንፈተኒ ቱረን። <verse eid="MRK 8:14"/><verse number="15" style="v" sid="MRK 8:15"/>ዬሱስስ፣ <char style="wj">“ቤከዻ፤ ራጭቲ ፈሪሶታቲፊ ራጭቲ ሄሮድስራ ኦፍ ኤገዻ”</char> ጄዼ እሳን አኬከቺሴ።<verse eid="MRK 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16"/>እሳንስ፣ “ኩን ሰበቢ ኑ ቡዴነ ህንቀብኔፍ” ጄዸኒ ወሊ ወጅን ሃሰአን።<verse eid="MRK 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17"/>ዬሱስስ ዋን እሳን ሃሰአን ቤኬ አከነ ጄዼ እሳን ጋፈቴ፤ <char style="wj">“እስን ማሊፍ ዋኤ ቡዴነ ዸቡኬሰኒ ዱዱበቱ? እስን አመዩ ህንአርግተኒ? ዮካን ህንሁበተኒ? መታ ጀባተኒ?</char> <verse eid="MRK 8:17"/><verse number="18" style="v" sid="MRK 8:18"/><char style="wj">እስን ኡቱመ እጀ ቀብደኑ ህንአርግተኒ? ኡቱመ ጉረ ቀብደኑስ ህንዸጌሰኒ? ህንያደተኒ?</char> <verse eid="MRK 8:18"/><verse number="19" style="v" sid="MRK 8:19"/><char style="wj">ዬሮ አን ቡዴነ ሸነን ሰነ ነመ ኩመ ሸኒፍ ጨጨብሴት እስን ሁራኣ ጉንዶ ሜቀ ጉቱ ካፍተን?”</char></para>
  <para style="p" vid="MRK 8:19">እሳንስ፣ “ኩዸ ለመ” ጄዸኒን።<verse eid="MRK 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20"/>እንስ፣ <char style="wj">“ዬሮ አን ቡዴነ ቶርበ ነመ ኩመ አፉሪፍ ጨጨብሴት ሀምባ ጉንዶ ሜቀ ጉቱ ወልት ቀብደን?”</char> ጄዼ ጋፈቴ።</para>
  <para style="p" vid="MRK 8:20">እሳንስ፣ “ቶርበ” ጄዸኒን።<verse eid="MRK 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21"/>እንስ፣ <char style="wj">“እስን አመዩ ህንሁበተኒ?”</char> ጄዼን።<verse eid="MRK 8:21"/></para>
  <para style="s1">ዬሱስ ቤተ ሳይዳት ነመ ጃማ ፈይሴ</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22"/>እሳንስ ቤተ ሳይዳ ዸቀን፤ ጀር ቶኮስ ነምቸ ጃማ ቶኮ ፍደኒ አከ እን እሰ ቀቀቡፍ ዬሱስን ከዸተን። <verse eid="MRK 8:22"/><verse number="23" style="v" sid="MRK 8:23"/>እንስ ነምቸ ጃማ ሰነ ሀርከ ቀቤ ገንደ ሰነ ኬሳ ባሴ። እጀ እሳትስ ቱፌ፣ ሀርከሳስ እረ ካኤ፣ <char style="wj">“ዋ አርጉ ደንዴሳ?”</char> ጄዼ ጋፈቴ።<verse eid="MRK 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24"/>ነምችስ ኦል እላሌ፣ “ነሞተ ነንአርገ፤ ገሩ እሳን ሙከ ዴሙ ነት ፈካቱ” ጄዼ።<verse eid="MRK 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25"/>ዬሱስ አመሌ ሀርከሳ እጀ ነምቻረ ካኤ። እጅ ነምቻስ ንበነሜ፤ አገርቱንሳ ንዴብኤፍ፤ ዋን ሁንደስ ስሪት አርጌ። <verse eid="MRK 8:25"/><verse number="26" style="v" sid="MRK 8:26"/>ዬሱስስ ነምቻን፣ <char style="wj">“ገረ ገንደ ሰና ሴንቴ ዋን ከነ ነመ ቶኮትሌ ህንህምን”</char> ጄዼ ገረ መነሳት እሰ ኤርጌ።<verse eid="MRK 8:26"/></para>
  <para style="s1">ጴጥሮስ ኤኙማ ክርስቶስ ቤክስሴ</para>
  <para style="r">
    <ref loc="MRK 8:27-29">8፥27‑29</ref> ኩወፈ – <char style="xt"><ref loc="MAT 16:13-16">ማቴ 16፥13‑16</ref>፤ <ref loc="LUK 9:18-20">ሉቃ 9፥18‑20</ref></char></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27"/>ዬሱሲፊ በረቶትንሳ ገረ ገንዶተ ናኖ ፊልጶስ ቂሳርያ ጅረኒት ደርበን። እንስ፣ <char style="wj">“ነሞትን አናን ኤኙ ጄዹ?”</char> ጄዼ ከራረት እሳን ጋፈቴ።<verse eid="MRK 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28"/>እሳንስ፣ “ነሞትን ቶኮ ቶኮ፣ ‘እን ዮሀንስ ጩጳዸ’ ጄዹ፤ ወር ካን፣ ‘እን ኤልያስ’ ጄዹ፤ ካንሞ፣ ‘እን ራጆተ ኬሳ እሰ ቶኮዸ’ ጄዹ” ጄዸኒ ዴብሰን።<verse eid="MRK 8:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29"/>እንስ፣ <char style="wj">“እስንሆ? ኤኙ አናን ጄቱ?”</char> ጄዼ ጋፈቴ።</para>
  <para style="p" vid="MRK 8:29">ጴጥሮስስ፣ “አት ክርስቶስ” ጄዼ ዴብሴ።<verse eid="MRK 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30"/>ዬሱስስ አከ እሳን ዋኤሳ ነመ ቶኮትሌ ህንህምኔፍ እሳን አኬከቺሴ።<verse eid="MRK 8:30"/></para>
  <para style="s1">ዬሱስ ዱራን ዱርሴ ዋኤ ዱአሳ ዱበቴ</para>
  <para style="r">
    <ref loc="MRK 8:31-9:1">8፥31–9፥1</ref> ኩወፈ – <char style="xt"><ref loc="MAT 16:21-28">ማቴ 16፥21‑28</ref>፤ <ref loc="LUK 9:22-27">ሉቃ 9፥22‑27</ref></char></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31"/>ዬሱስስ አከ እልም ነማ ዋን ሄዱን ዽጰቹ ቀቡ፣ አከ ማንጉዶታን፣ ሉቦተ ሀንገፎታፊ በርሲስቶተ ሴራቲን ቱፈተሙ ቀቡፊ አከ አጄፈሙ ቀቡ፣ ጉያ ሰዲ ቦዴሞ አከ ዱኣ ከኡ እሳን በርሲሱ ጀልቀቤ። <verse eid="MRK 8:31"/><verse number="32" style="v" sid="MRK 8:32"/>እንስ ዋኤ ከና እፈት ባሴ ዱበቴ፤ ጴጥሮስስ ኮጳት ባሴ እሰ እፈቹ ጀልቀቤ።<verse eid="MRK 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 8:33"/>ዬሱስ ገሩ ኦፍረ ገረገሌ በረቶተሳ እላሌ፤ ጴጥሮሲንስ፣ <char style="wj">“ሴጠነነነ! ነ ዱበት ዴብእ! አት ከን ነማ ያደ መሌ ከን ዋቃ ህንያዱቲ”</char> ጄዼ እፈቴ።<verse eid="MRK 8:33"/></para>
  <para style="s1">ሃለ ከራ ፈኖ</para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34"/>ኤርገሲ እን ቱተ ሰናፊ በረቶተሳ ኦፍት ዋሜ አከነ ጄዼ፤ <char style="wj">“ነምን ከምዩ ዮ ነ ፋነ ዹፉ በርባዴ፣ እን ኦፍ ሃገኑ፤ ፈኖሳ ባዸቴስ ነ ዱካ ሃቡኡ።</char> <verse eid="MRK 8:34"/><verse number="35" style="v" sid="MRK 8:35"/><char style="wj">ነምን ሉቡሳ ኦልፈቹ በርባዱ ከምዩ ሉቡሳ ንዸባቲ፤ ገሩ ነምን አናፊ ወንጌላፍ ጄዼ ሉቡሳ ዸቡ ከምዩ ሉቡሳ ንኦልፈተ።</char> <verse eid="MRK 8:35"/><verse number="36" style="v" sid="MRK 8:36"/><char style="wj">ነምን ዮ አዱኛ ጉቱ አርገቴ ሉቡሳሞ ዸቤ ቡኣ ማሊ አርገተ?</char> <verse eid="MRK 8:36"/><verse number="37" style="v" sid="MRK 8:37"/><char style="wj">ዮካን ነምን ቆደ ሉቡሳ ማል ኬኑ ደንደአ?</char> <verse eid="MRK 8:37"/><verse number="38" style="v" sid="MRK 8:38"/><char style="wj">ዮ ነምን ከምዩ ዸሎተ ኤጃፊ ጩበማ ከነ ኬሰት አናፊ ዱቢኮት ቃነኤ፣ እልም ነማ ዮሙ ኡልፍነ አባሳቲን ኤርገሞተ ቁልቁሉ ወጅን ዹፉት እሰት ንቃነአ።”</char><verse eid="MRK 8:38"/></para>
  <chapter eid="MRK 8"/>
  <chapter number="9" style="c" sid="MRK 9"/>
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1"/>እንስ፣ <char style="wj">“አን ዹጉመን እስንት ህመ፤ ወረ አስ ዸዻበቻ ጅረን ኬሳ ነሞትን ቶኮ ቶኮ ሀመ ሞቱማን ዋቃ ሁምናን ዹፌ አርገንት ዱአ ህንዸንዸመን”</char> እሳኒን ጄዼ።<verse eid="MRK 9:1"/></para>
  <para style="s1">ብፍት ዬሱስ ጌደረሙሳ</para>
  <para style="r">
    <ref loc="MRK 9:2-8">9፥2‑8</ref> ኩወፈ – <char style="xt"><ref loc="LUK 9:28-36">ሉቃ 9፥28‑36</ref></char></para>
  <para style="r">
    <ref loc="MRK 9:2-13">9፥2‑13</ref> ኩወፈ – <char style="xt"><ref loc="MAT 17:1-13">ማቴ 17፥1‑13</ref></char></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2"/>ዬሱስ ጉያ ጀአ ቦዴ ጴጥሮስን፣ ያቆቢፊ ዮሀንስን ፉዸቴ ቱሉ ዼራ<note caller="+" style="f"><char style="fr" closed="false">9፥2 </char><char style="fq" closed="false">ቱሉ </char><char style="ft" closed="false">– አከ ሁበትና ይሁዶታት ቱሉን ዮካን ጋር ኦል ዼራን እዶ ምጃኣ እት ዋቅን ነመት ኦፍ ሙልእሱዸ።</char></note> ቶኮት እዶ እሳን ሁንድ ኮጳ ቱሩ ደንደአንት ኦል እሳን ባሴ። እንስ አችት ፉለሳኒ ዱረት ጌደረሜ። <verse eid="MRK 9:2"/><verse number="3" style="v" sid="MRK 9:3"/>ኡፈትንሳስ ኡፈተ ነምን አዱኛ ከና ከምዩ ሚጬ አዴሱ ደንደኡ ጫላ አከ መሌ አዳቴ። <verse eid="MRK 9:3"/><verse number="4" style="v" sid="MRK 9:4"/>ኤልያሲፊ ሙሴንስ እሳንት ሙልአተን፤ እሳንስ ዬሱስ ወጅን ሃሰኣ ቱረን።<verse eid="MRK 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 9:5"/>ጴጥሮስስ ዬሱሲን፣ “ያ በርሲሳ፣ አስ ጅራቹን ኑፍ ጋሪዸ፤ ዳሲ ሰዲ፣ ቶኮ ሲፍ፣ ቶኮ ሙሴፍ፣ ቶኮሞ ኤልያሲፍ ንእጃረ” ጄዼ። <verse eid="MRK 9:5"/><verse number="6" style="v" sid="MRK 9:6"/>እን ዋን ዱበቱ ህንቤኩ ቱሬ፤ እሳን አከ መሌ ሶዳተኒ ቱረኒቲ።<verse eid="MRK 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7"/>ዱሜስስ<note caller="+" style="f"><char style="fr" closed="false">9፥7 </char><char style="fq" closed="false">ዱሜስስ </char><char style="ft" closed="false">– ዱሜስ አርገሙ ዋቃ ሙልእሰ (<char style="xt"><ref loc="EXO 13:21-22">በኡ 13፥21‑22</ref>፤ <ref loc="EXO 16:10">16፥10</ref>፤ <ref loc="EXO 19:9">19፥9</ref>፤ <ref loc="2CH 5:13-14">2ሴና 5፥13‑14</ref></char>)።</char></note> ዹፌ እሳን ሀጉጌ፤ ሰገሌን፣ “ኩን እልመኮ እሰ አን ጃለዹዸ። እስንስ እሰ ዸገኣ!” ጄዹ ቶኮ ዱሜስቸ ኬሳ ዹፌ።<verse eid="MRK 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 9:8"/>እሳንስ ዮሙ አኩመ ተሳ ናኖሳኒ እላለንት ዬሱስን መሌ ነመ ቶኮሌ ኦፍ ብረት ህንአርግኔ።<verse eid="MRK 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9"/>ኡቱ ቱሉ ሰነራ ቡኡት ጅረኑስ ዬሱስ አከ እሳን ሀመ እልም ነማ ወረ ዱአን ኬሳ ከኡት ዋን አርገን ሰነ ነመ ቶኮትሌ ህንህምኔ እሳን አጀጄ። <verse eid="MRK 9:9"/><verse number="10" style="v" sid="MRK 9:10"/>እሳንስ ወረ ዱአን ኬሳ ከኡን ማል አከ ተኤ ወል ገጋፈቻ ዱብቸ ገራት ቀበተን።<verse eid="MRK 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 9:11"/>እሳንስ፣ “በርሲስቶትን ሴራ ማሊፍ ኤልያስ አከ ዱራን ዱርሴ ዹፉ ቀቡ ዱበቱ?” ጄዸኒ እሰ ጋፈተን።<verse eid="MRK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12"/>ዬሱስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“ዹጉማን ኤልያስ ዱራን ዱርሴ ንዹፈ፤ ዋን ሁንደስ እዶት ዴብሰ። ዮስ ማሊፍ እልም ነማ አከ መሌ ዽጰቹፊ ቱፈተሙ ቀበ ጄዸሜ በሬፈሜሬ?</char> <verse eid="MRK 9:12"/><verse number="13" style="v" sid="MRK 9:13"/><char style="wj">አን ገሩ እስንትን ህመ፤ ኤልያስ ዹፌረ፤ እሳንስ አኩመ ዋኤሳ በሬፈሜ ሰነት ዋኑመ ፌዸን ሁንደ እሰት ሆጄተን።”</char><verse eid="MRK 9:13"/></para>
  <para style="s1">ጉርባን ሀፉረ ጡራኣዻን ቀበሜ ቶኮ ፈዬ</para>
  <para style="r">
    <ref loc="MRK 9:14-28">9፥14‑28</ref>፣<ref loc="MRK 9:30-32">30‑32</ref> ኩወፈ – <char style="xt"><ref loc="MAT 17:14-19">ማቴ 17፥14‑19</ref>፣<ref loc="MAT 17:22">22</ref>፣<ref loc="MAT 17:23">23</ref>፤ <ref loc="LUK 9:37-45">ሉቃ 9፥37‑45</ref></char></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14"/>እሳንስ ዮሙ ገረ በረቶተ ካኒ ዹፈንት፣ ነሞትን ሄዱን እሳንት ናነአኒ፣ በርሲስቶትን ሴራሞ ኡቱ እሳንት ፈልመኑ አርገን። <verse eid="MRK 9:14"/><verse number="15" style="v" sid="MRK 9:15"/>ነሞትን ሁንድኑስ አኩመ ዬሱስን አርገኒን አከ መሌ ድንቅፈተኒ እሰ ዱብሱዻፍ እት ፊገን።<verse eid="MRK 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 9:16"/>እንስ፣ <char style="wj">“እስን ማል እሳንት ፈልምቱ?”</char> ጄዼ እሳን ጋፈቴ።<verse eid="MRK 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17"/>ነሞተ ሰነ ኬሳስ ነምች ቶኮ አከነ ጄዼ ዴብሴ፤ “ያ በርሲሳ፣ አን እልመኮ ከን ሀፉረ አረበ ድዳዻን ቀበሜ ስት ፍዴረ። <verse eid="MRK 9:17"/><verse number="18" style="v" sid="MRK 9:18"/>ሀፉርች ዬሮ እት ከኡ ከምዩ፣ ደርበቴ ለፋን እሰ ዸአ። ጉርብችስ ሆመቸ አፋኒን ባሰ፤ እልካን ቀረ፤ ንኮኮታአስ። አን አከ ሀፉረ ሰነ ባሰኒፍ በረቶተኬ ነንጋፈዼ፤ እሳን ገሩ ህንደንዴኜ።”<verse eid="MRK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19"/>ዬሱስስ ዴብሴ፣ <char style="wj">“እስን ዸሎተ ህንአመኔነነ፤ አን ሀመ ዮሚትን እስን ወጅን ጅራዸ? ሀመ ዮሚትስ አን እስኒ ኦብሰ? ሜ ጉርብቸ ነት ፍዳ”</char> ጄዼ።<verse eid="MRK 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 9:20"/>እሳንስ ጉርብቸ እሰት ፍደን። ሀፉርችስ አኩመ ዬሱስን አርጌን ጉርብቸ ዽዺተቺሴ፤ ጉርብችስ ለፈ ዸኤ ሆመቸ አፋኒን ባሴ ገንገለቴ።<verse eid="MRK 9:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 9:21"/>ዬሱስስ፣ <char style="wj">“ወን ኩን ኤርገ እሰ ቀቤ ሀመም ቱሬ?”</char> ጄዼ አባ ጉርብቻ ጋፈቴ።</para>
  <para style="p" vid="MRK 9:21">እንስ አከነ ጄዼ፤ “እጆሉማዻ ጀልቀቤት። <verse eid="MRK 9:21"/><verse number="22" style="v" sid="MRK 9:22"/>እሰ አጄሱፍ ጄዼስ ዬሮ ባይኤ እብደ ኬሰ ዮካን ብሻን ኬሰ እሰ ቡሴረ። አት ገሩ ዮ ዋኑመ ቶኮሌ ጎቹ ደንዴሴ ገራ ኑ ላፊቲ ኑ ገርጋር።”<verse eid="MRK 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23"/>ዬሱስስ፣ <char style="wj">“ ‘ዮ ደንዴሴ’ ጄታ? ነመ አመኑፍ ወን ሁንድ ንደንደአመ”</char> ጄዼን።<verse eid="MRK 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24"/>ዮሙሱመ አባን ሙጫ ሰና፣ “አን ነንአመነ፤ አመንቲ ዸቡኮ ነ ገርጋር” ጄዼ እዬ።<verse eid="MRK 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25"/>ዬሱስስ ዮሙ ነሞተ ግርሰኒ ዹፈን አርጌት፣ <char style="wj">“ያ ሀፉረ ዱዳፊ አረብ-ድዳነነ፣ አከ አት እሰ ኬሳ ባቱ፣ ዴብቴስ አከ እሰት ህንገሌ ስን አጀጀ”</char> ጄዼ ሀፉረ ጡራኣ ሰነ እፈቴ።<verse eid="MRK 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26"/>ሀፉር ሱን እዬ፣ አከ መሌስ እሰ ዽዺተቺሴ ኬሳ በኤ። ጉርብችስ አኩመ ሬፋ ተኤ፤ ነሞትን ባይኤንስ፣ “እን ዱኤረ” ጄዸን። <verse eid="MRK 9:26"/><verse number="27" style="v" sid="MRK 9:27"/>ዬሱስ ገሩ ሀርከ ቀቤ ኦል እሰ ካሴ፤ ጉርባን ሱንስ ከኤ ዻበቴ።<verse eid="MRK 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28"/>ኤርገ ዬሱስ መነት ኦል ገሌ ቦዴ በረቶትንሳ፣ “ኑ ማሊፍ ሀፉረ ሀማ ሰነ ባሱ ደዸብኔ?” ጄዸኒ ኮጳት እሰ ጋፈተን።<verse eid="MRK 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29"/>እንስ ዴብሴ፣ <char style="wj">“እን አከና ኩን ከዸትናፊ ሶመ ቆፋን በአ መሌ ዋን ብራቲን ህንበኡ”</char> ጄዼን።<verse eid="MRK 9:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30"/>እሳን አቺ ከአኒ ገሊላ ኬሰ ደርበን። ዬሱስስ አከ ነምን ቶኮዩ ከነ ቤኩ ህንበርባድኔ፤ <verse eid="MRK 9:30"/><verse number="31" style="v" sid="MRK 9:31"/>ሰበቢንሳስ፣ <char style="wj">“እልም ነማ ደበርፈሜ ሀርከ ነሞታት ንኬነመ። እሳንስ እሰ ንአጄሱ፤ እንስ ጉያ ሰዲ ቦዴ ዱኣ ንከአ”</char> ጄዼ በረቶተሳ በርሲሳ ቱሬ። <verse eid="MRK 9:31"/><verse number="32" style="v" sid="MRK 9:32"/>እሳን ገሩ ዋን እን ጄዼ ህንሁበትኔ፤ እሰ ጋፈቹስ ንሶዳተን።<verse eid="MRK 9:32"/></para>
  <para style="s1">ነምን ነመ ሁንዱማ ጫሉ ኤኙ?</para>
  <para style="r">
    <ref loc="MRK 9:33-37">9፥33‑37</ref> ኩወፈ – <char style="xt"><ref loc="MAT 18:1-5">ማቴ 18፥1‑5</ref>፤ <ref loc="LUK 9:46-48">ሉቃ 9፥46‑48</ref></char></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33"/>እሳንስ ቅፍርናሆም ዸቀን። እንስ ዬሮ መነ ኬሰ ቱሬት፣ <char style="wj">“እስን ከራት ማል ወልት ፈልማ ቱርተን?”</char> ጄዼ እሳን ጋፈቴ። <verse eid="MRK 9:33"/><verse number="34" style="v" sid="MRK 9:34"/>እሳን ገሩ ኤኙ አከ ነመ ሁንዱማ ጫሉ ከራት ዋን ወልት ፈልማ ቱረኒፍ ንጨልእሰን።<verse eid="MRK 9:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 9:35"/>ዬሱስስ ታኤ ወረ ኩዸ ለማን ዋሜ፣ <char style="wj">“ነምን ነመ ጀልቀባ ተኡ በርባዱ ከምዩ ነመ ሁንዳ ገዲፊ ተጃጅላ ነመ ሁንዳ ተኡ ቀበ”</char> ጄዼን።<verse eid="MRK 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 9:36"/>እንስ ሙጫ ጥና ቶኮ ፍዴ እሳን ግዱ ዻቤ። ሀመቴስ አከነ እሳኒን ጄዼ፤ <verse eid="MRK 9:36"/><verse number="37" style="v" sid="MRK 9:37"/><char style="wj">“ነምን እጆሌ ጥጥኖ ከኔን ኬሳ ቶኮ መቃኮቲን ስመቱ ከምዩ ነ ስመተ፤ ነምን ነ ስመቱ ከምዩስ እሰ ነ ኤርጌ ሰነ ስመተ መሌ ነ ቆፈ ህንስመቱ።”</char><verse eid="MRK 9:37"/></para>
  <para style="s1">ነምን ኑን ህንሞርምኔ ከምዩ ገሬኬኘ</para>
  <para style="r">
    <ref loc="MRK 9:38-40">9፥38‑40</ref> ኩወፈ – <char style="xt"><ref loc="LUK 9:49">ሉቃ 9፥49</ref>፣<ref loc="LUK 9:50">50</ref></char></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38"/>ዮሀንስስ፣ “ያ በርሲሳ፣ ኑ ኡቱ ነምን ቶኮ መቃኬቲን ሀፉሮተ ሀሞ ባሱ አርግኔ ዋን እን ኑ ዱካ ህንቡኔፍ እሰ ዾውኔ” ጄዼ።<verse eid="MRK 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39"/>ዬሱስ ገሩ አከነ ጄዼ፤ <char style="wj">“እሰ ህንዾውና፤ ነምን መቃኮቲን ድንቂ ሆጄቱ ከን ኤርገሲሞ ደፌ ዋኤኮ ዋን ሀማ ዱበቹ ደንደኡ ቶኮዩ ህንጅሩቲ።</char> <verse eid="MRK 9:39"/><verse number="40" style="v" sid="MRK 9:40"/><char style="wj">ነምን ኑን ህንሞርምኔ ከምዩ ከኑመኬኛቲ።</char> <verse eid="MRK 9:40"/><verse number="41" style="v" sid="MRK 9:41"/><char style="wj">አን ዹጉመን እስንት ህመ፤ ነምን ሰበቢ እስን ከን ክርስቶስ ታተኒፍ ጄዼ ብሻን ቡዱቅሳ ቶኮ እስኒ ኬኑ ከምዩ ዹጉማን ገቲሳ ህንዸቡ።</char><verse eid="MRK 9:41"/></para>
  <para style="s1">ጩቡ ነመ ሆጄቺሱ</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42"/>
    <char style="wj">“ነምን ከምዩ ወረ ነት አመነን ጥጥና ከኔን ኬሳ ቶኮ ጉፈቺሱረ፣ ኡቱ ዸጋን ዳኩ ጉዳንሳ ሞርመሳት ህዸሜ ገላነት ደርበተሜ እሳፍ ወየ ቱሬ።</char> <verse eid="MRK 9:42"/><verse number="43" style="v" sid="MRK 9:43"/><char style="wj">ዮ ሀርክኬ ስ ጉፈቺሴ፣ ኦፍራ ሙር። ሀርከ ለመ ቀባቴ ገሃነምት፣ እዶ እብድሳ ህንዻምኔት ገሉረ፣ ሀርከ ዶሉዻን ጅሬኘት ገሉ ሲፍ ወየ።</char> [ <verse eid="MRK 9:43"/><verse number="44" style="v" sid="MRK 9:44"/><char style="wj">ገሃነምስ እዶ፣</char></para>
  <para style="q1" vid="MRK 9:44">
    <char style="wj">“ ‘እት ራሞንሳኒ ህንዱኔ፣</char></para>
  <para style="q2" vid="MRK 9:44">
    <char style="wj">እብድስ ህንዻምኔዸ።’</char>]<note caller="+" style="f"><char style="fr" closed="false">9፥44 </char><char style="ft" closed="false">ኩታን ኩን ወራብሌ ቶኮ ቶኮ ኬሰት ህንአርገሙ።</char></note><verse eid="MRK 9:44"/></para>
  <para style="m">
    <verse number="45" style="v" sid="MRK 9:45"/>
    <char style="wj">ዮ ሚልኬ ስ ጉፈቺሴ ኦፍራ ሙር። ሚለ ለመ ቀባቴ ገሃነምት ደርበተሙረ፣ ላምሾፍቴ ጅሬኘት ገሉ ሲፍ ወየ።</char> [ <verse eid="MRK 9:45"/><verse number="46" style="v" sid="MRK 9:46"/><char style="wj">ገሃነምስ እዶ፣</char></para>
  <para style="q1" vid="MRK 9:46">
    <char style="wj">“ ‘እት ራሞንሳኒ ህንዱኔ፣</char></para>
  <para style="q2" vid="MRK 9:46">
    <char style="wj">እብድስ ህንዻምኔዸ።’</char>]<note caller="+" style="f" category="dup"> <char style="fr" closed="false">9፥46 </char><char style="ft" closed="false">ኩታን ኩን ወራብሌ ቶኮ ቶኮ ኬሰት ህንአርገሙ።</char></note><verse eid="MRK 9:46"/></para>
  <para style="m">
    <verse number="47" style="v" sid="MRK 9:47"/>
    <char style="wj">ዮ እጅኬ ስ ጉፈቺሴ፣ ኦፍ ኬሳ ባስ። እጀ ለመ ቀባቴ ገሃነምት ደርበተሙረ እጀ ቶኮን ሞቱማ ዋቃት ገሉ ሲፍ ወየ።</char> <verse eid="MRK 9:47"/><verse number="48" style="v" sid="MRK 9:48"/><char style="wj">ገሃነምስ እዶ፣</char></para>
  <para style="q1" vid="MRK 9:48">
    <char style="wj">“ ‘እት ራሞንሳኒ ህንዱኔ፣</char></para>
  <para style="q2" vid="MRK 9:48">
    <char style="wj">እብድስ ህንዻምኔዸ።’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">9፥48 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="ISA 66:24">እሳ 66፥24</ref>
        </char>
      </char>
    </note><verse eid="MRK 9:48"/></para>
  <para style="m">
    <verse number="49" style="v" sid="MRK 9:49"/>
    <char style="wj">ነምን ሁንድኑ እብዳን ምኤፈመ።</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">9፥49 </char>
      <char style="fq" closed="false">ምኤፈመ </char>
      <char style="fqa" closed="false">(ቁልቁሌፈመ) </char>
      <char style="ft" closed="false">– ጄች ኩን ምኣ ሶግደራ አርገሙ ሙልእሰ። ነሞትን ዱሪ አከ ኣርሳን ቶኮ ፉለ ዋቃ ዱረት ፉዸተመ አርገቱፍ ጄቹንስ ኣርሳ ቁልቁሌሱፍ ሶግደት ፈየደማ ቱረን (<char style="xt"><ref loc="LEV 2:13">ሌዎ 2፥13</ref>፤ <ref loc="EZK 43:24">ህስ 43፥24</ref></char>)።</char>
    </note><verse eid="MRK 9:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50"/>
    <char style="wj">“ሶግድ ጋሪዸ፤ ገሩ ዮ ምኣሳ ዸቤ፣ ምኣሳ አከሚን ዴብሱፊ ደንዴሱ? እስንስ ሶግደ ኦፍ ኬሳ ቀባዻ፤ ወሊ ወጅንስ ነጋን ጅራዻ።”</char><verse eid="MRK 9:50"/></para>
  <chapter eid="MRK 9"/>
  <chapter number="10" style="c" sid="MRK 10"/>
  <para style="s1">ወል ሂኩ ዽርሳፊ ኒቲ</para>
  <para style="r">
    <ref loc="MRK 10:1-12">10፥1‑12</ref> ኩወፈ – <char style="xt"><ref loc="MAT 19:1-9">ማቴ 19፥1‑9</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1"/>ዬሱስስ አቺ ከኤ ገረ ብየ ይሁዳቲፊ ዮርዳኖስ ገማ ዸቄ። አመሌ ነሞትን እሰ ብረት ወልት ቀበመን፤ እንስ አኩመ በርቴሳት እሳን በርሲሴ።<verse eid="MRK 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2"/>ፈሪሶትን ዹፈኒ፣ “ነምን ቶኮ ኒቲሳ ሂኩን ንኤየመማ?” ጄዸኒ ጋፈቹዻን እሰ ቆረን።<verse eid="MRK 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3"/>እንስ ዴብሴ፣ <char style="wj">“ሙሴን ማል እስን አጀጄ?”</char> ጄዼን።<verse eid="MRK 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4"/>እሳንስ፣ “ነምን ቶኮ አከ ወረቃ ረጋ ሂካ በሬሴፊ ኒቲሳ ሂኩ ሙሴን ኤየሜረ” ጄዸን።<verse eid="MRK 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5"/>ዬሱስስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“ሙሴን ሰበቢ መተ ጀብነኬሰኒቲፍ ጄዼ ሴረ ከነ እስኒፍ በሬሴ።</char> <verse eid="MRK 10:5"/><verse number="6" style="v" sid="MRK 10:6"/><char style="wj">ጀልቀበ ኡመማቲ ካሴ ገሩ ዋቅን፣ ‘ዺራፊ ዱበርቲ እሳን ታስሴ።’</char><note caller="+" style="f"><char style="fr" closed="false">10፥6 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 1:27">ኡመ 1፥27</ref></char></char></note> <verse eid="MRK 10:6"/><verse number="7" style="v" sid="MRK 10:7"/><char style="wj">‘ከናፍስ ነምን አባሳቲፊ ሃዸሳ ንዺሰ፤ ኒቲሳ ወጅንስ ቶኮ ተአ፤</char> <verse eid="MRK 10:7"/><verse number="8" style="v" sid="MRK 10:8"/><char style="wj">ለማንሳኒዩ ፎን ቶኮ ንተኡ።’</char><note caller="+" style="f"><char style="fr" closed="false">10፥8 </char><char style="ft" closed="false"><char style="xt"><ref loc="GEN 2:24">ኡመ 2፥24</ref></char></char></note> <char style="wj">ኤጋ እሳን ስአች ፎን ቶኮ መሌ ለመ ምት።</char> <verse eid="MRK 10:8"/><verse number="9" style="v" sid="MRK 10:9"/><char style="wj">ከናፉ ዋን ዋቅን ቶኮ ታስሴ ነምን ገርገር ህንባስን።”</char><verse eid="MRK 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10"/>ኡቱ አመስ መነ ጅረኑ በረቶትን ዋኤ ዱቢ ከና ዬሱስን ጋፈተን። <verse eid="MRK 10:10"/><verse number="11" style="v" sid="MRK 10:11"/>እንስ አከነ ጄዼ ዴብሴፍ፤ <char style="wj">“ነምን ኒቲሳ ሂኬ ዱበርቲ ብራ ፉዹ ከምዩ እሼረት ኤጀ ራወተ።</char> <verse eid="MRK 10:11"/><verse number="12" style="v" sid="MRK 10:12"/><char style="wj">እሼንስ ዮ ዽርሰሼ ሂክቴ ነመ ብራት ሄሩምቴ ኤጀ ራወት።”</char><verse eid="MRK 10:12"/></para>
  <para style="s1">ዬሱስ እጆሌ ኤብሱሳ</para>
  <para style="r">
    <ref loc="MRK 10:13-16">10፥13‑16</ref> ኩወፈ – <char style="xt"><ref loc="MAT 19:13-15">ማቴ 19፥13‑15</ref>፤ <ref loc="LUK 18:15-17">ሉቃ 18፥15‑17</ref></char></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13"/>ነሞትን አከ እን ሀርከ እሳንረ ካኡፍ እጆሌ ጥጥኖ ዬሱስት ፍዳ ቱረን፤ በረቶትን ገሩ እሳን እፈተን። <verse eid="MRK 10:13"/><verse number="14" style="v" sid="MRK 10:14"/>ዬሱስ ዮሙ ዋን ከነ አርጌት ኣሬ አከነ እሳኒን ጄዼ፤ <char style="wj">“እጆሌን ጥጥኖን ገረኮ ሃዹፈኒቲ ህንዾውና፤ ሞቱማን ዋቃ ከን ወረ አከናቲ።</char> <verse eid="MRK 10:14"/><verse number="15" style="v" sid="MRK 10:15"/><char style="wj">አን ዹጉመን እስንት ህመ፤ ነምን አኩመ እጆሌት ሞቱማ ዋቃ ህንስመትኔ ከምዩ ጎንኩማ እት ህንገሉ።”</char> <verse eid="MRK 10:15"/><verse number="16" style="v" sid="MRK 10:16"/>እንስ እጆሌ ሰነ ፉዼ ኦፍት ቀቤ፤ ሀርከሳስ እሳንረ ካኤ እሳን ኤብሴ።<verse eid="MRK 10:16"/></para>
  <para style="s1">ደርገጌሰ ሶሬሰ ቶኮ</para>
  <para style="r">
    <ref loc="MRK 10:17-31">10፥17‑31</ref> ኩወፈ – <char style="xt"><ref loc="MAT 19:16-30">ማቴ 19፥16‑30</ref>፤ <ref loc="LUK 18:18-30">ሉቃ 18፥18‑30</ref></char></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17"/>አኩመ ዬሱስ ዴሙፍ ከራ ቀበቴን ነምች ቶኮ ፊጋ ዹፌ ፉለሳ ዱረት ጅልቤንፈቴ፣ “ያ በርሲሳ ጋሪ፣ አን ጅሬኘ በረ በራ ዻሉፍ ማል ጎቹን ቀበ?” ጄዼ ጋፈቴ።<verse eid="MRK 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18"/>ዬሱስስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“አት ማሊፍ ጋሪ ናን ጄተ? ዋቀ ቶክቸ መሌ ጋሪን ህንጅሩ።</char> <verse eid="MRK 10:18"/><verse number="19" style="v" sid="MRK 10:19"/><char style="wj">አት አጀጀወን ንቤክተ፤ ‘ህንአጄስን፤ ህንኤጅን፤ ህንሀትን፤ ሶባን ዹጋ ህንበእን፤ ህንጎዎምስን፤ አባኬቲፊ ሃዸኬቲፍ ኡልፍነ ኬን።’</char><note caller="+" style="f"><char style="fr" closed="false">10፥19 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 20:12">በኡ 20፥12</ref>፤ <ref loc="DEU 5:16-20">ኬዴ 5፥16‑20</ref></char></char></note><char style="wj">”</char><verse eid="MRK 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20"/>ነምችስ፣ “ያ በርሲሳ፣ አን እጆሉማኮቲ ጀልቀቤ አጀጀወን ከኔን ሁንደ ኤጌረ” ጄዼ።<verse eid="MRK 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21"/>ዬሱስ ነምቸ እላሌ እሰ ጃለቴ፣ <char style="wj">“ዋን ቶኮቱ ስ ዱራ ህርአተ፤ ዸቂቲ ዋን ቀብዱ ሁንደ ጉርጉሪ ህዬዪፍ ኬን፤ ሰሚረት በዻዹማ ንቀባታ። ኤርገሲ ኮቱ ነ ዱካ ቡእ”</char> ጄዼን።<verse eid="MRK 10:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 10:22"/>ከነረት ፉል ነምቻ ንጌደረሜ። እን ገዴ አቺ ዴሜ፤ ቀቤኘ ጉዳ ቀበ ቱሬቲ።<verse eid="MRK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23"/>ዬሱስስ ናኖሳ እላሌ በረቶተሳቲን፣ <char style="wj">“ሞቱማ ዋቃት ገሉን ሶሬዪፍ አከም ረክሳዸ!”</char> ጄዼ።<verse eid="MRK 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24"/>በረቶትንስ ዱቢሳ ንድንቅሲፈተን። ዬሱስ ገሩ አመስ አከነ ጄዼን፤ <char style="wj">“እጆሌ፣ ሞቱማ ዋቃት ገሉን አከም ረክሳዸ!</char> <verse eid="MRK 10:24"/><verse number="25" style="v" sid="MRK 10:25"/><char style="wj">ነምን ሶሬስ ሞቱማ ዋቃት ገሉረ ቃወ ልልሞ ኬሰ በኡቱ ጋላፍ ሰልጰተ።”</char><verse eid="MRK 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26"/>በረቶትንስ አከ መሌ ራጄፈተኒ፣ “ዮስ ኤኙቱ ፈዩ ደንደአሬ?” ወሊን ጄዸን።<verse eid="MRK 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27"/>ዬሱስስ እሳን እላሌ፣ <char style="wj">“ኩን ገሩ ዋቃፍ መሌ ነማፍ ህንደንደአሙ፤ ዋቃፍ ወን ሁንድኑ ንደንደአማቲ”</char> ጄዼ።<verse eid="MRK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28"/>ከነረት ጴጥሮስ፣ “ኩኖ፣ ኑ ዋን ሁንደ ዺፍኔ ስ ዱካ ቡኔረ” ጄዼ።<verse eid="MRK 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29"/>ዬሱስስ ዴብሴ አከነ ጄዼን፤ <char style="wj">“አን ዹጉመ እስንት ነንህመ፤ ነምን አናፊ ወንጌላፍ ጄዼ መነ ዮካን ኦቦሎተ ዮካን ኦቦሌቶተ ዮካን ሃዸ ዮካን አባ ዮካን እጆሌ ዮካን ለፈ ቆቲሳ ዺሴ ከምዩ፣</char> <verse eid="MRK 10:29"/><verse number="30" style="v" sid="MRK 10:30"/><char style="wj">ከን በረ አማ ከነ ኬሰ አርአተመ ወጅን መኔን፣ ኦቦሎተ፣ ኦቦሌቶተ፣ ሃዾተ፣ እጆሌፊ ለፈ ቆቲሳ ደቻ ዽበ ህንአርገትኔ፣ ከን በረ ዹፉትስ ጅሬኘ በረ በራ ህንዻሌ ቶኮዩ ህንጅሩ።</char> <verse eid="MRK 10:30"/><verse number="31" style="v" sid="MRK 10:31"/><char style="wj">ገሩ ወር ጀልቀባ ሄዱን ወረ ዹማ፣ ወር ዹማሞ ወረ ጀልቀባ ንተኡ።”</char><verse eid="MRK 10:31"/></para>
  <para style="s1">ዬሱስ አመስ ዋኤ ዱአሳ ዱራን ዱርሴ ዱበቴ</para>
  <para style="r">
    <ref loc="MRK 10:32-34">10፥32‑34</ref> ኩወፈ – <char style="xt"><ref loc="MAT 20:17-19">ማቴ 20፥17‑19</ref>፤ <ref loc="LUK 18:31-33">ሉቃ 18፥31‑33</ref></char></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32"/>እሳንስ ዬሩሳሌምት ኦል በኡፍ ጄዸኒ ከራረ ቱረን፤ ዬሱስሞ እሳን ዱረ ዴማ ቱሬ፤ በረቶትንስ ንድንቅሲፈተን፤ ወር ዱካ ቡኣ ቱረንሞ ንሶዳተን። ዬሱስ አመሌ ወረ ኩዸ ለማን ኮጳት ባሴ ዋን እሰት ዹፉፍ ጅሩ እሳንት ህሜ። <verse eid="MRK 10:32"/><verse number="33" style="v" sid="MRK 10:33"/>አከነስ ጄዼ፤ <char style="wj">“ኩኖ፣ ኑ ዬሩሳሌምት ኦል በኣ ጅረ፤ እልም ነማስ ደበርፈሜ ሉቦተ ሀንገፎተቲፊ በርሲስቶተ ሴራት ንኬነመ። እሳንስ ዱአ እት ሙሩ፤ አከሱመስ ደበርሰኒ ነሞተ ኦርማት እሰ ኬኑ፤</char> <verse eid="MRK 10:33"/><verse number="34" style="v" sid="MRK 10:34"/><char style="wj">እሳንስ እሰት ቆሱ፤ እሰት ቱፉ፤ እሰ ገረፉ፤ እሰ አጄሱስ። እን ገሩ ጉያ ሰዲ ቦዴ ዱኣ ንከአ።”</char><verse eid="MRK 10:34"/></para>
  <para style="s1">ከዻ ያቆቢፊ ዮሀንስ</para>
  <para style="r">
    <ref loc="MRK 10:35-45">10፥35‑45</ref> ኩወፈ – <char style="xt"><ref loc="MAT 20:20-28">ማቴ 20፥20‑28</ref></char></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35"/>እልማን ዘብዴዎስ ጄቹንስ ያቆቢፊ ዮሀንስ ገረ ዬሱስ ዹፈኒ፣ “ያ በርሲሳ፣ አከ አት ዋን ኑ ስከዸትኑ ከምዩ ኑ ጎቱ በርባድነ” ጄዸን።<verse eid="MRK 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36"/>እንስ፣ <char style="wj">“አከ አን ማል እስኒፍ ጎዹ በርባዱ?”</char> ጄዼን።<verse eid="MRK 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37"/>እሳንስ ዴብሰኒ፣ “ዬሮ ኡልፍነኬቲት፣ ቶኮንኬኘ ምርገኬቲን፣ ቶኮንኬኘሞ ብታኬቲን አከ ቴኙፍ ኑፍ ኤየም” ጄዸኒ ዴብሰን።<verse eid="MRK 10:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38"/>ዬሱስስ፣ <char style="wj">“እስን ዋን ከዸተን ህንቤክተን፤ ጦፎ አን ዹጉ፣ ዹጉ ዮካን ጩጳ አን ጩጰሙ፣ ጩጰሙ ንደንዴሱ?”</char> ጄዼን።<verse eid="MRK 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39"/>እሳንስ፣ “ንደንዴኘ” ጄዸኒ ዴብሰን።</para>
  <para style="p" vid="MRK 10:39">ዬሱስስ አከነ ጄዼን፤ <char style="wj">“ጦፎ አን ዹጉ ንዹግዱ፤ ጩጳ አን ጩጰሙስ ንጩጰምቱ፤</char> <verse eid="MRK 10:39"/><verse number="40" style="v" sid="MRK 10:40"/><char style="wj">ገሩ ምርገኮ ዮካን ብታኮ ታኡ ከን ኬኑ አነ ምት። እዶን ኩን ከን ወረ እሳኒፍ ጄዸሜ ቆጴፈሜ ሰናት።”</char><verse eid="MRK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41"/>ወር ኩርነን ዮሙ ዋን ከነ ዸገአንት ያቆቢፊ ዮሀንስት ኣረን። <verse eid="MRK 10:41"/><verse number="42" style="v" sid="MRK 10:42"/>ዬሱስስ ወልት እሳን ዋሜ አከነ ጄዼ፤ <char style="wj">“እስን አከ ወር አከ ቡልችቶተ ነሞተ ኦርማት እላለመን ሱን እሳንረት ጎፍቱማ ሙልእሰን፣ ጉርጉዶትንሳኒስ አከ እሳንረት ታይታ አርግሲሰን ንቤክቱ።</char> <verse eid="MRK 10:42"/><verse number="43" style="v" sid="MRK 10:43"/><char style="wj">እስን ብረት አከስ ምት። ቆደ ከና ነምን እስን ኬሳ ነመ ጉዳ ተኡ በርባዱ ከምዩ ተጃጅላኬሰን ተኡ ቀበ፤</char> <verse eid="MRK 10:43"/><verse number="44" style="v" sid="MRK 10:44"/><char style="wj">ነምን ነመ ጀልቀባ ተኡ በርባዱ ከምዩ ገርብቸ ነመ ሁንዳ ተኡ ቀበ።</char> <verse eid="MRK 10:44"/><verse number="45" style="v" sid="MRK 10:45"/><char style="wj">እልም ነማዩ ተጃጅሉፊ ሉቡሳሞ ነሞተ ባይኤዻፍ ፉሪ ጎዼ ኬኑፍ ዹፌ መሌ ተጃጅለሙፍ ህንዹፍኔቲ።”</char><verse eid="MRK 10:45"/></para>
  <para style="s1">እጅ በርጤሜዎስ በነሙሳ</para>
  <para style="r">
    <ref loc="MRK 10:46-52">10፥46‑52</ref> ኩወፈ – <char style="xt"><ref loc="MAT 20:29-34">ማቴ 20፥29‑34</ref>፤ <ref loc="LUK 18:35-43">ሉቃ 18፥35‑43</ref></char></para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46"/>እሳንስ ዬርኮ ዹፈን። ኡቱ ዬሱስ በረቶተሳቲፊ ቱተ ነሞታ ጉዳሳ ወጅን ዬርኮዻ በኣ ጅሩ፣ ነምች ጃማን በርጥሜዎስ ጄዸሙ እልም ጥሜዎስ ከራረ ታኤ ከዸቻ ቱሬ። <verse eid="MRK 10:46"/><verse number="47" style="v" sid="MRK 10:47"/>በርጤሜዎስስ ዮሙ አከ እን ዬሱስ እሰ ናዝሬት ተኤ ዸገኤት፣ “ዬሱስ፣ ያ እልመ ዳዊት ነ ማር!” ጄዼ እዩ ጀልቀቤ።<verse eid="MRK 10:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48"/>ነሞትን ባይኤን አከ እን ጨልእሱፍ እፈተን፤ እን ገሩ፣ “ያ እልመ ዳዊት ነ ማር!” ጄዼ እቱመ ጫልችሴ እዬ።<verse eid="MRK 10:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49"/>ዬሱስስ ዻበቴ፣ <char style="wj">“እሰ ዋማ”</char> ጄዼ።</para>
  <para style="p" vid="MRK 10:49">እሳንስ፣ “ጀባዹ! ከእ እን ስዋማቲ” ጄዸኒ ነምቸ ጃማ ሰነ ዋመን። <verse eid="MRK 10:49"/><verse number="50" style="v" sid="MRK 10:50"/>እንስ ወያሳ ኦፍራ ደርበቴ፣ ኡታሌ ከኤ ገረ ዬሱስ ዹፌ።<verse eid="MRK 10:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51"/>ዬሱስስ፣ <char style="wj">“አከ አን ማል ሲፍ ጎዹ በርባደ?”</char> ጄዼ እሰ ጋፈቴ።</para>
  <para style="p" vid="MRK 10:51">ነምች ጃማን ሱንስ፣ “ያ በርሲሳ፣ አን አርጉን በርባደ” ጄዼን።<verse eid="MRK 10:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52"/>ዬሱስስ፣ <char style="wj">“አመንቲንኬ ስፈይሴራ ዴም”</char> ጄዼን። እንስ ዬሩመ ሰነ አርጌ ከራረ ቡኤ ዬሱስ ዱካ ቡኤ።<verse eid="MRK 10:52"/></para>
  <chapter eid="MRK 10"/>
  <chapter number="11" style="c" sid="MRK 11"/>
  <para style="s1">ዬሱስ አከ ሞቲት ዬሩሳሌም ሴኑሳ</para>
  <para style="r">
    <ref loc="MRK 11:1-10">11፥1‑10</ref> ኩወፈ – <char style="xt"><ref loc="MAT 21:1-9">ማቴ 21፥1‑9</ref>፤ <ref loc="LUK 19:29-38">ሉቃ 19፥29‑38</ref></char></para>
  <para style="r">
    <ref loc="MRK 11:7-10">11፥7‑10</ref> ኩወፈ – <char style="xt"><ref loc="JHN 12:12-15">ዮሀ 12፥12‑15</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1"/>አኩመ እሳን ዬሩሳሌምት ዽኣተኒ፣ ቤተ ፋጌፊ ቢታንያ ከኔን ቱሉ ኤጄርሳ ብራ ሰነ ገአኒን ዬሱስ በረቶተሳ ኬሳ ለመ ኤርጌ፤ <verse eid="MRK 11:1"/><verse number="2" style="v" sid="MRK 11:2"/>አከነስ እሳኒን ጄዼ፤ <char style="wj">“ገረ ገንደ ፉለኬሰን ዱረ ጅሩ ሰና ዸቃ፤ አኩመ አች ሴንተኒንስ፣ እልሞ ሀሬ ከን ነምን ቶኮዩ ተኩማ ህንያበትን ቶኮ አችት ህዸሜ ጅሩ ንአርገቱ፤ እሰ ሂካቲ አስ ፍዳ።</char> <verse eid="MRK 11:2"/><verse number="3" style="v" sid="MRK 11:3"/><char style="wj">ዮ ነምን ቶኮዩ፣ ‘እስን ማሊፍ ዋን ከነ ጎቱ?’ ጄዼ እስን ጋፈቴ፣ ‘ጎፍታቱ እሰ በርባደ፤ ደፌስ ዴብሴ ንኤርገ’ ጄዻ።”</char><verse eid="MRK 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4"/>እሳንስ ዸቀኒ እልሞ ሀሬ ከን በልበለ ዱረት፣ ከራረት ህዸሜ ቶኮ አርገን። አኩመ እሳን ሂከኒንስ፣ <verse eid="MRK 11:4"/><verse number="5" style="v" sid="MRK 11:5"/>ነሞትን አች ዸዻበቻ ቱረን ቶኮ ቶኮ፣ “ማል ጎቹፍ እልሞ ሀሬ ሰነ ሂክቱ?” ጄዸኒ እሳን ጋፈተን። <verse eid="MRK 11:5"/><verse number="6" style="v" sid="MRK 11:6"/>እሳንስ አኩመ ዬሱስ እሳኒን ጄዼ ሰነት ዴብሰኒፍ፤ ነሞትን ሱንስ አከ እሳን ዴመን እሳን ዺሰን። <verse eid="MRK 11:6"/><verse number="7" style="v" sid="MRK 11:7"/>እልሞ ሀሬ ሰነስ ዬሱስት ፍደን፤ ኡፈተሳኒስ እልሞ ሀሬረ ቡሰን፤ እንስ እረ ታኤ። <verse eid="MRK 11:7"/><verse number="8" style="v" sid="MRK 11:8"/>ነሞትን ባይኤን ኡፈተሳኒ ከራረ አፈን፤ ወር ካንሞ ደሜወን ባለ ቀበን ከኔን አላ ኩኩተን ሰነ ከራረ ቡቡሰን። <verse eid="MRK 11:8"/><verse number="9" style="v" sid="MRK 11:9"/>ወር ዱረ ዴማ ቱረኒፊ ወር ዱካ ቡኣ ቱረን እየኒ አከነ ጄዸን፤</para>
  <para style="q1" vid="MRK 11:9">“ሆሳእና!”<note caller="+" style="f"><char style="fr" closed="false">11፥9 </char><char style="fq" closed="false">ሆሳእና! </char><char style="ft" closed="false">– ሆሳእና ጄቹን፣ “አመ ፈይስ!” ዮካን “ማሎ ፈይስ!” ጄቹዸ።</char></note></para>
  <para style="b" vid="MRK 11:9"/>
  <para style="q1" vid="MRK 11:9">“እን መቃ ጎፍታቲን ዹፉ ኤብፈማዸ!”<note caller="+" style="f"><char style="fr" closed="false">11፥9 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:25">ፋር 118፥25</ref>፣<ref loc="PSA 118:26">26</ref></char></char></note><verse eid="MRK 11:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10"/>“ሞቱማን አባኬኘ ዳዊት እን ዹፉ ሱን ኤብፈማዸ!”</para>
  <para style="b" vid="MRK 11:10"/>
  <para style="q1" vid="MRK 11:10">“ሆሳእና ኦል ጉባት!”<verse eid="MRK 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11"/>ዬሱስስ ዬሩሳሌም ሴኔ መነ ቁልቁሉማት ኦል ገሌ። ገረገሌስ ዋን ሁንዱማ እላሌ፤ ሰበቢ ለፍት ገልገላኤ ቱሬፍስ ወረ ኩዸ ለማን ወጅን በኤ ቢታንያ ዸቄ።<verse eid="MRK 11:11"/></para>
  <para style="s1">ዬሱስ መነ ቁልቁሉማ ቁልቁሌሱሳ</para>
  <para style="r">
    <ref loc="MRK 11:12-14">11፥12‑14</ref> ኩወፈ – <char style="xt"><ref loc="MAT 21:18-22">ማቴ 21፥18‑22</ref></char></para>
  <para style="r">
    <ref loc="MRK 11:15-18">11፥15‑18</ref> ኩወፈ – <char style="xt"><ref loc="MAT 21:12-16">ማቴ 21፥12‑16</ref>፤ <ref loc="LUK 19:45-47">ሉቃ 19፥45‑47</ref>፤ <ref loc="JHN 2:13-16">ዮሀ 2፥13‑16</ref></char></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12"/>ጉያ እት ኣኑት ኡቱ ቢታንያዻ በአኑ ዬሱስ ቤለኤ። <verse eid="MRK 11:12"/><verse number="13" style="v" sid="MRK 11:13"/>እንስ ሙከ ሀርቡ ባለ ቀቡ ቶኮ ፈጎት አርጌ እጀ ቀባቹፊ ቀባቹ ባቹሳ እላሉ ዸቄ። ገሩ ዋን ዬሮን ሱን ወቅቲ ሀርቡ ህንተእኒፍ እን ዮሙ ሙከ ሰነ ብረ ገኤት ባለ መሌ ዋ ቶኮሌ ህንአርገትኔ። <verse eid="MRK 11:13"/><verse number="14" style="v" sid="MRK 11:14"/>ዬሱስስ ሙከ ሰናን፣ <char style="wj">“ነምን ቶኮዩ ዴብኤ እጀ ስራ ህንኛትን”</char> ጄዼ። በረቶትንሳስ ንዸገአን።<verse eid="MRK 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15"/>ዮሙ ዬሩሳሌም ገአንትስ ዬሱስ መነ ቁልቁሉማ ሴኔ ወረ አችት ብተተኒፊ ጉርጉረተን አርኡ ጀልቀቤ። ምንጃለ ወረ ማለቀ ጌደረተኒቲፊ በርጩመ ወረ ጉጌ ጉርጉረተኒ ገረገልቼ። <verse eid="MRK 11:15"/><verse number="16" style="v" sid="MRK 11:16"/>አከ ነምን ቶኮዩ ዋን ቶኮሌ ባቴ መነ ቁልቁሉማ ኬሰ ደርቡስ ህንኤየምኔ። <verse eid="MRK 11:16"/><verse number="17" style="v" sid="MRK 11:17"/>እንስ አከነ ጄዼ እሳን በርሲሴ፤ <char style="wj">“ ‘መንኮ ሰበ ሁንዱማፍ መነ ከዸትና ንጄዸመ’</char><note caller="+" style="f"><char style="fr" closed="false">11፥17 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 56:7">እሳ 56፥7</ref></char></char></note> <char style="wj">ጄዸሜ ህንበሬፈምኔ? እስን ገሩ ‘ሆልቀ ሳምቶታ’</char><note caller="+" style="f"><char style="fr" closed="false">11፥17 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 11:7">ኤር 11፥7</ref></char></char></note> <char style="wj">ጎተኒርቱ።”</char><verse eid="MRK 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18"/>ሉቦትን ሀንገፎትኒፊ በርሲስቶትን ሴራ ዋን ከነ ዸገአኒ ከራ እቲን እሰ አጄሰን በርባዱ ጀልቀበን፤ እሳን ሰበቢ ነሞትን ሁንድኑ በርሲሰሳ ድንቅሲፈተኒፍ እሰ ሶዳተኒ ቱረኒቲ።<verse eid="MRK 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19"/>እሳንስ ዮሙ ለፍት ገልገላኤት መጋላ ሰነ ኬሳ በአን።<verse eid="MRK 11:19"/></para>
  <para style="s1">ሙክት ሀርቡ ጎጉሳ</para>
  <para style="r">
    <ref loc="MRK 11:20-24">11፥20‑24</ref> ኩወፈ – <char style="xt"><ref loc="MAT 21:19-22">ማቴ 21፥19‑22</ref></char></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20"/>እሳንስ ገነማን ኡቱ ከራ ሰነ ደርበኑ አከ ሙክት ሀርቡ ሱን ሁንዴሳቲ ጀልቀቤ ጎጌ አርገን። <verse eid="MRK 11:20"/><verse number="21" style="v" sid="MRK 11:21"/>ጴጥሮስስ ያደቴ ዬሱሲን፣ “ያ በርሲሳ እላ! ሀርቡን አት አባርቴ ሱን ጎጌረ!” ጄዼ።<verse eid="MRK 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22"/>ዬሱስሞ አከነ ጄዼ ዴብሴ፤ <char style="wj">“ዋቀት አመና።</char> <verse eid="MRK 11:22"/><verse number="23" style="v" sid="MRK 11:23"/><char style="wj">አን ዹጉመን እስንት ህመ፤ ኤኙዩ ዮ ቱሉ ከናን ‘ቡቀኢቲ ገላነት ደርበተም’ ጄዼ፣ ዮ ገራሳትስ መሙ ባቴ አከ ወን እን ጄዼ ሱን ተኡ አመኔ፣ ወን ሱን ንተኣፍ።</char> <verse eid="MRK 11:23"/><verse number="24" style="v" sid="MRK 11:24"/><char style="wj">ከናፉ አን እስንትን ህመ፤ ዋን ከዸትናዻን ጋፈተን ሁንደ አከ አርገተን አመና፤ እንስ እስኒፍ ንተአ።</char> <verse eid="MRK 11:24"/><verse number="25" style="v" sid="MRK 11:25"/><char style="wj">ዬሮ ከዸቹፍ ዻበተን፣ አከ አባንኬሰን እን ሰሚራ ጩቡኬሰን እስኒፍ ዺሱፍ፣ እስንስ ዮ ዋኑመ ቶኮሌ ነመ ከምዩራ ቀባተን ዺሳፊ።</char> [ <verse eid="MRK 11:25"/><verse number="26" style="v" sid="MRK 11:26"/><char style="wj">ዮ ዺሱፊ ባተን ገሩ አባንኬሰን እን ሰሚራስ ጩቡኬሰን እስኒፍ ህንዺሱ።”</char>]<note caller="+" style="f"><char style="fr" closed="false">11፥26 </char><char style="ft" closed="false">ወራብሌን ቶኮ ቶኮ ሉቅሳ 26 ህንቀበን።</char></note><verse eid="MRK 11:26"/></para>
  <para style="s1">ታይታን ዬሱስ ጋፊ ኡሜ</para>
  <para style="r">
    <ref loc="MRK 11:27-33">11፥27‑33</ref> ኩወፈ – <char style="xt"><ref loc="MAT 21:23-27">ማቴ 21፥23‑27</ref>፤ <ref loc="LUK 20:1-8">ሉቃ 20፥1‑8</ref></char></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27"/>እሳንስ ዴብአኒ ገረ ዬሩሳሌም ዹፈን፤ ኡቱ ዬሱስ መነ ቁልቁሉማ ኬሰ ዴዴብኣ ጅሩ ሉቦትን ሀንገፎትን፣ በርሲስቶትን ሴራቲፊ ማንጉዶትን ገረሳ ዹፈን። <verse eid="MRK 11:27"/><verse number="28" style="v" sid="MRK 11:28"/>እሳንስ፣ “አት ታይታ ማሊቲን ወንቶተ ከኔን ሆጄተ? አከ ወንቶተ ከኔን ሆጄቱፍስ ኤኙቱ ታይታ ሲፍ ኬኔ?” ጄዸኒን።<verse eid="MRK 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29"/>ዬሱስስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“አንስ ጋፊ ቶኮን እስን ጋፈዸ። እስንሞ ዴቢ ናፍ ኬና፤ አንስ ታይታ ማሊቲን ወንቶተ ከኔን አከን ሆጄዹ እስንትን ህመ።</char> <verse eid="MRK 11:29"/><verse number="30" style="v" sid="MRK 11:30"/><char style="wj">ጩጳን ዮሀንስ ሰሚራ ዹፌሞ ነመ ብራ ዹፌ? ሜ ነት ህማ!”</char><verse eid="MRK 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31"/>እሳንስ ወሊን መርአተኒ አከነ ጄዸን፤ “ዮ ኑ፣ ‘ሰሚራ ዹፌ’ ጄኔ እንሞ፣ ‘ዮስ እስን ማሊፍ እሰ ህንአመንንሬ?’ ጄዼ ኑ ጋፈተ፤ <verse eid="MRK 11:31"/><verse number="32" style="v" sid="MRK 11:32"/>ዮካን፣ ‘ነመ ብራ ዹፌ’ ጄኑ?” ጄዸን። ሰበቢ ነምን ሁንድኑ ዹጉማን ዮሀንስን አከ ራጂት እላሌፍ ኡመተ ሶዳተን።<verse eid="MRK 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 11:33"/>ከናፍ እሳን፣ “ህንቤክኑ” ጄዸኒ ዬሱሲፍ ዴብሰን።</para>
  <para style="p" vid="MRK 11:33">ዬሱስሞ፣ <char style="wj">“አንስ ታይታ ማሊቲን አከን ወንቶተ ከኔን ሆጄዹ እስንት ህንህሙ”</char> ጄዼን።<verse eid="MRK 11:33"/></para>
  <chapter eid="MRK 11"/>
  <chapter number="12" style="c" sid="MRK 12"/>
  <para style="s1">ፈኬኘ ቆቱወኒ</para>
  <para style="r">
    <ref loc="MRK 12:1-12">12፥1‑12</ref> ኩወፈ – <char style="xt"><ref loc="MAT 21:33-46">ማቴ 21፥33‑46</ref>፤ <ref loc="LUK 20:9-19">ሉቃ 20፥9‑19</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1"/>ዬሱስስ አከነ ጄዼ ፈኬኛን እሳንት ዱበቹ ጀልቀቤ፤ <char style="wj">“ነምች ቶኮ እዶ ዻበ ወይኒረ ወይኒ ዻበቴ። እንስ ናኖሳት ደላ እጃሬ፣ ቦለ እት ወይኒ ጩንፈን ቆቴ ቆጢ ኤጉምሳ እጃሬ። ኤርገሲስ እዶ ዻበ ወይኒ ሰነ ቆናን ቡልቶተት ክራ ኬነቴ ብየ ፈጎ ዸቄ።</char> <verse eid="MRK 12:1"/><verse number="2" style="v" sid="MRK 12:2"/><char style="wj">እንስ ዬሮ ምዻን ወልት ቀበሙት አከ እን እጀ እዶ ዻበ ወይኒራ ዋ ፍዱፊፍ ገርብቸ ቶኮ ቆቱወን ሰነት ኤርገቴ።</char> <verse eid="MRK 12:2"/><verse number="3" style="v" sid="MRK 12:3"/><char style="wj">እሳን ገሩ ቀበኒ፣ ቱመኒ ሀርከ ዱዋ ኦፍራ እሰ ዴብሰን።</char> <verse eid="MRK 12:3"/><verse number="4" style="v" sid="MRK 12:4"/><char style="wj">አመሌ ገርብቸ ብራ እሳንት ኤርገቴ፤ እሳንስ መታሳ ቡሩቅሰኒ እሰ ቃኔሰን።</char> <verse eid="MRK 12:4"/><verse number="5" style="v" sid="MRK 12:5"/><char style="wj">አመሌ ገርብቸ ብራ ኤርገቴ፤ እሰስ ንአጄሰን። ገርቦተ ብራ ባይኤስ ኤርገቴ፤ እሳንስ ገርቶኮ ንቱመን፤ ካንሞ ንአጄሰን።</char><verse eid="MRK 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6"/>
    <char style="wj">“አመዩ እን ነመ ኤርጉ ቶኮ ቀበ ቱሬ፤ እንስ እልመሳ ጃለተማዸ። ነምችስ፣ ‘እልመኮ ንከበጁ’ ጄዼ ዹመረት እሰ ኤርገቴ።</char><verse eid="MRK 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7"/>
    <char style="wj">“ቆናን ቡልቶትን ሱን ገሩ፣ ‘ዻልቱን እሰ ከነ። ኮታ እሰ አጄፍና፤ ዻል ሱን ከንኬኘ ተኣቲ’ ወሊን ጄዸን።</char> <verse eid="MRK 12:7"/><verse number="8" style="v" sid="MRK 12:8"/><char style="wj">ከናፉ እሳን ፉዸኒ እሰ አጄሰን፤ እዶ ዻበ ወይኒ ኬሳስ ገድ ባሰኒ እሰ ገተን።</char><verse eid="MRK 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9"/>
    <char style="wj">“ኤጋ አባን እዶ ዻበ ወይኒ ሰና ማል ጎዽነ ላተ? እን ዹፌ ቆቱወን ሰነ ንአጄሰ፤ እዶ ዻበ ወይኒ ሰነስ ነሞተ ብራት ኬነተ።</char> <verse eid="MRK 12:9"/><verse number="10" style="v" sid="MRK 12:10"/><char style="wj">እስን ከተቢ ቁልቁሉ ህንዱብፍኔ? እንስ አከነ ጄዸ፦</char></para>
  <para style="q1" vid="MRK 12:10">
    <char style="wj">“ ‘ዸጋን እጃርቶትን ቱፈተን፣</char></para>
  <para style="q2" vid="MRK 12:10">
    <char style="wj">ዸጋ ጎሌ ተኤረ፤</char><verse eid="MRK 12:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11"/>
    <char style="wj">ከነስ ጎፍታቱ ጎዼ፤</char></para>
  <para style="q2" vid="MRK 12:11">
    <char style="wj">ኩንስ እጀኬኘት ድንቂዸ።’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">12፥11 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="PSA 118:22">ፋር 118፥22</ref>፣<ref loc="PSA 118:23">23</ref></char>
      </char>
    </note>
    <char style="wj">”</char><verse eid="MRK 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12"/>እሳንስ አከ እን እሳኒን ሞርሙዻን ፈኬኘ ሰነ ዱበቴ ዋን ቤከኒፍ እሰ ቀቡ በርባደን። ገሩ ነሞተ ሰነ ሶዳተን፤ ከናፉ እሰ ዺሰኒ ቀጄለን።<verse eid="MRK 12:12"/></para>
  <para style="s1">ዋኤ ግብረ ባሱ</para>
  <para style="r">
    <ref loc="MRK 12:13-17">12፥13‑17</ref> ኩወፈ – <char style="xt"><ref loc="MAT 22:15-22">ማቴ 22፥15‑22</ref>፤ <ref loc="LUK 20:20-26">ሉቃ 20፥20‑26</ref></char></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13"/>ኤርገሲ ዋን እን ዱበቱን እሰ ቀቡፍ ጄዸኒ ፈሪሶታፊ ገሬ ሄሮድስ ኬሳ ጀረ ቶኮ ዬሱስት ኤርገን። <verse eid="MRK 12:13"/><verse number="14" style="v" sid="MRK 12:14"/>እሳንስ ገረሳ ዹፈኒ አከነ ጄዸኒን፤ “ያ በርሲሳ፣ አከ አት ነመ ዹጋ ታቴ ቤክነ። አት ዋን ፉለ ነማ ህንእላሌፍ ነምን ከምዩ ከራራ ስ ህንጀልእሱቲ፤ ገሩ አት ዹጋዻን ከራ ዋቃ በርሲፍተ። ቄሳሪፍ ግብረ ባሱን ኤየመሜረሞ ህንኤየመምኔ? <verse eid="MRK 12:14"/><verse number="15" style="v" sid="MRK 12:15"/>ሃባስኑሞ ሃዺፍኑ?”</para>
  <para style="p" vid="MRK 12:15">ዬሱስ ገሩ ፈኬስቱማሳኒ ቤኬ፣ <char style="wj">“እስን ማሊፍ ነ ቆርቱ? ሜ ዲናሪ</char><note caller="+" style="f"><char style="fr" closed="false">12፥15 </char><char style="fq" closed="false">ዲናሪ </char><char style="ft" closed="false">– ሂካን ቶኮ ቶኮ ሳንትመ ጄዸ። ሳንትምን ማለቃ ኩንስ ሳንትመ ሞቱማ ሮማ ቱሬ። እንስ ፈኪ ፉለ ሞቲ ሮማ ቆፈ ኡቱ ህንተእን ሞርሚ ሞቲን ሱን አመንቲረት ቀቡስ ንሙልእሰ። ፈኬኛፍ ጥባርዮስ ሞትች በረ ሰነ ሳንትመሳረት ከተቢ፣ “ጥባርዮስ ቄሳር፣ እልመ አዉግስጦስ ዋቅቻ” ጄዹ ቀበ ቱሬ (<char style="xt"><ref loc="LUK 3:1">ሉቃ 3፥1</ref></char>)። ፈኪ ፉለ ነማ ሳንትመረት ቀባቹን ፉለ ይሁዶተ አመንቲ ቀበኒ ዱረት ጅብሲሳ ቱሬ። ክታበ ቁልቁሉ ኬሰትስ ዾወሜረ (<char style="xt"><ref loc="EXO 20:4">በኡ 20፥4</ref>፤ <ref loc="DEU 5:8">ኬዴ 5፥8</ref></char>)።</char></note> <char style="wj">ቶኮ ነት ፍዳ ነንእላላ”</char> ጄዼን። <verse eid="MRK 12:15"/><verse number="16" style="v" sid="MRK 12:16"/>እሳንስ ዲናሪ ቶኮ እሰት ፍደን፤ እንስ፣ <char style="wj">“ፈኪን ኩን ከን ኤኙት? ከተቢን ኩንስ ከን ኤኙት?”</char> ጄዼ እሳን ጋፈቴ።</para>
  <para style="p" vid="MRK 12:16">እሳንስ፣ “ከን ቄሳር” ጄዸኒ ዴብሰን።<verse eid="MRK 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17"/>ከነረት ዬሱስ፣ <char style="wj">“ከን ቄሳር ቄሳሪፍ፣ ከን ዋቃሞ ዋቃፍ ኬና”</char> ጄዼን።</para>
  <para style="p" vid="MRK 12:17">እሳንስ እሰ ድንቅፈተን።<verse eid="MRK 12:17"/></para>
  <para style="s1">ጋፊ ዋኤ ዱኣ ከኡ</para>
  <para style="r">
    <ref loc="MRK 12:18-27">12፥18‑27</ref> ኩወፈ – <char style="xt"><ref loc="MAT 22:23-33">ማቴ 22፥23‑33</ref>፤ <ref loc="LUK 20:27-38">ሉቃ 20፥27‑38</ref></char></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18"/>ኤርገሲ ሰዱቆትን፣ ዱኣ ከኡን ህንጅሩ ጄዸን ገረ ዬሱስ ዹፈኒ አከነ ጄዸኒ ጋፊ ቶኮ እሰ ጋፈተን፤ <verse eid="MRK 12:18"/><verse number="19" style="v" sid="MRK 12:19"/>“ያ በርሲሳ ዮ ኦቦሌስ ነመ ቶኮ ኒቲ ፉዼ ኡቱ እጆሌ ህንዸልችን ኒቲሳራ ዱኤ፣ ኦቦሌስሳ ኒቲ ሰነ ዻሌ ኦቦሌሰሳቲፍ ሰኚ ሃዻቡ ጄዼ ሙሴን ኑ በሬሴረ። <verse eid="MRK 12:19"/><verse number="20" style="v" sid="MRK 12:20"/>ኩኖ ኦቦሎተ ቶርበቱ ቱሬ። እን ጀልቀባ ኒቲ ፉዼ ኡቱ እጆሌ ህንዸልችን ዱኤ። <verse eid="MRK 12:20"/><verse number="21" style="v" sid="MRK 12:21"/>እን ለመፋንስ እሼ ፉዼ ኡቱ እጆሌ ህንዸልችን ዱኤ። እን ሰደፋንስ አከሱመ ተኤ። <verse eid="MRK 12:21"/><verse number="22" style="v" sid="MRK 12:22"/>ቶርበንሳኒዩ እጆሌ ህንዸልችኔ። ዹመረት ዱበርትቲንስ ንዱቴ። <verse eid="MRK 12:22"/><verse number="23" style="v" sid="MRK 12:23"/>ጉያ ዱኣ ከኡት እሼን ኒቲ እሰ ከሚ ታት? ቶርበንሳኒዩ እሼ ፉዸኒሩቲ።”<verse eid="MRK 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24"/>ዬሱስሞ አከነ ጄዼ ዴብሴ፤ <char style="wj">“እስን ዋን ከተቢወን ቁልቁሉ ዮካን ሁምነ ዋቃ ህንቤክኔፍ ዶጎጎርቱ ምቲ?</char> <verse eid="MRK 12:24"/><verse number="25" style="v" sid="MRK 12:25"/><char style="wj">ወር ዱአን ዮሙ ዱኣ ከአንት አከ ኤርገሞተ ሰሚ ተኡ መሌ ህንፉዸን፤ ህንሄሩመንስ።</char> <verse eid="MRK 12:25"/><verse number="26" style="v" sid="MRK 12:26"/><char style="wj">ዋኤ ወር ዱአን ዱኣ ከኡ ገሩ አከ ዋቅን ክታበ ሙሴ ኬሰት፣ ደገለ ቦበኡ ብረት፣ ‘አን ዋቀ አብረሃም፣ ዋቀ ይስሃቂፊ ዋቀ ያቆብ’</char><note caller="+" style="f"><char style="fr" closed="false">12፥26 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 3:6">በኡ 3፥6</ref></char></char></note> <char style="wj">ጄዼ እሰት ዱበቴ እስን ህንዱብፍኔ?</char> <verse eid="MRK 12:26"/><verse number="27" style="v" sid="MRK 12:27"/><char style="wj">እን ዋቀ ወረ ጅራተኒት መሌ ዋቀ ወረ ዱአኒ ምት። እስን አከ መሌ ዶጎጎርተኒርቱ።”</char><verse eid="MRK 12:27"/></para>
  <para style="s1">አጀጀ አጀጀ ሁንዱማ ጫሉ</para>
  <para style="r">
    <ref loc="MRK 12:28-34">12፥28‑34</ref> ኩወፈ – <char style="xt"><ref loc="MAT 22:34-40">ማቴ 22፥34‑40</ref></char></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28"/>በርሲስቶተ ሴራ ኬሳ እን ቶኮ ዹፌ ወል ፈልሙሳኒ ዸገኤ። እንስ አከ ዬሱስ ዴቢ ጋሪ እሳኒፍ ኬኔ ሁበቴ፣ “አጀጅን አጀጀወን ሁንደ ጫሉ እሰ ከም?” ጄዼ እሰ ጋፈቴ።<verse eid="MRK 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29"/>ዬሱስስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“አጀጅን አጀጀወን ሁንደ ጫሉ እሰ ከነ፤ ‘ያ እስራኤል ዸገእ! ዋቀዮ ጎፍታንኬኘ ጎፍታ ቶክቸ።</char> <verse eid="MRK 12:29"/><verse number="30" style="v" sid="MRK 12:30"/><char style="wj">ዋቀኬ ጎፍትቸ ገራኬ ጉቱዻን፣ ሉቡኬ ጉቱዻን፣ ያደኬ ጉቱዻን፣ ሁምነኬ ጉቱዻን ጃለዹ።’</char><note caller="+" style="f"><char style="fr" closed="false">12፥30 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 6:4">ኬዴ 6፥4</ref>፣<ref loc="DEU 6:5">5</ref></char></char></note> <verse eid="MRK 12:30"/><verse number="31" style="v" sid="MRK 12:31"/><char style="wj">እን ለመፋንሞ፣ እሰ ከነ፤ ‘ኦላኬ አኩመ ኦፊኬቲት ጃለዹ።’</char><note caller="+" style="f"><char style="fr" closed="false">12፥31 </char><char style="ft" closed="false"><char style="xt"><ref loc="LEV 19:18">ሌዎ 19፥18</ref></char></char></note> <char style="wj">አጀጅን አጀጀወን ከኔን ጫሉ ቶኮዩ ህንጅሩ።”</char><verse eid="MRK 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32"/>በርሲሳን ሴራ ሱንስ አከነ ጄዼ ዴብሴ፤ “ያ በርሲሳ፣ አት ዹጋ ጄቴ፤ ዋቀ ቶክቸ መሌ ዋቅን ብራ ህንጅሩቲ። <verse eid="MRK 12:32"/><verse number="33" style="v" sid="MRK 12:33"/>ገራኬ ጉቱዻን፣ ያደኬ ጉቱዻን፣ ሁምነኬ ጉቱዻን እሰ ጃለቹን፣ ኦላኬስ አኩመ ኦፊኬቲት ጃለቹን፣ ቀልመ ጉበሙፊ ኣርሳ ሁንደ ጫለ።”<verse eid="MRK 12:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34"/>ዬሱስስ ዮሙ አከ እን ሁበትናዻን ዴብሴ አርጌት፣ <char style="wj">“አት ሞቱማ ዋቃራ ፈጎ ህንጅርቱ”</char> ጄዼን። ኤርገሲ ነምን ቶኮዩ ዴብኤ ጋፊ እሰ ጋፈቹፍ እጀ ህንጀባትኔ።<verse eid="MRK 12:34"/></para>
  <para style="s1">ክርስቶስ እልመ ኤኙት?</para>
  <para style="r">
    <ref loc="MRK 12:35-37">12፥35‑37</ref> ኩወፈ – <char style="xt"><ref loc="MAT 22:41-46">ማቴ 22፥41‑46</ref>፤ <ref loc="LUK 20:41-44">ሉቃ 20፥41‑44</ref></char></para>
  <para style="r">
    <ref loc="MRK 12:38-40">12፥38‑40</ref> ኩወፈ – <char style="xt"><ref loc="MAT 23:1-7">ማቴ 23፥1‑7</ref>፤ <ref loc="LUK 20:45-47">ሉቃ 20፥45‑47</ref></char></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35"/>ዬሱስ ኡቱ መነ ቁልቁሉማ ኬሰት በርሲሳ ጅሩ አከነ ጄዼ ጋፈቴ፤ <char style="wj">“በርሲስቶትን ሴራ ማሊፍ ክርስቶስ እልመ ዳዊት ጄዹ?</char> <verse eid="MRK 12:35"/><verse number="36" style="v" sid="MRK 12:36"/><char style="wj">ዳዊት መታንሳዩ ሀፉረ ቁልቁሉዻን ጌጌፈሜ አከነ ጄዼ፦</char></para>
  <para style="q1" vid="MRK 12:36">
    <char style="wj">“ ‘ጎፍትች ጎፍታኮቲን፣</char></para>
  <para style="q2" vid="MRK 12:36">
    <char style="wj">“ሀመ አን ዲኖተኬ፣</char></para>
  <para style="q1" vid="MRK 12:36">
    <char style="wj">ሚለኬ ጀለ ሲፍ ገልቹት፣</char></para>
  <para style="q2" vid="MRK 12:36">
    <char style="wj">ገረ ምርገኮ ታእ።” ’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">12፥36 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="PSA 110:1">ፋር 110፥1</ref>
        </char>
      </char>
    </note><verse eid="MRK 12:36"/></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37"/>
    <char style="wj">ዳዊት መታንሳዩ ‘ጎፍታ’ ጄዼ እሰ ዋመ። ዮስ እን አከምት እልመሳ ተኡ ደንደአሬ?”</char></para>
  <para style="p" vid="MRK 12:37">ቱትን ጉዳን ሱንስ ገመቹዻን እሰ ዸገኤ።<verse eid="MRK 12:37"/></para>
  <para style="s1">በርሲስቶተ ሴራራ ኦፍ ኤገቹ</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38"/>ዬሱስስ ኡቱ በርሲሱ አከነ ጄዼ፤ <char style="wj">“በርሲስቶተ ሴራራ ኦፍ ኤገዻ። እሳን ኡፈተ ዼዼራ ኡፈተኒ ነናነኡፊ ገባ ኬሰትስ ነጋ ጋፈተሙ ጃለቱ፤</char> <verse eid="MRK 12:38"/><verse number="39" style="v" sid="MRK 12:39"/><char style="wj">መኔን ሰገዳ ኬሰት ታኡምሰ ኡልፍና፣ ለፈ ጭዻትሞ እዶ ኡልፍና ጃለቱ።</char> <verse eid="MRK 12:39"/><verse number="40" style="v" sid="MRK 12:40"/><char style="wj">እሳንስ መነ ሃዸ ህዬሳ ሳመኒ ኦንሱ፤ ኦፍ አርግሲሱፍ ጄዸኒስ ከዸትና ዼሬሱ። ነሞትን ኩኔን አደበ ጉዳ አደበሙ።”</char><verse eid="MRK 12:40"/></para>
  <para style="s1">ኬና ሃዸ ህዬሳ</para>
  <para style="r">
    <ref loc="MRK 12:41-44">12፥41‑44</ref> ኩወፈ – <char style="xt"><ref loc="LUK 21:1-4">ሉቃ 21፥1‑4</ref></char></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41"/>ዬሱስስ ፉሌ እዶ ኬናን ካአሙ ታኤ ነሞተ ማለቀሳኒ ምአ ቡሲ ኬሰ ቡሰን እላለ ቱሬ። ሶሬዪን ባይኤንስ ማለቀ ባይኤ ምአ ሰነ ኬሰ ቡሳ ቱረን። <verse eid="MRK 12:41"/><verse number="42" style="v" sid="MRK 12:42"/>ሃት ህዬሳ ህዬቲን ቶኮ ዹፍቴ ሳንትመ ስቢለ ዲማ ጥጥኖ ለመ ከን ገቲንሳ ገረ ሳንትመ ቶኮ ተኤ ምአ ሰነ ኬሰ ቡፍቴ።<verse eid="MRK 12:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 12:43"/>ዬሱስስ በረቶተሳ ኦፍት ዋሜ አከነ ጄዼ፤ <char style="wj">“አን ዹጉመን እስንት ህመ፤ ሃት ህዬሳ ህዬቲን ኩን ወረ ምአ ቡሲ ከነ ኬሰ ኬና ቡሰን ሁንደ ጫላ ቡፍቴርት።</char> <verse eid="MRK 12:43"/><verse number="44" style="v" sid="MRK 12:44"/><char style="wj">እሳን ሁንድ ቀቤኘሳኒራ ኬነን፤ እሼን ገሩ ህዩመሼ ኬሳ ዋን ሁንደ፣ ዋን እቲን ጅራቱ ሁንደ ኬንቴ።”</char><verse eid="MRK 12:44"/></para>
  <chapter eid="MRK 12"/>
  <chapter number="13" style="c" sid="MRK 13"/>
  <para style="s1">መለቶ ዹመ በራ</para>
  <para style="r">
    <ref loc="MRK 13:1-37">13፥1‑37</ref> ኩወፈ – <char style="xt"><ref loc="MAT 24:1-51">ማቴ 24፥1‑51</ref>፤ <ref loc="LUK 21:5-36">ሉቃ 21፥5‑36</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1"/>ኡቱ ዬሱስ መነ ቁልቁሉማቲ በኣ ጅሩ በረቶተሳ ኬሳ እን ቶኮ፣ “ያ በርሲሳ! ዸጋወን ጉርጉዳ ከኔኒፊ ገሞወን በበሬዶ ከኔን ሜ እላል!” ጄዼን።<verse eid="MRK 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2"/>ዬሱስስ፣ <char style="wj">“ገሞወን ጉርጉዳ ከኔን አርግታ? ንዲገመ መሌ አስት ዸጋን ዸጋረት ህንሀፉ”</char> ጄዼን።<verse eid="MRK 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3"/>ኡቱ ዬሱስ ቱሉ ኤጄርሳረ ፉሌ መነ ቁልቁሉማ ታኤ ጅሩ ጴጥሮስ፣ ያቆብ፣ ዮሀንሲፊ እንድሪያስ አከነ ጄዸኒ ኮጳት እሰ ጋፈተን፤ <verse eid="MRK 13:3"/><verse number="4" style="v" sid="MRK 13:4"/>“ሜ ኑት ህም፤ ወንቶትን ኩኔን ዮም ተኡ? መለቶን ዬሮ ወንቶትን ኩኔን ሁንድ እት ራወተመኒ ማል?”<verse eid="MRK 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5"/>ዬሱስስ አከነ እሳኒን ጄቹ ጀልቀቤ፤ <char style="wj">“አከ ነምን ቶኮዩ እስን ህንጎዎምስኔፍ ኦፍ ኤገዻ።</char> <verse eid="MRK 13:5"/><verse number="6" style="v" sid="MRK 13:6"/><char style="wj">ነሞትን ሄዱን፣ ‘አን እሰ’ ጄቻ መቃኮቲን ንዹፉ፤ ነመ ሄዱስ ንጎዎምሱ።</char> <verse eid="MRK 13:6"/><verse number="7" style="v" sid="MRK 13:7"/><char style="wj">እስን ዮሙ ዋኤ ወራናቲፊ ኦዱ ወራና ዸጌሰንት ህንርፈትና። ወን አከና ተኡ ቀባቲ፤ ዹምን ገሩ አመዩ ህንጌኜ።</char> <verse eid="MRK 13:7"/><verse number="8" style="v" sid="MRK 13:8"/><char style="wj">ሰብን ሰበት፣ ሞቱማንስ ሞቱማት ንከአ። ሶቺን ለፋ እዶ ገራ ገራት ንተአ፤ ቤልስ ንቡአ። ኩንስ ጀልቀበ ጭኒንሱ ደኡምሳት።</char><verse eid="MRK 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9"/>
    <char style="wj">“እስን ኦፍ ኤገቹ ቀብዱ። እስን ደበርፈምተኒ ያኢት ንኬነምቱ፤ መኔን ሰገዳ ኬሰትስ ንገረፈምቱ። እስንስ አከ እሳንት ዹገ ባቶተ ታተኒፍ አናፍ ጄተኒ ፉለ ቡልችቶታቲፊ ሞቶታ ዱረ ንዻበቱ።</char> <verse eid="MRK 13:9"/><verse number="10" style="v" sid="MRK 13:10"/><char style="wj">ዱራን ዱርሴ ወንጌል ሰበ ሁንደት ለለበሙ ቀበ።</char> <verse eid="MRK 13:10"/><verse number="11" style="v" sid="MRK 13:11"/><char style="wj">ዮሙ ቀበምተኒ ቆሩምሳፍ ዽኤፈምተንት ዋኤ ዋን ዱበተኒ ዱራን ዱርስተኒ ህንያደእና። ዋኑመ ዬሮ ሰነ እስኒ ኬነሙ ዱበዻ፤ ከን ዱበቱ ሀፉረ ቁልቁሉዸ መሌ እስን ምት።</char><verse eid="MRK 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 13:12"/>
    <char style="wj">“ኦቦሌስ ደበርሴ ኦቦሌሰ ዱአት ኬነ፤ አባን ደበርሴ እጆሌሳ ዱአት ኬነ። እጆሌንስ ወረሳኒት ከአኒ እሳን አጄሱ።</char> <verse eid="MRK 13:12"/><verse number="13" style="v" sid="MRK 13:13"/><char style="wj">ነምን ሁንድኑ ሰበቢ መቃኮቲፍ እስን ጅበ፤ ከን ሀመ ዹማት ጀባቴ ዻበቱ ገሩ ንፈየ።</char><verse eid="MRK 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14"/>
    <char style="wj">“ ‘እስን ዮሙ ወን ጅብሲሳን በዲሰ ፍዱ’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">13፥14 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="DAN 9:27">ዳን 9፥27</ref>፤ <ref loc="DAN 11:31">11፥31</ref>፤ <ref loc="DAN 12:11">12፥11</ref></char>
      </char>
    </note> <char style="wj">ሱን እዶ እሳፍ ህንመሌ ዻበቴ አርግተንት፣ ነምን ዱብሱ ሃሁበቱ፤ ዮሙስ ወር ይሁዳ ኬሰ ጅረን ቱሉወንት ሃበቀተን።</char> <verse eid="MRK 13:14"/><verse number="15" style="v" sid="MRK 13:15"/><char style="wj">ነምን በንቲ መናረ ጅሩ ቶኮዩ ዋን ቶኮሌ ፉዸቹፍ ገድ ህንቡእን ዮካን መነ ህንሴንን።</char> <verse eid="MRK 13:15"/><verse number="16" style="v" sid="MRK 13:16"/><char style="wj">ነምን ለፈ ቆቲሳ ጅሩ ቶኮዩ ኡፈተሳ ፉዸቹፍ ዱበት ህንዴብእን።</char> <verse eid="MRK 13:16"/><verse number="17" style="v" sid="MRK 13:17"/><char style="wj">በረ ሰነ ኬሰ ዱበርቶተ ኡልፋቲፊ ሃዾተ ሆስሰኒፍ ወዮ!</char> <verse eid="MRK 13:17"/><verse number="18" style="v" sid="MRK 13:18"/><char style="wj">ኩንስ አከ ገነ</char><note caller="+" style="f"><char style="fr" closed="false">13፥18 </char><char style="fq" closed="false">ገነ </char><char style="ft" closed="false">– ገን ዬሮ ቦካን ጭማን ሮቤ ለግን ጉቴ ረክነ ኡሙዸ። አከሱመስ አከ ገነ ኬሰ ህርእን ኛታ ጅሩ አርግሲሱ ደንደአ።</char></note> <char style="wj">ኬሰ ህንታኔፍ ከዸዻ!</char> <verse eid="MRK 13:18"/><verse number="19" style="v" sid="MRK 13:19"/><char style="wj">ጉዮተ ሰነ ኬሰ ዽጵን ጀልቀበ ኡመመ ዋቅን ኡሜ ካሴ ሀመ አማት ህንዹፍን፣ ከን ገረ ፉለ ዱራትስ ህንዹፍኔ ንዹፋቲ።</char><verse eid="MRK 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 13:20"/>
    <char style="wj">“ኡቱ ጎፍታን ጉዮተ ሰነ ገባብሱ ባቴ ስላ ነምን ቶኮዩ ህንሀፉ ቱሬ። ገሩ እን ሰበቢ ፍለተምቶተ ፍለቴቲፍ ጄዼ ጉዮተ ሰነ ገባብሴረ።</char> <verse eid="MRK 13:20"/><verse number="21" style="v" sid="MRK 13:21"/><char style="wj">ዬሮ ሰነ ዮ ነምን ከምዩ፣ ‘እላ ክርስቶስ አስ ጅረ!’ ዮካን ‘እላ፣ እን አች ጅረ!’ እስኒን ጄዼ ህንአመንና።</char> <verse eid="MRK 13:21"/><verse number="22" style="v" sid="MRK 13:22"/><char style="wj">ክርስቶሶትን ሶባቲፊ ራጆትን ሶባ ንከኡቲ፤ እሳንስ ዮ ደንደአሜፍ፣ ፍለተምቶተሌ ጎዎምሱፍ ጄዸኒ መለቶፊ ድንቂ ንሆጄቱ።</char> <verse eid="MRK 13:22"/><verse number="23" style="v" sid="MRK 13:23"/><char style="wj">እስን ገሩ ኦፍ ኤገዻ! አን ዋን ሁንደ ዱራን ዱርሴ እስንት ህሜረ።</char><verse eid="MRK 13:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24"/>
    <char style="wj">“በረ ሰነ ኬሰ ገሩ ዽጵነ ሰነ ቦዴ፣</char></para>
  <para style="q1" vid="MRK 13:24">
    <char style="wj">“ ‘አዱን ንዱከኖፍት፤</char></para>
  <para style="q2" vid="MRK 13:24">
    <char style="wj">ጅእስ እፈሼ ህንኬንቱ፤</char><verse eid="MRK 13:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="MRK 13:25"/>
    <char style="wj">ኡርጂወን ሰሚራ ንሀርጨኡ፤</char></para>
  <para style="q2" vid="MRK 13:25">
    <char style="wj">ሁምኖትን ሰሚስ ንራፈሙ።’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">13፥25 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="ISA 13:10">እሳ 13፥10</ref>፤ <ref loc="ISA 34:4">34፥4</ref></char>
      </char>
    </note><verse eid="MRK 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 13:26"/>
    <char style="wj">“ዬሮ ሰነ ነሞትን ኡቱ እልም ነማ ሁምነ ጉዳፊ ኡልፍናን ዱሜሳን ዹፉ ንአርጉ።</char> <verse eid="MRK 13:26"/><verse number="27" style="v" sid="MRK 13:27"/><char style="wj">እንስ ኤርገሞተሳ ኤርጌ ፍለተምቶተሳ ከኔን ሀንዳረወን ለፋራ ሀመ ሀንዳረወን ሰሚወኒት ጅረን ቡቤወን አፍረንራ ወልት ቀበ።</char><verse eid="MRK 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28"/>
    <char style="wj">“ፈኬኘ ከነ ሙከ ሀርቡራ በረዻ፤ ዮሙ ደሜንሳ ለቴ ባለ ባፈቱት አከ ቦን ዽኣቴ ንቤክቱ።</char> <verse eid="MRK 13:28"/><verse number="29" style="v" sid="MRK 13:29"/><char style="wj">አከሱመ እስንስ ዮሙ ወን ኩን ራወተሙሳ አርግተንት አከ እን ዽኣቴ፣ አከ በልበለረስ ገኤ ንቤክቱ።</char> <verse eid="MRK 13:29"/><verse number="30" style="v" sid="MRK 13:30"/><char style="wj">አን ዹጉመ እስንትን ህመ፤ ሀመ ወን ኩን ሁንድ ተኡት ዸሎትን ኩን ህንደርቡ።</char> <verse eid="MRK 13:30"/><verse number="31" style="v" sid="MRK 13:31"/><char style="wj">ሰሚፊ ለፍት ንደርቡ፤ ዱቢንኮ ገሩ ጎንኩማ ህንደርቡ።</char><verse eid="MRK 13:31"/></para>
  <para style="s1">ጉያፊ ሰኣቲን ሱን ህንቤከሙ</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32"/>
    <char style="wj">“ዋኤ ጉያ ሰና ዮካን ዋኤ ሰኣቲ ሰና ገሩ አባ ቆፈቱ ቤከ መሌ ነምን ቶኮዩ ህንቤኩ፤ ኤርገሞትን ሰሚራዩ ህንቤከን፤ ዮካን እልምዩ ህንቤኩ።</char> <verse eid="MRK 13:32"/><verse number="33" style="v" sid="MRK 13:33"/><char style="wj">ኦፍ ኤገዻ! ደመቃስ! ዬሮን ሱን ዮም አከ ተኤ ህንቤክተኒቲ።</char> <verse eid="MRK 13:33"/><verse number="34" style="v" sid="MRK 13:34"/><char style="wj">እንስ ነመ ገርቦተሳት ታይታ ኬኔ፣ ቶኮ ቶኮሳኒትስ ሆጂሳ ኬኔ፣ አከ ገርብች ከረ ኤጉሞ ደመቄ ኤጉ አጀጄ፣ መነሳ ዺሴ ከራ ዼራ ዴሜ ቶኮ ፈካተ።</char><verse eid="MRK 13:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 13:35"/>
    <char style="wj">“ከናፉ እስን ደመቃ፤ ዬሮ እት አባን መነ ሰና ዴብኡ፣ ጄቹንስ ገልገለ ዮካን ሀልከን ወለካ ዮካን እየ እንዳንቆ ዮካን በሪ ኦቦሮ ተኡሳ ህንቤክተኒቲ።</char> <verse eid="MRK 13:35"/><verse number="36" style="v" sid="MRK 13:36"/><char style="wj">ኩንስ አከ እን አኩመ ተሳ ዹፌ ኡቱ ረፍተኑስ እስን ህንአርገትኔፍ።</char> <verse eid="MRK 13:36"/><verse number="37" style="v" sid="MRK 13:37"/><char style="wj">አን ዋነን እስኒን ጄዹ ነመ ሁንዱማን ነንጄዸ፤ ደመቃ!”</char><verse eid="MRK 13:37"/></para>
  <chapter eid="MRK 13"/>
  <chapter number="14" style="c" sid="MRK 14"/>
  <para style="s1">ዬሱስ ቢታንያት ሽቶ ድበሜ</para>
  <para style="r">
    <ref loc="MRK 14:1-11">14፥1‑11</ref> ኩወፈ – <char style="xt"><ref loc="MAT 26:2-16">ማቴ 26፥2‑16</ref></char></para>
  <para style="r">
    <ref loc="MRK 14:1">14፥1</ref>፣<ref loc="MRK 14:2">2</ref>፣<ref loc="MRK 14:10">10</ref>፣<ref loc="MRK 14:11">11</ref> ኩወፈ – <char style="xt"><ref loc="LUK 22:1-6">ሉቃ 22፥1‑6</ref></char></para>
  <para style="r">
    <ref loc="MRK 14:3-8">14፥3‑8</ref> ኩወእ – <char style="xt"><ref loc="JHN 12:1-8">ዮሀ 12፥1‑8</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1"/>ኤጋ ፋሲካፊ አያነ መጥኖቲፍ ጉያ ለመ ቆፈቱ ሀፌ፤ ሉቦትን ሀንገፎትኒፊ በርሲስቶትን ሴራ ሀጡማዻን ዬሱስን ቀበኒ አጄሱፍ መርአቻ ቱረን። <verse eid="MRK 14:1"/><verse number="2" style="v" sid="MRK 14:2"/>እሳንስ፣ “ገሩ አከ ነሞትን ጎሊ ህንካፍኔፍ ዬሮ አያናት ህንተእን” ጄዸን።<verse eid="MRK 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3"/>ኡቱ እን ቢታንያ ኬሰ መነ ስሞን እሰ ለምጣኣ ሰናት ማዲት ዽኣቴ ጅሩ፣ ዱበርቲን ቶኮ ሽቶ ገቲንሳ ጉዳ ተኤ ከን ናርዶስ ቁልቁሉራ ቆጴፈሜ ብልቃጢ አልባስጥሮስት ቀበቴ ዹፍቴ። እሼንስ ብልቃጥቸ ጨብስቴ ሽቶ ሰነ መታሳት ዸንገላፍቴ።<verse eid="MRK 14:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 14:4"/>ነሞተ አች ቱረን ኬሳ ቶኮ ቶኮ ኣረኒ አከነ ወሊን ጄዸን፤ “ሽቶ ከነ በሌሱን ማሊፍ? <verse eid="MRK 14:4"/><verse number="5" style="v" sid="MRK 14:5"/>ስላ ሽቶን ኩን ዲናሪ ዽበ ሰዲ<note caller="+" style="f"><char style="fr" closed="false">14፥5 </char><char style="fq" closed="false">ዲናሪ ዽበ ሰዲ </char><char style="ft" closed="false">– ምንዳ ወጋት ሆጄታ ቶኮፍ ከፈለሙ።</char></note> ኦልት ጉርጉረሜ ማለቀሳ ህዬዪፍ ኬኑን ንደንደአመ ቱሬቲ።” እሳንስ እሼት ዼከመን።<verse eid="MRK 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6"/>ዬሱስ ገሩ አከነ ጄዼ፤ <char style="wj">“እሼ ዺሳ። ማሊፍ እሼ ረክፍቱ? እሼን ዋን ጋሪ ናፍ ጎቴርት።</char> <verse eid="MRK 14:6"/><verse number="7" style="v" sid="MRK 14:7"/><char style="wj">ህዬዪ ዬሮ ሁንደ ኦፍ ብራ ቀብዱ፤ እስን ዬሮ ፌተን ከምትዩ እሳን ገርጋሩ ንደንዴሱ። አነ ገሩ ዬሮ ሁንደ ኦፍ ብራ ህንቀብደን።</char> <verse eid="MRK 14:7"/><verse number="8" style="v" sid="MRK 14:8"/><char style="wj">እሼን ዋን ደንዴሱ ሆጄቴ። እሼን ዱራን ዱርስቴ ዸግነኮ አዋላፍ ድብዴ።</char><note caller="+" style="f"><char style="fr" closed="false">14፥8 </char><char style="fq" closed="false">ዸግነኮ አዋላፍ ድብዴ </char><char style="ft" closed="false">– ይሁዶትን ዮሙ ሬፈ ቶኮ አዋላፍ ቆጴሰንት ሽቶት ፈየደሙ ቱሬ (<char style="xt"><ref loc="MRK 16:1">ማር 16፥1</ref></char>)።</char></note> <verse eid="MRK 14:8"/><verse number="9" style="v" sid="MRK 14:9"/><char style="wj">አን ዹጉመ እስንትን ህመ፤ አዱኛ ሁንደረት፣ እዶ ወንጌል እት ለለበሙ ከምትዩ ወን እሼን ጎቴስ ያደኖሼቲፍ ንኦዴፈመ።”</char><verse eid="MRK 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10"/>ኤርገሲስ ወረ ኩዸ ለማን ኬሳ ቶኮ፣ ይሁዳ አስቆሮትች፣ ዬሱስን ደበርሴ እሳንት ኬኑፍ ጄዼ ገረ ሉቦተ ሀንገፎታ ዸቄ። <verse eid="MRK 14:10"/><verse number="11" style="v" sid="MRK 14:11"/>እሳንስ ዮሙ ዋን ከነ ዸገአንት ገመደኒ፣ ማለቀ እሳፍ ኬኑፍ ዋዳ ገለን። ከናፉ ይሁዳን ደበርሴ እሰ ኬኑፍ ሃለ ምጃኣ ኤገቻ ቱሬ።<verse eid="MRK 14:11"/></para>
  <para style="s1">እርባተ ጎፍታ</para>
  <para style="r">
    <ref loc="MRK 14:12-26">14፥12‑26</ref> ኩወፈ – <char style="xt"><ref loc="MAT 26:17-30">ማቴ 26፥17‑30</ref>፤ <ref loc="LUK 22:7-23">ሉቃ 22፥7‑23</ref></char></para>
  <para style="r">
    <ref loc="MRK 14:22-25">14፥22‑25</ref> ኩወፈ – <char style="xt"><ref loc="1CO 11:23-25">1ቆሮ 11፥23‑25</ref></char></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12"/>ጉያ ጀልቀበ አያነ መጥኖ፣ ዬሮ እት ሆላን ፋሲካ ቀለሙት በረቶትን ዬሱስ፣ “አከ አት ፋሲካ ኛቱፍ ኑ ኤሰ ዸቅኔ አከ ሲፍ ቆጴስኑ በርባደ?” ጄዸኒ እሰ ጋፈተን።<verse eid="MRK 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13"/>እንስ በረቶተሳ ኬሳ ነመ ለመ ኤርጌ፤ አከነስ እሳኒን ጄዼ፤ <char style="wj">“መጋላ ሴና፤ ነምች ኦኮቴ ብሻኒ ባቱ ቶኮ እስንት ዹፈ፤ እሰ ዱካ ቡኣ።</char> <verse eid="MRK 14:13"/><verse number="14" style="v" sid="MRK 14:14"/><char style="wj">አባ መነ ነምች ሱን ሴኑቲንስ፣ ‘በርሲሳን፣ መን ኬሱማኮ፣ እዶን አን እት በረቶተኮ ወጅን ፋሲካ ኛዹ ኤሰ? ጄዼ ጋፈተ’ ጄዻ።</char> <verse eid="MRK 14:14"/><verse number="15" style="v" sid="MRK 14:15"/><char style="wj">አባን መና ሱንስ ደርቢ በልኣ ሚዸግፈሜ ቆጴፈሜ ቶኮ እስንት አርግሲሰ። እስንስ አችት ኑፍ ቆጴሳ።”</char><verse eid="MRK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16"/>በረቶትንስ ከአኒ መጋላ ሰነ ሴነኒ አኩመ ዬሱስ እሳንት ህሜ ሰነት አርገተን። ፋሲካስ ንቆጴሰን።<verse eid="MRK 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17"/>ዬሱስስ ዮሙ ገልገላኤት ወረ ኩዸ ለማን ወጅን አች ገኤ። <verse eid="MRK 14:17"/><verse number="18" style="v" sid="MRK 14:18"/>ኡቱ እሳን ማዲት ዽኣተኒ ጅረኑ ዬሱስ፣ <char style="wj">“አን ዹጉመ እስንት ነንህመ፤ እስን ኬሳ ቶኮ፣ ከን አመ ነ ወጅን ኛቹት ጅሩ ደበርሴ ነ ኬነ”</char> ጄዼን።<verse eid="MRK 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19"/>እሳንስ ገደኒ፣ ቶኮ ቶኮን፣ “ነ ተእና ላተ?” ጄቹ ጀልቀበን።<verse eid="MRK 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20"/>እንስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“ነምች ሱን ወረ ኩዸ ለማን ኬሳ ቶኮዸ። እንስ እሰ ነ ወጅን ገበቴ ኬሳ ጩጰቱዸ።</char> <verse eid="MRK 14:20"/><verse number="21" style="v" sid="MRK 14:21"/><char style="wj">እልም ነማ አኩመ ዋኤንሳ በሬፈሜ ሰነት ንዴመ። ገሩ ነምቸ ደበርሴ እልመ ነማ ኬኑ ሰናፍ ወዮ! እን ኡቱ ዸለቹ ባቴ እሳፍ ወየ ቱሬ።”</char><verse eid="MRK 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22"/>ኡቱ ኛቻ ጅረኑስ ዬሱስ ቡዴነ ፉዼ ኤብሴ፤ ጨጨብሴስ፣ <char style="wj">“ፉዸዻ፤ ኩን ፎንኮት”</char> ጄዼ እሳኒፍ ኬኔ።<verse eid="MRK 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23"/>ጦፎስ ፉዼ ገለተ ገልቼ እሳኒፍ ኬኔ፤ ሁንድሳኒስ ጦፎ ሰነራ ዹገን።<verse eid="MRK 14:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 14:24"/>እንስ አከነ እሳኒን ጄዼ፤ <char style="wj">“ኩን ዺገኮ፣ ዺገ ከኩ ሃራ ከን ነሞተ ባይኤፍ ዸንገላፈሙዸ።</char> <verse eid="MRK 14:24"/><verse number="25" style="v" sid="MRK 14:25"/><char style="wj">አን ዹጉመ እስንት ነንህመ፤ አን ሀመን ጉያ ሰነ ሞቱማ ዋቃ ኬሰት ዴብኤ ዹጉት እጀ ወይኒ ከነራ ዴብኤ ህንዹጉ።”</char><verse eid="MRK 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26"/>እሳንስ ኤርገ ፋርፈትና ፋርፈተኒ ቦዴ ቱሉ ኤጄርሳት ቀጄለን።<verse eid="MRK 14:26"/></para>
  <para style="s1">ዬሱስ አከ ጴጥሮስ እሰ ገኑ ዱራን ዱርሴ ዱበቴ</para>
  <para style="r">
    <ref loc="MRK 14:27-31">14፥27‑31</ref> ኩወፈ – <char style="xt"><ref loc="MAT 26:31-35">ማቴ 26፥31‑35</ref></char></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27"/>ዬሱስ አከነ እሳኒን ጄዼ፤ <char style="wj">“ሁንድኬሰን ንጉፈቱ፤ አከነ ጄዸሜ በሬፈሜራቲ፦</char></para>
  <para style="q1" vid="MRK 14:27">
    <char style="wj">“ ‘አን ትክሴ ነንሩኩተ፤</char></para>
  <para style="q2" vid="MRK 14:27">
    <char style="wj">ሆሎትንስ ንብትኔፈሙ።’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">14፥27 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="ZEC 13:7">ዘካ 13፥7</ref>
        </char>
      </char>
    </note><verse eid="MRK 14:27"/></para>
  <para style="m">
    <verse number="28" style="v" sid="MRK 14:28"/>
    <char style="wj">አን ገሩ ኤርገን ዱኣ ከኤ ቦዴ እስን ዱረ ገሊላ ነንዸቀ።”</char><verse eid="MRK 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29"/>ጴጥሮስ ገሩ፣ “ዮ ነምን ሁንድኑ ጉፈቴዩ አን ህንጉፈዹ” ጄዼን።<verse eid="MRK 14:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30"/>ዬሱስሞ ዴብሴ፣ <char style="wj">“አን ዹጉመ ስት ነንህመ፤ አት ሀርአ፣ ኤደኑመ ኡቱ እንዳንቆን ዬሮ ለመ ህንእይን፣ ዬሮ ሰዲ ነ ገንተ”</char> ጄዼን።<verse eid="MRK 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31"/>ጴጥሮስ ገሩ፣ “አን ዮን ስ ወጅን ዱኡ ቀባዼሌ ጎንኩማ ስ ህንገኑ” ጄዼ ጀቤሴ ዱበቴ። ሁንድሳኒስ አከሱመ ጄዸን።<verse eid="MRK 14:31"/></para>
  <para style="s1">ጌቴሴማኒ</para>
  <para style="r">
    <ref loc="MRK 14:32-42">14፥32‑42</ref> ኩወፈ – <char style="xt"><ref loc="MAT 26:36-46">ማቴ 26፥36‑46</ref>፤ <ref loc="LUK 22:40-46">ሉቃ 22፥40‑46</ref></char></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32"/>እሳንስ እዶ ጌቴሴማኒ ጄዸሙ ቶኮ ዸቀን፤ ዬሱስስ በረቶተሳቲን፣ <char style="wj">“ሀመ አን ከዸዹት እስን አስ ታኣ”</char> ጄዼ። <verse eid="MRK 14:32"/><verse number="33" style="v" sid="MRK 14:33"/>እንስ ጴጥሮስን፣ ያቆቢፊ ዮሀንስን ኦፍ ፋነ ፉዸቴ፣ አከ መሌ ዽጰቹፊ ያደኡስ ጀልቀቤ። <verse eid="MRK 14:33"/><verse number="34" style="v" sid="MRK 14:34"/>እንስ፣ <char style="wj">“ሉቡንኮ አከ መሌ ገድቴ ዱኡ ጌሴርት። እስን አሱመ ቱራቲ ደመቃ”</char> ጄዼን።<verse eid="MRK 14:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35"/>እንስ ጥኖ አች ሂቄ ለፈት ጎምብፈሜ፣ ዮ ደንደአሜ አከ ሰኣቲን ሱን እሰረ ደርብቱፍ ከዸቴ። <verse eid="MRK 14:35"/><verse number="36" style="v" sid="MRK 14:36"/>እንስ፣ <char style="tl"><char style="wj">“ኣባ፣</char></char><note caller="+" style="f"><char style="fr" closed="false">14፥36 </char><char style="ft" closed="false">አፋን አራማይኪቲን </char><char style="fqa" closed="false">አባ </char><char style="ft" closed="false">ጄቹዸ።</char></note> <char style="wj">ያ አባ፣ ወን ሁንድኑ ሲፍ ንደንደአመ። ጦፎ ከነ ነራ ፉዽ። ገሩ አከ ፌዺኬቲ መሌ አከ ፌዺኮቲ ህንተእን”</char> ጄዼ።<verse eid="MRK 14:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37"/>እንስ ገረ በረቶተሳት ዴብኤ ኡቱ ረፈኑ እሳን አርጌ። ጴጥሮሲንስ አከነ ጄዼ፤ <char style="wj">“ስሞን፣ አት አመሌ እኑመ ረፍታ? ሰኣቲ ቶክቲሌ ደመቁ ህንደንዴኜ?</char> <verse eid="MRK 14:37"/><verse number="38" style="v" sid="MRK 14:38"/><char style="wj">እስን አከ ቆሩምሰት ህንገሌፍ ደመቃ ከዸዻ። ሀፉር ቆጳኣዸ፤ ፎን ገሩ ደዸባዸ።”</char><verse eid="MRK 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39"/>አመስ አች ሂቄ ዋኑመ ዱራን ከዸቴ ሰነ ከዸቴ። <verse eid="MRK 14:39"/><verse number="40" style="v" sid="MRK 14:40"/>እን ዮሙ ዴብኤ ዹፌት፣ አመስ ኡቱ ረፈኑ እሳን አርጌ፤ እጅሳኒ እት ኡልፋቴ ቱሬቲ። እሳንስ አከ ማል ጄዸኒ ዴብሰኒፍ ህንቤክኔ።<verse eid="MRK 14:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41"/>ዬሮ ሰደፋስ ዴብኤ አከነ ጄዼን፤ <char style="wj">“እስን አመዩ ረፍተኒ ቦቆቻ ጅርቱ? ንገአ! ሰኣቲን ሱን ገኤረ። ኩኖ፣ እልም ነማ ደበርፈሜ ሀርከ ጩበሞታት ንኬነመ።</char> <verse eid="MRK 14:41"/><verse number="42" style="v" sid="MRK 14:42"/><char style="wj">ከኣ ንዴምና! ኩኖ፣ ነምች ደበርሴ ነ ኬኑ ሱን ዹፋ ጅረ።”</char><verse eid="MRK 14:42"/></para>
  <para style="s1">ዬሱስ ቀበሙሳ</para>
  <para style="r">
    <ref loc="MRK 14:43-50">14፥43‑50</ref> ኩወፈ – <char style="xt"><ref loc="MAT 26:47-56">ማቴ 26፥47‑56</ref>፤ <ref loc="LUK 22:47-50">ሉቃ 22፥47‑50</ref>፤ <ref loc="JHN 18:3-11">ዮሀ 18፥3‑11</ref></char></para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43"/>ኡቱመ እን ዱበቻ ጅሩስ፣ ይሁዳን ነምች ወረ ኩዸ ለማን ኬሳ ቶኮ ተኤ ሱን ዹፌ። ቱትን ሉቦተ ሀንገፎተ፣ በርሲስቶተ ሴራቲፊ ማንጉዶተ ብራ ኤርገሜስ ጎራዴፊ ቦኩ ቀበቴ እሰ ወጅን ዹፌ።<verse eid="MRK 14:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MRK 14:44"/>እን ደበርሴ ዬሱስን ኬኑ ሱንስ፣ “ነምች አን ዹንገዹ እሰ፤ እስንስ እሰ ቀባቲ ኤጋ እሰ ፉዻ ዴማ” ጄዼ መለቶ ኬኔፊ ቱሬ። <verse eid="MRK 14:44"/><verse number="45" style="v" sid="MRK 14:45"/>ይሁዳንስ ዮሙሱመ ዬሱስት ዽኣቴ፣ “ያ በርሲሳ!” ጄዼ እሰ ዹንገቴ። <verse eid="MRK 14:45"/><verse number="46" style="v" sid="MRK 14:46"/>ነሞትን ሱን ዬሱስን ቀበኒ ህዸን። <verse eid="MRK 14:46"/><verse number="47" style="v" sid="MRK 14:47"/>ወረ አች ዸዻበቻ ቱረን ኬሳ እን ቶኮ ገሩ ጎራዴሳ ሉቅፈቴ ገርብቸ ሉበ ኦል ኣና ዸኤ ጉረሳ እራ ኩቴ።<verse eid="MRK 14:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 14:48"/>ዬሱስስ አከነ ጄዼ፤ <char style="wj">“እስን ጎራዴፊ ቦኩ ቀበተኒ አከ ነመ ሀቱ ቀቡት ነ ቀቡ ዹፍተኒ?</char> <verse eid="MRK 14:48"/><verse number="49" style="v" sid="MRK 14:49"/><char style="wj">አን ጉዩመ ጉያን መነ ቁልቁሉማ ኬሰት በርሲሳ እስን ወጅን ቱሬ፤ እስንስ ነ ህንቀብኔ። ገሩ ከተቢወን ቁልቁሉን ራወተሙ ቀቡ።”</char> <verse eid="MRK 14:49"/><verse number="50" style="v" sid="MRK 14:50"/>እሳን ሁንድኑስ እሰ ዺሰኒ በቀተን።<verse eid="MRK 14:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51"/>ደርገጌስ ቶኮስ ኡፈተ ቁንጬ ተልባራ ሆጄተሜ ቶኮ ቁላሳረ ቡፈቴ ዬሱስ ፋነ ዴማ ቱሬ። ዬሮ እሰ ቀበንትስ፣ <verse eid="MRK 14:51"/><verse number="52" style="v" sid="MRK 14:52"/>ደርገጌስ ሱን ኡፈተሳ ዺሴ፣ ቁላሳ ሀርካ በኤ።<verse eid="MRK 14:52"/></para>
  <para style="s1">ዬሱስ ያኢ ዱረት</para>
  <para style="r">
    <ref loc="MRK 14:53-65">14፥53‑65</ref> ኩወፈ – <char style="xt"><ref loc="MAT 26:57-68">ማቴ 26፥57‑68</ref>፤ <ref loc="JHN 18:12">ዮሀ 18፥12</ref>፣<ref loc="JHN 18:13">13</ref>፣<ref loc="JHN 18:19-24">19‑24</ref></char></para>
  <para style="r">
    <ref loc="MRK 14:61-63">14፥61‑63</ref> ኩወፈ – <char style="xt"><ref loc="LUK 22:67-71">ሉቃ 22፥67‑71</ref></char></para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53"/>እሳንስ ዬሱስን ሉበ ኦል ኣናት ጌሰን፤ ሉቦትን ሀንገፎትን፣ ማንጉዶትኒፊ በርሲስቶትን ሴራ ሁንድኑ ወልት ቀበመን። <verse eid="MRK 14:53"/><verse number="54" style="v" sid="MRK 14:54"/>ጴጥሮስስ ሀመ ደላ ሉበ ኦል ኣና ኬሳት ፈጎት እሰ ዱካ ቡኤ። እንስ ዋርድዮተ ወጅን እብደ ብረ ታኤ ቀቃመቻ ቱሬ።<verse eid="MRK 14:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MRK 14:55"/>ሉቦትን ሀንገፎትኒፊ ያኢን ጉቱን ዬሱስን አጄሱፍ ጄዸኒ ረጋ እሰት በርባዳ ቱረን፤ እሳን ገሩ ሆማ ህንአርገትኔ። <verse eid="MRK 14:55"/><verse number="56" style="v" sid="MRK 14:56"/>ነሞትን ባይኤን ሶባን እሰት ዹጋ በአን፤ ዹገ በኡምስሳኒ ገሩ ቶኮ ህንታኔ።<verse eid="MRK 14:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57"/>ቶኮ ቶኮሞ ከአኒ አከነ ጄዻኒ ሶባን እሰት ዹጋ በአን፦ <verse eid="MRK 14:57"/><verse number="58" style="v" sid="MRK 14:58"/>“ ‘መነ ቁልቁሉማ ከን ሀርከ ነማቲን እጃረሜ ከነ ዲጌ ከን ብራ ከን ሀርከ ነማቲን ህንእጃረምን ጉያ ሰዲ ኬሰት ዴብሴ ነንእጃረ’ ጄቹሳ ዸጌኜረ።” <verse eid="MRK 14:58"/><verse number="59" style="v" sid="MRK 14:59"/>ሃተኡ መሌ ዹገ በኡምስሳኒ አመሌ ቶኮ ህንታኔ።<verse eid="MRK 14:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60"/>ሉብች ኦል ኣናንስ ከኤ ፉለሳኒ ዱረ ዻበቴ፣ “አት ዴቢ ቶኮሌ ህንኬንቱ? ወን ነሞትን ኩኔን ዹጋ ስት በአን ኩን ማል?” ጄዼ ዬሱስን ጋፈቴ። <verse eid="MRK 14:60"/><verse number="61" style="v" sid="MRK 14:61"/>ዬሱስ ገሩ እኑመ ጨልእሴ መሌ ዴቢ ቶኮሌ ህንኬንኔ።</para>
  <para style="p" vid="MRK 14:61">ሉብች ኦል ኣናን አመስ፣ “ክርስቶስ እልም እሰ ኤብፈማ ሰና ሲ?” ጄዼ እሰ ጋፈቴ።<verse eid="MRK 14:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62"/>ዬሱስስ፣ <char style="wj">“ኤዬ አነ፤ እስን ኡቱ እልም ነማ ከራ ምርገ ሁምነ ቀቤሰ ሰናቲን ታኤ፣ ዱሜሰ ሰሚቲን ዹፉ ንአርግቱ”</char> ጄዼ።<verse eid="MRK 14:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63"/>ሉብች ኦል ኣናን ኡፈተሳ ተርሳሴ አከነ ጄዼ፤ “ከነ ጫላ ዹገ ባቶተ ማሊ ኑ በርባችሰ? <verse eid="MRK 14:63"/><verse number="64" style="v" sid="MRK 14:64"/>ዋቀ አረብሱሳ እስንዩ ዸጌሰኒርቱ። ማል እስንት ፈካተ?”</para>
  <para style="p" vid="MRK 14:64">ሁንድሳኒስ ዱአቱ እሳፍ መለ ጄዸኒ እሰት ሙረን። <verse eid="MRK 14:64"/><verse number="65" style="v" sid="MRK 14:65"/>ነሞትን ቶኮ ቶኮ እሰት ቱፉ ጀልቀበን፤ ፉለሳስ ሀጉገኒ አቦቴን እሰ ሩኩተኒ፣ “ሜ ራጂ ዱበዹ!” ጄዸን። ኤግዶትንስ ፉዸኒ እሰ ከከበለን።<verse eid="MRK 14:65"/></para>
  <para style="s1">ጴጥሮስ ዬሱስን ገኑሳ</para>
  <para style="r">
    <ref loc="MRK 14:66-72">14፥66‑72</ref> ኩወፈ – <char style="xt"><ref loc="MAT 26:69-75">ማቴ 26፥69‑75</ref>፤ <ref loc="LUK 22:56-62">ሉቃ 22፥56‑62</ref>፤ <ref loc="JHN 18:16-18">ዮሀ 18፥16‑18</ref>፣<ref loc="JHN 18:25-27">25‑27</ref></char></para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66"/>ኡቱ ጴጥሮስ ደላ ሰነ ኬሰ ገረ ገዲ ጅሩ ጦምቦሬወን ሉበ ኦል ኣና ኬሳ ቶኮ ዹፍቴ። <verse eid="MRK 14:66"/><verse number="67" style="v" sid="MRK 14:67"/>እሼን ኡቱ ጴጥሮስ እብደ ቀቃመቱ አርግቴ፤ ሁበቴስ እሰ እላልቴ።</para>
  <para style="p" vid="MRK 14:67">እሼንስ፣ “አትስ ዬሱስ ነመ ናዝሬት ሰነ ወጅን ቱርቴ” ጄቴን።<verse eid="MRK 14:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68"/>እን ገሩ፣ “አን ዋን አት ጄቱ ህንቤኩ፤ ናፍ ህንገሉስ” ጄዼ ገኔ። ከረ ደላቲንስ ገድ በኤ፤ እንዳንቆንስ ንእዬ።<verse eid="MRK 14:68"/></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69"/>ጦምቦሬን ሱን አመስ እሰ አርግቴ ወረ አች ዸዻበተኒን፣ “ነምች ኩን ጀረ ኬሳ ቶኮዸ” ጄቴ። <verse eid="MRK 14:69"/><verse number="70" style="v" sid="MRK 14:70"/>እን ገሩ አመስ ንገኔ።</para>
  <para style="p" vid="MRK 14:70">ዬሮ ጥኖ ቦዴሞ ወር አች ዸዻበቻ ቱረን ጴጥሮሲን፣ “አትስ ነመ ገሊላ ዋን ታቴፍ ዹጉመዩ ጀረ ኬሳ ቶኮዸ!” ጄዸኒን።<verse eid="MRK 14:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71"/>እንስ፣ “አን ነምቸ እስን ዋኤሳ ዱበተን ከነ ህንቤኩ” ጄዼ ኦፍ አባሩፊ ከከቹ ጀልቀቤ።<verse eid="MRK 14:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72"/>ዮሙሱመ እንዳንቆን ለመተ እዬ። ጴጥሮስስ ዱቢ ዬሱስ፣ <char style="wj">“ኡቱ እንዳንቆን ዬሮ ለመ ህንእይን፣ አት ዬሮ ሰዲ ነ ገንተ”</char> እሳን ጄዼ ቱሬ ሰነ ያደቴ ቦኤ።<verse eid="MRK 14:72"/></para>
  <chapter eid="MRK 14"/>
  <chapter number="15" style="c" sid="MRK 15"/>
  <para style="s1">ዬሱስ ፉለ ጲላጦስ ዱረት</para>
  <para style="r">
    <ref loc="MRK 15:2-15">15፥2‑15</ref> ኩወፈ – <char style="xt"><ref loc="MAT 27:11-26">ማቴ 27፥11‑26</ref>፤ <ref loc="LUK 23:2">ሉቃ 23፥2</ref>፣<ref loc="LUK 23:3">3</ref>፣<ref loc="LUK 23:18-25">18‑25</ref>፤ <ref loc="JHN 18:29-19:16">ዮሀ 18፥29–19፥16</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1"/>ገነመ በሪ ሉቦትን ሀንገፎትን፣ ማንጉዶተ፣ በርሲስቶተ ሴራቲፊ ጉቱማ ያኢ ይሁዶታ ወጅን መርአተኒ ዬሱስን ህዸኒ፣ ጌሰኒ ጲላጦስት ደበርሰኒ ኬነን።<verse eid="MRK 15:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 15:2"/>ጲላጦስስ፣ “አት ሞቲ ይሁዶታቲ?” ጄዼ እሰ ጋፈቴ።</para>
  <para style="p" vid="MRK 15:2">ዬሱስሞ፣ <char style="wj">“አቱ ጄቴካ!”</char> ጄዼ ዴብሴ።<verse eid="MRK 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3"/>ሉቦትን ሀንገፎትን ዋን ባይኤዻን እሰ ህመተን። <verse eid="MRK 15:3"/><verse number="4" style="v" sid="MRK 15:4"/>ጲላጦስ አመሌ፣ “አት ዴቢ ቶኮሌ ህንኬንቱ? እሳን ዋን ሜቃን አከ ስህመተን ሜ እላል” ጄዼ እሰ ጋፈቴ።<verse eid="MRK 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5"/>ዬሱስ ገሩ አመሌ ዴቢ ቶኮዩ ህንኬንኔ፤ ጲላጦስስ ንድንቅሲፈቴ።<verse eid="MRK 15:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6"/>እንስ ነመ ህዸሜ ከን ሰብን ጋፈቴ ቶኮ ጉያ አያና ሁንደ ገድ ዺሰ ቱሬ። <verse eid="MRK 15:6"/><verse number="7" style="v" sid="MRK 15:7"/>ነምች በረባስ ጄዸሙ ቶኮ ፍንጭልቶተ ጎሊ ካሰኒ ነመ አጄሰን ወጅን መነ ህዻ ኬሰ ቱሬ። <verse eid="MRK 15:7"/><verse number="8" style="v" sid="MRK 15:8"/>ኡመትን ሱንስ ጲላጦስ ብረ ዸቄ አከ እን ዋን ዱራን ጎቻፊ ቱሬ ሰነ እሳኒ ጎዹ እሰ ከዸቴ።<verse eid="MRK 15:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 15:9"/>ጲላጦስ ገሩ፣ “አከ አን ሞቲ ይሁዶታ ገድ እስኒ ዺሱ በርባዱ?” ጄዼ ጋፈቴ፤ <verse eid="MRK 15:9"/><verse number="10" style="v" sid="MRK 15:10"/>እን አከ ሉቦትን ሀንገፎትን ህናፋዻን ዬሱስን ደበርሰኒ እሰት ኬነን ንቤከ ቱሬቲ። <verse eid="MRK 15:10"/><verse number="11" style="v" sid="MRK 15:11"/>ሉቦትን ሀንገፎትን ገሩ አከ ጲላጦስ ቆደ ዬሱስ በረባስን ገድ ዺሱ አከ እሰ ከዸተኒፍ ነሞተ ከካሰን።<verse eid="MRK 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 15:12"/>ጲላጦስስ፣ “ዮስ ነምቸ እስን ሞቲ ይሁዶታ ጄተኒን ከነ ማል ጎዹሬ?” ጄዼ አመሌ እሳን ጋፈቴ።<verse eid="MRK 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13"/>እሳን አመሌ፣ “እሰ ፈንስ!” ጄዸኒ እየን።<verse eid="MRK 15:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14"/>ጲላጦስሞ፣ “ማሊፍ? እን የከ ማሊ ሆጄቴ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="MRK 15:14">እሳን ገሩ እቱመ ጫልችሰኒ፣ “እሰ ፈንስ!” ጄዸኒ እየን።<verse eid="MRK 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15"/>ከናፉ ጲላጦስ ነሞተ ገመቺሱፍ ጄዼ በረባስን ገድ እሳኒፍ ዺሴ። ዬሱስን ገሩ ገረፍሲሴ አከ እን ፈንፈሙፍ ደበርሴ ኬኔ።<verse eid="MRK 15:15"/></para>
  <para style="s1">ሎልቶትን ዬሱስት ቆሱሳኒ</para>
  <para style="r">
    <ref loc="MRK 15:16-20">15፥16‑20</ref> ኩወፈ – <char style="xt"><ref loc="MAT 27:27-31">ማቴ 27፥27‑31</ref></char></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16"/>ኤርገሲ ሎልቶትን ዬሱስን መነ ቡልቻት፣ ጄቹንስ <char style="tl">ፕራይቶርዮንት</char> ኦል ገልቸን፤ ራያ ሎልቶታ ሁንደስ ወልት ዋመን። <verse eid="MRK 15:16"/><verse number="17" style="v" sid="MRK 15:17"/>ኡፈተ ዺልጌ<note caller="+" style="f"><char style="fr" closed="false">15፥17 </char><char style="fq" closed="false">ኡፈተ ዺልጌ </char><char style="fqa" closed="false">(ቡሌ ዲማ) </char><char style="ft" closed="false">– ኡፈተ ሎልቶተ ሮማ ከን ወያ ካንረት ኡፈተሙ።</char></note> እት ኡፍሰን፤ ጎንፎ ቆራቲስ ምጪረኒ ዸአኒ እሰረ ካአን። <verse eid="MRK 15:17"/><verse number="18" style="v" sid="MRK 15:18"/>እሳንስ፣ “አከምሬ፣ ያ ሞቲ ይሁዶታ!” ጄዸኒ ነጋ እሰ ጋፈቹ ጀልቀበን። <verse eid="MRK 15:18"/><verse number="19" style="v" sid="MRK 15:19"/>ኡሌዻንስ መታሳ ሩኩተን፤ እሰትስ ቱፈን። ጅልቤንፈተኒስ ሰገደኒፍ። <verse eid="MRK 15:19"/><verse number="20" style="v" sid="MRK 15:20"/>ኤርገ እት ቆሰኒ ቦዴ ኡፈተ ዲማ ዺልጌ ሰነ እራ ባሰኒ ወያሳ ዴብሰኒ እሰት ኡፍሰን። ፈንሱፍስ እሰ ፉዸኒ ዴመን።<verse eid="MRK 15:20"/></para>
  <para style="s1">ዬሱስ ፈንፈሙሳ</para>
  <para style="r">
    <ref loc="MRK 15:22-32">15፥22‑32</ref> ኩወፈ – <char style="xt"><ref loc="MAT 27:33-44">ማቴ 27፥33‑44</ref>፤ <ref loc="LUK 23:33-43">ሉቃ 23፥33‑43</ref>፤ <ref loc="JHN 19:17-24">ዮሀ 19፥17‑24</ref></char></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21"/>እሳንስ ነምቸ ቀሬና<note caller="+" style="f"><char style="fr" closed="false">15፥21 </char><char style="ft" closed="false">ቀሬናን መጋላ ግሪክ ከን ቀርቀረ ካበ አፍሪካ ናኖ ሀርአ ሊብያ ጄዸሙት አርገሙዸ።</char></note> ከን ስሞን ጄዸሙ ቶኮ ኡቱ እን ባድያዻ ዹፌ አቺን ደርባ ጅሩ አርገኒ አከ እን ፈኖ ዬሱስ ባቱፍ እሰ ድርቅሲሰን። ነምች ኩንስ አባ አሌክስንድሮሲፊ ሩፎስት። <verse eid="MRK 15:21"/><verse number="22" style="v" sid="MRK 15:22"/>እሳንስ እዶ ጎልጎታ ጄዸሙት ዬሱስን ጌሰን፤ ጎልጎታ ጄቹን “እዶ ቡቄ መታ” ጄቹዸ። <verse eid="MRK 15:22"/><verse number="23" style="v" sid="MRK 15:23"/>ጀርስ አከ እን ዳዺ ወይኒ ከን ቁምቢን ወልት መከሜ ዹጉፍ ኬነኒፍ፤ እን ገሩ ፉዸቹ ድዴ። <verse eid="MRK 15:23"/><verse number="24" style="v" sid="MRK 15:24"/>እሳንስ እሰ ፈንሰን። ኡፈተሳስ ገርገር ቆደተኒ ቶኮን ቶኮን ነማ ማል አከ አርገቱ ሙርቴሱፍ እጣ ቡፈተን።<verse eid="MRK 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 15:25"/>ዬሮን እሳን እት እሰ ፈንሰንስ ገነመ ሰኣቲ ሰዲ ቱሬ። <verse eid="MRK 15:25"/><verse number="26" style="v" sid="MRK 15:26"/>ከተቢን ዋን እን እቲን ህመተሜ ከን፣</para>
  <para style="pc" vid="MRK 15:26">ሞትቸ ይሁዶታ</para>
  <para style="m" vid="MRK 15:26">ጄዹ መታሳቲን ኦል ቱሬ።<verse eid="MRK 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 15:27"/>ሀቶተ ለመስ፣ እሰ ቶኮ ምርገሳቲን፣ ካንሞ ብታሳቲን እሰ ወጅን ፈንሰን። [ <verse eid="MRK 15:27"/><verse number="28" style="v" sid="MRK 15:28"/>ከናንስ ዱቢን ክታብን፣ “እን አከ ሴረ ጨብስቶታት ሄደሜ” ጄዹ ሱን ንራወተሜ።]<note caller="+" style="f"><char style="fr" closed="false">15፥28 </char><char style="ft" closed="false">ወራብሌን ቶኮ ቶኮ ሉቅሳ 28 ህንቀበን።</char></note> <verse eid="MRK 15:28"/><verse number="29" style="v" sid="MRK 15:29"/>ወር አቺን ደርበንስ እሰ አረብሰን፤ መታሳኒስ ራሰኒ፣ “ሙ! አት ከን መነ ቁልቁሉማ ዲግዴ ጉያ ሰዲት እጃርቱ፣ <verse eid="MRK 15:29"/><verse number="30" style="v" sid="MRK 15:30"/>ሜ ፈኖራ ገድ ቡኢቲ ኦፍ ኦልች!” ጄዸን። <verse eid="MRK 15:30"/><verse number="31" style="v" sid="MRK 15:31"/>አከሱመስ ሉቦትን ሀንገፎትኒፊ በርሲስቶትን ሴራ ወጅን እት ቆሰን። አከነስ ጄዸን፤ “እን ወረ ካን ኦልቼረ፤ ኦፊሳ ገሩ ኦልቹ ህንደንደኡ! <verse eid="MRK 15:31"/><verse number="32" style="v" sid="MRK 15:32"/>አከ ኑ አርግኔ አመኑፍ ክርስቶስ ሞትች እስራኤል ኩን ሜ አመ ፈኖራ ገድ ሃቡኡ።” ወር እሰ ወጅን ፈንፈመንስ እሰ አረብሰን።<verse eid="MRK 15:32"/></para>
  <para style="s1">ዬሱስ ዱኡሳ</para>
  <para style="r">
    <ref loc="MRK 15:33-41">15፥33‑41</ref> ኩወፈ – <char style="xt"><ref loc="MAT 27:45-56">ማቴ 27፥45‑56</ref>፤ <ref loc="LUK 23:44-49">ሉቃ 23፥44‑49</ref></char></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33"/>ሰኣቲ ጀኣ ጀልቀቤ፣ ሀመ ሰኣቲ ሰገሊት ዱከን ለፈ ሁንደረ ቡኤ። <verse eid="MRK 15:33"/><verse number="34" style="v" sid="MRK 15:34"/>ሰኣቲ ሰገልትስ ዬሱስ ሰገሌ ጉዳዻን፣ <char style="tl"><char style="wj">“ኤሎሄ! ኤሎሄ!</char></char><note caller="+" style="f"><char style="fr" closed="false">15፥34 </char><char style="ft" closed="false">ወራብሌን ቶኮ ቶኮ </char><char style="fqa" closed="false">ኤሊ፣ ኤሊ ጄዹ።</char></note> <char style="tl"><char style="wj">ላማ ሰበቅታኒ?”</char></char> ጄዼ እዬ። ሂካንሳስ፣ <char style="wj">“ያ ዋቀኮ! ያ ዋቀኮ! አት ማሊፍ ነ ዺፍቴ?”</char><note caller="+" style="f"><char style="fr" closed="false">15፥34 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 22:1">ፋር 22፥1</ref></char></char></note> ጄቹዸ።<verse eid="MRK 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35"/>ወረ አች ዸዻበተን ኬሳ ቶኮ ቶኮ ዮሙ ዋን ከነ ዸገአንት፣ “እላ፣ እን ኤልያስን ዋማ” ጄዸን።<verse eid="MRK 15:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 15:36"/>ነምች ቶኮስ ፊጌ፣ እስፖንጂ ዸንገጋኣዻን ጉቴ፣ ኡሌት ካኤ፤ አከ እን ዹጉፍስ ዬሱሲፍ ኬኔ፣ “ሜ እሰ ዺሳ። አከ ኤልያስ ዹፌ ገድ እሰ ቡሱ አርግናቲ” ጄዼ።<verse eid="MRK 15:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37"/>ዬሱስስ ሰገሌ ጉዳዻን እዬ ሀፉረ ዹማ ባፈቴ።<verse eid="MRK 15:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38"/>ጎልጋን መነ ቁልቁሉማስ ኦሊ ሀመ ገዲት እዶ ለመት ተርሰኤ። <verse eid="MRK 15:38"/><verse number="39" style="v" sid="MRK 15:39"/>አጀጃን ዽባ ከን ፉለ ዬሱስ ዱረ ዻበቻ ቱሬስ ዮሙ እዩ ዬሱስ ዸገኤ አከ እን እት ሀፉረ ዹማ ባፈቴ አርጌት፣ “ዹጉማኑ ነምች ኩን እልመ ዋቃ ቱሬ!” ጄዼ።<verse eid="MRK 15:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40"/>ዱበርቶትን ቶኮ ቶኮስ ፈጎዻ እላላ ቱረን። እሳን ኬሳስ ማርያም እሼ መግደላ፣ ማርያም ሃዸ ያቆብ እሰ ቁጥሱቲፊ ዮሳ አከሱመስ ሰሎሜ ቱረን። <verse eid="MRK 15:40"/><verse number="41" style="v" sid="MRK 15:41"/>እሳንስ ዬሮ እን ገሊላ ቱሬት እሰ ዱካ ቡአኒ እሰ ተጃጅላ ቱረን። ዱበርቶትን እሰ ወጅን ዬሩሳሌምት ኦል በአን ባይኤን ካንስ አች ቱረን።<verse eid="MRK 15:41"/></para>
  <para style="s1">ዬሱስ አዋለሙሳ</para>
  <para style="r">
    <ref loc="MRK 15:42-47">15፥42‑47</ref> ኩወፈ – <char style="xt"><ref loc="MAT 27:57-61">ማቴ 27፥57‑61</ref>፤ <ref loc="LUK 23:50-56">ሉቃ 23፥50‑56</ref>፤ <ref loc="JHN 19:38-42">ዮሀ 19፥38‑42</ref></char></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42"/>ጉያን ሱን ጉያ ቆጲ ጄቹንስ ጉያ ሰንበታን ዱራ ቱሬ። ዮሙ ገልገላኤትስ፣ <verse eid="MRK 15:42"/><verse number="43" style="v" sid="MRK 15:43"/>ዮሴፍ ነምን አርማትያስ፣ ምሴንስ ያኢ ቤከማን ከን መታንሳ ሞቱማ ዋቃ ኤገቻ ቱሬ ቶኮ እጀ ጀብናን ገረ ጲላጦስ ዸቄ ሬፈ ዬሱስ ከዸቴ። <verse eid="MRK 15:43"/><verse number="44" style="v" sid="MRK 15:44"/>ጲላጦስስ ዮሙ አከ እን ዱኤ ዸገኤት ንድንቅፈቴ። አጀጃ ዽባ ሰነስ ኦፍት ዋሜ ዬሱስ ኤርገ ዱኤ ቱሩፊ ቱሩ ባቹሳ ጋፈቴ። <verse eid="MRK 15:44"/><verse number="45" style="v" sid="MRK 15:45"/>አከ እን ዱኤስ አጀጃ ዽባ ሰነራ ኤርገ ምርከኔፈቴ ቦዴ ሬፈ ሰነ ዮሴፊፍ ኬኔ። <verse eid="MRK 15:45"/><verse number="46" style="v" sid="MRK 15:46"/>ዮሴፍስ ሁጩ ቁንጬ ተልባራ ሆጄተሜ ብቴ፣ ሬፈ ሰነ ገድ ቡሴ፣ ሁጩ ሰናን ከፈኔ አዋለ ገራ ከታ ኬሰት ቆተቴ ኬሰ ካኤ። ዸጋ ቶኮስ በልበለ አዋለ ሰናት ገንገልቼ ጩፌ። <verse eid="MRK 15:46"/><verse number="47" style="v" sid="MRK 15:47"/>ማርያም እሼን መግደላቲፊ ማርያም ሃት ዮሳ ለፈ እን ካአሜ ንአርገን።<verse eid="MRK 15:47"/></para>
  <chapter eid="MRK 15"/>
  <chapter number="16" style="c" sid="MRK 16"/>
  <para style="s1">ዬሱስ ዱኣ ከኡሳ</para>
  <para style="r">
    <ref loc="MRK 16:1-8">16፥1‑8</ref> ኩወፈ – <char style="xt"><ref loc="MAT 28:1-8">ማቴ 28፥1‑8</ref>፤ <ref loc="LUK 24:1-10">ሉቃ 24፥1‑10</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1"/>ኤርገ ሰንበትን ደርቤ ቦዴ ማርያም እሼን መግደላ፣ ማርያም ሃት ያቆቢፊ ሰሎሜን ዸቀኒ ሬፈ ዬሱስ ድቡፍ ጄዸኒ ኡርጎፍቱ ብተን። <verse eid="MRK 16:1"/><verse number="2" style="v" sid="MRK 16:2"/>እሳንስ ጉያ ጀልቀበ ቶርባን ሰና ገነመ በሪ፣ አኩመ ቢፍቱን ባቴን ገረ አዋላ ዸቀን፤ <verse eid="MRK 16:2"/><verse number="3" style="v" sid="MRK 16:3"/>እሳንስ፣ “ኤኙቱ በልበለ አዋላራ ዸጋ ሰነ ኑ ገንገልቸ?” ወሊን ጄዸን።<verse eid="MRK 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 16:4"/>ዮሙ ምልአተኒ እላለንት ገሩ አከ ዸጋን ባይኤ ጉዳን ሱን አፋን አዋላራ ገንገልፈሜ አርገን። <verse eid="MRK 16:4"/><verse number="5" style="v" sid="MRK 16:5"/>እሳንስ አዋለ ኬሰ ሴነኒ ደርገጌሰ ኡፈተ አዲ ኡፈቴ ቶኮ ከራ ምርጋቲን ታኤ አርገኒ ርፈተን።<verse eid="MRK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6"/>እንስ አከነ እሳኒን ጄዼ፤ “ህንርፈትና! እስን ዬሱስ ነመ ናዝሬት እሰ ፈንፈሜ ቱሬ በርባዱ። እን ከኤረ! አስ ህንጅሩ። ሜ እዶ እሳን እሰ ካአኒ ቱረን እላላ። <verse eid="MRK 16:6"/><verse number="7" style="v" sid="MRK 16:7"/>ገሩ ዸቃቲ በረቶተሳቲፊ ጴጥሮስት፣ ‘እን እስን ዱርሴ ገሊላ ንዸቀ። አኩመ እስንት ህሜ ሰነስ አችት እሰ ንአርግቱ’ ጄዻቲ ህማ።”<verse eid="MRK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8"/>ዱበርቶትን ሱንስ ሆለቻፊ ድንቅሲፈቻ ገድ በአኒ አዋልቸ ብራ በቀተን። ሰበቢ ሶዳተኒፍስ ነመ ቶኮትሌ ሆማ ህንህምኔ።</para>
  <para style="p" vid="MRK 16:8">[ <verse eid="MRK 16:8"/><verse number="9" style="v" sid="MRK 16:9"/>ዬሱስስ በሪ ጉያ ጀልቀበ ቶርበን ሰና ዬሮ ዱኣ ከኤት ዱራን ዱርሴ ማርያም እሼ መግደላት ሙልአቴ፤ ማርያም ኩንስ ከን እን ሀፉሮተ ሀሞ ቶርበ እሼ ኬሳ ባሴ ቱሬዸ። <verse eid="MRK 16:9"/><verse number="10" style="v" sid="MRK 16:10"/>እሼንስ ዸቅጤ ኡቱ ወር እሰ ወጅን ቱረን ወዋቹፊ ቦኡት ጅረኑ እሳንት ህምቴ። <verse eid="MRK 16:10"/><verse number="11" style="v" sid="MRK 16:11"/>እሳን ገሩ ዮሙ አከ ዬሱስ ጅራታ ተኤፊ አከ እሼን እሰ አርግቴ ዸገአንት ዋን ሰነ ህንአመኔ።<verse eid="MRK 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12"/>ኤርገሲስ እሳን ኬሳ ኡቱ ነሞትን ለመ ባድያ ዸቃ ጅረኑ ዬሱስ ብፈ ብራቲን እሳንት ሙልአቴ። <verse eid="MRK 16:12"/><verse number="13" style="v" sid="MRK 16:13"/>ጀርስ ዴብአኒ ወረ ሀፈንት ህመን፤ እሳን ገሩ ወረ ከነስ ህንአመኔ።<verse eid="MRK 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14"/>ኤርገሲስ ዬሱስ ኡቱ እሳን ማዲት ዽኣተኒ ጅረኑ ወረ ኩዸ ቶኮት ሙልአቴ፤ እንስ ሰበቢ እሳን ወረ ኤርገ እን ዱኣ ከኤ እሰ አርገን ሰነ አመኑ ድደኒፍ፣ አመንቲ ዸቢሰሳኒቲፊ መተ ጀብነሳኒቲፍ እሳን እፈቴ።<verse eid="MRK 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 16:15"/>እንስ አከነ እሳኒን ጄዼ፤ <char style="wj">“ገረ አዱኛ ሁንዳ ዸቃ፤ ኡመመ ሁንዱመትስ ወንጌለ ለለባ።</char> <verse eid="MRK 16:15"/><verse number="16" style="v" sid="MRK 16:16"/><char style="wj">ነምን አመኑፊ ጩጰሙ ከምዩ ንፈየ፤ ነመ ህንአመኔት ገሩ ንሙረመ።</char> <verse eid="MRK 16:16"/><verse number="17" style="v" sid="MRK 16:17"/><char style="wj">መለቶን ኩንስ ወረ አመነንራ ሙልአተ፤ እሳን መቃኮቲን ሀፉሮተ ሀሞ ባሱ፤ አፋን ሃራዻን ዱበቱ፤</char> <verse eid="MRK 16:17"/><verse number="18" style="v" sid="MRK 16:18"/><char style="wj">ሀርከሳኒቲን ቦፈ ንቀቡ፤ ዮ ሱሚ ነመ አጄሱ ዹገን እሳን ህንሚዹ፤ ሀርከሳኒ ነሞተ ዹኩብሰተንረ ንካኡ፤ ነሞትንስ ንፈዩ።”</char><verse eid="MRK 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19"/>ዬሱስ ጎፍታን ኤርገ እሳንት ዱበቴ ቦዴ ሰሚት ኦል ፉዸተሜ ገረ ምርገ ዋቃቲን ታኤ። <verse eid="MRK 16:19"/><verse number="20" style="v" sid="MRK 16:20"/>በረቶትንስ አቺ በአኒ እዶ ሁንደት ለለበን፤ ጎፍታንስ እሳን ወጅን ሆጄቻ ቱሬ፤ ዱቢሳስ ድንቂወን ሆጄተመኒን ንምርከኔሰ ቱሬ።]<note caller="+" style="f"><char style="fr" closed="false">16፥20 </char><char style="ft" closed="false">ወራብሌን ዱሪ ቶኮ ቶኮ ኩታ ሉቅሳ 9ፊ 20 ግዱ ጅሩ ህንቀበን።</char></note><verse eid="MRK 16:20"/></para>
  <chapter eid="MRK 16"/>
</usx>
