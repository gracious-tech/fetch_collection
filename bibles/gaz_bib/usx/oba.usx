<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="OBA" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">ኦባድያ</para>
  <para style="toc1">ራጂ ኦባድያ</para>
  <para style="toc2">ኦባድያ</para>
  <para style="toc3">አብድ</para>
  <para style="mt2">ራጂ</para>
  <para style="mt1">ኦባድያ</para>
  <chapter number="1" style="c" sid="OBA 1"/>
  <para style="p">
    <verse number="1" style="v" sid="OBA 1:1"/>ሙልአተ ኦባድያ።</para>
  <para style="r" vid="OBA 1:1">
    <ref loc="OBA 1:1-4">1‑4</ref> ኩወፈ – <char style="xt"><ref loc="JER 49:14-16">ኤር 49፥14‑16</ref></char></para>
  <para style="r" vid="OBA 1:1">
    <ref loc="OBA 1:5-6">5‑6</ref> ኩወፈ – <char style="xt"><ref loc="JER 49:9-10">ኤር 49፥9‑10</ref></char></para>
  <para style="p" vid="OBA 1:1">
    <char style="nd">ዋቀዮ</char> ጎፍታን ዋኤ ኤዶም አከነ ጄዸ።</para>
  <para style="b" vid="OBA 1:1"/>
  <para style="b" vid="OBA 1:1"/>
  <para style="q1" vid="OBA 1:1">ኑ ኤርጋ ቶኮ <char style="nd">ዋቀዮራ</char> ዸጌኜረ፦</para>
  <para style="q2" vid="OBA 1:1">ኤርገማን ቶኮ፣ “ከኣ ዸቅኔ እሼ ሎላ፤</para>
  <para style="q1" vid="OBA 1:1">ወራናፍስ በኣ” ጄቹፍ ገረ ሰቦታት ኤርገሜ።<verse eid="OBA 1:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="OBA 1:2"/>“ኩኖ፣ አን ሰቦተ ግዱት ስን ጥኔሰ፤</para>
  <para style="q2" vid="OBA 1:2">አትስ አከ መሌ ቱፈተምተ።<verse eid="OBA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="OBA 1:3"/>አት ከን በቀቃ ከታ ኬሰ ጅራቴ</para>
  <para style="q2" vid="OBA 1:3">መነኬ ለፈ ኦል ከኣረት እጃረቱ፣</para>
  <para style="q1" vid="OBA 1:3">ከን፣ ‘ኤኙቱ ለፈት ገድ ነ ቡሰ?’ ኦፊን ጄቱ፣</para>
  <para style="q2" vid="OBA 1:3">ኦፍ ቱሉማን ገራኬቲ ስ ጎዎምሴረ።<verse eid="OBA 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="OBA 1:4"/>ዮ አት አኩመ ርሳ ኦል ፈጋቴ</para>
  <para style="q2" vid="OBA 1:4">ኡርጂወን ግዱት መንኤኬ እጃረቴዩ፣</para>
  <para style="q2" vid="OBA 1:4">አን አቺ ገድ ስን ቡሰ”</para>
  <para style="q2" vid="OBA 1:4">ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="OBA 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="OBA 1:5"/>“ሀቱን ዮ ስት ዹፍቴ</para>
  <para style="q2" vid="OBA 1:5">ሳምቱን ሀልከኒን ስት ሴንቴ፣</para>
  <para style="q1" vid="OBA 1:5">በላ አከሚቱ ስ ኤገተ!</para>
  <para style="q2" vid="OBA 1:5">እሳን ሀሙመ በርባደን ቆፈ ፉዸተኒ ህንዴመኒ?</para>
  <para style="q1" vid="OBA 1:5">ወር እጀ ወይኒ ጉረን ኡቱ ገረኬ ዹፈኒ፣</para>
  <para style="q2" vid="OBA 1:5">ስላ ቀርሚ ወዪ ህንዺሰኒ?<verse eid="OBA 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="OBA 1:6"/>ኤሳዉ ገሩ አከም ሳመሜ</para>
  <para style="q2" vid="OBA 1:6">ቀቤኝሳ ዾክፈማንስ ጀላ ጉረሜ!<verse eid="OBA 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="OBA 1:7"/>ገሬንኬ ሁንድኑ ገረ ሞጋት ስ ዺበ፤</para>
  <para style="q2" vid="OBA 1:7">ምቾትንኬ ስ ጎዎምሰኒ ስ ሞአቱ፤</para>
  <para style="q1" vid="OBA 1:7">ወር ቡዴነኬ ኛተን ክዮ ስ ዱረ ካኡ፤</para>
  <para style="q2" vid="OBA 1:7">አት ገሩ ዋን ከነ ህንሁበቱ።<verse eid="OBA 1:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="OBA 1:8"/>“አን በረ ሰነ ኦጌዪ ኤዶም፣</para>
  <para style="q2" vid="OBA 1:8">ነሞተ ሁበትና ቀበን ቱሉወን ኤሳውራ</para>
  <para style="q2" vid="OBA 1:8">ህንበሌሱ?” ጄዸ <char style="nd">ዋቀዮ</char>።<verse eid="OBA 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="OBA 1:9"/>“ያ ቴማን ቀብሳኦንኬ ንርፈቱ፤</para>
  <para style="q2" vid="OBA 1:9">ነምን ቱሉወን ኤሳዉረ</para>
  <para style="q2" vid="OBA 1:9">ጅራቱ ሁንድኑስ ጎረአሜ ዹመ።<verse eid="OBA 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="OBA 1:10"/>ሰበቢ ደበ ኦቦሌሰኬ ያቆብት ሆጄተሜቲፍ</para>
  <para style="q2" vid="OBA 1:10">አት ቃኒዻን ሀጉገምተ፤</para>
  <para style="q2" vid="OBA 1:10">በረ በራንስ ንበሌፈምተ።<verse eid="OBA 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="OBA 1:11"/>ጋፈ አለጎን ቀቤኘሳ</para>
  <para style="q2" vid="OBA 1:11">ጉረተኒ ነሞትን ኦርማሞ ከረሳ ሴነኒ</para>
  <para style="q1" vid="OBA 1:11">ዬሩሳሌምት እጣ ቡፈተንት፣</para>
  <para style="q2" vid="OBA 1:11">አትስ ኮጳ ዻበቴ</para>
  <para style="q2" vid="OBA 1:11">እሳን ኬሳ አከ እሰ ቶኮ ታቴ።<verse eid="OBA 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="OBA 1:12"/>ጋፈ እን ምልኪ ዸቤት</para>
  <para style="q2" vid="OBA 1:12">አት ኦቦሌሰኬ ቱፈቹ ህንቀብዱ ቱርቴ፤</para>
  <para style="q1" vid="OBA 1:12">ዮካን ጉያ በዲሳኒት</para>
  <para style="q2" vid="OBA 1:12">ሰበ ይሁዳት ገመዱ ህንቀብዱ ቱርቴ፤</para>
  <para style="q1" vid="OBA 1:12">ዮካን በረ ረክነሳኒ ኬሰ</para>
  <para style="q2" vid="OBA 1:12">አከ መሌ ኦፍ ቱሉ ህንቀብዱ ቱርቴ።<verse eid="OBA 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="OBA 1:13"/>በረ በላን እሳንት ዹፌ ኬሰ</para>
  <para style="q2" vid="OBA 1:13">ከረ ሰበኮቲን ኦል ሴኑ ህንቀብዱ ቱርቴ፤</para>
  <para style="q1" vid="OBA 1:13">ዮካን በረ ዸእች እሳንት ዹፌ ኬሰ</para>
  <para style="q2" vid="OBA 1:13">ረክነሳኒ ኬሰት እሳን ቱፈቹ ህንቀብዱ ቱርቴ፤</para>
  <para style="q1" vid="OBA 1:13">ዮካን በረ በላን እሳንት ዹፌ ኬሰ</para>
  <para style="q2" vid="OBA 1:13">ቀቤኘሳኒ ሳሙ ህንቀብዱ ቱርቴ።<verse eid="OBA 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="OBA 1:14"/>በቀቶተሳ ፍጡፍ ጄቴ ቀጣሙረ ከራት</para>
  <para style="q2" vid="OBA 1:14">እሳን ኤገቹ ህንቀብዱ ቱርቴ፤</para>
  <para style="q1" vid="OBA 1:14">ዮካን በረ ረክነሳ ኬሰ</para>
  <para style="q2" vid="OBA 1:14">ሀምባሳ ደበርስቴ ኬኑ ህንቀብዱ ቱርቴ።<verse eid="OBA 1:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="OBA 1:15"/>“ጉያን <char style="nd">ዋቀዮ</char></para>
  <para style="q2" vid="OBA 1:15">ሰቦተ ሁንዳፍ ዽኣቴረ።</para>
  <para style="q1" vid="OBA 1:15">አኩመ አት ሆጄቴ ስትስ ንሆጄተመ፤</para>
  <para style="q2" vid="OBA 1:15">ሆጂንኬስ መቱመኬት ዴብአ።<verse eid="OBA 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="OBA 1:16"/>አኩመ እስን ጋረኮ ቁልቁሉረት ዹግደን ሰነ፣</para>
  <para style="q2" vid="OBA 1:16">ሰቦትን ሁንድኑ እቱመ ፉፈኒ ንዹጉ፤</para>
  <para style="q1" vid="OBA 1:16">እሳን እት ዴዴብአኒ ዹጉ፤</para>
  <para style="q2" vid="OBA 1:16">አከ ዋን ጎንኩማ ህንዹግኒ ተኡ።<verse eid="OBA 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="OBA 1:17"/>ቱሉ ጥዮንረ ገሩ ፉረሙን ንጅራተ፤</para>
  <para style="q2" vid="OBA 1:17">እን ንቁልቁላአ፤</para>
  <para style="q2" vid="OBA 1:17">መን ያቆብስ ዻለሳኒ ንዹንፈቱ።<verse eid="OBA 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="OBA 1:18"/>መን ያቆብ እብደ፣</para>
  <para style="q2" vid="OBA 1:18">መን ዮሴፍሞ አረበ እብዳ ተአ፤</para>
  <para style="q1" vid="OBA 1:18">መን ኤሳው ሁረ ተአ፤</para>
  <para style="q2" vid="OBA 1:18">እሳንስ እብደ እት ቀብሲሰኒ ጉበኒ በርበዴሱ።</para>
  <para style="q1" vid="OBA 1:18">መነ ኤሳው ኬሳ</para>
  <para style="q2" vid="OBA 1:18">ነምን ቶኮዩ ህንሀፉ”</para>
  <para style="q1" vid="OBA 1:18">ጄዼ ዱበቴረ <char style="nd">ዋቀዮ</char>።<verse eid="OBA 1:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="OBA 1:19"/>ነሞትን ኔጌብ</para>
  <para style="q2" vid="OBA 1:19">ቱሉወን ኤሳው ንቀበቱ፤</para>
  <para style="q1" vid="OBA 1:19">ነሞትን ጋረን ጀለ ጅራተንሞ</para>
  <para style="q2" vid="OBA 1:19">ብየ ፍልስጤሞታ ቀበቱ።</para>
  <para style="q1" vid="OBA 1:19">እሳን ድሬ ኤፍሬሚፊ ሰማርያ ንቀበቱ፤</para>
  <para style="q2" vid="OBA 1:19">ቤንያምሞ ብየ ግልኣድ ቀበተ።<verse eid="OBA 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="OBA 1:20"/>ገሬን ቦጅአምቶተ እስራኤል ከን ከነኣን ጅራቱ ኩን</para>
  <para style="q2" vid="OBA 1:20">ብየ ሀመ ሳረፕታት ጅሩ ዻለ፤</para>
  <para style="q1" vid="OBA 1:20">ቦጅአምቶትን ዬሩሳሌም ከኔን</para>
  <para style="q2" vid="OBA 1:20">ሴፋራድ ጅራተን መጋላወን ኔጌብ ዻሉ።<verse eid="OBA 1:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="OBA 1:21"/>ብልሰ ባስቶትን ቱሉወን ኤሳው ቡልቹዻፍ</para>
  <para style="q2" vid="OBA 1:21">ቱሉ ጥዮንት ኦል በኡ።</para>
  <para style="q2" vid="OBA 1:21">ሞቱማንስ ከን <char style="nd">ዋቀዮ</char> ተአ።<verse eid="OBA 1:21"/></para>
  <chapter eid="OBA 1"/>
</usx>
