<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">ዮሀንስ</para>
  <para style="toc1">ወንጌለ ዮሀንስ</para>
  <para style="toc2">ዮሀንስ</para>
  <para style="toc3">ዮሀ</para>
  <para style="mt2">ወንጌለ</para>
  <para style="mt1">ዮሀንስ</para>
  <chapter number="1" style="c" sid="JHN 1"/>
  <para style="s1">ዱቢን ፎን ተኡሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1"/>ጀልቀበት ዱቢቱ ቱሬ፤ ዱብችስ ዋቀ ወጅን ቱሬ፤ ዱቢን ሱንስ ዋቀ ቱሬ። <verse eid="JHN 1:1"/><verse number="2" style="v" sid="JHN 1:2"/>እንስ ጀልቀበት ዋቀ ወጅን ቱሬ። <verse eid="JHN 1:2"/><verse number="3" style="v" sid="JHN 1:3"/>ወን ሁንድኑ እሳን ተኤ፤ ዋን ተኤ ሁንደ ኬሳስ ወን እሰ መሌ ተኤ ቶኮዩ ህንጅሩ። <verse eid="JHN 1:3"/><verse number="4" style="v" sid="JHN 1:4"/>ጅሬኝ እሰ ኬሰ ቱሬ፤ ጅሬኝ ሱንስ እፈ ነሞታ ቱሬ። <verse eid="JHN 1:4"/><verse number="5" style="v" sid="JHN 1:5"/>እፍን ሱን ዱከነ ኬሰት ንእብሰ፤ ዱከን ገሩ እሰ ህንሞአትኔ።<verse eid="JHN 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6"/>ነመ ዋቀ ብራ ኤርገሜ ከን መቃንሳ ዮሀንስ ጄዸሙ ቶኮቱ ቱሬ። <verse eid="JHN 1:6"/><verse number="7" style="v" sid="JHN 1:7"/>እንስ አከ ነምን ሁንድኑ ከራሳቲን አመኑፍ ዹገ ባቱ ተኤ ዋኤ እፈ ሰና ዹጋ በኡፍ ዹፌ። <verse eid="JHN 1:7"/><verse number="8" style="v" sid="JHN 1:8"/>ዋኤ እፈ ሰና ዹጋ በኡ ዹፌ መሌ እን መታንሳ እፈ ህንቱሬ።<verse eid="JHN 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 1:9"/>እፍን ዹጋ ከን ነመ ሁንዳፍ እፈ ኬኑ ሱን ገረ አዱኛ ዹፋ ቱሬ። <verse eid="JHN 1:9"/><verse number="10" style="v" sid="JHN 1:10"/>እን አዱኛ ኬሰ ቱሬ፤ አዱኛን እሳን ኡመሜ፤ አዱኛን ገሩ እሰ ህንቤክኔ። <verse eid="JHN 1:10"/><verse number="11" style="v" sid="JHN 1:11"/>እንስ ገረ ሰበሳ ዹፌ፤ ሰብንሳ ገሩ እሰ ህንፉዸትኔ። <verse eid="JHN 1:11"/><verse number="12" style="v" sid="JHN 1:12"/>ወረ እሰ ፉዸተኒ መቃሳት አመነኒፍ ገሩ አከ እጆሌ ዋቃ ተአኒፍ ምርገ ኬኔ። <verse eid="JHN 1:12"/><verse number="13" style="v" sid="JHN 1:13"/>እሳንስ ዋቀራ ዸለተን መሌ ዺገራ ዮካን ፌዺ ፎኒራ ዮካን ፌዺ ዺራራ ህንዸለትኔ።<verse eid="JHN 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14"/>ዱቢን ፎን ተኤ ኑ ግዱ ጅራቴ። ኑስ ኡልፍነሳ፣ ኡልፍነ እልመ ቶክቸ አያናፊ ዹጋዻን ጉተሜ አባ ብራ ዹፌ ሰና አርግኔረ።<verse eid="JHN 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15"/>ዮሀንስስ ዋኤሳ ዹጋ በኤ። ሰገሌሳስ ኦል ፉዸቴ አከነ ጄዼ፤ “እን አን፣ ‘እን ነ ዱባን ዹፉ ነ ጫለ፤ እን ነ ዱረ ቱሬቲ’ ጄዼ ዋኤሳ ዱበዼ ሱን እሰ ከነ።” <verse eid="JHN 1:15"/><verse number="16" style="v" sid="JHN 1:16"/>ጉተመሳራስ ሁንድኬኘ አያነረት አያነ አርገትኔረ። <verse eid="JHN 1:16"/><verse number="17" style="v" sid="JHN 1:17"/>ሴር ከራ ሙሴቲን ኬነሜቲ፤ አያኒፊ ዹጋን ገሩ ከራ ዬሱስ ክርስቶሲቲን ዹፌ። <verse eid="JHN 1:17"/><verse number="18" style="v" sid="JHN 1:18"/>ኤኙዩ ተኩማ ዋቀ ህንአርግኔ፤ ገሩ እልመ ቶክቸ አባ ብረ ጅሩ ሰነቱ እሰ ቤክስሴ።<verse eid="JHN 1:18"/></para>
  <para style="s1">ዮሀንስ ጩጳን አከ ኦፊሳቲ ክርስቶስ ህንተእን ዱበቴ</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19"/>ዮሙ ይሁዶትን ሉቦታፊ ሌዎተ ዬሩሳሌም ዮሀንስት ኤርገኒ፣ “አት ኤኙ?” ጄዸኒ ጋፈቺሰንት ዹገ በኡምስ ዮሀንስ ኬኔ ከነ ቱሬ። <verse eid="JHN 1:19"/><verse number="20" style="v" sid="JHN 1:20"/>እን ዹጋ በኤ መሌ ህንገኔ፤ “አን ክርስቶስ ምት” ጄዼ ዹጋ በኤ።<verse eid="JHN 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21"/>እሳንስ፣ “ዮስ አት ኤኙሬ? ኤልያስሞ?” ጄዸኒ እሰ ጋፈተን።</para>
  <para style="p" vid="JHN 1:21">እንስ፣ “ለክ፣ አን እሰ ምት” ጄዼ ዴብሴፍ።</para>
  <para style="p" vid="JHN 1:21">እሳንስ፣ “ዮስ አት ራጅቻሬ?”<note caller="+" style="f"><char style="fr" closed="false">1፥21 </char><char style="ft" closed="false"><char style="xt"><ref loc="DEU 18:15">ኬዴ 18፥15</ref></char></char></note> ጄዸኒን።</para>
  <para style="p" vid="JHN 1:21">እንሞ፣ “ለክ” ጄዼን።<verse eid="JHN 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22"/>እሳንስ፣ “አት ኤኙሬ? አከ ወረ ኑ ኤርገኒፍ ዴቢ ኬንኑፍ አት ኤኙ ኦፊን ጄተ?” ጄዸኒን።<verse eid="JHN 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23"/>ዮሀንስስ ዱቢ እሳያስ ራጅች ዱበቴ ሰናን ዴብሴ፣ “አን ሰገሌ ገሞጂ ኬሳ፣ ‘ጎፍታፍ ከራ ቀጄልቻ’<note caller="+" style="f"><char style="fr" closed="false">1፥23 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 40:3">እሳ 40፥3</ref></char></char></note> ጄዼ እዩ ሰናዸ” ጄዼን።<verse eid="JHN 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24"/>ፈሪሶትን ኤርገመን ቶኮ ቶኮስ፣ <verse eid="JHN 1:24"/><verse number="25" style="v" sid="JHN 1:25"/>አከነ ጄዸኒ እሰ ጋፈተን፤ “አት ኤርገ ክርስቶስ ዮካን ኤልያስ ዮካን ራጅቸ ተኡ ባቴ ማሊፍ ጩጵጠሬ?”<verse eid="JHN 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26"/>ዮሀንስሞ አከነ ጄዼ ዴብሴፍ፤ “አን ብሻኒን ነንጩጰ፤ ነምን እስን እሰ ህንቤክኔ ቶኮ ገሩ እስን ግዱ ዻበተ። <verse eid="JHN 1:26"/><verse number="27" style="v" sid="JHN 1:27"/>እንስ እሰ ነ ዱባን ዹፉ ከን አን ህዻ ኮጴሳዩ ሂኩፊ ህንመሌዸ።”<verse eid="JHN 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28"/>ወንቶትን ኩኔን ዮርዳኖስ ገመ እዶ ዮሀንስ እት ጩጳ ቱሬ ቢታንያ ኬሰት ተኤ።<verse eid="JHN 1:28"/></para>
  <para style="s1">ዬሱስ ሆላ ዋቃ</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29"/>ጉያ እት ኣኑት ዮሀንስ ኡቱ ዬሱስ ገረሳ ዹፉ አርጌ አከነ ጄዼ፤ “እላ ሆላ ዋቃ ከን ጩቡ አዱኛ በሌሱ! <verse eid="JHN 1:29"/><verse number="30" style="v" sid="JHN 1:30"/>እን አን፣ ‘ነምን ነ ዱባን ዹፉ ነ ጫለ፤ እን ነ ዱረ ቱሬቲ’ ጄዼ ዋኤሳ ዱበዼ ሱን እሰ ከነ። <verse eid="JHN 1:30"/><verse number="31" style="v" sid="JHN 1:31"/>አን መታንኮዩ እሰ ህንቤኩን ቱሬ፤ ሰበቢን አን ብሻኒን ጩጳ ዹፌፍ ገሩ አከ እን ሰበ እስራኤልት ሙልእፈሙፍ።”<verse eid="JHN 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32"/>ዮሀንስ እት ፉፌ አከነ ጄዼ ዹጋ በኤ፤ “አን ኡቱ ሀፉር አኩመ ጉጌት ሰሚራ ገድ ቡኤ እሰረ ጅራቱ ነንአርጌ። <verse eid="JHN 1:32"/><verse number="33" style="v" sid="JHN 1:33"/>እን አከ አን ብሻኒን ጩጱፍ ነ ኤርጌ ሱን፣ ‘ነምች አት ኡቱ ሀፉር ገድ ቡኤ እሰረ ጅራቱ አርግቱ ሱን፣ እሰ ሀፉረ ቁልቁሉዻን ጩጱዸ’ ጄዼ ኡቱ ነት ህሙ ባቴ ስላ አንዩ እሰ ህንቤኩ ቱሬ። <verse eid="JHN 1:33"/><verse number="34" style="v" sid="JHN 1:34"/>አንስ አርጌረ፤ አከ እን እልመ ዋቃ ተኤስ ዹጋ በኤረ።”<verse eid="JHN 1:34"/></para>
  <para style="s1">በረቶትን ዮሀንስ ዬሱስ ዱካ ቡኡሳኒ</para>
  <para style="r">
    <ref loc="JHN 1:40-42">1፥40‑42</ref> ኩወፈ – <char style="xt"><ref loc="MAT 4:18-22">ማቴ 4፥18‑22</ref>፤ <ref loc="MRK 1:16-20">ማር 1፥16‑20</ref>፤ <ref loc="LUK 5:2-11">ሉቃ 5፥2‑11</ref></char></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35"/>ጉያ እት ኣኑት ዮሀንስ አመስ በረቶተሳ ኬሳ ለመ ወጅን አች ቱሬ። <verse eid="JHN 1:35"/><verse number="36" style="v" sid="JHN 1:36"/>እንስ ኡቱ ዬሱስ አችረ ደርቡ አርጌ፣ “እላ፣ ሆላ ዋቃ!” ጄዼ።<verse eid="JHN 1:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37"/>በረቶትን ለማንስ ዋን ከነ ዱበቹሳ ዸገአኒ ዬሱስ ዱካ ቡአን። <verse eid="JHN 1:37"/><verse number="38" style="v" sid="JHN 1:38"/>ዬሱስስ ኦፍረ ገረገሌ እሰ ዱካ ቡኡሳኒ አርጌ፣ <char style="wj">“እስን ማል በርባዱ?”</char> ጄዼን።</para>
  <para style="p" vid="JHN 1:38">እሳንስ፣ “ረቢ፣ አት ኤሰ ጅራተ?” ጄዸኒን። ረቢ ጄቹን በርሲሳ ጄቹዸ።<verse eid="JHN 1:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39"/>እንስ፣ <char style="wj">“ኮታቲ እላላ”</char> ጄዼን።</para>
  <para style="p" vid="JHN 1:39">እሳንስ ዸቀኒ አከ እን ኤሰ ጅራቱ አርገን፤ ጋፈ ሰነ እሰ ወጅን ኦለን። ዬሮን ሱንስ ገረ ሰኣቲ ኩርነፋ ቱሬ።<verse eid="JHN 1:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40"/>ወረ ዋን ዮሀንስ ዱበቴ ዸገአኒ ዬሱስ ዱካ ቡአን ለማን ኬሳ እን ቶኮ እንድሪያስ ኦቦሌሰ ስሞን ጴጥሮስ ቱሬ። <verse eid="JHN 1:40"/><verse number="41" style="v" sid="JHN 1:41"/>እንስ ዱራን ዱርሴ ኦቦሌሰሳ ስሞንን አርገቴ፣ “ኑ መሲህቸ አርገትኔረ” ጄዼን፤ መሲሂ ጄቹን ክርስቶስ ጄቹዸ። <verse eid="JHN 1:41"/><verse number="42" style="v" sid="JHN 1:42"/>እንድሪያስስ ስምኦንን ገረ ዬሱስት ፍዴ።</para>
  <para style="p" vid="JHN 1:42">ዬሱስስ እሰ እላሌ፣ <char style="wj">“አት ስሞን እልመ ዮሀንስ፣ ኬፋ ጄዸምቴ ንዋመምተ”</char> ጄዼን። ኬፋ ጄቹን ጴጥሮስ ጄቹዸ።<verse eid="JHN 1:42"/></para>
  <para style="s1">ዬሱስ ፊልጶሲፊ ናትናኤልን ዋሙሳ</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43"/>ዬሱስስ ጉያ እት ኣኑት ገሊላ ዸቁ በርባዴ። እንስ ፊልጶስን አርጌ፣ <char style="wj">“ነ ዱካ ቡእ”</char> ጄዼን።<verse eid="JHN 1:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 1:44"/>ፊልጶስስ አኩመ እንድሪያሲፊ ጴጥሮስ ነመ መጋላ ቤተ ሳይዳ ቱሬ። <verse eid="JHN 1:44"/><verse number="45" style="v" sid="JHN 1:45"/>ፊልጶስ ናትናኤልን አርጌ፣ “እሰ ሙሴን ክታበ ሴራ ኬሰት ዋኤሳ በሬሴፊ እሰ ራጆትንስ ዋኤሳ በሬሰን፣ እልመ ዮሴፍ፣ ዬሱስ ነመ ናዝሬት አርገትኔረ” ጄዼን።<verse eid="JHN 1:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46"/>ናትናኤልስ፣ “ናዝሬት ኬሳ ወን ጋሪን በኡ ንደንደኣ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="JHN 1:46">ፊልጶስስ፣ “ኮቱቲ እላል” ጄዼን።<verse eid="JHN 1:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47"/>ዬሱስስ ኡቱ ናትናኤል ገረሳ ዹፉ አርጌ፣ <char style="wj">“እላ፣ እስራኤልቸ ዹጋ፣ ከን ሀጡማን ኬሰ ህንጅሬ!”</char> ጄዼ ዋኤሳ ዱበቴ።<verse eid="JHN 1:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48"/>ናትናኤልስ፣ “አት ኤሰት ነ ቤክተ?” ጄዼን።</para>
  <para style="p" vid="JHN 1:48">ዬሱስስ፣ <char style="wj">“ኡቱ ፊልጶስ ስ ህንዋምን ዱረ ዬሮ አት ሙከ ሀርቡ ጀለ ቱርቴትን ስ አርጌ”</char> ጄዼ ዴብሴፍ።<verse eid="JHN 1:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49"/>ናትናኤልስ፣ “ያ በርሲሳ፣ አት እልመ ዋቃት! አት ሞቲ እስራኤል” ጄዼን።<verse eid="JHN 1:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50"/>ዬሱስሞ አከነ ጄዼን፤ <char style="wj">“አት ሰበቢ አን ሙከ ሀርቡ ጀለተን ስ አርጌ ሲን ጄዼፍ አመንቴ? ዋን ከነ ጫሉዩ አርጉፍ ጅርተ።”</char> <verse eid="JHN 1:50"/><verse number="51" style="v" sid="JHN 1:51"/>እንስ እት ደበሌ፣ <char style="wj">“አን ዹጉመን፣ ዹጉመን እስኒን ጄዸ፤ ሰሚን በነሜ ኡቱ ኤርገሞትን ዋቃ እልመ ነማረ ኦል በአኒ ገድ ቡአኑ ንአርግቱ”</char> ጄዼን።<verse eid="JHN 1:51"/></para>
  <chapter eid="JHN 1"/>
  <chapter number="2" style="c" sid="JHN 2"/>
  <para style="s1">ዬሱስ ብሻን ገረ ዳዺ ወይኒት ጌደሩሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1"/>ጉያ ሰደፋት ቃና ገሊላ ኬሰ ጭዸ ጋኤላቱ<note caller="+" style="f"><char style="fr" closed="false">2፥1 </char><char style="fq" closed="false">ጭዸ ጋኤላቱ </char><char style="fqa" closed="false">(ጅለ ፉዻ) </char><char style="ft" closed="false">– ጭዽ ጋኤላ ቶርበን ቶኮ ጉቱ ፉዸተ ቱሬ።</char></note> ቱሬ። ሃት ዬሱሲስ አች ቱርቴ፤ <verse eid="JHN 2:1"/><verse number="2" style="v" sid="JHN 2:2"/>ዬሱሲፊ በረቶትንሳ ገረ ጭዸ ሰናት ዋመመኒ ቱረን። <verse eid="JHN 2:2"/><verse number="3" style="v" sid="JHN 2:3"/>ዮሙ ዳዺን ወይኒ ዹሜት ሃት ዬሱስ፣ “ጀር ዳዺ ወይኒ ህንቀበን” እሳን ጄቴ።<verse eid="JHN 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4"/>ዬሱስሞ ዴብሴ፣ <char style="wj">“ዱበርቲነነ! ማል ጎዽ ናን ጄተ? ዬሮንኮ አመሌ ህንጌኜ”</char> ጄዼን።<verse eid="JHN 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5"/>ሃትሳስ ተጃጅልቶታን፣ “ዋኑመ እን እስንት ህሙ ሁንደ ጎዻ” ጄቴ።<verse eid="JHN 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6"/>ጋኒወን ዸጋ ጀአ ስርነ ቁልቁሌሱ ይሁዶታቲፍ አች ዻበመኒ ቱረን፤ ቶኮን ቶኮንሳኒስ ገረ ሊትሮ 75 ሀመ 115 ቀበተ ቱሬ።<verse eid="JHN 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 2:7"/>ዬሱስ ተጃጅልቶታን፣ <char style="wj">“ጋኒወንት ብሻን ጉታ”</char> ጄዼ፤ እሳንስ ሀመ አፋን ጋኒወኒት ጉተን።<verse eid="JHN 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 2:8"/>እንስ፣ <char style="wj">“ኤጋ ቡዱቅሳቲ አባ ጭዻት ኬና”</char> ጄዼን።</para>
  <para style="p" vid="JHN 2:8">እሳንስ አከሱመ ጎዸን፤ <verse eid="JHN 2:8"/><verse number="9" style="v" sid="JHN 2:9"/>አባን ጭዻስ ብሻን ገረ ዳዺ ወይኒት ጌደረሜ ሰነ አፋኒን ቀቤ እላሌ። ዳዺን ወይኒ ሱን ኤሳ አከ ዹፌ ተጃጅልቶተ ብሻን ወራበንቱ ቤከ መሌ አባን ጭዻ ሱን ህንቤኩ ቱሬ። እንስ ምስርቸ ዋሜ <verse eid="JHN 2:9"/><verse number="10" style="v" sid="JHN 2:10"/>አከነ ጄዼን፤ “ነምን ሁንድ ዳዺ ወይኒ እሰ ጋሪ ጀልቀበት ዽኤሴ፣ ኤርገ ኬሱሞትን መቻአኒ ቦዴሞ ዳዺ እሰ ላፋ ዽኤሰ፤ አት ገሩ ዳዺ ጋሪ ሀመ አማት ቱርስቴ።”<verse eid="JHN 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11"/>ዬሱስ መለቶወንሳ ኬሳ እሰ ጀልቀባ ከነ ቃና ገሊላ ኬሰት ሆጄቴ። ኡልፍነሳስ ንሙልእሴ፤ በረቶትንሳስ እሰት አመነን።<verse eid="JHN 2:11"/></para>
  <para style="s1">ዬሱስ መነ ቁልቁሉማ ቁልቁሌሱሳ</para>
  <para style="r">
    <ref loc="JHN 2:14-16">2፥14‑16</ref> ኩወፈ – <char style="xt"><ref loc="MAT 21:12">ማቴ 21፥12</ref>፣<ref loc="MAT 21:13">13</ref>፤ <ref loc="MRK 11:15-17">ማር 11፥15‑17</ref>፤ <ref loc="LUK 19:45">ሉቃ 19፥45</ref>፣<ref loc="LUK 19:46">46</ref></char></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12"/>ከነ ቦዴስ እን ሃዸሳ፣ ኦቦሎተሳቲፊ በረቶተሳ ወጅን ቅፍርናሆምት ገድ ቡኤ። እሳንስ ጉዮተ ሙራሰ አች ቱረን።<verse eid="JHN 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13"/>ዬሱስስ ዋን ፋሲካን ይሁዶታ ዽኣቴፍ ዬሩሳሌምት ኦል በኤ። <verse eid="JHN 2:13"/><verse number="14" style="v" sid="JHN 2:14"/>መነ ቁልቁሉማ ኬሰትስ ወረ ሰንጎተ፣ ሆሎታፊ ጉጌ ጉርጉረተኒፊ ወረ ታአኒ ማለቀ ጌደረን አርጌ። <verse eid="JHN 2:14"/><verse number="15" style="v" sid="JHN 2:15"/>እንስ ቁንጬራ ቀጬ ዸአቴ ነመ ሁንዱማ ሆሎታፊ ሰንጎተ ወጅን መነ ቁልቁሉማ ኬሳ አርኤ፤ ሳንትመ ወረ ማለቀ ጌደረኒስ ብትኔሴ፤ ምንጃለሳኒስ ገረገልቼ። <verse eid="JHN 2:15"/><verse number="16" style="v" sid="JHN 2:16"/>ወረ ጉጌ ጉርጉረኒንስ፣ <char style="wj">“ከነ ሁንደ አሲ ባሳ! መነ አባኮ መነ ደልደላ ህንጎዽና!”</char> ጄዼ። <verse eid="JHN 2:16"/><verse number="17" style="v" sid="JHN 2:17"/>በረቶትንሳስ፣ “ህናፋን መነኬቲ ነ ጉጉበ”<note caller="+" style="f"><char style="fr" closed="false">2፥17 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 69:9">ፋር 69፥9</ref></char></char></note> ጄዸሜ አከ በሬፈሜ ያደተን።<verse eid="JHN 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18"/>ይሁዶትንስ ዴብሰኒ፣ “ከነ ሁንደ ሆጄቹፍ አከ ታይታ ቀብዱ ምርከኔሱፍ መለቶ ማሊ ኑት አርግሲሱ ደንዴሰ?” ጄዸኒ እሰ ጋፈተን።<verse eid="JHN 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19"/>ዬሱስ፣ <char style="wj">“መነ ቁልቁሉማ ከነ ጅግሳ፤ አንሞ ጉያ ሰዲት ኦልን ዻባ”</char> ጄዼ ዴብሴፍ።<verse eid="JHN 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20"/>ይሁዶትንስ ዴብሰኒ፣ “መነ ቁልቁሉማ ከነ እጃሩን ወጋ አፉርተሚ ጀአ ፉዸቴ፤ አትሞ ጉያ ሰዲ ኬሰት ኦል ዻብዳ?” ጄዸኒን። <verse eid="JHN 2:20"/><verse number="21" style="v" sid="JHN 2:21"/>መን ቁልቁሉማ ከን እን ዋኤሳ ዱበቴ ሱን ገሩ ዸግነሳት። <verse eid="JHN 2:21"/><verse number="22" style="v" sid="JHN 2:22"/>ኤርገ እን ዱኣ ከኤ ቦዴ በረቶትንሳ ዋን እን ዱበቴ ቱሬ ሰነ ያደተን። እሳንስ ከተቢ ቁልቁሉፊ ዱቢ ዬሱስ ዱበቴ አመነን።<verse eid="JHN 2:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23"/>ዬሮ እን አያነ ፋሲካቲፍ ጄዼ ዬሩሳሌም ቱሬት ነሞትን ባይኤን መለቶ እን ሆጄቴ አርገኒ መቃሳት አመነን። <verse eid="JHN 2:23"/><verse number="24" style="v" sid="JHN 2:24"/>ዬሱስ ገሩ ዋን ነመ ሁንደ ቤኩፍ፣ አመኔ እሳንት ኦፍ ህንዺፍኔ። <verse eid="JHN 2:24"/><verse number="25" style="v" sid="JHN 2:25"/>አከ ነምን ቶኮዩ ዋኤ ነማ እሳፍ ዹጋ በኡ እሰ ህንበርባችፍኔ፤ እን ዋን ነመ ኬሰ ጅሩ ቤከ ቱሬቲ።<verse eid="JHN 2:25"/></para>
  <chapter eid="JHN 2"/>
  <chapter number="3" style="c" sid="JHN 3"/>
  <para style="s1">ዬሱስ ኒቆዲሞስን በርሲሱሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1"/>ፈሪስቸ ኒቆዲሞስ ጄዸሙ ቡልቻ ይሁዶታ ቶኮቱ ቱሬ። <verse eid="JHN 3:1"/><verse number="2" style="v" sid="JHN 3:2"/>እንስ ሀልከኒን ዬሱስ ብረ ዸቄ፣ “ያ በርሲሳ፣ አከ አት በርሲሳ ዋቀ ብራ ዹፍቴ ታቴ ኑ ቤክነ፤ ነመ ዋቅን እሰ ወጅን ጅሩ መሌ ነምን መለቶ አት ሆጄቱ ከነ ሆጄቹ ደንደኡ ቶኮዩ ህንጅሩቲ” ጄዼን።<verse eid="JHN 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3"/>ዬሱስስ ዴብሴ፣ <char style="wj">“አን ዹጉመን፣ ዹጉመን ስት ህመ፤ ነምን ዮ ለመተ ዸለቴ መሌ ሞቱማ ዋቃ አርጉ ህንደንደኡ”</char> ጄዼን።<verse eid="JHN 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4"/>ኒቆዲሞስሞ፣ “ነምን ኤርገ ዱሎሜ ቦዴ አከምት ዸለቹ ደንደአ? ዸለቹፍ ጄዼ ለመተ ገደሜሰ ሃዸሳ ኬሰ ሴኑ ደንደኣ?” ጄዼ ጋፈቴ።<verse eid="JHN 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 3:5"/>ዬሱስስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“አን ዹጉመን፣ ዹጉመን ስት ህመ፤ ነምን ዮ ብሻኒፊ ሀፉረራ ዸለቴ መሌ ሞቱማ ዋቃት ገሉ ህንደንደኡ።</char> <verse eid="JHN 3:5"/><verse number="6" style="v" sid="JHN 3:6"/><char style="wj">ከን ፎንራ ዸለቴ ፎን፤ ከን ሀፉረራ ዸለቴ ገሩ ሀፉረ።</char> <verse eid="JHN 3:6"/><verse number="7" style="v" sid="JHN 3:7"/><char style="wj">ጄቸ አን፣ ‘አት ለመተ ዸለቹ ስበርባችሰ ሲን ጄዼ ህንድንቅፈትን።’</char> <verse eid="JHN 3:7"/><verse number="8" style="v" sid="JHN 3:8"/><char style="wj">ቡቤን ገረ ፌዼት ቡብሰ። አትስ ሁርሱሳ ዸጌሰ መሌ አከ እን ኤሳ ዹፌፊ አከ እን ገረምት ዴሙ ህንቤክቱ፤ ነምን ሀፉረራ ዸለቴ ሁንድኑስ አከኑመ።”</char><verse eid="JHN 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9"/>ኒቆዲሞስስ፣ “ኩን አከምት ተኡ ደንደአ?” ጄዼ ጋፈቴ።<verse eid="JHN 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10"/>ዬሱስ አከነ ጄዼ ዴብሴፍ፤ <char style="wj">“አት ኡቱ በርሲሳ እስራኤል ታቴ ጅርቱ ዋን ከነ ህንቤክቱ?</char> <verse eid="JHN 3:10"/><verse number="11" style="v" sid="JHN 3:11"/><char style="wj">አን ዹጉመን፣ ዹጉመን ስት ህመ፤ ኑ ዋን ቤክኑ ዱበትነ፤ ዋን አርግኔስ ዹጋ ንባነ፤ እስን ገሩ ዹጋ በኡምሰኬኘ ህንፉዸተን።</char> <verse eid="JHN 3:11"/><verse number="12" style="v" sid="JHN 3:12"/><char style="wj">እስን ዮ አን ዋን አዱኛ እስንት ህምናን ህንአመንን፣ ዮ አን ዋን ሰሚ እስንት ህሜ አከምት አመንቱሬ?</char> <verse eid="JHN 3:12"/><verse number="13" style="v" sid="JHN 3:13"/><char style="wj">እልመ ነማ እሰ ሰሚራ ገድ ቡኤ መሌ ኤኙዩ ሰሚት ኦል ህንባኔ።</char> <verse eid="JHN 3:13"/><verse number="14" style="v" sid="JHN 3:14"/><char style="wj">አኩመ ሙሴን ገሞጂ ኬሰት ቦፈ ፈንሴ</char><note caller="+" style="f"><char style="fr" closed="false">3፥14 </char><char style="ft" closed="false"><char style="xt"><ref loc="NUM 21:9">ለኮ 21፥9</ref></char></char></note> <char style="wj">ሰነ እልም ነማስ ፈንፈሙ ቀበ።</char> <verse eid="JHN 3:14"/><verse number="15" style="v" sid="JHN 3:15"/><char style="wj">ኩንስ አከ ነምን እሰት አመኑ ሁንድ ጅሬኘ በረ በራ ቀባቱፍ።”</char><verse eid="JHN 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 3:16"/>ከን እሰት አመኑ ሁንድ ጅሬኘ በረ በራ አከ ቀባቱፍ መሌ አከ ህንበድኔፍ፣ ዋቅን ሀመ እልመሳ ቶክቸ ኬኑት አዱኛ ጃለቴራቲ። <verse eid="JHN 3:16"/><verse number="17" style="v" sid="JHN 3:17"/>ዋቅን ከራሳቲን አዱኛ ፈይሱዻፍ መሌ አዱኛት ሙሩፍ እልመሳ ገረ አዱኛት ህንኤርግኔቲ። <verse eid="JHN 3:17"/><verse number="18" style="v" sid="JHN 3:18"/>ከን እሰት አመኑት ህንሙረሙ፤ ከን እሰት ህንአመኔ ገሩ ዋን እን መቃ እልመ ዋቃ ቶክቻት ህንአመንኒፍ አሙመዩ እት ሙረሜረ። <verse eid="JHN 3:18"/><verse number="19" style="v" sid="JHN 3:19"/>ሙርቲን ሱንስ እሰ ከነ፦ እፍን ገረ አዱኛ ዹፌ፤ ነሞትን ገሩ ዋን ሆጂንሳኒ ሀማ ቱሬፍ እፈ ጫላ ዱከነ ጃለተን። <verse eid="JHN 3:19"/><verse number="20" style="v" sid="JHN 3:20"/>ነምን ዋን ሀማ ሆጄቱ ከምዩ እፈ ጅበ፤ አከ ሆጂንሳ እፈት ህንባፈምኔፍስ ገረ እፋ ህንዹፉ። <verse eid="JHN 3:20"/><verse number="21" style="v" sid="JHN 3:21"/>ነምን ዹጋ ሆጄቱ ከምዩ ገሩ አከ ሆጂንሳ አከ ፌዺ ዋቃት ሆጄተሙንሳ ሙልአቱፍ ገረ እፋ ዹፈ።<verse eid="JHN 3:21"/></para>
  <para style="s1">ዮሀንስ ጩጳን ዋኤ ዬሱስ ዹጋ በኤ</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22"/>ኤርገሲስ ዬሱሲፊ በረቶትንሳ ገረ ብየ ይሁዳ ዸቀን፤ እንስ እሳን ወጅን አች ቱሬ፤ ንጩጴስ። <verse eid="JHN 3:22"/><verse number="23" style="v" sid="JHN 3:23"/>ዮሀንስስ ናኖ ሳሌም እዶ ሄኖን ጄዸሙት ንጩጰ ቱሬ፤ ብሻን ባይኤን አች ቱሬቲ፤ ነሞትንስ አች ዸቀኒ ጩጰሙ ቱረን። <verse eid="JHN 3:23"/><verse number="24" style="v" sid="JHN 3:24"/>ኩንስ ኡቱ ዮሀንስ መነ ህዻት ህንገልፈምን ተኤ። <verse eid="JHN 3:24"/><verse number="25" style="v" sid="JHN 3:25"/>ዮሙስ በረቶተ ዮሀንሲፊ ይሁዲ ቶኮ ግዱት ዋኤ ቁልቁሌፈሙ እረት ወል ፈልሚን ኡመሜ። <verse eid="JHN 3:25"/><verse number="26" style="v" sid="JHN 3:26"/>እሳንስ ዮሀንስ ብረ ዹፈኒ፣ “ያ በርሲሳ፣ ነምች ሲ ወጅን ዮርዳኖስ ገመ ቱሬ፣ ከን አት ዋኤሳ ዹጋ ባቴ ሱን ኩኖ ጩጱት ጅረ፤ ነምን ሁንድስ ገረሳ ዸቁት ጅረ” ጄዸኒን።<verse eid="JHN 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27"/>ዮሀንስስ አከነ ጄዼ ዴብሴ፤ “ነምን ዮ ሰሚራ እሳፍ ኬነሜ መሌ ሆማ ፉዸቹ ህንደንደኡ። <verse eid="JHN 3:27"/><verse number="28" style="v" sid="JHN 3:28"/>አከ አን፣ ‘አን ክርስቶስ ምት፤ ገሩ እሰ ዱረ ነንኤርገሜ’ ጄዼ እስን መታንኬሰንዩ ዹጋ ናፍ ባቱ። <verse eid="JHN 3:28"/><verse number="29" style="v" sid="JHN 3:29"/>ምስርቲን ከን ምስርቻት። ሚንጄን ምስርቸ ብረ ዻበቱፊ እሰ ዸጌፈቱ፣ ዮሙ ሰገሌ ምስርቻ ዸገኡት አከ መሌ ገመደ። ገመቹን ሱን ከንኮት፤ ገመቹንኮስ አመ ጉቱ ተኤረ። <verse eid="JHN 3:29"/><verse number="30" style="v" sid="JHN 3:30"/>እን ጉዳ ተኡ ቀበ፤ አንሞ ጥና ተኡን ቀበ።<verse eid="JHN 3:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31"/>“ከን ኦሊ ዹፉ እን ሁንዱማ ኦል፤ እን ለፋሞ ከኑመ ለፋት፤ ዋኑመ ለፋ ዱበተስ። ከን ሰሚራ ዹፉ እን ሁንዱማ ኦል። <verse eid="JHN 3:31"/><verse number="32" style="v" sid="JHN 3:32"/>እን ዋን አርጌፊ ዋን ዸገኤ ዹጋ በአ፤ ዹገ በኡምሰሳ ገሩ ኤኙዩ ህንፉዸቱ። <verse eid="JHN 3:32"/><verse number="33" style="v" sid="JHN 3:33"/>ነምን ዹገ በኡምሰ ከነ ፉዸቴስ አከ ዋቅን ዹጋ ተኤ ምርከኔሴ። <verse eid="JHN 3:33"/><verse number="34" style="v" sid="JHN 3:34"/>እን ዋቅን ኤርጌ ዱቢ ዋቃ ዱበተ፤ ዋቅንስ ሰፈረ መሌ ሀፉረሳ ንኬናቲ። <verse eid="JHN 3:34"/><verse number="35" style="v" sid="JHN 3:35"/>አባን እልመ ንጃለተ፤ ዋን ሁንደስ ሀርከሳት ኬኔረ። <verse eid="JHN 3:35"/><verse number="36" style="v" sid="JHN 3:36"/>ነምን እልመት አመኑ ጅሬኘ በረ በራ ቀበ፤ ነምን እልማፍ ህንአጀጀምኔ ገሩ ዼከምሰ ዋቃቱ እሰረ ጅራተ መሌ ጅሬኘ ህንአርጉ።”<verse eid="JHN 3:36"/></para>
  <chapter eid="JHN 3"/>
  <chapter number="4" style="c" sid="JHN 4"/>
  <para style="s1">ዬሱሲፊ ዱበርቲ ሰማርያ ቶኮ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1"/>ኤጋ ዬሱስ ዮሀንስ ጫላ በረቶተ አከ ባይእፈቴፊ አከ ጩጴ ፈሪሶትን ዸገኡሳኒ ጎፍታን ንቤኬ፤ <verse eid="JHN 4:1"/><verse number="2" style="v" sid="JHN 4:2"/>ተኡስ በረቶተሳቱ ጩጳ ቱሬ መሌ ዬሱስ ኦፊሳቲ ህንጩጵኔ። <verse eid="JHN 4:2"/><verse number="3" style="v" sid="JHN 4:3"/>እን ይሁዳ ዺሴ አመሌ ገሊላት ዴብኤ።<verse eid="JHN 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 4:4"/>እንስ ሰማርያ ኬሰ ደርቡ ቀበ ቱሬ። <verse eid="JHN 4:4"/><verse number="5" style="v" sid="JHN 4:5"/>ከናፉ ገረ መጋላ ሰማርያ ከን ሲካር ጄዸሙ ቶኮ ዹፌ፤ መጋላን ሱንስ ለፈ ያቆብ እልመሳ ዮሴፊፍ ኬኔ ሰነት ዽኦዸ። <verse eid="JHN 4:5"/><verse number="6" style="v" sid="JHN 4:6"/>ቦል ብሻኒ ከን ያቆብ ቶኮ አች ቱሬ፤ ዬሱስስ ዋን ከራ ዴሙዻን ደዸቤፍ ቦለ ብሻኒ ሰነ ብረ ታኤ። ዬሮንስ ገረ ሰኣቲ ጀኣ ቱሬ።<verse eid="JHN 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7"/>ዱበርቲን ሰማርያ ቶኮስ ብሻን ወራበቹ ዹፍቴ፤ ዬሱስስ፣ <char style="wj">“ሜ ነ ኦባስ”</char> ጄዼን። <verse eid="JHN 4:7"/><verse number="8" style="v" sid="JHN 4:8"/>በረቶትንሳ ኛተ ብቱፍ ገረ መጋላ ዸቀኒ ቱረኒቲ።<verse eid="JHN 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9"/>ዱበርቲን ሰማርያ ሱንስ ዬሱሲን፣ “አት ኡቱ ይሁዲ ታቴ ጅርቱ አከምት ‘ነ ኦባስ’ ጄቴ አነ ዱበርቲ ሰማርያ ከዸተ?” ጄቴን። ይሁዶትን ወረ ሰማርያ ወጅን ወልት ዹፌኘ ህንቀበን ቱሬቲ።<verse eid="JHN 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10"/>ዬሱስስ ዴብሴ፣ <char style="wj">“ኬና ዋቃቲፊ እን፣ ‘ነ ኦባስ’ ሲን ጄዹ ኩን ኤኙ አከ ተኤ ኡቱ ቤክቴ ስላ ስቱ እሰ ከዸተ ቱሬ፤ እንስ ብሻን ጅሬኛ ሲፍ ኬነ ቱሬ”</char> ጄዼን።<verse eid="JHN 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11"/>ዱበርትቲንስ አከነ ጄቴን፤ “ያ ጎፍታ፣ አት ዋን እቲን ወራበቱ ህንቀብዱ፤ ቦል ብሻኒ ኩንስ ገድ ፈጎዸ። ዮስ ብሻን ጅሬኛ ኤሳ አርገተ? <verse eid="JHN 4:11"/><verse number="12" style="v" sid="JHN 4:12"/>አት አባኬኘ ያቆብ እሰ ቦለ ብሻኒ ከነ ኑ ኬኔ ጫልተሞ? እን መታንሳ፣ እጆሌንሳቲፊ ሆሪንሳ ቦለ ብሻኒ ከነ ኬሳ ዹጋ ቱረን።”<verse eid="JHN 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13"/>ዬሱስሞ አከነ ጄዼ ዴብሴ፤ <char style="wj">“ነምን ብሻን ከነ ዹጉ ሁንድኑ ዴብኤ ንዼቦተ፤</char> <verse eid="JHN 4:13"/><verse number="14" style="v" sid="JHN 4:14"/><char style="wj">ገሩ ነምን ብሻን አን እሳፍ ኬኑ ዹጉ ከምዩ ጎንኩማ ህንዼቦቱ። ብሻን አን እሳፍ ኬኑ እሰ ኬሰት ቡርቃ ብሻኒ እሰ ጅሬኘ በረ በራቲፍ ቡርቁ ንተአ።”</char><verse eid="JHN 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15"/>ዱበርትቲንስ፣ “ያ ጎፍታ፣ አከ አን ህንዼቦትኔፍ፣ ብሻን ወራቡፍስ አከ አን አስ ህንዹፍኔፍ ብሻን ሰነ ናፍ ኬን” ጄቴን።<verse eid="JHN 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 4:16"/>ዬሱስሞ፣ <char style="wj">“ዸቂቲ ዽርሰኬ ዋሚ ኮቱ!”</char> ጄዼን።<verse eid="JHN 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17"/>ዱበርትቲን፣ “አን ዽርሰ ህንቀቡ” ጄቴን።</para>
  <para style="p" vid="JHN 4:17">ዬሱስስ አከነ ጄዼን፤ <char style="wj">“ዽርሰ ህንቀቡ ጄቹንኬ ስሪዸ፤</char> <verse eid="JHN 4:17"/><verse number="18" style="v" sid="JHN 4:18"/><char style="wj">አት ዽርሶተ ሸን ቀብደ ቱርቴቲ፤ ነምች አመ ስ ወጅን ጅሩስ ዽርሰኬ ምት። ወን አት አመ ዱበቴ ዹጋዸ።”</char><verse eid="JHN 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19"/>ዱበርትቲንስ አከነ ጄቴ፤ “ያ ጎፍታ፣ አከ አት ራጂ ታቴ ነንሁበዸ። <verse eid="JHN 4:19"/><verse number="20" style="v" sid="JHN 4:20"/>አቦቲንኬኘ ቱሉ ከነረት ሰገዳ ቱረን፤ እስን ይሁዶትን ገሩ እዶን ነምን እት ዋቄፈቹ ቀቡ ዬሩሳሌም ጄቱ።”<verse eid="JHN 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21"/>ዬሱስስ አከነ ጄዼን፤ <char style="wj">“ዱበርቲነነ፣ ነ አመን፤ ዬሮን እስን እት ቱሉ ከነረትስ ተኡ ዮካን ዬሩሳሌምት አባ ህንዋቄፈትኔ ቶኮ ንዹፈ።</char> <verse eid="JHN 4:21"/><verse number="22" style="v" sid="JHN 4:22"/><char style="wj">እስን ከን ህንቤክኔ ዋቄፈቱ፤ ኑ ሰበቢ ፈይን ይሁዶተ ኬሳ ዹፉፍ ከን ቤክኑ ዋቄፈትነ።</char> <verse eid="JHN 4:22"/><verse number="23" style="v" sid="JHN 4:23"/><char style="wj">ወር ዹጋዻን ዋቄፈተን ዬሮን እሳን እት ሀፉራፊ ዹጋዻን አባ ዋቄፈተን ቶኮ ንዹፈ፤ አመዩ ዹፌረ፤ አባን ወረ አከስት እሰ ዋቄፈተን በርባደ።</char> <verse eid="JHN 4:23"/><verse number="24" style="v" sid="JHN 4:24"/><char style="wj">ዋቅን ሀፉረ፤ ወር እሰ ዋቄፈተንስ ሀፉራፊ ዹጋዻን ዋቄፈቹ ቀቡ።”</char><verse eid="JHN 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25"/>ዱበርትቲንስ፣ “አን አከ መሲሂን ክርስቶስ ጄዸሙ ዹፉ ነንቤከ። እን ዮሙ ዹፉት ዋን ሁንደ ኑት ህመ” ጄቴን።<verse eid="JHN 4:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 4:26"/>ዬሱስስ፣ <char style="wj">“አን ነምን አመ ስት ዱበቻ ጅሩ ኩን እሱመ”</char> ጄዼን።<verse eid="JHN 4:26"/></para>
  <para style="s1">በረቶትን ገረ ዬሱስት ዴብኡሳኒ</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27"/>በረቶትንሳ ዮሙሱመ ዴብአኒ ኡቱ እን ዱበርቲ ቶኮ ወጅን ዱበቱ አርገኒ ድንቅሲፈተን። ገሩ ነምን፣ “ማል በርባደ?” ዮካን “ማሊፍ እሼ ወጅን ሃሶፍተ?” ጄዼ እሰ ጋፈቱ ቶኮዩ ህንቱሬ።<verse eid="JHN 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28"/>ዱበርቲን ሱንስ ኦኮቴሼ ዺፍቴ ገረ መጋላት ዴብቴ፤ ነሞታንስ አከነ ጄቴ፤ <verse eid="JHN 4:28"/><verse number="29" style="v" sid="JHN 4:29"/>“ኮታቲ ነመ ዋን አን ሆጄዼ ሁንደ ነት ህሜ ቶኮ እላላ! ተሪ እን ክርስቶስ ተእና?” <verse eid="JHN 4:29"/><verse number="30" style="v" sid="JHN 4:30"/>እሳንስ መጋላ ኬሳ በአኒ ዬሱስ ብረ ዹፈን።<verse eid="JHN 4:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31"/>ከነ ግዱት በረቶትንሳ፣ “ያ በርሲሳ፣ ሜ ዋ ኛዹ!” ጄዸኒ እሰ ከዸተን።<verse eid="JHN 4:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32"/>እን ገሩ፣ <char style="wj">“አን ኛተ እስን ህንቤክኔ ከነን ኛዹ ቀበ”</char> ጄዼን።<verse eid="JHN 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33"/>በረቶትንሳስ፣ “ነመቱ ኛተ ፍዴፊ ላተ?” ጄዸኒ ወል ጋፈተን።<verse eid="JHN 4:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34"/>ዬሱስሞ አከነ ጄዼን፤ <char style="wj">“ኛትንኮ ፌዺ እሰ ነ ኤርጌ ጉቱፊ ሆጂሳ ራወቹዸ።</char> <verse eid="JHN 4:34"/><verse number="35" style="v" sid="JHN 4:35"/><char style="wj">እስን፣ ‘ጅአ አፉርቱ ሀፌ፤ ኤርገሲ ምዻን ወልት ቀበመ’ ጄቱ ምቲ? ኩኖ፣ አን እስንተን ህመ፤ አከ ምዻን ብልቻቴ ወልት ቀበሙ ገኤ ሜ ኦል ጄዻቲ ለፈ ቆቲሳ እላላ!</char> <verse eid="JHN 4:35"/><verse number="36" style="v" sid="JHN 4:36"/><char style="wj">እን ምዻን ሃሙ አመዩ ምንዳ ንአርገተ፤ ጅሬኘ በረ በራቲፍ እጀ ወልት ንቀበ፤ ኩንስ አከ እን ፈጫሱፊ እን ወልት ቀቡ ወሊን ገመደኒፍ።</char> <verse eid="JHN 4:36"/><verse number="37" style="v" sid="JHN 4:37"/><char style="wj">ሃለ ከናን መማክስ፣ ‘እን ቶኮ ንፈጫሰ፤ ካንሞ ንሃመ’ ጄዹ ሱን ዹጋዸ።</char> <verse eid="JHN 4:37"/><verse number="38" style="v" sid="JHN 4:38"/><char style="wj">አን አከ እስን ዋን እት ህንደዸብን ሃመተኒፈን እስን ኤርጌ። ወር ካን እት ደዸበኒሩ፤ እስን ገሩ ቡኣ ደዸቢሳኒ ገልፈተን።”</char><verse eid="JHN 4:38"/></para>
  <para style="s1">ነሞትን ሰማርያ ባይኤን አመኑሳኒ</para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39"/>ሰበቢ ዱበርትቲን፣ “እን ዋን አን ሆጄዼ ሁንደ ነት ህሜ” ጄቴ ዹጋ ባቴፍ ነሞትን ሰማርያ ወር መጋላ ሰና ባይኤን እሰት አመነን። <verse eid="JHN 4:39"/><verse number="40" style="v" sid="JHN 4:40"/>ከናፉ ነሞትን ሰማርያ ዮሙ ገረሳ ዹፈንት አከ እን እሳን ወጅን ቱሩፍ እሰ ከዸተን፤ እንስ ጉያ ለመ አች ቱሬ። <verse eid="JHN 4:40"/><verse number="41" style="v" sid="JHN 4:41"/>ሰበቢ ዱቢሳቲንስ ነሞትን ብራ ባይኤን እሰት አመነን።<verse eid="JHN 4:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 4:42"/>እሳንስ ዱበርትቲዻን፣ “ስአች ወን ኑ አመኑፍ ሰበቢ ዱቢ አት ኑት ህምቴ ሰናቲፊ ምት፤ ኑ መታንኬኘዩ እሰ ዸጌኜራቲ፤ አከ እን ዹጉማን ፈይሳ አዱኛ ተኤስ ቤክኔረ” ጄዸን።<verse eid="JHN 4:42"/></para>
  <para style="s1">ዬሱስ እልመ ቆንዳለ ቶኮ ፈይሱሳ</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43"/>ጉያ ለማን ሰነ ቦዴ ዬሱስ ገሊላ ዸቄ። <verse eid="JHN 4:43"/><verse number="44" style="v" sid="JHN 4:44"/>ዬሱስ መታንሳዩ አከ ራጂን ቶኮ ብየሳ ኬሰት ከበጀ ህንቀብኔ ዱበቴ ቱሬቲ። <verse eid="JHN 4:44"/><verse number="45" style="v" sid="JHN 4:45"/>ዮሙ እን ገሊላ ገኤትስ ወር ገሊላ እሰ ስመተን። እሳንስ ሰበቢ ዬሩሳሌም ቱረኒፍ ዋን እን ዬሮ አያነ ፋሲካት አችት ሆጄቴ ሁንደ አርገኒ ቱረን።<verse eid="JHN 4:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46"/>ከናፉ እን ዴብኤ ገረ ቃና እሼ ገሊላ ኬሳ እዶ እት ብሻን ገረ ዳዺ ወይኒት ጌደሬ ቱሬ ሰና ዸቄ። ቆንዳል ሞቲ ከን እልምሳ ዹኩብሰቴ ቶኮስ ቅፍርናሆም ኬሰ ቱሬ። <verse eid="JHN 4:46"/><verse number="47" style="v" sid="JHN 4:47"/>ነምች ኩንስ ዮሙ አከ ዬሱስ ይሁዳዻ ከኤ ገሊላ ዹፌ ዸገኤት እሰ ብረ ዸቄ አከ እን ዹፌ እልመሳ ከን ዱኡ ገኤ ሰነ ፈይሱ እሰ ከዸቴ።<verse eid="JHN 4:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 4:48"/>ከነረት ዬሱስ፣ <char style="wj">“እስን ዮ መለቶፊ ድንቂ አርግተን መሌ ህንአመንተን!”</char> እሳን ጄዼ።<verse eid="JHN 4:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49"/>ቆንዳልትችስ፣ “ያ ጎፍታ፣ ማሎ ኡቱ ሙጫንኮ ህንዱእን ናፍ ቀቀብ” ጄዼን።<verse eid="JHN 4:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50"/>ዬሱስስ፣ <char style="wj">“እልምኬ ንጅራታቲ ገል!”</char> ጄዼን።</para>
  <para style="p" vid="JHN 4:50">ነምችስ ዋን ዬሱስ እሰት ዱበቴ አመኔ ዴሜ። <verse eid="JHN 4:50"/><verse number="51" style="v" sid="JHN 4:51"/>ኡቱ እን ዴማ ጅሩስ ተጃጅልቶትንሳ እት ዹፈኒ አከ እልምሳ ሉቡን ጅሩ እት ህመን። <verse eid="JHN 4:51"/><verse number="52" style="v" sid="JHN 4:52"/>እንስ ዬሮ እት ሙጫሳት ወያኤ ጋፈቴ፤ እሳንስ፣ “ከሌሰ ሰኣቲ ቶርበት ዸግነ ጉባን እሰ ዺሴ” ጄዸኒን።<verse eid="JHN 4:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 4:53"/>አባን ሙጭቻስ አከ ዬሮን ሱን ዬሮ ዬሱስ እት፣ <char style="wj">“እልምኬ ንጅራተ”</char> ጄዼን ተኤ ሁበቴ። ከናፉ እንስ፣ ወር መነሳ ሁንድኑስ ንአመነን።<verse eid="JHN 4:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54"/>ኩን መለቶ ለመፋ ዬሱስ ኤርገ ይሁዳዻ ገሊላ ዹፌ ሆጄቴዸ።<verse eid="JHN 4:54"/></para>
  <chapter eid="JHN 4"/>
  <chapter number="5" style="c" sid="JHN 5"/>
  <para style="s1">ዬሱስ ቤተ ሳይዳት ዹኩብሰታ ፈይሱሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1"/>ዬሮ ጥኖ ቦዴ አያነ ይሁዶታ ቶኮቱ ቱሬ፤ ዬሱስስ ዬሩሳሌምት ኦል በኤ። <verse eid="JHN 5:1"/><verse number="2" style="v" sid="JHN 5:2"/>ዬሩሳሌም ኬሰ ከረ ሆላ ብረ ሀሮ አፋን እብራይስጢቲን ቤተ ሳይዳ ጄዸሙ ቶኮቱ ጅረ፤ ሀሮትን ሱን ገርዳፎ ሸን ቀበ። <verse eid="JHN 5:2"/><verse number="3" style="v" sid="JHN 5:3"/>ገርዳፎወን ሰነ ኬሰስ ነሞትን ዹኩብሰተን፣ ጄቹንስ ጃሞትን፣ ወር ናፈተኒፊ ወር ዸግን እረት ዱኤ ባይኤን ጪሰኒ ራፈመ ብሻኒ ኤገቻ ቱረን። [ <verse eid="JHN 5:3"/><verse number="4" style="v" sid="JHN 5:4"/>ኤርገማን ጎፍታ ዬሮ ዬሮት ገድ ቡኤ ብሻንቸ ንራሰ ቱሬ፤ ራፈመ ብሻንቻ ቦዴ ነምን ጀልቀበት ብሻን ሰነ ኬሰ ሴኑ ከምዩ ዹኩበ ቀቡ ሁንደራ ንፈየ ቱሬ።]<note caller="+" style="f"><char style="fr" closed="false">5፥4 </char><char style="ft" closed="false">ወራብሌን ዱሪ ቶኮ ቶኮ ኩታ ወለካ ሉቅሳ 3 እራ ጀልቀቤ ሀመ ሉቅሳ 4 ጅሩ ህንቀበን።</char></note> <verse eid="JHN 5:4"/><verse number="5" style="v" sid="JHN 5:5"/>ነምች ወጋ ሶዶሚ ሰዴት ዹኩብሰቴ ቶኮ አች ቱሬ። <verse eid="JHN 5:5"/><verse number="6" style="v" sid="JHN 5:6"/>ዬሱስስ ዮሙ እሳ አች ጪሱ አርጌ አከ እን ዬሮ ዼራ ሃለ ከነ ኬሰ ቱሬ ቤኬት፣ <char style="wj">“አት ፈዩ በርባዳ?”</char> ጄዼ እሰ ጋፈቴ።<verse eid="JHN 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7"/>ዹኩብሰታን ሱንስ፣ “ያ ጎፍታ፣ አን ነመ ነ ገርጋሬ ዮሙ ብሻንች ራፈሙት ሀሮ ሰነ ኬሰ ነ ቡሱ ህንቀቡ። ዬሮ አን ሴኑ ያሉትስ ነምን ብራ ነ ዱርሴ ሴነ” ጄዼን።<verse eid="JHN 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8"/>ከነረት ዬሱስ፣ <char style="wj">“ከእ! ስሬኬ ፉዸዹቲ ዴም”</char> ጄዼን። <verse eid="JHN 5:8"/><verse number="9" style="v" sid="JHN 5:9"/>ነምችስ ዬሩመ ሰነ ፈዬ፤ ስሬሳስ ፉዸቴ ዴሜ።</para>
  <para style="p" vid="JHN 5:9">ጉያን ወን ኩን ተኤ ሱንስ ሰንበተ ቱሬ፤ <verse eid="JHN 5:9"/><verse number="10" style="v" sid="JHN 5:10"/>ይሁዶትንስ ነምቸ ፈዬ ሰናን፣ “ሀርአ ሰንበተ፤ ሴር ስሬኬ ባቹ ስዾወ” ጄዸኒን።<verse eid="JHN 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11"/>እን ገሩ፣ “ነምቸ ነ ፈይሴቱ <char style="wj">‘ስሬኬ ፉዸዹ ዴም’</char> ናን ጄዼ” ጄዼን።<verse eid="JHN 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12"/>እሳንስ፣ “ነምች ስሬኬ ፉዸዹ ዴም ሲን ጄዼ ሱን ኤኙ?” ጄዸኒ እሰ ጋፈተን።<verse eid="JHN 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13"/>ነምች ፈዬ ሱን ሰበቢ ዬሱስ አች ሂቄ ቱተ እዶ ሰነ ቱሬ ኬሰ ሴኔፍ እን ኤኙ አከ ተኤ ህንቤክኔ።<verse eid="JHN 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14"/>ዬሱስስ ኤርገሲ ነምቸ ሰነ መነ ቁልቁሉማ ኬሰት አርጌ፣ <char style="wj">“አት ኩኖ አመ ፈይቴርተ። ወን ከነ ጫሉ አከ ስት ህንዹፍኔፍ ስአች ጩቡ ህንሆጄትን”</char> ጄዼን። <verse eid="JHN 5:14"/><verse number="15" style="v" sid="JHN 5:15"/>ነምችስ ዸቄ ከን እሰ ፈይሴ ዬሱስ አከ ተኤ ይሁዶተት ህሜ።<verse eid="JHN 5:15"/></para>
  <para style="s1">ጅሬኘ እልም ኬኑ</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 5:16"/>ከናፉ ሰበቢ እን ጉያ ሰንበታቲን ዋን ከነ ሆጄቴፍ፣ ይሁዶትን ዬሱስን አርአቹ ጀልቀበን። <verse eid="JHN 5:16"/><verse number="17" style="v" sid="JHN 5:17"/>ዬሱስ ገሩ፣ <char style="wj">“አባንኮ ሀመ አማት ሆጄቻ ጅረ፤ አንስ ሆጄቻን ጅረ”</char> እሳኒን ጄዼ። <verse eid="JHN 5:17"/><verse number="18" style="v" sid="JHN 5:18"/>ሰበቢ ከናፍ ይሁዶትን እቱመ ጫልችሰኒ እሰ አጄሱ በርባደን፤ እን ዋቃን ኦፍ ቅጤሱዻን ዋቀዩ አባ ኦፊሳ ጎዼ ዋማ ቱሬ መሌ ሰንበተ ቆፈ ህንጨብስኔ።<verse eid="JHN 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19"/>ዬሱስሞ አከነ ጄዼ ዴብሴፍ፤ <char style="wj">“አን ዹጉመን፣ ዹጉመን እስንት ህመ፤ እልም ኦፊሳቲን ዋን ቶኮሌ ሆጄቹ ህንደንደኡ፤ እን ዋኑመ ኡቱ አባንሳ ሆጄቱ አርጌ ቆፈ ሆጄቹ ደንደአ፤ ዋኑመ አባን ሆጄቱ እልምስ አከሱመ ሆጄታቲ።</char> <verse eid="JHN 5:19"/><verse number="20" style="v" sid="JHN 5:20"/><char style="wj">አባን እልመ ንጃለታቲ፤ ዋን ሆጄቱ ሁንዱመስ እሰት ንአርግሲሰ። አከ እስን ድንቅሲፈተኒፍስ እን ሆጂወን ሆጂወን ከኔን ጫለንዩ እሰት ንአርግሲሰ።</char> <verse eid="JHN 5:20"/><verse number="21" style="v" sid="JHN 5:21"/><char style="wj">አኩመ አባን ወረ ዱአን ዱኣ ካሴ ጅሬኘ ኬኑፍ ሰነ፣ እልምስ አከሱመ አባ ፌዼፍ ጅሬኘ ንኬነ።</char> <verse eid="JHN 5:21"/><verse number="22" style="v" sid="JHN 5:22"/><char style="wj">አባን ኤኙትሌ ህንሙሩ፤ ሙርቲ ሁንደ ገሩ እልመት ኬኔረ፤</char> <verse eid="JHN 5:22"/><verse number="23" style="v" sid="JHN 5:23"/><char style="wj">ኩንስ አከ ነምን ሁንድ አኩመ አባፍ ኡልፍነ ኬኑት እልማፍስ ኡልፍነ ኬኑፍ። ነምን እልማፍ ኡልፍነ ህንኬንኔ፣ አባ እሰ እልመ ኤርጌፍስ ኡልፍነ ህንኬኑ።</char><verse eid="JHN 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24"/>
    <char style="wj">“አን ዹጉመን፣ ዹጉመን እስንት ህመ፤ ነምን ዱቢኮ ዸገኡ፣ እሰ ነ ኤርጌትስ ከን አመኑ ሁንድ ጅሬኘ በረ በራ ቀበ፤ ሙርቲትስ ህንዽኣቱ፤ እን ዱአ ጀላ ገረ ጅሬኛት ደርቤረ።</char> <verse eid="JHN 5:24"/><verse number="25" style="v" sid="JHN 5:25"/><char style="wj">አን ዹጉመን፣ ዹጉመን እስንት ህመ፤ ዬሮን ወር ዱአን እት ሰገሌ እልመ ዋቃ ዸገአን ቶኮ ንዹፈ፤ አሙመዩ ዹፌረ፤ ወር ዸገአንስ ንጅራቱ።</char> <verse eid="JHN 5:25"/><verse number="26" style="v" sid="JHN 5:26"/><char style="wj">አኩመ አባን ኦፉመሳቲን ጅሬኘ ቀቡ ሰነ፣ እልምስ አከሱመ አከ ኦፉመሳቲን ጅሬኘ ቀባቱፍ እሳፍ ኬኔራቲ።</char> <verse eid="JHN 5:26"/><verse number="27" style="v" sid="JHN 5:27"/><char style="wj">ሰበቢ እን እልመ ነማ ተኤፍስ አከ እን ሙርቲ ኬኑፍ አባን ታይታ እሳፍ ኬኔረ።</char><verse eid="JHN 5:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 5:28"/>
    <char style="wj">“ከነ ህንድንቅሲፈትና፤ ሰኣቲን እት ወር አዋለ ኬሰ ጅረን ሁንድ ሰገሌሳ ዸገአን ቶኮ ንዹፋቲ።</char> <verse eid="JHN 5:28"/><verse number="29" style="v" sid="JHN 5:29"/><char style="wj">ወር ዋን ጋሪ ሆጄተን ዱኣ ከኡ ጅሬኛቲፍ፣ ወር ዋን ሀማ ሆጄተንሞ ዱኣ ከኡ ሙርቲቲፍ ዱኣ ንከኡ።</char> <verse eid="JHN 5:29"/><verse number="30" style="v" sid="JHN 5:30"/><char style="wj">አን ኦፊኮቲን ዋን ቶኮሌ ጎቹ ህንደንደኡ፤ አን አኩመን ዸገኡት ነንሙርቴሰ፤ አን ፌዺ እሰ ነ ኤርጌ መሌ ፌዺ መታኮቲ ዋን ህንበርባድኔፍ ሙርቲንኮ ቀጄላዸ።</char><verse eid="JHN 5:30"/></para>
  <para style="s1">ዹገ በኡምሰ ዋኤ ዬሱስ</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31"/>
    <char style="wj">“አን ዮን ዋኤ ኦፊኮቲ ዹጋ በኤ፣ ዹገ በኡምስኮ ዹጋ ምት።</char> <verse eid="JHN 5:31"/><verse number="32" style="v" sid="JHN 5:32"/><char style="wj">ገሩ ከን ዋኤኮ ዹጋ በኡ ብራ ጅረ፤ አንስ አከ ዹገ በኡምስ እን ዋኤኮ ኬኑ ሱን ዹጋ ተኤ ቤከ።</char><verse eid="JHN 5:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 5:33"/>
    <char style="wj">“እስን ዮሀንስት ኤርግተኒርቱ፤ እንስ ዹጋ ሰናፍ፣ ዹጋ በኤረ።</char> <verse eid="JHN 5:33"/><verse number="34" style="v" sid="JHN 5:34"/><char style="wj">አን ዹገ በኡምሰ ነማ ህንፉዸዹ፤ ገሩ አከ እስን ፈይተኒፍ ወንቶተ ከኔን ነንዱበዸ።</char> <verse eid="JHN 5:34"/><verse number="35" style="v" sid="JHN 5:35"/><char style="wj">ዮሀንስ እብሳ ቦበኤ እፈ ኬኑ ቱሬ፤ እስንስ ዬሮ ጥኖ እፈሳት ገመዱ በርባደን።</char><verse eid="JHN 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 5:36"/>
    <char style="wj">“አን ገሩ ዹገ በኡምሰ፣ ዹገ በኡምሰ ዮሀንስ ሰነ ጫሉ ቀበ። ሆጂን አከ አን ራወዹፍ አባን ነት ኬኔ፣ ከን አን ሆጄዹ ኩንዩ አከ አባን ነ ኤርጌ ምርከኔሳቲ።</char> <verse eid="JHN 5:36"/><verse number="37" style="v" sid="JHN 5:37"/><char style="wj">አባን እን ነ ኤርጌስ ኦፊሳቲ ዋኤኮ ዹጋ በኤረ። እስን ተኩማ ሰገሌሳ ህንዸጌኜ፤ ብፈሳስ ተኩማ ህንአርግኔ።</char> <verse eid="JHN 5:37"/><verse number="38" style="v" sid="JHN 5:38"/><char style="wj">እስን ሰበቢ እሰ እን ኤርጌ ህንአመንኒፍ ዱቢንሳ እስን ኬሰ ህንጅራቱ።</char> <verse eid="JHN 5:38"/><verse number="39" style="v" sid="JHN 5:39"/><char style="wj">እስን ከተቢወን ቁልቁሉዻን ጅሬኘ በረ በራ አርገትነ ጄተኒ ዋን ያደኒፍ ከተቢወን ቁልቁሉ ሰነ ቆረቱ። ከተቢወን ቁልቁሉን ኩኔንስ ዋኤኮ ዹጋ በኡ፤</char> <verse eid="JHN 5:39"/><verse number="40" style="v" sid="JHN 5:40"/><char style="wj">እስን ገሩ ጅሬኘ አርገቹዻፍ ገረኮ ዹፉ ህንበርባደን።</char><verse eid="JHN 5:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41"/>
    <char style="wj">“አን ነመራ ኡልፍነ ህንፉዸዹ፤</char> <verse eid="JHN 5:41"/><verse number="42" style="v" sid="JHN 5:42"/><char style="wj">ገሩ አከ እስን ጃለለ ዋቃ ኦፍ ኬሳ ህንቀብኔ ነንቤከ።</char> <verse eid="JHN 5:42"/><verse number="43" style="v" sid="JHN 5:43"/><char style="wj">አን መቃ አባኮቲን ዹፌረ፤ እስን ነ ህንስመተን፤ ኡቱ ነምን ብራ መቃ ኦፊሳቲን ዹፌ ገሩ እሰ ንስመቱ።</char> <verse eid="JHN 5:43"/><verse number="44" style="v" sid="JHN 5:44"/><char style="wj">እስን ዮ ወልራ ኡልፍነ አርገተኒ ኡልፍነ ዋቀ ቶክቸ ብራ ዹፉ ገሩ ህንበርባድኔ አከምት አመኑ ደንዴሱሬ?</char><verse eid="JHN 5:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 5:45"/>
    <char style="wj">“ዋን አን አባ ዱረት እስን ህመዹ ህንሴእና። ከን እስን ህመቱ ቶኮ ጅረ፤ እንስ ሙሴ እስን አብደተን ሰነ።</char> <verse eid="JHN 5:45"/><verse number="46" style="v" sid="JHN 5:46"/><char style="wj">ኡቱ ሙሴ አመንተኒ ስላ አነስ ንአመንቱ ቱሬ፤ እን ዋኤኮ በሬሴቲ።</char> <verse eid="JHN 5:46"/><verse number="47" style="v" sid="JHN 5:47"/><char style="wj">እስን ኤርገ ዋን እን በሬሴ ህንአመኔ፣ ዱቢኮሞ አከምት አመንቱሬ?”</char><verse eid="JHN 5:47"/></para>
  <chapter eid="JHN 5"/>
  <chapter number="6" style="c" sid="JHN 6"/>
  <para style="s1">ዬሱስ ነመ ኩመ ሸን ሶሩሳ</para>
  <para style="r">
    <ref loc="JHN 6:1-13">6፥1‑13</ref> ኩወፈ – <char style="xt"><ref loc="MAT 14:13-21">ማቴ 14፥13‑21</ref>፤ <ref loc="MRK 6:32-44">ማር 6፥32‑44</ref>፤ <ref loc="LUK 9:10-17">ሉቃ 9፥10‑17</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1"/>ወንቶተ ከኔን ቦዴ ዬሱስ ገላነ ገሊላ እሰ ገላነ ጥብርያዶስ ጄዸሙ ገመ ጬኤ፤ <verse eid="JHN 6:1"/><verse number="2" style="v" sid="JHN 6:2"/>ነሞትን ባይኤንስ ሰበቢ መለቶ እን ወረ ዹኩብሰተን ፈይሱዻን ሆጄቴ አርገኒፍ እሰ ዱካ ቡአን። <verse eid="JHN 6:2"/><verse number="3" style="v" sid="JHN 6:3"/>ዬሱስስ በረቶተሳ ወጅን ጋረት ኦል በኤ ታኤ። <verse eid="JHN 6:3"/><verse number="4" style="v" sid="JHN 6:4"/>ዬሮ ሰነ አያን ይሁዶታ፣ ፋሲካን ዽኣቴ ቱሬ።<verse eid="JHN 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 6:5"/>ዬሱስ ዮሙ ኦል እላሌት ቱተ ጉዳ ገረሳ ዹፋ ጅሩ ቶኮ አርጌ፤ ፊልጶሲንስ፣ <char style="wj">“ነሞተ ከኔኒፍ ቡዴነ እሳን ኛተን ኤሳ ብተትነ?”</char> ጄዼ። <verse eid="JHN 6:5"/><verse number="6" style="v" sid="JHN 6:6"/>ከነስ ፊልጶስን ቆሩዻፍ ጄዼ ጋፈቴ፤ እን መታንሳ ዋን ጎቹ ቀቡ ቤከ ቱሬቲ።<verse eid="JHN 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7"/>ፊልጶስሞ፣ “አከ ቶኮን ቶኮንሳኒ ዋኑመ ጥኖሌ አርገተኒፍ ቡዴነ ገኡ ብቱፍ ዲናሪ<note caller="+" style="f"><char style="fr" closed="false">6፥7 </char><char style="fq" closed="false">ዲናሪ </char><char style="ft" closed="false">– ዲናሪን ቶኮ ምንዳ ሆጄታን ቶኮ ጉያት አርገቱ ቱሬ።</char></note> ዽበ ለመ ፉዸተ” ጄዼ ዴብሴፍ።<verse eid="JHN 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8"/>በረቶተሳ ኬሳ ቶኮ እንድሪያስ፣ ኦቦሌስ ስሞን ጴጥሮስ አከነ ጄዼን፤ <verse eid="JHN 6:8"/><verse number="9" style="v" sid="JHN 6:9"/>“ጉርባን ቡዴነ ገርቡ ሸኒፊ ቁርጡሚ ለመ ቀቡ ቶኮ ኩኖት፤ ገሩ ነመ አከነ ባይአቱ ከናፍ ኩን ማል?”<verse eid="JHN 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10"/>ዬሱስስ፣ <char style="wj">“ነሞተ ቴስሳ”</char> ጄዼ። እዶ ሰነስ መርገ ባይኤቱ ቱሬ፤ ነሞትንስ ንተታአን፤ ዺረ ገረ ኩመ ሸኒቱ አች ቱሬ። <verse eid="JHN 6:10"/><verse number="11" style="v" sid="JHN 6:11"/>ዬሱስስ ኤርገሲ ቡዴነ ፉዼ፣ ገለተ ገልቼ ወረ ተታአኒፍ ሀመ እሳን በርባደን ቆቆዴ። ቁርጡሚ ሰነሌ አከሱመ ጎዼ።<verse eid="JHN 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 6:12"/>እንስ ዮሙ እሳን ሁንድ ኛተኒ ቁፈንት በረቶተሳቲን፣ <char style="wj">“ሁራኣ ሀምብፈሜ ወልት ቀባ። ወን ቶኮዩ ህንበድን”</char> ጄዼ። <verse eid="JHN 6:12"/><verse number="13" style="v" sid="JHN 6:13"/>ከናፉ እሳን ሁራኣ ቡዴነ ገርቡ ሸነኒ ከን ነሞትን ኛተኒ ሀምብሰን ወልት ቀበኒ ጉንዶ ኩዸ ለመ ጉተን።<verse eid="JHN 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14"/>ነሞትንስ ዮሙ መለቶ ዬሱስ ሆጄቴ አርገንት፣ “ኩን ዹጉማኑ ራጂ ገረ አዱኛ ዹፉፍ ጅሩ” ጄዸን። <verse eid="JHN 6:14"/><verse number="15" style="v" sid="JHN 6:15"/>ዬሱስስ አከ ነሞትን ሱን ዹፈኒ ሁምናን ቀበኒ ሞቲ እሰ ጎቹ ያደን ሁበቴ አመስ ኮጳሳ ገረ ቱሉ ዴሜ።<verse eid="JHN 6:15"/></para>
  <para style="s1">ዬሱስ ብሻንረ ዴሙሳ</para>
  <para style="r">
    <ref loc="JHN 6:16-21">6፥16‑21</ref> ኩወፈ – <char style="xt"><ref loc="MAT 14:22-33">ማቴ 14፥22‑33</ref>፤ <ref loc="MRK 6:47-51">ማር 6፥47‑51</ref></char></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16"/>ዮሙ ለፍት ገልገሎፍቴት በረቶትንሳ ገረ ገላናት ገድ ቡአን፤ <verse eid="JHN 6:16"/><verse number="17" style="v" sid="JHN 6:17"/>አችትስ ብድሩ ያበተኒ ገላነረ ገመ ቅፍርናሆምት ቀጄለን። ዬሮን ሱን ዱከነ ቱሬ፤ ዬሱስ አመዩ ገረሳኒ ህንዹፍኔ ቱሬ። <verse eid="JHN 6:17"/><verse number="18" style="v" sid="JHN 6:18"/>ቡቤን ጀባንሳ ዋን ቡብሳ ቱሬፍ ብሻንች ንራፈሜ። <verse eid="JHN 6:18"/><verse number="19" style="v" sid="JHN 6:19"/>እሳንስ ኤርገ ገረ ኪሎ ሜትረ ሸኒ ዮካን ጀኣ ሞቀኒ ቦዴ ኡቱ ዬሱስ ገላነረ ዴማ፣ ብድሩ ሰነትስ ዽኣቻ ጅሩ አርገን፤ ንሶዳተንስ። <verse eid="JHN 6:19"/><verse number="20" style="v" sid="JHN 6:20"/>እን ገሩ፣ <char style="wj">“አኑማቲ ህንሶዳትና”</char> ጄዼን። <verse eid="JHN 6:20"/><verse number="21" style="v" sid="JHN 6:21"/>እሳንስ ብድሩት ኦል እሰ ፉዸቹ በርባደን፤ ብድሩን ሱንስ ዮሙሱመ ለፈ እሳን ዸቃ ቱረን ሰነ ገኤ።<verse eid="JHN 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22"/>ጉያ እት ኣኑት ነሞትን ገላንቸ ገመት ሀፈኒ ቱረን አከ ብድሩን ቶኮ ቆፍት አች ቱሬ፣ አከ ዬሱስ በረቶተሳ ወጅን ብድሩ ህንያበትኒፊ አከ እሳን ኮጳሳኒ ዴመን ሁበተን። <verse eid="JHN 6:22"/><verse number="23" style="v" sid="JHN 6:23"/>ብድሩወን ብራ ጥብርያዶሲ ከአኒ እዶ እት ጎፍታን ገለተ ገልቼ እሳንስ እት ቡዴነ ኛተን ሰነ ብረ ገአን። <verse eid="JHN 6:23"/><verse number="24" style="v" sid="JHN 6:24"/>ነሞትን ሱንስ ዮሙ አከ ዬሱሲፊ በረቶትንሳ አች ህንጅሬ በረንት ብድሩወን ያበተኒ ዬሱስን በርባዱፍ ቅፍርናሆም ዸቀን።<verse eid="JHN 6:24"/></para>
  <para style="s1">ዬሱስ ቡዴነ ጅሬኛ</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25"/>ነሞትን ዮሙ ገላንቸ ገመት እሰ አርገንት፣ “ያ በርሲሳ፣ አት ዮም አስ ዹፍቴ?” ጄዸኒ እሰ ጋፈተን።<verse eid="JHN 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26"/>ዬሱስስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“አን ዹጉመን፣ ዹጉመን እስንት ህመ፤ እስን ዋን መለቶ አርግተኒፍ ኡቱ ህንተእን፣ ዋን ቡዴነ ኛተኒ ቁፍተኒፍ ነ በርባደን።</char> <verse eid="JHN 6:26"/><verse number="27" style="v" sid="JHN 6:27"/><char style="wj">ኛተ ጅሬኘ በረ በራቲፍ ተኡ ከን እልም ነማ እስኒ ኬኑፍ ደዸባ መሌ ኛተ በዱፍ ህንደዸብና። ዋቅን አባን ቻፓሳ ከን ምርከኔሱ እልመረት ሩኩቴራቲ።”</char><verse eid="JHN 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28"/>እሳንስ፣ “ኑ አከ ሆጂ ዋቃ ሆጄትኑፍ ማል ጎቹ ቀብነ?” ጄዸኒ ጋፈተን።<verse eid="JHN 6:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29"/>ዬሱስስ፣ <char style="wj">“እሰ እን ኤርጌት አመኑንኬሰን ኩን ሆጂ ዋቃት”</char> ጄዼ ዴብሴፍ።<verse eid="JHN 6:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30"/>ከናፉ እሳን አከነ ጄዸኒ እሰ ጋፈተን፤ “አከ ኑ እሰ አርግኔ ስአመኑፍ፣ መለቶ ማሊ አርግሲፍተ? ማል ሆጄተስ? <verse eid="JHN 6:30"/><verse number="31" style="v" sid="JHN 6:31"/>‘አከ እሳን ኛተኒፍ ሰሚራ ቡዴነ እሳኒፍ ኬኔ’ ጄዸሜ አኩመ በሬፈሜ፣ አቦቲንኬኘ ገሞጂ ኬሰት መና ኛተን።”<note caller="+" style="f"><char style="fr" closed="false">6፥31 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 16:4">በኡ 16፥4</ref>፤ <ref loc="NEH 9:15">ነህ 9፥15</ref>፤ <ref loc="PSA 78:24">ፋር 78፥24</ref>፣<ref loc="PSA 78:25">25</ref></char></char></note><verse eid="JHN 6:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32"/>ዬሱስስ አከነ ጄዼን፤ <char style="wj">“አን ዹጉመን እስንት ህመ፤ ከን ሰሚራ ቡዴነ እስኒ ኬኔ ሙሴ ምት፤ ከን ሰሚራ ቡዴነ ዹጋ እስኒፍ ኬኑ ገሩ አባኮት።</char> <verse eid="JHN 6:32"/><verse number="33" style="v" sid="JHN 6:33"/><char style="wj">ቡዴን ዋቃ እሰ ሰሚራ ገድ ቡኤ አዱኛፍ ጅሬኘ ኬኑ ሰናቲ።”</char><verse eid="JHN 6:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34"/>እሳንስ፣ “ያ ጎፍታ፣ ዬሮ ሁንደ ቡዴነ ከነ ኑ ኬን” ጄዸኒን።<verse eid="JHN 6:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35"/>ዬሱስስ አከነ እሳኒን ጄዼ፤ <char style="wj">“ቡዴን ጅሬኛ አነ። ነምን ገረኮ ዹፉ ጎንኩማ ህንቤለኡ፤ ከን አነት አመኑስ ጎንኩማ ህንዼቦቱ።</char> <verse eid="JHN 6:35"/><verse number="36" style="v" sid="JHN 6:36"/><char style="wj">አኩመ አን እስንት ህሜ እስን ነ አርግተኒርቱ፤ ገሩ አመዩ ህንአመንተን።</char> <verse eid="JHN 6:36"/><verse number="37" style="v" sid="JHN 6:37"/><char style="wj">ከን አባን ናፍ ኬኑ ሁንድ ገረኮ ንዹፈ፤ አንስ ከን ገረኮ ዹፉ ጎንኩማ አለት ህንአርኡ።</char> <verse eid="JHN 6:37"/><verse number="38" style="v" sid="JHN 6:38"/><char style="wj">አን ፌዺ እሰ ነ ኤርጌ ሰና ጉቱፍ መሌ፣ ፌዺ ኦፊኮ ጉተቹፍ ሰሚራ ገድ ህንቡኔቲ።</char> <verse eid="JHN 6:38"/><verse number="39" style="v" sid="JHN 6:39"/><char style="wj">ፌዺን እሰ ነ ኤርጌስ አከ አን ወረ እን ነት ኬኔ ሁንደ ጉያ ዹማት ዱኣ ካሱፍ መሌ አከ አን እሳን ኬሳ ቶኮሌ በሌሱፍ ምት።</char> <verse eid="JHN 6:39"/><verse number="40" style="v" sid="JHN 6:40"/><char style="wj">ፌዺን አባኮቲስ አከ ነምን እልመ እላሌ እሰት አመኑ ሁንድ ጅሬኘ በረ በራ ቀባቱፍ፤ አንስ ጉያ ዹማት ዱኣ እሰ ነንካሰ።”</char><verse eid="JHN 6:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41"/>ከነረት ይሁዶትን ሰበቢ እን፣ <char style="wj">“አን ቡዴነ ሰሚራ ገድ ቡኤዸ”</char> ጄዼፍ እሰት ጉንጉሙ ጀልቀበን። <verse eid="JHN 6:41"/><verse number="42" style="v" sid="JHN 6:42"/>እሳንስ፣ “ኩን ዬሱስ እልመ ዮሴፍ፣ እሰ ኑ አባፊ ሃዸሳ ቤክኑ ሰነ ምቲ? ዮስ እን አከምት፣ <char style="wj">‘አን ሰሚራ ገድ ቡኤረ’</char> ጄዸሬ?” ጄዸን።<verse eid="JHN 6:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43"/>ዬሱስሞ አከነ ጄዼ ዴብሴፍ፤ <char style="wj">“ወልት ህንጉንጉምና።</char> <verse eid="JHN 6:43"/><verse number="44" style="v" sid="JHN 6:44"/><char style="wj">አባን ነ ኤርጌ ሱን እሰ ሀርክሱ ባትናን ነምን ከምዩ ገረኮ ዹፉ ህንደንደኡ፤ አንስ ጉያ ዹማት ዱኣ እሰ ነንካሰ።</char> <verse eid="JHN 6:44"/><verse number="45" style="v" sid="JHN 6:45"/><char style="wj">ራጆተ ኬሰት፣ ‘እሳን ሁንድ ወረ ዋቀራ በረተን ንተኡ’</char><note caller="+" style="f"><char style="fr" closed="false">6፥45 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 54:13">እሳ 54፥13</ref></char></char></note> <char style="wj">ጄዸሜ በሬፈሜረ። ነምን አባራ ዸገኤፊ ከን እሰራ በረቴ ሁንድ ገረኮ ንዹፈ።</char> <verse eid="JHN 6:45"/><verse number="46" style="v" sid="JHN 6:46"/><char style="wj">እሰ ዋቀ ብራ ዹፌ ሰነ መሌ ነምን ቶኮዩ አባ ህንአርግኔ፤ እሰ ቆፈቱ አባ አርጌ።</char> <verse eid="JHN 6:46"/><verse number="47" style="v" sid="JHN 6:47"/><char style="wj">አን ዹጉመን እስንት ህመ፤ ከን አመኑ ጅሬኘ በረ በራ ቀበ።</char> <verse eid="JHN 6:47"/><verse number="48" style="v" sid="JHN 6:48"/><char style="wj">ቡዴን ጅሬኛ አነ።</char> <verse eid="JHN 6:48"/><verse number="49" style="v" sid="JHN 6:49"/><char style="wj">አቦቲንኬሰን ገሞጂ ኬሰት መና ኛተን፤ ተኡስ ንዱአን።</char> <verse eid="JHN 6:49"/><verse number="50" style="v" sid="JHN 6:50"/><char style="wj">ቡዴን ሰሚራ ገድ ቡኤ ገሩ እሰ ከነ፤ ነምን እሰ ኛቱ ጎንኩማ ህንዱኡ።</char> <verse eid="JHN 6:50"/><verse number="51" style="v" sid="JHN 6:51"/><char style="wj">ቡዴን ጅራታን ሰሚራ ቡኤ አነ። ነምን ከምዩ ዮ ቡዴነ ከነራ ኛቴ በረ በራን ንጅራተ። ቡዴን አን ጅሬኘ አዱኛቲፍ ኬኑስ ፎንኮት።”</char><verse eid="JHN 6:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52"/>ይሁዶትንስ፣ “ነምች ኩን አከምት አከ ኑ ኛትኑፍ ፎንሳ ኑ ኬኑ ደንደአ?” ጄዸኒ ወል ፈልመን።<verse eid="JHN 6:52"/></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53"/>ዬሱስሞ አከነ ጄዼን፤ <char style="wj">“አን ዹጉመን እስንት ህመ፤ እስን ፎን እልመ ነማ ኛቹ ባትናን፣ ዺገሳስ ዹጉ ባትናን ኦፊኬሰኒን ጅሬኘ ህንቀብደን።</char> <verse eid="JHN 6:53"/><verse number="54" style="v" sid="JHN 6:54"/><char style="wj">ነምን ፎንኮ ኛቱፊ ዺገኮ ዹጉ ጅሬኘ በረ በራ ቀበ። አንስ ጉያ ዹማት ዱኣ እሰ ነንካሰ።</char> <verse eid="JHN 6:54"/><verse number="55" style="v" sid="JHN 6:55"/><char style="wj">ፎንኮ ኛተ ዹጋቲ፤ ዺግንኮስ ዹጋቲ ዹጋት።</char> <verse eid="JHN 6:55"/><verse number="56" style="v" sid="JHN 6:56"/><char style="wj">ነምን ፎንኮ ኛቱፊ ዺገኮ ዹጉ ሁንድ ነ ኬሰ ጅራተ፤ አንስ እሰ ኬሰ ነንጅራዸ።</char> <verse eid="JHN 6:56"/><verse number="57" style="v" sid="JHN 6:57"/><char style="wj">አኩመ አባን ጅራታን ነ ኤርጌ አንስ ሰበቢ አባቲን ጅራዹ ሰነ፣ ነምን ነ ኛቱስ ሰበቢኮቲን ንጅራተ።</char> <verse eid="JHN 6:57"/><verse number="58" style="v" sid="JHN 6:58"/><char style="wj">ቡዴን ሰሚራ ቡኤ እሰ ከነ፤ እንስ ከን አከ መና አቦቲንኬሰን ኛተኒ ዱአን ሰና ምት፤ ነምን ቡዴነ ከነ ኛቱ በረ በራን ንጅራተ።”</char> <verse eid="JHN 6:58"/><verse number="59" style="v" sid="JHN 6:59"/>እንስ ቅፍርናሆምት ኡቱ መነ ሰገዳ ኬሰት በርሲሳ ጅሩ ዋን ከነ ዱበቴ።<verse eid="JHN 6:59"/></para>
  <para style="s1">በረቶትን ባይኤን ዬሱስን ዺሰኒ በቀተን</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60"/>በረቶተሳ ኬሳ ባይኤን ዮሙ ዋን ከነ ዸገአንት፣ “በርሲስን ኩን ጭማዸ፤ ኤኙቱ ፉዸቹ ደንደአ?” ጄዸን።<verse eid="JHN 6:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61"/>ዬሱስስ አከ በረቶትንሳ ዋኤ ዋን ከና ጉንጉመን ሁበቴ አከነ ጄዼን፤ <char style="wj">“ኩን እስን ጉፈቺሳሬ?</char> <verse eid="JHN 6:61"/><verse number="62" style="v" sid="JHN 6:62"/><char style="wj">ዮስ ዮ ኡቱ እልም ነማ እዶ ዱር ቱሬት ኦል በኡ አርግተን አከም ተእነሬ?</char> <verse eid="JHN 6:62"/><verse number="63" style="v" sid="JHN 6:63"/><char style="wj">ከን ጅሬኘ ኬኑ ሀፉረ፤ ፎን ፋይዳ ህንቀቡ። ዱቢን አን እስንት ዱበዼ ሀፉረ፤ ጅሬኘስ።</char> <verse eid="JHN 6:63"/><verse number="64" style="v" sid="JHN 6:64"/><char style="wj">እስን ኬሰስ ወር ህንአመኔ ቶኮ ቶኮ ጅሩ።”</char> ዬሱስ ጀልቀቡማ ካሴ እሳን ኬሳ ኤኙ አከ ህንአመንኒፊ ኤኙ አከ ደበርሴ እሰ ኬኑ ንቤከ ቱሬቲ። <verse eid="JHN 6:64"/><verse number="65" style="v" sid="JHN 6:65"/>እንስ እቱመ ፉፌ፣ <char style="wj">“ሰበቢን አን፣ ‘ዮ አባ ብራ እሳፍ ኬነሜ መሌ ነምን ከምዩ ገረኮ ዹፉ ህንደንደኡ’ እስኒን ጄዼፍስ ከኑመ”</char> ጄዼ።<verse eid="JHN 6:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66"/>ዬሮ ከና ጀልቀቤ በረቶተሳ ኬሳ ባይኤን ዱበት ዴብአን፤ ኤርገሲስ እሰ ወጅን ህንዴምኔ።<verse eid="JHN 6:66"/></para>
  <para style="p">
    <verse number="67" style="v" sid="JHN 6:67"/>ዬሱስስ ወረ ኩዸ ለማኒን፣ <char style="wj">“እስንስ ዴሙ በርባዱ?”</char> ጄዼ ጋፈቴ።<verse eid="JHN 6:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68"/>ስሞን ጴጥሮስስ አከነ ጄዼ ዴብሴ፤ “ያ ጎፍታ፣ ገረ ኤኙ ዴምነ? አት ዱቢ ጅሬኘ በረ በራ ቀብዳ። <verse eid="JHN 6:68"/><verse number="69" style="v" sid="JHN 6:69"/>ኑ አከ አት ቁልቁልቸ ዋቃ ታቴ አመኔረ፤ ቤክኔረስ።”<verse eid="JHN 6:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70"/>ዬሱስስ ዴብሴ፣ <char style="wj">“አኑመቱ ኩዸ ለማንኬሰን ፍለቴ ምቲ? ተኡስ እስን ኬሳ እን ቶኮ ዲያብሎሲዸ!”</char> ጄዼ። <verse eid="JHN 6:70"/><verse number="71" style="v" sid="JHN 6:71"/>እንስ ዋኤ ይሁዳ እልመ ስሞን አስቆሮትቻ ዱበቴ፤ ይሁዳን ወረ ኩዸ ለማን ኬሳ ቶኮ ተኡስ ዬሱስን ደበርሴ ኬኑፍ ጅራቲ!<verse eid="JHN 6:71"/></para>
  <chapter eid="JHN 6"/>
  <chapter number="7" style="c" sid="JHN 7"/>
  <para style="s1">ዬሱስ አያነ ዳሲረት አርገሙሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1"/>ከነ ቦዴ ዬሱስ ገሊላ ኬሰ ዴዴብኣ ቱሬ፤ ሰበቢ ይሁዶትን እሰ አጄሱ በርባደኒፍ እን ይሁዳ ኬሰ ህንዴዴብኔ። <verse eid="JHN 7:1"/><verse number="2" style="v" sid="JHN 7:2"/>አያን ዳሲ ይሁዶታ ዽኣቴ ቱሬ። <verse eid="JHN 7:2"/><verse number="3" style="v" sid="JHN 7:3"/>ኦቦሎትንሳስ አከነ ጄዸኒን፤ “አከ በረቶትንኬ ዋን አት ሆጄቱ አርገኒፍ ከኢቲ ይሁዳ ዸቅ። <verse eid="JHN 7:3"/><verse number="4" style="v" sid="JHN 7:4"/>ነምን ኡቱ እፋን እፈት ቤከሙ በርባዱ ዾክሳት ዋ ሆጄቱ ህንጅሩቲ። አትስ ሰበቢ ዋን ከነ ሆጄቱፍ አዱኛት ኦፍ ሙልእስ።” <verse eid="JHN 7:4"/><verse number="5" style="v" sid="JHN 7:5"/>ኦቦሎትንሳዩ እሰት ህንአመኔ ቱሬቲ።<verse eid="JHN 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6"/>ዬሱስስ አከነ ጄዼን፤ <char style="wj">“ዬሮንኮ አመሌ ህንጌኜ፤ እስኒፍ ገሩ ዬሮን ሁንድ ምጃኣዸ።</char> <verse eid="JHN 7:6"/><verse number="7" style="v" sid="JHN 7:7"/><char style="wj">አዱኛን እስን ጅቡ ህንደንደኡ፤ አነ ገሩ አከ ሆጂንሳ ሀማ ተኤ ዋነን እት ዹጋ በኡፍ ነ ጅበ።</char> <verse eid="JHN 7:7"/><verse number="8" style="v" sid="JHN 7:8"/><char style="wj">እስን ገረ አያነ ሰና ዸቃ። አን ገሩ ዋን ዬሮንኮ አመሌ ህንገእኒፍ ገረ አያንቻት ኦል ህንበኡ።”</char> <verse eid="JHN 7:8"/><verse number="9" style="v" sid="JHN 7:9"/>እን ዋን ከነ እሳንት ዱበቴ ገሊላት ሀፌ።<verse eid="JHN 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10"/>ገሩ ኤርገ ኦቦሎትንሳ ገረ አያንቻት ኦል በአኒ ቦዴ እንስ ኡቱ እፋን እፈት ህንተእን ዾክሳዻን ኦል በኤ። <verse eid="JHN 7:10"/><verse number="11" style="v" sid="JHN 7:11"/>ይሁዶትንስ አያንቸረት፣ “ነምች ሱን ኤሰ ጅረ?” ጄዸኒ ጋፈቻ እሰ በርባዳ ቱረን።<verse eid="JHN 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12"/>ነሞተ ግዱትስ ዋኤሳ ጉንጉሚ ጉዳቱ ቱሬ። ነሞትን ቶኮ ቶኮ፣ “እን ነመ ጋሪዸ” ጄዸን።</para>
  <para style="p" vid="JHN 7:12">ወር ካንሞ፣ “አከስ ምት፤ እን ነመ ዶጎጎርሰ” ጄዸን። <verse eid="JHN 7:12"/><verse number="13" style="v" sid="JHN 7:13"/>ገሩ ዋን ይሁዶተ ሶዳተኒፍ ነምን ቶኮዩ እፋን እፈት ዋኤሳ ህንዱበትኔ።<verse eid="JHN 7:13"/></para>
  <para style="s1">ዬሱስ አያነረት በርሲሱሳ</para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14"/>ገረ ወለካ አያንቻትስ ዬሱስ መነ ቁልቁሉማ ሴኔ በርሲሱ ጀልቀቤ። <verse eid="JHN 7:14"/><verse number="15" style="v" sid="JHN 7:15"/>ይሁዶትንስ ድንቅፈተኒ፣ “ነምች ኩን አከምት ኡቱ ህንበረትን ቤኩምሰ አከና ቀባቴ?” ጄዸን።<verse eid="JHN 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16"/>ዬሱስስ አከነ ጄዼ ዴብሴፍ፤ <char style="wj">“በርሲስንኮ ከን እሰ ነ ኤርጌት መሌ ከንኮ ምት።</char> <verse eid="JHN 7:16"/><verse number="17" style="v" sid="JHN 7:17"/><char style="wj">ነምን ፌዺ ዋቃ ጎቹ በርባዱ ከምዩ በርሲስንኮ ዋቀ ብራ ዹፉፊ ዹፉ ባቹሳ ዮካን አን ኦፉመኮቲን ዱበቹፊ ዱበቹ ባቹኮ ንቤከ።</char> <verse eid="JHN 7:17"/><verse number="18" style="v" sid="JHN 7:18"/><char style="wj">ነምን ኦፉመሳቲን ዱበቱ እን ኦፉመሳቲ ኡልፍነ አርገቹ በርባደ፤ ነምን ኡልፍነ ከን እሰ ኤርጌ ሰና በርባዱ ገሩ እን ነመ ዹጋት፤ ጀልእንስ እሰ ኬሰ ህንጅሩ።</char> <verse eid="JHN 7:18"/><verse number="19" style="v" sid="JHN 7:19"/><char style="wj">ሙሴን ሴረ እስኒ ኬኔረ ምቲ? እስን ኬሳ ገሩ ነምን ቶኮዩ ሴረ ሰነ ህንኤጉ። እስን ማሊፍ ነ አጄሱ በርባዱ?”</char><verse eid="JHN 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20"/>ጀርስ ዴብሰኒ፣ “ሀፉረ ሀማቱ ስ ኬሰ ጅረ፤ ኤኙቱ ስ አጄሱ በርባደ?” ጄዸኒን።<verse eid="JHN 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21"/>ዬሱስስ ዴብሴ አከነ ጄዼን፤ <char style="wj">“አን ሆጂ ቶኮ ሆጄትናን ሁንድኬሰን ድንቅፈተን።</char> <verse eid="JHN 7:21"/><verse number="22" style="v" sid="JHN 7:22"/><char style="wj">ሙሴን ሴረ ዸግነ ቀባ እስኒ ኬኔ፤ ዸግነ ቀባ ገሩ አቦቲቱ ጀልቀቤ መሌ ሙሴ ምት፤ እስንስ ጉያ ሰንበታቲን ነመ ዸግነ ቀብዱ።</char> <verse eid="JHN 7:22"/><verse number="23" style="v" sid="JHN 7:23"/><char style="wj">አከ ሴር ሙሴ ህንጨብኔፍ ኤርገ ነምን ቶኮ ጉያ ሰንበታቲን ዸግነ ቀበቹ ደንደኤ፣ እስን ማሊፍ ሰበቢ አን ጉያ ሰንበታቲን ዸግነ ነማ ጉቱ ፈይሴፍ ነት ኣርቱ?</char> <verse eid="JHN 7:23"/><verse number="24" style="v" sid="JHN 7:24"/><char style="wj">ሙርቲ ቀጄላ ኬና መሌ፣ ብፈ ቆፈ እላልተኒ ህንሙርቴስና።”</char><verse eid="JHN 7:24"/></para>
  <para style="s1">ዬሱስ ኩን እን ክርስቶሲዸ?</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25"/>ከነረት ነሞተ ዬሩሳሌም ኬሳ ቶኮ ቶኮ አከነ ጄዸን፤ “እን ኩን ነምቸ እሳን አጄሱፍ በርባደን ሰነ ምቲ? <verse eid="JHN 7:25"/><verse number="26" style="v" sid="JHN 7:26"/>ኩኖ እን እፈት በኤ ዱበተ፤ እሳንስ ሆማ እሳን ህንጄኔ። አቦቲን ታይታ አከ እን ክርስቶስ ተኤ ስሪት ቤከኒሩ ላተ? <verse eid="JHN 7:26"/><verse number="27" style="v" sid="JHN 7:27"/>ተኡስ ነምች ኩን ነመ ኤሳ አከ ተኤ ኑ ቤክነ። ክርስቶስ ዮሙ ዹፉት ገሩ እን ኤሳ አከ ዹፉ ነምን ቶኮዩ ህንቤኩ።”<verse eid="JHN 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28"/>ዬሱስ ኡቱ መነ ቁልቁሉማ ኬሰት በርሲሱ ሰገሌሳ ኦል ፉዸቴ አከነ ጄዼ፤ <char style="wj">“እስን ነ ቤክቱ፤ አከ አን ኤሳ ዹፌሌ ቤክቱ። አን ኦፊኮቲን ህንዹፍኔ፤ እን ነ ኤርጌ ሱን ዹገ ቀቤሰ። እስን ገሩ እሰ ህንቤክተን፤</char> <verse eid="JHN 7:28"/><verse number="29" style="v" sid="JHN 7:29"/><char style="wj">አን ገሩ ሰበቢን እሰ ብራ ዹፌፊ ሰበቢ እን ነ ኤርጌፍ እሰ ነንቤከ።”</char><verse eid="JHN 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30"/>ከነረት እሳን እሰ ቀቡ ያለን፤ ገሩ ዋን ሰኣቲንሳ ህንገእኒፍ ነምን ቶኮዩ ሀርካን እሰ ህንቱቅኔ። <verse eid="JHN 7:30"/><verse number="31" style="v" sid="JHN 7:31"/>ተኡስ ነሞትን ባይኤን እሰት አመነን። እሳንስ፣ “ክርስቶስ ዮሙ ዹፉት ነምቸ ከነ ጫላ መለቶ ሆጄታ?” ጄዸን።<verse eid="JHN 7:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32"/>ፈሪሶትንስ ኡቱ ነሞትን ዋኤሳ ዋን አከና ጉንጉመኑ ዸገአን። ሉቦትን ሀንገፎትኒፊ ፈሪሶትን ዬሱስን ቀብሲሱዻፍ ኤግዶተ መነ ቁልቁሉማ ኤርገን።<verse eid="JHN 7:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 7:33"/>ዬሱስስ አከነ ጄዼን፤ <char style="wj">“አን ዬሮ ገባባ እስን ወጅን ጅረ፤ ኤርገሲ ገረ እሰ ነ ኤርጌ ሰና ነንዸቀ።</char> <verse eid="JHN 7:33"/><verse number="34" style="v" sid="JHN 7:34"/><char style="wj">እስን ነ በርባዱ፤ ገሩ ነ ህንአርገተን፤ እዶ አን ጅሩስ ዹፉ ህንደንዴሰን።”</char><verse eid="JHN 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35"/>ይሁዶትንስ አከነ ወሊን ጄዸን፤ “ነምች ኩን አከ ኑ እሰ ህንአርግኔፍ ኤሰ ዸቁ ያዴ ላተ? ገረ ሰበኬኘ ወረ ግሪኮተ ኬሰ ፈፈጨአኒ ዸቄ ግሪኮተ በርሲሳ? <verse eid="JHN 7:35"/><verse number="36" style="v" sid="JHN 7:36"/><char style="wj">‘እስን ነ በርባዱ፤ ገሩ ነ ህንአርገተን፤ እዶ አን ጅሩስ ዹፉ ህንደንዴሰን’</char> ጄቹንሳስ ማል ጄቹሳቲ?”<verse eid="JHN 7:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37"/>ጉያ አያንች እት ሆበኡ፣ ጉያ ጉዳ ሰነ፣ ዬሱስ ከኤ ዻበቴ ሰገሌ ጉዳዻን አከነ ጄዼ፤ <char style="wj">“ኤኙዩ ዮ ዼቦቴ፣ ገረኮ ዹፌ ሃዹጉ።</char> <verse eid="JHN 7:37"/><verse number="38" style="v" sid="JHN 7:38"/><char style="wj">አኩመ ከተቢን ቁልቁሉን ጄዼ ነመ ነት አመኑ ከምዩ ለገ ብሻን ጅሬኛቱ ገራሳ ኬሳ ቡርቀ።”</char> <verse eid="JHN 7:38"/><verse number="39" style="v" sid="JHN 7:39"/>ኩንስ ዋኤ ሀፉረ ቁልቁሉ ወር እሰት አመነን አርገቹፍ ጅረኒ ዱበቹሳት። ሰበቢ ዬሱስ አመሌ ኡልፍነ ህንአርገትኒፍ ሀፉር ቁልቁሉን ሀመ ዬሮ ሰናት ህንኬነምኔ ቱሬቲ።<verse eid="JHN 7:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40"/>ነሞተ ሰነ ኬሳ ቶኮ ቶኮ ዮሙ ዱቢ ከነ ዸገአንት፣ “ኩን ዹጉማኑ ራጅቸ” ጄዸን።<verse eid="JHN 7:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41"/>ወር ካንሞ፣ “እን ክርስቶሲዸ” ጄዸን።</para>
  <para style="p" vid="JHN 7:41">ነሞትን ካንስ አከነ ጄዸን፤ “ክርስቶስ ገሊላዻ ዹፋ? <verse eid="JHN 7:41"/><verse number="42" style="v" sid="JHN 7:42"/>አከ ክርስቶስ ሰኚ ዳዊት ኬሳ ዸለቱፊ አከ እን ቤትልሄሚ፣ ገንደ ዳዊቲ ዹፉ ከተቢን ቁልቁሉን ንዱበተ ምቲ?” <verse eid="JHN 7:42"/><verse number="43" style="v" sid="JHN 7:43"/>አከሲን ዋኤ ዬሱስረት ገራ ገሩማን ወልዳ ግዱት ኡመሜ። <verse eid="JHN 7:43"/><verse number="44" style="v" sid="JHN 7:44"/>እሳን ኬሳስ ቶኮ ቶኮ እሰ ቀቡ በርባደን፤ ገሩ ነምን ቶኮዩ ሀርካን እሰ ህንቱቅኔ።<verse eid="JHN 7:44"/></para>
  <para style="s1">አመንቲ ዸቢሰ ዱረ ቡኦተ ይሁዶታ</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45"/>ኤግዶን ሱን ገረ ሉቦተ ሀንገፎታቲፊ ገረ ፈሪሶታት ዴብአን፤ እሳንስ፣ “እስን ማሊፍ እሰ ህንፍድን?” ጄዸኒ ኤግዶተ ሰነ ጋፈተን።<verse eid="JHN 7:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46"/>ኤግዶትንስ፣ “ተኩማ ነምን አከ ነምቸ ከናት ህንዱበትኔ” ጄዸኒ ዴብሰን።<verse eid="JHN 7:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47"/>ፈሪሶትንስ ዴብሰኒ አከነ ጄዸን፣ “እስንስ ጎዎምፈምተኒርቱ? <verse eid="JHN 7:47"/><verse number="48" style="v" sid="JHN 7:48"/>ቡልችቶተ ኬሳ ዮካን ፈሪሶተ ኬሳ ነምን ቶኮዩ እሰት አመኔራ? <verse eid="JHN 7:48"/><verse number="49" style="v" sid="JHN 7:49"/>ሰብን ሴረ ህንቤክኔ ኩን ገሩ አባረማዸ።”<verse eid="JHN 7:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50"/>ኒቆዲሞስ እን ዱራን ዬሱስ ብረ ዸቄፊ እሳን ኬሳስ ቶኮ ተኤ ሱን አከነ እሳኒን ጄዼ፤ <verse eid="JHN 7:50"/><verse number="51" style="v" sid="JHN 7:51"/>“ሴርኬኘ ኡቱ እሰራ ህንዸገእን፣ ዋን እን ሆጄቴስ ኡቱ ህንቤክን ነመ ቶኮት ንሙራ?”<verse eid="JHN 7:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52"/>እሳንስ፣ “አትስ ነመ ገሊላቲ? አከ ራጂን ገሊላዻ ህንካኔ ቆረዹ ብረ ገእ” ጄዸኒን።</para>
  <para style="p" vid="JHN 7:52">[ <verse eid="JHN 7:52"/><verse number="53" style="v" sid="JHN 7:53"/>ኤርገሲ እሳን ሁንድኑ ገረ መነሳኒት ገለን።<verse eid="JHN 7:53"/></para>
  <chapter eid="JHN 7"/>
  <chapter number="8" style="c" sid="JHN 8"/>
  <para style="s1">ዱበርቲ ኤጀረት ቀበምቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1"/>ዬሱስ ገሩ ገረ ጋረ ኤጄርሳ ዸቄ።<verse eid="JHN 8:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 8:2"/>ገነመ በሪስ ዴብኤ መነ ቁልቁሉማ ዹፌ፤ እንስ ነምን ሁንዱምቱ እሰ ብረት ወልት ቀበምናን ታኤ እሳን በርሲሴ። <verse eid="JHN 8:2"/><verse number="3" style="v" sid="JHN 8:3"/>በርሲሶትን ሴራቲፊ ፈሪሶትን ዱበርቲ ኤጀረት ቀበምቴ ቶኮ እሰት ፍደን። ግዱሳኒስ ዻበቺሰኒ፣ <verse eid="JHN 8:3"/><verse number="4" style="v" sid="JHN 8:4"/>ዬሱሲን አከነ ጄዸን፤ “ያ በርሲሳ፣ ዱበርቲን ኩን ኡቱ ኤጀ ሆጄቱ ቀበምቴ። <verse eid="JHN 8:4"/><verse number="5" style="v" sid="JHN 8:5"/>ሙሴን ሴረ ኬሰት አከ ወር አከና ዸጋዻን ቱመመን ኑ አጀጄረ። አትሞ ማል ጄተ?” <verse eid="JHN 8:5"/><verse number="6" style="v" sid="JHN 8:6"/>እሳንስ ዋን እቲን እሰ ህመተን አርገቹፍ ጄዸኒ እሰ ቆሩዻፍ ዋን ከነ ጋፈተን።</para>
  <para style="p" vid="JHN 8:6">ዬሱስ ገሩ ገድ ጄዼ ቁበሳቲን ለፈረት በሬሱ ጀልቀቤ። <verse eid="JHN 8:6"/><verse number="7" style="v" sid="JHN 8:7"/>እሳንስ እቱመ ፉፈኒ እሰ ጋፈትናን ኦል ጄዼ፣ <char style="wj">“እስን ኬሳ ነምን ጩቡ ህንቀብኔ ዱርሴ ዸጋ እሼት ሃደርበቱ”</char> ጄዼን። <verse eid="JHN 8:7"/><verse number="8" style="v" sid="JHN 8:8"/>አመስ ገድ ጄዼ ለፈረት በሬሴ።<verse eid="JHN 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 8:9"/>እሳንስ ዮሙ ከነ ዸገአንት ማንጉዶታ ጀልቀበኒ ቶኮ ቶኮን በአኒ ሶከን፤ ዬሱስሞ ዱበርትቲ አቹመ ዻበቴ ጅርቱ ወጅን ኮጳ ሀፌ። <verse eid="JHN 8:9"/><verse number="10" style="v" sid="JHN 8:10"/>ዬሱስስ ኦል ጄዼ፣ <char style="wj">“ዱበርቲነነ፣ ወር ስህመተን ሜሬ? ነምን ቶኮዩ ስት ህንሙሬ?”</char> ጄዼን።<verse eid="JHN 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11"/>እሼንስ፣ “ያ ጎፍታ፣ ነምን ቶኮዩ ነት ህንሙሬ” ጄቴን።</para>
  <para style="p" vid="JHN 8:11">ዬሱስስ፣ <char style="wj">“አንስ ስት ህንሙሩ፤ ዴም ገሩ ስአች ጩቡ ህንሆጄትን”</char> ጄዼን።]<note caller="+" style="f"><char style="fr" closed="false">8፥11 </char><char style="ft" closed="false">ወራብሌን ዱሪ ሄዱን ኩታ (<char style="xt"><ref loc="JHN 7:53-8:11">ዮሀ 7፥53–8፥11</ref></char>) ህንቀበን ዮካን እዶ ብራ ዮካንሞ ወንጌሎተ ብራ ኬሰ ሴንስሰን።</char></note><verse eid="JHN 8:11"/></para>
  <para style="s1">ዬሱስ እፈ አዱኛት</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12"/>ዬሱስ አመስ፣ <char style="wj">“አን እፈ አዱኛት። ነምን ነ ዱካ ቡኡ ከምዩ እፈ ጅሬኛ ቀባተ መሌ ዱከነ ኬሰ ህንዴዴብኡ”</char> ጄዼ እሳንት ዱበቴ።<verse eid="JHN 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13"/>ፈሪሶትንስ፣ “አት ዋኤ መታኬቲ ዹጋ ባተ፤ ዹገ በኡምስኬሞ ዹጋ ምት” ጄዸኒን።<verse eid="JHN 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14"/>ዬሱስስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“አን ዮን ኦፊኮቲፍ ዹጋ በኤሌ አን አከን ኤሳ ዹፌፊ አከን ገረም ዴሙ ዋነን ቤኩፍ ዹገ በኡምስኮ ዹጋዸ። እስን ገሩ አከ አን ኤሳ ዹፌ ዮካን አከ አን ገረም ዴሙ ህንቤክተን።</char> <verse eid="JHN 8:14"/><verse number="15" style="v" sid="JHN 8:15"/><char style="wj">እስን አከ ያደ ፎኒት ሙርቴስቱ፤ አን ነመ ቶኮትሌ ህንሙሩ።</char> <verse eid="JHN 8:15"/><verse number="16" style="v" sid="JHN 8:16"/><char style="wj">ገሩ አን ዮን ሙርቴሴሌ ሙርቲንኮ ዹጋዸ፤ ከን ሙሩስ ነ ቆፈ ምት። አን አባ ነ ኤርጌ ሰነ ወጅነን ጅራቲ።</char> <verse eid="JHN 8:16"/><verse number="17" style="v" sid="JHN 8:17"/><char style="wj">ዹገ በኡምስ ነመ ለማ አከ ዹጋ ተኤ ሴረኬሰን ኬሰት በሬፈሜረ።</char> <verse eid="JHN 8:17"/><verse number="18" style="v" sid="JHN 8:18"/><char style="wj">አን ኦፊኮቲፍ ዹጋ ነንበአ፤ አባን ነ ኤርጌስ ዋኤኮ ዹጋ በአ።”</char><verse eid="JHN 8:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19"/>እሳንስ፣ “አባንኬ ኤሰ ጅረ?” ጄዸኒ እሰ ጋፈተን።</para>
  <para style="p" vid="JHN 8:19">ዬሱስሞ ዴብሴ፣ <char style="wj">“እስን አነስ፣ አባኮስ ህንቤክተን፤ ኡቱ ነ ቤክተኒ ስላ አባኮስ ንቤክቱ ቱርተን”</char> ጄዼ። <verse eid="JHN 8:19"/><verse number="20" style="v" sid="JHN 8:20"/>ዬሱስ ኡቱ መነ ቁልቁሉማ ኬሰት፣ ኩታ ቡሲን እት ኩፈሙ ኬሰት በርሲሳ ጅሩ ዱቢ ከነ ዱበቴ። ገሩ ዋን ሰኣቲንሳ ህንገእኒፍ ነምን ቶኮዩ እሰ ህንቀብኔ።<verse eid="JHN 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21"/>ዬሱስ አመሌ፣ <char style="wj">“አን ነንዴመ፤ እስን ነ በርባዱ፤ ጩቡኬሰኒንስ ንዱቱ። እስን እዶ አን ዸቁ ዹፉ ህንደንዴሰን”</char> እሳኒን ጄዼ።<verse eid="JHN 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22"/>ይሁዶትንስ፣ “ <char style="wj">‘እስን እዶ አን ዸቁ ዹፉ ህንደንዴሰን’</char> ጄቹንሳ ኦፍ አጄሱፍ ተእና?” ጄዸን።<verse eid="JHN 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23"/>እንስ እቱመ ፉፌ አከነ ጄዼ፤ <char style="wj">“እስን ከን ገዲት፤ አን ከን ኦሊት። እስን ከን አዱኛ ከናት፤ አንሞ ከን አዱኛ ከና ምት።</char> <verse eid="JHN 8:23"/><verse number="24" style="v" sid="JHN 8:24"/><char style="wj">አከ እስን ጩቡኬሰኒን ዱተን አን እስንት ህሜረ፤ እስን ዮ አከ አን እሰ ተኤ አመኑ ባተን፣ ጩቡኬሰኒን ንዱቱ።”</char><verse eid="JHN 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25"/>እሳንስ፣ “አት ኤኙ?” ጄዸኒ እሰ ጋፈተን።</para>
  <para style="p" vid="JHN 8:25">ዬሱስሞ አከነ ጄዼ ዴብሴ፤ <char style="wj">“አን እሱመ ጀልቀባ ካሴ እስንት ዱበቻ ቱሬዸ።</char> <verse eid="JHN 8:25"/><verse number="26" style="v" sid="JHN 8:26"/><char style="wj">አን ዋኤኬሰን ዋነን ጄዹፊ ዋነን ሙርቴሱ ባይኤን ቀበ። ገሩ እን ነ ኤርጌ ዹጋ ቀቤሰ፤ አንስ ዋነን እሰራ ዸገኤ አዱኛት ነንህመ።”</char><verse eid="JHN 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27"/>እሳን ገሩ አከ እን ዋኤ አባሳ እሳንት ህማ ቱሬ ህንሁበትኔ። <verse eid="JHN 8:27"/><verse number="28" style="v" sid="JHN 8:28"/>ከናፉ ዬሱስ አከነ እሳኒን ጄዼ፤ <char style="wj">“ዮሙ እልመ ነማ ኦል ፉተንት አከ አን እሰ ተኤ፣ ዋኑመ አባን ነ በርሲሴን ዱበዸ መሌ አከ አን ኦፊኮቲን ሆማ ህንሆጄትኔስ ንቤክቱ።</char> <verse eid="JHN 8:28"/><verse number="29" style="v" sid="JHN 8:29"/><char style="wj">እን ነ ኤርጌ ነ ወጅን ጅረ፤ ሰበቢ አን ዬሮ ሁንደ ዋን እሰ ገመቺሱ ሆጄዹፍ፣ እን ኮጳኮ ነ ህንዺፍኔ።”</char> <verse eid="JHN 8:29"/><verse number="30" style="v" sid="JHN 8:30"/>ኡቱመ እን ዱበቱስ፣ ነሞትን ባይኤን እሰት አመነን።<verse eid="JHN 8:30"/></para>
  <para style="s1">እጆሌ አብረሃም</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31"/>ዬሱስ ይሁዶተ እሰት አመነኒን አከነ ጄዼ፤ <char style="wj">“ዮ ዱቢኮት ጭችተኒ ጅራተን እስን ዹጉመ በረቶተኮት።</char> <verse eid="JHN 8:31"/><verse number="32" style="v" sid="JHN 8:32"/><char style="wj">ዹጋስ ንቤክቱ፤ ዹጋንስ ብልሰ እስን ባሰ።”</char><verse eid="JHN 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33"/>እሳንስ፣ “ኑ ሰኚ አብረሃም፤ ኑ ኤኙማፉ ተኩማ ህንገርቦምኔ። ዮስ አት አከምት ብልሰ ባቱ ኑን ጄተሬ?” ጄዸኒን።<verse eid="JHN 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34"/>ዬሱስስ ዴብሴ አከነ ጄዼ፤ <char style="wj">“አን ዹጉመን፣ ዹጉመን እስንት ህመ፤ ነምን ጩቡ ሆጄቱ ሁንድ ገርብቸ ጩቡት።</char> <verse eid="JHN 8:34"/><verse number="35" style="v" sid="JHN 8:35"/><char style="wj">ገርብች በረ በራን መነ ህንጅራቱ፤ እልም ገሩ በረ በራን ንጅራተ።</char> <verse eid="JHN 8:35"/><verse number="36" style="v" sid="JHN 8:36"/><char style="wj">ከናፉ ዮ እልም ብልሰ እስን ባሴ፣ እስን ዹጉማኑ ብልሰ ንባቱ።</char> <verse eid="JHN 8:36"/><verse number="37" style="v" sid="JHN 8:37"/><char style="wj">እስን ሰኚ አብረሃም ተኡኬሰን አኑ ቤከ። ገሩ ሰበቢ ዱቢንኮ እስን ኬሰት እዶ ህንቀብኔፍ ነ አጄሱ በርባዱ።</char> <verse eid="JHN 8:37"/><verse number="38" style="v" sid="JHN 8:38"/><char style="wj">አን ዋነን አባኮ ብረት አርጌን ዱበዸ፤ እስንስ ዋኑመ አባኬሰንራ ዸጌሰን ሆጄቱ።”</char><verse eid="JHN 8:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39"/>እሳንስ፣ “አባንኬኘ አብረሃም” ጄዸን።</para>
  <para style="p" vid="JHN 8:39">ዬሱስሞ አከነ ጄዼ፤ <char style="wj">“እስን ኡቱ እጆሌ አብረሃም ታተኒ ስላ ሆጂ አብረሃም ሆጄቴ ንሆጄቱ ቱርተን።</char> <verse eid="JHN 8:39"/><verse number="40" style="v" sid="JHN 8:40"/><char style="wj">እስን ገሩ አነ ነመ ዹጋ ዋቀራ ዸገኤ እስንት ህሜ አጄሱ በርባዱ። አብረሃም ዋን አከሲ ህንሆጄትኔ።</char> <verse eid="JHN 8:40"/><verse number="41" style="v" sid="JHN 8:41"/><char style="wj">እስን ዋን አባንኬሰን ሆጄቴ ሆጄቱ።”</char></para>
  <para style="p" vid="JHN 8:41">እሳንስ፣ “ኑ ኤጃን ህንዸለትኔ። አባ ቶክቸ ቀብነ፤ እንስ ዋቀ” ጄዸኒን።<verse eid="JHN 8:41"/></para>
  <para style="s1">እጆሌ ዲያብሎስ</para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42"/>ዬሱስስ አከነ እሳኒን ጄዼ፤ <char style="wj">“እስን ኡቱ ዋቅን አባኬሰን ተኤ ስላ ነ ጃለቱ ቱርተን፤ አን ዋቀ ብራ በኤን ዹፌቲ። እሰቱ ነ ኤርጌ መሌ አን ኦፊኮቲን ህንዹፍኔ።</char> <verse eid="JHN 8:42"/><verse number="43" style="v" sid="JHN 8:43"/><char style="wj">ወን አን ዱበዹ ማሊፍ እስኒ ህንገሉ? ሰበቢንሳስ ዋን እስን ዋን አን ጄዹ ፉዸቹ ህንፌኔፍ።</char> <verse eid="JHN 8:43"/><verse number="44" style="v" sid="JHN 8:44"/><char style="wj">እስን እጆሌ አባኬሰኒ እጆሌ ዲያብሎስ፤ ፌዺንኬሰንስ ሀዊ አባኬሰኒ ራወቹዸ። እን ጀልቀቡማ ካሴ ነመ አጄሳ ቱሬ፤ ዋን ዹጋን እሰ ኬሰ ህንጅሬፍ እን ዹጋዻን ህንጅራቱ። እን ሶብዱፊ አባ ሶባ ዋን ተኤፍ ዮሙ ሶበ ዱበቱት ኦፉመ ኬሳ ፉዼ ዱበተ።</char> <verse eid="JHN 8:44"/><verse number="45" style="v" sid="JHN 8:45"/><char style="wj">እስን ገሩ ዋን አን ዹጋ ዱበዹፍ ነ ህንአመንተን!</char> <verse eid="JHN 8:45"/><verse number="46" style="v" sid="JHN 8:46"/><char style="wj">እስን ኬሳ ነምን ጩቡዻን ነ ህመቱ ኤኙ? ኤርገ አን ዹጋ ዱበዼ፣ እስን ማሊፍ ነ ህንአመኔ?</char> <verse eid="JHN 8:46"/><verse number="47" style="v" sid="JHN 8:47"/><char style="wj">ከን ዋቃ ከን ተኤ ዱቢ ዋቃ ንዸገአ። እስን ዋን ከን ዋቃ ህንተእኒፍ ህንዸጌሰን።”</char><verse eid="JHN 8:47"/></para>
  <para style="s1">ዬሱስ ዋኤ ኦፊሳ ዱበቴ</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48"/>ይሁዶትንስ ዴብሰኒ፣ “አት ነመ ሰማርያት፤ ሀፉረ ሀማቱ ስ ኬሰ ጅረ ጄቹንኬኘ ዹጋ ምቲ?” ጄዸኒን።<verse eid="JHN 8:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49"/>ዬሱስሞ አከነ ጄዼ፤ <char style="wj">“ሀፉር ሀማን ነ ኬሰ ህንጅሩ፤ አን አባኮ ነንከበጀ፤ እስን ገሩ ነ ህንከበጀን።</char> <verse eid="JHN 8:49"/><verse number="50" style="v" sid="JHN 8:50"/><char style="wj">አን ኡልፍነ መታኮ ህንበርባዱ፤ ገሩ ከን እሰ በርባዱ ቶኮቱ ጅረ፤ እንስ አባ ሙርቲት።</char> <verse eid="JHN 8:50"/><verse number="51" style="v" sid="JHN 8:51"/><char style="wj">አን ዹጉመን፣ ዹጉመን እስንት ህመ፤ ኤኙዩ ዮ ዱቢኮ ኤጌ በረ በራን ዱአ ህንአርጉ።”</char><verse eid="JHN 8:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52"/>ይሁዶትንስ አከነ ጄዸኒን፤ “አከ ሀፉር ሀማን ስ ኬሰ ጅሩ ኑ አመ በሬረ። አብረሃም ዱኤረ፤ ራጆትንስ ዱአኒሩ፤ አት ገሩ፣ ‘ኤኙዩ ዮ ዱቢኮ ኤጌ በረ በራን ዱአ ህንዸንዸሙ’ ጄተ። <verse eid="JHN 8:52"/><verse number="53" style="v" sid="JHN 8:53"/>አት አባኬኘ አብረሃም ጫልታ? እን ዱኤረ፤ ራጆትንስ ዱአኒሩ። ኤጋ አት ኤኙ ኦፊን ጄተሬ?”<verse eid="JHN 8:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54"/>ዬሱስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“አን ዮን ኦፊኮቲፍ ኡልፍነ ኬኔ፣ ኡልፍንኮ ገቲ ህንቀቡ። ከን ኡልፍነ ናፍ ኬኑ አባኮ እሱመ እስን ዋቀኬኘ ጄተኒን ሰናዸ።</char> <verse eid="JHN 8:54"/><verse number="55" style="v" sid="JHN 8:55"/><char style="wj">ዮ እስን እሰ ቤኩ ባተንሌ አን እሰ ቤከ። አን ኡቱን እሰ ህንቤኩ ጄዼ ስላ አኩመኬሰን ሶብዱ ነንተአ ቱሬ። አን ገሩ እሰ ቤከ፤ ዱቢሳሌ ነንኤገ።</char> <verse eid="JHN 8:55"/><verse number="56" style="v" sid="JHN 8:56"/><char style="wj">አባንኬሰን አብረሃም ጉያኮ አርጉፍ ገመዴ ቱሬ፤ እንስ ንአርጌ፤ ንገመዴስ።”</char><verse eid="JHN 8:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57"/>ይሁዶትንስ፣ “ኡምሪንኬ ወጋ ሸንተመዩ ህንጉትኔ፤ ዮስ አብረሃምን አርግቴርታ?” ጄዸኒን።<verse eid="JHN 8:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58"/>ዬሱስስ፣ <char style="wj">“አን ዹጉመን፣ ዹጉመን እስንት ህመ፤ ኡቱ አብረሃም ህንዸለትንዩ አን አኑመ”</char> እሳኒን ጄዼ። <verse eid="JHN 8:58"/><verse number="59" style="v" sid="JHN 8:59"/>ከነረት እሳን እሰ ዸኡፍ ጄዸኒ ዸጋ ጉረተን፤ ዬሱስ ገሩ ዾከቴ መነ ቁልቁሉማቲ በኤ ዴሜ።<verse eid="JHN 8:59"/></para>
  <chapter eid="JHN 8"/>
  <chapter number="9" style="c" sid="JHN 9"/>
  <para style="s1">ዬሱስ ነምቸ ጃማ ቶኮ ፈይሱሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1"/>ዬሱስ ኡቱ ደርቡ ነምቸ ዸሎቱመሳቲ ጀልቀቤ ጃማ ቱሬ ቶኮ አርጌ። <verse eid="JHN 9:1"/><verse number="2" style="v" sid="JHN 9:2"/>በረቶትንሳስ፣ “ያ በርሲሳ፣ አከ ነምች ኩን ጃማ ተኤ ዸለቱፍ ኤኙቱ ጩቡ ሆጄቴ? እሱመሞ አባፊ ሃዸሳት?” ጄዸኒ እሰ ጋፈተን።<verse eid="JHN 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3"/>ዬሱስስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“አከ ሆጂን ዋቃ እሳን ሙልአቱፍ መሌ እን ዮካን አባፊ ሃትሳ ጩቡ ሆጄተኒ ምት።</char> <verse eid="JHN 9:3"/><verse number="4" style="v" sid="JHN 9:4"/><char style="wj">ኡቱ ጉያ ተኤ ጅሩ ሆጂ እሰ ነ ኤርጌ ሆጄቹ ቀብነ። ሀልከን ነምን ቶኮዩ እት ሆጄቹ ህንደንዴኜ ንዹፈ።</char> <verse eid="JHN 9:4"/><verse number="5" style="v" sid="JHN 9:5"/><char style="wj">አን ዮሙን አዱኛረ ጅሩ፣ እፈ አዱኛት።”</char><verse eid="JHN 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6"/>እንስ ኤርገ ዋን ከነ ዱበቴ ቦዴ ለፈት ቱፌ ዾቄ ቶልቼ፤ ዾቄ ሰነስ እጀ ነምቻት ድቤ። <verse eid="JHN 9:6"/><verse number="7" style="v" sid="JHN 9:7"/>እንስ ነምቸ ሰናን፣ <char style="wj">“ዸቂቲ ሀሮ ሰሊሆምት ዽቀዹ”</char> ጄዼ። ሰሊሆም ጄቹን ከን ኤርገሜ ጄቹዸ። ነምችስ ዸቄ ዽቀቴ፤ አርጋስ ዴብኤ ዹፌ።<verse eid="JHN 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8"/>ኦሎትንሳቲፊ ነሞትን ዱራን ኡቱ እን ከዸቱ አርገን፣ “ነምች ኩን እሱመ ታኤ ከዸቻ ቱሬ ሰነ ምቲ?” ጄዸን። <verse eid="JHN 9:8"/><verse number="9" style="v" sid="JHN 9:9"/>ነሞትን ቶኮ ቶኮ፣ “ኤዬ፣ እሰ” ጄዸን።</para>
  <para style="p" vid="JHN 9:9">ካንሞ፣ “ምት፣ እሰ ፈካተ መሌ” ጄዸን።</para>
  <para style="p" vid="JHN 9:9">እን ገሩ፣ “ነምች ሱን አኑመ” ጄዼ።<verse eid="JHN 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10"/>ጀርስ፣ “እጅኬ አከምት በነሜሬ?” ጄዸኒን።<verse eid="JHN 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11"/>እንስ ዴብሴ፣ “ነምቸ ዬሱስ ጄዸሙቱ ዾቄ ቶልቼ እጀኮ ድቤ፣ ‘ገረ ሀሮ ሰሊሆም ዸቂቲ ዽቀዹ’ ናን ጄዼ፤ አንስ ዸቄን ዽቀዼ፤ አርጉስ ነንደንደኤ።”<verse eid="JHN 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12"/>እሳንስ፣ “ነምች ሱን ኤሰ ጅረ?” ጄዸኒ እሰ ጋፈተን።</para>
  <para style="p" vid="JHN 9:12">እንሞ፣ “አን ህንቤኩ” ጄዼን።<verse eid="JHN 9:12"/></para>
  <para style="s1">ፈሪሶትን ዋኤ ፈዩ ነምቻ ቆረቹሳኒ</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13"/>እሳንስ ነምቸ ጃማ ቱሬ ሰነ ፈሪሶተት ጌሰን። <verse eid="JHN 9:13"/><verse number="14" style="v" sid="JHN 9:14"/>ጉያን እት ዬሱስ ዾቄ ቶልቼ እጀ ነምቻ በኔ ሰንበተ ቱሬ። <verse eid="JHN 9:14"/><verse number="15" style="v" sid="JHN 9:15"/>ፈሪሶትንስ ነምች አከምት አከ አርጉ ደንደኤ እሰ ጋፈተን፤ ነምችስ፣ “እን ዾቄ ቶልቼ እጀኮ ድቤ፤ አንስ ነንዽቀዼ፤ ነንአርጌስ” ጄዼን።<verse eid="JHN 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16"/>ፈሪሶተ ኬሳስ ቶኮ ቶኮ፣ “ነምች ኩን ዋን ሰንበተ ህንኤግኔፍ፣ እን ዋቀ ብራ ህንዹፍኔ” ጄዸን።</para>
  <para style="p" vid="JHN 9:16">ወር ካን ገሩ፣ “ጩበማን ቶኮ አከምት ድንቂ አከና ሆጄቹ ደንደአ?” ጄዸን። ገራ ገሩማንስ እሳን ግዱት ኡመሜ።<verse eid="JHN 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17"/>እሳንስ አመሌ ነምቸ ጃማ ቱሬ ሰናን፣ “ዋኤ ነምቸ እጀኬ ሲፍ በኔ ሰና ማል ጄተ?” ጄዸን።</para>
  <para style="p" vid="JHN 9:17">ነምችስ ዴብሴ፣ “እን ራጂዸ” ጄዼ።<verse eid="JHN 9:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18"/>ይሁዶትንስ ሀመ አባፊ ሃዸ ነምቸ አገርቱሳ አርገቴ ሰና ዋመንት አከ እን ጃማ ቱሬፊ አከ እን አገርቱሳ አርገቴ አመሌ ህንአመኔ። <verse eid="JHN 9:18"/><verse number="19" style="v" sid="JHN 9:19"/>እሳንስ፣ “እን ኩን እልመኬሰን እሱመ እስን ጃማ ተኤ ዸለቴ ጄተን ሰና? ዮስ አመሞ አከምት አርጉ ደንደአሬ?” ጄዸኒ ጋፈተን።<verse eid="JHN 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20"/>አባፊ ሃት ነምቻስ ዴብሰኒ አከነ ጄዸን፤ “አከ እን እልመኬኘ ተኤፊ አከ እን ጃማ ተኤ ዸለቴ ንቤክነ። <verse eid="JHN 9:20"/><verse number="21" style="v" sid="JHN 9:21"/>ገሩ አመ አከምት አከ አርጉ ደንደኤ ዮካን እጀሳ ኤኙ አከ በኔፍ ኑ ህንቤክኑ። እን ነመ ገኣዸ፤ ዋኤ መታሳ ዱበቹ ንደንደአ፤ እሱመ ጋፈዻ።” <verse eid="JHN 9:21"/><verse number="22" style="v" sid="JHN 9:22"/>አባፊ ሃትሳ ሰበቢ ይሁዶተ ሶዳተኒፍ ዋን ከነ ጄዸን፤ ነምን ከምዩ ዮ ዬሱስ እን ክርስቶስ ጄዼ ዹጋ በኤ አከ መነ ሰገዳ ኬሳ አርአሙ ይሁዶትን ከናን ዱረ ወሊ ገለኒ ሙርቴሰኒ ቱረኒቲ። <verse eid="JHN 9:22"/><verse number="23" style="v" sid="JHN 9:23"/>ከናፉ አባፊ ሃቲሳ፣ “እን ነመ ገኣዸ፤ እሱመ ጋፈዻ” ጄዸን።<verse eid="JHN 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24"/>እሳንስ ዬሮ ለመፋ ነምቸ ጃማ ቱሬ ሰነ ዋመኒ፣ “ዋቃፍ ኡልፍነ ኬን። ነምች ኩን ጩበማ ተኡሳ ኑ ንቤክነ” ጄዸኒን።<verse eid="JHN 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25"/>እንስ፣ “ጩበማ ተኡፊ ተኡ ባቹሳ አን ህንቤኩ። አን ዋን ቶኮ ቤከ። አን ጃማን ቱሬ፤ አመ ገሩ ነንአርገ!” ጄዼ ዴብሴ።<verse eid="JHN 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26"/>እሳንስ፣ “እን ማል ሲፍ ጎዼ? እጀኬስ አከምት ሲፍ በኔ?” ጄዸኒ እሰ ጋፈተን።<verse eid="JHN 9:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27"/>እንሞ፣ “አን ከናን ዱረ እስንት ህሜረ፤ እስንስ ህንዸጌኜ። አመስ ማሊፍ ዸገኡ በርባዱ? እስንስ በረቶተሳ ተኡ በርባዱ?” ጄዼን።<verse eid="JHN 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28"/>እሳንስ አከነ ጄዸኒ እሰ አረብሰን፤ “በረታን ነምቸ ከና ስእ! ኑ በረቶተ ሙሴት! <verse eid="JHN 9:28"/><verse number="29" style="v" sid="JHN 9:29"/>አከ ዋቅን ሙሴት ዱበቴ ኑ ቤክነ፤ ነምች ኩን ገሩ ኤሳ አከ ዹፌዩ ህንቤክኑ።”<verse eid="JHN 9:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30"/>ነምችስ ዴብሴ አከነ ጄዼ፤ “እን ኤሳ አከ ዹፌ ወላሉንኬሰን ዋን ነመ ድንቁዸ፤ ገሩ እን እጀኮ ናፍ በኔ። <verse eid="JHN 9:30"/><verse number="31" style="v" sid="JHN 9:31"/>አከ ዋቅን ጩበሞተ ህንዸጌኜ ንቤክነ። እን ነመ እሰ ዋቄፈቱፊ ፌዺሳ ጉቱ ዸገአ። <verse eid="JHN 9:31"/><verse number="32" style="v" sid="JHN 9:32"/>ኤኙዩ እጀ ነመ ጃማ ተኤ ዸለቴ ቶኮ አከ በኔ ኡመመ አዱኛቲ ጀልቀቤ ህንዸገአምኔ። <verse eid="JHN 9:32"/><verse number="33" style="v" sid="JHN 9:33"/>ነምች ኩን ኡቱ ዋቀ ብራ ተኡ ባቴ ስላ ሆማ ጎቹ ህንደንደኡ ቱሬ።”<verse eid="JHN 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34"/>እሳንስ ዴብሰኒ፣ “አት ከን ጉቱማት ጩቡን ዸለቴ፣ ስቱ ኑ በርሲሳ?” ጄዸኒን። አለትስ ገድ እሰ ባሰን።<verse eid="JHN 9:34"/></para>
  <para style="s1">ጃሙማ ሀፉራ</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35"/>ዬሱስስ አከ እሳን ገድ እሰ ባሰን ዸገኤ፤ ዮሙ እሰ አርጌትስ፣ <char style="wj">“አት እልመ ነማት ንአመንታ?”</char> ጄዼን።<verse eid="JHN 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36"/>ነምችስ፣ “ያ ጎፍታ፣ አከ አን እሰት አመኑፍ እን ኤኙ?” ጄዼ።<verse eid="JHN 9:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37"/>ዬሱስስ፣ <char style="wj">“አት አመ እሰ አርግቴርተ፤ እን ስ ወጅን ሃሰኣ ጅሩ እሱመ”</char> ጄዼን።<verse eid="JHN 9:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38"/>ነምች ሱንስ፣ “ያ ጎፍታ፣ አን ነንአመነ” ጄዼ፤ ንሰገዴፍስ።<verse eid="JHN 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39"/>ዬሱስሞ፣ <char style="wj">“ወር ህንአርግኔ አከ አርገኒፍ፣ ወር አርገንሞ አከ ጃመኒፍ አን ሙርቲፍ ገረ አዱኛ ከና ዹፌረ”</char> ጄዼ።<verse eid="JHN 9:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40"/>ፈሪሶተ እሰ ወጅን ቱረን ኬሳ ቶኮ ቶኮ ዋን ከነ ጄቹሳ ዸገአኒ፣ “ኑስ ጃሞተ ምቲሬ?” ጄዸኒ ጋፈተን።<verse eid="JHN 9:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41"/>ዬሱስስ፣ <char style="wj">“ኡቱ ጃሞተ ታተኒ ስላ ጩቡ ህንቀብደን ቱርተን፤ እስን ገሩ፣ ‘ንአርግነ’ ጄቱ፤ ጩቡንኬሰን ንጅራተ”</char> ጄዼን።<verse eid="JHN 9:41"/></para>
  <chapter eid="JHN 9"/>
  <chapter number="10" style="c" sid="JHN 10"/>
  <para style="s1">ትክሴ ጋሪፊ ሆሎተሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1"/>
    <char style="wj">“አን ዹጉመን፣ ዹጉመን እስንት ህመ፤ ነምን በልበላን ጎለ ሆሎታ ህንሴኔ፣ ገሩ ከራ ብራቲን ኮሬ ሴኑ እን ሀቱፊ ሳምቱዸ።</char> <verse eid="JHN 10:1"/><verse number="2" style="v" sid="JHN 10:2"/><char style="wj">ነምን በልበላን ሴኑሞ ትክስቱ ሆሎታት።</char> <verse eid="JHN 10:2"/><verse number="3" style="v" sid="JHN 10:3"/><char style="wj">ኤግዱንስ በልበለ እሳፍ በነ፤ ሆሎትንስ ሰገሌሳ ንዸገኡ። እንስ ሆሎተሳ መቃ መቃን ዋሜ ገድ ያሰ።</char> <verse eid="JHN 10:3"/><verse number="4" style="v" sid="JHN 10:4"/><char style="wj">ኤርገ ወረ ከንሳ ተአን ሁንደ ገድ ያሴ ቦዴ እሳን ዱረ ዴመ፤ ሆሎትንሳስ ዋን ሰገሌሳ ቤከኒፍ እሰ ፋነ ቡኡ።</char> <verse eid="JHN 10:4"/><verse number="5" style="v" sid="JHN 10:5"/><char style="wj">ኦርመ ገሩ ንበቀቱ መሌ ፋነ ህንቡአን፤ ሰገሌ ኦርማ ህንቤከኒቲ።”</char> <verse eid="JHN 10:5"/><verse number="6" style="v" sid="JHN 10:6"/>ዬሱስ ፈኬኘ ከነ እሳንት ህሜ፤ እሳን ገሩ አከ እን ማል እሳንት ህማ ቱሬ ህንሁበትኔ።<verse eid="JHN 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7"/>ከናፉ ዬሱስ አመስ አከነ ጄዼን፤ <char style="wj">“ዹጉመን፣ ዹጉመን እስንት ህመ፤ አን በልበለ ሆሎታት።</char> <verse eid="JHN 10:7"/><verse number="8" style="v" sid="JHN 10:8"/><char style="wj">ወር ነ ዱረ ዹፈን ሁንድ ሀቶታፊ ሳምቶተ፤ ሆሎትን ገሩ እሳን ህንዸጌኜ።</char> <verse eid="JHN 10:8"/><verse number="9" style="v" sid="JHN 10:9"/><char style="wj">በልበል አነ፤ ነምን ከራኮቲን ኦል ሴኑ ከምዩ ንፈየ። እን ንሴነ፤ ንበአስ፤ ለፈ ዼዳስ ንአርገተ።</char> <verse eid="JHN 10:9"/><verse number="10" style="v" sid="JHN 10:10"/><char style="wj">ሀትች ሀቱፍ፣ አጄሱፊ በሌሱ ቆፋፍ ዹፈ፤ አን ገሩ አከ እሳን ጅሬኘ ቀባተኒፍ፣ ጅሬኘ እራ ሀፋስ አከ ቀባተኒፍ ዹፌረ።</char><verse eid="JHN 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11"/>
    <char style="wj">“ትክስቱን ጋሪን አነ። ትክስቱን ጋሪን ሆሎተሳቲፍ ጄዼ ሉቡሳ ደበርሴ ኬነ።</char> <verse eid="JHN 10:11"/><verse number="12" style="v" sid="JHN 10:12"/><char style="wj">ነምን ቀጨረማን ከን ትክስቱ ህንተእን ገሩ ዋን ሆሎትን ከንሳ ህንተእኒፍ ዮሙ ዹፋቲ ዬዪ አርጉት ሆሎተ ዺሴ በቀተ። ዬዪንስ ቡሻዬ ንቡተተ፤ ንብትኔሰስ።</char> <verse eid="JHN 10:12"/><verse number="13" style="v" sid="JHN 10:13"/><char style="wj">ነምች ዋን ቀጨረማ ተኤፍ ንበቀተ፤ ዽመ ሆሎታስ ህንቀቡ።</char><verse eid="JHN 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 10:14"/>
    <char style="wj">“ትክሴን ጋሪን አነ፤ አን ሆሎተኮ ቤከ፤ ሆሎትንኮስ ነ ቤኩ፤</char> <verse eid="JHN 10:14"/><verse number="15" style="v" sid="JHN 10:15"/><char style="wj">ኩንስ አኩመ አባን ነ ቤኩቲፊ አኩመ አን አባ ቤኩት። አንስ ሉቡኮ ሆሎታፍ ነንኬነ።</char> <verse eid="JHN 10:15"/><verse number="16" style="v" sid="JHN 10:16"/><char style="wj">አን ወረ ጎለ ከነት ገለን መሌስ ሆሎተ ገረ ብራ ቀበ። እሳንስ ፍዱን ቀበ። እሳንስ ሰገሌኮ ንዸገኡ፤ ከረ ቶኮስ ንተኡ፤ ትክስቱንሳኒስ ቶኮ ተአ።</char> <verse eid="JHN 10:16"/><verse number="17" style="v" sid="JHN 10:17"/><char style="wj">ከናፉ አባን ዋን አን ዴብሴ ፉዸቹፍ ሉቡኮ ደበርሴ ኬኑፍ ነ ጃለተ።</char> <verse eid="JHN 10:17"/><verse number="18" style="v" sid="JHN 10:18"/><char style="wj">ሉቡኮ አኑመቱ ኦፊኮቲን ደበርሴ ኬነ መሌ ኤኙዩ ነራ ህንፉዸቱ። አን ሉቡኮ ደበርሴ ኬኑፍ ታይታ ቀበ፤ ዴብሴ ፉዸቹፍስ ታይታ ቀበ። አጀጀ ከነስ አባኮ ብራ ፉዸዼረ።”</char><verse eid="JHN 10:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19"/>አመሌ ሰበቢ ዱቢ ከናቲፍ ይሁዶተ ግዱት ገራ ገሩማን ኡመሜ። <verse eid="JHN 10:19"/><verse number="20" style="v" sid="JHN 10:20"/>ባይኤንሳኒስ፣ “ሀፉረ ሀማቱ እሰ ኬሰ ጅረ፤ እን መራቴረ። እስን ማሊፍ እሰ ዸጌሱ?” ጄዸን።<verse eid="JHN 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21"/>ወር ካንሞ፣ “ኩን ጄቸ ነመ ሀፉረ ሀማዻን ቀበሜ ምት። ሀፉር ሀማን እጀ ነመ ጃማ በኑ ንደንደኣ?” ጄዸን።<verse eid="JHN 10:21"/></para>
  <para style="s1">አመንቲ ዸቡ ይሁዶታ</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22"/>ዬሮ ሰነ አያን መነ ቁልቁሉማ ሃሮምሱ<note caller="+" style="f"><char style="fr" closed="false">10፥22 </char><char style="fq" closed="false">አያን መነ ቁልቁሉማ ሃሮምሱ </char><char style="fqa" closed="false">ሀኑካ ጄዸሜ ቤከመ </char><char style="ft" closed="false">– ጅእ ሀኑካ ሰዳሳ ወጅን ቶኩመ። አያን ኩንስ ጉያ እት ይሁዳ መቃቢስ (ዸሎተ ክርስቶስ ዱረ በረ 164 ኬሰ) መነ ቁልቁሉማ ከን ነሞትን ሶርያ ወጋ ሰዲ ጡሬሰን ሰነ ሃሮምሴ ያደቹፍ ጎዸሜ። አያንችስ ጉያ ድግደሚ ሸነፋ ጅአ ሰናራ ጀልቀቤ ሀመ ጉያ ሰዴቲት አያኔፈመ ቱሬ። ዬሮን ኩን ይሁዶታፍ ዬሮ ገመቹ ጉዳ ቱሬ።</char></note> ዬሩሳሌምት አያኔፈሜ ቱሬ። ዬሮን ሱንስ ገነ ቱሬ፤ <verse eid="JHN 10:22"/><verse number="23" style="v" sid="JHN 10:23"/>ዬሱስስ መነ ቁልቁሉማ ኬሰ ገርዳፎ ሶሎሞን ኬሰ ዴዴብኣ ቱሬ። <verse eid="JHN 10:23"/><verse number="24" style="v" sid="JHN 10:24"/>ይሁዶትንስ እሰ መርሰኒ፣ “ሀመ ዮሚት ቀልቢ ኑ ረራፍታ? አት ዮ ክርስቶስ ታቴ እፈት ባሲ ኑት ህም” ጄዸኒን።<verse eid="JHN 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25"/>ዬሱስስ አከነ ጄዼ ዴብሴፍ፤ <char style="wj">“አን እስንት ህሜረ፤ እስን ገሩ ህንአመንተን። ሆጂን አን መቃ አባኮቲቲን ሆጄዹ ዋኤኮ ዹጋ በአ።</char> <verse eid="JHN 10:25"/><verse number="26" style="v" sid="JHN 10:26"/><char style="wj">እስን ገሩ ዋን ሆሎተኮ ህንተእኒፍ ህንአመንተን።</char> <verse eid="JHN 10:26"/><verse number="27" style="v" sid="JHN 10:27"/><char style="wj">ሆሎትንኮ ሰገሌኮ ንዸገኡ፤ አንስ እሳን ቤከ፤ እሳንስ ነ ፋነ ቡኡ።</char> <verse eid="JHN 10:27"/><verse number="28" style="v" sid="JHN 10:28"/><char style="wj">አንስ ጅሬኘ በረ በራ ነንኬናፍ፤ እሳንስ ጎንኩማ ህንበደን። ኤኙዩ ሀርከኮ ኬሳ እሳን ህንቡተቱ።</char> <verse eid="JHN 10:28"/><verse number="29" style="v" sid="JHN 10:29"/><char style="wj">አባንኮ ከን ነት እሳን ኬኔ ሱን ሁንዱመ ጫለ፤ ነምን ቶኮዩ ሀርከ አባኮቲ ኬሳ እሳን ቡተቹ ህንደንደኡ።</char> <verse eid="JHN 10:29"/><verse number="30" style="v" sid="JHN 10:30"/><char style="wj">አኒፊ አባን ቶኩመ።”</char><verse eid="JHN 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31"/>ይሁዶትን እሰ ዸኡፍ ጄዸኒ አመስ ዸጋ ጉረተን። <verse eid="JHN 10:31"/><verse number="32" style="v" sid="JHN 10:32"/>ዬሱስስ፣ <char style="wj">“አን ሆጂ አባኮ ጋሪ ባይኤ እስንት አርግሲሴረ። ሆጂ ከነ ኬሳ እስን ሰበቢ እሰ ከሚቲፍ ዸጋዻን ነ ዾፍቱ?”</char> ጄዼን።<verse eid="JHN 10:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33"/>ይሁዶትንስ፣ “ኑ ሆጂ ጋሪፍ ጄኔ ዸጋዻን ስ ህንዾፍኑ፤ ገሩ ዋን አት ዋቀ አረብስቴ ኡቱመ ነመ ታቴ ጅርቱ ዋቀ ኦፍ ጎቴፍ ስዾፍነ” ጄዸኒ ዴብሰኒፍ።<verse eid="JHN 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34"/>ዬሱስሞ አከነ ጄዼ ዴብሴፍ፤ <char style="wj">“ሴረኬሰን ኬሰት፣ ‘አኑ፣ “እስን ዋቆተ” ጄዼረ’</char><note caller="+" style="f"><char style="fr" closed="false">10፥34 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 82:6">ፋር 82፥6</ref></char></char></note> <char style="wj">ጄዸሜ በሬፈሜረ ምቲ?</char> <verse eid="JHN 10:34"/><verse number="35" style="v" sid="JHN 10:35"/><char style="wj">እን ኤርገ ወረ ዱቢን ዋቃ እሳኒፍ ዹፌን ‘ዋቆተ’ ጄዼ፣ ከተቢን ቁልቁሉንሞ ዋን ህንዲገምኔፍ፣</char> <verse eid="JHN 10:35"/><verse number="36" style="v" sid="JHN 10:36"/><char style="wj">ሰበቢ አን፣ ‘አን እልመ ዋቃት’ ጄዼፍ፣ እስን ማሊፍ እሰ አባን ቁልቁሌሴ ገረ አዱኛት ኤርጌ ሰናን ‘አት ዋቀ አረብስተ’ ጄቱ?</char> <verse eid="JHN 10:36"/><verse number="37" style="v" sid="JHN 10:37"/><char style="wj">ዮ አን ሆጂ አባኮቲ ሆጄቹ ባዼ ነ ህንአመንና።</char> <verse eid="JHN 10:37"/><verse number="38" style="v" sid="JHN 10:38"/><char style="wj">ዮ አን ሆጂ ሰነ ሆጄዼ ገሩ ዮ ነ አመኑ ባተንሌ ሆጅቸ አመና፤ ኩንስ አከ አባን ነ ኬሰ ጅሩ፣ አከ አንስ አባ ኬሰ ጅሩ ቤክተኒ አከ ሁበተኒፍ።”</char> <verse eid="JHN 10:38"/><verse number="39" style="v" sid="JHN 10:39"/>እሳን አመሌ እሰ ቀቡ በርባደን፤ እን ገሩ እሳን ሀርካ ምልቄ።<verse eid="JHN 10:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40"/>ዬሱስ ኤርገሲ ዴብኤ ዮርዳኖስ ገመ እዶ ዮሀንስ ጀልቀበት እት ጩጳ ቱሬ ሰነ ዸቄ አችስ ቱሬ። <verse eid="JHN 10:40"/><verse number="41" style="v" sid="JHN 10:41"/>ነሞትን ባይኤንስ ገረሳ ዹፈኒ፣ “ዮሀንስ መለቶ ቶኮሌ ህንሆጄትኔ፤ ገሩ ወን እን ዋኤ ነምቸ ከና ዱበቴ ሁንድኑ ዹጋዸ” ጄዸን። <verse eid="JHN 10:41"/><verse number="42" style="v" sid="JHN 10:42"/>አችትስ ነሞትን ሄዱን ዬሱስት አመነን።<verse eid="JHN 10:42"/></para>
  <chapter eid="JHN 10"/>
  <chapter number="11" style="c" sid="JHN 11"/>
  <para style="s1">ዱኡ አልኣዛር</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1"/>ነምች አልኣዛር ጄዸሙ ከን ቢታንያ ኬሰ ጅራቱ ቶኮ ዹኩብሰቴ ቱሬ። ቢታንያን ገንደ ማርያሚፊ ኦቦሌቲንሼ ማርታን ኬሰ ጅራተኒዸ። <verse eid="JHN 11:1"/><verse number="2" style="v" sid="JHN 11:2"/>ማርያም እሼን ኦቦሌስሼ አልኣዛር ዹኩብሰቴ ኩን፣ እሼዹመ ጎፍታ ሽቶ ድብዴ ርፌንሰ መታሼቲን ሚለሳ ሀቅጤ ሰናዸ። <verse eid="JHN 11:2"/><verse number="3" style="v" sid="JHN 11:3"/>ከናፍ ኦቦሌቶትንሳ፣ “ያ ጎፍታ፣ እን አት ጃለቱ ኩኖ ዹኩብሰቴ ጅረ” ጄዸኒ ዬሱስት ዻመን።<verse eid="JHN 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4"/>ዬሱስስ ዮሙ ዋን ከነ ዸገኤት፣ <char style="wj">“ዽቤን ኩን አከ እልም ዋቃ እቲን ኡልፋቱፍ፣ ኡልፍነ ዋቃቲፍ ዹፌ መሌ ዱኣን ህንገኡ”</char> ጄዼ። <verse eid="JHN 11:4"/><verse number="5" style="v" sid="JHN 11:5"/>ዬሱስስ ማርታፊ ኦቦሌቲሼ፣ አልኣዛርንስ ንጃለተ ቱሬ። <verse eid="JHN 11:5"/><verse number="6" style="v" sid="JHN 11:6"/>እንስ ዮሙ አከ አልኣዛር ዹኩብሰቴ ዸገኤት ጉያ ለመ እዱመ ጅሩ ሰነ ቱሬ። <verse eid="JHN 11:6"/><verse number="7" style="v" sid="JHN 11:7"/>እንስ ኤርገሲ በረቶተሳቲን፣ <char style="wj">“ኮታ ይሁዳት ዴብና”</char> ጄዼ።<verse eid="JHN 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8"/>በረቶትንሳሞ፣ “ያ በርሲሳ፣ ይሁዶትን ዽኤኘ ከነ ዸጋዻን ስቱሙ በርባዳ ቱረን፤ አት አመሌ ዴብቴ አች ዸቅጣ?” ጄዸኒን።<verse eid="JHN 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9"/>ዬሱስስ አከነ ጄዼ ዴብሴፍ፤ <char style="wj">“ጉያን ቶኮ ሰኣቲ ኩዸ ለመ ቀባ ምቲ? ነምን ጉያን ዴሙ ዋን እፈ አዱኛ ከናቲን አርጉፍ ህንጉፈቱ።</char> <verse eid="JHN 11:9"/><verse number="10" style="v" sid="JHN 11:10"/><char style="wj">ከን ሀልከኒን ዴሙ ገሩ ሰበቢ እፍን እሰ ኬሰ ህንጅሬፍ ንጉፈተ።”</char><verse eid="JHN 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 11:11"/>እንስ ኤርገ ዋን ከነ ዱበቴ ቦዴ፣ <char style="wj">“ምቹንኬኘ አልኣዛር ረፌረ፤ አን ገሩ ህርባ እሰ ካሱ ነንዸቀ”</char> እሳኒን ጄዼ።<verse eid="JHN 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12"/>በረቶትንሳስ፣ “ያ ጎፍታ፣ ዮ ረፌ ጅራቴ ንፈየ” ጄዸኒን። <verse eid="JHN 11:12"/><verse number="13" style="v" sid="JHN 11:13"/>ዬሱስ ዋኤ ዱአ አልኣዛር ዱበቴ፤ በረቶትንሳ ገሩ ዋን እን ዋኤ ረፊቲ ህርባ ዱበቴ ሴአን።<verse eid="JHN 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 11:14"/>ከናፉ ዬሱስ አከነ ጄዼ እፈት ባሴ እሳንት ህሜ፤ <char style="wj">“አልኣዛር ዱኤረ፤</char> <verse eid="JHN 11:14"/><verse number="15" style="v" sid="JHN 11:15"/><char style="wj">አከ እስን አመንተኒፍ አን ዋን አች ህንቱርኒፍ ዋኤኬሰኒፍ ነንገመደ። ተኡስ ኮታ ገረሳ ዸቅና።”</char><verse eid="JHN 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16"/>ቶማስ እን ድድሞስ ጄዸሙሞ በረቶተ ካኒን፣ “ኑስ አከ እሰ ወጅን ዱኑፍ ከኣ ንዸቅና” ጄዼ።<verse eid="JHN 11:16"/></para>
  <para style="s1">ዬሱስ ኦቦሌቶተ አልኣዛር ጀጀቤሱሳ</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17"/>ዬሱስ ዮሙ አች ገኤት አልኣዛር ኤርገ አዋለሜ ጉያ ሀፉር አከ ቱሬ ቤኬ። <verse eid="JHN 11:17"/><verse number="18" style="v" sid="JHN 11:18"/>ቢታንያን ዬሩሳሌምራ ገረ ኪሎ ሜትረ ሰዲ ፈጋት ቱርቴ፤ <verse eid="JHN 11:18"/><verse number="19" style="v" sid="JHN 11:19"/>ይሁዶትን ባይኤን ማርታፊ ማርያምን ሰበቢ ኦቦሌሰሳኒቲፍ እሳን ጀጀቤሱ ዸቀኒ ቱረን። <verse eid="JHN 11:19"/><verse number="20" style="v" sid="JHN 11:20"/>ማርታን ዮሙ ዹፋቲ ዬሱስ ዸጌሴት እሰ ስመቹ ገድ ባቴ፤ ማርያም ገሩ መነ ቴሴ።<verse eid="JHN 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 11:21"/>ማርታንስ ዬሱሲን አከነ ጄቴ፤ “ያ ጎፍታ፣ ኡቱ አት አስ ጅራቴ ስላ ኦቦሌስኮ ህንዱኡ ቱሬ። <verse eid="JHN 11:21"/><verse number="22" style="v" sid="JHN 11:22"/>አመስ ታናን አከ ዋን አት ዋቀ ከዸቱ ሁንደ ዋቅን ሲፍ ኬኑ ነንቤከ።”<verse eid="JHN 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23"/>ዬሱስስ፣ <char style="wj">“ኦቦሌስኬ ንከአ”</char> ጄዼን።<verse eid="JHN 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24"/>ማርታንስ ዴብፍቴ፣ “አከ እን ዱኣ ከኡ ጉያ ዹማ ሰነት ከኡ አኑ ቤከ” ጄቴን።<verse eid="JHN 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25"/>ዬሱስሞ አከነ እሼዻን ጄዼ፤ <char style="wj">“ዱኣ ከኡኒፊ ጅሬኝ አነ። ነምን ነት አመኑ ዮ ዱኤዩ ንጅራተ፤</char> <verse eid="JHN 11:25"/><verse number="26" style="v" sid="JHN 11:26"/><char style="wj">ከን ነ ኬሰ ጅራቱፊ ከን ነት አመኑ ሁንድኑ በረ በራን ህንዱኡ። ከነ ንአመንታሬ?”</char><verse eid="JHN 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27"/>እሼንስ፣ “ኤዬ ያ ጎፍታ፣ አከ አት ክርስቶስ እልመ ዋቃ ከን ገረ አዱኛ ዹፉ ሰነ ታቴ ነንአመነ” ጄቴን።<verse eid="JHN 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28"/>እሼንስ ኤርገ አከስ ጄቴ ዸቅጤ ኦቦሌቲሼ ማርያምን ኮጳት ዋምቴ፣ “በርሲሳን ዹፌረ፤ ስዋመስ” ጄቴን። <verse eid="JHN 11:28"/><verse number="29" style="v" sid="JHN 11:29"/>ማርያምስ ዮሙ ዋን ከነ ዸጌሴት አሪቲን ካቴ ገረሳ ዸቅጤ። <verse eid="JHN 11:29"/><verse number="30" style="v" sid="JHN 11:30"/>ዬሱስ ዬሮ ሰነ እዶ ማርታን እት እሰ ስመቴ ቱሬ መሌ አመሌ ገንደ ሰነ ህንሴኔ። <verse eid="JHN 11:30"/><verse number="31" style="v" sid="JHN 11:31"/>ይሁዶትን ማርያምን ጀጀቤሳ መነ ኬሰ እሼ ወጅን ቱረንስ ዮሙ አከ እሼን አሪቲዻን ካቴ ገድ ባቴ አርገንት ዋን እሼን አችት ቦኡፍ ጄቴ ገረ አዋላ ዸቅጡ ሴአኒ እሼ ዱካ ቡአን።<verse eid="JHN 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32"/>ማርያምስ ዮሙ እዶ ዬሱስ ቱሬ ሰነ ጌሴ እሰ አርግቴት፣ ሚለሳረት ኩፍቴ፣ “ያ ጎፍታ ኡቱ አት አስ ጅራቴ ስላ ኦቦሌስኮ ህንዱኡ ቱሬ” ጄቴን።<verse eid="JHN 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33"/>ዬሱስስ ዮሙ ቦኡሼ፣ ይሁዶትን እሼ ወጅን ዹፈንስ ቦኡሳኒ አርጌት ሀፉራን አከ መሌ ጄቀሜ፤ ንዽጰቴስ። <verse eid="JHN 11:33"/><verse number="34" style="v" sid="JHN 11:34"/>እንስ፣ <char style="wj">“ኤሰ እሰ ኬሰን?”</char> ጄዼ እሳን ጋፈቴ።</para>
  <para style="p" vid="JHN 11:34">እሳንስ፣ “ያ ጎፍታ፣ ኮቱ እላል” ጄዸኒን።<verse eid="JHN 11:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35"/>ዬሱስስ እምማን ዸንገላሴ።<verse eid="JHN 11:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 11:36"/>ይሁዶትንስ፣ “እን ሀመም አከ እሰ ጃለቱ ሜ እላላ!” ጄዸን።<verse eid="JHN 11:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37"/>እሳን ኬሳ ቶኮ ቶኮ ገሩ፣ “እን ከን እጀ ነምቸ ጃማ ሰና በኔ፣ አከ ነምች ኩንስ ህንዱኔ ጎቹ ህንደንደኡ ቱሬ?” ጄዸን።<verse eid="JHN 11:37"/></para>
  <para style="s1">ዬሱስ አልኣዛርን ዱኣ ካሴ</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38"/>ዬሱስ አመስ አከ መሌ ጄቀሜ ገረ አዋለ ሰና ዸቄ። አዋል ሱንስ ሆልቀ በልበልሳ ዸጋዻን ጩፈሜ ቶኮ ቱሬ። <verse eid="JHN 11:38"/><verse number="39" style="v" sid="JHN 11:39"/>ዬሱስስ፣ <char style="wj">“ዸጋ ከነ አችራ ፉዻ!”</char> ጄዼ።</para>
  <para style="p" vid="JHN 11:39">ማርታን ኦቦሌቲን እሰ ዱኤ ሰና ገሩ፣ “ያ ጎፍታ፣ እን ኤርገ አዋለሜ ዋን ጉያ አፉር ቱሬፍ ዮነ ንአጃአ” ጄቴን።<verse eid="JHN 11:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40"/>ዬሱስሞ፣ <char style="wj">“አት ዮ አመንቴ አከ ኡልፍነ ዋቃ አገርቱ አን ስት ህንህምኔ?”</char> ጄዼን።<verse eid="JHN 11:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 11:41"/>ከናፉ እሳን ዸግቸራ ካሰን። ዬሱስስ ኦል እላሌ አከነ ጄዼ፤ <char style="wj">“ያ አባ፣ ዋን አት ነ ዸጌሴፍ ስን ገለቴፈዸ።</char> <verse eid="JHN 11:41"/><verse number="42" style="v" sid="JHN 11:42"/><char style="wj">አከ አት ዬሮ ሁንደ ነ ዸጌሱ አን ቤኬረ፤ ገሩ አከ ነሞትን አስ ዸዻበተን ኩኔን አከ አት ነ ኤርግቴ አመነኒፍ አን እሳኒፍ ጄዼን ዋን ከነ ዱበዼ።”</char><verse eid="JHN 11:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 11:43"/>ዬሱስስ ዋን ከነ ዱበቴ፣ <char style="wj">“አልኣዛር፣ አስ በእ!”</char> ጄዼ ሰገሌ ጉዳዻን እዬ። <verse eid="JHN 11:43"/><verse number="44" style="v" sid="JHN 11:44"/>ነምች ዱኤ ሱንስ አኩመ ሀርክሳቲፊ ሚልሳ ሁጩዻን ከፈነሜ፣ ፉልሳስ ወያዻን መረሜት ገድ በኤ።</para>
  <para style="p" vid="JHN 11:44">ዬሱስስ፣ <char style="wj">“እሰ ሂካ፣ ሃዴሙ”</char> እሳኒን ጄዼ።<verse eid="JHN 11:44"/></para>
  <para style="s1">መለ ዬሱስን አጄሱፍ መለሜ</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45"/>ከናፉ ይሁዶተ ገረ ማርያም ዹፈኒ ዋን ዬሱስ ሆጄቴ አርገን ኬሳ ሄዱን እሰት አመነን። <verse eid="JHN 11:45"/><verse number="46" style="v" sid="JHN 11:46"/>እሳን ኬሳ ቶኮ ቶኮ ገሩ ፈሪሶተ ብረ ዸቀኒ ዋን ዬሱስ ሆጄቴ እት ህመን። <verse eid="JHN 11:46"/><verse number="47" style="v" sid="JHN 11:47"/>ከነረት ሉቦትን ሀንገፎትኒፊ ፈሪሶትን ያኢ ይሁዶታ ዋመን።</para>
  <para style="p" vid="JHN 11:47">እሳንስ አከነ ጄዸኒ ጋፈተን፤ “ነምች ኩን መለቶ ባይኤ አርግሲሳ ጅረ። ማል ሃጎኑ? <verse eid="JHN 11:47"/><verse number="48" style="v" sid="JHN 11:48"/>ዮ አከሱመት እሰ ዺፍኔ ነምን ሁንድ እሰት አመነ፤ ወር ሮማስ ዹፈኒ እዶኬኛፊ ሰበኬኘ ኑራ ፉዸቱ።”<verse eid="JHN 11:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49"/>እሳን ኬሳስ ነምች ቀያፋ ጄዸሙ ከን በረ ሰነ ሉበ ኦል ኣና ቱሬ ቶኮ አከነ እሳኒን ጄዼ፤ “እስን ዋን ቶኮሌ ህንቤክተን! <verse eid="JHN 11:49"/><verse number="50" style="v" sid="JHN 11:50"/>ሰብን ጉቱማት ዹሙረ ነምን ቶኮ ሰባፍ ዱኡን አከ እስኒ ወዩ ህንሁበተን።”<verse eid="JHN 11:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 11:51"/>እን በረ ሰነ ዋን ሉበ ኦል ኣና ቱሬፍ፣ አከ ዬሱስ ሰበ ሰናፍ ዱኡ ራጂ ዱበቹ እሳት መሌ ዱቢ ከነ ኦፍ ኬሳ ፉዼ ህንዱበትኔ፤ <verse eid="JHN 11:51"/><verse number="52" style="v" sid="JHN 11:52"/>ኩንስ እጆሌ ዋቃ ከኔን ብትናአን ወልት ቀቤ ቶኮ ጎቹፍ መሌ ሰበ ሰነ ቆፋፊ ምት። <verse eid="JHN 11:52"/><verse number="53" style="v" sid="JHN 11:53"/>ከናፉ እሳን ጋፈሲ ጀልቀበኒ እሰ አጄሱፍ መለቻ ቱረን።<verse eid="JHN 11:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 11:54"/>ከናፉ ዬሱስ እፈት በኤ ይሁዶተ ግዱ ህንዴዴብኔ። አቺ ከኤ ገረ መጋላ ኤፍሬም ጄዸሙ ከን ገሞጂት ዽኣቱ ቶኮ ዸቄ፤ በረቶተሳ ወጅንስ አች ቱሬ።<verse eid="JHN 11:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55"/>ፋሲካን ይሁዶታ ዋን ዽኣቴ ቱሬፍ፣ ነሞትን ሄዱን ኡቱ ፋሲካን ህንገእን ኦፍ ቁልቁሌሱፍ ጄዸኒ ባድያዻ ዬሩሳሌምት ኦል በአን። <verse eid="JHN 11:55"/><verse number="56" style="v" sid="JHN 11:56"/>እሳንስ ዬሱስን በርባዳ ቱረን፤ መነ ቁልቁሉማ ኬሰስ ዻበተኒ፣ “እስን ማል ሴተን? እን ገረ አያነ ከና ህንዹፉ ላተ?” ወሊን ጄዸን። <verse eid="JHN 11:56"/><verse number="57" style="v" sid="JHN 11:57"/>ሉቦትን ሀንገፎትኒፊ ፈሪሶትን ገሩ ዬሱስን ቀቡፍ ጄዸኒ ነምን እዶ እን ጅሩ ቤኩ ዮ ጅራቴ አከ እሳንት ህሙፍ አጀጀ ኬነኒ ቱረን።<verse eid="JHN 11:57"/></para>
  <chapter eid="JHN 11"/>
  <chapter number="12" style="c" sid="JHN 12"/>
  <para style="s1">ዬሱስ ቢታንያት ሽቶ ድበሜ</para>
  <para style="r">
    <ref loc="JHN 12:1-8">12፥1‑8</ref> ኩወእ – <char style="xt"><ref loc="MAT 26:6-13">ማቴ 26፥6‑13</ref>፤ <ref loc="MRK 14:3-9">ማር 14፥3‑9</ref>፤ <ref loc="LUK 7:37-39">ሉቃ 7፥37‑39</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1"/>ፋሲካ ዱረ ጉያ ጀአፋት ዬሱስ ገረ ቢታንያ ገንደ አልኣዛር፣ ከን ዬሱስ ዱኣ እሰ ካሴ ሱን ጅራቻ ቱሬ ዸቄ። <verse eid="JHN 12:1"/><verse number="2" style="v" sid="JHN 12:2"/>አችት እርባተ ቆጴሰኒፍ። ማርታንስ ንተጃጅልት ቱርቴ፤ አልኣዛርስ ወረ እሰ ወጅን እርባተት ዽኣተን ኬሳ ቶኮ ቱሬ። <verse eid="JHN 12:2"/><verse number="3" style="v" sid="JHN 12:3"/>ማርያምስ ሽቶ ናርዶስ ቁልቁሉ ገቲንሳ ጉዳ ከን ገረ ሊትሪ ወለካ ተኡ ፍዴ ሚለ ዬሱስ ድብዴ፤ ርፌንሰ መታሼቲንስ ሚለሳ ሀቅጤ። መንችስ ኡርጋ ሽቶ ሰናቲን ጉተሜ።<verse eid="JHN 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 12:4"/>በረቶተሳ ኬሳ ቶኮ ከን ደበርሴ እሰ ኬኑፍ ጅሩ ይሁዳ አስቆሮትች ገሩ አከነ ጄዼ፤ <verse eid="JHN 12:4"/><verse number="5" style="v" sid="JHN 12:5"/>“ሽቶን ኩን ማሊፍ ዲናሪ ዽበ ሰዲት<note caller="+" style="f"><char style="fr" closed="false">12፥5 </char><char style="fq" closed="false">ዲናሪ ዽበ ሰዲት </char><char style="ft" closed="false">– ዲናሪን ዽበ ሰዲ ምንዳ ሆጄታን ቶኮ ወጋት አርገቱዸ።</char></note> ጉርጉረሜ ህዬዪፍ ህንኬነምኔ?” <verse eid="JHN 12:5"/><verse number="6" style="v" sid="JHN 12:6"/>አከነ ጄቹንሳ ዋን ሀቱ ቱሬፍ መሌ ህዬዪፍ ያዴ ምት። እንስ ሰበቢ ኮሮጆን ማለቃ ሀርከሳ ቱሬፍ፣ ዋን አች ኬሰ ቡፈሙራ ኦፊሳቲ ፉዸቻ ቱሬ።<verse eid="JHN 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7"/>ዬሱስስ ዴብሴ አከነ ጄዼ፤ <char style="wj">“እሼን ሽቶ ከነ ጉያ አዋለኮቲፍ ሃቱርስቱቲ እሼ ዺሳ።</char> <verse eid="JHN 12:7"/><verse number="8" style="v" sid="JHN 12:8"/><char style="wj">ህዬዪ ዬሮ ሁንደ ኦፍ ብራ ቀብዱ፤ አነ ገሩ ዬሮ ሁንደ ኦፍ ብራ ህንቀብደን።”</char><verse eid="JHN 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9"/>ይሁዶትን ባይኤን አከ ዬሱስ አች ጅሩ ቤከኒ ዬሱስ ቆፋፍ ጄዻኒ ኡቱ ህንተእን፣ አልኣዛር እሰ እን ዱኣ ካሴስ እላሉፍ ዹፈን። <verse eid="JHN 12:9"/><verse number="10" style="v" sid="JHN 12:10"/>ከናፉ ሉቦትን ሀንገፎትን አልኣዛርንስ አጄሱፍ መርአተን፤ <verse eid="JHN 12:10"/><verse number="11" style="v" sid="JHN 12:11"/>ይሁዶተ ኬሳ ነሞትን ባይኤን ሰበቢሳቲፍ ዸቀኒ ዬሱስት አመና ቱረኒቲ።<verse eid="JHN 12:11"/></para>
  <para style="s1">ዬሱስ አከ ሞቲት ዬሩሳሌም ሴኑሳ</para>
  <para style="r">
    <ref loc="JHN 12:12-15">12፥12‑15</ref> ኩወፈ – <char style="xt"><ref loc="MAT 21:4-9">ማቴ 21፥4‑9</ref>፤ <ref loc="MRK 11:7-10">ማር 11፥7‑10</ref>፤ <ref loc="LUK 19:35-38">ሉቃ 19፥35‑38</ref></char></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12"/>ጉያ እት ኣኑት ነሞትን አያንቻፍ ዹፈኒ ቱረን ባይኤን አከ ዬሱስ ገረ ዬሩሳሌም ዹፋ ጅሩ ዸገአን። <verse eid="JHN 12:12"/><verse number="13" style="v" sid="JHN 12:13"/>እሳንስ ደሜ ሜጢ ሀርከት ቀበተኒ እሰ ስመቹ በአን፤ እየኒስ አከነ ጄዸን፤</para>
  <para style="q1" vid="JHN 12:13">“ሆሳእና!”<note caller="+" style="f"><char style="fr" closed="false">12፥13 </char><char style="fq" closed="false">“ሆሳእና!” </char><char style="ft" closed="false">– ሆሳእና ጄቹን አፋን እብራይስጢቲን “አመ ፈይስ” ጄቹዸ፤ ኩንስ ጄቸ ገለታት።</char></note></para>
  <para style="b" vid="JHN 12:13"/>
  <para style="q1" vid="JHN 12:13">“እን መቃ ጎፍታቲን ዹፉ ኤብፈማዸ!”<note caller="+" style="f"><char style="fr" closed="false">12፥13 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 118:25">ፋር 118፥25</ref>፣<ref loc="PSA 118:26">26</ref></char></char></note></para>
  <para style="b" vid="JHN 12:13"/>
  <para style="q1" vid="JHN 12:13">“ሞቲን እስራኤል ኤብፈማዸ!”<verse eid="JHN 12:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="JHN 12:14"/>ዬሱስስ እልሞ ሀሬ ቶኮ አርገቴ ያበቴ፤ ኩንስ አኩመ አከነ ጄዸሜ በሬፈሜዸ፤<verse eid="JHN 12:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15"/>“ያ እንተለ ጥዮን፣ ህንሶዳትን፤</para>
  <para style="q2" vid="JHN 12:15">ኩኖ፣ ሞቲንኬ፣</para>
  <para style="q2" vid="JHN 12:15">እልሞ ሀሬ ያበቴ ዹፉት ጅረ።”<note caller="+" style="f"><char style="fr" closed="false">12፥15 </char><char style="ft" closed="false"><char style="xt"><ref loc="ZEC 9:9">ዘካ 9፥9</ref></char></char></note><verse eid="JHN 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16"/>በረቶትንሳ ጀልቀበት ዋን ከነ ህንሁበትኔ። ኤርገ ዬሱስ ኡልፍነ አርገቴን ቦዴ ገሩ አከ ወን በሬፈሜ ኩን ዋኤሳ ተኤፊ አከ እሳንስ ዋኑመ ከነ እሳፍ ጎዸን ያደተን።<verse eid="JHN 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17"/>ነሞትን ባይኤን ዮሙ እን አልኣዛርን አዋለ ኬሳ ዋሜ ዱኣ ካሴት እሰ ወጅን ቱረንስ እቱመ ፉፈኒ ዹጋ በአን። <verse eid="JHN 12:17"/><verse number="18" style="v" sid="JHN 12:18"/>ነሞትን ባይኤንስ ሰበቢ መለቶ ከነ ጎቹሳ ዸገአኒፍ እሰ ስመቹ በአን። <verse eid="JHN 12:18"/><verse number="19" style="v" sid="JHN 12:19"/>ከናፉ ፈሪሶትን፣ “እስን አከ ዋ ቶኮሌ ጎቹ ህንደንዴኜ አርግተኒ? እላ፣ አዱኛን ጉቱን አከምት አከ እሰ ዱካ ቡኤ እላላ!” ወሊን ጄዸን።<verse eid="JHN 12:19"/></para>
  <para style="s1">ዬሱስ ዱራን ዱርሴ ዋኤ ዱአሳ ዱበቴ</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20"/>ወረ ዬሮ አያንቻት ዋቄፈቹፍ ኦል በአን ኬሳ ቶኮ ቶኮ ግሪኮተ ቱረን። <verse eid="JHN 12:20"/><verse number="21" style="v" sid="JHN 12:21"/>እሳንስ ፊልጶስ ነምቸ ቤተ ሳይዳ ገሊላቲ ዹፌ ሰነት ዽኣተኒ፣ “ያ ጎፍታ፣ ዬሱስን አርጉ በርባድነ” ጄዸኒን። <verse eid="JHN 12:21"/><verse number="22" style="v" sid="JHN 12:22"/>ፊልጶስስ ዸቄ እንድሪያስት ህሜ፤ እንድሪያሲፊ ፊልጶስሞ ዸቀኒ ዬሱስት ህመን።<verse eid="JHN 12:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 12:23"/>ዬሱስሞ አከነ ጄዼ እሳኒፍ ዴብሴ፤ <char style="wj">“ሰኣቲን እልም ነማ እት ኡልፍነ አርገቱ ገኤረ።</char> <verse eid="JHN 12:23"/><verse number="24" style="v" sid="JHN 12:24"/><char style="wj">አን ዹጉመን፣ ዹጉመን እስንት ህመ፤ እጅ ቀመዲ ቶኮ ዮ ለፈ ቡኤ ዱኡ ባቴ ኮጳሳ ሀፈ። ዮ ዱኤ ገሩ እጀ ባይኤ ነቀተ።</char> <verse eid="JHN 12:24"/><verse number="25" style="v" sid="JHN 12:25"/><char style="wj">ነምን ሉቡሳ ጃለቱ ከምዩ ሉቡሳ ንዸበ፤ ከን አዱኛ ከነረት ሉቡሳ ጅቡሞ ጅሬኘ በረ በራቲፍ ሉቡሳ ኬወተ።</char> <verse eid="JHN 12:25"/><verse number="26" style="v" sid="JHN 12:26"/><char style="wj">ነምን ነ ተጃጅሉ ከምዩ ነ ፋነ ሃቡኡ፤ እዶ አን ጅሩ ተጃጅላንኮስ ንጅራተ። አባንኮ ነመ ነ ተጃጅሉ ከሚፍዩ ኡልፍነ ንኬነ።</char><verse eid="JHN 12:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27"/>
    <char style="wj">“አመ ሉቡንኮ ዽጰቴርት፤ ኤጋ አን ማል ጄዹሬ? ‘ያ አባ፣ ሰኣቲ ከነ ጀላ ነ ባስ፤’ ገሩ አን ሰበቢ ከናፈን ገረ ሰኣቲ ከና ዹፌ።</char> <verse eid="JHN 12:27"/><verse number="28" style="v" sid="JHN 12:28"/><char style="wj">ያ አባ፣ መቃኬ ኡልፌስ!”</char></para>
  <para style="p" vid="JHN 12:28">ኤርገሲ ሰገሌን፣ “አን እሰ ኡልፌሴረ፤ አመስ ነንኡልፌሰ” ጄዹ ቶኮ ሰሚዻ ዹፌ። <verse eid="JHN 12:28"/><verse number="29" style="v" sid="JHN 12:29"/>ቱትን አች ዻበቻ ቱሬ ዮሙ ሰገሌ ከነ ዸገኤት፣ “ንከከውሴ” ጄዼ። ወር ካንሞ፣ “ኤርገማ ዋቀዮቱ እሰት ዱበቴ” ጄዸን።<verse eid="JHN 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30"/>ዬሱስ አከነ ጄዼ ዴብሴ፤ <char style="wj">“ሰገሌን ኩን ሰበቢኬሰኒፍ ዹፌ መሌ ሰበቢኮቲፊ ምት።</char> <verse eid="JHN 12:30"/><verse number="31" style="v" sid="JHN 12:31"/><char style="wj">ዬሮን እት አዱኛ ከነት ሙረሙ አመ፤ ቡልቻን አዱኛ ከናስ አመ ገድ ገተመ።</char> <verse eid="JHN 12:31"/><verse number="32" style="v" sid="JHN 12:32"/><char style="wj">አን ገሩ ዬሮን ለፈራ ኦል ፉዸሙት ነመ ሁንደ ኦፍት ነንሀርክሰ።”</char> <verse eid="JHN 12:32"/><verse number="33" style="v" sid="JHN 12:33"/>እንስ አከ ዱአ አከሚ ዱኡፍ ጅሩ አርግሲሱፍ ከነ ጄዼ።<verse eid="JHN 12:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34"/>ቱትንስ ዴብሴ፣ “አከ ክርስቶስ በረ በራን ጅራቱ ኑ ሴረራ ዸጌኜረ፤ ዮስ አት አከምት፣ <char style="wj">‘እልም ነማ ኦል ፉዸሙ ቀበ’</char> ጄተ? ‘እልም ነማ’ ኩንስ ኤኙ?” ጄዼን።<verse eid="JHN 12:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35"/>ዬሱስሞ አከነ ጄዼን፤ <char style="wj">“እፍን ዬሮ ገባባዻፍ እስን ብረ ጅረ። አከ ዱከን እስን ህንልቅምስኔፍ ኡቱ እፈ ቀብደኑ ዴዴብኣ። ነምን ዱከነ ኬሰ ዴዴብኡ ኤሰ አከ ዸቁ ህንቤኩቲ።</char> <verse eid="JHN 12:35"/><verse number="36" style="v" sid="JHN 12:36"/><char style="wj">እጆሌ እፋ አከ ታተኒፍ ኡቱ እፈ ቀብደኑ እፈ ሰነት አመና።”</char> ዬሱስስ ኤርገ ዋን ከነ ዱበቴ ፍጤን ቦዴ እዶ ሰና ከኤ እሳን ዱራ ዾከቴ።<verse eid="JHN 12:36"/></para>
  <para style="s1">አመንቲ ዸቡ ይሁዶታ</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37"/>ዬሱስ ፉለሳኒ ዱረት መለቶ ሄዱ ሆጄቱዩ፣ እሳን እሰት ህንአመኔ። <verse eid="JHN 12:37"/><verse number="38" style="v" sid="JHN 12:38"/>ኩንስ ዱቢን እሳያስ ራጅቻ ከን፦</para>
  <para style="q1" vid="JHN 12:38">“ያ ጎፍታ፣ ኤርጋኬኘ ኤኙቱ አመኔ?</para>
  <para style="q2" vid="JHN 12:38">እሬን ጎፍታስ ኤኙት ሙልአቴ?”<note caller="+" style="f"><char style="fr" closed="false">12፥38 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 53:1">እሳ 53፥1</ref></char></char></note></para>
  <para style="m" vid="JHN 12:38">ጄዹ ሱን አከ ራወተሙፍ ቱሬ።<verse eid="JHN 12:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39"/>ሰበቢ ከናፍ እሳን አመኑ ህንደንዴኜ፤ እሳያስ እዶ ብራት አከነ ጄዼራቲ፤<verse eid="JHN 12:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40"/>“እጀሳኒቲን አከ ህንአርግኔፍ፣</para>
  <para style="q2" vid="JHN 12:40">ቀልቢሳኒቲን አከ ህንሁበትኔፍ፣</para>
  <para style="q1" vid="JHN 12:40">አከ አን እሳን ፈይሱፍስ አከ ገረኮት ህንዴብኔፍ፣</para>
  <para style="q2" vid="JHN 12:40">እን እጀሳኒ ጃምሴራቲ፤</para>
  <para style="q2" vid="JHN 12:40">ገራሳኒስ ጀቤሴረ።”<note caller="+" style="f"><char style="fr" closed="false">12፥40 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 6:10">እሳ 6፥10</ref></char></char></note><verse eid="JHN 12:40"/></para>
  <para style="m">
    <verse number="41" style="v" sid="JHN 12:41"/>እሳያስ ሰበቢ ኡልፍነሳ አርጌ ዋኤሳስ ዱበቴፍ ዋን ከነ ጄዼ።<verse eid="JHN 12:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 12:42"/>ተኡስ ሆገንቶተ ኬሳዩ ነሞትን ባይኤን እሰት አመነን። ገሩ ዋን መነ ሰገዳቲ ኑ ባሱ ጄዸኒ ፈሪሶተ ሶዳተኒፍ አመንቲሳኒ እፈት ህንባፍኔ፤ <verse eid="JHN 12:42"/><verse number="43" style="v" sid="JHN 12:43"/>እሳን ኡልፍነ ዋቃረ ኡልፍነ ነማ ጃለተኒሩቲ።<verse eid="JHN 12:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44"/>ዬሱስስ እዬ አከነ ጄዼ፤ <char style="wj">“ነምን ነት አመኑ እሰ ነ ኤርጌ ሰነት አመነ መሌ ነት ምት።</char> <verse eid="JHN 12:44"/><verse number="45" style="v" sid="JHN 12:45"/><char style="wj">ከን ነ አርጉስ እሰ ነ ኤርጌ ሰነ አርገ።</char> <verse eid="JHN 12:45"/><verse number="46" style="v" sid="JHN 12:46"/><char style="wj">አከ ነምን ነት አመኑ ሁንድኑ ዱከነ ኬሰ ህንጅራትኔፍ አን እፈ ተኤ ገረ አዱኛ ዹፌረ።</char><verse eid="JHN 12:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 12:47"/>
    <char style="wj">“ነምን ዮ ዱቢኮ ዸገኤ ኤጉ ባቴ ከን እሰት ሙሩ አና ምት፤ አን አዱኛ ፈይሱፍን ዹፌ መሌ እት ሙሩፍ ህንዹፍኔቲ።</char> <verse eid="JHN 12:47"/><verse number="48" style="v" sid="JHN 12:48"/><char style="wj">ነምን ነ ድዱ ከን ዱቢኮስ ህንፉዸትኔ አባ ሙርቲ ቶኮ ቀበ፤ ዱቢን አን ዱበዼ ሱን ጉያ ዹማት እሰት ሙረ።</char> <verse eid="JHN 12:48"/><verse number="49" style="v" sid="JHN 12:49"/><char style="wj">ገሩ አባ እሱመ ነ ኤርጌ ሰነቱ አከ አን ዋነን ዱበዼ ሰነ ጄዹ ነ አጀጄ መሌ አን ኦፊኮቲን ህንዱበትኔ።</char> <verse eid="JHN 12:49"/><verse number="50" style="v" sid="JHN 12:50"/><char style="wj">አከ አጀጅንሳ ጅሬኘ በረ በራ ተኤ ነንቤከ። ከናፉ ወን አን ዱበዹ ከምዩ ዋን አከ አን ዱበዹፍ አባን ነት ህሜዸ።”</char><verse eid="JHN 12:50"/></para>
  <chapter eid="JHN 12"/>
  <chapter number="13" style="c" sid="JHN 13"/>
  <para style="s1">ዬሱስ ሚለ በረቶተሳ ዽቄ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1"/>ዬሮን ሱን አያነ ፋሲካቲን ዱረ ቱሬ። ዬሱስስ አከ አዱኛ ከነ ኬሳ ገረ አባ ዸቁዻፍ ሰኣቲንሳ ገኤ ንቤኬ። እንስ ወረ ከንሳ ተአን ከኔን አዱኛ ኬሰ ቱረን ንጃለቴ፤ ሀመ ዹማትስ እሳን ጃለቴ።<verse eid="JHN 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2"/>ዬሮ እርባታት ዲያብሎስ አከ እን ዬሱስን ደበርሴ ኬኑፍ ይሁዳ አስቆሮትቸ እልመ ስሞን ኬሰ ዱራን ዱርሴ ያደ ካኤ። <verse eid="JHN 13:2"/><verse number="3" style="v" sid="JHN 13:3"/>ዬሱስስ አከ አባን ዋን ሁንደ ሀርከሳት ኬኔ፣ አከ ዋቀ ብራ ዹፌፊ አከ ገረ ዋቃት ዴብኡሌ ቤከ ቱሬ፤ <verse eid="JHN 13:3"/><verse number="4" style="v" sid="JHN 13:4"/>ከናፍ እርባተራ ከኤ፣ ወያሳ ከን እራን ኡፈቴ ኦፍራ ፉዼ ለፈ ካኤ፤ ፎጣስ ሙዺት ህዸቴ። <verse eid="JHN 13:4"/><verse number="5" style="v" sid="JHN 13:5"/>ኤርገሲ ገበቴት ብሻን ነቀቴ ሚለ በረቶታ ዽቁፊ ፎጣ ሙዺት ህዸቴ ሰናንስ ሀቁ ጀልቀቤ።<verse eid="JHN 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 13:6"/>እን ገረ ስሞን ጴጥሮስ ዹፌ፤ ጴጥሮስስ፣ “ያ ጎፍታ፣ ስቱ ሚለኮ ናፍ ዽቃ?” ጄዼን።<verse eid="JHN 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7"/>ዬሱስሞ ዴብሴ፣ <char style="wj">“ዋን አን ሆጄቻ ጅሩ አት አመ ህንቤክቱ፤ ቦዴ ገሩ ንሁበተ”</char> ጄዼን።<verse eid="JHN 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8"/>ጴጥሮስስ፣ “ህንተኡ፤ አት ጎንኩማ ሚለኮ ናፍ ህንዽቅጡ” ጄዼን።</para>
  <para style="p" vid="JHN 13:8">ዬሱስስ ዴብሴ፣ <char style="wj">“ዮ አን ሲፍ ዽቁ ባዼ አት ነ ብራ ቆደ ህንቀባቱ”</char> ጄዼን።<verse eid="JHN 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9"/>ስሞን ጴጥሮስስ ዴብሴ፣ “ያ ጎፍታ፣ ዮስ ሀርከኮፊ መታኮስ መሌ ሚለኮ ቆፈ ህንተእን” ጄዼን።<verse eid="JHN 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10"/>ዬሱስስ፣ <char style="wj">“ነምን ዸግነሳ ዽቀቴ ቶኮ ሚለሳ ቆፈ ዽቀቹ እሰ በርባችሰ፤ ዸግንሳ ጉቱን ቁልቁሉዸ። እስን ቁልቁሉዸ፤ ገሩ ሁንደኬሰን ምት”</char> ጄዼን። <verse eid="JHN 13:10"/><verse number="11" style="v" sid="JHN 13:11"/>እንስ ነመ ደበርሴ እሰ ኬኑፍ ጅሩ ቤከ ቱሬቲ፤ ሰበቢን እን፣ <char style="wj">“ቁልቁሉን ሁንደኬሰን ምት”</char> ጄዼፍስ ከኑመ።<verse eid="JHN 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12"/>እንስ ኤርገ ሚለሳኒ ዽቄ ቦዴ፣ ኡፈተሳ ኡፈቴ እዶሳት ዴብኤ ታኤ። አከነስ ጄዼን፤ <char style="wj">“እስን ዋን አን እስኒፍ ጎዼ ሁበተኒ?</char> <verse eid="JHN 13:12"/><verse number="13" style="v" sid="JHN 13:13"/><char style="wj">እስን፣ ‘በርሲሳ’፣ ‘ጎፍታስ’ ናን ጄቱ፤ አንስ ዋን እሱመ እስን ጄተን ተኤፍ እስን ዹጉመ ጄተን።</char> <verse eid="JHN 13:13"/><verse number="14" style="v" sid="JHN 13:14"/><char style="wj">ዮስ ኤርገ አን ጎፍታፊ በርሲሳንኬሰን ሚለኬሰን እስኒ ዽቄ፣ እስንስ አከሱመ ሚለ ወሊ ዽቁ ቀብዱ።</char> <verse eid="JHN 13:14"/><verse number="15" style="v" sid="JHN 13:15"/><char style="wj">አኩመ አን እስኒ ጎዼ ከነ እስንስ አከ ጎተኒፍ አን ፈኬኘ እስኒ ኬኔረ።</char> <verse eid="JHN 13:15"/><verse number="16" style="v" sid="JHN 13:16"/><char style="wj">አን ዹጉመን፣ ዹጉመን እስንት ነንህመ፤ ገርብች ጎፍታሳ ህንጫሉ፤ ኤርገማንስ ከን እሰ ኤርጌ ህንጫሉ።</char> <verse eid="JHN 13:16"/><verse number="17" style="v" sid="JHN 13:17"/><char style="wj">ኤጋ እስን ዮ ዋን ከነ ቤክተኒ ሆጂረ ኦልችተን እስን ኤብፈሞዸ።</char><verse eid="JHN 13:17"/></para>
  <para style="s1">ዬሱስ አከ ደበርፈሜ ኬነሙ ዱራን ዱርሴ ዱበቴ</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18"/>
    <char style="wj">“አን ዋኤ ሁንደኬሰኒ ዱበቻ ህንጅሩ፤ አን ወረን ፍለዼ ነንቤከ። ኩን ገሩ ዱቢን ከተቢ ቁልቁሉ ከን፣ ‘እን ቡዴነኮ ኛቴ ኮሜሳ ነት ኦል ፉዸቴ’</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">13፥18 </char>
      <char style="ft" closed="false">
        <char style="xt">
          <ref loc="PSA 41:9">ፋር 41፥9</ref>
        </char>
      </char>
    </note> <char style="wj">ጄዹ ሱን አከ ጉተሙፍ።</char><verse eid="JHN 13:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 13:19"/>
    <char style="wj">“እስን ዮሙ ወን ኩን ተኡት አከ አን እሰ ተኤ አከ አመንተኒፍ ኡቱ እን ህንተእን አመ እስንት ነንህመ።</char> <verse eid="JHN 13:19"/><verse number="20" style="v" sid="JHN 13:20"/><char style="wj">አን ዹጉመን፣ ዹጉመን እስንት ህመ፤ ከን ነመ አን ኤርጉ ከምዩ ስመቱ ሁንድኑ ነ ስመተ፤ ከን ነ ስመቱ ሁንድስ እሰ ነ ኤርጌ ሰነ ስመተ።”</char><verse eid="JHN 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21"/>ዬሱስስ ኤርገ ከነ ዱበቴ ቦዴ ሀፉራን ጄቀሜ፣ <char style="wj">“አን ዹጉመን፣ ዹጉመን እስንት ህመ፤ እስን ኬሳ ቶኮ ደበርሴ ነ ኬነ”</char> ጄዼ ዹጋ በኤ።<verse eid="JHN 13:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22"/>በረቶትን አከ እን ዋኤ ኤኙ ዱበቴ ወላለኒ ወል እላለን። <verse eid="JHN 13:22"/><verse number="23" style="v" sid="JHN 13:23"/>በረቶተ ኬሳስ እን ዬሱስ እሰ ጃለቱ ቶኮ ዬሱስት እርከቴ ማዲት ዽኣቴ ቱሬ። <verse eid="JHN 13:23"/><verse number="24" style="v" sid="JHN 13:24"/>ስሞን ጴጥሮስስ፣ “ሜ ኤኙ ጄቹሳ አከ ተኤ እሰ ጋፈዹ!” ጄዼ ኛራን በረታ ሰነት ህሜ።<verse eid="JHN 13:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25"/>እንስ ቆመ ዬሱስት ህርከቴ፣ “ያ ጎፍታ፣ ኤኙ እኒ?” ጄዼ ጋፈቴ።<verse eid="JHN 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 13:26"/>ዬሱስስ ዴብሴ፣ <char style="wj">“ነምች አን ቡዴነ አፋን ካአተ ቶኮ ጫቢ ኬሰ ጩጴ ኬኑፍ እሰ”</char> ጄዼ። እንስ ቡዴነ ጫቢ ኬሰ ጩጴ ይሁዳ እልመ ስሞን አስቆሮትቻቲፍ ኬኔ። <verse eid="JHN 13:26"/><verse number="27" style="v" sid="JHN 13:27"/>ይሁዳስ አኩመ እን ቡዴንቸ ፉዸቴን ሴጠን እት ገሌ።</para>
  <para style="p" vid="JHN 13:27">ዬሱስስ፣ <char style="wj">“ዋን ጎቹፍ ጅርቱ ደፊ ጎዽ”</char> እሳን ጄዼ። <verse eid="JHN 13:27"/><verse number="28" style="v" sid="JHN 13:28"/>ወረ ኛታፍ ተታአን ኬሳስ ነምን ቶኮዩ ዋን እን አከስ እሳን ጄዼፍ ህንሁበትኔ። <verse eid="JHN 13:28"/><verse number="29" style="v" sid="JHN 13:29"/>ሰበቢ ይሁዳን ኮሮጆ ማለቃ ባቻ ቱሬፍስ እሳን ኬሳ ነሞትን ቶኮ ቶኮ ዋን ዬሱስ፣ አከ እን ዋን አያናፍ በርባችሱ ብቱ ዮካን አከ እን ህዬዪፍ ዋ ኬኑ እሰት ህሜ ሴአን። <verse eid="JHN 13:29"/><verse number="30" style="v" sid="JHN 13:30"/>ይሁዳንስ አኩመ ቡዴነ ሰነ ፉዸቴን ገድ በኤ። ዬሮን ሱንስ ሀልከን ቱሬ።<verse eid="JHN 13:30"/></para>
  <para style="s1">ዬሱስ አከ ጴጥሮስ እሰ ገኑ ዱራን ዱርሴ ዱበቴ</para>
  <para style="r">
    <ref loc="JHN 13:37-38">13፥37‑38</ref> ኩወፈ – <char style="xt"><ref loc="MAT 26:33-35">ማቴ 26፥33‑35</ref>፤ <ref loc="MRK 14:29-31">ማር 14፥29‑31</ref>፤ <ref loc="LUK 22:33-34">ሉቃ 22፥33‑34</ref></char></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31"/>ኤርገ ይሁዳን ገድ በኤ ቦዴ ዬሱስ አከነ ጄዼ፤ <char style="wj">“አመ እልም ነማ ኡልፋቴረ፤ ዋቅንስ እሳን ኡልፍነ አርገቴረ።</char> <verse eid="JHN 13:31"/><verse number="32" style="v" sid="JHN 13:32"/><char style="wj">ዋቅን ኤርገ እሳን ኡልፍነ አርገቴ፣ ዋቅን ኦፉመሳቲን እልመ ኡልፌሰ፤ እን ተኩማን እሰ ኡልፌሰ።</char><verse eid="JHN 13:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 13:33"/>
    <char style="wj">“ያ እጆሌ፣ አን ዬሮ ገባባዻፍ እስን ወጅነን ጅረ። እስን ነ በርባዱ፤ አን አኩመ ይሁዶታን፣ ‘እዶ አን ዸቁ እስን ዹፉ ህንደንዴሰን’ ጄዼ ሰነ አመስ እስኒን ነንጄዸ።</char><verse eid="JHN 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 13:34"/>
    <char style="wj">“አከ እስን ወል ጃለተኒፍ አን አጀጀ ሃራ እስኒፍን ኬነ። አኩመ አን እስን ጃለዼት እስንስ አከሱመ ወል ጃለዻ።</char> <verse eid="JHN 13:34"/><verse number="35" style="v" sid="JHN 13:35"/><char style="wj">ዮ እስን ጃለለ ወሊፍ ቀባተን ነሞትን ሁንድኑ አከ እስን በረቶተኮ ታተን ከናን ንቤኩ።”</char><verse eid="JHN 13:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36"/>ስሞን ጴጥሮስስ፣ “ያ ጎፍታ፣ ኤሰ ዸቅጠ?” ጄዼ እሰ ጋፈቴ።</para>
  <para style="p" vid="JHN 13:36">ዬሱስስ፣ <char style="wj">“አት አመ እዶ አን ዸቁ ነ ፋነ ዸቁ ህንደንዴሱ፤ ቦዴ ገሩ ነ ዱካ ቡተ”</char> ጄዼ ዴብሴፍ።<verse eid="JHN 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37"/>ጴጥሮስስ፣ “ያ ጎፍታ፣ አን ማሊፈን አመ ስ ዱካ ቡኡ ህንደንዴኜ? አን ሲፍ ጄዼ ሉቡኮ ነንኬነ” ጄዼን።<verse eid="JHN 13:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38"/>ዬሱስስ ዴብሴ፣ <char style="wj">“አት ዹጉመ ናፍ ጄቴ ሉቡኬ ንኬንታ? አን ዹጉመ፣ ዹጉመ ስት ነንህመ፤ አት ኡቱ እንዳንቆን ህንእይን ዬሮ ሰዲ ነ ገንተ”</char> ጄዼን።<verse eid="JHN 13:38"/></para>
  <chapter eid="JHN 13"/>
  <chapter number="14" style="c" sid="JHN 14"/>
  <para style="s1">ዬሱስ በረቶተሳ ጀጀቤሴ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1"/>
    <char style="wj">“ገራንኬሰን ህንራፈምን። ዋቀት አመና፤ ነትስ አመና።</char> <verse eid="JHN 14:1"/><verse number="2" style="v" sid="JHN 14:2"/><char style="wj">መነ አባኮ ኬሰ እዶ ጅሬኛ ባይኤቱ ጅረ፤ ኡቱ አከነ ተኡ ባቴ ስላ እስንትን ህመ ቱሬ። አን እዶ እስኒ ቆጴሱፍ አችን ዸቃቲ።</char> <verse eid="JHN 14:2"/><verse number="3" style="v" sid="JHN 14:3"/><char style="wj">አንስ ዮን ዸቄ እዶ እስኒ ቆጴሴ፣ አከ እስንስ እዶ አን ጅሩ ጅራተኒፍ ዴብኤ ዹፌን ኦፍት እስን ፉዸዸ።</char> <verse eid="JHN 14:3"/><verse number="4" style="v" sid="JHN 14:4"/><char style="wj">እስንስ ከራ እዶ አን ዸቁ ንቤክቱ።”</char><verse eid="JHN 14:4"/></para>
  <para style="s1">ዬሱስ ከራ ገረ አባት ጌሱ ተኡሳ</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5"/>ቶማስስ፣ “ያ ጎፍታ፣ አት ኤሰ አከ ዸቅጡ ኑ ህንቤክኑ፤ ዮስ አከምት ከራ ሰነ ቤኩ ደንዴኘሬ?” ጄዼን።<verse eid="JHN 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6"/>ዬሱስስ አከነ ጄዼ ዴብሴፍ፤ <char style="wj">“ከራፊ ዹጋን፣ ጅሬኝስ አኑመ። ዮ አናን ተኤ መሌ ኤኙዩ ገረ አባ ህንዹፉ።</char> <verse eid="JHN 14:6"/><verse number="7" style="v" sid="JHN 14:7"/><char style="wj">ኡቱ ነ ቤክተኒ ስላ አባኮስ አከሱመ ንቤክቱ ቱርተን፤ አማ ጀልቀብደኒስ እሰ ቤክቱ፤ እሰስ አርግተኒርቱ።”</char><verse eid="JHN 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8"/>ፊልጶስ፣ “ያ ጎፍታ፣ አባ ኑት አርግሲስ፤ ኩን ኑ ገኣቲ” ጄዼን።<verse eid="JHN 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9"/>ዬሱስስ አከነ እሳን ጄዼ፤ <char style="wj">“ያ ፊልጶስ፣ አን ዬሮ ዼራ አከና እስን ወጅን ጅራዼ፣ አት አመሌ ነ ህንቤክኔ? ነምን ነ አርጌ አባስ አርጌረ። ዮስ አት አከምት፣ ‘አባ ኑት አርግሲስ’ ጄቹ ደንዴሰሬ?</char> <verse eid="JHN 14:9"/><verse number="10" style="v" sid="JHN 14:10"/><char style="wj">አከ አን አባ ኬሰ ጅሩ፣ አባንስ አከ ነ ኬሰ ጅሩ አት ህንአመንቱ? አን ዱቢን እስንት ዱበዹ ከነ ኦፉመኮቲን ህንዱበዹ። ገሩ አባ እሰ ነ ኬሰ ጅራቱቱ ሆጂሳ ሆጄተ።</char> <verse eid="JHN 14:10"/><verse number="11" style="v" sid="JHN 14:11"/><char style="wj">አከ አን አባ ኬሰ ጅሩ፣ አባንስ አከ ነ ኬሰ ጅሩ ነ አመና፤ ዮካን ሰበቢ ሆጂ ሰናቲፍ ነ አመና።</char> <verse eid="JHN 14:11"/><verse number="12" style="v" sid="JHN 14:12"/><char style="wj">አን ዹጉመን፣ ዹጉመን እስንት ህመ፤ ነምን ነት አመኑ ሆጂ አን ሆጄዹ ንሆጄተ። አን ዋነን ገረ አባ ዸቁፍ እን ዋን ከነ ጫሉዩ ንሆጄተ።</char> <verse eid="JHN 14:12"/><verse number="13" style="v" sid="JHN 14:13"/><char style="wj">አከ አባን እልማን ኡልፍነ አርገቱፍ አን ዋን እስን መቃኮቲን ከዸተን ከምዩ ነንራወዸ።</char> <verse eid="JHN 14:13"/><verse number="14" style="v" sid="JHN 14:14"/><char style="wj">ዮ እስን መቃኮቲን ዋን ከምዩ ነ ከዸተን አን ነንራወዸ።</char><verse eid="JHN 14:14"/></para>
  <para style="s1">ዬሱስ አከ ሀፉረ ቁልቁሉ ኤርጉ አብደቺሴ</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15"/>
    <char style="wj">“እስን ዮ ነ ጃለተን አጀጀኮ ኤጋ።</char> <verse eid="JHN 14:15"/><verse number="16" style="v" sid="JHN 14:16"/><char style="wj">አን አባ ነንከዸዸ፤ እንስ አከ እን በረ በራን እስን ወጅን ጅራቱፍ ጀጀቤሳ ብራ እስኒ ኬነ፤</char> <verse eid="JHN 14:16"/><verse number="17" style="v" sid="JHN 14:17"/><char style="wj">እን ሀፉረ ዹጋት። አዱኛን ዋን እሰ ህንአርግኔፊ ዋን እሰ ህንቤክኔፍ እሰ ፉዸቹ ህንደንደኡ። እስን ገሩ ዋን እን እስን ወጅን ጅራቱፍ፣ እስን ኬሰስ ዋን ጅሩፍ እሰ ንቤክቱ።</char> <verse eid="JHN 14:17"/><verse number="18" style="v" sid="JHN 14:18"/><char style="wj">አን አከ እጆሌ ሃዻፊ አባ ህንቀብኔት እስን ህንዺሱ፤ ገረኬሰን ነንዹፈ።</char> <verse eid="JHN 14:18"/><verse number="19" style="v" sid="JHN 14:19"/><char style="wj">ዬሮ ሙራሰ ቦዴ አዱኛን ዴብኤ ነ ህንአርጉ፤ እስን ገሩ ነ አርግቱ። ሰበቢ አን ጅራዹፍ እስንስ ንጅራቱ።</char> <verse eid="JHN 14:19"/><verse number="20" style="v" sid="JHN 14:20"/><char style="wj">አከ አን አባኮ ኬሰ ጅሩ፣ አከ እስን ነ ኬሰ ጅርተን አከ አንስ እስን ኬሰ ጅሩ ጋፈስ ንቤክቱ።</char> <verse eid="JHN 14:20"/><verse number="21" style="v" sid="JHN 14:21"/><char style="wj">ነምን አጀጀወንኮ ቀቡ፣ እሳንስ ከን ኤጉ፣ እን ነ ጃለተ። ነመ ነ ጃለቱ አባንኮ ንጃለተ፤ አንስ እሰ ነንጃለዸ፤ እሰትስ ኦፍ ነንሙልእሰ።”</char><verse eid="JHN 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22"/>ይሁዳ አስቆሮትቸ ኡቱ ህንተእን ይሁዳን ካን፣ “ያ ጎፍታ፣ አት ማሊፍ አዱኛት ኡቱ ህንተእን ኑት ኦፍ ሙልእሱ በርባደ?” ጄዼን።<verse eid="JHN 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23"/>ዬሱስስ አከነ ጄዼ ዴብሴፍ፤ <char style="wj">“ነምን ነ ጃለቱ ከምዩ ዱቢኮ ንኤገ። አባንኮ እሰ ንጃለተ፤ ኑስ ገረሳ ንዹፍነ፤ እዶ ጅሬኛስ እሰ ወጅን ንጎዸትነ።</char> <verse eid="JHN 14:23"/><verse number="24" style="v" sid="JHN 14:24"/><char style="wj">ነምን ነ ህንጃለትኔ ዱቢኮ ህንኤጉ። ዱቢን እስን ዸጌሰን ኩንስ ከን አባ ነ ኤርጌ ሰናት መሌ ከንኮ ምት።</char><verse eid="JHN 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25"/>
    <char style="wj">“አን ኡቱመን እስን ወጅን ጅሩ ዋን ከነ እስንት ዱበዼረ።</char> <verse eid="JHN 14:25"/><verse number="26" style="v" sid="JHN 14:26"/><char style="wj">ጀጀቤሳን ሱን፣ ሀፉር ቁልቁሉን ከን አባን መቃኮቲን ኤርጉ ገሩ ዋን ሁንደ እስን በርሲሰ፤ ዋን አን እስንት ህሜ ሁንደስ እስን ያደቺሰ።</char> <verse eid="JHN 14:26"/><verse number="27" style="v" sid="JHN 14:27"/><char style="wj">አን ነጋ እስን ብረት ነንሀምብሰ፤ ነጋኮስ እስኒፍ ነንኬነ። አን አከ አዱኛን ኬኑት እስኒፍ ህንኬኑ። ገራንኬሰን ህንራፈምን፤ ህንሶዳትንስ።</char><verse eid="JHN 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 14:28"/>
    <char style="wj">“እስን አከ አን፣ ‘አን ነንዴመ፤ ዴብኤስ ገረኬሰን ነንዹፈ’ ጄዼ ዸጌሰኒርቱ። ኡቱ ነ ጃለተኒ ስላ ገረ አባ ዸቁኮት ንገመዱ ቱርተን፤ አባን ነ ጫላቲ።</char> <verse eid="JHN 14:28"/><verse number="29" style="v" sid="JHN 14:29"/><char style="wj">አከ ዮሙ ወን ኩን ተኡት እስን አመንተኒፍ ኡቱ ወን ሱን ህንተእን አን አመ ዱራን ዱርሴ እስንት ህሜረ።</char> <verse eid="JHN 14:29"/><verse number="30" style="v" sid="JHN 14:30"/><char style="wj">ዋን ቡልቻን አዱኛ ከና ዹፉፍ፣ አን ስአች እስን ወጅን ባይኤ ህንዱበዹ፤ እን ነራ ሆማ ህንቀቡ፤</char> <verse eid="JHN 14:30"/><verse number="31" style="v" sid="JHN 14:31"/><char style="wj">ገሩ አከ አን አባ ጃለዹ አዱኛን አከ ቤኩፍ፣ አን አኩመ አባን ነ አጀጄት ነንሆጄዸ።</char></para>
  <para style="p" vid="JHN 14:31">
    <char style="wj">“ከኣ፣ አሲ ንዴምና።</char><verse eid="JHN 14:31"/></para>
  <chapter eid="JHN 14"/>
  <chapter number="15" style="c" sid="JHN 15"/>
  <para style="s1">ሙከ ወይኒቲፊ ደሜወንሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1"/>
    <char style="wj">“አን ሙከ ወይኒ ዹጋት፤ ከን ዻቤስ አባኮት።</char> <verse eid="JHN 15:1"/><verse number="2" style="v" sid="JHN 15:2"/><char style="wj">እን ደሜኮ ከን እጀ ህንነቀትኔ ሁንደ ሙሬ ገተ፤ ደሜ እጀ ነቀቱሞ አከ ጫላት ነቀቱፍ እራ ቆረ።</char> <verse eid="JHN 15:2"/><verse number="3" style="v" sid="JHN 15:3"/><char style="wj">እስን ዱቢ አን እስንት ዱበዼን አመ ቁልቁሉዸ።</char> <verse eid="JHN 15:3"/><verse number="4" style="v" sid="JHN 15:4"/><char style="wj">ነ ኬሰ ጅራዻ፤ አንስ እስን ኬሰ ነንጅራዻ። አኩመ ደሜን ዮ ሙከ ወይኒት ጅራቴ መሌ ኦፉመሳቲን እጀ ነቀቹ ህንደንዴኜ፣ እስንስ ዮ ነ ኬሰ ጅራተን መሌ እጀ ነቀቹ ህንደንዴሰን።</char><verse eid="JHN 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5"/>
    <char style="wj">“አን ሙከ ወይኒት፤ እስንሞ ደሜወን። ነምን ዮ ነ ኬሰ ጅራቴ፣ አንስ ዮን እሰ ኬሰ ጅራዼ እን እጀ ባይኤ ነቀተ፤ እስን ነራ ገርገር ባተኒ ሆማ ጎቹ ህንደንዴሰኒቲ።</char> <verse eid="JHN 15:5"/><verse number="6" style="v" sid="JHN 15:6"/><char style="wj">ነምን ነ ኬሰ ህንጅራትኔ አከ ደሜ ገድ ገተሜ ጎጉት። ደሜወን አከና ወልት ቀበመኒ እብደት ነቀሙ፤ ንጉበሙስ።</char> <verse eid="JHN 15:6"/><verse number="7" style="v" sid="JHN 15:7"/><char style="wj">እስን ዮ ነ ኬሰ ጅራተን፣ ዱቢንኮስ ዮ እስን ኬሰ ጅራቴ፣ ዋኑመ ፌተን ከዸዻ፤ እንስ እስኒፍ ንኬነመ።</char> <verse eid="JHN 15:7"/><verse number="8" style="v" sid="JHN 15:8"/><char style="wj">እስን ዮ እጀ ባይኤ ነቀተኒፊ በረቶተኮ ታተን፣ ከናን አባንኮ ኡልፍነ አርገተ።</char><verse eid="JHN 15:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 15:9"/>
    <char style="wj">“አኩመ አባን ነ ጃለቴት አንስ አከሱመ እስን ጃለዼረ። ኤጋ ጃለለኮ ኬሰ ጅራዻ።</char> <verse eid="JHN 15:9"/><verse number="10" style="v" sid="JHN 15:10"/><char style="wj">አኩመ አን አጀጀወን አባኮ ኤጌ ጃለለሳ ኬሰ ጅራዹ፣ እስንስ ዮ አጀጀወንኮ ኤግደን ጃለለኮ ኬሰ ንጅራቱ።</char> <verse eid="JHN 15:10"/><verse number="11" style="v" sid="JHN 15:11"/><char style="wj">አከ ገመቹንኮ እስን ኬሰ ጅራቱፊ አከ ገመቹንኬሰንስ ጉቱ ተኡፍ አን ዋን ከነ እስንት ህሜረ።</char> <verse eid="JHN 15:11"/><verse number="12" style="v" sid="JHN 15:12"/><char style="wj">አጀጅንኮ እሰ ከነ፦ አኩመ አን እስን ጃለዼት እስንስ ወል ጃለዻ።</char> <verse eid="JHN 15:12"/><verse number="13" style="v" sid="JHN 15:13"/><char style="wj">ኤኙዩ ጃለለ ጉዳ ከን ነምን ሉቡሳ ደበርሴ ምቾተሳቲፍ ኬኑ ሰነረ ጫሉ ህንቀቡ።</char> <verse eid="JHN 15:13"/><verse number="14" style="v" sid="JHN 15:14"/><char style="wj">ዋን አን እስን አጀጄ ዮ ራወተን እስን ምቾተኮት።</char> <verse eid="JHN 15:14"/><verse number="15" style="v" sid="JHN 15:15"/><char style="wj">ገርብች ዋን ጎፍታንሳ ሆጄቱ ዋን ህንቤክኔፍ፣ አን ስአች ገርቦተ እስኒን ህንጄዹ። ቆደ ከና አን ምቾተ እስኒን ጄዼረ፤ አን ዋነን አባኮራ ዸገኤ ሁንዱማ እስን ቤክስሴራቲ።</char> <verse eid="JHN 15:15"/><verse number="16" style="v" sid="JHN 15:16"/><char style="wj">እስንስ አከ ዸቅጠኒ እጀ ነቀተኒፍ፣ እጅኬሰንስ አከ ጅራቱፍ አነቱ እስን ፍለቴ እስን ሙዴ መሌ እስን ነ ህንፍለትኔ። ኩንስ አከ አባን ዋን እስን መቃኮቲን ከዸተን ከምዩ እስኒ ኬኑፍ።</char> <verse eid="JHN 15:16"/><verse number="17" style="v" sid="JHN 15:17"/><char style="wj">አጀጅንኮ እሰ ከነ፦ ወል ጃለዻ።</char><verse eid="JHN 15:17"/></para>
  <para style="s1">አዱኛን በረቶተ ጅቡሳ</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18"/>
    <char style="wj">“ዮ አዱኛን እስን ጅቤ፣ አከ እን እስን ዱረ ነ ጅቤ ቤካ።</char> <verse eid="JHN 15:18"/><verse number="19" style="v" sid="JHN 15:19"/><char style="wj">ኡቱ እስን ከን አዱኛ ታተኒ ስላ አዱኛን ከን ኦፊሳ ንጃለተ ቱሬ። አመ ገሩ ዋን አን አዱኛ ኬሳ እስን ፍለዼፍ እስን ከን አዱኛ ምት። ከናፉ አዱኛን እስን ጅበ።</char> <verse eid="JHN 15:19"/><verse number="20" style="v" sid="JHN 15:20"/><char style="wj">ዱቢ አን፣ ‘ገርብች ጎፍታሳ ህንጫሉ’</char><note caller="+" style="f"><char style="fr" closed="false">15፥20 </char><char style="ft" closed="false"><char style="xt"><ref loc="JHN 13:16">ዮሀ 13፥16</ref></char></char></note> <char style="wj">ጄዼ እስንት ህሜ ሰነ ያደዻ። እሳን ኤርገ ነ አርአተኒ፣ እስንስ ንአርአቱ። ዮ ዱቢኮቲፍ አጀጀመን፣ ዱቢኬሰኒፍስ ንአጀጀሙ።</char> <verse eid="JHN 15:20"/><verse number="21" style="v" sid="JHN 15:21"/><char style="wj">እሳን ዋን እሰ ነ ኤርጌ ሰነ ህንቤክኔፍ፣ ሰበቢ መቃኮቲቲፍ ዋን ከነ ሁንደ እስንረት ራወቱ።</char> <verse eid="JHN 15:21"/><verse number="22" style="v" sid="JHN 15:22"/><char style="wj">ኡቱ አን ዹፌ እሳንት ህሙ ባዼ ስላ ጩቡ እሳንት ህንተኡ ቱሬ። አመ ገሩ ጩቡሳኒቲፍ ሰበቢ ዽኤፈተን ህንቀበን።</char> <verse eid="JHN 15:22"/><verse number="23" style="v" sid="JHN 15:23"/><char style="wj">ነምን ነ ጅቡ አባኮስ ንጅበ።</char> <verse eid="JHN 15:23"/><verse number="24" style="v" sid="JHN 15:24"/><char style="wj">ኡቱ አን ሆጂ ነምን ብራ ቶኮዩ ህንሆጄትን ግዱሳኒት ሆጄቹ ባዼ ስላ ጩቡ እሳንት ህንተኡ ቱሬ። አመ ገሩ ኡቱመ ዋን አን ሆጄዼ አርገኑ አነስ አባኮስ ጅበኒሩ።</char> <verse eid="JHN 15:24"/><verse number="25" style="v" sid="JHN 15:25"/><char style="wj">ኩንስ አከ ዱቢን ሴረሳኒ ኬሰት፣ ‘እሳን አከሱማን ነ ጅበን’</char><note caller="+" style="f"><char style="fr" closed="false">15፥25 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 35:19">ፋር 35፥19</ref>፤ <ref loc="PSA 69:4">69፥4</ref></char></char></note> <char style="wj">ጄዸሜ በሬፈሜ ሱን ራወተሙፍ ተኤ።</char><verse eid="JHN 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26"/>
    <char style="wj">“ጀጀቤሳን አን አባ ብራ እስኒ ኤርጉ፣ ጄቹንስ ሀፉር ዹጋ እን አባ ኬሳ በኡ ሱን ዮሙ ዹፉት ዋኤኮ ዹጋ በአ።</char> <verse eid="JHN 15:26"/><verse number="27" style="v" sid="JHN 15:27"/><char style="wj">እስንስ ጀልቀባ ካፍተኒ ዋን ነ ወጅን ቱርተኒፍ ዹጋ ባቱ።</char><verse eid="JHN 15:27"/></para>
  <chapter eid="JHN 15"/>
  <chapter number="16" style="c" sid="JHN 16"/>
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1"/>
    <char style="wj">“አን አከ እስን ህንጉፈትኔፍ ጄዼ ወንቶተ ከኔን እስንት ህሜረ።</char> <verse eid="JHN 16:1"/><verse number="2" style="v" sid="JHN 16:2"/><char style="wj">እሳን መነ ሰገዳ ኬሳ እስን አርኡ፤ ዹጉማን ዬሮን እት ነምን እስን አጄሱ ከምዩ አከ ዋን ዋቀ ተጃጅሉት ያዱ ቶኮ ንዹፈ።</char> <verse eid="JHN 16:2"/><verse number="3" style="v" sid="JHN 16:3"/><char style="wj">እሳንስ ዋን አባ ዮካን ነ ህንቤክኒፍ ወንቶተ ከኔን ጎዹ።</char> <verse eid="JHN 16:3"/><verse number="4" style="v" sid="JHN 16:4"/><char style="wj">አንስ አከ እስን ዮሙ ዬሮን ሱን ገኡት እሳን ያደተኒፍ ወንቶተ ከኔን እስንት ህሜረ። አን ዋነን እስን ወጅን ቱሬፍ ጀልቀበት ወንቶተ ከኔን እስንት ህንህምኔ።</char><verse eid="JHN 16:4"/></para>
  <para style="s1">ሆጂ ሀፉረ ቁልቁሉ</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5"/>
    <char style="wj">“አመ ገሩ አን ገረ እሰ ነ ኤርጌ ነንዸቀ፤ ተኡስ እስን ኬሳ ነምን፣ ‘አት ኤሰ ዸቅጠ?’ ጄዼ ነ ጋፈቱ ቶኮዩ ህንጅሩ።</char> <verse eid="JHN 16:5"/><verse number="6" style="v" sid="JHN 16:6"/><char style="wj">ገሩ ዋን አን ወንቶተ ከኔን እስንት ህሜፍ ገራንኬሰን ገዳን ጉተሜረ።</char> <verse eid="JHN 16:6"/><verse number="7" style="v" sid="JHN 16:7"/><char style="wj">አን ገሩ ዹጉመን እስንት ህመ፤ ዴሙንኮ ቡኣ እስኒፍ ቀበ፤ ዮ አን ዴሜ መሌ ጀጀቤሳን ሱን ገረኬሰን ህንዹፉ፤ አን ዮን ዴሜ ገሩ እሰ እስኒፍ ነንኤርገ።</char> <verse eid="JHN 16:7"/><verse number="8" style="v" sid="JHN 16:8"/><char style="wj">እንስ ዮሙ ዹፉት አከ አዱኛን ዋኤ ጩቡ፣ ዋኤ ቀጄሉማቲፊ ዋኤ ሙርቲ ዶጎጎሬ ጅሩ ምርከኔሰ፤</char> <verse eid="JHN 16:8"/><verse number="9" style="v" sid="JHN 16:9"/><char style="wj">ዋኤ ጩቡ፣ ሰበቢ ነሞትን ነት ህንአመኔፍ፤</char> <verse eid="JHN 16:9"/><verse number="10" style="v" sid="JHN 16:10"/><char style="wj">ዋኤ ቀጄሉማ፣ ሰበቢ አን ገረ አባ ዸቁፊ ሰበቢ እስንስ ስአች ነ ህንአርግኔፍ፤</char> <verse eid="JHN 16:10"/><verse number="11" style="v" sid="JHN 16:11"/><char style="wj">ዋኤ ሙርቲሞ ሰበቢ ቡልቻ አዱኛ ከናት ሙረሜፍ።</char><verse eid="JHN 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12"/>
    <char style="wj">“አን አመዩ ዋነን እስንት ህሙ ባይኤ ቀበ፤ እስን ገሩ አመ ባቹ ህንደንዴሰን።</char> <verse eid="JHN 16:12"/><verse number="13" style="v" sid="JHN 16:13"/><char style="wj">ሀፉር ዹጋ ሱን ዮሙ ዹፉት ገረ ዹጋ ሁንዳት እስን ጌሰ። እን ዋን ዸገኡ ቆፈ ዱበተ መሌ ኦፉመሳቲን ህንዱበቱ፤ ዋን ዹፉፍ ጅሩስ እስንት ህመ።</char> <verse eid="JHN 16:13"/><verse number="14" style="v" sid="JHN 16:14"/><char style="wj">እን ሰበቢ ዋኑመኮ ፉዼ እስንት ቤክስሱፍ ኡልፍነ ናፍ ኬነ።</char> <verse eid="JHN 16:14"/><verse number="15" style="v" sid="JHN 16:15"/><char style="wj">ወን አባን ቀቡ ሁንድኑ ከንኮት። እን ዋኑመኮ ፉዼ እስንት ቤክስሰ ጄቹንኮስ ከኑማፍ።</char><verse eid="JHN 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16"/>
    <char style="wj">“እስን ዬሮ ሙራሰ ቦዴ ነ ህንአርግተን፤ ዬሮ ሙራሰ ቦዴሞ ዴብተኒ ነ አርግቱ።”</char><verse eid="JHN 16:16"/></para>
  <para style="s1">ገድ በረቶታ ገመቹት ንጌደረመ</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17"/>በረቶተሳ ኬሳስ ቶኮ ቶኮ፣ “እን፣ <char style="wj">‘እስን ዬሮ ሙራሳፍ ነ ህንአርግተን፤ ዬሮ ሙራሳፍሞ ዴብተኒ ነ አርግቱ’</char> አከኑመስ <char style="wj">‘አን ዋነን ገረ አባ ዸቁፍ’</char> ኑን ጄቹንሳ ማል ጄቹሳት?” ወሊን ጄዸን። <verse eid="JHN 16:17"/><verse number="18" style="v" sid="JHN 16:18"/>እሳንስ፣ “ <char style="wj">‘ዬሮ ሙራሳፍ’</char> ጄቹንሳ ማል ጄቹሳት? ማል ጄቹሳ አከ ተኤ ኑ ህንቤክኑ” ጄዸን።<verse eid="JHN 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19"/>ዬሱስሞ አከ እሳን እሰ ጋፈቹ በርባደን ቤኬ አከነ ጄዼን፤ <char style="wj">“ወን አን፣ ‘እስን ዬሮ ሙራሳፍ ነ ህንአርግተን፤ ዬሮ ሙራሳፍሞ ዴብተኒ ነ አርግቱ’ ጄዼ ሱን ማል ጄቹኮ አከ ተኤ ወል ጋፈቻ ጅርቱ?</char> <verse eid="JHN 16:19"/><verse number="20" style="v" sid="JHN 16:20"/><char style="wj">አን ዹጉመን፣ ዹጉመን እስንት ህመ፤ እስን ንቦሱ፤ ንገድቱስ። አዱኛን ገሩ ንገመደ። እስን ንገድቱ፤ ገድኬሰን ገሩ ገመቹት ንጌደረመ።</char> <verse eid="JHN 16:20"/><verse number="21" style="v" sid="JHN 16:21"/><char style="wj">ዱበርቲን ዮሙ ጭኒንስፈቱ፣ ዋን ዬሮንሼ ገኤፍ ንገድት፤ ኤርገ ዳእመ ዴሴ ቦዴ ገሩ ዋን አዱኛረት ነምን ዸለቴፍ፣ እሼንስ ዋን ገመዱፍ ዽጵነ ሰነ ህንያደቱ።</char> <verse eid="JHN 16:21"/><verse number="22" style="v" sid="JHN 16:22"/><char style="wj">እስንስ አከሱመ አመ ገድተኒርቱ፤ አን ገሩ ዴብኤን እስን እላለ፤ ገራንኬሰንስ ንገመደ። ገመቹኬሰንስ ኤኙዩ እስንራ ህንፉዸቱ።</char> <verse eid="JHN 16:22"/><verse number="23" style="v" sid="JHN 16:23"/><char style="wj">ጋፈስ እስን ሆማ ነ ህንከዸተን። አን ዹጉመን፣ ዹጉመን እስንት ህመ፤ አባን ዋን እስን መቃኮቲን ከዸተን ከምዩ እስኒ ኬነ።</char> <verse eid="JHN 16:23"/><verse number="24" style="v" sid="JHN 16:24"/><char style="wj">እስን ሀመ አማት መቃኮቲን ሆማ ህንከዸትኔ። አከ ገመቹንኬሰን ጉቱ ተኡፍ ከዸዻ ንአርገቱ።</char><verse eid="JHN 16:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25"/>
    <char style="wj">“አን ወንቶተ ከኔን ፈኬኛን እስንት ህሜረ፤ ገሩ ዬሮን አን ዴብኤ ፈኬኛን እስንት ህንዱበትኔ ንዹፈ፤ ዮሙስ አን ዋኤ አባኮ እፋን እፈት እስንትን ህመ።</char> <verse eid="JHN 16:25"/><verse number="26" style="v" sid="JHN 16:26"/><char style="wj">እስን ጋፈስ መቃኮቲን ንከዸቱ። አን አባ እስኒፍ ነንከዸዸ እስኒን ህንጄዹ።</char> <verse eid="JHN 16:26"/><verse number="27" style="v" sid="JHN 16:27"/><char style="wj">እስን ዋን ነ ጃለተኒፍ፣ ዋቀ ብራ በኡኮ ዋን አመንተኒፍ አባን መታንሳ እስን ጃለተ።</char> <verse eid="JHN 16:27"/><verse number="28" style="v" sid="JHN 16:28"/><char style="wj">አን አባ ብራ በኤ ገረ አዱኛ ዹፌረ፤ አመስ አዱኛ ዺሴ ገረ አባ ነንዸቀ።”</char><verse eid="JHN 16:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29"/>በረቶትንሳስ አከነ ጄዸን፤ “ኩኖ፣ አት አመዩ ፈኬኛን ኡቱ ህንተእን እፋን እፈት ዱበቻ ጅርተ። <verse eid="JHN 16:29"/><verse number="30" style="v" sid="JHN 16:30"/>አከ አት ዋን ሁንደ ቤክቱፊ አከ ነምን ቶኮዩ ጋፊ ስ ጋፈቹ ህንበርባችፍኔ ኑ አመ ንቤክነ። ከናንስ ኑ አከ አት ዋቀ ብራ ባቴ ንአመነ።”<verse eid="JHN 16:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31"/>ዬሱስስ ዴብሴ አከነ ጄዼን፤ <char style="wj">“እስን አመ ንአመንቱ?</char> <verse eid="JHN 16:31"/><verse number="32" style="v" sid="JHN 16:32"/><char style="wj">ኩኖ ዬሮን እስን እት ኮጳት ነ ዺፍተኒ ቶኮን ቶኮንኬሰን ገረ ፌተንት ብትኖፍተን ቶኮ ንዹፈ። አሙመዩ ዹፌረ። ገሩ ዋን አባንኮ ነ ወጅን ጅሩፍ አን ኮጳኮ ምት።</char><verse eid="JHN 16:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 16:33"/>
    <char style="wj">“አከ እስን አናን ነጋ ቀባተኒፍ አን ወንቶተ ከኔን እስንት ህሜረ። አዱኛ ከነረት ረክን እስን አርገተ። ገሩ ጀባዻ! አን አዱኛ ሞአዼራ።”</char><verse eid="JHN 16:33"/></para>
  <chapter eid="JHN 16"/>
  <chapter number="17" style="c" sid="JHN 17"/>
  <para style="s1">ዬሱስ ኦፊፍ ከዸቹሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1"/>ዬሱስ ወንቶተ ከኔን ዱበቴ ገረ ሰሚ ኦል እላሌ አከነ ጄዼ፦</para>
  <para style="pm" vid="JHN 17:1">
    <char style="wj">“ያ አባ፣ ሰኣቲን ሱን ገኤረ። አከ እልምኬስ ኡልፍነ ሲፍ ኬኑፍ፣ አት እልመኬቲፍ ኡልፍነ ኬን።</char> <verse eid="JHN 17:1"/><verse number="2" style="v" sid="JHN 17:2"/><char style="wj">አከ እን ወረ አት እሳፍ ኬንቴ ሁንዳፍ ጅሬኘ በረ በራ ኬኑፍ፣ ነመ ሁንደረት ታይታ እሳፍ ኬንቴርታቲ።</char> <verse eid="JHN 17:2"/><verse number="3" style="v" sid="JHN 17:3"/><char style="wj">ጅሬኝ በረ በራስ ከነ፦ እንስ አከ እሳን ስእ ዋቀ ዹጋ ቶክቻፊ ዬሱስ ክርስቶስ እሰ አት ኤርግቴ ሰነ ቤከኒፍ።</char> <verse eid="JHN 17:3"/><verse number="4" style="v" sid="JHN 17:4"/><char style="wj">አን ሆጂ አት አከ አን ሆጄዹፍ ነት ኬንቴ ሰነ ራወቹዻን ለፈረት ኡልፍነ ሲፍ ኬኔረ።</char> <verse eid="JHN 17:4"/><verse number="5" style="v" sid="JHN 17:5"/><char style="wj">ያ አባ፣ አመሞ አት ኡልፍነ አን ኡቱ አዱኛን ህንኡመምኒን ዱረ ስ ብረት ቀባዼ ሰናን ኦፍ ብረት ነ ኡልፌስ።</char><verse eid="JHN 17:5"/></para>
  <para style="s1">ዬሱስ በረቶተሳቲፍ ከዸቹሳ</para>
  <para style="pm">
    <verse number="6" style="v" sid="JHN 17:6"/>
    <char style="wj">“አን ነሞተ አት አዱኛ ኬሳ ናፍ ኬንቴት መቃኬ ቤክስሴረ። እሳን ከንኬ ቱረን፤ አት እሳን ናፍ ኬንቴ፤ እሳንስ ዱቢኬ ኤገኒሩ።</char> <verse eid="JHN 17:6"/><verse number="7" style="v" sid="JHN 17:7"/><char style="wj">እሳን አከ ወን አት አናፍ ኬንቴ ሁንዱምቱ ስ ብራ ዹፌ አመ ቤከኒሩ።</char> <verse eid="JHN 17:7"/><verse number="8" style="v" sid="JHN 17:8"/><char style="wj">አን ዱቢ አት አናፍ ኬንቴ እሳኒፍ ኬኔራቲ፤ እሳንስ ፉዸተኒሩ። አከ አን ስ ብራ በኤስ ዹጉማን ቤከኒሩ፤ አከ አት ነ ኤርግቴስ አመነኒሩ።</char> <verse eid="JHN 17:8"/><verse number="9" style="v" sid="JHN 17:9"/><char style="wj">አን እሳኒፍ ነንከዸዸ። ወር አት ናፍ ኬንቴ ዋን ከንኬ ተአኒፍ እሳኒፍን ከዸዸ መሌ አዱኛፍ ህንከዸዹ።</char> <verse eid="JHN 17:9"/><verse number="10" style="v" sid="JHN 17:10"/><char style="wj">ወን አን ቀቡ ሁንድኑ ከንኬት፤ ወን አት ቀብዱ ሁንድኑስ ከንኮት። አንስ ከናን ኡልፍነ ነንአርገዸ።</char> <verse eid="JHN 17:10"/><verse number="11" style="v" sid="JHN 17:11"/><char style="wj">አን ስአች አዱኛ ኬሰ ህንቱሩ፤ እሳን ገሩ አመዩ አዱኛ ኬሰ ጅሩ፤ አን ገረኬ ነንዹፈ። ያ አባ ቁልቁሉ፣ አኩመ ኑ ቶኮ ታኔ ሰነ እሳንስ አከ ቶኮ ተአኒፍ መቃኬ ከን ናፍ ኬንቴ ሰናን እሳን ኤግ።</char> <verse eid="JHN 17:11"/><verse number="12" style="v" sid="JHN 17:12"/><char style="wj">አን ዬሮን እሳን ወጅን ቱሬት፣ መቃኬ ከን አት ናፍ ኬንቴ ሰናን እሳን ነንኤጌ፤ እሳን ኤጌረስ። አከ ከተቢን ቁልቁሉን ራወተሙፍስ እልመ በዲ ሰነ መሌ እሳን ኬሳ ነምን ቶኮዩ ህንበድኔ።</char><verse eid="JHN 17:12"/></para>
  <para style="pm">
    <verse number="13" style="v" sid="JHN 17:13"/>
    <char style="wj">“አመ ገሩ አን ገረኬ ነንዹፈ፤ ገመቹንኮስ አከ እሳን ኬሰት ጉቱ ተኡፍ፣ አን አመዩ ኡቱመን አዱኛ ኬሰ ጅሩ ወንቶተ ከኔን ነንዱበዸ።</char> <verse eid="JHN 17:13"/><verse number="14" style="v" sid="JHN 17:14"/><char style="wj">አን ዱቢኬ እሳኒፍ ኬኔረ፤ አኩመ አን ከን አዱኛ ህንተእን፣ እሳንስ ዋን ከን አዱኛ ህንተእኒፍ፣ አዱኛን እሳን ጅቤረ።</char> <verse eid="JHN 17:14"/><verse number="15" style="v" sid="JHN 17:15"/><char style="wj">አን አከ አት እሰ ሀማ ሰነ እሳንራ ኤግዱፍ መሌ አከ አት አዱኛ ኬሳ እሳን ባፍቱፍ ስ ህንከዸዹ።</char> <verse eid="JHN 17:15"/><verse number="16" style="v" sid="JHN 17:16"/><char style="wj">አኩመ አን ከን አዱኛ ህንተእን እሳንስ አከሱመ ከን አዱኛ ምት።</char> <verse eid="JHN 17:16"/><verse number="17" style="v" sid="JHN 17:17"/><char style="wj">ዹጋዻን እሳን ቁልቁሌስ፤ ዱቢንኬ ዹጋዸ።</char> <verse eid="JHN 17:17"/><verse number="18" style="v" sid="JHN 17:18"/><char style="wj">አኩመ አት ገረ አዱኛት ነ ኤርግቴ ሰነ አንስ ገረ አዱኛት እሳን ኤርጌረ።</char> <verse eid="JHN 17:18"/><verse number="19" style="v" sid="JHN 17:19"/><char style="wj">አከ እሳንስ ዹጉማን ቁልቁላአኒፍ፣ አን እሳኒፍ ጄዼ ኦፍ ነንቁልቁሌሰ።</char><verse eid="JHN 17:19"/></para>
  <para style="s1">ዬሱስ አመንቶተ ሁንዳፍ ከዸቹሳ</para>
  <para style="pm">
    <verse number="20" style="v" sid="JHN 17:20"/>
    <char style="wj">“አን ወረ ዱቢሳኒቲን ነት አመነኒፍስ መሌ እሳን ከነ ቆፋፍ ህንከዸዹ፤</char> <verse eid="JHN 17:20"/><verse number="21" style="v" sid="JHN 17:21"/><char style="wj">ኩንስ ያ አባ፣ አኩመ አት ነ ኬሰ ጅርቱ፣ አንስ ስ ኬሰ ጅሩ ሰነ፣ አከ ሁንድሳኒ ቶኮ ተአኒፍ። አከ አት ነ ኤርግቴ አዱኛን አከ አመኑፍ እሳንስ ኑ ኬሰ ሃጅራተን።</char> <verse eid="JHN 17:21"/><verse number="22" style="v" sid="JHN 17:22"/><char style="wj">አኩመ ኑ ቶኮ ታኔ እሳንስ አከ ቶኮ ተአኒፍ፣ ኡልፍነ አት ናፍ ኬንቴ ሰነ አንስ እሳኒፍ ኬኔረ፤</char> <verse eid="JHN 17:22"/><verse number="23" style="v" sid="JHN 17:23"/><char style="wj">ኩንስ አከ እሳን ጉቱማት ቶኮ ተአኒፍ አን እሳን ኬሰ ነንጅራዸ፤ አትሞ ነ ኬሰ ጅራተ። ዮስ አከ አት ነ ኤርግቴፊ አኩመ ነ ጃለቴት አከ እሳንስ ጃለቴ አዱኛን ንቤከ።</char><verse eid="JHN 17:23"/></para>
  <para style="pm">
    <verse number="24" style="v" sid="JHN 17:24"/>
    <char style="wj">“ያ አባ፣ አከ ወር አት ናፍ ኬንቴ ኩኔን እዶ አን ጅሩ ነ ወጅን ጅራተኒፊ አከ እሳን ኡልፍነኮ ከን አት ኡቱ አዱኛን ህንኡመምኒን ዱረ ዋን ነ ጃለቴፍ ናፍ ኬንቴ ሰነ አርገንስ ነንበርባደ።</char><verse eid="JHN 17:24"/></para>
  <para style="pm">
    <verse number="25" style="v" sid="JHN 17:25"/>
    <char style="wj">“ያ አባ ቀጄልትቸ፣ አዱኛን ስ ህንቤኩ፤ አን ገሩ ስ ቤከ፤ እሳን ኩንስ አከ አት ነ ኤርግቴ ንቤኩ።</char> <verse eid="JHN 17:25"/><verse number="26" style="v" sid="JHN 17:26"/><char style="wj">አከ ጃለል አት እቲን ነ ጃለቴ ሱን እሳን ኬሰ ጅራቱፍ፣ አንስ አከን እሳን ኬሰ ጅራዹፍ አን አከ መቃንኬ እሳን ብረት ቤከሙ ጎዼረ፤ አከ ቤከሙስ ነንጎዸ።”</char><verse eid="JHN 17:26"/></para>
  <chapter eid="JHN 17"/>
  <chapter number="18" style="c" sid="JHN 18"/>
  <para style="s1">ዬሱስ ቀበሜ</para>
  <para style="r">
    <ref loc="JHN 18:3-11">18፥3‑11</ref> ኩወፈ – <char style="xt"><ref loc="MAT 26:47-56">ማቴ 26፥47‑56</ref>፤ <ref loc="MRK 14:43-50">ማር 14፥43‑50</ref>፤ <ref loc="LUK 22:47-53">ሉቃ 22፥47‑53</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1"/>ዬሱስ ወንቶተ ከኔን ዱበቴ በረቶተሳ ወጅን ሱሉለ ቄድሮን ገመ እዶ ብቅልቱን ቱሬ ቶኮት ጬኤ፤ እንስ፣ በረቶትንሳስ አች ኬሰ ሴነን።<verse eid="JHN 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 18:2"/>ዬሱስ ዬሮ ባይኤ በረቶተሳ ወጅን አችት ወል አርጋ ዋን ቱሬፍ፣ ይሁዳን እን ዬሱስን ደበርሴ ኬኑ ሱንስ እዶ ሰነ ቤከ ቱሬ። <verse eid="JHN 18:2"/><verse number="3" style="v" sid="JHN 18:3"/>ከናፉ ይሁዳን ቱተ ሎልቶታቲፊ ቆንዳልቶተ ሉቦተ ሀንገፎታፊ ፈሪሶተ ብራ ኤርገመን ዱረ ዴማ አች ዹፌ። እሳንስ ጉጨ፣ እብሳፊ ምአ ሎላ ቀበተኒ ቱረን።<verse eid="JHN 18:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 18:4"/>ዬሱስስ ዋን እሰረ ገኡፍ ጅሩ ሁንደ ቤክናን ገድ በኤ፣ <char style="wj">“እስን ኤኙን በርባዱ?”</char> ጄዼ እሳን ጋፈቴ።<verse eid="JHN 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5"/>እሳንስ ዴብሰኒ፣ “ዬሱስ እሰ ናዝሬት” ጄዸን።</para>
  <para style="p" vid="JHN 18:5">ዬሱስሞ፣ <char style="wj">“አን እሳዸ”</char> ጄዼ። ይሁዳን እን ደበርሴ እሰ ኬኑ ሱንስ ጀረ ወጅን አች ዻበቻ ቱሬ። <verse eid="JHN 18:5"/><verse number="6" style="v" sid="JHN 18:6"/>ዮሙ ዬሱስ፣ <char style="wj">“አን እሳዸ”</char> እሳኒን ጄዼት ዱግደ ዱበት ዴብአኒ ለፈት ኩኩፈን።<verse eid="JHN 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 18:7"/>አመስ፣ <char style="wj">“እስን ኤኙን በርባዱ?”</char> ጄዼ እሳን ጋፈቴ።</para>
  <para style="p" vid="JHN 18:7">እሳንስ፣ “ዬሱስ እሰ ናዝሬት” ጄዸን።<verse eid="JHN 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8"/>ዬሱስስ ዴብሴ፣ <char style="wj">“አን፣ ‘አን እሳዸ’ እስኒን ጄዼረ። ከናፉ፣ እስን ዮ ነ በርባደን ነሞተ ከኔን ዺሳ ሃዴመኒ!”</char> ጄዼ። <verse eid="JHN 18:8"/><verse number="9" style="v" sid="JHN 18:9"/>ኩንስ አከ ዱቢን እን፣ <char style="wj">“አን ወረ አት ናፍ ኬንቴ ኬሳ ቶኮሌ ህንገትኔ”</char><note caller="+" style="f"><char style="fr" closed="false">18፥9 </char><char style="ft" closed="false"><char style="xt"><ref loc="JHN 6:39">ዮሀ 6፥39</ref></char></char></note> ጄዼ ዱበቴ ሱን ራወተሙፍ ተኤ።<verse eid="JHN 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10"/>ስሞን ጴጥሮስ ጎራዴ ቀቡ ሉቅፈቴ ገርብቸ ሉበ ኦል ኣና ዸኤ ጉረሳ ከን ምርጋ እራ ኩቴ። መቃን ገርብቸ ሰናስ ማልኮሲዸ።<verse eid="JHN 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 18:11"/>ዬሱስስ ጴጥሮሲን፣ <char style="wj">“ጎራዴኬ መንኤሳት ዴብስ! አን ጦፎ አባን ናፍ ኬኔ ህንዹጉ?”</char> ጄዼ።<verse eid="JHN 18:11"/></para>
  <para style="s1">ዬሱስ ሃናት ጌፈሜ</para>
  <para style="r">
    <ref loc="JHN 18:12">18፥12</ref>፣<ref loc="JHN 18:13">13</ref> ኩወፈ – <char style="xt"><ref loc="MAT 26:57">ማቴ 26፥57</ref></char></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12"/>ቱትን ሎልቶታ፣ አጀጃንሳኒቲፊ ኤግዶን ይሁዶታስ ዬሱስን ቀበኒ ህዸን። <verse eid="JHN 18:12"/><verse number="13" style="v" sid="JHN 18:13"/>እሳንስ ዱራን ዱርሰኒ ሃናት እሰ ጌሰን፤ ሃናን አባ ኒቲ ቀያፋት፤ ቀያፋንሞ በረ ሰነ ሉበ ኦል ኣና ቱሬ። <verse eid="JHN 18:13"/><verse number="14" style="v" sid="JHN 18:14"/>ቀያፋን እሰ አከ ነምን ቶኮ ኡመታፍ ዱኡን ወዩ ይሁዶተ ጎርሴ ቱሬዸ።<verse eid="JHN 18:14"/></para>
  <para style="s1">ጴጥሮስ ዬሮ ጀልቀባቲፍ ዬሱስን ገኑሳ</para>
  <para style="r">
    <ref loc="JHN 18:16-18">18፥16‑18</ref> ኩወፈ – <char style="xt"><ref loc="MAT 26:69">ማቴ 26፥69</ref>፣<ref loc="MAT 26:70">70</ref>፤ <ref loc="MRK 14:66-68">ማር 14፥66‑68</ref>፤ <ref loc="LUK 22:55-57">ሉቃ 22፥55‑57</ref></char></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15"/>ስሞን ጴጥሮሲፊ በረታን ብራ ዬሱስ ፋነ ቡአን። በረታን ሱንስ ዋን ሉበ ኦል ኣና ብረት ቤከማ ቱሬፍ፣ ዬሱስ ወጅን ደላ ሉበ ኦል ኣና ኬሰ ሴኔ፤ <verse eid="JHN 18:15"/><verse number="16" style="v" sid="JHN 18:16"/>ጴጥሮስ ገሩ በልበለ ዱረ አለ ዻበቻ ቱሬ። በረታን ሉበ ኦል ኣና ብረት ቤከማ ቱሬ ካን ገድ በኤ እንተለ በልበለ ኤግዱት ህሜ ጴጥሮስን ኦል ሴንስሴ።<verse eid="JHN 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 18:17"/>እንተል በልበለ ኤግዱ ሱንስ ጴጥሮሲን፣ “አትስ በረቶተ ነምቸ ከና ኬሳ ቶኮ ምቲ?” ጄቴ።</para>
  <para style="p" vid="JHN 18:17">እንሞ ዴብሴ፣ “አነ ምት” ጄዼ።<verse eid="JHN 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18"/>ዬሮንሳ ዋን ዻሞቸ ቱሬፍ ገርቦትኒፊ ኤግዶን እብደ ቀብሲፈተኒ ዸዻበተኒ ቀቃመቻ ቱረን። ጴጥሮስስ እሳን ወጅን ዻበቴ ቀቃመቻ ቱሬ።<verse eid="JHN 18:18"/></para>
  <para style="s1">ጋፊ ሉብች ኦል ኣናን ዬሱሲፍ ዽኤሴ</para>
  <para style="r">
    <ref loc="JHN 18:19-24">18፥19‑24</ref> ኩወፈ – <char style="xt"><ref loc="MAT 26:59-68">ማቴ 26፥59‑68</ref>፤ <ref loc="MRK 14:55-65">ማር 14፥55‑65</ref>፤ <ref loc="LUK 22:63-71">ሉቃ 22፥63‑71</ref></char></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19"/>ዮሙስ ሉብን ኦል ኣናን ዬሱስን ዋኤ በረቶተሳቲፊ ዋኤ በርሲሰሳ ጋፈቴ።<verse eid="JHN 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 18:20"/>ዬሱስስ አከነ ጄዼ ዴብሴፍ፤ <char style="wj">“አን እፋን እፈት አዱኛት ዱበዼረ፤ እዶ ይሁዶን ሁንድ እት ወልት ቀበመንት፣ መኔን ሰገዳቲፊ መነ ቁልቁሉማ ኬሰትስ አን ዬሮ ሁንደ በርሲሳን ቱሬ። አን ዋን ቶኮሌ እጪቲዻን ህንዱበትኔ።</char> <verse eid="JHN 18:20"/><verse number="21" style="v" sid="JHN 18:21"/><char style="wj">አት ማሊፍ ነ ጋፈተ? ወረ ዋን አን እሳኒን ጄዼ ዸገአን ጋፈዹ። ኩኖ እሳን ዋን አን ጄዼ ቤኩ።”</char><verse eid="JHN 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22"/>ዮሙ ዬሱስ ወንቶተ ከኔን ጄዼት ቆንዳልቶተ አች እጃጃ ቱረን ኬሳ ቶኮ፣ “ሉበ ኦል ኣናፍ አከነ ዴብፍታ?” ጄዼ እሰ ከበሌ።<verse eid="JHN 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23"/>ዬሱስስ ዴብሴ፣ <char style="wj">“ዮ አን ዋን ሀማ ዱበዼ ጅራዼ፣ ዋን ሀማ ሰነ ዹጋ በእ። ዮ አን ዋን ቀጄላ ዱበዼ ጅራዼ ገሩ አት ማሊፍ ነ ሩኩተ?”</char> ጄዼ። <verse eid="JHN 18:23"/><verse number="24" style="v" sid="JHN 18:24"/>ሃናንስ ዬሱስን አኩመ እን ህዸሜ ጅሩት ገረ ሉብቸ ኦል ኣና፣ ገረ ቀያፋት ኤርጌ።<verse eid="JHN 18:24"/></para>
  <para style="s1">ጴጥሮስ ዬሮ ለመፋፊ ሰደፋ ዬሱስን ገኑሳ</para>
  <para style="r">
    <ref loc="JHN 18:25-27">18፥25‑27</ref> ኩወፈ – <char style="xt"><ref loc="MAT 26:71-75">ማቴ 26፥71‑75</ref>፤ <ref loc="MRK 14:69-72">ማር 14፥69‑72</ref>፤ <ref loc="LUK 22:58-62">ሉቃ 22፥58‑62</ref></char></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25"/>ስሞን ጴጥሮስ ዻበቴ እብደ ቀቃመቻ ቱሬ። ከናፉ እሳን፣ “አትስ በረቶተሳ ኬሳ ቶኮ ምቲ?” ጄዸኒን።</para>
  <para style="p" vid="JHN 18:25">እንሞ፣ “አነ ምቲ” ጄዼ ሃሌ።<verse eid="JHN 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26"/>ገርቦተ ሉበ ኦል ኣና ኬሳስ ፍር ነምቸ ጴጥሮስ ጉረሳ እራ ኩቴ ሰና ቶኮ፣ “አን እዶ ብቅልቱት እሰ ወጅን ስ ህንአርግኔ?” ጄዼን። <verse eid="JHN 18:26"/><verse number="27" style="v" sid="JHN 18:27"/>ጴጥሮስ አመስ ንገኔ፤ ዮሙሱመ እንዳንቆን እዬ።<verse eid="JHN 18:27"/></para>
  <para style="s1">ዬሱስ ፉለ ጲላጦስ ዱረት</para>
  <para style="r">
    <ref loc="JHN 18:29-40">18፥29‑40</ref> ኩወፈ – <char style="xt"><ref loc="MAT 27:11-18">ማቴ 27፥11‑18</ref>፣<ref loc="MAT 27:20-23">20‑23</ref>፤ <ref loc="MRK 15:2-15">ማር 15፥2‑15</ref>፤ <ref loc="LUK 23:2">ሉቃ 23፥2</ref>፣<ref loc="LUK 23:3">3</ref>፣<ref loc="LUK 23:18-25">18‑25</ref></char></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28"/>ይሁዶትንስ ዬሱስን መነ ቀያፋቲ ፉዸኒ መሰራ ቡልቻ ወረ ሮማት ጌሰን። ዬሮን ሱን ገነመ በሪ ቱሬ፤ ይሁዶትንስ አከ ህንጡሮፍኔፍ ጄዸኒ መሰራ ኦል ህንሴኔ፤ ኩንስ አከ ፋሲካ ኛቹ ደንደአኒፍ። <verse eid="JHN 18:28"/><verse number="29" style="v" sid="JHN 18:29"/>ከናፉ ጲላጦስ ገረሳኒት ገድ በኤ፣ “ህመን እስን ነምቸ ከነረት ዽኤስተን ማል?” ጄዼ ጋፈቴ።<verse eid="JHN 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30"/>እሳንስ፣ “ኡቱ ነምች ኩን የከ ሆጄቹ ባቴ ኑ ስላ እሰ ደበርስኔ ስት ህንኬንኑ ቱሬ” ጄዸኒ ዴብሰኒፍ።<verse eid="JHN 18:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31"/>ጲላጦስስ፣ “እስን ኦፉመኬሰኒ እሰ ፉዻቲ አከ ሴረኬሰኒት እት ሙራ” ጄዼን።</para>
  <para style="p" vid="JHN 18:31">ይሁዶትንስ፣ “ኑ ገሩ ነመ ቶኮሌ አጄሱፍ ምርገ ህንቀብኑ” ጄዸኒን። <verse eid="JHN 18:31"/><verse number="32" style="v" sid="JHN 18:32"/>ኩንስ ወን ዬሱስ አከ ዱአ አከሚቲን ዱኡፍ ጅሩ አርግሲሱፍ ጄዼ ዱበቴ ሱን አከ ራወተሙፍ ተኤ።<verse eid="JHN 18:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33"/>ጲላጦስ አመስ መሰራ ሞቱማ ሴኔ፤ ዬሱስንስ ኦፍት ዋሜ፣ “አት ሞቲ ይሁዶታቲ?” ጄዼ እሰ ጋፈቴ።<verse eid="JHN 18:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34"/>ዬሱስስ፣ <char style="wj">“ዋን ከነ ሱመቱ ጄዼሞ ነሞተ ብራቱ ዋኤኮ ስት ህሜ?”</char> ጄዼ ጋፈቴ።<verse eid="JHN 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35"/>ጲላጦስስ ዴብሴ፣ “ነቱ ይሁዲዻሬ? ከን ደበርሴ ነት ስ ኬኔ ሰቡመኬቲፊ ሉቦተ ሀንገፎተ። ገሩ አት ማል ጎቴት?” ጄዼን።<verse eid="JHN 18:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36"/>ዬሱስስ፣ <char style="wj">“ሞቱማንኮ ከን አዱኛ ከና ምት። ኡቱ ከን አዱኛ ከና ተኤ ስላ አከ አን ደበርፈሜ ይሁዶተት ህንኬነምኔፍ ተጃጅልቶትንኮ ናፍ ሎሉ ቱረን። አመ ገሩ ሞቱማንኮ ከን አዱኛ ከና ምት”</char> ጄዼ።<verse eid="JHN 18:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37"/>ጲላጦስስ፣ “ዮስ አት ሞቲዸካ!” ጄዼን።</para>
  <para style="p" vid="JHN 18:37">ዬሱስሞ፣ <char style="wj">“አከ አን ሞቲ ተኤ አቱ ጄቴ። ዹጉማን ወን አን ዸለዼ ገረ አዱኛ ዹፌፍስ ዹጋዻፍ ዹጋ በኡፍ። ነምን ዹጋፍ ዻበቱ ሁንድኑ ሰገሌኮ ዸገአ”</char> ጄዼ ዴብሴ።<verse eid="JHN 18:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38"/>ጲላጦስስ፣ “ዹጋን ማል እን?” ጄዼን። እንስ ኤርገ ዋን ከነ ዱበቴ ቦዴ አመሌ ይሁዶተት ገድ በኤ አከነ ጄዼን፤ “አን በሌሳ ቶኮሌ እሰረት ህንአርገትኔ። <verse eid="JHN 18:38"/><verse number="39" style="v" sid="JHN 18:39"/>ገሩ እስን አከ አን ዬሮ ፋሲካት ነመ ቶኮ ገድ እስኒ ዺሱ በርቴ ጎዸተኒርቱ። ከናፉ አከ አን፣ ‘ሞቲ ይሁዶታ’ ገድ እስኒ ዺሱ በርባዱ?”<verse eid="JHN 18:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40"/>እሳን አመሌ እየኒ፣ “ለክ፣ በረባስ መሌ እሰ ምት!” ጄዸን። በረባስ ኩን ሳምቱ ቱሬ።<verse eid="JHN 18:40"/></para>
  <chapter eid="JHN 18"/>
  <chapter number="19" style="c" sid="JHN 19"/>
  <para style="s1">ፈንፈሙን ዬሱስት ሙረሜ</para>
  <para style="r">
    <ref loc="JHN 19:1-16">19፥1‑16</ref> ኩወፈ – <char style="xt"><ref loc="MAT 27:27-31">ማቴ 27፥27‑31</ref>፤ <ref loc="MRK 15:16-20">ማር 15፥16‑20</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1"/>ጲላጦስስ ዬሱስን ፉዼ ገረፍሲሴ። <verse eid="JHN 19:1"/><verse number="2" style="v" sid="JHN 19:2"/>ሎልቶትንስ ጎንፎ ቆራቲ ምጪረኒ ዸአኒ መታሳረ ካአን። እሳንስ ኡፈተ ዺልጌ እሰት ኡፍሰኒ፣ <verse eid="JHN 19:2"/><verse number="3" style="v" sid="JHN 19:3"/>“አከምሬ፣ ያ ሞቲ ይሁዶታ!” ጄቻ ገረሳት ዴዴብኣ ቱረን። እሰስ ንከበለን።<verse eid="JHN 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4"/>ጲላጦስ አመሌ ገድ በኤ ይሁዶታን፣ “አከ አን በሌሳ ቶኮሌ እሰረት ህንአርገን አከ ቤክተኒፍ ኩኖ አን እሰ ገድ እስኒፍን ባሰ” ጄዼ። <verse eid="JHN 19:4"/><verse number="5" style="v" sid="JHN 19:5"/>ዬሱስስ ጎንፎ ቆራቲ ካአቴ፣ ወያ ዺልጌስ ኡፈቴ ገድ በኤ፤ ጲላጦስስ፣ “ነምች ኩኖት!” እሳኒን ጄዼ።<verse eid="JHN 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6"/>ሉቦትን ሀንገፎትኒፊ ቆንዳልቶትንሳኒ ዮሙ እሰ አርገንት፣ “ፈንስ! ፈንስ!” ጄዸኒ እየን።</para>
  <para style="p" vid="JHN 19:6">ጲላጦስሞ ዴብሴ፣ “እስን ኦፉመኬሰኒ ፉዻቲ እሰ ፈንሳ መሌ አን በሌሳ ቶኮዩ እሰረት ህንአርገትኔ” ጄዼን።<verse eid="JHN 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7"/>ይሁዶትንስ ዴብሰኒ፣ “ኑ ሴረ ቀብነ፤ ነምች ኩን ዋን እልመ ዋቃ ኦፍ ጎዼፍ አከ ሴረኬኛት ዱኡ ቀበ” ጄዸን።<verse eid="JHN 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8"/>ጲላጦስስ ዮሙ ዱቢ ከነ ዸገኤት እቱመ ጫልችሴ ሶዳቴ። <verse eid="JHN 19:8"/><verse number="9" style="v" sid="JHN 19:9"/>እንስ መሰራት ኦል ዴብኤ፣ “አት ነመ ኤሳት?” ጄዼ ዬሱስን ጋፈቴ። ዬሱስ ገሩ ዴቢ ቶኮዩ ህንኬንኔፍ። <verse eid="JHN 19:9"/><verse number="10" style="v" sid="JHN 19:10"/>ጲላጦስስ፣ “አት ነ ጀላ ዱበቹ ድዳ? አከ አን ገድ ስዺሱፍ ታይታ ቀቡፊ አከ አን ስፈንሱፍ ታይታ ቀቡ አት ህንቤክቱ?” ጄዼን።<verse eid="JHN 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11"/>ዬሱስሞ፣ <char style="wj">“አት ኡቱ ኦሊ ሲፍ ኬነሙ ባቴ ስላ ታይታ ቶኮሌ ነረት ህንቀብዱ ቱሬ። ከናፍ እን ደበርሴ ስት ነ ኬኔ ሱን ጩቡ ጩቡ ጫሉ ቀበ”</char> ጄዼ ዴብሴፍ።<verse eid="JHN 19:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12"/>ጲላጦስስ ዬሮ ሰና ጀልቀቤ ዬሱስን ገድ ዺሱ በርባደ ቱሬ፤ ይሁዶትን ገሩ፣ “አት ዮ ነምቸ ከነ ገድ ዺፍቴ ምቹ ቄሳር ምት። ነምን ሞቲ ኦፍ ጎዹ ከምዩ ቄሳሪን ሞርመ” ጄዸኒ እየን።<verse eid="JHN 19:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13"/>ጲላጦስስ ዮሙ ዱቢ ከነ ዸገኤት ዬሱስን ገድ ባሴ፣ እዶ “ዸጋ አፈማ” ከን አፋን እብራይስጢቲን “ገበታ” ጄዸሙት በርጩመ ሙርቲረ ታኤ። <verse eid="JHN 19:13"/><verse number="14" style="v" sid="JHN 19:14"/>ጉያን ሱንስ ጉያ ቆጲ ፋሲካ ቱሬ፤ ዬሮንሳስ ገረ ሰኣቲ ጀኣ ቱሬ።</para>
  <para style="p" vid="JHN 19:14">ጲላጦስስ ይሁዶታን፣ “ሞቲንኬሰን ኩኖት!” ጄዼ።<verse eid="JHN 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15"/>እሳን ገሩ፣ “እሰ በሌስ! እሰ በሌስ! እሰ ፈንስ!” ጄዸኒ እየን።</para>
  <para style="p" vid="JHN 19:15">ጲላጦስሞ፣ “ሞቲኬሰን ፈንሱሞ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="JHN 19:15">ሉቦትን ሀንገፎትንስ፣ “ኑ ቄሳር መሌ ሞቲ ብራ ህንቀብኑ” ጄዸኒ ዴብሰኒፍ።<verse eid="JHN 19:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16"/>ከናፍ ጲላጦስ አከ እን ፈንፈሙፍ ደበርሴ እሳንት ኬኔ።</para>
  <para style="s1" vid="JHN 19:16">ዬሱስ ፈንፈሜ</para>
  <para style="r" vid="JHN 19:16">
    <ref loc="JHN 19:17-24">19፥17‑24</ref> ኩወፈ – <char style="xt"><ref loc="MAT 27:33-44">ማቴ 27፥33‑44</ref>፤ <ref loc="MRK 15:22-32">ማር 15፥22‑32</ref>፤ <ref loc="LUK 23:33-43">ሉቃ 23፥33‑43</ref></char></para>
  <para style="p" vid="JHN 19:16">እሳንስ ዬሱስን ፉዸኒ ዴመን። <verse eid="JHN 19:16"/><verse number="17" style="v" sid="JHN 19:17"/>እንስ ፈኖ ኦፊሳ ባዸቴ እዶ ቡቄ መታ ከን አፋን እብራይስጢቲን <char style="tl">ጎልጎታ</char> ጄዸሙት ኦል በኤ። <verse eid="JHN 19:17"/><verse number="18" style="v" sid="JHN 19:18"/>እሳንስ አችት እሰ ፈንሰን፤ እሰ ወጅንስ ነሞተ ብራ ለመ፣ እሰ ቶኮ ገረናን፣ ካንሞ ገረሲን፣ ዬሱስንሞ ግዱሳኒት ፈንሰን።<verse eid="JHN 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 19:19"/>ጲላጦስስ ከተቢ፣</para>
  <para style="pc" vid="JHN 19:19">ዬሱስ እሰ ናዝሬት፣ ሞትቸ ይሁዶታ</para>
  <para style="m" vid="JHN 19:19">ጄዹ ቶኮ በሬሴ ፈኖ ሰነት መጠንሴ። <verse eid="JHN 19:19"/><verse number="20" style="v" sid="JHN 19:20"/>እዶን ዬሱስ እት ፈንፈሜ ዋን መጋላት ዽኦ ቱሬፍ ይሁዶትን ሄዱን ከተቢ ሰነ ዱብሰኒሩ፤ ከተቢን ሱንስ አፋን እብራይስጢቲን፣ ላቲኒፊ ግሪኪን በሬፈሜ። <verse eid="JHN 19:20"/><verse number="21" style="v" sid="JHN 19:21"/>ሉቦትን ይሁዶታ ሀንገፎትን ጲላጦሲን፣ “ነምች ኩን፣ ‘ “አን ሞቲ ይሁዶታት” ጄዼረ’ ጄዺ በሬስ መሌ፣ ‘እን ሞቲ ይሁዶታት’ ጄቴ ህንበሬስን” ጄዸን።<verse eid="JHN 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22"/>ጲላጦስስ፣ “አን ዋነን በሬሴ፣ በሬሴረ” ጄዼ ዴብሴ።<verse eid="JHN 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23"/>ሎልቶትን ሱንስ ኤርገ ዬሱስን ፈንሰኒ ቦዴ ክታሳ ሀምብሰኒ ወያሳ ፉዸኒ አከ ቶኮ ቶኮ እሳን ገኡፍ እዶ አፉርት ህረተን። ክታን ሱን ህንሆዸምኔ፤ ኦሊ ሀመ ገዲትስ ዸኣ ቶኮ ቱሬ።<verse eid="JHN 19:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 19:24"/>ከናፉ እሳን፣ “ኮታ ህንተርሳስኑ፤ ገሩ እጣ ቡፈትኔ አከ እን ከን ኤኙ ተኡ እላላ”<note caller="+" style="f"><char style="fr" closed="false">19፥24 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 22:18">ፋር 22፥18</ref></char></char></note> ወሊን ጄዸን።</para>
  <para style="p" vid="JHN 19:24">ኩንስ አከ ከተቢን ቁልቁሉን፣</para>
  <para style="q1" vid="JHN 19:24">“እሳን ወያኮ ህረተን፤</para>
  <para style="q2" vid="JHN 19:24">ኡፈተኮትስ እጣ ቡፈተን”</para>
  <para style="m" vid="JHN 19:24">ጄዹ ሱን ራወተሙፍ ተኤ። ወን ሎልቶትን ጎዸንስ ከኑመ።<verse eid="JHN 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25"/>ፈኖ ዬሱስ ብረስ ሃትሳ፣ ኦቦሌቲን ሃዸሳ፣ ማርያም ኒቲን ቀለዮጳቲፊ ማርያም እሼን መግደላ ዻበተኒ ቱረን። <verse eid="JHN 19:25"/><verse number="26" style="v" sid="JHN 19:26"/>ዬሱስስ ዮሙ ሃዸሳቲፊ በረታ እን ጃለቱ ሰነ ኡቱ እን እሼ ጭነ ዻበቱ አርጌት ሃዸሳቲን፣ <char style="wj">“ዱበርቲነነ! ኩኖ፣ እልመኬ”</char> ጄዼ። <verse eid="JHN 19:26"/><verse number="27" style="v" sid="JHN 19:27"/>በረታ ሰናን፣ <char style="wj">“ኩኖ ሃዸኬ”</char> ጄዼ፤ በረታን ሱንስ ሰኣቲ ሰና ጀልቀቤ ገረ መነሳት እሼ ፉዸቴ።<verse eid="JHN 19:27"/></para>
  <para style="s1">ዱአ ዬሱስ</para>
  <para style="r">
    <ref loc="JHN 19:29">19፥29</ref>፣<ref loc="JHN 19:30">30</ref> ኩወፈ – <char style="xt"><ref loc="MAT 27:48">ማቴ 27፥48</ref>፣<ref loc="MAT 27:50">50</ref>፤ <ref loc="MRK 15:36">ማር 15፥36</ref>፣<ref loc="MRK 15:37">37</ref>፤ <ref loc="LUK 23:36">ሉቃ 23፥36</ref></char></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28"/>ኤርገሲ ዬሱስ አከ ወን ሁንድኑ ራወተሜ ቤኬ አከ ከተቢን ቁልቁሉን ራወተሙፍ፣ <char style="wj">“ነንዼቦዼ”</char> ጄዼ። <verse eid="JHN 19:28"/><verse number="29" style="v" sid="JHN 19:29"/>ቆዳን ዸንገጋኣ ቀቡ ቶኮ አች ቱሬ፤ እሳንስ ዸንገጋኣ ሰነ ኬሰ እስፖንጂ ጩጰኒ ሂሶጲት ካአኒ አፋንሳት ቀበን። <verse eid="JHN 19:29"/><verse number="30" style="v" sid="JHN 19:30"/>ዬሱስስ ዸንገጋኣ ሰነ ፉዸቴ፣ <char style="wj">“ራወቴረ”</char> ጄዼ። መታ ቡሴስ ሀፉረሳ ኬኔ።<verse eid="JHN 19:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31"/>ጉያን ሱን ጉያ ቆጲ ቱሬ፤ ጉያን ሰንበታ ሱንስ ጉያ አዳ ቱሬ። ከናፉ አከ ሬፍሳኒ ሰንበታን ፈኖረ ህንኦሌ ጎቹፍ ጄዸኒ አከ ሚልሳኒ ጨብሰሜ<note caller="+" style="f"><char style="fr" closed="false">19፥31 </char><char style="fq" closed="false">አከ ሚልሳኒ ጨብሰሜ </char><char style="ft" closed="false">– ሚለ የከምቶታ ቡሩሰ ጉዳዻን ጨብሱን ጎሰ አደቢ ሀማ ቱሬ። ወሉማ ገለት ሚለ ቆፈቱ ጨብሰመ ቱሬ። ዬሮ ቶኮ ቶኮ ገሩ ሀርክስ ንጨብሰመ ቱሬ። አደቢን ኩን ዮሙ ነመ ፈንፈማ ጅሩረት ራወተሙት መታሳቲን ጎሰ አደቢ ገረ ጀብናት። ገሩ ዽጵን ዱአ ፈኖ ከን ሉቡን ደፍቴ ኬሳ ህንባኔ ሱን ዋን ዬሮ ገባባ ኬሰት ራወቱፍ አከ ጎቸ አራራት እላለመ።</char></note> ፈኖራ ገድ ቡፈሙፍ ይሁዶትን ጲላጦስን ከዸተን። <verse eid="JHN 19:31"/><verse number="32" style="v" sid="JHN 19:32"/>ከናፉ ሎልቶትን ዸቀኒ ሚለ ነምቸ ጀልቀባ፣ ሚለ ነምቸ ዬሱስ ወጅን ፈንፈሜ ካኒስ ጨብሰን። <verse eid="JHN 19:32"/><verse number="33" style="v" sid="JHN 19:33"/>ዮሙ ገረ ዬሱስ ዹፈንት ገሩ እን ዱኤ ዋን አርገኒፍ ሚለሳ ህንጨብስኔ። <verse eid="JHN 19:33"/><verse number="34" style="v" sid="JHN 19:34"/>ሎልቶተ ሰነ ኬሳ እን ቶኮ ገሩ ኤቦዻን ጭናቸሳ ወራኔ፤ ዬሩመ ሰነ ዺግኒፊ ብሻን በኤ። <verse eid="JHN 19:34"/><verse number="35" style="v" sid="JHN 19:35"/>ነምን ዋን ከነ አርጌ ረጌሴረ፤ ረጋንሳስ ዹጋዸ። እን አከ ዹጋ ዱበቱ ንቤከ፤ እን አከ እስንስ አመንተኒፍ ዱበተ። <verse eid="JHN 19:35"/><verse number="36" style="v" sid="JHN 19:36"/>ኩንስ ወን ከተቢን ቁልቁሉን፣ “ለፌንሳ ቶኮዩ ህንጨብሰሙ”<note caller="+" style="f"><char style="fr" closed="false">19፥36 </char><char style="ft" closed="false"><char style="xt"><ref loc="EXO 12:46">በኡ 12፥46</ref>፤ <ref loc="NUM 9:12">ለኮ 9፥12</ref>፤ <ref loc="PSA 34:20">ፋር 34፥20</ref></char></char></note> ጄዼ ሱን አከ ራወተሙፍ ተኤ። <verse eid="JHN 19:36"/><verse number="37" style="v" sid="JHN 19:37"/>አመስ ከተቢን ቁልቁሉን ብራ፣ “እሳንስ እሰ ወራነን ሰነ ንእላሉ”<note caller="+" style="f"><char style="fr" closed="false">19፥37 </char><char style="ft" closed="false"><char style="xt"><ref loc="ZEC 12:10">ዘካ 12፥10</ref></char></char></note> ጄዸ።<verse eid="JHN 19:37"/></para>
  <para style="s1">አዋለሙ ዬሱስ</para>
  <para style="r">
    <ref loc="JHN 19:38-42">19፥38‑42</ref> ኩወፈ – <char style="xt"><ref loc="MAT 27:57-61">ማቴ 27፥57‑61</ref>፤ <ref loc="MRK 15:42-47">ማር 15፥42‑47</ref>፤ <ref loc="LUK 23:50-56">ሉቃ 23፥50‑56</ref></char></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38"/>ኤርገሲ ዮሴፍ ነምን አርማትያስ ከን ሰበቢ ይሁዶተ ሶዳቴፍ ዾክሳን በረታ ዬሱስ ቱሬ ሱን ሬፈ ዬሱስ ፉዸቹፍ ጲላጦስን ከዸቴ። ጲላጦስስ እሳፍ ኤየሜ፤ ከናፉ እን ዸቄ ሬፈ ዬሱስ ፉዸቴ። <verse eid="JHN 19:38"/><verse number="39" style="v" sid="JHN 19:39"/>ኒቆዲሞስ እን ዱራን ሀልከኒን ገረ ዬሱሲ ዹፌ ቱሬስ ወልመካ ቁምቢቲፊ አርጌሰ ገረ ኪሎ ግራሚ ሶዶሚ አፉር ኡልፋቱ ቀበቴ ዹፌ። <verse eid="JHN 19:39"/><verse number="40" style="v" sid="JHN 19:40"/>እሳንስ ሬፈ ዬሱስ ፉዸኒ አከ ዱዻ ይሁዶታት አዋሉፍ ኡርጎፍቱ ወጅን ሁጩ ቁንጬ ተልባራ ሆጄተሜን ከፈነን። <verse eid="JHN 19:40"/><verse number="41" style="v" sid="JHN 19:41"/>እዶ ዬሱስ እት ፈንፈሜስ ለፈ ብቅልቱ ቶኮቱ ቱሬ፤ ለፈ ብቅልቱ ሰነ ኬሰስ እዶ አዋላ ሃራ ከን ነምን ቶኮዩ ዱራን እት ህንአዋለምን ቶኮቱ ቱሬ። <verse eid="JHN 19:41"/><verse number="42" style="v" sid="JHN 19:42"/>ሰበቢ ጉያን ሱን ጉያ ቆጲ ይሁዶታ ቱሬፊ እዶን አዋላ ሱንስ ዋን ዽኦ ቱሬፍ ዬሱስን አች ኬሰ ካአን።<verse eid="JHN 19:42"/></para>
  <chapter eid="JHN 19"/>
  <chapter number="20" style="c" sid="JHN 20"/>
  <para style="s1">አዋለ ዱዋ</para>
  <para style="r">
    <ref loc="JHN 20:1-8">20፥1‑8</ref> ኩወፈ – <char style="xt"><ref loc="MAT 28:1-8">ማቴ 28፥1‑8</ref>፤ <ref loc="MRK 16:1-8">ማር 16፥1‑8</ref>፤ <ref loc="LUK 24:1-10">ሉቃ 24፥1‑10</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1"/>ጉያ ጀልቀበ ቶርበን ሰና ገነመ በሪ ኡቱመ ዱከናኤ ጅሩ ማርያም እሼን መግደላ ገረ አዋላ ዸቅጤ አከ ዸጋን አፋን አዋለ ሰናራ ፉዸሜ አርግቴ። <verse eid="JHN 20:1"/><verse number="2" style="v" sid="JHN 20:2"/>ከናፉ እሼን ፊጋ ገረ ስሞን ጴጥሮሲፊ ገረ በረታ ብራ ከን ዬሱስ እሰ ጃለቴ ሰና ዸቅጤ፣ “ጎፍታ አዋለ ኬሳ ፉዸተኒሩ፤ ኤሰ አከ እሰ ካአንስ ህንቤክኑ!” ጄቴን።<verse eid="JHN 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3"/>ከናፉ ጴጥሮሲፊ በረታን ካን በአኒ ገረ አዋልቻ ዸቀን። <verse eid="JHN 20:3"/><verse number="4" style="v" sid="JHN 20:4"/>ለቸንሳኒዩ ንፊጉ ቱረን፤ በረታን ካን ገሩ ጴጥሮስ ብረ ደርቤ ፊጉዻን ዱርሴ እዶ አዋላ ሰነ ገኤ። <verse eid="JHN 20:4"/><verse number="5" style="v" sid="JHN 20:5"/>እንስ ገድ ጄዼ እላሌ ሁጩ ቁንጬ ተልባራ ሆጄተሜ ለፈት አርጌ መሌ አዋልቸ ኬሰ ህንሴኔ። <verse eid="JHN 20:5"/><verse number="6" style="v" sid="JHN 20:6"/>ስሞን ጴጥሮስሞ እሰ ዱባን ዹፌ አዋልቸ ኬሰ ሴኔ። ሁጩ ሰነስ ለፈት አርጌ፤ <verse eid="JHN 20:6"/><verse number="7" style="v" sid="JHN 20:7"/>አከኑመስ ሁጩ መታ ዬሱስት መረሜ ቱሬ አርጌ። ሁጩን ሱንስ ኮጳሳ ደቻፈሜ እዶ ብራ ቱሬ መሌ ሁጩ ቁንጬ ተልባራ ሆጄተሜ ሰነ ብረ ህንቱሬ። <verse eid="JHN 20:7"/><verse number="8" style="v" sid="JHN 20:8"/>ኤርገሲስ በረታን ብራ እን ጀልቀበት አዋልቸ ብረ ገኤ ሱን ኬሰ ሴኔ። እንስ አርጌ አመኔ። <verse eid="JHN 20:8"/><verse number="9" style="v" sid="JHN 20:9"/>እሳን አከ ዬሱስ ወረ ዱአን ኬሳ ከኡ ከተቢ ቁልቁሉራ አመዩ ህንቤክኔ ቱሬቲ።<verse eid="JHN 20:9"/></para>
  <para style="s1">ዬሱስ ማርያም እሼ መግደላት ሙልአቴ</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 20:10"/>በረቶትን ሱንስ ገረ መነሳኒት ዴብአን።<verse eid="JHN 20:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11"/>ማርያም ገሩ አላን አዋለ ብረ ዻበቴ ቦኣ ቱርቴ። ኡቱመ ቦሱስ አዋለት ገድ ጄቴ እላልቴ፤ <verse eid="JHN 20:11"/><verse number="12" style="v" sid="JHN 20:12"/>እሼንስ ኤርገሞተ ለመ ከኔን ኡፈተ አዳዲ ኡፈተኒ እዶ ሬፍ ዬሱስ ካአሜ ቱሬ ሰነ፣ እን ቶኮ መታ ዱራን፣ ካንሞ ሚለ ጀላን ታአን አርግቴ።<verse eid="JHN 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 20:13"/>እሳንስ፣ “ዱበርቲነነ፣ ማሊፍ ቦሰ?” ጄዸኒን።</para>
  <para style="p" vid="JHN 20:13">እሼንሞ፣ “ጎፍታኮ ፉዸተኒሩ፤ ኤሰ አከ እሰ ካአንስ አን ህንቤኩ” ጄቴን። <verse eid="JHN 20:13"/><verse number="14" style="v" sid="JHN 20:14"/>ዮሙ ዋን ከነ ዱበቴ ኦፍረ ገረ ገልቴትስ ዬሱሲ አች ዻበቱ አርግቴ፤ ገሩ ዬሱስ ተኡሳ ህንቤክኔ።<verse eid="JHN 20:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 20:15"/>ዬሱስስ፣ <char style="wj">“ዱበርቲነነ፣ ማሊፍ ቦሰ? ኤኙን በርባደ?”</char> ጄዼን።</para>
  <para style="p" vid="JHN 20:15">እሼንሞ፣ ነመ እዶ ብቅልቱ ኬሰ ሆጄቱ ሴቴ፣ “ያ ጎፍታ፣ አት ዮ እሰ ፉቴ ጅራቴ፣ አከ አን ዸቄ ፉዸዹፍ ኤሰ አከ እሰ ኬሴ ነት ህም” ጄቴን።<verse eid="JHN 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16"/>ዬሱስስ፣ <char style="wj">“ማርያም!”</char> ጄዼን።</para>
  <para style="p" vid="JHN 20:16">እሼንስ እሰት ገረ ገልቴ አፋን እብራይስጢቲን፣ <char style="tl">“ረቡኒ!”</char> ጄቴን። ሂካንሳስ “በርሲሳ” ጄቹዸ።<verse eid="JHN 20:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17"/>ዬሱስሞ፣ <char style="wj">“አን አመሌ ዋን ገረ አባት ኦል ህንበእኒፍ ነ ህንቱቅን። ገሩ ኦቦሎተኮ ብረ ዸቂቲ፣ ‘አን ገረ አባኮቲፊ አባኬሰኒት፣ ገረ ዋቀኮቲፊ ዋቀኬሰኒት ኦል ነንበአ’ ጄዼረ ጄዺቲ እሳንት ህም”</char> ጄዼን።<verse eid="JHN 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18"/>ማርያም እሼን መግደላስ ገረ በረቶታ ዸቅጤ፣ “አን ጎፍታ አርጌረ!” ጄቴ። አከ እን ዋን ከነ እሼን ጄዼስ እሳንት ህምቴ።<verse eid="JHN 20:18"/></para>
  <para style="s1">ዬሱስ በረቶተሳት ሙልአቴ</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19"/>ጉያ ጀልቀበ ቶርበን ሰና ገልገለ ኡቱ በረቶትን ዋን ይሁዶተ ሶዳተኒፍ በልበለ ጩፈተኒ ወልት ቀበመኒ ጅረኑ ዬሱስ ዹፌ እሳን ግዱ ዻበቴ፣ <char style="wj">“ነጋን እስኒፍ ሃተኡ”</char> ጄዼን። <verse eid="JHN 20:19"/><verse number="20" style="v" sid="JHN 20:20"/>እንስ ኤርገ ዋን ከነ ዱበቴ ቦዴ ሀርከሳቲፊ ጭናቸሳ እሳንት አርግሲሴ። በረቶትንስ ዮሙ ጎፍታ አርገንት አከ መሌ ገመደን።<verse eid="JHN 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 20:21"/>ዬሱስ አመሌ፣ <char style="wj">“ነጋን እስኒፍ ሃተኡ! አኩመ አባን ነ ኤርጌ ሰነ አንስ እስነን ኤርገ”</char> ጄዼን። <verse eid="JHN 20:21"/><verse number="22" style="v" sid="JHN 20:22"/>እንስ ኤርገ ዋን ከነ ጄዼ ቦዴ ሀፉረ እሳንት ባፈቴ አከነ ጄዼን፤ <char style="wj">“ሀፉረ ቁልቁሉ ፉዸዻ።</char> <verse eid="JHN 20:22"/><verse number="23" style="v" sid="JHN 20:23"/><char style="wj">ዮ እስን ነሞታፍ ጩቡሳኒ ዺፍተን እሳኒፍ ንዺፈመ፤ ዮ እሳኒፍ ዺሱ ባተንሞ እሳኒፍ ህንዺፈሙ።”</char><verse eid="JHN 20:23"/></para>
  <para style="s1">ዬሱስ ቶማስት ሙልአቴ</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24"/>ገሩ ዬሮ ዬሱስ ዹፌት ወረ ኩዸ ለማን ኬሳ ቶማስ እን ድድሞስ ጄዸሙ ቶኮ በረቶተ ወጅን ህንቱሬ። <verse eid="JHN 20:24"/><verse number="25" style="v" sid="JHN 20:25"/>ከናፉ በረቶትን ወር ካን፣ “ኑ ጎፍታ አርግኔረ!” ጄዸኒ እሰት ህመን።</para>
  <para style="p" vid="JHN 20:25">እን ገሩ፣ “አን እዶ ምስማራን ወራነሜ ሀርከሳረት አርጉ መሌ፣ ቁበኮ እዶ ምስማራ ሰነ ኬሰ ካኡ መሌ፣ ሀርከኮስ ጭናቸሳ ኬሰ ካኡ መሌ ህንአመኑ” ጄዼን።<verse eid="JHN 20:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26"/>ጉያ ሰዴት ቦዴ በረቶትንሳ አመስ መነ ኬሰ ቱረን፤ ቶማስስ እሳን ወጅን ቱሬ። ኡቱመ በልበልች ጩፈሜ ጅሩስ ዬሱስ ኦል ገሌ እሳን ግዱ ዻበቴ፣ <char style="wj">“ነጋን እስኒፍ ሃተኡ!”</char> ጄዼን። <verse eid="JHN 20:26"/><verse number="27" style="v" sid="JHN 20:27"/>እንስ ቶማሲን፣ <char style="wj">“ቁበኬ አስ ፍድ፤ ሀርከኮ እላል። ሀርከኬ ድሪርፈዹቲ ጭናቸኮ ኬሰ ካእ። አመን መሌ አመንቲ ህንዸብን”</char> ጄዼ።<verse eid="JHN 20:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28"/>ቶማስሞ፣ “ጎፍታኮ! ዋቀኮ!” ጄዼን።<verse eid="JHN 20:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29"/>ዬሱስስ፣ <char style="wj">“አት ዋን ነ አርግቴፍ አመንቴ፤ ወር ኡቱ ህንአርግን አመነን ኤብፈሞዸ”</char> ጄዼን።<verse eid="JHN 20:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30"/>ዬሱስ በረቶተሳ ዱረት መለቶወን ብራ ከኔን ክታበ ከነ ኬሰት ህንበሬፈምን ሄዱ ሆጄቴ። <verse eid="JHN 20:30"/><verse number="31" style="v" sid="JHN 20:31"/>ወንቶትን ኩኔን ገሩ አከ ዬሱስ እን ክርስቶስ እልመ ዋቃ ተኤ አከ አመንተኒፍ፣ አመኑዻንስ አከ መቃሳቲን ጅሬኘ ቀባተኒፍ በሬፈሜ።<verse eid="JHN 20:31"/></para>
  <chapter eid="JHN 20"/>
  <chapter number="21" style="c" sid="JHN 21"/>
  <para style="s1">ዬሱሲፊ ድንቂ ቁርጡሚ ቀቡ</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1"/>ወንቶተ ከኔን ቦዴ ዬሱስ አመስ ገላነ ጥብርያዶስ ብረት በረቶተሳት ኦፍ ሙልእሴ። ሃል እን እቲን ኦፍ ሙልእሴስ አከነ ቱሬ፦ <verse eid="JHN 21:1"/><verse number="2" style="v" sid="JHN 21:2"/>ስሞን ጴጥሮስ፣ ቶማስ እን ድድሞስ ጄዸሙ፣ ናትናኤል ነምች ቃና ገሊላ፣ እልማን ዘብዴዎሲፊ በረቶትን ብራ ለመ ወሊ ወጅን ቱረን። <verse eid="JHN 21:2"/><verse number="3" style="v" sid="JHN 21:3"/>ስሞን ጴጥሮስስ፣ “አን ቁርጡሚ ቀቡ ነንዸቀ” እሳኒን ጄዼ፤ እሳንስ፣ “ኑስ ስ ወጅን ዸቅነ” ጄዸኒን። ገድ በአኒስ ብድሩ ያበተን፤ ሀልከን ሰነ ገሩ ሆማ ህንቀብኔ።<verse eid="JHN 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 21:4"/>ገነመ በሪዻንስ ዬሱስ ቀርቀረ ገላንቻረ ዻበቻ ቱሬ፤ በረቶትን ገሩ አከ እን ዬሱስ ተኤ ህንቤክኔ።<verse eid="JHN 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 21:5"/>እንስ እሳን ዋሜ፣ <char style="wj">“እጆሌ፣ ቁርጡሚ ቶኮሌ ህንቀብደኒ?”</char> ጄዼ ጋፈቴ።</para>
  <para style="p" vid="JHN 21:5">እሳንሞ፣ “ህንቀብኑ” ጄዸኒ ዴብሰን።<verse eid="JHN 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6"/>እንስ፣ <char style="wj">“ከራ ምርገ ብድሩቲን ክዮ ገድ ደርበዻ፤ ቁርጡሚ ንአርገቱ”</char> ጄዼን። ከናፉ እሳን ክዮ ሰነ ገድ ደርበተን፤ ሰበቢ ባይእነ ቁርጡሚቲፍስ ክዮ ሰነ ሀርክሱ ደዸበን።<verse eid="JHN 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7"/>በረታን እን ዬሱስ እሰ ጃለቻ ቱሬ ሱንስ፣ “እን ጎፍታዸ!” ጄዼ ጴጥሮስት ህሜ። ከናፉ ስሞን ጴጥሮስ ዮሙ “እን ጎፍታዸ” ጄቹሳ ዸገኤት ዋን መርጦሳ ኦፍራ ባሴ ቱሬፍ፣ መርጦሳ መርጥፈቴ ብሻንት ገድ ኡታሌ። <verse eid="JHN 21:7"/><verse number="8" style="v" sid="JHN 21:8"/>በረቶትን ካን ገሩ ዋን ቀርቀረ ገላናራ ዹንዹመ ዽበ ለመ ጫላ ህንፈጋትኒፍ ክዮ ቁርጡሚን ኬሰ ጉቴ ሰነ ሀርክሳ ብድሩዻን ዹፈን። <verse eid="JHN 21:8"/><verse number="9" style="v" sid="JHN 21:9"/>ዮሙ ለፈት በአንትስ እብደ ጭሌ ከን ቁርጡሚን እረ ጅሩፊ ቡዴነ አችት አርገን።<verse eid="JHN 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 21:10"/>ዬሱስስ፣ <char style="wj">“ሜ ቁርጡሚ አመ ቀብደንራ ዋ ፍዳ!”</char> እሳኒን ጄዼ። <verse eid="JHN 21:10"/><verse number="11" style="v" sid="JHN 21:11"/>ስሞን ጴጥሮስስ ብድሩ ሰነ ያበቴ ክዮ ቁርጡሚን ጉርጉዳን 153 ጉቴ ሰነ ገረ ለፋት ሀርክሴ። ጠጦን ሱንስ ቁርጡሚ አከስ ባይአቱን ጉተሙሌ ህንተርሳኔ። <verse eid="JHN 21:11"/><verse number="12" style="v" sid="JHN 21:12"/>ዬሱስስ፣ <char style="wj">“ኮታ ጭሬ ኛዻ!”</char> እሳኒን ጄዼ። በረቶተ ኬሳስ ነምን እጀ ጀባቴ፣ “አት ኤኙ?” ጄዼ እሰ ጋፈቴ ቶኮዩ ህንቱሬ። እሳን አከ እን ጎፍታ ተኤ ቤከኒሩቲ። <verse eid="JHN 21:12"/><verse number="13" style="v" sid="JHN 21:13"/>ዬሱስስ ዹፌ ቡዴነ ሰነ ፉዼ እሳኒፍ ኬኔ፤ ቁርጡምቸስ አከሱመ ጎዼ። <verse eid="JHN 21:13"/><verse number="14" style="v" sid="JHN 21:14"/>ኤጋ ዬሱስ ኤርገ ዱኣ ካፈሜ፣ ከነ ወጅን ዬሮ ሰደፋ በረቶተሳት ሙልአቴ።<verse eid="JHN 21:14"/></para>
  <para style="s1">ዬሱስ ጴጥሮስን ጋፊ ጋፈቴ</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15"/>ዬሱስ ኤርገ እሳን ጭሬ ኛተኒ ቦዴ ስምኦን ጴጥሮሲን፣ <char style="wj">“ያ ስሞን እልመ ዮሀንስ፣ አት ወረ ከነ ጫላ ነ ጃለታ?”</char> ጄዼ።</para>
  <para style="p" vid="JHN 21:15">እንስ፣ “ኤዬ፣ ያ ጎፍታ፤ አከ አን ስጃለዹ አቱ ንቤክተ” ጄዼን።</para>
  <para style="p" vid="JHN 21:15">ዬሱስስ፣ <char style="wj">“እልሞሌ ሆላኮ ሶር”</char> ጄዼን።<verse eid="JHN 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 21:16"/>ዬሱስ አመሌ፣ <char style="wj">“ያ ስሞን እልመ ዮሀንስ፣ አት ነ ጃለታ?”</char> ጄዼን።</para>
  <para style="p" vid="JHN 21:16">እንስ ዴብሴ፣ “ኤዬ፣ ያ ጎፍታ፣ አከ አን ስጃለዹ አቱ ንቤክተ” ጄዼን።</para>
  <para style="p" vid="JHN 21:16">ዬሱስሞ፣ <char style="wj">“ሆሎተኮ ትክስ”</char> ጄዼን።<verse eid="JHN 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 21:17"/>ዬሮ ሰደፋስ፣ <char style="wj">“ያ ስሞን እልመ ዮሀንስ፣ አት ነ ጃለታ?”</char> ጄዼን።</para>
  <para style="p" vid="JHN 21:17">ጴጥሮስስ ሰበቢ ዬሱስ ዬሮ ሰደፋ፣ <char style="wj">“አት ነ ጃለታ?”</char> ጄዼ እሰ ጋፈቴፍ ገዴ፣ “ያ ጎፍታ፣ አት ዋን ሁንደ ቤክተ፤ አከ አን ስጃለዹስ ንቤክተ” ጄዼን።</para>
  <para style="p" vid="JHN 21:17">ዬሱስስ አከነ ጄዼን፤ <char style="wj">“ሆሎተኮ ሶር።</char> <verse eid="JHN 21:17"/><verse number="18" style="v" sid="JHN 21:18"/><char style="wj">አን ዹጉመ፣ ዹጉመ ስት ነንህመ፤ አት ዬሮ ደርገጌሰ ቱርቴት፣ ኦፉመኬቲን ሙዺኬ ህዸቴ ለፈ በርባዴ ዸቅጠ ቱርቴ፤ ዬሮ ዱሎምቱት ገሩ ሀርከኬ ንድሪርፈተ፤ ነምን ብራስ ሙዺኬ ሲፍ ህዼ ለፈ አት ህንበርባድኔት ስ ጌሰ።”</char> <verse eid="JHN 21:18"/><verse number="19" style="v" sid="JHN 21:19"/>ዬሱስስ አከ ጴጥሮስ ዱአ አከሚቲን ዋቀ ኡልፌሱ አርግሲሱፍ ጄዼ ዋን ከነ ዱበቴ፤ ኤርገሲ፣ <char style="wj">“ነ ዱካ ቡእ”</char> ጄዼን።<verse eid="JHN 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20"/>ጴጥሮስስ ገረገሌ ኡቱ በረታን እን ዬሱስ እሰ ጃለቱ ሱን እሳን ዱካ ቡኡ አርጌ። በረታን ኩንስ እሰ ዬሮ እርባታት ቆመ ዬሱስት እርከቴ፣ “ያ ጎፍታ፣ እን ደበርሴ ስኬኑ ኤኙ?” ጄዼ ሰናዸ። <verse eid="JHN 21:20"/><verse number="21" style="v" sid="JHN 21:21"/>ጴጥሮስስ ዮሙ እሰ አርጌት፣ “ያ ጎፍታ፣ ነምች ኩንሆ?” ጄዼ ዬሱስን ጋፈቴ።<verse eid="JHN 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22"/>ዬሱስስ ዴብሴ፣ <char style="wj">“ሀመ አን ዹፉት አከ እን ጅራቱ ዮ ፌዺኮ ተኤ፣ ማልቱ ስዽቤ? አት ነ ዱካ ቡእ”</char> ጄዼን። <verse eid="JHN 21:22"/><verse number="23" style="v" sid="JHN 21:23"/>ከናፍ ኦዱን፣ “በረታን ኩን ህንዱኡ” ጄዹ ኦቦሎተ ግዱት ኦዴፈሜ። ዬሱስ ገሩ፣ <char style="wj">“ሀመ አን ዹፉት አከ እን ጅራቱ ዮ ፌዺኮ ተኤ ማልቱ ስዽቤ?”</char> ጄዼ መሌ፣ <char style="wj">“እን ህንዱኡ”</char> ህንጄኔ።<verse eid="JHN 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24"/>እን ዱቢ ከነ ዹጋ በኡ፣ ከን ዋን ከነስ በሬሴ በረታዹመ ከነ። አከ ዹገ በኡምስሳ ዹጋ ተኤስ ኑ ቤክነ።<verse eid="JHN 21:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25"/>ከነ መሌስ ዬሱስ ዋን ብራ ባይኤ ሆጄቴረ። ኡቱ ቶኮን ቶኮንሳኒ በሬፈመኒ ጅራተኒ ስላ አን ዋን አዱኛን መታንሼዩ ክታቦተ በሬፈመን ሰናፍ እዶ ገኡ ቀብዱ ህንሴኡ።<verse eid="JHN 21:25"/></para>
  <chapter eid="JHN 21"/>
</usx>
