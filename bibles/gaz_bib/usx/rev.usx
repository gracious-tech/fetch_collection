<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="REV" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">ሙልአተ</para>
  <para style="toc1">ሙልአተ ዮሀንስ</para>
  <para style="toc2">ሙልአተ</para>
  <para style="toc3">ሙል</para>
  <para style="mt1">ሙልአተ</para>
  <para style="mt2">ዮሀንስ</para>
  <chapter number="1" style="c" sid="REV 1"/>
  <para style="s1">ሴንሰ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1"/>ኩን ሙልአተ ዬሱስ ክርስቶስ፣ ከን አከ እን ዋን ዽኦት ተኡ ቀቡ ገርቦተሳት አርግሲሱፍ ጄዼ ዋቅን እሳፍ ኬኔዸ። እንስ ኤርገማሳ ገረ ገርብቸሳ ዮሀንስት ኤርጌ አከ ሙልአትን ሱን ቤከሙ ጎዼ፤ <verse eid="REV 1:1"/><verse number="2" style="v" sid="REV 1:2"/>ዮሀንስ እሰ ዋን አርጌ ሁንዱማ ጄቹንስ ዱቢ ዋቃቲፊ ዹገ በኡምሰ ዬሱስ ክርስቶስ ዹጋ በኡዸ። <verse eid="REV 1:2"/><verse number="3" style="v" sid="REV 1:3"/>ነምን ዱቢ ራጂ ከነ ዱብሱ ኤብፈማዸ፤ ወር ዋን ራጂ ሰነ ኬሰት በሬፈሜ ዸገአኒ ኤገንስ ኤብፈሞዸ፤ በርች ዽኣቴራቲ።<verse eid="REV 1:3"/></para>
  <para style="b"/>
  <para style="s1">ነጋ ጋፈቹፊ ዋቀ ገለቴፈቹ</para>
  <para style="po">
    <verse number="4" style="v" sid="REV 1:4"/>ዮሀንስራ።</para>
  <para style="po" vid="REV 1:4">ገረ ወልዶተ ክርስታና ከኔን ብየ አስያ ኬሰ ጅረን ቶርበኒት፤</para>
  <para style="po" vid="REV 1:4">እሰ ጅሩ፣ እሰ ቱሬ፣ እሰ ዹፉፍ ጅሩፊ ሀፉሮተ ቶርበን ፉለ ቴሶሳ ዱረ ጅረንራ፣ <verse eid="REV 1:4"/><verse number="5" style="v" sid="REV 1:5"/>አከሱመስ ዬሱስ ክርስቶስ ዹገ ባቱ አመነማ፣ ሀንገፈ ወረ ዱአኒቲፊ ቡልቻ ሞቶተ ለፋ ተኤ ሰነራ አያኒፊ ነጋን እስኒፍ ሃተኡ።</para>
  <para style="b" vid="REV 1:5"/>
  <para style="p" vid="REV 1:5">እሰ ኑ ጃለቱፊ እሰ ዺገሳቲን ጩቡኬኘራ ብልሰ ኑ ባሴ፣ <verse eid="REV 1:5"/><verse number="6" style="v" sid="REV 1:6"/>እሰ አከ ኑ ዋቀሳቲፊ አባሳ ተጃጅሉፍ ሞቱማፊ ሉቦተ ኑ ታስሴ ሰናፍ ኡልፍኒፊ ሁምን በረ በራ ሀመ በረ በራት ሃተኡ! አሜን።<verse eid="REV 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 1:7"/>“ኩኖ፣ እን ዱሜሰ ወጅን ዹፈ፤<note caller="+" style="f"><char style="fr" closed="false">1፥7 </char><char style="ft" closed="false"><char style="xt"><ref loc="DAN 7:13">ዳን 7፥13</ref></char></char></note></para>
  <para style="q2" vid="REV 1:7">እጅ ሁንድኑ፣</para>
  <para style="q1" vid="REV 1:7">ወር እሰ ወራነንዩ እሰ ንአርጉ፤”</para>
  <para style="q2" vid="REV 1:7">ሰቦትን ለፋ ሁንድኑስ “ሰበቢሳቲፍ ንወዋቱ።”<note caller="+" style="f"><char style="fr" closed="false">1፥7 </char><char style="ft" closed="false"><char style="xt"><ref loc="ZEC 12:10">ዘካ 12፥10</ref></char></char></note></para>
  <para style="qc" vid="REV 1:7">አከሱመ ተአ! አሜን።<verse eid="REV 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 1:8"/>ዋቅን ጎፍታን ዋን ሁንደ ደንደኡ፣ “አን አልፋፊ ኦሜጋዸ፤ እሰ ጅሩ፣ እሰ ቱሬፊ እሰ ዹፉፍ ጅሩዸ” ጄዸ።<verse eid="REV 1:8"/></para>
  <para style="b"/>
  <para style="s1">ዮሀንስ ሙልአታን ክርስቶስን አርጉሳ</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 1:9"/>አን ኦቦሌስኬሰን ዮሀንስ ዽጵነ ኬሰት፣ ሞቱማፊ ኦብሰ ዬሱስ ክርስቶስ ኬሰትስ እስን ወጅን ከን ህርማዹ ሰበቢ ዱቢ ዋቃቲፊ ሰበቢ ዹገ በኡምሰ ዬሱስ ክርስቶሲፍ ፍጥሞ ብየ ብሻን ግዱ እረን ቱሬ። <verse eid="REV 1:9"/><verse number="10" style="v" sid="REV 1:10"/>አንስ ጉያ ጎፍታት ሀፉራንን ቱሬ፤ ዱግደኮ ዱባንስ ሰገሌ ጉዳ አከ መለከታ ቶኮ ነንዸገኤ፤ <verse eid="REV 1:10"/><verse number="11" style="v" sid="REV 1:11"/>ሰገሌን ሱንስ፣ <char style="wj">“ዋን አርግቱ ክታበ መረማረት በሬሲቲ ገረ ወልዶተ ክርስታና ቶርበኒት ጄቹንስ ኤፌሶንት፣ ሰምርኔስት፣ ጴርጋሞንት፣ ትያትራ፣ ሰርዴስት፣ ፊልድልፍያቲፊ ሎዶቅያት ኤርግ”</char> ጄዼ።<verse eid="REV 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 1:12"/>አንስ ሰገሌ ነት ዱበቻ ቱሬ ሰነ እላሉፍ ጄዼን ኦፍረ ገረ ገሌ። አን ዮሙን ኦፍረ ገረ ገሌት ባቱወን እብሳ ከኔን ወርቄራ ሆጄተመን ቶርበ ነንአርጌ፤ <verse eid="REV 1:12"/><verse number="13" style="v" sid="REV 1:13"/>ባቱወን እብሳ ሰነ ግዱስ ከን፣ “እልመ ነማ ፈካቱ”<note caller="+" style="f" category="dup"> <char style="fr" closed="false">1፥13 </char><char style="ft" closed="false"><char style="xt"><ref loc="DAN 7:13">ዳን 7፥13</ref></char></char></note> ቶኮቱ ቱሬ፤ እንስ ኡፈተ ዼራ ሚለ ገኡ ኡፈቴ፣ ናኖ ቆመሳትሞ ሰበተ ወርቄ ህዸቴ ቱሬ። <verse eid="REV 1:13"/><verse number="14" style="v" sid="REV 1:14"/>መታንሳቲፊ ርፌንስ መታሳ አዲ አከ ሬፌንሰ ሆላ፣ አዲ አከ ጨቢ ቱሬ፤ እጅሳስ አከ አረበ እብዳ ቱርቴ። <verse eid="REV 1:14"/><verse number="15" style="v" sid="REV 1:15"/>ሚልሳስ ናሲ ቦለ እብዳ ኬሰት ዲሜፈሜ ፈካተ ቱሬ፤ ሰገሌንሳሞ አኩመ ሰገሌ ብሻን ባይኤት። <verse eid="REV 1:15"/><verse number="16" style="v" sid="REV 1:16"/>ሀርከሳ ምርጋቲን ኡርጂወን ቶርበ ቀበቴ ቱሬ፤ አፋንሳ ኬሳስ ጎራዴ ቀረ ለመ ቀቡቱ በኣ ቱሬ። ፉልሳስ ቢፍቱ ሁምነ ጉቱን እፍቱ ፈካተ ቱሬ።<verse eid="REV 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 1:17"/>አን ዮሙን እሰ አርጌት አከ ነመ ዱኤ ሚለሳ ጀለትን ኩፌ። እንሞ ሀርከሳ ምርጋ ነረ ካኤ አከነ ናን ጄዼ፦ <char style="wj">“ህንሶዳትን። አን ከን ጀልቀባቲፊ ከን ዹማት።</char> <verse eid="REV 1:17"/><verse number="18" style="v" sid="REV 1:18"/><char style="wj">እሰ ጅራታዸስ፤ አን ዱኤን ቱሬ፤ ኩኖ፣ በረ በራ ሀመ በረ በራት ነንጅራዸ! ፉርቱ ዱኣቲፊ ከን ሲኦልስ ቀበ።</char><verse eid="REV 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 1:19"/>
    <char style="wj">“ከናፉ አት ዋን አርግቴ፣ ዋን አመ ጅሩፊ ዋን ገረ ፉልዱራት ተኡ በሬስ።</char> <verse eid="REV 1:19"/><verse number="20" style="v" sid="REV 1:20"/><char style="wj">እጪቲን ኡርጂወን ቶርባ ከኔን አት ሀርከኮ ምርጋ ኬሰት አርግቴቲፊ ባቱወን እብሳ ከኔን ወርቄራ ሆጄተመን ቶርበኒ እሰ ከነ፦ ኡርጂወን ቶርበን ኤርገሞተ ወልዳ ክርስታና ቶርባት፤ ባቱወን እብሳ ቶርበንሞ ወልዶተ ክርስታና ቶርበኒዸ።</char><verse eid="REV 1:20"/></para>
  <chapter eid="REV 1"/>
  <chapter number="2" style="c" sid="REV 2"/>
  <para style="s1">ገረ ወልዳ ክርስታና ኤፌሶንት</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 2:1"/>
    <char style="wj">“ኤርገማ ዋቃ ከን ወልዳ ክርስታና ኤፌሶንት</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">2፥1 </char>
      <char style="fq" closed="false">ኤፌሶንት </char>
      <char style="ft" closed="false">– ኤፌሶን መጋላ ጉዶፊ ቤከምቱ ብየ አስያት፤ አስያንሞ ብየ ሮማ ኬሰት አርገምት። እሼንስ ቡፈተ ዶኒ (ሆቦሎ) ከን ሆጂን እት ባይአቱፊ ከን ደልደላን በዻቴዸ፤ ዊርቱ ፈልፈለ ዋቅቲ አርጤምስ (<char style="xt"><ref loc="ACT 19:27">ሆጂ 19፥27</ref>፣<ref loc="ACT 19:35">35</ref></char> እላላ) አከሱመስ ለፈ ሆጂን ፈልፈላ እት ሆጄተሙ ቱርቴ (<char style="xt"><ref loc="ACT 19:19">ሆጂ 19፥19</ref></char>)።</char>
    </note> <char style="wj">አከነ ጄዺ በሬስ፦</char></para>
  <para style="b" vid="REV 2:1"/>
  <para style="pi1" vid="REV 2:1">
    <char style="wj">እን ኡርጂወን ቶርበ ሀርከሳ ምርጋት ቀበቴ ባቱወን እብሳ ከኔን ወርቄራ ሆጄተመን ግዱ ዴዴብኡ ሱን አከነ ጄዸ።</char><verse eid="REV 2:1"/></para>
  <para style="b"/>
  <para style="pi1">
    <verse number="2" style="v" sid="REV 2:2"/>
    <char style="wj">አን ሆጂኬ፣ ደዸቢኬቲፊ ኦብሳን ዻበቹኬ ቤከ። አከ አት ጨልእፍቴ ነሞተ ሀሞ ህንዺፍኔ፣ ወረ ኡቱ ኤርገሞተ ህንተእን ኤርገሞተ ኦፊን ጄዸን ቆርቴ አከ እሳን ሶብዱ ተአን ምርከኔስቴስ ነንቤከ።</char> <verse eid="REV 2:2"/><verse number="3" style="v" sid="REV 2:3"/><char style="wj">አት መቃኮቲፍ ጄቴ ኦብሳን ዻበቴርተ፤ ረክነ ኦብስቴርተ፤ ህንደዸብኔስ።</char> <verse eid="REV 2:3"/><verse number="4" style="v" sid="REV 2:4"/><char style="wj">ተኡስ ጃለለኬ እሰ ጀልቀባ ዺሱኬቲፍ አን ዋን ስራ ጅቡ ጥኖ ቀበ።</char> <verse eid="REV 2:4"/><verse number="5" style="v" sid="REV 2:5"/><char style="wj">ከናፍ አት ማልራ አከ ኩፍቴ ያደዹ! ቀልቢ ጅጂረዹቲ ሆጂኬ ከን ዱራ ሰነ ሆጄዹ። ዮ አት ቀልቢ ጅጂረቹ ባቴሞ አን ስትን ዹፈ፤ ባቱ እብሳኬቲስ እዶሳቲ ነንፉዸ።</char> <verse eid="REV 2:5"/><verse number="6" style="v" sid="REV 2:6"/><char style="wj">ገሩ ዋን ጋሪ ቶኮ ቀብደ፦ ሆጂ ኒቆላዎታ ከን አን ጅቡ ሰነ አትስ ንጅብተ።</char> <verse eid="REV 2:6"/><verse number="7" style="v" sid="REV 2:7"/><char style="wj">ነምን ጉረ ቀቡ ዋን ሀፉር ወልዶተ ክርስታናቲን ጄዹ ሃዸገኡ። ነመ ሞአቱ አከ እን ሙከ ጅሬኛ ከን ጀነተ ዋቃ ኬሰ ጅሩራ ኛቱፍ ምርገ ነንኬናፍ።</char><verse eid="REV 2:7"/></para>
  <para style="s1">ገረ ወልዳ ክርስታና ሰምርኔስት</para>
  <para style="p">
    <verse number="8" style="v" sid="REV 2:8"/>
    <char style="wj">“ኤርገማ ዋቃ ከን ወልዳ ክርስታና ሰምርኔስት</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">2፥8 </char>
      <char style="fq" closed="false">ሰምርኔስት </char>
      <char style="ft" closed="false">– ሰምርኔስ (አመ እስሚር) መጋላ ዱሬቲፊ ቡፈተ ዶኒ ከን ይሁዶትን ሄዱን ኬሰ ጅራተን ቱርቴ። ሰምርኔስ መነ ቁልቁሉማ ሞፋ (ዱለቸ) ቶኮ ዋቅቲ ሮማቲፍ ቀብድ ቱርቴ፤ እን ሃራንሞ ሞትቸ ጥባርዮሲፍ ኬነሜ።</char>
    </note> <char style="wj">አከነ ጄዺ በሬስ፦</char></para>
  <para style="b" vid="REV 2:8"/>
  <para style="pi1" vid="REV 2:8">
    <char style="wj">እን ጀልቀባቲፊ እን ዹማ፣ እን ዱኤ ቱሬፊ አመሞ ጅራታ ተኤ ሱን አከነ ጄዸ።</char><verse eid="REV 2:8"/></para>
  <para style="b"/>
  <para style="pi1">
    <verse number="9" style="v" sid="REV 2:9"/>
    <char style="wj">አን ረክናፊ ህዩማኬ ቤከ፤ ተኡስ አት ሶሬሰ! አረብሶ ወረ ኡቱ ይሁዶተ ህንተእን ይሁዶተ ኦፊን ጄዸን ሰናስ ነንቤከ፤ እሳን ገሩ ወልዳ ሴጠናት።</char> <verse eid="REV 2:9"/><verse number="10" style="v" sid="REV 2:10"/><char style="wj">ዽጵነ ስረ ገኡፍ ጅሩ ህንሶዳትን። ኩኖ፣ አከ ቆረምተኒፍ ዲያብሎስ እስን ኬሳ ነሞተ ቶኮ ቶኮ መነ ህዻት ንገልቸ። ጉያ ኩዸንስ ንዽጰቱ። አት ሀመ ዱኣት አመነማ ተእ፤ አን ጎንፎ ጅሬኛ ሲፍን ኬናቲ።</char> <verse eid="REV 2:10"/><verse number="11" style="v" sid="REV 2:11"/><char style="wj">ነምን ጉረ ቀቡ ዋን ሀፉር ወልዶተ ክርስታናቲን ጄዹ ሃዸገኡ። ነምን ሞአቱ ዱአ ለመፋን ህንሚዸሙ።</char><verse eid="REV 2:11"/></para>
  <para style="s1">ገረ ወልዳ ክርስታና ጴርጋሞንት</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 2:12"/>
    <char style="wj">“ኤርገማ ዋቃ ከን ወልዳ ክርስታና ጴርጋሞንት</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">2፥12 </char>
      <char style="fq" closed="false">ጴርጋሞንት </char>
      <char style="ft" closed="false">– መኔን ቁልቁሉማ ከኔን ዋቄፈትና ዝያሲቲፊ ዋቆተ ብራ ወረ አከ አስቄሌጶሲቲፍ ኬነመን ቀብድ ቱርቴ። አስቄሌጶስስ ዋቀ ቶልፈማ ነመ ፈይሱዸ። ጴርጋሞንስ ሀንዹረ ሞቶትን ሮማ እት ዋቄፈተን ቱርቴ። እሼንስ መጋላ ኩታ ብየ ሰና ኬሳ እዶ ጀልቀበት መን ቁልቁሉማ አዉግስጦስ ዋቅቻፊ ዋቅቲ ሮማ ጄዸምቱፍ እት ኬነሜዸ።</char>
    </note> <char style="wj">አከነ ጄዺ በሬስ፦</char></para>
  <para style="b" vid="REV 2:12"/>
  <para style="pi1" vid="REV 2:12">
    <char style="wj">እን ጎራዴ ቀረማ አፋን ለማ ቀቡ ሱን አከነ ጄዸ።</char><verse eid="REV 2:12"/></para>
  <para style="b"/>
  <para style="pi1">
    <verse number="13" style="v" sid="REV 2:13"/>
    <char style="wj">አን እዶ አት ጅራቱ ቤከ፤ እንስ እዶ ቴሶን ሴጠና ጅሩዸ። ተኡስ አት መቃኮ ጀቤስቴ ቀበቴርተ። በረ አንቲጳስ ዹገ ባቱንኮ አመነማን መጋላኬሰን ኬሰት እዶ ሴጠን ጅራቱት አጄፈሜሌ አት አመንቲ ነረት ቀብዱ ህንዺፍኔ።</char> <verse eid="REV 2:13"/><verse number="14" style="v" sid="REV 2:14"/><char style="wj">ሃተኡ መሌ ሰበቢ አት ነሞተ በርሲሰ በለኣም</char><note caller="+" style="f"><char style="fr" closed="false">2፥14 </char><char style="fq" closed="false">በርሲሰ በለኣም </char><char style="ft" closed="false">– በለኣም ፈልፈልቱ ባብሎን ከን ባላቅ ሞትች አከ እን ሰበ እስራኤል አባሩፍ ቀጠሬዸ። አከ ሴረ <char style="xt"><ref loc="NUM 31:16">ለኮ 31፥16</ref></char> እረት ዱበተሜት ጎርስ በለኣም አከ ሰብን እስራኤል ዋቆተ ቶልፈሞ ዋቄፈቱፊ አከ ኤጀ ራወቱፍ ከራራ ጀልእሴ (<char style="xt"><ref loc="NUM 25:1-3">ለኮ 25፥1‑3</ref></char>)።</char></note> <char style="wj">ዱካ ቡአን አቺ ቀብዱፍ አን ዋን ስራ ጅቡ ጥኖ ቀበ፤ ነምን አከ እን ሰበ እስራኤል ዱረ ጉፉ ካኤ አከ እሳን ኛተ ዋቆተ ቶልፈሞፍ ኣርሳ ዽኤፈሜ ኛተኒፊ አከ እሳን ሀለሉማዻን ጅራተን ጎዹፍ ጄዼ ባላቅን በርሲሴ በለኣም ቱሬቲ።</char> <verse eid="REV 2:14"/><verse number="15" style="v" sid="REV 2:15"/><char style="wj">አከሱመስ ነሞተ በርሲሰ ኒቆላዎታ ዱካ ቡአን ቶኮ ቶኮ ኦፍ ብራ ቀብደ።</char> <verse eid="REV 2:15"/><verse number="16" style="v" sid="REV 2:16"/><char style="wj">ከናፉ ቀልቢ ጅጂረዹ! ዮ ከና አቺ አን ደፌን ስት ዹፈ፤ ጎራዴ አፋንኮቲቲንስ ጀረ ሰነ ነንሎለ።</char> <verse eid="REV 2:16"/><verse number="17" style="v" sid="REV 2:17"/><char style="wj">ነምን ጉረ ቀቡ ዋን ሀፉር ወልዶተ ክርስታናቲን ጄዹ ሃዸገኡ። ነመ ሞአቱፍ መና ዾክፈሜራ ነንኬነ። አከሱመስ ዸጋ አዲ መቃን ሃራን እረት በሬፈሜ ቶኮ ነንኬናፍ፤ መቃ ሰነስ ነምቸ እሰ ፉዸቱ ሰነ መሌ ነምን ቶኮዩ ህንቤኩ።</char><verse eid="REV 2:17"/></para>
  <para style="s1">ገረ ወልዳ ክርስታነ ትያጥሮንት</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 2:18"/>
    <char style="wj">“ኤርገማ ዋቃ ከን ወልዳ ክርስታና ትያትራት</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">2፥18 </char>
      <char style="fq" closed="false">ትያትራት </char>
      <char style="ft" closed="false">– ትያጥሮን ዊርቱ እንዱስትሪ ቱርቴ። እንዱስትሮተ ትያጥሮን ጉርጉዶ ኬሳስ ቶኮ ሆጂንሳ ቀለሚ ድቡፊ ኡፈተ ሱፊ ሆዹዸ (<char style="xt"><ref loc="ACT 16:14">ሆጂ 16፥14</ref></char>)።</char>
    </note> <char style="wj">አከነ ጄዺ በሬስ፦</char></para>
  <para style="b" vid="REV 2:18"/>
  <para style="pi1" vid="REV 2:18">
    <char style="wj">እልም ዋቃ እን እጅሳ አረበ እብዳ ፈካቱ፣ ከን ሚልሳሞ ናሲ በቅፈሜ ቁልቁሌፈሜ ፈካቱ ሱን አከነ ጄዸ።</char><verse eid="REV 2:18"/></para>
  <para style="b"/>
  <para style="pi1">
    <verse number="19" style="v" sid="REV 2:19"/>
    <char style="wj">አን ሆጂኬ፣ ጃለላፊ አመንቲኬ፣ ተጃጅላፊ ኦብሳን ዻበቹኬ ቤከ፤ አከሱመስ አከ ሆጂንኬ እን አማ ኩን እሰ ዱራ ጫሉ ነንቤከ።</char> <verse eid="REV 2:19"/><verse number="20" style="v" sid="REV 2:20"/><char style="wj">ሃተኡ መሌ ሰበቢ አት ዱበርትቲ ራጂ ኦፊን ጄቱ ኢዛቤልን ጨልእፍቴ እላልቱፍ አን ዋን ስራ ጅቡ ጥኖ ቀበ። እሼንስ በርሲሰሼቲን ተጃጅልቶተኮ ጎዎምስቴ አከ እሳን ሀለሉማ ሆጄተኒፊ አከ እሳን ኛተ ዋቆተ ቶልፈሞፍ ኣርሳ ዽኤፈሜ ኛተን ጎት።</char> <verse eid="REV 2:20"/><verse number="21" style="v" sid="REV 2:21"/><char style="wj">አን አከ እሼን ሀለሉማሼራ ቀልቢ ጅጂረቱፍ ዬሮ ኬኔፊን ቱሬ፤ እሼን ገሩ ንድዴ።</char> <verse eid="REV 2:21"/><verse number="22" style="v" sid="REV 2:22"/><char style="wj">ከናፉ አን ስሬ ዽጵናረት እሼ ነንገተ፤ ወረ እሼ ወጅን ኤጀንስ ዮ እሳን ከራሼራ ቀልቢ ጅጂረቹ ባተን ረክነ ጉዳ ኬሰ እሳን ነንቡሰ።</char> <verse eid="REV 2:22"/><verse number="23" style="v" sid="REV 2:23"/><char style="wj">እጆሌሼሞ ዸእቻን ነንአጄሰ። ወልዶትን ክርስታና ሁንድኑስ አከ አን ከሌፊ ኦኔ ቆሩ ንቤኩ፤ አንስ ቶኮ ቶኮኬሰኒፍ አኩመ ሆጂኬሰኒት ገቲኬሰን እስኒ ነንኬነ።</char> <verse eid="REV 2:23"/><verse number="24" style="v" sid="REV 2:24"/><char style="wj">እስን ወረ ትያትራ ኬሰ ጅራተን ከኔን በርሲሰሼ ዱካ ህንቡእኒፊ ወረ በርሲሰ ሴጠና ከን ዾክሳ ገድ ፈጎ ጄዸሙ ሰነ ህንበረትኒን አከነ ነንጄዸ፤ ‘አን በኣ ብራ እስንት ህንፌኡ፤</char> <verse eid="REV 2:24"/><verse number="25" style="v" sid="REV 2:25"/><char style="wj">እስን ገሩ ሀመ አን ዹፉት ዋን ቀብደን ሰነ ጀቤሳ ቀበዻ።’</char> <verse eid="REV 2:25"/><verse number="26" style="v" sid="REV 2:26"/><char style="wj">አን ነመ ሞአቱፍ፣ ከን ሀመ ዹማትስ ፌዺኮ ጉቱፍ ሰቦተረት ታይታ ነንኬነ።</char> <verse eid="REV 2:26"/><verse number="27" style="v" sid="REV 2:27"/><char style="wj">‘እን ቦኩ ስቢላቲን እሳን ቡልቸ፤ አኩመ ቆዳ ሱጴትስ</char><note caller="+" style="f"><char style="fr" closed="false">2፥27 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 2:9">ፋር 2፥9</ref></char></char></note> <char style="wj">እሳን ሁሬሰ፤’ ኩንስ አኩመ አን እት አባኮ ብራ ታይታ አርገዼ ሰናን።</char> <verse eid="REV 2:27"/><verse number="28" style="v" sid="REV 2:28"/><char style="wj">አንሞ በከልቸ በሪ ነንኬናፍ።</char> <verse eid="REV 2:28"/><verse number="29" style="v" sid="REV 2:29"/><char style="wj">ነምን ጉረ ቀቡ ዋን ሀፉር ወልዶተ ክርስታናቲን ጄዹ ሃዸገኡ።</char><verse eid="REV 2:29"/></para>
  <chapter eid="REV 2"/>
  <chapter number="3" style="c" sid="REV 3"/>
  <para style="s1">ገረ ወልዳ ክርስታና ሰርዴስት</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1"/>
    <char style="wj">“ኤርገማ ዋቃ ከን ወልዳ ክርስታና ሰርዴስት</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">3፥1 </char>
      <char style="fq" closed="false">ሰርዴስት </char>
      <char style="ft" closed="false">– ሰርዴስ መጋላ ጉዶ ሞቱማ ሊድያ ከን ዱሪ ቱርቴ። እሼንስ መጋላ ዱሬቲ ዊርቱ እንዱስትሪ ቤከምቱ እዶ ኡፈትን ሱፊፊ ምኦትን ቀለሚ ድበመን እት ሆጄተመን ቱርቴ፤ ተኡስ መጋለቲን ኩን ሶቺ ለፋ ከን በረ 17 (በረ አራራ) ኬሰ ተኤፊ ወራነ ገራ ገራቲን ሞአተምቴ ገድ ዴብቴርት።</char>
    </note> <char style="wj">አከነ ጄዺ በሬስ፦</char></para>
  <para style="b" vid="REV 3:1"/>
  <para style="pi1" vid="REV 3:1">
    <char style="wj">እን ሀፉሮተ ዋቃ ቶርባፊ ኡርጂወን ቶርበ ቀቡ ሱን አከነ ጄዸ።</char></para>
  <para style="b" vid="REV 3:1"/>
  <para style="pi1" vid="REV 3:1">
    <char style="wj">አን ሆጂኬ ቤከ፤ አት መቁማፍ ጅርተ መሌ ዱቴርተ።</char> <verse eid="REV 3:1"/><verse number="2" style="v" sid="REV 3:2"/><char style="wj">ደመቅ! አን ፉለ ዋቀኮቲ ዱረት ሆጂንኬ ጉቱ ተኡሳ ህንአርግኔቲ ዋን ዱኡ ገኤ ሰነ ጀጀቤስ።</char> <verse eid="REV 3:2"/><verse number="3" style="v" sid="REV 3:3"/><char style="wj">ከናፉ ዋን ፉዸቴፊ ዋን ዸጌሴ ያደዹ፤ ዋን ዸጌሴ ሰናፍ አጀጀም፤ ቀልቢስ ጅጂረዹ። ዮ አት ደመቁ ባቴ ገሩ አን አኩመ ሀቱት ስት ነንዹፈ፤ ሰኣቲ ከምት አከ አን ስት ዹፉስ አት ህንቤክቱ።</char> <verse eid="REV 3:3"/><verse number="4" style="v" sid="REV 3:4"/><char style="wj">ተኡዩ አት ነሞተ ኡፈተሳኒ ህንጡሬስን ሙራሰ ሰርዴስ ኬሳ ቀብደ። እሳንስ ኡፈተ አዳዲ ኡፈተኒ ነ ወጅን ንዴሙ፤ እሳን ከናፍ ወረ መለኒዸ።</char> <verse eid="REV 3:4"/><verse number="5" style="v" sid="REV 3:5"/><char style="wj">ነምን ሞኡ አኩመ እሳኒ ኡፈተ አዳዲ ንኡፈተ። አንስ መቃሳ ክታበ ጅሬኛ ኬሳ ጎንኩማ ህንሀቁ፤ ፉለ አባኮቲፊ ኤርገሞተሳ ዱረትስ መቃሳ ነንቤክስሰ።</char> <verse eid="REV 3:5"/><verse number="6" style="v" sid="REV 3:6"/><char style="wj">ነምን ጉረ ቀቡ ዋን ሀፉር ወልዶተ ክርስታናቲን ጄዹ ሃዸገኡ።</char><verse eid="REV 3:6"/></para>
  <para style="s1">ገረ ወልዳ ክርስታና ፊልድልፍያት</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7"/>
    <char style="wj">“ኤርገማ ዋቃ ከን ወልዳ ክርስታና ፊልድልፍያት</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">3፥7 </char>
      <char style="fq" closed="false">ፊልድልፍያት </char>
      <char style="ft" closed="false">– ፊልድልፍያን ዊርቱ ደልደላ ከን ሆጂ ጎጋቲፊ ጅርቢቲን ቤከምቴ፣ ከን ለፈ ቆቲሳ በዻዻሳቲን መርፈምቴዸ፤ ገሩ ሶቺ ለፋቲፍ ሳጥለምቱዸ።</char>
    </note> <char style="wj">አከነ ጄዺ በሬስ፦</char></para>
  <para style="b" vid="REV 3:7"/>
  <para style="pi1" vid="REV 3:7">
    <char style="wj">እን ቁልቁሉን፣ እን ዹጋን፣ እን ፉርቱ ዳዊት ሀርከሳቲ ቀቡ፣ ከን ዋን እን በኑ ኤኙዩ ጩፉ ህንደንዴኜፊ ዋን እን ጩፉስ ኤኙዩ በኑ ህንደንዴኜ ሱን አከነ ጄዸ።</char><verse eid="REV 3:7"/></para>
  <para style="b"/>
  <para style="pi1">
    <verse number="8" style="v" sid="REV 3:8"/>
    <char style="wj">አን ሆጂኬ ቤከ። ኩኖ፣ አን በልበለ በነማ ነምን ጩፉ ህንደንዴኜ ቶኮ ፉለኬ ዱረ ካኤረ። አከ አት ሁምነ ጥኖ ቀብዱስ ቤከ፤ ተኡስ ዱቢኮ ኤግዴርተ፤ መቃኮስ ህንገኔ።</char> <verse eid="REV 3:8"/><verse number="9" style="v" sid="REV 3:9"/><char style="wj">ኩኖ፣ አን ወረ ወልዳ ሴጠና ተአን ከኔን ኡቱ ይሁዶተ ህንተእን ይሁዶተ ኦፊን ጄዸኒ ሶበን ኬሳ ቶኮ ቶኮ አከ እሳን ዹፈኒ ሚለኬረት ኩፈኒ ሰገደኒፊ አከ እሳን አከ አን ስ ጃለዼ ቤከን ነንጎዸ።</char> <verse eid="REV 3:9"/><verse number="10" style="v" sid="REV 3:10"/><char style="wj">አጀጀ አን አከ አት ኦብሳን ዻበቱፍ ሲፍ ኬኔ ሰነ ዋን ኤግዴፍ፣ አንስ ሰኣቲ ቆሩምሳ ከን ወረ ለፈረ ጅራተን ቆሩፍ አዱኛ ጉቱት ዹፉፍ ጅሩ ሰነራ ስ ኦልቸ።</char> <verse eid="REV 3:10"/><verse number="11" style="v" sid="REV 3:11"/><char style="wj">አን ደፌን ዹፈ። አትስ አከ ነምን ቶኮዩ ጎንፎኬ ህንፉዸትኔፍ ዋን ቀብዱ ጀቤሲ ቀበዹ።</char> <verse eid="REV 3:11"/><verse number="12" style="v" sid="REV 3:12"/><char style="wj">ነመ ሞአቱስ መነ ቁልቁሉማ ዋቀኮ ኬሰት ኡቱባ ነንጎዸ። እንስ አች ኬሳ ጎንኩማ ህንበኡ። አንስ መቃ ዋቀኮቲፊ መቃ መጋላ ዋቀኮ፣ መቃ ዬሩሳሌም እሼ ሃራ፣ እሼ ዋቀኮ ብራ ሰሚራ ገድ ቡቱ ሰና እሰረት ነንበሬሰ፤ መቃኮ ሃራስ እሰረት ነንበሬሰ።</char> <verse eid="REV 3:12"/><verse number="13" style="v" sid="REV 3:13"/><char style="wj">ነምን ጉረ ቀቡ ዋን ሀፉር ወልዶተ ክርስታናቲን ጄዹ ሃዸገኡ።</char><verse eid="REV 3:13"/></para>
  <para style="s1">ገረ ወልዳ ክርስታና ሎዶቅያት</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 3:14"/>
    <char style="wj">“ኤርገማ ዋቃ ከን ወልዳ ክርስታና ሎዶቅያት</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">3፥14 </char>
      <char style="fq" closed="false">ሎዶቅያት </char>
      <char style="ft" closed="false">– ሎዶቅያን መጋላ ዱሮምቱፊ መጋላ ደልደላ ከን ጉደቻ ጅርቱ ቱርቴ። እሼንስ እዶ ጅሬኘ ሆጄቶተ ምአ ሱፊ ብየ ሰናራ ሆጄተሜ ቱርቴ። ምእ ሱፊ ኩንስ ጉራቸ ጩሉሉቃ ተኡሳቲን ቤከማ ቱሬ። አከሱመስ መጋለቲን ዊርቱ ሆጂ ባንኪቲፊ እዶ አስቄሌጶስ ዋቅች ቶልፈማን እት ዋቄፈተሙ ቱርቴ።</char>
    </note> <char style="wj">አከነ ጄዺ በሬስ፦</char></para>
  <para style="b" vid="REV 3:14"/>
  <para style="pi1" vid="REV 3:14">
    <char style="wj">አሜን፣ እን አመነማን፣ ዹገ ባቱን ዹጋቲፊ ጀልቀባን ኡመመ ዋቃ ሱን አከነ ጄዸ።</char><verse eid="REV 3:14"/></para>
  <para style="b"/>
  <para style="pi1">
    <verse number="15" style="v" sid="REV 3:15"/>
    <char style="wj">አከ አት ቀበናኣ ዮካን ሆኣ ህንተእን አን ሆጂኬ ቤከ! አን ኡቱ አት ቀበናኣ ዮካን ሆኣ ታቴ ስላ ነንሀወ ቱሬ።</char> <verse eid="REV 3:15"/><verse number="16" style="v" sid="REV 3:16"/><char style="wj">ከናፉ አት ዋን ለጲ</char><note caller="+" style="f"><char style="fr" closed="false">3፥16 </char><char style="fq" closed="false">ለጲ </char><char style="ft" closed="false">– ሎዶቅያ ብረ ቡርቃወን ሆኣ ብሻኖትንሳኒ ፈጎ ዴመንቱ ቱሬ። ብሻን ኩንስ ለጲ (ቡሉቆ) ተኤ ኤርገሲ ቅሌ (ሀለያ) ፉለ ሎዶቅያ ዱራት ዸንገለአ ቱሬ። ብሻን ሱንስ ዹኩበ ነመት ፍደ ቱሬ።</char></note> <char style="wj">ታቴፍ፣ ሆኣ ዮካን ቀበናኣ ዋን ህንተእኒፍ አን አፋንኮቲ ስቱፉ ገኤረ።</char> <verse eid="REV 3:16"/><verse number="17" style="v" sid="REV 3:17"/><char style="wj">አት፣ ‘አን ሶሬሰ፤ ቀቤኘ አርገዼረ፤ ወን ነ በርባችሱ ቶኮዩ ህንጅሩ’ ጄተ። ገሩ አት ዴጋ፣ ረከታ፣ ህዬሰ፣ ጃማፊ ቁላ ተኡኬ ህንቤክቱ።</char> <verse eid="REV 3:17"/><verse number="18" style="v" sid="REV 3:18"/><char style="wj">ከናፉ አት አከ ሶሮምቱፍ፣ ወርቄ እብዳን ቁልቁሌፈሜ አከ ነራ ብተቱ፣ አከ ቁላኬ ቃኔሳ ሰነ ሀጉገቱፍስ ኡፈተ አዲ ኡፈቱ አከ ነራ ብተቱ፣ አከ አርጉ ደንዴሱፍሞ ኩሊ እጀት ነቀቱ አከ ነራ ብተቱ ስን ጎርሰ።</char> <verse eid="REV 3:18"/><verse number="19" style="v" sid="REV 3:19"/><char style="wj">አን ወረን ጃለዹ ነንእፈዸ፤ ነንአደበስ። ከናፉ ጀባዹ፤ ቀልቢ ጅጂረዹስ።</char> <verse eid="REV 3:19"/><verse number="20" style="v" sid="REV 3:20"/><char style="wj">ኩኖ፣ አን በልበለ ዱረ ዻበዼን በልበለ ሩሩኩተ። ዮ ነምን ከምዩ ሰገሌኮ ዸገኤ በልበለ ናፍ በኔ፣ አን ኦል ሴኔ እሰ ወጅን እርባተ ነንኛዸ፤ እንስ ነ ወጅን ንኛተ።</char> <verse eid="REV 3:20"/><verse number="21" style="v" sid="REV 3:21"/><char style="wj">አኩመ አን ሞአዼ አባኮ ወጅን ቴሶሳረ ታኤ ሰነ፣ ነምን ሞአቱስ አከ እን ነ ወጅን ቴሶኮረ ታኡፍ ምርገ ነንኬናፍ።</char> <verse eid="REV 3:21"/><verse number="22" style="v" sid="REV 3:22"/><char style="wj">ነምን ጉረ ቀቡ ዋን ሀፉር ወልዶተ ክርስታናቲን ጄዹ ሃዸገኡ።”</char><verse eid="REV 3:22"/></para>
  <chapter eid="REV 3"/>
  <chapter number="4" style="c" sid="REV 4"/>
  <para style="s1">ቴሶ ሰሚ ኬሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1"/>አንስ ኤርገሲ ነንእላሌ፤ ኩኖ በልበለ በነማን ቶኮ ፉለኮ ዱረ ሰሚ ኬሰ ቱሬ። ሰገሌን ጀልቀባ ከን አን ኡቱ እን አከ መለከታት ነት ዱበቱ ዸገኤ ሱን፣ <char style="wj">“አስ ኦል ኮቱ፤ አንስ ዋን አሲን ቦዴ ተኡ ቀቡ ስትን አርግሲሳ”</char> ጄዼ። <verse eid="REV 4:1"/><verse number="2" style="v" sid="REV 4:2"/>አንስ ዮሙሱመ ሀፉራነን ቱሬ፤ ኩኖ፣ ቴሶን ነምን ቶኮረ ታኤ ቶኮ ሰሚ ኬሰ ቱሬ። <verse eid="REV 4:2"/><verse number="3" style="v" sid="REV 4:3"/>እን አች ታኤስ ዸጋ ገቲ ጉዳ ያስጲዲቲፊ<note caller="+" style="f"><char style="fr" closed="false">4፥3 </char><char style="fq" closed="false">ያስጲዲቲ </char><char style="ft" closed="false">– ዸጋ ገቲ ጉዳ ከን ዬሮ ባይኤ መገሪሰ ተኤዸ። ብፈ ኬሎ (ዳለቸ)፣ መጋለ ዮካን ዲማ ቀባቹ ደንደአ።</char></note> ሰርድዮን<note caller="+" style="f"><char style="fr" closed="false">4፥3 </char><char style="fq" closed="false">ሰርድዮን </char><char style="ft" closed="false">– ዸጋ ገቲ ጉዳ ከን ዬሮ ባይኤ ዲመቱዸ።</char></note> ፈካተ ቱሬ። ናኖ ቴሶ ሰናስ ሰበተ ዋቃ ከን ብፍንሳ ዸጋ መረግድ<note caller="+" style="f"><char style="fr" closed="false">4፥3 </char><char style="fq" closed="false">መረግድ </char><char style="ft" closed="false">– ዸጋ ገቲ ጉዳ ከን መገሪሰ ተኤዸ።</char></note> ፈካቱቱ ቱሬ። <verse eid="REV 4:3"/><verse number="4" style="v" sid="REV 4:4"/>ናኖ ቴሶ ሰናስ ቴሶወን ብራ ድግደሚ አፉርቱ ቱሬ። ቴሶወን ሰነረስ ማንጉዶትን ድግደሚ አፉር ኡፈተ አዳዲ ኡፈተኒ፣ መታሳኒትሞ ጎንፎ ወርቄ ካአተኒ ተታአኒ ቱረን። <verse eid="REV 4:4"/><verse number="5" style="v" sid="REV 4:5"/>ቴሶ ሰነ ኬሳስ እፍን በለቄ ንሙልአቴ፤ ከከዌፊ ሰገሌን ንዸገአሜ። ቴሶ ሰነ ፉልዱረትስ ጉጭ ቶርበ ቦበኣ ቱሬ። እሳን ኩኔንስ ሀፉሮተ ዋቃ ቶርበኒዸ። <verse eid="REV 4:5"/><verse number="6" style="v" sid="REV 4:6"/>አከሱመስ ወን ገላነ ብልሌ ፈካቱ ከን አከ ኦፍ እላሌ ቁልቁላኤ ቶኮ ቴሶ ሰነ ፉልዱረ ቱሬ።</para>
  <para style="p" vid="REV 4:6">ወለካ ናኖ ቴሶ ሰናስ ኡመመወን ሉቡ ቀቤዪ አፉርቱ ቱሬ፤ እሳንስ ዱራፊ ዱባን እጃን ጉተመኒ ቱረን። <verse eid="REV 4:6"/><verse number="7" style="v" sid="REV 4:7"/>ኡመምን ሉቡ<note caller="+" style="f"><char style="fr" closed="false">4፥7 </char><char style="ft" closed="false"><char style="xt"><ref loc="EZK 1:10">ህስ 1፥10</ref></char></char></note> ቀቤስ ጀልቀባ ሌንጨ፣ እን ለመፋን ሰንጋ ፈካተ ቱሬ፤ እን ሰደፋን ፉለ አከ ፉለ ነማ ቀበ ቱሬ፤ አፉረፋንሞ ርሳ<note caller="+" style="f"><char style="fr" closed="false">4፥7 </char><char style="fq" closed="false">ርሳ </char><char style="ft" closed="false">– (ሌንጨ፣ ሰንጋ፣ ነመ፣ ርሳ) አፍረንሳኒዩ ቶኩማዻን ጉቱማ ኡመመወን ሉቡ ቀቤዪ ቶኮ ተአኒ ዋቀ ገለቴፈተን ሰና እዶ ቡኡ።</char></note> በርሱ ፈካተ ቱሬ። <verse eid="REV 4:7"/><verse number="8" style="v" sid="REV 4:8"/>ቶኮን ቶኮን ኡመመወን ሉቡ ቀቤዪ አፍረኒ ቆቾ ጀአ ጀአ ቀቡ ቱረን፤ ዱብንሳኒቲፊ ኬስሳኒስ እጃን ጉተሜ ቱሬ። እሳንስ ኡቱ ኣረ ህንገልፈትን ሀልከኒ ጉያ፣</para>
  <para style="qc" vid="REV 4:8">“ ‘ዋቅን ጎፍታን ዋን ሁንደ ደንደኡ’<note caller="+" style="f"><char style="fr" closed="false">4፥8 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 6:3">እሳ 6፥3</ref></char></char></note></para>
  <para style="qc" vid="REV 4:8">እን ቱሬ፣ እን ጅሩፊ እን ዹፉፍ ጅሩ፣</para>
  <para style="qc" vid="REV 4:8">‘ቁልቁሉ፣ ቁልቁሉ፣ ቁልቁሉዸ’ ”</para>
  <para style="m" vid="REV 4:8">ጄዸኒ ፋርፈቹ ህንዺሰን። <verse eid="REV 4:8"/><verse number="9" style="v" sid="REV 4:9"/>ኡመመወን ሉቡ ቀቤዪን ሱን እሰ ቴሶረ ታኤ ጅሩ ከን በረ በራ ሀመ በረ በራት ጅራቱ ሰናፍ ኡልፍነ፣ ከበጃፊ ገለተ ዮሙ ኬነንት፣ <verse eid="REV 4:9"/><verse number="10" style="v" sid="REV 4:10"/>ማንጉዶትን ድግደሚ አፍረን ሱንስ ፉለ እሰ ቴሶረ ታኤ ጅሩ ሰና ዱረት ኩፈኒ እሰ በረ በራ ሀመ በረ በራት ጅራቱ ሰናፍ ንሰገደን። ጎንፎወንሳኒስ ፉለ ቴሶ ሰና ዱረ ከካአኒ አከነ ጄዹ፦<verse eid="REV 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 4:11"/>“ያ ጎፍታፊ ዋቀኬኘ፣</para>
  <para style="q2" vid="REV 4:11">አት ዋን ሁንደ ዋን ኡምቴፍ፣</para>
  <para style="q1" vid="REV 4:11">እሳን ፌዺኬቲን ዋን ኡመመኒፍ፣</para>
  <para style="q2" vid="REV 4:11">ዋን ጅራተኒፍስ፣</para>
  <para style="q2" vid="REV 4:11">ኡልፍነ፣ ከበጃፊ ሁምነ ፉዸቹን ሲፍ ንመለ።”<verse eid="REV 4:11"/></para>
  <chapter eid="REV 4"/>
  <chapter number="5" style="c" sid="REV 5"/>
  <para style="s1">ክታበ መረማፊ ሆላ ቀለሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 5:1"/>አንስ ሀርከ ምርገ እሰ ቴሶረ ታኤ ሰናረት ክታበ መረማ ኬሳፊ ዱባን እት በሬፈሜ ቻፓ ቶርባን ጩፈሜ ቶኮ ነንአርጌ። <verse eid="REV 5:1"/><verse number="2" style="v" sid="REV 5:2"/>አንስ ኤርገማ ዋቃ እሰ ጀባ ሰገሌ ጉዳዻን፣ “ቻፓ ሂኩን፣ ክታበ መረማስ በኑን ከን መሉፍ ኤኙ እን?” ጄዼ ለብሱ ቶኮ ነንአርጌ። <verse eid="REV 5:2"/><verse number="3" style="v" sid="REV 5:3"/>ገሩ ነምን ቶኮዩ ሰሚ ኬሳ ዮካን ለፈራ ዮካን ለፈ ጀላ ክታበ መረማ በኑ ዮካን ኬሰሳዩ እላሉ ህንደንዴኜ። <verse eid="REV 5:3"/><verse number="4" style="v" sid="REV 5:4"/>አንስ ዋን ነምን ክታበ መረማ በኑን ዮካን ኬሰሳ እላሉን መሉፍ ቶኮዩ ዸበሜፍ ባይእሴ ነንቦኤ። <verse eid="REV 5:4"/><verse number="5" style="v" sid="REV 5:5"/>ኤርገሲስ ማንጉዶተ ሰነ ኬሳ እን ቶኮ፣ “ህንቦእን! ኩኖ፣ ሌንጭ ጎሰ ይሁዳ፣ ህድ ዳዊት ሞአቴረ። እን ክታብቸ መረማ በኑ፣ ቻፓሳ ቶርበኑስ ሂኩ ንደንደአ” ናን ጄዼ።<verse eid="REV 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 5:6"/>አንስ ሆላ ዋን ቀለሜ ፈካቴ ቴሶ ወለካ ኡመመወን ሉቡ ቀቤዪ አፍረኒፊ ማንጉዶታን መርፈሜ ዻበቱ ቶኮ አርጌ። ሆልችስ ጋንፈ ቶርባፊ እጀ ቶርበ<note caller="+" style="f"><char style="fr" closed="false">5፥6 </char><char style="fq" closed="false">ጋንፈ ቶርባፊ እጀ ቶርበ </char><char style="ft" closed="false">– ክታበ ቁልቁሉ ኬሰት ጋፍን ፈኬኘ ጀብናቲፊ ሁምናት። “ጋንፍ ቶርበ” ሁምነ አከ መሌ ጉዳ አርግሲሰ፤ እጅሞ ደንዴቲ ዋቅን እቲን ዋን ሁንደ አርጉፊ ቤኩ አርግሲሰ።</char></note> ቀበ ቱሬ፤ እጅ ቶርበን ኩኔንስ ሀፉሮተ ዋቃ ከኔን ገረ ለፈ ሁንዳት ኤርገመን ቶርበኒዸ። <verse eid="REV 5:6"/><verse number="7" style="v" sid="REV 5:7"/>እንስ ዹፌ ሀርከ ምርጋ እሰ ቴሶረ ታኤ ጅሩ ሰናራ ክታበ መረማ ፉዸቴ። <verse eid="REV 5:7"/><verse number="8" style="v" sid="REV 5:8"/>ዮሙ እን ክታበ መረማ ሰነ ፉዸቴትስ ኡመመወን ሉቡ ቀቤዪ አፍረኒፊ ማንጉዶትን ድግደሚ አፍረን ፉለ ሆልቻ ዱረት ኩፈን። ቶኮን ቶኮንሳኒ በገና ቀቡ ቱረን፤ እሳንስ ምአ እጣና ከን ወርቄራ ሆጄተሜፊ ከን እጣን ኬሰ ጉቴ ሀርካ ቀቡ ቱረን፤ እጣን ኩንስ ከዸትና ቁልቁሎታት። <verse eid="REV 5:8"/><verse number="9" style="v" sid="REV 5:9"/>እሳንስ አከነ ጄዸኒ ፋርፈትና ሃራ ፋርፈተን፤</para>
  <para style="q1" vid="REV 5:9">“ክታበ መረማ ፉዹን፣</para>
  <para style="q2" vid="REV 5:9">ቻፓ ክታብቸ መረማስ ሂኩን ሲፍ መለ፤</para>
  <para style="q1" vid="REV 5:9">ሰበቢንሳስ አት ቀለምቴ፣ ጎሰ ሁንዱማ ኬሳ፣</para>
  <para style="q2" vid="REV 5:9">አፋን ሁንደ ኬሳ፣ ሰበ ሁንደ ኬሳ፣</para>
  <para style="q2" vid="REV 5:9">ሰኚ ሁንደ ኬሳ፣ ነሞተ ዺገኬቲን ዋቃፍ ብቴርታቲ።<verse eid="REV 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 5:10"/>አከ እሳን ሞቱማፊ ሉቦተ ዋቀኬኛ ተአንስ ጎቴርተ፤</para>
  <para style="q2" vid="REV 5:10">እሳንስ ለፈረት ንሞኡ።”<verse eid="REV 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11"/>አንስ እላሌ ሰገሌ ኤርገሞተ ባይኤ ዸገኤ፤ ባይእንሳኒስ ኩማተማፊ ኩመ ኩማተመ ቱሬ። እሳንስ ቴሶ ሰነት፣ ኡመመወን ሉቡ ቀቤዪፊ ማንጉዶተት ናነአኒ ቱረን። <verse eid="REV 5:11"/><verse number="12" style="v" sid="REV 5:12"/>እሳንስ አከነ ጄዸኒ ሰገሌ ጉዳዻን ፋርፈተን፤</para>
  <para style="q1" vid="REV 5:12">“ሆላ ቀለሜ ሰናፍ፣</para>
  <para style="q2" vid="REV 5:12">ሁምናፊ ቀቤኘ፣ ኦጉማፊ ጀብነ፣</para>
  <para style="q2" vid="REV 5:12">ከበጃፊ ኡልፍነ፣ ገለተስ አርገቹን ንመለ!”<verse eid="REV 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 5:13"/>አንስ ኤርገሲ ኡመምን ሰሚ ኬሰ ጅሩ፣ ከን ለፈረ ጅሩ፣ ከን ለፈ ጀለ ጅሩፊ ከን ገላነ ኬሰ ጅሩ ሁንድ፣ ኡመምን እሳን ኬሰ ጅሩ ሁንድኑስ፣</para>
  <para style="q1" vid="REV 5:13">“እሰ ቴሶረ ታኡ ሰናፊ ሆልቻፍ፣</para>
  <para style="q2" vid="REV 5:13">ገለትኒፊ ከበጅን፣ ኡልፍኒፊ ሁምን፣</para>
  <para style="qc" vid="REV 5:13">በረ በራ ሀመ በረ በራት ሃተኡ!”</para>
  <para style="m" vid="REV 5:13">ጄዸኒ ኡቱ ፋርፈተኑ ነንዸገኤ። <verse eid="REV 5:13"/><verse number="14" style="v" sid="REV 5:14"/>ኡመመወን ሉቡ ቀቤዪን አፍረን፣ “አሜን” ጄዸን፤ ማንጉዶትንስ ኩፈኒ ሰገደን።<verse eid="REV 5:14"/></para>
  <chapter eid="REV 5"/>
  <chapter number="6" style="c" sid="REV 6"/>
  <para style="s1">ቻፓወን ቶርበ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 6:1"/>አንስ ዮሙ ሆልች ቻፓወን ቶርበን ኬሳ እሰ ጀልቀባ በኑ ነንአርጌ። ኤርገሲስ ኡመመወን ሉቡ ቀቤዪ ኬሳ እን ቶኮ ሰገሌ አከ ከከዌቲን፣ “ኮቱ!” ጄቹሳ ነንዸገኤ። <verse eid="REV 6:1"/><verse number="2" style="v" sid="REV 6:2"/>አንስ ነንእላሌ፤ ኩኖ፣ ፈርድ አዲን<note caller="+" style="f"><char style="fr" closed="false">6፥2 </char><char style="fq" closed="false">ፈርድ አዲን </char><char style="ft" closed="false">– ፈኬኘ ቦጁፊ ሞአትናት።</char></note> ቶኮ ፉለኮ ዱረ ቱሬ! እን ፈርደ ሰነ ያበቴስ እዳ ሀርከት ቀበቴ ቱሬ፤ ጎንፎንስ ንኬነሜፍ፤ እንስ ሞአቻ፣ አመስ ሞአቹፍ በኤ።<verse eid="REV 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3"/>ዮሙ ሆልች ቻፓ ለመፋ በኔትስ ኡመምን ጅራታን እን ለመፋን፣ “ኮቱ!” ጄቹሳ ነንዸገኤ። <verse eid="REV 6:3"/><verse number="4" style="v" sid="REV 6:4"/>ፈርድ ብራ ዳማን<note caller="+" style="f"><char style="fr" closed="false">6፥4 </char><char style="fq" closed="false">ዳማን </char><char style="ft" closed="false">– ብፈ እብዳ ከን ወራነ ቆፈ ኡቱ ህንተእን አከ ቀለሙንስ ወራነ ኬሰ ጅሩ አርግሲሱዸ።</char></note> ቶኮስ ንዹፌ። እሰ ፈርድቸ ያበቱፍስ አከ እን ነጋ ለፈራ በሌሱፊ አከ ነሞትን ወል ጎረአን አከ ጎዹፍ ሁምን ኬነሜፍ፤ ጎራዴን ጉዳን ቶኮስ ንኬነሜፍ።<verse eid="REV 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5"/>ዮሙ ሆልች ቻፓ ሰደፋ በኔትስ ኡመምን ጅራታን እን ሰደፋን፣ “ኮቱ!” ጄቹሳ ነንዸገኤ፤ ነንእላሌስ፤ ኩኖ፣ ፈርድ ጉራች<note caller="+" style="f"><char style="fr" closed="false">6፥5 </char><char style="fq" closed="false">ፈርድ ጉራች </char><char style="ft" closed="false">– ኩን ፈኬኘ ቤላ ጄቹንስ ዱአ ቤል ፍዱዸ።</char></note> ቶኮ ፉለኮ ዱረ ቱሬ! እን ፈርድቸ ያበቱስ መዳሊ ኦፍ ሀርካ ቀበ ቱሬ። <verse eid="REV 6:5"/><verse number="6" style="v" sid="REV 6:6"/>አንስ ዋን አከ ሰገሌ ኡመመወን ሉቡ ቀቤዪ አፍረን ግዱ ዱበተሜ ፈካቱ ቶኮ፣ “ቀመዲን ሰፈርቱ ቶኮ ምንዳ ጉያ ቶኮቲፍ፣ ገርቡን ሰፈርቱ ሰዲስ ምንዳ ጉያ ቶኮቲፍ ሃተኡ፤ ገሩ ዘይቲፊ ዳዺ ወይኒ ህንሚዽን!” ጄቹሳ ነንዸገኤ።<verse eid="REV 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7"/>ዮሙ ሆልች ቻፓ አፉረፋ በኔት ሰገሌ ኡመመ ጅራታ አፉረፋ ከን፣ “ኮቱ!” ጄዹ ነንዸገኤ። <verse eid="REV 6:7"/><verse number="8" style="v" sid="REV 6:8"/>አንስ ነንእላሌ፤ ኩኖ፣ ፈርድ ዳለች ቶኮ ፉለኮ ዱረ ቱሬ! እን ፈርድቸ ያበቱስ መቃንሳ ዱአ ጄዸመ ቱሬ፤ ሲኦልስ ዱግደ ዱባን እት ዽኣቴ እሰ ዱካ ቡኣ ቱሬ። እሳንስ ጎራዴን፣ ቤላን፣ በላፊ ብኔንሶተ ለፋቲን አከ አጄሰኒፍ ኩርማነ ለፋረት ሁምን ንኬነሜፍ።<verse eid="REV 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 6:9"/>ዮሙ እን ቻፓ ሸነፋ በኔት አን እዶ ኣርሳ ጀለት ሉቡወን ወረ ሰበቢ ዱቢ ዋቃቲፊ ሰበቢ ዹገ በኡምሰ ኤገን ሰናቲፍ ጎረአመኒ ንአርጌ። <verse eid="REV 6:9"/><verse number="10" style="v" sid="REV 6:10"/>እሳንስ ሰገሌ ጉዳዻን፣ “ያ ጎፍታ ዋን ሁንዳ ኦሊ፣ ቁልቁልቻፊ ዹጋ፣ አት ወረ ለፈረ ጅራተንት ኡቱ ህንሙርን ሀመ ዮሚት ቱርተ? ሀመ ዮሚትስ ዺገኬኛፍ ሃሎ ህንባቱ?” ጄዸኒ እየን። <verse eid="REV 6:10"/><verse number="11" style="v" sid="REV 6:11"/>ቶኮ ቶኮሳኒቲፍስ ኡፈትን አዳዲን ንኬነሜ፤ ሀመ ለኮብስ ወረ እሳን ወጅን ተጃጅለኒቲፊ ለኮብስ ኦቦሎተሳኒ ከኔን አኩመ እሳኒት አጄፈሙፍ ጅረን ሰና ጉተሙት አከ ዬሮ ጥኖ ኦብሰን እሳንት ህመሜ።<verse eid="REV 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12"/>ዮሙ እን ቻፓ ጀአፋ በኔትስ ነንአርጌ። ሶቺ ለፋ ጉዳ ቶኮቱ ቱሬ። አዱን አከ ኡፈተ ገዳ ጉራቾፍቴ፤ ጂንስ አኩመ ዺጋ ዲመቴ፤ <verse eid="REV 6:12"/><verse number="13" style="v" sid="REV 6:13"/>ኡርጂወን ሰሚስ አኩመ እጅ ሙከ ሀርቡ ዮሙ ቅሌንሰ ጀባን ራፈሙት ሀርጨኡ ሰነ ለፈት ገድ ሀርጨአን። <verse eid="REV 6:13"/><verse number="14" style="v" sid="REV 6:14"/>ሰሚን አኩመ ክታበ መረማት መረሜ፤ ቱሉፊ ለፍት ብሻን ግዱስ እዶሳኒቲ ቡቅፈመን።<verse eid="REV 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 6:15"/>ሞቶትን ለፈራ፣ ቡልችቶትኒፊ አቦቲን ዱላ፣ ሶሬዪፊ ነሞትን ጀጀቦን፣ ነሞትን ካን ሁንድ፣ ገርበስ ተኡ ብርመዱን ሆልቀ ኬሳፊ ከታወን ቱሉወኒ ግዱት ዾከተን። <verse eid="REV 6:15"/><verse number="16" style="v" sid="REV 6:16"/>እሳንስ ቱሉወኒፊ ከታወን ዋመተኒ አከነ ጄዹ፤ “ኑረት ኩፋ፤ ፉለ እሰ ቴሶረ ታኡ ሰናቲፊ ዼከምሰ ሆልቻ ዱራ ኑ ዾክሳ! <verse eid="REV 6:16"/><verse number="17" style="v" sid="REV 6:17"/>ጉያን ዼከምሰሳ ጉዳን ሱን ገኤራቲ፤ ኤጋ ኤኙቱ ጉያ ሰነ ዱረ ዻበቹ ደንደአሬ?”<verse eid="REV 6:17"/></para>
  <chapter eid="REV 6"/>
  <chapter number="7" style="c" sid="REV 7"/>
  <para style="s1">ነሞትን 144,000 ቻፔፈመን</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1"/>ኤርገሲስ አን ኡቱ ኤርገሞትን አፉር ጎሌ ለፋ አፍረንረ ዻበተኒ አከ ቡቤን ለፈት ዮካን ገላነት ዮካን ሙከ ከምትዩ ህንቡብፍኔ ቡቤ ለፋ አፍረን ዾወኑ ነንአርጌ። <verse eid="REV 7:1"/><verse number="2" style="v" sid="REV 7:2"/>ኤርገማን ቻፓ ዋቀ ጅራታ ቀቡ ካንሞ ኡቱ ከራ በአ ቢፍቱቲን ኦል በኡ ነንአርጌ። እንስ ኤርገሞተ አፍረን አከ እሳን ለፋፊ ገላነ ሚዸኒፍ ሁምን ኬነሜፍ ሰነ ሰገሌ ጉዳዻን ዋሜ፣ <verse eid="REV 7:2"/><verse number="3" style="v" sid="REV 7:3"/>“ሀመ ኑ አደ ተጃጅልቶተ ዋቀኬኛረት ቻፓ ጎኑት ለፈ ዮካን ገላነ ዮካን ሙከ ህንሚዽና” ጄዼ። <verse eid="REV 7:3"/><verse number="4" style="v" sid="REV 7:4"/>አንስ ባይእነ ወረ ቻፔፈመኒ ዸገኤ፦ ጎሰ እስራኤል ሁንደ ኬሳ 144,000 ቱሬ።<verse eid="REV 7:4"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="5" style="v" sid="REV 7:5"/>ጎሰ ይሁዳ ኬሳ 12,000፣</para>
  <para style="li1" vid="REV 7:5">ጎሰ ሩቤን ኬሳ 12,000፣</para>
  <para style="li1" vid="REV 7:5">ጎሰ ጋድ ኬሳ 12,000፣<verse eid="REV 7:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="REV 7:6"/>ጎሰ አሴር ኬሳ 12,000፣</para>
  <para style="li1" vid="REV 7:6">ጎሰ ንፍታሌም ኬሳ 12,000፣</para>
  <para style="li1" vid="REV 7:6">ጎሰ ምናሴ ኬሳ 12,000፣<verse eid="REV 7:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="REV 7:7"/>ጎሰ ስምኦን ኬሳ 12,000፣</para>
  <para style="li1" vid="REV 7:7">ጎሰ ሌዊ ኬሳ 12,000፣</para>
  <para style="li1" vid="REV 7:7">ጎሰ ይሳኮር ኬሳ 12,000፣<verse eid="REV 7:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="REV 7:8"/>ጎሰ ዜቡሎን ኬሳ 12,000፣</para>
  <para style="li1" vid="REV 7:8">ጎሰ ዮሴፍ ኬሳ 12,000፣</para>
  <para style="li1" vid="REV 7:8">ጎሰ ቤንያም ኬሳ 12,000 ቱረን።<verse eid="REV 7:8"/></para>
  <para style="s1">ቱተ ነሞተ ኡፈተ አዳዲ ኡፈተኒ</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 7:9"/>አንስ ከነ ቦዴ ነንእላሌ፤ ኩኖ፣ ቱትን ጉዳን ነምን ቶኮዩ ለካኡ ህንደንዴኜ ከን ሰበ ሁንዱማ፣ ጎሰ ሁንዱማ፣ ነመ ሁንዱማፊ አፋን ሁንዱማ ኬሳ ወልት ቀበሜ ቶኮ ቴሶ ሰነ ዱራፊ ፉለ ሆልቻ ዱረ ዻበቴ ቱሬ። እሳንስ ኡፈተ አዳዲ ኡፈተኒ፣ ደሜ ሜጢስ ሀርከት ቀበተኒ ቱረን። <verse eid="REV 7:9"/><verse number="10" style="v" sid="REV 7:10"/>እሳንስ ሰገሌ ጉዳዻን፣</para>
  <para style="q1" vid="REV 7:10">“ፈይን ከን ዋቀኬኘ</para>
  <para style="q1" vid="REV 7:10">እሰ ቴሶረ ታኡቲፊ</para>
  <para style="q1" vid="REV 7:10">ከን ሆልቻት”</para>
  <para style="m" vid="REV 7:10">ጄዸኒ እየን። <verse eid="REV 7:10"/><verse number="11" style="v" sid="REV 7:11"/>ኤርገሞትን ሁንድኑ ቴስቸት፣ ማንጉዶታፊ ኡመመወን ሉቡ ቀቤዪ አፍረንት ናነአኒ ዸዻበቻ ቱረን። እሳንስ አደሳኒቲን ፉለ ቴሶ ሰና ዱረት ጎምብፈመኒ ዋቃፍ ሰገደን፤ <verse eid="REV 7:11"/><verse number="12" style="v" sid="REV 7:12"/>አከነስ ጄዸን፦</para>
  <para style="q1" vid="REV 7:12">“አሜን!</para>
  <para style="q1" vid="REV 7:12">ኤቢፊ ኡልፍን፣ ኦጉማን፣ ገለን፣</para>
  <para style="q1" vid="REV 7:12">ከበጅን፣ ሁምኒፊ ጀብን፣</para>
  <para style="q1" vid="REV 7:12">በረ በራ ሀመ በረ በራት</para>
  <para style="q1" vid="REV 7:12">ዋቀኬኛፍ ሃተኡ።</para>
  <para style="q1" vid="REV 7:12">አሜን!”<verse eid="REV 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13"/>ማንጉዶተ ኬሳስ እን ቶኮ፣ “ወር ኡፈተ አዳዲ ኡፈተን ኩኔን ኤኙ ፈእ? ኤሳ ዹፈን?” ጄዼ ነ ጋፈቴ።<verse eid="REV 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 7:14"/>አንስ፣ “ያ ጎፍታ፣ ስቱ ቤከ” ጄዼን ዴብሴፍ።</para>
  <para style="p" vid="REV 7:14">እንሞ አከነ ናን ጄዼ፤ “እሳን ኩኔን ወረ ዽጵነ ጉዳ ኬሳ በአኒ ዹፈኒዸ፤ እሳንስ ዺገ ሆልቻቲን ኡፈተሳኒ ሚጨተኒ አዴፈተኒሩ። <verse eid="REV 7:14"/><verse number="15" style="v" sid="REV 7:15"/>ከናፉ፣</para>
  <para style="q1" vid="REV 7:15">“እሳን ቴሶ ዋቃ ዱረ ጅሩ፤</para>
  <para style="q2" vid="REV 7:15">ሀልከኒ ጉያስ መነ ቁልቁሉማሳ <optbreak/> ኬሰት እሰ ተጃጅሉ፤</para>
  <para style="q1" vid="REV 7:15">እን ቴስቸረ ታኤ ጅሩ ሱንስ</para>
  <para style="q2" vid="REV 7:15">እሳን ግዱ ጅራተ።<verse eid="REV 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="REV 7:16"/>‘እሳንስ ስአች ጎንኩማ ህንቤለአን፤</para>
  <para style="q2" vid="REV 7:16">ስአችስ ጎንኩማ ህንዼቦተን።</para>
  <para style="q1" vid="REV 7:16">አዱን እሳን ህንዸኡ፤’<note caller="+" style="f"><char style="fr" closed="false">7፥16 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 49:10">እሳ 49፥10</ref></char></char></note></para>
  <para style="q2" vid="REV 7:16">ሆእ ፍኒናንስ እሳን ህንጉቡ።<verse eid="REV 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="REV 7:17"/>ሆልች ወለካ ቴሶ ሰና ጅሩ</para>
  <para style="q2" vid="REV 7:17">ትክሴሳኒ ንተኣቲ፤</para>
  <para style="q1" vid="REV 7:17">‘እን ገረ ቡርቃ ብሻን ጅሬኛት እሳን ጌሰ።’</para>
  <para style="q2" vid="REV 7:17">‘ዋቅንስ እምማን ሁንደ እጀሳኒራ ንሀቀ።’ ”<verse eid="REV 7:17"/></para>
  <chapter eid="REV 7"/>
  <chapter number="8" style="c" sid="REV 8"/>
  <para style="s1">ቻፓ ቶርበፋ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1"/>ዮሙ ሆልች ቻፓ ቶርበፋ በኔት ገረ ወለካ ሰኣቲ ቶኮ ሰሚ ኬሰ ተስገቢቱ ቱሬ።<verse eid="REV 8:1"/></para>
  <para style="s1">ግርግራ ወርቄ</para>
  <para style="p">
    <verse number="2" style="v" sid="REV 8:2"/>አንስ ኤርገሞተ ፉለ ዋቃ ዱረ ዸዻበተን ቶርበን አርጌ፤ እሳኒፍስ መለከትን ቶርበ ንኬነሜ።<verse eid="REV 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 8:3"/>ኤርገማን ብራ ከን ግርግራ ወርቄ ቀቡ ቶኮ ዹፌ እዶ ኣርሳ ብረ ዻበቴ። እንስ እዶ ኣርሳ ወርቄ ከን ፉለ ቴስቻ ዱረ ጅሩ ሰነረት አከ ከዸትና ቁልቁሎተ ሁንዱማ ወጅን ዽኤሱፍ እጣን ባይኤን እሳፍ ንኬነሜ። <verse eid="REV 8:3"/><verse number="4" style="v" sid="REV 8:4"/>ኣር እጣነ ሰናስ ከዸትና ቁልቁሎታ ወጅን ሀርከ ኤርገማ ሰና ኬሳ ፉለ ዋቃ ዱረት ኦል በኤ። <verse eid="REV 8:4"/><verse number="5" style="v" sid="REV 8:5"/>ኤርገማን ሱንስ ግርግራ ፉዼ እዶ ኣርሳራ እብደ እት ጉቴ ለፈት ገድ ደርበቴ፤ ኤርገሲስ ሰገሌን ከከዌ፣ በለቄሳፊ ሶቺ ለፋ ንዸገአሜ።<verse eid="REV 8:5"/></para>
  <para style="s1">መለከተወን</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6"/>ኤርገሞትን ዋቃ ቶርበን ወር መለከተ ቶርበን ቀበንስ መለከተ አፉፉፍ ንቆጳአን።<verse eid="REV 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 8:7"/>ኤርገማን ጀልቀባ መለከተሳ አፉፌ፤ ጨቢፊ እብድ ዺጋን መከሜስ ለፈት ገድ ደርበተሜ። ለፍት ሀርከ ሰዲ ኬሳ ሀርክ ቶኮ ንጉበቴ፤ ሙክትስ ሀርከ ሰዲ ኬሳ ሀርክ ቶኮ ንጉበቴ፤ መርግ ለልሳን ሁንድኑስ ንጉበቴ።<verse eid="REV 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8"/>ኤርገማን ለመፋንስ መለከተሳ አፉፌ፤ ወን ቱሉ ጉዳ ፈካቱ ከን እብዳን ጉበቻ ጅሩ ቶኮስ ገላነት ገድ ደርበተሜ። ገላንስ ሀርከ ሰዲ ኬሳ ሀርክ ቶኮ ዺገ ተኤ፤ <verse eid="REV 8:8"/><verse number="9" style="v" sid="REV 8:9"/>ኡመመወን ሉቡ ቀቤዪን ገላነ ኬሳ ሀርከ ሰዲ ኬሳ ሀርክ ቶኮ ንዹመን፤ ዶኒወን ሀርከ ሰዲ ኬሳስ ሀርክ ቶኮ ንበርበዳአን።<verse eid="REV 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10"/>ኤርገማን ሰደፋንስ መለከተሳ አፉፌ፤ ኡርጂን ጉዳን አከ ጉጫ ቦበኡ ቶኮስ ሰሚራ ለፈ ዸኤ፤ እንስ ለጌን ሀርከ ሰዲ ኬሳ ሀርከ ቶኮረት፣ ቡርቃወን ብሻኒረትስ ኩፌ፤ <verse eid="REV 8:10"/><verse number="11" style="v" sid="REV 8:11"/>መቃን ኡርጂ ሰናስ “ሀዼሳ” ጄዸመ። ብሻን ሱንስ ሀርከ ሰዲ ኬሳ ሀርክ ቶኮ ንሀዻኤ፤ ሰበቢ ብሻን ሱን ሀዼፈሜፍስ ነሞትን ባይኤን ብሻኒን ዹመን።<verse eid="REV 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12"/>ኤርገማን አፉረፋንስ መለከተሳ አፉፌ፤ አዱን ሀርከ ሰዲ ኬሳ ሀርክ ቶኮ፣ ጅእ ሀርከ ሰዲ ኬሳ ሀርክ ቶኮ፣ ኡርጂንስ ሀርከ ሰዲ ኬሳ ሀርክ ቶኮ ንሩኩተመን፤ ከናንስ እፍንሳኒ ሀርከ ሰዲ ኬሳ ሀርክ ቶኮ ንዱከናኤ። ጉያን ሀርከ ሰዲ ኬሳ ሀርክ ቶኮ አከሱመስ ሀልከን ሀርከ ሰዲ ኬሳ ሀርክ ቶኮ እፈ መሌ ሀፌ።<verse eid="REV 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 8:13"/>አንስ እላሌ ርሳ ሰሚ ወለካ በርሳ ሰገሌ ጉዳዻን፣ “ሰበቢ ሰገሌ መለከታ ከን ኤርገሞተ ብራ ሰደኒን ዸጌስፈሙፍ ጅሩ ሰናቲፍ ወረ ለፈረ ጅራተኒፍ ወዮ! ወዮ! ወዮ!” ጄዼ እዩ ቶኮ ነንዸገኤ።<verse eid="REV 8:13"/></para>
  <chapter eid="REV 8"/>
  <chapter number="9" style="c" sid="REV 9"/>
  <para style="s1">መለከተ ሸነፋ፦ ዸእቸ ሀዋንሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1"/>ኤርገማን ሸነፋን መለከተሳ አፉፌ፤ አንስ ኡርጂ ሰሚራ ለፈ ዸኤ ቶኮ ነንአርጌ። ኡርጂ ሰናፍስ ፉርቱን “ቦለ ቅሌ” ንኬነሜ። <verse eid="REV 9:1"/><verse number="2" style="v" sid="REV 9:2"/>ዮሙ እን ቦለ ቅሌ ሰነ በኔትስ ኣር ቶኮ አኩመ ኣረ ቦለ እብዳ ጉዳ ኬሳ በኡት ኦል በኤ። አዱፊ ሰሚንስ ኣረ ቦለ ቅሌ ኬሳ በኡ ሰናን ንዱከናአን። <verse eid="REV 9:2"/><verse number="3" style="v" sid="REV 9:3"/>ኣረ ሰነ ኬሳስ ሀዋንሰ ባይኤቱ ለፈት ያኤ፤ ሀዋንሶተ ሰናፍስ ታይታን አከ ታይታ ቶርባንቀባ ለፋ ንኬነሜ። <verse eid="REV 9:3"/><verse number="4" style="v" sid="REV 9:4"/>እሳንስ አከ መርገ ለፋ ዮካን ብቅልቱ ዮካን ሙከ ቶኮሌ ሚዸን ኡቱ ህንተእን አከ ነሞተ አደሳኒራ ቻፓ ዋቃ ህንቀባትን ቆፈ ሚዸን አጀጀመን። <verse eid="REV 9:4"/><verse number="5" style="v" sid="REV 9:5"/>እሳንስ አከ ነሞተ ሰነ ጅአ ሸን ዽጵሰኒፍ ኤየመሜፍ መሌ አከ ጀረ አጄሰኒፍ ምት። ዽጵን ኩንስ አኩመ ዽጵነ እሰ ዮሙ ቶርባንቀባን ነመ እዱት ዽጰተኒት። <verse eid="REV 9:5"/><verse number="6" style="v" sid="REV 9:6"/>ጉዮተ ሰነ ኬሰ ነሞትን ዱአ በርባዱ፤ ገሩ ህንአርገተን። ዱኡስ ንሀዉ፤ ዱት ገሩ እሳን በቀተ።<verse eid="REV 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7"/>ብፍት ሀዋንሶተ ሰናስ ፈርዴን ዱላፍ ቆጴፈመን ፈካተ ቱሬ። መታሳኒትስ ዋን አከ ጎንፎ ወርቄ ካአተኒ ቱረን፤ ፉልሳኒስ ፉለ ነማ ፈካተ ቱሬ። <verse eid="REV 9:7"/><verse number="8" style="v" sid="REV 9:8"/>ርፌንስሳኒ ርፌንሰ መታ ዱበርቶታ ፈካተ ቱሬ፤ እልካንሳኒስ እልካን ሌንጫ ፈካተ ቱሬ። <verse eid="REV 9:8"/><verse number="9" style="v" sid="REV 9:9"/>እሳንስ መዳ መዳ ስቢላ ፈካቱ ቀቡ ቱረን፤ ሰገሌን ቆቾሳኒስ ሰገሌ ፈርዴኒፊ ጋሪወን ባይኤ ከኔን ገረ ዱላት ድድቸኒ ፈካተ ቱሬ። <verse eid="REV 9:9"/><verse number="10" style="v" sid="REV 9:10"/>እሳንስ አኩመ ቶርባንቀባ ኤጌፊ እልኬ ቀቡ ቱረን፤ ኤጌሳኒ ኬሳሞ ታይታ እቲን ጅአ ሸን ነመ ዽጵሰን ቀቡ ቱረን። <verse eid="REV 9:10"/><verse number="11" style="v" sid="REV 9:11"/>እሳንስ ሞቲ ቀቡ ቱረን፤ እንስ ኤርገማ ቦለ ቅሌት፤ መቃንሳስ አፋን እብራይስጢቲን አበዶን፣ አፋን ግሪኪንሞ አጶልዮን ጄዸመ ቱሬ።<verse eid="REV 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12"/>ወዮን እን ዱራ ደርቤረ፤ ኩኖ፣ ወዮወን ብራ ለመቱ ዹፉፍ ጅረ።<verse eid="REV 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13"/>ኤርገማን ጀአፋንስ መለከተሳ አፉፌ፤ አንስ ጋንፈ አፍረን ከኔን እዶ ኣርሳ ወርቄራ ሆጄተሜ ፉለ ዋቃ ዱረ ጅሩራ ሰገሌ ቶኮ ነንዸገኤ። <verse eid="REV 9:13"/><verse number="14" style="v" sid="REV 9:14"/>ሰገሌን ሱንስ ኤርገማ ጀአፋ መለከተ ቀቡ ሰናን፣ “ኤርገሞተ አፍረን ከኔን ለገ ኤፍራጢስ ጉድቸ ብረት ህዸመን ሰነ ገድ ዺስ” ጄዼ። <verse eid="REV 9:14"/><verse number="15" style="v" sid="REV 9:15"/>ኤርገሞትን አፍረን ሰኣቲ ከናፍ፣ ጉያ ከናፍ፣ ጅኣፊ ወጋ ከናፍ ቆጴፈመኒ ቱረንስ ሰኚ ነማ ሀርከ ሰዲ ኬሳ ሀርከ ቶኮ ፍጡፍ ገድ ዺፈመን። <verse eid="REV 9:15"/><verse number="16" style="v" sid="REV 9:16"/>ባይእን ሎልቶተ ፈርዴኒን ዱለኒ ምልዮነ ዽበ ለመ ቱሬ። አንስ ባይእነሳኒስ ነንዸገኤ።<verse eid="REV 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 9:17"/>አንስ ሙልአተኮ ኬሰት ፈርዴኒፊ ነሞተ ፈርደ ያበተን ነንአርጌ፦ እሳንስ መዳ ዲማ አከ እብዳ፣ ሰንፔሪፊ<note caller="+" style="f"><char style="fr" closed="false">9፥17 </char><char style="fq" closed="false">ሰንፔሪ </char><char style="ft" closed="false">– ሰንፔሪን ዸጋ ገቲ ጉዳ ጉራቸ አከ ጩቁሊሳት።</char></note> ኬሎ አከ ድኚ<note caller="+" style="f"><char style="fr" closed="false">9፥17 </char><char style="fq" closed="false">ድኚ </char><char style="ft" closed="false">– ድኚን ኬምካለ ኬሎ ፈካቱ ከን ሆአ ጉዳዻን ጉበሙፊ ከን ፎሊ ነመት ህንቶሌ ቀቡዸ።</char></note> ቀቡ ቱረን። መታን ፈርዴን ሰናስ መታ ሌንጫ ፈካተ ቱሬ፤ አፋንሳኒ ኬሳስ እብደ፣ ኣራፊ ድኚቱ በኤ። <verse eid="REV 9:17"/><verse number="18" style="v" sid="REV 9:18"/>ዸእቸ ሰደን ከናን ጄቹንስ እብደ፣ ኣራፊ ድኚ አፋንሳኒቲ በኤን ሰኚን ነማ ሀርከ ሰዲ ኬሳ ሀርክ ቶኮ ንአጄፈሜ። <verse eid="REV 9:18"/><verse number="19" style="v" sid="REV 9:19"/>ታይታን ፈርዴን ሰናስ አፋንሳኒቲፊ ኤጌሳኒ ኬሰ ቱሬ፤ ኤጌንሳኒ አኩመ ቦፋ መታ ቀበ ቱሬቲ፤ እሳንስ መታ ሰናን ነመ ሚዹ ቱረን።<verse eid="REV 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 9:20"/>ነሞትን ዸእቸ ሰናን አጄፈሙ ጀላ በአንስ አመዩ ቀልቢ ጅጂረተኒ ሆጂ ሀርከሳኒራ ህንዴብኔ፤ ሀፉሮተ ሀሞ ዋቄፈቹፊ ዋቆተ ቶልፈሞ ወርቄራ፣ ሜቲራ፣ ናሲራ፣ ዸጋፊ ሙከራ ሆጄተመን ከኔን አርጉ ዮካን ዸገኡ ዮካን ዴሙ ህንደንዴኜ ዋቄፈቹ ህንዺፍኔ። <verse eid="REV 9:20"/><verse number="21" style="v" sid="REV 9:21"/>አከሱመስ ጋበኒ ነመ አጄሱሳኒራ ዮካን ፈልፈለ ሆጄቹሳኒራ ዮካን ሀለሉማሳኒራ ዮካን ሀነሳኒራ ህንዴብኔ።<verse eid="REV 9:21"/></para>
  <chapter eid="REV 9"/>
  <chapter number="10" style="c" sid="REV 10"/>
  <para style="s1">ኤርገምቻፊ ክታበ መረማ ጥና</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1"/>አንስ ኡቱ ኤርገማን ዋቃ እን ጀባን ብራ ቶኮ ሰሚራ ገድ ቡኡ ነንአርጌ። እንስ ዱሜሰ ኡፈቴ ቱሬ፤ መታሳ እራንሞ ሰበተ ዋቃቱ ቱሬ፤ ፉልሳ አከ አዱ፣ ሚልሳስ አከ ኡቱባ እብዳ ቱሬ። <verse eid="REV 10:1"/><verse number="2" style="v" sid="REV 10:2"/>እንስ ክታበ መረማ ጥና በነሜ ቶኮ ሀርከት ቀበቴ ቱሬ። ሚለሳ ምርጋ ገላነረ፣ ሚለሳ ብታሞ ለፈረ ዻቤ ቱሬ፤ <verse eid="REV 10:2"/><verse number="3" style="v" sid="REV 10:3"/>እንስ አኩመ ሌንጨ ኣዱት ሰገሌ ጉዳዻን እዬ። ዮሙ እን እዬትስ በከካወን ቶርበን ንዱበተን። <verse eid="REV 10:3"/><verse number="4" style="v" sid="REV 10:4"/>ዮሙ በከካወን ቶርበን ዱበተንትስ አን በሬሱፍ ቆጳኤን ቱሬ፤ ገሩ ሰገሌ፣ “ዋን በከካወን ቶርበን ጄዸን ሰነ ቻፓን ጩፍ መሌ ህንበሬስን” ጄዹ ቶኮ ሰሚራ ነንዸገኤ።<verse eid="REV 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5"/>ኤርገማን አን ኡቱ እን ገላናፊ ለፈረ ዻበቱ አርጌ ቱሬ ሱንስ ሀርከሳ ምርጋ ሰሚት ኦል ቀቤ። <verse eid="REV 10:5"/><verse number="6" style="v" sid="REV 10:6"/>እንስ እሰ በረ በራ ሀመ በረ በራት ጅራቱ፣ እሰ ሰሚወኒፊ ዋን እሳን ኬሰ ጅሩ ሁንዱማ፣ ለፋፊ ዋን እሰ ኬሰ ጅሩ ሁንዱማ፣ ገላናፊ ዋን እሰ ኬሰ ጅሩ ሁንዱማ ኡሜ ሰናን ከከቴ አከነ ጄዼ፤ “አማን አች ለፈረ ሀርክሱን ህንጅሩ! <verse eid="REV 10:6"/><verse number="7" style="v" sid="REV 10:7"/>ገሩ ጉዮተ ኤርገማን ቶርበፋን መለከተሳ አፉፉት እጪቲን ዋቃ አኩመ እን ራጆተ ወረ ሆጄቶተሳ ተአንት ለብሴ ሰነት ንራወተመ።”<verse eid="REV 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 10:8"/>ሰገሌን አን ሰሚራ ዸገኤ ቱሬ ሱን አመስ ዴብኤ፣ “ዸቂቲ ክታበ መረማ በነሜ ኤርገማ ገላናፊ ለፈረ ዻበቱ ሀርከ ጅሩ ሰነ ፉዸዹ” ናን ጄዼ።<verse eid="REV 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 10:9"/>ከናፉ አን ገረ ኤርገምቻ ዸቄ አከ እን ክታበ መረማ ጥና ሰነ ናፍ ኬኑፍ እሰ ጋፈዼ። እንስ፣ “ፉዸዹቲ ኛዹ፤ ክታብን ኩን ገራኬ ንሀዼሰ፤ ‘አፋንኬ ኬሰት ገሩ አከ ደማ ምኣአ’<note caller="+" style="f"><char style="fr" closed="false">10፥9 </char><char style="ft" closed="false"><char style="xt"><ref loc="EZK 3:3">ህስ 3፥3</ref></char></char></note>” ናን ጄዼ። <verse eid="REV 10:9"/><verse number="10" style="v" sid="REV 10:10"/>አንስ ክታበ መረማ ጥና ሰነ ኤርገምቸ ሀርካ ፉዸዼ ነንኛዼ። እንስ አፋንኮ ኬሰት አኩመ ደማ ምኣኤ፤ ኤርገ አን ኛዼ ገሩ ገራንኮ ንሀዼፈሜ። <verse eid="REV 10:10"/><verse number="11" style="v" sid="REV 10:11"/>ኤርገሲሞ፣ “አት ዋኤ ሰበ ባይኤ፣ ሰኚ ባይኤ፣ አፋን ባይኤቲፊ ዋኤ ሞቶተ ባይኤ አመስ ራጂ ዱበቹ ቀብደ” ጄዸሜ ነት ህመሜ።<verse eid="REV 10:11"/></para>
  <chapter eid="REV 10"/>
  <chapter number="11" style="c" sid="REV 11"/>
  <para style="s1">ዹገ ባቶተ ለማን</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1"/>ሸምበቆን ኡሌ ሰፈርቱ ፈካቱ ቶኮ ናፍ ኬነሜ አከነ ጄዸሜ ነት ህመሜ፤ “ዸቂቲ መነ ቁልቁሉማ ዋቃቲፊ እዶ ኣርሳ ሰፈር፤ ወረ አችት ዋቄፈተንስ ለካእ። <verse eid="REV 11:1"/><verse number="2" style="v" sid="REV 11:2"/>ኦብዲ መነ ቁልቁሉማቲ አለ ተኤ ገሩ ህንሰፈርን፤ ኦብዲን ሱን ዋን ነሞተ ኦርማቲፍ ኬነሜፍ እሰ እት ህንደበልን። እሳንስ መጋላ ቁልቁሉ ሰነ ጅአ 42 ለፈት ዽዺቱ። <verse eid="REV 11:2"/><verse number="3" style="v" sid="REV 11:3"/>አንስ ዹገ ባቶተኮ ለማኒፍ ሁምነ ነንኬነ፤ እሳንስ ኡፈተ ገዳ<note caller="+" style="f"><char style="fr" closed="false">11፥3 </char><char style="fq" closed="false">ኡፈተ ገዳ </char><char style="fqa" closed="false">(ላለላ) </char><char style="ft" closed="false">– ኡፈትን ገዳ ኡፈተ ራጆትን ዬሮ ሁንደ ኡፈተኒዸ (<char style="xt"><ref loc="2KI 1:18">2ሞቶ 1፥18</ref>፤ <ref loc="ISA 20:2">እሳ 20፥2</ref>፤ <ref loc="ZEC 13:4">ዘካ 13፥4</ref></char> እላላ)።</char></note> ኡፈተኒ ጉያ 1,260 ራጂ ንዱበቱ።” <verse eid="REV 11:3"/><verse number="4" style="v" sid="REV 11:4"/>እሳን ኩኔንስ ሙኬን ኤጄርሳ ለማኒፊ ባቱወን እብሳ ለማን ፉለ ጎፍታ ለፋ ዱረ ዻበተኒዸ። <verse eid="REV 11:4"/><verse number="5" style="v" sid="REV 11:5"/>ነምን ከምዩ እሳን ሚዹ ያላን እብድ አፋንሳኒቲ በኤ ዲኖተሳኒ ንበሌሰ። ኩንስ ሃለ ነምን እሳን ሚዹ በርባዱ ከምዩ እቲን አጄፈሙ ቀቡዸ። <verse eid="REV 11:5"/><verse number="6" style="v" sid="REV 11:6"/>እሳን ዬሮ ራጂ ዱበተንት አከ ቦካን ህንሮብኔፍ ሁምነ እቲን ሰሚ ጩፈን ቀቡ፤ አከሱመስ ብሻኖተ ዺገት ጌደሩዻፊ ዬሮ በርባደንት ዸእቸ ጎሰ ሁንዳቲን ለፈ ሩኩቱፍ ታይታ ቀቡ።<verse eid="REV 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7"/>ዮሙ እሳን ዹገ በኡምሰሳኒ ጡሙረንትስ ብኔንስ ቦለ ቅሌ ኬሳ ኦል በኡ ሱን ሎለ እሳንት ካሰ፤ እሳን ሞአተ፤ እሳን አጄሰስ። <verse eid="REV 11:7"/><verse number="8" style="v" sid="REV 11:8"/>ሬፍሳኒስ ዳንዲ መጋላ ጉዶረ ንጭጪሰ፤ መጋለቲን ኩንስ እሼ ሂካ ሀፉራቲን ሶዶሚፊ ግብጥ ጄዸምቱ ከን ጎፍታንሳኒስ እት ፈንፈሜ ቱሬዸ። <verse eid="REV 11:8"/><verse number="9" style="v" sid="REV 11:9"/>ነሞትን ሰበ ሁንደ ኬሳ፣ ጎሰ ሁንደ ኬሳ፣ አፋኒፊ ሰኚ ሁንደ ኬሳ ዹፈንስ ጉያ ሰዲፊ ወለካ ሬፈሳኒ እላሉ፤ አከ ህንአዋለምኔስ ንዾዉ። <verse eid="REV 11:9"/><verse number="10" style="v" sid="REV 11:10"/>ራጆትን ለማን ኩኔን ዋን ወረ ለፈረ ጅራተን ዽጵሳ ቱረኒፍ ወር ለፈረ ጅራተን እሳንት ገመዱ፤ ንእልልቹስ፤ ኬናስ ወሊ ኤርጉ።<verse eid="REV 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 11:11"/>ጉያ ሰዲፊ ወለካ ቦዴ ገሩ ሀፉር ጅሬኛ ዋቀ ብራ ዹፌ እሳን ሴኔ፤ እሳንስ ከአኒ ሚለሳኒቲን ዻበተን፤ ወር እሳን አርገንስ አከ መሌ ሶዳተን። <verse eid="REV 11:11"/><verse number="12" style="v" sid="REV 11:12"/>እሳንስ ሰገሌ ጉዳ፣ “አስ ኦል ኮታ!” እሳኒን ጄዹ ቶኮ ሰሚራ ዸገአን። ኡቱመ ዲኖትንሳኒ እላለኑስ ዱሜሳን ገረ ሰሚት ኦል በአን።<verse eid="REV 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 11:13"/>ዬሮ ሰነትስ ሶቺ ለፋ ጉዳሳቱ ቱሬ፤ መጋላን ሱንስ ኩዸን ኬሳ ቶኮ ንበርበዳኤ። ነሞትን ኩምን ቶርበስ ሶቺ ለፋ ሰናን ዹመን፤ ወር ሀፈንሞ ሶዳተኒ ዋቀ ሰሚቲፍ ኡልፍነ ኬነን።<verse eid="REV 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 11:14"/>ወዮን ለመፋን ደርቤረ፤ ኩኖ፣ ወዮን ሰደፋን ደፌ ንዹፈ።<verse eid="REV 11:14"/></para>
  <para style="s1">መለከተ ቶርበፋ</para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15"/>ኤርገማን ቶርበፋንስ መለከተሳ አፉፌ፤ ሰገሌን ጉዳን፣</para>
  <para style="q1" vid="REV 11:15">“ሞቱማን አዱኛ</para>
  <para style="q2" vid="REV 11:15">አመ ሞቱማ ጎፍታኬኛቲፊ ሞቱማ ክርስቶስ ተኤረ፤</para>
  <para style="q2" vid="REV 11:15">እንስ በረ በራ ሀመ በረ በራት ንሞአ”</para>
  <para style="m" vid="REV 11:15">ጄዹ ሰሚ ኬሰ ቱሬ። <verse eid="REV 11:15"/><verse number="16" style="v" sid="REV 11:16"/>ማንጉዶትን ድግደሚ አፍረን ፉለ ዋቃ ዱረ ቴሶሳኒረ ተታአኒ ቱረን ሱንስ አደሳኒቲን ጎምብፈመኒ ዋቃፍ ንሰገደን፤ <verse eid="REV 11:16"/><verse number="17" style="v" sid="REV 11:17"/>አከነስ ጄዸን፦</para>
  <para style="q1" vid="REV 11:17">“ያ ዋቀዮ ጎፍታ ዋን ሁንደ ደንዴሱ፣</para>
  <para style="q2" vid="REV 11:17">ከን ጅርቱፊ ከን ቱርቴ፣</para>
  <para style="q1" vid="REV 11:17">አት ሁምነኬ እሰ ጉዳ ፉዸቴ</para>
  <para style="q2" vid="REV 11:17">ዋን ሞኡ ጀልቀብዴፍ ገለተ ሲፍ ዽኤስነ።<verse eid="REV 11:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="REV 11:18"/>ነሞትን ኦርማ ንኣረን፤</para>
  <para style="q2" vid="REV 11:18">ዼከምስኬስ ዹፌረ።</para>
  <para style="q1" vid="REV 11:18">ዬሮን ወር ዱአን እት ሙርቲ አርገተን ገኤረ፤</para>
  <para style="q2" vid="REV 11:18">ዬሮን አት እት ራጆተ ተጃጅልቶተኬ ተአኒፍ፣</para>
  <para style="q1" vid="REV 11:18">ቁልቁሎተኬቲፊ ወረ መቃኬ ሶዳተን</para>
  <para style="q2" vid="REV 11:18">ጥናፍስ ተኡ ጉዳፍ በዻሰ ኬንቱ ገኤረ፤</para>
  <para style="q1" vid="REV 11:18">ዬሮን አት እት ወረ ለፈ በሌሰን በሌስቱስ ገኤረ።”<verse eid="REV 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19"/>መን ቁልቁሉማ ዋቃ ከን ሰሚ ኬሳስ ንበነሜ፤ ታቦትን ከኩሳስ መነ ቁልቁሉማሳ ኬሰት ሙልአቴ። ኤርገሲስ እፈ በለቄ፣ ሰገሌ፣ በከካ፣ ሶቺ ለፋቲፊ ቦካ ጨቢ ጉዳ እሳቱ ቱሬ።<verse eid="REV 11:19"/></para>
  <chapter eid="REV 11"/>
  <chapter number="12" style="c" sid="REV 12"/>
  <para style="s1">ዱበርትቲፊ ብኔንሰ ጀዌ ፈካቱ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1"/>መለቶን ጉዳን ቶኮ ሰሚ ኬሰት ሙልአቴ፦ ዱበርቲ ቢፍቱ ኡፈቴ ሚለሼ ጀላ ጅአ ቀብዱ ከን መታሼራ ጎንፎ ኡርጂወን ኩዸ ለማ ቀብዱ ቶኮቱ ቱሬ። <verse eid="REV 12:1"/><verse number="2" style="v" sid="REV 12:2"/>እሼንስ ኡልፈ ቱርቴ፤ ዮሙ ደኡምስሼ ገኤትስ ጭኒንሱዻን ቀበምቴ እይቴ። <verse eid="REV 12:2"/><verse number="3" style="v" sid="REV 12:3"/>መለቶን ብራስ ሰሚ ኬሰት ሙልአቴ፤ ኩኖ፣ ብኔንሰ ጀዌ ፈካቱ ዲማ ጉዳ፣ መታ ቶርባፊ ጋንፈ ኩዸን ቀቡ፣ ከን መታሳራ ጎንፎ ቶርበ ቀቡ ቶኮቱ ቱሬ። <verse eid="REV 12:3"/><verse number="4" style="v" sid="REV 12:4"/>ኤጌንሳስ ኡርጂወን ሰሚረ ጅረን ሀርከ ሰዲ ኬሳ ሀርከ ቶኮ ሀጣኤ ለፈት ገድ ደርበቴ። ብኔንስ ጀዌ ፈካቱ ሱንስ ዬሮ ዱበርትቲን ዴሱት ሙጫሼ ልቅምሱፍ ጄዼ ፉለ ዱበርቲ ደኡፍ ጅርቱ ሰና ዱረ ዻበቴ። <verse eid="REV 12:4"/><verse number="5" style="v" sid="REV 12:5"/>እሼን እልመ ቦኩ ስቢላቲን ሰበ ሁንዱማ ቡልቹፍ ጅሩ ቶኮ ዴሴ፤ ዳእምንሼስ ገረ ዋቃት፣ ገረ ቴሶ እሳትስ ኦል ቡተሜ። <verse eid="REV 12:5"/><verse number="6" style="v" sid="REV 12:6"/>ዱበርትቲንስ ገረ ለፈ ገሞጂ እዶ አከ እሼን ጉያ 1,260 አችት ገብፈምቱፍ ጄዼ ዋቅን እሼፍ ቆጴሴት በቀቴ።<verse eid="REV 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 12:7"/>ሎልስ ሰሚ ኬሰት ከኤ። ሚካኤሊፊ<note caller="+" style="f"><char style="fr" closed="false">12፥7 </char><char style="fq" closed="false">ሚካኤሊ </char><char style="ft" closed="false">– ሀንገፎተ ኤርገሞታ ኬሳ እሰ ቶኮ፤ እንስ <char style="xt"><ref loc="DAN 10:21">ዳን 10፥21</ref></char> እረት ኤግዱ ሰበ እስራኤል ከን አዳ ጄዸሜ እብሰሜ። ኤርገሞትን ሚካኤሊስ ወረ አጀጀ እሰ ጀለ ጅረኒዸ።</char></note> ኤርገሞትንሳ ብኔንሰ ጀዌ ፈካቱ ሰነ ሎለን፤ ብኔንስ ጀዌ ፈካቱ ሱኒፊ ኤርገሞትንሳስ ኦፍራ ሎለን። <verse eid="REV 12:7"/><verse number="8" style="v" sid="REV 12:8"/>እሳን ገሩ ሞአቹ ህንደንዴኜ፤ ኤርገሲስ እዶሳኒ ከን ሰሚ ኬሳ ሰነ ንዸበን። <verse eid="REV 12:8"/><verse number="9" style="v" sid="REV 12:9"/>ብኔንስ ጉዳን ጀዌ ፈካቱ ሱንስ ገድ ደርበተሜ፤ እንስ ቦፈ ዱሪ እሰ ዲያብሎስ ዮካን ሴጠነ ጄዸሙ፣ እሰ አዱኛ ጉቱ ከራራ ጀልእሱ ሰናዸ። እን ለፈት ገድ ደርበተሜ፤ ኤርገሞትንሳስ እሰ ወጅን ደርበተመን።<verse eid="REV 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 12:10"/>አንስ ሰገሌ ጉዳ ቶኮ ሰሚ ኬሳ ነንዸገኤ፤ እንስ አከነ ጄዸ፦</para>
  <para style="q1" vid="REV 12:10">“አመ ፈይን፣</para>
  <para style="q2" vid="REV 12:10">ሁምኒፊ ሞቱማን ዋቀኬኛ፣</para>
  <para style="q2" vid="REV 12:10">ታይታን ክርስቶስ<note caller="+" style="f"><char style="fr" closed="false">12፥10 </char><char style="ft" closed="false">ዮካን </char><char style="fqa" closed="false">መሲሂ</char></note> እሳስ ዹፌረ።</para>
  <para style="q1" vid="REV 12:10">ህመታን ኦቦሎተኬኛ</para>
  <para style="q2" vid="REV 12:10">እን ሀልከኒ ጉያ ፉለ ዋቃ ዱረት፣</para>
  <para style="q2" vid="REV 12:10">እሳን ህመቱ ሱን ገድ ደርበተሜራቲ።<verse eid="REV 12:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 12:11"/>እሳንስ ዺገ ሆልቻቲን፣</para>
  <para style="q2" vid="REV 12:11">ዱቢ ዹገ በኡምሰሳኒቲንስ፣ እሰ ሞአተን፤</para>
  <para style="q1" vid="REV 12:11">እሳን ሀመ ዱኣትሌ ታናን</para>
  <para style="q2" vid="REV 12:11">ሉቡሳኒ ህንመረርፈትኔ።<verse eid="REV 12:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="REV 12:12"/>ከናፉ ያ ሰሚወን፣</para>
  <para style="q2" vid="REV 12:12">እስን ወር እሳን ኬሰ ጅራተንስ ገመዳ!</para>
  <para style="q1" vid="REV 12:12">ገሩ ያ ለፋፊ ያ ገላነ እስኒፍ ወዮ!</para>
  <para style="q2" vid="REV 12:12">ዲያብሎስ ገረኬሰንት ገድ ቡኤራቲ!</para>
  <para style="q1" vid="REV 12:12">እንስ አከ ዬሮ ገባባ ቀቡ ዋን ቤኩፍ</para>
  <para style="q2" vid="REV 12:12">ባይኤ ኣሬረ።”<verse eid="REV 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 12:13"/>ብኔንስ ጀዌ ፈካቱ ሱንስ ዮሙ አከ ለፈት ገድ ደርበተሜ አርጌት፣ ዱበርትቲ ዳእመ ዺራ ዴሴ ሰነ አርአቹ ጀልቀቤ። <verse eid="REV 12:13"/><verse number="14" style="v" sid="REV 12:14"/>ዱበርትቲን ገሩ አከ ገረ ገሞጂ እዶ እሼፍ ቆጴፈሜት ቦፍቸ ጀላ በርፍቱፍ፣ አችትስ በራፍ፣ በሮታፊ ወለካ በራቲፍ አከ ገብፈምቱፍ ባሌን ርሳ ጉዳን ለመ እሼዻፍ ንኬነሜ። <verse eid="REV 12:14"/><verse number="15" style="v" sid="REV 12:15"/>ቦፍችስ አከ ዱበርትቲን ሎላዻን ፉዸተምቱፍ ጄዼ ዱግደሼ ዱባን ብሻን አከ ለጋ አፋንሳ ኬሳ ዸንገላሴ። <verse eid="REV 12:15"/><verse number="16" style="v" sid="REV 12:16"/>ለፍት ገሩ አፋን በንቴ ለገ ብኔንስ ጀዌ ፈካቱ ሱን አፋንሳ ኬሳ ዸንገላሴ ሰነ ልቅምሱዻን ዱበርትቲ ገርጋርቴ። <verse eid="REV 12:16"/><verse number="17" style="v" sid="REV 12:17"/>ብኔንስ ጀዌ ፈካቱ ሱን ዱበርትቲት ኣሬ ሰኚሼ ወረ ሀፈንት ሎለ ካሱ ዸቄ፤ እሳንስ ወረ አጀጀ ዋቃ ኤገኒፊ ወረ ዹገ በኡምሰ ዬሱስ ጀቤሰኒ ቀበተኒዸ።<verse eid="REV 12:17"/></para>
  <chapter eid="REV 12"/>
  <chapter number="13" style="c" sid="REV 13"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1"/>ብኔንስ ጀዌ ፈካቱ ሱንስ ጭረቸ ገላናረ ዻበቴ።</para>
  <para style="s1" vid="REV 13:1">ብኔንሰ ገላነ ኬሳ በኤ</para>
  <para style="p" vid="REV 13:1">ብኔንሰ ቶኮስ ኡቱ እን ገላነ ኬሳ በኡ ነንአርጌ። እንስ ጋንፈ ኩዸኒፊ መታ ቶርበ ቀበ ቱሬ፤ ጋንፈወንሳረት ጎንፎ ኩዸን፣ ቶኮ ቶኮ መታሳረትሞ መቃ አረብሶ ቀበ ቱሬ። <verse eid="REV 13:1"/><verse number="2" style="v" sid="REV 13:2"/>ብኔንስ አን አርጌ ሱንስ ቄረንሰ ፈካተ ቱሬ። ሚልሳ ሚለ አማኬታ፣ አፋንሳሞ አፋን ሌንጫ ፈካተ ቱሬ። ብኔንስ ጀዌ ፈካቱ ሱንስ ሁምነሳ፣ ቴሶሳቲፊ ታይታ ጉዳስ ብኔንስቻፍ ኬኔ። <verse eid="REV 13:2"/><verse number="3" style="v" sid="REV 13:3"/>መታ ብኔንስቻ ቶርበን ኬሳ እን ቶኮ ዋን መዳ ዱአ ፍዱ ቀቡ ፈካተ ቱሬ፤ መዳን ዱአ ፍዱ ሱን ገሩ ፈዬ ቱሬ፤ አዱኛን ጉቱንስ ድንቅሲፈቴ ብኔንስቸ ዱካ ቡኤ። <verse eid="REV 13:3"/><verse number="4" style="v" sid="REV 13:4"/>ነሞትን ሰበቢ እን ታይታሳ ብኔንሰ ሰናፍ ኬኔፍ ብኔንሰ ጀዌ ፈካቱ ሰናፍ ንሰገደን፤ አከሱመስ፣ “ከን አከ ብኔንስቻ ኤኙ? ኤኙቱስ ሎለ እሰት ካሱ ደንደአ?” ጄዸኒ ብኔንስቻፍ ሰገደን።<verse eid="REV 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 13:5"/>አከ ብኔንስች ዱቢ ኦፍ ቱሉማቲፊ አረብሶ ዱበቱፍ አፋን ንኬነሜፍ፤ ጅአ አፉርተሚ ለማፍ አከ እቲን ሆጄቱፍስ ታይታን እሳፍ ኬነሜ። <verse eid="REV 13:5"/><verse number="6" style="v" sid="REV 13:6"/>እንስ ዋቀ አረብሱፍ፣ ዋቃፊ እዶ ጅሬኘሳ፣ አከሱመስ ወረ ሰሚ ኬሰ ጅራተን መቃ በሌሱፍ ጄዼ አፋን በነቴ። <verse eid="REV 13:6"/><verse number="7" style="v" sid="REV 13:7"/>አከ እን ቁልቁሎተት ወራነ ካሴ እሳን ሞአቱፍስ ሁምን ንኬነሜፍ። ጎሰ ሁንደ፣ ሰበ ሁንደ፣ አፋኒፊ ሰኚ ሁንደረትስ ታይታን ንኬነሜፍ። <verse eid="REV 13:7"/><verse number="8" style="v" sid="REV 13:8"/>ወር ለፈረ ጅራተን ሁንድኑ ጄቹንስ ወር መቃንሳኒ ኤርገ አዱኛን ኡመሜ ጀልቀቤ ክታበ ጅሬኛ ከን ሆልቸ ቀለሜ ሰና ኬሰት ህንገልሜፈምን ሁንድኑ ብኔንስቻፍ ንሰገዱ።<verse eid="REV 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 13:9"/>ነምን ጉረ ቀቡ ከምዩ ሃዸገኡ።<verse eid="REV 13:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 13:10"/>ነምን ቦጅአሙፍ ጅሩ ከምዩ</para>
  <para style="q2" vid="REV 13:10">እን ንቦጅአመ።</para>
  <para style="q1" vid="REV 13:10">ነምን ጎራዴዻን አጄፈሙፍ ጅሩ ከምዩ</para>
  <para style="q2" vid="REV 13:10">ጎራዴዻን ንአጄፈመ።</para>
  <para style="m" vid="REV 13:10">ኩንስ ኦብሳፊ አመነሙማ ቁልቁሎታ አርግሲሰ።<verse eid="REV 13:10"/></para>
  <para style="s1">ብኔንሰ ለፈ ኬሳ በኤ</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11"/>ብኔንሰ ብራስ ኡቱ እን ለፈ ኬሳ በኡ ነንአርጌ። እንስ አከ ሆላ ጋንፈ ለመ ቀበ ቱሬ፤ አከ ብኔንሰ ጀዌ ፈካቱትስ ዱበተ ቱሬ። <verse eid="REV 13:11"/><verse number="12" style="v" sid="REV 13:12"/>እንስ ታይታ ብኔንስቸ ጀልቀባ ሁንዳን ፉለሳ ዱረት ሆጄቻ ቱሬ፤ አከ ለፍቲፊ ወር ለፈረ ጅራተን ብኔንስቸ ጀልቀባ እሰ መዳን ዱአ ፍዱ ፈዬፍ ሰናፍ ሰገደንስ ጎዼ። <verse eid="REV 13:12"/><verse number="13" style="v" sid="REV 13:13"/>እንስ ሀመ አከ እብድ ሰሚራ ለፈት ገድ ቡኡ ጎዹት እጀ ነማ ዱረት ድንቂ ጉርጉዳ ሆጄቴ። <verse eid="REV 13:13"/><verse number="14" style="v" sid="REV 13:14"/>መለቶ አከ እን እዶ ብኔንስች ጀልቀባ ጅሩት ሆጄቱፍ ኤየመሜፍ ሰናንስ ነሞተ ለፈረ ጅራተን ንጎዎምሴ። አከ እሳን ኡልፍነ ብኔንስቸ ጎራዴዻን መዳኤ ኤርገሲሞ ጅራቴ ሰናቲፍ ፈኪ ዻበን አጀጄ። <verse eid="REV 13:14"/><verse number="15" style="v" sid="REV 13:15"/>ፈኪን ብኔንሰ ጀልቀባ ሱንስ አከ ዱበቹ ደንደኡፊ ወረ ፈኪ ሰናፍ ሰገዱ ድደን ሁንደስ አከ አጄስሱፍ ብኔንስ እን ለመፋን አከ ፈኪ ሰናፍ ሉቡ ኬኑፍ ሁምን ኬነሜፍ። <verse eid="REV 13:15"/><verse number="16" style="v" sid="REV 13:16"/>አከሱመስ ነምን ሁንድኑ ጥናፊ ጉዳን፣ ሶሬሲፊ ህዬስ፣ ብርመዱፊ ገርብ ሀርከ ምርጋረት ዮካን አደረት አከ መለቶ ቀባቱ ድርቅሲሴ፤ <verse eid="REV 13:16"/><verse number="17" style="v" sid="REV 13:17"/>ኩንስ አከ ነምን መለቶ ከነ ጄቹንስ መቃ ብኔንስቻ ዮካን ለኮብሰ መቃሳ ህንቀባትን ከምዩ ብተቹ ዮካን ጉርጉረቹ ህንደንዴኜፍ።<verse eid="REV 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 13:18"/>ኦጉማን አስ ጅረ። ለኮብስች ዋን ለኮብሰ ነማ ተኤፍ ነምን ሁበትና ቀቡ ከምዩ ለኮብሰ ብኔንስቻ ሃሄሬጉ። ለኮብስሳስ 666።<verse eid="REV 13:18"/></para>
  <chapter eid="REV 13"/>
  <chapter number="14" style="c" sid="REV 14"/>
  <para style="s1">ሆልቻፊ ነሞተ 144,000</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1"/>አንስ ነንእላሌ፤ ኩኖ፣ ሆልች ቱሉ ጥዮንረ ዻበቻ ቱሬ፤ ነሞትን 144,000፣ ከኔን መቃንሳቲፊ መቃን አባሳ አደሳኒረት በሬፈሜስ እሰ ወጅን ቱረን። <verse eid="REV 14:1"/><verse number="2" style="v" sid="REV 14:2"/>አንስ ሰገሌ አከ ሰገሌ ብሻን ባይኤቲፊ አከ ሰገሌ ከከዌ ጉዳ ሰሚራ ነንዸገኤ። ሰገሌን አን ዸገኤ ሱንስ አከ ሰገሌ በገና ከን ነሞትን በገና ተጰተን ዸጌስሰኒ ቱሬ። <verse eid="REV 14:2"/><verse number="3" style="v" sid="REV 14:3"/>እሳንስ ፉለ ቴስቻ ዱረት፣ ፉለ ኡመመወን ሉቡ ቀቤዪ አፍረኒቲፊ ፉለ ማንጉዶታ ዱረት ፋርፈትና ሃራ ቶኮ ፋርፈተን። ፋርፈትና ሰነስ ነሞተ 144,000 ወረ ለፈራ ፉረመን ሰነ መሌ ነምን ቶኮዩ በረቹ ህንደንዴኜ። <verse eid="REV 14:3"/><verse number="4" style="v" sid="REV 14:4"/>እሳን ኩኔን ዋን ቁልቁልናን ኦፍ ኤገኒፍ ወረ ዱበርቶታን ኦፍ ህንጡሬስኒዸ። እሳንስ እዶ ሆልች ዸቁ ሁንዱመት እሰ ዱካ ቡኡ። ሰኚ ነማ ኬሳስ ሀንገፈ ተአኒ ዋቃፊ ሆልቻፍ ንፉረመን። <verse eid="REV 14:4"/><verse number="5" style="v" sid="REV 14:5"/>ሶብን ቶኮዩ አፋንሳኒ ኬሰት ህንአርገምኔ፤ እሳን ሙዳ ህንቀበን።<verse eid="REV 14:5"/></para>
  <para style="s1">ኤርገሞተ ሰደን</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6"/>አንስ ኤርገማ ብራ ከን ወረ ለፈረ ጅራተንት ጄቹንስ ሰበ ሁንደት፣ ጎሰ ሁንደት፣ አፋኒፊ ሰኚ ሁንደት ለለቡፍ ጄዼ ወንጌለ በረ በራ ቀበቴ ሰሚ ወለካ በርሱ ቶኮ ነንአርጌ። <verse eid="REV 14:6"/><verse number="7" style="v" sid="REV 14:7"/>እንስ ሰገሌ ጉዳዻን አከነ ጄዼ፤ “ሰኣቲን ሙርቲሳ ዋን ዽኣቴፍ ዋቀ ሶዳዻ፤ ኡልፍነስ እሳፍ ኬና። እሰ ሰሚፊ ለፈ፣ ገላናፊ ቡርቃወን ብሻኒ ኡሜ ሰናፍ ሰገዳ።”<verse eid="REV 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 14:8"/>ኤርገማን ለመፋንስ እት ኣንሴ፣ “ ‘ኩፍቴርት! ባብሎን ጉድቲን’ እሼን አከ ሰብን ሁንድ ዳዺ ወይኒ ዼከምሰ ሰጋገለሼ ዹጉ ጎቴ ሱን ኩፍቴርት” ጄዼ።<verse eid="REV 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9"/>ኤርገማን ዋቃ እን ሰደፋንስ እሳንት ኣንሴ ሰገሌ ጉዳዻን አከነ ጄዼ፤ “ነምን ከምዩ ብኔንስቻፊ ፈኪሳቲፍ ዮ ሰገዴ፣ መለቶሳስ አደሳረት ዮካን ሀርከሳረት ዮ ፉዸቴ፣ <verse eid="REV 14:9"/><verse number="10" style="v" sid="REV 14:10"/>እንስ አከሱመ ዳዺ ወይኒ ዼከምሰ ዋቃ እሰ ኡቱ ሆምቱ እት ህንመከምን ጦፎ ኣሪሳት ቡፈሜራ ንዹገ። ፉለ ኤርገሞተ ቁልቁሎታቲፊ ፉለ ሆልቻ ዱረትስ እብዳፊ ድኚዻን ንዽጰተ። <verse eid="REV 14:10"/><verse number="11" style="v" sid="REV 14:11"/>ኣር ዽጵነሳኒስ በረ በራ ሀመ በረ በራት ኦል በአ። ወር ብኔንስቻፊ ፈኪሳቲፍ ሰገደን ዮካን ወር መለቶ መቃሳ ፉዸተን ሁንድ ሀልከኒ ጉያ ቦቆና ህንቀባተን።” <verse eid="REV 14:11"/><verse number="12" style="v" sid="REV 14:12"/>ኩን ኦብሰ ቁልቁሎተ አጀጀ ዋቃ ኤገኒቲፊ ዬሱሲፍ አመነመኒ ጅራተኒ ጋፈተ።<verse eid="REV 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 14:13"/>አንስ ሰገሌ፣ “ዋን ከነ በሬስ፦ ስአች ወር ኡቱ ጎፍታዻን ጅረኑ ዱአን ኤብፈሞዸ” ጄዹ ቶኮ ሰሚራ ነንዸገኤ።</para>
  <para style="p" vid="REV 14:13">ሀፉር ቁልቁሉንስ፣ “ኤዬ፤ ሆጂንሳኒስ ዋን እሳን ዱካ ቡኡፍ እሳን ደዸቢሳኒራ ንቦቆቱ” ጄዸ።<verse eid="REV 14:13"/></para>
  <para style="s1">ሃመሙ ለፋቲፊ እዶን ጩንፋ ወይኒ ዽዺተሙሳ</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14"/>አንስ ነንእላሌ፤ ኩኖ፣ ዱሜሰ አዲ ቶኮቱ ቱሬ፤ እን “እልመ ነማ ፈካቱ”<note caller="+" style="f"><char style="fr" closed="false">14፥14 </char><char style="ft" closed="false"><char style="xt"><ref loc="DAN 7:13">ዳን 7፥13</ref></char></char></note> ቶኮስ ጎንፎ ወርቄ መታሳት ካአቴ፣ ሃምቱ ቀረማ ሀርከት ቀበቴ ዱሜሰረ ታኤ ቱሬ። <verse eid="REV 14:14"/><verse number="15" style="v" sid="REV 14:15"/>ኤርገማን ዋቃ ከን ብራስ መነ ቁልቁሉማቲ በኤ ሰገሌ ጉዳዻን እሰ ዱሜሰረ ታኤ ሰናን፣ “ምዻን ለፋ ዋን ብልቻቴፍ፣ ዬሮን ሃማስ ዋን ገኤፍ ሃምቱኬ ፉዸዹቲ ሃም” ጄዼ እዬ። <verse eid="REV 14:15"/><verse number="16" style="v" sid="REV 14:16"/>ከናፍስ እን ዱሜሰረ ታኤ ሱን ሃምቱሳ ለፈት ዻቤ፤ ለፍትስ ንሃመምቴ።<verse eid="REV 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17"/>ኤርገማን ዋቃ ከን ብራስ መነ ቁልቁሉማ እሰ ሰሚ ኬሳቲ በኤ፤ እንስ አከሱመ ሃምቱ ቀረማ ቀበ ቱሬ። <verse eid="REV 14:17"/><verse number="18" style="v" sid="REV 14:18"/>አመስ ኤርገማን ዋቃ ከን ብራ እን እብደረት ታይታ ቀቡ ቶኮ እዶ ኣርሳ ብራ ዹፌ፣ ሰገሌ ጉዳዻን ኤርገማ ሃምቱ ቀረማ ቀቡ ሰናን፣ “ሁርቡን ወይኒ ዋን ብልቻቴፍ ሃምቱኬ ቀረማ ሰነ ፉዸዹቲ ሁርቡ ወይኒ ለፋ ወልት ቀብ” ጄዼ። <verse eid="REV 14:18"/><verse number="19" style="v" sid="REV 14:19"/>ኤርገምችስ ሃምቱሳ ለፈት ዻቤ፤ ሁርቡ ወይኒ ለፋስ ወልት ቀቤ ገረ እዶ ጩንፋ ወይኒ ዼከምሰ ዋቃ እሰ ጉዳት ደርበቴ። <verse eid="REV 14:19"/><verse number="20" style="v" sid="REV 14:20"/>እሳንስ እዶ ጩንፋ ወይኒ ከን መጋላን አለ ጅሩ ኬሰት ዽዺተመን፤ እዶ ጩንፋ ሰነ ኬሳስ ዺግን ሀመ ሉገመ ፈርዳት ኦል ከኤ ፈጌኘ ገረ ኪሎ ሜትረ 300 ሎለኤ።<verse eid="REV 14:20"/></para>
  <chapter eid="REV 14"/>
  <chapter number="15" style="c" sid="REV 15"/>
  <para style="s1">ኤርገሞተ ቶርበ ከኔን ዸእቸወን ቶርበ ሀርካ ቀበን</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1"/>አንስ መለቶ ጉዳፊ ድንቅሲሳ ብራ ሰሚኬሰን አርጌ፤ መለቶን ኩንስ ኤርገሞተ ቶርበን ከኔን ዸእቸ ዹማ ቶርበ ቀበን ቱሬ፤ ዸእች ቶርበን ኩኔንስ ሰበቢ ዼከምስ ዋቃ እሳኒን ራወተሙፍ ዸእቸ ዹማ ጄዸመን። <verse eid="REV 15:1"/><verse number="2" style="v" sid="REV 15:2"/>አንስ ዋን ገላነ ብልሌ እብዳን መከሜ ፈካቱ ቶኮ ነንአርጌ፤ ወር ብኔንስቻፊ ፈኪሳ፣ ለኮብሰ መቃሳስ ሞአተን በገና ዋቅን እሳኒፍ ኬኔ ሀርከት ቀበተኒ ገላንቸ ብረ ዸዻበቻ ቱረን። <verse eid="REV 15:2"/><verse number="3" style="v" sid="REV 15:3"/>እሳንስ ፋርፈትና ሙሴ ገርብቸ ዋቃቲፊ ፋርፈትና ሆልቻ አከነ ጄዸኒ ፋርፈተን፦</para>
  <para style="q1" vid="REV 15:3">“ያ ዋቀ ጎፍታ ዋን ሁንዱማ ደንዴሱ፣</para>
  <para style="q2" vid="REV 15:3">ሆጂንኬ ጉዳፊ ድንቅሲሳዸ።</para>
  <para style="q1" vid="REV 15:3">ያ ሞቲ ሰቦታ፣</para>
  <para style="q2" vid="REV 15:3">ከራንኬ ቀጄላፊ ዹጋዸ።<verse eid="REV 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="REV 15:4"/>ያ ጎፍታ፣ ነምን ስ ህንሶዳትኔ፣</para>
  <para style="q2" vid="REV 15:4">ከን መቃኬስ ህንኡልፌስኔ ኤኙ?</para>
  <para style="q1" vid="REV 15:4">ስቆፈቱ ቁልቁሉዻቲ።</para>
  <para style="q1" vid="REV 15:4">ሆጂን ቀጄሉማኬቲ ዋን ሙልእፈሜፍ፣</para>
  <para style="q2" vid="REV 15:4">ሰቦትን ሁንድኑ ንዹፉ፤</para>
  <para style="q1" vid="REV 15:4">ፉለኬ ዱረትስ ንሰገዱ።”<verse eid="REV 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 15:5"/>ኤርገሲስ ነንእላሌ፤ መን ቁልቁሉማ እን ሰሚ ጄቹንስ ዱንካን ዹገ በኡ ንበነሜ። <verse eid="REV 15:5"/><verse number="6" style="v" sid="REV 15:6"/>መነ ቁልቁሉማ ሰነ ኬሳስ ኤርገሞትን ቶርበን ዸእቸ ቶርበ ቀበን ንበአን። እሳንስ ኡፈተ ቁልቁሉፊ ጨለቅሳ ቁንጬ ተልባራ ሆጄተሜ ኡፈተኒ ናኖ ቆመሳኒትስ ሰበተ ወርቄ ህዸተኒ ቱረን። <verse eid="REV 15:6"/><verse number="7" style="v" sid="REV 15:7"/>ኡመመወን ሉቡ ቀቤዪ አፍረን ኬሳስ እን ቶኮ ወጪቲወን ወርቄ ቶርበ ከኔን ዼከምሰ ዋቀ እሰ በረ በራ ሀመ በረ በራት ጅራቱቲን ጉተመን ኤርገሞተ ቶርበኒፍ ኬኔ። <verse eid="REV 15:7"/><verse number="8" style="v" sid="REV 15:8"/>መን ቁልቁሉማ ሱንስ ኣረ ኡልፍናፊ ሁምነ ዋቃ ኬሳ በኡን ጉተሜ፤ ሀመ ዸእች ቶርበን ኤርገሞተ ቶርበኒ ራወተሙትስ ኤኙዩ መነ ቁልቁሉማ ሰነ ሴኑ ህንደንዴኜ።<verse eid="REV 15:8"/></para>
  <chapter eid="REV 15"/>
  <chapter number="16" style="c" sid="REV 16"/>
  <para style="s1">ወጪቲወን ዼከምሰ ዋቃ ቶርበን</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1"/>አንስ ሰገሌ ጉዳ፣ ኤርገሞተ ቶርበኒን፣ “ዸቃቲ፣ ወጪቲወን ዼከምሰ ዋቃ ቶርበን ኬሳ ለፈረት ዸንገላሳ” ጄዹ ቶኮ መነ ቁልቁሉማ ኬሳ ነንዸገኤ።<verse eid="REV 16:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 16:2"/>ኤርገማን ዋቃ እን ጀልቀባ ዸቄ ወጪቲሳ ኬሳ ለፈረት ዸንገላሴ፤ ነሞተ መለቶ ብኔንስቻ ኦፍራ ቀበኒፊ ፈኪሳቲፍ ሰገደንትስ መዳን ሀማኒፊ ዹኩብሳን ንያኤ።<verse eid="REV 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3"/>ኤርገማን ለመፋን ወጪቲሳ ኬሳ ገላነት ዸንገላሴ፤ ገላንችስ ዺገ አከ ዺገ ነመ ዱኤ ተኤ፤ ሉቡ ቀቤዪን ገላነ ሰነ ኬሳ ሁንድኑስ ንዱአን።<verse eid="REV 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4"/>ኤርገማን ሰደፋን ወጪቲሳ ኬሳ ለጌኒፊ ቡርቃወን ብሻኒረት ዸንገላሴ፤ እሳንስ ዺገ ተአን። <verse eid="REV 16:4"/><verse number="5" style="v" sid="REV 16:5"/>ኤርገማን ብሻኖተረት እት ጋፈተሙማ ቀቡስ ኡቱ አከነ ጄዹ ነንዸገኤ፦</para>
  <para style="q1" vid="REV 16:5">“ያ እሰ ቁልቁሉ፣ ከን ጅርቱ፣ ከን ቱርቴ፣</para>
  <para style="q2" vid="REV 16:5">ሰበቢ ወንቶተ ከኔን ሙርቴስቴፍ፣ አት ቀጄላዸ፤<verse eid="REV 16:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 16:6"/>ዋን እሳን ዺገ ቁልቁሎታቲፊ ዺገ ራጆታ ዸንገላሰኒፍ፣</para>
  <para style="q2" vid="REV 16:6">አትሞ አከ እሳን ዹገኒፍ ዺገ እሳኒፍ ኬንቴርተ፤</para>
  <para style="q2" vid="REV 16:6">ኩን እሳኒፍ ንመላቲ።”<verse eid="REV 16:6"/></para>
  <para style="m">
    <verse number="7" style="v" sid="REV 16:7"/>አንስ ኡቱ እዶን ኣርሳ፣</para>
  <para style="q1" vid="REV 16:7">“ኤዬ ያ ዋቀዮ ጎፍታ ዋን ሁንደ ደንዴሱ፣</para>
  <para style="q2" vid="REV 16:7">ሙርቲንኬ ዹጋፊ ቀጄላዸ”</para>
  <para style="m" vid="REV 16:7">ጄዹ ነንዸገኤ።<verse eid="REV 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8"/>ኤርገማን አፉረፋንስ ወጪቲሳ ኬሳ አዱረት ዸንገላሴ፤ አዱዻፍስ አከ እሼን እብዳን ነመ ጉብዱፍ ሁምን ንኬነሜ። <verse eid="REV 16:8"/><verse number="9" style="v" sid="REV 16:9"/>ነሞትንስ ሆአ ጉዳ ሰናን ንጉበተን፤ መቃ ዋቀ ዸእቸ ከኔንረት ሁምነ ቀቡ ሰናስ ንአባረን፤ ቀልቢ ጅጂረቹፊ ኡልፍነ እሳፍ ኬኑስ ንድደን።<verse eid="REV 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10"/>ኤርገማን ሸነፋንስ ወጪቲሳ ኬሳ ቴሶ ብኔንስቻረት ዸንገላሴ፤ ሞቱማን ብኔንስቻስ ዱከናን ልቅምፈሜ። ነሞትንስ ዽጰቹዻን አረበሳኒ ጭጭኒነን፤ <verse eid="REV 16:10"/><verse number="11" style="v" sid="REV 16:11"/>ሰበቢ ዹኩቢፊ መዳሳኒቲፍስ ዋቀ ሰሚ ንአባረን፤ ገሩ ሆጂሳኒራ ቀልቢ ህንጅጂረትኔ።<verse eid="REV 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12"/>ኤርገማን ጀአፋንስ ወጪቲሳ ኬሳ ኤፍራጢስ ለግቸ ጉዳረት ዸንገላሴ፤ ብሻን ለገ ሰናስ ሞቶተ በአ ቢፍቱቲ ዹፈኒፍ አከ ከራን ቆጴፈሙፍ ንጎጌ። <verse eid="REV 16:12"/><verse number="13" style="v" sid="REV 16:13"/>ኤርገሲ አፋን ብኔንሰ ጀዌ ፈካቱ ሰና ኬሳ፣ አፋን ብኔንስቻ ኬሳፊ አፋን ራጂ ሶባ ኬሳ ሀፉሮትን ጡራኦን ፈቴ ፈካተን ሰዲ ኡቱ በአኑ ነንአርጌ። <verse eid="REV 16:13"/><verse number="14" style="v" sid="REV 16:14"/>እሳንስ ሀፉሮተ ሀፉረ ሀማ ከኔን ሆጂወን ድንቂ ሆጄተኒዸ፤ እሳንስ ሎለ ጉያ ጉድቻ ከን ዋቀ ዋን ሁንደ ደንደኡ ሰናቲፍ ወልት እሳን ቀቡፍ ገረ ሞቶተ አዱኛ ሁንዳት ከን በአኒዸ።<verse eid="REV 16:14"/></para>
  <para style="b"/>
  <para style="mi">
    <verse number="15" style="v" sid="REV 16:15"/>
    <char style="wj">“ኩኖ፣ አን አከ ሀቱት ነንዹፈ! ነምን አከ ቁላ ህንዴምኔፍ፣ አከ ቃኒንሳስ ህንሙልአትኔፍ ደመቄ ኡፈተሳ ኤገቱ ኤብፈማዸ።”</char><verse eid="REV 16:15"/></para>
  <para style="b"/>
  <para style="m">
    <verse number="16" style="v" sid="REV 16:16"/>እሳንስ እዶ አፋን እብራይስጢቲን አርማጌዶን ጄዸሙት ሞቶተ ሰነ ወልት ቀበን።<verse eid="REV 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 16:17"/>ኤርገማን ቶርበፋንስ ወጪቲሳ ኬሳ ቅሌንሰ ኬሰት ዸንገላሴ፤ ሰገሌን ጉዳን፣ “ራወተሜረ!” ጄዹ ቶኮስ መነ ቁልቁሉማቲ ቴሶ ኬሳ በኤ። <verse eid="REV 16:17"/><verse number="18" style="v" sid="REV 16:18"/>ኤርገሲስ በለቄን፣ ሰገሌን፣ ከከዌቲፊ ሶቺን ለፋ ሀማን ቶኮ ንተኤ። ሶቺን ለፋ ከን አከናስ ኤርገ ነምን ለፈረ ጅራቹ ጀልቀቤ ካሴ ተኩማ ተኤ ህንቤኩ፤ ሶቺን ለፋ ሱንስ አከ መሌ ጉዳ ቱሬ። <verse eid="REV 16:18"/><verse number="19" style="v" sid="REV 16:19"/>መጋለቲን ጉዶን እዶ ሰዲት ገርገር ቆደምቴ፤ መጋላወን ሰቦታስ ንኩፈን። ዋቅንስ ባብሎን ጉድቲ ንያደቴ፤ ጦፎ ዳዺ ወይኒ ዼከምሰሳ ሶዳችሳዻን ጉተሜስ ንኬኔፍ። <verse eid="REV 16:19"/><verse number="20" style="v" sid="REV 16:20"/>ብዮትን ብሻን ግዱ ሁንድኑ ንበቀተን፤ ቱሉወንስ አርገሙ ህንደንዴኜ። <verse eid="REV 16:20"/><verse number="21" style="v" sid="REV 16:21"/>ዸጋን ጨቢ ጉርጉዳን ቶኮን ቶኮንሳ ገረ ኪሎ ግራሚ አፉርተሚ ሸኒ ኡልፋቱ ሰሚራ ነሞተረ ቡቡኤ። ዸእች ሱንስ ዋን አከ መሌ ሀማ ቱሬፍ ነሞትን ሰበቢ ዸእቸ ጨቢ ሰናቲፍ ዋቀ ንአባረን።<verse eid="REV 16:21"/></para>
  <chapter eid="REV 16"/>
  <chapter number="17" style="c" sid="REV 17"/>
  <para style="s1">ዱበርትቲ ብኔንስቸ ያበቱ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1"/>ኤርገሞተ ቶርበን ወጪቲወን ቶርበ ቀበን ኬሳ እን ቶኮ ገረኮ ዹፌ አከነ ናን ጄዼ፤ “ኮቱ! አደበ ሰጋገልትቲ ጉድቲ እሼ ብሻኖተ ባይኤረ ቴሱ ሰነረት ራወተሙፍ ጅሩ ስትን አርግሲሳ። <verse eid="REV 17:1"/><verse number="2" style="v" sid="REV 17:2"/>ሞቶትን ለፋ እሼ ወጅን ሰጋገለኒሩ፤ ወር ለፈረ ጅራተንስ ዳዺ ወይኒ ሰጋገለሼቲን መቻአኒሩ።”<verse eid="REV 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3"/>ኤርገማን ዋቃ ሱንስ ሀፉረ ቁልቁሉዻን ነ ፉዼ ገሞጂት ነ ጌሴ። አችትስ ዱበርቲ ብኔንሰ ብልዲማ መቃ አረብሶቲን ጉተሜ ቶኮረ ቴሱ ነንአርጌ፤ ብኔንስችስ መታ ቶርባፊ ጋንፈ ኩዸን ቀበ ቱሬ። <verse eid="REV 17:3"/><verse number="4" style="v" sid="REV 17:4"/>ዱበርትቲንስ ኡፈተ ዺልጌፊ ብልዲማ ኡፈቴ ወርቄን፣ ዸጋ ገቲ ጉዳቲፊ ሉላን ሚዸግፈምቴ ቱርቴ። ሀርከሼትስ ጦፎ ወርቄ ከን ዋን ጅብሲሳፊ ጡራኡማ ሰጋገለሼቲን ጉተሜ ቀበቴ ቱርቴ። <verse eid="REV 17:4"/><verse number="5" style="v" sid="REV 17:5"/>አደሼረትስ መቃን እጪቲ ከን አከነ ጄዹ ቶኮ በሬፈሜ ቱሬ፦</para>
  <para style="pc" vid="REV 17:5">ባብሎን ጉድቲ፣</para>
  <para style="pc" vid="REV 17:5">ሃዸ ሰጋገልቶታፊ</para>
  <para style="pc" vid="REV 17:5">ሃዸ ዋን ጅብሲሳ ለፋ።<verse eid="REV 17:5"/></para>
  <para style="m">
    <verse number="6" style="v" sid="REV 17:6"/>አከ ዱበርትቲን ዺገ ቁልቁሎታቲፊ ዺገ ወረ ዬሱሲፍ ዹጋ በአኒቲን መቾፍቴ ነንአርጌ።</para>
  <para style="p" vid="REV 17:6">አንስ ዮሙ እሼ አርጌት ባይኤን ዋቃ ድንቅፈዼ። <verse eid="REV 17:6"/><verse number="7" style="v" sid="REV 17:7"/>ኤርገምችስ አከነ ናን ጄዼ፤ “አት ማሊፍ ድንቅፈተ? እጪቲ ዱበርትቲፊ እጪቲ ብኔንስቸ እሼ ባቱ ከን መታ ቶርባፊ ጋንፈ ኩዸን ቀቡ ሰና ስት ነንህመ። <verse eid="REV 17:7"/><verse number="8" style="v" sid="REV 17:8"/>ብኔንስ አት አርግቴ ሱን ዱር ቱሬ፤ አመ ገሩ ህንጅሩ፤ ቦዴ ገሩ ቦለ ቅሌ ኬሳ ኦል በኤ ገረ በዲሰሳ ንዸቀ። ወር ለፈረ ጅራተን ከኔን መቃንሳኒ ኡመመ አዱኛቲ ጀልቀቤ ክታበ ጅሬኛ ኬሰት ህንገልሜፈምን ዮሙ ብኔንስቸ አርገንት ንድንቅሲፈቱ፤ ሰበቢንሳስ ብኔንስች ዱር ቱሬ፤ አመ ገሩ ህንጅሩ፤ ቦዴ ገሩ ንዹፈ።<verse eid="REV 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 17:9"/>“ኩንስ ሰሙ ኦጉማ ቀቡ ጋፈተ። መታወን ቶርበን ሱንስ ቱሉወን ቶርበን ዱበርትቲን እረ ቴሱዸ። <verse eid="REV 17:9"/><verse number="10" style="v" sid="REV 17:10"/>አከሱመስ መታወን ቶርበን ሱን ሞቶተ ቶርበ። እሳን ኬሳስ ሸን ኩፈኒሩ፤ እን ቶኮ ጅረ፤ እን ካንሞ አመሌ ህንዹፍኔ፤ ዮሙ ዹፉት ገሩ ዬሮ ገባባፍ ቱሩ ቀበ። <verse eid="REV 17:10"/><verse number="11" style="v" sid="REV 17:11"/>ብኔንስች ዱራን ቱሬ አመሞ ህንጅሬ ሱን ሞቲ ሰዴተፋዸ። እን ሞቶተ ቶርበን ኬሳ ቶኮዸ፤ ገረ በዲሰሳስ ንዸቀ።<verse eid="REV 17:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 17:12"/>“ጋንፈወን ኩርነን አት አርግቴ ሱን ሞቶተ ኩርነን ወረ አመሌ ሞቱማ ህንአርገትኒዸ፤ ተኡስ እሳን ብኔንስቸ ወጅን ሰኣቲ ቶኮ አከ ሞቶታት ሞኡፍ ታይታ ንፉዸቱ። <verse eid="REV 17:12"/><verse number="13" style="v" sid="REV 17:13"/>እሳንስ ያዱመ ቶኮ ቀቡ፤ ሁምነሳኒቲፊ ታይታሳኒስ ደበርሰኒ ብኔንስቻፍ ንኬኑ። <verse eid="REV 17:13"/><verse number="14" style="v" sid="REV 17:14"/>እሳንስ ሆልቸት ሎለ ንካሱ፤ ሆልች ገሩ ዋን ጎፍታ ጎፍቶታቲፊ ሞቲ ሞቶታ ተኤፍ እሳን ሞአተ፤ ወር እሰ ወጅን ጅረንስ ወረ እሳፍ ዋመመን፣ ወረ እሳፍ ፍለተመኒፊ ወረ እሳፍ አመነመኒዸ።”<verse eid="REV 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 17:15"/>ኤርገማን ሱንስ አከነ ናን ጄዼ፤ “ብሻኖትን አት አርግቴ ከኔን ሰጋገልትቲን እረ ቴሱ ሱን ሰቦተ፣ ነሞተ፣ ሰኚወኒፊ አፋኖተ። <verse eid="REV 17:15"/><verse number="16" style="v" sid="REV 17:16"/>ብኔንስቺፊ ጋንፈወን ኩርነን አት አርግቴ ሱን ሰጋገልትቲ ንጅቡ። እሳንስ እሼ ኦንሰኒ ቁላሼ ሀምብሱ፤ ፎንሼ ንኛቱ፤ እብዳንስ እሼ ጉቡ። <verse eid="REV 17:16"/><verse number="17" style="v" sid="REV 17:17"/>እሳንስ ሀመ ዱቢን ዋቃ ፊጣን በኡትስ ወሊ ገሉዻን ታይታሳኒ ደበርሰኒ ብኔንስቻፍ ኬኑዻን አከ ካዮ ዋቃ ራወተኒፍ ዋቅን ያደ ከነ ገራሳኒ ኬሰ ካኤራቲ። <verse eid="REV 17:17"/><verse number="18" style="v" sid="REV 17:18"/>ዱበርትቲን አት አርግቴ ሱን መጋለቲ ጉዶ ሞቶተ ለፋ ቡልችቱዸ።”<verse eid="REV 17:18"/></para>
  <chapter eid="REV 17"/>
  <chapter number="18" style="c" sid="REV 18"/>
  <para style="s1">ኩፋቲ ባብሎኒቲፍ ቦኡ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1"/>ኤርገሲስ ኡቱ ኤርገማን ብራ ሰሚራ ገድ ቡኡ ነንአርጌ። እንስ ታይታ ጉዳ ቀበ ቱሬ፤ ኡልፍነሳቲንስ ለፍት ንእፍቴ። <verse eid="REV 18:1"/><verse number="2" style="v" sid="REV 18:2"/>እንስ አከነ ጄዼ ሰገሌ ጉዳዻን እዬ፦</para>
  <para style="q1" vid="REV 18:2">“ኩፍቴርት! ባብሎን ጉድቲን ኩፍቴርት!</para>
  <para style="q2" vid="REV 18:2">ለፈ ጅሬኘ ሀፉሮተ ሀሞ፣</para>
  <para style="q1" vid="REV 18:2">ለፈ ቁበተ ሀፉሮተ ጡራኦ ሁንዳ፣</para>
  <para style="q2" vid="REV 18:2">እዶ ጅሬኘ ስምብሮተ ጡራኦ፣</para>
  <para style="q2" vid="REV 18:2">እዶ ጅሬኘ ብኔንሶተ ጡራኦፊ <optbreak/> ጅብሲሶ ሁንዳ ታቴርት።<verse eid="REV 18:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="REV 18:3"/>ሰቦትን ሁንድኑስ፣</para>
  <para style="q2" vid="REV 18:3">ዳዺ ወይኒ ዼከምሰ ሰጋገለሼ ዹገኒሩቲ።</para>
  <para style="q1" vid="REV 18:3">ሞቶትን ለፋስ እሼ ወጅን ሰጋገለኒሩ፤</para>
  <para style="q2" vid="REV 18:3">ደልደልቶትን አዱኛስ ቀነኒሼ <optbreak/> ጉዳ ሰናን ሶሮመኒሩ።”<verse eid="REV 18:3"/></para>
  <para style="b"/>
  <para style="s1">ሙርቲ ባብሎን ጀላ ምልቁ</para>
  <para style="p">
    <verse number="4" style="v" sid="REV 18:4"/>ሰገሌ ብራስ ሰሚራ ነንዸገኤ፤ እንስ አከነ ጄዸ፦</para>
  <para style="q1" vid="REV 18:4">“ ‘ያ ሰበኮ፣ እስን አከ ጩቡሼ ኬሰት ህንህርማትኔፍ፣</para>
  <para style="q2" vid="REV 18:4">በላ እሼረ ገኡስ አከ ህንቆደትኔፍ፣</para>
  <para style="q2" vid="REV 18:4">ኮታ እሼ ኬሳ በኣ፤’<note caller="+" style="f"><char style="fr" closed="false">18፥4 </char><char style="ft" closed="false"><char style="xt"><ref loc="JER 51:45">ኤር 51፥45</ref></char></char></note><verse eid="REV 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 18:5"/>ጩቡንሼ ሀመ ሰሚት ኦል ቱለሜራቲ፤</para>
  <para style="q2" vid="REV 18:5">ዋቅንስ ጀልእነሼ ያደቴረ።<verse eid="REV 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 18:6"/>አኩመ እሼን ኬንቴት እስንስ እሼፍ ኬና፤</para>
  <para style="q2" vid="REV 18:6">አኩመ ሆጂሼትስ ደቻ ለመ ጎዻቲ እሼፍ ዴብሳ።</para>
  <para style="q2" vid="REV 18:6">ጦፎ እሼን እት ቡልቡልቴትስ ደቻ ለመ ጎዻቲ እሼፍ ቡልቡላ።<verse eid="REV 18:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 18:7"/>ሀሙመ እሼን ኡልፍነ ኦፊ ኬንቴ ቀነኒ ጉዳዻን ጅራቴ ሰነ፣</para>
  <para style="q2" vid="REV 18:7">ቅጤዹመሳ ዽጵናፊ ገደ እሼፍ ኬና።</para>
  <para style="q1" vid="REV 18:7">እሼንስ ገራሼ ኬሰት፣</para>
  <para style="q2" vid="REV 18:7">‘አን አከ ሞትቲ ቶኮት ነንታአ፤</para>
  <para style="q1" vid="REV 18:7">አን ሃዸ ህዬሳ ምት፤</para>
  <para style="q2" vid="REV 18:7">ጎንኩማስ ህንገዱ’ ጄቴ ኦፍ ጀጅ።<verse eid="REV 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 18:8"/>ከናፉ ዸእች ገራ ገራ ጄቹንስ፣</para>
  <para style="q2" vid="REV 18:8">ዱት፣ ገዲፊ ቤል ጉዩመ ቶኮት እሼረ ንገአ።</para>
  <para style="q1" vid="REV 18:8">ዋቅን ጎፍታን እሼት ሙርቴሱ ሱን ዋን ጀባ ተኤፍ፣</para>
  <para style="q2" vid="REV 18:8">እሼን እብዳን ንጉበምት።<verse eid="REV 18:8"/></para>
  <para style="s1">ዋኤ ኩፋቲ ባብሎኒቲፍ ወዮ</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9"/>“ሞቶትን ለፋ ወር እሼ ወጅን ሰጋገለኒፊ ወር ቀነኒ ጉዳዻን እሼ ወጅን ጅራተን ዮሙ ኣረ ጉበሙሼ አርገንት እሼፍ ንቦኡ፤ ንወዋቱስ። <verse eid="REV 18:9"/><verse number="10" style="v" sid="REV 18:10"/>እሳንስ ዽጵነሼ ዋን ሶዳተኒፍ ፈጎ ዻበተኒ፣</para>
  <para style="q1" vid="REV 18:10">“ ‘ወዮ! ወዮ! ያ መጋላ ጉድቲ፣</para>
  <para style="q2" vid="REV 18:10">ያ ባብሎን መጋለቲ ጀብዱ!</para>
  <para style="q1" vid="REV 18:10">በዲንኬ ሰኣቱመ ቶኮ ኬሰት ዹፌራቲ!’ ጄዹ።<verse eid="REV 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 18:11"/>“ደልደልቶትን ለፋስ ስአች ዋን ነምን ቶኮዩ ምአ ደልደለሳኒ ህንብትኔፍ እሼፍ ንቦኡ፤ ንወዋቱስ። <verse eid="REV 18:11"/><verse number="12" style="v" sid="REV 18:12"/>ምእ ደልደለሳኒስ ወርቄ፣ ሜቲ፣ ዸጋወን ገቲ ጉዳቲፊ ሉለ፣ ኡፈተ ሀጲ ቁንጬ ተልባራ ሆጄተሜ፣ ኡፈተ ዺልጌ፣ ኡፈተ ሃሪቲፊ ብልዲማ፣ ሙከ ኡርጋኣ ጎሰ ሁንዳ፣ ምአ እልከ አርባራ ሆጄተሜ ሁንደ፣ ምአ ሙከ ገቲ ጉዳራ ሆጄተሜ ሁንደ፣ ምአ ናሲራ ሆጄተሜ ሁንደ፣ ምአ ስቢላቲፊ ምአ ዸጋ አዲራ ሆጄተሜ ሁንዳፊ <verse eid="REV 18:12"/><verse number="13" style="v" sid="REV 18:13"/>ቀረፋፊ ኡርጎፍቱ፣ እጣነ፣ ቁምቢ፣ ሀጴ ኡርጋኣ፣ ዳዺ ወይኒቲፊ ዘይቲ ኤጄርሳ፣ ዳኩ ቡላኣፊ ቀመዲ፣ ሎወኒፊ ሆሎተ፣ ፈርዴኒፊ ጋሪወን፣ አከሱመስ ገርቦታፊ ሉቡወን ነሞታ ፈእ።<verse eid="REV 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 18:14"/>“እሳንስ፣ ‘እጅ ዋን አት ሀውቴ ሰና ስ ዱራ በዴረ። በዻዹማፊ በሬድንኬ ሁንድኑ ስራ በዴረ፤ ጎንኩማስ ዴብቴ ህንአርገቱ’ እሼዻን ጄዹ። <verse eid="REV 18:14"/><verse number="15" style="v" sid="REV 18:15"/>ደልደልቶትን ምአ ከኔን ጉርጉረተኒ እሼራ በዻዹማ አርገተንስ ዽጵነሼ ሶዳተኒ ፈጎ ዻበቱ። እሳንስ ቦኣ፣ ወዋቻስ፣ <verse eid="REV 18:15"/><verse number="16" style="v" sid="REV 18:16"/>ሰገሌ ጉዳዻን አከነ ጄዹ፦</para>
  <para style="q1" vid="REV 18:16">“ ‘ወዮ! ወዮ፣ ያ መጋላ ጉድቲ፤</para>
  <para style="q2" vid="REV 18:16">ያ እሼ ኡፈተ ሀጲ ቁንጬ ተልባራ ሆጄተሜ፣</para>
  <para style="q2" vid="REV 18:16">ኡፈተ ዺልጌፊ ኡፈተ ብልዲማ ኡፈቴ፣</para>
  <para style="q1" vid="REV 18:16">ያ እሼ ወርቄዻን፣</para>
  <para style="q2" vid="REV 18:16">ዸጋ ገቲ ጉዳቲፊ ሉላን ሚዸግፈምቴ!<verse eid="REV 18:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="REV 18:17"/>በዻዹማን ጉዳን አከና ሰኣቱመ ቶኮ ኬሰት በርበዳኤ!’</para>
  <para style="p" vid="REV 18:17">“አጀጁን ዶኒ ሁንድኑ፣ ወር ዶኒን እመለ ዴመን ሁንድኑ፣ ወር ዶኒረ ሆጄተኒፊ ወር ገላነረ ሆጄቹን ጅራተን ሁንድኑ ፈጋተኒ ንዻበቱ። <verse eid="REV 18:17"/><verse number="18" style="v" sid="REV 18:18"/>እሳን ዮሙ ኣረ ጉበሙሼ አርገንት፣ ‘መጋላን አከ መጋላ ጉድቲ ከና ጅራቴ ቤክቲ?’ ጄዸኒ እዩ። <verse eid="REV 18:18"/><verse number="19" style="v" sid="REV 18:19"/>እሳንስ አዋረ መታት ፍርፍርፈተኒ ቦኣ፣ ወዋቻስ አከነ ጄዸኒ እዩ፦</para>
  <para style="q1" vid="REV 18:19">“ ‘ወዮ! ወዮ፣ ያ መጋላ ጉድቲ፣</para>
  <para style="q2" vid="REV 18:19">ያ እሼ ወር ገላነራ ዶኒወን ቀበን ሁንድኑ</para>
  <para style="q2" vid="REV 18:19">ቀቤኘሼቲን ሶሮመን!</para>
  <para style="q1" vid="REV 18:19">እሼ ሰኣቱመ ቶኮ ኬሰት በርበዶፍቴ!’<verse eid="REV 18:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="REV 18:20"/>“ያ ሰሚ ኩፋቲሼት ገመድ!</para>
  <para style="q2" vid="REV 18:20">እስን ሰብን ዋቃ ገመዳ!</para>
  <para style="q1" vid="REV 18:20">ኤርገሞትኒፊ ራጆትን ገመዳ!</para>
  <para style="q2" vid="REV 18:20">ዋቅን እሼረት እስኒፍ ሙሬራቲ።”<verse eid="REV 18:20"/></para>
  <para style="s1">ጡሙረ በዲሰ ባብሎን</para>
  <para style="p">
    <verse number="21" style="v" sid="REV 18:21"/>ኤርገማን ጀባን ቶኮስ ዸጋ ሀመ ዸጋ ዳኩ ገኡ ቶኮ ፉዼ ገላነት ገድ ደርበቴ አከነ ጄዼ፦</para>
  <para style="q1" vid="REV 18:21">“ባብሎን መጋላ ጉድቲን፣</para>
  <para style="q2" vid="REV 18:21">አከሱመ ፉርጉግፈምቴ ንደርበተምት፤</para>
  <para style="q2" vid="REV 18:21">ጎንኩማስ ዴብቴ ህንአርገምቱ።<verse eid="REV 18:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="REV 18:22"/>ሰገሌን ወረ በገናፊ ሙዚቃ ተጰተኒ፣</para>
  <para style="q2" vid="REV 18:22">ሰገሌን ወረ ኡሉሌፊ መለከተ አፉፈኒ</para>
  <para style="q2" vid="REV 18:22">ስአች ስ ኬሰት ህንዸገአሙ።</para>
  <para style="q1" vid="REV 18:22">ኦጌስ ኦጉማ ሆጂ ሀርካ ቶኮሌ፣</para>
  <para style="q2" vid="REV 18:22">ስአች ስ ኬሰት ህንአርገሙ።</para>
  <para style="q1" vid="REV 18:22">ሰገሌን ዸጋ ዳኩስ፣</para>
  <para style="q2" vid="REV 18:22">ስአች ስ ኬሰት ህንዸገአሙ።<verse eid="REV 18:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="REV 18:23"/>እፍን እብሳ፣ ለመተ ስ ኬሰት ህንእፉ።</para>
  <para style="q2" vid="REV 18:23">ሰገሌን ምስርቻቲፊ ምስርቲ፣</para>
  <para style="q2" vid="REV 18:23">ለመተ ስ ኬሰት ህንዸገአሙ።</para>
  <para style="q1" vid="REV 18:23">ደልደልቶትንኬ ነሞተ ጉርጉዳ አዱኛ ቱረን።</para>
  <para style="q2" vid="REV 18:23">ፈልፈለኬቲን ሰብን ሁንድኑ ጎዎምፈሜረ።<verse eid="REV 18:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="REV 18:24"/>ዺግን ራጆታቲፊ ዺግን ቁልቁሎታ፣</para>
  <para style="q2" vid="REV 18:24">ዺግን ወረ ለፈረት ጎረአመን ሁንዱማስ <optbreak/> እሼ ኬሰት አርገሜ።”<verse eid="REV 18:24"/></para>
  <chapter eid="REV 18"/>
  <chapter number="19" style="c" sid="REV 19"/>
  <para style="s1">ሰበቢ ኩፋቲ ባብሎኒቲፍ ገለተ ገልቹ!</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1"/>ከነ ቦዴ ዋን አከ ሁርሳ ሰገሌ ቱተ ነሞታ ጉዳ ቶኮ ሰሚራ ነንዸገኤ፤ እንስ አከነ ጄዸ፦</para>
  <para style="q1" vid="REV 19:1">“ሃሌሉያ!</para>
  <para style="q1" vid="REV 19:1">ፈይን፣ ኡልፍኒፊ ሁምን ከን ዋቀኬኛት፤<verse eid="REV 19:1"/></para>
  <para style="q2">
    <verse number="2" style="v" sid="REV 19:2"/>ሙርቲንሳ ዹጋፊ ቀጄላዻቲ።</para>
  <para style="q1" vid="REV 19:2">እን ሰጋገልትቲ ጉዶ፣</para>
  <para style="q2" vid="REV 19:2">እሼ ሰጋገልቱማ እሼቲን ለፈ ጡሬስቴ ሰነት ሙሬረ፤</para>
  <para style="q1" vid="REV 19:2">ዺገ ገርቦተሳቲፍስ እሼት ሃሎ በኤረ።”<verse eid="REV 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 19:3"/>አመስ፣</para>
  <para style="q1" vid="REV 19:3">“ሃሌሉያ!</para>
  <para style="q1" vid="REV 19:3">ኣርሼስ በረ በራ ሀመ በረ በራት ኦል ንበአ”</para>
  <para style="m" vid="REV 19:3">ጄዸኒ እየን።<verse eid="REV 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 19:4"/>ማንጉዶትን ድግደሚ አፍረኒፊ ኡመመወን ሉቡ ቀቤዪን አፍረን ኩፈኒ ዋቀ ቴሶረ ታኤ ጅሩ ሰናፍ ሰገደን፤ ሰገሌ ጉዳዻንስ፣</para>
  <para style="q1" vid="REV 19:4">“አሜን፤ ሃሌሉያ!” ጄዸን።<verse eid="REV 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 19:5"/>ኤርገሲስ ሰገሌን፣</para>
  <para style="q1" vid="REV 19:5">“እስን ገርቦትንሳ ሁንድኑ፣</para>
  <para style="q2" vid="REV 19:5">ወር እሰ ሶዳተን፣</para>
  <para style="q1" vid="REV 19:5">ጥናንስ ጉዳንስ፣</para>
  <para style="q2" vid="REV 19:5">ዋቀኬኘ ጀጀዻ”</para>
  <para style="m" vid="REV 19:5">ጄዹ ቶኮ ቴስቸ ኬሳ ንበኤ።<verse eid="REV 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 19:6"/>አንስ ኡቱ ሰገሌን አከ ሰገሌ ቱተ ነመ ባይኤ፣ አከ ሰገሌ ብሻን ባይኤቲፊ አከ ሰገሌ ከከዌ ጉዳን ቶኮ አከነ ጄዹ ነንዸገኤ፦</para>
  <para style="q1" vid="REV 19:6">“ሃሌሉያ!</para>
  <para style="q2" vid="REV 19:6">ዋቅንኬኘ ጎፍታን ዋን ሁንደ ደንደኡ ሞኤራቲ።<verse eid="REV 19:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 19:7"/>ኮታ ንገመድና፤ ንእልልችነስ፤</para>
  <para style="q2" vid="REV 19:7">ኡልፍነስ እሳፍ ንኬንነ!</para>
  <para style="q1" vid="REV 19:7">ዬሮን ፉዸ ሆልቻ ገኤራቲ፤</para>
  <para style="q2" vid="REV 19:7">ምስርቲንሳስ ኦፍ ቆጴስቴርት።<verse eid="REV 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 19:8"/>አከ ኡፈቱፍስ ኡፈትን ሀጲን ቁንጬ ተልባራ ሆጄተሜ፣</para>
  <para style="q2" vid="REV 19:8">አዲፊ ቁልቁሉን እሼዻፍ ኬነሜረ።”</para>
  <para style="m" vid="REV 19:8">ኡፈትን ሀጲን ቁንጬ ተልባራ ሆጄተሜ ሱን ሆጂ ቁልቁሎታ እሰ ቀጄላ ሰነ አርግሲሰ።<verse eid="REV 19:8"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9"/>ኤርገማን ዋቃ ሱንስ፣ “ ‘ወር ገረ እርባተ ጭዸ ፉዸ ሆልቻት አፌረመን ኤብፈሞዸ!’ ጄዺ በሬስ” ናን ጄዼ፤ እንስ፣ “ዱቢን ኩን ዱቢ ዋቃ እሰ ዹጋዸ” ናን ጄዼ።<verse eid="REV 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 19:10"/>አንስ እሳፍ ሰገዱፍ ጄዼ ሚለሳረትን ኩፌ። እን ገሩ አከነ ናን ጄዼ፤ “ናፍ ህንሰገድን! አንስ ገርብቸ ስኢፊ ኦቦሎተኬ ወረ ዬሱሲፍ ዹጋ በአን ወጅን ተጃጅሉዸ። ዋቃፍ ሰገድ! ዹገ በኡምስ ዬሱስ ሀፉረ ራጂቲ።”<verse eid="REV 19:10"/></para>
  <para style="s1">ሎልቱን ሰሚ ብኔንስቸ ሞአቹሳ</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11"/>አንስ ሰሚ በነሜ ነንአርጌ፤ ኩኖ፣ ፈርደ አዲ ቶኮቱ ቱሬ፤ እን ፈርደ ሰነ ያበቱስ አመነማፊ ዹጋ ጄዸመ። እንስ ቀጄሉማዻን ሙርቴሰ፤ ወራነ ካሰስ። <verse eid="REV 19:11"/><verse number="12" style="v" sid="REV 19:12"/>እጅሳ አከ አረበ እብዳት፤ መታሳረስ ጎንፎ ባይኤቱ ጅረ። እንስ መቃ እሰረት በሬፈሜ ከን እሰ መሌ ነምን ቶኮዩ ህንቤክኔ ቶኮ ቀበ። <verse eid="REV 19:12"/><verse number="13" style="v" sid="REV 19:13"/>እንስ ኡፈተ ዺገ ኬሰ ጩጰሜ ቶኮ ኡፈተ፤ መቃንሳስ ዱቢ ዋቃ ጄዸመ። <verse eid="REV 19:13"/><verse number="14" style="v" sid="REV 19:14"/>ሎልቶትን ሰሚራስ ኡፈተ ሀጲ ቁንጬ ተልባራ ሆጄተሜ አዳዲፊ ቁልቁሉ ኡፈተኒ፣ ፈርዴን አዳዲ ያበተኒ እሰ ዱካ ቡአን። <verse eid="REV 19:14"/><verse number="15" style="v" sid="REV 19:15"/>አፋንሳ ኬሳስ ጎራዴ ቀረማ እን እቲን ሰቦተ ዸኡ ቶኮቱ በአ፤ “እንስ ቦኩ ስቢላቲን እሳን ቡልቸ።”<note caller="+" style="f"><char style="fr" closed="false">19፥15 </char><char style="ft" closed="false"><char style="xt"><ref loc="PSA 2:9">ፋር 2፥9</ref></char></char></note> እዶ ጩንፋ ወይኒ ዼከምሰ ሶዳችሳ ዋቀ ዋን ሁንደ ደንደኡ ሰናስ ንዽዺተ። <verse eid="REV 19:15"/><verse number="16" style="v" sid="REV 19:16"/>እንስ ኡፈተሳቲፊ ጉዴደሳረት መቃ በሬፈሜ ቶኮ ቀበ፤ መቃን ሱንስ አከነ ጄዸ፦</para>
  <para style="pc" vid="REV 19:16">ሞቲ ሞቶታፊ ጎፍታ ጎፍቶታ።<verse eid="REV 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17"/>ኤርገማ ቶኮስ ኡቱ እን አዱረ ዻበቱ ነንአርጌ፤ እንስ ሰገሌ ጉዳዻን ስምብሮተ ሰሚ ወለካ በርሰንት አከነ ጄዼ እዬ፤ “ኮታ፣ እርባተ ዋቃ እሰ ጉዳፍ ወልት ቀበማ፤ <verse eid="REV 19:17"/><verse number="18" style="v" sid="REV 19:18"/>ኩንስ አከ እስን ፎን ሞቶታ፣ ፎን አጀጆተ ወራና፣ ፎን ነሞተ ጀጀቦ፣ ፎን ፈርዴኒቲፊ ፎን ወረ ፈርደ ያበተኒ አከሱመስ ፎን ነመ ሁንዳ ጄቹንስ ፎን ነመ ብርመዱ ተኤቲፊ ገርባ፣ ፎን ጥናቲፊ ጉዳ ኛተኒፍ።”<verse eid="REV 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19"/>ዬሮ ሰነስ ብኔንስች፣ ሞቶትን ለፋቲፊ ሎልቶትንሳኒ ነምቸ ፈርደ ያበቱ ሰናፊ ሎልቶተሳት ወራነ ካሱፍ ጄዸኒ ኡቱ ወልት ቀበመኑ ነንአርጌ። <verse eid="REV 19:19"/><verse number="20" style="v" sid="REV 19:20"/>ብኔንስች ገሩ ንቀበሜ፤ ራጅች ሶባ ከን ፉለ ብኔንስቻ ዱረት ሆጂወን ድንቂ ሆጄቻ ቱሬ ሱንስ እሰ ወጅን ቀበሜ። እንስ ሆጂወን ድንቂ ከኔኒን ወረ መለቶ ብኔንስቻ ፉዸተኒፊ ወረ ፈኪሳቲፍ ሰገደን ንጎዎምሴ። እሳን ለቹ ኡቱመ ሉቡን ጅረኑ ሀሮ እብዳ ከን ድኚዻን ቦበኡ ኬሰት ገድ ደርበተመን። <verse eid="REV 19:20"/><verse number="21" style="v" sid="REV 19:21"/>ወር ሀፈንሞ ጎራዴ አፋን እሰ ፈርደ ያበቱ ሰና ኬሳ በኤን አጄፈመን፤ አላቲን ሁንድኑስ ፎንሳኒ ኛተኒ ቁፈን።<verse eid="REV 19:21"/></para>
  <chapter eid="REV 19"/>
  <chapter number="20" style="c" sid="REV 20"/>
  <para style="s1">ወጋ ኩመ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1"/>ኡቱ ኤርገማን ቶኮ ፉርቱ ቦለ ቅሌቲፊ ፎንጫ ጉዳ ቶኮ ሀርከት ቀበቴ ሰሚራ ገድ ቡኡ ነንአርጌ። <verse eid="REV 20:1"/><verse number="2" style="v" sid="REV 20:2"/>ኤርገማን ሱንስ ብኔንስቸ ጀዌ ፈካቱ፣ ቦፈ ዱሪ ሰነ ጄቹንስ ዲያብሎስ ዮካን ሴጠነ ቀቤ ወጋ ኩመ ቶኮ ህዼ። <verse eid="REV 20:2"/><verse number="3" style="v" sid="REV 20:3"/>ሀመ ወጋን ኩማ ሱን ዹሙትስ አከ እን ዴብኤ ሰቦተ ህንጎዎምስኔፍ ቦለ ቅሌት ገድ እሰ ደርበቴ እት ጩፌ። ቻፓስ እረት ቻፔሴ፤ ኤርገሲሞ ዬሮ ገባባዻፍ ሂከሙ ቀበ።<verse eid="REV 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4"/>አንስ ቴሶወን ነንአርጌ፤ ወር አከ ሙርቲ ኬነኒፍ ታይታን ኬነሜፍ ቴሶወን ሰነረ ታአኒ ቱረን። ሉቡወን ነሞተ ሰበቢ ዬሱሲፍ ዹጋ በአኒፊ ሰበቢ ዱቢ ዋቃቲፍ ጄዸኒ ጎረአመኒስ ነንአርጌ። እሳንስ ብኔንስቻፍ ዮካን ፈኪ ብኔንስቻቲፍ ህንሰገድኔ፤ መለቶሳስ አደሳኒረት ዮካን ሀርከሳኒረት ህንፉዸትኔ። እሳንስ ዱኣ ከአኒ ክርስቶስ ወጅን ወጋ ኩመ ቶኮ ሞአን። <verse eid="REV 20:4"/><verse number="5" style="v" sid="REV 20:5"/>ወር ዱአን ካን ገሩ ሀመ ወጋን ኩምን ሱን ዹሙት ዴብአኒ ሉቡዻን ህንጅራትኔ። ኩንስ ዱኣ ከኡ ጀልቀባት። <verse eid="REV 20:5"/><verse number="6" style="v" sid="REV 20:6"/>ወር ዱኣ ከኡ ጀልቀባ ኬሰት ቆደ ቀበን ኤብፈሞፊ ቁልቁሎተ። ወር አከሲ ሉቦተ ዋቃቲፊ ሉቦተ ክርስቶስ ተአኒ ወጋ ኩመ ቶኮ እሰ ወጅን ሞኡ መሌ ዱት ለመፋን እሳንረት ታይታ ህንቀቡ።<verse eid="REV 20:6"/></para>
  <para style="s1">ሴጠነት ሙረሙሳ</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7"/>ዮሙ ወጋን ኩምን ሱን ዹሙት ሴጠን እዶ እት ህዸሜ ቱሬ ኬሳ ገድ ዺፈመ፤ <verse eid="REV 20:7"/><verse number="8" style="v" sid="REV 20:8"/>እንስ ሰቦተ ጎሌ ለፋ አፍረን ጅረን ጄቹንስ ጎጊፊ ማጎግን ጎዎምሱፍ ንበአ፤ ሁንዱመሳኒስ ወራናፍ ወልት ንቀበ። ባይእንሳኒስ አከ ጭረቸ ቀርቀረ ገላናት። <verse eid="REV 20:8"/><verse number="9" style="v" sid="REV 20:9"/>እሳንስ ለፈ ሁንደረት ፈፈጨአኒ ቁበተ ቁልቁሎታቲፊ መጋለቲ ጃለተምቱ መርሰን። ገሩ እብድ ሰሚራ ገድ ቡኤ እሳን ፍጤ። <verse eid="REV 20:9"/><verse number="10" style="v" sid="REV 20:10"/>ዲያብሎስ እን እሳን ጎዎምሴ ሱንስ ገረ ሀሮ ድኚ ቦበኡት እዶ ብኔንስቺፊ ራጅች ሶባ እት ደርበተመን ሰነት ገድ ደርበተሜ። እሳንስ በረ በራ ሀመ በረ በራት ሀልከኒ ጉያ ንዽጵፈሙ።<verse eid="REV 20:10"/></para>
  <para style="s1">ወረ ዱአንት ሙረሙሳ</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11"/>አንስ ቴሶ አዲ ጉዳ ቶኮፊ እሰ ቴስቸረ ታኤ ነንአርጌ። ለፍቲፊ ሰሚን ፉለሳ ዱራ ንበቀተን፤ እዶንስ እሳኒፍ ህንአርገምኔ። <verse eid="REV 20:11"/><verse number="12" style="v" sid="REV 20:12"/>ወር ዱአንስ ጥና ጉዳን ፉለ ቴስቻ ዱረ ዻበተኒ ነንአርጌ፤ ክታቦትንስ ንበነመን፤ አከሱመስ ክታብን ብራ ጄቹንስ ክታብን ጅሬኛ ንበነሜ። ወረ ዱአንስ አኩመ ክታቦተ ኬሰት ገልሜፈሜት፣ አኩመ ሆጂ እሳን ዱራን ሆጄተኒት ሙርቲን ንኬነሜፍ። <verse eid="REV 20:12"/><verse number="13" style="v" sid="REV 20:13"/>ገላንስ ወረ ዱአን ከኔን እሰ ኬሰ ቱረን ኦፍ ኬሳ ባሴ ኬኔ፤ ዱቲፊ ሲኦልስ ወረ ዱአን ከኔን እሳን ኬሰ ቱረን ኦፍ ኬሳ ባሰኒ ኬነን፤ ነምን ሁንድስ አኩመ ሆጂሳት ሙርቲ አርገቴ። <verse eid="REV 20:13"/><verse number="14" style="v" sid="REV 20:14"/>ኤርገሲስ ዱቲፊ ሲኦል ሀሮ እብዳት ገድ ደርበተመን። ሀሮትን እብዳ ኩንስ ዱአ ለመፋት። <verse eid="REV 20:14"/><verse number="15" style="v" sid="REV 20:15"/>ነምን መቃንሳ ክታበ ጅሬኛ ኬሰት ህንገልሜፈምን ከምዩ ሀሮ እብዳት ገድ ደርበተሜ።<verse eid="REV 20:15"/></para>
  <chapter eid="REV 20"/>
  <chapter number="21" style="c" sid="REV 21"/>
  <para style="s1">ሰሚ ሃራፊ ለፈ ሃራ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1"/>አንስ ኤርገሲ ሰሚ ሃራፊ ለፈ ሃራ<note caller="+" style="f"><char style="fr" closed="false">21፥1 </char><char style="ft" closed="false"><char style="xt"><ref loc="ISA 65:17">እሳ 65፥17</ref>፤ <ref loc="2PE 3:13">2ጴጥ 3፥13</ref></char></char></note> ነንአርጌ፤ ሰሚን ዱራቲፊ ለፍት ዱራ ሱን በደኒሩቲ፤ ገላንስ ስአች ህንጅራቱ። <verse eid="REV 21:1"/><verse number="2" style="v" sid="REV 21:2"/>አንስ መጋላ ቁልቁልቲን ዬሩሳሌም ሃራን አኩመ ምስሮ ዽርሰሼቲፍ ሚዸግፈምቴት ቆጶፍቴ ሰሚ ኬሳ ዋቀ ብራ ኡቱ ገድ ቡቱ ነንአርጌ። <verse eid="REV 21:2"/><verse number="3" style="v" sid="REV 21:3"/>ሰገሌ ጉዳ ቴሶ ኬሳ አከነ ጄዹ ቶኮስ ነንዸገኤ፤ “ኩኖ፣ እዶን ዋቅን ጅራቱ ነሞተ ግዱዸ፤ እንስ እሳን ወጅን ጅራተ። እሳን ሰበሳ ንተኡ፤ ዋቅን መታንሳስ እሳን ወጅን ንጅራተ፤ ዋቀሳኒስ ንተአ። <verse eid="REV 21:3"/><verse number="4" style="v" sid="REV 21:4"/>እን እምማን ሁንደ እጀሳኒራ ንሀቀ። ስአች ዱት ዮካን ገድ ዮካን ቦእች ዮካን ዽጵን ህንጅራቱ፤ ስርን ሞፋን ሱን ደርቤራቲ።”<verse eid="REV 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5"/>እን ቴሶ ሰነረ ታኤስ፣ “ኩኖ፣ አን ዋን ሁንደ ነንሃሮምሰ!” ጄዼ፤ እንስ፣ “ዱቢን ኩን ዋን አመነማፊ ዹጋ ተኤፍ፣ ከነ በሬስ” ናን ጄዼ።<verse eid="REV 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 21:6"/>እንስ አከነ ናን ጄዼ፦ “ራወተሜረ። አልፋፊ ኦሜጋን፣ ጀልቀባፊ ዹምን አኑመ። አን ነመ ዼቦቴፍ ቡርቃ ብሻን ጅሬኛራ ቶለ ነንኬነ። <verse eid="REV 21:6"/><verse number="7" style="v" sid="REV 21:7"/>እን ሞኡ ዋን ከነ ሁንደ ንዻለ፤ አን ዋቀሳ ነንተኣፍ፤ እንስ እልመኮ ንተአ። <verse eid="REV 21:7"/><verse number="8" style="v" sid="REV 21:8"/>ገሩ ቆድን ሶዳቶታ፣ ከን ወረ አመንቲ ህንቀብኔ፣ ከን ጡራኦታ፣ ከን ወረ ነመ አጄሰኒ፣ ከን ሀለሌወኒ፣ ከን ወረ ፈልፈለ ሆጄተኒ፣ ከን ወረ ዋቆተ ቶልፈሞ ዋቄፈተኒቲፊ ከን ሶብዱወን ሁንዳ ሀሮ እብዳቲፊ ድኚ ቦበኡ ኬሰ ተአ፤ ኩንስ ዱአ ለመፋት።”<verse eid="REV 21:8"/></para>
  <para style="s1">ዬሩሳሌም ምስርቲ ሆልቻ</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9"/>ኤርገሞተ ቶርበን ወረ ወጪቲ ቶርበን ዸእቸ ዹማ ቶርበኒን ጉተመን ቀበን ኬሳስ እን ቶኮ ዹፌ፣ “ኮቱ፣ ምስርቲ ኒቲ ሆልቻ ስት ነንአርግሲሳቲ” ናን ጄዼ። <verse eid="REV 21:9"/><verse number="10" style="v" sid="REV 21:10"/>እንስ ሀፉራን ነ ፉዼ ቱሉ ጉዳፊ ዼራ ቶኮት ነ ጌሴ፤ ኡቱ ዬሩሳሌም መጋላ ቁልቁልቲን ሰሚ ኬሳ ዋቀ ብራ ገድ ቡቱ ነት አርግሲሴ። <verse eid="REV 21:10"/><verse number="11" style="v" sid="REV 21:11"/>እሼንስ ኡልፍነ ዋቃቲን ንእብስት ቱርቴ፤ ጩሉሉቅንሼስ አኩመ ጩሉሉቀ ዸጋ ገቲ ጉዳ፣ አከ ዸጋ ያስጲዲ ቁልቁሉ አከ ብልሌ ቱሬ። <verse eid="REV 21:11"/><verse number="12" style="v" sid="REV 21:12"/>መጋለቲንስ ደላ ጉዳፊ ኦል ዼራ ከረ ኩዸ ለመ ቀቡ ቀብድ ቱርቴ። ከረወን ሰነረስ ኤርገሞተ ኩዸ ለመቱ ዻበቴ ቱሬ፤ ከረ ኩዸ ለማን ሰነረትስ መቃን ጎሶተ እስራኤል ኩዸ ለማኒ በሬፈሜ ቱሬ። <verse eid="REV 21:12"/><verse number="13" style="v" sid="REV 21:13"/>ከራ በአ ቢፍቱቲን ከረ ሰዲ፣ ከራ ካባቲን ከረ ሰዲ፣ ከራ ክባቲን ከረ ሰዲ፣ ከራ ልጠ ቢፍቱቲንስ ከረ ሰዲቱ ቱሬ። <verse eid="REV 21:13"/><verse number="14" style="v" sid="REV 21:14"/>ደላን መጋለቲስ ሁንዴ ኩዸ ለመ ቀበ ቱሬ፤ ሁንዴወን ሰነረትስ መቃን ኤርገሞተ ሆልቻ ኩዸ ለማኒ በሬፈሜ ቱሬ።<verse eid="REV 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 21:15"/>ኤርገማን ነት ዱበቴ ሱንስ መጋለቲ፣ ከረወንሼቲፊ ደላወንሼ ሰፈሩዻፍ ኡሌ ሰፈርቱ ከን ወርቄ ቀበ ቱሬ። <verse eid="REV 21:15"/><verse number="16" style="v" sid="REV 21:16"/>መጋላን ሱንስ ጎሌ አፉር ቀብድ ቱርቴ፤ ዼርንሼቲፊ ገራንሼ ወል ቅጤ ቱሬ። ኤርገማን ሱንስ ኡሌሳቲን መጋለቲ ሰፈሬ፤ በልእንሼስ ገረ ኪሎ ሜትረ 2,200 ተኤ፤ ዼርንሼ፣ ገራንሼቲፊ ኦል ዼርንሼስ ወል ቅጤ ቱሬ። <verse eid="REV 21:16"/><verse number="17" style="v" sid="REV 21:17"/>ደላ መጋለቲስ ንሰፈሬ፤ እንስ አከ ሰፈረ ነማ ከን ኤርገምች እቲን ሰፈራ ቱሬ ሰናት ዹንዹመ 144 ተኤ። <verse eid="REV 21:17"/><verse number="18" style="v" sid="REV 21:18"/>ደላን ሱን ዸጋ ያስጲዲቲን እጃረሜ፤ መጋላን ሱንሞ ወርቄ ቁልቁሉ አከ ብልሌ ቁልቁሉ ተኤን እጃረምቴ። <verse eid="REV 21:18"/><verse number="19" style="v" sid="REV 21:19"/>ሁንዴወን ደላ መጋላ ሰናስ ዸጋ ገቲ ጉዳ ጎሰ ሁንዱማቲን ሚዸግፈመን። ሁንዴን ጀልቀባ ያስጲዲን፣ ለመፋን ሰንፔሪን፣<note caller="+" style="f"><char style="fr" closed="false">21፥19 </char><char style="fq" closed="false">ሰንፔሪን </char><char style="ft" closed="false">– ዸጋ ገቲ ጉዳ ከን ብፈ ጩቁሊሳ ቀቡ።</char></note> ሰደፋን ኬልቄዶኒን፣<note caller="+" style="f"><char style="fr" closed="false">21፥19 </char><char style="fq" closed="false">ኬልቄዶኒን </char><char style="ft" closed="false">– ዸጋ ገቲ ጉዳ ከን ብፈ አደ አዳ፣ ዬሮ ባይኤ መገሪሳ (ሀዾ)።</char></note> አፉረፋንሞ መረግዲን<note caller="+" style="f"><char style="fr" closed="false">21፥19 </char><char style="fq" closed="false">መረግዲን </char><char style="ft" closed="false">– ዸጋ መገሪሰ ገቲ ጉዳ።</char></note> ሚዸግፈሜ፤ <verse eid="REV 21:19"/><verse number="20" style="v" sid="REV 21:20"/>እን ሸነፋን ሰርዶንክሲን፣<note caller="+" style="f"><char style="fr" closed="false">21፥20 </char><char style="fq" closed="false">ሰርዶንክሲን </char><char style="ft" closed="false">– ዸጋ ገቲ ጉዳ ከን ብፈ አደ አዳ፣ ዬሮ ባይኤ ዲማ።</char></note> ጀአፋን ሰርድዮኒን፣<note caller="+" style="f"><char style="fr" closed="false">21፥20 </char><char style="fq" closed="false">ሰርድዮኒን </char><char style="ft" closed="false">– ዸጋ ገቲ ጉዳ ከን ዬሮ ባይኤ ዲማ።</char></note> ቶርበፋን ክርስቶሎቤን፣<note caller="+" style="f"><char style="fr" closed="false">21፥20 </char><char style="fq" closed="false">ክርስቶሎቤን </char><char style="ft" closed="false">– ዸጋ ወርቄ ፈካቱ።</char></note> ሰዴተፋን ቢረሌን፣<note caller="+" style="f"><char style="fr" closed="false">21፥20 </char><char style="fq" closed="false">ቢረሌን </char><char style="ft" closed="false">– ዬሮ ባይኤ ብፈ ጩቁሊሰ አከ መገሪሳት፤ አከሱመስ ብፈ አደ አዳ ቀበ።</char></note> ሰግለፋን ዉራዉሬን፣<note caller="+" style="f"><char style="fr" closed="false">21፥20 </char><char style="fq" closed="false">ዉራዉሬን </char><char style="ft" closed="false">– ዬሮ ባይኤ ብፍቲሳ ኬሎ ፈካተ።</char></note> ኩርነፋን ክርስጵራስሲን፣<note caller="+" style="f"><char style="fr" closed="false">21፥20 </char><char style="fq" closed="false">ክርስጵራስሲን </char><char style="ft" closed="false">– ዸጋ መገሪሰ።</char></note> ኩዸ ቶኮፋን ያክንቲን፣<note caller="+" style="f"><char style="fr" closed="false">21፥20 </char><char style="fq" closed="false">ያክንቲን </char><char style="ft" closed="false">– ዸጋ ዲማ ቡርቱካነ ፈካቱ።</char></note> ኩዸ ለመፋንሞ አሜቴስጥኖሲን<note caller="+" style="f"><char style="fr" closed="false">21፥20 </char><char style="fq" closed="false">አሜቴስጥኖሲን </char><char style="ft" closed="false">– ዸጋ ዺልጌ ዮካን ጉራቸ።</char></note> ሚዸግፈሜ። <verse eid="REV 21:20"/><verse number="21" style="v" sid="REV 21:21"/>ከረወን ኩዸ ለማን ሉለ ኩዸ ለመ ቱረን፤ ቶኮን ቶኮን ከረ ሰናስ ሉለ ቶኮራ ሆጄተሜ። ዳንዲን መጋላ ሰናስ ወርቄ ቁልቁሉ አኩመ ብልሌ ኬሳን ዋ አርገሙት።<verse eid="REV 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 21:22"/>ዋቅን ጎፍታን ዋን ሁንደ ደንደኡፊ ሆልች መነ ቁልቁሉማሼ ዋን ተአኒፍ አን መጋለቲ ኬሰት መነ ቁልቁሉማ ቶኮሌ ህንአርግኔ። <verse eid="REV 21:22"/><verse number="23" style="v" sid="REV 21:23"/>አዱን ዮካን ጅእ መጋለቲፍ እብሱን ህንበርባችሱ፤ ኡልፍን ዋቃ እፈ ኬናፊቲ፤ ሆልችስ እብሳሼት። <verse eid="REV 21:23"/><verse number="24" style="v" sid="REV 21:24"/>ሰቦትን እፈሼቲን ዴዴብኡ፤ ሞቶትን ለፋስ ኡልፍነሳኒ ገረሼት ፍዱ። <verse eid="REV 21:24"/><verse number="25" style="v" sid="REV 21:25"/>ሰበቢ ሀልከን አች ህንጅሬፍ ከረወን መጋለቲ ጎንኩማ ጉያ ቶኮዩ ህንጩፈመን። <verse eid="REV 21:25"/><verse number="26" style="v" sid="REV 21:26"/>ኡልፍናፊ ከበጀ ሰቦታ ገረሼ ንፍዱ። <verse eid="REV 21:26"/><verse number="27" style="v" sid="REV 21:27"/>ወረ መቃንሳኒ ክታበ ጅሬኛ ከን ሆልቻ ኬሰት ገልሜፈሜ መሌ ወን ጡራኣን ቶኮዩ ዮካን ነምን ዋን ጅብሲሳ ሆጄቱ ዮካን ነምን ነመ ሶቡ ከምዩ መጋላ ሰነ ህንሴኑ።<verse eid="REV 21:27"/></para>
  <chapter eid="REV 21"/>
  <chapter number="22" style="c" sid="REV 22"/>
  <para style="s1">ኤድን ለግን ጅሬኛ እዶሳት ዴብፈሙሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 22:1"/>ኤርገማን ሱንስ ለገ ብሻን ጅሬኛ፣ ቁልቁሉ አከ ብልሌ ከን ቴሶ ዋቃቲፊ ሆልቻ ኬሳ ቡርቁ ቶኮ ነት አርግሲሴ፤ <verse eid="REV 22:1"/><verse number="2" style="v" sid="REV 22:2"/>ብሻን ሱንስ ወለካ ዳንዲ መጋለቲረ ያኣ ቱሬ። ገማ ገመነ ለግቻረስ ሙክን ጅሬኛ እጀ ጎሰ ኩዸ ለመ ነቀቱ ዻበቴ ቱሬ፤ እንስ ጅኡመ ጅኣን እጀ ነቀተ ቱሬ። ባል ሙከ ሰናስ ሰቦተ ፈይሰ ቱሬ። <verse eid="REV 22:2"/><verse number="3" style="v" sid="REV 22:3"/>ስአች አባርስ ቶኮዩ ህንጅራቱ። ቴሶን ዋቃቲፊ ሆልቻ መጋለቲ ኬሰት አርገመ፤ ገርቦትንሳስ እሰ ተጃጅሉ። <verse eid="REV 22:3"/><verse number="4" style="v" sid="REV 22:4"/>እሳን ፉለሳ ንአርጉ፤ መቃንሳስ አደሳኒረት ንአርገመ። <verse eid="REV 22:4"/><verse number="5" style="v" sid="REV 22:5"/>ስአች ሀልከን ህንጅሩ። እፍን እብሳ ዮካን እፍን ቢፍቱ እሳን ህንበርባችሱ፤ ዋቅን ጎፍታን እፈ እሳኒፍ ኬናቲ። እሳንስ በረ በራ ሀመ በረ በራት ንሞኡ።<verse eid="REV 22:5"/></para>
  <para style="s1">ዮሀንሲፊ ኤርገማ</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6"/>ኤርገማን ዋቃ ሱንስ፣ “ዱቢን ኩን አመነማፊ ዹጋዸ። ጎፍታን፣ ዋቅን ሀፉሮተ ራጆታ ሱን ዋን ደፌ ተኡ ቀቡ ገርቦተሳት አርግሲሱፍ ጄዼ ኤርገማሳ ኤርጌረ” ናን ጄዼ።<verse eid="REV 22:6"/></para>
  <para style="s1">ዬሱስ ንዹፈ</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 22:7"/>
    <char style="wj">“ኩኖ፣ አን ደፌ ነንዹፈ! ነምን ዱቢ ራጂ ክታበ ከነ ኬሰ ጅሩ ኤጉ ኤብፈማዸ።”</char><verse eid="REV 22:7"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="8" style="v" sid="REV 22:8"/>ከን ወንቶተ ከኔን ዸገኤፊ አርጌ አነ ዮሀንስ። አንስ ዮሙ ወንቶተ ከኔን ዸገኤ አርጌት ኤርገማ ወንቶተ ከኔን ነት አርግሲሳ ቱሬ ሰናፍ ሰገዱዻፍ ሚለሳረትን ኩፌ። <verse eid="REV 22:8"/><verse number="9" style="v" sid="REV 22:9"/>እን ገሩ፣ “ከነ ህንጎዽን! አንስ ገርብቸ ስኢፊ ኦቦሎተኬ ራጆተ ወጅን፣ አከሱመስ ወረ ዱቢ ክታበ ከና ኤገን ወጅን ተጃጅሉዸ። ዋቃፍ ሰገድ!” ናን ጄዼ።<verse eid="REV 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 22:10"/>እን አከነ ናን ጄዼ፤ “ሰበቢ ዬሮን ሱን ዽኣቴፍ ዱቢ ራጂ ክታበ ከና ቻፓዻን ህንጩፍን። <verse eid="REV 22:10"/><verse number="11" style="v" sid="REV 22:11"/>ጀልኣን ጀልእነሳት ሃፉፉ፤ ጡራኣን ጡራኡማሳት ሃፉፉ፤ ቀጄላንስ ቀጄሉማሳት ሃፉፉ፤ ቁልቁሉንሞ ቁልቁሉማሳት ሃፉፉ።”<verse eid="REV 22:11"/></para>
  <para style="b"/>
  <para style="s1">ዋምቻፊ አኬከቺሰ ዹማ</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 22:12"/>
    <char style="wj">“ኩኖ፣ አን ደፌ ነንዹፈ! ገቲንኮ ነ ብረ ጅረ፤ ቶኮ ቶኮ ነማቲፍስ አኩመ ሆጂሳት ነንኬነ።</char> <verse eid="REV 22:12"/><verse number="13" style="v" sid="REV 22:13"/><char style="wj">አን አልፋፊ ኦሜጋዸ፤ እሰ ዱራቲፊ እሰ ቦዴት፤ እሰ ጀልቀባቲፊ እሰ ዹማትስ።</char><verse eid="REV 22:13"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="14" style="v" sid="REV 22:14"/>
    <char style="wj">“ወር አከ ሙከ ጅሬኛረት ምርገ ቀባተኒፊ አከ ከረወኒን መጋለቲ ሴነኒፍ ኡፈተሳኒ ሚጨተን ኤብፈሞዸ።</char> <verse eid="REV 22:14"/><verse number="15" style="v" sid="REV 22:15"/><char style="wj">ገሩ ሰሮትን፣ ፈልፈልቶትን፣ ሀለሌወን፣ ወር ነመ አጄሰኒፊ ወር ዋቆተ ቶልፈሞ ዋቄፈተን አከሱመስ ወር ሶበ ጃለተኒፊ ወር ሶበ ዱበተን ሁንድኑ አለት ሀፉ።</char><verse eid="REV 22:15"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="16" style="v" sid="REV 22:16"/>
    <char style="wj">“አን ዬሱስ፣ አከ እን ወንቶተ ከኔን ወልዶተ ክርስታና ኬሰት ዹጋ እስኒ በኡፍ ኤርገማኮ ኤርጌረ። አን ህዳፊ ሰኚ ዳዊት፣ በከልቸ በሪ ከን እፉዸ።”</char><verse eid="REV 22:16"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="17" style="v" sid="REV 22:17"/>ሀፉርቺፊ ምስርቲን፣ “ኮቱ!” ጄዹ፤ ነምን ዸገኡስ፣ “ኮቱ!” ሃጄዹ፤ ነምን ዼቦቴ ሃዹፉ፤ ከን በርባዱ ብሻን ጅሬኛ ቶለ ሃፉዸቱ።<verse eid="REV 22:17"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18"/>ነመ ዱቢ ራጂ ክታበ ከና ዸገኡ ሁንደ ነንአኬከቺሰ፦ ዮ ነምን ከምዩ ዱቢ ከነት ዋን ቶኮሌ ደበሌ፣ ዋቅን ዸእቸወን ክታበ ከነ ኬሰት እብሰመን እሰት ደበለ። <verse eid="REV 22:18"/><verse number="19" style="v" sid="REV 22:19"/>ነምን ከምዩ ዮ ዱቢ ክታበ ራጂ ከነ ኬሳ ዋን ቶኮሌ ህርእሴ፣ ዋቅን ሙከ ጅሬኛቲፊ መጋለቲ ቁልቁሉ ክታበ ከነ ኬሰት እብሰመን ኬሳ ቆደሳ ህርእሰ።<verse eid="REV 22:19"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="20" style="v" sid="REV 22:20"/>እን ዋን ከነ ዹጋ በኡስ፣ <char style="wj">“ኤዬ፣ አን ደፌ ነንዹፈ”</char> ጄዸ።</para>
  <para style="p" vid="REV 22:20">አሜን። ያ ጎፍታ ዬሱስ ኮቱ።<verse eid="REV 22:20"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="21" style="v" sid="REV 22:21"/>አያን ጎፍታ ዬሱስ ቁልቁሎተ ሁንዱማ ወጅን ሃተኡ። አሜን።<verse eid="REV 22:21"/></para>
  <chapter eid="REV 22"/>
</usx>
