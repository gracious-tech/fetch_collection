<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="ECC" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">ለለበ</para>
  <para style="toc1">ክታበ ለለባ</para>
  <para style="toc2">ለለበ</para>
  <para style="toc3">ለለ</para>
  <para style="mt2">ክታበ</para>
  <para style="mt1">ለለባ</para>
  <chapter number="1" style="c" sid="ECC 1"/>
  <para style="s1">ወንት ሁንድኑ ፋይዳ ህንቀቡ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 1:1"/>ዱቢ ለለባ እልመ ዳዊት፣ እሰ ዬሩሳሌም ኬሳት ሞቲ ተኤ ሰና፦<verse eid="ECC 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 1:2"/>ለለብች፣</para>
  <para style="q2" vid="ECC 1:2">“ፋይዳ ህንቀቡ! ፋይዳ ህንቀቡ!</para>
  <para style="q1" vid="ECC 1:2">ጉቱማን ጉቱት ፋይዳ ህንቀቡ!</para>
  <para style="q2" vid="ECC 1:2">ወን ሁንድኑ ፋይዳ ህንቀቡ” ጄዸ።<verse eid="ECC 1:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 1:3"/>ነምን ሆጂሳ ከን አዱዻ ገድት እት ደዸቡ ሁንደ ኬሳ፣</para>
  <para style="q2" vid="ECC 1:3">ቡኣ ማሊ አርገተ?<verse eid="ECC 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 1:4"/>ዸሎትን ንዹፈ፤ ዸሎትን ንደርበ፤</para>
  <para style="q2" vid="ECC 1:4">ለፍት ገሩ በረ በራን ጅራት።<verse eid="ECC 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 1:5"/>ቢፍቱን ንባት፤ ቢፍቱን ንልጥ፤</para>
  <para style="q2" vid="ECC 1:5">ገረ ባቴ ሰነት ዴብኡፍስ ንአሪፈት።<verse eid="ECC 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 1:6"/>ቡቤን ገረ ክባት ቡብሰ፤</para>
  <para style="q2" vid="ECC 1:6">ገረ ካባትስ ንዴብአ፤</para>
  <para style="q1" vid="ECC 1:6">እንስ ናነኡመ ናነኤ ዴመ፤</para>
  <para style="q2" vid="ECC 1:6">ከራሳረስ ዴዴብአ።<verse eid="ECC 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 1:7"/>ለግን ሁንድ ገላነት ያአ፤</para>
  <para style="q2" vid="ECC 1:7">ገላን ገሩ ህንጉቱ።</para>
  <para style="q1" vid="ECC 1:7">ለጌን ገሩመ ዹፈንት</para>
  <para style="q2" vid="ECC 1:7">ዴብአኒ ያኡ።<verse eid="ECC 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 1:8"/>ወን ሁንድኑ</para>
  <para style="q2" vid="ECC 1:8">ሀመ ነምን ቶኮ ዱበቹ ደንደኡ ጫላ ደዸብሲሳዸ።</para>
  <para style="q1" vid="ECC 1:8">እጅ አርጌ ህንቁፉ፤</para>
  <para style="q2" vid="ECC 1:8">ዮካን ጉር ዸገኤ ህንጉቱ።<verse eid="ECC 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 1:9"/>ወን ዱራን ቱሬ አመስ ንተአ፤</para>
  <para style="q2" vid="ECC 1:9">ወን ዱራን ሆጄተሜ አመስ ንሆጄተመ፤</para>
  <para style="q2" vid="ECC 1:9">አዱዻ ገድት ወን ሃራን ቶኮዩ ህንጅሩ።<verse eid="ECC 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 1:10"/>ወን ነምን ቶኮ፣</para>
  <para style="q2" vid="ECC 1:10">“እላ! ወን ኩን ሃራዸ” ጄቹ ደንደኡ ከምዩ ጅራ?</para>
  <para style="q1" vid="ECC 1:10">ወን ኩን ዱራኑ በረ ዼራን ዱረ አስ ቱሬ፤</para>
  <para style="q2" vid="ECC 1:10">በረኬኛን ዱረዩ አሱመ ቱሬ።<verse eid="ECC 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 1:11"/>ነሞትን በረ ዱሪ ህንያደተመን፤</para>
  <para style="q2" vid="ECC 1:11">ከኔን ዹፉፍ ጅረንስ <optbreak/> ወረ እሳን ዱባን ዹፈኒን ህንያደተመን።<verse eid="ECC 1:11"/></para>
  <para style="s1">ኦጉማን ፋይዳ ህንቀቡ</para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 1:12"/>አን ለለባን፣ ዬሩሳሌም ኬሰት ሞቲ እስራኤልን ቱሬ። <verse eid="ECC 1:12"/><verse number="13" style="v" sid="ECC 1:13"/>አን ዋን ሰሚ ገድት ሆጄተሜ ሁንደ ኦጉማዻን ቁአዼ ቆረዼ ብረ ገኡፍ ኦፍ ኬኔን ቱሬ። ዋቅን በኣ ኡልፋታ አከሚ ነመረ ካኤ! <verse eid="ECC 1:13"/><verse number="14" style="v" sid="ECC 1:14"/>አን ዋን አዱዻ ገድት ሆጄተሜ ሁንደ አርጌረ፤ ሁንድሳኒዩ ፋይዳ ህንቀበን፤ ኩን አኩመ ነመ ቡቤ አርኡት።<verse eid="ECC 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 1:15"/>ወን ጀልእፈሜ ቶኮ ዴብኤ ህንቀጄልፈሙ፤</para>
  <para style="q2" vid="ECC 1:15">ወን ህንጅሬስ ለካአሙ ህንደንደኡ።<verse eid="ECC 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 1:16"/>አንስ አከነ ጄዼን ያዴ፤ “ኩኖ፣ አን ነመ አናን ዱረ ዬሩሳሌምን ቡልቻ ቱሬ ከምዩ ጫላ ጉደዼ ኦጉማስ ደበለዼረ፤ አን ሙጠኖ ኦጉማቲፊ ቤኩምሳ ጉዳ አርገዼረ።” <verse eid="ECC 1:16"/><verse number="17" style="v" sid="ECC 1:17"/>ከናፉ አን ኦጉማ፣ መራቱማፊ ጎዉማ ሁበቹፍን ኦፍ ኬኔ፤ ገሩ አን አከ ወን ኩንስ ቡቤ አርኡ ተኤ ነንበረዼ።<verse eid="ECC 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 1:18"/>ኦጉማ ጉዳ ኬሰ ገደ ባይኤቱ ጅራቲ፤</para>
  <para style="q2" vid="ECC 1:18">አኩመ ቤኩምስ ደበለሙን ገድስ ደበለመ።<verse eid="ECC 1:18"/></para>
  <chapter eid="ECC 1"/>
  <chapter number="2" style="c" sid="ECC 2"/>
  <para style="s1">ገመቹን ፋይዳ ህንቀቡ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 2:1"/>አን ገራኮ ኬሰት፣ “አን ዋን ጋሪ በርባዱዻፍ ገመቹዻን ስን ቆራቲ ሜ ኮቱ” ጄዼን ያዴ። ገሩ ወን ኩንስ ዋን ፋይዳ ህንቀብኔ ተኡሳ ነንምርከኔፈዼ። <verse eid="ECC 2:1"/><verse number="2" style="v" sid="ECC 2:2"/>አንስ፣ “ኮልፍ ጎዉማዸ፤ ገመቹንስ ማል ፈየደ?” ነንጄዼ። <verse eid="ECC 2:2"/><verse number="3" style="v" sid="ECC 2:3"/>አንስ ኡቱመ ቀልቢንኮ ኦጉማዻን ነ ቀጄልቻ ጅሩ ጎዉማ ቀበዼ ዳዺ ወይኒቲን ኦፍ ገመቺሱ ነንያሌ። ነሞትን በረ ጅሬኘሳኒ ሙራሰ ኬሰት ሰሚ ገድት ዋን ጋሪ ጎቹን እሳኒፍ ተኡ አርጉ ነንፌዼ።<verse eid="ECC 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 2:4"/>አን ሆጂ ጉዳ ነንሆጄዼ፦ መኔን እጃረዼ ወይኒስ ዻበዼ። <verse eid="ECC 2:4"/><verse number="5" style="v" sid="ECC 2:5"/>አን እዶ ብቅልቱቲፊ እዶ በሸነና ቆጴፈዼ ሙኬን እጀ ነቀተን ከኔን ጎሰ ሁንዳ አች ኬሰ ነንዻበዼ። <verse eid="ECC 2:5"/><verse number="6" style="v" sid="ECC 2:6"/>ቦሶነ ሙኬን ጉደቻ ጅረኒ እቲን ኦባፈቹፍስ ኩሳ ብሻኒ ነንቆጴፈዼ። <verse eid="ECC 2:6"/><verse number="7" style="v" sid="ECC 2:7"/>አን ገርቦተ ዺራፊ ዱበርቲ ነንብተዼ፤ ገርቦተ መነኮት ዸለተን ብራስ ነንቀባዼ፤ ነመ ናን ዱረ ዬሩሳሌም ኬሰ ጅራቴ ከምዩ ጫላስ ሎኒፊ ቡሻዬ ሄዱ ነንሆረዼ። <verse eid="ECC 2:7"/><verse number="8" style="v" sid="ECC 2:8"/>አን ሜቲፊ ወርቄ፣ ቀቤኘ ሞቶታቲፊ ኩታወን ብያ ወልት ነንቀበዼ። አን ፋርፈቶተ ዺራፊ ዱበርቲ አከሱመስ ሳጀቶወን ነመ ገመቺሰን ሄዱ ቀበን ቱሬ። <verse eid="ECC 2:8"/><verse number="9" style="v" sid="ECC 2:9"/>ከናፉ አን አከ መሌ ጉደዼ ነመ አናን ዱረ ዬሩሳሌም ኬሰ ቱሬ ከምዩ ጫሌ። ዋን ከነ ሁንደ ኬሰት ኦጉማንኮ አኑመ ወጅን ቱሬ።<verse eid="ECC 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 2:10"/>አን ዋን እጅኮ ሀዌ ሁንደ እሰ ህንዾውኔ፤</para>
  <para style="q2" vid="ECC 2:10">ገራኮስ ገመቹ ቶኮሌ ህንለግኔ።</para>
  <para style="q1" vid="ECC 2:10">ገራንኮ ሆጂኮ ሁንደት ገመዴ፤</para>
  <para style="q2" vid="ECC 2:10">ኩንስ ደዸቢኮ ሁንዳፍ በዻሰ ቱሬ።<verse eid="ECC 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 2:11"/>ተኡስ አን ዬሮን ዋን ሀርክኮ ሆጄቴ ሁንዳፊ</para>
  <para style="q2" vid="ECC 2:11">ዋነን አርገቹፍ ጄዼ እት ደዸቤ ሁበዼ እላሌት፣</para>
  <para style="q1" vid="ECC 2:11">ወን ሁንድ አኩመ ቡቤ አርኡት መሌ ፋይዳ ህንቀቡ ቱሬ፤</para>
  <para style="q2" vid="ECC 2:11">አዱዻ ገድት ቡኣን ቶኮዩ ህንቱሬ።<verse eid="ECC 2:11"/></para>
  <para style="s1">ኦጉማፊ ጎዉማን ፋይዳ ህንቀበን</para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 2:12"/>አንስ ያደኮ ገረ ኦጉማ፣</para>
  <para style="q2" vid="ECC 2:12">መራቱማፊ ጎዉማ ሁበቹት ነንዴብፈዼ።</para>
  <para style="q1" vid="ECC 2:12">ነምን ሞቲ እዶ ቡኡ ቶኮ</para>
  <para style="q2" vid="ECC 2:12">ዋን ዱራን ሆጄተሜ ጫላ ማል ጎቹ ደንደአ?<verse eid="ECC 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 2:13"/>አን አኩመ እፍን ዱከነረ ወዩ ሰነ፣</para>
  <para style="q2" vid="ECC 2:13">አከ ኦጉማን ጎዉማረ ወዩ ነንአርጌ።<verse eid="ECC 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 2:14"/>ኦጌስ መታሳ ኬሳ እጀ ቀበ፤</para>
  <para style="q2" vid="ECC 2:14">ጎዋን ገሩ ዱከነ ኬሰ ዴመ፤</para>
  <para style="q1" vid="ECC 2:14">አን ገሩ አከ ገልገል እሳን ለማኒ</para>
  <para style="q2" vid="ECC 2:14">ቶኩመ ተኤ ነንሁበዼ።<verse eid="ECC 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 2:15"/>ኤርገሲ አን አከነ ጄዼን ገራኮ ኬሰት ነንያዴ፤</para>
  <para style="q1" vid="ECC 2:15">“ወን ጎዋ ቁነሜ፣ አናንስ ንቁነመ፤</para>
  <para style="q2" vid="ECC 2:15">ዮስ አን ኦጌሰ ተኡዻን ማለን አርገዸሬ?”</para>
  <para style="q1" vid="ECC 2:15">አን ገራኮ ኬሰት፣</para>
  <para style="q2" vid="ECC 2:15">“ኩንስ ፋይዳ ህንቀቡ” ነንጄዼ።<verse eid="ECC 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 2:16"/>ኦጌስ አኩመ ጎዋ ዬሮ ዼራፍ ህንያደተሙቲ፤</para>
  <para style="q2" vid="ECC 2:16">በረ ዹፉፍ ጅሩ ኬሰ እሳን ለቹ ንእራንፈተሙ።</para>
  <para style="q1" vid="ECC 2:16">ኦጌስስ አኩመ ጎዋ ዱኡ ቀበ!<verse eid="ECC 2:16"/></para>
  <para style="s1">ሆጂን ደዸቡን ፋይዳ ህንቀቡ</para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 2:17"/>ሰበቢ ወን አዱ ገድት ሆጄተሙ ነ ገድሲሴፍ አን ጅሬኘ ነንጅቤ፤ ኩን ሁንድኑ ቡቤ አርኡዸ፤ ፋይዳስ ህንቀቡ። <verse eid="ECC 2:17"/><verse number="18" style="v" sid="ECC 2:18"/>አን ሰበቢ ነመ አነ ዱባን ዹፉፍ ዋን ከነ ዺሱ ቀቡፍ፣ ዋነን አዱዻ ገድት እት ደዸቤ ሁንደ ነንጅቤ። <verse eid="ECC 2:18"/><verse number="19" style="v" sid="ECC 2:19"/>ኤኙቱ አከ እን ኦጌሰ ዮካን ጎዋ ተኡ ቤከ? ተኡስ እን ሆጂ አን አዱዻ ገድት ያሊፊ ኦጉማኮ እት ዸንገላሴ ሁንደት አባ ተአ። ኩንስ ፋይዳ ህንቀቡ። <verse eid="ECC 2:19"/><verse number="20" style="v" sid="ECC 2:20"/>ከናፉ ገራንኮ ሰበቢ ሆጂኮ ደዸብሲሳ አን አዱዻ ገድት እት ደዸቤ ሁንዳቲፍ አብዲ ኩተቹ ጀልቀቤ። <verse eid="ECC 2:20"/><verse number="21" style="v" sid="ECC 2:21"/>ነምን ቶኮ ሆጂሳ ኦጉማን፣ ቤኩምሳፊ ሀርከ ቶሊሳን ሆጄቴ ኤርገሲሞ ዋን ቀቡ ሁንደ ነመ ሆማ እት ህንደዸብኒፍ ዺሱ ቀባቲ። ወን ኩንስ ፋይዳ ህንቀቡ፤ ሀምነ ጉዳዸስ። <verse eid="ECC 2:21"/><verse number="22" style="v" sid="ECC 2:22"/>ነምን ቶኮ ደዸቢሳቲፍ ያሊ ጭማ አዱዻ ገድት ጎዼ ሰነ ሁንዳፍ ማል አርገተ? <verse eid="ECC 2:22"/><verse number="23" style="v" sid="ECC 2:23"/>ሆጂንሳ በረ ጅሬኘሳ ሁንደ ረክናፊ ገደ፤ ሰሙንሳ ሀልከንዩ ህንቦቆቱ። ኩንስ ዋን ፋይዳ ህንቀብኔዸ።<verse eid="ECC 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="ECC 2:24"/>ነምን ኛቴ ዹጌ ሆጂሳት ገመዱ ጫላ ሆማ ጎቹ ህንደንደኡ። አን አከ ወን ኩን ሀርከ ዋቃቲ ዹፌ ነንአርጌ፤ <verse eid="ECC 2:24"/><verse number="25" style="v" sid="ECC 2:25"/>ዋቃን መሌ ኤኙቱ ኛቹ ዮካን ገመዱ ደንደአ? <verse eid="ECC 2:25"/><verse number="26" style="v" sid="ECC 2:26"/>ዋቅን ነመ እሰ ገመቺሱፍ ኦጉማ፣ ቤኩምሳፊ ገመቹ ኬነ፤ ነመ ጩበማ ገሩ አከ እን ነምቸ ዋቀ ገመቺሱፍ ኬኑፍ ጄዼ ሆጂ ቀቤኘ ወልት ቀቡቲፊ ኩሱ ሆጄቱ ጎዸ። ኩንስ ቡቤ አርኡዸ፤ ፋይዳስ ህንቀቡ።<verse eid="ECC 2:26"/></para>
  <chapter eid="ECC 2"/>
  <chapter number="3" style="c" sid="ECC 3"/>
  <para style="s1">ወን ሁንድኑ ዬሮ ቀበ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 3:1"/>ወን ሁንድኑ ዬሮ ቀበ፤</para>
  <para style="q2" vid="ECC 3:1">ሆጂን ሰሚዻ ገድት ሆጄተሙ ሁንድስ ወቅቲ ቀበ፦<verse eid="ECC 3:1"/></para>
  <para style="b"/>
  <para style="q2">
    <verse number="2" style="v" sid="ECC 3:2"/>ዸለቹፍ ዬሮ ቀበ፤ ዱኡፍስ ዬሮ ቀበ፤</para>
  <para style="q2" vid="ECC 3:2">ዻቡፍ ዬሮ ቀበ፤ ቡቅሱፍስ ዬሮ ቀበ፤<verse eid="ECC 3:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="ECC 3:3"/>አጄሱፍ ዬሮ ቀበ፤ ፈይሱፍስ ዬሮ ቀበ፤</para>
  <para style="q2" vid="ECC 3:3">ዲጉፍ ዬሮ ቀበ፤ እጃሩፍስ ዬሮ ቀበ፤<verse eid="ECC 3:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="ECC 3:4"/>ቦኡፍ ዬሮ ቀበ፤ ኮልፉፍስ ዬሮ ቀበ፤</para>
  <para style="q2" vid="ECC 3:4">ገዱፍ ዬሮ ቀበ፤ ስርቡፍስ ዬሮ ቀበ፤<verse eid="ECC 3:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="ECC 3:5"/>ዸጋ ብትኔሱፍ ዬሮ ቀበ፤ ወልት ቀቡፍስ ዬሮ ቀበ፤</para>
  <para style="q2" vid="ECC 3:5">ሀመቹፍ ዬሮ ቀበ፤ ሀመቹ ዺሱፍስ ዬሮ ቀበ፤<verse eid="ECC 3:5"/></para>
  <para style="q2">
    <verse number="6" style="v" sid="ECC 3:6"/>በርባዱፍ ዬሮ ቀበ፤ በርባዱ ዺሱፍስ ዬሮ ቀበ፤</para>
  <para style="q2" vid="ECC 3:6">ካኡፍ ዬሮ ቀበ፤ ገቱፍስ ዬሮ ቀበ፤<verse eid="ECC 3:6"/></para>
  <para style="q2">
    <verse number="7" style="v" sid="ECC 3:7"/>ተርሳሱፍ ዬሮ ቀበ፤ ሆዹፍስ ዬሮ ቀበ፤</para>
  <para style="q2" vid="ECC 3:7">ጨልእሱፍ ዬሮ ቀበ፤ ዱበቹፍስ ዬሮ ቀበ፤<verse eid="ECC 3:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="ECC 3:8"/>ጃለቹን ዬሮ ቀበ፤ ጅቡፍስ ዬሮ ቀበ፤</para>
  <para style="q2" vid="ECC 3:8">ሎሉፍ ዬሮ ቀበ፤ ነጋፍስ ዬሮ ቀበ።<verse eid="ECC 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 3:9"/>ሆጄታን ቶኮ ደዸቢሳራ ቡኣ ማሊ አርገተ? <verse eid="ECC 3:9"/><verse number="10" style="v" sid="ECC 3:10"/>አን በኣ ዋቅን ነሞተረ ካኤ አርጌረ። <verse eid="ECC 3:10"/><verse number="11" style="v" sid="ECC 3:11"/>እን ዋን ሁንደ ዬሩመሳት ሚዸግሴ ቶልቼረ። አከሱመስ ያደ በራ በራ ገራ ነሞታ ኬሰ ካኤ። ተኡስ እሳን ዋን ዋቅን ጀልቀባ ሀመ ዹማት ሆጄቴ ቤኩ ህንደንደአን። <verse eid="ECC 3:11"/><verse number="12" style="v" sid="ECC 3:12"/>አን አከ ነሞታፍ በረ ጅሬኘሳኒ ኬሰ ወን ገመዱፊ ዋን ጋሪ ሆጄቹ ጫሉ ቶኮዩ ህንጅሬ ነንቤከ። <verse eid="ECC 3:12"/><verse number="13" style="v" sid="ECC 3:13"/>ቶኮን ቶኮን ነማ ኛቴ ዹጌ ቡኣ ሆጂሳ ሁንደት ገመዱን ኬና ዋቃት። <verse eid="ECC 3:13"/><verse number="14" style="v" sid="ECC 3:14"/>አን አከ ወን ዋቅን ሆጄቱ ሁንድ በረ በራን ጅራቱ ቤከ፤ ወን ቶኮሌ እት ህንደበለሙ፤ ወን ቶኮዩ ስራ ህንፉዸተሙ። ዋቅን አከ ነሞትን እሰ ሶዳተኒፍ ዋን ከነ ጎዸ።<verse eid="ECC 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 3:15"/>ወን አመ ጅሩ ከምዩ ዱራኑ ቱሬረ፤</para>
  <para style="q2" vid="ECC 3:15">ወን ዹፉፍ ጅሩስ ዱራኑ ጅረ ቱሬ፤</para>
  <para style="q2" vid="ECC 3:15">ዋቅን ዋን ደርቤስ ዴብሴ ፍደ።<verse eid="ECC 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 3:16"/>አንስ አዱዻ ገድት ዋን ብራ ነንአርጌ፤ ኩንስ፦</para>
  <para style="q1" vid="ECC 3:16">እዶ ሙርቲን ቀጄላን ጅራቹ መሉ፣ ሀምነቱ ቱሬ፤</para>
  <para style="q2" vid="ECC 3:16">እዶ ቀጄሉማን ጅራቹ መሉሞ ጀልእነቱ ቱሬ።<verse eid="ECC 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="ECC 3:17"/>አን ገራኮ ኬሰት አከነ ጄዼን ያዴ፤</para>
  <para style="q1" vid="ECC 3:17">“ዋቅን ቀጄልቶታፊ ሀሞተ፣ ገረ ሙርቲት ንፍደ፤</para>
  <para style="q2" vid="ECC 3:17">ወን ሁንድኑ፣ ሆጂን ሁንድኑስ ዬሮ ንቀባቲ።”<verse eid="ECC 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 3:18"/>አን አመሌ አከነ ጄዼ ገራኮ ኬሰት ነንያዴ፤ “ዋቅን አከ እሳን አኩመ ብኔንሶታ ተኡሳኒ አርገኒፍ እልማን ነማ ቆረ። <verse eid="ECC 3:18"/><verse number="19" style="v" sid="ECC 3:19"/>ወን ነመረ ገኡ፣ ብኔንሶተረስ ንገአ፤ ለቸንሳኒዩ ዋኑመ ቶኮቱ ኤገተ፤ አኩመ እን ቶኮ ዱኡ፣ እን ካንስ ንዱአ። ሁንድሳኒ ሀፉሩመ ቶኮ ቀቡ፤ ነምን ብኔንሰ ጫላ ፋይዳ አርገቱ ቶኮሌ ህንቀቡ። ወን ሁንድኑ ፋይዳ ህንቀቡ። <verse eid="ECC 3:19"/><verse number="20" style="v" sid="ECC 3:20"/>እሳን ሁንድ እዱመ ቶኮ ዸቁ፤ ሁንድኑ ብዮራ ዹፈን፤ ሁንድኑስ ብዮት ዴብኡ። <verse eid="ECC 3:20"/><verse number="21" style="v" sid="ECC 3:21"/>አከ ሀፉር ነማ ኦል በኤ ሀፉር ብኔንሳሞ ለፈ ኬሰ ሴኑ ኤኙቱ ቤከ?”<verse eid="ECC 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="ECC 3:22"/>ከናፉ አን ሰበቢ ወን ሱን እጣሳ ተኤፍ አከ ነማፍ ወን ሆጂሳት ገመዱ ጫሉ ቶኮዩ ህንጅሬ ነንአርጌ። አከ እን ዋን እሰ ዱባን ተኡ አርጉፍ ኤኙቱ እሰ ፍዱ ደንደአ?<verse eid="ECC 3:22"/></para>
  <chapter eid="ECC 3"/>
  <chapter number="4" style="c" sid="ECC 4"/>
  <para style="s1">ጩንቁርሳ፣ ሆጂዻን ደዸቡ፣ ምቹ ዸቡ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 4:1"/>አን አመስ እላሌ ጩንቁርሳ አዱዻ ገድት አዴምስፈማ ጅሩ ሁንደ ነንአርጌ፦</para>
  <para style="q1" vid="ECC 4:1">አን እምማን ጩንቁርፈምቶታ ነንአርጌ፤</para>
  <para style="q2" vid="ECC 4:1">ነመ እሳን ጀጀቤሱ ቶኮሌስ ህንቀበን፤</para>
  <para style="q1" vid="ECC 4:1">ሁምን ገመ ጩንቁርስቶተሳኒ ቱሬ፤</para>
  <para style="q2" vid="ECC 4:1">እሳን ነመ እሳን ጀጀቤሱ ቶኮሌ ህንቀበን።<verse eid="ECC 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 4:2"/>አንስ አከ ወር ዱአን፣</para>
  <para style="q2" vid="ECC 4:2">ከኔን ከናን ዱረ ዱአን፣</para>
  <para style="q2" vid="ECC 4:2">ጅራቶተ አመ ሉቡዻን ጅራተን ጫለን ነንለብሴ።<verse eid="ECC 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 4:3"/>ገሩ ነምን ሀመ አማት ህንዸለትን</para>
  <para style="q2" vid="ECC 4:3">ከን ሀምነ አዱዻ ገድት</para>
  <para style="q1" vid="ECC 4:3">ሆጄተሙ ህንአርግን፣</para>
  <para style="q2" vid="ECC 4:3">ለቸንሳኒረ ወየ።<verse eid="ECC 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 4:4"/>አንስ አከ ደዸቢን ሆጂ ሁንዲፊ ምልካኡን ሁንድ ህናፋ ነምን ኦላሳ ወጅን ቀቡራ ቡርቁ ነንአርገ። ኩንስ ቡቤ አርኡዸ፤ ፋይዳስ ህንቀቡ።<verse eid="ECC 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 4:5"/>ጎዋን ሀርከሳ መረቴ ታአ፤</para>
  <para style="q2" vid="ECC 4:5">ፎኑመ ኦፊሳስ ኛተ።<verse eid="ECC 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 4:6"/>ደዸቢፊ ቡቤ አርኡዻን</para>
  <para style="q2" vid="ECC 4:6">ኮኜ ለመ አርገቹረ</para>
  <para style="q2" vid="ECC 4:6">ነጋን ኮኜ ቶኮ አርገቹ ወየ።<verse eid="ECC 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 4:7"/>አን አመሌ ዋን ፋይዳ ህንቀብኔ ቶኮ አዱዻ ገድት ነንአርጌ፦<verse eid="ECC 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 4:8"/>ነመ ኮጳሳ ጅራቱ ቶኮቱ ጅረ፤</para>
  <para style="q2" vid="ECC 4:8">እንስ እልመ ዮካን ኦቦሌሰ ህንቀቡ ቱሬ።</para>
  <para style="q1" vid="ECC 4:8">ዬሮ ሁንደ ሆጂት ደዸበ፤</para>
  <para style="q2" vid="ECC 4:8">ተኡስ እጅሳ ቀቤኘሳ እላሌ ቁፌ ህንጄዹ።</para>
  <para style="q1" vid="ECC 4:8">እንስ፣ “አን ኤኙፍ ጄዼን ደዸበ?</para>
  <para style="q2" vid="ECC 4:8">ማሊፈን ገመቹስ ኦፍ ለገ?” ጄዼ ጋፈቴ።</para>
  <para style="q1" vid="ECC 4:8">ኩንስ ፋይዳ ህንቀቡ፤</para>
  <para style="q2" vid="ECC 4:8">ሆጂ ቡኣ ህንቀብኔዸ!<verse eid="ECC 4:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 4:9"/>እሳን ሰበቢ ሆጂሳኒቲፍ ገቲ ጋሪ ዋን አርገተኒፍ</para>
  <para style="q2" vid="ECC 4:9">ነመ ቶኮረ ነመ ለመ ወየ፦<verse eid="ECC 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 4:10"/>ዮ እን ቶኮ ኩፌ፣</para>
  <para style="q2" vid="ECC 4:10">እን ካን ኦል እሰ ቀበ።</para>
  <para style="q1" vid="ECC 4:10">ገሩ ነምን ኩፌ</para>
  <para style="q2" vid="ECC 4:10">ከን ኦል እሰ ካሱ ህንቀብኔ ገራ ነመ ኛተ!<verse eid="ECC 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 4:11"/>ዮ ነሞትን ለመ ወጅን ጪሰን እት ሆአ፤</para>
  <para style="q2" vid="ECC 4:11">ነመ ቶኮ ገሩ አከምት ኮጳሳ እት ሆኡ ደንደአ?<verse eid="ECC 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 4:12"/>ነምን ቶኮ ሞአተሙ ደንደአ፤</para>
  <para style="q2" vid="ECC 4:12">ነሞትን ለመ ገሩ ኦፍራ ዴብሱ ደንደኡ።</para>
  <para style="q1" vid="ECC 4:12">ፉኞን ፎኣ ሰዲን ፎአሜ ደፌ ህንጭቱ።<verse eid="ECC 4:12"/></para>
  <para style="s1">ጫለኒ አርገሙን ፋይዳ ህንቀቡ</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 4:13"/>ሞቲ ዱሎማፊ ጎዋ ስአች ጎርሰ ህንፉዸትኔረ፣ ደርገጌሰ ህዬሰ ኦጌሰ ወየ። <verse eid="ECC 4:13"/><verse number="14" style="v" sid="ECC 4:14"/>እን ዮ ህዩማን ሞቱማ ሰነ ኬሰት ዸለቴዩ መነ ህዻቲ በኤ ሞቲ ተኡ ደንደኣቲ። <verse eid="ECC 4:14"/><verse number="15" style="v" sid="ECC 4:15"/>አን አከ ነምን አዱዻ ገድ ጅራቴ ሁንድ ደርገጌሰ ሞቲ ዻሉ ሰነ ዱካ ቡኤ ነንአርጌ። <verse eid="ECC 4:15"/><verse number="16" style="v" sid="ECC 4:16"/>ባይእን ነመ ፉለሳኒ ዱረ ጅሩ ሀመ ህንቀቡ ቱሬ። ወር ዱባን ዹፈን ገሩ ደርገጌሰ ዻሉ ሰነት ህንገመድኔ። ኩን ሁንድስ ቡቤ አርኡዸ፤ ፋይዳስ ህንቀቡ።<verse eid="ECC 4:16"/></para>
  <chapter eid="ECC 4"/>
  <chapter number="5" style="c" sid="ECC 5"/>
  <para style="s1">ዋቀ ሶዳዹ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 5:1"/>አት ዬሮ ገረ መነ ዋቃ ዸቅጡ ተርካንፊኬ ኤገዹ። ዸጌፈቹፍ ዽኣቹን ኣርሳ ጎዎታ ዽኤሱ ጫለ፤ እሳን አከ ሀምነ ሆጄቻ ጅረን ህንቤከኒቲ።<verse eid="ECC 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 5:2"/>ፉለ ዋቃ ዱረት ዋን ቶኮ ዱበቹፍ</para>
  <para style="q2" vid="ECC 5:2">አፋንኬቲን ህንጀርጀርን፤</para>
  <para style="q2" vid="ECC 5:2">ገራንኬስ ህንአሪፈትን።</para>
  <para style="q1" vid="ECC 5:2">ዋቅን ሰሚ ኬሰ ጅረ፤</para>
  <para style="q2" vid="ECC 5:2">አትሞ ለፈረ ጅርተ፤</para>
  <para style="q2" vid="ECC 5:2">ከናፉ ዱቢንኬ ሃገባበቱ።<verse eid="ECC 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 5:3"/>አብጁን ባይእነ ሆጂቲን ዹፈ፤</para>
  <para style="q2" vid="ECC 5:3">ሃሳን ጎዋስ ባይእነ ዱቢቲን ቤከመ።<verse eid="ECC 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="ECC 5:4"/>አት ዬሮ ወሬገ ቶኮ ዋቃፍ ወሬግዱት ወሬገ ሰነ ኦፍራ ባሱፍ ለፈረ ህንሀርክፈትን። እን ጎዎተት ህንገመዱ፤ አት ወሬገኬ ኦፍራ ባስ። <verse eid="ECC 5:4"/><verse number="5" style="v" sid="ECC 5:5"/>ወሬገኒ ኦፍራ ባሱ ዺሱ መና ወሬጉ ዺሱ ወየ። <verse eid="ECC 5:5"/><verse number="6" style="v" sid="ECC 5:6"/>አፋንኬ ጩቡ ኬሰ ስ ህንቡስን። ኤርገማ መነ ቁልቁሉማቲንስ፣ “ወሬግንኮ ዶጎጎረ ቱሬ” ህንጄዽን። ዋቅን ማሊፍ ዋን አት ጄቴት ኣሬ ሆጂ ሀርከኬቲ በሌሰ? <verse eid="ECC 5:6"/><verse number="7" style="v" sid="ECC 5:7"/>አብጁን ባይኤኒፊ ዱቢን ባይኤን ፋይዳ ህንቀበን። ከናፉ ዋቀ ሶዳዹ።<verse eid="ECC 5:7"/></para>
  <para style="s1">በዻዹማን ፋይዳ ህንቀቡ</para>
  <para style="p">
    <verse number="8" style="v" sid="ECC 5:8"/>አት ዮ ህዬሰ ኣና ቶኮ ኬሰት ሀጩጨሜ ሙርቲ ቀጄላፊ ምርግ ዾወተሜ አርግቴ፣ ዋን አከና ህንድንቅሲፈትን፤ ቆንዳል ቶኮ ቆንዳለሳ ኦሊቲን እላላማቲ፤ እሳኒን ኦልትስ ቆንዳልቶትን ብራ ጅሩ። <verse eid="ECC 5:8"/><verse number="9" style="v" sid="ECC 5:9"/>ፋይዳን ለፈራ አርገሙ ከን ነመ ሁንዳት፤ ሞትች መታንሳዩ ቆነ ለፋራ ፈየደመ።<verse eid="ECC 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 5:10"/>ነመ ማለቀ ጃለቱ ከምዩ ማለቅን እሰ ህንገኡ፤</para>
  <para style="q2" vid="ECC 5:10">ነመ ቀቤኘ ጃለቱሌ ገሊንሳ እሰ ህንቁብሱ።</para>
  <para style="q2" vid="ECC 5:10">ኩንስ ፋይዳ ህንቀቡ።<verse eid="ECC 5:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 5:11"/>አኩመ ቀቤኝ ባይአቱን፣</para>
  <para style="q2" vid="ECC 5:11">ወር ኛተንስ ንባይአቱ።</para>
  <para style="q1" vid="ECC 5:11">ዮስ አቦቲን ቀቤኛ እጁማን እላሉ መሌ</para>
  <para style="q2" vid="ECC 5:11">ፋይዳ ማሊ አርገቱሬ?<verse eid="ECC 5:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 5:12"/>ጥቃስ ኛቱ፣ ጉዳስ ኛቱ፣</para>
  <para style="q2" vid="ECC 5:12">ህርብን ሆጄታ ቶኮ ምኣኣዸ፤</para>
  <para style="q1" vid="ECC 5:12">ባይእን ቀቤኛ ገሩ</para>
  <para style="q2" vid="ECC 5:12">ሶሬሰ ቶኮ ህርበ ዾወ።<verse eid="ECC 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 5:13"/>አን አዱዻ ገድት ሀምነ ነመ ገድሲሱ ነንአርጌ፤ ኩንስ፦</para>
  <para style="q1" vid="ECC 5:13">ቀቤኘ አቡመሳ ሚዹፍ ኩፈሜ፣<verse eid="ECC 5:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="ECC 5:14"/>ዮካን ቀቤኘ ምልኪ ዸቡዻን በዴ</para>
  <para style="q1" vid="ECC 5:14">ዬሮ ነምች ሱን እልመ ዸልቼት</para>
  <para style="q2" vid="ECC 5:14">እልመሳቲፍ ሆማ ህንሀፍኒዸ።<verse eid="ECC 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 5:15"/>ነምን ቁላዹመሳ ገደሜሰ ሃዸሳቲ በአ፤</para>
  <para style="q2" vid="ECC 5:15">እን አኩመ ዹፌት ዴብኤ ዴመ።</para>
  <para style="q1" vid="ECC 5:15">እን ዋን እት ደዸቤ ኬሳ</para>
  <para style="q2" vid="ECC 5:15">ዋን ቶኮሌ ሀርከት ቀበቴ ህንዴሙ።<verse eid="ECC 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 5:16"/>ኩንስ ሀምነ ነመ ገድሲሱዸ፦</para>
  <para style="q1" vid="ECC 5:16">ነምን አኩመ ዹፌት ዴመ፤</para>
  <para style="q2" vid="ECC 5:16">እን ዋን ቡቤዻፍ ደዸቡፍ</para>
  <para style="q2" vid="ECC 5:16">ፋይዳ ማሊ አርገተ?<verse eid="ECC 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 5:17"/>እን በረ ጅሬኘሳ ሁንደ ያዶ፣</para>
  <para style="q2" vid="ECC 5:17">ዹኩቢፊ ኣሪ ጉዳዻን ዱከነ ኬሰት ኛተ።<verse eid="ECC 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="ECC 5:18"/>አንስ አከ ነምን በረ ጅሬኘሳ ከን ዋቅን እሳፍ ኬኔ ገባባ ከነ ኬሰ ኛቴ ዹጌ ሆጂሳ ከን አዱዻ ገድት እት ደዸቤ ሰነትሌ ገመዱን እሳፍ ጋሪፊ በርባችሳ ተኤ ነንሁበዼ፤ ቆድንሳ ከኑማቲ። <verse eid="ECC 5:18"/><verse number="19" style="v" sid="ECC 5:19"/>አከሱመስ ዋቅን ነመ ከሚፉ በዻዹማፊ ቀቤኘ ኬኔ አከ እን እት ገመዱ፣ አከ እን ቆደ ኦፊሳ ፉዸቴ ሆጂ ኦፊሳት ገመዱ እሰ ጎዹንሳ፣ ኬና ዋቃት። <verse eid="ECC 5:19"/><verse number="20" style="v" sid="ECC 5:20"/>ሰበቢ ዋቅን ገራሳ ገመቹዻን ጉቴፍ እን በረ ጅሬኘሳ ባይኤ ህንያደቱ።<verse eid="ECC 5:20"/></para>
  <chapter eid="ECC 5"/>
  <chapter number="6" style="c" sid="ECC 6"/>
  <para style="p">
    <verse number="1" style="v" sid="ECC 6:1"/>አን አዱዻ ገድት ዋን ሀማ ብራ አርጌረ፤ ኩንስ አከ መሌ ነመት ኡልፋተ፦ <verse eid="ECC 6:1"/><verse number="2" style="v" sid="ECC 6:2"/>ዋቅን አከ ነምን ዋን ገራሳት ሀዉ ቶኮዩ ህንዸብኔፍ ቀቤኘ፣ በዻዹማፊ ኡልፍነ እሳፍ ኬኔ፤ ዋቅን ገሩ አከ እን እት ገመዱ ህንጎኔ፤ ቆደ ነምቻ ነመ ኦርማቱ እት ገመደ። ኩን ዋን ፋይዳ ህንቀብኔዸ፤ ሀምነ ነመ ገድሲሱዸስ።<verse eid="ECC 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 6:3"/>ነምን ቶኮ እጆሌ ዽበ ቀባቴ ወጎተ ባይኤ ጅራቹ ደንደአ፤ እን ሀመ ፌዼ ጅራቱሌ ዮ ቀቤኘሳት ገመዱ ባቴ አዋለ ጋሪስ አርገቹ ባቴ፣ አን፣ “እሳ መና ገተተ ወየ” ነንጄዸ። <verse eid="ECC 6:3"/><verse number="4" style="v" sid="ECC 6:4"/>እን አከሱማን ዹፈ፤ ዱከነ ኬሰ በደ፤ መቃንሳስ ዱከናን ሀጉገመ። <verse eid="ECC 6:4"/><verse number="5" style="v" sid="ECC 6:5"/>እን ዮ አዱ አርጉ ባቴዩ ዮካን ዮ ሆማ ቤኩ ባቴዩ ቦቆና ነምች ሱን አርገቱ ጫላ ቦቆና ቀባተ። <verse eid="ECC 6:5"/><verse number="6" style="v" sid="ECC 6:6"/>እን ወጋ ኩመ ዬሮ ለመ ጅራቱሌ ዮ ጅሬኘ ጋሪ ህንጅራትን፣ ነምን ሁንድ እዱመ ቶኮ ዸቃ ምቲ?<verse eid="ECC 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 6:7"/>ደዸቢን ነመ ሁንዳ አፋኑመሳቲፍ፤</para>
  <para style="q2" vid="ECC 6:7">ፌዺንሳ ገሩ ዮምዩ ህንጉቱ።<verse eid="ECC 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 6:8"/>ኦጌስ ማሊን ጎዋ ጫለ?</para>
  <para style="q1" vid="ECC 6:8">ህዬስ አከ እት ፉለ ነሞታ ዱረ ጅራቱ ቤኩዻን</para>
  <para style="q2" vid="ECC 6:8">ፋይዳ ማሊ አርገተ?<verse eid="ECC 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 6:9"/>ሀዊዻን ጆሩ መና ዋን እጅ አርጉ ወየ።</para>
  <para style="q2" vid="ECC 6:9">ኩንስ ቡቤ አርኡ መሌ ፋይዳ ህንቀቡ።<verse eid="ECC 6:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 6:10"/>ዋን ጅሩ ሁንዳፍ ዱራኑ መቃን በኤረ፤</para>
  <para style="q2" vid="ECC 6:10">ማሉማን ነማስ ቤከማዸ፤</para>
  <para style="q1" vid="ECC 6:10">ነምን ቶኮዩ ነመ እሰ ጫላ ሁምነ ቀቡን</para>
  <para style="q2" vid="ECC 6:10">ሞርከቹ ህንደንደኡ።<verse eid="ECC 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 6:11"/>ዱቢን አኩመ ባይአቱን ፋይዳ ዸበ፤</para>
  <para style="q2" vid="ECC 6:11">ዮስ ወን ሱን አከሚን ነመ ከምዩ ፈየደ?<verse eid="ECC 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 6:12"/>በረ ጅሬኘ ነማ ከን እን አኩመ ጋድሳት ኬሰ በኤ ደርቡ ገባባ ፋይዳ ህንቀብኔ ከነ ኬሰ ኤኙቱ ዋን ነማፍ ጋሪ ተኤ ቤከ? ዋን ኤርገ እን ዴሜ ቦዴ አዱዻ ገድት ተኡስ ኤኙቱ እሰት ህሙ ደንደአ?<verse eid="ECC 6:12"/></para>
  <chapter eid="ECC 6"/>
  <chapter number="7" style="c" sid="ECC 7"/>
  <para style="s1">ኦጉማ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 7:1"/>ሽቶ ኡርጋኣረ መቃ ጋሪ ወየ፤</para>
  <para style="q2" vid="ECC 7:1">ጉያ ዸሎታረ ጉያ ዱኣ ወየ።<verse eid="ECC 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 7:2"/>መነ ጭዻ ዸቁ መና</para>
  <para style="q2" vid="ECC 7:2">መነ ቦእቻ ዸቁ ወየ፤</para>
  <para style="q1" vid="ECC 7:2">ገልገል ነመ ሁንዳ ዱኡማቲ፤</para>
  <para style="q2" vid="ECC 7:2">ነምን ሉቡን ጅራቱ ዋን ከነ ገራት ሃቀበቱ።<verse eid="ECC 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 7:3"/>ፉል ገዱ ዋን ገራ ገመቺሱፍ</para>
  <para style="q2" vid="ECC 7:3">ኮልፈረ ገደ ወየ።<verse eid="ECC 7:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 7:4"/>ቀልቢን ኦጌሳ መነ ቦእቻ ጅረ፣</para>
  <para style="q2" vid="ECC 7:4">ቀልቢን ጎዋ ገሩ መነ ገመቹ ጅረ።<verse eid="ECC 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 7:5"/>ስርበ ጎዎታ ዸገኡ መና</para>
  <para style="q2" vid="ECC 7:5">እፈትና ኦጌሳ ዸጌፈቹ ወየ።<verse eid="ECC 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 7:6"/>ኮልፍ ጎዋ</para>
  <para style="q2" vid="ECC 7:6">አኩመ ቆራቲ ጡዌ ጀላ ጣጠኡት።</para>
  <para style="q2" vid="ECC 7:6">ኩንስ ፋይዳ ህንቀቡ።<verse eid="ECC 7:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 7:7"/>ጩንቁርሳን ኦጌሰ ጎዋ ጎዸ፤</para>
  <para style="q2" vid="ECC 7:7">መተኣንስ ሰሙ ነመ ጡሬሰ።<verse eid="ECC 7:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 7:8"/>ጀልቀበ ዋን ቶኮረ ዹመሳ ወየ፤</para>
  <para style="q2" vid="ECC 7:8">ኦፍ ቱሉረስ ኦብሰ ወየ።<verse eid="ECC 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 7:9"/>ሀፉረኬቲን ኣሩፍ ህንአሪፈትን፤</para>
  <para style="q2" vid="ECC 7:9">ኣሪን ቦባ ጎዎታ ኬሰ ጅራቲ።<verse eid="ECC 7:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 7:10"/>አት፣ “በር ዱሪ ማሊፍ በረ ከነ ጫሌ?” ህንጄዽን፤</para>
  <para style="q2" vid="ECC 7:10">ዋን ከነ ጋፈቹን ኦጉማ ምት።<verse eid="ECC 7:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 7:11"/>ኦጉማን አኩመ ዻላ ዋን ጋሪዸ፤</para>
  <para style="q2" vid="ECC 7:11">ወረ አዱ አርገኒፍስ ቡኣ ቀበ።<verse eid="ECC 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 7:12"/>አኩመ ማለቅን ደኦ ተኤ ሰነ</para>
  <para style="q2" vid="ECC 7:12">ኦጉማንስ ደኦዸ፤</para>
  <para style="q1" vid="ECC 7:12">ፋይዳን ቤኩምሳ ገሩ ከነ፦</para>
  <para style="q2" vid="ECC 7:12">እንስ ኦጉማን ወረ እሼ ቀበኒፍ ጅሬኘ ኬኑሼት።<verse eid="ECC 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 7:13"/>ዋን ዋቅን ሆጄቴ ሜ እላል፦</para>
  <para style="q1" vid="ECC 7:13">ዋን እን ጀልእሴ</para>
  <para style="q2" vid="ECC 7:13">ኤኙቱ ቀጄልቹ ደንደአ?<verse eid="ECC 7:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 7:14"/>ዮሙ ዬሮን ጋሪ ተኡት ገመድ፤</para>
  <para style="q2" vid="ECC 7:14">ዮሙ ዬሮን ሀማቱ ገሩ እት ያድ፦</para>
  <para style="q1" vid="ECC 7:14">ዋቅን እሰ ቶኮ ሆጄቴ እሰ ካንስ ሆጄቴረ።</para>
  <para style="q2" vid="ECC 7:14">ከናፉ ነምን ኤጌሬሳ ቤኩ ህንደንደኡ፤<verse eid="ECC 7:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="ECC 7:15"/>አን ጅሬኘኮ ከን ፋይዳ ህንቀብኔ ከነ ኬሰት ዋን ከነ ለቹ አርጌረ፤ ኩንስ፦</para>
  <para style="q1" vid="ECC 7:15">ቀጄላን ቀጄሉማሳቲን በዱሳቲፊ</para>
  <para style="q2" vid="ECC 7:15">ሀማንሞ ሀምነሳቲን በረ ዼራ ጅራቹሳት።<verse eid="ECC 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 7:16"/>አት አከ መሌ ቀጄላ ህንተእን፤</para>
  <para style="q2" vid="ECC 7:16">ዮካን አከ መሌ ኦጌሰ ህንተእን፤</para>
  <para style="q2" vid="ECC 7:16">ማሊፍ ኦፍ ገላፈተ?<verse eid="ECC 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 7:17"/>አት አከ መሌ ሀማ ህንተእን፤</para>
  <para style="q2" vid="ECC 7:17">ጎዋስ ህንተእን፤</para>
  <para style="q2" vid="ECC 7:17">ማሊፍ ኡቱ ዬሮንኬ ህንገእን ዱተ?<verse eid="ECC 7:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 7:18"/>ኡቱ እሰ ካን ገድ ህንዺስን</para>
  <para style="q2" vid="ECC 7:18">ዋን ቶኮ ቀባቹን ጋሪዸ።</para>
  <para style="q2" vid="ECC 7:18">ነምን ዋቀ ሶዳቱ ዋን ሁንዳን ንምልካአ።<verse eid="ECC 7:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="ECC 7:19"/>ኦጉማን፣ ቡልችቶተ መጋላ ቶኮ ኬሰ ጅረን ኩዸን ጫላ</para>
  <para style="q2" vid="ECC 7:19">ነመ ኦጌሰ ቶኮ ሁምነ ቀቤሰ ጎት።<verse eid="ECC 7:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ECC 7:20"/>ነምን ቀጄላን ዋን ቀጄላ መሌ ጩቡ ቶኮሌ ህንሆጄትኔ</para>
  <para style="q2" vid="ECC 7:20">ለፈረ ህንጅሩ።<verse eid="ECC 7:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="ECC 7:21"/>ዋን ነምን ጄዹ ሁንደ ህንዸጌፈትን፤</para>
  <para style="q2" vid="ECC 7:21">ዮ ከነ ጎቴ ኡቱ ሆጄታንኬ ስ አባሩ ዸጌሳ፤<verse eid="ECC 7:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="ECC 7:22"/>አት መታንኬዩ ዬሮ ባይኤ ነሞተ ካን አከ አባርቴ</para>
  <para style="q2" vid="ECC 7:22">ገራንኬ ቤካቲ።<verse eid="ECC 7:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="ECC 7:23"/>አን ዋን ከነ ሁንደ ኦጉማዻነን ቆረዼ፣</para>
  <para style="q1" vid="ECC 7:23">“አን ኦጌሰን ተአ” ነንጄዼ።</para>
  <para style="q2" vid="ECC 7:23">ወን ኩን ገሩ ነራ ፈጎ ቱሬ።<verse eid="ECC 7:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="ECC 7:24"/>ወንት ጅሩ ሁንድ ፈጎዸ፤ ገድ ፈጎዸ፤</para>
  <para style="q2" vid="ECC 7:24">ኤኙቱ ቆረቴ ብረ ገኡ ደንደአ?<verse eid="ECC 7:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="ECC 7:25"/>ከናፉ አን ገረ ኦጉማፊ ማሉማ ወንቶታ ሁበቹት፣</para>
  <para style="q2" vid="ECC 7:25">ሰከተኡት፣ ቆረቹት</para>
  <para style="q1" vid="ECC 7:25">አከሱመስ ሀምነ ጎዉማቲፊ</para>
  <para style="q2" vid="ECC 7:25">መራቱማ ጎዉማ ሁበቹት ቀልቢኮ ነንዴብፈዼ።<verse eid="ECC 7:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="ECC 7:26"/>አን ዋን ዱአ ጫላ ሀዻኡ ነንአርጌ፤ ኩንስ፦</para>
  <para style="q2" vid="ECC 7:26">ዱበርቲ ክዮ ታቴ፣</para>
  <para style="q1" vid="ECC 7:26">ከን ያድንሼ ክዮ፣</para>
  <para style="q2" vid="ECC 7:26">ሀርክሼሞ ፎንጫ ተኤዸ።</para>
  <para style="q1" vid="ECC 7:26">ነምን ዋቀ ገመቺሱ እሼ ጀላ ንበአ፤</para>
  <para style="q2" vid="ECC 7:26">ጩበማን ገሩ እሼዻን ቀበመ።<verse eid="ECC 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="ECC 7:27"/>ለለባን አከነ ጄዸ፤ “ኩኖ ወን አን ቆረዼ ብረ ገኤ ከናዸ፦</para>
  <para style="q1" vid="ECC 7:27">“መለሳ ቤኩፍ ዋን ቶኮ ፉዸኒ ዋን ካንት ደበሉዸ፤<verse eid="ECC 7:27"/></para>
  <para style="q2">
    <verse number="28" style="v" sid="ECC 7:28"/>አን አመስ ነንሰከተኤ፤</para>
  <para style="q2" vid="ECC 7:28">ገሩ ህንአርገትኔ።</para>
  <para style="q1" vid="ECC 7:28">አን ኩመ ኬሳ ዺረ ቀጄላ ቶኮ ነንአርገዼ፤</para>
  <para style="q2" vid="ECC 7:28">ሁንዱመሳኒ ኬሳ ገሩ ዱበርቲ ቀጄልቱ ቶኮዩ ህንአርገትኔ።<verse eid="ECC 7:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="ECC 7:29"/>ኩኖ አን ዋን ከነ ቆፈ ነንአርገዼ፦</para>
  <para style="q2" vid="ECC 7:29">ዋቅን ቀጄልቶተ ጎዼ እልማን ነማ ኡሜ፤</para>
  <para style="q2" vid="ECC 7:29">ነሞትን ገሩ መለ ባይኤ በርባቸ ዴመን።”<verse eid="ECC 7:29"/></para>
  <para style="b"/>
  <chapter eid="ECC 7"/>
  <chapter number="8" style="c" sid="ECC 8"/>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 8:1"/>ከን አከ ነመ ኦጌሳ ኤኙ?</para>
  <para style="q2" vid="ECC 8:1">ኤኙቱ ሂካ ዋን ቶኮ ቤከ?</para>
  <para style="q1" vid="ECC 8:1">ኦጉማን ፉለ ነማ እብሰ፤</para>
  <para style="q2" vid="ECC 8:1">ኛረ ጉረሜስ ንሂከ።<verse eid="ECC 8:1"/></para>
  <para style="s1">ሞቲፍ አጀጀም</para>
  <para style="p">
    <verse number="2" style="v" sid="ECC 8:2"/>አት ሰበቢ ፉለ ዋቃ ዱረት ከኩ ገልቴፍ አጀጀ ሞቲ ኤግ። <verse eid="ECC 8:2"/><verse number="3" style="v" sid="ECC 8:3"/>ፉለ ሞቲ ዱራ ዴሙፍ ህንጀርጀርን። ዋን ሀማ ኬሰት ህንህርማትን፤ እን ዋን ፌዼ ከምዩ ንጎዻቲ። <verse eid="ECC 8:3"/><verse number="4" style="v" sid="ECC 8:4"/>ሰበቢ ዱቢን ሞቲ ዋን ሁንዳ ኦል ተኤፍ ኤኙቱ፣ “አት ማል ሆጄቻ ጅርተ?” እሳን ጄቹ ደንደአ?<verse eid="ECC 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 8:5"/>ነምን አጀጀ ሞቲ ኤጉ ከምዩ ህንሚዸሙ፤</para>
  <para style="q2" vid="ECC 8:5">ቀልቢን ኦጌሳሞ ዬሮፊ ሃለ ምጃኣ ቤከ።<verse eid="ECC 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 8:6"/>ረክን ነማ አከ መሌ እሰት ኡልፋቱዩ</para>
  <para style="q2" vid="ECC 8:6">ወን ሁንድ ዬሮፊ ሃለ ምጃኣ ቀባቲ።<verse eid="ECC 8:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 8:7"/>ሰበቢ ነምን ቶኮዩ ዋን ኤጌር ተኡ ህንቤክኔፍ፣</para>
  <para style="q2" vid="ECC 8:7">ኤኙቱ ዋን ዹፉፍ ጅሩ እሰት ህሙ ደንደአ?<verse eid="ECC 8:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 8:8"/>ነምን ቶኮዩ ሀፉረሳ ኦፍ ኬሰት ዾዉ ህንደንደኡ፤</para>
  <para style="q2" vid="ECC 8:8">ከናፉ ኤኙዩ ጉያ ዱአሳረት ሁምነ ህንቀቡ።</para>
  <para style="q1" vid="ECC 8:8">አኩመ ነምን ቶኮ ዬሮ ወራናት ዱለ ኬሳ ህንአርአምኔ ሰነ፣</para>
  <para style="q2" vid="ECC 8:8">ሀምንስ ወረ እሰ ሆጄቱ ገድ ህንዺሱ።<verse eid="ECC 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 8:9"/>አንስ ቀልቢኮ ገረ ዋን አዱዻ ገድት ሆጄተሙ ሁንዳት ዴብፈዼ ዋን ከነ ሁንደ ነንአርጌ። ዬሮን ነምን ቶኮ ወረ ካን ሁምናን ነንቡልቸ ጄዼ ኦፉመ ሚዹ ጅረ። <verse eid="ECC 8:9"/><verse number="10" style="v" sid="ECC 8:10"/>ኤርገሲስ አን ሀሞተ እዶ ቁልቁሉ ሴነኒ በኣ ቱረን ሰነ አከ እሳን አዋለመን ነንአርጌ፤ እሳንስ መጋላ እት ዋን አከሲ ሆጄተን ኬሰት ንጀጀሙ ቱሬ። ኩንስ ፋይዳ ህንቀቡ።<verse eid="ECC 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 8:11"/>ሰበቢ የከ ሆጄተሜ ቶኮቲፍ አደቢን ደፌ ህንኬነምኔፍ፣ ገራን ነሞታ መለ ሀምነ ሆጄቹቲን ጉተመ። <verse eid="ECC 8:11"/><verse number="12" style="v" sid="ECC 8:12"/>ጩበማን ቶኮ ዬሮ ዽበ የከ ሆጄቴ በረ ዼራ ጅራቱዩ፣ አን አከ ነሞትን ዋቀ ሶዳተን ከኔን ሶዳዻን ፉለሳ ዱረ ጅራተን ነጋ ቀባተን ነንቤከ። <verse eid="ECC 8:12"/><verse number="13" style="v" sid="ECC 8:13"/>ተኡስ ሀሞን ሰበቢ ዋቀ ህንሶዳትኔፍ ነጋ ህንቀባተን፤ በር ጅሬኘሳኒስ አከ ጋድዱ ህንዼረቱ።<verse eid="ECC 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="ECC 8:14"/>ዋን ፋይዳ ህንቀብኔ ከን ለፈረት ተኡ ቶኮቱ ጅረ፤ ኩንስ ቀጄልቶተ ዋን ሀሞታፍ መሉ አርገተኒፊ ሀሞተ ዋን ቀጄልቶታፍ መሉ አርገተኒዸ። አን ወን ኩን ፋይዳ ህንቀቡ ነንጄዸ። <verse eid="ECC 8:14"/><verse number="15" style="v" sid="ECC 8:15"/>ከናፉ ነማፍ ወን አዱዻ ገድት ኛቹ፣ ዹጉፊ ገመዱ ጫሉ ቶኮዩ ሰበቢ ህንጅሬፍ አን አከ ነምን ጅሬኘት ገመዱ ነንጎርሰ። አከሲን በረ ጅሬኘሳ ከን ዋቅን አዱዻ ገድት ኬኔፍ ሁንደ ኬሰት ሆጂሳረት ገመቹን እሰ ዱካ ቡአ።<verse eid="ECC 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="ECC 8:16"/>አን ዮሙን ቀልቢኮ ገረ ኦጉማ ቤኩፊ ሆጂ ነምን ኡቱ እጅሳ ሀልከኒፊ ጉያ ህርበ ህንአርገን ሆጄቱ እላሉት ዴብፈዼት፣ <verse eid="ECC 8:16"/><verse number="17" style="v" sid="ECC 8:17"/>ዋን ዋቅን ሆጄቴ ሁንደ ነንአርጌ። ነምን ቶኮዩ ዋን አዱዻ ገድት ተኣ ጅሩ ሁበቹ ህንደንደኡ። ነምን ዋን ከነ ብረ ገኡፍ ተታፈቱዩ ሂካሳ አርገቹ ህንደንደኡ። ኦጌስ ዋን ቤኩ ዮ ኦፍ ሴኤሌ እን ዹጉማን ሁበቹ ህንደንደኡ።<verse eid="ECC 8:17"/></para>
  <chapter eid="ECC 8"/>
  <chapter number="9" style="c" sid="ECC 9"/>
  <para style="s1">ገልገል ነመ ሁንዳ ቶኩመ</para>
  <para style="p">
    <verse number="1" style="v" sid="ECC 9:1"/>ከናፉ አን ዋን ከነ ሁንደ ገራት ቀበዼ አከ ቀጄላን፣ ኦጌሲፊ ሆጂወንሳኒ ሀርከ ዋቃ ኬሰ ጅረን ነንሁበዼ፤ ገሩ ነምን ቶኮዩ አከ ጃለል ዮካን ጅብ እሰ ኤገቱ ህንቤኩ። <verse eid="ECC 9:1"/><verse number="2" style="v" sid="ECC 9:2"/>ነመ ቀጄላፊ ጀልኣ፣ ነመ ጋሪፊ ሀማ፣ ነመ ቁልቁሉፊ ጡራኣ፣ ወረ ኣርሳ ዽኤሰኒፊ ወረ ህንዽኤስኔ ሁንደ ገልገልሳኒ ቶኩመ።</para>
  <para style="q1" vid="ECC 9:2">ዋኑመ ነመ ጋሪረ ገኡቱ፣</para>
  <para style="q2" vid="ECC 9:2">ጩበማረስ ገአ፤</para>
  <para style="q1" vid="ECC 9:2">ዋኑመ ወረ ከኩ ሴነንረ ገኡቱ፣</para>
  <para style="q2" vid="ECC 9:2">ወር ከኩ ሴኑ ሶዳተንረ ገአ።<verse eid="ECC 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="ECC 9:3"/>ሀምን ዋን አዱዻ ገድት ተኡ ሁንደ ኬሰ ጅሩ ከናዸ፦ ገልገል ነመ ሁንዳ ቶኮዸ። ከነ መሌስ ገራን ነሞታ ሀምናን ጉተሜ ጅረ፤ በረ ጅሬኘሳኒ ኬሰስ መራቱማቱ ገራሳኒ ኬሰ ጅረ፤ ኤርገሲ እሳን ወረ ዱአንት ደበለሙ። <verse eid="ECC 9:3"/><verse number="4" style="v" sid="ECC 9:4"/>ነምን ወረ ሉቡን ጅረን ሁንደት ደበለሙ ከምዩ አብዲ ቀበ። ሌንጨ ዱኤ መና ሰሬ ሉቡን ጅርቱ ወያቲ!<verse eid="ECC 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 9:5"/>ወር ሉቡን ጅረን አከ ዱአን ንቤኩቲ፤</para>
  <para style="q2" vid="ECC 9:5">ወር ዱአን ገሩ ሆማ ህንቤከን፤</para>
  <para style="q1" vid="ECC 9:5">እሳን ስአች ገቲ ህንቀበን፤</para>
  <para style="q2" vid="ECC 9:5">ያደኖንሳኒዩ ንእራንፈተመ።<verse eid="ECC 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 9:6"/>ጃለልሳኒ፣ ጅብሳኒቲፊ</para>
  <para style="q2" vid="ECC 9:6">ህናፋንሳኒ ኤርገ በዴ ቱሬረ፤</para>
  <para style="q1" vid="ECC 9:6">እሳን ዋን አዱዻ ገድት ተኡ ከምዩ ኬሰት</para>
  <para style="q2" vid="ECC 9:6">ለመተ ቆደ ህንቀባተን።<verse eid="ECC 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="ECC 9:7"/>ሰበቢ ዋቅን ዋን አት ሆጄቴት ገመዴፍ ዸቂቲ ኛተኬ ገመቹዻን ኛዹ፤ ዳዺ ወይኒኬቲስ ገራ ገመዱን ዹግ። <verse eid="ECC 9:7"/><verse number="8" style="v" sid="ECC 9:8"/>ዬሮ ሁንደ ኡፈተ አዲ ኡፈዹ፤ ዘይቲንስ መታኬራ ህንዸበምን። <verse eid="ECC 9:8"/><verse number="9" style="v" sid="ECC 9:9"/>በረ ጅሬኛ ከን ፋይዳ ህንቀብኔ፣ ከን ዋቅን አዱዻ ገድት ሲፍ ኬኔ ከነ ሁንደ በረኬ ከን ፋይዳ ህንቀብኔ ሁንደ ኬሰት ሃዸ መናኬ ከን ጃለቱ ወጅን ገመቹዻን ጅራዹ። ጅሬኛፊ ሆጂ አት አዱዻ ገድት እት ደዸብዴ ሰናፍ ቆድንኬ ከኑማቲ። <verse eid="ECC 9:9"/><verse number="10" style="v" sid="ECC 9:10"/>ዋን ሀርክኬ ሆጄቹ ደንደኡ ሁንደ ሁምነኬ ጉቱዻን ሆጄዹ፤ አዋለ አት እት ዴሙፍ ጅርቱ ኬሰ ሆጂን ዮካን ያድን ዮካን ቤኩምስ ዮካን ኦጉማን ህንጅሩቲ።<verse eid="ECC 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 9:11"/>አን አዱዻ ገድት ዋን ብራ አርጌረ፦</para>
  <para style="q1" vid="ECC 9:11">ፊግች ወረ ሰፍሰኒፍ</para>
  <para style="q2" vid="ECC 9:11">ዮካን ሎል እሬ ጀቤዪፍ ምት፤</para>
  <para style="q1" vid="ECC 9:11">ዮካን ኛትን ኦጌዪፍ</para>
  <para style="q2" vid="ECC 9:11">ዮካን ቀቤኝ ሁበቶታፍ</para>
  <para style="q2" vid="ECC 9:11">ዮካን ፉዸተመ አርገቹን ቤክቶታፍ ምት፤</para>
  <para style="q1" vid="ECC 9:11">ዬሮፊ ጨራን ሁንደሳኒ አርገተ።<verse eid="ECC 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="ECC 9:12"/>ነምን ቶኮዩ ዬሮንሳ ዮም አከ ተኤ ህንቤኩ፦</para>
  <para style="q1" vid="ECC 9:12">አኩመ ቁርጡሚን ክዮ ሀማዻን ቀበሙ፣</para>
  <para style="q2" vid="ECC 9:12">ዮካን አኩመ ስምብር ክዮዻን ቀበምቱ ሰነ</para>
  <para style="q1" vid="ECC 9:12">ነሞትንስ በረ ሀማ</para>
  <para style="q2" vid="ECC 9:12">አኩመ ተሳ እሳንት ዹፉን ቀበሙ።<verse eid="ECC 9:12"/></para>
  <para style="s1">ጎዉማረ ኦጉማ ወየ</para>
  <para style="p">
    <verse number="13" style="v" sid="ECC 9:13"/>አን አመሌ ፈኬኘ ኦጉማ ከን አከ መሌ ነ ድንቅሲሴ ከነ አዱዻ ገድት ነንአርጌ፦ <verse eid="ECC 9:13"/><verse number="14" style="v" sid="ECC 9:14"/>መጋላ ጥኖ ነሞትን ሙራስን ኬሰ ጅራተን ቶኮቱ ቱሬ። ሞቲን ጀባን ቶኮስ እሼት በኤ መርሴ፤ ኮቢ ብዮ ጉዳ ናኔሴ እት እጃሬ። <verse eid="ECC 9:14"/><verse number="15" style="v" sid="ECC 9:15"/>ዬሮ ሰነት ህዬሰ ኦጌሰ ቶኮቱ መጋላ ሰነ ኬሰ ጅራቻ ቱሬ፤ እንስ ኦጉማሳቲን መጋለቲ በራሬ። ነምን ቶኮዩ ገሩ ህዬሰ ሰነ ህንያደትኔ። <verse eid="ECC 9:15"/><verse number="16" style="v" sid="ECC 9:16"/>ከናፉ አን፣ “ጀብነረ ኦጉማ ወየ” ነንጄዼ። ኦጉማን ህዬሰ ሰና ገሩ ንቱፈተሜ፤ ዱቢንሳስ ፉዸተመ ህንአርገትኔ።<verse eid="ECC 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 9:17"/>እየ ቡልቻ ጎዎታረ</para>
  <para style="q2" vid="ECC 9:17">ሀሳሰ ኦጌሳቱ ዸገአመ።<verse eid="ECC 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 9:18"/>ሜሻሌ ወራናረ ኦጉማ ወየ፤</para>
  <para style="q2" vid="ECC 9:18">ጩበማን ቶኮ ገሩ ዋን ጋሪ ሄዱ በሌሰ።<verse eid="ECC 9:18"/></para>
  <para style="b"/>
  <chapter eid="ECC 9"/>
  <chapter number="10" style="c" sid="ECC 10"/>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 10:1"/>አኩመ ትሲስን ዱቴ ቶኮ ሽቶ አጄስቱ ሰነ</para>
  <para style="q2" vid="ECC 10:1">ጎዉማን ጥኖን ኦጉማፊ ኡልፍነ በሌሰ።<verse eid="ECC 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 10:2"/>ያድን ኦጌሳ ከራ ምርጋ፣</para>
  <para style="q2" vid="ECC 10:2">ያድን ጎዋሞ ከራ ብታ ጅረ።<verse eid="ECC 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 10:3"/>ጎዋን ዮ ከራ ዴሙሌ ቀልቢ ህንቀቡ፤</para>
  <para style="q2" vid="ECC 10:3">አከ ጎዋ ተኤስ ነመ ሁንደት አርግሲሰ።<verse eid="ECC 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 10:4"/>ዮ ዼከምስ ቡልቻ ቶኮ ስት ሀማቴ፣</para>
  <para style="q2" vid="ECC 10:4">አት እዶኬ ገድ ህንዺስን፤</para>
  <para style="q2" vid="ECC 10:4">ተስገባኡን ዶጎጎረ ጉዳ ሀምብሱ ደንደኣቲ።<verse eid="ECC 10:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 10:5"/>ሀምን አን አዱዻ ገድት አርጌ ቶኮ ጅረ፤</para>
  <para style="q2" vid="ECC 10:5">ኩንስ ዶጎጎረ ቡልቻን ቶኮ ኡሙዸ።<verse eid="ECC 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 10:6"/>ኡቱመ በዻዾን እዶ ገድ ኣኑ ቀበተኒ ጅረኑ፣</para>
  <para style="q2" vid="ECC 10:6">ጎዎትን እዶ ኡልፍና ቀበቱ።<verse eid="ECC 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 10:7"/>አን ኡቱመ እልማን ሞቶታ አከ ገርቦታ ሚላን ዴመኒ</para>
  <para style="q2" vid="ECC 10:7">ገርቦንሞ ፈርዳን ኡቱ ዴመኒ ነንአርጌ።<verse eid="ECC 10:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 10:8"/>ነምን ቦለ ቆቱ ከምዩ ኦፉመሳቲ ኬሰ ቡአ፤</para>
  <para style="q2" vid="ECC 10:8">ነመ ደላ ጨብሴ ኬሳን በኡ ከምዩ ቦፈቱ እደ።<verse eid="ECC 10:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 10:9"/>ነምን ዸጋ ባሱ ከምዩ ዸጋ ሰናን ሚዸሙ ደንደአ፤</para>
  <para style="q2" vid="ECC 10:9">ነምን ጅርመ በቀቅሱ ሁንድኑስ ጅርሙመ ሰናን ሚዸመ።<verse eid="ECC 10:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 10:10"/>ቆቶን ዶሜ</para>
  <para style="q2" vid="ECC 10:10">አፋንሳ ዮ ህንቀረምን፣</para>
  <para style="q1" vid="ECC 10:10">ሁምነ ጉዳ በርባችሰ፤</para>
  <para style="q2" vid="ECC 10:10">ኦጉማን ገሩ ምልካእነ ፍደ።<verse eid="ECC 10:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="ECC 10:11"/>ቦፍት ቶኮ ኡቱ ህንራቴፈምን ዮ ነመ እዴ፣</para>
  <para style="q2" vid="ECC 10:11">ነምች ቦፈ ራቴሱ ሱን ሆማ ህንአርገቱ።<verse eid="ECC 10:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="ECC 10:12"/>ዱቢን አፋን ኦጌሳቲ በኡ ኡልፍነ ቀበ፤</para>
  <para style="q2" vid="ECC 10:12">ነምን ጎዋንሞ ህዺ ኦፊሳቲን በደ።<verse eid="ECC 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 10:13"/>ዱቢንሳ ጀልቀበት ጎዉማዸ፤</para>
  <para style="q2" vid="ECC 10:13">ዹመረት ገሩ መራቱማ ሀማዸ፤<verse eid="ECC 10:13"/></para>
  <para style="q2">
    <verse number="14" style="v" sid="ECC 10:14"/>ነምን ጎዋን ዱቢ ባይእሰ።</para>
  <para style="b" vid="ECC 10:14"/>
  <para style="q1" vid="ECC 10:14">ነምን ቶኮዩ ዋን ዹፉፍ ጅሩ ህንቤኩ፤</para>
  <para style="q2" vid="ECC 10:14">ኤኙቱ ዋን እሰ ዱባን ተኡ እሰት ህሙ ደንደአ?<verse eid="ECC 10:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="ECC 10:15"/>ደዸቢን ጎዋ እሱመ ቡቱችት፤</para>
  <para style="q2" vid="ECC 10:15">እን ከራ ገረ መጋላት ጌሱ ህንቤኩ።<verse eid="ECC 10:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="ECC 10:16"/>ያ ብየ ሞቲንኬ ሙጫ ቱሬ፣</para>
  <para style="q2" vid="ECC 10:16">ከን እልማን ሞቶታኬ ገነማን ኛተኒ ዹገን ሲፍ ወዮ።<verse eid="ECC 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="ECC 10:17"/>ያ ብየ ሞቲንኬ ሰኚ ቤከማራ ዸለቴ፣</para>
  <para style="q2" vid="ECC 10:17">ከን እልማን ሞቶታ ኡቱ መቻኡፍ ህንተእን፣</para>
  <para style="q2" vid="ECC 10:17">ጀብነ አርገቹፍ ጄዸኒ ዬሮ መሉት ኛተኒ ዹገን፣ <optbreak/> አት ኤብፈምቱዸ።<verse eid="ECC 10:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="ECC 10:18"/>ዽባኡማን፣ መነ ዱፍሰ፤</para>
  <para style="q2" vid="ECC 10:18">ሀርክ ህንሆጄትኔስ መነ ዽምሲሰ።<verse eid="ECC 10:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="ECC 10:19"/>ጭዽ ኮልፋፍ ቆጴፈመ፤</para>
  <para style="q2" vid="ECC 10:19">ዳዺን ወይኒስ ጅሬኘ ገመቺሰ፤</para>
  <para style="q2" vid="ECC 10:19">ማለቅንሞ ዴቢ ዋን ሁንዳት።<verse eid="ECC 10:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="ECC 10:20"/>ሰበቢ ስምብር ሰሚ ዱቢኬ ጌስቱፍ፣</para>
  <para style="q2" vid="ECC 10:20">ዮካን ስምብር በርሳ ጅርቱ ዸቅጤ ዋን አት ጄቱ ህምቱፍ፣</para>
  <para style="q1" vid="ECC 10:20">አት ያደኬ ኬሰት ሞቲ ህንአረብስን፤</para>
  <para style="q2" vid="ECC 10:20">ዮካን ኩታ ህርባ ኬሰት ሶሬሰ ህንአባርን።<verse eid="ECC 10:20"/></para>
  <chapter eid="ECC 10"/>
  <chapter number="11" style="c" sid="ECC 11"/>
  <para style="s1">ቡዴነ ብሻንራ</para>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 11:1"/>ቡዴነኬ ብሻን ጉባ ቡስ፤</para>
  <para style="q2" vid="ECC 11:1">ጉያ ባይኤ ቦዴ ዴብፍቴ አርገታቲ።<verse eid="ECC 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 11:2"/>ቀቤኘኬ እዶ ቶርበት ዮካን ሰዴትት ቆድ፤</para>
  <para style="q2" vid="ECC 11:2">በላ ብየት ዹፉፍ ጅሩ ህንቤክቱቲ።<verse eid="ECC 11:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 11:3"/>ዱሜስ ዮ ብሻኒን ጉተሜ፣</para>
  <para style="q2" vid="ECC 11:3">ቦካ ለፈት ገድ ዸንገላሰ።</para>
  <para style="q1" vid="ECC 11:3">ሙክን ቶኮ ዮ ክበት ዮካን ካበት ጅጌ፣</para>
  <para style="q2" vid="ECC 11:3">እዱመ እት ኩፌ ሰነ ጪሰ።<verse eid="ECC 11:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 11:4"/>ነምን ቅሌንሰ ኤገቱ ቶኮ ህንፈጫፈቱ፤</para>
  <para style="q2" vid="ECC 11:4">ከን ዱሜሰ እላለቱስ ህንሃመቱ።<verse eid="ECC 11:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 11:5"/>አት አኩመ ዳንዲ ቡቤ፣</para>
  <para style="q2" vid="ECC 11:5">ዮካን አከ እት ነምን ገደሜሰ ሃዻ ኬሰት ኡመሙ <optbreak/> ህንቤክኔ ሰነ፣</para>
  <para style="q1" vid="ECC 11:5">ሆጂ ዋቃ፣ ኡማ ዋን ሁንዳ ሰነሌ</para>
  <para style="q2" vid="ECC 11:5">ቤኩ ህንደንዴሱ።<verse eid="ECC 11:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 11:6"/>እን ኩን ዮካን እን ሱን፣</para>
  <para style="q2" vid="ECC 11:6">ዮካን ለቸኑ ወል ቅጤ ቶሉ፤</para>
  <para style="q1" vid="ECC 11:6">እን ከም አከ ቶሉ ህንቤክቱቲ፤</para>
  <para style="q2" vid="ECC 11:6">አት ሰኚኬ ገነማን ፈጫፈዹ፤</para>
  <para style="q2" vid="ECC 11:6">ገልገለስ ሀርክኬ ሆጂ መሌ ህንታእን።<verse eid="ECC 11:6"/></para>
  <para style="s1">ደርገጉማት ኡማኬ ያደዹ</para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 11:7"/>እፍን ምኣኣዸ፤</para>
  <para style="q2" vid="ECC 11:7">አዱ አርጉንስ እጀ ገመቺሰ።<verse eid="ECC 11:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 11:8"/>ነምን ዮ ሀመም ወጎተ ባይኤ ጅራቴሌ፣</para>
  <para style="q2" vid="ECC 11:8">እን ሁንዱመሳት ገመዳ ሃጅራቱ።</para>
  <para style="q1" vid="ECC 11:8">ገሩ እን ጉዮተ ዱከና ሃያደቱ፤</para>
  <para style="q2" vid="ECC 11:8">እሳን ንባይአቱቲ።</para>
  <para style="q2" vid="ECC 11:8">ወን ዹፉፍ ጅሩ ሁንድኑ ፋይዳ ህንቀቡ።<verse eid="ECC 11:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="ECC 11:9"/>ያ ደርገጌሰ፣ ሀመ ደርገጉማ ኬሰ ጅርቱት ገመድ፤</para>
  <para style="q2" vid="ECC 11:9">በረ ደርገጉማኬቲ ኬሰስ ገራንኬ ስ ሃገመቺሱ።</para>
  <para style="q1" vid="ECC 11:9">ያደ ገራኬቲ፣ ዋኑመ እጅኬ አርጉ ዱካ ቡእ፤</para>
  <para style="q2" vid="ECC 11:9">ገሩ አከ ዋቅን ዋን ከነ ሁንዳፍ <optbreak/> ገረ ሙርቲት ስ ፍዱ ቤከዹ።<verse eid="ECC 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="ECC 11:10"/>ከናፉ ገራኬ ኬሳ ያዶ በሌስ፤</para>
  <para style="q2" vid="ECC 11:10">ሰበቢ ደርገጉማፊ ጀብን ፋይዳ ህንቀብኔፍ</para>
  <para style="q2" vid="ECC 11:10">ዸግነኬ ኬሳ ሀምነ ባሲ ገት።<verse eid="ECC 11:10"/></para>
  <para style="b"/>
  <chapter eid="ECC 11"/>
  <chapter number="12" style="c" sid="ECC 12"/>
  <para style="q1">
    <verse number="1" style="v" sid="ECC 12:1"/>ኡቱ ጉያን ረክና ህንዹፍን፣</para>
  <para style="q2" vid="ECC 12:1">ኡቱ በር አት እት፣ “አን እት ህንገመዱ” ጄቱ ህንገእን፣</para>
  <para style="q2" vid="ECC 12:1">በረ ደርገጉማኬቲ ኬሰ ኡማኬ ያደዹ፤<verse eid="ECC 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="ECC 12:2"/>ኡቱ አዱፊ እፍን፣</para>
  <para style="q2" vid="ECC 12:2">ጂኒፊ ኡርጂን ህንዱከናእን፣</para>
  <para style="q2" vid="ECC 12:2">ኡቱ ዱሜስ ቦካት ኣኔ ህንዴብእን፣<verse eid="ECC 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="ECC 12:3"/>ዬሮ እት ኤግዶን መና ሆለተኒ</para>
  <para style="q2" vid="ECC 12:3">ነሞትን ጀጀቦንሞ ጉጉፈንት፣</para>
  <para style="q1" vid="ECC 12:3">ዬሮ እት ወር ምዻን ዳከን ሰበቢ ሙራሰ ተአኒፍ <optbreak/> ሆጂ ዺሰኒ፣</para>
  <para style="q2" vid="ECC 12:3">ከኔን ፎዳ ኬሳን እላለን አርጉ ደዸበንት፣<verse eid="ECC 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="ECC 12:4"/>ዬሮ እት በልበል ዳንዲ ጉዳት ጌሱ ጩፈሜ</para>
  <para style="q2" vid="ECC 12:4">ሰገሌን ዸጋ ዳኩሞ ገድ ቡኣ ዴሙት፣</para>
  <para style="q1" vid="ECC 12:4">ዬሮ እት ነምን ወጨ ስምብሮቲን ደመቄ</para>
  <para style="q2" vid="ECC 12:4">ስርብሼ ሁንድ ገሩ ገድ ቡኣ ዴሙት፣<verse eid="ECC 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="ECC 12:5"/>ዬሮ እት ነምን ለፈ ኦል ዼራፊ</para>
  <para style="q2" vid="ECC 12:5">በላ ዳንዲራ ሶዳቱ፣</para>
  <para style="q1" vid="ECC 12:5">ዬሮ እት ሙክን ኦቾሎኒ ደራሩ፣</para>
  <para style="q2" vid="ECC 12:5">ዬሮ እት ኮሮጵስን ትረቱፊ</para>
  <para style="q2" vid="ECC 12:5">ሀዊን ነመ ኬሳ በዱት ኡማኬ ያደዹ።</para>
  <para style="q1" vid="ECC 12:5">ኤርገሲ ነምን መነሳ በረ በራት ገለ፤</para>
  <para style="q2" vid="ECC 12:5">ወር ቦአንስ ዳንዲረ ዴዴብኡ።<verse eid="ECC 12:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="ECC 12:6"/>ኡቱ ፉኞን ሜቲ ህንጭትን፣</para>
  <para style="q2" vid="ECC 12:6">ዮካን ኡቱ ወጪቲን ወርቄ ህንጨብን እሰ ያደዹ፤</para>
  <para style="q1" vid="ECC 12:6">ኡቱ ኦኮቴን ቡርቃ ብረት ህንጨጨብን፣</para>
  <para style="q2" vid="ECC 12:6">ዮካን ኡቱ ጌንጎን እቲን ብሻን ወራበን <optbreak/> ቦለ ብሻኒ ብረት ህንጨብን፣<verse eid="ECC 12:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="ECC 12:7"/>ኡቱ ብዮን ለፈ ቱሬት ህንዴብእን፣</para>
  <para style="q2" vid="ECC 12:7">ኡቱ ሀፉርስ ዋቀ እሰ ኬኔት ህንዴብእን እሰ ያደዹ።<verse eid="ECC 12:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="ECC 12:8"/>ለለባንስ፣ “ወን ሁንድ ፋይዳ ህንቀቡ! ፋይዳ ህንቀቡ!</para>
  <para style="q2" vid="ECC 12:8">ወን ሁንድ ፋይዳ ህንቀቡ!” ጄዸ።<verse eid="ECC 12:8"/></para>
  <para style="s1">ጡሙረ ዱቢ</para>
  <para style="p">
    <verse number="9" style="v" sid="ECC 12:9"/>ለለባን ሱን ኦጌሰ ቆፈ ኡቱ ህንተእን ቤኩምሰስ ነማፍ ንቆደ ቱሬ። እን እት ያዴ፣ ቆረቴ ፈኬኘ ባይኤ ተርቲባን ካኤረ። <verse eid="ECC 12:9"/><verse number="10" style="v" sid="ECC 12:10"/>ለለባን ኩን ጄቸ ስሪ አርገቹፍ ጄዼ ቆረቴ፤ ወን እን በሬሴስ ቀጄላፊ ዹጋዸ።<verse eid="ECC 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="ECC 12:11"/>ዱቢን ኦጌሳ አኩመ ሜሻ እቲን ሎን ኦፈኒት፤ ጄችሳ ከን ወልት ቀበሜስ አኩመ ምስማረ ጀቤፈሜ ሩኩተሜት፤ ከነስ ትክሴ ቶኮቱ ኬኔ። <verse eid="ECC 12:11"/><verse number="12" style="v" sid="ECC 12:12"/>ያ እልመኮ፣ ዋን ከነራ ሀፌ ሁንደ ኦፍ ኤገዹ።</para>
  <para style="p" vid="ECC 12:12">ክታበ ሄዱ በሬሱን ሆጂ ዹመ ህንቀብኔዸ፤ ቁአናን ባይኤንስ ነመ ደዸብሲሰ።<verse eid="ECC 12:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="ECC 12:13"/>አመ ወን ሁንድኑ ዸገአሜረ፤</para>
  <para style="q2" vid="ECC 12:13">ዹምን ዱቢ ኩኖት፤</para>
  <para style="q1" vid="ECC 12:13">ዋቀ ሶዳዹቲ ሴረሳ ኤግ፤</para>
  <para style="q2" vid="ECC 12:13">ወን ነምን ሆጄቹ መሉ ጉዳን እሰ ከናቲ።<verse eid="ECC 12:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="ECC 12:14"/>ዋቅን ሆጂ ሁንደ፣</para>
  <para style="q2" vid="ECC 12:14">ዋን ዾክፈሜ ሁንደስ</para>
  <para style="q2" vid="ECC 12:14">ጋሪ ዮካን ሀማ ታናን ሙርቲት ዽኤሳቲ።<verse eid="ECC 12:14"/></para>
  <chapter eid="ECC 12"/>
</usx>
