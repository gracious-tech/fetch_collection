<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="EZR" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">እዝራ</para>
  <para style="toc1">ክታበ እዝራ</para>
  <para style="toc2">እዝራ</para>
  <para style="toc3">እዝ</para>
  <para style="mt2">ክታበ</para>
  <para style="mt1">እዝራ</para>
  <chapter number="1" style="c" sid="EZR 1"/>
  <para style="s1">ለብሲ ቂሮስ</para>
  <para style="r">
    <ref loc="EZR 1:1-3">1፥1‑3</ref> ኩወፈ – <char style="xt"><ref loc="2CH 36:22-23">2ሴና 36፥22‑23</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 1:1"/>
    <char style="nd">ዋቀዮ</char> አከ ዱቢን <char style="nd">ዋቀዮ</char> ከን አፋን ኤርምያሲን ዱበተሜ ሱን ራወተሙፍ ጄዼ በረ ቂሮስ ሞትቸ ፋሬስ ኬሰ ወጋ ጀልቀባት አከ እን ሞቱማሳ ሁንደ ኬሰ ለብሲ ቶኮ ደበርሱፊ አከ ለብሲን ሱንስ በሬፈሙፍ ሀፉረ ቂሮስ ሞትቸ ፋሬስ ንከካሴ፤ ለብሲን ሱንስ አከነ ጄዸ፦<verse eid="EZR 1:1"/></para>
  <para style="pmo">
    <verse number="2" style="v" sid="EZR 1:2"/>“ቂሮስ ሞትች ፋሬስ አከነ ጄዸ፦</para>
  <para style="pm" vid="EZR 1:2">“ ‘<char style="nd">ዋቀዮ</char> ዋቅን ሰሚ ሞቱሞተ ለፈራ ሁንደ ናፍ ኬኔረ፤ አከ አን ይሁዳ ኬሰት ዬሩሳሌምት መነ ቁልቁሉማ እሳፍ እጃሩፍስ ነ ሙዴረ። <verse eid="EZR 1:2"/><verse number="3" style="v" sid="EZR 1:3"/>ሰበሳ ኬሳ ነመ ግዱኬሰንት አርገሙ ከምዩ ዋቅንሳ እሰ ወጅን ሃተኡ፤ እንስ ገረ ዬሩሳሌም እሼ ይሁዳ ኬሳ ሰና ኦል በኤ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ዋቀ እስራኤል፣ ዋቀ ዬሩሳሌም ኬሰ ጅራቱ ሰና ሃእጃሩ። <verse eid="EZR 1:3"/><verse number="4" style="v" sid="EZR 1:4"/>ወረ ሀፈኒ እዶ ከምዩ ጅራተን ሁንዳፍ ሰብን ብየ እሳን ኬሰ ጅራተን ሰና ኬና ፌዺዻን መነ ቁልቁሉማ ዋቃ ከን ዬሩሳሌም ኬሰ ጅሩ ሰናፍ ኬኑረት ደበሌ ሜቲፊ ወርቄ፣ ምኣፊ ሆሪ ጉማቹዻን እሰ ሃገርጋረን።’ ”<verse eid="EZR 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 1:5"/>ኤርገሲ ሀንገፎትን ማቲ ይሁዳፊ ቤንያም፣ ሉቦትኒፊ ሌዎትን ጄቹንስ ነሞትን ዋቅን ገራሳኒ ከካሴ ሁንድ ዸቀኒ መነ <char style="nd">ዋቀዮ</char> ከን ዬሩሳሌም ኬሳ ሰነ እጃሩፍ ቆጳአን። <verse eid="EZR 1:5"/><verse number="6" style="v" sid="EZR 1:6"/>ኦሎትንሳኒ ሁንድኑስ ኬና ፌዺዻን ኬነንረት ደበለኒ ምአ ሜቲፊ ወርቄ፣ ቆዳፊ ሆሪ አከሱመስ ኬናወን ገቲ ጉዳ ባሰን ጉማቹዻን እሳን ገርጋረን።<verse eid="EZR 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 1:7"/>ከነ መሌስ ቂሮስ ሞትች ምኦተ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ከኔን ኔቡከድኔዘር ዬሩሳሌሚ ጉረቴ መነ ዋቀሳ ኬሰ ካአቴ ቱሬ ሰነ ገድ ንባሴ። <verse eid="EZR 1:7"/><verse number="8" style="v" sid="EZR 1:8"/>ቂሮስ ሞትች ፋሬስ አከ ምትሬዳት እት ጋፈተማን ቀቤኛ ሱን ምአ ሰነ ፍዴ ሼሽበዛር ቡልቻ ይሁዳቲፍ ለካኡ ጎዼ።<verse eid="EZR 1:8"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="9" style="v" sid="EZR 1:9"/>ምኦን ሱንስ፦</para>
  <para style="b" vid="EZR 1:9"/>
  <para style="li1" vid="EZR 1:9">ሳኒ ወርቄ <char style="litl">30</char></para>
  <para style="li1" vid="EZR 1:9">ሳኒ ሜቲ <char style="litl">1,000</char></para>
  <para style="li1" vid="EZR 1:9">ድስቲ ሜቲ <char style="litl">29</char><verse eid="EZR 1:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="EZR 1:10"/>ወጪቲ ወርቄ <char style="litl">30</char></para>
  <para style="li1" vid="EZR 1:10">ወጪቲ ሜቲ ከን ቀዳደ ቀቡ <char style="litl">410</char></para>
  <para style="li1" vid="EZR 1:10">ምአ ጎሰ ብራ <char style="litl">1,000</char>።<verse eid="EZR 1:10"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="11" style="v" sid="EZR 1:11"/>ወሉማ ገለት ምአ ወርቄቲፊ ከን ሜቲ <char style="litl">5,400</char> ቱሬ።</para>
  <para style="b" vid="EZR 1:11"/>
  <para style="p" vid="EZR 1:11">ሼሽበዛርስ ምኦተ ከኔን ሁንደ ዬሮ ቦጅአምቶተ ባብሎኒ ባሴ ዬሩሳሌምት ጌሴት ጉሬ ዴሜ።<verse eid="EZR 1:11"/></para>
  <chapter eid="EZR 1"/>
  <chapter number="2" style="c" sid="EZR 2"/>
  <para style="s1">መቃ ነሞተ ቦጁዻ ዴብአኒ</para>
  <para style="r">
    <ref loc="EZR 2:1-70">2፥1‑70</ref> ኩወፈ – <char style="xt"><ref loc="NEH 7:6-73">ነህ 7፥6‑73</ref></char></para>
  <para style="lh">
    <verse number="1" style="v" sid="EZR 2:1"/>ኤጋ እሳን ኩኔን ነሞተ ኩታ ብየ ሰና ወረ ቦጁ ኔቡከድኔዘር ሞትች ባብሎን ሱን ቦጅኤ ባብሎንት እሳን ጌሴ ቱሬ ሰና ዴብአኒዸ፤ እሳንስ ዬሩሳሌሚፊ ይሁዳት ዴብአኒ ቶኮን ቶኮንሳኒ መጋላ ኦፊሳኒት ገለን፤ <verse eid="EZR 2:1"/><verse number="2" style="v" sid="EZR 2:2"/>እሳንስ፦ ዘሩባቤል፣ ዬሹኣ፣ ነህምያ፣ ሴራያ፣ ሬኤላያ፣ ሞርዴካይ፣ ብልሻን፣ ምስጳር፣ በጉዋይ፣ ሬሁሚፊ በአና ወጅን ዹፈን።</para>
  <para style="b" vid="EZR 2:2"/>
  <para style="lh" vid="EZR 2:2">መቃ ነሞተ ሰበ እስራኤል ተአኒ፦<verse eid="EZR 2:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="EZR 2:3"/>ሰኚን ጳሮሽ <char style="litl">2,172</char><verse eid="EZR 2:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="EZR 2:4"/>ሰኚን ሼፋጥያ <char style="litl">372</char><verse eid="EZR 2:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="EZR 2:5"/>ሰኚን ኣራ <char style="litl">775</char><verse eid="EZR 2:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="EZR 2:6"/>ሰኚን ፈሀት ሞኣብ ወር ከራ ዬሹኣፊ ዮኣብ ዸለተን <char style="litl">2,812</char><verse eid="EZR 2:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="EZR 2:7"/>ሰኚን ኤላም <char style="litl">1,254</char><verse eid="EZR 2:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="EZR 2:8"/>ሰኚን ዛቱ <char style="litl">945</char><verse eid="EZR 2:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="EZR 2:9"/>ሰኚን ዘካይ <char style="litl">760</char><verse eid="EZR 2:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="EZR 2:10"/>ሰኚን ባኒ <char style="litl">642</char><verse eid="EZR 2:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="EZR 2:11"/>ሰኚን ቤበይ <char style="litl">623</char><verse eid="EZR 2:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="EZR 2:12"/>ሰኚን አዝጋድ <char style="litl">1,222</char><verse eid="EZR 2:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="EZR 2:13"/>ሰኚን አዶኒቃም <char style="litl">666</char><verse eid="EZR 2:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="EZR 2:14"/>ሰኚን በጉዋይ <char style="litl">2,056</char><verse eid="EZR 2:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="EZR 2:15"/>ሰኚን ኣዲን <char style="litl">454</char><verse eid="EZR 2:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="EZR 2:16"/>ሰኚን አቴር ወር ከራ ህስቅያስ <char style="litl">98</char><verse eid="EZR 2:16"/></para>
  <para style="li1">
    <verse number="17" style="v" sid="EZR 2:17"/>ሰኚን ቤሳይ <char style="litl">323</char><verse eid="EZR 2:17"/></para>
  <para style="li1">
    <verse number="18" style="v" sid="EZR 2:18"/>ሰኚን ዮራ <char style="litl">112</char><verse eid="EZR 2:18"/></para>
  <para style="li1">
    <verse number="19" style="v" sid="EZR 2:19"/>ሰኚን ሃሹም <char style="litl">223</char><verse eid="EZR 2:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="EZR 2:20"/>ሰኚን ግባር <char style="litl">95</char><verse eid="EZR 2:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="EZR 2:21"/>ነሞትን ቤትልሄም <char style="litl">123</char><verse eid="EZR 2:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="EZR 2:22"/>ነሞትን ኔቶፋ <char style="litl">56</char><verse eid="EZR 2:22"/></para>
  <para style="li1">
    <verse number="23" style="v" sid="EZR 2:23"/>ነሞትን አናቶት <char style="litl">128</char><verse eid="EZR 2:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="EZR 2:24"/>ነሞትን አዝማዌት <char style="litl">42</char><verse eid="EZR 2:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="EZR 2:25"/>ነሞትን ክርያት ዬኣሪም ከን ኬፊራቲፊ ብኤሮት <char style="litl">743</char><verse eid="EZR 2:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="EZR 2:26"/>ነሞትን ራማፊ ጌባ <char style="litl">621</char><verse eid="EZR 2:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="EZR 2:27"/>ነሞትን ምክማስ <char style="litl">122</char><verse eid="EZR 2:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="EZR 2:28"/>ነሞትን ቤትኤሊፊ ኣይ <char style="litl">223</char><verse eid="EZR 2:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="EZR 2:29"/>ነሞትን ኔቦ <char style="litl">52</char><verse eid="EZR 2:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="EZR 2:30"/>ነሞትን መግቢሽ <char style="litl">156</char><verse eid="EZR 2:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="EZR 2:31"/>ነሞትን ኤላም ካን <char style="litl">1,254</char><verse eid="EZR 2:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="EZR 2:32"/>ነሞትን ሃሪም <char style="litl">320</char><verse eid="EZR 2:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="EZR 2:33"/>ነሞትን ሎድ፣ ከን ሃዲዲፊ ኦኖም <char style="litl">725</char><verse eid="EZR 2:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="EZR 2:34"/>ነሞትን ዬርኮ <char style="litl">345</char><verse eid="EZR 2:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="EZR 2:35"/>ነሞትን ሴናኣ <char style="litl">3,630</char>።<verse eid="EZR 2:35"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="36" style="v" sid="EZR 2:36"/>ሉቦተ፦</para>
  <para style="li1" vid="EZR 2:36">ሰኚን ዬዳእያ ወር ከራ ማቲ ዬሹኣን ዹፈን <char style="litl">973</char><verse eid="EZR 2:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="EZR 2:37"/>ሰኚን እሜር <char style="litl">1,052</char><verse eid="EZR 2:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="EZR 2:38"/>ሰኚን ጳሽሁር <char style="litl">1,247</char><verse eid="EZR 2:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="EZR 2:39"/>ሰኚን ሃሪም <char style="litl">1,017</char>።<verse eid="EZR 2:39"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="40" style="v" sid="EZR 2:40"/>ሌዎተ፦</para>
  <para style="li1" vid="EZR 2:40">ሰኚን ዬሹኣፊ ቀድሚኤል፣ ከራ ሆደይዋ ዹፈን <char style="litl">74</char>።<verse eid="EZR 2:40"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="41" style="v" sid="EZR 2:41"/>ፋርፈቶተ፦</para>
  <para style="li1" vid="EZR 2:41">ሰኚን አሳፍ <char style="litl">128</char>።<verse eid="EZR 2:41"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="42" style="v" sid="EZR 2:42"/>ኤግዶተ ከረ መነ ቁልቁሉማ፦</para>
  <para style="li1" vid="EZR 2:42">ሰኚን ሸሉም፣ ሰኚን አቴር፣</para>
  <para style="li1" vid="EZR 2:42">ሰኚን ተልሞን፣ ሰኚን አቁብ፣</para>
  <para style="li1" vid="EZR 2:42">ሰኚን ሀጢጣፊ ሰኚን ሶባይ <char style="litl">139</char>።<verse eid="EZR 2:42"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="43" style="v" sid="EZR 2:43"/>ተጃጅልቶተ መነ ቁልቁሉማ፦</para>
  <para style="li1" vid="EZR 2:43">ሰኚ ዚሃ፣ ሰኚ ሀሱፋፊ ሰኚ ጠባኦት፣<verse eid="EZR 2:43"/></para>
  <para style="li1">
    <verse number="44" style="v" sid="EZR 2:44"/>ሰኚ ኬሮስ፣ ሰኚ ሲኣ፣ ሰኚ ፋዶን፤<verse eid="EZR 2:44"/></para>
  <para style="li1">
    <verse number="45" style="v" sid="EZR 2:45"/>ሰኚ ሌባና፣ ሰኚ ሀጋባፊ ሰኚ አቁብ፤<verse eid="EZR 2:45"/></para>
  <para style="li1">
    <verse number="46" style="v" sid="EZR 2:46"/>ሰኚ ሃጋብ፣ ሰኚ ሸልማይ፣ ሰኚ ሃናን፤<verse eid="EZR 2:46"/></para>
  <para style="li1">
    <verse number="47" style="v" sid="EZR 2:47"/>ሰኚ ግዴል፣ ሰኚ ገሀር፣ ሰኚ ሬኣያ፤<verse eid="EZR 2:47"/></para>
  <para style="li1">
    <verse number="48" style="v" sid="EZR 2:48"/>ሰኚ ሬዚን፣ ሰኚ ኔቆዳ፣ ሰኚ ገዛም፤<verse eid="EZR 2:48"/></para>
  <para style="li1">
    <verse number="49" style="v" sid="EZR 2:49"/>ሰኚ ኡዛ፣ ሰኚ ፋሴሃ፣ ሰኚ ቤሳይ፤<verse eid="EZR 2:49"/></para>
  <para style="li1">
    <verse number="50" style="v" sid="EZR 2:50"/>ሰኚ አስና፣ ሰኚ ሜኡንሚፊ ሰኚ ኔፉሲም፤<verse eid="EZR 2:50"/></para>
  <para style="li1">
    <verse number="51" style="v" sid="EZR 2:51"/>ሰኚ በቅቡቅ፣ ሰኚ ሀቁፋ፣ ሰኚ ሀርሁር፣<verse eid="EZR 2:51"/></para>
  <para style="li1">
    <verse number="52" style="v" sid="EZR 2:52"/>ሰኚ በዝሉት፣ ሰኚ ምሂዳፊ ሰኚ ሀርሻ፤<verse eid="EZR 2:52"/></para>
  <para style="li1">
    <verse number="53" style="v" sid="EZR 2:53"/>ሰኚ በርቆስ፣ ሰኚ ሲሳራፊ ሰኚ ቴመህ፤<verse eid="EZR 2:53"/></para>
  <para style="li1">
    <verse number="54" style="v" sid="EZR 2:54"/>ሰኚ ኔዚያፊ ሰኚ ሀጢፋ።<verse eid="EZR 2:54"/></para>
  <para style="lh">
    <verse number="55" style="v" sid="EZR 2:55"/>ሰኚ ተጃጅልቶተ ሶሎሞን፦</para>
  <para style="li1" vid="EZR 2:55">ሰኚ ሶጣይ፣</para>
  <para style="li1" vid="EZR 2:55">ሰኚ ሶፌሬቲፊ ሰኚ ፍሩዳ፤<verse eid="EZR 2:55"/></para>
  <para style="li1">
    <verse number="56" style="v" sid="EZR 2:56"/>ሰኚ የእላ፣ ሰኚ ደርቆኒፊ ሰኚ ግዴል፤<verse eid="EZR 2:56"/></para>
  <para style="li1">
    <verse number="57" style="v" sid="EZR 2:57"/>ሰኚ ሼፋጥያ፣ ሰኚ ሀጢል፣</para>
  <para style="li1" vid="EZR 2:57">ሰኚ ፎኬሬት-ሀዝባይሚፊ ሰኚ ኣሚ፤<verse eid="EZR 2:57"/></para>
  <para style="lf">
    <verse number="58" style="v" sid="EZR 2:58"/>ተጃጅልቶተ መነ ቁልቁሉማቲፊ ሰኚን ተጃጅልቶተ ሶሎሞን <char style="litl">392</char>።<verse eid="EZR 2:58"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="59" style="v" sid="EZR 2:59"/>ወር አርማን ገዲስ መጋላወን ቴል ሜላ፣ ቴል ሀሬሻ፣ ክሩብ፣ አዳኒፊ እሜሪቲ ዹፈን፤ እሳን ገሩ አከ ማቲንሳኒ ሰኚ እስራኤል ተአን ምርከኔሱ ህንደንዴኜ፤ እሳንስ፦<verse eid="EZR 2:59"/></para>
  <para style="li1">
    <verse number="60" style="v" sid="EZR 2:60"/>ሰኚን ዴላያ፣ ሰኚን ጦብያፊ ሰኚን ኔቆዳ <char style="litl">652</char>።<verse eid="EZR 2:60"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="61" style="v" sid="EZR 2:61"/>ሉቦተ ኬሳሞ፦</para>
  <para style="li1" vid="EZR 2:61">ሰኚ ሀበያ፣ ሰኚ ሀቆሲፊ ከን በርዝላይ፤ በርዝላዪን ኩን ሰበቢ እንተለ በርዝላይ ነምቸ ግልኣድ ሰና ፉዼፍ መቃ ከናን ዋመሜ።<verse eid="EZR 2:61"/></para>
  <para style="lf">
    <verse number="62" style="v" sid="EZR 2:62"/>እሳን ኩኔን ሰበቢ ገልሜ ህደ ዸሎታ ኬሳ መቃ ማቲሳኒ በርባደኒ ዸበኒፍ አከ ጡራኦታት እላለመኒ ተጃጅለ ሉቡማ ዾወመን። <verse eid="EZR 2:62"/><verse number="63" style="v" sid="EZR 2:63"/>ቡልቻን ብየቲስ ሀመ ሉብን ኡሪሚፊ ቱሚሚዻን ተጃጅሉ ቶኮ አርገሙት አከ እሳን ኛተ ኛተ ሁንደ ጫላ ቁልቁሉ ተኤ ከምዩ ህንኛትኔፍ እሳን አጀጄ።<verse eid="EZR 2:63"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="64" style="v" sid="EZR 2:64"/>ወር ቦጁዻ ዴብአን ወሉማ ገለት ነሞተ 42,360 ቱረን፤ <verse eid="EZR 2:64"/><verse number="65" style="v" sid="EZR 2:65"/>ከነ መሌስ ተጃጅልቶትንሳኒ ዺራፊ ዱበርቲን 7,337 ቱረን፤ አከሱመስ እሳን ፋርፈቶተ ዺራፊ ዱበርቲ 200 ቀቡ ቱሬ። <verse eid="EZR 2:65"/><verse number="66" style="v" sid="EZR 2:66"/>እሳን ፈርደ 736፣ ጋንጎሊ 245፣ <verse eid="EZR 2:66"/><verse number="67" style="v" sid="EZR 2:67"/>ጋለ 435ፊ ሀሬ 6,720 ቀቡ ቱሬ።<verse eid="EZR 2:67"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="68" style="v" sid="EZR 2:68"/>ዮሙ እሳን መነ <char style="nd">ዋቀዮ</char> ከን ዬሩሳሌም ኬሰ ጅሩ ሰነ ገአንት ሀንገፎትን ማቲወኒ ቶኮ ቶኮ አከ መን ዋቃ እዶሳት ዴብኤ እጃረሙፍ ኬና ፌዺዻን ኬነሙ ንጉማቸን። <verse eid="EZR 2:68"/><verse number="69" style="v" sid="EZR 2:69"/>እሳንስ አኩመ ደንዴቲሳኒት ወርቄ ዳሪኪ<note caller="+" style="f"><char style="fr" closed="false">2፥69 </char><char style="ft" closed="false">ዳሪኪን ቶኮ ግራሚ 8።</char></note> 61,000፣ ሜቲ ምናኒ<note caller="+" style="f"><char style="fr" closed="false">2፥69 </char><char style="ft" closed="false">ምናኒን ቶኮ ግራሚ 600።</char></note> 5,000ፊ ኡፈተ ሉቦታ 100 ሆሪ ሆጂ ከናፍ ወልት ቀበሜት ንደበለን።<verse eid="EZR 2:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="EZR 2:70"/>ሉቦትን፣ ሌዎትን፣ ፋርፈቶትን፣ ኤግዶን ከራፊ ተጃጅልቶትን መነ ቁልቁሉማ ነሞተ ቶኮ ቶኮ ወጅን መጋላወን ኦፊሳኒ ኬሰ ቁበተን፤ እስራኤሎን ካን መጋላወን ኦፊሳኒ ኬሰ ቁበተን።<verse eid="EZR 2:70"/></para>
  <chapter eid="EZR 2"/>
  <chapter number="3" style="c" sid="EZR 3"/>
  <para style="s1">እዶ ኣርሳ ዴብሰኒ ቶልቹ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 3:1"/>ዬሮ ጅእ ቶርበፋን ዹፌ እስራኤሎን መጋላወንሳኒ ኬሰ ቁበተንት ኡመትን አኩመ ነመ ቶኮት ዬሩሳሌም ኬሰት ወልት ቀበሜ። <verse eid="EZR 3:1"/><verse number="2" style="v" sid="EZR 3:2"/>ኤርገሲስ ዬሹኣን እልም ዮዛዳቅ ፍሮተሳ ሉቦተ ወጅን፣ ዘሩባቤል እልም ሼአልቲኤል ፍሮተሳ ወጅን አኩመ ሴረ ሙሴ ነመ ዋቃ ሰና ኬሰት በሬፈሜት ኣርሳ ጉበሙ አችረት ዽኤሱዻፍ እዶ ኣርሳ ዋቀ እስራኤል እጃረን። <verse eid="EZR 3:2"/><verse number="3" style="v" sid="EZR 3:3"/>እሳንስ ሰበቢ ነሞተ ናኖሳኒ ሶዳተኒፍ እዶ ኣርሳ ሰነ ሁንዴሳረት እጃረኒ አችረት ኣርሳ ጉበሙ <char style="nd">ዋቀዮፍ</char> ዽኤሰን፤ ኣርሳ ከነስ ገነማፊ ገልገለ ዽኤሰን። <verse eid="EZR 3:3"/><verse number="4" style="v" sid="EZR 3:4"/>ኤርገሲ አኩመ በሬፈሜት አያነ ዳሲ ንአያኔፈተን፤ አኩመ ባይእነ ኣርሳ ጉያ ጉያፍ ረመደሜትስ ኣርሳ ጉበሙ ንዽኤሰን። <verse eid="EZR 3:4"/><verse number="5" style="v" sid="EZR 3:5"/>ከነ ቦዴስ እሳን ኣርሳ ጉበሙ ከን ዬሮ ዬሮት ዽኤፈሙ፣ ኣርሳ ባቲ ሃራፊ ኣርሳወን አያኖተ <char style="nd">ዋቀዮፍ</char> ቁልቁሌፈመን ሁንዳፍ፣ አከሱመስ ከኔን ፌዺዻን <char style="nd">ዋቀዮፍ</char> ዽኤፈመን ንኬነን። <verse eid="EZR 3:5"/><verse number="6" style="v" sid="EZR 3:6"/>ጉያ ጀልቀበ ጅአ ቶርበፋትስ ኣርሳ ጉበሙ <char style="nd">ዋቀዮፍ</char> ዽኤሱ ጀልቀበን፤ ገሩ ሁንዴን መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> አመሌ ህንቡፈምኔ ቱሬ።<verse eid="EZR 3:6"/></para>
  <para style="s1">መነ ቁልቁሉማ ዴብሰኒ እጃሩ</para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 3:7"/>ኤርገሲ እሳን ወረ ዸጋ ጨብሰኒፊ ኦጌዪ ሆጂ ሙካቲፍ ማለቀ ኬነን፤ ወረ ሲዶናፊ ጢሮሲፍሞ አከ እሳን አኩመ ቂሮስ ሞትች ፋሬስ አጀጄ ሰነት ልባኖኒ ገረ ዮጴት ገላነረ ብርብርሰ ገድ ኤርገኒፍ ኛተ፣ ዹጋቲፊ ዘይቲ ኬነን።<verse eid="EZR 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 3:8"/>እሳንስ ኤርገ መነ ዋቃ ከን ዬሩሳሌም ኬሳ ሰነ ገአኒ ቦዴ ጅአ ለመፋ ወጋ ለመፋት ዘሩባቤል እልም ሼአልቲኤል፣ ዬሹኣን እልም ዮዛዳቂፊ ኦቦሎትንሳኒ ካን ጄቹንስ ሉቦትን፣ ሌዎትኒፊ ወር ቦጁዻ ዬሩሳሌምት ዴብአን ሁንድኑ አከ እሳን እጃርሰ መነ <char style="nd">ዋቀዮ</char> ቶአተኒፍ ሌዎተ ኡሙሪንሳኒ ወጋ ድግደማፊ ሀመሲ ኦሊ ሙደኒ ሆጂ ሰነ ጀልቀበን። <verse eid="EZR 3:8"/><verse number="9" style="v" sid="EZR 3:9"/>ዬሹኣን እልማንሳፊ ኦቦሎተሳ ወጅን፣ ቀድሚኤሊፊ እልማንሳ፣ እልማን ይሁዳ፣ እልማን ሄናዳዲፊ ሌዎተ፣ እልማንሳኒፊ ፍሮተሳኒ ወጅን ወረ መነ ዋቃ እጃረን ቶአቹፍ ቶኮ ተአን።<verse eid="EZR 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="EZR 3:10"/>ዮሙ እጃርቶትን ሱን ሁንዴ መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ቡሰንት ሉቦትን ኡፈተሳኒ ኡፈተኒ መለከተ ቀበተን፤ ሌዎትንሞ ጄቹንስ እልማን አሳፍ ክልሌ ቀበተኒ አኩመ ዳዊት ሞትች እስራኤል አጀጄት <char style="nd">ዋቀዮን</char> ጀጀቹፍ እዶ ኦፊሳኒ ቀበተን። <verse eid="EZR 3:10"/><verse number="11" style="v" sid="EZR 3:11"/>እሳንስ፣</para>
  <para style="q1" vid="EZR 3:11">“እን ጋሪዸ፤</para>
  <para style="q2" vid="EZR 3:11">ጃለል እን እስራኤሊፍ ቀቡ በረ በራን ጅራተ”</para>
  <para style="m" vid="EZR 3:11">ጄዸኒ ሌልሱፊ ገለቴፈቹዻን <char style="nd">ዋቀዮን</char> ፋርፈተን። ሰብን ሁንድኑ ሰበቢ ሁንዴን መነ ቁልቁሉማ <char style="nd">ዋቀዮ</char> ቡፈሜፍ እዬ ሰገሌ ጉዳዻን <char style="nd">ዋቀዮን</char> ገለቴፈቴ። <verse eid="EZR 3:11"/><verse number="12" style="v" sid="EZR 3:12"/>ገሩ ሉቦትን፣ ሌዎትኒፊ ሀንገፎትን ማቲ ወር ዱሪ ከኔን መነ ቁልቁሉማ እሰ ዱራ ሰነ አርገን ሄዱን ዬሮ ሁንዴን መነ ቁልቁሉማ ከና ቡፈሙ አርገንት ሰገሌ ኦል ፉዸተኒ ቦአን፤ ወር ካን ሄዱንሞ ገመቹዻን እየን። <verse eid="EZR 3:12"/><verse number="13" style="v" sid="EZR 3:13"/>ሰበቢ ነሞትን አከ መሌ ወጨኒፍ ነምን ቶኮዩ እየ ገመቹፊ እየ ቦእቻ ገርገር ባሱ ህንደንዴኜ፤ ሰገሌን ሱንስ ፈጎት ዸገአመ ቱሬ።<verse eid="EZR 3:13"/></para>
  <chapter eid="EZR 3"/>
  <chapter number="4" style="c" sid="EZR 4"/>
  <para style="s1">ሞርሚ እጃርሰ መነ ቁልቁሉማ ሙደቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 4:1"/>ዲኖትን ይሁዳፊ ቤንያም ዬሮ አከ ወር ቦጁዻ ዴብአን ሱን <char style="nd">ዋቀዮ</char> ዋቀ እስራኤሊፍ መነ ቁልቁሉማ እጃራ ጅረን ዸገአንት፣ <verse eid="EZR 4:1"/><verse number="2" style="v" sid="EZR 4:2"/>ገረ ዘሩባቤሊፊ ገረ ሀንገፎትን ማቲወኒ ዹፈኒ አከነ ጄዸኒን፤ “ሰበቢ ኑስ አኩመኬሰን ዋቀኬሰን በርባኔ በረ ኤሰርሀዶን ሞትቸ አሶር ከን አስ ኑ ፍዴ ሰናቲ ጀልቀብኔ ኣርሳ ዽኤሰፊ ቱሬፍ ኑስ እስን ወጅን ሃእጃሩ።”<verse eid="EZR 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 4:3"/>ዘሩባቤል፣ ዬሹኣፊ ሀንገፎትን ማቲ እስራኤል ካን ገሩ፣ “እስን መነ ዋቀኬኛ ኑ ወጅን እጃሩፍ ቆደ ህንቀብደን። ኑመ ቆፈቱ አኩመ ቂሮስ ሞትች ፋሬስ ኑ አጀጄ ሰነት <char style="nd">ዋቀዮ</char> ዋቀ እስራኤሊፍ መነ ቁልቁሉማ እጃረ” ጄዸኒ ዴብሰን።<verse eid="EZR 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="EZR 4:4"/>ነሞትን ናኖሳኒ አከ እሳን እት ፉፈኒ እጃሩ ሶዳተኒፍ ነሞተ ይሁዳ አብዲ ኩተቺሱፍ ከአን። <verse eid="EZR 4:4"/><verse number="5" style="v" sid="EZR 4:5"/>እሳንስ በረ ቂሮስ ሞትቸ ፋሬሲቲ ጀልቀቤ ሀመ በረ ዳርዮስ ሞትቸ ፋሬስት ጅሩ ሁንደ ካዮሳኒ ጉፈቺሱዻፍ ቆንዳልቶተ እሳኒን ሞርመን እት ብተን።<verse eid="EZR 4:5"/></para>
  <para style="s1">ሞርሚ በረ አሀሽዌሮሲፊ አርጤክስስ ኬሰ ቱሬ</para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 4:6"/>እሳንስ ጀልቀበ በረ ሞቱማ አሀሽዌሮስት ሰበ ይሁዳፊ ከን ዬሩሳሌም ህመተን።<verse eid="EZR 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 4:7"/>በረ አርጤክስስ ሞትቸ ፋሬስ ኬሰ ቢሽላም፣ ምትሬዳት፣ ጣብኤሊፊ ምቾተሳ ብራ ጠለያ ቶኮ አርጤክስስት በሬሰን። ጠለያን ሱንስ ቁቤ አራማይኪፊ አፋን አራማይኪን በሬፈሜ።<verse eid="EZR 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 4:8"/>ሬሁም አጀጃን ቆንዳልትቺፊ ሺምሻይ በሬሳን ሱን ዬሩሳሌሚን ሞርሙዻን አከነ ጄዸኒ ጠለያ ቶኮ አርጤክስስ ሞትቸት በሬሰን፦<verse eid="EZR 4:8"/></para>
  <para style="pmo">
    <verse number="9" style="v" sid="EZR 4:9"/>ሬሁም አጀጃን ቆንዳልትች፣ ሺምሻይ በሬሳፊ ምቾተሳኒ ካን ወጅን ጄቹንስ አቦቲ ሙርቲፊ ቆንዳልቶተ ነሞተ ትርፖሊስ፣ ፋሬስ፣ አርኪፊ ባብሎን ዹፈን፣ አከሱመስ ወረ ኤላሞተ ሱሳ ዹፈን ቡልቸኒፊ <verse eid="EZR 4:9"/><verse number="10" style="v" sid="EZR 4:10"/>ነሞተ ኦስናጴር ጉድቺፊ ከበጀማን ሱን ብያ ባሴ መጋላ ሰማርያ ኬሳፊ ለገ ኤፍራጢስ ገመ ቁበቺሴ ካን ወጅን በሬሰን።<verse eid="EZR 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 4:11"/>ኩን ገረ ገልቸ ጠለያ ጀር እሳፍ ኤርገኒት።</para>
  <para style="pmo" vid="EZR 4:11">ገረ አርጤክስስ ሞትቻ፣</para>
  <para style="pmo" vid="EZR 4:11">ተጃጅልቶተኬ ወረ ለገ ኤፍራጢሲን ገማራ፦<verse eid="EZR 4:11"/></para>
  <para style="pm">
    <verse number="12" style="v" sid="EZR 4:12"/>ሞትች አከ ይሁዶትን ስ ብራ ገረኬኘ ዹፈን ሱን ዬሩሳሌም ዸቀኒ መጋላ ፍንጭልቱፊ ሀምቱ ሰነ ዴብሰኒ እጃራ ጅረን ቤኩ ቀበ። እሳን ደላ ዸጋ ዴብሰኒ እጃሩዻን ሁንዴወንሼ ጀጀቤሳ ጅሩ።<verse eid="EZR 4:12"/></para>
  <para style="pm">
    <verse number="13" style="v" sid="EZR 4:13"/>ከነ መሌዩ ሞትች አከ ዮ መጋላን ኩን እጃረምቴ ደላንሼ ጀጀቤፈሜ አከ ስአች ቀረጥን፣ ግብር ዮካን አሹራን ህንአርገምኔፊ አከ ገሊን ሞቱማስ ገድ ቡኡ ቤኩ ቀበ። <verse eid="EZR 4:13"/><verse number="14" style="v" sid="EZR 4:14"/>ኑ አመ ዋን እት ጋፈተሙማ መሰራ ሞቱማ ቀብኑፊ ዋን አከ ሞትች ኡልፍነ ዸቡ አርጉ ህንፌኔፍ አከ ሞትች ቤኩፍ ጄኔ ኤርጋ ከነ እት ኤርግኔረ፤ <verse eid="EZR 4:14"/><verse number="15" style="v" sid="EZR 4:15"/>ኩንስ አከ መኔን ገልሜ አቦቲኬቲ ሰከተአመኒፍ። አትስ ገልሜወን ከነ ኬሰት አከ መጋላን ኩን ዱሩማ ጀልቀብዴ መጋላ ፍንጭልቱ፣ ከን ሞቶታፊ ኩታሌ ብያ ረክፍቱ፣ እዶ ፍንጭልቱ ታቴ ንአርግተ። ወን መጋላን ኩን በርበዴፈምቴፍስ ከኑመ። <verse eid="EZR 4:15"/><verse number="16" style="v" sid="EZR 4:16"/>ያ ሞትቸ፣ ዮ መጋላን ኩን እጃረሜ ደላንሳስ ጀጀቤፈሜ፣ አከ አት ለገ ኤፍራጢስ ገማ ዋን ቶኮሌ ህንቀባትኔ ኑ ስት ህምነ።<verse eid="EZR 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="EZR 4:17"/>ሞትችስ አከነ ጄዼ ዴቢ ከነ ኤርጌ፦</para>
  <para style="pmo" vid="EZR 4:17">ገረ ሬሁም አጀጃ ቆንዳልትቻ፣ ሺምሻይ በሬሳፊ ምቾተሳኒ ከኔን ሰማርያ ኬሳፊ ኤፍራጢሲን ገመ ጅራተን ካኒት፦</para>
  <para style="pmo" vid="EZR 4:17">ነጋንኬኘ እስን ሃገኡ።<verse eid="EZR 4:17"/></para>
  <para style="pm">
    <verse number="18" style="v" sid="EZR 4:18"/>ጠለያን እስን ኑፍ ኤርግተን ሱን ዱብፈሜ ፉሉመኮ ዱረት ሂከሜረ። <verse eid="EZR 4:18"/><verse number="19" style="v" sid="EZR 4:19"/>አንስ አጀጀ ኬኔ ገልሜን ቆረተሜረ፤ መጋላን ኩንስ አከ ዱሩማ ጀልቀቤ ሞቶተት ፍንጭላ ቱርቴ፣ አከ እሼን ሆልቀ ፍንጭልቶታፊ ሞርምቶታ ታቴስ ቤከሜረ። <verse eid="EZR 4:19"/><verse number="20" style="v" sid="EZR 4:20"/>ዬሩሳሌም ሞቶተ ጭጭሞ ጉቱማ ገመ ለገ ኤፍራጢስ ቡልቸን ቀብድ ቱርቴ፤ ቀረጥን፣ ግብሪፊ አሹራን እሳኒፍ ኬነመ ቱሬ። <verse eid="EZR 4:20"/><verse number="21" style="v" sid="EZR 4:21"/>አከ መጋላን ኩን ዴብፈምቴ ህንእጃረምኔ ሀመ አን ለብሲ ባሱት አከ እሳን ሆጂ ዻበኒፍ እስን አመ ነሞተ ከኔንት አጀጀ ደበርሳ። <verse eid="EZR 4:21"/><verse number="22" style="v" sid="EZR 4:22"/>አከ ዋን ከነ ህንቱፈኔፍ ኦፍ ኤገዻ። ማሊፍ ሀመ ረኮን ኩን ጉደቴ ፌዺ ሞቱማት ጉፉ ተኡት እቱመ ዺፍቱ?<verse eid="EZR 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="EZR 4:23"/>አኩመ ገረገልች ጠለያ አርጤክስስ ሞትቻ ሱን ፉለ ሬሁም፣ ሺምሻይ በሬሳፊ ምቾተሳኒ ዱረት ዱብፈሜን እሳን ዮሱመ ገረ ይሁዶተ ዬሩሳሌም ኬሰ ጅራተኒ ዸቀኒ ሁምናን ሆጂ እሳን ዻብስሰን።<verse eid="EZR 4:23"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="24" style="v" sid="EZR 4:24"/>አከሲን ሆጂን መነ ዋቃ ከን ዬሩሳሌም ኬሳ ሱን ሀመ ወጋ ለመፋ በረ ዳርዮስ ሞትቸ ፋሬስት ንዻበቴ።<verse eid="EZR 4:24"/></para>
  <chapter eid="EZR 4"/>
  <chapter number="5" style="c" sid="EZR 5"/>
  <para style="s1">ጠለያ ታቴናይ ዳርዮስት ኤርጌ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 5:1"/>ዬሮ ከነት ሃጌን ራጅቺፊ ዘካርያስ እልም እዶ ራጅች፣ መቃ ዋቀ እስራኤል ከን እሳን ወጅን ጅራቱ ሰናን ይሁዶተ ወረ ይሁዳፊ ዬሩሳሌም ኬሰ ጅረንት ራጂ ዱበተን። <verse eid="EZR 5:1"/><verse number="2" style="v" sid="EZR 5:2"/>ከነረት ዘሩባቤል እልም ሼአልቲኤሊፊ እያሱን እልም ዮሳዳቅ ዬሩሳሌም ኬሰት መነ ዋቃ ዴብሰኒ እጃሩ ጀልቀበን። ራጆትን ዋቃስ እሳን ገርጋሩፍ እሳኑመ ወጅን ቱረን።<verse eid="EZR 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 5:3"/>ዬሮ ሰነት ታቴናይ ቡልቻን ገመ ለገ ኤፍራጢስ፣ ሰተርቡዝናዪፊ ዴገርቶትንሳኒ ገረሳኒ ዸቀኒ፣ “አከ እስን መነ ቁልቁሉማ ከነ ዴብፍተኒ እጃርተኒፊ አከ እስን ደላ ዸጋ ከነስ አከ ዱሪት ዴብፍተን ኤኙቱ እስኒፍ ኤየሜ?” ጄዸኒ ጋፈተን። <verse eid="EZR 5:3"/><verse number="4" style="v" sid="EZR 5:4"/>አከሱመስ፣ “መቃን ወረ መነ ከነ እጃሩ ኤኙ ፈእ?” ጄዸኒ ጋፈተን። <verse eid="EZR 5:4"/><verse number="5" style="v" sid="EZR 5:5"/>ገሩ እጅ ዋቀሳኒ ማንጉዶተ ይሁዳረ ቱርቴ፤ እሳንስ ሀመ ገባስን ሱን ዳርዮስ ብረ ገኤ ዴቢንሳ በሬፈማን ዹፉት ሆጂ ህንዻብኔ።<verse eid="EZR 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="EZR 5:6"/>ኩንስ ገረገልቻ ጠለያ ታቴናይ ቡልቻን ገመ ለገ ኤፍራጢስ፣ ሰተርቡዝናይ፣ ዴገርቶትንሳኒፊ ቆንዳልቶትን ገመ ለገ ኤፍራጢስ ጅራተን ዳርዮስ ሞትቸት ኤርገኒት። <verse eid="EZR 5:6"/><verse number="7" style="v" sid="EZR 5:7"/>ገባስን እሳን ኤርገኒፍ ሱንስ አከነ ጄዸ፦</para>
  <para style="pmo" vid="EZR 5:7">ገረ ዳርዮስ ሞትቻ፦</para>
  <para style="pmo" vid="EZR 5:7">ነጋ ኡልፍናን ጉተሜ ሲፍ ኤርግነ።<verse eid="EZR 5:7"/></para>
  <para style="pm">
    <verse number="8" style="v" sid="EZR 5:8"/>ሞትች አከ ኑ ገረ ኣና ይሁዳ ገረ መነ ቁልቁሉማ ዋቀ ጉድቻ ዸቅኔ ቱሬ ሃቤኩ። ነሞትን ዸጋ ጉርጉዳዻን መነ ሰነ እጃራ፣ ላጣስ ኬኘን መና ኬሰ ካኣ ጅሩ። ሆጂን ኩንስ ጭምናን ሆጄተማ ሀርከሳኒ ጀለት ጉድነ አርግሲሳ ጅረ።<verse eid="EZR 5:8"/></para>
  <para style="pm">
    <verse number="9" style="v" sid="EZR 5:9"/>ኑ ማንጉዶተ ሰነ ዱብፍኔ፣ “ኤኙቱ አከ እስን መነ ቁልቁሉማ ከነ ዴብፍተኒ እጃርተኒፊ አከ እስን እጃርሰሳ አከ ዱሪት ዴብፍተን እስኒፍ ኤየሜ?” ጄኔ እሳን ጋፈትኔ። <verse eid="EZR 5:9"/><verse number="10" style="v" sid="EZR 5:10"/>አከሱመስ አከ መቃ ሆገንቶተሳኒ በሬስኔ ስ ቤክስፍኑፍ መቃሳኒሌ ጋፈትኔ ቱሬ።<verse eid="EZR 5:10"/></para>
  <para style="pm">
    <verse number="11" style="v" sid="EZR 5:11"/>እሳንስ ዴቢ ከነ ኑ ኬነን፦</para>
  <para style="b" vid="EZR 5:11"/>
  <para style="pm" vid="EZR 5:11">“ኑ ገርቦተ ዋቀ ሰሚፊ ለፋት፤ ኑ መነ ቁልቁሉማ ከን በረ ዼራን ዱረ እጃረሜ፣ ከን ሞቲን እስራኤል ጉድች እጃሬ ፍጤ ሰነ ዴብፍኔ እጃራ ጅረ። <verse eid="EZR 5:11"/><verse number="12" style="v" sid="EZR 5:12"/>ገሩ ሰበቢ አቦቲንኬኘ ዋቀ ሰሚ ኣርሰኒፍ እን ደበርሴ ሀርከ ኔቡከድኔዘር ነምቸ ብየ ከልዶታ፣ ሞቲ ባብሎንት እሳን ኬኔ፤ እንስ መነ ቁልቁሉማ ከነ በርበዴሴ ኡመተስ ብያ ባሴ ባብሎንት ጌሴ።<verse eid="EZR 5:12"/></para>
  <para style="pm">
    <verse number="13" style="v" sid="EZR 5:13"/>“ተኡሌ ወጋ ቶኮፋ በረ ሞቱማ ቂሮስ ሞትቸ ባብሎን ኬሰ ቂሮስ ሞትች አከ መን ዋቃ ኩን ዴብፈሜ እጃረሙፍ ለብሲ ቶኮ ለብሴ። <verse eid="EZR 5:13"/><verse number="14" style="v" sid="EZR 5:14"/>እንስ ምአ ወርቄፊ ሜቲ መነ ዋቃ ከን ኔቡከድኔዘር መነ ቁልቁሉማ ዬሩሳሌም ኬሳ ጉሬ ባብሎንት ጌሴ ሰነ መሰራ ሞቱማ ባብሎን ኬሳ ንባሴ። ቂሮስ ሞትች ነምቸ ሼሽበሳር ጄዸሙ ከን እን ቡልቻ ጎዼ ሙዴ ሰነት ምአ ከነ ኬኔ <verse eid="EZR 5:14"/><verse number="15" style="v" sid="EZR 5:15"/>አከነ ጄዼን፤ ‘ምአ ከነ ፉዺ ዸቂቲ መነ ቁልቁሉማ ከን ዬሩሳሌም ኬሰ ጅሩ ሰነት ገልች። መነ ዋቃስ እዶሳት ዴብሲ እጃር።’<verse eid="EZR 5:15"/></para>
  <para style="pm">
    <verse number="16" style="v" sid="EZR 5:16"/>“ኤርገሲስ ሼሽበሳር ኩን ዹፌ ሁንዴ መነ ዋቃ ከን ዬሩሳሌም ኬሳ ቡሴ። ዬሮ ሰና ጀልቀቤ ሀመ አማት መን ሱን እጃረማ ጅረ፤ ገሩ አመሌ ህንዹምኔ።”<verse eid="EZR 5:16"/></para>
  <para style="b"/>
  <para style="pm">
    <verse number="17" style="v" sid="EZR 5:17"/>ኤጋ አመ ዮ ፌዺ ሞትቻ ተኤ፣ ቂሮስ ሞትች ዹጉማን አከ መን ዋቃ ኩን ዬሩሳሌም ኬሰት ዴብፈሜ እጃረሙፍ ለብሲ ባሱፊ ባሱ ባቹሳ ቤኩፍ ገልሜን መሰራ ሞቱማ ባብሎን ሃቆረተሙ። ኤርገሲስ ሞትች ያደ ዋን ከነረት ቀቡ ኑፍ ሃኤርጉ።<verse eid="EZR 5:17"/></para>
  <chapter eid="EZR 5"/>
  <chapter number="6" style="c" sid="EZR 6"/>
  <para style="s1">ለብሲ ዳርዮስ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 6:1"/>ከነረት ዳርዮስ ሞትች አጀጀ ኬኔ፤ እሳንስ ገልሜወን መነ ገልሜ ባብሎን ኬሰት ኩፈመን ሰነ ንሰከተአን። <verse eid="EZR 6:1"/><verse number="2" style="v" sid="EZR 6:2"/>ክታብን መረማን ቶኮስ አህሜታ መጋላ ጉዳ ኩታ ብያ ሜዴ ኬሰት አርገሜ፤ ክታበ ሰነረትስ አከነ ጄዸሜ በሬፈሜ ቱሬ፦</para>
  <para style="pmo" vid="EZR 6:2">ያደቺሰ፦<verse eid="EZR 6:2"/></para>
  <para style="pm">
    <verse number="3" style="v" sid="EZR 6:3"/>ወጋ ቶኮፋ በረ ሞቱማ ቂሮስ ሞትቻ ኬሰ ሞትች ዋኤ መነ ቁልቁሉማ ዋቃ ከን ዬሩሳሌም ኬሰ ጅሩ ሰና አከነ ጄዼ ለብሲ ባሴ፦</para>
  <para style="b" vid="EZR 6:3"/>
  <para style="pm" vid="EZR 6:3">መን ቁልቁሉማ ኩን እዶ ኣርሳን እት ዽኤፈሙ ተኤ ዴብፈሜ ሃእጃረሙ፤ ሁንዴንሳስ ሃቡፈሙ። መን ኩንስ ኦል ዼርነ ዹንዹመ ጃተማፊ በልእነ ዹንዹመ ጃተመ ቀባቴ <verse eid="EZR 6:3"/><verse number="4" style="v" sid="EZR 6:4"/>ዸጋ ጉርጉዳ ቶረ ሰዲ ሰዲፊ ሙከ ቶረ ቶኮ ቶኮን ሃእጃረሙ። ባሲን ሁንድኑስ ቀቤኘ ሞቱማ ኬሳ ባፈሙ ቀበ። <verse eid="EZR 6:4"/><verse number="5" style="v" sid="EZR 6:5"/>አከሱመስ ምእ ወርቄፊ ሜቲ መነ ዋቃ ከን ኔቡከድኔዘር መነ ቁልቁሉማ ከን ዬሩሳሌም ኬሳቲ ባብሎንት ፍዴ ሱን እዶ እሳንት ጄቹንስ መነ ቁልቁሉማ ከን ዬሩሳሌምት ዴብፈመኒ መነ ዋቃ ኬሰ ኩፈሙ ቀቡ።<verse eid="EZR 6:5"/></para>
  <para style="b"/>
  <para style="pm">
    <verse number="6" style="v" sid="EZR 6:6"/>ኤጋ አት ታቴናይ ቡልቻን ገመ ለገ ኤፍራጢስ፣ ሰተርቡዝናዪፊ እስን ምቾተሳኒ ቆንዳልቶትን ኩታ ብየ ሰና አቺ ፈጋዻ። <verse eid="EZR 6:6"/><verse number="7" style="v" sid="EZR 6:7"/>እስን ሆጂ መነ ቁልቁሉማ ዋቃ ከነ ኬሰ ህንሴንና። ቡልቻን ይሁዶታፊ ማንጉዶትን ይሁዶታ መነ ዋቃ ከነ እዶሳት ዴብሰኒ ሃእጃረን።<verse eid="EZR 6:7"/></para>
  <para style="pm">
    <verse number="8" style="v" sid="EZR 6:8"/>ከነረት አን ዋን እስን እጃርሰ መነ ዋቃ ከነ ኬሰት ማንጉዶተ ይሁዶታ ከኔኒፍ ጎቹ ቀብደን ኩኖ ነንለብሰ፦</para>
  <para style="pm" vid="EZR 6:8">አከ ሆጂን ህንዻበኔፍ ባሲን ነሞተ ከና ጉቱማን ጉቱት ቀቤኘ ሞቱማራ ጄቹንስ ግብረ ገመ ለገ ኤፍራጢሲ ወልት ቀበሙ ኬሳ ሃባፈሙ። <verse eid="EZR 6:8"/><verse number="9" style="v" sid="EZR 6:9"/>ወን በርባችሱ ከምዩ ጄቹንስ ጅቦን፣ ኮርቤዪኒፊ ጦባላወን ሆላ ዋቀ ሰሚቲፍ ኣርሳ ጉበሙ ተአኒ ዽኤፈመን፣ አከሱመስ ቀመዲን፣ ሶግድ፣ ዳዺን ወይኒፊ ዘይቲን አኩመ ሉቦትን ዬሩሳሌም ኬሰ ጅራተን በርባደንት ኡቱ ገርገር ህንጭትን ጉያ ጉያዻን እሳኒፍ ኬነሙ ቀቡ፤ <verse eid="EZR 6:9"/><verse number="10" style="v" sid="EZR 6:10"/>ኩንስ አከ እሳን ኣርሳ ዋቀ ሰሚት ቶሉ ዽኤሰኒፊ አከ እሳን ጅሬኘ ሞትቻፊ እልማንሳቲፍ ዋቀ ከዸተኒፊዸ።<verse eid="EZR 6:10"/></para>
  <para style="pm">
    <verse number="11" style="v" sid="EZR 6:11"/>ከነ ጫላዩ ዮ ነምን ከምዩ አጀጀ ከነ ድዴ፣ አን አከ ኡቱባን መነሳ ኬሳ ቡቅፈሜ እንረት ፈንፈሙ ለብሲ ከነ ለብሴረ። ሰበቢ የከ ከናቲፍ መንሳ ቱላ ኮሲ ንተአ። <verse eid="EZR 6:11"/><verse number="12" style="v" sid="EZR 6:12"/>ዋቅን እን አከ መቃንሳ አች ጅራቱ ጎዼ ሱን ሞቲ ዮካን ሰበ ለብሲ ከነ ጌደሩፍ ዮካን መነ ቁልቁሉማ ከን ዬሩሳሌም ኬሳ በርበዴሱፍ ሀርከ ኦል ፉዸቱ ከምዩ ሃበሌሱ።</para>
  <para style="pm" vid="EZR 6:12">አን ዳርዮስ ለብሲ ከነ ለብሴረ። ወን ኩንስ አሪቲዻን ሆጂረ ሃኦሉ።<verse eid="EZR 6:12"/></para>
  <para style="s1">መን ቁልቁሉማ ጡሙረሜ ኤብፈሜ</para>
  <para style="p">
    <verse number="13" style="v" sid="EZR 6:13"/>ኤርገሲ ታቴናይ ቡልቻን ብየ ገመ ለገ ኤፍራጢስ፣ ሰተርቡዝናዪፊ ምቾትንሳኒ አኩመ ዳርዮስ ሞትች ለብሴት ለብሲ ሰነ አሪቲዻን ሆጂረ ንኦልቸን። <verse eid="EZR 6:13"/><verse number="14" style="v" sid="EZR 6:14"/>ከናፉ ማንጉዶትን ይሁዶታ ለለበ ሃጌ ራጅቻቲፊ ዘካርያስ እልመ እዶቲን እጃርሰ እት ፉፈን፤ ሆጂንስ ንምልካኤፍ። እሳንስ አኩመ አጀጀ ዋቀ እስራኤሊፊ አኩመ ለብሲወን ቂሮስ፣ ዳርዮሲፊ አርጤክስስ ሞቶተ ፋሬስት እጃርሰ መነ ቁልቁሉማ ሰነ ንጡሙረን። <verse eid="EZR 6:14"/><verse number="15" style="v" sid="EZR 6:15"/>መን ቁልቁሉማ ሱንስ ወጋ ጀአፋ በረ ዳርዮስ ሞትቻ ኬሰ፣ ቡልቲ ሰደፋ ጅአ አዳርት እጃረሜ ዹሜ።<verse eid="EZR 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZR 6:16"/>ኤርገሲ ሰብን እስራኤል ጄቹንስ ሉቦትን፣ ሌዎትኒፊ ቦጅአምቶትን ሀፈን አያነ ኤበ መነ ዋቃ ገመቹዻን አያኔፈተን። <verse eid="EZR 6:16"/><verse number="17" style="v" sid="EZR 6:17"/>ኤበ መነ ዋቃ ከናፍስ ጅቦተ ዽበ ቶኮ፣ ኮርቤዪ ሆላ ዽበ ለማፊ ጦባላ ሆላ ዽበ አፉር ኬነን፤ ሰበቢ ጩቡ እስራኤል ሁንዳፍሞ ኮርቤዪ ሬኤ ኩዸ ለመ ጄቹንስ ቶኮ ቶኮ ጎሰ እስራኤሊፍ ሬኤ ቶኮ ቶኮ ዽኤሰን። <verse eid="EZR 6:17"/><verse number="18" style="v" sid="EZR 6:18"/>ኤርገሲሞ አኩመ ክታበ ሙሴ ኬሰት በሬፈሜት ተጃጅለ መነ ዋቃ ከን ዬሩሳሌም ኬሳ ሰናፍ ሉቦተ ኩታ ኩታ እሳንት፣ ሌዎተሞ ገሬ ገሬሳኒት ረመደን።<verse eid="EZR 6:18"/></para>
  <para style="s1">ፋሲካ</para>
  <para style="p">
    <verse number="19" style="v" sid="EZR 6:19"/>ቦጅአምቶትንስ ጉያ ኩዸ አፉረፋ ጅአ ጀልቀባት ፋሲካ ንአያኔፈተን። <verse eid="EZR 6:19"/><verse number="20" style="v" sid="EZR 6:20"/>ሉቦትኒፊ ሌዎትን ኦፍ ቁልቁሌሰኒ ሁንድሳኒ አከ ሴራት ንቁልቁላአን። ሌዎትን ወረ ቦጅአመን ሁንዳፍ፣ ኦቦሎተሳኒ ሉቦታፊ ኦፊሳኒፍ ሆላ ፋሲካ ቀለን። <verse eid="EZR 6:20"/><verse number="21" style="v" sid="EZR 6:21"/>ከናፉ እስራኤሎን ቦጁዻ ዴብአን ነሞተ <char style="nd">ዋቀዮ</char> ዋቀ እስራኤል በርባዱዻፍ ሆጂ ጡራኡማ ከን ነሞተ ኦርማ ከኔን ኦላሳኒ ጅራተን ሰና ለገተን ሁንደ ወጅን ፋሲካ ሰነ ንኛተን። <verse eid="EZR 6:21"/><verse number="22" style="v" sid="EZR 6:22"/>ሰበቢ <char style="nd">ዋቀዮ</char> አከ እን ሆጂ እጃርሰ መነ ዋቀዮ ዋቀ እስራኤል ኬሰት እሳን ገርጋሩዻፍ ያደ ሞቲ አሶር ጌደሩዻን ገመቹዻን እሳን ጉቴፍ እሳን ቡልቲ ቶርበ ጉቱ አያነ መጥኖ ቡዴነ ገመቹዻን አያኔፈተን።<verse eid="EZR 6:22"/></para>
  <chapter eid="EZR 6"/>
  <chapter number="7" style="c" sid="EZR 7"/>
  <para style="s1">እዝራን ዬሩሳሌም ዹፌ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 7:1"/>ወንቶተ ከኔን ቦዴ በረ አርጤክስስ ሞትቸ ፋሬስ ኬሰ እዝራን እልም ሴራያ፣ እልም አዛርያ እልም ህልቅያ፣ <verse eid="EZR 7:1"/><verse number="2" style="v" sid="EZR 7:2"/>እልም ሸሉም፣ እልም ዛዶቅ፣ እልም አሂጡብ፣ <verse eid="EZR 7:2"/><verse number="3" style="v" sid="EZR 7:3"/>እልም አመርያ፣ እልም አዛርያ፣ እልም ሜራዮት፣ <verse eid="EZR 7:3"/><verse number="4" style="v" sid="EZR 7:4"/>እልም ዜራያ፣ እልም ኡዚ፣ እልም ቡኪ፣ <verse eid="EZR 7:4"/><verse number="5" style="v" sid="EZR 7:5"/>እልም አቢሹዋ፣ እልም ፊኔሃስ፣ እልም ኤሌኣዛር፣ እልም አሮን ሉብቸ ኦል ኣና <verse eid="EZR 7:5"/><verse number="6" style="v" sid="EZR 7:6"/>እዝራን ኩን ባብሎኒ ዹፌ። እንስ በርሲሳ ሴረ ሙሴ ከን <char style="nd">ዋቀዮ</char> ዋቅን እስራኤል ኬኔ ሰነ ስሪት ቤኩዸ። ሰበቢ ሀርክ <char style="nd">ዋቀዮ</char> ዋቀሳ እሰረ ቱሬፍ ሞትች ዋን እን ከዸቴ ሁንደ ንኬኔፍ። <verse eid="EZR 7:6"/><verse number="7" style="v" sid="EZR 7:7"/>አከሱመስ ወጋ ቶርበፋ በረ አርጤክስስ ሞትቻ ኬሰ እስራኤሎን ቶኮ ቶኮ ጄቹንስ ሉቦትን፣ ሌዎትን፣ ፋርፈቶትን፣ ኤግዶን ከራፊ ተጃጅልቶትን መነ ቁልቁሉማ ገረ ዬሩሳሌምት ኦል በአን።<verse eid="EZR 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="EZR 7:8"/>እዝራንስ ወጋ ቶርበፋ በረ ሞቲ ሰና ኬሰ ጅአ ሸነፋት ዬሩሳሌም ገኤ። <verse eid="EZR 7:8"/><verse number="9" style="v" sid="EZR 7:9"/>እንስ ቡልቲ ቶኮፋ ጅአ ጀልቀባት ከራሳ ባብሎኒ ጀልቀቤ ቡልቲ ቶኮፋ ጅአ ሸነፋት ዬሩሳሌም ገኤ፤ ሀርክ ዋቀሳ ቶላን ሱን እሰረ ቱሬቲ። <verse eid="EZR 7:9"/><verse number="10" style="v" sid="EZR 7:10"/>እዝራን ሴረ <char style="nd">ዋቀዮ</char> ቁአቹፊ ኤጉዻፍ አከሱመስ ለብሲፊ አጀጀ ሴርቻ እስራኤል ኬሰት በርሲሱዻፍ ኦፍ ኬኔ ቱሬቲ።<verse eid="EZR 7:10"/></para>
  <para style="s1">ጠለያ አርጤክስስ ሞትች እዝራት ኤርጌ</para>
  <para style="p">
    <verse number="11" style="v" sid="EZR 7:11"/>ኩን ገረ ገልቸ ጠለያ አርጤክስስ ሞትች እዝራ ሉብቻፊ በርሲሳ፣ ነምቸ ዋኤ አጀጃፊ ለብሲወን <char style="nd">ዋቀዮ</char> እስራኤሊፍ ኬኔ ሰና በረቴት ኤርጌት፦<verse eid="EZR 7:11"/></para>
  <para style="pmo">
    <verse number="12" style="v" sid="EZR 7:12"/>አርጤክስስ ሞቲ ሞቶታራ፤</para>
  <para style="pmo" vid="EZR 7:12">ገረ እዝራ ሉብቸ፣ በርሲሳ ሴረ ዋቀ ሰሚት፦</para>
  <para style="pmo" vid="EZR 7:12">ነጋን ሲፍ ሃተኡ።<verse eid="EZR 7:12"/></para>
  <para style="pm">
    <verse number="13" style="v" sid="EZR 7:13"/>አን አመ አከ ነምን እስራኤል ከን ሞቱማኮ ኬሰ ጅራቱ ከምዩ ሉቦትኒፊ ሌዎትንሌ አባን ስ ወጅን ዬሩሳሌም ዸቁ በርባዱ ዸቁ ደንደኡ ለብሴረ። <verse eid="EZR 7:13"/><verse number="14" style="v" sid="EZR 7:14"/>አት አከ አኩመ ሴረ ዋቀኬቲ ከን ሀርከኬ ጅሩ ሰናት ዋኤ ይሁዳፊ ዬሩሳሌም ቆረቱፍ ሞትቻፊ ጎርስቶተሳ ቶርባን ኤርገምቴርተ። <verse eid="EZR 7:14"/><verse number="15" style="v" sid="EZR 7:15"/>ከነረትስ ሜቲፊ ወርቄ ሞትቺፊ ጎርስቶትንሳ ዋቀ እስራኤል ከን ዬሩሳሌም ኬሰ ጅራቱፍ ቶሉመ ኬነን ሰነ ፉዺ ዴም፤ <verse eid="EZR 7:15"/><verse number="16" style="v" sid="EZR 7:16"/>ዋን ከነስ ሜቲፊ ወርቄ ኩታ ብየ ባብሎኒቲ ወልት ቀብዴ ሁንዳፊ ኬና ሰብኒፊ ሉቦትን መነ ቁልቁሉማ ዋቀሳኒ ከን ዬሩሳሌም ኬሳፍ ፌዺዻን ኬነን ወጅን ፉዺ ዸቅ። <verse eid="EZR 7:16"/><verse number="17" style="v" sid="EZR 7:17"/>ማለቀ ከናንስ ጅቦተ፣ ኮርቤዪ ሆላፊ ጦባላ ሆላ፣ ኬና ምዻኒፊ ዽባዩሳኒ ወጅን ብታቲ እዶ ኣርሳ መነ ቁልቁሉማ ዋቀኬሰኒ ከን ዬሩሳሌም ሰነረት ዽኤሳ።<verse eid="EZR 7:17"/></para>
  <para style="pm">
    <verse number="18" style="v" sid="EZR 7:18"/>ኤርገሲ አቲፊ ኦቦሎትንኬ ይሁዶትን ሜቲፊ ወርቄ ሀፌ አኩመ ፌዺ ዋቀኬሰኒት ዋኑመ ጋሪ እስንት ፈካቴረ ኦልቻ። <verse eid="EZR 7:18"/><verse number="19" style="v" sid="EZR 7:19"/>ምአ ዋቄፈትና መነ ቁልቁሉማ ዋቀኬቲ ኬሳፍ እማና ስት ኬነሜ ሁንደ ዋቀ ዬሩሳሌም ዱረት ዽኤስ። <verse eid="EZR 7:19"/><verse number="20" style="v" sid="EZR 7:20"/>ዋን መነ ቁልቁሉማ ዋቀኬቲፍ በርባደሙ ከን ኬኑ ፌቱ ሁንደ መንኩሰ ሞቲ ኬሳ ፉዺ ኬን።<verse eid="EZR 7:20"/></para>
  <para style="pm">
    <verse number="21" style="v" sid="EZR 7:21"/>ኤጋ አን አርጤክስስ ሞትች አከ ቀብዶትን ማለቃ ከኔን ገመ ለገ ኤፍራጢስ ጅረን ዋን እዝራን ሉብች፣ በርሲሳን ሴረ ዋቀ ሰሚ ኩን እስን ጋፈቱ ሁንደ አርጁማዻን እሳፍ ኬነን አጀጄረ፤ <verse eid="EZR 7:21"/><verse number="22" style="v" sid="EZR 7:22"/>ኩንስ ሀመ ሜቲ ታላንቲ ዽበ ቶኮ፣ ቀመዲ ቆሮሲ<note caller="+" style="f"><char style="fr" closed="false">7፥22 </char><char style="ft" closed="false">ቆሮሲን ቶኮ ሊትሪ 220።</char></note> ዽበ ቶኮ፣ ዳዺ ወይኒ ባዶሲ<note caller="+" style="f"><char style="fr" closed="false">7፥22 </char><char style="ft" closed="false">ባዶሲን ቶኮ ሊትሪ 22።</char></note> ዽበ ቶኮ፣ ዘይቲ ኤጄርሳ ባዶሲ ዽበ ቶኮፊ ሶግደ ሀመ ህንቀብኔ ሃተኡ። <verse eid="EZR 7:22"/><verse number="23" style="v" sid="EZR 7:23"/>ወን ዋቅን ሰሚ አጀጄ ከምዩ መነ ቁልቁሉማ ዋቀ ሰሚቲፍ ኦፍ ኤገናዻን ሃጎዸሙ። ማሊፍ ዼከምስ ሞትቻፊ እልማን ሞትቻት ዹፈ? <verse eid="EZR 7:23"/><verse number="24" style="v" sid="EZR 7:24"/>አመሌ እስን አከ ሉቦተ፣ ሌዎተ፣ ፋርፈቶተ፣ ኤግዶተ ከራ፣ ተጃጅልቶተ መነ ቁልቁሉማ ዮካን ሆጄቶተ መነ ዋቃ ከነ ኬሰ ሆጄተን ከምትዩ ግብረ፣ ቀረጣፊ አሹራ ሙርቴሱፍ ኣንጎ ህንቀብኔ ቤካ።<verse eid="EZR 7:24"/></para>
  <para style="pm">
    <verse number="25" style="v" sid="EZR 7:25"/>ኤጋ እዝራ፣ አት አኩመ ኦጉማ ዋቀኬቲ ከን ሀርከኬ ጅሩ ሰናት አከ እሳን ወረ ገመ ለገ ኤፍራጢስ ጅራተን ቡልቸኒፍ አቦቲ ሴራፊ አቦቲ ሙርቲ ከኔን ሁንድሳኒ ሴረ ዋቀኬቲ ቤከን ሙድ። ነመ ሴረ ዋቃ ህንቤክኔ ከምዩስ በርሲስ። <verse eid="EZR 7:25"/><verse number="26" style="v" sid="EZR 7:26"/>ነምን ሴረ ዋቀኬቲቲፍ ዮካን ሴረ ሞትቻቲፍ ህንአጀጀምኔ ከምዩ ዹጉማን አጄቻዻን፣ ብየ ኬሳ አርአሙዻን፣ ቀቤኝሳራ ዻለሙዻን ዮካን ህዻዻን አደበሙ ቀበ።<verse eid="EZR 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="EZR 7:27"/>
    <char style="nd">ዋቀዮ</char> ዋቅን አቦቲኬኛ ከን አከ እን ከራ ከናን መነ <char style="nd">ዋቀዮ</char> ከን ዬሩሳሌም ኬሰ ጅሩፍ ኡልፍነ ኬኑፍ ገራ ሞትቻ ኬሰ ያደ ከነ ካኤ ሱን ሃገለቴፈሙ፤ <verse eid="EZR 7:27"/><verse number="28" style="v" sid="EZR 7:28"/>ዋቀ ፉለ ሞትቻ፣ ፉለ ጎርስቶተ ሞትቻፊ ፉለ ቆንዳልቶተ ሞትቻ ጭጭሞ ሁንዳ ዱረት ጋሩማ ኦፊሳ ነ አርግሲሴፍ ገለን ሃገኡ። ሰበቢ ሀርክ <char style="nd">ዋቀዮ</char> ዋቀኮ አነረ ቱሬፍ አን ጀጀባዼን አከ እሳን ነ ወጅን ዴመኒፍ እስራኤል ኬሳ ነሞተ ቤቤከሞ ወልት ነንቀበዼ።<verse eid="EZR 7:28"/></para>
  <chapter eid="EZR 7"/>
  <chapter number="8" style="c" sid="EZR 8"/>
  <para style="s1">መቃ አቦቲ ማቲ ከኔን እዝራ ወሊን ዴብአኒ</para>
  <para style="lh">
    <verse number="1" style="v" sid="EZR 8:1"/>ወር ኩኔን ሀንገፎተ ማቲፊ ወረ እሳን ወጅን ገልማአን ከኔን በረ ሞቱማ አርጤክስስ ሞትቻ ኬሰ ነ ወጅን ባብሎኒ ዹፈኒዸ፦<verse eid="EZR 8:1"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="2" style="v" sid="EZR 8:2"/>ሰኚ ፊኔሃስ ኬሳ</para>
  <para style="li2" vid="EZR 8:2">ጌርሾም፤</para>
  <para style="li1" vid="EZR 8:2">ሰኚ ኢታማር ኬሳ</para>
  <para style="li2" vid="EZR 8:2">ዳንኤል፤</para>
  <para style="li1" vid="EZR 8:2">ሰኚ ዳዊት ኬሳ</para>
  <para style="li2" vid="EZR 8:2">ሀጡሽ <verse eid="EZR 8:2"/><verse number="3" style="v" sid="EZR 8:3"/>ሰኚ ሼካንያ፤</para>
  <para style="li1" vid="EZR 8:3">ሰኚ ጳሮሽ ኬሳ ዘካርያስ፤</para>
  <para style="li2" vid="EZR 8:3">ወር እሰ ወጅን ገልሜፈመንስ ነሞተ 150 ቱረን፤<verse eid="EZR 8:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="EZR 8:4"/>ሰኚ ፈሀት ሞኣብ ኬሳ</para>
  <para style="li2" vid="EZR 8:4">ኤሊሆኤነይ እልመ ዘራያ፤ ወር እሰ ወጅን ቱረንስ ነሞተ 200 ቱረን፤<verse eid="EZR 8:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="EZR 8:5"/>ሰኚ ዛቱእ ኬሳ ሼካንያ እልመ የህዚኤል፤</para>
  <para style="li2" vid="EZR 8:5">ወር እሰ ወጅን ቱረንስ ነሞተ 300 ቱረን፤<verse eid="EZR 8:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="EZR 8:6"/>ሰኚ ኣዲን ኬሳ ኤቤድ እልመ ዮናታን፤</para>
  <para style="li2" vid="EZR 8:6">ወር እሰ ወጅን ቱረንስ ነሞተ 50 ቱረን፤<verse eid="EZR 8:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="EZR 8:7"/>ሰኚ ኤላም ኬሳ ዬሻያ እልመ አታልያ፤</para>
  <para style="li2" vid="EZR 8:7">ወር እሰ ወጅን ቱረንስ ነሞተ 70 ቱረን፤<verse eid="EZR 8:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="EZR 8:8"/>ሰኚ ሼፋጥያ ኬሰ ዜባድያ እልመ ሚካኤል፤</para>
  <para style="li2" vid="EZR 8:8">ወር እሰ ወጅን ቱረንስ ነሞተ 80 ቱረን፤<verse eid="EZR 8:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="EZR 8:9"/>ሰኚ ዮኣብ ኬሳ ኦባድያ እልመ ዬሂኤል፤</para>
  <para style="li2" vid="EZR 8:9">ወር እሰ ወጅን ቱረንስ ነሞተ 218 ቱረን፤<verse eid="EZR 8:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="EZR 8:10"/>ሰኚ ባኒ ኬሳ ሼሎሚት እልመ ዮስፍያ፤</para>
  <para style="li2" vid="EZR 8:10">ወር እሰ ወጅን ቱረንስ ነሞተ 160 ቱረን፤<verse eid="EZR 8:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="EZR 8:11"/>ሰኚ ቤበይ ኬሳ ዘካርያስ እልመ ቤበይ፤</para>
  <para style="li2" vid="EZR 8:11">ወር እሰ ወጅን ቱረንስ ነሞተ 28 ቱረን፤<verse eid="EZR 8:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="EZR 8:12"/>ሰኚ አዝጋድ ኬሳ ዮሃናን እልመ ሀቃጣን፤</para>
  <para style="li2" vid="EZR 8:12">ወር እሰ ወጅን ቱረንስ ነሞተ 110 ቱረን፤<verse eid="EZR 8:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="EZR 8:13"/>ሰኚ አዶኒቃም ኬሳ</para>
  <para style="li2" vid="EZR 8:13">ወረ ገረ ዹማ ከኔን መቃንሳኒ ኤሊጴሌጥ፣ ዬኢኤሊፊ ሼማእያ ጄዸሙዸ፤ ወር እሳን ወጅን ቱረንስ ነሞተ 60 ቱረን፤<verse eid="EZR 8:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="EZR 8:14"/>ሰኚ በጉዋይ ኬሳ</para>
  <para style="li2" vid="EZR 8:14">ኡታዪፊ ዘኩር፤ ወር እሳን ወጅን ቱረንስ ነሞተ 70 ቱረን።<verse eid="EZR 8:14"/></para>
  <para style="s1">ገረ ዬሩሳሌምት ዴብኡ</para>
  <para style="p">
    <verse number="15" style="v" sid="EZR 8:15"/>አንስ ለገ ገረ አሀዋት ያኡ ብረት ወልት እሳን ነንቀቤ፤ ኑስ ጉያ ሰዲ አች ቱሬ። አንስ ዬሮን ኡመታፊ ሉቦተ ቶአዼት ሌዎተ ቶኮሌ እሳን ኬሳ ነንዸቤ። <verse eid="EZR 8:15"/><verse number="16" style="v" sid="EZR 8:16"/>ከናፉ አን ኤሊኤዜር፣ አሪኤል፣ ሼማእያ፣ ኤልናታን፣ ያሪብ፣ ኤልናታን፣ ናታን፣ ዘካርያሲፊ ሜሹላም ወረ ሆገንቶተ ቱረኒፊ ዮያሪቢፊ ኤልናታን ወረ ሀዮተ ተአን ሰነ ነንዋምስሴ፤ <verse eid="EZR 8:16"/><verse number="17" style="v" sid="EZR 8:17"/>ኤርገሲስ ገረ እዶ ነምቸ ካሲፍያ ቡልቹት እሳን ነንኤርጌ። አንስ አከ እሳን ነሞተ መነ ዋቀኬኛ ኬሰ ተጃጅለን ኑፍ ፍደኒፍ ዋን እሳን እዶፊ ፍሮተሳ ከኔን መነ ቁልቁሉማ ካስፍያ ኬሰ ተጃጅለኒን ጄቹ ቀበን እሳንት ነንህሜ። <verse eid="EZR 8:17"/><verse number="18" style="v" sid="EZR 8:18"/>እሳንስ ሰበቢ ሀርክ ዋቃ ቶላን ሱን ኑረ ቱሬፍ ሰኚ መህሊ ኬሳ ሼሬብያ እልመ ሌዊ፣ እልመ እስራኤል፣ ነምቸ ሁበታ ቶኮ እልማንሳፊ ኦቦሎተሳ ወጅን ወሉመት ነመ 18 ኑፍ ፍደን፤ <verse eid="EZR 8:18"/><verse number="19" style="v" sid="EZR 8:19"/>አከሱመስ ሀሸብያፊ እልማን ሜራሪ ኬሳሞ ዬሻያ፣ ኦቦሎተሳቲፊ እልማን ኦቦሎተሳ ወሉመት ነመ 20 ኑፍ ፍደን። <verse eid="EZR 8:19"/><verse number="20" style="v" sid="EZR 8:20"/>አመሌ ተጃጅልቶተ መነ ቁልቁሉማ ከኔን ዳዊቲፊ ቆንዳልቶትንሳ አከ እሳን ሌዎተ ገርጋረኒፍ ረመደን ኬሳ ነመ 220 ኑፍ ፍደን። እሳን ኩኔን ሁንድ መቃ መቃዻን ንገልሜፈመን።<verse eid="EZR 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="EZR 8:21"/>አንስ አከ ኑ፣ እጆሌንኬኛፊ ቀቤኝኬኘ ሁንድ ከራ ነጋ ዴምኑፍ አከ ፉለ ዋቀኬኛ ዱረት ገድ ኦፍ ቀብኔ ከዸኑፍ አቹመ ለገ አሀዋ ብረት ሶመን ነንለብሴ። <verse eid="EZR 8:21"/><verse number="22" style="v" sid="EZR 8:22"/>አን ሰበቢ ኑ፣ “ሀርክ ዋቀኬኛ እን ቶላን ነመ እሰ አብደቱ ሁንደረ ጅረ፤ ወረ እሰ ዺሱ ሁንደረ ገሩ ዼከምስሳ ንቡአ” ጄኔ ሞትቸት ህምኔ ቱሬፍ አከ እሳን ከራኬኘረት ዲኖተ ኑራ ዾወኒፍ ሎልቶታፊ አቦቲ ፈርዳ ሞትቸ ከዸቹ ነንቃነኤ። <verse eid="EZR 8:22"/><verse number="23" style="v" sid="EZR 8:23"/>ከናፉ ኑ ሶምኔ ዋን ከነረት ዋቀ ከዸትኔ፤ እንስ ከዻኬኛፍ ዴቢ ኬኔ።<verse eid="EZR 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="EZR 8:24"/>አንስ ሉቦተ ሀንገፎተ ኬሳ ኩዸ ለመ ጄቹንስ ሼሬብያ፣ ሀሸብያፊ ኦቦሎተሳኒ ኬሳ ነመ ኩዸን ኮጳት ነንባሴ፤ <verse eid="EZR 8:24"/><verse number="25" style="v" sid="EZR 8:25"/>አንስ ኬና ሜቲ፣ ወርቄፊ ምኣ ከን ሞትች፣ ጎርስቶትንሳ፣ ቆንዳልቶትንሳፊ እስራኤሎን አች ቱረን ሁንድ መነ ዋቀኬኛቲፍ ኬነንራ መዳሌ እሳኒፍ ነንቆዴ። <verse eid="EZR 8:25"/><verse number="26" style="v" sid="EZR 8:26"/>አን ሜቲ ታላንቲ<note caller="+" style="f"><char style="fr" closed="false">8፥26 </char><char style="ft" closed="false">ታላንቲን ቶኮ ኪሎ ግራሚ 34።</char></note> 650፣ ምአ ሜቲ ከነ ታላንቲ 100 ኡልፋቱ፣ ወርቄ ታላንቲ 100፣ <verse eid="EZR 8:26"/><verse number="27" style="v" sid="EZR 8:27"/>ወጪቲ ወርቄ 20 ከን ዳሪኪ<note caller="+" style="f"><char style="fr" closed="false">8፥27 </char><char style="ft" closed="false">ዳሪኪን ቶኮ ግራሚ 8።</char></note> 1,000 ባሱፊ ምአ ናሲ ጩሉሉቃ አኩመ ወርቄ ገቲንሳ ጉዳ ተኤ ለመ መዳሌን ቆዴፍ።<verse eid="EZR 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="EZR 8:28"/>አንስ አከነን እሳኒን ጄዼ፤ “እስኒፊ ምእ ኩን <char style="nd">ዋቀዮፍ</char> ቁልቁሌፈምተኒርቱ። ሜቲፊ ወርቄን ኩን ኬና ፌዺዻን <char style="nd">ዋቀዮ</char> ዋቀ አቦቲኬሰኒቲፍ ኬነመኒዸ። <verse eid="EZR 8:28"/><verse number="29" style="v" sid="EZR 8:29"/>ሀመ ኩታሌ መነ <char style="nd">ዋቀዮ</char> ከን ዬሩሳሌም ኬሳ ሰነ ኬሰት ፉለ ሉቦተ ሀንገፎታ፣ ፉለ ሌዎታፊ ሀንገፎተ ማቲ እስራኤል ዱረት መዳልተኒ ቆደንት ምአ ከነ ጀቤሳ ኤጋ።” <verse eid="EZR 8:29"/><verse number="30" style="v" sid="EZR 8:30"/>ከናፉ ሉቦትኒፊ ሌዎትን ሜቲ፣ ወርቄፊ ምአ ቁልቁሉ መዳለሜ ሰነ መነ ዋቀኬኛ ከን ዬሩሳሌም ኬሳት ጌሱፍ ንፉዸን።<verse eid="EZR 8:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="EZR 8:31"/>ኑስ ቡልቲ ኩዸ ለመፋ ጅአ ቶኮፋት ዬሩሳሌም ዸቁዻፍ ለገ አሀዋ ብራ ካኔ። ሀርክ ዋቀኬኛ ኑረ ቱሬ፤ እንስ ዲኖታፊ ነሞተ ርጰኒ ከራረት ነመ ኤገተን ጀላ ኑ ባሴ። <verse eid="EZR 8:31"/><verse number="32" style="v" sid="EZR 8:32"/>አከሲንስ ዬሩሳሌም ጌኜ ቡልቲ ሰዲ አች ቦቆትኔ።<verse eid="EZR 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="EZR 8:33"/>ኑስ ቡልቲ አፉረፋት መነ ዋቀኬኛ ኬሰት ሜቲ፣ ወርቄፊ ምአ ቁልቁሉ ሰነ መዳሌ ሀርከ ሜሬሞት ሉብቸ እልመ ኡርያ ሰናት ንኬንኔ። ኤሌኣዛር እልም ፊኔሃስ አከሱመስ ሌዎትን ጄቹንስ ዮዛባድ እልም ዬሹኣፊ ኖአድያን እልም ብኑዪ እሰ ወጅን ቱረን። <verse eid="EZR 8:33"/><verse number="34" style="v" sid="EZR 8:34"/>ወን ሁንድኑስ ለካአሜ መዳለሜ፤ ኡልፍን ዋን መዳለሜ ሁንዳስ ዬሩመ ሰነ ንገልሜፈሜ።<verse eid="EZR 8:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="EZR 8:35"/>ኤርገሲስ ቦጅአምቶትን ቦጁዻ ዴብአን ሱን እስራኤል ሁንዳፍ ጅቦተ ኩዸ ለመ፣ ኮርቤዪ ሆላ ሰገልተሚ ጀኣፊ ጦባላ ቶርባተሚ ቶርበን ኣርሳ ጉበሙ፣ ኮርቤዪ ሬኤ ኩዸ ለመ ኣርሳ ጩቡ ጎዸኒ ዋቀ እስራኤሊፍ ዽኤሰን፤ ኩን ሁንድ ኣርሳ ጉበሙ ከን <char style="nd">ዋቀዮፍ</char> ዽኤፈሜዸ። <verse eid="EZR 8:35"/><verse number="36" style="v" sid="EZR 8:36"/>እሳን አጀጀ ሞትቻሌ አጀጆተ ሞቱማፊ ቡልችቶተ ገመ ለገ ኤፍራጢስት ደበርሰን። ጀርስ ሰባፊ መነ ዋቃ ገርጋረን።<verse eid="EZR 8:36"/></para>
  <chapter eid="EZR 8"/>
  <chapter number="9" style="c" sid="EZR 9"/>
  <para style="s1">ዋኤ ፉዻፊ ሄሩመ ወልመካ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 9:1"/>ኤርገ ወን ኩን ሆጄተሜ ቦዴ ሆገንቶትን ገረኮ ዹፈኒ አከነ ጄዸን፤ “ሰብን እስራኤል ሉቦታፊ ሌዎተሌ ደበለቴ ሰቦተ ኦላሳኒ ከኔን ሆጂ ጅብሲሳ ሆጄተን ጄቹንስ ከነኣኖተ፣ ሄቶተ፣ ፌርዞተ፣ ዬቡሶተ፣ አሞኖተ፣ ሞኣቦተ፣ ወረ ግብጢፊ አሞሮተራ አዳን በአኒ ህንጅራትኔ። <verse eid="EZR 9:1"/><verse number="2" style="v" sid="EZR 9:2"/>እሳንስ እንተለን ጀራ ኦፊሳኒቲፍ ፉዸኒ እልማንሳኒስ ፉስሰኒ ሰኚ ቁልቁሉ ሰነ ሰቦተ ናኖሳኒት መከን። ሆገንቶትኒፊ ቆንዳልቶትንስ በሌሳ ከነ ሆጄቹ ኬሰት ዱረ ኣንቶተ ቱረን።”<verse eid="EZR 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="EZR 9:3"/>አን ዬሮን ዋን ከነ ዸገኤት ቆሜኮፊ ኡፈተኮ ነንተርሳሴ፣ ርፌንሰ መታኮፊ አሬደኮ ኦፍራ ቡቅሴ አከ መሌ ርፈዼን ታኤ። <verse eid="EZR 9:3"/><verse number="4" style="v" sid="EZR 9:4"/>ከነረት ነሞትን ዱቢ ዋቀ እስራኤሊን ሆለተን ሁንድ ሰበቢ በሌሳ ወረ ቦጁዻ ዴብአን ከናፍ ናኖኮት ወልት ቀበመን። አንስ አከ መሌ ርፈዼ ሀመ ኣርሳ ገልገላት አቹመን ታኤ።<verse eid="EZR 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 9:5"/>አንስ ዬሮ ኣርሳ ገልገላት አኩመ ቆሜፊ ኡፈትንኮ ተርሰኤ ጅሩት ለፈን ገዴ ታኣ ቱሬ ከኤ ጅልቤንፈዼ ሀርከኮ ገረ <char style="nd">ዋቀዮ</char> ዋቀኮት በልእሴ <verse eid="EZR 9:5"/><verse number="6" style="v" sid="EZR 9:6"/>አከነ ጄዼን ከዸዼ፦</para>
  <para style="pm" vid="EZR 9:6">“ያ ዋቀኮ፣ ሰበቢ ጩቡንኬኘ መታኬኘ ብረ ኦል ደርቤ የክኬኘስ ሰሚ ገኤፍ፣ ያ ዋቀኮ አን ፉለኮ ገረኬት ዴብፈቹ አከ መሌ ቃነኤረ፤ ሳልፈዼረስ። <verse eid="EZR 9:6"/><verse number="7" style="v" sid="EZR 9:7"/>በረ አቦቲኬኛቲ ጀልቀቤ ሀመ አማት በሌሳንኬኘ ጉዳዸ። ሰበቢ ጩቡኬኛፍ ኑ፣ ሞቶትንኬኛፊ ሉቦትንኬኘ አኩመ ሀርኣ ከነ ሀርከ ሞቶተ ኦርማ ጀለት ጎራዴፊ ቦጁት፣ ሳምቻፊ ሰልጵነት ደበርፈምኔ ኬነምኔረ።<verse eid="EZR 9:7"/></para>
  <para style="pm">
    <verse number="8" style="v" sid="EZR 9:8"/>“አመ ገሩ <char style="nd">ዋቀዮ</char> ዋቅንኬኘ ሀምባ ኑ ሀምብሴ እዶሳ ቁልቁሉ ሰነ ኬሰት እዶ አመንሲሳ ኑፍ ኬኑዻን ዬሮ ገባባዻፍ ገራ ኑፍ ላፌረ፤ አከሲንስ ዋቅንኬኘ እጀኬኛፍ እፈ ኬኔረ፤ ገርቡማኬኘ ኬሰትስ ጥኖ ኑ ቦቆቺሴረ። <verse eid="EZR 9:8"/><verse number="9" style="v" sid="EZR 9:9"/>ኑ ገርቦተ ታኑሌ ዋቅንኬኘ ገርቡማ ኬሰት ኑ ህንገትኔ። እን ፉለ ሞቶተ ፋሬስ ዱረት ጃለለሳ ከን ህንጌደረምኔ ሰነ ኑ አርግሲሴረ። እን አከ ኑ መነ ዋቀኬኛ ዴብፍኔ እጃሩፊ አከ ዲገማሳሌ እዶት ዴብፍኑፍ ጅሬኘ ሃራ ኑፍ ኬኔረ፤ ይሁዳፊ ዬሩሳሌም ኬሰትስ ደላ ደአትኖ ኑ ኬኔረ።<verse eid="EZR 9:9"/></para>
  <para style="pm">
    <verse number="10" style="v" sid="EZR 9:10"/>“አመ ገሩ ያ ዋቀኬኘ ኑ ከነ ቦዴ ማል ጄቹ ደንዴኘ? ኑ አጀጀ <verse eid="EZR 9:10"/><verse number="11" style="v" sid="EZR 9:11"/>አት ከራ ገርቦተኬ ራጆታን ኬንቴ ሰናፍ ህንአጀጀምኔቲ፤ እንስ አከነ ጄዸ፦ ‘ብይ እስን ዻሉዻፍ ሴኑት ጅርተን ጡራኡማ ሰበ ብየ ሰናን ጡሮፍቴርት። እሳን ሆጂ ጅብሲሳሳኒቲን ሀንዳረ ቶኮ ሀመ ሀንዳረ ካንት ጡራኡማሳኒቲን ብየቲ ጉተኒሩ። <verse eid="EZR 9:11"/><verse number="12" style="v" sid="EZR 9:12"/>ከናፉ እንተለንኬሰን እልማን እሳንት ህንሄሩምሲስና ዮካን እልማንኬሰን እንተለንሳኒ ህንፉስስና። አከ ጀባተኒፍ፣ አከ ዋን ጋሪ ብየ ሰና ኛተኒ ብየትሌ ዻለ በረ በራ ጎተኒ እጆሌኬሰንት ደበርስተኒፍ ዮምዩ እሳን ወጅን ወሊ ገልቴ ምቹማ ህንበርባድና።’<verse eid="EZR 9:12"/></para>
  <para style="pm">
    <verse number="13" style="v" sid="EZR 9:13"/>“ወን ኑረ ገኤ ኩን ገቲ ጎቸወን ሀምነኬኛፊ የከኬኘ ጉዳ ሰናት፤ ሃተኡቲ አት ዋቅንኬኘ አደበ ጩቡኬኛፍ መሉን ገድ ኑ አደብዴ ሀምባ አከና ኑ ኬንቴርተ። <verse eid="EZR 9:13"/><verse number="14" style="v" sid="EZR 9:14"/>ኑ አመሌ አጀጀኬ ጨብስኔ ሰበ ሆጂወን ጅብሲሶ ሆጄቱ ከናን ወል ሃፉኑ? ዮስ አት አከ መሌ ኑት ዼከምቴ ሀመ ሀምባን ቶኮዩ ህንሀፍኔት ኑ ህንበሌስቱሬ? <verse eid="EZR 9:14"/><verse number="15" style="v" sid="EZR 9:15"/>ያ <char style="nd">ዋቀዮ</char> ዋቀ እስራኤል፣ አት ቀጄላዸ! ኑ ሀርአ ሀምባ ታኔ ጅራኔረ። ቶኮንኬኘዩ ሰበቢ የከኬኛፍ ፉለኬ ዱረ ዻበቹ ደዸብኑሌ ኑ ኩኖ የኩመኬኘ ወጅን ፉለኬ ዱረ ጅረ።”<verse eid="EZR 9:15"/></para>
  <chapter eid="EZR 9"/>
  <chapter number="10" style="c" sid="EZR 10"/>
  <para style="s1">ኡመትን ጩቡሳ ህመቴ</para>
  <para style="p">
    <verse number="1" style="v" sid="EZR 10:1"/>ኡቱመ እዝራን መነ ዋቃ ዱረት ለፋን ኦፍ ዸኤ ቦኣ፣ ጩቡ ህመቻ፣ ከዸቻ ጅሩ እስራኤሎን አከ መሌ ሄዱን ዺሮትን፣ ዱበርቶትኒፊ እጆሌን ናኖሳት ወልት ንቀበመን። እሳንስ ህቅፈተኒ ቦአን። <verse eid="EZR 10:1"/><verse number="2" style="v" sid="EZR 10:2"/>ኤርገሲስ ሰኚ ኤላም ኬሳ ሼካንያን እልም ዬሂኤል እዝራዻን አከነ ጄዼ፤ “ኑ ዋን ሰቦተ ናኖኬኘ ጅራተን ኬሳ ዱበርቶተ ኦርማ ፉኔፍ ዋቀኬኛፍ ህንአመነምኔ። ወን ኩን ተኡሌ አመዩ እስራኤሊፍ አብዲን ጅረ። <verse eid="EZR 10:2"/><verse number="3" style="v" sid="EZR 10:3"/>ከናፉ ኮታ አኩመ ጎርሰ ጎፍታኮፊ ከን ወረ አጀጀ ዋቀኬኛ ሶዳተንት ዱበርቶተ ከኔኒፊ እጆሌሳኒ ሁንደ ኦፍራ ጌጌሱፍ ፉለ ዋቀኬኛ ዱረት ከኩ ንገለ። ኩንስ አኩመ ሴራት ሃራወተሙ። <verse eid="EZR 10:3"/><verse number="4" style="v" sid="EZR 10:4"/>ከእ፤ ወን ኩን ሱመ ሀርከ ጅረ። ኑ ስ ዴገረ፤ ኤጋ ጀባዹ ሆጄዹ።”<verse eid="EZR 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="EZR 10:5"/>ከናፉ እዝራን ከኤ አከ እሳን ዋን ጄዸሜ ሰነ ራወተኒፍ ሉቦተ ሀንገፎተ፣ ሌዎታፊ እስራኤል ሁንደ ንከከቺሴ፤ እሳንስ ንከከተን። <verse eid="EZR 10:5"/><verse number="6" style="v" sid="EZR 10:6"/>ኤርገሲ እዝራን ፉለ መነ ዋቃ ዱራ ከኤ ኩታ መና ከን ዬሆሃናን እልመ ኤልያሺብ ሴኔ። እን ዬሮ አች ቱሬት ኛተ ቶኮሌ ህንኛትኔ፤ ብሻንስ ህንዹግኔ፤ ሰበቢ አመነሙማ ዸቢሰ ወረ ቦጁዻ ዴብአኒፍ ገዳ ቱሬቲ።<verse eid="EZR 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="EZR 10:7"/>ኤርገሲ አከ ወር ቦጁዻ ዴብአን ሁንድ ዬሩሳሌም ኬሰት ወልት ቀበመኒፍ ይሁዳፊ ዬሩሳሌም ጉቱ ኬሰት ለብሲን ንለብሰሜ። <verse eid="EZR 10:7"/><verse number="8" style="v" sid="EZR 10:8"/>ነምን ከምዩ ቡልቲ ሰዲ ኬሰት ዮ ዽኣቹ ባቴ አኩመ ሙርቲ ቆንዳልቶታፊ ማንጉዶታት ቀቤኝሳ ሁንድ እራ ንፉዸተመ፤ እን መታንሳስ ወልዳ ወረ ቦጁዻ ዴብኤ ኬሳ ንአርአመ።<verse eid="EZR 10:8"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="9" style="v" sid="EZR 10:9"/>ቡልቲ ሰደን ሰነ ኬሰት ነሞትን ይሁዳፊ ቤንያም ሁንድ ዬሩሳሌም ኬሰት ወልት ቀበመን። ቡልቲ ድግደመፋ ጅአ ሰግለፋት ነሞትን ሁንድ ሰበቢ ዋን ከናፊ ሰበቢ ሮበ ጉዳቲፍ አከ መሌ ራፈመኒ ኦብዲ መነ ዋቃ ዱረ ጅሩረ ንተታአን። <verse eid="EZR 10:9"/><verse number="10" style="v" sid="EZR 10:10"/>እዝራን ሉብች ኦል ከኤ አከነ እሳኒን ጄዼ፤ “እስን አመነሞ ህንቱሬ፤ ዱበርቶተ ኦርማ ፉዹዻንስ እስራኤልረት የከ ደበልተኒርቱ። <verse eid="EZR 10:10"/><verse number="11" style="v" sid="EZR 10:11"/>ኤጋ አመ ጩቡኬሰን <char style="nd">ዋቀዮ</char> ዋቀ አቦቲኬሰንት ህመዻቲ ፌዺሳ ጉታ። ሰቦተ ናኖኬሰን ጅራተኒፊ ኒቶተ ወረ ኦርማ ኬሳ ፉተኒን ገርገር በኣ።”<verse eid="EZR 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="EZR 10:12"/>ጉቱማን ወልዳ ሰና አከነ ጄዼ ሰገሌ ጉዳዻን ዴብሴ፦ “አት ስሪዸ! ኑ አኩመ አት ጄቴ ጎቹ ቀብነ። <verse eid="EZR 10:12"/><verse number="13" style="v" sid="EZR 10:13"/>ገሩ ነመ ሄዱቱ አስ ጅረ፤ ዬሮን ኩንስ ዬሮ ሮባት፤ ከናፉ ኑ አለ ዻበቹ ህንደንዴኙ። ሰበቢ ኑ ዋን ከነ ኬሰት ጩቡ ጉዳ ሆጄትኔፍ ወን ኩን ጉያ ቶኮት ዮካን ጉያ ለመት ፈለ አርገቹ ህንደንደኡ። <verse eid="EZR 10:13"/><verse number="14" style="v" sid="EZR 10:14"/>ቆንዳልቶትንኬኘ እዶ ወልዳ ጉቱ ሃቡአን። ኤርገሲ ነምን መጋላወንኬኛ ከን ዱበርቲ ኦርማ ፉዼ ከምዩ ሀመ ዼከምስ ዋቀኬኛ ሶዳችሳን ሰበቢ ዋን ከናቲፍ ዹፌ ሱን ኑራ ዴብኡት ማንጉዶታፊ አቦቲ ሙርቲ ቶኮ ቶኮ መጋላ ወጅን ዬሮ ሙርቴፈሜት ሃዹፉ።” <verse eid="EZR 10:14"/><verse number="15" style="v" sid="EZR 10:15"/>ዮናታን እልመ አሳሄሊፊ የህዜያ እልመ ትቅዋ ቆፈቱ ዋን ከነ ሞርሜ፤ ሜሹላሚፊ ሻቤታይ ሌውችሞ እሳን ዴገረን።<verse eid="EZR 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="EZR 10:16"/>ወር ቦጁዻ ዴብአን ሱንስ አከሱመ ጎዸን። እዝራን ሉብችስ ነሞተ ሀንገፎተ ማቲ ተአን ቶኮ ቶኮ ገሬ ማቲ ኬሳ ነመ ቶኮ ፍለቴ ሁንዱመሳኒ መቃ መቃን ረመዴ። እሳንስ ቡልቲ ቶኮፋ ጅአ ኩርነፋት ዽመ ሰነ ቆረቹዻፍ ተታአኒ <verse eid="EZR 10:16"/><verse number="17" style="v" sid="EZR 10:17"/>ጉያ ቶኮፋ ጅአ ጀልቀባት ዋኤ ነሞተ ዱበርቶተ ኦርማ ፉዸን ሁንዳ ቆረተኒ ፍጠን።<verse eid="EZR 10:17"/></para>
  <para style="s1">ነሞተ ዱበርቶተ ኦርማ ፉዸን</para>
  <para style="lh">
    <verse number="18" style="v" sid="EZR 10:18"/>ሰኚ ሉቦታ ኬሳ ነሞትን ዱበርቶትን ኦርማ ፉዸን ከኔኒዸ፦</para>
  <para style="li1" vid="EZR 10:18">ሰኚ እያሱ እልመ ዮዛዳቂፊ ኦቦሎተሳ ኬሳ፦</para>
  <para style="li2" vid="EZR 10:18">መአሴያ፣ ኤሊኤዜር፣ ያሪቢፊ ጌዳልያስ። <verse eid="EZR 10:18"/><verse number="19" style="v" sid="EZR 10:19"/>እሳን ሁንድኑ ኒቶተሳኒ ሂኩዻፍ ዋዳ ንገለን፤ ቶኮን ቶኮንሳኒ በሌሳ ኦፊሳኒቲፍ ቡሻዬ ኬሳ ኮርቤሰ ሆላ ቶኮ ኣርሳ የካቲፍ ንዽኤሰን።<verse eid="EZR 10:19"/></para>
  <para style="li1">
    <verse number="20" style="v" sid="EZR 10:20"/>ሰኚ እሜር ኬሳ፦</para>
  <para style="li2" vid="EZR 10:20">ሀናኒፊ ዜባድያ።<verse eid="EZR 10:20"/></para>
  <para style="li1">
    <verse number="21" style="v" sid="EZR 10:21"/>ሰኚ ሃሪም ኬሳ፦</para>
  <para style="li2" vid="EZR 10:21">መአሴያ፣ ኤልያስ፣ ሼማእያ፣ ዬሂኤሊፊ ኡዝያ።<verse eid="EZR 10:21"/></para>
  <para style="li1">
    <verse number="22" style="v" sid="EZR 10:22"/>ሰኚ ጳሽሁር ኬሳ፦</para>
  <para style="li2" vid="EZR 10:22">ኤሊዮኤነይ፣ መአሴያ፣ እሽማኤል፣ ናትናኤል፣ ዮዛባዲፊ ኤሌኣሳ።<verse eid="EZR 10:22"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="23" style="v" sid="EZR 10:23"/>ሌዎተ ኬሳሞ፦</para>
  <para style="li2" vid="EZR 10:23">ዮዛባድ፣ ሽሜኢ፣ ቄላያ እሰ ቄሊጣ ጄዸሙ ሰነ፣ ጴታያ፣ ይሁዳፊ ኤሊኤዜር።<verse eid="EZR 10:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="EZR 10:24"/>ፋርፈቶተ ኬሳ፦</para>
  <para style="li2" vid="EZR 10:24">ኤልያሺብ።</para>
  <para style="li1" vid="EZR 10:24">ወረ ከረ ኤገን ኬሳ፦</para>
  <para style="li2" vid="EZR 10:24">ሸሉም፣ ቴሌሚፊ ኡር።<verse eid="EZR 10:24"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="25" style="v" sid="EZR 10:25"/>እስራኤሎተ ካን ኬሳ፦</para>
  <para style="li1" vid="EZR 10:25">ሰኚ ጳሮሽ ኬሳ፦</para>
  <para style="li2" vid="EZR 10:25">ራምያ፣ ዬዝያ፣ መልክያ፣ ምያሚን፣ ኤሌኣዛር፣ መልክያፊ ቤናያ።<verse eid="EZR 10:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="EZR 10:26"/>ሰኚ ኤላም ኬሳ፦</para>
  <para style="li2" vid="EZR 10:26">መታንያ፣ ዘካርያስ፣ ዬሂኤል፣ አብዲ፣ ይሬሞቲፊ ኤልያስ።<verse eid="EZR 10:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="EZR 10:27"/>ሰኚ ዛቱ ኬሳ፦</para>
  <para style="li2" vid="EZR 10:27">ኤሊዮኤነይ፣ ኤልያሺብ፣ መታንያ፣ ይሬሞት፣ ዛባዲፊ አዚዛ።<verse eid="EZR 10:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="EZR 10:28"/>ሰኚ ቤበይ ኬሳ፦</para>
  <para style="li2" vid="EZR 10:28">ዬሆሃናን፣ ሀናንያ፣ ዛበዪፊ ኣትላይ።<verse eid="EZR 10:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="EZR 10:29"/>ሰኚ ባኒ ኬሳ፦</para>
  <para style="li2" vid="EZR 10:29">ሜሹላም፣ መሉክ፣ አዳያ፣ ያሱብ፣ ሼኣሊፊ ራሞት።<verse eid="EZR 10:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="EZR 10:30"/>ሰኚ ፈሀት ሞኣብ ኬሳ፦</para>
  <para style="li2" vid="EZR 10:30">አድና፣ ኬላል፣ ቤናያ፣ መአሴያ፣ መታንያ፣ ቤዘልኤል፣ ብኑዪፊ ምናሴ።<verse eid="EZR 10:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="EZR 10:31"/>ሰኚ ሃሪም ኬሳ፦</para>
  <para style="li2" vid="EZR 10:31">ኤሊኤዜር፣ ይሽያ፣ መልክያ፣ ሼማእያ፣ ስምኦን፣ <verse eid="EZR 10:31"/><verse number="32" style="v" sid="EZR 10:32"/>ቤንያም፣ መሉኪፊ ሼማርያ።<verse eid="EZR 10:32"/></para>
  <para style="li1">
    <verse number="33" style="v" sid="EZR 10:33"/>ሰኚ ሃሹም ኬሳ፦</para>
  <para style="li2" vid="EZR 10:33">መቴናይ፣ መተታ፣ ዛባዲ፣ ኤሊጴሌጥ፣ ዬሬማይ፣ ምናሴፊ ሽሜኢ።<verse eid="EZR 10:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="EZR 10:34"/>ሰኚ ባኒ ኬሳ፦</para>
  <para style="li2" vid="EZR 10:34">መአዳይ፣ አምራም፣ ኡኤል፣ <verse eid="EZR 10:34"/><verse number="35" style="v" sid="EZR 10:35"/>ቤናያ፣ ቤድያ፣ ኬሉሂ፣ <verse eid="EZR 10:35"/><verse number="36" style="v" sid="EZR 10:36"/>ዋኔያ፣ ሜሬሞት፣ ኤልያሺብ፣ <verse eid="EZR 10:36"/><verse number="37" style="v" sid="EZR 10:37"/>መታንያ፣ መቴናዪፊ የአሳዉ፣<verse eid="EZR 10:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="EZR 10:38"/>ባኒ፣ ብኑዪ፣</para>
  <para style="li2" vid="EZR 10:38">ሽሜኢ፣ <verse eid="EZR 10:38"/><verse number="39" style="v" sid="EZR 10:39"/>ሼሌምያ፣ ናታን፣ አዳያ፣ <verse eid="EZR 10:39"/><verse number="40" style="v" sid="EZR 10:40"/>መክናዴባይ፣ ሻሻይ፣ ሻራይ፣ <verse eid="EZR 10:40"/><verse number="41" style="v" sid="EZR 10:41"/>አዘርኤል፣ ሼሌምያ፣ ሼማርያ፣ <verse eid="EZR 10:41"/><verse number="42" style="v" sid="EZR 10:42"/>ሸሉም፣ አመርያፊ ዮሴፍ።<verse eid="EZR 10:42"/></para>
  <para style="li1">
    <verse number="43" style="v" sid="EZR 10:43"/>ሰኚ ኔቦ ኬሳ፦</para>
  <para style="li2" vid="EZR 10:43">ዬኢኤል፣ መቲትያ፣ ዛባዲ፣ ዜቢና፣ ያዳይ፣ ዮኤሊፊ ቤናያ።<verse eid="EZR 10:43"/></para>
  <para style="b"/>
  <para style="lf">
    <verse number="44" style="v" sid="EZR 10:44"/>ወር ኩኔን ሁንድኑ ዱበርቶተ ኦርማ ንፉዸን፤ እሳን ኬሳስ ቶኮ ቶኮ ኒቶተ ከኔንራ እጆሌ ንዸልቸን።<verse eid="EZR 10:44"/></para>
  <chapter eid="EZR 10"/>
</usx>
