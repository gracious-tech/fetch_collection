<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2SA" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">2 ሳሙኤል</para>
  <para style="toc1">ክታበ ሳሙኤል ለመፋ</para>
  <para style="toc2">2 ሳሙኤል</para>
  <para style="toc3">2ሳሙ</para>
  <para style="mt2">ክታበ</para>
  <para style="mt1">ሳሙኤል</para>
  <para style="mt3">ለመፋ</para>
  <chapter number="1" style="c" sid="2SA 1"/>
  <para style="s1">ዳዊት አከ ሳኦል ዱኤ ዸገኤ</para>
  <para style="r">
    <ref loc="2SA 1:4-12">1፥4‑12</ref> ኩወፈ – <char style="xt"><ref loc="1SA 31:1-13">1ሳሙ 31፥1‑13</ref>፤ <ref loc="1CH 10:1-12">1ሴና 10፥1‑12</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 1:1"/>ሳኦል ኤርገ ዱኤ ቦዴ፣ ዳዊት አማሌቆተ ሩኩቱራ ዴብኤ ሲቅላግ ኬሰ ጉያ ለመ ቱሬ። <verse eid="2SA 1:1"/><verse number="2" style="v" sid="2SA 1:2"/>ጉያ ሰደፋት ነምች ቶኮ ቁበተ ሳኦሊ ዹፌ፤ እንስ ወያሳ ተርሳሴ መታሳት አዋረ ፍርፍርፈቴ ቱሬ። ዮሙ ዳዊት ብረ ገኤትስ ኡልፍነ እሳፍ ኬኑፍ ጄዼ አዳን ለፈት ጎምብፈሜ።<verse eid="2SA 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 1:3"/>ዳዊትስ፣ “አት ኤሳ ዹፍቴ?” ጄዼ እሰ ጋፈቴ።</para>
  <para style="p" vid="2SA 1:3">ነምችሞ፣ “አን ቁበተ እስራኤሎታ ኬሳን በቀዼ ዹፌ” ጄዼ።<verse eid="2SA 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 1:4"/>ዳዊትስ፣ “ማልቱ ዸለቴ? ሜ ነት ህም” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="2SA 1:4">እንስ፣ “ነሞትን አደ ወራናቲ ንበቀተን። ባይኤንሳኒ ሀርጨአኒሩ፤ ዱአኒሩስ። ሳኦሊፊ እልምሳ ዮናታንስ ዱአኒሩ” ጄዼን።<verse eid="2SA 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 1:5"/>ከነረት ዳዊት ደርገጌሰ ኦዱ ከነ ፍዴን፣ “አከ ሳኦሊፊ እልምሳ ዮናታን ዱአን አት አከምት ቤክቴ?” ጄዼ።<verse eid="2SA 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 1:6"/>ደርገጌስ ሱንስ አከነ ጄዼ ዴብሴ፤ “አኩመ ተሳ አን ቱሉ ግልቦኣት ኦል በኤን ቱሬ፤ ሳኦልስ ኤቦሳት እርከቴ አች ቱሬ፤ ጋሪወን ሎላቲፊ አቦቲን ፈርዳ እሰ ብረ ገአን። <verse eid="2SA 1:6"/><verse number="7" style="v" sid="2SA 1:7"/>እንስ ዮሙ ገረገሌ ነ አርጌት ነ ዋሜ፤ አንስ፣ ‘ማል ሲፍ አጀጀሙ?’ ጄዼ እሰ ጋፈዼ።<verse eid="2SA 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 1:8"/>“እንስ፣ ‘አት ኤኙ?’ ጄዼ ነ ጋፈቴ።</para>
  <para style="p" vid="2SA 1:8">“አንሞ፣ ‘አን ነመ አማሌቅ’ ጄዼን ዴብሴ።<verse eid="2SA 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 1:9"/>“ኤርገሲስ እን፣ ‘ነረ ዻበዹ ነ አጄስ! ዋን ሉቡን ነ ኬሳ ህንበእኒፍ አን አከ መሌ ዽጰቻን ጅራቲ’ ናን ጄዼ።<verse eid="2SA 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 1:10"/>“ከናፉ አን ሰበቢን አከ እን ኤርገ ኩፌ ህንፈይኔ ቤኬፍ እሰረ ዻበዼን እሰ አጄሴ። ጎንፎ መታሳቲፊ ብተዎ ሀርከሳ ፉዼ ጎፍታኮቲፍ ፍዴረ።”<verse eid="2SA 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 1:11"/>ዳዊቲፊ ነሞትን እሰ ወጅን ቱረን ሁንድ ወያ ኦፍራ ባሰኒ ተተርሳሰን። <verse eid="2SA 1:11"/><verse number="12" style="v" sid="2SA 1:12"/>እሳንስ ሳኦሊፊ ዮናታኒፍ፣ ሎልቶተ <char style="nd">ዋቀዮቲፊ</char> መነ እስራኤል ሁንዳፍ ገደኒ ንቦአን፤ ሀመ ገልገላት ንሶመን፤ እሳን ጎራዴዻን ዹመኒሩቲ።<verse eid="2SA 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 1:13"/>ዳዊትስ፣ “አት ኤሳ ዹፍቴ?” ጄዼ ደርገጌስቸ ኦዱ ፍዴ ሰነ ጋፈቴ።</para>
  <para style="p" vid="2SA 1:13">እንስ፣ “አን እልመ አማሌቅ፣ ነምቸ ገልቱ ተኤ ቶኮት” ጄዼ ዴብሴ።<verse eid="2SA 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 1:14"/>ዳዊትሞ፣ “ዮስ አት ድበማ <char style="nd">ዋቀዮ</char> ቶኮ ገላፈቹፍ ሀርከኬ ኦል ፉዸቹ ማሊፍ ህንሶዳትንሬ?” ጄዼ ጋፈቴ።<verse eid="2SA 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 1:15"/>ኤርገሲ ዳዊት ነሞተሳ ኬሳ ቶኮ ዋሜ፣ “ዸቂቲ ዸኢ እሰ አጄስ!” ጄዼ። እንስ እሰ ዸኤ፤ ነምችስ ንዱኤ። <verse eid="2SA 1:15"/><verse number="16" style="v" sid="2SA 1:16"/>ዳዊትስ፣ “ሰበቢ አፋኑምትኬ፣ ‘አን ነመ <char style="nd">ዋቀዮ</char> እሰ ድቤ አጄሴረ’ ጄዼ ዹጋ ስት በኤፍ ዺግንኬ መቱመኬት ዴብአ” ጄዼን።<verse eid="2SA 1:16"/></para>
  <para style="s1">ፋሩ ዳዊት ሳኦሊፊ ዮናታኒፍ ፋርሴ</para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 1:17"/>ዳዊት ፋሩ ከናን ሳኦሊፊ እልመ ሳኦል ዮናታኒፍ ቦኤ፤ <verse eid="2SA 1:17"/><verse number="18" style="v" sid="2SA 1:18"/>አከሱመስ ፋሩ እዳ ጄዸሙ ከነ አከ ነሞትን ይሁዳ በርሲፈመን አጀጄ፤ ኩንስ ክታበ ያሻር ኬሰት በሬፈሜረ። እንስ፦<verse eid="2SA 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="2SA 1:19"/>“ያ እስራኤል፣ ኡልፍንኬ ጋረንኬረት አጄፈሜረ።</para>
  <para style="q2" vid="2SA 1:19">ነሞትን ጀጀቦን አከምት አከስ ኩኩፈን!<verse eid="2SA 1:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="2SA 1:20"/>“ዋን ከነ ጋት ኬሰት ህንዱበትና፤</para>
  <para style="q2" vid="2SA 1:20">ዳንዲወን አሽቀሎንረትስ ህንለብስና፤</para>
  <para style="q1" vid="2SA 1:20">ዮ ከና አቺ እንተለን ፍልስጤሞታ ንገመዱ፤</para>
  <para style="q2" vid="2SA 1:20">እንተለን ወረ ዸግነ ህንቀበትኒስ ንእልልቹ።<verse eid="2SA 1:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="2SA 1:21"/>“ያ ቱሉወን ግልቦኣ፣</para>
  <para style="q2" vid="2SA 1:21">ፍጤንስ እስንረ ህንቡእን ዮካን ቦካን እስንት ህንሮብን፤</para>
  <para style="q2" vid="2SA 1:21">ዮካን ለፍት ቆቲሳ ምዻን ኣርሳፍ ዽኤፈሙ</para>
  <para style="q2" vid="2SA 1:21">ብቅልቹ እስን ኬሰት ህንአርገምን።</para>
  <para style="q1" vid="2SA 1:21">ጋቸን ነመ ጀባ አችት ጡራኤራቲ፤</para>
  <para style="q2" vid="2SA 1:21">ጋቸን ሳኦል ስአች ዘይቲ ህንድበሙ።<verse eid="2SA 1:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="2SA 1:22"/>“ዺገ ነሞተ ዹመኒ ኬሳ፣</para>
  <para style="q2" vid="2SA 1:22">ፎን ነሞተ ጀጀቦራ፣</para>
  <para style="q1" vid="2SA 1:22">እዳን ዮናታን ዱበት ህንዴብኔ፤</para>
  <para style="q2" vid="2SA 1:22">ጎራዴን ሳኦልስ አከሱማን ህንዴብኔ።<verse eid="2SA 1:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="2SA 1:23"/>ሳኦሊፊ ዮናታን ዬሮ ሉቡን ጅራቻ ቱረንት፣</para>
  <para style="q2" vid="2SA 1:23">ጃለተሞ ነምን እሳንት ገመዱ ቱረን፤</para>
  <para style="q2" vid="2SA 1:23">እሳን ዬሮ ዱኣትስ ገርገር ህንባኔ።</para>
  <para style="q1" vid="2SA 1:23">እሳን ርሳ ጫላ አሪፈቱ፣</para>
  <para style="q2" vid="2SA 1:23">ሌንጨ ጫላስ ጀባቱ ቱረን።<verse eid="2SA 1:23"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="24" style="v" sid="2SA 1:24"/>“ያ እንተለን እስራኤል፣</para>
  <para style="q2" vid="2SA 1:24">ሳኦል እሰ ወያ ብልዲማፊ ኡፈተ ሀጲ እስንት ኡፍሴ፣</para>
  <para style="q1" vid="2SA 1:24">ከን ወያኬሰን ወርቄዻን ሚዸግሴ፣</para>
  <para style="q2" vid="2SA 1:24">ሰናፍ ቦኣ።<verse eid="2SA 1:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="2SA 1:25"/>“ነሞትን ጀጀቦን አከምት ወራነ ኬሰት ኩፉ!</para>
  <para style="q2" vid="2SA 1:25">ዮናታን ጋረንኬሰንረት አጄፈሜረ።<verse eid="2SA 1:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="2SA 1:26"/>ያ ዮናታን ኦቦሌሰኮ፣ አን ሲፍ ገዴረ፤</para>
  <para style="q2" vid="2SA 1:26">አት አናፍ ነመ አከ መሌ ጃለተማ ቱርቴ።</para>
  <para style="q1" vid="2SA 1:26">ጃለል አት ናፍ ቀብዱ ድንቅሲሳ ቱሬ፤</para>
  <para style="q2" vid="2SA 1:26">ጃለለ ዱበርቲ ጫላ ድንቅሲሳ ቱሬ።<verse eid="2SA 1:26"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="27" style="v" sid="2SA 1:27"/>“ነሞትን ጀጀቦን አከምት ኩፈን!</para>
  <para style="q2" vid="2SA 1:27">ምኦን ሎላ በሌፈመኒሩ!”<verse eid="2SA 1:27"/></para>
  <chapter eid="2SA 1"/>
  <chapter number="2" style="c" sid="2SA 2"/>
  <para style="s1">ዳዊት ድበሜ ሞቲ ይሁዳ ተኤ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 2:1"/>ከነ ቦዴ ዳዊት፣ “መጋላወን ይሁዳ ኬሳ ገረ እሰ ቶኮት ኦል በኡ?” ጄዼ <char style="nd">ዋቀዮን</char> ጋፈቴ።</para>
  <para style="p" vid="2SA 2:1">
    <char style="nd">ዋቀዮስ</char>፣ “በእ” ጄዼን።</para>
  <para style="p" vid="2SA 2:1">ዳዊትሞ፣ “ገረ እሰ ከሚን ኦል በአ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="2SA 2:1">
    <char style="nd">ዋቀዮስ</char>፣ “ገረ ኬብሮንት” ጄዼ ዴብሴፍ።<verse eid="2SA 2:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 2:2"/>ከናፉ ዳዊት ኒቶተሳ ለማን ጄቹንስ አሂኖአም ይዝርኤልቲ ሰናፊ አቢገዪል ከን ናባል ነምች ቀርሜሎስ ሱንራ ዱኤ ወጅን ኦል በኤ። <verse eid="2SA 2:2"/><verse number="3" style="v" sid="2SA 2:3"/>ዳዊት ነሞተ እሰ ወጅን ቱረን ቶኮ ቶኮሳኒ ማቲሳኒ ወጅን ፉዸቴ፤ እሳንስ መጋላወን ኬብሮን ኬሰ ቁበተን። <verse eid="2SA 2:3"/><verse number="4" style="v" sid="2SA 2:4"/>ኤርገሲስ ነሞትን ይሁዳ ገረ ኬብሮን ዹፈኒ መነ ይሁዳረት ዳዊትን ሞቲ ጎዸኒ ድበን።</para>
  <para style="p" vid="2SA 2:4">ዬሮ አከ ነሞትን ያቤሽ ግልኣድ ሳኦልን አዋለን ዳዊትት ህመሜት፣ <verse eid="2SA 2:4"/><verse number="5" style="v" sid="2SA 2:5"/>እን አከነ ጄዼ ገረ ነሞተ ያቤሽ ግልኣድት ኤርገሞተ ኤርጌ፤ “ሰበቢ እስን እሰ አዋሉዻን ሳኦል ጎፍታኬሰኒፍ አርጁማ አከሲ ጎተኒፍ <char style="nd">ዋቀዮ</char> እስን ሃኤብሱ። <verse eid="2SA 2:5"/><verse number="6" style="v" sid="2SA 2:6"/>አመስ <char style="nd">ዋቀዮ</char> ጃለለሳ ከን ህንጌደረምኔፊ አመነሙማሳ እስኒፍ ሃኬኑ፤ አን ዋን እስን አከስ ጎተኒፍ አከሱመ ዋን ጋሪ እስኒፍ ነንጎዸ። <verse eid="2SA 2:6"/><verse number="7" style="v" sid="2SA 2:7"/>ኤጋ አመ ጀባዻ፤ ጭማ፤ ሳኦል ጎፍታንኬሰን ዱኤራቲ፤ ነሞትን ይሁዳሞ ሞቲ ጎዸተኒ ኦፍረት ነ ድበኒሩ።”<verse eid="2SA 2:7"/></para>
  <para style="s1">ወራነ መነ ዳዊቲፊ መነ ሳኦል ግዱ ቱሬ</para>
  <para style="r">
    <ref loc="2SA 3:2-5">3፥2‑5</ref> ኩወፈ – <char style="xt"><ref loc="1CH 3:1-4">1ሴና 3፥1‑4</ref></char></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 2:8"/>ዬሮ ሰነት አብኔር እልም ኔር አጀጃን ወራና ሳኦል ኢሽ-ቦሼት እልመ ሳኦል ፉዼ ገረ መሀነዪምት ደበርሴ። <verse eid="2SA 2:8"/><verse number="9" style="v" sid="2SA 2:9"/>እንስ ግልኣድ፣ አሹር፣ ይዝርኤል፣ ኤፍሬሚፊ ቤንያም፣ አከሱመስ ጉቱማ እስራኤልረት እሰ ሞስሴ።<verse eid="2SA 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 2:10"/>ኢሽ-ቦሼት እልም ሳኦል ዬሮ እስራኤልረት ሞቲ ተኤት ኡሙሪንሳ ወጋ አፉርተመ ቱሬ፤ እንስ ወጋ ለመ ሞኤ። ተኡስ መን ይሁዳ ዳዊት ዱካ ቡኤ። <verse eid="2SA 2:10"/><verse number="11" style="v" sid="2SA 2:11"/>ዳዊትስ ኬብሮንት መነ ይሁዳረት ወጋ ቶርባፊ ጅአ ጀአ ሞቲ ተኤ።<verse eid="2SA 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 2:12"/>አብኔር እልም ኔር ነሞተ ኢሽ-ቦሼት እልመ ሳኦል ሰነ ወጅን መሀነዪሚ ከአኒ ገረ ግቤኦን ዸቀን። <verse eid="2SA 2:12"/><verse number="13" style="v" sid="2SA 2:13"/>ዮኣብ እልም ዜሩያፊ ነሞትን ዳዊት እሳን ስመቹፍ በአኒ ሀሮ ግቤኦን ብረት እት ዹፈን። ገሬን ቶኮ ገመ ቶኮን፣ ገሬን ካንሞ ገመ ካኒን ሀሮ ሰነ ብረ ተታአን።<verse eid="2SA 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 2:14"/>አብኔርስ ዮኣቢን፣ “ሜ ደርገጎትን ከአኒ ፉለኬኘ ዱረት ወል ሃቱመን” ጄዼ።</para>
  <para style="p" vid="2SA 2:14">ዮኣብስ፣ “ሃተኡ፤ ወል ሃቱመን” ጄዼ።<verse eid="2SA 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 2:15"/>ከናፉ ቤንያምራ ነሞትን ኩዸ ለመ ኢሽ-ቦሼት እልመ ሳኦሊፍ፣ ነሞትን ኩዸ ለመሞ ከአኒ ዳዊቲፍ ለካአመን። <verse eid="2SA 2:15"/><verse number="16" style="v" sid="2SA 2:16"/>ቶኮን ቶኮን ነማስ ሞርምቱሳ መታ ቀቤ ጭናቸሳት ጎራዴ ድሬ ወል ቀበተኒ ኩኩፈን። ከናፉ እዶን ሱን ግቤኦን ኬሰት ለፈ ጎራዴ ጄዸሜ ዋመሜ።<verse eid="2SA 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 2:17"/>ሎል ጋፈ ሰና አከ መሌ ጀባ ቱሬ፤ አብኔሪፊ ነሞትን እስራኤልስ ነሞተ ዳዊቲን ሞአተመን።<verse eid="2SA 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 2:18"/>እልማን ዜሩያ ሰደን ጄቹንስ ዮኣብ፣ አቢሻዪፊ አሳሄል አች ቱረን። አሳሄል አኩመ ኩሩጴ ቦሶና ፊግቸት ነመ ጀባ ቱሬ። <verse eid="2SA 2:18"/><verse number="19" style="v" sid="2SA 2:19"/>እንስ ኡቱ ምርገት ዮካን ብታት ህንጎርን ፋነ ቡኤ አብኔርን አርኤ። <verse eid="2SA 2:19"/><verse number="20" style="v" sid="2SA 2:20"/>አብኔርስ ኦፍረ ገረገሌ፣ “አት አሳሄሊ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="2SA 2:20">እንስ፣ “ኤዬ አኑመ” ጄዼ ዴብሴ።<verse eid="2SA 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 2:21"/>ኤርገሲስ አብኔር፣ “ገረ ምርጋት ዮካን ብታት ገረገሊቲ ደርገጌሰ ቶኮ ቀቢ ምአ ሎላሳራ ፉዸዹ” ጄዼን። አሳሄል ገሩ እሰ አርኡ ህንዺፍኔ።<verse eid="2SA 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 2:22"/>አብኔር አመስ አሳሄልን፣ “ነ ህንአርእን! አን ማሊፈን ስ ገላፈዸ? አን አከምን ፉለኮ ኦል ፉዸዼ ኦቦሌሰኬ ዮኣብን እላለ?” ጄዼ።<verse eid="2SA 2:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 2:23"/>አሳሄል ገሩ እሰ አርኡ ህንዺፍኔ፤ ከናፉ አብኔር ቀረ ኤቦሳቲን ገራሳ ወራኔ፤ ኤቦን ሱንስ ኬሰ ፉለኤ ዱግደሳቲን በኤ። አሳሄልስ አችት ኩፌ ዮሙሱመ ዱኤ። ነምን ሁንድስ እዶ አሳሄል እት ኩፌ ዱኤ ሰነ ገኤ ዻበተ ቱሬ።<verse eid="2SA 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 2:24"/>ዮኣቢፊ አቢሻይ ገሩ አብኔርን አርአን፤ እሳንስ ዬሮ አዱን ዽኤት ጋረ አማ ከን ከራ ገሞጂ ግቤኦንት ጌሱረ ጊያት ገረገሌ አርገሙ ሰነ ገአን። <verse eid="2SA 2:24"/><verse number="25" style="v" sid="2SA 2:25"/>ነሞትን ቤንያምስ አብኔር ብረት ወልት ቀበመን። እሳንስ ገሬዻን ወልጉርሜሰኒ ጋረ አማ ጉባት ህሪረን።<verse eid="2SA 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 2:26"/>አብኔርስ እዬ ዮኣብን ዋሜ፣ “ጎራዴን ኩን በረ በራን ዋ ገላፈቹ ቀባ? አከ ዹምን ዋን ከና ሀዻኣ ተኤ አት ወላልቴቲ? አት ሀመ ዮሚት አከ ነሞትንኬ ኦቦሎተሳኒ አርኡ ዺሰን እት ህንህምቱ?” ጄዼ።<verse eid="2SA 2:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 2:27"/>ዮኣብሞ ዴብሴ፣ “ዹጋ ዋቀ ጅራታ፣ ኡቱ አት ዋን ከነ ጄቹ ባቴ ስላ ነሞትን ሀመ ለፍት በርኡት ኦቦሎተሳኒ አርኡራ ህንዴብአን ቱሬ” ጄዼ።<verse eid="2SA 2:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 2:28"/>ከናፉ ዮኣብ መለከተ አፉፌ፤ ነሞትን ሁንድስ እስራኤሎተ አርኡ ዺሰን፤ ለመተስ ወራን እሳን ግዱት ህንካኔ።<verse eid="2SA 2:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 2:29"/>አብኔሪፊ ነሞትንሳ ሀልከን ሰነ ጉቱ አረባ ኬሰ ያአኒ ደርበን። እሳንስ ለገ ዮርዳኖስ ጬአኒ ጉቱማ ቢትሮን ኬሰ ደርበኒ ገረ መሀነዪም ዹፈን።<verse eid="2SA 2:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 2:30"/>ኤርገሲስ ዮኣብ አብኔርን አርኡ ዺሴ ነሞተሳ ሁንደ ወልት ቀቤ። ዬሮ ሰነትስ አከ ነሞተ ዳዊት ኬሳ አሳሄልን መሌ ነሞትን ኩዸ ሰገል በደን ቤከሜ። <verse eid="2SA 2:30"/><verse number="31" style="v" sid="2SA 2:31"/>ነሞትን ዳዊት ገሩ ነሞተ ቤንያም ኬሳ ወረ አብኔር ወጅን ቱረን ዽበ ሰዲፊ ጃተመ አጄሰን። <verse eid="2SA 2:31"/><verse number="32" style="v" sid="2SA 2:32"/>እሳንስ ሬፈ አሳሄል ፉዸተኒ ቤትልሄምት እዶ አዋለ አባሳት አዋለን። ዮኣቢፊ ነሞትንሳ ሀልከን ጉቱ ዴማ ቡለኒ በሪ ኦቦሮ ኬብሮን ገአን።<verse eid="2SA 2:32"/></para>
  <chapter eid="2SA 2"/>
  <chapter number="3" style="c" sid="2SA 3"/>
  <para style="p">
    <verse number="1" style="v" sid="2SA 3:1"/>መነ ሳኦሊፊ መነ ዳዊት ግዱ ወራነ በረ ዼራቱ ቱሬ። ዬሮ ዳዊት ጀባቻ ዴሜት መን ሳኦልሞ ደዸባ ዴሜ።<verse eid="2SA 3:1"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="2" style="v" sid="2SA 3:2"/>ዳዊት ኬብሮንት እጆሌ ዸልቼ፤ እሳንስ፦</para>
  <para style="b" vid="2SA 3:2"/>
  <para style="li1" vid="2SA 3:2">እን ሀንገፍን አምኖን እሰ አሂኖአም ይዝርኤልቲን ዴሴዸ፤<verse eid="2SA 3:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="2SA 3:3"/>እን ለመፋን ክልኣብ እልመ አቢገዪል እሼን ናባል ነምች ብየ ቀርሜሎስራ ዱኤ ሱን ዴሴዸ፤</para>
  <para style="li1" vid="2SA 3:3">ሰደፋን አቤሳሎም እልመ መአካ ከን እንተል ተልማይ ሞትቸ ጌሹር ሱን ዴሴዸ፤<verse eid="2SA 3:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="2SA 3:4"/>አፉረፋን አዶንያ እልመ ሀጊት፤</para>
  <para style="li1" vid="2SA 3:4">ሸነፋን ሼፋጥያ እልመ አቢጣል፤<verse eid="2SA 3:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="2SA 3:5"/>ጀአፋን ይትሬኣም እልመ ኤግላ ኒቲን ዳዊት ዴሴዸ።</para>
  <para style="b" vid="2SA 3:5"/>
  <para style="lf" vid="2SA 3:5">እሳን ኩኔን ኬብሮንት ዳዊቲፍ ዸለተን።<verse eid="2SA 3:5"/></para>
  <para style="s1">አብኔር ገሬ ዳዊት ተኤ</para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 3:6"/>ዬሮ መነ ሳኦሊፊ መነ ዳዊት ግዱ ወራን ቱሬት አብኔር መነ ሳኦልረት ሁምነሳ ጀቤፈቻ ቱሬ። <verse eid="2SA 3:6"/><verse number="7" style="v" sid="2SA 3:7"/>ሳኦልስ እንተለ አያ ከን ሪጥጳ ጄዸምቱ ሳጀቶ ጎዸቴ ቱሬ። ኢሽ-ቦሼትስ አብኔሪን፣ “አት ማሊፍ ሳጀቶ አባኮቲ ወጅን ረፍቴ?” ጄዼ።<verse eid="2SA 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 3:8"/>አብኔርሞ ዋን ኢሽ-ቦሼት አከስ ጄዼፍ አከ መሌ ኣሬ አከነ ጄዼ፤ “አን መታ ሰሬ ይሁዳቲ? አን ሀመ ሀርኣት መነ አባኬ ሳኦሊፍ፣ መነ ማቲሳቲፊ መነ ፍሮተሳቲፍ አመነማዸ። ስእሌ ደበርሴ ዳዊትት ህንኬንኔ። አት ገሩ አመ ዋኤ ዱበርቲ ከናቲፍ ነ ህመተ! <verse eid="2SA 3:8"/><verse number="9" style="v" sid="2SA 3:9"/>ዮ አን አከ አብዲን ዋቅን ዳዊቲፍ ኬኔ ሱን ራወተሙ ጎቹ ባዼ <char style="nd">ዋቀዮ</char> አብኔርረት ዋን ሀማ ሃጎዹ፤ ሰነ ጫላዩ እሰት ሃፍዱ፤ <verse eid="2SA 3:9"/><verse number="10" style="v" sid="2SA 3:10"/>ወን ዋቅን ከኩዻን እሰ አብደቺሴ ሱንስ መነ ሳኦልራ ሞቱማ ፉዼ ዳኒ ጀልቀቤ ሀመ ቤርሼባት እስራኤሊፊ ይሁዳረት ቴሶ ዳዊት ጀቤሴ ዻቡዸ።” <verse eid="2SA 3:10"/><verse number="11" style="v" sid="2SA 3:11"/>ኢሽ-ቦሼት ዋን እሰ ሶዳቴፍ አብኔርት ዋን ቶኮሌ ዱበቹ ህንደንዴኜ።<verse eid="2SA 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 3:12"/>ኤርገሲ አብኔር፣ “ብየቲን ከን ኤኙት? ነ ወጅን ወሊ ገልቴ ጎዸዹ፤ አንስ አከ እስራኤል ጉቱማን ጉቱት ገረኬ ጎሩ ስን ገርጋራ” ጄዼ ዳዊትት ኤርገሞተ ኤርጌ።<verse eid="2SA 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 3:13"/>ዳዊትስ፣ “ጋሪዸ፤ አን ስ ወጅን ወሊ ገልቴ ነንጎዸዸ። ገሩ ዋን ቶኮ ስን ጋፈዸ፤ ኩንስ አት ዮሙ ገረኮ ዹፍቱት ጀልቀበት ሚካል እንተለ ሳኦል ና ፍድ፤ ዮ ከና አቺ ገረኮ ህንዹፍን” ጄዼ። <verse eid="2SA 3:13"/><verse number="14" style="v" sid="2SA 3:14"/>ኤርገሲስ ዳዊት፣ “ኒቲኮ እሼ አን ምሳ ፍልስጤሞተ ዽበ ቶኮቲን ካዽመዼ ሚካልን ና ኤርግ” ጄዼ ኢሽ-ቦሼት እልመ ሳኦልት ኤርገሞተ ኤርጌ።<verse eid="2SA 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 3:15"/>ከናፉ ኢሽ-ቦሼት ነመ ኤርጌ ዽርሰሼ ጰልቲኤል እልመ ላይሽ እራ እሼ ፉዸቴ። <verse eid="2SA 3:15"/><verse number="16" style="v" sid="2SA 3:16"/>ዽርስሼስ ሀመ መጋላ በሁሪምት ቦኣ እሼ ዱካ ቡኤ። አብኔርስ፣ “መነኬት ዴብእ!” ጄዼን። ከናፉ እን ንዴብኤ።<verse eid="2SA 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 3:17"/>አብኔር ማንጉዶተ እስራኤል ወጅን መርአቴ አከነ ጄዼ፤ “እስን ከናን ዱረ አከ ዳዊት ሞቲኬሰን ተኡ ሀዋ ቱርተን። <verse eid="2SA 3:17"/><verse number="18" style="v" sid="2SA 3:18"/><char style="nd">ዋቀዮ</char>፣ ‘አን ገርብቸኮ ዳዊቲን ሰበ እስራኤል ሀርከ ፍልስጤሞታቲ አከሱመስ ሀርከ ዲኖተሳኒ ሁንዳ ኬሳ ነንባሰ’ ጄዼ አብደቺሴራቲ እስን ዋን ከነ ገልማን ገኣ!”<verse eid="2SA 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 3:19"/>አብኔር ነሞተ ቤንያም ብረትስ ንዱበቴ። ኤርገሲስ ኬብሮን ዸቄ ዋን እስራኤሎትኒፊ መን ቤንያም ሁንድ ጎቹ በርባደን ዳዊትት ህሜ። <verse eid="2SA 3:19"/><verse number="20" style="v" sid="2SA 3:20"/>ዮሙ አብኔር ነሞተሳ ድግደመ ወጅን ኬብሮን ዹፌት፣ ዳዊት እሳፊ ነሞተሳቲፍ ጭዸ ቆጴሴ። <verse eid="2SA 3:20"/><verse number="21" style="v" sid="2SA 3:21"/>አብኔርስ ዳዊቲን፣ “አን ከኤ ዴሜ አከ እሳን ጎፍታኮ ሞቲ ወጅን ከኩ ገለኒፊ አከ አት ወረ ገራንኬ ፌዼ ሁንደረት ሞቲ ታቱፍ እስራኤሎተ ሁንደ ወልት ነንቀበ” ጄዼ። ከናፍ ዳዊት እሰ ጌጌሴ፤ እንስ ነጋዻን ዴሜ።<verse eid="2SA 3:21"/></para>
  <para style="s1">ዮኣብ አብኔርን አጄሴ</para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 3:22"/>ነሞትን ዳዊቲፊ ዮኣብ ዮሙሱመ ቦጁ ሄዱ ፉዸተኒ ዱላ ገለን። አብኔር ገሩ ዳዊት ወጅን ኬብሮን ህንቱሬ፤ ዳዊት እሰ ጌጌሴ እን ነጋን ዴሜራቲ። <verse eid="2SA 3:22"/><verse number="23" style="v" sid="2SA 3:23"/>ዮኣቢፊ ሎልቶትን እሰ ወጅን ቱረን ሁንድ ዮሙ አች ገአንት አከ አብኔር እልም ኔር ሞትቸ ብረ ዹፌ ሞትች ነጋን እሰ ጌጌሴ እሰት ህመሜ።<verse eid="2SA 3:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 3:24"/>ከናፉ ዮኣብ ገረ ሞትቻ ዸቄ አከነ ጄዼ፤ “ማል ጎቹኬት? ኩኖ አብኔር ገረኬ ዹፌ ቱሬ። አት ማሊፍ እሰ ጌጌስቴ? እን አመ ዴሜረ! <verse eid="2SA 3:24"/><verse number="25" style="v" sid="2SA 3:25"/>አት አብኔር እልመ ኔር ንቤክተ፤ እን ስ ጎዎምሴ ሶቺኬቲፊ ዋን አት ጎቻ ጅርቱ ሁንደ በሳሱዻፍ ዹፌ።”<verse eid="2SA 3:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 3:26"/>ዮኣብስ ዳዊት ብራ በኤ አብኔር ዱባን ኤርገሞተ ኤርጌ፤ እሳንስ ቦለ ብሻኒ ከን ሲራ ብራ እሰ ዴብሰን። ዳዊት ገሩ ዋን ከነ ህንቤክኔ። <verse eid="2SA 3:26"/><verse number="27" style="v" sid="2SA 3:27"/>ዬሮ አብኔር ኬብሮንት ዴብኤትስ ዮኣብ ዋን ኮጳት እሰ ወጅን ሃሰኡ በርባዴ ፈኬሴ ገረ ከራት እሰ ባሴ። አችትስ ሃሎ ዺገ ኦቦሌሰሳ አሳሄል ባሱፍ ገራ ኬሰ እሰ ወራኔ፤ እንስ ንዱኤ።<verse eid="2SA 3:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 3:28"/>ኤርገሲ ዳዊት ዮሙ ዋን ከነ ዸገኤት አከነ ጄዼ፤ “አኒፊ ሞቱማንኮ በረ በራን ዺገ አብኔር እልመ ኔርራ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ቁልቁሉዸ። <verse eid="2SA 3:28"/><verse number="29" style="v" sid="2SA 3:29"/>ጩቡን ዺገሳ መታ ዮኣቢፊ መነ አባሳ ሁንዳረ ሃገኡ! ነምን መዳ መላ ያሱ ዮካን ለምጢ ቀቡ ዮካን ነምን ኡሌት ረረኤ ዴሙ ዮካን ነምን ጎራዴን አጄፈሙ ዮካን ነምን ዋን ኛቱ ዸቡ መነ ዮኣቢ ህንዸበምን።”<verse eid="2SA 3:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 3:30"/>ሰበቢ እን ሎለ ግቤኦንረት ኦቦሌሰሳኒ አሳሄልን አጄሴፍ ዮኣቢፊ ኦቦሌስሳ አቢሻይ አብኔርን አጄሰን።<verse eid="2SA 3:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 3:31"/>ዳዊትስ ዮኣቢፊ ነሞተ እሰ ወጅን ቱረን ሁንዳን፣ “ኡፈተኬሰን ተርሳሳቲ ኡፈተ ገዳ ኡፈዻ፤ ፉለ አብኔር ዱረትስ ቦኣ” ጄዼ። ዳዊት ሞትችስ ሬፈ አብኔር ጌጌሴ። <verse eid="2SA 3:31"/><verse number="32" style="v" sid="2SA 3:32"/>እሳንስ አብኔርን ኬብሮንት አዋለን፤ ሞትችስ አዋለ አብኔርረት እዬ ቦኤ፤ ነሞትን ሁንድኑስ ንቦአን።<verse eid="2SA 3:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 3:33"/>ሞትችስ ፋሩ ገዳ ከነ አከነ ጄዼ አብኔሪፍ ፋርሴ፦</para>
  <para style="q1" vid="2SA 3:33">“አብኔር አከ ዱአ ነመ የራ ቶኮት ዱኡ ቀባ?<verse eid="2SA 3:33"/></para>
  <para style="q2">
    <verse number="34" style="v" sid="2SA 3:34"/>ሀርክኬ ህንህዸምኔ፤</para>
  <para style="q2" vid="2SA 3:34">ሚልኬ ፎንጫዻን ህንጋድአምኔ።</para>
  <para style="q1" vid="2SA 3:34">አት አኩመ ነመ ፉለ ሀሞታ ዱረት ኩፉ ቶኮት ኩፍቴ።”</para>
  <para style="p" vid="2SA 3:34">ነሞትን ሁንድኑ አመሌ ንቦአኒፍ።<verse eid="2SA 3:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="2SA 3:35"/>ገረ ሳፋትስ ነሞትን ሁንድ ዹፈኒ አከ እን ዋ ኛቱፍ ዳዊትን ከዸተን፤ እን ገሩ፣ “ዮ አን ሀመ ቢፍቱን ልጡት ቡዴነ ዮካን ዋን ብራ አፋንኮቲን ቀቤ ዋቅን ዋን ሀማ ነት ሃፍዱ፤ ከነ ጫላዩ ነት ሃፍዱ!” ጄዼ ከከቴ።<verse eid="2SA 3:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="2SA 3:36"/>ነሞትን ሁንድኑ ዋን ከነ አርገኒ ገመደን፤ ዹጉማን ወን ሞትች ጎዼ ሁንድ እሳን ገመቺሴ። <verse eid="2SA 3:36"/><verse number="37" style="v" sid="2SA 3:37"/>ከናፉ ጋፈ ሰነ ነሞትን ሁንዲፊ እስራኤል ሁንድ አከ አጄፈሙ አብኔር እልመ ኔር ኬሰት ሞትች ቆደ ህንቀብኔ ቤከን።<verse eid="2SA 3:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="2SA 3:38"/>ሞትችስ ነሞተሳቲን አከነ ጄዼ፤ “እስን አከ ጉያ ሀርኣ እልም ሞቲቲፊ ነምን ጉዳን ቶኮ እስራኤል ኬሳ ኩፌ ህንቤክኔ? <verse eid="2SA 3:38"/><verse number="39" style="v" sid="2SA 3:39"/>አን ሞቲ ድበሜ ተኡሌ ሀርአ ነመ ደዸባዸ፤ እልማን ዜሩያ ኩኔን ነት ጀባተኒሩ። <char style="nd">ዋቀዮ</char> ነመ ዋን ሀማ ሆጄቱፍ አኩመ ሀምነ ሆጂሳት እሳፍ ሃኬኑ!”<verse eid="2SA 3:39"/></para>
  <chapter eid="2SA 3"/>
  <chapter number="4" style="c" sid="2SA 4"/>
  <para style="s1">ኢሽ-ቦሼት አጄፈሜ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 4:1"/>ኢሽ-ቦሼት እልም ሳኦል ዮሙ አከ አብኔር ኬብሮንት አጄፈሜ ዸገኤት ሁምንሳ ንቡኤ፤ እስራኤል ሁንድስ ሶዳን ጉተሜ። <verse eid="2SA 4:1"/><verse number="2" style="v" sid="2SA 4:2"/>ዬሮ ሰነት ኢሽ-ቦሼት እልም ሳኦል ዱረ ቡቶተ ገሬ ዱልቶታ ለመ ቀበ ቱሬ። እን ቶኮ በአና፣ ካንሞ ሬካብ ጄዸመ ቱሬ፤ እሳንስ እልማን ርሞን ነምቸ ብኤሮት ከን ጎሰ ቤንያም ሰናት፤ ብኤሮት ኩን አከ ኩታ ቤንያምት ለካአመ፤ <verse eid="2SA 4:2"/><verse number="3" style="v" sid="2SA 4:3"/>ነሞትን ብኤሮት ኩኔን ገረ ግተይምት በቀተኒ ሀመ ሀርኣት አለጉማን አች ጅራቱቲ።<verse eid="2SA 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 4:4"/>ዮናታን እልም ሳኦል ሙጫ ሚልሳ ለቹ ናፈቴ ቶኮ ቀበ ቱሬ። ዬሮ ኦዱን ዋኤ ሳኦሊፊ ዮናታን ይዝርኤልራ ዹፌት እን ነመ ወጋ ሸኒ ቱሬ። ጉድፍቱንሳስ እሰ ፉዸቴ በቀቴ፤ ገሩ ኡቱ እሼን በቀቹፍ አሪፈቱ ሙጭች እሼራ ኩፌ ናፈቴ። መቃንሳስ ሜፊቦሼት ጄዸመ ቱሬ።<verse eid="2SA 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 4:5"/>ሬካቢፊ በአናን እልማን ርሞን ነምቸ ጎሰ ብኤሮት ከአኒ ገረ መነ ኢሽ-ቦሼት ቀጄለን፤ ዬሮን እሳን እት አች ገአንስ ጉያ ሳፋ ዬሮ እን እት ኣረ ገልፈቱ ቱሬ። <verse eid="2SA 4:5"/><verse number="6" style="v" sid="2SA 4:6"/>እሳንስ አከ ነመ ቀመዲ በርባዱት ኩታ መና እሰ ገረ ኬሳት ኦል ሴነኒ ገራሳ ወራነን። ኤርገሲስ ሬካቢፊ ኦቦሌስሳ በአናን ምልቀኒ በአን።<verse eid="2SA 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 4:7"/>እሳንስ ኡቱ እን ኩታ ጪስቻ ኬሰ ስሬሳረ ረፌ ጅሩ ኦል ሴነን። ኤርገ ገራሳ ወራነኒ እሰ አጄሰኒ ቦዴስ መታሳራ ኩተን። መታ ሰነስ ፉዸኒ ሀልከን ጉቱ ዳንዲ አረባረ ዴማ ቡለን። <verse eid="2SA 4:7"/><verse number="8" style="v" sid="2SA 4:8"/>እሳንስ ኬብሮንት መታ ኢሽ-ቦሼት ገረ ዳዊት ሞትቻ ፍደኒ፣ “ኩኖ መታ ኢሽ-ቦሼት እልመ ዲነኬ ሳኦል ከን እልመ ነምቸ ስ አጄሱ በርባዱ ሰና። ሀርአ <char style="nd">ዋቀዮ</char> ሳኦሊፊ ሰኚሳሌ ጎፍታኮ ሞትቻፍ ሃሎ ባሴረ” ጄዸኒን።<verse eid="2SA 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 4:9"/>ዳዊትሞ ሬካቢፊ ኦቦሌሰሳ በአና፣ እልማን ርሞኒ ነምቸ ጎሰ ብኤሮታ ሰናን አከነ ጄዼ፤ “ዹጋ <char style="nd">ዋቀዮ</char> ጅራታ እሰ ረክነ ሁንደ ጀላ ነ ባሴ ሰና፣ <verse eid="2SA 4:9"/><verse number="10" style="v" sid="2SA 4:10"/>ኩኖ አን ነምቸ ዋን ኦዱ ጋሪ ና ፍዴ ሴኤ፣ ‘ሳኦል ዱኤረ’ ጄዼ ነት ህሜ ሰነ ቀቤ ሲቅላግት አጄሴረ። ኤጋ ወን አን ነምቸ ኦዱ ሰነ ፍዴ በዻሴ ከነዸ! <verse eid="2SA 4:10"/><verse number="11" style="v" sid="2SA 4:11"/>ዮስ ዬሮ ነሞትን ሀሞን ነመ በሌሳ ህንቀብኔ ቶኮ መነሳ ኬሰት፣ ስሬሳረት አጄሰንት አን ዺገሳ ሀርከኬሰንራ ህንበርባዱሬ? ለፈራስ ህንበሌሱሬ?”<verse eid="2SA 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 4:12"/>ከናፉ ዳዊት ነሞተሳ አጀጄ፤ እሳንስ ጀረ አጄሰን። ሀርካፊ ሚለሳኒራ ኩኩተኒ ሀሮ ኬብሮን ብረት ሬፈሳኒ ፈንሰን። መታ ኢሽ-ቦሼት ገሩ ፉዸኒ ኬብሮንት አዋለ አብኔር ብረት አዋለን።<verse eid="2SA 4:12"/></para>
  <chapter eid="2SA 4"/>
  <chapter number="5" style="c" sid="2SA 5"/>
  <para style="s1">ዳዊት እስራኤልረት ሞቲ ተኤ</para>
  <para style="r">
    <ref loc="2SA 5:1-3">5፥1‑3</ref> ኩወፈ – <char style="xt"><ref loc="1CH 11:1-3">1ሴና 11፥1‑3</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 5:1"/>ጎሶትን እስራኤል ሁንድ ኬብሮንት ዳዊት ብረ ዹፈኒ አከነ ጄዸን፤ “ኑ ፎኒፊ ዺገኬት። <verse eid="2SA 5:1"/><verse number="2" style="v" sid="2SA 5:2"/>ዱራን ዬሮ ሳኦል ሞቲኬኘ ቱሬት፣ ነምን ዱለ ሎልቶተ እስራኤል ሆገኑ ስእ ቱሬ። <char style="nd">ዋቀዮስ</char>፣ ‘ስቱ ሰበኮ እስራኤልን ትክሰ፤ ቡልቻሳኒስ ንታተ’ ሲን ጄዼ ቱሬ።”<verse eid="2SA 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 5:3"/>ዮሙ ማንጉዶትን እስራኤል ሁንድ ኬብሮንት ዳዊት ሞትቸ ብረ ዹፈንት ሞትች ኬብሮንት ፉለ <char style="nd">ዋቀዮ</char> ዱረት እሳን ወጅን ከኩ ገሌ፤ እሳንስ ዳዊትን ድበኒ እስራኤልረት ሞቲ እሰ ጎዸን።<verse eid="2SA 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 5:4"/>ዳዊት ዬሮ ሞቲ ተኤት ኡሙሪንሳ ወጋ ሶዶመ ቱሬ፤ እንስ ወጋ አፉርተመ ቡልቼ። <verse eid="2SA 5:4"/><verse number="5" style="v" sid="2SA 5:5"/>ኬብሮን ኬሰት ወጋ ቶርባፊ ጅአ ጀአ ይሁዳረት ሞቲ ቱሬ፤ ዬሩሳሌም ኬሰትሞ ወጋ ሶዶሚ ሰዲ ጉቱማ እስራኤሊፊ ይሁዳረት ሞቲ ተኤ።<verse eid="2SA 5:5"/></para>
  <para style="s1">ዳዊት ዬሩሳሌም ቀበቹሳ</para>
  <para style="r">
    <ref loc="2SA 5:6-10">5፥6‑10</ref> ኩወፈ – <char style="xt"><ref loc="1CH 11:4-9">1ሴና 11፥4‑9</ref></char></para>
  <para style="r">
    <ref loc="2SA 5:11-16">5፥11‑16</ref> ኩወፈ – <char style="xt"><ref loc="1CH 3:5-9">1ሴና 3፥5‑9</ref>፤ <ref loc="1CH 14:1-7">14፥1‑7</ref></char></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 5:6"/>ሞትቺፊ ነሞትንሳ ዬቡሶተ አች ጅራተን ሎሉፍ ገረ ዬሩሳሌምት ንቀጄለን። ዬቡሶንስ ዳዊቲን፣ “አት አስ ህንሴንቱ፤ ጃማፊ ናፍንዩ ኦፍራ ስ ዴብሱ” ጄዸን። እሳን፣ “ዳዊት አስ ሴኑ ህንደንደኡ” ጄዸኒ ያደን። <verse eid="2SA 5:6"/><verse number="7" style="v" sid="2SA 5:7"/>ተኡስ ዳዊት ደአትኖ ጥዮን መጋላ ዳዊት ንቀበቴ።<verse eid="2SA 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 5:8"/>ዳዊትስ ጋፈስ፣ “ነምን ዬቡሶተ ዸኡፍ በኡ ከምዩ፣ ‘ናፎታፊ ጃሞተ’ ሉቡ ዳዊቲን ጅበመን ብረ ገኡፍ ከራ ቦኦ ብሻኒቲን ደርቡ ቀበ” ጄዼ። ሰበቢን እሳን፣ “ ‘ጃሞትኒፊ ናፎትን’ መሰራ ሞቲ ህንሴነን” ጄዸኒፍ ከኑመ።<verse eid="2SA 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 5:9"/>ዳዊትስ እዶ ጅሬኘሳ ደአትኖ ሰነ ጎዸቴ መጋላ ዳዊት ጄዼ ሞጋሴ። እን ሚሎዻ ጀልቀቤ ናኖሼ መርሴ እጃሬ። <verse eid="2SA 5:9"/><verse number="10" style="v" sid="2SA 5:10"/>እንስ ሰበቢ <char style="nd">ዋቀዮ</char> ዋቅን ዋን ሁንደ ደንደኡ እሰ ወጅን ቱሬፍ ዬሩመ ዬሮን ጀባቻ ዹፌ።<verse eid="2SA 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 5:11"/>ዬሮ ከነት ሂራም ሞቲን ጢሮስ ኤርገሞተ ወጅን ሙከ ብርብርሳ፣ ነሞተ ሙከ ሶፈኒፊ ወረ ዸጋ ሶፈን ገረ ዳዊት ኤርጌ፤ እሳንስ ዳዊቲፍ መሰራ እጃረን። <verse eid="2SA 5:11"/><verse number="12" style="v" sid="2SA 5:12"/>ዳዊትስ አከ <char style="nd">ዋቀዮ</char> ሰበ እስራኤልረት ሞቲ ጎዼ ጀቤሴ እሰ ዻቤፊ አከ ሰበ እስራኤሊፍ ጄዼ ሞቱማሳ ጉድሴፍ ንቤኬ።<verse eid="2SA 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 5:13"/>ዳዊትስ ኤርገ ኬብሮኒ በኤ ቦዴ ሳጀቶወኒፊ ኒቶተ ብራ ዬሩሳሌም ኬሰት ፉዼ፤ እልማኒፊ እንተለን ደበለታ ዸለተኒፍ። <verse eid="2SA 5:13"/><verse number="14" style="v" sid="2SA 5:14"/>መቃን እጆሌሳ ከኔን አችት እሳፍ ዸለተኒስ ሸሙኣ፣ ሾባብ፣ ናታን፣ ሶሎሞን፣ <verse eid="2SA 5:14"/><verse number="15" style="v" sid="2SA 5:15"/>ይቤሃር፣ ኤሊሹዋ፣ ኔፌግ፣ ያፊያ፣ <verse eid="2SA 5:15"/><verse number="16" style="v" sid="2SA 5:16"/>ኤሊሻማ፣ ኤልያዳፊ ኤሊጴሌጥ ጄዸሙ።<verse eid="2SA 5:16"/></para>
  <para style="s1">ዳዊት ፍልስጤሞተ ሞአቹሳ</para>
  <para style="r">
    <ref loc="2SA 5:17-25">5፥17‑25</ref> ኩወፈ – <char style="xt"><ref loc="1CH 14:8-17">1ሴና 14፥8‑17</ref></char></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 5:17"/>ፍልስጤሞትን ዮሙ አከ ዳዊት ድበሜ እስራኤልረት ሞቲ ተኤ ዸገአንት፣ ሁምነ ጉቱዻን እሰ በርባቸ ኦል በአን፤ ዳዊት ገሩ ዋን ከነ ዸገኤ ገረ ደአትኖ ጀባት ገድ ቡኤ። <verse eid="2SA 5:17"/><verse number="18" style="v" sid="2SA 5:18"/>ዬሮ ከነት ፍልስጤሞትን ዹፈኒ ሱሉለ ሬፋይም ኬሰ ፈፈጨአን፤ <verse eid="2SA 5:18"/><verse number="19" style="v" sid="2SA 5:19"/>ከናፉ ዳዊት፣ “አን በኤ ፍልስጤሞተ ዸኡ? አት ደበርስቴ ሀርከኮት እሳን ኬንታ?” ጄዼ <char style="nd">ዋቀዮን</char> ጋፈቴ።</para>
  <para style="p" vid="2SA 5:19">
    <char style="nd">ዋቀዮስ</char>፣ “በእ፤ አን ዹጉማን ፍልስጤሞተ ደበርሴ ሀርከኬት ነንኬናቲ” ጄዼ ዴብሴፍ።<verse eid="2SA 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 5:20"/>ከናፉ ዳዊት ገረ በኣል ጴራዚም ዸቄ፤ አችትስ እሳን ሞአቴ። እንስ፣ “አኩመ ብሻን መነሳ ጨብሴ ያኡ ሰነ <char style="nd">ዋቀዮ</char> ፉለኮ ዱረት ዲኖተኮ ጨብሴ በኤረ” ጄዼ። ከናፉ እዶን ሱን በኣል ጴራዚም ጄዸሜ ዋመሜ። <verse eid="2SA 5:20"/><verse number="21" style="v" sid="2SA 5:21"/>ፍልስጤሞትን ዋቆተሳኒ ቶልፈሞ አችት ዺሰኒ በቀተን፤ ዳዊቲፊ ነሞትንሳሞ እሳን ፉዸኒ ዴመን።<verse eid="2SA 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 5:22"/>ፍልስጤሞትን አመሌ ዹፈኒ ሱሉለ ሬፋይም ኬሰ ፈፈጨአን፤ <verse eid="2SA 5:22"/><verse number="23" style="v" sid="2SA 5:23"/>ከናፉ ዳዊት <char style="nd">ዋቀዮን</char> ጋፈቴ፤ ዋቀዮስ አከነ ጄዼን፤ “ከለቲዻን እት ህንበእን፤ ገሩ ዱባን እሳን መርሲቲ ሙከ ቅልጡ ዱረት እሳን ወራን። <verse eid="2SA 5:23"/><verse number="24" style="v" sid="2SA 5:24"/>አኩመ ፊጤ ሙከ ቅልጡ እራን ሰገሌ ዱላ ዸጌሴን ደፊቲ በእ፤ <char style="nd">ዋቀዮ</char> ሎልቶተ ፍልስጤም ዸኡዻፍ ስ ዱረ በኤረ ጄቹዻቲ።” <verse eid="2SA 5:24"/><verse number="25" style="v" sid="2SA 5:25"/>ከናፉ ዳዊት አኩመ <char style="nd">ዋቀዮ</char> እሰ አጀጄ ሰነ ግቤኦን ጀልቀቤ ሀመ ጌዝርት ፍልስጤሞተ ዸኤ።<verse eid="2SA 5:25"/></para>
  <chapter eid="2SA 5"/>
  <chapter number="6" style="c" sid="2SA 6"/>
  <para style="s1">ታቦትን ገረ ዬሩሳሌምት ፍደሙሳ</para>
  <para style="r">
    <ref loc="2SA 6:1-11">6፥1‑11</ref> ኩወፈ – <char style="xt"><ref loc="1CH 13:1-14">1ሴና 13፥1‑14</ref></char></para>
  <para style="r">
    <ref loc="2SA 6:12-19">6፥12‑19</ref> ኩወፈ – <char style="xt"><ref loc="1CH 15:25-16:3">1ሴና 15፥25–16፥3</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 6:1"/>ዳዊት አመስ ነሞተ እስራኤል ኬሳ ፍለተመን ኩመ ሶዶመ ወልት ቀበቴ። <verse eid="2SA 6:1"/><verse number="2" style="v" sid="2SA 6:2"/>እኒፊ ነሞትን እሰ ወጅን ቱረን ሁንድ ታቦተ ዋቃ ከን መቃ፣ መቃ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ ከን ታቦተ ጉባ፣ ኪሩቤሊ ቴሶረ ጅረን ግዱ ጅሩ ሰናቲን ዋመሙ ሰነ አቺ ፍዱፍ ገረ በኣላ እሼ ይሁዳ ኬሳ ሰና ንዸቀን። <verse eid="2SA 6:2"/><verse number="3" style="v" sid="2SA 6:3"/>እሳንስ ታቦተ ዋቃ ጋሪ ሃራረ ካአኒ መነ አቢናዳብ ከን ጋረረ ጅሩ ሰና ባሰኒ ፍደን። እልማን አቢናዳቢ፣ ኡዛፊ አሂዮን ጋሪ ሃራ ሰነ ኦፋ ቱረን፤ <verse eid="2SA 6:3"/><verse number="4" style="v" sid="2SA 6:4"/>ታቦትን ዋቃስ ጋሪረ ካአሜ አሂዮን ዱረ ዱረ ዴመ ቱሬ። <verse eid="2SA 6:4"/><verse number="5" style="v" sid="2SA 6:5"/>ዳዊቲፊ እስራኤል ሁንድኑ ሁምነሳኒ ጉቱዻን ፋርፈናዻን፣ መሲንቆዻን፣ በገናዻን፣ ድቤዻን፣ ብልብላን፣ ክልሌዻንስ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ገመደኒ ሹብሳ ቱረን።<verse eid="2SA 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 6:6"/>ዮሙ እሳን ኦብዲ ናኮን ብረ ገአንት ዋን ሰንጎን ጉፈተኒፍ ኡዛን ሀርከሳ ሂጠቴ ታቦተ ዋቃ ቀቤ። <verse eid="2SA 6:6"/><verse number="7" style="v" sid="2SA 6:7"/>ሰበቢ ሆጂሳ ከን ኡልፍነ ህንቀብኔቲፍ ዼከምስ <char style="nd">ዋቀዮ</char> ኡዛት ቦበኤ፤ ከናፉ ዋቅን እሰ ሩኩቴ፤ እንስ አቹመት ታቦተ ዋቃ ብረት ዱኤ።<verse eid="2SA 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 6:8"/>ዳዊትስ ሰበቢ <char style="nd">ዋቀዮ</char> አከ መሌ ኡዛት ዼከሜፍ ንኣሬ፤ እዶን ሱን ሀመ ሀርኣት ጴሬዝ ኡዛ ጄዸሜ ዋመመ።<verse eid="2SA 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 6:9"/>ዳዊትስ ጋፈ ሰነ <char style="nd">ዋቀዮን</char> ሶዳቴ፣ “ታቦትን <char style="nd">ዋቀዮ</char> አከምት ገረኮ ዹፈ?” ጄዼ። <verse eid="2SA 6:9"/><verse number="10" style="v" sid="2SA 6:10"/>እንስ አከ ታቦትን <char style="nd">ዋቀዮ</char> እሰ ወጅን መጋላ ዳዊት ኬሰ ጅራቱፍ ፉዸቹ ህንበርባድኔ። ቆደ ከና ገረ መነ ኦቤድ ኤዶም ነምቸ ግቲ ሰናት ጌሴ። <verse eid="2SA 6:10"/><verse number="11" style="v" sid="2SA 6:11"/>ታቦትን <char style="nd">ዋቀዮስ</char> ጅአ ሰዲ መነ ነምቸ ግቲ ከን ኦቤድ ኤዶም ጄዸሙ ሰና ቱሬ፤ <char style="nd">ዋቀዮስ</char> እሳፊ ወረ መነሳ ጅራተን ሁንደ ንኤብሴ።<verse eid="2SA 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 6:12"/>ዬሮ ከነት፣ “<char style="nd">ዋቀዮ</char> ሰበቢ ታቦተ ዋቃቲፍ ጄዼ ወረ መነ ኦቤድ ኤዶም ጅራተኒፊ ዋን እን ቀቡ ሁንደ ንኤብሴ” ጄዸኒ ዳዊት ሞትቸት ህመን። ከናፉ ዳዊት ገድ ቡኤ ታቦተ ዋቃ ሰነ መነ አቢዳራቲ ገመቹዻን ገረ መጋላ ዳዊትት ፍዴ። <verse eid="2SA 6:12"/><verse number="13" style="v" sid="2SA 6:13"/>እንስ አኩመ ነሞትን ታቦተ <char style="nd">ዋቀዮ</char> ባተን ሱን ተርካንፊ ጀአ አች ሂቀኒን ሰንጋ ቶኮፊ ጀቢ ጮማ ቶኮ ኣርሳ ዽኤሴ። <verse eid="2SA 6:13"/><verse number="14" style="v" sid="2SA 6:14"/>ዳዊትስ ድረተ ቁንጬ ተልባራ ሆጄተሜ ኡፈቴ ቆንዳልቶተሳ ወጅን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ሁምነሳ ጉቱን ሹብሰ ቱሬ፤ <verse eid="2SA 6:14"/><verse number="15" style="v" sid="2SA 6:15"/>እኒፊ እስራኤል ሁንድ “ሆ” ጄቻ ሰገሌ መለከታቲን ታቦተ <char style="nd">ዋቀዮ</char> ፍደን።<verse eid="2SA 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 6:16"/>ዬሮ ታቦትን <char style="nd">ዋቀዮ</char> መጋላ ዳዊት ሴኑት ሚካል እንተል ሳኦል ፎዳ ኬሳን እላላ ቱርቴ። እሼንስ አከ ዳዊት ሞትች ፉለ <char style="nd">ዋቀዮ</char> ዱረት ኡታሌ ሹብሱ ዮሙ አርግቴት ገራሼ ኬሰት እሰ ቱፈቴ።<verse eid="2SA 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 6:17"/>እሳንስ ታቦተ <char style="nd">ዋቀዮ</char> ፍደኒ ዱንካነ ዳዊት ዻቤፍ ኬሰ ንካአን፤ ዳዊትስ ኣርሳ ጉበሙፊ ኣርሳ ነጋ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዽኤሴ። <verse eid="2SA 6:17"/><verse number="18" style="v" sid="2SA 6:18"/>እንስ ኤርገ ኣርሳ ጉበሙፊ ኣርሳ ነጋ ዽኤሴ ቦዴ መቃ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡቲን ነሞተ ንኤብሴ። <verse eid="2SA 6:18"/><verse number="19" style="v" sid="2SA 6:19"/>ኤርገሲስ እን ቶኮ ቶኮ ነመ ቱተ እስራኤሎታ ጉቱ ኬሰ ጅሩቲፍ ጄቹንስ ዺሮታፍስ ዱበርቶታፍስ ቡዴነ ቶኮ ቶኮ፣ ጉማ ፎኒ ቶኮ ቶኮፊ ብጥሌ እጀ ወይኒ ቶኮ ቶኮ ንኬኔ። ነሞትን ሁንድኑስ ገረ መነ መነሳኒ ዴመን።<verse eid="2SA 6:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 6:20"/>ዮሙ ዳዊት ማቲ ኦፊሳ ኤብሱፍ ዴብኤትስ ሚካል እንተል ሳኦል እሰ ስመቹፍ ባቴ፣ “ሀርአ ሞቲን እስራኤል አከ ነመ ገቲ ህንቀብኔ ቶኮት ፉለ ጦምቦሬወን ሆጄቶተሳ ዱረት ቁላ አርገሙንሳ ኡልፍነ ተኤት ሞ!” ጄቴ።<verse eid="2SA 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 6:21"/>ዳዊትሞ ሚካሊን አከነ ጄዼ፤ “አን ፉለ <char style="nd">ዋቀዮ</char> እሰ አባኬቲፊ ወረ መነሳ ጅረን ጫልችሴ ነ ፍለቴ ሰበ <char style="nd">ዋቀዮ</char>፣ እስራኤልረት ነ ሙዴ ሰናፍ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ነንሹብሰ። <verse eid="2SA 6:21"/><verse number="22" style="v" sid="2SA 6:22"/>አን ከነ ጫላዩ ኦፍን ጥኔሰ፤ እጀኬ ዱረትስ ኦፍ ነንሰልጵሰ። ጦምቦሬወን አት ጄቴ ከኔኒን ገሩ ነንከበጀመ።”<verse eid="2SA 6:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 6:23"/>ሚካል እንተል ሳኦል ኡቱ እጆሌ ህንአርገን ዱቴ።<verse eid="2SA 6:23"/></para>
  <chapter eid="2SA 6"/>
  <chapter number="7" style="c" sid="2SA 7"/>
  <para style="s1">አብዲ ዋቀዮ ዳዊቲፍ ኬኔ</para>
  <para style="r">
    <ref loc="2SA 7:1-17">7፥1‑17</ref> ኩወፈ – <char style="xt"><ref loc="1CH 17:1-15">1ሴና 17፥1‑15</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 7:1"/>ሞትች ኤርገ መሰራሳ ኬሰ ጅራቹ ጀልቀቤ <char style="nd">ዋቀዮ</char> ዲኖተሳ ከኔን ናኖሳ ጅረን ሁንደ ጀላ እሰ ቦቆቺሴ ቦዴ፣ <verse eid="2SA 7:1"/><verse number="2" style="v" sid="2SA 7:2"/>ናታን ራጅቻን፣ “አን ኩኖ መነ ብርብርሳን እጃረሜኬሰን ጅራዸ፤ ታቦትን ዋቃ ገሩ ዱንካነ ኬሰ ጅራተ” ጄዼ።<verse eid="2SA 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 7:3"/>ናታንሞ ሞትቻን፣ “<char style="nd">ዋቀዮ</char> ስ ወጅን ጅራቲ ዋን ገራኬት ያዴ ከምዩ ጎዽ” ጄዼ።<verse eid="2SA 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 7:4"/>ሀልከን ሰነ ገሩ ዱቢን <char style="nd">ዋቀዮ</char> አከነ ጄዼ ገረ ናታን ዹፌ፦<verse eid="2SA 7:4"/></para>
  <para style="pm">
    <verse number="5" style="v" sid="2SA 7:5"/>“ዸቂቲ አከነ ጄዺ ገርብቸኮ ዳዊትት ህም፤ ‘<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ ከን መነ አን ኬሰ ጅራዹ ናፍ እጃሩ ስኢ? <verse eid="2SA 7:5"/><verse number="6" style="v" sid="2SA 7:6"/>አን ጋፈን እስራኤሎተ ግብጢ ባሴ ጀልቀቤ ሀመ ሀርኣት መነ ኬሰ ህንጅራትኔ። አን እዶ ጅሬኘኮ ዱንካነ ጎዸዼ እዶ ቶኮ ገረ እዶ ብራ ናነኣን ቱሬ። <verse eid="2SA 7:6"/><verse number="7" style="v" sid="2SA 7:7"/>አን እዶን እስራኤሎተ ሁንደ ወጅን ናነኣ ቱሬ ከምትዩ ቡልችቶተ አከ እሳን ሰበኮ እስራኤልን ኤገኒፍ አጀጄ ኬሳ ነመ ቶኮንዩ፣ “እስን ማሊፍ መነ ብርብርሳ ናፍ ህንእጃሬ?” ጄዼ ቤካ?’<verse eid="2SA 7:7"/></para>
  <para style="pm">
    <verse number="8" style="v" sid="2SA 7:8"/>“ኤጋ አመ አከነ ጄዺ ገርብቸኮ ዳዊትት ህም፤ ‘<char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ አከነ ጄዸ፦ አን አከ አት ቡልቻ ሰበኮ እስራኤል ታቱፍ ለፈ ትካቲፊ ቡሻዬ ፋነ ዴሙ ኬሳን ስ ፉዸዼ። <verse eid="2SA 7:8"/><verse number="9" style="v" sid="2SA 7:9"/>አን ለፈ አት ዸቅጤ ሁንደት ስ ወጅንን ቱሬ፤ ዲኖተኬ ሁንደስ ፉለኬ ዱራ በሌሴረ። አመስ አን መቃኬ አኩመ መቃ ነሞተ አዱኛረት አከ መሌ ጉርጉዳ ተአኒ ጉዳ ነንጎዸ። <verse eid="2SA 7:9"/><verse number="10" style="v" sid="2SA 7:10"/>አን አከ እሳን መነ ኦፊሳኒ ቀባተኒፊ ስአች ህንራፈምኔፍ ሰበኮ እስራኤሊፍ ለፈ ኬኔ እሳን ነንዻበ። ነሞትን ሀሞን አከ ጀልቀበት ጎዸን ሰነ ዴብአኒ እሳን ህንጩንቁርሰን፤ <verse eid="2SA 7:10"/><verse number="11" style="v" sid="2SA 7:11"/>እሳን ስአች ዋን ጋፈ አን ሰበኮ እስራኤልረት አቦቲ ሙርቲ ሙዴ አስ ጎዸን ሰነሌ ህንጎዸን። አን ዲኖተኬ ሁንደ ጀላስ ስን ቦቆቺሰ።</para>
  <para style="pm" vid="2SA 7:11">“ ‘አከ <char style="nd">ዋቀዮ</char> መታንሳ መነ ሲፍ እጃሩ <char style="nd">ዋቀዮ</char> ስት ንህመ፤ <verse eid="2SA 7:11"/><verse number="12" style="v" sid="2SA 7:12"/>ዮሙ በር ጅሬኘኬቲ ዹሜ አት አቦቲኬ ወጅን ቦቆቱት አን አከ እን እዶኬ ቡኡፍ ሰኚኬ ከን ጉዴደኬቲ በኡ ነንካሰ፤ ሞቱማሳሌ ጀቤሴ ነንዻበ። <verse eid="2SA 7:12"/><verse number="13" style="v" sid="2SA 7:13"/>ከን መቃኮቲፍ መነ እጃሩ እሰ፤ አንስ ቴሶ ሞቱማሳ በረ በራን ጀቤሴ ነንዻበ። <verse eid="2SA 7:13"/><verse number="14" style="v" sid="2SA 7:14"/>አን እሳፍ አባ ነንተአ፤ እንስ እልመ ና ተአ። ዮሙ እን በሌሳ ሆጄቱትስ ኡሌ ነሞታቲን እሰ ነንአደበ፤ አለንጌ እልማን ነማ እቲን ገረፈመኒንስ ነንገረፈ። <verse eid="2SA 7:14"/><verse number="15" style="v" sid="2SA 7:15"/>ጃለልኮ ገሩ አከ ጃለለ አን ሳኦል እሰ አን ፉለኬ ዱራ በሌሴ ሰነራ ፉዸዼ እሰራ ህንፉዸተሙ። <verse eid="2SA 7:15"/><verse number="16" style="v" sid="2SA 7:16"/>መኒፊ ሞቱማንኬ በረ በራን ፉለኮ ዱረ ንጅራተ፤ ቴሶንኬስ በረ በራን ጀባቴ ንዻበተ።’ ”<verse eid="2SA 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 7:17"/>ናታንስ ዱቢ ሙልአተ ከና ሁንደ ዳዊትት ህሜ።<verse eid="2SA 7:17"/></para>
  <para style="s1">ዳዊት ዋቀ ከዸቹሳ</para>
  <para style="r">
    <ref loc="2SA 7:18-29">7፥18‑29</ref> ኩወፈ – <char style="xt"><ref loc="1CH 17:16-27">1ሴና 17፥16‑27</ref></char></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 7:18"/>ኤርገሲ ዳዊት ሞትች ኦል ሴኔ ፉለ <char style="nd">ዋቀዮ</char> ዱረ ታኤ አከነ ጄዼ፦</para>
  <para style="pm" vid="2SA 7:18">“ያ <char style="nd">ዋቀዮ</char> ጎፍታ፣ ከን አት አሲን ነ ጌሴ አን ኤኙ? ማቲንኮስ ማል? <verse eid="2SA 7:18"/><verse number="19" style="v" sid="2SA 7:19"/>ያ <char style="nd">ዋቀዮ</char> ጎፍታ፣ አከ ዋን ወን ኩን ፉለኬ ዱረት ገኣ ህንተእኒት አት ዋኤ መነ ገርብቸኬቲ ከን ፉል ዱረት ተኡስ ዱበቴ። ያ <char style="nd">ዋቀዮ</char> ጎፍታ፣ ኤዳ ወልት ዹፌኝ አት ነሞተ ወጅን ቀብዱ ከና?<verse eid="2SA 7:19"/></para>
  <para style="pm">
    <verse number="20" style="v" sid="2SA 7:20"/>“ዳዊት ከነ ጫላ ማል ጄቹ ደንደአ? ያ <char style="nd">ዋቀዮ</char> ጎፍታ፣ አት ገርብቸኬ ንቤክታቲ። <verse eid="2SA 7:20"/><verse number="21" style="v" sid="2SA 7:21"/>አት ሰበቢ ዱቢኬቲቲፊ አኩመ ፌዺኬቲት ዋን ጉዳ ከነ ሆጄቴ አከ ገርብችኬ ቤኩ ጎቴ።<verse eid="2SA 7:21"/></para>
  <para style="pm">
    <verse number="22" style="v" sid="2SA 7:22"/>“ያ <char style="nd">ዋቀዮ</char> ጎፍታ፣ አት አከም ጉዳዸ! ከን አከኬቲ ቶኮዩ ህንጅሩ፤ አከ ኑ ጉሩመኬኛን ዸጌኜት ስ መሌ ዋቅን ብራ ህንጅሩ። <verse eid="2SA 7:22"/><verse number="23" style="v" sid="2SA 7:23"/>ሰብን አከ ሰበኬ እስራኤል፣ ከን ዋቅን አከ እን ሰበሳ ተኡፍ መቃ ኦፊሳ ዻበቹፍ ጄዼ እሰ ፉሩፍ ሰቦተ ኦርማቲፊ ዋቆተሳኒሌ ፉለሳ ዱራ አርኡዻን ድንቂወን ጉርጉዳፊ ሶዳችሳ አርግሲሱዻን በኤ ብየ ግብጢ ፉሬ ባሴ ከን ብራ ለፈራ ከሚዸ? <verse eid="2SA 7:23"/><verse number="24" style="v" sid="2SA 7:24"/>አት ሰበኬ እስራኤልን ከን ኦፊኬቲ ጎቴ በረ በራን ዻብዴርተ፤ ያ <char style="nd">ዋቀዮ</char> አት ዋቀሳኒ ታቴርተ።<verse eid="2SA 7:24"/></para>
  <para style="pm">
    <verse number="25" style="v" sid="2SA 7:25"/>“አመስ ያ <char style="nd">ዋቀዮ</char>፣ ያ ዋቅ፣ አት ዋዳ ገርብቸኬቲፊ መነሳቲፍ ገልቴ ሰነ በረ በራን ኤግ። ከነስ አኩመ ዋዳ ገልቴ ሰነ ራወዹ፤ <verse eid="2SA 7:25"/><verse number="26" style="v" sid="2SA 7:26"/>ኩንስ አከ መቃንኬ በረ በራን ጉዳ ተኡፍ። ከነረት ነሞትን፣ ‘<char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ እስራኤልረት ዋቀ!’ ንጄዹ። መን ገርብቸኬ ዳዊትስ ፉለኬ ዱረት ጀባቴ ንዻበተ።<verse eid="2SA 7:26"/></para>
  <para style="pm">
    <verse number="27" style="v" sid="2SA 7:27"/>“ያ <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንዴሱ፣ ዋቀ እስራኤል አት፣ ‘አን መነ ሲፍ ነንእጃረ’ ጄቴ ገርብቸኬት ዋን ከነ ሙልእፍቴርተ፤ ከናፉ ገርብችኬ ከዸትና ከነ ስት ዽኤሱፍ እጀ ጀብነ አርገቴረ። <verse eid="2SA 7:27"/><verse number="28" style="v" sid="2SA 7:28"/>ያ <char style="nd">ዋቀዮ</char> ጎፍታ፣ አት ዋቀ! ዱቢንኬ አመነማዸ፤ አትስ ዋን ጋሪ ከነ ገርብቸኬቲፍ ዋዳ ገልቴርተ። <verse eid="2SA 7:28"/><verse number="29" style="v" sid="2SA 7:29"/>አከ መንሳ በረ በራን ጀባቴ ፉለኬ ዱረ ዻበቱፍ አመስ መነ ገርብቸኬቲ ኤብሱን ፌዺኬ ሃተኡ፤ ያ <char style="nd">ዋቀዮ</char> ጎፍታ፣ አት ዱበቴርታቲ፤ ኤበኬቲንስ መን ገርብቸኬቲ በረ በራን ንኤብፈመ።”<verse eid="2SA 7:29"/></para>
  <chapter eid="2SA 7"/>
  <chapter number="8" style="c" sid="2SA 8"/>
  <para style="s1">ሞአኖወን ዳዊት</para>
  <para style="r">
    <ref loc="2SA 8:1-14">8፥1‑14</ref> ኩወፈ – <char style="xt"><ref loc="1CH 18:1-13">1ሴና 18፥1‑13</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 8:1"/>ኤርገሲ ዳዊት ፍልስጤሞተ ሞአቴ ኦፍ ጀለ እሳን ገልፈቴ፤ መጋላ ሜቴግ አማ ጄዸምቱስ ሀርከ ፍልስጤሞታቲ ባሴ ፉዸቴ።<verse eid="2SA 8:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 8:2"/>ዳዊት ሞኣቦተስ ንሞአቴ። ለፈረ ተሬ ጪብሴስ ፉኞን እሳን ሰፈሬ። ከኔን ተሬ ገለን ኬሳስ ፉኞ ለመ ለመ ሰፈሬ አጄሴ፤ ከኔን ፉኞ ቶኮ ቶኮ ሰፈሬሞ አከ እሳን ጅራተን ኤየሜፍ። ከናፉ ሞኣቦን ዳዊት ጀለት ቡለኒ ግብረ ፍደኒፍ።<verse eid="2SA 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 8:3"/>ከነረትስ ዳዊት ዬሮ ለገ ኤፍራጢስ ብረ ያደኖ ኦፊ ዴብሴ ዻበቹ ዸቄት ሞትቸ ዞባ፣ ሀዳዴዜር እልመ ሬሆብ ሞአቴ። <verse eid="2SA 8:3"/><verse number="4" style="v" sid="2SA 8:4"/>ዳዊትስ ጋሪወን ወራናሳ ኩመ ቶኮ፣ አቦቲ ፈርዳ ኩመ ቶርባፊ ሎልቶተ ለፎ ኩመ ድግደመ እሰራ ፉዸቴ። እንስ ፈርዴን ጋሪወኒ ዽበ ቶኮ ቆፈ ሀምብሴ ከኔን ሀፈን ሁንደ ሞጎሌ ኩኩቴ።<verse eid="2SA 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 8:5"/>ዬሮ ወር ሶርያ ከኔን ደማስቆ ጅራተን ሀዳዴዜር ሞትቸ ዞባ ገርጋሩፍ ዹፈንትስ ዳዊት እሳን ኬሳ ነመ ኩመ ድግደሚ ለመ ፍጤ። <verse eid="2SA 8:5"/><verse number="6" style="v" sid="2SA 8:6"/>ኤርገሲስ ኩታ ቡልቺንሰ ደማስቆ ከን ብየ ሶርያ ኬሰ ቁበተ ሎልቶታ ዻበቴ። ወር ሶርያስ እሰ ጀለት ቡለኒ ግብረ ፍደኒፍ። <char style="nd">ዋቀዮስ</char> ዳዊቲፍ ለፈ እን ዸቄ ሁንደት ሞእቸ ኬኔ።<verse eid="2SA 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 8:7"/>ዳዊትስ ጋቸነ ወርቄ ከን አጀጆትን ሎልቶተ ሀዳዴዜር ቀበተን ፉዸቴ ገረ ዬሩሳሌም ፍዴ። <verse eid="2SA 8:7"/><verse number="8" style="v" sid="2SA 8:8"/>ዳዊት ሞትች መጋላወን ሀዳዴዜር ጄቹንስ ቤጣቲፊ ቤሮታይ ኬሳ ስቢለ ናሲ አከ መሌ ባይኤ ፉዸቴ።<verse eid="2SA 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 8:9"/>ቶኢን ሞቲን ሀማት ዮሙ አከ ዳዊት ጉቱማ ሎልቶተ ሀዳዴዜር ሞአቴ ዸገኤት፣ <verse eid="2SA 8:9"/><verse number="10" style="v" sid="2SA 8:10"/>አከ እን ሰበቢ ሞአትና ዳዊት ሞትች ቶኢን ወል ሎላ ቱሬ ሱን ወራነ ኬሰት ሀዳዴዜር እረት አርገቴቲፍ ሀርከ እሰ ፉዼ ዻምሰ ገመቹ እሳፍ ደበርሱፍ እልመ ኦፊሳ ዮራምን ገረሳት ኤርጌ። ዮራምስ ኬናወን ሜቲራ፣ ወርቄፊ ናሲራ ሆጄተመን ፍዴ።<verse eid="2SA 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 8:11"/>ዳዊት ሞትችስ አኩመ ሜቲፊ ወርቄ ሰቦተ ብራ ከኔን ኦፍ ጀለ ገልፈቱ ሁንደራ ቦጅኤ ቱሬ ጎዼ ሰነ ምኦተ ከኔንሌ <char style="nd">ዋቀዮፍ</char> አዳን ባሴ። <verse eid="2SA 8:11"/><verse number="12" style="v" sid="2SA 8:12"/>ወር እን ኦፍ ጀለ ገልፈቴስ ኤዶም፣ ሞኣብ፣ አሞኖተ፣ ፍልስጤሞታፊ አማሌቅ ቱረን። ቦጁ ሀዳዴዜር እልመ ሬሆብ ሞትቸ ዞባራ ቦጅኤስ አከሱመ አዳን ባሴ።<verse eid="2SA 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 8:13"/>ዳዊትስ ኤርገ ሱሉለ ሶግዳ ኬሰት ኤዶሞተ ኩመ ኩዸ ሰዴት ፍጤ ዴብኤ ቦዴ ቤከማ ተኤ።<verse eid="2SA 8:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 8:14"/>እንስ ጉቱማ ኤዶም ኬሰ ቁበተ ሎልቶታ ዻበቴ፤ ኤዶሞን ሁንድኑስ ዳዊቲፍ ንገርቦመን። <char style="nd">ዋቀዮስ</char> ለፈ እን ዸቄ ሁንደት ዳዊቲፍ ሞአትና ንኬኔ።<verse eid="2SA 8:14"/></para>
  <para style="s1">ቆንዳልቶተ ዳዊት</para>
  <para style="r">
    <ref loc="2SA 8:15-18">8፥15‑18</ref> ኩወፈ – <char style="xt"><ref loc="1CH 18:14-17">1ሴና 18፥14‑17</ref></char></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 8:15"/>ዳዊት ጉቱማ እስራኤልረት ሞቲ ተኤ ሰበሳ ሁንዳፍ ሙርቲ ቀጄላፊ ቀጄሉማዻን ሆጄቴ። <verse eid="2SA 8:15"/><verse number="16" style="v" sid="2SA 8:16"/>ዮኣብ እልም ዜሩያ ሆገና ሎልቶታ ቱሬ፤ ዬሆሻፋጥ እልም አሂሉድሞ ገልሜሳ ቱሬ። <verse eid="2SA 8:16"/><verse number="17" style="v" sid="2SA 8:17"/>አከሱመስ ዛዶቅ እልም አሂጡቢፊ አቢሜሌክ እልም አብያታር ሉቦተ ቱረን፤ ሴራያንሞ በሬሳ ቱሬ። <verse eid="2SA 8:17"/><verse number="18" style="v" sid="2SA 8:18"/>ቤናያ እልም ዬሆያዳ ሆገና ኬሬቶታፊ ጴሌቶታ ቱሬ፤ እልማን ዳዊትሞ ሉቦተ ቱረን።<verse eid="2SA 8:18"/></para>
  <chapter eid="2SA 8"/>
  <chapter number="9" style="c" sid="2SA 9"/>
  <para style="s1">ዳዊቲፊ ሜፊቦሼት</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 9:1"/>ዳዊትስ፣ “አከ አን ዮናታኒፍ ጄዼ አርጁማ እሳፍ ጎዹ ነምን ማቲ ሳኦል ኬሳ ሀፌ አመ ጅራ?” ጄዼ ጋፈቴ።<verse eid="2SA 9:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 9:2"/>ዬሮ ሰነት ነምቸ ዚባ ጄዸሙ ተጃጅላ መነ ሳኦል ቶኮቱ ቱሬ። እንስ አከ ፉለ ዳዊት ዱረት ዽኣቱፍ ዋመሜ፤ ሞትችስ፣ “አት ዚባዻ?” ጄዼን።</para>
  <para style="p" vid="2SA 9:2">እንስ፣ “ኤዬ፣ አነ ገርብቸኬት” ጄዼ።<verse eid="2SA 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 9:3"/>ሞትችስ፣ “አከ አን አርጁማ ዋቃ እሳፍ ጎዹፍ ነምን ማቲ ሳኦል ኬሳ ሀፌ ቶኮዩ ህንጅሩ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="2SA 9:3">ዚባ፣ “እልም ዮናታን ቶኮ ጅረ፤ ሚልሳ ለቹስ ናፈ” ጄዼ ሞትቻፍ ዴብሴ።<verse eid="2SA 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 9:4"/>ሞትችስ፣ “እን ኤሰ ጅረ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="2SA 9:4">ዚባን ዴብሴ፣ “እን እዶ ሎዴባር ጄዸሙ መነ ማኪር እልመ አሚኤል ጅረ” ጄዼ።<verse eid="2SA 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 9:5"/>ከናፉ ዳዊት ሞትች ነመ ኤርጌ ሎዴባር መነ ማኪር እልመ አሚኤሊቲ እሰ ፍችሲሴ።<verse eid="2SA 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 9:6"/>ሜፊቦሼት እልም ዮናታን፣ እልም ሳኦል ዬሮ ዳዊት ብረ ዹፌት ኡልፍነ እሳፍ ኬኑፍ ገድ ጄዼ ሰገዴፍ።</para>
  <para style="p" vid="2SA 9:6">ዳዊትሞ፣ “ሜፊቦሼት!” ጄዼን።</para>
  <para style="p" vid="2SA 9:6">እንስ፣ “ገርብችኬ ኩኖት” ጄዼ ዴብሴፍ።<verse eid="2SA 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 9:7"/>ዳዊትስ፣ “አን አባኬ ዮናታኒፍ ጄዼ አርጁማ ሲፍን ጎዻቲ ህንሶዳትን። አን ለፈ አካከዩኬቲ፣ ለፈ ሳኦል ሁንደ ሲፍን ዴብሰ፤ አትስ ዬሮ ሁንደ ማዲኮራ ኛተ” ጄዼን።<verse eid="2SA 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 9:8"/>ሜፊቦሼትስ ሀርከ ፉዼ፣ “አነ ገርብቸኬ ነመ አከ ሰሬ ዱኤት እላለሙፍ ዋን ከነ ጎቹንኬ ማሊፍ?” ጄዼን።<verse eid="2SA 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 9:9"/>ሞትችስ ዚባ ገርብቸ ሳኦል ኦፍት ዋሜ አከነ ጄዼን፤ “አን እልመ እልመ ጎፍታኬቲቲፍ፣ ዋን ከን ሳኦሊፊ ከን ማቲሳ ተኤ ሁንደ ኬኔረ። <verse eid="2SA 9:9"/><verse number="10" style="v" sid="2SA 9:10"/>አት፣ እልማንኬቲፊ ተጃጅልቶትንኬ አከ እልም እልመ ጎፍታኬቲ ዋን ኛቱ አርገቱፍ ለፈ እሳፍ ቆቱ ቀብዱ። ሜፊቦሼት እልም እልመ ጎፍታኬቲስ ዬሮ ሁንደ ማዲኮራ ኛተ።” ዚባን እልማን ኩዸ ሸኒፊ ተጃጅልቶተ ድግደመ ቀበ ቱሬ።<verse eid="2SA 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 9:11"/>ዚባንስ ሞትቻን፣ “አን ገርብችኬ ዋን ጎፍታንኮ ሞትች አከ አን ሆጄዹፍ ነ አጀጁ ሁንደ ነንጎዸ” ጄዼ። ከናፉ ሜፊቦሼት አኩመ እልማን ሞቲ ኬሳ ነመ ቶኮት ማዲ ዳዊትራ ኛተ ቱሬ።<verse eid="2SA 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 9:12"/>ሜፊቦሼት እልመ ደርገጌሰ ሚካ ጄዸሙ ቶኮ ቀበ ቱሬ፤ ወር መነ ዚባ ጅራተን ሁንድ ሆጄቶተ ሜፊቦሼት ቱረን። <verse eid="2SA 9:12"/><verse number="13" style="v" sid="2SA 9:13"/>ሜፊቦሼትስ ሰበቢ ዬሮ ሁንደ ማዲ ሞቲራ ኛቻ ቱሬፍ ዬሩሳሌም ኬሰ ጅራተ ቱሬ፤ ሚልሳ ለቹ ናፈ ቱሬ።<verse eid="2SA 9:13"/></para>
  <chapter eid="2SA 9"/>
  <chapter number="10" style="c" sid="2SA 10"/>
  <para style="s1">ዳዊት አሞኖተ ሞአቹሳ</para>
  <para style="r">
    <ref loc="2SA 10:1-19">10፥1‑19</ref> ኩወፈ – <char style="xt"><ref loc="1CH 19:1-19">1ሴና 19፥1‑19</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 10:1"/>ኤርገሲስ ሞቲን አሞኖታ ንዱኤ፤ እልምሳ ሃኑንስ እዶሳ ቡኤ ሞቲ ተኤ። <verse eid="2SA 10:1"/><verse number="2" style="v" sid="2SA 10:2"/>ዳዊትስ፣ “አኩመ አባንሳ ና አርጆሜ ሰነ አንስ ሃኑን እልመ ናሃሺፍ ነንአርጆመ” ጄዼ ያዴ። ከናፉ ዳዊት ገደ ዋኤ አባሳቲፍ እት ዸገአሜ እሳ እብሱፍ ሃኑንት ኤርገሞተ ንኤርጌ።</para>
  <para style="p" vid="2SA 10:2">ዮሙ ነሞትን ዳዊት ገረ ብየ አሞኖታ ዸቀንት፣ <verse eid="2SA 10:2"/><verse number="3" style="v" sid="2SA 10:3"/>ቆንዳልቶትን አሞኖታ ሃኑን ጎፍታ እሳኒቲን፣ “አት ሰበቢ ዳዊት አከ እሳን ዻምሰ ገዳ ስት ህመኒፍ ነሞተ ስት ኤርጌፍ እን ዋን አባኬቲፍ ኡልፍነ ኬኔ ሴታ? ዳዊት አከ እሳን መጋለቲ ቆረተኒ፣ በሳሰኒፊ ቀበተኒፍ ገረኬ እሳን ኤርጌ ምቲ?” ጄዸን። <verse eid="2SA 10:3"/><verse number="4" style="v" sid="2SA 10:4"/>ከናፉ ሃኑን ነሞተ ዳዊት ሰነ ቀቀቤ ቶኮ ቶኮሳኒራ ሀሬደ ገመ ቶኮ ሃዴ ወያሳኒሌ ቴሱመረት ጭጭሬ ኦፍራ እሳን ኤርጌ።<verse eid="2SA 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 10:5"/>ዳዊት ዮሙ ወን ኩን እሰት ህመሜት ሰበቢ እሳን አከ መሌ ቃነአኒፍ ነሞተ ሰነት ኤርገሞተ ኤርጌ። ሞትችስ፣ “እስን ሀመ አሬድንኬሰን እስኒ ጉደቱት ዬርኮ ቱራቲ ኤርገሲ ዴብኣ ኮታ” ጄዼን።<verse eid="2SA 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 10:6"/>አሞኖትን ዮሙ አከ ዳዊት እሳን ጥሬፈቴ ሁበተንት፣ ቤት ሬሆቢፊ ሱባዻ ሎልቶተ ለፎ ከን ሶርያ ኩመ ድግደመ፣ ሞቲ መአካ ነሞተ ኩመ ቶኮ ወጅን አከሱመስ ጦብራ ነሞተ ኩመ ኩዸ ለመ ቀጠረተን።<verse eid="2SA 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 10:7"/>ዳዊት ዮሙ ዋን ከነ ዸገኤት ዮኣቢፊ ጉቱማ ሎልቶታ ንኤርጌ። <verse eid="2SA 10:7"/><verse number="8" style="v" sid="2SA 10:8"/>አሞኖትንሞ በአኒ ከረ መጋላ ሰናረት ወራናፍ ህሪረን፤ ነሞትን ሶርያ ወር ሱባፊ ሬሆብ፣ አከሱመስ ነሞትን ጦቢቲፊ መአካሞ ኮጳሳኒ ድሬረ ቱረን።<verse eid="2SA 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 10:9"/>ዮኣብስ አከ ፉለሳ ዱራፊ ዱግደሳ ዱባን ወራን ጅሩ ንአርጌ፤ ከናፉ ሎልቶተ እስራኤል ኬሳ ነሞተ ቤቤከሞ ፍለቴ አደ ሎልቶትን ሶርያ ጅረንት ቦባሴ። <verse eid="2SA 10:9"/><verse number="10" style="v" sid="2SA 10:10"/>ነሞተ ሀፈንሞ አጀጀ ኦቦሌሰሳ አቢሻይ ጀለት ህሪርሴ አሞኖተት እሳን ዱልችሴ። <verse eid="2SA 10:10"/><verse number="11" style="v" sid="2SA 10:11"/>ዮኣብስ አከነ ጄዼ፤ “ዮ ወር ሶርያ ነት ጀባተን አት ዹፍቴ ነ ገርጋርተ፤ ዮ አሞኖትን ስት ጀባተንሞ አን ዹፌ ስን ገርጋረ። <verse eid="2SA 10:11"/><verse number="12" style="v" sid="2SA 10:12"/>ጀባዹ፤ ሰበኬኛፊ መጋላወን ዋቀኬኛቲፍ ገራ ኩተናዻን ሃሎሉ። <char style="nd">ዋቀዮስ</char> ዋን ፉለሳ ዱረት ጋሪ ተኤ ንጎዸ።”<verse eid="2SA 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 10:13"/>ኤርገሲ ዮኣቢፊ ሎልቶትን እሰ ወጅን ቱረን ወረ ሶርያ ወራኑፍ ፉል ዱረት ንቀጄለን፤ ጀርስ ፉለሳ ዱራ በቀተን። <verse eid="2SA 10:13"/><verse number="14" style="v" sid="2SA 10:14"/>አሞኖትን ዮሙ አከ ነሞትን ሶርያ በቀተን አርገንት እሳንስ አቢሻይ ዱራ በቀተኒ መጋላ ሴነን። አከሲን ዮኣብ አሞኖተ ወራኑ ዺሴ ዬሩሳሌምት ዴብኤ።<verse eid="2SA 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 10:15"/>ነሞትን ሶርያ ዮሙ አከ እስራኤሎን እሳን ሞአተን አርገንት ለመተ ወልት ቀበመን። <verse eid="2SA 10:15"/><verse number="16" style="v" sid="2SA 10:16"/>ሀዳዴዜርስ ኤርገሞተ ኤርጌ ነሞተ ሶርያ ከኔን ለገ ኤፍራጢሲቲን ገማ ፍችሲሴ፤ እሳንስ ሆገኑማ አጀጃ ወራነ ሀዳዴዜር ከን ሾበክ ጄዸሙን ገረ ሄላም ዴመን።<verse eid="2SA 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 10:17"/>ዳዊትስ ዮሙ ወን ኩን እሰት ህመሜት፣ እስራኤሎተ ሁንደ ወልት ቀበቴ ዮርዳኖስ ጬኤ ሄላም ዸቄ። ወር ሶርያስ ወራናፍ ዳዊትት ህሪረኒ እሰ ሎለን። <verse eid="2SA 10:17"/><verse number="18" style="v" sid="2SA 10:18"/>እሳን ገሩ እስራኤሎተ ዱራ በቀተን፤ ዳዊትስ ነሞተ ጋሪ ወራና ኦፈን ዽበ ቶርባፊ ሎልቶተ ለፎ ኩመ አፉርተመ ፍጤ። አጀጃ ሎልቶተሳኒ ሾበክሌ መዴሴ፤ እንስ አቹመት ዱኤ። <verse eid="2SA 10:18"/><verse number="19" style="v" sid="2SA 10:19"/>ሞቶትን ሀዳዴዜርን ተጃጅላ ቱረን ሁንድ ዮሙ አከ እስራኤሎታን ሞአተመን አርገንት፣ እስራኤሎተ ወጅን ነጋ ኡመኒ እሰ ጀለት ቡለን።</para>
  <para style="p" vid="2SA 10:19">ከናፉ ነሞትን ሶርያ ኤርገሲ አሞኖተ ገርጋሩ ሶዳተን።<verse eid="2SA 10:19"/></para>
  <chapter eid="2SA 10"/>
  <chapter number="11" style="c" sid="2SA 11"/>
  <para style="s1">ዳዊቲፊ በትሼባ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 11:1"/>ብራ ኬሰ ዬሮ ሞቶትን ወራናፍ በአንት፣ ዳዊት ተጃጅልቶተሳቲፊ ሎልቶተ እስራኤል ሁንደ ወጅን ዮኣብን ኤርጌ። እሳንስ አሞኖተ በርበዴሰኒ መጋላ ረባ ጄዸምቱ መርሰን። ዳዊት ገሩ ዬሩሳሌምት ሀፌ።<verse eid="2SA 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 11:2"/>ጋፍ ቶኮ ገልገለ ዳዊት ስሬሳራ ከኤ በንቲ መሰራ ሞቱማረ አሲፊ አች ዴዴብኣ ቱሬ። እንስ በንቲ ጉባ ዻበቴ ዱበርቲ ዸግነሼ ዽቀቱ ቶኮ አርጌ። ዱበርቲን ሱን ባይኤ በሬዱ ቱርቴ፤ <verse eid="2SA 11:2"/><verse number="3" style="v" sid="2SA 11:3"/>ዳዊትስ ዋኤሼ ቤኩፍ ነመ እት ኤርጌ። ነምች ሱንስ፣ “እሼን በትሼባ እንተለ ኤልኣም፣ ኒቲ ኡርያ ነምቸ ጎሰ ሄት ሰናቲ ምቲ?” ጄዼ። <verse eid="2SA 11:3"/><verse number="4" style="v" sid="2SA 11:4"/>ዳዊትስ ነመ እት ኤርጌ እሼ ፍችሲሴ። እሼንስ ገረሳ ዹፍቴ፤ እንስ እሼ ወጅን ጪሴ። እሼን ጡራኡማሼራ ቁልቁሎፍቴ ቱርቴ። ኤርገሲ ገረ መነሼት ዴብቴ። <verse eid="2SA 11:4"/><verse number="5" style="v" sid="2SA 11:5"/>ዱበርቲን ሱን ኡልፎፍቴ፣ “አን ኡልፋኤረ” ጄቴ ዳዊትት ኤርጋ ኤርግቴ።<verse eid="2SA 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 11:6"/>ከናፉ ዳዊት፣ “ኡርያ ነምቸ ጎሰ ሄት ሰነ ና ኤርግ” ጄዼ ዮኣብት ዻምሰ ኤርጌ። ዮኣብስ ገረ ዳዊትት እሰ ኤርጌ። <verse eid="2SA 11:6"/><verse number="7" style="v" sid="2SA 11:7"/>ዳዊትስ ዮሙ ኡርያን ገረሳ ዹፌት ዋኤ ዮኣብ፣ ዋኤ ሎልቶታቲፊ ሃለ ወራን ኬሰ ጅሩ እሰ ጋፈቴ። <verse eid="2SA 11:7"/><verse number="8" style="v" sid="2SA 11:8"/>ኤርገሲሞ ዳዊት ኡርያን፣ “ገረ መነኬቲት ገድ ቡኢቲ ሚለኬ ዽቀዹ” ጄዼ። ከናፉ ኡርያን መሰራ ሞቲቲ በኤ ዴሜ፤ ኬናን ሞትቻስ እሰ ፋነ ኤርገሜ። <verse eid="2SA 11:8"/><verse number="9" style="v" sid="2SA 11:9"/>ኡርያን ገሩ ተጃጅልቶተ ጎፍታሳ ሁንደ ወጅን ከረ መሰራ ሞቲ ዱረ ጪሴ መሌ ገረ መነ ኦፊሳት ገድ ህንቡኔ።<verse eid="2SA 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 11:10"/>ዳዊትስ ዮሙ አከ ኡርያን ገረ መነሳ ህንዴምን እት ህመሜት፣ “አት ሬፉ ከራዻ ዹፍቴ ምቲ? ማሊፍ ገረ መነኬቲ ህንዴምኔ?” ጄዼ እሰ ጋፈቴ።<verse eid="2SA 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 11:11"/>ኡርያንሞ ዳዊቲን፣ “ታቦትኒፊ እስራኤል፣ ይሁዳንስ ዱንካነ ኬሰ ጅሩ፤ ጎፍታንኮ ዮኣቢፊ ነሞትን ጎፍታኮ ድሬረ ቡሉ። ኤጋ አን አከምት ኛቹፊ ዹጉፍ፣ ኒቲኮ ወጅንስ ረፉፍ ጄዼ ገረ መነኮ ዴመ? ዱአኬት፤ አን ዋን አከሲ ህንጎዹ!”<verse eid="2SA 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 11:12"/>ዳዊት፣ “አት ሀርአስ አስ ቡሊቲ አን ቦር ስን ጌጌሳ” ጄዼን። ከናፉ ኡርያን ጋፈ ሰናፊ ጉያ እት ኣኑ ዬሩሳሌም ኬሰ ቱሬ። <verse eid="2SA 11:12"/><verse number="13" style="v" sid="2SA 11:13"/>ዳዊትስ እሰ አፌሬ፤ እንስ ፉለሳ ዱረት ኛቴ ዹጌ፤ ዳዊትስ እሰ መቼሴ። ኡርያን ገሩ ሀልከን ሰነ አፈተሳረ ተጃጅልቶተ ጎፍታሳ ግዱ ጪሱፍ ገድ በኤ መሌ ገረ መነ ኦፊሳ ህንዴምኔ።<verse eid="2SA 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 11:14"/>ዳዊትስ ለፍት በሪናን ጠለያ በሬሴ ሀርኩመ ኡርያቲን ዮኣብት ኤርጌ። <verse eid="2SA 11:14"/><verse number="15" style="v" sid="2SA 11:15"/>ጠለይቸ ኬሰትስ፣ “እዶ ወራን እት ጭሜት ኡርያ ረመድ። አከ እን አችት ዸአሜ ዱኡፍስ እሰ ዺሳ ዱበት ዴብኣ” ጄዼ በሬሴ።<verse eid="2SA 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 11:16"/>ከናፉ ዮኣብ ኡቱ መጋለቲ መርሳ ጅሩ እዶ አከ ሎልቶትን ጭጭሞን ጅረን ቤኬት ኡርያ ረመዴ። <verse eid="2SA 11:16"/><verse number="17" style="v" sid="2SA 11:17"/>ዮሙ ነሞትን መጋላ ሰና እት ገድ በአኒ ዮኣብን ሎለንት፣ ሎልቶተ ዳዊት ኬሳ ነሞትን ቶኮ ቶኮ ዱአን፤ ኡርያን ነምች ጎሰ ሄት ሱንስ ንአጄፈሜ።<verse eid="2SA 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 11:18"/>ዮኣብስ ጉቱማ ኦዱ ዋኤ ሎለ ሰና ዳዊቲፍ ኤርጌ። <verse eid="2SA 11:18"/><verse number="19" style="v" sid="2SA 11:19"/>አከነ ጄዼስ ኤርገማ ሰነ አጀጄ፤ “ዮሙ አት ዋኤ ወራነ ከና ሞትቸት ህምቴ ፍጡት፣ <verse eid="2SA 11:19"/><verse number="20" style="v" sid="2SA 11:20"/>ኣሪን ሞትቻ ንቦበአ፤ እንስ አከነ ጄዼ ስ ጋፈቹ ደንደአ፤ ‘እስን ማሊፍ ሎሉፍ አከስ መጋላ ሰነት ዽኣተን? እስን አከ እሳን ደላራ ጥየ እስንት ደርበተን ህንቤክኔ? <verse eid="2SA 11:20"/><verse number="21" style="v" sid="2SA 11:21"/>ኤኙቱ አቢሜሌክ እልመ ይሩቤሼት ሰነ አጄሴ? ዱበርቲን ቶኮ ደላራ መጂ ዸጋ ዳኩ እት ገድ ዺፍቴ ቴቤስት እሰ ህንአጄፍኔ? እስን ማሊፍ አከስ ደላ ሰነት ዽኣተን?’ ዮ እን ዋን ከነ ስ ጋፈቴ፣ ‘ተጃጅላንኬ ኡርያን ነምች ጎሰ ሄት ሱንስ ዱኤረ’ ጄዺ እት ህም።”<verse eid="2SA 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 11:22"/>ኤርገማን ሱንስ ከኤ ዴሜ ዮሙ አች ገኤት ዋን ዮኣብ አከ እን እት ህሙ እሰ አጀጄ ሁንደ ዳዊትት ህሜ። <verse eid="2SA 11:22"/><verse number="23" style="v" sid="2SA 11:23"/>ኤርገማን ሱን ዳዊቲን አከነ ጄዼ፤ “ነሞትን ኑት ጀባተኒ ድሬት ገድ ኑት በአን፤ ኑስ አሪኔ ገረ ከረ መጋለቲት እሳን ዴብፍኔ። <verse eid="2SA 11:23"/><verse number="24" style="v" sid="2SA 11:24"/>ኤርገሲስ ወር ጥየ ደርበተን ደላራ ተጃጅልቶተኬት ደርበተን፤ ነሞትን ሞቲ ቶኮ ቶኮስ ንዱአን። ተጃጅላንኬ ኡርያን ነምች ሄት ሱንስ ንዱኤ።”<verse eid="2SA 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 11:25"/>ዳዊትስ ኤርገማ ሰናን፣ “ኤጋ አከነ ጄዺ ዮኣብት ህም፤ ‘ወን ኩን አብዲ ስ ህንኩተቺስን፤ ጎራዴን ዬሮ ቶኮ እሰ ቶኮ፣ ዬሮ ካንሞ ከን ብራ ኛተ። ጭምሲ መጋለቲ ዸኢቲ በሌስ።’ ዋን ከነስ ዮኣብን ጀጀቤሱፍ ጄዽ” ጄዼ።<verse eid="2SA 11:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 11:26"/>ኒቲን ኡርያ ዮሙ አከ ዽርስሼ ዱኤ ዸጌሴት ንቦሴፍ። <verse eid="2SA 11:26"/><verse number="27" style="v" sid="2SA 11:27"/>ኤርገ ዬሮን ቦእቻ ደርቤ ቦዴ ዳዊት መነ ኦፊሳት እሼ ፉዸቴ፤ እሼንስ ኒቲሳ ታቴ እልመ ዴሴፍ። ገሩ ወን ዳዊት ሆጄቴ ሱን <char style="nd">ዋቀዮ</char> ህንገመቺስኔ።<verse eid="2SA 11:27"/></para>
  <chapter eid="2SA 11"/>
  <chapter number="12" style="c" sid="2SA 12"/>
  <para style="s1">ናታን ዳዊትን እፈቴ</para>
  <para style="r">
    <ref loc="2SA 11:1">11፥1</ref>፤ <ref loc="2SA 12:29-31">12፥29‑31</ref> ኩወፈ – <char style="xt"><ref loc="1CH 20:1-3">1ሴና 20፥1‑3</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 12:1"/>
    <char style="nd">ዋቀዮስ</char> ናታንን ገረ ዳዊትት ኤርጌ። እንስ ገረ ዳዊት ዹፌ አከነ ጄዼ፤ “ነሞተ ለመቱ መጋላ ቶኮ ኬሰ ጅራተ ቱሬ፤ እን ቶኮ ሶሬሰ፣ ካንሞ ህዬሰ ቱሬ። <verse eid="2SA 12:1"/><verse number="2" style="v" sid="2SA 12:2"/>ነምች ሶሬስ ሱን ሆሎታፊ ሎን አከ መሌ ባይኤ ቀበ ቱሬ፤ <verse eid="2SA 12:2"/><verse number="3" style="v" sid="2SA 12:3"/>ነምች ህዬስ ሱን ገሩ ጎሮምቲ ሆላ ከን ብተቴ ጥኖ ቶኮ መሌ ሆማ ህንቀቡ ቱሬ፤ እንስ ጎሮምቲ ሆላ ሰነ ንኩኑንሴ፤ ሆላን ሱንስ እሳፊ እጆሌሳ ብረት ጉደቴ። እሼን ኛተሳራ ኛቻ፣ ዹጋቲሳራ ዹጋ፣ ቦባሳ ጀለ ጪሳ ቱርቴ። ጎሮምቲን ሆላ ኩን እሳፍ አኩመ እንተለሳ ቱርቴ።<verse eid="2SA 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 12:4"/>“ጋፍ ቶኮ ኬሱማን ቶኮ መነ ነምቸ ሶሬሰ ሰና ዹፌ፤ ነምች ሶሬስ ሱንስ ሆሎተ ዮካን ሎን ኦፊሳ ኬሳ ቶኮ ፉዼ ኬሱምቻፍ ኛተ ቆጴሱ መረርሲፈቴ። ቆደ ከና እልሞ ሆላ ነምቸ ህዬሰ ሰና ፉዼ ኬሱማ መነሳ ዹፌ ሰናፍ ቆጴሴ።”<verse eid="2SA 12:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 12:5"/>ዳዊትስ ነምቸ ሰነት አከ መሌ ኣሬ ናታኒን አከነ ጄዼ፤ “ዹጋ <char style="nd">ዋቀዮ</char> ጅራታ፣ ነምች ዋን ከነ ጎዼ ሱን ዱኡ ቀበ! <verse eid="2SA 12:5"/><verse number="6" style="v" sid="2SA 12:6"/>ነምች ሱን ቆደ ሆላ ሰና ሀርከ አፉር ባሱ ቀበ፤ እን ገረ ላፍነ መሌ ዋን ከነ ጎዼራቲ።”<verse eid="2SA 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 12:7"/>ናታንስ ዳዊቲን አከነ ጄዼ፤ “ነምች ሱን ሱመ! <char style="nd">ዋቀዮ</char> ዋቅን እስራኤል አከነ ጄዸ፦ ‘አን እስራኤልረት ሞቲ ጎዼ ስ ድቤረ፤ ሀርከ ሳኦል ጀላስ ስ ባሴረ። <verse eid="2SA 12:7"/><verse number="8" style="v" sid="2SA 12:8"/>አን መነ ጎፍታኬቲ ሲፍ ኬኔረ፤ ኒቶተ ጎፍታኬቲሌ ቦባኬት ሲፍ ኬኔረ። አን መነ እስራኤሊፊ መነ ይሁዳ ሲፍ ኬኔረ። ኡቱ ኩኔን ሁንድ ስት ጥናተኒ ስላ ከነ ጫላዩ ሲፍን ኬነ ቱሬ። <verse eid="2SA 12:8"/><verse number="9" style="v" sid="2SA 12:9"/>አት ማሊፍ ዋን እጀሳ ዱረት ሀማ ተኤ ሆጄቹዻን ዱቢ <char style="nd">ዋቀዮ</char> ቱፈቴ? አት ኡርያ ነምቸ ሄት ሰነ ጎራዴን አጄፍቴ ኒቲሳ ፉዸቴርተ። አት ጎራዴ አሞኖታቲን እሰ አጄፍቴ። <verse eid="2SA 12:9"/><verse number="10" style="v" sid="2SA 12:10"/>ከናፉ አመ ሰበቢ አት ነ ቱፈቴ ኒቲ ኡርያ ነምቸ ሄት ሰነ ኦፊኬቲፍ ፉዸቴፍ ጎራዴን መነኬራ ህንፈጋቱ።’<verse eid="2SA 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 12:11"/>“<char style="nd">ዋቀዮ</char> አከነ ጄዸ፦ ‘ኩኖ፣ አን መኑመኬ ኬሳ ዋን ሀማ ስት ነንካሰ፤ ኡቱመ እጅኬ አርጉ ኒቶተኬ ፉዼ ፍረ ስት ኣኑፍ ነንኬነ፤ እንስ ጉዩመ ሳፋዻን እሳን ወጅን ንጪሰ። <verse eid="2SA 12:11"/><verse number="12" style="v" sid="2SA 12:12"/>አት ዾክሳት አከስ ጎቴ፤ አን ገሩ እስራኤሎተ ሁንደ ዱረት ጉዩመ ሳፋዻን ዋን ከነ ነንጎዸ።’ ”<verse eid="2SA 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 12:13"/>ከነረት ዳዊት ናታኒን፣ “አን <char style="nd">ዋቀዮት</char> ጩቡ ሆጄዼረ” ጄዼ።</para>
  <para style="p" vid="2SA 12:13">ናታንሞ ዴብሴ አከነ ጄዼ፤ “<char style="nd">ዋቀዮ</char> ጩቡኬ ስራ ሀቄረ፤ አትስ ህንዱቱ። <verse eid="2SA 12:13"/><verse number="14" style="v" sid="2SA 12:14"/>ተኡስ ሰበቢ አት ዋን ከነ ጎቹዻን <char style="nd">ዋቀዮን</char> ቱፈቴፍ ዳእምን ሲፍ ዸለቴ ሱን ንዱአ።”<verse eid="2SA 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 12:15"/>ኤርገ ናታን ገረ መነ ኦፊሳ ዴሜ ቦዴ <char style="nd">ዋቀዮ</char> ዳእመ ኒቲን ኡርያ ዳዊቲፍ ዴሴ ንዸኤ፤ ሙጭችስ ንዽበሜ። <verse eid="2SA 12:15"/><verse number="16" style="v" sid="2SA 12:16"/>ዳዊትስ ዳእመ ሰናፍ ዋቀ ከዸቴ። እንስ ሶሜ መነሳት ገሌ ሀልከን ሁንደ ለፈ ረፋ ቱሬ። <verse eid="2SA 12:16"/><verse number="17" style="v" sid="2SA 12:17"/>ማንጉዶትን መነሳስ ለፋ እሰ ካሱፍ እሰ ብረ ዸዻበተን፤ እን ገሩ ንድዴ፤ እሳን ወጅንስ ሆማ ህንኛትኔ።<verse eid="2SA 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 12:18"/>ዳእምን ሱንስ ጉያ ቶርበፋት ንዱኤ። ተጃጅልቶትን ዳዊት አከ ዳእምን ሱን ዱኤ እሰት ህሙ ሶዳተን፤ እሳን፣ “ኑ ዬሮ ዳእምን ሱን ሉቡን ጅሩት ዳዊትት ዱበትኔ ቱሬ፤ እን ገሩ ኑ ዸገኡ ድዴ። አመ አከሚን ዳእምን ሱን ዱኤረ ጄኔ እት ህምነ? ዮ ኑ እት ህምኔ እን ኦፍ ሚዸ ተአ” ጄዸኒ ያደኒ ቱረኒቲ።<verse eid="2SA 12:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 12:19"/>ዳዊት አከ ተጃጅልቶትንሳ ወልት አሳሳ ጅረን ሁበቴ ዳእምን ሱን ዱኡሳ ቤኬ። እንስ፣ “ሙጭች ንዱኤ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="2SA 12:19">እሳንስ፣ “ኤዬ ዱኤረ” ጄዸኒ ዴብሰን።<verse eid="2SA 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 12:20"/>ዳዊትስ ለፋ ከኤ። ኤርገ ዸግነሳ ዽቀቴ ድበቴ ቦዴስ ኡፈተሳ ጌደረቴ መነ <char style="nd">ዋቀዮ</char> ሴኔ ዋቄፈቴ። ኤርገሲሞ ገረ መነ ኦፊሳት ገሌ ኛተ ጋፈናን ዽኤሰኒፍ፤ እንስ ንኛቴ።<verse eid="2SA 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 12:21"/>ተጃጅልቶትንሳስ፣ “አት ማሊፍ አከነ ጎተ? ዬሮ ሙጭች ሉቡን ጅሩት ንሶምቴ፤ ንቦሴስ። አመ ገሩ ሙጭች ዱኤረ፤ አትሞ ካቴ ኛተ!” ጄዸኒ እሰ ጋፈተን።<verse eid="2SA 12:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 12:22"/>እንስ አከነ ጄዼ ዴብሴ፤ “አን ዬሮ ሙጭች ሉቡን ቱሬት ነንሶሜ፤ ነንቦኤስ። አን፣ ‘ኤኙቱ ቤከ? <char style="nd">ዋቀዮ</char> ገራ ናላፌ ሙጭች ንፈየ’ ጄዼ ያዴን ቱሬ። <verse eid="2SA 12:22"/><verse number="23" style="v" sid="2SA 12:23"/>አመ ገሩ እን ዱኤረ፤ ዮስ አን ማሊፍን ሶመ? አን እሰ ዴብሱ ነንደንደኣ? አነቱ ገረሳ ዸቀ መሌ እን ገረኮ ህንዹፉ!”<verse eid="2SA 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 12:24"/>ኤርገሲስ ዳዊት ኒቲሳ በትሼባ ንጀጀቤሴ፤ ዸቄስ እሼ ወጅን ጪሴ። እሼንስ እልመ ዴሴፍ፤ መቃሳስ ሶሎሞን ጄዸኒ ሞጋሰን። <char style="nd">ዋቀዮስ</char> እሰ ንጃለቴ፤ <verse eid="2SA 12:24"/><verse number="25" style="v" sid="2SA 12:25"/><char style="nd">ዋቀዮ</char> ዋን እሰ ጃለቴፍ አከ እን ይዲድያ ጄዸሜ ዋመሙፍ ከራ ናታን ራጅቻቲን ዱቢ ኤርጌ።<verse eid="2SA 12:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 12:26"/>ዬሮ ሰነትስ ዮኣብ መጋላ አሞኖታ ከን ረባ ጄዸሙ ወራኔ ደአትኖ መሰራ ሞቱማ ቀበቴ። <verse eid="2SA 12:26"/><verse number="27" style="v" sid="2SA 12:27"/>ዮኣብስ አከነ ጄዼ ዳዊትት ኤርገሞተ ኤርጌ፤ “አን መጋላ ረባ ወራኔ መደ ብሻንሼ ቀበዼረ። <verse eid="2SA 12:27"/><verse number="28" style="v" sid="2SA 12:28"/>ኤጋ አት ሎልቶተ ሀፈን ወልት ቀበዹቲ መጋለቲ መርሲ ቀበዹ። ዮ ከና አቺ አን መጋለቲ ነንፉዸዸ፤ እሼንስ መቃኮቲን ሞጋፈምት።”<verse eid="2SA 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 12:29"/>ከናፉ ዳዊት ሎልቶተ ሁንደ ወልት ቀበቴ ዸቄ ረባ ወራኔ ቀበቴ። <verse eid="2SA 12:29"/><verse number="30" style="v" sid="2SA 12:30"/>ዳዊትስ መታ ሞቲሳኒራ ጎንፎ ፉዸቴ፤ ጎንፍችስ መታ ዳዊትራ ካአሜ። ጎንፎን ሱን ሀመ ወርቄ ታላንቲ ቶኮ ኡልፋቴ ዸጋወን ገት ጀቤዪስ ኦፍራ ቀበ ቱሬ። ዳዊትስ መጋላ ሰነ ኬሳ ቦጁ አከ መሌ ባይኤ ፉዸቴ <verse eid="2SA 12:30"/><verse number="31" style="v" sid="2SA 12:31"/>ነሞተ አች ኬሰ ቱረንስ ገድ ያሴ አከ እሳን መጋዚዻን፣ ገሶ ስቢላቲፊ ቆቶዻን ሆጂ ሆጄተን ጎዼ፤ ሱጴስ እሳን ዾፍስሴ። ዳዊት መጋላወን አሞኖታ ሁንደ ኬሰትስ አከሱመ ጎዼ። ኤርገሲ ዳዊቲፊ ሎልቶትንሳ ሁንድኑ ዬሩሳሌምት ንዴብአን።<verse eid="2SA 12:31"/></para>
  <chapter eid="2SA 12"/>
  <chapter number="13" style="c" sid="2SA 13"/>
  <para style="s1">አምኖኒፊ ታማር</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 13:1"/>ዬሮ ቶኮ አምኖን እልም ዳዊት ታማርን ጃለቴ፤ እሼን አከ መሌ በሬዱ፣ ኦቦሌቲ አቤሳሎም እልመ ዳዊት ሰና ቱርቴ።<verse eid="2SA 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 13:2"/>አምኖን ሰበቢ ጃለለ ኦቦሌቲሳ ታማሪቲፍ አከ መሌ ዽጰቴ ዽበሜ፤ ሰበቢ እሼን ዱርበ ቱርቴፍ አምኖን ዋን ዋኑመ ቶኮሌ እሼ ጎቹ ደንደኡ ህንሴኔ።<verse eid="2SA 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 13:3"/>አምኖን ምቹ አከ መሌ ጀልኣ ከን ዮናዳብ ጄዸሙ ቶኮ ቀበ ቱሬ፤ ዮናዳብ እልመ ሽሜኣ ኦቦሌሰ ዳዊት። <verse eid="2SA 13:3"/><verse number="4" style="v" sid="2SA 13:4"/>ዮናዳብስ አምኖኒን፣ “ያ እልመ ሞቲ፣ ዸግንኬ ማሊፍ ጉዩመ ጉያን ሁቀቻ ዴመ? አት ነት ህንህምቱ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="2SA 13:4">አምኖንሞ፣ “አን ታማር ኦቦሌቲ አቤሳሎም ኦቦሌሰኮቲ ጃለዼረ” እሳን ጄዼ።<verse eid="2SA 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 13:5"/>ዬሆናዳብስ፣ “ሶቢቲ አከ ነመ ዹኩብሰቴት ስሬረ ጪስ፤ ዮሙ አባንኬ ስ ጋፈቹ ዹፉት፣ ‘አከ አን ሀርከሼቲ ኛዹፍ አከ ኦቦሌቲንኮ ታማር ዹፍቴ ፉለኮ ዱረት ኛተ ና ቆጴስቱ ነንበርባደ’ ጄዺን” ጄዼ።<verse eid="2SA 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 13:6"/>ከናፉ አምኖን ሶቤ አከ ነመ ዹኩብሰቴ ቶኮት ጪሴ። ዮሙ ሞትች እሰ ጋፈቹ ዹፌትስ አምኖን፣ “አከ ኦቦሌቲንኮ ታማር ዹፍቴ ፉለኮ ዱረት ኛተ አዳ ናፍ ቆጴስቴ ኛቹ ነንበርባደ” ጄዼን።<verse eid="2SA 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 13:7"/>ዳዊትስ ገረ መናት ታማርት ነመ ኤርጌ፣ “ገረ መነ ኦቦሌሰኬ አምኖን ዸቂቲ ዋን እን ኛቱ ቆጴሲፍ” ጄዼ። <verse eid="2SA 13:7"/><verse number="8" style="v" sid="2SA 13:8"/>ከናፉ ታማር ካቴ ገረ መነ ኦቦሌሰሼ አምኖን ከን ጪሴ ቱሬ ሰና ዸቅጤ። ዳኩ ጥኖሼ ፉቴ ቡኬስቴ ፉለሳ ዱረት ቶልችቴ። <verse eid="2SA 13:8"/><verse number="9" style="v" sid="2SA 13:9"/>ኤርገሲስ ቡዴነ ቶልችቴ ሰነ ኤሌራ ፉቴ ዽኤስቴፍ፤ እን ገሩ ኛቹ ድዴ።</para>
  <para style="p" vid="2SA 13:9">አምኖን፣ “ነመ ሁንደ ነራ ባሳ” ጄዼ። ከናፉ ነምን ሁንድ እሰ ብራ በኤ። <verse eid="2SA 13:9"/><verse number="10" style="v" sid="2SA 13:10"/>ኤርገሲስ አምኖን ታማሪን፣ “አከ አን ሀርከኬራ ኛዹፍ ቡዴንቸ ኩታ አን ጪሱት ና ፍድ” ጄዼ። ታማርስ ቡዴነ ቆጴስቴ ሰነ ፉቴ አምኖን ኦቦሌሰሼቲፍ ለፈ እን ጪሴት ጌስቴ። <verse eid="2SA 13:10"/><verse number="11" style="v" sid="2SA 13:11"/>እን ገሩ ዮሙ እሼን ኛተ ዽኤስቴፍት ሁምናንሼ ቀበቴ፣ “ያ ኦቦሌቲኮ፣ ኮቱ ነ ወጅን ጪስ” ጄዼን።<verse eid="2SA 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 13:12"/>እሼንሞ ዴብፍቴ አከነ ጄቴን፤ “ያ ኦቦሌሰኮ፣ ዋን ከነ ህንጎዽን! ነ ህንድርቅሲስን። ወን ፎክሳን አከሲ እስራኤል ኬሰት ሆጄተሙ ህንቀቡ! አት ዋን ሀማ ከነ ህንጎዽን። <verse eid="2SA 13:12"/><verse number="13" style="v" sid="2SA 13:13"/>አን ማለን ተአ? ሰልጵነኮስ ባዼ ኤሰን ዸቀ? አትሆ? አትስ እስራኤል ኬሰት አከ ጎዋ ሀማ ቶኮት እላለሙኬት ምቲ? ማሎ ሞትቸት ህመዹ፤ እን ስት ሄሩሙ ነ ህንዾዉቲ።” <verse eid="2SA 13:13"/><verse number="14" style="v" sid="2SA 13:14"/>እን ገሩ እሼ ዸገኡ ድዴ፤ ዋን እሼ ጫላ ጀባ ተኤፍስ ሁምናን እሼ ጉዴዴ።<verse eid="2SA 13:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 13:15"/>ኤርገሲ አምኖን ጅበ ጉዳ እሼ ጅቤ፤ ዹጉማን ሀመ ዱር እሼ ጃለቴ ጫላ እሼ ጅቤ። አምኖንስ፣ “ከኢቲ በኢ ዴም!” እሼን ጄዼ።<verse eid="2SA 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 13:16"/>እሼንሞ፣ “ህንተኡ! ነ አርኡንኬ የከ አት ዱራን ነት ሆጄቴ ጫላ ሀማተ” ጄቴን።</para>
  <para style="p" vid="2SA 13:16">እን ገሩ እሼ ዸገኡ ድዴ። <verse eid="2SA 13:16"/><verse number="17" style="v" sid="2SA 13:17"/>ተጃጅላ ኦፊሳስ ዋሜ፣ “ዱበርቲ ከነ ነራ ባሲቲ በልበለ እት ጩፍ” ጄዼን። <verse eid="2SA 13:17"/><verse number="18" style="v" sid="2SA 13:18"/>ተጃጅላንሳ ሱንስ ገድ እሼ ባሴ በልበለ እት ጩፌ። እሼን ኡፈተ ፋየ አደ አዳቲን ሚዸግፈሜ ኡፈቴ ቱርቴ፤ እንተለን ሞቲ ከኔን ዱበረን ቁልቁሉ ተአን ኡፈተ አከሲ ኡፈቱ ቱሬቲ። <verse eid="2SA 13:18"/><verse number="19" style="v" sid="2SA 13:19"/>ታማርስ መታሼት ዳራ ፍርፍርፈቴ ወንደቦሼ ዼራ ፋየወኒን ሚዸግፈሜ ሰነ ተርሳፍቴ። ሀርከሼስ መታረ ካአቴ ሰገሌ ኦል ፉዸቴ ቦኣ ዴምቴ።<verse eid="2SA 13:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 13:20"/>አቤሳሎም ኦቦሌስሼ፣ “አምኖን ኦቦሌስኬ ስ ወጅን ቱሬ? ያ ኦቦሌቲኮ፣ ጨልእስ፤ እን ኦቦሌሱመኬት። ዋን ከነ ገራት ህንቀበትን” ጄዼን። ታማርስ ኮጳሼ መነ ኦቦሌሰሼ መነ አቤሳሎም ጅራቴ።<verse eid="2SA 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 13:21"/>ዳዊት ሞትች ዮሙ ዋን ከነ ሁንደ ዸገኤት ባይኤ ኣሬ። <verse eid="2SA 13:21"/><verse number="22" style="v" sid="2SA 13:22"/>አቤሳሎም ዱቢ ቶላ ዮካን ሀማ ቶኮሌ አምኖንት ህንዱበትኔ፤ አቤሳሎም ሰበቢ እን ኦቦሌቲሳ ታማርን ሰልጵሴፍ አከ መሌ አምኖንን ጅቤ ቱሬ።<verse eid="2SA 13:22"/></para>
  <para style="s1">አቤሳሎም አምኖንን አጄሴ</para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 13:23"/>ወጋ ለማ ቦዴ ወር ሆሎተ አቤሳሎምራ ርፌንሰ ሃደን መጋላ በኣል ሀሶር ከን ኤፍሬም ብረት አርገሙ ሰነ ኬሰ ቱረን፤ እንስ አከ እሳን አች ዸቀኒፍ እልማን ሞቲ ሁንደ ዋሜ። <verse eid="2SA 13:23"/><verse number="24" style="v" sid="2SA 13:24"/>አቤሳሎምስ ገረ ሞትቻ ዸቄ፣ “ነሞትን ሆሎተ ገርብቸኬቲራ ርፌንሰ ሃደን ዹፈኒሩ። ማሎ ሞትቺፊ ቆንዳልቶትንሳ ገርብቸኬ ወጅን ሃዴመን” ጄዼ ከዸቴ።<verse eid="2SA 13:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 13:25"/>ሞትችሞ ዴብሴ፣ “ለክ ያ እልመኮ፣ ኑ ሁንድኑ ዴሙ ህንቀብኑ፤ ኑ በኣ ቆፈ ስት ታና” ጄዼን። አቤሳሎም ጀቤሴ እሰ ከዸቱዩ እን እሰ ኤብሴ መሌ እሰ ፋነ ህንዴምኔ።<verse eid="2SA 13:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 13:26"/>አቤሳሎምስ፣ “ዮ ተኡ ባቴ፣ ማሎ ኦቦሌስኮ አምኖን ኑ ወጅን ሃዴሙ” ጄዼ።</para>
  <para style="p" vid="2SA 13:26">ሞትችሞ፣ “እን ማሊፍ ስ ወጅን ዴመ?” ጄዼ ጋፈቴ። <verse eid="2SA 13:26"/><verse number="27" style="v" sid="2SA 13:27"/>አቤሳሎም ገሩ ጀቤሴ እሰ ከዸቴ፤ ከናፉ እን አምኖኒፊ እልማን ሞትቻ ካን እሰ ወጅን ኤርጌ።<verse eid="2SA 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 13:28"/>አቤሳሎም አከነ ጄዼ ነሞተሳ አጀጄ፤ “ዸገኣ! ዮሙ አምኖን ዳዺ ወይኒ ዹጌ መቻኡት አን፣ ‘አምኖንን ዸኣ’ እስኒን ጄዸ፤ እስንስ ዮሙሱመ እሰ አጄሳ። ህንሶዳትና። አነቱ አጀጀ ከነ እስኒ ኬኔ ምቲ? ጀባዻ፤ ጀግኖማስ።” <verse eid="2SA 13:28"/><verse number="29" style="v" sid="2SA 13:29"/>ከናፉ ነሞትን አቤሳሎም ዋኑመ አቤሳሎም እሳን አጀጄ ሰነ አምኖንት ሆጄተን። እልማን ሞትቻ ሁንድኑስ ከአኒ ጋንጎሊሳኒ ያበተኒ በቀተን።<verse eid="2SA 13:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 13:30"/>ኡቱ እሳን ከራረ ጅረኑ ኦዱን፣ “አቤሳሎም እልማን ሞትቻ ሁንደ ፍጤረ፤ ቶኮንሳኒዩ ህንሀፍኔ” ጄዹ ዳዊት ቀቀቤ። <verse eid="2SA 13:30"/><verse number="31" style="v" sid="2SA 13:31"/>ሞትችስ ኦል ከኤ ኡፈተሳ ተርሳሴ ለፈ ጪሴ፤ ተጃጅልቶትንሳ ከኔን እሰ ብረ ዸዻበተኒ ቱረን ሁንድኑስ ኡፈተሳኒ ተተርሳሰን።<verse eid="2SA 13:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 13:32"/>ዮናዳብ እልም ሽሜኣ እልም ኦቦሌሰ ዳዊት ሱን ገሩ አከነ ጄዼ፤ “ጎፍታንኮ ዋን እሳን እልማን ሞትቻ ሁንደ ፍጠን ህንሴእን፤ አምኖን ቆፈቱ ዱኤ። ኩንስ ዋን አቤሳሎም ኤርገ አምኖን ኦቦሌቲሳ ታማርን ሁምናን ጉዴዴ ጀልቀቤ እት ያዳ ቱሬዸ። <verse eid="2SA 13:32"/><verse number="33" style="v" sid="2SA 13:33"/>ጎፍታንኮ ሞትች ዋኤ ኦዱ እልማን ሞትቻ ሁንድ አጄፈመኒሩ ጄዹ ሰና ህንያደእን፤ አምኖን ቆፈቱ ዱኤ።”<verse eid="2SA 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="2SA 13:34"/>ዬሮ ከነት አቤሳሎም በቀቴረ።</para>
  <para style="p" vid="2SA 13:34">ነምች ኤጉምሳፍ ዻበቴ ቱሬስ ኦል ጄዼ እላሌ ነሞተ ባይኤ ዳንዲ ሆሮናይም ከን ጋረ ጭነ በኡረ ዹፋ ጅረን አርጌ። ነምች ሱንስ ዸቄ፣ “አን ከራ ሆሮናይም፣ ጭነ ጋራት ነሞተ ነንአርገ” ጄዼ ሞትቸት ህሜ።<verse eid="2SA 13:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="2SA 13:35"/>ዮናዳብስ ሞትቻን፣ “ኩኖ፣ እልማን ሞትቻ ዹፈኒ ጅሩ፤ ወን ኩን አኩመ ገርብችኬ ጄዼ ተኤ” ጄዼ።<verse eid="2SA 13:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="2SA 13:36"/>አኩመ እን ዱበቴ ፍጠቴን እልማን ሞትቻ ሰገሌ ጉዳዻን ቦኣ ኦል ገለን። ሞትቺፊ ተጃጅልቶትንሳ ሁንድኑስ ህቅፈተኒ ቦአን።<verse eid="2SA 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="2SA 13:37"/>አቤሳሎም ገሩ በቀቴ ገረ እልመ አሚሁድ፣ ገረ ተልማይ ሞትቸ ጌሹር ሰና ዸቄ። ዳዊትሞ ጉያ ሁንደ እልመሳቲፍ ንቦአ ቱሬ።<verse eid="2SA 13:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="2SA 13:38"/>አቤሳሎም ኤርገ በቀቴ ጌሹር ዸቄ ቦዴ ወጋ ሰዲ አች ቱሬ። <verse eid="2SA 13:38"/><verse number="39" style="v" sid="2SA 13:39"/>ሞትችስ ዱአ አምኖንራ ጀጀባትናን ገረ አቤሳሎም ዸቁፍ ገራንሳ ከከኤ።<verse eid="2SA 13:39"/></para>
  <chapter eid="2SA 13"/>
  <chapter number="14" style="c" sid="2SA 14"/>
  <para style="s1">አቤሳሎም ዬሩሳሌምት ዴብኤ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 14:1"/>ዮኣብ እልም ዜሩያ አከ ገራን ሞትቻ አቤሳሎምት ዴብኤ ቤኬ። <verse eid="2SA 14:1"/><verse number="2" style="v" sid="2SA 14:2"/>ከናፉ ዮኣብ ገረ ቴቆኣት ነመ ኤርጌ ዱበርቲ ኦጌቲ ቶኮ ፍችሲሴ። እንስ አከነ እሼዻን ጄዼ፤ “ሶቢቲ አከ ነመ ገደ ኬሰ ጅሩ ተእ። ወያ ገዳ ኡፈዹ፤ ድበተ ከምዩ ህንድበትን። አከ ዱበርቲ ነመ ዱኤ ቶኮፍ ጉያ ሄዱ ገድቴ ቶኮስ ተእ። <verse eid="2SA 14:2"/><verse number="3" style="v" sid="2SA 14:3"/>ሞትቸ ብረ ዸቂቲ ዋን ከነ እት ህም።” ዮኣብስ ዋን እሼን ዱበቱ እሼት ህሜ።<verse eid="2SA 14:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 14:4"/>ዱበርቲን ሱን ዮሙ ቴቆኣዻ ገረ ሞትቻ ዹፍቴት ኡልፍነ እሳፍ ኬኑፍ አዳን ለፈት ጎምብፈምቴ፣ “ያ ሞቲ፣ ነ ገርጋር!” ጄቴ።<verse eid="2SA 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 14:5"/>ሞትችስ፣ “አት ማል ረከቴ?” ጄዼ እሼ ጋፈቴ።</para>
  <para style="p" vid="2SA 14:5">እሼንስ አከነ ጄቴ፤ “ሰበቢ ዽርስኮ ዱኤፍ አን ዹጉማን ኒቲ ዽርሰ ህንቀብኔዸ። <verse eid="2SA 14:5"/><verse number="6" style="v" sid="2SA 14:6"/>አን ገርብቲንኬ እልማን ለመ ቀበን ቱሬ። እሳንስ አለት ወል ሎለን፤ ሰበቢ ነምን ወልራ እሳን ዾዉ ቶኮዩ አች ህንቱርኒፍ እን ቶኮ እሰ ካን ዸኤ አጄሴ። <verse eid="2SA 14:6"/><verse number="7" style="v" sid="2SA 14:7"/>ኩኖ፣ ጎስት ሁንድ አነ ገርብቲኬት ከኤረ፤ እሳንስ፣ ‘ዋን እን ኦቦሌሰ ኦፊሳ አጄሴፍ አከ ኑ ሰበቢ ሉቡ ኦቦሌሰሳ ከን እን አጄሴ ሰና እሰ አጄፍኑፍ ደበርሲ ኑት ኬን፤ ኤርገሲ ዻልቱሳሌ ንገላፈትነ’ ጄዹ። እሳንስ አከሲን አከ ዽርስኮ መቃ ዮካን ሰኚ ለፈራ ህንቀባኔፍ እብሳኮ ቶክቸ ሀፌ ከነ ዻምሱ።”<verse eid="2SA 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 14:8"/>ሞትችስ ዱበርቲ ሰናን፣ “አን ዋኤኬቲፍ አጀጀ ነንደበርሳቲ አት መነኬት ገል” ጄዼ።<verse eid="2SA 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 14:9"/>ዱበርቲን ቴቆኣ ሱን ገሩ፣ “ያ ጎፍታኮ፣ ያ ሞትቸ፣ የክ ሱን አናፊ ማቲ አባኮረ ሃቡኡ፤ ሞትቺፊ ቴሶንሳ የከራ ሃቁልቁላአን” ጄቴ።<verse eid="2SA 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 14:10"/>ሞትችስ ዴብሴ፣ “ዮ ነምን ከምዩ ዋን ቶኮሌ ስት ዱበቴ እሰ ነት ፍድ፤ እንስ ዴብኤ ስ ህንረክሱ” ጄዼ።<verse eid="2SA 14:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 14:11"/>እሼሞ፣ “ከናፉ አከ ነምን ሃሎ ዺጋ ባሱ ሱን እቱመ ፉፌ ነመ ብራ አጄሴ አከሲን እልምኮ ህንአጄፈምኔፍ ሞትች <char style="nd">ዋቀዮን</char> ዋቀሳ ሃዋመቱ” ጄቴ።</para>
  <para style="p" vid="2SA 14:11">እንስ፣ “ዹጋ <char style="nd">ዋቀዮ</char> ጅራታ፣ ርፌንስ ቶክቲን መታ እልመኬቲራ ለፈ ህንቡኡ” ጄዼ።<verse eid="2SA 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 14:12"/>ኤርገሲስ ዱበርትቲን፣ “አከ አን ገርብቲንኬ ጎፍታኮ ሞትቸት ዱቢ ቶክቲ ዱበዹ ና ኤየም” ጄቴ።</para>
  <para style="p" vid="2SA 14:12">እንስ፣ “ዱበዹ” ጄዼ ዴብሴ።<verse eid="2SA 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 14:13"/>ዱበርትቲንሞ አከነ ጄቴ፤ “ዮስ አት ማሊፍ ዋን አከሲ ሰበ ዋቃት ያዴ? ሞትች እልመሳ ከን ብያ በቀቴ ሰነ ህንዴብፍኔቲ፤ አከነ ጄቹንሳ ኦፍት ሙሩሳ ምቲ? <verse eid="2SA 14:13"/><verse number="14" style="v" sid="2SA 14:14"/>ኑስ አኩመ ብሻን ለፈት ዸንገለኤ ዴብኤ ህንወራበምኔት ንዱነ። ዋቅን ገሩ ከራ ነምን ብያ በቀቴ ሱን እቲን ዴብኡ በርባደ መሌ አከ እን እሰራ ፈጋቴ ሀፉ ህንፌዹ።<verse eid="2SA 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 14:15"/>“ከናፉ ሰበቢ ነሞትን ነ ሶዳችሰኒፍ አን ዱቢ ከነ ጎፍታኮ ሞትቸት ህሙፍ ዹፌረ። ገርብቲንኬስ ዋን ከነ ያዴ፤ ‘አን ሞትቸ ነንጋፈዸ፤ እንስ ዋን ገርብቲንሳ ጋፈቴ ቶሌ ጄዸ ተአ። <verse eid="2SA 14:15"/><verse number="16" style="v" sid="2SA 14:16"/>ሞትች ዋን ከነ ዸገኤ ሀርከ ነምቸ አናፊ እልመኮ ዻለ ዋቅን ኑ ኬኔ ኑ ዸብሲሱ ያሉ ጀላ ገርብቲሳ ንባሳቲ።’<verse eid="2SA 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 14:17"/>“አመስ ገርብቲንኬ አከነ ጄት፤ ‘ሰበቢ ጎፍታንኮ ሞትች ዋን ጋሪፊ ሀማ ገርገር ባሴ ቤኩት አኩመ ኤርገማ ዋቀዮ ተኤፍ ዱቢን ጎፍታኮ ሞትቻ ቦቆና ናፍ ሃኬኑ። <char style="nd">ዋቀዮ</char> ዋቅንኬ ስ ወጅን ሃተኡ።’ ”<verse eid="2SA 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 14:18"/>ከነረት ሞትች ዱበርትቲዻን፣ “አት ዋን አን ስጋፈዹ ከምዩ ነ ህንዾክስን” ጄዼ።</para>
  <para style="p" vid="2SA 14:18">ዱበርትቲንስ፣ “ጎፍታንኮ ሞትች ሃዱበቱ” ጄቴ።<verse eid="2SA 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 14:19"/>ሞትች፣ “ዋን ከነ ሁንደ ኬሰት ሀርክ ዮኣብ ስ ወጅን ጅራ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="2SA 14:19">ዱበርቲን ሱንሞ አከነ ጄቴ ዴብፍቴ፤ “ያ ጎፍታኮ ሞትቸ፣ ዱአኬት፤ ዱቢ ጎፍታንኮ ሞትች ዱበቱራ ነምን ገረ ምርጋት ዮካን ገረ ብታት ጎሩ ደንደኡ ቶኮሌ ህንጅሩ። ዹጉመ ነምን አከ አን ዋን ከነ ዱበዹ ነ አጀጄፊ ከን ዱቢ ከነ ሁንደስ አፋን ገርብቲኬቲ ኬሰ ካኤ ዮኣቡመ ገርብቸኬት። <verse eid="2SA 14:19"/><verse number="20" style="v" sid="2SA 14:20"/>ዮኣብ ገርብችኬ ዋን ከነ ጎቹንሳ ሃለ ዬሮ አማ ጅሩ ጌደሩፍ። ጎፍታንኮ ኦጉማ አኩመ ኦጉማ ኤርገማ ዋቀዮ ቀበ፤ እን ዋን ለፈረት ተኡ ሁንደ ንቤከ።”<verse eid="2SA 14:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 14:21"/>ሞትችስ ዮኣቢን፣ “ቶሌ፤ አን ዋን ከነ ነንጎዸ። አት ዸቂ አቤሳሎም ደርገጌስቸ ፍድ” ጄዼ።<verse eid="2SA 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 14:22"/>ዮኣብስ ኡልፍነ እሳፍ ኬኑፍ አዳን ጎምብፈሜ ሞትቸ ኤብሴ። ዮኣብ፣ “ሰበቢ ሞትች ከዸትና ገርብቸሳ ዸገኤፍ እን አከ ፉለ ጎፍታሳ ሞትቻ ዱረት ፉዸተመ አርገቴ ሀርአ ንቤከ” ጄዼ።<verse eid="2SA 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 14:23"/>ኤርገሲ ዮኣብ ጌሹር ዸቄ አቤሳሎምን ዴብሴ ዬሩሳሌምት ፍዴ። <verse eid="2SA 14:23"/><verse number="24" style="v" sid="2SA 14:24"/>ሞትች ገሩ፣ “እን ገረ መነሳ ዴሙ ቀበ፤ እን ፉለኮ አርጉ ህንቀቡ” ጄዼ። ከናፉ አቤሳሎም ገረ መነሳት ገሌ፤ ፉለ ሞትቻስ ህንአርግኔ።<verse eid="2SA 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 14:25"/>ጉቱማ እስራኤል ኬሰ ነምን አከ አቤሳሎም ሚዸጉመሳቲን ባይኤ ጀጀሜ ቶኮዩ ህንቱሬ። እን መታሳቲ ጀልቀቤ ሀመ ፋነ ሚለሳት ህርእነ ቶኮዩ ህንቀቡ ቱሬ። <verse eid="2SA 14:25"/><verse number="26" style="v" sid="2SA 14:26"/>ዮሙ ርፌንስ መታሳ እት ኡልፋቱት ወጋት ዬሮ ቶኮ ኦፍራ ሙረ ቱሬ፤ ዬሮ እን ርፌንሰ መታሳ ከነ መዳል ሞቲቲን መዳሉትስ ርፌንስሳ ሰቅሊ ዽበ ለመ ኡልፋተ ቱሬ።<verse eid="2SA 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 14:27"/>አቤሳሎም እልማን ሰዲፊ እንተለ ቶኮ ዸልቼ። መቃን እንተለ ሰና ታማር ጄዸመ፤ እሼንስ ዱበርቲ አከ መሌ በሬዱ ቱርቴ።<verse eid="2SA 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 14:28"/>አቤሳሎም ኡቱ ፉለ ሞትቻ ህንአርግን ወጋ ለመ ዬሩሳሌም ኬሰ ጅራቴ። <verse eid="2SA 14:28"/><verse number="29" style="v" sid="2SA 14:29"/>ኤርገሲ አቤሳሎም ዮኣብን ገረ ሞትቻት ኤርጉፍ ጄዼ ነመ እት ኤርጌ፤ ዮኣብ ገሩ እሰ ብረ ዹፉ ድዴ። ከናፉ ዬሮ ለመፋ ነመ እት ኤርጌ፤ እን ገሩ ዹፉ ድዴ። <verse eid="2SA 14:29"/><verse number="30" style="v" sid="2SA 14:30"/>ኤርገሲስ አቤሳሎም ሆጄቶተሳቲን፣ “እላ፣ ለፍት ቆቲሳ ዮኣብ ለፈ ቆቲሳኮት ኣነ፤ እንስ ገርቡ አቺ ቀበ። ዸቃቲ እብደ እት ቀብሲሳ” ጄዼ። ከናፉ ሆጄቶትን አቤሳሎም ዸቀኒ ለፈ ቆቲሳ ሰነት እብደ ቀብሲሰን።<verse eid="2SA 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 14:31"/>ከነረት ዮኣብ ገረ መነ አቤሳሎም ዸቄ፣ “ሆጄቶትንኬ ማሊፍ ለፈ ቆቲሳኮት እብደ ቀብሲሰን?” ጄዼን።<verse eid="2SA 14:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 14:32"/>አቤሳሎምስ ዴብሴ ዮኣቢን አከነ ጄዼ፤ “ኩኖ አን አከ አት፣ ‘እን፣ “አን ማሊፍን ጌሹሪ ዹፌ? ኡቱን ሀመ አማት አቹመ ጅራዼ ናፍ ወየ ቱሬ!” ጄዸ’ ጄቴ ሞትቸት ናፍ ህምቱፍ ገረ ሞትቻት ስ ኤርገቹፍ፣ ነ ብረ ኮቱ ጄዼ ስት ዻመዼን ቱሬ። አን አመሌ ፉለ ሞትቻ አርጉን ፌዸ፤ ዮ አን የከ ቶኮሌ ሆጄዼ ጅራዼ እን ነ ሃአጄሱ።”<verse eid="2SA 14:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 14:33"/>ከናፉ ዮኣብ ገረ ሞትቻ ዸቄ ዋን ከነ እት ህሜ። ሞትችስ አቤሳሎምን ዋምስሴ፤ እንስ ዹፌ ፉለ ሞትቻ ዱረት አዳን ለፈት ጎምብፈሜ። ሞትችስ አቤሳሎምን ዹንገቴ።<verse eid="2SA 14:33"/></para>
  <chapter eid="2SA 14"/>
  <chapter number="15" style="c" sid="2SA 15"/>
  <para style="s1">ፍንጭለ አቤሳሎም</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 15:1"/>ከነረት አቤሳሎም ጋሪ ሎላቲፊ ፈርዴን አከሱመስ ነሞተ ፉለሳ ዱረ ፊገን ሸንተመ ኦፊሳቲፍ ቆጴፈቴ። <verse eid="2SA 15:1"/><verse number="2" style="v" sid="2SA 15:2"/>እንስ ገነማን ከኤ ዳንዲ ገረ ከረ መጋላት ነመ ጌሱረ ዻበተ ቱሬ። ዬሮ ነምን ከምዩ እየተሳ ሞቲ ዱረት ዽኤፈቴ ሙርቲ አርገቹፍ ዹፉት፣ አቤሳሎም ኦፍት እሰ ዋሜ፣ “አት መጋላ ከሚ ዹፍቴ?” ጄዼ ጋፈተ። ነምን ሱንስ፣ “ገርብችኬ ጎሶተ እስራኤል ኬሳ ጎሰ ቶኮ ኬሳ ዹፈ” ጄዼ ዴብሳፍ። <verse eid="2SA 15:2"/><verse number="3" style="v" sid="2SA 15:3"/>ኤርገሲስ አቤሳሎም፣ “ኩኖ እየንኬ ዹጋፊ ቀጄላዸ፤ ገሩ አከ እን ስ ዸገኡፍ ነምን ሞቲን እዶ ቡፈቴ ቶኮዩ ህንጅሩ” ጄዻን። <verse eid="2SA 15:3"/><verse number="4" style="v" sid="2SA 15:4"/>አቤሳሎምስ እት ደበሌ፣ “ማል ቀበ፣ ኡቱ አን ብየ ከነት አባ ሙርቲ ተኤ! ስላ ነምን እየተ ዮካን ህመተ ቀቡ ከምዩ ነ ብረ ዹፌ አንስ ሙርቲ ቀጄላ እሳፍ ነንኬነን ቱሬ” ጄዸ።<verse eid="2SA 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 15:5"/>አከሱመስ ዬሮ ነምን ቶኮ ፉለሳ ዱረት ጅልቤንፈቹፍ ገረሳ ዹፉት አቤሳሎም ሀርከ ድሪርፈቴ ኦል እሰ ቀቡዻን እሰ ዹንገተ። <verse eid="2SA 15:5"/><verse number="6" style="v" sid="2SA 15:6"/>አቤሳሎም አከሲን እስራኤሎተ ሙርቲ ቀጄላ አርገቹፍ ገረ ሞቲ ዹፈን ሁንደ ስመቹዻን ገራ ነሞተ እስራኤል ሀቴ።<verse eid="2SA 15:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 15:7"/>አቤሳሎምስ ገረ ዹመ ወጋ አፉረፋት ሞትቻን አከነ ጄዼ፤ “አከ አን ኬብሮን ዸቄ ወሬገ <char style="nd">ዋቀዮፍ</char> ወሬጌ ቱሬ ቶኮ ዽኤሱፍ ናፍ ኤየም። <verse eid="2SA 15:7"/><verse number="8" style="v" sid="2SA 15:8"/>አን ገርብችኬ ዬሮን ብየ ሶርያ ኬሰ ጌሹር ጅራቻ ቱሬት፣ ‘ዮ <char style="nd">ዋቀዮ</char> ገረ ዬሩሳሌምት ነ ዴብሴ፣ አን ኬብሮንት <char style="nd">ዋቀዮፍ</char> ነንሰገደ’ ጄዼ ወሬገ ከነ ወሬጌን ቱሬ።”<verse eid="2SA 15:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 15:9"/>ሞትችስ፣ “ነጋን ዴም” ጄዼን። ከናፉ አቤሳሎም ገረ ኬብሮን ዴሜ።<verse eid="2SA 15:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 15:10"/>አቤሳሎም ገሩ አከ እሳን፣ “እስን አኩመ ሰገሌ መለከታ ዸጌሰኒን፣ ‘አቤሳሎም ኬብሮንት ሞቲ ተኤረ’ ጄዻ” ጄዸኒፍ ጉቱማ ጎሶተ እስራኤል ኬሰ ዾክሳዻን ኤርገሞተ ቦባሴ። <verse eid="2SA 15:10"/><verse number="11" style="v" sid="2SA 15:11"/>ነሞትን ዽብ ለመ ዬሩሳሌሚ በአኒ አቤሳሎም ፋነ ቡአን። እሳን አከ ኬሱማት አፌረመኒ ጨልእሰኒቱመ ዴመን መሌ ዋኤ ዽመ ሰና ዋን ቶኮሌ ቁበ ህንቀበን ቱሬ። <verse eid="2SA 15:11"/><verse number="12" style="v" sid="2SA 15:12"/>አቤሳሎም ዬሮ ኣርሳ ዽኤሱት ነምች ጎሰ ጊሎ ከን አሂቶፌል ጄዸሙ፣ ጎርሳን ዳዊት አከ መጋላሳ ጊሎዻ ዹፉፍ ዋምስሴ። ከናፉ ፍንጭል ሱን ጀባቴ ዱካ ቡቶትን አቤሳሎምስ ባይአቻ ዹፈን።<verse eid="2SA 15:12"/></para>
  <para style="s1">ዳዊት በቀቹሳ</para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 15:13"/>ኤርገማን ቶኮስ ዳዊት ብረ ዹፌ፣ “ገራን ነሞተ እስራኤል ገረ አቤሳሎምት ዴብኤ ጅረ” ጄዼ እት ህሜ።<verse eid="2SA 15:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 15:14"/>ኤርገሲስ ዳዊት ቆንዳልቶተሳ ወረ እሰ ወጅን ዬሩሳሌም ኬሰ ቱረኒን አከነ ጄዼ፤ “ከኣ ንበቀትና! ዮ ከና አቺ ቶኮንኬኘዩ አቤሳሎም ጀላ ህንባኑ። ደፍኔ አሲ ዴሙ ቀብነ፤ ዮ ከና አቺ እን አሪቲዻን ዹፌ ኑ ቀቀቤ ኑ በሌሳቲ፤ መጋለቲሌ ጎራዴዻን ዸአ።”<verse eid="2SA 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 15:15"/>ቆንዳልቶትን ሞትቻስ፣ “ኑ ተጃጅልቶትንኬ ዋን ጎፍታንኬኘ ሞትች ሙርቴሴ ከምዩ ጎቹፍ ቆጳኦዸ” እሳን ጄዸን።<verse eid="2SA 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 15:16"/>ከናፉ ሞትች ወረ መነሳ ጅራተን ሁንደ ኦፍ ፋነ ፉዸቴ ቀጄሌ፤ ሳጀቶወንሳ ኩዸን ገሩ አከ እሳን መሰራ ሞቲ ኤገኒፍ አቹመት ዺሴ። <verse eid="2SA 15:16"/><verse number="17" style="v" sid="2SA 15:17"/>ሞትችስ አከሲን ነሞተ ሁንደ ኦፍ ፋነ ፉዸቴ በኤ፤ እሳንስ ጥኖ አች ፈጋተኒ እዶ ቶኮ ዸዻበተን። <verse eid="2SA 15:17"/><verse number="18" style="v" sid="2SA 15:18"/>ነሞትንሳ ሁንድኑ ኬሬቶታፊ ጴሌቶተ ሁንደ ወጅን ሞትቸ ዱረ ቀጄለን፤ አከሱመስ ጋቶትን ዽበ ጀአ ከኔን ግቲ እሰ ፋነ በአንስ ፉለ ሞትቻ ዱረ ደርበን።<verse eid="2SA 15:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 15:19"/>ሞትችስ እታይ ነምቸ ግቲ ሰናን አከነ ጄዼ፤ “አት ማሊፍ ኑ ፋነ ዹፍተ? ዴብኢቲ አቤሳሎም ሞትቸ ወጅን ቱር። አት ኬሱማ ብየኬቲ ቦጅአምቴ ዹፍቴዸ። <verse eid="2SA 15:19"/><verse number="20" style="v" sid="2SA 15:20"/>አት ከሌሱመ ዹፍቴ። ኤጋ አን ኡቱን ኦፊኮቲፉ ገረን ዸቁ ህንቤክን አከ አት ኑ ፋነ ጆርቱን ስ ጎዻ? አመ ቤኑ ነሞተ ብየኬቲ ፉዸዹቲ ዴብእ። ገረ ላፍኒፊ አመነሙማን ስ ወጅን ሃተአን።”<verse eid="2SA 15:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 15:21"/>እታይ ገሩ ዴብሴ ሞትቻን፣ “ዹጋ <char style="nd">ዋቀዮ</char> ጅራታቲፊ ዱአ ጎፍታኮ ሞትቻ፣ ጅሬኘስ ተኡ ዱአ ታናን አን ተጃጅላንኬ ገረ ጎፍታንኮ ሞትች ዴሙ ከምዩ ነንዴመ” ጄዼ።<verse eid="2SA 15:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 15:22"/>ዳዊትሞ እታዪን፣ “ዮስ ደርቢ ፉለ ዱረት ዴም” ጄዼ። ከናፉ እታይ ነምች ግቲ ሱን ነሞተሳቲፊ ማቲሳ ከኔን እሰ ወጅን ቱረን ሁንደ ፉዸቴ ዴሜ።<verse eid="2SA 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 15:23"/>ዬሮ ነሞትን ሱን ሁንድ ደርበንትስ ወር ባድያ ጅራተን ሁንድ ሰገሌ ኦል ፉዸተኒ ቦአን። ሞትችስ ሱሉለ ቄድሮን ጬኤ ዴሜ፤ ነሞትን ሁንድኑስ ጬአኒ ገረ ገሞጂት ቀጄለን።<verse eid="2SA 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 15:24"/>ዛዶቅስ አች ቱሬ፤ ሌዎትን እሰ ወጅን ቱረን ሁንድኑ ታቦተ ከኩ ዋቃ ባተኒ ቱረን፤ እሳንስ ታቦተ ዋቃ ለፈ ካአን፤ አብያታርሞ ሀመ ነሞትን ሁንድ መጋላ ኬሳ በአንት ኣርሳ ዽኤሴ።<verse eid="2SA 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2SA 15:25"/>ኤርገሲ ሞትች ዛዶቂን አከነ ጄዼ፤ “አት ታቦተ ዋቃ ፉዺቲ ገረ መጋላት ዴብእ። ዮ አን ፉለ <char style="nd">ዋቀዮ</char> ዱረት ሱራ አርገዼ ጅራዼ፣ እን ዴብሴ ነ ፍዴ ታቦተ ሰናፊ ለፈ ኦፊ ጅራቱ ነ አርግሲሰ። <verse eid="2SA 15:25"/><verse number="26" style="v" sid="2SA 15:26"/>ገሩ ዮ እን፣ ‘አን ስት ህንገመድኔ’ ናን ጄዼ፣ አን ቆጳኣዸ፤ እን ዋን ፌዼ ነ ሃጎዹ።”<verse eid="2SA 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 15:27"/>ሞትችስ ዛዶቅ ሉብቻን፣ “አት ነመ ሙልአታን ዋ አርጉ ምቲ? ኤጋ እልመኬ አሂመአዝን አከሱመስ ዮናታን እልመ አብያታር ፉዸዹቲ ነጋን ገረ መጋላት ዴብእ። አቲፊ አብያታር እልማንኬሰን ለማን ፉዸዻቲ ዴማ። <verse eid="2SA 15:27"/><verse number="28" style="v" sid="2SA 15:28"/>አንሞ ሀመን ዻምሰኬ ዸገኡት መልካ ገሞጂ ኬሳ ብረ ነንቱረ።” <verse eid="2SA 15:28"/><verse number="29" style="v" sid="2SA 15:29"/>ከናፉ ዛዶቂፊ አብያታር ታቦተ ዋቃ ሰነ ፉዸኒ ዬሩሳሌምት ዴብአኒ አቹመ ቱረን።<verse eid="2SA 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 15:30"/>ዳዊት ገሩ ጋረ ኤጄርሳት ኦል በኤ፤ ዬሮ ኦል በኡትስ ቦኣ ዴማ ቱሬ፤ እንስ መታሳ ሀጉገቴ ኮጴ መሌ ዴመ ቱሬ። ነሞትን እሰ ወጅን ቱረን ሁንድኑስ መታሳኒ ሀጉገተኒ ቦኣ ዴሙ ቱረን። <verse eid="2SA 15:30"/><verse number="31" style="v" sid="2SA 15:31"/>ዬሮ ከነት፣ “አሂቶፌልስ ወረ አቤሳሎም ወጅን ፍንጭለን ኬሳ ቶኮዸ” ጄዸሜ ዳዊትት ህመሜ። ከናፉ ዳዊት፣ “ያ <char style="nd">ዋቀዮ</char>፣ ጎርሰ አሂቶፌል ሰነ ጀላ ቡሼስ” ጄዼ ዋቀ ከዸቴ።<verse eid="2SA 15:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 15:32"/>ዬሮ ዳዊት እዶ ወል ገኢ እዶ እት ነሞትን ዋቀ ዋቄፈተን ገኤትስ ሁሻይ ነምች ጎሰ አርኪ ሱን ወንደቦ ኦፊ ተርሳሴ ዳራ መታት ፍርፍርፈቴ እሰ ስመቹፍ በኤ። <verse eid="2SA 15:32"/><verse number="33" style="v" sid="2SA 15:33"/>ዳዊትስ አከነ ጄዼን፣ “አት ዮ ነ ወጅን ዴምቴ በኣ ነት ታተ። <verse eid="2SA 15:33"/><verse number="34" style="v" sid="2SA 15:34"/>ገሩ ዮ ገረ መጋላት ዴብቴ አቤሳሎሚን፣ ‘ያ ሞቲ፣ አን ዱራን ገርብቸ አባኬቲን ቱሬ፤ አመ ገሩ ገርብቸኬ ነንተአ’ ጄቴ ጎርሰ አሂቶፌል ቡሼስቴ ነ ገርጋሩ ደንዴሰ። <verse eid="2SA 15:34"/><verse number="35" style="v" sid="2SA 15:35"/>ዛዶቂፊ አብያታር ሉቦትን ሱመ ወጅን አች ጅራቱ ምቲ? አት ዋን መሰራ ሞቲቲ ዸጌሱ ሁንደ እሳንት ህም። <verse eid="2SA 15:35"/><verse number="36" style="v" sid="2SA 15:36"/>እልማንሳኒ ለማን አሂመአዝ እልም ዛዶቂፊ ዮናታን እልም አብያታር እሳኑመ ወጅን አች ጅራተን። አት ዋን ዸጌሱ ሁንደ ሀርከሳኒቲን ና ኤርግ።”<verse eid="2SA 15:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="2SA 15:37"/>ከናፉ ሁሻይ ምቹን ዳዊት ኡቱመ አቤሳሎም ዬሩሳሌም ሴና ጅሩ አች ገኤ።<verse eid="2SA 15:37"/></para>
  <chapter eid="2SA 15"/>
  <chapter number="16" style="c" sid="2SA 16"/>
  <para style="s1">ዳዊቲፊ ዚባ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 16:1"/>ዳዊት ፊጤ ጋርቻ ደርቤ ጥኖ ኤርገ ዴሜ ቦዴ ዚባን ተጃጅላን ሜፊቦሼት ሀሮተ ለመት ቡዴነ ዽበ ለመ፣ ብጥሌ እጀ ወይኒ ዽበ ቶኮ፣ ብጥሌ እጀ ሀርቡ ዽበ ቶኮፊ ዳዺ ወይኒ ቀልቀሎ ቶኮ ፌኤ እሰ ስመቹፍ እት ዹፌ።<verse eid="2SA 16:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 16:2"/>ሞትችስ፣ “ከነ ሁንደ ማሊፍ ፍዴ?” ጄዼ ሲባ ጋፈቴ።</para>
  <para style="p" vid="2SA 16:2">ዚባንሞ፣ “ሀሮተ አከ ማቲን ሞትቻ ያበተኒፍ፣ ቡዴናፊ ብጥሌ እጀ ወይኒ አከ ነሞትን ኛተኒፍ፣ ዳዺ ወይኒሞ አከ ወር ገሞጂ ኬሰት ደዸበን እቲን በየነተኒፍ” ጄዼ ዴብሴ።<verse eid="2SA 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 16:3"/>ሞትችስ፣ “እልም እልመ ጎፍታኬቲ ኤሰ ጅረ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="2SA 16:3">ዚባንሞ ዴብሴ፣ “እን ዋን፣ ‘መን እስራኤል ሀርአ ሞቱማ አካከዩኮቲ ና ዴብሰ’ ጄዼ ያዱፍ ዬሩሳሌም ኬሰ ጅራተ” ጄዼ።<verse eid="2SA 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 16:4"/>ሞትችስ ዚባዻን፣ “ወን ከን ሜፊቦሼት ተኤ ሁንድኑ አመ ከንኬት” ጄዼ።</para>
  <para style="p" vid="2SA 16:4">ዚባንስ፣ “አን አከን ፉለ ጎፍታኮቲ፣ ፉለ ሞትቻ ዱረት ሱራ አርገዹፍ ኦፍ ቀቤን ስ ከዸዸ” ጄዼ።<verse eid="2SA 16:4"/></para>
  <para style="s1">ሳሚን ዳዊትን አባሬ</para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 16:5"/>አኩመ ዳዊት ሞትች በሁሪም ገኤን ነምች በልበለ ማቲ ሳኦል ቶኮ እት ዹፌ። መቃንሳስ ሽሜኢ እልመ ጌራት፤ ነምች ኩንስ ዳዊትን አባራ ገድ በኤ። <verse eid="2SA 16:5"/><verse number="6" style="v" sid="2SA 16:6"/>እንስ ኡቱመ ቆንዳልቶትኒፊ ዋርድዮትን ዳዊት ሁንድኑ ምርጋፊ ብታን ዳዊትን መርሰኒ ጅረኑ ሁንደሳኒት ዸጋ ደርበቻ ቱሬ። <verse eid="2SA 16:6"/><verse number="7" style="v" sid="2SA 16:7"/>ሽሜኢንስ አከነ ጄዼ እሰ አባራ ቱሬ፤ “አሲ በእ፤ አሲ በእ፤ አት ነመ ዺጋት፤ ነምቸ ሀማነነ! <verse eid="2SA 16:7"/><verse number="8" style="v" sid="2SA 16:8"/><char style="nd">ዋቀዮ</char> ዺገ መነ ሳኦል ከን አት እዶሳ ቡቴ ሞቴ ሰና ሁንዳፍ ገቲኬ ሲፍ ኬኔረ። <char style="nd">ዋቀዮ</char> ሞቱማኬ ስራ ፉዼ እልመኬ አቤሳሎሚፍ ኬኔረ። አት ሰበቢ ነመ ዺጋ ታቴፍ ንበደ!”<verse eid="2SA 16:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 16:9"/>አቢሻይ እልም ዜሩያ ሞትቻን፣ “ሰሬን ዱኣን ኩን ማሊፍ ጎፍታኮ ሞትቸ አባረ? አን ዸቄን መታሳራ ኩተ” ጄዼ።<verse eid="2SA 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 16:10"/>ሞትች ገሩ አከነ ጄዼ፤ “ያ እልማን ዜሩያ፣ አኒፊ እስን ማል ወልራ ቀብነ? ዮ እን ሰበቢ <char style="nd">ዋቀዮ</char>፣ ‘አት ዳዊትን አባር’ እሳን ጄዼፍ ነ አባሬ ኤኙቱ፣ ‘አት ማሊፍ ዋን ከነ ጎተ?’ ጄዼ እሰ ጋፈቹ ደንደአ?”<verse eid="2SA 16:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 16:11"/>ኤርገሲ ዳዊት አቢሻዪፊ ቆንዳልቶተሳ ሁንዳን አከነ ጄዼ፤ “እልምኮ ከን ጉዴደኮቲ በኤዩ ሉቡኮ በሌሱ በርባደ። ዮስ ነምች ጎሰ ቤንያም ኩን ሀመም ከነ ጫላ ህንጎኔ ሬ! እሰ ዺሳ፤ ዋን <char style="nd">ዋቀዮ</char> እሰ አጀጄፍ እን ነ ሃአባሩ። <verse eid="2SA 16:11"/><verse number="12" style="v" sid="2SA 16:12"/>ተሪ <char style="nd">ዋቀዮ</char> ዽጵነኮ አርጌ አባርሰ አን ሀርአ አባረማ ጅሩ ከነ ዋን ጋሪት ና ጌደረ ተኣ።”<verse eid="2SA 16:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 16:13"/>ከናፉ ዳዊቲፊ ነሞትንሳ ከራሳኒ እት ፉፈን፤ ሽሜኢንሞ እሰ አባራ፣ ዸጋ እት ደርበቻ፣ አዋረስ እት ብትኔሳ ፉሌሳቲን ጋረ ጭነ ዴማ ቱሬ። <verse eid="2SA 16:13"/><verse number="14" style="v" sid="2SA 16:14"/>ሞትቺፊ ነሞትን እሰ ወጅን ቱረን ሁንድ ደዸቢ ጉዳዻን ዹፈኒ አችት ኣረ ገልፈተን።<verse eid="2SA 16:14"/></para>
  <para style="s1">ጎርሰ ኩሲቲፊ አሂቶፌል</para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 16:15"/>ዬሮ ከነትስ አቤሳሎሚፊ ነሞትን እስራኤል ሁንድ ገረ ዬሩሳሌም ዹፈን፤ አሂቶፌልስ እሰ ወጅን ቱሬ። <verse eid="2SA 16:15"/><verse number="16" style="v" sid="2SA 16:16"/>ሁሻይ ነምች ጎሰ አርኪ ምቹን ዳዊት ሱን አቤሳሎም ብረ ዸቄ፣ “ያ ሞቲ በረ በራን ጅራዹ! ያ ሞቲ በረ በራን ጅራዹ!” ጄዼን።<verse eid="2SA 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 16:17"/>አቤሳሎምስ፣ “ጃለል አት ምቹኬቲፍ ቀብዱ ከና? አት ማሊፍ ምቹኬ ወጅን ህንዴምኔ?” ጄዼ ሁሻይን ጋፈቴ።<verse eid="2SA 16:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 16:18"/>ሁሻይሞ አቤሳሎሚን አከነ ጄዼ፤ “ለክ፤ አን ከን ነመ <char style="nd">ዋቀዮ</char>፣ ሰብን ኩኒፊ ነሞትን እስራኤል ሁንድ ፍለተኒ ነንተአ፤ እሰ ወጅንስ ነንጅራዸ። <verse eid="2SA 16:18"/><verse number="19" style="v" sid="2SA 16:19"/>ከና አች አን ኤኙን ተጃጅለ? አን እልመ ተጃጅሉ ህንቀቡ? አን አኩመን አባኬ ተጃጅሌ ሰነ ስእሌ ነንተጃጅለ።”<verse eid="2SA 16:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 16:20"/>አቤሳሎምስ አሂቶፌሊን፣ “ሜ ኑ ጎርስ። ኑ ማል ጎቹ ቀብነ?” ጄዼ።<verse eid="2SA 16:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 16:21"/>አሂቶፌልስ ዴብሴ፣ “ኦል ሴኒቲ ሳጀቶወን አባኬቲ ከኔን እን አከ እሳን መሰራ ሞቲ ኤገኒፍ ዺሴ ብራ ዴሜ ወጅን ጪስ። ኤርገሲ እስራኤሎን ሁንድ አከ አት አባኬ ጅብቴ ዸገአኒ፣ ሀርክ ወረ ስ ወጅን ጅረን ሁንዳስ ንጀባታ” ጄዼን። <verse eid="2SA 16:21"/><verse number="22" style="v" sid="2SA 16:22"/>ከናፉ በንቲ መናረ አቤሳሎሚፍ ዱንካነ ዻበን፤ እንስ እስራኤሎተ ሁንደ ዱረት ሳጀቶወን አባሳ ወጅን ጪሴ።<verse eid="2SA 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 16:23"/>በረ ሰነት ጎርስ አሂቶፌል ኬና ቱሬ አኩመ ዋን ነምን ቶኮ ዋቀ ጋፈቱት እላለመ ቱሬ። አክ እት ዳዊትስ ተኡ አቤሳሎም ጎርሰ አሂቶፌል ሁንደ ዸገኣ ቱረን ከናዸ።<verse eid="2SA 16:23"/></para>
  <chapter eid="2SA 16"/>
  <chapter number="17" style="c" sid="2SA 17"/>
  <para style="p">
    <verse number="1" style="v" sid="2SA 17:1"/>አሂቶፌልስ አቤሳሎሚን አከነ ጄዼ፤ “አን ነሞተ ኩመ ኩዸ ለመ ፍለዼ ሀልከኑመ ከነ ዳዊትን ነንአርአ። <verse eid="2SA 17:1"/><verse number="2" style="v" sid="2SA 17:2"/>አንስ ዬሮ እን ደዸቤ ላፉት እሰ ነንዸአ። ሶዳ እት ቡሴ አከ ነሞትን እሰ ወጅን ጅረን ሁንድስ በቀተን ነንጎዸ። አን ሞትቸ ቆፈ ዸኤ <verse eid="2SA 17:2"/><verse number="3" style="v" sid="2SA 17:3"/>ነሞተሳ ሁንደስ ዴብሴ ስን ፍደ። ዱት ነምቸ አት በርባዱ ሰና ዴብኡ ነመ ሁንዳት ጄቹዸ፤ ኤርገሲ ነሞትን ሁንድኑ ነጋን ጅራቱ።” <verse eid="2SA 17:3"/><verse number="4" style="v" sid="2SA 17:4"/>ከሮር ኩንስ አቤሳሎሚፊ ማንጉዶተ እስራኤል ሁንደት ዋን ጋሪ ፈካቴ።<verse eid="2SA 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 17:5"/>አቤሳሎም ገሩ፣ “ሜ ሁሻይ ነምቸ ጎሰ አርኪ ሰነስ ዋማቲ ዋን እን ጄዹ ሃዸጌኙ” ጄዼ። <verse eid="2SA 17:5"/><verse number="6" style="v" sid="2SA 17:6"/>አቤሳሎም ዬሮ ሁሻይ እሰ ብረ ዹፌት፣ “አሂቶፌል ጎርሰ ከነ ኑ ኬኔረ። ዋን እን ጄዼ ከነ ሃጎኑ? ዮ ተኡ ባቴሞ ያደኬ ኑ ኬን” ጄዼን።<verse eid="2SA 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 17:7"/>ሁሻይስ ዴብሴ አቤሳሎሚን አከነ ጄዼ፤ “ጎርስ አሂቶፌል ኬኔ ዬሮ ከነት ጋሪ ምት። <verse eid="2SA 17:7"/><verse number="8" style="v" sid="2SA 17:8"/>አት አባኬቲፊ ነሞተሳ ንቤክተ፤ እሳን ሎልቶታፊ ወረ አኩመ አማኬተ እልማንሼ ጀላ ፉዸተምቴት ነመ ሶዳችሰኒዸ። ከነረት አባንኬ ሙጠትኖ ወራና ጉዳ ቀበ፤ እን ሀልከን ሀልከን ሎልቶተ ብረ ህንቡሉ። <verse eid="2SA 17:8"/><verse number="9" style="v" sid="2SA 17:9"/>አመሌ እን ሆልቀ ኬሰ ዮካን ለፈ ብራ ዾከቴ ጅረ ተአ። ዮ እን ዱራን ዱርሴ ሎልቶተኬ ዸኤ፣ ነምን ዋኤ ከና ዸገኡ ከምዩ፣ ‘ሎልቶትን አቤሳሎም ዱከ ቡአን ንዹመን’ ጄዼ ኦዴሰ። <verse eid="2SA 17:9"/><verse number="10" style="v" sid="2SA 17:10"/>ኤርገሲሞ ሰበቢ እስራኤሎን ሁንድኑ አከ አባንኬ ነመ ወራና ተኤፊ አከ ወር እሰ ወጅን ጅረንስ ጀጀቦ ተአን ቤከኒፍ ሎልቶትን ጭጭሞን ወር ኦኔንሳኒ አከ ኦኔ ሌንጫ ተኤ ሶዳዻን ዹመን።<verse eid="2SA 17:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 17:11"/>“ኤጋ ወን አን ስ ጎርሱ ከነ፦ እስራኤሎን ለኮብስሳኒ አከ ጭረቸ ቀርቀረ ገላና ባይአቱ ከኔን ዳኒ ሀመ ቤርሼባት አርገመን ሁንድ ስ ብረት ወልት ሃቀበመኒቲ አት እሳን ዱረ ቡኢ ሎለት ሴን። <verse eid="2SA 17:11"/><verse number="12" style="v" sid="2SA 17:12"/>አከሲን ለፈ እን ጅሩት እሰ ዾፍነ፤ አኩመ ፍጤንስ ገነማ ለፈረ ቡኡትስ እሰረ ቡነ። እንስ ተኡ ነሞትንሳ ቶኮዩ ሉቡን ህንሀፈን። <verse eid="2SA 17:12"/><verse number="13" style="v" sid="2SA 17:13"/>ዮ እን ገረ መጋላ ሰናት በቀቴስ፣ እስራኤሎን ሁንድኑ ፉኞ ፍደኒ ሀመ ዸጋን ጥናን ቶኮ ህንሀፍኔት መጋላ ሰነ ገረ ሱሉላት ሀርክፍነ።”<verse eid="2SA 17:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 17:14"/>አቤሳሎሚፊ እስራኤሎን ሁንድኑ፣ “ጎርሰ አሂቶፌል ጫላ ጎርሰ ሁሻይ ነምቸ ጎሰ አርኪ ሰናቱ ወየ” ጄዸን። <char style="nd">ዋቀዮ</char> አቤሳሎም እት በዲሰ ፍዱፍ ጄዼ ጎርሰ አሂቶፌል ጋሪ ሰነ ፋይዳ ዸብሲሴራቲ።<verse eid="2SA 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 17:15"/>ሁሻዪስ አከነ ጄዼ ዛዶቂፊ አብያታር ሉቦተት ህሜ፤ “አሂቶፌል፣ ‘አከሲፊ አከስ ጎዻ’ ጄዼ አቤሳሎሚፊ ማንጉዶተ እስራኤል ጎርሴ ቱሬ፤ አን ገሩ፣ ‘አከናፊ አከነ ጎዻ’ ጄዼን እሳን ጎርሴ። <verse eid="2SA 17:15"/><verse number="16" style="v" sid="2SA 17:16"/>አመ ገረ ዳዊትት ኤርገሞተ ኤርጋቲ፣ ‘አት ሀልከን ከነ ሆልቀወን ገሞጂ ኬሰ ህንቡልን፤ ኡቱ ህንቱርን ጬኢ ዴም፤ ዮ ከና አቺ ሞትቺፊ ነሞትን እሰ ወጅን ጅረን ሁንድኑ ንልቅምፈምቱ’ ጄዻ እት ህማ።”<verse eid="2SA 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 17:17"/>ዬሮ ሰነትስ ዮናታኒፊ አሂመአዝ እዶ ኤን ሮጌል ጄዸሙ ቱረን። እንተል ጦምቦሬን ቶኮ ዸቅጤ እሳንት ህምት ቱርቴ፤ እሳንሞ ዸቀኒ ዳዊት ሞትቸት ህሙ ቱረን፤ እሳን አከ ዬሮ መጋላ ሴነንት ህንአርገምኔፍ ኦፍ ኤገቻ ቱረኒቲ። <verse eid="2SA 17:17"/><verse number="18" style="v" sid="2SA 17:18"/>ገሩ ደርገጌስ ቶኮ እሳን አርጌ አቤሳሎምት ህሜ። ከናፉ ለማንሳኒዩ ደፈኒ አቺ በአኒ መነ ነምቸ በሁሪም ኬሰ ጅራቱ ቶኮ ሴነን። ነምች ኩንስ ደላሳ ኬሳ ቦለ ቀበ ቱሬ፤ እሳንስ ቦለ ሰነ ኬሰ ልጠን። <verse eid="2SA 17:18"/><verse number="19" style="v" sid="2SA 17:19"/>ኒቲን ነምቸ ሰናስ አፋን ቦልቻ ጉባ ዋ ድሪርስቴ ምዻን አችረ አፍቴ። ነምን ቶኮዩ ዋን ከነ ህንቤክኔ።<verse eid="2SA 17:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 17:20"/>ነሞትን አቤሳሎም ዮሙ ዱበርትቲ ብረ መነ ዹፈንት፣ “አሂመአዚፊ ዮናታን ሜሬ?” ጄዸኒ ጋፈተን።</para>
  <para style="p" vid="2SA 17:20">ዱበርትቲንስ፣ “እሳን ለገ ጬአኒ ዴመኒሩ” ጄቴ እሳኒፍ ዴብፍቴ። ጀርስ በርባደኒ እሳን ዸበን፤ ከናፉ ዬሩሳሌምት ዴብአን።<verse eid="2SA 17:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 17:21"/>ኤርገ ነሞትን አቤሳሎም ዴመኒ ቦዴ አሂመአዚፊ ዮናታን ቦለ ኬሳ ኦል በአኒ ዳዊት ሞትቸት ህሙ ዸቀን። እሳንስ፣ “አሙመ ከነ ከኢቲ ለገ ጬእ፤ አሂቶፌል፣ ‘አከሲፊ አከስ ጎዻ’ ጄዼ ስረት እሳን ጎርሴራ” ጄዸኒን። <verse eid="2SA 17:21"/><verse number="22" style="v" sid="2SA 17:22"/>ከናፉ ዳዊቲፊ ነሞትንሳ ሁንድ ከአኒ ዮርዳኖስን ጬአን። ዬሮ ለፍት በሪቴት ነምን ኡቱ ዮርዳኖስን ህንጬእን ሀፌ ቶኮዩ ህንቱሬ።<verse eid="2SA 17:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 17:23"/>አሂቶፌልስ ዮሙ አከ ጎርስሳ ፉዸተመ ዸቤ ቤኬት ሀሬሳ ፌአቴ ገረ መጋላ እዶ መነ ጅሬኘሳት ቀጄሌ። እንስ ኤርገ መነሳ ቶቶልፈቴ ቦዴ ኦፍ ፈንሴ። አከሲንስ ዱኤ አዋለ አባሳ ኬሰት አዋለሜ።<verse eid="2SA 17:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 17:24"/>ዳዊት ገረ መሀነዪም ዴሜ፤ አቤሳሎምሞ ነሞተ እስራኤል ሁንደ ወጅን ዮርዳኖስን ጬኤ። <verse eid="2SA 17:24"/><verse number="25" style="v" sid="2SA 17:25"/>አቤሳሎምስ አማሳ ቆደ ዮኣብ አጀጃ ሎልቶታ ጎዼ ሙዴ፤ አማሳን ኩን እልመ ነምቸ ጎሰ እስራኤል ከን ይትራ ጄዸሙ እሰ አቢገዪል ሃዸ ዮኣብ፣ ኦቦሌቲ ዜሩያ፣ እንተለ ናኣሽ ሰነ ፉዼ ቱሬ። <verse eid="2SA 17:25"/><verse number="26" style="v" sid="2SA 17:26"/>እስራኤሎትኒፊ አቤሳሎም ብየ ግልኣድ ኬሰ ቁበተን።<verse eid="2SA 17:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 17:27"/>ዮሙ ዳዊት መሀነዪም ገኤትስ፣ ሾቢን እልም ናሃሽ ነምች ጎሰ አሞን ከን ረባዻ ዹፌ፣ ማኪር እልም አሚኤል ከን ሎዴባሪ ዹፌፊ በርዝላዪን ነምች ጎሰ ግልኣድ ከን ሮጌሊሚ ዹፌ <verse eid="2SA 17:27"/><verse number="28" style="v" sid="2SA 17:28"/>አፈተ፣ ወጪቲፊ ምኦተ ሱጴራ ሆጄተመን ፍደን። አከሱመስ አከ እሳን ኛተኒፍ ቀመዲፊ ገርቡ፣ ዳኩፊ አካዪ፣ ባቄላፊ ምስረ፣ <verse eid="2SA 17:28"/><verse number="29" style="v" sid="2SA 17:29"/>ደማፊ እትቱ፣ ሆሎታፊ ባዱ ኣነን ሎን ዳዊቲፊ ነሞተሳቲፍ ፍደን። እሳንስ፣ “ነሞትን ለፈ ገሞጂት ቤለአኒሩ፣ ደዸበኒሩ፣ ዼቦተኒሩስ” ጄዸኒ ቱረኒቲ።<verse eid="2SA 17:29"/></para>
  <chapter eid="2SA 17"/>
  <chapter number="18" style="c" sid="2SA 18"/>
  <para style="s1">አቤሳሎም ዱኡሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 18:1"/>ዳዊት ነሞተ እሰ ወጅን ቱረን ለካኤ አጀጁወን ኩማቲፊ አጀጁወን ዽባ ሙዴፍ። <verse eid="2SA 18:1"/><verse number="2" style="v" sid="2SA 18:2"/>ዳዊትስ ሀርከ ሰዲ ኬሳ ሀርከ ቶኮ አጀጀ ዮኣብ ጀለት፣ ሀርከ ቶኮ አጀጀ አቢሻይ ኦቦሌሰ ዮኣብ እልመ ዜሩያ ጀለት፣ ሀርከ ቶኮሞ አጀጀ እታዪ ነምቸ ግቲ ጀለት ህሪርሴ ቦባሴ። ሞትችስ ሎልቶታን፣ “አን መታንኮ ዹጉማን እስን ወጅን ነንበአ” ጄዼ።<verse eid="2SA 18:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 18:3"/>ነሞትን ገሩ አከነ ጄዸኒን፤ “አት ዴሙ ህንቀብዱ፤ ዮ ኑ በቀቹፍ ድርቀምኔ እሳን ዋኤኬኘ ዽመ ህንቀበን፤ ዮ ወለካንኬኘስ ዹምኔ እሳኒፍ ሆማ ምት፤ አት ገሩ ነመ አከኬኛ ኩመ ኩዸን ጫልተ። ከናፉ አት ዮ መጋላ ኬሰ ቱርቴ ኑ ገርጋርቴ ወየ።”<verse eid="2SA 18:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 18:4"/>ሞትችስ፣ “አን ዋን ጋሪ እስንት ፈካቴ ከምዩ ነንጎዸ” ጄዼ ዴብሴ።</para>
  <para style="p" vid="2SA 18:4">ከናፉ ሞትች ዬሮ ሎልቶትን ሁንድ ገሬ ዽባቲፊ ገሬ ኩማቲን ቀጄለንት ከረ ብረ ዻበቻ ቱሬ። <verse eid="2SA 18:4"/><verse number="5" style="v" sid="2SA 18:5"/>ሞትችስ ዮኣብ፣ አቢሻዪፊ እታዪን፣ “አናፍ ጄዻቲ አቤሳሎም ደርገጌስቻፍ ገራ ላፋ” ጄዼ አጀጄ። ሎልቶትን ሁንድኑስ አጀጀ ዳዊት ዋኤ አቤሳሎም አጀጆታፍ ኬኔ ዸገአን።<verse eid="2SA 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 18:6"/>ሎልቶትንስ እስራኤልን ወራኑፍ ድሬ ወራናት በአን፤ ሎልስ ቦሶነ ኤፍሬም ኬሰት ከኤ። <verse eid="2SA 18:6"/><verse number="7" style="v" sid="2SA 18:7"/>አችትስ ሎልቶትን እስራኤል ሎልቶተ ዳዊቲን ዸአመን፤ ሁባቲን ጋፈሲስ አከ መሌ ጉዳ ቱሬ፤ ነሞተ ኩመ ድግደመቱ ዹሜ። <verse eid="2SA 18:7"/><verse number="8" style="v" sid="2SA 18:8"/>ሎል ሱንስ ጉቱማ ባድያት በበልአቴ፤ ነሞተ ጎራዴን ፍጤ ጫላ ከን ቦሶን ልቅምሴ ሀምብሴቱ ባይአተ።<verse eid="2SA 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 18:9"/>አቤሳሎም ዬሮ ከነት አከ ተሳ ነሞተ ዳዊትት ዹፌ። እንስ ጋንጎሳ ያበቴ ዴማ ቱሬ፤ ኡቱመ ጋንጎንሳ ደሜሌ ጎቡ ቅልጡ ጉዳ ቶኮ ጀለ ደርባ ጅርቱ መታን አቤሳሎም ሙከ ኬሰት ቀበሜ። እንስ ቅሌንሰረት ረረኤ ሀፌ፤ ጋንጎን እን ያበቴ ቱሬ ሱን ገሩ ዴምሰሼ እቱመ ፉፍቴ።<verse eid="2SA 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 18:10"/>ነምች ቶኮ ዮሙ ዋን ከነ አርጌት፣ “አን አከ አቤሳሎም ሙከ ቅልጡት ረረኤ ጅሩ አሙመ አርጌረ” ጄዼ ዮኣብት ህሜ።<verse eid="2SA 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 18:11"/>ዮኣብስ ነምቸ ዋን ከነ እሰት ህሜን፣ “ማል ጄተ! አት እሰ አርግቴርታ? ማሊፍ አቹመት ሩኩቴ ለፋን እሰ ዸኡ ዺፍቴ? ስላ አን ሜቲ ሰቅሊ ኩዸኒፊ ሰበተ ጀግኑማ ስን በዻሰ ቱሬ” ጄዼ።<verse eid="2SA 18:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2SA 18:12"/>ነምች ሱን ገሩ፣ አከነ ጄዼ ዴብሴ፤ “ኡቱ ሰቅሊን ኩመ ቶኮ ሀርከኮት ናፍ ሰፈረሜዩ አን እልመ ሞቲት ሀርከኮ ኦል ህንፉዸዹ። ሞትች ኡቱ ኑ ዸጌኙ ስእ፣ አቢሻዪፊ እታዪን፣ ‘አናፍ ጄዻቲ አቤሳሎም ደርገጌስቸ ኤጋ’ ጄዼ አጀጄረ። <verse eid="2SA 18:12"/><verse number="13" style="v" sid="2SA 18:13"/>ከራ ብራሞ ኡቱ አን ኩተዼ ሉቡሳ በሌሴ፣ ሰበቢ ወንት ሞትቸ ዱራ ዾከቱ ቶኮዩ ህንጅሬፍ አት መታንኬዩ ነት ህንዽኣቱ ቱሬ።”<verse eid="2SA 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 18:14"/>ዮኣብስ፣ “ከነ ቦዴ አን ሃለ ከናን ስ ወጅን ዬሮ በሌሱ ህንቀቡ” ጄዼ። ከናፉ አንካሴ ሰዲ ሀርከት ቀበቴ ኡቱመ አቤሳሎም ሙከ ቅልጡት ረረኤ ሉቡን ጅሩ ገራሳት ድሬ። <verse eid="2SA 18:14"/><verse number="15" style="v" sid="2SA 18:15"/>ወር ዮኣቢፍ ምአ ሎላ ባተን ኩርነንስ እት ናነአኒ አቤሳሎምን ዸአኒ አጄሰን።<verse eid="2SA 18:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2SA 18:16"/>ከነረት ዮኣብ መለከተ አፉፌ፤ ሎልቶትንስ ሰበቢ እን እሳን ዾዌፍ እስራኤልን አርኡ ንዺሰን። <verse eid="2SA 18:16"/><verse number="17" style="v" sid="2SA 18:17"/>እሳንስ ሬፈ አቤሳሎም ፉዸኒ ቦሶነ ኬሰት ቦለ ጉዳ ቶኮት ደርበተኒ ዸጋ ጉርጉዳ እሰረ ቱለን። ዬሮ ከነት እስራኤሎን ሁንድ ገረ መነሳኒት በቀተን።<verse eid="2SA 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 18:18"/>አቤሳሎም ዬሮ ሉቡን ቱሬት፣ “አን እልመ መቃኮ ዋምስሱ ህንቀቡ” ጄዼ እዶ ሱሉለ ሞቲ ጄዸሙት ያደኖ ኦፊቲፍ ሶዱ ዻበቴ። ሶዱ ሰነስ መቃ ኦፊሳቲን ሞጋሴ። ሀመ ሀርኣትሌ ሶዱን ሱን ሶዱ አቤሳሎም ጄዸሜ ዋመመ።<verse eid="2SA 18:18"/></para>
  <para style="s1">ገደ ዳዊት</para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 18:19"/>አሂመአዝ እልም ዛዶቅ፣ “አን ዸቄ አከ <char style="nd">ዋቀዮ</char> ሀርከ ዲኖተሳ ጀላ እሰ ባሴ ሞትቸት ነንህመ” ጄዼ።<verse eid="2SA 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 18:20"/>ዮኣብሞ፣ “ነምን ሀርአ ዸቄ ህሙ ስኢ ምት፤ ሰበቢ እልም ሞትቻ ዱኤፍ አት ዬሮ ብራ ዸቅጤ እት ህምተ፤ ገሩ ሀርአ ዋን ከነ ጎቹ ህንቀብዱ” ጄዼን።<verse eid="2SA 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 18:21"/>ኤርገሲስ ዮኣብ ኩሺዻን፣ “ዸቂቲ ዋን አርግቴ ሞትቸት ህም” ጄዼ። ኩሺንስ ፉለ ዮኣብ ዱረት ገድ ጄዼ ሀርከ ፉዼ ፊጋ ቀጄሌ።<verse eid="2SA 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 18:22"/>አሂመአዝ እልም ዛዶቅ አመስ ዮኣቢን፣ “ወን ፌዼ ሃዹፉ፤ ማሎ አንስ ኩሺ ፋነ ነንፊገ” ጄዼ።</para>
  <para style="p" vid="2SA 18:22">ዮኣብ ገሩ፣ “ያ እልመኮ፣ አት ማሊፍ ዸቁ በርባደ? አት ኦዱ በዻሰ ሲፍ ኬንሲሱ ቶኮዩ ህንቀብዱ” ጄዼን።<verse eid="2SA 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2SA 18:23"/>እንሞ፣ “ወን ፌዼ ሃዹፉ፤ አን ፊጉ ነንበርባደ” ጄዼ።</para>
  <para style="p" vid="2SA 18:23">ከናፉ ዮኣብ፣ “ፊግ!” ጄዼን። ኤርገሲ አሂመአዝ ከራ ድሬቲን ፊጌ ኩሺ ብረ ደርቤ።<verse eid="2SA 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 18:24"/>አዶ ዳዊት ከረ አላቲፊ ከን ኬሳ ግዱ ታኤ ጅሩ ኤግዱን ከራ ዻበ ጉባ መናቲን ከራት ኦል በኤ። እንስ አች እላሌ ነመ ኮጳሳ ፊጉ ቶኮ አርጌ። <verse eid="2SA 18:24"/><verse number="25" style="v" sid="2SA 18:25"/>ኤግዱን ሱንስ ሞትቸ ዋሜ ዋን ከነ እት ህሜ።</para>
  <para style="p" vid="2SA 18:25">ሞትችስ፣ “እን ዮ ኮጳሳ ተኤ፣ ኦዱ ጋሪ ፍዱ ቀበ” ጄዼ። ነምች ሱንስ ዽኣቻ ዹፌ።<verse eid="2SA 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 18:26"/>ኤርገሲስ ኤግዱን ሱን ኡቱ ነምን ብራ ፊጉ አርጌ ኤግዱ ከራ ዋሜ፣ “ኩኖ ነምን ብራ ቶኮ ኮጳሳ ፊጋ ጅረ!” ጄዼን።</para>
  <para style="p" vid="2SA 18:26">ሞትችስ፣ “እንስ ኦዱ ጋሪ ፍዱ ቀበ” ጄዼ።<verse eid="2SA 18:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2SA 18:27"/>ኤግዱን ሱንስ፣ “እን ጀልቀባ ዋን አከ አሂመአዝ እልመ ዛዶቅት ፊጉ ነት ፈካተ” ጄዼ።</para>
  <para style="p" vid="2SA 18:27">ሞትችሞ፣ “እን ነመ ጋሪዸ፤ ኦዱ ጋሪ ፍዴ ዹፈ” ጄዼ።<verse eid="2SA 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2SA 18:28"/>አሂመአዝ ሞትቸ ዋሜ፣ “ወን ሁንድኑ ጋሪዸ” ጄዼ፤ ፉለ ሞትቻ ዱረትስ አዳን ለፈት ጎምብፈሜ፣ “<char style="nd">ዋቀዮ</char> ዋቅንኬ ገለተ ሃአርገቱ፤ እን ወረ ጎፍታኮ ሞትቸት ሀርከሳኒ ኦል ፉዸተን ደበርሴ ኬኔራቲ” ጄዼ።<verse eid="2SA 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 18:29"/>ሞትችሞ፣ “አቤሳሎም ደርገጌስች ጀላ በኤራ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="2SA 18:29">አሂመአዝስ፣ “ዬሮ ዮኣብ ገርብቸ ሞትቻቲፊ አነ ገርብቸኬ ኤርጉፍ ከኤት ራፈመ ጉዳቱ ቱሬ። ገሩ ወን ሱን ማል አከ ተኤ አን ህንቤኩ” ጄዼ ዴብሴ።<verse eid="2SA 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 18:30"/>ሞትችስ፣ “አስ ሂቂ ዻበዹ” ጄዼ። ከናፉ እን አች ሂቄ ዻበቴ።<verse eid="2SA 18:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 18:31"/>ኤርገሲስ ኩሺን ዹፌ፣ “ጎፍታኮ ያ ሞቲ፣ ኦዱ ገመቺሳ ዸገእ! <char style="nd">ዋቀዮ</char> ሀርአ ወረ ስት ከአን ሁንደ ጀላ ስ ባሴረ” ጄዼ።<verse eid="2SA 18:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="2SA 18:32"/>ሞትችስ ኩሺዻን፣ “አቤሳሎም ደርገጌስች ጀላ በኤራ?” ጄዼ ጋፈቴ።</para>
  <para style="p" vid="2SA 18:32">ኩሺንስ፣ “ዲኖትን ጎፍታኮ ሞትቻቲፊ ወር ስ ሚዹፍ ስት ከአን ሁንድ አኩመ ደርገጌሰ ሰና ሃተአን” ጄዼ ዴብሴ።<verse eid="2SA 18:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="2SA 18:33"/>ሞትች ንሆለቴ። ኩታ መና ከን ከረ ዱራ ጉባትስ ኦል በኤ ቦኤ። ዮሙ ኦል በኡትስ፣ “ያ እልመኮ አቤሳሎም! እልመኮ፣ እልመኮ አቤሳሎም! ኡቱ ቆደኬ አን ዱኤ ጅራዼ፤ ያ አቤሳሎም እልመኮ፣ ያ እልመኮ!” ጄዼ።<verse eid="2SA 18:33"/></para>
  <chapter eid="2SA 18"/>
  <chapter number="19" style="c" sid="2SA 19"/>
  <para style="p">
    <verse number="1" style="v" sid="2SA 19:1"/>ዮኣብትስ፣ “ዳዊት ሞትች አቤሳሎሚፍ ቦኡፊ ገዱት ጅረ” ጄዸሜ ህመሜ። <verse eid="2SA 19:1"/><verse number="2" style="v" sid="2SA 19:2"/>ሰበቢ ጉቱማን ሎልቶታ ኦዱ፣ “ሞትች እልመሳቲፍ ገዳ ጅረ” ጄዹ ዸገኤፍ ሞእች ጋፈ ሰና ገደት ጌደረሜ። <verse eid="2SA 19:2"/><verse number="3" style="v" sid="2SA 19:3"/>ጋፈ ሰነ ሰብን ሁንድስ አኩመ ሎልቶተ ሞአተመኒ ቃነኡዻን በቀተኒ መጋላ ሴነኒት ቃነኤ መጋላ ሴኔ። <verse eid="2SA 19:3"/><verse number="4" style="v" sid="2SA 19:4"/>ሞትችስ ፉለሳ ሀጉገቴ፣ “ያ እልመኮ አቤሳሎም! ያ አቤሳሎም እልመኮ፣ ያ እልመኮ!” ጄዼ ሰገሌ ኦል ፉዸቴ ቦኤ።<verse eid="2SA 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 19:5"/>ዮኣብ ገረ ሞትቻ መነ ኦል ሴኔ አከነ ጄዼ፤ “አት ሀርአ ፉለ ነሞተኬ ከኔን ሉቡኬ፣ ሉቡ እልማንኬቲቲፊ እንተለንኬቲ፣ ሉቡ ኒቶተኬቲቲፊ ሳጀቶወንኬቲ ኦልቸን ሰነ ሁንዳ ቃኒዻን ሀጉግዴርተ። <verse eid="2SA 19:5"/><verse number="6" style="v" sid="2SA 19:6"/>አት ወረ ስ ጅበን ጃለቴ ወረ ስ ጃለተንሞ ጅብቴርተ። አት አከ አጀጆተ ሎልቶተኬቲቲፊ ነሞተሳኒ ወይቱ ህንሄድኔ ሀርአ ምርከኔስቴርተ። ሀርአ ኡቱ ሁንድኬኘ ዱኔ አቤሳሎም ጅራቴ አት አከ ገመዱ አን ነንአርገ። <verse eid="2SA 19:6"/><verse number="7" style="v" sid="2SA 19:7"/>አመ ገድ በኢቲ ነሞተኬ ጀጀቤስ። ዮ አት ገድ በኡ ባቴ አከ ኤደነ ነምን ቶኮዩ ስ ብረት ህንሀፍኔ አን መቃ <char style="nd">ዋቀዮቲን</char> ነንከከዸ። ኩንሞ ረክነ አት እጆሉማኬቲ ጀልቀብዴ ሀመ አማት ኬሰ ደበርቴ ሁንደ ጫላ ሀማተ።”<verse eid="2SA 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 19:8"/>ከናፉ ሞትች ከኤ ከረ ዱረ ታኤ። ነሞትን ሁንድኑስ ዮሙ፣ “ሞትች ከረ ዱረ ታኤ ጅረ” ጄዸሜ እት ህመሜት እሰ ብረ ዹፈን።</para>
  <para style="p" vid="2SA 19:8">ዬሮ ሰነት እስራኤሎን ሁንድ ገረ መነሳኒት በቀተኒ ቱረን።<verse eid="2SA 19:8"/></para>
  <para style="s1">ዳዊት ዬሩሳሌምት ዴብኤ</para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 19:9"/>ጉቱማ ጎሶተ እስራኤል ኬሰት ነሞትን ሁንድኑ አከነ ጄዸኒ ወል ፈልማ ቱረን፤ “ሞትች ሀርከ ዲኖተኬኛ ጀላ ኑ ባሴረ፤ ነምን ሀርከ ፍልስጤሞታ ጀላ ኑ ባሴስ እሱመ። አመ ገሩ እን ሰበቢ አቤሳሎሚቲፍ ብያ በቀቴረ፤ <verse eid="2SA 19:9"/><verse number="10" style="v" sid="2SA 19:10"/>አቤሳሎም እን ኑ አከ እን ቡልቻኬኘ ተኡፍ ጄኔ ድብኔ ሱንሞ ሎለረት ዱኤረ። ከናፉ ዋኤ ሞትቸ አስ ዴብሱረት እስን ማሊፍ ዋን ቶኮ ህንመርአትኔ?”<verse eid="2SA 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 19:11"/>ዳዊት ሞትችስ አከነ ጄዼ ኤርጋ ከነ ዛዶቂፊ አብያታር ሉቦተት ኤርጌ፤ “አከነ ጄዻቲ ማንጉዶተ ይሁዳ ጋፈዻ፤ ‘ወን ጉቱማ እስራኤል ኬሰት ኦዴፈማ ጅሩ ጉረ ሞትቻ ቀቀቤራቲ እስን ማሊፍ ሞትቸ መነ ሞቱማሳት ዴብሱረት ዱበት ሀፍተን? <verse eid="2SA 19:11"/><verse number="12" style="v" sid="2SA 19:12"/>እስን ኦቦሎተኮ፣ ፎንኮቲፊ ዺገኮት፤ ዮስ ሞትቸ ፍዱረት ማሊፍ ዱበት ሀርክፈተንሬ?’ <verse eid="2SA 19:12"/><verse number="13" style="v" sid="2SA 19:13"/>አማሳንስ፣ ‘አት ፎኒፊ ዺገኮ ምቲ? ዮ አን አማ ጀልቀቤ እዶ ዮኣብ አጀጃ ሎልቶተኮ ስ ጎቹ ባዼ፣ ዋቅን ዋን ሀማ ነት ሃፍዱ፤ ዋን ጫሉሌ ነት ሃፍዱ።’ ”<verse eid="2SA 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 19:14"/>ሞትችስ አኩመ ገራ ነመ ቶኮት ገራ ነሞተ ይሁዳ ሁንዳ ቦጅኤ። እሳንስ፣ “ነሞተኬ ሁንደ ወጅን ዴብእ” ጄዸኒ ሞትቸት ኤርገን። <verse eid="2SA 19:14"/><verse number="15" style="v" sid="2SA 19:15"/>ሞትችስ ብየት ዴብኤ ሀመ ዮርዳኖስት ዹፌ።</para>
  <para style="p" vid="2SA 19:15">ነሞትን ይሁዳስ ሞትቸ ስመተኒ ዮርዳኖስን ጬስሰኒ ፍዱፍ ሀመ ግልጋልት ዹፈን። <verse eid="2SA 19:15"/><verse number="16" style="v" sid="2SA 19:16"/>ሽሜኢን ነምች በሁሪም እልም ጌራ ከን ጎሰ ቤንያም ሱንስ ሞትቸ ስመቹፍ ነሞተ ይሁዳ ወጅን ደፌ ገድ ቡኤ። <verse eid="2SA 19:16"/><verse number="17" style="v" sid="2SA 19:17"/>እሰ ወጅንስ ቤንያሞተ ኩመ ቶኮ አከሱመስ ዚባ ተጃጅላ ማቲ ሳኦል፣ እልማንሳ ኩዸ ሸነኒፊ ሆጄቶተሳ ድግደመቱ ቱሬ። እሳንስ ሞትቸ ዱርሰኒ ዮርዳኖስን ጬአን። <verse eid="2SA 19:17"/><verse number="18" style="v" sid="2SA 19:18"/>እሳንስ ማቲ ሞትቻ ስመቹፊ ዋን እን በርባዱ እሳፍ ጎቹፍ መልካ ጬአን።</para>
  <para style="p" vid="2SA 19:18">ሽሜኢን እልም ጌራ ዮሙ ዮርዳኖስን ጬኤት ሞትቸ ዱረት ኩፌ <verse eid="2SA 19:18"/><verse number="19" style="v" sid="2SA 19:19"/>አከነ እሳን ጄዼ፤ “ጎፍታንኮ በሌሳ ነት ህንሄሬግን። በሌሳ ገርብችኬ ዬሮ አት ጎፍታንኮ ሞትች ዬሩሳሌሚ ባቴት ሆጄቴ ገራት ህንቀበን። ሞትች ዋን ሰነ ያደሳ ኬሳ ሃባሱ። <verse eid="2SA 19:19"/><verse number="20" style="v" sid="2SA 19:20"/>አን ገርብችኬ ጩቡ ሆጄቹኮ ቤካቲ፤ ሀርአ ገሩ አን መነ ዮሴፍ ሁንደ ኬሳ ጎፍታኮ ሞትቸ ስመቹፍ ነመ ጀልቀባ ተኤ ዹፌረ።”<verse eid="2SA 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 19:21"/>አቢሻይ እልም ዜሩያስ፣ “ሽሜኢን ሰበቢ ነመ <char style="nd">ዋቀዮ</char> ድቤ አባሬፍ አመ ዱኡን እሳፍ ህንመሉ?” ጄዼ።<verse eid="2SA 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 19:22"/>ዳዊትሞ ዴብሴ፣ “ያ እልማን ዜሩያ አኒፊ እስን ማል ወልራ ቀብነ? እስን ዬሮ አማ ዲኖተ ነት ታተኒርቱ! ሀርአ ነምን ቶኮዩ እስራኤል ኬሰት አጄፈሙ ቀባ? አን ጉያ ሀርኣ እስራኤልረት ሞቲ ተኡኮ ህንቤኩ?” ጄዼ። <verse eid="2SA 19:22"/><verse number="23" style="v" sid="2SA 19:23"/>ከናፉ ሞትች ሽሜኢዻን፣ “አት ዱኡ ህንቀብዱ” ጄዼ። ከነስ ከካዻን ምርከኔሴፍ።<verse eid="2SA 19:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 19:24"/>ሜፊቦሼት አካከዩን ሳኦልስ ሞትቸ ስመቹፍ ገድ ቡኤ። እን ጋፈ ሞትች ዬሩሳሌሚ በኤ ጀልቀቤ ሀመ ሞትች ዴብኡት ሚለሳቲፍ ኤጉምሰ በርባችሳ ህንጎኔ ዮካን አሬደ ህንሃደትኔ ዮካን ኡፈተሳ ህንሚጨትኔ ቱሬ። <verse eid="2SA 19:24"/><verse number="25" style="v" sid="2SA 19:25"/>ዬሮ እን ሞትቸ ስመቹፍ ዬሩሳሌሚ ዹፌትስ ሞትች፣ “ሜፊቦሼት፣ አት ማሊፍ ነ ወጅን ህንዴምኔ?” ጄዼ እሰ ጋፈቴ።<verse eid="2SA 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2SA 19:26"/>እንስ አከነ ጄዼ ዴብሴ፤ “ያ ጎፍታኮ ሞትቸ፣ አን ገርብችኬ ዋነን ናፈ ተኤፍ፣ ‘አከ አን ያበዼ ሞትቸ ፋነ ዴሙ ደንደኡፍ ሀሬንኮ ናፍ ሃፌአሙ’ ጄዼን ቱሬ። ዚባን ተጃጅላንኮ ገሩ ነ ጎዎምሴ። <verse eid="2SA 19:26"/><verse number="27" style="v" sid="2SA 19:27"/>እን ጎፍታኮ ሞትቸ ዱረትስ ገርብቸኬ መቃ በሌሴረ፤ ጎፍታንኮ ሞትች አኩመ ኤርገማ ዋቀዮት፤ ከናፉ ዋን በርባዴ ሁንደ ጎዽ። <verse eid="2SA 19:27"/><verse number="28" style="v" sid="2SA 19:28"/>ስላ ወን ማቲን አባኮቲ ሁንድኑ ሞትቸራ አርገቹ መለን ዱአ ቆፈ ቱሬ። አት ገሩ አነ ገርብቸኬ ወረ ማዲኬራ ኛተን ወጅን ቴስፍቴ። ከነ ጫላ ወን አን አከ ና ጎዸሙፍ ሞትቸ ጋፈቹፍ ምርገ ቀቡ ማሊ?”<verse eid="2SA 19:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2SA 19:29"/>ሞትችስ፣ “ማሊፍ ዱቢ ዼሬስተ? አን አከ አቲፊ ዚባን ለፈ ሁንደ ገርገር ቆደተን አጀጄረ” ጄዼን።<verse eid="2SA 19:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2SA 19:30"/>ሜፊቦሼትሞ ሞትቻን፣ “አመ ኤርገ ጎፍታንኮ ሞትች ነጋን ዴብኤ እን ዋን ሁንደ ሃፉዸቱ” ጄዼ።<verse eid="2SA 19:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="2SA 19:31"/>ነምች ጎሰ ግልኣድ ከን በርዝላይ ጄዸሙ ቶኮስ ሮጌሊሚ ገድ ቡኤ፤ እንስ ሞትቸ ጌጌሱፍ እሰ ወጅን ዮርዳኖስ ጬኤ። <verse eid="2SA 19:31"/><verse number="32" style="v" sid="2SA 19:32"/>በርዝላዪን ጃርሰ ዱሎማ ወጋ ሰዴተመ ቱሬ። እንስ ዋን ነመ ሶሬሰ ቱሬፍ ዬሮ ሞትች መሀነዪም ጅራቴት ዋን እን ኛቱ ዽኤሳፊ ቱሬ። <verse eid="2SA 19:32"/><verse number="33" style="v" sid="2SA 19:33"/>ሞትችስ በርዝላዪን፣ “ገመት ነ ወጅን ጬኢቲ ነ ወጅን ዬሩሳሌም ጅራዹ፤ አንስ ስን ሶራ” ጄዼ።<verse eid="2SA 19:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="2SA 19:34"/>በርዝላዪን ገሩ ሞትቻን አከነ ጄዼ፤ “አን ስአች ወጋ ሀመም ጅራቹፈን ሞትቸ ወጅን ዬሩሳሌም ዸቀ? <verse eid="2SA 19:34"/><verse number="35" style="v" sid="2SA 19:35"/>አን ዬሮ አማ ወጋ ሰዴተመ ጉቴረ። አን ዋን ጋሪፊ ዋን ሀማ አዳን ባሱ ነንደንደኣ? ገርብችኬ ምኣ ኛታፊ ዹጋቲ ቤካ? አመስ ሰገሌ ዺሮታቲፊ ዱበርቶተ ስርበኒ ዸገኡ ደንደኣ? ዮስ ገርብችኬ ማሊፍ ጎፍታኮ ሞትቸት በኣ ደበለማ ተአሬ? <verse eid="2SA 19:35"/><verse number="36" style="v" sid="2SA 19:36"/>ገርብችኬ ሞትቸ ወጅን ዮርዳኖስ ጬኤ ጥኖሼ ንዴመ፤ ሞትች ገሩ ማሊፍ ሃለ ከናን ገለተ ናፍ ዴብሰ? <verse eid="2SA 19:36"/><verse number="37" style="v" sid="2SA 19:37"/>አከ አን ዮን ዱኤ መጋሉመኮት አዋለ አባፊ ሃዸኮ ብረት አዋለሙፍ ገርብቸኬ ዺስ ሃዴብኡ። ገርብችኬ ክምሃም ገሩ ኩኖት። እን ጎፍታኮ ሞትቸ ወጅን ሃጬኡ። አትስ ዋን ጃለቱ ከምዩ እሳፍ ጎዽ።”<verse eid="2SA 19:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="2SA 19:38"/>ሞትችስ፣ “ክምሃም ነ ወጅን ንጬአ፤ አንስ ዋን አት ጃለቱ ከምዩ እሳፍ ነንጎዸ፤ ዋን አት ነራ በርባዱ ከምዩስ ሲፍ ነንጎዸ” ጄዼ።<verse eid="2SA 19:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="2SA 19:39"/>አከሲን ነሞትን ሁንድኑ ዮርዳኖስን ጬአን፤ ሞትችስ ንጬኤ። ሞትችስ በርዝላዪ ዹንገቴ ኤብሴ፤ በርዝላዪንስ ገረ መነሳት ዴብኤ።<verse eid="2SA 19:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="2SA 19:40"/>ዮሙ ሞትች ገረ ግልጋልት ደርቤት ክምሃም እሰ ወጅን ዴሜ። ሎልቶትን ይሁዳ ሁንድኑፊ ወለካን ሎልቶተ እስራኤል ሞትቸ ጬስሰን።<verse eid="2SA 19:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="2SA 19:41"/>ዮሙሱመ ነሞትን እስራኤል ሁንድኑ ገረ ሞትቻ ዹፈኒ፣ “ኦቦሎትንኬኘ ወር ይሁዳ ማሊፍ ኑ ዾክሰኒ ሞትቻፊ ማቲሳ፣ ዱካ ቡቶተ እሰ ወጅን ዮርዳኖስን ጬስሰኒ ፍደን?” ጄዸኒን።<verse eid="2SA 19:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="2SA 19:42"/>ነሞትን ይሁዳ ሁንድስ ዴብሰኒ ነሞተ እስራኤሊን፣ “ኑ ዋን ሞትች ፍረ ዺጋ ኑፍ ተኤፍ ዋን ከነ ጎኔ። እስን ዋኤ ዋን ከና ማሊፍ ኣርቱ? ኑ ዋን ሞትቻ ኬሳ ቶኮሌ ኛትኔራ? ዋን ቶኮሌስ ኦፊኬኛፍ ፉዸኔራ?” ጄዸን።<verse eid="2SA 19:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="2SA 19:43"/>ከነረት ነሞትን እስራኤል ነሞተ ይሁዳቲን፣ “ኑ ሞትቸራ ቆደ ሀርከ ኩዸን ቀብነ፤ ከነ መሌስ ኑ እስን ጫላ ዳዊትራ ምርገ ቀብነ። ዮስ እስን ማሊፍ አከስ ኑ ቱፈቱሬ? አከ ሞቲንኬኘ ኑፍ ዴብኡፍ ከን ዱራን ዱርስኔ ጋፈትኔ ኑ ምቲ?” ጄዸኒ ዴብሰን።</para>
  <para style="p" vid="2SA 19:43">ገሩ ዴቢን ነሞትን ይሁዳ ዴብሰን ከን እስራኤሎታረ ጀባ ቱሬ።<verse eid="2SA 19:43"/></para>
  <chapter eid="2SA 19"/>
  <chapter number="20" style="c" sid="2SA 20"/>
  <para style="s1">ሳቤኤን ዳዊትት ፍንጭሉሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 20:1"/>ዬሮ ከነት ነምች ደባን ሼባ ጄዸሙ፣ እልም ቢክሪ ነምቸ ጎሰ ቤንያም ቶኮ አች ቱሬ። እንስ መለከተ አፉፌ ሰገሌ ጉዳን አከነ ጄዼ እዬ፤</para>
  <para style="q1" vid="2SA 20:1">“ኑ ዳዊትራ ቆደ ህንቀብኑ፤</para>
  <para style="q2" vid="2SA 20:1">እልመ እሴይራ ዻለ ቶኮሌ ህንቀብኑ!</para>
  <para style="q1" vid="2SA 20:1">ያ እስራኤል፣ ቶኮን ቶኮን ነማ ገረ ዱንካነሳት!”<verse eid="2SA 20:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 20:2"/>ከናፉ ነሞትን እስራኤል ሁንድኑ ሼባ እልመ ቢክሪ ሰነ ዱካ ቡኡፍ ጄዸኒ ዳዊትራ ገረገለን። ነሞትን ይሁዳ ገሩ ዮርዳኖሲ ሀመ ዬሩሳሌምት ሞቲሳኒ ወጅን ዴመን።<verse eid="2SA 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 20:3"/>ዳዊትስ ዮሙ መሰራሳ ከን ዬሩሳሌም ኬሳት ዴብኤት፣ ሳጀቶወንሳ ኩርነን አከ እሳን መሰራ ኤገኒፍ ዺሴ ብራ ዴሜ ሰነ ፉዼ መነ ቶኮት ገልቼ አከ እሳን ኤገመን ጎዼ። እን ዋን እሳን ኛተን ኬኔፍ መሌ እሳን ወጅን ህንጪፍኔ። እሳንስ ሀመ ጋፈ ዱአኒት አከ ኒቶተ ዽርሶትንራ ዱአኒት ኮጳ ጅራተን።<verse eid="2SA 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 20:4"/>ኤርገሲስ ሞትች አማሳዻን፣ “ነሞተ ይሁዳ ጉያ ሰዲ ኬሰት ወልት ና ቀብ፤ አትስ አስት አርገም” ጄዼ። <verse eid="2SA 20:4"/><verse number="5" style="v" sid="2SA 20:5"/>አማሳን ገሩ ዮሙ ነሞተ ይሁዳ ዋሙ ዴሜት ዬሮ ሞትች እሳፍ ኬኔ ጫላ ቱሬ።<verse eid="2SA 20:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2SA 20:6"/>ዳዊትስ አቢሻይዻን፣ “ሼባን እልም ቢክሪ ሚዻ አቤሳሎም ኑ ሚዼ ሰነ ጫላ ኑ ሚዸ። አት ነሞተ ጎፍታኬቲ ፉዸዹቲ እሰ አርእ፤ ዮ ከና አቺ እን መጋላ ደአትኖ ቀቡ አርገቴ ኑ ጀላ ምልቀ” ጄዼ። <verse eid="2SA 20:6"/><verse number="7" style="v" sid="2SA 20:7"/>ከናፉ ነሞትን ዮኣቢፊ ኬሬቶትን፣ ጴሌቶትኒፊ ነሞትን ወራና ጀጀቦን ሁንድ አጀጀ አቢሻይ ጀለት ህሪረኒ ቀጄለን። እሳንስ ዬሩሳሌሚ ከአኒ ሼባ እልመ ቢክሪ ሰነ አርኡፍ ቀጄለን።<verse eid="2SA 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 20:8"/>ኡቱመ እሳን ግቤኦን ኬሰ ከታ ጉዳ ብረ ጅረኑ አማሳን እሳን ስመቹፍ ዹፌ። ዮኣብ ኡፈተሳ ከን ወራና ኡፈቴ፤ ቀልቀል ጎራዴንሳ ኬሰ ጅሩስ ሰበታን ሙዺሳት ህዸሜ ቱሬ። አኩመ እን ገረ ፉለ ዱራት ተርካንፈቴንስ ጎራድች ቀልቀለሳ ኬሳ ለፈ ቡኤ።<verse eid="2SA 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 20:9"/>ዮኣብስ አማሳን፣ “ያ ኦቦሌሶ፣ አከም ጅርተ?” ጄዼ። ከነረት ዮኣብ እሰ ዹንገቹፍ ሀርከሳ ምርጋቲን ሀሬደ አሜሳይ ቀበቴ። <verse eid="2SA 20:9"/><verse number="10" style="v" sid="2SA 20:10"/>አሜሳይ አከ ዮኣብ ጎራዴ ሀርካ ቀቡ ህንሁበትኔ ቱሬ፤ ከናፉ ዮኣብ ጎራዴ ሰነ ገራሳት ድሬ፤ መርኡማንሳስ ለፈት ጅጌ። አማሳንስ ኡቱ ለመተ ህንወራነምን ዱኤ። ኤርገሲሞ ዮኣቢፊ ኦቦሌስሳ አቢሻይ ሼባ እልመ ቢክሪ ሰነ አርአን።<verse eid="2SA 20:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 20:11"/>ነሞተ ዮኣብ ኬሳ እን ቶኮ አሜሳይ ብረ ዻበቴ፣ “ነምን ዮኣብን ጃለቱ፣ ከን ገሬ ዳዊት ተኤ ሁንድ ዮኣብን ዱካ ሃቡኡ!” ጄዼ። <verse eid="2SA 20:11"/><verse number="12" style="v" sid="2SA 20:12"/>ዬሮ ከነት ሬፍ አማሳ ዺጋን ፋለሜ ከራረ ጪሰ ቱሬ፤ ነምች ቶኮስ አከ ሎልቶትን ሁንድ አች ዸዻበተን አርጌ። እንስ ዮሙ አከ ወር ገረ አሜሳይ ዹፈን ሁንድ ዸዻበተን አርጌት ከራራ ገረ ለፈ ቆቲሳት እሰ ሀርክሴ ወያረ ቡሴ። <verse eid="2SA 20:12"/><verse number="13" style="v" sid="2SA 20:13"/>ኤርገ ሬፍ አሜሳይ ከራራ ካፈሜ ቦዴ ነሞትን ሁንድኑ ሼባ እልመ ቢክሪ ሰነ አርኡፍ ዮኣብ ፋነ ቀጄለን።<verse eid="2SA 20:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 20:14"/>ሳቤኤንስ ጎሶተ እስራኤል ሁንደ ኬሰ ደርቤ ገረ አቤል ቤት መኣካቲፊ ገረ ብየ ቤሪት ሁንዳ ዸቄ፤ ነሞትን ቤሪትስ ወልት ቀበመኒ እሰ ዱካ ቡአን። <verse eid="2SA 20:14"/><verse number="15" style="v" sid="2SA 20:15"/>ሎልቶትን ዮኣብ ወጅን ቱረን ሁንድኑስ ዹፈኒ አቤል ቤት መኣካት ሳቤኤ መርሰን። እሳንስ ሀመ ከረ መጋላ ሰናት ናኔሰኒ ብዮ ቱለን፤ ዮሙ ደላ መጋላ ሰና ጅግሱፍ ቱማ ቱረንትስ፣ <verse eid="2SA 20:15"/><verse number="16" style="v" sid="2SA 20:16"/>ዱበርቲን ኦጌቲን ቶኮ መጋለቲዻ እሳን ዋምቴ፣ “ዸገኣ! ዸገኣ! አከ አን ዋ እሰት ህሙ ደንደኡፍ ዮኣብ አስ ሃዹፉ እት ህማ” ጄቴ። <verse eid="2SA 20:16"/><verse number="17" style="v" sid="2SA 20:17"/>እን ገረሼ ዸቄ፤ እሼንስ፣ “አት ዮኣቢ?” ጄቴ ጋፈቴ።</para>
  <para style="p" vid="2SA 20:17">እንስ፣ “አን እሱመ” ጄዼ ዴብሴ።</para>
  <para style="p" vid="2SA 20:17">እሼንሞ፣ “ዋን ተጃጅልቱንኬ ዱበቱ ዸገእ” ጄቴ።</para>
  <para style="p" vid="2SA 20:17">እንስ፣ “አን ዸገኣን ጅረ።”<verse eid="2SA 20:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 20:18"/>እሼንስ እት ፉፍቴ አከነ ጄቴ፤ “በረ ዱሪ ነሞትን፣ ‘ገረ አቤል ዸቃ ጎርሰ ጋፈዻ’ ጄዹ ቱሬ፤ አከሲንስ ዱቢን ንዹመ ቱሬ። <verse eid="2SA 20:18"/><verse number="19" style="v" sid="2SA 20:19"/>አን ወረ እስራኤል ኬሰ ነጋፊ አመነሙማን ጅራተን ኬሳ ቶኮዸ። አት መጋላ እስራኤል ኬሰት ሃዸ ታቴ ቶኮ በሌሱፍ ያዳ ጅርተ። አት ማሊፍ ዻለ <char style="nd">ዋቀዮ</char> ልቅምሱ በርባደ?”<verse eid="2SA 20:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 20:20"/>ዮኣብሞ አከነ ጄዼ ዴብሴ፤ “ወን ኩን ነራ ሃፈጋቱ! መጋለቲ በሌሱን ዮካን ልቅምሱን ነራ ሃፈጋቱ! <verse eid="2SA 20:20"/><verse number="21" style="v" sid="2SA 20:21"/>ወን ኩን አከነ ምት። ነምች ሼባ ጄዸሙ እልም ቢክሪ ከን ብየ ጋራ ኤፍሬም ሱን ሞቲት፣ ዳዊትት ሀርከሳ ኦል ፉዸቴረ። ነምቸ ቶክቸ ከነ ደበርሳ ኬና፤ አንስ መጋላ ከነ ገድ ዺሴ ነንበአ።”</para>
  <para style="p" vid="2SA 20:21">ዱበርቲን ሱንስ ዮኣቢን፣ “መታን ነምቸ ሰና ደላ እራን ገድ ሲፍ ደርበተመ” ጄቴ።<verse eid="2SA 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 20:22"/>ኤርገሲ ዱበርቲን ሱን ጎርሰሼ ከን ኦጉማን ጉተሜ ሰናን ነሞተ ሁንደ ብረ ዸቅጤ፤ እሳንስ መታ ሼባ እልመ ቢክሪ ሰና ኩተኒ ዮኣቢፍ ገድ ደርበተን። ከናፉ እን መለከተ አፉፌ፤ ነሞትንሳ መጋለቲ ዺሰኒ ቶኮን ቶኮን ነማ መነ ኦፊሳት ገሌ። ዮኣብሞ ገረ ዬሩሳሌም ሞትቸ ብረት ዴብኤ።<verse eid="2SA 20:22"/></para>
  <para style="b"/>
  <para style="li1">
    <verse number="23" style="v" sid="2SA 20:23"/>ዮኣብ ሎልቶተ እስራኤል ሁንደረት፣</para>
  <para style="li1" vid="2SA 20:23">ቤናያ እልም ዬሆያዳሞ ኬሬቶታፊ ጴሌቶተረት አጀጃ ተኤ፤<verse eid="2SA 20:23"/></para>
  <para style="li1">
    <verse number="24" style="v" sid="2SA 20:24"/>አዶራም ነሞተ ሆጂ ሁምና ሆጄተንረት ሙደሜ፤</para>
  <para style="li1" vid="2SA 20:24">ዬሆሻፋጥ እልም አሂሉድሞ ገልሜሳ ተኤ፤<verse eid="2SA 20:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="2SA 20:25"/>ሼዋን በሬሳ፣</para>
  <para style="li1" vid="2SA 20:25">ዛዶቂፊ አብያታርሞ ሉቦተ ቱረን፤<verse eid="2SA 20:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="2SA 20:26"/>አከሱመስ ኢራስ ነምች ጎሰ ያእር ሱን ሉበ ዳዊት ቱሬ።<verse eid="2SA 20:26"/></para>
  <chapter eid="2SA 20"/>
  <chapter number="21" style="c" sid="2SA 21"/>
  <para style="s1">ሃሎ ባፈቹ ግቤኦኖታ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 21:1"/>ጀበነ ዳዊት ኬሰ ቤል ወጋ ሰዲ ወልት ኣንሴ ቡኤ፤ ከናፉ ዳዊት ፉለ <char style="nd">ዋቀዮ</char> በርባዴ። <char style="nd">ዋቀዮስ</char>፣ “ሰበቢ ሳኦል ግቤኦኖተ አጄሴፍ እሳፊ መነሳረ የከ ዺጋቱ ጅረ” ጄዼ።<verse eid="2SA 21:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 21:2"/>ሞትችስ ግቤኦኖተ ወልት ቀቤ እሳን ወጅን ሃሰኤ። ግቤኦኖትን ሀምባ አሞሮታ ቱረን መሌ እልማን እስራኤሎታ ምት፤ እስራኤሎን አከ እሳን ኤገን ከኩ ሴነኒፍ፤ ሳኦል ገሩ ህናፋ እስራኤሊፊ ይሁዳፍ ቀቡን ግቤኦኖተ በሌሱ በርባዴ ቱሬ። <verse eid="2SA 21:2"/><verse number="3" style="v" sid="2SA 21:3"/>ዳዊትስ፣ “አን ማልን እስኒፍ ጎዸ? አከ እስን ዻለ <char style="nd">ዋቀዮ</char> ኤብፍተኒፍ አን አከምን አራረ ቡሱ ደንደአ?” ጄዼ ግቤኦኖተ ጋፈቴ።<verse eid="2SA 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 21:4"/>ግቤኦኖትንሞ፣ “ኑ ሳኦልራ ሜቲ ዮካን ወርቄ ጋፈቹፍ ምርገ ህንቀብኑ፤ ዮካን አከ ነምን ቶኮዩ እስራኤል ኬሰት ዱኡ ጎቹፍ ኑ ምርገ ቀብና?” ጄዸኒ ዴብሰኒፍ።</para>
  <para style="p" vid="2SA 21:4">ዳዊትስ፣ “አከ አን ማል እስኒፍ ጎዹ በርባዱ?” ጄዼ ጋፈቴ።<verse eid="2SA 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 21:5"/>እሳንስ አከነ ጄዸኒ ሞትቻፍ ዴቢ ኬነን፤ “ነመ አከ ኑ ዲገምኑፊ አከ ኑ እስራኤል ኬሰትስ እዶ ቶኮሌ ህንአርገትኔ ኑ ጎዼ ሰነ፣ <verse eid="2SA 21:5"/><verse number="6" style="v" sid="2SA 21:6"/>ሰኚሳ ኬሳ ዺር ቶርበ ኑፍ ሃኬነመን፤ ኑስ ዸቅኔ ብየ ሳኦል ነምቸ <char style="nd">ዋቀዮ</char> ፍለቴ ሰና፣ ግቤኣት ፉለ <char style="nd">ዋቀዮ</char> ዱረት እሳን ፈንፍና።”</para>
  <para style="p" vid="2SA 21:6">ከናፉ ሞትች፣ “ቶሌ እስኒፍን ኬነ” ጄዼ።<verse eid="2SA 21:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2SA 21:7"/>ሞትች ገሩ ሰበቢ ከኩ <char style="nd">ዋቀዮ</char> ከን ዳዊቲፊ ዮናታን እልመ ሳኦል ግዱት ጎዸሜ ሰናቲፍ ጄዼ ሜፊቦሼት እልመ ዮናታን እልመ ሳኦል ዱአ ጀላ ባሴ። <verse eid="2SA 21:7"/><verse number="8" style="v" sid="2SA 21:8"/>ሞትችስ አርሞኒፊ ሜፊቦሼት እልማን ሪጥጳን እንተል አያ ሳኦሊፍ ዴሴ ለማኒፊ እልማን ሜሮብ እንተል ሳኦል አድሪኤል እልመ በርዝላይ ነምቸ ጎሰ ሜሆላቲፍ ዴሴ ሸነን ጌሴ። <verse eid="2SA 21:8"/><verse number="9" style="v" sid="2SA 21:9"/>እንስ ደበርሴ ግቤኦኖተት እሳን ኬኔ። ጀርስ እሳን አጄሰኒ ጋረ ጉባት ፉለ <char style="nd">ዋቀዮ</char> ዱረት እሳን ፈንሰን። ቶርባንሳኒዩ ወሉማን ዹመን፤ እሳንስ አኩመ ገርቡን ሃመሙ ጀልቀቤን ዬሮ ምዻን ሃመሙት ጉዮተ ጀልቀባት አጄፈመን።<verse eid="2SA 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 21:10"/>ሪጥጳን እንተል አያ ሱን ወያ ገዳ ፉዸቴ ከታረ አፈቴ። እሼንስ ዬሮ ምዻን እት ሃመሙ ጀልቀብዴ ሀመ ቦካን ሬፈ ጀረ አጄፈመኒ ሰነት ሰሚዻ ሮቡት አከ ጉያ ጉያ አላቲን ሰሚ ሀልከንሞ ብኔንሶትን ቦሶና ሬፈ ሰነ ቱቀን ህንኤየምኔ። <verse eid="2SA 21:10"/><verse number="11" style="v" sid="2SA 21:11"/>ወን ሪጥጳን እንተል አያ ሳጀቶን ሳኦል ሱን ሆጄቴ ዳዊትት ህመሜ፤ <verse eid="2SA 21:11"/><verse number="12" style="v" sid="2SA 21:12"/>እንስ ዸቄ ለፌ ሳኦሊፊ ለፌ እልመሳ ዮናታን ነሞተ ያቤሽ ግልኣድ ብራ ፍዴ። እሳን ኦብዲ ቤት ሻን እዶ ፍልስጤሞትን ጋፈ ግልቦኣት ሳኦልን አጄሰን እት ጀረ ፈንሰን ሰና እሳን ሀተኒ ቱረኒቲ። <verse eid="2SA 21:12"/><verse number="13" style="v" sid="2SA 21:13"/>ዳዊትስ ለፌ ሳኦሊፊ ለፌ ዮናታን እልመ ሳኦል አቺ ፍዴ፤ ለፌን ወረ አጄፈመኒ ፈንፈመኒስ ወልት ቀበሜ።<verse eid="2SA 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 21:14"/>እሳንስ ለፌ ሳኦሊፊ ለፌ እልመሳ ዮናታን ብየ ቤንያም ኬሰት፣ እዶ ዜላ ጄዸሙት አዋለ ቂሽ አባ ሳኦል ኬሰት አዋለኒ ዋን ሞትች አጀጄ ሁንደ ጎዸን። ሰነ ቦዴ ዋቅን ከዸትና ዋኤ ብየቲፍ ዽኣቴ ንዸገኤ።<verse eid="2SA 21:14"/></para>
  <para style="s1">ወራነ ፍልስጤሞተት በነሜ</para>
  <para style="r">
    <ref loc="2SA 21:15-22">21፥15‑22</ref> ኩወፈ – <char style="xt"><ref loc="1CH 20:4-8">1ሴና 20፥4‑8</ref></char></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 21:15"/>አመስ ፍልስጤሞታፊ እስራኤል ግዱት ወራን ንከኤ። ዳዊትስ ነሞተሳ ወጅን ፍልስጤሞተ ወራኑፍ ዱሌ፤ እንስ አከ መሌ ደዸቤ። <verse eid="2SA 21:15"/><verse number="16" style="v" sid="2SA 21:16"/>ነምች ጎሰ ራፋ ከን ይሽቢ-ቤኖብ ጄዸሙ ቶኮ ኤቦ ናሲ ከን ኪሎ ግራሚ ሰዲፊ ወለካ ኡልፋቱፊ ጎራዴ ሃራ ህዸቴ ቱሬ፤ እንስ ዳዊትን አጄሱ በርባዴ። <verse eid="2SA 21:16"/><verse number="17" style="v" sid="2SA 21:17"/>አቢሻይ እልም ዜሩያ ገሩ ዳዊትን በራሩ ዹፌ፤ ነምቸ ፍልስጤም ሰነስ ዸኤ አጄሴ። ነሞትን ዳዊትስ፣ “አከ እብሳን እስራኤል ህንዻምኔፍ አት ስአች ኑ ወጅን ወራነ ህንዸቅጡ” ጄዸኒ ከከተኒፍ።<verse eid="2SA 21:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 21:18"/>ኤርገሲሞ ለፈ ጎብ ጄዸሙት ፍልስጤሞተ ወጅን ወራን ብራ ከኤ። ዬሮ ሰነትስ ሲቤካይ ነምች ብየ ሁሻ ነምቸ ሳፍ ጄዸሙ ቶኮ ሰኚ ራፋ ኬሳ አጄሴ።<verse eid="2SA 21:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2SA 21:19"/>ወራነ ብራ ከን ፍልስጤሞተ ወጅን ጎብት ጎዸሜ ኬሰትሞ ኤልሃናን እልም የእሬ ኦሬጊም ነምች ብየ ቤትልሄም ጎልያድ ነምቸ ግቲ ከን ሶማን ኤቦሳ ሎሳ ወየ ዾፍቱ ገኡ ሰነ ንአጄሴ።<verse eid="2SA 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 21:20"/>አመስ ወራነ ጋትት ጎዸሜ ከን ብራ ኬሰት ነምቸ ሀመ ወዪ ገኡ ከን ቶኮ ቶኮ ሀርከሳራ ቁቦተ ጀአ ጀአ አከሱመስ ቶኮ ቶኮ ሚለሳራ ቁቦተ ጀአ ጀአ ወሉመት ቁቦተ ድግደሚ አፉር ቀቡ ቶኮቱ ቱሬ፤ እንስ ሰኚ ራፋ ኬሳ ዸለቴ። <verse eid="2SA 21:20"/><verse number="21" style="v" sid="2SA 21:21"/>ዮሙ እን እስራኤልን ቱቱቄትስ፣ ዮናታን እልም ሽሜኢ ኦቦሌስ ዳዊት እሰ አጄሴ።<verse eid="2SA 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 21:22"/>ጀር አፍረን ኩኔን ሰኚወን ራፋ ወረ ጋት ኬሰ ቱረኒዸ። እሳንስ ሀርከ ዳዊቲፊ ሀርከ ነሞተሳቲን ዹመን።<verse eid="2SA 21:22"/></para>
  <chapter eid="2SA 21"/>
  <chapter number="22" style="c" sid="2SA 22"/>
  <para style="s1">ፋርፈትና ገለታ ከን ዳዊት</para>
  <para style="r">
    <ref loc="2SA 22:1-51">22፥1‑51</ref> ኩወፈ – <char style="xt"><ref loc="PSA 18:1-50">ፋር 18፥1‑50</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 22:1"/>ዳዊት ዮሙ <char style="nd">ዋቀዮ</char> ሀርከ ዲኖተሳ ሁንዳፊ ሀርከ ሳኦል ጀላ እሰ ባሴት ዱቢ ፋርፈትና ከነ <char style="nd">ዋቀዮፍ</char> ፋርፈቴ። <verse eid="2SA 22:1"/><verse number="2" style="v" sid="2SA 22:2"/>እንስ አከነ ጄዼ፦</para>
  <para style="q1" vid="2SA 22:2">“<char style="nd">ዋቀዮ</char> ከታኮት፤ ደአትኖኮቲፊ ኦልቻኮት፤<verse eid="2SA 22:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="2SA 22:3"/>ዋቅንኮ ከታኮ ከን አን ኮሉ እት ገሉዸ፤</para>
  <para style="q2" vid="2SA 22:3">እን ጋቸነኮቲፊ ጋንፈ ፈይነኮት።</para>
  <para style="q1" vid="2SA 22:3">እን ደአትኖኮ ጭማ፣ ኮሉኮቲፊ ፈይሳኮት፤</para>
  <para style="q2" vid="2SA 22:3">አት ነሞተ ሁምናን ነመት ከአን ጀላስ ነ ባስተ።<verse eid="2SA 22:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="2SA 22:4"/>“አን <char style="nd">ዋቀዮ</char> ገለን እሳፍ መሉ ሰነ ነንዋመዸ፤</para>
  <para style="q2" vid="2SA 22:4">ዲኖተኮ ጀላስ ነንበራረመ።<verse eid="2SA 22:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="2SA 22:5"/>ደምበሊን ዱኣ ነ መርሴረ፤</para>
  <para style="q2" vid="2SA 22:5">ሎላን በዲሳስ ነ ልቅምሴረ።<verse eid="2SA 22:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="2SA 22:6"/>ፉኞን ሲኦል ነት መረሜ፤</para>
  <para style="q2" vid="2SA 22:6">ክዮን ዱኣስ ነት ዹፌ።<verse eid="2SA 22:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="2SA 22:7"/>“አን ዽጵነኮ ኬሰት <char style="nd">ዋቀዮን</char> ነንዋመዼ፤</para>
  <para style="q2" vid="2SA 22:7">ዋቀኮት ነንእየዼ።</para>
  <para style="q1" vid="2SA 22:7">እንስ መነ ቁልቁሉማሳቲ ሰገሌኮ ዸገኤ፤</para>
  <para style="q2" vid="2SA 22:7">እይኮስ ጉረሳ ሴኔ።<verse eid="2SA 22:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="2SA 22:8"/>ለፍት ንሆለቴ፤ ንሶቾቴስ፤</para>
  <para style="q2" vid="2SA 22:8">ሁንዴወን ሰሚወኒ ንራፈመን፤</para>
  <para style="q2" vid="2SA 22:8">ሰበቢ እን ዼከሜፍስ እሳን ንሆለተን።<verse eid="2SA 22:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="2SA 22:9"/>ኣር ፉኛንሳቲ ኦል በኤ፤</para>
  <para style="q2" vid="2SA 22:9">እብድ ዋ በርበዴሱ አፋንሳቲ በኤ፤</para>
  <para style="q2" vid="2SA 22:9">ጭሌን ቦበኡስ አፋንሳቲ በኤ።<verse eid="2SA 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="2SA 22:10"/>እን ሰሚወን ተርሳሴ ገድ ቡኤ፤</para>
  <para style="q2" vid="2SA 22:10">ዱሜሶን ጉራችስ ሚለሳ ጀለ ቱረን።<verse eid="2SA 22:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="2SA 22:11"/>እን ኪሩቤልን ያበቴ በርሴ፤</para>
  <para style="q2" vid="2SA 22:11">ቆቾ ቅሌንሳቲንስ ኦል በኤ።<verse eid="2SA 22:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="2SA 22:12"/>እን ዱከነ፣ ዱሜሰ ሰሚ</para>
  <para style="q2" vid="2SA 22:12">ከን ቦካዻን ዱከናኤሞ ጎዶሳ ጎዸቴ።<verse eid="2SA 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="2SA 22:13"/>እፈ ፉለሳ ኬሳስ</para>
  <para style="q2" vid="2SA 22:13">በከካን በለቅሴ በኤ።<verse eid="2SA 22:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="2SA 22:14"/>
    <char style="nd">ዋቀዮ</char> ሰሚዻ ንቀቀዌሰኤ፤</para>
  <para style="q2" vid="2SA 22:14">ሰገሌን ዋቀ ዋን ሁንዳ ኦሊስ ንዸገአሜ።<verse eid="2SA 22:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="2SA 22:15"/>እን ጥየሳ ደርበቴ ዲኖተ ብትኔሴ፤</para>
  <para style="q2" vid="2SA 22:15">በከካስ ገድ ዺሴ እሳን ፍጤ።<verse eid="2SA 22:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="2SA 22:16"/>ዼከምሰ፣ <char style="nd">ዋቀዮቲን</char></para>
  <para style="q2" vid="2SA 22:16">ሁምነ ሀፉረ ፉኛንሳቲ በኡቲንስ</para>
  <para style="q1" vid="2SA 22:16">ሱሉለወን ገላና እፈት ባፈመን፤</para>
  <para style="q2" vid="2SA 22:16">ሁንዴወን ለፋስ ቁላ ሀፈን።<verse eid="2SA 22:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="2SA 22:17"/>“እን ኦል ጉባዻ ገድ ሂጠቴ ነ ቀቤ፤</para>
  <para style="q2" vid="2SA 22:17">ብሻኖተ ገድ ፈጎ ኬሳስ ነ ባሴ።<verse eid="2SA 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="2SA 22:18"/>እን ዲነኮ እሰ ጀባ ጀላ፣ አመጃጆተኮ</para>
  <para style="q2" vid="2SA 22:18">ወረ አከ መሌ ነት ጭመን ጀላስ ነ ባሴ።<verse eid="2SA 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="2SA 22:19"/>እሳን ጉያ ረክነኮት ነት ዹፈን፤</para>
  <para style="q2" vid="2SA 22:19">
    <char style="nd">ዋቀዮ</char> ገሩ ገርጋርሰኮ ቱሬ።<verse eid="2SA 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="2SA 22:20"/>እን እዶ በልኣት ነ ባሴ፤</para>
  <para style="q2" vid="2SA 22:20">ዋን ነት ገመዴፍስ ነ ኦልቼ።<verse eid="2SA 22:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="2SA 22:21"/>“<char style="nd">ዋቀዮ</char> አኩመ ቀጄሉማኮቲት ና ኬኔረ፤</para>
  <para style="q2" vid="2SA 22:21">አኩመ ቁልቁልነ ሀርከኮትስ ነ በዻሴ።<verse eid="2SA 22:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="2SA 22:22"/>አን ከራ <char style="nd">ዋቀዮ</char> ኤጌራቲ፤</para>
  <para style="q2" vid="2SA 22:22">ዋቀኮራ ገረገሌ ሀምነ ህንሆጄትኔ።<verse eid="2SA 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="2SA 22:23"/>ሴርሳ ሁንድኑ ፉለኮ ዱረ ጅረ፤</para>
  <para style="q2" vid="2SA 22:23">አንስ አጀጀሳራ ህንጀልአትኔ።<verse eid="2SA 22:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="2SA 22:24"/>አን ፉለሳ ዱረት ሙዳ ህንቀቡ ቱሬ፤</para>
  <para style="q2" vid="2SA 22:24">ጩቡራስ ኦፍ ኤገዼረ።<verse eid="2SA 22:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="2SA 22:25"/>
    <char style="nd">ዋቀዮ</char> አኩመ ቀጄሉመኮት፣</para>
  <para style="q2" vid="2SA 22:25">አኩመ አን ፉለሳ ዱረት ቁልቁሉ ተኤትስ ነ በዻሴረ።<verse eid="2SA 22:25"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="26" style="v" sid="2SA 22:26"/>“አት ነመ አመነማት አመነሙማኬ አርግሲፍተ፤</para>
  <para style="q2" vid="2SA 22:26">ነመ ሙዳ ህንቀብኔትስ ከን ሙዳ ህንቀብኔ ታተ፤<verse eid="2SA 22:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="2SA 22:27"/>ነመ ቁልቁሉት ቁልቁሉ ታተ፤</para>
  <para style="q2" vid="2SA 22:27">ነመ ጀልኣትሞ ጀልኣ ታተ።<verse eid="2SA 22:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="2SA 22:28"/>አት ወረ ገድ ኦፍ ቀበን ንኦልችተ፤</para>
  <para style="q2" vid="2SA 22:28">ወረ ኦፍ ቱለንሞ ገድ ዴብሱፍ እጅኬ እሳን እላለ።<verse eid="2SA 22:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="2SA 22:29"/>ያ <char style="nd">ዋቀዮ</char>፣ አት እብሳኮት፤</para>
  <para style="q2" vid="2SA 22:29">
    <char style="nd">ዋቀዮ</char> ዱከነኮ እፈት ንጌደረ።<verse eid="2SA 22:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="2SA 22:30"/>አን ገርጋርሰኬቲን ሎልቶተ ዺበዼ ነንዴመ፤</para>
  <para style="q2" vid="2SA 22:30">ዋቀኮቲንስ ደላ ኡታሉ ነንደንደአ።<verse eid="2SA 22:30"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="31" style="v" sid="2SA 22:31"/>“ዋቀ ከነ፣ ከራንሳ ሙዳ ህንቀቡ፤</para>
  <para style="q2" vid="2SA 22:31">ዱቢን <char style="nd">ዋቀዮ</char> ህርእነ ህንቀቡ።</para>
  <para style="q2" vid="2SA 22:31">ወረ እሰት ኮሉ ገለን ሁንዳፍ እን ጋቸነ ተአ።<verse eid="2SA 22:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="2SA 22:32"/>
    <char style="nd">ዋቀዮ</char> መሌ ዋቅን ኤኙ?</para>
  <para style="q2" vid="2SA 22:32">ዋቀኬኘ መሌስ ከታን ኤኙ?<verse eid="2SA 22:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="2SA 22:33"/>ከን ሁምነ ነ ህዸቺሱ፣</para>
  <para style="q2" vid="2SA 22:33">ከን አከ ከራንኮስ ነጋ ተኡ ጎዹ ዋቀ።<verse eid="2SA 22:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="2SA 22:34"/>እን ሚለኮ አከ ሚለ ቦሮፋ ጎዸ፤</para>
  <para style="q2" vid="2SA 22:34">እዶ ኦል ዼራረስ ነ ዻበቺሰ።<verse eid="2SA 22:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="2SA 22:35"/>እን ሀርከኮ ወራናፍ ሌንጅሰ፤</para>
  <para style="q2" vid="2SA 22:35">እሬንኮስ እዳ ናሲ ደብሱ ንደንደአ።<verse eid="2SA 22:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="2SA 22:36"/>አት ገርጋርሰኬ ከን ነመ ፈይሱ ጋቸነ ናፍ ጎተ፤</para>
  <para style="q2" vid="2SA 22:36">ገርጋርስኬስ ነመ ጉዳ ነ ጎዼ።<verse eid="2SA 22:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="2SA 22:37"/>አከ ኮሜንኮ ህንሙጩጫኔፍ፣</para>
  <para style="q2" vid="2SA 22:37">ሚለኮቲፍ ዳንዲ በልእፍቴርተ።<verse eid="2SA 22:37"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="38" style="v" sid="2SA 22:38"/>“አን ዲኖተኮ አርኤ ነንበሌሴ፤</para>
  <para style="q2" vid="2SA 22:38">ሀመ እሳን በርበዳአንትስ አን ዱበት ህንዴብኔ።<verse eid="2SA 22:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="2SA 22:39"/>አን ጉቱማን ጉቱት እሳን ነንበርበዴሴ፤</para>
  <para style="q2" vid="2SA 22:39">እሳን ዴብአኒ ከኡ ህንደንደአን፤</para>
  <para style="q2" vid="2SA 22:39">እሳንስ ሚለኮ ጀለት ንኩፈን።<verse eid="2SA 22:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="2SA 22:40"/>አት ሎላፍ ሁምነ ነ ህዸቺፍቴ፤</para>
  <para style="q2" vid="2SA 22:40">አመጃጆተኮስ ፉለኮ ዱረት ገድ ዴብፍቴ።<verse eid="2SA 22:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="2SA 22:41"/>አከ ዲኖትንኮ ዱግደ ዱበት ዴብአኒ በቀተን ጎቴርተ፤</para>
  <para style="q2" vid="2SA 22:41">አንስ አመጃጆተኮ በርበዴሴረ።<verse eid="2SA 22:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="2SA 22:42"/>እሳን ገርጋርሳፍ እየን፤ ገሩ ከን እሳን ኦልቹ ቶኮዩ ህንቱሬ፤</para>
  <para style="q2" vid="2SA 22:42">ገረ <char style="nd">ዋቀዮትስ</char> ንእየተን፤ እን ገሩ ዴቢ ህንኬንኔፍ።<verse eid="2SA 22:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="2SA 22:43"/>አንስ አኩመ አዋረ ለፋት እሳን ነንዳኬ፤</para>
  <para style="q2" vid="2SA 22:43">ቡሌሴስ አኩመ ዾቄ ዳንዲራት እሳን ዽዺቴ።<verse eid="2SA 22:43"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="44" style="v" sid="2SA 22:44"/>“አት ሎለ ነሞታ ጀላ ነ ባፍቴርተ፤</para>
  <para style="q2" vid="2SA 22:44">መታ ሰቦታ ጎቴ ነ ጅራችፍቴርተ።</para>
  <para style="q1" vid="2SA 22:44">ሰብን አን ህንቤክኔ ነ ተጃጅለ፤<verse eid="2SA 22:44"/></para>
  <para style="q2">
    <verse number="45" style="v" sid="2SA 22:45"/>ነሞትን ኦርማ ነ ሶሶበተን፤</para>
  <para style="q2" vid="2SA 22:45">እሳን አኩመ ዋኤኮ ዸገአኒን ናፍ አጀጀመን።<verse eid="2SA 22:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="2SA 22:46"/>እሳን ሁንድ አብዲ ኩተተን፤</para>
  <para style="q2" vid="2SA 22:46">ሆለቻስ ደአትኖሳኒ ጀባ ኬሳ በአን።<verse eid="2SA 22:46"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="47" style="v" sid="2SA 22:47"/>“<char style="nd">ዋቀዮ</char> ጅራታዸ! ከታንኮ ሃኤብፈሙ!</para>
  <para style="q2" vid="2SA 22:47">ዋቅንኮ፣ ከታን፣ ፈይሳንኮ ኦል ኦል ሃጄዹ!<verse eid="2SA 22:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="2SA 22:48"/>እን ዋቀ ሃሎ ና ባሱ፣</para>
  <para style="q2" vid="2SA 22:48">ከን ሰቦተስ ነ ጀለ ገልቹ፣<verse eid="2SA 22:48"/></para>
  <para style="q2">
    <verse number="49" style="v" sid="2SA 22:49"/>ከን ዲኖተኮ ጀላስ ብልሰ ነ ባሱዸ።</para>
  <para style="q1" vid="2SA 22:49">አት አመጃጆተኮቲ ኦል ነ ጎተ፤</para>
  <para style="q2" vid="2SA 22:49">ጎልቶተ ጀላስ ነ ባፍቴ።<verse eid="2SA 22:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="2SA 22:50"/>ከናፉ ያ <char style="nd">ዋቀዮ</char>፣ አን ሰቦተ ግዱት ስን ሌልሰ፤</para>
  <para style="q2" vid="2SA 22:50">ፋርፈትና ገለታሌ መቃኬቲፍ ነንፋርፈዸ።<verse eid="2SA 22:50"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="51" style="v" sid="2SA 22:51"/>“እን ሞአናወን ጉርጉዳ ሞቲሳቲፍ ንኬነ፤</para>
  <para style="q2" vid="2SA 22:51">ድበማሳ ዳዊቲፊ ሰኚሳቲፍ፣</para>
  <para style="q2" vid="2SA 22:51">አራረ በረ በራ ንአርግሲሰ።”<verse eid="2SA 22:51"/></para>
  <chapter eid="2SA 22"/>
  <chapter number="23" style="c" sid="2SA 23"/>
  <para style="s1">ዱቢ ዳዊት ከን ዹማ</para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 23:1"/>ዱቢን ዳዊት ዹመረት ዱበቴ ከናዸ፦</para>
  <para style="q1" vid="2SA 23:1">“ህመን ዳዊት እልም እሴይ፣</para>
  <para style="q2" vid="2SA 23:1">ህመን ነመ ዋቅን ዋን ሁንዳ ኦሊ፣ ኦል ኦል እሰ ቀቤ፣</para>
  <para style="q1" vid="2SA 23:1">ነመ ዋቅን ያቆብ እሰ ድቤ</para>
  <para style="q2" vid="2SA 23:1">ፋርፈታን እስራኤል ጃለተማን ሱን አከነ ጄዼ፦<verse eid="2SA 23:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="2SA 23:2"/>“ሀፉር <char style="nd">ዋቀዮ</char> ከራኮቲን ዱበቴረ፤</para>
  <para style="q2" vid="2SA 23:2">ዱቢንሳስ አረበኮረ ቱሬ።<verse eid="2SA 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="2SA 23:3"/>ዋቅን እስራኤል ዱበቴረ፤</para>
  <para style="q2" vid="2SA 23:3">ከታን እስራኤል አከነ ናን ጄዼ፦</para>
  <para style="q1" vid="2SA 23:3">‘ነምን ቀጄሉማን ሰበ ቡልቹ፣</para>
  <para style="q2" vid="2SA 23:3">ከን ሶዳ ዋቃቲን ቡልቹ፣<verse eid="2SA 23:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="2SA 23:4"/>እን አከ እፈ ቢፍቱ ገነማ</para>
  <para style="q2" vid="2SA 23:4">ከን እዶ ዱሜስ ህንጅሬት በኡ፣</para>
  <para style="q1" vid="2SA 23:4">አኩመ እፈ አዱ ከን ኤርገ ቦካን ጫሜ ቦዴ</para>
  <para style="q2" vid="2SA 23:4">መርገ ብቅልቹት።’<verse eid="2SA 23:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="2SA 23:5"/>“መንኮ ዋቀ ዱረት ቀጄላ ምቲ?</para>
  <para style="q2" vid="2SA 23:5">እን ከኩ በረ በራ ነ ወጅን ሴኔ</para>
  <para style="q2" vid="2SA 23:5">እሰስ ቀጄልቼ ከራ ሁንዳን ንኤገ ምቲ?</para>
  <para style="q1" vid="2SA 23:5">እሰቱ ፈይነኮ ፊጣን ባሴ</para>
  <para style="q2" vid="2SA 23:5">ፌዺኮ ሁንደስ ናፍ ጉተ ምቲ?<verse eid="2SA 23:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="2SA 23:6"/>ነሞትን ሀሞን ሁንድኑ ገሩ</para>
  <para style="q2" vid="2SA 23:6">አኩመ ቆራቲ ሀርካን ወልት ህንቀበምኔት ገተሙ።<verse eid="2SA 23:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="2SA 23:7"/>ነምን ቆራቲ ቱቁ ከምዩ ምአ ስቢላ</para>
  <para style="q2" vid="2SA 23:7">ዮካን ሶማ ኤቦ ቀበተ፤</para>
  <para style="q2" vid="2SA 23:7">ቆራቲን ሱንስ ለፉመ ጅሩት ጉበመ።”<verse eid="2SA 23:7"/></para>
  <para style="s1">ነሞተ ዳዊት ጀጀቦ</para>
  <para style="r">
    <ref loc="2SA 23:8-39">23፥8‑39</ref> ኩወፈ – <char style="xt"><ref loc="1CH 11:10-41">1ሴና 11፥10‑41</ref></char></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 23:8"/>መቃን ነሞተ ዳዊት ወረ ጀጀቦ ከናዸ፦</para>
  <para style="p" vid="2SA 23:8">ዮሼብ-በሼቤት ነምች ተህክሞን ሆገና ሰደኒ ቱሬ፤ እንስ ሎለ ቶኮረት ኤቦ ምርምርሴ ነሞተ ዽበ ሰዴት ፍጤ።<verse eid="2SA 23:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 23:9"/>ከን እሰት ኣኑሞ ኤሌኣዛር እልመ ዶዶ ነምቸ ጎሰ አሆኣ ቱሬ፤ እንስ ዬሮ ፍልስጤሞተ ሎላፍ አችት ወልት ቀበመኒ ቱረን ሰነ ወራኑፍ ኩተተንት፣ ነሞተ ጀጀቦ ዳዊት ወጅን ቱረን ሰደን ኬሳ ቶኮ ቱሬ። ኤርገሲ ነሞትን እስራኤል ቦዴት ዴብአን፤ <verse eid="2SA 23:9"/><verse number="10" style="v" sid="2SA 23:10"/>እን ገሩ ኡቱ ለፈ ዻበቴ ቱሬ ህንሶቾእን ሀመ ሀርክሳ ደዸቤ ጎራዴሳት ጎጉት ፍልስጤሞተ ንሩኩቴ። <char style="nd">ዋቀዮ</char> ጋፈስ ሞአኖ ጉዳ ኬኔ። ሎልቶትንስ ወረ ዱአንራ ሂከቹ ቆፋፍ ገረ ኤሌኣዛርት ዴብአን።<verse eid="2SA 23:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 23:11"/>እሰት ኣኔስ ሳማ እልመ ኣጌ ነምቸ ጎሰ ሀራራቱ ቱሬ። ዮሙ ፍልስጤሞትን እዶ ሌህ ጄዸሙት ለፈ ቆቲሳ ከን ምስራን ጉተሜ ቶኮ ብረት ወልት ቀበመንት ሎልቶትን እስራኤል እሳን ዱራ በቀተን። <verse eid="2SA 23:11"/><verse number="12" style="v" sid="2SA 23:12"/>ሳማን ገሩ ለፈ ቆቲሳ ወለካት እዶ ቀበቴ ቱሬ። እንስ እራ እትሱዻን ፍልስጤሞተ ፍጤ፤ <char style="nd">ዋቀዮስ</char> ሞአትና ጉዳ ኬኔ።<verse eid="2SA 23:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 23:13"/>ዬሮ ምዻን ሃመሙት ኡቱ ሎልቶትን ፍልስጤሞታ ሱሉለ ሬፋይም ኬሰት ወልት ቀበመኒ ጅረኑ፣ ሀንገፎተ ሶዶመን ሰነ ኬሳ ነሞትን ሰዲ ገረ ሆልቀ አዱላምት ገረ ዳዊት ገድ ቡአን። <verse eid="2SA 23:13"/><verse number="14" style="v" sid="2SA 23:14"/>ዬሮ ሰነት ዳዊት ደአትኖ ጭማ ኬሰ ቱሬ፤ ሎልቶትን ፍልስጤምሞ ቤትልሄም ቱረን። <verse eid="2SA 23:14"/><verse number="15" style="v" sid="2SA 23:15"/>ዳዊትስ ዼቦቴ፣ “ኡቱ ነምን ቶኮ ቦለ ብሻኒ ከን ከረ ቤትልሄም ብረ ጅሩ ኬሳ ብሻን ዹጋቲ ና ፍዴሆ!” ጄዼ። <verse eid="2SA 23:15"/><verse number="16" style="v" sid="2SA 23:16"/>ከናፉ ነሞትን ጀጀቦን ሰደን ሱን ቁበተ ፍልስጤሞታ ኬሳን ደርበኒ ቦለ ብሻኒ ከን ከረ ቤትልሄም ብረ ጅሩ ኬሳ ብሻን ወራበኒ ዳዊቲፍ ፍደን። እን ገሩ ዹጉ ንድዴ፤ ቆደ ከና ብሻን ሰነ ፉለ <char style="nd">ዋቀዮ</char> ዱረት ዸንገላሴ። <verse eid="2SA 23:16"/><verse number="17" style="v" sid="2SA 23:17"/>እንስ፣ “ያ <char style="nd">ዋቀዮ</char>፣ ዋን ከነ ጎቹን ነራ ሃፈጋቱ! ብሻን ኩን ዺገ ነሞተ ሉቡ ኦፊሳኒት ኩተተኒ ዴመኒ ምቲ?” ጄዼ። ከናፉ ዳዊት ብሻን ሰነ ህንዹግኔ።</para>
  <para style="p" vid="2SA 23:17">ኤጋ ወን ነሞትን ጀጀቦን ሰደን ሱን ሆጄተን ከነ ቱሬ።<verse eid="2SA 23:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 23:18"/>አቢሻይ እልም ዜሩያ ኦቦሌስ ዮኣብ ሆገና ሰደንሳኒ ቱሬ። እንስ ነሞተ ዽበ ሰዲት ኤቦሳ ኦል ካፈቴ እሳን ፍጤ፤ አከሲን እንስ አኩመ ነሞተ ሰደን ሰና ቤከማ ተኤ። <verse eid="2SA 23:18"/><verse number="19" style="v" sid="2SA 23:19"/>አቢሻይን ወረ ሰደን ጫላ ኡልፍነ ህንአርገኔሬ? እን ዮ እሳን ኬሳ ቶኮ ተኡ ባቴዩ አጀጃሳኒ ተኤ።<verse eid="2SA 23:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2SA 23:20"/>ቤናያ እልም ዬሆያዳ ሎልቱን ጭማን ብየ ቀብዝኤል ሱንስ ሎልቱ ሞአትና ጉርጉዳ አርገምሲሴ ቱሬ። እንስ ሎልቶተ ሞኣብ ከኔን አከ መሌ ጀጀቦ ተአን ለመ አጄሴ። ጋፈ ጨቢን ሮቤ ቶኮስ ቦለ ኬሰ ሴኔ ሌንጨ አጄሴ። <verse eid="2SA 23:20"/><verse number="21" style="v" sid="2SA 23:21"/>እን ነምቸ ብየ ግብጥ ጉድቸ ቶኮሌ ንአጄሴ። ነምች ግብጥ ሱን ኤቦ ሀርካ ቀባቱዩ ቤናያ ቦኩዻን እሰት በኤ፤ እንስ ሀርከ ነምቸ ግብጥ ሰናቲ ኤቦ ቡተቴ ኤቦዹመሳቲን እሰ አጄሴ። <verse eid="2SA 23:21"/><verse number="22" style="v" sid="2SA 23:22"/>ሆጂወን ጎቱማ ከኔን ቤናያ እልም ዬሆያዳ ሆጄቴ ከነ ፈእ፤ እንስ አኩመ ነሞተ ጀጀቦ ሰደን ሰና ነመ ቤከማ ቱሬ። <verse eid="2SA 23:22"/><verse number="23" style="v" sid="2SA 23:23"/>እን ነሞተ ሶዶመን ሰነ ኬሳ ነመ ከምዩ ጫላ ኡልፍነ ጉዳ አርገቴ፤ ገሩ ነሞተ ሰደን ሰነት ህንደበለምኔ። ዳዊትስ አጀጃ ኤግዶተ ኦፊሳ እሰ ጎዸቴ።<verse eid="2SA 23:23"/></para>
  <para style="b"/>
  <para style="lh">
    <verse number="24" style="v" sid="2SA 23:24"/>ጀረ ሶዶመን ሰነ ኬሰትስ፦</para>
  <para style="b" vid="2SA 23:24"/>
  <para style="li1" vid="2SA 23:24">አሳሄል ኦቦሌሰ ዮኣብ፣</para>
  <para style="li1" vid="2SA 23:24">ኤልሃናን እልመ ዶዶ ነምቸ ቤትልሄም፣<verse eid="2SA 23:24"/></para>
  <para style="li1">
    <verse number="25" style="v" sid="2SA 23:25"/>ሸማ ነምቸ ጎሰ ሀሮዳ፣</para>
  <para style="li1" vid="2SA 23:25">ኤሊቃ ነምቸ ጎሰ ሀሮዳ፣<verse eid="2SA 23:25"/></para>
  <para style="li1">
    <verse number="26" style="v" sid="2SA 23:26"/>ሄሌዝ ነምቸ ጳልቲ፣</para>
  <para style="li1" vid="2SA 23:26">ኢራ እልመ እቄሽ ነመ ቴቆኣ፣<verse eid="2SA 23:26"/></para>
  <para style="li1">
    <verse number="27" style="v" sid="2SA 23:27"/>አቢኤዜር ነመ አናቶት፣</para>
  <para style="li1" vid="2SA 23:27">ሜቡናይ ነመ ብየ ሁሻ፣<verse eid="2SA 23:27"/></para>
  <para style="li1">
    <verse number="28" style="v" sid="2SA 23:28"/>ዘልሞን ነመ አሆኣ፣</para>
  <para style="li1" vid="2SA 23:28">መሀራይ ነመ ኔቶፋ፣<verse eid="2SA 23:28"/></para>
  <para style="li1">
    <verse number="29" style="v" sid="2SA 23:29"/>ሄሌድ እልመ በአና ነመ ኔቶፋ፣</para>
  <para style="li1" vid="2SA 23:29">ጎሰ ቤንያም ኬሳ ኢታይ እልመ ሪባይ ነምቸ ግቤኣ፣<verse eid="2SA 23:29"/></para>
  <para style="li1">
    <verse number="30" style="v" sid="2SA 23:30"/>ቤናያ ነመ ጵራቶን</para>
  <para style="li1" vid="2SA 23:30">ህዳይ ነምቸ ሱሉሎተ ገኣሽ፣<verse eid="2SA 23:30"/></para>
  <para style="li1">
    <verse number="31" style="v" sid="2SA 23:31"/>አቢ-አልቦን ነምቸ ብየ አርባ፣</para>
  <para style="li1" vid="2SA 23:31">አዝማዌት ነመ በርሁም፣<verse eid="2SA 23:31"/></para>
  <para style="li1">
    <verse number="32" style="v" sid="2SA 23:32"/>ኤሊያባ ነምቸ ሸአልቦን፣</para>
  <para style="li1" vid="2SA 23:32">እልማን ያሼን፣</para>
  <para style="li1" vid="2SA 23:32">ዮናታን፣ <verse eid="2SA 23:32"/><verse number="33" style="v" sid="2SA 23:33"/>እልመ ሸማ ነምቸ ሀራራ ሰና፣</para>
  <para style="li1" vid="2SA 23:33">አሂኣም እልመ ሻራር ነምቸ አሮዳ ሰና፣<verse eid="2SA 23:33"/></para>
  <para style="li1">
    <verse number="34" style="v" sid="2SA 23:34"/>ኤሊጴሌጥ እልመ አሀስባይ ነመ መአካት፣</para>
  <para style="li1" vid="2SA 23:34">ኤልኣም እልመ አሂቶፌል ነመ ጊሎን፣<verse eid="2SA 23:34"/></para>
  <para style="li1">
    <verse number="35" style="v" sid="2SA 23:35"/>ሄዝሮ ነመ ቀርሜሎስ፣</para>
  <para style="li1" vid="2SA 23:35">ፈአራይ ነመ ብየ አርቢ፣<verse eid="2SA 23:35"/></para>
  <para style="li1">
    <verse number="36" style="v" sid="2SA 23:36"/>ይግኣል እልመ ናታን ነምቸ ዞባ፣</para>
  <para style="li1" vid="2SA 23:36">ባኒ ጎሰ ጋድ፣<verse eid="2SA 23:36"/></para>
  <para style="li1">
    <verse number="37" style="v" sid="2SA 23:37"/>ዜሌቅ ነምቸ ጎሰ አሞን፣</para>
  <para style="li1" vid="2SA 23:37">ነሃራይ ነምቸ ጎሰ ብኤሮት ከን ዮኣብ እልመ ዜሩያቲፍ ምአ ሎላ ባቱ ሰነ ቱሬ፤<verse eid="2SA 23:37"/></para>
  <para style="li1">
    <verse number="38" style="v" sid="2SA 23:38"/>ኢራስ ነምቸ ጎሰ ይትራ፣</para>
  <para style="li1" vid="2SA 23:38">ጋሬብ ነምቸ ጎሰ ይትራ፣<verse eid="2SA 23:38"/></para>
  <para style="li1">
    <verse number="39" style="v" sid="2SA 23:39"/>አከሱመስ ኡርያ ነምቸ ሄት።</para>
  <para style="b" vid="2SA 23:39"/>
  <para style="lf" vid="2SA 23:39">ወሉመት ነሞተ ሶዶሚ ቶርበ ቱረን።<verse eid="2SA 23:39"/></para>
  <chapter eid="2SA 23"/>
  <chapter number="24" style="c" sid="2SA 24"/>
  <para style="s1">ዳዊት ሎልቶተ ለካኤ</para>
  <para style="r">
    <ref loc="2SA 24:1-17">24፥1‑17</ref> ኩወፈ – <char style="xt"><ref loc="1CH 21:1-17">1ሴና 21፥1‑17</ref></char></para>
  <para style="p">
    <verse number="1" style="v" sid="2SA 24:1"/>ኣሪን <char style="nd">ዋቀዮ</char> አመስ እስራኤልት ከኤ ዳዊቲን፣ “ዸቂቲ እስራኤሊፊ ይሁዳ ለካእ” ጄዼ እሳንት ከካሴ።<verse eid="2SA 24:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2SA 24:2"/>ከናፉ ሞትች ዮኣቢፊ አጀጆተ ወራና ከኔን እሰ ብረ ቱረኒን፣ “አከ አን አከ እሳን ሀመም አከ ባይአተን ቤኩ ደንደኡፍ ጎሶተ እስራኤል ከኔን ዳኒ ሀመ ቤርሼባት ጅራተን ሁንደ ኬሰ ዴማቲ ነሞተ ሎሉ ደንደአን ገልሜሳ” ጄዼ።<verse eid="2SA 24:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2SA 24:3"/>ዮኣብ ገሩ ዴብሴ፣ “<char style="nd">ዋቀዮ</char> ዋቅንኬ ሎልቶተኬ ደቻ ዽበ ጫላ ሃባይእሱ፤ እጅ ጎፍታኮ ሞትቻስ ዋን ከነ ሃአርጉ። ገሩ ጎፍታንኮ ሞትች ማሊፍ ዋን ከነ ጎቹ በርባዴ?” ጄዼ።<verse eid="2SA 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2SA 24:4"/>ተኡስ ዱቢን ሞትቻ ዮኣቢፊ አጀጆተ ሎልቶታ ያደ ጌደረቺሴ፤ ከናፉ እሳን ፉለ ሞትቻ ዱራ በአኒ ነሞተ እስራኤል ከኔን ሎሉ ደንደአን ገልሜሱ ዴመን።<verse eid="2SA 24:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2SA 24:5"/>እሳንስ ኤርገ ዮርዳኖስ ጬአኒ ቦዴ ገረ ክበ መጋላ ሱሉለ ኬሰት አርገሙቲን አሮኤር ብረ ቁበተን፤ አቺሞ ጋድ ኬሰ ደርበኒ የእዜርት ቀጄለን። <verse eid="2SA 24:5"/><verse number="6" style="v" sid="2SA 24:6"/>እሳንስ ገረ ግልኣዲፊ ተባሶን አደሳይ፣ እት ኣንሰኒ ገረ ዳን ያአኒ አቺሞ ናነአኒ ሲዶና ዸቀን። <verse eid="2SA 24:6"/><verse number="7" style="v" sid="2SA 24:7"/>ኤርገሲሞ ገረ ደአትኖ ጢሮስ፣ ገረ መጋላወን ሂዎታቲፊ ከነኣኖታ ሁንዳ ዸቀን። ዹመረትሞ ገረ ቤርሼባ ከን ክበ ይሁዳት አርገምቱ ሰና ዸቀን።<verse eid="2SA 24:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2SA 24:8"/>እሳንስ ኤርገ ጉቱማ ብየቲ ኬሰ ናነአኒ ቦዴ ጅአ ሰገሊፊ ቡልቲ ድግደማት ዬሩሳሌምት ዴብአን።<verse eid="2SA 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2SA 24:9"/>ዮኣብስ ለኮብሰ ነሞተ ሎሉ ደንደአኒ ሞትቸት ህሜ፤ እስራኤል ኬሰ ነሞተ ሎላፍ ገኡምሰ ቀበን ከኔን ጎራዴ ቀበቹ ደንደአን ኩመ ዽበ ሰዴት፣ ይሁዳ ኬሰሞ ነሞተ ኩመ ዽበ ሸንቱ ቱሬ።<verse eid="2SA 24:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2SA 24:10"/>ዳዊት ዋን ኤርገ ሎልቶተ ለካኤ ቦዴ በሌሳን እት ዸገአሜፍ <char style="nd">ዋቀዮን</char>፣ “አን ዋን ሆጄዼ ኬሰት ጩቡ ጉዳ ሆጄዼረ። ያ <char style="nd">ዋቀዮ</char>፣ አን አከ አት በሌሳ ገርብቸኬቲ ዺፍቱፍ ስን ከዸዸ። አን ሆጂ ጎዉማ ጉዳ ሆጄዼራ” ጄዼ።<verse eid="2SA 24:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2SA 24:11"/>ጉያ እት ኣኑት ኡቱ ዳዊት ህርባ ህንከእን ኤርጋን <char style="nd">ዋቀዮ</char> ገረ ዋ ህማ ዳዊት ገረ ጋድ ራጅቻ ዹፌ፤ ኤርጋን ሱንስ፣ <verse eid="2SA 24:11"/><verse number="12" style="v" sid="2SA 24:12"/>“ዸቂቲ ዳዊቲን፣ ‘<char style="nd">ዋቀዮ</char> አከነ ሲን ጄዸ፦ አን ፍለትኖ ሰዲ ሲፍን ኬነ፤ አከ አን እሰ ስት ፍዱፍ እሳን ኬሳ ቶኮ ፍለዹ’ ጄዽ” ጄዸ።<verse eid="2SA 24:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2SA 24:13"/>ከናፉ ጋድ ገረ ዳዊት ዸቄ፣ “ወጋ ቶርበ ብየኬረ ቤል ሃቡኡ? ዮካን ዲኖትንኬ ጅአ ሰዲፍ ስ ሃአርአኒ? ዮካን ዸእች ጉያ ሰዲ ብየኬ ሃዸኡ? ኤጋ አመ እት ያዲቲ ዋን አን እሰ ነ ኤርጌ ሰናፍ ዴብሱ ሙርቴስ” ጄዼን።<verse eid="2SA 24:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2SA 24:14"/>ዳዊትሞ ጋዲን፣ “አን አከ መሌ ዽጰዼረ። ዋን አራርሳ ጉዳ ተኤፍ ኑ ሀርከ <char style="nd">ዋቀዮ</char> ሃሴኑ፤ ገሩ አከ አን ሀርከ ነማ ሴኑ ህንጎዽን” ጄዼ።<verse eid="2SA 24:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2SA 24:15"/>ከናፉ <char style="nd">ዋቀዮ</char> ጉያ እት ኣኑ ገነማ ጀልቀቤ ሀመ ጉያን ሙርታኤ ራወቱት እስራኤልት ዸእቸ ፍዴ፤ ዳኒ ሀመ ቤርሼባት ነሞትን ኩምን ቶርባተምን ንዹመን። <verse eid="2SA 24:15"/><verse number="16" style="v" sid="2SA 24:16"/>ዬሮ ኤርገማን ዋቀዮ ዬሩሳሌምን በሌሱፍ ሀርከሳ ድሪርፈቴት <char style="nd">ዋቀዮ</char> ሰበቢ ሁባቲን ሱን እሰ ገድሲሴፍ ኤርገማሳ ከን ሰበ በሌሱፍ ቱሬ ሰናን፣ “ንገአ! ሀርከኬ ዴብፈዹ” ጄዼ። ዬሮ ሰነ ኤርገማን <char style="nd">ዋቀዮ</char> ኦብዲ አረዉና ነምቸ ጎሰ ዬቡስ ሰና ብረ ቱሬ።<verse eid="2SA 24:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2SA 24:17"/>ዳዊት ዮሙ ኤርገማ ዋቀዮ ከን ነሞተ አጄሳ ቱሬ ሰነ አርጌት፣ <char style="nd">ዋቀዮን</char>፣ “ነምን ጩቡፊ በሌሳ ሆጄቴ አኑመ። እሳን ኩኔን ገሩ ሆሎታዸ። እሳን ማል ጎዸን? ሀርክኬ አናፊ ማቲኮረ ሃቡኡ” ጄዼ።<verse eid="2SA 24:17"/></para>
  <para style="s1">ዳዊት እዶ ኣርሳ ቶልቼ</para>
  <para style="r">
    <ref loc="2SA 24:18-25">24፥18‑25</ref> ኩወፈ – <char style="xt"><ref loc="1CH 21:18-26">1ሴና 21፥18‑26</ref></char></para>
  <para style="p">
    <verse number="18" style="v" sid="2SA 24:18"/>ጋፈስ ጋድ ገረ ዳዊት ዸቄ፣ “ኦል በኢቲ ኦብዲ አረዉና ነምቸ ጎሰ ዬቡስ ሰና ኬሰት እዶ ኣርሳ <char style="nd">ዋቀዮፍ</char> እጃር” ጄዼን። <verse eid="2SA 24:18"/><verse number="19" style="v" sid="2SA 24:19"/>ከናፉ ዳዊት አኩመ <char style="nd">ዋቀዮ</char> ከራ ጋዲን እሰ አጀጄት ኦል በኤ። <verse eid="2SA 24:19"/><verse number="20" style="v" sid="2SA 24:20"/>አረዉናን ዮሙ ምልአቴ ሞትቻፊ ነሞተሳ ከኔን ገረሳ ዹፋ ጅረን አርጌት፣ ገድ በኤ ፉለ ሞትቻ ዱረት አዳን ለፈት ጎምብፈሜ ሰገዴ።<verse eid="2SA 24:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2SA 24:21"/>አረዉናንስ፣ “ጎፍታንኮ ሞትች ማሊፍ ገረ ገርብቸሳ ዹፌ?” ጄዼ።</para>
  <para style="p" vid="2SA 24:21">ዳዊትሞ፣ “አን አከ ዸእች ሰበረ ቡኤ ኩን ዻበቱፍ፣ ኦብዲኬ ብቴ እሰረት እዶ ኣርሳ <char style="nd">ዋቀዮፍ</char> ቶልቹፍን ዹፌ” ጄዼ ዴብሴ።<verse eid="2SA 24:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2SA 24:22"/>አረዉናንስ ዳዊቲን አከነ ጄዼ፤ “ጎፍታንኮ ሞትች ዋን እሰት ቶሉ ከምዩ ፉዸቴ ሃዽኤሱ። ኣርሳ ጉበሙፍ ሰንጎን ኩኖት፤ ቆራኒፍሞ ምእ እቲን ምዻን ዸአሙፊ ዋንጆን ሰንጋ አስ ጅረ። <verse eid="2SA 24:22"/><verse number="23" style="v" sid="2SA 24:23"/>ያ ሞቲ፣ አረዉናን ዋን ከነ ሁንደ ሞትቻፍ ንኬነ።” አከሱመስ አረዉናን፣ “<char style="nd">ዋቀዮ</char> ዋቅንኬ ሲፍ ሃፉዸቱ” እሳን ጄዼ።<verse eid="2SA 24:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2SA 24:24"/>ሞትች ገሩ፣ “አከስ ምት፤ አን ገቲዻን ስራ ብቱ ነ በርባችሰ። አን ዋን ገቲ እት ህንባስን <char style="nd">ዋቀዮ</char> ዋቀኮቲፍ ኣርሳ ጉበሙ ጎዼ ህንዽኤሱ” ጄዼ አረዉናፍ ዴብሴ።</para>
  <para style="p" vid="2SA 24:24">ከናፉ ዳዊት ኦብድቻፊ ሰንጎተ ሰነ ሜቲ ሰቅሊ ሸንተማን ብቴ። <verse eid="2SA 24:24"/><verse number="25" style="v" sid="2SA 24:25"/>ዳዊትስ አችት እዶ ኣርሳ <char style="nd">ዋቀዮፍ</char> ቶልቼ ኣርሳ ጉበሙፊ ኣርሳ ነጋ ዽኤሴ። <char style="nd">ዋቀዮስ</char> ከዸትና ዋኤ ብየቲፍ ዽኣቴፍ ዴቢ ኬኔ፤ ዸእችስ እስራኤልራ ንዴብኤ።<verse eid="2SA 24:25"/></para>
  <chapter eid="2SA 24"/>
</usx>
