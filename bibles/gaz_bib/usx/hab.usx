<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="HAB" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">አንባቆም</para>
  <para style="toc1">ራጂ አንባቆም</para>
  <para style="toc2">አንባቆም</para>
  <para style="toc3">አንባ</para>
  <para style="mt2">ራጂ</para>
  <para style="mt1">አንባቆም</para>
  <chapter number="1" style="c" sid="HAB 1"/>
  <para style="p">
    <verse number="1" style="v" sid="HAB 1:1"/>ራጂ አንባቆም ራጅች አርጌ።<verse eid="HAB 1:1"/></para>
  <para style="b"/>
  <para style="s1">ጉንጉሚ አንባቆም</para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 1:2"/>ያ <char style="nd">ዋቀዮ</char>፣ አን ሀመ ዮሚትን ገርጋርሳፍ <optbreak/> ስት እየዸ?</para>
  <para style="q2" vid="HAB 1:2">አት ገሩ ነ ህንዸጌፈቱ፤</para>
  <para style="q1" vid="HAB 1:2">ዮካን አን ሀመ ዮሚት፣ “ጎሊ!”</para>
  <para style="q2" vid="HAB 1:2">ጄዼ ስት ቦኤ አት ገሩ ነ ህንኦልችቱ?<verse eid="HAB 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 1:3"/>አት ማሊፍ አከ አን ሙርቲ ደቤ አርጉ ነ ጎተ?</para>
  <para style="q2" vid="HAB 1:3">አት ማሊፍ በሌሳ ነማ ኦብስተ?</para>
  <para style="q1" vid="HAB 1:3">በዲስኒፊ ጎሊን ፉለኮ ዱረ ጅሩ፤</para>
  <para style="q2" vid="HAB 1:3">ሎሊፊ ወልዸቢንስ ባይአቴረ።<verse eid="HAB 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 1:4"/>ከናፉ ሴር ላምሸኤረ፤</para>
  <para style="q2" vid="HAB 1:4">ሙርቲን ቀጄላን ደብሰሜረ።</para>
  <para style="q1" vid="HAB 1:4">አከ ሙርቲን ቀጄላን ጀልእፈሙፍ፤</para>
  <para style="q2" vid="HAB 1:4">ነሞትን ሀሞን ቀጄሎተ መርሱ።<verse eid="HAB 1:4"/></para>
  <para style="s1">ዴቢ <char style="nd">ዋቀዮ</char></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 1:5"/>“ሰቦተ ሁበዻ እላላ፤</para>
  <para style="q2" vid="HAB 1:5">አከ መሌስ ድንቅሲፈዻ።</para>
  <para style="q1" vid="HAB 1:5">አን በረኬሰን ኬሰ</para>
  <para style="q2" vid="HAB 1:5">ዋን እስን ዮ እስንት ህመሜሌ</para>
  <para style="q2" vid="HAB 1:5">ህንአመኔ ቶኮ ነንሆጄዸ።<verse eid="HAB 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 1:6"/>አን ወረ ባብሎን፣</para>
  <para style="q2" vid="HAB 1:6">ኡመተ ገረ ጀቤሳፊ አሪፈታ፣</para>
  <para style="q1" vid="HAB 1:6">ከን እዶ ጅሬኘሳ ህንተእን ቀበቹፍ</para>
  <para style="q2" vid="HAB 1:6">ጉቱማ ለፋ ኬሰ ያኡ ሰነ ነንካሰ።<verse eid="HAB 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 1:7"/>እሳን ሰበ ሶዳተሙፊ ናስሱዸ፤</para>
  <para style="q2" vid="HAB 1:7">እሳን ኦፊሳኒቲፉ ሴረ፤</para>
  <para style="q2" vid="HAB 1:7">ኡልፍነሳኒስ ንጉድፈቱ።<verse eid="HAB 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 1:8"/>ፈርዴንሳኒ ቄረንሰ ጫላ ሰፍሱ፤</para>
  <para style="q2" vid="HAB 1:8">ዬዪ ገልገላ ጫላ ሶዳችሱ።</para>
  <para style="q1" vid="HAB 1:8">ነሞትንሳኒ ከኔን ፈርደ ያበተን <optbreak/> አሪቲዻን ጉሉፉ፤</para>
  <para style="q2" vid="HAB 1:8">አቦቲን ፈርደሳኒስ ፈጎዻ ዹፉ።</para>
  <para style="q1" vid="HAB 1:8">እሳን አኩመ ርሳ ዋ ኛቹፍ አሪፈቱ በርሱ፤<verse eid="HAB 1:8"/></para>
  <para style="q2">
    <verse number="9" style="v" sid="HAB 1:9"/>እሳን ሁንድኑ ጄቁምሳፍ ዹፉ።</para>
  <para style="q1" vid="HAB 1:9">ቱትንሳኒ አኩመ ቡቤ ገሞጂ ገረ ፉለ ዱራት ቀጄለ፤</para>
  <para style="q2" vid="HAB 1:9">ነሞተ ህዸመንስ አኩመ ጭረቻ ወልት ቀበ።<verse eid="HAB 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 1:10"/>እሳን ሞቶተ ቱፈተኒ</para>
  <para style="q2" vid="HAB 1:10">ቡልችቶተት ቆሱ።</para>
  <para style="q1" vid="HAB 1:10">ደአትኖ ሁንደት ንኮልፉ፤</para>
  <para style="q2" vid="HAB 1:10">ብዮስ ቱለኒ እሰ ቀበቱ።<verse eid="HAB 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 1:11"/>ኤርገሲ ነሞትን የከ ሆጄተን ከኔን ሁምነሳኒ <optbreak/> ዋቀሳኒ ጎዸተን፣</para>
  <para style="q2" vid="HAB 1:11">አከ ቡቤ ለፈ ሀጣአኒ ከራሳኒ እት ፉፉ።”<verse eid="HAB 1:11"/></para>
  <para style="s1">ጉንጉሚ አንባቆም እሰ ለመፋ</para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 1:12"/>ያ <char style="nd">ዋቀዮ</char>፣ አት በረ በራ ጀልቀብዴ ጅርተ ምቲ?</para>
  <para style="q2" vid="HAB 1:12">ያ ዋቀኮ፣ ያ ቁልቁልቸኮ፣ አት ጎንኩማ ህንዱቱ።</para>
  <para style="q1" vid="HAB 1:12">ያ <char style="nd">ዋቀዮ</char>፣ አት አከ እሳን ሙርቲ ኬነኒፍ <optbreak/> እሳን ሙዴርተ፤</para>
  <para style="q2" vid="HAB 1:12">ያ ከታኮ፣ አት አከ እሳን ነመ አደበኒፍ እሳን ረመዴርተ።<verse eid="HAB 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 1:13"/>እጅኬ አከ ዋን ሀማ ህንእላሌፍ አከ መሌ ቁልቁሉዸ፤</para>
  <para style="q2" vid="HAB 1:13">አት ደበ አርግቴ ኦብሳን ዺሱ ህንደንዴሱ።</para>
  <para style="q1" vid="HAB 1:13">ዮስ አት ማሊፍ ኦብሳን ነሞተ ሀሞ እላልተ?</para>
  <para style="q2" vid="HAB 1:13">አት ማሊፍ ዬሮ ነሞትን ሀሞን</para>
  <para style="q2" vid="HAB 1:13">ወረ እሳን ጫላ ቀጄሎ ተአን ልቅምሰንት ጨልእስታ?<verse eid="HAB 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 1:14"/>አት ነሞተ አከ ቁርጡሚ ገላነ ኬሳ፣</para>
  <para style="q2" vid="HAB 1:14">አከ ኡመመወን ገላና ከኔን ቡልቻ<optbreak/> ህንቀብኔ ጎቴርተ።<verse eid="HAB 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 1:15"/>ዲን ሆኮዻን እሳን ሁንደ ኦል ባሰ፤</para>
  <para style="q2" vid="HAB 1:15">ክዮሳቲንስ እሳን ሀርክሰ፤</para>
  <para style="q1" vid="HAB 1:15">ክዮሳ ኬሰት ወልት እሳን ቀበተ፤</para>
  <para style="q2" vid="HAB 1:15">ከናፉ እን ንገመደ፤ ንእልልቸስ።<verse eid="HAB 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 1:16"/>እን ሰበቢ ክዮሳቲን በሸነኔ</para>
  <para style="q2" vid="HAB 1:16">ኛተሳ ፍለተማት ገመዱፍ</para>
  <para style="q1" vid="HAB 1:16">ክዮሳቲፍ ኣርሳ ዽኤሰ፤</para>
  <para style="q2" vid="HAB 1:16">ክዮሳቲፍሌ እጣነ ኣርሰ።<verse eid="HAB 1:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 1:17"/>እን ክዮሳ ኬሳ ገረገልቹዻን፣</para>
  <para style="q2" vid="HAB 1:17">ገረ ላፍነ መሌ እቱመ ፉፌ ሰቦተ በሌሱ ቀባ?<verse eid="HAB 1:17"/></para>
  <para style="b"/>
  <chapter eid="HAB 1"/>
  <chapter number="2" style="c" sid="HAB 2"/>
  <para style="q1">
    <verse number="1" style="v" sid="HAB 2:1"/>አን እዶኮ ዻበዼ</para>
  <para style="q2" vid="HAB 2:1">ደላ ኤጉምሳረ ነንቱረ፤</para>
  <para style="q1" vid="HAB 2:1">ሜ ዋን እን ናን ጄዹ አርጉፍ</para>
  <para style="q2" vid="HAB 2:1">ዴቢ አን ጉንጉሚ ከናፍ ኬኑ መሉ ቤኩፍ ነንእላለ።<verse eid="HAB 2:1"/></para>
  <para style="s1">ዴቢ <char style="nd">ዋቀዮ</char></para>
  <para style="p">
    <verse number="2" style="v" sid="HAB 2:2"/>ኤርገሲ <char style="nd">ዋቀዮ</char> አከነ ጄዼ ዴቢ ኬኔ፦</para>
  <para style="q1" vid="HAB 2:2">“አከ ነምን ዱብሱ ቶኮ ቀበቴ ፊጉፍ፣</para>
  <para style="q2" vid="HAB 2:2">ሙልአተ ሰነ እፈ ጎዺ</para>
  <para style="q2" vid="HAB 2:2">ገበቴረት በሬስ።<verse eid="HAB 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 2:3"/>ሙልአትን ኩን ዬሮ ሙርታኤ ቶኮ ኤገታቲ፤</para>
  <para style="q2" vid="HAB 2:3">እን ዋኤ ዹመሳ ዱበተ መሌ ህንሶቡ።</para>
  <para style="q1" vid="HAB 2:3">ዮ ቱሬስ እሰ ኤግ፤</para>
  <para style="q2" vid="HAB 2:3">እን ዹጉማን ንዹፈ፤ ህንቱሩስ።<verse eid="HAB 2:3"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 2:4"/>“ኩኖ እን ኦፍ ቦኮክሴረ፤</para>
  <para style="q2" vid="HAB 2:4">ሀዊንሳስ ስሪ ምት፤</para>
  <para style="q2" vid="HAB 2:4">ነምን ቀጄላን ገሩ አመንቲሳቲን ጅራተ፤<verse eid="HAB 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 2:5"/>ዹጉማን እን ዳዺ ወይኒቲን ንጎዎምፈመ፤</para>
  <para style="q2" vid="HAB 2:5">ኦፍ ቱለ፤ ቦቆናስ ህንቀቡ።</para>
  <para style="q1" vid="HAB 2:5">እን አኩመ ሲኦል ሰሰተ፤</para>
  <para style="q2" vid="HAB 2:5">አከ ዱኣስ ከን ህንቁፍኔዸ።</para>
  <para style="q1" vid="HAB 2:5">እን ሰቦተ ሁንደ ወልት ቀበተ፤</para>
  <para style="q2" vid="HAB 2:5">ኡመተ ሁንደስ ቦጅኤ ፉዸተ።<verse eid="HAB 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="HAB 2:6"/>“እሳን ሁንድ እሰ ቱፈተኒ እት ኮልፋ፣</para>
  <para style="q1" vid="HAB 2:6">“ ‘ነመ ምአ ሀተሜ ቱለቴ</para>
  <para style="q2" vid="HAB 2:6">ሳምቻን ኦፍ ሶሮምሱፍ ወዮ!</para>
  <para style="q2" vid="HAB 2:6">ወን ኩን ሀመ ዮሚት እት ፉፈ’ <optbreak/> ጄዸኒ እት ህንቆሰኒ?<verse eid="HAB 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 2:7"/>ወር ልቂ ስራ ቀበን አኩመ ተሳ ስት ህንከአኒ?</para>
  <para style="q2" vid="HAB 2:7">እሳን ከአኒ ስ ህንሆለቺሰኒ?</para>
  <para style="q2" vid="HAB 2:7">ኤርገሲ አት ሀርከሳኒ ጀለ ገልተ።<verse eid="HAB 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 2:8"/>ሰበቢ አት ሰበ ሄዱ ሳምቴፍ</para>
  <para style="q2" vid="HAB 2:8">ነሞትን ሀፈን ስ ሳሙ።</para>
  <para style="q1" vid="HAB 2:8">አት ዺገ ነማ ዸንገላፍቴርታቲ፤</para>
  <para style="q2" vid="HAB 2:8">አት ብዮተ፣ መጋላወኒፊ <optbreak/> ነሞተ እሳን ኬሰ ጅራተን ሁንደ በሌስቴርተ።<verse eid="HAB 2:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 2:9"/>“ነመ ቡኣ ህንመሌን መነ እጃረቱ</para>
  <para style="q2" vid="HAB 2:9">ከን በዲሰ ጀላ በኡፍ ጄዼ</para>
  <para style="q2" vid="HAB 2:9">ለፈ ኦል ከኣረት እዶ ጅሬኛ ቶልፈቱፍ ወዮ!<verse eid="HAB 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="HAB 2:10"/>አት ሉቡ ነመ ባይኤ ገላፈቹዻፍ፣</para>
  <para style="q2" vid="HAB 2:10">ዋን ነመ ቃኔሱ መነኬት መለቴ <optbreak/> ሉቡኬት በዲሰ ፍዴ።<verse eid="HAB 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 2:11"/>ዸጋወን ኬኘን ኬሳ እዩ፤</para>
  <para style="q2" vid="HAB 2:11">ዴምዴሞን ሙካስ ጀላ ቀበ።<verse eid="HAB 2:11"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 2:12"/>“ነመ ዺገ ዸንገላሱዻን መጋላ እጃሩፍ፣</para>
  <para style="q2" vid="HAB 2:12">ከን የካን መጋላ ሁንዴሱፍ ወዮ!<verse eid="HAB 2:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 2:13"/>አከ ደዸቢን ነማ አኩመ ቆራን እብዳ ተኤ፣</para>
  <para style="q2" vid="HAB 2:13">አከ ሰቦትንስ አከሱማን ኦፍ ደዸብሲሰን</para>
  <para style="q2" vid="HAB 2:13">
    <char style="nd">ዋቀዮ</char> ዋን ሁንደ ደንደኡ ሙርቴሴረ ምቲ?<verse eid="HAB 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 2:14"/>አኩመ ብሻን ገላነ ጉቱ ሰነ</para>
  <para style="q2" vid="HAB 2:14">ለፍት ኡልፍነ <char style="nd">ዋቀዮ</char> ቤኩቲን ጉተምቲቲ።<verse eid="HAB 2:14"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 2:15"/>“ነመ ቁላ ዸግነ ኦላሳ እላሉፍ ጄዼ</para>
  <para style="q2" vid="HAB 2:15">ሀመ እን መቻኡት</para>
  <para style="q2" vid="HAB 2:15">ቀልቀሎ ኬሳ ዳዺ ወይኒ እሳፍ ቡሱፍ ወዮ።<verse eid="HAB 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 2:16"/>አት ቆደ ኡልፍና ቃኒዻን ጉተምተ።</para>
  <para style="q2" vid="HAB 2:16">አመ ደበሬን ከንኬት! አከ ቁላንኬ ሙልአቱፍ ዹግ።</para>
  <para style="q1" vid="HAB 2:16">ጦፎን ምርገ <char style="nd">ዋቀዮ</char> ስት ገረገለ፤</para>
  <para style="q2" vid="HAB 2:16">ሰልጵንስ ኡልፍነኬ ሀጉገ።<verse eid="HAB 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 2:17"/>ፍንጭል አት ልባኖንት ሆጄቴ ስልቅምሰ፤</para>
  <para style="q2" vid="HAB 2:17">ሆሪ ፍጡንኬ ስ ርፈቺሰ።</para>
  <para style="q1" vid="HAB 2:17">አት ዺገ ነማ ዸንገላፍቴርታቲ፤</para>
  <para style="q2" vid="HAB 2:17">አት ብዮተ፣ መጋላወኒፊ ነሞተ እሳን ኬሰ ጅራተን <optbreak/> ሁንደ በሌስቴርተ።<verse eid="HAB 2:17"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 2:18"/>“ዋቅን ቶልፈማን ኦጌሰ ሀርካቲን ሶፈሙ</para>
  <para style="q2" vid="HAB 2:18">ዮካን ፈኪን ሶበ በርሲሱ ፋይዳ ማሊ ቀበ?</para>
  <para style="q1" vid="HAB 2:18">ነምን እሰ ቶልቹ ቶኮ ሆጂዹመ ሀርከሳ አመነታቲ፤</para>
  <para style="q2" vid="HAB 2:18">እን ዋቆተ ቶልፈሞ ዱበቹ ህንደንዴኜ ቶልቸ።<verse eid="HAB 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 2:19"/>ነመ ሙካን፣ ‘ደመቅ!’</para>
  <para style="q2" vid="HAB 2:19">ዮካን ዸጋ ሉቡ ህንቀብኔን፣ ‘ከእ!’ ጄዹፍ ወዮ።</para>
  <para style="q1" vid="HAB 2:19">እን በርሲሱ ንደንደኣ?</para>
  <para style="q2" vid="HAB 2:19">ኩኖ እን ወርቄፊ ሜቲ ድበሜረ፤</para>
  <para style="q2" vid="HAB 2:19">ሀፉር ቶኮዩ እሰ ኬሰ ህንጅሩ።”<verse eid="HAB 2:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="HAB 2:20"/>
    <char style="nd">ዋቀዮ</char> ገሩ መነ ቁልቁሉማሳ <optbreak/> ቁልቁሉ ሰነ ኬሰ ጅረ፤</para>
  <para style="q2" vid="HAB 2:20">ለፍት ሁንድ ፉለሳ ዱረት ሃጨልእስቱ።<verse eid="HAB 2:20"/></para>
  <chapter eid="HAB 2"/>
  <chapter number="3" style="c" sid="HAB 3"/>
  <para style="s1">ከዸትና አንባቆም</para>
  <para style="d">
    <verse number="1" style="v" sid="HAB 3:1"/>ከዸትና አንባቆም ራጅቻ <char style="tl">ሽግዮኖቲዻን</char>።<note caller="+" style="f"><char style="fr" closed="false">3፥1 </char><char style="ft" closed="false">ሽግዮቲን <char style="it">ጎሰ ሙዚቃት።</char></char></note><verse eid="HAB 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="HAB 3:2"/>ያ <char style="nd">ዋቀዮ</char>፣ አን ኦዱኬ ዸገኤረ፤</para>
  <para style="q2" vid="HAB 3:2">ያ <char style="nd">ዋቀዮ</char>፣ አን ጎቸወንኬ ነንሶዳዸ።</para>
  <para style="q1" vid="HAB 3:2">በረኬኘ ኬሰ እሳን ሃሮምስ፤</para>
  <para style="q2" vid="HAB 3:2">ጀበነኬኘ ኬሰ እሳን ቤከምሲስ፤</para>
  <para style="q2" vid="HAB 3:2">ዬሮ ዼከምቱት አራረ ያደዹ።<verse eid="HAB 3:2"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="3" style="v" sid="HAB 3:3"/>ዋቅን ቴማንራ፣</para>
  <para style="q2" vid="HAB 3:3">እን ቁልቁልች ቱሉ ጳራኒቲ ዹፌ።</para>
  <para style="q1" vid="HAB 3:3">ኡልፍንሳ ሰሚወን ሀጉጌ፤</para>
  <para style="q2" vid="HAB 3:3">ገለንሳስ ለፈ ጉቴ።<verse eid="HAB 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="HAB 3:4"/>ሚዸግንሳ አኩመ በኢሰ አዱት፤</para>
  <para style="q2" vid="HAB 3:4">ጋንፈወን ለመ ሀርከሳቲ በኡ፤</para>
  <para style="q2" vid="HAB 3:4">ሁምንሳስ አች ዾከቴረ።<verse eid="HAB 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="HAB 3:5"/>ፉለሳ ዱረ ዸእቸቱ ዴሜ፤</para>
  <para style="q2" vid="HAB 3:5">ጎልፋንስ እሰ ዱካ ቡኤ።<verse eid="HAB 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="HAB 3:6"/>እን ዻበቴ ለፈ ራሴ፤</para>
  <para style="q2" vid="HAB 3:6">እላሌ አከ ሰቦትን ሆለተን ጎዼ።</para>
  <para style="q1" vid="HAB 3:6">ቱሉወን ዱሪ ንቡርኩታአን፤</para>
  <para style="q2" vid="HAB 3:6">ጋረን በረ ሄዱ ጅራተንስ ንዲገመን።</para>
  <para style="q2" vid="HAB 3:6">ከራንሳ ከን በረ በራት።<verse eid="HAB 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="HAB 3:7"/>አን ኡቱ ዱንካኖትን እቶጵያ ዽጰተኑ ነንአርጌ፤</para>
  <para style="q2" vid="HAB 3:7">ጎልጋወን ምድያኒስ ንሆለቱ።<verse eid="HAB 3:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="HAB 3:8"/>ያ <char style="nd">ዋቀዮ</char>፣ አት ለጌንት ኣርቴ ቱርቴ?</para>
  <para style="q2" vid="HAB 3:8">ቡርቃወንትስ ዼከምቴ?</para>
  <para style="q1" vid="HAB 3:8">አት ዬሮ ፈርዴንኬቲን ጉሉፍቴት፣</para>
  <para style="q2" vid="HAB 3:8">ዬሮ ጋሪወን ሞአትናኬ ያበቴት</para>
  <para style="q2" vid="HAB 3:8">ገላነት ዼከምቴ ቱርቴ?<verse eid="HAB 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="HAB 3:9"/>አት እዳኬ ሉቅፈቴ</para>
  <para style="q2" vid="HAB 3:9">ጥየ እት ዻበቴ።</para>
  <para style="q1" vid="HAB 3:9">ለፈስ ለጌኒን ገርገር በቀቅስቴ፤<verse eid="HAB 3:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="HAB 3:10"/>ቱሉወን ስ አርገኒ ሆለተን።</para>
  <para style="q1" vid="HAB 3:10">ዸኣወን ብሻኒ አቺን ደርበን፤</para>
  <para style="q2" vid="HAB 3:10">ቱጁብን ንሁርሴ፤</para>
  <para style="q2" vid="HAB 3:10">ደምበሊሳስ ኦል ካሴ።<verse eid="HAB 3:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="HAB 3:11"/>ሰበቢ ጥየኬ ጨለቅሳ ፊጉ ሰናቲፊ</para>
  <para style="q2" vid="HAB 3:11">ሰበቢ እፈ ኤቦኬቲ ሰናቲፍ አዱፊ</para>
  <para style="q2" vid="HAB 3:11">ጅእ ሰሚ ኬሰ ዻበተኒ ሀፈን።<verse eid="HAB 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="HAB 3:12"/>አት ዼከምሳን ለፈረ መርማርቴ፤</para>
  <para style="q2" vid="HAB 3:12">ኣሪዻንስ ሰቦተ ለፈት ዽዺቴ።<verse eid="HAB 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="HAB 3:13"/>አት ሰበኬ ፉሩፍ፣</para>
  <para style="q2" vid="HAB 3:13">ድበማኬ ኦልቹፍ ዹፍቴ።</para>
  <para style="q1" vid="HAB 3:13">ሆገና ብየ ሀሞታ ንዳክቴ፤</para>
  <para style="q2" vid="HAB 3:13">መታዻ ሀመ ሚላት ቁላ እሰ ሀምብፍቴ።<verse eid="HAB 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="HAB 3:14"/>ዬሮ ሎልቶትንሳ ኑ ብትኔሱፍ ከአኒ፣</para>
  <para style="q2" vid="HAB 3:14">አኩመ ዋን ረከቶተ ዾከተኒ ጅረን</para>
  <para style="q1" vid="HAB 3:14">ፍጡ ገአኒት ገመደንት፣</para>
  <para style="q2" vid="HAB 3:14">አት ኤቦ ኦፊሳቲን መታሳ ወራንቴ።<verse eid="HAB 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="HAB 3:15"/>አት ፈርዴንኬቲን ብሻኖተ ጉርጉዳ</para>
  <para style="q2" vid="HAB 3:15">ሆመቼሳ ገላነረ ዴምቴ።<verse eid="HAB 3:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="HAB 3:16"/>አን ዸገኤን ገራንኮ ራፈሜ፤</para>
  <para style="q2" vid="HAB 3:16">ህዺንኮ ሰገሌ ሰናን ሆለቴ፤</para>
  <para style="q1" vid="HAB 3:16">ቶርቶር ለፌኮ ሴኔ፤</para>
  <para style="q2" vid="HAB 3:16">ሚልኮስ ንሆለቴ።</para>
  <para style="q1" vid="HAB 3:16">ተኡስ አን ሀመ ጉያን በዲሳ</para>
  <para style="q2" vid="HAB 3:16">ሰቦተ ኑ ዌረረንት ዹፉት ኦብሳን ነንኤገዸ።<verse eid="HAB 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="HAB 3:17"/>ዮ ሙክን ሀርቡ ደራሩ ባቴ</para>
  <para style="q2" vid="HAB 3:17">እጅ ወይኒ ሙከ ወይኒረ ጅራቹ ባቴዩ፣</para>
  <para style="q1" vid="HAB 3:17">ዮ ሙክን ኤጄርሳ እጀ ነቀቹ ድዴ</para>
  <para style="q2" vid="HAB 3:17">ለፍት ቆቲሳ ምዻን ዾወቴዩ፣</para>
  <para style="q1" vid="HAB 3:17">ዮ ሆሎትን ጎለ ኬሳ፣</para>
  <para style="q2" vid="HAB 3:17">ሎንስ ደላ ኬሳ ዸበመንዩ፣<verse eid="HAB 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="HAB 3:18"/>አን ገሩ <char style="nd">ዋቀዮት</char> ነንገመደ፤</para>
  <para style="q2" vid="HAB 3:18">ዋቀ እሰ ነ ፈይሱት ነንገመደ።<verse eid="HAB 3:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="HAB 3:19"/>
    <char style="nd">ዋቀዮ</char> ጎፍታን ጀብነኮት፤</para>
  <para style="q2" vid="HAB 3:19">እን ሚለኮ አከ ሚለ ቦሮፋ ጎዸ፤</para>
  <para style="q2" vid="HAB 3:19">ለፈ ኦል ከኣረስ ነ ዴምስሰ።</para>
  <para style="d" vid="HAB 3:19">ዱረ ቡኣ ፋርፈናቲፍ። ሜሻኮ ከን ርቡቲን ከን ፋርፈተሜ።<verse eid="HAB 3:19"/></para>
  <chapter eid="HAB 3"/>
</usx>
