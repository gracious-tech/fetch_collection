<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1TH" style="id">- Biblica® Open New Oromo Contemporary Version Ethiopic 2022</book>
  <para style="h">1 ተሰሎኒቄ</para>
  <para style="toc1">ተሰሎኒቄ ቶኮፋ</para>
  <para style="toc2">1 ተሰሎኒቄ</para>
  <para style="toc3">1ተሰ</para>
  <para style="mt1">ተሰሎኒቄ</para>
  <para style="mt2">ቶኮፋ</para>
  <chapter number="1" style="c" sid="1TH 1"/>
  <para style="s1">ነጋ ጋፈቹ</para>
  <para style="po">
    <verse number="1" style="v" sid="1TH 1:1"/>ጳዉሎስ፣ ሲላሲፊ ጢሞቴዎስራ።</para>
  <para style="po" vid="1TH 1:1">ገረ ወልዳ ክርስታና ወረ ተሰሎኒቄ ከን ዋቀ አባቲፊ ከን ጎፍታ ዬሱስ ክርስቶስ ታቴት።</para>
  <para style="po" vid="1TH 1:1">አያኒፊ ነጋን እስኒፍ ሃተኡ።<verse eid="1TH 1:1"/></para>
  <para style="s1">አመንቲ ወረ ተሰሎኒቄቲፍ ገለቴፈቹ</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2"/>ኑ ከዸትናኬኘ ኬሰት መቃኬሰን ዾፍኔ ዬሮ ሁንደ ዋኤ ሁንደኬሰኒቲፍ ዋቀ ንገለቴፈትነ። <verse eid="1TH 1:2"/><verse number="3" style="v" sid="1TH 1:3"/>ኑ ሆጂ አመንቲኬሰኒ፣ ደዸቢ ጃለለኬሰኒፊ ኦብሰ አብዲኬሰኒ ከን ጎፍታኬኘ ዬሱስ ክርስቶስት ቀብደን ሰነ ዋቀኬኛፊ አባኬኘ ዱረት እቱመ ፉፍኔ ንያደትነ።<verse eid="1TH 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 1:4"/>ያ ኦቦሎተ ዋቃን ጃለተምተን፣ ኑ አከ እን እስን ፍለቴ ቤክናቲ፤ <verse eid="1TH 1:4"/><verse number="5" style="v" sid="1TH 1:5"/>ወንጌልኬኘ ሁምናን፣ ሀፉረ ቁልቁሉፊ አመንሲሰ ጉዳን መሌ ዱቢ አፋኒ ቆፋን ገረኬሰን ህንዹፍኔቲ። ኑ እስኒፍ ጄኔ አከምት አከ እስን ግዱ ጅራትኔ ንቤክቱ። <verse eid="1TH 1:5"/><verse number="6" style="v" sid="1TH 1:6"/>እስንስ ፈኬኘኬኛፊ ፈኬኘ ጎፍታ ዱካ ቡተኒርቱ፤ ኡቱመ ዽጵነ ጉዳ ኬሰ ጅርተኑስ ገመቹ ሀፉር ቁልቁሉን እስኒ ኬኑን ዱብቸ ፉዸተኒርቱ። <verse eid="1TH 1:6"/><verse number="7" style="v" sid="1TH 1:7"/>ከናንስ አመንቶተ መቄዶንያፊ አካያ ጅረን ሁንዳፍ ፈኬኘ ታተኒ ጅርተን። <verse eid="1TH 1:7"/><verse number="8" style="v" sid="1TH 1:8"/>ዱቢን ጎፍታ እስን ብራ በኤ መቄዶንያፊ አካያ ቆፈት ህንዸገአምኔ፤ አመንቲን እስን ዋቀት ቀብደንስ ለፈ ሁንደ ገኤረ። ከናፉ ዋኤሳ ሆማ ዱበቹ ኑ ህንበርባችሱ፤ <verse eid="1TH 1:8"/><verse number="9" style="v" sid="1TH 1:9"/>እስን ስመትና አከሚ አከ ኑ ጎተን እሳኑ ንዱበቱቲ። እሳን አከምት አከ እስን ዋቀ ጅራታፊ ዋቀ ዹጋ ተጃጅሉፍ ጄተኒ ዋቆተ ቶልፈሞራ ገረ ዋቃት ዴብተንስ ንህሙ፤ <verse eid="1TH 1:9"/><verse number="10" style="v" sid="1TH 1:10"/>አከሱመስ እልመሳ እሰ እን ወረ ዱአን ኬሳ ካሴ ጄቹንስ ዬሱስ እሰ ዼከምሰ ዹፉ ጀላ ኑ ባሱ ሰነ አከ ሰሚራ ኤገተን ንህሙ።<verse eid="1TH 1:10"/></para>
  <chapter eid="1TH 1"/>
  <chapter number="2" style="c" sid="1TH 2"/>
  <para style="s1">ጳዉሎስ ተሰሎኒቄት ተጃጅሉሳ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1"/>ያ ኦቦሎተ፣ እስን ብረ ዹፉንኬኘ ሱን አከሱማን አከ ህንተእን እስኑ ንቤክቱ። <verse eid="1TH 2:1"/><verse number="2" style="v" sid="1TH 2:2"/>አኩመ እስን ቤክተን ኑ ከናን ዱረ ፊልጵስዩስት ዽጰትኔረ፤ አከ መሌስ ቃኔፈምኔረ። ገሩ ዮ ሞርሚን ጭማን ኑ ቁነሜሌ ገርጋርሰ ዋቀኬኛቲን ወንጌለሳ እስንት ህሙዻፍ እጀ ጀብነ አርገትኔረ። <verse eid="1TH 2:2"/><verse number="3" style="v" sid="1TH 2:3"/>ጎርስ ኑ ኬንኑስ ከን ዶጎጎረ ዮካን ጡራኡማ ዮካን ጎዎምሳራ ዹፌ ምት። <verse eid="1TH 2:3"/><verse number="4" style="v" sid="1TH 2:4"/>ቆደ ከና ኑ አከ ወረ ዋቅን ወንጌለ እማና እት ኬኑፍ ቆረቴ ፉዸቴት ዱበትነ። ያሊንኬኘስ ዋቀ ገራኬኘ ቆሩ ሰነ ገመቺሱፍ መሌ ነመ ገመቺሱፊ ምት። <verse eid="1TH 2:4"/><verse number="5" style="v" sid="1TH 2:5"/>አኩመ እስን ቤክተኒፊ አኩመ ዋቅንስ ዹጋ በኡ ሰነ ኑ ዱቢ ሶሶቢት ህንፈየደምኔ፤ ዶቅኑማ ዾክፈቹፍስ ሀጉገትኔ ገረኬሰን ህንዹፍኔ። <verse eid="1TH 2:5"/><verse number="6" style="v" sid="1TH 2:6"/>ኑ ነሞተራ፣ እስንራስ ተኡ ዮካን ወረ ካንራ ኡልፍነ ህንበርባድኔ። ኑ አከ ኤርገሞተ ክርስቶሲት በኣ እስንት ተኡ ንደንዴኘ ቱሬ፤ <verse eid="1TH 2:6"/><verse number="7" style="v" sid="1TH 2:7"/>ኑ ገሩ አኩመ ሃዸ ዳእመንሼ ኩኑንፈቱ ቶኮ ታኔ።</para>
  <para style="p" vid="1TH 2:7">ገራሙማዻን ግዱኬሰን ጅራትኔ። <verse eid="1TH 2:7"/><verse number="8" style="v" sid="1TH 2:8"/>ኑ ዋን አከ መሌ እስን ጃለትኔፍ ወንጌለ ዋቃ ቆፈ ኡቱ ህንተእን ሉቡኬኘሌ እስኒ ኬኑን ፌዺኬኘ ቱሬ፤ እስን ኑ ብረት አከ መሌ ጃለተሞ ቱርተኒቲ። <verse eid="1TH 2:8"/><verse number="9" style="v" sid="1TH 2:9"/>ያ ኦቦሎተ፣ እስን ደዸቢፊ ዽጵነኬኘ ንያደቱቲ፤ ኑ ዬሮ ወንጌለ ዋቃ እስኒ ለለብኔት ነመ ቶኮትሌ አከ በኣ ህንታኔፍ ሀልከኒ ጉያ ሆጄቻ ቱሬ። <verse eid="1TH 2:9"/><verse number="10" style="v" sid="1TH 2:10"/>ኑ ሀመም ቁልቁሉማን፣ ቀጄሉማፊ ሙዳ መሌ እስን ወረ አመንተን ግዱ አከ ጅራትኔ እስን ዹጋ ንባቱ፤ ዋቅንስ ዹጋ በአ። <verse eid="1TH 2:10"/><verse number="11" style="v" sid="1TH 2:11"/>እስን አከ ኑ አኩመ አባን እጆሌሳ ጎርሴ ጀጀቤሱት ቶኮ ቶኮኬሰኒፍ ታኔ ንቤክቱቲ፤ <verse eid="1TH 2:11"/><verse number="12" style="v" sid="1TH 2:12"/>ኩንስ አከ እስን ጅሬኘ ዋቀ እሰ ሞቱማሳቲፊ ኡልፍነሳት እስን ዋሙ ሰናፍ መሉ ጅራተኒፍ።<verse eid="1TH 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13"/>እስንስ ዮሙ ዱቢ ዋቃ ከን ኑራ ዸጌሰን ሰነ ፉዸተንት አኩመ እን ጅሩት፣ አከ ዱቢ ዋቃ ከን እስን ወረ አመንተን ኬሰት ሆጄቱት ፉዸተን መሌ አከ ዱቢ ነማት ዋን ህንፉዸትኒፍ ኑ ኡቱ ገርገር ህንኩትን ዋቀ ገለቴፈትነ። <verse eid="1TH 2:13"/><verse number="14" style="v" sid="1TH 2:14"/>ያ ኦቦሎተ፣ እስን ፈኬኘ ወልዶተ ክርስታና ዋቃ ወረ ክርስቶስ ዬሱስት ጅረን ከኔን ብየ ይሁዳ ጅረኒ ዱካ ቡተኒርቱ፤ አኩመ ወልዶትን ኩኔን ሀርከ ይሁዶታት ዽጰተን ሰነ እስንስ ሀርከ ነሞተ ብየኬሰኒት ዽጰተኒርቱ፤ <verse eid="1TH 2:14"/><verse number="15" style="v" sid="1TH 2:15"/>ይሁዶትን ኩኔን ወረ ጎፍታ ዬሱሲፊ ራጆተ አጄሰኒ ኑሌ አርአተኒዸ። እሳን ዋቀ ህንገመቺሰን፤ ነመ ሁንደትስ ዲነ ተኡ፤ <verse eid="1TH 2:15"/><verse number="16" style="v" sid="1TH 2:16"/>እሳንስ ጩቡሳኒ ጉተቹፍ ጄዸኒ አከ ኑ አከ ነሞትን ኦርማ ፈይፈመኒፍ እት ህንዱበትኔ ኑ ዾዉ። ዹመረት ገሩ ዼከምስ ዋቃ እሳንት ዹፌረ።<verse eid="1TH 2:16"/></para>
  <para style="s1">ጳዉሎስ ወረ ተሰሎኒቄ አርጉ ሀዌ</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17"/>ገሩ ያ ኦቦሎተ፣ ኤርገ ያዳን ኡቱ ህንተእን ፎኒን ዬሮ ገባባፍ እስንራ ገርገር ባኔ ጀልቀብኔ ፉለኬሰን አርጉፍ ሀዊ ጉዳን ጫልችፍኔ ዸማኔ። <verse eid="1TH 2:17"/><verse number="18" style="v" sid="1TH 2:18"/>ኑ ገረኬሰን ዹፉ በርባድኔ ቱሬቲ፤ ዹጉማኑ አን ጳዉሎስ ዬሮ ባይኤ ገረኬሰን ዹፉ ያሌረ፤ ገሩ ሴጠነቱ ኑ ዾዌ። <verse eid="1TH 2:18"/><verse number="19" style="v" sid="1TH 2:19"/>ዮሙ ጎፍታንኬኘ ዬሱስ ክርስቶስ ዹፉት ፉለሳ ዱረት አብዲንኬኘ ዮካን ገመቹንኬኘ ዮካን ጎንፎን ኑ እቲን ኦፍ ጀጅኑ ኤኙ? እስኑመ ምቲ? <verse eid="1TH 2:19"/><verse number="20" style="v" sid="1TH 2:20"/>እስን ኡልፍናፊ ገመቹኬኛቲ።<verse eid="1TH 2:20"/></para>
  <chapter eid="1TH 2"/>
  <chapter number="3" style="c" sid="1TH 3"/>
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1"/>ከናፉ ኑ ዋን ሀመነ ጫላ ኦብሱ ደዸብኔፍ ኮጳኬኘ አቴናት ሀፉን ጋሪ ኑት ፈካቴ። <verse eid="1TH 3:1"/><verse number="2" style="v" sid="1TH 3:2"/>ኑስ ኦቦሌሰኬኘ ጢሞቴዎስ፣ ተጃጅላ ዋቃ እሰ ወንጌለ ክርስቶሲት ሆጄታ ህዸተኬኘ ተኤ ሰነ፣ አከ እን አመንቲኬሰንት እስን ጭምሱፊ እስን ጀጀቤሱፍ ኤርግኔረ፤ <verse eid="1TH 3:2"/><verse number="3" style="v" sid="1TH 3:3"/>ኩንስ አከ ነምን ቶኮዩ ዽጵነ ከናን ህንጄቀምኔፍ። እስንስ አከ ኑ ዋን ከናፍ ፍለተምኔ ስሪት ቤክቱ። <verse eid="1TH 3:3"/><verse number="4" style="v" sid="1TH 3:4"/>ዬሮ እስን ብረ ቱሬት አከ ዽጵን ኑረ ገኡ እስንት ህማ ቱሬቲ። እንስ አኩመ እስን ቤክተን ሰነ ተኤ። <verse eid="1TH 3:4"/><verse number="5" style="v" sid="1TH 3:5"/>ሰበቢ ከናፍ አን ዮሙን ከነ ጫላ ኦብሱ ደዸቤት ዋኤ አመንቲኬሰኒ በሩፍ ጄዼን እሰ ኤርጌ። ተሪ እን ነመ ቆሩ ሱን እስን ቆሬ ደዸቢንኬኘስ ፋይዳ መሌ ሀፌረ ጄዼን ሶዳዼ።<verse eid="1TH 3:5"/></para>
  <para style="s1">ጢሞቴዎስ ኦዱ ጋሪ ፍዴ</para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6"/>አመ ገሩ ጢሞቴዎስ እስን ብራ ገረኬኘ ዹፌ ዋኤ አመንቲኬሰኒቲፊ ዋኤ ጃለለኬሰኒ ኦዱ ጋሪ ኑት ህሜረ። አከሱመስ አከ እስን ዬሮ ሁንደ ያደ ጋሪዻን ኑ ያደኒፊ አኩመ ኑ እስን አርጉ ሀውኑ ሰነ አከ እስንስ ኑ አርጉ ሀውተን ኑት ህሜረ። <verse eid="1TH 3:6"/><verse number="7" style="v" sid="1TH 3:7"/>ከናፍ ያ ኦቦሎተ፣ ኑ ዽጵናፊ አርአተመኬኘ ሁንደ ኬሰት አመንቲኬሰኒን ዋኤኬሰን ጀጀባትኔረ። <verse eid="1TH 3:7"/><verse number="8" style="v" sid="1TH 3:8"/>ዮ እስን ጎፍታት ጭምተኒ ዻበተን ኑ ዹጉማን ንጅራትናቲ። <verse eid="1TH 3:8"/><verse number="9" style="v" sid="1TH 3:9"/>ገመቹ ሰበቢኬሰኒን ፉለ ዋቀኬኛ ዱረት ቀብኑ ሁንዳፍ ዋኤኬሰኒፍ ሀመም ዋቀ ገለቴፈቹ ደንዴኘ? <verse eid="1TH 3:9"/><verse number="10" style="v" sid="1TH 3:10"/>ኑ አከ ዴብኔ እስን አርግኑፊ ዋን አመንቲኬሰን ኬሳ ህርአቴስ አከ እስኒ ጉቱ ደንዴኙፍ ሀልከኒ ጉያ ጭምስኔ ከዸትነ።<verse eid="1TH 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11"/>አመስ ዋቅንኬኛፊ አባንኬኘ መታንሳ፣ ጎፍታንኬኘ ዬሱስስ አከ ኑ ገረኬሰን ዹፍኑ ከራ ኑፍ ሃቀጄልቹ። <verse eid="1TH 3:11"/><verse number="12" style="v" sid="1TH 3:12"/>አኩመ ጃለል ኑ እስኒ ቀብኑ ደበላ ዴሙ ሰነ ጎፍታን ጃለለ እስን ወሊኬሰኒፊ ነመ ሁንዳፍ ቀብደን እስኒ ሃጉድሱ፤ ሃባይእሱስ። <verse eid="1TH 3:12"/><verse number="13" style="v" sid="1TH 3:13"/>አከ እስን ዮሙ ጎፍታንኬኘ ዬሱስ ቁልቁሎተሳ ሁንደ ወጅን ዹፉት ፉለ ዋቀኬኛቲፊ አባኬኛ ዱረት ወረ ሙዳ ህንቀብኔፊ ቁልቁሎተ ታተኒፍስ እን ገራኬሰን ሃጀጀቤሱ።<verse eid="1TH 3:13"/></para>
  <chapter eid="1TH 3"/>
  <chapter number="4" style="c" sid="1TH 4"/>
  <para style="s1">ዋቀ ገመቺሱፍ ጅራቹ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1"/>ከነ መሌስ ያ ኦቦሎተ፣ ዋቀ ገመቺሱፍ አከምት አከ ጅራቹ ቀብደን ኑ እስን በርሲፍኔረ፤ እስንስ አኩመ ሰነት ጅራቻ ጅርቱ። አመስ አከ እቱመ ጫልችፍተኒ ዋን ከነ ጎተን ጎፍታ ዬሱሲን እስን ከዸትነ፤ እስን ጎርስነስ። <verse eid="1TH 4:1"/><verse number="2" style="v" sid="1TH 4:2"/>ኑ ታይታ ጎፍታ ዬሱሲን አጀጀ ማሊ አከ እስኒ ኬንኔ ቤክቱቲ።<verse eid="1TH 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1TH 4:3"/>ፌዺን ዋቃ አከ እስን ቁልቁሎፍተኒዸ፤ ኩንስ አከ እስን ሀለሉማራ ፈጋተኒፍ፤ <verse eid="1TH 4:3"/><verse number="4" style="v" sid="1TH 4:4"/>ቶኮን ቶኮንኬሰን አከምት አከ ከራ ቁልቁሉፊ ኡልፍነ ቀቤሰ ተኤን ዸግነኬሰን ኤገተን ቤኩ ቀብዱ፤ <verse eid="1TH 4:4"/><verse number="5" style="v" sid="1TH 4:5"/>ኩንስ አከ ኦርሞተ ዋቀ ህንቤክኔት ሀዊ ፎኒቲን ህንተእን፤ <verse eid="1TH 4:5"/><verse number="6" style="v" sid="1TH 4:6"/>ዋን ከናንስ ነምን ቶኮዩ ኦቦሌሰሳ ህንሚዽን ዮካን ህንጎዎምስን። አኩመ ኑ ከናን ዱረ እስንት ህምኔ እስን አኬከቺፍኔ ሰነ፣ ጎፍታን ወረ ጩቡ አከሲ ሆጄተን ሁንደ ሃሎ በአ። <verse eid="1TH 4:6"/><verse number="7" style="v" sid="1TH 4:7"/>ዋቅን አከ ኑ ጅሬኘ ቁልቁሉ ጅራትኑፍ መሌ አከ ጡሮፍኑፍ ኑ ህንዋምኔቲ። <verse eid="1TH 4:7"/><verse number="8" style="v" sid="1TH 4:8"/>ከናፉ ነምን ጎርሰ ከነ ቱፈቱ ዋቀ ሀፉረሳ ቁልቁሉ እስኒ ኬኑ ሰነ ቱፈተ መሌ ነመ ህንቱፈቱ።<verse eid="1TH 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9"/>ኤጋ ዋን ዋቅን አከ እስን ወል ጃለተን እስን በርሲሴፍ ዋኤ ጃለለ ኦቦሉማ እስኒ በሬሱ ኑ ህንበርባችሱ። <verse eid="1TH 4:9"/><verse number="10" style="v" sid="1TH 4:10"/>ዹጉማን እስን ኦቦሎተ ጉቱማ መቄዶንያ ኬሰ ጅረን ሁንደ ንጃለቱ። ያ ኦቦሎተ፣ ኑ ገሩ አከ ከነ ጫላ እሳን ጃለተን እስን ጎርስነ፤ <verse eid="1TH 4:10"/><verse number="11" style="v" sid="1TH 4:11"/>አኩመ ኑ ከናን ዱረ እስን አጀጅኔት ተስገቢን ጅራቹፍ ተታፈዻ፤ ሀርኩመኬሰኒን ሆጂኬሰን ሆጄተዻ፤ <verse eid="1TH 4:11"/><verse number="12" style="v" sid="1TH 4:12"/>ኩንስ አከ እስን ወረ አላ ብረት ኡልፍነ አርገተኒፊ አከ ሀርከ ነመ ቶኮሌ ህንኤገትኔፍ።<verse eid="1TH 4:12"/></para>
  <para style="s1">አመንቶተ ወረ ሉቡን ህንጅሬ</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13"/>ያ ኦቦሎተ፣ ኑ አከ እስን ዋኤ ወረ ረፈን ሰና ወላልተን ዮካን አከ ነሞተ አብዲ ህንቀብኔ ካኒት ገድተን ህንበርባድኑ። <verse eid="1TH 4:13"/><verse number="14" style="v" sid="1TH 4:14"/>ኑ ኤርገ አከ ዬሱስ ዱኤ ዱኣ ከኤ አመኔ አከሱመሞ ዋቅን ወረ ዬሱስት አመነኒ ረፈን ሰነ አከ እሱመ ወጅን ካሱ ንአመነ። <verse eid="1TH 4:14"/><verse number="15" style="v" sid="1TH 4:15"/>ወን ኑ አከ ዱቢ ጎፍታት እስንት ህምኑ ከነ፤ ኑ ወር ሉቡን ጅሩ ከኔን ሀመ ዹፋቲ ጎፍታት ጅራትኑ ጎንኩማ ወረ ረፈን ሰነ ህንዱርስኑ። <verse eid="1TH 4:15"/><verse number="16" style="v" sid="1TH 4:16"/>ጎፍታን መታንሳ አጀጃን፣ ሰገሌ ኤርገማ ሀንገፋቲፊ ሰገሌ መለከተ ዋቃቲን ሰሚራ ንቡአ፤ ወር ክርስቶስት አመነኒ ዱአንስ ጀልቀበት ንከኡ። <verse eid="1TH 4:16"/><verse number="17" style="v" sid="1TH 4:17"/>ኤርገሲሞ ኑ ወር ሀፍኔ ሉቡን ጅሩ ቅሌንሰረት ጎፍታ ስመቹፍ እሳን ወጅን ዱሜሳን ኦል ፉዸተምነ። አከሱመስ በረ በራን ጎፍታ ወጅን ንጅራትነ። <verse eid="1TH 4:17"/><verse number="18" style="v" sid="1TH 4:18"/>ከናፉ ዱቢ ከናን ወል ጀጀቤሳ።<verse eid="1TH 4:18"/></para>
  <chapter eid="1TH 4"/>
  <chapter number="5" style="c" sid="1TH 5"/>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1"/>ኤጋ ያ ኦቦሎተ፣ ዋኤ በሮታቲፊ ዋኤ ወቅቲሌ ዋን ቶኮዩ እስኒ በሬሱ ኑ ህንበርባችሱ፤ <verse eid="1TH 5:1"/><verse number="2" style="v" sid="1TH 5:2"/>አከ ጉያን ጎፍታ አኩመ ሀቱት ሀልከኒን ዹፉ እስኑ ስሪት ቤክቱቲ። <verse eid="1TH 5:2"/><verse number="3" style="v" sid="1TH 5:3"/>ኡቱመ ነሞትን፣ “ነጋዸ፤ ቀበነስ” ጄዸኑ አኩመ ጭኒንሱን ዱበርቲ ኡልፋት ዹፉ በዲስን አከ ተሳ እሳንት ዹፈ፤ ጀላስ ህንበአን።<verse eid="1TH 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 5:4"/>እስን ገሩ ያ ኦቦሎተ፣ አከ ጉያን ሱን አኩመ ሀቱት እስንት ህንዹፍኔፍ እስን ወረ ዱከነ ኬሰ ጅርተን ምት። <verse eid="1TH 5:4"/><verse number="5" style="v" sid="1TH 5:5"/>እስን ሁንድ እጆሌ እፋት፤ እጆሌ ጉያትስ። ኑ ወረ ሀልከኒ ዮካን ወረ ዱከና ምት። <verse eid="1TH 5:5"/><verse number="6" style="v" sid="1TH 5:6"/>ኤጋ ኮታ ኑ አከ ወረ ካኒ ህንረፍኑ፤ ቆደ ከና ኮታ ንደመቅና፤ ኦፍ ቀብነስ። <verse eid="1TH 5:6"/><verse number="7" style="v" sid="1TH 5:7"/>ወር ረፈን ሀልከኒን ረፉቲ፤ ወር መቻአንስ ሀልከኒን መቻኡ። <verse eid="1TH 5:7"/><verse number="8" style="v" sid="1TH 5:8"/>ኑ ገሩ ዋን ወረ ጉያ ታኔፍ ኮታ አመንቲፊ ጃለለ አከ ቆሜ ስቢላት ኡፈትኔ፣ አብዲ ፈይናሞ አከ ጎንፎ ስቢላት ኬወትኔ ኦፍ ቀብና። <verse eid="1TH 5:8"/><verse number="9" style="v" sid="1TH 5:9"/>ዋቅን አከ ኑ ከራ ጎፍታኬኘ ዬሱስ ክርስቶሲን ፈይነ አርገትኑፍ መሌ ዼከምሳፍ ኑ ህንፍለትኔቲ። <verse eid="1TH 5:9"/><verse number="10" style="v" sid="1TH 5:10"/>ኑ ዮ ደመቅኔ ዮካን ዮ ረፍኔ አከ እሰ ወጅን ቶኩማን ጅራትኑፍ እን ኑፍ ዱኤ። <verse eid="1TH 5:10"/><verse number="11" style="v" sid="1TH 5:11"/>ከናፉ አኩመ አመ ጎቻ ጅርተን ከነ ወል ጀጀቤሳ፤ ወል እጃራስ።<verse eid="1TH 5:11"/></para>
  <para style="s1">ጎርሰ ዹማ</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12"/>ኤጋ ያ ኦቦሎተ፣ ኑ አከ እስን ወረ ግዱኬሰንት ጭመኒ ሆጄተን፣ ከኔን ከራ ጎፍታቲን እስን ሆገነኒፊ እስን ጎርሰን ሰነ ከበጀን እስን ከዸትነ። <verse eid="1TH 5:12"/><verse number="13" style="v" sid="1TH 5:13"/>ሰበቢ ሆጂሳኒቲፍስ ጃለላን ኡልፍነ ጉዳ እሳኒፍ ኬና። ነጋዻንስ ወሊ ወጅን ጅራዻ። <verse eid="1TH 5:13"/><verse number="14" style="v" sid="1TH 5:14"/>ያ ኦቦሎተ፣ ኑ አከ እስን ወረ ሆጂ ሆጄቹ ህንጃለትኔ አኬከቺፍተን፣ ሶዳቶተ ጀጀቤስተን፣ ደዸቦ ገርጋርተን፣ አከ ነመ ሁንዱማፍስ ኦብስተን እስን ጎርስነ። <verse eid="1TH 5:14"/><verse number="15" style="v" sid="1TH 5:15"/>አከ ነምን ቶኮዩ ዋን ሀማፍ ዴቢ ሀማ ህንዴብፍኔ ኦፍ ኤገዻ፤ ቆደ ከና ዬሮ ሁንደ ወሊፍ፣ ነመ ሁንዳፍስ ዋን ጋሪ ጎቹፍ ጨራቃ።<verse eid="1TH 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 5:16"/>ዬሮ ሁንደ ገመዳ፤ <verse eid="1TH 5:16"/><verse number="17" style="v" sid="1TH 5:17"/>ኡቱ ገርገር ህንኩትን ከዸዻ። <verse eid="1TH 5:17"/><verse number="18" style="v" sid="1TH 5:18"/>ሃለ ሁንዱማ ኬሰት ዋቀ ገለቴፈዻ፤ ፌዺን ዋቅን ክርስቶስ ዬሱስት እስኒፍ ቀቡ ከናቲ።<verse eid="1TH 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19"/>ሀፉረ ህንዻምስና፤ <verse eid="1TH 5:19"/><verse number="20" style="v" sid="1TH 5:20"/>ራጂ ህንቱፈትና፤ <verse eid="1TH 5:20"/><verse number="21" style="v" sid="1TH 5:21"/>ዋን ሁንደ ቆራ። እሰ ጋሪ ጀቤሳቲ ቀበዻ። <verse eid="1TH 5:21"/><verse number="22" style="v" sid="1TH 5:22"/>ሀምነ ጎሰ ሁንዱማራ ፈጋዻ።<verse eid="1TH 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23"/>ዋቅን መታንሳ፣ ዋቅን ነጋ ጉቱማን ጉቱት እስን ሃቁልቁሌሱ። ሀፉርኬሰን፣ ሉቡንኬሰኒፊ ዸግንኬሰን ጉቱን ጉያ ጎፍታንኬኘ ዬሱስ ክርስቶስ ዹፉት ሙዳራ ሃኤገመን። <verse eid="1TH 5:23"/><verse number="24" style="v" sid="1TH 5:24"/>እን እስን ዋሙ ሱን አመነማዸ፤ ዋን ከነስ ንጎዸ።<verse eid="1TH 5:24"/></para>
  <para style="b"/>
  <para style="b"/>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25"/>ያ ኦቦሎተ፣ ኑፍስ ከዸዻ።<verse eid="1TH 5:25"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26"/>ዹንጎ ቁልቁሉዻንስ ኦቦሎተ ሁንደ ነጋ ጋፈዻ።<verse eid="1TH 5:26"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="27" style="v" sid="1TH 5:27"/>አን አከ ጠለያን ኩን ኦቦሎተ ሁንዳፍ ዱብፈሙ ፉለ ጎፍታ ዱረት እስን አጀጀ።<verse eid="1TH 5:27"/></para>
  <para style="b"/>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28"/>አያን ጎፍታኬኘ ዬሱስ ክርስቶስ እስን ወጅን ሃተኡ።<verse eid="1TH 5:28"/></para>
  <chapter eid="1TH 5"/>
</usx>
